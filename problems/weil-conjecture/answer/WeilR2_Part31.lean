    have hT : Q.comap (algebraMap T R₁) = 𝔭₁.comap (algebraMap T R₁) := by
      rw [h𝔭₁T, ← hQW]
      ext t
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, hΦ, hmem]
    calc Q = Ideal.map (algebraMap T R₁) (Q.comap (algebraMap T R₁)) := (IsLocalization.map_under (Submonoid.powers g) R₁ Q).symm
      _ = Ideal.map (algebraMap T R₁) (𝔭₁.comap (algebraMap T R₁)) := by rw [hT]
      _ = 𝔭₁ := IsLocalization.map_under (Submonoid.powers g) R₁ 𝔭₁
  have t_s9 : ∀ (R R₁ M : Type u) [CommRing R] [CommRing R₁] [Algebra R R₁] [AddCommGroup M] [Module R M] (r : R) (hr : r ∈ Module.annihilator R M), algebraMap R R₁ r ∈ Module.annihilator R₁ (TensorProduct R R₁ M) := by
    intro R R₁ M _ _ _ _ _ r hr
    rw [Module.mem_annihilator] at hr ⊢
    intro z
    rw [algebraMap_smul]
    induction z using TensorProduct.induction_on with
    | zero => rw [smul_zero]
    | tmul y m => rw [← TensorProduct.tmul_smul, hr, TensorProduct.tmul_zero]
    | add x y hx hy => rw [smul_add, hx, hy, add_zero]
  intro V _ _ C R _ _ _ _ _ _ hFT M _ _ hMfin 𝔭 h𝔭 q hq hq𝔭 hQF hm hIV
  classical
  haveI := hFT
  haveI := hQF
  haveI := h𝔭
  set p := 𝔭.comap (algebraMap C R) with hpdef
  haveI hpP : p.IsPrime := Ideal.comap_isPrime _ _
  haveI : q.LiesOver p := ⟨by
    show p = q.comap (algebraMap C (R ⧸ Module.annihilator R M))
    rw [IsScalarTower.algebraMap_eq C R (R ⧸ Module.annihilator R M), ← Ideal.comap_comap,
      Ideal.Quotient.algebraMap_eq, hq𝔭]⟩
  obtain ⟨C', iC', iCC', hEt, P, hP, hPo, ε, hε, 𝔓, h𝔓, h𝔓o, h𝔓q, hε𝔓, hbij, hfin, huniq⟩ :=
    Algebra.exists_etale_isIdempotentElem_forall_liesOver_eq p q
  letI iVC' : Algebra V C' := ((algebraMap C C').comp (algebraMap V C)).toAlgebra
  haveI tVCC' : IsScalarTower V C C' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have congC' := t_s1 C C' p P hbij.2
  have hPp : P.comap (algebraMap C C') = p := (Ideal.over_def P p).symm
  have h𝔓P : ∀ x : C', algebraMap C' (TensorProduct C C' (R ⧸ Module.annihilator R M)) x ∈ 𝔓 ↔ x ∈ P := by
    intro x; rw [Ideal.over_def 𝔓 P]; rfl
  refine ⟨C', iC', iCC', iVC', tVCC', hEt, P, hP, hPp, ?_⟩
  intro c hc

  let π : TensorProduct C R C' →+* TensorProduct C C' (R ⧸ Module.annihilator R M) :=
    ((Algebra.TensorProduct.comm C (R ⧸ Module.annihilator R M) C').toAlgHom.comp
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ C (Module.annihilator R M)) (AlgHom.id C C'))).toRingHom
  have hπ : ∀ (r : R) (x : C'), π (r ⊗ₜ[C] x) = x ⊗ₜ[C] Ideal.Quotient.mk (Module.annihilator R M) r := by
    intro r x; simp [π]
  have hπs : Function.Surjective π := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero π⟩
    | tmul x y =>
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨r ⊗ₜ[C] x, hπ r x⟩
    | add a b ha hb =>
      obtain ⟨a', rfl⟩ := ha
      obtain ⟨b', rfl⟩ := hb
      exact ⟨a' + b', map_add π _ _⟩
  have K1 : ∀ x : C', π ((1 : R) ⊗ₜ[C] x) = algebraMap C' (TensorProduct C C' (R ⧸ Module.annihilator R M)) x := by
    intro x
    rw [hπ, map_one, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  obtain ⟨εt, hεt⟩ := hπs ε
  set g : TensorProduct C R C' := εt * ((1 : R) ⊗ₜ[C] c) with hg
  haveI : Algebra.Etale (TensorProduct C R C') (Localization.Away g) := Algebra.Etale.of_isLocalizationAway g
  have hEtR : Algebra.Etale R (Localization.Away g) := Algebra.Etale.comp R (TensorProduct C R C') (Localization.Away g)
  have hug : IsUnit (algebraMap (TensorProduct C R C') (Localization.Away g) g) :=
    IsLocalization.Away.algebraMap_isUnit g
  have hεu : IsUnit (algebraMap (TensorProduct C R C') (Localization.Away g) εt) :=
    isUnit_of_mul_isUnit_left (by rw [← map_mul]; exact hug)
  have hcu : IsUnit (algebraMap (TensorProduct C R C') (Localization.Away g) ((1 : R) ⊗ₜ[C] c)) :=
    isUnit_of_mul_isUnit_right (by rw [← map_mul]; exact hug)
  let j : C' →+* Localization.Away g :=
    (algebraMap (TensorProduct C R C') (Localization.Away g)).comp Algebra.TensorProduct.includeRight.toRingHom
  have hj : ∀ x : C', j x = algebraMap (TensorProduct C R C') (Localization.Away g) ((1 : R) ⊗ₜ[C] x) := fun _ => rfl
  have hjc : IsUnit (j c) := hcu
  let lam : Localization.Away c →+* Localization.Away g := IsLocalization.Away.lift c hjc
  have hlam : ∀ x : C', lam (algebraMap C' (Localization.Away c) x) = j x := IsLocalization.Away.lift_eq c hjc
  letI iLR₁ : Algebra (Localization.Away c) (Localization.Away g) := lam.toAlgebra
  have hlam' : ∀ x : C', algebraMap (Localization.Away c) (Localization.Away g) (algebraMap C' (Localization.Away c) x) = j x := hlam
  have key3 : ∀ t : C, (algebraMap C R t) ⊗ₜ[C] (1 : C') = (1 : R) ⊗ₜ[C] (algebraMap C C' t) := by
    intro t
    rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one t, TensorProduct.smul_tmul]
  have hVR : ∀ v : V, algebraMap V (Localization.Away g) v = algebraMap (Localization.Away c) (Localization.Away g) (algebraMap V (Localization.Away c) v) := by
    intro v
    rw [IsScalarTower.algebraMap_apply V C' (Localization.Away c), hlam', hj]
    show algebraMap R (Localization.Away g) (algebraMap V R v) = _
    rw [IsScalarTower.algebraMap_apply R (TensorProduct C R C') (Localization.Away g),
      Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      IsScalarTower.algebraMap_apply V C R, key3]
    rfl
  haveI tVLR₁ : IsScalarTower V (Localization.Away c) (Localization.Away g) := IsScalarTower.of_algebraMap_eq hVR

  set I₁ := Module.annihilator (Localization.Away g) (TensorProduct R (Localization.Away g) M) with hI₁
  have hAnn : ∀ r ∈ Module.annihilator R M, Ideal.Quotient.mk I₁ (algebraMap (TensorProduct C R C') (Localization.Away g) (r ⊗ₜ[C] (1 : C'))) = 0 := by
    intro r hr
    rw [Ideal.Quotient.eq_zero_iff_mem]
    have := t_s9 R (Localization.Away g) M r hr
    rw [IsScalarTower.algebraMap_apply R (TensorProduct C R C') (Localization.Away g),
      Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at this
    exact this
  let fA : C' →ₐ[C] (Localization.Away g ⧸ I₁) :=
    (Ideal.Quotient.mkₐ C I₁).comp ((IsScalarTower.toAlgHom C (TensorProduct C R C') (Localization.Away g)).comp
      Algebra.TensorProduct.includeRight)
  let gA : (R ⧸ Module.annihilator R M) →ₐ[C] (Localization.Away g ⧸ I₁) :=
    Ideal.Quotient.liftₐ (Module.annihilator R M)
      ((Ideal.Quotient.mkₐ C I₁).comp ((IsScalarTower.toAlgHom C (TensorProduct C R C') (Localization.Away g)).comp
        Algebra.TensorProduct.includeLeft)) (fun r hr => hAnn r hr)
  let Φ : TensorProduct C C' (R ⧸ Module.annihilator R M) →+* (Localization.Away g ⧸ I₁) :=
    (Algebra.TensorProduct.lift fA gA (fun _ _ => Commute.all _ _)).toRingHom
  have hfA : ∀ y : C', fA y = Ideal.Quotient.mk I₁ (algebraMap (TensorProduct C R C') (Localization.Away g) ((1 : R) ⊗ₜ[C] y)) := fun _ => rfl
  have hgA : ∀ r : R, gA (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk I₁ (algebraMap (TensorProduct C R C') (Localization.Away g) (r ⊗ₜ[C] (1 : C'))) := fun _ => rfl
  have hΦt : ∀ (y : C') (r : R), Φ (y ⊗ₜ[C] Ideal.Quotient.mk (Module.annihilator R M) r) = fA y * gA (Ideal.Quotient.mk _ r) :=
    fun y r => Algebra.TensorProduct.lift_tmul _ _ _ y _
  have hΦ : ∀ x : TensorProduct C R C', Φ (π x) = Ideal.Quotient.mk I₁ (algebraMap (TensorProduct C R C') (Localization.Away g) x) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul r y =>
      rw [hπ, hΦt, hfA, hgA, ← map_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]
  have K2 : ∀ x : C', Φ (algebraMap C' (TensorProduct C C' (R ⧸ Module.annihilator R M)) x) = Ideal.Quotient.mk I₁ (j x) := by
    intro x; rw [← K1, hΦ, hj]
  have hE : Ideal.Quotient.mk I₁ (algebraMap (TensorProduct C R C') (Localization.Away g) εt) = 1 := by
    have hu : IsUnit (Ideal.Quotient.mk I₁ (algebraMap (TensorProduct C R C') (Localization.Away g) εt)) := hεu.map _
    refine (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp ?_
    have := hε.map Φ
    rw [← hεt, hΦ] at this
    exact this
  have hΦε : Φ ε = 1 := by rw [← hεt, hΦ, hE]
  have hΦεu : IsUnit (Φ ε) := by rw [hΦε]; exact isUnit_one

  obtain ⟨𝔔, h𝔔def⟩ : ∃ 𝔔 : Ideal (TensorProduct C R C'), 𝔔 = 𝔓.comap π := ⟨_, rfl⟩
  have hm𝔔 : ∀ x, x ∈ 𝔔 ↔ π x ∈ 𝔓 := by intro x; rw [h𝔔def]; rfl
  haveI h𝔔p : 𝔔.IsPrime := by rw [h𝔔def]; exact Ideal.comap_isPrime _ _
  have hg𝔔 : g ∉ 𝔔 := by
    rw [hm𝔔, hg, map_mul, hεt, K1]
    intro h
    rcases h𝔓.mem_or_mem h with h1 | h1
    · exact hε𝔓 h1
    · exact hc ((h𝔓P c).mp h1)
  have hdisj : Disjoint (↑(Submonoid.powers g) : Set (TensorProduct C R C')) ↑𝔔 :=
    (Ideal.disjoint_powers_iff_notMem_of_isPrime g).mpr hg𝔔
  obtain ⟨𝔭₁, h𝔭₁def⟩ : ∃ 𝔭₁ : Ideal (Localization.Away g), 𝔭₁ = 𝔔.map (algebraMap (TensorProduct C R C') (Localization.Away g)) := ⟨_, rfl⟩
  have h𝔭₁p : 𝔭₁.IsPrime := by
    rw [h𝔭₁def]; exact IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g) _ 𝔔 h𝔔p hdisj
  have h𝔭₁T : 𝔭₁.comap (algebraMap (TensorProduct C R C') (Localization.Away g)) = 𝔔 := by
    rw [h𝔭₁def]; exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g) _ h𝔔p hdisj
  have hm𝔭₁ : ∀ x, algebraMap (TensorProduct C R C') (Localization.Away g) x ∈ 𝔭₁ ↔ x ∈ 𝔔 := by
    intro x; rw [← h𝔭₁T]; rfl
  have hR𝔔 : 𝔔.comap (algebraMap R (TensorProduct C R C')) = 𝔭 := by
    ext x
    rw [Ideal.mem_comap, hm𝔔, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply, hπ, ← hq𝔭, Ideal.mem_comap, ← h𝔓q, Ideal.mem_comap]
    rfl
  have hjP : ∀ x : C', j x ∈ 𝔭₁ ↔ x ∈ P := by
    intro x; rw [hj, hm𝔭₁, hm𝔔, K1, h𝔓P]

  have c1 : 𝔭₁.comap (algebraMap R (Localization.Away g)) = 𝔭 := by
    ext x
    rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R (TensorProduct C R C') (Localization.Away g), hm𝔭₁,
      ← hR𝔔, Ideal.mem_comap]

  have congT := t_s2 C R C' p P congC' 𝔭 rfl 𝔔 (fun y hy => by rw [hm𝔔, K1]; exact (h𝔓P y).mpr hy)
  have c2 := t_s3 R (TensorProduct C R C') 𝔭 𝔔 hR𝔔 congT g hg𝔔 𝔭₁ h𝔭₁T

  have c3 : Ideal.map (algebraMap V (Localization.Away c)) (IsLocalRing.maximalIdeal V) ≤ 𝔭₁.comap (algebraMap (Localization.Away c) (Localization.Away g)) := by
    rw [Ideal.map_le_iff_le_comap]
    intro v hv
    rw [Ideal.mem_comap, Ideal.mem_comap, ← hVR]
    show algebraMap R (Localization.Away g) (algebraMap V R v) ∈ 𝔭₁
    rw [← Ideal.mem_comap, c1, IsScalarTower.algebraMap_apply V C R]
    exact hm (Ideal.mem_map_of_mem _ hv)

  have c4 : RingHom.Finite ((Ideal.Quotient.mk I₁).comp (algebraMap (Localization.Away c) (Localization.Away g))) := by
    refine t_s5 C' (TensorProduct C C' (R ⧸ Module.annihilator R M)) (Localization.Away g ⧸ I₁) c ε hfin Φ
      ((Ideal.Quotient.mk I₁).comp (algebraMap (Localization.Away c) (Localization.Away g))) ?_ hΦεu ?_
    · intro x
      rw [K2]
      show Ideal.Quotient.mk I₁ (j x) = Ideal.Quotient.mk I₁ (algebraMap (Localization.Away c) (Localization.Away g) (algebraMap C' (Localization.Away c) x))
      rw [hlam']
    · intro d
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective d
      obtain ⟨n, x, hx⟩ := IsLocalization.Away.surj g y
      refine ⟨π x, n, ?_⟩
      have hgs : algebraMap (TensorProduct C R C') (Localization.Away g) g = algebraMap (TensorProduct C R C') (Localization.Away g) εt * j c := map_mul _ _ _
      rw [hΦ, ← hx, K2, hgs, mul_pow, map_mul, map_mul, map_pow, map_pow, hE]
      ring

  have c5 : Module.Finite (Localization.Away c) (TensorProduct R (Localization.Away g) M) :=
    t_s6 (Localization.Away c) (Localization.Away g) (TensorProduct R (Localization.Away g) M)
      (Module.Finite.base_change R (Localization.Away g) M) c4

  have c6 : ∀ Q : Ideal (Localization.Away g), Q.IsPrime → I₁ ≤ Q → Q.comap (algebraMap (Localization.Away c) (Localization.Away g)) = 𝔭₁.comap (algebraMap (Localization.Away c) (Localization.Away g)) → Q = 𝔭₁ := by
    intro Q hQ hIQ hQc
    have hQP : Q.comap j = P := by
      ext x
      have e1 : x ∈ Q.comap j ↔ algebraMap C' (Localization.Away c) x ∈ Q.comap (algebraMap (Localization.Away c) (Localization.Away g)) := by
        rw [Ideal.mem_comap, Ideal.mem_comap, hlam']
      rw [e1, hQc, Ideal.mem_comap, hlam', hjP]
    exact t_s8 C' (TensorProduct C C' (R ⧸ Module.annihilator R M)) (TensorProduct C R C') (Localization.Away g) g
      π I₁ Φ hΦ ε hΦεu P 𝔓 huniq j K2 𝔭₁ h𝔭₁p (by rw [h𝔭₁T, h𝔔def]) Q hQ hIQ hQP

  haveI tVCL : IsScalarTower V C (Localization.Away c) := IsScalarTower.of_algebraMap_eq (fun v => by
    rw [IsScalarTower.algebraMap_apply V C' (Localization.Away c), IsScalarTower.algebraMap_apply C C' (Localization.Away c)]
    rfl)
  have hq₁ : ∀ x : C', algebraMap C' (Localization.Away c) x ∈ 𝔭₁.comap (algebraMap (Localization.Away c) (Localization.Away g)) ↔ x ∈ P := by
    intro x; rw [Ideal.mem_comap, hlam', hjP]
  haveI hq₁p : (𝔭₁.comap (algebraMap (Localization.Away c) (Localization.Away g))).IsPrime := Ideal.comap_isPrime _ _
  have hq₁P : (𝔭₁.comap (algebraMap (Localization.Away c) (Localization.Away g))).comap (algebraMap C' (Localization.Away c)) = P := by
    ext x; rw [Ideal.mem_comap, hq₁]
  have hq₁C : (𝔭₁.comap (algebraMap (Localization.Away c) (Localization.Away g))).comap (algebraMap C (Localization.Away c)) = p := by
    ext x; rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply C C' (Localization.Away c), hq₁, ← hPp, Ideal.mem_comap]
  have congL := t_s3 C C' p P hPp congC' c hc _ hq₁P
  have c7 := t_s4 V C (Localization.Away c) p _ hq₁C congL hIV
  exact ⟨Localization.Away g, inferInstance, inferInstance, inferInstance, inferInstance, iLR₁, tVLR₁, hEtR, c5, 𝔭₁, h𝔭₁p,
    c1, c2, c3, c4, c6, c7⟩

theorem wcpa_pple_dvls_domain_nbhd : ∀ (V : Type u) [CommRing V] [IsLocalRing V] (D : Type u) [CommRing D] [Algebra V D], Algebra.Smooth V D → ∀ (P : Ideal D) (_ : P.IsPrime), Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V) ≤ P → ∃ c : D, c ∉ P ∧ IsDomain (Localization.Away c ⧸ Ideal.map (algebraMap V (Localization.Away c)) (IsLocalRing.maximalIdeal V)) :=
by
  classical

  have s1 : ∀ (k : Type u) [Field k] (E : Type u) [CommRing E] [Algebra k E],
      Algebra.Smooth k E → ∀ (Q : Ideal E) [Q.IsPrime], IsDomain (Localization.AtPrime Q) := by
    intro k _ E _ _ hsm Q _
    haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap k E))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Smooth), CommRingCat.hom_ofHom]
      exact RingHom.smooth_algebraMap.mpr hsm
    haveI h := (wc_fntame_smooth_stalk_normal k (Spec (CommRingCat.of E))
      (Spec.map (CommRingCat.ofHom (algebraMap k E))) (⟨Q, inferInstance⟩ : PrimeSpectrum E)).1
    let e := (Spec.stalkIso (CommRingCat.of E) ⟨Q, inferInstance⟩).commRingCatIsoToRingEquiv
    exact MulEquiv.isDomain _ e.symm.toMulEquiv

  have s2 : ∀ (B E : Type u) [CommRing B] [CommRing E], (B ≃+* E) → IsNoetherianRing E →
      (∀ (Q : Ideal E) [Q.IsPrime], IsDomain (Localization.AtPrime Q)) →
      IsNoetherianRing B ∧ ∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) := by
    intro B E _ _ e hE hloc
    refine ⟨isNoetherianRing_of_ringEquiv E e.symm, ?_⟩
    intro Q _
    haveI : (Q.comap (e.symm : E →+* B)).IsPrime := Ideal.comap_isPrime _ _
    have hsub : Submonoid.map e.toMonoidHom Q.primeCompl =
        (Q.comap (e.symm : E →+* B)).primeCompl := by
      ext y
      rw [Submonoid.mem_map, Ideal.mem_primeCompl_iff, Ideal.mem_comap]
      constructor
      · rintro ⟨b, hb, rfl⟩
        rw [Ideal.mem_primeCompl_iff] at hb
        simpa using hb
      · intro hy
        exact ⟨e.symm y, Ideal.mem_primeCompl_iff.mpr hy, by simp⟩
    let f := IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime Q)
      (Localization.AtPrime (Q.comap (e.symm : E →+* B))) e hsub
    haveI := hloc (Q.comap (e.symm : E →+* B))
    exact MulEquiv.isDomain _ f.toMulEquiv

  have s3 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Q : Ideal A) [Q.IsPrime],
      IsDomain (Localization.AtPrime Q) → ∃ 𝔫 : Ideal A, 𝔫.IsPrime ∧ 𝔫 ≤ Q ∧
        ∃ s : A, s ∉ Q ∧ ∀ a ∈ 𝔫, s * a = 0 := by
    intro A _ _ Q hQ hdom
    let 𝔫 : Ideal A := Ideal.comap (algebraMap A (Localization.AtPrime Q)) ⊥
    haveI : (⊥ : Ideal (Localization.AtPrime Q)).IsPrime := Ideal.isPrime_bot
    have hkill : ∀ a ∈ 𝔫, ∃ t : A, t ∉ Q ∧ t * a = 0 := by
      intro a ha
      have h0 : algebraMap A (Localization.AtPrime Q) a = 0 := by
        simpa [𝔫, Ideal.mem_comap, Ideal.mem_bot] using ha
      obtain ⟨⟨t, ht⟩, hta⟩ := (IsLocalization.map_eq_zero_iff Q.primeCompl _ a).mp h0
      exact ⟨t, ht, hta⟩
    have hle : 𝔫 ≤ Q := by
      intro a ha
      obtain ⟨t, ht, hta⟩ := hkill a ha
      have : t * a ∈ Q := by rw [hta]; exact Q.zero_mem
      exact (hQ.mem_or_mem this).resolve_left ht
    obtain ⟨G, hG⟩ := (IsNoetherian.noetherian 𝔫 : 𝔫.FG)
    have hGmem : ∀ g ∈ G, ∃ t : A, t ∉ Q ∧ t * g = 0 := fun g hg =>
      hkill g (hG ▸ Submodule.subset_span hg)
    choose! t ht using hGmem
    refine ⟨𝔫, Ideal.comap_isPrime _ _, hle, ∏ g ∈ G, t g, ?_, ?_⟩
    · intro hmem
      obtain ⟨g, hg, hgQ⟩ := (hQ.prod_mem_iff).mp hmem
      exact (ht g hg).1 hgQ
    · intro a ha
      rw [← hG] at ha
      induction ha using Submodule.span_induction with
      | mem g hg =>
        obtain ⟨r, hr⟩ := Finset.dvd_prod_of_mem t hg
        rw [hr, mul_comm (t g) r, mul_assoc, (ht g hg).2, mul_zero]
      | zero => exact mul_zero _
      | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
      | smul r x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]

  have s4 : ∀ (D : Type u) [CommRing D] (I 𝔫 : Ideal D) (c : D), 𝔫.IsPrime → I ≤ 𝔫 → c ∉ 𝔫 →
      (∀ d ∈ 𝔫, c * d ∈ I) →
      IsDomain (Localization.Away c ⧸ Ideal.map (algebraMap D (Localization.Away c)) I) := by
    intro D _ I 𝔫 c h𝔫 hI hc hcI
    have hdisj : Disjoint (Submonoid.powers c : Set D) 𝔫 :=
      (Ideal.disjoint_powers_iff_notMem c h𝔫.isRadical).mpr hc
    haveI hN : (𝔫.map (algebraMap D (Localization.Away c))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers c) _ 𝔫 h𝔫 hdisj
    have heq : Ideal.map (algebraMap D (Localization.Away c)) I =
        𝔫.map (algebraMap D (Localization.Away c)) := by
      apply le_antisymm (Ideal.map_mono hI)
      rw [Ideal.map_le_iff_le_comap]
      intro d hd
      rw [Ideal.mem_comap]
      have hu : IsUnit (algebraMap D (Localization.Away c) c) :=
        IsLocalization.Away.algebraMap_isUnit c
      have h1 : algebraMap D (Localization.Away c) (c * d) ∈
          Ideal.map (algebraMap D (Localization.Away c)) I := Ideal.mem_map_of_mem _ (hcI d hd)
      rw [map_mul] at h1
      have h2 := Ideal.mul_mem_left _ (↑hu.unit⁻¹ : Localization.Away c) h1
      rwa [← mul_assoc, hu.val_inv_mul, one_mul] at h2
    rw [heq]
    infer_instance

  intro V _ _ D _ _ hsm P hP hIP
  set m := IsLocalRing.maximalIdeal V with hm
  set I := Ideal.map (algebraMap V D) m with hIdef
  letI : Field (V ⧸ m) := Ideal.Quotient.field m
  haveI : Algebra.Smooth (V ⧸ m) (TensorProduct V (V ⧸ m) D) := inferInstance
  haveI : IsNoetherianRing (TensorProduct V (V ⧸ m) D) :=
    Algebra.FiniteType.isNoetherianRing (V ⧸ m) _
  have hlocE := s1 (V ⧸ m) (TensorProduct V (V ⧸ m) D) inferInstance
  let e : (D ⧸ I) ≃+* TensorProduct V (V ⧸ m) D :=
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D m).toRingEquiv.trans
      (Algebra.TensorProduct.comm V D (V ⧸ m)).toRingEquiv
  obtain ⟨hnoeth, hlocB⟩ := s2 (D ⧸ I) _ e inferInstance hlocE
  have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ P := by rw [Ideal.mk_ker]; exact hIP
  set Pb := P.map (Ideal.Quotient.mk I) with hPb
  haveI hPbp : Pb.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
  have hPbc : Pb.comap (Ideal.Quotient.mk I) = P := by
    rw [hPb, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
    refine sup_eq_left.mpr ?_
    have : Ideal.comap (Ideal.Quotient.mk I) ⊥ = RingHom.ker (Ideal.Quotient.mk I) := rfl
    rw [this]; exact hker
  haveI := hnoeth
  obtain ⟨nb, hnb, hnbP, sb, hsb, hsbk⟩ := s3 (D ⧸ I) Pb (hlocB Pb)
  set n := nb.comap (Ideal.Quotient.mk I) with hn
  haveI hnp : n.IsPrime := Ideal.comap_isPrime _ _
  have hnP : n ≤ P := hPbc ▸ Ideal.comap_mono hnbP
  have hIn : I ≤ n := by
    intro d hd
    show Ideal.Quotient.mk I d ∈ nb
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hd]
    exact nb.zero_mem
  obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective sb
  have hcP : c ∉ P := by
    intro h
    apply hsb
    rw [← hc]
    exact Ideal.mem_map_of_mem _ h
  have hcI : ∀ d ∈ n, c * d ∈ I := by
    intro d hd
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hc]
    exact hsbk _ hd
  have hdom := s4 D I n c hnp hIn (fun h => hcP (hnP h)) hcI
  refine ⟨c, hcP, ?_⟩
  have hmap : Ideal.map (algebraMap D (Localization.Away c)) I =
      Ideal.map (algebraMap V (Localization.Away c)) m := by
    rw [hIdef, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  rw [← hmap]
  exact hdom

theorem wcpa_pple_dv_local_structure : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V],
    ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (R : Type u) [CommRing R] [Algebra V R], Algebra.FinitePresentation V R →
    ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M], Module.Finite R M →
    ∀ 𝔭 : Ideal R, 𝔭.IsPrime →
    Module.annihilator R M ⊔ Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ 𝔭 →
    ∀ d : ℕ, ringKrullDim (R ⧸ (Module.annihilator R M ⊔ Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V))) < ((d + 1 : ℕ) : WithBot ℕ∞) →
    ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra R R₁) (_ : Algebra V R₁) (_ : IsScalarTower V R R₁)
      (C : Type u) (_ : CommRing C) (_ : Algebra V C) (_ : Algebra C R₁) (_ : IsScalarTower V C R₁),
      Algebra.Etale R R₁ ∧ Algebra.Smooth V C ∧
      IsDomain (C ⧸ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V)) ∧
      ringKrullDim (C ⧸ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V)) < ((d + 1 : ℕ) : WithBot ℕ∞) ∧
      Module.Finite C (TensorProduct R R₁ M) ∧
      ∃ (𝔭₁ : Ideal R₁) (_ : 𝔭₁.IsPrime), 𝔭₁.comap (algebraMap R R₁) = 𝔭 ∧
        (∀ b : R₁, ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R R₁ s * b - algebraMap R R₁ a ∈ 𝔭₁) ∧
        Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≤ 𝔭₁.comap (algebraMap C R₁) ∧
        RingHom.Finite ((Ideal.Quotient.mk (Module.annihilator R₁ (TensorProduct R R₁ M))).comp (algebraMap C R₁)) ∧
        (∀ P : Ideal R₁, P.IsPrime → Module.annihilator R₁ (TensorProduct R R₁ M) ≤ P →
          P.comap (algebraMap C R₁) = 𝔭₁.comap (algebraMap C R₁) → P = 𝔭₁) ∧
        (∀ x : (𝔭₁.comap (algebraMap C R₁)).ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) :=
by
  intro V _ _ _ _ _ R _ _ hRfp M _ _ _ _ hM 𝔭 h𝔭 hJ d hdim
  classical

  have s2 : ∀ (C R : Type u) [CommRing C] [CommRing R] [Algebra V C] [Algebra C R] [Algebra V R]
      [IsScalarTower V C R], Algebra.FiniteType C R → ∀ (𝔄 : Ideal R),
      RingHom.Finite ((Ideal.Quotient.mk (𝔄 ⊔ Ideal.map (algebraMap V R)
        (IsLocalRing.maximalIdeal V))).comp (algebraMap C R)) →
      ∀ (q : Ideal (R ⧸ 𝔄)) (_ : q.IsPrime),
      Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ q.comap (Ideal.Quotient.mk 𝔄) →
      Algebra.QuasiFiniteAt C q := by
    intro C R _ _ _ _ _ _ hFT 𝔄 hfin q hq hmq
    set I := 𝔄 ⊔ Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) with hI
    haveI hTfin : Module.Finite C (R ⧸ I) := by
      rw [← RingHom.finite_algebraMap, IsScalarTower.algebraMap_eq C R (R ⧸ I),
        Ideal.Quotient.algebraMap_eq]
      exact hfin
    set p : Ideal C := q.under C with hp
    haveI : p.IsPrime := Ideal.IsPrime.under C q
    haveI : q.LiesOver p := ⟨rfl⟩
    let Λr : R →+* p.Fiber (R ⧸ 𝔄) :=
      (Algebra.TensorProduct.includeRight : (R ⧸ 𝔄) →ₐ[C] p.Fiber (R ⧸ 𝔄)).toRingHom.comp
        (Ideal.Quotient.mk 𝔄)
    let Λ : R →ₗ[C] p.Fiber (R ⧸ 𝔄) :=
      (Algebra.TensorProduct.includeRight : (R ⧸ 𝔄) →ₐ[C] p.Fiber (R ⧸ 𝔄)).toLinearMap.comp
        (Ideal.Quotient.mkₐ C 𝔄).toLinearMap
    have hΛ : ∀ y, Λ y = Λr y := fun y => rfl
    have hIker : I ≤ RingHom.ker Λr := by
      refine sup_le ?_ ?_
      · intro y hy
        rw [RingHom.mem_ker]
        show Algebra.TensorProduct.includeRight (Ideal.Quotient.mk 𝔄 y) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hy, map_zero]
      · rw [Ideal.map_le_iff_le_comap]
        intro v hv
        rw [Ideal.mem_comap, RingHom.mem_ker]
        have hval : algebraMap C (R ⧸ 𝔄) (algebraMap V C v) =
            Ideal.Quotient.mk 𝔄 (algebraMap V R v) := by
          rw [IsScalarTower.algebraMap_apply V C R v, Ideal.Quotient.mk_algebraMap]
        have hvp : algebraMap V C v ∈ p := by
          show algebraMap C (R ⧸ 𝔄) (algebraMap V C v) ∈ q
          rw [hval]
          exact hmq (Ideal.mem_map_of_mem _ hv)
        show (1 : p.ResidueField) ⊗ₜ[C] (Ideal.Quotient.mk 𝔄 (algebraMap V R v)) = 0
        rw [← hval, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one, (Ideal.algebraMap_residueField_eq_zero).mpr hvp,
          TensorProduct.zero_tmul]
    obtain ⟨G, hG⟩ := Module.Finite.fg_top (R := C) (M := R ⧸ I)
    choose lift hlift using fun t : R ⧸ I => Ideal.Quotient.mk_surjective t
    set N : Submodule p.ResidueField (p.Fiber (R ⧸ 𝔄)) :=
      Submodule.span p.ResidueField ↑(G.image fun g => Λ (lift g)) with hN
    have hall : ∀ r : R, Λ r ∈ N := by
      let N' : Submodule C R := (N.restrictScalars C).comap Λ
      have hker : ∀ y ∈ I, y ∈ N' := by
        intro y hy
        show Λ y ∈ N
        rw [hΛ, (RingHom.mem_ker).mp (hIker hy)]
        exact N.zero_mem
      have hmap : (⊤ : Submodule C (R ⧸ I)) ≤ N'.map (Ideal.Quotient.mkₐ C I).toLinearMap := by
        rw [← hG, Submodule.span_le]
        intro g hg
        refine ⟨lift g, ?_, hlift g⟩
        show Λ (lift g) ∈ N
        exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hg))
      intro r
      obtain ⟨r', hr', he⟩ := hmap (Submodule.mem_top : Ideal.Quotient.mk I r ∈ ⊤)
      have he' : Ideal.Quotient.mk I r' = Ideal.Quotient.mk I r := he
      have hd : r' - r ∈ I := Ideal.Quotient.eq.mp he'
      have : r = r' - (r' - r) := by ring
      show r ∈ N'
      rw [this]
      exact N'.sub_mem hr' (hker _ hd)
    haveI hFfin : Module.Finite p.ResidueField (p.Fiber (R ⧸ 𝔄)) := by
      refine ⟨⟨G.image fun g => Λ (lift g), ?_⟩⟩
      rw [← hN, eq_top_iff]
      intro x _
      clear ‹x ∈ ⊤›
      induction x using TensorProduct.induction_on with
      | zero => exact N.zero_mem
      | tmul a s =>
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective s
        have h1 : a ⊗ₜ[C] (Ideal.Quotient.mk 𝔄 r) = a • Λ r := by
          show a ⊗ₜ[C] (Ideal.Quotient.mk 𝔄 r) =
            a • ((1 : p.ResidueField) ⊗ₜ[C] (Ideal.Quotient.mk 𝔄 r))
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [h1]
        exact N.smul_mem a (hall r)
      | add x y hx hy => exact N.add_mem hx hy
    let e := PrimeSpectrum.preimageEquivFiber C (R ⧸ 𝔄) ⟨p, inferInstance⟩
    let x0 : ↑(PrimeSpectrum.comap (algebraMap C (R ⧸ 𝔄)) ⁻¹'
        {(⟨p, inferInstance⟩ : PrimeSpectrum C)}) :=
      ⟨⟨q, hq⟩, PrimeSpectrum.ext rfl⟩
    set Q0 := e x0 with hQ0
    have hQ : Ideal.comap Algebra.TensorProduct.includeRight.toRingHom Q0.asIdeal = q := by
      have h1 := PrimeSpectrum.preimageEquivFiber_symm_apply_coe C (R ⧸ 𝔄) ⟨p, inferInstance⟩ Q0
      rw [hQ0, Equiv.symm_apply_apply] at h1
      exact (congrArg PrimeSpectrum.asIdeal h1).symm
    haveI : Algebra.QuasiFiniteAt p.ResidueField Q0.asIdeal := by
      unfold Algebra.QuasiFiniteAt
      infer_instance
    exact Algebra.QuasiFiniteAt.of_quasiFiniteAt_residueField p q Q0.asIdeal hQ

  have s5 : ∀ (e : ℕ) (D : Type u) [CommRing D] [Algebra (MvPolynomial (Fin e) V) D] [Algebra V D]
      [IsScalarTower V (MvPolynomial (Fin e) V) D], Algebra.Etale (MvPolynomial (Fin e) V) D →
      ringKrullDim (D ⧸ Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V)) ≤
        ((e : ℕ) : WithBot ℕ∞) := by
    intro e D _ _ _ _ hEt
    have hle : Ideal.map (algebraMap V (MvPolynomial (Fin e) V)) (IsLocalRing.maximalIdeal V) ≤
        (Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V)).comap
          (algebraMap (MvPolynomial (Fin e) V) D) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    haveI : Algebra.QuasiFinite (MvPolynomial (Fin e) V) D := inferInstance
    haveI : Algebra.QuasiFinite (MvPolynomial (Fin e) V)
        (D ⧸ Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V)) := inferInstance
    let g := Ideal.quotientMap (Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V))
      (algebraMap (MvPolynomial (Fin e) V) D) hle
    have hg : ∀ x : MvPolynomial (Fin e) V,
        g (Ideal.Quotient.mk _ x) = algebraMap (MvPolynomial (Fin e) V)
          (D ⧸ Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V)) x := by
      intro x
      rw [Ideal.quotientMap_mk]
      rfl
    let f := PrimeSpectrum.comap g
    have hf : StrictMono f := by
      intro Q1 Q2 h12
      refine lt_of_le_of_ne ?_ ?_
      · show Ideal.comap g Q1.asIdeal ≤ Ideal.comap g Q2.asIdeal
        exact Ideal.comap_mono h12.le
      · intro heq
        have h1 : Ideal.under (MvPolynomial (Fin e) V) Q1.asIdeal =
            Ideal.under (MvPolynomial (Fin e) V) Q2.asIdeal := by
          have h2 : Ideal.comap g Q1.asIdeal = Ideal.comap g Q2.asIdeal :=
            congrArg PrimeSpectrum.asIdeal heq
          ext x
          have hx : (Ideal.Quotient.mk _ x ∈ Ideal.comap g Q1.asIdeal) ↔
              (Ideal.Quotient.mk _ x ∈ Ideal.comap g Q2.asIdeal) := by rw [h2]
          simp only [Ideal.mem_comap, hg] at hx
          simpa only [Ideal.under, Ideal.mem_comap] using hx
        exact h12.ne (PrimeSpectrum.ext
          (Algebra.QuasiFinite.eq_of_le_of_under_eq _ _ h12.le h1))
    have h1 := Order.krullDim_le_of_strictMono f hf
    have hC : Ideal.map (algebraMap V (MvPolynomial (Fin e) V)) (IsLocalRing.maximalIdeal V) =
        Ideal.map (MvPolynomial.C : V →+* MvPolynomial (Fin e) V) (IsLocalRing.maximalIdeal V) := by
      rw [MvPolynomial.algebraMap_eq]
    have e1 : ringKrullDim (MvPolynomial (Fin e) V ⧸
        Ideal.map (algebraMap V (MvPolynomial (Fin e) V)) (IsLocalRing.maximalIdeal V)) =
        ringKrullDim (MvPolynomial (Fin e) (V ⧸ IsLocalRing.maximalIdeal V)) :=
      ringKrullDim_eq_of_ringEquiv ((Ideal.quotEquivOfEq hC).trans
        (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin e)
          (IsLocalRing.maximalIdeal V)).toRingEquiv.symm)
    letI : Field (V ⧸ IsLocalRing.maximalIdeal V) := Ideal.Quotient.field _
    have h3 : ringKrullDim (D ⧸ Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V)) ≤
        ringKrullDim (MvPolynomial (Fin e) V ⧸
          Ideal.map (algebraMap V (MvPolynomial (Fin e) V)) (IsLocalRing.maximalIdeal V)) := h1
    rw [e1, MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin] at h3
    exact h3
  set m := IsLocalRing.maximalIdeal V with hm
  set Ann := Module.annihilator R M with hAnn
  set J := Ann ⊔ Ideal.map (algebraMap V R) m with hJdef
  have hmJ : Ideal.map (algebraMap V R) m ≤ J := le_sup_right
  have hAnnJ : Ann ≤ J := le_sup_left
  haveI : Algebra.FiniteType V R := inferInstance

  obtain ⟨e, φ, hed, hfin, h4⟩ :=
    wcpa_pple_dvls_noether_coord V R inferInstance J hmJ 𝔭 h𝔭 hJ d hdim
  let P := MvPolynomial (Fin e) V
  letI iPR : Algebra P R := φ.toRingHom.toAlgebra
  haveI tVPR : IsScalarTower V P R :=
    IsScalarTower.of_algebraMap_eq (fun v => (φ.commutes v).symm)
  haveI : Algebra.FiniteType P R := Algebra.FiniteType.of_restrictScalars_finiteType V P R

  have hker : RingHom.ker (Ideal.Quotient.mk Ann) ≤ 𝔭 := by
    rw [Ideal.mk_ker]; exact hAnnJ.trans hJ
  set q : Ideal (R ⧸ Ann) := 𝔭.map (Ideal.Quotient.mk Ann) with hqdef
  haveI hq : q.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
  have hqc : q.comap (Ideal.Quotient.mk Ann) = 𝔭 := by
    rw [hqdef, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
    refine sup_eq_left.mpr ?_
    have : Ideal.comap (Ideal.Quotient.mk Ann) ⊥ = RingHom.ker (Ideal.Quotient.mk Ann) := rfl
    rw [this]; exact hker
  have hQF : Algebra.QuasiFiniteAt P q :=
    s2 P R inferInstance Ann hfin q hq (by rw [hqc]; exact hmJ.trans hJ)
  have hmP : Ideal.map (algebraMap V P) m ≤ 𝔭.comap (algebraMap P R) := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq,
      ← Ideal.map_le_iff_le_comap]
    exact hmJ.trans hJ

  obtain ⟨C', iC', iPC', iVC', tVPC', hEt', P₀, hP₀, hP₀c, H⟩ :=
    wcpa_pple_dvls_etale_localize V P R inferInstance M hM 𝔭 h𝔭 q hq hqc hQF hmP h4
  haveI : Algebra.Smooth P C' := Algebra.Smooth.mk
  haveI : Algebra.Smooth V C' := Algebra.Smooth.comp V P C'
  have hmC' : Ideal.map (algebraMap V C') m ≤ P₀ := by
    rw [Ideal.map_le_iff_le_comap, IsScalarTower.algebraMap_eq V P C', ← Ideal.comap_comap,
      hP₀c, ← Ideal.map_le_iff_le_comap]
    exact hmP
  obtain ⟨c, hc, hdom⟩ := wcpa_pple_dvls_domain_nbhd V C' inferInstance P₀ hP₀ hmC'
  obtain ⟨R₁, iR₁, iRR₁, iVR₁, tVRR₁, iCR₁, tVCR₁, hEt, hfinM, 𝔭₁, h𝔭₁, hc1, hc2, hc3, hc4,
    hc5, hc6⟩ := H c hc

  let C := Localization.Away c
  haveI : Algebra.Smooth C' C := Algebra.Smooth.of_isLocalization_Away c
  haveI : Algebra.Smooth V C := Algebra.Smooth.comp V C' C
  haveI : Algebra.Etale C' C := Algebra.Etale.of_isLocalizationAway c
  haveI : Algebra.Etale P C := Algebra.Etale.comp P C' C
  haveI : IsScalarTower V P C := IsScalarTower.of_algebraMap_eq (fun v => by
    rw [IsScalarTower.algebraMap_apply V C' C, IsScalarTower.algebraMap_apply V P C',
      ← IsScalarTower.algebraMap_apply P C' C])
  have hdimC := s5 e C inferInstance
  refine ⟨R₁, iR₁, iRR₁, iVR₁, tVRR₁, C, inferInstance, inferInstance, iCR₁, tVCR₁, hEt,
    inferInstance, hdom, ?_, hfinM, 𝔭₁, h𝔭₁, hc1, hc2, hc3, hc4, hc5, hc6⟩
  refine lt_of_le_of_lt hdimC ?_
  exact_mod_cast Nat.lt_succ_of_le hed

theorem wcpa_pple_dv_generic_basis : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    (C : Type u) [CommRing C] [Algebra V C], Algebra.FiniteType V C →
    IsDomain (C ⧸ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V)) →
    ∀ d : ℕ, ringKrullDim (C ⧸ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V)) < ((d + 1 : ℕ) : WithBot ℕ∞) →
    ∀ (M : Type u) [AddCommGroup M] [Module C M] [Module V M] [IsScalarTower V C M], Module.Finite C M →
    ∃ (r : ℕ) (α : (Fin r → C) →ₗ[C] M),
      (∀ u : Fin r → C, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) →
        u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → C))) ∧
      ringKrullDim (C ⧸ (Module.annihilator C (M ⧸ LinearMap.range α) ⊔ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V))) < ((d : ℕ) : WithBot ℕ∞) :=
by
  intro V _ _ _ C _ _ _ hDom d hdim M _ _ _ _ hM
  classical
  generalize hIdef : Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) = I at hDom hdim ⊢
  have hI : I.IsPrime := by rwa [Ideal.Quotient.isDomain_iff_prime] at hDom
  haveI := hI
  have hIne : I ≠ ⊤ := hI.ne_top

  have sel : ∀ (n : ℕ) (y : Fin n → M), ∃ (r : ℕ) (z : Fin r → M),
      (∀ u : Fin r → C, ∑ i, u i • z i ∈ I • (⊤ : Submodule C M) → ∀ i, u i ∈ I) ∧
      ∀ j : Fin n, ∃ t : C, t ∉ I ∧
        t • y j ∈ Submodule.span C (Set.range z) ⊔ I • (⊤ : Submodule C M) := by
    intro n
    induction n with
    | zero =>
      intro y
      exact ⟨0, Fin.elim0, fun u _ i => Fin.elim0 i, fun j => Fin.elim0 j⟩
    | succ n ih =>
      intro y
      obtain ⟨r, z, hF, hD⟩ := ih (fun j => y j.succ)
      have hmono : Submodule.span C (Set.range z) ⊔ I • (⊤ : Submodule C M) ≤
          Submodule.span C (Set.range (Fin.cons (y 0) z : Fin (r + 1) → M)) ⊔
            I • (⊤ : Submodule C M) := by
        apply sup_le_sup_right
        apply Submodule.span_mono
        rintro _ ⟨i, rfl⟩
        exact ⟨i.succ, by simp⟩
      by_cases hF' : ∀ u : Fin (r + 1) → C,
          ∑ i, u i • (Fin.cons (y 0) z : Fin (r + 1) → M) i ∈ I • (⊤ : Submodule C M) →
            ∀ i, u i ∈ I
      · refine ⟨r + 1, Fin.cons (y 0) z, hF', ?_⟩
        intro j
        induction j using Fin.cases with
        | zero =>
          refine ⟨1, (Ideal.ne_top_iff_one I).mp hIne, ?_⟩
          rw [one_smul]
          apply Submodule.mem_sup_left
          apply Submodule.subset_span
          exact ⟨0, by simp⟩
        | succ k =>
          obtain ⟨t, ht, htm⟩ := hD k
          exact ⟨t, ht, hmono htm⟩
      · push_neg at hF'
        obtain ⟨u, hu, i₀, hi₀⟩ := hF'
        rw [Fin.sum_univ_succ] at hu
        simp only [Fin.cons_zero, Fin.cons_succ] at hu
        have hu0 : u 0 ∉ I := by
          intro h0
          have h1 : u 0 • y 0 ∈ I • (⊤ : Submodule C M) :=
            Submodule.smul_mem_smul h0 Submodule.mem_top
          have h2 : ∑ k : Fin r, u k.succ • z k ∈ I • (⊤ : Submodule C M) := by
            have h3 := Submodule.sub_mem _ hu h1
            rwa [add_sub_cancel_left] at h3
          have h3 := hF (fun k => u k.succ) h2
          have hall : ∀ i, u i ∈ I := fun i =>
            Fin.cases (motive := fun i => u i ∈ I) h0 (fun k => h3 k) i
          exact hi₀ (hall i₀)
        refine ⟨r, z, hF, ?_⟩
        intro j
        induction j using Fin.cases with
        | zero =>
          refine ⟨u 0, hu0, ?_⟩
          have e : u 0 • y 0 = (u 0 • y 0 + ∑ k : Fin r, u k.succ • z k) -
              ∑ k : Fin r, u k.succ • z k := by abel
          rw [e]
          apply Submodule.sub_mem
          · exact Submodule.mem_sup_right hu
          · apply Submodule.mem_sup_left
            apply Submodule.sum_mem
            intro k _
            exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
        | succ k => exact hD k

  obtain ⟨n, y, hy⟩ := Module.Finite.exists_fin (R := C) (M := M)
  obtain ⟨r, z, hF, hD⟩ := sel n y
  choose t ht using hD
  obtain ⟨s, hs⟩ : ∃ s : C, s = ∏ j, t j := ⟨_, rfl⟩
  have hsI : s ∉ I := by
    intro h
    rw [hs] at h
    obtain ⟨j, _, hj⟩ := Ideal.IsPrime.prod_mem_iff.mp h
    exact (ht j).1 hj
  have hsM : ∀ x : M, s • x ∈ Submodule.span C (Set.range z) ⊔ I • (⊤ : Submodule C M) := by
    intro x
    have hx : x ∈ Submodule.span C (Set.range y) := by rw [hy]; exact Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      have e : s = (∏ i ∈ Finset.univ.erase j, t i) * t j := by
        rw [hs, mul_comm, Finset.mul_prod_erase _ _ (Finset.mem_univ j)]
      rw [e, mul_smul]
      exact Submodule.smul_mem _ _ (ht j).2
    | zero => rw [smul_zero]; exact Submodule.zero_mem _
    | add a b _ _ ha hb => rw [smul_add]; exact Submodule.add_mem _ ha hb
    | smul c a _ ha => rw [smul_comm]; exact Submodule.smul_mem _ c ha

  obtain ⟨α, hαdef⟩ : ∃ α : (Fin r → C) →ₗ[C] M, α = Fintype.linearCombination C z := ⟨_, rfl⟩
  have hα : ∀ u, α u = ∑ i, u i • z i := fun u => by
    rw [hαdef]; exact Fintype.linearCombination_apply C z u
  have hrange : LinearMap.range α = Submodule.span C (Set.range z) := by
    rw [hαdef]; exact Fintype.range_linearCombination C z
  have KI : ∀ (X : Type u) [AddCommGroup X] [Module C X] [Module V X] [IsScalarTower V C X]
      (x : X), x ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V X) ↔
        x ∈ I • (⊤ : Submodule C X) := by
    intro X _ _ _ _ x
    rw [← Submodule.restrictScalars_top V C X, ← Ideal.smul_restrictScalars,
      Submodule.restrictScalars_mem, hIdef]
  have hinj : ∀ u : Fin r → C, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) →
      u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → C)) := by
    intro u hu
    rw [KI M, hα] at hu
    have hui := hF u hu
    rw [KI (Fin r → C), pi_eq_sum_univ u]
    apply Submodule.sum_mem
    intro i _
    exact Submodule.smul_mem_smul (hui i) Submodule.mem_top

  have hQ : ∀ q : M ⧸ LinearMap.range α,
      s • q ∈ I • (⊤ : Submodule C (M ⧸ LinearMap.range α)) := by
    intro q
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    have h1 := hsM x
    rw [← hrange, Submodule.mem_sup] at h1
    obtain ⟨a, ha, b, hb, hab⟩ := h1
    rw [← Submodule.Quotient.mk_smul, ← hab, Submodule.Quotient.mk_add,
      (Submodule.Quotient.mk_eq_zero _).mpr ha, zero_add]
    have h2 : (LinearMap.range α).mkQ b ∈
        Submodule.map (LinearMap.range α).mkQ (I • (⊤ : Submodule C M)) :=
      Submodule.mem_map_of_mem hb
    rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ] at h2
    exact h2

  obtain ⟨p, hpmon, -, hpcoeff, hpeval⟩ :=
    LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero C
      (algebraMap C (Module.End C (M ⧸ LinearMap.range α)) s) I (by
        rintro _ ⟨q, rfl⟩
        rw [Module.algebraMap_end_apply]
        exact hQ q)
  have he : Polynomial.aeval s p ∈ Module.annihilator C (M ⧸ LinearMap.range α) := by
    rw [Module.mem_annihilator]
    intro q
    have h1 := LinearMap.congr_fun
      (Polynomial.aeval_algebraMap_apply (Module.End C (M ⧸ LinearMap.range α)) s p) q
    rw [hpeval, LinearMap.zero_apply, Module.algebraMap_end_apply] at h1
    exact h1.symm
  have hsplit : Polynomial.aeval s p =
      (∑ k ∈ Finset.range p.natDegree, p.coeff k • s ^ k) + s ^ p.natDegree := by
    rw [Polynomial.aeval_eq_sum_range, Finset.sum_range_succ, hpmon.coeff_natDegree, one_smul]
  have hρ : (∑ k ∈ Finset.range p.natDegree, p.coeff k • s ^ k) ∈ I := by
    apply Ideal.sum_mem
    intro k hk
    have hk' : k < p.natDegree := Finset.mem_range.mp hk
    have hc : p.coeff k ∈ I := Ideal.pow_le_self (by omega) (hpcoeff k)
    rw [smul_eq_mul]
    exact Ideal.mul_mem_right _ _ hc
  have hsN : s ^ p.natDegree ∈ Module.annihilator C (M ⧸ LinearMap.range α) ⊔ I := by
    have e : s ^ p.natDegree =
        Polynomial.aeval s p - ∑ k ∈ Finset.range p.natDegree, p.coeff k • s ^ k := by
      rw [hsplit]; ring
    rw [e]
    exact sub_mem (Ideal.mem_sup_left he) (Ideal.mem_sup_right hρ)

  have hsNI : s ^ p.natDegree ∉ I := fun h => hsI (hI.mem_of_pow_mem _ h)
  have hIJ : I ≤ Module.annihilator C (M ⧸ LinearMap.range α) ⊔ I := le_sup_right
  have hx0 : Ideal.Quotient.mk I (s ^ p.natDegree) ≠ 0 := by
    rw [Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hsNI
  have hnzd : Ideal.Quotient.mk I (s ^ p.natDegree) ∈ nonZeroDivisors (C ⧸ I) :=
    mem_nonZeroDivisors_of_ne_zero hx0
  have hφ : Ideal.Quotient.factor hIJ (Ideal.Quotient.mk I (s ^ p.natDegree)) = 0 := by
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem]; exact hsN
  have hle := ringKrullDim_succ_le_of_surjective (Ideal.Quotient.factor hIJ)
    (Ideal.Quotient.factor_surjective hIJ) hnzd hφ
  have hlt := lt_of_le_of_lt hle hdim
  refine ⟨r, α, hinj, ?_⟩
  push_cast at hlt
  exact lt_of_add_lt_add_right hlt

theorem wcpa_gn_fibre_reduction : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V],
    ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (E : Type u) [CommRing E] [Algebra V E],
    (∀ (L : Type u) [Field L] [Algebra (FractionRing V) L],
      IsDomain (TensorProduct (FractionRing V) L (TensorProduct V (FractionRing V) E)) ∨
        Subsingleton (TensorProduct (FractionRing V) L (TensorProduct V (FractionRing V) E))) →
    (∀ (L : Type u) [Field L] [Algebra (IsLocalRing.ResidueField V) L],
      IsDomain (TensorProduct (IsLocalRing.ResidueField V) L
          (TensorProduct V (IsLocalRing.ResidueField V) E)) ∨
        Subsingleton (TensorProduct (IsLocalRing.ResidueField V) L
          (TensorProduct V (IsLocalRing.ResidueField V) E))) →
    ∀ (L : Type u) [Field L] [Algebra V L],
      IsDomain (TensorProduct V L E) ∨ Subsingleton (TensorProduct V L E) :=
by
  intro V _ _ _ hdim E _ _ hK hk L _ _
  have transfer : ∀ (S : Type u) [CommRing S] [Algebra V S] [Algebra S L] [IsScalarTower V S L],
      (IsDomain (TensorProduct S L (TensorProduct V S E)) ∨
        Subsingleton (TensorProduct S L (TensorProduct V S E))) →
      IsDomain (TensorProduct V L E) ∨ Subsingleton (TensorProduct V L E) := by
    intro S _ _ _ _ h
    let e := Algebra.TensorProduct.cancelBaseChange V S L L E
    rcases h with h | h
    · left
      exact MulEquiv.isDomain (TensorProduct S L (TensorProduct V S E)) e.symm.toMulEquiv
    · right
      exact Equiv.subsingleton e.symm.toEquiv
  haveI : Ring.KrullDimLE 1 V := Ring.krullDimLE_iff.mpr hdim
  set φ := algebraMap V L with hφ
  haveI hp : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
  by_cases hbot : RingHom.ker φ = ⊥
  · have hinj : Function.Injective φ := (RingHom.injective_iff_ker_eq_bot φ).mpr hbot
    letI : Algebra (FractionRing V) L :=
      (IsFractionRing.lift (K := FractionRing V) hinj).toAlgebra
    haveI : IsScalarTower V (FractionRing V) L :=
      IsScalarTower.of_algebraMap_eq (fun x => (IsFractionRing.lift_algebraMap hinj x).symm)
    exact transfer (FractionRing V) (hK L)
  · have hmax : (RingHom.ker φ).IsMaximal := Ideal.isMaximal_of_isPrime_of_ne_bot _ hbot
    have hm : RingHom.ker φ = IsLocalRing.maximalIdeal V := IsLocalRing.eq_maximalIdeal hmax
    haveI : IsLocalHom φ := by
      refine ⟨fun a ha => ?_⟩
      have h1 : a ∉ RingHom.ker φ := by
        rw [RingHom.mem_ker]
        exact ha.ne_zero
      rw [hm] at h1
      exact (IsLocalRing.notMem_maximalIdeal).mp h1
    letI : Algebra (IsLocalRing.ResidueField V) L :=
      (IsLocalRing.ResidueField.lift φ).toAlgebra
    haveI : IsScalarTower V (IsLocalRing.ResidueField V) L :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact (IsLocalRing.ResidueField.lift_residue_apply φ x).symm)
    exact transfer (IsLocalRing.ResidueField V) (hk L)

theorem wcpa_gn_geom_integral_of_algClosure : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A]
    [Algebra F A],
    (IsDomain (TensorProduct F (AlgebraicClosure F) A) ∨
      Subsingleton (TensorProduct F (AlgebraicClosure F) A)) →
    ∀ (L : Type u) [Field L] [Algebra F L],
      IsDomain (TensorProduct F L A) ∨ Subsingleton (TensorProduct F L A) :=
by
  have s2 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R] [Algebra K R],
      Algebra.FiniteType K R → ∀ (𝔫 : Ideal R), 𝔫.IsMaximal →
      ∃ χ : R →ₐ[K] K, ∀ r : R, χ r = 0 ↔ r ∈ 𝔫 := by
    intro K _ _ R _ _ hR 𝔫 h𝔫
    haveI := h𝔫
    letI : Field (R ⧸ 𝔫) := Ideal.Quotient.field 𝔫
    haveI : Module.Finite K (R ⧸ 𝔫) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ 𝔫)
    haveI : Algebra.IsIntegral K (R ⧸ 𝔫) := Algebra.IsIntegral.of_finite K _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := R ⧸ 𝔫)
    let e : K ≃ₐ[K] R ⧸ 𝔫 := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ 𝔫)) hbij
    refine ⟨(e.symm : R ⧸ 𝔫 →ₐ[K] K).comp (Ideal.Quotient.mkₐ K 𝔫), fun r => ?_⟩
    change e.symm (Ideal.Quotient.mk 𝔫 r) = 0 ↔ r ∈ 𝔫
    rw [map_eq_zero_iff _ e.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
  have s3 : ∀ (K : Type u) [Field K] (Ω : Type u) [Field Ω] [Algebra K Ω] (R : Type u)
      [CommRing R] [IsDomain R] [Algebra K R], Algebra.FiniteType K R →
      (∀ (𝔫 : Ideal R), 𝔫.IsMaximal → ∃ χ : R →ₐ[K] K, ∀ r : R, χ r = 0 ↔ r ∈ 𝔫) →
      IsDomain (TensorProduct K Ω R) := by
    intro K _ Ω _ _ R _ _ _ hR hpt
    classical
    haveI : Nontrivial (TensorProduct K Ω R) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain K Ω R
        (algebraMap K Ω).injective (algebraMap K R).injective
    haveI hJ : IsJacobsonRing R := isJacobsonRing_of_finiteType (A := K)
    have hjac : ∀ x : R, (∀ 𝔫 : Ideal R, 𝔫.IsMaximal → x ∈ 𝔫) → x = 0 := by
      intro x hx
      have h1 : (⊥ : Ideal R).jacobson = ⊥ := hJ.out Ideal.isRadical_bot
      have h2 : x ∈ (⊥ : Ideal R).jacobson := by
        rw [Ideal.jacobson, Ideal.mem_sInf]
        rintro J ⟨_, hJ⟩
        exact hx J hJ
      rw [h1] at h2
      exact h2
    let b := Module.Basis.ofVectorSpace K Ω
    let e := TensorProduct.equivFinsuppOfBasisLeft (R := K) (M := Ω) (N := R) b
    have heval : ∀ (χ : R →ₐ[K] K) (x : TensorProduct K Ω R),
        Algebra.TensorProduct.productMap (AlgHom.id K Ω) ((Algebra.ofId K Ω).comp χ) x = 0 →
        ∀ i, χ (e x i) = 0 := by
      intro χ x hx
      let φ := Algebra.TensorProduct.productMap (AlgHom.id K Ω) ((Algebra.ofId K Ω).comp χ)
      have hlin : φ.toLinearMap ∘ₗ e.symm.toLinearMap =
          b.repr.symm.toLinearMap ∘ₗ Finsupp.mapRange.linearMap χ.toLinearMap := by
        apply Finsupp.lhom_ext
        intro i r
        simp [φ, e, TensorProduct.equivFinsuppOfBasisLeft_symm_apply, Algebra.smul_def, mul_comm]
      have h1 := LinearMap.congr_fun hlin (e x)
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
        LinearEquiv.symm_apply_apply, AlgHom.toLinearMap_apply] at h1
      have h2 : b.repr.symm (Finsupp.mapRange.linearMap χ.toLinearMap (e x)) = 0 := by
        rw [← h1]; exact hx
      have h3 : Finsupp.mapRange.linearMap χ.toLinearMap (e x) = 0 := by
        have := congrArg b.repr h2
        simpa using this
      intro i
      have := congrArg (fun c => c i) h3
      simpa using this
    refine @NoZeroDivisors.to_isDomain _ _ _ ⟨fun {f g} hfg => ?_⟩
    have hdiv : ∀ i k, e f i * e g k = 0 := by
      intro i k
      apply hjac
      intro 𝔫 h𝔫
      obtain ⟨χ, hχ⟩ := hpt 𝔫 h𝔫
      have hm := congrArg (Algebra.TensorProduct.productMap (AlgHom.id K Ω)
        ((Algebra.ofId K Ω).comp χ)) hfg
      rw [map_mul, map_zero] at hm
      rcases mul_eq_zero.mp hm with h | h
      · exact Ideal.mul_mem_right _ _ ((hχ _).mp (heval χ f h i))
      · exact Ideal.mul_mem_left _ _ ((hχ _).mp (heval χ g h k))
    by_cases hf : e f = 0
    · left
      have := congrArg e.symm hf
      simpa using this
    · right
      obtain ⟨i, hi⟩ : ∃ i, e f i ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        exact hf (Finsupp.ext hcon)
      have hg : e g = 0 := by
        ext k
        exact (mul_eq_zero.mp (hdiv i k)).resolve_left hi
      have := congrArg e.symm hg
      simpa using this
  have s4inj : ∀ (K : Type u) [Field K] (Ω : Type u) [Field Ω] [Algebra K Ω] (B : Type u)
      [CommRing B] [Algebra K B] (T : Finset B),
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id K Ω)
        (Algebra.adjoin K (T : Set B)).val) := by
    intro K _ Ω _ _ B _ _ T
    have h1 : ∀ x, Algebra.TensorProduct.map (AlgHom.id K Ω) (Algebra.adjoin K (T : Set B)).val x =
        LinearMap.lTensor Ω (Algebra.adjoin K (T : Set B)).val.toLinearMap x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a c => simp
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have h2 := Module.Flat.lTensor_preserves_injective_linearMap (M := Ω)
      ((Algebra.adjoin K (T : Set B)).val.toLinearMap) Subtype.val_injective
    intro a b hab
    apply h2
    rw [← h1, ← h1]
    exact hab
  have s4mono : ∀ (K : Type u) [Field K] (Ω : Type u) [Field Ω] [Algebra K Ω] (B : Type u)
      [CommRing B] [Algebra K B] (T T' : Finset B), T ⊆ T' →
      ∀ (y : TensorProduct K Ω (Algebra.adjoin K (T : Set B))),
      ∃ y', Algebra.TensorProduct.map (AlgHom.id K Ω) (Algebra.adjoin K (T' : Set B)).val y' =
        Algebra.TensorProduct.map (AlgHom.id K Ω) (Algebra.adjoin K (T : Set B)).val y := by
    intro K _ Ω _ _ B _ _ T T' hT y
    have hs : Algebra.adjoin K (T : Set B) ≤ Algebra.adjoin K (T' : Set B) :=
      Algebra.adjoin_mono (Finset.coe_subset.mpr hT)
    have e : Algebra.TensorProduct.map (AlgHom.id K Ω) (Algebra.adjoin K (T : Set B)).val =
        (Algebra.TensorProduct.map (AlgHom.id K Ω) (Algebra.adjoin K (T' : Set B)).val).comp
          (Algebra.TensorProduct.map (AlgHom.id K Ω) (Subalgebra.inclusion hs)) := by
      rw [← Algebra.TensorProduct.map_comp, Subalgebra.val_comp_inclusion, AlgHom.id_comp]
    refine ⟨Algebra.TensorProduct.map (AlgHom.id K Ω) (Subalgebra.inclusion hs) y, ?_⟩
    rw [e, AlgHom.comp_apply]
  have s4 : ∀ (K : Type u) [Field K] (Ω : Type u) [Field Ω] [Algebra K Ω] (B : Type u)
      [CommRing B] [IsDomain B] [Algebra K B],
      (∀ T : Finset B, IsDomain (TensorProduct K Ω (Algebra.adjoin K (T : Set B)))) →
      IsDomain (TensorProduct K Ω B) := by
    intro K _ Ω _ _ B _ _ _ h
    classical
    have hcov : ∀ x : TensorProduct K Ω B, ∃ T : Finset B, ∃ y,
        Algebra.TensorProduct.map (AlgHom.id K Ω) (Algebra.adjoin K (T : Set B)).val y = x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨∅, 0, map_zero _⟩
      | tmul a c => exact ⟨{c}, a ⊗ₜ ⟨c, Algebra.subset_adjoin (by simp)⟩, by simp⟩
      | add x y hx hy =>
        obtain ⟨T1, y1, h1⟩ := hx
        obtain ⟨T2, y2, h2⟩ := hy
        obtain ⟨z1, hz1⟩ := s4mono K Ω B T1 (T1 ∪ T2) Finset.subset_union_left y1
        obtain ⟨z2, hz2⟩ := s4mono K Ω B T2 (T1 ∪ T2) Finset.subset_union_right y2
        exact ⟨T1 ∪ T2, z1 + z2, by rw [map_add, hz1, hz2, h1, h2]⟩
    haveI : Nontrivial (TensorProduct K Ω B) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain K Ω B
        (algebraMap K Ω).injective (algebraMap K B).injective
    refine @NoZeroDivisors.to_isDomain _ _ _ ⟨fun {f g} hfg => ?_⟩
    obtain ⟨T1, y1, h1⟩ := hcov f
    obtain ⟨T2, y2, h2⟩ := hcov g
    obtain ⟨z1, hz1⟩ := s4mono K Ω B T1 (T1 ∪ T2) Finset.subset_union_left y1
    obtain ⟨z2, hz2⟩ := s4mono K Ω B T2 (T1 ∪ T2) Finset.subset_union_right y2
    haveI := h (T1 ∪ T2)
    have hz : z1 * z2 = 0 := by
      apply s4inj K Ω B (T1 ∪ T2)
      rw [map_mul, map_zero, hz1, hz2, h1, h2, hfg]
    rcases mul_eq_zero.mp hz with h0 | h0
    · left; rw [← h1, ← hz1, h0, map_zero]
    · right; rw [← h2, ← hz2, h0, map_zero]
  have s6 : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A] [Algebra F A],
      (∀ (Ω : Type u) [Field Ω] [Algebra (AlgebraicClosure F) Ω],
        IsDomain (TensorProduct (AlgebraicClosure F) Ω (TensorProduct F (AlgebraicClosure F) A))) →
      ∀ (L : Type u) [Field L] [Algebra F L], IsDomain (TensorProduct F L A) := by
    intro F _ A _ _ h L _ _
    let j : AlgebraicClosure F →ₐ[F] AlgebraicClosure L := IsAlgClosed.lift
    letI : Algebra (AlgebraicClosure F) (AlgebraicClosure L) := j.toRingHom.toAlgebra
    haveI : IsScalarTower F (AlgebraicClosure F) (AlgebraicClosure L) :=
      IsScalarTower.of_algebraMap_eq (fun x => (j.commutes x).symm)
    let E := Algebra.TensorProduct.cancelBaseChange F (AlgebraicClosure F) (AlgebraicClosure L)
      (AlgebraicClosure L) A
    haveI := h (AlgebraicClosure L)
    let ι := Algebra.TensorProduct.map (IsScalarTower.toAlgHom F L (AlgebraicClosure L))
      (AlgHom.id F A)
    have hι : Function.Injective ι := by
      have h1 : ∀ x, ι x =
          LinearMap.rTensor A (IsScalarTower.toAlgHom F L (AlgebraicClosure L)).toLinearMap x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a c => simp [ι]
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      have h2 := Module.Flat.rTensor_preserves_injective_linearMap (M := A)
        ((IsScalarTower.toAlgHom F L (AlgebraicClosure L)).toLinearMap)
        (algebraMap L (AlgebraicClosure L)).injective
      intro a b hab
      apply h2
      rw [← h1, ← h1]
      exact hab
    let g : TensorProduct F L A →+* TensorProduct (AlgebraicClosure F) (AlgebraicClosure L)
        (TensorProduct F (AlgebraicClosure F) A) :=
      E.symm.toRingEquiv.toRingHom.comp ι.toRingHom
    have hg : Function.Injective g := fun a b hab => hι (E.symm.injective hab)
    exact Function.Injective.isDomain g hg
  intro F _ A _ _ hyp L _ _
  rcases hyp with hdom | hsub
  · left
    have key : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Ω : Type u) [Field Ω] [Algebra K Ω]
        (B : Type u) [CommRing B] [IsDomain B] [Algebra K B], IsDomain (TensorProduct K Ω B) := by
      intro K _ _ Ω _ _ B _ _ _
      apply s4 K Ω B
      intro T
      have hfin : Algebra.FiniteType K (Algebra.adjoin K (T : Set B)) :=
        (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset T)
      exact s3 K Ω _ hfin (fun 𝔫 h𝔫 => s2 K _ hfin 𝔫 h𝔫)
    exact s6 F A (fun Ω _ _ => key (AlgebraicClosure F) Ω _) L
  · right
    haveI := hsub
    haveI hA : Subsingleton A :=
      (Algebra.TensorProduct.includeRight_injective (R := F) (A := AlgebraicClosure F) (B := A)
        (algebraMap F _).injective).subsingleton
    have h10 : (1 : TensorProduct F L A) = 0 := by
      rw [Algebra.TensorProduct.one_def, Subsingleton.elim (1 : A) 0, TensorProduct.tmul_zero]
    exact subsingleton_of_zero_eq_one h10.symm

theorem wcpa_gn_special_fibre : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    [HenselianLocalRing V], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (D : Type u) [CommRing D] [Algebra V D], Algebra.Smooth V D →
    ∀ (𝔓 : Ideal D) [𝔓.IsPrime], Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V) ≤ 𝔓 →
    (∀ x : 𝔓.ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) →
    ∃ c₁ : D, c₁ ∉ 𝔓 ∧
      IsDomain (TensorProduct V (IsLocalRing.ResidueField V) (Localization.Away c₁)) ∧
      ∀ θ : FractionRing (TensorProduct V (IsLocalRing.ResidueField V) (Localization.Away c₁)),
        IsAlgebraic (IsLocalRing.ResidueField V) θ →
        ∃ a : IsLocalRing.ResidueField V, algebraMap (IsLocalRing.ResidueField V) _ a = θ :=
by
  intro V _ _ _ _ _hdim D _ _ hsm 𝔓 _ hm hiv
  classical

  have s1 : ∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [Algebra k B], Algebra.Smooth k B →
      ∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro k _ B _ _ hsmB Q _
    haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap k B))) := by
      refine (HasRingHomProperty.Spec_iff (P := @Smooth) (Q := @RingHom.Smooth)).mpr ?_
      rw [CommRingCat.hom_ofHom]
      exact RingHom.smooth_algebraMap.mpr hsmB
    obtain ⟨h1, h2⟩ := wc_fntame_smooth_stalk_normal k (Spec (CommRingCat.of B))
      (Spec.map (CommRingCat.ofHom (algebraMap k B))) (⟨Q, inferInstance⟩ : PrimeSpectrum B)
    let e := (Spec.stalkIso (CommRingCat.of B) ⟨Q, inferInstance⟩).commRingCatIsoToRingEquiv
    exact ⟨MulEquiv.isDomain _ e.symm.toMulEquiv, IsIntegrallyClosed.of_equiv e⟩

  have s6 : ∀ (E : Type u) [CommRing E] [Algebra V E] (K : Type u) [Field K] [Algebra V K]
      (g : E →ₐ[V] K), (∀ a ∈ IsLocalRing.maximalIdeal V, algebraMap V K a = 0) →
      ∃ ψ : TensorProduct V (IsLocalRing.ResidueField V) E →ₐ[V] K, ∀ e : E, ψ (1 ⊗ₜ e) = g e := by
    intro E _ _ K _ _ g h
    let ι : IsLocalRing.ResidueField V →ₐ[V] K :=
      Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal V) (Algebra.ofId V K) h
    refine ⟨Algebra.TensorProduct.productMap ι g, fun e => ?_⟩
    rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]

  have s3 : ∀ (T : Type u) [CommRing T] [Algebra V T] [Algebra (IsLocalRing.ResidueField V) T]
      [IsScalarTower V (IsLocalRing.ResidueField V) T] (K : Type u) [Field K] [Algebra V K]
      (ψ : T →ₐ[V] K), (∀ x : K, IsIntegral V x → ∃ a : V, algebraMap V K a = x) →
      ∀ (P : Ideal T) [P.IsPrime], RingHom.ker ψ = P →
      ∀ y : Localization.AtPrime P, IsIntegral (IsLocalRing.ResidueField V) y →
        ∃ a : IsLocalRing.ResidueField V,
          y - algebraMap (IsLocalRing.ResidueField V) (Localization.AtPrime P) a ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
    intro T _ _ _ _ K _ _ ψ hivK P _ hP y hy
    have hf : ∀ t : P.primeCompl, IsUnit (ψ t) := by
      rintro ⟨t, ht⟩
      apply isUnit_iff_ne_zero.mpr
      intro h0
      have htP : t ∈ P := by
        rw [← hP]
        exact RingHom.mem_ker.mpr h0
      exact ht htP
    let ψ' : Localization.AtPrime P →ₐ[V] K := IsLocalization.liftAlgHom (M := P.primeCompl) (f := ψ) hf
    have hyV : IsIntegral V y := isIntegral_trans (R := V) (A := IsLocalRing.ResidueField V) y hy
    obtain ⟨a, ha⟩ := hivK (ψ' y) (hyV.map ψ')
    refine ⟨algebraMap V (IsLocalRing.ResidueField V) a, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 := hu.map ψ'
    rw [map_sub, ← IsScalarTower.algebraMap_apply, AlgHom.commutes, ← ha, sub_self] at h1
    exact not_isUnit_zero h1

  have s4 : ∀ (k : Type u) [Field k] (T : Type u) [CommRing T] [IsDomain T] [Algebra k T]
      (P : Ideal T) [P.IsPrime], IsIntegrallyClosed (Localization.AtPrime P) →
      (∀ y : Localization.AtPrime P, IsIntegral k y → ∃ a : k,
        y - algebraMap k (Localization.AtPrime P) a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P)) →
      ∀ θ : FractionRing T, IsAlgebraic k θ → ∃ a : k, algebraMap k (FractionRing T) a = θ := by
    intro k _ T _ _ _ P _ hic hcong θ hθ
    haveI : IsDomain (Localization.AtPrime P) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors P)
    letI : Algebra (Localization.AtPrime P) (FractionRing T) :=
      IsLocalization.localizationAlgebraOfSubmonoidLe _ _ P.primeCompl (nonZeroDivisors T)
        (Ideal.primeCompl_le_nonZeroDivisors P)
    haveI : IsScalarTower T (Localization.AtPrime P) (FractionRing T) :=
      IsLocalization.localization_isScalarTower_of_submonoid_le _ _ _ _ _
    haveI : IsFractionRing (Localization.AtPrime P) (FractionRing T) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization P.primeCompl _ _
    haveI : IsScalarTower k (Localization.AtPrime P) (FractionRing T) :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        rw [IsScalarTower.algebraMap_apply k T (FractionRing T),
          IsScalarTower.algebraMap_apply k T (Localization.AtPrime P),
          ← IsScalarTower.algebraMap_apply T (Localization.AtPrime P) (FractionRing T)])
    have hθi : IsIntegral k θ := hθ.isIntegral
    have hθT : IsIntegral T θ := hθi.tower_top
    have hθP : IsIntegral (Localization.AtPrime P) θ := hθT.tower_top
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hθP
    let j := IsScalarTower.toAlgHom k (Localization.AtPrime P) (FractionRing T)
    have hj : Function.Injective j := IsFractionRing.injective (Localization.AtPrime P) (FractionRing T)
    have hjy : j y = θ := hy
    have hyk : IsIntegral k y := (isIntegral_algHom_iff j hj).mp (by rw [hjy]; exact hθi)
    obtain ⟨a, ha⟩ := hcong y hyk
    refine ⟨a, ?_⟩
    have hu0 : y - algebraMap k _ a = 0 := by
      by_contra hne
      have hint : IsIntegral k (y - algebraMap k _ a) := hyk.sub isIntegral_algebraMap
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp ha)) (hint.isUnit hne)
    rw [sub_eq_zero] at hu0
    rw [← hy, hu0, ← IsScalarTower.algebraMap_apply]

  have hkill : ∀ a ∈ IsLocalRing.maximalIdeal V, algebraMap V 𝔓.ResidueField a = 0 := by
    intro a ha
    rw [IsScalarTower.algebraMap_apply V D 𝔓.ResidueField, Ideal.algebraMap_residueField_eq_zero]
    exact hm (Ideal.mem_map_of_mem _ ha)
  obtain ⟨c, hc, hdomc⟩ := wcpa_pple_dvls_domain_nbhd V D hsm 𝔓 inferInstance hm
  refine ⟨c, hc, ?_⟩
  let e1 := Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away c)
    (IsLocalRing.maximalIdeal V)
  let e2 := Algebra.TensorProduct.comm V (IsLocalRing.ResidueField V) (Localization.Away c)
  let e : TensorProduct V (IsLocalRing.ResidueField V) (Localization.Away c) ≃+*
      (Localization.Away c ⧸ Ideal.map (algebraMap V (Localization.Away c)) (IsLocalRing.maximalIdeal V)) :=
    e2.toRingEquiv.trans e1.symm.toRingEquiv
  haveI hTdom : IsDomain (TensorProduct V (IsLocalRing.ResidueField V) (Localization.Away c)) :=
    MulEquiv.isDomain _ e.toMulEquiv
  refine ⟨hTdom, ?_⟩
  haveI : Algebra.Smooth D (Localization.Away c) := Algebra.Smooth.of_isLocalization_Away c
  haveI : Algebra.Smooth V (Localization.Away c) := Algebra.Smooth.comp V D (Localization.Away c)
  haveI hsmT : Algebra.Smooth (IsLocalRing.ResidueField V)
      (TensorProduct V (IsLocalRing.ResidueField V) (Localization.Away c)) :=
    Algebra.Smooth.baseChange V (Localization.Away c) (IsLocalRing.ResidueField V)
  have hf : ∀ y : Submonoid.powers c, IsUnit ((IsScalarTower.toAlgHom V D 𝔓.ResidueField) y) := by
    rintro ⟨y, n, rfl⟩
    rw [IsScalarTower.toAlgHom_apply, map_pow]
    apply IsUnit.pow
    apply isUnit_iff_ne_zero.mpr
    rw [Ne, Ideal.algebraMap_residueField_eq_zero]
    exact hc
  let g₁ : Localization.Away c →ₐ[V] 𝔓.ResidueField :=
    IsLocalization.liftAlgHom (M := Submonoid.powers c) (f := IsScalarTower.toAlgHom V D 𝔓.ResidueField) hf
  obtain ⟨ψ, -⟩ := s6 (Localization.Away c) 𝔓.ResidueField g₁ hkill
  haveI hP : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  have hic := (s1 (IsLocalRing.ResidueField V) _ hsmT (RingHom.ker ψ)).2
  have hcong := s3 _ 𝔓.ResidueField ψ hiv (RingHom.ker ψ) rfl
  exact s4 (IsLocalRing.ResidueField V) _ (RingHom.ker ψ) hic hcong

theorem wcpa_gn_regular_extension : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A] [IsDomain A]
    [Algebra F A],
    (∀ θ : FractionRing A, IsAlgebraic F θ → ∃ a : F, algebraMap F _ a = θ) →
    IsReduced (TensorProduct F (AlgebraicClosure F) A) →
    IsDomain (TensorProduct F (AlgebraicClosure F) A) :=
by

  have s1 : ∀ (F K : Type u) [Field F] [Field K] [Algebra F K],
      (∀ θ : K, IsAlgebraic F θ → ∃ a : F, algebraMap F K a = θ) →
      ∀ f : Polynomial F, f.Monic → Irreducible f → Irreducible (f.map (algebraMap F K)) := by
    intro F K _ _ _ hK f hm hirr
    have hinj : Function.Injective (Polynomial.map (algebraMap F K)) :=
      Polynomial.map_injective _ (algebraMap F K).injective
    have hlift : ∀ p : Polynomial K, p.Monic → p ∣ f.map (algebraMap F K) →
        ∃ p0 : Polynomial F, p0.map (algebraMap F K) = p ∧ p0.Monic := by
      intro p hp hdvd
      have hcoef : ∀ i, IsIntegral F (p.coeff i) :=
        Polynomial.isIntegral_coeff_of_dvd f p hm hp hdvd
      have hl : p ∈ Polynomial.lifts (algebraMap F K) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        obtain ⟨a, ha⟩ := hK _ (hcoef n).isAlgebraic
        exact ⟨a, ha⟩
      obtain ⟨p0, h1, _, h3⟩ := Polynomial.lifts_and_degree_eq_and_monic hl hp
      exact ⟨p0, h1, h3⟩
    rw [(hm.map (algebraMap F K)).irreducible_iff_natDegree]
    have hf := hm.irreducible_iff_natDegree.mp hirr
    refine ⟨fun h1 => hf.1 (hinj (by rw [h1, Polynomial.map_one])), ?_⟩
    intro a b ha hb hab
    obtain ⟨a0, ha0, ha0m⟩ := hlift a ha ⟨b, hab.symm⟩
    obtain ⟨b0, hb0, hb0m⟩ := hlift b hb ⟨a, by rw [← hab, mul_comm]⟩
    have hab0 : a0 * b0 = f := hinj (by rw [Polynomial.map_mul, ha0, hb0, hab])
    rcases hf.2 a0 b0 ha0m hb0m hab0 with h | h
    · left; rw [← ha0, Polynomial.natDegree_map]; exact h
    · right; rw [← hb0, Polynomial.natDegree_map]; exact h

  have s2 : ∀ (F K L : Type u) [Field F] [Field K] [Field L]
      [Algebra F K] [Algebra F L] (pb : PowerBasis F L),
      Irreducible ((minpoly F pb.gen).map (algebraMap F K)) →
      IsDomain (TensorProduct F L K) := by
    intro F K L _ _ _ _ _ pb hirr
    set f := minpoly F pb.gen with hfdef
    set g := f.map (algebraMap F K) with hgdef
    haveI : Fact (Irreducible g) := ⟨hirr⟩
    have hfm : f.Monic := minpoly.monic pb.isIntegral_gen
    have hg0 : g ≠ 0 := hirr.ne_zero
    have h0 : Polynomial.aeval (AdjoinRoot.root g) f = 0 := by
      rw [← Polynomial.aeval_map_algebraMap K, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    let φ : L →ₐ[F] AdjoinRoot g := pb.lift (AdjoinRoot.root g) h0
    let ψ : TensorProduct F K L →ₐ[K] AdjoinRoot g :=
      Algebra.TensorProduct.lift (Algebra.ofId K (AdjoinRoot g)) φ (fun _ _ => Commute.all _ _)
    have hsurj : Function.Surjective ψ := by
      have : ψ.range = ⊤ := by
        rw [eq_top_iff, ← AdjoinRoot.adjoinRoot_eq_top, Algebra.adjoin_le_iff]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        refine ⟨TensorProduct.tmul F (1 : K) pb.gen, ?_⟩
        simp [ψ, φ, Algebra.TensorProduct.lift_tmul, PowerBasis.lift_gen]
      exact (AlgHom.range_eq_top ψ).mp this
    haveI : Module.Finite F L := pb.finite
    haveI : Module.Finite K (AdjoinRoot g) := (AdjoinRoot.powerBasis hg0).finite
    have hd1 : Module.finrank K (TensorProduct F K L) = f.natDegree := by
      rw [Module.finrank_baseChange, PowerBasis.finrank pb, ← pb.natDegree_minpoly]
    have hd2 : Module.finrank K (AdjoinRoot g) = f.natDegree := by
      rw [(AdjoinRoot.powerBasis hg0).finrank, AdjoinRoot.powerBasis_dim, hfm.natDegree_map]
    have hinj : Function.Injective ψ :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hd1.trans hd2.symm)
        (f := ψ.toLinearMap)).mpr hsurj
    haveI : IsDomain (TensorProduct F K L) := hinj.isDomain ψ.toRingHom
    exact (Algebra.TensorProduct.comm F L K).toRingEquiv.toMulEquiv.isDomain

  have s3 : ∀ (F E K : Type u) [Field F] [Field E] [Field K]
      [Algebra F E] [Algebra F K], Algebra.IsAlgebraic F E →
      (∀ L : IntermediateField F E, FiniteDimensional F L → IsDomain (TensorProduct F L K)) →
      IsDomain (TensorProduct F E K) := by
    intro F E K _ _ _ _ _ halg hL
    let ι : ∀ L : IntermediateField F E, TensorProduct F L K →ₐ[F] TensorProduct F E K :=
      fun L => Algebra.TensorProduct.map L.val (AlgHom.id F K)
    have hι : ∀ L, Function.Injective (ι L) := by
      intro L
      have e : (ι L).toLinearMap = LinearMap.rTensor K L.val.toLinearMap := by
        apply TensorProduct.ext'
        intro x y
        rfl
      have h := Module.Flat.rTensor_preserves_injective_linearMap (M := K) L.val.toLinearMap
        L.val.injective
      rw [← e] at h
      exact h
    have hz : ∀ L, ι L 0 = 0 := fun L => (ι L).toRingHom.map_zero
    have h1 : ∀ L, ι L 1 = 1 := fun L => (ι L).toRingHom.map_one
    have hadd : ∀ L x y, ι L (x + y) = ι L x + ι L y := fun L => (ι L).toRingHom.map_add
    have hmul : ∀ L x y, ι L (x * y) = ι L x * ι L y := fun L => (ι L).toRingHom.map_mul
    have hmono : ∀ L₁ L₂ : IntermediateField F E, L₁ ≤ L₂ → ∀ x, ι L₁ x ∈ (ι L₂).range := by
      intro L₁ L₂ hle x
      induction x using TensorProduct.induction_on with
      | zero => rw [hz]; exact Subalgebra.zero_mem _
      | tmul l k => exact ⟨TensorProduct.tmul F (IntermediateField.inclusion hle l) k, rfl⟩
      | add x y hx hy => rw [hadd]; exact Subalgebra.add_mem _ hx hy
    have hint : Algebra.IsIntegral F E := Algebra.IsAlgebraic.isIntegral
    have hfin : ∀ T : Finset E,
        FiniteDimensional F (IntermediateField.adjoin F (T : Set E)) := by
      intro T
      haveI : Finite (T : Set E) := T.finite_toSet.to_subtype
      exact IntermediateField.finiteDimensional_adjoin (fun x _ => hint.isIntegral x)
    have hadj : ∀ T T' : Finset E, T ⊆ T' →
        IntermediateField.adjoin F (T : Set E) ≤ IntermediateField.adjoin F (T' : Set E) := by
      intro T T' h
      exact IntermediateField.adjoin.mono F _ _ (Finset.coe_subset.mpr h)
    have hcov : ∀ x : TensorProduct F E K, ∃ T : Finset E,
        x ∈ (ι (IntermediateField.adjoin F (T : Set E))).range := by
      classical
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨∅, Subalgebra.zero_mem _⟩
      | tmul e k =>
        refine ⟨{e}, ⟨TensorProduct.tmul F
          (⟨e, IntermediateField.subset_adjoin F _ (by simp)⟩ :
            IntermediateField.adjoin F (({e} : Finset E) : Set E)) k, rfl⟩⟩
      | add x y hx hy =>
        obtain ⟨Tx, hTx⟩ := hx
        obtain ⟨Ty, hTy⟩ := hy
        refine ⟨Tx ∪ Ty, Subalgebra.add_mem _ ?_ ?_⟩
        · obtain ⟨x', rfl⟩ := hTx
          exact hmono _ _ (hadj _ _ Finset.subset_union_left) x'
        · obtain ⟨y', rfl⟩ := hTy
          exact hmono _ _ (hadj _ _ Finset.subset_union_right) y'
    have hcov2 : ∀ x y : TensorProduct F E K, ∃ T : Finset E,
        x ∈ (ι (IntermediateField.adjoin F (T : Set E))).range ∧
        y ∈ (ι (IntermediateField.adjoin F (T : Set E))).range := by
      classical
      intro x y
      obtain ⟨Tx, x', rfl⟩ := hcov x
      obtain ⟨Ty, y', rfl⟩ := hcov y
      exact ⟨Tx ∪ Ty, hmono _ _ (hadj _ _ Finset.subset_union_left) x',
        hmono _ _ (hadj _ _ Finset.subset_union_right) y'⟩
    have hnt : Nontrivial (TensorProduct F E K) := by
      have hD := hL _ (hfin ∅)
      have hN := hD.toNontrivial
      refine ⟨⟨1, 0, fun h => ?_⟩⟩
      have h' : ι (IntermediateField.adjoin F ((∅ : Finset E) : Set E)) 1 =
          ι (IntermediateField.adjoin F ((∅ : Finset E) : Set E)) 0 := by
        rw [h1, hz]; exact h
      exact (@one_ne_zero _ _ _ (@NeZero.one _ _ hN)) (hι _ h')
    have hnzd : NoZeroDivisors (TensorProduct F E K) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨T, ⟨x', hx'⟩, ⟨y', hy'⟩⟩ := hcov2 x y
      have hx'' : ι _ x' = x := hx'
      have hy'' : ι _ y' = y := hy'
      have hD := hL _ (hfin T)
      have hZ := @IsDomain.to_noZeroDivisors _ _ hD
      have h : x' * y' = 0 := hι _ (by rw [hmul, hz, hx'', hy'']; exact hxy)
      rcases hZ.eq_zero_or_eq_zero_of_mul_eq_zero h with h | h
      · left; rw [← hx'', h, hz]
      · right; rw [← hy'', h, hz]
    exact @NoZeroDivisors.to_isDomain _ _ hnt hnzd

  have s4 : ∀ (F Ω : Type u) [Field F] [Field Ω] [Algebra F Ω]
      (S : IntermediateField F Ω), IsPurelyInseparable S Ω →
      ∀ (A : Type u) [CommRing A] [Algebra F A],
      IsDomain (TensorProduct F S A) → IsReduced (TensorProduct F Ω A) →
      IsDomain (TensorProduct F Ω A) := by
    intro F Ω _ _ _ S hS A _ _ hdom hred
    let ι : TensorProduct F S A →ₐ[F] TensorProduct F Ω A :=
      Algebra.TensorProduct.map S.val (AlgHom.id F A)
    have hι : Function.Injective ι := by
      have e : ι.toLinearMap = LinearMap.rTensor A S.val.toLinearMap := by
        apply TensorProduct.ext'
        intro x y
        rfl
      have h := Module.Flat.rTensor_preserves_injective_linearMap (M := A) S.val.toLinearMap
        S.val.injective
      rw [← e] at h
      exact h
    have hz : ι 0 = 0 := ι.toRingHom.map_zero
    have h1 : ι 1 = 1 := ι.toRingHom.map_one
    have hmul : ∀ x y, ι (x * y) = ι x * ι y := ι.toRingHom.map_mul
    have hnt : Nontrivial (TensorProduct F Ω A) := by
      have hN := hdom.toNontrivial
      refine ⟨⟨1, 0, fun h => ?_⟩⟩
      have h' : ι 1 = ι 0 := by rw [h1, hz]; exact h
      exact (@one_ne_zero _ _ _ (@NeZero.one _ _ hN)) (hι h')
    set q := ringExpChar F with hqdef
    haveI hF : ExpChar F q := ringExpChar.expChar F
    haveI : ExpChar (TensorProduct F Ω A) q :=
      expChar_of_injective_algebraMap (algebraMap F (TensorProduct F Ω A)).injective q
    have hup : ∀ z : TensorProduct F Ω A, ∀ n m : ℕ, z ^ q ^ n ∈ ι.range →
        z ^ q ^ (n + m) ∈ ι.range := by
      intro z n m h
      rw [pow_add, pow_mul]
      exact Subalgebra.pow_mem _ h _
    have hfrob : ∀ x : TensorProduct F Ω A, ∃ N : ℕ, x ^ q ^ N ∈ ι.range := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [pow_zero, pow_one]; exact Subalgebra.zero_mem _⟩
      | tmul ω a =>
        obtain ⟨n, s, hs⟩ := IsPurelyInseparable.pow_mem S q ω
        refine ⟨n, ⟨TensorProduct.tmul F s (a ^ q ^ n), ?_⟩⟩
        change ι (TensorProduct.tmul F s (a ^ q ^ n)) = (TensorProduct.tmul F ω a) ^ q ^ n
        rw [Algebra.TensorProduct.tmul_pow, ← hs]
        rfl
      | add x y hx hy =>
        obtain ⟨Nx, hNx⟩ := hx
        obtain ⟨Ny, hNy⟩ := hy
        refine ⟨Nx + Ny, ?_⟩
        rw [add_pow_expChar_pow]
        refine Subalgebra.add_mem _ (hup x Nx Ny hNx) ?_
        rw [add_comm Nx Ny]
        exact hup y Ny Nx hNy
    have hnzd : NoZeroDivisors (TensorProduct F Ω A) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨Nx, hNx⟩ := hfrob x
      obtain ⟨Ny, hNy⟩ := hfrob y
      obtain ⟨a, ha⟩ := hup x Nx Ny hNx
      obtain ⟨b, hb⟩ := hup y Ny Nx hNy
      rw [add_comm Ny Nx] at hb
      have ha' : ι a = x ^ q ^ (Nx + Ny) := ha
      have hb' : ι b = y ^ q ^ (Nx + Ny) := hb
      have hqpos : 0 < q ^ (Nx + Ny) := pow_pos (expChar_pos F q) _
      have hab : a * b = 0 := by
        apply hι
        rw [hmul, ha', hb', hz, ← mul_pow, hxy, zero_pow hqpos.ne']
      have hZ := @IsDomain.to_noZeroDivisors _ _ hdom
      rcases hZ.eq_zero_or_eq_zero_of_mul_eq_zero hab with h | h
      · left
        rw [h, hz] at ha'
        exact IsReduced.eq_zero x ⟨_, ha'.symm⟩
      · right
        rw [h, hz] at hb'
        exact IsReduced.eq_zero y ⟨_, hb'.symm⟩
    exact @NoZeroDivisors.to_isDomain _ _ hnt hnzd

  intro F _ A _ _ _ hH1 hH2
  set Ω := AlgebraicClosure F
  set S := separableClosure F Ω
  set K := FractionRing A
  have h5 : ∀ L : IntermediateField F S, FiniteDimensional F L →
      IsDomain (TensorProduct F L K) := by
    intro L hL
    haveI : Algebra.IsSeparable F L := Algebra.isSeparable_tower_bot_of_isSeparable F L S
    let pb := Field.powerBasisOfFiniteOfSeparable F L
    have hirr := s1 F K hH1 (minpoly F pb.gen) (minpoly.monic pb.isIntegral_gen)
      (minpoly.irreducible pb.isIntegral_gen)
    exact s2 F K L pb hirr
  have h6 : IsDomain (TensorProduct F S K) :=
    s3 F S K (Algebra.IsSeparable.isAlgebraic F S) h5
  have h7 : IsDomain (TensorProduct F S A) := by
    let ι₂ : TensorProduct F S A →ₐ[F] TensorProduct F S K :=
      Algebra.TensorProduct.map (AlgHom.id F S) (IsScalarTower.toAlgHom F A K)
    have e : ι₂.toLinearMap =
        LinearMap.lTensor S (IsScalarTower.toAlgHom F A K).toLinearMap := by
      apply TensorProduct.ext'
      intro x y
      rfl
    have h := Module.Flat.lTensor_preserves_injective_linearMap (M := S)
      (IsScalarTower.toAlgHom F A K).toLinearMap (IsFractionRing.injective A K)
    rw [← e] at h
    exact h.isDomain ι₂.toRingHom
  exact s4 F Ω S inferInstance A h7 hH2

theorem wcpa_gfn_derivative_conductor : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsIntegrallyClosed P]
    (f G c q : Polynomial P) (p : P) (N : ℕ), f.Monic → q.Monic → p ≠ 0 →
    f ∣ G ^ N * Polynomial.aeval c (q.scaleRoots p) →
    ∃ b : Polynomial P, f ∣ G * Polynomial.derivative f * c - Polynomial.C p * b :=
by
  intro P _ _ _ f G c q p N hf hq hp hdiv
  classical

  obtain ⟨L, _, _, _, hι⟩ : ∃ (L : Type u) (_ : Field L) (_ : IsAlgClosed L) (_ : Algebra P L),
      Function.Injective (algebraMap P L) := by
    refine ⟨AlgebraicClosure (FractionRing P), inferInstance, inferInstance, inferInstance, ?_⟩
    rw [IsScalarTower.algebraMap_eq P (FractionRing P) (AlgebraicClosure (FractionRing P))]
    exact (algebraMap (FractionRing P) (AlgebraicClosure (FractionRing P))).injective.comp
      (IsFractionRing.injective P (FractionRing P))
  have hp' : algebraMap P L p ≠ 0 := fun h => hp (hι (h.trans (map_zero _).symm))

  have s1 : ∀ (u : Polynomial L) (m : Multiset L),
      (m.map (fun a => Polynomial.X - Polynomial.C a)).prod ∣
        u * Polynomial.derivative (m.map (fun a => Polynomial.X - Polynomial.C a)).prod -
        (m.map (fun a => Polynomial.C (u.eval a) *
          ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum := by
    intro u m
    induction m using Multiset.induction_on with
    | empty => simp
    | cons a m ih =>
      have hsub : ∀ b ∈ m, (((a ::ₘ m).erase b).map (fun b => Polynomial.X - Polynomial.C b)).prod
          = (Polynomial.X - Polynomial.C a) *
            ((m.erase b).map (fun b => Polynomial.X - Polynomial.C b)).prod := by
        intro b hb
        by_cases hab : b = a
        · subst hab
          rw [Multiset.erase_cons_head]
          exact (Multiset.prod_map_erase hb).symm
        · rw [Multiset.erase_cons_tail_of_mem hb, Multiset.map_cons, Multiset.prod_cons]
      have hS : ((a ::ₘ m).map (fun b => Polynomial.C (u.eval b) *
            (((a ::ₘ m).erase b).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum
          = Polynomial.C (u.eval a) * (m.map (fun b => Polynomial.X - Polynomial.C b)).prod +
            (Polynomial.X - Polynomial.C a) * (m.map (fun b => Polynomial.C (u.eval b) *
              ((m.erase b).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum := by
        rw [Multiset.map_cons, Multiset.sum_cons, Multiset.erase_cons_head]
        congr 1
        rw [← Multiset.sum_map_mul_left]
        congr 1
        apply Multiset.map_congr rfl
        intro b hb
        rw [hsub b hb]
        ring
      rw [hS, Multiset.map_cons, Multiset.prod_cons, Polynomial.derivative_mul,
        Polynomial.derivative_X_sub_C, one_mul]
      generalize (m.map (fun b => Polynomial.X - Polynomial.C b)).prod = F at ih ⊢
      generalize (m.map (fun b => Polynomial.C (u.eval b) *
              ((m.erase b).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum = S at ih ⊢
      have key : u * (F + (Polynomial.X - Polynomial.C a) * Polynomial.derivative F) -
          (Polynomial.C (u.eval a) * F + (Polynomial.X - Polynomial.C a) * S)
          = (u - Polynomial.C (u.eval a)) * F +
            (Polynomial.X - Polynomial.C a) * (u * Polynomial.derivative F - S) := by ring
      rw [key]
      exact dvd_add (mul_dvd_mul Polynomial.X_sub_C_dvd_sub_C_eval dvd_rfl) (mul_dvd_mul_left _ ih)

  have s2 : ∀ (m : Multiset L) (w : L → L),
      ((m.map (fun a => Polynomial.C (w a) *
        ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum).degree
        < (Multiset.card m : WithBot ℕ) := by
    intro m w
    rw [← Polynomial.mem_degreeLT]
    refine multiset_sum_mem _ ?_
    intro x hx
    obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hx
    rw [Polynomial.mem_degreeLT]
    have h1 : (Polynomial.C (w a) *
        ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod).natDegree
          ≤ Multiset.card (m.erase a) := by
      refine (Polynomial.natDegree_C_mul_le _ _).trans ?_
      rw [Polynomial.natDegree_multiset_prod_X_sub_C_eq_card]
    have h2 : Multiset.card (m.erase a) < Multiset.card m := Multiset.card_erase_lt_of_mem ha
    calc _ ≤ ((Polynomial.C (w a) *
          ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod).natDegree : WithBot ℕ) :=
          Polynomial.degree_le_natDegree
      _ < _ := by exact_mod_cast lt_of_le_of_lt h1 h2

  have s3 : ∀ (m : Multiset L) (w : L → L), (∀ b ∈ m, _root_.IsIntegral P b) →
      (∀ a ∈ m, _root_.IsIntegral P (w a)) → ∀ k : ℕ,
      _root_.IsIntegral P (((m.map (fun a => Polynomial.C (w a) *
        ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum).coeff k) := by
    intro m w hm hw k
    let φ : integralClosure P L →+* L := algebraMap (integralClosure P L) L
    have hX : ∀ b ∈ m, (Polynomial.X - Polynomial.C b) ∈ Polynomial.lifts φ := by
      intro b hb
      refine (Polynomial.mem_lifts _).mpr ⟨Polynomial.X - Polynomial.C ⟨b, hm b hb⟩, ?_⟩
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
      rfl
    have hmem : (m.map (fun a => Polynomial.C (w a) *
        ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum
          ∈ Polynomial.lifts φ := by
      refine Subsemiring.multiset_sum_mem _ _ ?_
      intro x hx
      obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hx
      refine mul_mem ?_ ?_
      · have e : Polynomial.C (w a) = Polynomial.C (φ ⟨w a, hw a ha⟩) := rfl
        rw [e]
        exact Polynomial.C_mem_lifts _ _
      · refine Subsemiring.multiset_prod_mem _ _ ?_
        intro y hy
        obtain ⟨b, hb, rfl⟩ := Multiset.mem_map.mp hy
        exact hX b (Multiset.mem_of_mem_erase hb)
    obtain ⟨s, hs⟩ := (Polynomial.lifts_iff_coeff_lifts _).mp hmem k
    rw [← hs]
    exact s.2

  have s4 : ∀ a : L, Polynomial.aeval a f = 0 → _root_.IsIntegral P a →
      _root_.IsIntegral P (Polynomial.aeval a G * Polynomial.aeval a c / algebraMap P L p) := by
    intro a ha haint
    have hG : _root_.IsIntegral P (Polynomial.aeval a G) :=
      adjoin_le_integralClosure haint (Polynomial.aeval_mem_adjoin_singleton P a)
    by_cases hG0 : Polynomial.aeval a G = 0
    · rw [hG0, zero_mul, zero_div]; exact isIntegral_zero
    obtain ⟨k, hk⟩ := hdiv
    have h1 : Polynomial.aeval a (G ^ N * Polynomial.aeval c (q.scaleRoots p)) = 0 := by
      rw [hk, map_mul, ha, zero_mul]
    rw [map_mul, map_pow] at h1
    have h2 : Polynomial.aeval a (Polynomial.aeval c (q.scaleRoots p)) = 0 :=
      (mul_eq_zero.mp h1).resolve_left (pow_ne_zero _ hG0)
    have e := Polynomial.aeval_algHom_apply (Polynomial.aeval a) c (q.scaleRoots p)
    rw [← e] at h2
    have hy : Polynomial.aeval a c
        = algebraMap P L p * (Polynomial.aeval a c / algebraMap P L p) :=
      (mul_div_cancel₀ _ hp').symm
    rw [hy, Polynomial.aeval_def, Polynomial.scaleRoots_eval₂_mul, ← Polynomial.aeval_def] at h2
    have h3 := (mul_eq_zero.mp h2).resolve_left (pow_ne_zero _ hp')
    have hyint : _root_.IsIntegral P (Polynomial.aeval a c / algebraMap P L p) :=
      ⟨q, hq, by rw [← Polynomial.aeval_def]; exact h3⟩
    rw [mul_div_assoc]
    exact hG.mul hyint

  have s5 : ∀ r : P, _root_.IsIntegral P (algebraMap P L r / algebraMap P L p) → p ∣ r := by
    intro r h
    let φ : FractionRing P →ₐ[P] L :=
      IsFractionRing.liftAlgHom (K := FractionRing P) (g := Algebra.ofId P L) hι
    have hφinj : Function.Injective φ := φ.toRingHom.injective
    have hpK : algebraMap P (FractionRing P) p ≠ 0 :=
      fun h0 => hp (IsFractionRing.injective P (FractionRing P) (h0.trans (map_zero _).symm))
    have hx : φ (algebraMap P (FractionRing P) r / algebraMap P (FractionRing P) p)
        = algebraMap P L r / algebraMap P L p := by
      rw [map_div₀, AlgHom.commutes, AlgHom.commutes]
    rw [← hx, isIntegral_algHom_iff φ hφinj] at h
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp h
    refine ⟨y, IsFractionRing.injective P (FractionRing P) ?_⟩
    rw [map_mul, mul_comm, hy, div_mul_cancel₀ _ hpK]

  have hfLm : (f.map (algebraMap P L)).Monic := hf.map _
  have hsplit := IsAlgClosed.splits (f.map (algebraMap P L))
  have hfac : f.map (algebraMap P L) = ((f.map (algebraMap P L)).roots.map
      (fun a => Polynomial.X - Polynomial.C a)).prod := hsplit.eq_prod_roots_of_monic hfLm
  have hcard : Multiset.card (f.map (algebraMap P L)).roots = f.natDegree := by
    rw [← hsplit.natDegree_eq_card_roots, hf.natDegree_map]
  have hdeg : (f.map (algebraMap P L)).degree = (f.natDegree : WithBot ℕ) := by
    rw [hf.degree_map, Polynomial.degree_eq_natDegree hf.ne_zero]
  have hroot : ∀ b ∈ (f.map (algebraMap P L)).roots, Polynomial.aeval b f = 0 := by
    intro b hb
    rw [Polynomial.mem_roots hfLm.ne_zero, Polynomial.IsRoot.def,
      Polynomial.eval_map_algebraMap] at hb
    exact hb
  have hint : ∀ b ∈ (f.map (algebraMap P L)).roots, _root_.IsIntegral P b :=
    fun b hb => ⟨f, hf, by rw [← Polynomial.aeval_def]; exact hroot b hb⟩
  generalize hm : (f.map (algebraMap P L)).roots = m at hfac hcard hroot hint

  obtain ⟨u, hu⟩ : ∃ u : Polynomial L,
      u = Polynomial.C (algebraMap P L p)⁻¹ * (G * c).map (algebraMap P L) := ⟨_, rfl⟩
  have hw : ∀ a ∈ m, _root_.IsIntegral P (u.eval a) := by
    intro a ha
    have e : u.eval a = Polynomial.aeval a G * Polynomial.aeval a c / algebraMap P L p := by
      rw [hu, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.map_mul, Polynomial.eval_mul,
        Polynomial.eval_map_algebraMap, Polynomial.eval_map_algebraMap, inv_mul_eq_div]
    rw [e]
    exact s4 a (hroot a ha) (hint a ha)
  have h1 := s1 u m
  rw [← hfac] at h1
  have hRint := s3 m (fun a => u.eval a) hint hw
  have hRdeg := s2 m (fun a => u.eval a)
  rw [hcard, ← hdeg] at hRdeg
  generalize (m.map (fun a => Polynomial.C (u.eval a) *
    ((m.erase a).map (fun b => Polynomial.X - Polynomial.C b)).prod)).sum = R at h1 hRint hRdeg

  obtain ⟨r, Q0, hTdec, hrdeg⟩ : ∃ r Q0 : Polynomial P,
      r + f * Q0 = G * Polynomial.derivative f * c ∧ r.degree < f.degree :=
    ⟨(G * Polynomial.derivative f * c) %ₘ f, (G * Polynomial.derivative f * c) /ₘ f,
      Polynomial.modByMonic_add_div (G * Polynomial.derivative f * c) f,
      Polynomial.degree_modByMonic_lt (G * Polynomial.derivative f * c) hf⟩
  have e1 : u * Polynomial.derivative (f.map (algebraMap P L))
      = Polynomial.C (algebraMap P L p)⁻¹ * (r.map (algebraMap P L) +
        f.map (algebraMap P L) * Q0.map (algebraMap P L)) := by
    rw [hu, Polynomial.derivative_map, mul_assoc]
    congr 1
    rw [← Polynomial.map_mul, ← Polynomial.map_mul, ← Polynomial.map_add, hTdec]
    congr 1
    ring
  have hdvd : f.map (algebraMap P L) ∣
      Polynomial.C (algebraMap P L p)⁻¹ * r.map (algebraMap P L) - R := by
    have e2 : Polynomial.C (algebraMap P L p)⁻¹ * r.map (algebraMap P L) - R
        = (u * Polynomial.derivative (f.map (algebraMap P L)) - R) -
          f.map (algebraMap P L) * (Polynomial.C (algebraMap P L p)⁻¹ * Q0.map (algebraMap P L)) := by
      rw [e1]; ring
    rw [e2]
    exact dvd_sub h1 (dvd_mul_right _ _)
  have hDdeg : (Polynomial.C (algebraMap P L p)⁻¹ * r.map (algebraMap P L) - R).degree
      < (f.map (algebraMap P L)).degree := by
    refine lt_of_le_of_lt (Polynomial.degree_sub_le _ _) (max_lt ?_ hRdeg)
    rw [Polynomial.degree_C_mul (inv_ne_zero hp'), hf.degree_map]
    exact lt_of_le_of_lt Polynomial.degree_map_le hrdeg
  have hD0 := Polynomial.eq_zero_of_dvd_of_degree_lt hdvd hDdeg
  rw [sub_eq_zero] at hD0

  have hcoef : ∀ k, p ∣ r.coeff k := by
    intro k
    apply s5
    have := congrArg (fun g => g.coeff k) hD0
    simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map] at this
    rw [div_eq_inv_mul, this]
    exact hRint k
  obtain ⟨b, hb⟩ := (Polynomial.C_dvd_iff_dvd_coeff p r).mpr hcoef
  refine ⟨b, ⟨Q0, ?_⟩⟩
  rw [hb] at hTdec
  rw [← hTdec]
  ring

theorem wcpa_gfn_std_etale_elements : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S]
    (E : StandardEtalePresentation R S),
    (∀ s : S, ∃ (c : Polynomial R) (k : ℕ),
      s * Polynomial.aeval E.x E.g ^ k = Polynomial.aeval E.x c) ∧
    (∀ h : Polynomial R, Polynomial.aeval E.x h = 0 → ∃ N : ℕ, E.f ∣ E.g ^ N * h) :=
by
  intro R _ S _ _ E
  classical
  let I : Ideal (Polynomial (Polynomial R)) :=
    Ideal.span {Polynomial.C E.f, Polynomial.X * Polynomial.C E.g - 1}
  let φ := E.lift E.x E.hasMap
  let mk : Polynomial (Polynomial R) →+* E.Ring := Ideal.Quotient.mk I
  let ψ : Polynomial R →ₐ[R] E.Ring := (Ideal.Quotient.mkₐ R I).comp Polynomial.CAlgHom
  have hψX : ψ Polynomial.X = E.X := rfl
  have hψ : ∀ h : Polynomial R, ψ h = mk (Polynomial.C h) := fun h => rfl
  have hmkC : ∀ h : Polynomial R, Polynomial.aeval E.X h = mk (Polynomial.C h) := by
    intro h
    rw [← hψX, Polynomial.aeval_algHom_apply, Polynomial.aeval_X_left_apply, hψ]
  have hbr : ∀ h : Polynomial R, Polynomial.aeval E.x h = φ (Polynomial.aeval E.X h) := by
    intro h
    rw [← Polynomial.aeval_algHom_apply]
    exact congrArg (fun y => Polynomial.aeval y h) (E.lift_X E.x E.hasMap).symm
  have hG : Polynomial.aeval E.X E.g * mk Polynomial.X = 1 :=
    E.P.aeval_X_g_mul_mk_X
  have key : ∀ p : Polynomial (Polynomial R), ∃ (c : Polynomial R) (k : ℕ),
      mk p * Polynomial.aeval E.X E.g ^ k = Polynomial.aeval E.X c := by
    intro p
    induction p using Polynomial.induction_on with
    | C a => exact ⟨a, 0, by rw [pow_zero, mul_one, hmkC]⟩
    | add p q hp hq =>
      obtain ⟨c₁, k₁, h₁⟩ := hp
      obtain ⟨c₂, k₂, h₂⟩ := hq
      refine ⟨c₁ * E.g ^ k₂ + c₂ * E.g ^ k₁, k₁ + k₂, ?_⟩
      rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, ← h₁, ← h₂, pow_add]
      ring
    | monomial n a ih =>
      obtain ⟨c, k, h⟩ := ih
      refine ⟨c, k + 1, ?_⟩
      rw [← h, pow_succ Polynomial.X n, ← mul_assoc, map_mul mk, pow_succ]
      linear_combination
        (mk (Polynomial.C a * Polynomial.X ^ n) *
          Polynomial.aeval E.X E.g ^ k) * hG
  refine ⟨?_, ?_⟩
  · intro s
    obtain ⟨z, hz⟩ := E.lift_bijective.2 s
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective (I := I) z
    change φ (mk p) = s at hz
    obtain ⟨c, k, hck⟩ := key p
    refine ⟨c, k, ?_⟩
    rw [← hz, hbr, hbr, ← map_pow, ← map_mul, hck]
  · intro h hh
    rw [hbr, hmkC] at hh
    have h1 : mk (Polynomial.C h) = 0 :=
      E.lift_bijective.1 (hh.trans (map_zero φ).symm)
    have h2 : Polynomial.C h ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp h1
    obtain ⟨A, B, hAB⟩ := Ideal.mem_span_pair.mp h2
    have hAB' : A * Polynomial.C E.f + (B * Polynomial.X * Polynomial.C E.g - B) =
        Polynomial.C h := by
      rw [← hAB]; ring
    have h0 : A.coeff 0 * E.f - B.coeff 0 = h := by
      have := congrArg (fun q => Polynomial.coeff q 0) hAB'
      simp only [Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_mul_C,
        Polynomial.coeff_mul_X_zero, Polynomial.coeff_C_zero, zero_mul, zero_sub] at this
      rw [← this]; ring
    have hs : ∀ i : ℕ, A.coeff (i + 1) * E.f + B.coeff i * E.g - B.coeff (i + 1) = 0 := by
      intro i
      have := congrArg (fun q => Polynomial.coeff q (i + 1)) hAB'
      simp only [Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_mul_C,
        Polynomial.coeff_mul_X, Polynomial.coeff_C_succ] at this
      rw [← this]; ring
    have hstep : ∀ i : ℕ, E.f ∣ E.g ^ i * h + B.coeff i := by
      intro i
      induction i with
      | zero => exact ⟨A.coeff 0, by rw [pow_zero, one_mul, ← h0]; ring⟩
      | succ i ih =>
        obtain ⟨q, hq⟩ := ih
        refine ⟨E.g * q + A.coeff (i + 1), ?_⟩
        linear_combination E.g * hq - hs i
    refine ⟨B.natDegree + 1, ?_⟩
    have := hstep (B.natDegree + 1)
    rwa [Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_succ_self _), add_zero] at this

theorem wcpa_gfn_std_etale_int_closed : ∀ (P : Type u) [CommRing P] [IsDomain P] (B : Type u) [CommRing B]
    [Algebra P B] (x : B) (f g : Polynomial P), f.Monic → Polynomial.aeval x f = 0 →
    IsUnit (Polynomial.aeval x g) → IsUnit (Polynomial.aeval x (Polynomial.derivative f)) →
    (∀ b : B, ∃ (c : Polynomial P) (k : ℕ), b * Polynomial.aeval x g ^ k = Polynomial.aeval x c) →
    (∀ h : Polynomial P, Polynomial.aeval x h = 0 → ∃ N : ℕ, f ∣ g ^ N * h) →
    (∀ (s : P) (b : B), s ≠ 0 → algebraMap P B s * b = 0 → b = 0) →
    (∀ (G c q : Polynomial P) (p : P) (N : ℕ), q.Monic → p ≠ 0 →
      f ∣ G ^ N * Polynomial.aeval c (q.scaleRoots p) →
      ∃ b : Polynomial P, f ∣ G * Polynomial.derivative f * c - Polynomial.C p * b) →
    ∀ z : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)), IsIntegral B z →
      ∃ b : B, algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) b = z :=
by
  intro P _ _ B _ _ x f g hf hfx hg hd hel hker htf hcond z hz
  classical

  have hinj : Function.Injective
      (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))) := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    obtain ⟨⟨m, hm⟩, hmb⟩ := (IsLocalization.map_eq_zero_iff
      (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)) _ b).mp hb
    obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp hm
    refine htf s b (nonZeroDivisors.ne_zero hs) ?_
    rw [hsm]
    exact hmb

  have s2 : ∀ z₁ : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)),
      IsIntegral B z₁ → ∃ K : ℕ, IsIntegral P
        (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
          (Polynomial.aeval x g ^ K) * z₁) := by
    intro z₁ hz₁
    rcases subsingleton_or_nontrivial B with hB | hB
    · refine ⟨0, ?_⟩
      haveI : Subsingleton (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) :=
        (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))).codomain_trivial
      rw [Subsingleton.elim (algebraMap B (Localization (Algebra.algebraMapSubmonoid B
        (nonZeroDivisors P))) (Polynomial.aeval x g ^ 0) * z₁) 0]
      exact isIntegral_zero
    have hx : IsIntegral P x := ⟨f, hf, by rw [← Polynomial.aeval_def]; exact hfx⟩
    have hmem : ∀ c : Polynomial P, Polynomial.aeval x c ∈ Algebra.adjoin P {x} :=
      fun c => Polynomial.aeval_mem_adjoin_singleton P x
    have hyR : Polynomial.aeval x g ∈ Algebra.adjoin P {x} := hmem g
    choose cf kf hck using hel
    obtain ⟨Φ, hΦm, hΦ⟩ := hz₁
    obtain ⟨K, hK⟩ : ∃ K, ∀ i ≤ Φ.natDegree, kf (Φ.coeff i) ≤ K :=
      ⟨∑ i ∈ Finset.range (Φ.natDegree + 1), kf (Φ.coeff i), fun i hi =>
        Finset.single_le_sum (f := fun j => kf (Φ.coeff j)) (fun j _ => Nat.zero_le _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))⟩
    refine ⟨K, ?_⟩
    have hγR : Polynomial.aeval x g ^ K ∈ Algebra.adjoin P {x} := Subalgebra.pow_mem _ hyR K
    have hγΦ : ∀ i, Polynomial.aeval x g ^ K * Φ.coeff i ∈ Algebra.adjoin P {x} := by
      intro i
      by_cases hi : i ≤ Φ.natDegree
      · have hle := hK i hi
        have e : Polynomial.aeval x g ^ K * Φ.coeff i =
            Polynomial.aeval x g ^ (K - kf (Φ.coeff i)) * Polynomial.aeval x (cf (Φ.coeff i)) := by
          rw [← hck]
          calc Polynomial.aeval x g ^ K * Φ.coeff i
              = Polynomial.aeval x g ^ (K - kf (Φ.coeff i) + kf (Φ.coeff i)) * Φ.coeff i := by
                rw [Nat.sub_add_cancel hle]
            _ = _ := by rw [pow_add]; ring
        rw [e]
        exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hyR _) (hmem _)
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), mul_zero]
        exact Subalgebra.zero_mem _
    have hcoef : ∀ i, (Φ.scaleRoots (Polynomial.aeval x g ^ K)).coeff i ∈ Algebra.adjoin P {x} := by
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i Φ.natDegree with h | h | h
      · have e : Φ.coeff i * (Polynomial.aeval x g ^ K) ^ (Φ.natDegree - i) =
            (Polynomial.aeval x g ^ K * Φ.coeff i) *
              (Polynomial.aeval x g ^ K) ^ (Φ.natDegree - i - 1) := by
          rw [show Φ.natDegree - i = (Φ.natDegree - i - 1) + 1 by omega, pow_succ]
          rw [show Φ.natDegree - i - 1 + 1 - 1 = Φ.natDegree - i - 1 by omega]
          ring
        rw [e]
        exact Subalgebra.mul_mem _ (hγΦ i) (Subalgebra.pow_mem _ hγR _)
      · rw [h, Nat.sub_self, pow_zero, mul_one]
        have e : Φ.coeff Φ.natDegree = 1 := hΦm
        rw [e]
        exact Subalgebra.one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
        exact Subalgebra.zero_mem _
    have hlift : Φ.scaleRoots (Polynomial.aeval x g ^ K) ∈
        Polynomial.lifts (algebraMap (Algebra.adjoin P {x}) B) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨_, hcoef i⟩, rfl⟩
    obtain ⟨Ψ, hΨmap, -, hΨm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff _).mpr hΦm)
    have hroot : Polynomial.aeval (algebraMap B (Localization (Algebra.algebraMapSubmonoid B
        (nonZeroDivisors P))) (Polynomial.aeval x g ^ K) * z₁)
        (Φ.scaleRoots (Polynomial.aeval x g ^ K)) = 0 :=
      Polynomial.scaleRoots_aeval_eq_zero (by rw [Polynomial.aeval_def]; exact hΦ)
    have hint0 : IsIntegral (Algebra.adjoin P {x})
        (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
          (Polynomial.aeval x g ^ K) * z₁) :=
      ⟨Ψ, hΨm, by rw [← Polynomial.aeval_def, ← Polynomial.aeval_map_algebraMap B, hΨmap, hroot]⟩
    haveI : Algebra.IsIntegral P (Algebra.adjoin P {x}) :=
      Algebra.IsIntegral.adjoin (fun y hy => by rw [Set.mem_singleton_iff.mp hy]; exact hx)
    exact isIntegral_trans _ hint0

  have s3 : ∀ (w : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) (s : P)
      (c : Polynomial P), s ≠ 0 → IsIntegral P w →
      w * algebraMap P (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) s =
        algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
          (Polynomial.aeval x c) →
      ∃ b : B, algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) b
        = w := by
    intro w s c hs hw hwc
    obtain ⟨q, hqm, hq⟩ := hw
    have h1 : Polynomial.aeval (algebraMap P (Localization (Algebra.algebraMapSubmonoid B
        (nonZeroDivisors P))) s * w) (q.scaleRoots s) = 0 :=
      Polynomial.scaleRoots_aeval_eq_zero (by rw [Polynomial.aeval_def]; exact hq)
    rw [mul_comm, hwc] at h1
    have h3 : Polynomial.aeval (Polynomial.aeval x c) (q.scaleRoots s) = 0 := by
      apply hinj
      have e := Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom P B
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))))
        (Polynomial.aeval x c) (q.scaleRoots s)
      simp only [IsScalarTower.coe_toAlgHom'] at e
      rw [map_zero, ← e, h1]
    have h4 : Polynomial.aeval x (Polynomial.aeval c (q.scaleRoots s)) = 0 := by
      have e := Polynomial.aeval_algHom_apply (Polynomial.aeval x) c (q.scaleRoots s)
      rw [← e]
      exact h3
    obtain ⟨N, hN⟩ := hker _ h4
    obtain ⟨b₀, t, ht⟩ := hcond g c q s N hqm hs hN
    have h5 : Polynomial.aeval x g * Polynomial.aeval x (Polynomial.derivative f) *
        Polynomial.aeval x c = algebraMap P B s * Polynomial.aeval x b₀ := by
      have e := congrArg (Polynomial.aeval x) ht
      simp only [map_sub, map_mul, Polynomial.aeval_C, hfx, zero_mul] at e
      exact sub_eq_zero.mp e
    have hm : algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
        (algebraMap P B s) =
        algebraMap P (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) s :=
      (IsScalarTower.algebraMap_apply P B _ s).symm
    have hmunit : IsUnit (algebraMap P
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) s) := by
      rw [← hm]
      exact IsLocalization.map_units
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
        (⟨algebraMap P B s, Algebra.mem_algebraMapSubmonoid_of_mem
          (⟨s, mem_nonZeroDivisors_of_ne_zero hs⟩ : nonZeroDivisors P)⟩ :
          Algebra.algebraMapSubmonoid B (nonZeroDivisors P))
    have hv : IsUnit (Polynomial.aeval x g * Polynomial.aeval x (Polynomial.derivative f)) :=
      hg.mul hd
    have h6 : algebraMap P (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) s *
        (algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
          (Polynomial.aeval x g * Polynomial.aeval x (Polynomial.derivative f)) * w -
        algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
          (Polynomial.aeval x b₀)) = 0 := by
      have e := congrArg (algebraMap B
        (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))) h5
      simp only [map_mul] at e
      rw [hm, ← hwc] at e
      rw [map_mul]
      linear_combination e
    have h7 := sub_eq_zero.mp (hmunit.mul_right_eq_zero.mp h6)
    refine ⟨↑hv.unit⁻¹ * Polynomial.aeval x b₀, ?_⟩
    rw [map_mul, ← h7, ← mul_assoc, ← map_mul, IsUnit.val_inv_mul, map_one, one_mul]

  obtain ⟨⟨b, m⟩, rfl⟩ := IsLocalization.mk'_surjective
    (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)) z
  obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp m.2
  have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
  have hzm := IsLocalization.mk'_spec
    (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) b m
  obtain ⟨c, k, hck⟩ := hel b
  have hz1 : IsIntegral B (algebraMap B
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)))
      (Polynomial.aeval x g ^ k) * IsLocalization.mk'
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) b m) :=
    isIntegral_algebraMap.mul hz
  obtain ⟨K, hK⟩ := s2 _ hz1
  obtain ⟨b', hb'⟩ := s3 _ s (g ^ K * c) hs0 hK (by
    rw [IsScalarTower.algebraMap_apply P B
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))), hsm,
      mul_assoc, mul_assoc, hzm, ← map_mul, ← map_mul, Polynomial.aeval_mul,
      map_pow, ← hck]
    congr 1
    ring)
  have e : (↑(hg.pow (K + k)).unit⁻¹ : B) * (Polynomial.aeval x g ^ K * Polynomial.aeval x g ^ k)
      = 1 := by
    rw [← pow_add]
    exact IsUnit.val_inv_mul _
  refine ⟨↑(hg.pow (K + k)).unit⁻¹ * b', ?_⟩
  rw [map_mul, hb', ← mul_assoc, ← map_mul, ← mul_assoc, ← map_mul, mul_assoc, e, map_one,
    one_mul]

theorem wcpa_gfn_int_closed_localize : ∀ (P : Type u) [CommRing P] [IsDomain P] (B : Type u) [CommRing B]
    [Algebra P B],
    (∀ z : Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)), IsIntegral B z →
      ∃ b : B, algebraMap B (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) b = z) →
    ∀ (Q : Ideal B) [Q.IsPrime]
      (z : Localization (Algebra.algebraMapSubmonoid (Localization.AtPrime Q) (nonZeroDivisors P))),
      IsIntegral (Localization.AtPrime Q) z →
      ∃ a : Localization.AtPrime Q, algebraMap (Localization.AtPrime Q)
        (Localization (Algebra.algebraMapSubmonoid (Localization.AtPrime Q) (nonZeroDivisors P))) a = z :=
by
  intro P _ _ B _ _ H Q _

  have s2 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (Φ : Polynomial R)
      (c : R) (y : S), Φ.Monic → algebraMap R S c * Polynomial.aeval y Φ = 0 →
      IsIntegral R (algebraMap R S c * y) := by
    intro R _ S _ _ Φ c y hΦ hc
    refine ⟨Polynomial.X * Φ.scaleRoots c,
      Polynomial.monic_X.mul ((Polynomial.monic_scaleRoots_iff c).mpr hΦ), ?_⟩
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.scaleRoots_eval₂_mul,
      ← Polynomial.aeval_def]
    calc algebraMap R S c * y * (algebraMap R S c ^ Φ.natDegree * Polynomial.aeval y Φ)
        = y * algebraMap R S c ^ Φ.natDegree * (algebraMap R S c * Polynomial.aeval y Φ) := by ring
      _ = 0 := by rw [hc, mul_zero]
  have s3 : ∀ (R : Type u) [CommRing R] (T : Type u) [CommRing T] [Algebra R T] (Φ : Polynomial R)
      (σ β : R) (v : T), algebraMap R T σ * v = algebraMap R T β →
      algebraMap R T ((Φ.scaleRoots σ).eval β) = algebraMap R T σ ^ Φ.natDegree * Polynomial.aeval v Φ := by
    intro R _ T _ _ Φ σ β v h
    rw [← Polynomial.eval₂_at_apply, ← h, Polynomial.scaleRoots_eval₂_mul, Polynomial.aeval_def]
  set A := Localization.AtPrime Q with hAdef
  set AK := Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)) with hAKdef
  set BK := Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)) with hBKdef
  intro z hz
  have memA : ∀ s : P, s ≠ 0 → algebraMap P A s ∈ Algebra.algebraMapSubmonoid A (nonZeroDivisors P) :=
    fun s hs => ⟨s, mem_nonZeroDivisors_of_ne_zero hs, rfl⟩
  have memB : ∀ s : P, s ≠ 0 → algebraMap P B s ∈ Algebra.algebraMapSubmonoid B (nonZeroDivisors P) :=
    fun s hs => ⟨s, mem_nonZeroDivisors_of_ne_zero hs, rfl⟩
  have memA' : ∀ μ ∈ Algebra.algebraMapSubmonoid A (nonZeroDivisors P),
      ∃ s : P, s ≠ 0 ∧ algebraMap P A s = μ := by
    rintro μ ⟨s, hs, rfl⟩
    exact ⟨s, nonZeroDivisors.ne_zero hs, rfl⟩

  have s4 : ∀ h : B, algebraMap B AK h = 0 →
      ∃ u : B, u ∉ Q ∧ ∃ s : P, s ≠ 0 ∧ algebraMap P B s * (u * h) = 0 := by
    intro h hh
    rw [IsScalarTower.algebraMap_apply B A AK] at hh
    obtain ⟨μ, hμh⟩ :=
      (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)) AK _).mp hh
    obtain ⟨s, hs, hsμ⟩ := memA' μ.1 μ.2
    have hμh' : algebraMap B A (algebraMap P B s * h) = 0 := by
      rw [map_mul, ← IsScalarTower.algebraMap_apply P B A, hsμ]
      exact hμh
    obtain ⟨⟨u, hu⟩, huh⟩ := (IsLocalization.map_eq_zero_iff Q.primeCompl A _).mp hμh'
    refine ⟨u, hu, s, hs, ?_⟩
    rw [mul_left_comm]
    exact huh

  have s5 : ∀ z : AK, ∃ (b t : B) (s : P), t ∉ Q ∧ s ≠ 0 ∧
      algebraMap B AK t * z * algebraMap B AK (algebraMap P B s) = algebraMap B AK b := by
    intro z
    obtain ⟨⟨a, μ⟩, hza⟩ :=
      IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)) z
    obtain ⟨s, hs, hsμ⟩ := memA' μ.1 μ.2
    obtain ⟨⟨b, t⟩, hab⟩ := IsLocalization.mk'_surjective Q.primeCompl a
    refine ⟨b, t.1, s, t.2, hs, ?_⟩
    have e1 : z * algebraMap A AK μ.1 = algebraMap A AK a := by
      rw [← hza]; exact IsLocalization.mk'_spec AK a μ
    have e2 : algebraMap B A t.1 * a = algebraMap B A b := by
      rw [← hab]; exact IsLocalization.mk'_spec' A b t
    rw [IsScalarTower.algebraMap_apply B A AK t.1, IsScalarTower.algebraMap_apply B A AK b,
      IsScalarTower.algebraMap_apply B A AK (algebraMap P B s),
      ← IsScalarTower.algebraMap_apply P B A, hsμ, mul_assoc, e1, ← map_mul, e2]

  have s6 : ∀ s : P, s ≠ 0 → IsUnit (algebraMap B AK (algebraMap P B s)) := by
    intro s hs
    rw [IsScalarTower.algebraMap_apply B A AK, ← IsScalarTower.algebraMap_apply P B A]
    exact IsLocalization.map_units AK
      (⟨algebraMap P A s, memA s hs⟩ : Algebra.algebraMapSubmonoid A (nonZeroDivisors P))
  have uB : ∀ s : P, s ≠ 0 → IsUnit (algebraMap B BK (algebraMap P B s)) := fun s hs =>
    IsLocalization.map_units BK
      (⟨algebraMap P B s, memB s hs⟩ : Algebra.algebraMapSubmonoid B (nonZeroDivisors P))

  obtain ⟨b, t, s, ht, hs, hbz⟩ := s5 z
  obtain ⟨⟨m, hm⟩, hmz⟩ := IsIntegral.exists_multiple_integral_of_isLocalization Q.primeCompl z hz
  rw [Submonoid.smul_def, Algebra.smul_def] at hmz
  have hvint : IsIntegral B (algebraMap B AK t * (algebraMap B AK m * z)) :=
    (isIntegral_algebraMap).mul hmz
  have hσv : algebraMap B AK (algebraMap P B s) * (algebraMap B AK t * (algebraMap B AK m * z)) =
      algebraMap B AK (m * b) := by
    rw [map_mul, ← hbz]; ring
  obtain ⟨Φ, hΦm, hΦ⟩ := hvint
  rw [← Polynomial.aeval_def] at hΦ
  have hh0 : algebraMap B AK ((Φ.scaleRoots (algebraMap P B s)).eval (m * b)) = 0 := by
    rw [s3 B AK Φ (algebraMap P B s) (m * b) _ hσv, hΦ, mul_zero]
  obtain ⟨u, hu, s', hs', hus⟩ := s4 _ hh0
  have hσy : algebraMap B BK (algebraMap P B s) * IsLocalization.mk' BK (m * b)
      (⟨algebraMap P B s, memB s hs⟩ : Algebra.algebraMapSubmonoid B (nonZeroDivisors P)) =
      algebraMap B BK (m * b) := IsLocalization.mk'_spec' BK (m * b) _
  have hhB := s3 B BK Φ (algebraMap P B s) (m * b) _ hσy
  have huΦ : algebraMap B BK u * Polynomial.aeval (IsLocalization.mk' BK (m * b)
      (⟨algebraMap P B s, memB s hs⟩ : Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) Φ = 0 := by
    have e := congrArg (algebraMap B BK) hus
    rw [map_mul, map_mul, hhB, map_zero] at e
    have e' : algebraMap B BK (algebraMap P B s') * (algebraMap B BK (algebraMap P B s) ^ Φ.natDegree *
        (algebraMap B BK u * Polynomial.aeval (IsLocalization.mk' BK (m * b)
          (⟨algebraMap P B s, memB s hs⟩ : Algebra.algebraMapSubmonoid B (nonZeroDivisors P))) Φ)) = 0 := by
      rw [← e]; ring
    exact ((uB s hs).pow _).mul_right_eq_zero.mp ((uB s' hs').mul_right_eq_zero.mp e')
  have hint := s2 B BK Φ u _ hΦm huΦ
  obtain ⟨bs, hbs⟩ := H _ hint
  have e1 : algebraMap B BK (bs * algebraMap P B s) = algebraMap B BK (u * m * b) := by
    rw [map_mul, hbs, mul_assoc u m b, map_mul (algebraMap B BK) u (m * b), ← hσy]; ring
  obtain ⟨⟨c, hc⟩, hceq⟩ :=
    (IsLocalization.eq_iff_exists (Algebra.algebraMapSubmonoid B (nonZeroDivisors P)) BK).mp e1
  obtain ⟨s'', hs'', rfl⟩ := hc
  have e2 : algebraMap B AK bs * algebraMap B AK (algebraMap P B s) = algebraMap B AK (u * m * b) := by
    have e : algebraMap B AK (algebraMap P B s'') * algebraMap B AK (bs * algebraMap P B s) =
        algebraMap B AK (algebraMap P B s'') * algebraMap B AK (u * m * b) := by
      rw [← map_mul, ← map_mul]; exact congrArg _ hceq
    rw [← map_mul]
    exact (s6 s'' (nonZeroDivisors.ne_zero hs'')).mul_left_cancel e
  have humt : u * m * t ∉ Q := by
    intro hmem
    rcases (inferInstance : Q.IsPrime).mem_or_mem hmem with h1 | h1
    · rcases (inferInstance : Q.IsPrime).mem_or_mem h1 with h2 | h2
      · exact hu h2
      · exact hm h2
    · exact ht h1
  have e3 : algebraMap B AK bs = algebraMap B AK (u * m * t) * z := by
    apply (s6 s hs).mul_right_cancel
    rw [e2]
    simp only [map_mul]
    rw [← hbz]
    ring
  have e4 : algebraMap B A (u * m * t) * IsLocalization.mk' A bs (⟨u * m * t, humt⟩ : Q.primeCompl) =
      algebraMap B A bs := IsLocalization.mk'_spec' A bs _
  have hunit : IsUnit (algebraMap B AK (u * m * t)) := by
    rw [IsScalarTower.algebraMap_apply B A AK]
    exact (IsLocalization.map_units A (⟨u * m * t, humt⟩ : Q.primeCompl)).map (algebraMap A AK)
  refine ⟨IsLocalization.mk' A bs (⟨u * m * t, humt⟩ : Q.primeCompl), ?_⟩
  apply hunit.mul_left_cancel
  rw [← e3, IsScalarTower.algebraMap_apply B A AK (u * m * t), IsScalarTower.algebraMap_apply B A AK bs,
    ← map_mul, e4]

theorem wcpa_gfn_local_etale_normal : ∀ (P : Type u) [CommRing P] [IsDomain P] (A : Type u) [CommRing A]
    [IsLocalRing A] [Algebra P A], Algebra.FormallyEtale P A → Algebra.EssFiniteType P A →
    (∀ (s : P) (a : A), s ≠ 0 → algebraMap P A s * a = 0 → a = 0) →
    (∀ z : Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)), IsIntegral A z →
      ∃ a : A, algebraMap A (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) a = z) →
    IsDomain A ∧ IsIntegrallyClosed A :=
by
  intro P _ _ A _ _ _ hEt hEFT htf hic
  classical

  have hMle : Algebra.algebraMapSubmonoid A (nonZeroDivisors P) ≤ nonZeroDivisors A := by
    intro m hm
    obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hm
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    exact htf s x (nonZeroDivisors.ne_zero hs) (by rw [mul_comm]; exact hx)

  have hinj : Function.Injective
      (algebraMap A (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)))) :=
    IsLocalization.injective (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) hMle

  haveI := hEt
  haveI := hEFT
  haveI hEtK : Algebra.FormallyEtale (FractionRing P)
      (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    @Algebra.FormallyEtale.localization_map P A (FractionRing P)
      (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) _ _ _ _ (nonZeroDivisors P)
      _ _ _ _ _ _ _ _
      (inferInstanceAs (IsLocalization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))
        (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))))) _
  haveI : Algebra.EssFiniteType P (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    Algebra.EssFiniteType.comp P A _
  haveI : Algebra.EssFiniteType (FractionRing P)
      (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    Algebra.EssFiniteType.of_comp P (FractionRing P) _
  obtain ⟨I, hI, Ai, hF, hAlg, e, -⟩ :=
    (Algebra.FormallyEtale.iff_exists_algEquiv_prod (FractionRing P)
      (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)))).mp hEtK

  haveI hnt : Nontrivial (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    hinj.nontrivial
  have hIne : Nonempty I := by
    by_contra h
    rw [not_nonempty_iff] at h
    apply not_subsingleton (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)))
    exact ⟨fun x y => e.injective (funext fun i => (h.false i).elim)⟩
  have hIsub : Subsingleton I := by
    refine ⟨fun i j => ?_⟩
    by_contra hij
    obtain ⟨ε, hε⟩ : ∃ ε : Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)),
        ε = e.symm (Pi.single i 1) := ⟨_, rfl⟩
    have hεε : ε * ε = ε := by
      rw [hε, ← map_mul, ← Pi.single_mul, mul_one]
    have hint : IsIntegral A ε := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X,
        Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hεε, sub_self]
    obtain ⟨a, ha⟩ := hic ε hint
    have haa : a * a = a := hinj (by rw [map_mul, ha, hεε])
    have h01 : a = 0 ∨ a = 1 := by
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self a with hu | hu
      · right
        have h1 : a * (a - 1) = 0 := by rw [mul_sub, haa, mul_one, sub_self]
        exact sub_eq_zero.mp (hu.mul_right_eq_zero.mp h1)
      · left
        have h1 : (1 - a) * a = 0 := by rw [sub_mul, haa, one_mul, sub_self]
        exact hu.mul_right_eq_zero.mp h1
    rcases h01 with h0 | h1
    · have h2 : e ε = e 0 := by rw [← ha, h0, map_zero]
      rw [hε, AlgEquiv.apply_symm_apply, map_zero] at h2
      have h3 := congrFun h2 i
      rw [Pi.single_eq_same, Pi.zero_apply] at h3
      exact one_ne_zero h3
    · have h2 : e ε = e 1 := by rw [← ha, h1, map_one]
      rw [hε, AlgEquiv.apply_symm_apply, map_one] at h2
      have h3 := congrFun h2 j
      rw [Pi.single_eq_of_ne (Ne.symm hij), Pi.one_apply] at h3
      exact zero_ne_one h3
  haveI : Unique I := @uniqueOfSubsingleton I hIsub (Classical.choice hIne)
  have hLfield : IsField (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    MulEquiv.isField (Field.toIsField (Ai default))
      (e.toRingEquiv.trans (RingEquiv.piUnique Ai)).toMulEquiv

  haveI : NoZeroDivisors (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    ⟨fun {x y} hxy => by
      by_cases hx : x = 0
      · exact Or.inl hx
      · right
        obtain ⟨x', hx'⟩ := hLfield.mul_inv_cancel hx
        calc y = (x * x') * y := by rw [hx', one_mul]
          _ = x' * (x * y) := by ring
          _ = 0 := by rw [hxy, mul_zero]⟩
  haveI : IsDomain (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    NoZeroDivisors.to_isDomain _
  haveI hAdom : IsDomain A := Function.Injective.isDomain _ hinj
  haveI : IsFractionRing A (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) :=
    IsLocalization.of_le (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)) (nonZeroDivisors A)
      hMle (fun r hr => by
        have hr0 : algebraMap A (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P))) r
            ≠ 0 := fun h => nonZeroDivisors.ne_zero hr (hinj (h.trans (map_zero _).symm))
        obtain ⟨b, hb⟩ := hLfield.mul_inv_cancel hr0
        exact isUnit_iff_exists_inv.mpr ⟨b, hb⟩)
  exact ⟨hAdom, (isIntegrallyClosed_iff
    (Localization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)))).mpr (fun {x} hx => hic x hx)⟩

theorem wcpa_gf_smooth_valuation_normal : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    (D : Type u) [CommRing D] [Algebra V D], Algebra.Smooth V D →
    ∀ (𝔔 : Ideal D) [𝔔.IsPrime],
      IsDomain (Localization.AtPrime 𝔔) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔔) :=
by

  have s1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (n : ℕ),
      IsIntegrallyClosed (MvPolynomial (Fin n) R) := by
    intro R _ _ _ n
    induction n with
    | zero =>
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv R (Fin 0)).symm.toRingEquiv
    | succ n ih =>
      haveI := ih
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv

  have s7 : ∀ (R : Type u) [CommRing R] (x : R) (𝔔 : Ideal R) [𝔔.IsPrime], x ∉ 𝔔 →
      ∃ (Q : Ideal (Localization.Away x)) (_ : Q.IsPrime),
        Nonempty (Localization.AtPrime 𝔔 ≃+* Localization.AtPrime Q) := by
    intro R _ x 𝔔 h𝔔 hx
    have hdisj : Disjoint (Submonoid.powers x : Set R) (𝔔 : Set R) :=
      (Ideal.disjoint_powers_iff_notMem x (Ideal.IsPrime.isRadical h𝔔)).mpr hx
    haveI hQ : (Ideal.map (algebraMap R (Localization.Away x)) 𝔔).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers x) _ 𝔔 h𝔔 hdisj
    have hcomap : Ideal.comap (algebraMap R (Localization.Away x))
        (Ideal.map (algebraMap R (Localization.Away x)) 𝔔) = 𝔔 :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers x) (Localization.Away x) h𝔔 hdisj
    refine ⟨_, hQ, ?_⟩
    have hloc := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Submonoid.powers x) (Localization.AtPrime (Ideal.map (algebraMap R (Localization.Away x)) 𝔔))
      (Ideal.map (algebraMap R (Localization.Away x)) 𝔔)
    have heq : (Ideal.comap (algebraMap R (Localization.Away x))
        (Ideal.map (algebraMap R (Localization.Away x)) 𝔔)).primeCompl = 𝔔.primeCompl := by
      ext y
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
    have hloc' : IsLocalization 𝔔.primeCompl
        (Localization.AtPrime (Ideal.map (algebraMap R (Localization.Away x)) 𝔔)) := by
      have h2 := hloc
      unfold IsLocalization.AtPrime at h2
      rw [heq] at h2
      exact h2
    haveI := hloc'
    exact ⟨(IsLocalization.algEquiv 𝔔.primeCompl (Localization.AtPrime 𝔔) _).toRingEquiv⟩

  have s8 : ∀ (P : Type u) [CommRing P] [IsDomain P] (S : Type u) [CommRing S] [Algebra P S],
      Module.Flat P S → ∀ (Q : Ideal S) [Q.IsPrime],
      (∀ (s : P) (b : S), s ≠ 0 → algebraMap P S s * b = 0 → b = 0) ∧
      (∀ (s : P) (a : Localization.AtPrime Q), s ≠ 0 →
        algebraMap P (Localization.AtPrime Q) s * a = 0 → a = 0) := by
    intro P _ _ S _ _ hfl Q _
    have key : ∀ (M : Type u) [CommRing M] [Algebra P M], Module.Flat P M →
        ∀ (s : P) (b : M), s ≠ 0 → algebraMap P M s * b = 0 → b = 0 := by
      intro M _ _ hM s b hs hb
      haveI := hM
      haveI : Module.IsTorsionFree P M := Module.Flat.isTorsionFree
      have hreg : IsSMulRegular M s :=
        Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hs)
      apply hreg
      show s • b = s • 0
      rw [smul_zero, Algebra.smul_def, hb]
    refine ⟨key S hfl, key _ ?_⟩
    haveI := hfl
    haveI : Module.Flat S (Localization.AtPrime Q) := IsLocalization.flat _ Q.primeCompl
    exact Module.Flat.trans P S (Localization.AtPrime Q)

  have s6 : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsIntegrallyClosed P] (S : Type u) [CommRing S]
      [Algebra P S], Algebra.Etale P S → ∀ (Q : Ideal S) [Q.IsPrime],
      IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro P _ _ _ S _ _ hEt Q _
    haveI := hEt
    haveI : Algebra.FormallyEtale S (Localization.AtPrime Q) :=
      Algebra.FormallyEtale.of_isLocalization Q.primeCompl
    haveI : Algebra.FormallyEtale P (Localization.AtPrime Q) :=
      Algebra.FormallyEtale.comp P S (Localization.AtPrime Q)
    haveI : Algebra.IsEtaleAt P Q := ‹Algebra.FormallyEtale P (Localization.AtPrime Q)›
    obtain ⟨f₀, hf₀, hstdE⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := P) Q
    obtain ⟨E⟩ := Algebra.IsStandardEtale.nonempty_standardEtalePresentation
      (R := P) (S := Localization.Away f₀)
    obtain ⟨Q', hQ', ⟨eQ⟩⟩ := s7 S f₀ Q hf₀
    haveI := hQ'
    have hflat : Module.Flat P (Localization.Away f₀) := inferInstance
    obtain ⟨htfB, htfA⟩ := s8 P (Localization.Away f₀) hflat Q'
    obtain ⟨hel, hker⟩ := wcpa_gfn_std_etale_elements P (Localization.Away f₀) E
    have hB := wcpa_gfn_std_etale_int_closed P (Localization.Away f₀) E.x E.f E.g E.monic_f
      E.hasMap.1 E.hasMap.2 (StandardEtalePair.HasMap.isUnit_derivative_f _ E.hasMap) hel hker htfB
      (fun G c q p N hq hp h => wcpa_gfn_derivative_conductor P E.f G c q p N E.monic_f hq hp h)
    have hA := wcpa_gfn_int_closed_localize P (Localization.Away f₀) hB Q'
    haveI : Algebra.FormallyEtale (Localization.Away f₀) (Localization.AtPrime Q') :=
      Algebra.FormallyEtale.of_isLocalization Q'.primeCompl
    haveI : Algebra.FormallyEtale P (Localization.AtPrime Q') :=
      Algebra.FormallyEtale.comp P (Localization.Away f₀) (Localization.AtPrime Q')
    obtain ⟨hdom, hic⟩ := wcpa_gfn_local_etale_normal P (Localization.AtPrime Q') inferInstance
      inferInstance htfA hA
    haveI := hdom
    haveI := hic
    exact ⟨MulEquiv.isDomain _ eQ.toMulEquiv, IsIntegrallyClosed.of_equiv eQ.symm⟩

  intro V _ _ _ D _ _ hsm 𝔔 h𝔔
  haveI := hsm
  obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth V D
  obtain ⟨x, hxs, hx⟩ : ∃ x ∈ s, x ∉ 𝔔 := by
    by_contra h
    push_neg at h
    have hle : Ideal.span s ≤ 𝔔 := Ideal.span_le.mpr h
    rw [hs] at hle
    exact (Ideal.IsPrime.ne_top h𝔔) (top_le_iff.mp hle)
  obtain ⟨Q₁, hQ₁, ⟨e₁⟩⟩ := s7 D x 𝔔 hx
  haveI := hQ₁
  obtain ⟨n, g, -, hg⟩ :=
    (RingHom.isStandardSmooth_algebraMap.mpr (hstd x hxs)).exists_etale_mvPolynomial
  letI := g.toAlgebra
  haveI : IsIntegrallyClosed (MvPolynomial (Fin n) V) := s1 V n
  have hEt : Algebra.Etale (MvPolynomial (Fin n) V) (Localization.Away x) := hg
  obtain ⟨hd, hic⟩ := s6 (MvPolynomial (Fin n) V) (Localization.Away x) hEt Q₁
  haveI := hd
  haveI := hic
  exact ⟨MulEquiv.isDomain _ e₁.toMulEquiv, IsIntegrallyClosed.of_equiv e₁.symm⟩

theorem wcpa_gf_domain_nbhd : ∀ (V : Type u) [CommRing V] [IsDomain V] (D : Type u) [CommRing D]
    [Algebra V D], Module.Flat V D → IsNoetherianRing (TensorProduct V (FractionRing V) D) →
    ∀ (𝔓 : Ideal D) [𝔓.IsPrime], IsDomain (Localization.AtPrime 𝔓) →
    ∃ c : D, c ∉ 𝔓 ∧ IsDomain (Localization.Away c) ∧
      IsDomain (TensorProduct V (FractionRing V) (Localization.Away c)) :=
by
  intro V _ _ D _ _ hflat hnoeth 𝔓 h𝔓 hdom
  classical

  have htf : ∀ s : V, s ≠ 0 → ∀ x : D, algebraMap V D s * x = 0 → x = 0 := by
    intro s hs x hx
    have : Module.IsTorsionFree V D := Module.Flat.isTorsionFree
    have hreg : IsSMulRegular D s :=
      Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hs)
    apply hreg
    show s • x = s • (0 : D)
    rw [smul_zero, Algebra.smul_def]
    exact hx

  have hloc : IsLocalization (Algebra.algebraMapSubmonoid D (nonZeroDivisors V))
      (TensorProduct V D (FractionRing V)) :=
    IsLocalization.tensor (S := D) (FractionRing V) (nonZeroDivisors V)
  have hBnoeth : IsNoetherianRing (TensorProduct V D (FractionRing V)) :=
    isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm V (FractionRing V) D).toRingEquiv
  set f := algebraMap D (TensorProduct V D (FractionRing V)) with hf
  set I := RingHom.ker (algebraMap D (Localization.AtPrime 𝔓)) with hI

  have hJfg : (Ideal.map f I).FG := IsNoetherian.noetherian _
  obtain ⟨s', hs'sub, hs'span⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset (f '' (I : Set D))).mp hJfg
  have hch : ∀ y ∈ s', ∃ m : D, m ∉ 𝔓 ∧ ∃ x : D, f x = y ∧ m * x = 0 := by
    intro y hy
    obtain ⟨x, hxI, hxy⟩ := hs'sub hy
    have hx0 : algebraMap D (Localization.AtPrime 𝔓) x = 0 := hxI
    obtain ⟨⟨m, hm⟩, hmx⟩ :=
      (IsLocalization.map_eq_zero_iff 𝔓.primeCompl (Localization.AtPrime 𝔓) x).mp hx0
    exact ⟨m, hm, x, hxy, hmx⟩
  choose! m hm x hxf hmx using hch

  obtain ⟨c, hcdef⟩ : ∃ c : D, c = ∏ y ∈ s', m y := ⟨_, rfl⟩
  have hc : c ∉ 𝔓 := by
    have : c ∈ 𝔓.primeCompl := hcdef ▸ 𝔓.primeCompl.prod_mem (fun y hy => hm y hy)
    exact this
  have hcx : ∀ y ∈ s', c * x y = 0 := by
    intro y hy
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem m hy
    rw [hcdef, hk, mul_comm (m y) k, mul_assoc, hmx y hy, mul_zero]

  have hann : ∀ z ∈ Submodule.span (TensorProduct V D (FractionRing V)) (s' : Set _),
      f c * z = 0 := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      rw [← hxf z hz, ← map_mul, hcx z hz, map_zero]
    | zero => rw [mul_zero]
    | add z w _ _ hz hw => rw [mul_add, hz, hw, add_zero]
    | smul a z _ hz => rw [smul_eq_mul, mul_left_comm, hz, mul_zero]

  have hkill : ∀ d : D, algebraMap D (Localization.AtPrime 𝔓) d = 0 → c * d = 0 := by
    intro d hd
    have hdI : d ∈ I := hd
    have hfd : f d ∈ Ideal.map f I := Ideal.mem_map_of_mem f hdI
    have hfd' : f d ∈ Submodule.span (TensorProduct V D (FractionRing V)) (s' : Set _) := by
      rw [← hs'span]
      exact hfd
    have h0 : f (c * d) = 0 := by rw [map_mul]; exact hann _ hfd'
    obtain ⟨⟨t, ht⟩, htcd⟩ :=
      (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid D (nonZeroDivisors V))
        (TensorProduct V D (FractionRing V)) (c * d)).mp h0
    obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp ht
    exact htf s (nonZeroDivisors.ne_zero hs) _ htcd

  have hu : IsUnit (algebraMap D (Localization.AtPrime 𝔓) c) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔓) 𝔓 c).mpr hc
  have hg : ∀ y : Submonoid.powers c, IsUnit (algebraMap D (Localization.AtPrime 𝔓) (y : D)) := by
    rintro ⟨_, n, rfl⟩
    simp only [map_pow]
    exact hu.pow n
  have hinj : Function.Injective
      (IsLocalization.lift (M := Submonoid.powers c) (S := Localization.Away c) hg) := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨a, y⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers c) z
    have h1 : algebraMap D (Localization.AtPrime 𝔓) a =
        algebraMap D (Localization.AtPrime 𝔓) (y : D) * 0 :=
      (IsLocalization.lift_mk'_spec hg a 0 y).mp hz
    rw [mul_zero] at h1
    have h2 := hkill a h1
    rw [IsLocalization.mk'_eq_zero_iff]
    exact ⟨⟨c, 1, pow_one c⟩, h2⟩
  have hDc : IsDomain (Localization.Away c) := Function.Injective.isDomain _ hinj

  have hnz : ∀ s : V, s ≠ 0 → algebraMap V (Localization.Away c) s ≠ 0 := by
    intro s hs h0
    rw [IsScalarTower.algebraMap_apply V D (Localization.Away c)] at h0
    obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers c) (Localization.Away c) _).mp h0
    have hcn : c ^ n = 0 := htf s hs _ (by rw [mul_comm]; exact hn)
    exact hc (h𝔓.mem_of_pow_mem n (hcn ▸ 𝔓.zero_mem))
  have hloc' : IsLocalization
      (Algebra.algebraMapSubmonoid (Localization.Away c) (nonZeroDivisors V))
      (TensorProduct V (Localization.Away c) (FractionRing V)) :=
    IsLocalization.tensor (S := Localization.Away c) (FractionRing V) (nonZeroDivisors V)
  have hle : Algebra.algebraMapSubmonoid (Localization.Away c) (nonZeroDivisors V) ≤
      nonZeroDivisors (Localization.Away c) := by
    intro t ht
    obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp ht
    exact mem_nonZeroDivisors_of_ne_zero (hnz s (nonZeroDivisors.ne_zero hs))
  have hB' : IsDomain (TensorProduct V (Localization.Away c) (FractionRing V)) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ hle
  have hA : IsDomain (TensorProduct V (FractionRing V) (Localization.Away c)) :=
    MulEquiv.isDomain _
      (Algebra.TensorProduct.comm V (FractionRing V) (Localization.Away c)).toRingEquiv.toMulEquiv
  exact ⟨c, hc, hDc, hA⟩

theorem wcpa_hs_idempotent_lift : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (C : Type u) [CommRing C] [Algebra R C], Module.Finite R C → ∀ ε : C, ε * ε - ε ∈ Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R) → ∃ e : C, IsIdempotentElem e ∧ e - ε ∈ Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R) :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (B : Type u) [CommRing B]
      [Algebra R B], Algebra.Etale R B → ∀ φ : B →ₐ[R] IsLocalRing.ResidueField R,
      ∃ σ : B →ₐ[R] R, (Algebra.ofId R (IsLocalRing.ResidueField R)).comp σ = φ := by
    intro R _ _ B _ _ het φ
    haveI := het
    haveI hQ : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
    haveI : Algebra.FinitePresentation R B := inferInstance
    haveI : Algebra.IsEtaleAt R (RingHom.ker φ) :=
      (inferInstance : Algebra.FormallyEtale R (Localization.AtPrime (RingHom.ker φ)))
    obtain ⟨f, hfQ, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker φ)
    obtain ⟨P⟩ := hstd.nonempty_standardEtalePresentation
    let e : P.Ring ≃ₐ[R] Localization.Away f :=
      AlgEquiv.ofBijective (P.lift P.x P.hasMap) P.lift_bijective
    have hunit : IsUnit (φ f) := by
      refine IsUnit.mk0 _ ?_
      intro h0
      exact hfQ (RingHom.mem_ker.mpr h0)
    let φf : Localization.Away f →ₐ[R] IsLocalRing.ResidueField R :=
      IsLocalization.Away.liftAlgHom f hunit
    have hf0 : Polynomial.aeval (φf P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, P.hasMap.1, map_zero]
    have hg0 : Polynomial.aeval (φf P.x) P.g ≠ 0 := by
      rw [Polynomial.aeval_algHom_apply]
      exact (P.hasMap.2.map φf).ne_zero
    have hd0 : Polynomial.aeval (φf P.x) (Polynomial.derivative P.f) ≠ 0 := by
      obtain ⟨p₁, p₂, m, hc⟩ := P.cond
      have h1 := congrArg (Polynomial.aeval (φf P.x)) hc
      rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
      intro h
      rw [h, zero_mul] at h1
      exact pow_ne_zero m hg0 h1.symm
    have hhens := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
    obtain ⟨a, ha, hares⟩ := hhens P.f P.monic_f (φf P.x) hf0 hd0
    have hres : ∀ p : Polynomial R,
        IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval (φf P.x) p := by
      intro p
      rw [← hares]
      exact (Polynomial.aeval_algHom_apply (Algebra.ofId R (IsLocalRing.ResidueField R)) a p).symm
    have hA : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]; exact ha
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres]; exact hg0
    refine ⟨((P.lift a hA).comp e.symm.toAlgHom).comp
      (IsScalarTower.toAlgHom R B (Localization.Away f)), ?_⟩
    have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (P.lift a hA) =
        φf.comp e.toAlgHom := by
      apply StandardEtalePair.hom_ext
      show Algebra.ofId R _ (P.lift a hA P.X) = φf (P.lift P.x P.hasMap P.X)
      rw [StandardEtalePair.lift_X, StandardEtalePair.lift_X, Algebra.ofId_apply,
        IsLocalRing.ResidueField.algebraMap_eq, hares]
    apply AlgHom.ext
    intro b
    show Algebra.ofId R _ (P.lift a hA (e.symm (algebraMap B (Localization.Away f) b))) = φ b
    have h1 : Algebra.ofId R _ (P.lift a hA (e.symm (algebraMap B (Localization.Away f) b))) =
        φf (e (e.symm (algebraMap B (Localization.Away f) b))) :=
      DFunLike.congr_fun hcomp _
    rw [h1, AlgEquiv.apply_symm_apply, IsLocalization.Away.liftAlgHom_apply]
    exact IsLocalization.Away.lift_eq f hunit b

  have s2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R], (∀ (B : Type u) [CommRing B]
      [Algebra R B], Algebra.Etale R B → ∀ φ : B →ₐ[R] IsLocalRing.ResidueField R,
      ∃ σ : B →ₐ[R] R, (Algebra.ofId R (IsLocalRing.ResidueField R)).comp σ = φ) →
      ∀ (p : Polynomial R), p.Monic → ∀ (g₀ h₀ : Polynomial (IsLocalRing.ResidueField R)),
      g₀.Monic → h₀.Monic → p.map (IsLocalRing.residue R) = g₀ * h₀ → IsCoprime g₀ h₀ →
      ∃ g h : Polynomial R, p = g * h ∧ IsCoprime g h ∧ g.map (IsLocalRing.residue R) = g₀ ∧
        h.map (IsLocalRing.residue R) = h₀ := by
    intro R _ _ hsec p hp g₀ h₀ hg₀ hh₀ hmap hcop
    have hn : p.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hp.natDegree_map (IsLocalRing.residue R), hmap, hg₀.natDegree_mul hh₀]
    let Pp : Polynomial.MonicDegreeEq R p.natDegree := Polynomial.MonicDegreeEq.mk p hp rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField R) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg₀ rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField R) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh₀ rfl
    have hPc : (Pp : Polynomial R) = p := Polynomial.MonicDegreeEq.mk_coe _ _ _
    have hGc : (G₀ : Polynomial (IsLocalRing.ResidueField R)) = g₀ :=
      Polynomial.MonicDegreeEq.mk_coe _ _ _
    have hHc : (H₀ : Polynomial (IsLocalRing.ResidueField R)) = h₀ :=
      Polynomial.MonicDegreeEq.mk_coe _ _ _
    have hx : (G₀ : Polynomial (IsLocalRing.ResidueField R)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap R (IsLocalRing.ResidueField R)) (Pp : Polynomial R) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField R)) (H₀ : Polynomial _) := by
      refine ⟨?_, ?_⟩
      · rw [hGc, hHc, hPc, IsLocalRing.ResidueField.algebraMap_eq, hmap]
      · rw [hGc, hHc]; exact hcop
    obtain ⟨σ, hσ⟩ := hsec (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree
        h₀.natDegree hn Pp) inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField R)
        g₀.natDegree h₀.natDegree hn Pp).symm ⟨(G₀, H₀), hx⟩)
    obtain ⟨⟨⟨G, H⟩, hGH, hGHc⟩, hq⟩ : ∃ q,
        Polynomial.UniversalCoprimeFactorizationRing.homEquiv R g₀.natDegree h₀.natDegree hn Pp σ
          = q := ⟨_, rfl⟩
    have h2 := Polynomial.UniversalCoprimeFactorizationRing.homEquiv_comp_fst R g₀.natDegree
      h₀.natDegree hn Pp σ (Algebra.ofId R (IsLocalRing.ResidueField R))
    have h2' := Polynomial.UniversalCoprimeFactorizationRing.homEquiv_comp_snd R g₀.natDegree
      h₀.natDegree hn Pp σ (Algebra.ofId R (IsLocalRing.ResidueField R))
    rw [hσ, Equiv.apply_symm_apply, hq] at h2 h2'
    have hof : ((Algebra.ofId R (IsLocalRing.ResidueField R) : R →ₐ[R] _) :
        R →+* IsLocalRing.ResidueField R) = IsLocalRing.residue R :=
      RingHom.ext fun r => (Algebra.ofId_apply (IsLocalRing.ResidueField R) r).trans
        (by rw [IsLocalRing.ResidueField.algebraMap_eq])
    have h3 : (G₀ : Polynomial (IsLocalRing.ResidueField R)) =
        Polynomial.map ((Algebra.ofId R (IsLocalRing.ResidueField R) : R →ₐ[R] _) :
          R →+* IsLocalRing.ResidueField R) (G : Polynomial R) := by
      rw [← Polynomial.MonicDegreeEq.map_coe]
      exact congrArg (fun r : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField R)
        g₀.natDegree => (r : Polynomial (IsLocalRing.ResidueField R))) h2
    have h3' : (H₀ : Polynomial (IsLocalRing.ResidueField R)) =
        Polynomial.map ((Algebra.ofId R (IsLocalRing.ResidueField R) : R →ₐ[R] _) :
          R →+* IsLocalRing.ResidueField R) (H : Polynomial R) := by
      rw [← Polynomial.MonicDegreeEq.map_coe]
      exact congrArg (fun r : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField R)
        h₀.natDegree => (r : Polynomial (IsLocalRing.ResidueField R))) h2'
    refine ⟨(G : Polynomial R), (H : Polynomial R), ?_, hGHc, ?_, ?_⟩
    · rw [hGH, Algebra.algebraMap_self, Polynomial.map_id, hPc]
    · rw [← hof, ← h3, hGc]
    · rw [← hof, ← h3', hHc]
  intro R _ _ C _ _ hfin ε ht
  haveI := hfin
  obtain ⟨J, hJ⟩ : ∃ J, J = Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R) := ⟨_, rfl⟩
  rw [← hJ] at ht ⊢
  have hιJ : ∀ x ∈ IsLocalRing.maximalIdeal R, algebraMap R C x ∈ J := fun x hx =>
    hJ ▸ Ideal.mem_map_of_mem _ hx

  have s3 : ∀ (P : Polynomial R), ∃ c : C, Polynomial.aeval ε P =
      algebraMap R C (P.eval 0) * (1 - ε) + algebraMap R C (P.eval 1) * ε + (ε * ε - ε) * c := by
    intro P
    obtain ⟨L, hL⟩ : ∃ L : Polynomial R, L = Polynomial.C (P.eval 0) * (1 - Polynomial.X) +
        Polynomial.C (P.eval 1) * Polynomial.X := ⟨_, rfl⟩
    have hD0 : (P - L).coeff 0 = 0 := by
      rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_sub, hL]
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub,
        Polynomial.eval_one, Polynomial.eval_X]
      ring
    obtain ⟨D₁, hD₁⟩ := Polynomial.X_dvd_iff.mpr hD0
    have hD1 : D₁.IsRoot 1 := by
      have h := congrArg (Polynomial.eval 1) hD₁
      rw [Polynomial.eval_mul, Polynomial.eval_X, one_mul, Polynomial.eval_sub, hL] at h
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub,
        Polynomial.eval_one, Polynomial.eval_X] at h
      rw [Polynomial.IsRoot.def, ← h]
      ring
    obtain ⟨D₂, hD₂⟩ := Polynomial.dvd_iff_isRoot.mpr hD1
    refine ⟨Polynomial.aeval ε D₂, ?_⟩
    have hP : P = L + Polynomial.X * ((Polynomial.X - Polynomial.C 1) * D₂) := by
      rw [← hD₂, ← hD₁]; ring
    have h2 : Polynomial.aeval ε P = Polynomial.aeval ε
        (L + Polynomial.X * ((Polynomial.X - Polynomial.C 1) * D₂)) := by
      rw [← hP]
    rw [h2, hL]
    simp only [map_add, map_mul, map_sub, map_one, Polynomial.aeval_C, Polynomial.aeval_X]
    ring

  have s4 : ∀ (χ : Polynomial (IsLocalRing.ResidueField R)), χ.Monic → χ.eval 0 = 0 →
      χ.eval 1 = 0 → ∃ g₀ h₀ : Polynomial (IsLocalRing.ResidueField R), g₀.Monic ∧ h₀.Monic ∧
        χ = g₀ * h₀ ∧ IsCoprime g₀ h₀ ∧ g₀.eval 0 = 0 ∧ h₀.eval 1 = 0 := by
    intro χ hχ h0 h1
    have hχ0 : χ ≠ 0 := hχ.ne_zero
    obtain ⟨q, hq, hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd χ hχ0 0
    rw [Polynomial.C_0, sub_zero] at hq hndvd
    have ha : 0 < Polynomial.rootMultiplicity 0 χ := (Polynomial.rootMultiplicity_pos hχ0).mpr h0
    obtain ⟨a, ha'⟩ : ∃ a, a = Polynomial.rootMultiplicity 0 χ := ⟨_, rfl⟩
    rw [← ha'] at hq ha
    have hqm : q.Monic := by
      have : (Polynomial.X ^ a * q).Monic := by rw [← hq]; exact hχ
      exact Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_pow a) this
    refine ⟨Polynomial.X ^ a, q, Polynomial.monic_X_pow a, hqm, hq, ?_, ?_, ?_⟩
    · exact ((Irreducible.coprime_iff_not_dvd Polynomial.irreducible_X).mpr hndvd).pow_left
    · rw [Polynomial.eval_pow, Polynomial.eval_X, zero_pow ha.ne']
    · rw [hq, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X, one_pow, one_mul] at h1
      exact h1

  by_cases hε : ε ∈ J
  · exact ⟨0, IsIdempotentElem.zero, by rw [zero_sub]; exact neg_mem hε⟩
  by_cases h1ε : 1 - ε ∈ J
  · exact ⟨1, IsIdempotentElem.one, h1ε⟩

  obtain ⟨χ, hχm, hχε⟩ := IsIntegral.of_finite R ε
  have hχε' : Polynomial.aeval ε χ = 0 := by rw [Polynomial.aeval_def]; exact hχε
  obtain ⟨c, hc⟩ := s3 χ
  rw [hχε'] at hc
  have hβ : χ.eval 1 ∈ IsLocalRing.maximalIdeal R := by
    by_contra hβ
    obtain ⟨w, hw⟩ := (IsLocalRing.notMem_maximalIdeal.mp hβ).exists_left_inv
    apply hε
    have key : algebraMap R C (χ.eval 1) * ε = algebraMap R C (χ.eval 0) * (ε * ε - ε) -
        algebraMap R C (χ.eval 1) * (ε * ε - ε) - (ε * ε - ε) * c * ε := by
      linear_combination (-ε) * hc
    have hmem : algebraMap R C (χ.eval 1) * ε ∈ J := by
      rw [key]
      exact J.sub_mem (J.sub_mem (J.mul_mem_left _ ht) (J.mul_mem_left _ ht))
        (J.mul_mem_right _ (J.mul_mem_right _ ht))
    have : ε = algebraMap R C w * (algebraMap R C (χ.eval 1) * ε) := by
      rw [← mul_assoc, ← map_mul, hw, map_one, one_mul]
    rw [this]; exact J.mul_mem_left _ hmem
  have hα : χ.eval 0 ∈ IsLocalRing.maximalIdeal R := by
    by_contra hα
    obtain ⟨w, hw⟩ := (IsLocalRing.notMem_maximalIdeal.mp hα).exists_left_inv
    apply h1ε
    have key : algebraMap R C (χ.eval 0) * (1 - ε) = algebraMap R C (χ.eval 1) * (ε * ε - ε) -
        algebraMap R C (χ.eval 0) * (ε * ε - ε) - (ε * ε - ε) * c * (1 - ε) := by
      linear_combination (ε - 1) * hc
    have hmem : algebraMap R C (χ.eval 0) * (1 - ε) ∈ J := by
      rw [key]
      exact J.sub_mem (J.sub_mem (J.mul_mem_left _ ht) (J.mul_mem_left _ ht))
        (J.mul_mem_right _ (J.mul_mem_right _ ht))
    have : 1 - ε = algebraMap R C w * (algebraMap R C (χ.eval 0) * (1 - ε)) := by
      rw [← mul_assoc, ← map_mul, hw, map_one, one_mul]
    rw [this]; exact J.mul_mem_left _ hmem

  have hχbm : (χ.map (IsLocalRing.residue R)).Monic := hχm.map _
  have hχb0 : (χ.map (IsLocalRing.residue R)).eval 0 = 0 := by
    rw [Polynomial.eval_zero_map, IsLocalRing.residue_eq_zero_iff]; exact hα
  have hχb1 : (χ.map (IsLocalRing.residue R)).eval 1 = 0 := by
    rw [Polynomial.eval_one_map, IsLocalRing.residue_eq_zero_iff]; exact hβ
  obtain ⟨g₀, h₀, hg₀m, hh₀m, hχgh, hcop, hg₀0, hh₀1⟩ := s4 _ hχbm hχb0 hχb1
  obtain ⟨g, h, hgh, hcopgh, hgmap, hhmap⟩ := s2 R (s1 R) χ hχm g₀ h₀ hg₀m hh₀m hχgh hcop
  have hg0m : g.eval 0 ∈ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_zero_map, hgmap]; exact hg₀0
  have hh1m : h.eval 1 ∈ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_one_map, hhmap]; exact hh₀1

  obtain ⟨u, v, huv⟩ := hcopgh
  refine ⟨Polynomial.aeval ε (u * g), ?_, ?_⟩
  · rw [isIdempotentElem_iff_mul_one_sub_self]
    have h1 : 1 - Polynomial.aeval ε (u * g) = Polynomial.aeval ε (v * h) := by
      have h0 : Polynomial.aeval ε (u * g + v * h) = Polynomial.aeval ε (1 : Polynomial R) := by
        rw [huv]
      rw [map_add, map_one] at h0
      linear_combination -h0
    rw [h1, ← map_mul]
    have : u * g * (v * h) = (u * v) * (g * h) := by ring
    rw [this, ← hgh, map_mul, hχε', mul_zero]

  · obtain ⟨c', hc'⟩ := s3 (u * g)
    have ha0 : (u * g).eval 0 ∈ IsLocalRing.maximalIdeal R := by
      rw [Polynomial.eval_mul]; exact Ideal.mul_mem_left _ _ hg0m
    have ha1 : (u * g).eval 1 - 1 ∈ IsLocalRing.maximalIdeal R := by
      have h4 := congrArg (Polynomial.eval 1) huv
      rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_one] at h4
      have e : (u * g).eval 1 - 1 = -(v.eval 1 * h.eval 1) := by
        rw [Polynomial.eval_mul]; linear_combination h4
      rw [e]; exact neg_mem (Ideal.mul_mem_left _ _ hh1m)
    have e2 : Polynomial.aeval ε (u * g) - ε = algebraMap R C ((u * g).eval 0) * (1 - ε) +
        algebraMap R C ((u * g).eval 1 - 1) * ε + (ε * ε - ε) * c' := by
      rw [hc', map_sub, map_one]; ring
    rw [e2]
    exact J.add_mem (J.add_mem (J.mul_mem_right _ (hιJ _ ha0)) (J.mul_mem_right _ (hιJ _ ha1)))
      (J.mul_mem_right _ ht)

theorem wcpa_hs_finite_domain_henselian : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (S : Type u) [CommRing S] [IsDomain S] [Algebra R S], Module.Free R S → Module.Finite R S → IsField (S ⧸ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)) → HenselianLocalRing S :=
by
  intro R _ _ S _ _ _ _hfree hfin hfield
  classical

  have hs2 : ∀ (I : Ideal S), I ≠ ⊤ → ∀ (f : Polynomial S), f.Monic → ∀ (a₀ : S),
      f.eval a₀ ∈ I → IsUnit ((Polynomial.derivative f).eval a₀) →
      ∃ ε : AdjoinRoot f, ε * ε - ε ∈ Ideal.map (algebraMap S (AdjoinRoot f)) I ∧
        (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * ε ∈
          Ideal.map (algebraMap S (AdjoinRoot f)) I ∧
        ε ∉ Ideal.map (algebraMap S (AdjoinRoot f)) I := by
    intro I hI f hf a₀ hf0 hu
    simp only [AdjoinRoot.algebraMap_eq]
    have hd : f.natDegree ≠ 0 := by
      intro h
      have h1 := Polynomial.eq_one_of_monic_natDegree_zero hf h
      rw [h1, Polynomial.eval_one] at hf0
      exact hI (Ideal.eq_top_of_isUnit_mem _ hf0 isUnit_one)
    set c := f.eval a₀ with hc
    set G := f /ₘ (Polynomial.X - Polynomial.C a₀) with hG
    have hdec : Polynomial.C c + (Polynomial.X - Polynomial.C a₀) * G = f := by
      have := Polynomial.modByMonic_add_div f (Polynomial.X - Polynomial.C a₀)
      rwa [Polynomial.modByMonic_X_sub_C_eq_C_eval] at this
    have hGdeg : G.natDegree = f.natDegree - 1 := by
      rw [hG, Polynomial.natDegree_divByMonic f (Polynomial.monic_X_sub_C a₀),
        Polynomial.natDegree_X_sub_C]
    have hGmonic : G.Monic := by
      have h1 : (Polynomial.X - Polynomial.C a₀) * G = f - Polynomial.C c := by
        rw [← hdec]; ring
      have h2 : (f - Polynomial.C c).Monic := by
        apply hf.sub_of_left
        calc Polynomial.degree (Polynomial.C c) ≤ 0 := Polynomial.degree_C_le
          _ < Polynomial.degree f :=
            Polynomial.natDegree_pos_iff_degree_pos.mp (Nat.pos_of_ne_zero hd)
      rw [← h1] at h2
      exact (Polynomial.monic_X_sub_C a₀).of_mul_monic_left h2
    have hder : Polynomial.derivative f =
        G + (Polynomial.X - Polynomial.C a₀) * Polynomial.derivative G := by
      rw [← hdec]
      simp [Polynomial.derivative_mul]
    set w := G.eval a₀ with hw
    have hw' : w = (Polynomial.derivative f).eval a₀ := by
      rw [hder]; simp [hw]
    obtain ⟨u, huw⟩ : ∃ u, u * w = 1 := by
      rw [hw']
      obtain ⟨v, hv⟩ := hu
      exact ⟨↑v⁻¹, by rw [← hv]; simp⟩
    have hkey : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * AdjoinRoot.mk f G =
        -(AdjoinRoot.of f c) := by
      have h1 : (Polynomial.X - Polynomial.C a₀) * G = f - Polynomial.C c := by
        rw [← hdec]; ring
      have h2 := congrArg (AdjoinRoot.mk f) h1
      rw [map_mul, map_sub, map_sub, AdjoinRoot.mk_X, AdjoinRoot.mk_C, AdjoinRoot.mk_C,
        AdjoinRoot.mk_self] at h2
      rw [h2]; ring
    obtain ⟨H, hH⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := a₀) (p := G)
    have hH' : AdjoinRoot.mk f G - AdjoinRoot.of f w =
        (AdjoinRoot.root f - AdjoinRoot.of f a₀) * AdjoinRoot.mk f H := by
      have h2 := congrArg (AdjoinRoot.mk f) hH
      rw [map_mul, map_sub, map_sub, AdjoinRoot.mk_X, AdjoinRoot.mk_C, AdjoinRoot.mk_C] at h2
      exact h2
    have huw' : AdjoinRoot.of f u * AdjoinRoot.of f w = 1 := by
      rw [← map_mul, huw, map_one]
    have hcI : AdjoinRoot.of f c ∈ Ideal.map (AdjoinRoot.of f) I := Ideal.mem_map_of_mem _ hf0
    refine ⟨AdjoinRoot.of f u * AdjoinRoot.mk f G, ?_, ?_, ?_⟩
    · have : AdjoinRoot.of f u * AdjoinRoot.mk f G * (AdjoinRoot.of f u * AdjoinRoot.mk f G) -
          AdjoinRoot.of f u * AdjoinRoot.mk f G =
          (AdjoinRoot.of f u ^ 2 * AdjoinRoot.mk f H) * (-(AdjoinRoot.of f c)) := by
        linear_combination (AdjoinRoot.of f u) ^ 2 * AdjoinRoot.mk f G * hH' +
          AdjoinRoot.of f u * AdjoinRoot.mk f G * huw' +
          (AdjoinRoot.of f u) ^ 2 * AdjoinRoot.mk f H * hkey
      rw [this]
      exact Ideal.mul_mem_left _ _ (neg_mem hcI)
    · have : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * (AdjoinRoot.of f u * AdjoinRoot.mk f G) =
          AdjoinRoot.of f u * (-(AdjoinRoot.of f c)) := by
        linear_combination AdjoinRoot.of f u * hkey
      rw [this]
      exact Ideal.mul_mem_left _ _ (neg_mem hcI)
    · intro hmem
      set lam : AdjoinRoot f →ₗ[S] S :=
        (Polynomial.lcoeff S (f.natDegree - 1)).comp (AdjoinRoot.modByMonicHom hf) with hlam
      have hlamG : lam (AdjoinRoot.mk f G) = 1 := by
        rw [hlam, LinearMap.comp_apply, AdjoinRoot.modByMonicHom_mk]
        have hGf : G %ₘ f = G := by
          rw [Polynomial.modByMonic_eq_self_iff hf]
          apply Polynomial.degree_lt_degree
          omega
        rw [hGf, Polynomial.lcoeff_apply, ← hGdeg]
        exact hGmonic.coeff_natDegree
      have hlamε : lam (AdjoinRoot.of f u * AdjoinRoot.mk f G) = u := by
        rw [← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def, map_smul, hlamG, smul_eq_mul, mul_one]
      have hlamJ : ∀ x ∈ Ideal.map (AdjoinRoot.of f) I, lam x ∈ I := by
        intro x hx
        rw [← AdjoinRoot.algebraMap_eq] at hx
        have hx' : x ∈ I • (⊤ : Submodule S (AdjoinRoot f)) := by
          rw [Ideal.smul_top_eq_map]
          exact (Submodule.restrictScalars_mem S _ _).mpr hx
        refine Submodule.smul_induction_on hx' ?_ ?_
        · intro r hr n _
          rw [map_smul, smul_eq_mul]
          exact I.mul_mem_right _ hr
        · intro x y hx hy
          rw [map_add]
          exact I.add_mem hx hy
      have huI := hlamJ _ hmem
      rw [hlamε] at huI
      exact hI (Ideal.eq_top_of_isUnit_mem _ huI (IsUnit.of_mul_eq_one w huw))

  have hs4 : ∀ (f : Polynomial S), Module.Finite R (AdjoinRoot f) → ∀ (a₀ : S)
      (e : AdjoinRoot f), IsIdempotentElem e →
      (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * e ∈
        Ideal.map (algebraMap R (AdjoinRoot f)) (IsLocalRing.maximalIdeal R) →
      ∃ a : S, AdjoinRoot.root f * e = algebraMap S (AdjoinRoot f) a * e := by
    intro f hfinC a₀ e he ht
    set W : Submodule R (AdjoinRoot f) := LinearMap.range (LinearMap.mulRight R e) with hW
    set N₀ : Submodule R (AdjoinRoot f) := (Submodule.span S {e}).restrictScalars R with hN₀
    have hWfg : W.FG := by
      rw [hW, LinearMap.range_eq_map]
      exact Module.Finite.fg_top.map _
    have hIW : ∀ t ∈ Ideal.map (algebraMap R (AdjoinRoot f)) (IsLocalRing.maximalIdeal R),
        t * e ∈ (IsLocalRing.maximalIdeal R) • W := by
      intro t htI
      have h1 : t ∈ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R (AdjoinRoot f)) := by
        rw [Ideal.smul_top_eq_map]
        exact (Submodule.restrictScalars_mem R _ _).mpr htI
      have h2 : LinearMap.mulRight R e t ∈
          Submodule.map (LinearMap.mulRight R e) ((IsLocalRing.maximalIdeal R) • ⊤) :=
        Submodule.mem_map_of_mem h1
      rw [Submodule.map_smul'', ← LinearMap.range_eq_map] at h2
      exact h2
    have hsup : W ≤ N₀ ⊔ (IsLocalRing.maximalIdeal R) • W := by
      rintro x ⟨z, rfl⟩
      obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective z
      obtain ⟨Q, hQ⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := a₀) (p := P)
      have h2 := congrArg (AdjoinRoot.mk f) hQ
      rw [map_mul, map_sub, map_sub, AdjoinRoot.mk_X, AdjoinRoot.mk_C, AdjoinRoot.mk_C] at h2
      have hdec : LinearMap.mulRight R e (AdjoinRoot.mk f P) =
          P.eval a₀ • e + (AdjoinRoot.mk f Q *
            ((AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * e)) * e := by
        rw [LinearMap.mulRight_apply, Algebra.smul_def, AdjoinRoot.algebraMap_eq]
        have he' : e * e = e := he
        linear_combination e * h2 -
          (AdjoinRoot.mk f Q * (AdjoinRoot.root f - AdjoinRoot.of f a₀)) * he'
      rw [hdec]
      refine Submodule.add_mem_sup ?_ ?_
      · exact (Submodule.restrictScalars_mem R _ _).mpr
          (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self e))
      · exact hIW _ (Ideal.mul_mem_left _ _ ht)
    have hle := Submodule.le_of_le_smul_of_le_jacobson_bot hWfg
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hsup
    have hy : AdjoinRoot.root f * e ∈ W := ⟨AdjoinRoot.root f, rfl⟩
    have hy' := hle hy
    rw [hN₀, Submodule.restrictScalars_mem, Submodule.mem_span_singleton] at hy'
    obtain ⟨a, ha⟩ := hy'
    exact ⟨a, by rw [← ha, Algebra.smul_def]⟩

  set N := Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) with hNdef
  have hN : N.IsMaximal := (Ideal.Quotient.maximal_ideal_iff_isField_quotient N).mpr hfield
  haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
  have huniq : ∀ M : Ideal S, M.IsMaximal → M = N := by
    intro M hM
    have h1 := Ideal.IsMaximal.under R M
    have h2 : Ideal.under R M = IsLocalRing.maximalIdeal R := IsLocalRing.eq_maximalIdeal h1
    have h3 : N ≤ M := by
      rw [hNdef, Ideal.map_le_iff_le_comap, ← Ideal.under_def, h2]
    exact (hN.eq_of_le hM.ne_top h3).symm
  letI hloc : IsLocalRing S := IsLocalRing.of_unique_max_ideal ⟨N, hN, fun M hM => huniq M hM⟩
  have hmS : IsLocalRing.maximalIdeal S = N := huniq _ (IsLocalRing.maximalIdeal.isMaximal S)

  have hs5 : ∀ (f : Polynomial S), f.Monic → ∀ (a₀ a : S) (e : AdjoinRoot f),
      e ∉ Ideal.map (algebraMap S (AdjoinRoot f)) (IsLocalRing.maximalIdeal S) →
      AdjoinRoot.root f * e = algebraMap S (AdjoinRoot f) a * e →
      (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * e ∈
        Ideal.map (algebraMap S (AdjoinRoot f)) (IsLocalRing.maximalIdeal S) →
      f.IsRoot a ∧ a - a₀ ∈ IsLocalRing.maximalIdeal S := by
    intro f hf a₀ a e he hroot ht
    rw [AdjoinRoot.algebraMap_eq] at he hroot ht
    have hP : ∀ P : Polynomial S, AdjoinRoot.mk f P * e = AdjoinRoot.of f (P.eval a) * e := by
      intro P
      induction P using Polynomial.induction_on with
      | C x => rw [AdjoinRoot.mk_C, Polynomial.eval_C]
      | add p q hp hq =>
        rw [map_add, add_mul, hp, hq, Polynomial.eval_add, map_add, add_mul]
      | monomial n x ih =>
        simp only [map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X, Polynomial.eval_mul,
          Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X] at ih ⊢
        calc AdjoinRoot.of f x * AdjoinRoot.root f ^ (n + 1) * e
            = AdjoinRoot.root f * (AdjoinRoot.of f x * AdjoinRoot.root f ^ n * e) := by ring
          _ = AdjoinRoot.root f * (AdjoinRoot.of f x * AdjoinRoot.of f a ^ n * e) := by rw [ih]
          _ = AdjoinRoot.of f x * AdjoinRoot.of f a ^ n * (AdjoinRoot.root f * e) := by ring
          _ = AdjoinRoot.of f x * AdjoinRoot.of f a ^ (n + 1) * e := by rw [hroot]; ring
    have he0 : e ≠ 0 := by
      rintro rfl
      exact he (Ideal.zero_mem _)
    refine ⟨?_, ?_⟩
    · have h1 := hP f
      rw [AdjoinRoot.mk_self, zero_mul] at h1
      have h2 : (f.eval a) • e = 0 := by
        rw [Algebra.smul_def, AdjoinRoot.algebraMap_eq]; exact h1.symm
      have := Module.Free.of_basis (AdjoinRoot.powerBasis' hf).basis
      by_contra hne
      have hreg : IsSMulRegular (AdjoinRoot f) (f.eval a) :=
        Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hne)
      apply he0
      apply hreg
      exact h2.trans (smul_zero _).symm
    · by_contra hne
      obtain ⟨v, hv⟩ := (IsLocalRing.notMem_maximalIdeal.mp hne).exists_left_inv
      apply he
      have h1 : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * e = AdjoinRoot.of f (a - a₀) * e := by
        rw [map_sub]; linear_combination hroot
      have h2 : e = AdjoinRoot.of f v * ((AdjoinRoot.root f - AdjoinRoot.of f a₀) * e) := by
        rw [h1, ← mul_assoc, ← map_mul, hv, map_one, one_mul]
      rw [h2]
      exact Ideal.mul_mem_left _ _ ht

  refine @HenselianLocalRing.mk S _ hloc ?_
  intro f hf a₀ hf0 hu
  have hJ : Ideal.map (algebraMap R (AdjoinRoot f)) (IsLocalRing.maximalIdeal R) =
      Ideal.map (algebraMap S (AdjoinRoot f)) (IsLocalRing.maximalIdeal S) := by
    rw [hmS, hNdef, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  haveI : Module.Finite S (AdjoinRoot f) := (AdjoinRoot.powerBasis' hf).finite
  haveI hfinC : Module.Finite R (AdjoinRoot f) := Module.Finite.trans S (AdjoinRoot f)
  obtain ⟨ε, hε1, hε2, hε3⟩ :=
    hs2 (IsLocalRing.maximalIdeal S) (IsLocalRing.maximalIdeal.isMaximal S).ne_top f hf a₀ hf0 hu
  rw [← hJ] at hε1
  obtain ⟨e, he, hee⟩ := wcpa_hs_idempotent_lift R (AdjoinRoot f) hfinC ε hε1
  rw [hJ] at hee
  have he3 : e ∉ Ideal.map (algebraMap S (AdjoinRoot f)) (IsLocalRing.maximalIdeal S) := by
    intro h
    apply hε3
    have := Ideal.sub_mem _ h hee
    rwa [sub_sub_cancel] at this
  have he2 : (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * e ∈
      Ideal.map (algebraMap S (AdjoinRoot f)) (IsLocalRing.maximalIdeal S) := by
    have : (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * e =
        (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * ε +
          (AdjoinRoot.root f - algebraMap S (AdjoinRoot f) a₀) * (e - ε) := by ring
    rw [this]
    exact Ideal.add_mem _ hε2 (Ideal.mul_mem_left _ _ hee)
  obtain ⟨a, ha⟩ := hs4 f hfinC a₀ e he (by rw [hJ]; exact he2)
  exact ⟨a, hs5 f hf a₀ a e he3 ha he2⟩

theorem wcpa_hs_separable_point : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A], Algebra.Smooth k A → Nontrivial A → ∃ (L : Type u) (_ : Field L) (_ : Algebra k L), FiniteDimensional k L ∧ Algebra.IsSeparable k L ∧ Nonempty (A →ₐ[k] L) :=
by
  intro k _ A _ _ hsm hA
  classical
  by_cases hk : Finite k
  · obtain ⟨M, hM⟩ := Ideal.exists_maximal A
    letI : Field (A ⧸ M) := Ideal.Quotient.field M
    haveI : Algebra.FiniteType k A := inferInstance
    haveI : Module.Finite k (A ⧸ M) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ M)
    haveI : Algebra.IsAlgebraic k (A ⧸ M) := Algebra.IsAlgebraic.of_finite k (A ⧸ M)
    haveI : PerfectField k := inferInstance
    exact ⟨A ⧸ M, inferInstance, inferInstance, inferInstance,
      Algebra.IsAlgebraic.isSeparable_of_perfectField, ⟨Ideal.Quotient.mkₐ k M⟩⟩
  · haveI : Infinite k := not_finite_iff_infinite.mp hk
    obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth k A
    obtain ⟨M, hM⟩ := Ideal.exists_maximal A
    obtain ⟨x, hxs, hxM⟩ : ∃ x ∈ s, x ∉ M := by
      by_contra h
      push_neg at h
      have h' : Ideal.span s ≤ M := Ideal.span_le.mpr h
      rw [hs] at h'
      exact hM.ne_top (top_le_iff.mp h')
    haveI := hstd x hxs
    haveI hBnt : Nontrivial (Localization.Away x) := by
      refine nontrivial_of_ne 0 1 ?_
      intro h
      have h1 : algebraMap A (Localization.Away x) 1 = 0 := by rw [map_one]; exact h.symm
      obtain ⟨⟨_, j, rfl⟩, hj⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers x) (Localization.Away x) 1).mp h1
      have hxj : x ^ j ∈ M := by
        simp only [mul_one] at hj
        rw [hj]; exact M.zero_mem
      exact hxM (hM.isPrime.mem_of_pow_mem j hxj)
    have h1 : (algebraMap k (Localization.Away x)).IsStandardSmooth :=
      RingHom.isStandardSmooth_algebraMap.mpr inferInstance
    obtain ⟨n, g, hgC, hgE⟩ := RingHom.IsStandardSmooth.exists_etale_mvPolynomial h1
    letI : Algebra (MvPolynomial (Fin n) k) (Localization.Away x) := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin n) k) (Localization.Away x) := hgE
    have hopen : IsOpenMap (PrimeSpectrum.comap
        (algebraMap (MvPolynomial (Fin n) k) (Localization.Away x))) :=
      PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
    obtain ⟨q⟩ := (inferInstance : Nonempty (PrimeSpectrum (Localization.Away x)))
    obtain ⟨_, ⟨f, rfl⟩, hqf, hfU⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
        (Set.mem_range_self q) hopen.isOpen_range
    have hf0 : f ≠ 0 := by
      rintro rfl
      simp at hqf
    obtain ⟨a, ha⟩ : ∃ a : Fin n → k, MvPolynomial.eval a f ≠ 0 := by
      by_contra h
      push_neg at h
      exact hf0 (MvPolynomial.funext (fun y => by simpa using h y))
    have hsurj : Function.Surjective (MvPolynomial.eval a : MvPolynomial (Fin n) k →+* k) :=
      fun c => ⟨MvPolynomial.C c, MvPolynomial.eval_C c⟩
    have hm : (RingHom.ker (MvPolynomial.eval a)).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective _ hsurj
    have hmem : (⟨RingHom.ker (MvPolynomial.eval a), hm.isPrime⟩ : PrimeSpectrum _) ∈
        (PrimeSpectrum.basicOpen f : Set _) := by
      simpa [PrimeSpectrum.mem_basicOpen, RingHom.mem_ker] using ha
    obtain ⟨q', hq'⟩ := hfU hmem
    obtain ⟨N, hN, hqN⟩ := Ideal.exists_le_maximal q'.asIdeal q'.isPrime.ne_top
    have hcomap : Ideal.comap (algebraMap (MvPolynomial (Fin n) k) (Localization.Away x)) N =
        RingHom.ker (MvPolynomial.eval a) := by
      have h2 : RingHom.ker (MvPolynomial.eval a) ≤
          Ideal.comap (algebraMap (MvPolynomial (Fin n) k) (Localization.Away x)) N := by
        have h3 : (PrimeSpectrum.comap (algebraMap (MvPolynomial (Fin n) k)
            (Localization.Away x)) q').asIdeal = RingHom.ker (MvPolynomial.eval a) := by
          rw [hq']
        rw [← h3, PrimeSpectrum.comap_asIdeal]
        exact Ideal.comap_mono hqN
      exact (hm.eq_of_le (Ideal.comap_ne_top _ hN.ne_top) h2).symm
    haveI : IsScalarTower k (MvPolynomial (Fin n) k) (Localization.Away x) :=
      IsScalarTower.of_algebraMap_eq' (by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, hgC])
    haveI : N.LiesOver (RingHom.ker (MvPolynomial.eval a)) := ⟨by rw [Ideal.under_def, hcomap]⟩
    letI : Field (Localization.Away x ⧸ N) := Ideal.Quotient.field N
    letI : Field (MvPolynomial (Fin n) k ⧸ RingHom.ker (MvPolynomial.eval a)) :=
      Ideal.Quotient.field _
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin n) k) (Localization.Away x ⧸ N) :=
      inferInstance
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin n) k ⧸ RingHom.ker (MvPolynomial.eval a))
        (Localization.Away x ⧸ N) :=
      Algebra.FormallyUnramified.of_restrictScalars (MvPolynomial (Fin n) k) _ _
    haveI : Algebra.FormallyUnramified k
        (MvPolynomial (Fin n) k ⧸ RingHom.ker (MvPolynomial.eval a)) := by
      refine Algebra.FormallyUnramified.of_surjective (Algebra.ofId k _) ?_
      intro y
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨MvPolynomial.eval a p, ?_⟩
      rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply k (MvPolynomial (Fin n) k),
        Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq,
        RingHom.mem_ker, map_sub, MvPolynomial.eval_C, sub_self]
    haveI : Algebra.FormallyUnramified k (Localization.Away x ⧸ N) :=
      Algebra.FormallyUnramified.comp k
        (MvPolynomial (Fin n) k ⧸ RingHom.ker (MvPolynomial.eval a)) _
    haveI : Algebra.FiniteType k (Localization.Away x) := inferInstance
    haveI : Algebra.FiniteType k (Localization.Away x ⧸ N) := inferInstance
    haveI : Algebra.IsSeparable k (Localization.Away x ⧸ N) :=
      Algebra.FormallyUnramified.isSeparable k _
    haveI : Module.Finite k (Localization.Away x ⧸ N) :=
      finite_of_finite_type_of_isJacobsonRing k _
    exact ⟨Localization.Away x ⧸ N, inferInstance, inferInstance, inferInstance, inferInstance,
      ⟨(Ideal.Quotient.mkₐ k N).comp (IsScalarTower.toAlgHom k A (Localization.Away x))⟩⟩

theorem wcpa_hs_unramified_lift : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] (L : Type u) [Field L] [Algebra (IsLocalRing.ResidueField V) L] [Algebra V L] [IsScalarTower V (IsLocalRing.ResidueField V) L], FiniteDimensional (IsLocalRing.ResidueField V) L → Algebra.IsSeparable (IsLocalRing.ResidueField V) L → ∃ (V'' : Type u) (_ : CommRing V'') (_ : IsDomain V'') (_ : Algebra V V''), Module.Free V V'' ∧ Module.Finite V V'' ∧ IsField (V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)) ∧ Nonempty (L →ₐ[V] V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)) :=
by
  intro V _ _ _ L _ _ _ _ hfin hsep
  classical
  haveI := hfin
  haveI := hsep
  set k := IsLocalRing.ResidueField V with hk
  set pb := Field.powerBasisOfFiniteOfSeparable k L with hpb
  have hpint : IsIntegral k pb.gen := pb.isIntegral_gen
  have hpmon : (minpoly k pb.gen).Monic := minpoly.monic hpint
  have hpirr : Irreducible (minpoly k pb.gen) := minpoly.irreducible hpint
  have hlift : minpoly k pb.gen ∈ Polynomial.lifts (IsLocalRing.residue V) := by
    rw [Polynomial.mem_lifts]
    exact Polynomial.map_surjective _ IsLocalRing.residue_surjective _
  obtain ⟨f, hfmap, _, hfmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon

  have hfirr' : Irreducible (f.map (IsLocalRing.residue V)) := by rw [hfmap]; exact hpirr
  have hprime : Prime f := by
    have ha : Irreducible f := hfmon.irreducible_of_irreducible_map _ f hfirr'
    have hb : Irreducible (f.map (algebraMap V (FractionRing V))) :=
      (hfmon.irreducible_iff_irreducible_map_fraction_map (K := FractionRing V)).mp ha
    have hc : Prime (f.map (algebraMap V (FractionRing V))) := hb.prime
    have hinj := IsFractionRing.injective V (FractionRing V)
    refine ⟨hfmon.ne_zero, ha.not_isUnit, ?_⟩
    intro a b hab
    have h1 := Polynomial.map_dvd (algebraMap V (FractionRing V)) hab
    rw [Polynomial.map_mul] at h1
    rcases hc.dvd_or_dvd h1 with h | h
    · exact Or.inl ((Polynomial.map_dvd_map _ hinj hfmon).mp h)
    · exact Or.inr ((Polynomial.map_dvd_map _ hinj hfmon).mp h)
  haveI hdom : IsDomain (AdjoinRoot f) := AdjoinRoot.isDomain_of_prime hprime
  set pbf := AdjoinRoot.powerBasis' hfmon with hpbf
  haveI : Fact (Irreducible (f.map (IsLocalRing.residue V))) := ⟨hfirr'⟩
  let e : (AdjoinRoot f ⧸ Ideal.map (algebraMap V (AdjoinRoot f)) (IsLocalRing.maximalIdeal V))
      ≃ₐ[V] AdjoinRoot (f.map (IsLocalRing.residue V)) :=
    (Ideal.quotientEquivAlgOfEq V
      (congrArg (fun φ => Ideal.map φ (IsLocalRing.maximalIdeal V))
        (AdjoinRoot.algebraMap_eq f))).trans
      (AdjoinRoot.quotEquivQuotMap f (IsLocalRing.maximalIdeal V))
  have hroot : Polynomial.aeval (AdjoinRoot.root (f.map (IsLocalRing.residue V)))
      (minpoly k pb.gen) = 0 := by
    rw [← hfmap, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  let g : L →ₐ[k] AdjoinRoot (f.map (IsLocalRing.residue V)) :=
    pb.lift (AdjoinRoot.root (f.map (IsLocalRing.residue V))) hroot
  refine ⟨AdjoinRoot f, inferInstance, hdom, inferInstance, Module.Free.of_basis pbf.basis,
    pbf.finite, ?_, ⟨e.symm.toAlgHom.comp (g.restrictScalars V)⟩⟩
  exact MulEquiv.isField (Field.toIsField _) e.toRingEquiv.toMulEquiv

theorem wcpa_hs_smooth_section : ∀ (S : Type u) [CommRing S] [HenselianLocalRing S] (A : Type u) [CommRing A] [Algebra S A], Algebra.Smooth S A → (A →ₐ[S] IsLocalRing.ResidueField S) → Nonempty (A →ₐ[S] S) :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (B : Type u) [CommRing B]
      [Algebra R B], Algebra.Etale R B → (B →ₐ[R] IsLocalRing.ResidueField R) →
      Nonempty (B →ₐ[R] R) := by
    intro R _ _ B _ _ het φ
    haveI := het
    haveI hQ : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
    haveI : Algebra.FinitePresentation R B := inferInstance
    haveI : Algebra.IsEtaleAt R (RingHom.ker φ) :=
      (inferInstance : Algebra.FormallyEtale R (Localization.AtPrime (RingHom.ker φ)))
    obtain ⟨f, hfQ, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker φ)
    obtain ⟨P⟩ := hstd.nonempty_standardEtalePresentation
    let e : P.Ring ≃ₐ[R] Localization.Away f :=
      AlgEquiv.ofBijective (P.lift P.x P.hasMap) P.lift_bijective
    have hunit : IsUnit (φ f) := by
      refine IsUnit.mk0 _ ?_
      intro h0
      exact hfQ (RingHom.mem_ker.mpr h0)
    let φf : Localization.Away f →ₐ[R] IsLocalRing.ResidueField R :=
      IsLocalization.Away.liftAlgHom f hunit
    have hf0 : Polynomial.aeval (φf P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, P.hasMap.1, map_zero]
    have hg0 : Polynomial.aeval (φf P.x) P.g ≠ 0 := by
      rw [Polynomial.aeval_algHom_apply]
      exact (P.hasMap.2.map φf).ne_zero
    have hd0 : Polynomial.aeval (φf P.x) (Polynomial.derivative P.f) ≠ 0 := by
      obtain ⟨p₁, p₂, m, hc⟩ := P.cond
      have h1 := congrArg (Polynomial.aeval (φf P.x)) hc
      rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
      intro h
      rw [h, zero_mul] at h1
      exact pow_ne_zero m hg0 h1.symm
    have hhens := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
    obtain ⟨a, ha, hares⟩ := hhens P.f P.monic_f (φf P.x) hf0 hd0
    have hres : ∀ p : Polynomial R,
        IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval (φf P.x) p := by
      intro p
      rw [← hares]
      exact (Polynomial.aeval_algHom_apply (Algebra.ofId R (IsLocalRing.ResidueField R)) a p).symm
    have hA : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]; exact ha
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres]; exact hg0
    exact ⟨((P.lift a hA).comp e.symm.toAlgHom).comp
      (IsScalarTower.toAlgHom R B (Localization.Away f))⟩
  intro S _ _ A _ _ hsm ψ
  haveI := hsm

  haveI hQ : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  obtain ⟨s, hs, hst⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth S A
  have hex : ∃ h ∈ s, h ∉ RingHom.ker ψ := by
    by_contra hc
    push_neg at hc
    exact hQ.ne_top (eq_top_iff.mpr (hs ▸ Ideal.span_le.mpr hc))
  obtain ⟨h, hhs, hhQ⟩ := hex
  obtain ⟨n, g, hgC, hg⟩ :=
    (RingHom.isStandardSmooth_algebraMap.mpr (hst h hhs)).exists_etale_mvPolynomial

  have hunit : IsUnit (ψ h) := IsUnit.mk0 _ (fun h0 => hhQ (RingHom.mem_ker.mpr h0))
  let ψh : Localization.Away h →ₐ[S] IsLocalRing.ResidueField S :=
    IsLocalization.Away.liftAlgHom h hunit

  let a : Fin n → S := fun i => (IsLocalRing.residue_surjective (ψh (g (MvPolynomial.X i)))).choose
  have ha : ∀ i, IsLocalRing.residue S (a i) = ψh (g (MvPolynomial.X i)) := fun i =>
    (IsLocalRing.residue_surjective _).choose_spec
  let ev : MvPolynomial (Fin n) S →ₐ[S] S := MvPolynomial.aeval a
  letI : Algebra (MvPolynomial (Fin n) S) (Localization.Away h) := g.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin n) S) (Localization.Away h) := RingHom.Etale.toAlgebra hg
  letI : Algebra (MvPolynomial (Fin n) S) S := ev.toRingHom.toAlgebra
  haveI hBet : Algebra.Etale S (TensorProduct (MvPolynomial (Fin n) S) S (Localization.Away h)) :=
    Algebra.Etale.baseChange _ _ _
  have hgCr : ∀ r : S, g (MvPolynomial.C r) = algebraMap S (Localization.Away h) r := by
    intro r; rw [← hgC]; rfl
  have hcomm : ψh.toRingHom.comp g =
      (algebraMap S (IsLocalRing.ResidueField S)).comp ev.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro r
      show ψh (g (MvPolynomial.C r)) = algebraMap S _ (ev (MvPolynomial.C r))
      rw [hgCr, AlgHom.commutes, MvPolynomial.aeval_C]
      rfl
    · intro i
      show ψh (g (MvPolynomial.X i)) = algebraMap S _ (ev (MvPolynomial.X i))
      rw [MvPolynomial.aeval_X, ← ha i]
      rfl
  letI : Algebra (MvPolynomial (Fin n) S) (IsLocalRing.ResidueField S) :=
    ((algebraMap S (IsLocalRing.ResidueField S)).comp ev.toRingHom).toAlgebra
  haveI : IsScalarTower (MvPolynomial (Fin n) S) S (IsLocalRing.ResidueField S) :=
    IsScalarTower.of_algebraMap_eq' rfl
  let ψ' : Localization.Away h →ₐ[MvPolynomial (Fin n) S] IsLocalRing.ResidueField S :=
    { ψh.toRingHom with
      commutes' := fun p => RingHom.congr_fun hcomm p }
  let φB : TensorProduct (MvPolynomial (Fin n) S) S (Localization.Away h) →ₐ[S]
      IsLocalRing.ResidueField S :=
    Algebra.TensorProduct.lift (Algebra.ofId S _) ψ' (fun _ _ => Commute.all _ _)
  let ι : Localization.Away h →ₐ[S]
      TensorProduct (MvPolynomial (Fin n) S) S (Localization.Away h) :=
    { (Algebra.TensorProduct.includeRight : Localization.Away h →ₐ[MvPolynomial (Fin n) S]
        TensorProduct (MvPolynomial (Fin n) S) S (Localization.Away h)).toRingHom with
      commutes' := fun r => by
        show (1 : S) ⊗ₜ[MvPolynomial (Fin n) S] (algebraMap S (Localization.Away h) r) = _
        rw [Algebra.TensorProduct.algebraMap_apply, ← hgCr]
        show (1 : S) ⊗ₜ[MvPolynomial (Fin n) S]
          (algebraMap (MvPolynomial (Fin n) S) (Localization.Away h) (MvPolynomial.C r)) = _
        rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul]
        congr 1
        show ev (MvPolynomial.C r) = algebraMap S S r
        rw [MvPolynomial.aeval_C] }

  obtain ⟨σ⟩ := s1 S _ hBet φB
  exact ⟨σ.comp (ι.comp (IsScalarTower.toAlgHom S A (Localization.Away h)))⟩

theorem wcpa_gf_henselian_section : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    [HenselianLocalRing V] (E : Type u) [CommRing E] [Algebra V E], Algebra.Smooth V E →
    Ideal.map (algebraMap V E) (IsLocalRing.maximalIdeal V) ≠ ⊤ →
    ∃ (V'' : Type u) (_ : CommRing V'') (_ : IsDomain V'') (_ : Algebra V V''),
      Module.Free V V'' ∧ Module.Finite V V'' ∧
      IsField (V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)) ∧
      Nonempty (E →ₐ[V] V'') :=
by
  intro V _ _ _ _ E _ _ hsm hmE
  classical
  haveI : Algebra.Smooth V E := hsm

  haveI hsm0 : Algebra.Smooth (IsLocalRing.ResidueField V)
      (TensorProduct V (IsLocalRing.ResidueField V) E) := inferInstance
  have hnt : Nontrivial (TensorProduct V (IsLocalRing.ResidueField V) E) := by
    haveI : Nontrivial (E ⧸ Ideal.map (algebraMap V E) (IsLocalRing.maximalIdeal V)) :=
      Ideal.Quotient.nontrivial_iff.mpr hmE
    let f1 : IsLocalRing.ResidueField V →ₐ[V]
        E ⧸ Ideal.map (algebraMap V E) (IsLocalRing.maximalIdeal V) :=
      Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal V)
        (Algebra.ofId V (E ⧸ Ideal.map (algebraMap V E) (IsLocalRing.maximalIdeal V)))
        (fun a ha => by
          rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply V E,
            Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_map_of_mem _ ha)
    let f2 : E →ₐ[V] E ⧸ Ideal.map (algebraMap V E) (IsLocalRing.maximalIdeal V) :=
      Ideal.Quotient.mkₐ V _
    exact (Algebra.TensorProduct.lift f1 f2 (fun _ _ => Commute.all _ _)).toRingHom.domain_nontrivial

  obtain ⟨L, _, _, hLfin, hLsep, ⟨χ₀⟩⟩ :=
    wcpa_hs_separable_point (IsLocalRing.ResidueField V) _ hsm0 hnt

  letI : Algebra V L :=
    ((algebraMap (IsLocalRing.ResidueField V) L).comp
      (algebraMap V (IsLocalRing.ResidueField V))).toAlgebra
  haveI : IsScalarTower V (IsLocalRing.ResidueField V) L := IsScalarTower.of_algebraMap_eq' rfl
  obtain ⟨V'', _, _, _, hfree, hfin, hfield, ⟨φ⟩⟩ := wcpa_hs_unramified_lift V L hLfin hLsep

  haveI hhens : HenselianLocalRing V'' := wcpa_hs_finite_domain_henselian V V'' hfree hfin hfield
  have hNmax : (Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)).IsMaximal :=
    Ideal.Quotient.maximal_ideal_iff_isField_quotient _ |>.mpr hfield
  have hNle : Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) ≤
      IsLocalRing.maximalIdeal V'' := (IsLocalRing.eq_maximalIdeal hNmax).le

  haveI hsmA : Algebra.Smooth V'' (TensorProduct V V'' E) := inferInstance
  let g : E →ₐ[V] V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) :=
    φ.comp ((χ₀.restrictScalars V).comp Algebra.TensorProduct.includeRight)
  let ψ' : TensorProduct V V'' E →ₐ[V''] V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) :=
    Algebra.TensorProduct.lift (Algebra.ofId V'' _) g (fun _ _ => Commute.all _ _)
  let fac : V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) →ₐ[V'']
      IsLocalRing.ResidueField V'' := Ideal.Quotient.factorₐ V'' hNle

  obtain ⟨σ⟩ := wcpa_hs_smooth_section V'' (TensorProduct V V'' E) hsmA (fac.comp ψ')

  exact ⟨V'', inferInstance, inferInstance, inferInstance, hfree, hfin, hfield,
    ⟨(σ.restrictScalars V).comp Algebra.TensorProduct.includeRight⟩⟩

theorem wcpa_gf_saturation : ∀ (V : Type u) [CommRing V] [IsDomain V] (R : Type u) [CommRing R]
    [IsDomain R] [IsIntegrallyClosed R] [Algebra V R], Function.Injective (algebraMap V R) →
    ∀ (E : Type u) [CommRing E] [Algebra V E] (ι : E →ₐ[V] R), Function.Injective ι →
    ∀ (V'' : Type u) [CommRing V''] [IsDomain V''] [Algebra V V''] [Module.Free V V'']
      [Module.Finite V V''] (σ : E →ₐ[V] V'') (e : E), IsIntegral V (ι e) →
    ∃ (W : Subalgebra V V'') (χ : W →ₐ[V] R), ∃ h : σ e ∈ W, χ ⟨σ e, h⟩ = ι e ∧
      (∀ v : V'', ∀ s : V, s ≠ 0 → s • v ∈ W → v ∈ W) :=
by
  intro V _ _ R _ _ _ _ hVR E _ _ ι hι V'' _ _ _ _ _ σ e he
  classical

  have hP1 : Function.Injective (algebraMap V V'') := FaithfulSMul.algebraMap_injective V V''
  have hP2 : ∀ s : V, s ≠ 0 → algebraMap V R s ≠ 0 := fun s hs h =>
    hs (hVR (h.trans (map_zero _).symm))
  obtain ⟨E₀, hE₀⟩ : ∃ E₀ : Subalgebra V E, E₀ = Algebra.adjoin V {e} := ⟨_, rfl⟩
  have heE₀ : e ∈ E₀ := by rw [hE₀]; exact Algebra.self_mem_adjoin_singleton V e

  have hint : ∀ x ∈ E₀, _root_.IsIntegral V (ι x) := by
    intro x hx
    rw [hE₀] at hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => rw [Set.mem_singleton_iff.mp hx]; exact he
    | algebraMap r => rw [AlgHom.commutes]; exact isIntegral_algebraMap
    | add x y _ _ hx hy => rw [map_add]; exact hx.add hy
    | mul x y _ _ hx hy => rw [map_mul]; exact hx.mul hy

  have s1 : ∀ x ∈ E₀, σ x = 0 → x = 0 := by
    intro x hx hσx
    by_contra hx0
    obtain ⟨p, hpm, hp⟩ := hint x hx
    have hp' : Polynomial.aeval (ι x) p = 0 := by rw [Polynomial.aeval_def]; exact hp
    have hp0 : p ≠ 0 := hpm.ne_zero
    obtain ⟨q, hpq, hq⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd p hp0 0
    rw [map_zero, sub_zero] at hpq hq
    have hq0 : q.coeff 0 ≠ 0 := fun h => hq (Polynomial.X_dvd_iff.mpr h)
    have hy0 : ι x ≠ 0 := fun h => hx0 (hι (h.trans (map_zero ι).symm))
    have h1 : Polynomial.aeval (ι x) q = 0 := by
      rw [hpq, map_mul, map_pow, Polynomial.aeval_X] at hp'
      exact (mul_eq_zero.mp hp').resolve_left (pow_ne_zero _ hy0)
    have h2 : Polynomial.aeval x q = 0 := by
      apply hι
      rw [← Polynomial.aeval_algHom_apply, h1, map_zero]
    have h3 : Polynomial.aeval (σ x) q = 0 := by
      rw [Polynomial.aeval_algHom_apply, h2, map_zero]
    rw [hσx, Polynomial.aeval_def, Polynomial.eval₂_at_zero] at h3
    exact hq0 (hP1 (h3.trans (map_zero _).symm))

  have s2 : ∀ (p : Polynomial V), p.Monic → ∀ (s : V), s ≠ 0 → ∀ (y : R),
      Polynomial.aeval y (p.scaleRoots s) = 0 → ∃ r : R, algebraMap V R s * r = y := by
    intro p hpm s hs y hy
    have hj : Function.Injective (algebraMap R (FractionRing R)) :=
      IsFractionRing.injective R (FractionRing R)
    have hfs : algebraMap V (FractionRing R) s ≠ 0 := by
      rw [IsScalarTower.algebraMap_apply V R (FractionRing R)]
      exact (map_ne_zero_iff _ hj).mpr (hP2 s hs)
    obtain ⟨ρ, hρ⟩ : ∃ ρ : FractionRing R,
        ρ = algebraMap R (FractionRing R) y / algebraMap V (FractionRing R) s := ⟨_, rfl⟩
    have hsρ : algebraMap V (FractionRing R) s * ρ = algebraMap R (FractionRing R) y := by
      rw [hρ]; exact mul_div_cancel₀ _ hfs
    have hρroot : Polynomial.eval₂ (algebraMap V (FractionRing R)) ρ p = 0 := by
      have h := Polynomial.scaleRoots_eval₂_mul (p := p) (algebraMap V (FractionRing R)) ρ s
      rw [hsρ, ← Polynomial.aeval_def, Polynomial.aeval_algebraMap_apply, hy, map_zero] at h
      exact (mul_eq_zero.mp h.symm).resolve_left (pow_ne_zero _ hfs)
    have hρV : _root_.IsIntegral V ρ := ⟨p, hpm, hρroot⟩
    have hρint : _root_.IsIntegral R ρ := hρV.tower_top
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp hρint
    refine ⟨r, hj ?_⟩
    rw [map_mul, hr, ← IsScalarTower.algebraMap_apply, hsρ]

  have s4 : ∀ (v : V'') (s : V), s ≠ 0 → ∀ x ∈ E₀, σ x = s • v →
      ∃ r : R, algebraMap V R s * r = ι x := by
    intro v s hs x hx hxv
    obtain ⟨p, hpm, hp⟩ := _root_.IsIntegral.of_finite V v
    have hp' : Polynomial.aeval v p = 0 := by rw [Polynomial.aeval_def]; exact hp
    have hq : Polynomial.aeval (σ x) (p.scaleRoots s) = 0 := by
      rw [hxv, Algebra.smul_def]
      exact Polynomial.scaleRoots_aeval_eq_zero hp'
    have hqE : Polynomial.aeval x (p.scaleRoots s) ∈ E₀ :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr hx)
        (Polynomial.aeval_mem_adjoin_singleton V x)
    have h0 : Polynomial.aeval x (p.scaleRoots s) = 0 :=
      s1 _ hqE (by rw [← Polynomial.aeval_algHom_apply]; exact hq)
    exact s2 p hpm s hs (ι x) (by rw [Polynomial.aeval_algHom_apply, h0, map_zero])

  have s5 : ∀ (v : V'') (s t : V) (x y : E) (r r' : R), s ≠ 0 → t ≠ 0 → x ∈ E₀ → y ∈ E₀ →
      σ x = s • v → σ y = t • v → algebraMap V R s * r = ι x →
      algebraMap V R t * r' = ι y → r = r' := by
    intro v s t x y r r' hs ht hx hy hxv hyv hr hr'
    have hxy : t • x = s • y := by
      have := s1 (t • x - s • y) (E₀.sub_mem (E₀.smul_mem hx t) (E₀.smul_mem hy s)) (by
        rw [map_sub, map_smul, map_smul, hxv, hyv, smul_smul, smul_smul, mul_comm, sub_self])
      exact sub_eq_zero.mp this
    apply mul_left_cancel₀ (hP2 (s * t) (mul_ne_zero hs ht))
    calc algebraMap V R (s * t) * r = algebraMap V R t * (algebraMap V R s * r) := by
          rw [map_mul]; ring
      _ = ι (t • x) := by rw [hr, map_smul, Algebra.smul_def]
      _ = ι (s • y) := by rw [hxy]
      _ = algebraMap V R s * (algebraMap V R t * r') := by rw [hr', map_smul, Algebra.smul_def]
      _ = algebraMap V R (s * t) * r' := by rw [map_mul]; ring

  let W : Subalgebra V V'' :=
    { carrier := {v | ∃ s : V, s ≠ 0 ∧ ∃ x ∈ E₀, σ x = s • v}
      mul_mem' := by
        rintro a b ⟨s, hs, x, hx, hxa⟩ ⟨t, ht, y, hy, hyb⟩
        exact ⟨s * t, mul_ne_zero hs ht, x * y, E₀.mul_mem hx hy, by
          rw [map_mul, hxa, hyb, smul_mul_smul_comm]⟩
      add_mem' := by
        rintro a b ⟨s, hs, x, hx, hxa⟩ ⟨t, ht, y, hy, hyb⟩
        refine ⟨s * t, mul_ne_zero hs ht, t • x + s • y,
          E₀.add_mem (E₀.smul_mem hx t) (E₀.smul_mem hy s), ?_⟩
        rw [map_add, map_smul, map_smul, hxa, hyb, smul_smul, smul_smul, smul_add, mul_comm t s]
      algebraMap_mem' := by
        intro a
        exact ⟨1, one_ne_zero, algebraMap V E a, E₀.algebraMap_mem a, by
          rw [one_smul, AlgHom.commutes]⟩ }
  have hmem : ∀ v : V'', v ∈ W ↔ ∃ s : V, s ≠ 0 ∧ ∃ x ∈ E₀, σ x = s • v := fun v => Iff.rfl
  have hsat : ∀ v : V'', ∀ s : V, s ≠ 0 → s • v ∈ W → v ∈ W := by
    intro v s hs hv
    obtain ⟨t, ht, x, hx, hxv⟩ := (hmem _).mp hv
    exact (hmem v).mpr ⟨t * s, mul_ne_zero ht hs, x, hx, by rw [hxv, smul_smul]⟩

  have ex : ∀ w : W, ∃ r : R, ∃ s : V, s ≠ 0 ∧ ∃ x ∈ E₀, σ x = s • (w : V'') ∧
      algebraMap V R s * r = ι x := by
    intro w
    obtain ⟨s, hs, x, hx, hxw⟩ := (hmem w).mp w.2
    obtain ⟨r, hr⟩ := s4 w s hs x hx hxw
    exact ⟨r, s, hs, x, hx, hxw, hr⟩
  choose χ₀ hspec using ex
  have hχ₀ : ∀ (w : W) (s : V) (x : E) (r : R), s ≠ 0 → x ∈ E₀ → σ x = s • (w : V'') →
      algebraMap V R s * r = ι x → χ₀ w = r := by
    intro w s x r hs hx hxw hr
    obtain ⟨t, ht, y, hy, hyw, hr'⟩ := hspec w
    exact s5 w t s y x (χ₀ w) r ht hs hy hx hyw hxw hr' hr
  let χ : W →ₐ[V] R :=
    { toFun := χ₀
      map_one' := hχ₀ 1 1 1 1 one_ne_zero E₀.one_mem (by simp) (by simp)
      map_mul' := fun a b => by
        obtain ⟨s, hs, x, hx, hxa, hra⟩ := hspec a
        obtain ⟨t, ht, y, hy, hyb, hrb⟩ := hspec b
        apply hχ₀ (a * b) (s * t) (x * y) _ (mul_ne_zero hs ht) (E₀.mul_mem hx hy)
        · rw [map_mul, hxa, hyb, smul_mul_smul_comm]; rfl
        · rw [map_mul, map_mul, ← hra, ← hrb]; ring
      map_zero' := hχ₀ 0 1 0 0 one_ne_zero E₀.zero_mem (by simp) (by simp)
      map_add' := fun a b => by
        obtain ⟨s, hs, x, hx, hxa, hra⟩ := hspec a
        obtain ⟨t, ht, y, hy, hyb, hrb⟩ := hspec b
        apply hχ₀ (a + b) (s * t) (t • x + s • y) _ (mul_ne_zero hs ht)
          (E₀.add_mem (E₀.smul_mem hx t) (E₀.smul_mem hy s))
        · rw [map_add, map_smul, map_smul, hxa, hyb, smul_smul, smul_smul, mul_comm t s,
            ← smul_add]; rfl
        · rw [map_add, map_smul, map_smul, Algebra.smul_def, Algebra.smul_def, ← hra, ← hrb,
            map_mul]
          ring
      commutes' := fun a => hχ₀ _ 1 (algebraMap V E a) (algebraMap V R a) one_ne_zero
        (E₀.algebraMap_mem a) (by simp) (by simp) }
  refine ⟨W, χ, (hmem _).mpr ⟨1, one_ne_zero, e, heE₀, by rw [one_smul]⟩, ?_, hsat⟩
  exact hχ₀ _ 1 e (ι e) one_ne_zero heE₀ (by rw [one_smul]) (by rw [map_one, one_mul])

theorem wcpa_gf_residue_congr : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    (R : Type u) [CommRing R] [IsLocalRing R] [Algebra V R],
    (∀ x : IsLocalRing.ResidueField R, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) →
    ∀ (V'' : Type u) [CommRing V''] [Algebra V V''] [Module.Finite V V''],
    IsField (V'' ⧸ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)) →
    ∀ (W : Subalgebra V V'') (χ : W →ₐ[V] R), (∀ v : V'', ∀ s : V, s ≠ 0 → s • v ∈ W → v ∈ W) →
    ∀ w ∈ W, ∃ a : V, w - algebraMap V V'' a ∈
      Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) :=
by
  intro V _ _ _ R _ _ _ hres V'' _ _ _ hfield W χ _hpure w hw
  haveI hint : Algebra.IsIntegral V V'' := Algebra.IsIntegral.of_finite V V''
  have hNmax : (Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)).IsMaximal :=
    Ideal.Quotient.maximal_of_isField _ hfield

  have s1 : ∀ x : V'', x ∉ Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) →
      IsUnit x := by
    intro x hx
    by_contra hxu
    obtain ⟨M, hM, hxM⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hxu)
    have hMu : (M.under V).IsMaximal := Ideal.IsMaximal.under V M
    have hMeq : Ideal.comap (algebraMap V V'') M = IsLocalRing.maximalIdeal V :=
      IsLocalRing.eq_maximalIdeal hMu
    have hle : Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V) ≤ M :=
      Ideal.map_le_iff_le_comap.mpr (le_of_eq hMeq.symm)
    have hEq := hNmax.eq_of_le hM.ne_top hle
    exact hx (hEq ▸ hxM)

  have s2 : ∀ u v : V'', u ∈ W → u * v = 1 → IsIntegral V v → v ∈ W := by
    intro u v hu huv hv
    obtain ⟨p, hpm, hp⟩ := hv
    have hp' : Polynomial.aeval v p = 0 := by rw [Polynomial.aeval_def]; exact hp
    rw [Polynomial.aeval_eq_sum_range] at hp'
    rcases Nat.eq_zero_or_pos p.natDegree with h0 | hpos
    · have h1 : p = 1 := Polynomial.eq_one_of_monic_natDegree_zero hpm h0
      rw [h1, Polynomial.eval₂_one] at hp
      have hv0 : v = 0 := by rw [← mul_one v, hp, mul_zero]
      rw [hv0]; exact W.zero_mem
    · obtain ⟨k, hk⟩ : ∃ k, p.natDegree = k + 1 := ⟨p.natDegree - 1, by omega⟩
      have hlead : p.coeff (k + 1) = 1 := by rw [← hk]; exact hpm.coeff_natDegree
      rw [hk, Finset.sum_range_succ, hlead, one_smul] at hp'
      have hterm : ∀ i ∈ Finset.range (k + 1), (p.coeff i • v ^ i) * u ^ k ∈ W := by
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have he : (p.coeff i • v ^ i) * u ^ k = p.coeff i • u ^ (k - i) := by
          rw [smul_mul_assoc]
          congr 1
          obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hik
          rw [Nat.add_sub_cancel_left, pow_add, ← mul_assoc, ← mul_pow, mul_comm v u, huv,
            one_pow, one_mul]
        rw [he]; exact W.smul_mem (W.pow_mem hu _) _
      have hvk : v ^ (k + 1) * u ^ k = v := by
        rw [pow_succ', mul_assoc, ← mul_pow, mul_comm v u, huv, one_pow, mul_one]
      have h := congrArg (· * u ^ k) hp'
      simp only [add_mul, zero_mul, Finset.sum_mul, hvk] at h
      have hv' : v = - ∑ i ∈ Finset.range (k + 1), (p.coeff i • v ^ i) * u ^ k := by
        linear_combination h
      rw [hv']
      exact W.neg_mem (W.sum_mem hterm)

  have hwi : IsIntegral V w := Algebra.IsIntegral.isIntegral w
  have hw'i : IsIntegral V (⟨w, hw⟩ : W) :=
    (isIntegral_algHom_iff W.val Subtype.val_injective).mp hwi
  have hχi : IsIntegral V (χ ⟨w, hw⟩) := hw'i.map χ
  have hκi : IsIntegral V (algebraMap R (IsLocalRing.ResidueField R) (χ ⟨w, hw⟩)) :=
    hχi.map (IsScalarTower.toAlgHom V R (IsLocalRing.ResidueField R))
  obtain ⟨a, ha⟩ := hres _ hκi
  refine ⟨a, ?_⟩
  have huWm : χ (⟨w, hw⟩ - algebraMap V W a) ∈ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.residue_eq_zero_iff, ← IsLocalRing.ResidueField.algebraMap_eq, map_sub,
      AlgHom.commutes, map_sub,
      ← IsScalarTower.algebraMap_apply V R (IsLocalRing.ResidueField R) a, ha, sub_self]

  by_contra hu
  obtain ⟨v, hv⟩ := (s1 _ hu).exists_right_inv
  have hvW : v ∈ W :=
    s2 _ v (W.sub_mem hw (W.algebraMap_mem a)) hv (Algebra.IsIntegral.isIntegral v)
  have h1 : (⟨w, hw⟩ - algebraMap V W a) * (⟨v, hvW⟩ : W) = 1 := Subtype.ext hv
  have hunit : IsUnit (χ (⟨w, hw⟩ - algebraMap V W a)) :=
    IsUnit.of_mul_eq_one (χ ⟨v, hvW⟩) (by rw [← map_mul, h1, map_one])
  exact (IsLocalRing.mem_maximalIdeal _).mp huWm hunit

theorem wcpa_gf_pure_subalgebra_bot : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    (V'' : Type u) [CommRing V''] [Algebra V V''] [Module.Free V V''] [Module.Finite V V'']
    (W : Subalgebra V V''), (∀ v : V'', ∀ s : V, s ≠ 0 → s • v ∈ W → v ∈ W) →
    (∀ w ∈ W, ∃ a : V, w - algebraMap V V'' a ∈
      Ideal.map (algebraMap V V'') (IsLocalRing.maximalIdeal V)) →
    ∀ w ∈ W, ∃ a : V, algebraMap V V'' a = w :=
by
  intro V _ _ _ V'' _ _ _ _ W hP hC
  classical
  set P : Submodule V V'' := Subalgebra.toSubmodule W with hPdef
  have hPmem : ∀ v, v ∈ P ↔ v ∈ W := fun v => Subalgebra.mem_toSubmodule W

  have htor : Submodule.torsion V (V'' ⧸ P) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_torsion_iff] at hx
    obtain ⟨a, ha⟩ := hx
    obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective P x
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at ha
    have ha0 : (a : V) ≠ 0 := nonZeroDivisors.coe_ne_zero a
    have hv : v ∈ P := (hPmem v).2 (hP v a ha0 ((hPmem _).1 ha))
    rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
    exact hv
  haveI : Module.Flat V (V'' ⧸ P) := (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout).2 htor
  haveI : Module.Free V (V'' ⧸ P) := Module.free_of_flat_of_isLocalRing
  haveI : Module.Projective V (V'' ⧸ P) := Module.Projective.of_free
  obtain ⟨g, hg⟩ := LinearMap.exists_rightInverse_of_surjective P.mkQ (Submodule.range_mkQ P)
  set π : V'' →ₗ[V] V'' := LinearMap.id - g ∘ₗ P.mkQ with hπdef
  have hπ1 : ∀ v, π v ∈ P := by
    intro v
    have h1 : P.mkQ (g (P.mkQ v)) = P.mkQ v := by
      rw [← LinearMap.comp_apply, hg, LinearMap.id_apply]
    have h2 : P.mkQ (π v) = 0 := by
      rw [hπdef, LinearMap.sub_apply, map_sub, LinearMap.id_apply, LinearMap.comp_apply, h1,
        sub_self]
    exact (Submodule.Quotient.mk_eq_zero P).1 h2
  have hπ2 : ∀ v ∈ P, π v = v := by
    intro v hv
    have : P.mkQ v = 0 := (Submodule.Quotient.mk_eq_zero P).2 hv
    simp only [hπdef, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, this,
      map_zero, sub_zero]
  have hrange : Submodule.map π ⊤ = P := by
    apply le_antisymm
    · rintro _ ⟨v, -, rfl⟩
      exact hπ1 v
    · intro w hw
      exact ⟨w, Submodule.mem_top, hπ2 w hw⟩
  have hFG : P.FG := by
    rw [← hrange]
    exact (Module.Finite.fg_top).map π
  set m := IsLocalRing.maximalIdeal V with hm
  have hsub : P ≤ Submodule.span V {(1 : V'')} ⊔ m • P := by
    intro w hw
    obtain ⟨a, ha⟩ := hC w ((hPmem w).1 hw)
    set u := w - algebraMap V V'' a with hu
    have huW : u ∈ P := (hPmem u).2 (W.sub_mem ((hPmem w).1 hw) (W.algebraMap_mem a))
    have hum : u ∈ m • (⊤ : Submodule V V'') := by
      rw [Ideal.smul_top_eq_map]
      exact ha
    have hu' : u ∈ m • P := by
      have h1 : π u ∈ Submodule.map π (m • ⊤) := Submodule.mem_map_of_mem hum
      rw [Submodule.map_smul'', hrange, hπ2 u huW] at h1
      exact h1
    have hw' : w = a • (1 : V'') + u := by
      rw [hu, Algebra.algebraMap_eq_smul_one]; abel
    rw [hw']
    exact Submodule.add_mem_sup
      (Submodule.smul_mem _ a (Submodule.mem_span_singleton_self 1)) hu'
  have hle : P ≤ Submodule.span V {(1 : V'')} :=
    Submodule.le_of_le_smul_of_le_jacobson_bot hFG (IsLocalRing.maximalIdeal_le_jacobson ⊥) hsub
  intro w hw
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 (hle ((hPmem w).2 hw))
  exact ⟨a, by rw [Algebra.algebraMap_eq_smul_one]; exact ha⟩

theorem wcpa_gn_generic_fibre : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V]
    [HenselianLocalRing V], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (D : Type u) [CommRing D] [Algebra V D], Algebra.Smooth V D →
    ∀ (𝔓 : Ideal D) [𝔓.IsPrime], Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V) ≤ 𝔓 →
    (∀ x : 𝔓.ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) →
    ∃ c₂ : D, c₂ ∉ 𝔓 ∧
      IsDomain (TensorProduct V (FractionRing V) (Localization.Away c₂)) ∧
      ∀ θ : FractionRing (TensorProduct V (FractionRing V) (Localization.Away c₂)),
        IsAlgebraic (FractionRing V) θ →
        ∃ a : FractionRing V, algebraMap (FractionRing V) _ a = θ :=
by
  intro V _ _ _ _ _hdim D _ _ hsm 𝔓 _ hm hiv
  classical
  haveI : Algebra.Smooth V D := hsm
  haveI hflat : Module.Flat V D := Algebra.Smooth.flat V D
  haveI : Module.IsTorsionFree V D := Module.Flat.isTorsionFree
  have hTF : ∀ (a : V) (x : D), a ≠ 0 → a • x = 0 → x = 0 := by
    intro a x ha hx
    have hreg : IsSMulRegular D a := Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero ha)
    apply hreg
    show a • x = a • 0
    rw [hx, smul_zero]
  have hnoeth : IsNoetherianRing (TensorProduct V (FractionRing V) D) := by
    haveI := Algebra.Smooth.baseChange V D (FractionRing V)
    exact Algebra.FiniteType.isNoetherianRing (FractionRing V) _

  obtain ⟨hRdom, hRic⟩ := wcpa_gf_smooth_valuation_normal V D hsm 𝔓
  haveI := hRdom
  haveI := hRic

  obtain ⟨c₂, hc₂, hDc, hA⟩ := wcpa_gf_domain_nbhd V D hflat hnoeth 𝔓 hRdom
  haveI := hDc
  haveI := hA
  refine ⟨c₂, hc₂, hA, ?_⟩
  intro θ hθ

  have hker : ∀ d : D, algebraMap D (Localization.AtPrime 𝔓) d = 0 → ∃ k : ℕ, c₂ ^ k * d = 0 := by
    intro d hd
    obtain ⟨⟨m, hmP⟩, hmd⟩ := (IsLocalization.map_eq_zero_iff 𝔓.primeCompl _ d).mp hd
    have h1 : algebraMap D (Localization.Away c₂) m * algebraMap D (Localization.Away c₂) d = 0 := by
      rw [← map_mul]
      have hmd' : m * d = 0 := hmd
      rw [hmd', map_zero]
    rcases mul_eq_zero.mp h1 with h | h
    · exfalso
      obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers c₂) _ m).mp h
      have hk' : c₂ ^ k * m = 0 := hk
      have hmem : c₂ ^ k * m ∈ 𝔓 := by rw [hk']; exact 𝔓.zero_mem
      rcases Ideal.IsPrime.mem_or_mem inferInstance hmem with h' | h'
      · exact hc₂ (Ideal.IsPrime.mem_of_pow_mem inferInstance k h')
      · exact hmP h'
    · obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers c₂) _ d).mp h
      exact ⟨k, hk⟩

  have hunit : ∀ c : D, c ∉ 𝔓 → ∀ y : Submonoid.powers c,
      IsUnit ((IsScalarTower.toAlgHom V D (Localization.AtPrime 𝔓)) (y : D)) := by
    intro c hc y
    obtain ⟨_, k, rfl⟩ := y
    rw [IsScalarTower.coe_toAlgHom', map_pow]
    exact ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔓) 𝔓 c).mpr hc).pow k

  have hlift_inj : ∀ (c : D) (hc : c ∉ 𝔓),
      (∀ d : D, algebraMap D (Localization.AtPrime 𝔓) d = 0 → ∃ k : ℕ, c ^ k * d = 0) →
      Function.Injective (IsLocalization.liftAlgHom (M := Submonoid.powers c)
        (S := Localization.Away c) (hunit c hc)) := by
    intro c hc hk
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨d, y⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers c) z
    rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_mk'_spec, mul_zero] at hz
    obtain ⟨k, hk'⟩ := hk d hz
    rw [IsLocalization.mk'_eq_zero_iff]
    exact ⟨⟨c ^ k, k, rfl⟩, hk'⟩

  have hVR : Function.Injective (algebraMap V (Localization.AtPrime 𝔓)) := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    rw [IsScalarTower.algebraMap_apply V D (Localization.AtPrime 𝔓)] at ha
    obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff 𝔓.primeCompl _ _).mp ha
    by_contra ha0
    have hs0 : s = 0 := hTF a s ha0 (by rw [Algebra.smul_def, mul_comm]; exact hsa)
    exact hs (by rw [hs0]; exact 𝔓.zero_mem)

  set ι₂ := IsLocalization.liftAlgHom (M := Submonoid.powers c₂)
    (S := Localization.Away c₂) (hunit c₂ hc₂) with hι₂
  have hι₂ : Function.Injective ι₂ := hlift_inj c₂ hc₂ hker
  have hVKR : Function.Injective (Algebra.ofId V (FractionRing (Localization.AtPrime 𝔓))) := by
    intro a b hab
    apply hVR
    apply IsFractionRing.injective (Localization.AtPrime 𝔓) (FractionRing (Localization.AtPrime 𝔓))
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    exact hab
  set gK : FractionRing V →ₐ[V] FractionRing (Localization.AtPrime 𝔓) :=
    IsFractionRing.liftAlgHom (K := FractionRing V) hVKR with hgK
  set gD : Localization.Away c₂ →ₐ[V] FractionRing (Localization.AtPrime 𝔓) :=
    (IsScalarTower.toAlgHom V (Localization.AtPrime 𝔓) (FractionRing (Localization.AtPrime 𝔓))).comp
      ι₂ with hgD
  have hgD : Function.Injective gD := by
    intro a b hab
    apply hι₂
    exact IsFractionRing.injective (Localization.AtPrime 𝔓) (FractionRing (Localization.AtPrime 𝔓))
      hab
  set ψ : TensorProduct V (FractionRing V) (Localization.Away c₂) →ₐ[V]
      FractionRing (Localization.AtPrime 𝔓) :=
    Algebra.TensorProduct.lift gK gD (fun x y => Commute.all _ _) with hψ
  have hψinj : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective (nonZeroDivisors V)
      (TensorProduct.mk V (FractionRing V) (Localization.Away c₂) 1) x
    have h1 := IsLocalizedModule.mk'_cancel' (TensorProduct.mk V (FractionRing V)
      (Localization.Away c₂) 1) m s
    have h2 : ψ ((TensorProduct.mk V (FractionRing V) (Localization.Away c₂) 1) m) = 0 := by
      rw [← h1, Submonoid.smul_def, map_smul]
      simp only [Function.uncurry_apply_pair] at hx
      rw [hx, smul_zero]
    have h3 : gD m = 0 := by
      rw [TensorProduct.mk_apply, hψ, Algebra.TensorProduct.lift_tmul, map_one, one_mul] at h2
      exact h2
    have hm0 : m = 0 := hgD (h3.trans (map_zero gD).symm)
    simp only [Function.uncurry_apply_pair]
    rw [hm0, IsLocalizedModule.mk'_zero]
  set Φ : FractionRing (TensorProduct V (FractionRing V) (Localization.Away c₂)) →ₐ[V]
      FractionRing (Localization.AtPrime 𝔓) := IsFractionRing.liftAlgHom hψinj with hΦ
  have hΦinj : Function.Injective Φ := Φ.toRingHom.injective

  have hθV : IsAlgebraic V θ :=
    (IsFractionRing.isAlgebraic_iff V (FractionRing V) _).mpr hθ
  obtain ⟨y, hy0, hyint⟩ := (hθV.algHom Φ).exists_integral_multiple
  obtain ⟨η, hη⟩ := IsIntegrallyClosed.isIntegral_iff.mp
    (hyint.tower_top (A := Localization.AtPrime 𝔓))
  have hηint : IsIntegral V η := by
    refine (isIntegral_algHom_iff (IsScalarTower.toAlgHom V (Localization.AtPrime 𝔓)
      (FractionRing (Localization.AtPrime 𝔓)))
      (IsFractionRing.injective (Localization.AtPrime 𝔓) _)).mp ?_
    rw [IsScalarTower.coe_toAlgHom', hη]
    exact hyint

  obtain ⟨⟨d, t⟩, hdt⟩ := IsLocalization.mk'_surjective 𝔓.primeCompl η
  have ht : (t : D) ∉ 𝔓 := t.2
  have hc₂t : c₂ * t ∉ 𝔓 := fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hc₂ ht
  have hkt : ∀ d : D, algebraMap D (Localization.AtPrime 𝔓) d = 0 →
      ∃ k : ℕ, (c₂ * t) ^ k * d = 0 := by
    intro d' hd'
    obtain ⟨k, hk⟩ := hker d' hd'
    exact ⟨k, by rw [mul_pow, mul_comm (c₂ ^ k), mul_assoc, hk, mul_zero]⟩
  set ι := IsLocalization.liftAlgHom (M := Submonoid.powers (c₂ * t))
    (S := Localization.Away (c₂ * (t : D))) (hunit (c₂ * t) hc₂t) with hι
  have hιinj : Function.Injective ι := hlift_inj (c₂ * t) hc₂t hkt
  set e : Localization.Away (c₂ * (t : D)) :=
    IsLocalization.mk' (Localization.Away (c₂ * (t : D))) (d * c₂)
      (⟨c₂ * t, 1, pow_one _⟩ : Submonoid.powers (c₂ * (t : D))) with he
  have hιe : ι e = η := by
    rw [hι, he, IsLocalization.liftAlgHom_apply, IsLocalization.lift_mk'_spec, ← hdt]
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, IsScalarTower.coe_toAlgHom']
    rw [map_mul, map_mul, mul_assoc, IsLocalization.mk'_spec', mul_comm]
  haveI hsmE : Algebra.Smooth V (Localization.Away (c₂ * (t : D))) := by
    haveI : Algebra.Smooth D (Localization.Away (c₂ * (t : D))) :=
      Algebra.Smooth.of_isLocalization_Away (c₂ * (t : D))
    exact Algebra.Smooth.comp V D (Localization.Away (c₂ * (t : D)))
  have hmE : Ideal.map (algebraMap V (Localization.Away (c₂ * (t : D))))
      (IsLocalRing.maximalIdeal V) ≠ ⊤ := by
    intro htop
    have h1 : Ideal.map (ι : Localization.Away (c₂ * (t : D)) →+* Localization.AtPrime 𝔓)
        (Ideal.map (algebraMap V (Localization.Away (c₂ * (t : D)))) (IsLocalRing.maximalIdeal V))
        = ⊤ := by rw [htop, Ideal.map_top]
    rw [Ideal.map_map, AlgHom.comp_algebraMap, IsScalarTower.algebraMap_eq V D
      (Localization.AtPrime 𝔓), ← Ideal.map_map] at h1
    have h3 : Ideal.map (algebraMap D (Localization.AtPrime 𝔓))
        (Ideal.map (algebraMap V D) (IsLocalRing.maximalIdeal V)) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.map_mono hm
    rw [h1] at h3
    exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime 𝔓)).ne_top (top_le_iff.mp h3)

  obtain ⟨V'', _, _, _, hfree, hfin, hfield, ⟨σ⟩⟩ :=
    wcpa_gf_henselian_section V (Localization.Away (c₂ * (t : D))) hsmE hmE
  haveI := hfree
  haveI := hfin

  obtain ⟨W, χ, hW, hχ, hpure⟩ := wcpa_gf_saturation V (Localization.AtPrime 𝔓) hVR
    (Localization.Away (c₂ * (t : D))) ι hιinj V'' σ e (by rw [hιe]; exact hηint)

  have hcong := wcpa_gf_residue_congr V (Localization.AtPrime 𝔓) hiv V'' hfield W χ hpure

  obtain ⟨a, ha⟩ := wcpa_gf_pure_subalgebra_bot V V'' W hpure hcong (σ e) hW
  have hηa : η = algebraMap V (Localization.AtPrime 𝔓) a := by
    rw [← hιe, ← hχ]
    have : (⟨σ e, hW⟩ : W) = algebraMap V W a := Subtype.ext ha.symm
    rw [this, χ.commutes]

  have hyθ : algebraMap V _ y * θ = algebraMap V _ a := by
    apply hΦinj
    rw [map_mul, AlgHom.commutes, AlgHom.commutes, ← Algebra.smul_def, ← hη, hηa,
      ← IsScalarTower.algebraMap_apply]
  have hyK : algebraMap V (FractionRing V) y ≠ 0 := by
    intro h
    exact hy0 (IsFractionRing.injective V (FractionRing V) (h.trans (map_zero _).symm))
  refine ⟨algebraMap V (FractionRing V) a / algebraMap V (FractionRing V) y, ?_⟩
  have hyF : algebraMap (FractionRing V) (FractionRing (TensorProduct V (FractionRing V)
      (Localization.Away c₂))) (algebraMap V (FractionRing V) y) ≠ 0 :=
    (map_ne_zero _).mpr hyK
  rw [map_div₀, div_eq_iff hyF, ← IsScalarTower.algebraMap_apply,
    ← IsScalarTower.algebraMap_apply, ← hyθ, mul_comm]

theorem wcpa_gn_away_mul_domain : ∀ (V : Type u) [CommRing V] (D : Type u) [CommRing D] [Algebra V D]
    (F : Type u) [Field F] [Algebra V F] (Ω : Type u) [Field Ω] [Algebra F Ω] (c c' : D),
    (IsDomain (TensorProduct F Ω (TensorProduct V F (Localization.Away c))) ∨
      Subsingleton (TensorProduct F Ω (TensorProduct V F (Localization.Away c)))) →
    (IsDomain (TensorProduct F Ω (TensorProduct V F (Localization.Away (c * c')))) ∨
      Subsingleton (TensorProduct F Ω (TensorProduct V F (Localization.Away (c * c'))))) :=
by
  intro V _ D _ _ F _ _ Ω _ _ c c' h
  letI : Algebra V Ω := ((algebraMap F Ω).comp (algebraMap V F)).toAlgebra
  haveI : IsScalarTower V F Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have key : ∀ d : D, Nonempty (TensorProduct F Ω (TensorProduct V F (Localization.Away d)) ≃+*
      Localization.Away (algebraMap D (TensorProduct V D Ω) d)) := by
    intro d
    exact ⟨(Algebra.TensorProduct.cancelBaseChange V F Ω Ω (Localization.Away d)).toRingEquiv.trans
      ((Algebra.TensorProduct.comm V Ω (Localization.Away d)).toRingEquiv.trans
      ((Algebra.TensorProduct.cancelBaseChange V D D (Localization.Away d) Ω).symm.toRingEquiv.trans
      ((Algebra.TensorProduct.comm D (Localization.Away d) (TensorProduct V D Ω)).toRingEquiv.trans
      (IsLocalization.Away.tensorEquiv (TensorProduct V D Ω) d (Localization.Away d)).toRingEquiv)))⟩
  have loc : ∀ (T : Type u) [CommRing T] (x y : T),
      (IsDomain (Localization.Away x) ∨ Subsingleton (Localization.Away x)) →
      (IsDomain (Localization.Away (x * y)) ∨ Subsingleton (Localization.Away (x * y))) := by
    intro T _ x y hx
    let y' : Localization.Away x := algebraMap T (Localization.Away x) y
    haveI : IsLocalization.Away (x * y) (Localization.Away y') :=
      IsLocalization.Away.mul' (Localization.Away x) (Localization.Away y') x y
    let ψ : Localization.Away (x * y) ≃ₐ[T] Localization.Away y' :=
      IsLocalization.algEquiv (Submonoid.powers (x * y)) (Localization.Away (x * y))
        (Localization.Away y')
    rcases hx with hd | hs
    · by_cases hy : y' = 0
      · right
        haveI : Unique (Localization.Away y') :=
          IsLocalization.uniqueOfZeroMem (M := Submonoid.powers y') (S := Localization.Away y')
            ⟨1, by show y' ^ 1 = 0; rw [pow_one, hy]⟩
        exact ψ.toEquiv.subsingleton
      · left
        haveI : IsDomain (Localization.Away y') :=
          IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hy)
        exact MulEquiv.isDomain (Localization.Away y') ψ.toMulEquiv
    · right
      haveI : Subsingleton (Localization.Away y') := by
        apply subsingleton_of_zero_eq_one
        rw [← map_zero (algebraMap (Localization.Away x) (Localization.Away y')),
          ← map_one (algebraMap (Localization.Away x) (Localization.Away y')),
          Subsingleton.elim (0 : Localization.Away x) 1]
      exact ψ.toEquiv.subsingleton
  obtain ⟨φ⟩ := key c
  have h2 : Nonempty (TensorProduct F Ω (TensorProduct V F (Localization.Away (c * c'))) ≃+*
      Localization.Away (algebraMap D (TensorProduct V D Ω) c *
        algebraMap D (TensorProduct V D Ω) c')) := by
    have := key (c * c')
    rwa [map_mul] at this
  obtain ⟨φ'⟩ := h2
  have hx : IsDomain (Localization.Away (algebraMap D (TensorProduct V D Ω) c)) ∨
      Subsingleton (Localization.Away (algebraMap D (TensorProduct V D Ω) c)) := by
    rcases h with hd | hs
    · left
      exact MulEquiv.isDomain (TensorProduct F Ω (TensorProduct V F (Localization.Away c)))
        φ.symm.toMulEquiv
    · right
      exact φ.symm.toEquiv.subsingleton
  rcases loc _ _ (algebraMap D (TensorProduct V D Ω) c') hx with hd | hs
  · left
    exact MulEquiv.isDomain (Localization.Away (algebraMap D (TensorProduct V D Ω) c *
        algebraMap D (TensorProduct V D Ω) c')) φ'.toMulEquiv
  · right
    exact φ'.toEquiv.subsingleton

theorem wcpa_gn_smooth_geom_reduced : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A]
    [Algebra F A], Algebra.Smooth F A → IsReduced (TensorProduct F (AlgebraicClosure F) A) :=
by
  intro F _ A _ _ hA
  have s2 : ∀ (P : Type u) [CommRing P] [IsDomain P] (S : Type u) [CommRing S] [Algebra P S],
      Algebra.Etale P S → _root_.IsReduced S := by
    intro P _ _ S _ _ hE
    haveI := hE
    have hinj : Function.Injective
        (Algebra.TensorProduct.includeRight : S →ₐ[P] TensorProduct P (FractionRing P) S) :=
      Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective P (FractionRing P))
    haveI : Algebra.Etale (FractionRing P) (TensorProduct P (FractionRing P) S) :=
      Algebra.Etale.baseChange P S (FractionRing P)
    haveI : _root_.IsReduced (TensorProduct P (FractionRing P) S) :=
      Algebra.FormallyUnramified.isReduced_of_field (FractionRing P) _
    exact isReduced_of_injective _ hinj
  have s3 : ∀ (R : Type u) [CommRing R] (s : Set R), Ideal.span s = ⊤ →
      (∀ x ∈ s, _root_.IsReduced (Localization.Away x)) → _root_.IsReduced R := by
    intro R _ s hs H
    refine ⟨fun b hb => ?_⟩
    have hmem : b ∈ (⊥ : Submodule R R) := by
      refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ s hs b (fun r => ?_)
      haveI := H r.1 r.2
      have h0 : algebraMap R (Localization.Away (r : R)) b = 0 := (hb.map _).eq_zero
      obtain ⟨⟨y, hy⟩, hyb⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers (r : R))
        (Localization.Away (r : R)) b).mp h0
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
      exact ⟨n, by simpa [smul_eq_mul] using hyb⟩
    simpa using hmem
  haveI := hA
  haveI : Algebra.Smooth (AlgebraicClosure F) (TensorProduct F (AlgebraicClosure F) A) :=
    Algebra.Smooth.baseChange F A (AlgebraicClosure F)
  obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth
    (AlgebraicClosure F) (TensorProduct F (AlgebraicClosure F) A)
  apply s3 _ s hs
  intro x hx
  haveI := hstd x hx
  have hss : (algebraMap (AlgebraicClosure F) (Localization.Away x)).IsStandardSmooth :=
    RingHom.isStandardSmooth_algebraMap.mpr inferInstance
  obtain ⟨n, g, -, hg⟩ := hss.exists_etale_mvPolynomial
  letI : Algebra (MvPolynomial (Fin n) (AlgebraicClosure F)) (Localization.Away x) := g.toAlgebra
  exact s2 (MvPolynomial (Fin n) (AlgebraicClosure F)) (Localization.Away x) hg

theorem wcpa_pple_dv_geom_nbhd : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V],
    ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (C : Type u) [CommRing C] [Algebra V C], Algebra.Smooth V C →
    ∀ (𝔮 : Ideal C) [𝔮.IsPrime], Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≤ 𝔮 →
    (∀ x : 𝔮.ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) →
    ∀ (C' : Type u) [CommRing C'] [Algebra C C'] [Algebra V C'] [IsScalarTower V C C'], Algebra.Etale C C' →
    ∀ (𝔮' : Ideal C') [𝔮'.IsPrime], 𝔮'.comap (algebraMap C C') = 𝔮 →
    (∀ b : C', ∃ a s : C, s ∉ 𝔮 ∧ algebraMap C C' s * b - algebraMap C C' a ∈ 𝔮') →
    ∃ c₀ : C', c₀ ∉ 𝔮' ∧ ∀ (L : Type u) [Field L] [Algebra V L],
      IsDomain (TensorProduct V L (Localization.Away c₀)) ∨ Subsingleton (TensorProduct V L (Localization.Away c₀)) :=
by
  intro V _ _ _ _ hdim C _ _ hCsm 𝔮 _ hm𝔮 hiv C' _ _ _ _ hEt 𝔮' h𝔮' hcomap helem

  haveI : Algebra.Smooth V C := hCsm
  haveI : Algebra.Etale C C' := hEt
  haveI hsm' : Algebra.Smooth V C' := Algebra.Smooth.comp V C C'
  have hm' : Ideal.map (algebraMap V C') (IsLocalRing.maximalIdeal V) ≤ 𝔮' := by
    rw [IsScalarTower.algebraMap_eq V C C', ← Ideal.map_map]
    calc Ideal.map (algebraMap C C') (Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V))
        ≤ Ideal.map (algebraMap C C') 𝔮 := Ideal.map_mono hm𝔮
      _ ≤ 𝔮' := by rw [← hcomap]; exact Ideal.map_comap_le
  have hiv' : ∀ x : 𝔮'.ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x := by
    let f : C →ₐ[V] C' := IsScalarTower.toAlgHom V C C'
    have hf : 𝔮 = Ideal.comap f.toRingHom 𝔮' := by rw [← hcomap]; rfl
    let ι : 𝔮.ResidueField →ₐ[V] 𝔮'.ResidueField := Ideal.ResidueField.mapₐ 𝔮 𝔮' f hf
    have hι : ∀ c : C, ι (algebraMap C _ c) = algebraMap C' _ (algebraMap C C' c) := by
      intro c
      rw [Ideal.ResidueField.mapₐ_apply, Ideal.ResidueField.map_algebraMap]
      rfl
    have hsurj0 : ∀ b : C', ∃ y : 𝔮.ResidueField, ι y = algebraMap C' _ b := by
      intro b
      obtain ⟨a, s, hs, hsb⟩ := helem b
      refine ⟨algebraMap C _ a / algebraMap C _ s, ?_⟩
      have hs0' : algebraMap C' 𝔮'.ResidueField (algebraMap C C' s) ≠ 0 := by
        rw [Ne, Ideal.algebraMap_residueField_eq_zero, ← Ideal.mem_comap, hcomap]; exact hs
      have h1 : algebraMap C' 𝔮'.ResidueField (algebraMap C C' s * b - algebraMap C C' a) = 0 :=
        Ideal.algebraMap_residueField_eq_zero.mpr hsb
      rw [map_sub, map_mul, sub_eq_zero] at h1
      rw [map_div₀, hι, hι, div_eq_iff hs0', ← h1, mul_comm]
    have hsurj : Function.Surjective ι := by
      intro x
      obtain ⟨y, z, _, rfl⟩ := IsFractionRing.div_surjective (A := C' ⧸ 𝔮') x
      obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨z', rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨u, hu⟩ := hsurj0 y'
      obtain ⟨v, hv⟩ := hsurj0 z'
      refine ⟨u / v, ?_⟩
      rw [map_div₀, hu, hv, IsScalarTower.algebraMap_apply C' (C' ⧸ 𝔮') 𝔮'.ResidueField y',
        IsScalarTower.algebraMap_apply C' (C' ⧸ 𝔮') 𝔮'.ResidueField z']
      rfl
    intro x hx
    obtain ⟨y, rfl⟩ := hsurj x
    have hy : IsIntegral V y :=
      (isIntegral_algHom_iff ι (ι : 𝔮.ResidueField →+* 𝔮'.ResidueField).injective).mp hx
    obtain ⟨a, ha⟩ := hiv y hy
    exact ⟨a, by rw [← ha, AlgHom.commutes]⟩

  obtain ⟨c₁, hc₁, hT, hTalg⟩ := wcpa_gn_special_fibre V hdim C' hsm' 𝔮' hm' hiv'
  obtain ⟨c₂, hc₂, hA, hAalg⟩ := wcpa_gn_generic_fibre V hdim C' hsm' 𝔮' hm' hiv'
  have hsmAway : ∀ c : C', Algebra.Smooth V (Localization.Away c) := by
    intro c
    haveI : Algebra.Smooth C' (Localization.Away c) := Algebra.Smooth.of_isLocalization_Away c
    exact Algebra.Smooth.comp V C' (Localization.Away c)
  haveI := hsmAway c₁
  haveI := hsmAway c₂
  haveI := hT
  haveI := hA

  have hT' := wcpa_gn_regular_extension (IsLocalRing.ResidueField V)
    (TensorProduct V (IsLocalRing.ResidueField V) (Localization.Away c₁)) hTalg
    (wcpa_gn_smooth_geom_reduced _ _ inferInstance)
  have hA' := wcpa_gn_regular_extension (FractionRing V)
    (TensorProduct V (FractionRing V) (Localization.Away c₂)) hAalg
    (wcpa_gn_smooth_geom_reduced _ _ inferInstance)

  have h1 := wcpa_gn_away_mul_domain V C' (IsLocalRing.ResidueField V)
    (AlgebraicClosure (IsLocalRing.ResidueField V)) c₁ c₂ (Or.inl hT')
  have h2 := wcpa_gn_away_mul_domain V C' (FractionRing V)
    (AlgebraicClosure (FractionRing V)) c₂ c₁ (Or.inl hA')
  rw [mul_comm c₂ c₁] at h2
  refine ⟨c₁ * c₂, fun h => (h𝔮'.mem_or_mem h).elim hc₁ hc₂, ?_⟩

  exact wcpa_gn_fibre_reduction V hdim (Localization.Away (c₁ * c₂))
    (wcpa_gn_geom_integral_of_algClosure (FractionRing V) _ h2)
    (wcpa_gn_geom_integral_of_algClosure (IsLocalRing.ResidueField V) _ h1)

theorem wcpa_pple_dv_vanish : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V],
    ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (R : Type u) [CommRing R] [Algebra V R], Algebra.FinitePresentation V R →
    ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M], Module.Finite R M →
    ∀ 𝔭 : Ideal R, 𝔭.IsPrime → Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ 𝔭 →
    ¬ (Module.annihilator R M ⊔ Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ 𝔭) →
    wcpaDvConc V R M 𝔭 :=
by
  intro V _ _ _ _ hW R _ _ hRfp M _ _ _ _ hM 𝔭 h𝔭 hm𝔭 hJ
  classical
  have hann : ¬ (Module.annihilator R M ≤ 𝔭) := fun h => hJ (sup_le h hm𝔭)
  obtain ⟨β, hβA, hβ𝔭⟩ := Set.not_subset.mp hann
  have hβM : ∀ m : M, β • m = 0 := fun m => Module.mem_annihilator.mp hβA m
  unfold wcpaDvConc
  refine ⟨R, inferInstance, Algebra.id R, inferInstance, inferInstance, inferInstance, 𝔭, h𝔭,
    ?_, ?_, ?_⟩
  · exact Ideal.comap_id 𝔭
  · intro b
    refine ⟨b, 1, h𝔭.one_notMem, ?_⟩
    have h0 : algebraMap R R 1 * b - algebraMap R R b = 0 := by
      rw [map_one, one_mul]
      exact sub_self _
    rw [h0]
    exact Submodule.zero_mem _
  · intro f hf
    refine ⟨f * β, h𝔭.mul_notMem hf hβ𝔭, dvd_mul_right f β, ?_⟩
    rintro X _ _ ⟨e⟩
    have hu : IsUnit (algebraMap R (Localization.Away (f * β)) β) := by
      have hg := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (f * β)) (f * β)
      rw [map_mul] at hg
      exact isUnit_of_mul_isUnit_right hg
    have hz : ∀ z : TensorProduct R (Localization.Away (f * β)) M, z = 0 := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rfl
      | tmul x m =>
        have hx : x = β • (↑hu.unit⁻¹ * x) := by
          rw [Algebra.smul_def, ← mul_assoc]
          have : algebraMap R (Localization.Away (f * β)) β * ↑hu.unit⁻¹ = 1 :=
            hu.mul_val_inv
          rw [this, one_mul]
        rw [hx, TensorProduct.smul_tmul, hβM, TensorProduct.tmul_zero]
      | add a b ha hb => rw [ha, hb, add_zero]
    have hX : ∀ x : X, x = 0 := fun x => by
      rw [← e.apply_symm_apply x, hz (e.symm x), map_zero]
    unfold wcpaDvFilt
    refine ⟨0, fun _ => ⊥, rfl, ?_, fun k hk => absurd hk (Nat.not_lt_zero k)⟩
    rw [eq_top_iff]
    intro x _
    rw [hX x]
    exact Submodule.zero_mem _

theorem wcpa_pple_dv_base_change : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V],
    ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (R : Type u) [CommRing R] [Algebra V R], Algebra.FinitePresentation V R →
    ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M], Module.Finite R M →
    ∀ 𝔭 : Ideal R, 𝔭.IsPrime →
    ∀ (R₁ : Type u) [CommRing R₁] [Algebra R R₁] [Algebra V R₁] [IsScalarTower V R R₁]
      (C : Type u) [CommRing C] [Algebra V C] [Algebra C R₁] [IsScalarTower V C R₁],
    Algebra.Etale R R₁ → Algebra.Smooth V C →
    ∀ (𝔭₁ : Ideal R₁) [𝔭₁.IsPrime], 𝔭₁.comap (algebraMap R R₁) = 𝔭 →
      (∀ b : R₁, ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R R₁ s * b - algebraMap R R₁ a ∈ 𝔭₁) →
      Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≤ 𝔭₁.comap (algebraMap C R₁) →
      RingHom.Finite ((Ideal.Quotient.mk (Module.annihilator R₁ (TensorProduct R R₁ M))).comp (algebraMap C R₁)) →
      (∀ P : Ideal R₁, P.IsPrime → Module.annihilator R₁ (TensorProduct R R₁ M) ≤ P →
        P.comap (algebraMap C R₁) = 𝔭₁.comap (algebraMap C R₁) → P = 𝔭₁) →
    ∀ (r : ℕ) (α : (Fin r → C) →ₗ[C] TensorProduct R R₁ M),
      (∀ u : Fin r → C, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (TensorProduct R R₁ M)) →
        u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → C))) →
    ∀ (C' : Type u) [CommRing C'] [Algebra C C'] [Algebra V C'] [IsScalarTower V C C'], Algebra.Etale C C' →
    ∀ (𝔮' : Ideal C') [𝔮'.IsPrime], 𝔮'.comap (algebraMap C C') = 𝔭₁.comap (algebraMap C R₁) →
      (∀ b : C', ∃ a s : C, s ∉ 𝔭₁.comap (algebraMap C R₁) ∧ algebraMap C C' s * b - algebraMap C C' a ∈ 𝔮') →
      (∀ f : C', f ∉ 𝔮' → ∃ g : C', g ∉ 𝔮' ∧ f ∣ g ∧
        ∀ (X : Type u) [AddCommGroup X] [Module V X],
          Nonempty (TensorProduct C (Localization.Away g) (TensorProduct R R₁ M ⧸ LinearMap.range α) ≃ₗ[V] X) →
          wcpaDvFilt V X) →
    ∀ c₀ : C', c₀ ∉ 𝔮' → (∀ (L : Type u) [Field L] [Algebra V L],
      IsDomain (TensorProduct V L (Localization.Away c₀)) ∨ Subsingleton (TensorProduct V L (Localization.Away c₀))) →
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra V R') (_ : IsScalarTower V R R'),
      Algebra.Etale R R' ∧ ∃ 𝔭' : Ideal R', 𝔭'.IsPrime ∧ 𝔭'.comap (algebraMap R R') = 𝔭 ∧
        (∀ b : R', ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R R' s * b - algebraMap R R' a ∈ 𝔭') ∧
        ∀ f : R', f ∉ 𝔭' → ∃ g : R', g ∉ 𝔭' ∧ f ∣ g ∧
          ∃ (C'' : Type u) (_ : CommRing C'') (_ : Algebra V C''), Algebra.Smooth V C'' ∧
            Ideal.map (algebraMap V C'') (IsLocalRing.maximalIdeal V) ≠ ⊤ ∧
            (∀ (L : Type u) [Field L] [Algebra V L],
              IsDomain (TensorProduct V L C'') ∨ Subsingleton (TensorProduct V L C'')) ∧
            ∃ (r'' : ℕ) (α'' : (Fin r'' → C'') →ₗ[V] TensorProduct R (Localization.Away g) M),
              (∀ u : Fin r'' → C'', α'' u ∈ (IsLocalRing.maximalIdeal V) •
                  (⊤ : Submodule V (TensorProduct R (Localization.Away g) M)) →
                u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r'' → C''))) ∧
              ∃ (Q : Type u) (_ : AddCommGroup Q) (_ : Module V Q), wcpaDvFilt V Q ∧
                Nonempty ((TensorProduct R (Localization.Away g) M ⧸ LinearMap.range α'') ≃ₗ[V] Q) :=
by

  have wcpa_pple_dvbc_tensor_congr : ∀ (C R₁ C' : Type u) [CommRing C] [CommRing R₁] [CommRing C'] [Algebra C R₁] [Algebra C C'] (𝔮 : Ideal C) [𝔮.IsPrime] (𝔮' : Ideal C'), (∀ b : C', ∃ a s : C, s ∉ 𝔮 ∧ algebraMap C C' s * b - algebraMap C C' a ∈ 𝔮') → ∀ x : TensorProduct C R₁ C', ∃ s : C, s ∉ 𝔮 ∧ ∃ y : R₁, algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ s) * x - algebraMap R₁ (TensorProduct C R₁ C') y ∈ Ideal.map (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom 𝔮' := by
    intro C R₁ C' _ _ _ _ _ 𝔮 h𝔮 𝔮' helem x
    have hT : ∀ c : C, algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ c) =
        (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') (algebraMap C C' c) := by
      intro c
      rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
    have hsplit : ∀ (r : R₁) (c' : C'), (r ⊗ₜ[C] c' : TensorProduct C R₁ C') =
        algebraMap R₁ (TensorProduct C R₁ C') r *
          (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c' := by
      intro r c'
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.algebraMap_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, Algebra.algebraMap_self_apply]
    have h1 : (1 : C) ∉ 𝔮 := fun h => h𝔮.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨1, h1, 0, by simp⟩
    | tmul r c' =>
      obtain ⟨a, s, hs, he⟩ := helem c'
      refine ⟨s, hs, algebraMap C R₁ a * r, ?_⟩
      have key : algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ s) * (r ⊗ₜ[C] c') -
          algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ a * r) =
          algebraMap R₁ (TensorProduct C R₁ C') r *
            (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom
              (algebraMap C C' s * c' - algebraMap C C' a) := by
        rw [hsplit, map_mul, hT, hT]
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, map_mul]
        ring
      rw [key]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ he)
    | add x₁ x₂ ih₁ ih₂ =>
      obtain ⟨s₁, hs₁, y₁, hy₁⟩ := ih₁
      obtain ⟨s₂, hs₂, y₂, hy₂⟩ := ih₂
      refine ⟨s₁ * s₂, fun h => (h𝔮.mem_or_mem h).elim hs₁ hs₂,
        algebraMap C R₁ s₂ * y₁ + algebraMap C R₁ s₁ * y₂, ?_⟩
      have key : algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ (s₁ * s₂)) * (x₁ + x₂) -
          algebraMap R₁ (TensorProduct C R₁ C')
            (algebraMap C R₁ s₂ * y₁ + algebraMap C R₁ s₁ * y₂) =
          algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ s₂) *
            (algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ s₁) * x₁ -
              algebraMap R₁ (TensorProduct C R₁ C') y₁) +
          algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ s₁) *
            (algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ s₂) * x₂ -
              algebraMap R₁ (TensorProduct C R₁ C') y₂) := by
        simp only [map_mul, map_add]
        ring
      rw [key]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy₁) (Ideal.mul_mem_left _ _ hy₂)

  have wcpa_pple_dvbc_prime_exists : ∀ (C R₁ C' : Type u) [CommRing C] [CommRing R₁] [CommRing C'] [Algebra C R₁] [Algebra C C'] (𝔭₁ : Ideal R₁) [𝔭₁.IsPrime] (𝔮' : Ideal C') [𝔮'.IsPrime], 𝔮'.comap (algebraMap C C') = 𝔭₁.comap (algebraMap C R₁) → (∀ b : C', ∃ a s : C, s ∉ 𝔭₁.comap (algebraMap C R₁) ∧ algebraMap C C' s * b - algebraMap C C' a ∈ 𝔮') → ∃ 𝔭' : Ideal (TensorProduct C R₁ C'), 𝔭'.IsPrime ∧ 𝔭'.comap (algebraMap R₁ (TensorProduct C R₁ C')) = 𝔭₁ ∧ 𝔭'.comap (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom = 𝔮' := by
    intro C R₁ C' _ _ _ _ _ 𝔭₁ h𝔭₁ 𝔮' h𝔮' hcomap helem
    classical
    haveI h𝔮 : (𝔭₁.comap (algebraMap C R₁)).IsPrime := Ideal.comap_isPrime _ _
    let μ : (𝔭₁.comap (algebraMap C R₁)).ResidueField →+* 𝔮'.ResidueField :=
      Ideal.ResidueField.map (𝔭₁.comap (algebraMap C R₁)) 𝔮' (algebraMap C C') hcomap.symm
    have hμ : ∀ c : C, μ (algebraMap C (𝔭₁.comap (algebraMap C R₁)).ResidueField c) =
        algebraMap C' 𝔮'.ResidueField (algebraMap C C' c) := fun c =>
      Ideal.ResidueField.map_algebraMap _ _ _ _ c
    have himg : ∀ b : C', ∃ w, μ w = algebraMap C' 𝔮'.ResidueField b := by
      intro b
      obtain ⟨a, s, hs, he⟩ := helem b
      have hs0 : algebraMap C (𝔭₁.comap (algebraMap C R₁)).ResidueField s ≠ 0 := by
        rw [Ne, Ideal.algebraMap_residueField_eq_zero]
        exact hs
      refine ⟨algebraMap C _ a / algebraMap C _ s, ?_⟩
      have he' : algebraMap C' 𝔮'.ResidueField (algebraMap C C' s * b - algebraMap C C' a) = 0 :=
        (Ideal.algebraMap_residueField_eq_zero).mpr he
      rw [map_sub, map_mul, sub_eq_zero] at he'
      have hs0' : μ (algebraMap C _ s) ≠ 0 := (map_ne_zero μ).mpr hs0
      rw [map_div₀, hμ, hμ, ← he']
      rw [hμ] at hs0'
      field_simp
    have hsurj : Function.Surjective μ := by
      intro z
      obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := C' ⧸ 𝔮') z
      obtain ⟨x', rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨w₁, hw₁⟩ := himg x'
      obtain ⟨w₂, hw₂⟩ := himg y'
      refine ⟨w₁ / w₂, ?_⟩
      rw [map_div₀, hw₁, hw₂]
      rfl
    let e := RingEquiv.ofBijective μ ⟨μ.injective, hsurj⟩
    let ν : (𝔭₁.comap (algebraMap C R₁)).ResidueField →+* 𝔭₁.ResidueField :=
      Ideal.ResidueField.map (𝔭₁.comap (algebraMap C R₁)) 𝔭₁ (algebraMap C R₁) rfl
    let θ : C' →+* 𝔭₁.ResidueField :=
      (ν.comp e.symm.toRingHom).comp (algebraMap C' 𝔮'.ResidueField)
    have hθc : ∀ c : C, θ (algebraMap C C' c) = algebraMap R₁ 𝔭₁.ResidueField (algebraMap C R₁ c) := by
      intro c
      have h1 : e.symm (algebraMap C' 𝔮'.ResidueField (algebraMap C C' c)) =
          algebraMap C (𝔭₁.comap (algebraMap C R₁)).ResidueField c := by
        apply e.injective
        rw [RingEquiv.apply_symm_apply]
        exact (hμ c).symm
      show ν (e.symm (algebraMap C' 𝔮'.ResidueField (algebraMap C C' c))) = _
      rw [h1]
      exact Ideal.ResidueField.map_algebraMap _ _ _ _ c
    have hθker : ∀ b : C', θ b = 0 ↔ b ∈ 𝔮' := by
      intro b
      rw [← Ideal.algebraMap_residueField_eq_zero]
      show ν (e.symm (algebraMap C' 𝔮'.ResidueField b)) = 0 ↔ _
      rw [map_eq_zero_iff ν ν.injective, map_eq_zero_iff e.symm e.symm.injective]
    letI : Algebra C 𝔭₁.ResidueField :=
      ((algebraMap R₁ 𝔭₁.ResidueField).comp (algebraMap C R₁)).toAlgebra
    haveI : IsScalarTower C C 𝔭₁.ResidueField := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let f : R₁ →ₐ[C] 𝔭₁.ResidueField :=
      { algebraMap R₁ 𝔭₁.ResidueField with commutes' := fun c => rfl }
    let g : C' →ₐ[C] 𝔭₁.ResidueField :=
      { θ with commutes' := fun c => hθc c }
    let ψ := Algebra.TensorProduct.productMap f g
    have hψ : ∀ (r : R₁) (c' : C'), ψ (r ⊗ₜ[C] c') = algebraMap R₁ 𝔭₁.ResidueField r * θ c' :=
      fun r c' => Algebra.TensorProduct.productMap_apply_tmul f g r c'
    refine ⟨RingHom.ker ψ.toRingHom, RingHom.ker_isPrime _, ?_, ?_⟩
    · ext r
      rw [Ideal.mem_comap, RingHom.mem_ker, Algebra.TensorProduct.algebraMap_apply,
        Algebra.algebraMap_self_apply]
      show ψ (r ⊗ₜ[C] 1) = 0 ↔ _
      rw [hψ, map_one, mul_one, Ideal.algebraMap_residueField_eq_zero]
    · ext b
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show ψ (1 ⊗ₜ[C] b) = 0 ↔ _
      rw [hψ, map_one, one_mul, hθker]

  have wcpa_pple_dvbc_unique_elem : ∀ (R R₁ C C' R' : Type u) [CommRing R] [CommRing R₁] [CommRing C] [CommRing C'] [CommRing R'] (ρ : R →+* R₁) (φ : C →+* R₁) (lam : R₁ →+* R') (ι : C' →+* R') (𝔭 : Ideal R) (𝔭₁ : Ideal R₁) [𝔭₁.IsPrime] (𝔮' : Ideal C') (𝔭' : Ideal R') [𝔭'.IsPrime], 𝔭₁.comap ρ = 𝔭 → 𝔭'.comap lam = 𝔭₁ → 𝔮' ≤ 𝔭'.comap ι → (∀ x : R', ∃ s : C, s ∉ 𝔭₁.comap φ ∧ ∃ y : R₁, lam (φ s) * x - lam y ∈ 𝔮'.map ι) → (∀ b : R₁, ∃ a s : R, s ∉ 𝔭 ∧ ρ s * b - ρ a ∈ 𝔭₁) → (∀ P : Ideal R', P.IsPrime → P.comap lam = 𝔭₁ → 𝔮'.map ι ≤ P → P = 𝔭') ∧ (∀ b : R', ∃ a s : R, s ∉ 𝔭 ∧ lam (ρ s) * b - lam (ρ a) ∈ 𝔭') := by
    intro R R₁ C C' R' _ _ _ _ _ ρ φ lam ι 𝔭 𝔭₁ h𝔭₁ 𝔮' 𝔭' h𝔭' hρ hlam hι hcong helem
    have hJ : 𝔮'.map ι ≤ 𝔭' := Ideal.map_le_iff_le_comap.mpr hι
    have hmem : ∀ (P : Ideal R'), P.comap lam = 𝔭₁ → ∀ z : R₁, lam z ∈ P ↔ z ∈ 𝔭₁ := by
      intro P hP z
      rw [← hP, Ideal.mem_comap]
    have htr : ∀ (P : Ideal R'), P.IsPrime → P.comap lam = 𝔭₁ → 𝔮'.map ι ≤ P →
        ∀ x : R', ∀ s : C, s ∉ 𝔭₁.comap φ → ∀ y : R₁, lam (φ s) * x - lam y ∈ 𝔮'.map ι →
          (x ∈ P ↔ y ∈ 𝔭₁) := by
      intro P hP hPl hJP x s hs y hd
      have hu : lam (φ s) ∉ P := fun h => hs ((hmem P hPl _).mp h)
      rw [← hmem P hPl]
      constructor
      · intro hx
        have e : lam y = lam (φ s) * x - (lam (φ s) * x - lam y) := by ring
        rw [e]
        exact P.sub_mem (P.mul_mem_left _ hx) (hJP hd)
      · intro hy
        have h2 : lam (φ s) * x ∈ P := by
          have e : lam (φ s) * x = (lam (φ s) * x - lam y) + lam y := by ring
          rw [e]
          exact P.add_mem (hJP hd) hy
        exact (hP.mem_or_mem h2).resolve_left hu
    refine ⟨?_, ?_⟩
    · intro P hP hPl hJP
      ext x
      obtain ⟨s, hs, y, hd⟩ := hcong x
      rw [htr P hP hPl hJP x s hs y hd, htr 𝔭' inferInstance hlam hJ x s hs y hd]
    · intro b
      obtain ⟨s, hs, y, hd⟩ := hcong b
      obtain ⟨a₁, s₁, hs₁, he₁⟩ := helem (φ s)
      obtain ⟨a₂, s₂, hs₂, he₂⟩ := helem y
      have h𝔭prime : 𝔭.IsPrime := hρ ▸ Ideal.comap_isPrime ρ 𝔭₁
      refine ⟨s₁ * a₂, s₂ * a₁, ?_, ?_⟩
      · intro hmul
        rcases h𝔭prime.mem_or_mem hmul with h | h
        · exact hs₂ h
        · have ha : ρ a₁ ∈ 𝔭₁ := by
            rw [← hρ] at h
            exact h
          have h3 : ρ s₁ * φ s ∈ 𝔭₁ := by
            have e : ρ s₁ * φ s = (ρ s₁ * φ s - ρ a₁) + ρ a₁ := by ring
            rw [e]
            exact 𝔭₁.add_mem he₁ ha
          rcases h𝔭₁.mem_or_mem h3 with h' | h'
          · apply hs₁
            rw [← hρ]
            exact h'
          · exact hs h'
      · have key : lam (ρ (s₂ * a₁)) * b - lam (ρ (s₁ * a₂)) =
            -(lam (ρ s₂) * b * lam (ρ s₁ * φ s - ρ a₁)) +
              lam (ρ s₂) * lam (ρ s₁) * (lam (φ s) * b - lam y) +
              lam (ρ s₁) * lam (ρ s₂ * y - ρ a₂) := by
          simp only [map_mul, map_sub]
          ring
        rw [key]
        refine 𝔭'.add_mem (𝔭'.add_mem (𝔭'.neg_mem (𝔭'.mul_mem_left _ ?_))
          (𝔭'.mul_mem_left _ (hJ hd))) (𝔭'.mul_mem_left _ ?_)
        · rw [← Ideal.mem_comap, hlam]
          exact he₁
        · rw [← Ideal.mem_comap, hlam]
          exact he₂

  have wcpa_pple_dvbc_going_up_elt : ∀ (A B : Type u) [CommRing A] [CommRing B] (ι : A →+* B) (J : Ideal B), RingHom.Finite ((Ideal.Quotient.mk J).comp ι) → ∀ (𝔮' : Ideal A) [𝔮'.IsPrime] (𝔭' : Ideal B), (∀ P : Ideal B, P.IsPrime → J ≤ P → P.comap ι = 𝔮' → P = 𝔭') → ∀ f : B, f ∉ 𝔭' → ∃ c : A, c ∉ 𝔮' ∧ ∃ t : B, ι c - f * t ∈ J := by
    intro A B _ _ ι J hfin 𝔮' h𝔮 𝔭' huniq f hf
    by_cases hb : (J ⊔ Ideal.span {f}).comap ι ≤ 𝔮'
    · exfalso
      letI : Algebra A (B ⧸ (J ⊔ Ideal.span {f})) :=
        ((Ideal.Quotient.mk (J ⊔ Ideal.span {f})).comp ι).toAlgebra
      have hfinK : ((Ideal.Quotient.mk (J ⊔ Ideal.span {f})).comp ι).Finite := by
        have e : (Ideal.Quotient.mk (J ⊔ Ideal.span {f})).comp ι =
            (Ideal.Quotient.factor (le_sup_left : J ≤ J ⊔ Ideal.span {f})).comp
              ((Ideal.Quotient.mk J).comp ι) := by
          ext a
          simp
        rw [e]
        exact RingHom.Finite.comp (RingHom.Finite.of_surjective _ (Ideal.Quotient.factor_surjective _))
          hfin
      haveI : Module.Finite A (B ⧸ (J ⊔ Ideal.span {f})) := hfinK
      haveI : Algebra.IsIntegral A (B ⧸ (J ⊔ Ideal.span {f})) := Algebra.IsIntegral.of_finite A _
      have hbot : (⊥ : Ideal (B ⧸ (J ⊔ Ideal.span {f}))).comap
          (algebraMap A (B ⧸ (J ⊔ Ideal.span {f}))) ≤ 𝔮' := by
        intro a ha
        apply hb
        rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_bot.mp ha
      obtain ⟨Q, -, hQ, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral 𝔮' ⊥ hbot
      have hP : (Q.comap (Ideal.Quotient.mk (J ⊔ Ideal.span {f}))).IsPrime := Ideal.comap_isPrime _ Q
      have hJP : J ≤ Q.comap (Ideal.Quotient.mk (J ⊔ Ideal.span {f})) := by
        intro x hx
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left hx)]
        exact Q.zero_mem
      have hPc : (Q.comap (Ideal.Quotient.mk (J ⊔ Ideal.span {f}))).comap ι = 𝔮' := by
        rw [Ideal.comap_comap]
        exact hQc
      have h1 := huniq _ hP hJP hPc
      apply hf
      rw [← h1, Ideal.mem_comap,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.mem_span_singleton_self f))]
      exact Q.zero_mem
    · obtain ⟨c, hcK, hc⟩ := SetLike.not_le_iff_exists.mp hb
      refine ⟨c, hc, ?_⟩
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (Ideal.mem_comap.mp hcK)
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      refine ⟨a, ?_⟩
      have e : ι c - f * a = y := by
        rw [← hyz]
        ring
      rw [e]
      exact hy

  have wcpa_pple_dvbc_finite_basechange : ∀ (C R₁ C' : Type u) [CommRing C] [CommRing R₁] [CommRing C'] [Algebra C R₁] [Algebra C C'] (I : Ideal R₁), RingHom.Finite ((Ideal.Quotient.mk I).comp (algebraMap C R₁)) → RingHom.Finite ((Ideal.Quotient.mk (I.map (algebraMap R₁ (TensorProduct C R₁ C')))).comp (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom) := by
    intro C R₁ C' _ _ _ _ _ I hfin
    haveI : Module.Finite C (R₁ ⧸ I) := by
      rw [← RingHom.finite_algebraMap, IsScalarTower.algebraMap_eq C R₁ (R₁ ⧸ I),
        Ideal.Quotient.algebraMap_eq]
      exact hfin
    haveI : Module.Finite C' (TensorProduct C C' (R₁ ⧸ I)) := Module.Finite.base_change C C' (R₁ ⧸ I)
    have hfin' : (algebraMap C' (TensorProduct C C' (R₁ ⧸ I))).Finite :=
      RingHom.finite_algebraMap.mpr inferInstance
    set J := I.map (algebraMap R₁ (TensorProduct C R₁ C')) with hJ
    let g₁ : (R₁ ⧸ I) →ₐ[C] (TensorProduct C R₁ C' ⧸ J) :=
      Ideal.Quotient.liftₐ I ((Ideal.Quotient.mkₐ C J).comp
        (IsScalarTower.toAlgHom C R₁ (TensorProduct C R₁ C'))) (by
          intro a ha
          show Ideal.Quotient.mk J (algebraMap R₁ (TensorProduct C R₁ C') a) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_map_of_mem _ ha)
    let g₂ : C' →ₐ[C] (TensorProduct C R₁ C' ⧸ J) :=
      (Ideal.Quotient.mkₐ C J).comp Algebra.TensorProduct.includeRight
    let g := Algebra.TensorProduct.productMap g₂ g₁
    have hg : ∀ (c' : C') (r : R₁), g (c' ⊗ₜ[C] Ideal.Quotient.mk I r) =
        Ideal.Quotient.mk J ((r ⊗ₜ[C] c' : TensorProduct C R₁ C')) := by
      intro c' r
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      show Ideal.Quotient.mk J (Algebra.TensorProduct.includeRight c') *
        Ideal.Quotient.mk J (algebraMap R₁ (TensorProduct C R₁ C') r) = _
      rw [← map_mul, Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.algebraMap_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, Algebra.algebraMap_self_apply]
    have hsurj : Function.Surjective g := by
      intro z
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [map_zero, map_zero]⟩
      | tmul r c' => exact ⟨c' ⊗ₜ[C] Ideal.Quotient.mk I r, hg c' r⟩
      | add x y hx hy =>
        obtain ⟨a, ha⟩ := hx
        obtain ⟨b, hb⟩ := hy
        exact ⟨a + b, by rw [map_add, ha, hb, map_add]⟩
    have heq : (Ideal.Quotient.mk J).comp
        (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom =
        g.toRingHom.comp (algebraMap C' (TensorProduct C C' (R₁ ⧸ I))) := by
      ext c'
      show Ideal.Quotient.mk J ((1 : R₁) ⊗ₜ[C] c') = g (c' ⊗ₜ[C] 1)
      rw [← map_one (Ideal.Quotient.mk I), hg]
    rw [heq]
    exact RingHom.Finite.comp (RingHom.Finite.of_surjective _ hsurj) hfin'

  have wcpa_pple_dvbc_ann_kills : ∀ (R R₁ B : Type u) [CommRing R] [CommRing R₁] [CommRing B] [Algebra R R₁] [Algebra R₁ B] [Algebra R B] [IsScalarTower R R₁ B] (M : Type u) [AddCommGroup M] [Module R M] (b : B), b ∈ Ideal.map (algebraMap R₁ B) (Module.annihilator R₁ (TensorProduct R R₁ M)) → ∀ x : TensorProduct R B M, b • x = 0 := by
    intro R R₁ B _ _ _ _ _ _ _ M _ _ b hb x
    have hle : Ideal.map (algebraMap R₁ B) (Module.annihilator R₁ (TensorProduct R R₁ M)) ≤
        Module.annihilator B (TensorProduct R B M) := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, Module.mem_annihilator]
      rw [Module.mem_annihilator] at ha
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact smul_zero _
      | tmul b' m =>
        have h1 := ha (1 ⊗ₜ m)
        have h2 : (a ⊗ₜ[R] m : TensorProduct R R₁ M) = 0 := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one] at h1
          exact h1
        have h3 : ((algebraMap R₁ B a) ⊗ₜ[R] m : TensorProduct R B M) = 0 := by
          have := congrArg (LinearMap.rTensor M (IsScalarTower.toAlgHom R R₁ B).toLinearMap) h2
          rw [LinearMap.rTensor_tmul, map_zero] at this
          exact this
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_comm, ← smul_eq_mul,
          ← TensorProduct.smul_tmul', h3, smul_zero]
      | add y z hy hz => rw [smul_add, hy, hz, add_zero]
    exact (Module.mem_annihilator.mp (hle hb)) x

  have loc_swap_gen : ∀ (B N N' : Type u) [CommRing B] [AddCommGroup N] [Module B N]
      [AddCommGroup N'] [Module B N'] (τ : N →ₗ[B] N') (f t c g₀ : B),
      IsLocalizedModule (Submonoid.powers g₀) τ → c ∣ g₀ →
      (∀ x : N, c • x = (f * t) • x) → IsLocalizedModule (Submonoid.powers (f * g₀)) τ := by
    intro B N N' _ _ _ _ _ τ f t c g₀ hτ hdvd hc
    have hc' : ∀ y : N', c • y = (f * t) • y := by
      intro y
      obtain ⟨⟨n, s⟩, hs⟩ := IsLocalizedModule.surj (Submonoid.powers g₀) τ y
      have hu := IsLocalizedModule.map_units τ s
      rw [Module.End.isUnit_iff] at hu
      apply hu.1
      simp only [Module.algebraMap_end_apply]
      simp only [Submonoid.smul_def] at hs
      rw [smul_comm, hs, smul_comm (s : B), hs, ← map_smul, ← map_smul, hc]
    have hcE : algebraMap B (Module.End B N') c = algebraMap B (Module.End B N') (f * t) := by
      ext y
      simp only [Module.algebraMap_end_apply]
      exact hc' y
    obtain ⟨d, hd⟩ := hdvd
    have hg : IsUnit (algebraMap B (Module.End B N') g₀) :=
      IsLocalizedModule.map_units τ ⟨g₀, Submonoid.mem_powers g₀⟩
    rw [hd, map_mul, (Commute.map (Commute.all c d) (algebraMap B (Module.End B N'))).isUnit_mul_iff,
      hcE, map_mul, (Commute.map (Commute.all f t) (algebraMap B (Module.End B N'))).isUnit_mul_iff] at hg
    have hf : IsUnit (algebraMap B (Module.End B N') f) := hg.1.1
    have hg₀ : IsUnit (algebraMap B (Module.End B N') g₀) :=
      IsLocalizedModule.map_units τ ⟨g₀, Submonoid.mem_powers g₀⟩
    constructor
    · rintro ⟨x, n, rfl⟩
      rw [map_pow, map_mul]
      exact (hf.mul hg₀).pow n
    · intro y
      obtain ⟨⟨n, ⟨s, k, rfl⟩⟩, hs⟩ := IsLocalizedModule.surj (Submonoid.powers g₀) τ y
      refine ⟨⟨f ^ k • n, ⟨(f * g₀) ^ k, k, rfl⟩⟩, ?_⟩
      simp only [Submonoid.smul_def] at hs ⊢
      rw [mul_pow, mul_smul, hs, map_smul]
    · intro x₁ x₂ h
      obtain ⟨⟨s, k, rfl⟩, hs⟩ := IsLocalizedModule.exists_of_eq (S := Submonoid.powers g₀) h
      refine ⟨⟨(f * g₀) ^ k, k, rfl⟩, ?_⟩
      simp only [Submonoid.smul_def] at hs ⊢
      rw [mul_pow, mul_smul, mul_smul, hs]
  have wcpa_pple_dvbc_loc_swap : ∀ (V R B : Type u) [CommRing V] [CommRing R] [CommRing B] [Algebra V R] [Algebra R B] [Algebra V B] [IsScalarTower V R B] (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M] (f t c g₀ : B), c ∣ g₀ → (∀ x : TensorProduct R B M, c • x = (f * t) • x) → Nonempty (TensorProduct R (Localization.Away (f * g₀)) M ≃ₗ[V] TensorProduct R (Localization.Away g₀) M) := by
    intro V R B _ _ _ _ _ _ _ M _ _ _ _ f t c g₀ hdvd hc
    haveI := loc_swap_gen B (TensorProduct R B M) (TensorProduct R (Localization.Away g₀) M)
      (TensorProduct.AlgebraTensorModule.rTensor R M (Algebra.linearMap B (Localization.Away g₀)))
      f t c g₀ inferInstance hdvd hc
    exact ⟨(IsLocalizedModule.linearEquiv (Submonoid.powers (f * g₀))
      (TensorProduct.AlgebraTensorModule.rTensor R M (Algebra.linearMap B (Localization.Away (f * g₀))))
      (TensorProduct.AlgebraTensorModule.rTensor R M (Algebra.linearMap B (Localization.Away g₀)))).restrictScalars V⟩

  have wcpa_pple_dvbc_loc_cancel : ∀ (V : Type u) [CommRing V] (R : Type u) [CommRing R] [Algebra V R] (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M] (R₁ : Type u) [CommRing R₁] [Algebra R R₁] [Algebra V R₁] [IsScalarTower V R R₁] (C : Type u) [CommRing C] [Algebra V C] [Algebra C R₁] [IsScalarTower V C R₁] (C' : Type u) [CommRing C'] [Algebra C C'] [Algebra V C'] [IsScalarTower V C C'] (c' : C'), Nonempty (TensorProduct R (Localization.Away ((Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c')) M ≃ₗ[V] TensorProduct C (Localization.Away c') (TensorProduct R R₁ M)) := by
    intro V _ R _ _ M _ _ _ _ R₁ _ _ _ _ C _ _ _ _ C' _ _ _ _ c'
    classical
    have hT : ∀ c : C, algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ c) =
        (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') (algebraMap C C' c) := by
      intro c
      rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
    have hVR' : ∀ v : V, algebraMap V (TensorProduct C R₁ C') v =
        (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') (algebraMap V C' v) := by
      intro v
      rw [IsScalarTower.algebraMap_apply V R₁ (TensorProduct C R₁ C'),
        IsScalarTower.algebraMap_apply V C R₁, hT, ← IsScalarTower.algebraMap_apply V C C']
    obtain ⟨Φ₀, hgen⟩ : ∃ Φ₀ : TensorProduct R (TensorProduct C R₁ C') M ≃+
        TensorProduct C C' (TensorProduct R R₁ M), ∀ (r : R₁) (c₁ : C') (m : M),
        Φ₀ ((r ⊗ₜ[C] c₁) ⊗ₜ[R] m) = c₁ ⊗ₜ[C] (r ⊗ₜ[R] m) := by
      refine ⟨(((TensorProduct.AlgebraTensorModule.cancelBaseChange R R₁ (TensorProduct C R₁ C')
        (TensorProduct C R₁ C') M).symm.toAddEquiv.trans
        (TensorProduct.comm R₁ (TensorProduct C R₁ C') (TensorProduct R R₁ M)).toAddEquiv).trans
        (TensorProduct.AlgebraTensorModule.cancelBaseChange C R₁ R₁ (TensorProduct R R₁ M) C').toAddEquiv).trans
        (TensorProduct.comm C (TensorProduct R R₁ M) C').toAddEquiv, ?_⟩
      intro r c₁ m
      simp only [AddEquiv.trans_apply, LinearEquiv.coe_toAddEquiv]
      erw [TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul, TensorProduct.comm_tmul]
      simp only [LinearEquiv.refl_apply, TensorProduct.mk_apply,
        TensorProduct.AlgebraTensorModule.rid_tmul]
      erw [LinearEquiv.refl_apply, TensorProduct.AlgebraTensorModule.rid_tmul]
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    have hΦ : ∀ (c : C') (x : TensorProduct R (TensorProduct C R₁ C') M),
        Φ₀ ((Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c • x) = c • Φ₀ x := by
      intro c x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul y m =>
        induction y using TensorProduct.induction_on with
        | zero => simp
        | tmul r c₁ =>
          have h1 : (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c •
              ((r ⊗ₜ[C] c₁) ⊗ₜ[R] m : TensorProduct R (TensorProduct C R₁ C') M) =
              (r ⊗ₜ[C] (c * c₁)) ⊗ₜ[R] m := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, Algebra.TensorProduct.includeRight_apply,
              Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          rw [h1, hgen, hgen, TensorProduct.smul_tmul', smul_eq_mul]
        | add y₁ y₂ h₁ h₂ =>
          rw [TensorProduct.add_tmul, smul_add, map_add, h₁, h₂, map_add, smul_add]
      | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add]
    generalize hh : (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c' = h
    let ι : C' →+* TensorProduct C R₁ C' :=
      (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom
    have hιc : ι c' = h := hh
    letI mN : Module C' (TensorProduct R (TensorProduct C R₁ C') M) :=
      Module.compHom (TensorProduct R (TensorProduct C R₁ C') M) ι
    letI mL : Module C' (TensorProduct R (Localization.Away h) M) :=
      Module.compHom (TensorProduct R (Localization.Away h) M) ι
    have hsm : ∀ (c : C') (y : TensorProduct R (Localization.Away h) M), c • y = ι c • y :=
      fun _ _ => rfl
    have hsmN : ∀ (c : C') (y : TensorProduct R (TensorProduct C R₁ C') M), c • y = ι c • y :=
      fun _ _ => rfl
    let τ₁ : TensorProduct R (TensorProduct C R₁ C') M →ₗ[TensorProduct C R₁ C']
        TensorProduct R (Localization.Away h) M :=
      TensorProduct.AlgebraTensorModule.rTensor R M
        (Algebra.linearMap (TensorProduct C R₁ C') (Localization.Away h))
    have hτ₁ : IsLocalizedModule (Submonoid.powers h) τ₁ := inferInstance
    let τ₁' : TensorProduct R (TensorProduct C R₁ C') M →ₗ[C']
        TensorProduct R (Localization.Away h) M :=
      { toFun := τ₁, map_add' := τ₁.map_add, map_smul' := fun c x => τ₁.map_smul (ι c) x }
    have hτ₁' : IsLocalizedModule (Submonoid.powers c') τ₁' := by
      constructor
      · rintro ⟨_, n, rfl⟩
        have hu := IsLocalizedModule.map_units (S := Submonoid.powers h) τ₁ ⟨h ^ n, n, rfl⟩
        rw [Module.End.isUnit_iff] at hu ⊢
        have heq : ⇑(algebraMap C' (Module.End C' (TensorProduct R (Localization.Away h) M)) (c' ^ n)) =
            ⇑(algebraMap (TensorProduct C R₁ C')
              (Module.End (TensorProduct C R₁ C') (TensorProduct R (Localization.Away h) M)) (h ^ n)) := by
          funext y
          rw [Module.algebraMap_end_apply, Module.algebraMap_end_apply, hsm, map_pow, hιc]
        have := (congrArg Function.Bijective heq).mpr hu
        exact this
      · intro y
        obtain ⟨⟨x, ⟨_, k, rfl⟩⟩, hx⟩ := IsLocalizedModule.surj (Submonoid.powers h) τ₁ y
        refine ⟨⟨x, ⟨c' ^ k, k, rfl⟩⟩, ?_⟩
        simp only [Submonoid.smul_def] at hx ⊢
        rw [hsm, map_pow, hιc]
        exact hx
      · intro x₁ x₂ he
        obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
          IsLocalizedModule.exists_of_eq (S := Submonoid.powers h) (f := τ₁) he
        refine ⟨⟨c' ^ k, k, rfl⟩, ?_⟩
        simp only [Submonoid.smul_def] at hk ⊢
        rw [hsmN, hsmN, map_pow, hιc]
        exact hk
    let τ₂ : TensorProduct C C' (TensorProduct R R₁ M) →ₗ[C']
        TensorProduct C (Localization.Away c') (TensorProduct R R₁ M) :=
      TensorProduct.AlgebraTensorModule.rTensor C (TensorProduct R R₁ M)
        (Algebra.linearMap C' (Localization.Away c'))
    haveI hτ₂ : IsLocalizedModule (Submonoid.powers c') τ₂ := inferInstance
    let Φ : TensorProduct R (TensorProduct C R₁ C') M ≃ₗ[C'] TensorProduct C C' (TensorProduct R R₁ M) :=
      { Φ₀ with map_smul' := fun c x => hΦ c x }
    haveI hcomp : IsLocalizedModule (Submonoid.powers c') (τ₂ ∘ₗ Φ.toLinearMap) :=
      IsLocalizedModule.of_linearEquiv_right (Submonoid.powers c') τ₂ Φ
    let eL := IsLocalizedModule.linearEquiv (Submonoid.powers c') τ₁' (τ₂ ∘ₗ Φ.toLinearMap)
    have hv1 : ∀ (v : V) (x : TensorProduct R (Localization.Away h) M),
        v • x = (algebraMap V C' v) • x := by
      intro v x
      rw [hsm]
      show v • x = (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C')
        (algebraMap V C' v) • x
      rw [← hVR', algebraMap_smul]
    have hv2 : ∀ (v : V) (y : TensorProduct C (Localization.Away c') (TensorProduct R R₁ M)),
        v • y = (algebraMap V C' v) • y := by
      intro v y
      rw [algebraMap_smul]
    refine ⟨{ eL.toAddEquiv with map_smul' := fun v x => ?_ }⟩
    show eL (v • x) = v • eL x
    rw [hv1, LinearEquiv.map_smul, hv2]

  have wcpa_pple_dvbc_injm_flat : ∀ (V C C'' M₁ : Type u) [CommRing V] [CommRing C] [CommRing C''] [Algebra V C] [Algebra C C''] [Algebra V C''] [IsScalarTower V C C''] [Module.Flat C C''] [AddCommGroup M₁] [Module C M₁] [Module V M₁] [IsScalarTower V C M₁] (𝔪 : Ideal V) (r : ℕ) (α : (Fin r → C) →ₗ[C] M₁), (∀ u : Fin r → C, α u ∈ 𝔪 • (⊤ : Submodule V M₁) → u ∈ 𝔪 • (⊤ : Submodule V (Fin r → C))) → ∃ β : (Fin r → C'') →ₗ[V] TensorProduct C C'' M₁, (∀ u : Fin r → C'', β u ∈ 𝔪 • (⊤ : Submodule V (TensorProduct C C'' M₁)) → u ∈ 𝔪 • (⊤ : Submodule V (Fin r → C''))) ∧ Nonempty ((TensorProduct C C'' M₁ ⧸ LinearMap.range β) ≃ₗ[V] TensorProduct C C'' (M₁ ⧸ LinearMap.range α)) := by
    intro V C C'' M₁ _ _ _ _ _ _ _ _ _ _ _ _ 𝔪 r α hα
    classical
    set 𝔞 : Ideal C := 𝔪.map (algebraMap V C) with h𝔞
    have hconv : ∀ (X : Type u) [AddCommGroup X] [Module C X] [Module V X] [IsScalarTower V C X]
        (x : X), x ∈ 𝔪 • (⊤ : Submodule V X) ↔ x ∈ 𝔞 • (⊤ : Submodule C X) := by
      intro X _ _ _ _ x
      have h := Ideal.smul_restrictScalars (R := V) (S := C) (M := X) 𝔪 (⊤ : Submodule C X)
      rw [Submodule.restrictScalars_top] at h
      rw [← h, Submodule.restrictScalars_mem]
    let π : TensorProduct C C'' (Fin r → C) ≃ₗ[C''] (Fin r → C'') :=
      TensorProduct.piScalarRight C C'' C'' (Fin r)
    let βC : (Fin r → C'') →ₗ[C] TensorProduct C C'' M₁ :=
      (LinearMap.lTensor C'' α) ∘ₗ (π.symm.toLinearMap.restrictScalars C)
    refine ⟨βC.restrictScalars V, ?_, ?_⟩
    · intro u hu
      rw [hconv] at hu ⊢
      let P : Submodule C (Fin r → C) := 𝔞 • ⊤
      let Q : Submodule C M₁ := 𝔞 • ⊤
      let ab : (Fin r → C) →ₗ[C] M₁ ⧸ Q := Q.mkQ ∘ₗ α
      have hex : Function.Exact P.subtype ab := by
        intro y
        constructor
        · intro hy
          have hy' : α y ∈ Q := (Submodule.Quotient.mk_eq_zero Q).mp hy
          have : y ∈ 𝔞 • (⊤ : Submodule C (Fin r → C)) :=
            (hconv _ y).mp (hα y ((hconv _ (α y)).mpr hy'))
          exact ⟨⟨y, this⟩, rfl⟩
        · rintro ⟨⟨y, hy⟩, rfl⟩
          show Q.mkQ (α y) = 0
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
          have : Submodule.map α P ≤ Q := by
            rw [Submodule.map_smul'']
            exact Submodule.smul_mono le_rfl le_top
          exact this ⟨y, hy, rfl⟩
      have hex' := Module.Flat.lTensor_exact C'' hex
      set v := π.symm u with hv
      have hab : LinearMap.lTensor C'' ab v = 0 := by
        have h1 : βC u ∈ 𝔞 • (⊤ : Submodule C (TensorProduct C C'' M₁)) := hu
        have h2 : LinearMap.lTensor C'' Q.mkQ (βC u) = 0 := by
          have hle : Submodule.map (LinearMap.lTensor C'' Q.mkQ)
              (𝔞 • (⊤ : Submodule C (TensorProduct C C'' M₁))) ≤ ⊥ := by
            rw [Submodule.map_smul'', Submodule.smul_le]
            intro a ha z hz
            clear hz
            induction z using TensorProduct.induction_on with
            | zero => simp
            | tmul c m =>
              rw [Submodule.mem_bot, ← TensorProduct.tmul_smul]
              obtain ⟨m', rfl⟩ := Submodule.Quotient.mk_surjective Q m
              rw [← Submodule.Quotient.mk_smul, (Submodule.Quotient.mk_eq_zero Q).mpr
                (Submodule.smul_mem_smul ha Submodule.mem_top), TensorProduct.tmul_zero]
            | add x y hx hy =>
              rw [Submodule.mem_bot] at hx hy ⊢
              rw [smul_add, hx, hy, add_zero]
          exact (Submodule.mem_bot C).mp (hle ⟨_, h1, rfl⟩)
        rw [LinearMap.lTensor_comp, LinearMap.comp_apply]
        exact h2
      obtain ⟨w, hw⟩ := (hex' v).mp hab
      have hvmem : v ∈ 𝔞 • (⊤ : Submodule C (TensorProduct C C'' (Fin r → C))) := by
        rw [← hw]
        have hle : LinearMap.range (LinearMap.lTensor C'' P.subtype) ≤
            𝔞 • (⊤ : Submodule C (TensorProduct C C'' (Fin r → C))) := by
          rintro _ ⟨z, rfl⟩
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul c p =>
            rw [LinearMap.lTensor_tmul]
            obtain ⟨p, hp⟩ := p
            show c ⊗ₜ[C] p ∈ _
            refine Submodule.smul_induction_on hp ?_ ?_
            · intro a ha y _
              rw [TensorProduct.tmul_smul]
              exact Submodule.smul_mem_smul ha Submodule.mem_top
            · intro x y hx hy
              rw [TensorProduct.tmul_add]
              exact Submodule.add_mem _ hx hy
          | add x y hx hy =>
            rw [map_add]
            exact Submodule.add_mem _ hx hy
        exact hle ⟨w, rfl⟩
      have hu' : u = (π.toLinearMap.restrictScalars C) v := by
        rw [hv]
        simp
      rw [hu']
      have hmap : Submodule.map (π.toLinearMap.restrictScalars C)
          (𝔞 • (⊤ : Submodule C (TensorProduct C C'' (Fin r → C)))) ≤ 𝔞 • ⊤ := by
        rw [Submodule.map_smul'']
        exact Submodule.smul_mono le_rfl le_top
      exact hmap ⟨v, hvmem, rfl⟩
    · have hex := lTensor_exact C'' (LinearMap.exact_map_mkQ_range α)
        (Submodule.mkQ_surjective (LinearMap.range α))
      let E := hex.linearEquivOfSurjective
        (LinearMap.lTensor_surjective C'' (Submodule.mkQ_surjective (LinearMap.range α)))
      have hrange : LinearMap.range (βC.restrictScalars V) =
          (LinearMap.range (LinearMap.lTensor C'' α)).restrictScalars V := by
        ext x
        simp only [LinearMap.mem_range, Submodule.restrictScalars_mem, LinearMap.coe_restrictScalars]
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨π.symm y, rfl⟩
        · rintro ⟨y, rfl⟩
          refine ⟨π y, ?_⟩
          show LinearMap.lTensor C'' α (π.symm (π y)) = _
          rw [LinearEquiv.symm_apply_apply]
      refine ⟨(Submodule.quotEquivOfEq _ _ hrange).trans
        ((Submodule.Quotient.restrictScalarsEquiv V _).trans (E.restrictScalars V))⟩

  have wcpa_pple_dvbc_good_smooth : ∀ (V : Type u) [CommRing V] [IsLocalRing V] (C : Type u) [CommRing C] [Algebra V C], Algebra.Smooth V C → ∀ (C' : Type u) [CommRing C'] [Algebra C C'] [Algebra V C'] [IsScalarTower V C C'], Algebra.Etale C C' → ∀ (𝔮' : Ideal C') [𝔮'.IsPrime], Ideal.map (algebraMap V C') (IsLocalRing.maximalIdeal V) ≤ 𝔮' → ∀ c' : C', c' ∉ 𝔮' → Algebra.Smooth V (Localization.Away c') ∧ Ideal.map (algebraMap V (Localization.Away c')) (IsLocalRing.maximalIdeal V) ≠ ⊤ := by
    intro V _ _ C _ _ hC C' _ _ _ _ hE 𝔮' h𝔮 hm c' hc
    haveI : Algebra.Smooth C C' := inferInstance
    haveI : Algebra.Smooth V C' := Algebra.Smooth.comp V C C'
    haveI : Algebra.Smooth C' (Localization.Away c') := Algebra.Smooth.of_isLocalization_Away c'
    refine ⟨Algebra.Smooth.comp V C' (Localization.Away c'), ?_⟩
    have hdisj : Disjoint (Submonoid.powers c' : Set C') (𝔮' : Set C') :=
      (Ideal.disjoint_powers_iff_notMem c' h𝔮.isRadical).mpr hc
    have hp := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers c')
      (Localization.Away c') 𝔮' h𝔮 hdisj
    intro htop
    apply hp.ne_top
    rw [eq_top_iff, ← htop, IsScalarTower.algebraMap_eq V C' (Localization.Away c'), ← Ideal.map_map]
    exact Ideal.map_mono hm

  have dos_away : ∀ (S T : Type u) [CommRing S] [CommRing T] [Algebra S T] (x : S)
      [IsLocalization.Away x T], (IsDomain S ∨ Subsingleton S) → IsDomain T ∨ Subsingleton T := by
    intro S T _ _ _ x _ h
    rcases h with h | h
    · by_cases hx : x = 0
      · right
        exact IsLocalization.subsingleton (M := Submonoid.powers x) (by rw [hx]; exact ⟨1, pow_one 0⟩)
      · left
        have hle : Submonoid.powers x ≤ nonZeroDivisors S :=
          powers_le_nonZeroDivisors_of_noZeroDivisors hx
        exact IsLocalization.isDomain_of_le_nonZeroDivisors T hle
    · right
      exact subsingleton_of_zero_eq_one (by
        rw [← map_zero (algebraMap S T), ← map_one (algebraMap S T), Subsingleton.elim (0 : S) 1])
  have dos_equiv : ∀ (A B : Type u) [CommRing A] [CommRing B] (e : A ≃+* B),
      (IsDomain B ∨ Subsingleton B) → IsDomain A ∨ Subsingleton A := by
    intro A B _ _ e h
    rcases h with h | h
    · left; exact e.toMulEquiv.isDomain
    · right; exact e.toEquiv.subsingleton
  have wcpa_pple_dvbc_geom_dvd : ∀ (V B : Type u) [CommRing V] [CommRing B] [Algebra V B] (c₀ c' : B), c₀ ∣ c' → (∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L (Localization.Away c₀)) ∨ Subsingleton (TensorProduct V L (Localization.Away c₀))) → ∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L (Localization.Away c')) ∨ Subsingleton (TensorProduct V L (Localization.Away c')) := by
    intro V B _ _ _ c₀ c' hdvd hgeom L _ _
    obtain ⟨d, rfl⟩ := hdvd
    let D := Localization.Away c₀
    let T' := Localization.Away (algebraMap B D d)
    haveI : IsLocalization.Away (c₀ * d) T' := IsLocalization.Away.mul' D T' c₀ d
    let e : Localization.Away (c₀ * d) ≃ₐ[B] T' :=
      IsLocalization.algEquiv (Submonoid.powers (c₀ * d)) (Localization.Away (c₀ * d)) T'
    let e1 : TensorProduct V L (Localization.Away (c₀ * d)) ≃ₐ[V] TensorProduct V L T' :=
      Algebra.TensorProduct.congr AlgEquiv.refl (e.restrictScalars V)
    let e2 : TensorProduct V L T' ≃ₐ[V] TensorProduct V T' L := Algebra.TensorProduct.comm V L T'
    let e3 : TensorProduct D T' (TensorProduct V D L) ≃ₐ[T'] TensorProduct V T' L :=
      Algebra.TensorProduct.cancelBaseChange V D T' T' L
    let e4 : TensorProduct V D L ≃ₐ[V] TensorProduct V L D := Algebra.TensorProduct.comm V D L
    haveI : IsLocalization.Away (algebraMap D (TensorProduct V D L) (algebraMap B D d))
        (TensorProduct D (TensorProduct V D L) T') := IsLocalization.Away.tensor _ _
    let e5 : TensorProduct D (TensorProduct V D L) T' ≃ₐ[D] TensorProduct D T' (TensorProduct V D L) :=
      Algebra.TensorProduct.comm D _ _
    have h0 : IsDomain (TensorProduct V D L) ∨ Subsingleton (TensorProduct V D L) :=
      dos_equiv (TensorProduct V D L) (TensorProduct V L D) e4.toRingEquiv (hgeom L)
    have h1 := dos_away (TensorProduct V D L) (TensorProduct D (TensorProduct V D L) T')
      (algebraMap D (TensorProduct V D L) (algebraMap B D d)) h0
    have h2 := dos_equiv (TensorProduct D T' (TensorProduct V D L))
      (TensorProduct D (TensorProduct V D L) T') e5.symm.toRingEquiv h1
    have h3 := dos_equiv (TensorProduct V T' L) (TensorProduct D T' (TensorProduct V D L))
      e3.symm.toRingEquiv h2
    have h4 := dos_equiv (TensorProduct V L T') (TensorProduct V T' L) e2.toRingEquiv h3
    exact dos_equiv (TensorProduct V L (Localization.Away (c₀ * d))) (TensorProduct V L T')
      e1.toRingEquiv h4
  intro V _ _ _ _ hW R _ _ hRfp M _ _ _ _ hM 𝔭 h𝔭 R₁ _ _ _ _ C _ _ _ _ hEt hSm 𝔭₁ _ hcomap₁
    helem₁ hmC hfin huniq r α hinj C' _ _ _ _ hEtC 𝔮' _ hcomap' helem' hcof' c₀ hc₀ hgeom
  classical

  obtain ⟨𝔭', h𝔭', hlam, hι⟩ := wcpa_pple_dvbc_prime_exists C R₁ C' 𝔭₁ 𝔮' hcomap' helem'
  haveI := h𝔭'
  have hT : ∀ c : C, algebraMap R₁ (TensorProduct C R₁ C') (algebraMap C R₁ c) =
      (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') (algebraMap C C' c) := by
    intro c
    rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  have hTc : (algebraMap R₁ (TensorProduct C R₁ C')).comp (algebraMap C R₁) =
      (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom.comp
        (algebraMap C C') := RingHom.ext hT
  haveI : Algebra.Etale R₁ (TensorProduct C R₁ C') := inferInstance
  haveI hEt' : Algebra.Etale R (TensorProduct C R₁ C') := Algebra.Etale.comp R R₁ _
  have hcomapR : 𝔭'.comap (algebraMap R (TensorProduct C R₁ C')) = 𝔭 := by
    rw [IsScalarTower.algebraMap_eq R R₁ (TensorProduct C R₁ C'), ← Ideal.comap_comap, hlam,
      hcomap₁]

  have hcong := wcpa_pple_dvbc_tensor_congr C R₁ C' (𝔭₁.comap (algebraMap C R₁)) 𝔮' helem'
  obtain ⟨hA, hB⟩ := wcpa_pple_dvbc_unique_elem R R₁ C C' (TensorProduct C R₁ C')
    (algebraMap R R₁) (algebraMap C R₁) (algebraMap R₁ (TensorProduct C R₁ C'))
    (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom
    𝔭 𝔭₁ 𝔮' 𝔭' hcomap₁ hlam (le_of_eq hι.symm) hcong helem₁
  refine ⟨TensorProduct C R₁ C', inferInstance, inferInstance, inferInstance, inferInstance,
    hEt', 𝔭', h𝔭', hcomapR, ?_, ?_⟩
  · intro b
    obtain ⟨a, s, hs, h⟩ := hB b
    refine ⟨a, s, hs, ?_⟩
    rwa [IsScalarTower.algebraMap_apply R R₁ (TensorProduct C R₁ C') s,
      IsScalarTower.algebraMap_apply R R₁ (TensorProduct C R₁ C') a]
  intro f hf

  have hfinJ := wcpa_pple_dvbc_finite_basechange C R₁ C'
    (Module.annihilator R₁ (TensorProduct R R₁ M)) hfin
  have huniqJ : ∀ P : Ideal (TensorProduct C R₁ C'), P.IsPrime →
      (Module.annihilator R₁ (TensorProduct R R₁ M)).map
        (algebraMap R₁ (TensorProduct C R₁ C')) ≤ P →
      P.comap (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom
        = 𝔮' → P = 𝔭' := by
    intro P hP hJP hιP
    haveI := hP
    have h1 : Module.annihilator R₁ (TensorProduct R R₁ M) ≤
        P.comap (algebraMap R₁ (TensorProduct C R₁ C')) := Ideal.map_le_iff_le_comap.mp hJP
    have h2 : (P.comap (algebraMap R₁ (TensorProduct C R₁ C'))).comap (algebraMap C R₁) =
        𝔭₁.comap (algebraMap C R₁) := by
      rw [Ideal.comap_comap, hTc, ← Ideal.comap_comap, hιP, hcomap']
    have h3 := huniq _ inferInstance h1 h2
    refine hA P hP h3 ?_
    rw [Ideal.map_le_iff_le_comap, hιP]
  obtain ⟨c₁, hc₁, t, ht⟩ := wcpa_pple_dvbc_going_up_elt C' (TensorProduct C R₁ C')
    (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C').toRingHom
    _ hfinJ 𝔮' 𝔭' huniqJ f hf

  have hc0c1 : c₀ * c₁ ∉ 𝔮' := fun h =>
    ((inferInstance : 𝔮'.IsPrime).mem_or_mem h).elim hc₀ hc₁
  obtain ⟨c', hc', hdvd, hFILT⟩ := hcof' (c₀ * c₁) hc0c1
  have hιc' : (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c' ∉ 𝔭' := by
    intro h
    apply hc'
    rw [← hι]
    exact h
  refine ⟨f * (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c', ?_,
    dvd_mul_right f _, ?_⟩
  · intro h
    rcases h𝔭'.mem_or_mem h with h | h
    · exact hf h
    · exact hιc' h

  have hkill : ∀ x : TensorProduct R (TensorProduct C R₁ C') M,
      (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c₁ • x =
        (f * t) • x := by
    intro x
    have h := wcpa_pple_dvbc_ann_kills R R₁ (TensorProduct C R₁ C') M _ ht x
    have h2 : ((Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c₁ -
        f * t) • x = 0 := h
    have h3 := @sub_smul (TensorProduct C R₁ C') (TensorProduct R (TensorProduct C R₁ C') M) _ _
      TensorProduct.leftModule
      ((Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c₁) (f * t) x
    exact sub_eq_zero.mp (h3.symm.trans h2)
  have hdvd1 : (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c₁ ∣
      (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c' :=
    map_dvd _ (dvd_trans (dvd_mul_left c₁ c₀) hdvd)
  obtain ⟨e₁⟩ := wcpa_pple_dvbc_loc_swap V R (TensorProduct C R₁ C') M f t _ _ hdvd1 hkill
  obtain ⟨e₂⟩ := wcpa_pple_dvbc_loc_cancel V R M R₁ C C' c'
  set e := (e₁.trans e₂).symm with he

  have hmC' : Ideal.map (algebraMap V C') (IsLocalRing.maximalIdeal V) ≤ 𝔮' := by
    rw [IsScalarTower.algebraMap_eq V C C', ← Ideal.map_map, Ideal.map_le_iff_le_comap, hcomap']
    exact hmC
  have hs10 := wcpa_pple_dvbc_good_smooth V C hSm C' hEtC 𝔮' hmC' c' hc'
  have hgeom'' := wcpa_pple_dvbc_geom_dvd V C' c₀ c' (dvd_trans (dvd_mul_right c₀ c₁) hdvd) hgeom
  haveI : Module.Flat C C' := inferInstance
  haveI : Module.Flat C (Localization.Away c') := Module.Flat.trans C C' (Localization.Away c')
  obtain ⟨β, hβ, ⟨ε⟩⟩ := wcpa_pple_dvbc_injm_flat V C (Localization.Away c')
    (TensorProduct R R₁ M) (IsLocalRing.maximalIdeal V) r α hinj
  have hinj'' : ∀ u : Fin r → Localization.Away c',
      (e.toLinearMap ∘ₗ β) u ∈ (IsLocalRing.maximalIdeal V) •
        (⊤ : Submodule V (TensorProduct R (Localization.Away
          (f * (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c')) M)) →
      u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → Localization.Away c')) := by
    intro u hu
    apply hβ u
    have h1 : e.symm ((e.toLinearMap ∘ₗ β) u) ∈ ((IsLocalRing.maximalIdeal V) •
        (⊤ : Submodule V (TensorProduct R (Localization.Away
          (f * (Algebra.TensorProduct.includeRight : C' →ₐ[C] TensorProduct C R₁ C') c')) M))).map
          e.symm.toLinearMap := Submodule.mem_map_of_mem hu
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range] at h1
    have h2 : e.symm ((e.toLinearMap ∘ₗ β) u) = β u := e.symm_apply_apply (β u)
    rw [h2] at h1
    exact h1
  have hrange : (LinearMap.range β).map e.toLinearMap = LinearMap.range (e.toLinearMap ∘ₗ β) :=
    (LinearMap.range_comp β e.toLinearMap).symm
  refine ⟨Localization.Away c', inferInstance, inferInstance, hs10.1, hs10.2, hgeom'', r,
    e.toLinearMap ∘ₗ β, hinj'', _, inferInstance, inferInstance,
    hFILT _ ⟨LinearEquiv.refl V _⟩, ⟨?_⟩⟩
  exact (Submodule.Quotient.equiv _ _ e hrange).symm.trans ε

theorem wcpa_pple_filt_extend : ∀ (V : Type u) [CommRing V] [IsLocalRing V]
    (Y X : Type u) [AddCommGroup Y] [Module V Y] [AddCommGroup X] [Module V X], (Y ≃ₗ[V] X) →
    ∀ (C : Type u) [CommRing C] [Algebra V C], Algebra.Smooth V C →
    Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≠ ⊤ →
    (∀ (L : Type u) [Field L] [Algebra V L],
      IsDomain (TensorProduct V L C) ∨ Subsingleton (TensorProduct V L C)) →
    ∀ (r : ℕ) (α : (Fin r → C) →ₗ[V] Y),
    (∀ u : Fin r → C, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V Y) →
      u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → C))) →
    ∀ (Q : Type u) [AddCommGroup Q] [Module V Q], wcpaDvFilt V Q →
    ((Y ⧸ LinearMap.range α) ≃ₗ[V] Q) → wcpaDvFilt V X :=
by
  intro V _ _ Y X _ _ _ _ σ C _ _ hsm hne hgeom r α hα Q _ _ hQ e
  classical
  have mpres : ∀ {M M' : Type u} [AddCommMonoid M] [Module V M] [AddCommMonoid M'] [Module V M']
      (f : M →ₗ[V] M') (x : M), x ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) →
      f x ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M') := by
    intro M M' _ _ _ _ f x hx
    have hle : (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) ≤
        ((IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M')).comap f := by
      rw [Submodule.smul_le]
      intro a ha n _
      rw [Submodule.mem_comap, map_smul]
      exact Submodule.smul_mem_smul ha Submodule.mem_top
    exact hle hx
  unfold wcpaDvFilt at hQ ⊢
  obtain ⟨nQ, NQ, hNQ0, hNQn, hstepQ⟩ := hQ
  let p : X →ₗ[V] Q := e.toLinearMap ∘ₗ (LinearMap.range α).mkQ ∘ₗ σ.symm.toLinearMap
  have hp : ∀ x, p x = e (Submodule.Quotient.mk (σ.symm x)) := fun x => rfl
  have hpsurj : Function.Surjective p := by
    intro q
    obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (e.symm q)
    refine ⟨σ y, ?_⟩
    rw [hp, LinearEquiv.symm_apply_apply, hy, LinearEquiv.apply_symm_apply]
  have hker : ∀ x, p x = 0 ↔ ∃ u, σ (α u) = x := by
    intro x
    rw [hp, LinearEquiv.map_eq_zero_iff, Submodule.Quotient.mk_eq_zero, LinearMap.mem_range]
    constructor
    · rintro ⟨u, hu⟩
      exact ⟨u, by rw [hu, LinearEquiv.apply_symm_apply]⟩
    · rintro ⟨u, rfl⟩
      exact ⟨u, by rw [LinearEquiv.symm_apply_apply]⟩
  let N : ℕ → Submodule V X := fun k =>
    @Nat.casesOn (fun _ => Submodule V X) k ⊥ (fun j => (NQ j).comap p)
  have hN0 : N 0 = ⊥ := rfl
  have hNs : ∀ j, N (j + 1) = (NQ j).comap p := fun j => rfl
  have hN1 : ∀ x, x ∈ N 1 ↔ ∃ u, σ (α u) = x := by
    intro x
    show x ∈ (NQ 0).comap p ↔ _
    rw [hNQ0, Submodule.comap_bot, LinearMap.mem_ker, hker]
  refine ⟨nQ + 1, N, hN0, ?_, ?_⟩
  · rw [hNs, hNQn, Submodule.comap_top]
  intro k hk
  rcases k with _ | j
  · refine ⟨bot_le, C, inferInstance, inferInstance, hsm, hne, hgeom, r,
      (N 0).mkQ ∘ₗ σ.toLinearMap ∘ₗ α, ?_, ?_⟩
    · refine Submodule.ext fun z => ?_
      constructor
      · rintro ⟨u, rfl⟩
        exact Submodule.mem_map.mpr ⟨σ (α u), (hN1 _).mpr ⟨u, rfl⟩, rfl⟩
      · intro hz
        obtain ⟨x', hx', rfl⟩ := Submodule.mem_map.mp hz
        obtain ⟨u, rfl⟩ := (hN1 x').mp hx'
        exact ⟨u, rfl⟩
    · intro u hu
      apply hα u
      have h1 := mpres (Submodule.quotEquivOfEqBot (N 0) hN0).toLinearMap _ hu
      have h1' : σ (α u) ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V X) := h1
      have h2 := mpres σ.symm.toLinearMap _ h1'
      rwa [LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] at h2
  · have hj : j < nQ := by omega
    obtain ⟨hleQ, Cj, iCj, iVCj, hsmj, hnej, hgeomj, rj, β, hβrange, hβinj⟩ := hstepQ j hj
    let pj : X →ₗ[V] (Q ⧸ NQ j) := (NQ j).mkQ ∘ₗ p
    have hpjsurj : Function.Surjective pj := (Submodule.mkQ_surjective _).comp hpsurj
    have hpjker : LinearMap.ker pj = N (j + 1) := by
      ext x
      rw [LinearMap.mem_ker, hNs, Submodule.mem_comap]
      exact Submodule.Quotient.mk_eq_zero _
    let ψ : (X ⧸ N (j + 1)) ≃ₗ[V] (Q ⧸ NQ j) :=
      (Submodule.quotEquivOfEq _ _ hpjker).symm ≪≫ₗ pj.quotKerEquivOfSurjective hpjsurj
    have hψ : ∀ x, ψ (Submodule.Quotient.mk x) = Submodule.Quotient.mk (p x) := by
      intro x
      rfl
    refine ⟨Submodule.comap_mono hleQ, Cj, iCj, iVCj, hsmj, hnej, hgeomj, rj,
      ψ.symm.toLinearMap ∘ₗ β, ?_, ?_⟩
    · refine Submodule.ext fun z => ?_
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      constructor
      · rintro ⟨u, hu⟩
        have h1 : ψ (Submodule.Quotient.mk x) ∈ LinearMap.range β := ⟨u, by
          rw [← hu, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]⟩
        rw [hβrange] at h1
        obtain ⟨t, ht, ht'⟩ := Submodule.mem_map.mp h1
        obtain ⟨x', rfl⟩ := hpsurj t
        refine Submodule.mem_map.mpr ⟨x', ?_, ?_⟩
        · rw [hNs]; exact ht
        · apply ψ.injective
          rw [Submodule.mkQ_apply, hψ]
          exact ht'
      · intro hz
        obtain ⟨x', hx', hx'eq⟩ := Submodule.mem_map.mp hz
        have h1 : ψ (Submodule.Quotient.mk x) ∈ LinearMap.range β := by
          rw [hβrange, ← hx'eq, Submodule.mkQ_apply, hψ]
          rw [hNs] at hx'
          exact Submodule.mem_map.mpr ⟨p x', hx', rfl⟩
        obtain ⟨u, hu⟩ := h1
        exact ⟨u, by rw [LinearMap.comp_apply, LinearEquiv.coe_coe, hu,
          LinearEquiv.symm_apply_apply]⟩
    · intro u hu
      apply hβinj u
      have h1 := mpres ψ.toLinearMap _ hu
      rwa [LinearEquiv.coe_coe, LinearMap.comp_apply, LinearEquiv.coe_coe,
        LinearEquiv.apply_symm_apply] at h1

theorem wcpa_pple_devissage : ∀ (V A : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V] [CommRing A] [IsDomain A] [Algebra V A], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) → Algebra.FinitePresentation V A → Module.Flat V A → ∀ 𝔭 : Ideal A, 𝔭.IsPrime → Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V) ≤ 𝔭 → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra V B) (_ : IsScalarTower V A B), Module.Flat A B ∧ Algebra.FinitePresentation A B ∧ (∃ 𝔮 : Ideal B, 𝔮.IsPrime ∧ Ideal.comap (algebraMap A B) 𝔮 = 𝔭) ∧ ∃ (n : ℕ) (N : ℕ → Submodule V B), N 0 = ⊥ ∧ N n = ⊤ ∧ ∀ k < n, N k ≤ N (k + 1) ∧ ∃ (C : Type u) (_ : CommRing C) (_ : Algebra V C), Algebra.Smooth V C ∧ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≠ ⊤ ∧ (∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L C) ∨ Subsingleton (TensorProduct V L C)) ∧ ∃ (r : ℕ) (α : (Fin r → C) →ₗ[V] (B ⧸ N k)), LinearMap.range α = (N (k + 1)).map (N k).mkQ ∧ ∀ u : Fin r → C, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (B ⧸ N k)) → u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → C)) :=
by
  intro V A _ _ _ _ _ _ _ hW hfp hflat 𝔭 h𝔭 hI
  classical

  have hP : ∀ d : ℕ, ∀ (R : Type u) [CommRing R] [Algebra V R], Algebra.FinitePresentation V R →
      ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M],
      Module.Finite R M → ∀ 𝔮 : Ideal R, 𝔮.IsPrime →
      Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ 𝔮 →
      ringKrullDim (R ⧸ (Module.annihilator R M ⊔
        Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V))) < ((d : ℕ) : WithBot ℕ∞) →
      wcpaDvConc V R M 𝔮 := by
    intro d
    induction d with
    | zero =>
      intro R _ _ hRfp M _ _ _ _ hM 𝔮 h𝔮 hm𝔮 hdim
      by_cases hJ : Module.annihilator R M ⊔
          Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ 𝔮
      · exfalso
        have hne : Module.annihilator R M ⊔
            Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≠ ⊤ := fun h =>
          h𝔮.ne_top (top_le_iff.mp (h ▸ hJ))
        haveI : Nontrivial (R ⧸ (Module.annihilator R M ⊔
            Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V))) :=
          Ideal.Quotient.nontrivial_iff.mpr hne
        have h0 := ringKrullDim_nonneg_of_nontrivial (R := R ⧸ (Module.annihilator R M ⊔
            Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V)))
        rw [Nat.cast_zero] at hdim
        exact (not_lt.mpr h0) hdim
      · exact wcpa_pple_dv_vanish V hW R hRfp M hM 𝔮 h𝔮 hm𝔮 hJ
    | succ d ih =>
      intro R _ _ hRfp M _ _ _ _ hM 𝔮 h𝔮 hm𝔮 hdim
      by_cases hJ : Module.annihilator R M ⊔
          Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ 𝔮
      · obtain ⟨R₁, iR₁, iRR₁, iVR₁, iT₁, C, iC, iVC, iCR₁, iT₂, hEt, hSm, hDom, hdimC, hfinM₁,
          𝔭₁, h𝔭₁, hcomap₁, helem₁, hmC, hfin, huniq, halg⟩ :=
          wcpa_pple_dv_local_structure V hW R hRfp M hM 𝔮 h𝔮 hJ d hdim
        haveI := hSm
        haveI := hfinM₁
        haveI := h𝔭₁
        obtain ⟨r, α, hinj, hdimQ⟩ := wcpa_pple_dv_generic_basis V C inferInstance hDom d hdimC
          (TensorProduct R R₁ M) hfinM₁
        have hQ := ih C inferInstance (TensorProduct R R₁ M ⧸ LinearMap.range α) inferInstance
          (𝔭₁.comap (algebraMap C R₁)) inferInstance hmC hdimQ
        unfold wcpaDvConc at hQ
        obtain ⟨C', iC', iCC', iVC', iT₃, hEtC, 𝔮', h𝔮', hcomap', helem', hcof'⟩ := hQ
        haveI := h𝔮'
        obtain ⟨c₀, hc₀, hgeom⟩ := wcpa_pple_dv_geom_nbhd V hW C hSm (𝔭₁.comap (algebraMap C R₁))
          hmC halg C' hEtC 𝔮' hcomap' helem'
        obtain ⟨R', iR', iRR', iVR', iT', hEt', 𝔭', h𝔭', hc', he', hcof⟩ :=
          wcpa_pple_dv_base_change V hW R hRfp M hM 𝔮 h𝔮 R₁ C hEt hSm 𝔭₁ hcomap₁ helem₁
            hmC hfin huniq r α hinj C' hEtC 𝔮' hcomap' helem' hcof' c₀ hc₀ hgeom
        refine ⟨R', iR', iRR', iVR', iT', hEt', 𝔭', h𝔭', hc', he', fun f hf => ?_⟩
        obtain ⟨g, hg, hfg, C'', iC'', iVC'', hSm'', hne'', hgeom'', r'', α'', hinj'', Q, iQ, iVQ,
          hQF, ⟨eQ⟩⟩ := hcof f hf
        refine ⟨g, hg, hfg, fun X _ _ hX => ?_⟩
        obtain ⟨eX⟩ := hX
        exact wcpa_pple_filt_extend V _ X eX C'' hSm'' hne'' hgeom'' r'' α'' hinj'' Q hQF eQ
      · exact wcpa_pple_dv_vanish V hW R hRfp M hM 𝔮 h𝔮 hm𝔮 hJ

  obtain ⟨d, hd⟩ : ∃ d : ℕ, ringKrullDim (A ⧸ (Module.annihilator A A ⊔
      Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V))) < ((d : ℕ) : WithBot ℕ∞) := by
    set J := Module.annihilator A A ⊔ Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V)
      with hJ
    obtain ⟨n, g, hg⟩ :=
      Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType V A)
    let ψ : MvPolynomial (Fin n) V →+* A ⧸ J := (Ideal.Quotient.mk J).comp g.toRingHom
    have hψ : Function.Surjective ψ := Ideal.Quotient.mk_surjective.comp hg
    have hker : ∀ a ∈ Ideal.map (MvPolynomial.C : V →+* MvPolynomial (Fin n) V)
        (IsLocalRing.maximalIdeal V), ψ a = 0 := by
      intro a ha
      have hle : Ideal.map (MvPolynomial.C : V →+* MvPolynomial (Fin n) V)
          (IsLocalRing.maximalIdeal V) ≤ RingHom.ker ψ := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker]
        show Ideal.Quotient.mk J (g (MvPolynomial.C b)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem, MvPolynomial.algHom_C]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hb)
      exact hle ha
    let ψ' : MvPolynomial (Fin n) (V ⧸ IsLocalRing.maximalIdeal V) →+* A ⧸ J :=
      (Ideal.Quotient.lift _ ψ hker).comp
        (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin n)
          (IsLocalRing.maximalIdeal V)).toRingEquiv.toRingHom
    have hψ' : Function.Surjective ψ' :=
      (Ideal.Quotient.lift_surjective_of_surjective _ hker hψ).comp
        (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin n)
          (IsLocalRing.maximalIdeal V)).surjective
    have h1 := ringKrullDim_le_of_surjective ψ' hψ'
    letI : Field (V ⧸ IsLocalRing.maximalIdeal V) := Ideal.Quotient.field _
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin] at h1
    refine ⟨n + 1, lt_of_le_of_lt h1 ?_⟩
    exact_mod_cast Nat.lt_succ_self n

  have hC := hP d A hfp A inferInstance 𝔭 h𝔭 hI hd
  unfold wcpaDvConc at hC
  obtain ⟨R', iR', iAR', iVR', iT, hEt, 𝔭', h𝔭', hcomap, -, hcof⟩ := hC
  haveI := hEt
  obtain ⟨g, hg, -, hFILT⟩ := hcof 1 h𝔭'.one_notMem
  have hdisj : Disjoint (Submonoid.powers g : Set R') (𝔭' : Set R') :=
    (Ideal.disjoint_powers_iff_notMem g h𝔭'.isRadical).mpr hg
  refine ⟨Localization.Away g, inferInstance, inferInstance, inferInstance, inferInstance,
    ?_, ?_, ?_, ?_⟩
  · exact Module.Flat.trans A R' (Localization.Away g)
  · exact Algebra.FinitePresentation.trans A R' (Localization.Away g)
  · refine ⟨Ideal.map (algebraMap R' (Localization.Away g)) 𝔭',
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g) _ 𝔭' h𝔭' hdisj, ?_⟩
    have h2 : Ideal.comap (algebraMap R' (Localization.Away g))
        (Ideal.map (algebraMap R' (Localization.Away g)) 𝔭') = 𝔭' :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g) (Localization.Away g)
        h𝔭' hdisj
    rw [IsScalarTower.algebraMap_eq A R' (Localization.Away g), ← Ideal.comap_comap, h2, hcomap]
  · exact hFILT (Localization.Away g)
      ⟨(TensorProduct.AlgebraTensorModule.rid A (Localization.Away g)
        (Localization.Away g)).restrictScalars V⟩

theorem wcpa_pnm_fibre_descent : ∀ (A V B : Type u) [CommRing A] [CommRing V] [Algebra A V] [CommRing B] [Algebra A B], Module.Flat A B → (∀ (L : Type u) [Field L] [Algebra V L] [Algebra A L] [IsScalarTower A V L], IsDomain (TensorProduct A L B)) → ∀ (P : Ideal V), P.IsPrime → ∀ (L : Type u) [Field L] [Algebra A L], RingHom.ker (algebraMap A L) = P.comap (algebraMap A V) → IsDomain (TensorProduct A L B) :=
by
  intro A V B _ _ _ _ _ hflat hyp P hP L _ _ hker
  classical
  have s1 : ∃ (L' : Type u) (_ : Field L') (_ : Algebra V L') (_ : Algebra A L')
      (_ : IsScalarTower A V L'), Nonempty (L →ₐ[A] L') := by
    have H : ∀ a ∈ P.comap (algebraMap A V), algebraMap A L a = 0 := fun a ha => by
      rw [← hker] at ha; exact ha
    let ψ : A ⧸ P.comap (algebraMap A V) →+* L :=
      Ideal.Quotient.lift (P.comap (algebraMap A V)) (algebraMap A L) H
    letI : Algebra (A ⧸ P.comap (algebraMap A V)) L := ψ.toAlgebra
    have hψinj : Function.Injective (algebraMap (A ⧸ P.comap (algebraMap A V)) L) :=
      (Ideal.injective_lift_iff H).mpr hker
    have hDinj : Function.Injective
        (algebraMap (A ⧸ P.comap (algebraMap A V)) (V ⧸ P)) :=
      Ideal.algebraMap_quotient_injective
    haveI : P.IsPrime := hP
    haveI : Nontrivial (TensorProduct (A ⧸ P.comap (algebraMap A V)) L (V ⧸ P)) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain
        (A ⧸ P.comap (algebraMap A V)) L (V ⧸ P) hψinj hDinj
    obtain ⟨M, hM⟩ :=
      Ideal.exists_maximal (TensorProduct (A ⧸ P.comap (algebraMap A V)) L (V ⧸ P))

    have gen : ∀ (K : Type u) [Field K]
        (q : TensorProduct (A ⧸ P.comap (algebraMap A V)) L (V ⧸ P) →+* K),
        ∃ (L' : Type u) (_ : Field L') (_ : Algebra V L') (_ : Algebra A L')
          (_ : IsScalarTower A V L'), Nonempty (L →ₐ[A] L') := by
      intro K _ q
      let fV : V →+* K :=
        (q.comp (Algebra.TensorProduct.includeRight :
          V ⧸ P →ₐ[A ⧸ P.comap (algebraMap A V)] _).toRingHom).comp (Ideal.Quotient.mk P)
      let fA : A →+* K := fV.comp (algebraMap A V)
      let φ₀ : L →+* K := q.comp Algebra.TensorProduct.includeLeftRingHom
      have hcomm : ∀ a : A, φ₀ (algebraMap A L a) = fA a := by
        intro a
        have e1 : algebraMap A L a = algebraMap (A ⧸ P.comap (algebraMap A V)) L
            (Ideal.Quotient.mk _ a) := rfl
        have e2 : fA a =
            q ((1 : L) ⊗ₜ algebraMap (A ⧸ P.comap (algebraMap A V)) (V ⧸ P)
              (Ideal.Quotient.mk _ a)) := rfl
        rw [e1, e2]
        show q (algebraMap (A ⧸ P.comap (algebraMap A V)) L (Ideal.Quotient.mk _ a) ⊗ₜ
          (1 : V ⧸ P)) = _
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one (A := V ⧸ P),
          TensorProduct.smul_tmul]
      letI iV : Algebra V K := fV.toAlgebra
      letI iA : Algebra A K := fA.toAlgebra
      exact ⟨K, inferInstance, iV, iA, IsScalarTower.of_algebraMap_eq (fun _ => rfl),
        ⟨{ φ₀ with commutes' := hcomm }⟩⟩
    letI : Field (TensorProduct (A ⧸ P.comap (algebraMap A V)) L (V ⧸ P) ⧸ M) :=
      Ideal.Quotient.field M
    exact gen _ (Ideal.Quotient.mk M)
  obtain ⟨L', iF, iV, iA, iT, ⟨φ⟩⟩ := s1
  haveI hdom' : IsDomain (TensorProduct A L' B) := hyp L'
  have hinj : Function.Injective φ := (φ : L →+* L').injective
  have hrT := Module.Flat.rTensor_preserves_injective_linearMap (M := B) φ.toLinearMap hinj
  let Φ := Algebra.TensorProduct.map φ (AlgHom.id A B)
  have heq : ∀ x, Φ x = LinearMap.rTensor B φ.toLinearMap x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul l b => simp [Φ]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hΦ : Function.Injective Φ.toRingHom := fun x y hxy =>
    hrT (by rw [← heq, ← heq]; exact hxy)
  exact Function.Injective.isDomain Φ.toRingHom hΦ

theorem wcpa_pgo_flat_generic_domain : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B], Module.Flat A B → IsDomain (TensorProduct A (FractionRing A) B) → IsDomain B ∧ Function.Injective (algebraMap A B) :=
by
  intro A B _ _ _ _ hflat hT
  haveI := hflat
  have hAK : Function.Injective (algebraMap A (FractionRing A)) :=
    IsFractionRing.injective A (FractionRing A)
  have h1 : Function.Injective (LinearMap.rTensor B (Algebra.linearMap A (FractionRing A))) :=
    Module.Flat.rTensor_preserves_injective_linearMap _ hAK
  have h2 : (⇑(Algebra.TensorProduct.includeRight :
      B →ₐ[A] TensorProduct A (FractionRing A) B)) =
      (LinearMap.rTensor B (Algebra.linearMap A (FractionRing A))) ∘
        (TensorProduct.lid A B).symm := by
    funext b
    simp
  have hι : Function.Injective (Algebra.TensorProduct.includeRight :
      B →ₐ[A] TensorProduct A (FractionRing A) B) := by
    rw [h2]
    exact h1.comp (TensorProduct.lid A B).symm.injective
  haveI hB : IsDomain B := Function.Injective.isDomain _ hι
  refine ⟨hB, ?_⟩
  have hg : Function.Injective (Algebra.TensorProduct.includeLeftRingHom :
      FractionRing A →+* TensorProduct A (FractionRing A) B) := RingHom.injective _
  have h3 : (⇑(Algebra.TensorProduct.includeRight :
      B →ₐ[A] TensorProduct A (FractionRing A) B)) ∘ (algebraMap A B) =
      (Algebra.TensorProduct.includeLeftRingHom :
        FractionRing A →+* TensorProduct A (FractionRing A) B) ∘
        (algebraMap A (FractionRing A)) := by
    funext a
    simp only [Function.comp_apply, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.includeLeftRingHom_apply]
    exact (Algebra.TensorProduct.tmul_one_eq_one_tmul a).symm
  have h4 : Function.Injective ((⇑(Algebra.TensorProduct.includeRight :
      B →ₐ[A] TensorProduct A (FractionRing A) B)) ∘ (algebraMap A B)) := by
    rw [h3]
    exact hg.comp hAK
  exact Function.Injective.of_comp h4

theorem wcpa_pgo_smooth_birational_model : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [IsDomain B] [Algebra A B], Algebra.Smooth A B → Function.Injective (algebraMap A B) → ∃ (r : ℕ) (P : Polynomial (MvPolynomial (Fin r) A)) (h : B) (s₀ : MvPolynomial (Fin r) A), P.Monic ∧ 0 < P.natDegree ∧ h ≠ 0 ∧ s₀ ≠ 0 ∧ Nonempty (Localization.Away h ≃ₐ[A] Localization.Away (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s₀))) :=
by

  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Nontrivial B] [Algebra A B], Algebra.Smooth A B → ∃ (x : B) (n : ℕ) (g : MvPolynomial (Fin n) A →+* Localization.Away x), x ≠ 0 ∧ g.comp MvPolynomial.C = algebraMap A (Localization.Away x) ∧ g.Etale := by
    intro A B _ _ _ _ hsm
    obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth A B
    have : ∃ x ∈ s, x ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      have hle : Ideal.span s ≤ ⊥ := by
        rw [Ideal.span_le]
        intro y hy
        rw [hcon y hy]
        exact (⊥ : Ideal B).zero_mem
      rw [hs] at hle
      exact one_ne_zero ((Submodule.eq_bot_iff _).mp (le_bot_iff.mp hle) 1 Submodule.mem_top)
    obtain ⟨x, hx, hx0⟩ := this
    have h1 := RingHom.isStandardSmooth_algebraMap.mpr (hstd x hx)
    obtain ⟨n, g, hg, hgE⟩ := h1.exists_etale_mvPolynomial
    exact ⟨x, n, g, hx0, hg, hgE⟩

  have s2 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [Nontrivial E] [Algebra R E], Algebra.Etale R E → Function.Injective (algebraMap R E) ∧ Module.Finite (FractionRing R) (TensorProduct R (FractionRing R) E) ∧ Algebra.FormallyUnramified (FractionRing R) (TensorProduct R (FractionRing R) E) ∧ Function.Injective (fun b : E => (1 : FractionRing R) ⊗ₜ[R] b) := by
    intro R E _ _ _ _ _ het
    haveI hflat : Module.Flat R E := inferInstance
    haveI htf : Module.IsTorsionFree R E := Module.Flat.isTorsionFree
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro r hr
      by_contra hr0
      have hreg : IsSMulRegular E r := Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hr0)
      apply one_ne_zero (α := E)
      apply hreg
      show r • (1 : E) = r • (0 : E)
      rw [Algebra.smul_def, hr, zero_mul, smul_zero]
    · haveI : Algebra.Etale (FractionRing R) (TensorProduct R (FractionRing R) E) :=
        Algebra.Etale.baseChange R E (FractionRing R)
      exact Algebra.FormallyUnramified.finite_of_free _ _
    · haveI : Algebra.Etale (FractionRing R) (TensorProduct R (FractionRing R) E) :=
        Algebra.Etale.baseChange R E (FractionRing R)
      infer_instance
    · have h1 : Function.Injective (LinearMap.rTensor E (Algebra.linearMap R (FractionRing R))) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ (IsFractionRing.injective R (FractionRing R))
      have h2 : (fun b : E => (1 : FractionRing R) ⊗ₜ[R] b) =
          (LinearMap.rTensor E (Algebra.linearMap R (FractionRing R))) ∘ (TensorProduct.lid R E).symm := by
        funext b
        simp
      rw [h2]
      exact h1.comp (TensorProduct.lid R E).symm.injective

  have s3 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [Algebra R E] (ω : TensorProduct R (FractionRing R) E), ∃ (c : R) (b : E), c ≠ 0 ∧ algebraMap R (FractionRing R) c • ω = (1 : FractionRing R) ⊗ₜ[R] b := by
    intro R E _ _ _ _ ω
    have key : ∀ (c : R) (b : E), algebraMap R (FractionRing R) c • ((1 : FractionRing R) ⊗ₜ[R] b) = (1 : FractionRing R) ⊗ₜ[R] (c • b) := by
      intro c b
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]
    induction ω using TensorProduct.induction_on with
    | zero => exact ⟨1, 0, one_ne_zero, by simp⟩
    | tmul k e =>
      obtain ⟨⟨a, c⟩, hac⟩ := IsLocalization.surj (nonZeroDivisors R) k
      refine ⟨c, a • e, nonZeroDivisors.ne_zero c.2, ?_⟩
      simp only at hac
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_comm, hac, ← TensorProduct.smul_tmul,
        Algebra.algebraMap_eq_smul_one]
    | add ω₁ ω₂ ih₁ ih₂ =>
      obtain ⟨c₁, b₁, hc₁, h₁⟩ := ih₁
      obtain ⟨c₂, b₂, hc₂, h₂⟩ := ih₂
      refine ⟨c₁ * c₂, c₂ • b₁ + c₁ • b₂, mul_ne_zero hc₁ hc₂, ?_⟩
      rw [smul_add, map_mul, mul_comm, mul_smul, h₁, mul_comm, mul_smul, h₂, key, key, TensorProduct.tmul_add]

  have s4 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [IsDomain E] [Algebra R E], Function.Injective (fun b : E => (1 : FractionRing R) ⊗ₜ[R] b) → (∀ ω : TensorProduct R (FractionRing R) E, ∃ (c : R) (b : E), c ≠ 0 ∧ algebraMap R (FractionRing R) c • ω = (1 : FractionRing R) ⊗ₜ[R] b) → IsDomain (TensorProduct R (FractionRing R) E) := by
    intro R E _ _ _ _ _ hj hclr
    haveI : Nontrivial (TensorProduct R (FractionRing R) E) := by
      refine ⟨⟨1, 0, fun h => ?_⟩⟩
      apply one_ne_zero (α := E)
      apply hj
      simp only
      rw [TensorProduct.tmul_zero]
      exact h
    haveI : NoZeroDivisors (TensorProduct R (FractionRing R) E) := by
      refine ⟨fun {ω₁ ω₂} h => ?_⟩
      obtain ⟨c₁, b₁, hc₁, h₁⟩ := hclr ω₁
      obtain ⟨c₂, b₂, hc₂, h₂⟩ := hclr ω₂
      have hk₁ : algebraMap R (FractionRing R) c₁ ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr hc₁
      have hk₂ : algebraMap R (FractionRing R) c₂ ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr hc₂
      have hb : (1 : FractionRing R) ⊗ₜ[R] (b₁ * b₂) = (1 : FractionRing R) ⊗ₜ[R] (0 : E) := by
        rw [TensorProduct.tmul_zero]
        have e : (1 : FractionRing R) ⊗ₜ[R] (b₁ * b₂) = ((1 : FractionRing R) ⊗ₜ[R] b₁) * ((1 : FractionRing R) ⊗ₜ[R] b₂) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        rw [e, ← h₁, ← h₂, smul_mul_smul_comm, h, smul_zero]
      have hb0 : b₁ * b₂ = 0 := hj hb
      rcases mul_eq_zero.mp hb0 with h0 | h0
      · left
        rw [h0, TensorProduct.tmul_zero] at h₁
        exact (smul_eq_zero.mp h₁).resolve_left hk₁
      · right
        rw [h0, TensorProduct.tmul_zero] at h₂
        exact (smul_eq_zero.mp h₂).resolve_left hk₂
    exact NoZeroDivisors.to_isDomain _

  have s5 : ∀ (K Ω : Type u) [Field K] [CommRing Ω] [IsDomain Ω] [Algebra K Ω], Module.Finite K Ω → Algebra.FormallyUnramified K Ω → ∃ α : Ω, ∀ ω : Ω, ∃ q : Polynomial K, Polynomial.aeval α q = ω := by
    intro K Ω _ _ _ _ hfin hunr
    letI := fieldOfFiniteDimensional K Ω
    haveI : Algebra.IsSeparable K Ω := Algebra.FormallyUnramified.isSeparable K Ω
    obtain ⟨α, hα⟩ := Field.exists_primitive_element K Ω
    refine ⟨α, fun ω => ?_⟩
    have halg : IsAlgebraic K α := (_root_.IsIntegral.of_finite K α).isAlgebraic
    have h1 : ω ∈ (IntermediateField.adjoin K {α}).toSubalgebra := by
      rw [hα, IntermediateField.top_toSubalgebra]; trivial
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic halg,
      Algebra.adjoin_singleton_eq_range_aeval] at h1
    obtain ⟨q, hq⟩ := h1
    exact ⟨q, hq⟩

  have s6 : ∀ (K Ω : Type u) [Field K] [CommRing Ω] [Algebra K Ω] (β : Ω), (∀ ω : Ω, ∃ q : Polynomial K, Polynomial.aeval β q = ω) → ∀ q : Polynomial K, q ≠ 0 → Polynomial.aeval β q = 0 → Module.finrank K Ω ≤ q.natDegree := by
    intro K Ω _ _ _ β hgen q hq0 hq
    set q' := q * Polynomial.C q.leadingCoeff⁻¹ with hq'def
    have hq'm : q'.Monic := Polynomial.monic_mul_leadingCoeff_inv hq0
    have hq'd : q'.natDegree = q.natDegree := Polynomial.natDegree_mul_leadingCoeff_inv q hq0
    have hq'0 : Polynomial.aeval β q' = 0 := by
      rw [hq'def, map_mul, hq, zero_mul]
    by_cases hd : q.natDegree = 0
    · have h1 : q' = 1 := Polynomial.eq_one_of_monic_natDegree_zero hq'm (by rw [hq'd, hd])
      rw [h1, map_one] at hq'0
      haveI : Subsingleton Ω := subsingleton_of_zero_eq_one hq'0.symm
      rw [Module.finrank_zero_of_subsingleton]
      exact Nat.zero_le _
    · have hne1 : q' ≠ 1 := by
        intro h1
        apply hd
        rw [← hq'd, h1, Polynomial.natDegree_one]
      have hspan : Submodule.span K (Set.range (fun i : Fin q.natDegree => β ^ (i : ℕ))) = ⊤ := by
        rw [eq_top_iff]
        rintro ω -
        obtain ⟨p, rfl⟩ := hgen ω
        have e1 : Polynomial.aeval β p = Polynomial.aeval β (p %ₘ q') := by
          conv_lhs => rw [← Polynomial.modByMonic_add_div p q']
          rw [map_add, map_mul, hq'0, zero_mul, add_zero]
        have hlt : (p %ₘ q').natDegree < q.natDegree := by
          rw [← hq'd]; exact Polynomial.natDegree_modByMonic_lt p hq'm hne1
        rw [e1, Polynomial.aeval_eq_sum_range' hlt, Finset.sum_range]
        refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
      calc Module.finrank K Ω = Module.finrank K (⊤ : Submodule K Ω) := (finrank_top K Ω).symm
        _ = Module.finrank K (Submodule.span K (Set.range (fun i : Fin q.natDegree => β ^ (i : ℕ)))) := by rw [hspan]
        _ ≤ Fintype.card (Fin q.natDegree) := finrank_range_le_card _
        _ = q.natDegree := Fintype.card_fin _

  have s7 : ∀ (K Ω : Type u) [Field K] [CommRing Ω] [Algebra K Ω] (α : Ω) (k : K), k ≠ 0 → (∀ ω : Ω, ∃ q : Polynomial K, Polynomial.aeval α q = ω) → ∀ ω : Ω, ∃ q : Polynomial K, Polynomial.aeval (k • α) q = ω := by
    intro K Ω _ _ _ α k hk hgen ω
    obtain ⟨q, rfl⟩ := hgen ω
    refine ⟨q.comp (Polynomial.C k⁻¹ * Polynomial.X), ?_⟩
    rw [Polynomial.aeval_comp]
    congr 1
    rw [map_mul, Polynomial.aeval_C, Polynomial.aeval_X, ← Algebra.smul_def, smul_smul, inv_mul_cancel₀ hk, one_smul]

  have s8 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [Algebra R E], Function.Injective (algebraMap R E) → Function.Injective (fun b : E => (1 : FractionRing R) ⊗ₜ[R] b) → Module.Finite (FractionRing R) (TensorProduct R (FractionRing R) E) → ∀ e₀ : E, ∃ (c : R) (P : Polynomial R), c ≠ 0 ∧ P.Monic ∧ P.natDegree ≤ Module.finrank (FractionRing R) (TensorProduct R (FractionRing R) E) ∧ Polynomial.aeval (algebraMap R E c * e₀) P = 0 := by
    intro R E _ _ _ _ hRE hj hfin e₀
    set K := FractionRing R
    set β₀ : TensorProduct R K E := (1 : K) ⊗ₜ[R] e₀ with hβ₀
    have hint : _root_.IsIntegral K β₀ := _root_.IsIntegral.of_finite K β₀
    set m := minpoly K β₀ with hm
    have hm0 : m ≠ 0 := minpoly.ne_zero hint
    have hmdeg : m.natDegree ≤ Module.finrank K (TensorProduct R K E) := minpoly.natDegree_le β₀
    set p₀ := IsLocalization.integerNormalization (nonZeroDivisors R) m with hp₀
    obtain ⟨b, hb, hbspec⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) m
    rw [← hp₀] at hbspec
    have hbK : algebraMap R K b ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr (nonZeroDivisors.ne_zero hb)
    have hbm : b • m = Polynomial.C (algebraMap R K b) * m := by
      rw [← algebraMap_smul K b m, Polynomial.smul_eq_C_mul]
    have hbm0 : b • m ≠ 0 := by
      rw [hbm]; exact mul_ne_zero (Polynomial.C_ne_zero.mpr hbK) hm0
    have hbmdeg : (b • m).natDegree = m.natDegree := by
      rw [hbm, Polynomial.natDegree_C_mul hbK]
    have hmapdeg : (Polynomial.map (algebraMap R K) p₀).natDegree = p₀.natDegree :=
      Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective R K) p₀
    have hp₀0 : p₀ ≠ 0 := by
      intro h
      apply hbm0
      rw [← hbspec, h, Polynomial.map_zero]
    have hp₀deg : p₀.natDegree = m.natDegree := by
      rw [← hmapdeg, hbspec, hbmdeg]
    have hp₀β : Polynomial.aeval β₀ p₀ = 0 :=
      IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors R) m (minpoly.aeval K β₀)
    have hp₀e : Polynomial.aeval e₀ p₀ = 0 := by
      apply hj
      simp only
      rw [TensorProduct.tmul_zero]
      have := Polynomial.aeval_algHom_apply
        (Algebra.TensorProduct.includeRight : E →ₐ[R] TensorProduct R K E) e₀ p₀
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeRight_apply] at this
      rw [← this]
      exact hp₀β
    refine ⟨p₀.leadingCoeff, p₀.integralNormalization, Polynomial.leadingCoeff_ne_zero.mpr hp₀0,
      Polynomial.monic_integralNormalization hp₀0, ?_, ?_⟩
    · rw [Polynomial.natDegree_integralNormalization, hp₀deg]; exact hmdeg
    · exact Polynomial.integralNormalization_aeval_eq_zero hp₀e
        (fun x hx => hRE (hx.trans (map_zero _).symm))

  have s9 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [IsDomain E] [Algebra R E], Function.Injective (fun b : E => (1 : FractionRing R) ⊗ₜ[R] b) → ∀ (e : E) (P : Polynomial R), P.Monic → P.natDegree ≤ Module.finrank (FractionRing R) (TensorProduct R (FractionRing R) E) → Polynomial.aeval e P = 0 → (∀ q : Polynomial (FractionRing R), q ≠ 0 → Polynomial.aeval ((1 : FractionRing R) ⊗ₜ[R] e) q = 0 → Module.finrank (FractionRing R) (TensorProduct R (FractionRing R) E) ≤ q.natDegree) → 0 < P.natDegree ∧ ∀ Q : Polynomial R, Polynomial.aeval e Q = 0 → P ∣ Q := by
    intro R E _ _ _ _ _ hj e P hPm hPd hPe hmin
    set K := FractionRing R
    have hpos : 0 < P.natDegree := by
      rcases Nat.eq_zero_or_pos P.natDegree with h | h
      · exfalso
        have h1 := Polynomial.eq_one_of_monic_natDegree_zero hPm h
        rw [h1, map_one] at hPe
        exact one_ne_zero hPe
      · exact h
    refine ⟨hpos, fun Q hQ => ?_⟩
    have hne1 : P ≠ 1 := by
      intro h; rw [h, Polynomial.natDegree_one] at hpos; exact lt_irrefl 0 hpos
    set Q₁ := Q %ₘ P with hQ₁
    have hQ₁e : Polynomial.aeval e Q₁ = 0 := by
      have := Polynomial.modByMonic_add_div Q P
      rw [← this, map_add, map_mul, hPe, zero_mul, add_zero] at hQ
      exact hQ
    have hlt : Q₁.natDegree < P.natDegree := Polynomial.natDegree_modByMonic_lt Q hPm hne1
    have hq : Polynomial.aeval ((1 : K) ⊗ₜ[R] e) (Polynomial.map (algebraMap R K) Q₁) = 0 := by
      rw [Polynomial.aeval_map_algebraMap]
      have := Polynomial.aeval_algHom_apply
        (Algebra.TensorProduct.includeRight : E →ₐ[R] TensorProduct R K E) e Q₁
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeRight_apply,
        hQ₁e, TensorProduct.tmul_zero] at this
      exact this
    have hq0 : Polynomial.map (algebraMap R K) Q₁ = 0 := by
      by_contra hne
      have h1 := hmin _ hne hq
      rw [Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective R K)] at h1
      omega
    have hQ₁0 : Q₁ = 0 := by
      apply Polynomial.map_injective _ (IsFractionRing.injective R K)
      rw [hq0, Polynomial.map_zero]
    exact (Polynomial.modByMonic_eq_zero_iff_dvd hPm).mp hQ₁0

  have s10 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [Algebra R E] (e : E), Function.Injective (fun b : E => (1 : FractionRing R) ⊗ₜ[R] b) → (∀ ω : TensorProduct R (FractionRing R) E, ∃ q : Polynomial (FractionRing R), Polynomial.aeval ((1 : FractionRing R) ⊗ₜ[R] e) q = ω) → ∀ b : E, ∃ (c : R) (Q : Polynomial R), c ≠ 0 ∧ algebraMap R E c * b = Polynomial.aeval e Q := by
    intro R E _ _ _ _ e hj hgen b
    set K := FractionRing R
    obtain ⟨q, hq⟩ := hgen ((1 : K) ⊗ₜ[R] b)
    obtain ⟨c, hc, hcspec⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) q
    refine ⟨c, IsLocalization.integerNormalization (nonZeroDivisors R) q, nonZeroDivisors.ne_zero hc, ?_⟩
    apply hj
    simp only
    have := Polynomial.aeval_algHom_apply
      (Algebra.TensorProduct.includeRight : E →ₐ[R] TensorProduct R K E) e
      (IsLocalization.integerNormalization (nonZeroDivisors R) q)
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeRight_apply] at this
    rw [← this, ← Polynomial.aeval_map_algebraMap K, hcspec, ← algebraMap_smul K c q, map_smul, hq,
      algebraMap_smul, ← TensorProduct.tmul_smul, Algebra.smul_def]

  have s11 : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] [Algebra R E], Algebra.FiniteType R E → ∀ e : E, (∀ b : E, ∃ (c : R) (Q : Polynomial R), c ≠ 0 ∧ algebraMap R E c * b = Polynomial.aeval e Q) → ∃ s₀ : R, s₀ ≠ 0 ∧ ∀ b : E, ∃ (k : ℕ) (Q : Polynomial R), Polynomial.aeval e Q = algebraMap R E s₀ ^ k * b := by
    intro R E _ _ _ _ hft e hden
    classical
    obtain ⟨t, ht⟩ := hft.out
    choose c Q hc hcQ using hden
    refine ⟨∏ i ∈ t, c i, Finset.prod_ne_zero_iff.mpr (fun i _ => hc i), fun b => ?_⟩
    have hb : b ∈ Algebra.adjoin R (t : Set E) := by rw [ht]; trivial
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨1, Polynomial.C (∏ i ∈ t.erase x, c i) * Q x, ?_⟩
      rw [map_mul, Polynomial.aeval_C, ← hcQ x, pow_one, ← Finset.prod_erase_mul t c hx, map_mul]
      ring
    | algebraMap r =>
      exact ⟨0, Polynomial.C r, by rw [Polynomial.aeval_C, pow_zero, one_mul]⟩
    | add x y _ _ hx hy =>
      obtain ⟨k₁, Q₁, h₁⟩ := hx
      obtain ⟨k₂, Q₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, Polynomial.C ((∏ i ∈ t, c i) ^ k₂) * Q₁ + Polynomial.C ((∏ i ∈ t, c i) ^ k₁) * Q₂, ?_⟩
      rw [map_add, map_mul, map_mul, Polynomial.aeval_C, Polynomial.aeval_C, h₁, h₂, map_pow, map_pow]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨k₁, Q₁, h₁⟩ := hx
      obtain ⟨k₂, Q₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, Q₁ * Q₂, ?_⟩
      rw [map_mul, h₁, h₂]
      ring

  have s12 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E] (e : E) (P : Polynomial R), Polynomial.aeval e P = 0 → (∀ Q : Polynomial R, Polynomial.aeval e Q = 0 → P ∣ Q) → ∃ ψ : (Polynomial R ⧸ Ideal.span {P}) →ₐ[R] E, Function.Injective ψ ∧ ∀ Q : Polynomial R, ψ (Ideal.Quotient.mk (Ideal.span {P}) Q) = Polynomial.aeval e Q := by
    intro R E _ _ _ e P hPe hdvd
    have H : ∀ a ∈ Ideal.span {P}, Polynomial.aeval e a = 0 := by
      intro a ha
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hPe, mul_zero]
    refine ⟨Ideal.Quotient.liftₐ (Ideal.span {P}) (Polynomial.aeval e) H, ?_, fun Q => ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hz' : Polynomial.aeval e Q = 0 := hz
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      exact hdvd Q hz'
    · rfl

  have s13 : ∀ (A R D E : Type u) [CommRing A] [CommRing R] [CommRing D] [CommRing E] [Algebra A R] [Algebra R D] [Algebra A D] [IsScalarTower A R D] [Algebra R E] [Algebra A E] [IsScalarTower A R E] (ψ : D →ₐ[R] E), Function.Injective ψ → ∀ d : D, (∀ b : E, ∃ (k : ℕ) (a : D), ψ a = ψ d ^ k * b) → Nonempty (Localization.Away (ψ d) ≃ₐ[A] Localization.Away d) := by
    intro A R D E _ _ _ _ _ _ _ _ _ _ _ ψ hψ d hsurj
    have hy : Submonoid.powers d ≤ Submonoid.comap (ψ : D →+* E) (Submonoid.powers (ψ d)) := by
      rintro _ ⟨k, rfl⟩
      exact ⟨k, by simp⟩
    let Φ : Localization.Away d →+* Localization.Away (ψ d) :=
      IsLocalization.map (Localization.Away (ψ d)) (ψ : D →+* E) hy
    have hΦinj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers d) z
      simp only at hz ⊢
      rw [IsLocalization.map_mk', IsLocalization.mk'_eq_zero_iff] at hz
      obtain ⟨⟨_, j, rfl⟩, hj⟩ := hz
      rw [IsLocalization.mk'_eq_zero_iff]
      refine ⟨⟨d ^ j, j, rfl⟩, ?_⟩
      apply hψ
      simp only at hj ⊢
      rw [map_mul, map_pow, map_zero]
      exact hj
    have hΦsurj : Function.Surjective Φ := by
      intro w
      obtain ⟨⟨b, ⟨_, k, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (ψ d)) w
      obtain ⟨j, a, ha⟩ := hsurj b
      refine ⟨IsLocalization.mk' (Localization.Away d) a (⟨d ^ (j + k), j + k, rfl⟩ : Submonoid.powers d), ?_⟩
      simp only
      rw [IsLocalization.map_mk', IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [RingHom.coe_coe, map_pow, ha]
      ring
    let Φe : Localization.Away d ≃+* Localization.Away (ψ d) := RingEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩
    refine ⟨(AlgEquiv.ofRingEquiv (f := Φe) ?_).symm⟩
    intro a
    show Φ (algebraMap A (Localization.Away d) a) = algebraMap A (Localization.Away (ψ d)) a
    rw [IsScalarTower.algebraMap_apply A D (Localization.Away d), IsLocalization.map_eq,
      IsScalarTower.algebraMap_apply A E (Localization.Away (ψ d))]
    congr 1
    rw [IsScalarTower.algebraMap_apply A R D, IsScalarTower.algebraMap_apply A R E]
    exact ψ.commutes _

  have s14 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsDomain B] [Algebra A B] (x : B) (y : Localization.Away x), x ≠ 0 → y ≠ 0 → ∃ h : B, h ≠ 0 ∧ Nonempty (Localization.Away h ≃ₐ[A] Localization.Away y) := by
    intro A B _ _ _ _ x y hx hy
    obtain ⟨n, b, hb⟩ := IsLocalization.Away.surj x y
    have hu : IsUnit (algebraMap B (Localization.Away x) x ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit x).pow n
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [map_zero, hu.mul_left_eq_zero] at hb
      exact hy hb
    have hassoc : Associated (algebraMap B (Localization.Away x) b) y := by
      rw [← hb]; exact associated_mul_unit_left y _ hu
    haveI : IsLocalization.Away (x * b) (Localization.Away y) :=
      IsLocalization.Away.mul_of_associated x b y hassoc
    refine ⟨x * b, mul_ne_zero hx hb0, ⟨?_⟩⟩
    exact (IsLocalization.algEquiv (Submonoid.powers (x * b)) (Localization.Away (x * b))
      (Localization.Away y)).restrictScalars A

  intro A B _ _ _ _ _ hsm _hAB
  classical
  obtain ⟨x, n, g, hx0, hgC, hgE⟩ := s1 A B hsm
  letI : Algebra (MvPolynomial (Fin n) A) (Localization.Away x) := g.toAlgebra
  haveI : IsScalarTower A (MvPolynomial (Fin n) A) (Localization.Away x) :=
    IsScalarTower.of_algebraMap_eq (fun a => by
      rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, ← RingHom.comp_apply, hgC])
  haveI hEt : Algebra.Etale (MvPolynomial (Fin n) A) (Localization.Away x) := RingHom.Etale.toAlgebra hgE
  haveI hEdom : IsDomain (Localization.Away x) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hx0)
  haveI hEft : Algebra.FiniteType (MvPolynomial (Fin n) A) (Localization.Away x) := inferInstance
  set R := MvPolynomial (Fin n) A
  set E := Localization.Away x
  set K := FractionRing R
  obtain ⟨hRE, hfin, hunr, hj⟩ := s2 R E hEt
  have hclr := s3 R E
  haveI hΩ : IsDomain (TensorProduct R K E) := s4 R E hj hclr
  obtain ⟨α, hα⟩ := s5 K (TensorProduct R K E) hfin hunr
  obtain ⟨c, e₀, hc, hce₀⟩ := hclr α
  have hcK : algebraMap R K c ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hc
  have hgen₀ : ∀ ω : TensorProduct R K E, ∃ q : Polynomial K, Polynomial.aeval ((1 : K) ⊗ₜ[R] e₀) q = ω := by
    rw [← hce₀]; exact s7 K _ α _ hcK hα
  obtain ⟨c', P, hc', hPm, hPd, hPe⟩ := s8 R E hRE hj hfin e₀
  set e := algebraMap R E c' * e₀ with he
  have hc'K : algebraMap R K c' ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hc'
  have h1e : (1 : K) ⊗ₜ[R] e = algebraMap R K c' • ((1 : K) ⊗ₜ[R] e₀) := by
    rw [he, ← Algebra.smul_def]
    symm
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
      Algebra.algebraMap_eq_smul_one]
  have hgen : ∀ ω : TensorProduct R K E, ∃ q : Polynomial K, Polynomial.aeval ((1 : K) ⊗ₜ[R] e) q = ω := by
    rw [h1e]; exact s7 K _ _ _ hc'K hgen₀
  have hmin := s6 K (TensorProduct R K E) _ hgen
  obtain ⟨hPpos, hdvd⟩ := s9 R E hj e P hPm hPd hPe hmin
  have hden := s10 R E e hj hgen
  obtain ⟨s₀, hs₀, hs₀spec⟩ := s11 R E hEft e hden
  obtain ⟨ψ, hψinj, hψ⟩ := s12 R E e P hPe hdvd
  have hψd : ψ (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s₀)) = algebraMap R E s₀ := by
    rw [hψ, Polynomial.aeval_C]
  obtain ⟨iso₁⟩ := s13 A R (Polynomial R ⧸ Ideal.span {P}) E ψ hψinj
    (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s₀)) (by
      intro b
      obtain ⟨k, Q, hQ⟩ := hs₀spec b
      exact ⟨k, Ideal.Quotient.mk (Ideal.span {P}) Q, by rw [hψ, hQ, hψd]⟩)
  have hy0 : ψ (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s₀)) ≠ 0 := by
    rw [hψd]; exact (map_ne_zero_iff _ hRE).mpr hs₀
  obtain ⟨h, hh0, ⟨iso₂⟩⟩ := s14 A B x _ hx0 hy0
  exact ⟨n, P, h, s₀, hPm, hPpos, hh0, hs₀, ⟨iso₂.trans iso₁⟩⟩

theorem wcpa_pgo_basechange_model : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (r : ℕ) (P : Polynomial (MvPolynomial (Fin r) A)) (h : B) (s₀ : MvPolynomial (Fin r) A), (Localization.Away h ≃ₐ[A] Localization.Away (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s₀))) → ∀ (L : Type u) [CommRing L] [Algebra A L], Nonempty (Localization.Away ((1 : L) ⊗ₜ[A] h) ≃+* Localization.Away (Ideal.Quotient.mk (Ideal.span {P.map (MvPolynomial.map (algebraMap A L))}) (Polynomial.C (MvPolynomial.map (algebraMap A L) s₀)))) :=
by
  classical

  have s3 : ∀ (A L S T : Type u) [CommRing A] [CommRing L] [Algebra A L] [CommRing S] [Algebra A S]
      [CommRing T] (θ : TensorProduct A L S ≃+* T) (p s : S) (p' s' : T),
      θ ((1 : L) ⊗ₜ[A] p) = p' → θ ((1 : L) ⊗ₜ[A] s) = s' →
      Nonempty (Localization.Away ((1 : L) ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span {p}) s)) ≃+*
        Localization.Away (Ideal.Quotient.mk (Ideal.span {p'}) s')) := by
    intro A L S T _ _ _ _ _ _ θ p s p' s' hp hs
    have hm : Function.Surjective
        (Algebra.TensorProduct.map (AlgHom.id A L) (Ideal.Quotient.mkₐ A (Ideal.span {p}))) :=
      Algebra.TensorProduct.map_surjective _ _ (fun x => ⟨x, rfl⟩) (Ideal.Quotient.mkₐ_surjective A _)
    have hk : RingHom.ker (Ideal.Quotient.mkₐ A (Ideal.span {p})) = Ideal.span {p} := by
      ext x
      rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    have hker : RingHom.ker
        (Algebra.TensorProduct.map (AlgHom.id A L) (Ideal.Quotient.mkₐ A (Ideal.span {p})))
        = Ideal.span {(1:L) ⊗ₜ[A] p} := by
      rw [Algebra.TensorProduct.lTensor_ker _ (Ideal.Quotient.mkₐ_surjective A _), hk,
        Ideal.map_span, Set.image_singleton, Algebra.TensorProduct.includeRight_apply]
    obtain ⟨κ, hκ⟩ : ∃ κ : (TensorProduct A L S ⧸ Ideal.span {(1:L) ⊗ₜ[A] p}) ≃+*
        TensorProduct A L (S ⧸ Ideal.span {p}),
        κ (Ideal.Quotient.mk _ ((1:L) ⊗ₜ[A] s)) =
          (1:L) ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span {p}) s) := by
      refine ⟨(Ideal.quotEquivOfEq hker.symm).trans
        (Ideal.quotientKerAlgEquivOfSurjective hm).toRingEquiv, ?_⟩
      rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
      erw [Ideal.quotientKerAlgEquivOfSurjective_apply, RingHom.kerLift_mk]
      all_goals first | rfl | exact hm
    have hJ : Ideal.span {p'} =
        Ideal.map (θ : TensorProduct A L S →+* T) (Ideal.span {(1:L) ⊗ₜ[A] p}) := by
      rw [Ideal.map_span, Set.image_singleton, RingEquiv.coe_toRingHom, hp]
    obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : TensorProduct A L (S ⧸ Ideal.span {p}) ≃+* T ⧸ Ideal.span {p'},
        Ψ ((1:L) ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span {p}) s)) = Ideal.Quotient.mk _ s' := by
      refine ⟨κ.symm.trans
        (Ideal.quotientEquiv (Ideal.span {(1:L) ⊗ₜ[A] p}) (Ideal.span {p'}) θ hJ), ?_⟩
      rw [RingEquiv.trans_apply, ← hκ, RingEquiv.symm_apply_apply, Ideal.quotientEquiv_mk, hs]
    refine ⟨IsLocalization.ringEquivOfRingEquiv
      (M := Submonoid.powers ((1:L) ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span {p}) s)))
      (T := Submonoid.powers (Ideal.Quotient.mk (Ideal.span {p'}) s'))
      (Localization.Away ((1 : L) ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span {p}) s)))
      (Localization.Away (Ideal.Quotient.mk (Ideal.span {p'}) s')) Ψ ?_⟩
    rw [Submonoid.map_powers]
    exact congrArg Submonoid.powers hΨ

  have s2 : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (r : ℕ),
      ∃ θ : TensorProduct A L (Polynomial (MvPolynomial (Fin r) A)) ≃+*
          Polynomial (MvPolynomial (Fin r) L),
        ∀ p : Polynomial (MvPolynomial (Fin r) A),
          θ ((1 : L) ⊗ₜ[A] p) = p.map (MvPolynomial.map (algebraMap A L)) := by
    intro A L _ _ _ r
    have hΦc : ∀ c : A, (Polynomial.mapRingHom (MvPolynomial.map (algebraMap A L)))
        (algebraMap A (Polynomial (MvPolynomial (Fin r) A)) c) =
          algebraMap A (Polynomial (MvPolynomial (Fin r) L)) c := by
      intro c
      rw [Polynomial.algebraMap_apply, Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq,
        MvPolynomial.algebraMap_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        MvPolynomial.map_C]
    let f₂ : Polynomial (MvPolynomial (Fin r) A) →ₐ[A] Polynomial (MvPolynomial (Fin r) L) :=
      AlgHom.mk (Polynomial.mapRingHom (MvPolynomial.map (algebraMap A L))) hΦc
    let f₁ : L →ₐ[A] Polynomial (MvPolynomial (Fin r) L) := IsScalarTower.toAlgHom A L _
    have hf₁ : ∀ l : L, f₁ l = Polynomial.C (MvPolynomial.C l) := by
      intro l
      show algebraMap L (Polynomial (MvPolynomial (Fin r) L)) l = _
      rw [Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
    have hf₂ : ∀ p, f₂ p = p.map (MvPolynomial.map (algebraMap A L)) := fun p => rfl
    obtain ⟨θ₀, hθ₀⟩ : ∃ θ₀ : TensorProduct A L (Polynomial (MvPolynomial (Fin r) A)) →+*
        Polynomial (MvPolynomial (Fin r) L),
        ∀ l p, θ₀ (l ⊗ₜ p) =
          Polynomial.C (MvPolynomial.C l) * p.map (MvPolynomial.map (algebraMap A L)) := by
      refine ⟨(Algebra.TensorProduct.productMap f₁ f₂).toRingHom, fun l p => ?_⟩
      show Algebra.TensorProduct.productMap f₁ f₂ (l ⊗ₜ p) = _
      rw [Algebra.TensorProduct.productMap_apply_tmul, hf₁, hf₂]
    obtain ⟨θ₁, hθ₁C, hθ₁X, hθ₁XX⟩ : ∃ θ₁ : Polynomial (MvPolynomial (Fin r) L) →+*
        TensorProduct A L (Polynomial (MvPolynomial (Fin r) A)),
        (∀ l : L, θ₁ (Polynomial.C (MvPolynomial.C l)) = l ⊗ₜ 1) ∧
        (∀ i, θ₁ (Polynomial.C (MvPolynomial.X i)) =
          (1:L) ⊗ₜ[A] (Polynomial.C (MvPolynomial.X i))) ∧
        θ₁ Polynomial.X = (1:L) ⊗ₜ[A] Polynomial.X := by
      refine ⟨Polynomial.eval₂RingHom (MvPolynomial.eval₂Hom
        (Algebra.TensorProduct.includeLeftRingHom :
          L →+* TensorProduct A L (Polynomial (MvPolynomial (Fin r) A)))
        (fun i : Fin r => (1:L) ⊗ₜ[A]
          (Polynomial.C (MvPolynomial.X i) : Polynomial (MvPolynomial (Fin r) A))))
        ((1:L) ⊗ₜ[A] (Polynomial.X : Polynomial (MvPolynomial (Fin r) A))), ?_, ?_, ?_⟩
      · intro l
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C]
        rfl
      · intro i
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, MvPolynomial.eval₂Hom_X']
      · rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have h1 : θ₀.comp θ₁ = RingHom.id _ := by
      have hC : (θ₀.comp θ₁).comp Polynomial.C =
          (Polynomial.C : MvPolynomial (Fin r) L →+* _) := by
        apply MvPolynomial.ringHom_ext
        · intro l
          rw [RingHom.comp_apply, RingHom.comp_apply, hθ₁C, hθ₀, Polynomial.map_one, mul_one]
        · intro i
          rw [RingHom.comp_apply, RingHom.comp_apply, hθ₁X, hθ₀, Polynomial.map_C,
            MvPolynomial.map_X, MvPolynomial.C_1, Polynomial.C_1, one_mul]
      apply Polynomial.ringHom_ext
      · intro a; exact RingHom.congr_fun hC a
      · rw [RingHom.comp_apply, hθ₁XX, hθ₀, Polynomial.map_X, MvPolynomial.C_1, Polynomial.C_1,
          one_mul, RingHom.id_apply]
    have hθ₁Φ : θ₁.comp (Polynomial.mapRingHom (MvPolynomial.map (algebraMap A L))) =
        Algebra.TensorProduct.includeRight.toRingHom := by
      have hC : (θ₁.comp (Polynomial.mapRingHom (MvPolynomial.map (algebraMap A L)))).comp
          Polynomial.C =
          (Algebra.TensorProduct.includeRight.toRingHom.comp Polynomial.C :
            MvPolynomial (Fin r) A →+* TensorProduct A L (Polynomial (MvPolynomial (Fin r) A))) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          show θ₁ ((Polynomial.C (MvPolynomial.C c)).map (MvPolynomial.map (algebraMap A L))) =
            (1:L) ⊗ₜ[A] (Polynomial.C (MvPolynomial.C c) : Polynomial (MvPolynomial (Fin r) A))
          rw [Polynomial.map_C, MvPolynomial.map_C, hθ₁C, Algebra.TensorProduct.tmul_one_eq_one_tmul,
            Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
        · intro i
          show θ₁ ((Polynomial.C (MvPolynomial.X i)).map (MvPolynomial.map (algebraMap A L))) =
            (1:L) ⊗ₜ[A] (Polynomial.C (MvPolynomial.X i) : Polynomial (MvPolynomial (Fin r) A))
          rw [Polynomial.map_C, MvPolynomial.map_X, hθ₁X]
      apply Polynomial.ringHom_ext
      · intro a; exact RingHom.congr_fun hC a
      · show θ₁ ((Polynomial.X : Polynomial (MvPolynomial (Fin r) A)).map
            (MvPolynomial.map (algebraMap A L))) =
            (1:L) ⊗ₜ[A] (Polynomial.X : Polynomial (MvPolynomial (Fin r) A))
        rw [Polynomial.map_X, hθ₁XX]
    have h2 : θ₁.comp θ₀ = RingHom.id _ := by
      apply RingHom.ext
      intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul l p =>
        rw [RingHom.comp_apply, hθ₀, map_mul, hθ₁C, RingHom.id_apply]
        have : θ₁ (p.map (MvPolynomial.map (algebraMap A L))) = (1:L) ⊗ₜ p :=
          RingHom.congr_fun hθ₁Φ p
        rw [this, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy =>
        rw [map_add, hx, hy, map_add]
    refine ⟨RingEquiv.ofRingHom θ₀ θ₁ h1 h2, ?_⟩
    intro p
    show θ₀ ((1:L) ⊗ₜ p) = _
    rw [hθ₀, MvPolynomial.C_1, Polynomial.C_1, one_mul]

  have s1 : ∀ (A B L : Type u) [CommRing A] [CommRing B] [Algebra A B] [CommRing L] [Algebra A L]
      (b : B), Nonempty (Localization.Away ((1 : L) ⊗ₜ[A] b) ≃+*
        TensorProduct A L (Localization.Away b)) := by
    intro A B L _ _ _ _ _ b
    let R := TensorProduct A L B
    let W := Localization.Away ((1 : L) ⊗ₜ[A] b)
    let Bb := Localization.Away b
    let Z := TensorProduct A L Bb
    let g : R →ₐ[A] Z := Algebra.TensorProduct.map (AlgHom.id A L) (IsScalarTower.toAlgHom A B Bb)
    have hg : ∀ (l : L) (x : B), g (l ⊗ₜ x) = l ⊗ₜ (algebraMap B Bb x) := fun l x => rfl
    have hunit : ∀ y : Submonoid.powers ((1 : L) ⊗ₜ[A] b), IsUnit (g y) := by
      rintro ⟨y, n, rfl⟩
      rw [map_pow]
      apply IsUnit.pow
      rw [hg]
      refine ⟨⟨(1:L) ⊗ₜ algebraMap B Bb b, (1:L) ⊗ₜ IsLocalization.Away.invSelf b, ?_, ?_⟩, rfl⟩
      · rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, IsLocalization.Away.mul_invSelf]; rfl
      · rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm,
          IsLocalization.Away.mul_invSelf]; rfl
    let F : W →ₐ[A] Z := IsLocalization.liftAlgHom (M := Submonoid.powers ((1 : L) ⊗ₜ[A] b)) hunit
    have hF : ∀ z : R, F (algebraMap R W z) = g z := by
      intro z
      simp only [F, IsLocalization.liftAlgHom_apply]
      exact IsLocalization.lift_eq _ z
    let ι : R →ₐ[A] W := IsScalarTower.toAlgHom A R W
    have hιb : IsUnit (ι ((1:L) ⊗ₜ[A] b)) := IsLocalization.Away.algebraMap_isUnit _
    let f₂ : B →ₐ[A] W := ι.comp Algebra.TensorProduct.includeRight
    have hf₂ : ∀ y : Submonoid.powers b, IsUnit (f₂ y) := by
      rintro ⟨y, n, rfl⟩
      rw [map_pow]
      exact hιb.pow n
    let g₂ : Bb →ₐ[A] W := IsLocalization.liftAlgHom (M := Submonoid.powers b) hf₂
    have hg₂ : ∀ x : B, g₂ (algebraMap B Bb x) = ι ((1:L) ⊗ₜ x) := by
      intro x
      simp only [g₂, IsLocalization.liftAlgHom_apply]
      exact IsLocalization.lift_eq _ x
    let g₁ : L →ₐ[A] W := ι.comp Algebra.TensorProduct.includeLeft
    let G : Z →ₐ[A] W := Algebra.TensorProduct.productMap g₁ g₂
    have hG : ∀ (l : L) (y : Bb), G (l ⊗ₜ y) = ι (l ⊗ₜ 1) * g₂ y := fun l y => by
      simp only [G]; rfl
    have hFg₂ : F.comp g₂ = Algebra.TensorProduct.includeRight := by
      apply IsLocalization.algHom_ext (Submonoid.powers b)
      ext x
      simp only [AlgHom.comp_apply]
      show F (g₂ (algebraMap B Bb x)) = Algebra.TensorProduct.includeRight (algebraMap B Bb x)
      rw [hg₂]
      show F (algebraMap R W ((1:L) ⊗ₜ x)) = _
      rw [hF, hg]
      rfl
    have h1 : F.comp G = AlgHom.id A Z := by
      apply Algebra.TensorProduct.ext'
      intro l y
      simp only [AlgHom.comp_apply]
      rw [hG, map_mul]
      have e1 : F (ι (l ⊗ₜ 1)) = l ⊗ₜ 1 := by
        show F (algebraMap R W (l ⊗ₜ 1)) = _
        rw [hF, hg, map_one]
      have e2 : F (g₂ y) = (1:L) ⊗ₜ y := by
        rw [← AlgHom.comp_apply, hFg₂]; rfl
      rw [e1, e2, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rfl
    have h2 : G.comp F = AlgHom.id A W := by
      apply IsLocalization.algHom_ext (Submonoid.powers ((1 : L) ⊗ₜ[A] b))
      apply Algebra.TensorProduct.ext'
      intro l x
      simp only [AlgHom.comp_apply, AlgHom.id_apply]
      show G (F (algebraMap R W (l ⊗ₜ x))) = algebraMap R W (l ⊗ₜ x)
      rw [hF, hg, hG, hg₂, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rfl
    exact ⟨(AlgEquiv.ofAlgHom F G h1 h2).toRingEquiv⟩

  intro A B _ _ _ r P h s₀ e L _ _
  obtain ⟨e₁⟩ := s1 A B L h
  have e₂ := (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[A] L) e).toRingEquiv
  obtain ⟨e₃⟩ := s1 A (Polynomial (MvPolynomial (Fin r) A) ⧸ Ideal.span {P}) L
    (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s₀))
  obtain ⟨θ, hθ⟩ := s2 A L r
  obtain ⟨e₄⟩ := s3 A L (Polynomial (MvPolynomial (Fin r) A)) (Polynomial (MvPolynomial (Fin r) L))
    θ P (Polynomial.C s₀) (P.map (MvPolynomial.map (algebraMap A L)))
    (Polynomial.C (MvPolynomial.map (algebraMap A L) s₀)) (hθ P) (by rw [hθ, Polynomial.map_C])
  exact ⟨e₁.trans (e₂.trans (e₃.symm.trans e₄))⟩

theorem wcpa_pgo_irreducible_of_domain : ∀ (E : Type u) [Field E] (r : ℕ) (P : Polynomial (MvPolynomial (Fin r) E)) (s : MvPolynomial (Fin r) E), P.Monic → 0 < P.natDegree → s ≠ 0 → IsDomain (Localization.Away (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s))) → Irreducible P :=
by
  intro E _ r P s hPm _ hs hdom

  have hgen : ∀ {A : Type u} [CommRing A] (p c : A), (∀ f : A, p ∣ c * f → p ∣ f) →
      Submonoid.powers (Ideal.Quotient.mk (Ideal.span {p}) c) ≤
        nonZeroDivisors (A ⧸ Ideal.span {p}) := by
    intro A _ p c hdvd
    have hnzd : ∀ y : A ⧸ Ideal.span {p}, Ideal.Quotient.mk (Ideal.span {p}) c * y = 0 → y = 0 := by
      intro y hy
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hy
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      exact hdvd f hy
    have hmem : Ideal.Quotient.mk (Ideal.span {p}) c ∈ nonZeroDivisors (A ⧸ Ideal.span {p}) := by
      rw [mem_nonZeroDivisors_iff]
      exact ⟨fun y hy => hnzd y hy, fun y hy => hnzd y ((mul_comm _ y).trans hy)⟩
    exact (Submonoid.powers_le (P := nonZeroDivisors _)).mpr hmem
  have hdvd : ∀ f : Polynomial (MvPolynomial (Fin r) E), P ∣ Polynomial.C s * f → P ∣ f := by
    intro f hf
    have hsplit := Polynomial.modByMonic_add_div f P
    have h1 : P ∣ Polynomial.C s * (f %ₘ P) := by
      have e : Polynomial.C s * (f %ₘ P) = Polynomial.C s * f - P * (Polynomial.C s * (f /ₘ P)) := by
        calc Polynomial.C s * (f %ₘ P)
            = Polynomial.C s * (f %ₘ P + P * (f /ₘ P)) - P * (Polynomial.C s * (f /ₘ P)) := by ring
          _ = Polynomial.C s * f - P * (Polynomial.C s * (f /ₘ P)) := by rw [hsplit]
      rw [e]
      exact dvd_sub hf (dvd_mul_right _ _)
    have hdeg : (Polynomial.C s * (f %ₘ P)).degree < P.degree := by
      rw [Polynomial.degree_C_mul hs]
      exact Polynomial.degree_modByMonic_lt f hPm
    have h2 := Polynomial.eq_zero_of_dvd_of_degree_lt h1 hdeg
    have hCs : (Polynomial.C s : Polynomial (MvPolynomial (Fin r) E)) ≠ 0 :=
      Polynomial.C_ne_zero.mpr hs
    have h3 : f %ₘ P = 0 := (mul_eq_zero.mp h2).resolve_left hCs
    exact (Polynomial.modByMonic_eq_zero_iff_dvd hPm).mp h3
  have hle := hgen P (Polynomial.C s) hdvd
  have hQ : IsDomain (Polynomial (MvPolynomial (Fin r) E) ⧸ Ideal.span {P}) :=
    Function.Injective.isDomain
      (algebraMap _ (Localization.Away (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s))))
      (IsLocalization.injective
        (Localization.Away (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s))) hle)
  have hprime : (Ideal.span {P}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hQ
  have hP0 : P ≠ 0 := hPm.ne_zero
  exact ((Ideal.span_singleton_prime hP0).mp hprime).irreducible

theorem wcpa_pgo_domain_of_irreducible : ∀ (E : Type u) [Field E] (r : ℕ) (P : Polynomial (MvPolynomial (Fin r) E)) (s : MvPolynomial (Fin r) E), P.Monic → 0 < P.natDegree → Irreducible P → s ≠ 0 → IsDomain (Localization.Away (Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s))) :=
by
  intro E _ r P s hPm hPd hPirr hs
  have hPprime : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp hPirr
  haveI hI : (Ideal.span {P}).IsPrime :=
    (Ideal.span_singleton_prime hPprime.ne_zero).mpr hPprime
  haveI : IsDomain (Polynomial (MvPolynomial (Fin r) E) ⧸ Ideal.span {P}) :=
    Ideal.Quotient.isDomain _
  have hc : Ideal.Quotient.mk (Ideal.span {P}) (Polynomial.C s) ≠ 0 := by
    intro h0
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h0
    have hCs : (Polynomial.C s) ≠ 0 := Polynomial.C_ne_zero.mpr hs
    exact hPm.not_dvd_of_natDegree_lt hCs (by rw [Polynomial.natDegree_C]; exact hPd) h0
  have key : ∀ (Q : Type u) [CommRing Q] [IsDomain Q] (c : Q), c ≠ 0 →
      IsDomain (Localization.Away c) :=
    fun Q _ _ c hc => IsLocalization.isDomain_localization
      (powers_le_nonZeroDivisors_of_noZeroDivisors hc)
  exact key _ _ hc

theorem wcpa_pgo_bertini_noether : ∀ (A : Type u) [CommRing A] [IsDomain A] (r : ℕ) (P : Polynomial (MvPolynomial (Fin r) A)), P.Monic → 0 < P.natDegree → Irreducible (P.map (MvPolynomial.map (algebraMap A (AlgebraicClosure (FractionRing A))))) → ∃ f : A, f ≠ 0 ∧ ∀ (κ : Type u) [Field κ] [Algebra A κ], algebraMap A κ f ≠ 0 → Irreducible (P.map (MvPolynomial.map (algebraMap A κ))) :=
by

  have s1 : ∀ (R : Type u) [CommRing R] [IsDomain R] (r : ℕ)
      (Q₁ Q₂ : Polynomial (MvPolynomial (Fin r) R)), Q₁ ≠ 0 → Q₂ ≠ 0 →
      ∀ (k : ℕ) (m : Fin r →₀ ℕ), (Q₁.coeff k).coeff m ≠ 0 →
      k + (m.sum fun _ e => e) ≤ ((MvPolynomial.finSuccEquiv R r).symm (Q₁ * Q₂)).totalDegree := by
    intro R _ _ r Q₁ Q₂ h1 h2 k m hk
    have hF1 : (MvPolynomial.finSuccEquiv R r).symm Q₁ ≠ 0 :=
      (map_ne_zero_iff _ (MvPolynomial.finSuccEquiv R r).symm.injective).mpr h1
    have hF2 : (MvPolynomial.finSuccEquiv R r).symm Q₂ ≠ 0 :=
      (map_ne_zero_iff _ (MvPolynomial.finSuccEquiv R r).symm.injective).mpr h2
    rw [map_mul, MvPolynomial.totalDegree_mul_of_isDomain hF1 hF2]
    have hc : ((MvPolynomial.finSuccEquiv R r).symm Q₁).coeff (Finsupp.cons k m) =
        (Q₁.coeff k).coeff m := by
      rw [← MvPolynomial.finSuccEquiv_coeff_coeff, AlgEquiv.apply_symm_apply]
    have hs : Finsupp.cons k m ∈ ((MvPolynomial.finSuccEquiv R r).symm Q₁).support := by
      rw [MvPolynomial.mem_support_iff, hc]; exact hk
    have := MvPolynomial.le_totalDegree hs
    rw [Finsupp.sum_cons] at this
    omega

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S) (r : ℕ)
      (P : Polynomial (MvPolynomial (Fin r) R)),
      ((MvPolynomial.finSuccEquiv S r).symm (P.map (MvPolynomial.map φ))).totalDegree ≤
        ((MvPolynomial.finSuccEquiv R r).symm P).totalDegree := by
    intro R S _ _ φ r P
    have hc : ∀ (T : Type u) [CommRing T] (Q : Polynomial (MvPolynomial (Fin r) T)) (k : ℕ)
        (m : Fin r →₀ ℕ), ((MvPolynomial.finSuccEquiv T r).symm Q).coeff (Finsupp.cons k m) =
          (Q.coeff k).coeff m := by
      intro T _ Q k m
      rw [← MvPolynomial.finSuccEquiv_coeff_coeff, AlgEquiv.apply_symm_apply]
    have hsub : ((MvPolynomial.finSuccEquiv S r).symm (P.map (MvPolynomial.map φ))).support ⊆
        ((MvPolynomial.finSuccEquiv R r).symm P).support := by
      intro s hs
      have e1 := hc S (P.map (MvPolynomial.map φ)) (s 0) s.tail
      have e2 := hc R P (s 0) s.tail
      rw [Finsupp.cons_tail] at e1 e2
      rw [MvPolynomial.mem_support_iff] at hs ⊢
      rw [e1] at hs
      rw [e2]
      intro h0
      apply hs
      rw [Polynomial.coeff_map, MvPolynomial.coeff_map, h0, map_zero]
    unfold MvPolynomial.totalDegree
    exact Finset.sup_mono hsub

  have s4 : ∀ (A : Type u) [CommRing A] [IsDomain A] (C : Type u) [CommRing C] [Algebra A C],
      Algebra.FiniteType A C → IsEmpty (C →ₐ[A] AlgebraicClosure (FractionRing A)) →
      ∃ f : A, f ≠ 0 ∧ algebraMap A C f = 0 := by
    intro A _ _ C _ _ hft hE
    classical
    by_contra hcon
    push_neg at hcon
    have hloc : IsLocalization (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))
        (TensorProduct A C (FractionRing A)) :=
      IsLocalization.tensor (FractionRing A) (nonZeroDivisors A)
    have : Nontrivial (TensorProduct A C (FractionRing A)) := by
      by_contra hnt
      rw [not_nontrivial_iff_subsingleton] at hnt
      have h1 : algebraMap C (TensorProduct A C (FractionRing A)) 1 = 0 := Subsingleton.elim _ _
      obtain ⟨⟨m, hm⟩, hm1⟩ := (IsLocalization.map_eq_zero_iff
        (Algebra.algebraMapSubmonoid C (nonZeroDivisors A))
        (TensorProduct A C (FractionRing A)) 1).mp h1
      obtain ⟨a, ha, rfl⟩ := hm
      simp only [mul_one] at hm1
      exact hcon a (nonZeroDivisors.ne_zero ha) hm1
    have : Nontrivial (TensorProduct A (FractionRing A) C) :=
      (Algebra.TensorProduct.comm A C (FractionRing A)).injective.nontrivial
    have : Algebra.FiniteType (FractionRing A) (TensorProduct A (FractionRing A) C) :=
      inferInstance
    obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal (TensorProduct A (FractionRing A) C)
    letI : Field (TensorProduct A (FractionRing A) C ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have : Algebra.FiniteType (FractionRing A) (TensorProduct A (FractionRing A) C ⧸ 𝔪) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ (FractionRing A) 𝔪)
        (Ideal.Quotient.mkₐ_surjective (FractionRing A) 𝔪)
    have : Module.Finite (FractionRing A) (TensorProduct A (FractionRing A) C ⧸ 𝔪) :=
      finite_of_finite_type_of_isJacobsonRing (FractionRing A) _
    have : Algebra.IsAlgebraic (FractionRing A) (TensorProduct A (FractionRing A) C ⧸ 𝔪) :=
      Algebra.IsAlgebraic.of_finite _ _
    have : Module.IsTorsionFree (FractionRing A) (TensorProduct A (FractionRing A) C ⧸ 𝔪) :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr
        (algebraMap (FractionRing A) (TensorProduct A (FractionRing A) C ⧸ 𝔪)).injective
    let ι : (TensorProduct A (FractionRing A) C ⧸ 𝔪) →ₐ[FractionRing A]
        AlgebraicClosure (FractionRing A) := IsAlgClosed.lift
    let γ : C →ₐ[A] AlgebraicClosure (FractionRing A) :=
      (ι.restrictScalars A).comp (((Ideal.Quotient.mkₐ (FractionRing A) 𝔪).restrictScalars A).comp
        Algebra.TensorProduct.includeRight)
    exact hE.false γ

  have s3 : ∀ (A : Type u) [CommRing A] (r : ℕ) (P : Polynomial (MvPolynomial (Fin r) A))
      (e₁ e₂ N : ℕ),
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Algebra.FiniteType A C ∧
      (∀ (S : Type u) [CommRing S] [Algebra A S] (Q₁ Q₂ : Polynomial (MvPolynomial (Fin r) S)),
        Q₁.Monic → Q₂.Monic → Q₁.natDegree = e₁ → Q₂.natDegree = e₂ →
        (∀ (k : ℕ) (m : Fin r →₀ ℕ), (Q₁.coeff k).coeff m ≠ 0 → k + (m.sum fun _ e => e) ≤ N) →
        (∀ (k : ℕ) (m : Fin r →₀ ℕ), (Q₂.coeff k).coeff m ≠ 0 → k + (m.sum fun _ e => e) ≤ N) →
        Q₁ * Q₂ = P.map (MvPolynomial.map (algebraMap A S)) → Nonempty (C →ₐ[A] S)) ∧
      (∀ (S : Type u) [CommRing S] [Nontrivial S] [Algebra A S], Nonempty (C →ₐ[A] S) →
        ∃ Q₁ Q₂ : Polynomial (MvPolynomial (Fin r) S), Q₁.Monic ∧ Q₂.Monic ∧
          Q₁.natDegree = e₁ ∧ Q₂.natDegree = e₂ ∧
          Q₁ * Q₂ = P.map (MvPolynomial.map (algebraMap A S))) := by
    intro A _ r P e₁ e₂ N
    classical
    have hfac_map : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (e : ℕ)
        (B : Finset (Fin r →₀ ℕ)) (a : Fin e → B → R),
        (wcpaBnFac r e B a).map (MvPolynomial.map f) =
          wcpaBnFac r e B (fun k m => f (a k m)) := by
      intro R S _ _ f e B a
      simp [wcpaBnFac, Polynomial.map_sum, MvPolynomial.map_monomial]
    have hfac_eq : ∀ {S : Type u} [CommRing S] (e : ℕ) (B : Finset (Fin r →₀ ℕ))
        (Q : Polynomial (MvPolynomial (Fin r) S)),
        Q.Monic → Q.natDegree = e → (∀ k m, (Q.coeff k).coeff m ≠ 0 → m ∈ B) →
        wcpaBnFac r e B (fun k m => (Q.coeff k).coeff (m : Fin r →₀ ℕ)) = Q := by
      intro S _ e B Q hQ hQd hQB
      conv_rhs => rw [hQ.as_sum, hQd]
      unfold wcpaBnFac
      congr 1
      rw [← Fin.sum_univ_eq_sum_range (fun i => Polynomial.C (Q.coeff i) * Polynomial.X ^ i) e]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      congr 2
      rw [Finset.sum_coe_sort B (fun m => MvPolynomial.monomial m ((Q.coeff k).coeff m))]
      conv_rhs => rw [MvPolynomial.as_sum (Q.coeff k)]
      symm
      apply Finset.sum_subset
      · intro m hm
        exact hQB k m (MvPolynomial.mem_support_iff.mp hm)
      · intro m _ hm
        rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
    have hfac_monic : ∀ {S : Type u} [CommRing S] (e : ℕ) (B : Finset (Fin r →₀ ℕ))
        (a : Fin e → B → S), (wcpaBnFac r e B a).Monic :=
      fun e B a => Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
    have hfac_deg : ∀ {S : Type u} [CommRing S] [Nontrivial S] (e : ℕ)
        (B : Finset (Fin r →₀ ℕ)) (a : Fin e → B → S), (wcpaBnFac r e B a).natDegree = e := by
      intro S _ _ e B a
      unfold wcpaBnFac
      rw [Polynomial.natDegree_add_eq_left_of_degree_lt, Polynomial.natDegree_X_pow]
      rw [Polynomial.degree_X_pow]
      exact Polynomial.degree_sum_fin_lt _
    have hcoef : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
        (D : Polynomial (MvPolynomial (Fin r) R)) (k : ℕ) (m : Fin r →₀ ℕ),
        ((D.map (MvPolynomial.map f)).coeff k).coeff m = f ((D.coeff k).coeff m) := by
      intro R S _ _ f D k m
      rw [Polynomial.coeff_map, MvPolynomial.coeff_map]
    let B : Finset (Fin r →₀ ℕ) := Finset.Iic (Finsupp.equivFunOnFinite.symm fun _ => N)
    have hB : ∀ (k : ℕ) (m : Fin r →₀ ℕ), k + (m.sum fun _ e => e) ≤ N → m ∈ B := by
      intro k m h
      show m ∈ Finset.Iic (Finsupp.equivFunOnFinite.symm fun _ => N)
      rw [Finset.mem_Iic, Finsupp.le_def]
      intro i
      rw [Finsupp.equivFunOnFinite_symm_apply_apply]
      have : m i ≤ m.sum fun _ e => e := by
        by_cases hi : i ∈ m.support
        · unfold Finsupp.sum
          exact Finset.single_le_sum (f := fun j => m j) (fun j _ => Nat.zero_le _) hi
        · rw [Finsupp.notMem_support_iff.mp hi]; exact Nat.zero_le _
      omega
    let ι := (Fin e₁ × B) ⊕ (Fin e₂ × B)
    let U₁ : Polynomial (MvPolynomial (Fin r) (MvPolynomial ι A)) :=
      wcpaBnFac r e₁ B (fun k m => MvPolynomial.X (Sum.inl (k, m)))
    let U₂ : Polynomial (MvPolynomial (Fin r) (MvPolynomial ι A)) :=
      wcpaBnFac r e₂ B (fun k m => MvPolynomial.X (Sum.inr (k, m)))
    let D := U₁ * U₂ - P.map (MvPolynomial.map (algebraMap A (MvPolynomial ι A)))
    let I : Ideal (MvPolynomial ι A) :=
      Ideal.span (Set.range fun km : ℕ × (Fin r →₀ ℕ) => (D.coeff km.1).coeff km.2)
    have key : ∀ (S : Type u) [CommRing S] [Algebra A S] (ψ : MvPolynomial ι A →ₐ[A] S),
        (∀ a ∈ I, ψ a = 0) ↔
          wcpaBnFac r e₁ B (fun k m => ψ (MvPolynomial.X (Sum.inl (k, m)))) *
            wcpaBnFac r e₂ B (fun k m => ψ (MvPolynomial.X (Sum.inr (k, m)))) =
            P.map (MvPolynomial.map (algebraMap A S)) := by
      intro S _ _ ψ
      have hD : D.map (MvPolynomial.map (ψ : MvPolynomial ι A →+* S)) =
          wcpaBnFac r e₁ B (fun k m => ψ (MvPolynomial.X (Sum.inl (k, m)))) *
            wcpaBnFac r e₂ B (fun k m => ψ (MvPolynomial.X (Sum.inr (k, m)))) -
            P.map (MvPolynomial.map (algebraMap A S)) := by
        have hcomp : (MvPolynomial.map (ψ : MvPolynomial ι A →+* S)).comp
            (MvPolynomial.map (algebraMap A (MvPolynomial ι A))) =
            (MvPolynomial.map (algebraMap A S) :
              MvPolynomial (Fin r) A →+* MvPolynomial (Fin r) S) := by
          refine RingHom.ext fun p => ?_
          rw [RingHom.comp_apply, MvPolynomial.map_map, AlgHom.comp_algebraMap]
        simp only [D, U₁, U₂, Polynomial.map_sub, Polynomial.map_mul, hfac_map,
          Polynomial.map_map, hcomp, RingHom.coe_coe]
      constructor
      · intro h
        rw [← sub_eq_zero, ← hD]
        ext k m
        rw [hcoef, Polynomial.coeff_zero, MvPolynomial.coeff_zero]
        exact h _ (Ideal.subset_span ⟨(k, m), rfl⟩)
      · intro h a ha
        have hle : I ≤ RingHom.ker (ψ : MvPolynomial ι A →+* S) := by
          apply Ideal.span_le.mpr
          rintro _ ⟨⟨k, m⟩, rfl⟩
          rw [SetLike.mem_coe, RingHom.mem_ker, ← hcoef, hD, h, sub_self]
          simp
        exact hle ha
    refine ⟨MvPolynomial ι A ⧸ I, inferInstance, inferInstance, ?_, ?_, ?_⟩
    · exact Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A I)
        (Ideal.Quotient.mkₐ_surjective A I)
    · intro S _ _ Q₁ Q₂ hQ₁ hQ₂ hd₁ hd₂ hb₁ hb₂ hprod
      let v : ι → S := Sum.elim (fun km => (Q₁.coeff km.1).coeff km.2)
        (fun km => (Q₂.coeff km.1).coeff km.2)
      let ψ : MvPolynomial ι A →ₐ[A] S := MvPolynomial.aeval v
      have h1 : wcpaBnFac r e₁ B (fun k m => ψ (MvPolynomial.X (Sum.inl (k, m)))) = Q₁ := by
        simp only [ψ, MvPolynomial.aeval_X, v, Sum.elim_inl]
        exact hfac_eq e₁ B Q₁ hQ₁ hd₁ (fun k m h => hB k m (hb₁ k m h))
      have h2 : wcpaBnFac r e₂ B (fun k m => ψ (MvPolynomial.X (Sum.inr (k, m)))) = Q₂ := by
        simp only [ψ, MvPolynomial.aeval_X, v, Sum.elim_inr]
        exact hfac_eq e₂ B Q₂ hQ₂ hd₂ (fun k m h => hB k m (hb₂ k m h))
      exact ⟨Ideal.Quotient.liftₐ I ψ ((key S ψ).mpr (by rw [h1, h2]; exact hprod))⟩
    · intro S _ _ _ hg
      obtain ⟨g⟩ := hg
      let ψ : MvPolynomial ι A →ₐ[A] S := g.comp (Ideal.Quotient.mkₐ A I)
      have hψ : ∀ a ∈ I, ψ a = 0 := by
        intro a ha
        simp only [ψ, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
          Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
      exact ⟨_, _, hfac_monic _ _ _, hfac_monic _ _ _, hfac_deg _ _ _, hfac_deg _ _ _,
        (key S ψ).mp hψ⟩

  intro A _ _ r P hPm hPd hirr
  classical
  have H : ∀ e : ℕ, ∃ fe : A, fe ≠ 0 ∧ (0 < e → e < P.natDegree →
      ∀ (κ : Type u) [Field κ] [Algebra A κ], algebraMap A κ fe ≠ 0 →
      ∀ Q₁ Q₂ : Polynomial (MvPolynomial (Fin r) κ), Q₁.Monic → Q₂.Monic →
        Q₁.natDegree = e → Q₂.natDegree = P.natDegree - e →
        Q₁ * Q₂ = P.map (MvPolynomial.map (algebraMap A κ)) → False) := by
    intro e
    by_cases he : 0 < e ∧ e < P.natDegree
    swap
    · exact ⟨1, one_ne_zero, fun h1 h2 => absurd ⟨h1, h2⟩ he⟩
    obtain ⟨C, iC, iAC, hft, fw, cv⟩ :=
      s3 A r P e (P.natDegree - e) ((MvPolynomial.finSuccEquiv A r).symm P).totalDegree
    have hE : IsEmpty (C →ₐ[A] AlgebraicClosure (FractionRing A)) := by
      refine ⟨fun g => ?_⟩
      obtain ⟨Q₁, Q₂, hQ₁, hQ₂, hd₁, hd₂, hprod⟩ := cv _ ⟨g⟩
      have := ((hPm.map _).irreducible_iff_natDegree.mp hirr).2 Q₁ Q₂ hQ₁ hQ₂ hprod
      omega
    obtain ⟨fe, hfe0, hfe⟩ := s4 A C hft hE
    refine ⟨fe, hfe0, fun _ _ κ _ _ hκ Q₁ Q₂ hQ₁ hQ₂ hd₁ hd₂ hprod => ?_⟩
    have hT : ((MvPolynomial.finSuccEquiv κ r).symm (Q₁ * Q₂)).totalDegree ≤
        ((MvPolynomial.finSuccEquiv A r).symm P).totalDegree := by
      rw [hprod]; exact s2 A κ (algebraMap A κ) r P
    have hT' : ((MvPolynomial.finSuccEquiv κ r).symm (Q₂ * Q₁)).totalDegree ≤
        ((MvPolynomial.finSuccEquiv A r).symm P).totalDegree := by
      rw [mul_comm]; exact hT
    obtain ⟨g⟩ := fw κ Q₁ Q₂ hQ₁ hQ₂ hd₁ hd₂
      (fun k m h => (s1 κ r Q₁ Q₂ hQ₁.ne_zero hQ₂.ne_zero k m h).trans hT)
      (fun k m h => (s1 κ r Q₂ Q₁ hQ₂.ne_zero hQ₁.ne_zero k m h).trans hT') hprod
    apply hκ
    rw [← g.commutes, hfe, map_zero]
  choose f hf0 hf using H
  refine ⟨∏ e ∈ Finset.Ioo 0 P.natDegree, f e,
    Finset.prod_ne_zero_iff.mpr (fun e _ => hf0 e), ?_⟩
  intro κ _ _ hκ
  rw [map_prod, Finset.prod_ne_zero_iff] at hκ
  have hm : (P.map (MvPolynomial.map (algebraMap A κ))).Monic := hPm.map _
  have hdeg : (P.map (MvPolynomial.map (algebraMap A κ))).natDegree = P.natDegree :=
    hPm.natDegree_map _
  rw [hm.irreducible_iff_natDegree]
  refine ⟨fun h1 => ?_, fun g₁ g₂ hg₁ hg₂ hprod => ?_⟩
  · rw [h1, Polynomial.natDegree_one] at hdeg; omega
  · have hsum := hg₁.natDegree_mul hg₂
    rw [hprod, hdeg] at hsum
    by_contra hcon
    push_neg at hcon
    exact hf _ (by omega) (by omega) κ (hκ _ (Finset.mem_Ioo.mpr ⟨by omega, by omega⟩)) g₁ g₂
      hg₁ hg₂ rfl (by omega) hprod

theorem wcpa_pgo_generic_freeness : ∀ (A C M : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing C] [Algebra A C] [AddCommGroup M] [Module A M] [Module C M] [IsScalarTower A C M], Algebra.FiniteType A C → Module.Finite C M → ∃ f : A, f ≠ 0 ∧ Module.Free (Localization.Away f) (TensorProduct A (Localization.Away f) M) :=
by
  have s1 : ∀ (A S T M : Type u) [CommRing A] [CommRing S] [CommRing T] [Algebra A S] [Algebra A T] [AddCommGroup M] [Module A M], (S →ₐ[A] T) → Module.Free S (TensorProduct A S M) → Module.Free T (TensorProduct A T M) := by
    intro A S T M _ _ _ _ _ _ _ φ hfree
    letI : Algebra S T := φ.toRingHom.toAlgebra
    haveI : IsScalarTower A S T := IsScalarTower.of_algebraMap_eq (fun x => (φ.commutes x).symm)
    haveI : Module.Free T (TensorProduct S T (TensorProduct A S M)) := inferInstance
    exact Module.Free.of_equiv (TensorProduct.AlgebraTensorModule.cancelBaseChange A S T T M)
  have s2 : ∀ (A N₁ N₂ N₃ : Type u) [CommRing A] [AddCommGroup N₁] [Module A N₁] [AddCommGroup N₂] [Module A N₂] [AddCommGroup N₃] [Module A N₃] (f : N₁ →ₗ[A] N₂) (g : N₂ →ₗ[A] N₃), Function.Injective f → Function.Surjective g → Function.Exact f g → ∀ s : A, Module.Free (Localization.Away s) (TensorProduct A (Localization.Away s) N₁) → Module.Free (Localization.Away s) (TensorProduct A (Localization.Away s) N₃) → Module.Free (Localization.Away s) (TensorProduct A (Localization.Away s) N₂) := by
    intro A N₁ N₂ N₃ _ _ _ _ _ _ _ f g hf hg hfg s h1 h3
    set S := Localization.Away s
    haveI : Module.Flat A S := IsLocalization.flat S (Submonoid.powers s)
    set f' := f.baseChange S
    set g' := g.baseChange S
    have hf' : Function.Injective f' := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_preserves_injective_linearMap _ hf
    have hg' : Function.Surjective g' := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective _ hg
    have hfg' : Function.Exact f' g' := by
      rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
      exact lTensor_exact S hfg hg
    haveI : Module.Projective S (TensorProduct A S N₃) := Module.Projective.of_free
    obtain ⟨σ, hσ⟩ := Module.projective_lifting_property g' LinearMap.id hg'
    have hgσ : ∀ y, g' (σ y) = y := fun y => LinearMap.congr_fun hσ y
    have hΦinj : Function.Injective (f'.coprod σ) := by
      rw [injective_iff_map_eq_zero]
      rintro ⟨p, y⟩ h
      simp only [LinearMap.coprod_apply] at h
      have hy : y = 0 := by
        have h' := congrArg g' h
        rwa [map_add, hfg'.apply_apply_eq_zero, hgσ, zero_add, map_zero] at h'
      subst hy
      rw [map_zero, add_zero] at h
      have hp : p = 0 := hf' (h.trans (map_zero f').symm)
      rw [hp]
      rfl
    have hΦsurj : Function.Surjective (f'.coprod σ) := by
      intro x
      have h0 : g' (x - σ (g' x)) = 0 := by rw [map_sub, hgσ, sub_self]
      obtain ⟨p, hp⟩ := (hfg' _).mp h0
      refine ⟨(p, g' x), ?_⟩
      simp only [LinearMap.coprod_apply]
      rw [hp, sub_add_cancel]
    exact Module.Free.of_equiv (LinearEquiv.ofBijective (f'.coprod σ) ⟨hΦinj, hΦsurj⟩)
  have s3 : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] (a : A), (∀ m : M, a • m = 0) → Module.Free (Localization.Away a) (TensorProduct A (Localization.Away a) M) := by
    intro A M _ _ _ a ha
    have hu : IsUnit (algebraMap A (Localization.Away a) a) := IsLocalization.Away.algebraMap_isUnit a
    have hkill : ∀ z : TensorProduct A (Localization.Away a) M, a • z = 0 := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [smul_zero]
      | tmul t m => rw [← TensorProduct.tmul_smul, ha, TensorProduct.tmul_zero]
      | add x y hx hy => rw [smul_add, hx, hy, add_zero]
    haveI : Subsingleton (TensorProduct A (Localization.Away a) M) := by
      refine ⟨fun x y => ?_⟩
      have h0 : ∀ z : TensorProduct A (Localization.Away a) M, z = 0 := by
        intro z
        obtain ⟨v, hv⟩ := hu.exists_left_inv
        calc z = (v * algebraMap A (Localization.Away a) a) • z := by rw [hv, one_smul]
          _ = v • (a • z) := by rw [mul_smul, algebraMap_smul]
          _ = 0 := by rw [hkill, smul_zero]
      rw [h0 x, h0 y]
    exact Module.Free.of_subsingleton _ _
  have s4 : ∀ (A : Type u) [CommRing A] (g f : A), g ∣ f → Nonempty (Localization.Away g →ₐ[A] Localization.Away f) := by
    intro A _ g f hgf
    obtain ⟨c, rfl⟩ := hgf
    have hu : IsUnit (algebraMap A (Localization.Away (g * c)) g) :=
      isUnit_of_mul_isUnit_left
        (by rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit (g * c))
    exact ⟨{ Localization.awayLift (algebraMap A (Localization.Away (g * c))) g hu with
      commutes' := fun x => IsLocalization.Away.lift_eq g hu x }⟩
  have s5 : ∀ (A : Type u) [CommRing A] [IsDomain A] (a : A), a ≠ 0 → ∀ b : Localization.Away a, b ≠ 0 → ∃ f : A, f ≠ 0 ∧ Nonempty (Localization.Away b →ₐ[A] Localization.Away f) := by
    intro A _ _ a ha b hb
    obtain ⟨⟨c, ⟨_, k, rfl⟩⟩, hbc⟩ := IsLocalization.surj (Submonoid.powers a) b
    simp only at hbc
    have hc : c ≠ 0 := by
      rintro rfl
      apply hb
      rw [map_zero] at hbc
      have hu : IsUnit (algebraMap A (Localization.Away a) (a ^ k)) := by
        rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit a).pow k
      exact (hu.mul_left_eq_zero).mp hbc
    refine ⟨a * c, mul_ne_zero ha hc, ?_⟩
    obtain ⟨ψ⟩ := s4 A a (a * c) (dvd_mul_right a c)
    have hcu : IsUnit (algebraMap A (Localization.Away (a * c)) c) :=
      isUnit_of_mul_isUnit_right
        (by rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit (a * c))
    have hau : IsUnit (algebraMap A (Localization.Away (a * c)) a) :=
      isUnit_of_mul_isUnit_left
        (by rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit (a * c))
    have hψb : IsUnit (ψ b) := by
      have h1 : ψ b * algebraMap A (Localization.Away (a * c)) (a ^ k) =
          algebraMap A (Localization.Away (a * c)) c := by
        rw [← ψ.commutes, ← ψ.commutes, ← map_mul, hbc]
      rw [← h1] at hcu
      exact isUnit_of_mul_isUnit_left hcu
    exact ⟨{ Localization.awayLift ψ.toRingHom b hψb with
      commutes' := fun x => by
        show (IsLocalization.Away.lift b hψb) (algebraMap (Localization.Away a) (Localization.Away b) (algebraMap A (Localization.Away a) x)) = _
        rw [IsLocalization.Away.lift_eq]
        exact ψ.commutes x }⟩
  have s6 : ∀ (A R S M : Type u) [CommRing A] [CommRing R] [CommRing S] [Algebra A R] [Algebra R S] [Algebra A S] [IsScalarTower A R S] [AddCommGroup M] [Module A M], Module.Free S (TensorProduct R S (TensorProduct A R M)) → Module.Free S (TensorProduct A S M) := by
    intro A R S M _ _ _ _ _ _ _ _ _ h
    exact Module.Free.of_equiv (TensorProduct.AlgebraTensorModule.cancelBaseChange A R S S M)
  have s10 : ∀ (A C : Type u) [CommRing A] [CommRing C] [IsNoetherianRing C] [Algebra A C] (Q : (N : Type u) → [AddCommGroup N] → [Module A N] → Prop), (∀ (N N' : Type u) [AddCommGroup N] [Module A N] [AddCommGroup N'] [Module A N'], (N ≃ₗ[A] N') → Q N → Q N') → (∀ (N : Type u) [AddCommGroup N] [Module A N] [Subsingleton N], Q N) → (∀ (N₁ N₂ N₃ : Type u) [AddCommGroup N₁] [Module A N₁] [AddCommGroup N₂] [Module A N₂] [AddCommGroup N₃] [Module A N₃] (f : N₁ →ₗ[A] N₂) (g : N₂ →ₗ[A] N₃), Function.Injective f → Function.Surjective g → Function.Exact f g → Q N₁ → Q N₃ → Q N₂) → (∀ q : Ideal C, q.IsPrime → Q (C ⧸ q)) → ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module C M] [IsScalarTower A C M], Module.Finite C M → Q M := by
    intro A C _ _ _ _ Q hiso hsub hext hprime M _ instM _ _ hfin
    have key := IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime C hfin
      (motive := fun N _ _ _ => ∀ (inst : Module A N),
        (∀ (a : A) (n : N), a • n = algebraMap A C a • n) → @Q N _ inst)
      (fun N _ _ _ _ inst _ => @hsub N _ inst _)
      (fun N _ _ _ p e inst hc => by
        have e' : (C ⧸ p.asIdeal) ≃ₗ[A] N :=
          { e.symm.toAddEquiv with
            map_smul' := fun a x => by
              show e.symm (a • x) = a • e.symm x
              rw [hc, ← map_smul, algebraMap_smul] }
        exact hiso _ _ e' (hprime p.asIdeal p.isPrime))
      (fun N₁ _ _ _ N₂ _ _ _ N₃ _ _ _ f g hf hg hfg h1 h3 inst hc => by
        letI i1 : Module A N₁ := Module.compHom N₁ (algebraMap A C)
        letI i3 : Module A N₃ := Module.compHom N₃ (algebraMap A C)
        let f' : N₁ →ₗ[A] N₂ :=
          { toFun := f, map_add' := f.map_add,
            map_smul' := fun a x => by
              show f (algebraMap A C a • x) = a • f x
              rw [hc, f.map_smul] }
        let g' : N₂ →ₗ[A] N₃ :=
          { toFun := g, map_add' := g.map_add,
            map_smul' := fun a x => by
              show g (a • x) = algebraMap A C a • g x
              rw [hc, g.map_smul] }
        exact hext N₁ N₂ N₃ f' g' hf hg hfg (h1 i1 (fun _ _ => rfl)) (h3 i3 (fun _ _ => rfl)))
    exact key instM (fun a n => (algebraMap_smul C a n).symm)
  have s7c : ∀ (A D : Type u) [CommRing A] [CommRing D] [Algebra A D] (n : ℕ) (y : Fin (n + 1) → D) (e : Fin n → ℕ) (a : A), Function.Surjective (MvPolynomial.aeval (R := A) y) → Algebra.adjoin ↥(MvPolynomial.aeval (R := Localization.Away a) (fun j : Fin n => (1 : Localization.Away a) ⊗ₜ[A] (y j.succ - y 0 ^ e j))).range {(1 : Localization.Away a) ⊗ₜ[A] y 0} = ⊤ := by
    intro A D _ _ _ n y e a hsurj
    set A' := Localization.Away a
    set z : Fin n → TensorProduct A A' D := fun j => (1 : A') ⊗ₜ[A] (y j.succ - y 0 ^ e j) with hz
    set S := (MvPolynomial.aeval (R := A') z).range with hS
    set x : TensorProduct A A' D := (1 : A') ⊗ₜ[A] y 0 with hx
    set 𝒜 := Algebra.adjoin S {x} with h𝒜
    have hSmem : ∀ v : TensorProduct A A' D, v ∈ S → v ∈ 𝒜 := fun v hv =>
      Subalgebra.algebraMap_mem 𝒜 (⟨v, hv⟩ : S)
    have hxmem : x ∈ 𝒜 := Algebra.subset_adjoin rfl
    have hA'mem : ∀ s : A', algebraMap A' (TensorProduct A A' D) s ∈ 𝒜 := fun s =>
      hSmem _ (S.algebraMap_mem s)
    have hAmem : ∀ r : A, algebraMap A (TensorProduct A A' D) r ∈ 𝒜 := fun r => by
      rw [IsScalarTower.algebraMap_apply A A' (TensorProduct A A' D)]
      exact hA'mem _
    let ι : D →ₐ[A] TensorProduct A A' D := Algebra.TensorProduct.includeRight
    have hy : ∀ i, ι (y i) ∈ 𝒜 := by
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · exact hxmem
      · have h1 : ι (y j.succ) = z j + x ^ e j := by
          simp only [hz, hx, ι, Algebra.TensorProduct.includeRight_apply]
          rw [Algebra.TensorProduct.tmul_pow, one_pow, ← TensorProduct.tmul_add, sub_add_cancel]
        rw [h1]
        refine add_mem (hSmem _ ⟨MvPolynomial.X j, MvPolynomial.aeval_X _ _⟩) (pow_mem hxmem _)
    have hι : ∀ d : D, ι d ∈ 𝒜 := by
      intro d
      obtain ⟨P, rfl⟩ := hsurj d
      rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
      induction P using MvPolynomial.induction_on with
      | C r => rw [MvPolynomial.aeval_C]; exact hAmem r
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | mul_X p i hp => rw [map_mul, MvPolynomial.aeval_X]; exact mul_mem hp (hy i)
    rw [eq_top_iff]
    rintro t -
    induction t using TensorProduct.inductionOn with
    | tmul s d =>
      have : s ⊗ₜ[A] d = algebraMap A' (TensorProduct A A' D) s * ι d := by
        show s ⊗ₜ[A] d = (s ⊗ₜ[A] (1 : D)) * ((1 : A') ⊗ₜ[A] d)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this]
      exact mul_mem (hA'mem s) (hι d)
    | add p q hp hq => exact add_mem hp hq
  have s7b : ∀ (A D : Type u) [CommRing A] [CommRing D] [Algebra A D] (n : ℕ) (y : Fin (n + 1) → D) (e : Fin n → ℕ) (a : A) (F : MvPolynomial (Fin (n + 1)) A), MvPolynomial.aeval y F = 0 → (MvPolynomial.finSuccEquiv A n (MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.X j.succ + MvPolynomial.X 0 ^ e j) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) A) F)).leadingCoeff = MvPolynomial.C a → IsIntegral ↥(MvPolynomial.aeval (R := Localization.Away a) (fun j : Fin n => (1 : Localization.Away a) ⊗ₜ[A] (y j.succ - y 0 ^ e j))).range ((1 : Localization.Away a) ⊗ₜ[A] y 0) := by
    intro A D _ _ _ n y e a F hF hlc
    set A' := Localization.Away a
    set D' := TensorProduct A A' D
    set z : Fin n → D' := fun j => (1 : A') ⊗ₜ[A] (y j.succ - y 0 ^ e j) with hz
    set S := (MvPolynomial.aeval (R := A') z).range with hS
    set x : D' := (1 : A') ⊗ₜ[A] y 0 with hx
    set t : Fin (n + 1) → MvPolynomial (Fin (n + 1)) A :=
      Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.X j.succ + MvPolynomial.X 0 ^ e j) with ht
    set G := MvPolynomial.finSuccEquiv A n (MvPolynomial.aeval t F) with hG
    let ι : D →ₐ[A] D' := Algebra.TensorProduct.includeRight
    let φ : MvPolynomial (Fin n) A →+* D' := (MvPolynomial.aeval (R := A) z).toRingHom

    have hi : ∀ H : MvPolynomial (Fin (n + 1)) A,
        Polynomial.eval₂ φ x (MvPolynomial.finSuccEquiv A n H) =
          MvPolynomial.aeval (Fin.cons x z : Fin (n + 1) → D') H := by
      intro H
      have h : (Polynomial.eval₂RingHom φ x).comp
          ((MvPolynomial.finSuccEquiv A n).toAlgHom.toRingHom) =
          (MvPolynomial.aeval (Fin.cons x z : Fin (n + 1) → D')).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [φ, MvPolynomial.finSuccEquiv_apply]
        · intro i
          refine Fin.cases ?_ (fun j => ?_) i
          · simp [MvPolynomial.finSuccEquiv_X_zero]
          · simp [φ, MvPolynomial.finSuccEquiv_X_succ]
      exact RingHom.congr_fun h H

    have hιy : ∀ j : Fin n, ι (y j.succ) = z j + x ^ e j := by
      intro j
      show (1 : A') ⊗ₜ[A] y j.succ = (1 : A') ⊗ₜ[A] (y j.succ - y 0 ^ e j) + ((1 : A') ⊗ₜ[A] y 0) ^ e j
      rw [Algebra.TensorProduct.tmul_pow, one_pow, ← TensorProduct.tmul_add, sub_add_cancel]
    have hii : MvPolynomial.aeval (Fin.cons x z : Fin (n + 1) → D') (MvPolynomial.aeval t F) = 0 := by
      rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
      have hfun : (fun i => MvPolynomial.aeval (Fin.cons x z : Fin (n + 1) → D') (t i)) =
          fun i => ι (y i) := by
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [ht, Fin.cons_zero, MvPolynomial.aeval_X]
          rfl
        · simp only [ht, Fin.cons_succ, map_add, map_pow, MvPolynomial.aeval_X, Fin.cons_zero]
          rw [hιy]
      rw [hfun, ← MvPolynomial.comp_aeval, AlgHom.comp_apply, hF, map_zero]
    have hGx : Polynomial.eval₂ φ x G = 0 := by rw [hG, hi, hii]

    let ρ : MvPolynomial (Fin n) A →+* S :=
      (MvPolynomial.aeval (R := A') z).rangeRestrict.toRingHom.comp
        (MvPolynomial.map (algebraMap A A'))
    have hρ : (algebraMap S D').comp ρ = φ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [ρ, φ, IsScalarTower.algebraMap_apply A A' D']
      · intro i
        simp [ρ, φ]
    have hGS : Polynomial.eval₂ (algebraMap S D') x (G.map ρ) = 0 := by
      rw [Polynomial.eval₂_map, hρ, hGx]
    have hv : IsUnit (ρ (MvPolynomial.C a)) := by
      have : ρ (MvPolynomial.C a) = algebraMap A' S (algebraMap A A' a) := by
        simp only [ρ, RingHom.comp_apply, MvPolynomial.map_C]
        rw [← MvPolynomial.algebraMap_eq]
        exact (MvPolynomial.aeval (R := A') z).rangeRestrict.commutes _
      rw [this]
      exact (IsLocalization.Away.algebraMap_isUnit a).map _
    refine ⟨Polynomial.C (↑hv.unit⁻¹ : S) * G.map ρ, ?_, ?_⟩
    · rcases subsingleton_or_nontrivial S with hSs | hSn
      · exact Subsingleton.elim _ _
      · have hne : ρ G.leadingCoeff ≠ 0 := by rw [hlc]; exact hv.ne_zero
        unfold Polynomial.Monic
        rw [Polynomial.leadingCoeff_C_mul_of_isUnit (Units.isUnit _),
          Polynomial.leadingCoeff_map_of_leadingCoeff_ne_zero _ hne, hlc]
        exact hv.unit.inv_mul
    · rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, hGS, mul_zero]
  have s7a : ∀ (A : Type u) [CommRing A] (n : ℕ) (F : MvPolynomial (Fin (n + 1)) A), F ≠ 0 → ∃ (e : Fin n → ℕ) (a : A), a ≠ 0 ∧ (MvPolynomial.finSuccEquiv A n (MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.X j.succ + MvPolynomial.X 0 ^ e j) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) A) F)).leadingCoeff = MvPolynomial.C a := by
    intro A _ n F hF
    classical
    haveI : Nontrivial A := by
      by_contra h
      rw [not_nontrivial_iff_subsingleton] at h
      exact hF (Subsingleton.elim _ _)
    set c := F.totalDegree + 1 with hc

    have hdig : ∀ (m : ℕ) (f g : Fin m → ℕ), (∀ i, f i < c) → (∀ i, g i < c) →
        ∑ i, f i * c ^ (i : ℕ) = ∑ i, g i * c ^ (i : ℕ) → f = g := by
      intro m
      induction m with
      | zero => intro f g _ _ _; funext i; exact i.elim0
      | succ m ih =>
        intro f g hf hg h
        have hsplit : ∀ k : Fin (m + 1) → ℕ, ∑ i, k i * c ^ (i : ℕ) =
            k 0 + c * ∑ j : Fin m, k j.succ * c ^ (j : ℕ) := by
          intro k
          rw [Fin.sum_univ_succ, Finset.mul_sum]
          congr 1
          · simp
          · refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Fin.val_succ, pow_succ]
            ring
        rw [hsplit f, hsplit g] at h
        have h0 : f 0 = g 0 := by
          have h' := congrArg (· % c) h
          simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hf 0),
            Nat.mod_eq_of_lt (hg 0)] at h'
          exact h'
        have hrest : ∑ j : Fin m, f j.succ * c ^ (j : ℕ) = ∑ j : Fin m, g j.succ * c ^ (j : ℕ) := by
          rw [h0] at h
          have h' := Nat.add_left_cancel h
          exact Nat.eq_of_mul_eq_mul_left (by omega) h'
        have := ih (fun j => f j.succ) (fun j => g j.succ) (fun j => hf _) (fun j => hg _) hrest
        funext i
        exact Fin.cases h0 (fun j => congrFun this j) i
    set e : Fin n → ℕ := fun j => c ^ ((j : ℕ) + 1) with he
    set t : Fin (n + 1) → MvPolynomial (Fin (n + 1)) A :=
      Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.X j.succ + MvPolynomial.X 0 ^ e j)
      with ht
    set P : Fin (n + 1) → Polynomial (MvPolynomial (Fin n) A) :=
      fun i => MvPolynomial.finSuccEquiv A n (t i) with hP
    have hPmon : ∀ i, (P i).Monic ∧ (P i).natDegree = c ^ (i : ℕ) := by
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · simp only [hP, ht, Fin.cons_zero, MvPolynomial.finSuccEquiv_X_zero]
        exact ⟨Polynomial.monic_X, by simp⟩
      · simp only [hP, ht, Fin.cons_succ, map_add, map_pow, MvPolynomial.finSuccEquiv_X_zero,
          MvPolynomial.finSuccEquiv_X_succ]
        rw [add_comm]
        have hej : e j ≠ 0 := by
          show c ^ ((j : ℕ) + 1) ≠ 0
          exact pow_ne_zero _ (by omega)
        refine ⟨Polynomial.monic_X_pow_add_C _ hej, ?_⟩
        rw [Polynomial.natDegree_X_pow_add_C]
        simp only [he, Fin.val_succ]
    have hG : MvPolynomial.finSuccEquiv A n (MvPolynomial.aeval t F) = MvPolynomial.aeval P F := by
      show ((MvPolynomial.finSuccEquiv A n).toAlgHom.comp (MvPolynomial.aeval t)) F = _
      rw [MvPolynomial.comp_aeval]
      rfl
    obtain ⟨d, hd⟩ := MvPolynomial.ne_zero_iff.mp hF
    have hsupp : F.support.Nonempty := ⟨d, MvPolynomial.mem_support_iff.mpr hd⟩
    set w : (Fin (n + 1) →₀ ℕ) → ℕ := fun ν => ∑ i, ν i * c ^ (i : ℕ) with hw
    obtain ⟨ν₀, hν₀, hmax⟩ := Finset.exists_max_image F.support w hsupp
    have hdigits : ∀ ν ∈ F.support, ∀ i, ν i < c := by
      intro ν hν i
      have h1 := MvPolynomial.le_totalDegree hν
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl)] at h1
      have h2 : ν i ≤ ∑ j, ν j :=
        Finset.single_le_sum (f := fun j => ν j) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
      omega
    have hwinj : ∀ ν ∈ F.support, ∀ μ ∈ F.support, w ν = w μ → ν = μ := by
      intro ν hν μ hμ h
      have := hdig (n + 1) ν μ (hdigits ν hν) (hdigits μ hμ) h
      exact Finsupp.ext (fun i => congrFun this i)
    set Q : (Fin (n + 1) →₀ ℕ) → Polynomial (MvPolynomial (Fin n) A) :=
      fun ν => ∏ i, P i ^ ν i with hQ
    have hQmon : ∀ ν, (Q ν).Monic ∧ (Q ν).natDegree = w ν := by
      intro ν
      refine ⟨Polynomial.monic_prod_of_monic _ _ (fun i _ => (hPmon i).1.pow _), ?_⟩
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun i _ => (hPmon i).1.pow _)]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [(hPmon i).1.natDegree_pow, (hPmon i).2]
    have hterm : ∀ ν, MvPolynomial.aeval P (MvPolynomial.monomial ν (F.coeff ν)) =
        Polynomial.C (MvPolynomial.C (F.coeff ν)) * Q ν := by
      intro ν
      rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun i => pow_zero _),
        Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
    have hGsum : MvPolynomial.aeval P F =
        ∑ ν ∈ F.support, Polynomial.C (MvPolynomial.C (F.coeff ν)) * Q ν := by
      conv_lhs => rw [F.as_sum]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun ν _ => hterm ν)
    have hlt : ∀ ν ∈ F.support, ν ≠ ν₀ → w ν < w ν₀ := fun ν hν hne =>
      lt_of_le_of_ne (hmax ν hν) (fun h => hne (hwinj ν hν ν₀ hν₀ h))
    have hdeg : (MvPolynomial.aeval P F).natDegree ≤ w ν₀ := by
      rw [hGsum]
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro ν hν
      refine (Polynomial.natDegree_C_mul_le _ _).trans ?_
      rw [(hQmon ν).2]
      exact hmax ν hν
    have hcoeff : (MvPolynomial.aeval P F).coeff (w ν₀) = MvPolynomial.C (F.coeff ν₀) := by
      rw [hGsum, Polynomial.finset_sum_coeff, Finset.sum_eq_single ν₀]
      · rw [Polynomial.coeff_C_mul, ← (hQmon ν₀).2, (hQmon ν₀).1.coeff_natDegree, mul_one]
      · intro ν hν hne
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_eq_zero_of_natDegree_lt, mul_zero]
        rw [(hQmon ν).2]
        exact hlt ν hν hne
      · intro h
        exact absurd hν₀ h
    have ha0 : F.coeff ν₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hν₀
    have hC0 : MvPolynomial.C (F.coeff ν₀) ≠ (0 : MvPolynomial (Fin n) A) := by
      rw [Ne, MvPolynomial.C_eq_zero]
      exact ha0
    have hnat : (MvPolynomial.aeval P F).natDegree = w ν₀ :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hdeg (by rw [hcoeff]; exact hC0)
    refine ⟨e, F.coeff ν₀, ha0, ?_⟩
    show (MvPolynomial.finSuccEquiv A n (MvPolynomial.aeval t F)).leadingCoeff = _
    rw [hG, Polynomial.leadingCoeff, hnat, hcoeff]
  intro A₀ C₀ M₀ _ _ _ _ _ _ _ _ _ hft₀ hfin₀
  have sfin : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (x : B), IsIntegral R x →
      Algebra.adjoin R {x} = ⊤ → Module.Finite R B := by
    intro R B _ _ _ x hx hadj
    haveI : Module.Finite R (Algebra.adjoin R {x}) := Algebra.finite_adjoin_simple_of_isIntegral hx
    exact Module.Finite.equiv ((Subalgebra.equivOfEq _ ⊤ hadj).trans Subalgebra.topEquiv).toLinearEquiv
  have step : ∀ n : ℕ, (∀ m : ℕ, n = m + 1 → ∀ (A C M : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing C] [Algebra A C] [AddCommGroup M] [Module A M] [Module C M] [IsScalarTower A C M], (∃ g : MvPolynomial (Fin m) A →ₐ[A] C, Function.Surjective g) → Module.Finite C M → ∃ f : A, f ≠ 0 ∧ Module.Free (Localization.Away f) (TensorProduct A (Localization.Away f) M)) →
      ∀ (A C M : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing C] [Algebra A C] [AddCommGroup M] [Module A M] [Module C M] [IsScalarTower A C M], (∃ g : MvPolynomial (Fin n) A →ₐ[A] C, Function.Surjective g) → Module.Finite C M → ∃ f : A, f ≠ 0 ∧ Module.Free (Localization.Away f) (TensorProduct A (Localization.Away f) M) := by
    intro n hIH A C M _ _ _ _ _ _ _ _ _ hgs hfin
    obtain ⟨g, hg⟩ := hgs
    haveI : Algebra.FiniteType A C := Algebra.FiniteType.of_surjective g hg
    haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing A C
    refine s10 A C (fun N _ _ => ∃ f : A, f ≠ 0 ∧ Module.Free (Localization.Away f) (TensorProduct A (Localization.Away f) N)) ?_ ?_ ?_ ?_ M hfin
    · intro N N' _ _ _ _ e ⟨f, hf, hfree⟩
      exact ⟨f, hf, Module.Free.of_equiv (LinearEquiv.baseChange A (Localization.Away f) N N' e)⟩
    · intro N _ _ _
      exact ⟨1, one_ne_zero, Module.Free.of_subsingleton _ _⟩
    · intro N₁ N₂ N₃ _ _ _ _ _ _ f g hf hg hfg ⟨f₁, hf₁, h₁⟩ ⟨f₃, hf₃, h₃⟩
      obtain ⟨φ₁⟩ := s4 A f₁ (f₁ * f₃) (dvd_mul_right f₁ f₃)
      obtain ⟨φ₃⟩ := s4 A f₃ (f₁ * f₃) (dvd_mul_left f₃ f₁)
      exact ⟨f₁ * f₃, mul_ne_zero hf₁ hf₃, s2 A N₁ N₂ N₃ f g hf hg hfg (f₁ * f₃)
        (s1 A _ _ N₁ φ₁ h₁) (s1 A _ _ N₃ φ₃ h₃)⟩
    · intro q _
      let ψ : MvPolynomial (Fin n) A →ₐ[A] C ⧸ q := (Ideal.Quotient.mkₐ A q).comp g
      have hψ : Function.Surjective ψ := (Ideal.Quotient.mkₐ_surjective A q).comp hg
      set y : Fin n → C ⧸ q := fun i => ψ (MvPolynomial.X i) with hy
      have hψy : MvPolynomial.aeval y = ψ := (MvPolynomial.aeval_unique ψ).symm
      by_cases hinj : Function.Injective ψ
      · let eq := AlgEquiv.ofBijective ψ ⟨hinj, hψ⟩
        haveI : Module.Free A (C ⧸ q) := Module.Free.of_equiv eq.toLinearEquiv
        exact ⟨1, one_ne_zero, Module.Free.of_basis (Algebra.TensorProduct.basis (Localization.Away (1 : A)) (Module.Free.chooseBasis A (C ⧸ q)))⟩
      · rw [injective_iff_map_eq_zero] at hinj
        push_neg at hinj
        obtain ⟨F, hF0, hFne⟩ := hinj
        cases n with
        | zero =>
          have hFC := MvPolynomial.eq_C_of_isEmpty F
          have hc : F.coeff 0 ≠ 0 := by
            intro h0
            apply hFne
            rw [hFC, h0, map_zero]
          have halg : algebraMap A (C ⧸ q) (F.coeff 0) = 0 := by
            rw [← ψ.commutes, MvPolynomial.algebraMap_eq, ← hFC]
            exact hF0
          refine ⟨F.coeff 0, hc, s3 A (C ⧸ q) (F.coeff 0) (fun d => ?_)⟩
          rw [Algebra.smul_def, halg, zero_mul]
        | succ m =>
          obtain ⟨e, a, ha, hlc⟩ := s7a A m F hFne
          have hFy : MvPolynomial.aeval y F = 0 := by rw [hψy]; exact hF0
          haveI : IsDomain (Localization.Away a) :=
            IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors ha)
          haveI : IsNoetherianRing (Localization.Away a) :=
            IsLocalization.isNoetherianRing (Submonoid.powers a) _ inferInstance
          have hint := s7b A (C ⧸ q) m y e a F hFy hlc
          have hadj := s7c A (C ⧸ q) m y e a (by rw [hψy]; exact hψ)
          set S := (MvPolynomial.aeval (R := Localization.Away a)
              (fun j : Fin m => (1 : Localization.Away a) ⊗ₜ[A] (y j.succ - y 0 ^ e j))).range
            with hS
          set x : TensorProduct A (Localization.Away a) (C ⧸ q) :=
            (1 : Localization.Away a) ⊗ₜ[A] y 0 with hx
          have hfinS : Module.Finite S (TensorProduct A (Localization.Away a) (C ⧸ q)) :=
            sfin S _ x hint hadj
          obtain ⟨b, hb, hfree⟩ := hIH m rfl (Localization.Away a) S
            (TensorProduct A (Localization.Away a) (C ⧸ q))
            ⟨_, AlgHom.rangeRestrict_surjective _⟩ hfinS
          obtain ⟨f, hf, ⟨φ⟩⟩ := s5 A a ha b hb
          exact ⟨f, hf, s1 A _ _ (C ⧸ q) φ (s6 A (Localization.Away a) _ (C ⧸ q) hfree)⟩
  have P : ∀ n : ℕ, ∀ (A C M : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing C] [Algebra A C] [AddCommGroup M] [Module A M] [Module C M] [IsScalarTower A C M], (∃ g : MvPolynomial (Fin n) A →ₐ[A] C, Function.Surjective g) → Module.Finite C M → ∃ f : A, f ≠ 0 ∧ Module.Free (Localization.Away f) (TensorProduct A (Localization.Away f) M) := by
    intro n
    induction n with
    | zero => exact step 0 (fun m h => absurd h (Nat.succ_ne_zero m).symm)
    | succ k ih =>
      refine step (k + 1) (fun m h => ?_)
      obtain rfl : k = m := Nat.succ_injective h
      exact ih
  obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft₀
  exact P n A₀ C₀ M₀ ⟨g, hg⟩ hfin₀

theorem wcpa_pgo_nzd_fibres : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (f : A) (h : B), (∀ b : B, h * b = 0 → b = 0) → Module.Flat (Localization.Away f) (TensorProduct A (Localization.Away f) (B ⧸ Ideal.span {h})) → ∀ (L : Type u) [Field L] [Algebra A L], algebraMap A L f ≠ 0 → ∀ x : TensorProduct A L B, ((1 : L) ⊗ₜ[A] h) * x = 0 → x = 0 :=
by
  intro A B _ _ _ f h hnzd hflat L _ _ hf x hx
  classical
  have hu : IsUnit (algebraMap A L f) := isUnit_iff_ne_zero.mpr hf
  letI : Algebra (Localization.Away f) L :=
    (IsLocalization.Away.lift (S := Localization.Away f) f hu).toAlgebra
  haveI : IsScalarTower A (Localization.Away f) L :=
    IsScalarTower.of_algebraMap_eq (fun a => (IsLocalization.Away.lift_eq f hu a).symm)
  let φ : B →ₗ[A] B := LinearMap.mulLeft A h
  let π : B →ₗ[A] B ⧸ Ideal.span {h} := (Ideal.Quotient.mkₐ A (Ideal.span {h})).toLinearMap
  have hφ : Function.Injective φ := by
    intro b b' hb
    have h1 : h * (b - b') = 0 := by
      rw [mul_sub]; exact sub_eq_zero.mpr hb
    exact sub_eq_zero.mp (hnzd _ h1)
  have hex : Function.Exact φ π := by
    intro y
    simp only [π, φ, AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton', Set.mem_range,
      LinearMap.mulLeft_apply]
    constructor
    · rintro ⟨a, rfl⟩; exact ⟨a, mul_comm _ _⟩
    · rintro ⟨a, rfl⟩; exact ⟨a, mul_comm _ _⟩
  have hπ : Function.Surjective π := Ideal.Quotient.mkₐ_surjective A _
  have hinj' : Function.Injective (LinearMap.baseChange (Localization.Away f) φ) := by
    rw [LinearMap.baseChange_eq_ltensor]
    exact Module.Flat.lTensor_preserves_injective_linearMap φ hφ
  have hex' : Function.Exact (LinearMap.baseChange (Localization.Away f) φ)
      (LinearMap.baseChange (Localization.Away f) π) := by
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    exact Module.Flat.lTensor_exact (Localization.Away f) hex
  have hsurj' : Function.Surjective (LinearMap.baseChange (Localization.Away f) π) := by
    rw [LinearMap.baseChange_eq_ltensor]
    exact LinearMap.lTensor_surjective (Localization.Away f) hπ
  have hΨ : Function.Injective
      (LinearMap.lTensor L (LinearMap.baseChange (Localization.Away f) φ)) :=
    LinearMap.lTensor_injective_of_exact_of_flat _ hsurj' _ hinj' hex' L
  let e := TensorProduct.AlgebraTensorModule.cancelBaseChange A (Localization.Away f)
    (Localization.Away f) L B
  have key : ∀ z, e (LinearMap.lTensor L (LinearMap.baseChange (Localization.Away f) φ) z) =
      ((1 : L) ⊗ₜ[A] h) * e z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | add z w hz hw => simp only [map_add, mul_add, hz, hw]
    | tmul l w =>
      induction w using TensorProduct.induction_on with
      | zero => simp
      | add w w' hw hw' => simp only [TensorProduct.tmul_add, map_add, mul_add, hw, hw']
      | tmul a b =>
        simp [e, φ, Algebra.TensorProduct.tmul_mul_tmul,
          TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
  have hz : e.symm x = 0 := by
    apply hΨ
    apply e.injective
    rw [key, LinearEquiv.apply_symm_apply, hx, map_zero, map_zero]
  rw [← e.apply_symm_apply x, hz, map_zero]

theorem wcpa_pnm_good_open : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A] [CommRing B] [Algebra A B], Algebra.Smooth A B → ∀ (p : Ideal A), p.IsPrime → (∀ (L : Type u) [Field L] [Algebra A L], RingHom.ker (algebraMap A L) = p → IsDomain (TensorProduct A L B)) → ∃ f : A, f ∉ p ∧ ∀ (q : Ideal A), q.IsPrime → p ≤ q → f ∉ q → ∀ (L : Type u) [Field L] [Algebra A L], RingHom.ker (algebraMap A L) = q → IsDomain (TensorProduct A L B) :=
by
  intro A B _ _ _ _ hsm p hp hgood
  classical

  have hdom : ∀ (A₁ B₁ : Type u) [CommRing A₁] [IsDomain A₁] [IsNoetherianRing A₁] [CommRing B₁]
      [Algebra A₁ B₁], Algebra.Smooth A₁ B₁ →
      (∀ (L : Type u) [Field L] [Algebra A₁ L], Function.Injective (algebraMap A₁ L) →
        IsDomain (TensorProduct A₁ L B₁)) →
      ∃ f : A₁, f ≠ 0 ∧ ∀ (L : Type u) [Field L] [Algebra A₁ L], algebraMap A₁ L f ≠ 0 →
        IsDomain (TensorProduct A₁ L B₁) := by
    intro A₁ B₁ _ _ _ _ _ hsm₁ Hyp
    haveI := hsm₁
    haveI hflat : Module.Flat A₁ B₁ := inferInstance
    haveI hft : Algebra.FiniteType A₁ B₁ := inferInstance
    haveI hK := Hyp (FractionRing A₁) (IsFractionRing.injective A₁ (FractionRing A₁))
    obtain ⟨hBdom, hAB⟩ := wcpa_pgo_flat_generic_domain A₁ B₁ hflat hK
    haveI := hBdom
    obtain ⟨r, P, h, s₀, hPm, hPd, hh, hs₀, ⟨e⟩⟩ :=
      wcpa_pgo_smooth_birational_model A₁ B₁ hsm₁ hAB

    have hinc : ∀ (L : Type u) [Field L] [Algebra A₁ L], Function.Injective (algebraMap A₁ L) →
        Function.Injective (fun b : B₁ => (1 : L) ⊗ₜ[A₁] b) := by
      intro L _ _ hinj
      have h1 : Function.Injective (LinearMap.rTensor B₁ (Algebra.linearMap A₁ L)) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ hinj
      have h2 : (fun b : B₁ => (1 : L) ⊗ₜ[A₁] b) =
          (LinearMap.rTensor B₁ (Algebra.linearMap A₁ L)) ∘ (TensorProduct.lid A₁ B₁).symm := by
        funext b
        simp
      rw [h2]
      exact h1.comp (TensorProduct.lid A₁ B₁).symm.injective

    have hinjKb : Function.Injective (algebraMap A₁ (AlgebraicClosure (FractionRing A₁))) := by
      rw [IsScalarTower.algebraMap_eq A₁ (FractionRing A₁) (AlgebraicClosure (FractionRing A₁))]
      exact (algebraMap (FractionRing A₁) (AlgebraicClosure (FractionRing A₁))).injective.comp
        (IsFractionRing.injective A₁ (FractionRing A₁))
    have hirrKb : Irreducible (P.map (MvPolynomial.map
        (algebraMap A₁ (AlgebraicClosure (FractionRing A₁))))) := by
      haveI hKbB := Hyp (AlgebraicClosure (FractionRing A₁)) hinjKb
      have h1h : ((1 : AlgebraicClosure (FractionRing A₁)) ⊗ₜ[A₁] h) ≠ 0 := by
        intro h0
        apply hh
        apply hinc (AlgebraicClosure (FractionRing A₁)) hinjKb
        simp only
        rw [h0, TensorProduct.tmul_zero]
      haveI hloc : IsDomain (Localization.Away
          ((1 : AlgebraicClosure (FractionRing A₁)) ⊗ₜ[A₁] h)) :=
        IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors h1h)
      obtain ⟨e'⟩ := wcpa_pgo_basechange_model A₁ B₁ r P h s₀ e
        (AlgebraicClosure (FractionRing A₁))
      haveI := MulEquiv.isDomain _ e'.symm.toMulEquiv
      refine wcpa_pgo_irreducible_of_domain (AlgebraicClosure (FractionRing A₁)) r _ _
        (hPm.map _) ?_ ?_ this
      · rw [hPm.natDegree_map]; exact hPd
      · exact (map_ne_zero_iff _ (MvPolynomial.map_injective _ hinjKb)).mpr hs₀
    obtain ⟨f₁, hf₁0, hf₁⟩ := wcpa_pgo_bertini_noether A₁ r P hPm hPd hirrKb
    obtain ⟨m, hm⟩ := MvPolynomial.ne_zero_iff.mp hs₀
    haveI hftC : Algebra.FiniteType A₁ (B₁ ⧸ Ideal.span {h}) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A₁ _)
        (Ideal.Quotient.mkₐ_surjective A₁ _)
    obtain ⟨f₂, hf₂0, hf₂⟩ := wcpa_pgo_generic_freeness A₁ (B₁ ⧸ Ideal.span {h})
      (B₁ ⧸ Ideal.span {h}) hftC (Module.Finite.self _)
    haveI := hf₂
    have hflat₂ : Module.Flat (Localization.Away f₂)
        (TensorProduct A₁ (Localization.Away f₂) (B₁ ⧸ Ideal.span {h})) := inferInstance
    refine ⟨f₁ * f₂ * s₀.coeff m,
      mul_ne_zero (mul_ne_zero hf₁0 hf₂0) hm, ?_⟩
    intro L _ _ hfL
    rw [map_mul, map_mul] at hfL
    have hL1 : algebraMap A₁ L f₁ ≠ 0 := fun h0 => hfL (by rw [h0]; ring)
    have hL2 : algebraMap A₁ L f₂ ≠ 0 := fun h0 => hfL (by rw [h0]; ring)
    have hL3 : algebraMap A₁ L (s₀.coeff m) ≠ 0 := fun h0 => hfL (by rw [h0]; ring)
    have hirrL := hf₁ L hL1
    have hsL : MvPolynomial.map (algebraMap A₁ L) s₀ ≠ 0 := by
      intro h0
      apply hL3
      have h1 : (MvPolynomial.map (algebraMap A₁ L) s₀).coeff m = 0 := by rw [h0]; rfl
      rwa [MvPolynomial.coeff_map] at h1
    haveI hHypL := wcpa_pgo_domain_of_irreducible L r _ _ (hPm.map _)
      (by rw [hPm.natDegree_map]; exact hPd) hirrL hsL
    obtain ⟨eL⟩ := wcpa_pgo_basechange_model A₁ B₁ r P h s₀ e L
    haveI hlocL : IsDomain (Localization.Away ((1 : L) ⊗ₜ[A₁] h)) :=
      MulEquiv.isDomain _ eL.toMulEquiv
    have hnzd := wcpa_pgo_nzd_fibres A₁ B₁ f₂ h
      (fun b hb => (mul_eq_zero.mp hb).resolve_left hh) hflat₂ L hL2
    have hmem : ((1 : L) ⊗ₜ[A₁] h) ∈ nonZeroDivisors (TensorProduct A₁ L B₁) := by
      rw [mem_nonZeroDivisors_iff]
      exact ⟨fun x hx => hnzd x hx, fun x hx => hnzd x (by rw [mul_comm]; exact hx)⟩
    have hle : Submonoid.powers ((1 : L) ⊗ₜ[A₁] h) ≤ nonZeroDivisors (TensorProduct A₁ L B₁) :=
      Submonoid.powers_le.mpr hmem
    exact Function.Injective.isDomain
      (algebraMap (TensorProduct A₁ L B₁) (Localization.Away ((1 : L) ⊗ₜ[A₁] h)))
      (IsLocalization.injective (Localization.Away ((1 : L) ⊗ₜ[A₁] h)) hle)

  haveI := hsm
  haveI : IsDomain (A ⧸ p) := Ideal.Quotient.isDomain p
  have hsm' : Algebra.Smooth (A ⧸ p) (TensorProduct A (A ⧸ p) B) :=
    Algebra.Smooth.baseChange A B (A ⧸ p)
  have Hyp : ∀ (L : Type u) [Field L] [Algebra (A ⧸ p) L],
      Function.Injective (algebraMap (A ⧸ p) L) →
      IsDomain (TensorProduct (A ⧸ p) L (TensorProduct A (A ⧸ p) B)) := by
    intro L _ _ hinj
    letI : Algebra A L := ((algebraMap (A ⧸ p) L).comp (algebraMap A (A ⧸ p))).toAlgebra
    haveI : IsScalarTower A (A ⧸ p) L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hker : RingHom.ker (algebraMap A L) = p := by
      ext x
      rw [RingHom.mem_ker]
      show algebraMap (A ⧸ p) L (algebraMap A (A ⧸ p) x) = 0 ↔ x ∈ p
      rw [map_eq_zero_iff _ hinj, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
    haveI := hgood L hker
    exact MulEquiv.isDomain _
      (Algebra.TensorProduct.cancelBaseChange A (A ⧸ p) L L B).toMulEquiv
  obtain ⟨f', hf'0, hf'⟩ := hdom (A ⧸ p) (TensorProduct A (A ⧸ p) B) hsm' Hyp
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective f'
  refine ⟨f, fun hf => hf'0 (Ideal.Quotient.eq_zero_iff_mem.mpr hf), ?_⟩
  intro q hq hpq hfq L _ _ hker
  have hlift : ∀ a ∈ p, algebraMap A L a = 0 := by
    intro a ha
    have ha' : a ∈ RingHom.ker (algebraMap A L) := by rw [hker]; exact hpq ha
    exact RingHom.mem_ker.mp ha'
  letI : Algebra (A ⧸ p) L := (Ideal.Quotient.lift p (algebraMap A L) hlift).toAlgebra
  haveI : IsScalarTower A (A ⧸ p) L :=
    IsScalarTower.of_algebraMap_eq (fun x => (Ideal.Quotient.lift_mk p _ _).symm)
  have hf0 : algebraMap (A ⧸ p) L (Ideal.Quotient.mk p f) ≠ 0 := by
    show Ideal.Quotient.lift p (algebraMap A L) hlift (Ideal.Quotient.mk p f) ≠ 0
    rw [Ideal.Quotient.lift_mk]
    intro h0
    apply hfq
    rw [← hker]
    exact RingHom.mem_ker.mpr h0
  haveI := hf' L hf0
  exact MulEquiv.isDomain _
    (Algebra.TensorProduct.cancelBaseChange A (A ⧸ p) L L B).symm.toMulEquiv

theorem wcpa_pnm_spread : ∀ (A V : Type u) [CommRing A] [IsNoetherianRing A] [CommRing V] [Algebra A V] (Good : Ideal A → Prop), (∀ P : Ideal V, P.IsPrime → Good (P.comap (algebraMap A V))) → (∀ p : Ideal A, p.IsPrime → Good p → ∃ f : A, f ∉ p ∧ ∀ q : Ideal A, q.IsPrime → p ≤ q → f ∉ q → Good q) → ∃ (R : Type u) (_ : CommRing R) (_ : IsNoetherianRing R) (_ : Algebra A R) (_ : Algebra R V) (_ : IsScalarTower A R V), ∀ Q : Ideal R, Q.IsPrime → Good (Q.comap (algebraMap A R)) :=
by
  intro A V _ _ _ _ Good h1 h2
  classical

  have sep : ∀ p : Ideal A, p.IsPrime → (∀ P : Ideal V, P.IsPrime → P.comap (algebraMap A V) ≠ p) →
      ∃ (s : A) (n : ℕ) (c : Fin n → V) (x : Fin n → A), s ∉ p ∧ (∀ i, x i ∈ p) ∧
        algebraMap A V s = ∑ i, c i * algebraMap A V (x i) := by
    intro p hp hne
    by_cases hd : Disjoint (Ideal.map (algebraMap A V) p : Set V)
        (Submonoid.map (algebraMap A V) p.primeCompl : Set V)
    · exfalso
      obtain ⟨P, hP, hNP, hPd⟩ := Ideal.exists_le_prime_disjoint _ _ hd
      apply hne P hP
      apply le_antisymm
      · intro a ha
        by_contra hap
        exact Set.disjoint_left.mp hPd (Ideal.mem_comap.mp ha) (Submonoid.mem_map.mpr ⟨a, hap, rfl⟩)
      · exact Ideal.map_le_iff_le_comap.mp hNP
    · obtain ⟨y, hyN, hyM⟩ := Set.not_disjoint_iff.mp hd
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hyM
      have hyN' : algebraMap A V s ∈ Submodule.span V (algebraMap A V '' (p : Set A)) := hyN
      obtain ⟨n, c, g, hg⟩ := Submodule.mem_span_set'.mp hyN'
      have hx : ∀ i, ∃ a, a ∈ p ∧ algebraMap A V a = (g i : V) := fun i => (g i).2
      choose x hxp hxe using hx
      refine ⟨s, n, c, x, hs, hxp, ?_⟩
      rw [← hg]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [smul_eq_mul, hxe]

  have kill : ∀ (p : Ideal A) (s : A) (n : ℕ) (c : Fin n → V) (x : Fin n → A), (∀ i, x i ∈ p) →
      algebraMap A V s = ∑ i, c i * algebraMap A V (x i) →
      ∃ T : Subalgebra A V, T.FG ∧ ∀ T' : Subalgebra A V, T ≤ T' → ∀ Q : Ideal T',
        p ≤ Q.comap (algebraMap A T') → s ∈ Q.comap (algebraMap A T') := by
    intro p s n c x hx hs
    refine ⟨Algebra.adjoin A ↑(Finset.univ.image c), Subalgebra.fg_adjoin_finset _, ?_⟩
    intro T' hle Q hQ
    have hc : ∀ i, c i ∈ T' := fun i => hle (Algebra.subset_adjoin (by simp))
    have key : algebraMap A T' s = ∑ i, (⟨c i, hc i⟩ : T') * algebraMap A T' (x i) := by
      apply Subtype.val_injective
      show T'.val (algebraMap A T' s) = T'.val (∑ i, (⟨c i, hc i⟩ : T') * algebraMap A T' (x i))
      rw [map_sum, AlgHom.commutes, hs]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, AlgHom.commutes]
      rfl
    rw [Ideal.mem_comap, key]
    exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hQ (hx i)))
  have ax : ∀ (I : Ideal A) (a : A), a ∉ I → I < I ⊔ Ideal.span {a} := by
    intro I a ha
    refine lt_of_le_of_ne le_sup_left (fun h => ha ?_)
    rw [h]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self a)
  have ax2 : ∀ (I q : Ideal A) (a : A), I ≤ q → a ∈ q → I ⊔ Ideal.span {a} ≤ q :=
    fun I q a h ha => sup_le h ((Ideal.span_singleton_le_iff_mem _).mpr ha)
  have pc : ∀ (T' : Subalgebra A V) (Q : Ideal T'), Q.IsPrime →
      (Q.comap (algebraMap A T')).IsPrime := by
    intro T' Q hQ
    have := hQ
    infer_instance
  have main : ∀ I : Ideal A, ∃ T : Subalgebra A V, T.FG ∧ ∀ T' : Subalgebra A V, T ≤ T' →
      ∀ Q : Ideal T', Q.IsPrime → I ≤ Q.comap (algebraMap A T') →
        Good (Q.comap (algebraMap A T')) := by
    intro I₀
    refine IsNoetherian.induction (R := A) (M := A)
      (P := fun I : Ideal A => ∃ T : Subalgebra A V, T.FG ∧ ∀ T' : Subalgebra A V, T ≤ T' →
        ∀ Q : Ideal T', Q.IsPrime → I ≤ Q.comap (algebraMap A T') →
          Good (Q.comap (algebraMap A T'))) (fun (I : Ideal A) IH => ?_) I₀
    by_cases hI : I.IsPrime
    · by_cases hG : Good I
      · obtain ⟨f, hf, Hf⟩ := h2 I hI hG
        obtain ⟨T, hT, hTc⟩ := IH _ (ax I f hf)
        refine ⟨T, hT, fun T' hle Q hQ hIQ => ?_⟩
        by_cases hfQ : f ∈ Q.comap (algebraMap A T')
        · exact hTc T' hle Q hQ (ax2 _ _ _ hIQ hfQ)
        · exact Hf _ (pc T' Q hQ) hIQ hfQ
      · have hne : ∀ P : Ideal V, P.IsPrime → P.comap (algebraMap A V) ≠ I :=
          fun P hP he => hG (he ▸ h1 P hP)
        obtain ⟨s, n, c, x, hs, hx, hsc⟩ := sep I hI hne
        obtain ⟨Tk, hTk, hk⟩ := kill I s n c x hx hsc
        obtain ⟨TJ, hTJ, hJ⟩ := IH _ (ax I s hs)
        refine ⟨TJ ⊔ Tk, hTJ.sup hTk, fun T' hle Q hQ hIQ => ?_⟩
        have hsQ := hk T' (le_sup_right.trans hle) Q hIQ
        exact hJ T' (le_sup_left.trans hle) Q hQ (ax2 _ _ _ hIQ hsQ)
    · by_cases htop : I = ⊤
      · refine ⟨⊥, Subalgebra.fg_bot, fun T' _ Q hQ hIQ => ?_⟩
        exfalso
        rw [htop, top_le_iff] at hIQ
        exact (pc T' Q hQ).ne_top hIQ
      · have hex : ∃ a b, a * b ∈ I ∧ a ∉ I ∧ b ∉ I := by
          by_contra hcon
          push_neg at hcon
          exact hI ⟨htop, fun {a b} hab =>
            (em (a ∈ I)).elim Or.inl (fun h => Or.inr (hcon a b hab h))⟩
        obtain ⟨a, b, hab, ha, hb⟩ := hex
        obtain ⟨T₁, hT₁, h₁⟩ := IH _ (ax I a ha)
        obtain ⟨T₂, hT₂, h₂⟩ := IH _ (ax I b hb)
        refine ⟨T₁ ⊔ T₂, hT₁.sup hT₂, fun T' hle Q hQ hIQ => ?_⟩
        rcases (pc T' Q hQ).mem_or_mem (hIQ hab) with h | h
        · exact h₁ T' (le_sup_left.trans hle) Q hQ (ax2 _ _ _ hIQ h)
        · exact h₂ T' (le_sup_right.trans hle) Q hQ (ax2 _ _ _ hIQ h)
  obtain ⟨T, hT, hTc⟩ := main ⊥
  haveI : Algebra.FiniteType A T := (Subalgebra.fg_iff_finiteType T).mp hT
  haveI : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing A T
  exact ⟨T, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    fun Q hQ => hTc T le_rfl Q hQ bot_le⟩

theorem wcpa_pple_noetherian_model : ∀ (V C : Type u) [CommRing V] [CommRing C] [Algebra V C], Algebra.Smooth V C → (∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L C)) → ∃ (R₀ : Type u) (_ : CommRing R₀) (_ : IsNoetherianRing R₀) (_ : Algebra R₀ V) (C₀ : Type u) (_ : CommRing C₀) (_ : Algebra R₀ C₀), Algebra.Smooth R₀ C₀ ∧ (∀ (L : Type u) [Field L] [Algebra R₀ L], IsDomain (TensorProduct R₀ L C₀)) ∧ Nonempty (C ≃ₗ[V] TensorProduct R₀ V C₀) :=
by
  intro V C _ _ _ hsm hdom
  classical
  haveI := hsm

  obtain ⟨A₀, B₀, iB₀, iAB, hfg, hsm₀, ⟨e⟩⟩ := Algebra.Smooth.exists_subalgebra_fg ℤ V C

  haveI : Algebra.FiniteType ℤ A₀ := (Subalgebra.fg_iff_finiteType A₀).mp hfg
  haveI hA₀N : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing ℤ A₀
  haveI := hsm₀
  have hflat : Module.Flat A₀ B₀ := inferInstance

  let Good : Ideal A₀ → Prop := fun p => ∀ (L : Type u) [Field L] [Algebra A₀ L],
    RingHom.ker (algebraMap A₀ L) = p → IsDomain (TensorProduct A₀ L B₀)
  have hi : ∀ P : Ideal V, P.IsPrime → Good (P.comap (algebraMap A₀ V)) := by
    intro P hP L _ _ hker
    refine wcpa_pnm_fibre_descent A₀ V B₀ hflat ?_ P hP L hker

    intro L' _ _ _ _
    haveI := hdom L'
    exact MulEquiv.isDomain (TensorProduct V L' C)
      ((Algebra.TensorProduct.congr (AlgEquiv.refl : L' ≃ₐ[L'] L') e).trans
        (Algebra.TensorProduct.cancelBaseChange A₀ V L' L' B₀)).symm.toMulEquiv
  have hii : ∀ p : Ideal A₀, p.IsPrime → Good p →
      ∃ f : A₀, f ∉ p ∧ ∀ q : Ideal A₀, q.IsPrime → p ≤ q → f ∉ q → Good q := by
    intro p hp hg
    exact wcpa_pnm_good_open A₀ B₀ hsm₀ p hp hg
  obtain ⟨R, iR, hRN, iAR, iRV, hT, hgood⟩ := wcpa_pnm_spread A₀ V Good hi hii

  refine ⟨R, iR, hRN, iRV, TensorProduct A₀ R B₀, inferInstance, inferInstance, ?_, ?_, ?_⟩
  · exact Algebra.Smooth.baseChange A₀ B₀ R
  · intro L _ _
    letI : Algebra A₀ L := ((algebraMap R L).comp (algebraMap A₀ R)).toAlgebra
    haveI : IsScalarTower A₀ R L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hQ : (RingHom.ker (algebraMap R L)).IsPrime := RingHom.ker_isPrime _
    have hk : RingHom.ker (algebraMap A₀ L) =
        (RingHom.ker (algebraMap R L)).comap (algebraMap A₀ R) := by
      rw [RingHom.comap_ker]; rfl
    haveI : IsDomain (TensorProduct A₀ L B₀) := hgood _ hQ L hk
    exact MulEquiv.isDomain _ (Algebra.TensorProduct.cancelBaseChange A₀ R L L B₀).toMulEquiv
  · exact ⟨(e.trans (Algebra.TensorProduct.cancelBaseChange A₀ R V V B₀).symm).toLinearEquiv⟩

theorem wcpa_pple_np_quot_hyp : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (I : Ideal R), Module.Flat R S → Algebra.FiniteType R S → (∀ (L : Type u) [Field L] [Algebra R L], IsDomain (TensorProduct R L S)) → Module.Flat (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I) ∧ Algebra.FiniteType (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I) ∧ ∀ (L : Type u) [Field L] [Algebra (R ⧸ I) L], IsDomain (TensorProduct (R ⧸ I) L (S ⧸ Ideal.map (algebraMap R S) I)) :=
by
  intro R S _ _ _ I hfl hft hdom
  haveI := hfl
  haveI := hft
  let e : (S ⧸ Ideal.map (algebraMap R S) I) ≃ₐ[R ⧸ I] TensorProduct R (R ⧸ I) S :=
    AlgEquiv.extendScalarsOfSurjective (R := R) (S := R ⧸ I) Ideal.Quotient.mk_surjective
      (((Algebra.TensorProduct.quotIdealMapEquivTensorQuot S I).restrictScalars R).trans
        (Algebra.TensorProduct.comm R S (R ⧸ I)))
  refine ⟨?_, ?_, ?_⟩
  · exact Module.Flat.of_linearEquiv (R := R ⧸ I) e.toLinearEquiv
  · haveI : Algebra.FiniteType R (S ⧸ Ideal.map (algebraMap R S) I) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R (Ideal.map (algebraMap R S) I))
        (Ideal.Quotient.mkₐ_surjective R _)
    exact Algebra.FiniteType.of_restrictScalars_finiteType R (R ⧸ I)
      (S ⧸ Ideal.map (algebraMap R S) I)
  · intro L _ _
    letI : Algebra R L := Algebra.compHom L (Ideal.Quotient.mk I)
    haveI : IsScalarTower R (R ⧸ I) L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI hD : IsDomain (TensorProduct R L S) := hdom L
    let Φ : TensorProduct (R ⧸ I) L (S ⧸ Ideal.map (algebraMap R S) I) ≃ₐ[R ⧸ I]
        TensorProduct R L S :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl (R := R ⧸ I) (A₁ := L)) e).trans
        (Algebra.TensorProduct.cancelBaseChange R (R ⧸ I) (R ⧸ I) L S)
    exact MulEquiv.isDomain (TensorProduct R L S) Φ.toMulEquiv

theorem wcpa_pple_np_quot_transfer : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (I : Ideal R) (J : Ideal (R ⧸ I)), Module.Projective (R ⧸ J.comap (Ideal.Quotient.mk I)) (S ⧸ Ideal.map (algebraMap R S) (J.comap (Ideal.Quotient.mk I))) → Module.Projective ((R ⧸ I) ⧸ J) ((S ⧸ Ideal.map (algebraMap R S) I) ⧸ Ideal.map (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I)) J) :=
by

  have transport : ∀ (A A' M M' : Type u) [CommRing A] [CommRing A'] [AddCommGroup M] [Module A M]
      [AddCommGroup M'] [Module A' M'] (e₁ : A ≃+* A') (e₂ : M ≃+ M'),
      (∀ (a : A) (m : M), e₂ (a • m) = e₁ a • e₂ m) →
      Module.Projective A M → Module.Projective A' M' := by
    intro A A' M M' _ _ _ _ _ _ e₁ e₂ he hP
    obtain ⟨s, hs⟩ := Module.projective_def'.mp hP
    have he' : ∀ (c : A') (y : M'), e₂.symm (c • y) = e₁.symm c • e₂.symm y := by
      intro c y
      apply e₂.injective
      rw [he, e₂.apply_symm_apply, e₁.apply_symm_apply, e₂.apply_symm_apply]
    have hmr : ∀ (a : A) (f : M →₀ A), Finsupp.mapRange e₁ (map_zero e₁) (a • f) =
        e₁ a • Finsupp.mapRange e₁ (map_zero e₁) f := by
      intro a f
      ext m
      simp only [Finsupp.mapRange_apply, Finsupp.smul_apply, smul_eq_mul, map_mul]
    let s' : M' →ₗ[A'] (M' →₀ A') :=
      { toFun := fun y => Finsupp.mapDomain e₂ (Finsupp.mapRange e₁ (map_zero e₁) (s (e₂.symm y)))
        map_add' := by
          intro x y
          simp only [map_add, Finsupp.mapRange_add (map_add e₁), Finsupp.mapDomain_add]
        map_smul' := by
          intro c y
          simp only [RingHom.id_apply]
          rw [he', map_smul, hmr, e₁.apply_symm_apply, Finsupp.mapDomain_smul] }
    refine Module.projective_def'.mpr ⟨s', ?_⟩
    apply LinearMap.ext
    intro y
    show Finsupp.linearCombination A' id
      (Finsupp.mapDomain e₂ (Finsupp.mapRange e₁ (map_zero e₁) (s (e₂.symm y)))) = y
    rw [Finsupp.linearCombination_mapDomain, Finsupp.linearCombination_apply,
      Finsupp.sum_mapRange_index (h := fun i a => a • (id ∘ ⇑e₂) i) (fun _ => zero_smul _ _)]
    have h1 := LinearMap.congr_fun hs (e₂.symm y)
    rw [LinearMap.comp_apply, Finsupp.linearCombination_apply, LinearMap.id_apply] at h1
    conv_rhs => rw [← e₂.apply_symm_apply y, ← h1]
    rw [map_finsuppSum]
    simp only [Function.comp_apply, id, he]
  intro R S _ _ _ I J hP
  have hIK : I ≤ J.comap (Ideal.Quotient.mk I) := by
    intro x hx
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact J.zero_mem
  have hJ : J = Ideal.map (Ideal.Quotient.mk I) (J.comap (Ideal.Quotient.mk I)) :=
    (Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective J).symm
  let φ : R →+* (R ⧸ I) ⧸ J := (Ideal.Quotient.mk J).comp (Ideal.Quotient.mk I)
  have hφs : Function.Surjective φ :=
    Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hkerφ : RingHom.ker φ = J.comap (Ideal.Quotient.mk I) := by
    ext x
    rw [RingHom.mem_ker, Ideal.mem_comap]
    exact Ideal.Quotient.eq_zero_iff_mem
  have hsq : ∀ x : R, algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I) (Ideal.Quotient.mk I x) =
      Ideal.Quotient.mk (Ideal.map (algebraMap R S) I) (algebraMap R S x) :=
    fun x => Ideal.Quotient.algebraMap_quotient_map_quotient x
  have hJ' : Ideal.map (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I)) J =
      Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) I))
        (Ideal.map (algebraMap R S) (J.comap (Ideal.Quotient.mk I))) := by
    calc Ideal.map (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I)) J
        = Ideal.map (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I))
            (Ideal.map (Ideal.Quotient.mk I) (J.comap (Ideal.Quotient.mk I))) :=
          congrArg (Ideal.map (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I))) hJ
      _ = Ideal.map ((algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I)).comp
            (Ideal.Quotient.mk I)) (J.comap (Ideal.Quotient.mk I)) := Ideal.map_map _ _
      _ = Ideal.map ((Ideal.Quotient.mk (Ideal.map (algebraMap R S) I)).comp (algebraMap R S))
            (J.comap (Ideal.Quotient.mk I)) := by
          rw [show (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I)).comp
              (Ideal.Quotient.mk I) = (Ideal.Quotient.mk (Ideal.map (algebraMap R S) I)).comp
              (algebraMap R S) from RingHom.ext hsq]
      _ = Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) I))
            (Ideal.map (algebraMap R S) (J.comap (Ideal.Quotient.mk I))) := (Ideal.map_map _ _).symm
  let ψ : S →+* (S ⧸ Ideal.map (algebraMap R S) I) ⧸
      Ideal.map (algebraMap (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I)) J :=
    (Ideal.Quotient.mk _).comp (Ideal.Quotient.mk (Ideal.map (algebraMap R S) I))
  have hψs : Function.Surjective ψ :=
    Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hkerψ : RingHom.ker ψ = Ideal.map (algebraMap R S) (J.comap (Ideal.Quotient.mk I)) := by
    ext x
    rw [RingHom.mem_ker]
    show Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.map (algebraMap R S) I) x) = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem, hJ', ← Ideal.mem_comap,
      Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
      sup_eq_left.mpr (Ideal.map_mono hIK)]
  let e₁ := (Ideal.quotEquivOfEq hkerφ.symm).trans (RingHom.quotientKerEquivOfSurjective hφs)
  let e₂ := (Ideal.quotEquivOfEq hkerψ.symm).trans (RingHom.quotientKerEquivOfSurjective hψs)
  have he₁ : ∀ r : R, e₁ (Ideal.Quotient.mk _ r) = φ r := fun r => rfl
  have he₂ : ∀ s : S, e₂ (Ideal.Quotient.mk _ s) = ψ s := fun s => rfl
  refine transport _ _ _ _ e₁ e₂.toAddEquiv ?_ hP
  intro a m
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective m
  show e₂ _ = _ • e₂ _
  rw [Algebra.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_quotient_map_quotient, ← map_mul,
    he₂, he₂, he₁]
  show ψ _ = algebraMap ((R ⧸ I) ⧸ J) _ (Ideal.Quotient.mk J (Ideal.Quotient.mk I r)) * ψ s
  rw [Ideal.Quotient.algebraMap_quotient_map_quotient, hsq, map_mul]
  rfl

theorem wcpa_pple_np_basechange_hyp : ∀ (R T S : Type u) [CommRing R] [CommRing T] [Algebra R T] [CommRing S] [Algebra R S], Module.Flat R S → Algebra.FiniteType R S → (∀ (L : Type u) [Field L] [Algebra R L], IsDomain (TensorProduct R L S)) → Module.Flat T (TensorProduct R T S) ∧ Algebra.FiniteType T (TensorProduct R T S) ∧ ∀ (L : Type u) [Field L] [Algebra T L], IsDomain (TensorProduct T L (TensorProduct R T S)) :=
by
  intro R T S _ _ _ _ _ hfl hft hdom
  refine ⟨?_, ?_, ?_⟩
  · exact Module.Flat.baseChange R T S
  · exact Algebra.FiniteType.baseChange T
  · intro L _ _
    letI : Algebra R L := ((algebraMap T L).comp (algebraMap R T)).toAlgebra
    haveI : IsScalarTower R T L := IsScalarTower.of_algebraMap_eq' rfl
    haveI := hdom L
    exact MulEquiv.isDomain (TensorProduct R L S)
      (Algebra.TensorProduct.cancelBaseChange R T L L S).toMulEquiv

theorem wcpa_pple_np_basechange_modg : ∀ (R T S : Type u) [CommRing R] [CommRing T] [Algebra R T] [CommRing S] [Algebra R S] (g : R), Module.Projective (R ⧸ Ideal.span {g}) (S ⧸ Ideal.map (algebraMap R S) (Ideal.span {g})) → Module.Projective (T ⧸ Ideal.span {algebraMap R T g}) (TensorProduct R T S ⧸ Ideal.map (algebraMap T (TensorProduct R T S)) (Ideal.span {algebraMap R T g})) :=
by
  intro R T S _ _ _ _ _ g h
  have hJ : Ideal.span {algebraMap R T g} = Ideal.map (algebraMap R T) (Ideal.span {g}) := by
    rw [Ideal.map_span, Set.image_singleton]
  rw [hJ]
  haveI := h
  let I : Ideal R := Ideal.span {g}
  let J : Ideal T := Ideal.map (algebraMap R T) I
  let eS : (S ⧸ Ideal.map (algebraMap R S) I) ≃ₗ[R ⧸ I] TensorProduct R (R ⧸ I) S :=
    LinearEquiv.extendScalarsOfSurjective (R := R) (S := R ⧸ I) Ideal.Quotient.mk_surjective
      (((Ideal.qoutMapEquivTensorQout S (I := I)).restrictScalars R).trans
        (TensorProduct.comm R S (R ⧸ I)))
  let eB : (TensorProduct R T S ⧸ Ideal.map (algebraMap T (TensorProduct R T S)) J) ≃ₗ[T ⧸ J]
      TensorProduct T (T ⧸ J) (TensorProduct R T S) :=
    LinearEquiv.extendScalarsOfSurjective (R := T) (S := T ⧸ J) Ideal.Quotient.mk_surjective
      (((Ideal.qoutMapEquivTensorQout (TensorProduct R T S) (I := J)).restrictScalars T).trans
        (TensorProduct.comm T (TensorProduct R T S) (T ⧸ J)))
  let Φ := eB.trans
    ((TensorProduct.AlgebraTensorModule.cancelBaseChange R T (T ⧸ J) (T ⧸ J) S).trans
    ((TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (T ⧸ J) (T ⧸ J) S).symm.trans
    (LinearEquiv.baseChange (R ⧸ I) (T ⧸ J) _ _ eS.symm)))
  haveI : Module.Projective (T ⧸ J)
      (TensorProduct (R ⧸ I) (T ⧸ J) (S ⧸ Ideal.map (algebraMap R S) I)) := inferInstance
  exact Module.Projective.of_equiv Φ.symm

theorem wcpa_pple_np_prod_projective : ∀ (R T₁ T₂ M : Type u) [CommRing R] [CommRing T₁] [CommRing T₂] [Algebra R T₁] [Algebra R T₂] [AddCommGroup M] [Module R M], Module.Projective T₁ (TensorProduct R T₁ M) → Module.Projective T₂ (TensorProduct R T₂ M) → Module.Projective (T₁ × T₂) (TensorProduct R (T₁ × T₂) M) :=
by
  intro R T₁ T₂ M _ _ _ _ _ _ _ h₁ h₂
  have half : ∀ (T' : Type u) [CommRing T'] [Algebra R T'] (p : (T₁ × T₂) →ₐ[R] T')
      (ι : T' →ₗ[R] (T₁ × T₂)),
      (∀ (t : T₁ × T₂) (a : T'), ι (p t * a) = t * ι a) →
      (∀ a b : T', ι (a * b) = ι a * ι b) →
      Module.Projective T' (TensorProduct R T' M) →
      ∃ i : TensorProduct R (T₁ × T₂) M →ₗ[T₁ × T₂] (TensorProduct R T' M →₀ (T₁ × T₂)),
        ∀ z, Finsupp.linearCombination (T₁ × T₂)
          (fun x : TensorProduct R T' M => LinearMap.rTensor M ι x) (i z) =
          LinearMap.rTensor M ι (LinearMap.rTensor M p.toLinearMap z) := by
    intro T' _ _ p ι hlin hmul hP
    have hsemi : ∀ (t : T₁ × T₂) (z : TensorProduct R (T₁ × T₂) M),
        LinearMap.rTensor M p.toLinearMap (t • z) = p t • LinearMap.rTensor M p.toLinearMap z := by
      intro t z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a m => simp [TensorProduct.smul_tmul', LinearMap.rTensor_tmul]
      | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]
    have hsm : ∀ (c : T') (y : TensorProduct R T' M),
        ι c • LinearMap.rTensor M ι y = LinearMap.rTensor M ι (c • y) := by
      intro c y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul a m => simp [TensorProduct.smul_tmul', LinearMap.rTensor_tmul, hmul]
      | add x y hx hy => rw [map_add, smul_add, hx, hy, smul_add, map_add]
    obtain ⟨s, hs⟩ := Module.projective_def'.mp hP
    refine ⟨{ toFun := fun z => Finsupp.mapRange ι (map_zero ι)
                (s (LinearMap.rTensor M p.toLinearMap z)),
              map_add' := ?_, map_smul' := ?_ }, ?_⟩
    · intro x y
      rw [map_add, map_add]
      exact Finsupp.mapRange_add (map_add ι) _ _
    · intro t z
      simp only [RingHom.id_apply]
      rw [hsemi, map_smul]
      refine Finsupp.ext (fun x => ?_)
      rw [Finsupp.smul_apply, Finsupp.mapRange_apply, Finsupp.mapRange_apply, Finsupp.smul_apply,
        smul_eq_mul, smul_eq_mul, hlin]
    · intro z
      simp only [LinearMap.coe_mk, AddHom.coe_mk]
      have hw : Finsupp.linearCombination T' id (s (LinearMap.rTensor M p.toLinearMap z)) =
          LinearMap.rTensor M p.toLinearMap z := by
        rw [← LinearMap.comp_apply, hs]; rfl
      rw [Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index
        (fun a => zero_smul (T₁ × T₂) (LinearMap.rTensor M ι a))]
      conv_rhs => rw [← hw, Finsupp.linearCombination_apply, map_finsuppSum]
      apply Finsupp.sum_congr
      intro x _
      exact hsm _ _
  have decomp : ∀ z : TensorProduct R (T₁ × T₂) M,
      LinearMap.rTensor M (LinearMap.inl R T₁ T₂) (LinearMap.rTensor M (AlgHom.fst R T₁ T₂).toLinearMap z) +
      LinearMap.rTensor M (LinearMap.inr R T₁ T₂) (LinearMap.rTensor M (AlgHom.snd R T₁ T₂).toLinearMap z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a m =>
      simp only [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, AlgHom.fst_apply, AlgHom.snd_apply,
        LinearMap.inl_apply, LinearMap.inr_apply]
      rw [← TensorProduct.add_tmul]
      congr 1
      ext <;> simp
    | add x y hx hy =>
      rw [map_add, map_add, map_add, map_add, add_add_add_comm, hx, hy]
  obtain ⟨i₁, hi₁⟩ := half T₁ (AlgHom.fst R T₁ T₂) (LinearMap.inl R T₁ T₂)
    (fun t a => by ext <;> simp) (fun a b => by ext <;> simp) h₁
  obtain ⟨i₂, hi₂⟩ := half T₂ (AlgHom.snd R T₁ T₂) (LinearMap.inr R T₁ T₂)
    (fun t a => by ext <;> simp) (fun a b => by ext <;> simp) h₂
  let s := LinearMap.coprod
    (Finsupp.linearCombination (T₁ × T₂)
      (fun x : TensorProduct R T₁ M => LinearMap.rTensor M (LinearMap.inl R T₁ T₂) x))
    (Finsupp.linearCombination (T₁ × T₂)
      (fun x : TensorProduct R T₂ M => LinearMap.rTensor M (LinearMap.inr R T₁ T₂) x))
  refine Module.Projective.of_split (LinearMap.prod i₁ i₂) s ?_
  apply LinearMap.ext
  intro z
  change Finsupp.linearCombination (T₁ × T₂)
      (fun x : TensorProduct R T₁ M => LinearMap.rTensor M (LinearMap.inl R T₁ T₂) x) (i₁ z) +
    Finsupp.linearCombination (T₁ × T₂)
      (fun x : TensorProduct R T₂ M => LinearMap.rTensor M (LinearMap.inr R T₁ T₂) x) (i₂ z) = z
  rw [hi₁, hi₂]
  exact decomp z

theorem wcpa_pple_np_nilpotent_lift : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (I : Ideal R), IsNilpotent I → Module.Flat R S → Module.Projective (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I) → Module.Projective R S :=
by
  intro R S _ _ _ I hI hfl hproj

  have s1 : ∀ (F P : Type u) [AddCommGroup F] [Module R F] [AddCommGroup P] [Module R P]
      [Module.Flat R P] (π : F →ₗ[R] P), Function.Surjective π → ∀ (k : LinearMap.ker π),
      (k : F) ∈ (I • ⊤ : Submodule R F) → k ∈ (I • ⊤ : Submodule R (LinearMap.ker π)) := by
    intro F P _ _ _ _ _ π hπ k hk
    have hinj := LinearMap.lTensor_injective_of_exact_of_flat π hπ (LinearMap.ker π).subtype
      (Submodule.injective_subtype _) (LinearMap.exact_subtype_ker_map π) (R ⧸ I)
    have h1 : LinearMap.lTensor (R ⧸ I) (LinearMap.ker π).subtype ((1 : R ⧸ I) ⊗ₜ[R] k) = 0 := by
      rw [LinearMap.lTensor_tmul, Submodule.subtype_apply,
        ← TensorProduct.quotTensorEquivQuotSMul_symm_mk, (Submodule.Quotient.mk_eq_zero _).mpr hk,
        map_zero]
    have h2 : (1 : R ⧸ I) ⊗ₜ[R] k = 0 := hinj (h1.trans (map_zero _).symm)
    have h3 : (Submodule.Quotient.mk k :
        LinearMap.ker π ⧸ (I • ⊤ : Submodule R (LinearMap.ker π))) = 0 := by
      rw [← (TensorProduct.quotTensorEquivQuotSMul (LinearMap.ker π) I).apply_symm_apply
        (Submodule.Quotient.mk k), TensorProduct.quotTensorEquivQuotSMul_symm_mk, h2, map_zero]
    exact (Submodule.Quotient.mk_eq_zero _).mp h3

  have s2 : ∀ (K : Type u) [AddCommGroup K] [Module R K] (w : Module.End R K),
      (∀ x : K, x - w x ∈ (I • ⊤ : Submodule R K)) → IsUnit w := by
    intro K _ _ w hw
    set u : Module.End R K := 1 - w with hu
    have hux : ∀ x, u x ∈ (I • ⊤ : Submodule R K) := fun x => by
      have : u x = x - w x := rfl
      rw [this]; exact hw x
    have hA : ∀ j : ℕ, ∀ y ∈ (I ^ j • ⊤ : Submodule R K),
        u y ∈ (I ^ (j + 1) • ⊤ : Submodule R K) := by
      intro j y hy
      refine Submodule.smul_induction_on hy ?_ ?_
      · intro r hr z _
        rw [map_smul, pow_succ, Submodule.mul_smul]
        exact Submodule.smul_mem_smul hr (hux z)
      · intro x y hx hy
        rw [map_add]; exact Submodule.add_mem _ hx hy
    have hB : ∀ j : ℕ, ∀ x, (u ^ j) x ∈ (I ^ j • ⊤ : Submodule R K) := by
      intro j
      induction j with
      | zero => intro x; simp
      | succ j ih => intro x; rw [pow_succ' u j, Module.End.mul_apply]; exact hA j _ (ih x)
    obtain ⟨n, hn⟩ := hI
    have hun : u ^ n = 0 := by
      ext x
      have := hB n x
      rw [hn, Ideal.zero_eq_bot, Submodule.bot_smul] at this
      simpa using this
    have := IsNilpotent.isUnit_one_sub ⟨n, hun⟩
    rwa [hu, sub_sub_cancel] at this

  have s3 : ∀ (F P : Type u) [AddCommGroup F] [Module R F] [AddCommGroup P] [Module R P],
      Module.Projective R F → ∀ (π : F →ₗ[R] P), Function.Surjective π →
      ∀ ρ : F →ₗ[R] LinearMap.ker π, (∀ k : LinearMap.ker π, ρ k = k) → Module.Projective R P := by
    intro F P _ _ _ _ hF π hπ ρ hρ
    have := hF
    let q : F →ₗ[R] F := LinearMap.id - (LinearMap.ker π).subtype ∘ₗ ρ
    have hq : LinearMap.ker π ≤ LinearMap.ker q := by
      intro k hk
      rw [LinearMap.mem_ker]
      show k - ((ρ k : LinearMap.ker π) : F) = 0
      have := hρ ⟨k, hk⟩
      rw [this, sub_self]
    let e := π.quotKerEquivOfSurjective hπ
    let s : P →ₗ[R] F := (LinearMap.ker π).liftQ q hq ∘ₗ e.symm.toLinearMap
    refine Module.Projective.of_split s π ?_
    ext p
    obtain ⟨f, rfl⟩ := hπ p
    have he : e.symm (π f) = Submodule.Quotient.mk f := by
      apply e.injective
      rw [LinearEquiv.apply_symm_apply]
      rfl
    have h0 : π ((ρ f : LinearMap.ker π) : F) = 0 := (ρ f).2
    show π ((LinearMap.ker π).liftQ q hq (e.symm (π f))) = π f
    rw [he, Submodule.liftQ_apply]
    show π (f - ((ρ f : LinearMap.ker π) : F)) = π f
    rw [map_sub, h0, sub_zero]

  have s4 : ∀ (ι P Q : Type u) [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q]
      [Module (R ⧸ I) Q] [IsScalarTower R (R ⧸ I) Q] [Module.Projective (R ⧸ I) Q]
      (π : (ι →₀ R) →ₗ[R] P), Function.Surjective π → ∀ (τ : P →ₗ[R] Q), Function.Surjective τ →
      (∀ p, τ p = 0 → p ∈ (I • ⊤ : Submodule R P)) →
      ∃ ρ₀ : (ι →₀ R) →ₗ[R] LinearMap.ker π, ∀ k : LinearMap.ker π,
        (ρ₀ k : ι →₀ R) - (k : ι →₀ R) ∈ (I • ⊤ : Submodule R (ι →₀ R)) := by
    intro ι P Q _ _ _ _ _ _ _ π hπ τ hτ hker
    let NF : Submodule R (ι →₀ R) := I • ⊤
    have hsurjR : Function.Surjective (algebraMap R (R ⧸ I)) := Ideal.Quotient.mk_surjective
    have hIQ : ∀ r ∈ I, ∀ q : Q, r • q = 0 := by
      intro r hr q
      rw [← algebraMap_smul (R ⧸ I) r q, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem.mpr hr, zero_smul]
    have hle : NF ≤ LinearMap.ker (τ ∘ₗ π) := by
      show I • ⊤ ≤ _
      rw [Submodule.smul_le]
      intro r hr n _
      rw [LinearMap.mem_ker, map_smul]
      exact hIQ r hr _
    let πbR : ((ι →₀ R) ⧸ NF) →ₗ[R] Q := NF.liftQ (τ ∘ₗ π) hle
    let πb : ((ι →₀ R) ⧸ NF) →ₗ[R ⧸ I] Q := LinearMap.extendScalarsOfSurjective hsurjR πbR
    have hπb : ∀ f, πb (Submodule.Quotient.mk f) = τ (π f) := fun f => rfl
    have hπbs : Function.Surjective πb := by
      intro y
      obtain ⟨p, rfl⟩ := hτ y
      obtain ⟨f, rfl⟩ := hπ p
      exact ⟨_, hπb f⟩
    obtain ⟨σ, hσ⟩ := Module.projective_lifting_property πb LinearMap.id hπbs
    have hσ' : ∀ y, πb (σ y) = y := fun y => LinearMap.congr_fun hσ y
    let E : ((ι →₀ R) ⧸ NF) → ((ι →₀ R) ⧸ NF) := fun x => x - σ (πb x)
    have hE : ∀ x, πb (E x) = 0 := fun x => by
      show πb (x - σ (πb x)) = 0
      rw [map_sub, hσ', sub_self]
    have hlift : ∀ x : (ι →₀ R) ⧸ NF, πb x = 0 →
        ∃ k : LinearMap.ker π, Submodule.Quotient.mk (k : ι →₀ R) = x := by
      intro x hx
      obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective NF x
      rw [hπb] at hx
      have h1 : π f ∈ (I • ⊤ : Submodule R P) := hker _ hx
      have h2 : (I • ⊤ : Submodule R P) = Submodule.map π NF := by
        show _ = Submodule.map π (I • ⊤)
        rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hπ]
      rw [h2] at h1
      obtain ⟨y, hy, hyf⟩ := h1
      refine ⟨⟨f - y, ?_⟩, ?_⟩
      · rw [LinearMap.mem_ker, map_sub, hyf, sub_self]
      · show Submodule.Quotient.mk (f - y) = Submodule.Quotient.mk f
        rw [Submodule.Quotient.mk_sub, (Submodule.Quotient.mk_eq_zero NF).mpr hy, sub_zero]
    choose kk hkk using fun i : ι => hlift (E (Submodule.Quotient.mk (Finsupp.single i 1))) (hE _)
    refine ⟨Finsupp.linearCombination R kk, ?_⟩
    let ER : ((ι →₀ R) ⧸ NF) →ₗ[R] ((ι →₀ R) ⧸ NF) := (LinearMap.id - σ ∘ₗ πb).restrictScalars R
    have hid : NF.mkQ ∘ₗ (LinearMap.ker π).subtype ∘ₗ Finsupp.linearCombination R kk =
        ER ∘ₗ NF.mkQ := by
      apply Finsupp.lhom_ext
      intro i b
      rw [← Finsupp.smul_single_one, LinearMap.map_smul, LinearMap.map_smul]
      congr 1
      rw [LinearMap.comp_apply, LinearMap.comp_apply, Finsupp.linearCombination_single, one_smul,
        Submodule.subtype_apply, Submodule.mkQ_apply, hkk i]
      rfl
    intro k
    have h1 := LinearMap.congr_fun hid (k : ι →₀ R)
    have h2 : ER (Submodule.Quotient.mk (k : ι →₀ R)) = Submodule.Quotient.mk (k : ι →₀ R) := by
      show Submodule.Quotient.mk (k : ι →₀ R) - σ (πb (Submodule.Quotient.mk (k : ι →₀ R))) = _
      rw [hπb, LinearMap.mem_ker.mp k.2, map_zero, map_zero, sub_zero]
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.mkQ_apply, h2, Submodule.subtype_apply] at h1
    exact (Submodule.Quotient.eq NF).mp h1

  let π : (S →₀ R) →ₗ[R] S := Finsupp.linearCombination R (fun s : S => s)
  have hπ : Function.Surjective π := fun s => ⟨Finsupp.single s 1, by simp [π]⟩
  let τ : S →ₗ[R] S ⧸ Ideal.map (algebraMap R S) I :=
    (Ideal.Quotient.mkₐ R (Ideal.map (algebraMap R S) I)).toLinearMap
  have hτ : Function.Surjective τ := Ideal.Quotient.mk_surjective
  have hker : ∀ p, τ p = 0 → p ∈ (I • ⊤ : Submodule R S) := by
    intro p hp
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
    exact Ideal.Quotient.eq_zero_iff_mem.mp hp
  obtain ⟨ρ₀, hρ₀⟩ := s4 S S (S ⧸ Ideal.map (algebraMap R S) I) π hπ τ hτ hker
  let w : Module.End R (LinearMap.ker π) := ρ₀ ∘ₗ (LinearMap.ker π).subtype
  have hw : ∀ x : LinearMap.ker π, x - w x ∈ (I • ⊤ : Submodule R (LinearMap.ker π)) := by
    intro x
    apply s1 (S →₀ R) S π hπ
    have h := Submodule.neg_mem _ (hρ₀ x)
    rw [neg_sub] at h
    exact h
  obtain ⟨U, hU⟩ := s2 (LinearMap.ker π) w hw
  let ρ : (S →₀ R) →ₗ[R] LinearMap.ker π := (↑U⁻¹ : Module.End R (LinearMap.ker π)) ∘ₗ ρ₀
  have hρ : ∀ k : LinearMap.ker π, ρ k = k := by
    intro k
    have h : ((↑U⁻¹ * ↑U : Module.End R (LinearMap.ker π))) k = k := by
      rw [Units.inv_mul]; rfl
    rw [hU] at h
    exact h
  exact s3 (S →₀ R) S (Module.Projective.of_basis Finsupp.basisSingleOne) π hπ ρ hρ

theorem wcpa_pple_np_mod_pow : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (g : A), Module.Flat A B → Module.Projective (A ⧸ Ideal.span {g}) (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g})) → ∀ n : ℕ, Module.Projective (A ⧸ Ideal.span {g ^ n}) (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g ^ n})) :=
by
  intro A B _ _ _ g hfl hproj n
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    haveI : Subsingleton (A ⧸ Ideal.span {g ^ 0}) := by
      rw [Ideal.Quotient.subsingleton_iff, pow_zero, Ideal.span_singleton_one]
    haveI : Module.Free (A ⧸ Ideal.span {g ^ 0})
        (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g ^ 0})) :=
      Module.Free.of_subsingleton' _ _
    exact Module.Projective.of_free
  · have s2 : (Ideal.map (Ideal.Quotient.mk (Ideal.span {g ^ n})) (Ideal.span {g})).comap
        (Ideal.Quotient.mk (Ideal.span {g ^ n})) = Ideal.span {g} := by
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr (Ideal.span_singleton_le_span_singleton.mpr (dvd_pow_self g hn.ne'))
    have s3 : IsNilpotent (Ideal.map (Ideal.Quotient.mk (Ideal.span {g ^ n})) (Ideal.span {g})) := by
      refine ⟨n, ?_⟩
      rw [← Ideal.map_pow, Ideal.span_singleton_pow, Ideal.map_quotient_self, Ideal.zero_eq_bot]
    haveI := hfl
    have s4 : Module.Flat (A ⧸ Ideal.span {g ^ n})
        (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g ^ n})) :=
      Module.Flat.of_linearEquiv (R := A ⧸ Ideal.span {g ^ n})
        (AlgEquiv.extendScalarsOfSurjective (R := A) (S := A ⧸ Ideal.span {g ^ n})
          Ideal.Quotient.mk_surjective
          (((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (Ideal.span {g ^ n})).restrictScalars
            A).trans (Algebra.TensorProduct.comm A B (A ⧸ Ideal.span {g ^ n})))).toLinearEquiv
    have s5 := wcpa_pple_np_quot_transfer A B (Ideal.span {g ^ n})
      (Ideal.map (Ideal.Quotient.mk (Ideal.span {g ^ n})) (Ideal.span {g}))
      (by rw [s2]; exact hproj)
    exact wcpa_pple_np_nilpotent_lift _ _ _ s3 s4 s5

theorem wcpa_pple_np_generic_free : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R] [Nontrivial R] [CommRing S] [Algebra R S], Algebra.FiniteType R S → ∃ f : R, f ≠ 0 ∧ Module.Projective (Localization.Away f) (TensorProduct R (Localization.Away f) S) :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R] [Nontrivial R],
      ∃ p : Ideal R, p.IsPrime ∧ ∃ s : R, s ∉ p ∧ ∀ x ∈ p, s * x = 0 := by
    intro R _ _ _ _
    obtain ⟨m, hm⟩ := Ideal.exists_maximal R
    have := hm.isPrime
    obtain ⟨p, hp, -⟩ := Ideal.exists_minimalPrimes_le (show (⊥ : Ideal R) ≤ m from bot_le)
    have hpp : p.IsPrime := hp.1.1
    have hfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
    have hE : ∀ q ∈ hfin.toFinset.erase p, ∃ a ∈ q, a ∉ p := by
      intro q hq
      rw [Finset.mem_erase, Set.Finite.mem_toFinset] at hq
      by_contra h
      have hqp : q ≤ p := fun a ha => by
        by_contra hap
        exact h ⟨a, ha, hap⟩
      have hq2 : q ∈ (⊥ : Ideal R).minimalPrimes := hq.2
      have : p ≤ q := hp.2 ⟨hq2.1.1, bot_le⟩ hqp
      exact hq.1 (le_antisymm hqp this)
    choose! a ha using hE
    refine ⟨p, hpp, ∏ q ∈ hfin.toFinset.erase p, a q, ?_, ?_⟩
    · intro hmem
      obtain ⟨q, hq, hqp⟩ := (Ideal.IsPrime.prod_mem_iff (p := p)).mp hmem
      exact (ha q hq).2 hqp
    · intro x hx
      have hrad : (∏ q ∈ hfin.toFinset.erase p, a q) * x ∈ (⊥ : Ideal R).radical := by
        rw [← Ideal.sInf_minimalPrimes]
        rw [Submodule.mem_sInf]
        intro q hq
        by_cases hqp : q = p
        · subst hqp
          exact Ideal.mul_mem_left _ _ hx
        · have hq' : q ∈ hfin.toFinset.erase p := by
            rw [Finset.mem_erase, Set.Finite.mem_toFinset]
            exact ⟨hqp, hq⟩
          apply Ideal.mul_mem_right
          exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem _ hq') (ha q hq').1
      obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hrad
      exact IsNilpotent.eq_zero ⟨n, Ideal.mem_bot.mp hn⟩

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (p : Ideal R) (s : R),
      s ∉ p → (∀ x ∈ p, s * x = 0) → Function.Surjective (algebraMap R S) →
      ∃ f : R, f ∉ p ∧ Module.Projective (Localization.Away f)
        (TensorProduct R (Localization.Away f) S) := by
    intro R S _ _ _ p s hs hsp hsurj
    by_cases hI : RingHom.ker (algebraMap R S) ≤ p
    · refine ⟨s, hs, ?_⟩
      set T := Localization.Away s
      have hu : IsUnit (algebraMap R T s) := IsLocalization.Away.algebraMap_isUnit s
      have hker : RingHom.ker (algebraMap R S) ≤ RingHom.ker (algebraMap R T) := by
        intro x hx
        rw [RingHom.mem_ker] at hx ⊢
        have h1 : algebraMap R T s * algebraMap R T x = 0 := by
          rw [← map_mul, hsp x (hI hx), map_zero]
        exact (hu.mul_right_eq_zero).mp h1
      let e := Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R S) hsurj
      let ψ : S →ₐ[R] T := (Ideal.Quotient.liftₐ (RingHom.ker (Algebra.ofId R S))
        (Algebra.ofId R T) (fun x hx => hker hx)).comp e.symm.toAlgHom
      have hψ : ∀ r : R, ψ (algebraMap R S r) = algebraMap R T r := fun r => ψ.commutes r
      let i : TensorProduct R T S →ₐ[T] T :=
        Algebra.TensorProduct.lift (AlgHom.id T T) ψ (fun _ _ => Commute.all _ _)
      let j : T →ₐ[T] TensorProduct R T S := Algebra.TensorProduct.includeLeft
      refine Module.Projective.of_split (M := T) i.toLinearMap j.toLinearMap ?_
      apply LinearMap.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul t y =>
        obtain ⟨r, rfl⟩ := hsurj y
        simp only [LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
          LinearMap.id_apply]
        simp only [i, j, Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, hψ,
          Algebra.TensorProduct.includeLeft_apply]
        rw [Algebra.algebraMap_eq_smul_one r, mul_smul_comm, mul_one, TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one]
      | add x y hx hy => rw [map_add, hx, hy, map_add]
    · obtain ⟨a, haI, hap⟩ := Set.not_subset.mp hI
      refine ⟨a, hap, ?_⟩
      set T := Localization.Away a
      have hu : IsUnit (algebraMap R T a) := IsLocalization.Away.algebraMap_isUnit a
      have hkill : ∀ z : TensorProduct R T S, a • z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact smul_zero _
        | tmul t y =>
          rw [← TensorProduct.tmul_smul, Algebra.smul_def, RingHom.mem_ker.mp haI, zero_mul,
            TensorProduct.tmul_zero]
        | add x y hx hy => rw [smul_add, hx, hy, add_zero]
      haveI : Subsingleton (TensorProduct R T S) := by
        refine ⟨fun x y => ?_⟩
        have h0 : ∀ z : TensorProduct R T S, z = 0 := by
          intro z
          obtain ⟨v, hv⟩ := hu.exists_left_inv
          calc z = (v * algebraMap R T a) • z := by rw [hv, one_smul]
            _ = v • (a • z) := by rw [mul_smul, algebraMap_smul]
            _ = 0 := by rw [hkill, smul_zero]
        rw [h0 x, h0 y]
      haveI : Module.Free T (TensorProduct R T S) := Module.Free.of_subsingleton T _
      exact Module.Projective.of_free

  have s6 : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (g f : R), g ∣ f →
      Module.Projective (Localization.Away g) (TensorProduct R (Localization.Away g) M) →
      Module.Projective (Localization.Away f) (TensorProduct R (Localization.Away f) M) := by
    intro R M _ _ _ g f hgf h
    obtain ⟨c, rfl⟩ := hgf
    have hu : IsUnit (algebraMap R (Localization.Away (g * c)) g) :=
      isUnit_of_mul_isUnit_left
        (by rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit (g * c))
    letI : Algebra (Localization.Away g) (Localization.Away (g * c)) :=
      (Localization.awayLift (algebraMap R (Localization.Away (g * c))) g hu).toAlgebra
    haveI : IsScalarTower R (Localization.Away g) (Localization.Away (g * c)) :=
      IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.Away.lift_eq g hu x).symm)
    haveI : Module.Projective (Localization.Away (g * c))
        (TensorProduct (Localization.Away g) (Localization.Away (g * c))
          (TensorProduct R (Localization.Away g) M)) := Module.Projective.tensorProduct
    exact Module.Projective.of_equiv (TensorProduct.AlgebraTensorModule.cancelBaseChange R
      (Localization.Away g) (Localization.Away (g * c)) (Localization.Away (g * c)) M)

  have s5 : ∀ (T P : Type u) [CommRing T] [AddCommGroup P] [Module T P] (N : ℕ → Submodule T P),
      Monotone N → N 0 = ⊥ → (∀ z : P, ∃ i, z ∈ N i) →
      (∀ i, ∃ (Q : Type u) (_ : AddCommGroup Q) (_ : Module T Q), Module.Projective T Q ∧
        ∃ π : ↥(N (i + 1)) →ₗ[T] Q, Function.Surjective π ∧
          LinearMap.ker π = Submodule.comap (N (i + 1)).subtype (N i)) →
      Module.Projective T P := by
    intro T P _ _ _ N hN hN0 hex hQ
    choose Q iQ mQ hQp π hπs hπk using hQ
    have hσ : ∀ i, ∃ σ : Q i →ₗ[T] ↥(N (i + 1)), (π i).comp σ = LinearMap.id := fun i =>
      Module.projective_lifting_property (π i) LinearMap.id (hπs i)
    choose σ hσ using hσ
    have hπσ : ∀ i (q : Q i), π i (σ i q) = q := fun i q => LinearMap.congr_fun (hσ i) q
    let Φ : DirectSum ℕ Q →ₗ[T] P :=
      DirectSum.toModule T ℕ P (fun i => (N (i + 1)).subtype.comp (σ i))
    have hΦof : ∀ i (q : Q i), Φ (DirectSum.lof T ℕ Q i q) = (σ i q : P) := fun i q =>
      DirectSum.toModule_lof T i _
    have hker : ∀ i (y : ↥(N (i + 1))), (y : P) ∈ N i → π i y = 0 := fun i y hy => by
      have : y ∈ LinearMap.ker (π i) := by rw [hπk i]; exact hy
      exact this
    have hsurjk : ∀ k, ∀ z ∈ N k, ∃ q, Φ q = z := by
      intro k
      induction k with
      | zero =>
        intro z hz
        rw [hN0, Submodule.mem_bot] at hz
        exact ⟨0, by rw [hz, map_zero]⟩
      | succ k ih =>
        intro z hz
        set y : ↥(N (k + 1)) := ⟨z, hz⟩ with hy
        have h1 : y - σ k (π k y) ∈ LinearMap.ker (π k) := by
          rw [LinearMap.mem_ker, map_sub, hπσ, sub_self]
        rw [hπk k] at h1
        obtain ⟨q', hq'⟩ := ih _ h1
        refine ⟨q' + DirectSum.lof T ℕ Q k (π k y), ?_⟩
        rw [map_add, hq', hΦof]
        simp [y]
    have hsurj : Function.Surjective Φ := fun z => by
      obtain ⟨k, hk⟩ := hex z
      exact hsurjk k z hk
    have hinj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro q hq
      by_contra hne
      have hsupp : q.support.Nonempty :=
        Finset.nonempty_iff_ne_empty.mpr (fun h => hne (DFinsupp.support_eq_empty.mp h))
      set k := q.support.max' hsupp with hkdef
      have hk : k ∈ q.support := Finset.max'_mem _ _
      have hsum : Φ q = ∑ i ∈ q.support, (σ i (q i) : P) := by
        conv_lhs => rw [← DirectSum.sum_support_of q]
        rw [map_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← DirectSum.lof_eq_of T, hΦof]
      have hrest : ∑ i ∈ q.support.erase k, (σ i (q i) : P) ∈ N k := by
        apply Submodule.sum_mem
        intro i hi
        have hik : i < k := lt_of_le_of_ne (Finset.le_max' _ _ (Finset.mem_of_mem_erase hi))
          (Finset.ne_of_mem_erase hi)
        exact hN (by omega : i + 1 ≤ k) (σ i (q i)).2
      have hsplit := Finset.add_sum_erase q.support (fun i => (σ i (q i) : P)) hk
      have hneg : ((σ k (q k) : ↥(N (k + 1))) : P) ∈ N k := by
        have : (σ k (q k) : P) = - ∑ i ∈ q.support.erase k, (σ i (q i) : P) := by
          rw [eq_neg_iff_add_eq_zero, hsplit, ← hsum, hq]
        rw [this]
        exact neg_mem hrest
      have h2 := hker k _ hneg
      rw [hπσ] at h2
      exact (DFinsupp.mem_support_iff.mp hk) h2
    exact Module.Projective.of_equiv (LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩)

  have s4 : ∀ (R T M : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.Flat R T]
      [AddCommGroup M] [Module R M] (N : ℕ → Submodule R M) (Q : ℕ → Type u)
      [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)], Monotone N → N 0 = ⊥ →
      (∀ m : M, ∃ i, m ∈ N i) →
      (∀ i, ∃ π : ↥(N (i + 1)) →ₗ[R] Q i, Function.Surjective π ∧
        LinearMap.ker π = Submodule.comap (N (i + 1)).subtype (N i)) →
      ∃ N' : ℕ → Submodule T (TensorProduct R T M), Monotone N' ∧ N' 0 = ⊥ ∧
        (∀ z : TensorProduct R T M, ∃ i, z ∈ N' i) ∧
        ∀ i, ∃ π' : ↥(N' (i + 1)) →ₗ[T] TensorProduct R T (Q i), Function.Surjective π' ∧
          LinearMap.ker π' = Submodule.comap (N' (i + 1)).subtype (N' i) := by
    intro R T M _ _ _ _ _ _ N Q _ _ hNm hN0 hex hπ
    have mono : ∀ a b, a ≤ b → LinearMap.range ((N a).subtype.baseChange T) ≤
        LinearMap.range ((N b).subtype.baseChange T) := by
      intro a b hab
      have hcomp : (N a).subtype = (N b).subtype.comp (Submodule.inclusion (hNm hab)) := by
        ext x; rfl
      rw [hcomp, LinearMap.baseChange_comp]
      exact LinearMap.range_comp_le_range _ _
    refine ⟨fun i => LinearMap.range ((N i).subtype.baseChange T), ?_, ?_, ?_, ?_⟩
    · intro i j hij
      exact mono i j hij
    · show LinearMap.range ((N 0).subtype.baseChange T) = ⊥
      have h0 : (N 0).subtype = 0 := by
        ext x
        have hx : (x : M) ∈ (⊥ : Submodule R M) := hN0 ▸ x.2
        rw [Submodule.mem_bot] at hx
        simp [hx]
      rw [h0, LinearMap.baseChange_zero, LinearMap.range_zero]
    · intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, Submodule.zero_mem _⟩
      | tmul t m =>
        obtain ⟨i, hi⟩ := hex m
        exact ⟨i, ⟨t ⊗ₜ ⟨m, hi⟩, by simp⟩⟩
      | add x y hx hy =>
        obtain ⟨i, hi⟩ := hx
        obtain ⟨j, hj⟩ := hy
        exact ⟨max i j, Submodule.add_mem _ (mono i _ (le_max_left _ _) hi)
          (mono j _ (le_max_right _ _) hj)⟩
    · intro i
      obtain ⟨π, hπs, hπk⟩ := hπ i
      set ι := (N (i + 1)).subtype with hι
      set K := Submodule.comap ι (N i) with hK
      have hinj : Function.Injective (ι.baseChange T) := by
        rw [LinearMap.baseChange_eq_ltensor]
        exact Module.Flat.lTensor_preserves_injective_linearMap ι Subtype.val_injective
      let E := LinearEquiv.ofInjective (ι.baseChange T) hinj
      have hEapp : ∀ w, ((E w : TensorProduct R T M)) = ι.baseChange T w := fun w => rfl
      have hπbs : Function.Surjective (π.baseChange T) := by
        rw [LinearMap.baseChange_eq_ltensor]
        exact LinearMap.lTensor_surjective T hπs
      have hex' : Function.Exact (K.subtype.baseChange T) (π.baseChange T) := by
        have hE0 : Function.Exact K.subtype π := by
          rw [LinearMap.exact_iff, hπk, Submodule.range_subtype]
        have := lTensor_exact T hE0 hπs
        rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
        exact this
      let κ : K →ₗ[R] ↥(N i) := LinearMap.codRestrict (N i) (ι.comp K.subtype) (fun x => x.2)
      have hκ : ι.comp K.subtype = (N i).subtype.comp κ := by ext x; rfl
      have hκs : Function.Surjective (κ.baseChange T) := by
        rw [LinearMap.baseChange_eq_ltensor]
        apply LinearMap.lTensor_surjective
        intro m
        exact ⟨⟨⟨m, hNm (Nat.le_succ i) m.2⟩, m.2⟩, rfl⟩
      refine ⟨(π.baseChange T).comp E.symm.toLinearMap, ?_, ?_⟩
      · rw [LinearMap.coe_comp]
        exact hπbs.comp E.symm.surjective
      · ext y
        obtain ⟨w, rfl⟩ := E.surjective y
        rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearEquiv.coe_coe,
          LinearEquiv.symm_apply_apply, Submodule.mem_comap, Submodule.coe_subtype, hEapp, hex' w]
        constructor
        · rintro ⟨u, rfl⟩
          refine ⟨κ.baseChange T u, ?_⟩
          rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp, ← hκ, LinearMap.baseChange_comp,
            LinearMap.comp_apply]
        · rintro ⟨v, hv⟩
          obtain ⟨u, rfl⟩ := hκs v
          refine ⟨u, hinj ?_⟩
          rw [← hv, ← LinearMap.comp_apply, ← LinearMap.baseChange_comp, hκ,
            LinearMap.baseChange_comp, LinearMap.comp_apply]

  have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (n : ℕ)
      (φ : MvPolynomial (Fin (n + 1)) R →ₐ[R] S), Function.Surjective φ →
      ∃ (S' : Subalgebra R S) (ψ : MvPolynomial (Fin n) R →ₐ[R] S') (J : ℕ → Ideal S')
        (N : ℕ → Submodule R S), Function.Surjective ψ ∧ Monotone J ∧ Monotone N ∧ N 0 = ⊥ ∧
        (∀ y : S, ∃ i, y ∈ N i) ∧ ∀ i, ∃ π : ↥(N (i + 1)) →ₗ[R] (S' ⧸ J i),
          Function.Surjective π ∧ LinearMap.ker π = Submodule.comap (N (i + 1)).subtype (N i) := by
    intro R S _ _ _ n φ hφ
    set φ₀ : MvPolynomial (Fin n) R →ₐ[R] S := φ.comp (MvPolynomial.rename Fin.castSucc)
      with hφ₀
    set S' : Subalgebra R S := φ₀.range with hS'
    set x : S := φ (MvPolynomial.X (Fin.last n)) with hx
    let M : ℕ → Submodule S' S := fun i => Submodule.span S' ((fun j => x ^ j) '' Set.Iio i)
    let J : ℕ → Ideal S' := fun i =>
      Submodule.comap (LinearMap.toSpanSingleton S' S (x ^ i)) (M i)
    have hJmem : ∀ i (t : S'), t ∈ J i ↔ t • x ^ i ∈ M i := by
      intro i t
      simp only [J, Submodule.mem_comap, LinearMap.toSpanSingleton_apply]
    have hgen : ∀ i j, j < i → x ^ j ∈ M i := fun i j hj =>
      Submodule.subset_span ⟨j, hj, rfl⟩
    have hMmono : Monotone M := by
      intro i j hij
      apply Submodule.span_mono
      apply Set.image_mono
      exact Set.Iio_subset_Iio hij
    have hXmul : ∀ i, ∀ y ∈ M i, x * y ∈ M (i + 1) := by
      intro i y hy
      have hle : M i ≤ Submodule.comap (LinearMap.mulLeft S' x) (M (i + 1)) := by
        rw [Submodule.span_le]
        rintro _ ⟨j, hj, rfl⟩
        show x * x ^ j ∈ M (i + 1)
        rw [← pow_succ']
        exact hgen _ _ (by simp only [Set.mem_Iio] at hj; omega)
      exact hle hy
    have hset : ∀ i, (fun j => x ^ j) '' Set.Iio (i + 1) =
        insert (x ^ i) ((fun j => x ^ j) '' Set.Iio i) := by
      intro i
      ext z
      simp only [Set.mem_image, Set.mem_Iio, Set.mem_insert_iff]
      constructor
      · rintro ⟨j, hj, rfl⟩
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h | h
        · exact Or.inr ⟨j, h, rfl⟩
        · exact Or.inl (by rw [h])
      · rintro (rfl | ⟨j, hj, rfl⟩)
        · exact ⟨i, by omega, rfl⟩
        · exact ⟨j, by omega, rfl⟩
    refine ⟨S', φ₀.rangeRestrict, J, fun i => (M i).restrictScalars R,
      AlgHom.rangeRestrict_surjective φ₀, ?_, ?_, ?_, ?_, ?_⟩
    · apply monotone_nat_of_le_succ
      intro i t ht
      rw [hJmem] at ht ⊢
      have := hXmul i _ ht
      rwa [mul_smul_comm, ← pow_succ'] at this
    · intro i j hij
      exact hMmono hij
    · ext y
      simp [M]
    · intro y
      obtain ⟨P, rfl⟩ := hφ y
      induction P using MvPolynomial.induction_on with
      | C a =>
        refine ⟨1, ?_⟩
        show φ (MvPolynomial.C a) ∈ M 1
        have h1 : φ (MvPolynomial.C a) = a • x ^ 0 := by
          rw [pow_zero, ← MvPolynomial.algebraMap_eq, AlgHom.commutes,
            Algebra.algebraMap_eq_smul_one]
        rw [h1]
        exact Submodule.smul_of_tower_mem _ a (hgen 1 0 (by omega))
      | add P Q hP hQ =>
        obtain ⟨i, hi⟩ := hP
        obtain ⟨j, hj⟩ := hQ
        refine ⟨max i j, ?_⟩
        show φ (P + Q) ∈ M (max i j)
        rw [map_add]
        exact Submodule.add_mem _ (hMmono (le_max_left i j) hi) (hMmono (le_max_right i j) hj)
      | mul_X P k hP =>
        obtain ⟨i, hi⟩ := hP
        have hi' : φ P ∈ M i := hi
        rcases Fin.eq_castSucc_or_eq_last k with ⟨j, rfl⟩ | rfl
        · refine ⟨i, ?_⟩
          show φ (P * MvPolynomial.X (Fin.castSucc j)) ∈ M i
          have hmem : φ (MvPolynomial.X (Fin.castSucc j)) ∈ S' :=
            ⟨MvPolynomial.X j, by simp [φ₀, MvPolynomial.rename_X]⟩
          have : φ (P * MvPolynomial.X (Fin.castSucc j)) =
              (⟨φ (MvPolynomial.X (Fin.castSucc j)), hmem⟩ : S') • φ P := by
            rw [map_mul, mul_comm]
            rfl
          rw [this]
          exact Submodule.smul_mem _ _ hi'
        · refine ⟨i + 1, ?_⟩
          show φ (P * MvPolynomial.X (Fin.last n)) ∈ M (i + 1)
          rw [map_mul, mul_comm]
          exact hXmul i _ hi'
    · intro i
      set K := Submodule.comap ((M (i + 1)).restrictScalars R).subtype ((M i).restrictScalars R)
        with hK
      have hxi : ∀ t : S', t • x ^ i ∈ (M (i + 1)).restrictScalars R := fun t =>
        Submodule.smul_mem _ t (hgen (i + 1) i (by omega))
      let g : S' →ₗ[R] ↥((M (i + 1)).restrictScalars R) :=
        LinearMap.codRestrict _ ((LinearMap.toSpanSingleton S' S (x ^ i)).restrictScalars R)
          (fun t => hxi t)
      let ρ : S' →ₗ[R] ↥((M (i + 1)).restrictScalars R) ⧸ K := K.mkQ.comp g
      have hρs : Function.Surjective ρ := by
        intro w
        obtain ⟨⟨y, hy⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ w
        have hy' : y ∈ Submodule.span S' (insert (x ^ i) ((fun j => x ^ j) '' Set.Iio i)) := by
          rw [← hset]; exact hy
        obtain ⟨c, z, hz, hyz⟩ := Submodule.mem_span_insert.mp hy'
        refine ⟨c, ?_⟩
        show Submodule.Quotient.mk (g c) = Submodule.Quotient.mk ⟨y, hy⟩
        rw [Submodule.Quotient.eq]
        show ((g c - ⟨y, hy⟩ : ↥((M (i + 1)).restrictScalars R)) : S) ∈ (M i).restrictScalars R
        have hgc : ((g c : ↥((M (i + 1)).restrictScalars R)) : S) = c • x ^ i := rfl
        have : ((g c - ⟨y, hy⟩ : ↥((M (i + 1)).restrictScalars R)) : S) = -z := by
          show ((g c : ↥((M (i + 1)).restrictScalars R)) : S) - y = -z
          rw [hgc, hyz]
          abel
        rw [this]
        exact neg_mem hz
      have hρk : LinearMap.ker ρ = (J i).restrictScalars R := by
        ext t
        rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, hJmem]
        show Submodule.Quotient.mk (g t) = 0 ↔ _
        rw [Submodule.Quotient.mk_eq_zero]
        rfl
      let e := LinearMap.quotKerEquivOfSurjective ρ hρs
      let e2 := Submodule.quotEquivOfEq _ _ hρk
      let e3 := Submodule.Quotient.restrictScalarsEquiv R (J i)
      refine ⟨(e3.toLinearMap.comp e2.toLinearMap).comp (e.symm.toLinearMap.comp K.mkQ), ?_, ?_⟩
      · intro w
        obtain ⟨v, rfl⟩ := e3.surjective w
        obtain ⟨u, rfl⟩ := e2.surjective v
        obtain ⟨y, hy⟩ := Submodule.mkQ_surjective K (e u)
        refine ⟨y, ?_⟩
        simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe, hy,
          LinearEquiv.symm_apply_apply]
      · ext y
        show e3 (e2 (e.symm (K.mkQ y))) = 0 ↔ y ∈ K
        rw [LinearEquiv.map_eq_zero_iff, LinearEquiv.map_eq_zero_iff, LinearEquiv.map_eq_zero_iff,
          Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]

  intro R S _ _ _ _ _ _ hft
  obtain ⟨p, hp, s, hs, hsp⟩ := s1 R
  have Q : ∀ n : ℕ, ∀ (S : Type u) [CommRing S] [Algebra R S]
      (φ : MvPolynomial (Fin n) R →ₐ[R] S), Function.Surjective φ →
      ∃ f : R, f ∉ p ∧ Module.Projective (Localization.Away f)
        (TensorProduct R (Localization.Away f) S) := by
    intro n
    induction n with
    | zero =>
      intro S _ _ φ hφ
      apply s2 R S p s hs hsp
      intro y
      obtain ⟨P, rfl⟩ := hφ y
      obtain ⟨a, rfl⟩ := MvPolynomial.C_surjective (Fin 0) P
      exact ⟨a, by rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]⟩
    | succ n ih =>
      intro S _ _ φ hφ
      obtain ⟨S', ψ, J, N, hψ, hJ, hN, hN0, hex, hπ⟩ := s3 R S n φ hφ
      haveI : Algebra.FiniteType R S' := Algebra.FiniteType.of_surjective ψ hψ
      haveI : IsNoetherianRing S' := Algebra.FiniteType.isNoetherianRing R S'
      obtain ⟨i₀, hi₀⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) ⟨J, hJ⟩
      have hfi : ∀ i, ∃ f : R, f ∉ p ∧ Module.Projective (Localization.Away f)
          (TensorProduct R (Localization.Away f) (S' ⧸ J i)) := fun i =>
        ih (S' ⧸ J i) ((Ideal.Quotient.mkₐ R (J i)).comp ψ)
          ((Ideal.Quotient.mkₐ_surjective R (J i)).comp hψ)
      choose fi hfip hfiP using hfi
      set f := ∏ i ∈ Finset.range (i₀ + 1), fi i with hfdef
      have hfp : f ∉ p := by
        intro h
        obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (p := p)).mp h
        exact hfip i hi
      refine ⟨f, hfp, ?_⟩
      obtain ⟨N', hN'm, hN'0, hN'ex, hπ'⟩ :=
        s4 R (Localization.Away f) S N (fun i => S' ⧸ J i) hN hN0 hex hπ
      apply s5 (Localization.Away f) _ N' hN'm hN'0 hN'ex
      intro i
      obtain ⟨π', hπ's, hπ'k⟩ := hπ' i
      refine ⟨TensorProduct R (Localization.Away f) (S' ⧸ J i), inferInstance, inferInstance, ?_,
        π', hπ's, hπ'k⟩
      by_cases hi : i ≤ i₀
      · exact s6 R _ (fi i) f (Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr (by omega)))
          (hfiP i)
      · have hJeq : J i₀ = J i := hi₀ i (by omega)
        haveI := s6 R _ (fi i₀) f (Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr (by omega)))
          (hfiP i₀)
        exact Module.Projective.of_equiv
          (LinearEquiv.baseChange R (Localization.Away f) _ _
            (Ideal.quotientEquivAlgOfEq R hJeq).toLinearEquiv)
  obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
  obtain ⟨f, hf, hP⟩ := Q n S φ hφ
  exact ⟨f, fun h => hf (h ▸ p.zero_mem), hP⟩

theorem wcpa_pple_np_completion_basic : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (f : R), IsNoetherianRing (AdicCompletion (Ideal.span {f}) R) ∧ IsAdicComplete (Ideal.span {algebraMap R (AdicCompletion (Ideal.span {f}) R) f}) (AdicCompletion (Ideal.span {f}) R) :=
by
  intro R _ _ f

  have hc : ∀ (n : ℕ) (P : Polynomial R), Polynomial.eval f P -
      Polynomial.eval f (PowerSeries.trunc n (P : PowerSeries R)) ∈ Ideal.span {f} ^ n := by
    intro n P
    have hdvd : (Polynomial.X : Polynomial R) ^ n ∣ P - PowerSeries.trunc n (P : PowerSeries R) := by
      rw [Polynomial.X_pow_dvd_iff]
      intro d hd
      rw [Polynomial.coeff_sub, PowerSeries.coeff_trunc, if_pos hd, Polynomial.coeff_coe, sub_self]
    obtain ⟨Q, hQ⟩ := hdvd
    rw [← Polynomial.eval_sub, hQ, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X,
      Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    exact dvd_mul_right _ _
  let ψn : ∀ n : ℕ, PowerSeries R →+* R ⧸ Ideal.span {f} ^ n := fun n =>
    { toFun := fun F => Ideal.Quotient.mk (Ideal.span {f} ^ n)
        (Polynomial.eval f (PowerSeries.trunc n F))
      map_one' := by
        rw [← map_one (Ideal.Quotient.mk (Ideal.span {f} ^ n)), Ideal.Quotient.eq]
        have := hc n 1
        rw [Polynomial.coe_one, Polynomial.eval_one] at this
        rw [← neg_sub]
        exact neg_mem this
      map_mul' := fun F G => by
        rw [← map_mul, Ideal.Quotient.eq]
        have := hc n (PowerSeries.trunc n F * PowerSeries.trunc n G)
        rw [Polynomial.coe_mul, PowerSeries.trunc_trunc_mul_trunc, Polynomial.eval_mul] at this
        rw [← neg_sub]
        exact neg_mem this
      map_zero' := by simp
      map_add' := fun F G => by simp [map_add] }
  have hψn : ∀ n F, ψn n F = Ideal.Quotient.mk (Ideal.span {f} ^ n)
      (Polynomial.eval f (PowerSeries.trunc n F)) := fun n F => rfl
  have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorPow (Ideal.span {f}) hle).comp (ψn n) = ψn m := by
    intro m n hle
    refine RingHom.ext fun F => ?_
    rw [RingHom.comp_apply, hψn, hψn]
    rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := hc m (PowerSeries.trunc n F)
    rwa [PowerSeries.trunc_trunc_of_le _ hle] at this
  let ψ := AdicCompletion.liftRingHom (Ideal.span {f}) ψn hcompat
  have hψ : ∀ n F, AdicCompletion.evalₐ (Ideal.span {f}) n (ψ F) =
      Ideal.Quotient.mk (Ideal.span {f} ^ n) (Polynomial.eval f (PowerSeries.trunc n F)) :=
    fun n F => AdicCompletion.evalₐ_liftRingHom _ _ _ _ _
  have hsurj : Function.Surjective ψ := by
    intro x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {f}) R x
    have hcons : ∀ k, c (k + 1) - c k ∈ Ideal.span {f} ^ k := by
      intro k
      have h := AdicCompletion.AdicCauchySequence.mk_eq_mk (Nat.le_succ k) c
      rw [Submodule.Quotient.eq, Ideal.smul_eq_mul, Ideal.mul_top] at h
      exact h
    have hd : ∀ k, ∃ d : R, d * f ^ k = c (k + 1) - c k := by
      intro k
      have := hcons k
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at this
      exact this
    choose d hd using hd
    refine ⟨PowerSeries.mk (fun k => d k + if k = 0 then c 0 else 0), ?_⟩
    have hT : ∀ n, Polynomial.eval f (PowerSeries.trunc (n + 1)
        (PowerSeries.mk (fun k => d k + if k = 0 then c 0 else 0))) = c (n + 1) := by
      intro n
      induction n with
      | zero =>
        rw [PowerSeries.trunc_succ, PowerSeries.trunc_zero', zero_add, Polynomial.eval_monomial,
          PowerSeries.coeff_mk, if_pos rfl, pow_zero, mul_one]
        have := hd 0
        rw [pow_zero, mul_one] at this
        rw [this]
        ring
      | succ n ih =>
        rw [PowerSeries.trunc_succ, Polynomial.eval_add, ih, Polynomial.eval_monomial,
          PowerSeries.coeff_mk, if_neg (Nat.succ_ne_zero n), add_zero, hd]
        ring
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hψ, AdicCompletion.evalₐ_mk]
    cases n with
    | zero =>
      have : Subsingleton (R ⧸ Ideal.span {f} ^ 0) :=
        Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
      exact Subsingleton.elim _ _
    | succ n => rw [hT n]
  refine ⟨isNoetherianRing_of_surjective (PowerSeries R) _ ψ hsurj, ?_⟩
  have h2 := (IsAdicComplete.map_algebraMap_iff (S := AdicCompletion (Ideal.span {f}) R)
    (Ideal.span {f}) (AdicCompletion (Ideal.span {f}) R)).mpr
    (AdicCompletion.isAdicComplete (Submodule.fg_span_singleton f))
  rw [Ideal.map_span, Set.image_singleton] at h2
  exact h2

theorem wcpa_pple_np_faithfully_flat_cover : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (f : R), Module.FaithfullyFlat R (Localization.Away f × AdicCompletion (Ideal.span {f}) R) :=
by
  intro R _ _ f
  have hprod : ∀ (M N : Type u) [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N],
      Module.Flat R M → Module.Flat R N → Module.Flat R (M × N) := by
    intro M N _ _ _ _ hM hN
    rw [Module.Flat.iff_rTensor_preserves_injective_linearMap]
    intro P Q _ _ _ _ g hg
    have key : (TensorProduct.prodRight R R Q M N).toLinearMap ∘ₗ (g.rTensor (M × N)) =
        ((g.rTensor M).prodMap (g.rTensor N)) ∘ₗ (TensorProduct.prodRight R R P M N).toLinearMap := by
      apply TensorProduct.ext'
      intro p mn
      simp [TensorProduct.prodRight_tmul]
    have h2 : Function.Injective (((g.rTensor M).prodMap (g.rTensor N)) ∘ₗ
        (TensorProduct.prodRight R R P M N).toLinearMap) := by
      rw [LinearMap.coe_comp]
      exact (Function.Injective.prodMap (Module.Flat.rTensor_preserves_injective_linearMap g hg)
        (Module.Flat.rTensor_preserves_injective_linearMap g hg)).comp
          (TensorProduct.prodRight R R P M N).injective
    rw [← key, LinearMap.coe_comp] at h2
    exact h2.of_comp
  have hsurj : Function.Surjective (PrimeSpectrum.comap
      (algebraMap R (Localization.Away f × AdicCompletion (Ideal.span {f}) R))) := by
    intro x
    by_cases hf : f ∈ x.asIdeal
    · let π := AdicCompletion.evalₐ (Ideal.span {f}) 1
      let mk := Ideal.Quotient.mk (Ideal.span {f} ^ 1)
      have hker : RingHom.ker mk ≤ x.asIdeal := by
        rw [Ideal.mk_ker, pow_one, Ideal.span_singleton_le_iff_mem]; exact hf
      have hpb : (x.asIdeal.map mk).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
      let ρ : (Localization.Away f × AdicCompletion (Ideal.span {f}) R) →+* R ⧸ Ideal.span {f} ^ 1 :=
        (π : AdicCompletion (Ideal.span {f}) R →+* R ⧸ Ideal.span {f} ^ 1).comp (RingHom.snd _ _)
      refine ⟨⟨(x.asIdeal.map mk).comap ρ, Ideal.IsPrime.comap ρ⟩, ?_⟩
      ext1
      rw [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap]
      have hρ : ρ.comp (algebraMap R (Localization.Away f × AdicCompletion (Ideal.span {f}) R)) = mk := by
        ext r
        simp [ρ, π, mk, Prod.algebraMap_apply, AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
      rw [hρ, Ideal.comap_map_of_surjective' mk Ideal.Quotient.mk_surjective, sup_eq_left.mpr hker]
    · have hdisj : Disjoint (Submonoid.powers f : Set R) x.asIdeal := by
        rw [Set.disjoint_left]
        intro y hy hyx
        obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
        exact hf (x.isPrime.mem_of_pow_mem n hyx)
      have hQ : (x.asIdeal.map (algebraMap R (Localization.Away f))).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
          x.asIdeal x.isPrime hdisj
      refine ⟨⟨(x.asIdeal.map (algebraMap R (Localization.Away f))).comap
        (RingHom.fst (Localization.Away f) (AdicCompletion (Ideal.span {f}) R)), Ideal.IsPrime.comap _⟩, ?_⟩
      ext1
      rw [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap]
      have h1 : (RingHom.fst (Localization.Away f) (AdicCompletion (Ideal.span {f}) R)).comp
          (algebraMap R (Localization.Away f × AdicCompletion (Ideal.span {f}) R)) =
          algebraMap R (Localization.Away f) := by
        ext r; simp [Prod.algebraMap_apply]
      rw [h1]
      have := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
        x.isPrime hdisj
      rw [Ideal.under_def] at this
      exact this
  have : Module.Flat R (Localization.Away f × AdicCompletion (Ideal.span {f}) R) :=
    hprod _ _ (IsLocalization.flat _ (Submonoid.powers f)) (AdicCompletion.flat_of_isNoetherian _)
  exact Module.FaithfullyFlat.of_comap_surjective hsurj

theorem wcpa_pple_np_projective_ml : ∀ (R P : Type u) [CommRing R] [AddCommGroup P] [Module R P], Module.Projective R P → ∀ (k : ℕ) (x : (Fin k → R) →ₗ[R] P), ∃ (p : ℕ) (a : (Fin k → R) →ₗ[R] (Fin p → R)), ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.FinitePresentation R N], LinearMap.ker (a.rTensor N) = LinearMap.ker (x.rTensor N) :=
by
  intro R P _ _ _ hP k x
  classical
  obtain ⟨s, hs⟩ := Module.projective_def'.mp hP
  have hπs : ∀ m : P, Finsupp.linearCombination R id (s m) = m := fun m =>
    LinearMap.congr_fun hs m
  set E : Finset P := Finset.univ.biUnion (fun j : Fin k => (s (x (Pi.single j 1))).support)
    with hE
  set b : Fin E.card → P := fun i => ((E.equivFin.symm i : ↥E) : P) with hb
  let pr : (P →₀ R) →ₗ[R] (Fin E.card → R) := LinearMap.pi (fun i => Finsupp.lapply (b i))
  let y : (Fin E.card → R) →ₗ[R] P := Fintype.linearCombination R b
  have hsupp : ∀ v : Fin k → R, s (x v) ∈ Finsupp.supported R R (↑E : Set P) := by
    intro v
    rw [← Finset.univ_sum_single v, map_sum, map_sum]
    refine Submodule.sum_mem _ (fun j _ => ?_)
    have h1 : (Pi.single j (v j) : Fin k → R) = v j • Pi.single j 1 := by
      rw [← Pi.single_smul, smul_eq_mul, mul_one]
    rw [h1, map_smul, map_smul]
    refine Submodule.smul_mem _ _ ?_
    rw [Finsupp.mem_supported]
    intro m hm
    exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hm⟩)
  have hrec : ∀ f : P →₀ R, f ∈ Finsupp.supported R R (↑E : Set P) →
      y (pr f) = Finsupp.linearCombination R id f := by
    intro f hf
    rw [Finsupp.mem_supported] at hf
    rw [Finsupp.linearCombination_apply]
    rw [Finsupp.sum_of_support_subset f (s := E) (by exact_mod_cast hf)
      (fun i a => a • id i) (fun i _ => zero_smul R _)]
    show ∑ i, (pr f) i • b i = _
    simp only [pr, LinearMap.pi_apply, Finsupp.lapply_apply, hb, id]
    rw [Equiv.sum_comp E.equivFin.symm (fun e : ↥E => f (e : P) • (e : P))]
    exact Finset.sum_coe_sort E (fun m => f m • m)
  have hya : y ∘ₗ (pr ∘ₗ s ∘ₗ x) = x := by
    apply LinearMap.ext
    intro v
    show y (pr (s (x v))) = x v
    rw [hrec _ (hsupp v), hπs]
  refine ⟨E.card, pr ∘ₗ s ∘ₗ x, fun N _ _ _ => le_antisymm ?_ ?_⟩
  · intro z hz
    rw [LinearMap.mem_ker] at hz ⊢
    rw [← hya, LinearMap.rTensor_comp_apply, hz, map_zero]
  · intro z hz
    rw [LinearMap.mem_ker] at hz ⊢
    have : pr ∘ₗ s ∘ₗ x = (pr ∘ₗ s) ∘ₗ x := rfl
    rw [this, LinearMap.rTensor_comp_apply, hz, map_zero]

theorem wcpa_pple_np_ml_descent : ∀ (R T M : Type u) [CommRing R] [CommRing T] [Algebra R T] [AddCommGroup M] [Module R M], Module.FaithfullyFlat R T → Module.Flat R M → (∀ (k : ℕ) (x : (Fin k → T) →ₗ[T] TensorProduct R T M), ∃ (p : ℕ) (a : (Fin k → T) →ₗ[T] (Fin p → T)), ∀ (N : Type u) [AddCommGroup N] [Module T N] [Module.FinitePresentation T N], LinearMap.ker (a.rTensor N) = LinearMap.ker (x.rTensor N)) → ∀ (k : ℕ) (x : (Fin k → R) →ₗ[R] M), ∃ (p : ℕ) (a : (Fin k → R) →ₗ[R] (Fin p → R)), ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.FinitePresentation R N], LinearMap.ker (a.rTensor N) = LinearMap.ker (x.rTensor N) :=
by
  have s1 : ∀ (R : Type u) [CommRing R] (k p : ℕ) (M : Type u) [AddCommGroup M] [Module R M] (a : (Fin k → R) →ₗ[R] (Fin p → R)) (x : (Fin k → R) →ₗ[R] M), (∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.FinitePresentation R N], LinearMap.ker (a.rTensor N) ≤ LinearMap.ker (x.rTensor N)) → ∃ h : (Fin p → R) →ₗ[R] M, h ∘ₗ a = x := by
    intro R _ k p M _ _ a x hker
    classical
    let e : Fin k → (Fin k → R) := fun j => Pi.single j 1
    let av : (Fin p → R) →ₗ[R] (Fin k → R) :=
      ∑ i, (LinearMap.proj i : (Fin p → R) →ₗ[R] R).smulRight (∑ j, a (e j) i • e j)
    have hav : ∀ i, av (Pi.single i 1) = ∑ j, a (e j) i • e j := by
      intro i
      simp [av, Pi.single_apply]
    let K := LinearMap.range av
    let π := K.mkQ
    haveI : Module.FinitePresentation R ((Fin k → R) ⧸ K) := by
      apply Module.finitePresentation_of_surjective π (Submodule.mkQ_surjective K)
      rw [Submodule.ker_mkQ, show K = Submodule.map av ⊤ from LinearMap.range_eq_map av]
      exact (Module.Finite.fg_top).map av
    have hdec : ∀ v : Fin p → R, v = ∑ i, v i • (Pi.single i 1 : Fin p → R) := by
      intro v
      ext l
      simp [Pi.single_apply]
    let ξ : TensorProduct R (Fin k → R) ((Fin k → R) ⧸ K) := ∑ j, e j ⊗ₜ π (e j)
    have hξ : a.rTensor _ ξ = 0 := by
      calc a.rTensor _ ξ = ∑ j, a (e j) ⊗ₜ π (e j) := by simp [ξ, map_sum]
      _ = ∑ j, ∑ i, (Pi.single i 1 : Fin p → R) ⊗ₜ (a (e j) i • π (e j)) := by
          refine Finset.sum_congr rfl fun j _ => ?_
          conv_lhs => rw [hdec (a (e j))]
          rw [TensorProduct.sum_tmul]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [TensorProduct.smul_tmul]
      _ = ∑ i, (Pi.single i 1 : Fin p → R) ⊗ₜ π (av (Pi.single i 1)) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hav, map_sum, TensorProduct.tmul_sum]
          simp only [map_smul]
      _ = 0 := by
          refine Finset.sum_eq_zero fun i _ => ?_
          rw [show π (av (Pi.single i 1)) = 0 from
            (Submodule.Quotient.mk_eq_zero K).mpr (LinearMap.mem_range_self av _), TensorProduct.tmul_zero]
    have hxξ : x.rTensor _ ξ = 0 := hker _ (LinearMap.mem_ker.mpr hξ)
    have hex : Function.Exact (av.lTensor M) (π.lTensor M) :=
      lTensor_exact M (LinearMap.exact_iff.mpr (Submodule.ker_mkQ K)) (Submodule.mkQ_surjective K)
    let z : TensorProduct R M (Fin k → R) := ∑ j, x (e j) ⊗ₜ e j
    have hz : π.lTensor M z = 0 := by
      have : π.lTensor M z = x.rTensor _ ξ := by simp [z, ξ, map_sum]
      rw [this, hxξ]
    obtain ⟨w, hw⟩ := (hex z).mp hz
    let Φ : (n : ℕ) → Fin n → (TensorProduct R M (Fin n → R) →ₗ[R] M) := fun n j =>
      (TensorProduct.rid R M).toLinearMap ∘ₗ (LinearMap.proj j : (Fin n → R) →ₗ[R] R).lTensor M
    have hΦ : ∀ n (j : Fin n) (m : M) (v : Fin n → R), Φ n j (m ⊗ₜ v) = v j • m := by
      intro n j m v
      simp [Φ]
    let m : Fin p → M := fun i => Φ p i w
    refine ⟨∑ i, (LinearMap.proj i : (Fin p → R) →ₗ[R] R).smulRight (m i), ?_⟩
    have key : ∀ j : Fin k, (Φ k j) ∘ₗ av.lTensor M = ∑ i, a (e j) i • Φ p i := by
      intro j
      apply TensorProduct.ext'
      intro m0 v
      have : av v j = ∑ i, a (e j) i * v i := by
        simp [av, e, Pi.single_apply, LinearMap.sum_apply, Finset.sum_apply, mul_comm]
      rw [LinearMap.comp_apply, LinearMap.lTensor_tmul, hΦ, this, LinearMap.sum_apply, Finset.sum_smul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [LinearMap.smul_apply, hΦ, mul_smul]
    apply LinearMap.pi_ext'
    intro j
    apply LinearMap.ext_ring
    have e1 : x (e j) = Φ k j z := by
      simp [z, map_sum, hΦ, e, Pi.single_apply]
    have e2 : Φ k j z = ∑ i, a (e j) i • m i := by
      rw [← hw]
      have := LinearMap.congr_fun (key j) w
      rw [LinearMap.comp_apply] at this
      rw [this, LinearMap.sum_apply]
      rfl
    simp only [LinearMap.comp_apply, LinearMap.single_apply, LinearMap.sum_apply,
      LinearMap.smulRight_apply, LinearMap.proj_apply]
    rw [show (Pi.single j 1 : Fin k → R) = e j from rfl, e1, e2]
  have s2 : ∀ (R T M : Type u) [CommRing R] [CommRing T] [Algebra R T] [AddCommGroup M] [Module R M] (p : ℕ) (h : (Fin p → T) →ₗ[T] TensorProduct R T M), ∃ (q : ℕ) (φ : (Fin q → R) →ₗ[R] M) (c : (Fin p → T) →ₗ[T] TensorProduct R T (Fin q → R)), φ.baseChange T ∘ₗ c = h := by
    intro R T M _ _ _ _ _ p h
    classical
    choose S hS using fun i : Fin p => TensorProduct.exists_finset (h (Pi.single i 1))
    let ε := Fintype.equivFin (Σ i : Fin p, (S i))
    let φ : (Fin (Fintype.card (Σ i : Fin p, (S i))) → R) →ₗ[R] M :=
      ∑ l, (LinearMap.proj l : (Fin _ → R) →ₗ[R] R).smulRight ((ε.symm l).2.1.2)
    let c : (Fin p → T) →ₗ[T] TensorProduct R T (Fin (Fintype.card (Σ i : Fin p, (S i))) → R) :=
      ∑ i, (LinearMap.proj i : (Fin p → T) →ₗ[T] T).smulRight
        (∑ l, (if (ε.symm l).1 = i then (ε.symm l).2.1.1 else 0) ⊗ₜ[R] (Pi.single l 1 : Fin _ → R))
    refine ⟨_, φ, c, ?_⟩
    apply LinearMap.pi_ext'
    intro i
    apply LinearMap.ext_ring
    have hc : c (Pi.single i 1) =
        ∑ l, (if (ε.symm l).1 = i then (ε.symm l).2.1.1 else 0) ⊗ₜ[R] (Pi.single l 1 : Fin _ → R) := by
      simp [c, Pi.single_apply]
    have hφ : ∀ l, φ (Pi.single l 1) = (ε.symm l).2.1.2 := by
      intro l
      simp [φ, Pi.single_apply]
    simp only [LinearMap.comp_apply, LinearMap.single_apply]
    rw [hc, map_sum, hS i]
    simp only [LinearMap.baseChange_tmul, hφ]
    rw [Fintype.sum_equiv ε.symm _
      (fun σ : (Σ i : Fin p, (S i)) => (if σ.1 = i then σ.2.1.1 else 0) ⊗ₜ[R] σ.2.1.2) (fun l => rfl)]
    rw [Fintype.sum_sigma, Finset.sum_eq_single i]
    · simp only
      exact Finset.sum_coe_sort (S i) (fun s => s.1 ⊗ₜ[R] s.2)
    · intro b _ hb
      simp [hb]
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  have s3 : ∀ (R T M F : Type u) [CommRing R] [CommRing T] [Algebra R T] [AddCommGroup M] [Module R M] [AddCommGroup F] [Module R F] [Module.Free R F] [Module.Finite R F], Module.Flat R T → Module.Flat R M → ∀ (p : ℕ) (ψ : F →ₗ[R] M) (β : (Fin p → T) →ₗ[T] TensorProduct R T F), ψ.baseChange T ∘ₗ β = 0 → ∃ (q : ℕ) (b : F →ₗ[R] (Fin q → R)) (y : (Fin q → R) →ₗ[R] M), y ∘ₗ b = ψ ∧ b.baseChange T ∘ₗ β = 0 := by
    intro R T M F _ _ _ _ _ _ _ _ _ hT hM p ψ β hψβ
    classical
    have hmem : ∀ j : Fin p, β (Pi.single j 1) ∈
        LinearMap.range ((LinearMap.ker ψ).subtype.baseChange T) := by
      intro j
      have h1 : β (Pi.single j 1) ∈ LinearMap.ker (ψ.baseChange T) := by
        rw [LinearMap.mem_ker, ← LinearMap.comp_apply, hψβ, LinearMap.zero_apply]
      have h2 := Module.Flat.ker_lTensor_eq (R := R) (S := T) (M := T) ψ
      rw [show ψ.baseChange T = TensorProduct.AlgebraTensorModule.lTensor T T ψ from rfl, h2] at h1
      exact h1
    choose w hw using hmem
    choose S hS using fun j => TensorProduct.exists_finset (w j)
    let G : Finset F := Finset.univ.biUnion (fun j => (S j).image (fun s => ((s.2 : LinearMap.ker ψ) : F)))
    let K0 := Submodule.span R (G : Set F)
    have hK0le : K0 ≤ LinearMap.ker ψ := by
      rw [Submodule.span_le]
      intro v hv
      simp only [G, Finset.coe_biUnion, Finset.coe_image, Set.mem_iUnion, Set.mem_image] at hv
      obtain ⟨j, _, s, _, rfl⟩ := hv
      exact s.2.2
    have hK0 : ψ ∘ₗ K0.subtype = 0 := by
      ext ⟨v, hv⟩
      exact hK0le hv
    obtain ⟨q, a0, y0, hxa, ha0⟩ := Module.Flat.exists_factorization_of_comp_eq_zero_of_free hK0
    let ι := Finsupp.linearEquivFunOnFinite R R (Fin q)
    refine ⟨q, ι.toLinearMap ∘ₗ a0, y0 ∘ₗ ι.symm.toLinearMap, ?_, ?_⟩
    · rw [hxa]
      ext v
      simp
    · apply LinearMap.pi_ext'
      intro j
      apply LinearMap.ext_ring
      simp only [LinearMap.comp_apply, LinearMap.single_apply, LinearMap.zero_apply]
      rw [← hw j, hS j, map_sum, map_sum]
      refine Finset.sum_eq_zero fun s hs => ?_
      rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul]
      have hsK : ((s.2 : LinearMap.ker ψ) : F) ∈ K0 := by
        apply Submodule.subset_span
        simp only [G, Finset.coe_biUnion, Finset.coe_image, Set.mem_iUnion, Set.mem_image]
        exact ⟨j, Finset.mem_coe.mpr (Finset.mem_univ j), s, hs, rfl⟩
      have h0 : a0 ((s.2 : LinearMap.ker ψ) : F) = 0 := by
        have := LinearMap.congr_fun ha0 ⟨_, hsK⟩
        simpa using this
      simp [h0]
  have s4 : ∀ (R T P Q : Type u) [CommRing R] [CommRing T] [Algebra R T] [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q], Module.FaithfullyFlat R T → ∀ (k : ℕ) (f : (Fin k → R) →ₗ[R] P) (g : (Fin k → R) →ₗ[R] Q), (∀ (N : Type u) [AddCommGroup N] [Module T N] [Module.FinitePresentation T N], LinearMap.ker ((f.baseChange T ∘ₗ (TensorProduct.piScalarRight R T T (Fin k)).symm.toLinearMap).rTensor N) ≤ LinearMap.ker ((g.baseChange T ∘ₗ (TensorProduct.piScalarRight R T T (Fin k)).symm.toLinearMap).rTensor N)) → ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.FinitePresentation R N], LinearMap.ker (f.rTensor N) ≤ LinearMap.ker (g.rTensor N) := by
    intro R T P Q _ _ _ _ _ _ _ hff k f g hT N _ _ _ z hz
    rw [LinearMap.mem_ker] at hz ⊢
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset z
    let ζ : TensorProduct T (Fin k → T) (TensorProduct R T N) :=
      ∑ s ∈ S, (TensorProduct.piScalarRight R T T (Fin k) ((1 : T) ⊗ₜ[R] s.1)) ⊗ₜ[T] ((1 : T) ⊗ₜ[R] s.2)
    have key : ∀ (X : Type u) [AddCommGroup X] [Module R X] (h : (Fin k → R) →ₗ[R] X),
        (h.baseChange T ∘ₗ (TensorProduct.piScalarRight R T T (Fin k)).symm.toLinearMap).rTensor
            (TensorProduct R T N) ζ =
          TensorProduct.AlgebraTensorModule.distribBaseChange R T X N ((1 : T) ⊗ₜ[R] (h.rTensor N z)) := by
      intro X _ _ h
      rw [hS]
      simp only [ζ, map_sum, TensorProduct.tmul_sum, LinearMap.rTensor_tmul, LinearMap.comp_apply,
        LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply, LinearMap.baseChange_tmul,
        TensorProduct.AlgebraTensorModule.distribBaseChange_tmul]
    have h1 : ζ ∈ LinearMap.ker ((f.baseChange T ∘ₗ (TensorProduct.piScalarRight R T T (Fin k)).symm.toLinearMap).rTensor (TensorProduct R T N)) := by
      rw [LinearMap.mem_ker, key P f, hz, TensorProduct.tmul_zero, map_zero]
    have h2 := hT (TensorProduct R T N) h1
    rw [LinearMap.mem_ker, key Q g] at h2
    have h3 : (1 : T) ⊗ₜ[R] (g.rTensor N z) = 0 :=
      (TensorProduct.AlgebraTensorModule.distribBaseChange R T Q N).injective (h2.trans (map_zero _).symm)
    haveI := hff
    apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := R) (B := T) (M := TensorProduct R Q N)
    rw [TensorProduct.mk_apply, TensorProduct.mk_apply, h3, TensorProduct.tmul_zero]
  intro R T M _ _ _ _ _ hff hM hyp k x
  haveI := hff
  have hTfl : Module.Flat R T := inferInstance
  let σ : (Fin k → T) →ₗ[T] TensorProduct R T (Fin k → R) :=
    (TensorProduct.piScalarRight R T T (Fin k)).symm.toLinearMap
  obtain ⟨p, a', ha'⟩ := hyp k (x.baseChange T ∘ₗ σ)
  obtain ⟨h', hh'⟩ := s1 T k p (TensorProduct R T M) a'
    (x.baseChange T ∘ₗ σ) (fun N _ _ _ => (ha' N).le)
  obtain ⟨q, φ₀, c, hc⟩ := s2 R T M p h'
  let ψ : ((Fin k → R) × (Fin q → R)) →ₗ[R] M := x.coprod (-φ₀)
  let β : (Fin k → T) →ₗ[T] TensorProduct R T ((Fin k → R) × (Fin q → R)) :=
    (LinearMap.inl R (Fin k → R) (Fin q → R)).baseChange T ∘ₗ σ +
      (LinearMap.inr R (Fin k → R) (Fin q → R)).baseChange T ∘ₗ (c ∘ₗ a')
  have hψβ : ψ.baseChange T ∘ₗ β = 0 := by
    have e1 : ψ.baseChange T ∘ₗ β = (ψ ∘ₗ LinearMap.inl R (Fin k → R) (Fin q → R)).baseChange T ∘ₗ σ +
        (ψ ∘ₗ LinearMap.inr R (Fin k → R) (Fin q → R)).baseChange T ∘ₗ (c ∘ₗ a') := by
      simp only [β, LinearMap.comp_add, LinearMap.baseChange_comp, LinearMap.comp_assoc]
    rw [e1]
    simp only [ψ, LinearMap.coprod_inl, LinearMap.coprod_inr, LinearMap.baseChange_neg,
      LinearMap.neg_comp]
    rw [← LinearMap.comp_assoc, hc, ← hh']
    exact LinearMap.ext fun v => by simp
  obtain ⟨q₂, b, y, hyb, hbβ⟩ := s3 R T M ((Fin k → R) × (Fin q → R))
    hTfl hM k ψ β hψβ
  let a : (Fin k → R) →ₗ[R] (Fin q₂ → R) := b ∘ₗ LinearMap.inl R (Fin k → R) (Fin q → R)
  have hya : y ∘ₗ a = x := by
    show y ∘ₗ (b ∘ₗ LinearMap.inl R (Fin k → R) (Fin q → R)) = x
    rw [← LinearMap.comp_assoc, hyb]
    exact LinearMap.coprod_inl x (-φ₀)
  have haσ : a.baseChange T ∘ₗ σ =
      (-((b ∘ₗ LinearMap.inr R (Fin k → R) (Fin q → R)).baseChange T ∘ₗ c)) ∘ₗ a' := by
    have e2 : b.baseChange T ∘ₗ β = a.baseChange T ∘ₗ σ +
        ((b ∘ₗ LinearMap.inr R (Fin k → R) (Fin q → R)).baseChange T ∘ₗ c) ∘ₗ a' := by
      simp only [β, a, LinearMap.comp_add, LinearMap.baseChange_comp, LinearMap.comp_assoc]
    rw [hbβ] at e2
    refine LinearMap.ext fun v => ?_
    have e3 := LinearMap.congr_fun e2 v
    simp only [LinearMap.zero_apply, LinearMap.add_apply] at e3
    simp only [LinearMap.comp_apply, LinearMap.neg_apply] at e3 ⊢
    exact eq_neg_of_add_eq_zero_left e3.symm
  refine ⟨q₂, a, fun N _ _ _ => le_antisymm ?_ ?_⟩
  · have hle := LinearMap.ker_le_ker_comp (a.rTensor N) (y.rTensor N)
    rwa [← LinearMap.rTensor_comp, hya] at hle
  · refine s4 R T M (Fin q₂ → R) hff k x a (fun N' _ _ _ => ?_) N
    show LinearMap.ker ((x.baseChange T ∘ₗ σ).rTensor N') ≤ LinearMap.ker ((a.baseChange T ∘ₗ σ).rTensor N')
    rw [← ha' N', haσ, LinearMap.rTensor_comp]
    exact LinearMap.ker_le_ker_comp _ _

theorem wcpa_pple_np_projective_of_ml : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M], Module.Flat R M → (∃ e : ℕ → M, Submodule.span R (Set.range e) = ⊤) → (∀ (k : ℕ) (x : (Fin k → R) →ₗ[R] M), ∃ (p : ℕ) (a : (Fin k → R) →ₗ[R] (Fin p → R)), ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.FinitePresentation R N], LinearMap.ker (a.rTensor N) = LinearMap.ker (x.rTensor N)) → Module.Projective R M :=
by
  intro R M _ _ _ _hflat hgen hML
  classical

  have cF : ∀ (P : Type u) [AddCommGroup P] [Module R P] (k p : ℕ)
      (a : (Fin k → R) →ₗ[R] (Fin p → R)) (x : (Fin k → R) →ₗ[R] P),
      (∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.FinitePresentation R N],
        LinearMap.ker (a.rTensor N) ≤ LinearMap.ker (x.rTensor N)) →
      ∃ h : (Fin p → R) →ₗ[R] P, h ∘ₗ a = x := by
    intro M _ _ k p a x hax
    let u : Fin p → (Fin k → R) := fun i j => a (Pi.single j 1) i
    let g : (Fin p → R) →ₗ[R] (Fin k → R) := Fintype.linearCombination R u
    let Q : Submodule R (Fin k → R) := LinearMap.range g
    have hQfg : Q.FG := by
      show (LinearMap.range g).FG
      rw [Fintype.range_linearCombination]
      exact Submodule.fg_span (Set.finite_range u)
    have : Module.FinitePresentation R ((Fin k → R) ⧸ Q) :=
      Module.finitePresentation_of_free_of_surjective Q.mkQ (Submodule.mkQ_surjective Q)
        (by rw [Submodule.ker_mkQ]; exact hQfg)
    let N := (Fin k → R) ⧸ Q
    let ξ : TensorProduct R (Fin k → R) N :=
      ∑ j : Fin k, (Pi.single j 1 : Fin k → R) ⊗ₜ[R] Q.mkQ (Pi.single j 1)
    have hu : ∀ i, Q.mkQ (u i) = 0 := by
      intro i
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨Pi.single i 1, by simp [g]⟩
    have hsingle : ∀ (n : ℕ) (v : Fin n → R),
        ∑ j : Fin n, v j • (Pi.single j 1 : Fin n → R) = v := by
      intro n v
      conv_rhs => rw [← Finset.univ_sum_single v]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ext l
      by_cases hl : l = j
      · subst hl; simp
      · simp [hl]
    have hξ : a.rTensor N ξ = 0 := by
      simp only [ξ, map_sum, LinearMap.rTensor_tmul]
      have e : ∀ j : Fin k, a (Pi.single j 1) ⊗ₜ[R] Q.mkQ (Pi.single j 1 : Fin k → R) =
          ∑ i : Fin p, (Pi.single i 1 : Fin p → R) ⊗ₜ[R]
            (a (Pi.single j 1) i • Q.mkQ (Pi.single j 1 : Fin k → R)) := by
        intro j
        conv_lhs => rw [← hsingle p (a (Pi.single j 1))]
        rw [TensorProduct.sum_tmul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [TensorProduct.smul_tmul]
      rw [Finset.sum_congr rfl (fun j _ => e j), Finset.sum_comm]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [← TensorProduct.tmul_sum]
      have : ∑ j : Fin k, a (Pi.single j 1) i • Q.mkQ (Pi.single j 1 : Fin k → R) =
          Q.mkQ (u i) := by
        simp only [← map_smul, ← map_sum]
        rw [hsingle k (u i)]
      rw [this, hu, TensorProduct.tmul_zero]
    have hxξ : x.rTensor N ξ = 0 := hax N hξ
    have hex : Function.Exact g Q.mkQ := by
      rw [LinearMap.exact_iff, Submodule.ker_mkQ]
    have hexM := lTensor_exact M hex (Submodule.mkQ_surjective Q)
    let Θ : TensorProduct R M (Fin k → R) :=
      ∑ j : Fin k, x (Pi.single j 1) ⊗ₜ[R] (Pi.single j 1 : Fin k → R)
    have hΘ : LinearMap.lTensor M Q.mkQ Θ = 0 := by
      rw [← hxξ]
      simp only [Θ, ξ, map_sum, LinearMap.lTensor_tmul, LinearMap.rTensor_tmul]
    obtain ⟨Ω, hΩ⟩ := (hexM Θ).mp hΘ
    let ev : ∀ n : ℕ, TensorProduct R M (Fin n → R) →ₗ[R] (Fin n → M) := fun n =>
      TensorProduct.lift (LinearMap.mk₂ R (fun (m : M) (v : Fin n → R) (j : Fin n) => v j • m)
        (fun m₁ m₂ v => by ext j; simp [smul_add])
        (fun c m v => by ext j; simp [smul_comm c])
        (fun m v₁ v₂ => by ext j; simp [add_smul])
        (fun c m v => by ext j; simp [mul_smul]))
    have hev : ∀ (n : ℕ) (m : M) (v : Fin n → R) (j : Fin n), ev n (m ⊗ₜ[R] v) j = v j • m := by
      intro n m v j
      rfl
    have hevΘ : ∀ j, ev k Θ j = x (Pi.single j 1) := by
      intro j
      simp only [Θ, map_sum, Finset.sum_apply, hev]
      rw [Finset.sum_eq_single j]
      · simp
      · intro b _ hb
        simp [Ne.symm hb]
      · simp
    have hevg : ∀ (ω : TensorProduct R M (Fin p → R)) (j : Fin k),
        ev k (LinearMap.lTensor M g ω) j = ∑ i : Fin p, u i j • ev p ω i := by
      intro ω j
      induction ω using TensorProduct.induction_on with
      | zero => simp
      | tmul m v =>
        rw [LinearMap.lTensor_tmul, hev]
        simp only [hev, g, Fintype.linearCombination_apply, Finset.sum_apply, Pi.smul_apply,
          smul_eq_mul, Finset.sum_smul, mul_smul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [smul_comm]
      | add ω₁ ω₂ h₁ h₂ =>
        rw [map_add, map_add, Pi.add_apply, h₁, h₂, map_add]
        simp only [Pi.add_apply, smul_add, Finset.sum_add_distrib]
    let mm : Fin p → M := ev p Ω
    refine ⟨Fintype.linearCombination R mm, ?_⟩
    apply LinearMap.pi_ext'
    intro j
    apply LinearMap.ext_ring
    simp only [LinearMap.comp_apply, LinearMap.coe_single, Fintype.linearCombination_apply]
    rw [← hevΘ j, ← hΩ, hevg]

  have ST : ∀ (k : ℕ) (x : (Fin k → R) →ₗ[R] M), ∃ (p : ℕ) (a : (Fin k → R) →ₗ[R] (Fin p → R))
      (h : (Fin p → R) →ₗ[R] M), h ∘ₗ a = x ∧ LinearMap.ker x ≤ LinearMap.ker a ∧
      ∀ (q : ℕ) (g : (Fin p → R) →ₗ[R] (Fin q → R)) (ψ : (Fin q → R) →ₗ[R] M), ψ ∘ₗ g = h →
        ∃ w : (Fin q → R) →ₗ[R] (Fin p → R), w ∘ₗ g ∘ₗ a = a := by
    intro k x
    obtain ⟨p, a, ha⟩ := hML k x
    obtain ⟨h, hh⟩ := cF M k p a x (fun N _ _ _ => (ha N).le)
    refine ⟨p, a, h, hh, ?_, ?_⟩
    · intro z hz
      rw [LinearMap.mem_ker] at hz ⊢
      have h1 : z ⊗ₜ[R] (1 : R) ∈ LinearMap.ker (x.rTensor R) := by
        rw [LinearMap.mem_ker, LinearMap.rTensor_tmul, hz, TensorProduct.zero_tmul]
      rw [← ha R, LinearMap.mem_ker, LinearMap.rTensor_tmul] at h1
      have h2 := congrArg (TensorProduct.rid R (Fin p → R)) h1
      rwa [TensorProduct.rid_tmul, one_smul, map_zero] at h2
    · intro q g ψ hψ
      refine cF (Fin p → R) k q (g ∘ₗ a) a (fun N _ _ _ => ?_)
      intro t ht
      rw [ha N, LinearMap.mem_ker]
      rw [LinearMap.mem_ker] at ht
      rw [← hh, ← hψ, LinearMap.comp_assoc, LinearMap.rTensor_comp_apply, ht, map_zero]

  have tower : ∃ (r : ℕ → ℕ) (φ : ∀ n, (Fin (r n) → R) →ₗ[R] M)
      (f : ∀ n, (Fin (r n) → R) →ₗ[R] (Fin (r (n + 1)) → R)),
      (∀ n, φ (n + 1) ∘ₗ f n = φ n) ∧ (∀ n, LinearMap.ker (φ n) ≤ LinearMap.ker (f n)) ∧
      (∀ n, ∃ w : (Fin (r (n + 1 + 1)) → R) →ₗ[R] (Fin (r (n + 1)) → R),
        w ∘ₗ f (n + 1) ∘ₗ f n = f n) ∧
      (∀ m : M, ∃ (n : ℕ) (z : Fin (r n) → R), φ n z = m) := by
    obtain ⟨e, he⟩ := hgen
    choose P A H hHA hker hw using ST
    let X : ∀ (n r : ℕ), ((Fin r → R) →ₗ[R] M) → ((Fin (r + 1) → R) →ₗ[R] M) := fun n r φ =>
      φ ∘ₗ LinearMap.funLeft R R Fin.castSucc + (LinearMap.proj (Fin.last r)).smulRight (e n)
    let stage : ℕ → Σ r : ℕ, (Fin r → R) →ₗ[R] M := fun n =>
      Nat.rec (motive := fun _ => Σ r : ℕ, (Fin r → R) →ₗ[R] M) ⟨0, 0⟩
        (fun n s => ⟨P (s.1 + 1) (X n s.1 s.2), H (s.1 + 1) (X n s.1 s.2)⟩) n
    let r : ℕ → ℕ := fun n => (stage n).1
    let φ : ∀ n, (Fin (r n) → R) →ₗ[R] M := fun n => (stage n).2
    let ι : ∀ r : ℕ, (Fin r → R) →ₗ[R] (Fin (r + 1) → R) := fun r =>
      { toFun := fun v => Fin.snoc v 0
        map_add' := fun v w => by
          ext i
          refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
        map_smul' := fun c v => by
          ext i
          refine Fin.lastCases ?_ (fun j => ?_) i <;> simp }
    let f : ∀ n, (Fin (r n) → R) →ₗ[R] (Fin (r (n + 1)) → R) := fun n =>
      A (r n + 1) (X n (r n) (φ n)) ∘ₗ ι (r n)
    have hα : ∀ n (v : Fin (r n) → R), X n (r n) (φ n) (ι (r n) v) = φ n v := by
      intro n v
      simp only [X, ι, LinearMap.add_apply, LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk,
        LinearMap.smulRight_apply, LinearMap.proj_apply, Fin.snoc_last, zero_smul, add_zero]
      congr 1
      ext i
      simp [LinearMap.funLeft_apply]
    have hβ : ∀ n, X n (r n) (φ n) (Pi.single (Fin.last _) 1) = e n := by
      intro n
      simp only [X, LinearMap.add_apply, LinearMap.comp_apply,
        LinearMap.smulRight_apply, LinearMap.proj_apply, Pi.single_eq_same, one_smul]
      have : LinearMap.funLeft R R Fin.castSucc (Pi.single (Fin.last (r n)) (1 : R)) = 0 := by
        ext i
        simp [LinearMap.funLeft_apply, Fin.castSucc_ne_last]
      rw [this, map_zero, zero_add]
    have hT : ∀ n, φ (n + 1) ∘ₗ f n = φ n := by
      intro n
      apply LinearMap.ext
      intro v
      show φ (n + 1) (A (r n + 1) (X n (r n) (φ n)) (ι (r n) v)) = φ n v
      exact (LinearMap.congr_fun (hHA (r n + 1) (X n (r n) (φ n))) (ι (r n) v)).trans (hα n v)
    refine ⟨r, φ, f, hT, ?_, ?_, ?_⟩
    · intro n v hv
      rw [LinearMap.mem_ker] at hv ⊢
      show A (r n + 1) (X n (r n) (φ n)) (ι (r n) v) = 0
      apply hker
      rw [LinearMap.mem_ker, hα, hv]
    · intro n
      obtain ⟨w, hw'⟩ := hw (r n + 1) (X n (r n) (φ n)) (r (n + 1 + 1)) (f (n + 1))
        (φ (n + 1 + 1)) (hT (n + 1))
      refine ⟨w, ?_⟩
      apply LinearMap.ext
      intro v
      have := LinearMap.congr_fun hw' (ι (r n) v)
      exact this
    · have hmono : Monotone (fun n => LinearMap.range (φ n)) := by
        apply monotone_nat_of_le_succ
        intro n
        rw [← hT n]
        exact LinearMap.range_comp_le_range _ _
      have hle : Submodule.span R (Set.range e) ≤ ⨆ n, LinearMap.range (φ n) := by
        rw [Submodule.span_le]
        rintro _ ⟨n, rfl⟩
        apply Submodule.mem_iSup_of_mem (n + 1)
        refine ⟨A (r n + 1) (X n (r n) (φ n)) (Pi.single (Fin.last _) 1), ?_⟩
        exact (LinearMap.congr_fun (hHA (r n + 1) (X n (r n) (φ n))) _).trans (hβ n)
      intro m
      have hm : m ∈ ⨆ n, LinearMap.range (φ n) := hle (he ▸ Submodule.mem_top)
      rw [Submodule.mem_iSup_of_directed _ hmono.directed_le] at hm
      obtain ⟨n, z, hz⟩ := hm
      exact ⟨n, z, hz⟩
  obtain ⟨r, φ, f, hT, hK, hS, hsurj⟩ := tower

  refine Module.Projective.of_lifting_property'' (fun π hπ => ?_)

  have lifts : ∃ β : ∀ n, (Fin (r n) → R) →ₗ[R] (M →₀ R),
      (∀ n, π ∘ₗ β n = φ n) ∧ (∀ n, β (n + 1) ∘ₗ f n = β n) := by
    choose w hw using hS
    have hδ : ∀ m, ∃ δ : (Fin (r m) → R) →ₗ[R] (M →₀ R), π ∘ₗ δ = φ m :=
      fun m => Module.projective_lifting_property π (φ m) hπ
    choose δ hδ using hδ
    let γ : ∀ n, (Fin (r (n + 1)) → R) →ₗ[R] (M →₀ R) := fun n =>
      Nat.rec (motive := fun n => (Fin (r (n + 1)) → R) →ₗ[R] (M →₀ R)) (δ 1)
        (fun n g => δ (n + 1 + 1) + (g - δ (n + 1 + 1) ∘ₗ f (n + 1)) ∘ₗ w n) n
    have hγ0 : γ 0 = δ 1 := rfl
    have hγs : ∀ n, γ (n + 1) = δ (n + 1 + 1) + (γ n - δ (n + 1 + 1) ∘ₗ f (n + 1)) ∘ₗ w n :=
      fun n => rfl
    have hπγ : ∀ n, π ∘ₗ γ n = φ (n + 1) := by
      intro n
      induction n with
      | zero => rw [hγ0, hδ]
      | succ n ih =>
        rw [hγs]
        apply LinearMap.ext
        intro v
        have e1 := LinearMap.congr_fun ih (w n v)
        have e2 := LinearMap.congr_fun (hδ (n + 1 + 1)) v
        have e3 := LinearMap.congr_fun (hδ (n + 1 + 1)) (f (n + 1) (w n v))
        have e4 := LinearMap.congr_fun (hT (n + 1)) (w n v)
        simp only [LinearMap.comp_apply] at e1 e2 e3 e4
        simp only [LinearMap.comp_apply, LinearMap.add_apply, LinearMap.sub_apply, map_add,
          map_sub, e1, e2, e3, e4, sub_self, add_zero]
    refine ⟨fun n => γ n ∘ₗ f n, fun n => ?_, fun n => ?_⟩
    · apply LinearMap.ext
      intro v
      have e1 := LinearMap.congr_fun (hπγ n) (f n v)
      have e2 := LinearMap.congr_fun (hT n) v
      simp only [LinearMap.comp_apply] at e1 e2 ⊢
      rw [e1, e2]
    · apply LinearMap.ext
      intro v
      have h1 := LinearMap.congr_fun (hw n) v
      simp only [LinearMap.comp_apply] at h1 ⊢
      rw [hγs]
      simp only [LinearMap.comp_apply, LinearMap.add_apply, LinearMap.sub_apply, h1]
      abel
  obtain ⟨β, hπβ, hB⟩ := lifts

  have glue : ∃ s : M →ₗ[R] (M →₀ R), ∀ n, s ∘ₗ φ n = β n := by
    have htr : ∀ n m, n ≤ m → ∃ F : (Fin (r n) → R) →ₗ[R] (Fin (r m) → R),
        (∀ z, φ m (F z) = φ n z) ∧ (∀ z, β m (F z) = β n z) := by
      intro n m hnm
      induction m, hnm using Nat.le_induction with
      | base => exact ⟨LinearMap.id, fun z => rfl, fun z => rfl⟩
      | succ m _ ih =>
        obtain ⟨F, h1, h2⟩ := ih
        refine ⟨f m ∘ₗ F, fun z => ?_, fun z => ?_⟩
        · have := LinearMap.congr_fun (hT m) (F z)
          simp only [LinearMap.comp_apply] at this ⊢
          rw [this, h1]
        · have := LinearMap.congr_fun (hB m) (F z)
          simp only [LinearMap.comp_apply] at this ⊢
          rw [this, h2]
    have hwd1 : ∀ n m (z : Fin (r n) → R) (z' : Fin (r m) → R), n ≤ m → φ n z = φ m z' →
        β n z = β m z' := by
      intro n m z z' hnm he
      obtain ⟨F, h1, h2⟩ := htr n m hnm
      have e1 : φ m (F z - z') = 0 := by
        rw [map_sub, h1, he, sub_self]
      have e2 : f m (F z - z') = 0 := hK m e1
      have e3 : β m (F z - z') = 0 := by
        have := LinearMap.congr_fun (hB m) (F z - z')
        simp only [LinearMap.comp_apply] at this
        rw [← this, e2, map_zero]
      rw [map_sub, sub_eq_zero, h2] at e3
      exact e3
    have hwd : ∀ n m (z : Fin (r n) → R) (z' : Fin (r m) → R), φ n z = φ m z' →
        β n z = β m z' := by
      intro n m z z' he
      rcases le_total n m with h | h
      · exact hwd1 n m z z' h he
      · exact (hwd1 m n z' z h he.symm).symm
    choose N Z hNZ using hsurj
    let s : M →ₗ[R] (M →₀ R) :=
      { toFun := fun m => β (N m) (Z m)
        map_add' := by
          intro m₁ m₂
          obtain ⟨F₁, h11, h12⟩ := htr (N m₁) (N m₁ + N m₂) (Nat.le_add_right _ _)
          obtain ⟨F₂, h21, h22⟩ := htr (N m₂) (N m₁ + N m₂) (Nat.le_add_left _ _)
          have e : φ (N (m₁ + m₂)) (Z (m₁ + m₂)) =
              φ (N m₁ + N m₂) (F₁ (Z m₁) + F₂ (Z m₂)) := by
            rw [map_add, h11, h21, hNZ, hNZ, hNZ]
          show β (N (m₁ + m₂)) (Z (m₁ + m₂)) = β (N m₁) (Z m₁) + β (N m₂) (Z m₂)
          rw [hwd _ _ _ _ e, map_add, h12, h22]
        map_smul' := by
          intro c m
          have e : φ (N (c • m)) (Z (c • m)) = φ (N m) (c • Z m) := by
            rw [map_smul, hNZ, hNZ]
          show β (N (c • m)) (Z (c • m)) = c • β (N m) (Z m)
          rw [hwd _ _ _ _ e, map_smul] }
    refine ⟨s, fun n => LinearMap.ext fun z => ?_⟩
    show β (N (φ n z)) (Z (φ n z)) = β n z
    exact hwd _ _ _ _ (hNZ _)
  obtain ⟨s, hs⟩ := glue
  refine ⟨s, LinearMap.ext fun m => ?_⟩
  obtain ⟨n, z, rfl⟩ := hsurj m
  have e1 := LinearMap.congr_fun (hs n) z
  have e2 := LinearMap.congr_fun (hπβ n) z
  simp only [LinearMap.comp_apply] at e1 e2
  rw [LinearMap.comp_apply, e1, e2, LinearMap.id_apply]

theorem wcpa_pple_np_product_ml : ∀ (A ι : Type u) [CommRing A] [IsNoetherianRing A], ∀ (k : ℕ) (x : (Fin k → A) →ₗ[A] (ι → A)), ∃ (p : ℕ) (a : (Fin k → A) →ₗ[A] (Fin p → A)), ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.FinitePresentation A N], LinearMap.ker (a.rTensor N) = LinearMap.ker (x.rTensor N) :=
by
  classical
  intro A ι _ _ k x
  let φ : ι → ((Fin k → A) →ₗ[A] A) := fun i => (LinearMap.proj i : (ι → A) →ₗ[A] A) ∘ₗ x
  have hfg : (Submodule.span A (Set.range φ)).FG := IsNoetherian.noetherian _
  obtain ⟨s', hs'sub, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hfg
  let e := s'.equivFin
  let f : Fin s'.card → ((Fin k → A) →ₗ[A] A) := fun j => ((e.symm j : s') : _)
  have hfmem : ∀ j, ∃ i, φ i = f j := fun j => hs'sub (e.symm j).2
  choose idx hidx using hfmem
  have hsub : ∀ i, φ i ∈ Submodule.span A (Set.range f) := by
    intro i
    have h1 : φ i ∈ Submodule.span A (Set.range φ) := Submodule.subset_span ⟨i, rfl⟩
    rw [hspan] at h1
    refine Submodule.span_mono ?_ h1
    intro g hg
    exact ⟨e ⟨g, hg⟩, by simp [f]⟩
  have hc : ∀ i, ∃ c : Fin s'.card → A, ∑ j, c j • f j = φ i := fun i =>
    (Submodule.mem_span_range_iff_exists_fun A).mp (hsub i)
  choose c hc using hc
  let a : (Fin k → A) →ₗ[A] (Fin s'.card → A) := LinearMap.pi f
  let b : (ι → A) →ₗ[A] (Fin s'.card → A) := LinearMap.pi (fun j => LinearMap.proj (idx j))
  let d : (Fin s'.card → A) →ₗ[A] (ι → A) :=
    LinearMap.pi (fun i => ∑ j, c i j • (LinearMap.proj j : (Fin s'.card → A) →ₗ[A] A))
  have hab : a = b ∘ₗ x := by
    apply LinearMap.ext
    intro u
    funext j
    show f j u = x u (idx j)
    rw [← hidx j]
    rfl
  have hxd : x = d ∘ₗ a := by
    apply LinearMap.ext
    intro u
    funext i
    show x u i = (∑ j, c i j • (LinearMap.proj j : (Fin s'.card → A) →ₗ[A] A)) (fun j => f j u)
    have h := LinearMap.congr_fun (hc i) u
    rw [LinearMap.sum_apply] at h
    rw [LinearMap.sum_apply]
    simp only [LinearMap.smul_apply, LinearMap.proj_apply] at h ⊢
    exact h.symm
  refine ⟨s'.card, a, fun N _ _ _ => le_antisymm ?_ ?_⟩
  · intro z hz
    rw [LinearMap.mem_ker] at hz ⊢
    rw [hxd, LinearMap.rTensor_comp, LinearMap.comp_apply, hz, map_zero]
  · intro z hz
    rw [LinearMap.mem_ker] at hz ⊢
    rw [hab, LinearMap.rTensor_comp, LinearMap.comp_apply, hz, map_zero]

theorem wcpa_pple_np_completion_product : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (g : A) (ι : Type u), IsAdicComplete (Ideal.span {g}) A → ∃ j : AdicCompletion (Ideal.span {g}) (ι →₀ A) →ₗ[A] (ι → A), ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.FinitePresentation A N], Function.Injective (j.rTensor N) :=
by
  intro A _ _ g ι hc
  classical

  have hs0 : ∀ (J : Ideal A) (f : ι →₀ A),
      f ∈ (J • (⊤ : Submodule A (ι →₀ A))) ↔ ∀ α, f α ∈ J := by
    intro J f
    constructor
    · intro hf
      refine Submodule.smul_induction_on hf ?_ ?_
      · intro r hr n _ α
        simp only [Finsupp.smul_apply, smul_eq_mul]
        exact J.mul_mem_right _ hr
      · intro x y hx hy α
        simp only [Finsupp.add_apply]
        exact J.add_mem (hx α) (hy α)
    · intro h
      rw [← Finsupp.sum_single f, Finsupp.sum]
      refine Submodule.sum_mem _ (fun α _ => ?_)
      rw [← Finsupp.smul_single_one]
      exact Submodule.smul_mem_smul (h α) Submodule.mem_top

  have hspi : ∀ (q : ℕ) (J : Ideal A) (v : Fin q → A),
      v ∈ J • (⊤ : Submodule A (Fin q → A)) ↔ ∀ i, v i ∈ J := by
    intro q J v
    constructor
    · intro hv
      refine Submodule.smul_induction_on hv ?_ ?_
      · intro r hr n _ i
        simp only [Pi.smul_apply, smul_eq_mul]
        exact J.mul_mem_right _ hr
      · intro x y hx hy i
        simp only [Pi.add_apply]
        exact J.add_mem (hx i) (hy i)
    · intro h
      rw [pi_eq_sum_univ v]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      exact Submodule.smul_mem_smul (h i) Submodule.mem_top

  have hs1 : ∀ (M M' : Type u) [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
      (j : M →ₗ[A] M'), (∀ (m c : ℕ) (P : Matrix (Fin m) (Fin c) A) (y : Fin m → M)
        (z' : Fin c → M'), (∀ i, j (y i) = ∑ l, P i l • z' l) →
          ∃ z : Fin c → M, ∀ i, y i = ∑ l, P i l • z l) →
      ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.FinitePresentation A N],
        Function.Injective (j.rTensor N) := by
    intro M M' _ _ _ _ j hyp N _ _ _
    obtain ⟨m, K, e, hK⟩ := Module.FinitePresentation.exists_fin A N
    obtain ⟨c, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hK
    let P : Matrix (Fin m) (Fin c) A := Matrix.of fun i l => s l i
    let φ : (Fin c → A) →ₗ[A] (Fin m → A) := P.mulVecLin
    have hφ : ∀ w, φ w = ∑ l, w l • s l := by
      intro w
      funext i
      simp [φ, P, Matrix.mulVec, dotProduct, Finset.sum_apply, mul_comm]
    have hrange : LinearMap.range φ = K := by
      rw [← hs]
      ext v
      rw [Submodule.mem_span_range_iff_exists_fun, LinearMap.mem_range]
      constructor
      · rintro ⟨w, rfl⟩; exact ⟨w, (hφ w).symm⟩
      · rintro ⟨w, rfl⟩; exact ⟨w, hφ w⟩
    let π : (Fin m → A) →ₗ[A] N := e.symm.toLinearMap ∘ₗ K.mkQ
    have hπs : Function.Surjective π := e.symm.surjective.comp K.mkQ_surjective
    have hexact : Function.Exact φ π := by
      rw [LinearMap.exact_iff, LinearEquiv.ker_comp, Submodule.ker_mkQ, hrange]
    have c1 : ∀ s0 : TensorProduct A M (Fin m → A),
        TensorProduct.piScalarRight A A M' (Fin m) (j.rTensor (Fin m → A) s0) =
          fun i => j (TensorProduct.piScalarRight A A M (Fin m) s0 i) := by
      intro s0
      induction s0 using TensorProduct.induction_on with
      | zero => funext i; simp
      | tmul x v =>
        funext i
        simp [TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul]
      | add a b ha hb =>
        rw [map_add, map_add, ha, hb]
        funext i
        simp
    have c2 : ∀ (Q : Type u) [AddCommGroup Q] [Module A Q] (s1 : TensorProduct A Q (Fin c → A)),
        TensorProduct.piScalarRight A A Q (Fin m) (φ.lTensor Q s1) =
          fun i => ∑ l, P i l • TensorProduct.piScalarRight A A Q (Fin c) s1 l := by
      intro Q _ _ s1
      induction s1 using TensorProduct.induction_on with
      | zero => funext i; simp
      | tmul x v =>
        funext i
        simp [TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul, φ,
          Matrix.mulVec, dotProduct, Finset.sum_smul, mul_smul]
      | add a b ha hb =>
        rw [map_add, map_add, ha, hb]
        funext i
        simp [smul_add, Finset.sum_add_distrib]
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨s0, rfl⟩ := LinearMap.lTensor_surjective M hπs t
    have h1 : π.lTensor M' (j.rTensor (Fin m → A) s0) = 0 := by
      rw [← LinearMap.comp_apply, LinearMap.lTensor_comp_rTensor, ← LinearMap.rTensor_comp_lTensor,
        LinearMap.comp_apply]
      exact ht
    obtain ⟨s', hs'⟩ := (lTensor_exact M' hexact hπs _).mp h1
    have hjy : ∀ i, j (TensorProduct.piScalarRight A A M (Fin m) s0 i) =
        ∑ l, P i l • TensorProduct.piScalarRight A A M' (Fin c) s' l := by
      intro i
      have := congrArg (TensorProduct.piScalarRight A A M' (Fin m)) hs'
      rw [c2, c1] at this
      exact (congrFun this i).symm
    obtain ⟨z, hz⟩ := hyp m c P _ _ hjy
    have hs0' : s0 = φ.lTensor M ((TensorProduct.piScalarRight A A M (Fin c)).symm z) := by
      apply (TensorProduct.piScalarRight A A M (Fin m)).injective
      rw [c2]
      funext i
      rw [hz i, LinearEquiv.apply_symm_apply]
    rw [hs0', ← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hexact.linearMap_comp_eq_zero,
      LinearMap.lTensor_zero, LinearMap.zero_apply]

  have hs2 : ∀ (I : Ideal A), IsAdicComplete I A →
      ∃ j : AdicCompletion I (ι →₀ A) →ₗ[A] (ι → A),
        (∀ (x : AdicCompletion I (ι →₀ A)) (n : ℕ) (f : ι →₀ A),
          AdicCompletion.eval I (ι →₀ A) n x = Submodule.Quotient.mk f →
            ∀ α : ι, j x α - f α ∈ I ^ n) ∧ Function.Injective j := by
    intro I hcI
    haveI := hcI
    let e := AdicCompletion.ofLinearEquiv I A
    let j : AdicCompletion I (ι →₀ A) →ₗ[A] (ι → A) :=
      LinearMap.pi (fun α => e.symm.toLinearMap ∘ₗ
        ((AdicCompletion.map I (Finsupp.lapply α)).restrictScalars A))
    have hJ1 : ∀ (x : AdicCompletion I (ι →₀ A)) (n : ℕ) (f : ι →₀ A),
        AdicCompletion.eval I (ι →₀ A) n x = Submodule.Quotient.mk f →
        ∀ α : ι, j x α - f α ∈ I ^ n := by
      intro x n f hx α
      have h1 : e (j x α) = AdicCompletion.map I (Finsupp.lapply α) x := by
        simp [j]
      rw [AdicCompletion.ofLinearEquiv_apply] at h1
      have h2 := congrArg (fun y : AdicCompletion I A => y.val n) h1
      simp only [AdicCompletion.of_apply, AdicCompletion.map_val_apply] at h2
      rw [AdicCompletion.eval_apply] at hx
      rw [hx, LinearMap.reduceModIdeal_apply, Finsupp.lapply_apply] at h2
      have h3 := (Submodule.Quotient.eq _).mp h2
      simpa [smul_eq_mul, Ideal.mul_top] using h3
    refine ⟨j, hJ1, ?_⟩
    rw [injective_iff_map_eq_zero]
    intro x hx
    ext n
    obtain ⟨f, hf⟩ := Submodule.Quotient.mk_surjective _ (x.val n)
    have hfI : f ∈ (I ^ n) • (⊤ : Submodule A (ι →₀ A)) := by
      rw [hs0]
      intro α
      have := hJ1 x n f (by rw [AdicCompletion.eval_apply, hf]) α
      rw [hx] at this
      simpa using this
    rw [← hf, AdicCompletion.val_zero, Pi.zero_apply, Submodule.Quotient.mk_eq_zero]
    exact hfI

  have hs3 : ∀ (I : Ideal A), IsHausdorff I A → ∀ (m c : ℕ) (P : Matrix (Fin m) (Fin c) A),
      ∃ k : ℕ, ∀ w : Fin c → A, ∃ w' : Fin c → A, P.mulVec w' = P.mulVec w ∧
        ∀ n : ℕ, (∀ i, P.mulVec w i ∈ I ^ n) → ∀ l, w' l ∈ I ^ (n - k) := by
    intro I hH m c P
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul I (LinearMap.range P.mulVecLin)
    have hfix : ∀ (n : ℕ) (w : Fin c → A), (∀ i, P.mulVec w i ∈ I ^ n) →
        ∃ w'' : Fin c → A, P.mulVec w'' = P.mulVec w ∧ ∀ l, w'' l ∈ I ^ (n - k) := by
      intro n w hw
      by_cases hnk : n < k
      · refine ⟨w, rfl, fun l => ?_⟩
        rw [show n - k = 0 by omega, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      · push_neg at hnk
        have hv1 : P.mulVec w ∈ (I ^ n • (⊤ : Submodule A (Fin m → A))) := (hspi m _ _).mpr hw
        have hv2 : P.mulVec w ∈ LinearMap.range P.mulVecLin := ⟨w, Matrix.mulVecLin_apply P w⟩
        have hv3 : P.mulVec w ∈ I ^ (n - k) • (I ^ k • (⊤ : Submodule A (Fin m → A)) ⊓
            LinearMap.range P.mulVecLin) := by
          rw [← hk n hnk]; exact ⟨hv1, hv2⟩
        have hv4 : P.mulVec w ∈ I ^ (n - k) • LinearMap.range P.mulVecLin :=
          Submodule.smul_mono le_rfl inf_le_right hv3
        rw [LinearMap.range_eq_map, ← Submodule.map_smul''] at hv4
        obtain ⟨w'', hw''1, hw''2⟩ := hv4
        refine ⟨w'', by rw [← Matrix.mulVecLin_apply]; exact hw''2, fun l => ?_⟩
        exact (hspi c _ _).mp hw''1 l
    refine ⟨k, fun w => ?_⟩
    by_cases h0 : P.mulVec w = 0
    · refine ⟨0, by rw [h0, Matrix.mulVec_zero], fun n _ l => ?_⟩
      exact (I ^ (n - k)).zero_mem
    · obtain ⟨i₀, hi₀⟩ : ∃ i₀, P.mulVec w i₀ ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        exact h0 (funext hcon)
      obtain ⟨N, hN⟩ : ∃ N : ℕ, P.mulVec w i₀ ∉ I ^ N := by
        by_contra hcon
        push_neg at hcon
        apply hi₀
        apply hH.haus
        intro n
        rw [SModEq.zero, smul_eq_mul, Ideal.mul_top]
        exact hcon n
      let Q : ℕ → Prop := fun n => ∀ i, P.mulVec w i ∈ I ^ n
      have hQ0 : Q 0 := fun i => by
        rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      have hQN : ∀ n, Q n → n ≤ N := by
        intro n hn
        by_contra hlt
        push_neg at hlt
        exact hN (Ideal.pow_le_pow_right hlt.le (hn i₀))
      set n₀ := Nat.findGreatest Q N with hn₀
      have hQn₀ : Q n₀ := Nat.findGreatest_spec (Nat.zero_le N) hQ0
      obtain ⟨w', hw'1, hw'2⟩ := hfix n₀ w hQn₀
      refine ⟨w', hw'1, fun n hn l => ?_⟩
      have hle : n ≤ n₀ := Nat.le_findGreatest (hQN n hn) hn
      exact Ideal.pow_le_pow_right (by omega) (hw'2 l)

  have hs4 : ∀ (I : Ideal A) (w : ι → A), (∀ n : ℕ, ∃ T : Finset ι, ∀ α, α ∉ T → w α ∈ I ^ n) →
      ∃ x : AdicCompletion I (ι →₀ A), ∀ n : ℕ, ∃ f : ι →₀ A,
        AdicCompletion.eval I (ι →₀ A) n x = Submodule.Quotient.mk f ∧
          ∀ α, f α - w α ∈ I ^ n := by
    intro I w hw
    choose T hT using hw
    let U : ℕ → Finset ι := fun n => (Finset.range (n+1)).biUnion T
    have hU : ∀ n β, β ∉ U n → w β ∈ I ^ n := fun n β hβ =>
      hT n β (fun h => hβ (Finset.mem_biUnion.mpr ⟨n, Finset.self_mem_range_succ n, h⟩))
    have hUmono : ∀ n, U n ⊆ U (n+1) := fun n β hβ => by
      obtain ⟨k, hk, h⟩ := Finset.mem_biUnion.mp hβ
      exact Finset.mem_biUnion.mpr ⟨k, by simp only [Finset.mem_range] at hk ⊢; omega, h⟩
    let F : ℕ → (ι →₀ A) := fun n => ∑ α ∈ U n, Finsupp.single α (w α)
    have hF : ∀ n β, F n β = if β ∈ U n then w β else 0 := by
      intro n β
      simp [F, Finsupp.finset_sum_apply, Finsupp.single_apply]
    have hC : ∀ n, F n ≡ F (n + 1) [SMOD (I ^ n • (⊤ : Submodule A (ι →₀ A)))] := by
      intro n
      rw [SModEq.sub_mem, hs0]
      intro β
      rw [Finsupp.sub_apply, hF, hF]
      by_cases h1 : β ∈ U n
      · rw [if_pos h1, if_pos (hUmono n h1), sub_self]; exact (I ^ n).zero_mem
      · rw [if_neg h1]
        by_cases h2 : β ∈ U (n + 1)
        · rw [if_pos h2, zero_sub]; exact (I ^ n).neg_mem (hU n β h1)
        · rw [if_neg h2, sub_zero]; exact (I ^ n).zero_mem
    refine ⟨AdicCompletion.mk I (ι →₀ A) (AdicCompletion.AdicCauchySequence.mk I (ι →₀ A) F hC),
      fun n => ⟨F n, ?_, fun α => ?_⟩⟩
    · rw [AdicCompletion.eval_apply, AdicCompletion.mk_apply_coe]
      rfl
    · rw [hF]
      by_cases h1 : α ∈ U n
      · rw [if_pos h1, sub_self]; exact (I ^ n).zero_mem
      · rw [if_neg h1, zero_sub]; exact (I ^ n).neg_mem (hU n α h1)

  have hs5 : ∀ (I : Ideal A), IsHausdorff I A → ∀ (j : AdicCompletion I (ι →₀ A) →ₗ[A] (ι → A)),
      (∀ (x : AdicCompletion I (ι →₀ A)) (n : ℕ) (f : ι →₀ A),
        AdicCompletion.eval I (ι →₀ A) n x = Submodule.Quotient.mk f →
          ∀ α : ι, j x α - f α ∈ I ^ n) → Function.Injective j →
      ∀ (m c : ℕ) (P : Matrix (Fin m) (Fin c) A),
      (∃ k : ℕ, ∀ w : Fin c → A, ∃ w' : Fin c → A, P.mulVec w' = P.mulVec w ∧
        ∀ n : ℕ, (∀ i, P.mulVec w i ∈ I ^ n) → ∀ l, w' l ∈ I ^ (n - k)) →
      ∀ (y : Fin m → AdicCompletion I (ι →₀ A)) (z' : Fin c → (ι → A)),
        (∀ i, j (y i) = ∑ l, P i l • z' l) →
          ∃ z : Fin c → AdicCompletion I (ι →₀ A), ∀ i, y i = ∑ l, P i l • z l := by
    intro I hH j hJ1 hinj m c P hk y z' h
    have hconv := hs4 I
    obtain ⟨k, hk⟩ := hk
    have hHaus : ∀ a : A, (∀ n : ℕ, a ∈ I ^ n) → a = 0 := by
      intro a ha
      apply hH.haus
      intro n
      rw [SModEq.zero, smul_eq_mul, Ideal.mul_top]
      exact ha n
    have hPw : ∀ (α : ι) (i : Fin m), P.mulVec (fun l => z' l α) i = j (y i) α := by
      intro α i
      rw [h i]
      simp [Matrix.mulVec, dotProduct, Finset.sum_apply]
    choose W hW1 hW2 using fun α : ι => hk (fun l => z' l α)
    have hcol : ∀ (l : Fin c) (n : ℕ), ∃ T : Finset ι, ∀ α, α ∉ T → W α l ∈ I ^ n := by
      intro l n
      choose f hf using fun i => Submodule.Quotient.mk_surjective _
        (AdicCompletion.eval I (ι →₀ A) (n + k) (y i))
      refine ⟨Finset.univ.biUnion (fun i => (f i).support), fun α hα => ?_⟩
      have hf0 : ∀ i, f i α = 0 := by
        intro i
        by_contra hne
        exact hα (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, Finsupp.mem_support_iff.mpr hne⟩)
      have hy : ∀ i, P.mulVec (fun l => z' l α) i ∈ I ^ (n + k) := by
        intro i
        rw [hPw]
        have := hJ1 (y i) (n + k) (f i) (hf i).symm α
        rwa [hf0 i, sub_zero] at this
      have := hW2 α (n + k) hy l
      rwa [Nat.add_sub_cancel] at this
    choose zz hzz using fun l => hconv (fun α => W α l) (hcol l)
    have hjz : ∀ l α, j (zz l) α = W α l := by
      intro l α
      apply sub_eq_zero.mp
      apply hHaus
      intro n
      obtain ⟨f, hf1, hf2⟩ := hzz l n
      have e1 := hJ1 _ n f hf1 α
      have e2 := (I ^ n).add_mem e1 (hf2 α)
      rwa [sub_add_sub_cancel] at e2
    refine ⟨zz, fun i => hinj ?_⟩
    funext α
    rw [map_sum, Finset.sum_apply]
    simp only [map_smul, Pi.smul_apply, smul_eq_mul, hjz]
    rw [← hPw α i, ← hW1 α]
    simp [Matrix.mulVec, dotProduct]

  haveI := hc
  have hH : IsHausdorff (Ideal.span {g}) A := inferInstance
  obtain ⟨j, hJ1, hinj⟩ := hs2 (Ideal.span {g}) hc
  refine ⟨j, ?_⟩
  apply hs1 _ _ j
  intro m c P y z' h
  exact hs5 (Ideal.span {g}) hH j hJ1 hinj m c P (hs3 (Ideal.span {g}) hH m c P) y z' h

theorem wcpa_pple_np_completion_summand : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (g : A), Module.Flat A B → (∀ n : ℕ, Module.Projective (A ⧸ Ideal.span {g ^ n}) (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g ^ n}))) → ∃ (i : AdicCompletion (Ideal.span {g}) B →ₗ[A] AdicCompletion (Ideal.span {g}) (B →₀ A)) (r : AdicCompletion (Ideal.span {g}) (B →₀ A) →ₗ[A] AdicCompletion (Ideal.span {g}) B), r ∘ₗ i = LinearMap.id :=
by
  intro A B _ _ _ g _ hproj

  have L1 : ∀ (n : ℕ) (M N : Type u) [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N],
      (∀ m : M, g ^ n • m = 0) → ∀ (f : M →ₗ[A] N)
      (h : B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B) →ₗ[A] N), (∀ x, ∃ m, f m = h x) →
      ∃ h' : B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B) →ₗ[A] M, f ∘ₗ h' = h := by
    intro n M N _ _ _ _ hM f h hrange
    haveI := hproj n
    have heq : (Ideal.span {g} ^ n • ⊤ : Submodule A B) =
        (Ideal.map (algebraMap A B) (Ideal.span {g ^ n})).restrictScalars A := by
      rw [Ideal.span_singleton_pow, Ideal.smul_top_eq_map]
    let e : (B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B)) ≃ₗ[A]
        (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g ^ n})) :=
      (Submodule.quotEquivOfEq _ _ heq).trans
        (Submodule.Quotient.restrictScalarsEquiv A (Ideal.map (algebraMap A B) (Ideal.span {g ^ n})))
    have hM' : Module.IsTorsionBySet A M (Ideal.span {g ^ n} : Set A) :=
      (Module.isTorsionBySet_span_singleton_iff (g ^ n)).mpr hM
    letI : Module (A ⧸ Ideal.span {g ^ n}) M := hM'.module
    haveI : IsScalarTower A (A ⧸ Ideal.span {g ^ n}) M := hM'.isScalarTower
    have hN' : Module.IsTorsionBySet A (LinearMap.range f) (Ideal.span {g ^ n} : Set A) := by
      apply (Module.isTorsionBySet_span_singleton_iff (g ^ n)).mpr
      rintro ⟨y, m, rfl⟩
      apply Subtype.ext
      show g ^ n • f m = 0
      rw [← map_smul, hM, map_zero]
    letI : Module (A ⧸ Ideal.span {g ^ n}) (LinearMap.range f) := hN'.module
    haveI : IsScalarTower A (A ⧸ Ideal.span {g ^ n}) (LinearMap.range f) := hN'.isScalarTower
    let f₀ : M →ₗ[A] LinearMap.range f := f.rangeRestrict
    let h₀ : (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g ^ n})) →ₗ[A] LinearMap.range f :=
      LinearMap.codRestrict (LinearMap.range f) (h ∘ₗ e.symm.toLinearMap) (fun q => by
        obtain ⟨m, hm⟩ := hrange (e.symm q)
        exact ⟨m, hm⟩)
    have hsurjA : Function.Surjective (algebraMap A (A ⧸ Ideal.span {g ^ n})) :=
      Ideal.Quotient.mk_surjective
    let f₀' := LinearMap.extendScalarsOfSurjective hsurjA f₀
    let h₀' := LinearMap.extendScalarsOfSurjective hsurjA h₀
    obtain ⟨k, hk⟩ := Module.projective_lifting_property f₀' h₀' (fun y => by
      obtain ⟨m, hm⟩ := LinearMap.surjective_rangeRestrict f y
      exact ⟨m, by rw [LinearMap.extendScalarsOfSurjective_apply]; exact hm⟩)
    refine ⟨(k.restrictScalars A) ∘ₗ e.toLinearMap, LinearMap.ext fun x => ?_⟩
    have h1 : ((f₀ (k (e x)) : LinearMap.range f) : N) = ((h₀ (e x) : LinearMap.range f) : N) :=
      congrArg Subtype.val (LinearMap.congr_fun hk (e x))
    have h2 : ((h₀ (e x) : LinearMap.range f) : N) = h x := by
      simp [h₀]
    exact h1.trans h2

  let π : (B →₀ A) →ₗ[A] B := Finsupp.linearCombination A id
  have hπ : Function.Surjective π := Finsupp.linearCombination_id_surjective A B
  let πn : ∀ n : ℕ, (B →₀ A) ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A (B →₀ A)) →ₗ[A]
      B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B) :=
    fun n => Submodule.mapQ _ _ π (Submodule.smul_top_le_comap_smul_top (Ideal.span {g} ^ n) π)

  have L2 : ∀ (n : ℕ) (s : B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B) →ₗ[A]
      (B →₀ A) ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A (B →₀ A))), (∀ x, πn n (s x) = x) →
      ∃ s' : B ⧸ (Ideal.span {g} ^ (n + 1) • ⊤ : Submodule A B) →ₗ[A]
        (B →₀ A) ⧸ (Ideal.span {g} ^ (n + 1) • ⊤ : Submodule A (B →₀ A)),
        (∀ x, πn (n + 1) (s' x) = x) ∧
        ∀ x, AdicCompletion.transitionMap (Ideal.span {g}) (B →₀ A) (Nat.le_succ n) (s' x) =
          s (AdicCompletion.transitionMap (Ideal.span {g}) B (Nat.le_succ n) x) := by
    intro n s hs
    have htors : ∀ m : (B →₀ A) ⧸ (Ideal.span {g} ^ (n + 1) • ⊤ : Submodule A (B →₀ A)),
        g ^ (n + 1) • m = 0 := by
      intro m
      obtain ⟨φ, rfl⟩ := Submodule.Quotient.mk_surjective _ m
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self g) _)
        Submodule.mem_top
    have hmap : (Ideal.span {g} ^ n • ⊤ : Submodule A B) =
        Submodule.map π (Ideal.span {g} ^ n • ⊤ : Submodule A (B →₀ A)) := by
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hπ]
    have hrange : ∀ x, ∃ m, ((πn (n + 1)).prod
        (AdicCompletion.transitionMap (Ideal.span {g}) (B →₀ A) (Nat.le_succ n))) m =
        (LinearMap.id.prod (s ∘ₗ AdicCompletion.transitionMap (Ideal.span {g}) B (Nat.le_succ n))) x := by
      intro x
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      obtain ⟨φ₀, hφ₀⟩ := Submodule.Quotient.mk_surjective _ (s (Submodule.Quotient.mk b))
      have h1 : (Submodule.Quotient.mk (π φ₀) : B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B)) =
          Submodule.Quotient.mk b := by
        have := hs (Submodule.Quotient.mk b)
        rw [← hφ₀] at this
        exact this
      rw [Submodule.Quotient.eq, hmap] at h1
      obtain ⟨φ₁, hφ₁, hφ₁eq⟩ := h1
      refine ⟨Submodule.Quotient.mk (φ₀ - φ₁), Prod.ext ?_ ?_⟩
      · show Submodule.Quotient.mk (π (φ₀ - φ₁)) = Submodule.Quotient.mk b
        rw [map_sub, hφ₁eq, sub_sub_cancel]
      · show (Submodule.Quotient.mk (φ₀ - φ₁) :
            (B →₀ A) ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A (B →₀ A))) =
          s (Submodule.Quotient.mk b)
        rw [← hφ₀, Submodule.Quotient.eq, sub_sub_cancel_left]
        exact Submodule.neg_mem _ hφ₁
    obtain ⟨h', hh'⟩ := L1 (n + 1) _ _ htors _ _ hrange
    refine ⟨h', fun x => ?_, fun x => ?_⟩
    · exact congrArg Prod.fst (LinearMap.congr_fun hh' x)
    · exact congrArg Prod.snd (LinearMap.congr_fun hh' x)

  have hsub : ∀ y : B ⧸ (Ideal.span {g} ^ 0 • ⊤ : Submodule A B), y = 0 := by
    intro y
    obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rw [Submodule.Quotient.mk_eq_zero, pow_zero, Ideal.one_eq_top, Submodule.top_smul]
    exact Submodule.mem_top
  let Sec : ℕ → Type u := fun n =>
    {s : B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B) →ₗ[A]
      (B →₀ A) ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A (B →₀ A)) // ∀ x, πn n (s x) = x}
  let t : ∀ n, Sec n := fun n => Nat.rec (motive := Sec)
    ⟨0, fun x => (hsub _).trans (hsub x).symm⟩
    (fun n sn => ⟨Classical.choose (L2 n sn.1 sn.2), (Classical.choose_spec (L2 n sn.1 sn.2)).1⟩) n
  obtain ⟨s, hs, hstep⟩ : ∃ s : ∀ n : ℕ, B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B) →ₗ[A]
      (B →₀ A) ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A (B →₀ A)),
      (∀ n x, πn n (s n x) = x) ∧
      ∀ n x, AdicCompletion.transitionMap (Ideal.span {g}) (B →₀ A) (Nat.le_succ n) (s (n + 1) x) =
          s n (AdicCompletion.transitionMap (Ideal.span {g}) B (Nat.le_succ n) x) :=
    ⟨fun n => (t n).1, fun n => (t n).2,
      fun n x => (Classical.choose_spec (L2 n (t n).1 (t n).2)).2 x⟩

  have Tid : ∀ (M : Type u) [AddCommGroup M] [Module A M] (n : ℕ)
      (x : M ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A M)),
      AdicCompletion.transitionMap (Ideal.span {g}) M (le_refl n) x = x := by
    intro M _ _ n x
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rfl
  have Tcomp : ∀ (M : Type u) [AddCommGroup M] [Module A M] (k m n : ℕ) (h1 : k ≤ m) (h2 : m ≤ n)
      (x : M ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A M)),
      AdicCompletion.transitionMap (Ideal.span {g}) M h1
        (AdicCompletion.transitionMap (Ideal.span {g}) M h2 x) =
      AdicCompletion.transitionMap (Ideal.span {g}) M (h1.trans h2) x := by
    intro M _ _ k m n h1 h2 x
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rfl
  have hcompat : ∀ m n (hmn : m ≤ n) (y : B ⧸ (Ideal.span {g} ^ n • ⊤ : Submodule A B)),
      AdicCompletion.transitionMap (Ideal.span {g}) (B →₀ A) hmn (s n y) =
        s m (AdicCompletion.transitionMap (Ideal.span {g}) B hmn y) := by
    intro m n hmn
    induction n, hmn using Nat.le_induction with
    | base => intro y; rw [Tid, Tid]
    | succ n hmn ih =>
      intro y
      rw [← Tcomp (B →₀ A) m n (n + 1) hmn (Nat.le_succ n) (s (n + 1) y), hstep n y, ih, Tcomp]
  let i : AdicCompletion (Ideal.span {g}) B →ₗ[A] AdicCompletion (Ideal.span {g}) (B →₀ A) :=
    AdicCompletion.lift (Ideal.span {g}) (fun n => s n ∘ₗ AdicCompletion.eval (Ideal.span {g}) B n)
      (fun {m n} hmn => LinearMap.ext fun x => by
        simp only [LinearMap.comp_apply, AdicCompletion.coe_eval]
        rw [hcompat, AdicCompletion.transitionMap_comp_eval_apply])
  refine ⟨i, AdicCompletion.map (Ideal.span {g}) π, ?_⟩
  apply LinearMap.ext
  intro x
  apply AdicCompletion.ext
  intro n
  show (AdicCompletion.map (Ideal.span {g}) π (i x)).val n = x.val n
  rw [AdicCompletion.map_val_apply]
  have hix : (i x).val n = s n (x.val n) := by
    have := AdicCompletion.eval_lift_apply (Ideal.span {g})
      (fun n => s n ∘ₗ AdicCompletion.eval (Ideal.span {g}) B n)
      (fun {m n} hmn => LinearMap.ext fun x => by
        simp only [LinearMap.comp_apply, AdicCompletion.coe_eval]
        rw [hcompat, AdicCompletion.transitionMap_comp_eval_apply]) n x
    simpa only [LinearMap.comp_apply, AdicCompletion.coe_eval] using this
  rw [hix]
  obtain ⟨z, hz⟩ := Submodule.Quotient.mk_surjective _ (s n (x.val n))
  rw [← hz, LinearMap.reduceModIdeal_apply]
  have := hs n (x.val n)
  rw [← hz] at this
  exact this

theorem wcpa_pple_np_nzd_fibres : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A] [CommRing B] [Algebra A B] (g : A), g ∈ (⊥ : Ideal A).jacobson → Module.Flat A B → (∀ (L : Type u) [Field L] [Algebra A L], IsDomain (TensorProduct A L B)) → ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N] (c : B) (z : TensorProduct A B N), (1 + algebraMap A B g * c) • z = 0 → z = 0 :=
by
  intro A B _ _ _ _ g hg hfl hdom N _ _ _ c z hz

  have hequiv : ∀ {M M' : Type u} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
      (φ : M →ₗ[A] M') (b : B) (x : TensorProduct A B M),
      LinearMap.lTensor B φ (b • x) = b • LinearMap.lTensor B φ x := by
    intro M M' _ _ _ _ φ b x
    induction x using TensorProduct.induction_on with
    | zero => rw [smul_zero, map_zero, smul_zero]
    | tmul b' m =>
      rw [TensorProduct.smul_tmul', LinearMap.lTensor_tmul, LinearMap.lTensor_tmul,
        TensorProduct.smul_tmul']
    | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add]

  have hprime : ∀ (p : Ideal A), p.IsPrime → ∀ x : TensorProduct A B (A ⧸ p),
      (1 + algebraMap A B g * c) • x = 0 → x = 0 := by
    intro p hp x hx
    have hmul : ∀ y : TensorProduct A B (A ⧸ p),
        (1 + algebraMap A B g * c) • y = ((1 + algebraMap A B g * c) ⊗ₜ[A] (1 : A ⧸ p)) * y := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => rw [smul_zero, mul_zero]
      | tmul b a =>
        rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul, one_mul, smul_eq_mul]
      | add y y' hy hy' => rw [smul_add, hy, hy', mul_add]

    let K := FractionRing (A ⧸ p)
    let j : (A ⧸ p) →ₐ[A] K := IsScalarTower.toAlgHom A (A ⧸ p) K
    have hj : Function.Injective j := IsFractionRing.injective (A ⧸ p) K
    let ψ : TensorProduct A B (A ⧸ p) →ₐ[A] TensorProduct A B K :=
      Algebra.TensorProduct.map (AlgHom.id A B) j
    have hψeq : ∀ y, ψ y = LinearMap.lTensor B j.toLinearMap y := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul b a => rfl
      | add y y' hy hy' => rw [map_add, map_add, hy, hy']
    have hψ : Function.Injective ψ := by
      intro y y' h
      rw [hψeq, hψeq] at h
      exact Module.Flat.lTensor_preserves_injective_linearMap j.toLinearMap hj h
    haveI : IsDomain (TensorProduct A K B) := hdom K
    let Θ : TensorProduct A B (A ⧸ p) →ₐ[A] TensorProduct A K B :=
      (Algebra.TensorProduct.comm A B K).toAlgHom.comp ψ
    have hΘ : Function.Injective Θ :=
      (Algebra.TensorProduct.comm A B K).injective.comp hψ
    haveI : IsDomain (TensorProduct A B (A ⧸ p)) := Function.Injective.isDomain Θ hΘ

    have hne : ((1 + algebraMap A B g * c) ⊗ₜ[A] (1 : A ⧸ p)) ≠ 0 := by
      obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p hp.ne_top
      have hgm : g ∈ m := by
        rw [Ideal.jacobson, Ideal.mem_sInf] at hg
        exact hg ⟨bot_le, hm⟩
      letI : Field (A ⧸ m) := Ideal.Quotient.field m
      haveI : IsDomain (TensorProduct A (A ⧸ m) B) := hdom (A ⧸ m)
      let Φ : TensorProduct A B (A ⧸ p) →ₐ[A] TensorProduct A B (A ⧸ m) :=
        Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.factorₐ A hpm)
      have hΦ : Φ ((1 + algebraMap A B g * c) ⊗ₜ[A] (1 : A ⧸ p)) = 1 := by
        rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply, TensorProduct.add_tmul,
          ← Algebra.smul_def, TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
          Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hgm,
          TensorProduct.tmul_zero, add_zero, Algebra.TensorProduct.one_def]
      intro h0
      rw [h0, map_zero] at hΦ
      have h1 : (1 : TensorProduct A (A ⧸ m) B) = 0 := by
        have := congrArg (Algebra.TensorProduct.comm A B (A ⧸ m)) hΦ
        rwa [map_zero, map_one, eq_comm] at this
      exact one_ne_zero h1
    rw [hmul] at hx
    exact (mul_eq_zero.mp hx).resolve_left hne
  refine (IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime A
    (inferInstance : Module.Finite A N)
    (motive := fun N (_ : AddCommGroup N) (_ : Module A N) (_ : Module.Finite A N) =>
      ∀ z : TensorProduct A B N, (1 + algebraMap A B g * c) • z = 0 → z = 0) ?_ ?_ ?_) z hz
  · intro M _ _ _ _ x _
    have hall : ∀ y : TensorProduct A B M, y = 0 := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => rfl
      | tmul b n => rw [Subsingleton.elim n 0, TensorProduct.tmul_zero]
      | add x y hx hy => rw [hx, hy, add_zero]
    exact hall x
  · intro M _ _ _ p a x hx
    have hinj : Function.Injective (LinearMap.lTensor B (a : M →ₗ[A] A ⧸ p.asIdeal)) :=
      Module.Flat.lTensor_preserves_injective_linearMap _ a.injective
    apply hinj
    rw [map_zero]
    apply hprime p.asIdeal p.isPrime
    rw [← hequiv, hx, map_zero]
  · intro N₁ _ _ _ N₂ _ _ _ N₃ _ _ _ f h hf hh hex ih1 ih3 x hx
    have hF : Function.Injective (LinearMap.lTensor B f) :=
      Module.Flat.lTensor_preserves_injective_linearMap f hf
    have hFH := lTensor_exact B hex hh
    have h3 : LinearMap.lTensor B h x = 0 := by
      apply ih3
      rw [← hequiv, hx, map_zero]
    obtain ⟨w, rfl⟩ := (hFH x).mp h3
    have hw : (1 + algebraMap A B g * c) • w = 0 := by
      apply hF
      rw [hequiv, hx, map_zero]
    rw [ih1 w hw, map_zero]

theorem wcpa_pple_np_univ_inj_completion : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A] [CommRing B] [Algebra A B] (g : A), (∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N] (c : B) (z : TensorProduct A B N), (1 + algebraMap A B g * c) • z = 0 → z = 0) → Algebra.FiniteType A B → ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.FinitePresentation A N], Function.Injective ((AdicCompletion.of (Ideal.span {g}) B).rTensor N) :=
by
  intro A B _ _ _ _ g H hft N _ _ _
  classical
  haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  haveI : Module.Finite A N := inferInstance
  haveI : Module.Finite B (TensorProduct A B N) := inferInstance

  have hhaus : Function.Injective
      (AdicCompletion.of (Ideal.span {g}) (TensorProduct A B N)) := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    have hmem : ∀ n : ℕ, ∃ m : TensorProduct A B N, g ^ n • m = z := by
      intro n
      have h1 := congrArg (AdicCompletion.eval (Ideal.span {g}) _ n) hz
      rw [AdicCompletion.eval_of, map_zero, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero] at h1
      rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul] at h1
      obtain ⟨m, -, hm⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp h1
      exact ⟨m, hm⟩
    have hinf : z ∈ ⨅ n : ℕ, (Ideal.span {algebraMap A B g}) ^ n •
        (⊤ : Submodule B (TensorProduct A B N)) := by
      rw [Submodule.mem_iInf]
      intro n
      obtain ⟨m, hm⟩ := hmem n
      have e : (algebraMap A B g) ^ n • m = z := by
        rw [← map_pow, algebraMap_smul]; exact hm
      rw [← e]
      exact Submodule.smul_mem_smul
        (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n) Submodule.mem_top
    obtain ⟨⟨r, hr⟩, hrz⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff _ z).mp hinf
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hr
    apply H N (-b) z
    have hrz' : r • z = z := hrz
    rw [add_smul, one_smul, mul_neg, neg_smul, mul_comm, hb, hrz', add_neg_cancel]

  let β : AdicCompletion (Ideal.span {g}) B →ₗ[A] N →ₗ[A]
      AdicCompletion (Ideal.span {g}) (TensorProduct A B N) :=
    LinearMap.mk₂ A (fun ξ n => AdicCompletion.map (Ideal.span {g})
        ((TensorProduct.mk A B N).flip n) ξ)
      (fun ξ ξ' n => map_add _ ξ ξ')
      (fun a ξ n => LinearMap.map_smul_of_tower _ a ξ)
      (fun ξ n n' => by
        rw [map_add, map_add, LinearMap.add_apply])
      (fun a ξ n => by
        rw [map_smul, map_smul, LinearMap.smul_apply])
  have hΦ : ∀ x : TensorProduct A B N,
      TensorProduct.lift β ((AdicCompletion.of (Ideal.span {g}) B).rTensor N x) =
        AdicCompletion.of (Ideal.span {g}) (TensorProduct A B N) x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul b n =>
      rw [LinearMap.rTensor_tmul, TensorProduct.lift.tmul]
      show AdicCompletion.map (Ideal.span {g}) ((TensorProduct.mk A B N).flip n)
          (AdicCompletion.of (Ideal.span {g}) B b) = _
      rw [AdicCompletion.map_of, LinearMap.flip_apply, TensorProduct.mk_apply]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  intro x y hxy
  apply hhaus
  rw [← hΦ x, ← hΦ y, hxy]

theorem wcpa_pple_noetherian_projective : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S], Module.Flat R S → Algebra.FiniteType R S → (∀ (L : Type u) [Field L] [Algebra R L], IsDomain (TensorProduct R L S)) → Module.Projective R S :=
by

  have hgen : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Algebra.FiniteType R S →
      ∃ e : ℕ → S, Submodule.span R (Set.range e) = ⊤ := by
    intro R S _ _ _ hft
    obtain ⟨n, ψ, hψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    obtain ⟨e', he'⟩ := exists_surjective_nat (Fin n →₀ ℕ)
    refine ⟨fun k => ψ (MvPolynomial.monomial (e' k) 1), ?_⟩
    rw [eq_top_iff]
    rintro s -
    obtain ⟨p, rfl⟩ := hψ s
    rw [p.as_sum, map_sum]
    refine Submodule.sum_mem _ (fun v _ => ?_)
    obtain ⟨k, hk⟩ := he' v
    have hm : MvPolynomial.monomial v (p.coeff v) = p.coeff v • MvPolynomial.monomial v (1 : R) := by
      rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [hm, map_smul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, by simp only [hk]⟩)

  have s1 : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A] [CommRing B] [Algebra A B] (g : A),
      IsAdicComplete (Ideal.span {g}) A → Module.Flat A B → Algebra.FiniteType A B →
      (∀ (L : Type u) [Field L] [Algebra A L], IsDomain (TensorProduct A L B)) →
      Module.Projective (A ⧸ Ideal.span {g}) (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g})) →
      Module.Projective A B := by
    intro A B _ _ _ _ g hc hfl hft hdom hproj
    haveI := hc
    have hjac : g ∈ (⊥ : Ideal A).jacobson :=
      (IsAdicComplete.le_jacobson_bot (Ideal.span {g})) (Ideal.mem_span_singleton_self g)
    have hpow := wcpa_pple_np_mod_pow A B g hfl hproj
    have hnzd := wcpa_pple_np_nzd_fibres A B g hjac hfl hdom
    have hof := wcpa_pple_np_univ_inj_completion A B g hnzd hft
    obtain ⟨i, r, hri⟩ := wcpa_pple_np_completion_summand A B g hfl hpow
    obtain ⟨j, hj⟩ := wcpa_pple_np_completion_product A g B hc
    have hJ : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.FinitePresentation A N],
        Function.Injective ((j ∘ₗ i ∘ₗ AdicCompletion.of (Ideal.span {g}) B).rTensor N) := by
      intro N _ _ _
      have hi : Function.Injective (i.rTensor N) := by
        have e : Function.LeftInverse (r.rTensor N) (i.rTensor N) := by
          intro z
          rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp, hri, LinearMap.rTensor_id,
            LinearMap.id_apply]
        exact e.injective
      rw [LinearMap.rTensor_comp, LinearMap.rTensor_comp, LinearMap.coe_comp, LinearMap.coe_comp]
      exact (hj N).comp (hi.comp (hof N))
    have hML : ∀ (k : ℕ) (x : (Fin k → A) →ₗ[A] B), ∃ (p : ℕ) (a : (Fin k → A) →ₗ[A] (Fin p → A)),
        ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.FinitePresentation A N],
          LinearMap.ker (a.rTensor N) = LinearMap.ker (x.rTensor N) := by
      intro k x
      obtain ⟨p, a, ha⟩ := wcpa_pple_np_product_ml A B k
        ((j ∘ₗ i ∘ₗ AdicCompletion.of (Ideal.span {g}) B) ∘ₗ x)
      refine ⟨p, a, fun N _ _ _ => ?_⟩
      rw [ha N, LinearMap.rTensor_comp, LinearMap.ker_comp, LinearMap.ker_eq_bot.mpr (hJ N),
        Submodule.comap_bot]
    exact wcpa_pple_np_projective_of_ml A B hfl (hgen A B hft) hML

  have key : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S],
      Module.Flat R S → Algebra.FiniteType R S →
      (∀ (L : Type u) [Field L] [Algebra R L], IsDomain (TensorProduct R L S)) →
      (∀ J : Ideal R, J ≠ ⊥ → Module.Projective (R ⧸ J) (S ⧸ Ideal.map (algebraMap R S) J)) →
      Module.Projective R S := by
    intro R S _ _ _ _ hfl hft hdom hstar
    rcases subsingleton_or_nontrivial R with hR | hR
    · haveI : Subsingleton S := by
        refine ⟨fun x y => ?_⟩
        rw [← one_smul R x, ← one_smul R y, Subsingleton.elim (1 : R) 0, zero_smul, zero_smul]
      haveI : Module.Free R S := Module.Free.of_subsingleton R S
      exact Module.Projective.of_free
    by_cases hred : IsReduced R
    swap
    · have hn : nilradical R ≠ ⊥ := by
        intro h
        apply hred
        refine ⟨fun x hx => ?_⟩
        have hx' : x ∈ nilradical R := mem_nilradical.mpr hx
        rw [h] at hx'
        exact Ideal.mem_bot.mp hx'
      exact wcpa_pple_np_nilpotent_lift R S (nilradical R)
        (IsNoetherianRing.isNilpotent_nilradical R) hfl (hstar _ hn)
    haveI := hred
    obtain ⟨f, hf0, hfproj⟩ := wcpa_pple_np_generic_free R S hft
    obtain ⟨hAN, hAC⟩ := wcpa_pple_np_completion_basic R f
    haveI := hAN
    obtain ⟨hBfl, hBft, hBdom⟩ :=
      wcpa_pple_np_basechange_hyp R (AdicCompletion (Ideal.span {f}) R) S hfl hft hdom
    have hf' : Ideal.span {f} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact hf0
    have hBp := wcpa_pple_np_basechange_modg R (AdicCompletion (Ideal.span {f}) R) S f
      (hstar _ hf')
    have hBproj : Module.Projective (AdicCompletion (Ideal.span {f}) R)
        (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) :=
      s1 (AdicCompletion (Ideal.span {f}) R) (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S)
        (algebraMap R (AdicCompletion (Ideal.span {f}) R) f) hAC hBfl hBft hBdom hBp
    have hT := wcpa_pple_np_prod_projective R (Localization.Away f)
      (AdicCompletion (Ideal.span {f}) R) S hfproj hBproj
    have hTML := wcpa_pple_np_projective_ml (Localization.Away f × AdicCompletion (Ideal.span {f}) R)
      (TensorProduct R (Localization.Away f × AdicCompletion (Ideal.span {f}) R) S) hT
    have hff := wcpa_pple_np_faithfully_flat_cover R f
    have hML := wcpa_pple_np_ml_descent R (Localization.Away f × AdicCompletion (Ideal.span {f}) R)
      S hff hfl hTML
    exact wcpa_pple_np_projective_of_ml R S hfl (hgen R S hft) hML

  intro R S _ _ _ _ hfl hft hdom
  have hP : ∀ I : Ideal R, Module.Projective (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I) := by
    intro I
    refine IsNoetherian.induction
      (P := fun I : Ideal R => Module.Projective (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I))
      (fun I ih => ?_) I
    obtain ⟨h1, h2, h3⟩ := wcpa_pple_np_quot_hyp R S I hfl hft hdom
    refine key (R ⧸ I) (S ⧸ Ideal.map (algebraMap R S) I) h1 h2 h3 (fun J hJ => ?_)
    apply wcpa_pple_np_quot_transfer R S I J
    apply ih
    refine lt_of_le_of_ne ?_ ?_
    · intro x hx
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact J.zero_mem
    · intro hEq
      apply hJ
      rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective J,
        ← hEq, Ideal.map_quotient_self]
  exact key R S hfl hft hdom (fun J _ => hP J)

theorem wcpa_pple_smooth_projective : ∀ (V C : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V] [CommRing C] [Algebra V C], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) → Algebra.Smooth V C → Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≠ ⊤ → (∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L C) ∨ Subsingleton (TensorProduct V L C)) → Module.Projective V C :=
by
  intro V C _ _ _ _ _ _ _hdim hsm hne hfib
  haveI := hsm
  haveI hflat : Module.Flat V C := inferInstance

  haveI hff : Module.FaithfullyFlat V C := by
    refine Module.FaithfullyFlat.mk (fun m hm => ?_)
    rw [IsLocalRing.eq_maximalIdeal hm]
    intro htop
    apply hne
    rw [Ideal.smul_top_eq_map] at htop
    exact (Submodule.restrictScalars_eq_top_iff V C C).mp htop
  have hdom : ∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L C) := by
    intro L _ _
    rcases hfib L with h | h
    · exact h
    · exfalso
      haveI : Nontrivial (TensorProduct V L C) := inferInstance
      exact not_subsingleton _ h

  obtain ⟨R₀, iR₀, hN, iRV, C₀, iC₀, iRC, hsm0, hfib0, ⟨e⟩⟩ :=
    wcpa_pple_noetherian_model V C hsm hdom
  haveI : Module.Projective R₀ C₀ :=
    wcpa_pple_noetherian_projective R₀ C₀ inferInstance inferInstance hfib0
  haveI : Module.Projective V (TensorProduct R₀ V C₀) := inferInstance
  exact Module.Projective.of_equiv e.symm

theorem wcpa_pp_local_etale_projective : ∀ (V A : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V] [CommRing A] [IsDomain A] [Algebra V A], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) → Algebra.FinitePresentation V A → Module.Flat V A → ∀ 𝔭 : Ideal A, 𝔭.IsPrime → Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V) ≤ 𝔭 → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra V B) (_ : IsScalarTower V A B), Module.Flat A B ∧ Algebra.FinitePresentation A B ∧ Module.Projective V B ∧ ∃ 𝔮 : Ideal B, 𝔮.IsPrime ∧ Ideal.comap (algebraMap A B) 𝔮 = 𝔭 :=
by
  intro V A _ _ _ _ _ _ _ hW hfp hflat 𝔭 h𝔭 hI
  classical
  obtain ⟨B, iB, iAB, iVB, iT, hBflat, hBfp, hq, n, N, hN0, hNn, hstep⟩ :=
    wcpa_pple_devissage V A hW hfp hflat 𝔭 h𝔭 hI
  refine ⟨B, iB, iAB, iVB, iT, hBflat, hBfp, ?_, hq⟩

  have hbez : ∀ (M : Type u) [AddCommGroup M] [Module V M] (y : M),
      y ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) →
      ∃ m' ∈ IsLocalRing.maximalIdeal V, ∃ w : M, y = m' • w := by
    intro M _ _ y hy
    refine Submodule.smul_induction_on
      (p := fun y => ∃ m' ∈ IsLocalRing.maximalIdeal V, ∃ w : M, y = m' • w) hy ?_ ?_
    · intro r hr w _
      exact ⟨r, hr, w, rfl⟩
    · rintro y₁ y₂ ⟨m₁, hm₁, w₁, rfl⟩ ⟨m₂, hm₂, w₂, rfl⟩
      rcases ValuationRing.dvd_total m₁ m₂ with ⟨r, rfl⟩ | ⟨r, rfl⟩
      · exact ⟨m₁, hm₁, w₁ + r • w₂, by rw [smul_add, mul_smul]⟩
      · exact ⟨m₂, hm₂, r • w₁ + w₂, by rw [smul_add, mul_smul]⟩

  have s3 : ∀ (P M : Type u) [AddCommGroup P] [Module V P] [Module.Projective V P]
      [AddCommGroup M] [Module V M],
      (∀ (c : V) (x : M), c ≠ 0 → c • x = 0 → x = 0) → ∀ α : P →ₗ[V] M,
      (∀ u : P, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) →
        u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V P)) →
      Function.Injective α ∧
        ∀ (c : V) (x : M), c ≠ 0 → c • x ∈ LinearMap.range α → x ∈ LinearMap.range α := by
    intro P M _ _ hPproj _ _ hTF α hα
    obtain ⟨s, hs⟩ := Module.projective_def'.mp hPproj
    have hπ : ∀ b, Finsupp.linearCombination V id (s b) = b := fun b => LinearMap.congr_fun hs b
    have star : ∀ u : P, u ≠ 0 → ∃ d : V, d ≠ 0 ∧ ∃ u' : P, u = d • u' ∧
        u' ∉ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V P) := by
      intro u hu
      obtain ⟨c, hcdef⟩ : ∃ c, c = s u := ⟨_, rfl⟩
      have hc0 : c ≠ 0 := by
        intro h
        apply hu
        rw [← hπ u, ← hcdef, h, map_zero]
      have key : ∀ T : Finset P, T.Nonempty → ∃ p₀ ∈ T, ∀ p ∈ T, c p₀ ∣ c p := by
        intro T hT
        induction T using Finset.induction_on with
        | empty => exact absurd hT Finset.not_nonempty_empty
        | insert a T haT ih =>
          rcases T.eq_empty_or_nonempty with hTe | hTne
          · refine ⟨a, Finset.mem_insert_self _ _, fun p hp => ?_⟩
            rw [hTe] at hp
            rw [Finset.mem_singleton.mp hp]
          · obtain ⟨q, hq, hqd⟩ := ih hTne
            rcases ValuationRing.dvd_total (c a) (c q) with h | h
            · refine ⟨a, Finset.mem_insert_self _ _, fun p hp => ?_⟩
              rcases Finset.mem_insert.mp hp with rfl | hp
              · exact dvd_rfl
              · exact h.trans (hqd p hp)
            · refine ⟨q, Finset.mem_insert_of_mem hq, fun p hp => ?_⟩
              rcases Finset.mem_insert.mp hp with rfl | hp
              · exact h
              · exact hqd p hp
      obtain ⟨p₀, hp₀, hdvd⟩ := key c.support (Finsupp.support_nonempty_iff.mpr hc0)
      have hz0 : c p₀ ≠ 0 := Finsupp.mem_support_iff.mp hp₀
      choose! q hq using hdvd
      have hfg : u = c p₀ • ∑ p ∈ c.support, q p • p := by
        rw [Finset.smul_sum]
        conv_lhs => rw [← hπ u, ← hcdef]
        rw [Finsupp.linearCombination_apply, Finsupp.sum]
        refine Finset.sum_congr rfl (fun p hp => ?_)
        rw [hq p hp, mul_smul]
        rfl
      refine ⟨c p₀, hz0, ∑ p ∈ c.support, q p • p, hfg, fun hg => ?_⟩
      obtain ⟨m', hm', w, hw⟩ := hbez P _ hg
      have h1 : u = (c p₀ * m') • w := by
        rw [hfg, hw, mul_smul]
      have h2 : c p₀ = (c p₀ * m') * s w p₀ := by
        conv_lhs => rw [hcdef, h1]
        rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
      have h3 : c p₀ * 1 = c p₀ * (m' * s w p₀) := by
        rw [mul_one, ← mul_assoc]
        exact h2
      have h4 := mul_left_cancel₀ hz0 h3
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal m').mp hm'))
        (isUnit_iff_exists_inv.mpr ⟨s w p₀, h4.symm⟩)
    have hinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro u hu
      by_contra hne
      obtain ⟨d, hd, u', rfl, hu'⟩ := star u hne
      rw [map_smul] at hu
      have h0 : α u' = 0 := hTF d (α u') hd hu
      exact hu' (hα u' (by rw [h0]; exact Submodule.zero_mem _))
    refine ⟨hinj, fun c x hc hx => ?_⟩
    obtain ⟨u, hu⟩ := LinearMap.mem_range.mp hx
    by_cases hu0 : u = 0
    · rw [hu0, map_zero] at hu
      have hx0 : x = 0 := hTF c x hc hu.symm
      rw [hx0]
      exact Submodule.zero_mem _
    obtain ⟨d, hd, u', rfl, hu'⟩ := star u hu0
    have hαu' : α u' ∉ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V M) :=
      fun h => hu' (hα u' h)
    rw [map_smul] at hu
    rcases ValuationRing.dvd_total c d with ⟨e, rfl⟩ | ⟨e, rfl⟩
    · have h0 : x - α (e • u') = 0 :=
        hTF c _ hc (by rw [smul_sub, map_smul, ← mul_smul, hu, sub_self])
      exact LinearMap.mem_range.mpr ⟨e • u', (sub_eq_zero.mp h0).symm⟩
    · have h0 : e • x - α u' = 0 :=
        hTF d _ hd (by rw [smul_sub, ← mul_smul, hu, sub_self])
      have he : e • x = α u' := sub_eq_zero.mp h0
      by_cases heu : IsUnit e
      · obtain ⟨e', he'⟩ := heu.exists_left_inv
        refine LinearMap.mem_range.mpr ⟨e' • u', ?_⟩
        rw [map_smul, ← he, ← mul_smul, he', one_smul]
      · exfalso
        apply hαu'
        rw [← he]
        exact Submodule.smul_mem_smul
          ((IsLocalRing.mem_maximalIdeal e).mpr (mem_nonunits_iff.mpr heu)) Submodule.mem_top

  haveI : Module.Flat V B := Module.Flat.trans V A B
  haveI htfB : Module.IsTorsionFree V B := Module.Flat.isTorsionFree
  have hBTF : ∀ (c : V) (x : B), c ≠ 0 → c • x = 0 → x = 0 := by
    intro c x hc hx
    have hreg : IsSMulRegular B c := Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hc)
    apply hreg
    show c • x = c • 0
    rw [hx, smul_zero]
  have hPi : ∀ (C : Type u) [CommRing C] [Algebra V C] [Module.Projective V C] (r : ℕ),
      Module.Projective V (Fin r → C) := by
    intro C _ _ _ r
    exact Module.Projective.of_equiv
      (DFinsupp.linearEquivFunOnFintype (R := V) (M := fun _ : Fin r => C))

  have hup : ∀ k, k ≤ n → ∀ (c : V) (x : B ⧸ N k), c ≠ 0 → c • x = 0 → x = 0 := by
    intro k
    induction k with
    | zero =>
      intro _ c x hc hx
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, hN0,
        Submodule.mem_bot] at hx
      rw [Submodule.Quotient.mk_eq_zero, hN0, Submodule.mem_bot]
      exact hBTF c b hc hx
    | succ k ih =>
      intro hk c x hc hx
      have hk' : k < n := by omega
      obtain ⟨hle, C, iC, iVC, hsm, hne, hgeom, r, α, hrange, hα⟩ := hstep k hk'
      haveI : Module.Projective V C := wcpa_pple_smooth_projective V C hW hsm hne hgeom
      haveI : Module.Projective V (Fin r → C) := hPi C r
      obtain ⟨_, hcok⟩ := s3 (Fin r → C) (B ⧸ N k) (ih (by omega)) α hα
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hx
      have h1 : c • (N k).mkQ b ∈ LinearMap.range α := by
        rw [hrange]
        exact Submodule.mem_map.mpr ⟨c • b, hx, map_smul _ _ _⟩
      have h2 := hcok c _ hc h1
      rw [hrange] at h2
      have h3 : b ∈ Submodule.comap (N k).mkQ (Submodule.map (N k).mkQ (N (k + 1))) := h2
      rw [Submodule.comap_map_mkQ] at h3
      rw [Submodule.Quotient.mk_eq_zero]
      exact (sup_le hle le_rfl) h3

  have hdown : ∀ j k, k + j = n → Module.Projective V (B ⧸ N k) := by
    intro j
    induction j with
    | zero =>
      intro k hk
      have hNk : N k = ⊤ := by
        rw [show k = n by omega]
        exact hNn
      have hz : ∀ x : B ⧸ N k, x = 0 := by
        intro x
        obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ x
        rw [Submodule.Quotient.mk_eq_zero, hNk]
        exact Submodule.mem_top
      exact Module.Projective.mk ⟨0, fun x => (hz _).trans (hz x).symm⟩
    | succ j ih =>
      intro k hk
      haveI hP : Module.Projective V (B ⧸ N (k + 1)) := ih (k + 1) (by omega)
      have hkn : k < n := by omega
      obtain ⟨hle, C, iC, iVC, hsm, hne, hgeom, r, α, hrange, hα⟩ := hstep k hkn
      haveI : Module.Projective V C := wcpa_pple_smooth_projective V C hW hsm hne hgeom
      haveI : Module.Projective V (Fin r → C) := hPi C r
      obtain ⟨hinj, _⟩ := s3 (Fin r → C) (B ⧸ N k) (hup k hkn.le) α hα
      have hπs : Function.Surjective (Submodule.factor hle) := by
        intro y
        obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ y
        exact ⟨Submodule.Quotient.mk b, Submodule.factor_mk hle b⟩
      have hker : ∀ y, Submodule.factor hle y = 0 ↔ y ∈ LinearMap.range α := by
        intro y
        obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ y
        have e1 : Submodule.factor hle (Submodule.Quotient.mk b : B ⧸ N k) =
            (Submodule.Quotient.mk b : B ⧸ N (k + 1)) := Submodule.factor_mk hle b
        have e2 : (Submodule.Quotient.mk b : B ⧸ N k) ∈ Submodule.map (N k).mkQ (N (k + 1)) ↔
            b ∈ N (k + 1) := by
          constructor
          · intro h
            have h' : b ∈ Submodule.comap (N k).mkQ (Submodule.map (N k).mkQ (N (k + 1))) := h
            rw [Submodule.comap_map_mkQ] at h'
            exact (sup_le hle le_rfl) h'
          · intro h
            exact Submodule.mem_map_of_mem h
        rw [e1, Submodule.Quotient.mk_eq_zero, hrange, e2]
      obtain ⟨σ, hσ⟩ := Module.projective_lifting_property (Submodule.factor hle) LinearMap.id hπs
      have hπσ : ∀ y, Submodule.factor hle (σ y) = y := fun y => LinearMap.congr_fun hσ y
      have hπα : ∀ p, Submodule.factor hle (α p) = 0 := fun p =>
        (hker _).mpr (LinearMap.mem_range_self α p)
      have hΦinj : Function.Injective (α.coprod σ) := by
        rw [injective_iff_map_eq_zero]
        rintro ⟨p, y⟩ h
        simp only [LinearMap.coprod_apply] at h
        have hy : y = 0 := by
          have h' := congrArg (Submodule.factor hle) h
          rwa [map_add, hπα, hπσ, zero_add, map_zero] at h'
        subst hy
        rw [map_zero, add_zero] at h
        have hp : p = 0 := hinj (h.trans (map_zero α).symm)
        rw [hp]
        rfl
      have hΦsurj : Function.Surjective (α.coprod σ) := by
        intro x
        have h0 : Submodule.factor hle (x - σ (Submodule.factor hle x)) = 0 := by
          rw [map_sub, hπσ, sub_self]
        obtain ⟨p, hp⟩ := LinearMap.mem_range.mp ((hker _).mp h0)
        refine ⟨(p, Submodule.factor hle x), ?_⟩
        simp only [LinearMap.coprod_apply]
        rw [hp, sub_add_cancel]
      exact Module.Projective.of_equiv (LinearEquiv.ofBijective (α.coprod σ) ⟨hΦinj, hΦsurj⟩)
  haveI : Module.Projective V (B ⧸ N 0) := hdown n 0 (by omega)
  exact Module.Projective.of_equiv (Submodule.quotEquivOfEqBot (N 0) hN0)

theorem wcpa_pp_cover_assembly : ∀ (V A : Type u) [CommRing V] [CommRing A] [Algebra V A] (I : Ideal A), (∀ 𝔭 : Ideal A, 𝔭.IsPrime → I ≤ 𝔭 → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra V B) (_ : IsScalarTower V A B), Module.Flat A B ∧ Algebra.FinitePresentation A B ∧ Module.Projective V B ∧ ∃ 𝔮 : Ideal B, 𝔮.IsPrime ∧ Ideal.comap (algebraMap A B) 𝔮 = 𝔭) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra V B) (_ : IsScalarTower V A B), Module.Flat A B ∧ Module.Projective V B ∧ ∀ 𝔭 : Ideal A, 𝔭.IsPrime → I ≤ 𝔭 → ∃ 𝔮 : Ideal B, 𝔮.IsPrime ∧ Ideal.comap (algebraMap A B) 𝔮 = 𝔭 :=
by
  intro V A _ _ _ I h
  classical
  have h' : ∀ z : {x : PrimeSpectrum A // I ≤ x.asIdeal}, ∃ (B : Type u) (_ : CommRing B)
      (_ : Algebra A B) (_ : Algebra V B) (_ : IsScalarTower V A B), Module.Flat A B ∧
      Algebra.FinitePresentation A B ∧ Module.Projective V B ∧
      ∃ 𝔮 : Ideal B, 𝔮.IsPrime ∧ Ideal.comap (algebraMap A B) 𝔮 = z.1.asIdeal :=
    fun z => h z.1.asIdeal z.1.isPrime z.2
  choose Bf iR iA iV iT hfl hfp hpr hq using h'
  let U : {x : PrimeSpectrum A // I ≤ x.asIdeal} → Set (PrimeSpectrum A) :=
    fun z => Set.range (PrimeSpectrum.comap (algebraMap A (Bf z)))
  have hUo : ∀ z, IsOpen (U z) := by
    intro z
    have := hfl z
    have := hfp z
    exact (PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
      (R := A) (S := Bf z)).isOpen_range
  have hUmem : ∀ z, z.1 ∈ U z := by
    intro z
    obtain ⟨𝔮, h𝔮, hc⟩ := hq z
    exact ⟨⟨𝔮, h𝔮⟩, PrimeSpectrum.ext hc⟩
  have hS : IsCompact (PrimeSpectrum.zeroLocus (I : Set A)) :=
    (PrimeSpectrum.isClosed_zeroLocus _).isCompact
  have hcov : PrimeSpectrum.zeroLocus (I : Set A) ⊆ ⋃ z, U z := by
    intro x hx
    exact Set.mem_iUnion.mpr ⟨⟨x, (PrimeSpectrum.mem_zeroLocus _ _).mp hx⟩, hUmem _⟩
  obtain ⟨t, ht⟩ := hS.elim_finite_subcover U hUo hcov
  have hflat : Module.Flat A (∀ j : {z // z ∈ t}, Bf j.1) :=
    Module.Flat.of_linearEquiv
      (DirectSum.linearEquivFunOnFintype A {z // z ∈ t} (fun j => Bf j.1)).symm
  have hproj : Module.Projective V (∀ j : {z // z ∈ t}, Bf j.1) :=
    Module.Projective.of_equiv
      (DirectSum.linearEquivFunOnFintype V {z // z ∈ t} (fun j => Bf j.1))
  refine ⟨∀ j : {z // z ∈ t}, Bf j.1, inferInstance, inferInstance, inferInstance, inferInstance,
    hflat, hproj, ?_⟩
  intro 𝔭 h𝔭 hI
  have hx : (⟨𝔭, h𝔭⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus (I : Set A) :=
    (PrimeSpectrum.mem_zeroLocus _ _).mpr hI
  obtain ⟨z, hz, y, hy⟩ : ∃ z ∈ t, (⟨𝔭, h𝔭⟩ : PrimeSpectrum A) ∈ U z := by
    have := ht hx
    simpa only [Set.mem_iUnion, exists_prop] using this
  let ev : (∀ j : {z // z ∈ t}, Bf j.1) →+* Bf z :=
    Pi.evalRingHom (fun j : {z // z ∈ t} => Bf j.1) ⟨z, hz⟩
  refine ⟨Ideal.comap ev y.asIdeal, Ideal.IsPrime.comap ev (hK := y.isPrime), ?_⟩
  rw [Ideal.comap_comap]
  have hev : ev.comp (algebraMap A (∀ j : {z // z ∈ t}, Bf j.1)) = algebraMap A (Bf z) := by
    ext a
    rfl
  rw [hev]
  exact congrArg PrimeSpectrum.asIdeal hy

theorem wcpa_dj_lr1u_mnc_pure_projective : ∀ (V A : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [HenselianLocalRing V] [CommRing A] [IsDomain A] [Algebra V A], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) → Algebra.FinitePresentation V A → Module.Flat V A → Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V) ≠ ⊤ → Module.Projective V A :=
by
  intro V A _ _ _ _ _ _ _ hW hfp hflat hne
  classical

  obtain ⟨B, iB, iAB, iVB, iT, hBflat, hBproj, hcov⟩ :=
    wcpa_pp_cover_assembly V A (Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V))
      (fun 𝔭 h𝔭 hI => wcpa_pp_local_etale_projective V A hW hfp hflat 𝔭 h𝔭 hI)

  obtain ⟨hinj, hdiv⟩ := wcpa_pp_flat_cover_pure V A B hW hBflat hne hcov
  have hpure : ∀ (a : A) (c : V) (p : B), c ≠ 0 →
      (IsScalarTower.toAlgHom V A B).toLinearMap a = c • p → ∃ a' : A, a = c • a' := by
    intro a c p hc h
    have h' : algebraMap A B a = algebraMap A B (algebraMap V A c) * p := by
      rw [← IsScalarTower.algebraMap_apply, ← Algebra.smul_def]
      exact h
    obtain ⟨a', ha'⟩ := hdiv a c hc ⟨p, h'⟩
    exact ⟨a', by rw [Algebra.smul_def, ha']⟩
  have hsat := wcpa_pp_sat_fg_of_pure_embedding V A B (IsScalarTower.toAlgHom V A B).toLinearMap
    hinj hpure

  haveI htf : Module.IsTorsionFree V A := Module.Flat.isTorsionFree

  have hgen : ∃ e : ℕ → A, Submodule.span V (Set.range e) = ⊤ := by
    have hft : Algebra.FiniteType V A := inferInstance
    obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    haveI : Countable (Fin n →₀ ℕ) := inferInstance
    obtain ⟨μ, hμ⟩ := exists_surjective_nat (Fin n →₀ ℕ)
    refine ⟨fun i => g (MvPolynomial.monomial (μ i) 1), ?_⟩
    rw [eq_top_iff]
    rintro a -
    obtain ⟨P, rfl⟩ := hg a
    refine MvPolynomial.induction_on' P (fun m r => ?_) (fun p q hp hq => ?_)
    · obtain ⟨i, rfl⟩ := hμ m
      have e1 : MvPolynomial.monomial (μ i) r = r • MvPolynomial.monomial (μ i) (1 : V) := by
        rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      rw [e1, map_smul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · rw [map_add]
      exact Submodule.add_mem _ hp hq
  exact wcpa_pp_free_of_sat_fg V A htf hgen hsat

theorem wcpa_dj_lr1u_mn_content : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)), Flat uX → LocallyOfFiniteType uX → AlgebraicGeometry.IsIntegral X → ∀ U : X.Opens, IsAffineOpen U → (∃ x : X, x ∈ U ∧ uX x = IsLocalRing.closedPoint ↥W) → ∀ f : Γ(X, U), f ≠ 0 → ∃ (z : ↥W) (g : Γ(X, U)), f = wcCnSigma uX U z * g ∧ g ∉ Ideal.map (wcCnSigma uX U) (IsLocalRing.maximalIdeal ↥W) :=
by
  intro Ω _ _ W hW X uX hflat hlft hint U hU ⟨x, hxU, hxc⟩ f hf
  classical

  have hhens : HenselianLocalRing ↥W := by
    refine ⟨fun p hp a₀ ha₀ _ => ?_⟩
    have hinjW : Function.Injective (algebraMap ↥W Ω) := IsFractionRing.injective ↥W Ω
    obtain ⟨R, hR⟩ : ∃ R, R = (p.map (algebraMap ↥W Ω)).roots := ⟨_, rfl⟩
    have hroots : ∀ α ∈ R, ∃ b : ↥W, algebraMap ↥W Ω b = α := by
      intro α hα
      rw [hR] at hα
      have hint' : IsIntegral ↥W α := ⟨p, hp, by
        rw [Polynomial.eval₂_eq_eval_map]
        exact (Polynomial.mem_roots (hp.map _).ne_zero).mp hα⟩
      exact IsIntegrallyClosed.isIntegral_iff.mp hint'
    choose! L hL using hroots
    have hS : (R.map L).map (algebraMap ↥W Ω) = R := by
      rw [Multiset.map_map]
      conv_rhs => rw [← Multiset.map_id R]
      exact Multiset.map_congr rfl (fun α hα => hL α hα)
    have hsplit : p.map (algebraMap ↥W Ω) = (R.map (fun α => Polynomial.X - Polynomial.C α)).prod := by
      rw [hR]
      exact (Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq (hp.map _)
        IsAlgClosed.card_roots_eq_natDegree).symm
    have hpW : p = ((R.map L).map (fun b => Polynomial.X - Polynomial.C b)).prod := by
      apply Polynomial.map_injective (algebraMap ↥W Ω) hinjW
      rw [hsplit, Polynomial.map_multiset_prod, Multiset.map_map]
      conv_lhs => rw [← hS]
      rw [Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro b _
      simp
    have heval : p.eval a₀ = ((R.map L).map (fun b => a₀ - b)).prod := by
      conv_lhs => rw [hpW]
      rw [Polynomial.eval_multiset_prod, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro b _
      simp
    rw [heval] at ha₀
    obtain ⟨t, ht, htm⟩ := (Ideal.IsPrime.multiset_prod_mem_iff_exists_mem
      (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime _).mp ha₀
    obtain ⟨b, hb, rfl⟩ := Multiset.mem_map.mp ht
    refine ⟨b, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def, hpW, Polynomial.eval_multiset_prod]
      apply Multiset.prod_eq_zero
      rw [Multiset.map_map]
      exact Multiset.mem_map.mpr ⟨b, hb, by simp⟩
    · rw [← neg_sub]
      exact neg_mem htm
  haveI := hhens
  letI := (wcCnSigma uX U).toAlgebra
  haveI hUne : Nonempty U := ⟨⟨x, hxU⟩⟩
  haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U

  have hσflat : (wcCnSigma uX U).Flat := by
    have e : wcCnSigma uX U =
        (uX.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom := rfl
    rw [e]
    exact RingHom.Flat.comp
      (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _))
      (Flat.flat_appLE uX (isAffineOpen_top (Spec (.of ↥W))) hU le_top)
  haveI : Module.Flat ↥W Γ(X, U) := hσflat

  have hσft : (wcCnSigma uX U).FiniteType := by
    have e : wcCnSigma uX U =
        (uX.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom := rfl
    rw [e]
    exact RingHom.FiniteType.comp
      (HasRingHomProperty.appLE @LocallyOfFiniteType uX hlft ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top)
      (RingHom.FiniteType.of_surjective _ (ConcreteCategory.bijective_of_isIso _).2)
  haveI : Algebra.FiniteType ↥W Γ(X, U) := hσft

  haveI : Algebra.FinitePresentation ↥W Γ(X, U) :=
    wcpa_dj_lr1u_mnc_nagata_fp ↥W Γ(X, U) inferInstance inferInstance

  have hs2 : hU.fromSpec ≫ uX = Spec.map (CommRingCat.ofHom (wcCnSigma uX U)) := by
    have ha := Scheme.toSpecΓ_naturality uX
    have hb : (Spec (.of ↥W)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of ↥W)).hom := by
      rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom]
    have hc : uX = X.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop) := by
      have := congrArg (· ≫ Spec.map (Scheme.ΓSpecIso (.of ↥W)).inv) ha
      simp only [Category.assoc, hb, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id] at this
      exact this
    have e : hU.fromSpec ≫ uX = Spec.map (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop) ≫
        X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op) := by
      conv_lhs => rw [hc]
      rw [← Category.assoc, IsAffineOpen.fromSpec_toSpecΓ hU, ← Spec.map_comp]
    rw [e]
    rfl
  have hne : Ideal.map (algebraMap ↥W Γ(X, U)) (IsLocalRing.maximalIdeal ↥W) ≠ ⊤ := by
    obtain ⟨P, hP⟩ : ∃ P, P = hU.primeIdealOf ⟨x, hxU⟩ := ⟨_, rfl⟩
    have h1 : hU.fromSpec P = x := by rw [hP, hU.fromSpec_primeIdealOf]
    have h2 : uX x = (Spec.map (CommRingCat.ofHom (wcCnSigma uX U))) P := by
      have := congrArg (fun g : Spec Γ(X, U) ⟶ Spec (.of ↥W) => g P) hs2
      calc uX x = uX (hU.fromSpec P) := by rw [h1]
        _ = (hU.fromSpec ≫ uX) P := rfl
        _ = _ := this
    have h3 : (uX x).asIdeal = Ideal.comap (wcCnSigma uX U) P.asIdeal := by
      rw [h2]
      rfl
    have h4 : Ideal.map (algebraMap ↥W Γ(X, U)) (IsLocalRing.maximalIdeal ↥W) ≤ P.asIdeal := by
      rw [Ideal.map_le_iff_le_comap]
      show IsLocalRing.maximalIdeal ↥W ≤ Ideal.comap (wcCnSigma uX U) P.asIdeal
      rw [← h3, hxc]
      exact le_rfl
    intro htop
    rw [htop, top_le_iff] at h4
    exact P.isPrime.ne_top h4

  haveI hproj : Module.Projective ↥W Γ(X, U) :=
    wcpa_dj_lr1u_mnc_pure_projective ↥W Γ(X, U) hW inferInstance inferInstance hne

  obtain ⟨s, hs⟩ := Module.projective_def'.mp hproj
  have hπ : ∀ b, Finsupp.linearCombination ↥W id (s b) = b := fun b => LinearMap.congr_fun hs b
  obtain ⟨c, hcdef⟩ : ∃ c, c = s f := ⟨_, rfl⟩
  have hc0 : c ≠ 0 := by
    intro h
    apply hf
    rw [← hπ f, ← hcdef, h, map_zero]
  have key : ∀ T : Finset Γ(X, U), T.Nonempty → ∃ p₀ ∈ T, ∀ p ∈ T, c p₀ ∣ c p := by
    intro T hT
    induction T using Finset.induction_on with
    | empty => exact absurd hT Finset.not_nonempty_empty
    | insert a T haT ih =>
      rcases T.eq_empty_or_nonempty with hTe | hTne
      · refine ⟨a, Finset.mem_insert_self _ _, fun p hp => ?_⟩
        rw [hTe] at hp
        rw [Finset.mem_singleton.mp hp]
      · obtain ⟨q, hq, hqd⟩ := ih hTne
        rcases ValuationRing.dvd_total (c a) (c q) with h | h
        · refine ⟨a, Finset.mem_insert_self _ _, fun p hp => ?_⟩
          rcases Finset.mem_insert.mp hp with rfl | hp
          · exact dvd_rfl
          · exact h.trans (hqd p hp)
        · refine ⟨q, Finset.mem_insert_of_mem hq, fun p hp => ?_⟩
          rcases Finset.mem_insert.mp hp with rfl | hp
          · exact h
          · exact hqd p hp
  obtain ⟨p₀, hp₀, hdvd⟩ := key c.support (Finsupp.support_nonempty_iff.mpr hc0)
  have hz0 : c p₀ ≠ 0 := Finsupp.mem_support_iff.mp hp₀
  choose! q hq using hdvd
  have hfg : f = algebraMap ↥W Γ(X, U) (c p₀) * ∑ p ∈ c.support, q p • p := by
    rw [← Algebra.smul_def, Finset.smul_sum]
    conv_lhs => rw [← hπ f, ← hcdef]
    rw [Finsupp.linearCombination_apply, Finsupp.sum]
    refine Finset.sum_congr rfl (fun p hp => ?_)
    rw [hq p hp, mul_smul]
    rfl
  have hbez : ∀ y ∈ Ideal.map (algebraMap ↥W Γ(X, U)) (IsLocalRing.maximalIdeal ↥W),
      ∃ m' ∈ IsLocalRing.maximalIdeal ↥W, ∃ w : Γ(X, U), y = m' • w := by
    intro y hy
    have hy' : y ∈ (IsLocalRing.maximalIdeal ↥W) • (⊤ : Submodule ↥W Γ(X, U)) := by
      rw [Ideal.smul_top_eq_map]
      exact hy
    refine Submodule.smul_induction_on
      (p := fun y => ∃ m' ∈ IsLocalRing.maximalIdeal ↥W, ∃ w : Γ(X, U), y = m' • w) hy' ?_ ?_
    · intro r hr w _
      exact ⟨r, hr, w, rfl⟩
    · rintro y₁ y₂ ⟨m₁, hm₁, w₁, rfl⟩ ⟨m₂, hm₂, w₂, rfl⟩
      rcases ValuationRing.dvd_total m₁ m₂ with ⟨r, rfl⟩ | ⟨r, rfl⟩
      · exact ⟨m₁, hm₁, w₁ + r • w₂, by rw [smul_add, mul_smul]⟩
      · exact ⟨m₂, hm₂, r • w₁ + w₂, by rw [smul_add, mul_smul]⟩
  refine ⟨c p₀, ∑ p ∈ c.support, q p • p, hfg, fun hg => ?_⟩
  obtain ⟨m', hm', w, hw⟩ := hbez _ hg
  have h1 : f = (c p₀ * m') • w := by
    rw [hfg, ← Algebra.smul_def, hw, mul_smul]
  have h2 : c p₀ = (c p₀ * m') * s w p₀ := by
    conv_lhs => rw [hcdef, h1]
    rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
  have h3 : c p₀ * 1 = c p₀ * (m' * s w p₀) := by
    rw [mul_one, ← mul_assoc]
    exact h2
  have h4 := mul_left_cancel₀ hz0 h3
  exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal m').mp hm'))
    (isUnit_iff_exists_inv.mpr ⟨s w p₀, h4.symm⟩)

theorem wcpa_dj_lr1u_mn_bounded_denom : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W), a ≠ 0 → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), Flat uX → IsOpenImmersion ι → (∀ x : X, x ∈ Set.range ⇑ι ↔ a ∉ (uX x).asIdeal) → AlgebraicGeometry.IsIntegral X → ∀ U : X.Opens, IsAffineOpen U → Nonempty U → ∀ c : FractionRing Γ(X, U), IsIntegral Γ(X, U) c → ∃ (y : ↥W) (b : Γ(X, U)), y ≠ 0 ∧ algebraMap Γ(X, U) (FractionRing Γ(X, U)) (wcCnSigma uX U y) * c = algebraMap Γ(X, U) (FractionRing Γ(X, U)) b :=
by
  intro Ω _ W a ha0 X uX ι hflat hι hrι hint U hU hUne c hc
  haveI := hint
  haveI := hι

  have alg : ∀ (B C : Type u) [CommRing B] [IsDomain B] [CommRing C] [IsDomain C]
      [IsIntegrallyClosed C] [Algebra B C] (s : B), s ≠ 0 → IsLocalization.Away s C →
      ∀ c : FractionRing B, IsIntegral B c → ∃ (n : ℕ) (b : B),
        algebraMap B (FractionRing B) (s ^ n) * c = algebraMap B (FractionRing B) b := by
    intro B C _ _ _ _ _ _ s hs hloc c hc
    have hunit : ∀ y : Submonoid.powers s, IsUnit (algebraMap B (FractionRing B) y) := by
      rintro ⟨_, n, rfl⟩
      exact isUnit_iff_ne_zero.mpr
        ((map_ne_zero_iff _ (IsFractionRing.injective B (FractionRing B))).mpr (pow_ne_zero n hs))
    obtain ⟨lam, hlam⟩ : ∃ lam : C →+* FractionRing B,
        ∀ x : B, lam (algebraMap B C x) = algebraMap B (FractionRing B) x :=
      ⟨IsLocalization.lift (M := Submonoid.powers s) hunit, IsLocalization.lift_eq hunit⟩
    letI : Algebra C (FractionRing B) := lam.toAlgebra
    haveI : IsScalarTower B C (FractionRing B) :=
      IsScalarTower.of_algebraMap_eq (fun x => (hlam x).symm)
    haveI : IsFractionRing C (FractionRing B) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers s) C
        (FractionRing B)
    have hcC : IsIntegral C c := hc.tower_top
    obtain ⟨e, he⟩ := (IsIntegrallyClosed.isIntegral_iff (R := C) (K := FractionRing B)).mp hcC
    obtain ⟨⟨b, ⟨_, n, rfl⟩⟩, hb⟩ := IsLocalization.surj (Submonoid.powers s) e
    refine ⟨n, b, ?_⟩
    have h1 : lam (e * algebraMap B C (s ^ n)) = lam (algebraMap B C b) := congrArg lam hb
    rw [map_mul, hlam, hlam] at h1
    have he' : lam e = c := he
    rw [he'] at h1
    rw [mul_comm]
    exact h1

  have s2 : ∀ V : X.Opens, IsAffineOpen V → Nonempty V →
      (∀ y : X, y ∈ V → IsIntegrallyClosed (X.presheaf.stalk y)) →
      IsIntegrallyClosed Γ(X, V) := by
    intro V hV hne hnorm
    haveI : IsDomain Γ(X, V) := IsIntegral.component_integral V
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    let P : Spec Γ(X, V) := ⟨p, hpm.isPrime⟩
    have hx : hV.fromSpec P ∈ V := by
      have := Set.mem_range_self (f := hV.fromSpec) P
      rwa [hV.range_fromSpec] at this
    let x : V := ⟨_, hx⟩
    have hq : hV.primeIdealOf x = P := by
      haveI := hV.isOpenImmersion_fromSpec
      apply hV.fromSpec.isOpenEmbedding.injective
      rw [hV.fromSpec_primeIdealOf]
    letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf x
    have hloc : IsLocalization.AtPrime (X.presheaf.stalk (x : X)) p := by
      have := hV.isLocalization_stalk x
      rw [hq] at this
      exact this
    let e := IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (X.presheaf.stalk (x : X))
    haveI := hnorm (x : X) hx
    exact IsIntegrallyClosed.of_equiv e.symm.toRingEquiv

  have s1 : ∀ x : X, x ∈ U → (x ∈ X.basicOpen (wcCnSigma uX U a) ↔ a ∉ (uX x).asIdeal) := by
    intro x hx
    have e : wcCnSigma uX U a = (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) := rfl
    have h2 : x ∈ X.basicOpen (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) ↔
        uX x ∈ (Spec (.of ↥W)).basicOpen ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) := by
      rw [← Scheme.preimage_basicOpen_top]
      rfl
    rw [e, Scheme.basicOpen_res, TopologicalSpace.Opens.mem_inf, h2,
      AlgebraicGeometry.basicOpen_eq_of_affine]
    exact ⟨fun h => (PrimeSpectrum.mem_basicOpen _ _).mp h.2,
      fun h => ⟨hx, (PrimeSpectrum.mem_basicOpen _ _).mpr h⟩⟩
  set s := wcCnSigma uX U a with hs_def

  haveI : AlgebraicGeometry.IsIntegral (wcProjK Ω 1) := (wc_projK_integral_normal Ω 1).1
  obtain ⟨p0⟩ : Nonempty (wcProjK Ω 1) := inferInstance
  have u0 : U := hUne.some
  obtain ⟨x0, ⟨p1, hp1⟩, hx0U⟩ : (Set.range ι ∩ (U : Set X)).Nonempty :=
    nonempty_preirreducible_inter ι.opensRange.isOpen U.isOpen ⟨ι p0, p0, rfl⟩ ⟨u0.1, u0.2⟩
  have hx0D : x0 ∈ X.basicOpen s := (s1 x0 hx0U).mpr ((hrι x0).mp ⟨p1, hp1⟩)
  have hs0 : s ≠ 0 := by
    intro h
    rw [h, Scheme.basicOpen_zero] at hx0D
    exact hx0D

  have hnormD : ∀ y : X, y ∈ X.basicOpen s → IsIntegrallyClosed (X.presheaf.stalk y) := by
    intro y hy
    have hyU : y ∈ U := X.basicOpen_le s hy
    obtain ⟨p, rfl⟩ := (hrι y).mpr ((s1 y hyU).mp hy)
    haveI := (wc_projK_integral_normal Ω 1).2.1 p
    exact IsIntegrallyClosed.of_equiv (asIso (ι.stalkMap p)).symm.commRingCatIsoToRingEquiv
  have hDaff : IsAffineOpen (X.basicOpen s) := hU.basicOpen s
  haveI hDne : Nonempty (X.basicOpen s) := ⟨⟨x0, hx0D⟩⟩
  haveI : IsDomain Γ(X, X.basicOpen s) := IsIntegral.component_integral _
  haveI : IsIntegrallyClosed Γ(X, X.basicOpen s) := s2 _ hDaff hDne hnormD
  haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U
  haveI hloc := hU.isLocalization_basicOpen s
  obtain ⟨n, b, hb⟩ := alg Γ(X, U) Γ(X, X.basicOpen s) s hs0 hloc c hc
  refine ⟨a ^ n, b, pow_ne_zero n ha0, ?_⟩
  rw [map_pow]
  exact hb

theorem wcpa_dj_lr1u_model_normal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjSemistable uX → (∃ (N : ℕ) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX) → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → AlgebraicGeometry.IsIntegral X ∧ ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x) :=
by
  intro Ω _ _ W hW hWt X uX ι hss _hXp hpb
  classical

  have crux : ∀ (V A : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [CommRing A]
      [IsDomain A] (φ : V →+* A), Function.Injective φ →
      _root_.IsReduced (A ⧸ Ideal.map φ (IsLocalRing.maximalIdeal V)) →
      (∀ f : A, f ≠ 0 → ∃ (z : V) (g : A), f = φ z * g ∧
        g ∉ Ideal.map φ (IsLocalRing.maximalIdeal V)) →
      (∀ c : FractionRing A, IsIntegral A c → ∃ (y : V) (b : A), y ≠ 0 ∧
        algebraMap A (FractionRing A) (φ y) * c = algebraMap A (FractionRing A) b) →
      IsIntegrallyClosed A := by
    intro V A _ _ _ _ _ φ hφ hred hcont hbd
    rw [isIntegrallyClosed_iff (FractionRing A)]
    intro c hc
    have hιinj : Function.Injective (algebraMap A (FractionRing A)) :=
      IsFractionRing.injective A (FractionRing A)
    obtain ⟨y, b, hy0, hyb⟩ := hbd c hc
    have hφy : algebraMap A (FractionRing A) (φ y) ≠ 0 := by
      intro h
      apply hy0
      apply hφ
      apply hιinj
      rw [h, map_zero, map_zero]
    by_cases hb : b = 0
    · refine ⟨0, ?_⟩
      rw [hb, map_zero] at hyb
      rw [map_zero]
      exact ((mul_eq_zero.mp hyb).resolve_left hφy).symm
    obtain ⟨z, g, hbz, hg⟩ := hcont b hb
    have case1 : ∀ w : V, z = y * w → ∃ e : A, algebraMap A (FractionRing A) e = c := by
      intro w hw
      refine ⟨φ w * g, ?_⟩
      apply mul_left_cancel₀ hφy
      rw [hyb, hbz, hw]
      simp only [map_mul]
      ring
    rcases ValuationRing.dvd_total y z with ⟨w, hw⟩ | ⟨t, ht⟩
    · exact case1 w hw
    · by_cases htu : IsUnit t
      · obtain ⟨u, rfl⟩ := htu
        exact case1 (↑u⁻¹ : V) (by rw [ht, mul_assoc, Units.mul_inv, mul_one])
      · exfalso
        have htm : t ∈ IsLocalRing.maximalIdeal V := htu
        have hz0 : algebraMap A (FractionRing A) (φ z) ≠ 0 := by
          intro h
          apply hφy
          rw [ht, map_mul, map_mul, h, zero_mul]
        have key : algebraMap A (FractionRing A) (φ t) * c = algebraMap A (FractionRing A) g := by
          apply mul_left_cancel₀ hz0
          have e1 : algebraMap A (FractionRing A) (φ z) * (algebraMap A (FractionRing A) (φ t) * c)
              = algebraMap A (FractionRing A) (φ y) * c := by
            rw [ht, map_mul, map_mul, mul_assoc]
          rw [e1, hyb, hbz, map_mul]
        obtain ⟨P, hPm, hP⟩ := hc
        have h1 := Polynomial.scaleRoots_eval₂_mul (p := P) (algebraMap A (FractionRing A)) c (φ t)
        rw [key, hP, mul_zero, Polynomial.eval₂_at_apply] at h1
        have h2 : (P.scaleRoots (φ t)).eval g = 0 := hιinj (by rw [h1, map_zero])
        have hφt : φ t ∈ Ideal.map φ (IsLocalRing.maximalIdeal V) := Ideal.mem_map_of_mem φ htm
        have hgd : g ^ P.natDegree ∈ Ideal.map φ (IsLocalRing.maximalIdeal V) := by
          rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.sum_range_succ,
            Polynomial.coeff_scaleRoots, hPm.coeff_natDegree, Nat.sub_self, pow_zero, one_mul,
            one_mul] at h2
          have e2 : g ^ P.natDegree =
              -∑ i ∈ Finset.range P.natDegree, (P.scaleRoots (φ t)).coeff i * g ^ i := by
            linear_combination h2
          rw [e2]
          refine neg_mem (Ideal.sum_mem _ fun i hi => ?_)
          rw [Polynomial.coeff_scaleRoots]
          have hi' : 0 < P.natDegree - i := by
            have := Finset.mem_range.mp hi
            omega
          exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hφt _ hi'))
        haveI := hred
        have hnil : IsNilpotent (Ideal.Quotient.mk (Ideal.map φ (IsLocalRing.maximalIdeal V)) g) :=
          ⟨P.natDegree, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hgd⟩
        exact hg (Ideal.Quotient.eq_zero_iff_mem.mp hnil.eq_zero)

  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
  have hprimes : ∀ I : Ideal ↥W, I.IsPrime → I = ⊥ ∨ I = IsLocalRing.maximalIdeal ↥W := by
    intro I hI
    rcases Ring.krullDimLE_one_iff.mp inferInstance I hI with h | h
    · exact Or.inl (le_bot_iff.mp (h.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le))
    · exact Or.inr (IsLocalRing.eq_maximalIdeal h)
  obtain ⟨t, ht⟩ : ∃ t : Ω, t ∉ W := by
    by_contra hcon
    push_neg at hcon
    exact hWt (eq_top_iff.mpr fun x _ => hcon x)
  have ht0 : t ≠ 0 := fun h => ht (h ▸ W.zero_mem)
  have hti : t⁻¹ ∈ W := (W.mem_or_inv_mem t).resolve_left ht
  obtain ⟨a, ha⟩ : ∃ a : ↥W, a = ⟨t⁻¹, hti⟩ := ⟨_, rfl⟩
  have hav : (a : Ω) = t⁻¹ := by rw [ha]
  have ha0 : a ≠ 0 := fun h => inv_ne_zero ht0 (by rw [← hav, h]; rfl)
  have ham : a ∈ IsLocalRing.maximalIdeal ↥W := by
    intro hu
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    apply ht
    have hv' : t⁻¹ * (v : Ω) = 1 := by rw [← hav]; exact congrArg Subtype.val hv
    have : (v : Ω) = t := by
      have := congrArg (t * ·) hv'
      simp only [mul_one] at this
      rw [← mul_assoc, mul_inv_cancel₀ ht0, one_mul] at this
      exact this
    rw [← this]; exact v.2
  have hloc : IsLocalization.Away a Ω := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, n, rfl⟩
      simp only [map_pow]
      apply IsUnit.pow
      exact isUnit_iff_ne_zero.mpr (by
        show (a : Ω) ≠ 0
        rw [hav]; exact inv_ne_zero ht0)
    · intro x
      by_cases hx : x ∈ W
      · exact ⟨(⟨x, hx⟩, 1), by simp⟩
      · have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
        have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
        obtain ⟨y, hy⟩ : ∃ y : ↥W, y = ⟨x⁻¹, hxi⟩ := ⟨_, rfl⟩
        have hyv : (y : Ω) = x⁻¹ := by rw [hy]
        have hy0 : y ≠ 0 := fun h => inv_ne_zero hx0 (by rw [← hyv, h]; rfl)
        have hamem : a ∈ (Ideal.span {y}).radical := by
          rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
          rintro J ⟨hyJ, hJ⟩
          rcases hprimes J hJ with h | h
          · exfalso
            apply hy0
            have : y ∈ J := hyJ (Ideal.mem_span_singleton_self y)
            rw [h] at this
            simpa using this
          · rw [h]; exact ham
        obtain ⟨n, hn⟩ := hamem
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
        refine ⟨(w, ⟨a ^ n, n, rfl⟩), ?_⟩
        have hw' : (w : Ω) * x⁻¹ = (a : Ω) ^ n := by
          rw [← hyv]
          have := congrArg Subtype.val hw
          simpa using this
        show x * algebraMap ↥W Ω (a ^ n) = algebraMap ↥W Ω w
        simp only [map_pow]
        show x * (a : Ω) ^ n = (w : Ω)
        rw [← hw', mul_comm (w : Ω), ← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
    · intro x y hxy
      exact ⟨1, by simpa using Subtype.val_injective hxy⟩
  haveI heW : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
    IsOpenImmersion.of_isLocalization a
  have hra : ∀ z : ↥(Spec (.of ↥W)),
      z ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ↔ a ∉ z.asIdeal := by
    intro z
    constructor
    · rintro ⟨x, rfl⟩ hz
      have hx : (x : PrimeSpectrum Ω).asIdeal = ⊥ :=
        @Ideal.eq_bot_of_prime _ _ _ (PrimeSpectrum.isPrime (x : PrimeSpectrum Ω))
      have h1 : Ideal.comap (algebraMap ↥W Ω) (x : PrimeSpectrum Ω).asIdeal = ⊥ := by
        rw [hx]
        exact (RingHom.injective_iff_ker_eq_bot _).mp Subtype.val_injective
      have h2 : a ∈ Ideal.comap (algebraMap ↥W Ω) (x : PrimeSpectrum Ω).asIdeal := hz
      rw [h1] at h2
      exact ha0 (by simpa using h2)
    · intro hz
      have hz' : z.asIdeal = ⊥ := by
        rcases hprimes z.asIdeal z.isPrime with h | h
        · exact h
        · exact absurd (by rw [h]; exact ham) hz
      refine ⟨⟨⊥, Ideal.isPrime_bot⟩, ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap ↥W Ω) ⊥ = z.asIdeal
      rw [hz']
      exact (RingHom.injective_iff_ker_eq_bot _).mp Subtype.val_injective

  haveI hιo : IsOpenImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip heW
  have hrι : ∀ x : X, x ∈ Set.range ⇑ι ↔ a ∉ (uX x).asIdeal := by
    intro x
    rw [← hra]
    constructor
    · rintro ⟨p, rfl⟩
      refine ⟨wcProjKStr Ω 1 p, ?_⟩
      have := congrArg (fun f : wcProjK Ω 1 ⟶ Spec (.of ↥W) => f p) hpb.w
      simp only [Scheme.Hom.comp_apply] at this
      exact this.symm
    · rintro ⟨y, hy⟩
      obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := uX) (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x y hy.symm
      refine ⟨hpb.isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst, hw1]

  haveI hflat : Flat uX := hss.1
  haveI hprop : IsProper uX := hss.2.1
  have hint : AlgebraicGeometry.IsIntegral X :=
    wcpa_dj_lr1u_mn_integral Ω W a ha0 X uX ι hflat hιo hrι
  haveI := hint
  refine ⟨hint, fun x => ?_⟩
  by_cases hxa : a ∉ (uX x).asIdeal
  ·
    obtain ⟨p, rfl⟩ := (hrι x).2 hxa
    haveI := (wc_projK_integral_normal Ω 1).2.1 p
    exact IsIntegrallyClosed.of_equiv (asIso (ι.stalkMap p)).symm.commRingCatIsoToRingEquiv
  ·
    have hxm : a ∈ (uX x).asIdeal := not_not.mp hxa
    have hclosed : uX x = IsLocalRing.closedPoint ↥W := by
      rcases hprimes (uX x).asIdeal (uX x).isPrime with h | h
      · exfalso
        rw [h] at hxm
        exact ha0 (by simpa using hxm)
      · exact PrimeSpectrum.ext h
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    haveI hUne : Nonempty U := ⟨⟨x, hxU⟩⟩
    haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U
    have hσflat : (wcCnSigma uX U).Flat := by
      have e : wcCnSigma uX U =
          (uX.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom := rfl
      rw [e]
      exact RingHom.Flat.comp
        (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _))
        (Flat.flat_appLE uX (isAffineOpen_top (Spec (.of ↥W))) hU le_top)
    have hσinj : Function.Injective (wcCnSigma uX U) := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      by_contra hy0
      letI := (wcCnSigma uX U).toAlgebra
      haveI : Module.Flat ↥W Γ(X, U) := hσflat
      haveI := Module.Flat.isTorsionFree (R := ↥W) (M := Γ(X, U))
      have hreg : IsSMulRegular Γ(X, U) y :=
        Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hy0)
      apply one_ne_zero (α := Γ(X, U))
      apply hreg
      show (wcCnSigma uX U) y * 1 = (wcCnSigma uX U) y * 0
      rw [hy, zero_mul, zero_mul]
    haveI hBic : IsIntegrallyClosed Γ(X, U) :=
      crux ↥W Γ(X, U) (wcCnSigma uX U) hσinj
        (wcpa_dj_lr1u_mn_affine_fibre_reduced Ω W X uX hss U hU)
        (wcpa_dj_lr1u_mn_content Ω W hW X uX hflat inferInstance hint U hU ⟨x, hxU, hclosed⟩)
        (wcpa_dj_lr1u_mn_bounded_denom Ω W a ha0 X uX ι hflat hιo hrι hint U hU hUne)
    let xU : U := ⟨x, hxU⟩
    show IsIntegrallyClosed (X.presheaf.stalk (xU : X))
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xU : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xU
    haveI := hU.isLocalization_stalk xU
    exact isIntegrallyClosed_of_isLocalization (X.presheaf.stalk (xU : X))
      (hU.primeIdealOf xU).asIdeal.primeCompl (Ideal.primeCompl_le_nonZeroDivisors _)

theorem wcpa_dj_lr1u_vv_transc_residue : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ξ : X), uX ξ = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({ξ} : Set X) → ∃ s : X.presheaf.stalk ξ, ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → IsUnit (q.eval₂ ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ ξ trivial).hom s) :=
by
  intro Ω _ W X uX ξ hu hnc
  classical

  have s2 : ∀ (R B : Type u) [CommRing R] [CommRing B] (ρ : R →+* B) (P : Ideal B), P.IsPrime →
      (∀ w : R, ¬ IsUnit w → ρ w ∈ P) →
      (∀ b : B, ∃ q : Polynomial R, (∃ i, IsUnit (q.coeff i)) ∧ q.eval₂ ρ b ∈ P) → P.IsMaximal := by
    intro R B _ _ ρ P hP h1 h2
    haveI := hP
    apply Ideal.Quotient.maximal_of_isField
    have claim : ∀ β : B ⧸ P, β ≠ 0 → ∃ γ, β * γ = 1 := by
      intro β hβ
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective β
      obtain ⟨q, hq, hqP⟩ := h2 b
      have hev : (q.map ((Ideal.Quotient.mk P).comp ρ)).eval (Ideal.Quotient.mk P b) = 0 := by
        have := Polynomial.hom_eval₂ q ρ (Ideal.Quotient.mk P) b
        rw [Polynomial.eval_map, ← this]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hqP
      obtain ⟨r, hr, hmin⟩ : ∃ r, IsUnit (q.coeff r) ∧ ∀ d < r, ¬ IsUnit (q.coeff d) :=
        ⟨Nat.find hq, Nat.find_spec hq, fun d hd => Nat.find_min hq hd⟩
      have hlow : ∀ d < r, (q.map ((Ideal.Quotient.mk P).comp ρ)).coeff d = 0 := by
        intro d hd
        rw [Polynomial.coeff_map, RingHom.comp_apply]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (h1 _ (hmin d hd))
      obtain ⟨G, hG⟩ := Polynomial.X_pow_dvd_iff.mpr hlow
      have hG0 : G.coeff 0 = ((Ideal.Quotient.mk P).comp ρ) (q.coeff r) := by
        have := congrArg (fun p => Polynomial.coeff p r) hG
        simp only [Polynomial.coeff_map, Polynomial.coeff_X_pow_mul', le_refl, if_true,
          Nat.sub_self] at this
        exact this.symm
