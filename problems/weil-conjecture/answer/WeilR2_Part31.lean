    have key : (Scheme.ΓSpecIso (.of R)).hom.hom ((Spec.map φ).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0))) = φ.hom (MvPolynomial.X 0) := by
      have := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0))) hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      congr 1
      exact CategoryTheory.Iso.inv_hom_id_apply (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))) _
    rw [key]
    congr 1
    ext1
    apply MvPolynomial.ringHom_ext
    · intro r
      have := congrArg (fun f => f.hom r) hC
      simpa using this
    · intro i
      rw [Subsingleton.elim i 0]
      simp



  have shiftg : ∀ {A : Type u} [CommRing A] (g : MvPolynomial (Fin 1) ↥W →+* A) (c : ↥W), g.Etale →
      ∃ g' : MvPolynomial (Fin 1) ↥W →+* A, g'.Etale ∧ g'.comp MvPolynomial.C = g.comp MvPolynomial.C ∧
        g' (MvPolynomial.X 0) = g (MvPolynomial.X 0 - MvPolynomial.C c) := by
    intro A _ g c hg
