theorem wcpa_dj_lr1k_ebnt_coord_transcendental : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P), wcEbntPres W σ a f → ∀ p : Polynomial ↥W, Polynomial.eval₂ σ (f (wcEbntX W a 0)) p = 0 → p = 0 :=
by
  intro Ω _ _ W hW hWt P _ σ a f hf p hp
  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  have ha : a ∈ IsLocalRing.maximalIdeal ↥W := hf.1
  have ha0 : a ≠ 0 := hf.2.1
  have hanu : ¬ IsUnit a := (IsLocalRing.mem_maximalIdeal _).mp ha
  obtain ⟨δ₀, hδ₀⟩ := IsAlgClosed.exists_pow_nat_eq ((a : ↥W) : Ω) two_pos
  have hδ₀ne : δ₀ ≠ 0 := by
    rintro rfl
    rw [zero_pow two_ne_zero] at hδ₀
    exact ha0 (by exact_mod_cast hδ₀.symm)
  have hδW : δ₀ ∈ W := by
    rcases W.mem_or_inv_mem δ₀ with h | h
    · exact h
    · exfalso; apply hanu
      obtain ⟨t, ht⟩ : ∃ t : ↥W, (t : Ω) = δ₀⁻¹ := ⟨⟨δ₀⁻¹, h⟩, rfl⟩
      refine IsUnit.of_mul_eq_one (t ^ 2) ?_
      apply Subtype.ext
      push_cast [ht]
      rw [← hδ₀, ← mul_pow, mul_inv_cancel₀ hδ₀ne, one_pow]
  obtain ⟨δ, hδc⟩ : ∃ δ : ↥W, (δ : Ω) = δ₀ := ⟨⟨δ₀, hδW⟩, rfl⟩
  have hδ2 : δ * δ = a := Subtype.ext (by push_cast [hδc]; rw [← hδ₀]; ring)
  have hδ0 : δ ≠ 0 := by
    rintro rfl
    exact ha0 (by rw [← hδ2, mul_zero])
  have hδnu : ¬ IsUnit δ := fun hu => hanu (hδ2 ▸ hu.mul hu)
  have hζ : ∀ n : ℕ, IsUnit (1 - a ^ (n + 1)) := by
    intro n
    apply IsLocalRing.isUnit_one_sub_self_of_mem_nonunits
    intro hu
    exact hanu ((isUnit_pow_iff (Nat.succ_ne_zero n)).mp hu)
  obtain ⟨x, y, hxinj, hxy, hxnu, hynu⟩ : ∃ x y : ℕ → ↥W, Function.Injective x ∧
      (∀ n, x n * y n = a) ∧ (∀ n, ¬ IsUnit (x n)) ∧ (∀ n, ¬ IsUnit (y n)) := by
    refine ⟨fun n => δ * (1 - a ^ (n + 1)), fun n => δ * ↑(hζ n).unit⁻¹, ?_, ?_, ?_, ?_⟩
    · intro n m hnm
      have h1 : 1 - a ^ (n + 1) = 1 - a ^ (m + 1) := mul_left_cancel₀ hδ0 hnm
      have h2 : a ^ (n + 1) = a ^ (m + 1) := sub_right_injective h1
      by_contra hne
      have key : ∀ i j : ℕ, i < j → a ^ (i + 1) = a ^ (j + 1) → False := by
        intro i j hij hij'
        have h3 : a ^ (i + 1) * (a ^ (j - i) - 1) = 0 := by
          rw [mul_sub, mul_one, ← pow_add, show i + 1 + (j - i) = j + 1 by omega, hij', sub_self]
