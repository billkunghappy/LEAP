  obtain ⟨hσ', hσ'x, hb0, hbm⟩ := hP'

  have hss : wcpaDjSemistable uX := hM.1
  haveI hflat : Flat uX := hss.1
  haveI hprop : IsProper uX := hss.2.1
  haveI hlfp : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX hflat inferInstance
  haveI : IsClosedImmersion (σ ≫ uX) := by rw [hσ]; infer_instance
  haveI hσci : IsClosedImmersion σ := IsClosedImmersion.of_comp σ uX
  haveI : IsClosedImmersion (σ' ≫ uX) := by rw [hσ']; infer_instance
  haveI hσ'ci : IsClosedImmersion σ' := IsClosedImmersion.of_comp σ' uX
  obtain ⟨s₀, hs₀⟩ : ∃ s : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Spec (.of ↥W),
