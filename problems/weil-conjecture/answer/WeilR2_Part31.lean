theorem wcpa_dj_lr1s_normalization_flat : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (φ : Ct ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], IsFinite φ → φ ≫ wcProjKStr Ω 1 = ct → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → Flat ((φ ≫ ι).fromNormalization ≫ uX) :=
by
  intro Ω _ W Ct ct φ X uX ι _ _ _ hφ hpb

  have s1 : ∀ (R A B : Type u) [CommRing R] [IsDomain R] [IsBezout R] [CommRing A]
      [CommRing B] (ψ : R →+* A) (j : A →+* B), Function.Injective j →
      (∀ r : R, r ≠ 0 → IsUnit (j (ψ r))) → ψ.Flat := by
    intro R A B _ _ _ _ _ ψ j hj hu
    let _ := ψ.toAlgebra
    show Module.Flat R A
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
    have ha0 : (a : R) ≠ 0 := nonZeroDivisors.coe_ne_zero a
    rw [Submonoid.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra] at ha
    have h1 : j (ψ a) * j x = 0 := by rw [← map_mul, ha, map_zero]
    rw [(hu a ha0).mul_right_eq_zero] at h1
    exact hj (h1.trans (map_zero j).symm)

  have s2 : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) (q : Y ⟶ Spec (.of Ω)),
      f ≫ uX = q ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) →
      ∀ (U : X.Opens) (hU : IsAffineOpen U) (w : ↥W), w ≠ 0 →
      IsUnit ((f.app U).hom ((Spec.preimage (hU.fromSpec ≫ uX)).hom w)) := by
    intro Y f q h U hU w hw
    have e1 : Spec.preimage (hU.fromSpec ≫ uX) = (Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (hU.fromSpec ≫ uX).appTop ≫ (Scheme.ΓSpecIso Γ(X, U)).hom := by
      have := Scheme.ΓSpecIso_naturality (Spec.preimage (hU.fromSpec ≫ uX))
      rw [Spec.map_preimage] at this
      rw [this, Iso.inv_hom_id_assoc]
    have e2 : hU.fromSpec.appTop ≫ (Scheme.ΓSpecIso Γ(X, U)).hom =
        X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op := by
      rw [← IsAffineOpen.isoSpec_inv_ι, Scheme.Hom.comp_appTop]
      simp only [IsAffineOpen.isoSpec_inv_appTop, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      simp only [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      exact (X.presheaf.map_comp _ _).symm
    have e3 : (Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))).appTop =
        CommRingCat.ofHom (algebraMap ↥W Ω) ≫ (Scheme.ΓSpecIso (.of Ω)).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv, Scheme.ΓSpecIso_naturality]
    have e4 : uX.appTop ≫ f.appTop =
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))).appTop ≫ q.appTop := by
      rw [← Scheme.Hom.comp_appTop, h, Scheme.Hom.comp_appTop]
    have key : Spec.preimage (hU.fromSpec ≫ uX) ≫ f.app U =
        (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ f.appTop ≫
        Y.presheaf.map ((TopologicalSpace.Opens.map f.base).map
          (homOfLE (le_top : U ≤ ⊤))).op := by
      rw [e1, Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
      rw [reassoc_of% e2, Scheme.Hom.naturality]
      rfl
    have key2 : Spec.preimage (hU.fromSpec ≫ uX) ≫ f.app U =
        CommRingCat.ofHom (algebraMap ↥W Ω) ≫
        (Scheme.ΓSpecIso (.of Ω)).inv ≫ q.appTop ≫
        Y.presheaf.map ((TopologicalSpace.Opens.map f.base).map
          (homOfLE (le_top : U ≤ ⊤))).op := by
      rw [key, reassoc_of% e4, reassoc_of% e3]
    have hval : ((Spec.preimage (hU.fromSpec ≫ uX) ≫ f.app U).hom w) =
        (f.app U).hom ((Spec.preimage (hU.fromSpec ≫ uX)).hom w) := rfl
    rw [← hval, key2]
    have hw' : IsUnit (algebraMap ↥W Ω w) := by
      rw [isUnit_iff_ne_zero]
      intro h0
      exact hw (Subtype.val_injective (h0.trans rfl))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
    exact ((hw'.map _).map _).map _

  have hcomm : (φ ≫ ι) ≫ uX = ct ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [Category.assoc, hpb.w, ← Category.assoc, hφ]
  apply @IsZariskiLocalAtSource.of_openCover @Flat
    (HasRingHomProperty.instIsZariskiLocalAtSource (P := @Flat)) _ _ _
    (φ ≫ ι).normalizationOpenCover
  intro U₀
  let U : X.affineOpens := U₀
  have key : Flat (Spec.map ((φ ≫ ι).normalizationDiagramMap.app (Opposite.op U.1)) ≫
      U.2.fromSpec ≫ uX) := by
    rw [← Spec.map_preimage (U.2.fromSpec ≫ uX), ← Spec.map_comp,
      HasRingHomProperty.Spec_iff (P := @Flat)]
    let _ := ((φ ≫ ι).app U).hom.toAlgebra
    refine s1 ↥W _ Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) _
      (integralClosure Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U)).val.toRingHom Subtype.val_injective ?_
    intro w hw
    exact s2 (φ ≫ ι) ct hcomm U.1 U.2 w hw
  have e := (reassoc_of% (Scheme.Hom.ι_fromNormalization (φ ≫ ι) U)) uX
  erw [e]
  exact key

theorem wcpa_dj_lr1s_normalization_generic_fibre : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (φ : Ct ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], IsFinite φ → φ ≫ wcProjKStr Ω 1 = ct → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → IsPullback (φ ≫ ι).toNormalization ct ((φ ≫ ι).fromNormalization ≫ uX) (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
by
  have GP : ∀ (A : Type u) [CommRing A] [IsDomain A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))], IsIntegralHom p → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) := by
    intro A _ _ X f P p _ _ hp
    open Limits TensorProduct in
    set_option backward.defeqAttrib.useBackward true in
    set_option backward.isDefEq.respectTransparency false in
    ·
      have s2 : ∀ {R R' S P : CommRingCat.{u}} (a : R ⟶ S) (b : R ⟶ R') (c : S ⟶ P) (d : R' ⟶ P),
          IsPushout a b c d → ∀ (M : Submonoid R), (letI : Algebra R R' := b.hom.toAlgebra;
            IsLocalization M R') → (letI : Algebra S P := c.hom.toAlgebra;
            IsLocalization (M.map a.hom) P) := by
        intro R R' S P a b c d h M hM
        letI : Algebra R S := a.hom.toAlgebra
        letI : Algebra R R' := b.hom.toAlgebra
        letI : Algebra S P := c.hom.toAlgebra
        letI : Algebra R' P := d.hom.toAlgebra
        letI : Algebra R P := (a ≫ c).hom.toAlgebra
        haveI : IsScalarTower R S P := .of_algebraMap_eq' rfl
        haveI : IsScalarTower R R' P := .of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h.w)
        have h' : Algebra.IsPushout R R' S P := CommRingCat.isPushout_iff_isPushout.mp h.flip
        exact (Algebra.isLocalization_iff_isPushout M R' (T := S) (B := P)).mpr h'.symm

      have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R)
          [IsLocalization M S], ∃ M' : Submonoid Γ(Spec (.of R), ⊤),
          letI : Algebra Γ(Spec (.of R), ⊤) Γ(Spec (.of S), ⊤) :=
            (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap R S))) ⊤ ⊤ le_top).hom.toAlgebra;
          IsLocalization M' Γ(Spec (.of S), ⊤) := by
        intro R S _ _ _ M _
        let eR : Γ(Spec (.of R), ⊤) ≃+* R := (Scheme.ΓSpecIso (.of R)).commRingCatIsoToRingEquiv
        let eS : Γ(Spec (.of S), ⊤) ≃+* S := (Scheme.ΓSpecIso (.of S)).commRingCatIsoToRingEquiv
        refine ⟨M.map eR.symm, ?_⟩
        have h1 := IsLocalization.isLocalization_of_base_ringEquiv M S eR.symm
        letI i1 : Algebra Γ(Spec (.of R), ⊤) S :=
          ((algebraMap R S).comp eR.symm.symm.toRingHom).toAlgebra
        have h2 := (IsLocalization.isLocalization_iff_of_ringEquiv (M.map eR.symm) eS.symm).mp h1
        have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap R S))
        have hEq : (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap R S))) ⊤ ⊤ le_top).hom =
