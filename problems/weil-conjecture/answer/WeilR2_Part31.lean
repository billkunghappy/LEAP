        Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A L) (AlgHom.id R L) e = 1 ∧
        ∀ y : TensorProduct R A L, e * y = e * (TensorProduct.tmul R (1 : A)
          (Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A L) (AlgHom.id R L) y)) := by
    intro R A L _ _ _ _ _ _ _ _
    obtain ⟨t, ht1, ht2⟩ := Algebra.FormallyUnramified.iff_exists_tensorProduct.mp
      (inferInstance : Algebra.FormallyUnramified R A)
    set κ := IsScalarTower.toAlgHom R A L with hκ
    set μ := Algebra.TensorProduct.productMap κ (AlgHom.id R L) with hμ
    set ψ : TensorProduct R A A →ₐ[R] TensorProduct R A L :=
      Algebra.TensorProduct.map (AlgHom.id R A) κ with hψ
    have hμψ : μ.comp ψ = κ.comp (Algebra.TensorProduct.lmul' R) := by
      apply Algebra.TensorProduct.ext'
      intro a b
      simp [hμ, hψ, Algebra.TensorProduct.productMap_apply_tmul,
        Algebra.TensorProduct.lmul'_apply_tmul]
    refine ⟨ψ t, ?_, ?_⟩
    · have := congrArg (fun F => F t) hμψ
      simp only [AlgHom.comp_apply] at this
      rw [this, ht2, map_one]
    · have habs : ∀ a : A, ψ t * (TensorProduct.tmul R a (1 : L)) =
          ψ t * (TensorProduct.tmul R (1 : A) (κ a)) := by
        intro a
        have h := congrArg ψ (ht1 a)
        rw [map_mul, map_zero, map_sub] at h
        simp only [hψ, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one] at h
        rw [sub_mul, sub_eq_zero] at h
        rw [mul_comm, ← h, mul_comm]
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul a ℓ =>
        have e1 : (TensorProduct.tmul R a ℓ : TensorProduct R A L) =
            (TensorProduct.tmul R a (1 : L)) * (TensorProduct.tmul R (1 : A) ℓ) := by
          simp
        rw [e1, ← mul_assoc, habs a, mul_assoc]
        simp [hμ, Algebra.TensorProduct.productMap_apply_tmul]
      | add y₁ y₂ h₁ h₂ =>
        rw [mul_add, h₁, h₂, map_add, TensorProduct.tmul_add, mul_add]

  have wcpa_dj_lr1k_eb_cdnc_closure_etale_of_idem : ∀ (R A L : Type u) [CommRing R] [CommRing A]
