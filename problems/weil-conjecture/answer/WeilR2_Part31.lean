      have hGe : G.eval (Ideal.Quotient.mk P b) = 0 := by
        rw [hG, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X] at hev
        exact (mul_eq_zero.mp hev).resolve_left (pow_ne_zero _ hβ)
      have hlin : Ideal.Quotient.mk P b * G.divX.eval (Ideal.Quotient.mk P b) + G.coeff 0 = 0 := by
        have := congrArg (Polynomial.eval (Ideal.Quotient.mk P b)) (Polynomial.X_mul_divX_add G)
        rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C,
          hGe] at this
        exact this
