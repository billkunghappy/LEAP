  have h1 := hvan k (by rw [hf]; exact hcon)
  rw [Matrix.charpoly_map, Polynomial.coeff_map] at h1
  set a := (Algebra.leftMulMatrix β zB).charpoly.coeff k with ha
  have hχk : (LinearMap.charpoly (Algebra.lmul K' L z)).coeff k = (a : K') := by
    rw [hcp, Polynomial.coeff_map] <;> rfl
  rw [hχk] at hk0 hkinv
  have hunit : IsUnit (⟨(a : K'), a.2⟩ : ↥O) := by
    refine ⟨⟨⟨(a : K'), a.2⟩, ⟨(a : K')⁻¹, hkinv⟩, ?_, ?_⟩, rfl⟩
    · apply Subtype.ext
      show (a : K') * (a : K')⁻¹ = 1
      exact mul_inv_cancel₀ hk0
    · apply Subtype.ext
      show (a : K')⁻¹ * (a : K') = 1
      exact inv_mul_cancel₀ hk0
  have hne := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hunit
  exact hne ((hπR a).symm.trans h1)

theorem wcpa_dj_lr1k_eb_rd_cc_inu_structure : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), W ≠ ⊤ → ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInU W f) → (∀ w : Ω, algebraMap Ω (RatFunc Ω) w ∈ O ↔ w ∈ W) ∧ O.valuation RatFunc.X < 1 ∧ (∀ f : RatFunc Ω, f ≠ 0 → ∃ (c : Ω) (j : ℤ), c ≠ 0 ∧ O.valuation (f / (algebraMap Ω (RatFunc Ω) c * RatFunc.X ^ j)) = 1) ∧ (∀ (c : Ω) (d : ℤ), c ≠ 0 → O.valuation (algebraMap Ω (RatFunc Ω) c * RatFunc.X ^ d) = 1 → d = 0) :=
by
  intro Ω _ _ W hW O hO
  classical

  have KF : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F), y ≠ 0 →
      (A.valuation y < 1 ↔ y⁻¹ ∉ A) := by
    intro F _ A y hy
    rw [← A.valuation_le_one_iff, map_inv₀, not_le, one_lt_inv₀ ((A.valuation).pos_iff.mpr hy)]
  have hX0 : (RatFunc.X : RatFunc Ω) ≠ 0 := RatFunc.X_ne_zero

  have s1 : ∀ c : Ω, c ≠ 0 → W.valuation c < 1 → ¬ wcEbAnInOc W c (RatFunc.X : RatFunc Ω)⁻¹ := by
    rintro c hc hvc ⟨p, q, i, hqi, heq, -, hp⟩
    have hq : q = Polynomial.X * p := by
      apply RatFunc.algebraMap_injective Ω
      rw [map_mul, RatFunc.algebraMap_X, ← heq, ← mul_assoc, mul_inv_cancel₀ hX0, one_mul]
    subst hq
    obtain _ | k := i
    · exact hqi (by rw [Polynomial.coeff_X_mul_zero, zero_mul])
    · have h := hp k
      rw [Polynomial.coeff_X_mul] at hqi h
      have hpk : p.coeff k ≠ 0 := fun h0 => hqi (by rw [h0, zero_mul])
      have e : p.coeff k * c ^ k / (p.coeff k * c ^ (k + 1)) = c⁻¹ := by
        rw [pow_succ, ← mul_assoc, div_mul_eq_div_div,
          div_self (mul_ne_zero hpk (pow_ne_zero _ hc)), one_div]
      rw [e] at h
      exact ((KF W c hc).mp hvc) h

  have s2 : ∀ a c : Ω, c ≠ 0 → a / c ∈ W →
      wcEbAnInOc W c (algebraMap Ω (RatFunc Ω) a * RatFunc.X⁻¹) := by
    intro a c hc hac
    refine ⟨Polynomial.C a, Polynomial.X, 1, ?_, ?_, ?_, ?_⟩
    · rw [Polynomial.coeff_X_one, one_mul, pow_one]; exact hc
    · rw [RatFunc.algebraMap_X, mul_assoc, inv_mul_cancel₀ hX0, mul_one, RatFunc.algebraMap_C,
        RatFunc.algebraMap_eq_C]
    · intro j
      rw [Polynomial.coeff_X_one, one_mul, pow_one, Polynomial.coeff_X]
      split_ifs with h
      · subst h; rw [one_mul, pow_one, div_self hc]; exact W.one_mem
      · rw [zero_mul, zero_div]; exact W.zero_mem
    · intro j
      rw [Polynomial.coeff_X_one, one_mul, pow_one, Polynomial.coeff_C]
      split_ifs with h
      · subst h; rw [pow_zero, mul_one]; exact hac
      · rw [zero_mul, zero_div]; exact W.zero_mem

  have inocC : ∀ (w c : Ω), c ≠ 0 → w ∈ W → wcEbAnInOc W c (algebraMap Ω (RatFunc Ω) w) := by
    intro w c hc hw
    refine ⟨Polynomial.C w, 1, 0, ?_, ?_, ?_, ?_⟩
    · simp
    · rw [map_one, mul_one, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    · intro j; by_cases h : j = 0 <;> simp [h, Polynomial.coeff_one]
    · intro j; by_cases h : j = 0 <;> simp [h, Polynomial.coeff_C, hw]
  have inocC' : ∀ (w c : Ω), wcEbAnInOc W c (algebraMap Ω (RatFunc Ω) w) → w ∈ W := by
    rintro w c ⟨p, q, i, hqi, heq, -, hp⟩
    have hpq : p = Polynomial.C w * q := by
      apply RatFunc.algebraMap_injective Ω
      rw [← heq, map_mul, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C, mul_comm]
    have h := hp i
    rw [hpq, Polynomial.coeff_C_mul, mul_assoc, mul_div_assoc, div_self hqi, mul_one] at h
    exact h

  obtain ⟨cs, hcs0, hcs⟩ : ∃ c : Ω, c ≠ 0 ∧ W.valuation c < 1 := by
    by_contra hcon
    push_neg at hcon
    apply hW
    ext x
    constructor
    · intro _; exact ValuationSubring.mem_top _
    · intro _
      by_cases hx : x = 0
      · rw [hx]; exact W.zero_mem
      · by_contra hxW
        have h1 := (KF W x⁻¹ (inv_ne_zero hx)).mpr (by rwa [inv_inv])
        exact absurd h1 (not_lt.mpr (hcon x⁻¹ (inv_ne_zero hx)))
  have one_div_self : ∀ c : Ω, c ≠ 0 → c / c ∈ W := fun c hc => by
    rw [div_self hc]; exact W.one_mem

  have hA : ∀ w : Ω, algebraMap Ω (RatFunc Ω) w ∈ O ↔ w ∈ W := by
    intro w
    rw [hO]
    constructor
    · rintro ⟨c₀, hc₀, hv₀, H⟩
      exact inocC' w c₀ (H c₀ hc₀ hv₀ (one_div_self c₀ hc₀))
    · intro hw
      exact ⟨cs, hcs0, hcs, fun c hc _ _ => inocC w c hc hw⟩

  have hXinv : (RatFunc.X : RatFunc Ω)⁻¹ ∉ O := by
    rw [hO]; rintro ⟨c₀, hc₀, hv₀, H⟩
    exact s1 c₀ hc₀ hv₀ (H c₀ hc₀ hv₀ (one_div_self c₀ hc₀))
  have hB : O.valuation RatFunc.X < 1 := (KF O _ hX0).mpr hXinv

  have hiii : ∀ a : Ω, a ≠ 0 → W.valuation a < 1 →
      algebraMap Ω (RatFunc Ω) a * RatFunc.X⁻¹ ∈ O := by
    intro a ha hva
    rw [hO]
    exact ⟨a, ha, hva, fun c hc _ hac => s2 a c hc hac⟩

  have UF : ∀ w : Ω, W.valuation w = 1 → O.valuation (algebraMap Ω (RatFunc Ω) w) = 1 := by
    intro w hw
    have hw0 : w ≠ 0 := by rintro rfl; simp at hw
    have hy0 : algebraMap Ω (RatFunc Ω) w ≠ 0 := (map_ne_zero _).mpr hw0
    have h1 : algebraMap Ω (RatFunc Ω) w ∈ O := (hA w).mpr ((W.valuation_le_one_iff w).mp hw.le)
    have h2 : (algebraMap Ω (RatFunc Ω) w)⁻¹ ∈ O := by
      rw [← map_inv₀]; apply (hA _).mpr
      rw [← W.valuation_le_one_iff, map_inv₀, hw, inv_one]
    rw [← O.valuation_le_one_iff] at h1 h2
    rw [map_inv₀] at h2
    exact le_antisymm h1 ((inv_le_one₀ ((O.valuation).pos_iff.mpr hy0)).mp h2)

  have hXO : (RatFunc.X : RatFunc Ω) ∈ O := (O.valuation_le_one_iff _).mp hB.le
  have hCO : ∀ b : Ω, W.valuation b < 1 → algebraMap Ω (RatFunc Ω) b ∈ O :=
    fun b hb => (hA b).mpr ((W.valuation_le_one_iff b).mp hb.le)
  have stepM : ∀ b : Ω, b ≠ 0 → W.valuation b < 1 → ∀ k : ℤ,
      algebraMap Ω (RatFunc Ω) b * RatFunc.X ^ k ∈ O := by
    intro b hb hvb k
    obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg k
    · rw [zpow_natCast]; exact O.mul_mem _ _ (hCO b hvb) (O.pow_mem hXO n)
    · rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn; simp only [Nat.cast_zero, neg_zero, zpow_zero, mul_one]; exact hCO b hvb
      · obtain ⟨b', hb'⟩ := IsAlgClosed.exists_pow_nat_eq b hn
        have hb'0 : b' ≠ 0 := by rintro rfl; rw [zero_pow hn.ne'] at hb'; exact hb hb'.symm
        have hvb' : W.valuation b' < 1 := by
          rw [← pow_lt_one_iff hn.ne', ← map_pow, hb']; exact hvb
        have hy := O.pow_mem (hiii b' hb'0 hvb') n
        rw [mul_pow, ← map_pow, hb', inv_pow] at hy
        rw [zpow_neg, zpow_natCast]; exact hy
  have hiv : ∀ (a : Ω) (k : ℤ), a ≠ 0 → W.valuation a < 1 →
      O.valuation (algebraMap Ω (RatFunc Ω) a * RatFunc.X ^ k) < 1 := by
    intro a k ha hva
    obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq a (by norm_num : 0 < 2)
    have hb0 : b ≠ 0 := by rintro rfl; rw [zero_pow two_ne_zero] at hb; exact ha hb.symm
    have hvb : W.valuation b < 1 := by
      rw [← pow_lt_one_iff two_ne_zero, ← map_pow, hb]; exact hva
    have h1 : O.valuation (algebraMap Ω (RatFunc Ω) b) < 1 := by
      rw [KF O _ ((map_ne_zero _).mpr hb0), ← map_inv₀, hA]
      exact (KF W b hb0).mp hvb
    have h2 := (O.valuation_le_one_iff _).mpr (stepM b hb0 hvb k)
    have e : algebraMap Ω (RatFunc Ω) a * RatFunc.X ^ k =
        algebraMap Ω (RatFunc Ω) b * (algebraMap Ω (RatFunc Ω) b * RatFunc.X ^ k) := by
      rw [← mul_assoc, ← map_mul, ← pow_two, hb]
    rw [e, Valuation.map_mul]
    exact mul_lt_one_of_lt_of_le h1 h2

  have hE : ∀ (c : Ω) (d : ℤ), c ≠ 0 →
      O.valuation (algebraMap Ω (RatFunc Ω) c * RatFunc.X ^ d) = 1 → d = 0 := by
    intro c d hc hval
    rcases lt_trichotomy (W.valuation c) 1 with h | h | h
    · exact absurd hval (hiv c d hc h).ne
    · rw [Valuation.map_mul, UF c h, one_mul, map_zpow₀] at hval
      obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg d
      · rw [zpow_natCast] at hval
        rcases Nat.eq_zero_or_pos n with hn | hn
        · simp [hn]
        · exact absurd hval (pow_lt_one' hB hn.ne').ne
      · rw [zpow_neg, zpow_natCast, inv_eq_one] at hval
        rcases Nat.eq_zero_or_pos n with hn | hn
        · simp [hn]
        · exact absurd hval (pow_lt_one' hB hn.ne').ne
    · exfalso
      have hc' : W.valuation c⁻¹ < 1 := by
        rw [map_inv₀]; exact (inv_lt_one₀ ((W.valuation).pos_iff.mpr hc)).mpr h
      have h1 := hiv c⁻¹ (-d) (inv_ne_zero hc) hc'
      have e : algebraMap Ω (RatFunc Ω) c⁻¹ * RatFunc.X ^ (-d) =
          (algebraMap Ω (RatFunc Ω) c * RatFunc.X ^ d)⁻¹ := by
        rw [map_inv₀, zpow_neg, mul_inv]
      rw [e, map_inv₀, hval, inv_one] at h1
      exact lt_irrefl _ h1

  have hpoly : ∀ p : Polynomial Ω, p ≠ 0 → ∃ (c : Ω) (n : ℕ), c ≠ 0 ∧
      O.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) p) =
        O.valuation (algebraMap Ω (RatFunc Ω) c * RatFunc.X ^ n) := by
    intro p hp
    have hS : p.support.Nonempty := Polynomial.support_nonempty.mpr hp
    obtain ⟨i₁, hi₁, hmax⟩ :=
      Finset.exists_max_image p.support (fun i => W.valuation (p.coeff i)) hS
    have hTne : (p.support.filter
        (fun i => W.valuation (p.coeff i) = W.valuation (p.coeff i₁))).Nonempty :=
      ⟨i₁, Finset.mem_filter.mpr ⟨hi₁, rfl⟩⟩
    obtain ⟨i₀, hi₀T, hi₀min⟩ : ∃ i₀ ∈ p.support.filter
        (fun i => W.valuation (p.coeff i) = W.valuation (p.coeff i₁)),
        ∀ i ∈ p.support.filter
          (fun i => W.valuation (p.coeff i) = W.valuation (p.coeff i₁)), i₀ ≤ i :=
      ⟨_, Finset.min'_mem _ hTne, fun i hi => Finset.min'_le _ i hi⟩
    have hi₀S : i₀ ∈ p.support := (Finset.mem_filter.mp hi₀T).1
    have hi₀M : W.valuation (p.coeff i₀) = W.valuation (p.coeff i₁) :=
      (Finset.mem_filter.mp hi₀T).2
    have hc0 : p.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀S
    have hC0 : algebraMap Ω (RatFunc Ω) (p.coeff i₀) ≠ 0 := (map_ne_zero _).mpr hc0
    refine ⟨p.coeff i₀, i₀, hc0, ?_⟩
    have hm0 : algebraMap Ω (RatFunc Ω) (p.coeff i₀) * RatFunc.X ^ i₀ ≠ 0 :=
      mul_ne_zero hC0 (pow_ne_zero _ hX0)
    have hvm0 : O.valuation (algebraMap Ω (RatFunc Ω) (p.coeff i₀) * RatFunc.X ^ i₀) ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr hm0
    have hexp : algebraMap (Polynomial Ω) (RatFunc Ω) p =
        ∑ i ∈ p.support, algebraMap Ω (RatFunc Ω) (p.coeff i) * RatFunc.X ^ i := by
      conv_lhs => rw [Polynomial.as_sum_support_C_mul_X_pow p]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, RatFunc.algebraMap_X, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    have hlt : ∀ i ∈ p.support.erase i₀,
        O.valuation (algebraMap Ω (RatFunc Ω) (p.coeff i) * RatFunc.X ^ i) <
          O.valuation (algebraMap Ω (RatFunc Ω) (p.coeff i₀) * RatFunc.X ^ i₀) := by
      intro i hi
      obtain ⟨hii₀, hiS⟩ := Finset.mem_erase.mp hi
      have hci : p.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hiS
      have hfac : algebraMap Ω (RatFunc Ω) (p.coeff i) * RatFunc.X ^ i =
          (algebraMap Ω (RatFunc Ω) (p.coeff i₀) * RatFunc.X ^ i₀) *
            (algebraMap Ω (RatFunc Ω) (p.coeff i / p.coeff i₀) * RatFunc.X ^ ((i : ℤ) - i₀)) := by
        rw [map_div₀, zpow_sub₀ hX0, zpow_natCast, zpow_natCast]
        field_simp
      have key : O.valuation (algebraMap Ω (RatFunc Ω) (p.coeff i / p.coeff i₀) *
          RatFunc.X ^ ((i : ℤ) - i₀)) < 1 := by
        have hle : W.valuation (p.coeff i) ≤ W.valuation (p.coeff i₁) := hmax i hiS
        rcases hle.lt_or_eq with hlt' | heq'
        · apply hiv _ _ (div_ne_zero hci hc0)
          rw [Valuation.map_div, hi₀M]
          exact (div_lt_one₀ (by rw [← hi₀M]; exact (Valuation.pos_iff _).mpr hc0)).mpr hlt'
        · have hiT : i ∈ p.support.filter
              (fun i => W.valuation (p.coeff i) = W.valuation (p.coeff i₁)) :=
            Finset.mem_filter.mpr ⟨hiS, heq'⟩
          have hle' : i₀ ≤ i := hi₀min i hiT
          have hlt'' : i₀ < i := lt_of_le_of_ne hle' (Ne.symm hii₀)
          have hu : W.valuation (p.coeff i / p.coeff i₀) = 1 := by
            rw [Valuation.map_div, hi₀M, heq', div_self]
            rw [← hi₀M]; exact (Valuation.ne_zero_iff _).mpr hc0
          have hz : ((i : ℤ) - i₀) = ((i - i₀ : ℕ) : ℤ) := by omega
          rw [Valuation.map_mul, UF _ hu, one_mul, hz, zpow_natCast, Valuation.map_pow]
          exact pow_lt_one' hB (by omega)
      rw [hfac, Valuation.map_mul]
      calc _ < O.valuation (algebraMap Ω (RatFunc Ω) (p.coeff i₀) * RatFunc.X ^ i₀) * 1 :=
            mul_lt_mul_of_pos_left key (zero_lt_iff.mpr hvm0)
        _ = _ := mul_one _
    rw [hexp, ← Finset.add_sum_erase _ _ hi₀S, Valuation.map_add_eq_of_lt_left]
    exact Valuation.map_sum_lt _ hvm0 hlt

  refine ⟨hA, hB, ?_, hE⟩
  intro f hf
  obtain ⟨a, n₁, ha, hN⟩ := hpoly f.num (RatFunc.num_ne_zero hf)
  obtain ⟨b, n₂, hb, hD⟩ := hpoly f.denom (RatFunc.denom_ne_zero f)
  refine ⟨a / b, (n₁ : ℤ) - n₂, div_ne_zero ha hb, ?_⟩
  have hma : O.valuation (algebraMap Ω (RatFunc Ω) a * RatFunc.X ^ n₁) ≠ 0 :=
    (Valuation.ne_zero_iff _).mpr (mul_ne_zero ((map_ne_zero _).mpr ha) (pow_ne_zero _ hX0))
  have hmb : O.valuation (algebraMap Ω (RatFunc Ω) b * RatFunc.X ^ n₂) ≠ 0 :=
    (Valuation.ne_zero_iff _).mpr (mul_ne_zero ((map_ne_zero _).mpr hb) (pow_ne_zero _ hX0))
  have e : algebraMap Ω (RatFunc Ω) (a / b) * RatFunc.X ^ ((n₁ : ℤ) - n₂) =
      (algebraMap Ω (RatFunc Ω) a * RatFunc.X ^ n₁) /
        (algebraMap Ω (RatFunc Ω) b * RatFunc.X ^ n₂) := by
    rw [map_div₀, zpow_sub₀ hX0, zpow_natCast, zpow_natCast]; ring
  conv_lhs => rw [← RatFunc.num_div_denom f]
  rw [e, Valuation.map_div, Valuation.map_div, Valuation.map_div, hN, hD]
  exact div_self (div_ne_zero hma hmb)

theorem wcpa_dj_lr1k_eb_rd_charpoly_certificate : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L] [Algebra.IsSeparable (RatFunc Ω) L], wcEbDefectless W L → wcEbAnGaussStr W L → ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L), wcEbMoBD W L m U e η u → ∀ b : Fin m, (∀ j, wcEbAnInU W ((LinearMap.charpoly (Algebra.lmul (RatFunc Ω) L (η b))).coeff j)) ∧ ∃ k, k ≤ e b ∧ (LinearMap.charpoly (Algebra.lmul (RatFunc Ω) L (η b))).coeff k ≠ 0 ∧ wcEbAnInU W ((LinearMap.charpoly (Algebra.lmul (RatFunc Ω) L (η b))).coeff k)⁻¹ :=
by
  classical

  have s1 : ∀ (K L E : Type u) [Field K] [Field L] [Field E] [Algebra K L] [FiniteDimensional K L]
      [Algebra.IsSeparable K L] [Algebra K E] [IsAlgClosed E] [Infinite K] (z : L),
      (LinearMap.charpoly (Algebra.lmul K L z)).map (algebraMap K E) =
        ∏ σ : L →ₐ[K] E, (Polynomial.X - Polynomial.C (σ z)) := by
    intro K L E _ _ _ _ _ _ _ _ _ z
    let bs := Module.finBasis K L
    have hev : ∀ c : K, (LinearMap.charpoly (Algebra.lmul K L z)).eval c =
        Algebra.norm K (algebraMap K L c - z) := by
      intro c
      rw [← LinearMap.charpoly_toMatrix (Algebra.lmul K L z) bs, Matrix.eval_charpoly,
        Algebra.norm_eq_matrix_det bs, map_sub, AlgHom.commutes, Algebra.leftMulMatrix_apply]
      congr 2
    set D := (LinearMap.charpoly (Algebra.lmul K L z)).map (algebraMap K E) -
      ∏ σ : L →ₐ[K] E, (Polynomial.X - Polynomial.C (σ z)) with hD
    have hroot : ∀ c : K, D.IsRoot (algebraMap K E c) := by
      intro c
      rw [Polynomial.IsRoot, hD, Polynomial.eval_sub, Polynomial.eval_map,
        Polynomial.eval₂_at_apply, hev, Algebra.norm_eq_prod_embeddings K E, Polynomial.eval_prod,
        sub_eq_zero]
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, map_sub, AlgHom.commutes]
    have hinf : {x | D.IsRoot x}.Infinite := by
      apply Set.Infinite.mono (s := Set.range (algebraMap K E))
      · rintro _ ⟨c, rfl⟩
        exact hroot c
      · exact Set.infinite_range_of_injective (algebraMap K E).injective
    exact sub_eq_zero.mp (Polynomial.eq_zero_of_infinite_isRoot D hinf)

  have s2 : ∀ (E : Type u) [Field E] (V : ValuationSubring E) (ι : Type u) [Fintype ι]
      (r : ι → E) (S : Finset ι), (∀ i ∈ S, V.valuation (r i) < 1) →
      (∀ i, i ∉ S → V.valuation (r i) = 1) →
      (∀ j, (∏ i, (Polynomial.X - Polynomial.C (r i))).coeff j ∈ V) ∧
        V.valuation ((∏ i, (Polynomial.X - Polynomial.C (r i))).coeff S.card) = 1 := by
    intro E _ V ι _ r S hS hnS
    have hmem : ∀ i, r i ∈ V := by
      intro i
      rw [← V.valuation_le_one_iff]
      by_cases hi : i ∈ S
      · exact (hS i hi).le
      · exact (hnS i hi).le
    let r' : ι → V := fun i => ⟨r i, hmem i⟩
    let P' : Polynomial V := ∏ i, (Polynomial.X - Polynomial.C (r' i))
    have hP' : P'.map V.subtype = ∏ i, (Polynomial.X - Polynomial.C (r i)) := by
