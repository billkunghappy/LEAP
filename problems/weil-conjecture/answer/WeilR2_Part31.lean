        _ = a := by rw [IsUnit.mul_val_inv, mul_one, hδ2]
    · intro n hu
      exact hδnu (isUnit_of_mul_isUnit_left hu)
    · intro n hu
      exact hδnu (isUnit_of_mul_isUnit_left hu)
  have hroot : ∀ n, p.IsRoot (x n) := by
    intro n
    obtain ⟨g, hgC, hg0, hg1⟩ : ∃ g : wcEbntN W a →+* ↥W,
