    exact h1
  have hσ'r₂ : σ' (IsLocalRing.closedPoint ↥W) ∈ Z.basicOpen r₂ := by
    have h1 : IsLocalRing.closedPoint ↥W ∈ σ' ⁻¹ᵁ (Z.basicOpen r₂) := by
      rw [Scheme.preimage_basicOpen, hθr₂, Scheme.basicOpen_one]
      exact hσ'V
    exact h1
  have hσO_mem : σ (IsLocalRing.closedPoint ↥W) ∈ Z.basicOpen (r₁ * r₂) := by
    rw [Scheme.basicOpen_mul]
    exact ⟨hσr₁, by rw [hpt]; exact hσ'r₂⟩
  have hσ'O_mem : σ' (IsLocalRing.closedPoint ↥W) ∈ Z.basicOpen (r₁ * r₂) := by
    rw [← hpt]; exact hσO_mem
  obtain ⟨σO, hσO⟩ := liftO _ σ hσO_mem
  obtain ⟨σ'O, hσ'O⟩ := liftO _ σ' hσ'O_mem

  obtain ⟨m, hm, hmq, hmP⟩ := chart_morphism ↥W Z uu V hle g₀ hV hg₀ (hg₀C.trans hgC)
    (Z.basicOpen (r₁ * r₂)) (Z.basicOpen_le (r₁ * r₂))

  have hKO := ker_open_lift Z (Spec (.of ↥W)) (Z.basicOpen (r₁ * r₂)) σ σO hσO _ hK
  rw [← hmP] at hKO
  have hK'O := ker_open_lift Z (Spec (.of ↥W)) (Z.basicOpen (r₁ * r₂)) σ' σ'O hσ'O _ hK'
  rw [← hmP] at hK'O

  have hsec0 : (σO ≫ m) ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ := by
    rw [Category.assoc, hmq, ← Category.assoc, hσO, hσ]
  have hG := section_eval ↥W (σO ≫ m) hsec0
  have hX0 : σO.appTop.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.X 0))) = 0 := by
    have h1 : m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0)) ∈ RingHom.ker σO.appTop.hom := by
      rw [hKO]; exact Ideal.subset_span rfl
    exact h1
  have hcΔ : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σO ≫ m).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) = 0 := by
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hX0, map_zero]
  rw [hcΔ] at hG
  have hsec' : (σ'O ≫ m) ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ := by
    rw [Category.assoc, hmq, ← Category.assoc, hσ'O, hσ']
  have hG' := section_eval ↥W (σ'O ≫ m) hsec'
  have h1' : σ'O.appTop.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.X 0 - MvPolynomial.C c'))) = 0 := by
    have h1 : m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C c')) ∈ RingHom.ker σ'O.appTop.hom := by
      rw [hK'O]; exact Ideal.subset_span rfl
    exact h1
  have hCnat : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c') =
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))).appTop.hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c') := by
    have := congrArg (fun f => f.hom c')
      (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    exact this
  have h2' : σ'O.appTop.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.C c'))) = (Scheme.ΓSpecIso (.of ↥W)).inv.hom c' := by
    rw [hCnat]
    have e : σ'O ≫ m ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ := by
      rw [hmq, ← Category.assoc, hσ'O, hσ']
    have e2 := congrArg (fun f => (Scheme.Hom.appTop f).hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c')) e
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
      Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply] at e2
    exact e2
  have hval : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ'O ≫ m).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) = c' := by
    have hXsplit : (MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W) =
        (MvPolynomial.X 0 - MvPolynomial.C c') + MvPolynomial.C c' := (sub_add_cancel _ _).symm
    rw [hXsplit]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, map_add, h1', h2',
      zero_add]
    exact CategoryTheory.Iso.inv_hom_id_apply (Scheme.ΓSpecIso (.of ↥W)) c'
  rw [hval] at hG'
  exact ⟨Z.basicOpen (r₁ * r₂), m, σO, σ'O, c', hV.basicOpen (r₁ * r₂), hm, hmq, hσO, hσ'O,
    hG, hG', hKO, hK'O⟩

theorem wcpa_dj_lr1k_ebd_centre_comap : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (σ σ' : Spec (.of ↥W) ⟶ X) (a a' c' : ↥W)
    (O : X.Opens) (m : O.toScheme ⟶ wcEbdA1 W) (σO σ'O : Spec (.of ↥W) ⟶ O.toScheme),
    IsClosedImmersion σ → IsClosedImmersion σ' → IsAffineOpen O → m ≫ wcEbdStr W = O.ι ≫ uX →
    σO ≫ O.ι = σ → σ'O ≫ O.ι = σ' → σO ≫ m = wcEbdSec W 0 → σ'O ≫ m = wcEbdSec W c' →
    RingHom.ker σO.appTop.hom = Ideal.span {m.appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} →
    RingHom.ker σ'O.appTop.hom = Ideal.span {m.appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C c'))} →
    (Scheme.Hom.ker σ ⊔ wcNcPrincipal (.of ↥W) X uX a).comap O.ι = (wcEbdJ W a).comap m ∧
    (Scheme.Hom.ker σ' ⊔ wcNcPrincipal (.of ↥W) X uX a').comap O.ι =
      (wcEbdJ W a').comap (m ≫ wcEbdShift W (-c')) ∧
    (Scheme.Hom.ker σ ⊔ wcNcPrincipal (.of ↥W) X uX a ≤
      Scheme.Hom.ker σ' ⊔ wcNcPrincipal (.of ↥W) X uX a' → a' ∣ a ∧ a' ∣ c') :=
by
  intro Ω _ W X uX σ σ' a a' c' O m σO σ'O hσci hσ'ci hOaff hmq hσO hσ'O hσOm hσ'Om hKO hK'O
  classical
  haveI : IsAffine O.toScheme := hOaff

  have comapL : ∀ (R : CommRingCat.{u}) (Y Y' : Scheme.{u}) (g : Y ⟶ Spec R) (f : Y' ⟶ Y) (t : R),
      (wcNcPrincipal R Y g t).comap f = wcNcPrincipal R Y' (f ≫ g) t := by
    have nat : ∀ (X Y : Scheme.{u}) (h : X ⟶ Y) (U : Y.Opens) (b : Γ(Y, ⊤)),
        (h.app U).hom ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom b) =
          (X.presheaf.map (homOfLE (le_top : h ⁻¹ᵁ U ≤ ⊤)).op).hom (h.appTop.hom b) := by
      intro X Y h U b
      exact congrArg (fun φ => φ.hom b) (h.naturality (homOfLE (le_top : U ≤ ⊤)).op)
    have key : ∀ (X : Scheme.{u}) (s : Γ(X, ⊤)),
        (Scheme.IdealSheafData.ofIdealTop (Ideal.span {s})).subschemeι.appTop.hom s = 0 := by
      intro X s
      set J := Scheme.IdealSheafData.ofIdealTop (Ideal.span {s})
      apply J.subscheme.IsSheaf.section_ext
      intro x _
      obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := J.subschemeι x)
        (U := ⊤) trivial
      refine ⟨J.subschemeι ⁻¹ᵁ W, le_top, hxW, ?_⟩
      rw [map_zero]
      have h1 := nat _ _ J.subschemeι W s
      rw [← h1]
      rw [← RingHom.mem_ker, J.ker_subschemeι_app ⟨W, hW⟩, Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self s)
    intro R Y Y' g f t
    unfold wcNcPrincipal
    set a := g.appTop.hom ((Scheme.ΓSpecIso R).inv.hom t)
    have hb : (f ≫ g).appTop.hom ((Scheme.ΓSpecIso R).inv.hom t) = f.appTop.hom a := rfl
    rw [hb]
    set b := f.appTop.hom a
    set I := Scheme.IdealSheafData.ofIdealTop (Ideal.span {a}) with hI
    set I' := Scheme.IdealSheafData.ofIdealTop (Ideal.span {b}) with hI'
    apply le_antisymm
    · apply (Scheme.IdealSheafData.le_map_iff_comap_le).mp
      show _ ≤ Scheme.Hom.ker _
      unfold Scheme.Hom.ker
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U
      rw [hI, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
        Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat]
      have hz : (I'.subschemeι ≫ f).appTop.hom a = 0 := key Y' b
      rw [hz]
      exact map_zero _
    · show _ ≤ Scheme.Hom.ker _
      unfold Scheme.Hom.ker
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U
      rw [hI', Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
        Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat]
      have hz : (Limits.pullback.fst f I.subschemeι).appTop.hom b = 0 := by
        calc (Limits.pullback.fst f I.subschemeι).appTop.hom b
            = (Limits.pullback.fst f I.subschemeι ≫ f).appTop.hom a := rfl
          _ = (Limits.pullback.snd f I.subschemeι ≫ I.subschemeι).appTop.hom a := by
            rw [Limits.pullback.condition]
          _ = (Limits.pullback.snd f I.subschemeι).appTop.hom (I.subschemeι.appTop.hom a) := rfl
          _ = 0 := by rw [key Y a]; exact map_zero _
      rw [hz]
      exact map_zero _

  have kerR : ∀ (X : Scheme.{u}) (U : X.Opens) (R : CommRingCat.{u}) (Δ : Spec R ⟶ X)
      (ΔU : Spec R ⟶ U.toScheme), IsClosedImmersion Δ → ΔU ≫ U.ι = Δ →
      (Scheme.Hom.ker Δ).comap U.ι = Scheme.Hom.ker ΔU := by
    intro X U R Δ ΔU hΔ hΔU
    haveI := hΔ
    have H : Set.range Δ ⊆ Set.range U.ι := by
      rintro _ ⟨x, rfl⟩
      exact ⟨ΔU x, by rw [← hΔU]; rfl⟩
    have hpb : IsPullback ΔU (𝟙 (Spec R)) U.ι Δ := by
      have h1 := IsOpenImmersion.isPullback_lift_id Δ U.ι H
      rwa [← IsOpenImmersion.lift_uniq U.ι Δ H ΔU hΔU] at h1
    apply Scheme.IdealSheafData.ext
    funext V
    rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
      Scheme.ker_ideal_of_isPullback_of_isOpenImmersion Δ ΔU (𝟙 _) U.ι hpb V]

  have kerC : ∀ (U : Scheme.{u}) (mm : U ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (ΔU : Spec (.of ↥W) ⟶ U), IsAffine U →
      ΔU ≫ mm = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) →
      RingHom.ker ΔU.appTop.hom = Ideal.span {mm.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} →
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))))).comap mm = Scheme.Hom.ker ΔU := by
    intro U mm ΔU hU _ hker
    have s2 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
        Ideal.span {MvPolynomial.X 0} := by
      ext p
      rw [RingHom.mem_ker, MvPolynomial.eval_zero']
      constructor
      · intro hp
        rw [← Set.image_singleton, MvPolynomial.mem_ideal_span_X_image]
        intro n hn
        refine ⟨0, Set.mem_singleton _, ?_⟩
        intro h0
        have hn0 : n = 0 := by
          rw [Finsupp.unique_ext_iff]
          exact h0
        rw [MvPolynomial.mem_support_iff, hn0] at hn
        exact hn (by rw [← MvPolynomial.constantCoeff_eq]; exact hp)
      · intro hp
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
        simp
    have s3 : Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span
          {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)}) := by
      rw [Scheme.ker_of_isAffine]
      congr 1
      have nat : ∀ y, (Scheme.ΓSpecIso (.of ↥W)).hom.hom
          ((Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))).appTop.hom y) =
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom y) := by
        intro y
        have := congrArg (fun h => h.hom y)
          (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))))
        exact this
      have inj : ∀ z, (Scheme.ΓSpecIso (.of ↥W)).hom.hom z = 0 → z = 0 := by
        intro z hz
        have e : (Scheme.ΓSpecIso (.of ↥W)).inv.hom ((Scheme.ΓSpecIso (.of ↥W)).hom.hom z) = z := by
          simp
        rw [← e, hz, map_zero]
      ext y
      rw [RingHom.mem_ker, Ideal.mem_span_singleton']
      constructor
      · intro hy
        have h2 : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom y ∈
            RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) := by
          rw [RingHom.mem_ker, ← nat, hy, map_zero]
        rw [s2] at h2
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
        refine ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom c, ?_⟩
        rw [← map_mul, hc]
        simp
      · rintro ⟨c, rfl⟩
        rw [map_mul]
        have h0 : (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) = 0 := by
          apply inj
          rw [nat]
          simp
        rw [h0, mul_zero]
    have : IsAffine U := hU
    rw [s3, Scheme.ker_of_isAffine ΔU, hker]
    have e1 : Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)}) =
        wcNcPrincipal (.of (MvPolynomial (Fin 1) ↥W)) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (𝟙 _)
          (MvPolynomial.X 0) := by
      unfold wcNcPrincipal
      rw [Scheme.Hom.id_appTop]
      rfl
    rw [e1, comapL, Category.comp_id]
    rfl

  have hshq : wcEbdShift W (-c') ≫ wcEbdStr W = wcEbdStr W := by
    dsimp only [wcEbdShift, wcEbdStr]
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    ext r : 1
    simp
  have hm'q : (m ≫ wcEbdShift W (-c')) ≫ wcEbdStr W = O.ι ≫ uX := by
    rw [Category.assoc, hshq, hmq]
  have hσ'Om' : σ'O ≫ (m ≫ wcEbdShift W (-c')) = wcEbdSec W 0 := by
    rw [← Category.assoc, hσ'Om]
    dsimp only [wcEbdShift, wcEbdSec]
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r; simp
    · intro i; fin_cases i; simp
  have hsh : (wcEbdShift W (-c')).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C c') := by
    have e : (MvPolynomial.X 0 - MvPolynomial.C c' : MvPolynomial (Fin 1) ↥W) =
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun _ : Fin 1 => MvPolynomial.X 0 + MvPolynomial.C (-c')) (MvPolynomial.X 0) := by
      rw [MvPolynomial.eval₂Hom_X', map_neg, sub_eq_add_neg]
    rw [e]
    have nat := Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.eval₂Hom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
        (fun _ : Fin 1 => (MvPolynomial.X 0 + MvPolynomial.C (-c') : MvPolynomial (Fin 1) ↥W))))
    have nat' := congrArg (fun φ => φ.hom (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) ↥W)) nat
    exact nat'.symm
  have hK' : RingHom.ker σ'O.appTop.hom = Ideal.span {(m ≫ wcEbdShift W (-c')).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} := by
    have e : (m ≫ wcEbdShift W (-c')).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
        m.appTop.hom ((wcEbdShift W (-c')).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) := rfl
    rw [e, hsh]
    exact hK'O
  refine ⟨?_, ?_, ?_⟩
  ·
    show (Scheme.Hom.ker σ ⊔ wcNcPrincipal (.of ↥W) X uX a).comap O.ι =
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a).comap m
    rw [Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup, comapL, comapL,
      kerR X O (.of ↥W) σ σO hσci hσO, kerC O.toScheme m σO inferInstance hσOm hKO, hmq]
  ·
    show (Scheme.Hom.ker σ' ⊔ wcNcPrincipal (.of ↥W) X uX a').comap O.ι =
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a').comap
        (m ≫ wcEbdShift W (-c'))
    rw [Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup, comapL, comapL,
      kerR X O (.of ↥W) σ' σ'O hσ'ci hσ'O,
      kerC O.toScheme (m ≫ wcEbdShift W (-c')) σ'O inferInstance hσ'Om' hK', hm'q]
  ·
    intro H
    have H1 : (Scheme.Hom.ker σ ⊔ wcNcPrincipal (.of ↥W) X uX a).comap O.ι ≤
        (Scheme.Hom.ker σ' ⊔ wcNcPrincipal (.of ↥W) X uX a').comap O.ι :=
      Scheme.IdealSheafData.comap_mono O.ι H
    rw [Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup, comapL, comapL,
      kerR X O (.of ↥W) σ σO hσci hσO, kerR X O (.of ↥W) σ' σ'O hσ'ci hσ'O] at H1
    set U₀ : O.toScheme.affineOpens := ⟨⊤, isAffineOpen_top _⟩ with hU₀
    have H2 := Scheme.IdealSheafData.le_def.mp H1 U₀
    have hρ : ∀ (h : (U₀ : O.toScheme.Opens) ≤ ⊤) (s : Γ(O.toScheme, ⊤)),
        (O.toScheme.presheaf.map (homOfLE h).op).hom s = s := by
      intro h s
      first
        | exact (congrArg (fun φ => φ.hom s) (O.toScheme.presheaf.map_id (Opposite.op ⊤))).trans rfl
        | simp
    let ψ : Γ(O.toScheme, ⊤) →+* ↥W :=
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom.comp σ'O.appTop.hom
    have hF : ∀ p : MvPolynomial (Fin 1) ↥W,
        ψ (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p)) =
          MvPolynomial.eval (fun _ : Fin 1 => c') p := by
      intro p
      have e1 : ψ (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p)) =
          (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ'O ≫ m).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p)) := rfl
      rw [e1, hσ'Om]
      have nat := congrArg
        (fun h => h.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p))
        (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c'))))
      refine nat.trans ?_
      simp
    have hgbar : ∀ t : ↥W, (O.ι ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom t) =
        m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.C t)) := by
      intro t
      rw [← hmq]
      show m.appTop.hom ((wcEbdStr W).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom t)) = _
      congr 1
      exact (congrArg (fun φ => φ.hom t) (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))).symm
    have hpsig : ∀ t : ↥W,
        ψ ((O.ι ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom t)) = t := by
      intro t
      rw [hgbar, hF, MvPolynomial.eval_C]
    have hψT : ψ (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0))) = c' := by
      rw [hF, MvPolynomial.eval_X]
    have mem1 : (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0)) : Γ(O.toScheme, ⊤)) ∈
        (Scheme.Hom.ker σO ⊔ wcNcPrincipal (.of ↥W) O.toScheme (O.ι ≫ uX) a).ideal U₀ := by
      rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply]
      apply Ideal.mem_sup_left
      rw [Scheme.Hom.ker_apply]
      show _ ∈ RingHom.ker σO.appTop.hom
      rw [hKO]
      exact Ideal.mem_span_singleton_self _
    have mem2 : ((O.ι ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) :
        Γ(O.toScheme, ⊤)) ∈
        (Scheme.Hom.ker σO ⊔ wcNcPrincipal (.of ↥W) O.toScheme (O.ι ≫ uX) a).ideal U₀ := by
      rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply]
      apply Ideal.mem_sup_right
      unfold wcNcPrincipal
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      have h := Ideal.mem_map_of_mem
        (O.toScheme.presheaf.map (homOfLE (le_top : (U₀ : O.toScheme.Opens) ≤ ⊤)).op).hom
        (Ideal.mem_span_singleton_self
          ((O.ι ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)))
      rw [hρ] at h
      exact h
    have hbound : ∀ x ∈
        (Scheme.Hom.ker σ'O ⊔ wcNcPrincipal (.of ↥W) O.toScheme (O.ι ≫ uX) a').ideal U₀,
        a' ∣ ψ x := by
      intro x hx
      rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Scheme.Hom.ker_apply] at hx
      unfold wcNcPrincipal at hx
      rw [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton] at hx
      obtain ⟨k, hk, y, hy, rfl⟩ := Submodule.mem_sup.mp hx
      obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      have hk' : σ'O.appTop.hom k = 0 := hk
      have hk0 : ψ k = 0 := by
        show (Scheme.ΓSpecIso (.of ↥W)).hom.hom (σ'O.appTop.hom k) = 0
        rw [hk', map_zero]
      rw [map_add, map_mul, hk0, zero_add, hρ, hpsig a']
      exact dvd_mul_left _ _
    have d1 := hbound _ (H2 mem2)
    have d2 := hbound _ (H2 mem1)
    rw [hpsig a] at d1
    rw [hψT] at d2
    exact ⟨d1, d2⟩

theorem wcpa_dj_lr1k_ebd_model_charts : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (c : ↥W), c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (M : Scheme.{u}) (r₀ : M ⟶ wcEbdA1 W), wcCsdIsBlowup (wcEbdJ W c) r₀ →
    ∃ e : wcEbdQ W c ⟶ M, IsOpenImmersion e ∧ e ≫ r₀ = wcEbdHX W c ∧
      ∀ n : M, r₀ n = wcEbdSec W 0 (IsLocalRing.closedPoint ↥W) →
        (¬ ∃ N : M.Opens, n ∈ N ∧ SmoothOfRelativeDimension 1 (N.ι ≫ r₀ ≫ wcEbdStr W)) →
        ∃ y : wcEbdQ W c, e y = n ∧ wcEbdQX W c 0 ∈ y.asIdeal ∧ wcEbdQX W c 1 ∈ y.asIdeal :=
by
  intro Ω _ W c hc _hcm M r₀ hr₀
  classical

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)}) := by
    unfold wcNcPrincipal
    have := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [this]
  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext V
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have hJ : Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
      wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
        (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)])) := by
    rw [hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hker0, hprinc, hsup]
    congr 1
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union, Ideal.span_insert]
  have hr₀' : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)]))) r₀ := by
    have h0 : wcCsdIsBlowup (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c) r₀ :=
      hr₀
    rwa [hJ] at h0

  obtain ⟨U, t, hU⟩ := wc_bp_blowup_charts _ r₀ hr₀'
  have hrat := hU.2.2.1
  have hnzdU := hU.2.2.2.1

  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} with hIdef
  have h00 : (r₀.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
      t 0 0 * (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) :=
    hrat 0 0
  have h01 : (r₀.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) =
      t 0 1 * (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) :=
    hrat 0 1
  have hnz0 : (r₀.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) ∈
      nonZeroDivisors Γ(M, U 0) :=
    hnzdU 0
  have hAB : Ideal.Quotient.mk I (MvPolynomial.X 0) * Ideal.Quotient.mk I (MvPolynomial.X 1) =
      Ideal.Quotient.mk I (MvPolynomial.C c) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  let θ₀ : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ I :=
    (Ideal.Quotient.mk I).comp (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin 2))).toRingHom
  have hθC : ∀ w : ↥W, θ₀ (MvPolynomial.C w) = Ideal.Quotient.mk I (MvPolynomial.C w) :=
    fun w => by simp [θ₀]
  have hθX : θ₀ (MvPolynomial.X 0) = Ideal.Quotient.mk I (MvPolynomial.X 0) := by simp [θ₀]
  let θc : CommRingCat.of (MvPolynomial (Fin 1) ↥W) ⟶
      CommRingCat.of (MvPolynomial (Fin 2) ↥W ⧸ I) :=
    CommRingCat.ofHom θ₀
  let h : Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)) :=
    Spec.map θc
  have hnat : ∀ z, h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom (θ₀ z) := by
    intro z
    have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ z) (Scheme.ΓSpecIso_inv_naturality θc)
    simp only [θc, CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e2
    exact e2.symm
  have hδγ : ∀ z : MvPolynomial (Fin 2) ↥W ⧸ I,
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom z) = z :=
    fun z => by simp
  have hγδ : ∀ s : Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)), ⊤),
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom s) = s :=
    fun s => by simp
  have hγδa : ∀ s : Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤),
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom s) = s :=
    fun s => by simp
  have hAnzd : ∀ y : MvPolynomial (Fin 2) ↥W ⧸ I,
      y * Ideal.Quotient.mk I (MvPolynomial.X 0) = 0 → y = 0 := by
    intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨σ₀, hσ0, hσ1, hσC⟩ : ∃ σ₀ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W,
        σ₀ (MvPolynomial.X 0) = 0 ∧ σ₀ (MvPolynomial.X 1) = MvPolynomial.X 1 ∧
        ∀ r, σ₀ (MvPolynomial.C r) = MvPolynomial.C r :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 1], by simp, by simp, by simp⟩
    have hdvd : ∀ f : MvPolynomial (Fin 2) ↥W, MvPolynomial.X 0 ∣ f - σ₀ f := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C r => rw [hσC, sub_self]; exact dvd_zero _
      | add f g hf hg => rw [map_add, add_sub_add_comm]; exact dvd_add hf hg
      | mul_X f n hf =>
        rw [map_mul]
        have e : f * MvPolynomial.X n - σ₀ f * σ₀ (MvPolynomial.X n) =
            (f - σ₀ f) * MvPolynomial.X n + σ₀ f * (MvPolynomial.X n - σ₀ (MvPolynomial.X n)) := by
          ring
        rw [e]
        refine dvd_add (dvd_mul_of_dvd_left hf _) (dvd_mul_of_dvd_right ?_ _)
        fin_cases n
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 0 - σ₀ (MvPolynomial.X 0)
          rw [hσ0, sub_zero]
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 1 - σ₀ (MvPolynomial.X 1)
          rw [hσ1, sub_self]; exact dvd_zero _
    have hσg : σ₀ g = 0 := by
      have h1 := congrArg σ₀ hg
      simp only [map_mul, map_sub, hσ0, hσ1, hσC] at h1
      have h2 : σ₀ g * MvPolynomial.C c = 0 := by linear_combination -h1
      exact (mul_eq_zero.mp h2).resolve_right (fun hc' => hc (MvPolynomial.C_eq_zero.mp hc'))
    obtain ⟨g', hg'⟩ := hdvd g
    rw [hσg, sub_zero] at hg'
    have hp : p * MvPolynomial.X 0 =
        (g' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c)) * MvPolynomial.X 0 := by
      rw [← hg, hg']; ring
    have hp' := mul_right_cancel₀ (MvPolynomial.X_ne_zero 0) hp
    rw [Ideal.Quotient.eq_zero_iff_mem, hp']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  have ht00 : t 0 0 = 1 := by
    apply (mul_cancel_right_mem_nonZeroDivisors hnz0).mp
    rw [one_mul]
    exact h00.symm
  obtain ⟨Φ, hΦX0, hΦX1, hΦC⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥W ⧸ I →+* Γ(M, U 0),
      Φ (Ideal.Quotient.mk I (MvPolynomial.X 0)) = (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) ∧
      Φ (Ideal.Quotient.mk I (MvPolynomial.X 1)) = t 0 1 ∧
      ∀ w : ↥W, Φ (Ideal.Quotient.mk I (MvPolynomial.C w)) = (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w)) := by
    let ψ : ↥W →+* Γ(M, U 0) := (r₀.appLE ⊤ (U 0) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C)
    let Φt : MvPolynomial (Fin 2) ↥W →+* Γ(M, U 0) := MvPolynomial.eval₂Hom ψ
      ![(r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)), t 0 1]
    have hΦt : ∀ p ∈ I, Φt p = 0 := by
      intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      have hF : Φt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
        simp only [Φt, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        have e : ψ c = (r₀.appLE ⊤ (U 0) (by simp)).hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) := rfl
        rw [e, h01]
        ring
      rw [map_mul, hF, mul_zero]
    refine ⟨Ideal.Quotient.lift I Φt hΦt, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · intro w
      rw [Ideal.Quotient.lift_mk]
      simp only [Φt, MvPolynomial.eval₂Hom_C]
      rfl
  have hkey : Φ.comp θ₀ = (r₀.appLE ⊤ (U 0) (by simp)).hom.comp
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom := by
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [hθC, hΦC]
    · intro i
      fin_cases i
      show Φ (θ₀ (MvPolynomial.X 0)) = (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))
      rw [hθX, hΦX0]
  have hstr : h ≫ wcEbdStr W =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I))) := by
    show Spec.map θc ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I)))
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro w
    simp only [θc, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    exact (hθC w).trans rfl
  have hdata : ∃ τ : Fin 2 → Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)), ⊤),
      (∀ j, h.appTop.hom (![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0), (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.C c)] j) = τ j * h.appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) ∧
      h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0)) ∈ nonZeroDivisors Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)), ⊤) ∧
      (∀ s : Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)), ⊤),
          s ∈ Subring.closure (Set.range h.appTop.hom ∪ Set.range τ)) ∧
      ∃ φ : Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)), ⊤) →+* Γ(M, U 0),
        φ.comp h.appTop.hom = (r₀.appLE ⊤ (U 0) (by simp)).hom ∧ ∀ j, φ (τ j) = t 0 j := by
    refine ⟨![1, (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
        (Ideal.Quotient.mk I (MvPolynomial.X 1))], ?_, ?_, ?_, ?_⟩
    · intro j
      fin_cases j
      · exact (one_mul _).symm
      · show h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
            (MvPolynomial.C c)) =
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X 1)) *
          h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))
        have e2 : (Ideal.Quotient.mk I (MvPolynomial.C c) : MvPolynomial (Fin 2) ↥W ⧸ I) =
            Ideal.Quotient.mk I (MvPolynomial.X 1) * Ideal.Quotient.mk I (MvPolynomial.X 0) := by
          rw [← hAB]; ring
        rw [hnat, hnat, hθC, hθX, e2, map_mul]
    · rw [hnat, hθX, mem_nonZeroDivisors_iff_right]
      intro y hy
      have h1 := congrArg (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom hy
      rw [map_mul, hδγ, map_zero] at h1
      have h2 := hAnzd _ h1
      rw [← hγδ y, h2, map_zero]
    · have hgen : ∀ z : MvPolynomial (Fin 2) ↥W ⧸ I,
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom z ∈
          Subring.closure (Set.range h.appTop.hom ∪ Set.range ![1,
            (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
              (Ideal.Quotient.mk I (MvPolynomial.X 1))]) := by
        intro z
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
        induction p using MvPolynomial.induction_on with
        | C w =>
          exact Subring.subset_closure (Set.mem_union_left _
            ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w),
              (hnat _).trans (congrArg _ (hθC w))⟩)
        | add f g hf hg =>
          have e : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
              (Ideal.Quotient.mk I (f + g)) =
              (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
                (Ideal.Quotient.mk I f) +
              (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
                (Ideal.Quotient.mk I g) := by
            rw [map_add, map_add]
          rw [e]
          exact Subring.add_mem _ hf hg
        | mul_X f n hf =>
          have e : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
              (Ideal.Quotient.mk I (f * MvPolynomial.X n)) =
              (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
                (Ideal.Quotient.mk I f) *
              (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
                (Ideal.Quotient.mk I (MvPolynomial.X n)) := by
            rw [map_mul, map_mul]
          rw [e]
          refine Subring.mul_mem _ hf ?_
          fin_cases n
          · exact Subring.subset_closure (Set.mem_union_left _
              ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
                (hnat _).trans (congrArg _ hθX)⟩)
          · exact Subring.subset_closure (Set.mem_union_right _ ⟨1, rfl⟩)
      intro s
      rw [← hγδ s]
      exact hgen _
    · refine ⟨Φ.comp (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom, ?_, ?_⟩
      · apply RingHom.ext
        intro x
        rw [← hγδa x]
        simp only [RingHom.comp_apply]
        rw [hnat, hδγ, ← RingHom.comp_apply Φ θ₀, hkey, RingHom.comp_apply]
      · intro j
        fin_cases j
        · show (Φ.comp (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom) 1 = t 0 0
          rw [map_one, ht00]
        · show (Φ.comp (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom)
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
              (Ideal.Quotient.mk I (MvPolynomial.X 1))) = t 0 1
          rw [RingHom.comp_apply, hδγ, hΦX1]
  obtain ⟨τ, hrel, hnzd, hgen, hφ⟩ := hdata
  obtain ⟨e, her, heo, herange⟩ :=
    wcpa_dj_ncmb_chart_open_imm _ r₀ U t hr₀' hU 0 _ h τ hrel hnzd hgen hφ

  obtain ⟨h₁, τ₁, ρ₀, ρc, hh₁s, hτ₁, hnzd₁, hgen₁, hφ₁, -⟩ :=
    wcpa_dj_mscm_chart_data_c Ω W c hc M r₀ U t hU
  obtain ⟨c₁, hc₁r, hc₁o, hc₁range⟩ :=
    wcpa_dj_ncmb_chart_open_imm _ r₀ U t hr₀' hU 1 _ h₁ τ₁ hτ₁ hnzd₁ hgen₁ hφ₁
  haveI := heo
  haveI := hc₁o
  have hg₀ : e ≫ r₀ ≫ wcEbdStr W =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I))) := by
    rw [← Category.assoc, her]
    exact hstr
  have hg₁ : c₁ ≫ r₀ ≫ wcEbdStr W = wcEbdStr W := by
    rw [← Category.assoc, hc₁r]
    exact hh₁s

  have hqsm : SmoothOfRelativeDimension 1
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) := by
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1)]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [CommRingCat.hom_ofHom, ← MvPolynomial.algebraMap_eq]
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial (↥W) (Fin 1)
    simpa using this

  have nbhd : ∀ (Y : Scheme.{u}) (j : Y ⟶ M) [IsOpenImmersion j],
      SmoothOfRelativeDimension 1 (j ≫ r₀ ≫ wcEbdStr W) → ∀ y : Y,
      ∃ N : M.Opens, j y ∈ N ∧ SmoothOfRelativeDimension 1 (N.ι ≫ r₀ ≫ wcEbdStr W) := by
    intro Y j _ hj y
    refine ⟨j.opensRange, ⟨y, rfl⟩, ?_⟩
    have e0' : j.isoOpensRange.inv ≫ j = j.opensRange.ι :=
      (Iso.inv_comp_eq _).mpr (Scheme.Hom.isoOpensRange_hom_ι j).symm
    have e1 : j.opensRange.ι ≫ r₀ ≫ wcEbdStr W =
        j.isoOpensRange.inv ≫ (j ≫ r₀ ≫ wcEbdStr W) := by
      rw [← e0', Category.assoc]
    rw [e1]
    haveI := hj
    exact smoothOfRelativeDimension_comp 0 1 _ _
  refine ⟨e, heo, her, ?_⟩
  intro n hn hns
  have hz : n ∈ (⨆ l, U l) := by rw [hU.1]; trivial
  obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
  have hl0 : l = 0 → n ∈ Set.range e := by
    intro hl'; subst hl'; rw [herange]; exact hl
  have hl1 : l = 1 → n ∈ Set.range c₁ := by
    intro hl'; subst hl'; rw [hc₁range]; exact hl
  fin_cases l
  · obtain ⟨y, hy⟩ := hl0 rfl
    refine ⟨y, hy, ?_, ?_⟩
    ·
      have hHX : (Spec.map (CommRingCat.ofHom θ₀)) y =
          (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))))
            (IsLocalRing.closedPoint ↥W) := by
        have h2 := hn
        rw [← hy, ← Scheme.Hom.comp_apply, her] at h2
        exact h2
      have hHX' : PrimeSpectrum.comap θ₀ y = PrimeSpectrum.comap
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) (IsLocalRing.closedPoint ↥W) := by
        first
          | exact hHX
          | (rw [Spec.map_apply, CommRingCat.hom_ofHom] at hHX
             erw [Spec.map_apply, CommRingCat.hom_ofHom] at hHX
             exact hHX)
      have hX : MvPolynomial.X 0 ∈ (PrimeSpectrum.comap θ₀ y).asIdeal := by
        rw [hHX']
        show MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)) (MvPolynomial.X 0) ∈
          (IsLocalRing.closedPoint ↥W).asIdeal
        rw [MvPolynomial.eval_X]
        exact Ideal.zero_mem _
      have h3 : θ₀ (MvPolynomial.X 0) ∈ y.asIdeal := hX
      rw [hθX] at h3
      exact h3
    ·
      by_contra hy1
      have hyV : y ∈ (Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X 1))) := by
        rw [basicOpen_eq_of_affine]; exact hy1
      obtain ⟨y', hy'⟩ : y ∈ Set.range ((Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X 1)))).ι := by
        rw [Scheme.Opens.range_ι]; exact hyV
      have hsmV := wcpa_dj_ncmb_basicOpen_smooth (↥W) c 1
      have hcomp : (((Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X 1)))).ι ≫ e) ≫ r₀ ≫ wcEbdStr W =
          ((Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X 1)))).ι ≫
          Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I))) := by
        rw [Category.assoc, hg₀]
      have hsm : SmoothOfRelativeDimension 1 ((((Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X 1)))).ι ≫ e) ≫ r₀ ≫ wcEbdStr W) := by
        rw [hcomp]; exact hsmV
      obtain ⟨N, hN, hNsm⟩ := nbhd _ _ hsm y'
      apply hns
      refine ⟨N, ?_, hNsm⟩
      rw [Scheme.Hom.comp_apply, hy', hy] at hN
      exact hN
  · exfalso
    obtain ⟨y₁, hy₁⟩ := hl1 rfl
    have hsm : SmoothOfRelativeDimension 1 (c₁ ≫ r₀ ≫ wcEbdStr W) := by
      rw [hg₁]; exact hqsm
    obtain ⟨N, hN, hNsm⟩ := nbhd _ c₁ hsm y₁
    rw [hy₁] at hN
    exact hns ⟨N, hN, hNsm⟩

theorem wcpa_dj_lr1k_ebd_roof : ∀ (X X' M O' : Scheme.{u}) (I : X.IdealSheafData)
    (J : O'.IdealSheafData) (O : X.Opens) (m : O.toScheme ⟶ O') (r : X' ⟶ X) (r₀ : M ⟶ O'),
    Etale m → I.comap O.ι = J.comap m → wcCsdIsBlowup I r → wcCsdIsBlowup J r₀ →
    ∃ (P : Scheme.{u}) (p : P ⟶ X') (sP : P ⟶ O.toScheme) (κ : P ⟶ M),
      IsOpenImmersion p ∧ (∀ x' : X', r x' ∈ O → x' ∈ Set.range p) ∧ p ≫ r = sP ≫ O.ι ∧
      Etale κ ∧ IsPullback κ sP r₀ m :=
by
  intro X X' M O' I J O m r r₀ hm hJeq hbl hr₀
  haveI := hm
  have hb1 := wcpa_dj_nc_blowup_flat_basechange X X' O.toScheme I r O.ι inferInstance hbl
  have hb2 := wcpa_dj_nc_blowup_flat_basechange O' M O.toScheme J r₀ m inferInstance hr₀
  rw [← hJeq] at hb2
  obtain ⟨θ, hθ, -⟩ := hb2.2 _ (Limits.pullback.snd r O.ι) hb1.1
  obtain ⟨θ', hθ', -⟩ := hb1.2 _ (Limits.pullback.snd r₀ m) hb2.1
  have hθθ' : θ ≫ θ' = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb1.2 _ (Limits.pullback.snd r O.ι) hb1.1
    exact (huniq _ (by show (θ ≫ θ') ≫ _ = _; rw [Category.assoc, hθ', hθ])).trans
      (huniq _ (Category.id_comp _)).symm
  have hθ'θ : θ' ≫ θ = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb2.2 _ (Limits.pullback.snd r₀ m) hb2.1
    exact (huniq _ (by show (θ' ≫ θ) ≫ _ = _; rw [Category.assoc, hθ, hθ'])).trans
      (huniq _ (Category.id_comp _)).symm
  haveI : IsIso θ := ⟨θ', hθθ', hθ'θ⟩
  obtain ⟨κ, hκ⟩ : ∃ κ : Limits.pullback r O.ι ⟶ M, κ = θ ≫ Limits.pullback.fst r₀ m :=
    ⟨_, rfl⟩
  haveI hκet : Etale κ := by rw [hκ]; infer_instance
  refine ⟨Limits.pullback r O.ι, Limits.pullback.fst r O.ι, Limits.pullback.snd r O.ι, κ,
    inferInstance, ?_, Limits.pullback.condition, hκet, ?_⟩
  · intro x' hx'
    have hmem : r x' ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hx'
    obtain ⟨o, ho⟩ := hmem
    obtain ⟨ρ, hρ1, -⟩ := Scheme.exists_preimage_of_isPullback (IsPullback.of_hasPullback r O.ι)
      x' o ho.symm
    exact ⟨ρ, hρ1⟩
  · refine IsPullback.of_iso_pullback ⟨?_⟩ (asIso θ) hκ.symm hθ
    rw [hκ, Category.assoc, Limits.pullback.condition, ← Category.assoc, hθ]

theorem wcpa_dj_lr1k_ebd_invpull_locus : ∀ (X X₂ : Scheme.{u}) (I : X.IdealSheafData)
    (r₂ : X₂ ⟶ X), ∃ U : X₂.Opens, wcCsdInvPull I (U.ι ≫ r₂) ∧
      (∀ (T : Scheme.{u}) (j : T ⟶ X₂), IsOpenImmersion j → wcCsdInvPull I (j ≫ r₂) →
        ∀ t : T, j t ∈ U) ∧
      ∀ t : X₂, r₂ t ∉ (I.support : Set X) → t ∈ U :=
by
  intro X X₂ I r₂


  have chartOI : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData) (j : T' ⟶ T) [IsOpenImmersion j]
      (h : T ⟶ X) (U : X.affineOpens) (a : Γ(X, U.1)) (t' : T'),
      wcCsdChartAt I h U a (j t') ↔ wcCsdChartAt I (j ≫ h) U a t' := by
    intro X T T' I j _ h U a t'
    have hmapcomp : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x : A),
        Ideal.map φ.hom J = Ideal.span {φ.hom x} →
        Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
      intro A B C φ σ J x hx
      rw [CommRingCat.hom_comp, ← Ideal.map_map, hx, Ideal.map_span, Set.image_singleton]
      try rfl
    have hiso : ∀ {A B C : CommRingCat.{u}} (ρ : A ⟶ B) (σ : B ⟶ C) [IsIso σ] (J : Ideal A)
        (x : A), ρ.hom x ∈ nonZeroDivisors B → Ideal.map ρ.hom J = Ideal.span {ρ.hom x} →
        (ρ ≫ σ).hom x ∈ nonZeroDivisors C ∧
          Ideal.map (ρ ≫ σ).hom J = Ideal.span {(ρ ≫ σ).hom x} := by
      intro A B C ρ σ _ J x hN hI
      refine ⟨?_, hmapcomp ρ σ J x hI⟩
      rw [← MulEquivClass.map_nonZeroDivisors (asIso σ).commRingCatIsoToRingEquiv]
      exact ⟨ρ.hom x, hN, rfl⟩
    have happ : ∀ (W : T.Opens) (V : T'.Opens) (e : V ≤ j ⁻¹ᵁ W), j ''ᵁ V = W →
        IsIso (j.appLE W V e) := by
      intro W V e hW
      subst hW
      have : j.appLE (j ''ᵁ V) V e = (j.appIso V).hom := by
        rw [Scheme.Hom.appIso_hom]
        rfl
      rw [this]
      infer_instance
    constructor
    · rintro ⟨V, e, hjt, hN, hI⟩
      have hjr : j t' ∈ j.opensRange := ⟨t', rfl⟩
      obtain ⟨f, hfO, hft⟩ :=
        V.2.exists_basicOpen_le (V := V.1 ⊓ j.opensRange) ⟨j t', hjt, hjr⟩ hjt
      have hDR : T.basicOpen f ≤ j.opensRange := hfO.trans inf_le_right
      have eD : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := (T.basicOpen_le f).trans e
      have hfac1 : h.appLE U.1 V.1 e ≫ T.presheaf.map (homOfLE (T.basicOpen_le f)).op =
          h.appLE U.1 (T.basicOpen f) eD := Scheme.Hom.appLE_map _ _ _
      have := V.2.isLocalization_basicOpen f
      have hN1 : (h.appLE U.1 (T.basicOpen f) eD).hom a ∈
          nonZeroDivisors Γ(T, T.basicOpen f) := by
        rw [← hfac1]
        exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(T, T.basicOpen f)
          ⟨_, hN, rfl⟩
      have hI1 := hmapcomp _ (T.presheaf.map (homOfLE (T.basicOpen_le f)).op) _ _ hI
      rw [hfac1] at hI1
      have hV' : IsAffineOpen (j ⁻¹ᵁ T.basicOpen f) :=
        (V.2.basicOpen f).preimage_of_isOpenImmersion j hDR
      have e' : j ⁻¹ᵁ T.basicOpen f ≤ (j ≫ h) ⁻¹ᵁ U.1 := fun y hy => eD hy
      have hfac2 := Scheme.Hom.appLE_comp_appLE j h U.1 (T.basicOpen f) (j ⁻¹ᵁ T.basicOpen f)
        eD le_rfl
      have himg : j ''ᵁ (j ⁻¹ᵁ T.basicOpen f) = T.basicOpen f := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
        exact inf_eq_right.mpr hDR
      have := happ _ _ (le_rfl : j ⁻¹ᵁ T.basicOpen f ≤ j ⁻¹ᵁ T.basicOpen f) himg
      obtain ⟨g1, g2⟩ := hiso (h.appLE U.1 (T.basicOpen f) eD)
        (j.appLE (T.basicOpen f) (j ⁻¹ᵁ T.basicOpen f) le_rfl) (I.ideal U) a hN1 hI1
      rw [hfac2] at g1 g2
      exact ⟨⟨_, hV'⟩, e', hft, g1, g2⟩
    · rintro ⟨V', e', ht', hN', hI'⟩
      have hV0 : IsAffineOpen (j ''ᵁ V'.1) := V'.2.image_of_isOpenImmersion j
      have hj : j t' ∈ j ''ᵁ V'.1 := ⟨t', ht', rfl⟩
      have e0 : j ''ᵁ V'.1 ≤ h ⁻¹ᵁ U.1 := by
        rintro _ ⟨y, hy, rfl⟩
        exact e' hy
      have ej : V'.1 ≤ j ⁻¹ᵁ (j ''ᵁ V'.1) := fun y hy => ⟨y, hy, rfl⟩
      have hfac := Scheme.Hom.appLE_comp_appLE j h U.1 (j ''ᵁ V'.1) V'.1 e0 ej
      have := happ (j ''ᵁ V'.1) V'.1 ej rfl
      have heq : h.appLE U.1 (j ''ᵁ V'.1) e0 =
          (j ≫ h).appLE U.1 V'.1 e' ≫ inv (j.appLE (j ''ᵁ V'.1) V'.1 ej) := by
        rw [← hfac, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
      obtain ⟨g1, g2⟩ := hiso _ (inv (j.appLE (j ''ᵁ V'.1) V'.1 ej)) (I.ideal U) a hN' hI'
      rw [← heq] at g1 g2
      exact ⟨⟨_, hV0⟩, e0, hj, g1, g2⟩

  have off : ∀ t : X₂, r₂ t ∉ (I.support : Set X) →
      ∃ (U₀ : X.affineOpens) (b : Γ(X, U₀.1)), b ∈ I.ideal U₀ ∧ wcCsdChartAt I r₂ U₀ b t := by
    intro t hh
    obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := r₂ t) trivial
    have hns' : r₂ t ∉ X.zeroLocus (U := U₀) (I.ideal ⟨U₀, hU₀⟩ : Set Γ(X, U₀)) := by
      rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
      exact hh
    rw [Scheme.mem_zeroLocus_iff] at hns'
    push_neg at hns'
    obtain ⟨b, hbI, hxb⟩ := hns'
    have htD : t ∈ r₂ ⁻¹ᵁ X.basicOpen b := (Scheme.Hom.mem_preimage r₂).mpr hxb
    obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
    have hVD : V₀ ≤ r₂ ⁻¹ᵁ X.basicOpen b := hV₀sub
    have hVU : V₀ ≤ r₂ ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono r₂ (X.basicOpen_le b))
    have hbo : X₂.basicOpen ((r₂.appLE U₀ V₀ hVU).hom b) = V₀ := by
      rw [Scheme.basicOpen_appLE]
      exact inf_eq_left.mpr hVD
    have hunit : IsUnit ((r₂.appLE U₀ V₀ hVU).hom b) := by
      apply RingedSpace.isUnit_of_isUnit_germ X₂.toRingedSpace V₀
      intro y' hy
      have hy' : y' ∈ X₂.basicOpen ((r₂.appLE U₀ V₀ hVU).hom b) := by rw [hbo]; exact hy
      exact (X₂.mem_basicOpen _ y' hy).mp hy'
    refine ⟨⟨U₀, hU₀⟩, b, hbI, ⟨V₀, hV₀⟩, hVU, htV₀, hunit.mem_nonZeroDivisors, ?_⟩
    rw [Ideal.span_singleton_eq_top.mpr hunit]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hbI) hunit

  let S : Set X₂ := {t | ∃ (U₀ : X.affineOpens) (b : Γ(X, U₀.1)), b ∈ I.ideal U₀ ∧
    wcCsdChartAt I r₂ U₀ b t}
  have hS : IsOpen S := by
    rw [isOpen_iff_forall_mem_open]
    rintro t ⟨U₀, b, hb, V, e, htV, hnzd, hmap⟩
    exact ⟨V.1, fun t' ht' => ⟨U₀, b, hb, V, e, ht', hnzd, hmap⟩, V.1.isOpen, htV⟩
  let U : X₂.Opens := ⟨S, hS⟩
  refine ⟨U, ?_, ?_, ?_⟩
  · intro u
    have hu : U.ι u ∈ S := by
      have h1 : U.ι u ∈ U := by
        first
          | exact u.2
          | (have h2 : U.ι u ∈ Set.range U.ι := ⟨u, rfl⟩
             rw [Scheme.Opens.range_ι] at h2
             exact h2)
      exact h1
    obtain ⟨U₀, b, hb, hc⟩ := hu
    obtain ⟨V, e, huV, hnzd, hmap⟩ :=
      (chartOI X X₂ U.toScheme I U.ι r₂ U₀ b u).mp hc
    exact ⟨U₀, V, e, b, huV, hb, hnzd, hmap⟩
  · intro T j hj hP t
    haveI := hj
    obtain ⟨U₀, V, hVU, a, htV, ha, hnzd, hmap⟩ := hP t
    show j t ∈ S
    exact ⟨U₀, a, ha, (chartOI X X₂ T I j r₂ U₀ a t).mpr ⟨V, hVU, htV, hnzd, hmap⟩⟩
  · intro t ht
    exact off t ht

theorem wcpa_dj_lr1k_ebd_invpull_flat_pre : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData)
    (h : T ⟶ X) (k : T' ⟶ T), Flat k → wcCsdInvPull I h → wcCsdInvPull I (k ≫ h) :=
by
  intro X T T' I h k hk hI t'

  have nzd : ∀ {R S : CommRingCat.{u}} (κ : R ⟶ S), κ.hom.Flat →
      ∀ r : R, r ∈ nonZeroDivisors R → κ.hom r ∈ nonZeroDivisors S := by
    intro R S κ hκ r hr
    letI := κ.hom.toAlgebra
    haveI : Module.Flat R S := hκ
    have hreg : IsSMulRegular S r := Module.Flat.isSMulRegular_of_nonZeroDivisors hr
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply isSMulRegular_iff_right_eq_zero_of_smul.mp hreg x
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm]
    exact hx

  obtain ⟨U, V, eV, a, htV, haI, hnzd, hspan⟩ := hI (k t')
  obtain ⟨V', hV', ht'V', hsub⟩ :=
    exists_isAffineOpen_mem_and_subset (U := k ⁻¹ᵁ V.1) (x := t')
      ((Scheme.Hom.mem_preimage k).mpr htV)
  have hV'k : V' ≤ k ⁻¹ᵁ V.1 := hsub
  have e' : V' ≤ (k ≫ h) ⁻¹ᵁ U.1 := fun x hx => eV (hV'k hx)
  have key : h.appLE U.1 V.1 eV ≫ k.appLE V.1 V' hV'k = (k ≫ h).appLE U.1 V' e' := by
    rw [Scheme.Hom.appLE_comp_appLE]
  have hcomp : ((k ≫ h).appLE U.1 V' e').hom =
      (k.appLE V.1 V' hV'k).hom.comp (h.appLE U.1 V.1 eV).hom := by
    rw [← key, CommRingCat.hom_comp]
  have hflat : (k.appLE V.1 V' hV'k).hom.Flat :=
    HasRingHomProperty.appLE @Flat k hk V ⟨V', hV'⟩ hV'k
  refine ⟨U, ⟨V', hV'⟩, e', a, ht'V', haI, ?_, ?_⟩
  · show ((k ≫ h).appLE U.1 V' e').hom a ∈ nonZeroDivisors Γ(T', V')
    rw [hcomp, RingHom.comp_apply]
    exact nzd _ hflat _ hnzd
  · show Ideal.map ((k ≫ h).appLE U.1 V' e').hom (I.ideal U) =
      Ideal.span {((k ≫ h).appLE U.1 V' e').hom a}
    rw [hcomp, ← Ideal.map_map, hspan, Ideal.map_span, Set.image_singleton, RingHom.comp_apply]

theorem wcpa_dj_lr1k_ebd_quad_node : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W)
    (P M Y : Scheme.{u}) (κ : P ⟶ M) (e : wcEbdQ W c ⟶ M) (v : M ⟶ Spec (.of ↥W))
    (p : P ⟶ Y) (u₁ : Y ⟶ Spec (.of ↥W)) (ρ : P) (y : wcEbdQ W c),
    Etale κ → IsOpenImmersion e → IsOpenImmersion p →
    e ≫ v = wcEbdHX W c ≫ wcEbdStr W → p ≫ u₁ = κ ≫ v →
    κ ρ = e y → wcEbdQX W c 0 ∈ y.asIdeal → wcEbdQX W c 1 ∈ y.asIdeal →
    ¬ ∃ N : Y.Opens, p ρ ∈ N ∧ SmoothOfRelativeDimension 1 (N.ι ≫ u₁) :=
by
  intro Ω _ W c P M Y κ e v p u₁ ρ y hκ he hp hev hpu hρ hy0 hy1 hN
  obtain ⟨N, hpN, hsm⟩ := hN
  haveI := hκ
  haveI := he
  haveI := hp
  haveI := hsm

  obtain ⟨φ, hφdef⟩ : ∃ f : (κ ⁻¹ᵁ e.opensRange).toScheme ⟶ wcEbdQ W c,
      f = (κ ∣_ e.opensRange) ≫ e.isoOpensRange.inv := ⟨_, rfl⟩
  haveI : Etale φ := by rw [hφdef]; infer_instance
  have hφe : φ ≫ e = (κ ⁻¹ᵁ e.opensRange).ι ≫ κ := by
    rw [hφdef, Category.assoc, Scheme.Hom.isoOpensRange_inv_comp, morphismRestrict_ι]
  have hρU : ρ ∈ κ ⁻¹ᵁ e.opensRange := by
    rw [Scheme.Hom.mem_preimage]
    show κ ρ ∈ (e.opensRange : Set M)
    rw [Scheme.Hom.coe_opensRange, hρ]
    exact ⟨y, rfl⟩
  obtain ⟨x, hx⟩ : ρ ∈ Set.range (κ ⁻¹ᵁ e.opensRange).ι := by
    rw [Scheme.Opens.range_ι]; exact hρU
  have hφx : φ x = y := by
    apply e.isOpenEmbedding.injective
    show e (φ x) = e y
    rw [← Scheme.Hom.comp_apply, hφe, Scheme.Hom.comp_apply, hx, hρ]

  let c₀ : Matrix (Fin 2) (Fin 2) ↥W := !![0, 1; 0, 0]
  have hdet : IsUnit (c₀ + c₀.transpose).det := by
    have h1 : (c₀ + c₀.transpose).det = -1 := by
      rw [Matrix.det_fin_two]
      simp [c₀]
    rw [h1]
    exact isUnit_one.neg
  have hsum : (∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C (c₀ p q) * MvPolynomial.X p *
      MvPolynomial.X q : MvPolynomial (Fin 2) ↥W) = MvPolynomial.X 0 * MvPolynomial.X 1 := by
    simp [c₀, Fin.sum_univ_two]
  have hideal : wcQuadModelIdeal (↥W) 2 c c₀ =
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} := by
    simp only [wcQuadModelIdeal]
    rw [hsum]
  let ε := Ideal.quotientEquivAlgOfEq (↥W) hideal
  let εI := ε.toRingEquiv.toCommRingCatIso
  haveI : Etale (φ ≫ Spec.map εI.hom) := inferInstance
  have gen : ∀ {A B : CommRingCat.{u}} (f : A ⟶ B) (y : Spec B) (a : A) (b : B),
      f.hom a = b → b ∈ y.asIdeal → a ∈ (Spec.map f y).asIdeal := by
    intro A B f y a b hab hb
    subst hab
    exact hb
  have hq : ∀ q : Fin 2, Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
      (MvPolynomial.X q) ∈ y.asIdeal := by
    intro q
    fin_cases q
    · exact hy0
    · exact hy1
  have hpts : ∀ q, Ideal.Quotient.mk (wcQuadModelIdeal (↥W) 2 c c₀) (MvPolynomial.X q) ∈
      ((φ ≫ Spec.map εI.hom) x).asIdeal := by
    intro q
    rw [Scheme.Hom.comp_apply, hφx]
    exact gen _ y _ _ (Ideal.quotientEquivAlgOfEq_mk (↥W) hideal (MvPolynomial.X q)) (hq q)

  let V : (κ ⁻¹ᵁ e.opensRange).toScheme.Opens := (κ ⁻¹ᵁ e.opensRange).ι ⁻¹ᵁ (p ⁻¹ᵁ N)
  have hxV : x ∈ V := by
    show x ∈ (κ ⁻¹ᵁ e.opensRange).ι ⁻¹ᵁ (p ⁻¹ᵁ N)
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, hx]
    exact hpN
  have hrng : Set.range (V.ι ≫ (κ ⁻¹ᵁ e.opensRange).ι ≫ p).base ⊆ Set.range N.ι.base := by
    rintro _ ⟨w, rfl⟩
    have hw : V.ι w ∈ V := by
      have : V.ι w ∈ Set.range V.ι := ⟨w, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have h2 : (V.ι ≫ (κ ⁻¹ᵁ e.opensRange).ι ≫ p) w ∈ Set.range N.ι := by
      rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      have hw' : V.ι w ∈ (κ ⁻¹ᵁ e.opensRange).ι ⁻¹ᵁ (p ⁻¹ᵁ N) := hw
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage] at hw'
      exact hw'
    exact h2
  obtain ⟨t, htN⟩ : ∃ t : V.toScheme ⟶ N.toScheme, t ≫ N.ι = V.ι ≫ (κ ⁻¹ᵁ e.opensRange).ι ≫ p :=
    ⟨IsOpenImmersion.lift N.ι _ hrng, IsOpenImmersion.lift_fac _ _ _⟩
  haveI : IsOpenImmersion (t ≫ N.ι) := by rw [htN]; infer_instance
  haveI : IsOpenImmersion t := IsOpenImmersion.of_comp t N.ι
  haveI : Smooth (N.ι ≫ u₁) := SmoothOfRelativeDimension.smooth 1 _
  haveI : Smooth (t ≫ N.ι ≫ u₁) := inferInstance

  have hring : CommRingCat.ofHom (algebraMap ↥W (wcQuadModelRing (↥W) 2 c c₀)) ≫ εI.hom =
      CommRingCat.ofHom (algebraMap ↥W (wcEbdQR W c)) := by
    ext w
    exact ε.commutes w
  have hr1 : Spec.map εI.hom ≫ wcQuadModelStr (↥W) 2 c c₀ =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (wcEbdQR W c))) := by
    rw [wcQuadModelStr, ← Spec.map_comp, hring]
  have hr2 : wcEbdHX W c ≫ wcEbdStr W =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (wcEbdQR W c))) := by
    rw [← Spec.map_comp]
    congr 1
    ext w
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.rename_C]
    rfl
  have hchain : V.ι ≫ (φ ≫ Spec.map εI.hom) ≫ wcQuadModelStr (↥W) 2 c c₀ ≫ 𝟙 (Spec (.of ↥W)) =
      t ≫ N.ι ≫ u₁ := by
    calc V.ι ≫ (φ ≫ Spec.map εI.hom) ≫ wcQuadModelStr (↥W) 2 c c₀ ≫ 𝟙 (Spec (.of ↥W))
        = V.ι ≫ φ ≫ (Spec.map εI.hom ≫ wcQuadModelStr (↥W) 2 c c₀) := by
          simp only [Category.comp_id, Category.assoc]
      _ = V.ι ≫ φ ≫ e ≫ v := by rw [hr1, ← hr2, ← hev]
      _ = V.ι ≫ (κ ⁻¹ᵁ e.opensRange).ι ≫ κ ≫ v := by
          rw [← Category.assoc φ e v, hφe, Category.assoc]
      _ = V.ι ≫ (κ ⁻¹ᵁ e.opensRange).ι ≫ p ≫ u₁ := by rw [hpu]
      _ = t ≫ N.ι ≫ u₁ := by
          rw [← Category.assoc t, htN]
          simp only [Category.assoc]

  exact wc_quad_model_vertex_not_smooth (↥W) 2 (by norm_num) c c₀ hdet
    (φ ≫ Spec.map εI.hom) (𝟙 _) x hpts ⟨V, hxV, by rw [hchain]; infer_instance⟩

theorem wcpa_dj_lr1k_ebd_smat_of_etale : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Y P M : Scheme.{u}) (u : Y ⟶ Spec (.of ↥W)) (p : P ⟶ Y) (κ : P ⟶ M)
    (v : M ⟶ Spec (.of ↥W)) (ρ : P)
    (w : ↥(Limits.pullback u
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
    IsOpenImmersion p → Etale κ → p ≫ u = κ ≫ v →
    Limits.pullback.fst u
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = p ρ →
    (∃ N : M.Opens, κ ρ ∈ N ∧ SmoothOfRelativeDimension 1 (N.ι ≫ v)) →
    wcpaDjLkSmAt W u w :=
by
  intro Ω _ W Y P M u p κ v ρ w hp hκ hcomm hw hN
  obtain ⟨N, hρN, hNsm⟩ := hN
  haveI := hp
  haveI := hκ
  haveI := hNsm
  have hρN' : ρ ∈ κ ⁻¹ᵁ N := (Scheme.Hom.mem_preimage κ).mpr hρN
  have h2a : SmoothOfRelativeDimension (0 + 1) ((κ ∣_ N) ≫ N.ι ≫ v) :=
    smoothOfRelativeDimension_comp 0 1 _ _
  have heq2 : (κ ∣_ N) ≫ N.ι ≫ v = (κ ⁻¹ᵁ N).ι ≫ p ≫ u := by
    rw [← Category.assoc, morphismRestrict_ι, Category.assoc, hcomm]
  have h2 : SmoothOfRelativeDimension 1 ((κ ⁻¹ᵁ N).ι ≫ p ≫ u) := by
    rw [← heq2]; exact h2a
  have heq3 : (p ''ᵁ (κ ⁻¹ᵁ N)).ι ≫ u =
      (Scheme.Hom.isoImage p (κ ⁻¹ᵁ N)).inv ≫ (κ ⁻¹ᵁ N).ι ≫ p ≫ u := by
    have he : (Scheme.Hom.isoImage p (κ ⁻¹ᵁ N)).hom ≫ (p ''ᵁ (κ ⁻¹ᵁ N)).ι =
        (κ ⁻¹ᵁ N).ι ≫ p :=
      Scheme.Hom.isoImage_hom_ι _ _
    rw [← Category.assoc ((κ ⁻¹ᵁ N).ι) p u, ← he, Category.assoc, Iso.inv_hom_id_assoc]
  have h3 : SmoothOfRelativeDimension 1 ((p ''ᵁ (κ ⁻¹ᵁ N)).ι ≫ u) := by
    rw [heq3]
    haveI := h2
    exact smoothOfRelativeDimension_comp 0 1 (Scheme.Hom.isoImage p (κ ⁻¹ᵁ N)).inv _
  have hwU : w ∈ Limits.pullback.fst u
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ
        (p ''ᵁ (κ ⁻¹ᵁ N)) := by
    rw [Scheme.Hom.mem_preimage, hw]
    exact ⟨ρ, hρN', rfl⟩
  have hpb := (isPullback_morphismRestrict (Limits.pullback.fst u
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (p ''ᵁ (κ ⁻¹ᵁ N))).paste_vert (IsPullback.of_hasPullback u
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  exact ⟨_, hwU, MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb h3⟩

theorem wcpa_dj_lr1k_ebd_node_lift : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (a a' qq c' d : ↥W), a ≠ 0 → a' ≠ 0 → a = a' * qq → c' = a' * d →
    ∀ (M : Scheme.{u}) (r₀ : M ⟶ wcEbdA1 W) (e : wcEbdQ W a' ⟶ M), IsOpenImmersion e →
      e ≫ r₀ = wcEbdHX W a' →
    ∀ y : wcEbdQ W a', wcEbdQX W a' 0 ∈ y.asIdeal → wcEbdQX W a' 1 ∈ y.asIdeal →
    ∃ (N : M.Opens) (b : N.toScheme ⟶ wcEbdQ W a), e y ∈ N ∧
      wcCsdInvPull (wcEbdJ W a) (N.ι ≫ r₀ ≫ wcEbdShift W c') ∧
      b ≫ wcEbdHX W a = N.ι ≫ r₀ ≫ wcEbdShift W c' ∧
      ∀ n : N.toScheme, N.ι n = e y →
        wcEbdQX W a 0 ∈ (b n).asIdeal ∧ wcEbdQX W a 1 ∈ (b n).asIdeal :=
by
  intro Ω _ W a a' qq c' d ha0 ha'0 hqq hd M r₀ e he her y hy0 hy1
  classical
  haveI := he

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have nzd_iso : ∀ (R : CommRingCat.{u}) (x : R), x ∈ nonZeroDivisors R →
      (Scheme.ΓSpecIso R).inv.hom x ∈ nonZeroDivisors Γ(Spec R, ⊤) := by
    intro R x hx
    rw [mem_nonZeroDivisors_iff_right] at hx ⊢
    intro z hz
    have h1 := congrArg (Scheme.ΓSpecIso R).hom.hom hz
    rw [map_mul, hinvhom, map_zero] at h1
    have h2 := hx _ h1
    rw [← hhominv R z, h2, map_zero]

  have flat_pre : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData)
      (h : T ⟶ X) (k : T' ⟶ T), Flat k → wcCsdInvPull I h → wcCsdInvPull I (k ≫ h) := by
    intro X T T' I h k hk hI t'
    have nzd : ∀ {R S : CommRingCat.{u}} (κ : R ⟶ S), κ.hom.Flat →
        ∀ r : R, r ∈ nonZeroDivisors R → κ.hom r ∈ nonZeroDivisors S := by
      intro R S κ hκ r hr
      letI := κ.hom.toAlgebra
      haveI : Module.Flat R S := hκ
      have hreg : IsSMulRegular S r := Module.Flat.isSMulRegular_of_nonZeroDivisors hr
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      apply isSMulRegular_iff_right_eq_zero_of_smul.mp hreg x
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm]
      exact hx
    obtain ⟨U, V, eV, a, htV, haI, hnzd, hspan⟩ := hI (k t')
    obtain ⟨V', hV', ht'V', hsub⟩ :=
      exists_isAffineOpen_mem_and_subset (U := k ⁻¹ᵁ V.1) (x := t')
        ((Scheme.Hom.mem_preimage k).mpr htV)
    have hV'k : V' ≤ k ⁻¹ᵁ V.1 := hsub
    have e' : V' ≤ (k ≫ h) ⁻¹ᵁ U.1 := fun x hx => eV (hV'k hx)
    have key : h.appLE U.1 V.1 eV ≫ k.appLE V.1 V' hV'k = (k ≫ h).appLE U.1 V' e' := by
      rw [Scheme.Hom.appLE_comp_appLE]
    have hcomp : ((k ≫ h).appLE U.1 V' e').hom =
        (k.appLE V.1 V' hV'k).hom.comp (h.appLE U.1 V.1 eV).hom := by
      rw [← key, CommRingCat.hom_comp]
    have hflat : (k.appLE V.1 V' hV'k).hom.Flat :=
      HasRingHomProperty.appLE @Flat k hk V ⟨V', hV'⟩ hV'k
    refine ⟨U, ⟨V', hV'⟩, e', a, ht'V', haI, ?_, ?_⟩
    · show ((k ≫ h).appLE U.1 V' e').hom a ∈ nonZeroDivisors Γ(T', V')
      rw [hcomp, RingHom.comp_apply]
      exact nzd _ hflat _ hnzd
    · show Ideal.map ((k ≫ h).appLE U.1 V' e').hom (I.ideal U) =
        Ideal.span {((k ≫ h).appLE U.1 V' e').hom a}
      rw [hcomp, ← Ideal.map_map, hspan, Ideal.map_span, Set.image_singleton, RingHom.comp_apply]

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
