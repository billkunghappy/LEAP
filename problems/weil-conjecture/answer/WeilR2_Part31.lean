theorem wcpa_dj_lr1k_ebnt_bb_gauss_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (μ₀ μ₁ : ↥W), μ₀ ∈ IsLocalRing.maximalIdeal ↥W → μ₁ ∈ IsLocalRing.maximalIdeal ↥W → μ₀ * μ₁ = b → ∃ (K : Type u) (_ : Field K) (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k ∧ (∀ γ : ↥W, γ ≠ 0 → k (σ γ) ≠ 0) ∧ ∃ e₀ e₁ : V, IsUnit e₀ ∧ IsUnit e₁ ∧ k (f (wcEbntX W b 0)) = e₀ * k (σ μ₀) ∧ k (f (wcEbntX W b 1)) = e₁ * k (σ μ₁) :=
