        (j ''ᵁ (h₂ ⁻¹ᵁ V')), ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage, ← hρ1']
      show j ρ₀ ∈ ((j ''ᵁ (h₂ ⁻¹ᵁ V') : X'.Opens) : Set X')
      rw [Scheme.Hom.coe_image]
      exact ⟨ρ₀, hyV', rfl⟩
    · have hsq := IsPullback.paste_vert (isPullback_morphismRestrict (Limits.pullback.fst (r ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        (j ''ᵁ (h₂ ⁻¹ᵁ V'))) (IsPullback.of_hasPullback (r ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq hsm2
  ·
    have hcp : c (Spec.map (CommRingCat.ofHom (R := ↥(wcEbRing W a)) (S := wcEbntN W a) (e.symm : ↥(wcEbRing W a) →+* wcEbntN W a)) p) =
        h₂ ρ₀ := (ptw h3 p).trans hp
    have hp'I : (Spec.map (CommRingCat.ofHom (R := ↥(wcEbRing W a)) (S := wcEbntN W a) (e.symm : ↥(wcEbRing W a) →+* wcEbntN W a))
        p).asIdeal = wcEbNode W a := by
      show Ideal.comap (e.symm : ↥(wcEbRing W a) →+* wcEbntN W a) p.asIdeal = _
      rw [hpI, ← he2]
      exact Ideal.comap_symm e
    have hρQ : ρ₀ ∈ h₂ ⁻¹ᵁ c.opensRange := by
      rw [Scheme.Hom.mem_preimage, ← hcp]
      exact Scheme.Hom.mem_opensRange.mpr ⟨_, rfl⟩
    have hx' : Limits.pullback.fst (r ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w' ∈
        j ''ᵁ (h₂ ⁻¹ᵁ c.opensRange) := by
      rw [← hρ1']
      show j ρ₀ ∈ ((j ''ᵁ (h₂ ⁻¹ᵁ c.opensRange) : X'.Opens) : Set X')
      rw [Scheme.Hom.coe_image]
      exact ⟨ρ₀, hρQ, rfl⟩
    refine ⟨hx', ?_⟩
    have hz0 := ptw (Scheme.Hom.isoImage_inv_ι j (h₂ ⁻¹ᵁ c.opensRange)) ⟨_, hx'⟩
    rw [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at hz0
    have hzρ : (h₂ ⁻¹ᵁ c.opensRange).ι ((j.isoImage (h₂ ⁻¹ᵁ c.opensRange)).inv ⟨_, hx'⟩) = ρ₀ :=
      j.isOpenEmbedding.injective (hz0.trans hρ1'.symm)
    have hcn : c (n₀ ((j.isoImage (h₂ ⁻¹ᵁ c.opensRange)).inv ⟨_, hx'⟩)) =
        c (Spec.map (CommRingCat.ofHom (R := ↥(wcEbRing W a)) (S := wcEbntN W a) (e.symm : ↥(wcEbRing W a) →+* wcEbntN W a)) p) := by
      rw [hcp, ptw hn₀c, Scheme.Hom.comp_apply, hzρ]
    have hn : n₀ ((j.isoImage (h₂ ⁻¹ᵁ c.opensRange)).inv ⟨_, hx'⟩) =
        Spec.map (CommRingCat.ofHom (R := ↥(wcEbRing W a)) (S := wcEbntN W a) (e.symm : ↥(wcEbRing W a) →+* wcEbntN W a)) p :=
      c.isOpenEmbedding.injective hcn
    rw [← ptw (rfl : (j.isoImage (h₂ ⁻¹ᵁ c.opensRange)).inv ≫ n₀ =
      (j.isoImage (h₂ ⁻¹ᵁ c.opensRange)).inv ≫ n₀) ⟨_, hx'⟩, hn, hp'I]

theorem wcpa_dj_lr1k_eb_cd_generic_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (a : ↥W) (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ [AlgebraicGeometry.IsIntegral C] [Algebra (RatFunc Ω) C.functionField],
    ∀ (X X' : Scheme.{u}) (uX' : X' ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      (ι' : wcProjK Ω 1 ⟶ X') (r : X' ⟶ X), ι' ≫ r = ι → wcpaDjLkModel W uX' ι' →
    ∀ (O : X.Opens) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (g : Spec C.functionField ⟶ O.toScheme),
      g ≫ O.ι = C.fromSpecStalk (genericPoint C) ≫ γ ≫ ι →
      g ≫ m = Spec.map (CommRingCat.ofHom
        ((algebraMap (RatFunc Ω) C.functionField).comp (wcEbCdJ W))) →
    ∀ (O' : X'.Opens) (hle : O' ≤ r ⁻¹ᵁ O) (n : O'.toScheme ⟶ Spec (.of ↥(wcEbRing W a))),
      (O' : Set X').Nonempty →
      n ≫ Spec.map (CommRingCat.ofHom (wcEbCdRho W a)) = r.resLE O O' hle ≫ m →
    ∃ g' : Spec C.functionField ⟶ O'.toScheme,
      g' ≫ O'.ι = C.fromSpecStalk (genericPoint C) ≫ γ ≫ ι' ∧
      g' ≫ n = Spec.map (CommRingCat.ofHom
        ((algebraMap (RatFunc Ω) C.functionField).comp (wcEbRing W a).subtype)) :=
by
  intro Ω _ _ W _ _ a C γ hcov _ _ X X' uX' ι ι' r hι' hM' O m g hg1 hg2 O' hle n hO'ne hn
  classical
  haveI : AlgebraicGeometry.IsIntegral (wcProjK Ω 1) := (wc_projK_integral_normal Ω 1).1
  haveI : Nonempty C := IsIntegral.nonempty

  have hγη : γ (genericPoint C) = genericPoint (wcProjK Ω 1) := by
    obtain ⟨V, hVd, hVe⟩ := hcov.2.2.2.2
    have hVne : (V : Set C).Nonempty := hVd.nonempty
    have hηV : genericPoint C ∈ V :=
      ((genericPoint_spec C).mem_open_set_iff V.isOpen).mpr (by simpa using hVne)
    haveI : Flat (V.ι ≫ γ) := inferInstance
    obtain ⟨v', hv'1, hv'2⟩ := Flat.generalizingMap (V.ι ≫ γ)
      (genericPoint_specializes ((V.ι ≫ γ) ⟨genericPoint C, hηV⟩))
    have e1 : V.ι v' ⤳ genericPoint C := by
      have := hv'1.map V.ι.continuous
      simpa [Scheme.Opens.ι_apply] using this
    have e2 : V.ι v' = genericPoint C := (e1.antisymm (genericPoint_specializes _)).eq
    rw [← e2, ← Scheme.Hom.comp_apply, hv'2]

  have hspec : ∀ x : X', ι' (genericPoint (wcProjK Ω 1)) ⤳ x := by
    intro x
    haveI : Flat uX' := hM'.1.1
    let s₀ : Spec (.of Ω) := ⟨⊥, Ideal.isPrime_bot⟩
    have hq : ∀ y : Spec (.of ↥W), Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) s₀ ⤳ y := by
      intro y
      refine (PrimeSpectrum.le_iff_specializes (R := ↥W) _ _).mp ?_
      refine (PrimeSpectrum.asIdeal_le_asIdeal (R := ↥W) ..).mp ?_
      intro z hz
      have hz' : algebraMap ↥W Ω z = 0 := by
        have h1 : Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) s₀ =
            PrimeSpectrum.comap (algebraMap ↥W Ω) s₀ := rfl
        rw [h1, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at hz
        exact hz
      have hz0 : z = 0 := Subtype.ext hz'
      rw [hz0]
      exact Ideal.zero_mem _
    obtain ⟨x', hx'1, hx'2⟩ := Flat.generalizingMap uX' (hq (uX' x))
    obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback hM'.2.2 x' s₀ hx'2
    rw [← hp1] at hx'1
    exact ((genericPoint_specializes p).map ι'.continuous).trans hx'1

  obtain ⟨x0, hx0⟩ := hO'ne
  have hξ : ι' (γ (genericPoint C)) ∈ (O' : Set X') := by
    rw [hγη]; exact (hspec x0).mem_open O'.isOpen hx0
  have hrange : Set.range (C.fromSpecStalk (genericPoint C) ≫ γ ≫ ι') ⊆ Set.range O'.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    have ht : C.fromSpecStalk (genericPoint C) t ∈
        Set.range (C.fromSpecStalk (genericPoint C)) := ⟨t, rfl⟩
    rw [Scheme.range_fromSpecStalk] at ht
    have ht' : C.fromSpecStalk (genericPoint C) t = genericPoint C :=
      (Specializes.antisymm ht (genericPoint_specializes _)).eq
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ht']
    exact hξ

  let g' := IsOpenImmersion.lift O'.ι (C.fromSpecStalk (genericPoint C) ≫ γ ≫ ι') hrange
  have h1 : g' ≫ O'.ι = C.fromSpecStalk (genericPoint C) ≫ γ ≫ ι' :=
    IsOpenImmersion.lift_fac _ _ _
  refine ⟨g', h1, ?_⟩
  have h2 : g' ≫ r.resLE O O' hle = g := by
    rw [← cancel_mono O.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, h1, hg1,
      Category.assoc, Category.assoc, hι']

  let ψ : CommRingCat.of ↥(wcEbRing W a) ⟶ C.functionField := Spec.preimage (g' ≫ n)
  have hψ : Spec.map ψ = g' ≫ n := Spec.map_preimage _
  have hψρ : ψ.hom.comp (wcEbCdRho W a) =
      (algebraMap (RatFunc Ω) C.functionField).comp (wcEbCdJ W) := by
    have h3 : CommRingCat.ofHom (wcEbCdRho W a) ≫ ψ = CommRingCat.ofHom
        ((algebraMap (RatFunc Ω) C.functionField).comp (wcEbCdJ W)) := by
      apply Spec.map_injective
      rw [Spec.map_comp, hψ, Category.assoc, hn, ← Category.assoc, h2, hg2]
    have h4 := congrArg CommRingCat.Hom.hom h3
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom] at h4
    exact h4

  have hsubρ : (wcEbRing W a).subtype.comp (wcEbCdRho W a) = wcEbCdJ W := by
    apply MvPolynomial.ringHom_ext
    · intro w; simp [wcEbCdRho, wcEbCdJ, wcEbW]
    · intro i; simp [wcEbCdRho, wcEbCdJ]
  have hρ : ∀ p, ψ.hom (wcEbCdRho W a p) =
      (algebraMap (RatFunc Ω) C.functionField) ((wcEbCdRho W a p : wcEbRing W a) : RatFunc Ω) := by
    intro p
    have e1 := RingHom.congr_fun hψρ p
    have e2 := RingHom.congr_fun hsubρ p
    simp only [RingHom.comp_apply, Subring.coe_subtype] at e1 e2
    rw [e1, e2]
  have htv : ((wcEbCdRho W a (MvPolynomial.X 0) : wcEbRing W a) : RatFunc Ω) = RatFunc.X := by
    simp [wcEbCdRho]
  have hcv : ((wcEbCdRho W a (MvPolynomial.C a) : wcEbRing W a) : RatFunc Ω) =
      algebraMap Ω (RatFunc Ω) (a : Ω) := by
    simp [wcEbCdRho, wcEbW]
  have hne : (algebraMap (RatFunc Ω) C.functionField) RatFunc.X ≠ 0 :=
    (map_ne_zero _).mpr RatFunc.X_ne_zero
  have key : ∀ (y : RatFunc Ω) (hy : y ∈ Subring.closure
      ((Set.range fun w : ↥W => (algebraMap Ω (RatFunc Ω)) ↑w) ∪
        {RatFunc.X, (algebraMap Ω (RatFunc Ω)) ↑a * RatFunc.X⁻¹})),
      ψ.hom (⟨y, hy⟩ : wcEbRing W a) = (algebraMap (RatFunc Ω) C.functionField) y := by
    intro y hy
    induction hy using Subring.closure_induction with
    | mem y hy =>
      rcases hy with ⟨w, rfl⟩ | hy
      · have e : (⟨_, Subring.subset_closure (Or.inl ⟨w, rfl⟩)⟩ : wcEbRing W a) =
            wcEbCdRho W a (MvPolynomial.C w) := Subtype.ext (by simp [wcEbCdRho, wcEbW])
        rw [e, hρ]
        simp [wcEbCdRho, wcEbW]
      · rcases hy with rfl | hy
        · have e : (⟨RatFunc.X, Subring.subset_closure (Or.inr (Or.inl rfl))⟩ : wcEbRing W a) =
              wcEbCdRho W a (MvPolynomial.X 0) := Subtype.ext htv.symm
          rw [e, hρ, htv]
        · rw [Set.mem_singleton_iff] at hy
          subst hy
          set s : wcEbRing W a := ⟨_, Subring.subset_closure (Or.inr (Or.inr rfl))⟩ with hs
          set t : wcEbRing W a := wcEbCdRho W a (MvPolynomial.X 0) with ht
          have hst : s * t = wcEbCdRho W a (MvPolynomial.C a) := by
            apply Subtype.ext
            rw [Subring.coe_mul, htv, hcv]
            exact inv_mul_cancel_right₀ RatFunc.X_ne_zero _
          have hψt : ψ.hom t = (algebraMap (RatFunc Ω) C.functionField) RatFunc.X := by
            rw [ht, hρ, htv]
          have hm : ψ.hom s * ψ.hom t =
              (algebraMap (RatFunc Ω) C.functionField) ((s : RatFunc Ω)) *
                (algebraMap (RatFunc Ω) C.functionField) RatFunc.X := by
            rw [← map_mul, hst, hρ, ← hst, Subring.coe_mul, htv, map_mul]
          rw [hψt] at hm
          exact mul_right_cancel₀ hne hm
    | zero => exact (map_zero ψ.hom).trans (map_zero _).symm
    | one => exact (map_one ψ.hom).trans (map_one _).symm
    | add x y hx hy ihx ihy =>
      show ψ.hom (⟨x, hx⟩ + ⟨y, hy⟩) = _
      rw [map_add, ihx, ihy, map_add]
    | neg x hx ihx =>
      show ψ.hom (-⟨x, hx⟩) = _
      rw [map_neg, ihx, map_neg]
    | mul x y hx hy ihx ihy =>
      show ψ.hom (⟨x, hx⟩ * ⟨y, hy⟩) = _
      rw [map_mul, ihx, ihy, map_mul]
  have hEq : ψ.hom = (algebraMap (RatFunc Ω) C.functionField).comp (wcEbRing W a).subtype := by
    ext x
    exact key x.1 x.2
  have hψ' : ψ = CommRingCat.ofHom
      ((algebraMap (RatFunc Ω) C.functionField).comp (wcEbRing W a).subtype) :=
    CommRingCat.hom_ext (by rw [CommRingCat.hom_ofHom]; exact hEq)
  rw [← hψ, hψ']

theorem wcpa_dj_lr1k_eb_cd_closed_residue : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X' : Scheme.{u}) (uX' : X' ⟶ Spec (.of ↥W)) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
    wcpaDjLkModel W uX' ι' →
    ∀ y' : ↥(wcpaDjLkFib W (γ ≫ ι') uX'),
      IsClosed ({y'} : Set ↥(wcpaDjLkFib W (γ ≫ ι') uX')) →
      Function.Surjective (((γ ≫ ι').normalization.residue (wcNdPt W (γ ≫ ι') uX' y')).hom.comp
        (wcNdSig ((γ ≫ ι').fromNormalization ≫ uX') (wcNdPt W (γ ≫ ι') uX' y'))) :=
by
  classical
  have cr_A : ∀ {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (z : Z),
      Spec.map (CommRingCat.ofHom ((Z.residue z).hom.comp (wcNdSig h z))) =
        Z.fromSpecResidueField z ≫ h := by
    intro B _ Z h z
    have e1 : Z.fromSpecStalk z ≫ h = Spec.map (Z.presheaf.germ ⊤ z trivial) ≫ Spec.map h.appTop ≫
        Spec.map (Scheme.ΓSpecIso (.of B)).inv := by
      rw [← Scheme.fromSpecStalk_toSpecΓ, Category.assoc, ← Scheme.toSpecΓ_naturality_assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
    have e2 : CommRingCat.ofHom ((Z.residue z).hom.comp (wcNdSig h z)) =
        (Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop ≫ Z.presheaf.germ ⊤ z trivial ≫ Z.residue z := by
      have hid : Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op = 𝟙 _ := by
        rw [show (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
          CategoryTheory.Functor.map_id]
      apply CommRingCat.hom_ext
      simp only [wcNdSig, wcCnSigma, hid, CommRingCat.hom_id, CommRingCat.hom_ofHom,
        CommRingCat.hom_comp]
      rfl
    rw [show Z.fromSpecResidueField z = Spec.map (Z.residue z) ≫ Z.fromSpecStalk z from rfl,
      Category.assoc, e1, e2]
    simp only [Spec.map_comp, Category.assoc]
  have key : ∀ {N X : Scheme.{u}} (k : Type u) [Field k] [IsAlgClosed k] (B : Type u) [CommRing B]
      (ν : N ⟶ X) [IsIntegralHom ν] (u : X ⟶ Spec (.of B)) [LocallyOfFiniteType u] (ψ : B →+* k)
      (s : Spec (.of k) ⟶ Spec (.of B)), s = Spec.map (CommRingCat.ofHom ψ) →
      Function.Surjective ψ → ∀ y : ↥(Limits.pullback (ν ≫ u) s),
      IsClosed ({y} : Set ↥(Limits.pullback (ν ≫ u) s)) →
      Function.Surjective ((N.residue (Limits.pullback.fst (ν ≫ u) s y)).hom.comp
        (wcNdSig (ν ≫ u) (Limits.pullback.fst (ν ≫ u) s y))) := by
    intro N X k _ _ B _ ν _ u _ ψ s hs hψ y hy
    let π : Limits.pullback (ν ≫ u) s ⟶ Limits.pullback u s :=
      Limits.pullback.lift (Limits.pullback.fst (ν ≫ u) s ≫ ν) (Limits.pullback.snd (ν ≫ u) s)
        (by rw [Category.assoc, Limits.pullback.condition])
    have hπ1 : π ≫ Limits.pullback.fst u s = Limits.pullback.fst (ν ≫ u) s ≫ ν :=
      Limits.pullback.lift_fst _ _ _
    have hπ2 : π ≫ Limits.pullback.snd u s = Limits.pullback.snd (ν ≫ u) s :=
      Limits.pullback.lift_snd _ _ _
    have hpb : IsPullback π (Limits.pullback.fst (ν ≫ u) s) (Limits.pullback.fst u s) ν :=
      IsPullback.of_right (h₁₂ := Limits.pullback.snd u s) (h₂₂ := u) (v₁₃ := s)
        (by rw [hπ2]; exact (IsPullback.of_hasPullback (ν ≫ u) s).flip) hπ1
        (IsPullback.of_hasPullback u s).flip
    have hπint : IsIntegralHom π :=
      MorphismProperty.of_isPullback (P := @IsIntegralHom) hpb.flip inferInstance
    have hx : IsClosed ({π y} : Set ↥(Limits.pullback u s)) := by
      have := π.isClosedMap _ hy
      rwa [Set.image_singleton] at this
    have : JacobsonSpace ↥(Limits.pullback u s) :=
      LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd u s)
    have : LocallyOfFiniteType ((Limits.pullback u s).fromSpecResidueField (π y)) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hx
    set Ψ₀ := ((Limits.pullback u s).residue (π y)).hom.comp
      (wcNdSig (Limits.pullback.snd u s) (π y)) with hΨ₀def
    have hΨ₀ : Spec.map (CommRingCat.ofHom Ψ₀) =
        (Limits.pullback u s).fromSpecResidueField (π y) ≫ Limits.pullback.snd u s := cr_A _ _
    have hft : Ψ₀.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom Ψ₀)) := by
        rw [hΨ₀]; infer_instance
      exact HasRingHomProperty.Spec_iff.mp this
    have hΨ₀int : Ψ₀.IsIntegral := by
      letI := Ψ₀.toAlgebra
      have : Algebra.FiniteType k ((Limits.pullback u s).residueField (π y)) := hft
      have := finite_of_finite_type_of_isJacobsonRing k ((Limits.pullback u s).residueField (π y))
      exact fun t => Algebra.IsIntegral.isIntegral (R := k) t
    have hr' : Spec.map (π.residueFieldMap y) ≫ (Limits.pullback u s).fromSpecResidueField (π y) =
        (Limits.pullback (ν ≫ u) s).fromSpecResidueField y ≫ π :=
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField π y
    have : IsClosedImmersion ((Limits.pullback (ν ≫ u) s).fromSpecResidueField y) :=
      isClosed_singleton_iff_isClosedImmersion.mp hy
    have hr'int : (π.residueFieldMap y).hom.IsIntegral := by
      have : IsIntegralHom (Spec.map (π.residueFieldMap y) ≫
          (Limits.pullback u s).fromSpecResidueField (π y)) := by
        rw [hr']; infer_instance
      have : IsIntegralHom (Spec.map (π.residueFieldMap y)) :=
        IsIntegralHom.of_comp _ ((Limits.pullback u s).fromSpecResidueField (π y))
      exact IsIntegralHom.SpecMap_iff.mp this
    have hΨsurj : Function.Surjective ((π.residueFieldMap y).hom.comp Ψ₀) := by
      letI := ((π.residueFieldMap y).hom.comp Ψ₀).toAlgebra
      have : Algebra.IsIntegral k ((Limits.pullback (ν ≫ u) s).residueField y) :=
        ⟨RingHom.IsIntegral.trans _ _ hΨ₀int hr'int⟩
      exact (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k)).2
    set r := (Limits.pullback.fst (ν ≫ u) s).residueFieldMap y with hrdef
    set Φ := (N.residue (Limits.pullback.fst (ν ≫ u) s y)).hom.comp
      (wcNdSig (ν ≫ u) (Limits.pullback.fst (ν ≫ u) s y)) with hΦdef
    have hΦ : Spec.map (CommRingCat.ofHom Φ) =
        N.fromSpecResidueField (Limits.pullback.fst (ν ≫ u) s y) ≫ ν ≫ u := cr_A _ _
    have hsq : r.hom.comp Φ = ((π.residueFieldMap y).hom.comp Ψ₀).comp ψ := by
      have : CommRingCat.ofHom (r.hom.comp Φ) =
          CommRingCat.ofHom (((π.residueFieldMap y).hom.comp Ψ₀).comp ψ) := by
        apply Spec.map_injective
        rw [show CommRingCat.ofHom (r.hom.comp Φ) = CommRingCat.ofHom Φ ≫ r from rfl,
          show CommRingCat.ofHom (((π.residueFieldMap y).hom.comp Ψ₀).comp ψ) =
            CommRingCat.ofHom ψ ≫ CommRingCat.ofHom Ψ₀ ≫ π.residueFieldMap y from rfl,
          Spec.map_comp, Spec.map_comp, Spec.map_comp, hΦ, hΨ₀, ← hs,
          Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField_assoc,
          reassoc_of% hr']
        simp only [Category.assoc]
        rw [reassoc_of% hπ2, Limits.pullback.condition]
      exact congrArg CommRingCat.Hom.hom this
    intro t
    obtain ⟨w, hw⟩ := hΨsurj (r.hom t)
    obtain ⟨b, rfl⟩ := hψ w
    refine ⟨b, r.hom.injective ?_⟩
    have := congrArg (fun g => g b) hsq
    simp only [RingHom.comp_apply] at this hw ⊢
    rw [this, hw]
  have algcl : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
      IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    intro Ω _ _ W
    refine IsAlgClosed.of_exists_root _ ?_
    intro pb hmon hirr
    have hdeg : 0 < pb.degree := Polynomial.degree_pos_of_irreducible hirr
    have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.mem_lifts]
      exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
    obtain ⟨p, hpmap, hpdeg, hpmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
    have hPdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hpmon.degree_map, hpdeg]
      exact ne_of_gt hdeg
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hPdeg
    have hx' : Polynomial.eval x (p.map (algebraMap ↥W Ω)) = 0 := hx
    have hint : IsIntegral ↥W x := ⟨p, hpmon, by rw [← Polynomial.eval_map]; exact hx'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hpy : p.eval y = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval_map_apply, hy]
      exact hx'
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hpmap, Polynomial.eval_map_apply, hpy, map_zero]
  intro Ω _ _ W _ _ C γ _ X' uX' ι' _ _ hM y' hy'
  have hsemi : wcpaDjSemistable uX' := hM.1
  unfold wcpaDjSemistable at hsemi
  haveI : IsProper uX' := hsemi.2.1
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := algcl Ω W
  exact key (IsLocalRing.ResidueField ↥W) ↥W (γ ≫ ι').fromNormalization uX'
    (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) _ rfl IsLocalRing.residue_surjective y' hy'

theorem wcpa_dj_fcs_sections_integrally_closed : ∀ (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z], (∀ z : ↥Z, IsIntegrallyClosed (Z.presheaf.stalk z)) → ∀ U : Z.Opens, IsAffineOpen U → Nonempty ↥U → IsIntegrallyClosed ↑Γ(Z, U) :=
by
  intro Z _ hstalk U hU hne
  have : IsDomain Γ(Z, U) := @IsIntegral.component_integral Z _ U hne
  apply IsIntegrallyClosed.of_localization_maximal
  intro p _ hpmax
  let y : PrimeSpectrum Γ(Z, U) := ⟨p, hpmax.isPrime⟩
  have hx : hU.fromSpec y ∈ U := by
    have h := hU.range_fromSpec
    have h2 : hU.fromSpec y ∈ Set.range hU.fromSpec := ⟨y, rfl⟩
    rw [h] at h2
    exact h2
  letI : Algebra Γ(Z, U) (Z.presheaf.stalk (hU.fromSpec y)) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨hU.fromSpec y, hx⟩
  have hloc : IsLocalization.AtPrime (Z.presheaf.stalk (hU.fromSpec y)) p :=
    hU.isLocalization_stalk' y hx
  have := hstalk (hU.fromSpec y)
  exact IsIntegrallyClosed.of_equiv
    (IsLocalization.algEquiv p.primeCompl (Z.presheaf.stalk (hU.fromSpec y))
      (Localization.AtPrime p)).toRingEquiv

theorem wcpa_dj_lus_cvs_ct_fcn_smooth_stalk_normal : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] (W : Scheme.{u}) (q : W ⟶ Spec (.of B)) (n : ℕ) [SmoothOfRelativeDimension n q] (w : W), IsDomain (W.presheaf.stalk w) ∧ IsIntegrallyClosed (W.presheaf.stalk w) :=
by
  have halg : ∀ (R T : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing T]
      [Algebra R T] [Algebra.Etale R T] (q : Ideal T) [q.IsPrime],
      IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) := by
    intro R T _ _ _ _ _ _ q _
    classical
    have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (y : A),
        ∃ ε γ : A, IsIdempotentElem ε ∧ y * γ = ε ∧ (1 - ε) * y = 0 := by
      intro K A _ _ _ _ y
      obtain ⟨I, _, Ai, hF, hA, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
      let ε' : (i : I) → Ai i := fun i => if e y i = 0 then 0 else 1
      let γ' : (i : I) → Ai i := fun i => (e y i)⁻¹
      have hε' : IsIdempotentElem ε' := by
        show ε' * ε' = ε'
        funext i
        simp only [Pi.mul_apply, ε']
        split_ifs <;> simp
      refine ⟨e.symm ε', e.symm γ', hε'.map e.symm, ?_, ?_⟩
      · apply e.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
        funext i
        simp only [Pi.mul_apply, ε', γ']
        split_ifs with h
        · rw [h, zero_mul]
        · exact mul_inv_cancel₀ h
      · apply e.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        funext i
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
        split_ifs with h
        · rw [h, mul_zero]
        · simp
    let K := FractionRing R
    let S := TensorProduct R T K
    let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
    have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
    have hjinj : Function.Injective j :=
      Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
        (IsFractionRing.injective R K)
    have hQ : ∀ y : S, ∃ ε γ : S, IsIdempotentElem ε ∧ y * γ = ε ∧ (1 - ε) * y = 0 := by
      intro y
      let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
      obtain ⟨ε', γ', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c y)
      refine ⟨c.symm ε', c.symm γ', hε'.map c.symm, ?_, ?_⟩
      · apply c.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
        exact h1
      · apply c.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        exact h2
    have hlift : ∀ z : S, IsIntegral T z → ∃ t : T, j t = z := by
      intro z hint
      obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
        (B := K)).2 ⟨z, (mem_integralClosure_iff T S).mpr hint⟩
      have hw' := congrArg Subtype.val hw
      simp only at hw'
      have key : ∀ w' : TensorProduct R T (integralClosure R K),
          ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
        intro w'
        induction w' using TensorProduct.induction_on with
        | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
        | tmul t c =>
          have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
            rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
          obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
          refine ⟨r • t, ?_⟩
          rw [hj]
          change TensorProduct.tmul R t (c : K) = _
          rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
        | add x y hx hy =>
          obtain ⟨t₁, h₁⟩ := hx
          obtain ⟨t₂, h₂⟩ := hy
          exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
      obtain ⟨t, ht⟩ := key w
      exact ⟨t, ht.symm.trans hw'⟩
    have hliftI : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
      intro ε hε
      apply hlift
      refine ⟨Polynomial.X ^ 2 - Polynomial.X,
        Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
        sub_self]
    have hsep : ∀ a b : S, a * b = 0 →
        ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
      intro a b hab
      obtain ⟨ε, γ, hε, h1, h2⟩ := hQ a
      refine ⟨ε, hε, ?_, h2⟩
      rw [← h1, mul_comm a γ, mul_assoc, hab, mul_zero]
    have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
      obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
      dsimp only at hxy ⊢
      rw [← IsLocalization.mk'_mul] at hxy
      obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
      obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
        (by rw [← map_mul, mul_assoc, hm, map_zero])
      obtain ⟨e, rfl⟩ := hliftI ε hε
      have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
      have he2 : (1 - e) * ((m : T) * s) = 0 :=
        hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
      have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
      set π := algebraMap T (Localization.AtPrime q) with hπ
      have hē : π e * π e = π e := by rw [← map_mul, he3]
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
      · right
        have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
        have hs' : π s' = 0 := by
          have := congrArg π he1
          rwa [map_mul, h1', one_mul, map_zero] at this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
      · left
        have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
        have hs : π s = 0 := by
          have := congrArg π he2
          rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
          exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
    haveI hdom : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
    refine ⟨hdom, ?_⟩
    let L := Localization.AtPrime q
    let F := FractionRing L
    have hmk : ∀ (a : T) (s : q.primeCompl),
        algebraMap L F (IsLocalization.mk' L a s) * algebraMap T F s = algebraMap T F a := by
      intro a s
      rw [IsScalarTower.algebraMap_apply T L F (s : T), IsScalarTower.algebraMap_apply T L F a,
        ← map_mul, IsLocalization.mk'_spec]
    have hπne : ∀ s : T, s ∈ q.primeCompl → algebraMap T F s ≠ 0 := by
      intro s hs h
      rw [IsScalarTower.algebraMap_apply T L F] at h
      have h' := (IsFractionRing.injective L F) (h.trans (map_zero _).symm)
      exact (IsLocalization.map_units L (⟨s, hs⟩ : q.primeCompl)).ne_zero h'
    have hRne : ∀ r : R, r ≠ 0 → algebraMap R F r ≠ 0 := by
      intro r hr h
      rw [IsScalarTower.algebraMap_apply R T F, IsScalarTower.algebraMap_apply T L F] at h
      have h' : algebraMap T L (algebraMap R T r) = 0 :=
        (IsFractionRing.injective L F) (h.trans (map_zero _).symm)
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl L _).mp h'
      have hu : IsUnit (j (algebraMap R T r)) := by
        rw [AlgHom.commutes]
        have e1 : algebraMap R S r = Algebra.TensorProduct.includeRight (algebraMap R K r) :=
          (AlgHom.commutes _ r).symm
        rw [e1]
        exact (IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hr)).map _
      have hjm : j (m : T) = 0 := by
        have := congrArg j hm
        rw [map_mul, map_zero] at this
        exact (hu.mul_left_eq_zero).mp this
      have hm0 : (m : T) = 0 := hjinj (hjm.trans (map_zero j).symm)
      exact m.2 (by rw [hm0]; exact q.zero_mem)
    let ι : R →ₐ[R] F := Algebra.ofId R F
    have hι : Function.Injective ι :=
      (injective_iff_map_eq_zero ι).mpr (fun r hr => by
        by_contra h
        exact hRne r h hr)
    let κ : K →ₐ[R] F := IsFractionRing.liftAlgHom (R := R) (A := R) (K := K) (L := F) hι
    let ρ : S →ₐ[R] F := Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R T F) κ
    have hρj : ∀ t : T, ρ (j t) = algebraMap T F t := by
      intro t
      rw [hj]
      show Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R T F) κ (t ⊗ₜ[R] (1 : K)) = _
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    have hinv : ∀ g : S, ρ g ≠ 0 → ∃ g' : S, ρ g * ρ g' = 1 := by
      intro g hg
      obtain ⟨ε, γ, -, h1, h2⟩ := hQ g
      refine ⟨γ, ?_⟩
      rw [← map_mul, h1]
      have h3 := congrArg ρ h2
      rw [map_mul, map_sub, map_one, map_zero] at h3
      have h4 := (mul_eq_zero.mp h3).resolve_right hg
      exact (sub_eq_zero.mp h4).symm
    have hrangeL : ∀ l : L, ∃ g : S, ρ g = algebraMap L F l := by
      intro l
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl l
      dsimp only
      obtain ⟨g', hg'⟩ := hinv (j s) (by rw [hρj]; exact hπne s s.2)
      rw [hρj] at hg'
      refine ⟨j a * g', ?_⟩
      rw [map_mul, hρj, ← hmk a s, mul_assoc, hg', mul_one]
    have hrange : ∀ y : F, ∃ g : S, ρ g = y := by
      intro y
      obtain ⟨a', b', hb', rfl⟩ := IsFractionRing.div_surjective L y
      obtain ⟨ga, hga⟩ := hrangeL a'
      obtain ⟨gb, hgb⟩ := hrangeL b'
      have hb0 : algebraMap L F b' ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective L F)).mpr (nonZeroDivisors.ne_zero hb')
      obtain ⟨g', hg'⟩ := hinv gb (by rw [hgb]; exact hb0)
      refine ⟨ga * g', ?_⟩
      rw [map_mul, hga, div_eq_mul_inv, ← hgb, inv_eq_of_mul_eq_one_right hg']
    refine (isIntegrallyClosed_iff F).mpr ?_
    intro x hx
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization q.primeCompl x hx
    have hmx : m • x = algebraMap T F m * x := by rw [Submonoid.smul_def, Algebra.smul_def]
    rw [hmx] at hm
    obtain ⟨Q, hQm, hQx⟩ := hm
    obtain ⟨z, hz⟩ := hrange (algebraMap T F m * x)
    obtain ⟨v, hv⟩ : ∃ v : S, v = Q.eval₂ (algebraMap T S) z := ⟨_, rfl⟩
    have hρalg : ((ρ : S →+* F).comp (algebraMap T S)) = algebraMap T F :=
      RingHom.ext (fun t => hρj t)
    have hρv : ρ v = 0 := by
      have h0 : (ρ : S →+* F) v = 0 := by
        rw [hv, Polynomial.hom_eval₂, hρalg]
        change Polynomial.eval₂ (algebraMap T F) (ρ z) Q = 0
        rw [hz]
        exact hQx
      exact h0
    obtain ⟨δ, γ', hδ, h1, h2⟩ := hQ v
    have hρδ : ρ δ = 0 := by rw [← h1, map_mul, hρv, zero_mul]
    obtain ⟨z', hz'⟩ : ∃ z' : S, z' = (1 - δ) * z := ⟨_, rfl⟩
    obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub z' z (Q.map (algebraMap T S))
    rw [Polynomial.eval_map, Polynomial.eval_map, ← hv] at hc
    have hz'int : IsIntegral T z' := by
      refine ⟨Polynomial.X * Q, Polynomial.monic_X.mul hQm, ?_⟩
      rw [Polynomial.eval₂_X_mul]
      have e1 : Q.eval₂ (algebraMap T S) z' = v + (z' - z) * c := by rw [← hc]; ring
      rw [e1, hz']
      linear_combination z * h2 + z ^ 2 * c * hδ.eq
    obtain ⟨t, ht⟩ := hlift z' hz'int
    have hρz' : ρ z' = algebraMap T F m * x := by
      rw [hz', map_mul, map_sub, map_one, hρδ, sub_zero, one_mul, hz]
    have hπt : algebraMap T F t = algebraMap T F m * x := by
      rw [← hρj t, ht, hρz']
    refine ⟨IsLocalization.mk' L t m, ?_⟩
    apply mul_right_cancel₀ (hπne m m.2)
    rw [hmk, hπt, mul_comm]
  have hgeo : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Smooth f]
      (x : X), ∃ (n : ℕ) (T : Type u) (_ : CommRing T) (_ : Algebra (MvPolynomial (Fin n) A) T)
      (q : Ideal T) (_ : q.IsPrime), Algebra.Etale (MvPolynomial (Fin n) A) T ∧
      Nonempty (X.presheaf.stalk x ≃+* Localization.AtPrime q) := by
    intro A _ X f _ x
    classical
    obtain ⟨V, hV, hxV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hsm := (smooth_iff f).mp ‹_› (isAffineOpen_top (Spec (.of A))) hV e
    let e' : A ≃+* Γ(Spec (.of A), ⊤) :=
      Iso.commRingCatIsoToRingEquiv (Scheme.ΓSpecIso (CommRingCat.of A)).symm
    have he' : (e'.toRingHom).Smooth := RingHom.Smooth.of_bijective e'.bijective
    let φ : A →+* Γ(X, V) := (Scheme.Hom.appLE f ⊤ V e).hom.comp e'.toRingHom
    have hφ : φ.Smooth := RingHom.Smooth.comp he' hsm
    letI : Algebra A Γ(X, V) := φ.toAlgebra
    haveI : Algebra.Smooth A Γ(X, V) := RingHom.Smooth.toAlgebra hφ
    obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth A Γ(X, V)
    let p := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
    haveI hp : p.IsPrime := (hV.primeIdealOf ⟨x, hxV⟩).isPrime
    obtain ⟨b, hbs, hbp⟩ : ∃ b ∈ s, b ∉ p := by
      by_contra h
      push_neg at h
      have h1 : Ideal.span s ≤ p := Ideal.span_le.mpr h
      rw [hs] at h1
      exact hp.ne_top (top_le_iff.mp h1)
    have hC : Algebra.IsStandardSmooth A (Localization.Away b) := hstd b hbs
    obtain ⟨n, g, -, hg⟩ := RingHom.IsStandardSmooth.exists_etale_mvPolynomial
      (RingHom.isStandardSmooth_algebraMap.mpr hC)
    letI : Algebra (MvPolynomial (Fin n) A) (Localization.Away b) := g.toAlgebra
    have hEt : Algebra.Etale (MvPolynomial (Fin n) A) (Localization.Away b) :=
      RingHom.Etale.toAlgebra hg
    have hdisj : Disjoint ((Submonoid.powers b : Submonoid Γ(X, V)) : Set Γ(X, V))
        (p : Set Γ(X, V)) := by
      refine Set.disjoint_left.mpr ?_
      rintro y ⟨k, rfl⟩ hy
      exact hbp (hp.mem_of_pow_mem k hy)
    let q := p.map (algebraMap Γ(X, V) (Localization.Away b))
    haveI hq : q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) p hp hdisj
    have hcomap : Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q = p :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) hp hdisj
    letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxV⟩ : V)
    have hgen : ∀ (P : Ideal Γ(X, V)) [P.IsPrime], P = p →
        IsLocalization.AtPrime (X.presheaf.stalk x) P := by
      intro P _ hP
      subst hP
      exact hV.isLocalization_stalk ⟨x, hxV⟩
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x)
        (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q) := hgen _ hcomap
    let Φ₁ := IsLocalization.algEquiv
      (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q).primeCompl
      (X.presheaf.stalk x)
      (Localization.AtPrime (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q))
    let Φ₂ := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
      (Submonoid.powers b) q
    exact ⟨n, Localization.Away b, inferInstance, inferInstance, q, hq, hEt,
      ⟨Φ₁.toRingEquiv.trans Φ₂.toRingEquiv⟩⟩
  have hpoly : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (n : ℕ),
      IsIntegrallyClosed (MvPolynomial (Fin n) A) := by
    intro A _ _ _ n
    induction n with
    | zero =>
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).symm.toRingEquiv
    | succ n ih =>
