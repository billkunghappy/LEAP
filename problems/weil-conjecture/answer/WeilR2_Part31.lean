  have hcoeffL : ((F.coeff N : D) : L) =
      ∑ k ∈ Finset.range (N + 1), (-1) ^ k * lam ^ (N - k) * B k := by
    rw [hcoeff]
    change D.subtype (∑ k ∈ Finset.range (N + 1), (Bd k * ld ^ (N - k)) * (-1) ^ k) = _
    rw [map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_mul, map_mul, map_pow, map_pow, map_neg, map_one]
    show B k * lam ^ (N - k) * (-1) ^ k = _
    ring
  have hne : F.coeff N ≠ 0 := by
    intro h0
    apply hℓ
    rw [← hcoeffL, h0]
    simp
  have hnat : F.natDegree = N := Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hdeg hne
  have hlc : F.leadingCoeff = F.coeff N := by rw [Polynomial.leadingCoeff, hnat]
  have hI := isIntegral_leadingCoeff_smul F t haeval
  rw [hlc] at hI
  have hsm : (F.coeff N) • t = ((F.coeff N : D) : L) * t := rfl
  rw [hsm, hcoeffL] at hI
  exact hI

 have wcpa_dj_lr1k_eb_uc_lc_shift : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (L : Type u) [Field L] [Algebra (RatFunc Ω) L] (g : Ω) (η : L) (N j0 : ℕ)
    (x : ℕ → ℕ → Ω), g ≠ 0 → η ≠ 0 → j0 ≤ N → (∀ j k, x j k ∈ W) →
    (∀ j k, j < j0 → k ≤ N → x j k / g ^ (j0 - j) ∈ W) →
    ∃ B : ℕ → L, (∀ k, B k ∈ wcEbEpD W L g η) ∧
      (∀ k ≤ N, η ^ j0 * B k = ∑ j ∈ Finset.range (N + 1),
        algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (x j k)) * η ^ j) ∧
      ∀ V : ValuationSubring L,
        (∀ w : ↥W, V.valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (w : Ω))) ≤ 1) →
        V.valuation η < 1 →
        V.valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) g) / η) < 1 →
        ∀ k ≤ N, V.valuation (B k - algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (x j0 k))) < 1 := by
  intro Ω _ W L _ _ g η N j0 x hg hη hj0 hxW hdiv
  classical
  obtain ⟨ι, hι⟩ : ∃ ι : Ω →+* L,
      ι = (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)) := ⟨_, rfl⟩
  have hιapp : ∀ w : Ω, algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w) = ι w := by
    intro w; rw [hι]; rfl
  have hηD : η ∈ wcEbEpD W L g η := Subring.subset_closure (Or.inr (Set.mem_insert _ _))
  have hGD : ι g / η ∈ wcEbEpD W L g η := by
    rw [← hιapp]; exact Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))
  have hcD : ∀ w : Ω, w ∈ W → ι w ∈ wcEbEpD W L g η := by
    intro w hw; rw [← hιapp]; exact Subring.subset_closure (Or.inl ⟨⟨w, hw⟩, rfl⟩)
  simp only [hιapp]
  have hιg : ι g ≠ 0 := (map_ne_zero ι).mpr hg
  let τ : ℕ → ℕ → L := fun j k => if j0 ≤ j then ι (x j k) * η ^ (j - j0)
    else ι (x j k / g ^ (j0 - j)) * (ι g / η) ^ (j0 - j)
  refine ⟨fun k => if k ≤ N then ∑ j ∈ Finset.range (N + 1), τ j k else 0, ?_, ?_, ?_⟩
  · intro k
    show (if k ≤ N then ∑ j ∈ Finset.range (N + 1), τ j k else 0) ∈ wcEbEpD W L g η
    split_ifs with hk
    · refine sum_mem (fun j _ => ?_)
      show (if j0 ≤ j then ι (x j k) * η ^ (j - j0)
        else ι (x j k / g ^ (j0 - j)) * (ι g / η) ^ (j0 - j)) ∈ wcEbEpD W L g η
      split_ifs with hj
