      ¬ IsUnit (φ (wcEbntX W b 0)) → ¬ IsUnit (φ (wcEbntX W b 1)) →
      (∀ c ∈ IsLocalRing.maximalIdeal ↥W, ¬ IsUnit (φ (Ideal.Quotient.mk _ (MvPolynomial.C c)))) →
      ∀ t, IsUnit (φ t) ↔ t ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
        (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})) := by
    intro B _ _ φ hX0 hX1 hC t
