    have hτC : ∀ r : A, τ (Polynomial.C r) = Polynomial.C r := by
      intro r
      show Polynomial.taylor (-c) (Polynomial.C r) = _
      exact Polynomial.taylor_C (R := A) _ _
    let ε : Polynomial A →+* E := ε₀.comp τ.toRingHom
    have hεC : ε.comp Polynomial.C = σ := by
      rw [← hε₀C]
      ext r
