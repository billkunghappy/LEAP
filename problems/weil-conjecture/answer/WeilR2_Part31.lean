  have hmap : Ideal.map e (Ideal.map (wcNdSig ((γ ≫ ι).fromNormalization ≫ uX)
      (wcNdPt W (γ ≫ ι) uX y)) (IsLocalRing.maximalIdeal ↥W)) =
      Ideal.map f (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    rw [Ideal.map_map, Ideal.map_map, hfc]
  obtain ⟨θ, -⟩ := wcpa_dj_lr1k_ndmf_hens_levels _ _ P _ _ e f inferInstance h𝔫 he hf _ _
    hI le_sup_right hmap
