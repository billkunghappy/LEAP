      (∀ (w : ↥W) (hw : c (w : Ω) ∈ V), φ (IsLocalRing.residue ↥W w) =
        IsLocalRing.residue ↥V ⟨c (w : Ω), hw⟩) ∧
      ∀ x : ↥V, ((∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) (x : K) ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) (x : K))⁻¹ ∈ V) ↔
        ∀ p : Polynomial (IsLocalRing.ResidueField ↥W),
          p.eval₂ φ (IsLocalRing.residue ↥V x) = 0 → p = 0) := by
    let ψ : ↥W →+* ↥V :=
      { toFun := fun w => ⟨c w, (hVW w).2 w.2⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun x y => Subtype.ext (by simp)
        map_zero' := Subtype.ext (by simp)
        map_add' := fun x y => Subtype.ext (by simp) }
    have hψ : ∀ w : ↥W, ((ψ w : ↥V) : K) = c (w : Ω) := fun w => rfl
    haveI : IsLocalHom ψ := by
      refine ⟨fun w hw => ?_⟩
      obtain ⟨u, hu⟩ := hw
      have h1 : ((u : ↥V) : K) * (((u⁻¹ : (↥V)ˣ) : ↥V) : K) = 1 := by
        rw [← MulMemClass.coe_mul, Units.mul_inv]; rfl
      rw [hu, hψ] at h1
      have hc0 : c (w : Ω) ≠ 0 := left_ne_zero_of_mul_eq_one h1
      have hw0 : (w : Ω) ≠ 0 := fun h => hc0 (by rw [h, map_zero])
      have h2 : (((u⁻¹ : (↥V)ˣ) : ↥V) : K) = c ((w : Ω)⁻¹) := by
        rw [map_inv₀]; exact eq_inv_of_mul_eq_one_right h1
      have h3 : (w : Ω)⁻¹ ∈ W := (hVW _).1 (by rw [← h2]; exact ((u⁻¹ : (↥V)ˣ) : ↥V).2)
      exact isUnit_iff_exists_inv.mpr ⟨⟨(w : Ω)⁻¹, h3⟩, Subtype.ext (by simp [hw0])⟩
    refine ⟨IsLocalRing.ResidueField.map ψ, fun w hw => ?_, fun x => ?_⟩
    · exact IsLocalRing.ResidueField.map_residue ψ w
    have hcomp1 : V.subtype.comp ψ = c.comp W.subtype := RingHom.ext fun w => rfl
    have hcomp2 : (IsLocalRing.residue ↥V).comp ψ =
        (IsLocalRing.ResidueField.map ψ).comp (IsLocalRing.residue ↥W) :=
      RingHom.ext fun w => (IsLocalRing.ResidueField.map_residue ψ w).symm
    have c1 : ∀ q : Polynomial ↥W, ((q.eval₂ ψ x : ↥V) : K) = q.eval₂ (c.comp W.subtype) (x : K) := by
      intro q
      have h := Polynomial.hom_eval₂ q ψ V.subtype x
      rw [hcomp1] at h
      exact h
    have c2 : ∀ q : Polynomial ↥W, IsLocalRing.residue ↥V (q.eval₂ ψ x) =
        (q.map (IsLocalRing.residue ↥W)).eval₂ (IsLocalRing.ResidueField.map ψ)
          (IsLocalRing.residue ↥V x) := by
      intro q
      rw [Polynomial.hom_eval₂, hcomp2, Polynomial.eval₂_map]
    constructor
    · intro hRTx p hp
      by_contra hp0
      obtain ⟨q, rfl⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
        IsLocalRing.residue_surjective p
      obtain ⟨i, hi⟩ : ∃ i, (q.map (IsLocalRing.residue ↥W)).coeff i ≠ 0 := by
        by_contra h
        push_neg at h
        exact hp0 (Polynomial.ext h)
      rw [Polynomial.coeff_map, IsLocalRing.residue_ne_zero_iff_isUnit] at hi
      obtain ⟨hne, hinv⟩ := hRTx q ⟨i, hi⟩
      have hunit : IsUnit (q.eval₂ ψ x) := by
        refine isUnit_iff_exists_inv.mpr ⟨⟨_, hinv⟩, Subtype.ext ?_⟩
        show ((q.eval₂ ψ x : ↥V) : K) * _ = 1
        rw [c1]
        exact mul_inv_cancel₀ hne
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, c2] at hunit
      exact hunit hp
    · rintro hT q ⟨i, hi⟩
      have hp0 : q.map (IsLocalRing.residue ↥W) ≠ 0 := by
        intro h
        have h' := congrArg (fun r => r.coeff i) h
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h'
        exact ((IsLocalRing.residue_ne_zero_iff_isUnit (q.coeff i)).mpr hi) h'
      have hne : IsLocalRing.residue ↥V (q.eval₂ ψ x) ≠ 0 := by
        rw [c2]
        exact fun h => hp0 (hT _ h)
      rw [IsLocalRing.residue_ne_zero_iff_isUnit] at hne
      obtain ⟨U, hU⟩ := hne
      have hmul : ((q.eval₂ ψ x : ↥V) : K) * (((U⁻¹ : (↥V)ˣ) : ↥V) : K) = 1 := by
        rw [← hU, ← MulMemClass.coe_mul, Units.mul_inv]; rfl
      rw [c1] at hmul
      refine ⟨left_ne_zero_of_mul_eq_one hmul, ?_⟩
      rw [← eq_inv_of_mul_eq_one_right hmul]
      exact ((U⁻¹ : (↥V)ˣ) : ↥V).2

  have s3 : ∀ (A B : Multiset K) (ε₁ ε₂ : Ω), ε₁ ≠ 0 →
      (∀ z ∈ A + B, z ∈ V ∧ z ≠ 0 ∧ z⁻¹ ∈ V) → c ε₁ * s * B.prod = c ε₂ * A.prod →
      ∃ z ∈ A + B, z ∈ V ∧ ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) z ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) z)⁻¹ ∈ V := by
    intro A B ε₁ ε₂ hε₁ hU heq
    by_contra hN
    have hN' : ∀ z ∈ A + B, z ∈ V → ¬ (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) z ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) z)⁻¹ ∈ V) :=
      fun z hz hzV hRTz => hN ⟨z, hz, hzV, hRTz⟩
    letI : Algebra (IsLocalRing.ResidueField ↥W) (IsLocalRing.ResidueField ↥V) := φ.toAlgebra
    let S : Submonoid K :=
      { carrier := {y | ∃ hy : y ∈ V, y ≠ 0 ∧ y⁻¹ ∈ V ∧
          IsAlgebraic (IsLocalRing.ResidueField ↥W) (IsLocalRing.residue ↥V ⟨y, hy⟩)}
        mul_mem' := by
          rintro y z ⟨hy, hy0, hyi, hya⟩ ⟨hz, hz0, hzi, hza⟩
          refine ⟨mul_mem hy hz, mul_ne_zero hy0 hz0,
            by rw [mul_inv]; exact mul_mem hyi hzi, ?_⟩
          have e : (⟨y * z, mul_mem hy hz⟩ : ↥V) = ⟨y, hy⟩ * ⟨z, hz⟩ := rfl
          rw [e, map_mul]
          exact hya.mul hza
        one_mem' := by
          refine ⟨V.one_mem, one_ne_zero, by rw [inv_one]; exact V.one_mem, ?_⟩
          have e : (⟨1, V.one_mem⟩ : ↥V) = 1 := rfl
          rw [e, map_one]
          exact isAlgebraic_one }
    have hmemS : ∀ y, y ∈ S ↔ ∃ hy : y ∈ V, y ≠ 0 ∧ y⁻¹ ∈ V ∧
        IsAlgebraic (IsLocalRing.ResidueField ↥W) (IsLocalRing.residue ↥V ⟨y, hy⟩) :=
      fun y => Iff.rfl
    have hfac : ∀ z ∈ A + B, z ∈ S := by
      intro z hz
      obtain ⟨hzV, hz0, hzi⟩ := hU z hz
      rw [hmemS]
      refine ⟨hzV, hz0, hzi, ?_⟩
      have hnot : ¬ ∀ p : Polynomial (IsLocalRing.ResidueField ↥W),
          p.eval₂ φ (IsLocalRing.residue ↥V ⟨z, hzV⟩) = 0 → p = 0 :=
        fun h => hN' z hz hzV ((hD ⟨z, hzV⟩).mpr h)
      push_neg at hnot
      obtain ⟨p, hp, hp0⟩ := hnot
      exact ⟨p, hp0, by rw [Polynomial.aeval_def]; exact hp⟩
    have hA := S.multiset_prod_mem A (fun z hz => hfac z (Multiset.mem_add.mpr (Or.inl hz)))
    have hB := S.multiset_prod_mem B (fun z hz => hfac z (Multiset.mem_add.mpr (Or.inr hz)))
    obtain ⟨hAV, hA0, hAi, hAa⟩ := (hmemS _).mp hA
    obtain ⟨hBV, hB0, hBi, hBa⟩ := (hmemS _).mp hB
    have hcε₁ : c ε₁ ≠ 0 := (map_ne_zero c).mpr hε₁
    have hee : c (ε₂ / ε₁) * c ε₁ = c ε₂ := by rw [← map_mul, div_mul_cancel₀ _ hε₁]
    have hce : c (ε₂ / ε₁) = s * B.prod * (A.prod)⁻¹ := by
      have h2 : c (ε₂ / ε₁) * (c ε₁ * A.prod) = s * B.prod * (A.prod)⁻¹ * (c ε₁ * A.prod) := by
        calc c (ε₂ / ε₁) * (c ε₁ * A.prod) = c ε₂ * A.prod := by rw [← hee]; ring
          _ = c ε₁ * s * B.prod := heq.symm
          _ = s * B.prod * (A.prod)⁻¹ * (c ε₁ * A.prod) := by
            rw [mul_comm (c ε₁) A.prod, ← mul_assoc, inv_mul_cancel_right₀ hA0]; ring
      exact mul_right_cancel₀ (mul_ne_zero hcε₁ hA0) h2
    have hceV : c (ε₂ / ε₁) ∈ V := by
      rw [hce]; exact mul_mem (mul_mem hsV hBV) hAi
    have heW : ε₂ / ε₁ ∈ W := (hVW _).1 hceV
    have hVeq : (⟨s, hsV⟩ : ↥V) * ⟨B.prod, hBV⟩ = ⟨c (ε₂ / ε₁), hceV⟩ * ⟨A.prod, hAV⟩ := by
      apply Subtype.ext
      show s * B.prod = c (ε₂ / ε₁) * A.prod
      rw [hce, inv_mul_cancel_right₀ hA0]
    have hres := congrArg (IsLocalRing.residue ↥V) hVeq
    rw [map_mul, map_mul] at hres
    have hBunit : IsLocalRing.residue ↥V ⟨B.prod, hBV⟩ ≠ 0 := by
      rw [IsLocalRing.residue_ne_zero_iff_isUnit]
      exact isUnit_iff_exists_inv.mpr ⟨⟨_, hBi⟩, Subtype.ext (mul_inv_cancel₀ hB0)⟩
    have hsres : IsLocalRing.residue ↥V ⟨s, hsV⟩ =
        IsLocalRing.residue ↥V ⟨c (ε₂ / ε₁), hceV⟩ * IsLocalRing.residue ↥V ⟨A.prod, hAV⟩ *
          (IsLocalRing.residue ↥V ⟨B.prod, hBV⟩)⁻¹ := by
      rw [eq_mul_inv_iff_mul_eq₀ hBunit]; exact hres
    have hcalg : IsAlgebraic (IsLocalRing.ResidueField ↥W)
        (IsLocalRing.residue ↥V ⟨c (ε₂ / ε₁), hceV⟩) := by
      have h := hφ ⟨ε₂ / ε₁, heW⟩ hceV
      show IsAlgebraic _ (IsLocalRing.residue ↥V ⟨c ((⟨ε₂ / ε₁, heW⟩ : ↥W) : Ω), hceV⟩)
      rw [← h]
      exact isAlgebraic_algebraMap _
    have hsalg : IsAlgebraic (IsLocalRing.ResidueField ↥W) (IsLocalRing.residue ↥V ⟨s, hsV⟩) := by
      rw [hsres]
      exact (hcalg.mul hAa).mul hBa.inv
    obtain ⟨p, hp0, hp⟩ := hsalg
    rw [Polynomial.aeval_def] at hp
    exact hp0 ((hD ⟨s, hsV⟩).mp hRT p hp)

  obtain ⟨p, q, hq, hspq⟩ := hgen s
  have hs0 : s ≠ 0 := by
    have h := (hRT Polynomial.X ⟨1, by simp⟩).1
    simpa using h
  have hp : p.eval₂ c t ≠ 0 := by rw [← hspq]; exact mul_ne_zero hs0 hq
  have hpf := s4 p t
  have hqf := s4 q t
  have hpR : ∀ γ ∈ p.roots, t - c γ ≠ 0 := by
    intro γ hγ h0
    apply hp
    rw [hpf, Multiset.prod_eq_zero (Multiset.mem_map.mpr ⟨γ, hγ, h0⟩), mul_zero]
  have hqR : ∀ γ ∈ q.roots, t - c γ ≠ 0 := by
    intro γ hγ h0
    apply hq
    rw [hqf, Multiset.prod_eq_zero (Multiset.mem_map.mpr ⟨γ, hγ, h0⟩), mul_zero]
  have hlcq : q.leadingCoeff ≠ 0 := by
    intro h
    rw [Polynomial.leadingCoeff_eq_zero] at h
    subst h
    exact hq (Polynomial.eval₂_zero _ _)
  have hb : ∀ α : Ω, ∃ b : Ω, b ≠ 0 ∧ (t - c α ≠ 0 →
      (t - c α) * (c b)⁻¹ ∈ V ∧ ((t - c α) * (c b)⁻¹)⁻¹ ∈ V) := by
    intro α
    by_cases hα : t - c α = 0
    · exact ⟨1, one_ne_zero, fun h => absurd hα h⟩
    · have hcomp : ∀ r : Polynomial Ω,
          (r.comp (Polynomial.X + Polynomial.C α)).eval₂ c (t - c α) = r.eval₂ c t := by
        intro r
        rw [Polynomial.eval₂_comp]
        simp
      obtain ⟨b, hb0, hb1, hb2⟩ := s1 (t - c α) hα
        ⟨p.comp (Polynomial.X + Polynomial.C α), q.comp (Polynomial.X + Polynomial.C α),
          by rw [hcomp]; exact hq, by rw [hcomp, hcomp]; exact hspq⟩
      exact ⟨b, hb0, fun _ => ⟨hb1, hb2⟩⟩
  choose bf hbf0 hbfu using hb
  have hcb : ∀ α, c (bf α) ≠ 0 := fun α => (map_ne_zero c).mpr (hbf0 α)
  obtain ⟨uf, huf⟩ : ∃ uf : Ω → K, ∀ α, uf α = (t - c α) * (c (bf α))⁻¹ := ⟨_, fun _ => rfl⟩
  have hid : ∀ R : Multiset Ω,
      (R.map (fun α => t - c α)).prod = c (R.map bf).prod * (R.map uf).prod := by
    intro R
    rw [map_multiset_prod, Multiset.map_map, ← Multiset.prod_map_mul]
    congr 1
    apply Multiset.map_congr rfl
    intro α _
    show t - c α = c (bf α) * uf α
    rw [huf, mul_comm (c (bf α)), mul_assoc, inv_mul_cancel₀ (hcb α), mul_one]
  have hε₁ : q.leadingCoeff * (q.roots.map bf).prod ≠ 0 := by
    refine mul_ne_zero hlcq (Multiset.prod_ne_zero ?_)
    rw [Multiset.mem_map]
    rintro ⟨β, _, hβ⟩
    exact hbf0 β hβ
  have hAB : ∀ z ∈ p.roots.map uf + q.roots.map uf, ∃ γ, t - c γ ≠ 0 ∧ z = uf γ := by
    intro z hz
    rcases Multiset.mem_add.mp hz with h | h
    · obtain ⟨γ, hγ, rfl⟩ := Multiset.mem_map.mp h
      exact ⟨γ, hpR γ hγ, rfl⟩
    · obtain ⟨γ, hγ, rfl⟩ := Multiset.mem_map.mp h
      exact ⟨γ, hqR γ hγ, rfl⟩
  have hunit : ∀ z ∈ p.roots.map uf + q.roots.map uf, z ∈ V ∧ z ≠ 0 ∧ z⁻¹ ∈ V := by
    intro z hz
    obtain ⟨γ, hγ, rfl⟩ := hAB z hz
    obtain ⟨h1, h2⟩ := hbfu γ hγ
    rw [huf]
    exact ⟨h1, mul_ne_zero hγ (inv_ne_zero (hcb γ)), h2⟩
  have heq : c (q.leadingCoeff * (q.roots.map bf).prod) * s * (q.roots.map uf).prod =
      c (p.leadingCoeff * (p.roots.map bf).prod) * (p.roots.map uf).prod := by
    have e1 := hspq
    rw [hqf, hpf, hid, hid] at e1
    rw [map_mul, map_mul]
    linear_combination e1
  obtain ⟨z, hz, hzV, hzRT⟩ := s3 (p.roots.map uf) (q.roots.map uf)
    (q.leadingCoeff * (q.roots.map bf).prod) (p.leadingCoeff * (p.roots.map bf).prod)
    hε₁ hunit heq
  obtain ⟨γ, _, rfl⟩ := hAB z hz
  refine ⟨γ, bf γ, hbf0 γ, ?_, ?_⟩
  · rw [← huf]; exact hzV
  · rw [← huf]; exact hzRT

