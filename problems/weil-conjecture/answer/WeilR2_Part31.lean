        obtain ⟨b, hbS, hb⟩ := s2 {b | IsIntegral ↥O.toSubring b}
          (fun y hy => s1 y (fun V hV => by
            obtain ⟨i, hi⟩ := hVsall V (by rw [hV])
            rw [← hi]; exact hy i))
          (fun i => (x i : L)) (fun i => (x i).2)
        let bB : ↥(integralClosure ↥O.toSubring L) := ⟨b, hbS⟩
        refine ⟨fun l => πR (β.repr bB l), ?_⟩
        funext i
        rw [Finset.sum_apply]
        have e1 : ∀ l, ((fun l => πR (β.repr bB l)) l • (fun l i => ρ i (β l)) l) i =
