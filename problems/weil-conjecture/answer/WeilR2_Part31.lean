    haveI : IsLocalization.Away eJ (integralClosure A L) :=
      IsLocalization.away_of_isIdempotentElem hid hker hsurj
    haveI : Algebra.Etale (integralClosure A (TensorProduct R A L)) (integralClosure A L) :=
