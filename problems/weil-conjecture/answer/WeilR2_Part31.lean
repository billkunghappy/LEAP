          have hk' : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          rw [show lam ^ N = lam ^ (N - k) * lam ^ k by rw [← pow_add, Nat.sub_add_cancel hk'],
