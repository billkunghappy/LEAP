      · exact ⟨s, hs0, hs, hsH⟩
    exact wcpa_dj_lr1k_ebnt_dm_no_embedded Ω W hdim hWt Q σ b f hf γ u H hu0 hu1 huH

  obtain ⟨α, n, i, hα0, hint, hex⟩ :=
    wcpa_dj_lr1k_ebnt_dm_slope Ω W hdim hWt Q σ b f hf F G c hc hFG
  have hmain : ∀ (x' y' : Q), x' * y' = σ b →
      (∀ (K : Type u) [Field K] (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k →
        (∃ μ ∈ IsLocalRing.maximalIdeal ↥W, μ ≠ 0 ∧ k (σ μ) ∣ k (f (wcEbntX W b 0)) ∧
          k (σ μ) ∣ k (f (wcEbntX W b 1))) → k (σ (α * b ^ n)) ∣ k (F * y' ^ n)) →
      (∃ (K : Type u) (_ : Field K) (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k ∧
        k (σ (α * b ^ n)) ≠ 0 ∧ k (F * y' ^ n) ∣ k (σ (α * b ^ n))) →
      ∃ η : Q, IsUnit η ∧ F = η * σ α * x' ^ n := by
    rintro x' y' hxy hintH ⟨K, _, V, k, hk, hkne, hkd⟩
    have hb : σ b ≠ 0 := fun h => hb0 (hσinj (h.trans (map_zero σ).symm))
    have hγ : α * b ^ n ≠ 0 := mul_ne_zero hα0 (pow_ne_zero _ hb0)
    have hc' : c * b ^ n ≠ 0 := mul_ne_zero hc (pow_ne_zero _ hb0)
    have hHG : (F * y' ^ n) * (G * x' ^ n) = σ (c * b ^ n) := by
      rw [map_mul, map_pow, ← hxy, ← hFG]
      ring
    have hmem := hdiv (F * y' ^ n) (G * x' ^ n) (c * b ^ n) (α * b ^ n) hc' hγ hHG hintH
    obtain ⟨E, hE⟩ := Ideal.mem_span_singleton'.mp hmem
    have hy0 : y' ≠ 0 := by
      rintro rfl
      apply hb
      rw [← hxy, mul_zero]
    have hF : F = E * σ α * x' ^ n := by
      apply mul_right_cancel₀ (pow_ne_zero n hy0)
      rw [← hE, map_mul, map_pow, ← hxy]
      ring
    refine ⟨E, ?_, hF⟩
    obtain ⟨r, hr⟩ := hkd
    have h1 : k (σ (α * b ^ n)) * (k E * r) = k (σ (α * b ^ n)) * 1 := by
      rw [mul_one]
      conv_rhs => rw [hr]
      rw [← hE, map_mul k]
      ring
    have h2 := mul_left_cancel₀ hkne h1
    have hkE : IsUnit (k E) := ⟨⟨k E, r, h2, by rw [mul_comm]; exact h2⟩, rfl⟩
    exact (isUnit_map_iff k E).mp hkE
  have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
  rcases hi with rfl | rfl
  · have e : (1 : Fin 2) - 0 = 1 := rfl
    rw [e] at hint hex
    obtain ⟨η, hη, hF⟩ := hmain (f (wcEbntX W b 0)) (f (wcEbntX W b 1))
      (hrel _ _ _ _ hf) hint hex
    exact ⟨α, n, η, hα0, hη, Or.inl hF⟩
  · have e : (1 : Fin 2) - 1 = 0 := rfl
    rw [e] at hint hex
    obtain ⟨η, hη, hF⟩ := hmain (f (wcEbntX W b 1)) (f (wcEbntX W b 0))
      (by rw [mul_comm]; exact hrel _ _ _ _ hf) hint hex
    exact ⟨α, n, η, hα0, hη, Or.inr hF⟩

theorem wcpa_dj_lr1k_ebnt_coord_divides : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (σ : ↥W →+* P) (b : ↥W) (f : wcEbntN W b →+* P), wcEbntPres W σ b f → ∀ c : ↥W, σ c ∈ Ideal.span {f (wcEbntX W b 0)} → b ∣ c :=
by
  intro Ω _ _ W P _ σ b f hf c hc
  classical
  obtain ⟨hbm, hb0, hfσ, hH⟩ := hf

  have hWH : HenselianLocalRing ↥W := by
    refine ⟨fun F hF a₀ h₁ _ => ?_⟩
    have h2 : W.valuation (algebraMap W Ω (F.eval a₀)) < 1 := (W.valuation_lt_one_iff _).mp h₁
    have hsplit := IsAlgClosed.splits (F.map (algebraMap W Ω))
    have h3 := Polynomial.Splits.aeval_eq_prod_aroots_of_monic hsplit hF (algebraMap W Ω a₀)
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h3
    rw [h3] at h2
    have h4 : ∃ α ∈ F.aroots Ω, W.valuation (algebraMap W Ω a₀ - α) < 1 := by
      by_contra hcon
      push_neg at hcon
      rw [map_multiset_prod, Multiset.map_map] at h2
      have : 1 ≤ ((F.aroots Ω).map (W.valuation ∘ fun α => algebraMap W Ω a₀ - α)).prod := by
        apply Multiset.one_le_prod
        intro x hx
        obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hx
        exact hcon α hα
      exact absurd h2 (not_lt.mpr this)
    obtain ⟨α, hα, hv⟩ := h4
    have hα' := (Polynomial.mem_aroots.mp hα).2
    have hint : _root_.IsIntegral W α := ⟨F, hF, by rwa [← Polynomial.aeval_def]⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, ?_, ?_⟩
    · show Polynomial.eval y F = 0
      apply FaithfulSMul.algebraMap_injective W Ω
      rw [map_zero, ← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, hy]
      exact hα'
    · rw [W.valuation_lt_one_iff]
      have e : ((y - a₀ : W) : Ω) = algebraMap W Ω y - algebraMap W Ω a₀ := by
        simp only [ValuationSubring.algebraMap_apply]; push_cast; rfl
      rw [e, hy, Valuation.map_sub_swap]
      exact hv

  by_cases hc0 : c = 0
  · rw [hc0]; exact dvd_zero b
  by_contra hbc
  obtain ⟨d, hd⟩ : c ∣ b := (ValuationRing.dvd_total b c).resolve_left hbc
  have hd0 : d ≠ 0 := by
    rintro rfl
    exact hb0 (by rw [hd, mul_zero])
  have hdm : d ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hdm
    have hdu : IsUnit d := IsLocalRing.notMem_maximalIdeal.mp hdm
    apply hbc
    refine ⟨↑hdu.unit⁻¹, ?_⟩
    rw [hd, mul_assoc, hdu.mul_val_inv, mul_one]

  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((d : Ω)) (by norm_num : 0 < 2)
  have hdΩ : (d : Ω) ≠ 0 := fun h => hd0 (Subtype.ext h)
  have hz0 : z ≠ 0 := by
    rintro rfl
    apply hdΩ
    rw [← hz]
    ring
  have hzW : z ∈ W := by
    rcases W.mem_or_inv_mem z with h | h
    · exact h
    · exfalso
      let w : ↥W := ⟨z⁻¹, h⟩
      have hw : w ^ 2 * d = 1 := by
        apply Subtype.ext
        show (z⁻¹) ^ 2 * (d : Ω) = 1
        rw [← hz, inv_pow, inv_mul_cancel₀ (pow_ne_zero 2 hz0)]
      have hdu : IsUnit d := ⟨⟨d, w ^ 2, by rw [mul_comm]; exact hw, hw⟩, rfl⟩
      exact (IsLocalRing.notMem_maximalIdeal.mpr hdu) hdm
  set δ : ↥W := ⟨z, hzW⟩ with hδdef
  have hδ2 : δ ^ 2 = d := by
    apply Subtype.ext
    show z ^ 2 = (d : Ω)
    exact hz
  have hδm : δ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra h
    have hu := IsLocalRing.notMem_maximalIdeal.mp h
    have hdu : IsUnit d := hδ2 ▸ hu.pow 2
    exact (IsLocalRing.notMem_maximalIdeal.mpr hdu) hdm
  have hγ0m : c * δ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ c hδm
  have hγ : c * δ * δ = b := by
    rw [hd, ← hδ2]; ring

  set v : Fin 2 → ↥W := ![c * δ, δ] with hvdef
  have hvm : ∀ i, v i ∈ IsLocalRing.maximalIdeal ↥W := by
    intro i
    fin_cases i
    · exact hγ0m
    · exact hδm
  have hφ : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b :
      MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval v a = 0 := by
    intro a ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_sub, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, MvPolynomial.eval_C]
    have h0 : v 0 = c * δ := rfl
    have h1 : v 1 = δ := rfl
    rw [h0, h1, hγ, sub_self, mul_zero]
  let g : wcEbntN W b →+* ↥W := Ideal.Quotient.lift _ (MvPolynomial.eval v) hφ
  have hg : ∀ p : MvPolynomial (Fin 2) ↥W,
      g (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C b}) p) = MvPolynomial.eval v p :=
    fun p => Ideal.Quotient.lift_mk _ _ _
  have hXs : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) ↥W) ∈
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro i
    fin_cases i
    · exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hcc : ∀ p : MvPolynomial (Fin 2) ↥W,
      p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ∧
      MvPolynomial.eval v p - MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p p' hp hp' =>
      constructor
      · have e : (p + p') - MvPolynomial.C (MvPolynomial.constantCoeff (p + p')) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (p' - MvPolynomial.C (MvPolynomial.constantCoeff p')) := by
          simp only [map_add]; ring
        rw [e]
        exact Ideal.add_mem _ hp.1 hp'.1
      · have e : MvPolynomial.eval v (p + p') - MvPolynomial.constantCoeff (p + p') =
            (MvPolynomial.eval v p - MvPolynomial.constantCoeff p) +
              (MvPolynomial.eval v p' - MvPolynomial.constantCoeff p') := by
          simp only [map_add]; ring
        rw [e]
        exact Ideal.add_mem _ hp.2 hp'.2
    | mul_X p i hp =>
      constructor
      · have e : p * MvPolynomial.X i -
            MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X i)) =
            p * MvPolynomial.X i := by
          simp
        rw [e]
        exact Ideal.mul_mem_left _ _ (hXs i)
      · have e : MvPolynomial.eval v (p * MvPolynomial.X i) -
            MvPolynomial.constantCoeff (p * MvPolynomial.X i) =
            MvPolynomial.eval v p * v i := by
          simp
        rw [e]
        exact Ideal.mul_mem_left _ _ (hvm i)

  have hgu : ∀ t : wcEbntN W b, IsUnit (g t) ↔ t ∉
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _) :
          Ideal (wcEbntN W b)) := by
    intro t
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
    rw [hg, ← IsLocalRing.notMem_maximalIdeal, not_iff_not]
    constructor
    · intro hp
      have h2 : MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W := by
        have := Ideal.sub_mem _ hp (hcc p).2
        rwa [sub_sub_cancel] at this
      apply Ideal.mem_map_of_mem
      have e : p = (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
          MvPolynomial.C (MvPolynomial.constantCoeff p) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (hcc p).1)
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ h2))
    · intro hp
      have hle : ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _) :
            Ideal (wcEbntN W b)) ≤ (IsLocalRing.maximalIdeal ↥W).comap g := by
        rw [Ideal.map_le_iff_le_comap]
        refine sup_le ?_ ?_
        · rw [Ideal.span_le]
          intro q hq
          rcases hq with rfl | hq
          · rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, hg, MvPolynomial.eval_X]
            exact hvm 0
          · rw [Set.mem_singleton_iff] at hq
            subst hq
            rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, hg, MvPolynomial.eval_X]
            exact hvm 1
        · rw [Ideal.map_le_iff_le_comap]
          intro t ht
          rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, hg, MvPolynomial.eval_C]
          exact ht
      have := hle hp
      rwa [Ideal.mem_comap, hg] at this

  obtain ⟨k, ⟨hk, -⟩, -⟩ := hH.2.2 (↥W) hWH g hgu
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hc
  have hσc : σ c = f (Ideal.Quotient.mk _ (MvPolynomial.C c)) := (RingHom.congr_fun hfσ c).symm
  have hkσ : k (σ c) = c := by
    rw [hσc]
    show (k.comp f) (Ideal.Quotient.mk _ (MvPolynomial.C c)) = c
    rw [hk, hg, MvPolynomial.eval_C]
  have hkx : k (f (wcEbntX W b 0)) = c * δ := by
    show (k.comp f) (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = c * δ
    rw [hk, hg, MvPolynomial.eval_X]
    rfl
  have e1 : k r * (c * δ) = c := by
    rw [← hkx, ← map_mul, hr, hkσ]
  have e2 : c * (k r * δ) = c * 1 := by
    rw [mul_one]
    calc c * (k r * δ) = k r * (c * δ) := by ring
      _ = c := e1
  have e3 : k r * δ = 1 := mul_left_cancel₀ hc0 e2
  have hδu : IsUnit δ := ⟨⟨δ, k r, by rw [mul_comm]; exact e3, e3⟩, rfl⟩
  exact (IsLocalRing.notMem_maximalIdeal.mpr hδu) hδm

theorem wc_rescale_etale_presentation : ∀ (A E : Type u) [CommRing A] [CommRing E] [Algebra A E] [Algebra.Etale A E], ∃ (n : ℕ) (R : Fin n → MvPolynomial (Fin n) A) (ψ : MvPolynomial (Fin n) A →ₐ[A] E), Function.Surjective ψ ∧ RingHom.ker ψ = Ideal.span (Set.range R) ∧ IsUnit (ψ (Matrix.of (fun j i => MvPolynomial.pderiv i (R j))).det) :=
by
  intro A E _ _ _ _
  classical
  have h : Algebra.IsStandardSmoothOfRelativeDimension 0 A E :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
  obtain ⟨ι, σ, hσ, hι, P, hP⟩ := h.out
  letI := Fintype.ofFinite σ
  letI := Fintype.ofFinite ι
  have hdim : Nat.card ι - Nat.card σ = 0 := hP
  have hle : Nat.card σ ≤ Nat.card ι :=
    P.toPreSubmersivePresentation.card_relations_le_card_vars_of_isFinite
  have hbij : Function.Bijective P.map :=
    Function.Injective.bijective_of_nat_card_le P.map_inj (by omega)
  let em : σ ≃ ι := Equiv.ofBijective P.map hbij
  let eσ : σ ≃ Fin (Nat.card σ) := Finite.equivFin σ
  let eι : ι ≃ Fin (Nat.card σ) := em.symm.trans eσ
  have K1 : ∀ s, eι (P.map s) = eσ s := by
    intro s
    show eσ (em.symm (P.map s)) = eσ s
    congr 1
    exact em.symm_apply_eq.mpr rfl
  have K2 : ∀ i, eι (P.map (eσ.symm i)) = i := by
    intro i; rw [K1]; exact eσ.apply_symm_apply i
  let R : Fin (Nat.card σ) → MvPolynomial (Fin (Nat.card σ)) A :=
    fun j => MvPolynomial.rename eι (P.relation (eσ.symm j))
  let ψ : MvPolynomial (Fin (Nat.card σ)) A →ₐ[A] E := MvPolynomial.aeval (P.val ∘ eι.symm)
  have K3 : ∀ p : MvPolynomial ι A, ψ (MvPolynomial.rename eι p) = MvPolynomial.aeval P.val p := by
    intro p
    simp only [ψ, MvPolynomial.aeval_rename]
    have hc : (P.val ∘ ⇑eι.symm) ∘ ⇑eι = P.val := by funext x; simp
    rw [hc]
  have K4 : ∀ x : MvPolynomial (Fin (Nat.card σ)) A,
      MvPolynomial.rename eι (MvPolynomial.rename eι.symm x) = x := by
    intro x
    rw [MvPolynomial.rename_rename]
    have : (⇑eι ∘ ⇑eι.symm) = id := by funext y; simp
    rw [this, MvPolynomial.rename_id_apply]
  have hrelker : ∀ t, MvPolynomial.aeval P.val (P.relation t) = 0 := by
    intro t
    have h1 : P.relation t ∈ P.ker := by
      rw [← P.span_range_relation_eq_ker]
      exact Ideal.subset_span ⟨t, rfl⟩
    rw [P.ker_eq_ker_aeval_val, RingHom.mem_ker] at h1
    exact h1
  refine ⟨Nat.card σ, R, ψ, ?_, ?_, ?_⟩
  · intro e
    refine ⟨MvPolynomial.rename eι (P.σ e), ?_⟩
    rw [K3]
    exact P.aeval_val_σ e
  · apply le_antisymm
    · intro x hx
      rw [RingHom.mem_ker] at hx
      have hx' : MvPolynomial.rename eι.symm x ∈ Ideal.span (Set.range P.relation) := by
        rw [P.span_range_relation_eq_ker, P.ker_eq_ker_aeval_val, RingHom.mem_ker, ← K3, K4]
        exact hx
      have hle' : Ideal.span (Set.range P.relation) ≤
          Ideal.comap (MvPolynomial.rename eι) (Ideal.span (Set.range R)) := by
        rw [Ideal.span_le]
        rintro _ ⟨t, rfl⟩
        refine Ideal.subset_span ⟨eσ t, ?_⟩
        show MvPolynomial.rename eι (P.relation (eσ.symm (eσ t))) = _
        rw [eσ.symm_apply_apply]
      have := hle' hx'
      rw [Ideal.mem_comap, K4] at this
      exact this
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      show ψ (R j) = 0
      exact (K3 _).trans (hrelker _)
  · have hJ : IsUnit (MvPolynomial.aeval P.val P.jacobiMatrix.det) := by
      have := P.jacobian_isUnit
      rw [P.jacobian_eq_jacobiMatrix_det, Algebra.Generators.algebraMap_eq] at this
      exact this
    have hM : (Matrix.of (fun j i => MvPolynomial.pderiv i (R j))) =
        (P.jacobiMatrix.submatrix eσ.symm eσ.symm).transpose.map (MvPolynomial.rename eι) := by
      ext j i
      simp only [Matrix.of_apply, Matrix.map_apply, Matrix.transpose_apply, Matrix.submatrix_apply,
        P.jacobiMatrix_apply, R]
      conv_lhs => rw [← K2 i]
      rw [MvPolynomial.pderiv_rename eι.injective]
    have hdet : ((P.jacobiMatrix.submatrix eσ.symm eσ.symm).transpose.map
        (MvPolynomial.rename eι)).det = MvPolynomial.rename eι P.jacobiMatrix.det := by
      rw [← AlgHom.mapMatrix_apply, ← AlgHom.map_det, Matrix.det_transpose,
        Matrix.det_submatrix_equiv_self]
    rw [hM, hdet, K3]
    exact hJ

theorem wc_rescale_multi_hensel : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] (ι : Type) [Fintype ι] [DecidableEq ι] (F : ι → MvPolynomial ι B) (b₀ : ι → B), (∀ k, MvPolynomial.eval b₀ (F k) ∈ IsLocalRing.maximalIdeal B) → IsUnit (MvPolynomial.eval b₀ (Matrix.of (fun k l => MvPolynomial.pderiv l (F k))).det) → (∃ b : ι → B, (∀ k, MvPolynomial.eval b (F k) = 0) ∧ ∀ l, b l - b₀ l ∈ IsLocalRing.maximalIdeal B) ∧ ∀ b b' : ι → B, (∀ k, MvPolynomial.eval b (F k) = 0) → (∀ k, MvPolynomial.eval b' (F k) = 0) → (∀ l, b l - b₀ l ∈ IsLocalRing.maximalIdeal B) → (∀ l, b' l - b₀ l ∈ IsLocalRing.maximalIdeal B) → b = b' :=
by
  intro B _ _ ι _ _ F b₀ hF hJ
  classical

  have hresE : ∀ y : ι → B, (∀ l, y l - b₀ l ∈ IsLocalRing.maximalIdeal B) →
      ∀ q : MvPolynomial ι B, IsLocalRing.residue B (MvPolynomial.eval y q) =
        IsLocalRing.residue B (MvPolynomial.eval b₀ q) := by
    intro y hy q
    have hyl : ∀ l, IsLocalRing.residue B (y l) = IsLocalRing.residue B (b₀ l) := by
      intro l
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact hy l
    induction q using MvPolynomial.induction_on with
    | C a => simp only [MvPolynomial.eval_C]
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p n hp => simp only [map_mul, MvPolynomial.eval_X, hp, hyl]

  have taylor : ∀ (x h : ι → B), (∀ l, h l ∈ IsLocalRing.maximalIdeal B) →
      ∀ P : MvPolynomial ι B, ∃ c : ι → B,
        MvPolynomial.eval (x + h) P - MvPolynomial.eval x P = ∑ l, c l * h l ∧
        ∀ l, IsLocalRing.residue B (c l) =
          IsLocalRing.residue B (MvPolynomial.eval x (MvPolynomial.pderiv l P)) := by
    intro x h hh P
    induction P using MvPolynomial.induction_on with
    | C a =>
      refine ⟨0, ?_, ?_⟩
      · simp
      · intro l; simp
    | add p q hp hq =>
      obtain ⟨cp, hp1, hp2⟩ := hp
      obtain ⟨cq, hq1, hq2⟩ := hq
      refine ⟨cp + cq, ?_, ?_⟩
      · rw [map_add, map_add]
        have : MvPolynomial.eval (x + h) p + MvPolynomial.eval (x + h) q -
            (MvPolynomial.eval x p + MvPolynomial.eval x q) =
            (MvPolynomial.eval (x + h) p - MvPolynomial.eval x p) +
            (MvPolynomial.eval (x + h) q - MvPolynomial.eval x q) := by ring
        rw [this, hp1, hq1, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        simp only [Pi.add_apply]; ring
      · intro l
        simp only [Pi.add_apply, map_add, hp2, hq2]
    | mul_X p n hp =>
      obtain ⟨c, hc1, hc2⟩ := hp
      refine ⟨fun l => c l * (x n + h n) + (if l = n then MvPolynomial.eval x p else 0), ?_, ?_⟩
      · rw [Finset.sum_congr rfl (fun l _ => show (c l * (x n + h n) +
            (if l = n then MvPolynomial.eval x p else 0)) * h l =
            (x n + h n) * (c l * h l) + (if l = n then MvPolynomial.eval x p * h l else 0) by
              split_ifs <;> ring)]
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← hc1]
        simp only [Finset.sum_ite_eq', Finset.mem_univ, if_true, map_mul, MvPolynomial.eval_X,
          Pi.add_apply]
        ring
      · intro l
        have hn0 : IsLocalRing.residue B (h n) = 0 :=
          (IsLocalRing.residue_eq_zero_iff _).mpr (hh n)
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X]
        by_cases hl : l = n
        · subst hl
          simp only [Pi.single_eq_same, eq_self_iff_true, if_true, map_add, map_mul, map_one,
            mul_one, MvPolynomial.eval_X, hc2, hn0]
          ring
        · simp only [Pi.single_eq_of_ne (Ne.symm hl), hl, if_false, map_add, map_mul, map_zero,
            mul_zero, MvPolynomial.eval_X, hc2, hn0]
          ring

  have huniq : ∀ b b' : ι → B, (∀ k, MvPolynomial.eval b (F k) = 0) →
      (∀ k, MvPolynomial.eval b' (F k) = 0) → (∀ l, b l - b₀ l ∈ IsLocalRing.maximalIdeal B) →
      (∀ l, b' l - b₀ l ∈ IsLocalRing.maximalIdeal B) → b = b' := by
    intro b b' hb hb' hbb hbb'
    have hh : ∀ l, (b' - b) l ∈ IsLocalRing.maximalIdeal B := by
      intro l
      have := Ideal.sub_mem _ (hbb' l) (hbb l)
      rw [sub_sub_sub_cancel_right] at this
      exact this
    choose c hc1 hc2 using fun k => taylor b (b' - b) hh (F k)
    have hbh : b + (b' - b) = b' := add_sub_cancel b b'
    have hC : (Matrix.of c).mulVec (b' - b) = 0 := by
      funext k
      have := hc1 k
      rw [hbh, hb' k, hb k, sub_zero] at this
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply]
      exact this.symm
    have hdet : IsUnit (Matrix.of c).det := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, RingHom.map_det]
      have e : (IsLocalRing.residue B).mapMatrix (Matrix.of c) =
          (IsLocalRing.residue B).mapMatrix ((MvPolynomial.eval b₀).mapMatrix
            (Matrix.of (fun k l => MvPolynomial.pderiv l (F k)))) := by
        ext k l
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
        rw [hc2, hresE b hbb]
      rw [e, ← RingHom.map_det, ← RingHom.map_det, IsLocalRing.residue_ne_zero_iff_isUnit]
      exact hJ
    have h0 : b' - b = 0 := by
      have := congrArg (Matrix.of c)⁻¹.mulVec hC
      rwa [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hdet, Matrix.one_mulVec,
        Matrix.mulVec_zero] at this
    rw [← hbh, h0, add_zero]
  refine ⟨?_, huniq⟩

  set Δ := (Matrix.of (fun k l => MvPolynomial.pderiv l (F k))).det with hΔ
  set v : Unit ⊕ ι → MvPolynomial (Unit ⊕ ι) B := Sum.elim
    (fun _ : Unit => MvPolynomial.X (Sum.inl ()) * MvPolynomial.rename Sum.inr Δ - 1)
    (fun k => MvPolynomial.rename Sum.inr (F k)) with hv
  set I : Ideal (MvPolynomial (Unit ⊕ ι) B) := Ideal.span (Set.range v) with hI

  have hEt : Algebra.Etale B (MvPolynomial (Unit ⊕ ι) B ⧸ I) := by
    let P : Algebra.PreSubmersivePresentation B (MvPolynomial (Unit ⊕ ι) B ⧸ Ideal.span (Set.range v))
      (Unit ⊕ ι) (Unit ⊕ ι) := Algebra.PreSubmersivePresentation.naive (v := v) id Function.injective_id
    have hrel : ∀ j, P.relation j = v j := fun j => rfl
    have hmap : ∀ i, P.map i = i := fun i => rfl
    have hz : ∀ p : MvPolynomial ι B, MvPolynomial.pderiv (Sum.inl () : Unit ⊕ ι)
        (MvPolynomial.rename Sum.inr p) = 0 := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
      | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
      | mul_X p n hp =>
        rw [map_mul, MvPolynomial.pderiv_mul, hp, MvPolynomial.rename_X, MvPolynomial.pderiv_X,
          Pi.single_eq_of_ne (Sum.inr_ne_inl), zero_mul, mul_zero, add_zero]
    have hblock : P.jacobiMatrix = Matrix.fromBlocks
        (Matrix.of (fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inr Δ)) 0
        (Matrix.of (fun (l : ι) (_ : Unit) => MvPolynomial.pderiv (Sum.inr l) (v (Sum.inl ()))))
        (Matrix.of (fun (l k : ι) => MvPolynomial.rename Sum.inr (MvPolynomial.pderiv l (F k)))) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply, hmap, hrel]
      rcases i with ⟨⟩ | l <;> rcases j with ⟨⟩ | k
      · simp only [Matrix.fromBlocks_apply₁₁, Matrix.of_apply, v, Sum.elim_inl, map_sub,
          MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, hz, Pi.single_eq_same, one_mul,
          mul_zero, add_zero]
        simp
      · simp only [Matrix.fromBlocks_apply₁₂, Matrix.zero_apply, v, Sum.elim_inr, hz]
      · simp only [Matrix.fromBlocks_apply₂₁, Matrix.of_apply]
      · simp only [Matrix.fromBlocks_apply₂₂, Matrix.of_apply, v, Sum.elim_inr,
          MvPolynomial.pderiv_rename Sum.inr_injective]
    have hJd : P.jacobiMatrix.det = (MvPolynomial.rename Sum.inr Δ) ^ 2 := by
      rw [hblock, Matrix.det_fromBlocks_zero₁₂, Matrix.det_unique, Matrix.of_apply, sq]
      congr 1
      rw [hΔ, AlgHom.map_det, ← Matrix.det_transpose]
      congr 1
    have hh : (MvPolynomial.aeval P.val : MvPolynomial (Unit ⊕ ι) B →ₐ[B] _) =
        Ideal.Quotient.mkₐ B (Ideal.span (Set.range v)) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [MvPolynomial.aeval_X]
      rfl
    have halg : ∀ p, algebraMap P.Ring _ p = Ideal.Quotient.mk (Ideal.span (Set.range v)) p := by
      intro p
      rw [Algebra.Generators.algebraMap_eq, hh]
      rfl
    have hunit : IsUnit P.jacobian := by
      rw [P.jacobian_eq_jacobiMatrix_det, hJd, halg, map_pow]
      apply IsUnit.pow
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl ())), ?_⟩
      rw [← map_mul, mul_comm, ← sub_eq_zero, ← map_one (Ideal.Quotient.mk _), ← map_sub,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨Sum.inl (), rfl⟩
    let Ps : Algebra.SubmersivePresentation B _ (Unit ⊕ ι) (Unit ⊕ ι) := ⟨P, hunit⟩
    have : Algebra.IsStandardSmoothOfRelativeDimension 0 B
        (MvPolynomial (Unit ⊕ ι) B ⧸ Ideal.span (Set.range v)) :=
      Ps.isStandardSmoothOfRelativeDimension (by simp [Algebra.Presentation.dimension])
    infer_instance

  have s3 : ∀ (S' : Type u) [CommRing S'] [Algebra B S'] [Algebra.IsStandardEtale B S']
      (ρ : S' →ₐ[B] IsLocalRing.ResidueField B),
      ∃ τ : S' →ₐ[B] B, ∀ s, IsLocalRing.residue B (τ s) = ρ s := by
    intro S' _ _ _ ρ
    obtain ⟨P⟩ := Algebra.IsStandardEtale.nonempty_standardEtalePresentation (R := B) (S := S')
    obtain ⟨hx0, hxu⟩ := P.hasMap
    have h1 : Polynomial.aeval (ρ P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, hx0, map_zero]
    have h2 : IsUnit (Polynomial.aeval (ρ P.x) P.g) := by
      rw [Polynomial.aeval_algHom_apply]; exact hxu.map ρ
    obtain ⟨p₁, p₂, n, hc⟩ := P.cond
    have h3 : Polynomial.aeval (ρ P.x) (Polynomial.derivative P.f) ≠ 0 := by
      intro h
      have := congrArg (Polynomial.aeval (ρ P.x)) hc
      simp only [map_add, map_mul, map_pow, h, h1, zero_mul, add_zero] at this
      exact (h2.pow n).ne_zero this.symm
    have hT : ∀ (f : Polynomial B), f.Monic → ∀ (a₀ : IsLocalRing.ResidueField B),
        Polynomial.aeval a₀ f = 0 → Polynomial.aeval a₀ (Polynomial.derivative f) ≠ 0 →
        ∃ a, f.IsRoot a ∧ IsLocalRing.residue B a = a₀ :=
      ((HenselianLocalRing.TFAE B).out 1 2).mp (inferInstance : HenselianLocalRing B)
    obtain ⟨a, ha, har⟩ := hT P.f P.monic_f (ρ P.x) h1 h3
    have hres : ∀ q : Polynomial B, IsLocalRing.residue B (Polynomial.aeval a q) =
        Polynomial.aeval (IsLocalRing.residue B a) q := by
      intro q
      have := Polynomial.aeval_algHom_apply (Algebra.ofId B (IsLocalRing.ResidueField B)) a q
      exact this.symm
    have hHas : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]; exact ha
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres, har]; exact h2.ne_zero
    let e := AlgEquiv.ofBijective (P.lift P.x P.hasMap) P.lift_bijective
    refine ⟨(P.lift a hHas).comp e.symm.toAlgHom, ?_⟩
    intro s
    obtain ⟨r, rfl⟩ := e.surjective s
    have key : (Algebra.ofId B (IsLocalRing.ResidueField B)).comp (P.lift a hHas) =
        ρ.comp (P.lift P.x P.hasMap) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, StandardEtalePair.lift_X]
      exact har
    have := AlgHom.congr_fun key r
    simp only [AlgHom.comp_apply] at this
    have hsr : e.symm (e r) = r := e.symm_apply_apply r
    show IsLocalRing.residue B ((P.lift a hHas) (e.symm (e r))) = ρ (e r)
    rw [hsr]
    exact this

  have s4 : ∀ (S : Type u) [CommRing S] [Algebra B S] [Algebra.Etale B S]
      (ρ : S →ₐ[B] IsLocalRing.ResidueField B),
      ∃ τ : S →ₐ[B] B, ∀ s, IsLocalRing.residue B (τ s) = ρ s := by
    intro S _ _ _ ρ
    have : (RingHom.ker ρ).IsPrime := RingHom.ker_isPrime _
    obtain ⟨f, hf, hstdf⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := B) (RingHom.ker ρ)
    have hu : IsUnit (ρ f) := by
      rw [isUnit_iff_ne_zero]; intro h; exact hf (RingHom.mem_ker.mpr h)
    obtain ⟨τ', hτ'⟩ := s3 (Localization.Away f) (IsLocalization.Away.liftAlgHom f hu)
    refine ⟨τ'.comp (IsScalarTower.toAlgHom B S (Localization.Away f)), fun s => ?_⟩
    rw [AlgHom.comp_apply, hτ', IsLocalization.Away.liftAlgHom_apply, IsScalarTower.coe_toAlgHom',
      IsLocalization.Away.lift_eq]
    rfl

  set δ := IsLocalRing.residue B (MvPolynomial.eval b₀ Δ) with hδ
  have hδ0 : δ ≠ 0 := by
    rw [hδ, IsLocalRing.residue_ne_zero_iff_isUnit]; exact hJ
  let ρ₀ : MvPolynomial (Unit ⊕ ι) B →ₐ[B] IsLocalRing.ResidueField B :=
    MvPolynomial.aeval (Sum.elim (fun _ => δ⁻¹) (fun l => IsLocalRing.residue B (b₀ l)))
  have hρ₀r : ∀ p : MvPolynomial ι B, ρ₀ (MvPolynomial.rename Sum.inr p) =
      IsLocalRing.residue B (MvPolynomial.eval b₀ p) := by
    intro p
    simp only [ρ₀, MvPolynomial.aeval_rename]
    induction p using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.aeval_C, MvPolynomial.eval_C]; rfl
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p n hp => simp only [map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.eval_X,
        Function.comp_apply, Sum.elim_inr]
  have hker : ∀ a ∈ I, ρ₀ a = 0 := by
    have hle : I ≤ RingHom.ker ρ₀ := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      rcases j with ⟨⟩ | k
      · simp only [v, Sum.elim_inl, map_sub, map_mul, map_one, hρ₀r]
        rw [MvPolynomial.aeval_X, Sum.elim_inl, ← hδ, inv_mul_cancel₀ hδ0, sub_self]
      · simp only [v, Sum.elim_inr, hρ₀r]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr (hF k)
    intro a ha
    exact RingHom.mem_ker.mp (hle ha)
  let ρ : (MvPolynomial (Unit ⊕ ι) B ⧸ I) →ₐ[B] IsLocalRing.ResidueField B :=
    Ideal.Quotient.liftₐ I ρ₀ hker
  obtain ⟨τ, hτ⟩ := s4 _ ρ
  let τt := τ.comp (Ideal.Quotient.mkₐ B I)
  let b : ι → B := fun l => τt (MvPolynomial.X (Sum.inr l))
  have hτr : ∀ p : MvPolynomial ι B, τt (MvPolynomial.rename Sum.inr p) = MvPolynomial.eval b p := by
    intro p
    have e : τt.comp (MvPolynomial.rename Sum.inr) = MvPolynomial.aeval b := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, MvPolynomial.rename_X, MvPolynomial.aeval_X, b]
    rw [← MvPolynomial.coe_aeval_eq_eval, ← e]
    rfl
  refine ⟨b, fun k => ?_, fun l => ?_⟩
  · rw [← hτr]
    show τ (Ideal.Quotient.mk I (v (Sum.inr k))) = 0
    have hmem : v (Sum.inr k) ∈ I := Ideal.subset_span (Set.mem_range_self (Sum.inr k))
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
  · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
    show IsLocalRing.residue B (τ (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr l)))) = _
    rw [hτ]
    show ρ₀ (MvPolynomial.X (Sum.inr l)) = _
    rw [MvPolynomial.aeval_X, Sum.elim_inr]

theorem wc_rescale_twisted_system : ∀ (S₀ B : Type u) [CommRing S₀] [CommRing B] [IsLocalRing B] (γ : S₀ →+* B) (u₀ u₁ : B), u₀ ∈ IsLocalRing.maximalIdeal B → u₁ ∈ IsLocalRing.maximalIdeal B → ∀ (n : ℕ) (R : Fin n → MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)) (ê : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)), ∃ F : Fin n ⊕ Fin 2 → MvPolynomial (Fin n ⊕ Fin 2) B, (∀ (v : Fin n ⊕ Fin 2 → B) (j : Fin n), MvPolynomial.eval v (F (Sum.inl j)) = MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![v (Sum.inr 1) * u₀, v (Sum.inr 0) * u₁]) (v ∘ Sum.inl) (R j)) ∧ (∀ v : Fin n ⊕ Fin 2 → B, MvPolynomial.eval v (F (Sum.inr 0)) = v (Sum.inr 0) - MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![v (Sum.inr 1) * u₀, v (Sum.inr 0) * u₁]) (v ∘ Sum.inl) ê) ∧ (∀ v : Fin n ⊕ Fin 2 → B, MvPolynomial.eval v (F (Sum.inr 1)) = v (Sum.inr 0) * v (Sum.inr 1) - 1) ∧ (∀ (v : Fin n ⊕ Fin 2 → B) (q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)), IsLocalRing.residue B (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![v (Sum.inr 1) * u₀, v (Sum.inr 0) * u₁]) (v ∘ Sum.inl) q) = IsLocalRing.residue B (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![u₀, u₁]) (v ∘ Sum.inl) q)) ∧ (∀ v : Fin n ⊕ Fin 2 → B, IsLocalRing.residue B (MvPolynomial.eval v (Matrix.of (fun k l => MvPolynomial.pderiv l (F k))).det) = IsLocalRing.residue B (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![u₀, u₁]) (v ∘ Sum.inl) (Matrix.of (fun j i => MvPolynomial.pderiv i (R j))).det) * IsLocalRing.residue B (v (Sum.inr 0))) :=
by
  intro S₀ B _ _ _ γ u₀ u₁ hu₀ hu₁ n R ê

  have hs1 : ∀ (v : Fin n ⊕ Fin 2 → B) (q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)),
      MvPolynomial.eval v (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom ((MvPolynomial.C : B →+* MvPolynomial (Fin n ⊕ Fin 2) B).comp γ) ![MvPolynomial.X (Sum.inr 1) * MvPolynomial.C u₀, MvPolynomial.X (Sum.inr 0) * MvPolynomial.C u₁]) (fun i => MvPolynomial.X (Sum.inl i)) q) = MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![v (Sum.inr 1) * u₀, v (Sum.inr 0) * u₁]) (v ∘ Sum.inl) q := by
    intro v q
    rw [MvPolynomial.eval₂_comp_left]
    congr 1
    · apply MvPolynomial.ringHom_ext
      · intro s; simp
      · intro i; fin_cases i <;> simp
    · funext i; simp

  have hs2 : ∀ (a₀ a₁ : B), a₀ - u₀ ∈ IsLocalRing.maximalIdeal B →
      a₁ - u₁ ∈ IsLocalRing.maximalIdeal B → ∀ (w : Fin n → B)
      (q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)),
      IsLocalRing.residue B (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![a₀, a₁]) w q) = IsLocalRing.residue B (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom γ ![u₀, u₁]) w q) := by
    intro a₀ a₁ h0 h1 w q
    rw [MvPolynomial.eval₂_comp_left, MvPolynomial.eval₂_comp_left]
    congr 1
    have e0 : IsLocalRing.residue B a₀ = IsLocalRing.residue B u₀ := by
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact h0
    have e1 : IsLocalRing.residue B a₁ = IsLocalRing.residue B u₁ := by
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact h1
    apply MvPolynomial.ringHom_ext
    · intro s; simp
    · intro i; fin_cases i <;> simp [e0, e1]
  have hr0 : IsLocalRing.residue B u₀ = 0 := (IsLocalRing.residue_eq_zero_iff u₀).mpr hu₀
  have hr1 : IsLocalRing.residue B u₁ = 0 := (IsLocalRing.residue_eq_zero_iff u₁).mpr hu₁

  have hs3 : ∀ (q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)),
      MvPolynomial.map (IsLocalRing.residue B) (MvPolynomial.eval₂ (MvPolynomial.eval₂Hom ((MvPolynomial.C : B →+* MvPolynomial (Fin n ⊕ Fin 2) B).comp γ) ![MvPolynomial.X (Sum.inr 1) * MvPolynomial.C u₀, MvPolynomial.X (Sum.inr 0) * MvPolynomial.C u₁]) (fun i => MvPolynomial.X (Sum.inl i)) q) = MvPolynomial.rename (Sum.inl : Fin n → Fin n ⊕ Fin 2) (MvPolynomial.map ((IsLocalRing.residue B).comp (MvPolynomial.eval₂Hom γ ![u₀, u₁])) q) := by
    intro q
    have key : (MvPolynomial.map (IsLocalRing.residue B)).comp (MvPolynomial.eval₂Hom ((MvPolynomial.C : B →+* MvPolynomial (Fin n ⊕ Fin 2) B).comp γ) ![MvPolynomial.X (Sum.inr 1) * MvPolynomial.C u₀, MvPolynomial.X (Sum.inr 0) * MvPolynomial.C u₁]) = (MvPolynomial.C : IsLocalRing.ResidueField B →+* MvPolynomial (Fin n ⊕ Fin 2) (IsLocalRing.ResidueField B)).comp ((IsLocalRing.residue B).comp (MvPolynomial.eval₂Hom γ ![u₀, u₁])) := by
      apply MvPolynomial.ringHom_ext
      · intro s; simp
      · intro i; fin_cases i <;> simp [hr0, hr1]
    have key2 : (MvPolynomial.map (IsLocalRing.residue B)).comp (MvPolynomial.eval₂Hom (MvPolynomial.eval₂Hom ((MvPolynomial.C : B →+* MvPolynomial (Fin n ⊕ Fin 2) B).comp γ) ![MvPolynomial.X (Sum.inr 1) * MvPolynomial.C u₀, MvPolynomial.X (Sum.inr 0) * MvPolynomial.C u₁]) (fun i => MvPolynomial.X (Sum.inl i))) = (MvPolynomial.rename (Sum.inl : Fin n → Fin n ⊕ Fin 2)).toRingHom.comp (MvPolynomial.map ((IsLocalRing.residue B).comp (MvPolynomial.eval₂Hom γ ![u₀, u₁]))) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        refine (RingHom.congr_fun key c).trans ?_
        show MvPolynomial.C _ = MvPolynomial.rename Sum.inl (MvPolynomial.map _ (MvPolynomial.C c))
        rw [MvPolynomial.map_C, MvPolynomial.rename_C]
      · intro i; simp
    exact RingHom.congr_fun key2 q

  have hs5 : ∀ (R' : Type u) [CommRing R'] (φ : R' →+* IsLocalRing.ResidueField B) (ι : Type)
      [Fintype ι] [DecidableEq ι] (G : ι → MvPolynomial ι R'),
      MvPolynomial.map φ (Matrix.of (fun k l => MvPolynomial.pderiv l (G k))).det = (Matrix.of (fun k l => MvPolynomial.pderiv l (MvPolynomial.map φ (G k)))).det := by
    intro R' _ φ ι _ _ G
    rw [RingHom.map_det]
    congr 1
    ext k l
    simp [MvPolynomial.pderiv_map]

  have hren : ∀ (p : MvPolynomial (Fin n) (IsLocalRing.ResidueField B)) (i : Fin 2),
      MvPolynomial.pderiv (Sum.inr i : Fin n ⊕ Fin 2) (MvPolynomial.rename Sum.inl p) = 0 := by
    intro p i
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq => simp [hp, hq]
    | mul_X p m hp => simp [hp, MvPolynomial.pderiv_X]
  have hblk : ∀ (M : Matrix (Fin n ⊕ Fin 2) (Fin n ⊕ Fin 2) (IsLocalRing.ResidueField B)),
      M.toBlocks₁₂ = 0 → M.det = M.toBlocks₁₁.det * M.toBlocks₂₂.det := by
    intro M h
    conv_lhs => rw [← Matrix.fromBlocks_toBlocks M, h]
    exact Matrix.det_fromBlocks_zero₁₂ _ _ _

  have hs4 : ∀ (G : Fin n → MvPolynomial (Fin n) (IsLocalRing.ResidueField B))
      (e : MvPolynomial (Fin n) (IsLocalRing.ResidueField B))
      (w : Fin n ⊕ Fin 2 → IsLocalRing.ResidueField B)
      (H : Fin n ⊕ Fin 2 → MvPolynomial (Fin n ⊕ Fin 2) (IsLocalRing.ResidueField B)),
      (∀ j, H (Sum.inl j) = MvPolynomial.rename Sum.inl (G j)) →
      H (Sum.inr 0) = MvPolynomial.X (Sum.inr 0) - MvPolynomial.rename Sum.inl e →
      H (Sum.inr 1) = MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1 →
      MvPolynomial.eval w (Matrix.of (fun k l => MvPolynomial.pderiv l (H k))).det = MvPolynomial.eval (w ∘ Sum.inl) (Matrix.of (fun j i => MvPolynomial.pderiv i (G j))).det * w (Sum.inr 0) := by
    intro G e w H hl h0 h1
    rw [RingHom.map_det, RingHom.map_det, hblk]
    · congr 1
      · congr 1
        ext j i
        simp [Matrix.toBlocks₁₁, hl, MvPolynomial.pderiv_rename Sum.inl_injective,
          MvPolynomial.eval_rename]
      · rw [Matrix.det_fin_two]
        simp [Matrix.toBlocks₂₂, h0, h1, hren, MvPolynomial.pderiv_X]
    · ext j i
      simp [Matrix.toBlocks₁₂, hl, hren]

  refine ⟨Sum.elim (fun j => MvPolynomial.eval₂ (MvPolynomial.eval₂Hom ((MvPolynomial.C : B →+* MvPolynomial (Fin n ⊕ Fin 2) B).comp γ) ![MvPolynomial.X (Sum.inr 1) * MvPolynomial.C u₀, MvPolynomial.X (Sum.inr 0) * MvPolynomial.C u₁]) (fun i => MvPolynomial.X (Sum.inl i)) (R j))
    ![MvPolynomial.X (Sum.inr 0) - MvPolynomial.eval₂ (MvPolynomial.eval₂Hom ((MvPolynomial.C : B →+* MvPolynomial (Fin n ⊕ Fin 2) B).comp γ) ![MvPolynomial.X (Sum.inr 1) * MvPolynomial.C u₀, MvPolynomial.X (Sum.inr 0) * MvPolynomial.C u₁]) (fun i => MvPolynomial.X (Sum.inl i)) ê,
      MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1], ?_, ?_, ?_, ?_, ?_⟩
  · intro v j
    exact hs1 v (R j)
  · intro v
    simp only [Sum.elim_inr, Matrix.cons_val_zero, map_sub, MvPolynomial.eval_X]
    rw [hs1 v ê]
  · intro v
    simp
  · intro v q
    exact hs2 _ _ (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hu₀) hu₀)
      (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hu₁) hu₁) (v ∘ Sum.inl) q
  · intro v
    have ha : ∀ P : MvPolynomial (Fin n ⊕ Fin 2) B, IsLocalRing.residue B (MvPolynomial.eval v P)
        = MvPolynomial.eval (IsLocalRing.residue B ∘ v) (MvPolynomial.map (IsLocalRing.residue B) P) := by
      intro P
      rw [MvPolynomial.eval_map]
      exact MvPolynomial.eval₂_comp_left (IsLocalRing.residue B) (RingHom.id B) v P
    rw [ha, hs5]
    refine (hs4
      (fun j => MvPolynomial.map ((IsLocalRing.residue B).comp (MvPolynomial.eval₂Hom γ ![u₀, u₁])) (R j))
      (MvPolynomial.map ((IsLocalRing.residue B).comp (MvPolynomial.eval₂Hom γ ![u₀, u₁])) ê)
      (IsLocalRing.residue B ∘ v) _ ?_ ?_ ?_).trans ?_
    · intro j
      exact hs3 (R j)
    · simp only [Sum.elim_inr, Matrix.cons_val_zero, map_sub, MvPolynomial.map_X]
      rw [hs3 ê]
    · simp
    · rw [← hs5, MvPolynomial.eval_map, MvPolynomial.eval₂_comp_left]
      rfl

theorem wcpa_dj_lr1k_ebnt_rescale : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P), wcEbntPres W σ a f → ∀ η η' : P, η * η' = 1 → ∃ f' : wcEbntN W a →+* P, wcEbntPres W σ a f' ∧ f' (wcEbntX W a 0) = η * f (wcEbntX W a 0) ∧ f' (wcEbntX W a 1) = η' * f (wcEbntX W a 1) :=
by
  intro Ω _ W P _ σ a f hf η η' hηη'
  obtain ⟨ha, ha0, hfσ, hfH⟩ := hf
  have hfH2 := hfH
  obtain ⟨hPH, hfU, hUP⟩ := hfH2
  haveI := hPH
  obtain ⟨mk, hmk⟩ : ∃ mk : MvPolynomial (Fin 2) ↥W →+* wcEbntN W a,
      mk = Ideal.Quotient.mk _ := ⟨_, rfl⟩
  have hmks : Function.Surjective mk := by rw [hmk]; exact Ideal.Quotient.mk_surjective
  have hmkX : ∀ i, mk (MvPolynomial.X i) = wcEbntX W a i := by intro i; rw [hmk]
  have hfσ' : f.comp (mk.comp MvPolynomial.C) = σ := by rw [hmk]; exact hfσ
  have hrel : wcEbntX W a 0 * wcEbntX W a 1 = mk (MvPolynomial.C a) := by
    have h : (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C a : MvPolynomial (Fin 2) ↥W)})) (MvPolynomial.X 0 * MvPolynomial.X 1) =
        Ideal.Quotient.mk _ (MvPolynomial.C a) :=
      Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
    rw [map_mul] at h
    rw [hmk]; exact h
  have hX0𝔪 : wcEbntX W a 0 ∈ ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) : Ideal (wcEbntN W a)) :=
    Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
  have hX1𝔪 : wcEbntX W a 1 ∈ ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) : Ideal (wcEbntN W a)) :=
    Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span
      (Set.mem_insert_of_mem _ (Set.mem_singleton _))))

  have hext : ∀ (B : Type u) [CommRing B] (g₁ g₂ : wcEbntN W a →+* B),
      g₁.comp (mk.comp MvPolynomial.C) = g₂.comp (mk.comp MvPolynomial.C) →
      g₁ (wcEbntX W a 0) = g₂ (wcEbntX W a 0) → g₁ (wcEbntX W a 1) = g₂ (wcEbntX W a 1) →
      g₁ = g₂ := by
    intro B _ g₁ g₂ hC h0 h1
    have h : g₁.comp mk = g₂.comp mk := by
      apply MvPolynomial.ringHom_ext
      · intro r; exact RingHom.congr_fun hC r
      · intro i
        fin_cases i
        · exact (congrArg g₁ (hmkX 0)).trans (h0.trans (congrArg g₂ (hmkX 0)).symm)
        · exact (congrArg g₁ (hmkX 1)).trans (h1.trans (congrArg g₂ (hmkX 1)).symm)
    rw [hmk] at h
    exact Ideal.Quotient.ringHom_ext h

  have htw : ∀ (B : Type u) [CommRing B] (g : wcEbntN W a →+* B) (c₀ c₁ : B), c₀ * c₁ = 1 →
      ∃ g' : wcEbntN W a →+* B,
        g'.comp (mk.comp MvPolynomial.C) = g.comp (mk.comp MvPolynomial.C) ∧
        g' (wcEbntX W a 0) = c₀ * g (wcEbntX W a 0) ∧
        g' (wcEbntX W a 1) = c₁ * g (wcEbntX W a 1) := by
    intro B _ g c₀ c₁ hc
    let φ₀ : MvPolynomial (Fin 2) ↥W →+* B := MvPolynomial.eval₂Hom
      (g.comp (mk.comp MvPolynomial.C)) ![c₀ * g (wcEbntX W a 0), c₁ * g (wcEbntX W a 1)]
    have hker : RingHom.ker mk ≤ RingHom.ker φ₀ := by
      rw [hmk, Ideal.mk_ker, Ideal.span_le]
      rintro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      rw [SetLike.mem_coe, RingHom.mem_ker]
      have key : g (wcEbntX W a 0) * g (wcEbntX W a 1) = g (mk (MvPolynomial.C a)) := by
        rw [← map_mul, hrel]
      simp only [φ₀, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        RingHom.comp_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      linear_combination (g (wcEbntX W a 0) * g (wcEbntX W a 1)) * hc + key
    refine ⟨RingHom.liftOfSurjective mk hmks ⟨φ₀, hker⟩, ?_, ?_, ?_⟩
    · apply RingHom.ext; intro r
      simp only [RingHom.comp_apply]
      rw [RingHom.liftOfSurjective_comp_apply]
      simp [φ₀]
    · rw [← hmkX 0, RingHom.liftOfSurjective_comp_apply]
      simp [φ₀, hmkX]
    · rw [← hmkX 1, RingHom.liftOfSurjective_comp_apply]
      simp [φ₀, hmkX]
  have hUnitRes : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (x y : B),
      IsLocalRing.residue B x = IsLocalRing.residue B y → (IsUnit x ↔ IsUnit y) := by
    intro B _ _ x y h
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, h, IsLocalRing.residue_ne_zero_iff_isUnit]

  have hUT : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (g₁ g₂ : wcEbntN W a →+* B),
      g₁.comp (mk.comp MvPolynomial.C) = g₂.comp (mk.comp MvPolynomial.C) →
      g₁ (wcEbntX W a 0) ∈ IsLocalRing.maximalIdeal B → g₂ (wcEbntX W a 0) ∈ IsLocalRing.maximalIdeal B →
      g₁ (wcEbntX W a 1) ∈ IsLocalRing.maximalIdeal B → g₂ (wcEbntX W a 1) ∈ IsLocalRing.maximalIdeal B →
      ∀ t, IsLocalRing.residue B (g₁ t) = IsLocalRing.residue B (g₂ t) := by
    intro B _ _ g₁ g₂ hC h10 h20 h11 h21 t
    have h := hext (IsLocalRing.ResidueField B) ((IsLocalRing.residue B).comp g₁)
      ((IsLocalRing.residue B).comp g₂)
      (by rw [RingHom.comp_assoc, RingHom.comp_assoc, hC])
      (by
        simp only [RingHom.comp_apply]
        rw [(IsLocalRing.residue_eq_zero_iff _).mpr h10, (IsLocalRing.residue_eq_zero_iff _).mpr h20])
      (by
        simp only [RingHom.comp_apply]
        rw [(IsLocalRing.residue_eq_zero_iff _).mpr h11, (IsLocalRing.residue_eq_zero_iff _).mpr h21])
    exact RingHom.congr_fun h t

  have hres : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (k₁ k₂ : P →+* B),
      IsLocalHom k₁ → IsLocalHom k₂ →
      (∀ t, IsLocalRing.residue B (k₁ (f t)) = IsLocalRing.residue B (k₂ (f t))) →
      ∀ z, IsLocalRing.residue B (k₁ z) = IsLocalRing.residue B (k₂ z) := by
    intro B _ _ k₁ k₂ hk₁ hk₂ hk z
    haveI := hk₁
    haveI := hk₂
    obtain ⟨h, -, huniq⟩ := hUP (IsLocalRing.ResidueField B) inferInstance
      ((IsLocalRing.residue B).comp (k₁.comp f)) (fun t => by
        rw [RingHom.comp_apply, RingHom.comp_apply, isUnit_map_iff (IsLocalRing.residue B),
          isUnit_map_iff k₁]
        exact hfU t)
    have e1 := huniq ((IsLocalRing.residue B).comp k₁) ⟨rfl, RingHom.isLocalHom_comp _ _⟩
    have e2 := huniq ((IsLocalRing.residue B).comp k₂)
      ⟨RingHom.ext fun t => (hk t).symm, RingHom.isLocalHom_comp _ _⟩
    exact RingHom.congr_fun (e1.trans e2.symm) z

  obtain ⟨f', hf'C, hf'0, hf'1⟩ := htw P f η η' hηη'
  have hx0 : f (wcEbntX W a 0) ∈ IsLocalRing.maximalIdeal P :=
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (fun h => (hfU _).mp h hX0𝔪))
  have hx1 : f (wcEbntX W a 1) ∈ IsLocalRing.maximalIdeal P :=
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (fun h => (hfU _).mp h hX1𝔪))
  refine ⟨f', ?_, hf'0, hf'1⟩
  show _ ∧ _ ∧ _ ∧ _
  refine ⟨ha, ha0, ?_, ?_⟩
  · have : f'.comp (mk.comp MvPolynomial.C) = σ := hf'C.trans hfσ'
    rw [hmk] at this; exact this
  show _ ∧ _ ∧ _
  refine ⟨hPH, ?_, ?_⟩
  · intro t
    refine (hUnitRes P _ _ (hUT P f' f hf'C (by rw [hf'0]; exact Ideal.mul_mem_left _ _ hx0) hx0
      (by rw [hf'1]; exact Ideal.mul_mem_left _ _ hx1) hx1 t)).trans (hfU t)

  intro B _ hBH g hg
  haveI := hBH
  have hu0 : g (wcEbntX W a 0) ∈ IsLocalRing.maximalIdeal B :=
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (fun h => (hg _).mp h hX0𝔪))
  have hu1 : g (wcEbntX W a 1) ∈ IsLocalRing.maximalIdeal B :=
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (fun h => (hg _).mp h hX1𝔪))
  have hresEq : ∀ x y : B, x - y ∈ IsLocalRing.maximalIdeal B ↔
      IsLocalRing.residue B x = IsLocalRing.residue B y := by
    intro x y
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
  obtain ⟨h₁, ⟨hh₁f, hh₁l⟩, -⟩ := hUP B hBH g hg
  have hΘ : ∀ (g' : wcEbntN W a →+* B) (d₀ d₁ : B),
      g'.comp (mk.comp MvPolynomial.C) = g.comp (mk.comp MvPolynomial.C) →
      g' (wcEbntX W a 0) = d₀ → g' (wcEbntX W a 1) = d₁ →
      MvPolynomial.eval₂Hom (g.comp (mk.comp MvPolynomial.C)) ![d₀, d₁] = g'.comp mk := by
    intro g' d₀ d₁ hC h0 h1
    apply MvPolynomial.ringHom_ext
    · intro r; rw [MvPolynomial.eval₂Hom_C]; exact (RingHom.congr_fun hC r).symm
    · intro i; rw [MvPolynomial.eval₂Hom_X']
      fin_cases i
      · exact h0.symm.trans (congrArg g' (hmkX 0)).symm
      · exact h1.symm.trans (congrArg g' (hmkX 1)).symm

  obtain ⟨E, iE, iAE, iEt, φ, hφ, hηr⟩ := wcNd_hne_etale_approx (wcEbntN W a) _ P f hfH {η}
  obtain ⟨e₀, he₀⟩ := RingHom.mem_range.mp (hηr η (Finset.mem_singleton_self η))
  obtain ⟨n, R, ψ, hψs, hψk, hψJ⟩ := wc_rescale_etale_presentation (wcEbntN W a) E
  obtain ⟨et, het⟩ := hψs e₀
  obtain ⟨ê, hê⟩ := MvPolynomial.map_surjective mk hmks et
  choose Rh hRh using fun j => MvPolynomial.map_surjective mk hmks (R j)
  obtain ⟨F, hF1, hF2, hF3, hF4, hF5⟩ := wc_rescale_twisted_system (↥W) B
    (g.comp (mk.comp MvPolynomial.C)) (g (wcEbntX W a 0)) (g (wcEbntX W a 1)) hu0 hu1 n Rh ê

  have hstar : ∀ (k : P →+* B) (d₀ d₁ : B),
      (k.comp f).comp (mk.comp MvPolynomial.C) = g.comp (mk.comp MvPolynomial.C) →
      k (f (wcEbntX W a 0)) = d₀ → k (f (wcEbntX W a 1)) = d₁ →
      ∀ q, MvPolynomial.eval₂ (MvPolynomial.eval₂Hom (g.comp (mk.comp MvPolynomial.C)) ![d₀, d₁])
        (fun i => k (φ (ψ (MvPolynomial.X i)))) q = k (φ (ψ (MvPolynomial.map mk q))) := by
    intro k d₀ d₁ hC h0 h1 q
    rw [hΘ (k.comp f) d₀ d₁ hC h0 h1]
    have hh : MvPolynomial.eval₂Hom ((k.comp f).comp mk) (fun i => k (φ (ψ (MvPolynomial.X i)))) =
        (k.comp φ).comp ((ψ : MvPolynomial (Fin n) (wcEbntN W a) →+* E).comp
          (MvPolynomial.map mk)) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, MvPolynomial.map_C,
          RingHom.coe_coe, AlgHom.coe_toRingHom, MvPolynomial.algHom_C]
        rw [show φ (algebraMap _ E (mk r)) = f (mk r) from RingHom.congr_fun hφ (mk r)]
      · intro i
        simp only [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, MvPolynomial.map_X,
          RingHom.coe_coe, AlgHom.coe_toRingHom]
    exact RingHom.congr_fun hh q
  have hRk : ∀ j, ψ (R j) = 0 := by
    intro j
    have : R j ∈ RingHom.ker ψ := by rw [hψk]; exact Ideal.subset_span ⟨j, rfl⟩
    exact RingHom.mem_ker.mp this
  have hdetmap : MvPolynomial.map mk (Matrix.of (fun j i => MvPolynomial.pderiv i (Rh j))).det =
      (Matrix.of (fun j i => MvPolynomial.pderiv i (R j))).det := by
    simp only [Matrix.det_apply, map_sum, Units.smul_def, map_zsmul, map_prod, Matrix.of_apply,
      ← MvPolynomial.pderiv_map, hRh]

  have h1C : (h₁.comp f).comp (mk.comp MvPolynomial.C) = g.comp (mk.comp MvPolynomial.C) := by
    rw [hh₁f]
  have h10 : h₁ (f (wcEbntX W a 0)) = g (wcEbntX W a 0) := RingHom.congr_fun hh₁f _
  have h11 : h₁ (f (wcEbntX W a 1)) = g (wcEbntX W a 1) := RingHom.congr_fun hh₁f _
  have hstar₁ := hstar h₁ _ _ h1C h10 h11
  let b₀ : Fin n ⊕ Fin 2 → B := Sum.elim (fun i => h₁ (φ (ψ (MvPolynomial.X i)))) ![h₁ η, h₁ η']
  have hFin2 : ∀ i : Fin 2, i = 0 ∨ i = 1 := by intro i; fin_cases i <;> simp
  have hFb₀ : ∀ k, MvPolynomial.eval b₀ (F k) ∈ IsLocalRing.maximalIdeal B := by
    intro k
    rcases k with j | i
    · rw [hF1 b₀ j, ← IsLocalRing.residue_eq_zero_iff, hF4 b₀]
      have e : MvPolynomial.eval₂ (MvPolynomial.eval₂Hom (g.comp (mk.comp MvPolynomial.C))
          ![g (wcEbntX W a 0), g (wcEbntX W a 1)]) (b₀ ∘ Sum.inl) (Rh j) = 0 :=
        (hstar₁ (Rh j)).trans (by rw [hRh, hRk]; simp)
      rw [e, map_zero]
    · obtain rfl | rfl := hFin2 i
      · rw [hF2 b₀, ← IsLocalRing.residue_eq_zero_iff, map_sub, hF4 b₀]
        have e : MvPolynomial.eval₂ (MvPolynomial.eval₂Hom (g.comp (mk.comp MvPolynomial.C))
            ![g (wcEbntX W a 0), g (wcEbntX W a 1)]) (b₀ ∘ Sum.inl) ê = h₁ η :=
          (hstar₁ ê).trans (by rw [hê, het, he₀])
        rw [e]; exact sub_self _
      · rw [hF3 b₀]
        show h₁ η * h₁ η' - 1 ∈ IsLocalRing.maximalIdeal B
        rw [← map_mul, hηη', map_one, sub_self]; exact Ideal.zero_mem _
  have hJb₀ : IsUnit (MvPolynomial.eval b₀
      (Matrix.of (fun k l => MvPolynomial.pderiv l (F k))).det) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hF5 b₀]
    apply mul_ne_zero
    · rw [IsLocalRing.residue_ne_zero_iff_isUnit]
      have e : MvPolynomial.eval₂ (MvPolynomial.eval₂Hom (g.comp (mk.comp MvPolynomial.C))
          ![g (wcEbntX W a 0), g (wcEbntX W a 1)]) (b₀ ∘ Sum.inl)
          (Matrix.of (fun j i => MvPolynomial.pderiv i (Rh j))).det =
          h₁ (φ (ψ (Matrix.of (fun j i => MvPolynomial.pderiv i (R j))).det)) :=
        (hstar₁ _).trans (by rw [hdetmap])
      rw [e]
      exact (hψJ.map φ).map h₁
    · rw [IsLocalRing.residue_ne_zero_iff_isUnit]
      exact IsUnit.map h₁ (isUnit_iff_exists_inv.mpr ⟨η', hηη'⟩)

  obtain ⟨⟨b, hb, hbb₀⟩, hbuniq⟩ := wc_rescale_multi_hensel B (Fin n ⊕ Fin 2) F b₀ hFb₀ hJb₀
  have hbb : b (Sum.inr 0) * b (Sum.inr 1) = 1 := by
    have := hb (Sum.inr 1); rw [hF3] at this; exact sub_eq_zero.mp this

  obtain ⟨gβ, hgβC, hgβ0, hgβ1⟩ := htw B g (b (Sum.inr 1)) (b (Sum.inr 0))
    (by rw [mul_comm]; exact hbb)
  have hgβ0m : gβ (wcEbntX W a 0) ∈ IsLocalRing.maximalIdeal B := by
    rw [hgβ0]; exact Ideal.mul_mem_left _ _ hu0
  have hgβ1m : gβ (wcEbntX W a 1) ∈ IsLocalRing.maximalIdeal B := by
    rw [hgβ1]; exact Ideal.mul_mem_left _ _ hu1
  have hgβres : ∀ t, IsLocalRing.residue B (gβ t) = IsLocalRing.residue B (g t) :=
    hUT B gβ g hgβC hgβ0m hu0 hgβ1m hu1
  obtain ⟨kβ, ⟨hkβf, hkβl⟩, hkβu⟩ := hUP B hBH gβ
    (fun t => (hUnitRes B _ _ (hgβres t)).trans (hg t))
  have hΘβ := hΘ gβ _ _ hgβC hgβ0 hgβ1
  let ρ : MvPolynomial (Fin n) (wcEbntN W a) →+* B := MvPolynomial.eval₂Hom gβ (b ∘ Sum.inl)
  have hρmap : ∀ q, ρ (MvPolynomial.map mk q) =
      MvPolynomial.eval₂ (MvPolynomial.eval₂Hom (g.comp (mk.comp MvPolynomial.C))
        ![b (Sum.inr 1) * g (wcEbntX W a 0), b (Sum.inr 0) * g (wcEbntX W a 1)])
        (b ∘ Sum.inl) q := by
    intro q
    rw [hΘβ]
    have hh : ρ.comp (MvPolynomial.map mk) = MvPolynomial.eval₂Hom (gβ.comp mk) (b ∘ Sum.inl) := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [ρ]
      · intro i; simp [ρ]
    exact RingHom.congr_fun hh q
  let ψR : MvPolynomial (Fin n) (wcEbntN W a) →+* E := ψ.toRingHom
  have hψRs : Function.Surjective ψR := hψs
  have hkerρ : RingHom.ker ψR ≤ RingHom.ker ρ := by
    intro p hp
    have hp' : p ∈ RingHom.ker ψ := hp
    rw [hψk] at hp'
    refine Ideal.span_le.mpr ?_ hp'
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, ← hRh j, hρmap, ← hF1 b j, hb]
  let ρE : E →+* B := @RingHom.liftOfSurjective (MvPolynomial (Fin n) (wcEbntN W a)) E B _ _ _
    ψR hψRs ⟨ρ, hkerρ⟩
  have hρE : ∀ p, ρE (ψ p) = ρ p := fun p => RingHom.liftOfSurjective_comp_apply ψR hψRs _ p
  letI : Algebra (wcEbntN W a) B := gβ.toAlgebra
  let τ₁ : E →ₐ[wcEbntN W a] B :=
    { kβ.comp φ with
      commutes' := fun r => (congrArg kβ (RingHom.congr_fun hφ r)).trans
        (RingHom.congr_fun hkβf r) }
  let τ₂ : E →ₐ[wcEbntN W a] B :=
    { ρE with
      commutes' := fun r => by
        show ρE (algebraMap _ E r) = gβ r
        rw [← MvPolynomial.algHom_C ψ r, hρE]
        exact MvPolynomial.eval₂Hom_C _ _ _ }
  have hkβres : ∀ z, IsLocalRing.residue B (kβ z) = IsLocalRing.residue B (h₁ z) :=
    hres B kβ h₁ hkβl hh₁l (fun t => (congrArg _ (RingHom.congr_fun hkβf t)).trans
      ((hgβres t).trans (congrArg _ (RingHom.congr_fun hh₁f t)).symm))
  have hτ : τ₁ = τ₂ := by
    apply wc_hnas_hs_etale_hom_unique_residue (wcEbntN W a) E B τ₁ τ₂
    intro x
    obtain ⟨p, rfl⟩ := hψs x
    have hh : (IsLocalRing.residue B).comp ((kβ.comp φ).comp
        (ψ : MvPolynomial (Fin n) (wcEbntN W a) →+* E)) = (IsLocalRing.residue B).comp ρ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.coe_coe, AlgHom.coe_toRingHom, MvPolynomial.algHom_C]
        rw [show φ (algebraMap _ E r) = f r from RingHom.congr_fun hφ r,
          show kβ (f r) = gβ r from RingHom.congr_fun hkβf r]
        simp only [ρ, MvPolynomial.eval₂Hom_C]
      · intro i
        simp only [RingHom.comp_apply, RingHom.coe_coe, AlgHom.coe_toRingHom]
        rw [hkβres]
        simp only [ρ, MvPolynomial.eval₂Hom_X', Function.comp_apply]
        exact ((hresEq _ _).mp (hbb₀ (Sum.inl i))).symm
    rw [show τ₂ (ψ p) = ρ p from hρE p]
    exact RingHom.congr_fun hh p
  have hkη : kβ η = b (Sum.inr 0) := by
    have e1 : kβ η = τ₁ e₀ := by rw [← he₀]; rfl
    rw [e1, hτ]
    show ρE e₀ = _
    rw [← het, hρE, ← hê, hρmap]
    have := hb (Sum.inr 0); rw [hF2] at this; exact (sub_eq_zero.mp this).symm
  have hkη' : kβ η' = b (Sum.inr 1) := by
    have e1 : kβ η * kβ η' = 1 := by rw [← map_mul, hηη', map_one]
    linear_combination b (Sum.inr 1) * e1 - (b (Sum.inr 1) * kβ η') * hkη - kβ η' * hbb
  have hkβf' : kβ.comp f' = g := by
    apply hext B
    · rw [RingHom.comp_assoc, hf'C, ← RingHom.comp_assoc, hkβf, hgβC]
    · show kβ (f' (wcEbntX W a 0)) = _
      rw [hf'0, map_mul, hkη, show kβ (f (wcEbntX W a 0)) = gβ (wcEbntX W a 0) from
        RingHom.congr_fun hkβf _, hgβ0]
      linear_combination g (wcEbntX W a 0) * hbb
    · show kβ (f' (wcEbntX W a 1)) = _
      rw [hf'1, map_mul, hkη', show kβ (f (wcEbntX W a 1)) = gβ (wcEbntX W a 1) from
        RingHom.congr_fun hkβf _, hgβ1]
      linear_combination g (wcEbntX W a 1) * hbb
  refine ⟨kβ, ⟨hkβf', hkβl⟩, ?_⟩

  rintro k ⟨hkf', hkl⟩
  have hkx0 : k (f (wcEbntX W a 0)) = k η' * g (wcEbntX W a 0) := by
    rw [← RingHom.congr_fun hkf' (wcEbntX W a 0)]
    show _ = k η' * k (f' (wcEbntX W a 0))
    rw [hf'0, ← map_mul, ← mul_assoc, mul_comm η' η, hηη', one_mul]
  have hkx1 : k (f (wcEbntX W a 1)) = k η * g (wcEbntX W a 1) := by
    rw [← RingHom.congr_fun hkf' (wcEbntX W a 1)]
    show _ = k η * k (f' (wcEbntX W a 1))
    rw [hf'1, ← map_mul, ← mul_assoc, hηη', one_mul]
  have hkC : (k.comp f).comp (mk.comp MvPolynomial.C) = g.comp (mk.comp MvPolynomial.C) := by
    rw [← hkf', RingHom.comp_assoc, RingHom.comp_assoc, hf'C]
  let v : Fin n ⊕ Fin 2 → B := Sum.elim (fun i => k (φ (ψ (MvPolynomial.X i)))) ![k η, k η']
  have hstark := hstar k _ _ hkC hkx0 hkx1
  have hv : ∀ l, MvPolynomial.eval v (F l) = 0 := by
    intro l
    rcases l with j | i
    · rw [hF1 v j]
      exact (hstark (Rh j)).trans (by rw [hRh, hRk]; simp)
    · obtain rfl | rfl := hFin2 i
      · rw [hF2 v, sub_eq_zero]
        have e : k (φ (ψ (MvPolynomial.map mk ê))) = k η := by rw [hê, het, he₀]
        exact ((hstark ê).trans e).symm
      · rw [hF3 v]
        show k η * k η' - 1 = 0
        rw [← map_mul, hηη', map_one, sub_self]
  have hkres : ∀ z, IsLocalRing.residue B (k z) = IsLocalRing.residue B (h₁ z) := by
    apply hres B k h₁ hkl hh₁l
    intro t
    have := hUT B (k.comp f) g hkC
      (by show k (f (wcEbntX W a 0)) ∈ IsLocalRing.maximalIdeal B
          rw [hkx0]; exact Ideal.mul_mem_left _ _ hu0) hu0
      (by show k (f (wcEbntX W a 1)) ∈ IsLocalRing.maximalIdeal B
          rw [hkx1]; exact Ideal.mul_mem_left _ _ hu1) hu1 t
    exact this.trans (congrArg _ (RingHom.congr_fun hh₁f t)).symm
  have hvb₀ : ∀ l, v l - b₀ l ∈ IsLocalRing.maximalIdeal B := by
    intro l
    rw [hresEq]
    rcases l with i | i
    · exact hkres (φ (ψ (MvPolynomial.X i)))
    · obtain rfl | rfl := hFin2 i
      · exact hkres η
      · exact hkres η'
  have hvb := hbuniq v b hv hb hvb₀ hbb₀
  have hkη2 : k η = b (Sum.inr 0) := congrFun hvb (Sum.inr 0)
  have hkη2' : k η' = b (Sum.inr 1) := congrFun hvb (Sum.inr 1)
  have hkfβ : k.comp f = gβ := by
    apply hext B
    · rw [hkC, hgβC]
    · show k (f (wcEbntX W a 0)) = _
      rw [hkx0, hgβ0, hkη2']
    · show k (f (wcEbntX W a 1)) = _
      rw [hkx1, hgβ1, hkη2]
  exact hkβu k ⟨hkfβ, hkl⟩

theorem wcpa_dj_lr1k_ebnt_concentric : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P₁ P₂ : Type u) [CommRing P₁] [CommRing P₂] (σ₁ : ↥W →+* P₁) (σ₂ : ↥W →+* P₂)
      (h : P₁ →+* P₂), IsLocalHom h → h.comp σ₁ = σ₂ →
      wcNdModelB W P₁ σ₁ → wcNdModelB W P₂ σ₂ →
    ∀ 𝔔 : Ideal P₂, 𝔔.IsPrime → (∀ t ∈ IsLocalRing.maximalIdeal ↥W, σ₂ t ∈ 𝔔) →
      (∃ t ∉ 𝔔, ¬ IsUnit t) → (∃ t : P₁, h t ∉ 𝔔 ∧ ¬ IsUnit t) →
      (∀ q : P₂, ∃ a b : P₁, h b ∉ 𝔔 ∧ q * h b - h a ∈ 𝔔) →
    ∃ (a₁ a₂ c : ↥W) (f₁ : wcEbntN W a₁ →+* P₁) (f₂ : wcEbntN W a₂ →+* P₂),
      a₁ = c * a₂ ∧ wcEbntPres W σ₁ a₁ f₁ ∧ wcEbntPres W σ₂ a₂ f₂ ∧
      h (f₁ (wcEbntX W a₁ 0)) = f₂ (wcEbntX W a₂ 0) ∧
      h (f₁ (wcEbntX W a₁ 1)) = σ₂ c * f₂ (wcEbntX W a₂ 1) :=
by
  rintro Ω _ _ W hdim hWt P₁ P₂ _ _ σ₁ σ₂ h hloc hcomp hB₁ hB₂ 𝔔 h𝔔p hW ⟨t₂, ht₂𝔔, ht₂u⟩
    ⟨t₁, ht₁𝔔, ht₁u⟩ hfrac
  classical
  haveI := h𝔔p
  haveI := hloc

  have hrel : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → f (wcEbntX W c 0) * f (wcEbntX W c 1) = σ c := by
    intro P _ σ c f hf
    have h1 : (wcEbntX W c 0) * (wcEbntX W c 1) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
          (MvPolynomial.C c) := by
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [← map_mul, h1, ← hf.2.2.1]
    rfl
  have hX0 : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → ¬ IsUnit (f (wcEbntX W c 0)) := by
    intro P _ σ c f hf hu
    apply (hf.2.2.2.2.1 _).mp hu
    apply Ideal.mem_map_of_mem
    apply Ideal.mem_sup_left
    apply Ideal.subset_span
    exact Set.mem_insert _ _
  have hprime : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → p.IsPrime := by
    intro A _ p P _ e he
    haveI := he.1
    have hp : p = (IsLocalRing.maximalIdeal P).comap e := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 t, not_not]
    rw [hp]
    exact Ideal.comap_isPrime e _

  unfold wcNdModelB at hB₁ hB₂
  obtain ⟨a, ham, ha0, f₁₀, hf₁σ, hf₁H⟩ := hB₁
  obtain ⟨b, hbm, hb0, f₂₀, hf₂σ, hf₂H⟩ := hB₂
  have hf₁₀ : wcEbntPres W σ₁ a f₁₀ := ⟨ham, ha0, hf₁σ, hf₁H⟩
  have hf₂₀ : wcEbntPres W σ₂ b f₂₀ := ⟨hbm, hb0, hf₂σ, hf₂H⟩
  haveI : HenselianLocalRing P₁ := hf₁H.1
  haveI : HenselianLocalRing P₂ := hf₂H.1
  have hhσ : ∀ t, h (σ₁ t) = σ₂ t := fun t => RingHom.congr_fun hcomp t
  have hQmax : 𝔔 ≤ IsLocalRing.maximalIdeal P₂ := IsLocalRing.le_maximalIdeal h𝔔p.ne_top
  have hexp : ∀ (z u₁ u₂ : P₂) (p q : ℕ), z ∉ 𝔔 → z ∈ IsLocalRing.maximalIdeal P₂ →
      IsUnit u₁ → IsUnit u₂ → u₁ * z ^ p - u₂ * z ^ q ∈ 𝔔 → p = q := by
    intro z u₁ u₂ p q hz hzm hu₁ hu₂ hmem
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with hlt | hlt
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hlt
      have h0 : z ^ p * (u₁ - u₂ * z ^ (d + 1)) ∈ 𝔔 := by
        convert hmem using 1; ring
      rcases h𝔔p.mem_or_mem h0 with h | h
      · exact hz (h𝔔p.mem_of_pow_mem p h)
      · have h2 : u₂ * z ^ (d + 1) ∈ IsLocalRing.maximalIdeal P₂ :=
          Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hzm _ (Nat.succ_pos d))
        have h3 : u₁ ∈ IsLocalRing.maximalIdeal P₂ := by
          have := Ideal.add_mem _ (hQmax h) h2
          rwa [sub_add_cancel] at this
        exact (IsLocalRing.mem_maximalIdeal _).mp h3 hu₁
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hlt
      have h0 : z ^ q * (u₁ * z ^ (d + 1) - u₂) ∈ 𝔔 := by
        convert hmem using 1; ring
      rcases h𝔔p.mem_or_mem h0 with h | h
      · exact hz (h𝔔p.mem_of_pow_mem q h)
      · have h2 : u₁ * z ^ (d + 1) ∈ IsLocalRing.maximalIdeal P₂ :=
          Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hzm _ (Nat.succ_pos d))
        have h3 : u₂ ∈ IsLocalRing.maximalIdeal P₂ := by
          have := Ideal.sub_mem _ h2 (hQmax h)
          rwa [sub_sub_cancel] at this
        exact (IsLocalRing.mem_maximalIdeal _).mp h3 hu₂
  have hQnm : ¬ 𝔔.IsMaximal := by
    intro hmax
    apply ht₂𝔔
    rw [IsLocalRing.eq_maximalIdeal hmax]
    exact (IsLocalRing.mem_maximalIdeal _).mpr ht₂u

  obtain ⟨f₂, hf₂, hy'𝔔⟩ : ∃ f₂ : wcEbntN W b →+* P₂, wcEbntPres W σ₂ b f₂ ∧
      f₂ (wcEbntX W b 1) ∈ 𝔔 := by
    have hm : f₂₀ (wcEbntX W b 0) * f₂₀ (wcEbntX W b 1) ∈ 𝔔 := by
      rw [hrel _ _ _ _ hf₂₀]; exact hW b hbm
    rcases h𝔔p.mem_or_mem hm with h0 | h1
    · obtain ⟨f', hf', -, h1'⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P₂ σ₂ b f₂₀ hf₂₀
      exact ⟨f', hf', by rw [h1']; exact h0⟩
    · exact ⟨f₂₀, hf₂₀, h1⟩
  obtain ⟨-, hx'nb, hcl₂⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt P₂ σ₂ b f₂ hf₂
  have hle₂ : Ideal.span {f₂ (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ₂ ≤ 𝔔 :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hy'𝔔)
      (Ideal.map_le_iff_le_comap.mpr (fun t ht => Ideal.mem_comap.mpr (hW t ht)))
  have hx'𝔔 : f₂ (wcEbntX W b 0) ∉ 𝔔 := by
    rcases hcl₂ 𝔔 h𝔔p hle₂ with heq | hmax
    · rw [heq]; exact hx'nb
    · exact absurd hmax hQnm

  obtain ⟨f₁, hf₁, hy𝔔⟩ : ∃ f₁ : wcEbntN W a →+* P₁, wcEbntPres W σ₁ a f₁ ∧
      h (f₁ (wcEbntX W a 1)) ∈ 𝔔 := by
    have hm : h (f₁₀ (wcEbntX W a 0)) * h (f₁₀ (wcEbntX W a 1)) ∈ 𝔔 := by
      rw [← map_mul, hrel _ _ _ _ hf₁₀, hhσ]; exact hW a ham
    rcases h𝔔p.mem_or_mem hm with h0 | h1
    · obtain ⟨f', hf', -, h1'⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P₁ σ₁ a f₁₀ hf₁₀
      exact ⟨f', hf', by rw [h1']; exact h0⟩
    · exact ⟨f₁₀, hf₁₀, h1⟩
  haveI h𝔭p : (𝔔.comap h).IsPrime := Ideal.comap_isPrime (H := h𝔔p) h 𝔔
  obtain ⟨-, hxnb, hcl₁⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt P₁ σ₁ a f₁ hf₁
  have hle₁ : Ideal.span {f₁ (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ₁ ≤
      𝔔.comap h :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_comap.mpr hy𝔔))
      (Ideal.map_le_iff_le_comap.mpr (fun t ht => by
        rw [Ideal.mem_comap, Ideal.mem_comap, hhσ]; exact hW t ht))
  have hmap : ∀ t, t ∈ Ideal.span {f₁ (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ₁ →
      h t ∈ 𝔔 := fun t ht => Ideal.mem_comap.mp (hle₁ ht)
  have hx𝔔 : h (f₁ (wcEbntX W a 0)) ∉ 𝔔 := by
    rcases hcl₁ (𝔔.comap h) h𝔭p hle₁ with heq | hmax
    · intro hx
      apply hxnb
      rw [← heq]
      exact Ideal.mem_comap.mpr hx
    · exfalso
      apply ht₁𝔔
      have : t₁ ∈ 𝔔.comap h := by
        rw [IsLocalRing.eq_maximalIdeal hmax]
        exact (IsLocalRing.mem_maximalIdeal _).mpr ht₁u
      exact Ideal.mem_comap.mp this

  have hFG : h (f₁ (wcEbntX W a 0)) * h (f₁ (wcEbntX W a 1)) = σ₂ a := by
    rw [← map_mul, hrel _ _ _ _ hf₁, hhσ]
  obtain ⟨α, n, η, hα0, hη, hform⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hdim hWt P₂ σ₂ b
    f₂ hf₂ _ _ a ha0 hFG
  have hαm : α ∉ IsLocalRing.maximalIdeal ↥W := by
    intro hα
    apply hx𝔔
    rcases hform with hf | hf <;> rw [hf] <;>
      exact 𝔔.mul_mem_right _ (𝔔.mul_mem_left _ (hW α hα))
  have hαu : IsUnit α := by
    by_contra hc
    exact hαm ((IsLocalRing.mem_maximalIdeal _).mpr hc)
  have hη₀ : IsUnit (η * σ₂ α) := hη.mul (hαu.map σ₂)
  have hF : h (f₁ (wcEbntX W a 0)) = (η * σ₂ α) * f₂ (wcEbntX W b 0) ^ n := by
    rcases hform with hf | hf
    · exact hf
    · rcases Nat.eq_zero_or_pos n with hn | hn
      · rw [hf, hn, pow_zero, pow_zero]
      · exfalso
        apply hx𝔔
        rw [hf]
        exact 𝔔.mul_mem_left _ (Ideal.pow_mem_of_mem _ hy'𝔔 n hn)

  obtain ⟨a₀, b₀, hb₀, hab⟩ := hfrac (f₂ (wcEbntX W b 0))
  obtain ⟨k₁, ε₁, hε₁, hk₁⟩ : ∃ (k : ℕ) (ε : P₁), IsUnit ε ∧
      h b₀ - h ε * h (f₁ (wcEbntX W a 0)) ^ k ∈ 𝔔 := by
    rcases wcpa_dj_lr1k_ebnt_branch_monomial Ω W hdim hWt P₁ σ₁ a f₁ hf₁ b₀ with
      hb | ⟨k, ε, hε, hk⟩
    · exact absurd (hmap _ hb) hb₀
    · refine ⟨k, ε, hε, ?_⟩
      have := hmap _ hk
      rwa [map_sub, map_mul, map_pow] at this
  obtain ⟨k₂, ε₂, hε₂, hk₂⟩ : ∃ (k : ℕ) (ε : P₁), IsUnit ε ∧
      h a₀ - h ε * h (f₁ (wcEbntX W a 0)) ^ k ∈ 𝔔 := by
    rcases wcpa_dj_lr1k_ebnt_branch_monomial Ω W hdim hWt P₁ σ₁ a f₁ hf₁ a₀ with
      ha | ⟨k, ε, hε, hk⟩
    · exfalso
      have h1 : f₂ (wcEbntX W b 0) * h b₀ ∈ 𝔔 := by
        have := 𝔔.add_mem hab (hmap _ ha)
        rwa [sub_add_cancel] at this
      rcases h𝔔p.mem_or_mem h1 with h2 | h2
      · exact hx'𝔔 h2
      · exact hb₀ h2
    · refine ⟨k, ε, hε, ?_⟩
      have := hmap _ hk
      rwa [map_sub, map_mul, map_pow] at this
  have key : (h ε₁ * (η * σ₂ α) ^ k₁) * f₂ (wcEbntX W b 0) ^ (n * k₁ + 1) -
      (h ε₂ * (η * σ₂ α) ^ k₂) * f₂ (wcEbntX W b 0) ^ (n * k₂) ∈ 𝔔 := by
    have := 𝔔.add_mem (𝔔.sub_mem hab (𝔔.mul_mem_left (f₂ (wcEbntX W b 0)) hk₁)) hk₂
    rw [hF] at this
    convert this using 1
    ring
  have hx'max : f₂ (wcEbntX W b 0) ∈ IsLocalRing.maximalIdeal P₂ :=
    (IsLocalRing.mem_maximalIdeal _).mpr (hX0 _ _ _ _ hf₂)
  have hn1 : n = 1 := by
    have he := hexp _ _ _ _ _ hx'𝔔 hx'max ((hε₁.map h).mul (hη₀.pow k₁))
      ((hε₂.map h).mul (hη₀.pow k₂)) key
    have hd : n ∣ 1 := by
      have h2 : n ∣ n * k₁ + 1 := by rw [he]; exact dvd_mul_right n k₂
      exact (Nat.dvd_add_right (dvd_mul_right n k₁)).mp h2
    exact Nat.dvd_one.mp hd
  subst hn1

  have hdiv : σ₂ a ∈ Ideal.span {f₂ (wcEbntX W b 0)} := by
    rw [← hFG, hF, pow_one]
    exact Ideal.mem_span_singleton'.mpr ⟨(η * σ₂ α) * h (f₁ (wcEbntX W a 1)), by ring⟩
  obtain ⟨c₀, hc₀⟩ := wcpa_dj_lr1k_ebnt_coord_divides Ω W P₂ σ₂ b f₂ hf₂ a hdiv

  haveI : IsDomain (wcEbntN W b) := (wcNd_nodal_poly_normal Ω W b hb0).1
  haveI : IsIntegrallyClosed (wcEbntN W b) := (wcNd_nodal_poly_normal Ω W b hb0).2
  haveI : IsDomain P₂ := (wcNd_hens_normal_domain (wcEbntN W b) _
    (hprime _ _ _ _ hf₂.2.2.2) P₂ f₂ hf₂.2.2.2).1
  have hx'0 : f₂ (wcEbntX W b 0) ≠ 0 := fun h0 => hx'𝔔 (by rw [h0]; exact 𝔔.zero_mem)
  have hcan : (η * σ₂ α) * h (f₁ (wcEbntX W a 1)) = σ₂ c₀ * f₂ (wcEbntX W b 1) := by
    apply mul_left_cancel₀ hx'0
    have e1 : f₂ (wcEbntX W b 0) * ((η * σ₂ α) * h (f₁ (wcEbntX W a 1))) = σ₂ a := by
      rw [← hFG, hF, pow_one]; ring
    have e2 : f₂ (wcEbntX W b 0) * (σ₂ c₀ * f₂ (wcEbntX W b 1)) = σ₂ a := by
      rw [hc₀, map_mul, ← hrel _ _ _ _ hf₂]; ring
    rw [e1, e2]

  obtain ⟨f₂', hf₂', hX0', hX1'⟩ := wcpa_dj_lr1k_ebnt_rescale Ω W P₂ σ₂ b f₂ hf₂ (η * σ₂ α)
    (↑hη₀.unit⁻¹) hη₀.mul_val_inv
  refine ⟨a, b, c₀, f₁, f₂', by rw [hc₀, mul_comm], hf₁, hf₂', ?_, ?_⟩
  · rw [hX0', hF, pow_one]
  · rw [hX1']
    have hinv : (↑hη₀.unit⁻¹ : P₂) * (η * σ₂ α) = 1 := hη₀.val_inv_mul
    calc h (f₁ (wcEbntX W a 1))
        = ((↑hη₀.unit⁻¹ : P₂) * (η * σ₂ α)) * h (f₁ (wcEbntX W a 1)) := by
          rw [hinv, one_mul]
      _ = (↑hη₀.unit⁻¹ : P₂) * (σ₂ c₀ * f₂ (wcEbntX W b 1)) := by rw [mul_assoc, hcan]
      _ = σ₂ c₀ * ((↑hη₀.unit⁻¹ : P₂) * f₂ (wcEbntX W b 1)) := by ring

theorem wcpa_dj_lr1k_ebnb_hens_inj : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    (p : Ideal A), p.IsPrime → ∀ (P : Type u) [CommRing P] (e : A →+* P), wcNdIsHens p P e →
    Function.Injective e ∧ ∀ (B : Type u) [CommRing B] (φ : P →+* B),
      Function.Injective (φ.comp e) → Function.Injective φ :=
by
  intro A _ _ _ p hp P _ e hH
  haveI : HenselianLocalRing P := hH.1
  refine ⟨?_, ?_⟩
  · obtain ⟨V, _, hV, g, hg_inj, hg_unit⟩ := wcNd_hne_valuation_witness A p hp
    obtain ⟨h, ⟨hhe, _⟩, _⟩ := hH.2.2 V hV g hg_unit
    intro a b hab
    apply hg_inj
    rw [← hhe, RingHom.comp_apply, RingHom.comp_apply, hab]
  · intro B _ φ hφ
    rw [injective_iff_map_eq_zero φ]
    intro x hx
    obtain ⟨E, _, _, _, χ, hχ, hxF⟩ := wcNd_hne_etale_approx A p P e hH {x}
    obtain ⟨y, hy⟩ := RingHom.mem_range.mp (hxF x (Finset.mem_singleton_self x))
    haveI hq : (Ideal.comap χ (IsLocalRing.maximalIdeal P)).IsPrime :=
      Ideal.comap_isPrime χ (IsLocalRing.maximalIdeal P)
    set q := Ideal.comap χ (IsLocalRing.maximalIdeal P) with hqdef
    have hunit : ∀ s : q.primeCompl, IsUnit (χ s) := by
      intro s
      have hs : χ (s : E) ∉ IsLocalRing.maximalIdeal P := s.2
      exact IsLocalRing.notMem_maximalIdeal.mp hs
    let γ : Localization.AtPrime q →+* P :=
      IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit
    have hγ : ∀ z : E, γ (algebraMap E (Localization.AtPrime q) z) = χ z := fun z =>
      IsLocalization.lift_eq (M := q.primeCompl) (S := Localization.AtPrime q) hunit z
    have hdom : IsDomain (Localization.AtPrime q) :=
      (wc_pks_etale_localization_normal A E q).1
    have hinj1 : Function.Injective ((φ.comp γ).comp (algebraMap A (Localization.AtPrime q))) := by
      have heq : (φ.comp γ).comp (algebraMap A (Localization.AtPrime q)) = φ.comp e := by
        ext a
        simp only [RingHom.comp_apply]
        rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime q), hγ, ← hχ,
          RingHom.comp_apply]
      rw [heq]
      exact hφ
    have halg : ∀ z : E, ∃ c : Polynomial A, c ≠ 0 ∧ Polynomial.aeval z c = 0 :=
      fun z => wcNd_hne_etale_algebraic A E z
    have hinj := wcNd_hne_local_injective A E q hdom B (φ.comp γ) hinj1 halg
    have h0 : algebraMap E (Localization.AtPrime q) y = 0 := by
      apply hinj
      rw [RingHom.comp_apply, hγ, hy, hx, map_zero]
    rw [← hy, ← hγ, h0, map_zero]

theorem wcpa_dj_lr1k_ebnb_hens_finite : ∀ (A B R P Q : Type u) [CommRing A] [IsLocalRing A]
    [CommRing B] [CommRing R] [IsLocalRing R] [CommRing P] [CommRing Q] (α : A →+* B), α.Finite →
    ∀ (𝔫 : Ideal B) (h𝔫 : 𝔫.IsMaximal) (β : B →+* R),
    @IsLocalization B _ (@Ideal.primeCompl B _ 𝔫 h𝔫.isPrime) R _ β.toAlgebra →
    ∀ (e : A →+* P), wcNdIsHens (IsLocalRing.maximalIdeal A) P e →
    ∀ (k : R →+* Q), wcNdIsHens (IsLocalRing.maximalIdeal R) Q k →
    ∀ (j : P →+* Q), IsLocalHom j → j.comp e = k.comp (β.comp α) →
    j.Finite ∧ ∀ q : Q, ∃ (m : ℕ) (p : Fin m → P) (r : Fin m → R), q = ∑ i, j (p i) * k (r i) :=
by
  intro A B R P Q _ _ _ _ _ _ _ α hα 𝔫 h𝔫 β hloc e he k hk j hjl hje
  classical

  have hcmp : ∀ (C : Type u) [CommRing C] (p : Ideal C) (P₁ P₂ : Type u) [CommRing P₁]
      [CommRing P₂] (e₁ : C →+* P₁) (e₂ : C →+* P₂), wcNdIsHens p P₁ e₁ → wcNdIsHens p P₂ e₂ →
      ∃ (u : P₁ →+* P₂) (u' : P₂ →+* P₁), IsLocalHom u ∧ IsLocalHom u' ∧ u.comp e₁ = e₂ ∧
        u'.comp e₂ = e₁ ∧ (∀ x, u (u' x) = x) ∧ (∀ x, u' (u x) = x) := by
    intro C _ p P₁ P₂ _ _ e₁ e₂ h₁ h₂
    obtain ⟨h₁h, h₁u, h₁U⟩ := h₁
    obtain ⟨h₂h, h₂u, h₂U⟩ := h₂
    obtain ⟨u, ⟨hue, hul⟩, -⟩ := h₁U P₂ h₂h e₂ h₂u
    obtain ⟨u', ⟨hue', hul'⟩, -⟩ := h₂U P₁ h₁h e₁ h₁u
    have hA : u.comp u' = RingHom.id P₂ := by
      refine (h₂U P₂ h₂h e₂ h₂u).unique ⟨?_, ?_⟩ ⟨?_, ?_⟩
      · rw [RingHom.comp_assoc, hue', hue]
      · exact RingHom.isLocalHom_comp u u'
      · exact RingHom.id_comp e₂
      · infer_instance
    have hB : u'.comp u = RingHom.id P₁ := by
      refine (h₁U P₁ h₁h e₁ h₁u).unique ⟨?_, ?_⟩ ⟨?_, ?_⟩
      · rw [RingHom.comp_assoc, hue, hue']
      · exact RingHom.isLocalHom_comp u' u
      · exact RingHom.id_comp e₁
      · infer_instance
    refine ⟨u, u', hul, hul', hue, hue', fun x => ?_, fun x => ?_⟩
    · exact RingHom.congr_fun hA x
    · exact RingHom.congr_fun hB x

  obtain ⟨R', _, _, hR', -, hres⟩ := wcNd_hi_hens_exists_flat A
  letI : Algebra A B := α.toAlgebra
  have hαf : Module.Finite A B := hα
  obtain ⟨ε, e', hidem, hT, hcomp⟩ := wcNd_hi_factor_hens A R' B R hR' hres hαf 𝔫 h𝔫 β hloc
  haveI : IsLocalRing R' := hR'.1.toIsLocalRing
  haveI : IsLocalRing (Localization.Away ε) := hT.1.toIsLocalRing

  have hι1 : algebraMap (TensorProduct A R' B) (Localization.Away ε) ε = 1 := by
    refine (IsIdempotentElem.iff_eq_one_of_isUnit
      (IsLocalization.Away.algebraMap_isUnit ε)).mp ?_
    unfold IsIdempotentElem
    rw [← map_mul, hidem.eq]
  have hsurj : Function.Surjective (algebraMap (TensorProduct A R' B) (Localization.Away ε)) := by
    intro t
    obtain ⟨⟨x, y⟩, hxy⟩ := IsLocalization.surj (Submonoid.powers ε) t
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp y.2
    refine ⟨x, ?_⟩
    simp only at hxy
    rw [← hn, map_pow, hι1, one_pow, mul_one] at hxy
    exact hxy.symm

  obtain ⟨J, hJdef⟩ : ∃ J : R' →+* Localization.Away ε,
      J = (algebraMap (TensorProduct A R' B) (Localization.Away ε)).comp
        (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct A R' B) := ⟨_, rfl⟩
  have hJapp : ∀ r : R', J r = algebraMap (TensorProduct A R' B) (Localization.Away ε)
      (TensorProduct.tmul A r (1 : B)) := by
    intro r; rw [hJdef]; rfl
  have hJf : J.Finite := by
    rw [hJdef]
    apply RingHom.Finite.comp (RingHom.Finite.of_surjective _ hsurj)
    rw [show (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct A R' B) =
      algebraMap R' (TensorProduct A R' B) from rfl]
    have : Module.Finite R' (TensorProduct A R' B) := Module.Finite.base_change A R' B
    exact RingHom.finite_algebraMap.mpr this
  have hJl : IsLocalHom J := by
    have hmax : (Ideal.comap J (IsLocalRing.maximalIdeal (Localization.Away ε))).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal J hJf.to_isIntegral _
    have heq := IsLocalRing.eq_maximalIdeal hmax
    refine ⟨fun r hr => ?_⟩
    by_contra hnu
    have h1 : r ∈ IsLocalRing.maximalIdeal R' :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
    rw [← heq, Ideal.mem_comap] at h1
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1) hr
  have hJc : J.comp (algebraMap A R') = e'.comp (β.comp α) := by
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hcomp (α a), hJapp,
      Algebra.TensorProduct.tmul_one_eq_one_tmul]
    rfl

  obtain ⟨u, u', hul, hul', hue, hue', huu', hu'u⟩ :=
    hcmp A (IsLocalRing.maximalIdeal A) P R' e (algebraMap A R') he hR'
  obtain ⟨w, v, hwl, hvl, hwe, hve, hwv, hvw⟩ :=
    hcmp R (IsLocalRing.maximalIdeal R) Q (Localization.Away ε) k e' hk hT

  have hjeq : j = v.comp (J.comp u) := by
    have hunit : ∀ a, IsUnit ((k.comp (β.comp α)) a) ↔ a ∉ IsLocalRing.maximalIdeal A := by
      intro a
      rw [← hje, RingHom.comp_apply, isUnit_map_iff j]
      exact he.2.1 a
    refine (he.2.2 Q hk.1 _ hunit).unique ⟨hje, hjl⟩ ⟨?_, ?_⟩
    · rw [RingHom.comp_assoc, RingHom.comp_assoc, hue, hJc, ← RingHom.comp_assoc, hve]
    · haveI := RingHom.isLocalHom_comp J u
      exact RingHom.isLocalHom_comp v (J.comp u)
  refine ⟨?_, ?_⟩
  · rw [hjeq]
    exact (RingHom.Finite.of_surjective v (fun t => ⟨w t, hvw t⟩)).comp
      (hJf.comp (RingHom.Finite.of_surjective u (fun r => ⟨u' r, huu' r⟩)))
  · intro q
    obtain ⟨x, hx⟩ := hsurj (w q)
    obtain ⟨Sx, hSx⟩ := TensorProduct.exists_finset x
    refine ⟨Sx.card, fun i => u' (Sx.equivFin.symm i).1.1,
      fun i => β (Sx.equivFin.symm i).1.2, ?_⟩
    have key : q = ∑ s ∈ Sx, j (u' s.1) * k (β s.2) := by
      rw [← hvw q, ← hx, hSx, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun s _ => ?_)
      rw [hjeq, ← hve]
      simp only [RingHom.comp_apply, huu']
      rw [← map_mul, hcomp, hJapp, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        one_mul]
    rw [key, ← Finset.sum_coe_sort Sx]
    exact (Equiv.sum_comp Sx.equivFin.symm (fun s : Sx => j (u' s.1.1) * k (β s.1.2))).symm

theorem wcpa_dj_lr1k_ebnb_finite_stalk_chart : ∀ {N X : Scheme.{u}} (φ : N ⟶ X) [IsFinite φ]
    (n : ↥N) (x : ↥X) (hx : φ n = x) (T : Type u) [CommRing T]
    (eT : ↥(N.presheaf.stalk n) ≃+* T),
    ∃ (B : Type u) (_ : CommRing B) (α : ↥(X.presheaf.stalk x) →+* B) (𝔫 : Ideal B)
      (h𝔫 : 𝔫.IsMaximal) (β : B →+* T), α.Finite ∧
      @IsLocalization B _ (@Ideal.primeCompl B _ 𝔫 h𝔫.isPrime) T _ β.toAlgebra ∧
      β.comp α = eT.toRingHom.comp
        ((X.presheaf.stalkCongr (Inseparable.of_eq hx.symm)).hom ≫ φ.stalkMap n).hom :=
by
  intro N X φ _ n x hx T _ eT
  subst hx
  rw [show (X.presheaf.stalkCongr (Inseparable.of_eq (rfl : φ n = φ n).symm)).hom = 𝟙 _ from
    TopCat.Presheaf.stalkSpecializes_refl _ _, Category.id_comp]
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := φ n) (U := ⊤) trivial
  have hV : IsAffineOpen (φ ⁻¹ᵁ U) := IsAffineHom.isAffine_preimage U hU
  have hf : (φ.app U).hom.Finite := IsFinite.finite_app φ U hU
  have hnV : n ∈ φ ⁻¹ᵁ U := hxU
  letI : Algebra Γ(X, U) (X.presheaf.stalk (φ n)) := (X.presheaf.germ U (φ n) hxU).hom.toAlgebra
  letI : Algebra Γ(N, φ ⁻¹ᵁ U) (N.presheaf.stalk n) :=
    (N.presheaf.germ (φ ⁻¹ᵁ U) n hnV).hom.toAlgebra
  haveI hlocX : IsLocalization.AtPrime (X.presheaf.stalk (φ n))
      (hU.primeIdealOf ⟨φ n, hxU⟩).asIdeal := hU.isLocalization_stalk ⟨φ n, hxU⟩
  haveI hlocN : IsLocalization.AtPrime (N.presheaf.stalk n)
      (hV.primeIdealOf ⟨n, hnV⟩).asIdeal := hV.isLocalization_stalk ⟨n, hnV⟩
  set p := (hU.primeIdealOf ⟨φ n, hxU⟩).asIdeal with hp
  set q := (hV.primeIdealOf ⟨n, hnV⟩).asIdeal with hq
  set f : Γ(X, U) →+* Γ(N, φ ⁻¹ᵁ U) := (φ.app U).hom with hfdef
  have hgs : (φ.stalkMap n).hom.comp (algebraMap Γ(X, U) (X.presheaf.stalk (φ n))) =
      (algebraMap Γ(N, φ ⁻¹ᵁ U) (N.presheaf.stalk n)).comp f := by
    have := Scheme.Hom.germ_stalkMap φ U n hxU
    exact congrArg CommRingCat.Hom.hom this

  have hmx : Ideal.comap (algebraMap Γ(X, U) (X.presheaf.stalk (φ n)))
      (IsLocalRing.maximalIdeal (X.presheaf.stalk (φ n))) = p :=
    IsLocalization.AtPrime.under_maximalIdeal _ p
  have hmn : Ideal.comap (algebraMap Γ(N, φ ⁻¹ᵁ U) (N.presheaf.stalk n))
      (IsLocalRing.maximalIdeal (N.presheaf.stalk n)) = q :=
    IsLocalization.AtPrime.under_maximalIdeal _ q
  have hlh : Ideal.comap (φ.stalkMap n).hom (IsLocalRing.maximalIdeal (N.presheaf.stalk n)) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk (φ n)) :=
    ((IsLocalRing.local_hom_TFAE (φ.stalkMap n).hom).out 1 5).mp
      (inferInstance : IsLocalHom (φ.stalkMap n).hom)
  have s5 : Ideal.comap f q = p := by
    rw [← hmn, ← hmx, Ideal.comap_comap, ← hgs, ← Ideal.comap_comap, hlh]

  set M : Submonoid Γ(N, φ ⁻¹ᵁ U) := Submonoid.map f p.primeCompl with hM
  have hMq : ∀ m ∈ M, m ∉ q := by
    rintro m ⟨s, hs, rfl⟩ hmq
    apply hs
    rw [← s5]
    exact hmq
  have hdisj : Disjoint (M : Set Γ(N, φ ⁻¹ᵁ U)) (q : Set Γ(N, φ ⁻¹ᵁ U)) :=
    Set.disjoint_left.mpr hMq
  let α : X.presheaf.stalk (φ n) →+* Localization M :=
    IsLocalization.map (Localization M) f (Submonoid.le_comap_map p.primeCompl)
  have hαfin : α.Finite :=
    RingHom.finite_localizationPreserves f p.primeCompl (X.presheaf.stalk (φ n))
      (Localization M) hf
  set 𝔫 : Ideal (Localization M) := Ideal.map (algebraMap Γ(N, φ ⁻¹ᵁ U) (Localization M)) q
    with h𝔫def
  haveI h𝔫p : 𝔫.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M _ q inferInstance hdisj
  have h𝔫c : Ideal.comap (algebraMap Γ(N, φ ⁻¹ᵁ U) (Localization M)) 𝔫 = q :=
    IsLocalization.under_map_of_isPrime_disjoint M _ inferInstance hdisj
  have hcα : Ideal.comap α 𝔫 = IsLocalRing.maximalIdeal (X.presheaf.stalk (φ n)) := by
