  have s5lin : ∀ (kf E : Type u) [Field kf] [AddCommGroup E] [Module kf E] (n : ℕ)
      (M : Matrix (Fin n) (Fin n) kf) (w : Fin n → E),
      (∀ y : E, ∃ c : Fin n → kf, ∑ l, c l • w l = y) → (∀ j : Fin n, ∑ l, M l j • w l = 0) →
      ∀ j : ℕ, j < Module.finrank kf E → M.charpoly.coeff j = 0 := by
    intro kf E _ _ _ n M w hspan hrel j hj
    let T : (Fin n → kf) →ₗ[kf] E :=
      { toFun := fun c => ∑ l, c l • w l
        map_add' := fun c d => by simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun a c => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply] }
    have hT : ∀ c, T c = ∑ l, c l • w l := fun c => rfl
    have hsurj : Function.Surjective T := fun y => by
      obtain ⟨c, hc⟩ := hspan y
      exact ⟨c, hc⟩
    haveI : Module.Finite kf E := Module.Finite.of_surjective T hsurj
    let S := LinearMap.ker T
    have hcol : ∀ c, Matrix.toLin' M c ∈ S := by
      intro c
      show T (Matrix.toLin' M c) = 0
      rw [hT, Matrix.toLin'_apply]
      simp only [Matrix.mulVec, dotProduct]
      simp_rw [Finset.sum_smul]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      calc ∑ x, (M x i * c i) • w x = c i • ∑ l, M l i • w l := by
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl (fun l _ => ?_)
            rw [smul_smul, mul_comm]
        _ = 0 := by rw [hrel i, smul_zero]
    have hdim := LinearMap.finrank_range_add_finrank_ker T
    rw [LinearMap.range_eq_top.mpr hsurj, finrank_top, Module.finrank_fin_fun] at hdim
    set m := Module.finrank kf S with hm
    let b₀ := Module.finBasis kf S
    let g := (Matrix.toLin' M).codRestrict S hcol
    have hfac : Matrix.toLin' M = S.subtype ∘ₗ g :=
      (LinearMap.subtype_comp_codRestrict _ _ _).symm
    let A : Matrix (Fin n) (Fin m) kf := LinearMap.toMatrix b₀ (Pi.basisFun kf (Fin n)) S.subtype
    let C : Matrix (Fin m) (Fin n) kf := LinearMap.toMatrix (Pi.basisFun kf (Fin n)) b₀ g
    have hMAC : M = A * C := by
      rw [← LinearMap.toMatrix_comp, ← hfac, LinearMap.toMatrix_eq_toMatrix',
        LinearMap.toMatrix'_toLin']
    have hle : Fintype.card (Fin m) ≤ Fintype.card (Fin n) := by
      simp only [Fintype.card_fin]; omega
    have hcm := Matrix.charpoly_mul_comm_of_le A C hle
    rw [hMAC]
    erw [hcm]
    rw [Polynomial.coeff_X_pow_mul', if_neg]
    simp only [Fintype.card_fin]
    omega



