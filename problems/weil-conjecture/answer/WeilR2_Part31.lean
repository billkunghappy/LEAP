    intro z
    obtain ⟨p, d, hd, hpd⟩ := hgen z
    exact ⟨p, d, hd, hpd⟩

theorem wcpa_dj_lr1k_eb_rd_rescale_twist : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L] [Algebra.IsSeparable (RatFunc Ω) L] (c : Ω), c ≠ 0 → ∃ φ : RatFunc Ω →+* L, (∀ w : Ω, φ (algebraMap Ω (RatFunc Ω) w) = algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w)) ∧ φ RatFunc.X = algebraMap (RatFunc Ω) L (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) ∧ (∀ V' : ValuationSubring L, (∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ V' ↔ wcEbAnInOc W c f) → (V'.comap φ).toSubring = wcEbGauss W) ∧ ∀ (ι : RatFunc Ω →+* L), ι = algebraMap (RatFunc Ω) L → ∀ (z : L) (P : Polynomial (RatFunc Ω)), P = LinearMap.charpoly (Algebra.lmul (RatFunc Ω) L z) → (letI : Algebra (RatFunc Ω) L := φ.toAlgebra; ∃ (_ : FiniteDimensional (RatFunc Ω) L), Algebra.IsSeparable (RatFunc Ω) L ∧ ∀ j : ℕ, φ ((LinearMap.charpoly (Algebra.lmul (RatFunc Ω) L z)).coeff j) = ι (P.coeff j)) :=
