        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} ∧
      RingHom.ker σ'O.appTop.hom = Ideal.span {m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0 - MvPolynomial.C c'))} :=
by
  intro Ω _ W Z uu σ σ' huu hσ hσ' hpt hex
  obtain ⟨W₁, hxW₁, hW₁⟩ := hex
  haveI := huu
  haveI : IsClosedImmersion (σ ≫ uu) := by rw [hσ]; infer_instance
  haveI hσci : IsClosedImmersion σ := IsClosedImmersion.of_comp σ uu
  haveI : IsClosedImmersion (σ' ≫ uu) := by rw [hσ']; infer_instance
  haveI hσ'ci : IsClosedImmersion σ' := IsClosedImmersion.of_comp σ' uu



  have chart_at_section : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)) (Δ : Spec (.of R) ⟶ Z), Δ ≫ uu = 𝟙 _ → ∀ (W₁ : Z.Opens), SmoothOfRelativeDimension 1 (W₁.ι ≫ uu) → Δ (IsLocalRing.closedPoint R) ∈ W₁ → ∃ (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) R →+* Γ(Z, V)), IsAffineOpen V ∧ Δ (IsLocalRing.closedPoint R) ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom ∧ Function.Bijective ((Δ.app V).hom.comp (g.comp MvPolynomial.C)) := by
    intro R _ _ Z uu Δ hΔ W₁ hW₁ hΔW₁
    have chart_open : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S) (W : Z.Opens), SmoothOfRelativeDimension 1 (W.ι ≫ uu) → ∀ z ∈ W, ∃ (U : S.Opens) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ U) (g : MvPolynomial (Fin 1) Γ(S, U) →+* Γ(Z, V)), IsAffineOpen U ∧ IsAffineOpen V ∧ z ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE U V hle).hom := by
      intro Z S uu W hsm z hz
      have := hsm
      obtain ⟨U₀, hU₀, V₀, hV₀, hzV₀, e, hstd⟩ :=
        SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1) (f := W.ι ≫ uu)
          (⟨z, hz⟩ : W.toScheme)
      obtain ⟨g₀, hg₀C, hg₀⟩ := hstd.exists_etale_mvPolynomial
      have hle : W.ι ''ᵁ V₀ ≤ uu ⁻¹ᵁ U₀ := by
        intro y hy
        have hy' : y ∈ (W.ι ''ᵁ V₀ : Set Z) := hy
        rw [Scheme.Hom.coe_image] at hy'
        obtain ⟨x, hx, rfl⟩ := hy'
        have h1 : x ∈ (W.ι ≫ uu) ⁻¹ᵁ U₀ := e hx
        rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h1
        exact h1
      have key : (W.ι ≫ uu).appLE U₀ V₀ e = uu.appLE U₀ (W.ι ''ᵁ V₀) hle := by
        rw [Scheme.Hom.comp_appLE]
        have h := Scheme.Opens.ι_appLE W (uu ⁻¹ᵁ U₀) V₀ (by exact e)
        rw [h, Scheme.Hom.appLE]
        rfl
      refine ⟨U₀, W.ι ''ᵁ V₀, hle, g₀, hU₀, hV₀.image_of_isOpenImmersion W.ι, ?_, hg₀, ?_⟩
      · have h2 := (Scheme.Hom.apply_mem_image_iff W.ι).mpr hzV₀
        simpa using h2
      · exact hg₀C.trans (congrArg CommRingCat.Hom.hom key)
    have chart_shrink : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S) (τ : S ⟶ Z), τ ≫ uu = 𝟙 S → ∀ (U₀ : S.Opens) (V₁ : Z.Opens) (e₁ : V₁ ≤ uu ⁻¹ᵁ U₀) (g₁ : MvPolynomial (Fin 1) Γ(S, U₀) →+* Γ(Z, V₁)), IsAffineOpen U₀ → IsAffineOpen V₁ → g₁.Etale → g₁.comp MvPolynomial.C = (uu.appLE U₀ V₁ e₁).hom → ∀ p : S, τ p ∈ V₁ → ∃ (U : S.Opens) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ U) (g : MvPolynomial (Fin 1) Γ(S, U) →+* Γ(Z, V)), IsAffineOpen U ∧ IsAffineOpen V ∧ τ p ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE U V hle).hom ∧ Function.Bijective ((τ.app V).hom.comp (uu.appLE U V hle).hom) := by
      intro Z S uu τ h U₀ V₁ e₁ g₁ hU₀ hV₁ hg₁ hg₁C p hp
      have hpt : ∀ x : S, uu (τ x) = x := by
        intro x
        rw [← Scheme.Hom.comp_apply, h]
        rfl
      have hpU₀ : p ∈ U₀ := by
        have h1 : τ p ∈ uu ⁻¹ᵁ U₀ := e₁ hp
        rw [Scheme.Hom.mem_preimage, hpt] at h1
        exact h1
      have hpτ : p ∈ τ ⁻¹ᵁ V₁ := hp
      obtain ⟨c, hc, hpc⟩ := hU₀.exists_basicOpen_le (V := τ ⁻¹ᵁ V₁) ⟨p, hpτ⟩ hpU₀
      have hVeq : Z.basicOpen ((uu.appLE U₀ V₁ e₁).hom c) = V₁ ⊓ uu ⁻¹ᵁ S.basicOpen c :=
        Scheme.basicOpen_appLE uu V₁ U₀ e₁ c
      set V := Z.basicOpen ((uu.appLE U₀ V₁ e₁).hom c) with hVdef
      have hle : V ≤ uu ⁻¹ᵁ S.basicOpen c := by rw [hVeq]; exact inf_le_right
      have hpV : τ p ∈ V := by
        rw [hVeq]
        refine ⟨hp, ?_⟩
        show uu (τ p) ∈ S.basicOpen c
        rw [hpt]; exact hpc
      have hτV : τ ⁻¹ᵁ V = S.basicOpen c := by
        ext x
        rw [hVeq]
        constructor
        · rintro ⟨_, h2⟩
          have h3 : uu (τ x) ∈ S.basicOpen c := h2
          rw [hpt] at h3
          exact h3
        · intro hx
          refine ⟨hc hx, ?_⟩
          show uu (τ x) ∈ S.basicOpen c
          rw [hpt]; exact hx
      have hbij : Function.Bijective ((τ.app V).hom.comp (uu.appLE (S.basicOpen c) V hle).hom) := by
        have key : ∀ (f : S ⟶ S) (W : S.Opens) (e : W ≤ f ⁻¹ᵁ S.basicOpen c), f = 𝟙 S →
            W = S.basicOpen c → Function.Bijective (f.appLE (S.basicOpen c) W e).hom := by
          intro f W e hf hW
          subst hf
          subst hW
          have h1 : (𝟙 S : S ⟶ S).appLE (S.basicOpen c) (S.basicOpen c) e = 𝟙 _ := by
            rw [Scheme.Hom.appLE]
            erw [Scheme.Hom.id_app, Category.id_comp]
            exact S.presheaf.map_id (Opposite.op (S.basicOpen c))
          rw [h1, CommRingCat.hom_id]
          exact Function.bijective_id
        rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
        exact key _ _ _ h hτV
      haveI hlocS : IsLocalization.Away c Γ(S, S.basicOpen c) := hU₀.isLocalization_basicOpen c
      haveI hlocZ : IsLocalization.Away ((uu.appLE U₀ V₁ e₁).hom c) Γ(Z, V) :=
        hV₁.isLocalization_basicOpen _
      letI : Algebra (MvPolynomial (Fin 1) Γ(S, U₀)) (MvPolynomial (Fin 1) Γ(S, S.basicOpen c)) :=
        MvPolynomial.algebraMvPolynomial
      let M : Submonoid (MvPolynomial (Fin 1) Γ(S, U₀)) :=
        Submonoid.map MvPolynomial.C (Submonoid.powers c)
      haveI hM : IsLocalization M (MvPolynomial (Fin 1) Γ(S, S.basicOpen c)) :=
        MvPolynomial.isLocalization (Submonoid.powers c) _
      have hMmap : M.map g₁ = Submonoid.powers ((uu.appLE U₀ V₁ e₁).hom c) := by
        simp only [M, Submonoid.map_powers]
        rw [← hg₁C]
        rfl
      haveI hM2 : IsLocalization (M.map g₁) Γ(Z, V) := by rw [hMmap]; exact hlocZ
      let g : MvPolynomial (Fin 1) Γ(S, S.basicOpen c) →+* Γ(Z, V) :=
        IsLocalization.map (M := M) (T := M.map g₁) Γ(Z, V) g₁ (Submonoid.le_comap_map M)
      have hgEt : g.Etale :=
        RingHom.Etale.isStableUnderBaseChange.localizationPreserves g₁ M _ _ hg₁
      have hgC : g.comp MvPolynomial.C = (uu.appLE (S.basicOpen c) V hle).hom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers c)
        ext b
        simp only [RingHom.comp_apply]
        have e1 : MvPolynomial.C (algebraMap Γ(S, U₀) Γ(S, S.basicOpen c) b) =
            algebraMap (MvPolynomial (Fin 1) Γ(S, U₀)) (MvPolynomial (Fin 1) Γ(S, S.basicOpen c))
              (MvPolynomial.C b) := by
          rw [MvPolynomial.algebraMap_def, MvPolynomial.map_C]
        rw [e1]
        show IsLocalization.map (M := M) (T := M.map g₁) Γ(Z, V) g₁ (Submonoid.le_comap_map M)
          (algebraMap _ _ (MvPolynomial.C b)) = _
        rw [IsLocalization.map_eq]
        have e2 : g₁ (MvPolynomial.C b) = (uu.appLE U₀ V₁ e₁).hom b := by rw [← hg₁C]; rfl
        rw [e2]
        have e3 : uu.appLE U₀ V₁ e₁ ≫ Z.presheaf.map (homOfLE (Z.basicOpen_le _)).op =
            S.presheaf.map (homOfLE (S.basicOpen_le c)).op ≫ uu.appLE (S.basicOpen c) V hle := by
          rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
        exact congrArg (fun φ => φ.hom b) e3
      exact ⟨S.basicOpen c, V, hle, g, hU₀.basicOpen c, hV₁.basicOpen _, hpV, hgEt, hgC, hbij⟩
    obtain ⟨U₀, V₁, e₁, g₁, hU₀, hV₁, hzV₁, hg₁, hg₁C⟩ :=
      chart_open uu W₁ hW₁ (Δ (IsLocalRing.closedPoint R)) hΔW₁
    obtain ⟨U, V, hle, g, _hU, hV, hΔV, hg, hgC, hbij⟩ :=
      chart_shrink uu Δ hΔ U₀ V₁ e₁ g₁ hU₀ hV₁ hg₁ hg₁C (IsLocalRing.closedPoint R) hzV₁
    have hsU : IsLocalRing.closedPoint R ∈ U := by
      have h1 : Δ (IsLocalRing.closedPoint R) ∈ uu ⁻¹ᵁ U := hle hΔV
      have hpt : uu (Δ (IsLocalRing.closedPoint R)) = IsLocalRing.closedPoint R := by
        show (Δ ≫ uu) (IsLocalRing.closedPoint R) = _
        rw [hΔ]; rfl
      rw [Scheme.Hom.mem_preimage, hpt] at h1
      exact h1
    have hUtop : U = ⊤ := by
      have := Scheme.preimage_eq_top_of_closedPoint_mem (𝟙 (Spec (.of R))) (U := U) hsU
      simpa using this
    subst hUtop
    let e₀ : R ≃+* Γ(Spec (.of R), ⊤) := (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv
    have he₀ : ∀ a, e₀ a = (Scheme.ΓSpecIso (.of R)).inv.hom a := fun a => rfl
    let E : MvPolynomial (Fin 1) R ≃+* MvPolynomial (Fin 1) Γ(Spec (.of R), ⊤) :=
      MvPolynomial.mapEquiv (Fin 1) e₀
    have hEC : ∀ a, E (MvPolynomial.C a) = MvPolynomial.C (e₀ a) := fun a => by
      show MvPolynomial.map (e₀ : R →+* Γ(Spec (.of R), ⊤)) (MvPolynomial.C a) = _
      rw [MvPolynomial.map_C]
      rfl
    refine ⟨V, hle, g.comp E.toRingHom, hV, hΔV, RingHom.Etale.respectsIso.2 g E hg, ?_, ?_⟩
    · ext a
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, hEC]
      rw [← he₀]
      exact congrArg (fun φ => φ (e₀ a)) hgC
    · have hfun : ⇑((Δ.app V).hom.comp ((g.comp E.toRingHom).comp MvPolynomial.C)) =
          ⇑((Δ.app V).hom.comp (uu.appLE ⊤ V hle).hom) ∘ ⇑e₀ := by
        funext a
        simp only [RingHom.comp_apply, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, hEC]
        congr 1
        exact congrArg (fun φ => φ (e₀ a)) hgC
      rw [hfun]
      exact hbij.comp e₀.bijective



  have ker_fg : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale → Function.Bijective (θ.comp (g.comp MvPolynomial.C)) → (RingHom.ker θ).FG := by
    intro R A B _ _ _ g θ hg hbij
    have hfp : (g.comp MvPolynomial.C).FinitePresentation := by
      have h1 : g.FinitePresentation := by
        letI := g.toAlgebra
        haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
        exact (inferInstance : Algebra.FinitePresentation (MvPolynomial (Fin 1) R) A)
      have h2 : (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R).FinitePresentation := by
        rw [← MvPolynomial.algebraMap_eq]
        exact RingHom.finitePresentation_algebraMap.mpr inferInstance
      exact RingHom.FinitePresentation.comp h1 h2
    letI : Algebra R A := (g.comp MvPolynomial.C).toAlgebra
    letI : Algebra R B := (θ.comp (g.comp MvPolynomial.C)).toAlgebra
    haveI : Algebra.FinitePresentation R A := hfp
    let θa : A →ₐ[R] B := { θ with commutes' := fun r => rfl }
    have hsurj : Function.Surjective θa := Function.Surjective.of_comp hbij.2
    haveI : Algebra.FinitePresentation R B := by
      let e : R ≃ₐ[R] B := AlgEquiv.ofBijective (Algebra.ofId R B) hbij
      exact Algebra.FinitePresentation.equiv e
    exact Algebra.FinitePresentation.ker_fG_of_surjective θa hsurj
  have localizer : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale → Function.Bijective (θ.comp (g.comp MvPolynomial.C)) → θ (g (MvPolynomial.X 0)) = 0 → ∃ r : A, θ r = 1 ∧ ∀ x ∈ RingHom.ker θ, ∃ y : A, r * x = y * g (MvPolynomial.X 0) := by
    intro R A B _ _ _ g θ hg hbij hθ0
    have hFG := ker_fg g θ hg hbij
    have s2 : ∀ a : R, θ (g (MvPolynomial.C a)) = θ (g (MvPolynomial.X 0)) →
        RingHom.ker θ ≤ RingHom.ker θ ^ 2 ⊔
          Ideal.span {g (MvPolynomial.X 0 - MvPolynomial.C a)} := by
      intro a ha
      letI := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
      set e := RingEquiv.ofBijective _ hbij with he
      have he_apply : ∀ c, e c = θ (g (MvPolynomial.C c)) := fun c => rfl
      set J := RingHom.ker θ with hJ
      set I₀ := J ^ 2 ⊔ Ideal.span {g (MvPolynomial.X 0 - MvPolynomial.C a)} with hI₀
      let q := Ideal.Quotient.mk I₀
      let σ : A →+* A := (g.comp MvPolynomial.C).comp ((e.symm : B →+* R).comp θ)
      have hσ : ∀ x, σ x = g (MvPolynomial.C (e.symm (θ x))) := fun x => rfl
      have hσθ : ∀ x, θ (σ x) = θ x := by
        intro x
        rw [hσ, ← he_apply, e.apply_symm_apply]
      have hcomm : (q.comp σ).comp g = q.comp g := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply]
          rw [hσ, ← he_apply, e.symm_apply_apply]
        · intro i
          have hi : i = 0 := Subsingleton.elim _ _
          subst hi
          simp only [RingHom.comp_apply]
          rw [hσ, ← ha, ← he_apply, e.symm_apply_apply]
          refine (Ideal.Quotient.eq.mpr ?_).symm
          rw [← map_sub]
          exact Ideal.mem_sup_right (Ideal.subset_span rfl)
      let q₂ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I₀ :=
        { q.comp σ with
          commutes' := fun P => by
            have := congrArg (fun f => f P) hcomm
            simp only [RingHom.comp_apply] at this
            exact this }
      have hq₂ : ∀ x, q₂ x = q (σ x) := fun x => rfl
      have hnil : IsNilpotent (J.map q) := by
        refine ⟨2, ?_⟩
        rw [← Ideal.map_pow]
        have h1 : Ideal.map q (J ^ 2) ≤ Ideal.map q I₀ := Ideal.map_mono le_sup_left
        have h2 : Ideal.map q I₀ = ⊥ := by
          rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        rw [h2] at h1
        exact le_bot_iff.mp h1
      have hext := Algebra.FormallyUnramified.ext (R := MvPolynomial (Fin 1) R) (J.map q) hnil
        (g₁ := Ideal.Quotient.mkₐ (MvPolynomial (Fin 1) R) I₀) (g₂ := q₂) (fun x => by
          rw [Ideal.Quotient.eq, hq₂, Ideal.Quotient.mkₐ_eq_mk]
          show q x - q (σ x) ∈ _
          rw [← map_sub]
          apply Ideal.mem_map_of_mem
          rw [RingHom.mem_ker, map_sub, hσθ, sub_self])
      intro x hx
      have h1 := congrArg (fun f => f x) hext
      simp only [Ideal.Quotient.mkₐ_eq_mk, hq₂, hσ] at h1
      rw [RingHom.mem_ker.mp hx, map_zero, map_zero, map_zero, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have s3 : ∀ (J : Ideal A) (t : A), J.FG → J ≤ J ^ 2 ⊔ Ideal.span {t} →
        ∃ r : A, r - 1 ∈ J ∧ ∀ x ∈ J, ∃ y : A, r * x = y * t := by
      intro J t hFG hle
      set K : Ideal A := Ideal.span {t} with hK
      let π := Submodule.mkQ K
      let N : Submodule A (A ⧸ K) := Submodule.map π J
      have hNfg : N.FG := Submodule.FG.map π hFG
      have hNle : N ≤ J • N := by
        rintro _ ⟨x, hx, rfl⟩
        obtain ⟨j, hj, w, hw, hjw⟩ := Submodule.mem_sup.mp (hle hx)
        have hπ : π x = π j := by
          rw [← hjw, map_add]
          have : π w = 0 := (Submodule.Quotient.mk_eq_zero K).mpr hw
          rw [this, add_zero]
        show π x ∈ J • N
        rw [hπ]
        have hj' : j ∈ J • J := by rwa [Ideal.smul_eq_mul, ← pow_two]
        have := Submodule.mem_map_of_mem (f := π) hj'
        rwa [Submodule.map_smul''] at this
      obtain ⟨r, hr1, hr⟩ :=
        Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J N hNfg hNle
      refine ⟨r, hr1, fun x hx => ?_⟩
      have h1 : π (r * x) = 0 := by
        rw [← smul_eq_mul, LinearMap.map_smul]
        exact hr _ (Submodule.mem_map_of_mem hx)
      have h2 : r * x ∈ K := (Submodule.Quotient.mk_eq_zero K).mp h1
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp h2
      exact ⟨y, hy.symm⟩
    have h0 : θ (g (MvPolynomial.C 0)) = θ (g (MvPolynomial.X 0)) := by
      rw [hθ0, map_zero, map_zero, map_zero]
    have hle := s2 0 h0
    have hX : MvPolynomial.X 0 - MvPolynomial.C (0 : R) = (MvPolynomial.X 0 : MvPolynomial (Fin 1) R) := by
      rw [map_zero, sub_zero]
    rw [hX] at hle
    obtain ⟨r, hr1, hr⟩ := s3 _ _ hFG hle
    refine ⟨r, ?_, hr⟩
    have := RingHom.mem_ker.mp hr1
    rw [map_sub, map_one, sub_eq_zero] at this
    exact this



  have kernel_basicOpen : ∀ {X Y : Scheme.{u}} (τ : Y ⟶ X) [IsClosedImmersion τ] (V : X.Opens), IsAffineOpen V → ∀ (t r : Γ(X, V)), (τ.app V).hom t = 0 → (∀ x ∈ RingHom.ker (τ.app V).hom, ∃ y : Γ(X, V), r * x = y * t) → RingHom.ker (τ.app (X.basicOpen r)).hom = Ideal.span {(X.presheaf.map (homOfLE (X.basicOpen_le r)).op).hom t} := by
    intro X Y τ _ W hW t f hθt hker
    haveI hloc : IsLocalization.Away f Γ(X, X.basicOpen f) := hW.isLocalization_basicOpen f
    have hle' : τ ⁻¹ᵁ X.basicOpen f ≤ τ ⁻¹ᵁ W := fun x hx => X.basicOpen_le f hx
    have nat : ∀ a : Γ(X, W), (τ.app (X.basicOpen f)).hom (algebraMap Γ(X, W) Γ(X, X.basicOpen f) a)
        = (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom a) := by
      intro a
      have e := τ.naturality (homOfLE (X.basicOpen_le f)).op
      have := congrArg (fun φ => φ.hom a) e
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    have hfu : IsUnit (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f) :=
      IsLocalization.Away.algebraMap_isUnit f
    have halg : ∀ a, (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a =
        algebraMap Γ(X, W) Γ(X, X.basicOpen f) a := fun a => rfl
    rw [halg]
    refine le_antisymm ?_ ?_
    · intro x' hx'
      rw [RingHom.mem_ker] at hx'
      obtain ⟨⟨x0, ⟨_, n, rfl⟩⟩, hx0⟩ := IsLocalization.surj (Submonoid.powers f) x'
      simp only at hx0
      have h1 : (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom x0) = 0 := by
        rw [← nat, ← hx0, map_mul, hx', zero_mul]
      have hWY : IsAffineOpen (τ ⁻¹ᵁ W) := hW.preimage τ
      letI : Algebra Γ(Y, τ ⁻¹ᵁ W) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) :=
        (Y.presheaf.map (homOfLE hle').op).hom.toAlgebra
      haveI : IsLocalization.Away ((τ.app W).hom f) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) :=
        hWY.isLocalization_of_eq_basicOpen ((τ.app W).hom f) (homOfLE hle')
          (τ.preimage_basicOpen f)
      obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff
        (Submonoid.powers ((τ.app W).hom f)) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) ((τ.app W).hom x0)).mp h1
      simp only at hk
      obtain ⟨y, hy⟩ := hker (f ^ k * x0) (by rw [RingHom.mem_ker, map_mul, map_pow]; exact hk)
      have key : x' * (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f *
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) f ^ (k + n)) =
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * algebraMap Γ(X, W) Γ(X, X.basicOpen f) t := by
        have e := congrArg (algebraMap Γ(X, W) Γ(X, X.basicOpen f)) hy
        rw [map_mul, map_mul, map_mul, map_pow, ← hx0, map_pow] at e
        rw [← e]
        ring
      have hu := hfu.mul (hfu.pow (k + n))
      rw [Ideal.mem_span_singleton']
      refine ⟨algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * ↑hu.unit⁻¹, ?_⟩
      calc algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * ↑hu.unit⁻¹ *
            algebraMap Γ(X, W) Γ(X, X.basicOpen f) t
          = (algebraMap Γ(X, W) Γ(X, X.basicOpen f) y *
            algebraMap Γ(X, W) Γ(X, X.basicOpen f) t) * ↑hu.unit⁻¹ := by ring
        _ = x' * (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f *
            algebraMap Γ(X, W) Γ(X, X.basicOpen f) f ^ (k + n)) * ↑hu.unit⁻¹ := by rw [key]
        _ = x' := by rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat, hθt, map_zero]



  have chart_morphism : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) R →+* Γ(Z, V)), IsAffineOpen V → g.Etale → g.comp MvPolynomial.C = (uu.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom → ∀ (U : Z.Opens) (hUV : U ≤ V), ∃ m : U.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) R)), Etale m ∧ m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)) = U.ι ≫ uu ∧ ∀ P : MvPolynomial (Fin 1) R, m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom P) = U.topIso.inv.hom ((Z.presheaf.map (homOfLE hUV).op).hom (g P)) := by
    intro R _ Z uu V hle g hV hg hgC U hUV
    have hSpec : Etale (Spec.map (CommRingCat.ofHom g)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hg
    refine ⟨Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g), inferInstance, ?_⟩
    have hE : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv ≫
        (Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop =
        CommRingCat.ofHom g ≫ Z.presheaf.map (homOfLE hUV).op ≫ U.topIso.inv := by
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← Category.assoc, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, IsAffineOpen.isoSpec_hom, Category.assoc,
        Scheme.Opens.toSpecΓ_appTop]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
      congr 1
      rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.topIso_inv]
      erw [← Functor.map_comp, ← Functor.map_comp]
      rfl
    have hEx : ∀ P, (Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom P) =
        U.topIso.inv.hom ((Z.presheaf.map (homOfLE hUV).op).hom (g P)) := by
      intro P
      have := congrArg (fun f => f.hom P) hE
      exact this
    refine ⟨?_, hEx⟩
    apply ext_of_isAffine
    have hC : (Scheme.ΓSpecIso (.of R)).inv ≫ (Spec.map (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R))).appTop =
        CommRingCat.ofHom MvPolynomial.C ≫ (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv :=
      (Scheme.ΓSpecIso_inv_naturality _).symm
    rw [← cancel_epi (Scheme.ΓSpecIso (.of R)).inv]
    ext a
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← Category.assoc, hC, Category.assoc]
    change (Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.C a)) = _
    rw [hEx]
    have hga : g (MvPolynomial.C a) = (uu.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of R)).inv.hom a) := by
      have := congrArg (fun f => f a) hgC
      exact this
    rw [hga]
    change ((uu.appLE ⊤ V hle ≫ Z.presheaf.map (homOfLE hUV).op ≫ U.topIso.inv).hom
        ((Scheme.ΓSpecIso (.of R)).inv.hom a)) =
      ((uu.appTop ≫ U.ι.appTop).hom ((Scheme.ΓSpecIso (.of R)).inv.hom a))
    congr 2
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv, Scheme.Hom.appLE, Scheme.Hom.appTop,
      Category.assoc]
    congr 1
    erw [← Functor.map_comp, ← Functor.map_comp]
    rfl



  have ker_open_lift : ∀ (X T : Scheme.{u}) (U : X.Opens) (Δ : T ⟶ X) (ΔU : T ⟶ U.toScheme), ΔU ≫ U.ι = Δ → ∀ h : Γ(X, U), RingHom.ker (Δ.app U).hom = Ideal.span {h} → RingHom.ker ΔU.appTop.hom = Ideal.span {U.topIso.inv.hom h} := by
    intro X T U Δ ΔU hΔU h hker
    subst hΔU
    have e1 : (ΔU ≫ U.ι).app U = U.ι.app U ≫ ΔU.app (U.ι ⁻¹ᵁ U) := Scheme.Hom.comp_app _ _ _
    have e2 := Scheme.Hom.app_eq ΔU (Scheme.Opens.ι_preimage_self U)
    rw [e2] at e1
    have e3 : U.ι.app U ≫ U.toScheme.presheaf.map (eqToHom (Scheme.Opens.ι_preimage_self U).symm).op =
        U.topIso.inv := by
      rw [Scheme.Opens.topIso_inv, Scheme.Opens.ι_app_self]
      erw [← Functor.map_comp]
      congr 1
    rw [← Category.assoc, e3] at e1
    set κ := T.presheaf.map (eqToHom (congrArg (fun V => ΔU ⁻¹ᵁ V) (Scheme.Opens.ι_preimage_self U))).op
      with hκ
    have hκinj : Function.Injective κ.hom := by
      have : IsIso κ := by rw [hκ]; infer_instance
      exact (ConcreteCategory.bijective_of_isIso κ).1
    have key : ∀ x, ((ΔU ≫ U.ι).app U).hom x = κ.hom (ΔU.appTop.hom (U.topIso.inv.hom x)) := by
      intro x
      rw [e1]
      rfl
    ext y
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    have hy : y = U.topIso.inv.hom (U.topIso.hom.hom y) :=
      (CategoryTheory.Iso.hom_inv_id_apply U.topIso y).symm
    constructor
    · intro h0
      have h1 : U.topIso.hom.hom y ∈ RingHom.ker ((ΔU ≫ U.ι).app U).hom := by
        rw [RingHom.mem_ker, key, ← hy, h0]
        exact map_zero _
      rw [hker, Ideal.mem_span_singleton'] at h1
      obtain ⟨b, hb⟩ := h1
      refine ⟨U.topIso.inv.hom b, ?_⟩
      rw [← map_mul, hb, ← hy]
    · rintro ⟨b, hb⟩
      have h1 : U.topIso.hom.hom y ∈ RingHom.ker ((ΔU ≫ U.ι).app U).hom := by
        rw [hker, Ideal.mem_span_singleton']
        refine ⟨U.topIso.hom.hom b, ?_⟩
        rw [← hb, map_mul]
        congr 1
        exact (CategoryTheory.Iso.inv_hom_id_apply U.topIso h).symm
      rw [RingHom.mem_ker, key, ← hy] at h1
      apply hκinj
      rw [h1]
      exact (map_zero _).symm



  have section_eval : ∀ (R : Type u) [CommRing R] (σ : Spec (.of R) ⟶ Spec (.of (MvPolynomial (Fin 1) R))), σ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)) = 𝟙 _ → σ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (Scheme.ΓSpecIso (.of R)).hom.hom (σ.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)))))) := by
    intro R _ σ hσ
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = σ := ⟨Spec.preimage σ, Spec.map_preimage σ⟩
    have hC : CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R) ≫ φ = 𝟙 _ := by
      apply Spec.map_injective
