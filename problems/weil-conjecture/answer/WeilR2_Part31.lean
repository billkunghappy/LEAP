by
  intro Ω _ _ W hW hWt X uX ι hM x w hwx hSm σ a σ' b d hP hP' hIeq had hd0 hdm X₁ r₁ ι₁ hbl₁
    hι₁ hM₁ σ₁ σt hσ₁ hσt hne w₁ hw₁ hsm₁ X₂ r₂ ι₂ hbl₂ hι₂ hM₂ V₂ hV₂ hiso₂ Xa ra ιa hbla hιa
    hMa q hq hιq hInv p₂ hp₂ wa hwa
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
