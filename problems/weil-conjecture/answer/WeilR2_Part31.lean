by
  intro Ω _ W g hg B _ _ φ hH
  classical
  have hx0d : (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})) (MvPolynomial.X 0) = wcEbntX W g 0 := rfl
  have hx1d : (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})) (MvPolynomial.X 1) = wcEbntX W g 1 := rfl
  have hXX : wcEbntX W g 0 * wcEbntX W g 1 =
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) g := by
    rw [← hx0d, ← hx1d, RingHom.comp_apply, ← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  set c := ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) with hc
  set ev : Polynomial ↥W →+* wcEbntN W g := Polynomial.eval₂RingHom c (wcEbntX W g 0) with hev
  have e2 : ev Polynomial.X = wcEbntX W g 0 := Polynomial.eval₂_X _ _
  have e3 : ∀ a : ↥W, ev (Polynomial.C a) = c a := fun a => Polynomial.eval₂_C _ _
  have e5 : ∀ r : Polynomial ↥W,
      φ (ev r) = Polynomial.eval₂ (φ.comp c) (φ (wcEbntX W g 0)) r := fun r =>
    Polynomial.hom_eval₂ _ _ _ _
  have habs : ∀ F : MvPolynomial (Fin 2) ↥W, ∃ (k : ℕ) (r : Polynomial ↥W),
      wcEbntX W g 0 ^ k * (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})) F = ev r := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C a =>
      refine ⟨0, Polynomial.C a, ?_⟩
      rw [pow_zero, one_mul, e3, hc, RingHom.comp_apply]
    | add p q hp hq =>
      obtain ⟨k₁, r₁, h₁⟩ := hp
      obtain ⟨k₂, r₂, h₂⟩ := hq
      refine ⟨k₁ + k₂, Polynomial.X ^ k₂ * r₁ + Polynomial.X ^ k₁ * r₂, ?_⟩
      rw [map_add ev, map_mul ev, map_mul ev, map_pow ev, map_pow ev, e2, ← h₁, ← h₂, map_add]
      ring
    | mul_X p n hp =>
      obtain ⟨k, r, h⟩ := hp
      have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      rcases hn with rfl | rfl
      · refine ⟨k, r * Polynomial.X, ?_⟩
        rw [map_mul ev, e2, ← h, map_mul, hx0d]
        ring
      · refine ⟨k + 1, Polynomial.C g * r, ?_⟩
        rw [map_mul ev, e3, ← h, map_mul, hx1d, ← hXX]
        ring
  have hnzd : ∀ t : wcEbntN W g, wcEbntX W g 0 * t = 0 → t = 0 := by
    intro t ht
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective t
    rw [← hx0d, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at ht
    obtain ⟨G, hG⟩ := ht
    have hp : Prime (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) := MvPolynomial.X_prime
    have hdvd : (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) ∣
        G * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) := ⟨F, hG⟩
    rcases hp.dvd_or_dvd hdvd with ⟨G', hG'⟩ | hf
    · rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
      refine ⟨G', ?_⟩
      have h3 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) *
          (G' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g)) =
          MvPolynomial.X 0 * F := by
        rw [← hG, hG']; ring
      exact mul_left_cancel₀ hp.ne_zero h3
    · exfalso
      have h2 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) ∣ MvPolynomial.C g := by
        have e : (MvPolynomial.C g : MvPolynomial (Fin 2) ↥W) =
            MvPolynomial.X 0 * MvPolynomial.X 1 -
              (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) := by ring
        rw [e]
        exact dvd_sub (dvd_mul_right _ _) hf
      obtain ⟨h', hh'⟩ := h2
      have h4 := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (0 : ↥W))) hh'
      simp only [MvPolynomial.eval_C, map_mul, MvPolynomial.eval_X, zero_mul] at h4
      exact hg h4
  have hpow : ∀ (k : ℕ) (t : wcEbntN W g), wcEbntX W g 0 ^ k * t = 0 → t = 0 := by
    intro k
    induction k with
    | zero => intro t h; simpa using h
    | succ k ih =>
      intro t h
      apply ih
      apply hnzd
      rw [← mul_assoc, ← pow_succ']
      exact h
  rw [injective_iff_map_eq_zero]
  intro t ht
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective t
  obtain ⟨k, r, hkr⟩ := habs F
  have hr : r = 0 := by
    apply hH
    rw [← e5, ← hkr, map_mul, ht, mul_zero]
  rw [hr, map_zero] at hkr
  exact hpow k _ hkr

theorem wcpa_dj_lr1k_ebnt_integral_divides : ∀ (P Q : Type u) [CommRing P] [IsDomain P] [IsIntegrallyClosed P] [CommRing Q] (j : P →+* Q), Function.Injective j → j.IsIntegral → ∀ p r : P, p ≠ 0 → j r ∈ Ideal.span {j p} → r ∈ Ideal.span {p} :=
by
  intro P Q _ _ _ _ j hj hint p r hp hr
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hr
  obtain ⟨f, hfm, hfa⟩ := hint a
  have hE : Polynomial.eval r (f.scaleRoots p) = 0 := by
    apply hj
    rw [map_zero, ← Polynomial.eval₂_at_apply, ← ha, mul_comm a,
      Polynomial.scaleRoots_eval₂_mul, hfa, mul_zero]
  set K := FractionRing P
  have hι : Function.Injective (algebraMap P K) := IsFractionRing.injective P K
  have hpK : algebraMap P K p ≠ 0 := (map_ne_zero_iff _ hι).mpr hp
  set x : K := algebraMap P K r / algebraMap P K p with hx
  have hpx : algebraMap P K p * x = algebraMap P K r := by
    rw [hx, mul_comm]
    exact div_mul_cancel₀ _ hpK
  have hxi : IsIntegral P x := by
    refine ⟨f, hfm, ?_⟩
    have h1 := Polynomial.scaleRoots_eval₂_mul (p := f) (algebraMap P K) x p
    rw [hpx, Polynomial.eval₂_at_apply, hE, map_zero] at h1
    exact (mul_eq_zero.mp h1.symm).resolve_left (pow_ne_zero _ hpK)
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (K := K)).mp hxi
  refine Ideal.mem_span_singleton'.mpr ⟨y, ?_⟩
  apply hι
  rw [map_mul, hy, mul_comm, hpx]

theorem wcpa_dj_lr1k_ebnt_j2_integral : ∀ (P₁ P₂ Q₁ Q₂ : Type u) [CommRing P₁] [CommRing P₂] [CommRing Q₁] [CommRing Q₂] (h : P₁ →+* P₂) (j₁ : P₁ →+* Q₁) (j₂ : P₂ →+* Q₂) (κ : Q₁ →+* Q₂), κ.comp j₁ = j₂.comp h → j₁.Finite → (∀ q : Q₂, ∃ p : Polynomial Q₂, p.Monic ∧ (∀ i, p.coeff i ∈ κ.range ⊔ j₂.range) ∧ p.eval q = 0) → j₂.IsIntegral :=
by
  intro P₁ P₂ Q₁ Q₂ _ _ _ _ h j₁ j₂ κ hcomm hfin hint
  letI : Algebra P₂ Q₂ := j₂.toAlgebra
  have hj₁ : j₁.IsIntegral := RingHom.IsIntegral.of_finite hfin
  have hκ : ∀ q₁ : Q₁, IsIntegral P₂ (κ q₁) := by
    intro q₁
    have h1 := (hj₁ q₁).map κ
    rw [hcomm] at h1
    exact RingHom.IsIntegralElem.of_comp h1
  have hA : κ.range ⊔ j₂.range ≤ (integralClosure P₂ Q₂).toSubring := by
    apply sup_le
    · rintro _ ⟨q, rfl⟩
      exact Subalgebra.mem_toSubring.mpr (hκ q)
    · rintro _ ⟨p, rfl⟩
      exact Subalgebra.mem_toSubring.mpr
        (isIntegral_algebraMap (R := P₂) (A := Q₂) (x := p))
  intro q
  obtain ⟨p, hpm, hpc, hpq⟩ := hint q
  have hlift : p ∈ Polynomial.lifts (algebraMap (integralClosure P₂ Q₂) Q₂) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    exact ⟨⟨p.coeff n, hA (hpc n)⟩, rfl⟩
  obtain ⟨p₀, hp₀map, -, hp₀m⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
  have hq : IsIntegral (integralClosure P₂ Q₂) q := by
    refine ⟨p₀, hp₀m, ?_⟩
    rw [Polynomial.eval₂_eq_eval_map, hp₀map]
    exact hpq
  exact isIntegral_trans q hq

theorem wcpa_dj_lr1k_ebnt_hens_transport : ∀ (A H Q : Type u) [CommRing A] [CommRing H] [CommRing Q] (p : Ideal A) (e : A →+* H) (φ : H →+* Q), wcNdIsHens p H e → Function.Bijective φ → wcNdIsHens p Q (φ.comp e) :=
by
  intro A H Q _ _ _ p e φ hHens hφ
  obtain ⟨hH, hunit, huniv⟩ := hHens
  set ψ : H ≃+* Q := RingEquiv.ofBijective φ hφ with hψdef
  have hψφ : ∀ x, ψ x = φ x := fun x => rfl
  have hφu : ∀ x : H, IsUnit (φ x) ↔ IsUnit x := fun x => by
    rw [← hψφ]; exact isUnit_map_iff ψ x
  have hψsu : ∀ y : Q, IsUnit (ψ.symm y) ↔ IsUnit y := fun y => isUnit_map_iff ψ.symm y
  have hφs : ∀ y : Q, φ (ψ.symm y) = y := fun y => by
    rw [← hψφ]; exact ψ.apply_symm_apply y
  have hsφ : ∀ x : H, ψ.symm (φ x) = x := fun x => by
    rw [← hψφ]; exact ψ.symm_apply_apply x
  haveI : IsLocalHom φ := ⟨fun x hx => (hφu x).mp hx⟩
  haveI : IsLocalHom (ψ.symm : Q →+* H) := ⟨fun y hy => (hψsu y).mp hy⟩
  haveI := hH
  haveI hQl : IsLocalRing Q := ψ.isLocalRing
  have hev : ∀ (q : Polynomial Q) (y : Q),
      (q.map (ψ.symm : Q →+* H)).eval (ψ.symm y) = ψ.symm (q.eval y) := fun q y =>
    Polynomial.eval_map_apply (ψ.symm : Q →+* H) y
  refine ⟨?_, ?_, ?_⟩
  · refine @HenselianLocalRing.mk Q _ hQl ?_
    intro f hf a₀ h1 h2
    have hgm : (f.map (ψ.symm : Q →+* H)).Monic := hf.map _
    have hg1 : (f.map (ψ.symm : Q →+* H)).eval (ψ.symm a₀) ∈ IsLocalRing.maximalIdeal H := by
      rw [hev, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hψsu]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1
      exact h1
    have hg2 : IsUnit ((f.map (ψ.symm : Q →+* H)).derivative.eval (ψ.symm a₀)) := by
      rw [Polynomial.derivative_map, hev, hψsu]
      exact h2
    obtain ⟨b, hb, hbm⟩ := HenselianLocalRing.is_henselian _ hgm _ hg1 hg2
    refine ⟨ψ b, ?_, ?_⟩
    · have h3 := hev f (ψ b)
      rw [ψ.symm_apply_apply] at h3
      have h4 : (f.map (ψ.symm : Q →+* H)).eval b = 0 := hb
      rw [h4] at h3
      have h5 : ψ.symm (f.eval (ψ b)) = ψ.symm 0 := by rw [← h3, map_zero]
      exact ψ.symm.injective h5
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hψsu, map_sub,
        ψ.symm_apply_apply]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hbm
      exact hbm
  · intro a
    rw [RingHom.comp_apply, hφu]
    exact hunit a
  · intro B _ hB g hg
    obtain ⟨h, ⟨hhe, hhl⟩, huniq⟩ := huniv B hB g hg
    haveI := hhl
    refine ⟨h.comp (ψ.symm : Q →+* H), ⟨?_, ?_⟩, ?_⟩
    · ext a
      show h (ψ.symm (φ (e a))) = g a
      rw [hsφ]
      exact RingHom.congr_fun hhe a
    · exact RingHom.isLocalHom_comp h _
    · rintro k ⟨hk, hkl⟩
      haveI := hkl
      have h1 : k.comp φ = h := huniq (k.comp φ)
        ⟨by rw [RingHom.comp_assoc]; exact hk, RingHom.isLocalHom_comp k φ⟩
      ext y
      show k y = h (ψ.symm y)
      rw [← h1, RingHom.comp_apply, hφs]

theorem wcpa_dj_lr1k_ebnt_annulus_normalization : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P₁ P₂ : Type u) [CommRing P₁] [CommRing P₂] (σ₁ : ↥W →+* P₁) (σ₂ : ↥W →+* P₂)
      (h : P₁ →+* P₂), IsLocalHom h → h.comp σ₁ = σ₂ →
    ∀ (a₁ a₂ c : ↥W) (f₁ : wcEbntN W a₁ →+* P₁) (f₂ : wcEbntN W a₂ →+* P₂),
      a₁ = c * a₂ → wcEbntPres W σ₁ a₁ f₁ → wcEbntPres W σ₂ a₂ f₂ →
      h (f₁ (wcEbntX W a₁ 0)) = f₂ (wcEbntX W a₂ 0) →
      h (f₁ (wcEbntX W a₁ 1)) = σ₂ c * f₂ (wcEbntX W a₂ 1) →
    ∀ (Q₁ Q₂ : Type u) [CommRing Q₁] [CommRing Q₂] (j₁ : P₁ →+* Q₁) (j₂ : P₂ →+* Q₂)
      (κ : Q₁ →+* Q₂),
      IsLocalHom j₁ → IsLocalHom j₂ → IsLocalHom κ → κ.comp j₁ = j₂.comp h →
      Function.Injective j₁ → j₁.Finite → Function.Injective j₂ → Function.Injective κ →
      HenselianLocalRing Q₂ → IsDomain Q₂ → IsIntegrallyClosed Q₂ →
      (∀ q : Q₂, ∃ p : Polynomial Q₂, p.Monic ∧ (∀ i, p.coeff i ∈ κ.range ⊔ j₂.range) ∧
        p.eval q = 0) →
      (∀ q : Q₂, ∃ a ∈ κ.range ⊔ j₂.range, ∃ b ∈ κ.range ⊔ j₂.range, b ≠ 0 ∧ q * b = a) →
      (wcNdModelA W Q₁ (j₁.comp σ₁) ∨ wcNdModelB W Q₁ (j₁.comp σ₁)) →
      wcNdModelB W Q₂ (j₂.comp σ₂) :=
by
  intro Ω _ _ W hW hWt P₁ P₂ _ _ σ₁ σ₂ h hhl hhσ a₁ a₂ c f₁ f₂ hac hf₁ hf₂ hx hy Q₁ Q₂ _ _
    j₁ j₂ κ hj₁l hj₂l hκl hκj hj₁i hj₁f hj₂i hκi hQ₂h hQ₂d hQ₂ic hint hfrac hAB
  classical
  haveI := hhl; haveI := hj₁l; haveI := hj₂l; haveI := hκl; haveI := hQ₂h; haveI := hQ₂d
  haveI := hQ₂ic

  have hrel : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → f (wcEbntX W c 0) * f (wcEbntX W c 1) = σ c := by
    intro P _ σ c f hf
    have h1 : (wcEbntX W c 0) * (wcEbntX W c 1) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
          (MvPolynomial.C c) := by
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [← map_mul, h1, ← hf.2.2.1]
    rfl
  have hXmem : ∀ (c : ↥W) (i : Fin 2), wcEbntX W c i ∈
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
        (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})) := by
    intro c i
    apply Ideal.mem_map_of_mem
    apply Ideal.mem_sup_left
    apply Ideal.subset_span
    fin_cases i <;> simp
  have hCmem : ∀ (c : ↥W) (t : ↥W), t ∈ IsLocalRing.maximalIdeal ↥W →
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp
        MvPolynomial.C) t ∈
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
        (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c :
          MvPolynomial (Fin 2) ↥W)})) := by
    intro c t ht
    exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ht))
  have hXnu : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → ∀ i : Fin 2, ¬ IsUnit (f (wcEbntX W c i)) := by
    intro P _ σ c f hf i hu
    exact (hf.2.2.2.2.1 _).mp hu (hXmem c i)
  have hCnu : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → ∀ t ∈ IsLocalRing.maximalIdeal ↥W, ¬ IsUnit (σ t) := by
    intro P _ σ c f hf t ht hu
    rw [← hf.2.2.1] at hu
    exact (hf.2.2.2.2.1 _).mp hu (hCmem c t ht)
  have hprime : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → p.IsPrime := by
    intro A _ p P _ e he
    haveI := he.1
    have hp : p = (IsLocalRing.maximalIdeal P).comap e := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 t, not_not]
    rw [hp]
    exact Ideal.comap_isPrime e _
  have hN : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → IsDomain P ∧ IsIntegrallyClosed P := by
    intro P _ σ c f hf
    obtain ⟨hd, hic⟩ := wcNd_nodal_poly_normal Ω W c hf.2.1
    haveI := hd; haveI := hic
    exact wcNd_hens_normal_domain _ _ (hprime _ _ _ _ hf.2.2.2) P f hf.2.2.2
  haveI : HenselianLocalRing P₁ := hf₁.2.2.2.1
  haveI : HenselianLocalRing P₂ := hf₂.2.2.2.1
  obtain ⟨hP₂d, hP₂ic⟩ := hN P₂ σ₂ a₂ f₂ hf₂
  haveI := hP₂d; haveI := hP₂ic
  have hκσ : ∀ t, κ (j₁ (σ₁ t)) = j₂ (σ₂ t) := by
    intro t
    have := RingHom.congr_fun hκj (σ₁ t)
    simp only [RingHom.comp_apply] at this
    rw [this, ← RingHom.comp_apply h σ₁, hhσ]
  have hσ₂inj : Function.Injective σ₂ := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P₂ σ₂ a₂ f₂ hf₂
  have hσinj : Function.Injective (j₂.comp σ₂) := hj₂i.comp hσ₂inj
  have hj₂int : j₂.IsIntegral :=
    wcpa_dj_lr1k_ebnt_j2_integral P₁ P₂ Q₁ Q₂ h j₁ j₂ κ hκj hj₁f hint

  obtain ⟨f₁s, hf₁s, hf₁s0, hf₁s1⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P₁ σ₁ a₁ f₁ hf₁
  obtain ⟨hb₁p, hx₁nb, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt P₁ σ₁ a₁ f₁ hf₁
  obtain ⟨hb₀p, hy₁nb, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt P₁ σ₁ a₁ f₁s hf₁s
  rw [hf₁s1] at hb₀p
  rw [hf₁s0, hf₁s1] at hy₁nb
  letI : Algebra P₁ Q₁ := j₁.toAlgebra
  haveI : Algebra.IsIntegral P₁ Q₁ := ⟨RingHom.IsIntegral.of_finite hj₁f⟩
  have hunder : ∀ 𝔟 : Ideal P₁, Ideal.under P₁ (⊥ : Ideal Q₁) ≤ 𝔟 := by
    intro 𝔟 t ht
    have h0 : j₁ t = 0 := Ideal.mem_bot.mp (Ideal.mem_comap.mp ht)
    rw [show t = 0 from hj₁i (by rw [h0, map_zero])]
