    intro k hk
    have hk' : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    have h1 : ((1 : Polynomial D) - Polynomial.X).natDegree ≤ 1 := by
      refine (Polynomial.natDegree_sub_le _ _).trans ?_
      rw [Polynomial.natDegree_one]
      exact max_le (Nat.zero_le _) Polynomial.natDegree_X_le
    have h2 : ((1 - Polynomial.X : Polynomial D) ^ k).natDegree ≤ k := by
      refine Polynomial.natDegree_pow_le.trans ?_
      calc k * _ ≤ k * 1 := Nat.mul_le_mul_left _ h1
        _ = k := mul_one k
    calc (Polynomial.C (Bd k * ld ^ (N - k)) * (1 - Polynomial.X) ^ k *
          Polynomial.X ^ (N - k)).natDegree
        ≤ (Polynomial.C (Bd k * ld ^ (N - k)) * (1 - Polynomial.X) ^ k).natDegree +
          (Polynomial.X ^ (N - k) : Polynomial D).natDegree := Polynomial.natDegree_mul_le
      _ ≤ k + (N - k) := add_le_add ((Polynomial.natDegree_C_mul_le _ _).trans h2)
          (Polynomial.natDegree_X_pow_le _)
      _ = N := Nat.add_sub_cancel' hk'
  have hc1 : ∀ k : ℕ, ((1 - Polynomial.X : Polynomial D) ^ k).coeff k = (-1) ^ k := by
    intro k
    have e : (1 - Polynomial.X : Polynomial D) ^ k =
        Polynomial.C ((-1) ^ k) * (Polynomial.X - Polynomial.C 1) ^ k := by
      rw [show (1 - Polynomial.X : Polynomial D) =
          Polynomial.C (-1) * (Polynomial.X - Polynomial.C 1) by
        rw [map_neg, map_one]; ring, mul_pow, ← map_pow]
    have hm := (Polynomial.monic_X_sub_C (1 : D)).pow k
    rw [e, Polynomial.coeff_C_mul]
    have hn : ((Polynomial.X - Polynomial.C 1 : Polynomial D) ^ k).natDegree = k := by
      rw [(Polynomial.monic_X_sub_C (1 : D)).natDegree_pow, Polynomial.natDegree_X_sub_C,
        mul_one]
