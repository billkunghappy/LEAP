theorem wcpa_dj_lr1k_ebc_dia_nonclosed_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι → ∀ y : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
    ¬ IsClosed ({y} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) →
    wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) = 0 :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y hy
  suffices key : ∀ (Z : Scheme.{u}) (y : ↥Z),
      (∀ w : ↥Z, ringKrullDim (Z.presheaf.stalk w) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
      ¬ IsClosed ({y} : Set ↥Z) → ringKrullDim (Z.presheaf.stalk y) ≤ 0 by
    exact wcpa_dj_lr1k_ll_dp_delta_zero _
      (key _ y (wcpa_dj_lr1k_gn_fibre_dim_le Ω W hW hWt C γ hcov X uX ι hM) hy)
  clear hy y
  intro Z y hdim1 hy

  have hex : ∃ y' : ↥Z, y ⤳ y' ∧ y' ≠ y := by
    by_contra hcon
    push_neg at hcon
    apply hy
    apply isClosed_of_closure_subset
    intro z hz
    exact hcon z (specializes_iff_mem_closure.mpr hz)
  obtain ⟨y', hyy', hne⟩ := hex

  obtain ⟨U, hU, hbU, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y') (U := ⊤) trivial
  have haU : y ∈ U := hyy'.mem_open U.isOpen hbU
  set pa := hU.primeIdealOf ⟨y, haU⟩ with hpa
  set pb := hU.primeIdealOf ⟨y', hbU⟩ with hpb
  have ea : hU.fromSpec pa = y := hU.fromSpec_primeIdealOf ⟨y, haU⟩
  have eb : hU.fromSpec pb = y' := hU.fromSpec_primeIdealOf ⟨y', hbU⟩
  have hind : Topology.IsInducing ⇑hU.fromSpec := hU.fromSpec.isOpenEmbedding.isInducing
  have hsp : hU.fromSpec pa ⤳ hU.fromSpec pb := by rw [ea, eb]; exact hyy'
  have hle : pa ≤ pb := (PrimeSpectrum.le_iff_specializes pa pb).mpr (hind.specializes_iff.mp hsp)
  have hne' : pa ≠ pb := by
    intro h
    apply hne
    rw [← ea, ← eb, h]
  have hlt : pa.asIdeal < pb.asIdeal :=
    (PrimeSpectrum.asIdeal_lt_asIdeal pa pb).mpr (lt_of_le_of_ne hle hne')
  have da : ringKrullDim (Z.presheaf.stalk y) = (pa.asIdeal.height : WithBot ℕ∞) :=
    @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ pa.asIdeal _
      (Z.presheaf.stalk (⟨y, haU⟩ : U)) _
      (TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨y, haU⟩)
      (hU.isLocalization_stalk ⟨y, haU⟩)
  have db : ringKrullDim (Z.presheaf.stalk y') = (pb.asIdeal.height : WithBot ℕ∞) :=
    @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ pb.asIdeal _
      (Z.presheaf.stalk (⟨y', hbU⟩ : U)) _
      (TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨y', hbU⟩)
      (hU.isLocalization_stalk ⟨y', hbU⟩)

  have hb1 : ringKrullDim (Z.presheaf.stalk y') ≤ ((1 : ℕ) : WithBot ℕ∞) := hdim1 y'
  rw [db] at hb1
  have hb1' : pb.asIdeal.height ≤ ((1 : ℕ) : ℕ∞) := by
    have : ((1 : ℕ) : WithBot ℕ∞) = (((1 : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
    rw [this] at hb1
    exact WithBot.coe_le_coe.mp hb1
  have ha1 : pa.asIdeal.height < ((1 : ℕ) : ℕ∞) :=
    (Ideal.height_le_iff (p := pb.asIdeal) (n := 1)).mp hb1' pa.asIdeal pa.isPrime hlt
  have ha0 : pa.asIdeal.height = 0 := by
    have : pa.asIdeal.height < 1 := by exact_mod_cast ha1
    exact ENat.lt_one_iff_eq_zero.mp this
  rw [da, ha0]
  rfl

theorem wcpa_dj_lr1k_ebc_dia_modelA_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
