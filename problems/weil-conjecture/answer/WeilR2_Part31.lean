      wcpaDjLkModel W (r₂ ≫ r₁ ≫ uX) ι₂ →
      ∀ V₂ : X₁.Opens, (V₂ : Set X₁) = {σt (IsLocalRing.closedPoint ↥W)}ᶜ → IsIso (r₂ ∣_ V₂) →
    ∀ (Xa : Scheme.{u}) (ra : Xa ⟶ X) (ιa : wcProjK Ω 1 ⟶ Xa),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) ra → ιa ≫ ra = ι →
      wcpaDjLkModel W (ra ≫ uX) ιa →
    ∀ q : X₂ ⟶ Xa, q ≫ ra = r₂ ≫ r₁ → ι₂ ≫ q = ιa →
      wcCsdInvPull (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) (r₂ ≫ r₁) →
    ∀ p₂ : ↥X₂, r₂ p₂ = σ₁ (IsLocalRing.closedPoint ↥W) →
