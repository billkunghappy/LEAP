  have bridge : ∀ (n : ℕ) (ρ : MvPolynomial (Fin (n + 1)) R →+* B) (g : Fin n → MvPolynomial (Fin (n + 1)) R) (j : Fin (n + 1)), ρ (wcpaDjJacMinor g j) = (-1) ^ (j : ℕ) * ((Matrix.of fun m l => ρ (MvPolynomial.pderiv l (g m))).submatrix id j.succAbove).det := by
