  refine ⟨S, Z, sS, u, τ, U₀, U₁.toScheme, inferInstance, e, U₁.ι, (u ⁻¹ᵁ U₁).toScheme,
    u ∣_ U₁, κ ≫ χw, (u ⁻¹ᵁ U₁).ι, s, hS, hZ, hss, hτ, hU₀, hU₀U, hfin, hesurj, ?_, hPB,
    hR.flip, hs1, ?_, hs2⟩
  · rw [← Category.assoc, heι, ← hd, ← hβ₀]
