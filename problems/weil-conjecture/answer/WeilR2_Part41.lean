  have R3 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A] (σ : A), σ ≠ 0 → ∀ p ∈ associatedPrimes A (A ⧸ Ideal.span {σ}), ∀ [p.IsPrime], IsDiscreteValuationRing (Localization.AtPrime p) := by
