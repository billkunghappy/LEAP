      intro A B C h1 h2 x
      change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
      rw [← Functor.map_comp]
      rfl
    have resId : ∀ {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
        (X.presheaf.map (homOfLE h).op).hom x = x := by
      intro A h x
      change (X.presheaf.map (𝟙 (Opposite.op A))).hom x = x
      rw [CategoryTheory.Functor.map_id]
      rfl

    have s2 : ∀ (c : ∀ l j : Fin L.m, Γ(X, L.V l ⊓ L.V j)), ∃ (G : X.Modules)
        (π : ∀ V : X.Opens, Γ(G, V) → ∀ j : Fin L.m, Γ(X, V ⊓ L.V j)),
        (∀ (V : X.Opens) (x y : Γ(G, V)), π V x = π V y → x = y) ∧
