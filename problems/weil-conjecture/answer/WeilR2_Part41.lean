    have hpm : p ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal] at hip ⊢
      exact (map_mem_nonunits_iff _ p).mp hip
    have h2 := Ideal.add_mem _ hp (Ideal.mem_map_of_mem _ hpm)
    rwa [sub_add_cancel] at h2
