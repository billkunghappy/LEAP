      (g ≫ wcpaBscChartMap D k).appLE (D.V k) ⊤ h =
        CommRingCat.ofHom (AdjoinRoot.of (wcpaBscPoly D k)) ≫
          (Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D k)))).inv ≫ g.appTop := by
    intro k Y g h
    rw [Fcomp (g ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of (wcpaBscPoly D k))))
