      (∀ i, s i ≫ π₁ = 𝟙 U₁) ∧ (∀ i, s i ≫ χ = e ≫ U₀.ι ≫ σ i) ∧
      (∀ i, s i ≫ ψ = φ ≫ τ i) :=
by
  intro k _ _ X P _ _ sP f U n σ hin
  obtain ⟨L, iL, iA, iFD, hloc⟩ :=
    wcpa_dj_lc_uniform_local_stable_reduction k X P sP f U n σ hin
  obtain ⟨S₀, iS₀, sS₀, β₀, ε, hβ₀, hS₀, hβ₀p, hβ₀s, hβ₀f, hgen⟩ :=
    wcpa_dj_lc_alteration_model k P sP hin.2.1 L
  haveI := iS₀
  obtain ⟨S, Z, iS, sS, d, u, τ, W, Yw, πw, χw, ψw, sw, hd, hS, hdp, hds, hdf, hZ, hss, hτ, hW,
    hχ, hψ, hsπ, hsχ, hsψ⟩ :=
    wcpa_dj_lc_patch k X P sP f U n σ hin L S₀ sS₀ β₀ ε hβ₀ hS₀ hβ₀p hgen hloc
  haveI := iS
  haveI := hdp
  haveI := hβ₀p
  have hβp : IsProper (d ≫ β₀) := inferInstance
  obtain ⟨hβs, hβf⟩ := wcpa_dj_alteration_comp β₀ d hβ₀p hβ₀s hds hβ₀f hdf
  obtain ⟨U₀, hU₀, hU₀U, hU₀W, hfin⟩ :=
    wcpa_dj_lc_generic_fibre_open S P (d ≫ β₀) hβp hβs hβf W hW U hin.2.2.1

  haveI := hβs
  have hne : Nonempty ↥((d ≫ β₀) ⁻¹ᵁ U₀) := by
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mp hU₀
    obtain ⟨y, hy⟩ := (d ≫ β₀).surjective x
    refine ⟨⟨y, ?_⟩⟩
    rw [Scheme.Hom.mem_preimage, hy]
    exact hx
  haveI : Nonempty ((d ≫ β₀) ⁻¹ᵁ U₀).toScheme := hne
  haveI : AlgebraicGeometry.IsIntegral ((d ≫ β₀) ⁻¹ᵁ U₀).toScheme :=
    isIntegral_of_isOpenImmersion ((d ≫ β₀) ⁻¹ᵁ U₀).ι
  set U₁ := (d ≫ β₀) ⁻¹ᵁ U₀ with hU₁
  set e := (d ≫ β₀) ∣_ U₀ with he
  have hesurj : Surjective e :=
    MorphismProperty.of_isPullback (P := @Surjective)
      (isPullback_morphismRestrict (d ≫ β₀) U₀).flip hβs
  have heι : e ≫ U₀.ι = U₁.ι ≫ d ≫ β₀ := morphismRestrict_ι _ _
  let ι₁ : U₁.toScheme ⟶ W.toScheme := S.homOfLE hU₀W
  have hι₁ : ι₁ ≫ W.ι = U₁.ι := Scheme.homOfLE_ι _ _

  have hR : IsPullback (u ∣_ U₁) (u ⁻¹ᵁ U₁).ι U₁.ι u := isPullback_morphismRestrict u U₁
  have hRι : (u ∣_ U₁) ≫ U₁.ι = (u ⁻¹ᵁ U₁).ι ≫ u := morphismRestrict_ι _ _
  let κ : (u ⁻¹ᵁ U₁).toScheme ⟶ Yw :=
    hψ.lift (u ⁻¹ᵁ U₁).ι ((u ∣_ U₁) ≫ ι₁)
      (by rw [Category.assoc, hι₁, hRι])
  have hκ1 : κ ≫ ψw = (u ⁻¹ᵁ U₁).ι := hψ.lift_fst _ _ _
  have hκ2 : κ ≫ πw = (u ∣_ U₁) ≫ ι₁ := hψ.lift_snd _ _ _
  have hκ : IsPullback κ (u ∣_ U₁) πw ι₁ := by
    have h1 : IsPullback (κ ≫ ψw) (u ∣_ U₁) u (ι₁ ≫ W.ι) := by
