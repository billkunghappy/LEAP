    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec σ hV (isAffineOpen_top (Spec (.of K))) h
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h1
    have h2 : CommRingCat.ofHom (wcpaBscEval K σ V h) =
        σ.appLE V ⊤ h ≫ (Scheme.ΓSpecIso (.of K)).hom := rfl
    rw [h2, Spec.map_comp, Category.assoc, h1, ← Category.assoc, ← Spec.map_comp,
