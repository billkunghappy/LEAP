    refine ⟨(PowerSeries.map (Ideal.Quotient.mk (Ideal.span {t l}))).comp ρ, fun F i => ?_⟩
    rw [RingHom.comp_apply, PowerSeries.coeff_map]
    congr 1
    first
      | exact PowerSeries.coeff_mk (R := A) _ _
      | erw [PowerSeries.coeff_mk]
      | simp [ρ]
  have hχX : χ (MvPowerSeries.X j) = PowerSeries.X := by
    ext i
    rw [hχc, MvPowerSeries.coeff_X, PowerSeries.coeff_X]
    by_cases hi : i = 1
    · subst hi; simp
    · rw [if_neg (fun h => hi ((Finsupp.single_injective j) h)), if_neg hi, map_zero]
  have hχX' : χ (MvPowerSeries.X j') = 0 := by
    ext i
    rw [hχc, map_zero, MvPowerSeries.coeff_X, if_neg, map_zero]
    intro h
    have := congrArg (fun m => m j') h
    simp [Finsupp.single_apply, hjj'] at this
  have hχC : ∀ b, χ (MvPowerSeries.C b) =
      PowerSeries.C (Ideal.Quotient.mk (Ideal.span {t l}) b) := by
    intro b
    ext i
    rw [hχc, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
    by_cases hi : i = 0
    · subst hi; simp
    · rw [if_neg (by rwa [Finsupp.single_eq_zero]), if_neg hi, map_zero]
  have hker : ∀ F, χ F = 0 → ∃ G H : MvPowerSeries (Fin 2) A,
      F = MvPowerSeries.X j' * G + MvPowerSeries.C (t l) * H := by
    intro F hF
    have hax : ∀ m : Fin 2 →₀ ℕ, ∃ a : A, m j' = 0 → a * t l = MvPowerSeries.coeff m F := by
      intro m
      by_cases hm : m j' = 0
      · have hm' : m = Finsupp.single j (m j) := by
          ext x
          rcases hcover x with hx | hx
          · rw [hx, Finsupp.single_eq_same]
          · rw [hx, hm, Finsupp.single_apply, if_neg hjj']
        have h1 := congrArg (PowerSeries.coeff (m j)) hF
        rw [hχc, map_zero, ← hm'] at h1
        obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp h1)
        exact ⟨a, fun _ => ha⟩
      · exact ⟨0, fun h => absurd h hm⟩
    choose H0 hH using hax
    let H : MvPowerSeries (Fin 2) A := H0
    have hHc : ∀ m, MvPowerSeries.coeff m H = H0 m := fun m => rfl
    have hdvd : MvPowerSeries.X j' ∣ F - MvPowerSeries.C (t l) * H := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [map_sub, MvPowerSeries.coeff_C_mul, hHc, ← hH m hm]
      ring
    obtain ⟨G, hG⟩ := hdvd
    exact ⟨G, H, by rw [← hG]; ring⟩

  have hgen : χ (MvPowerSeries.X 0 * MvPowerSeries.X 1 -
      MvPowerSeries.C (↑v * ∏ k, t k ^ c k)) = 0 := by
    rw [← hprod, map_sub, map_mul, hχX, hχX', mul_zero, hχC, zero_sub, neg_eq_zero,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr htl), map_zero]
  obtain ⟨χb, hχb⟩ : ∃ χb : wcpaDjStcTuRing A t c v →+* PowerSeries (A ⧸ Ideal.span {t l}),
      ∀ F, χb (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) F) = χ F := by
    refine ⟨Ideal.Quotient.lift (wcpaDjStcTuIdeal A t c v) χ ?_, fun F => Ideal.Quotient.lift_mk _ _ _⟩
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hgen, mul_zero]
  set P := RingHom.ker χb with hPdef
  haveI hP : P.IsPrime := RingHom.ker_isPrime χb
  have hmemP : ∀ F, Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) F ∈ P ↔ χ F = 0 := by
    intro F
    rw [hPdef, RingHom.mem_ker, hχb]

  have hτP : Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) ∈ P := by
    rw [hmemP, hχC, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _),
      map_zero]
  have hτ0 : Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) ≠ 0 := by
    intro h0
    have h1 : MvPowerSeries.C (t l) ∈ wcpaDjStcTuIdeal A t c v :=
      Ideal.Quotient.eq_zero_iff_mem.mp h0
    obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp h1
    have ha : MvPowerSeries.HasSubst
        (fun i : Fin 2 => (MvPowerSeries.X (i : ℕ) : MvPowerSeries ℕ A)) :=
      MvPowerSeries.hasSubst_of_constantCoeff_zero (fun s => by simp)
    let φ := MvPowerSeries.substAlgHom (R := A) (S := A) ha
    have hC : ∀ b : A, φ (MvPowerSeries.C b) = MvPowerSeries.C b := fun b => by
      have := φ.commutes b
      first
        | simpa [MvPowerSeries.algebraMap_apply] using this
        | exact this
    have hX : ∀ i : Fin 2, φ (MvPowerSeries.X i) = MvPowerSeries.X (i : ℕ) :=
      MvPowerSeries.substAlgHom_X ha
    have h2 := congrArg φ hG
    rw [map_mul, map_sub, map_mul, hX, hX, hC, hC] at h2
    apply (ht l).ne_zero
    apply hCinj
    exact Ideal.mem_span_singleton'.mpr ⟨_, h2⟩
  have hXP : Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j) ∉ P := by
    rw [hmemP, hχX]
    exact PowerSeries.X_ne_zero
  have hτkP : ∀ k, k ≠ l →
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) ∉ P := by
    intro k hk
    rw [hmemP, hχC]
    intro h0
    have h1 := PowerSeries.C_injective (h0.trans (map_zero _).symm)
    exact hndvd l k (Ne.symm hk)
      (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h1))

  haveI : IsDomain (Localization.AtPrime P) :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors P)
  haveI : IsNoetherianRing (Localization.AtPrime P) :=
    IsLocalization.isNoetherianRing P.primeCompl _ inferInstance
  have hunitX : IsUnit (algebraMap _ (Localization.AtPrime P)
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j))) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff _ P _).mpr hXP
  have hπ0 : algebraMap _ (Localization.AtPrime P)
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ≠ 0 := fun h0 =>
    hτ0 (IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
      (h0.trans (map_zero _).symm))
  have hπm : algebraMap _ (Localization.AtPrime P)
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ P _).mpr hτP

  obtain ⟨d, hd⟩ := htl
  have hrelR : Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j) *
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j') =
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) *
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C d) := by
    have h1 : Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v)
        (MvPowerSeries.X 0 * MvPowerSeries.X 1) =
        Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v)
          (MvPowerSeries.C (↑v * ∏ k, t k ^ c k)) :=
      Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
    rw [← hprod, hd] at h1
    simpa only [map_mul] using h1
  have hdvdX' : algebraMap _ (Localization.AtPrime P)
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ∣
      algebraMap _ (Localization.AtPrime P)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j')) := by
    have h2 := congrArg (algebraMap _ (Localization.AtPrime P)) hrelR
    simp only [map_mul] at h2
    have h3 : algebraMap _ (Localization.AtPrime P)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ∣
        algebraMap _ (Localization.AtPrime P)
          (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j)) *
        algebraMap _ (Localization.AtPrime P)
          (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X j')) := ⟨_, h2⟩
    first
      | exact hunitX.dvd_mul_left.mp h3
      | exact hunitX.dvd_mul_right.mp h3

  have hPle : P ≤ Ideal.comap (algebraMap _ (Localization.AtPrime P))
      (Ideal.span {algebraMap _ (Localization.AtPrime P)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)))}) := by
    intro x hx
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [hmemP] at hx
    obtain ⟨G, H, rfl⟩ := hker F hx
    rw [Ideal.mem_comap, Ideal.mem_span_singleton]
    simp only [map_add, map_mul]
    exact dvd_add (dvd_mul_of_dvd_left hdvdX' _) (dvd_mul_right _ _)

  have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime P) =
      Ideal.span {algebraMap _ (Localization.AtPrime P)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)))} := by
    apply le_antisymm
    · rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P (Localization.AtPrime P)]
      exact Ideal.map_le_iff_le_comap.mpr hPle
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hπm
  have hnf : ¬ IsField (Localization.AtPrime P) := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax]
    intro h0
    exact hπ0 (Ideal.span_singleton_eq_bot.mp h0)
  haveI : IsDiscreteValuationRing (Localization.AtPrime P) := by
    have hprin : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (Localization.AtPrime P)) :=
      ⟨⟨_, hmax⟩⟩
    first
      | exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime P) hnf).out 0 4).mpr hprin
      | exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime P) hnf).out 1 5).mpr hprin
  have hirr : Irreducible (algebraMap _ (Localization.AtPrime P)
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)))) :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer (R := Localization.AtPrime P) _).mpr hmax
  refine ⟨P, hP, inferInstance, hπ0, ?_, ?_, hunitX, ?_⟩
  · exact (IsLocalRing.mem_maximalIdeal _).mp hπm
  · intro z hz
    obtain ⟨e, w, hzw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible (R := Localization.AtPrime P) hz hirr
    exact ⟨e, w, hzw⟩
  · intro k hk
    exact (IsLocalization.AtPrime.isUnit_to_map_iff _ P _).mpr (hτkP k hk)

