theorem wcpa_dj_lqcf_ir_affine_coords : ∀ (k : Type u) [Field k] (C : Scheme.{u}) (c : C ⟶ Spec (.of k)) (B : Type u) [CommRing B] [Algebra k B] (CB : Scheme.{u}) (pr : CB ⟶ C) (qB : CB ⟶ Spec (.of B)), IsPullback pr qB c (Spec.map (CommRingCat.ofHom (algebraMap k B))) → ∀ (ι : Type u) (b : Module.Basis ι k B) (U : C.Opens), IsAffineOpen U → IsAffineOpen (pr ⁻¹ᵁ U) ∧ ∀ y : Γ(CB, pr ⁻¹ᵁ U), ∃! r : ι →₀ Γ(C, U), y = r.sum (fun α a => (pr.app U).hom a * (qB.appTop ≫ CB.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U ≤ ⊤)).op).hom ((Scheme.ΓSpecIso (.of B)).inv.hom (b α))) :=
