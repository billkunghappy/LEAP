    rw [hsQ1, ← Category.assoc, hγ₁2, ← w₁, Category.assoc, Category.assoc, Category.assoc, hφ]
  obtain ⟨γ, hγp, hγq⟩ : ∃ γ : ((e ≫ U₀.ι) ⁻¹ᵁ W).toScheme ⟶ Limits.pullback sQ1 sM,
      γ ≫ Limits.pullback.fst sQ1 sM = γ₁ ∧
      γ ≫ Limits.pullback.snd sQ1 sM = ((e ≫ U₀.ι) ⁻¹ᵁ W).ι ≫ φ :=
    ⟨Limits.pullback.lift _ _ w₂, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  haveI hQC : QuasiCompact γ := quasiCompact_of_compactSpace γ

  haveI hint : AlgebraicGeometry.IsIntegral (Scheme.Hom.image γ) :=
    wcpa_dj_gc_image_integral _ _ γ hQC
  obtain ⟨β', hβ'⟩ : ∃ b : Scheme.Hom.image γ ⟶ P,
      b = Scheme.Hom.imageι γ ≫ Limits.pullback.fst sQ1 sM ≫
        Limits.pullback.fst sP (wcProjKStr k r) := ⟨_, rfl⟩
  obtain ⟨φ'', hφ''⟩ : ∃ b : Scheme.Hom.image γ ⟶ M,
      b = Scheme.Hom.imageι γ ≫ Limits.pullback.snd sQ1 sM := ⟨_, rfl⟩
  have hφ''s : φ'' ≫ sM = β' ≫ sP := by
    have c1 : Limits.pullback.fst sQ1 sM ≫ sQ1 = Limits.pullback.snd sQ1 sM ≫ sM :=
      Limits.pullback.condition
    rw [hφ'', hβ']
    simp only [Category.assoc]
    rw [← c1, hsQ1']
  have hprojI : wcpaDjIsProjOver k (Scheme.Hom.imageι γ ≫ Limits.pullback.snd sQ1 sM ≫ sM) := by
    have := wcpa_dj_ssm_proj_fibre_product k (Limits.pullback sP (wcProjKStr k r)) (Spec (.of k)) M
      (Scheme.Hom.image γ) (𝟙 _) sQ1 sM (Scheme.Hom.imageι γ) inferInstance
      (by rw [Category.comp_id]; exact hQ1') (by rw [Category.comp_id]; exact hM) inferInstance
    rwa [Category.comp_id] at this
  have hprojP'' : wcpaDjIsProjOver k (β' ≫ sP) := by
    rw [← hφ''s, hφ'', Category.assoc]; exact hprojI
  haveI hβprop : IsProper β' := by
    haveI : IsProper (β' ≫ sP) := wcpa_dj_proj_proper k _ hprojP''
    exact IsProper.of_comp β' sP

  have hU : β' ⁻¹ᵁ W = (Scheme.Hom.imageι γ ≫ Limits.pullback.fst sQ1 sM) ⁻¹ᵁ
      (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W) := by
    rw [hβ']
    simp only [Scheme.Hom.comp_preimage]
  have hhO : h ≫ (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W).ι =
      γ ≫ Limits.pullback.fst sQ1 sM := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hh1, hει, ← Category.assoc γ, hγp, hγ₁1]
    · simp only [Category.assoc]
      rw [hh2, ← Category.assoc γ, hγp, hγ₁2]
  obtain ⟨t, ht_iso, ht⟩ := wcpa_dj_gc_image_open_iso _ _ _ γ (Limits.pullback.fst sQ1 sM)
    (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W) (β' ⁻¹ᵁ W) h hQC inferInstance inferInstance
    hU hhO hhci

  have hi : t ≫ (β' ⁻¹ᵁ W).ι ≫ β' = ((e ≫ U₀.ι) ⁻¹ᵁ W).ι ≫ e ≫ U₀.ι := by
    rw [← Category.assoc, ht, hβ', ← Category.assoc, Scheme.Hom.toImage_imageι,
      ← Category.assoc, hγp, hγ₁1]
  have hii : t ≫ (β' ⁻¹ᵁ W).ι ≫ φ'' = ((e ≫ U₀.ι) ⁻¹ᵁ W).ι ≫ φ := by
    rw [← Category.assoc, ht, hφ'', ← Category.assoc, Scheme.Hom.toImage_imageι, hγq]

  have hsurj : Surjective β' := by
    have hcl : IsClosed (Set.range β') := β'.isClosedMap.isClosed_range
    have hsub : (W : Set P) ⊆ Set.range β' := by
      intro w hw
      obtain ⟨u, hu⟩ := e.surjective ⟨w, hWU hw⟩
      have huV : u ∈ (e ≫ U₀.ι) ⁻¹ᵁ W :=
        (Scheme.Hom.mem_preimage _).mpr (by rw [Scheme.Hom.comp_apply, hu, Scheme.Opens.ι_apply]; exact hw)
      have huR : u ∈ Set.range ((e ≫ U₀.ι) ⁻¹ᵁ W).ι := by
        rw [Scheme.Opens.range_ι]; exact huV
      obtain ⟨v, hv⟩ := huR
      refine ⟨(β' ⁻¹ᵁ W).ι (t v), ?_⟩
      have e1 : (t ≫ (β' ⁻¹ᵁ W).ι ≫ β') v = (((e ≫ U₀.ι) ⁻¹ᵁ W).ι ≫ e ≫ U₀.ι) v := by rw [hi]
      simp only [Scheme.Hom.comp_apply] at e1
      rw [e1, hv, hu, Scheme.Opens.ι_apply]
    have hd : Dense (W : Set P) := W.isOpen.dense ⟨x, hxW⟩
    refine ⟨fun y => ?_⟩
    have hy : y ∈ closure (W : Set P) := by rw [hd.closure_eq]; trivial
    exact closure_minimal hsub hcl hy

  have htε : t ≫ (β' ∣_ W) = (e ≫ U₀.ι) ∣_ W := by
    rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, hi, hει]
  have hfin : IsFinite (β' ∣_ W) := by
    have : β' ∣_ W = inv t ≫ (e ≫ U₀.ι) ∣_ W := by rw [← htε, IsIso.inv_hom_id_assoc]
    rw [this]
    infer_instance
  have hW0 : W ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mpr ⟨x, hxW⟩
  have hU''0 : β' ⁻¹ᵁ W ≠ ⊥ := by
    obtain ⟨v₀⟩ := (inferInstance : Nonempty ((e ≫ U₀.ι) ⁻¹ᵁ W).toScheme)
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨(t v₀).1, (t v₀).2⟩
  have hle : β' ⁻¹ᵁ W ≤ β' ⁻¹ᵁ U₀ := fun y hy => hWU hy
  refine ⟨Scheme.Hom.image γ, hint, β' ≫ sP, β', φ'', β' ⁻¹ᵁ W, inv t ≫ ((e ≫ U₀.ι) ⁻¹ᵁ W).ι,
    rfl, hφ''s, hprojP'', hβprop, hsurj, ⟨W, hW0, hfin⟩, hU''0, hle, ?_, ?_⟩
  · rw [Category.assoc, ← hi, IsIso.inv_hom_id_assoc]
  · rw [Category.assoc, ← hii, IsIso.inv_hom_id_assoc]

theorem wcpa_dj_mm_integral_of_flat : ∀ (C P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
    (g : C ⟶ P) (U : P.Opens), Flat g → U ≠ ⊥ → SmoothOfRelativeDimension 1 (g ∣_ U) →
    GeometricallyConnected (g ∣_ U) → AlgebraicGeometry.IsIntegral C :=
by
  intro C P _ g U hg hU hsm hgc
  haveI hPirr : IrreducibleSpace P := irreducibleSpace_of_isIntegral P

  have s1 : ∃ (y : Spec (P.presheaf.stalk (genericPoint P)) ⟶ U)
      (l : Limits.pullback g (P.fromSpecStalk (genericPoint P)) ⟶ (g ⁻¹ᵁ U)),
      IsPullback l (Limits.pullback.snd g (P.fromSpecStalk (genericPoint P))) (g ∣_ U) y := by
    have hη : genericPoint P ∈ U := by
      obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
      exact (genericPoint_specializes u).mem_open U.isOpen hu
    have hrange : Set.range (P.fromSpecStalk (genericPoint P)) ⊆ Set.range U.ι := by
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι]
      have hz : P.fromSpecStalk (genericPoint P) z ⤳ genericPoint P := by
        have : P.fromSpecStalk (genericPoint P) z ∈
            Set.range (P.fromSpecStalk (genericPoint P)) := ⟨z, rfl⟩
        rwa [Scheme.range_fromSpecStalk] at this
      exact hz.mem_open U.isOpen hη
    let y := IsOpenImmersion.lift U.ι (P.fromSpecStalk (genericPoint P)) hrange
    have hy : y ≫ U.ι = P.fromSpecStalk (genericPoint P) :=
      IsOpenImmersion.lift_fac _ _ _
    have sq := IsPullback.of_hasPullback g (P.fromSpecStalk (genericPoint P))
    have sq3 := (isPullback_morphismRestrict g U).flip
    have w : Limits.pullback.fst g (P.fromSpecStalk (genericPoint P)) ≫ g =
        (Limits.pullback.snd g (P.fromSpecStalk (genericPoint P)) ≫ y) ≫ U.ι := by
      rw [Category.assoc, hy]
      exact sq.w
    refine ⟨y, sq3.lift _ _ w, ?_⟩
    apply IsPullback.of_right ?_ (sq3.lift_snd _ _ w) sq3
    rw [sq3.lift_fst, hy]
    exact sq


  have s2 : ∀ (K : Type u) [Field K] (X Y : Scheme.{u}) (f : X ⟶ Y) (y : Spec (.of K) ⟶ Y)
      (Z : Scheme.{u}) (fst : Z ⟶ X) (snd : Z ⟶ Spec (.of K)), SmoothOfRelativeDimension 1 f →
      GeometricallyConnected f → IsPullback fst snd f y →
      IrreducibleSpace Z ∧ AlgebraicGeometry.IsReduced Z := by
    intro K _ X Y f y Z fst snd hsm' hgc' hpb
    haveI := hgc'
    haveI : SmoothOfRelativeDimension 1 snd :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm'
    haveI : ConnectedSpace Z := GeometricallyConnected.geometrically_connectedSpace y fst snd hpb
    haveI : Smooth snd := SmoothOfRelativeDimension.smooth 1 snd
    haveI : LocallyOfFiniteType snd := inferInstance
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd
    have hd := wcpa_smooth_stalk_isDomain K Z snd 1
    refine ⟨wcpa_irreducible_of_connected_domain_stalks Z hd, ?_⟩
    haveI : ∀ z : Z, _root_.IsReduced (Z.presheaf.stalk z) := fun z => by
      haveI := hd z
      infer_instance
    exact isReduced_of_isReduced_stalk Z

  have s3 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      IrreducibleSpace ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      IrreducibleSpace X ∧ True := by
    intro S X _ _ f hf hG
    refine ⟨?_, trivial⟩
    have hgen : GeneralizingMap f := Flat.generalizingMap f
    have key : ∀ x : X, Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))
        (genericPoint ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S)))) ⤳ x := by
      intro x
      have h1 : genericPoint S ⤳ f x := genericPoint_specializes (f x)
      obtain ⟨x', hx', hfx'⟩ := hgen h1
      have hmem : f x' ∈ Set.range (S.fromSpecStalk (genericPoint S)) := by
        rw [Scheme.range_fromSpecStalk, hfx']
        exact specializes_refl _
      have hx'r : x' ∈ Set.range (Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))) := by
        rw [Scheme.Pullback.range_fst]
        exact hmem
      obtain ⟨z, rfl⟩ := hx'r
      exact ((genericPoint_specializes z).map (Limits.pullback.fst f _).continuous).trans hx'
    rw [irreducibleSpace_def]
    have huniv : (Set.univ : Set X) = closure {Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))
        (genericPoint ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S))))} := by
      apply (Set.eq_univ_of_forall _).symm
      intro x
      exact specializes_iff_mem_closure.mp (key x)
    rw [Set.top_eq_univ, huniv]
    exact isIrreducible_singleton.closure

  have s4 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S)
      (V : S.Opens)
      (hV : IsAffineOpen V) (W : X.Opens) (hW : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
      (hη : genericPoint S ∈ V),
      AlgebraicGeometry.IsReduced (Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη))) ∧ True := by
    intro S X _ _ f V hV W hW e hη hG
    refine ⟨?_, trivial⟩
    have h0 : IsPullback (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Spec.map (f.appLE V W e) ≫ hV.fromSpec)
        (Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec) :=
      IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) hV.fromSpec)
    have e1 : Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec =
        S.fromSpecStalk (genericPoint S) := hV.fromSpecStalk_eq_fromSpecStalk hη
    rw [IsAffineOpen.SpecMap_appLE_fromSpec f hV hW e, e1] at h0
    have sqG := (IsPullback.of_hasPullback f (S.fromSpecStalk (genericPoint S))).flip
    have w : (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ hW.fromSpec) ≫ f =
        Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ S.fromSpecStalk (genericPoint S) := by
      rw [Category.assoc]
      exact h0.w
    have Sq := IsPullback.of_right (h₁₁ := Limits.pullback.lift _ _ w) ?_
      (Limits.pullback.lift_fst _ _ w) sqG
    · haveI : IsOpenImmersion (Limits.pullback.lift _ _ w) :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) Sq.flip inferInstance
      exact isReduced_of_isOpenImmersion (Limits.pullback.lift _ _ w)
    · rw [Limits.pullback.lift_snd]
      exact h0.flip

  have s5 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      (∀ (V : S.Opens) (_ : IsAffineOpen V) (W : X.Opens) (_ : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
        (hη : genericPoint S ∈ V), AlgebraicGeometry.IsReduced (Limits.pullback
          (Spec.map (f.appLE V W e)) (Spec.map (S.presheaf.germ V (genericPoint S) hη)))) →
      AlgebraicGeometry.IsReduced X ∧ True := by
    intro S X _ _ f hf H
    haveI := hf
    have hst : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
      intro x
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := ⊤) trivial
      obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := f ⁻¹ᵁ V) hxV
      have hη : genericPoint S ∈ V := (genericPoint_specializes (f x)).mem_open V.isOpen hxV
      have hT := H V hV W hW hWV hη
      letI := (f.appLE V W hWV).hom.toAlgebra
      letI := (S.presheaf.germ V (genericPoint S) hη).hom.toAlgebra
      haveI : Module.Flat Γ(S, V) Γ(X, W) := Flat.flat_appLE f hV hW hWV
      have hinj : Function.Injective (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S))) :=
        germ_injective_of_isIntegral S _ hη
      have hinc := Algebra.TensorProduct.includeLeft_injective (R := Γ(S, V)) (S := Γ(S, V))
        (A := Γ(X, W)) (B := S.presheaf.stalk (genericPoint S)) hinj
      haveI : AlgebraicGeometry.IsReduced
          (Spec (.of (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))) := by
        haveI : AlgebraicGeometry.IsReduced (Limits.pullback
            (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Γ(X, W))))
            (Spec.map (CommRingCat.ofHom
              (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S)))))) := hT
        exact isReduced_of_isOpenImmersion (pullbackSpecIso _ _ _).inv
      haveI : _root_.IsReduced
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))) :=
        (affine_isReduced_iff (CommRingCat.of
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))).mp inferInstance
      haveI : _root_.IsReduced Γ(X, W) := isReduced_of_injective _ hinc
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
      haveI := hW.isLocalization_stalk ⟨x, hxW⟩
      exact isReduced_localizationPreserves (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
        (X.presheaf.stalk (⟨x, hxW⟩ : W)) ‹_›
    exact ⟨isReduced_of_isReduced_stalk X, trivial⟩

  haveI := hg
  obtain ⟨y, l, hl⟩ := s1
  have hBR : IrreducibleSpace ↥(Limits.pullback g (P.fromSpecStalk (genericPoint P))) ∧
      AlgebraicGeometry.IsReduced (Limits.pullback g (P.fromSpecStalk (genericPoint P))) :=
    s2 (P.presheaf.stalk (genericPoint P)) _ _ (g ∣_ U) y _ l _ hsm hgc hl
  haveI hI : IrreducibleSpace C := (s3 P C g hg hBR.1).1
  haveI hR : AlgebraicGeometry.IsReduced C :=
    (s5 P C g hg (fun V hV W hW e hη => (s4 P C g V hV W hW e hη hBR.2).1)).1
  exact isIntegral_of_irreducibleSpace_of_isReduced C

theorem wcpa_dj_sm_moduli_model : ∀ (k : Type u) [Field k] [Finite k] (X P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    (f : X ⟶ P) (U : P.Opens) (n : ℕ) (σ : Fin n → (P ⟶ X)), wcpaDjSmIn k sP f U σ →
    wcpaDjStableModel k sP f U σ :=
by
  intro k _ _ X P _ _ sP f U n σ hin
  obtain ⟨M, Z, sM, u, τ, U₀, U₁, iU₁, e, φ, Y₁, π₁, χ, ψ, s, hM, hZ, hss, hτ, hU₀, hU₀U,
    he, hesurj, hφ, hχ, hψ, hsπ, hsχ, hsψ⟩ :=
    wcpa_dj_mm_level_classifying k X P sP f U n σ hin
  obtain ⟨_, hPproj, _, hsm, hgc, _, hσ, _⟩ := hin
  haveI := iU₁
  obtain ⟨P'', iP'', sP'', β', φ'', U'', j, hβ', hφ'', hP'', hβp, hβs, hβf, hU'', hU''le,
    hj1, hj2⟩ := wcpa_dj_mm_graph_closure k P M U₁ sP sM U₀ e φ hPproj hM hU₀ he hesurj hφ
  haveI := iP''
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have hpb : IsPullback (Limits.pullback.fst u φ'') (Limits.pullback.snd u φ'') u φ'' :=
    IsPullback.of_hasPullback u φ''
  set g' := Limits.pullback.snd u φ'' with hg'
  set fC := Limits.pullback.fst u φ'' with hfC
  let τ'' : Fin n → (P'' ⟶ Limits.pullback u φ'') := fun i =>
    Limits.pullback.lift (φ'' ≫ τ i) (𝟙 P'')
      (by rw [Category.assoc, hτ.1 i, Category.comp_id, Category.id_comp])
  have hτ''s : ∀ i, τ'' i ≫ g' = 𝟙 P'' := fun i => Limits.pullback.lift_snd _ _ _
  have hτ''f : ∀ i, τ'' i ≫ fC = φ'' ≫ τ i := fun i => Limits.pullback.lift_fst _ _ _
  have hss' : wcpaDjSemistable g' := wcpa_dj_mm_semistable_basechange M P'' Z φ'' u hss
  have hproj' : wcpaDjIsProjOver k (g' ≫ sP'') :=
    wcpa_dj_tr_basechange_proj k M P'' Z sM sP'' φ'' u hφ'' hM hP'' hZ
  have hsec : wcpaDjSections g' n τ'' := by
    refine ⟨hτ''s, ?_, ?_⟩
    · intro i i' p q hii' heq
      apply hτ.2.1 i i' (φ'' p) (φ'' q) hii'
      have h1 := congrArg fC heq
      rw [pt (hτ''f i) p, pt (hτ''f i') q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      exact h1
    · intro i p
      obtain ⟨W, hW, hWsm⟩ := hτ.2.2 i (φ'' p)
      refine ⟨fC ⁻¹ᵁ W, ?_, ?_⟩
      · show fC (τ'' i p) ∈ W
        rw [pt (hτ''f i) p, Scheme.Hom.comp_apply]
        exact hW
      · have h1 : IsPullback (fC ∣_ W) (fC ⁻¹ᵁ W).ι W.ι fC := isPullback_morphismRestrict fC W
        have h2 : IsPullback (fC ∣_ W) ((fC ⁻¹ᵁ W).ι ≫ g') (W.ι ≫ u) φ'' := h1.paste_vert hpb
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

  have hA : IsPullback (g' ∣_ U'') (g' ⁻¹ᵁ U'').ι U''.ι g' := isPullback_morphismRestrict g' U''
  have hB : IsPullback ((g' ⁻¹ᵁ U'').ι ≫ fC) (g' ∣_ U'') u (j ≫ φ) := by
    rw [hj2]
    exact hA.flip.paste_horiz hpb
  let ψ' : (g' ⁻¹ᵁ U'').toScheme ⟶ Y₁ :=
    hψ.lift ((g' ⁻¹ᵁ U'').ι ≫ fC) ((g' ∣_ U'') ≫ j) (by rw [hB.w, Category.assoc])
  have hψ'1 : ψ' ≫ ψ = (g' ⁻¹ᵁ U'').ι ≫ fC := hψ.lift_fst _ _ _
  have hψ'2 : ψ' ≫ π₁ = (g' ∣_ U'') ≫ j := hψ.lift_snd _ _ _
  have hC : IsPullback ψ' (g' ∣_ U'') π₁ j := by
    have h1 : IsPullback (ψ' ≫ ψ) (g' ∣_ U'') u (j ≫ φ) := by rw [hψ'1]; exact hB
    exact IsPullback.of_right h1 hψ'2 hψ
  have hPB : IsPullback (ψ' ≫ χ) (g' ∣_ U'') f (U''.ι ≫ β') := by
    rw [← hj1]
    exact hC.paste_horiz hχ

  have hle : U'' ≤ β' ⁻¹ᵁ U := by
    intro x hx
    exact hU₀U (hU''le hx)
  have hbU : β'.resLE U U'' hle ≫ U.ι = U''.ι ≫ β' := Scheme.Hom.resLE_comp_ι _ _
  have hfU : IsPullback (f ∣_ U) (f ⁻¹ᵁ U).ι U.ι f := isPullback_morphismRestrict f U
  let κ : (g' ⁻¹ᵁ U'').toScheme ⟶ (f ⁻¹ᵁ U).toScheme :=
    hfU.lift ((g' ∣_ U'') ≫ β'.resLE U U'' hle) (ψ' ≫ χ)
      (by rw [Category.assoc, hbU, hPB.w])
  have hκ1 : κ ≫ (f ∣_ U) = (g' ∣_ U'') ≫ β'.resLE U U'' hle := hfU.lift_fst _ _ _
  have hκ2 : κ ≫ (f ⁻¹ᵁ U).ι = ψ' ≫ χ := hfU.lift_snd _ _ _
  have hD : IsPullback κ (g' ∣_ U'') (f ∣_ U) (β'.resLE U U'' hle) := by
    have h1 : IsPullback (κ ≫ (f ⁻¹ᵁ U).ι) (g' ∣_ U'') f (β'.resLE U U'' hle ≫ U.ι) := by
      rw [hκ2, hbU]; exact hPB
    exact IsPullback.of_right h1 hκ1 hfU.flip
  have hsm'' : SmoothOfRelativeDimension 1 (g' ∣_ U'') :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hD hsm
  have hgc'' : GeometricallyConnected (g' ∣_ U'') :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hD hgc
  have hCint : AlgebraicGeometry.IsIntegral (Limits.pullback u φ'') :=
    wcpa_dj_mm_integral_of_flat _ P'' g' U'' hss'.1 hU'' hsm'' hgc''
  refine ⟨P'', iP'', sP'', β', Limits.pullback u φ'', hCint, g', τ'', U'', ψ' ≫ χ, hβ', hP'',
    hβp, hβs, hβf, hproj', hss', hsec, hU'', hle, hsm'', hgc'', hPB, ?_⟩

  intro c i
  let t : U''.toScheme ⟶ (g' ⁻¹ᵁ U'').toScheme :=
    hA.lift (𝟙 _) (U''.ι ≫ τ'' i)
      (by rw [Category.id_comp, Category.assoc, hτ''s, Category.comp_id])
  have ht1 : t ≫ (g' ∣_ U'') = 𝟙 _ := hA.lift_fst _ _ _
  have ht2 : t ≫ (g' ⁻¹ᵁ U'').ι = U''.ι ≫ τ'' i := hA.lift_snd _ _ _
  have ht3 : t ≫ ψ' = j ≫ s i := by
    apply hψ.hom_ext
    · rw [Category.assoc, hψ'1, ← Category.assoc, ht2, Category.assoc, hτ''f, ← Category.assoc,
        ← hj2, Category.assoc, Category.assoc, hsψ]
    · rw [Category.assoc, hψ'2, ← Category.assoc, ht1, Category.id_comp, Category.assoc, hsπ,
        Category.comp_id]
  have ht4 : t ≫ (ψ' ≫ χ) = (U''.ι ≫ β') ≫ σ i := by
    rw [← Category.assoc, ht3, Category.assoc, hsχ, ← hj1, Category.assoc, Category.assoc]
  have key := wcpa_dj_mm_section_point_unique X P U'' (g' ⁻¹ᵁ U'') f (U''.ι ≫ β') (ψ' ≫ χ)
    (g' ∣_ U'') (σ i) t hPB (hσ i) ht1 ht4 c
  have e1 : U''.ι ((g' ∣_ U'') c) = g' ((g' ⁻¹ᵁ U'').ι c) := by
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  have e2 : (g' ⁻¹ᵁ U'').ι (t ((g' ∣_ U'') c)) = τ'' i (g' ((g' ⁻¹ᵁ U'').ι c)) := by
    rw [pt ht2, Scheme.Hom.comp_apply, e1]
  rw [Scheme.Hom.comp_apply U''.ι β', e1] at key
  rw [key, ← e2]
  constructor
  · intro h; rw [← h]
  · intro h
    exact (g' ⁻¹ᵁ U'').ι.isOpenEmbedding.injective h

theorem wcpa_dj_ssfi_regular_model : ∀ (k : Type u) [Field k] [Finite k] (X₃ P₂ : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₃] [AlgebraicGeometry.IsIntegral P₂] (sP₂ : P₂ ⟶ Spec (.of k))
    (f₃ : X₃ ⟶ P₂), wcpaDjIsProjOver k (f₃ ≫ sP₂) → wcpaDjIsProjOver k sP₂ → Flat f₃ →
    ∀ U₂ : P₂.Opens, U₂ ≠ ⊥ → SmoothOfRelativeDimension 1 (f₃ ∣_ U₂) →
    GeometricallyConnected (f₃ ∣_ U₂) →
    ∀ (n : ℕ) (σ : Fin n → (P₂ ⟶ X₃)), (∀ i, σ i ≫ f₃ = 𝟙 P₂) →
    (∀ (i j : Fin n) (p : P₂), p ∈ U₂ → i ≠ j → σ i p ≠ σ j p) →
    ∀ nP : ℕ, topologicalKrullDim P₂ = (nP : WithBot ℕ∞) → wcpaDjAltIH.{u} nP →
    ∃ (S : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S) (sS : S ⟶ Spec (.of k)) (ρ : S ⟶ P₂)
      (Y : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y) (gY : Y ⟶ S) (W : S.Opens)
      (Dset : Set S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (ψ : (gY ⁻¹ᵁ W).toScheme ⟶ X₃),
      ρ ≫ sP₂ = sS ∧ wcpaDjIsProjOver k sS ∧ IsProper ρ ∧ Surjective ρ ∧
      (∃ V : P₂.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) ∧
      (∀ s : S, IsRegularLocalRing (S.presheaf.stalk s)) ∧
      topologicalKrullDim S = (nP : WithBot ℕ∞) ∧
      wcpaDjSNCSet S Dset ∧ (W : Set S)ᶜ ⊆ Dset ∧
      wcpaDjIsProjOver k (gY ≫ sS) ∧ wcpaDjSemistable gY ∧ wcpaDjSections gY m τ ∧
      W ≠ ⊥ ∧ W ≤ ρ ⁻¹ᵁ U₂ ∧ SmoothOfRelativeDimension 1 (gY ∣_ W) ∧
      GeometricallyConnected (gY ∣_ W) ∧
      IsPullback ψ (gY ∣_ W) f₃ (W.ι ≫ ρ) ∧
      (∀ c, ψ c ∈ ⋃ i, Set.range ⇑(σ i) → (gY ⁻¹ᵁ W).ι c ∈ ⋃ j, Set.range ⇑(τ j)) ∧
      ∃ (N : ℕ) (j₃ : X₃ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra) (I : Finset (Fin (N + 1))),
        IsClosedImmersion j₃ ∧
        j₃ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) = f₃ ≫ sP₂ ∧
        (∀ (x : X₃) (i : Fin (N + 1)), i ∉ I →
          j₃ x ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            MvPolynomial.gradedAlgebra (MvPolynomial.X i)) ∧
        (∀ c, (∃ i ∈ I, j₃ (ψ c) ∉ @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
          (gY ⁻¹ᵁ W).ι c ∈ ⋃ j, Set.range ⇑(τ j)) :=
by
  intro k _ _ X₁ P _ _ sP f hf hP hflat U hU hUsm hUgc n0 σ0 hσ0 hσ0d nP hdim hIH
  classical
  have capp : ∀ {A B C : Scheme.{u}} (φ : A ⟶ B) (ψ : B ⟶ C) (x : A), ψ (φ x) = (φ ≫ ψ) x :=
    fun φ ψ x => (Scheme.Hom.comp_apply φ ψ x).symm
  have papp : ∀ {A B : Scheme.{u}} {φ ψ : A ⟶ B}, φ = ψ → ∀ x : A, φ x = ψ x :=
    fun h x => by rw [h]
  have gen_of_surj : ∀ {A B : Scheme.{u}} [AlgebraicGeometry.IsIntegral A]
      [AlgebraicGeometry.IsIntegral B] (φ : A ⟶ B), Surjective φ →
      φ (genericPoint A) = genericPoint B := by
    intro A B _ _ φ hφ
    haveI := hφ
    have h1 : IsGenericPoint (φ (genericPoint A)) Set.univ := by
      rw [isGenericPoint_iff_specializes]
      intro y
      simp only [Set.mem_univ, iff_true]
      obtain ⟨x, rfl⟩ := φ.surjective y
      exact ((genericPoint_spec A).specializes (Set.mem_univ x)).map φ.continuous
    exact h1.eq (genericPoint_spec B)
  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hfsPp : IsProper (f ≫ sP) := wcpa_dj_proj_proper k _ hf
  haveI hfp : IsProper f := IsProper.of_comp f sP
  obtain ⟨N, j₃, hj₃, hj₃eq⟩ := id hf
  let BO : Fin (N + 1) → (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra).Opens := fun i => @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
        (MvPolynomial.X i)
  obtain ⟨I, hI⟩ : ∃ I : Finset (Fin (N + 1)), ∀ i, i ∈ I ↔ ∃ x : X₁, j₃ x ∈ BO i :=
    ⟨Finset.univ.filter (fun i => ∃ x : X₁, j₃ x ∈ BO i), fun i => by simp⟩
  obtain ⟨H, hHcl, hHne, hHmem⟩ : ∃ H : Fin (N + 1) → Set X₁, (∀ i, IsClosed (H i)) ∧
      (∀ i, genericPoint X₁ ∉ H i) ∧ ∀ i x, i ∈ I → j₃ x ∉ BO i → x ∈ H i := by
    refine ⟨fun i => if i ∈ I then (⇑j₃ ⁻¹' (BO i : Set _))ᶜ else ∅, fun i => ?_, fun i => ?_,
      fun i x hi hx => ?_⟩
    · show IsClosed (if i ∈ I then _ else _)
      split_ifs
      · exact ((BO i).isOpen.preimage j₃.continuous).isClosed_compl
      · exact isClosed_empty
    · show genericPoint X₁ ∉ (if i ∈ I then _ else _)
      split_ifs with hi
      · intro hη
        obtain ⟨x, hx⟩ := (hI i).mp hi
        have hcl : IsClosed (⇑j₃ ⁻¹' (BO i : Set _))ᶜ :=
          ((BO i).isOpen.preimage j₃.continuous).isClosed_compl
        exact ((genericPoint_spec X₁).specializes (Set.mem_univ x)).mem_closed hcl hη hx
      · simp
    · show x ∈ (if i ∈ I then _ else _)
      rw [if_pos hi]
      exact hx
  obtain ⟨T, hTdef⟩ : ∃ T : Set X₁,
      T = (⋃ i, Set.range ⇑(σ0 i)) ∪ ⇑f ⁻¹' ((U : Set P)ᶜ) ∪ ⋃ i, H i := ⟨_, rfl⟩
  have hηU : genericPoint P ∈ U := by
    obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact ((genericPoint_spec P).specializes (Set.mem_univ p)).mem_open U.isOpen hp
  have hσcl : ∀ i, IsClosed (Set.range ⇑(σ0 i)) := by
    intro i
    haveI : IsClosedImmersion (σ0 i ≫ f) := by rw [hσ0 i]; infer_instance
    haveI : IsClosedImmersion (σ0 i) := IsClosedImmersion.of_comp (σ0 i) f
    exact (IsClosedImmersion.isClosedEmbedding (σ0 i)).isClosed_range
  have hTcl : IsClosed T := by
    rw [hTdef]
    exact ((isClosed_iUnion_of_finite hσcl).union
      (U.isOpen.isClosed_compl.preimage f.continuous)).union (isClosed_iUnion_of_finite hHcl)
  have hηT : genericPoint X₁ ∉ T := by
    obtain ⟨hgen, -, hinf, -⟩ := wcpa_dj_ssm_generic_fibre X₁ P f U hU hUsm hUgc
    rw [hTdef]
    rintro ((h | h) | h)
    · obtain ⟨i, p, hp⟩ := Set.mem_iUnion.mp h
      have hall : ∀ x : X₁, x ∈ Set.range ⇑(σ0 i) := fun x =>
        ((genericPoint_spec X₁).specializes (Set.mem_univ x)).mem_closed (hσcl i) ⟨p, hp⟩
      apply hinf
      apply (Set.finite_singleton (σ0 i (genericPoint P))).subset
      intro x hx
      obtain ⟨q, rfl⟩ := hall x
      have hx' : f (σ0 i q) = genericPoint P := hx
      have hq : q = f (σ0 i q) := by rw [capp (σ0 i) f, hσ0 i]; try rfl
      rw [Set.mem_singleton_iff, hq, hx']
    · apply h
      show f (genericPoint X₁) ∈ (U : Set P)
      rw [hgen]
      exact hηU
    · obtain ⟨i, hi⟩ := Set.mem_iUnion.mp h
      exact hHne i hi
  have hTne : T ≠ Set.univ := fun h => hηT (by rw [h]; exact Set.mem_univ _)

  obtain ⟨hgen, hres, hinf, hfin⟩ := wcpa_dj_ssm_generic_fibre X₁ P f U hU hUsm hUgc
  have hTF : (T ∩ {x : X₁ | f x = genericPoint P}).Finite := hfin T hTcl hηT
  have hinf2 : ({x : X₁ | f x = genericPoint P} \
      ({genericPoint X₁} ∪ (T ∩ {x : X₁ | f x = genericPoint P}))).Infinite :=
    hinf.diff ((Set.finite_singleton _).union hTF)
  obtain ⟨E, hEsub, hEcard⟩ := hinf2.exists_subset_card_eq 3
  have hY₀F : ∀ y ∈ hTF.toFinset ∪ E, f y = genericPoint P ∧ y ≠ genericPoint X₁ := by
    intro y hy
    rcases Finset.mem_union.mp hy with h | h
    · have h' := (Set.Finite.mem_toFinset hTF).mp h
      exact ⟨h'.2, fun he => hηT (he ▸ h'.1)⟩
    · have h' := hEsub (Finset.mem_coe.mpr h)
      exact ⟨h'.1, fun he => h'.2 (Set.mem_union_left _ (Set.mem_singleton_iff.mpr he))⟩
  have hY₀res : ∀ y ∈ hTF.toFinset ∪ E, f y = genericPoint P ∧ (f.residueFieldMap y).hom.Finite :=
    fun y hy => ⟨(hY₀F y hy).1, hres y (hY₀F y hy).1 (hY₀F y hy).2⟩
  have hY₀T : ∀ x : X₁, f x = genericPoint P → x ∈ T → x ∈ hTF.toFinset ∪ E := by
    intro x hx hxT
    exact Finset.mem_union_left _ ((Set.Finite.mem_toFinset hTF).mpr ⟨hxT, hx⟩)
  have hY₀card : 3 ≤ (hTF.toFinset ∪ E).card := hEcard ▸ Finset.card_le_card Finset.subset_union_right
  obtain ⟨P₀, iP₀, β₀, hβ₀p, hβ₀s, hβ₀f, hβ₀η, S, hS, hScov, hSall⟩ :=
    wcpa_dj_ssm_rationalize k X₁ P sP f (hTF.toFinset ∪ E) hY₀res
  haveI := iP₀
  haveI := hβ₀p
  have hScard : 3 ≤ S.card := by
    refine hY₀card.trans (Finset.card_le_card_of_surjOn (fun z => Limits.pullback.fst f β₀ z) ?_)
    intro y hy
    obtain ⟨z, hz, hzy⟩ := hScov y hy
    exact ⟨z, hz, hzy⟩
  obtain ⟨zz, hzzS, hzzinj, hzzsurj⟩ : ∃ zz : Fin S.card → ↥(Limits.pullback f β₀),
      (∀ i, zz i ∈ S) ∧ Function.Injective zz ∧ ∀ z ∈ S, ∃ i, zz i = z :=
    ⟨fun i => (S.equivFin.symm i).1, fun i => (S.equivFin.symm i).2,
      fun i j h => S.equivFin.symm.injective (Subtype.ext h),
      fun z hz => ⟨S.equivFin ⟨z, hz⟩, by simp⟩⟩
  have hspread : ∀ i : Fin S.card, ∃ (W : P₀.Opens)
      (s : (W : Scheme.{u}) ⟶ Limits.pullback f β₀) (hW : genericPoint P₀ ∈ W),
      s ≫ Limits.pullback.snd f β₀ = W.ι ∧ s ⟨genericPoint P₀, hW⟩ = zz i :=
    fun i => wcpa_dj_ssm_spread_section (Limits.pullback.snd f β₀) (zz i)
      (hS _ (hzzS i)).1 (hS _ (hzzS i)).2
  choose Wsp s hWsp hsW hsη using hspread
  obtain ⟨P10, iP10, ρ, t, hρp, hρs, hρf, ht, htη⟩ :=
    wcpa_dj_ssm_extend_sections P₀ (Limits.pullback f β₀) (Limits.pullback.snd f β₀) S.card Wsp s
      hWsp hsW
  haveI := iP10
  haveI := hρp
  haveI : IsProper (ρ ≫ β₀ ≫ sP) := inferInstance
  obtain ⟨P₁, iP₁, c, hcP, hcp, hcs, hcf⟩ := wcpa_dj_cf_chow_projective k P10 (ρ ≫ β₀ ≫ sP)
  haveI := iP₁
  haveI := hcp
  obtain ⟨hρ's0, hρ'f0⟩ := wcpa_dj_alteration_comp ρ c hρp hρs hcs hρf hcf
  obtain ⟨ρ', hρ'def⟩ : ∃ ρ' : P₁ ⟶ P₀, ρ' = c ≫ ρ := ⟨_, rfl⟩
  have hρ'p : IsProper ρ' := by rw [hρ'def]; infer_instance
  have hρ's : Surjective ρ' := by rw [hρ'def]; exact hρ's0
  have hρ'f : ∃ V : P₀.Opens, V ≠ ⊥ ∧ IsFinite (ρ' ∣_ V) := by rw [hρ'def]; exact hρ'f0
  haveI := hρ'p
  obtain ⟨hβ₁s, hβ₁f⟩ := wcpa_dj_alteration_comp β₀ ρ' hβ₀p hβ₀s hρ's hβ₀f hρ'f
  have hβ₁p : IsProper (ρ' ≫ β₀) := inferInstance
  haveI := hβ₁p
  have hcP' : wcpaDjIsProjOver k ((ρ' ≫ β₀) ≫ sP) := by
    rw [hρ'def]; simpa only [Category.assoc] using hcP
  have hρ'η : ρ' (genericPoint P₁) = genericPoint P₀ := gen_of_surj ρ' hρ's
  obtain ⟨t', ht'def⟩ : ∃ t' : Fin S.card → (P₁ ⟶ Limits.pullback f β₀), ∀ i, t' i = c ≫ t i :=
    ⟨fun i => c ≫ t i, fun _ => rfl⟩
  have ht' : ∀ i, t' i ≫ Limits.pullback.snd f β₀ = ρ' := by
    intro i; rw [ht'def, hρ'def, Category.assoc, ht i]
  have ht'η : ∀ i, t' i (genericPoint P₁) = zz i := by
    intro i
    rw [ht'def, Scheme.Hom.comp_apply, gen_of_surj c hcs, htη i, hsη i]
  have hcond : ∀ i, (t' i ≫ Limits.pullback.fst f β₀) ≫ f = 𝟙 P₁ ≫ ρ' ≫ β₀ := by
    intro i
    rw [Category.id_comp, Category.assoc, Limits.pullback.condition, ← ht' i, Category.assoc]
  obtain ⟨σ', hσ'def⟩ : ∃ σ' : Fin S.card → (P₁ ⟶ Limits.pullback f (ρ' ≫ β₀)),
      ∀ i, σ' i = Limits.pullback.lift (t' i ≫ Limits.pullback.fst f β₀) (𝟙 P₁) (hcond i) :=
    ⟨fun i => Limits.pullback.lift (t' i ≫ Limits.pullback.fst f β₀) (𝟙 P₁) (hcond i),
      fun _ => rfl⟩
  have hσ'snd : ∀ i, σ' i ≫ Limits.pullback.snd f (ρ' ≫ β₀) = 𝟙 P₁ := by
    intro i; rw [hσ'def, Limits.pullback.lift_snd]
  have hσ'fst : ∀ i, σ' i ≫ Limits.pullback.fst f (ρ' ≫ β₀) = t' i ≫ Limits.pullback.fst f β₀ := by
    intro i; rw [hσ'def, Limits.pullback.lift_fst]
  obtain ⟨π, hπ⟩ : ∃ π : Limits.pullback f (ρ' ≫ β₀) ⟶ Limits.pullback f β₀,
      π = Limits.pullback.lift (Limits.pullback.fst f (ρ' ≫ β₀))
        (Limits.pullback.snd f (ρ' ≫ β₀) ≫ ρ')
        ((Limits.pullback.condition).trans (Category.assoc _ _ _).symm) := ⟨_, rfl⟩
  have hπfst : π ≫ Limits.pullback.fst f β₀ = Limits.pullback.fst f (ρ' ≫ β₀) := by
    rw [hπ, Limits.pullback.lift_fst]
  have hπsnd : π ≫ Limits.pullback.snd f β₀ = Limits.pullback.snd f (ρ' ≫ β₀) ≫ ρ' := by
    rw [hπ, Limits.pullback.lift_snd]
  have hπσ : ∀ i, σ' i ≫ π = t' i := by
    intro i
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hπfst, hσ'fst]
    · rw [Category.assoc, hπsnd, ← Category.assoc, hσ'snd, Category.id_comp, ht' i]
  have hσ'η : ∀ i, π (σ' i (genericPoint P₁)) = zz i := by
    intro i; rw [capp (σ' i) π, hπσ i, ht'η i]
  have hσ'sndη : ∀ i, Limits.pullback.snd f (ρ' ≫ β₀) (σ' i (genericPoint P₁)) = genericPoint P₁ := by
    intro i
    rw [capp (σ' i) (Limits.pullback.snd f (ρ' ≫ β₀)), hσ'snd i]
    try rfl
  have key : ∀ w : ↥(Limits.pullback f (ρ' ≫ β₀)),
      Limits.pullback.snd f (ρ' ≫ β₀) w = genericPoint P₁ →
      Limits.pullback.fst f (ρ' ≫ β₀) w ∈ T → ∃ i, w = σ' i (genericPoint P₁) := by
    intro w hw hwT
    have h1 : Limits.pullback.snd f β₀ (π w) = genericPoint P₀ := by
      rw [capp π (Limits.pullback.snd f β₀) w, papp hπsnd w, Scheme.Hom.comp_apply, hw, hρ'η]
    have h2 : Limits.pullback.fst f β₀ (π w) = Limits.pullback.fst f (ρ' ≫ β₀) w := by
      rw [capp π (Limits.pullback.fst f β₀) w, papp hπfst w]
    have h3 : f (Limits.pullback.fst f β₀ (π w)) = genericPoint P := by
      rw [capp (Limits.pullback.fst f β₀) f (π w), papp Limits.pullback.condition (π w),
        Scheme.Hom.comp_apply, h1, hβ₀η]
    have h4 : π w ∈ S := hSall (π w) h1 (hY₀T _ h3 (by rw [h2]; exact hwT))
    obtain ⟨i, hi⟩ := hzzsurj _ h4
    refine ⟨i, ?_⟩
    have hsnd : Limits.pullback.snd f (ρ' ≫ β₀) w =
        Limits.pullback.snd f (ρ' ≫ β₀) (σ' i (genericPoint P₁)) := by
