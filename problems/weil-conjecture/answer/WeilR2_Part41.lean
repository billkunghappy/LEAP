  have h1 := fun V => wcpa_dj_lcp_spread_local k X P sP f U n σ hin L S₀ sS₀ β₀ ε hβ₀ hS₀ hβ₀p
    hgen V (hloc V)
  choose SV iSV dV cV OV ZV uV τV Oo hOo Yo πo χo ψo so hdVproj hdVp hdViso hcen hrange hstab hgc
    hOone hχo hψo hsπ hsχ hsψ using h1
  haveI := iSV

  obtain ⟨r, Vs, S, iS, d, e, hnorm, hdproj, hdp, hds, hdf, hed, hedom, hcover⟩ :=
    wcpa_dj_lcp_rz_finite_model k S₀ sS₀ hS₀ L ε SV dV cV OV hdVproj hdVp hdViso hcen hrange
