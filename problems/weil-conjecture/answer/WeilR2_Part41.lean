      have e2 : X i' = X (finRotate (m + 2) i) :=
        le_antisymm h2 ((hXE i').1.2 (hXE _).1.1 h2)
      exact hXne i (e1.symm.trans e2)
  ·
    obtain ⟨Hp, Φ, D, Tg, d, e, w, partner, hH0, hH1, hH2, hH3, hH4, hH5⟩ :=
      wcpa_dj_nccw_half_points R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk
