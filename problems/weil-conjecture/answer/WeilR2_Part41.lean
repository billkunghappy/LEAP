      rwa [Scheme.Hom.mem_preimage] at h
    rcases hx with hx | hx
    · obtain ⟨l, p, hp⟩ := Set.mem_iUnion.mp hx
      have hpx : p = (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) (ψ₀ (φ c)) := by
        rw [← hp, capp (σ l), hσsec l]
        try rfl
      have h1 : ψ₀ (φ c) = σ l (β' (g' ((g' ⁻¹ᵁ U'').ι (φ c)))) := by
        rw [← hx2, ← hpx, hp]
      have h2 := (hiff (φ c) l).mp h1
      have hb : (g' ⁻¹ᵁ U'').ι (φ c) = Limits.pullback.fst g' ρ₀
          (((Limits.pullback.snd g' ρ₀) ⁻¹ᵁ (ρ₀ ⁻¹ᵁ U'')).ι c) := by
        rw [capp φ, papp hφ2, Scheme.Hom.comp_apply]
      apply hτcont
      show Limits.pullback.fst g' ρ₀ (((Limits.pullback.snd g' ρ₀) ⁻¹ᵁ (ρ₀ ⁻¹ᵁ U'')).ι c) ∈
        ⋃ j, Set.range ⇑(τ' j)
      rw [← hb]
      exact Set.mem_iUnion.mpr ⟨l, _, h2.symm⟩
    · exact (hx (show (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) (ψ₀ (φ c)) ∈ (U₁ : Set P₁) by
        rw [hx2]; exact hU1)).elim
  refine ⟨S0, iS, sS, ρ₀ ≫ β' ≫ ρ' ≫ β₀, Limits.pullback g' ρ₀, hYint, Limits.pullback.snd g' ρ₀,
    ρ₀ ⁻¹ᵁ U'', Dset, S.card, τ,
    ℓ ≫ ((ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ⁻¹ᵁ ((ρ' ≫ β₀) ⁻¹ᵁ U)).ι ≫ ι ≫
      Limits.pullback.fst f (ρ' ≫ β₀),
    ?_, hSproj, inferInstance, hs2, hf2, hreg, hdimS, hsnc, ?_, hYproj, hYss, hτ, ?_, ?_,
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hAsq hsm'',
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hAsq hgc'', hfinal, ?_,
    N, j₃, I, hj₃, hj₃eq, ?_, ?_⟩
  · rw [← hρ₀, ← hβ']; simp only [Category.assoc]
  · intro x hx
    exact hE hx
  · obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U'').mp hU''ne
    haveI := hρ₀s
    obtain ⟨x, hx⟩ := ρ₀.surjective p
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr
      ⟨x, show ρ₀ x ∈ U'' by rw [hx]; exact hp⟩
  · intro x hx
    have h := hUV _ hx
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    exact h
  · intro c hc
    rw [hψc c] at hc
    apply hd c
    rw [hTdef]
    exact Or.inl (Or.inl hc)
  · intro x i hi hx
    exact hi ((hI i).mpr ⟨x, hx⟩)
  · rintro c ⟨i, hi, hc⟩
    rw [hψc c] at hc
    apply hd c
    rw [hTdef]
    exact Or.inr (Set.mem_iUnion.mpr ⟨i, hHmem i _ hi hc⟩)

theorem wcpa_dj_bsc_sing_finite : ∀ (k : Type u) [Field k] [Finite k] (C P' S : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P') (ι : S ⟶ C), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → wcpaDjSemistable g → IsClosedImmersion ι → (∀ x : C, x ∈ Set.range ι ↔ ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → IsFinite (ι ≫ g) :=
by
  intro k _ _ C P' S sP' g ι hgP hP' hss hι hset
  classical

  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsProper f →
      (∀ y : Y, (⇑f ⁻¹' {y}).Finite) → IsFinite f := by
    intro X Y f hf hfib
    haveI := hf
    haveI : LocallyQuasiFinite f := by
      rw [locallyQuasiFinite_iff]
      intro U hU V hV e
      letI := (f.appLE U V e).hom.toAlgebra
      haveI : Algebra.FiniteType Γ(Y, U) Γ(X, V) := LocallyOfFiniteType.finiteType_appLE f hU hV e
      have hqf : Algebra.QuasiFinite Γ(Y, U) Γ(X, V) := by
        rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
        intro x
        have hinj : Function.Injective hV.fromSpec := hV.fromSpec.isOpenEmbedding.injective
        refine ((hfib (hU.fromSpec x)).preimage (fun _ _ _ _ h => hinj h)).subset ?_
        intro q hq
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at hq ⊢
        rw [← Scheme.Hom.comp_apply, ← IsAffineOpen.SpecMap_appLE_fromSpec f hU hV e,
          Scheme.Hom.comp_apply]
        congr 1
      exact hqf
    exact IsFinite.of_isProper_of_locallyQuasiFinite f

  have s3 : ∀ (K R : Type u) [Field K] [CommRing R] [IsLocalRing R] (σ : K →+* R)
      (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
      e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp σ) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C →
      Function.Surjective ((IsLocalRing.residue R).comp σ) := by
    intro K R _ _ _ σ e he r
    have hnu : ∀ H : MvPowerSeries (Fin 2) K, MvPowerSeries.constantCoeff H = 0 →
        ¬ IsUnit (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
          MvPowerSeries (Fin 2) K)}) H) := by
      intro H hH hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      obtain ⟨H', rfl⟩ := Ideal.Quotient.mk_surjective v
      have hv' : Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
          MvPowerSeries (Fin 2) K)}) (H * H') = Ideal.Quotient.mk _ 1 := by
        rw [map_mul, map_one]; exact hv
      obtain ⟨Q, hQ⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq.mp hv')
      have h1 := congrArg MvPowerSeries.constantCoeff hQ
      simp only [map_mul, map_sub, map_one, MvPowerSeries.constantCoeff_X, mul_zero, hH,
        zero_mul, zero_sub] at h1
      exact one_ne_zero (neg_eq_zero.mp h1.symm)
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective r
    obtain ⟨F, hF⟩ := Ideal.Quotient.mk_surjective
      (e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) a))
    refine ⟨MvPowerSeries.constantCoeff F, ?_⟩
    show IsLocalRing.residue R (σ (MvPowerSeries.constantCoeff F)) = IsLocalRing.residue R a
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    by_contra h
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at h
    have h1 : e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)
        (σ (MvPowerSeries.constantCoeff F))) =
        Ideal.Quotient.mk _ (MvPowerSeries.C (MvPowerSeries.constantCoeff F)) :=
      RingHom.congr_fun he (MvPowerSeries.constantCoeff F)
    have h2 : e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)
        (σ (MvPowerSeries.constantCoeff F) - a)) =
        Ideal.Quotient.mk _ (MvPowerSeries.C (MvPowerSeries.constantCoeff F) - F) := by
      simp only [map_sub]
      rw [h1, ← hF]
    have hcc : MvPowerSeries.constantCoeff
        (MvPowerSeries.C (MvPowerSeries.constantCoeff F) - F : MvPowerSeries (Fin 2) K) = 0 := by
      rw [map_sub, MvPowerSeries.constantCoeff_C, sub_self]
    have hu := (h.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))).map e
    rw [h2] at hu
    exact hnu _ hcc hu

  have s4 : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (π : Z ⟶ Spec (.of K)) (z : Z),
      LocallyOfFiniteType π →
      Function.Surjective ((IsLocalRing.residue (Z.presheaf.stalk z)).comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫ π.appTop ≫ Z.presheaf.germ ⊤ z trivial).hom) →
      IsClosed ({z} : Set Z) := by
    intro K _ Z π z hπ hsurj
    haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace π
    rw [isClosed_singleton_iff_locallyOfFiniteType]
    have heq : Z.fromSpecResidueField z ≫ π = Spec.map (CommRingCat.ofHom
        ((IsLocalRing.residue (Z.presheaf.stalk z)).comp
          ((Scheme.ΓSpecIso (.of K)).inv ≫ π.appTop ≫ Z.presheaf.germ ⊤ z trivial).hom) :
        CommRingCat.of K ⟶ Z.residueField z) := by
      apply ext_of_isAffine
      rw [← cancel_epi (Scheme.ΓSpecIso (.of K)).inv, ← cancel_mono (Scheme.ΓSpecIso _).hom]
      simp only [Scheme.Hom.comp_appTop, Scheme.fromSpecResidueField, Scheme.fromSpecStalk_appTop,
        Category.assoc, Scheme.ΓSpecIso_naturality]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Iso.inv_hom_id_assoc]
      erw [Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
      rfl
    haveI : LocallyOfFiniteType (Z.fromSpecResidueField z ≫ π) := by
      rw [heq]
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
        (RingHom.FiniteType.of_surjective _ hsurj)
    exact locallyOfFiniteType_of_comp _ π

  have s6 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] [QuasiSober X]
      (s : Set X), IsClosed s → (∀ x ∈ s, IsClosed ({x} : Set X)) → s.Finite := by
    intro X _ _ _ s hs hpt
    obtain ⟨T, hTf, hTcl, hTirr, rfl⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hs
    refine hTf.sUnion fun t ht => ?_
    have hgen := (hTirr t ht).isGenericPoint_genericPoint_closure
    rw [(hTcl t ht).closure_eq] at hgen
    have hη : (hTirr t ht).genericPoint ∈ t := hgen.mem
    have hcl : IsClosed ({(hTirr t ht).genericPoint} : Set X) :=
      hpt _ (Set.mem_sUnion_of_mem hη ht)
    have ht' : t = {(hTirr t ht).genericPoint} := hgen.def.symm.trans hcl.closure_eq
    exact ht' ▸ Set.finite_singleton _

  haveI : IsProper g := hss.2.1
  haveI : IsClosedImmersion ι := hι
  haveI : IsProper sP' := wcpa_dj_proj_proper k sP' hP'
  haveI : IsLocallyNoetherian P' := LocallyOfFiniteType.isLocallyNoetherian sP'
  have hlofp : LocallyOfFinitePresentation g := inferInstance
  have hfin : ∀ p : P', {x : C | g x = p ∧
      ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)}.Finite := by
    intro p
    let sb : Spec (.of (AlgebraicClosure (P'.residueField p))) ⟶ P' :=
      Spec.map (CommRingCat.ofHom (algebraMap (P'.residueField p)
        (AlgebraicClosure (P'.residueField p)))) ≫ P'.fromSpecResidueField p
    let Z := Limits.pullback g sb
    let a : Z ⟶ Spec (.of (AlgebraicClosure (P'.residueField p))) := Limits.pullback.snd g sb
    let Sg : Set Z := {w | ¬ ∃ W : Z.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a)}
    have hc1 : IsClosed Sg := by
      rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
      intro w hw
      have hw' : ∃ W : Z.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a) := by
        by_contra hc; exact hw hc
      obtain ⟨W, hwW, hW⟩ := hw'
      refine ⟨W, fun w' hw'' => ?_, W.isOpen, hwW⟩
      intro hc
      exact hc ⟨W, hw'', hW⟩
    haveI ha_loft : LocallyOfFiniteType a :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback g sb) (inferInstance : LocallyOfFiniteType g)
    haveI ha_prop : IsProper a :=
      MorphismProperty.of_isPullback (P := @IsProper)
        (IsPullback.of_hasPullback g sb) hss.2.1
    have hc2 : ∀ w ∈ Sg, IsClosed ({w} : Set Z) := by
      intro w hw
      rcases hss.2.2 (AlgebraicClosure (P'.residueField p)) sb w with hd | ⟨e, he⟩
      · exact absurd hd hw
      · exact s4 _ Z a w ha_loft (s3 _ _ _ e he)
    haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace a
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian a
    haveI : AlgebraicGeometry.IsNoetherian Z := AlgebraicGeometry.IsNoetherian.mk
    have hc4 : Sg.Finite := s6 Z Sg hc1 hc2
    refine (hc4.image (Limits.pullback.fst g sb)).subset ?_
    rintro x ⟨hxp, hxns⟩
    have hpt : g x = sb (IsLocalRing.closedPoint (AlgebraicClosure (P'.residueField p))) := by
      have hr : ∀ y, P'.fromSpecResidueField p y = p := fun y => by
        have hy : P'.fromSpecResidueField p y ∈ Set.range (P'.fromSpecResidueField p) := ⟨y, rfl⟩
        rw [Scheme.range_fromSpecResidueField] at hy
        exact hy
      rw [hxp]
      exact (hr _).symm
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := g)
      (g := sb) x (IsLocalRing.closedPoint (AlgebraicClosure (P'.residueField p))) hpt
    refine ⟨w, ?_, hw1⟩
    show ¬ _
    intro hsm
    obtain ⟨W', hW'1, hW'2⟩ :=
      wcpa_dj_bsc_smooth_descend P' C g _ sb w hss.1 hlofp hsm
    exact hxns ⟨W', hw1 ▸ hW'1, hW'2⟩
  apply s2 (ι ≫ g) inferInstance
  intro p
  have hinj : Function.Injective ι := ι.isClosedEmbedding.injective
  refine ((hfin p).preimage (fun _ _ _ _ h => hinj h)).subset ?_
  intro y hy
  simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply] at hy
  exact ⟨hy, (hset (ι y)).mp ⟨y, rfl⟩⟩

theorem wcpa_dj_lqu_pointwise : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y), (∀ y : X, ∃ (U : Y.Opens) (_ : IsAffineOpen U) (V : X.Opens) (hV : IsAffineOpen V) (hy : y ∈ V) (e : V ≤ h ⁻¹ᵁ U) (d : Γ(X, V)), d ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∧ letI := (h.appLE U V e).hom.toAlgebra; ∀ ω : KaehlerDifferential Γ(Y, U) Γ(X, V), d • ω = 0) → FormallyUnramified h :=
by
  intro X Y h H
  have key_alg : ∀ {A B B' : Type u} [CommRing A] [CommRing B] [CommRing B'] (φ : A →+* B)
      [Algebra B B'] (d : B) [IsLocalization.Away d B'],
      (letI := φ.toAlgebra; ∀ ω : KaehlerDifferential A B, d • ω = 0) →
      ((algebraMap B B').comp φ).FormallyUnramified := by
    intro A B B' _ _ _ φ _ d _ hk
    letI : Algebra A B := φ.toAlgebra
    letI : Algebra A B' := ((algebraMap B B').comp φ).toAlgebra
    haveI : IsScalarTower A B B' := IsScalarTower.of_algebraMap_eq' rfl
    show Algebra.FormallyUnramified A B'
    have ha : ∀ b : B, algebraMap B B' d • KaehlerDifferential.D A B' (algebraMap B B' b) = 0 := by
      intro b
      have h1 := (KaehlerDifferential.map A A B B').map_smul d (KaehlerDifferential.D A B b)
      rw [hk, map_zero, KaehlerDifferential.map_D, ← algebraMap_smul B'] at h1
      exact h1.symm
    have hD : ∀ z : B', KaehlerDifferential.D A B' z = 0 := by
      intro z
      obtain ⟨n, b, hz⟩ := IsLocalization.Away.surj d z
      have e1 := congrArg (KaehlerDifferential.D A B') hz
      rw [Derivation.leibniz] at e1
      have e2 := congrArg (algebraMap B B' d • ·) e1
      simp only [smul_add] at e2
      have ha' := ha (d ^ n)
      rw [map_pow] at ha'
      rw [ha b, smul_comm _ z, ha', smul_zero, zero_add, smul_smul] at e2
      have hu : IsUnit (algebraMap B B' d * algebraMap B B' d ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit d).mul
          ((IsLocalization.Away.algebraMap_isUnit d).pow n)
      exact hu.smul_eq_zero.mp e2
    have key : ∀ ω : Ω[B'⁄A], ω = 0 := by
      intro ω
      have hω : ω ∈ Submodule.span B' (Set.range (KaehlerDifferential.D A B')) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction with
      | mem x hx => obtain ⟨z, rfl⟩ := hx; exact hD z
      | zero => rfl
      | add x y _ _ hx hy => rw [hx, hy, add_zero]
      | smul a x _ hx => rw [hx, smul_zero]
    constructor
    exact ⟨fun ω₁ ω₂ => by rw [key ω₁, key ω₂]⟩
  rw [HasRingHomProperty.iff_exists_appLE (P := @FormallyUnramified)
    (RingHom.FormallyUnramified.stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.FormallyUnramified.holdsForLocalizationAway).1]
  intro y
  obtain ⟨U, hU, V, hV, hy, e, d, hd, hk⟩ := H y
  have hy' : y ∈ X.basicOpen d := by
    have h1 := hV.fromSpec_primeIdealOf ⟨y, hy⟩
    have h3 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen d :=
      (PrimeSpectrum.mem_basicOpen _ _).mpr hd
    rw [← hV.fromSpec_preimage_basicOpen d] at h3
    have h4 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ X.basicOpen d := h3
    rw [h1] at h4
    exact h4
  have e' : X.basicOpen d ≤ h ⁻¹ᵁ U := (X.basicOpen_le d).trans e
  refine ⟨⟨U, hU⟩, ⟨X.basicOpen d, hV.basicOpen d⟩, hy', e', ?_⟩
  have hc : h.appLE U (X.basicOpen d) e' =
      h.appLE U V e ≫ X.presheaf.map (homOfLE (X.basicOpen_le d)).op :=
    (Scheme.Hom.appLE_map h e _).symm
  haveI := hV.isLocalization_basicOpen d
  have := key_alg (B' := Γ(X, X.basicOpen d)) (h.appLE U V e).hom d hk
  change RingHom.FormallyUnramified (h.appLE U (X.basicOpen d) e').hom
  rw [hc, CommRingCat.hom_comp]
  exact this

theorem wcpa_dj_lqu_pnt_minor_vanish : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → wcpaLquPNT F c → ∀ s, MvPolynomial.eval c (wcpaLquGen F s) = 0 :=
by
  intro K _ m r F c hF hPNT s
  classical
  have hLadd : ∀ v w : Fin m → K, wcpaLquLin c (v + w) = wcpaLquLin c v + wcpaLquLin c w := by
    intro v w
    simp only [wcpaLquLin, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
  have hLsmul : ∀ (a : K) (v : Fin m → K),
      wcpaLquLin c (a • v) = MvPolynomial.C a * wcpaLquLin c v := by
    intro a v
    simp only [wcpaLquLin, Pi.smul_apply, smul_eq_mul, map_mul, Finset.mul_sum, mul_assoc]
  have hL0 : wcpaLquLin c (0 : Fin m → K) = 0 := by
    simp [wcpaLquLin]
  have hLmem : ∀ w, wcpaLquLin c w ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := by
    intro w
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
  have hLsingle : ∀ n, wcpaLquLin c (Pi.single n 1) = MvPolynomial.X n - MvPolynomial.C (c n) := by
    intro n
    simp only [wcpaLquLin]
    rw [Finset.sum_eq_single n]
    · simp
    · intro b _ hb
      simp [hb]
    · simp
  have ering : ∀ (P A Ce Ccn Xn : MvPolynomial (Fin m) K),
      P * Xn - Ce * Ccn - (Ccn * A + Ce * (Xn - Ccn)) = (P - Ce - A) * Xn + A * (Xn - Ccn) := by
    intros; ring
  have taylor : ∀ p : MvPolynomial (Fin m) K, p - MvPolynomial.C (MvPolynomial.eval c p) -
      wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      have h0 : (fun l => MvPolynomial.eval c
          (MvPolynomial.pderiv l (MvPolynomial.C a : MvPolynomial (Fin m) K))) = 0 := by
        funext l
        simp
      rw [h0, hL0, MvPolynomial.eval_C, sub_self, sub_zero]
      exact zero_mem _
    | add p q hp hq =>
      have h0 : (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p + q))) =
          (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) +
            (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) := by
        funext l
        simp
      rw [h0, hLadd]
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) -
          (wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) +
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) =
          (p - MvPolynomial.C (MvPolynomial.eval c p) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p))) +
          (q - MvPolynomial.C (MvPolynomial.eval c q) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) := by
        rw [map_add, map_add]
        ring
      rw [e]
      exact add_mem hp hq
    | mul_X p n hp =>
      have hlin : (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * MvPolynomial.X n))) =
          c n • (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) +
            MvPolynomial.eval c p • (Pi.single n 1 : Fin m → K) := by
        funext l
        simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, map_mul,
          MvPolynomial.eval_X, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        by_cases h : l = n
        · subst h
          simp only [Pi.single_eq_same, map_one] <;> ring
        · have h' : n ≠ l := Ne.symm h
          simp [h, h'] <;> ring
      rw [hlin, hLadd, hLsmul, hLsmul, hLsingle, MvPolynomial.eval_mul, MvPolynomial.eval_X,
        map_mul, ering]
      refine add_mem (Ideal.mul_mem_right _ _ hp) ?_
      rw [pow_two]
      exact Ideal.mul_mem_mul (hLmem _) (Ideal.subset_span ⟨n, rfl⟩)
  set L : Fin r → Fin m → K := fun j l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))
    with hLdef
  have hΛ : ∀ v ∈ Submodule.span K (Set.range L), wcpaLquLin c v ∈ wcpaLquI F c 2 := by
    intro v hv
    unfold wcpaLquI
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      have h1 := taylor (F j)
      rw [hF j, map_zero, sub_zero] at h1
      have e : wcpaLquLin c (L j) = F j - (F j - wcpaLquLin c (L j)) := by ring
      rw [e]
      exact sub_mem (Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)) (Ideal.mem_sup_left h1)
    | zero => rw [hL0]; exact zero_mem _
    | add x y _ _ hx hy => rw [hLadd]; exact add_mem hx hy
    | smul a x _ hx => rw [hLsmul]; exact Ideal.mul_mem_left _ _ hx
  obtain ⟨α, β, -, hb, -⟩ := hPNT
  have hdisj : ∀ a b : K, a • α + b • β ∈ Submodule.span K (Set.range L) → a = 0 ∧ b = 0 := by
    intro a b h
    apply hb
    have h2 := hΛ _ h
    rwa [hLadd, hLsmul, hLsmul] at h2
  rcases s with j | ⟨ρ', κ⟩
  · exact hF j
  · show MvPolynomial.eval c
      (Matrix.det (Matrix.of fun i j => MvPolynomial.pderiv (κ j) (F (ρ' i)))) = 0
    rw [RingHom.map_det]
    by_contra hne
    have hrows := Matrix.linearIndependent_rows_of_det_ne_zero hne
    have hv : LinearIndependent K (fun i => L (ρ' i)) := by
      apply LinearIndependent.of_comp (LinearMap.funLeft K K κ)
      convert hrows using 1
      funext i
      funext l
      simp [hLdef, RingHom.mapMatrix_apply, Matrix.map_apply, LinearMap.funLeft_apply]
    have hab : LinearIndependent K ![α, β] := by
      rw [LinearIndependent.pair_iff]
      intro s t h
      exact hdisj s t (by rw [h]; exact zero_mem _)
    have hD : Disjoint (Submodule.span K (Set.range fun i => L (ρ' i)))
        (Submodule.span K (Set.range ![α, β])) := by
      rw [Submodule.disjoint_def]
      intro x hx1 hx2
      have hx1' : x ∈ Submodule.span K (Set.range L) :=
        Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨ρ' i, rfl⟩) hx1
      obtain ⟨g, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx2
      rw [Fin.sum_univ_two] at hx1' ⊢
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hx1' ⊢
      obtain ⟨h0, h1⟩ := hdisj _ _ hx1'
      rw [h0, h1]
      simp
    have hall := hv.sum_type hab hD
    have hcard := hall.fintype_card_le_finrank
    rw [Module.finrank_fin_fun, Fintype.card_sum, Fintype.card_fin, Fintype.card_fin] at hcard
    omega

theorem wcpa_dj_lq_unramified : ∀ (k : Type u) [Field k] [Finite k] (C P' S : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P') (ι : S ⟶ C), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → wcpaDjSemistable g → IsClosedImmersion ι → IsReduced S → (∀ x : C, x ∈ Set.range ι ↔ ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → FormallyUnramified (ι ≫ g) :=
by
  intro k _ _ C P' S sP' g ι _hgP hP' hss hι hred hset
  haveI := hι
  haveI hgprop : IsProper g := hss.2.1
  haveI hsP' : IsProper sP' := wcpa_dj_proj_proper k sP' hP'
  haveI hPnoeth : IsLocallyNoetherian P' := LocallyOfFiniteType.isLocallyNoetherian sP'
  apply wcpa_dj_lqu_pointwise (ι ≫ g)
  intro y

  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := g (ι y))
    (U := (⊤ : P'.Opens)) trivial
  obtain ⟨V₀, hV₀, hxV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset (x := ι y)
    (U := g ⁻¹ᵁ U) hxU
  have e : V₀ ≤ g ⁻¹ᵁ U := fun z hz => hV₀sub hz
  have hV : IsAffineOpen (ι ⁻¹ᵁ V₀) := hV₀.preimage ι
  have hy : y ∈ ι ⁻¹ᵁ V₀ := hxV₀
  have e' : ι ⁻¹ᵁ V₀ ≤ (ι ≫ g) ⁻¹ᵁ U := fun z hz => e hz
  obtain ⟨π, hπdef⟩ : ∃ π : Γ(C, V₀) ⟶ Γ(S, ι ⁻¹ᵁ V₀), π = ι.appLE V₀ (ι ⁻¹ᵁ V₀) le_rfl :=
    ⟨_, rfl⟩
  have hπsurj : Function.Surjective π.hom := by
    rw [hπdef, Scheme.Hom.appLE_eq_app]
    exact Scheme.Hom.app_surjective ι V₀ hV₀
  have hcomp : (ι ≫ g).appLE U (ι ⁻¹ᵁ V₀) e' = g.appLE U V₀ e ≫ π := by
    rw [hπdef, Scheme.Hom.appLE_comp_appLE]

  haveI hA : IsNoetherianRing Γ(P', U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have hft : (g.appLE U V₀ e).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨U, hU⟩ ⟨V₀, hV₀⟩ e
  obtain ⟨m, p, hpC, hpsurj⟩ : ∃ (m : ℕ) (p : MvPolynomial (Fin m) Γ(P', U) →+* Γ(C, V₀)),
      p.comp MvPolynomial.C = (g.appLE U V₀ e).hom ∧ Function.Surjective p := by
    letI := (g.appLE U V₀ e).hom.toAlgebra
    obtain ⟨m, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    refine ⟨m, (f : MvPolynomial (Fin m) Γ(P', U) →+* Γ(C, V₀)), ?_, hf⟩
    rw [← MvPolynomial.algebraMap_eq]
    exact f.comp_algebraMap
  obtain ⟨r, F, hF⟩ : ∃ (r : ℕ) (F : Fin r → MvPolynomial (Fin m) Γ(P', U)),
      RingHom.ker p = Ideal.span (Set.range F) := by
    have hfg : (RingHom.ker p).FG := IsNoetherian.noetherian _
    obtain ⟨r, F, hF⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    exact ⟨r, F, hF.symm⟩
  have hFker : ∀ j, p (F j) = 0 := by
    intro j
    have h : F j ∈ RingHom.ker p := by
      rw [hF]
      exact Ideal.subset_span ⟨j, rfl⟩
    exact RingHom.mem_ker.mp h

  have hpt : ∀ (L : Type u) [Field L] (χ : Γ(S, ι ⁻¹ᵁ V₀) →+* L),
      hV₀.fromSpec ⟨RingHom.ker (χ.comp π.hom), RingHom.ker_isPrime _⟩ ∈ Set.range ι := by
    intro L _ χ
    let q : Spec Γ(S, ι ⁻¹ᵁ V₀) := ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩
    refine ⟨hV.fromSpec q, ?_⟩
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec ι hV₀ hV (le_refl (ι ⁻¹ᵁ V₀))
    rw [← hπdef] at h1
    have hq : (⟨RingHom.ker (χ.comp π.hom), RingHom.ker_isPrime _⟩ : Spec Γ(C, V₀)) =
        Spec.map π q := by
      first
        | (rw [Spec.map_apply]; exact PrimeSpectrum.ext (RingHom.comap_ker χ π.hom).symm)
        | exact PrimeSpectrum.ext (RingHom.comap_ker χ π.hom).symm
    have h3 : (Spec.map π ≫ hV₀.fromSpec) q = (hV.fromSpec ≫ ι) q := by rw [h1]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h3
    rw [hq, h3]

  have hcompat : ∀ (L : Type u) [Field L] (χ : Γ(S, ι ⁻¹ᵁ V₀) →+* L)
      (P : MvPolynomial (Fin m) Γ(P', U)),
      MvPolynomial.eval (fun l => (χ.comp π.hom) (p (MvPolynomial.X l)))
        (MvPolynomial.map ((χ.comp π.hom).comp (g.appLE U V₀ e).hom) P) = χ (π.hom (p P)) := by
    intro L _ χ P
    have h : (MvPolynomial.eval (fun l => (χ.comp π.hom) (p (MvPolynomial.X l)))).comp
        (MvPolynomial.map ((χ.comp π.hom).comp (g.appLE U V₀ e).hom)) = (χ.comp π.hom).comp p := by
      apply MvPolynomial.ringHom_ext
      · intro a
        have h2 : p (MvPolynomial.C a) = (g.appLE U V₀ e).hom a := RingHom.congr_fun hpC a
        simp only [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval_C]
        rw [h2]
      · intro l
        simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval_X]
    exact RingHom.congr_fun h P
  have hF0 : ∀ (L : Type u) [Field L] (χ : Γ(S, ι ⁻¹ᵁ V₀) →+* L) (j : Fin r),
      MvPolynomial.eval (fun l => (χ.comp π.hom) (p (MvPolynomial.X l)))
        (MvPolynomial.map ((χ.comp π.hom).comp (g.appLE U V₀ e).hom) (F j)) = 0 := by
    intro L _ χ j
    rw [hcompat, hFker j, map_zero, map_zero]
  have hGenMap : ∀ (L : Type u) [Field L] (φ : Γ(P', U) →+* L) s,
      wcpaLquGen (fun j => MvPolynomial.map φ (F j)) s = MvPolynomial.map φ (wcpaLquGen F s) := by
    intro L _ φ s
    rcases s with j | q
    · rfl
    · simp only [wcpaLquGen, Sum.elim_inr]
      rw [RingHom.map_det]
      congr 1
      ext i j
      simp [MvPolynomial.pderiv_map]

  have hPNT : ∀ (L : Type u) [Field L] [IsAlgClosed L] (χ : Γ(S, ι ⁻¹ᵁ V₀) →+* L),
      wcpaLquPNT (fun j => MvPolynomial.map ((χ.comp π.hom).comp (g.appLE U V₀ e).hom) (F j))
        (fun l => (χ.comp π.hom) (p (MvPolynomial.X l))) := by
    intro L _ _ χ
    exact wcpa_dj_lqu_sigma_pnt C P' g hss hPnoeth U hU V₀ hV₀ e m r p F hpC hpsurj hF L
      (χ.comp π.hom) ((hset _).mp (hpt L χ))
  have hχex : ∀ (J : Ideal Γ(S, ι ⁻¹ᵁ V₀)) [J.IsPrime],
      ∃ χ : Γ(S, ι ⁻¹ᵁ V₀) →+* AlgebraicClosure J.ResidueField, RingHom.ker χ = J := by
    intro J _
    refine ⟨(algebraMap J.ResidueField (AlgebraicClosure J.ResidueField)).comp
      (algebraMap _ J.ResidueField), ?_⟩
    rw [← RingHom.comap_ker, (RingHom.injective_iff_ker_eq_bot _).mp
      (algebraMap J.ResidueField (AlgebraicClosure J.ResidueField)).injective,
      ← RingHom.ker_eq_comap_bot, Ideal.ker_algebraMap_residueField]

  have hminor : ∀ s, π.hom (p (wcpaLquGen F s)) = 0 := by
    intro s
    haveI : _root_.IsReduced Γ(S, ι ⁻¹ᵁ V₀) := IsReduced.component_reduced _
    apply IsReduced.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    haveI := hJ
    obtain ⟨χ, hχ⟩ := hχex J
    rw [← hχ, RingHom.mem_ker]
    have h1 := wcpa_dj_lqu_pnt_minor_vanish _ m r _ _ (hF0 _ χ) (hPNT _ χ) s
    rw [hGenMap, hcompat] at h1
    exact h1

  obtain ⟨χ, hχ⟩ := hχex (hV.primeIdealOf ⟨y, hy⟩).asIdeal
  obtain ⟨σ, hσ⟩ := wcpa_dj_lqu_pnt_span _ m r _ _ (hF0 _ χ) (hPNT _ χ)
  obtain ⟨M, hMdef⟩ : ∃ M : Matrix (Fin m) (Fin m) Γ(S, ι ⁻¹ᵁ V₀),
      M = Matrix.of fun i l => π.hom (p (MvPolynomial.pderiv l (wcpaLquGen F (σ i)))) := ⟨_, rfl⟩
  have hχM : χ M.det = (Matrix.of fun i l => MvPolynomial.eval
      (fun l => (χ.comp π.hom) (p (MvPolynomial.X l)))
      (MvPolynomial.pderiv l (wcpaLquGen (fun j => MvPolynomial.map
        ((χ.comp π.hom).comp (g.appLE U V₀ e).hom) (F j)) (σ i)))).det := by
    rw [RingHom.map_det]
    congr 1
    ext i l
    show χ (M i l) = _
    rw [hMdef]
    simp only [Matrix.of_apply]
    rw [hGenMap, MvPolynomial.pderiv_map, hcompat]
  refine ⟨U, hU, ι ⁻¹ᵁ V₀, hV, hy, e', M.det, ?_, ?_⟩
  · intro hmem
    rw [← hχ] at hmem
    exact hσ (hχM ▸ RingHom.mem_ker.mp hmem)
  · letI := ((ι ≫ g).appLE U (ι ⁻¹ᵁ V₀) e').hom.toAlgebra
    intro ω
    have hψ : algebraMap Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀) = π.hom.comp (g.appLE U V₀ e).hom := by
      show ((ι ≫ g).appLE U (ι ⁻¹ᵁ V₀) e').hom = _
      rw [hcomp]
      rfl
    obtain ⟨p', hp'def⟩ : ∃ p' : MvPolynomial (Fin m) Γ(P', U) →ₐ[Γ(P', U)] Γ(S, ι ⁻¹ᵁ V₀),
        p' = MvPolynomial.aeval (fun l => π.hom (p (MvPolynomial.X l))) := ⟨_, rfl⟩
    have hp' : ∀ P, p' P = π.hom (p P) := by
      intro P
      have h : (p' : MvPolynomial (Fin m) Γ(P', U) →+* Γ(S, ι ⁻¹ᵁ V₀)) = π.hom.comp p := by
        apply MvPolynomial.ringHom_ext
        · intro a
          have h1 : p' (MvPolynomial.C a) = algebraMap Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀) a := by
            rw [hp'def]; exact MvPolynomial.aeval_C _ a
          have h2 : p (MvPolynomial.C a) = (g.appLE U V₀ e).hom a := RingHom.congr_fun hpC a
          show p' (MvPolynomial.C a) = π.hom (p (MvPolynomial.C a))
          rw [h1, h2, hψ]
          rfl
        · intro l
          show p' (MvPolynomial.X l) = π.hom (p (MvPolynomial.X l))
          rw [hp'def]
          exact MvPolynomial.aeval_X _ l
      exact RingHom.congr_fun h P
    have hp'surj : Function.Surjective p' := by
      intro z
      obtain ⟨b, rfl⟩ := hπsurj z
      obtain ⟨P, rfl⟩ := hpsurj b
      exact ⟨P, hp' P⟩
    obtain ⟨hD, -⟩ := wc_pfc_ssp_kaehler_presentation Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀) m p' hp'surj
    have hrel : ∀ i, ∑ l, M i l • KaehlerDifferential.D Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀)
        (p' (MvPolynomial.X l)) = 0 := by
      intro i
      have h := hD (wcpaLquGen F (σ i))
      rw [hp' (wcpaLquGen F (σ i)), hminor (σ i), map_zero] at h
      rw [h]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [hp' (MvPolynomial.pderiv l (wcpaLquGen F (σ i))), hMdef, Matrix.of_apply]
    have hkill : ∀ l, M.det • KaehlerDifferential.D Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀)
        (p' (MvPolynomial.X l)) = 0 := by
      intro l
      have key : ∑ i, M.adjugate l i • ∑ l', M i l' • KaehlerDifferential.D Γ(P', U)
          Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l')) =
          M.det • KaehlerDifferential.D Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l)) := by
        calc ∑ i, M.adjugate l i • ∑ l', M i l' • KaehlerDifferential.D Γ(P', U)
              Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l'))
            = ∑ l', (∑ i, M.adjugate l i * M i l') • KaehlerDifferential.D Γ(P', U)
              Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l')) := by
              simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
              exact Finset.sum_comm
          _ = ∑ l', (M.adjugate * M) l l' • KaehlerDifferential.D Γ(P', U)
              Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l')) := by
              simp only [Matrix.mul_apply]
          _ = ∑ l', (if l = l' then M.det else 0) • KaehlerDifferential.D Γ(P', U)
              Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l')) := by
              rw [Matrix.adjugate_mul]
              refine Finset.sum_congr rfl (fun l' _ => ?_)
              rw [Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
              split_ifs <;> simp
          _ = M.det • KaehlerDifferential.D Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀) (p' (MvPolynomial.X l)) := by
              simp only [ite_smul, zero_smul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
      rw [← key]
      simp only [hrel, smul_zero, Finset.sum_const_zero]
    have hDz : ∀ z, M.det • KaehlerDifferential.D Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀) z = 0 := by
      intro z
      obtain ⟨P, rfl⟩ := hp'surj z
      rw [hD P, Finset.smul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      rw [smul_comm, hkill j, smul_zero]
    have hω : ω ∈ Submodule.span Γ(S, ι ⁻¹ᵁ V₀)
        (Set.range (KaehlerDifferential.D Γ(P', U) Γ(S, ι ⁻¹ᵁ V₀))) := by
      rw [KaehlerDifferential.span_range_derivation]
      trivial
    induction hω using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨z, rfl⟩ := hx
      exact hDz z
    | zero => exact smul_zero _
    | add x y _ _ hx hy => rw [smul_add, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_comm, hx, smul_zero]

theorem wcpa_dj_lq_rational_node : ∀ (k : Type u) [Field k] [Finite k] (C P' : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P'), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → wcpaDjSemistable g → ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P') (τ : Spec (.of K) ⟶ Limits.pullback g s), τ ≫ Limits.pullback.snd g s = 𝟙 _ → (¬ ∃ W : C.Opens, Limits.pullback.fst g s (τ (IsLocalRing.closedPoint K)) ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → wcpaLqRatNode K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))) :=
by
  intro k _ _ C P' sP' g hgP hP' hss K _ s τ hτ hNS
  classical

  have s11 : ∀ (L : Type u) [Field L] (a b c α β γ δ : L), (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0) →
      α * δ - β * γ ≠ 0 → a * α ^ 2 + b * α * β + c * β ^ 2 = 0 →
      a * γ ^ 2 + b * γ * δ + c * δ ^ 2 = 0 → b ^ 2 - 4 * a * c ≠ 0 := by
    intro L _ a b c α β γ δ hne hD h1 h2 hd
    have hb2 : (2 * a * α * γ + b * (α * δ + β * γ) + 2 * c * β * δ) ^ 2 = 0 := by
      linear_combination (4 * (a * γ ^ 2 + b * γ * δ + c * δ ^ 2)) * h1 +
        (α * δ - β * γ) ^ 2 * hd
    have hb : 2 * a * α * γ + b * (α * δ + β * γ) + 2 * c * β * δ = 0 := pow_eq_zero_iff
      (two_ne_zero) |>.mp hb2
    have hD2 : (α * δ - β * γ) ^ 2 ≠ 0 := pow_ne_zero 2 hD
    have ha : (α * δ - β * γ) ^ 2 * a = 0 := by
      linear_combination δ ^ 2 * h1 - β * δ * hb + β ^ 2 * h2
    have hc : (α * δ - β * γ) ^ 2 * c = 0 := by
      linear_combination γ ^ 2 * h1 - α * γ * hb + α ^ 2 * h2
    have hbb : (α * δ - β * γ) ^ 2 * b = 0 := by
      linear_combination (-2 * γ * δ) * h1 + (α * δ + β * γ) * hb - 2 * α * β * h2
    have ha0 := (mul_eq_zero.mp ha).resolve_left hD2
    have hb0 := (mul_eq_zero.mp hbb).resolve_left hD2
    have hc0 := (mul_eq_zero.mp hc).resolve_left hD2
    rcases hne with h | h | h
    · exact h ha0
    · exact h hb0
    · exact h hc0

  have main : ∀ (X : Scheme.{u}) (a : X ⟶ Spec (.of K)) (σ : Spec (.of K) ⟶ X),
      σ ≫ a = 𝟙 _ → wcpaDjSemistable a →
      (¬ ∃ W : X.Opens, σ (IsLocalRing.closedPoint K) ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ a)) →
      wcpaLqRatNode K (X.presheaf.stalk (σ (IsLocalRing.closedPoint K)))
        (wcpaLqPhi K X a (σ (IsLocalRing.closedPoint K))) := by
    intro X a σ hσ hssa hns
    haveI hafl : Flat a := hssa.1
    haveI hapr : IsProper a := hssa.2.1
    haveI : LocallyOfFinitePresentation a := inferInstance
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian a
    let L := AlgebraicClosure K
    let jL : Spec (.of L) ⟶ Spec (.of K) := Spec.map (CommRingCat.ofHom (algebraMap K L))
    have hlift : (jL ≫ σ) ≫ a = 𝟙 _ ≫ jL := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    let σ' : Spec (.of L) ⟶ Limits.pullback a jL := Limits.pullback.lift (jL ≫ σ) (𝟙 _) hlift
    have hσ's : σ' ≫ Limits.pullback.snd a jL = 𝟙 _ := Limits.pullback.lift_snd _ _ _
    have hσ'f : σ' ≫ Limits.pullback.fst a jL = jL ≫ σ := Limits.pullback.lift_fst _ _ _
    haveI : LocallyOfFiniteType (Limits.pullback.snd a jL) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback a jL)
        (inferInstance : LocallyOfFiniteType a)
    haveI : IsLocallyNoetherian (Limits.pullback a jL) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd a jL)

    have hpt : Limits.pullback.fst a jL (σ' (IsLocalRing.closedPoint L)) =
        σ (IsLocalRing.closedPoint K) := by
      have key : ∀ x : ↥(Spec (.of L)), Limits.pullback.fst a jL (σ' x) = σ (jL x) := by
        intro x
        rw [← Scheme.Hom.comp_apply, hσ'f, Scheme.Hom.comp_apply]
      refine (key _).trans ?_
      have hx : jL (IsLocalRing.closedPoint L) = IsLocalRing.closedPoint K :=
        Subsingleton.elim (α := PrimeSpectrum K) _ _
      first
        | exact congrArg (fun y : ↥(Spec (.of K)) => σ y) hx
        | rw [hx]

    have hns' : ¬ ∃ W : (Limits.pullback a jL).Opens, σ' (IsLocalRing.closedPoint L) ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd a jL) := by
      intro hW
      obtain ⟨W', hW', hsm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of K)) X a L jL
        (σ' (IsLocalRing.closedPoint L)) hafl inferInstance hW
      rw [hpt] at hW'
      exact hns ⟨W', hW', hsm⟩

    obtain ⟨e, he⟩ := (hssa.2.2 L jL (σ' (IsLocalRing.closedPoint L))).resolve_left hns'

    obtain ⟨h, hcomp, hflat, hmax⟩ :=
      wcpa_dj_lqr_basechange_stalk K L X a σ hσ σ' hσ's hσ'f
    have hres := wcpa_dj_lqr_section_residue K X a σ hσ
    have hres' := wcpa_dj_lqr_section_residue L (Limits.pullback a jL)
      (Limits.pullback.snd a jL) σ' hσ's
    obtain ⟨hdens, hstrict⟩ := wcpa_dj_lqr_completion_bridge L _ e
    have hψφ : (e.toRingHom.comp (algebraMap _ (AdicCompletion (IsLocalRing.maximalIdeal
        ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))))
        ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L)))))).comp
        ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a jL).appTop ≫
          (Limits.pullback a jL).presheaf.germ ⊤ (σ' (IsLocalRing.closedPoint L)) trivial).hom =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
      rw [RingHom.comp_assoc]; exact he
    refine ⟨?_, ?_⟩
    ·
      unfold wcpaLqHilb
      intro n hn
      have e1 := wcpa_dj_lqr_flat_hilb_eq K L (algebraMap K L) _ _ _ _ h hcomp hflat hmax hres
        hres' n
      have e2 := wcpa_dj_lqr_quot_hilb L _ _ _ hψφ hdens hstrict n
      have e3 := wcpa_dj_lqr_node_trunc_dim L n hn
      rw [← e1]
      exact e2.trans e3
    ·
      intro u v hb a₀ b₀ c₀ hne hrel
      obtain ⟨hu, hv, hspan, _⟩ := hb
      have hφ : ∀ c : K, h (wcpaLqPhi K X a (σ (IsLocalRing.closedPoint K)) c) =
          ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a jL).appTop ≫
            (Limits.pullback a jL).presheaf.germ ⊤ (σ' (IsLocalRing.closedPoint L)) trivial).hom
            (algebraMap K L c) := fun c => RingHom.congr_fun hcomp c

      have hu' : h u ∈ IsLocalRing.maximalIdeal
          ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))) := by
        rw [← hmax]; exact Ideal.mem_map_of_mem h hu
      have hv' : h v ∈ IsLocalRing.maximalIdeal
          ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))) := by
        rw [← hmax]; exact Ideal.mem_map_of_mem h hv
      have hspan' : ∀ y ∈ IsLocalRing.maximalIdeal
          ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))),
          ∃ c₁ c₂ : L, y - (((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a jL).appTop ≫
            (Limits.pullback a jL).presheaf.germ ⊤ (σ' (IsLocalRing.closedPoint L)) trivial).hom c₁ *
              h u +
            ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a jL).appTop ≫
            (Limits.pullback a jL).presheaf.germ ⊤ (σ' (IsLocalRing.closedPoint L)) trivial).hom c₂ *
              h v) ∈ IsLocalRing.maximalIdeal
          ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))) ^ 2 := by
        intro y hy
        rw [← hmax] at hy
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
        · rintro x ⟨m, hm, rfl⟩
          obtain ⟨c₁, c₂, hc⟩ := hspan m hm
          refine ⟨algebraMap K L c₁, algebraMap K L c₂, ?_⟩
          have hh := Ideal.mem_map_of_mem h hc
          rw [Ideal.map_pow, hmax, map_sub, map_add, map_mul, map_mul, hφ, hφ] at hh
          exact hh
        · exact ⟨0, 0, by simp⟩
        · rintro x y _ _ ⟨c₁, c₂, hc⟩ ⟨d₁, d₂, hd⟩
          refine ⟨c₁ + d₁, c₂ + d₂, ?_⟩
          have hh := Ideal.add_mem _ hc hd
          convert hh using 1
          simp only [map_add]
          ring
        · rintro r x hx ⟨c₁, c₂, hc⟩
          obtain ⟨e₀, he₀⟩ := hres' r
          refine ⟨e₀ * c₁, e₀ * c₂, ?_⟩
          have hx' : x ∈ IsLocalRing.maximalIdeal
              ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))) := by
            rw [← hmax]; exact hx
          have h1 := Ideal.mul_mem_left (IsLocalRing.maximalIdeal
              ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))) ^ 2)
            (((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a jL).appTop ≫
            (Limits.pullback a jL).presheaf.germ ⊤ (σ' (IsLocalRing.closedPoint L)) trivial).hom e₀)
            hc
          have h2 : (r - ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a jL).appTop ≫
              (Limits.pullback a jL).presheaf.germ ⊤ (σ' (IsLocalRing.closedPoint L))
                trivial).hom e₀) * x ∈ IsLocalRing.maximalIdeal
              ((Limits.pullback a jL).presheaf.stalk (σ' (IsLocalRing.closedPoint L))) ^ 2 := by
            rw [pow_two]; exact Ideal.mul_mem_mul he₀ hx'
          have hh := Ideal.add_mem _ h1 h2
          convert hh using 1
          simp only [smul_eq_mul, map_mul]
          ring
      have hrel' := Ideal.mem_map_of_mem h hrel
      rw [Ideal.map_pow, hmax] at hrel'
      simp only [map_add, map_mul, map_pow, hφ] at hrel'
      obtain ⟨α, β, γ, δ, hD, h1, h2⟩ := wcpa_dj_lqr_isotropic L _ _ _ hψφ hdens hstrict
        (h u) (h v) hu' hv' hspan' _ _ _ hrel'
      have hne' : algebraMap K L a₀ ≠ 0 ∨ algebraMap K L b₀ ≠ 0 ∨ algebraMap K L c₀ ≠ 0 := by
        rcases hne with h0 | h0 | h0
        · exact Or.inl ((map_ne_zero _).mpr h0)
        · exact Or.inr (Or.inl ((map_ne_zero _).mpr h0))
        · exact Or.inr (Or.inr ((map_ne_zero _).mpr h0))
      have hd := s11 L _ _ _ α β γ δ hne' hD h1 h2
      intro h0
      apply hd
      have := congrArg (algebraMap K L) h0
      simpa only [map_sub, map_mul, map_pow, map_ofNat, map_zero] using this
  haveI : IsProper sP' := wcpa_dj_proj_proper k sP' hP'
  haveI : IsLocallyNoetherian P' := LocallyOfFiniteType.isLocallyNoetherian sP'
  haveI : Flat g := hss.1
  haveI : IsProper g := hss.2.1
  have hssa := wcpa_dj_mm_semistable_basechange P' (Spec (.of K)) C s g hss
  refine main (Limits.pullback g s) (Limits.pullback.snd g s) τ hτ hssa ?_
  rintro ⟨W, hW, hsm⟩
  exact hNS (wcpa_dj_bsc_smooth_descend P' C g K s _ hss.1 inferInstance ⟨W, hW, hsm⟩)

theorem wcpa_dj_lq_conormal_frame : ∀ (R A : Type u) [CommRing R] [CommRing A] [_root_.IsReduced R]
    [IsNoetherianRing R] (π : R →+* A) (μ : A →+* R), μ.comp π = RingHom.id R → π.FiniteType →
    (letI := π.toAlgebra
      ∀ (𝔭 : Ideal R) [𝔭.IsPrime] (n : ℕ), 1 ≤ n → n ≤ 3 →
        Module.finrank 𝔭.ResidueField
          (TensorProduct R 𝔭.ResidueField (A ⧸ RingHom.ker μ ^ n)) = 2 * n - 1) →
    ∀ (𝔭 : Ideal R) [𝔭.IsPrime], ∃ (f : R) (u v : A) (a b c : R), f ∉ 𝔭 ∧ μ u = 0 ∧ μ v = 0 ∧
      (∀ x, μ x = 0 → ∃ m : ℕ, π (f ^ m) * x ∈ Ideal.span {u, v} ⊔ RingHom.ker μ ^ 2) ∧
      (∃ m : ℕ, π (f ^ m) * (π a * u ^ 2 + π b * (u * v) + π c * v ^ 2) ∈ RingHom.ker μ ^ 3) ∧
      (∃ m : ℕ, f ^ m ∈ Ideal.span {a, b, c}) :=
by
  intro R A _ _ _ _ π μ hμπ hft hH 𝔭 _
  open TensorProduct in
  focus
    letI := π.toAlgebra
    have hμπ' : ∀ r, μ (π r) = r := fun r => RingHom.congr_fun hμπ r
    have hSMUL : ∀ (J : Ideal A) (r : R) (a : A),
        r • Ideal.Quotient.mk J a = Ideal.Quotient.mk J (π r * a) := by
      intro J r a
      rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, RingHom.algebraMap_toAlgebra, ← map_mul]
    have s1 : ∀ n : ℕ, Module.Finite R (A ⧸ RingHom.ker μ ^ n) := by
      intro n
      haveI : Algebra.FiniteType R A := hft
      have hft' : Algebra.FiniteType R (A ⧸ RingHom.ker μ ^ n) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R (RingHom.ker μ ^ n))
          (Ideal.Quotient.mkₐ_surjective R _)
      have hint : Algebra.IsIntegral R (A ⧸ RingHom.ker μ ^ n) := by
        constructor
        intro y
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hdec : Ideal.Quotient.mk (RingHom.ker μ ^ n) x =
            algebraMap R _ (μ x) + Ideal.Quotient.mk _ (x - π (μ x)) := by
          rw [← Ideal.Quotient.mk_algebraMap, RingHom.algebraMap_toAlgebra, ← map_add,
            add_sub_cancel]
        have hi : x - π (μ x) ∈ RingHom.ker μ := by
          rw [RingHom.mem_ker, map_sub, ← RingHom.comp_apply, hμπ, RingHom.id_apply, sub_self]
        rw [hdec]
        refine _root_.IsIntegral.add isIntegral_algebraMap ?_
        refine _root_.IsIntegral.of_pow (Nat.succ_pos n) ?_
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.pow_le_pow_right (Nat.le_succ n) (Ideal.pow_mem_pow hi _))]
        exact isIntegral_zero
      exact Algebra.finite_iff_isIntegral_and_finiteType.mpr ⟨hint, hft'⟩
    have s2 : ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
        (n : ℕ) (s : Fin n → M) (𝔭 : Ideal R) [𝔭.IsPrime],
        Submodule.span 𝔭.ResidueField
          (Set.range (fun i => (1 : 𝔭.ResidueField) ⊗ₜ[R] s i)) = ⊤ →
        ∃ f : R, f ∉ 𝔭 ∧ ∀ m : M, f • m ∈ Submodule.span R (Set.range s) := by
      intro M _ _ _ n s 𝔭 _ h
      set P := Submodule.span R (Set.range s) with hP
      have hΦs : Function.Surjective (P.mkQ.baseChange 𝔭.ResidueField) :=
        LinearMap.baseChange_surjective _ (Submodule.mkQ_surjective P)
      have hΦ0 : ∀ t, P.mkQ.baseChange 𝔭.ResidueField t = 0 := by
        intro t
        have h1 : Submodule.span 𝔭.ResidueField
            (Set.range (fun i => (1 : 𝔭.ResidueField) ⊗ₜ[R] s i)) ≤
            LinearMap.ker (P.mkQ.baseChange 𝔭.ResidueField) := by
          rw [Submodule.span_le]
          rintro _ ⟨i, rfl⟩
          rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.baseChange_tmul, Submodule.mkQ_apply,
            (Submodule.Quotient.mk_eq_zero P).mpr (Submodule.subset_span ⟨i, rfl⟩), tmul_zero]
        exact h1 (h ▸ Submodule.mem_top)
      have hsub : Subsingleton (TensorProduct R 𝔭.ResidueField (M ⧸ P)) := by
        constructor
        intro a b
        obtain ⟨x, rfl⟩ := hΦs a
        obtain ⟨y, rfl⟩ := hΦs b
        rw [hΦ0, hΦ0]
      have hnot : (⟨𝔭, inferInstance⟩ : PrimeSpectrum R) ∉ Module.support R (M ⧸ P) := by
        rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct]
        exact not_nontrivial_iff_subsingleton.mpr hsub
      rw [Module.support_eq_zeroLocus, PrimeSpectrum.mem_zeroLocus, Set.not_subset] at hnot
      obtain ⟨f, hfAnn, hf𝔭⟩ := hnot
      refine ⟨f, hf𝔭, fun m => ?_⟩
      have := Module.mem_annihilator.mp hfAnn (P.mkQ m)
      rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
      exact this
    have s3 : ∀ (M : Type u) [AddCommGroup M] [Module R M] (n : ℕ) (s : Fin n → M)
        (f : R), (∀ m : M, f • m ∈ Submodule.span R (Set.range s)) → ∀ (𝔮 : Ideal R) [𝔮.IsPrime],
        f ∉ 𝔮 →
        Submodule.span 𝔮.ResidueField (Set.range (fun i => (1 : 𝔮.ResidueField) ⊗ₜ[R] s i)) = ⊤ := by
      intro M _ _ n s f hf 𝔮 _ hq
      set S := Submodule.span 𝔮.ResidueField
        (Set.range (fun i => (1 : 𝔮.ResidueField) ⊗ₜ[R] s i)) with hS
      have hφ : algebraMap R 𝔮.ResidueField f ≠ 0 :=
        fun h => hq (Ideal.algebraMap_residueField_eq_zero.mp h)
      have h1 : ∀ m : M, (1 : 𝔮.ResidueField) ⊗ₜ[R] m ∈ S := by
        intro m
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp (hf m)
        have e : algebraMap R 𝔮.ResidueField f • ((1 : 𝔮.ResidueField) ⊗ₜ[R] m) =
            ∑ i, algebraMap R 𝔮.ResidueField (c i) • ((1 : 𝔮.ResidueField) ⊗ₜ[R] s i) := by
          simp only [algebraMap_smul]
          rw [← tmul_smul, ← hc, tmul_sum]
          simp only [tmul_smul]
        have h2 : algebraMap R 𝔮.ResidueField f • ((1 : 𝔮.ResidueField) ⊗ₜ[R] m) ∈ S := by
          rw [e]
          exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
        have h3 := Submodule.smul_mem S (algebraMap R 𝔮.ResidueField f)⁻¹ h2
        rwa [smul_smul, inv_mul_cancel₀ hφ, one_smul] at h3
      rw [Submodule.eq_top_iff']
      intro t
      induction t using TensorProduct.induction_on with
      | zero => exact S.zero_mem
      | tmul k m =>
        have e : k ⊗ₜ[R] m = k • ((1 : 𝔮.ResidueField) ⊗ₜ[R] m) := by
          rw [smul_tmul', smul_eq_mul, mul_one]
        rw [e]
        exact S.smul_mem k (h1 m)
      | add x y hx hy => exact S.add_mem hx hy
    have s4 : ∀ (M : Type u) [AddCommGroup M] [Module R M] (n : ℕ)
        (s : Fin n → M) (f : R), (∀ m : M, f • m ∈ Submodule.span R (Set.range s)) →
        (∀ (𝔮 : Ideal R) [𝔮.IsPrime], f ∉ 𝔮 →
          Module.finrank 𝔮.ResidueField (TensorProduct R 𝔮.ResidueField M) = n) →
        ∀ (r : Fin n → R), ∑ i, r i • s i = 0 → ∀ (i : Fin n), f * r i = 0 := by
      intro M _ _ n s f hf hrk r hr i
      apply _root_.IsReduced.eq_zero
      rw [← mem_nilradical, nilradical_eq_sInf, Submodule.mem_sInf]
      suffices key : ∀ (𝔮 : Ideal R), 𝔮.IsPrime → f * r i ∈ 𝔮 from fun 𝔮 h𝔮 => key 𝔮 h𝔮
      intro 𝔮 h𝔮
      haveI : 𝔮.IsPrime := h𝔮
      by_cases hq : f ∈ 𝔮
      · exact Ideal.mul_mem_right _ _ hq
      · have hspan := s3 M n s f hf 𝔮 hq
        have hli : LinearIndependent 𝔮.ResidueField (fun i => (1 : 𝔮.ResidueField) ⊗ₜ[R] s i) :=
          linearIndependent_of_top_le_span_of_card_eq_finrank hspan.ge
            (by rw [Fintype.card_fin, hrk 𝔮 hq])
        have hsum : ∑ i, algebraMap R 𝔮.ResidueField (r i) •
            ((1 : 𝔮.ResidueField) ⊗ₜ[R] s i) = 0 := by
          simp only [algebraMap_smul]
          simp only [← tmul_smul]
          rw [← tmul_sum, hr, tmul_zero]
        have := Fintype.linearIndependent_iff.mp hli _ hsum i
        exact Ideal.mul_mem_left _ _ (Ideal.algebraMap_residueField_eq_zero.mp this)
    have s7 : ∀ (K V W : Type u) [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W]
        [Module K W] (φ : V →ₗ[K] W) (w : Fin 6 → V), Submodule.span K (Set.range w) = ⊤ →
        Module.finrank K V = 5 → φ (w 3) = 0 → φ (w 4) = 0 → φ (w 5) = 0 →
        LinearIndependent K ![φ (w 0), φ (w 1), φ (w 2)] →
        ∃ j : Fin 6, 3 ≤ j.val ∧
          Submodule.span K (Set.range (fun k : Fin 5 => w (j.succAbove k))) = ⊤ := by
      intro K V W _ _ _ _ _ φ w hw h5 h3 h4 h5' hli
      haveI : FiniteDimensional K V := Module.finite_of_finrank_pos (by omega)
      have hnli : ¬ LinearIndependent K w := by
        intro h
        have := h.fintype_card_le_finrank
        rw [Fintype.card_fin, h5] at this
        omega
      obtain ⟨g, hg, j, hj⟩ := Fintype.not_linearIndependent_iff.mp hnli
      have hφg : g 0 • φ (w 0) + g 1 • φ (w 1) + g 2 • φ (w 2) = 0 := by
        have := congrArg φ hg
        rw [map_sum, map_zero, Fin.sum_univ_six] at this
        simpa [h3, h4, h5'] using this
      have hg012 := Fintype.linearIndependent_iff.mp hli ![g 0, g 1, g 2] (by
        rw [Fin.sum_univ_three]; simpa using hφg)
      have h0 : g 0 = 0 := by simpa using hg012 0
      have h1 : g 1 = 0 := by simpa using hg012 1
      have h2 : g 2 = 0 := by simpa using hg012 2
      have hj3 : 3 ≤ j.val := by
        by_contra hlt
        push_neg at hlt
        have : j = 0 ∨ j = 1 ∨ j = 2 := by
          rcases j with ⟨jv, hjv⟩
          interval_cases jv <;> simp
        rcases this with rfl | rfl | rfl <;> contradiction
      refine ⟨j, hj3, ?_⟩
      set S := Submodule.span K (Set.range (fun k : Fin 5 => w (j.succAbove k))) with hS
      have hwj : w j ∈ S := by
        rw [Fin.sum_univ_succAbove _ j] at hg
        have hsum : ∑ k : Fin 5, g (j.succAbove k) • w (j.succAbove k) ∈ S :=
          Submodule.sum_mem _ (fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩))
        have e : g j • w j = -∑ k : Fin 5, g (j.succAbove k) • w (j.succAbove k) :=
          eq_neg_of_add_eq_zero_left hg
        have h6 : g j • w j ∈ S := by rw [e]; exact S.neg_mem hsum
        have h7 := S.smul_mem (g j)⁻¹ h6
        rwa [inv_smul_smul₀ hj] at h7
      rw [eq_top_iff, ← hw, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      rcases Fin.eq_self_or_eq_succAbove j i with h | ⟨k, rfl⟩
      · rw [h]; exact hwj
      · exact Submodule.subset_span ⟨k, rfl⟩
    have s6 : ∀ (f₀ : R) (u v : A), μ u = 0 → μ v = 0 →
        (∀ x : A, ∃ r₀ r₁ r₂ : R,
          π f₀ * x - (π r₀ + π r₁ * u + π r₂ * v) ∈ RingHom.ker μ ^ 2) → ∀ (x : A),
        ∃ c : Fin 6 → R, π (f₀ ^ 3) * x - (π (c 0) + π (c 1) * u + π (c 2) * v + π (c 3) * u ^ 2 +
          π (c 4) * (u * v) + π (c 5) * v ^ 2) ∈ RingHom.ker μ ^ 3 := by
      intro f₀ u v hu hv hLIN x
      set I := RingHom.ker μ with hI
      have hμπ' : ∀ r, μ (π r) = r := fun r => RingHom.congr_fun hμπ r
      have hI12 : ∀ a b : A, a ∈ I → b ∈ I ^ 2 → a * b ∈ I ^ 3 := fun a b ha hb => by
        rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ']; exact Ideal.mul_mem_mul ha hb
      have hI22 : ∀ a b : A, a ∈ I ^ 2 → b ∈ I ^ 2 → a * b ∈ I ^ 3 := fun a b ha hb => by
        refine Ideal.pow_le_pow_right (by norm_num : 3 ≤ 4) ?_
        rw [show (4 : ℕ) = 2 + 2 from rfl, pow_add]; exact Ideal.mul_mem_mul ha hb
      have huI : u ∈ I := hu
      have hvI : v ∈ I := hv

      have lin : ∀ i ∈ I, ∃ r₁ r₂ : R, ∃ d ∈ I ^ 2, π f₀ * i = π r₁ * u + π r₂ * v + d := by
        intro i hi
        obtain ⟨r₀, r₁, r₂, hd⟩ := hLIN i
        have hdI : π f₀ * i - (π r₀ + π r₁ * u + π r₂ * v) ∈ I := Ideal.pow_le_self two_ne_zero hd
        have h0 := RingHom.mem_ker.mp hdI
        rw [map_sub, map_add, map_add, map_mul, map_mul, map_mul, hμπ', hμπ', hμπ', hμπ',
          RingHom.mem_ker.mp hi, hu, hv] at h0
        have hr0 : r₀ = 0 := by linear_combination -h0
        refine ⟨r₁, r₂, _, hd, ?_⟩
        rw [hr0, map_zero]; ring

      have prod : ∀ i ∈ I, ∀ i' ∈ I, ∃ c₃ c₄ c₅ : R, π (f₀ ^ 2) * (i * i') -
          (π c₃ * u ^ 2 + π c₄ * (u * v) + π c₅ * v ^ 2) ∈ I ^ 3 := by
        intro i hi i' hi'
        obtain ⟨r₁, r₂, d, hd, e1⟩ := lin i hi
        obtain ⟨r₁', r₂', d', hd', e2⟩ := lin i' hi'
        have hP : π r₁ * u + π r₂ * v ∈ I :=
          I.add_mem (I.mul_mem_left _ huI) (I.mul_mem_left _ hvI)
        have hP' : π r₁' * u + π r₂' * v ∈ I :=
          I.add_mem (I.mul_mem_left _ huI) (I.mul_mem_left _ hvI)
        refine ⟨r₁ * r₁', r₁ * r₂' + r₂ * r₁', r₂ * r₂', ?_⟩
        have key : π (f₀ ^ 2) * (i * i') - (π (r₁ * r₁') * u ^ 2 + π (r₁ * r₂' + r₂ * r₁') * (u * v) +
            π (r₂ * r₂') * v ^ 2) = (π r₁ * u + π r₂ * v) * d' + (π r₁' * u + π r₂' * v) * d +
            d * d' := by
          simp only [map_pow, map_mul, map_add]
          linear_combination (π f₀ * i') * e1 + (π r₁ * u + π r₂ * v + d) * e2
        rw [key]
        exact (I ^ 3).add_mem ((I ^ 3).add_mem (hI12 _ _ hP hd') (hI12 _ _ hP' hd)) (hI22 _ _ hd hd')

      have sq : ∀ y ∈ I ^ 2, ∃ c₃ c₄ c₅ : R, π (f₀ ^ 2) * y -
          (π c₃ * u ^ 2 + π c₄ * (u * v) + π c₅ * v ^ 2) ∈ I ^ 3 := by
        intro y hy
        rw [pow_two] at hy
        refine Submodule.mul_induction_on hy (fun i hi i' hi' => prod i hi i' hi') ?_
        rintro a b ⟨a₃, a₄, a₅, ha⟩ ⟨b₃, b₄, b₅, hb⟩
        refine ⟨a₃ + b₃, a₄ + b₄, a₅ + b₅, ?_⟩
        have e : π (f₀ ^ 2) * (a + b) - (π (a₃ + b₃) * u ^ 2 + π (a₄ + b₄) * (u * v) +
            π (a₅ + b₅) * v ^ 2) = (π (f₀ ^ 2) * a - (π a₃ * u ^ 2 + π a₄ * (u * v) + π a₅ * v ^ 2)) +
            (π (f₀ ^ 2) * b - (π b₃ * u ^ 2 + π b₄ * (u * v) + π b₅ * v ^ 2)) := by
          simp only [map_add]; ring
        rw [e]; exact (I ^ 3).add_mem ha hb

      have hi : x - π (μ x) ∈ I := by
        rw [RingHom.mem_ker, map_sub, hμπ', sub_self]
      obtain ⟨r₁, r₂, d, hd, e⟩ := lin _ hi
      obtain ⟨c₃, c₄, c₅, hc⟩ := sq d hd
      refine ⟨![f₀ ^ 3 * μ x, f₀ ^ 2 * r₁, f₀ ^ 2 * r₂, c₃, c₄, c₅], ?_⟩
      have key : π (f₀ ^ 3) * x - (π (f₀ ^ 3 * μ x) + π (f₀ ^ 2 * r₁) * u + π (f₀ ^ 2 * r₂) * v +
          π c₃ * u ^ 2 + π c₄ * (u * v) + π c₅ * v ^ 2) =
          π (f₀ ^ 2) * d - (π c₃ * u ^ 2 + π c₄ * (u * v) + π c₅ * v ^ 2) := by
        simp only [map_pow, map_mul]
        linear_combination (π f₀) ^ 2 * e
      simpa only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two] using
        (show _ ∈ I ^ 3 from key ▸ hc)
    have d₁ : Module.finrank 𝔭.ResidueField
        (TensorProduct R 𝔭.ResidueField (A ⧸ RingHom.ker μ ^ 1)) = 1 :=
      (hH 𝔭 1 le_rfl (by norm_num)).trans (by norm_num)
    have d₂ : Module.finrank 𝔭.ResidueField
        (TensorProduct R 𝔭.ResidueField (A ⧸ RingHom.ker μ ^ 2)) = 3 :=
      (hH 𝔭 2 (by norm_num) (by norm_num)).trans (by norm_num)
    have d₃ : Module.finrank 𝔭.ResidueField
        (TensorProduct R 𝔭.ResidueField (A ⧸ RingHom.ker μ ^ 3)) = 5 :=
      (hH 𝔭 3 (by norm_num) le_rfl).trans (by norm_num)
    have h12 : RingHom.ker μ ^ 2 ≤ RingHom.ker μ ^ 1 := Ideal.pow_le_pow_right (by norm_num)
    have h23 : RingHom.ker μ ^ 3 ≤ RingHom.ker μ ^ 2 := Ideal.pow_le_pow_right (by norm_num)



    have s5 : ∃ u v : A, μ u = 0 ∧ μ v = 0 ∧ Submodule.span 𝔭.ResidueField (Set.range (fun i =>
        (1 : 𝔭.ResidueField) ⊗ₜ[R] (Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] i)))) = ⊤ := by
      haveI : FiniteDimensional 𝔭.ResidueField
          (TensorProduct R 𝔭.ResidueField (A ⧸ RingHom.ker μ ^ 2)) :=
        Module.finite_of_finrank_pos (by rw [d₂]; norm_num)
      set Φ := ((Ideal.Quotient.factorₐ R h12).toLinearMap).baseChange 𝔭.ResidueField with hΦ
      have hΦs : Function.Surjective Φ :=
        LinearMap.baseChange_surjective _ (fun y => by
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
          exact ⟨Ideal.Quotient.mk _ x, rfl⟩)
      have hker : Module.finrank 𝔭.ResidueField (LinearMap.ker Φ) = 2 := by
        have e := LinearMap.finrank_range_add_finrank_ker Φ
        rw [LinearMap.range_eq_top.mpr hΦs, finrank_top, d₁, d₂] at e
        omega
      set L := Submodule.span 𝔭.ResidueField {t | ∃ i : A, μ i = 0 ∧
        (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) i = t} with hL
      have hLker : L ≤ LinearMap.ker Φ := by
        rw [hL, Submodule.span_le]
        rintro _ ⟨i, hi, rfl⟩
        rw [SetLike.mem_coe, LinearMap.mem_ker, hΦ, LinearMap.baseChange_tmul]
        have : (Ideal.Quotient.factorₐ R h12).toLinearMap
            (Ideal.Quotient.mk (RingHom.ker μ ^ 2) i) = 0 := by
          show Ideal.Quotient.mk (RingHom.ker μ ^ 1) i = 0
          rw [Ideal.Quotient.eq_zero_iff_mem, pow_one]; exact hi
        rw [this, tmul_zero]
      have hLdim : Module.finrank 𝔭.ResidueField L ≤ 2 :=
        (Submodule.finrank_mono hLker).trans hker.le
      have hgen : ∀ i : A, μ i = 0 →
          (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) i ∈ L :=
        fun i hi => Submodule.subset_span ⟨i, hi, rfl⟩
      have hpair : ∃ u v : A, μ u = 0 ∧ μ v = 0 ∧ L ≤ Submodule.span 𝔭.ResidueField
          (Set.range ![(1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) u,
            (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) v]) := by
        by_cases hA : ∀ i : A, μ i = 0 →
            (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) i = 0
        · refine ⟨0, 0, map_zero μ, map_zero μ, ?_⟩
          rw [hL, Submodule.span_le]
          rintro _ ⟨i, hi, rfl⟩
          rw [hA i hi]; exact Submodule.zero_mem _
        push_neg at hA
        obtain ⟨u, hu, hu0⟩ := hA
        set g₁ := (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) u with hg₁
        by_cases hB : ∀ i : A, μ i = 0 →
            (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) i ∈
              Submodule.span 𝔭.ResidueField {g₁}
        · refine ⟨u, u, hu, hu, ?_⟩
          rw [hL, Submodule.span_le]
          rintro _ ⟨i, hi, rfl⟩
          refine (Submodule.span_mono ?_) (hB i hi)
          rintro _ rfl
          exact ⟨0, rfl⟩
        push_neg at hB
        obtain ⟨v, hv, hv1⟩ := hB
        set g₂ := (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) v with hg₂
        refine ⟨u, v, hu, hv, ?_⟩
        have hli : LinearIndependent 𝔭.ResidueField ![g₁, g₂] := by
          rw [LinearIndependent.pair_iff]
          intro s t hst
          by_cases ht : t = 0
          · rw [ht, zero_smul, add_zero] at hst
            exact ⟨(smul_eq_zero.mp hst).resolve_right hu0, ht⟩
          · exfalso
            apply hv1
            rw [Submodule.mem_span_singleton]
            refine ⟨-(t⁻¹ * s), ?_⟩
            have e : t • g₂ = -(s • g₁) := eq_neg_of_add_eq_zero_right hst
            have e2 : g₂ = t⁻¹ • (t • g₂) := by rw [smul_smul, inv_mul_cancel₀ ht, one_smul]
            rw [e2, e, smul_neg, smul_smul]
            first | exact neg_smul _ _ | simp
        have hS2le : Submodule.span 𝔭.ResidueField (Set.range ![g₁, g₂]) ≤ L := by
          rw [Submodule.span_le]
          rintro _ ⟨i, rfl⟩
          fin_cases i
          · exact hgen u hu
          · exact hgen v hv
        have hS2dim : Module.finrank 𝔭.ResidueField
            (Submodule.span 𝔭.ResidueField (Set.range ![g₁, g₂])) = 2 := by
          rw [finrank_span_eq_card hli, Fintype.card_fin]
        exact (Submodule.eq_of_le_of_finrank_le hS2le (by rw [hS2dim]; exact hLdim)).ge
      obtain ⟨u, v, hu, hv, hLle⟩ := hpair
      refine ⟨u, v, hu, hv, ?_⟩
      set T := Submodule.span 𝔭.ResidueField (Set.range (fun i =>
        (1 : 𝔭.ResidueField) ⊗ₜ[R] (Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] i))))
        with hT
      have hS2T : Submodule.span 𝔭.ResidueField
          (Set.range ![(1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) u,
            (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) v]) ≤ T := by
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        fin_cases i
        · exact Submodule.subset_span ⟨1, rfl⟩
        · exact Submodule.subset_span ⟨2, rfl⟩
      have h1T : ∀ x : A,
          (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) x ∈ T := by
        intro x
        have hi : μ (x - π (μ x)) = 0 := by rw [map_sub, hμπ', sub_self]
        have e : (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) x =
            algebraMap R 𝔭.ResidueField (μ x) •
              ((1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] 0)) +
            (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) (x - π (μ x)) := by
          rw [algebraMap_smul, ← tmul_smul, hSMUL, ← tmul_add, ← map_add]
          congr 2
          simp
        rw [e]
        exact T.add_mem (T.smul_mem _ (Submodule.subset_span ⟨0, rfl⟩))
          (hS2T (hLle (hgen _ hi)))
      rw [Submodule.eq_top_iff']
      intro t
      induction t using TensorProduct.induction_on with
      | zero => exact T.zero_mem
      | tmul k m =>
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective m
        have e : k ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) x =
            k • ((1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) x) := by
          rw [smul_tmul', smul_eq_mul, mul_one]
        rw [e]
        exact T.smul_mem k (h1T x)
      | add x y hx hy => exact T.add_mem hx hy
    obtain ⟨u, v, hu, hv, hspan2⟩ := s5
    haveI hfin2 : Module.Finite R (A ⧸ RingHom.ker μ ^ 2) := s1 2
    haveI hfin3 : Module.Finite R (A ⧸ RingHom.ker μ ^ 3) := s1 3
    obtain ⟨f₀, hf₀, hspr⟩ := s2 (A ⧸ RingHom.ker μ ^ 2) 3
      (fun i => Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] i)) 𝔭 hspan2

    have hLIN : ∀ x : A, ∃ r₀ r₁ r₂ : R,
        π f₀ * x - (π r₀ + π r₁ * u + π r₂ * v) ∈ RingHom.ker μ ^ 2 := by
      intro x
      obtain ⟨c, hc⟩ :=
        (Submodule.mem_span_range_iff_exists_fun R).mp (hspr (Ideal.Quotient.mk _ x))
      refine ⟨c 0, c 1, c 2, ?_⟩
      rw [← Ideal.Quotient.eq, ← hSMUL, ← hc, Fin.sum_univ_three]
      show c 0 • Ideal.Quotient.mk (RingHom.ker μ ^ 2) 1 + c 1 • Ideal.Quotient.mk _ u +
        c 2 • Ideal.Quotient.mk _ v = _
      simp only [hSMUL, map_add, mul_one]

    obtain ⟨w, hw⟩ : ∃ w : Fin 6 → A ⧸ RingHom.ker μ ^ 3,
        w = fun i => Ideal.Quotient.mk (RingHom.ker μ ^ 3) (![1, u, v, u ^ 2, u * v, v ^ 2] i) :=
      ⟨_, rfl⟩
    have hw0 : w 0 = Ideal.Quotient.mk (RingHom.ker μ ^ 3) 1 := by rw [hw]; rfl
    have hw1 : w 1 = Ideal.Quotient.mk (RingHom.ker μ ^ 3) u := by rw [hw]; rfl
    have hw2 : w 2 = Ideal.Quotient.mk (RingHom.ker μ ^ 3) v := by rw [hw]; rfl
    have hw3 : w 3 = Ideal.Quotient.mk (RingHom.ker μ ^ 3) (u ^ 2) := by rw [hw]; rfl
    have hw4 : w 4 = Ideal.Quotient.mk (RingHom.ker μ ^ 3) (u * v) := by rw [hw]; rfl
    have hw5 : w 5 = Ideal.Quotient.mk (RingHom.ker μ ^ 3) (v ^ 2) := by rw [hw]; rfl
    have hspr3 : ∀ m : A ⧸ RingHom.ker μ ^ 3, f₀ ^ 3 • m ∈ Submodule.span R (Set.range w) := by
      intro m
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective m
      obtain ⟨c, hc⟩ := s6 f₀ u v hu hv hLIN x
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨c, ?_⟩
      rw [hSMUL, Ideal.Quotient.eq.mpr hc, Fin.sum_univ_six, hw0, hw1, hw2, hw3, hw4, hw5]
      simp only [hSMUL, map_add, mul_one]
    have hf₀3 : f₀ ^ 3 ∉ 𝔭 := fun h => hf₀ (Ideal.IsPrime.mem_of_pow_mem inferInstance 3 h)
    have hspan6 := s3 (A ⧸ RingHom.ker μ ^ 3) 6 w (f₀ ^ 3) hspr3 𝔭 hf₀3

    set φ := ((Ideal.Quotient.factorₐ R h23).toLinearMap).baseChange 𝔭.ResidueField with hφ
    have hq2 : ∀ a b : A, μ a = 0 → μ b = 0 → a * b ∈ RingHom.ker μ ^ 2 := fun a b ha hb => by
      rw [pow_two]; exact Ideal.mul_mem_mul ha hb
    have hφw0 : φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 0) =
        (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) 1 := by
      rw [hw0, hφ, LinearMap.baseChange_tmul]; rfl
    have hφw1 : φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 1) =
        (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) u := by
      rw [hw1, hφ, LinearMap.baseChange_tmul]; rfl
    have hφw2 : φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 2) =
        (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) v := by
      rw [hw2, hφ, LinearMap.baseChange_tmul]; rfl
    have hφw3 : φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 3) = 0 := by
      rw [hw3, hφ, LinearMap.baseChange_tmul]
      show (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) (u ^ 2) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (by rw [sq u]; exact hq2 u u hu hu), tmul_zero]
    have hφw4 : φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 4) = 0 := by
      rw [hw4, hφ, LinearMap.baseChange_tmul]
      show (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) (u * v) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hq2 u v hu hv), tmul_zero]
    have hφw5 : φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 5) = 0 := by
      rw [hw5, hφ, LinearMap.baseChange_tmul]
      show (1 : 𝔭.ResidueField) ⊗ₜ[R] Ideal.Quotient.mk (RingHom.ker μ ^ 2) (v ^ 2) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (by rw [sq v]; exact hq2 v v hv hv), tmul_zero]
    have hli2 : LinearIndependent 𝔭.ResidueField (fun i : Fin 3 =>
        (1 : 𝔭.ResidueField) ⊗ₜ[R] (Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] i))) :=
      linearIndependent_of_top_le_span_of_card_eq_finrank hspan2.ge (by rw [Fintype.card_fin, d₂])
    have hfun : ![φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 0), φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 1),
        φ ((1 : 𝔭.ResidueField) ⊗ₜ[R] w 2)] = (fun i : Fin 3 =>
        (1 : 𝔭.ResidueField) ⊗ₜ[R] (Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] i))) := by
      funext i
      fin_cases i
      · exact hφw0
      · exact hφw1
      · exact hφw2
    obtain ⟨j, hj3, hspanj⟩ := s7 𝔭.ResidueField _ _ φ (fun i => (1 : 𝔭.ResidueField) ⊗ₜ[R] w i)
      hspan6 d₃ hφw3 hφw4 hφw5 (hfun ▸ hli2)
    obtain ⟨f₂, hf₂, hspr5⟩ := s2 (A ⧸ RingHom.ker μ ^ 3) 5 (fun k => w (j.succAbove k)) 𝔭 hspanj
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp (hspr5 (w j))
    obtain ⟨ρ, hρ⟩ : ∃ ρ : Fin 6 → R, ρ = Fin.insertNth j (-f₂) c := ⟨_, rfl⟩
    have hρj : ρ j = -f₂ := by rw [hρ]; exact Fin.insertNth_apply_same _ _ _
    have hρs : ∀ k, ρ (j.succAbove k) = c k := fun k => by
      rw [hρ]; exact Fin.insertNth_apply_succAbove _ _ _ _
    have hrel0 : ∑ i, ρ i • w i = 0 := by
      rw [Fin.sum_univ_succAbove _ j, hρj]
      simp only [hρs]
      rw [hc, neg_smul, neg_add_cancel]
    have hREL : π (ρ 0) + π (ρ 1) * u + π (ρ 2) * v + π (ρ 3) * u ^ 2 + π (ρ 4) * (u * v) +
        π (ρ 5) * v ^ 2 ∈ RingHom.ker μ ^ 3 := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← hrel0, Fin.sum_univ_six, hw0, hw1, hw2, hw3, hw4, hw5]
      simp only [hSMUL, map_add, mul_one]

    have hlow : π (ρ 0) + π (ρ 1) * u + π (ρ 2) * v ∈ RingHom.ker μ ^ 2 := by
      have h1 := h23 hREL
      have h2 : π (ρ 3) * u ^ 2 + π (ρ 4) * (u * v) + π (ρ 5) * v ^ 2 ∈ RingHom.ker μ ^ 2 := by
        refine add_mem (add_mem ?_ ?_) ?_ <;> refine Ideal.mul_mem_left _ _ ?_
        · rw [sq u]; exact hq2 u u hu hu
        · exact hq2 u v hu hv
        · rw [sq v]; exact hq2 v v hv hv
      have h3 := (RingHom.ker μ ^ 2).sub_mem h1 h2
      convert h3 using 1
      ring
    have hr3 : ∑ i, ![ρ 0, ρ 1, ρ 2] i •
        (fun i => Ideal.Quotient.mk (RingHom.ker μ ^ 2) (![1, u, v] i)) i = 0 := by
      rw [Fin.sum_univ_three]
      show ρ 0 • Ideal.Quotient.mk (RingHom.ker μ ^ 2) 1 + ρ 1 • Ideal.Quotient.mk _ u +
        ρ 2 • Ideal.Quotient.mk _ v = 0
      rw [hSMUL, hSMUL, hSMUL, ← map_add, ← map_add, Ideal.Quotient.eq_zero_iff_mem, mul_one]
      exact hlow
    have hrk : ∀ (𝔮 : Ideal R) [𝔮.IsPrime], f₀ ∉ 𝔮 →
        Module.finrank 𝔮.ResidueField (TensorProduct R 𝔮.ResidueField (A ⧸ RingHom.ker μ ^ 2)) =
          3 := fun 𝔮 _ _ => (hH 𝔮 2 (by norm_num) (by norm_num)).trans (by norm_num)
    have k0 : f₀ * ρ 0 = 0 := s4 _ 3 _ f₀ hspr hrk _ hr3 0
    have k1 : f₀ * ρ 1 = 0 := s4 _ 3 _ f₀ hspr hrk _ hr3 1
    have k2 : f₀ * ρ 2 = 0 := s4 _ 3 _ f₀ hspr hrk _ hr3 2

    refine ⟨f₀ * f₂, u, v, f₀ * ρ 3, f₀ * ρ 4, f₀ * ρ 5,
      Ideal.IsPrime.mul_notMem inferInstance hf₀ hf₂, hu, hv, ?_, ?_, ?_⟩
    · intro x hx
      obtain ⟨r₀, r₁, r₂, hd⟩ := hLIN x
      have hdI : π f₀ * x - (π r₀ + π r₁ * u + π r₂ * v) ∈ RingHom.ker μ :=
        Ideal.pow_le_self two_ne_zero hd
      have h0 := RingHom.mem_ker.mp hdI
      rw [map_sub, map_add, map_add, map_mul, map_mul, map_mul, hμπ', hμπ', hμπ', hμπ',
        hx, hu, hv] at h0
      have hr0 : r₀ = 0 := by linear_combination -h0
      refine ⟨1, ?_⟩
      have e : π ((f₀ * f₂) ^ 1) * x = π f₂ * (π r₁ * u + π r₂ * v) +
          π f₂ * (π f₀ * x - (π r₀ + π r₁ * u + π r₂ * v)) := by
        rw [hr0, map_zero, pow_one, map_mul]; ring
      rw [e]
      refine Submodule.add_mem_sup ?_ ?_
      · exact Ideal.mul_mem_left _ _ (Ideal.mem_span_pair.mpr ⟨π r₁, π r₂, rfl⟩)
      · exact Ideal.mul_mem_left _ _ hd
    · refine ⟨0, ?_⟩
      have h1 := (RingHom.ker μ ^ 3).mul_mem_left (π f₀) hREL
      have e : π ((f₀ * f₂) ^ 0) * (π (f₀ * ρ 3) * u ^ 2 + π (f₀ * ρ 4) * (u * v) +
          π (f₀ * ρ 5) * v ^ 2) = π f₀ * (π (ρ 0) + π (ρ 1) * u + π (ρ 2) * v + π (ρ 3) * u ^ 2 +
          π (ρ 4) * (u * v) + π (ρ 5) * v ^ 2) -
          (π (f₀ * ρ 0) + π (f₀ * ρ 1) * u + π (f₀ * ρ 2) * v) := by
        simp only [pow_zero, map_one, map_mul]; ring
      rw [e, k0, k1, k2, map_zero, zero_mul, zero_mul, add_zero, add_zero, sub_zero]
      exact h1
    · refine ⟨1, ?_⟩
      rw [pow_one]
      have hfj : f₀ * f₂ = -(f₀ * ρ j) := by rw [hρj]; ring
      rw [hfj]
      refine neg_mem (Ideal.subset_span ?_)
      rcases j with ⟨jv, hjv⟩
      have hj3' : 3 ≤ jv := hj3
      interval_cases jv
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)

theorem wcpa_dj_lq_fe_bridge : ∀ (C P' S : Scheme.{u}) (g : C ⟶ P') (ι : S ⟶ C)
    (Ω : (wcpaLqY g ι).Opens) (V : S.Opens), IsAffineOpen Ω → IsAffineOpen V →
    ∀ (hΩV : Ω ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V) (hVΩ : V ≤ wcpaLqDelta g ι ⁻¹ᵁ Ω)
      (K : Type u) [Field K] (s : Spec (.of K) ⟶ P') (τ : Spec (.of K) ⟶ Limits.pullback g s)
      (σ : Spec (.of K) ⟶ S), τ ≫ Limits.pullback.snd g s = 𝟙 _ →
      τ ≫ Limits.pullback.fst g s = σ ≫ ι →
    ∀ (hs : s = σ ≫ ι ≫ g) (h : ⊤ ≤ σ ⁻¹ᵁ V)
      (hw : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω) [Algebra Γ(S, V) K],
      algebraMap Γ(S, V) K = wcpaBscEval K σ V h →
      (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw).comp
          ((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom =
        (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
          (τ (IsLocalRing.closedPoint K))).comp (algebraMap Γ(S, V) K) ∧
      (letI := ((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom.toAlgebra
       letI := (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
          (τ (IsLocalRing.closedPoint K))).toAlgebra
       ∀ n : ℕ, 1 ≤ n → ∃ e : TensorProduct Γ(S, V) K
          (Γ(wcpaLqY g ι, Ω) ⧸ RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ n) ≃ₗ[K]
          ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)) ⧸
            IsLocalRing.maximalIdeal
              ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ n),
        ∀ (k : K) (a : Γ(wcpaLqY g ι, Ω)),
          e (k ⊗ₜ Ideal.Quotient.mk (RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ n) a) =
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal
              ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ n)
              (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
                (τ (IsLocalRing.closedPoint K)) k *
                wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw a)) :=
by
  intro C P' S g ι Ω V hΩ hV hΩV hVΩ K _ s τ σ hτs hτf hs h hw inst hev
  classical

  have s8 : ∀ (R A K₀ : Type u) [CommRing R] [CommRing A] [Field K₀] [Algebra R A] [Algebra R K₀]
      (μ : A →+* R), μ.comp (algebraMap R A) = RingHom.id R →
      ∃ χ : TensorProduct R K₀ A →+* K₀,
        (∀ (k : K₀) (a : A), χ (k ⊗ₜ a) = k * algebraMap R K₀ (μ a)) ∧
        χ.comp (algebraMap K₀ (TensorProduct R K₀ A)) = RingHom.id K₀ ∧
        (∀ a : A, χ (Algebra.TensorProduct.includeRight a) = algebraMap R K₀ (μ a)) ∧
        ∀ n : ℕ, Ideal.map (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R K₀ A)
          (RingHom.ker μ ^ n) = RingHom.ker χ ^ n := by
    intro R A K₀ _ _ _ _ _ μ hμ
    have hμr : ∀ r : R, μ (algebraMap R A r) = r := fun r => RingHom.congr_fun hμ r
    let ν : A →ₐ[R] K₀ :=
      { (algebraMap R K₀).comp μ with
        commutes' := fun r => by
          show algebraMap R K₀ (μ (algebraMap R A r)) = algebraMap R K₀ r
          rw [hμr] }
    let χa := Algebra.TensorProduct.lift (Algebra.ofId K₀ K₀) ν (fun _ _ => Commute.all _ _)
    have hχ1 : ∀ (k : K₀) (a : A), χa.toRingHom (k ⊗ₜ a) = k * algebraMap R K₀ (μ a) := by
      intro k a
      show χa (k ⊗ₜ a) = _
      rw [Algebra.TensorProduct.lift_tmul]
      rfl
    have hr : ∀ (k : K₀) (r : R),
        k ⊗ₜ[R] algebraMap R A r = (k * algebraMap R K₀ r) ⊗ₜ[R] (1 : A) := by
      intro k r
      rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_comm]
    have key : ∀ t : TensorProduct R K₀ A, t - algebraMap K₀ _ (χa.toRingHom t) ∈
        Ideal.map (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R K₀ A)
          (RingHom.ker μ) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul k a =>
        rw [hχ1, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply]
        have hmem : a - algebraMap R A (μ a) ∈ RingHom.ker μ := by
          rw [RingHom.mem_ker, map_sub, hμr, sub_self]
        have e : k ⊗ₜ[R] a - (k * algebraMap R K₀ (μ a)) ⊗ₜ[R] (1 : A) =
            (k ⊗ₜ[R] (1 : A)) *
              Algebra.TensorProduct.includeRight (a - algebraMap R A (μ a)) := by
          rw [map_sub, Algebra.TensorProduct.includeRight_apply,
            Algebra.TensorProduct.includeRight_apply, mul_sub, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, one_mul, hr]
        rw [e]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hmem)
      | add x y hx hy =>
        have e : x + y - algebraMap K₀ _ (χa.toRingHom (x + y)) =
            (x - algebraMap K₀ _ (χa.toRingHom x)) + (y - algebraMap K₀ _ (χa.toRingHom y)) := by
          rw [map_add, map_add]; abel
        rw [e]
        exact Ideal.add_mem _ hx hy
    have hker : Ideal.map (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R K₀ A)
        (RingHom.ker μ) = RingHom.ker χa.toRingHom := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro i hi
        rw [Ideal.mem_comap, RingHom.mem_ker, Algebra.TensorProduct.includeRight_apply, hχ1,
          RingHom.mem_ker.mp hi, map_zero, mul_zero]
      · intro t ht
        have := key t
        rw [RingHom.mem_ker.mp ht, map_zero, sub_zero] at this
        exact this
    refine ⟨χa.toRingHom, hχ1, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro k
      rw [RingHom.comp_apply, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
        RingHom.id_apply, hχ1, map_one, map_one, mul_one]
    · intro a
      rw [Algebra.TensorProduct.includeRight_apply, hχ1, one_mul]
    · intro n
      rw [Ideal.map_pow, hker]
  have s9 : ∀ (R K₀ A : Type u) [CommRing R] [Field K₀] [CommRing A] [Algebra R K₀]
      [Algebra R A] (J : Ideal A),
      ∃ e : TensorProduct R K₀ (A ⧸ J) ≃ₗ[K₀] (TensorProduct R K₀ A ⧸
          Ideal.map (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R K₀ A) J),
        ∀ (k : K₀) (a : A), e (k ⊗ₜ Ideal.Quotient.mk J a) = Ideal.Quotient.mk _ (k ⊗ₜ a) := by
    intro R K₀ A _ _ _ _ _ J
    let Φ : TensorProduct R K₀ A →ₐ[K₀] TensorProduct R K₀ (A ⧸ J) :=
      Algebra.TensorProduct.map (AlgHom.id K₀ K₀) (Ideal.Quotient.mkₐ R J)
    have hΦs : Function.Surjective Φ :=
      Algebra.TensorProduct.map_surjective _ _ (fun k => ⟨k, rfl⟩)
        (Ideal.Quotient.mkₐ_surjective R J)
    have hΦk : RingHom.ker Φ =
        Ideal.map (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R K₀ A) J := by
      have := Algebra.TensorProduct.lTensor_ker (A := K₀) (Ideal.Quotient.mkₐ R J)
        (Ideal.Quotient.mkₐ_surjective R J)
      have hk : RingHom.ker (Ideal.Quotient.mkₐ R J) = J := by
        ext x; simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
      rw [hk] at this
      exact this
    let E := (Ideal.quotientEquivAlgOfEq K₀ hΦk).symm.trans
      (Ideal.quotientKerAlgEquivOfSurjective hΦs)
    refine ⟨E.symm.toLinearEquiv, fun k a => ?_⟩
    apply E.injective
    simp only [AlgEquiv.toLinearEquiv_apply, AlgEquiv.apply_symm_apply]
    rfl
  have s10 : ∀ (K₀ T O : Type u) [Field K₀] [CommRing T] [CommRing O] [IsLocalRing O]
      (Θ : T →+* O) (χ : T →+* K₀), Function.Surjective χ → (∀ t, χ t ≠ 0 → IsUnit (Θ t)) →
      (∀ y : O, ∃ t t', χ t' ≠ 0 ∧ y * Θ t' = Θ t) →
      (∀ t, Θ t = 0 → ∃ t', χ t' ≠ 0 ∧ t' * t = 0) →
      (∀ n : ℕ, Ideal.comap Θ (IsLocalRing.maximalIdeal O ^ n) = RingHom.ker χ ^ n) ∧
        (∀ (n : ℕ) (y : O), ∃ t, y - Θ t ∈ IsLocalRing.maximalIdeal O ^ n) := by
    intro K₀ T O _ _ _ _ Θ χ hχ L1 L2 L3
    have c1 : ∀ t ∈ RingHom.ker χ, Θ t ∈ IsLocalRing.maximalIdeal O := by
      intro t ht
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      obtain ⟨t₁, t', ht', he⟩ := L2 (↑u⁻¹)
      have h1 : Θ (t' - t * t₁) = 0 := by
        rw [map_sub, map_mul, ← he, ← hu]
        simp
      obtain ⟨t'', ht'', h2⟩ := L3 _ h1
      have h3 := congrArg χ h2
      rw [map_mul, map_sub, map_mul, RingHom.mem_ker.mp ht, zero_mul, sub_zero, map_zero] at h3
      exact (mul_ne_zero ht'' ht') h3
    have c2 : ∀ y ∈ IsLocalRing.maximalIdeal O, y ∈ Ideal.map Θ (RingHom.ker χ) := by
      intro y hy
      obtain ⟨t, t', ht', he⟩ := L2 y
      obtain ⟨v, hv⟩ := L1 t' ht'
      have hyv : y = Θ t * ↑v⁻¹ := by rw [← he, ← hv, mul_assoc, Units.mul_inv, mul_one]
      have htN : t ∈ RingHom.ker χ := by
        by_contra hc
        have hu := L1 t (fun h => hc (RingHom.mem_ker.mpr h))
        have hyu : IsUnit y := by rw [hyv]; exact hu.mul v⁻¹.isUnit
        exact ((IsLocalRing.mem_maximalIdeal _).mp hy) hyu
      rw [hyv]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem Θ htN)
    have hmap : Ideal.map Θ (RingHom.ker χ) = IsLocalRing.maximalIdeal O :=
      le_antisymm (Ideal.map_le_iff_le_comap.mpr c1) c2
    have mapn : ∀ n : ℕ, Ideal.map Θ (RingHom.ker χ ^ n) = IsLocalRing.maximalIdeal O ^ n := by
      intro n; rw [Ideal.map_pow, hmap]
    have c3 : ∀ (n : ℕ) (s : T), χ s ≠ 0 → ∃ s', s * s' - 1 ∈ RingHom.ker χ ^ n := by
      intro n s hs
      obtain ⟨s₁, hs₁⟩ := hχ (χ s)⁻¹
      have he : 1 - s * s₁ ∈ RingHom.ker χ := by
        rw [RingHom.mem_ker, map_sub, map_one, map_mul, hs₁, mul_inv_cancel₀ hs, sub_self]
      refine ⟨s₁ * ∑ i ∈ Finset.range n, (1 - s * s₁) ^ i, ?_⟩
      have hg := mul_neg_geom_sum (1 - s * s₁) n
      have : s * (s₁ * ∑ i ∈ Finset.range n, (1 - s * s₁) ^ i) - 1 = -((1 - s * s₁) ^ n) := by
        have e2 : s * (s₁ * ∑ i ∈ Finset.range n, (1 - s * s₁) ^ i) =
            (1 - (1 - s * s₁)) * ∑ i ∈ Finset.range n, (1 - s * s₁) ^ i := by ring
        rw [e2, hg]; ring
      rw [this]
      exact neg_mem (Ideal.pow_mem_pow he n)
    have c4 : ∀ n : ℕ, RingHom.ker χ ^ n ≤ Ideal.comap Θ (IsLocalRing.maximalIdeal O ^ n) :=
      fun n => Ideal.map_le_iff_le_comap.mp (le_of_eq (mapn n))
    have sub : ∀ n : ℕ, ∀ z ∈ Ideal.map Θ (RingHom.ker χ ^ n),
        ∃ s t₁, χ s ≠ 0 ∧ t₁ ∈ RingHom.ker χ ^ n ∧ z * Θ s = Θ t₁ := by
      intro n z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j, hj, rfl⟩ := hx
        exact ⟨1, j, by simp, hj, by simp⟩
      | zero => exact ⟨1, 0, by simp, Submodule.zero_mem _, by simp⟩
      | add x y _ _ ihx ihy =>
        obtain ⟨s, t₁, hs, ht, he⟩ := ihx
        obtain ⟨s', t₁', hs', ht', he'⟩ := ihy
        refine ⟨s * s', t₁ * s' + t₁' * s, by rw [map_mul]; exact mul_ne_zero hs hs',
          Ideal.add_mem _ (Ideal.mul_mem_right _ _ ht) (Ideal.mul_mem_right _ _ ht'), ?_⟩
        rw [map_mul, map_add, map_mul, map_mul, ← he, ← he']
        ring
      | smul o x _ ihx =>
        obtain ⟨s, t₁, hs, ht, he⟩ := ihx
        obtain ⟨t'', s'', hs'', he''⟩ := L2 o
        refine ⟨s * s'', t'' * t₁, by rw [map_mul]; exact mul_ne_zero hs hs'',
          Ideal.mul_mem_left _ _ ht, ?_⟩
        rw [smul_eq_mul, map_mul, map_mul, ← he, ← he'']
        ring
    have c5 : ∀ n : ℕ, Ideal.comap Θ (IsLocalRing.maximalIdeal O ^ n) ≤ RingHom.ker χ ^ n := by
      intro n t ht
      rw [Ideal.mem_comap, ← mapn n] at ht
      obtain ⟨s, t₁, hs, ht₁, he⟩ := sub n _ ht
      have h0 : Θ (t * s - t₁) = 0 := by rw [map_sub, map_mul, he, sub_self]
      obtain ⟨t', ht', h2⟩ := L3 _ h0
      have hts : χ (t' * s) ≠ 0 := by rw [map_mul]; exact mul_ne_zero ht' hs
      obtain ⟨s', hs'⟩ := c3 n _ hts
      have h4 : t' * (t * s) = t' * t₁ := by rw [mul_sub, sub_eq_zero] at h2; exact h2
      have key : t = s' * (t' * t₁) - (t' * s * s' - 1) * t := by linear_combination s' * h4
      rw [key]
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ ht₁))
        (Ideal.mul_mem_right _ _ hs')
    have c6 : ∀ (n : ℕ) (y : O), ∃ t, y - Θ t ∈ IsLocalRing.maximalIdeal O ^ n := by
      intro n y
      obtain ⟨t, t', ht', he⟩ := L2 y
      obtain ⟨s', hs'⟩ := c3 n t' ht'
      refine ⟨t * s', ?_⟩
      have : y - Θ (t * s') = -y * Θ (t' * s' - 1) := by
        rw [map_mul, ← he, map_sub, map_mul, map_one]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ (c4 n hs')
    exact ⟨fun n => le_antisymm (c5 n) (c4 n), c6⟩
  have s11 : ∀ (K₀ T O : Type u) [Field K₀] [CommRing T] [Algebra K₀ T] [CommRing O]
      (φ : K₀ →+* O) (Θ : T →+* O) (I : Ideal T) (J : Ideal O), Θ.comp (algebraMap K₀ T) = φ →
      Ideal.comap Θ J = I → (∀ y, ∃ t, y - Θ t ∈ J) →
      letI := φ.toAlgebra
      ∃ e : (T ⧸ I) ≃ₗ[K₀] (O ⧸ J),
        ∀ t, e (Ideal.Quotient.mk I t) = Ideal.Quotient.mk J (Θ t) := by
    intro K₀ T O _ _ _ _ φ Θ I J h1 h2 h3
    letI := φ.toAlgebra
    let Θa : T →ₐ[K₀] O :=
      { Θ with commutes' := fun k => by show Θ (algebraMap K₀ T k) = φ k; rw [← h1]; rfl }
    let q := Ideal.quotientMapₐ J Θa (le_of_eq h2.symm)
    have hq : ∀ t, q (Ideal.Quotient.mk I t) = Ideal.Quotient.mk J (Θ t) := fun t => rfl
    have inj : Function.Injective q := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hq, Ideal.Quotient.eq_zero_iff_mem] at hx
      rw [Ideal.Quotient.eq_zero_iff_mem, ← h2]
      exact hx
    have surj : Function.Surjective q := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨t, ht⟩ := h3 y
      exact ⟨Ideal.Quotient.mk I t, by rw [hq]; exact (Ideal.Quotient.eq.mpr ht).symm⟩
    exact ⟨LinearEquiv.ofBijective q.toLinearMap ⟨inj, surj⟩, fun t => rfl⟩


  have chart : ∀ (C P' : Scheme.{u}) (g : C ⟶ P') (U : P'.Opens) (hU : IsAffineOpen U)
      (V₀ : C.Opens) (hV₀ : IsAffineOpen V₀) (e : V₀ ≤ g ⁻¹ᵁ U) (L : Type u) [Field L]
      (ψ : Γ(P', U) →+* L), letI := (g.appLE U V₀ e).hom.toAlgebra; letI := ψ.toAlgebra;
      ∃ ι : Spec (.of (TensorProduct Γ(P', U) L Γ(C, V₀))) ⟶
          Limits.pullback g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec),
        IsOpenImmersion ι ∧
        ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) =
          Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(P', U) L Γ(C, V₀)))) ∧
        ι ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) =
          Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
            Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom) ≫
            hV₀.fromSpec := by
    intro C P' g U hU V₀ hV₀ e L _ ψ
    letI := (g.appLE U V₀ e).hom.toAlgebra
    letI := ψ.toAlgebra
    have s2 : ∀ {W X Y Z S : Scheme.{u}} {fst : W ⟶ X} {snd : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
        (i : Z ⟶ S) [Mono i] {f' : X ⟶ S} {g' : Y ⟶ S},
        IsPullback fst snd f g → f ≫ i = f' → g ≫ i = g' → IsPullback fst snd f' g' := by
      intro W X Y Z S fst snd f g i _ f' g' H hf hg
      subst hf hg
      refine IsPullback.mk' ?_ ?_ ?_
      · rw [← Category.assoc, H.w, Category.assoc]
      · intro T φ φ' h1 h2
        exact H.hom_ext h1 h2
      · intro T a b hab
        have w : a ≫ f = b ≫ g := by
          rw [← cancel_mono i]
          simpa only [Category.assoc] using hab
        exact ⟨H.lift a b w, H.lift_fst a b w, H.lift_snd a b w⟩
    have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct Γ(P', U) L Γ(C, V₀))
    haveI : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    haveI : IsOpenImmersion hV₀.fromSpec := hV₀.isOpenImmersion_fromSpec
    have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(P', U) L))
        ≫ hU.fromSpec = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec := rfl
    have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(P', U) Γ(C, V₀))) ≫ hU.fromSpec
        = hV₀.fromSpec ≫ g := IsAffineOpen.SpecMap_appLE_fromSpec g hU hV₀ e
    have H2 := s2 hU.fromSpec H1 e1 e2
    have H : IsPullback
        (Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(P', U) L Γ(C, V₀)))))
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : Γ(C, V₀) →ₐ[Γ(P', U)]
          TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom))
        (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) (hV₀.fromSpec ≫ g) := H2
    have w : ((Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom))
          ≫ hV₀.fromSpec) ≫ g =
        Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(P', U) L Γ(C, V₀)))) ≫
          (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) := by
      rw [Category.assoc]; exact H.w.symm
    let ι := Limits.pullback.lift _ _ w
    have hιsnd : ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = _ :=
      Limits.pullback.lift_snd _ _ w
    have hιfst : ι ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = _ :=
      Limits.pullback.lift_fst _ _ w
    have H' : IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom))
        ι hV₀.fromSpec (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)) := by
      refine IsPullback.of_bot ?_ hιfst.symm (IsPullback.of_hasPullback g _)
      rw [hιsnd]
      exact H.flip
    have hιo : IsOpenImmersion ι :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) H' inferInstance
    exact ⟨ι, hιo, hιsnd, hιfst⟩

  have germkey : ∀ (T : Type u) [CommRing T] (Y : Scheme.{u}) (Ω : Y.Opens)
      (hΩ : IsAffineOpen Ω) (ρ : Γ(Y, Ω) →+* T) (f : Spec (.of T) ⟶ Y),
      f = Spec.map (CommRingCat.ofHom ρ) ≫ hΩ.fromSpec → ∀ (x : Spec (.of T))
      (hx : x ∈ f ⁻¹ᵁ Ω), f.app Ω ≫ (Spec (.of T)).presheaf.germ (f ⁻¹ᵁ Ω) x hx =
        CommRingCat.ofHom ρ ≫ (Scheme.ΓSpecIso (.of T)).inv ≫
          (Spec (.of T)).presheaf.germ ⊤ x trivial := by
    intro T _ Y Ω hΩ ρ f hf x hx
    subst hf
    have e : (⊤ : (Spec (.of T)).Opens) ≤
        (Spec.map (CommRingCat.ofHom ρ) ≫ hΩ.fromSpec) ⁻¹ᵁ Ω := by
      intro y _
      have h1 : Spec.map (CommRingCat.ofHom ρ) y ∈ hΩ.fromSpec ⁻¹ᵁ Ω := by
        rw [hΩ.fromSpec_preimage_self]; trivial
      exact h1
    have h1 : (Spec.map (CommRingCat.ofHom ρ) ≫ hΩ.fromSpec).app Ω ≫
        (Spec (.of T)).presheaf.germ _ x hx =
        (Spec.map (CommRingCat.ofHom ρ) ≫ hΩ.fromSpec).appLE Ω ⊤ e ≫
          (Spec (.of T)).presheaf.germ ⊤ x trivial := by
      rw [Scheme.Hom.appLE, Category.assoc]
      congr 1
      exact ((Spec (.of T)).presheaf.germ_res (homOfLE e) x trivial).symm
    have h2 : (Spec.map (CommRingCat.ofHom ρ) ≫ hΩ.fromSpec).appLE Ω ⊤ e =
        CommRingCat.ofHom ρ ≫ (Scheme.ΓSpecIso (.of T)).inv := by
      simp only [Scheme.Hom.comp_appLE, IsAffineOpen.fromSpec_app_self, Category.assoc]
      rw [Scheme.ΓSpecIso_inv_naturality]
      rfl
    rw [h1, h2, Category.assoc]

  have stalkpkg : ∀ (T : Type u) [CommRing T] [Algebra K T] (X Y : Scheme.{u})
      (a : X ⟶ Spec (.of K)) (j : Spec (.of T) ⟶ X) (θ : X ⟶ Y) (Ω : Y.Opens)
      (hΩ : IsAffineOpen Ω) (ρ : Γ(Y, Ω) →+* T), IsOpenImmersion j →
      j ≫ a = Spec.map (CommRingCat.ofHom (algebraMap K T)) →
      j ≫ θ = Spec.map (CommRingCat.ofHom ρ) ≫ hΩ.fromSpec →
      ∀ (x : Spec (.of T)) (w : X) (hjx : j x = w) (hw : w ∈ θ ⁻¹ᵁ Ω),
      ∃ σ₀ : T →+* X.presheaf.stalk w,
        σ₀.comp (algebraMap K T) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ w trivial).hom ∧
        (∀ b : Γ(Y, Ω), σ₀ (ρ b) = (θ.app Ω ≫ X.presheaf.germ _ w hw).hom b) ∧
        (∀ t, t ∉ x.asIdeal → IsUnit (σ₀ t)) ∧
        (∀ y, ∃ t s, s ∉ x.asIdeal ∧ y * σ₀ s = σ₀ t) ∧
        (∀ t, σ₀ t = 0 → ∃ s, s ∉ x.asIdeal ∧ s * t = 0) := by
    intro T _ _ X Y a j θ Ω hΩ ρ hj hja hjθ x w hjx hw
    subst hjx
    let x' : PrimeSpectrum T := x
    have : x'.asIdeal.IsPrime := x'.isPrime
    have : IsIso (j.stalkMap x) := inferInstance
    let Θ : X.presheaf.stalk (j x) ≃+* (Spec (.of T)).presheaf.stalk x :=
      (asIso (j.stalkMap x)).commRingCatIsoToRingEquiv
    let τT : T →+* (Spec (.of T)).presheaf.stalk x :=
      ((Scheme.ΓSpecIso (.of T)).inv ≫ (Spec (.of T)).presheaf.germ ⊤ x trivial).hom
    let Φ : Localization.AtPrime x'.asIdeal ≃+* (Spec (.of T)).presheaf.stalk x :=
      (Spec.stalkIso (CommRingCat.of T) x').symm.commRingCatIsoToRingEquiv
    have hK : ∀ t, τT t = Φ (algebraMap T _ t) := by
      intro t
      have h := Spec.algebraMap_stalkIso_inv (R := CommRingCat.of T) x'
      have h2 := congrArg (fun f => f.hom t) h
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
      exact h2.symm
    have hstar : (Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (j x) trivial ≫
        j.stalkMap x = CommRingCat.ofHom (algebraMap K T) ≫ (Scheme.ΓSpecIso (.of T)).inv ≫
        (Spec (.of T)).presheaf.germ ⊤ x trivial := by
      have hg : X.presheaf.germ ⊤ (j x) trivial ≫ j.stalkMap x =
          j.appTop ≫ (Spec (.of T)).presheaf.germ ⊤ x trivial :=
        Scheme.Hom.germ_stalkMap j ⊤ x trivial
      rw [hg, ← Category.assoc a.appTop, ← Scheme.Hom.comp_appTop, hja, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
    have hC : ∀ l, Θ (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
        X.presheaf.germ ⊤ (j x) trivial).hom l) = τT (algebraMap K T l) := by
      intro l
      have h2 := congrArg (fun f => f.hom l) hstar
      exact h2
    have hG : ∀ b, Θ ((θ.app Ω ≫ X.presheaf.germ _ (j x) hw).hom b) = τT (ρ b) := by
      intro b
      have hg := Scheme.Hom.germ_stalkMap j (θ ⁻¹ᵁ Ω) x hw
      have hk := germkey T Y Ω hΩ ρ (j ≫ θ) hjθ x hw
      have e3 : θ.app Ω ≫ X.presheaf.germ _ (j x) hw ≫ j.stalkMap x =
          CommRingCat.ofHom ρ ≫ (Scheme.ΓSpecIso (.of T)).inv ≫
            (Spec (.of T)).presheaf.germ ⊤ x trivial := by
        rw [hg, ← Category.assoc, ← Scheme.Hom.comp_app]
        exact hk
      exact congrArg (fun f => f.hom b) e3
    refine ⟨(Θ.symm : _ →+* _).comp τT, ?_, ?_, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro l
      rw [RingHom.comp_apply, RingHom.comp_apply, ← hC]
      exact Θ.symm_apply_apply _
    · intro b
      show Θ.symm (τT (ρ b)) = _
      rw [← hG b]
      exact Θ.symm_apply_apply _
    · intro t ht
      have h1 : IsUnit (algebraMap T (Localization.AtPrime x'.asIdeal) t) :=
        IsLocalization.map_units (Localization.AtPrime x'.asIdeal)
          (⟨t, ht⟩ : x'.asIdeal.primeCompl)
      have h2 : IsUnit (τT t) := by rw [hK]; exact h1.map Φ
      exact h2.map Θ.symm
    · intro y
      obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj x'.asIdeal.primeCompl (Φ.symm (Θ y))
      refine ⟨t, s, s.2, ?_⟩
      show y * Θ.symm (τT s) = Θ.symm (τT t)
      apply Θ.injective
      rw [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, hK, hK]
      have h3 := congrArg Φ hts
      rw [map_mul, RingEquiv.apply_symm_apply] at h3
      exact h3
    · intro t ht
      have h1 : τT t = 0 := by
        have h0 : Θ.symm (τT t) = 0 := ht
        have := congrArg Θ h0
        rwa [RingEquiv.apply_symm_apply, map_zero] at this
      rw [hK] at h1
      have h2 : algebraMap T (Localization.AtPrime x'.asIdeal) t = 0 := by
        have := congrArg Φ.symm h1
        rwa [RingEquiv.symm_apply_apply, map_zero] at this
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff x'.asIdeal.primeCompl _ t).mp h2
      exact ⟨m, m.2, hm⟩


  have hinst : inst = (wcpaBscEval K σ V h).toAlgebra :=
    Algebra.algebra_ext _ _ (fun r => (RingHom.congr_fun hev r).trans rfl)
  subst hinst
  letI : Algebra Γ(S, V) K := (wcpaBscEval K σ V h).toAlgebra
