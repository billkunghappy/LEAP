theorem wcpa_dj_npr_completion_data : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (n : ℕ) (t : Fin n → R), (n : WithBot ℕ∞) = ringKrullDim R → Ideal.span (Set.range t) = IsLocalRing.maximalIdeal R → ∃ (_ : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal R) R)), IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal R) R) ∧ IsAdicComplete (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal R) R)) (AdicCompletion (IsLocalRing.maximalIdeal R) R) ∧ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal R) R) = Ideal.span (Set.range (fun i => algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) (t i))) ∧ (n : WithBot ℕ∞) = ringKrullDim (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
