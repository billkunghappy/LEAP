      | (have h : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x) := ⟨q, rfl⟩
         rwa [Scheme.range_fromSpecStalk] at h)
      | (have h1 : q ⤳ IsLocalRing.closedPoint (X.presheaf.stalk x) :=
           (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
         have h2 := h1.map (X.fromSpecStalk x).continuous
         rwa [Scheme.fromSpecStalk_closedPoint] at h2)
    refine ⟨hsp, fun a => ?_⟩
    have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = q := by
      apply (X.fromSpecStalk x).isEmbedding.injective
      first
      | (rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.fromSpecStalk_closedPoint])
      | (show (Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk x)
            (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = _
         rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
      | (have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk x q)) ⟶ X =>
            k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))))
            (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
         simp only [Scheme.Hom.comp_apply] at e
         rw [e, Scheme.fromSpecStalk_closedPoint])
    have h2 : a ∈ q.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q)))).asIdeal := by
      rw [key]
    rw [h2]
    first
    | exact Iff.rfl
    | (rw [Spec.map_base_apply]; exact Iff.rfl)
    | (rw [Scheme.Spec_map_base]; exact Iff.rfl)
    | simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, IsLocalRing.closedPoint]
  obtain ⟨hsp, hiff⟩ := t_gen Y y ⟨P, inferInstance⟩
  let x : ↥(g ⁻¹ᵁ W) := ⟨Y.fromSpecStalk y ⟨P, inferInstance⟩, hgW⟩
  have hb₁ := t_La _ _ (g ∣_ W) 1 x
  have hb₂ := t_Lb S Y g W x 1 hb₁
  have hb₃ := t_Lc S Y g y _ hsp 1 hb₂
  have hloc : letI := (Y.presheaf.stalkSpecializes hsp).hom.toAlgebra;
      IsLocalization.AtPrime (Y.presheaf.stalk (Y.fromSpecStalk y ⟨P, inferInstance⟩)) P := by
    letI := (Y.presheaf.stalkSpecializes hsp).hom.toAlgebra
    have h := t_s2 Y y _ hsp
    have e : P.primeCompl = ((IsLocalRing.maximalIdeal (Y.presheaf.stalk (Y.fromSpecStalk y ⟨P, inferInstance⟩))).comap
        (Y.presheaf.stalkSpecializes hsp).hom).primeCompl :=
      Submonoid.ext fun a => not_congr (hiff a).symm
    show IsLocalization P.primeCompl _
    rw [e]
    exact h
  letI := (g.stalkMap y).hom.toAlgebra
  exact t_s7 _ _ _ (Y.presheaf.stalkSpecializes hsp).hom P 1 hloc hb₃

theorem wcpa_dj_mn_completion_regular : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] (n : ℕ) (t : Fin n → A), (n : WithBot ℕ∞) = ringKrullDim A → Ideal.span (Set.range t) = IsLocalRing.maximalIdeal A → IsDomain (AdicCompletion (IsLocalRing.maximalIdeal A) A) ∧ IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) ∧ ∀ j, Prime (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (t j)) :=
by
  intro A _ _ n t hn hspan
  have RC : ∀ (P : Type u) [CommRing P] [IsRegularLocalRing P],
      IsDomain (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
    intro P _ _
    have h1 : IsRegularLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
      wc_pfc_pc_completion_regular wc_hnas_pfc_regular_flat_ascent P inferInstance
        (AdicCompletion (IsLocalRing.maximalIdeal P) P) ⟨AlgEquiv.refl⟩
    exact wcpa_regular_isDomain _ wcpa_rs_quotient_regular h1
  refine ⟨RC A, wc_hnas_completion_noetherian A, ?_⟩
  intro j
  have hf : ∀ i, t i ∈ IsLocalRing.maximalIdeal A := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  have L := wc_lpkt_cotangent_indep A n t hspan hn.symm hf
  let x : Fin 1 → IsLocalRing.maximalIdeal A := fun _ => ⟨t j, hf j⟩
  have L1 : LinearIndependent (IsLocalRing.ResidueField A)
      (fun i => (IsLocalRing.maximalIdeal A).toCotangent (x i)) :=
    L.comp (fun _ : Fin 1 => j) (Function.injective_of_subsingleton _)
  have hsq : t j ∉ IsLocalRing.maximalIdeal A ^ 2 := by
    intro h
    exact L1.ne_zero 0 ((Ideal.toCotangent_eq_zero _ (x 0)).mpr h)
  obtain ⟨hRI, -⟩ := wcpa_rs_quotient_regular A 1 x L1
  haveI := hRI
  haveI hdomQ := RC (A ⧸ Ideal.span (Set.range (fun i => (x i : A))))
  obtain ⟨E₃⟩ := wc_hnas_pfc_completion_surj_base_change A
    (A ⧸ Ideal.span (Set.range (fun i => (x i : A)))) Ideal.Quotient.mk_surjective
  let E₁ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot
    (AdicCompletion (IsLocalRing.maximalIdeal A) A) (Ideal.span (Set.range (fun i => (x i : A))))
  let E₂ := Algebra.TensorProduct.comm A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
    (A ⧸ Ideal.span (Set.range (fun i => (x i : A))))
  let Φ := E₁.toRingEquiv.trans (E₂.toRingEquiv.trans E₃.toRingEquiv)
  haveI hdomI : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal A) A ⧸
      (Ideal.span (Set.range (fun i => (x i : A)))).map
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) :=
    MulEquiv.isDomain _ Φ.toMulEquiv
  have hprime := (Ideal.Quotient.isDomain_iff_prime _).mp hdomI
  have hIeq : (Ideal.span (Set.range (fun i => (x i : A)))).map
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) =
      Ideal.span {algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (t j)} := by
    rw [Ideal.map_span]
    congr 1
    ext y
    simp only [Set.mem_image, Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨_, ⟨_, rfl⟩, rfl⟩
      rfl
    · rintro rfl
      exact ⟨t j, ⟨0, rfl⟩, rfl⟩
  rw [hIeq] at hprime
  have hne : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (t j) ≠ 0 := by
    intro h0
    apply hsq
    apply (wc_hnas_hs_completion_levels A).2 2 (t j)
    rw [h0]
    exact Ideal.zero_mem _
  exact (Ideal.span_singleton_prime hne).mp hprime

theorem wcpa_dj_mn_monomial_factor : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] (n : ℕ) (s : Fin n → B) (J : Finset (Fin n)) (h : B), (∀ j ∈ J, Prime (s j)) → (∀ q : Ideal B, q.IsPrime → h ∈ q → ∃ j ∈ J, s j ∈ q) → ∃ (v : Bˣ) (a : Fin n → ℕ), (∀ j, a j ≠ 0 → j ∈ J) ∧ h = ↑v * ∏ j, s j ^ a j :=
by
  intro B _ _ _ n s J h hprime hV
  classical
  let T : Submonoid B :=
    { carrier := {x | ∃ b : Fin n → ℕ, (∀ j, b j ≠ 0 → j ∈ J) ∧ x = ∏ j, s j ^ b j}
      one_mem' := ⟨0, fun j hj => absurd rfl hj, by simp⟩
      mul_mem' := by
        rintro x y ⟨b, hb, rfl⟩ ⟨b', hb', rfl⟩
        refine ⟨b + b', fun j hj => ?_, ?_⟩
        · by_cases h1 : b j = 0
          · exact hb' j (by simpa [h1] using hj)
          · exact hb j h1
        · simp only [Pi.add_apply, pow_add, Finset.prod_mul_distrib] }
  have hsT : ∀ j₀ ∈ J, s j₀ ∈ T := by
    intro j₀ hj₀
    refine ⟨(Pi.single j₀ (1 : ℕ) : Fin n → ℕ), fun j hj => ?_, ?_⟩
    · by_cases hjj : j = j₀
      · rw [hjj]; exact hj₀
      · exact absurd (Pi.single_eq_of_ne hjj 1) hj
    · rw [Fintype.prod_eq_single j₀ (fun j hj => by rw [Pi.single_eq_of_ne hj, pow_zero]),
        Pi.single_eq_same, pow_one]
  have hnd : ¬ Disjoint (↑(Ideal.span {h}) : Set B) (↑T : Set B) := by
    intro hdis
    obtain ⟨q, hq, hle, hqdis⟩ := Ideal.exists_le_prime_disjoint _ T hdis
    obtain ⟨j, hj, hsj⟩ := hV q hq (hle (Ideal.mem_span_singleton_self h))
    exact Set.disjoint_left.mp hqdis hsj (hsT j hj)
  obtain ⟨t, ht1, ht2⟩ := Set.not_disjoint_iff.mp hnd
  obtain ⟨b, hb, rfl⟩ := ht2
  have hdvd : h ∣ ∏ j, s j ^ b j := Ideal.mem_span_singleton.mp ht1
  have hsingle : ∀ (i : Fin n) (c : Fin n → ℕ),
      ∏ j, s j ^ (c j + (Pi.single i (1 : ℕ) : Fin n → ℕ) j) = s i * ∏ j, s j ^ c j := by
    intro i c
    have hs1 : ∏ j, s j ^ (Pi.single i (1 : ℕ) : Fin n → ℕ) j = s i := by
      rw [Fintype.prod_eq_single i (fun j hj => by rw [Pi.single_eq_of_ne hj, pow_zero]),
        Pi.single_eq_same, pow_one]
    simp only [pow_add]
    rw [Finset.prod_mul_distrib, hs1, mul_comm]
  have key : ∀ N : ℕ, ∀ (b : Fin n → ℕ) (x : B), ∑ j, b j = N → (∀ j, b j ≠ 0 → j ∈ J) →
      x ∣ ∏ j, s j ^ b j →
      ∃ (v : Bˣ) (a : Fin n → ℕ), (∀ j, a j ≠ 0 → j ∈ J) ∧ x = ↑v * ∏ j, s j ^ a j := by
    intro N
    induction N with
    | zero =>
      intro b x hsum hb hx
      have hb0 : ∀ j, b j = 0 := fun j => (Finset.sum_eq_zero_iff.mp hsum) j (Finset.mem_univ j)
      have h1 : ∏ j, s j ^ b j = 1 := by simp [hb0]
      rw [h1] at hx
      have hu : IsUnit x := isUnit_of_dvd_one hx
      exact ⟨hu.unit, 0, fun j hj => absurd rfl hj, by simp⟩
    | succ N ih =>
      intro b x hsum hb hx
      have hne : ∑ j, b j ≠ 0 := by rw [hsum]; exact Nat.succ_ne_zero N
      obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
      have hiJ := hb i hi
      have hpi := hprime i hiJ
      obtain ⟨b', hb'def⟩ : ∃ b' : Fin n → ℕ, b' = Function.update b i (b i - 1) := ⟨_, rfl⟩
      have hbb : ∀ j, b j = b' j + (Pi.single i (1 : ℕ) : Fin n → ℕ) j := by
        intro j
        by_cases hji : j = i
        · subst hji; rw [hb'def, Function.update_self, Pi.single_eq_same]; omega
        · rw [hb'def, Function.update_of_ne hji, Pi.single_eq_of_ne hji, add_zero]
      have hsum' : ∑ j, b' j = N := by
        have e : ∑ j, b j = ∑ j, b' j + 1 := by
          rw [Finset.sum_congr rfl (fun j _ => hbb j), Finset.sum_add_distrib]
          simp
        omega
      have hb'J : ∀ j, b' j ≠ 0 → j ∈ J := by
        intro j hj; apply hb j; have := hbb j; omega
      have hprod : ∏ j, s j ^ b j = s i * ∏ j, s j ^ b' j := by
        rw [← hsingle]; exact Finset.prod_congr rfl (fun j _ => by rw [hbb j])
      obtain ⟨c, hc⟩ := hx
      rw [hprod] at hc
      have hdiv : s i ∣ x * c := ⟨_, hc.symm⟩
      rcases hpi.dvd_or_dvd hdiv with ⟨x', rfl⟩ | ⟨c', rfl⟩
      · have e : x' * c = ∏ j, s j ^ b' j := by
          apply mul_left_cancel₀ hpi.ne_zero
          rw [hc]; ring
        obtain ⟨v, a', ha', hx'⟩ := ih b' x' hsum' hb'J ⟨c, e.symm⟩
        refine ⟨v, fun j => a' j + (Pi.single i (1 : ℕ) : Fin n → ℕ) j, fun j hj => ?_, ?_⟩
        · by_cases hji : j = i
          · rw [hji]; exact hiJ
          · apply ha' j
            simp only [Pi.single_eq_of_ne hji, add_zero] at hj
            exact hj
        · rw [hsingle, hx']; ring
      · have e : x * c' = ∏ j, s j ^ b' j := by
          apply mul_left_cancel₀ hpi.ne_zero
          rw [hc]; ring
        exact ih b' x hsum' hb'J ⟨c', e.symm⟩
  exact key _ b h rfl hb hdvd

theorem wcpa_dj_rn_monomial_nodes : ∀ (S Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (g : Y ⟶ S) (W : S.Opens) (D : Set S), wcpaDjSplitSemistable g → SmoothOfRelativeDimension 1 (g ∣_ W) → (W : Set S)ᶜ ⊆ D → (∀ p : S, IsRegularLocalRing (S.presheaf.stalk p)) → wcpaDjSNCSet S D → wcpaDjMonoNodeForm g D :=
by
  intro S Y _ g W D hss hsm hW hreg hD y
  classical
  obtain ⟨hflat, hprop, hfib⟩ := hss
  obtain ⟨mD, Dc, hDc, hDeq, hloc⟩ := hD
  obtain ⟨n, t, hn, hspan, α, -, hiff⟩ := hloc (g y)

  set J : Finset (Fin n) := Finset.univ.image α with hJ
  have hG0 : ∀ (p' : S) (hp : p' ⤳ g y), (p' ∈ D ↔ ∃ j ∈ J,
      (S.presheaf.stalkSpecializes hp).hom (t j) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p')) := by
    intro p' hp
    constructor
    · intro hpD
      rw [hDeq, Set.mem_iUnion] at hpD
      obtain ⟨i, hi⟩ := hpD
      have hyi : g y ∈ Dc i := hp.mem_closed (hDc i) hi
      exact ⟨α ⟨i, hyi⟩, Finset.mem_image_of_mem _ (Finset.mem_univ _), (hiff ⟨i, hyi⟩ p' hp).mp hi⟩
    · rintro ⟨j, hj, hmem⟩
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hj
      rw [hDeq, Set.mem_iUnion]
      exact ⟨i.1, (hiff i p' hp).mpr hmem⟩

  obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := g)
    (g := S.fromSpecResidueField (g y)) y (IsLocalRing.closedPoint (S.residueField (g y)))
    (Scheme.fromSpecResidueField_apply _ _).symm
  haveI := hflat
  haveI := hprop
  rcases hfib (S.residueField (g y)) (S.fromSpecResidueField (g y)) w with hsmooth | ⟨eK, heK⟩
  ·
    haveI hlfp : LocallyOfFinitePresentation g := wcpa_dj_mn_flat_fp S Y g hflat inferInstance
    exact Or.inl (wcpa_dj_mn_fibre_smooth S Y g y w hflat hlfp hw hsmooth)
  ·
    right
    haveI hAreg : IsRegularLocalRing (S.presheaf.stalk (g y)) := hreg (g y)
    haveI hAnoeth : IsNoetherianRing (S.presheaf.stalk (g y)) := inferInstance
    obtain ⟨hEFT, hRnoeth⟩ := wcpa_dj_mn_stalk_eft S Y g y inferInstance hAnoeth
    haveI := hRnoeth
    obtain ⟨ε, hε⟩ := wcpa_dj_mn_fibre_bridge S Y g y w hw ⟨eK, heK⟩
    obtain ⟨h, e₀, he₀⟩ := wcpa_dj_mn_node_deform (S.presheaf.stalk (g y)) (Y.presheaf.stalk y)
      (g.stalkMap y).hom inferInstance (Flat.stalkMap g y) ⟨ε, hε⟩

    have hVh : ∀ q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y))), q.IsPrime → h ∈ q → ∃ j ∈ J,
        algebraMap (S.presheaf.stalk (g y)) (AdicCompletion (IsLocalRing.maximalIdeal
          (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y))) (t j) ∈ q := by
      intro q hq hhq
      by_contra hcon
      push_neg at hcon
      letI : Algebra (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) := (g.stalkMap y).hom.toAlgebra
      haveI : IsLocalHom (algebraMap (S.presheaf.stalk (g y)) (Y.presheaf.stalk y)) :=
        inferInstanceAs (IsLocalHom (g.stalkMap y).hom)
      haveI : Algebra.EssFiniteType (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) := hEFT
      obtain ⟨P, hP, hPc, hrk⟩ := wcpa_dj_mn_two_derivations (S.presheaf.stalk (g y))
        (Y.presheaf.stalk y) h e₀ (by exact he₀) q hq hhq
      haveI := hP
      let 𝔭 : PrimeSpectrum (S.presheaf.stalk (g y)) :=
        ⟨q.comap (algebraMap (S.presheaf.stalk (g y)) (AdicCompletion (IsLocalRing.maximalIdeal
          (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y)))), Ideal.IsPrime.comap _⟩
      obtain ⟨hsp, hspiff⟩ := wcpa_dj_mn_generization S (g y) 𝔭
      have hnotD : S.fromSpecStalk (g y) 𝔭 ∉ D := by
        intro hD'
        obtain ⟨j, hj, hmem⟩ := (hG0 _ hsp).mp hD'
        exact hcon j hj ((hspiff (t j)).mp hmem)
      have hinW : S.fromSpecStalk (g y) 𝔭 ∈ (W : Set S) := by
        by_contra hnW
        exact hnotD (hW hnW)
      have hSpec : (Spec.map (g.stalkMap y)) (⟨P, hP⟩ : PrimeSpectrum (Y.presheaf.stalk y)) = 𝔭 := by
        apply PrimeSpectrum.ext
        exact hPc
      have hpt : S.fromSpecStalk (g y) ((Spec.map (g.stalkMap y))
            (⟨P, hP⟩ : PrimeSpectrum (Y.presheaf.stalk y))) =
          g (Y.fromSpecStalk y (⟨P, hP⟩ : PrimeSpectrum (Y.presheaf.stalk y))) := by
        have := congrArg (fun k : Spec (Y.presheaf.stalk y) ⟶ S =>
          k (⟨P, hP⟩ : PrimeSpectrum (Y.presheaf.stalk y)))
          (Scheme.SpecMap_stalkMap_fromSpecStalk g (x := y))
        exact this
      have hgW : g (Y.fromSpecStalk y ⟨P, inferInstance⟩) ∈ W := by
        rw [← hpt, hSpec]
        exact hinW
      have hrk1 := wcpa_dj_mn_smooth_omega_rank S Y g W y P hsm hgW
      have h21 : 2 ≤ 1 := hrk.trans_eq hrk1
      omega

    obtain ⟨hdom, hnoethC, hprime⟩ := wcpa_dj_mn_completion_regular (S.presheaf.stalk (g y)) n t
      hn hspan
    haveI := hdom
    haveI := hnoethC
    obtain ⟨v, a, hsupp, hfac⟩ := wcpa_dj_mn_monomial_factor _ n
      (fun j => algebraMap (S.presheaf.stalk (g y)) (AdicCompletion (IsLocalRing.maximalIdeal
        (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y))) (t j)) J h (fun j _ => hprime j) hVh
    subst hfac
    obtain ⟨Φ, hΦ⟩ := wcpa_dj_mn_rescale _ v (∏ j, (algebraMap (S.presheaf.stalk (g y))
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y))) (t j)) ^ a j)
    refine ⟨n, t, J, a, hn, hspan, hG0, hsupp, e₀.trans Φ, ?_⟩
    apply RingHom.ext
    intro x
    have h1 := RingHom.congr_fun he₀ x
    have h2 := RingHom.congr_fun hΦ (algebraMap (S.presheaf.stalk (g y))
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y))) x)
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at h1 h2 ⊢
    rw [RingEquiv.trans_apply, h1, h2]

theorem wcpa_dj_tr_basechange_semistable : ∀ (P' P'' C : Scheme.{u}) (β : P'' ⟶ P') (g : C ⟶ P'), wcpaDjSplitSemistable g → wcpaDjSplitSemistable (Limits.pullback.snd g β) :=
by

  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)

  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
    simpa [smul_eq_mul, Ideal.mul_top] using this

  have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
        AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
    intro A B _ _ _ _ σ
    let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
    have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        f n x = Ideal.Quotient.mk _ (σ a) := by
      intro n x a ha
      show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
        (AdicCompletion.evalₐ _ n x) = _
      rw [ha, Ideal.quotientMap_mk]
      rfl
    have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
        rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk]
    refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hf n x a ha

  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
    intro A B _ _ _ _ σ
    obtain ⟨Φ, hΦ⟩ := hmap A B σ
    obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
        RingHom.id_apply, hb]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
        RingHom.id_apply, hb]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
        AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
          Ideal.Quotient.mk _ r := by
      intro R _ I r
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
        RingHom.id_apply]
    show AdicCompletion.evalₐ _ n (Φ _) = _
    rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]

  have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
      (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
        i.stalkMap x =
      (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    intro K _ X Y i p q hi x
    have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
        i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
    rw [← hi, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key

  have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'

  intro P' P'' C β g hss
  obtain ⟨hflat, hprop, hfib⟩ := hss
  haveI := hflat
  haveI := hprop
  refine ⟨inferInstance, inferInstance, ?_⟩
  intro K _ s w
  set i := (Limits.pullbackLeftPullbackSndIso g β s).hom with hi_def
  have hi : i ≫ Limits.pullback.snd g (s ≫ β) = Limits.pullback.snd (Limits.pullback.snd g β) s :=
    Limits.pullbackLeftPullbackSndIso_hom_snd g β s
  rcases hfib K (s ≫ β) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
  · left
    refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
    exact s3 i _ _ hi W' hsm
  · right
    let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
    obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
    refine ⟨Φ.trans e₀, ?_⟩
    have h2 := s2 K i _ _ hi w
    ext1 k
    have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd (Limits.pullback.snd g β) s).appTop ≫
        (Limits.pullback (Limits.pullback.snd g β) s).presheaf.germ ⊤ w trivial).hom k) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g (s ≫ β)).appTop ≫
        (Limits.pullback g (s ≫ β)).presheaf.germ ⊤ (i w) trivial).hom k := by
      rw [← h2, RingEquiv.symm_apply_eq]
      rfl
    have := RingHom.congr_fun he₀ k
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
    rw [RingEquiv.trans_apply, hΦ, hk]
    exact this

theorem wcpa_dj_ste_prepare : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (gY : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens) (nP : ℕ),
    wcpaDjIsProjOver k sS → wcpaDjIsProjOver k (gY ≫ sS) → wcpaDjSemistable gY →
    wcpaDjSections gY m τ → W ≠ ⊥ → SmoothOfRelativeDimension 1 (gY ∣_ W) →
    GeometricallyConnected (gY ∣_ W) →
    topologicalKrullDim S = (nP : WithBot ℕ∞) → wcpaDjAltIH.{u} nP →
    ∃ (S₁ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S₁) (ρ₁ : S₁ ⟶ S)
      (Y₁ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y₁) (g₁ : Y₁ ⟶ S₁) (π₁ : Y₁ ⟶ Y)
      (W₁ : S₁.Opens) (D₁ : Set S₁) (m₁ : ℕ) (τ₁ : Fin m₁ → (S₁ ⟶ Y₁)),
      IsProper ρ₁ ∧ Surjective ρ₁ ∧ (∃ V : S.Opens, V ≠ ⊥ ∧ IsFinite (ρ₁ ∣_ V)) ∧
      wcpaDjIsProjOver k (ρ₁ ≫ sS) ∧ (∀ s : S₁, IsRegularLocalRing (S₁.presheaf.stalk s)) ∧
      topologicalKrullDim S₁ = (nP : WithBot ℕ∞) ∧ wcpaDjSNCSet S₁ D₁ ∧
      (W₁ : Set S₁)ᶜ ⊆ D₁ ∧ W₁ ≠ ⊥ ∧ W₁ ≤ ρ₁ ⁻¹ᵁ W ∧
      wcpaDjIsProjOver k (g₁ ≫ ρ₁ ≫ sS) ∧ wcpaDjSplitSemistable g₁ ∧
      wcpaDjMonoNodeForm g₁ D₁ ∧ wcpaDjSections g₁ m₁ τ₁ ∧
      SmoothOfRelativeDimension 1 (g₁ ∣_ W₁) ∧ GeometricallyConnected (g₁ ∣_ W₁) ∧
      π₁ ≫ gY = g₁ ≫ ρ₁ ∧ IsProper π₁ ∧ Surjective π₁ ∧
      (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (π₁ ∣_ V)) ∧
      ⇑π₁ ⁻¹' ((⋃ j, Set.range ⇑(τ j)) ∪ ⇑gY ⁻¹' ((W : Set S)ᶜ)) ⊆
        (⋃ j, Set.range ⇑(τ₁ j)) ∪ ⇑g₁ ⁻¹' ((W₁ : Set S₁)ᶜ) :=
by
  intro k _ _ S Y _ _ sS gY m τ W nP hS hY hss hτ hW hWsm hWgc hdim hIH
  classical

  have hRB : ∀ (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange]
      {X B Z : Scheme.{u}} (g : X ⟶ B) (φ : Z ⟶ B) (U : B.Opens) (V : Z.Opens),
      V ≤ φ ⁻¹ᵁ U → P (g ∣_ U) → P ((Limits.pullback.snd g φ) ∣_ V) := by
    intro P _ X B Z g φ U V hV hP
    have e₁ : Limits.pullback.snd g φ ⁻¹ᵁ V ≤ Limits.pullback.fst g φ ⁻¹ᵁ (g ⁻¹ᵁ U) := by
      intro q hq
      rw [Scheme.Hom.mem_preimage] at hq
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
      have h1 := hV hq
      rw [Scheme.Hom.mem_preimage] at h1
      have e : (Limits.pullback.fst g φ ≫ g) q = (Limits.pullback.snd g φ ≫ φ) q := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
      rw [e]
      exact h1
    obtain ⟨a, ha'⟩ : ∃ a : (Limits.pullback.snd g φ ⁻¹ᵁ V).toScheme ⟶ (g ⁻¹ᵁ U).toScheme,
        a ≫ (g ⁻¹ᵁ U).ι = (Limits.pullback.snd g φ ⁻¹ᵁ V).ι ≫ Limits.pullback.fst g φ :=
      ⟨_, Scheme.Hom.resLE_comp_ι _ e₁⟩
    obtain ⟨b, hb'⟩ : ∃ b : V.toScheme ⟶ U.toScheme, b ≫ U.ι = V.ι ≫ φ :=
      ⟨_, Scheme.Hom.resLE_comp_ι _ hV⟩
    have L := (isPullback_morphismRestrict (Limits.pullback.snd g φ) V).flip
    have R := IsPullback.of_hasPullback g φ
    have outer := L.paste_horiz R
    rw [← ha', ← hb'] at outer
    have R' := (isPullback_morphismRestrict g U).flip
    have comm : a ≫ (g ∣_ U) = (Limits.pullback.snd g φ ∣_ V) ≫ b := by
      rw [← cancel_mono U.ι]
      simp only [Category.assoc, morphismRestrict_ι, hb']
      rw [← Category.assoc a, ha', morphismRestrict_ι_assoc, Category.assoc,
        Limits.pullback.condition]
    have hpb := IsPullback.of_right outer comm R'
    exact MorphismProperty.of_isPullback hpb hP

  obtain ⟨P'', iP'', sP'', β₃, hβ₃, hP'', hβ₃p, hβ₃s, hβ₃f, C'', iC'', g'', h₃, hh₃g, hC'',
    hsplit, hh₃p, hh₃s, hh₃f, U'', m'', τ'', hU'', hU''sm, hU''gc, hτ'', hcont''⟩ :=
    wcpa_dj_ss_split k Y S sS gY hY hS hss W hW hWsm hWgc m τ hτ
  haveI := iP''
  haveI := iC''

  haveI hsSp : IsProper sS := wcpa_dj_proj_proper k sS hS
  haveI hsP''p : IsProper sP'' := wcpa_dj_proj_proper k sP'' hP''
  have hP''dim : topologicalKrullDim P'' = (nP : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k P'' S sP'' sS β₃ hβ₃ hβ₃s hβ₃f).trans hdim

  obtain ⟨O, hOdef⟩ : ∃ O : P''.Opens, O = U'' ⊓ β₃ ⁻¹ᵁ W := ⟨_, rfl⟩
  have hOmem : ∀ p : P'', p ∈ O ↔ p ∈ U'' ∧ β₃ p ∈ W := by
    intro p
    first
      | (rw [hOdef, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage])
      | (rw [hOdef]; exact Iff.rfl)
  obtain ⟨q, hqO⟩ : ∃ q : P'', q ∈ O := by
    have h1 : (U'' : Set P'').Nonempty := (TopologicalSpace.Opens.ne_bot_iff_nonempty U'').mp hU''
    obtain ⟨w, hw⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hW
    haveI := hβ₃s
    obtain ⟨p, hp⟩ := β₃.surjective w
    have h2 : ((β₃ ⁻¹ᵁ W : P''.Opens) : Set P'').Nonempty :=
      ⟨p, show p ∈ β₃ ⁻¹ᵁ W by rw [Scheme.Hom.mem_preimage, hp]; exact hw⟩
    obtain ⟨r, hr1, hr2⟩ := nonempty_preirreducible_inter U''.isOpen (β₃ ⁻¹ᵁ W).isOpen h1 h2
    exact ⟨r, (hOmem r).mpr ⟨hr1, (Scheme.Hom.mem_preimage β₃).mp hr2⟩⟩
  have hEcl : IsClosed ((O : Set P'')ᶜ) := O.isOpen.isClosed_compl
  have hEne : (O : Set P'')ᶜ ≠ Set.univ := by
    intro h0
    have hq' : q ∈ (O : Set P'')ᶜ := by rw [h0]; exact Set.mem_univ q
    exact hq' hqO
  obtain ⟨S₁, iS₁, sZ, ρ₀, hρ₀, hsZp, hreg, hρ₀p, hρ₀s, hρ₀f, hsZ, D₁, hD₁, hED⟩ :=
    hIH k P'' sP'' hP''dim _ hEcl hEne
  haveI := iS₁
  haveI := hsZp

  have hflat : Flat g'' := by
    have h := hsplit
    unfold wcpaDjSplitSemistable at h
    exact h.1
  haveI iY₁ : AlgebraicGeometry.IsIntegral (Limits.pullback g'' ρ₀) :=
    wcpa_dj_tr_basechange_integral P'' S₁ C'' ρ₀ g'' U'' hflat hρ₀s hU'' hU''sm hU''gc
  have hproj₁ := wcpa_dj_tr_basechange_proj k P'' S₁ C'' sP'' sZ ρ₀ g'' hρ₀ hP'' hsZ hC''
  obtain ⟨τ₁, hτ₁, hτ₁pre⟩ := wcpa_dj_tr_basechange_sections P'' S₁ C'' ρ₀ g'' m'' τ'' hτ''
  have hsplit₁ := wcpa_dj_tr_basechange_semistable P'' S₁ C'' ρ₀ g'' hsplit
  obtain ⟨hf₁p, hf₁s, hf₁f⟩ :=
    wcpa_dj_tr_basechange_alteration P'' S₁ C'' ρ₀ g'' hflat hρ₀p hρ₀s hρ₀f

  have hW₁U : ρ₀ ⁻¹ᵁ O ≤ ρ₀ ⁻¹ᵁ U'' := by
    intro s hs
    rw [Scheme.Hom.mem_preimage] at hs ⊢
    exact ((hOmem _).mp hs).1
  have hsm₁ : SmoothOfRelativeDimension 1 (Limits.pullback.snd g'' ρ₀ ∣_ (ρ₀ ⁻¹ᵁ O)) :=
    hRB (@SmoothOfRelativeDimension 1) g'' ρ₀ U'' (ρ₀ ⁻¹ᵁ O) hW₁U hU''sm
  have hgc₁ : GeometricallyConnected (Limits.pullback.snd g'' ρ₀ ∣_ (ρ₀ ⁻¹ᵁ O)) :=
    hRB (@GeometricallyConnected) g'' ρ₀ U'' (ρ₀ ⁻¹ᵁ O) hW₁U hU''gc

  have hW₁D : ((ρ₀ ⁻¹ᵁ O : S₁.Opens) : Set S₁)ᶜ ⊆ D₁ := by
    intro s hs
    apply hED
    show ρ₀ s ∈ (O : Set P'')ᶜ
    intro hO
    apply hs
    show s ∈ ρ₀ ⁻¹ᵁ O
    rw [Scheme.Hom.mem_preimage]
    exact hO
  have hW₁ne : ρ₀ ⁻¹ᵁ O ≠ ⊥ := by
    haveI := hρ₀s
    obtain ⟨s, hs⟩ := ρ₀.surjective q
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    exact ⟨s, show s ∈ ρ₀ ⁻¹ᵁ O by rw [Scheme.Hom.mem_preimage, hs]; exact hqO⟩
  have hW₁le : ρ₀ ⁻¹ᵁ O ≤ (ρ₀ ≫ β₃) ⁻¹ᵁ W := by
    intro s hs
    rw [Scheme.Hom.mem_preimage] at hs ⊢
    rw [Scheme.Hom.comp_apply]
    exact ((hOmem _).mp hs).2

  have hmono := wcpa_dj_rn_monomial_nodes S₁ (Limits.pullback g'' ρ₀)
    (Limits.pullback.snd g'' ρ₀) (ρ₀ ⁻¹ᵁ O) D₁ hsplit₁ hsm₁ hW₁D hreg hD₁

  haveI := hβ₃p
  haveI := hρ₀p
  haveI := hh₃p
  haveI := hf₁p
  obtain ⟨hρ₁s, hρ₁f⟩ := wcpa_dj_alteration_comp β₃ ρ₀ hβ₃p hβ₃s hρ₀s hβ₃f hρ₀f
  obtain ⟨hπ₁s, hπ₁f⟩ :=
    wcpa_dj_alteration_comp h₃ (Limits.pullback.fst g'' ρ₀) hh₃p hh₃s hf₁s hh₃f hf₁f
  have hdim₁ : topologicalKrullDim S₁ = (nP : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k S₁ P'' sZ sP'' ρ₀ hρ₀ hρ₀s hρ₀f).trans hP''dim
  have hI1 : (ρ₀ ≫ β₃) ≫ sS = sZ := by rw [Category.assoc, hβ₃, hρ₀]

  refine ⟨S₁, iS₁, ρ₀ ≫ β₃, Limits.pullback g'' ρ₀, iY₁, Limits.pullback.snd g'' ρ₀,
    Limits.pullback.fst g'' ρ₀ ≫ h₃, ρ₀ ⁻¹ᵁ O, D₁, m'', τ₁, inferInstance, hρ₁s, hρ₁f, ?_,
    hreg, hdim₁, hD₁, hW₁D, hW₁ne, hW₁le, ?_, hsplit₁, hmono, hτ₁, hsm₁, hgc₁, ?_,
    inferInstance, hπ₁s, hπ₁f, ?_⟩
  · rw [hI1]; exact hsZ
  · rw [hI1]; exact hproj₁
  · rw [Category.assoc, hh₃g]
    first
      | exact Limits.pullback.condition_assoc _
      | (rw [← Category.assoc, Limits.pullback.condition, Category.assoc])
  ·
    intro y hy
    have hy' : h₃ (Limits.pullback.fst g'' ρ₀ y) ∈
        (⋃ j, Set.range ⇑(τ j)) ∪ ⇑gY ⁻¹' ((W : Set S)ᶜ) := by
      rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hy
      exact hy
    have h2 := hcont'' (show Limits.pullback.fst g'' ρ₀ y ∈ ⇑h₃ ⁻¹' _ from hy')
    by_cases hW₁y : Limits.pullback.snd g'' ρ₀ y ∈ ρ₀ ⁻¹ᵁ O
    · left
      rcases h2 with h3 | h3
      · exact hτ₁pre h3
      · exfalso
        have e : (Limits.pullback.fst g'' ρ₀ ≫ g'') y = (Limits.pullback.snd g'' ρ₀ ≫ ρ₀) y := by
          rw [Limits.pullback.condition]
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
        have hin : g'' (Limits.pullback.fst g'' ρ₀ y) ∈ (U'' : Set P'') := by
          rw [e]
          rw [Scheme.Hom.mem_preimage] at hW₁y
          exact ((hOmem _).mp hW₁y).1
        simp only [Set.mem_preimage, Set.mem_compl_iff] at h3
        exact h3 hin
    · right
      exact hW₁y

theorem wcpa_dj_bkle_regular_param_prime : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (n : ℕ) (t : Fin n → R), (n : WithBot ℕ∞) = ringKrullDim R →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal R → ∀ l, Prime (t l) :=
by
  intro R _ _ n t hn hspan l
  have ht : ∀ l, t l ∈ IsLocalRing.maximalIdeal R := fun l => by
    rw [← hspan]; exact Ideal.subset_span (Set.mem_range_self l)
  set t' : Fin n → IsLocalRing.maximalIdeal R := fun l => ⟨t l, ht l⟩ with ht'
  have hfin : Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) = n := by
    have h1 := IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R
    have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hn, h1] at h2
    exact_mod_cast h2
  have htop : Submodule.span R (Set.range t') = ⊤ := by
    apply Submodule.map_injective_of_injective (f := (IsLocalRing.maximalIdeal R).subtype)
      Subtype.val_injective
    rw [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp]
    exact hspan
  have hcot : Submodule.span (IsLocalRing.ResidueField R)
      (Set.range (fun l => (IsLocalRing.maximalIdeal R).toCotangent (t' l))) = ⊤ := by
    rw [Set.range_comp']
    exact (IsLocalRing.CotangentSpace.span_image_eq_top_iff (s := Set.range t')).mpr htop
  have L : LinearIndependent (IsLocalRing.ResidueField R)
      (fun l => (IsLocalRing.maximalIdeal R).toCotangent (t' l)) := by
    apply linearIndependent_of_top_le_span_of_card_eq_finrank hcot.ge
    rw [Fintype.card_fin]
    exact hfin.symm
  have hne : t l ≠ 0 := by
    intro h0
    apply L.ne_zero l
    have : t' l = 0 := Subtype.ext h0
    simp only [this, map_zero]
  have hinj : Function.Injective (fun _ : Fin 1 => l) := fun a b _ => Subsingleton.elim a b
  have L1 := L.comp (fun _ : Fin 1 => l) hinj
  have hreg := (wcpa_rs_quotient_regular R 1 (fun _ => t' l) L1).1
  have hdom := @wcpa_regular_isDomain _ _ wcpa_rs_quotient_regular hreg
  have hrange : Set.range (fun _ : Fin 1 => ((t' l : IsLocalRing.maximalIdeal R) : R)) = {t l} :=
    Set.range_const
  rw [hrange] at hdom
  have hprime : (Ideal.span {t l}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdom
  exact (Ideal.span_singleton_prime hne).mp hprime

theorem wcpa_dj_bkle_vanishing_stalk : ∀ (S : Scheme.{u}) (Z : Set S) (hZ : IsClosed Z)
    (U : S.affineOpens) (p : S) (hp : p ∈ U.1),
    (p ∉ Z → Ideal.map (S.presheaf.germ U.1 p hp).hom
      ((Scheme.IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal U) = ⊤) ∧
    ∀ τ : S.presheaf.stalk p, Prime τ →
      (∀ (p' : S) (hsp : p' ⤳ p), p' ∈ Z ↔
        (S.presheaf.stalkSpecializes hsp).hom τ ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
      Ideal.map (S.presheaf.germ U.1 p hp).hom
        ((Scheme.IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal U) = Ideal.span {τ} :=
by
  intro S Z hZ U p hp
  have L1 : ∀ q : PrimeSpectrum (S.presheaf.stalk p),
      Ideal.map (S.presheaf.germ U.1 p hp).hom
        ((Scheme.IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal U) ≤ q.asIdeal ↔
        S.fromSpecStalk p q ∈ Z := by
    intro q
    have e1 : S.fromSpecStalk p q =
        U.2.fromSpec (PrimeSpectrum.comap (S.presheaf.germ U.1 p hp).hom q) := by
      rw [← IsAffineOpen.fromSpecStalk_eq_fromSpecStalk U.2 hp]
      rfl
    have hT : IsClosed (U.2.fromSpec ⁻¹' Z) := hZ.preimage U.2.fromSpec.continuous
    have key : ∀ y : PrimeSpectrum Γ(S, U.1),
        PrimeSpectrum.vanishingIdeal (U.2.fromSpec ⁻¹' Z) ≤ y.asIdeal ↔
          y ∈ U.2.fromSpec ⁻¹' Z := by
      intro y
      have h1 : PrimeSpectrum.zeroLocus
          (PrimeSpectrum.vanishingIdeal (U.2.fromSpec ⁻¹' Z) : Set Γ(S, U.1)) =
          U.2.fromSpec ⁻¹' Z :=
        (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure _).trans hT.closure_eq
      exact (PrimeSpectrum.mem_zeroLocus y _).symm.trans (Set.ext_iff.mp h1 y)
    rw [e1, Ideal.map_le_iff_le_comap, Scheme.IdealSheafData.vanishingIdeal_ideal]
    exact key (PrimeSpectrum.comap (S.presheaf.germ U.1 p hp).hom q)
  have L2 : (Ideal.map (S.presheaf.germ U.1 p hp).hom
      ((Scheme.IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal U)).IsRadical := by
    have hI : ((Scheme.IdealSheafData.vanishingIdeal ⟨Z, hZ⟩).ideal U).IsRadical := by
      rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
      exact PrimeSpectrum.isRadical_vanishingIdeal _
    let x : U.1 := ⟨p, hp⟩
    letI : Algebra Γ(S, U.1) (S.presheaf.stalk p) := (S.presheaf.germ U.1 p hp).hom.toAlgebra
    haveI : IsLocalization.AtPrime (S.presheaf.stalk p) (U.2.primeIdealOf x).asIdeal :=
      U.2.isLocalization_stalk x
    have e : (S.presheaf.germ U.1 p hp).hom =
        algebraMap Γ(S, U.1) (S.presheaf.stalk p) := rfl
    rw [e]
    intro y hy
    rw [← IsLocalization.map_radical (U.2.primeIdealOf x).asIdeal.primeCompl
      (S.presheaf.stalk p), hI.radical] at hy
    exact hy
  have L3 : ∀ (J : Ideal (S.presheaf.stalk p)) (τ : S.presheaf.stalk p), J.IsRadical →
      Prime τ → (∀ Q : Ideal (S.presheaf.stalk p), Q.IsPrime → (J ≤ Q ↔ τ ∈ Q)) →
      J = Ideal.span {τ} := by
    intro J τ hJ hτ hQ
    have hsp : (Ideal.span {τ}).IsPrime := (Ideal.span_singleton_prime hτ.ne_zero).mpr hτ
    rw [← hJ.radical, ← hsp.radical, Ideal.radical_eq_sInf, Ideal.radical_eq_sInf]
    congr 1
    ext Q
    simp only [Set.mem_setOf_eq, Ideal.span_singleton_le_iff_mem]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨(hQ Q h2).mp h1, h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨(hQ Q h2).mpr h1, h2⟩
  have GEN : ∀ (X : Scheme.{u}) (x : X) (q : PrimeSpectrum (X.presheaf.stalk x)),
      ∃ hsp : X.fromSpecStalk x q ⤳ x, ∀ a : X.presheaf.stalk x,
        (X.presheaf.stalkSpecializes hsp).hom a ∈
          IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk x q)) ↔ a ∈ q.asIdeal := by
    intro X x q
    have hsp : X.fromSpecStalk x q ⤳ x := by
      first
      | exact (Scheme.range_fromSpecStalk (X := X) (x := x)).subset ⟨q, rfl⟩
      | (have h : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x) := ⟨q, rfl⟩
         rwa [Scheme.range_fromSpecStalk] at h)
      | (have h1 : q ⤳ IsLocalRing.closedPoint (X.presheaf.stalk x) :=
           (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
         have h2 := h1.map (X.fromSpecStalk x).continuous
         rwa [Scheme.fromSpecStalk_closedPoint] at h2)
    refine ⟨hsp, fun a => ?_⟩
    have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = q := by
      apply (X.fromSpecStalk x).isEmbedding.injective
      first
      | (rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.fromSpecStalk_closedPoint])
      | (show (Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk x)
            (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = _
         rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
      | (have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk x q)) ⟶ X =>
            k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))))
            (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
         simp only [Scheme.Hom.comp_apply] at e
         rw [e, Scheme.fromSpecStalk_closedPoint])
    have h2 : a ∈ q.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q)))).asIdeal := by
      rw [key]
    rw [h2]
    first
    | exact Iff.rfl
    | (rw [Spec.map_base_apply]; exact Iff.rfl)
    | (rw [Scheme.Spec_map_base]; exact Iff.rfl)
    | simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, IsLocalRing.closedPoint]
  refine ⟨fun hpZ => ?_, fun τ hτ hcrit => ?_⟩
  · by_contra hne
    have hle := IsLocalRing.le_maximalIdeal hne
    have h2 := (L1 (IsLocalRing.closedPoint _)).mp hle
    rw [Scheme.fromSpecStalk_closedPoint] at h2
    exact hpZ h2
  · apply L3 _ τ L2 hτ
    intro Q hQ
    rw [L1 ⟨Q, hQ⟩]
    obtain ⟨hsp, hiff⟩ := GEN S p ⟨Q, hQ⟩
    exact (hcrit _ hsp).trans (hiff τ)

theorem wcpa_dj_bkle_principal_cover : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] [CompactSpace X]
    (m : ℕ) (I : Fin m → X.IdealSheafData),
    (∀ (j : Fin m) (U : X.affineOpens) (x : X) (hx : x ∈ U.1), ∃ g : X.presheaf.stalk x,
      Ideal.map (X.presheaf.germ U.1 x hx).hom ((I j).ideal U) = Ideal.span {g}) →
    ∃ (r : ℕ) (V : Fin r → X.affineOpens) (h : ∀ ν, Fin m → Γ(X, (V ν).1)),
      (∀ x : X, ∃ ν, x ∈ (V ν).1) ∧ ∀ ν j, (I j).ideal (V ν) = Ideal.span {h ν j} :=
by
  intro X _ _ m I hI
  classical

  have s1 : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S] (M : Submonoid A)
      [IsLocalization M S] (J : Ideal A) (g : S), J.FG →
      Ideal.map (algebraMap A S) J = Ideal.span {g} → ∃ a ∈ J, ∃ σ ∈ M, ∀ b ∈ J, a ∣ σ * b := by
    intro A S _ _ _ M _ J g hJ hg
    have hgmem : g ∈ Ideal.map (algebraMap A S) J := hg ▸ Ideal.mem_span_singleton_self g
    obtain ⟨⟨⟨a, ha⟩, ⟨s₀, hs₀⟩⟩, hx⟩ := (IsLocalization.mem_map_algebraMap_iff M S).mp hgmem
    simp only at hx
    have key : ∀ b ∈ J, ∃ τ ∈ M, a ∣ τ * b := by
      intro b hb
      have hbm : algebraMap A S b ∈ Ideal.span {g} := hg ▸ Ideal.mem_map_of_mem _ hb
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hbm
      obtain ⟨u, hu⟩ := IsLocalization.map_units S (⟨s₀, hs₀⟩ : M)
      obtain ⟨⟨b', w⟩, hw⟩ := IsLocalization.surj M (c * ↑u⁻¹)
      simp only at hw
      have e1 : algebraMap A S (↑w * b) = algebraMap A S (b' * a) := by
        rw [map_mul, map_mul, ← hc, ← hx, ← hw]
        simp only at hu
        rw [← hu]
        have hinv : (↑u⁻¹ : S) * ↑u = 1 := Units.inv_mul u
        linear_combination (-(c * g * algebraMap A S ↑w)) * hinv
      obtain ⟨e, he⟩ := (IsLocalization.eq_iff_exists M S).mp e1
      refine ⟨↑e * ↑w, M.mul_mem e.2 w.2, Dvd.intro (↑e * b') ?_⟩
      linear_combination -he
    choose! τ hτM hτ using key
    obtain ⟨T, hT⟩ := hJ
    have hTJ : ∀ s ∈ T, s ∈ J := fun s hs => hT ▸ Submodule.subset_span hs
    refine ⟨a, ha, ∏ s ∈ T, τ s, M.prod_mem (fun s hs => hτM s (hTJ s hs)), ?_⟩
    intro b hb
    rw [← hT] at hb
    induction hb using Submodule.span_induction with
    | mem x hx =>
      exact (hτ x (hTJ x hx)).trans (mul_dvd_mul_right (Finset.dvd_prod_of_mem τ hx) x)
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact dvd_add hx hy
    | smul c x _ hx => rw [smul_eq_mul, mul_left_comm]; exact hx.mul_left c

  have s3 : ∀ (U : X.affineOpens) (x : X) (hx : x ∈ U.1), ∃ σ : Γ(X, U.1),
      x ∈ X.basicOpen σ ∧ ∀ j, ∃ a ∈ (I j).ideal U, ∀ b ∈ (I j).ideal U, a ∣ σ * b := by
    intro U x hx
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hx⟩ : U.1)
    haveI := U.2.isLocalization_stalk ⟨x, hx⟩
    have halg := TopCat.Presheaf.stalk_open_algebraMap X.presheaf (⟨x, hx⟩ : U.1)
    haveI := IsLocallyNoetherian.component_noetherian U
    have hj : ∀ j, ∃ a ∈ (I j).ideal U,
        ∃ σ ∈ (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl, ∀ b ∈ (I j).ideal U, a ∣ σ * b := by
      intro j
      obtain ⟨g, hg⟩ := hI j U x hx
      exact s1 Γ(X, U.1) (X.presheaf.stalk x) _ ((I j).ideal U) g (IsNoetherian.noetherian _)
        (by rw [halg]; exact hg)
    choose a ha σ hσ hdiv using hj
    refine ⟨∏ j, σ j, ?_, fun j => ⟨a j, ha j, fun b hb => (hdiv j b hb).trans
      (mul_dvd_mul_right (Finset.dvd_prod_of_mem σ (Finset.mem_univ j)) b)⟩⟩
    rw [Scheme.mem_basicOpen X _ x hx]
    have hmem : ∏ j, σ j ∈ (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl :=
      Submonoid.prod_mem _ (fun j _ => hσ j)
    have hunit := IsLocalization.map_units (X.presheaf.stalk x)
      (⟨_, hmem⟩ : (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl)
    rw [halg] at hunit
    exact hunit

  have s4 : ∀ (U : X.affineOpens) (J : X.IdealSheafData) (a σ : Γ(X, U.1)), a ∈ J.ideal U →
      (∀ b ∈ J.ideal U, a ∣ σ * b) → J.ideal (X.affineBasicOpen σ) =
        Ideal.span {(X.presheaf.map (homOfLE (X.basicOpen_le σ)).op).hom a} := by
    intro U J a σ ha hdiv
    have s2 : ∀ {A B : Type u} [CommRing A] [CommRing B] (ρ : A →+* B) (K : Ideal A) (a σ : A),
        a ∈ K → IsUnit (ρ σ) → (∀ b ∈ K, a ∣ σ * b) → Ideal.map ρ K = Ideal.span {ρ a} := by
      intro A B _ _ ρ K a σ ha hu hdiv
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, Ideal.mem_span_singleton]
        have h1 := map_dvd ρ (hdiv b hb)
        rw [map_mul] at h1
        exact hu.dvd_mul_left.mp h1
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_map_of_mem _ ha
    rw [← J.map_ideal_basicOpen U σ]
    exact s2 _ _ a σ ha (RingedSpace.isUnit_res_basicOpen X.toRingedSpace σ) hdiv

  have hloc : ∀ x : X, ∃ (U : X.affineOpens) (σ : Γ(X, U.1)), x ∈ X.basicOpen σ ∧
      ∀ j, ∃ a : Γ(X, (X.affineBasicOpen σ).1),
        (I j).ideal (X.affineBasicOpen σ) = Ideal.span {a} := by
    intro x
    obtain ⟨U', hU', hxU', -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
      (show x ∈ (⊤ : X.Opens) from trivial)
    obtain ⟨σ, hxσ, hj⟩ := s3 ⟨U', hU'⟩ x hxU'
    refine ⟨⟨U', hU'⟩, σ, hxσ, fun j => ?_⟩
    obtain ⟨a, ha, hdiv⟩ := hj j
    exact ⟨_, s4 _ (I j) a σ ha hdiv⟩
  choose U σ hxσ hgen using hloc
  choose hh hhgen using hgen
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun x => (X.basicOpen (σ x) : Set X)) (fun x => (X.basicOpen (σ x)).isOpen)
    (fun y _ => Set.mem_iUnion.mpr ⟨y, hxσ y⟩)
  refine ⟨t.card, fun ν => X.affineBasicOpen (σ (t.equivFin.symm ν).1),
    fun ν j => hh _ j, ?_, fun ν j => hhgen _ j⟩
  intro x
  have hx := ht (Set.mem_univ x)
  rw [Set.mem_iUnion₂] at hx
  obtain ⟨y, hy, hxy⟩ := hx
  refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
  have e : t.equivFin.symm (t.equivFin ⟨y, hy⟩) = ⟨y, hy⟩ := Equiv.symm_apply_apply _ _
  show x ∈ ((X.affineBasicOpen (σ (t.equivFin.symm (t.equivFin ⟨y, hy⟩)).1)).1 : Set X)
  rw [e, Scheme.affineBasicOpen_coe]
  exact hxy

theorem wcpa_dj_bk_local_equations : ∀ (k : Type u) [Field k] [Finite k] (S : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) (mD : ℕ) (Dc : Fin mD → Set S),
    wcpaDjIsProjOver k sS → (∀ s : S, IsRegularLocalRing (S.presheaf.stalk s)) →
    wcpaDjSNCComps S mD Dc →
    (∃ p₀ : S, ∀ i, p₀ ∉ Dc i) ∧
    ∃ (r : ℕ) (V : Fin r → S.affineOpens) (h : ∀ ν, Fin mD → Γ(S, (V ν).1)),
      (∀ x : S, ∃ ν, x ∈ (V ν).1) ∧
      (∀ ν i (x : S) (hx : x ∈ (V ν).1), (S.presheaf.germ (V ν).1 x hx).hom (h ν i) ≠ 0) ∧
      (∀ ν ν' i (x : S) (hx : x ∈ (V ν).1) (hx' : x ∈ (V ν').1),
        Ideal.span {(S.presheaf.germ (V ν).1 x hx).hom (h ν i)} =
          Ideal.span {(S.presheaf.germ (V ν').1 x hx').hom (h ν' i)}) ∧
      (∀ ν i (p : S) (hp : p ∈ (V ν).1),
        (S.presheaf.germ (V ν).1 p hp).hom (h ν i) ∈
          IsLocalRing.maximalIdeal (S.presheaf.stalk p) → p ∈ Dc i) ∧
      (∀ ν i (p : S) (hp : p ∈ (V ν).1), p ∈ Dc i →
        ∀ (n : ℕ) (t : Fin n → S.presheaf.stalk p) (j : Fin n),
          (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk p) →
          Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk p) →
          (∀ (p' : S) (hsp : p' ⤳ p), p' ∈ Dc i ↔
            (S.presheaf.stalkSpecializes hsp).hom (t j) ∈
              IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
          Associated ((S.presheaf.germ (V ν).1 p hp).hom (h ν i)) (t j)) :=
by
  intro k _ _ S _ sS mD Dc hproj hreg hsnc
  obtain ⟨hcl, hloc⟩ := hsnc

  have hG0 : ∀ i, genericPoint S ∉ Dc i := by
    intro i hi
    obtain ⟨n, t, hn, _, a, _, _⟩ := hloc (genericPoint S)
    have h0 : ringKrullDim (S.presheaf.stalk (genericPoint S)) = 0 := ringKrullDim_eq_zero_of_field _
    rw [h0] at hn
    have hn0 : n = 0 := by exact_mod_cast hn
    subst hn0
    exact (a ⟨i, hi⟩).elim0

  haveI : IsProper sS := wcpa_dj_proj_proper k sS hproj
  haveI : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace sS
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian sS

  have K1 : ∀ (i : Fin mD) (U : S.affineOpens) (x : S) (hx : x ∈ U.1), x ∉ Dc i →
      Ideal.map (S.presheaf.germ U.1 x hx).hom
        ((Scheme.IdealSheafData.vanishingIdeal ⟨Dc i, hcl i⟩).ideal U) = ⊤ :=
    fun i U x hx hxi => (wcpa_dj_bkle_vanishing_stalk S (Dc i) (hcl i) U x hx).1 hxi
  have K3 : ∀ (i : Fin mD) (U : S.affineOpens) (x : S) (hx : x ∈ U.1)
      (n : ℕ) (t : Fin n → S.presheaf.stalk x) (j : Fin n),
      (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk x) →
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk x) →
      (∀ (p' : S) (hsp : p' ⤳ x), p' ∈ Dc i ↔
        (S.presheaf.stalkSpecializes hsp).hom (t j) ∈
          IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
      Ideal.map (S.presheaf.germ U.1 x hx).hom
        ((Scheme.IdealSheafData.vanishingIdeal ⟨Dc i, hcl i⟩).ideal U) = Ideal.span {t j} := by
    intro i U x hx n t j hn hspan hcrit
    haveI := hreg x
    have hp : Prime (t j) := wcpa_dj_bkle_regular_param_prime _ n t hn hspan j
    exact (wcpa_dj_bkle_vanishing_stalk S (Dc i) (hcl i) U x hx).2 (t j) hp hcrit
  have hprime : ∀ (x : S) (n : ℕ) (t : Fin n → S.presheaf.stalk x) (j : Fin n),
      (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk x) →
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk x) → Prime (t j) := by
    intro x n t j hn hspan
    haveI := hreg x
    exact wcpa_dj_bkle_regular_param_prime _ n t hn hspan j

  obtain ⟨r, V, h, hcov, hgen⟩ := wcpa_dj_bkle_principal_cover S mD
    (fun i => Scheme.IdealSheafData.vanishingIdeal ⟨Dc i, hcl i⟩) (by
      intro j U x hx
      by_cases hxj : x ∈ Dc j
      · obtain ⟨n, t, hn, hspan, a, _, hcrit⟩ := hloc x
        exact ⟨t (a ⟨j, hxj⟩), K3 j U x hx n t _ hn hspan (hcrit ⟨j, hxj⟩)⟩
      · exact ⟨1, by rw [Ideal.span_singleton_one]; exact K1 j U x hx hxj⟩)
  have hdag : ∀ ν i (x : S) (hx : x ∈ (V ν).1),
      Ideal.map (S.presheaf.germ (V ν).1 x hx).hom
        ((Scheme.IdealSheafData.vanishingIdeal ⟨Dc i, hcl i⟩).ideal (V ν)) =
        Ideal.span {(S.presheaf.germ (V ν).1 x hx).hom (h ν i)} := by
    intro ν i x hx
    rw [hgen ν i, Ideal.map_span, Set.image_singleton]
  refine ⟨⟨genericPoint S, hG0⟩, r, V, h, hcov, ?_, ?_, ?_, ?_⟩
  ·
    intro ν i x hx h0
    have e := hdag ν i x hx
    rw [h0] at e
    by_cases hxi : x ∈ Dc i
    · obtain ⟨n, t, hn, hspan, a, _, hcrit⟩ := hloc x
      have e2 := K3 i (V ν) x hx n t (a ⟨i, hxi⟩) hn hspan (hcrit ⟨i, hxi⟩)
      rw [e] at e2
      have hp := hprime x n t (a ⟨i, hxi⟩) hn hspan
      apply hp.ne_zero
      have hmem : t (a ⟨i, hxi⟩) ∈ Ideal.span {(0 : S.presheaf.stalk x)} :=
        e2 ▸ Ideal.mem_span_singleton_self _
      rw [Ideal.mem_span_singleton, zero_dvd_iff] at hmem
      exact hmem
    · have e2 := K1 i (V ν) x hx hxi
      rw [e, Ideal.span_singleton_eq_top] at e2
      exact not_isUnit_zero e2
  ·
    intro ν ν' i x hx hx'
    rw [← hdag ν i x hx, ← hdag ν' i x hx']
    by_cases hxi : x ∈ Dc i
    · obtain ⟨n, t, hn, hspan, a, _, hcrit⟩ := hloc x
      rw [K3 i (V ν) x hx n t (a ⟨i, hxi⟩) hn hspan (hcrit ⟨i, hxi⟩),
        K3 i (V ν') x hx' n t (a ⟨i, hxi⟩) hn hspan (hcrit ⟨i, hxi⟩)]
    · rw [K1 i (V ν) x hx hxi, K1 i (V ν') x hx' hxi]
  ·
    intro ν i p hp hm
    by_contra hpi
    have e := K1 i (V ν) p hp hpi
    rw [hdag, Ideal.span_singleton_eq_top] at e
    exact (IsLocalRing.mem_maximalIdeal _).mp hm e
  ·
    intro ν i p hp _ n t j hn hspan hcrit
    have e := K3 i (V ν) p hp n t j hn hspan hcrit
    rw [hdag] at e
    exact Ideal.span_singleton_eq_span_singleton.mp e

theorem wcpa_dj_bkp_glue : ∀ (S : Scheme.{u}) [S.IsSeparated] (mD B r : ℕ)
    (V : Fin r → S.affineOpens) (h : ∀ ν, Fin mD → Γ(S, (V ν).1)),
    (∀ ν ν' i (x : S) (hx : x ∈ (V ν).1) (hx' : x ∈ (V ν').1),
      Ideal.span {(S.presheaf.germ (V ν).1 x hx).hom (h ν i)} =
        Ideal.span {(S.presheaf.germ (V ν').1 x hx').hom (h ν' i)}) →
    ∃ 𝔞 : S.IdealSheafData, ∀ (U : S.affineOpens) (ν : Fin r) (x : S) (hxU : x ∈ U.1)
      (hxV : x ∈ (V ν).1),
      Ideal.map (S.presheaf.germ U.1 x hxU).hom (𝔞.ideal U) =
        wcpaDjBkPairIdeal (S.presheaf.stalk x) mD
          (fun i => (S.presheaf.germ (V ν).1 x hxV).hom (h ν i)) B :=
by
  intro S _ mD B r V h hcompat
  classical

  have hmapPI : ∀ (R T : Type u) [CommRing R] [CommRing T] (φ : R →+* T) (m : ℕ)
      (x : Fin m → R) (B : ℕ),
      Ideal.map φ (wcpaDjBkPairIdeal R m x B) = wcpaDjBkPairIdeal T m (fun i => φ (x i)) B := by
    intro R T _ _ φ m x B
    unfold wcpaDjBkPairIdeal
    rw [← Ideal.mapHom_apply, map_prod]
    refine Finset.prod_congr rfl (fun ΓΓ _ => ?_)
    rw [Ideal.mapHom_apply, Ideal.map_span, Set.image_pair, map_prod, map_prod]
    simp only [map_pow]

  have hspan : ∀ (R : Type u) [CommRing R] (m : ℕ) (x y : Fin m → R) (B : ℕ),
      (∀ i, Ideal.span {x i} = Ideal.span {y i}) →
      wcpaDjBkPairIdeal R m x B = wcpaDjBkPairIdeal R m y B := by
    intro R _ m x y B hxy
    have hd : ∀ n : Fin m → ℕ, Ideal.span {∏ i, x i ^ n i} = Ideal.span {∏ i, y i ^ n i} := by
      intro n
      apply le_antisymm
      · rw [Ideal.span_singleton_le_span_singleton]
        apply Finset.prod_dvd_prod_of_dvd
        intro i _
        apply pow_dvd_pow_of_dvd
        exact Ideal.span_singleton_le_span_singleton.mp (le_of_eq (hxy i))
      · rw [Ideal.span_singleton_le_span_singleton]
        apply Finset.prod_dvd_prod_of_dvd
        intro i _
        apply pow_dvd_pow_of_dvd
        exact Ideal.span_singleton_le_span_singleton.mp (le_of_eq (hxy i).symm)
    unfold wcpaDjBkPairIdeal
    refine Finset.prod_congr rfl (fun ΓΓ _ => ?_)
    rw [Ideal.span_insert, Ideal.span_insert, hd (fun i => (ΓΓ.1 i : ℕ)),
      hd (fun i => (ΓΓ.2 i : ℕ))]

  obtain ⟨P, hP⟩ : ∃ P : ∀ ν, Ideal Γ(S, (V ν).1),
      ∀ ν, P ν = wcpaDjBkPairIdeal Γ(S, (V ν).1) mD (h ν) B := ⟨_, fun _ => rfl⟩
  have hPx : ∀ ν (x : S) (hx : x ∈ (V ν).1),
      Ideal.map (S.presheaf.germ (V ν).1 x hx).hom (P ν) =
        wcpaDjBkPairIdeal (S.presheaf.stalk x) mD
          (fun i => (S.presheaf.germ (V ν).1 x hx).hom (h ν i)) B := by
    intro ν x hx
    rw [hP, hmapPI]

  have hJ : ∀ ν ν' (x : S) (hx : x ∈ (V ν).1) (hx' : x ∈ (V ν').1),
      Ideal.map (S.presheaf.germ (V ν).1 x hx).hom (P ν) =
        Ideal.map (S.presheaf.germ (V ν').1 x hx').hom (P ν') := by
    intro ν ν' x hx hx'
    rw [hPx, hPx]
    exact hspan _ mD _ _ B (fun i => hcompat ν ν' i x hx hx')

  have gres : ∀ {W W' : S.Opens} (i : W' ⟶ W) (y : S) (hy : y ∈ W') (hy' : y ∈ W)
      (a : Γ(S, W)),
      (S.presheaf.germ W' y hy).hom ((S.presheaf.map i.op).hom a) =
        (S.presheaf.germ W y hy').hom a := by
    intro W W' i y hy hy' a
    have := congrArg (fun φ => φ.hom a) (S.presheaf.germ_res i y hy)
    exact this
  have gmap : ∀ {W W' : S.Opens} (i : W' ⟶ W) (y : S) (hy : y ∈ W') (hy' : y ∈ W)
      (Q : Ideal Γ(S, W)),
      Ideal.map (S.presheaf.germ W' y hy).hom (Ideal.map (S.presheaf.map i.op).hom Q) =
        Ideal.map (S.presheaf.germ W y hy').hom Q := by
    intro W W' i y hy hy' Q
    rw [Ideal.map_map]
    congr 1
    exact RingHom.ext fun a => gres i y hy hy' a

  have hrad : ∀ (A : Type u) [CommRing A] (Q : Ideal A) (f b : A),
      (∀ J : Ideal A, J.IsPrime → f ∉ J → ∃ s, s ∉ J ∧ s * b ∈ Q) →
      ∃ N : ℕ, f ^ N * b ∈ Q := by
    intro A _ Q f b H
    let C : Ideal A :=
      { carrier := {x | x * b ∈ Q}
        add_mem' := fun {x y} hx hy => by
          simp only [Set.mem_setOf_eq, add_mul] at *
          exact Q.add_mem hx hy
        zero_mem' := by simp
        smul_mem' := fun c x hx => by
          simp only [Set.mem_setOf_eq, smul_eq_mul, mul_assoc] at *
          exact Q.mul_mem_left c hx }
    have hf : f ∈ C.radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hCJ, hJp⟩
      by_contra hfJ
      obtain ⟨s, hs, hsb⟩ := H J hJp hfJ
      exact hs (hCJ hsb)
    obtain ⟨N, hN⟩ := hf
    exact ⟨N, hN⟩

  have hloc : ∀ (W : S.Opens), IsAffineOpen W → ∀ (Q : Ideal Γ(S, W)) (f b : Γ(S, W)),
      (∀ (y : S) (hy : y ∈ W), y ∈ S.basicOpen f →
        (S.presheaf.germ W y hy).hom b ∈ Ideal.map (S.presheaf.germ W y hy).hom Q) →
      ∃ N : ℕ, f ^ N * b ∈ Q := by
    intro W hW Q f b H
    apply hrad
    intro J hJ hfJ
    let 𝔮 : PrimeSpectrum Γ(S, W) := ⟨J, hJ⟩
    have hy : hW.fromSpec 𝔮 ∈ W := by
      rw [← SetLike.mem_coe, ← hW.range_fromSpec]
      exact ⟨𝔮, rfl⟩
    have hL := hW.isLocalization_stalk' 𝔮 hy
    letI := TopCat.Presheaf.algebra_section_stalk S.presheaf ⟨hW.fromSpec 𝔮, hy⟩
    have hfu : IsUnit ((S.presheaf.germ W _ hy).hom f) :=
      @IsLocalization.map_units _ _ _ _ _ _ hL ⟨f, hfJ⟩
    have hb := H _ hy ((S.mem_basicOpen f _ hy).mpr hfu)
    obtain ⟨⟨q, t⟩, hqt⟩ := (@IsLocalization.mem_map_algebraMap_iff _ _ _ _ _ _ hL _ _).mp hb
    have hqt' : algebraMap Γ(S, W) (S.presheaf.stalk (hW.fromSpec 𝔮)) (b * t.1) =
        algebraMap Γ(S, W) (S.presheaf.stalk (hW.fromSpec 𝔮)) q.1 := by
      rw [map_mul]; exact hqt
    obtain ⟨c, hc⟩ := (@IsLocalization.eq_iff_exists _ _ _ _ _ _ hL _ _).mp hqt'
    refine ⟨c.1 * t.1, ?_, ?_⟩
    · exact 𝔮.asIdeal.primeCompl.mul_mem c.2 t.2
    · have e : c.1 * t.1 * b = c.1 * (b * t.1) := by ring
      rw [e, hc]
      exact Q.mul_mem_left _ q.2

  obtain ⟨Fo, hFo⟩ : ∃ Fo : ∀ W : S.Opens, Ideal Γ(S, W), ∀ (W : S.Opens) (a : Γ(S, W)),
      a ∈ Fo W ↔ ∀ (y : S) (hy : y ∈ W) (ν : Fin r) (hyν : y ∈ (V ν).1),
        (S.presheaf.germ W y hy).hom a ∈ Ideal.map (S.presheaf.germ (V ν).1 y hyν).hom (P ν) := by
    refine ⟨fun W => ⨅ (y : S) (hy : y ∈ W) (ν : Fin r) (hyν : y ∈ (V ν).1),
      Ideal.comap (S.presheaf.germ W y hy).hom
        (Ideal.map (S.presheaf.germ (V ν).1 y hyν).hom (P ν)), ?_⟩
    intro W a
    simp only [Submodule.mem_iInf, Ideal.mem_comap]

  have hbo : ∀ (U : S.affineOpens) (f : Γ(S, U.1)),
      Ideal.map (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom (Fo U.1) =
        Fo (S.basicOpen f) := by
    intro U f
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, hFo]
      intro y hy ν hyν
      rw [gres (homOfLE (S.basicOpen_le f)) y hy (S.basicOpen_le f hy)]
      exact (hFo _ a).mp ha y _ ν hyν
    · intro c hc
      haveI := U.2.isLocalization_basicOpen f
      obtain ⟨n, b, hnb⟩ := IsLocalization.Away.surj f c
      have hN : ∀ ν, ∃ N : ℕ, ∀ (y : S) (hy : y ∈ U.1) (hyν : y ∈ (V ν).1),
          (S.presheaf.germ U.1 y hy).hom (f ^ N * b) ∈
            Ideal.map (S.presheaf.germ (V ν).1 y hyν).hom (P ν) := by
        intro ν
        have hW : IsAffineOpen (U.1 ⊓ (V ν).1) := U.2.inf (V ν).2
        let ιU : U.1 ⊓ (V ν).1 ⟶ U.1 := homOfLE inf_le_left
        let ιV : U.1 ⊓ (V ν).1 ⟶ (V ν).1 := homOfLE inf_le_right
        have hcond : ∀ (y : S) (hyW : y ∈ U.1 ⊓ (V ν).1),
            y ∈ S.basicOpen ((S.presheaf.map ιU.op).hom f) →
            (S.presheaf.germ _ y hyW).hom ((S.presheaf.map ιU.op).hom b) ∈
              Ideal.map (S.presheaf.germ _ y hyW).hom
                (Ideal.map (S.presheaf.map ιV.op).hom (P ν)) := by
          intro y hyW hyD'
          have hyU : y ∈ U.1 := hyW.1
          have hyν : y ∈ (V ν).1 := hyW.2
          have hyD : y ∈ S.basicOpen f := by
            refine (S.mem_basicOpen f y hyU).mpr ?_
            rw [← gres ιU y hyW hyU f]
            exact (S.mem_basicOpen _ y hyW).mp hyD'
          rw [gmap ιV y hyW hyν, gres ιU y hyW hyU]
          have e : (S.presheaf.germ U.1 y hyU).hom b =
              (S.presheaf.germ (S.basicOpen f) y hyD).hom c *
                ((S.presheaf.germ (S.basicOpen f) y hyD).hom
                  (algebraMap Γ(S, U.1) Γ(S, S.basicOpen f) f)) ^ n := by
            rw [← map_pow, ← map_mul, hnb]
            exact (gres (homOfLE (S.basicOpen_le f)) y hyD hyU b).symm
          rw [e]
          exact Ideal.mul_mem_right _ _ ((hFo _ c).mp hc y hyD ν hyν)
        obtain ⟨N, hN⟩ := hloc _ hW (Ideal.map (S.presheaf.map ιV.op).hom (P ν))
          ((S.presheaf.map ιU.op).hom f) ((S.presheaf.map ιU.op).hom b) hcond
        refine ⟨N, fun y hy hyν => ?_⟩
        have hyW : y ∈ U.1 ⊓ (V ν).1 := ⟨hy, hyν⟩
        have e1 : (S.presheaf.germ U.1 y hy).hom (f ^ N * b) =
            (S.presheaf.germ _ y hyW).hom
              ((S.presheaf.map ιU.op).hom f ^ N * (S.presheaf.map ιU.op).hom b) := by
          rw [← map_pow, ← map_mul, gres ιU y hyW hy]
        rw [e1, ← gmap ιV y hyW hyν]
        exact Ideal.mem_map_of_mem _ hN
      choose N hN using hN
      have hM : f ^ (∑ ν, N ν) * b ∈ Fo U.1 := by
        rw [hFo]
        intro y hy ν hyν
        have hle : N ν ≤ ∑ ν, N ν :=
          Finset.single_le_sum (fun i _ => Nat.zero_le (N i)) (Finset.mem_univ ν)
        have e : f ^ (∑ ν, N ν) * b = f ^ (∑ ν, N ν - N ν) * (f ^ N ν * b) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
        rw [e, map_mul]
        exact Ideal.mul_mem_left _ _ (hN ν y hy hyν)
      have hres : (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom (f ^ (∑ ν, N ν) * b) =
          c * (algebraMap Γ(S, U.1) Γ(S, S.basicOpen f) f) ^ (∑ ν, N ν + n) := by
        rw [map_mul, map_pow]
        show (algebraMap Γ(S, U.1) Γ(S, S.basicOpen f)) f ^ (∑ ν, N ν) *
          (algebraMap Γ(S, U.1) Γ(S, S.basicOpen f)) b = _
        rw [← hnb]
        ring
      have hmem := Ideal.mem_map_of_mem (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom hM
      rw [hres] at hmem
      exact (Ideal.mul_unit_mem_iff_mem _
        ((IsLocalization.Away.algebraMap_isUnit f).pow _)).mp hmem

  have hstalk : ∀ (U : S.affineOpens) (ν : Fin r) (x : S) (hxU : x ∈ U.1) (hxV : x ∈ (V ν).1),
      Ideal.map (S.presheaf.germ U.1 x hxU).hom (Fo U.1) =
        Ideal.map (S.presheaf.germ (V ν).1 x hxV).hom (P ν) := by
    intro U ν x hxU hxV
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      exact (hFo _ a).mp ha x hxU ν hxV
    · rw [Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap]
      obtain ⟨f, hD, hxD⟩ := U.2.exists_basicOpen_le (V := (V ν).1) ⟨x, hxV⟩ hxU
      have hc : (S.presheaf.map (homOfLE hD).op).hom p ∈ Fo (S.basicOpen f) := by
        rw [hFo]
        intro y hy ν' hyν'
        rw [gres (homOfLE hD) y hy (hD hy), ← hJ ν ν' y (hD hy) hyν']
        exact Ideal.mem_map_of_mem _ hp
      rw [← hbo U f] at hc
      have h2 := Ideal.mem_map_of_mem (S.presheaf.germ (S.basicOpen f) x hxD).hom hc
      rw [gmap (homOfLE (S.basicOpen_le f)) x hxD hxU, gres (homOfLE hD) x hxD hxV] at h2
      exact h2

  refine ⟨Scheme.IdealSheafData.mk (fun U => Fo U.1) (fun U f => hbo U f)
    (⋂ U : S.affineOpens, S.zeroLocus ((Fo U.1 : Ideal Γ(S, U.1)) : Set Γ(S, U.1))), ?_⟩
  intro U ν x hxU hxV
  show Ideal.map (S.presheaf.germ U.1 x hxU).hom (Fo U.1) = _
  rw [hstalk U ν x hxU hxV, hPx]

theorem wcpa_dj_bkp_blowup : ∀ (k : Type u) [Field k] (S : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) (𝔞 : S.IdealSheafData),
    wcpaDjIsProjOver k sS → genericPoint S ∉ (𝔞.support : Set S) →
    ∃ (S₃ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S₃) (σ : S₃ ⟶ S),
      wcpaDjIsProjOver k (σ ≫ sS) ∧ IsProper σ ∧ Surjective σ ∧
      (∃ V' : S.Opens, V' ≠ ⊥ ∧ IsFinite (σ ∣_ V')) ∧
      ∀ (Z : Scheme.{u}) (ρ : Z ⟶ S) (ψ : Z ⟶ S₃), ψ ≫ σ = ρ → ∀ z : Z,
        ∃ (U : S.affineOpens) (hU : ρ z ∈ U.1),
          (Ideal.map ((S.presheaf.germ U.1 (ρ z) hU) ≫ ρ.stalkMap z).hom (𝔞.ideal U)).IsPrincipal :=
by
  intro k _ S _ sS 𝔞 hproj hη
  classical
  haveI hsSp : IsProper sS := wcpa_dj_proj_proper k sS hproj

  have hproj' := hproj
  obtain ⟨N, j, hj, -⟩ := hproj'
  haveI := hj
  obtain ⟨m, g, w, hgen, hunit, hcoc⟩ := wc_csd_blowup_chart_generators k N S j 𝔞 hj
  have hUa : ∀ J, IsAffineOpen (j ⁻¹ᵁ wcSgD k N J) := fun J =>
    IsAffineOpen.preimage (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k J))
      one_pos) j
  have hcover : (⨆ J, j ⁻¹ᵁ wcSgD k N J) = ⊤ := by
    have h0 : (⨆ J, wcSgD k N J) = ⊤ := wc_pp_basicOpen_cover k N
    rw [← Scheme.Hom.preimage_iSup, h0, Scheme.Hom.preimage_top]
  obtain ⟨P, r, ιb, hιb, hιbr, hbl⟩ := wc_csd_blowup_model k S sS 𝔞 N m
    (fun J => j ⁻¹ᵁ wcSgD k N J) hUa g w hcover (fun J => hgen J (hUa J)) hunit hcoc
  haveI := hιb

  haveI := wc_proj_space_isProper k m
  haveI hrp : IsProper r := by rw [← hιbr]; infer_instance

  obtain ⟨U₀, hU₀def⟩ : ∃ U : S.Opens, U = 𝔞.support.compl := ⟨_, rfl⟩
  have hU₀coe : (U₀ : Set S) = ((𝔞.support : Set S))ᶜ := by
    rw [hU₀def, TopologicalSpace.Closeds.coe_compl]
  have hηU : genericPoint S ∈ (U₀ : Set S) := by rw [hU₀coe]; exact hη
  have hU₀ : U₀ ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hηU⟩
  haveI hiso : IsIso (r ∣_ U₀) := wc_csd_blowup_iso_off_center S P 𝔞 r U₀ hbl
    (by rw [hU₀coe]; exact Set.inter_compl_self _)

  obtain ⟨t₀, -⟩ := (r ∣_ U₀).surjective ⟨_, hηU⟩
  haveI : Nonempty (r ⁻¹ᵁ U₀).toScheme := ⟨t₀⟩
  haveI hTint : AlgebraicGeometry.IsIntegral (r ⁻¹ᵁ U₀).toScheme :=
    isIntegral_of_isOpenImmersion ((r ∣_ U₀) ≫ U₀.ι)
  obtain ⟨S₃, hS₃, ι, hι, hTsub, hιiso⟩ := wcpa_dj_sst_closure_subscheme P (r ⁻¹ᵁ U₀) hTint
  haveI := hS₃
  haveI := hι
  haveI := hιiso
  haveI hσiso : IsIso ((ι ≫ r) ∣_ U₀) := by
    rw [morphismRestrict_comp]; exact IsIso.comp_isIso' hιiso hiso
  have hsub : (U₀ : Set S) ⊆ Set.range ⇑(ι ≫ r) := by
    intro u hu
    obtain ⟨w', hw'⟩ := (r ∣_ U₀).surjective ⟨u, hu⟩
    have hw1 : r w'.1 = u := by
      have := congrArg Subtype.val hw'
      rw [morphismRestrict_base_coe] at this
      exact this
    obtain ⟨y, hy⟩ := hTsub w'.2
    exact ⟨y, by rw [Scheme.Hom.comp_apply, hy, hw1]⟩
  have hsurj : Surjective (ι ≫ r) := by
    have hcl : IsClosed (Set.range ⇑(ι ≫ r)) := (ι ≫ r).isClosedMap.isClosed_range
    have hd : Dense (U₀ : Set S) := U₀.isOpen.dense ⟨_, hηU⟩
    have hc : closure (U₀ : Set S) ⊆ Set.range ⇑(ι ≫ r) := hcl.closure_subset_iff.mpr hsub
    rw [hd.closure_eq] at hc
    exact ⟨fun x => hc (Set.mem_univ x)⟩

  have hPk : wcpaDjIsProjOver k (wcProjKStr k m ≫ 𝟙 (Spec (.of k))) := by
    unfold wcpaDjIsProjOver
    exact ⟨m, 𝟙 _, inferInstance, by rw [Category.id_comp, Category.comp_id]⟩
  have hP8 := wcpa_dj_ssm_proj_fibre_product k S (Spec (.of k)) (wcProjK k m) S₃ (𝟙 _) sS
    (wcProjKStr k m) (ι ≫ ιb) inferInstance (by rwa [Category.comp_id]) hPk inferInstance
  have heq : (ι ≫ ιb) ≫ Limits.pullback.snd sS (wcProjKStr k m) ≫ wcProjKStr k m ≫
      𝟙 (Spec (.of k)) = (ι ≫ r) ≫ sS := by
    rw [Category.comp_id, ← Limits.pullback.condition, ← hιbr]
    simp only [Category.assoc]
  rw [heq] at hP8

  have key : ∀ (Z : Scheme.{u}) (φ : Z ⟶ P) (z : Z), ∃ (U : S.affineOpens)
      (hU : (φ ≫ r) z ∈ U.1),
      (Ideal.map ((S.presheaf.germ U.1 ((φ ≫ r) z) hU) ≫ (φ ≫ r).stalkMap z).hom
        (𝔞.ideal U)).IsPrincipal := by
    intro Z φ z
    obtain ⟨U, V, hVU, a, ht, -, -, hspan⟩ := hbl.1 (φ z)
    have hU : (φ ≫ r) z ∈ U.1 := hVU ht
    refine ⟨U, hU, ?_⟩
    have hfac : (S.presheaf.germ U.1 ((φ ≫ r) z) hU) ≫ (φ ≫ r).stalkMap z =
        r.appLE U V hVU ≫ P.presheaf.germ V.1 (φ z) ht ≫ φ.stalkMap z := by
      rw [Scheme.Hom.stalkMap_comp]
      have e1 := Scheme.Hom.germ_stalkMap r U.1 (φ z) hU
      have e2 := TopCat.Presheaf.germ_res P.presheaf (homOfLE hVU) (φ z) ht
      have e3 : r.appLE U V hVU = r.app U ≫ P.presheaf.map (homOfLE hVU).op := rfl
      rw [e3, Category.assoc, reassoc_of% e2, ← Category.assoc, ← e1, Category.assoc]
      rfl
    rw [hfac, CommRingCat.hom_comp, ← Ideal.map_map, hspan, Ideal.map_span, Set.image_singleton]
    exact ⟨⟨_, rfl⟩⟩
  refine ⟨S₃, hS₃, ι ≫ r, hP8, inferInstance, hsurj, ⟨U₀, hU₀, inferInstance⟩, ?_⟩
  intro Z ρ ψ hψ z
  subst hψ
  rw [← Category.assoc]
  exact key Z (ψ ≫ ι) z

theorem wcpa_dj_bk_principalize : ∀ (k : Type u) [Field k] [Finite k] (S : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) (mD B r : ℕ)
    (V : Fin r → S.affineOpens) (h : ∀ ν, Fin mD → Γ(S, (V ν).1)),
    wcpaDjIsProjOver k sS → (∀ x : S, ∃ ν, x ∈ (V ν).1) →
    (∀ ν i (x : S) (hx : x ∈ (V ν).1), (S.presheaf.germ (V ν).1 x hx).hom (h ν i) ≠ 0) →
    (∀ ν ν' i (x : S) (hx : x ∈ (V ν).1) (hx' : x ∈ (V ν').1),
      Ideal.span {(S.presheaf.germ (V ν).1 x hx).hom (h ν i)} =
        Ideal.span {(S.presheaf.germ (V ν').1 x hx').hom (h ν' i)}) →
    ∃ (S₃ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S₃) (σ : S₃ ⟶ S),
      wcpaDjIsProjOver k (σ ≫ sS) ∧ IsProper σ ∧ Surjective σ ∧
      (∃ V' : S.Opens, V' ≠ ⊥ ∧ IsFinite (σ ∣_ V')) ∧
      ∀ (Z : Scheme.{u}) (ρ : Z ⟶ S) (ψ : Z ⟶ S₃), ψ ≫ σ = ρ →
        ∀ (z : Z) (ν : Fin r) (hz : ρ z ∈ (V ν).1),
          (wcpaDjBkPairIdeal (Z.presheaf.stalk z) mD
            (fun i => (ρ.stalkMap z).hom ((S.presheaf.germ (V ν).1 (ρ z) hz).hom (h ν i)))
            B).IsPrincipal :=
by
  intro k _ _ S _ sS mD B r V h hproj hcov hnz hcompat
  classical

  have hmapPI : ∀ (R T : Type u) [CommRing R] [CommRing T] (φ : R →+* T) (m : ℕ)
      (x : Fin m → R) (B : ℕ),
      Ideal.map φ (wcpaDjBkPairIdeal R m x B) = wcpaDjBkPairIdeal T m (fun i => φ (x i)) B := by
    intro R T _ _ φ m x B
    unfold wcpaDjBkPairIdeal
    rw [← Ideal.mapHom_apply, map_prod]
    refine Finset.prod_congr rfl (fun ΓΓ _ => ?_)
    rw [Ideal.mapHom_apply, Ideal.map_span, Set.image_pair, map_prod, map_prod]
    simp only [map_pow]

  haveI hsSp : IsProper sS := wcpa_dj_proj_proper k sS hproj
  haveI : S.IsSeparated := by
    apply Scheme.IsSeparated.mk
    have e : Limits.terminal.from S = sS ≫ Limits.terminal.from (Spec (.of k)) :=
      Limits.terminal.hom_ext _ _
    haveI : IsSeparated (Limits.terminal.from (Spec (.of k))) :=
      (Scheme.isSeparated_iff _).mp inferInstance
    rw [e]
    infer_instance

  obtain ⟨𝔞, h𝔞⟩ := wcpa_dj_bkp_glue S mD B r V h hcompat

  have hη : genericPoint S ∉ (𝔞.support : Set S) := by
    obtain ⟨ν₀, hν₀⟩ := hcov (genericPoint S)
    intro hmem
    have hmem' := (Scheme.IdealSheafData.mem_support_iff_of_mem hν₀).mp hmem
    rw [Scheme.mem_zeroLocus_iff] at hmem'
    have hle : Ideal.map (S.presheaf.germ (V ν₀).1 (genericPoint S) hν₀).hom (𝔞.ideal (V ν₀)) ≤
        IsLocalRing.maximalIdeal (S.presheaf.stalk (genericPoint S)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact hmem' a ha ((S.mem_basicOpen a _ hν₀).mpr hu)
    rw [h𝔞 (V ν₀) ν₀ _ hν₀ hν₀] at hle
    have hunit : ∀ i, IsUnit ((S.presheaf.germ (V ν₀).1 (genericPoint S) hν₀).hom (h ν₀ i)) := by
      intro i
      letI : Field (S.presheaf.stalk (genericPoint S)) := inferInstanceAs (Field S.functionField)
      exact isUnit_iff_ne_zero.mpr (hnz ν₀ i _ hν₀)
    have htop : wcpaDjBkPairIdeal (S.presheaf.stalk (genericPoint S)) mD
        (fun i => (S.presheaf.germ (V ν₀).1 (genericPoint S) hν₀).hom (h ν₀ i)) B = ⊤ := by
      unfold wcpaDjBkPairIdeal
      rw [← Ideal.one_eq_top]
      apply Finset.prod_eq_one
      intro ΓΓ _
      rw [Ideal.one_eq_top]
      apply Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _))
      exact Finset.prod_induction _ IsUnit (fun a b ha hb => ha.mul hb) isUnit_one
        (fun i _ => (hunit i).pow _)
    rw [htop] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (top_le_iff.mp hle)

  obtain ⟨S₃, iS₃, σ, hσproj, hσp, hσs, hσf, hprin⟩ := wcpa_dj_bkp_blowup k S sS 𝔞 hproj hη
  refine ⟨S₃, iS₃, σ, hσproj, hσp, hσs, hσf, ?_⟩
  intro Z ρ ψ hψ z ν hz
  obtain ⟨U, hU, hP⟩ := hprin Z ρ ψ hψ z
  rw [CommRingCat.hom_comp, ← Ideal.map_map, h𝔞 U ν (ρ z) hU hz, hmapPI] at hP
  exact hP

theorem wcpa_dj_bk_kummer_roots : ∀ (k : Type u) [Field k] [Finite k] (S S₃ : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S₃] (s₃ : S₃ ⟶ Spec (.of k)) [IsProper s₃] (σ : S₃ ⟶ S)
    (mD r d : ℕ) (V : Fin r → S.affineOpens) (h : ∀ ν, Fin mD → Γ(S, (V ν).1)),
    (∀ x : S, ∃ ν, x ∈ (V ν).1) → 1 ≤ d →
    ∃ (S' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S') (β : S' ⟶ S₃),
      IsProper β ∧ Surjective β ∧ (∃ V' : S₃.Opens, V' ≠ ⊥ ∧ IsFinite (β ∣_ V')) ∧
      ∀ (Z : Scheme.{u}) (ρ : Z ⟶ S) (ψ : Z ⟶ S'), ψ ≫ β ≫ σ = ρ →
        ∀ z : Z, ∃ (ν : Fin r) (hz : ρ z ∈ (V ν).1), ∀ i, ∃ Θ : Z.presheaf.stalk z,
          Θ ^ d = (ρ.stalkMap z).hom ((S.presheaf.germ (V ν).1 (ρ z) hz).hom (h ν i)) :=
by
  intro k _ _ S S₃ _ s₃ _ σ mD r d V h hcov hd
  classical
  have hd0 : d ≠ 0 := by omega

  have hroot : ∀ (B : Type u) [CommRing B] (b : B) (m : Multiset B),
      (Polynomial.X ^ d - Polynomial.C b : Polynomial B) =
        (m.map fun c => Polynomial.X - Polynomial.C c).prod → ∃ θ : B, θ ^ d = b := by
    intro B _ b m hm
    rcases Multiset.empty_or_exists_mem m with h0 | ⟨c, hc⟩
    · subst h0
      have h1 := congrArg (fun p => Polynomial.coeff p d) hm
      have h2 : (1 : B) = 0 := by
        simpa [Polynomial.coeff_X_pow, Polynomial.coeff_C, Polynomial.coeff_one, hd0,
          Ne.symm hd0] using h1
      haveI := subsingleton_of_zero_eq_one h2.symm
      exact ⟨0, Subsingleton.elim _ _⟩
    · refine ⟨c, ?_⟩
      have h1 := congrArg (Polynomial.eval c) hm
      have h2 : (Multiset.map (Polynomial.eval c)
          (m.map fun c' => Polynomial.X - Polynomial.C c')).prod = 0 := by
        apply Multiset.prod_eq_zero
        rw [Multiset.map_map]
        exact Multiset.mem_map.mpr ⟨c, hc, by simp⟩
      rw [Polynomial.eval_multiset_prod, h2] at h1
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at h1
      exact sub_eq_zero.mp h1

  have hsplitfam : ∀ (K : Type u) [Field K] (ι : Type u) [Fintype ι] (b : ι → K),
      ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : FiniteDimensional K L), ∀ j,
        ∃ m : Multiset L, (Polynomial.X ^ d - Polynomial.C (b j)).map (algebraMap K L) =
          (m.map fun c => Polynomial.X - Polynomial.C c).prod := by
    intro K _ ι _ b
    let G : Polynomial K := ∏ j, (Polynomial.X ^ d - Polynomial.C (b j))
    have hGm : G.Monic := Polynomial.monic_prod_of_monic _ _
      (fun j _ => Polynomial.monic_X_pow_sub_C (b j) hd0)
    refine ⟨G.SplittingField, inferInstance, inferInstance, inferInstance, fun j => ?_⟩
    have hG0 : G.map (algebraMap K G.SplittingField) ≠ 0 := (hGm.map _).ne_zero
    have hdvd : (Polynomial.X ^ d - Polynomial.C (b j)).map (algebraMap K G.SplittingField) ∣
        G.map (algebraMap K G.SplittingField) :=
      Polynomial.map_dvd _ (Finset.dvd_prod_of_mem
        (fun j => Polynomial.X ^ d - Polynomial.C (b j)) (Finset.mem_univ j))
    have hs := Polynomial.Splits.of_dvd (Polynomial.SplittingField.splits G) hG0 hdvd
    exact ⟨_, hs.eq_prod_roots_of_monic ((Polynomial.monic_X_pow_sub_C (b j) hd0).map _)⟩

  have hgerm : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (W : X.Opens) (e : W ≤ f ⁻¹ᵁ U)
      (x : X) (hx : x ∈ W) (a : Γ(Y, U)),
      (X.presheaf.germ W x hx).hom ((f.appLE U W e).hom a) =
        (f.stalkMap x).hom ((Y.presheaf.germ U (f x) (e hx)).hom a) := by
    intro X Y f U W e x hx a
    refine Eq.trans ?_ (Scheme.Hom.germ_stalkMap_apply f U x (e hx) a).symm
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE e) x hx _

  haveI : CompactSpace S₃ := QuasiCompact.compactSpace_of_compactSpace s₃
  have hpt : ∀ x : S₃, ∃ (ν : Fin r) (W : S₃.Opens),
      IsAffineOpen W ∧ x ∈ W ∧ W ≤ σ ⁻¹ᵁ (V ν).1 := by
    intro x
    obtain ⟨ν, hν⟩ := hcov (σ x)
    obtain ⟨W, hW, hxW, hWle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens S₃)) (show x ∈ σ ⁻¹ᵁ (V ν).1 from hν)
    exact ⟨ν, W, hW, hxW, hWle⟩
  choose ν₀ W₀ hW₀aff hxW₀ hW₀le using hpt
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (W₀ x : Set S₃))
    (fun x => (W₀ x).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hxW₀ x⟩)
  have hη : ∀ x, genericPoint S₃ ∈ W₀ x := fun x =>
    ((genericPoint_spec S₃).mem_open_set_iff (W₀ x).isOpen).mpr ⟨x, trivial, hxW₀ x⟩

  obtain ⟨L, iL, iA, iFD, hL⟩ := hsplitfam S₃.functionField (↥t × Fin mD)
    (fun p => (S₃.presheaf.germ (W₀ p.1.1) (genericPoint S₃) (hη p.1.1)).hom
      ((σ.appLE (V (ν₀ p.1.1)).1 (W₀ p.1.1) (hW₀le p.1.1)).hom (h (ν₀ p.1.1) p.2)))
  obtain ⟨P₀, iP₀, β₀, hfin, hsurj, hspl⟩ := wcpa_dj_ssprf_normalize k S₃ s₃ L
  have hθ : ∀ y ∈ t, ∀ i, ∃ θ : Γ(P₀, β₀ ⁻¹ᵁ W₀ y), θ ^ d =
      (β₀.app (W₀ y)).hom ((σ.appLE (V (ν₀ y)).1 (W₀ y) (hW₀le y)).hom (h (ν₀ y) i)) := by
    intro y hy i
    obtain ⟨m, hm⟩ := hL (⟨y, hy⟩, i)
    have hF : (Polynomial.X ^ d - Polynomial.C
        ((σ.appLE (V (ν₀ y)).1 (W₀ y) (hW₀le y)).hom (h (ν₀ y) i)) :
          Polynomial Γ(S₃, W₀ y)).Monic :=
      Polynomial.monic_X_pow_sub_C _ hd0
    obtain ⟨m', hm'⟩ := hspl (W₀ y) (hW₀aff y) (hη y) _ hF ⟨m, by
      rw [← hm]
      simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
        RingHom.comp_apply]⟩
    apply hroot _ _ m'
    rw [← hm']
    simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  haveI := iP₀
  refine ⟨P₀, iP₀, β₀, inferInstance, hsurj, ⟨⊤, ?_, inferInstance⟩, ?_⟩
  · exact (TopologicalSpace.Opens.ne_bot_iff_nonempty ⊤).mpr ⟨genericPoint S₃, by simp⟩
  · intro Z ρ ψ hρ z
    subst hρ
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ (β₀ (ψ z))))
    refine ⟨ν₀ y, hW₀le y hxy, fun i => ?_⟩
    obtain ⟨θ, hθ'⟩ := hθ y hy i
    refine ⟨(Z.presheaf.germ (ψ ⁻¹ᵁ (β₀ ⁻¹ᵁ W₀ y)) z hxy).hom ((ψ.app (β₀ ⁻¹ᵁ W₀ y)).hom θ), ?_⟩
    rw [← map_pow, ← map_pow, hθ', ← Scheme.Hom.germ_stalkMap_apply ψ _ z hxy,
      ← Scheme.Hom.germ_stalkMap_apply β₀ _ (ψ z) hxy,
      hgerm σ (V (ν₀ y)).1 (W₀ y) (hW₀le y) (β₀ (ψ z)) hxy (h (ν₀ y) i),
      Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp]
    rfl

theorem wcpa_dj_bko_regular_params : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (n : ℕ) (t : Fin n → R), (n : WithBot ℕ∞) = ringKrullDim R → Ideal.span (Set.range t) = IsLocalRing.maximalIdeal R → IsDomain R ∧ (∀ l, Prime (t l)) ∧ (∀ l l', l ≠ l' → ¬ t l ∣ t l') :=
by
  intro R _ _ n t hn hspan
  have hdom : IsDomain R := @wcpa_regular_isDomain _ _ wcpa_rs_quotient_regular inferInstance
  have ht : ∀ l, t l ∈ IsLocalRing.maximalIdeal R := fun l => by
    rw [← hspan]; exact Ideal.subset_span (Set.mem_range_self l)
  set t' : Fin n → IsLocalRing.maximalIdeal R := fun l => ⟨t l, ht l⟩ with ht'
  have hfin : Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) = n := by
    have h1 := IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R
    have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hn, h1] at h2
    exact_mod_cast h2
  have htop : Submodule.span R (Set.range t') = ⊤ := by
    apply Submodule.map_injective_of_injective (f := (IsLocalRing.maximalIdeal R).subtype)
      Subtype.val_injective
    rw [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp]
    exact hspan
  have hcot : Submodule.span (IsLocalRing.ResidueField R)
      (Set.range (fun l => (IsLocalRing.maximalIdeal R).toCotangent (t' l))) = ⊤ := by
    rw [Set.range_comp']
    exact (IsLocalRing.CotangentSpace.span_image_eq_top_iff (s := Set.range t')).mpr htop
  have L : LinearIndependent (IsLocalRing.ResidueField R)
      (fun l => (IsLocalRing.maximalIdeal R).toCotangent (t' l)) := by
    apply linearIndependent_of_top_le_span_of_card_eq_finrank hcot.ge
    rw [Fintype.card_fin]
    exact hfin.symm
  have hprimes : ∀ l, Prime (t l) := by
    intro l
    have hne : t l ≠ 0 := by
      intro h0
      apply L.ne_zero l
      have : t' l = 0 := Subtype.ext h0
      simp only [this, map_zero]
    have hinj : Function.Injective (fun _ : Fin 1 => l) := fun a b _ => Subsingleton.elim a b
    have L1 := L.comp (fun _ : Fin 1 => l) hinj
    have hreg := (wcpa_rs_quotient_regular R 1 (fun _ => t' l) L1).1
    have hdom1 := @wcpa_regular_isDomain _ _ wcpa_rs_quotient_regular hreg
    have hrange : Set.range (fun _ : Fin 1 => ((t' l : IsLocalRing.maximalIdeal R) : R)) = {t l} :=
      Set.range_const
    rw [hrange] at hdom1
    have hprime : (Ideal.span {t l}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdom1
    exact (Ideal.span_singleton_prime hne).mp hprime
  refine ⟨hdom, hprimes, ?_⟩
  intro l l' hll' hdvd
  obtain ⟨a, ha⟩ := hdvd
  have hsm : t' l' = a • t' l := by
    apply Subtype.ext
    show t l' = a * t l
    rw [ha, mul_comm]
  have hv : (IsLocalRing.maximalIdeal R).toCotangent (t' l') =
      (IsLocalRing.residue R a) • (IsLocalRing.maximalIdeal R).toCotangent (t' l) := by
    rw [hsm, LinearMap.map_smul, ← IsLocalRing.ResidueField.algebraMap_eq]
    exact (algebraMap_smul (IsLocalRing.ResidueField R) a _).symm
  have L2 := L.comp ![l, l'] (by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [eq_comm])
  have L2' : LinearIndependent (IsLocalRing.ResidueField R)
      ![(IsLocalRing.maximalIdeal R).toCotangent (t' l),
        (IsLocalRing.maximalIdeal R).toCotangent (t' l')] := by
    convert L2 using 1
    funext i
    fin_cases i <;> rfl
  have := (LinearIndependent.pair_iff.mp L2') (IsLocalRing.residue R a) (-1) (by
    rw [← hv, neg_one_smul, add_neg_cancel])
  exact neg_ne_zero.mpr one_ne_zero this.2

theorem wcpa_dj_bko_root_monomial : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (n : ℕ) (t : Fin n → R) (J : Finset (Fin n)) (d : ℕ) (Θ x : R), (∀ l ∈ J, Prime (t l)) → Θ ^ d = x → (∀ q : Ideal R, q.IsPrime → x ∈ q → ∃ l ∈ J, t l ∈ q) → ∃ (v : Rˣ) (c : Fin n → ℕ), (∀ l, c l ≠ 0 → l ∈ J) ∧ x = ↑v * ∏ l, t l ^ (d * c l) :=
by
  intro R _ _ _ n t J d Θ x hJ hx H
  classical
  subst hx
  rcases Nat.eq_zero_or_pos d with hd | hd
  · subst hd
    exact ⟨1, fun _ => 0, fun l hl => absurd rfl hl, by simp⟩

  have key : ∀ (l₀ : Fin n) (b : Fin n → ℕ),
      ∏ l, t l ^ (b l + if l = l₀ then 1 else 0) = t l₀ * ∏ l, t l ^ b l := by
    intro l₀ b
    have h1 : ∏ l, t l ^ (b l + if l = l₀ then 1 else 0) =
        (∏ l, t l ^ b l) * ∏ l, t l ^ (if l = l₀ then 1 else 0) := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl (fun l _ => pow_add _ _ _)
    have h2 : ∏ l, t l ^ (if l = l₀ then 1 else 0) = t l₀ := by
      rw [Fintype.prod_eq_single l₀ (fun k hk => by simp [hk])]
      simp
    rw [h1, h2, mul_comm]

  have s1 : ∃ (z : R) (a : Fin n → ℕ), (∀ l, a l ≠ 0 → l ∈ J) ∧ Θ * z = ∏ l, t l ^ a l := by
    let S : Submonoid R :=
      { carrier := {y | ∃ a : Fin n → ℕ, (∀ l, a l ≠ 0 → l ∈ J) ∧ y = ∏ l, t l ^ a l}
        one_mem' := ⟨0, fun l hl => absurd rfl hl, by simp⟩
        mul_mem' := by
          rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
          refine ⟨a + b, fun l hl => ?_, ?_⟩
          · by_cases hal : a l = 0
            · apply hb l
              simpa [Pi.add_apply, hal] using hl
            · exact ha l hal
          · rw [← Finset.prod_mul_distrib]
            exact Finset.prod_congr rfl (fun l _ => (pow_add _ _ _).symm) }
    by_contra hne
    have hdisj : Disjoint ((Ideal.span {Θ} : Ideal R) : Set R) (S : Set R) := by
      rw [Set.disjoint_left]
      intro y hy hyS
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hy
      obtain ⟨a, ha, rfl⟩ := hyS
      exact hne ⟨w, a, ha, by rw [mul_comm]; exact hw⟩
    obtain ⟨q, hq, hle, hqd⟩ := Ideal.exists_le_prime_disjoint _ S hdisj
    have hΘ : Θ ∈ q := hle (Ideal.mem_span_singleton_self Θ)
    obtain ⟨l, hl, htl⟩ := H q hq (Ideal.pow_mem_of_mem q hΘ d hd)
    have hS : t l ∈ S := by
      refine ⟨fun k => if k = l then 1 else 0, fun k hk => ?_, ?_⟩
      · by_cases hkl : k = l
        · rw [hkl]; exact hl
        · simp [hkl] at hk
      · have := key l (fun _ => 0)
        simp only [zero_add, pow_zero, Finset.prod_const_one, mul_one] at this
        exact this.symm
    exact Set.disjoint_left.mp hqd htl hS

  have s2 : ∀ N : ℕ, ∀ (a : Fin n → ℕ) (Θ z : R), ∑ l, a l = N →
      (∀ l, a l ≠ 0 → Prime (t l)) → Θ * z = ∏ l, t l ^ a l →
      ∃ (u : Rˣ) (e : Fin n → ℕ), (∀ l, e l ≠ 0 → a l ≠ 0) ∧ Θ = ↑u * ∏ l, t l ^ e l := by
    intro N
    induction N with
    | zero =>
      intro a Θ z hsum _ hΘz
      have ha0 : ∀ l, a l = 0 := fun l =>
        (Finset.sum_eq_zero_iff.mp hsum) l (Finset.mem_univ l)
      have h1 : Θ * z = 1 := by rw [hΘz]; simp [ha0]
      have hu : IsUnit Θ := isUnit_iff_exists_inv.mpr ⟨z, h1⟩
      exact ⟨hu.unit, fun _ => 0, fun l hl => absurd rfl hl, by simp⟩
    | succ N ih =>
      intro a Θ z hsum hpr hΘz
      obtain ⟨l₀, -, hl₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero
        (by rw [hsum]; exact Nat.succ_ne_zero N : ∑ l, a l ≠ 0)
      set a' : Fin n → ℕ := fun k => if k = l₀ then a k - 1 else a k with ha'def
      have ha : ∀ k, a k = a' k + if k = l₀ then 1 else 0 := by
        intro k
        by_cases hk : k = l₀
        · subst hk; simp only [ha'def, ite_true]; omega
        · simp [ha'def, hk]
      have hsum' : ∑ l, a' l = N := by
        have e1 : ∑ l, a l = ∑ l, a' l + 1 := by
          rw [Finset.sum_congr rfl (fun k _ => ha k), Finset.sum_add_distrib]
          simp
        omega
      have hprod : ∏ l, t l ^ a l = t l₀ * ∏ l, t l ^ a' l := by
        rw [← key l₀ a']
        exact Finset.prod_congr rfl (fun k _ => by rw [← ha k])
      have hpr' : ∀ l, a' l ≠ 0 → Prime (t l) := by
        intro l hl
        apply hpr l
        rw [ha l]; omega
      have hp : Prime (t l₀) := hpr l₀ hl₀
      have hp0 : t l₀ ≠ 0 := hp.ne_zero
      have hdvd : t l₀ ∣ Θ * z := ⟨∏ l, t l ^ a' l, by rw [hΘz, hprod]⟩
      rcases hp.dvd_or_dvd hdvd with ⟨Θ', hΘ'⟩ | ⟨z', hz'⟩
      · have hc : Θ' * z = ∏ l, t l ^ a' l := by
          apply mul_left_cancel₀ hp0
          rw [← hprod, ← hΘz, hΘ']; ring
        obtain ⟨u, e', he', hΘ'e⟩ := ih a' Θ' z hsum' hpr' hc
        refine ⟨u, fun k => e' k + if k = l₀ then 1 else 0, fun k hk => ?_, ?_⟩
        · by_cases hkl : k = l₀
          · rw [hkl]; exact hl₀
          · have hek : e' k ≠ 0 := by simpa [hkl] using hk
            have := he' k hek
            rw [ha k]; omega
        · rw [key l₀ e', hΘ', hΘ'e]; ring
      · have hc : Θ * z' = ∏ l, t l ^ a' l := by
          apply mul_left_cancel₀ hp0
          rw [← hprod, ← hΘz, hz']; ring
        obtain ⟨u, e, he, hΘe⟩ := ih a' Θ z' hsum' hpr' hc
        refine ⟨u, e, fun k hk => ?_, hΘe⟩
        have := he k hk
        rw [ha k]; omega

  obtain ⟨z, a, haJ, hΘz⟩ := s1
  obtain ⟨u, e, he, hΘe⟩ := s2 _ a Θ z rfl (fun l hl => hJ l (haJ l hl)) hΘz
  refine ⟨u ^ d, e, fun l hl => haJ l (he l hl), ?_⟩
  rw [hΘe, mul_pow, Units.val_pow_eq_pow_val, ← Finset.prod_pow]
  congr 1
  exact Finset.prod_congr rfl (fun l _ => by rw [← pow_mul, mul_comm])

theorem wcpa_dj_bko_eqn_generization : ∀ (S S'' : Scheme.{u}) (ρ : S'' ⟶ S) (mD r : ℕ) (Dc : Fin mD → Set S) (V : Fin r → S.affineOpens) (h : ∀ ν, Fin mD → Γ(S, (V ν).1)), (∀ ν i (p : S) (hp : p ∈ (V ν).1), (S.presheaf.germ (V ν).1 p hp).hom (h ν i) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p) → p ∈ Dc i) → ∀ (s : S'') (ν : Fin r) (hs : ρ s ∈ (V ν).1) (i : Fin mD) (q : Ideal (S''.presheaf.stalk s)), q.IsPrime → (ρ.stalkMap s).hom ((S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i)) ∈ q → ∃ (s' : S'') (hsp : s' ⤳ s), ρ s' ∈ Dc i ∧ ∀ b : S''.presheaf.stalk s, ((S''.presheaf.stalkSpecializes hsp).hom b ∈ IsLocalRing.maximalIdeal (S''.presheaf.stalk s') ↔ b ∈ q) :=
by
  intro S S'' ρ mD r Dc V h hLEa s ν hs i q hq hxq

  have gen : ∀ (X : Scheme.{u}) (x : X) (Q : PrimeSpectrum (X.presheaf.stalk x)),
      ∃ hsp : X.fromSpecStalk x Q ⤳ x, ∀ a : X.presheaf.stalk x,
        (X.presheaf.stalkSpecializes hsp).hom a ∈
          IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk x Q)) ↔ a ∈ Q.asIdeal := by
    intro X x Q
    have hsp : X.fromSpecStalk x Q ⤳ x :=
      (Scheme.range_fromSpecStalk (X := X) (x := x)).subset ⟨Q, rfl⟩
    refine ⟨hsp, fun a => ?_⟩
    have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x Q))) = Q := by
      apply (X.fromSpecStalk x).isEmbedding.injective
      have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk x Q)) ⟶ X =>
          k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x Q))))
          (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
      simp only at e
      exact e.trans Scheme.fromSpecStalk_closedPoint
    have h2 : a ∈ Q.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x Q)))).asIdeal := by
      rw [key]
    rw [h2]
    exact Iff.rfl
  obtain ⟨hsp, hiff⟩ := gen S'' s ⟨q, hq⟩
  refine ⟨S''.fromSpecStalk s ⟨q, hq⟩, hsp, ?_, hiff⟩
  set s' := S''.fromSpecStalk s ⟨q, hq⟩ with hs'
  have hsp' : ρ s' ⤳ ρ s := hsp.map ρ.continuous
  have hp' : ρ s' ∈ (V ν).1 := hsp'.mem_open (V ν).1.isOpen hs
  apply hLEa ν i (ρ s') hp'
  have e1 : (S.presheaf.stalkSpecializes hsp').hom ((S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i))
      = (S.presheaf.germ (V ν).1 (ρ s') hp').hom (h ν i) :=
    TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  have e2 := Scheme.Hom.stalkSpecializes_stalkMap_apply ρ (h := hsp)
    (y := (S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i))
  rw [e1] at e2
  have hm : (ρ.stalkMap s').hom ((S.presheaf.germ (V ν).1 (ρ s') hp').hom (h ν i)) ∈
      IsLocalRing.maximalIdeal (S''.presheaf.stalk s') := by
    rw [e2]
    exact (hiff _).2 hxq
  rw [IsLocalRing.mem_maximalIdeal] at hm ⊢
  exact (map_mem_nonunits_iff (ρ.stalkMap s').hom _).1 hm

theorem wcpa_dj_bko_pair_comparable : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] (m n B : ℕ) (x : Fin m → R) (t : Fin n → R) (v : Fin m → Rˣ) (e : Fin m → Fin n → ℕ), (∀ l, Prime (t l)) → (∀ l l', l ≠ l' → ¬ t l ∣ t l') → (∀ i, x i = ↑(v i) * ∏ l, t l ^ e i l) → (wcpaDjBkPairIdeal R m x B).IsPrincipal → ∀ G G' : Fin m → ℕ, (∀ i, G i ≤ B) → (∀ i, G' i ≤ B) → (∀ l, ∑ i, G i * e i l ≤ ∑ i, G' i * e i l) ∨ (∀ l, ∑ i, G' i * e i l ≤ ∑ i, G i * e i l) :=
by
  intro R _ _ _ m n B x t v e hprime hndiv hx hprin G G' hG hG'
  classical

  have hmono : ∀ H : Fin m → ℕ, (∏ i, x i ^ H i) =
      ↑(∏ i, v i ^ H i) * ∏ l, t l ^ (∑ i, H i * e i l) := by
    intro H
    simp_rw [hx, mul_pow, Finset.prod_mul_distrib, Units.coe_prod, Units.val_pow_eq_pow_val]
    congr 1
    simp_rw [← Finset.prod_pow, ← pow_mul]
    rw [Finset.prod_comm]
    refine Finset.prod_congr rfl (fun l _ => ?_)
    rw [Finset.prod_pow_eq_pow_sum]
    congr 1
    exact Finset.sum_congr rfl (fun i _ => mul_comm _ _)

  have hne : ∀ H : Fin m → ℕ, (∏ i, x i ^ H i) ≠ 0 := by
    intro H
    rw [hmono H]
    refine mul_ne_zero (Units.ne_zero _) ?_
    rw [Finset.prod_ne_zero_iff]
    intro l _
    exact pow_ne_zero _ (hprime l).ne_zero

  have c2 : ∀ I J : Ideal R, (I * J).IsPrincipal → I * J ≠ ⊥ → I.IsPrincipal := by
    intro I J hIJ hne0
    obtain ⟨g, hg⟩ := hIJ
    have hg' : I * J = Ideal.span {g} := hg
    have hg0 : g ≠ 0 := by
      rintro rfl
      exact hne0 (by rw [hg', Ideal.span_singleton_eq_bot.mpr rfl])
    have hex : ∃ a ∈ I, ∃ b ∈ J, a * b ∉ Ideal.span {g} * IsLocalRing.maximalIdeal R := by
      by_contra hcon
      push_neg at hcon
      have hle : I * J ≤ Ideal.span {g} * IsLocalRing.maximalIdeal R := Ideal.mul_le.mpr hcon
      have hgm : g ∈ Ideal.span {g} * IsLocalRing.maximalIdeal R :=
        hle (hg' ▸ Ideal.mem_span_singleton_self g)
      obtain ⟨z, hz, hgz⟩ := Ideal.mem_span_singleton_mul.mp hgm
      have hu : IsUnit (1 - z) := by
        by_contra hnu
        have h1 : 1 - z ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr hnu
        have h2 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
          have := Ideal.add_mem _ h1 hz
          simpa using this
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
      have h3 : g * (1 - z) = 0 := by rw [mul_sub, mul_one, hgz, sub_self]
      exact hg0 ((hu.mul_left_eq_zero).mp h3)
    obtain ⟨a, ha, b, hb, hab⟩ := hex
    have habIJ : a * b ∈ Ideal.span {g} := hg' ▸ Ideal.mul_mem_mul ha hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp habIJ
    have hcu : IsUnit c := by
      by_contra hnu
      apply hab
      rw [← hc, mul_comm c g]
      exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self g)
        ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hc
      exact hg0 ((hcu.mul_right_eq_zero).mp hc)
    obtain ⟨c', hc'⟩ := hcu.exists_left_inv
    refine ⟨a, ?_⟩
    apply le_antisymm
    · intro y hy
      have hyb : y * b ∈ Ideal.span {g} := hg' ▸ Ideal.mul_mem_mul hy hb
      obtain ⟨f, hf⟩ := Ideal.mem_span_singleton'.mp hyb
      have key : (y * c) * b = (f * a) * b := by
        calc (y * c) * b = c * (y * b) := by ring
          _ = c * (f * g) := by rw [hf]
          _ = f * (c * g) := by ring
          _ = f * (a * b) := by rw [hc]
          _ = (f * a) * b := by ring
      have key2 : y * c = f * a := mul_right_cancel₀ hb0 key
      have hy' : y = (c' * f) * a := by
        calc y = y * (c' * c) := by rw [hc', mul_one]
          _ = c' * (y * c) := by ring
          _ = c' * (f * a) := by rw [key2]
          _ = (c' * f) * a := by ring
      rw [hy']
      exact Submodule.mem_span_singleton.mpr ⟨c' * f, rfl⟩
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      exact ha

  have c3 : ∀ a b : R, (Ideal.span {a, b}).IsPrincipal → a ∣ b ∨ b ∣ a := by
    intro a b hab
    obtain ⟨g, hg⟩ := hab
    have hg' : Ideal.span {a, b} = Ideal.span {g} := hg
    have ha : a ∈ Ideal.span {g} := hg' ▸ Ideal.subset_span (Set.mem_insert a {b})
    have hb : b ∈ Ideal.span {g} := hg' ▸ Ideal.subset_span (Set.mem_insert_of_mem a rfl)
    have hgm : g ∈ Ideal.span {a, b} := hg' ▸ Ideal.mem_span_singleton_self g
    obtain ⟨α, hα⟩ := Ideal.mem_span_singleton'.mp ha
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hb
    obtain ⟨l1, μ, hlμ⟩ := Ideal.mem_span_pair.mp hgm
    by_cases hg0 : g = 0
    · left
      have hb0 : b = 0 := by rw [← hβ, hg0, mul_zero]
      rw [hb0]
      exact dvd_zero a
    · have h1 : (l1 * α + μ * β) * g = 1 * g := by
        rw [one_mul]
        nth_rewrite 2 [← hlμ]
        rw [← hα, ← hβ]
        ring
      have h2 : l1 * α + μ * β = 1 := mul_right_cancel₀ hg0 h1
      have h2u : IsUnit (l1 * α + μ * β) := by rw [h2]; exact isUnit_one
      rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add h2u with h | h
      · left
        obtain ⟨α', hα'⟩ := (isUnit_of_mul_isUnit_right h).exists_left_inv
        refine ⟨β * α', ?_⟩
        rw [← hβ, ← hα]
        calc β * g = β * ((α' * α) * g) := by rw [hα', one_mul]
          _ = α * g * (β * α') := by ring
      · right
        obtain ⟨β', hβ'⟩ := (isUnit_of_mul_isUnit_right h).exists_left_inv
        refine ⟨α * β', ?_⟩
        rw [← hβ, ← hα]
        calc α * g = α * ((β' * β) * g) := by rw [hβ', one_mul]
          _ = β * g * (α * β') := by ring

  have c4 : ∀ (u u' : Rˣ) (E E' : Fin n → ℕ),
      (↑u * ∏ l, t l ^ E l) ∣ (↑u' * ∏ l, t l ^ E' l) → ∀ l, E l ≤ E' l := by
    intro u u' E E' hdvd l
    rw [Units.mul_left_dvd, Units.dvd_mul_left] at hdvd
    by_contra hlt
    push_neg at hlt
    obtain ⟨k, hk⟩ : ∃ k, E l = E' l + (k + 1) := ⟨E l - E' l - 1, by omega⟩
    have e1 : ∏ l', t l' ^ E l' = t l ^ E l * ∏ l' ∈ Finset.univ.erase l, t l' ^ E l' :=
      (Finset.mul_prod_erase Finset.univ (fun l' => t l' ^ E l') (Finset.mem_univ l)).symm
    have e2 : ∏ l', t l' ^ E' l' = t l ^ E' l * ∏ l' ∈ Finset.univ.erase l, t l' ^ E' l' :=
      (Finset.mul_prod_erase Finset.univ (fun l' => t l' ^ E' l') (Finset.mem_univ l)).symm
    have h3 : t l ^ E' l * (t l ^ (k + 1) * ∏ l' ∈ Finset.univ.erase l, t l' ^ E l') ∣
        t l ^ E' l * ∏ l' ∈ Finset.univ.erase l, t l' ^ E' l' := by
      rw [← mul_assoc, ← pow_add, ← hk, ← e1, ← e2]
      exact hdvd
    have h4 := (mul_dvd_mul_iff_left (pow_ne_zero (E' l) (hprime l).ne_zero)).mp h3
    have htl : t l ∣ ∏ l' ∈ Finset.univ.erase l, t l' ^ E' l' :=
      dvd_trans (dvd_mul_of_dvd_left (dvd_pow_self _ (Nat.succ_ne_zero k)) _) h4
    obtain ⟨l', hl', hdl⟩ := ((hprime l).dvd_finsetProd_iff _).mp htl
    exact hndiv l l' (Finset.ne_of_mem_erase hl').symm ((hprime l).dvd_of_dvd_pow hdl)

  let F : (Fin m → Fin (B + 1)) × (Fin m → Fin (B + 1)) → Ideal R := fun ΓΓ =>
    Ideal.span {∏ i, x i ^ (ΓΓ.1 i : ℕ), ∏ i, x i ^ (ΓΓ.2 i : ℕ)}
  have hP : wcpaDjBkPairIdeal R m x B = ∏ ΓΓ, F ΓΓ := rfl
  have hnebot : wcpaDjBkPairIdeal R m x B ≠ ⊥ := by
    intro hbot
    have hz : (∏ ΓΓ : (Fin m → Fin (B + 1)) × (Fin m → Fin (B + 1)),
        ∏ i, x i ^ (ΓΓ.1 i : ℕ)) ∈ wcpaDjBkPairIdeal R m x B := by
      rw [hP]
      exact Ideal.prod_mem_prod (fun ΓΓ _ => Ideal.subset_span (Set.mem_insert _ _))
    rw [hbot, Ideal.mem_bot] at hz
    exact (Finset.prod_ne_zero_iff.mpr (fun ΓΓ _ => hne _)) hz

  let Γ : Fin m → Fin (B + 1) := fun i => ⟨G i, Nat.lt_succ_of_le (hG i)⟩
  let Γ' : Fin m → Fin (B + 1) := fun i => ⟨G' i, Nat.lt_succ_of_le (hG' i)⟩
  have hsplit : F (Γ, Γ') * ∏ ΓΓ ∈ Finset.univ.erase (Γ, Γ'), F ΓΓ =
      wcpaDjBkPairIdeal R m x B :=
    Finset.mul_prod_erase Finset.univ F (Finset.mem_univ _)
  have hIprin : (F (Γ, Γ')).IsPrincipal := by
    apply c2 _ (∏ ΓΓ ∈ Finset.univ.erase (Γ, Γ'), F ΓΓ)
    · rw [hsplit]; exact hprin
    · rw [hsplit]; exact hnebot
  have hFG : F (Γ, Γ') = Ideal.span {∏ i, x i ^ G i, ∏ i, x i ^ G' i} := rfl
  rw [hFG] at hIprin
  rcases c3 _ _ hIprin with h | h
  · left
    rw [hmono G, hmono G'] at h
    exact c4 _ _ _ _ h
  · right
    rw [hmono G, hmono G'] at h
    exact c4 _ _ _ _ h

theorem wcpa_dj_bk_kummer_ord_of_charts : ∀ (S S'' : Scheme.{u}) (ρ : S'' ⟶ S) (mD : ℕ)
    (Dc : Fin mD → Set S) (D'' : Set S'') (d B r : ℕ) (V : Fin r → S.affineOpens)
    (h : ∀ ν, Fin mD → Γ(S, (V ν).1)),
    (∀ s : S, IsRegularLocalRing (S.presheaf.stalk s)) →
    (∀ s : S'', IsRegularLocalRing (S''.presheaf.stalk s)) →
    wcpaDjSNCSet S'' D'' → ⇑ρ ⁻¹' (⋃ i, Dc i) ⊆ D'' →
    (∀ ν i (p : S) (hp : p ∈ (V ν).1),
      (S.presheaf.germ (V ν).1 p hp).hom (h ν i) ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk p) → p ∈ Dc i) →
    (∀ ν i (p : S) (hp : p ∈ (V ν).1), p ∈ Dc i →
      ∀ (n : ℕ) (t : Fin n → S.presheaf.stalk p) (j : Fin n),
        (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk p) →
        Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk p) →
        (∀ (p' : S) (hsp : p' ⤳ p), p' ∈ Dc i ↔
          (S.presheaf.stalkSpecializes hsp).hom (t j) ∈
            IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
        Associated ((S.presheaf.germ (V ν).1 p hp).hom (h ν i)) (t j)) →
    (∀ s : S'', ∃ (ν : Fin r) (hs : ρ s ∈ (V ν).1), ∀ i, ∃ Θ : S''.presheaf.stalk s,
      Θ ^ d = (ρ.stalkMap s).hom ((S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i))) →
    (∀ (s : S'') (ν : Fin r) (hs : ρ s ∈ (V ν).1),
      (wcpaDjBkPairIdeal (S''.presheaf.stalk s) mD
        (fun i => (ρ.stalkMap s).hom ((S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i)))
        B).IsPrincipal) →
    wcpaDjKummerOrd ρ mD Dc D'' d B :=
by
  intro S S'' ρ mD Dc D'' d B r V h hregS hregS'' hsnc hpre hLEa hLEb hroots hprin
  classical
  intro s n t a hn hspan hinj hchar
  obtain ⟨m'', Dc'', hcl'', hD'', hloc''⟩ := hsnc
  obtain ⟨n'', t'', hn'', hspan'', a'', hinj'', hchar''⟩ := hloc'' s
  haveI := hregS'' s
  obtain ⟨hdom, hprime, hndiv⟩ := wcpa_dj_bko_regular_params _ n'' t'' hn'' hspan''
  haveI := hdom
  set J'' : Finset (Fin n'') := Finset.univ.image a'' with hJ''
  have hJ : ∀ (s' : S'') (hsp : s' ⤳ s), s' ∈ D'' ↔ ∃ l ∈ J'',
      (S''.presheaf.stalkSpecializes hsp).hom (t'' l) ∈
        IsLocalRing.maximalIdeal (S''.presheaf.stalk s') := by
    intro s' hsp
    constructor
    · intro hs'
      rw [hD'', Set.mem_iUnion] at hs'
      obtain ⟨j, hj⟩ := hs'
      have hsj : s ∈ Dc'' j := hsp.mem_closed (hcl'' j) hj
      exact ⟨a'' ⟨j, hsj⟩, Finset.mem_image_of_mem _ (Finset.mem_univ _),
        (hchar'' ⟨j, hsj⟩ s' hsp).1 hj⟩
    · rintro ⟨l, hl, hm⟩
      obtain ⟨j', _, rfl⟩ := Finset.mem_image.mp hl
      rw [hD'', Set.mem_iUnion]
      exact ⟨j'.1, (hchar'' j' s' hsp).2 hm⟩
  obtain ⟨ν, hs, hΘ⟩ := hroots s
  choose Θ hΘ using hΘ
  have hmono : ∀ i, ∃ (v : (S''.presheaf.stalk s)ˣ) (c : Fin n'' → ℕ), (∀ l, c l ≠ 0 → l ∈ J'') ∧
      (ρ.stalkMap s).hom ((S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i)) =
        ↑v * ∏ l, t'' l ^ (d * c l) := by
    intro i
    refine wcpa_dj_bko_root_monomial _ n'' t'' J'' d (Θ i) _ (fun l _ => hprime l) (hΘ i) ?_
    intro q hq hxq
    obtain ⟨s', hsp, hρs', hiff⟩ :=
      wcpa_dj_bko_eqn_generization S S'' ρ mD r Dc V h hLEa s ν hs i q hq hxq
    have hs'D : s' ∈ D'' := hpre (Set.mem_iUnion.mpr ⟨i, hρs'⟩)
    obtain ⟨l, hl, hm⟩ := (hJ s' hsp).1 hs'D
    exact ⟨l, hl, (hiff (t'' l)).1 hm⟩
  choose v c hcJ hx using hmono
  refine ⟨n'', t'', J'', fun i l => d * c i.1 l, hn'', hspan'', hJ, ?_, ?_, ?_, ?_⟩
  · intro i l hne
    apply hcJ i.1 l
    intro hc
    apply hne
    simp [hc]
  · intro i l
    exact Dvd.intro _ rfl
  · intro i
    obtain ⟨u, hu⟩ := hLEb ν i.1 (ρ s) hs i.2 n t (a i) hn hspan (hchar i)
    refine ⟨v i.1 * Units.map (ρ.stalkMap s).hom.toMonoidHom u, ?_⟩
    rw [← hu, map_mul, hx i.1, Units.val_mul, Units.coe_map]
    simp only [RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe]
    ring
  · intro γ γ' hγ hγ'
    have hsum : ∀ (g : {i // ρ s ∈ Dc i} → ℕ) (l : Fin n''),
        ∑ i : Fin mD, (if hi : ρ s ∈ Dc i then g ⟨i, hi⟩ else 0) * (d * c i l) =
          ∑ i : {i // ρ s ∈ Dc i}, g i * (d * c i.1 l) := by
      intro g l
      rw [← Fintype.sum_subtype_add_sum_subtype (fun i => ρ s ∈ Dc i)]
      have h2 : ∑ i : {i // ¬ ρ s ∈ Dc i},
          (if hi : ρ s ∈ Dc i.1 then g ⟨i.1, hi⟩ else 0) * (d * c i.1 l) = 0 :=
        Finset.sum_eq_zero (fun i _ => by rw [dif_neg i.2, zero_mul])
      rw [h2, add_zero]
      exact Finset.sum_congr rfl (fun i _ => by rw [dif_pos i.2])
    have hG : ∀ i, (if hi : ρ s ∈ Dc i then γ ⟨i, hi⟩ else 0) ≤ B := by
      intro i
      split_ifs with hi
      · exact hγ _
      · exact Nat.zero_le _
    have hG' : ∀ i, (if hi : ρ s ∈ Dc i then γ' ⟨i, hi⟩ else 0) ≤ B := by
      intro i
      split_ifs with hi
      · exact hγ' _
      · exact Nat.zero_le _
    rcases wcpa_dj_bko_pair_comparable _ mD n'' B
        (fun i => (ρ.stalkMap s).hom ((S.presheaf.germ (V ν).1 (ρ s) hs).hom (h ν i)))
        t'' v (fun i l => d * c i l) hprime hndiv hx (hprin s ν hs) _ _ hG hG' with H | H
    · left
      intro l
      have e1 := hsum γ l
      have e2 := hsum γ' l
      have := H l
      simp only [] at this ⊢
      rw [← e1, ← e2]
      exact this
    · right
      intro l
      have e1 := hsum γ l
      have e2 := hsum γ' l
      have := H l
      simp only [] at this ⊢
      rw [← e1, ← e2]
      exact this

theorem wcpa_dj_ste_base_kummer : ∀ (k : Type u) [Field k] [Finite k] (S : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) (nP mD : ℕ) (Dc : Fin mD → Set S)
    (d B : ℕ),
    wcpaDjIsProjOver k sS → (∀ s : S, IsRegularLocalRing (S.presheaf.stalk s)) →
    topologicalKrullDim S = (nP : WithBot ℕ∞) → wcpaDjAltIH.{u} nP →
    wcpaDjSNCComps S mD Dc → 1 ≤ d →
    ∃ (S'' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S'') (ρ : S'' ⟶ S) (D'' : Set S''),
      wcpaDjIsProjOver k (ρ ≫ sS) ∧ IsProper ρ ∧ Surjective ρ ∧
      (∃ V : S.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) ∧
      (∀ s : S'', IsRegularLocalRing (S''.presheaf.stalk s)) ∧ wcpaDjSNCSet S'' D'' ∧
      ⇑ρ ⁻¹' (⋃ i, Dc i) ⊆ D'' ∧ wcpaDjKummerOrd ρ mD Dc D'' d B :=
by
  intro k _ _ S _ sS nP mD Dc d B hproj hreg hdim hIH hsnc hd

  obtain ⟨⟨p₀, hp₀⟩, r, V, h, hcov, hnz, hcompat, hLEa, hLEb⟩ :=
    wcpa_dj_bk_local_equations k S sS mD Dc hproj hreg hsnc

  obtain ⟨S₃, iS₃, σ, hσproj, hσp, hσs, hσf, hprin⟩ :=
    wcpa_dj_bk_principalize k S sS mD B r V h hproj hcov hnz hcompat
  haveI := iS₃
  haveI hs₃ : IsProper (σ ≫ sS) := wcpa_dj_proj_proper k (σ ≫ sS) hσproj

  obtain ⟨S', iS', β, hβp, hβs, hβf, hroots⟩ :=
    wcpa_dj_bk_kummer_roots k S S₃ (σ ≫ sS) σ mD r d V h hcov hd
  haveI := iS'
  haveI := hσp
  haveI := hβp
  obtain ⟨hβσs, hβσf⟩ := wcpa_dj_alteration_comp σ β hσp hσs hβs hσf hβf
  haveI hS'p : IsProper (β ≫ σ ≫ sS) := inferInstance
  haveI hSp : IsProper sS := wcpa_dj_proj_proper k sS hproj
  have hdim' : topologicalKrullDim S' = (nP : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k S' S (β ≫ σ ≫ sS) sS (β ≫ σ) (Category.assoc _ _ _) hβσs
      hβσf).trans hdim

  have hEcl : IsClosed (⇑(β ≫ σ) ⁻¹' (⋃ i, Dc i)) :=
    (isClosed_iUnion_of_finite hsnc.1).preimage (β ≫ σ).continuous
  have hEne : ⇑(β ≫ σ) ⁻¹' (⋃ i, Dc i) ≠ Set.univ := by
    intro hE
    haveI := hβσs
    obtain ⟨y, hy⟩ := (β ≫ σ).surjective p₀
    have hy' : y ∈ ⇑(β ≫ σ) ⁻¹' (⋃ i, Dc i) := by rw [hE]; exact Set.mem_univ y
    rw [Set.mem_preimage, hy, Set.mem_iUnion] at hy'
    obtain ⟨i, hi⟩ := hy'
    exact hp₀ i hi
  obtain ⟨Z, iZ, sZ, φ, hφ, hsZp, hregZ, hφp, hφs, hφf, hsZproj, D, hD, hDE⟩ :=
    hIH k S' (β ≫ σ ≫ sS) hdim' _ hEcl hEne
  haveI := iZ
  haveI := hφp
  obtain ⟨hρs, hρf⟩ := wcpa_dj_alteration_comp (β ≫ σ) φ inferInstance hβσs hφs hβσf hφf
  have hpre : ⇑(φ ≫ β ≫ σ) ⁻¹' (⋃ i, Dc i) ⊆ D := by
    intro z hz
    apply hDE
    simpa only [Set.mem_preimage, Scheme.Hom.comp_apply] using hz
  refine ⟨Z, iZ, φ ≫ β ≫ σ, D, ?_, inferInstance, hρs, hρf, hregZ, hD, hpre, ?_⟩
  · have e : (φ ≫ β ≫ σ) ≫ sS = sZ := by
      simp only [Category.assoc]
      exact hφ
    rw [e]
    exact hsZproj
  · exact wcpa_dj_bk_kummer_ord_of_charts S Z (φ ≫ β ≫ σ) mD Dc D d B r V h hreg hregZ hD hpre
      hLEa hLEb (hroots Z (φ ≫ β ≫ σ) φ rfl)
      (hprin Z (φ ≫ β ≫ σ) (φ ≫ β) (Category.assoc _ _ _))

theorem wcpa_dj_stc_tu_ps_regular : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A],
    IsRegularLocalRing (PowerSeries A) :=
by
  intro A _ _
  classical
  have hA := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  have hXm : (PowerSeries.X : PowerSeries A) ∈ IsLocalRing.maximalIdeal (PowerSeries A) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
    simp
  have hCm : ∀ a ∈ IsLocalRing.maximalIdeal A,
      (PowerSeries.C a : PowerSeries A) ∈ IsLocalRing.maximalIdeal (PowerSeries A) := by
    intro a ha
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha
    simpa using ha
  have hc0 : ∀ φ ∈ IsLocalRing.maximalIdeal (PowerSeries A),
      PowerSeries.constantCoeff φ ∈ IsLocalRing.maximalIdeal A := by
    intro φ hφ
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hφ ⊢
    rwa [PowerSeries.isUnit_iff_constantCoeff] at hφ
  have hXl : ∀ y : PowerSeries A, PowerSeries.X * y = 0 → y = 0 := fun y hy =>
    PowerSeries.X_mul_injective (by simp only; rw [hy, mul_zero])
  have hXr : ∀ y : PowerSeries A, y * PowerSeries.X = 0 → y = 0 := fun y hy =>
    PowerSeries.mul_X_cancel (by rw [hy, zero_mul])
  have hXnzd : (PowerSeries.X : PowerSeries A) ∈ nonZeroDivisors (PowerSeries A) :=
    mem_nonZeroDivisors_iff.mpr ⟨hXl, hXr⟩
  have hker : RingHom.ker (PowerSeries.constantCoeff (R := A)) =
      Ideal.span {(PowerSeries.X : PowerSeries A)} := by
    ext φ
    rw [RingHom.mem_ker, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff]
  have hquot : ringKrullDim (PowerSeries A ⧸ Ideal.span {(PowerSeries.X : PowerSeries A)}) =
      ringKrullDim A := by
    have e : PowerSeries A ⧸ Ideal.span {(PowerSeries.X : PowerSeries A)} ≃+* A :=
      (Ideal.quotEquivOfEq hker.symm).trans
        (RingHom.quotientKerEquivOfSurjective PowerSeries.constantCoeff_surj)
    exact ringKrullDim_eq_of_ringEquiv e
  have hdimB := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    hXnzd hXm
  rw [hquot, ← hA] at hdimB
  obtain ⟨s, hs_card, hs_span⟩ :=
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A)).exists_span_set_encard_eq_spanFinrank
  have hs_fin : s.Finite := Set.finite_of_encard_eq_coe hs_card
  have hs_ncard : s.ncard = Submodule.spanFinrank (IsLocalRing.maximalIdeal A) := by
    have := hs_fin.cast_ncard_eq
    rw [hs_card] at this
    exact_mod_cast this
  have hmB : IsLocalRing.maximalIdeal (PowerSeries A) =
      Ideal.span (insert PowerSeries.X ((PowerSeries.C : A →+* PowerSeries A) '' s)) := by
    apply le_antisymm
    · intro φ hφ
      have h0 := hc0 φ hφ
      rw [← hs_span] at h0
      have h1 : PowerSeries.C (PowerSeries.constantCoeff φ) ∈
          Ideal.span ((PowerSeries.C : A →+* PowerSeries A) '' s) := by
        rw [← Ideal.map_span]
        exact Ideal.mem_map_of_mem _ h0
      have h2 : φ - PowerSeries.C (PowerSeries.constantCoeff φ) ∈
          Ideal.span {(PowerSeries.X : PowerSeries A)} := by
        rw [PowerSeries.sub_const_eq_X_mul_shift, Ideal.mem_span_singleton]
        exact dvd_mul_right _ _
      rw [Ideal.span_insert]
      have e : φ = (φ - PowerSeries.C (PowerSeries.constantCoeff φ)) +
          PowerSeries.C (PowerSeries.constantCoeff φ) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left h2) (Ideal.mem_sup_right h1)
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | ⟨a, ha, rfl⟩
      · exact hXm
      · apply hCm
        rw [← hs_span]
        exact Submodule.subset_span ha
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [← hdimB, hmB]
  have hle : Submodule.spanFinrank
      (Ideal.span (insert PowerSeries.X ((PowerSeries.C : A →+* PowerSeries A) '' s))) ≤
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) + 1 := by
    calc _ ≤ (insert PowerSeries.X ((PowerSeries.C : A →+* PowerSeries A) '' s)).ncard :=
          Submodule.spanFinrank_span_le_ncard_of_finite ((hs_fin.image _).insert _)
      _ ≤ ((PowerSeries.C : A →+* PowerSeries A) '' s).ncard + 1 := Set.ncard_insert_le _ _
      _ ≤ s.ncard + 1 := by gcongr; exact Set.ncard_image_le hs_fin
      _ = _ := by rw [hs_ncard]
  exact_mod_cast hle

theorem wcpa_dj_stc_tu_ps_complete : ∀ (A : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A], IsAdicComplete (IsLocalRing.maximalIdeal A) A →
    IsAdicComplete (IsLocalRing.maximalIdeal (PowerSeries A)) (PowerSeries A) :=
by
  intro A _ _ _ hA
  have tr : ∀ {R : Type u} [CommRing R] (I : Ideal R) (n : ℕ) (x y : R),
      (x ≡ y [SMOD (I ^ n • ⊤ : Submodule R R)]) ↔ x - y ∈ I ^ n := by
    intro R _ I n x y
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
  set m := IsLocalRing.maximalIdeal A with hm
  set M := IsLocalRing.maximalIdeal (PowerSeries A) with hM
  have s0 : ∀ f : PowerSeries A, f ∈ M ↔ PowerSeries.constantCoeff f ∈ m := by
    intro f
    rw [hM, hm, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
  have s1 : ∀ (n : ℕ) (f : PowerSeries A), f ∈ M ^ n →
      ∀ k : ℕ, PowerSeries.coeff k f ∈ m ^ (n - k) := by
    intro n
    induction n with
    | zero => intro f _ k; simp
    | succ n ih =>
      intro f hf
      rw [pow_succ] at hf
      refine Submodule.mul_induction_on
        (C := fun f => ∀ k : ℕ, PowerSeries.coeff k f ∈ m ^ (n + 1 - k)) hf ?_ ?_
      · intro a ha b hb k
        rw [PowerSeries.coeff_mul]
        refine Ideal.sum_mem _ (fun p hp => ?_)
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have h1 := ih a ha p.1
        have h2 : PowerSeries.coeff p.2 b ∈ m ^ (1 - p.2) := by
          rcases Nat.eq_zero_or_pos p.2 with h | h
          · rw [h, PowerSeries.coeff_zero_eq_constantCoeff_apply]
            simpa using (s0 b).mp hb
          · rw [show 1 - p.2 = 0 by omega]; simp
        have h3 := Ideal.mul_mem_mul h1 h2
        rw [← pow_add] at h3
        exact Ideal.pow_le_pow_right (by omega) h3
      · intro x y hx hy k
        rw [map_add]; exact Ideal.add_mem _ (hx k) (hy k)
  have hX : (PowerSeries.X : PowerSeries A) ∈ M := by rw [s0]; simp
  have hC : ∀ (j : ℕ) (a : A), a ∈ m ^ j → PowerSeries.C (R := A) a ∈ M ^ j := by
    intro j a ha
    have hmap : Ideal.map (PowerSeries.C (R := A)) m ≤ M := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, s0]; simpa using hx
    have : Ideal.map (PowerSeries.C (R := A)) (m ^ j) ≤ M ^ j := by
      rw [Ideal.map_pow]; exact Ideal.pow_right_mono hmap j
    exact this (Ideal.mem_map_of_mem _ ha)
  have s2 : ∀ (n : ℕ) (f : PowerSeries A), (∀ k, PowerSeries.coeff k f ∈ m ^ (n - k)) →
      f ∈ M ^ n := by
    intro n f hf
    have hdec : f = ∑ k ∈ Finset.range n,
        PowerSeries.C (R := A) (PowerSeries.coeff k f) * PowerSeries.X ^ k
        + PowerSeries.X ^ n * PowerSeries.mk (fun j => PowerSeries.coeff (j + n) f) := by
      ext d
      rw [map_add, map_sum]
      simp only [PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow, PowerSeries.coeff_X_pow_mul',
        PowerSeries.coeff_mk, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_range]
      by_cases hd : d < n
      · rw [if_pos hd, if_neg (by omega), add_zero]
      · rw [if_neg hd, if_pos (by omega), zero_add, Nat.sub_add_cancel (by omega)]
    rw [hdec]
    refine Ideal.add_mem _ (Ideal.sum_mem _ (fun k hk => ?_))
      (Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hX n))
    have hk' : k < n := Finset.mem_range.mp hk
    have := Ideal.mul_mem_mul (hC _ _ (hf k)) (Ideal.pow_mem_pow hX k)
    rwa [← pow_add, Nat.sub_add_cancel hk'.le] at this
  have hH : IsHausdorff M (PowerSeries A) := by
    refine ⟨fun x hx => ?_⟩
    ext k
    rw [map_zero]
    refine IsHausdorff.haus hA.toIsHausdorff _ (fun N => ?_)
    rw [tr, sub_zero]
    have hxN : x ∈ M ^ (N + k) := by
      have := (tr M (N + k) x 0).mp (hx (N + k)); rwa [sub_zero] at this
    have := s1 (N + k) x hxN k
    rwa [Nat.add_sub_cancel] at this
  have hP : IsPrecomplete M (PowerSeries A) := by
    refine ⟨fun F hF => ?_⟩
    have hc : ∀ k : ℕ, ∃ L : A, ∀ n,
        PowerSeries.coeff k (F (n + k)) ≡ L [SMOD (m ^ n • ⊤ : Submodule A A)] := by
      intro k
      refine IsPrecomplete.prec hA.toIsPrecomplete
        (f := fun n => PowerSeries.coeff k (F (n + k))) (fun {a b} hab => ?_)
      show PowerSeries.coeff k (F (a + k)) ≡ PowerSeries.coeff k (F (b + k))
        [SMOD (m ^ a • ⊤ : Submodule A A)]
      rw [tr, ← map_sub]
      have h1 := (tr M (a + k) _ _).mp (hF (show a + k ≤ b + k by omega))
      have := s1 (a + k) _ h1 k
      rwa [Nat.add_sub_cancel] at this
    choose L hL using hc
    refine ⟨PowerSeries.mk L, fun n => ?_⟩
    rw [tr]
    refine s2 n _ (fun k => ?_)
    rw [map_sub, PowerSeries.coeff_mk]
    by_cases hkn : k ≤ n
    · have := (tr m (n - k) _ _).mp (hL k (n - k))
      rwa [Nat.sub_add_cancel hkn] at this
    · rw [show n - k = 0 by omega]; simp
  exact { toIsHausdorff := hH, toIsPrecomplete := hP }

theorem wcpa_dj_stc_tu_no_root : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsDomain A] (h : A),
    h ∈ IsLocalRing.maximalIdeal A → h ≠ 0 →
    ∀ a : PowerSeries A, a ^ 2 - PowerSeries.X * a + PowerSeries.C h ≠ 0 :=
by
  intro A _ _ _ h hm hh0 a hE
  have c0 := congrArg (PowerSeries.coeff 0) hE
  have c1 := congrArg (PowerSeries.coeff 1) hE
  have c2 := congrArg (PowerSeries.coeff 2) hE
  simp only [map_sub, map_add, map_zero, pow_two, PowerSeries.coeff_mul, PowerSeries.coeff_C,
    PowerSeries.coeff_X, Finset.Nat.sum_antidiagonal_succ, Finset.Nat.antidiagonal_zero,
    Finset.sum_singleton, zero_add, Nat.reduceAdd, Nat.reduceEqDiff, ↓reduceIte,
    one_ne_zero, OfNat.ofNat_ne_zero, mul_one, mul_zero, one_mul, zero_mul, add_zero,
    sub_zero] at c0 c1 c2
  have ha0 : PowerSeries.coeff 0 a ≠ 0 := by
    intro h0
    apply hh0
    rw [h0] at c0
    linear_combination c0
  have h3 : 2 * PowerSeries.coeff 1 a - 1 = 0 := by
    have : PowerSeries.coeff 0 a * (2 * PowerSeries.coeff 1 a - 1) = 0 := by
      linear_combination c1
    exact (mul_eq_zero.mp this).resolve_left ha0
  have h4 : PowerSeries.coeff 0 a * (8 * PowerSeries.coeff 2 a) = 1 := by
    linear_combination 4 * c2 - (2 * PowerSeries.coeff 1 a - 1) * h3
  have hu : IsUnit (PowerSeries.coeff 0 a) := IsUnit.of_mul_eq_one _ h4
  have hh : h = -(PowerSeries.coeff 0 a ^ 2) := by linear_combination c0
  have hhu : IsUnit h := by rw [hh]; exact (hu.pow 2).neg
  exact ((IsLocalRing.mem_maximalIdeal _).mp hm) hhu

theorem wcpa_dj_stc_tu_adjoin_domain : ∀ (B : Type u) [CommRing B] [IsDomain B]
    [IsIntegrallyClosed B] (s h : B), (∀ a : B, a ^ 2 - s * a + h ≠ 0) →
    IsDomain (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C s * Polynomial.X + Polynomial.C h)) :=
by
  intro B _ _ _ s h hroot
  classical
  set f : Polynomial B := Polynomial.X ^ 2 - Polynomial.C s * Polynomial.X + Polynomial.C h
    with hf
  have hinj : Function.Injective (algebraMap B (FractionRing B)) :=
    IsFractionRing.injective B (FractionRing B)
  have hmon : f.Monic := by rw [hf]; monicity!
  have hdeg : f.natDegree = 2 := by rw [hf]; compute_degree!
  set g : Polynomial (FractionRing B) := f.map (algebraMap B (FractionRing B)) with hg
  have hgdeg : g.natDegree = 2 := by rw [hg, hmon.natDegree_map, hdeg]
  have hnoroot : ∀ x : FractionRing B, ¬ g.IsRoot x := by
    intro x hx
    have hx' : Polynomial.aeval x f = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map]; exact hx
    have hint : IsIntegral B x := ⟨f, hmon, by rw [← Polynomial.aeval_def]; exact hx'⟩
    obtain ⟨a, rfl⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    apply hroot a
    apply hinj
    rw [map_zero, ← hx']
    simp [hf]
  have hirr : Irreducible g :=
    Polynomial.irreducible_of_degree_le_three_of_not_isRoot (by rw [hgdeg]; decide) hnoroot
  have hprime : Prime g := hirr.prime
  have hfprime : Prime f := by
    refine ⟨hmon.ne_zero, fun hu => hirr.not_isUnit
      (hu.map (Polynomial.mapRingHom (algebraMap B (FractionRing B)))), ?_⟩
    intro p q hpq
    have h1 : g ∣ p.map (algebraMap B (FractionRing B)) * q.map (algebraMap B (FractionRing B)) := by
      rw [← Polynomial.map_mul]; exact Polynomial.map_dvd _ hpq
    rcases hprime.dvd_or_dvd h1 with h2 | h2
    · left; exact (Polynomial.map_dvd_map _ hinj hmon).mp h2
    · right; exact (Polynomial.map_dvd_map _ hinj hmon).mp h2
  exact AdjoinRoot.isDomain_of_prime hfprime

theorem wcpa_dj_stc_tu_weierstrass : ∀ (A : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A],
    IsAdicComplete (IsLocalRing.maximalIdeal (PowerSeries A)) (PowerSeries A) →
    ∀ h ∈ IsLocalRing.maximalIdeal A,
    ∃ Φ : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X * Polynomial.X +
        Polynomial.C (PowerSeries.C h) : Polynomial (PowerSeries A)) ≃+*
      (MvPowerSeries (Fin 2) A ⧸ Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C h}),
      Φ (AdjoinRoot.root _) = Ideal.Quotient.mk _ (MvPowerSeries.X 0) ∧
      Φ (AdjoinRoot.of _ PowerSeries.X) =
        Ideal.Quotient.mk _ (MvPowerSeries.X 0 + MvPowerSeries.X 1) ∧
      ∀ a : A, Φ (AdjoinRoot.of _ (PowerSeries.C a)) = Ideal.Quotient.mk _ (MvPowerSeries.C a) :=
by
  intro A _ _ _ hBc h hh
  classical

  have wquot : ∀ (B : Type u) [CommRing B] [IsLocalRing B],
      IsAdicComplete (IsLocalRing.maximalIdeal B) B → ∀ s c : B,
      s ∈ IsLocalRing.maximalIdeal B → c ∈ IsLocalRing.maximalIdeal B →
      ∃ Ψ : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C s * Polynomial.X + Polynomial.C c :
          Polynomial B) ≃+*
        (PowerSeries B ⧸ Ideal.span {PowerSeries.X ^ 2 - PowerSeries.C s * PowerSeries.X +
          PowerSeries.C c}),
        Ψ (AdjoinRoot.root _) = Ideal.Quotient.mk _ PowerSeries.X ∧
        ∀ b : B, Ψ (AdjoinRoot.of _ b) = Ideal.Quotient.mk _ (PowerSeries.C b) := by
    intro B _ _ hc s c hs hcm
    haveI := hc
    set p0 : Polynomial B := Polynomial.X ^ 2 - Polynomial.C s * Polynomial.X + Polynomial.C c
      with hp0
    set g : PowerSeries B := PowerSeries.X ^ 2 - PowerSeries.C s * PowerSeries.X + PowerSeries.C c
      with hg
    set I : Ideal (PowerSeries B) := Ideal.span {g} with hI
    have hmon : p0.Monic := by rw [hp0]; monicity!
    have hdeg : p0.degree = 2 := by rw [hp0]; compute_degree!
    have hcoe : ((p0 : Polynomial B) : PowerSeries B) = g := by
      rw [hp0, hg]
      simp only [Polynomial.coe_add, Polynomial.coe_sub, Polynomial.coe_mul, Polynomial.coe_pow,
        Polynomial.coe_X, Polynomial.coe_C]
    have hmap : PowerSeries.map (IsLocalRing.residue B) g = PowerSeries.X ^ 2 := by
      have h1 : IsLocalRing.residue B s = 0 := (IsLocalRing.residue_eq_zero_iff s).mpr hs
      have h2 : IsLocalRing.residue B c = 0 := (IsLocalRing.residue_eq_zero_iff c).mpr hcm
      rw [hg]
      simp [h1, h2]
    have hne : PowerSeries.map (IsLocalRing.residue B) g ≠ 0 := by
      rw [hmap]; exact pow_ne_zero _ PowerSeries.X_ne_zero
    have hord : (PowerSeries.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)) g).order.toNat
        = 2 := by
      change (PowerSeries.map (IsLocalRing.residue B) g).order.toNat = 2
      rw [hmap, PowerSeries.order_X_pow]
      rfl
    let i : B →+* PowerSeries B ⧸ I := (Ideal.Quotient.mk I).comp PowerSeries.C
    have hE : ∀ p : Polynomial B, Polynomial.eval₂ i (Ideal.Quotient.mk I PowerSeries.X) p =
        Ideal.Quotient.mk I (p : PowerSeries B) := by
      have : (Polynomial.eval₂RingHom i (Ideal.Quotient.mk I PowerSeries.X)) =
          (Ideal.Quotient.mk I).comp (Polynomial.coeToPowerSeries.ringHom) := by
        apply Polynomial.ringHom_ext
        · intro a
          simp [i, Polynomial.coeToPowerSeries.ringHom_apply]
        · simp [Polynomial.coeToPowerSeries.ringHom_apply]
      intro p
      have := congrArg (fun φ => φ p) this
      simpa [Polynomial.coeToPowerSeries.ringHom_apply] using this
    have hp0z : Polynomial.eval₂ i (Ideal.Quotient.mk I PowerSeries.X) p0 = 0 := by
      rw [hE, hcoe, Ideal.Quotient.eq_zero_iff_mem, hI]
      exact Ideal.mem_span_singleton_self g
    let j := AdjoinRoot.lift i (Ideal.Quotient.mk I PowerSeries.X) hp0z
    have hsurj : Function.Surjective j := by
      intro y
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨Q, r, hQr⟩ := PowerSeries.exists_isWeierstrassDivision F hne
      refine ⟨AdjoinRoot.mk p0 r, ?_⟩
      have h2 := ((PowerSeries.isWeierstrassDivisionAt_iff _ _ _ _ _).mp hQr).2
      rw [AdjoinRoot.lift_mk, hE, Ideal.Quotient.eq, h2, hI, Ideal.mem_span_singleton']
      exact ⟨-Q, by ring⟩
    have hinj : Function.Injective j := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective z
      rw [AdjoinRoot.lift_mk, hE, Ideal.Quotient.eq_zero_iff_mem, hI,
        Ideal.mem_span_singleton'] at hz
      obtain ⟨G, hG⟩ := hz
      have hdiv := Polynomial.modByMonic_add_div p p0
      have hr : ((p %ₘ p0 : Polynomial B) : PowerSeries B) =
          g * (G - ((p /ₘ p0 : Polynomial B) : PowerSeries B)) := by
        have : (p : PowerSeries B) = ((p %ₘ p0 : Polynomial B) : PowerSeries B) +
            g * ((p /ₘ p0 : Polynomial B) : PowerSeries B) := by
          rw [← hcoe, ← Polynomial.coe_mul, ← Polynomial.coe_add, hdiv]
        rw [mul_sub, mul_comm g G, hG, this]; ring
      have D1 : ((p %ₘ p0 : Polynomial B) : PowerSeries B).IsWeierstrassDivision g
          (G - ((p /ₘ p0 : Polynomial B) : PowerSeries B)) 0 := by
        refine PowerSeries.IsWeierstrassDivisionAt.mk ?_ ?_
        · rw [hord, Polynomial.degree_zero]; exact WithBot.bot_lt_coe 2
        · rw [Polynomial.coe_zero, add_zero]; exact hr
      have D2 : ((p %ₘ p0 : Polynomial B) : PowerSeries B).IsWeierstrassDivision g 0
          (p %ₘ p0) := by
        refine PowerSeries.IsWeierstrassDivisionAt.mk ?_ ?_
        · rw [hord]
          have := Polynomial.degree_modByMonic_lt p hmon
          rw [hdeg] at this
          exact this
        · simp
      have h0 := (PowerSeries.IsWeierstrassDivision.elim hne D1 D2).2
      rw [AdjoinRoot.mk_eq_zero]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd hmon).mp h0.symm
    refine ⟨RingEquiv.ofBijective j ⟨hinj, hsurj⟩, ?_, ?_⟩
    · show j (AdjoinRoot.root p0) = _
      exact AdjoinRoot.lift_root hp0z
    · intro b
      show j (AdjoinRoot.of p0 b) = _
      rw [AdjoinRoot.lift_of hp0z]
      rfl

  have shear : ∃ τ : MvPowerSeries (Fin 2) A ≃+* MvPowerSeries (Fin 2) A,
      τ (MvPowerSeries.X 0) = MvPowerSeries.X 0 ∧
      τ (MvPowerSeries.X 1) = MvPowerSeries.X 0 + MvPowerSeries.X 1 ∧
      ∀ a : A, τ (MvPowerSeries.C a) = MvPowerSeries.C a := by
    let a : Fin 2 → MvPowerSeries (Fin 2) A :=
      ![MvPowerSeries.X 0, MvPowerSeries.X 0 + MvPowerSeries.X 1]
    let b : Fin 2 → MvPowerSeries (Fin 2) A :=
      ![MvPowerSeries.X 0, MvPowerSeries.X 1 - MvPowerSeries.X 0]
    have ha : MvPowerSeries.HasSubst a :=
      MvPowerSeries.hasSubst_of_constantCoeff_zero (fun s => by fin_cases s <;> simp [a])
    have hb : MvPowerSeries.HasSubst b :=
      MvPowerSeries.hasSubst_of_constantCoeff_zero (fun s => by fin_cases s <;> simp [b])
    have hba : (fun s => MvPowerSeries.subst b (a s)) = MvPowerSeries.X := by
      funext s
      fin_cases s
      · simp [a, MvPowerSeries.subst_X hb, b]
      · simp [a, MvPowerSeries.subst_add hb, MvPowerSeries.subst_X hb, b]
    have hab : (fun s => MvPowerSeries.subst a (b s)) = MvPowerSeries.X := by
      funext s
      fin_cases s
      · simp [b, MvPowerSeries.subst_X ha, a]
      · simp [b, MvPowerSeries.subst_sub ha, MvPowerSeries.subst_X ha, a]
    have h1 : ∀ F : MvPowerSeries (Fin 2) A,
        MvPowerSeries.subst b (MvPowerSeries.subst a F) = F := by
      intro F
      rw [MvPowerSeries.subst_comp_subst_apply ha hb, hba, MvPowerSeries.subst_self]
      rfl
    have h2 : ∀ F : MvPowerSeries (Fin 2) A,
        MvPowerSeries.subst a (MvPowerSeries.subst b F) = F := by
      intro F
      rw [MvPowerSeries.subst_comp_subst_apply hb ha, hab, MvPowerSeries.subst_self]
      rfl
    refine ⟨RingEquiv.ofRingHom (MvPowerSeries.substAlgHom (R := A) ha).toRingHom
      (MvPowerSeries.substAlgHom (R := A) hb).toRingHom ?_ ?_, ?_, ?_, ?_⟩
    · ext1 F
      simp [MvPowerSeries.coe_substAlgHom, h2]
    · ext1 F
      simp [MvPowerSeries.coe_substAlgHom, h1]
    · simp [MvPowerSeries.subst_X ha, a]
    · simp [MvPowerSeries.subst_X ha, a]
    · intro r
      simp [MvPowerSeries.subst_C]

  have regroup : ∃ Θ : PowerSeries (PowerSeries A) ≃+* MvPowerSeries (Fin 2) A,
      Θ PowerSeries.X = MvPowerSeries.X 0 ∧ Θ (PowerSeries.C PowerSeries.X) = MvPowerSeries.X 1 ∧
      ∀ a : A, Θ (PowerSeries.C (PowerSeries.C a)) = MvPowerSeries.C a := by
    let e : ℕ → ℕ → (Fin 2 →₀ ℕ) := fun i j => Finsupp.single 0 i + Finsupp.single 1 j
    have e0 : ∀ i j, e i j 0 = i := by intro i j; simp [e]
    have e1 : ∀ i j, e i j 1 = j := by intro i j; simp [e]
    have ee : ∀ n : Fin 2 →₀ ℕ, e (n 0) (n 1) = n := by
      intro n; ext k; fin_cases k <;> simp [e]
    have einj : ∀ a b c d, e a b = e c d ↔ a = c ∧ b = d := by
      intro a b c d
      constructor
      · intro h
        exact ⟨by rw [← e0 a b, h, e0], by rw [← e1 a b, h, e1]⟩
      · rintro ⟨rfl, rfl⟩; rfl
    let f : PowerSeries (PowerSeries A) → MvPowerSeries (Fin 2) A :=
      fun G n => PowerSeries.coeff (n 1) (PowerSeries.coeff (n 0) G)
    let g : MvPowerSeries (Fin 2) A → PowerSeries (PowerSeries A) :=
      fun F => PowerSeries.mk fun i => PowerSeries.mk fun j => MvPowerSeries.coeff (e i j) F
    have hf : ∀ G n, MvPowerSeries.coeff n (f G) =
        PowerSeries.coeff (n 1) (PowerSeries.coeff (n 0) G) := fun _ _ => rfl
    have hfe : ∀ G a b, MvPowerSeries.coeff (e a b) (f G) =
        PowerSeries.coeff b (PowerSeries.coeff a G) := by
      intro G a b; rw [hf, e0, e1]
    have hgf : ∀ G, g (f G) = G := by
      intro G; ext i j; simp [g, hfe]
    have hfg : ∀ F, f (g F) = F := by
      intro F; ext n; rw [hf]; simp [g, ee]
    have hadd : ∀ G H, f (G + H) = f G + f H := by
      intro G H; ext n; simp [hf]
    have hmul : ∀ G H, f (G * H) = f G * f H := by
      intro G H; ext n
      rw [hf, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul, map_sum]
      simp_rw [PowerSeries.coeff_mul]
      rw [← Finset.sum_product']
      refine Finset.sum_nbij' (fun x => (e x.1.1 x.2.1, e x.1.2 x.2.2))
        (fun y => ((y.1 0, y.2 0), (y.1 1, y.2 1))) ?_ ?_ ?_ ?_ ?_
      · intro x hx
        obtain ⟨h1, h2⟩ := Finset.mem_product.mp hx
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at h1 h2
        rw [Finset.HasAntidiagonal.mem_antidiagonal]
        refine Finsupp.ext (Fin.forall_fin_two.mpr ⟨?_, ?_⟩)
        · rw [Finsupp.add_apply, e0, e0]; exact h1
        · rw [Finsupp.add_apply, e1, e1]; exact h2
      · intro y hy
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hy
        refine Finset.mem_product.mpr ⟨Finset.HasAntidiagonal.mem_antidiagonal.mpr ?_,
          Finset.HasAntidiagonal.mem_antidiagonal.mpr ?_⟩
        · show y.1 0 + y.2 0 = n 0
          rw [← hy, Finsupp.add_apply]
        · show y.1 1 + y.2 1 = n 1
          rw [← hy, Finsupp.add_apply]
      · intro x _
        show ((e x.1.1 x.2.1 0, e x.1.2 x.2.2 0), (e x.1.1 x.2.1 1, e x.1.2 x.2.2 1)) = x
        rw [e0, e0, e1, e1]
      · intro y _
        show (e (y.1 0) (y.1 1), e (y.2 0) (y.2 1)) = y
        rw [ee, ee]
      · intro x _
        show PowerSeries.coeff x.2.1 (PowerSeries.coeff x.1.1 G) *
            PowerSeries.coeff x.2.2 (PowerSeries.coeff x.1.2 H) =
          MvPowerSeries.coeff (e x.1.1 x.2.1) (f G) * MvPowerSeries.coeff (e x.1.2 x.2.2) (f H)
        rw [hfe, hfe]
    let Θ : PowerSeries (PowerSeries A) ≃+* MvPowerSeries (Fin 2) A :=
      { toFun := f, invFun := g, left_inv := hgf, right_inv := hfg, map_mul' := hmul,
        map_add' := hadd }
    have hΘ : ∀ G, Θ G = f G := fun _ => rfl
    refine ⟨Θ, ?_, ?_, ?_⟩
    · ext n; rw [← ee n, hΘ, hfe, MvPowerSeries.coeff_X]
      have : Finsupp.single (0 : Fin 2) 1 = e 1 0 := by simp [e]
      rw [this]
      simp only [einj]
      rw [PowerSeries.coeff_X]
      by_cases ha : n 0 = 1 <;> by_cases hb : n 1 = 0 <;> simp [ha, hb, PowerSeries.coeff_one]
    · ext n; rw [← ee n, hΘ, hfe, MvPowerSeries.coeff_X]
      have : Finsupp.single (1 : Fin 2) 1 = e 0 1 := by simp [e]
      rw [this]
      simp only [einj]
      rw [PowerSeries.coeff_C]
      by_cases ha : n 0 = 0 <;> by_cases hb : n 1 = 1 <;> simp [ha, hb, PowerSeries.coeff_X]
    · intro r
      ext n; rw [← ee n, hΘ, hfe, MvPowerSeries.coeff_C]
      have : (0 : Fin 2 →₀ ℕ) = e 0 0 := by simp [e]
      rw [this]
      simp only [einj]
      rw [PowerSeries.coeff_C]
      by_cases ha : n 0 = 0 <;> by_cases hb : n 1 = 0 <;> simp [ha, hb, PowerSeries.coeff_C]

  have hS : (PowerSeries.X : PowerSeries A) ∈ IsLocalRing.maximalIdeal (PowerSeries A) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff,
      PowerSeries.constantCoeff_X]
    exact not_isUnit_zero
  have hCh : (PowerSeries.C h : PowerSeries A) ∈ IsLocalRing.maximalIdeal (PowerSeries A) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff,
      PowerSeries.constantCoeff_C]
    exact (IsLocalRing.mem_maximalIdeal _).mp hh
  obtain ⟨Ψ₁, h1r, h1o⟩ := wquot (PowerSeries A) hBc PowerSeries.X (PowerSeries.C h) hS hCh
  obtain ⟨Θ, hΘ0, hΘ1, hΘC⟩ := regroup
  obtain ⟨τ, hτ0, hτ1, hτC⟩ := shear
  let Ψ : PowerSeries (PowerSeries A) ≃+* MvPowerSeries (Fin 2) A := Θ.trans τ
  have hΨX : Ψ PowerSeries.X = MvPowerSeries.X 0 := by
    show τ (Θ PowerSeries.X) = _
    rw [hΘ0, hτ0]
  have hΨS : Ψ (PowerSeries.C PowerSeries.X) = MvPowerSeries.X 0 + MvPowerSeries.X 1 := by
    show τ (Θ (PowerSeries.C PowerSeries.X)) = _
    rw [hΘ1, hτ1]
  have hΨC : ∀ a : A, Ψ (PowerSeries.C (PowerSeries.C a)) = MvPowerSeries.C a := by
    intro a
    show τ (Θ (PowerSeries.C (PowerSeries.C a))) = _
    rw [hΘC, hτC]
  have hΨq : Ψ (PowerSeries.X ^ 2 - PowerSeries.C PowerSeries.X * PowerSeries.X +
      PowerSeries.C (PowerSeries.C h)) =
      -(MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h) := by
    rw [map_add, map_sub, map_mul, map_pow, hΨX, hΨS, hΨC]
    ring
  have hIJ : Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
      MvPowerSeries.C h} = Ideal.map (Ψ : PowerSeries (PowerSeries A) →+* MvPowerSeries (Fin 2) A)
      (Ideal.span {PowerSeries.X ^ 2 - PowerSeries.C PowerSeries.X * PowerSeries.X +
        PowerSeries.C (PowerSeries.C h)}) := by
    rw [Ideal.map_span, Set.image_singleton]
    have : (Ψ : PowerSeries (PowerSeries A) →+* MvPowerSeries (Fin 2) A)
        (PowerSeries.X ^ 2 - PowerSeries.C PowerSeries.X * PowerSeries.X +
          PowerSeries.C (PowerSeries.C h)) =
        -(MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h) := hΨq
    rw [this, Ideal.span_singleton_neg]
  let Ψ₂ := Ideal.quotientEquiv _ _ Ψ hIJ
  refine ⟨Ψ₁.trans Ψ₂, ?_, ?_, ?_⟩
  · rw [RingEquiv.trans_apply, h1r]
    show Ideal.Quotient.mk _ (Ψ PowerSeries.X) = _
    rw [hΨX]
  · rw [RingEquiv.trans_apply, h1o]
    show Ideal.Quotient.mk _ (Ψ (PowerSeries.C PowerSeries.X)) = _
    rw [hΨS]
  · intro a
    rw [RingEquiv.trans_apply, h1o]
    show Ideal.Quotient.mk _ (Ψ (PowerSeries.C (PowerSeries.C a))) = _
    rw [hΨC]

theorem wcpa_dj_stc_tu_krull_criterion : ∀ (B R : Type u) [CommRing B] [IsDomain B]
    [UniqueFactorizationMonoid B] [IsNoetherianRing B] [CommRing R] [IsDomain R] [Algebra B R]
    [Module.Free B R] [Module.Finite B R] (b r : R), b ≠ 0 →
    (∀ Q : Ideal R, Q.IsPrime → Q.height = 1 → ∃ s ∉ Q, s * r ∈ Ideal.span {b}) →
    r ∈ Ideal.span {b} :=
by
  intro B R _ _ _ _ _ _ _ _ _ b r hb H
  classical
  haveI hint : Algebra.IsIntegral B R := Algebra.IsIntegral.of_finite B R
  haveI : FaithfulSMul B R := Module.Free.instFaithfulSMulOfNontrivial B R
  have hinj : Function.Injective (algebraMap B R) := FaithfulSMul.algebraMap_injective B R

  have hne : Ideal.comap (algebraMap B R) (Ideal.span {b}) ≠ ⊥ := by
    have := Ideal.under_ne_bot_of_integral_mem (R := B) hb (Ideal.mem_span_singleton_self b)
      (Algebra.IsIntegral.isIntegral b)
    simpa [Ideal.under_def] using this
  obtain ⟨c, hc, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  rw [Ideal.mem_comap, Ideal.mem_span_singleton'] at hc
  obtain ⟨b', hb'⟩ := hc
  have hφc : algebraMap B R c ≠ 0 := fun h => hc0 (hinj (h.trans (map_zero _).symm))
  have hb'0 : b' ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hb'
    exact hφc hb'.symm

  have s2 : ∀ z : R, z ∈ Ideal.span {b} ↔ b' * z ∈ Ideal.span {algebraMap B R c} := by
    intro z
    simp only [Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨a, by rw [← hb']; ring⟩
    · rintro ⟨a, ha⟩
      refine ⟨a, ?_⟩
      apply mul_left_cancel₀ hb'0
      rw [← ha, ← hb']
      ring

  let bs := Module.Free.chooseBasis B R
  have s3 : ∀ y : R, y ∈ Ideal.span {algebraMap B R c} ↔ ∀ i, c ∣ bs.repr y i := by
    intro y
    rw [Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, rfl⟩ i
      have : a * algebraMap B R c = c • a := by rw [Algebra.smul_def, mul_comm]
      rw [this, map_smul, Finsupp.smul_apply, smul_eq_mul]
      exact dvd_mul_right _ _
    · intro h
      choose x hx using h
      refine ⟨∑ i, x i • bs i, ?_⟩
      rw [mul_comm, ← Algebra.smul_def, Finset.smul_sum]
      conv_rhs => rw [← bs.sum_repr y]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_smul, hx i]

  have s4 : ∀ π : B, Prime π → ∀ Q : Ideal R, Q.IsPrime →
      Ideal.comap (algebraMap B R) Q = Ideal.span {π} → Q.height = 1 := by
    intro π hπ Q hQ hQπ
    have hπQ : algebraMap B R π ∈ Q := by
      rw [← Ideal.mem_comap, hQπ]
      exact Ideal.mem_span_singleton_self π
    have hπ0 : algebraMap B R π ≠ 0 := fun h => hπ.ne_zero (hinj (h.trans (map_zero _).symm))
    have hQbot : Q ≠ ⊥ := fun h => hπ0 (by rw [h] at hπQ; exact (Submodule.mem_bot R).mp hπQ)
    have h0 : Q.height ≠ 0 := by
      intro h
      rw [Ideal.height_eq_zero_iff, IsDomain.minimalPrimes_eq_singleton_bot] at h
      exact hQbot h
    have h1 : Q.height ≤ 1 := by
      rw [show (1 : ℕ∞) = ((1 : ℕ) : ℕ∞) from rfl, Ideal.height_le_iff]
      intro q hq hqQ
      by_contra hcon
      have hqbot : q ≠ ⊥ := by
        rintro rfl
        rw [Ideal.height_bot] at hcon
        exact hcon (by norm_num)
      obtain ⟨x, hxQ, hxq⟩ := SetLike.exists_of_lt hqQ
      have hlt : Ideal.comap (algebraMap B R) q < Ideal.comap (algebraMap B R) Q := by
        have := Ideal.under_lt_under_of_integral_mem_sdiff (R := B) hqQ.le ⟨hxQ, hxq⟩
          (Algebra.IsIntegral.isIntegral x)
        simpa [Ideal.under_def] using this
      obtain ⟨y, hyq, hy0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hqbot
      have hcq : Ideal.comap (algebraMap B R) q ≠ ⊥ := by
        have := Ideal.under_ne_bot_of_integral_mem (R := B) hy0 hyq
          (Algebra.IsIntegral.isIntegral y)
        simpa [Ideal.under_def] using this
      haveI : (Ideal.comap (algebraMap B R) q).IsPrime := Ideal.IsPrime.comap _
      obtain ⟨p', hp'mem, hp'⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot this hcq
      have hdvd : π ∣ p' := by
        have := hlt.le hp'mem
        rw [hQπ, Ideal.mem_span_singleton] at this
        exact this
      have hass := hπ.associated_of_dvd hp' hdvd
      have hπmem : π ∈ Ideal.comap (algebraMap B R) q := by
        obtain ⟨u, hu⟩ := hass.symm
        rw [← hu]
        exact Ideal.mul_mem_right _ _ hp'mem
      rw [hQπ] at hlt
      exact lt_irrefl _ (lt_of_le_of_lt ((Ideal.span_singleton_le_iff_mem _).mpr hπmem) hlt)
    rcases ENat.le_one_iff_eq_zero_or_eq_one.mp h1 with h | h
    · exact absurd h h0
    · exact h

  have s5 : ∀ (c w : B), c ≠ 0 → (∀ π : B, Prime π → ∃ t : B, ¬ π ∣ t ∧ c ∣ t * w) →
      c ∣ w := by
    intro c w
    induction c using UniqueFactorizationMonoid.induction_on_prime
    · intro h
      exact absurd rfl h
    · rename_i x hx
      intro _ _
      exact hx.dvd
    · rename_i a p ha hp ih
      intro _ hH
      obtain ⟨w', rfl⟩ := ih ha (fun π hπ => by
        obtain ⟨t, ht, hd⟩ := hH π hπ
        exact ⟨t, ht, dvd_trans (dvd_mul_left a p) hd⟩)
      obtain ⟨t, ht, hd⟩ := hH p hp
      have hpt : p ∣ t * w' := by
        have h2 : p * a ∣ (t * w') * a := by
          have e : t * (a * w') = (t * w') * a := by ring
          rwa [e] at hd
        exact (mul_dvd_mul_iff_right ha).mp h2
      rcases hp.dvd_or_dvd hpt with h | h
      · exact absurd h ht
      · rw [mul_comm a w']
        exact mul_dvd_mul_right h a

  have s6 : ∀ π : B, Prime π → ∃ t : B, ¬ π ∣ t ∧ algebraMap B R t * r ∈ Ideal.span {b} := by
    intro π hπ
    by_contra hcon
    push_neg at hcon
    let J : Ideal R := (Ideal.span {b}).colon (Ideal.span {r})
    have hJ : ∀ x, x ∈ J ↔ x * r ∈ Ideal.span {b} := fun x => Ideal.mem_colon_span_singleton
    haveI hP : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
    have hle : Ideal.comap (algebraMap B R) J ≤ Ideal.span {π} := by
      intro t ht
      rw [Ideal.mem_comap, hJ] at ht
      rw [Ideal.mem_span_singleton]
      by_contra hd
      exact hcon t hd ht
    obtain ⟨Q, hJQ, hQ, hQπ⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (Ideal.span {π}) J
      (by simpa [Ideal.under_def] using hle)
    have hQ1 := s4 π hπ Q hQ (by simpa [Ideal.under_def] using hQπ)
    obtain ⟨s, hsQ, hs⟩ := H Q hQ hQ1
    exact hsQ (hJQ ((hJ s).mpr hs))

  have key : ∀ i, c ∣ bs.repr (b' * r) i := by
    intro i
    apply s5 c _ hc0
    intro π hπ
    obtain ⟨t, ht, htr⟩ := s6 π hπ
    refine ⟨t, ht, ?_⟩
    have h1 := (s3 _).mp ((s2 _).mp htr) i
    have h2 : b' * (algebraMap B R t * r) = t • (b' * r) := by
      rw [Algebra.smul_def]
      ring
    rw [h2, map_smul, Finsupp.smul_apply, smul_eq_mul] at h1
    exact h1
  exact (s2 r).mpr ((s3 _).mpr key)

theorem wcpa_dj_stc_tu_axis_ker : ∀ (A : Type u) [CommRing A] (b h : A), b ∣ h → ∀ σ : Fin 2, ∃ ρ : (MvPowerSeries (Fin 2) A ⧸ Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) →+* PowerSeries (A ⧸ Ideal.span {b}), RingHom.ker ρ = Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.X σ), Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.C b)} ∧ (∀ a : A, ρ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.C a)) = PowerSeries.C (Ideal.Quotient.mk (Ideal.span {b}) a)) ∧ ∀ i : Fin 2, i ≠ σ → ρ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.X i)) = PowerSeries.X :=
by
  intro A _ b h hbh σ
  classical

  have axis : ∀ (s : Fin 2), ∃ φ : MvPowerSeries (Fin 2) A →+* PowerSeries A,
      ∀ (F : MvPowerSeries (Fin 2) A) (j : ℕ),
        PowerSeries.coeff j (φ F) = MvPowerSeries.coeff (Finsupp.single s j) F := by
    intro s
    refine ⟨{ toFun := fun F => PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single s j) F),
              map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ }, ?_⟩
    · ext j
      rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
      by_cases hj : j = 0
      · subst hj; simp
      · rw [if_neg (by simpa using hj), if_neg hj]
    · intro F G
      ext j
      rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
        Finsupp.antidiagonal_single, Finset.sum_map]
      simp [PowerSeries.coeff_mk]
    · ext j; simp
    · intro F G; ext j; simp
    · intro F j; simp [PowerSeries.coeff_mk]

  have decomp : ∀ (F : MvPowerSeries (Fin 2) A),
      (∀ m : Fin 2 →₀ ℕ, m σ = 0 → b ∣ MvPowerSeries.coeff m F) →
      ∃ G H : MvPowerSeries (Fin 2) A, F = MvPowerSeries.X σ * G + MvPowerSeries.C b * H := by
    intro F hF
    obtain ⟨G, hG⟩ : ∃ G : MvPowerSeries (Fin 2) A, ∀ m,
        MvPowerSeries.coeff m G = MvPowerSeries.coeff (m + Finsupp.single σ 1) F :=
      ⟨fun m => MvPowerSeries.coeff (m + Finsupp.single σ 1) F, fun m => rfl⟩
    obtain ⟨H, hH0, hH1⟩ : ∃ H : MvPowerSeries (Fin 2) A,
        (∀ m, m σ = 0 → MvPowerSeries.coeff m F = b * MvPowerSeries.coeff m H) ∧
        (∀ m, m σ ≠ 0 → MvPowerSeries.coeff m H = 0) :=
      ⟨fun m => if hm : m σ = 0 then (hF m hm).choose else 0,
        fun m hm => by
          show _ = b * (if hm : m σ = 0 then (hF m hm).choose else 0)
          rw [dif_pos hm]
          exact (hF m hm).choose_spec,
        fun m hm => by
          show (if hm : m σ = 0 then (hF m hm).choose else 0) = 0
          rw [dif_neg hm]⟩
    refine ⟨G, H, ?_⟩
    ext m
    rw [map_add, MvPowerSeries.coeff_C_mul, MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul]
    by_cases hm : m σ = 0
    · have hle : ¬ Finsupp.single σ 1 ≤ m := by rw [Finsupp.single_le_iff]; omega
      rw [if_neg hle, zero_add, hH0 m hm]
    · have hle : Finsupp.single σ 1 ≤ m := by rw [Finsupp.single_le_iff]; omega
      rw [if_pos hle, hG, tsub_add_cancel_of_le hle, hH1 m hm]
      ring

  obtain ⟨σ', hσ'σ, hσ'⟩ : ∃ σ' : Fin 2, σ' ≠ σ ∧ ∀ i : Fin 2, i ≠ σ → i = σ' := by
    fin_cases σ
    · exact ⟨1, by decide, fun i hi => by fin_cases i <;> simp_all⟩
    · exact ⟨0, by decide, fun i hi => by fin_cases i <;> simp_all⟩
  obtain ⟨φ, hφ⟩ := axis σ'
  set q := Ideal.Quotient.mk (Ideal.span {b}) with hq
  set ρ₀ := (PowerSeries.map q).comp φ with hρ₀
  have hstar : ∀ F j, PowerSeries.coeff j (ρ₀ F) =
      q (MvPowerSeries.coeff (Finsupp.single σ' j) F) := by
    intro F j
    rw [hρ₀, RingHom.comp_apply, PowerSeries.coeff_map, hφ]
  have v1 : ∀ a, ρ₀ (MvPowerSeries.C a) = PowerSeries.C (q a) := by
    intro a
    ext j
    rw [hstar, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
    by_cases hj : j = 0
    · subst hj; simp
    · rw [if_neg (by simpa using hj), if_neg hj, map_zero]
  have v2 : ρ₀ (MvPowerSeries.X σ') = PowerSeries.X := by
    ext j
    rw [hstar, MvPowerSeries.coeff_X, PowerSeries.coeff_X]
    by_cases hj : j = 1
    · subst hj; simp
    · rw [if_neg (fun h' => hj (Finsupp.single_injective σ' h')), if_neg hj, map_zero]
  have v3 : ρ₀ (MvPowerSeries.X σ) = 0 := by
    ext j
    rw [hstar, MvPowerSeries.coeff_X, map_zero, if_neg, map_zero]
    intro h'
    have := congrArg (fun f => f σ) h'
    simp [hσ'σ] at this
  have hqb : q b = 0 := (Ideal.Quotient.eq_zero_iff_dvd _ _).mpr dvd_rfl
  have hqh : q h = 0 := (Ideal.Quotient.eq_zero_iff_dvd _ _).mpr hbh
  have v5 : ρ₀ (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h) = 0 := by
    rw [map_sub, map_mul, v1, hqh, map_zero, sub_zero]
    rcases (show σ = 0 ∨ σ = 1 by fin_cases σ <;> simp) with rfl | rfl
    · rw [v3, zero_mul]
    · rw [v3, mul_zero]
  have hH : ∀ a ∈ Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
      MvPowerSeries.C h}, ρ₀ a = 0 := by
    intro a ha
    obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, v5, mul_zero]
  refine ⟨Ideal.Quotient.lift _ ρ₀ hH, ?_, ?_, ?_⟩
  · apply le_antisymm
    · intro r hr
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [RingHom.mem_ker, Ideal.Quotient.lift_mk] at hr
      have hdiv : ∀ m : Fin 2 →₀ ℕ, m σ = 0 → b ∣ MvPowerSeries.coeff m F := by
        intro m hm
        have hm' : m = Finsupp.single σ' (m σ') := by
          ext i
          by_cases hi : i = σ
          · subst hi; simp [hm, hσ'σ]
          · rw [hσ' i hi]; simp
        have e := hstar F (m σ')
        rw [hr, map_zero, ← hm'] at e
        exact (Ideal.Quotient.eq_zero_iff_dvd _ _).mp e.symm
      obtain ⟨G, H, hFGH⟩ := decomp F hdiv
      rw [hFGH, map_add, map_mul, map_mul]
      exact Ideal.mem_span_pair.mpr ⟨Ideal.Quotient.mk _ G, Ideal.Quotient.mk _ H, by ring⟩
    · rw [Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with rfl | hx
      · rw [SetLike.mem_coe, RingHom.mem_ker, Ideal.Quotient.lift_mk, v3]
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        rw [SetLike.mem_coe, RingHom.mem_ker, Ideal.Quotient.lift_mk, v1, hqb, map_zero]
  · intro a
    rw [Ideal.Quotient.lift_mk, v1]
  · intro i hi
    rw [hσ' i hi, Ideal.Quotient.lift_mk, v2]

theorem wcpa_dj_stc_tu_reduce_ker : ∀ (A : Type u) [CommRing A] (b h : A), ∃ ψ : (MvPowerSeries (Fin 2) A ⧸ Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) →+* (MvPowerSeries (Fin 2) (A ⧸ Ideal.span {b}) ⧸ Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {b}) h)}), RingHom.ker ψ = Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.C b)} ∧ (∀ a : A, ψ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.C a)) = Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {b}) h)}) (MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {b}) a))) ∧ ∀ i : Fin 2, ψ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.X i)) = Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {b}) h)}) (MvPowerSeries.X i) :=
by
  intro A _ b h
  classical
  set q : A →+* A ⧸ Ideal.span {b} := Ideal.Quotient.mk (Ideal.span {b}) with hq
  set I : Ideal (MvPowerSeries (Fin 2) A) := Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h} with hI
  set J : Ideal (MvPowerSeries (Fin 2) (A ⧸ Ideal.span {b})) := Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (q h)} with hJ
  let π : MvPowerSeries (Fin 2) A →+* MvPowerSeries (Fin 2) (A ⧸ Ideal.span {b}) :=
    MvPowerSeries.map q
  have hπf : π (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h) =
      MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (q h) := by
    simp only [π, map_sub, map_mul, MvPowerSeries.map_X, MvPowerSeries.map_C]
  let F : MvPowerSeries (Fin 2) A →+* MvPowerSeries (Fin 2) (A ⧸ Ideal.span {b}) ⧸ J :=
    (Ideal.Quotient.mk J).comp π
  have hIF : ∀ a ∈ I, F a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp only [F, RingHom.comp_apply, map_mul, hπf]
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), mul_zero]
  have hle : I ≤ RingHom.ker F := fun a ha => hIF a ha
  have hsurj : Function.Surjective π := by
    intro g
    refine ⟨fun n => Function.surjInv Ideal.Quotient.mk_surjective (MvPowerSeries.coeff n g), ?_⟩
    ext n
    simp only [π]
    exact Function.surjInv_eq _ _
  have hker : RingHom.ker π = Ideal.span {MvPowerSeries.C b} := by
    apply le_antisymm
    · intro φ hφ
      rw [RingHom.mem_ker] at hφ
      have hd : ∀ n, b ∣ MvPowerSeries.coeff n φ := by
        intro n
        have h1 := congrArg (MvPowerSeries.coeff n) hφ
        rw [MvPowerSeries.coeff_map, map_zero] at h1
        exact (Ideal.Quotient.eq_zero_iff_dvd _ _).mp h1
      choose c hc using hd
      let θ : MvPowerSeries (Fin 2) A := fun n => c n
      have hθ : ∀ n, MvPowerSeries.coeff n θ = c n := fun n => rfl
      refine Ideal.mem_span_singleton'.mpr ⟨θ, ?_⟩
      ext n
      rw [mul_comm, MvPowerSeries.coeff_C_mul, hc n, hθ]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show π (MvPowerSeries.C b) = 0
      simp only [π, MvPowerSeries.map_C]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
  refine ⟨Ideal.Quotient.lift I F hIF, ?_, ?_, ?_⟩
  · have hk : RingHom.ker (Ideal.Quotient.lift I F hIF) =
        Ideal.map (Ideal.Quotient.mk I) (RingHom.ker F) := Ideal.ker_quotient_lift F hle
    rw [hk]
    have hF : RingHom.ker F = Ideal.comap π J := by
      ext x
      simp only [F, RingHom.mem_ker, RingHom.comp_apply, Ideal.mem_comap,
        Ideal.Quotient.eq_zero_iff_mem]
    have hJI : J = Ideal.map π I := by
      rw [hI, Ideal.map_span, Set.image_singleton, hπf]
    rw [hF, hJI, Ideal.comap_map_of_surjective' π hsurj, hker, Ideal.map_sup,
      Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, Set.image_singleton]
  · intro a
    rw [Ideal.Quotient.lift_mk]
    simp only [F, π, RingHom.comp_apply, MvPowerSeries.map_C]
  · intro i
    rw [Ideal.Quotient.lift_mk]
    simp only [F, π, RingHom.comp_apply, MvPowerSeries.map_X]

theorem wcpa_dj_stc_tu_T_quot : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A], IsAdicComplete (IsLocalRing.maximalIdeal A) A → ∀ (n : ℕ) (t : Fin n → A), (n : WithBot ℕ∞) = ringKrullDim A → Ideal.span (Set.range t) = IsLocalRing.maximalIdeal A → ∀ (c : Fin n → ℕ), (∃ l, c l ≠ 0) → ∀ (v : Aˣ) (l : Fin n), c l = 0 → IsDomain (MvPowerSeries (Fin 2) (A ⧸ Ideal.span {t l}) ⧸ Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {t l}) (↑v * ∏ k, t k ^ c k))}) ∧ Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {t l}) (↑v * ∏ k, t k ^ c k))}) (MvPowerSeries.X (0 : Fin 2)) ≠ 0 ∧ ∀ k, k ≠ l → Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {t l}) (↑v * ∏ k, t k ^ c k))}) (MvPowerSeries.C (Ideal.Quotient.mk (Ideal.span {t l}) (t k))) ≠ 0 :=
by
  classical
  intro A _ _ hA n t hdim hspan c hc v l hcl
  obtain ⟨hAdom, htp, hnd⟩ := wcpa_dj_bko_regular_params A n t hdim hspan
  haveI := hAdom
  have htm : ∀ k, t k ∈ IsLocalRing.maximalIdeal A := fun k =>
    hspan ▸ Ideal.subset_span ⟨k, rfl⟩

  have hsf : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = n := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [← hdim] at h1
    exact_mod_cast h1
  have hnpos : 0 < n := Fin.pos l

  obtain ⟨hreg, -, -⟩ := wc_ogp_quotient_regular A {t l} ((Finset.univ.erase l).image t)
    (by
      rw [← hspan]
      congr 1
      ext y
      simp only [Set.mem_union, Finset.coe_singleton, Set.mem_singleton_iff, Finset.coe_image,
        Set.mem_image, Finset.mem_coe, Finset.mem_erase, Finset.mem_univ, and_true, Set.mem_range]
      constructor
      · rintro (rfl | ⟨k, _, rfl⟩)
        · exact ⟨l, rfl⟩
        · exact ⟨k, rfl⟩
      · rintro ⟨k, rfl⟩
        by_cases hk : k = l
        · left; rw [hk]
        · right; exact ⟨k, hk, rfl⟩)
    (by
      rw [Finset.card_singleton, hsf]
      have h1 := Finset.card_image_le (s := Finset.univ.erase l) (f := t)
      rw [Finset.card_erase_of_mem (Finset.mem_univ l), Finset.card_univ, Fintype.card_fin] at h1
      omega)
  rw [Finset.coe_singleton] at hreg
  haveI := hreg
  haveI : IsDomain (A ⧸ Ideal.span {t l}) := (wc_fco_regular_local_ufd (A ⧸ Ideal.span {t l})).1

  haveI : IsAdicComplete (IsLocalRing.maximalIdeal A) A := hA
  have hne : Ideal.span {t l} ≠ ⊤ := fun h =>
    (htp l).not_unit (Ideal.span_singleton_eq_top.mp h)
  obtain ⟨_, hA'c⟩ := wc_hnas_quotient_complete A (Ideal.span {t l}) hne

  have hτ : ∀ k, k ≠ l → Ideal.Quotient.mk (Ideal.span {t l}) (t k) ≠ 0 := by
    intro k hk h0
    exact hnd l k (Ne.symm hk) ((Ideal.Quotient.eq_zero_iff_dvd _ _).mp h0)
  have hb0 : Ideal.Quotient.mk (Ideal.span {t l}) (↑v * ∏ k, t k ^ c k) ≠ 0 := by
    intro h0
    have hd := (Ideal.Quotient.eq_zero_iff_dvd _ _).mp h0
    rcases (htp l).dvd_or_dvd hd with h1 | h1
    · exact (htp l).not_unit (isUnit_of_dvd_unit h1 v.isUnit)
    · obtain ⟨k, -, hk⟩ := ((htp l).dvd_finsetProd_iff _).mp h1
      by_cases hkl : k = l
      · rw [hkl, hcl, pow_zero] at hk
        exact (htp l).not_unit (isUnit_of_dvd_one hk)
      · exact hnd l k (Ne.symm hkl) ((htp l).dvd_of_dvd_pow hk)
  obtain ⟨k₀, hk₀⟩ := hc
  have hhm : (↑v * ∏ k, t k ^ c k : A) ∈ IsLocalRing.maximalIdeal A := by
    apply Ideal.mul_mem_left
    rw [← Finset.mul_prod_erase Finset.univ (fun k => t k ^ c k) (Finset.mem_univ k₀)]
    apply Ideal.mul_mem_right
    exact Ideal.pow_mem_of_mem _ (htm k₀) _ (Nat.pos_of_ne_zero hk₀)
  have hbm : Ideal.Quotient.mk (Ideal.span {t l}) (↑v * ∏ k, t k ^ c k) ∈
      IsLocalRing.maximalIdeal (A ⧸ Ideal.span {t l}) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨y, hy⟩ := hu.exists_right_inv
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, ← map_one (Ideal.Quotient.mk (Ideal.span {t l})),
      Ideal.Quotient.mk_eq_mk_iff_sub_mem] at hy
    have hle : Ideal.span {t l} ≤ IsLocalRing.maximalIdeal A :=
      (Ideal.span_singleton_le_iff_mem _).mpr (htm l)
    have h1 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
      have := Ideal.sub_mem _ (Ideal.mul_mem_right b _ hhm) (hle hy)
      simpa using this
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  generalize Ideal.Quotient.mk (Ideal.span {t l}) (↑v * ∏ k, t k ^ c k) = hb at hb0 hbm ⊢

  haveI hBreg := wcpa_dj_stc_tu_ps_regular (A ⧸ Ideal.span {t l})
  obtain ⟨hBdom, hBufd⟩ := wc_fco_regular_local_ufd (PowerSeries (A ⧸ Ideal.span {t l}))
  haveI := hBdom
  haveI := hBufd
  have hBc := wcpa_dj_stc_tu_ps_complete (A ⧸ Ideal.span {t l}) hA'c
  obtain ⟨Φ, hΦroot, -, hΦC⟩ := wcpa_dj_stc_tu_weierstrass (A ⧸ Ideal.span {t l}) hBc hb hbm
  have hnr := wcpa_dj_stc_tu_no_root (A ⧸ Ideal.span {t l}) hb hbm hb0
  haveI hAdj := wcpa_dj_stc_tu_adjoin_domain (PowerSeries (A ⧸ Ideal.span {t l}))
    PowerSeries.X (PowerSeries.C hb) hnr
  have hfdeg : (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X * Polynomial.X +
      Polynomial.C (PowerSeries.C hb) :
        Polynomial (PowerSeries (A ⧸ Ideal.span {t l}))).natDegree = 2 := by
    compute_degree!
  have hroot : AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X * Polynomial.X +
      Polynomial.C (PowerSeries.C hb) : Polynomial (PowerSeries (A ⧸ Ideal.span {t l}))) ≠ 0 := by
    intro h0
    rw [← AdjoinRoot.mk_X, AdjoinRoot.mk_eq_zero] at h0
    have h1 := Polynomial.natDegree_le_of_dvd h0 Polynomial.X_ne_zero
    rw [hfdeg, Polynomial.natDegree_X] at h1
    omega
  have hof : Function.Injective (AdjoinRoot.of (Polynomial.X ^ 2 -
      Polynomial.C PowerSeries.X * Polynomial.X + Polynomial.C (PowerSeries.C hb) :
        Polynomial (PowerSeries (A ⧸ Ideal.span {t l})))) :=
    AdjoinRoot.of.injective_of_degree_ne_zero
      (Polynomial.natDegree_pos_iff_degree_pos.mp (by rw [hfdeg]; norm_num)).ne'
  refine ⟨Function.Injective.isDomain Φ.symm Φ.symm.injective, ?_, ?_⟩
  · intro h0
    apply hroot
    apply Φ.injective
    rw [hΦroot, h0, map_zero]
  · intro k hk h0
    have h1 : AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X * Polynomial.X +
        Polynomial.C (PowerSeries.C hb) : Polynomial (PowerSeries (A ⧸ Ideal.span {t l})))
        (PowerSeries.C (Ideal.Quotient.mk (Ideal.span {t l}) (t k))) = 0 := by
      apply Φ.injective
      rw [hΦC, h0, map_zero]
    rw [map_eq_zero_iff _ hof, map_eq_zero_iff _ PowerSeries.C_injective] at h1
    exact hτ k hk h1

theorem wcpa_dj_stc_tu_toric_orders : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A],
    IsAdicComplete (IsLocalRing.maximalIdeal A) A →
    ∀ (n : ℕ) (t : Fin n → A), (n : WithBot ℕ∞) = ringKrullDim A →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal A →
    ∀ (c : Fin n → ℕ), (∃ l, c l ≠ 0) → ∀ (v : Aˣ), IsDomain (wcpaDjStcTuRing A t c v) →
    (∀ (l : Fin n) (σ : Fin 2), (wcpaDjStcTuQ A t c v l σ).IsPrime ∧
      (wcpaDjStcTuQ A t c v l σ).height = 1 ∧
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ∈ wcpaDjStcTuQ A t c v l σ ∧
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ≠ 0 ∧
      (∀ k, k ≠ l → (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) :
        wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ) ∧
      wcpaDjStcTuOrd (wcpaDjStcTuQ A t c v l σ)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)))
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)))
        (if σ = 0 then c l else 0) ∧
      ∀ r : wcpaDjStcTuRing A t c v, r ≠ 0 → ∃ e, wcpaDjStcTuOrd (wcpaDjStcTuQ A t c v l σ)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) r e) ∧
    (∀ P : Ideal (wcpaDjStcTuRing A t c v), P.IsPrime → P.height = 1 → ∀ l,
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ∈ P → ∃ σ, P = wcpaDjStcTuQ A t c v l σ) ∧
    (∀ P : Ideal (wcpaDjStcTuRing A t c v), P.IsPrime →
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)) :
        wcpaDjStcTuRing A t c v) ∈ P →
      ∃ l, (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ∈ P) :=
by
  classical
  intro A _ _ hA n t hdim hspan c hc v hR
  haveI := hR


  have dvr : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (Q : Ideal R) (π : R),
      Q.IsPrime → π ∈ Q → π ≠ 0 → (∀ a ∈ Q, ∃ s ∉ Q, s * a ∈ Ideal.span {π}) →
      Q.height = 1 ∧ ∀ r : R, r ≠ 0 → ∃ e : ℕ, wcpaDjStcTuOrd Q π r e := by
    intro R _ _ _ Q π hQ hπQ hπ0 hloc
    haveI := hQ
    have hmin : Q ∈ (Ideal.span {π}).minimalPrimes := by
      refine ⟨⟨hQ, (Ideal.span_singleton_le_iff_mem _).mpr hπQ⟩, ?_⟩
      rintro P ⟨hP, hπP⟩ hPQ a ha
      obtain ⟨s, hs, hsa⟩ := hloc a ha
      rcases hP.mem_or_mem (hπP hsa) with h | h
      · exact absurd (hPQ h) hs
      · exact h
    haveI : (Ideal.span {π}).IsPrincipal := ⟨⟨π, rfl⟩⟩
    have hle : Q.height ≤ 1 :=
      Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {π}) Q hmin
    have hne : Q.height ≠ 0 := by
      intro h0
      have h1 := Ideal.height_eq_zero_iff.mp h0
      rw [IsDomain.minimalPrimes_eq_singleton_bot R] at h1
      have h2 : Q = ⊥ := h1
      apply hπ0
      rw [h2] at hπQ
      exact (Submodule.mem_bot R).mp hπQ
    refine ⟨le_antisymm hle (ENat.one_le_iff_ne_zero.mpr hne), ?_⟩
    intro r hr
    by_contra hno
    push_neg at hno
    have hall : ∀ e : ℕ, ∃ s ∉ Q, ∃ a : R, s * r = π ^ e * a := by
      intro e
      induction e with
      | zero => exact ⟨1, fun h => hQ.ne_top ((Ideal.eq_top_iff_one _).mpr h), r, by ring⟩
      | succ e ih =>
        obtain ⟨s, hs, a, hsa⟩ := ih
        by_cases ha : a ∈ Q
        · obtain ⟨s', hs', hs'a⟩ := hloc a ha
          obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hs'a
          refine ⟨s' * s, fun hm => ?_, b, ?_⟩
          · rcases hQ.mem_or_mem hm with h | h <;> contradiction
          · calc s' * s * r = s' * (s * r) := by ring
              _ = π ^ e * (s' * a) := by rw [hsa]; ring
              _ = π ^ (e + 1) * b := by rw [← hb]; ring
        · exact (hno e ⟨s, a, hs, ha, by rw [hsa]; ring⟩).elim
    have hπm : algebraMap R (Localization.AtPrime Q) π ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q π).mpr hπQ
    have hmem : ∀ e : ℕ, algebraMap R (Localization.AtPrime Q) r ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) ^ e := by
      intro e
      obtain ⟨s, hs, a, hsa⟩ := hall e
      have hu : IsUnit (algebraMap R (Localization.AtPrime Q) s) :=
        IsLocalization.map_units (Localization.AtPrime Q) (⟨s, hs⟩ : Q.primeCompl)
      rw [← Ideal.unit_mul_mem_iff_mem _ hu, ← map_mul, hsa, map_mul, map_pow]
      exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hπm e)
    have hbot : ⨅ e : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime Q) ^ e = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing _
        (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime Q)).ne_top
    have hr0 : algebraMap R (Localization.AtPrime Q) r = 0 := by
      have h1 : algebraMap R (Localization.AtPrime Q) r ∈
          ⨅ e : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime Q) ^ e :=
        Submodule.mem_iInf _ |>.mpr hmem
      rw [hbot] at h1
      exact (Submodule.mem_bot _).mp h1
    apply hr
    apply IsLocalization.injective (Localization.AtPrime Q) (Ideal.primeCompl_le_nonZeroDivisors Q)
    rw [hr0, map_zero]

  obtain ⟨hAdom, htp, hnd⟩ := wcpa_dj_bko_regular_params A n t hdim hspan
  haveI := hAdom
  obtain ⟨l₀, hl₀⟩ := hc
  have htm : ∀ l, t l ∈ IsLocalRing.maximalIdeal A := fun l =>
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (htp l).not_unit)
  have hhm : (↑v * ∏ l, t l ^ c l : A) ∈ IsLocalRing.maximalIdeal A := by
    apply Ideal.mul_mem_left
    rw [← Finset.mul_prod_erase Finset.univ (fun l => t l ^ c l) (Finset.mem_univ l₀)]
    apply Ideal.mul_mem_right
    exact Ideal.pow_mem_of_mem _ (htm l₀) _ (Nat.pos_of_ne_zero hl₀)
  obtain ⟨hCinj, -⟩ := wcpa_dj_stc_tu_const_inj A _ hhm
  have hτ0 : ∀ l, (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
      wcpaDjStcTuRing A t c v) ≠ 0 := fun l h0 => (htp l).ne_zero (hCinj _ h0)
  have hwu : IsUnit (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (↑v : A))) :=
    (v.isUnit.map MvPowerSeries.C).map _
  have hxy : (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 0) *
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 1) : wcpaDjStcTuRing A t c v) =
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (↑v : A)) *
        ∏ k, Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) ^ c k := by
    rw [← map_mul, Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _) :
      _ ∈ wcpaDjStcTuIdeal A t c v)]
    simp only [map_mul, map_prod, map_pow]
  have hxyl : ∀ l, (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 0) *
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 1) : wcpaDjStcTuRing A t c v) =
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (↑v : A)) *
        ∏ k ∈ Finset.univ.erase l,
          Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) ^ c k) *
        Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) ^ c l := by
    intro l
    rw [hxy, ← Finset.mul_prod_erase Finset.univ
      (fun k => Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) ^ c k)
      (Finset.mem_univ l)]
    ring
  have hU : ∀ (l : Fin n) (P : Ideal (wcpaDjStcTuRing A t c v)), P.IsPrime →
      (∀ k, k ≠ l → (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) :
        wcpaDjStcTuRing A t c v) ∉ P) →
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (↑v : A)) *
        ∏ k ∈ Finset.univ.erase l,
          Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) ^ c k) ∉ P := by
    intro l P hP hτP hm
    haveI := hP
    rw [Ideal.unit_mul_mem_iff_mem _ hwu, Ideal.IsPrime.prod_mem_iff] at hm
    obtain ⟨k, hk, hkP⟩ := hm
    exact hτP k (Finset.ne_of_mem_erase hk) (hP.mem_of_pow_mem _ hkP)
  have h2 : ∀ σ : Fin 2, σ = 0 ∨ σ = 1 := by decide

  have hT1 : ∀ (l : Fin n) (σ : Fin 2), (wcpaDjStcTuQ A t c v l σ).IsPrime ∧
      (wcpaDjStcTuQ A t c v l σ).height = 1 ∧
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ∈ wcpaDjStcTuQ A t c v l σ ∧
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ≠ 0 ∧
      (∀ k, k ≠ l → (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) :
        wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ) ∧
      wcpaDjStcTuOrd (wcpaDjStcTuQ A t c v l σ)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)))
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)))
        (if σ = 0 then c l else 0) ∧
      ∀ r : wcpaDjStcTuRing A t c v, r ≠ 0 → ∃ e, wcpaDjStcTuOrd (wcpaDjStcTuQ A t c v l σ)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) r e := by
    intro l σ
    by_cases hcl : c l = 0
    ·
      have hQ : wcpaDjStcTuQ A t c v l σ = Ideal.span
          {Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))} := by
        simp only [wcpaDjStcTuQ, if_pos hcl]
      obtain ⟨ψ, hker, hψC, hψX⟩ := wcpa_dj_stc_tu_reduce_ker A (t l) (↑v * ∏ k, t k ^ c k)
      obtain ⟨hdom', hX0', hτ'⟩ :=
        wcpa_dj_stc_tu_T_quot A hA n t hdim hspan c ⟨l₀, hl₀⟩ v l hcl
      haveI := hdom'
      have hker' : RingHom.ker ψ = wcpaDjStcTuQ A t c v l σ := by rw [hQ]; exact hker
      have hQp : (wcpaDjStcTuQ A t c v l σ).IsPrime := hker' ▸ RingHom.ker_isPrime ψ
      have hnot : ∀ r, ψ r ≠ 0 → r ∉ wcpaDjStcTuQ A t c v l σ := fun r hr hm =>
        hr (by rw [← hker'] at hm; exact hm)
      have h1Q : (1 : wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ := fun h =>
        hQp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
      have hτQ : (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
          wcpaDjStcTuRing A t c v) ∈ wcpaDjStcTuQ A t c v l σ := by
        rw [hQ]; exact Ideal.subset_span (Set.mem_singleton _)
      have hxQ : (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)) :
          wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ :=
        hnot _ (by rw [hψX 0]; exact hX0')
      obtain ⟨hht, hord⟩ := dvr _ _ _ hQp hτQ (hτ0 l) (fun a ha =>
        ⟨1, h1Q, by rw [one_mul]; rw [hQ] at ha; exact ha⟩)
      have hexp : (if σ = 0 then c l else 0) = 0 := by split_ifs <;> simp [hcl]
      refine ⟨hQp, hht, hτQ, hτ0 l, fun k hk => hnot _ ?_, ?_, hord⟩
      · rw [hψC]; exact hτ' k hk
      · rw [hexp]; exact ⟨1, _, h1Q, hxQ, by ring⟩
    ·
      have hQ : wcpaDjStcTuQ A t c v l σ = Ideal.span
          {Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X σ),
            Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))} := by
        simp only [wcpaDjStcTuQ, if_neg hcl]
      have hdvd : t l ∣ (↑v * ∏ k, t k ^ c k) :=
        Dvd.dvd.mul_left ((dvd_pow_self (t l) hcl).trans
          (Finset.dvd_prod_of_mem (fun k => t k ^ c k) (Finset.mem_univ l))) _
      obtain ⟨ρ, hker, hρC, hρX⟩ := wcpa_dj_stc_tu_axis_ker A (t l) _ hdvd σ
      haveI : (Ideal.span {t l}).IsPrime :=
        (Ideal.span_singleton_prime (htp l).ne_zero).mpr (htp l)
      have hker' : RingHom.ker ρ = wcpaDjStcTuQ A t c v l σ := by rw [hQ]; exact hker
      have hQp : (wcpaDjStcTuQ A t c v l σ).IsPrime := hker' ▸ RingHom.ker_isPrime ρ
      have hnot : ∀ r, ρ r ≠ 0 → r ∉ wcpaDjStcTuQ A t c v l σ := fun r hr hm =>
        hr (by rw [← hker'] at hm; exact hm)
      have h1Q : (1 : wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ := fun h =>
        hQp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
      obtain ⟨σ', hσ'σ, hσ'⟩ : ∃ σ' : Fin 2, σ' ≠ σ ∧
          (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X σ) *
            Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X σ') :
              wcpaDjStcTuRing A t c v) =
          Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 0) *
            Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 1) := by
        rcases h2 σ with rfl | rfl
        · exact ⟨1, by decide, rfl⟩
        · exact ⟨0, by decide, mul_comm _ _⟩
      have hzQ : (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X σ') :
          wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ :=
        hnot _ (by rw [hρX σ' hσ'σ]; exact PowerSeries.X_ne_zero)
      have hτQ : (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
          wcpaDjStcTuRing A t c v) ∈ wcpaDjStcTuQ A t c v l σ := by
        rw [hQ]; exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      have hτk : ∀ k, k ≠ l → (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v)
          (MvPowerSeries.C (t k)) : wcpaDjStcTuRing A t c v) ∉ wcpaDjStcTuQ A t c v l σ := by
        intro k hk
        apply hnot
        rw [hρC]
        intro h0
        have h1 : Ideal.Quotient.mk (Ideal.span {t l}) (t k) = 0 :=
          PowerSeries.C_injective (h0.trans (map_zero _).symm)
        exact hnd l k (Ne.symm hk) ((Ideal.Quotient.eq_zero_iff_dvd _ _).mp h1)
      obtain ⟨m, hm⟩ : ∃ m, c l = m + 1 := ⟨c l - 1, by omega⟩
      have hloc : ∀ a ∈ wcpaDjStcTuQ A t c v l σ, ∃ s ∉ wcpaDjStcTuQ A t c v l σ,
          s * a ∈ Ideal.span {(Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v)
            (MvPowerSeries.C (t l)) : wcpaDjStcTuRing A t c v)} := by
        intro a ha
        rw [hQ] at ha
        obtain ⟨a', b', hab⟩ := Ideal.mem_span_pair.mp ha
        refine ⟨_, hzQ, Ideal.mem_span_singleton'.mpr ⟨a' *
          ((Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (↑v : A)) *
            ∏ k ∈ Finset.univ.erase l,
              Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t k)) ^ c k) *
            Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) ^ m) +
          b' * Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X σ'), ?_⟩⟩
        rw [← hab]
        have e := hxyl l
        rw [hm, ← hσ'] at e
        linear_combination (-a') * e
      obtain ⟨hht, hord⟩ := dvr _ _ _ hQp hτQ (hτ0 l) hloc
      refine ⟨hQp, hht, hτQ, hτ0 l, hτk, ?_, hord⟩
      rcases h2 σ with rfl | rfl
      · rw [if_pos rfl]
        refine ⟨_, _, hzQ, hU l _ hQp hτk, ?_⟩
        linear_combination hσ' + hxyl l
      · rw [if_neg (by decide)]
        exact ⟨1, _, h1Q, hnot _ (by rw [hρX 0 (by decide)]; exact PowerSeries.X_ne_zero),
          by ring⟩

  have hT2 : ∀ P : Ideal (wcpaDjStcTuRing A t c v), P.IsPrime → P.height = 1 → ∀ l,
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ∈ P → ∃ σ, P = wcpaDjStcTuQ A t c v l σ := by
    intro P hP hht l hτP
    haveI := hP
    have hfin : P.FiniteHeight := (Ideal.finiteHeight_iff P).mpr (Or.inr (by
      rw [hht]; exact ENat.one_ne_top))
    obtain ⟨σ, hσ⟩ : ∃ σ, wcpaDjStcTuQ A t c v l σ ≤ P := by
      by_cases hcl : c l = 0
      · refine ⟨0, ?_⟩
        simp only [wcpaDjStcTuQ, if_pos hcl]
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hτP)
      · have hxyP : (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 0) *
            Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X 1) :
              wcpaDjStcTuRing A t c v) ∈ P := by
          rw [hxyl l]
          exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hτP _ (Nat.pos_of_ne_zero hcl))
        rcases hP.mem_or_mem hxyP with hx | hy
        · refine ⟨0, ?_⟩
          simp only [wcpaDjStcTuQ, if_neg hcl]
          exact Ideal.span_le.mpr (Set.insert_subset_iff.mpr ⟨hx, Set.singleton_subset_iff.mpr hτP⟩)
        · refine ⟨1, ?_⟩
          simp only [wcpaDjStcTuQ, if_neg hcl]
          exact Ideal.span_le.mpr (Set.insert_subset_iff.mpr ⟨hy, Set.singleton_subset_iff.mpr hτP⟩)
    haveI := (hT1 l σ).1
    have hmin : P ∈ (wcpaDjStcTuQ A t c v l σ).minimalPrimes :=
      Ideal.mem_minimalPrimes_of_height_le hσ (by rw [hht, (hT1 l σ).2.1])
    rw [Ideal.minimalPrimes_eq_subsingleton_self] at hmin
    exact ⟨σ, hmin⟩

  have hT3 : ∀ P : Ideal (wcpaDjStcTuRing A t c v), P.IsPrime →
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)) :
        wcpaDjStcTuRing A t c v) ∈ P →
      ∃ l, (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)) :
        wcpaDjStcTuRing A t c v) ∈ P := by
    intro P hP hx
    haveI := hP
    have hxyP := Ideal.mul_mem_right
      (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (1 : Fin 2))) P hx
    rw [hxy, Ideal.unit_mul_mem_iff_mem _ hwu, Ideal.IsPrime.prod_mem_iff] at hxyP
    obtain ⟨k, -, hk⟩ := hxyP
    exact ⟨k, hP.mem_of_pow_mem _ hk⟩
  exact ⟨hT1, hT2, hT3⟩

theorem wcpa_dj_stc_tu_class_step : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (n : ℕ) (t : Fin n → A), (n : WithBot ℕ∞) = ringKrullDim A →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal A →
    ∀ (c : Fin n → ℕ), (∃ l, c l ≠ 0) → ∀ (v : Aˣ), IsDomain (wcpaDjStcTuRing A t c v) →
    ∀ (F₁ F₂ : wcpaDjStcTuRing A t c v) (M : ℕ),
      F₁ * F₂ = (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2))) ^ M →
      ∃ i ≤ M, ∀ l, c l ≠ 0 → ∀ s ∉ wcpaDjStcTuQ A t c v l 0, ∀ a : wcpaDjStcTuRing A t c v,
        s * F₁ ≠ (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ^
          (i * c l + 1) * a ∧
        s * F₂ ≠ (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ^
          ((M - i) * c l + 1) * a :=
by
  intro A _ _ n t hdim hspan c hc v _ F₁ F₂ M hF
  classical
  obtain ⟨hAdom, htp, htnd⟩ := wcpa_dj_bko_regular_params A n t hdim hspan
  haveI := hAdom
  have t_dec : ∀ p : Fin 2 →₀ ℕ,
      Finsupp.single (0 : Fin 2) (p 0) + Finsupp.single (1 : Fin 2) (p 1) = p := by
    intro p; ext i; fin_cases i <;> simp
  have t_sseq : ∀ a b a' b' : ℕ,
      Finsupp.single (0 : Fin 2) a + Finsupp.single (1 : Fin 2) b =
        Finsupp.single (0 : Fin 2) a' + Finsupp.single (1 : Fin 2) b' ↔ a = a' ∧ b = b' := by
    intro a b a' b'
    constructor
    · intro h
      have h0 := congrArg (fun f => f 0) h
      have h1 := congrArg (fun f => f 1) h
      simp at h0 h1
      exact ⟨h0, h1⟩
    · rintro ⟨rfl, rfl⟩; rfl
  have t_rows : ∀ (F K : MvPowerSeries (Fin 2) A) (a : ℕ),
      wcpaDjStcTuCsRow a (F * K) =
        ∑ p ∈ Finset.HasAntidiagonal.antidiagonal a, wcpaDjStcTuCsRow p.1 F * wcpaDjStcTuCsRow p.2 K := by
    intro F K a
    ext b
    rw [map_sum]
    simp only [wcpaDjStcTuCsRow, PowerSeries.coeff_mk, PowerSeries.coeff_mul,
      MvPowerSeries.coeff_mul]
    rw [← Finset.sum_product']
    refine Finset.sum_nbij' (fun pq => ((pq.1 0, pq.2 0), (pq.1 1, pq.2 1)))
      (fun xy => (Finsupp.single (0 : Fin 2) xy.1.1 + Finsupp.single (1 : Fin 2) xy.2.1,
        Finsupp.single (0 : Fin 2) xy.1.2 + Finsupp.single (1 : Fin 2) xy.2.2)) ?_ ?_ ?_ ?_ ?_
    · rintro ⟨p, q⟩ hpq
      simp only [Finset.mem_coe, Finset.HasAntidiagonal.mem_antidiagonal, Finset.mem_product] at hpq ⊢
      have h0 := congrArg (fun f => f 0) hpq
      have h1 := congrArg (fun f => f 1) hpq
      simp at h0 h1
      exact ⟨h0, h1⟩
    · rintro ⟨⟨x1, x2⟩, ⟨y1, y2⟩⟩ h
      simp only [Finset.mem_coe, Finset.HasAntidiagonal.mem_antidiagonal, Finset.mem_product] at h ⊢
      obtain ⟨hx, hy⟩ := h
      ext i; fin_cases i <;> simp <;> omega
    · rintro ⟨p, q⟩ _
      simp only [t_dec]
    · rintro ⟨⟨x1, x2⟩, ⟨y1, y2⟩⟩ _
      simp
    · rintro ⟨p, q⟩ _
      simp only
      rw [t_dec p, t_dec q]
  have t_tw : ∀ (B : Type u) [CommRing B] (c X : B) (j : ℕ) (r s : ℕ → B),
      ∃ E : B, (∑ a ∈ Finset.range (j + 1), c ^ a * X ^ (j - a) * r a) *
        (∑ a ∈ Finset.range (j + 1), c ^ a * X ^ (j - a) * s a) =
        X ^ j * (∑ n ∈ Finset.range (j + 1), c ^ n * X ^ (j - n) *
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal n, r p.1 * s p.2) + c ^ (j + 1) * E := by
    intro B _ c X j r s
    refine ⟨∑ p ∈ (Finset.range (j + 1) ×ˢ Finset.range (j + 1)).filter
        (fun p => ¬ p.1 + p.2 ≤ j),
        c ^ (p.1 + p.2 - (j + 1)) * (X ^ (j - p.1) * X ^ (j - p.2) * (r p.1 * s p.2)), ?_⟩
    rw [Finset.sum_mul_sum, ← Finset.sum_product',
      ← Finset.sum_filter_add_sum_filter_not _ (fun p : ℕ × ℕ => p.1 + p.2 ≤ j)]
    congr 1
    · rw [← Finset.sum_fiberwise_of_maps_to (g := fun p : ℕ × ℕ => p.1 + p.2)
        (t := Finset.range (j + 1))]
      · rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro n hn
        rw [Finset.mem_range] at hn
        have hset : ((Finset.range (j + 1) ×ˢ Finset.range (j + 1)).filter
            (fun p : ℕ × ℕ => p.1 + p.2 ≤ j)).filter (fun p : ℕ × ℕ => p.1 + p.2 = n) =
            Finset.HasAntidiagonal.antidiagonal n := by
          ext p
          simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range,
            Finset.HasAntidiagonal.mem_antidiagonal]
          omega
        rw [hset, Finset.mul_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have e1 : X ^ (j - p.1) * X ^ (j - p.2) = X ^ j * X ^ (j - n) := by
          rw [← pow_add, ← pow_add]; congr 1; omega
        have e2 : c ^ p.1 * c ^ p.2 = c ^ n := by rw [← pow_add, hp]
        calc c ^ p.1 * X ^ (j - p.1) * r p.1 * (c ^ p.2 * X ^ (j - p.2) * s p.2)
            = (c ^ p.1 * c ^ p.2) * (X ^ (j - p.1) * X ^ (j - p.2)) * (r p.1 * s p.2) := by
              ring
          _ = X ^ j * (c ^ n * X ^ (j - n) * (r p.1 * s p.2)) := by rw [e1, e2]; ring
      · intro p hp
        simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range] at hp
        simp only [Finset.mem_range]
        omega
    · rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro p hp
      simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range] at hp
      have e2 : c ^ p.1 * c ^ p.2 = c ^ (j + 1) * c ^ (p.1 + p.2 - (j + 1)) := by
        rw [← pow_add, ← pow_add]; congr 1; omega
      calc c ^ p.1 * X ^ (j - p.1) * r p.1 * (c ^ p.2 * X ^ (j - p.2) * s p.2)
          = (c ^ p.1 * c ^ p.2) * (X ^ (j - p.1) * X ^ (j - p.2) * (r p.1 * s p.2)) := by ring
        _ = _ := by rw [e2]; ring
  have t_mul : ∀ (h : A) (j : ℕ) (F K : MvPowerSeries (Fin 2) A), ∃ E : PowerSeries A,
      wcpaDjStcTuCsTw h j F * wcpaDjStcTuCsTw h j K =
        PowerSeries.X ^ j * wcpaDjStcTuCsTw h j (F * K) + PowerSeries.C (h ^ (j + 1)) * E := by
    intro h j F K
    obtain ⟨E, hE⟩ := t_tw (PowerSeries A) (PowerSeries.C h) PowerSeries.X j
      (fun a => wcpaDjStcTuCsRow a F) (fun a => wcpaDjStcTuCsRow a K)
    refine ⟨E, ?_⟩
    simp only [wcpaDjStcTuCsTw, map_pow, t_rows]
    exact hE
  have t_lin : ∀ (h : A) (j : ℕ) (c : A) (D K : MvPowerSeries (Fin 2) A),
      wcpaDjStcTuCsTw h j (MvPowerSeries.C c * D + K) =
        PowerSeries.C c * wcpaDjStcTuCsTw h j D + wcpaDjStcTuCsTw h j K := by
    intro h j c D K
    have hrow : ∀ a, wcpaDjStcTuCsRow a (MvPowerSeries.C c * D + K) =
        PowerSeries.C c * wcpaDjStcTuCsRow a D + wcpaDjStcTuCsRow a K := by
      intro a; ext b
      simp [wcpaDjStcTuCsRow, MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul]
    simp only [wcpaDjStcTuCsTw, hrow, Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro a _
    ring
  have hX01 : (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) A)
      = MvPowerSeries.monomial (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) 1 := by
    simp only [MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
  have t_rel : ∀ (h : A) (j : ℕ), ∃ E : PowerSeries A,
      wcpaDjStcTuCsTw h j (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C h) = PowerSeries.C (h ^ (j + 1)) * E := by
    intro h j
    have hc : ∀ a b, MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) a + Finsupp.single (1 : Fin 2) b)
        (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h :
          MvPowerSeries (Fin 2) A) = (if a = 1 ∧ b = 1 then 1 else 0) - (if a = 0 ∧ b = 0 then h else 0) := by
      intro a b
      have e0 : (Finsupp.single (0 : Fin 2) a + Finsupp.single (1 : Fin 2) b = 0) ↔ a = 0 ∧ b = 0 := by
        have := t_sseq a b 0 0; simpa using this
      rw [map_sub, hX01, MvPowerSeries.coeff_monomial, MvPowerSeries.coeff_C]
      simp only [t_sseq, e0]
    have hr0 : wcpaDjStcTuCsRow 0 (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C h : MvPowerSeries (Fin 2) A) = - PowerSeries.C h := by
      ext b; rw [wcpaDjStcTuCsRow, PowerSeries.coeff_mk, hc]; simp [PowerSeries.coeff_C]
    have hr1 : wcpaDjStcTuCsRow 1 (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C h : MvPowerSeries (Fin 2) A) = PowerSeries.X := by
      ext b; rw [wcpaDjStcTuCsRow, PowerSeries.coeff_mk, hc]; simp [PowerSeries.coeff_X]
    have hr2 : ∀ a, wcpaDjStcTuCsRow (a + 1 + 1) (MvPowerSeries.X (0 : Fin 2) *
        MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h : MvPowerSeries (Fin 2) A) = 0 := by
      intro a; ext b; rw [wcpaDjStcTuCsRow, PowerSeries.coeff_mk, hc]; simp
    cases j with
    | zero =>
      refine ⟨-1, ?_⟩
      simp [wcpaDjStcTuCsTw, hr0]
    | succ j' =>
      refine ⟨0, ?_⟩
      rw [wcpaDjStcTuCsTw, Finset.sum_range_succ', Finset.sum_range_succ']
      simp only [hr2, hr1, hr0, mul_zero, Finset.sum_const_zero, zero_add, Nat.add_sub_cancel,
        Nat.sub_zero, pow_zero, pow_one, map_one, one_mul]
      ring
  have t_c0 : ∀ (h : A) (j : ℕ) (G : MvPowerSeries (Fin 2) A),
      PowerSeries.coeff 0 (wcpaDjStcTuCsTw h j G) =
        h ^ j * MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) j) G := by
    intro h j G
    rw [wcpaDjStcTuCsTw, map_sum, Finset.sum_eq_single j]
    · simp [wcpaDjStcTuCsRow, mul_assoc, PowerSeries.coeff_C_mul]
    · intro a ha hne
      rw [Finset.mem_range] at ha
      rw [mul_assoc, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow_mul', if_neg (by omega),
        mul_zero]
    · intro hj
      exact absurd (Finset.mem_range.mpr (by omega)) hj
  have t_cm : ∀ (h : A) (j : ℕ) (G : MvPowerSeries (Fin 2) A) (m : ℕ), ∃ z : A,
      PowerSeries.coeff (m + j) (wcpaDjStcTuCsTw h j G) =
        MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) m) G + h * z := by
    intro h j G m
    refine ⟨∑ a ∈ Finset.range j, h ^ a * PowerSeries.coeff (m + j)
      (PowerSeries.X ^ (j - (a + 1)) * wcpaDjStcTuCsRow (a + 1) G), ?_⟩
    rw [wcpaDjStcTuCsTw, Finset.sum_range_succ', map_add, map_sum, Finset.mul_sum, add_comm]
    congr 1
    · simp [PowerSeries.coeff_X_pow_mul', wcpaDjStcTuCsRow]
    · apply Finset.sum_congr rfl
      intro a _
      rw [mul_assoc, PowerSeries.coeff_C_mul, pow_succ]
      ring
  have t_desc : ∀ (t : A) (S : MvPowerSeries (Fin 2) A),
      (∀ m, t ∣ MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) m) S) →
      ∃ U V : MvPowerSeries (Fin 2) A, S = MvPowerSeries.X (0 : Fin 2) * U + MvPowerSeries.C t * V := by
    intro t S hS
    choose q hq using hS
    let V : MvPowerSeries (Fin 2) A := fun n => if n 0 = 0 then q (n 1) else 0
    have hV : ∀ n, MvPowerSeries.coeff n V = if n 0 = 0 then q (n 1) else 0 := fun n => rfl
    have hX : MvPowerSeries.X (0 : Fin 2) ∣ S - MvPowerSeries.C t * V := by
      refine MvPowerSeries.X_dvd_iff.mpr (fun n hn => ?_)
      have hn' : n = Finsupp.single (1 : Fin 2) (n 1) := by
        ext i; fin_cases i <;> simp [hn]
      have e : MvPowerSeries.coeff n S = t * q (n 1) := by
        rw [← hq (n 1), ← hn']
      rw [map_sub, MvPowerSeries.coeff_C_mul, hV, if_pos hn, e, sub_self]
    obtain ⟨U, hU⟩ := hX
    exact ⟨U, V, by rw [← hU]; ring⟩
  have t_gauss : ∀ (t : A), Prime t → ∀ (N : ℕ) (P₁ P₂ : PowerSeries A),
      (∃ m, ¬ t ∣ PowerSeries.coeff m P₁) → (∃ m, ¬ t ^ N ∣ PowerSeries.coeff m P₂) →
      ∃ m, ¬ t ^ N ∣ PowerSeries.coeff m (P₁ * P₂) := by
    intro t ht N P₁ P₂ hP₁ hP₂
    by_contra hall
    push_neg at hall
    haveI hpr : (Ideal.span {t}).IsPrime := (Ideal.span_singleton_prime ht.ne_zero).mpr ht
    have claim : ∀ k ≤ N, ∀ m, t ^ k ∣ PowerSeries.coeff m P₂ := by
      intro k
      induction k with
      | zero => intro _ m; simp
      | succ k ih =>
        intro hk
        choose q hq using ih (by omega)
        set Q : PowerSeries A := PowerSeries.mk q with hQ
        have hP2 : P₂ = PowerSeries.C (t ^ k) * Q := by
          ext m; rw [PowerSeries.coeff_C_mul, hQ, PowerSeries.coeff_mk, hq m]
        have hdiv : ∀ m, t ∣ PowerSeries.coeff m (P₁ * Q) := by
          intro m
          have h1 := hall m
          rw [hP2, mul_left_comm, PowerSeries.coeff_C_mul] at h1
          have h2 : t ^ k * t ^ (N - k) ∣ t ^ k * PowerSeries.coeff m (P₁ * Q) := by
            rw [← pow_add, Nat.add_sub_cancel' (by omega)]; exact h1
          have h3 := (mul_dvd_mul_iff_left (pow_ne_zero k ht.ne_zero)).mp h2
          exact (dvd_pow_self t (by omega)).trans h3
        let π := Ideal.Quotient.mk (Ideal.span {t})
        have hz : PowerSeries.map π (P₁ * Q) = 0 := by
          ext m
          rw [PowerSeries.coeff_map, map_zero, Ideal.Quotient.eq_zero_iff_mem,
            Ideal.mem_span_singleton]
          exact hdiv m
        have hne : PowerSeries.map π P₁ ≠ 0 := by
          obtain ⟨m, hm⟩ := hP₁
          intro h0
          have := congrArg (PowerSeries.coeff m) h0
          rw [PowerSeries.coeff_map, map_zero, Ideal.Quotient.eq_zero_iff_mem,
            Ideal.mem_span_singleton] at this
          exact hm this
        rw [map_mul] at hz
        have hQ0 := (mul_eq_zero.mp hz).resolve_left hne
        intro m
        have := congrArg (PowerSeries.coeff m) hQ0
        rw [PowerSeries.coeff_map, map_zero, Ideal.Quotient.eq_zero_iff_mem,
          Ideal.mem_span_singleton, hQ, PowerSeries.coeff_mk] at this
        rw [hq m, pow_succ]
        exact mul_dvd_mul_left _ this
    obtain ⟨m, hm⟩ := hP₂
    exact hm (claim N le_rfl m)
  have t_unit : ∀ (h : A), h ∈ IsLocalRing.maximalIdeal A →
      ∀ (G₁ G₂ H : MvPowerSeries (Fin 2) A) (M : ℕ),
      G₁ * G₂ = MvPowerSeries.X (0 : Fin 2) ^ M +
        (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h) * H →
      ∃ i ≤ M, IsUnit (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) i) G₁) ∧
        IsUnit (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) (M - i)) G₂) := by
    intro h hh G₁ G₂ H M hG
    have col : ∀ (F K : MvPowerSeries (Fin 2) A) (n : ℕ),
        MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) n) (F * K) =
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal n,
            MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) p.1) F *
              MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) p.2) K := by
      intro F K n
      rw [MvPowerSeries.coeff_mul, Finsupp.antidiagonal_single, Finset.sum_map]
      rfl
    let φ : MvPowerSeries (Fin 2) A → PowerSeries (IsLocalRing.ResidueField A) := fun G =>
      PowerSeries.mk fun a => IsLocalRing.residue A
        (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) a) G)
    have hφ : φ G₁ * φ G₂ = PowerSeries.X ^ M := by
      ext n
      rw [PowerSeries.coeff_mul]
      simp only [φ, PowerSeries.coeff_mk, ← map_mul]
      rw [← map_sum, ← col, hG, map_add, sub_mul, map_sub, hX01,
        MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_C_mul]
      have hnle : ¬ (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1 ≤
          Finsupp.single (0 : Fin 2) n) := by
        intro hle; have := hle 1; simp at this
      rw [if_neg hnle, zero_sub, map_add, map_neg,
        (IsLocalRing.residue_eq_zero_iff _).mpr (Ideal.mul_mem_right _ _ hh), neg_zero, add_zero,
        MvPowerSeries.coeff_X_pow, PowerSeries.coeff_X_pow]
      by_cases hn : n = M
      · subst hn; simp
      · rw [if_neg hn, if_neg (fun he => hn (Finsupp.single_injective _ he))]; simp
    have hX0 : (PowerSeries.X ^ M : PowerSeries (IsLocalRing.ResidueField A)) ≠ 0 :=
      pow_ne_zero M PowerSeries.X_ne_zero
    have h1 : φ G₁ ≠ 0 := fun h0 => hX0 (by rw [← hφ, h0, zero_mul])
    have h2 : φ G₂ ≠ 0 := fun h0 => hX0 (by rw [← hφ, h0, mul_zero])
    have ho := congrArg PowerSeries.order hφ
    rw [PowerSeries.order_mul, PowerSeries.order_X_pow] at ho
    have t1 : (φ G₁).order ≠ ⊤ := by rwa [Ne, PowerSeries.order_eq_top]
    have t2 : (φ G₂).order ≠ ⊤ := by rwa [Ne, PowerSeries.order_eq_top]
    have hsum : (φ G₁).order.toNat + (φ G₂).order.toNat = M := by
      have : (((φ G₁).order.toNat + (φ G₂).order.toNat : ℕ) : ℕ∞) = (M : ℕ∞) := by
        push_cast
        rw [ENat.coe_toNat t1, ENat.coe_toNat t2]
        exact ho
      exact_mod_cast this
    refine ⟨(φ G₁).order.toNat, by omega, ?_, ?_⟩
    · have := PowerSeries.coeff_order h1
      simp only [φ, PowerSeries.coeff_mk] at this
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp this
    · have := PowerSeries.coeff_order h2
      simp only [φ, PowerSeries.coeff_mk] at this
      rw [show M - (φ G₁).order.toNat = (φ G₂).order.toNat by omega]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp this
  have core : ∀ (tt w : A) (cc j j' : ℕ), Prime tt → ¬ tt ∣ w → 1 ≤ cc →
      ∀ (G S D H : MvPowerSeries (Fin 2) A),
      ¬ tt ∣ MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) j) G →
      ¬ tt ∣ MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j') S →
      S * G ≠ MvPowerSeries.C (tt ^ (j * cc + 1)) * D +
        (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
          MvPowerSeries.C (w * tt ^ cc)) * H := by
    intro tt w cc j j' htt htw hcc G S D H hG hS heq
    obtain ⟨c', rfl⟩ : ∃ c', cc = c' + 1 := ⟨cc - 1, by omega⟩
    obtain ⟨E₁, hE₁⟩ := t_mul (w * tt ^ (c' + 1)) j S G
    obtain ⟨E₂, hE₂⟩ := t_mul (w * tt ^ (c' + 1)) j
      (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C (w * tt ^ (c' + 1))) H
    obtain ⟨E', hE'⟩ := t_rel (w * tt ^ (c' + 1)) j
    have hlin := t_lin (w * tt ^ (c' + 1)) j (tt ^ (j * (c' + 1) + 1)) D
      ((MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C (w * tt ^ (c' + 1))) * H)
    rw [heq, hlin] at hE₁
    rw [hE'] at hE₂
    have hpow : (w * tt ^ (c' + 1)) ^ (j + 1) =
        tt ^ (j * (c' + 1) + 1) * (w ^ (j + 1) * tt ^ c') := by ring
    have hC : PowerSeries.C ((w * tt ^ (c' + 1)) ^ (j + 1)) =
        PowerSeries.C (tt ^ (j * (c' + 1) + 1)) * PowerSeries.C (w ^ (j + 1) * tt ^ c') := by
      rw [hpow, map_mul]
    have key : wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j S * wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j G =
        PowerSeries.C (tt ^ (j * (c' + 1) + 1)) *
          (PowerSeries.X ^ j * wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j D +
            PowerSeries.C (w ^ (j + 1) * tt ^ c') *
              (E₁ + E' * wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j H - E₂)) := by
      linear_combination hE₁ - hE₂ +
        (E₁ + E' * wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j H - E₂) * hC
    have hall : ∀ m, tt ^ (j * (c' + 1) + 1) ∣ PowerSeries.coeff m
        (wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j S * wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j G) := by
      intro m
      rw [key, PowerSeries.coeff_C_mul]
      exact dvd_mul_right _ _
    have htth : tt ∣ w * tt ^ (c' + 1) := dvd_mul_of_dvd_right (dvd_pow_self tt (by omega)) w
    have h1 : ∃ m, ¬ tt ∣ PowerSeries.coeff m (wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j S) := by
      obtain ⟨z, hz⟩ := t_cm (w * tt ^ (c' + 1)) j S j'
      refine ⟨j' + j, fun hd => hS ?_⟩
      rw [hz] at hd
      exact (dvd_add_left (dvd_mul_of_dvd_left htth z)).mp hd
    have h2 : ∃ m, ¬ tt ^ (j * (c' + 1) + 1) ∣
        PowerSeries.coeff m (wcpaDjStcTuCsTw (w * tt ^ (c' + 1)) j G) := by
      refine ⟨0, fun hd => ?_⟩
      rw [t_c0] at hd
      have e1 : (w * tt ^ (c' + 1)) ^ j * MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) j) G =
          tt ^ (j * (c' + 1)) * (w ^ j * MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) j) G) := by
        ring
      rw [e1, pow_succ] at hd
      have hd2 := (mul_dvd_mul_iff_left (pow_ne_zero (j * (c' + 1)) htt.ne_zero)).mp hd
      rcases htt.dvd_or_dvd hd2 with h3 | h3
      · exact htw (htt.dvd_of_dvd_pow h3)
      · exact hG h3
    obtain ⟨m, hm⟩ := t_gauss tt htt (j * (c' + 1) + 1) _ _ h1 h2
    exact hm (hall m)

  have htm : ∀ l, t l ∈ IsLocalRing.maximalIdeal A := fun l =>
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (htp l).not_unit)
  obtain ⟨l₀, hl₀⟩ := hc
  have hhm : (↑v * ∏ l, t l ^ c l : A) ∈ IsLocalRing.maximalIdeal A := by
    apply Ideal.mul_mem_left
    rw [← Finset.mul_prod_erase Finset.univ (fun l => t l ^ c l) (Finset.mem_univ l₀)]
    apply Ideal.mul_mem_right
    exact Ideal.pow_mem_of_mem _ (htm l₀) _ (Nat.pos_of_ne_zero hl₀)
  obtain ⟨G₁, rfl⟩ := Ideal.Quotient.mk_surjective F₁
  obtain ⟨G₂, rfl⟩ := Ideal.Quotient.mk_surjective F₂
  rw [← map_mul, ← map_pow, Ideal.Quotient.eq] at hF
  obtain ⟨H, hH⟩ := Ideal.mem_span_singleton'.mp hF
  have hG : G₁ * G₂ = MvPowerSeries.X (0 : Fin 2) ^ M +
      (MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
        MvPowerSeries.C (↑v * ∏ l, t l ^ c l)) * H := by
    linear_combination (-1 : MvPowerSeries (Fin 2) A) * hH
  obtain ⟨i, hiM, hu₁, hu₂⟩ := t_unit _ hhm G₁ G₂ H M hG
  refine ⟨i, hiM, ?_⟩
  intro l hl s hs a
  unfold wcpaDjStcTuQ at hs
  rw [if_neg hl] at hs
  obtain ⟨S, rfl⟩ := Ideal.Quotient.mk_surjective s
  obtain ⟨D, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hw : (↑v * ∏ k, t k ^ c k : A) =
      (↑v * ∏ k ∈ Finset.univ.erase l, t k ^ c k) * t l ^ c l := by
    rw [← Finset.mul_prod_erase Finset.univ (fun k => t k ^ c k) (Finset.mem_univ l)]
    ring
  have htw : ¬ t l ∣ (↑v * ∏ k ∈ Finset.univ.erase l, t k ^ c k) := by
    intro hd
    rcases (htp l).dvd_or_dvd hd with h1 | h1
    · exact (htp l).not_unit (isUnit_of_dvd_unit h1 v.isUnit)
    · obtain ⟨k, hk, hdk⟩ := ((htp l).dvd_finsetProd_iff _).mp h1
      exact htnd l k (Finset.ne_of_mem_erase hk).symm ((htp l).dvd_of_dvd_pow hdk)
  have hS : ∃ j', ¬ t l ∣ MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j') S := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨U, V, hUV⟩ := t_desc (t l) S hcon
    apply hs
    rw [hUV, map_add, map_mul, map_mul]
    exact Ideal.mem_span_pair.mpr ⟨Ideal.Quotient.mk _ U, Ideal.Quotient.mk _ V, by ring⟩
  obtain ⟨j', hj'⟩ := hS
  have conj : ∀ (j : ℕ) (G : MvPowerSeries (Fin 2) A),
      IsUnit (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) j) G) →
      Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) S * Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) G ≠
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) ^ (j * c l + 1) *
          Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) D := by
    intro j G hu heq
    rw [← map_pow, ← map_mul, ← map_mul, Ideal.Quotient.eq, ← map_pow] at heq
    obtain ⟨H', hH'⟩ := Ideal.mem_span_singleton'.mp heq
    have hut : ¬ t l ∣ MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) j) G :=
      fun hd => (htp l).not_unit (isUnit_of_dvd_unit hd hu)
    apply core (t l) _ (c l) j j' (htp l) htw (Nat.pos_of_ne_zero hl) G S D H' hut hj'
    rw [← hw]
    linear_combination (-1 : MvPowerSeries (Fin 2) A) * hH'
  exact ⟨conj i G₁ hu₁, conj (M - i) G₂ hu₂⟩

theorem wcpa_dj_stc_toric_unit (A : Type u) [CommRing A] [IsRegularLocalRing A] :
    wcpaDjStcToricUnitProp A :=
by
  classical
  intro hA n t hdim hspan c hc v f g J hf0 hg0 hH

  have key : ∀ (R : Type u) [CommRing R] [IsDomain R] (x : R) (τ : Fin n → R)
      (Q : Fin n → Fin 2 → Ideal R) (f g : R), f ≠ 0 → g ≠ 0 → (∃ l, c l ≠ 0) →
      (∀ b r : R, b ≠ 0 → (∀ P : Ideal R, P.IsPrime → P.height = 1 →
        ∃ s ∉ P, s * r ∈ Ideal.span {b}) → r ∈ Ideal.span {b}) →
      (∀ (l : Fin n) (σ : Fin 2), (Q l σ).IsPrime ∧ (Q l σ).height = 1 ∧ τ l ∈ Q l σ ∧
        τ l ≠ 0 ∧ (∀ k, k ≠ l → τ k ∉ Q l σ) ∧
        wcpaDjStcTuOrd (Q l σ) (τ l) x (if σ = 0 then c l else 0) ∧
        ∀ r : R, r ≠ 0 → ∃ e, wcpaDjStcTuOrd (Q l σ) (τ l) r e) →
      (∀ P : Ideal R, P.IsPrime → P.height = 1 → ∀ l, τ l ∈ P → ∃ σ, P = Q l σ) →
      (∀ P : Ideal R, P.IsPrime → x ∈ P → ∃ l, τ l ∈ P) →
      (∀ l, c l = 0 → Q l 0 = Q l 1) →
      (∀ (F₁ F₂ : R) (M : ℕ), F₁ * F₂ = x ^ M → ∃ i ≤ M, ∀ l, c l ≠ 0 → ∀ s ∉ Q l 0,
        ∀ a : R, s * F₁ ≠ τ l ^ (i * c l + 1) * a ∧ s * F₂ ≠ τ l ^ ((M - i) * c l + 1) * a) →
      (∀ P : Ideal R, P.IsPrime → P.height = 1 → (∀ l ∈ J, τ l ∉ P) →
        ∃ p q : R, p ∉ P ∧ q ∉ P ∧ p * f = q * g) →
      ∃ (α : ℤ) (β : Fin n → ℤ), (∀ l, l ∉ J → β l = 0) ∧ wcpaDjStcMonRel x τ f g α β := by
    intro R _ _ x τ Q f g hf0 hg0 hc hKC hT1 hT2 hT3 hQeq hCS hH
    have h2 : ∀ σ : Fin 2, σ = 0 ∨ σ = 1 := by decide
    have h10 : (1 : Fin 2) ≠ 0 := by decide

    have oQ1 : ∀ l σ, (1 : R) ∉ Q l σ := fun l σ h =>
      (hT1 l σ).1.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have o_unit : ∀ l σ (r : R), r ∉ Q l σ → wcpaDjStcTuOrd (Q l σ) (τ l) r 0 :=
      fun l σ r hr => ⟨1, r, oQ1 l σ, hr, by ring⟩
    have o_mul : ∀ l σ (r r' : R) e e', wcpaDjStcTuOrd (Q l σ) (τ l) r e →
        wcpaDjStcTuOrd (Q l σ) (τ l) r' e' → wcpaDjStcTuOrd (Q l σ) (τ l) (r * r') (e + e') := by
      rintro l σ r r' e e' ⟨s, u, hs, hu, h⟩ ⟨s', u', hs', hu', h'⟩
      refine ⟨s * s', u * u', fun hm => ?_, fun hm => ?_, ?_⟩
      · rcases (hT1 l σ).1.mem_or_mem hm with h1 | h1 <;> contradiction
      · rcases (hT1 l σ).1.mem_or_mem hm with h1 | h1 <;> contradiction
      · calc s * s' * (r * r') = (s * r) * (s' * r') := by ring
          _ = _ := by rw [h, h', pow_add]; ring
    have o_pow : ∀ l σ (r : R) e m, wcpaDjStcTuOrd (Q l σ) (τ l) r e →
        wcpaDjStcTuOrd (Q l σ) (τ l) (r ^ m) (m * e) := by
      intro l σ r e m h
      induction m with
      | zero => rw [pow_zero, zero_mul]; exact o_unit l σ 1 (oQ1 l σ)
      | succ m ih => rw [pow_succ, Nat.succ_mul]; exact o_mul l σ _ _ _ _ ih h
    have o_prod : ∀ l σ (r : Fin n → R) (e : Fin n → ℕ) (s : Finset (Fin n)),
        (∀ k ∈ s, wcpaDjStcTuOrd (Q l σ) (τ l) (r k) (e k)) →
        wcpaDjStcTuOrd (Q l σ) (τ l) (∏ k ∈ s, r k) (∑ k ∈ s, e k) := by
      intro l σ r e s
      induction s using Finset.induction_on with
      | empty => intro _; rw [Finset.prod_empty, Finset.sum_empty]; exact o_unit l σ 1 (oQ1 l σ)
      | insert a s ha ih =>
        intro h
        rw [Finset.prod_insert ha, Finset.sum_insert ha]
        exact o_mul l σ _ _ _ _ (h a (Finset.mem_insert_self a s))
          (ih (fun k hk => h k (Finset.mem_insert_of_mem hk)))
    have o_uniq : ∀ l σ (r : R) e e', wcpaDjStcTuOrd (Q l σ) (τ l) r e →
        wcpaDjStcTuOrd (Q l σ) (τ l) r e' → e = e' := by
      have aux : ∀ l σ (r : R) e d, wcpaDjStcTuOrd (Q l σ) (τ l) r e →
          ¬ wcpaDjStcTuOrd (Q l σ) (τ l) r (e + d + 1) := by
        rintro l σ r e d ⟨s, u, hs, hu, h⟩ ⟨s', u', hs', hu', h'⟩
        obtain ⟨hP, -, hτQ, hτ0, -⟩ := hT1 l σ
        have h1 : τ l ^ e * (s' * u - s * u' * τ l ^ (d + 1)) = 0 := by
          linear_combination (-s') * h + s * h'
        have h2 : s' * u = s * u' * τ l ^ (d + 1) :=
          sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_left (pow_ne_zero _ hτ0))
        have h3 : s * u' * τ l ^ (d + 1) ∈ Q l σ :=
          Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hτQ _ (Nat.succ_pos d))
        rw [← h2] at h3
        rcases hP.mem_or_mem h3 with h4 | h4 <;> contradiction
      intro l σ r e e' h h'
      rcases lt_trichotomy e e' with hlt | heq | hgt
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hlt
        exact absurd h' (aux l σ r e d h)
      · exact heq
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hgt
        exact absurd h (aux l σ r e' d h')
    have o_div : ∀ l σ (r₁ r₂ : R) e₁ e₂, wcpaDjStcTuOrd (Q l σ) (τ l) r₁ e₁ →
        wcpaDjStcTuOrd (Q l σ) (τ l) r₂ e₂ → e₂ ≤ e₁ →
        ∃ s ∉ Q l σ, s * r₁ ∈ Ideal.span {r₂} := by
      rintro l σ r₁ r₂ e₁ e₂ ⟨s₁, u₁, hs₁, hu₁, h₁⟩ ⟨s₂, u₂, hs₂, hu₂, h₂⟩ hle
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hle
      refine ⟨s₁ * u₂, fun hm => ?_, Ideal.mem_span_singleton'.mpr ⟨u₁ * τ l ^ d * s₂, ?_⟩⟩
      · rcases (hT1 l σ).1.mem_or_mem hm with h | h <;> contradiction
      · linear_combination (u₁ * τ l ^ d) * h₂ - u₂ * h₁
    have o_bound : ∀ l σ (F : R) e E, wcpaDjStcTuOrd (Q l σ) (τ l) F e →
        (∀ s ∉ Q l σ, ∀ a : R, s * F ≠ τ l ^ E * a) → e < E := by
      rintro l σ F e E ⟨s, u, hs, hu, h⟩ hb
      by_contra hlt
      push_neg at hlt
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hlt
      exact hb s hs (u * τ l ^ d) (by rw [h, pow_add]; ring)
    have o_ne : ∀ l σ (r : R) e, wcpaDjStcTuOrd (Q l σ) (τ l) r e → r ≠ 0 := by
      rintro l σ r e ⟨s, u, hs, hu, h⟩ hr
      rw [hr, mul_zero] at h
      have hu0 : u ≠ 0 := fun h0 => hu (by rw [h0]; exact Ideal.zero_mem _)
      exact mul_ne_zero hu0 (pow_ne_zero _ (hT1 l σ).2.2.2.1) h.symm
    obtain ⟨l₀, hl₀⟩ := hc
    have hx0 : x ≠ 0 := o_ne l₀ 0 x _ (hT1 l₀ 0).2.2.2.2.2.1

    obtain ⟨μ, hμ⟩ : ∃ μ : ℕ → (Fin n → ℕ) → R, ∀ m γ, μ m γ = x ^ m * ∏ k, τ k ^ γ k :=
      ⟨fun m γ => x ^ m * ∏ k, τ k ^ γ k, fun _ _ => rfl⟩
    have hμne : ∀ m γ, μ m γ ≠ 0 := by
      intro m γ
      rw [hμ]
      refine mul_ne_zero (pow_ne_zero _ hx0) ?_
      rw [Finset.prod_ne_zero_iff]
      intro k _
      exact pow_ne_zero _ (hT1 k 0).2.2.2.1
    have o_mon : ∀ l σ (r : R) e m γ, wcpaDjStcTuOrd (Q l σ) (τ l) r e →
        wcpaDjStcTuOrd (Q l σ) (τ l) (r * μ m γ)
          (e + (m * (if σ = 0 then c l else 0) + γ l)) := by
      intro l σ r e m γ hr
      rw [hμ]
      refine o_mul l σ _ _ _ _ hr (o_mul l σ _ _ _ _ (o_pow l σ _ _ m (hT1 l σ).2.2.2.2.2.1) ?_)
      have := o_prod l σ (fun k => τ k ^ γ k) (fun k => γ k * (if k = l then 1 else 0))
        Finset.univ (fun k _ => o_pow l σ _ _ _ (by
          by_cases hk : k = l
          · subst hk
            rw [if_pos rfl]
            exact ⟨1, 1, oQ1 _ _, oQ1 _ _, by ring⟩
          · rw [if_neg hk]
            exact o_unit l σ _ ((hT1 l σ).2.2.2.2.1 k hk)))
      simpa [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq'] using this
    have hμnot : ∀ P : Ideal R, P.IsPrime → (∀ l, τ l ∉ P) → ∀ m γ, μ m γ ∉ P := by
      intro P hP hτP m γ hm
      rw [hμ] at hm
      have hx : x ∉ P := fun hx => by
        obtain ⟨l, hl⟩ := hT3 P hP hx
        exact hτP l hl
      haveI := hP
      rcases hP.mem_or_mem hm with h | h
      · exact hx (hP.mem_of_pow_mem _ h)
      · obtain ⟨k, -, hk⟩ := Ideal.IsPrime.prod_mem_iff.mp h
        exact hτP k (hP.mem_of_pow_mem _ hk)

    have hex : ∀ (r : R), r ≠ 0 → ∀ l σ, ∃ e, wcpaDjStcTuOrd (Q l σ) (τ l) r e :=
      fun r hr l σ => (hT1 l σ).2.2.2.2.2.2 r hr
    choose ef hef using hex f hf0
    choose eg heg using hex g hg0
    obtain ⟨β, hβ⟩ : ∃ β : Fin n → ℤ, ∀ l, β l = (ef l 1 : ℤ) - eg l 1 := ⟨_, fun _ => rfl⟩
    obtain ⟨d, hd⟩ : ∃ d : Fin n → ℤ, ∀ l, d l = (ef l 0 : ℤ) - eg l 0 - β l :=
      ⟨_, fun _ => rfl⟩
    have hd0 : ∀ l, c l = 0 → d l = 0 := by
      intro l hl
      have e1 : ef l 0 = ef l 1 := by
        have h := hef l 0
        rw [hQeq l hl] at h
        exact o_uniq l 1 f _ _ h (hef l 1)
      have e2 : eg l 0 = eg l 1 := by
        have h := heg l 0
        rw [hQeq l hl] at h
        exact o_uniq l 1 g _ _ h (heg l 1)
      rw [hd, hβ]
      omega
    have hβJ : ∀ l, l ∉ J → β l = 0 := by
      intro l hl
      obtain ⟨hP, hht, -, -, hnot, -, -⟩ := hT1 l 1
      obtain ⟨p, q, hp, hq, hpq⟩ := hH (Q l 1) hP hht
        (fun k hk => hnot k (fun h => hl (by rw [← h]; exact hk)))
      have e1 := o_mul l 1 p f 0 (ef l 1) (o_unit l 1 p hp) (hef l 1)
      have e2 := o_mul l 1 q g 0 (eg l 1) (o_unit l 1 q hq) (heg l 1)
      rw [hpq] at e1
      have := o_uniq l 1 _ _ _ e1 e2
      rw [hβ]
      omega

    have hD : ∀ r₁ r₂ : R, r₂ ≠ 0 →
        (∀ l σ, ∃ e₁ e₂, e₂ ≤ e₁ ∧ wcpaDjStcTuOrd (Q l σ) (τ l) r₁ e₁ ∧
          wcpaDjStcTuOrd (Q l σ) (τ l) r₂ e₂) →
        (∀ P : Ideal R, P.IsPrime → P.height = 1 → (∀ l, τ l ∉ P) →
          ∃ s ∉ P, s * r₁ ∈ Ideal.span {r₂}) →
        r₁ ∈ Ideal.span {r₂} := by
      intro r₁ r₂ hr₂ hord hnt
      refine hKC r₂ r₁ hr₂ (fun P hP hht => ?_)
      by_cases hτ : ∃ l, τ l ∈ P
      · obtain ⟨l, hl⟩ := hτ
        obtain ⟨σ, rfl⟩ := hT2 P hP hht l hl
        obtain ⟨e₁, e₂, hle, h₁, h₂⟩ := hord l σ
        exact o_div l σ r₁ r₂ e₁ e₂ h₁ h₂ hle
      · push_neg at hτ
        exact hnt P hP hht hτ
    have hNT : ∀ P : Ideal R, P.IsPrime → P.height = 1 → (∀ l, τ l ∉ P) → ∀ m₁ γ₁ m₂ γ₂,
        (∃ s ∉ P, s * (f * μ m₁ γ₁) ∈ Ideal.span {g * μ m₂ γ₂}) ∧
        (∃ s ∉ P, s * (g * μ m₁ γ₁) ∈ Ideal.span {f * μ m₂ γ₂}) := by
      intro P hP hht hτP m₁ γ₁ m₂ γ₂
      obtain ⟨p, q, hp, hq, hpq⟩ := hH P hP hht (fun l _ => hτP l)
      have h2 := hμnot P hP hτP m₂ γ₂
      refine ⟨⟨p * μ m₂ γ₂, fun hm => ?_, Ideal.mem_span_singleton'.mpr ⟨q * μ m₁ γ₁, ?_⟩⟩,
        ⟨q * μ m₂ γ₂, fun hm => ?_, Ideal.mem_span_singleton'.mpr ⟨p * μ m₁ γ₁, ?_⟩⟩⟩
      · rcases hP.mem_or_mem hm with h | h <;> contradiction
      · linear_combination (-(μ m₁ γ₁ * μ m₂ γ₂)) * hpq
      · rcases hP.mem_or_mem hm with h | h <;> contradiction
      · linear_combination (μ m₁ γ₁ * μ m₂ γ₂) * hpq
    have hDfg : ∀ m₁ γ₁ m₂ γ₂, (∀ (l : Fin n) (σ : Fin 2),
        eg l σ + (m₂ * (if σ = 0 then c l else 0) + γ₂ l) ≤
          ef l σ + (m₁ * (if σ = 0 then c l else 0) + γ₁ l)) →
        f * μ m₁ γ₁ ∈ Ideal.span {g * μ m₂ γ₂} := by
      intro m₁ γ₁ m₂ γ₂ hle
      exact hD _ _ (mul_ne_zero hg0 (hμne _ _))
        (fun l σ => ⟨_, _, hle l σ, o_mon l σ f _ m₁ γ₁ (hef l σ), o_mon l σ g _ m₂ γ₂ (heg l σ)⟩)
        (fun P hP hht hτP => (hNT P hP hht hτP m₁ γ₁ m₂ γ₂).1)
    have hDgf : ∀ m₁ γ₁ m₂ γ₂, (∀ (l : Fin n) (σ : Fin 2),
        ef l σ + (m₂ * (if σ = 0 then c l else 0) + γ₂ l) ≤
          eg l σ + (m₁ * (if σ = 0 then c l else 0) + γ₁ l)) →
        g * μ m₁ γ₁ ∈ Ideal.span {f * μ m₂ γ₂} := by
      intro m₁ γ₁ m₂ γ₂ hle
      exact hD _ _ (mul_ne_zero hf0 (hμne _ _))
        (fun l σ => ⟨_, _, hle l σ, o_mon l σ g _ m₁ γ₁ (heg l σ), o_mon l σ f _ m₂ γ₂ (hef l σ)⟩)
        (fun P hP hht hτP => (hNT P hP hht hτP m₁ γ₁ m₂ γ₂).2)

    obtain ⟨K, hK⟩ : ∃ K : ℕ, K = ∑ l, (d l).natAbs := ⟨_, rfl⟩
    have hKl : ∀ l, (d l).natAbs ≤ K := fun l => by
      rw [hK]
      exact Finset.single_le_sum (f := fun i => (d i).natAbs) (fun i _ => Nat.zero_le _)
        (Finset.mem_univ l)
    have hKc : ∀ l, c l ≠ 0 → (d l).natAbs ≤ K * c l := fun l hl =>
      (hKl l).trans (Nat.le_mul_of_pos_right K (Nat.pos_of_ne_zero hl))
    obtain ⟨bp, hbp⟩ : ∃ bp : Fin n → ℕ, ∀ l, bp l = (β l).toNat := ⟨_, fun _ => rfl⟩
    obtain ⟨bm, hbm⟩ : ∃ bm : Fin n → ℕ, ∀ l, bm l = (-β l).toNat := ⟨_, fun _ => rfl⟩
    have hpm : ∀ l, (bp l : ℤ) - bm l = β l := fun l => by
      rw [hbp, hbm]; exact Int.toNat_sub_toNat_neg _
    have hF1 : f * μ K bm ∈ Ideal.span {g * μ 0 bp} := hDfg K bm 0 bp (fun l σ => by
      have := hd l; have := hpm l; have := hβ l; have := hd0 l
      have h1 : d l ≤ ((d l).natAbs : ℤ) := Int.le_natAbs
      have h2' : -d l ≤ ((d l).natAbs : ℤ) := by omega
      rcases h2 σ with rfl | rfl
      · rw [if_pos rfl]
        by_cases hcl : c l = 0
        · rw [hcl]; have := hd0 l hcl; omega
        · have := hKc l hcl; omega
      · rw [if_neg h10]; omega)
    have hF2 : g * μ K bp ∈ Ideal.span {f * μ 0 bm} := hDgf K bp 0 bm (fun l σ => by
      have := hd l; have := hpm l; have := hβ l
      have h1 : d l ≤ ((d l).natAbs : ℤ) := Int.le_natAbs
      have h2' : -d l ≤ ((d l).natAbs : ℤ) := by omega
      rcases h2 σ with rfl | rfl
      · rw [if_pos rfl]
        by_cases hcl : c l = 0
        · rw [hcl]; have := hd0 l hcl; omega
        · have := hKc l hcl; omega
      · rw [if_neg h10]; omega)
    obtain ⟨F₁, hF₁⟩ := Ideal.mem_span_singleton'.mp hF1
    obtain ⟨F₂, hF₂⟩ := Ideal.mem_span_singleton'.mp hF2
    have hprod : F₁ * F₂ = x ^ (K + K) := by
      have hne : (g * μ 0 bp) * (f * μ 0 bm) ≠ 0 :=
        mul_ne_zero (mul_ne_zero hg0 (hμne _ _)) (mul_ne_zero hf0 (hμne _ _))
      apply mul_right_cancel₀ hne
      calc F₁ * F₂ * ((g * μ 0 bp) * (f * μ 0 bm))
          = (F₁ * (g * μ 0 bp)) * (F₂ * (f * μ 0 bm)) := by ring
        _ = (f * μ K bm) * (g * μ K bp) := by rw [hF₁, hF₂]
        _ = x ^ (K + K) * ((g * μ 0 bp) * (f * μ 0 bm)) := by simp only [hμ]; ring
    obtain ⟨i, hiM, hi⟩ := hCS F₁ F₂ (K + K) hprod
    have hdl : ∀ l, d l = ((i : ℤ) - K) * c l := by
      intro l
      by_cases hcl : c l = 0
      · rw [hd0 l hcl, hcl]; simp
      have hx := (hT1 l 0).2.2.2.2.2.1
      rw [if_pos rfl] at hx
      have hF₁0 : F₁ ≠ 0 := fun h => by
        rw [h, zero_mul] at hprod; exact pow_ne_zero _ hx0 hprod.symm
      have hF₂0 : F₂ ≠ 0 := fun h => by
        rw [h, mul_zero] at hprod; exact pow_ne_zero _ hx0 hprod.symm
      obtain ⟨e₁, he₁⟩ := (hT1 l 0).2.2.2.2.2.2 F₁ hF₁0
      obtain ⟨e₂, he₂⟩ := (hT1 l 0).2.2.2.2.2.2 F₂ hF₂0
      have b1 := o_bound l 0 F₁ e₁ _ he₁ (fun s hs a => (hi l hcl s hs a).1)
      have b2 := o_bound l 0 F₂ e₂ _ he₂ (fun s hs a => (hi l hcl s hs a).2)
      have u1 := o_uniq l 0 _ _ _ (o_mul l 0 F₁ F₂ e₁ e₂ he₁ he₂)
        (by rw [hprod]; exact o_pow l 0 x _ (K + K) hx)
      have u2 := o_uniq l 0 _ _ _ (o_mul l 0 F₁ (g * μ 0 bp) e₁ _ he₁ (o_mon l 0 g _ 0 bp (heg l 0)))
        (by rw [hF₁]; exact o_mon l 0 f _ K bm (hef l 0))
      rw [if_pos rfl] at u2
      have hsub : (K + K - i) * c l + i * c l = (K + K) * c l := by
        rw [← add_mul, Nat.sub_add_cancel hiM]
      have := hd l; have := hpm l
      have k1 : e₁ = i * c l := by omega
      have k2 : d l = ((i * c l : ℕ) : ℤ) - ((K * c l : ℕ) : ℤ) := by omega
      rw [k2]; push_cast; ring
    refine ⟨(i : ℤ) - K, β, hβJ, ?_⟩
    obtain ⟨ap, hap⟩ : ∃ ap : ℕ, ap = ((i : ℤ) - K).toNat := ⟨_, rfl⟩
    obtain ⟨am, ham⟩ : ∃ am : ℕ, am = (-((i : ℤ) - K)).toNat := ⟨_, rfl⟩
    have hapm : (ap : ℤ) - am = (i : ℤ) - K := by rw [hap, ham]; exact Int.toNat_sub_toNat_neg _
    have hdc : ∀ l, d l = ((ap * c l : ℕ) : ℤ) - ((am * c l : ℕ) : ℤ) := by
      intro l; rw [hdl l, ← hapm]; push_cast; ring
    have hR1 : f * μ am bm ∈ Ideal.span {g * μ ap bp} := hDfg am bm ap bp (fun l σ => by
      have := hdc l; have := hd l; have := hpm l; have := hβ l
      rcases h2 σ with rfl | rfl
      · rw [if_pos rfl]; omega
      · rw [if_neg h10]; omega)
    have hR2 : g * μ ap bp ∈ Ideal.span {f * μ am bm} := hDgf ap bp am bm (fun l σ => by
      have := hdc l; have := hd l; have := hpm l; have := hβ l
      rcases h2 σ with rfl | rfl
      · rw [if_pos rfl]; omega
      · rw [if_neg h10]; omega)
    obtain ⟨w₁, hw₁⟩ := Ideal.mem_span_singleton'.mp hR1
    obtain ⟨w₂, hw₂⟩ := Ideal.mem_span_singleton'.mp hR2
    have hR1ne : f * μ am bm ≠ 0 := mul_ne_zero hf0 (hμne _ _)
    have hw : w₁ * w₂ = 1 := by
      apply mul_right_cancel₀ hR1ne
      calc w₁ * w₂ * (f * μ am bm) = w₁ * (w₂ * (f * μ am bm)) := by ring
        _ = f * μ am bm := by rw [hw₂, hw₁]
        _ = 1 * (f * μ am bm) := by ring
    refine ⟨Units.mkOfMulEqOne w₁ w₂ hw, ?_⟩
    rw [Units.val_mkOfMulEqOne, ← hap, ← ham]
    simp only [← hbp, ← hbm]
    have e1 := hw₁
    simp only [hμ] at e1
    linear_combination (-1 : R) * e1

  obtain ⟨hAdom, htp, -⟩ := wcpa_dj_bko_regular_params A n t hdim hspan
  haveI := hAdom
  obtain ⟨l₀, hl₀⟩ := hc
  have htm : ∀ l, t l ∈ IsLocalRing.maximalIdeal A := fun l =>
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (htp l).not_unit)
  have hhm : (↑v * ∏ l, t l ^ c l : A) ∈ IsLocalRing.maximalIdeal A := by
    apply Ideal.mul_mem_left
    rw [← Finset.mul_prod_erase Finset.univ (fun l => t l ^ c l) (Finset.mem_univ l₀)]
    apply Ideal.mul_mem_right
    exact Ideal.pow_mem_of_mem _ (htm l₀) _ (Nat.pos_of_ne_zero hl₀)
  have hh0 : (↑v * ∏ l, t l ^ c l : A) ≠ 0 := by
    refine mul_ne_zero v.ne_zero ?_
    rw [Finset.prod_ne_zero_iff]
    intro l _
    exact pow_ne_zero _ (htp l).ne_zero
  haveI hBreg := wcpa_dj_stc_tu_ps_regular A
  obtain ⟨hBdom, hBufd⟩ := wc_fco_regular_local_ufd (PowerSeries A)
  haveI := hBdom
  haveI := hBufd
  have hBc := wcpa_dj_stc_tu_ps_complete A hA
  obtain ⟨Φ, -, -, -⟩ := wcpa_dj_stc_tu_weierstrass A hBc _ hhm
  have hnr := wcpa_dj_stc_tu_no_root A _ hhm hh0
  haveI hAdj := wcpa_dj_stc_tu_adjoin_domain (PowerSeries A) PowerSeries.X
    (PowerSeries.C (↑v * ∏ l, t l ^ c l)) hnr
  haveI hRdom : IsDomain (wcpaDjStcTuRing A t c v) :=
    Function.Injective.isDomain Φ.symm Φ.symm.injective
  have hKC : ∀ b r : wcpaDjStcTuRing A t c v, b ≠ 0 →
      (∀ Q : Ideal (wcpaDjStcTuRing A t c v), Q.IsPrime → Q.height = 1 →
        ∃ s ∉ Q, s * r ∈ Ideal.span {b}) → r ∈ Ideal.span {b} := by
    intro b r hb hloc
    letI : Algebra (PowerSeries A) (wcpaDjStcTuRing A t c v) :=
      (Φ.toRingHom.comp (AdjoinRoot.of _)).toAlgebra
    have hmon : (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X * Polynomial.X +
        Polynomial.C (PowerSeries.C (↑v * ∏ l, t l ^ c l)) :
          Polynomial (PowerSeries A)).Monic := by
      monicity!
    let e : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X * Polynomial.X +
        Polynomial.C (PowerSeries.C (↑v * ∏ l, t l ^ c l)) : Polynomial (PowerSeries A))
        ≃ₐ[PowerSeries A] wcpaDjStcTuRing A t c v :=
      AlgEquiv.ofRingEquiv (f := Φ) (fun y => by
        rw [AdjoinRoot.algebraMap_eq, RingHom.algebraMap_toAlgebra]; rfl)
    haveI : Module.Free (PowerSeries A) (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C PowerSeries.X *
        Polynomial.X + Polynomial.C (PowerSeries.C (↑v * ∏ l, t l ^ c l)) :
          Polynomial (PowerSeries A))) :=
      Module.Free.of_basis (AdjoinRoot.powerBasis' hmon).basis
    haveI : Module.Finite (PowerSeries A) (AdjoinRoot (Polynomial.X ^ 2 -
        Polynomial.C PowerSeries.X * Polynomial.X + Polynomial.C (PowerSeries.C (↑v * ∏ l, t l ^ c l)) :
          Polynomial (PowerSeries A))) :=
      Module.Finite.of_basis (AdjoinRoot.powerBasis' hmon).basis
    haveI : Module.Free (PowerSeries A) (wcpaDjStcTuRing A t c v) :=
      Module.Free.of_equiv e.toLinearEquiv
    haveI : Module.Finite (PowerSeries A) (wcpaDjStcTuRing A t c v) :=
      Module.Finite.equiv e.toLinearEquiv
    exact wcpa_dj_stc_tu_krull_criterion (PowerSeries A) (wcpaDjStcTuRing A t c v) b r hb hloc
  obtain ⟨hT1, hT2, hT3⟩ :=
    wcpa_dj_stc_tu_toric_orders A hA n t hdim hspan c ⟨l₀, hl₀⟩ v hRdom
  have hCS := wcpa_dj_stc_tu_class_step A n t hdim hspan c ⟨l₀, hl₀⟩ v hRdom
  have hQeq : ∀ l, c l = 0 → wcpaDjStcTuQ A t c v l 0 = wcpaDjStcTuQ A t c v l 1 := by
    intro l hl
    unfold wcpaDjStcTuQ
    simp [hl]
  exact key (wcpaDjStcTuRing A t c v)
    (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)))
    (fun l => Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l)))
    (wcpaDjStcTuQ A t c v) f g hf0 hg0 ⟨l₀, hl₀⟩ hKC hT1 hT2 hT3 hQeq hCS hH

theorem wcpa_dj_ts_boundary : ∀ (S Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y] (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (D : Set S), Flat g → IsProper g → wcpaDjSections g m τ → IsClosed D → D ≠ Set.univ → IsClosed (⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j)) ∧ genericPoint Y ∉ (⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j)) :=
by
  intro S Y _ _ g m τ D hflat hprop hsec hDcl hDne
  classical
  obtain ⟨hs1, -, hs3⟩ := hsec
  have hτci : ∀ j, IsClosedImmersion (τ j) := by
    intro j
    haveI : IsClosedImmersion (τ j ≫ g) := by rw [hs1 j]; infer_instance
    exact IsClosedImmersion.of_comp (τ j) g
  have hτcl : ∀ j, IsClosed (Set.range ⇑(τ j)) := by
    intro j
    haveI := hτci j
    exact (τ j).isClosedEmbedding.isClosed_range
  have hgη : g (genericPoint Y) = genericPoint S := by
    haveI := hflat
    obtain ⟨y₀⟩ := (inferInstance : Nonempty Y)
    have h1 : genericPoint S ⤳ g y₀ := (genericPoint_spec S).specializes trivial
    obtain ⟨y', _, hgy'⟩ := Flat.generalizingMap g h1
    have h2 : genericPoint Y ⤳ y' := (genericPoint_spec Y).specializes trivial
    have h3 : g (genericPoint Y) ⤳ genericPoint S := hgy' ▸ h2.map g.continuous
    have h4 : genericPoint S ⤳ g (genericPoint Y) := (genericPoint_spec S).specializes trivial
    exact (h3.antisymm h4).eq
  have hηD : g (genericPoint Y) ∉ D := by
    intro h
    rw [hgη] at h
    apply hDne
    apply Set.eq_univ_of_forall
    intro p
    exact ((genericPoint_spec S).specializes trivial).mem_closed hDcl h
  have hητ : ∀ j, genericPoint Y ∉ Set.range ⇑(τ j) := by
    intro j hmem
    obtain ⟨p₀, hp₀⟩ := hmem
    haveI := hτci j
    haveI : Surjective (τ j) := ⟨fun y =>
      ((genericPoint_spec Y).specializes trivial).mem_closed (hτcl j) ⟨p₀, hp₀⟩⟩
    haveI : IsIso (τ j) := isIso_of_isClosedImmersion_of_surjective (τ j)
    haveI : IsIso g := by
      haveI : IsIso (τ j ≫ g) := by rw [hs1 j]; infer_instance
      exact IsIso.of_isIso_comp_left (τ j) g
    obtain ⟨W, hW, hWsm⟩ := hs3 j p₀
    obtain ⟨U, hU, V, hV, hx, e, H⟩ :=
      hWsm.exists_isStandardSmoothOfRelativeDimension (⟨τ j p₀, hW⟩ : W.toScheme)
    letI := (Scheme.Hom.appLE (W.ι ≫ g) U V e).hom.toAlgebra
    haveI : Nonempty V := ⟨⟨_, hx⟩⟩
    haveI : Nontrivial Γ(W.toScheme, V) := Scheme.component_nontrivial _ V
    have H' : Algebra.IsStandardSmoothOfRelativeDimension 1 Γ(S, U) Γ(W.toScheme, V) := H
    have r1 := H'.rank_kaehlerDifferential
    have hfu : Algebra.FormallyUnramified Γ(S, U) Γ(W.toScheme, V) :=
      FormallyUnramified.formallyUnramified_appLE (W.ι ≫ g) hU hV e
    haveI := hfu
    haveI : Subsingleton Ω[Γ(W.toScheme, V)⁄Γ(S, U)] := by
      first
        | exact Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
        | exact Algebra.FormallyUnramified.iff_subsingleton_kaehlerDifferential.mp hfu
        | infer_instance
    have r0 := rank_subsingleton' Γ(W.toScheme, V) Ω[Γ(W.toScheme, V)⁄Γ(S, U)]
    rw [r0] at r1
    exact zero_ne_one r1
  refine ⟨(hDcl.preimage g.continuous).union (isClosed_iUnion_of_finite hτcl), ?_⟩
  intro hmem
  rcases hmem with h | h
  · exact hηD h
  · obtain ⟨j, hj⟩ := Set.mem_iUnion.mp h
    exact hητ j hj

theorem wcpa_dj_stc_kmn_generic_ratio : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjStcKmHyp k S Y sS g m τ W mD Dc N I O a →
    ∀ i₀ ∈ I, ∀ i ∈ I,
      ∃ hη : genericPoint Y ∈ O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
        (MvPolynomial.X i₀)),
        (Y.presheaf.germ (O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
          (MvPolynomial.X i₀))) (genericPoint Y) hη).hom (wcpaDjStcRatioSec k O a i₀ i) ≠ 0 :=
by
  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a hH i₀ hi₀ i hi
  classical
  obtain ⟨_, _, h3, _, h5, h6, _, _, _, _, _, h12, _, _, h15⟩ := hH
  obtain ⟨hflat, hprop, -⟩ := h3
  have hWne : ((W : Set S)ᶜ) ≠ Set.univ := by
    intro h0
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp h6
    have hx' : x ∈ ((W : Set S)ᶜ) := by rw [h0]; exact Set.mem_univ x
    exact hx' hx
  have hη₀ := (wcpa_dj_ts_boundary S Y g m τ (W : Set S)ᶜ hflat hprop h5
    W.isOpen.isClosed_compl hWne).2
  have hηO : genericPoint Y ∈ O := by
    apply h12
    rw [Scheme.Hom.mem_preimage]
    by_contra hc
    exact hη₀ (Or.inl hc)
  let c : O.toScheme := ⟨genericPoint Y, hηO⟩
  have hcη : O.ι c = genericPoint Y := rfl
  have hD : ∀ j ∈ I, a c ∈ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X j) := by
    intro j hj
    by_contra hcon
    have h := h15 c ⟨j, hj, hcon⟩
    rw [hcη] at h
    rcases h with h | h
    · exact hη₀ (Or.inr h)
    · exact hη₀ (Or.inl h)
  have hcU' : c ∈ a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀) := hD i₀ hi₀
  have hηV : genericPoint Y ∈ O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀)) := ⟨c, hcU', rfl⟩
  refine ⟨hηV, ?_⟩
  have hchart := (wcpa_dj_gsfp_chart_facts k N).2 i₀ i i₀
  have hbo : (wcProjK k N).basicOpen (wcSgE k N i₀ i) = wcSgD k N i₀ ⊓ wcSgD k N i :=
    hchart.2.1
  have hac : a c ∈ (wcProjK k N).basicOpen (wcSgE k N i₀ i) := by
    rw [hbo]; exact ⟨hD i₀ hi₀, hD i hi⟩
  have hu0 := ((wcProjK k N).mem_basicOpen (wcSgE k N i₀ i) (a c) (hD i₀ hi₀)).mp hac
  have hu1 := hu0.map (a.stalkMap c).hom
  rw [Scheme.Hom.germ_stalkMap_apply] at hu1
  have hcV : O.ι c ∈ O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀)) := hηV
  have key : (O.ι.stalkMap c).hom ((Y.presheaf.germ (O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀))) (O.ι c) hcV).hom (wcpaDjStcRatioSec k O a i₀ i)) =
      (O.toScheme.presheaf.germ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
        (MvPolynomial.X i₀)) c hcU').hom
        ((a.app (@Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
          (MvPolynomial.X i₀))).hom (wcSgE k N i₀ i)) := by
    rw [Scheme.Hom.germ_stalkMap_apply]
    unfold wcpaDjStcRatioSec
    erw [Scheme.Hom.appIso_inv_app_apply, TopCat.Presheaf.germ_res_apply]
  have hu2 : IsUnit ((O.ι.stalkMap c).hom ((Y.presheaf.germ (O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀))) (O.ι c) hcV).hom (wcpaDjStcRatioSec k O a i₀ i))) := by
    rw [key]; exact hu1
  exact (isUnit_of_map_unit _ _ hu2).ne_zero

theorem wcpa_dj_stc_kmn_ratio_link : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (V : Y.Opens) (r : Γ(Y, V)) (y : Y) (hη : genericPoint Y ∈ V),
    ∃ num den : Y.presheaf.stalk y, wcpaDjStcRatioLink r y num den ∧ den ≠ 0 ∧
      ((Y.presheaf.germ V (genericPoint Y) hη).hom r ≠ 0 → num ≠ 0) :=
by
  intro Y _ V r y hη
  have hal : ∀ (x : Y) (hx : genericPoint Y ⤳ x),
      algebraMap (Y.presheaf.stalk x) Y.functionField = (Y.presheaf.stalkSpecializes hx).hom :=
    fun _ _ => rfl
  set φ : Y.functionField := (Y.presheaf.germ V (genericPoint Y) hη).hom r with hφ
  obtain ⟨⟨a, s⟩, hst⟩ := IsLocalization.surj (nonZeroDivisors (Y.presheaf.stalk y)) φ
  simp only at hst
  have hsne : algebraMap (Y.presheaf.stalk y) Y.functionField (s : Y.presheaf.stalk y) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors s.2
  refine ⟨a, s, ?_, nonZeroDivisors.ne_zero s.2, ?_⟩
  · unfold wcpaDjStcRatioLink
    refine ⟨s.2, ?_⟩
    intro w hw h
    apply IsFractionRing.injective (Y.presheaf.stalk w) Y.functionField
    rw [map_mul, hal w (genericPoint_specializes w)]
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply, TopCat.Presheaf.stalkSpecializes_comp_apply,
      TopCat.Presheaf.stalkSpecializes_comp_apply]
    rw [hal y (genericPoint_specializes y)] at hst
    exact hst
  · intro hφ0 ha
    apply hφ0
    rw [ha, map_zero] at hst
    exact (mul_eq_zero.mp hst).resolve_right hsne

theorem wcpa_dj_stc_kmo_smooth_regular_params : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y) (n : ℕ)
    (t : Fin n → S.presheaf.stalk (g y)),
    IsRegularLocalRing (S.presheaf.stalk (g y)) →
    (∃ W' : Y.Opens, y ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g)) →
    (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk (g y)) →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)) →
    IsRegularLocalRing (Y.presheaf.stalk y) ∧ ∃ (e : ℕ) (f : Fin e → Y.presheaf.stalk y),
      Ideal.span (Set.range (Fin.append (fun i => (g.stalkMap y).hom (t i)) f)) =
        IsLocalRing.maximalIdeal (Y.presheaf.stalk y) ∧
      ((n + e : ℕ) : WithBot ℕ∞) = ringKrullDim (Y.presheaf.stalk y) :=
by
  intro S Y g y n t hR hsm hn ht
  haveI := hR
  obtain ⟨hAnoeth, Q, hQprime, β, hQ, hcomp, hloc, hflat, hmax⟩ :=
    wcpa_dj_sp_smooth_stalk_model S Y g y inferInstance hsm
  haveI := hAnoeth
  haveI := hQprime
  obtain ⟨e, f₀, -, -, hspanC, hdimC⟩ :=
    wcpa_dj_sp_poly_prime_params (S.presheaf.stalk (g y)) n t hn ht Q hQ
  obtain ⟨hspanA, hdimA⟩ :=
    wcpa_dj_sp_flat_unram_params (Localization.AtPrime Q) (Y.presheaf.stalk y) β hloc hflat hmax
      (n + e) _ hspanC hdimC
  let f : Fin e → Y.presheaf.stalk y :=
    fun j => β (algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q) (f₀ j))
  have hfun : (fun i => β (Fin.append
      (fun i => algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q)
        (Polynomial.C (t i)))
      (fun j => algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q)
        (f₀ j)) i)) =
      Fin.append (fun i => (g.stalkMap y).hom (t i)) f := by
    funext i
    refine Fin.addCases (fun i => ?_) (fun j => ?_) i
    · rw [Fin.append_left, Fin.append_left]
      have := RingHom.congr_fun hcomp (t i)
      simpa using this
    · rw [Fin.append_right, Fin.append_right]
  rw [hfun] at hspanA
  have hle : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) ≤ n + e := by
    rw [← hspanA]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
  have hreg : IsRegularLocalRing (Y.presheaf.stalk y) := by
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    rw [← hdimA]
    exact_mod_cast hle
  exact ⟨hreg, e, f, hspanA, hdimA⟩

theorem wcpa_dj_stc_kmo_ufd_monomial : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] (n : ℕ)
    (s : Fin n → R) (J : Finset (Fin n)) (num den : R),
    (∀ l ∈ J, Prime (s l)) → (∀ l ∈ J, ∀ l' ∈ J, l ≠ l' → ¬ s l ∣ s l') →
    num ≠ 0 → den ≠ 0 →
    (∀ π : R, Prime π → (∀ l ∈ J, ¬ π ∣ s l) →
      ∃ a b : R, ¬ π ∣ a ∧ ¬ π ∣ b ∧ a * num = b * den) →
    ∃ β : Fin n → ℤ, (∀ l, l ∉ J → β l = 0) ∧
      (∀ l ∈ J, β l = (multiplicity (s l) num : ℤ) - (multiplicity (s l) den : ℤ)) ∧
      wcpaDjStcMonRel (1 : R) s num den 0 β :=
by
  intro R _ _ _ n s J num den hP hND hnum hden hH
  classical

  have s1 : ∀ A B : R, A ≠ 0 → B ≠ 0 →
      (∀ π : R, Prime π → emultiplicity π A = emultiplicity π B) → Associated A B := by
    intro A B hA hB h
    letI : StrongNormalizationMonoid R := UniqueFactorizationMonoid.strongNormalizationMonoid
    rw [UniqueFactorizationMonoid.associated_iff_normalizedFactors_eq_normalizedFactors hA hB]
    have key : ∀ p : R, Prime p → normalize p = p →
        Multiset.count p (UniqueFactorizationMonoid.normalizedFactors A) =
          Multiset.count p (UniqueFactorizationMonoid.normalizedFactors B) := by
      intro p hp hn
      have e1 := UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors
        hp.irreducible hA
      have e2 := UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors
        hp.irreducible hB
      rw [hn] at e1 e2
      have h3 := h p hp
      rw [e1, e2] at h3
      exact_mod_cast h3
    ext p
    by_cases hpA : p ∈ UniqueFactorizationMonoid.normalizedFactors A
    · exact key p (UniqueFactorizationMonoid.prime_of_normalized_factor p hpA)
        (UniqueFactorizationMonoid.normalize_normalized_factor p hpA)
    · by_cases hpB : p ∈ UniqueFactorizationMonoid.normalizedFactors B
      · exact key p (UniqueFactorizationMonoid.prime_of_normalized_factor p hpB)
          (UniqueFactorizationMonoid.normalize_normalized_factor p hpB)
      · rw [Multiset.count_eq_zero.mpr hpA, Multiset.count_eq_zero.mpr hpB]

  obtain ⟨β, hβJ, hβv⟩ : ∃ β : Fin n → ℤ, (∀ l, l ∉ J → β l = 0) ∧
      (∀ l ∈ J, β l = (multiplicity (s l) num : ℤ) - (multiplicity (s l) den : ℤ)) :=
    ⟨fun l => if l ∈ J then (multiplicity (s l) num : ℤ) - (multiplicity (s l) den : ℤ) else 0,
      fun l hl => if_neg hl, fun l hl => if_pos hl⟩
  refine ⟨β, hβJ, hβv, ?_⟩

  have hprod : ∀ p : R, Prime p → ∀ e : Fin n → ℕ, (∀ l, l ∉ J → e l = 0) →
      emultiplicity p (∏ l, s l ^ e l) = ∑ l ∈ J, (e l : ℕ∞) * emultiplicity p (s l) := by
    intro p hp e he
    rw [Finset.emultiplicity_prod hp]
    simp_rw [emultiplicity_pow hp]
    symm
    apply Finset.sum_subset (Finset.subset_univ J)
    intro l _ hl
    rw [he l hl]
    simp
  have heM : ∀ l, l ∉ J → (-(β l)).toNat = 0 := fun l hl => by rw [hβJ l hl]; rfl
  have heP : ∀ l, l ∉ J → (β l).toNat = 0 := fun l hl => by rw [hβJ l hl]; rfl

  have hprod_ne : ∀ e : Fin n → ℕ, (∀ l, l ∉ J → e l = 0) → ∏ l, s l ^ e l ≠ 0 := by
    intro e he
    rw [Finset.prod_ne_zero_iff]
    intro l _
    by_cases hl : l ∈ J
    · exact pow_ne_zero _ (hP l hl).ne_zero
    · rw [he l hl, pow_zero]; exact one_ne_zero
  have hA : num * ∏ l, s l ^ (-(β l)).toNat ≠ 0 := mul_ne_zero hnum (hprod_ne _ heM)
  have hB : den * ∏ l, s l ^ (β l).toNat ≠ 0 := mul_ne_zero hden (hprod_ne _ heP)

  have hval : ∀ π : R, Prime π → emultiplicity π (num * ∏ l, s l ^ (-(β l)).toNat) =
      emultiplicity π (den * ∏ l, s l ^ (β l).toNat) := by
    intro π hπ
    by_cases hb : ∃ l ∈ J, π ∣ s l
    · obtain ⟨l₀, hl₀, hdvd⟩ := hb
      have hassoc : Associated π (s l₀) := hπ.associated_of_dvd (hP l₀ hl₀) hdvd
      rw [← emultiplicity_eq_of_associated_left hassoc,
        ← emultiplicity_eq_of_associated_left hassoc]
      have hp : Prime (s l₀) := hP l₀ hl₀
      have hsingle : ∀ e : Fin n → ℕ, (∀ l, l ∉ J → e l = 0) →
          emultiplicity (s l₀) (∏ l, s l ^ e l) = (e l₀ : ℕ∞) := by
        intro e he
        rw [hprod (s l₀) hp e he, Finset.sum_eq_single_of_mem l₀ hl₀]
        · rw [FiniteMultiplicity.emultiplicity_self
            (FiniteMultiplicity.of_not_isUnit hp.not_isUnit hp.ne_zero), mul_one]
        · intro l hl hne
          rw [emultiplicity_eq_zero.mpr (hND l₀ hl₀ l hl (Ne.symm hne)), mul_zero]
      have fnum : FiniteMultiplicity (s l₀) num :=
        FiniteMultiplicity.of_not_isUnit hp.not_isUnit hnum
      have fden : FiniteMultiplicity (s l₀) den :=
        FiniteMultiplicity.of_not_isUnit hp.not_isUnit hden
      rw [emultiplicity_mul hp, emultiplicity_mul hp, hsingle _ heM, hsingle _ heP,
        fnum.emultiplicity_eq_multiplicity, fden.emultiplicity_eq_multiplicity, hβv l₀ hl₀]
      have h1 : (-((multiplicity (s l₀) num : ℤ) - (multiplicity (s l₀) den : ℤ))).toNat =
          multiplicity (s l₀) den - multiplicity (s l₀) num := by omega
      have h2 : ((multiplicity (s l₀) num : ℤ) - (multiplicity (s l₀) den : ℤ)).toNat =
          multiplicity (s l₀) num - multiplicity (s l₀) den := by omega
      rw [h1, h2, ← Nat.cast_add, ← Nat.cast_add]
      congr 1
      omega
    · push_neg at hb
      have hzero : ∀ e : Fin n → ℕ, (∀ l, l ∉ J → e l = 0) →
          emultiplicity π (∏ l, s l ^ e l) = 0 := by
        intro e he
        rw [hprod π hπ e he]
        apply Finset.sum_eq_zero
        intro l hl
        rw [emultiplicity_eq_zero.mpr (hb l hl), mul_zero]
      obtain ⟨a, b, ha, hb', hab⟩ := hH π hπ hb
      have e1 := congrArg (emultiplicity π) hab
      rw [emultiplicity_mul hπ, emultiplicity_mul hπ, emultiplicity_eq_zero.mpr ha,
        emultiplicity_eq_zero.mpr hb', zero_add, zero_add] at e1
      rw [emultiplicity_mul hπ, emultiplicity_mul hπ, hzero _ heM, hzero _ heP, e1]
  obtain ⟨u, hu⟩ := s1 _ _ hA hB hval
  refine ⟨u⁻¹, ?_⟩
  simp only [one_pow, mul_one]
  rw [mul_assoc (↑u⁻¹ : R), ← hu, mul_comm (↑u⁻¹ : R), Units.mul_inv_cancel_right]

theorem wcpa_dj_sp_snc_pullback_iff : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y) (m : ℕ) (Dc : Fin m → Set S) (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (a : {i : Fin m // g y ∈ Dc i} → Fin n), (∀ i, IsClosed (Dc i)) → (∀ (i : {i : Fin m // g y ∈ Dc i}) (p' : S) (h : p' ⤳ g y), (p' ∈ Dc i.1 ↔ (S.presheaf.stalkSpecializes h).hom (t (a i)) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p'))) → ∀ (z' : Y) (hz : z' ⤳ y), (g z' ∈ ⋃ i, Dc i ↔ ∃ i : {i : Fin m // g y ∈ Dc i}, (Y.presheaf.stalkSpecializes hz).hom ((g.stalkMap y).hom (t (a i))) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z')) :=
by
  intro S Y g y m Dc n t a hDc hiff z' hz
  have hp : g z' ⤳ g y := hz.map g.continuous
  have loc : ∀ x : S.presheaf.stalk (g y),
      (Y.presheaf.stalkSpecializes hz).hom ((g.stalkMap y).hom x) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z') ↔
        (S.presheaf.stalkSpecializes hp).hom x ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk (g z')) := by
    intro x
    have key := Scheme.Hom.stalkSpecializes_stalkMap_apply g z' y hz x
    rw [← key, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, map_mem_nonunits_iff]
  constructor
  · intro h
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp h
    have hgy : g y ∈ Dc i := hp.mem_closed (hDc i) hi
    exact ⟨⟨i, hgy⟩, (loc _).mpr ((hiff ⟨i, hgy⟩ (g z') hp).mp hi)⟩
  · rintro ⟨i, hi⟩
    exact Set.mem_iUnion.mpr ⟨i.1, (hiff i (g z') hp).mpr ((loc _).mp hi)⟩

theorem wcpa_dj_stc_kms_ratio_unit : ∀ (k : Type u) [Field k] {Y : Scheme.{u}} (O : Y.Opens) {N : ℕ}
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) (i₀ i : Fin (N + 1)) (w : Y) (hw : w ∈ O),
    a ⟨w, hw⟩ ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra (MvPolynomial.X i₀) →
    a ⟨w, hw⟩ ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra (MvPolynomial.X i) →
    ∃ hV : w ∈ O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀)),
    IsUnit ((Y.presheaf.germ _ w hV).hom (wcpaDjStcRatioSec k O a i₀ i)) :=
by
  have tA : ∀ {Y X : Scheme.{u}} (O : Y.Opens) (a : O.toScheme ⟶ X) (D : X.Opens)
      (s : Γ(X, D)) (w : Y) (hw : w ∈ O), a ⟨w, hw⟩ ∈ X.basicOpen s →
      ∃ hV : w ∈ O.ι ''ᵁ (a ⁻¹ᵁ D),
        IsUnit ((Y.presheaf.germ _ w hV).hom
          ((O.ι.appIso (a ⁻¹ᵁ D)).inv.hom ((a.app D).hom s))) := by
    intro Y X O a D s w hw h
    have hx : (⟨w, hw⟩ : O.toScheme) ∈ O.toScheme.basicOpen ((a.app D).hom s) := by
      rw [← Scheme.preimage_basicOpen]
      exact h
    have hxD : (⟨w, hw⟩ : O.toScheme) ∈ a ⁻¹ᵁ D := Scheme.basicOpen_le _ _ hx
    have himg : w ∈ O.ι ''ᵁ (O.toScheme.basicOpen ((a.app D).hom s)) := by
      rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
      exact ⟨⟨w, hw⟩, hx, rfl⟩
    have hV : w ∈ O.ι ''ᵁ (a ⁻¹ᵁ D) := by
      rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
      exact ⟨⟨w, hw⟩, hxD, rfl⟩
    refine ⟨hV, ?_⟩
    rw [Scheme.image_basicOpen] at himg
    exact (Scheme.mem_basicOpen _ _ _ hV).mp himg
  have tB : ∀ (k : Type u) [Field k] {N : ℕ} (i₀ i : Fin (N + 1))
      (P : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra),
      P ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i₀) →
      P ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i) →
      P ∈ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra).basicOpen
        ((@Proj.awayToSection _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
          (MvPolynomial.X i₀)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra _ _
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i₀)) 1
            (MvPolynomial.X i)
            (by rw [smul_eq_mul, mul_one]
                exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                  (MvPolynomial.isHomogeneous_X k i)))) := by
    intro k _ N i₀ i P h0 h1
    let _ : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    have hx0 : (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i₀)
    have hx1 : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)
    have hPf : P ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        (MvPolynomial.X i₀ * MvPolynomial.X i) := by
      rw [Proj.basicOpen_mul]; exact ⟨h0, h1⟩
    have hle : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        (MvPolynomial.X i₀ * MvPolynomial.X i) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (MvPolynomial.X i₀) := by
      rw [Proj.basicOpen_mul]; exact inf_le_left
    have key := Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      hx1 (f := MvPolynomial.X i₀) (x := MvPolynomial.X i₀ * MvPolynomial.X i) rfl
    have hunit : ∀ (hf : MvPolynomial.X i₀ * MvPolynomial.X i ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 2)
        (ha : MvPolynomial.X i * MvPolynomial.X i ^ 1 ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k (1 • 2)),
        IsUnit (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hf 1
          (MvPolynomial.X i * MvPolynomial.X i ^ 1) ha) := by
      intro hf ha
      have hv : MvPolynomial.X i₀ * MvPolynomial.X i₀ ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k (1 • 2) := by
        rw [smul_eq_mul, one_mul]
        exact SetLike.mul_mem_graded hx0 hx0
      refine IsUnit.of_mul_eq_one (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hf 1
          (MvPolynomial.X i₀ * MvPolynomial.X i₀) hv) ?_
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
        Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul, mul_one, pow_one]
      ring
    rw [Scheme.mem_basicOpen _ _ _ h0]
    rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE hle) P hPf]
    have key' := congrArg (fun φ => φ.hom (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra _ _
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
              (MvPolynomial.isHomogeneous_X k i₀)) 1
            (MvPolynomial.X i)
            (by rw [smul_eq_mul, mul_one]
                exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                  (MvPolynomial.isHomogeneous_X k i)))) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at key'
    erw [← key']
    refine (IsUnit.map _ (IsUnit.map _ ?_))
    rw [HomogeneousLocalization.awayMap_mk]
    exact hunit _ _
  intro k _ Y O N a i₀ i w hw h0 h1
  exact tA O a _ _ w hw (tB k i₀ i (a ⟨w, hw⟩) h0 h1)

theorem wcpa_dj_stc_kmo_prime_off_boundary : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjStcKmHyp k S Y sS g m τ W mD Dc N I O a →
    ∀ i₀ ∈ I, ∀ i ∈ I, ∀ y : Y, y ∉ ⋃ j, Set.range ⇑(τ j) →
    ∀ (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (e : {i // g y ∈ Dc i} → Fin n)
      (J : Finset (Fin n)),
      wcpaDjStcSNCSys S mD Dc (g y) n t e → (∀ l, l ∈ J ↔ ∃ i, e i = l) →
      ∀ num den : Y.presheaf.stalk y,
        wcpaDjStcRatioLink (wcpaDjStcRatioSec k O a i₀ i) y num den →
        ∀ π : Y.presheaf.stalk y, Prime π → (∀ l ∈ J, ¬ π ∣ (g.stalkMap y).hom (t l)) →
          ∃ a' b' : Y.presheaf.stalk y, ¬ π ∣ a' ∧ ¬ π ∣ b' ∧ a' * num = b' * den :=
by
  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a H i₀ hi₀ i hi y hy n t e J hsys hJ num den
    hlink π hπ hπJ
  classical
  obtain ⟨-, -, hss, -, hsec, -, -, -, -, hcomps, H11, H12, -, -, H15⟩ := H
  obtain ⟨-, hProp, -⟩ := hss
  obtain ⟨hτg, -, -⟩ := hsec
  have hDcl : ∀ i, IsClosed (Dc i) := hcomps.1
  obtain ⟨-, -, -, hiff⟩ := hsys
  haveI : IsProper g := hProp

  have hπ0 : π ≠ 0 := hπ.ne_zero
  have hq : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ0).mpr hπ
  let q : PrimeSpectrum (Y.presheaf.stalk y) := ⟨Ideal.span {π}, hq⟩
  obtain ⟨hsp, hgen⟩ := wcpa_dj_mn_generization Y y q
  have hgen' : ∀ b, (Y.presheaf.stalkSpecializes hsp).hom b ∈
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (Y.fromSpecStalk y q)) ↔ π ∣ b :=
    fun b => (hgen b).trans Ideal.mem_span_singleton

  have hτcl : ∀ j, IsClosed (Set.range ⇑(τ j)) := fun j =>
    (wcpa_dj_sp_section_stalk S Y g (τ j) (g y) inferInstance (hτg j)).1

  have hD : g (Y.fromSpecStalk y q) ∉ ⋃ i, Dc i := by
    intro hgz
    obtain ⟨i₁, hi₁⟩ := (wcpa_dj_sp_snc_pullback_iff S Y g y mD Dc n t e hDcl
      (fun i p' h => hiff i p' h) _ hsp).mp hgz
    exact hπJ (e i₁) ((hJ _).mpr ⟨i₁, rfl⟩) ((hgen' _).mp hi₁)
  have hT : Y.fromSpecStalk y q ∉ ⋃ j, Set.range ⇑(τ j) := by
    intro hwτ
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hwτ
    exact hy (Set.mem_iUnion.mpr ⟨j, hsp.mem_closed (hτcl j) hj⟩)

  have hgW : g (Y.fromSpecStalk y q) ∈ W := by
    by_contra hW
    exact hD (H11 hW)
  have hwO : Y.fromSpecStalk y q ∈ O := H12 (show Y.fromSpecStalk y q ∈ g ⁻¹ᵁ W from hgW)
  have hbas : ∀ j ∈ I, a ⟨Y.fromSpecStalk y q, hwO⟩ ∈ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X j) := by
    intro j hj
    by_contra hno
    rcases H15 ⟨Y.fromSpecStalk y q, hwO⟩ ⟨j, hj, hno⟩ with h | h
    · exact hT h
    · exact h hgW

  obtain ⟨hV, hunit⟩ := wcpa_dj_stc_kms_ratio_unit k O a i₀ i _ hwO (hbas i₀ hi₀) (hbas i hi)
  have heq := hlink.2 _ hV hsp

  letI : Algebra (Y.presheaf.stalk y) (Y.presheaf.stalk (Y.fromSpecStalk y q)) :=
    (Y.presheaf.stalkSpecializes hsp).hom.toAlgebra
  haveI hloc := wc_ldp_nc_stalkSpecializes_isLocalization Y (Y.fromSpecStalk y q) y hsp
  set P := (IsLocalRing.maximalIdeal (Y.presheaf.stalk (Y.fromSpecStalk y q))).comap
    (Y.presheaf.stalkSpecializes hsp).hom with hP
  have hPmem : ∀ x, x ∈ P ↔ π ∣ x := fun x => by
    rw [hP, Ideal.mem_comap]
    exact hgen' x
  set u := (Y.presheaf.germ _ (Y.fromSpecStalk y q) hV).hom (wcpaDjStcRatioSec k O a i₀ i)
    with hu
  have heq' : u * algebraMap (Y.presheaf.stalk y) (Y.presheaf.stalk (Y.fromSpecStalk y q)) den =
      algebraMap (Y.presheaf.stalk y) (Y.presheaf.stalk (Y.fromSpecStalk y q)) num := heq
  obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.mk'_surjective P.primeCompl u
  simp only at hcs
  have hc : c ∈ P.primeCompl := by
    rw [← IsLocalization.AtPrime.isUnit_mk'_iff (Y.presheaf.stalk (Y.fromSpecStalk y q)) P c s,
      hcs]
    exact hunit
  have hspec := IsLocalization.mk'_spec (Y.presheaf.stalk (Y.fromSpecStalk y q)) c s
  rw [hcs] at hspec
  have halg : algebraMap (Y.presheaf.stalk y) (Y.presheaf.stalk (Y.fromSpecStalk y q)) (c * den) =
      algebraMap (Y.presheaf.stalk y) (Y.presheaf.stalk (Y.fromSpecStalk y q)) (s * num) := by
    rw [map_mul, map_mul, ← hspec, ← heq']
    ring
  obtain ⟨x, hx⟩ := (IsLocalization.eq_iff_exists P.primeCompl
    (Y.presheaf.stalk (Y.fromSpecStalk y q))).mp halg
  have hxs : (x : Y.presheaf.stalk y) * s ∈ P.primeCompl := P.primeCompl.mul_mem x.2 s.2
  have hxc : (x : Y.presheaf.stalk y) * c ∈ P.primeCompl := P.primeCompl.mul_mem x.2 hc
  refine ⟨x * s, x * c, fun h => hxs ((hPmem _).mpr h), fun h => hxc ((hPmem _).mpr h), ?_⟩
  linear_combination -hx

theorem wcpa_dj_stc_kmo_exponent_bound : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjStcKmHyp k S Y sS g m τ W mD Dc N I O a →
    ∃ B₁ : ℕ, ∀ i₀ ∈ I, ∀ i ∈ I, ∀ (y : Y) (j : Fin mD) (τ₀ : S.presheaf.stalk (g y)),
      IsDomain (Y.presheaf.stalk y) → UniqueFactorizationMonoid (Y.presheaf.stalk y) →
      Prime ((g.stalkMap y).hom τ₀) →
      (∀ (p' : S) (h : p' ⤳ g y), p' ∈ Dc j ↔
        (S.presheaf.stalkSpecializes h).hom τ₀ ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
      ∀ num den : Y.presheaf.stalk y, num ≠ 0 → den ≠ 0 →
        wcpaDjStcRatioLink (wcpaDjStcRatioSec k O a i₀ i) y num den →
        |(multiplicity ((g.stalkMap y).hom τ₀) num : ℤ) -
          (multiplicity ((g.stalkMap y).hom τ₀) den : ℤ)| ≤ (B₁ : ℤ) :=
by
  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a hH
  classical
  have hC1 : ∀ (k : Type u) [Field k] (Y : Scheme.{u}) (s : Y ⟶ Spec (.of k)), IsProper s →
      TopologicalSpace.NoetherianSpace Y ∧ ∀ y : Y, IsNoetherianRing (Y.presheaf.stalk y) := by
    intro k _ Y s hs
    haveI := hs
    haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian s
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace s
    haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
    exact ⟨inferInstance, fun y => inferInstance⟩
  have hC2 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] [QuasiSober X]
      (Z : Set X), IsClosed Z → {w : X | w ∈ Z ∧ ∀ w' : X, w' ⤳ w → w' ∈ Z → w' = w}.Finite := by
    intro X _ _ _ Z hZ
    obtain ⟨𝒮, hSf, hScl, hSirr, hZS⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
    refine (hSf.biUnion' (t := fun T hT => ({(hSirr T hT).genericPoint} : Set X))
      (fun T hT => Set.finite_singleton _)).subset ?_
    rintro w ⟨hwZ, hmax⟩
    have hw' := hwZ
    rw [hZS] at hw'
    obtain ⟨T, hT, hwT⟩ := Set.mem_sUnion.mp hw'
    have hgen := (hSirr T hT).isGenericPoint_genericPoint (hScl T hT)
    have h1 : (hSirr T hT).genericPoint ⤳ w := hgen.specializes hwT
    have h2 : (hSirr T hT).genericPoint ∈ Z := by
      rw [hZS]; exact Set.mem_sUnion_of_mem hgen.mem hT
    have h3 := hmax _ h1 h2
    exact Set.mem_iUnion₂.mpr ⟨T, hT, Set.mem_singleton_iff.mpr h3.symm⟩
  have hC3 : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y) (Z : Set S) (τ₀ : S.presheaf.stalk (g y)),
      Prime ((g.stalkMap y).hom τ₀) →
      (∀ (p' : S) (h : p' ⤳ g y), p' ∈ Z ↔
        (S.presheaf.stalkSpecializes h).hom τ₀ ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
      ∃ (w : Y) (hsp : w ⤳ y),
        (∀ b : Y.presheaf.stalk y, (Y.presheaf.stalkSpecializes hsp).hom b ∈
            IsLocalRing.maximalIdeal (Y.presheaf.stalk w) ↔ (g.stalkMap y).hom τ₀ ∣ b) ∧
        g w ∈ Z ∧ ∀ w' : Y, w' ⤳ w → g w' ∈ Z → w' = w := by
    intro S Y g y Z τ₀ hP hiff
    have hgen := wcpa_dj_mn_generization
    set s := (g.stalkMap y).hom τ₀ with hs_def
    let q : PrimeSpectrum (Y.presheaf.stalk y) :=
      ⟨Ideal.span {s}, (Ideal.span_singleton_prime hP.ne_zero).mpr hP⟩
    obtain ⟨hsp, hq⟩ := hgen Y y q
    refine ⟨Y.fromSpecStalk y q, hsp, fun b => (hq b).trans Ideal.mem_span_singleton, ?_, ?_⟩
    · have hgsp : g (Y.fromSpecStalk y q) ⤳ g y := hsp.map g.continuous
      apply (hiff _ hgsp).mpr
      by_contra hnot
      have hu : IsUnit ((S.presheaf.stalkSpecializes hgsp).hom τ₀) :=
        IsLocalRing.notMem_maximalIdeal.mp hnot
      have hu2 := hu.map (g.stalkMap (Y.fromSpecStalk y q)).hom
      rw [Scheme.Hom.stalkSpecializes_stalkMap_apply g (Y.fromSpecStalk y q) y hsp τ₀] at hu2
      have hm : (Y.presheaf.stalkSpecializes hsp).hom s ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk (Y.fromSpecStalk y q)) :=
        (hq s).mpr (Ideal.mem_span_singleton_self s)
      exact (IsLocalRing.mem_maximalIdeal _).mp hm hu2
    · intro w' hw' hgw'
      have hw'y : w' ⤳ y := hw'.trans hsp
      have hmem : w' ∈ Set.range (Y.fromSpecStalk y) := by
        rw [Scheme.range_fromSpecStalk]; exact hw'y
      obtain ⟨q', rfl⟩ := hmem
      obtain ⟨hsp', hq'⟩ := hgen Y y q'
      have hm := (hiff _ (hsp'.map g.continuous)).mp hgw'
      have hm2 := map_nonunit (g.stalkMap (Y.fromSpecStalk y q')).hom _ hm
      rw [Scheme.Hom.stalkSpecializes_stalkMap_apply g (Y.fromSpecStalk y q') y hsp' τ₀] at hm2
      have hsq' : s ∈ q'.asIdeal := (hq' s).mp hm2
      have hle1 : q.asIdeal ≤ q'.asIdeal := (Ideal.span_singleton_le_iff_mem _).mpr hsq'
      have hspq : q' ⤳ q :=
        ((Y.fromSpecStalk y).isEmbedding.toIsInducing.specializes_iff).mp hw'
      have hle2 : q'.asIdeal ≤ q.asIdeal := (PrimeSpectrum.le_iff_specializes q' q).mpr hspq
      have : q' = q := PrimeSpectrum.ext (le_antisymm hle2 hle1)
      rw [this]
  have hC4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]
      (T : Type u) [CommRing T] [IsLocalRing T] [Algebra R T] (s : R), Prime s →
      ∀ (P : Ideal R) [P.IsPrime] [IsLocalization.AtPrime T P], (∀ x : R, x ∈ P ↔ s ∣ x) →
      ∀ (num den : R) (num' den' : T) (B : ℕ), num ≠ 0 → den ≠ 0 →
        algebraMap R T num * den' = algebraMap R T den * num' →
        num' ∉ IsLocalRing.maximalIdeal T ^ (B + 1) → den' ∉ IsLocalRing.maximalIdeal T ^ (B + 1) →
        |(multiplicity s num : ℤ) - (multiplicity s den : ℤ)| ≤ (B : ℤ) := by
    intro R _ _ _ T _ _ _ s hs P _ _ hP num den num' den' B hnum hden heq hn' hd'
    have hle : P.primeCompl ≤ nonZeroDivisors R := fun x hx =>
      mem_nonZeroDivisors_of_ne_zero (fun h0 => hx (h0 ▸ P.zero_mem))
    have hinj : Function.Injective (algebraMap R T) := IsLocalization.injective T hle
    have hfin : ∀ x : R, x ≠ 0 → ∃ c : ℕ, ∃ v : R, x = s ^ c * v ∧ ¬ s ∣ v := by
      intro x hx
      obtain ⟨v, hv, hnd⟩ := (FiniteMultiplicity.of_not_isUnit hs.not_isUnit hx).exists_eq_pow_mul_and_not_dvd
      exact ⟨_, v, hv, hnd⟩
    have hsm : algebraMap R T s ∈ IsLocalRing.maximalIdeal T := by
      rw [IsLocalization.AtPrime.to_map_mem_maximal_iff T P]
      exact (hP s).mpr dvd_rfl

    have hnf : ∀ x : T, x ∉ IsLocalRing.maximalIdeal T ^ (B + 1) →
        ∃ (r t : R), ¬ s ∣ t ∧ x * algebraMap R T t = algebraMap R T r ∧ ∃ c : ℕ, ∃ v : R,
          r = s ^ c * v ∧ ¬ s ∣ v ∧ c ≤ B := by
      intro x hx
      obtain ⟨⟨r, t⟩, hrt⟩ := IsLocalization.surj P.primeCompl x
      have ht : ¬ s ∣ (t : R) := fun h => t.2 ((hP _).mpr h)
      obtain ⟨ut, hut⟩ := IsLocalization.map_units T t
      have hx' : x = algebraMap R T r * ↑ut⁻¹ := by
        rw [Units.eq_mul_inv_iff_mul_eq, hut]; exact hrt
      have hr0 : r ≠ 0 := by
        intro h0
        apply hx
        rw [hx', h0, map_zero, zero_mul]
        exact Ideal.zero_mem _
      obtain ⟨c, v, hrv, hv⟩ := hfin r hr0
      refine ⟨r, t, ht, hrt, c, v, hrv, hv, ?_⟩
      by_contra hc
      push_neg at hc
      apply hx
      rw [hx', hrv, map_mul, map_pow, mul_assoc]
      apply Ideal.mul_mem_right
      exact Ideal.pow_le_pow_right hc (Ideal.pow_mem_pow hsm c)
    obtain ⟨r1, t1, ht1, hrt1, c, v1, hr1, hv1, hc⟩ := hnf num' hn'
    obtain ⟨r2, t2, ht2, hrt2, d, v2, hr2, hv2, hd⟩ := hnf den' hd'
    obtain ⟨u, hu, hnu⟩ := (FiniteMultiplicity.of_not_isUnit hs.not_isUnit hnum).exists_eq_pow_mul_and_not_dvd
    obtain ⟨u', hu', hnu'⟩ := (FiniteMultiplicity.of_not_isUnit hs.not_isUnit hden).exists_eq_pow_mul_and_not_dvd
    set A := multiplicity s num
    set Bm := multiplicity s den

    have hR : num * r2 * t1 = den * r1 * t2 := by
      apply hinj
      have e1 : algebraMap R T (num * r2 * t1) =
          (algebraMap R T num * den') * (algebraMap R T t2 * algebraMap R T t1) := by
        rw [map_mul, map_mul, ← hrt2]; ring
      have e2 : algebraMap R T (den * r1 * t2) =
          (algebraMap R T den * num') * (algebraMap R T t2 * algebraMap R T t1) := by
        rw [map_mul, map_mul, ← hrt1]; ring
      rw [e1, e2, heq]
    have hX : ¬ s ∣ u * v2 * t1 := by
      intro h
      rcases hs.dvd_or_dvd h with h | h
      · rcases hs.dvd_or_dvd h with h | h
        · exact hnu h
        · exact hv2 h
      · exact ht1 h
    have hX' : ¬ s ∣ u' * v1 * t2 := by
      intro h
      rcases hs.dvd_or_dvd h with h | h
      · rcases hs.dvd_or_dvd h with h | h
        · exact hnu' h
        · exact hv1 h
      · exact ht2 h
    have hE : s ^ (A + d) * (u * v2 * t1) = s ^ (Bm + c) * (u' * v1 * t2) := by
      have : num * r2 * t1 = s ^ (A + d) * (u * v2 * t1) := by rw [hu, hr2, pow_add]; ring
      have h' : den * r1 * t2 = s ^ (Bm + c) * (u' * v1 * t2) := by rw [hu', hr1, pow_add]; ring
      rw [← this, ← h', hR]
    have hs0 : s ≠ 0 := hs.ne_zero
    have key : ∀ (m n : ℕ) (X X' : R), ¬ s ∣ X → m < n → s ^ m * X ≠ s ^ n * X' := by
      intro m n X X' hXd hmn h
      apply hXd
      have h2 : s ^ m * X = s ^ m * (s ^ (n - m) * X') := by
        rw [h, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hmn.le]
