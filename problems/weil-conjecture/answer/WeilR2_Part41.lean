      (∀ i, sw i ≫ πw = 𝟙 _) ∧ (∀ i, sw i ≫ χw = (W.ι ≫ d ≫ β₀) ≫ σ i) ∧
      (∀ i, sw i ≫ ψw = W.ι ≫ τ i) :=
by
  intro k _ _ X P _ _ sP f U n σ hin L _ _ S₀ _ sS₀ β₀ ε hβ₀ hS₀ hβ₀p hgen hloc
  have hn : 3 ≤ n := hin.2.2.2.2.2.1

