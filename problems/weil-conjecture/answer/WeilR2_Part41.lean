by
  classical
  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a hH
  obtain ⟨hS, hY, hss, _hmono, hsec, _hW, _hWsm, _hWgc, hreg, hcomps, hWD, hO, _hstr, _hC1,
    hC2⟩ := hH
  obtain ⟨hflat, hprop, _⟩ := hss
  obtain ⟨hτg, hdisj, hτsm⟩ := hsec
  haveI : IsProper g := hprop
  haveI hsep : IsSeparated g := inferInstance

  haveI hgsP : IsProper (g ≫ sS) := wcpa_dj_proj_proper k (g ≫ sS) hY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sS)
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (g ≫ sS)
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk

  obtain ⟨hp₀, -⟩ := wcpa_dj_bk_local_equations k S sS mD Dc hS hreg hcomps
  obtain ⟨hBdcl, hη, hoff⟩ := wcpa_dj_stc_kms_boundary_basic k S Y g m τ W mD Dc N I O a hflat
    hprop hτg hdisj hτsm hcomps.1 hp₀ hWD hO hC2
  obtain ⟨F, hF⟩ := wcpa_dj_stc_kms_dvr_points_finite Y _ hBdcl hη

  let f : Fin (N + 1) × Fin (N + 1) → Y.functionField := fun p =>
    if h : genericPoint Y ∈ O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
        (MvPolynomial.X p.1)) then
      (Y.presheaf.germ _ (genericPoint Y) h).hom (wcpaDjStcRatioSec k O a p.1 p.2)
    else 0
  obtain ⟨B, hB⟩ := wcpa_dj_stc_kms_ord_bound Y F (I ×ˢ I) f
  refine ⟨B, ?_⟩
  intro i₀ hi₀ y hy n t e J hsys hJ
  obtain ⟨j, hyj⟩ := Set.mem_iUnion.mp hy
  obtain ⟨p₀, rfl⟩ := hyj
  obtain ⟨hn, hspan, _heinj, hiff⟩ := hsys
  haveI hRreg := hreg (g (τ j p₀))
  obtain ⟨hregY, ψ, z, hψ, hker, hspanY, hdimY, hzIff⟩ :=
    wcpa_dj_stc_kms_section_local S Y g (τ j) p₀ n t hsep (hτg j) (hτsm j p₀) inferInstance hn
      hspan
  obtain ⟨hDS, hDY⟩ := wcpa_dj_stc_kms_boundary_iff S Y g m τ mD Dc j p₀ n t e J z hsep hτg
    hcomps.1 hdisj hiff hJ hzIff
  haveI := hregY
  obtain ⟨hdom, hufd⟩ := wc_fco_regular_local_ufd (Y.presheaf.stalk (τ j p₀))
  haveI := hdom
  haveI := hufd
  obtain ⟨-, hprime, hndvd⟩ := wcpa_dj_bko_regular_params (Y.presheaf.stalk (τ j p₀)) (n + 1)
    (Fin.append (fun l => (g.stalkMap (τ j p₀)).hom (t l)) ![z]) hdimY hspanY
  have hz : Prime z := by
    have h := hprime (Fin.natAdd n 0)
    rwa [Fin.append_right, Matrix.cons_val_zero] at h
  have hs : ∀ l, Prime ((g.stalkMap (τ j p₀)).hom (t l)) := fun l => by
    have h := hprime (Fin.castAdd 1 l)
    rwa [Fin.append_left] at h
  have hzs : ∀ l, ¬ Associated z ((g.stalkMap (τ j p₀)).hom (t l)) := by
    intro l hA
    refine hndvd (Fin.natAdd n 0) (Fin.castAdd 1 l) ?_ ?_
    · intro h
      have h' := congrArg Fin.val h
      have := l.isLt
      simp at h' <;> omega
    · rw [Fin.append_right, Fin.append_left, Matrix.cons_val_zero]
      exact hA.dvd
  have hss' : ∀ l l', l ≠ l' → ¬ Associated ((g.stalkMap (τ j p₀)).hom (t l))
      ((g.stalkMap (τ j p₀)).hom (t l')) := by
    intro l l' hne hA
    refine hndvd (Fin.castAdd 1 l) (Fin.castAdd 1 l') ?_ ?_
    · intro h
      apply hne
      exact Fin.ext (by simpa using congrArg Fin.val h)
    · rw [Fin.append_left, Fin.append_left]
      exact hA.dvd
  obtain ⟨c, hc1, hc2, hc3, hc4, hc5, hc6, hc7⟩ :=
    wcpa_dj_stc_kms_coeff_maps _ _ (g.stalkMap (τ j p₀)).hom ψ z hψ hker hz.ne_zero
  obtain ⟨ε, hεC, hεX⟩ := wcpa_dj_stc_kms_completion_iso _ _ (g.stalkMap (τ j p₀)).hom ψ z c hψ
    hker hc1 hc2 hc3 hc4 hc5 hc6 hc7

  have key : ∀ i ∈ I, ∃ (α : ℤ) (β : Fin n → ℤ) (num den : Y.presheaf.stalk (τ j p₀)),
      |α| ≤ (B : ℤ) ∧ (∀ l, |β l| ≤ (B : ℤ)) ∧ (∀ l, β l ≠ 0 → l ∈ J) ∧
      wcpaDjStcRatioLink (wcpaDjStcRatioSec k O a i₀ i) (τ j p₀) num den ∧
      ∃ w : (Y.presheaf.stalk (τ j p₀))ˣ,
        num * z ^ (-α).toNat * ∏ l, (g.stalkMap (τ j p₀)).hom (t l) ^ (-(β l)).toNat =
          ↑w * den * z ^ α.toNat * ∏ l, (g.stalkMap (τ j p₀)).hom (t l) ^ (β l).toNat := by
    intro i hi
    obtain ⟨hηO, hηI⟩ := hoff _ hη
    obtain ⟨hηV, hηunit⟩ :=
      wcpa_dj_stc_kms_ratio_unit k O a i₀ i _ hηO (hηI i₀ hi₀) (hηI i hi)
    obtain ⟨num, den, hlink, hden0, hnum0'⟩ :=
      wcpa_dj_stc_kmn_ratio_link Y _ (wcpaDjStcRatioSec k O a i₀ i) (τ j p₀) hηV
    have hnum0 : num ≠ 0 := hnum0' hηunit.ne_zero
    have hcop : ∀ π : Y.presheaf.stalk (τ j p₀), Prime π → ¬ Associated π z →
