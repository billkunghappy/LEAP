              Limits.pullback.fst g (ι ≫ g)
          = (Spec.map (CommRingCat.ofHom χ) ≫ Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight : Γ(wcpaLqY g ι, Ω) →ₐ[Γ(S, V)]
                TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω)).toRingHom)) ≫ hΩ.fromSpec ≫
