theorem wcpa_dj_mm_graph_closure : ∀ (k : Type u) [Field k] (P M U₁ : Scheme.{u})
    [AlgebraicGeometry.IsIntegral P] [AlgebraicGeometry.IsIntegral U₁] (sP : P ⟶ Spec (.of k))
    (sM : M ⟶ Spec (.of k)) (U₀ : P.Opens) (e : U₁ ⟶ U₀.toScheme) (φ : U₁ ⟶ M),
    wcpaDjIsProjOver k sP → wcpaDjIsProjOver k sM → U₀ ≠ ⊥ → IsFinite e → Surjective e →
    φ ≫ sM = e ≫ U₀.ι ≫ sP →
