          hW.fromSpec ≫ u := by
        have := IsAffineOpen.SpecMap_appLE_fromSpec u hU hW e
        exact this
      have e₂ : Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec =
          𝟙 _ ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec) :=
        (Category.id_comp _).symm
      haveI := Scheme.pullback_map_isOpenImmersion
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) Γ(Z, W))))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L))) u
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec)
        hW.fromSpec (𝟙 _) hU.fromSpec e₁ e₂
      haveI : AlgebraicGeometry.IsReduced (Limits.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) Γ(Z, W))))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)))) :=
        isReduced_of_isOpenImmersion (Limits.pullback.map _ _ _ _ _ _ _ e₁ e₂)
      haveI : AlgebraicGeometry.IsReduced
          (Spec (CommRingCat.of (TensorProduct Γ(T, U) Γ(Z, W) L))) :=
        isReduced_of_isOpenImmersion (pullbackSpecIso Γ(T, U) Γ(Z, W) L).inv
      exact (affine_isReduced_iff (CommRingCat.of (TensorProduct Γ(T, U) Γ(Z, W) L))).mp
        inferInstance
    letI := (u.appLE U W e).hom.toAlgebra
    have hflat : Module.Flat Γ(T, U) Γ(Z, W) :=
      HasRingHomProperty.appLE @Flat u ‹Flat u› ⟨U, hU⟩ ⟨W, hW⟩ e
    let κ := P.ResidueField
    let L := AlgebraicClosure κ
    have h1 := hgeo L (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec)
    haveI h2 := patch L h1
    let g : κ →ₐ[Γ(T, U)] L := IsScalarTower.toAlgHom Γ(T, U) κ L
    have hg : Function.Injective g := (algebraMap κ L).injective
    have hinj : Function.Injective (LinearMap.lTensor Γ(Z, W) g.toLinearMap) :=
      Module.Flat.lTensor_preserves_injective_linearMap g.toLinearMap hg
    let φ := Algebra.TensorProduct.map (AlgHom.id Γ(T, U) Γ(Z, W)) g
    have hφ : ⇑φ = ⇑(LinearMap.lTensor Γ(Z, W) g.toLinearMap) := by
      funext x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul b k => simp [φ]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have hφi : Function.Injective φ := by rw [hφ]; exact hinj
    exact isReduced_of_injective φ.toRingHom hφi

  haveI := hsT
  haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian sT
  obtain ⟨hZred, hdense⟩ := wcpa_dj_lgs_reduced_dense k T sT hsT Z u hss
  haveI := hZred
  haveI hav : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hv
  have hja : j ≫ (ι ≫ Limits.pullback.fst u u') = a := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_fst]
  have hra : ∀ z : Z, u z ∈ Set.range v → z ∈ Set.range a := by
    intro z hz
    have hz' : z ∈ Set.range (Limits.pullback.fst u v) := by
      rw [Scheme.Pullback.range_fst]; exact hz
    obtain ⟨w, rfl⟩ := hz'
    refine ⟨hpb.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst]
  obtain ⟨x0⟩ := hV
  have hvne : v.opensRange ≠ ⊥ :=
    (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨v x0, x0, rfl⟩
  have hdr : Dense (Set.range ⇑(ι ≫ Limits.pullback.fst u u')) := by
    refine (hdense _ hvne).mono ?_
    intro z hz
    obtain ⟨y, rfl⟩ := hra z hz
    exact ⟨j y, by rw [← Scheme.Hom.comp_apply, hja]⟩
  haveI : IsFinite (ι ≫ Limits.pullback.fst u u') := hfin
  haveI : IsAffineHom (ι ≫ Limits.pullback.fst u u') := inferInstance

  refine s1 G Z _ hfin (fun z => ?_)
  obtain ⟨U, hU, huz, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    T.isBasis_affineOpens) (show u z ∈ (⊤ : T.Opens) from trivial)
  obtain ⟨W, hW, hz, hWle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    Z.isBasis_affineOpens) (show z ∈ u ⁻¹ᵁ U from huz)
  refine ⟨W, hz, hW, ?_⟩
  haveI hUne : Nonempty U := ⟨⟨u z, huz⟩⟩
  haveI : IsDomain Γ(T, U) := IsIntegral.component_integral U
  haveI : IsNoetherianRing Γ(T, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI : IsIntegrallyClosed Γ(T, U) := s7 U hU hUne
  letI := (u.appLE U W hWle).hom.toAlgebra
  haveI : Module.Flat Γ(T, U) Γ(Z, W) :=
    HasRingHomProperty.appLE @Flat u ‹Flat u› ⟨U, hU⟩ ⟨W, hW⟩ hWle
  have hfib := s8 U W hU hW hWle
  obtain ⟨x, hxv, hxU⟩ : (Set.range v ∩ (U : Set T)).Nonempty :=
    nonempty_preirreducible_inter v.opensRange.isOpen U.isOpen ⟨v x0, x0, rfl⟩ ⟨u z, huz⟩
  obtain ⟨s, hsle, hxs⟩ := hU.exists_basicOpen_le (V := v.opensRange) ⟨x, hxv⟩ hxU
  have hs0 : s ≠ 0 := by
    rintro rfl
    rw [Scheme.basicOpen_zero] at hxs
    exact hxs
  have hsne : T.basicOpen s ≠ ⊥ :=
    (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxs⟩
  have hbo : Z.basicOpen ((u.appLE U W hWle).hom s) = W ⊓ u ⁻¹ᵁ T.basicOpen s :=
    Scheme.basicOpen_appLE u W U hWle s
  have hiso : IsIso ((ι ≫ Limits.pullback.fst u u') ∣_ Z.basicOpen ((u.appLE U W hWle).hom s)) := by
    refine s3 G Z Y _ j a hj hav hja hjr _ ?_
    intro z' hz'
    rw [hbo] at hz'
    apply hra
    exact hsle hz'.2
  have hgen := s4 G Z (ι ≫ Limits.pullback.fst u u') inferInstance W hW
    ((u.appLE U W hWle).hom s) hiso
  have hinj := s2 G Z (ι ≫ Limits.pullback.fst u u') hZred hdr W
  have hDd : Dense (⇑(ι ≫ Limits.pullback.fst u u') ⁻¹'
      ((u ⁻¹ᵁ T.basicOpen s : Z.Opens) : Set Z)) :=
    s6 G Y Z j _ a hjd hav hja _ (hdense _ hsne)
  have hnzd : ∀ c : Γ(G, (ι ≫ Limits.pullback.fst u u') ⁻¹ᵁ W),
      ((ι ≫ Limits.pullback.fst u u').app W).hom ((u.appLE U W hWle).hom s) * c = 0 → c = 0 := by
    intro c hc
    refine s5 G hGred _ _ c ?_ hc
    rw [← Scheme.preimage_basicOpen, hbo]
    have h1 := hDd.open_subset_closure_inter ((ι ≫ Limits.pullback.fst u u') ⁻¹ᵁ W).isOpen
    refine h1.trans (closure_mono ?_)
    rintro g ⟨hg1, hg2⟩
    exact ⟨hg1, hg2⟩
  exact s9 Γ(T, U) Γ(Z, W) Γ(G, (ι ≫ Limits.pullback.fst u u') ⁻¹ᵁ W)
    ((ι ≫ Limits.pullback.fst u u').app W).hom (fun P _ => hfib P)
    (IsFinite.finite_app _ W hW) hinj s hs0 hnzd hgen

theorem wcpa_dj_lgs_iso_extend : ∀ (k : Type u) [Field k] (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (sT : T ⟶ Spec (.of k)), LocallyOfFiniteType sT → (∀ x : T, IsIntegrallyClosed (T.presheaf.stalk x)) → ∀ (Z Z' : Scheme.{u}) (u : Z ⟶ T) (u' : Z' ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T ⟶ Z')), 3 ≤ n → wcpaDjStablePtd u n τ → wcpaDjStablePtd u' n τ' → GeometricallyConnected u → GeometricallyConnected u' → ∀ (V Y : Scheme.{u}) (v : V ⟶ T) (π : Y ⟶ V) (a : Y ⟶ Z) (a' : Y ⟶ Z'), IsOpenImmersion v → Nonempty V → IsPullback a π u v → IsPullback a' π u' v → (∀ i, ∃ t : V ⟶ Y, t ≫ π = 𝟙 V ∧ t ≫ a = v ≫ τ i ∧ t ≫ a' = v ≫ τ' i) → ∃ Φ : Z ⟶ Z', Φ ≫ u' = u ∧ a ≫ Φ = a' :=
by
  intro k _ T _ sT hsT hnorm Z Z' u u' n τ τ' hn hst hst' hgc hgc' V Y v π a a' hv hV hpb hpb'
    hsec
  have h : a ≫ u = a' ≫ u' := hpb.w.trans hpb'.w.symm
  haveI hup : IsProper u := hst.1.2.1
  haveI hup' : IsProper u' := hst'.1.2.1
  haveI := hsT
  haveI : LocallyOfFiniteType (u ≫ sT) := inferInstance
  haveI hZnoeth : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian (u ≫ sT)
  haveI hZred : AlgebraicGeometry.IsReduced Z :=
    (wcpa_dj_lgs_reduced_dense k T sT hsT Z u hst.1).1
  haveI hav : IsOpenImmersion a := MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hv
  haveI hYred : AlgebraicGeometry.IsReduced Y := isReduced_of_isOpenImmersion a
  obtain ⟨Γ, ι, j, hι, hΓred, hj, hjd, hjι, hjr⟩ :=
    wcpa_dj_lie_graph_closure T Z Z' V Y u u' v π a a' h hv inferInstance hZnoeth hYred hpb hpb'
  haveI := hι
  haveI hlqf : LocallyQuasiFinite (ι ≫ Limits.pullback.fst u u') :=
    wcpa_dj_lie_graph_quasifinite k T sT hsT hnorm Z Z' u u' n τ τ' hn hst hst' hgc hgc' V Y v π
      a a' hv hV hpb hpb' hsec h Γ ι j hι hΓred hj hjd hjι hjr
  haveI hfstp : IsProper (Limits.pullback.fst u u') :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback u u').flip hup'
  haveI hp₁p : IsProper (ι ≫ Limits.pullback.fst u u') := inferInstance
  have hfin : IsFinite (ι ≫ Limits.pullback.fst u u') :=
    IsFinite.of_isProper_of_locallyQuasiFinite _
  haveI hiso : IsIso (ι ≫ Limits.pullback.fst u u') :=
    wcpa_dj_lie_graph_finite_iso k T sT hsT hnorm Z Z' u u' n τ τ' hn hst hst' hgc hgc' V Y v π
      a a' hv hV hpb hpb' hsec h Γ ι j hι hΓred hj hjd hjι hjr hfin
  have hja : j ≫ (ι ≫ Limits.pullback.fst u u') = a := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_fst]
  refine ⟨inv (ι ≫ Limits.pullback.fst u u') ≫ ι ≫ Limits.pullback.snd u u', ?_, ?_⟩
  · simp only [Category.assoc]
    rw [← Limits.pullback.condition, ← Category.assoc ι, IsIso.inv_hom_id_assoc]
  · rw [← hja, Category.assoc j, IsIso.hom_inv_id_assoc, ← Category.assoc, hjι,
      Limits.pullback.lift_snd]

theorem wcpa_dj_lgs_stableptd_local : ∀ (Z S : Scheme.{u}) (u : Z ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ Z)) (r : ℕ) (O : Fin r → S.Opens), (⨆ j, O j) = ⊤ → ∀ (Zj : Fin r → Scheme.{u}) (a : ∀ j, Zj j ⟶ Z) (uj : ∀ j, Zj j ⟶ (O j).toScheme) (τj : ∀ j, Fin n → ((O j).toScheme ⟶ Zj j)), (∀ j, IsPullback (a j) (uj j) u (O j).ι) → (∀ j, wcpaDjStablePtd (uj j) n (τj j)) → (∀ j, GeometricallyConnected (uj j)) → (∀ j i, τj j i ≫ a j = (O j).ι ≫ τ i) → wcpaDjStablePtd u n τ ∧ GeometricallyConnected u :=
by
  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
    simpa [smul_eq_mul, Ideal.mul_top] using this
  have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
        AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
    intro A B _ _ _ _ σ
    let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
    have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        f n x = Ideal.Quotient.mk _ (σ a) := by
      intro n x a ha
      show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
        (AdicCompletion.evalₐ _ n x) = _
      rw [ha, Ideal.quotientMap_mk]
      rfl
    have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
        rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk]
    refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hf n x a ha
  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
    intro A B _ _ _ _ σ
    obtain ⟨Φ, hΦ⟩ := hmap A B σ
    obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
        RingHom.id_apply, hb]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
        RingHom.id_apply, hb]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
        AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
          Ideal.Quotient.mk _ r := by
      intro R _ I r
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
        RingHom.id_apply]
    show AdicCompletion.evalₐ _ n (Φ _) = _
    rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
  have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
      (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
        i.stalkMap x =
      (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    intro K _ X Y i p q hi x
    have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
        i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
    rw [← hi, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
  have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  intro Z S u n τ r O hO Zj a uj τj hpb hst hgc hτ
  have hao : ∀ j, IsOpenImmersion (a j) := fun j =>
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (hpb j).flip inferInstance

  have fac : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ S), ∃ (j : Fin r)
      (s' : Spec (.of K) ⟶ (O j).toScheme) (e : Limits.pullback u s ≅ Limits.pullback (uj j) s'),
      s' ≫ (O j).ι = s ∧ e.hom ≫ Limits.pullback.snd (uj j) s' = Limits.pullback.snd u s ∧
      e.hom ≫ Limits.pullback.fst (uj j) s' ≫ a j = Limits.pullback.fst u s := by
    intro K _ s
    have hmem : s (IsLocalRing.closedPoint K) ∈ ⨆ j, O j := by rw [hO]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
    have hr : Set.range s.base ⊆ Set.range (O j).ι.base := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, Subsingleton.elim x (IsLocalRing.closedPoint K)]
      exact hj
    obtain ⟨s', hs'⟩ : ∃ s' : Spec (.of K) ⟶ (O j).toScheme, s' ≫ (O j).ι = s :=
      ⟨IsOpenImmersion.lift (O j).ι s hr, IsOpenImmersion.lift_fac _ _ _⟩
    have H := (IsPullback.of_hasPullback (uj j) s').paste_horiz (hpb j)
    rw [hs'] at H
    refine ⟨j, s', H.isoPullback.symm, hs', ?_, ?_⟩
    · rw [Iso.symm_hom, Iso.inv_comp_eq, H.isoPullback_hom_snd]
    · rw [Iso.symm_hom, Iso.inv_comp_eq, H.isoPullback_hom_fst]

  have hres : ∀ j, ∃ e : Zj j ≅ (u ⁻¹ᵁ O j).toScheme, e.hom ≫ (u ∣_ O j) = uj j := fun j =>
    ⟨IsPullback.isoIsPullback _ _ (hpb j).flip (isPullback_morphismRestrict u (O j)),
      IsPullback.isoIsPullback_hom_fst _ _ _ _⟩
  have hflat : Flat u := by
    haveI : IsZariskiLocalAtTarget @Flat := HasRingHomProperty.instIsZariskiLocalAtTarget @Flat
    refine IsZariskiLocalAtTarget.of_iSup_eq_top O hO (fun j => ?_)
    obtain ⟨e, he⟩ := hres j
    haveI := (hst j).1.1
    have : u ∣_ O j = e.inv ≫ uj j := by rw [← he, Iso.inv_hom_id_assoc]
    rw [this]; infer_instance
  have hproper : IsProper u := by
    refine IsZariskiLocalAtTarget.of_iSup_eq_top O hO (fun j => ?_)
    obtain ⟨e, he⟩ := hres j
    haveI := (hst j).1.2.1
    have : u ∣_ O j = e.inv ≫ uj j := by rw [← he, Iso.inv_hom_id_assoc]
    rw [this]; infer_instance

  have hS1 : ∀ i, τ i ≫ u = 𝟙 S := by
    intro i
    refine (S.openCoverOfIsOpenCover O hO).hom_ext _ _ (fun j => ?_)
    show (O j).ι ≫ τ i ≫ u = (O j).ι ≫ 𝟙 S
    rw [← Category.assoc, ← hτ j i, Category.assoc, (hpb j).w, ← Category.assoc,
      (hst j).2.1.1 i, Category.id_comp, Category.comp_id]
  have hsec : wcpaDjSections u n τ := by
    refine ⟨hS1, fun i i' p q hii' heq => ?_, fun i p => ?_⟩
    · have hpq : p = q := by
        have h1 := congrArg (fun x => u x) heq
        simp only at h1
        rw [pt (hS1 i) p, pt (hS1 i') q] at h1
        exact h1
      rw [← hpq] at heq
      have hmem : p ∈ ⨆ j, O j := by rw [hO]; trivial
      obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
      obtain ⟨p', rfl⟩ : p ∈ Set.range (O j).ι.base := by rw [Scheme.Opens.range_ι]; exact hj
      haveI := hao j
      apply (hst j).2.1.2.1 i i' p' p' hii'
      apply (a j).isOpenEmbedding.injective
      rw [pt (hτ j i) p', pt (hτ j i') p', Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact heq
    · have hmem : p ∈ ⨆ j, O j := by rw [hO]; trivial
      obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
      obtain ⟨p', rfl⟩ : p ∈ Set.range (O j).ι.base := by rw [Scheme.Opens.range_ι]; exact hj
      obtain ⟨W', hw', hW'⟩ := (hst j).2.1.2.2 i p'
      haveI := hao j
      refine ⟨(a j) ''ᵁ W', ?_, ?_⟩
      · refine ⟨τj j i p', hw', ?_⟩
        have h0 := pt (hτ j i) p'
        rw [Scheme.Hom.comp_apply] at h0
        exact h0
      · have h1 : ((a j) ''ᵁ W').ι ≫ u =
            ((a j).isoImage W').inv ≫ (W'.ι ≫ uj j) ≫ (O j).ι := by
          rw [Iso.eq_inv_comp, ← Category.assoc, Scheme.Hom.isoImage_hom_ι]
          simp only [Category.assoc]
          rw [(hpb j).w]
        rw [h1]
        haveI := hW'
        haveI h2 : SmoothOfRelativeDimension 1 ((W'.ι ≫ uj j) ≫ (O j).ι) := by
          have := smoothOfRelativeDimension_comp (n := 1) (m := 0) (W'.ι ≫ uj j) (O j).ι
          simpa only [add_zero] using this
        have := smoothOfRelativeDimension_comp (n := 0) (m := 1) ((a j).isoImage W').inv
          ((W'.ι ≫ uj j) ≫ (O j).ι)
        simpa only [zero_add] using this

  have hgcu : GeometricallyConnected u := by
    refine ⟨fun K _ y W fst snd hW => ?_⟩
    obtain ⟨j, s', e, -, -, -⟩ := fac K y
    haveI := (hgc j).geometrically_connectedSpace s' (Limits.pullback.fst _ _)
      (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    let hh := Scheme.homeoOfIso (e.symm ≪≫ hW.isoPullback.symm)
    exact hh.surjective.connectedSpace hh.continuous
  refine ⟨⟨⟨hflat, hproper, ?_⟩, hsec, ?_⟩, hgcu⟩
  ·
    intro K _ _ s w
    obtain ⟨j, s', e, hs', he2, he3⟩ := fac K s
    set i := e.hom with hi_def
    rcases (hst j).1.2.2 K s' (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
    · left
      exact ⟨i ⁻¹ᵁ W', hw', s3 i _ _ he2 W' hsm⟩
    · right
      let σ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
      obtain ⟨Φ, hΦ⟩ := s1 _ _ σ.symm
      refine ⟨Φ.trans e₀, ?_⟩
      have h2 := s2 K i _ _ he2 w
      ext1 k
      have hk : σ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
          (Limits.pullback.snd u s).appTop ≫
          (Limits.pullback u s).presheaf.germ ⊤ w trivial).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd (uj j) s').appTop ≫
          (Limits.pullback (uj j) s').presheaf.germ ⊤ (i w) trivial).hom k := by
        rw [← h2, RingEquiv.symm_apply_eq]
        rfl
      have := RingHom.congr_fun he₀ k
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
      rw [RingEquiv.trans_apply, hΦ, hk]
      exact this
  ·
    intro K _ _ s E hE hdat
    obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
    obtain ⟨j, s', e, hs', I2, I1⟩ := fac K s
    haveI := hao j
    obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback u s) ≃ₜ ↥(Limits.pullback (uj j) s'),
        ∀ x, h x = e.hom x :=
      ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
    have hE0 : h '' E ∈ irreducibleComponents ↥(Limits.pullback (uj j) s') := by
      refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
        ?_ h.surjective hE
      intro y
      apply Set.Subsingleton.isPreirreducible
      intro a ha a' ha'
      exact h.injective (ha.trans ha'.symm)
    have hcnt : (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
      rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
      exact Set.ncard_image_of_injective _ h.injective
    have hdat0 : ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (uj j) s')
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd (uj j) s' := by
      refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
      · ext y
        constructor
        · rintro ⟨x, rfl⟩
          refine ⟨ι x, ?_, ?_⟩
          · rw [← hrange]; exact ⟨x, rfl⟩
          · rw [hh, Scheme.Hom.comp_apply]
        · rintro ⟨z, hz, rfl⟩
          rw [← hrange] at hz
          obtain ⟨x, rfl⟩ := hz
          exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
      · rw [hθ, Category.assoc, I2]
    have key := (hst j).2.2 K s' (h '' E) hE0 hdat0
    have Ia : ∀ x, a j (Limits.pullback.fst (uj j) s' (e.hom x)) = Limits.pullback.fst u s x := by
      intro x
      have := pt I1 x
      rwa [Scheme.Hom.comp_apply] at this
    have Ib : ∀ (i : Fin n) (p : ↥(Spec (.of K))), a j (τj j i (s' p)) = τ i (s p) := by
      intro i p
      have := pt (hτ j i) (s' p)
      rwa [Scheme.Hom.comp_apply, pt hs' p] at this
    have hiff : ∀ i : Fin n,
        (∃ x ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u s x = τ i (s p)) ↔
        (∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst (uj j) s' y = τj j i (s' p)) := by
      intro i
      constructor
      · rintro ⟨x, hx, p, hp⟩
        refine ⟨h x, ⟨x, hx, rfl⟩, p, ?_⟩
        apply (a j).isOpenEmbedding.injective
        rw [hh, Ia, Ib]
        exact hp
      · rintro ⟨y, ⟨x, hx, rfl⟩, p, hp⟩
        refine ⟨x, hx, p, ?_⟩
        rw [← Ia, ← Ib, ← hh, hp]
    have hcard : Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst u s x = τ i (s p)} =
        Nat.card {i : Fin n // ∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst (uj j) s' y = τj j i (s' p)} :=
      Nat.card_congr (Equiv.subtypeEquivRight hiff)
    rw [hcard, ← hcnt]
    exact key

theorem wcpa_dj_lcp_glue_stable : ∀ (k : Type u) [Field k] (S : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS →
    (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) →
    ∀ (X P : Scheme.{u}) (b : S ⟶ P) (f : X ⟶ P) (n : ℕ) (σ : Fin n → (P ⟶ X)), 3 ≤ n →
    ∀ (r : ℕ) (O : Fin r → S.Opens), (⨆ j, O j) = ⊤ →
    ∀ (Z : Fin r → Scheme.{u}) (u : ∀ j, Z j ⟶ (O j).toScheme)
      (τ : ∀ j, Fin n → ((O j).toScheme ⟶ Z j)),
      (∀ j, wcpaDjStablePtd (u j) n (τ j)) → (∀ j, GeometricallyConnected (u j)) →
    ∀ (W₀ : S.Opens) (hW : ∀ j, W₀ ≤ O j), W₀ ≠ ⊥ →
    ∀ (Y : Fin r → Scheme.{u}) (π : ∀ j, Y j ⟶ W₀.toScheme) (χ : ∀ j, Y j ⟶ X)
      (ψ : ∀ j, Y j ⟶ Z j) (s : ∀ j, Fin n → (W₀.toScheme ⟶ Y j)),
      (∀ j, IsPullback (χ j) (π j) f (W₀.ι ≫ b)) →
      (∀ j, IsPullback (ψ j) (π j) (u j) (S.homOfLE (hW j))) →
      (∀ j i, s j i ≫ π j = 𝟙 _) → (∀ j i, s j i ≫ χ j = (W₀.ι ≫ b) ≫ σ i) →
      (∀ j i, s j i ≫ ψ j = S.homOfLE (hW j) ≫ τ j i) →
    ∃ (Zg : Scheme.{u}) (ug : Zg ⟶ S) (τg : Fin n → (S ⟶ Zg)) (W : S.Opens) (Yw : Scheme.{u})
      (πw : Yw ⟶ W.toScheme) (χw : Yw ⟶ X) (ψw : Yw ⟶ Zg) (sw : Fin n → (W.toScheme ⟶ Yw)),
      wcpaDjStablePtd ug n τg ∧ GeometricallyConnected ug ∧ W ≠ ⊥ ∧
      IsPullback χw πw f (W.ι ≫ b) ∧ IsPullback ψw πw ug W.ι ∧
      (∀ i, sw i ≫ πw = 𝟙 _) ∧ (∀ i, sw i ≫ χw = (W.ι ≫ b) ≫ σ i) ∧
      (∀ i, sw i ≫ ψw = W.ι ≫ τg i) :=
by
  intro k _ S _ sS hS hnorm X P b f n σ hn r O hO Z u τ hst hgc W₀ hW hW0 Y π χ ψ s hχ hψ hsπ
    hsχ hsψ
  classical
  haveI hsSp : IsProper sS := wcpa_dj_proj_proper k sS hS
  haveI hup : ∀ a, IsProper (u a) := fun a => (hst a).1.2.1

  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have hmemι : ∀ {B : Scheme.{u}} (U : B.Opens) (x : U.toScheme), U.ι x ∈ U := by
    intro B U x
    show U.ι x ∈ (U : Set B)
    rw [← Scheme.Opens.range_ι U]
    exact ⟨x, rfl⟩
  obtain ⟨w0, hw0⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W₀).mp hW0
  obtain ⟨w0'⟩ : Nonempty W₀.toScheme := ⟨⟨w0, hw0⟩⟩
  have hne : ∀ U : S.Opens, W₀ ≤ U → Nonempty U.toScheme := fun U h => ⟨S.homOfLE h w0'⟩
  have hint : ∀ U : S.Opens, W₀ ≤ U → AlgebraicGeometry.IsIntegral U.toScheme := fun U h => by
    haveI := hne U h
    exact isIntegral_of_isOpenImmersion U.ι
  have hnormU : ∀ (U : S.Opens) (x : U.toScheme),
      IsIntegrallyClosed (U.toScheme.presheaf.stalk x) := by
    intro U x
    haveI := hnorm (U.ι x)
    exact IsIntegrallyClosed.of_equiv (asIso (U.ι.stalkMap x)).commRingCatIsoToRingEquiv
  have hτu : ∀ a i {T' : Scheme.{u}} (h : (O a).toScheme ⟶ T'), τ a i ≫ u a ≫ h = h := by
    intro a i T' h
    rw [← Category.assoc, (hst a).2.1.1 i, Category.id_comp]
  have hψq : ∀ a, ψ a ≫ u a ≫ (O a).ι = π a ≫ W₀.ι := by
    intro a
    rw [← Category.assoc, (hψ a).w, Category.assoc, Scheme.homOfLE_ι]
  have hψmem : ∀ a y, (u a ≫ (O a).ι) (ψ a y) ∈ W₀ := by
    intro a y
    rw [pt (hψq a), Scheme.Hom.comp_apply]
    exact hmemι W₀ _

  have hred : ∀ a, IsReduced (Z a) := fun a => by
    haveI := hint (O a) (hW a)
    exact (wcpa_dj_lgs_reduced_dense k (O a).toScheme ((O a).ι ≫ sS) inferInstance (Z a) (u a)
      (hst a).1).1
  have hdense : ∀ a, Dense (Set.range (ψ a).base) := by
    intro a
    haveI := hint (O a) (hW a)
    have h2 := (wcpa_dj_lgs_reduced_dense k (O a).toScheme ((O a).ι ≫ sS) inferInstance (Z a)
      (u a) (hst a).1).2 ((O a).ι ⁻¹ᵁ W₀) (by
        rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
        refine ⟨S.homOfLE (hW a) w0', ?_⟩
        show (O a).ι (S.homOfLE (hW a) w0') ∈ W₀
        rw [pt (Scheme.homOfLE_ι S (hW a))]
        exact hmemι W₀ w0')
    refine h2.mono ?_
    intro z hz
    have hz' : (O a).ι (u a z) ∈ W₀ := hz
    obtain ⟨p0, hp0⟩ : (O a).ι (u a z) ∈ Set.range W₀.ι.base := by
      rw [Scheme.Opens.range_ι]; exact hz'
    have hp2 : S.homOfLE (hW a) p0 = u a z :=
      (O a).ι.isOpenEmbedding.injective (by rw [pt (Scheme.homOfLE_ι S (hW a))]; exact hp0)
    obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback z p0 hp2.symm
    refine ⟨(hψ a).isoPullback.inv y, ?_⟩
    rw [pt (hψ a).isoPullback_inv_fst]
    exact hy1
  have hdom : ∀ a (R : (Z a).Opens) (g : Y a ⟶ R.toScheme), g ≫ R.ι = ψ a → IsDominant g := by
    intro a R g hg
    rw [isDominant_iff]
    refine Dense.mono ?_ ((hdense a).preimage R.ι.isOpenEmbedding.isOpenMap)
    rintro x ⟨y, hy⟩
    exact ⟨y, R.ι.isOpenEmbedding.injective (by rw [pt hg]; exact hy)⟩
  have hlift : ∀ a (R : (Z a).Opens), (∀ y, ψ a y ∈ R) → ∃ g : Y a ⟶ R.toScheme, g ≫ R.ι = ψ a :=
    fun a R h => ⟨IsOpenImmersion.lift R.ι (ψ a) (by
      rintro _ ⟨y, rfl⟩; rw [Scheme.Opens.range_ι]; exact h y), IsOpenImmersion.lift_fac _ _ _⟩

  obtain ⟨ε, hεχ, hεπ⟩ : ∃ ε : ∀ a c, Y a ≅ Y c, (∀ a c, (ε a c).hom ≫ χ c = χ a) ∧
      ∀ a c, (ε a c).hom ≫ π c = π a :=
    ⟨fun a c => IsPullback.isoIsPullback _ _ (hχ a) (hχ c),
      fun a c => IsPullback.isoIsPullback_hom_fst _ _ _ _,
      fun a c => IsPullback.isoIsPullback_hom_snd _ _ _ _⟩
  have hE1 : ∀ a, (ε a a).hom = 𝟙 _ := fun a =>
    (hχ a).hom_ext (by rw [hεχ, Category.id_comp]) (by rw [hεπ, Category.id_comp])
  have hE2 : ∀ a b c, (ε a b).hom ≫ (ε b c).hom = (ε a c).hom := fun a b c =>
    (hχ c).hom_ext (by rw [Category.assoc, hεχ, hεχ, hεχ]) (by rw [Category.assoc, hεπ, hεπ, hεπ])
  have hE3 : ∀ a c i, s a i ≫ (ε a c).hom = s c i := fun a c i =>
    (hχ c).hom_ext (by rw [Category.assoc, hεχ, hsχ, hsχ]) (by rw [Category.assoc, hεπ, hsπ, hsπ])

  have key : ∀ a c, ∃ Φ : Limits.pullback (u a) (S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a)) ⟶
      Limits.pullback (u c) (S.homOfLE (inf_le_right : O a ⊓ O c ≤ O c)),
      Φ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ∧
      ∀ g : Y a ⟶ Limits.pullback (u a) (S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a)),
        g ≫ Limits.pullback.fst _ _ = ψ a →
        g ≫ Limits.pullback.snd _ _ = π a ≫ S.homOfLE (le_inf (hW a) (hW c)) →
        g ≫ Φ ≫ Limits.pullback.fst _ _ = (ε a c).hom ≫ ψ c := by
    intro a c
    set lam := S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) with hlam
    set rho := S.homOfLE (inf_le_right : O a ⊓ O c ≤ O c) with hrho
    set v := S.homOfLE (le_inf (hW a) (hW c)) with hv
    have hvl : v ≫ lam = S.homOfLE (hW a) := Scheme.homOfLE_homOfLE _ _ _
    have hvr : v ≫ rho = S.homOfLE (hW c) := Scheme.homOfLE_homOfLE _ _ _
    haveI := hint (O a ⊓ O c) (le_inf (hW a) (hW c))
    obtain ⟨τP, hτPst, hτPs, hτPf⟩ := wcpa_dj_lcp_stableptd_basechange (u a) n (τ a) lam (hst a)
    obtain ⟨τQ, hτQst, hτQs, hτQf⟩ := wcpa_dj_lcp_stableptd_basechange (u c) n (τ c) rho (hst c)
    have hgcP : GeometricallyConnected (Limits.pullback.snd (u a) lam) :=
      MorphismProperty.of_isPullback (P := @GeometricallyConnected)
        (IsPullback.of_hasPullback _ _) (hgc a)
    have hgcQ : GeometricallyConnected (Limits.pullback.snd (u c) rho) :=
      MorphismProperty.of_isPullback (P := @GeometricallyConnected)
        (IsPullback.of_hasPullback _ _) (hgc c)
    have wP : ψ a ≫ u a = (π a ≫ v) ≫ lam := by
      rw [Category.assoc (π a), hvl, (hψ a).w]
    have wQ : ((ε a c).hom ≫ ψ c) ≫ u c = (π a ≫ v) ≫ rho := by
      rw [Category.assoc (π a), hvr, Category.assoc, (hψ c).w, ← Category.assoc, hεπ]
    set aP := Limits.pullback.lift _ _ wP with haP
    set aQ := Limits.pullback.lift _ _ wQ with haQ
    have hQbig : IsPullback ((ε a c).hom ≫ ψ c) (π a) (u c) (S.homOfLE (hW c)) :=
      IsPullback.of_iso (hψ c) (ε a c).symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by simp) (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hεπ a c,
          Iso.inv_hom_id_assoc]) (by simp) (by simp)
    have hPpb : IsPullback aP (π a) (Limits.pullback.snd (u a) lam) v := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback (u a) lam)
      rw [Limits.pullback.lift_fst, hvl]
      exact hψ a
    have hQpb : IsPullback aQ (π a) (Limits.pullback.snd (u c) rho) v := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback (u c) rho)
      rw [Limits.pullback.lift_fst, hvr]
      exact hQbig
    have hsec : ∀ i, ∃ t : W₀.toScheme ⟶ Y a, t ≫ π a = 𝟙 _ ∧ t ≫ aP = v ≫ τP i ∧
        t ≫ aQ = v ≫ τQ i := by
      intro i
      refine ⟨s a i, hsπ a i, ?_, ?_⟩
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.assoc, hτPf, ← Category.assoc,
            hvl, hsψ]
        · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, hsπ,
            Category.id_comp, Category.assoc, hτPs, Category.comp_id]
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hE3, hsψ,
            Category.assoc, hτQf, ← Category.assoc, hvr]
        · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, hsπ,
            Category.id_comp, Category.assoc, hτQs, Category.comp_id]
    obtain ⟨Φ, hΦ1, hΦ2⟩ := wcpa_dj_lgs_iso_extend k (O a ⊓ O c).toScheme ((O a ⊓ O c).ι ≫ sS)
      inferInstance (hnormU _) _ _ (Limits.pullback.snd (u a) lam)
      (Limits.pullback.snd (u c) rho) n τP τQ hn hτPst hτQst hgcP hgcQ W₀.toScheme (Y a) v
      (π a) aP aQ inferInstance ⟨w0'⟩ hPpb hQpb hsec
    refine ⟨Φ, hΦ1, fun g hg1 hg2 => ?_⟩
    have hg : g = aP := Limits.pullback.hom_ext (by rw [hg1, Limits.pullback.lift_fst])
      (by rw [hg2, Limits.pullback.lift_snd])
    rw [hg, ← Category.assoc, hΦ2, Limits.pullback.lift_fst]

  obtain ⟨τ', hG1, hstar⟩ : ∃ τ' : ∀ a c, ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme ⟶ Z c,
      (∀ a c, τ' a c ≫ u c ≫ (O c).ι = ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι ≫ u a ≫ (O a).ι) ∧
      (∀ a c (g : Y a ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme),
        g ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι = ψ a → g ≫ τ' a c = (ε a c).hom ≫ ψ c) := by
    choose Φ hΦs hΦk using key
    have hmr : ∀ a c, Set.range (((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι ≫ u a ≫ (O a).ι).base ⊆
        Set.range (O a ⊓ O c).ι.base := by
      intro a c
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      have h1 : (u a ≫ (O a).ι) (((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι x) ∈ O a := by
        rw [Scheme.Hom.comp_apply]; exact hmemι _ _
      have h2 : (u a ≫ (O a).ι) (((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι x) ∈ O c := hmemι _ x
      exact ⟨h1, h2⟩
    obtain ⟨m, hm⟩ : ∃ m : ∀ a c, ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme ⟶ (O a ⊓ O c).toScheme,
        ∀ a c, m a c ≫ (O a ⊓ O c).ι = ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι ≫ u a ≫ (O a).ι :=
      ⟨fun a c => IsOpenImmersion.lift _ _ (hmr a c), fun a c => IsOpenImmersion.lift_fac _ _ _⟩
    have hcomm : ∀ a c, ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι ≫ u a =
        m a c ≫ S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) := by
      intro a c
      rw [← cancel_mono (O a).ι, Category.assoc, Category.assoc, Scheme.homOfLE_ι, hm]
    refine ⟨fun a c => Limits.pullback.lift _ _ (hcomm a c) ≫ Φ a c ≫ Limits.pullback.fst _ _,
      ?_, ?_⟩
    · intro a c
      simp only [Category.assoc]
      rw [Limits.pullback.condition_assoc, reassoc_of% (hΦs a c),
        Limits.pullback.lift_snd_assoc, Scheme.homOfLE_ι, hm]
    · intro a c g hg
      have h := hΦk a c (g ≫ Limits.pullback.lift _ _ (hcomm a c))
        (by rw [Category.assoc, Limits.pullback.lift_fst, hg])
        (by
          rw [Category.assoc, Limits.pullback.lift_snd, ← cancel_mono (O a ⊓ O c).ι,
            Category.assoc, hm, ← Category.assoc, hg, hψq, Category.assoc, Scheme.homOfLE_ι])
      simpa only [Category.assoc] using h
  have hstar' : ∀ a c {T : Scheme.{u}} (g : T ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme)
      (e : T ⟶ Y a), g ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι = e ≫ ψ a →
      g ≫ τ' a c = e ≫ (ε a c).hom ≫ ψ c := by
    intro a c T g e hg
    obtain ⟨gl, hgl⟩ := hlift a ((u a ≫ (O a).ι) ⁻¹ᵁ O c) (fun y => hW c (hψmem a y))
    have : g = e ≫ gl := by
      rw [← cancel_mono ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι, Category.assoc, hgl, hg]
    rw [this, Category.assoc, hstar a c gl hgl]

  have hid : ∀ a, τ' a a = ((u a ≫ (O a).ι) ⁻¹ᵁ O a).ι := by
    intro a
    haveI := hred a
    haveI := hup a
    obtain ⟨gl, hgl⟩ := hlift a ((u a ≫ (O a).ι) ⁻¹ᵁ O a) (fun y => hW a (hψmem a y))
    haveI := hdom a _ gl hgl
    refine ext_of_isDominant_of_isSeparated (u a ≫ (O a).ι) (hG1 a a) gl ?_
    rw [hstar a a gl hgl, hE1, Category.id_comp, hgl]

  have hcoc : ∀ a b c (T : Scheme.{u}) (h₁ : T ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ O b).toScheme)
      (h₂ : T ⟶ ((u b ≫ (O b).ι) ⁻¹ᵁ O c).toScheme)
      (h₃ : T ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme),
      h₂ ≫ ((u b ≫ (O b).ι) ⁻¹ᵁ O c).ι = h₁ ≫ τ' a b →
      h₃ ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι = h₁ ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O b).ι →
      h₂ ≫ τ' b c = h₃ ≫ τ' a c := by
    intro a b c T h₁ h₂ h₃ e1 e2
    haveI := hred a
    haveI := hup c
    have hR1 : (u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c) ≤ (u a ≫ (O a).ι) ⁻¹ᵁ O b := fun x hx => hx.1
    have hR3 : (u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c) ≤ (u a ≫ (O a).ι) ⁻¹ᵁ O c := fun x hx => hx.2
    have hr2 : Set.range ((Z a).homOfLE hR1 ≫ τ' a b).base ⊆
        Set.range ((u b ≫ (O b).ι) ⁻¹ᵁ O c).ι.base := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      have h1 : (u b ≫ (O b).ι) (((Z a).homOfLE hR1 ≫ τ' a b) x) ∈ O c := by
        rw [pt (show ((Z a).homOfLE hR1 ≫ τ' a b) ≫ u b ≫ (O b).ι =
            ((u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c)).ι ≫ u a ≫ (O a).ι by
          rw [Category.assoc, hG1, Scheme.homOfLE_ι_assoc])]
        exact (hmemι ((u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c)) x).2
      exact h1
    obtain ⟨r₂, hr2f⟩ : ∃ r₂ : ((u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c)).toScheme ⟶
        ((u b ≫ (O b).ι) ⁻¹ᵁ O c).toScheme,
        r₂ ≫ ((u b ≫ (O b).ι) ⁻¹ᵁ O c).ι = (Z a).homOfLE hR1 ≫ τ' a b :=
      ⟨IsOpenImmersion.lift _ _ hr2, IsOpenImmersion.lift_fac _ _ _⟩
    have hC : r₂ ≫ τ' b c = (Z a).homOfLE hR3 ≫ τ' a c := by
      obtain ⟨gR, hgR⟩ := hlift a ((u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c))
        (fun y => ⟨hW b (hψmem a y), hW c (hψmem a y)⟩)
      haveI := hdom a _ gR hgR
      refine ext_of_isDominant_of_isSeparated (u c ≫ (O c).ι) ?_ gR ?_
      · simp only [Category.assoc]
        rw [hG1 b c, reassoc_of% hr2f, hG1 a b, Scheme.homOfLE_ι_assoc, hG1 a c,
          Scheme.homOfLE_ι_assoc]
      · have hb := hstar a b (gR ≫ (Z a).homOfLE hR1)
          (by rw [Category.assoc, Scheme.homOfLE_ι, hgR])
        have hc := hstar a c (gR ≫ (Z a).homOfLE hR3)
          (by rw [Category.assoc, Scheme.homOfLE_ι, hgR])
        rw [← Category.assoc, hstar' b c (gR ≫ r₂) (ε a b).hom
          (by rw [Category.assoc, hr2f, ← Category.assoc, hb]),
          ← Category.assoc, hE2, ← Category.assoc, hc]
    have e2' : ∀ x, ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι (h₃ x) =
        ((u a ≫ (O a).ι) ⁻¹ᵁ O b).ι (h₁ x) := fun x => by
      rw [← Scheme.Hom.comp_apply, e2, Scheme.Hom.comp_apply]
    have hx : ∀ x, (u a ≫ (O a).ι) (((u a ≫ (O a).ι) ⁻¹ᵁ O b).ι (h₁ x)) ∈ O b ⊓ O c :=
      fun x => ⟨hmemι _ (h₁ x), by rw [← e2' x]; exact hmemι _ (h₃ x)⟩
    obtain ⟨hh, hhf⟩ : ∃ hh : T ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c)).toScheme,
        hh ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ (O b ⊓ O c)).ι = h₁ ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O b).ι :=
      ⟨IsOpenImmersion.lift _ _ (by
        rintro _ ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
        exact hx x), IsOpenImmersion.lift_fac _ _ _⟩
    have hh1 : hh ≫ (Z a).homOfLE hR1 = h₁ := by
      rw [← cancel_mono ((u a ≫ (O a).ι) ⁻¹ᵁ O b).ι, Category.assoc, Scheme.homOfLE_ι, hhf]
    have hh3 : hh ≫ (Z a).homOfLE hR3 = h₃ := by
      rw [← cancel_mono ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι, Category.assoc, Scheme.homOfLE_ι, hhf, e2]
    have hh2 : hh ≫ r₂ = h₂ := by
      rw [← cancel_mono ((u b ≫ (O b).ι) ⁻¹ᵁ O c).ι, Category.assoc, hr2f, ← Category.assoc,
        hh1, e1]
    rw [← hh2, ← hh3, Category.assoc, hC, Category.assoc]

  have hsc : ∀ a c i (t : (O a ⊓ O c).toScheme ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme),
      t ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι = S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) ≫ τ a i →
      t ≫ τ' a c = S.homOfLE (inf_le_right : O a ⊓ O c ≤ O c) ≫ τ c i := by
    intro a c i t ht
    haveI := hint (O a ⊓ O c) (le_inf (hW a) (hW c))
    haveI := hup c
    haveI hv : IsDominant (S.homOfLE (le_inf (hW a) (hW c))) := by
      rw [isDominant_iff]
      exact (S.homOfLE (le_inf (hW a) (hW c))).isOpenEmbedding.isOpen_range.dense ⟨_, w0', rfl⟩
    refine ext_of_isDominant_of_isSeparated (u c ≫ (O c).ι) ?_
      (S.homOfLE (le_inf (hW a) (hW c))) ?_
    · simp only [Category.assoc]
      rw [hG1, reassoc_of% ht, hτu, hτu]
      simp only [Scheme.homOfLE_ι]
    · rw [← Category.assoc, hstar' a c _ (s a i)
        (by rw [Category.assoc, ht, Scheme.homOfLE_homOfLE_assoc, hsψ]),
        ← Category.assoc, hE3, hsψ, Scheme.homOfLE_homOfLE_assoc]

  obtain ⟨Zg, p, ι, hιo, hιp, hιr, -, hιτ, -⟩ := wc_sch_rel_glue S (ULift.{u} (Fin r))
    (fun i => O i.down) (fun i => Z i.down) (fun i => u i.down ≫ (O i.down).ι)
    (fun i => by rintro _ ⟨x, rfl⟩; rw [Scheme.Hom.comp_apply]; exact hmemι _ _)
    (fun i j => τ' i.down j.down) (fun i j => hG1 i.down j.down)
    (fun i T h => congrArg (fun g => h ≫ g) (hid i.down))
    (fun i j k T h₁ h₂ h₃ e1 e2 => hcoc i.down j.down k.down T h₁ h₂ h₃ e1 e2)
  have hιp' : ∀ a, ι ⟨a⟩ ≫ p = u a ≫ (O a).ι := fun a => hιp ⟨a⟩
  have hιτ' : ∀ a c, ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι ≫ ι ⟨a⟩ = τ' a c ≫ ι ⟨c⟩ :=
    fun a c => hιτ ⟨a⟩ ⟨c⟩
  have hpb : ∀ a, IsPullback (ι ⟨a⟩) (u a) p (O a).ι := by
    intro a
    haveI := hιo ⟨a⟩
    have hr : Set.range (ι ⟨a⟩).base = Set.range (p ⁻¹ᵁ O a).ι.base := by
      rw [hιr ⟨a⟩, Scheme.Opens.range_ι]; rfl
    set e := IsOpenImmersion.isoOfRangeEq (ι ⟨a⟩) (p ⁻¹ᵁ O a).ι hr with he
    have hef : e.hom ≫ (p ⁻¹ᵁ O a).ι = ι ⟨a⟩ := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
    have heu : e.hom ≫ (p ∣_ O a) = u a := by
      rw [← cancel_mono (O a).ι, Category.assoc, morphismRestrict_ι, reassoc_of% hef, hιp']
    exact (isPullback_morphismRestrict p (O a)).flip.of_iso e.symm (Iso.refl _) (Iso.refl _)
      (Iso.refl _)
      (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hef, Iso.inv_hom_id_assoc])
      (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← heu, Iso.inv_hom_id_assoc])
      (by simp) (by simp)

  have hov : ∀ i a c, S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) ≫ τ a i ≫ ι ⟨a⟩ =
      S.homOfLE (inf_le_right : O a ⊓ O c ≤ O c) ≫ τ c i ≫ ι ⟨c⟩ := by
    intro i a c
    have hrg : Set.range (S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) ≫ τ a i).base ⊆
        Set.range ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι.base := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      show (u a ≫ (O a).ι) ((S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) ≫ τ a i) x) ∈ O c
      rw [pt (show (S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) ≫ τ a i) ≫ u a ≫ (O a).ι =
          (O a ⊓ O c).ι by rw [Category.assoc, hτu, Scheme.homOfLE_ι])]
      exact (hmemι (O a ⊓ O c) x).2
    obtain ⟨t, ht⟩ : ∃ t : (O a ⊓ O c).toScheme ⟶ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).toScheme,
        t ≫ ((u a ≫ (O a).ι) ⁻¹ᵁ O c).ι = S.homOfLE (inf_le_left : O a ⊓ O c ≤ O a) ≫ τ a i :=
      ⟨IsOpenImmersion.lift _ _ hrg, IsOpenImmersion.lift_fac _ _ _⟩
    rw [← reassoc_of% ht, hιτ', ← Category.assoc, hsc a c i t ht, Category.assoc]
  choose φ hφ using fun i => (wc_csd_glue_opens S Zg r O).2 (fun l => τ l i ≫ ι ⟨l⟩)
    (fun a c => hov i a c)
  obtain ⟨e, he⟩ : ∃ e : S ⟶ (⨆ j, O j).toScheme, e ≫ (⨆ j, O j).ι = 𝟙 S :=
    ⟨IsOpenImmersion.lift _ _ (by rintro _ ⟨x, rfl⟩; rw [Scheme.Opens.range_ι, hO]; simp),
      IsOpenImmersion.lift_fac _ _ _⟩
  have hOe : ∀ a, (O a).ι ≫ e = S.homOfLE (le_iSup O a) := by
    intro a
    rw [← cancel_mono (⨆ j, O j).ι, Category.assoc, he, Category.comp_id, Scheme.homOfLE_ι]
  have hτg : ∀ a i, (O a).ι ≫ e ≫ φ i = τ a i ≫ ι ⟨a⟩ := by
    intro a i
    rw [← Category.assoc, hOe, hφ i a]

  have hstab := wcpa_dj_lgs_stableptd_local Zg S p n (fun i => e ≫ φ i) r O hO Z
    (fun a => ι ⟨a⟩) u τ hpb hst hgc (fun a i => (hτg a i).symm)

  have hw0O : w0 ∈ ⨆ j, O j := by rw [hO]; trivial
  obtain ⟨j₀, -⟩ := TopologicalSpace.Opens.mem_iSup.mp hw0O
  refine ⟨Zg, p, fun i => e ≫ φ i, W₀, Y j₀, π j₀, χ j₀, ψ j₀ ≫ ι ⟨j₀⟩, s j₀, hstab.1, hstab.2,
    hW0, hχ j₀, ?_, hsπ j₀, hsχ j₀, ?_⟩
  · have h := (hψ j₀).paste_horiz (hpb j₀)
    rwa [Scheme.homOfLE_ι] at h
  · intro i
    rw [← Category.assoc, hsψ, Category.assoc, ← hτg, ← Category.assoc, Scheme.homOfLE_ι]

theorem wcpa_dj_lcf_sc_conormal_of_ann : ∀ {R B : Type u} [CommRing R] [CommRing B] (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* B) (f : Fin r → MvPolynomial (Fin (r + 1)) R), RingHom.ker π = Ideal.span (Set.range f) → (∀ v : B, (∀ j, v * π (wcpaDjJacMinor f j) = 0) → v = 0) → ∀ c : Fin r → MvPolynomial (Fin (r + 1)) R, ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π :=
by
  intro R B _ _ r π f hker hE3 c hh i
  classical
  set I := RingHom.ker π with hI

  have hf : ∀ i, f i ∈ I := fun i => by
    rw [hker]; exact Ideal.subset_span ⟨i, rfl⟩

  have hsq : ∀ l : Fin (r + 1), ∀ a ∈ I ^ 2, MvPolynomial.pderiv l a ∈ I := by
    intro l a ha
    rw [pow_two] at ha
    refine Submodule.mul_induction_on ha ?_ ?_
    · intro x hx y hy
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (Ideal.mul_mem_right _ _ hx) (Ideal.mul_mem_right _ _ hy)
    · intro x y hx hy
      rw [map_add]
      exact add_mem hx hy

  have hrow : ∀ l : Fin (r + 1), ∑ i, π (c i) * π (MvPolynomial.pderiv l (f i)) = 0 := by
    intro l
    have h1 : MvPolynomial.pderiv l (∑ i, c i * f i) =
        ∑ i, c i * MvPolynomial.pderiv l (f i) + ∑ i, f i * MvPolynomial.pderiv l (c i) := by
      rw [map_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    have h2 : ∑ i, c i * MvPolynomial.pderiv l (f i) ∈ I := by
      have h3 : ∑ i, c i * MvPolynomial.pderiv l (f i) =
          MvPolynomial.pderiv l (∑ i, c i * f i) - ∑ i, f i * MvPolynomial.pderiv l (c i) := by
        rw [h1]; ring
      rw [h3]
      refine Ideal.sub_mem _ (hsq l _ hh) ?_
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hf i))
    have h4 := (RingHom.mem_ker).mp h2
    rw [map_sum] at h4
    simpa only [map_mul] using h4

  have hkill : ∀ j : Fin (r + 1), ∀ i : Fin r,
      (Matrix.of fun (i l : Fin r) => π (MvPolynomial.pderiv (j.succAbove l) (f i))).det
        * π (c i) = 0 := by
    intro j i
    set N : Matrix (Fin r) (Fin r) B :=
      Matrix.of fun (i l : Fin r) => π (MvPolynomial.pderiv (j.succAbove l) (f i)) with hN
    set w : Fin r → B := fun i => π (c i) with hw
    have ha : Matrix.vecMul w N = 0 := by
      funext l
      simp only [Matrix.vecMul, dotProduct, hN, hw, Matrix.of_apply, Pi.zero_apply]
      exact hrow (j.succAbove l)
    have hb : N.det • w = 0 := by
      calc N.det • w = N.det • Matrix.vecMul w 1 := by rw [Matrix.vecMul_one]
        _ = Matrix.vecMul w (N.det • (1 : Matrix (Fin r) (Fin r) B)) := by
          rw [Matrix.vecMul_smul]
        _ = Matrix.vecMul w (N * N.adjugate) := by rw [Matrix.mul_adjugate]
        _ = Matrix.vecMul (Matrix.vecMul w N) N.adjugate := by rw [Matrix.vecMul_vecMul]
        _ = 0 := by rw [ha, Matrix.zero_vecMul]
    have := congrFun hb i
    simpa [hw] using this

  have hminor : ∀ j : Fin (r + 1), π (wcpaDjJacMinor f j) = (-1) ^ (j : ℕ) *
      (Matrix.of fun (i l : Fin r) => π (MvPolynomial.pderiv (j.succAbove l) (f i))).det := by
    intro j
    unfold wcpaDjJacMinor
    rw [map_mul, map_pow, map_neg, map_one, RingHom.map_det]
    congr 2

  apply RingHom.mem_ker.mpr
  apply hE3
  intro j
  rw [hminor j, mul_left_comm, mul_comm (π (c i)), hkill j i, mul_zero]

theorem wcpa_dj_lcf_sc_smooth_chart : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (z : Y) (W₀ : Y.Opens), z ∈ W₀ → SmoothOfRelativeDimension 1 (W₀.ι ≫ q) → ∃ (V : Y.Opens) (W : T.Opens) (hle : V ≤ q ⁻¹ᵁ W) (r : ℕ) (π : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* Γ(Y, V)) (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W)), z ∈ V ∧ IsAffineOpen V ∧ IsAffineOpen W ∧ Function.Surjective π ∧ (∀ c, π (MvPolynomial.C c) = (q.appLE W V hle).hom c) ∧ RingHom.ker π = Ideal.span (Set.range f) :=
by
  have s2 : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
      RingHom.IsStandardSmoothOfRelativeDimension 1 φ →
      ∃ (r : ℕ) (π : MvPolynomial (Fin (r + 1)) A →+* B)
        (f : Fin r → MvPolynomial (Fin (r + 1)) A),
        Function.Surjective π ∧ (∀ c, π (MvPolynomial.C c) = φ c) ∧
          RingHom.ker π = Ideal.span (Set.range f) := by
    intro A B _ _ φ hφ
    letI : Algebra A B := φ.toAlgebra
    have hφ' : Algebra.IsStandardSmoothOfRelativeDimension 1 A B := hφ
    obtain ⟨ι, σ, _, _, P, hP⟩ := hφ'.out
    have hcard : Nat.card ι = Nat.card σ + 1 := by
      have h1 : Nat.card ι - Nat.card σ = 1 := hP
      omega
    let eσ : σ ≃ Fin (Nat.card σ) := Finite.equivFin σ
    let eι : ι ≃ Fin (Nat.card σ + 1) := (Finite.equivFin ι).trans (finCongr hcard)
    have hre : ∀ g : MvPolynomial ι A,
        MvPolynomial.rename eι.symm (MvPolynomial.rename eι g) = g := by
      intro g
      rw [MvPolynomial.rename_rename, Equiv.symm_comp_self, MvPolynomial.rename_id_apply]
    have hre' : ∀ g : MvPolynomial (Fin (Nat.card σ + 1)) A,
        MvPolynomial.rename eι (MvPolynomial.rename eι.symm g) = g := by
      intro g
      rw [MvPolynomial.rename_rename, Equiv.self_comp_symm, MvPolynomial.rename_id_apply]
    refine ⟨Nat.card σ,
      (MvPolynomial.aeval P.val).toRingHom.comp (MvPolynomial.rename eι.symm).toRingHom,
      fun i => MvPolynomial.rename eι (P.relation (eσ.symm i)), ?_, ?_, ?_⟩
    · intro b
      obtain ⟨g, hg⟩ := P.aeval_val_surjective b
      refine ⟨MvPolynomial.rename eι g, ?_⟩
      show MvPolynomial.aeval P.val (MvPolynomial.rename eι.symm (MvPolynomial.rename eι g)) = b
      rw [hre, hg]
    · intro c
      show MvPolynomial.aeval P.val (MvPolynomial.rename eι.symm (MvPolynomial.C c)) = φ c
      rw [MvPolynomial.rename_C, MvPolynomial.aeval_C]
      rfl
    · have hK : RingHom.ker (MvPolynomial.aeval P.val) = Ideal.span (Set.range P.relation) := by
        rw [P.span_range_relation_eq_ker, P.ker_eq_ker_aeval_val]
      apply le_antisymm
      · intro h hh
        have hg : MvPolynomial.rename eι.symm h ∈ RingHom.ker (MvPolynomial.aeval P.val) := by
          rw [RingHom.mem_ker]
          exact hh
        rw [hK] at hg
        have hm := Ideal.mem_map_of_mem (MvPolynomial.rename eι) hg
        rw [hre', Ideal.map_span] at hm
        refine Ideal.span_mono ?_ hm
        rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
        exact ⟨eσ s, by simp only [Equiv.symm_apply_apply]⟩
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        show MvPolynomial.aeval P.val (MvPolynomial.rename eι.symm
          (MvPolynomial.rename eι (P.relation (eσ.symm i)))) = 0
        rw [hre, P.aeval_val_relation]
  intro Y T q z W₀ hz hsm
  haveI := hsm
  obtain ⟨U, hU, V', hV', hzV', e, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1) (f := W₀.ι ≫ q)
      (⟨z, hz⟩ : W₀.toScheme)
  obtain ⟨r, π₀, f, hsurj₀, hC₀, hker₀⟩ := s2 _ hstd
  have hle : W₀.ι ''ᵁ V' ≤ q ⁻¹ᵁ U := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact e hx
  have key : (W₀.ι ≫ q).appLE U V' e = q.appLE U (W₀.ι ''ᵁ V') hle ≫ (W₀.ι.appIso V').hom := by
    rw [Scheme.Hom.appIso_hom', Scheme.Hom.appLE_comp_appLE]
  have key2 : q.appLE U (W₀.ι ''ᵁ V') hle = (W₀.ι ≫ q).appLE U V' e ≫ (W₀.ι.appIso V').inv := by
    rw [key, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hhi : ∀ y, (W₀.ι.appIso V').inv.hom ((W₀.ι.appIso V').hom.hom y) = y := fun y => by
    have := congrArg (fun g => g.hom y) (W₀.ι.appIso V').hom_inv_id
    rw [CommRingCat.hom_comp, CommRingCat.hom_id] at this
    exact this
  have hih : ∀ y, (W₀.ι.appIso V').hom.hom ((W₀.ι.appIso V').inv.hom y) = y := fun y => by
    have := congrArg (fun g => g.hom y) (W₀.ι.appIso V').inv_hom_id
    rw [CommRingCat.hom_comp, CommRingCat.hom_id] at this
    exact this
  have hinj : Function.Injective (W₀.ι.appIso V').inv.hom := fun a b hab => by
    rw [← hih a, ← hih b, hab]
  have hzV : z ∈ W₀.ι ''ᵁ V' := by
    have h1 := (W₀.ι.apply_mem_image_iff (U := V') (x := ⟨z, hz⟩)).mpr hzV'
    rwa [Scheme.Opens.ι_apply] at h1
  refine ⟨W₀.ι ''ᵁ V', U, hle, r, (W₀.ι.appIso V').inv.hom.comp π₀, f, hzV,
    hV'.image_of_isOpenImmersion W₀.ι, hU, ?_, ?_, ?_⟩
  · intro y
    obtain ⟨x, hx⟩ := hsurj₀ ((W₀.ι.appIso V').hom.hom y)
    exact ⟨x, by rw [RingHom.comp_apply, hx, hhi]⟩
  · intro c
    rw [RingHom.comp_apply, hC₀ c, key2, CommRingCat.hom_comp, RingHom.comp_apply]
  · rw [RingHom.ker_comp_of_injective _ hinj, hker₀]

theorem wcpa_dj_lcf_sc_chart_away : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (V : Y.Opens) (W : T.Opens) (hle : V ≤ q ⁻¹ᵁ W) (r s : ℕ) (p : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* Γ(Y, V)) (F : Fin s → MvPolynomial (Fin (r + 1)) Γ(T, W)) (e : Fin r → Fin s) (G : MvPolynomial (Fin (r + 1)) Γ(T, W)), IsAffineOpen V → Function.Surjective p → (∀ c, p (MvPolynomial.C c) = (q.appLE W V hle).hom c) → RingHom.ker p = Ideal.span (Set.range F) → (∀ j, G * F j ∈ Ideal.span (Set.range (F ∘ e))) → ∃ (hle' : Y.basicOpen (p G) ≤ q ⁻¹ᵁ W) (π' : MvPolynomial (Fin (r + 1 + 1)) Γ(T, W) →+* Γ(Y, Y.basicOpen (p G))) (f' : Fin (r + 1) → MvPolynomial (Fin (r + 1 + 1)) Γ(T, W)), Function.Surjective π' ∧ (∀ c, π' (MvPolynomial.C c) = (q.appLE W (Y.basicOpen (p G)) hle').hom c) ∧ RingHom.ker π' = Ideal.span (Set.range f') :=
by
  intro Y T q V W hle r s p F e G hV hp hC hker hG
  classical

  haveI := hV.isLocalization_basicOpen (p G)
  have hle' : Y.basicOpen (p G) ≤ q ⁻¹ᵁ W := (Y.basicOpen_le (p G)).trans hle
  have F1 : ∀ b, (q.appLE W (Y.basicOpen (p G)) hle').hom b =
      algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G)) ((q.appLE W V hle).hom b) := fun b =>
    congrArg (fun φ => φ.hom b) (Scheme.Hom.appLE_map q hle (homOfLE (Y.basicOpen_le (p G))).op).symm

  set u : Γ(Y, Y.basicOpen (p G)) := IsLocalization.Away.invSelf (S := Γ(Y, Y.basicOpen (p G))) (p G)
    with hu
  set x' : Fin (r + 1 + 1) → Γ(Y, Y.basicOpen (p G)) := Fin.snoc (α := fun _ => Γ(Y, Y.basicOpen (p G)))
    (fun j => algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G)) (p (MvPolynomial.X j))) u with hx'
  set π' := MvPolynomial.eval₂Hom (q.appLE W (Y.basicOpen (p G)) hle').hom x' with hπ'
  set I' := Ideal.span (Set.range (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Γ(T, W))
    (fun i => MvPolynomial.rename Fin.castSucc (F (e i)))
    (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc G - 1))) with hI'
  let ι : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* MvPolynomial (Fin (r + 1 + 1)) Γ(T, W) :=
    (MvPolynomial.rename Fin.castSucc).toRingHom

  have L1 : π'.comp ι = (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G))).comp p := by
    apply MvPolynomial.ringHom_ext
    · intro b
      simp only [ι, hπ', RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.rename_C, MvPolynomial.eval₂Hom_C, hC]
      exact F1 b
    · intro j
      simp only [ι, hπ', hx', RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc]
  have L1' : ∀ h, π' (MvPolynomial.rename Fin.castSucc h)
      = algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G)) (p h) := fun h => RingHom.congr_fun L1 h
  have hπ't : π' (MvPolynomial.X (Fin.last (r + 1))) = u := by
    simp only [hπ', hx', MvPolynomial.eval₂Hom_X', Fin.snoc_last]
  have hus : algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G)) (p G) * u = 1 :=
    IsLocalization.Away.mul_invSelf (p G)

  have surj : Function.Surjective π' := by
    intro z
    obtain ⟨n, a, hz⟩ := IsLocalization.Away.surj (p G) z
    obtain ⟨a', ha'⟩ := hp a
    refine ⟨MvPolynomial.rename Fin.castSucc a' * MvPolynomial.X (Fin.last (r + 1)) ^ n, ?_⟩
    rw [map_mul, map_pow, L1', ha', hπ't, ← hz, mul_assoc, ← mul_pow, hus, one_pow, mul_one]

  have hfI : ∀ i, MvPolynomial.rename Fin.castSucc (F (e i)) ∈ I' :=
    fun i => Ideal.subset_span ⟨i.castSucc, Fin.snoc_castSucc _ _ _⟩
  have hlast : MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc G - 1 ∈ I' :=
    Ideal.subset_span ⟨Fin.last r, Fin.snoc_last _ _⟩

  have s5 : I' ≤ RingHom.ker π' := by
    rw [hI', Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    induction i using Fin.lastCases with
    | last =>
      rw [Fin.snoc_last, map_sub, map_mul, hπ't, L1', map_one, mul_comm, hus, sub_self]
    | cast j =>
      rw [Fin.snoc_castSucc, L1']
      have hj : F (e j) ∈ RingHom.ker p := by rw [hker]; exact Ideal.subset_span ⟨e j, rfl⟩
      rw [RingHom.mem_ker.mp hj, map_zero]

  have hstar : ∀ j, MvPolynomial.rename Fin.castSucc (F j) ∈ I' := by
    intro j
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp (hG j)
    have h1 : MvPolynomial.rename Fin.castSucc G * MvPolynomial.rename Fin.castSucc (F j) ∈ I' := by
      rw [← map_mul, ← hc, map_sum]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hfI i)
    have h2 : MvPolynomial.rename Fin.castSucc (F j) =
        MvPolynomial.X (Fin.last (r + 1)) *
          (MvPolynomial.rename Fin.castSucc G * MvPolynomial.rename Fin.castSucc (F j)) -
        (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc G - 1) *
          MvPolynomial.rename Fin.castSucc (F j) := by ring
    rw [h2]
    exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ h1) (Ideal.mul_mem_right _ _ hlast)

  have hν : RingHom.ker p ≤ RingHom.ker ((Ideal.Quotient.mk I').comp ι) := by
    rw [hker, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hstar j
  let θA : Γ(Y, V) →+* MvPolynomial (Fin (r + 1 + 1)) Γ(T, W) ⧸ I' :=
    p.liftOfSurjective hp ⟨(Ideal.Quotient.mk I').comp ι, hν⟩
  have hθA : ∀ h, θA (p h) = Ideal.Quotient.mk I' (MvPolynomial.rename Fin.castSucc h) := fun h =>
    RingHom.liftOfSurjective_comp_apply p hp ⟨(Ideal.Quotient.mk I').comp ι, hν⟩ h

  have hmkinv : Ideal.Quotient.mk I' (MvPolynomial.rename Fin.castSucc G) *
      Ideal.Quotient.mk I' (MvPolynomial.X (Fin.last (r + 1))) = 1 := by
    rw [← map_mul, ← map_one (Ideal.Quotient.mk I'), Ideal.Quotient.mk_eq_mk_iff_sub_mem, mul_comm]
    exact hlast
  have hU : IsUnit (Ideal.Quotient.mk I' (MvPolynomial.rename Fin.castSucc G)) :=
    ⟨⟨_, _, hmkinv, by rw [mul_comm]; exact hmkinv⟩, rfl⟩
  have hunit : IsUnit (θA (p G)) := by rw [hθA]; exact hU
  let θ : Γ(Y, Y.basicOpen (p G)) →+* MvPolynomial (Fin (r + 1 + 1)) Γ(T, W) ⧸ I' :=
    IsLocalization.Away.lift (S := Γ(Y, Y.basicOpen (p G))) (p G) hunit
  have hθ : ∀ a, θ (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G)) a) = θA a := fun a =>
    IsLocalization.Away.lift_eq (p G) hunit a

  have hcomp : θ.comp π' = Ideal.Quotient.mk I' := by
    apply MvPolynomial.ringHom_ext
    · intro b
      rw [RingHom.comp_apply, hπ', MvPolynomial.eval₂Hom_C, F1, hθ, ← hC, hθA,
        MvPolynomial.rename_C]
    · intro i
      induction i using Fin.lastCases with
      | last =>
        rw [RingHom.comp_apply, hπ't]
        apply hU.mul_left_cancel
        have e2 : θ (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen (p G)) (p G)) =
            Ideal.Quotient.mk I' (MvPolynomial.rename Fin.castSucc G) := by
          rw [hθ, hθA]
        rw [hmkinv, ← e2, ← map_mul, hus, map_one]
      | cast j =>
        have hx : (MvPolynomial.X j.castSucc : MvPolynomial (Fin (r + 1 + 1)) Γ(T, W)) =
            MvPolynomial.rename Fin.castSucc (MvPolynomial.X j) := by
          rw [MvPolynomial.rename_X]
        rw [hx, RingHom.comp_apply, L1', hθ, hθA]

  refine ⟨hle', π', Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Γ(T, W))
    (fun i => MvPolynomial.rename Fin.castSucc (F (e i)))
    (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc G - 1), surj,
    fun c => MvPolynomial.eval₂Hom_C _ _ _, le_antisymm ?_ s5⟩
  intro h hh
  rw [RingHom.mem_ker] at hh
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← hcomp, RingHom.comp_apply, hh, map_zero]

theorem wcpa_dj_lcf_sc_fibre_hilbert : ∀ (C P' : Scheme.{u}) (g : C ⟶ P'), wcpaDjSemistable g → IsLocallyNoetherian P' → ∀ (U : P'.Opens) (_ : IsAffineOpen U) (V₀ : C.Opens) (hV₀ : IsAffineOpen V₀) (e : V₀ ≤ g ⁻¹ᵁ U) (m r : ℕ) (p : MvPolynomial (Fin m) Γ(P', U) →+* Γ(C, V₀)) (F : Fin r → MvPolynomial (Fin m) Γ(P', U)), p.comp MvPolynomial.C = (g.appLE U V₀ e).hom → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → ∀ (L : Type u) [Field L] [IsAlgClosed L] (χ : Γ(C, V₀) →+* L), (¬ ∃ W : C.Opens, hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → ∀ n : ℕ, 1 ≤ n → Module.finrank L (MvPolynomial (Fin m) L ⧸ wcpaLquI (fun j => MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j)) (fun l => χ (p (MvPolynomial.X l))) n) = 2 * n - 1 :=
by
  intro C P' g hss hPn U hU V₀ hV₀ e m r p F hpC hpsurj hF L _ _ χ hns n hn
  classical
  haveI : IsLocallyNoetherian P' := hPn
  haveI hgprop : IsProper g := hss.2.1
  haveI hgflat : Flat g := hss.1
  letI alg1 : Algebra Γ(P', U) Γ(C, V₀) := (g.appLE U V₀ e).hom.toAlgebra
  letI alg2 : Algebra Γ(P', U) L := (χ.comp (g.appLE U V₀ e).hom).toAlgebra

  obtain ⟨ι, hιo, hιa, hιf⟩ :=
    wcpa_dj_lqu_sp_fibre_chart C P' g U hU V₀ hV₀ e L (χ.comp (g.appLE U V₀ e).hom)

  obtain ⟨P0, μ, hP0C, hP0s, hP0k, hμP0, hμ1⟩ :=
    wcpa_dj_lqu_sp_pres_basechange Γ(P', U) Γ(C, V₀) m r p F hpC hpsurj hF L χ rfl

  let xT : Spec (.of (TensorProduct Γ(P', U) L Γ(C, V₀))) := ⟨RingHom.ker μ, RingHom.ker_isPrime μ⟩
  have hx : Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE U V₀ e).hom)) ≫
      hU.fromSpec) (ι xT) = hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ := by
    rw [← Scheme.Hom.comp_apply, hιf, Scheme.Hom.comp_apply]
    congr 1
    apply PrimeSpectrum.ext
    ext b
    change μ ((1 : L) ⊗ₜ[Γ(P', U)] b) = 0 ↔ χ b = 0
    rw [hμ1 b]

  have hns' : ¬ ∃ W : (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)).Opens, ι xT ∈ W ∧
      SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom
        (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)) := by
    intro hW
    obtain ⟨W', hW'1, hW'2⟩ := wcpa_dj_bsc_smooth_descend P' C g L _ (ι xT) hgflat inferInstance hW
    exact hns ⟨W', hx ▸ hW'1, hW'2⟩

  obtain ⟨eC, heC⟩ := (hss.2.2 L _ (ι xT)).resolve_left hns'
  haveI : IsLocallyNoetherian (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g _)
  obtain ⟨hd, hs⟩ := wcpa_dj_lqr_completion_bridge L _ eC

  obtain ⟨σ, hσφ, hunit, hfrac, hker⟩ :=
    wcpa_dj_lqu_sp_stalk_loc L (TensorProduct Γ(P', U) L Γ(C, V₀)) _ _ ι hιo hιa xT
  have hρφ : ∀ a : L, (σ.comp P0) (MvPolynomial.C a) =
      ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd g _).appTop ≫
        (Limits.pullback g _).presheaf.germ ⊤ (ι xT) trivial).hom a := by
    intro a
    rw [← hσφ, RingHom.comp_apply, ← RingHom.comp_apply P0, hP0C]
    rfl
  have hP0F : ∀ j, P0 (MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j)) = 0 := by
    intro j
    have hmem : MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j) ∈ RingHom.ker P0 := by
      rw [hP0k]
      exact Ideal.subset_span ⟨j, rfl⟩
    exact hmem
  have hev : ∀ h, MvPolynomial.eval (fun l => χ (p (MvPolynomial.X l))) h = μ (P0 h) := by
    intro h
    rw [← hμP0]
    rfl

  obtain ⟨hdens, hstrict⟩ := wcpa_dj_lqu_sp_trunc_transfer L m r
    (fun j => MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j))
    (fun l => χ (p (MvPolynomial.X l)))
    (fun j => by rw [hev, hP0F j, map_zero])
    _ (σ.comp P0)
    (fun h hh => hunit (P0 h) (fun hmem => hh (by rw [hev]; exact RingHom.mem_ker.mp hmem)))
    (fun j => by rw [RingHom.comp_apply, hP0F j, map_zero])
    (by
      intro y
      obtain ⟨t, s', hs', hy⟩ := hfrac y
      obtain ⟨h, rfl⟩ := hP0s t
      obtain ⟨s0, rfl⟩ := hP0s s'
      refine ⟨h, s0, fun h0 => hs' (RingHom.mem_ker.mpr (by rw [← hev]; exact h0)), hy⟩)
    (by
      intro h hρh
      obtain ⟨s', hs', hs'0⟩ := hker (P0 h) hρh
      obtain ⟨s0, rfl⟩ := hP0s s'
      refine ⟨s0, fun h0 => hs' (RingHom.mem_ker.mpr (by rw [← hev]; exact h0)), ?_⟩
      have hmem : s0 * h ∈ RingHom.ker P0 := RingHom.mem_ker.mpr (by rw [map_mul]; exact hs'0)
      rw [hP0k] at hmem
      exact hmem)

  have h2 := wcpa_dj_lqr_quot_hilb L _ _ (eC.toRingHom.comp (algebraMap _ _))
    (by rw [RingHom.comp_assoc]; exact heC) hd hs n
  have h3 := wcpa_dj_lqr_node_trunc_dim L n hn

  letI algR : Algebra L ((Limits.pullback g (Spec.map (CommRingCat.ofHom
      (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)).presheaf.stalk (ι xT)) :=
    ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd g _).appTop ≫
        (Limits.pullback g _).presheaf.germ ⊤ (ι xT) trivial).hom.toAlgebra
  let ρₐ : MvPolynomial (Fin m) L →ₐ[L] ((Limits.pullback g (Spec.map (CommRingCat.ofHom
      (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)).presheaf.stalk (ι xT)) :=
    { (σ.comp P0) with commutes' := fun a => hρφ a }
  let θ := (Ideal.Quotient.mkₐ L (IsLocalRing.maximalIdeal ((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)).presheaf.stalk
        (ι xT)) ^ n)).comp ρₐ
  have hθ : ∀ h, θ h = Ideal.Quotient.mk _ ((σ.comp P0) h) := fun h => rfl
  have hsurj : Function.Surjective θ := by
    intro q
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨h, hh⟩ := hdens n y
    refine ⟨h, ?_⟩
    rw [hθ, Ideal.Quotient.eq, ← neg_sub]
    exact Submodule.neg_mem _ hh
  have hkerθ : RingHom.ker θ = wcpaLquI
      (fun j => MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j))
      (fun l => χ (p (MvPolynomial.X l))) n := by
    ext h
    rw [RingHom.mem_ker, hθ, Ideal.Quotient.eq_zero_iff_mem]
    exact hstrict n h
  have h1 := LinearEquiv.finrank_eq
    ((Ideal.quotientEquivAlgOfEq L hkerθ.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hsurj)).toLinearEquiv
  exact h1.trans (h2.trans h3)

theorem wcpa_dj_lcf_sc_hilb_gen : ∀ (K : Type u) [Field K] (r s : ℕ) (F : Fin s → MvPolynomial (Fin (r + 1)) K) (c : Fin (r + 1) → K), (∀ j, MvPolynomial.eval c (F j) = 0) → wcpaLquPNT F c → (∀ n : ℕ, 1 ≤ n → Module.finrank K (MvPolynomial (Fin (r + 1)) K ⧸ wcpaLquI F c n) = 2 * n - 1) → ∃ E : Fin r → MvPolynomial (Fin (r + 1)) K, (∀ i, E i ∈ Ideal.span (Set.range F)) ∧ ∀ j, ∃ σ : MvPolynomial (Fin (r + 1)) K, MvPolynomial.eval c σ ≠ 0 ∧ σ * F j ∈ Ideal.span (Set.range E) :=
by
  intro K _ r s F c hF hPNT hHilb
  classical
  obtain ⟨α, β, hPa, hPb, hPc⟩ := hPNT
  set M : Ideal (MvPolynomial (Fin (r + 1)) K) :=
    Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) with hM
  set J : Ideal (MvPolynomial (Fin (r + 1)) K) := Ideal.span (Set.range F) with hJ
  have hPc' : wcpaLquLin c α * wcpaLquLin c β ∈ M ^ 3 ⊔ J := hPc

  let L : (Fin (r + 1) → K) →ₗ[K] MvPolynomial (Fin (r + 1)) K :=
    { toFun := fun w => wcpaLquLin c w
      map_add' := fun v w => by
        simp only [wcpaLquLin, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun a w => by
        simp only [wcpaLquLin, Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply,
          MvPolynomial.smul_eq_C_mul, Finset.mul_sum, mul_assoc] }
  have hLadd : ∀ v w, wcpaLquLin c (v + w) = wcpaLquLin c v + wcpaLquLin c w :=
    fun v w => L.map_add v w
  have hLsmul : ∀ (a : K) w, wcpaLquLin c (a • w) = MvPolynomial.C a * wcpaLquLin c w :=
    fun a w => (L.map_smul a w).trans (MvPolynomial.smul_eq_C_mul _ _)
  have hLzero : wcpaLquLin c 0 = 0 := L.map_zero
  have hLsum : ∀ {ι : Type} [Fintype ι] (f : ι → (Fin (r + 1) → K)),
      wcpaLquLin c (∑ i, f i) = ∑ i, wcpaLquLin c (f i) :=
    fun f => map_sum L f Finset.univ
  have hLmem : ∀ w, wcpaLquLin c w ∈ M := fun w =>
    Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
  have hevM : ∀ y ∈ M, MvPolynomial.eval c y = 0 := by
    intro y hy
    have h : M ≤ RingHom.ker (MvPolynomial.eval c) :=
      Ideal.span_le.mpr (by rintro _ ⟨l, rfl⟩; simp)
    exact h hy
  have hLsingle : ∀ (k : Fin (r + 1)) (a : K), wcpaLquLin c (Pi.single k a) =
      MvPolynomial.C a * (MvPolynomial.X k - MvPolynomial.C (c k)) := by
    intro k a
    unfold wcpaLquLin
    rw [Finset.sum_eq_single k]
    · simp
    · intro b _ hb; simp [Pi.single_apply, hb]
    · intro h; exact absurd (Finset.mem_univ k) h

  have taylor : ∀ h : MvPolynomial (Fin (r + 1)) K, ∃ w : Fin (r + 1) → K,
      h - MvPolynomial.C (MvPolynomial.eval c h) - wcpaLquLin c w ∈ M ^ 2 := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a => exact ⟨0, by simp [hLzero]⟩
    | add p q hp hq =>
      obtain ⟨w1, h1⟩ := hp
      obtain ⟨w2, h2⟩ := hq
      refine ⟨w1 + w2, ?_⟩
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) - wcpaLquLin c (w1 + w2) =
          (p - MvPolynomial.C (MvPolynomial.eval c p) - wcpaLquLin c w1) +
          (q - MvPolynomial.C (MvPolynomial.eval c q) - wcpaLquLin c w2) := by
        rw [hLadd, map_add, map_add]; ring
      rw [e]; exact add_mem h1 h2
    | mul_X p k hp =>
      obtain ⟨w, hw⟩ := hp
      refine ⟨c k • w + Pi.single k (MvPolynomial.eval c p), ?_⟩
      have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X k)) -
          wcpaLquLin c (c k • w + Pi.single k (MvPolynomial.eval c p)) =
          wcpaLquLin c w * (MvPolynomial.X k - MvPolynomial.C (c k)) +
          (p - MvPolynomial.C (MvPolynomial.eval c p) - wcpaLquLin c w) * MvPolynomial.X k := by
        rw [hLadd, hLsmul, hLsingle, MvPolynomial.eval_mul, MvPolynomial.eval_X, map_mul]
        ring
      rw [e]
      refine add_mem ?_ (Ideal.mul_mem_right _ _ hw)
      rw [sq]; exact Ideal.mul_mem_mul (hLmem w) (Ideal.subset_span ⟨k, rfl⟩)

  have hlam0 : ∀ j, ∃ w : Fin (r + 1) → K, F j - wcpaLquLin c w ∈ M ^ 2 := fun j => by
    obtain ⟨w, hw⟩ := taylor (F j)
    exact ⟨w, by rwa [hF j, map_zero, sub_zero] at hw⟩
  choose lam hlam using hlam0
  have hFJ : ∀ j, F j ∈ J := fun j => Ideal.subset_span ⟨j, rfl⟩
  have hlamI : ∀ j, wcpaLquLin c (lam j) ∈ M ^ 2 ⊔ J := fun j => by
    have e : wcpaLquLin c (lam j) = F j - (F j - wcpaLquLin c (lam j)) := by ring
    rw [e]; exact sub_mem (Submodule.mem_sup_right (hFJ j)) (Submodule.mem_sup_left (hlam j))

  obtain ⟨κ, ea, hea, hspan, hli⟩ := exists_linearIndependent' K lam
  have : Finite κ := Finite.of_injective ea hea
  letI : Fintype κ := Fintype.ofFinite κ
  let μ : Option (Option κ) → (Fin (r + 1) → K) := fun o =>
    Option.elim o α (fun o' => Option.elim o' β (fun i => lam (ea i)))
  have hμ : LinearIndependent K μ := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    rw [Fintype.sum_option, Fintype.sum_option] at hg
    simp only [μ, Option.elim_none, Option.elim_some] at hg
    have key : MvPolynomial.C (g none) * wcpaLquLin c α + MvPolynomial.C (g (some none)) * wcpaLquLin c β +
        ∑ i, MvPolynomial.C (g (some (some i))) * wcpaLquLin c (lam (ea i)) = 0 := by
      have h1 := congrArg (wcpaLquLin c) hg
      rw [hLadd, hLadd, hLsmul, hLsmul, hLsum, hLzero] at h1
      simp only [hLsmul] at h1
      rw [← h1]; ring
    have hab : g none = 0 ∧ g (some none) = 0 := by
      apply hPb
      have e : MvPolynomial.C (g none) * wcpaLquLin c α + MvPolynomial.C (g (some none)) * wcpaLquLin c β =
          -∑ i, MvPolynomial.C (g (some (some i))) * wcpaLquLin c (lam (ea i)) := by
        rw [eq_neg_iff_add_eq_zero]; exact key
      show _ ∈ M ^ 2 ⊔ J
      rw [e]
      exact neg_mem (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hlamI _))
    have hrest : ∀ i, g (some (some i)) = 0 := by
      rw [hab.1, hab.2, zero_smul, zero_smul, zero_add, zero_add] at hg
      exact Fintype.linearIndependent_iff.mp hli (fun i => g (some (some i))) hg
    intro o
    rcases o with _ | _ | i
    · exact hab.1
    · exact hab.2
    · exact hrest i
  have hcard := hμ.fintype_card_le_finrank
  simp only [Fintype.card_option, Module.finrank_fin_fun] at hcard
  obtain ⟨ι⟩ := Function.Embedding.nonempty_of_card_le
    (show Fintype.card (Option κ) ≤ Fintype.card (Fin r) by
      rw [Fintype.card_option, Fintype.card_fin]; omega)

  obtain ⟨q0, hq0, G, hG, hqG⟩ := Submodule.mem_sup.mp hPc'
  let gE : Option κ → MvPolynomial (Fin (r + 1)) K := fun o => Option.elim o G (fun i => F (ea i))
  let E : Fin r → MvPolynomial (Fin (r + 1)) K := fun i => gE (Function.invFun ι i)
  have hEι : ∀ o, E (ι o) = gE o := fun o => by
    show gE (Function.invFun ι (ι o)) = gE o
    rw [Function.leftInverse_invFun ι.injective o]
  have hEJ : ∀ i, E i ∈ J := by
    intro i
    show gE (Function.invFun ι i) ∈ J
    rcases Function.invFun ι i with _ | k
    · exact hG
    · exact hFJ (ea k)
  set JE : Ideal (MvPolynomial (Fin (r + 1)) K) := Ideal.span (Set.range E) with hJE
  have hGE : G ∈ JE := Ideal.subset_span ⟨ι none, hEι none⟩
  have hFaE : ∀ i, F (ea i) ∈ JE := fun i => Ideal.subset_span ⟨ι (some i), hEι (some i)⟩
  have hJEJ : JE ≤ J := Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hEJ i)

  have hred : ∀ j, F j ∈ M ^ 2 ⊔ JE := by
    intro j
    have hmem : lam j ∈ Submodule.span K (Set.range (lam ∘ ea)) := by
      rw [hspan]; exact Submodule.subset_span ⟨j, rfl⟩
    obtain ⟨g, hg⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hmem
    have hLj : wcpaLquLin c (lam j) = ∑ i, MvPolynomial.C (g i) * wcpaLquLin c (lam (ea i)) := by
      rw [← hg, hLsum]
      simp only [hLsmul, Function.comp]
    have e : F j = (F j - wcpaLquLin c (lam j)) -
        ∑ i, MvPolynomial.C (g i) * (F (ea i) - wcpaLquLin c (lam (ea i))) +
        ∑ i, MvPolynomial.C (g i) * F (ea i) := by
      rw [hLj]; simp only [mul_sub, Finset.sum_sub_distrib]; ring
    rw [e]
    refine add_mem (sub_mem (Submodule.mem_sup_left (hlam j)) (Submodule.mem_sup_left
      (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hlam (ea i))))) (Submodule.mem_sup_right
      (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hFaE i)))
  have hI2 : M ^ 2 ⊔ J ≤ M ^ 2 ⊔ JE :=
    sup_le le_sup_left (Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hred j))
  set uu := wcpaLquLin c α with huu
  set vv := wcpaLquLin c β with hvv
  have hu : uu ∈ M := hLmem α
  have hv : vv ∈ M := hLmem β
  have hcot : ∀ y ∈ M, ∃ a b : K, y - (MvPolynomial.C a * uu + MvPolynomial.C b * vv) ∈ M ^ 2 ⊔ JE := by
    intro y hy
    obtain ⟨w, hw⟩ := taylor y
    rw [hevM y hy, map_zero, sub_zero] at hw
    obtain ⟨a', b', hab⟩ := hPa w
    refine ⟨a', b', ?_⟩
    have e : y - (MvPolynomial.C a' * uu + MvPolynomial.C b' * vv) =
        (y - wcpaLquLin c w) + (wcpaLquLin c w - (MvPolynomial.C a' * uu + MvPolynomial.C b' * vv)) := by
      ring
    rw [e]; exact add_mem (Submodule.mem_sup_left hw) (hI2 hab)
  have huv : uu * vv ∈ M ^ 3 ⊔ JE := by
    rw [← hqG]; exact add_mem (Submodule.mem_sup_left hq0) (Submodule.mem_sup_right hGE)
  have hcl : ∀ (a b : ℕ) (x z : MvPolynomial (Fin (r + 1)) K), x ∈ M ^ a → z ∈ M ^ b ⊔ JE →
      x * z ∈ M ^ (a + b) ⊔ JE := by
    intro a b x z hx hz
    obtain ⟨z1, hz1, z2, hz2, rfl⟩ := Submodule.mem_sup.mp hz
    rw [mul_add]
    refine add_mem (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right (Ideal.mul_mem_left _ _ hz2))
    rw [pow_add]; exact Ideal.mul_mem_mul hx hz1

  have hstep : ∀ d : ℕ, 1 ≤ d → ∀ y ∈ M ^ d, ∃ a b : K,
      y - (MvPolynomial.C a * uu ^ d + MvPolynomial.C b * vv ^ d) ∈ M ^ (d + 1) ⊔ JE := by
    intro d hd
    induction d, hd using Nat.le_induction with
    | base =>
      intro y hy
      rw [pow_one] at hy
      simpa only [pow_one] using hcot y hy
    | succ d hd ih =>
      intro y hy
      obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro p hp q hq
        obtain ⟨a1, b1, h1⟩ := ih p hp
        obtain ⟨a2, b2, h2⟩ := hcot q hq
        refine ⟨a1 * a2, b1 * b2, ?_⟩
        have e : p * q - (MvPolynomial.C (a1 * a2) * uu ^ (d' + 1 + 1) +
            MvPolynomial.C (b1 * b2) * vv ^ (d' + 1 + 1)) =
            MvPolynomial.C (a1 * b2) * uu ^ d' * (uu * vv) +
            MvPolynomial.C (b1 * a2) * vv ^ d' * (uu * vv) +
            (MvPolynomial.C a1 * uu ^ (d' + 1) + MvPolynomial.C b1 * vv ^ (d' + 1)) *
              (q - (MvPolynomial.C a2 * uu + MvPolynomial.C b2 * vv)) +
            (p - (MvPolynomial.C a1 * uu ^ (d' + 1) + MvPolynomial.C b1 * vv ^ (d' + 1))) * q := by
          simp only [map_mul]; ring
        rw [e]
        refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
        · have h := hcl d' 3 _ _ (Ideal.mul_mem_left _ (MvPolynomial.C (a1 * b2)) (Ideal.pow_mem_pow hu d')) huv
          rwa [show d' + 3 = d' + 1 + 1 + 1 by ring] at h
        · have h := hcl d' 3 _ _ (Ideal.mul_mem_left _ (MvPolynomial.C (b1 * a2)) (Ideal.pow_mem_pow hv d')) huv
          rwa [show d' + 3 = d' + 1 + 1 + 1 by ring] at h
        · have hx : MvPolynomial.C a1 * uu ^ (d' + 1) + MvPolynomial.C b1 * vv ^ (d' + 1) ∈ M ^ (d' + 1) :=
            add_mem (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hu _))
              (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hv _))
          have h := hcl (d' + 1) 2 _ _ hx h2
          rwa [show d' + 1 + 2 = d' + 1 + 1 + 1 by ring] at h
        · have h := hcl 1 (d' + 1 + 1) q _ (by rwa [pow_one]) h1
          rw [mul_comm]
          rwa [show 1 + (d' + 1 + 1) = d' + 1 + 1 + 1 by ring] at h
      · rintro x y ⟨a1, b1, h1⟩ ⟨a2, b2, h2⟩
        refine ⟨a1 + a2, b1 + b2, ?_⟩
        have e : x + y - (MvPolynomial.C (a1 + a2) * uu ^ (d' + 1 + 1) +
            MvPolynomial.C (b1 + b2) * vv ^ (d' + 1 + 1)) =
            (x - (MvPolynomial.C a1 * uu ^ (d' + 1 + 1) + MvPolynomial.C b1 * vv ^ (d' + 1 + 1))) +
            (y - (MvPolynomial.C a2 * uu ^ (d' + 1 + 1) + MvPolynomial.C b2 * vv ^ (d' + 1 + 1))) := by
          rw [map_add, map_add]; ring
        rw [e]; exact add_mem h1 h2

  have hcmp : ∀ n : ℕ, 1 ≤ n → wcpaLquI F c n ≤ M ^ n ⊔ JE := by
    intro n hn
    set Q : Ideal (MvPolynomial (Fin (r + 1)) K) := M ^ n ⊔ JE with hQ
    let T : Finset (MvPolynomial (Fin (r + 1)) K) :=
      insert 1 ((Finset.range (n - 1)).image (fun i => uu ^ (i + 1)) ∪
        (Finset.range (n - 1)).image (fun i => vv ^ (i + 1)))
    have hTcard : T.card ≤ 2 * n - 1 := by
      refine (Finset.card_insert_le _ _).trans ?_
      have h1 := Finset.card_union_le ((Finset.range (n - 1)).image (fun i => uu ^ (i + 1)))
        ((Finset.range (n - 1)).image (fun i => vv ^ (i + 1)))
      have h2 := (Finset.card_image_le (s := Finset.range (n - 1)) (f := fun i => uu ^ (i + 1)))
      have h3 := (Finset.card_image_le (s := Finset.range (n - 1)) (f := fun i => vv ^ (i + 1)))
      rw [Finset.card_range] at h2 h3
      omega
    set S : Submodule K (MvPolynomial (Fin (r + 1)) K) := Submodule.span K (T : Set _) with hS
    have h1S : (1 : MvPolynomial (Fin (r + 1)) K) ∈ S := Submodule.subset_span (Finset.mem_insert_self _ _)
    have huS : ∀ d, 1 ≤ d → d < n → ∀ a : K, MvPolynomial.C a * uu ^ d ∈ S := by
      intro d hd1 hdn a
      rw [← MvPolynomial.smul_eq_C_mul]
      refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
      refine Finset.mem_insert_of_mem (Finset.mem_union_left _ (Finset.mem_image.mpr ⟨d - 1, ?_, ?_⟩))
      · rw [Finset.mem_range]; omega
      · show uu ^ (d - 1 + 1) = uu ^ d
        rw [Nat.sub_add_cancel hd1]
    have hvS : ∀ d, 1 ≤ d → d < n → ∀ a : K, MvPolynomial.C a * vv ^ d ∈ S := by
      intro d hd1 hdn a
      rw [← MvPolynomial.smul_eq_C_mul]
      refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
      refine Finset.mem_insert_of_mem (Finset.mem_union_right _ (Finset.mem_image.mpr ⟨d - 1, ?_, ?_⟩))
      · rw [Finset.mem_range]; omega
      · show vv ^ (d - 1 + 1) = vv ^ d
        rw [Nat.sub_add_cancel hd1]
    have hdown : ∀ k, k ≤ n → ∀ y ∈ M ^ (n - k), ∃ t ∈ S, y - t ∈ Q := by
      intro k
      induction k with
      | zero =>
        intro _ y hy
        exact ⟨0, S.zero_mem, by rw [sub_zero]; exact Submodule.mem_sup_left (by simpa using hy)⟩
      | succ k ih =>
        intro hk y hy
        by_cases hd : 1 ≤ n - (k + 1)
        · obtain ⟨a, b, hab⟩ := hstep (n - (k + 1)) hd y hy
          obtain ⟨z1, hz1, z2, hz2, hz⟩ := Submodule.mem_sup.mp hab
          rw [show n - (k + 1) + 1 = n - k by omega] at hz1
          obtain ⟨t1, ht1, hzt⟩ := ih (by omega) z1 hz1
          refine ⟨MvPolynomial.C a * uu ^ (n - (k + 1)) + MvPolynomial.C b * vv ^ (n - (k + 1)) + t1,
            S.add_mem (S.add_mem (huS _ hd (by omega) a) (hvS _ hd (by omega) b)) ht1, ?_⟩
          have e : y - (MvPolynomial.C a * uu ^ (n - (k + 1)) + MvPolynomial.C b * vv ^ (n - (k + 1)) + t1) =
              (z1 - t1) + z2 := by
            linear_combination (-1 : MvPolynomial (Fin (r + 1)) K) * hz
          rw [e]; exact add_mem hzt (Submodule.mem_sup_right hz2)
        · have hnk : n - k = 1 := by omega
          have hy1 : y - MvPolynomial.C (MvPolynomial.eval c y) ∈ M ^ (n - k) := by
            rw [hnk, pow_one]
            obtain ⟨w, hw⟩ := taylor y
            have e : y - MvPolynomial.C (MvPolynomial.eval c y) =
                (y - MvPolynomial.C (MvPolynomial.eval c y) - wcpaLquLin c w) + wcpaLquLin c w := by ring
            rw [e]; exact add_mem (Ideal.pow_le_self two_ne_zero hw) (hLmem w)
          obtain ⟨t1, ht1, hzt⟩ := ih (by omega) _ hy1
          refine ⟨MvPolynomial.C (MvPolynomial.eval c y) + t1, S.add_mem ?_ ht1, ?_⟩
          · rw [← mul_one (MvPolynomial.C _), ← MvPolynomial.smul_eq_C_mul]
            exact S.smul_mem _ h1S
          · have e : y - (MvPolynomial.C (MvPolynomial.eval c y) + t1) =
                y - MvPolynomial.C (MvPolynomial.eval c y) - t1 := by ring
            rw [e]; exact hzt
    have hall : ∀ y, ∃ t ∈ S, y - t ∈ Q := fun y =>
      hdown n le_rfl y (by rw [Nat.sub_self, pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top)
    let π : MvPolynomial (Fin (r + 1)) K →ₗ[K] (MvPolynomial (Fin (r + 1)) K ⧸ Q) :=
      (Ideal.Quotient.mkₐ K Q).toLinearMap
    have hπ : ∀ y, π y = Ideal.Quotient.mk Q y := fun y => rfl
    have hspanQ : Submodule.span K ((T.image π : Finset _) : Set (MvPolynomial (Fin (r + 1)) K ⧸ Q)) = ⊤ := by
      rw [eq_top_iff]
      rintro x -
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨t, ht, hyt⟩ := hall y
      have e : Ideal.Quotient.mk Q y = π t := by
        rw [hπ]; exact Ideal.Quotient.eq.mpr hyt
      rw [e, Finset.coe_image, ← Submodule.map_span]
      exact Submodule.mem_map_of_mem ht
    haveI hfinQ : Module.Finite K (MvPolynomial (Fin (r + 1)) K ⧸ Q) := ⟨⟨T.image π, hspanQ⟩⟩
    have hrkQ : Module.finrank K (MvPolynomial (Fin (r + 1)) K ⧸ Q) ≤ 2 * n - 1 := by
      have h := finrank_span_finset_le_card (R := K) (T.image π)
      unfold Set.finrank at h
      rw [hspanQ, finrank_top] at h
      exact h.trans (Finset.card_image_le.trans hTcard)

    have hQI : Q ≤ wcpaLquI F c n := sup_le_sup_left hJEJ _
    let φ := (Ideal.Quotient.factorₐ K hQI).toLinearMap
    have hφ : ∀ y, φ (Ideal.Quotient.mk Q y) = Ideal.Quotient.mk (wcpaLquI F c n) y := fun y => rfl
    have hφs : Function.Surjective φ := by
      intro x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact ⟨_, hφ y⟩
    haveI : Module.Finite K (MvPolynomial (Fin (r + 1)) K ⧸ wcpaLquI F c n) :=
      Module.Finite.of_surjective φ hφs
    have hrk : Module.finrank K (MvPolynomial (Fin (r + 1)) K ⧸ Q) =
        Module.finrank K (MvPolynomial (Fin (r + 1)) K ⧸ wcpaLquI F c n) := by
      have h1 := LinearMap.finrank_range_le φ
      rw [LinearMap.range_eq_top.mpr hφs, finrank_top] at h1
      rw [hHilb n hn] at h1 ⊢
      omega
    have hφi : Function.Injective φ :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hrk).mpr hφs
    intro x hx
    have h0 : φ (Ideal.Quotient.mk Q x) = φ 0 := by
      rw [hφ, map_zero, Ideal.Quotient.eq_zero_iff_mem]; exact hx
    exact Ideal.Quotient.eq_zero_iff_mem.mp (hφi h0)

  refine ⟨E, hEJ, fun j => ?_⟩
  have hFn : ∀ n : ℕ, F j ∈ M ^ n ⊔ JE := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_sup_left Submodule.mem_top
    · exact hcmp n hn (Submodule.mem_sup_right (hFJ j))
  have hx : (Ideal.Quotient.mk JE (F j)) ∈
      ⨅ i, M ^ i • (⊤ : Submodule (MvPolynomial (Fin (r + 1)) K) (MvPolynomial (Fin (r + 1)) K ⧸ JE)) := by
    rw [Submodule.mem_iInf]
    intro i
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hFn i)
    have e2 : a • Ideal.Quotient.mk JE (1 : MvPolynomial (Fin (r + 1)) K) = Ideal.Quotient.mk JE a := by
      first
      | (rw [← Ideal.Quotient.mk_eq_mk, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]; rfl)
      | rfl
      | simp [Algebra.smul_def]
    have e : Ideal.Quotient.mk JE (F j) = a • Ideal.Quotient.mk JE 1 := by
      rw [e2]
      exact Ideal.Quotient.eq.mpr (by rw [← hab, add_sub_cancel_left]; exact hb)
    rw [e]
    exact Submodule.smul_mem_smul ha Submodule.mem_top
  obtain ⟨⟨r0, hr0⟩, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff M _).mp hx
  refine ⟨1 - r0, ?_, ?_⟩
  · rw [map_sub, map_one, hevM r0 hr0, sub_zero]; exact one_ne_zero
  · have h1 : Ideal.Quotient.mk JE (r0 * F j) = Ideal.Quotient.mk JE (F j) := by
      rw [map_mul]; exact hr
    have h2 := Ideal.Quotient.eq.mp h1.symm
    have e : (1 - r0) * F j = F j - r0 * F j := by ring
    rw [e]; exact h2

theorem wcpa_dj_lcf_sc_nakayama_subfamily : ∀ (K : Type u) [Field K] (r s : ℕ) (F : Fin s → MvPolynomial (Fin (r + 1)) K) (c : Fin (r + 1) → K) (E : Fin r → MvPolynomial (Fin (r + 1)) K), 0 < s → (∀ i, E i ∈ Ideal.span (Set.range F)) → (∀ j, ∃ σ : MvPolynomial (Fin (r + 1)) K, MvPolynomial.eval c σ ≠ 0 ∧ σ * F j ∈ Ideal.span (Set.range E)) → ∃ e : Fin r → Fin s, ∀ j, ∃ σ : MvPolynomial (Fin (r + 1)) K, MvPolynomial.eval c σ ≠ 0 ∧ σ * F j ∈ Ideal.span (Set.range (F ∘ e)) :=
by
  intro K _ r s F c E hs hE hσ
  classical
  set m : Ideal (MvPolynomial (Fin (r + 1)) K) := RingHom.ker (MvPolynomial.eval c) with hm
  set I : Ideal (MvPolynomial (Fin (r + 1)) K) := Ideal.span (Set.range F) with hI
  set J : Ideal (MvPolynomial (Fin (r + 1)) K) := m * I with hJ
  have hT : ∀ a : MvPolynomial (Fin (r + 1)) K,
      a - MvPolynomial.C (MvPolynomial.eval c a) ∈ m := by
    intro a
    rw [hm, RingHom.mem_ker, map_sub, MvPolynomial.eval_C, sub_self]
  have hsmul : ∀ (k : K) (x : MvPolynomial (Fin (r + 1)) K),
      k • Ideal.Quotient.mk J x = Ideal.Quotient.mk J (MvPolynomial.C k * x) := by
    intro k x
    rw [← MvPolynomial.smul_eq_C_mul]
    have h := map_smul (Ideal.Quotient.mkₐ K J) k x
    simpa only [Ideal.Quotient.mkₐ_eq_mk] using h.symm

  have hv : ∀ j, Ideal.Quotient.mk J (F j) ∈
      Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (E i)) := by
    intro j
    obtain ⟨σ, hσc, hσF⟩ := hσ j
    obtain ⟨b, hb⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hσF
    have hkey : MvPolynomial.C (MvPolynomial.eval c σ) * F j
        - ∑ i, MvPolynomial.C (MvPolynomial.eval c (b i)) * E i ∈ J := by
      have h1 : MvPolynomial.C (MvPolynomial.eval c σ) * F j
          - ∑ i, MvPolynomial.C (MvPolynomial.eval c (b i)) * E i
          = -((σ - MvPolynomial.C (MvPolynomial.eval c σ)) * F j)
            + ∑ i, (b i - MvPolynomial.C (MvPolynomial.eval c (b i))) * E i := by
        simp only [sub_mul, Finset.sum_sub_distrib, hb]
        ring
      rw [h1]
      refine J.add_mem (J.neg_mem ?_) (J.sum_mem fun i _ => ?_)
      · exact Ideal.mul_mem_mul (hT σ) (Ideal.subset_span ⟨j, rfl⟩)
      · exact Ideal.mul_mem_mul (hT (b i)) (hE i)
    have h2 : (MvPolynomial.eval c σ) • Ideal.Quotient.mk J (F j)
        = ∑ i, (MvPolynomial.eval c (b i)) • Ideal.Quotient.mk J (E i) := by
      simp only [hsmul, ← map_sum]
      exact Ideal.Quotient.eq.mpr hkey
    have h3 : Ideal.Quotient.mk J (F j)
        = ∑ i, ((MvPolynomial.eval c σ)⁻¹ * MvPolynomial.eval c (b i)) •
            Ideal.Quotient.mk J (E i) := by
      rw [← inv_smul_smul₀ hσc (Ideal.Quotient.mk J (F j)), h2, Finset.smul_sum]
      simp only [smul_smul]
    rw [h3]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

  obtain ⟨e, he⟩ : ∃ e : Fin r → Fin s, ∀ j, Ideal.Quotient.mk J (F j) ∈
      Submodule.span K (Set.range (fun i => Ideal.Quotient.mk J (F (e i)))) := by
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' K (fun j => Ideal.Quotient.mk J (F j))
    have : Finite κ := Finite.of_injective a ha
    haveI : Fintype κ := Fintype.ofFinite κ
    have hle : Submodule.span K (Set.range (fun j => Ideal.Quotient.mk J (F j))) ≤
        Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (E i)) :=
      Submodule.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hv j)
    have : FiniteDimensional K (Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (E i))) :=
      FiniteDimensional.span_of_finite K (Set.finite_range _)
    have hcard : Fintype.card κ ≤ Fintype.card (Fin r) := by
      rw [← finrank_span_eq_card hli, hspan]
      calc _ ≤ Module.finrank K (Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (E i))) :=
            Submodule.finrank_mono hle
        _ ≤ _ := finrank_range_le_card (fun i => Ideal.Quotient.mk J (E i))
    obtain ⟨ι⟩ := Function.Embedding.nonempty_of_card_le hcard
    refine ⟨Function.extend ι a (fun _ => ⟨0, hs⟩), fun j => ?_⟩
    have h1 : Submodule.span K (Set.range ((fun j => Ideal.Quotient.mk J (F j)) ∘ a)) ≤
        Submodule.span K (Set.range (fun i =>
          Ideal.Quotient.mk J (F (Function.extend ι a (fun _ => ⟨0, hs⟩) i)))) := by
      apply Submodule.span_mono
      rintro _ ⟨k, rfl⟩
      exact ⟨ι k, by simp only [Function.comp_apply, ι.injective.extend_apply]⟩
    exact h1 (hspan ▸ Submodule.subset_span ⟨j, rfl⟩)

  set N : Ideal (MvPolynomial (Fin (r + 1)) K) := Ideal.span (Set.range (F ∘ e)) with hN
  have hFN : ∀ j, F j ∈ N ⊔ J := by
    intro j
    obtain ⟨k, hk⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp (he j)
    simp only [hsmul, ← map_sum] at hk
    have hdiff : F j - ∑ i, MvPolynomial.C (k i) * F (e i) ∈ J := Ideal.Quotient.eq.mp hk.symm
    have hsN : ∑ i, MvPolynomial.C (k i) * F (e i) ∈ N :=
      N.sum_mem fun i _ => N.mul_mem_left _ (Ideal.subset_span ⟨i, rfl⟩)
    have := Submodule.add_mem_sup hsN hdiff
    simpa using this

  obtain ⟨σ₀, hσ₀1, hσ₀le⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
    (I := m) (N := N) (N' := I) (P := I) (Submodule.fg_span (Set.finite_range F)) le_rfl (by
      rw [Ideal.smul_eq_mul]
      exact Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hFN j))
  refine ⟨e, fun j => ⟨σ₀, ?_, ?_⟩⟩
  · have h := RingHom.mem_ker.mp hσ₀1
    rw [map_sub, map_one, sub_eq_zero] at h
    rw [h]
    exact one_ne_zero
  · exact hσ₀le (Submodule.smul_mem_pointwise_smul _ _ _ (Ideal.subset_span ⟨j, rfl⟩))

theorem wcpa_dj_lcf_sc_flat_lift : ∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [CommRing B] [Algebra R B] [Module.Flat R B] (r s : ℕ) (p : MvPolynomial (Fin (r + 1)) R →+* B) (F : Fin s → MvPolynomial (Fin (r + 1)) R) (e : Fin r → Fin s), p.comp MvPolynomial.C = algebraMap R B → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → ∀ (L : Type u) [Field L] (χ : B →+* L), (∀ j, ∃ σ : MvPolynomial (Fin (r + 1)) L, MvPolynomial.eval (fun l => χ (p (MvPolynomial.X l))) σ ≠ 0 ∧ σ * MvPolynomial.map (χ.comp (algebraMap R B)) (F j) ∈ Ideal.span (Set.range fun i => MvPolynomial.map (χ.comp (algebraMap R B)) (F (e i)))) → ∃ G : MvPolynomial (Fin (r + 1)) R, χ (p G) ≠ 0 ∧ ∀ j, G * F j ∈ Ideal.span (Set.range (F ∘ e)) :=
by
  intro R B _ _ _ _ _ r s p F e hpC hp hker L _ χ hσ
  classical

  have s1 : ∀ (P M L : Type u) [CommRing P] [AddCommGroup M] [Module P M] [Module.Finite P M]
      [Field L] (φ : P →+* L), (letI := φ.toAlgebra; Subsingleton (TensorProduct P L M)) →
      ∃ G : P, φ G ≠ 0 ∧ ∀ m : M, G • m = 0 := by
    intro P M L _ _ _ _ _ φ h
    letI := φ.toAlgebra
    haveI hQ : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
    let φ' : (RingHom.ker φ).ResidueField →+* L := Ideal.ResidueField.lift (RingHom.ker φ) φ le_rfl
      (fun x hx => (IsUnit.mem_submonoid_iff _).mpr (isUnit_iff_ne_zero.mpr hx))
    letI : Algebra (RingHom.ker φ).ResidueField L := φ'.toAlgebra
    haveI : IsScalarTower P (RingHom.ker φ).ResidueField L := IsScalarTower.of_algebraMap_eq
      (fun x => (Ideal.ResidueField.lift_algebraMap (RingHom.ker φ) φ le_rfl _ x).symm)
    have e := TensorProduct.AlgebraTensorModule.cancelBaseChange P (RingHom.ker φ).ResidueField L L M
    haveI : Subsingleton (TensorProduct (RingHom.ker φ).ResidueField L
        (TensorProduct P (RingHom.ker φ).ResidueField M)) := e.toEquiv.subsingleton
    have h1 : Subsingleton (TensorProduct P (RingHom.ker φ).ResidueField M) :=
      (Module.FaithfullyFlat.subsingleton_tensorProduct_iff_right (RingHom.ker φ).ResidueField L).mp
        inferInstance
    have h2 : (⟨RingHom.ker φ, hQ⟩ : PrimeSpectrum P) ∉ Module.support P M := by
      rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct]
      exact not_nontrivial_iff_subsingleton.mpr h1
    rw [Module.mem_support_iff_of_finite] at h2
    obtain ⟨G, hG, hGQ⟩ := Set.not_subset.mp h2
    exact ⟨G, hGQ, (Module.mem_annihilator).mp hG⟩

  have s2 : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] [Module.Flat R B] (n : ℕ)
      (p : MvPolynomial (Fin n) R →+* B), p.comp MvPolynomial.C = algebraMap R B →
      Function.Surjective p → ∀ (A : Type u) [CommRing A] [Algebra R A],
      Function.Injective (fun t : TensorProduct R A ((RingHom.ker p).restrictScalars R) =>
        MvPolynomial.algebraTensorAlgEquiv R A
          (LinearMap.lTensor A ((RingHom.ker p).restrictScalars R).subtype t)) := by
    intro R B _ _ _ _ n p hpC hp A _ _
    let f : MvPolynomial (Fin n) R →ₗ[R] B :=
      { toFun := p
        map_add' := map_add p
        map_smul' := fun r x => by
          show p (r • x) = r • p x
          rw [MvPolynomial.smul_eq_C_mul, map_mul, Algebra.smul_def, ← RingHom.congr_fun hpC r,
            RingHom.comp_apply] }
    have hinj := LinearMap.lTensor_injective_of_exact_of_flat f hp
      ((RingHom.ker p).restrictScalars R).subtype Subtype.val_injective (fun y => by
        constructor
        · intro hy
          exact ⟨⟨y, RingHom.mem_ker.mpr hy⟩, rfl⟩
        · rintro ⟨x, rfl⟩
          show p x.1 = 0
          exact RingHom.mem_ker.mp x.2) A
    exact (MvPolynomial.algebraTensorAlgEquiv R A).injective.comp hinj

  have s3 : ∀ (R : Type u) [CommRing R] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) (k : ℕ)
      (g : Fin k → MvPolynomial (Fin n) R), (∀ i, g i ∈ I) → ∀ (L : Type u) [Field L] (ψ : R →+* L)
      (c : Fin n → L),
      (letI := ψ.toAlgebra; Function.Injective (fun t : TensorProduct R L (I.restrictScalars R) =>
        MvPolynomial.algebraTensorAlgEquiv R L (LinearMap.lTensor L (I.restrictScalars R).subtype t))) →
      ∀ (q : MvPolynomial (Fin n) R) (hq : q ∈ I) (σ : MvPolynomial (Fin n) L),
      MvPolynomial.eval c σ ≠ 0 →
      σ * MvPolynomial.map ψ q ∈ Ideal.span (Set.range fun i => MvPolynomial.map ψ (g i)) →
      (letI := ((MvPolynomial.eval c).comp (MvPolynomial.map ψ)).toAlgebra;
        (1 : L) ⊗ₜ[MvPolynomial (Fin n) R]
          (Submodule.Quotient.mk (⟨q, hq⟩ : I) :
            ↥I ⧸ Submodule.comap I.subtype (Ideal.span (Set.range g))) = 0) := by
    intro R _ n I k g hg L _ ψ c hinj q hq σ hσ hrel
    letI iR : Algebra R L := ψ.toAlgebra
    letI iP : Algebra (MvPolynomial (Fin n) R) L :=
      ((MvPolynomial.eval c).comp (MvPolynomial.map ψ)).toAlgebra
    let I' := I.restrictScalars R
    let N := ↥I ⧸ Submodule.comap I.subtype (Ideal.span (Set.range g))
    let E := MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) R L
    let j : I' →+ N :=
      { toFun := fun x => Submodule.Quotient.mk (⟨x.1, x.2⟩ : I)
        map_zero' := Submodule.Quotient.mk_zero _
        map_add' := fun x y => by rw [← Submodule.Quotient.mk_add]; rfl }
    have hj : ∀ (r : R) (x : I'), j (r • x) = (MvPolynomial.C r : MvPolynomial (Fin n) R) • j x := by
      intro r x
      show Submodule.Quotient.mk _ = (MvPolynomial.C r : MvPolynomial (Fin n) R) •
        Submodule.Quotient.mk _
      rw [← Submodule.Quotient.mk_smul]
      congr 1
      apply Subtype.ext
      show r • x.1 = MvPolynomial.C r * x.1
      exact MvPolynomial.smul_eq_C_mul _ _
    have hφ : ∀ f : MvPolynomial (Fin n) R,
        algebraMap (MvPolynomial (Fin n) R) L f = MvPolynomial.eval c (MvPolynomial.map ψ f) :=
      fun f => rfl
    let f : L →+ I' →+ TensorProduct (MvPolynomial (Fin n) R) L N :=
      AddMonoidHom.mk' (fun a => AddMonoidHom.mk' (fun x => a ⊗ₜ[MvPolynomial (Fin n) R] j x)
        (fun x y => by rw [map_add, TensorProduct.tmul_add]))
        (fun a b => by
          ext x
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, TensorProduct.add_tmul])
    have hbal : ∀ (r : R) (a : L) (x : I'), f (r • a) x = f a (r • x) := by
      intro r a x
      simp only [f, AddMonoidHom.mk'_apply]
      rw [hj, TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, Algebra.smul_def,
        hφ, MvPolynomial.map_C, MvPolynomial.eval_C]
      rfl
    let Θ := TensorProduct.liftAddHom f hbal
    have hΘ : ∀ (a : L) (x : I'), Θ (a ⊗ₜ[R] x) = a ⊗ₜ[MvPolynomial (Fin n) R] j x := by
      intro a x
      simp only [Θ, TensorProduct.liftAddHom_tmul, f, AddMonoidHom.mk'_apply]
    let mx : ∀ x : MvPolynomial (Fin n) R, x ∈ I → (MvPolynomial (Fin n) R →ₗ[R] I') := fun x hx =>
      { toFun := fun f => ⟨f * x, I.mul_mem_left f hx⟩
        map_add' := fun f g => Subtype.ext (add_mul f g x)
        map_smul' := fun r f => Subtype.ext (smul_mul_assoc r f x) }
    let ιh : TensorProduct R L I' →+ MvPolynomial (Fin n) L :=
      E.toRingEquiv.toAddEquiv.toAddMonoidHom.comp (LinearMap.lTensor L I'.subtype).toAddMonoidHom
    have hinj' : Function.Injective ιh := hinj
    have hTι : ∀ (x : MvPolynomial (Fin n) R) (hx : x ∈ I)
        (u : TensorProduct R L (MvPolynomial (Fin n) R)),
        ιh (LinearMap.lTensor L (mx x hx) u) = E u * MvPolynomial.map ψ x := by
      intro x hx u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | tmul a f =>
        show E (LinearMap.lTensor L I'.subtype (LinearMap.lTensor L (mx x hx) (a ⊗ₜ f))) =
          E (a ⊗ₜ f) * _
        rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul, MvPolynomial.algebraTensorAlgEquiv_tmul,
          MvPolynomial.algebraTensorAlgEquiv_tmul]
        show a • MvPolynomial.map ψ (f * x) = a • MvPolynomial.map ψ f * MvPolynomial.map ψ x
        rw [map_mul, smul_mul_assoc]
      | add u v hu hv => rw [map_add, map_add, hu, hv, map_add, add_mul]
    have hTΘ : ∀ (x : MvPolynomial (Fin n) R) (hx : x ∈ I)
        (u : TensorProduct R L (MvPolynomial (Fin n) R)),
        Θ (LinearMap.lTensor L (mx x hx) u) =
          MvPolynomial.eval c (E u) ⊗ₜ[MvPolynomial (Fin n) R] j ⟨x, hx⟩ := by
      intro x hx u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | tmul a f =>
        rw [LinearMap.lTensor_tmul, hΘ, MvPolynomial.algebraTensorAlgEquiv_tmul]
        have h1 : j (mx x hx f) = f • j ⟨x, hx⟩ := by
          show Submodule.Quotient.mk _ = f • Submodule.Quotient.mk _
          rw [← Submodule.Quotient.mk_smul]
          rfl
        rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def, hφ]
        congr 1
        show MvPolynomial.eval c (MvPolynomial.map ψ f) * a =
          MvPolynomial.eval c (a • MvPolynomial.map ψ f)
        rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.eval_C, mul_comm]
      | add u v hu hv => rw [map_add, map_add, hu, hv, map_add, map_add, TensorProduct.add_tmul]
    obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hrel
    let T : ∀ x : MvPolynomial (Fin n) R, x ∈ I → MvPolynomial (Fin n) L → TensorProduct R L I' :=
      fun x hx τ => LinearMap.lTensor L (mx x hx) (E.symm τ)
    let w := T q hq σ - ∑ i, T (g i) (hg i) (a i)
    have hw : w = 0 := by
      apply hinj'
      rw [map_zero, map_sub, map_sum]
      simp only [T, hTι, AlgEquiv.apply_symm_apply]
      rw [ha, sub_self]
    have hΘw : Θ w = 0 := by rw [hw, map_zero]
    have hgi : ∀ i, j ⟨g i, hg i⟩ = 0 := by
      intro i
      show Submodule.Quotient.mk _ = 0
      rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
      exact Ideal.subset_span ⟨i, rfl⟩
    have hmain : MvPolynomial.eval c σ ⊗ₜ[MvPolynomial (Fin n) R] j ⟨q, hq⟩ = 0 := by
      have := hΘw
      simp only [w, T, map_sub, map_sum, hTΘ, AlgEquiv.apply_symm_apply, hgi,
        TensorProduct.tmul_zero, Finset.sum_const_zero, sub_zero] at this
      exact this
    show (1 : L) ⊗ₜ[MvPolynomial (Fin n) R] j ⟨q, hq⟩ = 0
    rw [← inv_mul_cancel₀ hσ, ← smul_eq_mul, ← TensorProduct.smul_tmul', hmain, smul_zero]

  have s4 : ∀ (P M L : Type u) [CommRing P] [AddCommGroup M] [Module P M] [CommRing L]
      [Algebra P L] (s : ℕ) (m : Fin s → M), Submodule.span P (Set.range m) = ⊤ →
      (∀ j, (1 : L) ⊗ₜ[P] m j = 0) → Subsingleton (TensorProduct P L M) := by
    intro P M L _ _ _ _ _ s m hspan h
    refine subsingleton_of_forall_eq 0 (fun z => ?_)
    induction z using TensorProduct.induction_on with
    | zero => rfl
    | tmul a x =>
      have hx : x ∈ Submodule.span P (Set.range m) := hspan ▸ Submodule.mem_top
      obtain ⟨b, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun P).mp hx
      rw [TensorProduct.tmul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      rw [← TensorProduct.smul_tmul]
      have : (b j • a) ⊗ₜ[P] m j = (b j • a) • ((1 : L) ⊗ₜ[P] m j) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [this, h j, smul_zero]
    | add x y hx hy => rw [hx, hy, add_zero]

  let ψ : R →+* L := χ.comp (algebraMap R B)
  let c : Fin (r + 1) → L := fun l => χ (p (MvPolynomial.X l))
  let φ : MvPolynomial (Fin (r + 1)) R →+* L := (MvPolynomial.eval c).comp (MvPolynomial.map ψ)
  let I := RingHom.ker p
  let M := ↥I ⧸ Submodule.comap I.subtype (Ideal.span (Set.range (F ∘ e)))
  have hFj : ∀ j, F j ∈ I := fun j => by
    show F j ∈ RingHom.ker p
    rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
  have hge : ∀ i, (F ∘ e) i ∈ I := fun i => hFj (e i)
  let m : Fin s → M := fun j => Submodule.Quotient.mk ⟨F j, hFj j⟩
  have hspan : Submodule.span (MvPolynomial (Fin (r + 1)) R) (Set.range m) = ⊤ := by
    rw [eq_top_iff]
    rintro y -
    obtain ⟨⟨x, hx⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    have hx' : x ∈ Ideal.span (Set.range F) := hker ▸ hx
    obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx'
    have hsum : (⟨x, hx⟩ : I) = ∑ j, b j • (⟨F j, hFj j⟩ : I) := by
      apply Subtype.ext
      rw [Submodule.coe_sum]
      simp only [Submodule.coe_smul, smul_eq_mul]
      exact hb.symm
    rw [hsum, ← Submodule.mkQ_apply, map_sum]
    refine Submodule.sum_mem _ (fun j _ => ?_)
    rw [map_smul, Submodule.mkQ_apply]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  have hinj := by
    letI : Algebra R L := ψ.toAlgebra
    exact s2 R B (r + 1) p hpC hp L
  have hdie : ∀ j, (letI := φ.toAlgebra;
      (1 : L) ⊗ₜ[MvPolynomial (Fin (r + 1)) R] m j = 0) := by
    intro j
    obtain ⟨σ, hσ1, hσ2⟩ := hσ j
    exact s3 R (r + 1) I r (F ∘ e) hge L ψ c hinj (F j) (hFj j) σ hσ1 hσ2
  have hsub : (letI := φ.toAlgebra;
      Subsingleton (TensorProduct (MvPolynomial (Fin (r + 1)) R) L M)) := by
    letI := φ.toAlgebra
    exact s4 (MvPolynomial (Fin (r + 1)) R) M L s m hspan hdie
  obtain ⟨G, hG1, hG2⟩ := s1 (MvPolynomial (Fin (r + 1)) R) M L φ hsub
  refine ⟨G, ?_, fun j => ?_⟩
  · have key : χ.comp p = MvPolynomial.eval₂Hom ψ c := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        exact congrArg χ (RingHom.congr_fun hpC a)
      · intro l
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rfl
    have hφG : φ G = χ (p G) := by
      show MvPolynomial.eval c (MvPolynomial.map ψ G) = _
      rw [MvPolynomial.eval_map, ← MvPolynomial.coe_eval₂Hom, ← key]
      rfl
    rw [← hφG]
    exact hG1
  · have h := hG2 (m j)
    simp only [m] at h
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap] at h
    exact h

theorem wcpa_dj_lcf_saj_ass_fibre_minimal : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] [IsNoetherianRing R] [IsNoetherianRing B] [Module.Flat R B], (∀ (𝔮 : Ideal R), 𝔮.IsPrime → ∀ (b : B) (n : ℕ), b ^ n ∈ Ideal.map (algebraMap R B) 𝔮 → ∃ s : R, s ∉ 𝔮 ∧ algebraMap R B s * b ∈ Ideal.map (algebraMap R B) 𝔮) → ∀ (𝔭 : Ideal B) [𝔭.IsPrime] (y : B), (∀ x : B, x ∈ 𝔭 ↔ x * y = 0) → 𝔭 ∈ (Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B))).minimalPrimes :=
by
  intro R B _ _ _ _ _ _ hH 𝔭 _ y hy
  classical
  have h𝔮p : (𝔭.comap (algebraMap R B)).IsPrime := Ideal.comap_isPrime (algebraMap R B) 𝔭

  have hyq : ∀ q ∈ 𝔭.comap (algebraMap R B), q • y = 0 := by
    intro q hq
    rw [Algebra.smul_def]
    exact (hy _).mp hq
  obtain ⟨k, c₀, b₀, hc₀, hy₀⟩ : ∃ (k : ℕ) (c : Fin k → R) (b : Fin k → B),
      (∀ j, ∀ q ∈ 𝔭.comap (algebraMap R B), q * c j = 0) ∧
      y = ∑ j, algebraMap R B (c j) * b j := by
    have hcomp : (LinearMap.toSpanSingleton R B y) ∘ₗ (𝔭.comap (algebraMap R B)).subtype = 0 := by
      ext ⟨q, hq⟩
      simp [hyq q hq]
    obtain ⟨k, a, y', hxy, haf⟩ := Module.Flat.exists_factorization_of_comp_eq_zero_of_free hcomp
    refine ⟨k, fun j => a 1 j, fun j => y' (Finsupp.single j 1), ?_, ?_⟩
    · intro j q hq
      have h1 : a q = 0 := by
        have := LinearMap.congr_fun haf ⟨q, hq⟩
        simpa using this
      have h2 : a q = q • a 1 := by
        rw [← map_smul, smul_eq_mul, mul_one]
      rw [h2] at h1
      have := congrArg (fun g => g j) h1
      simpa using this
    · have h1 : y = y' (a 1) := by
        have := LinearMap.congr_fun hxy 1
        simpa using this
      rw [h1]
      conv_lhs => rw [← Finsupp.univ_sum_single (a 1)]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← Finsupp.smul_single_one, map_smul, Algebra.smul_def]

  have hex : ∃ m : ℕ, ∃ (s : R) (c : Fin m → R) (b : Fin m → B),
      s ∉ 𝔭.comap (algebraMap R B) ∧ (∀ i, ∀ q ∈ 𝔭.comap (algebraMap R B), q * c i = 0) ∧
      algebraMap R B s * y = ∑ i, algebraMap R B (c i) * b i := by
    refine ⟨k, 1, c₀, b₀, ?_, hc₀, ?_⟩
    · intro h
      exact h𝔮p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    · rw [map_one, one_mul]; exact hy₀

  have helim : ∀ (m : ℕ) (s : R) (c : Fin m → R) (b : Fin m → B),
      s ∉ 𝔭.comap (algebraMap R B) → (∀ i, ∀ q ∈ 𝔭.comap (algebraMap R B), q * c i = 0) →
      algebraMap R B s * y = ∑ i, algebraMap R B (c i) * b i →
      ∀ (r : Fin m → R) (i₀ : Fin m), ∑ i, c i * r i = 0 → r i₀ ∉ 𝔭.comap (algebraMap R B) →
      ∃ m' < m, ∃ (s : R) (c : Fin m' → R) (b : Fin m' → B),
        s ∉ 𝔭.comap (algebraMap R B) ∧ (∀ i, ∀ q ∈ 𝔭.comap (algebraMap R B), q * c i = 0) ∧
        algebraMap R B s * y = ∑ i, algebraMap R B (c i) * b i := by
    intro m
    cases m with
    | zero => intro s c b _ _ _ r i₀; exact i₀.elim0
    | succ m =>
      intro s c b hs hc hrep r i₀ hr hri
      refine ⟨m, Nat.lt_succ_self m, r i₀ * s, fun i => c (i₀.succAbove i),
        fun i => algebraMap R B (r i₀) * b (i₀.succAbove i) -
          algebraMap R B (r (i₀.succAbove i)) * b i₀, ?_, fun i => hc _, ?_⟩
      · intro h
        rcases h𝔮p.mem_or_mem h with h | h
        · exact hri h
        · exact hs h
      · have hA : algebraMap R B s * y = algebraMap R B (c i₀) * b i₀ +
            ∑ i, algebraMap R B (c (i₀.succAbove i)) * b (i₀.succAbove i) := by
          rw [hrep, Fin.sum_univ_succAbove _ i₀]
        have hB : c i₀ * r i₀ + ∑ i, c (i₀.succAbove i) * r (i₀.succAbove i) = 0 := by
          rw [← Fin.sum_univ_succAbove (fun i => c i * r i) i₀]; exact hr
        have hB' : algebraMap R B (c i₀) * algebraMap R B (r i₀) +
            ∑ i, algebraMap R B (c (i₀.succAbove i)) * algebraMap R B (r (i₀.succAbove i)) = 0 := by
          have := congrArg (algebraMap R B) hB
          rw [map_add, map_mul, map_sum, map_zero] at this
          simpa only [map_mul] using this
        have hsum : ∑ i, algebraMap R B (c (i₀.succAbove i)) *
            (algebraMap R B (r i₀) * b (i₀.succAbove i) -
              algebraMap R B (r (i₀.succAbove i)) * b i₀) =
            algebraMap R B (r i₀) *
              ∑ i, algebraMap R B (c (i₀.succAbove i)) * b (i₀.succAbove i) -
            b i₀ * ∑ i, algebraMap R B (c (i₀.succAbove i)) * algebraMap R B (r (i₀.succAbove i)) := by
          rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
        rw [hsum, map_mul]
        linear_combination algebraMap R B (r i₀) * hA + b i₀ * hB'
  obtain ⟨s, c, b, hs, hc, hrep⟩ := Nat.find_spec hex

  have hind : ∀ r : Fin (Nat.find hex) → R, ∑ i, c i * r i = 0 →
      ∀ i, r i ∈ 𝔭.comap (algebraMap R B) := by
    intro r hr i
    by_contra hri
    obtain ⟨m', hlt, hm'⟩ := helim _ s c b hs hc hrep r i hr hri
    exact Nat.find_min hex hlt hm'

  have hZ2 : ∀ x ∈ 𝔭, ∀ i, x * b i ∈ Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B)) := by
    intro x hx
    have hxy : x * y = 0 := (hy x).mp hx
    have h0 : ∑ i, c i • (x * b i) = 0 := by
      calc ∑ i, c i • (x * b i) = x * ∑ i, algebraMap R B (c i) * b i := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Algebra.smul_def]; ring
        _ = x * (algebraMap R B s * y) := by rw [hrep]
        _ = algebraMap R B s * (x * y) := by ring
        _ = 0 := by rw [hxy, mul_zero]
    obtain ⟨k', a, v, hw, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := R) (M := B) (f := c) (x := fun i => x * b i) h0
    intro i
    rw [show x * b i = _ from hw i]
    refine Ideal.sum_mem _ fun l _ => ?_
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hind (fun i => a i l) (ha l) i))

  have hann : ∀ i, ∀ u ∈ Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B)),
      algebraMap R B (c i) * u = 0 := by
    intro i u hu
    have hle : Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B)) ≤
        (LinearMap.ker (LinearMap.mulLeft B (algebraMap R B (c i))) : Ideal B) := by
      rw [Ideal.map_le_iff_le_comap]
      intro q hq
      rw [Ideal.mem_comap, LinearMap.mem_ker, LinearMap.mulLeft_apply, ← map_mul, mul_comm,
        hc i q hq, map_zero]
    have := hle hu
    rwa [LinearMap.mem_ker, LinearMap.mulLeft_apply] at this
  have hZ1 : ∃ i, ∀ t : R, t ∉ 𝔭.comap (algebraMap R B) →
      algebraMap R B t * b i ∉ Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B)) := by
    by_contra hne
    push_neg at hne
    choose t ht htI using hne
    have hT : (∏ i, t i) ∉ 𝔭.comap (algebraMap R B) := by
      intro hT
      obtain ⟨i, -, hi⟩ := (Ideal.IsPrime.prod_mem_iff).mp hT
      exact ht i hi
    have hTb : ∀ i, algebraMap R B (∏ i, t i) * b i ∈
        Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B)) := by
      intro i
      rw [← Finset.mul_prod_erase Finset.univ t (Finset.mem_univ i), map_mul,
        mul_comm (algebraMap R B (t i)), mul_assoc]
      exact Ideal.mul_mem_left _ _ (htI i)
    have h0 : algebraMap R B ((∏ i, t i) * s) * y = 0 := by
      rw [map_mul, mul_assoc, hrep, Finset.mul_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [mul_left_comm]
      exact hann i _ (hTb i)
    have hTs : (∏ i, t i) * s ∈ 𝔭.comap (algebraMap R B) := by
      rw [Ideal.mem_comap]
      exact (hy _).mpr h0
    rcases h𝔮p.mem_or_mem hTs with h | h
    · exact hT h
    · exact hs h

  obtain ⟨i, hi⟩ := hZ1
  refine ⟨⟨inferInstance, Ideal.map_comap_le⟩, ?_⟩
  rintro P' ⟨hP', hIP'⟩ hP'le
  intro x hx
  by_contra hxP
  have h1 : x * b i ∈ P' := hIP' (hZ2 x hx i)
  have h2 : b i ∈ P' := (hP'.mem_or_mem h1).resolve_left hxP
  have h3 : b i ^ 2 ∈ Ideal.map (algebraMap R B) (𝔭.comap (algebraMap R B)) := by
    rw [sq]; exact hZ2 _ (hP'le h2) i
  obtain ⟨t, ht, htI⟩ := hH _ h𝔮p (b i) 2 h3
  exact hi t ht htI

theorem wcpa_dj_lcf_saj_fibre_reduced_torsion : ∀ (C P' : Scheme.{u}) (g : C ⟶ P'), wcpaDjSemistable g → ∀ (V : C.Opens) (W : P'.Opens) (hle : V ≤ g ⁻¹ᵁ W), IsAffineOpen V → IsAffineOpen W → ∀ (𝔮 : Ideal Γ(P', W)), 𝔮.IsPrime → ∀ (b : Γ(C, V)) (n : ℕ), b ^ n ∈ Ideal.map (g.appLE W V hle).hom 𝔮 → ∃ s : Γ(P', W), s ∉ 𝔮 ∧ (g.appLE W V hle).hom s * b ∈ Ideal.map (g.appLE W V hle).hom 𝔮 :=
by
  intro C P' g hss V W hle hV hW 𝔮 h𝔮 b n hbn
  haveI := h𝔮
  suffices key : ∀ (K : Type u) [Field K] (ψ : Γ(P', W) →+* K), (∀ q ∈ 𝔮, ψ q = 0) →
      (∀ (D : Type u) [CommRing D] (χ : Γ(P', W) →+* D), (∀ q ∈ 𝔮, χ q = 0) →
        (∀ s, s ∉ 𝔮 → IsUnit (χ s)) → ∃ f : K →+* D, f.comp ψ = χ) →
      ∃ s : Γ(P', W), s ∉ 𝔮 ∧ (g.appLE W V hle).hom s * b ∈ Ideal.map (g.appLE W V hle).hom 𝔮 by
    refine key 𝔮.ResidueField (algebraMap Γ(P', W) 𝔮.ResidueField)
      (fun q hq => Ideal.algebraMap_residueField_eq_zero.mpr hq) ?_
    intro D _ χ h1 h2
    refine ⟨Ideal.ResidueField.lift 𝔮 χ (fun q hq => (RingHom.mem_ker).mpr (h1 q hq))
      (fun s hs => by exact h2 s (by exact hs)), ?_⟩
    apply RingHom.ext
    intro r
    rw [RingHom.comp_apply]
    exact Ideal.ResidueField.lift_algebraMap _ _ _ _ _
  intro K _ ψ hψ0 hU

  obtain ⟨ι, hι, -, -⟩ := wcpa_dj_lqu_sp_fibre_chart C P' g W hW V hV hle K ψ
  haveI := hι
  haveI hred : AlgebraicGeometry.IsReduced
      (Limits.pullback g (Spec.map (CommRingCat.ofHom ψ) ≫ hW.fromSpec)) :=
    wcpa_dj_ldx_semistable_fibre_reduced C P' g hss K _
  have hT := (affine_isReduced_iff _).mp (isReduced_of_isOpenImmersion ι)
  letI := (g.appLE W V hle).hom.toAlgebra
  letI := ψ.toAlgebra
  haveI hTred : _root_.IsReduced (TensorProduct Γ(P', W) K Γ(C, V)) := hT

  have hker : Ideal.map (g.appLE W V hle).hom 𝔮 ≤
      RingHom.ker (Algebra.TensorProduct.includeRight :
        Γ(C, V) →ₐ[Γ(P', W)] TensorProduct Γ(P', W) K Γ(C, V)).toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro q hq
    rw [Ideal.mem_comap, RingHom.mem_ker]
    show (1 : K) ⊗ₜ[Γ(P', W)] ((g.appLE W V hle).hom q) = 0
    have e1 : (g.appLE W V hle).hom q = q • (1 : Γ(C, V)) := by
      rw [Algebra.smul_def, mul_one]; rfl
    have e2 : q • (1 : K) = 0 := by
      rw [Algebra.smul_def, mul_one, RingHom.algebraMap_toAlgebra]; exact hψ0 q hq
    rw [e1, ← TensorProduct.smul_tmul, e2, TensorProduct.zero_tmul]
  have hb0 : (1 : K) ⊗ₜ[Γ(P', W)] b = 0 := by
    have hnil : IsNilpotent ((Algebra.TensorProduct.includeRight :
        Γ(C, V) →ₐ[Γ(P', W)] TensorProduct Γ(P', W) K Γ(C, V)).toRingHom b) := by
      refine ⟨n, ?_⟩
      rw [← map_pow]
      exact (RingHom.mem_ker).mp (hker hbn)
    exact hnil.eq_zero

  set I := Ideal.map (g.appLE W V hle).hom 𝔮 with hI
  let θ : Γ(P', W) →+* Γ(C, V) ⧸ I := (Ideal.Quotient.mk I).comp (g.appLE W V hle).hom
  let M : Submonoid (Γ(C, V) ⧸ I) := Submonoid.map θ 𝔮.primeCompl
  let ℓ : Γ(C, V) ⧸ I →+* Localization M := algebraMap (Γ(C, V) ⧸ I) (Localization M)
  let χ : Γ(P', W) →+* Localization M := ℓ.comp θ
  have h1 : ∀ q ∈ 𝔮, χ q = 0 := by
    intro q hq
    show ℓ (Ideal.Quotient.mk I ((g.appLE W V hle).hom q)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hq), map_zero]
  have h2 : ∀ s, s ∉ 𝔮 → IsUnit (χ s) := by
    intro s hs
    exact IsLocalization.map_units (Localization M) (⟨θ s, Submonoid.mem_map_of_mem θ hs⟩ : M)
  obtain ⟨f, hf⟩ := hU (Localization M) χ h1 h2
  letI : Algebra Γ(P', W) (Localization M) := χ.toAlgebra
  let f' : K →ₐ[Γ(P', W)] Localization M :=
    { f with
      commutes' := fun r => by
        show f (algebraMap Γ(P', W) K r) = χ r
        rw [RingHom.algebraMap_toAlgebra]
        exact RingHom.congr_fun hf r }
  let g' : Γ(C, V) →ₐ[Γ(P', W)] Localization M :=
    { ℓ.comp (Ideal.Quotient.mk I) with
      commutes' := fun r => rfl }
  have hΛ := congrArg (Algebra.TensorProduct.productMap f' g') hb0
  rw [Algebra.TensorProduct.productMap_apply_tmul, map_zero, map_one, one_mul] at hΛ
  have hΛ' : algebraMap (Γ(C, V) ⧸ I) (Localization M) (Ideal.Quotient.mk I b) = 0 := hΛ
  obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff M (Localization M) _).mp hΛ'
  obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hm
  refine ⟨s, hs, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
  exact hm0

theorem wcpa_dj_lcf_saj_jacobian_rank : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* B) (f : Fin r → MvPolynomial (Fin (r + 1)) R), Function.Surjective π → (∀ c, π (MvPolynomial.C c) = algebraMap R B c) → RingHom.ker π = Ideal.span (Set.range f) → ∀ (𝔭 : Ideal B) [𝔭.IsPrime], Module.finrank 𝔭.ResidueField (TensorProduct B 𝔭.ResidueField Ω[B⁄R]) ≤ 1 → ∃ j, π (wcpaDjJacMinor f j) ∉ 𝔭 :=
by
  have s4 : ∀ (K : Type u) [Field K] (r : ℕ) (M : Matrix (Fin r) (Fin (r + 1)) K), r ≤ Module.finrank K (Submodule.span K (Set.range M)) → ∃ j : Fin (r + 1), (M.submatrix id j.succAbove).det ≠ 0 := by
    intro K _ r M h
    classical
    have hle : Module.finrank K (Submodule.span K (Set.range M)) ≤ r := by
      have := finrank_range_le_card (R := K) M
      simpa [Set.finrank] using this
    have heq : Fintype.card (Fin r) = Set.finrank K (Set.range M) := by
      simp only [Fintype.card_fin, Set.finrank]; omega
    have hli : LinearIndependent K M := linearIndependent_iff_card_eq_finrank_span.mpr heq
    have hex : ∃ j : Fin (r+1), Pi.single j (1:K) ∉ Submodule.span K (Set.range M) := by
      by_contra hcon
      push_neg at hcon
      have htop : Submodule.span K (Set.range M) = ⊤ := by
        rw [eq_top_iff, ← (Pi.basisFun K (Fin (r+1))).span_eq, Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        rw [Pi.basisFun_apply]
        exact hcon j
      have := congrArg (fun S : Submodule K (Fin (r+1) → K) => Module.finrank K S) htop
      simp only [finrank_top, Module.finrank_fin_fun] at this
      omega
    obtain ⟨j, hj⟩ := hex
    let N : Matrix (Fin (r+1)) (Fin (r+1)) K :=
      Matrix.of (Fin.cons (α := fun _ => Fin (r+1) → K) (Pi.single j 1) M)
    have hN : LinearIndependent K N.row := by
      simp only [N, Matrix.of_row]
      exact linearIndependent_finCons.mpr ⟨hli, hj⟩
    have hdet : N.det ≠ 0 :=
      ((Matrix.isUnit_iff_isUnit_det N).mp (Matrix.linearIndependent_rows_iff_isUnit.mp hN)).ne_zero
    rw [Matrix.det_succ_row_zero, Finset.sum_eq_single j] at hdet
    · refine ⟨j, fun h0 => hdet ?_⟩
      have : N.submatrix Fin.succ j.succAbove = M.submatrix id j.succAbove := by
        ext a b; rfl
      rw [this, h0, mul_zero]
    · intro k _ hk
      have hN0 : N 0 k = 0 := by
        show (Pi.single j (1:K) : Fin (r+1) → K) k = 0
        simp [Pi.single_apply, hk]
      rw [hN0, mul_zero, zero_mul]
    · simp
  have s2 : ∀ (B κ M : Type u) [CommRing B] [Field κ] [Algebra B κ] [AddCommGroup M] [Module B M] (n : ℕ) (ω : Fin n → M), Submodule.span B (Set.range ω) = ⊤ → ∀ S : Submodule κ (Fin n → κ), (∀ v : Fin n → κ, ∑ l, v l • ((1 : κ) ⊗ₜ[B] ω l) = 0 → v ∈ S) → n ≤ Module.finrank κ (TensorProduct B κ M) + Module.finrank κ S := by
    intro B κ M _ _ _ _ _ n ω hspan S hS
    classical
    let Φ : (Fin n → κ) →ₗ[κ] TensorProduct B κ M :=
      Fintype.linearCombination κ (fun l => (1:κ) ⊗ₜ[B] ω l)
    have hΦ : Function.Surjective Φ := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, eq_top_iff]
      intro z hz
      clear hz
      induction z using TensorProduct.induction_on with
      | zero => exact Submodule.zero_mem _
      | tmul k m =>
        have hm : m ∈ Submodule.span B (Set.range ω) := hspan ▸ Submodule.mem_top
        obtain ⟨b, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hm
        rw [TensorProduct.tmul_sum]
        refine Submodule.sum_mem _ fun l _ => ?_
        have : k ⊗ₜ[B] (b l • ω l) = (b l • k) • ((1:κ) ⊗ₜ[B] ω l) := by
          rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', TensorProduct.smul_tmul',
            smul_eq_mul, mul_one]
        rw [this]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
      | add x y hx hy => exact Submodule.add_mem _ hx hy
    haveI : Module.Finite κ (TensorProduct B κ M) := Module.Finite.of_surjective Φ hΦ
    have h1 := LinearMap.finrank_range_add_finrank_ker Φ
    rw [LinearMap.range_eq_top.mpr hΦ, finrank_top, Module.finrank_fin_fun] at h1
    have h2 : Module.finrank κ (LinearMap.ker Φ) ≤ Module.finrank κ S := by
      apply Submodule.finrank_mono
      intro v hv
      apply hS
      rw [LinearMap.mem_ker, Fintype.linearCombination_apply] at hv
      exact hv
    omega
  have s3 : ∀ (B κ M : Type u) [CommRing B] [Field κ] [Algebra B κ] [AddCommGroup M] [Module B M] (m n : ℕ) (ω : Fin n → M) (A : Matrix (Fin m) (Fin n) B), Submodule.span B (Set.range ω) = ⊤ → (∀ i, ∑ l, A i l • ω l = 0) → (∀ w : Fin n → B, ∑ l, w l • ω l = 0 → ∃ c : Fin m → B, ∀ l, w l = ∑ i, c i * A i l) → ∀ v : Fin n → κ, ∑ l, v l • ((1 : κ) ⊗ₜ[B] ω l) = 0 → v ∈ Submodule.span κ (Set.range (A.map (algebraMap B κ))) := by
    intro B κ M _ _ _ _ _ m n ω A hspan hrel hker v hv
    classical
    let F : (Fin m → B) →ₗ[B] (Fin n → B) := Matrix.vecMulLinear A
    let G : (Fin n → B) →ₗ[B] M := Fintype.linearCombination B ω
    have hG : Function.Surjective G := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hspan]
    have hex : Function.Exact F G := by
      rw [LinearMap.exact_iff]
      apply le_antisymm
      · intro w hw
        rw [LinearMap.mem_ker, Fintype.linearCombination_apply] at hw
        obtain ⟨c, hc⟩ := hker w hw
        refine ⟨c, ?_⟩
        ext l
        simp [F, Matrix.vecMul, dotProduct, hc l]
      · rintro _ ⟨c, rfl⟩
        rw [LinearMap.mem_ker, Fintype.linearCombination_apply]
        simp only [F, Matrix.vecMulLinear_apply, Matrix.vecMul, dotProduct]
        simp_rw [Finset.sum_smul, mul_smul]
        rw [Finset.sum_comm]
        simp_rw [← Finset.smul_sum, hrel, smul_zero, Finset.sum_const_zero]
    have hex' := lTensor_exact κ hex hG
    let t : TensorProduct B κ (Fin n → B) := ∑ l, v l ⊗ₜ[B] Pi.single l (1:B)
    have ht : LinearMap.lTensor κ G t = 0 := by
      simp only [t, map_sum, LinearMap.lTensor_tmul]
      rw [← hv]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      congr 1
      simp [G, Fintype.linearCombination_apply, Pi.single_apply]
    obtain ⟨y, hy⟩ := (hex' t).mp ht
    let θ := TensorProduct.piScalarRightHom B κ κ (Fin n)
    have hθt : θ t = v := by
      ext j
      simp [θ, t, TensorProduct.piScalarRightHom_tmul, Pi.single_apply]
    have key : ∀ y, θ (LinearMap.lTensor κ F y) ∈
        Submodule.span κ (Set.range (A.map (algebraMap B κ))) := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul x c =>
        rw [LinearMap.lTensor_tmul]
        have : θ (x ⊗ₜ[B] F c) = ∑ i, (algebraMap B κ (c i) * x) • (A.map (algebraMap B κ)) i := by
          ext l
          rw [Finset.sum_apply]
          simp only [θ, TensorProduct.piScalarRightHom_tmul, F, Matrix.vecMulLinear_apply,
            Matrix.vecMul, dotProduct, Pi.smul_apply, Matrix.map_apply, smul_eq_mul]
          rw [Algebra.smul_def, map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul]; ring
        rw [this]
        exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
      | add a b ha hb => rw [map_add, map_add]; exact Submodule.add_mem _ ha hb
    rw [← hθt, ← hy]
    exact key y
  intro R B _ _ _ r π f hsurj hC hker 𝔭 _ hrk
  classical
  let p : MvPolynomial (Fin (r + 1)) R →ₐ[R] B :=
    { π with commutes' := fun c => by rw [MvPolynomial.algebraMap_eq]; exact hC c }
  have hp : Function.Surjective p := hsurj

  have P1 : ∀ P : MvPolynomial (Fin (r + 1)) R, KaehlerDifferential.D R B (p P) =
      ∑ j, p (MvPolynomial.pderiv j P) • KaehlerDifferential.D R B (p (MvPolynomial.X j)) := by
    intro P
    induction P using MvPolynomial.induction_on
    next a =>
      have h1 : p (MvPolynomial.C a) = algebraMap R B a := by
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      simp [h1]
    next P Q hP hQ =>
      simp only [map_add, hP, hQ, add_smul, Finset.sum_add_distrib]
    next Q i hQ =>
      rw [map_mul, Derivation.leibniz, hQ]
      simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, map_mul, add_smul,
        Finset.sum_add_distrib]
      rw [add_comm]
      congr 1
      · rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [smul_smul, mul_comm]
      · simp [Pi.single_apply, apply_ite]

  have P2 : ∀ w : Fin (r + 1) → B,
      ∑ j, w j • KaehlerDifferential.D R B (p (MvPolynomial.X j)) = 0 →
      ∃ g ∈ RingHom.ker p, ∀ j, w j = p (MvPolynomial.pderiv j g) := by
    intro w hw
    letI : Algebra (MvPolynomial (Fin (r + 1)) R) B := p.toRingHom.toAlgebra
    haveI : IsScalarTower R (MvPolynomial (Fin (r + 1)) R) B :=
      IsScalarTower.of_algebraMap_eq (fun r => (p.commutes r).symm)
    have hp' : Function.Surjective (algebraMap (MvPolynomial (Fin (r + 1)) R) B) := hp
    have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R
      (MvPolynomial (Fin (r + 1)) R) B hp'
    have hξ0 : KaehlerDifferential.mapBaseChange R (MvPolynomial (Fin (r + 1)) R) B
        (∑ j, w j • Algebra.TensorProduct.basis B
          (KaehlerDifferential.mvPolynomialBasis R (Fin (r + 1))) j) = 0 := by
      rw [map_sum]
      simp only [map_smul, Algebra.TensorProduct.basis_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.mvPolynomialBasis_apply, KaehlerDifferential.map_D]
      exact hw
    obtain ⟨z, hz⟩ := (hex _).mp hξ0
    obtain ⟨⟨g, hg⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hz
    refine ⟨g, RingHom.mem_ker.mpr (RingHom.mem_ker.mp hg), fun j => ?_⟩
    have h2 := congrFun ((Algebra.TensorProduct.basis B
      (KaehlerDifferential.mvPolynomialBasis R (Fin (r + 1)))).repr_sum_self w) j
    rw [← hz, Algebra.TensorProduct.basis_repr_tmul, Finsupp.smul_apply, one_smul,
      Finsupp.mapRange_apply, KaehlerDifferential.mvPolynomialBasis_repr_apply] at h2
    exact h2.symm
  have P1' : ∀ P : MvPolynomial (Fin (r + 1)) R, KaehlerDifferential.D R B (π P) =
      ∑ j, π (MvPolynomial.pderiv j P) • KaehlerDifferential.D R B (π (MvPolynomial.X j)) := P1
  have hfi : ∀ i, π (f i) = 0 := fun i => by
    rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span ⟨i, rfl⟩
  set ω : Fin (r + 1) → Ω[B⁄R] := fun l => KaehlerDifferential.D R B (π (MvPolynomial.X l)) with hω
  let A : Matrix (Fin r) (Fin (r + 1)) B := Matrix.of fun i l => π (MvPolynomial.pderiv l (f i))
  have hspan : Submodule.span B (Set.range ω) = ⊤ := by
    rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation R B, Submodule.span_le]
    rintro _ ⟨b, rfl⟩
    obtain ⟨P, rfl⟩ := hsurj b
    rw [SetLike.mem_coe, P1' P]
    exact Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
  have hrel : ∀ i, ∑ l, A i l • ω l = 0 := by
    intro i
    have := P1' (f i)
    rw [hfi i, map_zero] at this
    exact this.symm
  have hker' : ∀ w : Fin (r + 1) → B, ∑ l, w l • ω l = 0 →
      ∃ c : Fin r → B, ∀ l, w l = ∑ i, c i * A i l := by
    intro w hw
    obtain ⟨g, hg, hwg⟩ := P2 w hw
    have hg' : g ∈ RingHom.ker π := RingHom.mem_ker.mpr (RingHom.mem_ker.mp hg)
    rw [hker] at hg'
    obtain ⟨h, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hg'
    refine ⟨fun i => π (h i), fun l => ?_⟩
    rw [hwg l]
    show π (MvPolynomial.pderiv l (∑ i, h i * f i)) = _
    simp only [map_sum, MvPolynomial.pderiv_mul, map_add, map_mul, hfi, mul_zero, zero_add]
    rfl
  have h3 := s3 B 𝔭.ResidueField Ω[B⁄R] r (r + 1) ω A hspan hrel hker'
  have h2 := s2 B 𝔭.ResidueField Ω[B⁄R] (r + 1) ω hspan _ h3
  have hS : r ≤ Module.finrank 𝔭.ResidueField
      (Submodule.span 𝔭.ResidueField (Set.range (A.map (algebraMap B 𝔭.ResidueField)))) := by
    omega
  obtain ⟨j, hj⟩ := s4 𝔭.ResidueField r _ hS
  refine ⟨j, fun hmem => hj ?_⟩
  have h0 : algebraMap B 𝔭.ResidueField (π (wcpaDjJacMinor f j)) = 0 :=
    Ideal.algebraMap_residueField_eq_zero.mpr hmem
  unfold wcpaDjJacMinor at h0
  rw [map_mul, map_mul, RingHom.map_det, RingHom.map_det] at h0
  have hu : algebraMap B 𝔭.ResidueField (π ((-1) ^ (j : ℕ))) ≠ 0 := by simp
  have h4 := (mul_eq_zero.mp h0).resolve_left hu
  convert h4 using 2
  ext a b
  rfl

theorem wcpa_dj_lcf_saj_smooth_kaehler : ∀ (C P' : Scheme.{u}) (g : C ⟶ P') (V : C.Opens) (W : P'.Opens) (hle : V ≤ g ⁻¹ᵁ W) (hV : IsAffineOpen V), IsAffineOpen W → ∀ 𝔭 : PrimeSpectrum Γ(C, V), (∃ W' : C.Opens, hV.fromSpec 𝔭 ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g)) → letI := (g.appLE W V hle).hom.toAlgebra; Module.finrank 𝔭.asIdeal.ResidueField (TensorProduct Γ(C, V) 𝔭.asIdeal.ResidueField Ω[Γ(C, V)⁄Γ(P', W)]) ≤ 1 :=
by
  intro C P' g V W hle hV hW 𝔭 hex
  obtain ⟨W', hx, hsm⟩ := hex
  have t_s1 : ∀ (A R A' R' : Type u) [CommRing A] [CommRing R] [CommRing A'] [CommRing R'] (φ : A →+* R) (ψ : A' →+* R') (σA : A →+* A') (σR : R →+* R') (M : Submonoid A) (N : Submonoid R) (_hsq : ψ.comp σA = σR.comp φ) (_hM : letI := σA.toAlgebra; IsLocalization M A') (_hN : letI := σR.toAlgebra; IsLocalization N R'),
      letI := φ.toAlgebra; letI := ψ.toAlgebra; letI := σR.toAlgebra; Nonempty (TensorProduct R R' Ω[R⁄A] ≃ₗ[R'] Ω[R'⁄A']) := by
    intro A R A' R' _ _ _ _ φ ψ σA σR M N hsq hM hN
    letI iAR : Algebra A R := φ.toAlgebra
    letI iAR' : Algebra A' R' := ψ.toAlgebra
    letI iRR' : Algebra R R' := σR.toAlgebra
    letI iAA' : Algebra A A' := σA.toAlgebra
    letI iAR'' : Algebra A R' := (ψ.comp σA).toAlgebra
    haveI : IsScalarTower A A' R' := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    haveI : IsScalarTower A R R' := IsScalarTower.of_algebraMap_eq (fun x => (RingHom.congr_fun hsq x))
    haveI := hM
    haveI := hN
    haveI : Algebra.FormallyEtale R R' := Algebra.FormallyEtale.of_isLocalization N
    haveI : Algebra.FormallyUnramified A A' := Algebra.FormallyUnramified.of_isLocalization M
    have hsurj := KaehlerDifferential.map_surjective A A' R'
    have hex := KaehlerDifferential.exact_mapBaseChange_map A A' R'
    haveI : Subsingleton Ω[A'⁄A] := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    haveI : Subsingleton (TensorProduct A' R' Ω[A'⁄A]) := inferInstance
    have hinj : Function.Injective (KaehlerDifferential.map A A' R' R') := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨y, rfl⟩ := (hex x).mp hx
      have : y = 0 := Subsingleton.elim _ _
      rw [this, map_zero]
    exact ⟨(KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A R R').trans
      (LinearEquiv.ofBijective (KaehlerDifferential.map A A' R' R') ⟨hinj, hsurj⟩)⟩
  have t_s3 : ∀ (X T : Scheme.{u}) (f : X ⟶ T) (n : ℕ) (x : X) [SmoothOfRelativeDimension n f], ∃ (U : T.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U) (_ : x ∈ V), IsAffineOpen U ∧ IsAffineOpen V ∧ (letI := (f.appLE U V e).hom.toAlgebra; Nonempty (Module.Basis (Fin n) Γ(X, V) Ω[Γ(X, V)⁄Γ(T, U)])) := by
    intro X T f n x _
    obtain ⟨U, hU, V, hV, hxV, e, hsm⟩ := SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := f) x
    refine ⟨U, V, e, hxV, hU, hV, ?_⟩
    letI := (f.appLE U V e).hom.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension n Γ(T, U) Γ(X, V) := hsm
    haveI : Nontrivial Γ(X, V) := RingHom.domain_nontrivial (X.presheaf.germ V x hxV).hom
    haveI : Algebra.IsStandardSmooth Γ(T, U) Γ(X, V) := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Module.Free Γ(X, V) Ω[Γ(X, V)⁄Γ(T, U)] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hr := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential (R := Γ(T, U)) (S := Γ(X, V)) n
    haveI : Module.Finite Γ(X, V) Ω[Γ(X, V)⁄Γ(T, U)] := Module.finite_of_rank_eq_nat hr
    exact ⟨Module.finBasisOfFinrankEq _ _ (Module.finrank_eq_of_rank_eq hr)⟩
  have t_s4 : ∀ (X T : Scheme.{u}) (f : X ⟶ T) (U : T.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U) (x : X) (hx : x ∈ V) (_hU : IsAffineOpen U) (_hV : IsAffineOpen V), ∃ (M : Submonoid Γ(T, U)) (N : Submonoid Γ(X, V)), (letI := (T.presheaf.germ U (f x) (e hx)).hom.toAlgebra; IsLocalization M (T.presheaf.stalk (f x))) ∧ (letI := (X.presheaf.germ V x hx).hom.toAlgebra; IsLocalization N (X.presheaf.stalk x)) ∧ (f.stalkMap x).hom.comp (T.presheaf.germ U (f x) (e hx)).hom = (X.presheaf.germ V x hx).hom.comp (f.appLE U V e).hom := by
    intro X T f U V e x hx hU hV
    refine ⟨_, _, hU.isLocalization_stalk ⟨f x, e hx⟩, hV.isLocalization_stalk ⟨x, hx⟩, ?_⟩
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
    congr 1
    rw [Scheme.Hom.germ_stalkMap f U x (e hx), Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
  have t_s6 : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (e : R ≃+* R'), letI := e.toRingHom.toAlgebra; IsLocalization (⊥ : Submonoid R) R' := by
    intro R R' _ _ e
    letI := e.toRingHom.toAlgebra
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, hy⟩
      rw [Submonoid.mem_bot] at hy
      subst hy
      simp
    · intro z
      exact ⟨⟨e.symm z, 1⟩, by simp [RingHom.algebraMap_toAlgebra]⟩
    · intro a b h
      refine ⟨1, ?_⟩
      have : a = b := e.injective h
      rw [this]
  have t_s7 : ∀ (R R' Mo : Type u) [CommRing R] [CommRing R'] [AddCommGroup Mo] [Module R Mo] (σ : R →+* R') (P : Ideal R) [P.IsPrime] (n : ℕ) (_hloc : letI := σ.toAlgebra; IsLocalization.AtPrime R' P) (_hb : letI := σ.toAlgebra; Nonempty (Module.Basis (Fin n) R' (TensorProduct R R' Mo))), Module.finrank P.ResidueField (TensorProduct R P.ResidueField Mo) = n := by
    intro R R' Mo _ _ _ _ σ P _ n hloc hb
    letI : Algebra R R' := σ.toAlgebra
    haveI := hloc
    obtain ⟨b⟩ := hb
    let ι : R' →+* P.ResidueField := (algebraMap (Localization.AtPrime P) P.ResidueField).comp
      (IsLocalization.algEquiv P.primeCompl R' (Localization.AtPrime P)).toRingEquiv.toRingHom
    letI : Algebra R' P.ResidueField := ι.toAlgebra
    haveI : IsScalarTower R R' P.ResidueField := by
      apply IsScalarTower.of_algebraMap_eq
      intro r
      rw [RingHom.algebraMap_toAlgebra]
      simp only [ι, RingHom.comp_apply]
      rw [IsScalarTower.algebraMap_apply R (Localization.AtPrime P) P.ResidueField r]
      congr 1
      exact ((IsLocalization.algEquiv P.primeCompl R' (Localization.AtPrime P)).commutes r).symm
    let eqv := TensorProduct.AlgebraTensorModule.cancelBaseChange R R' P.ResidueField P.ResidueField Mo
    let b2 := (Algebra.TensorProduct.basis P.ResidueField b).map eqv
    rw [Module.finrank_eq_card_basis b2, Fintype.card_fin]
  have t_s1b : ∀ (A R A' R' : Type u) [CommRing A] [CommRing R] [CommRing A'] [CommRing R'] (φ : A →+* R) (ψ : A' →+* R') (σA : A →+* A') (σR : R →+* R') (M : Submonoid A) (N : Submonoid R) (_hsq : ψ.comp σA = σR.comp φ) (_hM : letI := σA.toAlgebra; IsLocalization M A') (_hN : letI := σR.toAlgebra; IsLocalization N R') (n : ℕ) (_hb : letI := φ.toAlgebra; Nonempty (Module.Basis (Fin n) R Ω[R⁄A])),
      letI := ψ.toAlgebra; Nonempty (Module.Basis (Fin n) R' Ω[R'⁄A']) := by
    intro A R A' R' _ _ _ _ φ ψ σA σR M N hsq hM hN n hb
    obtain ⟨ε⟩ := t_s1 A R A' R' φ ψ σA σR M N hsq hM hN
    letI : Algebra A R := φ.toAlgebra
    letI : Algebra A' R' := ψ.toAlgebra
    letI : Algebra R R' := σR.toAlgebra
    obtain ⟨b⟩ := hb
    exact ⟨(Algebra.TensorProduct.basis R' b).map ε⟩
  have t_La : ∀ (X T : Scheme.{u}) (f : X ⟶ T) (n : ℕ) (x : X) [SmoothOfRelativeDimension n f], letI := (f.stalkMap x).hom.toAlgebra; Nonempty (Module.Basis (Fin n) (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄T.presheaf.stalk (f x)]) := by
    intro X T f n x _
    obtain ⟨U, V, e, hxV, hU, hV, hb⟩ := t_s3 X T f n x
    obtain ⟨M, N, hM, hN, hsq⟩ := t_s4 X T f U V e x hxV hU hV
    exact t_s1b _ _ _ _ (f.appLE U V e).hom (f.stalkMap x).hom (T.presheaf.germ U (f x) (e hxV)).hom
      (X.presheaf.germ V x hxV).hom M N hsq hM hN n hb

  have hxV : hV.fromSpec 𝔭 ∈ V := by
    have h := hV.range_fromSpec
    have h2 : hV.fromSpec 𝔭 ∈ Set.range hV.fromSpec := ⟨𝔭, rfl⟩
    rw [h] at h2
    exact h2
  let y : W'.toScheme := ⟨hV.fromSpec 𝔭, hx⟩
  haveI := hsm

  have hb1 := t_La _ _ (W'.ι ≫ g) 1 y

  let eι : W'.toScheme.presheaf.stalk y ≃+* C.presheaf.stalk (hV.fromSpec 𝔭) :=
    (asIso (W'.ι.stalkMap y)).symm.commRingCatIsoToRingEquiv
  have hsq1 : (g.stalkMap (hV.fromSpec 𝔭)).hom.comp (RingHom.id (P'.presheaf.stalk (g (hV.fromSpec 𝔭)))) =
      eι.toRingHom.comp ((W'.ι ≫ g).stalkMap y).hom := by
    rw [RingHom.comp_id]
    have e1 : (W'.ι ≫ g).stalkMap y ≫ inv (W'.ι.stalkMap y) = g.stalkMap (W'.ι y) :=
      (IsIso.comp_inv_eq _).mpr (Scheme.Hom.stalkMap_comp W'.ι g y)
    exact congrArg CommRingCat.Hom.hom e1.symm
  have hb2 := t_s1b _ _ _ _ ((W'.ι ≫ g).stalkMap y).hom (g.stalkMap (hV.fromSpec 𝔭)).hom
    (RingHom.id (P'.presheaf.stalk (g (hV.fromSpec 𝔭)))) eι.toRingHom ⊥ ⊥ hsq1
    (t_s6 _ _ (RingEquiv.refl _)) (t_s6 _ _ eι) 1 hb1

  obtain ⟨M, N, hM, hN, hsq⟩ := t_s4 C P' g W V hle (hV.fromSpec 𝔭) hxV hW hV
  obtain ⟨ε⟩ := t_s1 _ _ _ _ (g.appLE W V hle).hom (g.stalkMap (hV.fromSpec 𝔭)).hom
    (P'.presheaf.germ W (g (hV.fromSpec 𝔭)) (hle hxV)).hom (C.presheaf.germ V (hV.fromSpec 𝔭) hxV).hom
    M N hsq hM hN
  letI iRB : Algebra Γ(P', W) Γ(C, V) := (g.appLE W V hle).hom.toAlgebra
  letI iAO : Algebra (P'.presheaf.stalk (g (hV.fromSpec 𝔭))) (C.presheaf.stalk (hV.fromSpec 𝔭)) :=
    (g.stalkMap (hV.fromSpec 𝔭)).hom.toAlgebra
  letI iBO : Algebra Γ(C, V) (C.presheaf.stalk (hV.fromSpec 𝔭)) :=
    (C.presheaf.germ V (hV.fromSpec 𝔭) hxV).hom.toAlgebra
  obtain ⟨b⟩ := hb2
  have hb3 : Nonempty (Module.Basis (Fin 1) (C.presheaf.stalk (hV.fromSpec 𝔭))
      (TensorProduct Γ(C, V) (C.presheaf.stalk (hV.fromSpec 𝔭)) Ω[Γ(C, V)⁄Γ(P', W)])) :=
    ⟨b.map ε.symm⟩

  have hloc : IsLocalization.AtPrime (C.presheaf.stalk (hV.fromSpec 𝔭)) 𝔭.asIdeal :=
    hV.isLocalization_stalk' 𝔭 hxV
  have hfin := t_s7 Γ(C, V) (C.presheaf.stalk (hV.fromSpec 𝔭)) Ω[Γ(C, V)⁄Γ(P', W)]
    (C.presheaf.germ V (hV.fromSpec 𝔭) hxV).hom 𝔭.asIdeal 1 hloc hb3
  exact le_of_eq hfin

theorem wcpa_dj_lcf_sc_ann_jac : ∀ (C P' : Scheme.{u}) (g : C ⟶ P'), wcpaDjSemistable g → IsLocallyNoetherian P' → ∀ (V : C.Opens) (W : P'.Opens) (hle : V ≤ g ⁻¹ᵁ W) (r : ℕ) (π : MvPolynomial (Fin (r + 1)) Γ(P', W) →+* Γ(C, V)) (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(P', W)), IsAffineOpen V → IsAffineOpen W → Function.Surjective π → (∀ c, π (MvPolynomial.C c) = (g.appLE W V hle).hom c) → RingHom.ker π = Ideal.span (Set.range f) → ∀ v : Γ(C, V), (∀ j, v * π (wcpaDjJacMinor f j) = 0) → v = 0 :=
by
  intro C P' g hss hP' V W hle r π f hV hW hsurj hC hker v hv
  classical
  haveI : IsNoetherianRing Γ(P', W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  haveI : IsNoetherianRing Γ(C, V) := isNoetherianRing_of_surjective _ _ π hsurj
  letI : Algebra Γ(P', W) Γ(C, V) := (g.appLE W V hle).hom.toAlgebra
  have hflat : (g.appLE W V hle).hom.Flat :=
    HasRingHomProperty.appLE @Flat g hss.1 ⟨W, hW⟩ ⟨V, hV⟩ hle
  haveI : Module.Flat Γ(P', W) Γ(C, V) := hflat
  by_contra hv0

  obtain ⟨𝔭, hass, hle𝔭⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing Γ(C, V) v hv0
  obtain ⟨hprime, ι, hι⟩ := (isAssociatedPrime_iff_exists_injective_linearMap 𝔭 Γ(C, V)).mp hass
  haveI := hprime
  have hy𝔭 : ∀ x : Γ(C, V), x ∈ 𝔭 ↔ x * ι 1 = 0 := by
    intro x
    have h0 : x • (1 : Γ(C, V) ⧸ 𝔭) = Ideal.Quotient.mk 𝔭 x := by
      rw [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq]
    have h1 : x * ι 1 = ι (Ideal.Quotient.mk 𝔭 x) := by
      rw [← smul_eq_mul, ← LinearMap.map_smul, h0]
    constructor
    · intro h
      rw [h1, (Ideal.Quotient.eq_zero_iff_mem).mpr h, map_zero]
    · intro h
      apply (Ideal.Quotient.eq_zero_iff_mem).mp
      apply hι
      rw [← h1, h, map_zero]

  have hΔ : ∀ j, π (wcpaDjJacMinor f j) ∈ 𝔭 := by
    intro j
    apply hle𝔭
    rw [Submodule.mem_colon_singleton, Submodule.mem_bot, smul_eq_mul, mul_comm]
    exact hv j

  have hred := wcpa_dj_lcf_saj_fibre_reduced_torsion C P' g hss V W hle hV hW
  have hmin := wcpa_dj_lcf_saj_ass_fibre_minimal Γ(P', W) Γ(C, V) hred 𝔭 (ι 1) hy𝔭
  have hsm := wcpa_dj_lcf_saj_fibre_minimal_smooth C P' g hss hP' V W hle hV hW ⟨𝔭, hprime⟩ hmin
  have hrk := wcpa_dj_lcf_saj_smooth_kaehler C P' g V W hle hV hW ⟨𝔭, hprime⟩ hsm
  obtain ⟨j, hj⟩ := wcpa_dj_lcf_saj_jacobian_rank Γ(P', W) Γ(C, V) r π f hsurj hC hker 𝔭 hrk
  exact hj (hΔ j)

theorem wcpa_dj_lcf_syntomic_chart : ∀ (k : Type u) [Field k] (S Z : Scheme.{u}) (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), wcpaDjSemistable uu → ∀ z : Z, ∃ (V : Z.Opens) (W : S.Opens) (hle : V ≤ uu ⁻¹ᵁ W) (r : ℕ) (π : MvPolynomial (Fin (r + 1)) Γ(S, W) →+* Γ(Z, V)) (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(S, W)), z ∈ V ∧ IsAffineOpen V ∧ IsAffineOpen W ∧ Function.Surjective π ∧ (∀ c, π (MvPolynomial.C c) = (uu.appLE W V hle).hom c) ∧ RingHom.ker π = Ideal.span (Set.range f) ∧ (∀ c : Fin r → MvPolynomial (Fin (r + 1)) Γ(S, W), ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) ∧ (∀ v : Γ(Z, V), (∀ j, v * π (wcpaDjJacMinor f j) = 0) → v = 0) :=
by
  intro k _ S Z sS hS uu hss z
  classical

  have proj_proper : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)),
      wcpaDjIsProjOver k s → IsProper s := by
    intro Y s hs
    obtain ⟨N, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
          (x : MvPolynomial (Fin (N + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance
  haveI : IsProper sS := proj_proper sS hS
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian sS
  haveI : IsProper uu := hss.2.1
  haveI : Flat uu := hss.1
  by_cases hsm : ∃ W₀ : Z.Opens, z ∈ W₀ ∧ SmoothOfRelativeDimension 1 (W₀.ι ≫ uu)
  ·
    obtain ⟨W₀, hzW₀, hW₀⟩ := hsm
    obtain ⟨V, W, hle, r, π, f, hzV, hV, hW, hsurj, hC, hker⟩ :=
      wcpa_dj_lcf_sc_smooth_chart uu z W₀ hzW₀ hW₀
    have hE3 := wcpa_dj_lcf_sc_ann_jac Z S uu hss inferInstance V W hle r π f hV hW hsurj hC hker
    exact ⟨V, W, hle, r, π, f, hzV, hV, hW, hsurj, hC, hker,
      wcpa_dj_lcf_sc_conormal_of_ann r π f hker hE3, hE3⟩
  ·
    obtain ⟨W, hW, hzW, -⟩ := exists_isAffineOpen_mem_and_subset (x := uu z)
      (U := (⊤ : S.Opens)) trivial
    obtain ⟨V₀, hV₀, hzV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset (x := z)
      (U := uu ⁻¹ᵁ W) (show z ∈ uu ⁻¹ᵁ W from hzW)
    have e : V₀ ≤ uu ⁻¹ᵁ W := fun x hx => hV₀sub hx
    haveI : IsNoetherianRing Γ(S, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
    letI : Algebra Γ(S, W) Γ(Z, V₀) := (uu.appLE W V₀ e).hom.toAlgebra
    have hflat : (uu.appLE W V₀ e).hom.Flat :=
      HasRingHomProperty.appLE @Flat uu hss.1 ⟨W, hW⟩ ⟨V₀, hV₀⟩ e
    haveI : Module.Flat Γ(S, W) Γ(Z, V₀) := hflat
    have hft : (uu.appLE W V₀ e).hom.FiniteType :=
      HasRingHomProperty.appLE @LocallyOfFiniteType uu inferInstance ⟨W, hW⟩ ⟨V₀, hV₀⟩ e
    haveI hft' : Algebra.FiniteType Γ(S, W) Γ(Z, V₀) := hft

    obtain ⟨m, p₀, hp₀⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft'
    obtain ⟨p, hpC, hp⟩ : ∃ p : MvPolynomial (Fin m) Γ(S, W) →+* Γ(Z, V₀),
        p.comp MvPolynomial.C = (uu.appLE W V₀ e).hom ∧ Function.Surjective p :=
      ⟨p₀.toRingHom, RingHom.ext fun a => p₀.commutes a, hp₀⟩
    have hfg : (RingHom.ker p).FG := IsNoetherian.noetherian _
    obtain ⟨s₀, F₀, hF₀⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    obtain ⟨F, hFdef⟩ : ∃ F : Fin (s₀ + 1) → MvPolynomial (Fin m) Γ(S, W),
        F = Fin.cons (α := fun _ => MvPolynomial (Fin m) Γ(S, W)) 0 F₀ := ⟨_, rfl⟩
    have hker : RingHom.ker p = Ideal.span (Set.range F) := by
      rw [hFdef, Fin.range_cons, Ideal.span_insert_zero]
      exact hF₀.symm

    obtain ⟨χ, hχ⟩ : ∃ χ : Γ(Z, V₀) →+*
        AlgebraicClosure (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal.ResidueField,
        RingHom.ker χ = (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal :=
      ⟨(algebraMap _ _).comp (algebraMap Γ(Z, V₀) (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal.ResidueField),
        by rw [RingHom.ker_comp_of_injective _ (algebraMap
            (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal.ResidueField _).injective,
          Ideal.ker_algebraMap_residueField]⟩
    have hpt : (⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ : PrimeSpectrum Γ(Z, V₀)) =
        hV₀.primeIdealOf ⟨z, hzV₀⟩ := PrimeSpectrum.ext hχ
    have hfrom : hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ = z :=
      (congrArg (fun x => hV₀.fromSpec x) hpt).trans (hV₀.fromSpec_primeIdealOf ⟨z, hzV₀⟩)
    have hns : ¬ ∃ W' : Z.Opens, hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ ∈ W' ∧
        SmoothOfRelativeDimension 1 (W'.ι ≫ uu) := by
      rintro ⟨W', h1, h2⟩
      rw [hfrom] at h1
      exact hsm ⟨W', h1, h2⟩

    have hPNT := wcpa_dj_lqu_sigma_pnt Z S uu hss inferInstance W hW V₀ hV₀ e m (s₀ + 1) p F
      hpC hp hker _ χ hns
    have hHilb := wcpa_dj_lcf_sc_fibre_hilbert Z S uu hss inferInstance W hW V₀ hV₀ e m (s₀ + 1)
      p F hpC hp hker _ χ hns
    have hm : m ≠ 0 := by
      rintro rfl
      unfold wcpaLquPNT at hPNT
      obtain ⟨α, β, -, hb, -⟩ := hPNT
      have hαβ : α = β := Subsingleton.elim _ _
      subst hαβ
      have h := hb 1 (-1) (by
        simp only [map_neg, map_one, one_mul, neg_mul, add_neg_cancel]
        exact Submodule.zero_mem _)
      exact one_ne_zero h.1
    obtain ⟨r, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm

    have key : χ.comp p = MvPolynomial.eval₂Hom (χ.comp (uu.appLE W V₀ e).hom)
        (fun l => χ (p (MvPolynomial.X l))) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        exact congrArg χ (RingHom.congr_fun hpC a)
      · intro l
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
    have hev : ∀ j, MvPolynomial.eval (fun l => χ (p (MvPolynomial.X l)))
        (MvPolynomial.map (χ.comp (uu.appLE W V₀ e).hom) (F j)) = 0 := by
      intro j
      have hFj : F j ∈ RingHom.ker p := by rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
      rw [MvPolynomial.eval_map]
      have h1 := RingHom.congr_fun key (F j)
      rw [MvPolynomial.coe_eval₂Hom] at h1
      rw [← h1, RingHom.comp_apply, RingHom.mem_ker.mp hFj, map_zero]

    obtain ⟨E, hE1, hE2⟩ := wcpa_dj_lcf_sc_hilb_gen _ r (s₀ + 1) _ _ hev hPNT hHilb
    obtain ⟨ι, hι⟩ := wcpa_dj_lcf_sc_nakayama_subfamily _ r (s₀ + 1) _ _ E (Nat.succ_pos s₀)
      hE1 hE2
    obtain ⟨G, hχG, hG⟩ := wcpa_dj_lcf_sc_flat_lift Γ(S, W) Γ(Z, V₀) r (s₀ + 1) p F ι hpC hp hker
      _ χ hι

    obtain ⟨hle', π', f', hsurj', hC', hker'⟩ := wcpa_dj_lcf_sc_chart_away uu V₀ W e r (s₀ + 1)
      p F ι G hV₀ hp (fun c => RingHom.congr_fun hpC c) hker hG
    have hzD : z ∈ Z.basicOpen (p G) := by
      have h1 : (⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ : PrimeSpectrum Γ(Z, V₀)) ∈
          hV₀.fromSpec ⁻¹ᵁ Z.basicOpen (p G) := by
        rw [hV₀.fromSpec_preimage_basicOpen]
        exact hχG
      have h2 : hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ ∈ Z.basicOpen (p G) := h1
      rw [hfrom] at h2
      exact h2
    have hE3 := wcpa_dj_lcf_sc_ann_jac Z S uu hss inferInstance (Z.basicOpen (p G)) W hle' (r + 1)
      π' f' (hV₀.basicOpen (p G)) hW hsurj' hC' hker'
    exact ⟨Z.basicOpen (p G), W, hle', r + 1, π', f', hzD, hV₀.basicOpen (p G), hW, hsurj', hC',
      hker', wcpa_dj_lcf_sc_conormal_of_ann (r + 1) π' f' hker' hE3, hE3⟩

theorem wcpa_dj_lcfse_etale_section_algebra : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale → Function.Surjective θ → Function.Bijective (θ.comp (g.comp MvPolynomial.C)) → (RingHom.ker θ).FG → ∃ t r : A, θ t = 0 ∧ θ r = 1 ∧ t ∈ nonZeroDivisors A ∧ ∀ x ∈ RingHom.ker θ, ∃ y : A, r * x = y * t :=
by
  intro R A B _ _ _ g θ hg _hsurj hbij hFG

  have s1 : ∀ a : R, g (MvPolynomial.X 0 - MvPolynomial.C a) ∈ nonZeroDivisors A := by
    intro a
    letI := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
    have hp : (MvPolynomial.X 0 - MvPolynomial.C a : MvPolynomial (Fin 1) R) ∈
        nonZeroDivisors (MvPolynomial (Fin 1) R) := by
      let e := MvPolynomial.uniqueAlgEquiv R (Fin 1)
      apply mem_nonZeroDivisors_of_injective (f := (e : MvPolynomial (Fin 1) R →+* Polynomial R))
        e.injective
      have : (e : MvPolynomial (Fin 1) R →+* Polynomial R) (MvPolynomial.X 0 - MvPolynomial.C a)
          = Polynomial.X - Polynomial.C a := by simp [e]
      rw [this]
      exact (Polynomial.monic_X_sub_C a).mem_nonZeroDivisors
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := A) hp
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hreg
    simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    rw [mul_comm, mul_zero]; exact hx

  have s2 : ∀ a : R, θ (g (MvPolynomial.C a)) = θ (g (MvPolynomial.X 0)) →
      RingHom.ker θ ≤ RingHom.ker θ ^ 2 ⊔
        Ideal.span {g (MvPolynomial.X 0 - MvPolynomial.C a)} := by
    intro a ha
    letI := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
    set e := RingEquiv.ofBijective _ hbij with he
    have he_apply : ∀ c, e c = θ (g (MvPolynomial.C c)) := fun c => rfl
    set J := RingHom.ker θ with hJ
    set I₀ := J ^ 2 ⊔ Ideal.span {g (MvPolynomial.X 0 - MvPolynomial.C a)} with hI₀
    let q := Ideal.Quotient.mk I₀
    let σ : A →+* A := (g.comp MvPolynomial.C).comp ((e.symm : B →+* R).comp θ)
    have hσ : ∀ x, σ x = g (MvPolynomial.C (e.symm (θ x))) := fun x => rfl
    have hσθ : ∀ x, θ (σ x) = θ x := by
      intro x
      rw [hσ, ← he_apply, e.apply_symm_apply]
    have hcomm : (q.comp σ).comp g = q.comp g := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply]
        rw [hσ, ← he_apply, e.symm_apply_apply]
      · intro i
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        simp only [RingHom.comp_apply]
        rw [hσ, ← ha, ← he_apply, e.symm_apply_apply]
        refine (Ideal.Quotient.eq.mpr ?_).symm
        rw [← map_sub]
        exact Ideal.mem_sup_right (Ideal.subset_span rfl)
    let q₂ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I₀ :=
      { q.comp σ with
        commutes' := fun P => by
          have := congrArg (fun f => f P) hcomm
          simp only [RingHom.comp_apply] at this
          exact this }
    have hq₂ : ∀ x, q₂ x = q (σ x) := fun x => rfl
    have hnil : IsNilpotent (J.map q) := by
      refine ⟨2, ?_⟩
      rw [← Ideal.map_pow]
      have h1 : Ideal.map q (J ^ 2) ≤ Ideal.map q I₀ := Ideal.map_mono le_sup_left
      have h2 : Ideal.map q I₀ = ⊥ := by
        rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
      rw [h2] at h1
      exact le_bot_iff.mp h1
    have hext := Algebra.FormallyUnramified.ext (R := MvPolynomial (Fin 1) R) (J.map q) hnil
      (g₁ := Ideal.Quotient.mkₐ (MvPolynomial (Fin 1) R) I₀) (g₂ := q₂) (fun x => by
        rw [Ideal.Quotient.eq, hq₂, Ideal.Quotient.mkₐ_eq_mk]
        show q x - q (σ x) ∈ _
        rw [← map_sub]
        apply Ideal.mem_map_of_mem
        rw [RingHom.mem_ker, map_sub, hσθ, sub_self])
    intro x hx
    have h1 := congrArg (fun f => f x) hext
    simp only [Ideal.Quotient.mkₐ_eq_mk, hq₂, hσ] at h1
    rw [RingHom.mem_ker.mp hx, map_zero, map_zero, map_zero, map_zero] at h1
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  have s3 : ∀ (J : Ideal A) (t : A), J.FG → J ≤ J ^ 2 ⊔ Ideal.span {t} →
      ∃ r : A, r - 1 ∈ J ∧ ∀ x ∈ J, ∃ y : A, r * x = y * t := by
    intro J t hFG hle
    set K : Ideal A := Ideal.span {t} with hK
    let π := Submodule.mkQ K
    let N : Submodule A (A ⧸ K) := Submodule.map π J
    have hNfg : N.FG := Submodule.FG.map π hFG
    have hNle : N ≤ J • N := by
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨j, hj, w, hw, hjw⟩ := Submodule.mem_sup.mp (hle hx)
      have hπ : π x = π j := by
        rw [← hjw, map_add]
        have : π w = 0 := (Submodule.Quotient.mk_eq_zero K).mpr hw
        rw [this, add_zero]
      show π x ∈ J • N
      rw [hπ]
      have hj' : j ∈ J • J := by rwa [Ideal.smul_eq_mul, ← pow_two]
      have := Submodule.mem_map_of_mem (f := π) hj'
      rwa [Submodule.map_smul''] at this
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J N hNfg hNle
    refine ⟨r, hr1, fun x hx => ?_⟩
    have h1 : π (r * x) = 0 := by
      rw [← smul_eq_mul, LinearMap.map_smul]
      exact hr _ (Submodule.mem_map_of_mem hx)
    have h2 : r * x ∈ K := (Submodule.Quotient.mk_eq_zero K).mp h1
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp h2
    exact ⟨y, hy.symm⟩

  obtain ⟨a, ha⟩ := hbij.2 (θ (g (MvPolynomial.X 0)))
  simp only [RingHom.comp_apply] at ha
  refine ⟨g (MvPolynomial.X 0 - MvPolynomial.C a), ?_⟩
  obtain ⟨r, hr1, hr⟩ := s3 (RingHom.ker θ) _ hFG (s2 a ha)
  refine ⟨r, ?_, ?_, s1 a, hr⟩
  · rw [map_sub, map_sub, ha, sub_self]
  · have := RingHom.mem_ker.mp hr1
    rw [map_sub, map_one, sub_eq_zero] at this
    exact this

theorem wcpa_dj_lcfse_kernel_localize : ∀ {X Y : Scheme.{u}} (τ : Y ⟶ X) [IsClosedImmersion τ] (W : X.Opens), IsAffineOpen W → ∀ (t m f : Γ(X, W)) (W' : X.Opens), W' = X.basicOpen f → X.basicOpen f ≤ X.basicOpen m → (τ.app W).hom t = 0 → t ∈ nonZeroDivisors Γ(X, W) → (∀ x ∈ RingHom.ker (τ.app W).hom, ∃ y : Γ(X, W), m * x = y * t) → ∃ h : Γ(X, W'), h ∈ nonZeroDivisors Γ(X, W') ∧ RingHom.ker (τ.app W').hom = Ideal.span {h} :=
by
  intro X Y τ _ W hW t m f W' hW' hfm hθt ht hker
  subst hW'
  haveI hloc : IsLocalization.Away f Γ(X, X.basicOpen f) := hW.isLocalization_basicOpen f
  have hle' : τ ⁻¹ᵁ X.basicOpen f ≤ τ ⁻¹ᵁ W := fun x hx => X.basicOpen_le f hx

  have nat : ∀ a : Γ(X, W), (τ.app (X.basicOpen f)).hom (algebraMap Γ(X, W) Γ(X, X.basicOpen f) a)
      = (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom a) := by
    intro a
    have e := τ.naturality (homOfLE (X.basicOpen_le f)).op
    have := congrArg (fun φ => φ.hom a) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this

  have hfu : IsUnit (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f) :=
    IsLocalization.Away.algebraMap_isUnit f
  have hmu : IsUnit (algebraMap Γ(X, W) Γ(X, X.basicOpen f) m) := by
    have h1 : IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le m)).op).hom m) :=
      RingedSpace.isUnit_res_basicOpen X.toRingedSpace m
    have h2 := h1.map (X.presheaf.map (homOfLE hfm).op).hom
    convert h2 using 1
    have e := congrArg (fun φ => φ.hom m)
      (X.presheaf.map_comp (homOfLE (X.basicOpen_le m)).op (homOfLE hfm).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    exact e
  refine ⟨algebraMap Γ(X, W) Γ(X, X.basicOpen f) t, ?_, le_antisymm ?_ ?_⟩
  · exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(X, X.basicOpen f)
      ⟨t, ht, rfl⟩
  · intro x' hx'
    rw [RingHom.mem_ker] at hx'
    obtain ⟨⟨x0, ⟨_, n, rfl⟩⟩, hx0⟩ := IsLocalization.surj (Submonoid.powers f) x'
    simp only at hx0
    have h1 : (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom x0) = 0 := by
      rw [← nat, ← hx0, map_mul, hx', zero_mul]
    have hWY : IsAffineOpen (τ ⁻¹ᵁ W) := hW.preimage τ
    letI : Algebra Γ(Y, τ ⁻¹ᵁ W) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) :=
      (Y.presheaf.map (homOfLE hle').op).hom.toAlgebra
    haveI : IsLocalization.Away ((τ.app W).hom f) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) :=
      hWY.isLocalization_of_eq_basicOpen ((τ.app W).hom f) (homOfLE hle')
        (τ.preimage_basicOpen f)
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff
      (Submonoid.powers ((τ.app W).hom f)) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) ((τ.app W).hom x0)).mp h1
    simp only at hk
    obtain ⟨y, hy⟩ := hker (f ^ k * x0) (by rw [RingHom.mem_ker, map_mul, map_pow]; exact hk)
    have key : x' * (algebraMap Γ(X, W) Γ(X, X.basicOpen f) m *
        algebraMap Γ(X, W) Γ(X, X.basicOpen f) f ^ (k + n)) =
        algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * algebraMap Γ(X, W) Γ(X, X.basicOpen f) t := by
      have e := congrArg (algebraMap Γ(X, W) Γ(X, X.basicOpen f)) hy
      rw [map_mul, map_mul, map_mul, map_pow, ← hx0, map_pow] at e
      rw [← e]
      ring
    have hu := hmu.mul (hfu.pow (k + n))
    rw [Ideal.mem_span_singleton']
    refine ⟨algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * ↑hu.unit⁻¹, ?_⟩
    calc algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * ↑hu.unit⁻¹ *
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) t
        = (algebraMap Γ(X, W) Γ(X, X.basicOpen f) y *
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) t) * ↑hu.unit⁻¹ := by ring
      _ = x' * (algebraMap Γ(X, W) Γ(X, X.basicOpen f) m *
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) f ^ (k + n)) * ↑hu.unit⁻¹ := by rw [key]
      _ = x' := by rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
  · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat, hθt, map_zero]

theorem wcpa_dj_lcfse_etale_chart_shrink : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S) (τ : S ⟶ Z), τ ≫ uu = 𝟙 S → ∀ (U₀ : S.Opens) (V₁ : Z.Opens) (e₁ : V₁ ≤ uu ⁻¹ᵁ U₀) (g₁ : MvPolynomial (Fin 1) Γ(S, U₀) →+* Γ(Z, V₁)), IsAffineOpen U₀ → IsAffineOpen V₁ → g₁.Etale → g₁.comp MvPolynomial.C = (uu.appLE U₀ V₁ e₁).hom → ∀ p : S, τ p ∈ V₁ → ∃ (U : S.Opens) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ U) (g : MvPolynomial (Fin 1) Γ(S, U) →+* Γ(Z, V)), IsAffineOpen U ∧ IsAffineOpen V ∧ τ p ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE U V hle).hom ∧ Function.Bijective ((τ.app V).hom.comp (uu.appLE U V hle).hom) :=
by
  intro Z S uu τ h U₀ V₁ e₁ g₁ hU₀ hV₁ hg₁ hg₁C p hp
  have hpt : ∀ x : S, uu (τ x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, h]
    rfl
  have hpU₀ : p ∈ U₀ := by
    have h1 : τ p ∈ uu ⁻¹ᵁ U₀ := e₁ hp
    rw [Scheme.Hom.mem_preimage, hpt] at h1
    exact h1
  have hpτ : p ∈ τ ⁻¹ᵁ V₁ := hp
  obtain ⟨c, hc, hpc⟩ := hU₀.exists_basicOpen_le (V := τ ⁻¹ᵁ V₁) ⟨p, hpτ⟩ hpU₀
  have hVeq : Z.basicOpen ((uu.appLE U₀ V₁ e₁).hom c) = V₁ ⊓ uu ⁻¹ᵁ S.basicOpen c :=
    Scheme.basicOpen_appLE uu V₁ U₀ e₁ c
  set V := Z.basicOpen ((uu.appLE U₀ V₁ e₁).hom c) with hVdef
  have hle : V ≤ uu ⁻¹ᵁ S.basicOpen c := by rw [hVeq]; exact inf_le_right
  have hpV : τ p ∈ V := by
    rw [hVeq]
    refine ⟨hp, ?_⟩
    show uu (τ p) ∈ S.basicOpen c
    rw [hpt]; exact hpc
  have hτV : τ ⁻¹ᵁ V = S.basicOpen c := by
    ext x
    rw [hVeq]
    constructor
    · rintro ⟨_, h2⟩
      have h3 : uu (τ x) ∈ S.basicOpen c := h2
      rw [hpt] at h3
      exact h3
    · intro hx
      refine ⟨hc hx, ?_⟩
      show uu (τ x) ∈ S.basicOpen c
      rw [hpt]; exact hx

  have hbij : Function.Bijective ((τ.app V).hom.comp (uu.appLE (S.basicOpen c) V hle).hom) := by
    have key : ∀ (f : S ⟶ S) (W : S.Opens) (e : W ≤ f ⁻¹ᵁ S.basicOpen c), f = 𝟙 S →
        W = S.basicOpen c → Function.Bijective (f.appLE (S.basicOpen c) W e).hom := by
      intro f W e hf hW
      subst hf
      subst hW
      have h1 : (𝟙 S : S ⟶ S).appLE (S.basicOpen c) (S.basicOpen c) e = 𝟙 _ := by
        rw [Scheme.Hom.appLE]
        erw [Scheme.Hom.id_app, Category.id_comp]
        exact S.presheaf.map_id (Opposite.op (S.basicOpen c))
      rw [h1, CommRingCat.hom_id]
      exact Function.bijective_id
    rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    exact key _ _ _ h hτV

  haveI hlocS : IsLocalization.Away c Γ(S, S.basicOpen c) := hU₀.isLocalization_basicOpen c
  haveI hlocZ : IsLocalization.Away ((uu.appLE U₀ V₁ e₁).hom c) Γ(Z, V) :=
    hV₁.isLocalization_basicOpen _
  letI : Algebra (MvPolynomial (Fin 1) Γ(S, U₀)) (MvPolynomial (Fin 1) Γ(S, S.basicOpen c)) :=
    MvPolynomial.algebraMvPolynomial
  let M : Submonoid (MvPolynomial (Fin 1) Γ(S, U₀)) :=
    Submonoid.map MvPolynomial.C (Submonoid.powers c)
  haveI hM : IsLocalization M (MvPolynomial (Fin 1) Γ(S, S.basicOpen c)) :=
    MvPolynomial.isLocalization (Submonoid.powers c) _
  have hMmap : M.map g₁ = Submonoid.powers ((uu.appLE U₀ V₁ e₁).hom c) := by
    simp only [M, Submonoid.map_powers]
    rw [← hg₁C]
    rfl
  haveI hM2 : IsLocalization (M.map g₁) Γ(Z, V) := by rw [hMmap]; exact hlocZ
  let g : MvPolynomial (Fin 1) Γ(S, S.basicOpen c) →+* Γ(Z, V) :=
    IsLocalization.map (M := M) (T := M.map g₁) Γ(Z, V) g₁ (Submonoid.le_comap_map M)
  have hgEt : g.Etale :=
    RingHom.Etale.isStableUnderBaseChange.localizationPreserves g₁ M _ _ hg₁
  have hgC : g.comp MvPolynomial.C = (uu.appLE (S.basicOpen c) V hle).hom := by
    apply IsLocalization.ringHom_ext (Submonoid.powers c)
    ext b
    simp only [RingHom.comp_apply]
    have e1 : MvPolynomial.C (algebraMap Γ(S, U₀) Γ(S, S.basicOpen c) b) =
        algebraMap (MvPolynomial (Fin 1) Γ(S, U₀)) (MvPolynomial (Fin 1) Γ(S, S.basicOpen c))
          (MvPolynomial.C b) := by
      rw [MvPolynomial.algebraMap_def, MvPolynomial.map_C]
    rw [e1]
    show IsLocalization.map (M := M) (T := M.map g₁) Γ(Z, V) g₁ (Submonoid.le_comap_map M)
      (algebraMap _ _ (MvPolynomial.C b)) = _
    rw [IsLocalization.map_eq]
    have e2 : g₁ (MvPolynomial.C b) = (uu.appLE U₀ V₁ e₁).hom b := by rw [← hg₁C]; rfl
    rw [e2]
    have e3 : uu.appLE U₀ V₁ e₁ ≫ Z.presheaf.map (homOfLE (Z.basicOpen_le _)).op =
        S.presheaf.map (homOfLE (S.basicOpen_le c)).op ≫ uu.appLE (S.basicOpen c) V hle := by
      rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    exact congrArg (fun φ => φ.hom b) e3
  exact ⟨S.basicOpen c, V, hle, g, hU₀.basicOpen c, hV₁.basicOpen _, hpV, hgEt, hgC, hbij⟩

theorem wcpa_dj_lcf_section_equation : ∀ (k : Type u) [Field k] (S Z : Scheme.{u}) (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ Z)), wcpaDjSemistable uu → wcpaDjSections uu n τ → ∀ (V : Z.Opens), IsAffineOpen V → ∀ z ∈ V, ∃ s : Γ(Z, V), z ∈ Z.basicOpen s ∧ ∀ i, IsAffineOpen ((τ i) ⁻¹ᵁ Z.basicOpen s) ∧ Function.Surjective ((τ i).app (Z.basicOpen s)).hom ∧ ∃ hi : Γ(Z, Z.basicOpen s), hi ∈ nonZeroDivisors Γ(Z, Z.basicOpen s) ∧ RingHom.ker ((τ i).app (Z.basicOpen s)).hom = Ideal.span {hi} :=
by
  intro k _ S Z sS hS uu n τ hss hsec V hV z hzV
  classical
  have proj_proper : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)),
      wcpaDjIsProjOver k s → IsProper s := by
    intro Y s hs
    obtain ⟨N, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
          (x : MvPolynomial (Fin (N + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance
  haveI hsSp : IsProper sS := proj_proper sS hS
  haveI huup : IsProper uu := hss.2.1

  have hci : ∀ i, IsClosedImmersion (τ i) := by
    intro i
    haveI : IsClosedImmersion (τ i ≫ uu) := by rw [hsec.1 i]; infer_instance
    exact IsClosedImmersion.of_comp (τ i) uu

  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian sS
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian uu

  let Cset : Set Z := ⋃ i : Fin n, if z ∈ Set.range (τ i) then ∅ else Set.range (τ i)
  have hCcl : IsClosed Cset := by
    refine isClosed_iUnion_of_finite (fun i => ?_)
    split_ifs
    · exact isClosed_empty
    · haveI := hci i
      exact (τ i).isClosedEmbedding.isClosed_range
  have hzC : z ∉ Cset := by
    intro h
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp h
    split_ifs at hi with h'
    · exact hi
    · exact h' hi
  have hC_sub : ∀ i, z ∉ Set.range (τ i) → Set.range (τ i) ⊆ Cset := by
    intro i hi x hx
    exact Set.mem_iUnion.mpr ⟨i, by rw [if_neg hi]; exact hx⟩
  let OC : Z.Opens := ⟨Csetᶜ, hCcl.isOpen_compl⟩
  have hzOC : z ∈ OC := hzC

  have hP4 : ∀ (s : Γ(Z, V)) (i : Fin n), IsAffineOpen ((τ i) ⁻¹ᵁ Z.basicOpen s) ∧
      Function.Surjective ((τ i).app (Z.basicOpen s)).hom := by
    intro s i
    haveI := hci i
    exact ⟨(hV.basicOpen s).preimage (τ i), (τ i).app_surjective _ (hV.basicOpen s)⟩
  have hempty : ∀ (s : Γ(Z, V)) (i : Fin n), Z.basicOpen s ≤ OC → z ∉ Set.range (τ i) →
      ∃ hi : Γ(Z, Z.basicOpen s), hi ∈ nonZeroDivisors Γ(Z, Z.basicOpen s) ∧
        RingHom.ker ((τ i).app (Z.basicOpen s)).hom = Ideal.span {hi} := by
    intro s i hsO hzi
    have hbot : (τ i) ⁻¹ᵁ Z.basicOpen s = ⊥ := by
      refine eq_bot_iff.mpr (fun x hx => ?_)
      exfalso
      have h1 : τ i x ∈ OC := hsO ((Scheme.Hom.mem_preimage _).mp hx)
      exact h1 (hC_sub i hzi ⟨x, rfl⟩)
    haveI : Subsingleton Γ(S, (τ i) ⁻¹ᵁ Z.basicOpen s) :=
      CommRingCat.subsingleton_of_isTerminal (S.sheaf.isTerminalOfEqEmpty hbot)
    refine ⟨1, Submonoid.one_mem _, ?_⟩
    rw [Ideal.span_singleton_one, eq_top_iff]
    intro x _
    rw [RingHom.mem_ker]
    exact Subsingleton.elim _ _
  by_cases hA : ∃ i, z ∈ Set.range (τ i)
  swap
  ·
    have hA' : ∀ i, z ∉ Set.range (τ i) := fun i h => hA ⟨i, h⟩
    obtain ⟨s, hsO, hzs⟩ := hV.exists_basicOpen_le (⟨z, hzOC⟩ : OC) hzV
    exact ⟨s, hzs, fun i => ⟨(hP4 s i).1, (hP4 s i).2, hempty s i hsO (hA' i)⟩⟩

  obtain ⟨i₀, p, hp⟩ := hA
  have huniq : ∀ i, z ∈ Set.range (τ i) → i = i₀ := by
    rintro i ⟨q, hq⟩
    by_contra hne
    exact hsec.2.1 i i₀ q p hne (hq.trans hp.symm)
  obtain ⟨W, hW, hWsm⟩ := hsec.2.2 i₀ p
  rw [hp] at hW
  obtain ⟨U₀, V₁, e₁, g₁, hU₀, hV₁, hzV₁, hg₁, hg₁C⟩ :=
    wcpa_dj_lcfse_smooth_etale_chart_open uu W hWsm z hW
  have hpV₁ : τ i₀ p ∈ V₁ := by rw [hp]; exact hzV₁
  obtain ⟨U, V', hle, g, hU, hV', hzV', hg, hgC, hbij⟩ :=
    wcpa_dj_lcfse_etale_chart_shrink uu (τ i₀) (hsec.1 i₀) U₀ V₁ e₁ g₁ hU₀ hV₁ hg₁ hg₁C p hpV₁
  have hzV'' : z ∈ V' := by rw [← hp]; exact hzV'
  haveI := hci i₀
  have hθs : Function.Surjective ((τ i₀).app V').hom := (τ i₀).app_surjective V' hV'
  have hFG : (RingHom.ker ((τ i₀).app V').hom).FG := by
    haveI : IsNoetherianRing Γ(Z, V') := IsLocallyNoetherian.component_noetherian ⟨V', hV'⟩
    exact IsNoetherian.noetherian _
  have hbij' : Function.Bijective (((τ i₀).app V').hom.comp (g.comp MvPolynomial.C)) := by
    rw [hgC]; exact hbij
  obtain ⟨t, r, hθt, hθr, ht, htr⟩ :=
    wcpa_dj_lcfse_etale_section_algebra g ((τ i₀).app V').hom hg hθs hbij' hFG
  have hzr : z ∈ Z.basicOpen r := by
    have h1 : (τ i₀) ⁻¹ᵁ Z.basicOpen r = (τ i₀) ⁻¹ᵁ V' := by
      rw [Scheme.Hom.preimage_basicOpen, hθr, Scheme.basicOpen_one]
    have h2 : p ∈ (τ i₀) ⁻¹ᵁ V' := hzV'
    rw [← h1, Scheme.Hom.mem_preimage, hp] at h2
    exact h2
  obtain ⟨f₀, hf₀le, hzf₀⟩ :=
    hV'.exists_basicOpen_le (⟨z, ⟨hzr, hzOC⟩⟩ : ↥(Z.basicOpen r ⊓ OC)) hzV''
  obtain ⟨s, f, hsf, hzs⟩ := exists_basicOpen_le_affine_inter hV (hV'.basicOpen f₀) z ⟨hzV, hzf₀⟩
  obtain ⟨f', hf'⟩ := hV'.basicOpen_basicOpen_is_basicOpen f₀ f
  have hsf' : Z.basicOpen s = Z.basicOpen f' := hsf.trans hf'.symm
  have hfle : Z.basicOpen f ≤ Z.basicOpen r ⊓ OC := (Z.basicOpen_le f).trans hf₀le
  have hsle : Z.basicOpen s ≤ OC := by rw [hsf]; exact hfle.trans inf_le_right
  have hf'r : Z.basicOpen f' ≤ Z.basicOpen r := by rw [hf']; exact hfle.trans inf_le_left
  refine ⟨s, hzs, fun i => ⟨(hP4 s i).1, (hP4 s i).2, ?_⟩⟩
  by_cases hi : z ∈ Set.range (τ i)
  · obtain rfl := huniq i hi
    exact wcpa_dj_lcfse_kernel_localize (τ i) V' hV' t r f' (Z.basicOpen s) hsf' hf'r hθt ht htr
  · exact hempty s i hsle hi

theorem wcpa_dj_lcf_cl_minor_adjoin : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (ρ : R →+* R') (r : ℕ) (f : Fin r → MvPolynomial (Fin (r + 1)) R) (S : MvPolynomial (Fin (r + 1)) R) (j : Fin (r + 1)), wcpaDjJacMinor (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) R') (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ (f i))) (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ S) - 1)) j.castSucc = MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ S) * MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ (wcpaDjJacMinor f j)) :=
by
  intro R R' _ _ ρ r f S j
  classical
  unfold wcpaDjJacMinor
  set ιh : MvPolynomial (Fin (r + 1)) R →+* MvPolynomial (Fin (r + 1 + 1)) R' :=
    (MvPolynomial.rename Fin.castSucc).toRingHom.comp (MvPolynomial.map ρ) with hιh
  have hι : ∀ p, MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ p) = ιh p := fun p => rfl
  have D0 : ∀ q : MvPolynomial (Fin (r + 1)) R',
      MvPolynomial.pderiv (Fin.last (r + 1)) (MvPolynomial.rename Fin.castSucc q) = 0 := by
    intro q
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro h
    obtain ⟨a, _, ha⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename _ _ h)
    exact Fin.castSucc_ne_last a ha
  have s2 : (Fin.castSucc j).succAbove (Fin.last r) = Fin.last (r + 1) := by
    rw [Fin.succAbove_of_le_castSucc _ _ (Fin.castSucc_le_castSucc_iff.mpr (Fin.le_last j)),
      Fin.succ_last]
  set f' := Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) R')
    (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ (f i)))
    (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc (MvPolynomial.map ρ S) - 1)
    with hf'
  set M' : Matrix (Fin (r + 1)) (Fin (r + 1)) (MvPolynomial (Fin (r + 1 + 1)) R') :=
    Matrix.of fun i l => MvPolynomial.pderiv ((Fin.castSucc j).succAbove l) (f' i) with hM'
  set J : Matrix (Fin r) (Fin r) (MvPolynomial (Fin (r + 1)) R) :=
    Matrix.of fun i l => MvPolynomial.pderiv (j.succAbove l) (f i) with hJ
  have c1 : ∀ i : Fin r, M' (Fin.castSucc i) (Fin.last r) = 0 := by
    intro i
    simp only [hM', Matrix.of_apply, s2, hf', Fin.snoc_castSucc]
    exact D0 _
  have c2 : M' (Fin.last r) (Fin.last r) = ιh S := by
    simp only [hM', Matrix.of_apply, s2, hf', Fin.snoc_last]
    rw [map_sub, Derivation.map_one_eq_zero, sub_zero, Derivation.leibniz, D0,
      MvPolynomial.pderiv_X_self, smul_eq_mul, smul_eq_mul, mul_zero, zero_add, mul_one]
    exact hι S
  have s4 : M'.submatrix Fin.castSucc Fin.castSucc = ιh.mapMatrix J := by
    ext i l
    simp only [Matrix.submatrix_apply, hM', hJ, Matrix.of_apply, RingHom.mapMatrix_apply,
      Matrix.map_apply, Fin.castSucc_succAbove_castSucc, hf', Fin.snoc_castSucc]
    rw [MvPolynomial.pderiv_rename (Fin.castSucc_injective _), MvPolynomial.pderiv_map]
    rfl
  have s5 : M'.det = ιh S * ιh J.det := by
    rw [Matrix.det_succ_column M' (Fin.last r), Fin.sum_univ_castSucc]
    rw [Finset.sum_eq_zero (fun i _ => by rw [c1 i, mul_zero, zero_mul]), zero_add,
      Fin.succAbove_last, c2, s4, ← RingHom.map_det, Fin.val_last,
      Even.neg_one_pow ⟨r, rfl⟩, one_mul]
  change (-1) ^ ((Fin.castSucc j : Fin (r + 1 + 1)) : ℕ) * M'.det =
    ιh S * ιh ((-1) ^ (j : ℕ) * J.det)
  rw [s5, map_mul, map_pow, map_neg, map_one, Fin.coe_castSucc]
  ring

theorem wcpa_dj_lcf_cl_presentation : ∀ {R A Rc As : Type u} [CommRing R] [CommRing A] [CommRing Rc] [CommRing As] [Algebra R Rc] [Algebra A As] (c : R) (s : A) [IsLocalization.Away c Rc] [IsLocalization.Away s As] (φ : R →+* A) (ψ : Rc →+* As), (∀ b : R, ψ (algebraMap R Rc b) = algebraMap A As (φ b)) → ∀ (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* A) (f : Fin r → MvPolynomial (Fin (r + 1)) R) (S : MvPolynomial (Fin (r + 1)) R), Function.Surjective π → (∀ b, π (MvPolynomial.C b) = φ b) → RingHom.ker π = Ideal.span (Set.range f) → π S = s → Function.Surjective (MvPolynomial.eval₂Hom ψ (Fin.snoc (α := fun _ => As) (fun j => algebraMap A As (π (MvPolynomial.X j))) (IsLocalization.Away.invSelf (S := As) s))) ∧ RingHom.ker (MvPolynomial.eval₂Hom ψ (Fin.snoc (α := fun _ => As) (fun j => algebraMap A As (π (MvPolynomial.X j))) (IsLocalization.Away.invSelf (S := As) s))) = Ideal.span (Set.range (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Rc) (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i))) (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S) - 1))) :=
by
  intro R A Rc As _ _ _ _ _ _ c s _ _ φ ψ hψ r π f S hsurj hC hker hS
  set u : As := IsLocalization.Away.invSelf (S := As) s with hu
  set g : Fin (r + 1 + 1) → As := Fin.snoc (α := fun _ => As)
    (fun j => algebraMap A As (π (MvPolynomial.X j))) u with hg
  set π' := MvPolynomial.eval₂Hom ψ g with hπ'
  set I' := Ideal.span (Set.range (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Rc)
    (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i)))
    (MvPolynomial.X (Fin.last (r + 1)) *
      MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S) - 1))) with hI'
  let ι : MvPolynomial (Fin (r + 1)) R →+* MvPolynomial (Fin (r + 1 + 1)) Rc :=
    (MvPolynomial.rename Fin.castSucc).toRingHom.comp (MvPolynomial.map (algebraMap R Rc))

  have L1 : π'.comp ι = (algebraMap A As).comp π := by
    apply MvPolynomial.ringHom_ext
    · intro b
      simp only [ι, hπ', RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.map_C, MvPolynomial.rename_C, MvPolynomial.eval₂Hom_C, hψ, hC]
    · intro j
      simp only [ι, hπ', hg, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.map_X, MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc]
  have L1' : ∀ p, π' (MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) p))
      = algebraMap A As (π p) := fun p => RingHom.congr_fun L1 p

  have hπ't : π' (MvPolynomial.X (Fin.last (r + 1))) = u := by
    simp only [hπ', hg, MvPolynomial.eval₂Hom_X', Fin.snoc_last]
  have hus : algebraMap A As s * u = 1 := IsLocalization.Away.mul_invSelf s

  have surj : Function.Surjective π' := by
    intro z
    obtain ⟨n, a, hz⟩ := IsLocalization.Away.surj s z
    obtain ⟨a', ha'⟩ := hsurj a
    refine ⟨MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) a') *
      MvPolynomial.X (Fin.last (r + 1)) ^ n, ?_⟩
    rw [map_mul, map_pow, L1', ha', hπ't, ← hz, mul_assoc, ← mul_pow, hus, one_pow, mul_one]

  have hfI : ∀ i, MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i)) ∈ I' :=
    fun i => Ideal.subset_span ⟨i.castSucc, Fin.snoc_castSucc _ _ _⟩
  have hlast : MvPolynomial.X (Fin.last (r + 1)) *
      MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S) - 1 ∈ I' :=
    Ideal.subset_span ⟨Fin.last r, Fin.snoc_last _ _⟩

  have s4 : I' ≤ RingHom.ker π' := by
    rw [hI', Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    induction i using Fin.lastCases with
    | last =>
      rw [Fin.snoc_last, map_sub, map_mul, hπ't, L1', hS, map_one, mul_comm, hus, sub_self]
    | cast j =>
      rw [Fin.snoc_castSucc, L1']
      have hj : f j ∈ RingHom.ker π := by rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
      rw [RingHom.mem_ker.mp hj, map_zero]

  have hν : RingHom.ker π ≤ RingHom.ker ((Ideal.Quotient.mk I').comp ι) := by
    rw [hker, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hfI i
  let θA : A →+* MvPolynomial (Fin (r + 1 + 1)) Rc ⧸ I' :=
    π.liftOfSurjective hsurj ⟨(Ideal.Quotient.mk I').comp ι, hν⟩
  have hθA : ∀ p, θA (π p) = Ideal.Quotient.mk I'
      (MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) p)) := fun p =>
    RingHom.liftOfSurjective_comp_apply π hsurj ⟨(Ideal.Quotient.mk I').comp ι, hν⟩ p

  have hmkinv : Ideal.Quotient.mk I'
      (MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S)) *
      Ideal.Quotient.mk I' (MvPolynomial.X (Fin.last (r + 1))) = 1 := by
    rw [← map_mul, ← map_one (Ideal.Quotient.mk I'), Ideal.Quotient.mk_eq_mk_iff_sub_mem, mul_comm]
    exact hlast
  have hU : IsUnit (Ideal.Quotient.mk I'
      (MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S))) :=
    ⟨⟨_, _, hmkinv, by rw [mul_comm]; exact hmkinv⟩, rfl⟩
  have hunit : IsUnit (θA s) := by rw [← hS, hθA]; exact hU

  let θ : As →+* MvPolynomial (Fin (r + 1 + 1)) Rc ⧸ I' := IsLocalization.Away.lift (S := As) s hunit
  have hθ : ∀ a, θ (algebraMap A As a) = θA a := fun a => IsLocalization.Away.lift_eq s hunit a

  have hcomp : θ.comp π' = Ideal.Quotient.mk I' := by
    apply MvPolynomial.ringHom_ext
    · intro a
      have h1 : θ.comp ψ = (Ideal.Quotient.mk I').comp MvPolynomial.C := by
        apply IsLocalization.ringHom_ext (Submonoid.powers c)
        ext b
        simp only [RingHom.comp_apply]
        rw [hψ, hθ, ← hC, hθA, MvPolynomial.map_C, MvPolynomial.rename_C]
      rw [RingHom.comp_apply, hπ', MvPolynomial.eval₂Hom_C]
      exact RingHom.congr_fun h1 a
    · intro i
      induction i using Fin.lastCases with
      | last =>
        rw [RingHom.comp_apply, hπ't]
        apply hU.mul_left_cancel
        have e2 : θ (algebraMap A As s) = Ideal.Quotient.mk I'
            (MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S)) := by
          rw [hθ, ← hS, hθA]
        rw [hmkinv, ← e2, ← map_mul, hus, map_one]
      | cast j =>
        have hx : (MvPolynomial.X j.castSucc : MvPolynomial (Fin (r + 1 + 1)) Rc) =
            MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (MvPolynomial.X j)) := by
          rw [MvPolynomial.map_X, MvPolynomial.rename_X]
        rw [hx, RingHom.comp_apply, L1', hθ, hθA]

  refine ⟨surj, le_antisymm ?_ s4⟩
  intro p hp
  rw [RingHom.mem_ker] at hp
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← hcomp, RingHom.comp_apply, hp, map_zero]

theorem wcpa_dj_lcf_cl_conormal : ∀ {R A Rc As : Type u} [CommRing R] [CommRing A] [CommRing Rc] [CommRing As] [Algebra R Rc] [Algebra A As] (c : R) (s : A) [IsLocalization.Away c Rc] [IsLocalization.Away s As] (φ : R →+* A) (ψ : Rc →+* As), (∀ b : R, ψ (algebraMap R Rc b) = algebraMap A As (φ b)) → ∀ (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* A) (f : Fin r → MvPolynomial (Fin (r + 1)) R) (S : MvPolynomial (Fin (r + 1)) R), Function.Surjective π → (∀ b, π (MvPolynomial.C b) = φ b) → RingHom.ker π = Ideal.span (Set.range f) → π S = s → (∀ c : Fin r → MvPolynomial (Fin (r + 1)) R, ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) → RingHom.ker (MvPolynomial.eval₂Hom ψ (Fin.snoc (α := fun _ => As) (fun j => algebraMap A As (π (MvPolynomial.X j))) (IsLocalization.Away.invSelf (S := As) s))) = Ideal.span (Set.range (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Rc) (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i))) (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S) - 1))) → ∀ c' : Fin (r + 1) → MvPolynomial (Fin (r + 1 + 1)) Rc, ∑ i, c' i * (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Rc) (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i))) (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) S) - 1)) i ∈ RingHom.ker (MvPolynomial.eval₂Hom ψ (Fin.snoc (α := fun _ => As) (fun j => algebraMap A As (π (MvPolynomial.X j))) (IsLocalization.Away.invSelf (S := As) s))) ^ 2 → ∀ i, c' i ∈ RingHom.ker (MvPolynomial.eval₂Hom ψ (Fin.snoc (α := fun _ => As) (fun j => algebraMap A As (π (MvPolynomial.X j))) (IsLocalization.Away.invSelf (S := As) s))) :=
by
  intro R A Rc As _ _ _ _ _ _ c s _ _ φ ψ hψ r π f S hsurj hC hker hS hE2 hker' c' hrel
  classical

  have s1 : ∀ (F : Fin r → MvPolynomial (Fin (r + 1)) Rc) (Q : MvPolynomial (Fin (r + 1)) Rc) (J : Ideal (MvPolynomial (Fin (r + 1 + 1)) Rc)), (∀ i, MvPolynomial.rename Fin.castSucc (F i) ∈ J) → MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc Q - 1 ∈ J → ∀ c' : Fin (r + 1) → MvPolynomial (Fin (r + 1 + 1)) Rc, ∑ i, c' i * (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Rc) (fun i => MvPolynomial.rename Fin.castSucc (F i)) (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc Q - 1)) i ∈ J ^ 2 → c' (Fin.last r) ∈ J := by
    intro F Q J hF hg c' hrel
    have D0 : ∀ p : MvPolynomial (Fin (r + 1)) Rc,
        MvPolynomial.pderiv (Fin.last (r + 1)) (MvPolynomial.rename Fin.castSucc p) = 0 := by
      intro p
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro h
      have h' := MvPolynomial.vars_rename Fin.castSucc p h
      obtain ⟨k, _, hk⟩ := Finset.mem_image.mp h'
      exact Fin.castSucc_ne_last k hk
    have hGJ : ∀ i, (Fin.snoc (α := fun _ => MvPolynomial (Fin (r + 1 + 1)) Rc)
        (fun i => MvPolynomial.rename Fin.castSucc (F i))
        (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc Q - 1)) i ∈ J := by
      intro i
      induction i using Fin.lastCases with
      | last => rw [Fin.snoc_last]; exact hg
      | cast i => rw [Fin.snoc_castSucc]; exact hF i
    have hDJ2 : ∀ x ∈ J ^ 2, MvPolynomial.pderiv (Fin.last (r + 1)) x ∈ J := by
      intro x hx
      rw [sq] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro m hm n hn
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact add_mem (J.mul_mem_right _ hm) (J.mul_mem_right _ hn)
      · intro x y hx hy
        rw [map_add]
        exact add_mem hx hy
    have h1 := hDJ2 _ hrel
    rw [map_sum] at h1
    simp only [Derivation.leibniz, smul_eq_mul, Finset.sum_add_distrib] at h1
    rw [Fin.sum_univ_castSucc (f := fun i => c' i * _)] at h1
    simp only [Fin.snoc_castSucc, Fin.snoc_last, D0, mul_zero, Finset.sum_const_zero, zero_add,
      map_sub, Derivation.leibniz, smul_eq_mul, MvPolynomial.pderiv_X_self, mul_one,
      Derivation.map_one_eq_zero, sub_zero] at h1
    have h2 : c' (Fin.last r) * MvPolynomial.rename Fin.castSucc Q ∈ J :=
      (Submodule.add_mem_iff_left _ (Ideal.sum_mem _ (fun i _ => J.mul_mem_right _ (hGJ i)))).mp h1
    have e : c' (Fin.last r) = MvPolynomial.X (Fin.last (r + 1)) *
        (c' (Fin.last r) * MvPolynomial.rename Fin.castSucc Q) -
        c' (Fin.last r) * (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc Q - 1) := by
      ring
    rw [e]
    exact sub_mem (J.mul_mem_left _ h2) (J.mul_mem_left _ hg)

  have s3 : ∀ {P L P' : Type u} [CommRing P] [CommRing L] [CommRing P'] [Algebra P L] (w : P) [IsLocalization.Away w L] (π : P →+* A) (ρ : A →+* As) (κ : P' →+* L) (μ : L →+* As) (π' : P' →+* As) (f : Fin r → P) (ιf : Fin r → P') (I' : Ideal P'), IsUnit (ρ (π w)) → (∀ c : Fin r → P, ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) → (∀ i, κ (ιf i) = algebraMap P L (f i)) → (∀ p, μ (algebraMap P L p) = ρ (π p)) → (∀ p', μ (κ p') = π' p') → (∀ x ∈ I', κ x ∈ Ideal.map (algebraMap P L) (RingHom.ker π)) → ∀ a : Fin r → P', ∑ i, a i * ιf i ∈ I' ^ 2 → ∀ i, π' (a i) = 0 := by
    intro P L P' _ _ _ _ w _ π ρ κ μ π' f ιf I' hu hE2 hκf hμ hμκ hI' a ha i
    have hmapI : Ideal.map κ I' ≤ Ideal.map (algebraMap P L) (RingHom.ker π) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact hI' x hx
    have hy : κ (∑ i, a i * ιf i) ∈ Ideal.map (algebraMap P L) (RingHom.ker π ^ 2) := by
      rw [Ideal.map_pow]
      have h1 : κ (∑ i, a i * ιf i) ∈ Ideal.map κ (I' ^ 2) := Ideal.mem_map_of_mem κ ha
      rw [Ideal.map_pow] at h1
      exact Ideal.pow_right_mono hmapI 2 h1
    have hyκ : κ (∑ i, a i * ιf i) = ∑ i, κ (a i) * algebraMap P L (f i) := by
      simp only [map_sum, map_mul, hκf]
    obtain ⟨b, hint⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers w) Finset.univ
      (fun i => κ (a i))
    choose α hα using fun i => hint i (Finset.mem_univ i)
    have hα' : ∀ i, algebraMap P L (α i) = algebraMap P L (b : P) * κ (a i) := by
      intro i
      rw [hα i, Algebra.smul_def]
    have hz : algebraMap P L (∑ i, α i * f i) ∈ Ideal.map (algebraMap P L) (RingHom.ker π ^ 2) := by
      have e : algebraMap P L (∑ i, α i * f i) = algebraMap P L (b : P) * κ (∑ i, a i * ιf i) := by
        rw [hyκ, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, hα' i]
        ring
      rw [e]
      exact Ideal.mul_mem_left _ _ hy
    obtain ⟨⟨β, m⟩, hβm⟩ := (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers w) L).mp hz
    simp only at hβm
    rw [← map_mul] at hβm
    obtain ⟨n, hn⟩ := IsLocalization.Away.exists_of_eq w hβm
    have hmem : ∑ i, (w ^ n * (m : P) * α i) * f i ∈ RingHom.ker π ^ 2 := by
      have e : ∑ i, (w ^ n * (m : P) * α i) * f i = w ^ n * ((∑ i, α i * f i) * (m : P)) := by
        rw [Finset.sum_mul, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      rw [e, hn]
      exact Ideal.mul_mem_left _ _ β.2
    have hk := hE2 _ hmem i
    rw [RingHom.mem_ker] at hk
    have hk' := congrArg ρ hk
    have e : ρ (π (α i)) = ρ (π (b : P)) * π' (a i) := by
      rw [← hμ, hα' i, map_mul, hμ, hμκ]
    simp only [map_mul, map_pow, map_zero] at hk'
    rw [e] at hk'
    have hmu : IsUnit (ρ (π (m : P))) := by
      obtain ⟨e1, he1⟩ := m.2
      rw [← he1, map_pow, map_pow]
      exact hu.pow e1
    have hbu : IsUnit (ρ (π (b : P))) := by
      obtain ⟨e1, he1⟩ := b.2
      rw [← he1, map_pow, map_pow]
      exact hu.pow e1
    exact hbu.mul_right_eq_zero.mp (((hu.pow n).mul hmu).mul_right_eq_zero.mp hk')

  obtain ⟨w, hw⟩ : ∃ w : MvPolynomial (Fin (r + 1)) R, w = MvPolynomial.C c * S := ⟨_, rfl⟩
  let lam := algebraMap (MvPolynomial (Fin (r + 1)) R) (Localization.Away w)
  have hlw : lam w * IsLocalization.Away.invSelf (S := Localization.Away w) w = 1 :=
    IsLocalization.Away.mul_invSelf w
  have hcu : IsUnit ((lam.comp MvPolynomial.C) c) := by
    refine isUnit_iff_exists_inv.mpr ⟨lam S * IsLocalization.Away.invSelf (S := Localization.Away w) w, ?_⟩
    rw [RingHom.comp_apply, ← mul_assoc, ← map_mul, ← hw]
    exact hlw
  let κ₀ : Rc →+* Localization.Away w := IsLocalization.Away.lift c (S := Rc) hcu
  have hκ₀ : ∀ b : R, κ₀ (algebraMap R Rc b) = lam (MvPolynomial.C b) := fun b =>
    IsLocalization.Away.lift_eq c hcu b
  let σ : Localization.Away w := lam (MvPolynomial.C c) * IsLocalization.Away.invSelf (S := Localization.Away w) w
  have hσ : σ * lam S = 1 := by
    have e : σ * lam S = lam (MvPolynomial.C c * S) *
        IsLocalization.Away.invSelf (S := Localization.Away w) w := by
      simp only [σ, map_mul]; ring
    rw [e, ← hw]
    exact hlw
  let κ : MvPolynomial (Fin (r + 1 + 1)) Rc →+* Localization.Away w :=
    MvPolynomial.eval₂Hom κ₀ (Fin.snoc (α := fun _ => Localization.Away w) (fun j => lam (MvPolynomial.X j)) σ)
  have K1 : ∀ p : MvPolynomial (Fin (r + 1)) R,
      κ (MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) p)) = lam p := by
    intro p
    have h : κ.comp ((MvPolynomial.rename Fin.castSucc).toRingHom.comp
        (MvPolynomial.map (algebraMap R Rc))) = lam := by
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [κ, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_C, MvPolynomial.rename_C, MvPolynomial.eval₂Hom_C]
        exact hκ₀ b
      · intro j
        simp only [κ, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_X, MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc]
    exact congrArg (fun g => g p) h
  have K2 : κ (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc
      (MvPolynomial.map (algebraMap R Rc) S) - 1) = 0 := by
    rw [map_sub, map_mul, K1, map_one]
    have : κ (MvPolynomial.X (Fin.last (r + 1))) = σ := by
      simp only [κ, MvPolynomial.eval₂Hom_X', Fin.snoc_last]
    rw [this, hσ, sub_self]
  have hwu : IsUnit ((algebraMap A As).comp π w) := by
    rw [hw, RingHom.comp_apply, map_mul, map_mul, hC, hS, ← hψ]
    exact (IsUnit.map ψ (IsLocalization.Away.algebraMap_isUnit c)).mul
      (IsLocalization.Away.algebraMap_isUnit s)
  let μ : Localization.Away w →+* As := IsLocalization.Away.lift w (S := Localization.Away w) hwu
  have K3 : ∀ p, μ (lam p) = algebraMap A As (π p) := fun p => IsLocalization.Away.lift_eq w hwu p
  set π' := MvPolynomial.eval₂Hom ψ (Fin.snoc (α := fun _ => As)
    (fun j => algebraMap A As (π (MvPolynomial.X j))) (IsLocalization.Away.invSelf (S := As) s)) with hπ'
  have K4 : ∀ p', μ (κ p') = π' p' := by
    have h : μ.comp κ = π' := by
      apply MvPolynomial.ringHom_ext
      · intro a
        have h0 : μ.comp κ₀ = ψ := by
          apply IsLocalization.ringHom_ext (Submonoid.powers c)
          apply RingHom.ext
          intro b
          simp only [RingHom.comp_apply]
          rw [hκ₀, K3, hC, hψ]
        simp only [RingHom.comp_apply, κ, hπ', MvPolynomial.eval₂Hom_C]
        exact congrArg (fun g => g a) h0
      · intro j
        induction j using Fin.lastCases with
        | last =>
          simp only [RingHom.comp_apply, κ, hπ', MvPolynomial.eval₂Hom_X', Fin.snoc_last]
          have hsu := IsLocalization.Away.algebraMap_isUnit (S := As) s
          apply hsu.mul_left_inj.mp
          have h1 : μ σ * algebraMap A As s = 1 := by
            rw [← hS, ← K3, ← map_mul, hσ, map_one]
          have h2 : IsLocalization.Away.invSelf (S := As) s * algebraMap A As s = 1 := by
            rw [mul_comm]; exact IsLocalization.Away.mul_invSelf s
          rw [h1, h2]
        | cast j =>
          simp only [RingHom.comp_apply, κ, hπ', MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc]
          exact K3 _
    intro p'
    exact congrArg (fun g => g p') h

  have hιJ : ∀ i, MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i)) ∈
      RingHom.ker π' := by
    intro i
    rw [hker']
    exact Ideal.subset_span ⟨i.castSucc, Fin.snoc_castSucc _ _ _⟩
  have hgJ : MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc
      (MvPolynomial.map (algebraMap R Rc) S) - 1 ∈ RingHom.ker π' := by
    rw [hker']
    exact Ideal.subset_span ⟨Fin.last r, Fin.snoc_last _ _⟩
  have hlast : c' (Fin.last r) ∈ RingHom.ker π' :=
    s1 (fun i => MvPolynomial.map (algebraMap R Rc) (f i)) (MvPolynomial.map (algebraMap R Rc) S)
      (RingHom.ker π') hιJ hgJ c' hrel
  have hrel2 := hrel
  rw [Fin.sum_univ_castSucc] at hrel2
  simp only [Fin.snoc_castSucc, Fin.snoc_last] at hrel2
  have hcg : c' (Fin.last r) * (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc
      (MvPolynomial.map (algebraMap R Rc) S) - 1) ∈ RingHom.ker π' ^ 2 := by
    rw [sq]; exact Ideal.mul_mem_mul hlast hgJ
  have hy := (Submodule.add_mem_iff_left _ hcg).mp hrel2
  have hI' : ∀ x ∈ RingHom.ker π', κ x ∈ Ideal.map lam (RingHom.ker π) := by
    intro x hx
    rw [hker'] at hx
    refine (Ideal.span_le.mpr ?_ : _ ≤ (Ideal.map lam (RingHom.ker π)).comap κ) hx
    rintro _ ⟨i, rfl⟩
    induction i using Fin.lastCases with
    | last =>
      rw [SetLike.mem_coe, Ideal.mem_comap, Fin.snoc_last, K2]
      exact zero_mem _
    | cast i =>
      rw [SetLike.mem_coe, Ideal.mem_comap, Fin.snoc_castSucc, K1]
      exact Ideal.mem_map_of_mem _ (hker ▸ Ideal.subset_span ⟨i, rfl⟩)
  intro i
  induction i using Fin.lastCases with
  | last => exact hlast
  | cast i =>
    exact RingHom.mem_ker.mpr (s3 w π (algebraMap A As) κ μ π' f
      (fun i => MvPolynomial.rename Fin.castSucc (MvPolynomial.map (algebraMap R Rc) (f i)))
      (RingHom.ker π') hwu hE2 (fun i => K1 (f i)) K3 K4 hI' (fun i => c' i.castSucc) hy i)

theorem wcpa_dj_lcf_chart_localize : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (V : Y.Opens) (W : T.Opens) (hle : V ≤ q ⁻¹ᵁ W) (r : ℕ) (π : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* Γ(Y, V)) (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W)), IsAffineOpen V → IsAffineOpen W → Function.Surjective π → (∀ c, π (MvPolynomial.C c) = (q.appLE W V hle).hom c) → RingHom.ker π = Ideal.span (Set.range f) → (∀ c : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W), ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) → (∀ v : Γ(Y, V), (∀ j, v * π (wcpaDjJacMinor f j) = 0) → v = 0) → ∀ (s : Γ(Y, V)) (c : Γ(T, W)) (hsc : Y.basicOpen s ≤ q ⁻¹ᵁ T.basicOpen c), ∃ (π' : MvPolynomial (Fin (r + 1 + 1)) Γ(T, T.basicOpen c) →+* Γ(Y, Y.basicOpen s)) (f' : Fin (r + 1) → MvPolynomial (Fin (r + 1 + 1)) Γ(T, T.basicOpen c)), Function.Surjective π' ∧ (∀ c', π' (MvPolynomial.C c') = (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom c') ∧ RingHom.ker π' = Ideal.span (Set.range f') ∧ (∀ c' : Fin (r + 1) → MvPolynomial (Fin (r + 1 + 1)) Γ(T, T.basicOpen c), ∑ i, c' i * f' i ∈ RingHom.ker π' ^ 2 → ∀ i, c' i ∈ RingHom.ker π') ∧ (∀ v : Γ(Y, Y.basicOpen s), (∀ j, v * π' (wcpaDjJacMinor f' j) = 0) → v = 0) ∧ (∀ j : Fin (r + 1), π' (MvPolynomial.X j.castSucc) = (Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op).hom (π (MvPolynomial.X j))) ∧ (∀ j : Fin (r + 1), π' (wcpaDjJacMinor f' j.castSucc) = (Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op).hom (s * π (wcpaDjJacMinor f j))) :=
by
  intro Y T q V W hle r π f hV hW hsurj hC hker hE2 hE3 s c hsc
  classical
  haveI := hW.isLocalization_basicOpen c
  haveI := hV.isLocalization_basicOpen s

  have F1 : ∀ b : Γ(T, W), (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom
      (algebraMap Γ(T, W) Γ(T, T.basicOpen c) b) =
      algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) ((q.appLE W V hle).hom b) := by
    intro b
    have e : T.presheaf.map (homOfLE (T.basicOpen_le c)).op ≫
        q.appLE (T.basicOpen c) (Y.basicOpen s) hsc =
        q.appLE W V hle ≫ Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    exact congrArg (fun g => g.hom b) e
  obtain ⟨S, hS⟩ := hsurj s
  obtain ⟨hsurj', hker'⟩ := wcpa_dj_lcf_cl_presentation c s (q.appLE W V hle).hom
    (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom F1 r π f S hsurj hC hker hS
  have hE2' := wcpa_dj_lcf_cl_conormal c s (q.appLE W V hle).hom
    (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom F1 r π f S hsurj hC hker hS hE2 hker'
  set π' := MvPolynomial.eval₂Hom (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom
    (Fin.snoc (α := fun _ => Γ(Y, Y.basicOpen s))
      (fun j => algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π (MvPolynomial.X j)))
      (IsLocalization.Away.invSelf (S := Γ(Y, Y.basicOpen s)) s)) with hπ'

  have L1 : ∀ p : MvPolynomial (Fin (r + 1)) Γ(T, W),
      π' (MvPolynomial.rename Fin.castSucc
        (MvPolynomial.map (algebraMap Γ(T, W) Γ(T, T.basicOpen c)) p)) =
      algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π p) := by
    intro p
    have h : π'.comp ((MvPolynomial.rename Fin.castSucc).toRingHom.comp
        (MvPolynomial.map (algebraMap Γ(T, W) Γ(T, T.basicOpen c)))) =
        (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s)).comp π := by
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_C, MvPolynomial.rename_C, hπ', MvPolynomial.eval₂Hom_C]
        rw [hC, F1]
      · intro j
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.map_X, MvPolynomial.rename_X, hπ', MvPolynomial.eval₂Hom_X',
          Fin.snoc_castSucc]
    exact congrArg (fun g => g p) h
  have hvii : ∀ j : Fin (r + 1), π' (wcpaDjJacMinor (Fin.snoc (α := fun _ =>
      MvPolynomial (Fin (r + 1 + 1)) Γ(T, T.basicOpen c))
      (fun i => MvPolynomial.rename Fin.castSucc
        (MvPolynomial.map (algebraMap Γ(T, W) Γ(T, T.basicOpen c)) (f i)))
      (MvPolynomial.X (Fin.last (r + 1)) * MvPolynomial.rename Fin.castSucc
        (MvPolynomial.map (algebraMap Γ(T, W) Γ(T, T.basicOpen c)) S) - 1)) j.castSucc) =
      algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (s * π (wcpaDjJacMinor f j)) := by
    intro j
    rw [wcpa_dj_lcf_cl_minor_adjoin (algebraMap Γ(T, W) Γ(T, T.basicOpen c)) r f S j, map_mul,
      L1, L1, hS, ← map_mul]
  refine ⟨π', _, hsurj', ?_, hker', hE2', ?_, ?_, hvii⟩
  · intro c'
    exact MvPolynomial.eval₂Hom_C _ _ _
  ·
    intro v hv
    have hu : IsUnit (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) s) :=
      IsLocalization.Away.algebraMap_isUnit s
    have h1 : ∀ j, v * algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π (wcpaDjJacMinor f j)) = 0 := by
      intro j
      have h := hv j.castSucc
      rw [hvii j, map_mul] at h
      have h' : algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) s *
          (v * algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π (wcpaDjJacMinor f j))) = 0 := by
        rw [← h]; ring
      exact hu.mul_right_eq_zero.mp h'
    obtain ⟨⟨a, m⟩, hm⟩ := IsLocalization.surj (Submonoid.powers s) v
    simp only at hm
    have h2 : ∀ j, algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (a * π (wcpaDjJacMinor f j)) = 0 := by
      intro j
      rw [map_mul, ← hm]
      calc v * algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (m : Γ(Y, V)) *
            algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π (wcpaDjJacMinor f j))
          = algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (m : Γ(Y, V)) *
            (v * algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π (wcpaDjJacMinor f j))) := by ring
        _ = 0 := by rw [h1 j, mul_zero]
    have h3 : ∀ j, ∃ m' : Submonoid.powers s,
        (m' : Γ(Y, V)) * (a * π (wcpaDjJacMinor f j)) = 0 := fun j =>
      (IsLocalization.map_eq_zero_iff (Submonoid.powers s) Γ(Y, Y.basicOpen s) _).mp (h2 j)
    choose mj hmj using h3
    have hMmem : (∏ j, (mj j : Γ(Y, V))) ∈ Submonoid.powers s :=
      Submonoid.prod_mem _ (fun j _ => (mj j).2)
    have h4 : (∏ j, (mj j : Γ(Y, V))) * a = 0 := by
      apply hE3
      intro j
      rw [← Finset.prod_erase_mul _ _ (Finset.mem_univ j)]
      calc (∏ k ∈ Finset.univ.erase j, (mj k : Γ(Y, V))) * (mj j : Γ(Y, V)) * a *
            π (wcpaDjJacMinor f j)
          = (∏ k ∈ Finset.univ.erase j, (mj k : Γ(Y, V))) *
            ((mj j : Γ(Y, V)) * (a * π (wcpaDjJacMinor f j))) := by ring
        _ = 0 := by rw [hmj j, mul_zero]
    have hMu : IsUnit (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (∏ j, (mj j : Γ(Y, V)))) :=
      IsLocalization.map_units Γ(Y, Y.basicOpen s)
        (⟨_, hMmem⟩ : Submonoid.powers s)
    have h5 : algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) a = 0 := by
      have h := congrArg (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s)) h4
      rw [map_mul, map_zero] at h
      exact hMu.mul_right_eq_zero.mp h
    have hmu : IsUnit (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (m : Γ(Y, V))) :=
      IsLocalization.map_units Γ(Y, Y.basicOpen s) m
    rw [h5] at hm
    exact hmu.mul_left_eq_zero.mp hm
  · intro j
    simp only [hπ', MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc]
    rfl

theorem wcpa_dj_lcfg_kaehler_restrict : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (O O' : Y.Opens) (U U' : T.Opens) (hO : O' ≤ O) (hU : U' ≤ U) (h1 : O ≤ q ⁻¹ᵁ U) (h2 : O' ≤ q ⁻¹ᵁ U') (m : ℕ) (a x : Fin m → Γ(Y, O)), (letI : Algebra Γ(T, U) Γ(Y, O) := (q.appLE U O h1).hom.toAlgebra; ∑ i, a i • KaehlerDifferential.D Γ(T, U) Γ(Y, O) (x i) = 0) → (letI : Algebra Γ(T, U') Γ(Y, O') := (q.appLE U' O' h2).hom.toAlgebra; ∑ i, (Y.presheaf.map (homOfLE hO).op).hom (a i) • KaehlerDifferential.D Γ(T, U') Γ(Y, O') ((Y.presheaf.map (homOfLE hO).op).hom (x i)) = 0) :=
by
  intro Y T q O O' U U' hO hU h1 h2 m a x H
  letI iRA : Algebra Γ(T, U) Γ(Y, O) := (q.appLE U O h1).hom.toAlgebra
  letI iSB : Algebra Γ(T, U') Γ(Y, O') := (q.appLE U' O' h2).hom.toAlgebra
  letI iAB : Algebra Γ(Y, O) Γ(Y, O') := (Y.presheaf.map (homOfLE hO).op).hom.toAlgebra
  letI iRS : Algebra Γ(T, U) Γ(T, U') := (T.presheaf.map (homOfLE hU).op).hom.toAlgebra
  letI iRB : Algebra Γ(T, U) Γ(Y, O') := (q.appLE U O' (hO.trans h1)).hom.toAlgebra
  haveI t1 : IsScalarTower Γ(T, U) Γ(Y, O) Γ(Y, O') := IsScalarTower.of_algebraMap_eq (fun c => by
    show (q.appLE U O' _).hom c = (Y.presheaf.map (homOfLE hO).op).hom ((q.appLE U O h1).hom c)
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map])
  haveI t2 : IsScalarTower Γ(T, U) Γ(T, U') Γ(Y, O') := IsScalarTower.of_algebraMap_eq (fun c => by
    show (q.appLE U O' _).hom c = (q.appLE U' O' h2).hom ((T.presheaf.map (homOfLE hU).op).hom c)
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE])
  haveI t3 : SMulCommClass Γ(T, U') Γ(Y, O) Γ(Y, O') := ⟨fun s a b => by
    simp only [Algebra.smul_def]; exact mul_left_comm _ _ _⟩
  have E := congrArg (KaehlerDifferential.map Γ(T, U) Γ(T, U') Γ(Y, O) Γ(Y, O')) H
  simp only [map_sum, map_smul, KaehlerDifferential.map_D, map_zero] at E
  show ∑ i, (Y.presheaf.map (homOfLE hO).op).hom (a i) • KaehlerDifferential.D Γ(T, U') Γ(Y, O') ((Y.presheaf.map (homOfLE hO).op).hom (x i)) = 0
  rw [← E]
  refine Finset.sum_congr rfl fun i _ => ?_
  exact algebraMap_smul Γ(Y, O') (a i) _

theorem wcpa_dj_lcfg_kaehler_local : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (O : Y.Opens) (U : T.Opens) (h1 : O ≤ q ⁻¹ᵁ U), IsAffineOpen O → ∀ (m : ℕ) (a x : Fin m → Γ(Y, O)), (∀ z ∈ O, ∃ s : Γ(Y, O), z ∈ Y.basicOpen s ∧ (letI : Algebra Γ(T, U) Γ(Y, Y.basicOpen s) := (q.appLE U (Y.basicOpen s) ((Y.basicOpen_le s).trans h1)).hom.toAlgebra; ∑ i, (Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op).hom (a i) • KaehlerDifferential.D Γ(T, U) Γ(Y, Y.basicOpen s) ((Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op).hom (x i)) = 0)) → (letI : Algebra Γ(T, U) Γ(Y, O) := (q.appLE U O h1).hom.toAlgebra; ∑ i, a i • KaehlerDifferential.D Γ(T, U) Γ(Y, O) (x i) = 0) :=
by
  intro Y T q O U h1 hO m a x H
  letI : Algebra Γ(T, U) Γ(Y, O) := (q.appLE U O h1).hom.toAlgebra
  have span_kill : ∀ (S : Set Γ(Y, O)) (τ : Ω[Γ(Y, O)⁄Γ(T, U)]), Ideal.span S = ⊤ →
      (∀ s ∈ S, ∃ e : ℕ, s ^ e • τ = 0) → τ = 0 := by
    intro S τ hS hpow
    have hrad : (Submodule.span Γ(Y, O) {τ}).annihilator.radical = ⊤ := by
      rw [eq_top_iff, ← hS, Ideal.span_le]
      intro s hs
      obtain ⟨e, he⟩ := hpow s hs
      exact ⟨e, (Submodule.mem_annihilator_span_singleton _ _).mpr he⟩
    have htop := Ideal.radical_eq_top.mp hrad
    have h1m : (1 : Γ(Y, O)) ∈ (Submodule.span Γ(Y, O) {τ}).annihilator := by
      rw [htop]; trivial
    simpa using (Submodule.mem_annihilator_span_singleton _ _).mp h1m
  choose s hs hrel using H
  apply span_kill (Set.range (fun p : {z // z ∈ O} => s p.1 p.2))
  · rw [← hO.self_le_iSup_basicOpen_iff]
    intro z hz
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨s z hz, ⟨⟨z, hz⟩, rfl⟩⟩, hs z hz⟩
  · rintro _ ⟨⟨z, hz⟩, rfl⟩
    have hr := hrel z hz
    letI : Algebra Γ(T, U) Γ(Y, Y.basicOpen (s z hz)) :=
      (q.appLE U (Y.basicOpen (s z hz)) ((Y.basicOpen_le (s z hz)).trans h1)).hom.toAlgebra
    haveI : IsLocalization.Away (s z hz) Γ(Y, Y.basicOpen (s z hz)) :=
      hO.isLocalization_basicOpen (s z hz)
    haveI : IsScalarTower Γ(T, U) Γ(Y, O) Γ(Y, Y.basicOpen (s z hz)) := by
      apply IsScalarTower.of_algebraMap_eq
      intro c
      have e := Scheme.Hom.appLE_map q h1 (homOfLE (Y.basicOpen_le (s z hz))).op
      have e2 := congrArg (fun f => f.hom c) e
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
      exact e2.symm
    have hloc := KaehlerDifferential.isLocalizedModule_map Γ(T, U) Γ(Y, O)
      Γ(Y, Y.basicOpen (s z hz)) (Submonoid.powers (s z hz))
    have hmap : KaehlerDifferential.map Γ(T, U) Γ(T, U) Γ(Y, O) Γ(Y, Y.basicOpen (s z hz))
        (∑ i, a i • KaehlerDifferential.D Γ(T, U) Γ(Y, O) (x i)) = 0 := by
      rw [map_sum]
      simp only [LinearMap.map_smul, KaehlerDifferential.map_D]
      rw [← hr]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← algebraMap_smul Γ(Y, Y.basicOpen (s z hz))]
      rfl
    obtain ⟨c, hc⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers (s z hz))
      (KaehlerDifferential.map Γ(T, U) Γ(T, U) Γ(Y, O) Γ(Y, Y.basicOpen (s z hz)))).mp hmap
    obtain ⟨e, he⟩ := Submonoid.mem_powers_iff _ _ |>.mp c.2
    refine ⟨e, ?_⟩
    rw [he]
    exact hc

theorem wcpa_dj_lcfg_glue_units : ∀ {Y : Scheme.{u}} (O : Y.Opens) (ι : Type u) (D : ι → Y.Opens) (hD : ∀ i, D i ≤ O), O ≤ (⨆ i, D i) → ∀ γ : ∀ i, (Γ(Y, D i))ˣ, (∀ i j, (Y.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom (γ i : Γ(Y, D i)) = (Y.presheaf.map (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom (γ j : Γ(Y, D j))) → ∃ g : (Γ(Y, O))ˣ, ∀ i, (Y.presheaf.map (homOfLE (hD i)).op).hom (g : Γ(Y, O)) = γ i :=
by
  intro Y O ι D hD hcov γ hγ
  have hinv : ∀ i j, (Y.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom
      (↑(γ i)⁻¹ : Γ(Y, D i)) =
      (Y.presheaf.map (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom
      (↑(γ j)⁻¹ : Γ(Y, D j)) := by
    intro i j
    set lf := (Y.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom
    set mf := (Y.presheaf.map (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom
    have e := hγ i j
    have h1 : lf (↑(γ i)⁻¹ : Γ(Y, D i)) * lf (γ i : Γ(Y, D i)) = 1 := by
      rw [← map_mul, Units.inv_mul, map_one]
    have h2 : mf (γ j : Γ(Y, D j)) * mf (↑(γ j)⁻¹ : Γ(Y, D j)) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    calc lf (↑(γ i)⁻¹ : Γ(Y, D i))
        = lf (↑(γ i)⁻¹ : Γ(Y, D i)) * (mf (γ j : Γ(Y, D j)) * mf (↑(γ j)⁻¹ : Γ(Y, D j))) := by
          rw [h2, mul_one]
      _ = (lf (↑(γ i)⁻¹ : Γ(Y, D i)) * lf (γ i : Γ(Y, D i))) * mf (↑(γ j)⁻¹ : Γ(Y, D j)) := by
          rw [e, mul_assoc]
      _ = mf (↑(γ j)⁻¹ : Γ(Y, D j)) := by rw [h1, one_mul]
  obtain ⟨s, hs, -⟩ : ∃! s : Γ(Y, O), ∀ i,
      (Y.presheaf.map (homOfLE (hD i)).op).hom s = (γ i : Γ(Y, D i)) :=
    Y.sheaf.existsUnique_gluing' D O (fun i => homOfLE (hD i)) hcov
      (fun i => (γ i : Γ(Y, D i))) (fun i j => hγ i j)
  obtain ⟨t, ht, -⟩ : ∃! t : Γ(Y, O), ∀ i,
      (Y.presheaf.map (homOfLE (hD i)).op).hom t = (↑(γ i)⁻¹ : Γ(Y, D i)) :=
    Y.sheaf.existsUnique_gluing' D O (fun i => homOfLE (hD i)) hcov
      (fun i => (↑(γ i)⁻¹ : Γ(Y, D i))) (fun i j => hinv i j)
  have hloc : ∀ a b : Γ(Y, O), (∀ i, (Y.presheaf.map (homOfLE (hD i)).op).hom a =
      (Y.presheaf.map (homOfLE (hD i)).op).hom b) → a = b := fun a b h =>
    Y.sheaf.eq_of_locally_eq' D O (fun i => homOfLE (hD i)) hcov a b h
  have hst : s * t = 1 := by
    apply hloc
    intro i
    rw [map_mul, map_one, hs i, ht i, Units.mul_inv]
  refine ⟨⟨s, t, hst, by rw [mul_comm]; exact hst⟩, fun i => hs i⟩

theorem wcpa_dj_lcfg_local_annih : ∀ {Y : Scheme.{u}} (V : Y.Opens) (r n : ℕ) (Δ : Fin (r + 1) → Γ(Y, V)) (h : Fin n → Γ(Y, V)), IsAffineOpen V → (∀ i, h i ∈ nonZeroDivisors Γ(Y, V)) → (∀ v : Γ(Y, V), (∀ j, v * Δ j = 0) → v = 0) → ∀ (O : Y.Opens) (hOV : O ≤ V) (w : Γ(Y, O)), (∀ j, w * (Y.presheaf.map (homOfLE hOV).op).hom ((∏ i, h i) * Δ j) = 0) → w = 0 :=
by
  intro Y V r n Δ h hV hh hΔ O hOV w hw
  have hH : (∏ i, h i) ∈ nonZeroDivisors Γ(Y, V) := prod_mem (fun i _ => hh i)
  have hAnn : ∀ v : Γ(Y, V), (∀ j, v * ((∏ i, h i) * Δ j) = 0) → v = 0 := by
    intro v hv
    have h1 : v * (∏ i, h i) = 0 := hΔ _ (fun j => by rw [mul_assoc]; exact hv j)
    exact (mem_nonZeroDivisors_iff.mp hH).2 v h1
  have loc : ∀ {B : Type u} [CommRing B] [Algebra Γ(Y, V) B] (M : Submonoid Γ(Y, V))
      [IsLocalization M B] (b : B),
      (∀ j, b * algebraMap Γ(Y, V) B ((∏ i, h i) * Δ j) = 0) → b = 0 := by
    intro B _ _ M _ b hb
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective M b
    have hspec := IsLocalization.mk'_spec B a s
    have hj : ∀ j, ∃ m : M, (m : Γ(Y, V)) * (a * ((∏ i, h i) * Δ j)) = 0 := by
      intro j
      rw [← IsLocalization.map_eq_zero_iff M B, map_mul, ← hspec]
      calc IsLocalization.mk' B a s * algebraMap Γ(Y, V) B (s : Γ(Y, V)) *
            algebraMap Γ(Y, V) B ((∏ i, h i) * Δ j)
          = (IsLocalization.mk' B a s * algebraMap Γ(Y, V) B ((∏ i, h i) * Δ j)) *
            algebraMap Γ(Y, V) B (s : Γ(Y, V)) := by ring
        _ = 0 := by rw [hb j, zero_mul]
    choose m hm using hj
    have ht : (∏ j, (m j : Γ(Y, V))) * a = 0 := by
      apply hAnn
      intro j
      rw [← Finset.mul_prod_erase Finset.univ (fun j => (m j : Γ(Y, V))) (Finset.mem_univ j)]
      calc ((m j : Γ(Y, V)) * ∏ i ∈ Finset.univ.erase j, (m i : Γ(Y, V))) * a *
            ((∏ i, h i) * Δ j)
          = (∏ i ∈ Finset.univ.erase j, (m i : Γ(Y, V))) *
            ((m j : Γ(Y, V)) * (a * ((∏ i, h i) * Δ j))) := by ring
        _ = 0 := by rw [hm j, mul_zero]
    have ha : algebraMap Γ(Y, V) B a = 0 := by
      rw [IsLocalization.map_eq_zero_iff M B]
      exact ⟨⟨∏ j, (m j : Γ(Y, V)), prod_mem (fun j _ => (m j).2)⟩, ht⟩
    rw [ha] at hspec
    exact (IsLocalization.map_units B s).mul_left_eq_zero.mp hspec
  apply TopCat.Presheaf.section_ext Y.sheaf O w 0
  intro x hx
  rw [map_zero]
  let x' : V := ⟨x, hOV hx⟩
  letI : Algebra Γ(Y, V) (Y.presheaf.stalk (x' : Y)) := Y.presheaf.algebra_section_stalk x'
  have hloc := hV.isLocalization_stalk x'
  apply loc (B := Y.presheaf.stalk (x' : Y)) (hV.primeIdealOf x').asIdeal.primeCompl
  intro j
  rw [TopCat.Presheaf.stalk_open_algebraMap]
  have e := TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hOV) x hx ((∏ i, h i) * Δ j)
  rw [← e]
  change (Y.presheaf.germ O x hx).hom w * (Y.presheaf.germ O x hx).hom
    ((Y.presheaf.map (homOfLE hOV).op).hom ((∏ i, h i) * Δ j)) = 0
  rw [← map_mul, hw j, map_zero]

theorem wcpa_dj_lcfg_local_rigid : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (V : Y.Opens) (W : T.Opens) (hle : V ≤ q ⁻¹ᵁ W) (r : ℕ) (π : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* Γ(Y, V)) (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W)), IsAffineOpen V → IsAffineOpen W → Function.Surjective π → (∀ c, π (MvPolynomial.C c) = (q.appLE W V hle).hom c) → RingHom.ker π = Ideal.span (Set.range f) → (∀ c : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W), ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) → (∀ v : Γ(Y, V), (∀ j, v * π (wcpaDjJacMinor f j) = 0) → v = 0) → ∀ (O : Y.Opens) (U : T.Opens) (hOV : O ≤ V) (hOU : O ≤ q ⁻¹ᵁ U) (v : Γ(Y, O)), (letI : Algebra Γ(T, U) Γ(Y, O) := (q.appLE U O hOU).hom.toAlgebra; ∀ k, v • KaehlerDifferential.D Γ(T, U) Γ(Y, O) ((Y.presheaf.map (homOfLE hOV).op).hom (π (MvPolynomial.X k))) = 0) → v = 0 :=
by
  intro Y T q V W hle r π f hV hW hsurj hC hker hE2 hE3 O U hOV hOU v hv
  classical

  have rigidity : ∀ {R B : Type u} [CommRing R] [CommRing B] [Algebra R B] (r : ℕ)
      (π : MvPolynomial (Fin (r + 1)) R →+* B) (f : Fin r → MvPolynomial (Fin (r + 1)) R),
      Function.Surjective π → (∀ c, π (MvPolynomial.C c) = algebraMap R B c) →
      RingHom.ker π = Ideal.span (Set.range f) → ∀ v : B,
      (∀ k, v • KaehlerDifferential.D R B (π (MvPolynomial.X k)) = 0) →
      ∀ k, v * π (wcpaDjJacMinor f k) = 0 := by
    intro R B _ _ _ r π f hsurj hC hker v hv
    classical

    let L : MvPolynomial (Fin (r + 1)) R →ₗ[R] MvPolynomial (Fin (r + 1)) R :=
      ∑ l, (LinearMap.mulLeft R (wcpaDjJacMinor f l)) ∘ₗ
        (MvPolynomial.pderiv l : Derivation R _ _).toLinearMap
    have hL : ∀ p, L p = ∑ l, wcpaDjJacMinor f l * MvPolynomial.pderiv l p := by
      intro p
      simp [L, LinearMap.sum_apply]
    let θ : Derivation R (MvPolynomial (Fin (r + 1)) R) (MvPolynomial (Fin (r + 1)) R) :=
      Derivation.mk' L (by
        intro a b
        rw [hL, hL, hL, smul_eq_mul, smul_eq_mul, Finset.mul_sum, Finset.mul_sum,
          ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        ring)
    have hθ : ∀ p, θ p = ∑ l, wcpaDjJacMinor f l * MvPolynomial.pderiv l p := hL

    have hθX : ∀ k, θ (MvPolynomial.X k) = wcpaDjJacMinor f k := by
      intro k
      rw [hθ]
      simp [MvPolynomial.pderiv_X, Pi.single_apply]

    have hθf : ∀ i, θ (f i) = 0 := by
      intro i
      let Q : Matrix (Fin (r + 1)) (Fin (r + 1)) (MvPolynomial (Fin (r + 1)) R) :=
        Matrix.of (Fin.snoc (α := fun _ => Fin (r + 1) → MvPolynomial (Fin (r + 1)) R)
          (fun i' l => MvPolynomial.pderiv l (f i')) (fun l => MvPolynomial.pderiv l (f i)))
      have hQ0 : Q.det = 0 := by
        apply Matrix.det_zero_of_row_eq (Fin.castSucc_ne_last i)
        funext l
        simp [Q, Fin.snoc_castSucc, Fin.snoc_last]
      rw [Matrix.det_succ_row Q (Fin.last r)] at hQ0
      have hQ1 : ∑ j : Fin (r + 1), (-1 : MvPolynomial (Fin (r + 1)) R) ^ ((Fin.last r : ℕ) + (j : ℕ)) *
          Q (Fin.last r) j * (Q.submatrix (Fin.last r).succAbove j.succAbove).det =
          (-1) ^ r * θ (f i) := by
        rw [hθ, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        have e1 : Q (Fin.last r) j = MvPolynomial.pderiv j (f i) := by
          simp [Q, Fin.snoc_last]
        have e2 : (Q.submatrix (Fin.last r).succAbove j.succAbove).det =
            Matrix.det (Matrix.of fun (i' l : Fin r) => MvPolynomial.pderiv (j.succAbove l) (f i')) := by
          congr 1
          ext i' l
          simp [Q, Fin.succAbove_last, Fin.snoc_castSucc]
        rw [e1, e2, Fin.val_last, pow_add, wcpaDjJacMinor]
        ring
      rw [hQ1] at hQ0
      exact neg_one_pow_mul_eq_zero_iff.mp hQ0

    have hfker : ∀ i, π (f i) = 0 := by
      intro i
      have : f i ∈ RingHom.ker π := by rw [hker]; exact Ideal.subset_span ⟨i, rfl⟩
      exact this
    have hd : ∀ p, π p = 0 → π (θ p) = 0 := by
      intro p hp
      have hp' : p ∈ Ideal.span (Set.range f) := by rw [← hker]; exact hp
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hp'
      simp only [smul_eq_mul, map_sum, Derivation.leibniz, hθf, smul_zero, zero_add, map_mul,
        hfker, zero_mul, mul_zero, Finset.sum_const_zero]
    let πa : MvPolynomial (Fin (r + 1)) R →ₐ[R] B :=
      AlgHom.mk π (fun c => hC c)
    let θB : Derivation R B B := Derivation.liftOfSurjective (f := πa) hsurj hd
    have hθB : ∀ p, θB (π p) = π (θ p) := fun p => Derivation.liftOfSurjective_apply (f := πa) hsurj hd p
    intro k
    have h := congrArg θB.liftKaehlerDifferential (hv k)
    rw [map_smul, Derivation.liftKaehlerDifferential_comp_D, map_zero, hθB, hθX, smul_eq_mul] at h
    exact h

  have kills_all : ∀ {R R' A B : Type u} [CommRing R] [CommRing R'] [CommRing A] [CommRing B]
      [Algebra R' B] (ι : R →+* R') (ρ : A →+* B) (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* A)
      (s : A), Function.Surjective π → (∀ c, ρ (π (MvPolynomial.C c)) = algebraMap R' B (ι c)) →
      IsUnit (ρ s) → (∀ b : B, ∃ (a : A) (e : ℕ), b * ρ s ^ e = ρ a) → ∀ v : B,
      (∀ k, v • KaehlerDifferential.D R' B (ρ (π (MvPolynomial.X k))) = 0) →
      ∀ b, v • KaehlerDifferential.D R' B b = 0 := by
    intro R R' A B _ _ _ _ _ ι ρ r π s hsurj hC hs hfrac v hv
    have hA : ∀ p, v • KaehlerDifferential.D R' B (ρ (π p)) = 0 := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c => rw [hC, Derivation.map_algebraMap, smul_zero]
      | add p q hp hq => rw [map_add, map_add, map_add, smul_add, hp, hq, add_zero]
      | mul_X p n hp =>
        rw [map_mul, map_mul, Derivation.leibniz, smul_add, smul_comm v (ρ (π p)),
          smul_comm v (ρ (π (MvPolynomial.X n))), hv n, hp, smul_zero, smul_zero, add_zero]
    have hB : ∀ a, v • KaehlerDifferential.D R' B (ρ a) = 0 := by
      intro a
      obtain ⟨p, rfl⟩ := hsurj a
      exact hA p
    intro b
    obtain ⟨a, e, hb⟩ := hfrac b
    have hu : IsUnit (ρ s ^ e) := hs.pow e
    have h1 : v • KaehlerDifferential.D R' B (ρ s ^ e) = 0 := by
      rw [← map_pow]; exact hB _
    have h2 := hB a
    rw [← hb, Derivation.leibniz, smul_add, smul_comm v b, h1, smul_zero, zero_add,
      smul_comm v (ρ s ^ e)] at h2
    obtain ⟨w, hw⟩ := hu.exists_left_inv
    rw [← one_smul B (v • KaehlerDifferential.D R' B b), ← hw, mul_smul, h2, smul_zero]
  have resres : ∀ {O1 O2 O3 : Y.Opens} (h12 : O2 ≤ O1) (h23 : O3 ≤ O2) (x : Γ(Y, O1)),
      (Y.presheaf.map (homOfLE h23).op).hom ((Y.presheaf.map (homOfLE h12).op).hom x) =
        (Y.presheaf.map (homOfLE (h23.trans h12)).op).hom x := by
    intro O1 O2 O3 h12 h23 x
    show (Y.presheaf.map (homOfLE h12).op ≫ Y.presheaf.map (homOfLE h23).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  apply TopCat.Presheaf.section_ext Y.sheaf O v 0
  intro z hz
  rw [map_zero]

  obtain ⟨c, hcU, hzc⟩ := hW.exists_basicOpen_le (V := U) ⟨q z, hOU hz⟩ (hle (hOV hz))

  have hzN : z ∈ O ⊓ q ⁻¹ᵁ T.basicOpen c := ⟨hz, hzc⟩
  obtain ⟨s, hsN, hzs⟩ := hV.exists_basicOpen_le (V := O ⊓ q ⁻¹ᵁ T.basicOpen c) ⟨z, hzN⟩ (hOV hz)
  have hsO : Y.basicOpen s ≤ O := hsN.trans inf_le_left
  have hsc : Y.basicOpen s ≤ q ⁻¹ᵁ T.basicOpen c := hsN.trans inf_le_right

  obtain ⟨π', f', hsurj', hC', hker', -, hE3', -, -⟩ :=
    wcpa_dj_lcf_chart_localize q V W hle r π f hV hW hsurj hC hker hE2 hE3 s c hsc

  have hT : ∀ k, (letI : Algebra Γ(T, T.basicOpen c) Γ(Y, Y.basicOpen s) :=
      (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom.toAlgebra;
      (Y.presheaf.map (homOfLE hsO).op).hom v • KaehlerDifferential.D Γ(T, T.basicOpen c)
        Γ(Y, Y.basicOpen s)
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op).hom (π (MvPolynomial.X k))) = 0) := by
    intro k
    have H := wcpa_dj_lcfg_kaehler_restrict q O (Y.basicOpen s) U (T.basicOpen c) hsO hcU hOU hsc 1
      ![v] ![(Y.presheaf.map (homOfLE hOV).op).hom (π (MvPolynomial.X k))]
      (by simp only [Fin.sum_univ_one, Matrix.cons_val_zero]; exact hv k)
    simp only [Fin.sum_univ_one, Matrix.cons_val_zero] at H
    rw [resres] at H
    exact H
  letI : Algebra Γ(T, T.basicOpen c) Γ(Y, Y.basicOpen s) :=
    (q.appLE (T.basicOpen c) (Y.basicOpen s) hsc).hom.toAlgebra
  haveI := hV.isLocalization_basicOpen s

  have hcompat : ∀ c₀ : Γ(T, W),
      algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) (π (MvPolynomial.C c₀)) =
        algebraMap Γ(T, T.basicOpen c) Γ(Y, Y.basicOpen s)
          ((T.presheaf.map (homOfLE (T.basicOpen_le c)).op).hom c₀) := by
    intro c₀
    have e : T.presheaf.map (homOfLE (T.basicOpen_le c)).op ≫
        q.appLE (T.basicOpen c) (Y.basicOpen s) hsc =
        q.appLE W V hle ≫ Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    rw [hC]
    exact (congrArg (fun g => g.hom c₀) e).symm
  have hunit : IsUnit (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) s) :=
    IsLocalization.Away.algebraMap_isUnit s
  have hfrac : ∀ b : Γ(Y, Y.basicOpen s), ∃ (a : Γ(Y, V)) (e : ℕ),
      b * algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) s ^ e = algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s) a := by
    intro b
    obtain ⟨⟨a, m⟩, hm⟩ := IsLocalization.surj (Submonoid.powers s) b
    obtain ⟨e, he⟩ := m.2
    refine ⟨a, e, ?_⟩
    have he' : s ^ e = (m : Γ(Y, V)) := he
    rw [← map_pow, he']
    exact hm
  have hK := kills_all (T.presheaf.map (homOfLE (T.basicOpen_le c)).op).hom
    (algebraMap Γ(Y, V) Γ(Y, Y.basicOpen s)) r π s hsurj hcompat hunit hfrac
    ((Y.presheaf.map (homOfLE hsO).op).hom v) (fun k => hT k)

  have hR := rigidity (r + 1) π' f' hsurj' (fun c' => hC' c') hker'
    ((Y.presheaf.map (homOfLE hsO).op).hom v) (fun l => hK _)

  have hv0 := hE3' _ hR

  have e := TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hsO) z hzs v
  change (Y.presheaf.germ O z hz).hom v = 0
  rw [← e, hv0, map_zero]

theorem wcpa_dj_lcfg_pair_unit : ∀ {R B : Type u} [CommRing R] [CommRing B] [Algebra R B] (r p : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* B) (f : Fin r → MvPolynomial (Fin (r + 1)) R) (π' : MvPolynomial (Fin (p + 1)) R →+* B) (f' : Fin p → MvPolynomial (Fin (p + 1)) R), Function.Surjective π → Function.Surjective π' → (∀ c, π (MvPolynomial.C c) = algebraMap R B c) → (∀ c, π' (MvPolynomial.C c) = algebraMap R B c) → RingHom.ker π = Ideal.span (Set.range f) → RingHom.ker π' = Ideal.span (Set.range f') → (∀ c : Fin r → MvPolynomial (Fin (r + 1)) R, ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) → ∃ u : Bˣ, ∀ (j : Fin (r + 1)) (k : Fin (p + 1)), ((u : B) * π (wcpaDjJacMinor f j)) • KaehlerDifferential.D R B (π' (MvPolynomial.X k)) = π' (wcpaDjJacMinor f' k) • KaehlerDifferential.D R B (π (MvPolynomial.X j)) :=
by
  intro R B _ _ _
  have s1 : ∀ (n : ℕ) (π : MvPolynomial (Fin n) R →+* B), (∀ c, π (MvPolynomial.C c) = algebraMap R B c) → ∀ P : MvPolynomial (Fin n) R, KaehlerDifferential.D R B (π P) = ∑ l, π (MvPolynomial.pderiv l P) • KaehlerDifferential.D R B (π (MvPolynomial.X l)) := by
    intro n π hC P
    induction P using MvPolynomial.induction_on with
    | C a => simp [hC]
    | add p q hp hq => simp only [map_add, hp, hq, add_smul, Finset.sum_add_distrib]
    | mul_X p i ih =>
      have e : ∀ l, π (MvPolynomial.pderiv l (p * MvPolynomial.X i)) • KaehlerDifferential.D R B (π (MvPolynomial.X l)) = π (MvPolynomial.X i) • (π (MvPolynomial.pderiv l p) • KaehlerDifferential.D R B (π (MvPolynomial.X l))) + (if i = l then π p • KaehlerDifferential.D R B (π (MvPolynomial.X l)) else 0) := by
        intro l
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, Pi.single_apply]
        split_ifs with h
        · rw [map_add, map_mul, map_mul, map_one, mul_one, add_smul, smul_smul, mul_comm]
        · rw [map_add, map_mul, map_mul, map_zero, mul_zero, add_zero, add_zero, smul_smul, mul_comm]
      rw [Finset.sum_congr rfl (fun l _ => e l), Finset.sum_add_distrib, ← Finset.smul_sum, ← ih,
        Finset.sum_ite_eq, if_pos (Finset.mem_univ _), map_mul, Derivation.leibniz]
      exact add_comm _ _
  have s4 : ∀ (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) (e : Fin n → MvPolynomial (Fin n) R), (∀ l, e l ∈ I) → ∀ Q : MvPolynomial (Fin n) R, MvPolynomial.aeval (fun l => MvPolynomial.X l + e l) Q - Q - ∑ l, MvPolynomial.pderiv l Q * e l ∈ I ^ 2 := by
    intro n I e he Q
    induction Q using MvPolynomial.induction_on with
    | C a => simp [MvPolynomial.algebraMap_eq]
    | add p q hp hq =>
      have : MvPolynomial.aeval (fun l => MvPolynomial.X l + e l) (p + q) - (p + q) - ∑ l, MvPolynomial.pderiv l (p + q) * e l = (MvPolynomial.aeval (fun l => MvPolynomial.X l + e l) p - p - ∑ l, MvPolynomial.pderiv l p * e l) + (MvPolynomial.aeval (fun l => MvPolynomial.X l + e l) q - q - ∑ l, MvPolynomial.pderiv l q * e l) := by
        simp only [map_add, add_mul, Finset.sum_add_distrib]; ring
      rw [this]; exact add_mem hp hq
    | mul_X p i ih =>
      have h2 : ∑ l, p * ((Pi.single l 1 : Fin n → MvPolynomial (Fin n) R) i) * e l = p * e i := by
        rw [Finset.sum_eq_single i]
        · simp
        · intro b _ hb; simp [Ne.symm hb]
        · simp
      have hs : ∑ l, MvPolynomial.pderiv l (p * MvPolynomial.X i) * e l = (∑ l, MvPolynomial.pderiv l p * e l) * MvPolynomial.X i + p * e i := by
        simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, add_mul, Finset.sum_add_distrib, h2, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl (fun l _ => by ring)
      have key : MvPolynomial.aeval (fun l => MvPolynomial.X l + e l) (p * MvPolynomial.X i) - p * MvPolynomial.X i - ∑ l, MvPolynomial.pderiv l (p * MvPolynomial.X i) * e l = (∑ l, MvPolynomial.pderiv l p * e l) * e i + (MvPolynomial.aeval (fun l => MvPolynomial.X l + e l) p - p - ∑ l, MvPolynomial.pderiv l p * e l) * (MvPolynomial.X i + e i) := by
        rw [map_mul, MvPolynomial.aeval_X, hs]; ring
      rw [key]
      refine add_mem ?_ (Ideal.mul_mem_right _ _ ih)
      rw [Finset.sum_mul]
      refine Ideal.sum_mem _ (fun l _ => ?_)
      rw [mul_assoc, pow_two]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul (he l) (he i))
  have s3 : ∀ (n n' r s : ℕ) (π : MvPolynomial (Fin n) R →+* B) (π' : MvPolynomial (Fin n') R →+* B) (f : Fin r → MvPolynomial (Fin n) R) (φ : Fin n' → MvPolynomial (Fin n) R) (Q : Fin s → MvPolynomial (Fin n') R) (P : Fin s → MvPolynomial (Fin n) R) (a : Fin s → Fin r → MvPolynomial (Fin n) R), (∀ Q' : MvPolynomial (Fin n') R, π (MvPolynomial.aeval φ Q') = π' Q') → (∀ m, π (f m) = 0) → (∀ i, MvPolynomial.aeval φ (Q i) = P i + ∑ m, a i m * f m) → Matrix.of (fun (i : Fin s) (k : Fin n') => π' (MvPolynomial.pderiv k (Q i))) * Matrix.of (fun (k : Fin n') (l : Fin n) => π (MvPolynomial.pderiv l (φ k))) = Matrix.of (fun (i : Fin s) (l : Fin n) => π (MvPolynomial.pderiv l (P i))) + Matrix.of (fun (i : Fin s) (m : Fin r) => π (a i m)) * Matrix.of (fun (m : Fin r) (l : Fin n) => π (MvPolynomial.pderiv l (f m))) := by
    intro n n' r s π π' f φ Q P a hΘ hf hQ
    have SCR : ∀ (Q' : MvPolynomial (Fin n') R) (l : Fin n), MvPolynomial.pderiv l (MvPolynomial.aeval φ Q') = ∑ k, MvPolynomial.aeval φ (MvPolynomial.pderiv k Q') * MvPolynomial.pderiv l (φ k) := by
      intro Q' l
      induction Q' using MvPolynomial.induction_on with
      | C c => simp [MvPolynomial.algebraMap_eq]
      | add p q hp hq => simp only [map_add, hp, hq, add_mul, Finset.sum_add_distrib]
      | mul_X q i ih =>
        have h2 : ∑ k, MvPolynomial.aeval φ (q * (Pi.single k 1 : Fin n' → MvPolynomial (Fin n') R) i) * MvPolynomial.pderiv l (φ k) = MvPolynomial.aeval φ q * MvPolynomial.pderiv l (φ i) := by
          rw [Finset.sum_eq_single i]
          · simp
          · intro b _ hb; simp [Ne.symm hb]
          · simp
        rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.pderiv_mul, ih]
        simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, add_mul, Finset.sum_add_distrib, h2, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [map_mul, MvPolynomial.aeval_X]; ring
    ext i l
    simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.add_apply]
    have h1 : ∑ k, π' (MvPolynomial.pderiv k (Q i)) * π (MvPolynomial.pderiv l (φ k)) = π (MvPolynomial.pderiv l (MvPolynomial.aeval φ (Q i))) := by
      rw [SCR, map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [map_mul, hΘ]
    rw [h1, hQ i, map_add, map_add, map_sum, map_sum]
    congr 1
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hf m]; ring
  have s5 : ∀ (r p : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* B) (π' : MvPolynomial (Fin (p + 1)) R →+* B) (f : Fin r → MvPolynomial (Fin (r + 1)) R) (f' : Fin p → MvPolynomial (Fin (p + 1)) R) (φ : Fin (p + 1) → MvPolynomial (Fin (r + 1)) R) (ψ : Fin (r + 1) → MvPolynomial (Fin (p + 1)) R) (a : Fin p → Fin r → MvPolynomial (Fin (r + 1)) R) (a' : Fin r → Fin p → MvPolynomial (Fin (p + 1)) R) (c : Fin (r + 1) → Fin r → MvPolynomial (Fin (r + 1)) R), (∀ Q : MvPolynomial (Fin (p + 1)) R, π (MvPolynomial.aeval φ Q) = π' Q) → (∀ i, MvPolynomial.aeval φ (f' i) = ∑ m, a i m * f m) → (∀ m, MvPolynomial.aeval ψ (f m) = ∑ i, a' m i * f' i) → (∀ l, MvPolynomial.aeval φ (ψ l) = MvPolynomial.X l + ∑ m, c l m * f m) → (∀ m, MvPolynomial.aeval (fun l => MvPolynomial.X l + ∑ m', c l m' * f m') (f m) - f m - ∑ l, MvPolynomial.pderiv l (f m) * ∑ m', c l m' * f m' ∈ RingHom.ker π ^ 2) → (∀ κ : Fin r → MvPolynomial (Fin (r + 1)) R, ∑ i, κ i * f i ∈ RingHom.ker π ^ 2 → ∀ i, κ i ∈ RingHom.ker π) → Matrix.of (fun (m : Fin r) (i : Fin p) => π' (a' m i)) * Matrix.of (fun (i : Fin p) (m : Fin r) => π (a i m)) = 1 + Matrix.of (fun (m : Fin r) (l : Fin (r + 1)) => π (MvPolynomial.pderiv l (f m))) * Matrix.of (fun (l : Fin (r + 1)) (m : Fin r) => π (c l m)) := by
    intro r p π π' f f' φ ψ a a' c hΘ ha ha' hc hT hE2
    classical
    ext m m'
    have h1 : MvPolynomial.aeval φ (MvPolynomial.aeval ψ (f m)) = MvPolynomial.aeval (fun l => MvPolynomial.X l + ∑ m', c l m' * f m') (f m) := by
      rw [MvPolynomial.comp_aeval_apply]
      have : (fun i => MvPolynomial.aeval φ (ψ i)) = (fun l => MvPolynomial.X l + ∑ m', c l m' * f m') := funext hc
      rw [this]
    have h2 : MvPolynomial.aeval φ (MvPolynomial.aeval ψ (f m)) = ∑ m', (∑ i, MvPolynomial.aeval φ (a' m i) * a i m') * f m' := by
      rw [ha' m, map_sum]
      simp only [map_mul, ha, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    have hκ : ∑ m'', (∑ i, MvPolynomial.aeval φ (a' m i) * a i m'' - (if m'' = m then 1 else 0) - ∑ l, MvPolynomial.pderiv l (f m) * c l m'') * f m'' = MvPolynomial.aeval (fun l => MvPolynomial.X l + ∑ m', c l m' * f m') (f m) - f m - ∑ l, MvPolynomial.pderiv l (f m) * ∑ m', c l m' * f m' := by
      simp only [sub_mul, Finset.sum_sub_distrib, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
      rw [← h2, h1]
      congr 1
      simp only [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    have hk := hE2 _ (hκ ▸ hT m) m'
    rw [RingHom.mem_ker] at hk
    simp only [map_sub, map_sum, map_mul, hΘ, apply_ite π, map_one, map_zero] at hk
    simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.add_apply, Matrix.one_apply]
    by_cases h : m = m'
    · subst h
      simp only [if_true] at hk ⊢
      linear_combination hk
    · simp only [h, Ne.symm h, if_false] at hk ⊢
      linear_combination hk
  have hBE : ∀ (r : ℕ) (G : Matrix (Fin r) (Fin (r + 1)) B) (z : Fin (r + 1) → B), (Matrix.of (Fin.snoc (α := fun _ => Fin (r + 1) → B) (fun i => G i) z)).det = (-1) ^ r * ∑ l, z l * ((-1) ^ (l : ℕ) * (G.submatrix id l.succAbove).det) := by
    intro r G z
    rw [Matrix.det_succ_row _ (Fin.last r), Finset.mul_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    have hsub : (Matrix.of (Fin.snoc (α := fun _ => Fin (r + 1) → B) (fun i => G i) z)).submatrix (Fin.last r).succAbove l.succAbove = G.submatrix id l.succAbove := by
      ext a b
      simp [Fin.succAbove_last]
    rw [hsub]
    simp only [Matrix.of_apply, Fin.snoc_last, Fin.val_last, pow_add]
    ring
  have s2 : ∀ (r : ℕ) (G : Matrix (Fin r) (Fin (r + 1)) B) (ω : Fin (r + 1) → KaehlerDifferential R B), (∀ i, ∑ l, G i l • ω l = 0) → ∀ a b : Fin (r + 1), ((-1) ^ (a : ℕ) * (G.submatrix id a.succAbove).det) • ω b = ((-1) ^ (b : ℕ) * (G.submatrix id b.succAbove).det) • ω a := by
    intro r G ω hG a b
    classical
    set S : (Fin (r + 1) → B) → Matrix (Fin (r + 1)) (Fin (r + 1)) B := fun z => Matrix.of (Fin.snoc (α := fun _ => Fin (r + 1) → B) (fun i => G i) z) with hS
    have hBE' : ∀ c : Fin (r + 1), (S (Pi.single c 1)).det = (-1) ^ r * ((-1) ^ (c : ℕ) * (G.submatrix id c.succAbove).det) := by
      intro c
      rw [hS]
      simp only
      rw [hBE]
      congr 1
      rw [Finset.sum_eq_single c]
      · simp
      · intro l _ hl; simp [hl]
      · simp
    set Q := S (Pi.single b 1) with hQ
    have hupd : Q.updateRow (Fin.last r) (Pi.single a 1) = S (Pi.single a 1) := by
      ext i j
      induction i using Fin.lastCases with
      | last => simp [hQ, hS]
      | cast i => simp [hQ, hS, Matrix.updateRow_apply, Fin.castSucc_ne_last]
    have hadj : Q.adjugate a (Fin.last r) = (S (Pi.single a 1)).det := by
      rw [Matrix.adjugate_apply, hupd]
    have hrow : ∀ s : Fin (r + 1), ∑ t, Q s t • ω t = if s = Fin.last r then ω b else 0 := by
      intro s
      induction s using Fin.lastCases with
      | last =>
        simp only [if_true, hQ, hS, Matrix.of_apply, Fin.snoc_last]
        rw [Finset.sum_eq_single b]
        · simp
        · intro l _ hl; simp [hl]
        · simp
      | cast i =>
        simp only [hQ, hS, Matrix.of_apply, Fin.snoc_castSucc, Fin.castSucc_ne_last, if_false]
        exact hG i
    have key : ∑ t, (Q.adjugate * Q) a t • ω t = Q.adjugate a (Fin.last r) • ω b := by
      simp only [Matrix.mul_apply, Finset.sum_smul, ← smul_smul]
      rw [Finset.sum_comm]
      simp only [← Finset.smul_sum, hrow]
      simp
    rw [Matrix.adjugate_mul] at key
    have lhs : ∑ t, (Q.det • (1 : Matrix (Fin (r + 1)) (Fin (r + 1)) B)) a t • ω t = Q.det • ω a := by
      simp [Matrix.smul_apply, Matrix.one_apply]
    rw [lhs, hadj, hQ, hBE', hBE'] at key
    have hsq : ((-1 : B) ^ r) * (-1) ^ r = 1 := by rw [← mul_pow]; simp
    calc ((-1) ^ (a : ℕ) * (G.submatrix id a.succAbove).det) • ω b
        = (((-1) ^ r * (-1) ^ r) * ((-1) ^ (a : ℕ) * (G.submatrix id a.succAbove).det)) • ω b := by rw [hsq, one_mul]
      _ = ((-1 : B) ^ r) • (((-1) ^ r * ((-1) ^ (a : ℕ) * (G.submatrix id a.succAbove).det)) • ω b) := by rw [smul_smul, mul_assoc]
      _ = ((-1 : B) ^ r) • (((-1) ^ r * ((-1) ^ (b : ℕ) * (G.submatrix id b.succAbove).det)) • ω a) := by rw [← key]
      _ = ((-1) ^ (b : ℕ) * (G.submatrix id b.succAbove).det) • ω a := by rw [smul_smul, ← mul_assoc, hsq, one_mul]
  have s6 : ∀ (r p : ℕ) (G : Matrix (Fin r) (Fin (r + 1)) B) (G' : Matrix (Fin p) (Fin (p + 1)) B) (Φ : Matrix (Fin (p + 1)) (Fin (r + 1)) B) (Ψ : Matrix (Fin (r + 1)) (Fin (p + 1)) B) (A : Matrix (Fin p) (Fin r) B) (A' : Matrix (Fin r) (Fin p) B) (C : Matrix (Fin (r + 1)) (Fin r) B) (C' : Matrix (Fin (p + 1)) (Fin p) B), G' * Φ = A * G → G * Ψ = A' * G' → Ψ * Φ = 1 + C * G → Φ * Ψ = 1 + C' * G' → A' * A = 1 + G * C → ∃ v : Bˣ, ∀ k : Fin (p + 1), (-1) ^ (k : ℕ) * (G'.submatrix id k.succAbove).det = (v : B) * ∑ l, Φ k l * ((-1) ^ (l : ℕ) * (G.submatrix id l.succAbove).det) := by
    intro r p G G' Φ Ψ A A' C C' R1 R2 R3 R4 R5
    classical
    have hSM : ∀ (n q s : ℕ) (Gx : Matrix (Fin n) (Fin q) B) (w : Fin q → B) (M : Matrix (Fin q) (Fin s) B),
        (Matrix.of (Fin.snoc (α := fun _ => Fin q → B) (fun i => Gx i) w) : Matrix (Fin (n + 1)) (Fin q) B) * M =
          Matrix.of (Fin.snoc (α := fun _ => Fin s → B) (fun i => (Gx * M) i) (Matrix.vecMul w M)) := by
      intro n q s Gx w M
      ext i j
      induction i using Fin.lastCases with
      | last => simp [Matrix.mul_apply, Matrix.vecMul, dotProduct]
      | cast i => simp [Matrix.mul_apply]
    have hMC : ∀ (a n' n : ℕ) (Mx : Matrix (Fin a) (Fin n') B) (Cx : Matrix (Fin n') (Fin n) B),
