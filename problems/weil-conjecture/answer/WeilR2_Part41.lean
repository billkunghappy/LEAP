  obtain ⟨r, g, h, hg, hh1, hh2, hhci⟩ :=
    wcpa_dj_gc_chart_embedding k P ((e ≫ U₀.ι) ⁻¹ᵁ W) sP W ((e ≫ U₀.ι) ∣_ W) hWaff hεfin

  have hR : wcpaDjIsProjOver k (wcProjKStr k r) := ⟨r, 𝟙 _, inferInstance, Category.id_comp _⟩
  have hQ1 : wcpaDjIsProjOver k (Limits.pullback.snd sP (wcProjKStr k r) ≫ wcProjKStr k r) := by
