    have cij : ⊤ ≤ (h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
        (D.V i ⊓ D.V j) := fun x _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
      exact memσ i j (h₁ x)
    have cjk' : ⊤ ≤ (h₂ ≫ (wcpaBscChartMap D j ⁻¹ᵁ D.V k).ι ≫ wcpaBscChartMap D j) ⁻¹ᵁ
        (D.V j ⊓ D.V k) := fun x _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
      exact memσ j k (h₂ x)
    have cik' : ⊤ ≤ (h₃ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V k).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
        (D.V i ⊓ D.V k) := fun x _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
      exact memσ i k (h₃ x)
    have cjk : ⊤ ≤ (h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
        (D.V j ⊓ D.V k) := by
      rw [← E2]; exact cjk'
    have cik : ⊤ ≤ (h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
        (D.V i ⊓ D.V k) := by
      rw [← E3]; exact cik'
    have cijk : ⊤ ≤ (h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
        (D.V i ⊓ D.V j ⊓ D.V k) := fun x hx => ⟨cij hx, (cik hx).2⟩
    have ci : ⊤ ≤ (h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ D.V i :=
      fun x hx => (cij hx).1
    have cj : ⊤ ≤ (h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ D.V j :=
      fun x hx => (cij hx).2
    have R1 : ∀ x : Γ(S, D.V j),
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V j ⊓ D.V k) ⊤
          cjk).hom (wcpaBscRes S (inf_le_left : D.V j ⊓ D.V k ≤ D.V j) x) =
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤
          cij).hom (wcpaBscRes S (inf_le_right : D.V i ⊓ D.V j ≤ D.V j) x) :=
      fun x => (Fres _ _ _ _ cjk cj x).trans (Fres _ _ _ _ cij cj x).symm
    have R2 : ∀ x : Γ(S, D.V i),
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V k) ⊤
          cik).hom (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V k ≤ D.V i) x) =
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤
          cij).hom (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) x) :=
      fun x => (Fres _ _ _ _ cik ci x).trans (Fres _ _ _ _ cij ci x).symm
    have R3 : ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V i ⊓ D.V k) ⊤ cik).hom (D.lam i k : Γ(S, D.V i ⊓ D.V k)) =
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V i ⊓ D.V j) ⊤ cij).hom (D.lam i j : Γ(S, D.V i ⊓ D.V j)) *
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V j ⊓ D.V k) ⊤ cjk).hom (D.lam j k : Γ(S, D.V j ⊓ D.V k)) := by
      rw [← Fres _ _ _ (le_inf (inf_le_left.trans inf_le_left) inf_le_right) cijk cik,
        D.lam_cocycle i j k, map_mul, Fres _ _ _ _ cijk cij, Fres _ _ _ _ cijk cjk]
    have R4 : ∀ r s,
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V i ⊓ D.V k) ⊤ cik).hom (D.M i k r s) =
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V i ⊓ D.V j) ⊤ cij).hom (D.M i j r 0) *
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V j ⊓ D.V k) ⊤ cjk).hom (D.M j k 0 s) +
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V i ⊓ D.V j) ⊤ cij).hom (D.M i j r 1) *
        ((h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE
          (D.V j ⊓ D.V k) ⊤ cjk).hom (D.M j k 1 s) := by
      intro r s
      have e := congrFun (congrFun (D.M_cocycle i j k) r) s
      simp only [Matrix.map_apply, Matrix.mul_apply, Fin.sum_univ_two] at e
      rw [← Fres _ _ _ (le_inf (inf_le_left.trans inf_le_left) inf_le_right) cijk cik, e, map_add,
        map_mul, map_mul, Fres _ _ _ _ cijk cij, Fres _ _ _ _ cijk cjk, Fres _ _ _ _ cijk cij,
        Fres _ _ _ _ cijk cjk]
    apply CE k
    · simp only [Category.assoc, hτ1]
      rw [E2, E3]
    · rw [HR j k T h₂ cjk', Fcongr _ _ E2 _ cjk' cjk, H2, HR i j T h₁ cij,
        HR i k T h₃ cik', Fcongr _ _ E3 _ cik' cik, H3]
      exact LC i j k _ _ _ _ R1 R2 R3 R4

theorem wcpa_dj_bsc_local_props : ∀ (S W : Scheme.{u}) (p : W ⟶ S) (J : Type u) (V : J → S.Opens) (hV : ∀ i, IsAffineOpen (V i)), (∀ x : S, ∃ i, x ∈ V i) → ∀ (A : J → CommRingCat.{u}) (φ : ∀ i, Γ(S, V i) ⟶ A i) (ι : ∀ i, Spec (A i) ⟶ W), (∀ i, IsOpenImmersion (ι i)) → (∀ i, ι i ≫ p = Spec.map (φ i) ≫ (hV i).fromSpec) → (∀ i, Set.range (ι i) = p ⁻¹' (V i : Set S)) → (∀ i, IsFinite (Spec.map (φ i))) → (∀ i, FormallyUnramified (Spec.map (φ i))) → (∀ i, Surjective (Spec.map (φ i))) → IsFinite p ∧ FormallyUnramified p ∧ Surjective p :=
by
  intro S W p J V hV hcov A φ ι hopen hιp hrange hfin hunr hsurj
  have hsup : iSup V = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨i, hi⟩ := hcov x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
  have harr : ∀ i, Nonempty (Arrow.mk (Spec.map (φ i)) ≅ Arrow.mk (p ∣_ V i)) := by
    intro i
    have := hopen i
    have hr : Set.range (ι i) = Set.range (p ⁻¹ᵁ V i).ι := by
      rw [Scheme.Opens.range_ι, hrange i]
      rfl
    let e₁ := IsOpenImmersion.isoOfRangeEq (ι i) (p ⁻¹ᵁ V i).ι hr
    let e₂ := (hV i).isoSpec
    have w : e₁.hom ≫ p ∣_ V i = Spec.map (φ i) ≫ e₂.symm.hom := by
      rw [← cancel_mono (V i).ι, Category.assoc, morphismRestrict_ι, ← Category.assoc,
        IsOpenImmersion.isoOfRangeEq_hom_fac, hιp i, Category.assoc, Iso.symm_hom,
        IsAffineOpen.isoSpec_inv_ι]
    exact ⟨Arrow.isoMk' _ _ e₁ e₂.symm w⟩
  haveI hZfin : IsZariskiLocalAtTarget (@IsFinite : MorphismProperty Scheme.{u}) :=
    @HasAffineProperty.instIsZariskiLocalAtTarget _ _
      IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop
  haveI hZunr : IsZariskiLocalAtTarget (@FormallyUnramified : MorphismProperty Scheme.{u}) :=
    HasRingHomProperty.instIsZariskiLocalAtTarget @FormallyUnramified
  haveI hRfin : MorphismProperty.RespectsIso (@IsFinite : MorphismProperty Scheme.{u}) := by
    first
      | exact inferInstance
      | exact hZfin.toRespectsIso
      | exact IsZariskiLocalAtTarget.respectsIso
      | exact hZfin.1
  haveI hRunr : MorphismProperty.RespectsIso (@FormallyUnramified : MorphismProperty Scheme.{u}) := by
    first
      | exact inferInstance
      | exact hZunr.toRespectsIso
      | exact IsZariskiLocalAtTarget.respectsIso
      | exact hZunr.1
  refine ⟨?_, ?_, ?_⟩
  · refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @IsFinite) V hsup).mpr ?_
    intro i
    obtain ⟨e⟩ := harr i
    exact (MorphismProperty.arrow_mk_iso_iff (@IsFinite) e).mp (hfin i)
  · refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @FormallyUnramified) V hsup).mpr ?_
    intro i
    obtain ⟨e⟩ := harr i
    exact (MorphismProperty.arrow_mk_iso_iff (@FormallyUnramified) e).mp (hunr i)
  · refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @Surjective) V hsup).mpr ?_
    intro i
    obtain ⟨e⟩ := harr i
    exact (MorphismProperty.arrow_mk_iso_iff (@Surjective) e).mp (hsurj i)

theorem wcpa_dj_bsc_root_of_point : ∀ (S W : Scheme.{u}) (p : W ⟶ S) (U : S.Opens) (hU : IsAffineOpen U) (a b c : Γ(S, U)) (ι : Spec (CommRingCat.of (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c)))) ⟶ W), IsOpenImmersion ι → ι ≫ p = Spec.map (CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c)))) ≫ hU.fromSpec → Set.range ι = p ⁻¹' (U : Set S) → ∀ (K : Type u) [Field K] (ρ : Spec (.of K) ⟶ W) (hi : ⊤ ≤ (ρ ≫ p) ⁻¹ᵁ U), ∃ τ₁ : K, τ₁ ^ 2 - wcpaBscEval K (ρ ≫ p) U hi b * τ₁ + wcpaBscEval K (ρ ≫ p) U hi a * wcpaBscEval K (ρ ≫ p) U hi c = 0 :=
by
  intro S W p U hU a b c ι hιo hιp hrange K _ ρ hi
  have htop : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤ := by
    intro X Y f x _
    first
      | exact trivial
      | exact Set.mem_univ _
      | simp
  have appTop_eq : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤),
      f.appLE ⊤ ⊤ e = f.appTop := by
    intro X Y f e
    exact Scheme.Hom.appLE_eq_app f
  have e3 : (⊤ : (Spec Γ(S, U)).Opens) ≤ hU.fromSpec ⁻¹ᵁ U := hU.fromSpec_preimage_self.symm.le
  have hfs : hU.fromSpec.appLE U ⊤ e3 = (Scheme.ΓSpecIso Γ(S, U)).inv := by
    have hid : ∀ (i : Opposite.op (⊤ : (Spec Γ(S, U)).Opens) ⟶ Opposite.op ⊤),
        (Spec Γ(S, U)).presheaf.map i = 𝟙 _ := fun i => by
      rw [Subsingleton.elim i (𝟙 _), CategoryTheory.Functor.map_id]
    rw [Scheme.Hom.appLE, hU.fromSpec_app_self, Category.assoc,
      ← CategoryTheory.Functor.map_comp, hid, Category.comp_id]

  have main : ∀ (P : Polynomial Γ(S, U)) (ι : Spec (CommRingCat.of (AdjoinRoot P)) ⟶ W),
      IsOpenImmersion ι → ι ≫ p = Spec.map (CommRingCat.ofHom (AdjoinRoot.of P)) ≫ hU.fromSpec →
      Set.range ι = p ⁻¹' (U : Set S) →
      ∃ θ : AdjoinRoot P →+* K, ∀ x, wcpaBscEval K (ρ ≫ p) U hi x = θ (AdjoinRoot.of P x) := by
    intro P ι hιo hιp hrange
    haveI := hιo

    have H : Set.range ρ.base ⊆ Set.range ι.base := by
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ (ρ ≫ p) ⁻¹ᵁ U := hi trivial
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at hx
      have hx' : ρ x ∈ Set.range ι := by rw [hrange]; exact hx
      exact hx'

    obtain ⟨ρ', hfac⟩ : ∃ ρ' : Spec (.of K) ⟶ Spec (CommRingCat.of (AdjoinRoot P)), ρ' ≫ ι = ρ :=
      ⟨_, IsOpenImmersion.lift_fac ι ρ H⟩
    subst hfac
    have e1 : (⊤ : (Spec (CommRingCat.of (AdjoinRoot P))).Opens) ≤
        (Spec.map (CommRingCat.ofHom (AdjoinRoot.of P)) ≫ hU.fromSpec) ⁻¹ᵁ U := by
      intro x _
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
      have : hU.fromSpec (Spec.map (CommRingCat.ofHom (AdjoinRoot.of P)) x) ∈
          Set.range hU.fromSpec := ⟨_, rfl⟩
      rw [hU.range_fromSpec] at this
      exact this

    have key : ∀ (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ U),
        σ = ρ' ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of P)) ≫ hU.fromSpec →
        σ.appLE U ⊤ h = CommRingCat.ofHom (AdjoinRoot.of P) ≫
          (Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot P))).inv ≫ ρ'.appTop := by
      rintro σ h rfl
      rw [← Scheme.Hom.appLE_comp_appLE ρ' _ U ⊤ ⊤ e1 (htop ρ'),
        ← Scheme.Hom.appLE_comp_appLE (Spec.map (CommRingCat.ofHom (AdjoinRoot.of P)))
          hU.fromSpec U ⊤ ⊤ e3 (htop _), appTop_eq, appTop_eq, hfs, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
    have hσ : (ρ' ≫ ι) ≫ p =
        ρ' ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of P)) ≫ hU.fromSpec := by
      rw [Category.assoc, hιp]

    refine ⟨((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot P))).inv ≫
      ρ'.appTop ≫ (Scheme.ΓSpecIso (.of K)).hom).hom, fun x => ?_⟩
    show ((((ρ' ≫ ι) ≫ p).appLE U ⊤ hi ≫ (Scheme.ΓSpecIso (.of K)).hom).hom x) = _
    rw [key _ hi hσ]
    rfl
  obtain ⟨θ, hev⟩ := main _ ι hιo hιp hrange

  refine ⟨θ (AdjoinRoot.root
    (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c))), ?_⟩
  rw [hev, hev, hev]
  have h0 := AdjoinRoot.eval₂_root
    (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c))
  simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
    Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C, map_mul] at h0
  have h2 := congrArg θ h0
  simp only [map_add, map_sub, map_mul, map_pow, map_zero] at h2
  exact h2

theorem wcpa_dj_bsc_glue_discriminant : ∀ (S : Scheme.{u}) (D : wcpaBscChartData S), ∃ (T : Scheme.{u}) (π : T ⟶ S), IsFinite π ∧ FormallyUnramified π ∧ Surjective π ∧ ∀ (K : Type u) [Field K] (ρ : Spec (.of K) ⟶ T) (i : D.J) (hi : ⊤ ≤ (ρ ≫ π) ⁻¹ᵁ D.V i), ∃ τ₁ : K, τ₁ ^ 2 - wcpaBscEval K (ρ ≫ π) (D.V i) hi (D.b i) * τ₁ + wcpaBscEval K (ρ ≫ π) (D.V i) hi (D.a i) * wcpaBscEval K (ρ ≫ π) (D.V i) hi (D.c i) = 0 :=
by
  intro S D
  obtain ⟨τ, hτ, hid, hcoc⟩ := wcpa_dj_bsc_transitions S D
  have hq : ∀ i, Set.range (wcpaBscChartMap D i) ⊆ (D.V i : Set S) := by
    intro i x hx
    obtain ⟨y, rfl⟩ := hx
    rw [← (D.affine i).range_fromSpec]
    first
      | exact ⟨(Spec.map (CommRingCat.ofHom (AdjoinRoot.of (wcpaBscPoly D i)))) y, rfl⟩
      | exact ⟨_, (Scheme.Hom.comp_apply _ _ y).symm⟩
  obtain ⟨W, p, ι, hopen, hιp, hrange, -, -, -⟩ :=
    wc_sch_rel_glue S D.J D.V (wcpaBscChart D) (wcpaBscChartMap D) hq τ hτ hid hcoc
  have hprops := fun i => wcpa_dj_bsc_chart_props Γ(S, D.V i) (D.a i) (D.b i) (D.c i) (D.disc i)
  obtain ⟨hfin, hunr, hsurj⟩ := wcpa_dj_bsc_local_props S W p D.J D.V D.affine D.cover
    (fun i => CommRingCat.of (AdjoinRoot (wcpaBscPoly D i)))
    (fun i => CommRingCat.ofHom (AdjoinRoot.of (wcpaBscPoly D i))) ι hopen hιp hrange
    (fun i => (hprops i).1) (fun i => (hprops i).2.1) (fun i => (hprops i).2.2)
  refine ⟨W, p, hfin, hunr, hsurj, ?_⟩
  intro K _ ρ i hi
  exact wcpa_dj_bsc_root_of_point S W p (D.V i) (D.affine i) (D.a i) (D.b i) (D.c i) (ι i)
    (hopen i) (hιp i) (hrange i) K ρ hi

theorem wcpa_dj_bsc_assemble_fibre : ∀ (C P' S T : Scheme.{u}) (g : C ⟶ P') (ι : S ⟶ C) (π : T ⟶ S), (∀ x : C, x ∈ Set.range ι ↔ ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → Surjective π → ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P'), (∀ v : ↥(Limits.pullback (π ≫ ι ≫ g) s), ∃ W : (Limits.pullback (π ≫ ι ≫ g) s).Opens, v ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s)) → ∀ w : ↥(Limits.pullback g s), (¬ ∃ W : (Limits.pullback g s).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g s)) → ∃ (ρ : Spec (.of K) ⟶ T) (τ : Spec (.of K) ⟶ Limits.pullback g s), τ (IsLocalRing.closedPoint K) = w ∧ τ ≫ Limits.pullback.snd g s = 𝟙 _ ∧ τ ≫ Limits.pullback.fst g s = ρ ≫ π ≫ ι :=
by
  intro C P' S T g ι π hset hsurj K _ s hsplit w hw

  have hx : ¬ ∃ W : C.Opens, Limits.pullback.fst g s w ∈ W ∧
      SmoothOfRelativeDimension 1 (W.ι ≫ g) := by
    rintro ⟨W, hxW, hsm⟩
    apply hw
    refine ⟨Limits.pullback.fst g s ⁻¹ᵁ W, hxW, ?_⟩
    have hpb := IsPullback.paste_vert
      (isPullback_morphismRestrict (Limits.pullback.fst g s) W) (IsPullback.of_hasPullback g s)
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm

  obtain ⟨y, hy⟩ := (hset _).mpr hx
  have hsurj' := hsurj
  obtain ⟨t, ht⟩ := π.surjective y
  have htw : (π ≫ ι) t = Limits.pullback.fst g s w := by
    rw [Scheme.Hom.comp_apply, ht, hy]
  obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback t w htw

  have c1 : Limits.pullback.fst (π ≫ ι) (Limits.pullback.fst g s) ≫ π ≫ ι =
      Limits.pullback.snd (π ≫ ι) (Limits.pullback.fst g s) ≫ Limits.pullback.fst g s :=
    Limits.pullback.condition
  have hφeq : Limits.pullback.fst (π ≫ ι) (Limits.pullback.fst g s) ≫ (π ≫ ι ≫ g) =
      (Limits.pullback.snd (π ≫ ι) (Limits.pullback.fst g s) ≫ Limits.pullback.snd g s) ≫ s := by
    simp only [Category.assoc]
    rw [reassoc_of% c1, Limits.pullback.condition]
  obtain ⟨φ, hφ1, hφ2⟩ : ∃ φ : Limits.pullback (π ≫ ι) (Limits.pullback.fst g s) ⟶
      Limits.pullback (π ≫ ι ≫ g) s,
      φ ≫ Limits.pullback.fst (π ≫ ι ≫ g) s = Limits.pullback.fst (π ≫ ι) (Limits.pullback.fst g s) ∧
      φ ≫ Limits.pullback.snd (π ≫ ι ≫ g) s =
        Limits.pullback.snd (π ≫ ι) (Limits.pullback.fst g s) ≫ Limits.pullback.snd g s :=
    ⟨_, Limits.pullback.lift_fst _ _ hφeq, Limits.pullback.lift_snd _ _ hφeq⟩
  have hψeq : (Limits.pullback.fst (π ≫ ι ≫ g) s ≫ π ≫ ι) ≫ g =
      Limits.pullback.snd (π ≫ ι ≫ g) s ≫ s := by
    simp only [Category.assoc]
    exact Limits.pullback.condition
  obtain ⟨ψ, hψ1, hψ2⟩ : ∃ ψ : Limits.pullback (π ≫ ι ≫ g) s ⟶ Limits.pullback g s,
      ψ ≫ Limits.pullback.fst g s = Limits.pullback.fst (π ≫ ι ≫ g) s ≫ π ≫ ι ∧
      ψ ≫ Limits.pullback.snd g s = Limits.pullback.snd (π ≫ ι ≫ g) s :=
    ⟨_, Limits.pullback.lift_fst _ _ hψeq, Limits.pullback.lift_snd _ _ hψeq⟩
  have K1 : φ ≫ ψ = Limits.pullback.snd (π ≫ ι) (Limits.pullback.fst g s) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hψ1, ← Category.assoc, hφ1, c1]
    · rw [Category.assoc, hψ2, hφ2]

  obtain ⟨σ, hσs, hσpt⟩ : ∃ σ : Spec (.of K) ⟶ Limits.pullback (π ≫ ι ≫ g) s,
      σ ≫ Limits.pullback.snd (π ≫ ι ≫ g) s = 𝟙 _ ∧ ∀ p : ↥(Spec (.of K)), σ p = φ z := by
    obtain ⟨W, hvW, hiso⟩ := hsplit (φ z)
    obtain ⟨q, hq⟩ : φ z ∈ Set.range W.ι := by
      first
        | (rw [Scheme.Opens.range_ι]; exact hvW)
        | exact ⟨⟨φ z, hvW⟩, rfl⟩
    refine ⟨inv (W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s) ≫ W.ι, ?_, ?_⟩
    · rw [Category.assoc, IsIso.inv_hom_id]
    · intro p
      have hp : p = (W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s) q :=
        Subsingleton.elim (α := PrimeSpectrum K) _ _
      have h2 : (inv (W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s))
          ((W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s) q) = q := by
        rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
        all_goals first | rfl | simp
      rw [hp]
      first
        | (rw [Scheme.Hom.comp_apply (inv (W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s)) W.ι, h2, hq])
        | (show W.ι ((inv (W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s))
              ((W.ι ≫ Limits.pullback.snd (π ≫ ι ≫ g) s) q)) = φ z
           rw [h2, hq])

  refine ⟨σ ≫ Limits.pullback.fst (π ≫ ι ≫ g) s, σ ≫ ψ, ?_, ?_, ?_⟩
  · have hτ : ∀ p : ↥(Spec (.of K)), (σ ≫ ψ) p = w := by
      intro p
      rw [Scheme.Hom.comp_apply, hσpt, ← Scheme.Hom.comp_apply, K1, hz2]
    exact hτ _
  · rw [Category.assoc, hψ2, hσs]
  · simp only [Category.assoc, hψ1]

theorem wcpa_dj_ssp_bw_branch_scheme : ∀ (k : Type u) [Field k] [Finite k] (C P' : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P'), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → wcpaDjSemistable g → ∃ (T : Scheme.{u}) (t : T ⟶ P'), IsFinite t ∧ FormallyUnramified t ∧ ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P'), (∀ v : ↥(Limits.pullback t s), ∃ W : (Limits.pullback t s).Opens, v ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd t s)) → ∀ w : ↥(Limits.pullback g s), (¬ ∃ W : (Limits.pullback g s).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g s)) → ∃ f : MvPowerSeries (Fin 2) K, 3 ≤ MvPowerSeries.order (f - MvPowerSeries.X 0 * MvPowerSeries.X 1) ∧ ∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk w)) ((Limits.pullback g s).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f}), e.toRingHom.comp ((algebraMap ((Limits.pullback g s).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk w)) ((Limits.pullback g s).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g s).appTop ≫ (Limits.pullback g s).presheaf.germ ⊤ w trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro k _ _ C P' sP' g hgP hP' hss

  have s1 : ∀ (K : Type u) [Field K] (a b c t : K), b ^ 2 - 4 * a * c ≠ 0 →
      t ^ 2 - b * t + a * c = 0 → ∃ α β γ δ l : K, l ≠ 0 ∧ α * δ - β * γ ≠ 0 ∧
        l * (α * γ) = a ∧ l * (α * δ + β * γ) = b ∧ l * (β * δ) = c := by
    intro K _ a b c t hd ht
    by_cases ha : a = 0
    · subst ha
      have hb : b ≠ 0 := by
        intro hb
        apply hd
        rw [hb]
        ring
      refine ⟨0, 1, b, c, 1, one_ne_zero, ?_, by ring, by ring, by ring⟩
      intro h
      apply hb
      linear_combination -h
    · refine ⟨a, t, a, b - t, a⁻¹, inv_ne_zero ha, ?_, ?_, ?_, ?_⟩
      · intro h
        apply hd
        have h1 : a * (b - 2 * t) = 0 := by linear_combination h
        have hb2 : b - 2 * t = 0 := (mul_eq_zero.mp h1).resolve_left ha
        linear_combination (b - 2 * t) * hb2 - 4 * ht
      · rw [inv_mul_eq_iff_eq_mul₀ ha]
      · rw [inv_mul_eq_iff_eq_mul₀ ha]
        ring
      · rw [inv_mul_eq_iff_eq_mul₀ ha]
        linear_combination -ht

  obtain ⟨S, ι, hι, hunr, hset, D, hfib⟩ := wcpa_dj_bsc_local_quadric k C P' sP' g hgP hP' hss
  have hfin : IsFinite (ι ≫ g) := wcpa_dj_bsc_sing_finite k C P' S sP' g ι hgP hP' hss hι hset
  obtain ⟨T, π, hπfin, hπunr, hπsurj, hroot⟩ := wcpa_dj_bsc_glue_discriminant S D
  refine ⟨T, π ≫ ι ≫ g, ?_, ?_, ?_⟩
  · haveI := hπfin
    haveI := hfin
    infer_instance
  · first
      | exact MorphismProperty.comp_mem @FormallyUnramified π (ι ≫ g) hπunr hunr
      | exact MorphismProperty.comp_mem _ π (ι ≫ g) hπunr hunr
      | (haveI := hπunr; haveI := hunr; exact FormallyUnramified.comp π (ι ≫ g))
  intro K _ s hsplit w hw

  obtain ⟨ρ, τ, rfl, hτs, hτf⟩ :=
    wcpa_dj_bsc_assemble_fibre C P' S T g ι π hset hπsurj K s hsplit w hw
  obtain ⟨i, hi⟩ := D.cover ((ρ ≫ π) (IsLocalRing.closedPoint K))
  have hσ : ⊤ ≤ (ρ ≫ π) ⁻¹ᵁ D.V i := by
    intro x _
    have hx : x = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
    rw [hx]
    exact hi
  obtain ⟨τ₁, hτ₁⟩ := hroot K ρ i hσ
  have hdisc : wcpaBscEval K (ρ ≫ π) (D.V i) hσ (D.b i) ^ 2 -
      4 * wcpaBscEval K (ρ ≫ π) (D.V i) hσ (D.a i) * wcpaBscEval K (ρ ≫ π) (D.V i) hσ (D.c i)
        ≠ 0 := by
    have h := (D.disc i).map (wcpaBscEval K (ρ ≫ π) (D.V i) hσ)
    simp only [map_sub, map_mul, map_pow, map_ofNat] at h
    exact h.ne_zero
  obtain ⟨f, hf, e₁, he₁⟩ := hfib K s τ (ρ ≫ π) hτs (hτf.trans (Category.assoc _ _ _).symm) i hσ
  obtain ⟨α, β, γ, δ, l, hl, hdet, ha, hb, hc⟩ := s1 K _ _ _ τ₁ hdisc hτ₁
  obtain ⟨f', hf', e₂, he₂⟩ :=
    wcpa_dj_bsc_linear_normalize K f _ _ _ α β γ δ l hl hdet ha hb hc hf
  refine ⟨f', hf', e₁.trans e₂, ?_⟩
  rw [RingEquiv.toRingHom_trans, RingHom.comp_assoc, he₁, he₂]

theorem wcpa_dj_ssp_bw_split_any_field : ∀ (P' T P'' : Scheme.{u}) (t : T ⟶ P') (β : P'' ⟶ P'), (∀ (p : P'') (w : ↥(Limits.pullback t (P''.fromSpecResidueField p ≫ β))), ∃ W : (Limits.pullback t (P''.fromSpecResidueField p ≫ β)).Opens, w ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd t (P''.fromSpecResidueField p ≫ β))) → ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P''), ∀ v : ↥(Limits.pullback t (s ≫ β)), ∃ W : (Limits.pullback t (s ≫ β)).Opens, v ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd t (s ≫ β)) :=
by
  intro P' T P'' t β H K _ s v
  have s3 : ∀ {S S' : Scheme.{u}} (g : S ⟶ P') (a : S' ⟶ S) (h : S' ⟶ P'), a ≫ g = h →
      ∃ L : Limits.pullback t h ⟶ Limits.pullback t g,
        IsPullback L (Limits.pullback.snd t h) (Limits.pullback.snd t g) a := by
    intro S S' g a h heq
    subst heq
    refine ⟨Limits.pullback.lift (Limits.pullback.fst t (a ≫ g))
      (Limits.pullback.snd t (a ≫ g) ≫ a)
      (by rw [Limits.pullback.condition, Category.assoc]), ?_⟩
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback t g)
    rw [Limits.pullback.lift_fst]
    exact IsPullback.of_hasPullback t (a ≫ g)
  have s2 : ∀ {Q Q' S S' : Scheme.{u}} (f₁ : Q' ⟶ Q) (q' : Q' ⟶ S') (q : Q ⟶ S) (a : S' ⟶ S),
      IsPullback f₁ q' q a → (∀ w : Q, ∃ W : Q.Opens, w ∈ W ∧ IsIso (W.ι ≫ q)) →
      ∀ v : Q', ∃ W : Q'.Opens, v ∈ W ∧ IsIso (W.ι ≫ q') := by
    intro Q Q' S S' f₁ q' q a hpb hloc v
    obtain ⟨W, hW, hiso⟩ := hloc (f₁ v)
    refine ⟨f₁ ⁻¹ᵁ W, (Scheme.Hom.mem_preimage f₁).mpr hW, ?_⟩
    have h2 := IsPullback.paste_vert (isPullback_morphismRestrict f₁ W) hpb
    exact h2.isIso_snd_of_isIso
  have hs : Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo s)) ≫
      P''.fromSpecResidueField (s (IsLocalRing.closedPoint K)) = s := by
    exact Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K P'' s
  obtain ⟨L, hL⟩ := s3 (P''.fromSpecResidueField (s (IsLocalRing.closedPoint K)) ≫ β)
    (Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo s))) (s ≫ β)
    (by rw [← Category.assoc, hs])
  exact s2 L _ _ _ hL (H _) v

theorem wcpa_dj_ssp_branch_witness : ∀ (k : Type u) [Field k] [Finite k] (C P' : Scheme.{u})
    (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P'), wcpaDjIsProjOver k (g ≫ sP') →
    wcpaDjIsProjOver k sP' → wcpaDjSemistable g →
    ∃ (T : Scheme.{u}) (t : T ⟶ P'), IsFinite t ∧ FormallyUnramified t ∧
      ∀ (P'' : Scheme.{u}) (β : P'' ⟶ P'),
        (∀ (p : P'') (w : ↥(Limits.pullback t (P''.fromSpecResidueField p ≫ β))),
          ∃ W : (Limits.pullback t (P''.fromSpecResidueField p ≫ β)).Opens, w ∈ W ∧
            IsIso (W.ι ≫ Limits.pullback.snd t (P''.fromSpecResidueField p ≫ β))) →
        wcpaDjSplitSemistable (Limits.pullback.snd g β) :=
by
  intro k _ _ C P' sP' g hgP hP' hss
  obtain ⟨T, t, htfin, htunr, hT⟩ := wcpa_dj_ssp_bw_branch_scheme k C P' sP' g hgP hP' hss
  refine ⟨T, t, htfin, htunr, ?_⟩
  intro P'' β hres
  refine ⟨MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback g β) hss.1,
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback g β) hss.2.1, ?_⟩
  intro K _ s w
  have hΦ := Limits.pullbackLeftPullbackSndIso_hom_snd g β s
  refine wcpa_dj_ssp_bw_ns_transport K (Limits.pullbackLeftPullbackSndIso g β s) _ _ hΦ w ?_
  by_cases h : ∃ W : (Limits.pullback g (s ≫ β)).Opens,
      (Limits.pullbackLeftPullbackSndIso g β s).hom w ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g (s ≫ β))
  · exact Or.inl h
  · right
    have hsplit := wcpa_dj_ssp_bw_split_any_field P' T P'' t β hres K s
    obtain ⟨f, hf, e₁, he₁⟩ := hT K (s ≫ β) hsplit _ h
    obtain ⟨e₂, he₂⟩ := wcpa_dj_ssp_bw_hensel_node K f hf
    refine ⟨e₁.trans e₂, ?_⟩
    rw [RingEquiv.toRingHom_trans, RingHom.comp_assoc, he₁, he₂]

theorem wcpa_dj_ssprf_split_comp : ∀ (S T P₂ P₃ : Scheme.{u}) (t : T ⟶ S) (β : P₂ ⟶ S) (α : P₃ ⟶ P₂), (∀ (p : P₂) (w : ↥(Limits.pullback t (P₂.fromSpecResidueField p ≫ β))), ∃ W : (Limits.pullback t (P₂.fromSpecResidueField p ≫ β)).Opens, w ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd t (P₂.fromSpecResidueField p ≫ β))) → ∀ (p : P₃) (w : ↥(Limits.pullback t (P₃.fromSpecResidueField p ≫ (α ≫ β)))), ∃ W : (Limits.pullback t (P₃.fromSpecResidueField p ≫ (α ≫ β))).Opens, w ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd t (P₃.fromSpecResidueField p ≫ (α ≫ β))) :=
by
  intro S T P₂ P₃ t β α hsplit p w
  have hg : P₃.fromSpecResidueField p ≫ (α ≫ β) =
      Spec.map (α.residueFieldMap p) ≫ (P₂.fromSpecResidueField (α p) ≫ β) := by
    rw [← Category.assoc, ← Category.assoc,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  have hφ : Limits.pullback.fst t (P₃.fromSpecResidueField p ≫ (α ≫ β)) ≫ t =
      (Limits.pullback.snd t (P₃.fromSpecResidueField p ≫ (α ≫ β)) ≫
        Spec.map (α.residueFieldMap p)) ≫ (P₂.fromSpecResidueField (α p) ≫ β) :=
    Limits.pullback.condition.trans
      ((congrArg (fun k => Limits.pullback.snd t (P₃.fromSpecResidueField p ≫ (α ≫ β)) ≫ k)
        hg).trans (Category.assoc _ _ _).symm)
  obtain ⟨φ, hφ1, hφ2⟩ : ∃ φ : Limits.pullback t (P₃.fromSpecResidueField p ≫ (α ≫ β)) ⟶
      Limits.pullback t (P₂.fromSpecResidueField (α p) ≫ β),
      φ ≫ Limits.pullback.fst t (P₂.fromSpecResidueField (α p) ≫ β) =
        Limits.pullback.fst t (P₃.fromSpecResidueField p ≫ (α ≫ β)) ∧
      φ ≫ Limits.pullback.snd t (P₂.fromSpecResidueField (α p) ≫ β) =
        Limits.pullback.snd t (P₃.fromSpecResidueField p ≫ (α ≫ β)) ≫
          Spec.map (α.residueFieldMap p) :=
    ⟨Limits.pullback.lift _ _ hφ, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have key : ∀ (g g' : Spec (P₃.residueField p) ⟶ S), g = g' →
      IsPullback (Limits.pullback.fst t g) (Limits.pullback.snd t g) t g' := by
    rintro g _ rfl
    exact IsPullback.of_hasPullback t g
  have hs : IsPullback (φ ≫ Limits.pullback.fst t (P₂.fromSpecResidueField (α p) ≫ β))
      (Limits.pullback.snd t (P₃.fromSpecResidueField p ≫ (α ≫ β))) t
      (Spec.map (α.residueFieldMap p) ≫ (P₂.fromSpecResidueField (α p) ≫ β)) := by
    rw [hφ1]
    exact key _ _ hg
  have hsq := IsPullback.of_right hs hφ2
    (IsPullback.of_hasPullback t (P₂.fromSpecResidueField (α p) ≫ β))
  obtain ⟨W', hw', hiso'⟩ := hsplit (α p) (φ w)
  have hbig := (isPullback_morphismRestrict φ W').paste_vert hsq
  have := hiso'
  refine ⟨φ ⁻¹ᵁ W', hw', ?_⟩
  exact hbig.isIso_snd_of_isIso

theorem wcpa_dj_ssprf_affine_presentation : ∀ (S T : Scheme.{u}) (t : T ⟶ S) [IsFinite t] [CompactSpace S], ∃ (m : ℕ) (U : Fin m → S.Opens), (∀ a, IsAffineOpen (U a)) ∧ (∀ a, (U a : Set S).Nonempty) ∧ (⨆ a, U a) = ⊤ ∧ ∀ a, ∃ (n : ℕ) (s : Fin n → Γ(T, t ⁻¹ᵁ U a)) (F : Fin n → Polynomial Γ(S, U a)), (∀ b : Γ(T, t ⁻¹ᵁ U a), b ∈ Subring.closure (Set.range (t.app (U a)).hom ∪ Set.range s)) ∧ (∀ i, (F i).Monic) ∧ (∀ i, Polynomial.eval₂ (t.app (U a)).hom (s i) (F i) = 0) :=
by
  intro S T t _ _
  classical

  have alg : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B), f.Finite →
      ∃ (n : ℕ) (s : Fin n → B) (F : Fin n → Polynomial A),
        (∀ b : B, b ∈ Subring.closure (Set.range f ∪ Set.range s)) ∧ (∀ i, (F i).Monic) ∧
        (∀ i, Polynomial.eval₂ f (s i) (F i) = 0) := by
    intro A B _ _ f hf
    letI := f.toAlgebra
    haveI : Module.Finite A B := hf
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
    have hint := hf.to_isIntegral
    choose F hFm hFe using fun i => hint (s i)
    refine ⟨n, s, F, ?_, hFm, hFe⟩
    intro b
    have hb : b ∈ Submodule.span A (Set.range s) := by rw [hs]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hb
    rw [← hc]
    refine Subring.sum_mem _ (fun i _ => ?_)
    rw [Algebra.smul_def]
    exact Subring.mul_mem _ (Subring.subset_closure (Or.inl ⟨c i, rfl⟩))
      (Subring.subset_closure (Or.inr ⟨i, rfl⟩))

  have hW : ∀ x : S, ∃ W : S.Opens, IsAffineOpen W ∧ x ∈ W := fun x => by
    obtain ⟨W, hW, hx, _⟩ :=
      exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : S.Opens) from trivial)
    exact ⟨W, hW, hx⟩
  choose W hWaff hxW using hW
  obtain ⟨t₀, ht₀⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set S))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  refine ⟨t₀.card, fun a => W (t₀.equivFin.symm a).1, fun a => hWaff _, fun a => ⟨_, hxW _⟩,
    ?_, ?_⟩
  · rw [eq_top_iff]
    intro y _
    have hy : y ∈ ⋃ x ∈ t₀, (W x : Set S) := by rw [ht₀]; trivial
    obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.mp hy
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨t₀.equivFin ⟨x, hx⟩, ?_⟩
    show y ∈ W (t₀.equivFin.symm (t₀.equivFin ⟨x, hx⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hyx
  · intro a
    exact alg _ _ (t.app _).hom (((isFinite_iff t).mp inferInstance).2 _ (hWaff _))

theorem wcpa_dj_ssprf_splitting_field : ∀ (K : Type u) [Field K] (ι : Type) [Fintype ι] (G : ι → Polynomial K), (∀ i, (G i).Monic) → ∃ (L : Type u) (_ : Field L) (_ : Algebra K L), FiniteDimensional K L ∧ ∀ i, ∃ m : Multiset L, (G i).map (algebraMap K L) = (m.map fun c => Polynomial.X - Polynomial.C c).prod :=
by
  intro K _ ι _ G hG
  classical
  set P : Polynomial K := ∏ i, G i with hP
  have hPm : P.Monic := Polynomial.monic_prod_of_monic _ _ (fun i _ => hG i)
  refine ⟨P.SplittingField, inferInstance, inferInstance, inferInstance, fun i => ?_⟩
  have hdvd : G i ∣ P := Finset.dvd_prod_of_mem G (Finset.mem_univ i)
  have hs := Polynomial.SplittingField.splits P
  have hdvd' : (G i).map (algebraMap K P.SplittingField) ∣
      P.map (algebraMap K P.SplittingField) := Polynomial.map_dvd _ hdvd
  have hne : P.map (algebraMap K P.SplittingField) ≠ 0 := (hPm.map _).ne_zero
  have hsi := Polynomial.Splits.of_dvd hs hne hdvd'
  exact ⟨((G i).map (algebraMap K P.SplittingField)).roots,
    Polynomial.Splits.eq_prod_roots_of_monic hsi ((hG i).map _)⟩

theorem wcpa_dj_ssprf_normalize : ∀ (k : Type u) [Field k] [PerfectField k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) [IsProper sY] (L : Type u) [Field L] [Algebra Y.functionField L] [FiniteDimensional Y.functionField L], ∃ (P₀ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P₀) (β₀ : P₀ ⟶ Y), IsFinite β₀ ∧ Surjective β₀ ∧ ∀ (U : Y.Opens) (_ : IsAffineOpen U) (hη : genericPoint Y ∈ U) (F : Polynomial Γ(Y, U)), F.Monic → (∃ m : Multiset L, F.map ((algebraMap Y.functionField L).comp (Y.presheaf.germ U (genericPoint Y) hη).hom) = (m.map fun c => Polynomial.X - Polynomial.C c).prod) → ∃ m' : Multiset Γ(P₀, β₀ ⁻¹ᵁ U), F.map (β₀.app U).hom = (m'.map fun c => Polynomial.X - Polynomial.C c).prod :=
by
  intro k _ _ Y _ sY _ L _ _ _
  classical

  have hpushT : ∀ {R S : Type u} [CommRing R] [CommRing S] (j : R →+* S) (m : Multiset R),
      ((m.map fun c => Polynomial.X - Polynomial.C c).prod).map j =
        ((m.map j).map fun c => Polynomial.X - Polynomial.C c).prod := by
    intro R S _ _ j m
    rw [Polynomial.map_multiset_prod, Multiset.map_map, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro c _
    simp

  have s2T : ∀ (A B M : Type u) [CommRing A] [CommRing B] [CommRing M] [Algebra A B] (e : B ≃+* M)
      (ψ : A →+* M), (∀ a : A, e (algebraMap A B a) = ψ a) → ∀ F : Polynomial A, F.Monic →
      (∃ m : Multiset M, F.map ψ = (m.map fun c => Polynomial.X - Polynomial.C c).prod) →
      ∃ m' : Multiset (integralClosure A B), F.map (algebraMap A (integralClosure A B)) =
        (m'.map fun c => Polynomial.X - Polynomial.C c).prod := by
    intro A B M _ _ _ _ e ψ he F hF hm
    obtain ⟨m, hm⟩ := hm
    let j : M →+* B := e.symm.toRingHom
    have hcomp : j.comp ψ = algebraMap A B := by
      ext a
      show e.symm (ψ a) = algebraMap A B a
      rw [← he a, RingEquiv.symm_apply_apply]
    have hB : F.map (algebraMap A B) =
        ((m.map j).map fun c => Polynomial.X - Polynomial.C c).prod := by
      rw [← hcomp, ← Polynomial.map_map, hm, hpushT]
    have hint : ∀ b ∈ m.map j, b ∈ integralClosure A B := by
      intro b hb
      refine ⟨F, hF, ?_⟩
      rw [← Polynomial.eval_map, hB, Polynomial.eval_multiset_prod]
      apply Multiset.prod_eq_zero
      rw [Multiset.map_map, Multiset.mem_map]
      exact ⟨b, hb, by simp⟩
    obtain ⟨m'', hm''⟩ : ∃ m'' : Multiset (integralClosure A B),
        m''.map (algebraMap (integralClosure A B) B) = m.map j := by
      refine ⟨(m.map j).attach.map (fun x => (⟨x.1, hint x.1 x.2⟩ : integralClosure A B)), ?_⟩
      rw [Multiset.map_map]
      exact Multiset.attach_map_val _
    refine ⟨m'', ?_⟩
    have hinj : Function.Injective (algebraMap (integralClosure A B) B) :=
      fun x y h => Subtype.ext h
    apply Polynomial.map_injective _ hinj
    have htow : (algebraMap (integralClosure A B) B).comp (algebraMap A (integralClosure A B)) =
        algebraMap A B := RingHom.ext fun _ => rfl
    rw [Polynomial.map_map, htow, hB, hpushT, hm'']

  have s6T : ∀ (A K M : Type u) [CommRing A] [IsDomain A] [Field K] [Field M] [Algebra A K]
      [IsFractionRing A K] [Algebra K M] [Algebra A M] [IsScalarTower A K M]
      [FiniteDimensional K M], ∃ B : Subalgebra A M, Module.Finite A B ∧ IsFractionRing B M := by
    intro A K M _ _ _ _ _ _ _ _ _ _
    obtain ⟨s, b, hb⟩ := FiniteDimensional.exists_is_basis_integral A K M
    refine ⟨Algebra.adjoin A (Set.range b), ?_, ?_⟩
    · exact Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range b)
        (by rintro _ ⟨i, rfl⟩; exact hb i)
    · haveI : FaithfulSMul (Algebra.adjoin A (Set.range b)) M :=
        (faithfulSMul_iff_algebraMap_injective _ _).mpr (fun x y h => Subtype.ext h)
      refine IsFractionRing.of_field _ M (fun z => ?_)
      obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A) Finset.univ
        (fun i => b.repr z i)
      have hd' : ∀ i, ∃ y : A, algebraMap A K y = (d : A) • b.repr z i :=
        fun i => RingHom.mem_rangeS.mp (hd i (Finset.mem_univ i))
      choose a ha using hd'
      have hz : (d : A) • z = ∑ i, a i • b i := by
        conv_lhs => rw [← b.sum_repr z]
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← smul_assoc, ← ha i, algebraMap_smul]
      have hmem : (d : A) • z ∈ Algebra.adjoin A (Set.range b) := by
        rw [hz]
        exact Subalgebra.sum_mem _ (fun i _ =>
          Subalgebra.smul_mem _ (Algebra.subset_adjoin (Set.mem_range_self i)) _)
      have hd0 : algebraMap A M (d : A) ≠ 0 := by
        rw [IsScalarTower.algebraMap_apply A K M]
        exact (map_ne_zero _).mpr (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors d.2)
      refine ⟨⟨(d : A) • z, hmem⟩, algebraMap A _ (d : A), ?_⟩
      show z = ((d : A) • z) / (algebraMap A M (d : A))
      rw [eq_div_iff hd0, Algebra.smul_def, mul_comm]

  have s7T : ∀ (A : Type u) [CommRing A] [Algebra k A] [Algebra.FiniteType k A] (M : Type u)
      [Field M] [Algebra A M] (B : Subalgebra A M), Module.Finite A B → IsFractionRing B M →
      Module.Finite A (integralClosure A M) := by
    intro A _ _ _ M _ _ B hBfin hBfr
    haveI := hBfr
    letI : Algebra k B := ((algebraMap A B).comp (algebraMap k A)).toAlgebra
    haveI : IsScalarTower k A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.FiniteType A B := Module.Finite.finiteType B
    haveI : Algebra.FiniteType k B := Algebra.FiniteType.trans (S := A) inferInstance inferInstance
    haveI hN : Module.Finite B (integralClosure B (FractionRing B)) :=
      noether_integralClosure_finite k B
    haveI hBM : Module.Finite B (integralClosure B M) :=
      Module.Finite.equiv
        (IsLocalization.algEquiv (nonZeroDivisors B) (FractionRing B) M).mapIntegralClosure.toLinearEquiv
    haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
    haveI : Module.Finite A (integralClosure B M) := Module.Finite.trans B _
    let φ : integralClosure A M →ₗ[A] integralClosure B M :=
      { toFun := fun x => ⟨x.1, IsIntegral.tower_top (A := B) x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    refine Module.Finite.of_injective φ ?_
    intro x y h
    apply Subtype.ext
    have h' := congrArg (fun z : integralClosure B M => (z : M)) h
    exact h'

  have genB : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S) (V : (Spec R).Opens)
      (e : (⊤ : (Spec S).Opens) ≤ (Spec.map φ) ⁻¹ᵁ V)
      (i : Opposite.op (⊤ : (Spec R).Opens) ⟶ Opposite.op V),
      (Spec R).presheaf.map i ≫ (Spec.map φ).appLE V ⊤ e ≫ (Scheme.ΓSpecIso S).hom =
        (Scheme.ΓSpecIso R).hom ≫ φ := by
    intro R S φ V e i
    rw [Scheme.Hom.map_appLE_assoc, ← Scheme.ΓSpecIso_naturality]
    rfl
  have s1mainA : ∀ (U : Y.Opens) (hη : genericPoint Y ∈ U)
      (hle : (⊤ : (Spec (.of L)).Opens) ≤ (Spec.map (CommRingCat.ofHom (algebraMap Y.functionField L)) ≫
        Y.fromSpecStalk (genericPoint Y)) ⁻¹ᵁ U),
      (Spec.map (CommRingCat.ofHom (algebraMap Y.functionField L)) ≫
        Y.fromSpecStalk (genericPoint Y)).appLE U ⊤ hle ≫ (Scheme.ΓSpecIso (.of L)).hom =
        Y.presheaf.germ U (genericPoint Y) hη ≫ CommRingCat.ofHom (algebraMap Y.functionField L) := by
    intro U hη hle
    rw [Scheme.Hom.comp_appLE, Scheme.fromSpecStalk_app hη]
    simp only [Category.assoc]
    refine Eq.trans (congrArg (fun t => Y.presheaf.germ U (genericPoint Y) hη ≫
      (Scheme.ΓSpecIso (Y.presheaf.stalk (genericPoint Y))).inv ≫ t)
      (genB (CommRingCat.ofHom (algebraMap Y.functionField L))
        (Y.fromSpecStalk (genericPoint Y) ⁻¹ᵁ U) hle _)) ?_
    exact congrArg (fun t => Y.presheaf.germ U (genericPoint Y) hη ≫ t)
      (Iso.inv_hom_id_assoc (Scheme.ΓSpecIso (Y.presheaf.stalk (genericPoint Y)))
        (CommRingCat.ofHom (algebraMap Y.functionField L)))
  have s1full : ∀ (f : Spec (.of L) ⟶ Y) (U : Y.Opens)
      (h : (⊤ : (Spec (.of L)).Opens) = f ⁻¹ᵁ U) (R : CommRingCat.{u}) (g : Γ(Y, U) ⟶ R)
      (ψ : R →+* L),
      f.appLE U ⊤ h.le ≫ (Scheme.ΓSpecIso (.of L)).hom = g ≫ CommRingCat.ofHom ψ →
      ∃ e : Γ(Spec (.of L), f ⁻¹ᵁ U) ≃+* L,
        ∀ a : Γ(Y, U), e ((f.app U).hom a) = ψ (g.hom a) := by
    intro f U h R g ψ key
    refine ⟨((Spec (.of L)).presheaf.mapIso (eqToIso h).op ≪≫
        Scheme.ΓSpecIso (.of L)).commRingCatIsoToRingEquiv, fun a => ?_⟩
    have := congrArg (fun g => g.hom a) key
    exact this

  obtain ⟨f, hf⟩ : ∃ f : Spec (.of L) ⟶ Y, f = Spec.map (CommRingCat.ofHom
      (algebraMap Y.functionField L)) ≫ Y.fromSpecStalk (genericPoint Y) := ⟨_, rfl⟩
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated sY
  haveI : QuasiCompact f := quasiCompact_of_compactSpace f
  haveI : QuasiSeparated f := by subst hf; infer_instance
  have hgen : ∀ x, f x ⤳ genericPoint Y := by
    intro x
    have hx : f x ∈ Set.range (Y.fromSpecStalk (genericPoint Y)) := by
      subst hf; exact ⟨_, (Scheme.Hom.comp_apply _ _ x).symm⟩
    rw [Scheme.range_fromSpecStalk] at hx
    exact hx

  have s1 : ∀ (U : Y.Opens) (hη : genericPoint Y ∈ U), ∃ e : Γ(Spec (.of L), f ⁻¹ᵁ U) ≃+* L,
      ∀ a : Γ(Y, U), e ((f.app U).hom a) =
        algebraMap Y.functionField L ((Y.presheaf.germ U (genericPoint Y) hη).hom a) := by
    intro U hη
    have h : (⊤ : (Spec (.of L)).Opens) = f ⁻¹ᵁ U := by
      symm
      rw [eq_top_iff]
      intro x _
      rw [Scheme.Hom.mem_preimage]
      exact (hgen x).mem_open U.isOpen hη
    have key : f.appLE U ⊤ h.le ≫ (Scheme.ΓSpecIso (.of L)).hom =
        Y.presheaf.germ U (genericPoint Y) hη ≫ CommRingCat.ofHom (algebraMap Y.functionField L) := by
      subst hf
      exact s1mainA U hη h.le
    exact s1full f U h _ _ _ key

  have hsurj : Surjective f.fromNormalization := by
    refine ⟨fun y => ?_⟩
    have hclosed : IsClosed (Set.range f.fromNormalization) :=
      f.fromNormalization.isClosedMap.isClosed_range
    obtain ⟨x⟩ : Nonempty (Spec (.of L)) := inferInstance
    have h1 : f.fromNormalization (f.toNormalization x) = f x := by
      rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
    have h2 : genericPoint Y ∈ Set.range f.fromNormalization :=
      (hgen x).mem_closed hclosed ⟨_, h1⟩
    exact ((genericPoint_spec Y).specializes (Set.mem_univ y)).mem_closed hclosed h2

  have happ : ∀ U : Y.Opens, IsAffineOpen U → (f.fromNormalization.app U).hom.Finite := by
    intro U hU
    by_cases hne : (U : Set Y).Nonempty
    · have hη : genericPoint Y ∈ U :=
        ((genericPoint_spec Y).mem_open_set_iff U.isOpen).mpr (by simpa using hne)
      haveI : Nonempty U := ⟨⟨_, hη⟩⟩
      obtain ⟨e, he⟩ := s1 U hη
      have hFT := HasRingHomProperty.appLE @LocallyOfFiniteType sY inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
      let ρ : k →+* Γ(Y, U) := (sY.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom
      have hρ : ρ.FiniteType := RingHom.FiniteType.comp hFT (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso (.of k)).commRingCatIsoToRingEquiv.symm.surjective)
      letI : Algebra k Γ(Y, U) := ρ.toAlgebra
      haveI : Algebra.FiniteType k Γ(Y, U) := hρ
      letI : Algebra Γ(Y, U) L :=
        ((algebraMap Y.functionField L).comp (algebraMap Γ(Y, U) Y.functionField)).toAlgebra
      haveI : IsScalarTower Γ(Y, U) Y.functionField L :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : IsFractionRing Γ(Y, U) Y.functionField :=
        functionField_isFractionRing_of_isAffineOpen Y U hU
      obtain ⟨B', hB'fin, hB'fr⟩ := s6T Γ(Y, U) Y.functionField L
      haveI hAL : Module.Finite Γ(Y, U) (integralClosure Γ(Y, U) L) :=
        s7T Γ(Y, U) L B' hB'fin hB'fr
      letI : Algebra Γ(Y, U) Γ(Spec (.of L), f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
      let eA : L ≃ₐ[Γ(Y, U)] Γ(Spec (.of L), f ⁻¹ᵁ U) := AlgEquiv.ofRingEquiv (f := e.symm)
        (fun a => by rw [RingEquiv.symm_apply_eq]; exact (he a).symm)
      haveI : Module.Finite Γ(Y, U) (integralClosure Γ(Y, U) Γ(Spec (.of L), f ⁻¹ᵁ U)) :=
        Module.Finite.equiv eA.mapIntegralClosure.toLinearEquiv
      rw [Scheme.Hom.fromNormalization_app f hU, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact RingHom.Finite.comp (RingHom.Finite.of_surjective _
        (Scheme.Hom.normalizationObjIso f hU).commRingCatIsoToRingEquiv.symm.surjective)
        (RingHom.finite_algebraMap.mpr inferInstance)
    · have hU0 : U = ⊥ := by
        by_contra h
        rw [← Ne, TopologicalSpace.Opens.ne_bot_iff_nonempty] at h
        exact hne h
      subst hU0
      haveI : Subsingleton Γ(f.normalization, f.fromNormalization ⁻¹ᵁ ⊥) :=
        CommRingCat.subsingleton_of_isTerminal
          (f.normalization.sheaf.isTerminalOfEqEmpty (Scheme.Hom.preimage_bot _))
      exact RingHom.Finite.of_surjective _ (fun b => ⟨0, Subsingleton.elim _ _⟩)
  have hfin : IsFinite f.fromNormalization := by
    rw [isFinite_iff]
    exact ⟨inferInstance, happ⟩

  refine ⟨f.normalization, inferInstance, f.fromNormalization, hfin, hsurj, ?_⟩
  intro U hU hη F hFm hsplit
  obtain ⟨e, he⟩ := s1 U hη
  letI : Algebra Γ(Y, U) Γ(Spec (.of L), f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
  obtain ⟨m₁, hm₁⟩ := s2T Γ(Y, U) Γ(Spec (.of L), f ⁻¹ᵁ U) L e
    ((algebraMap Y.functionField L).comp (Y.presheaf.germ U (genericPoint Y) hη).hom) he F hFm hsplit
  refine ⟨m₁.map (Scheme.Hom.normalizationObjIso f hU).inv.hom, ?_⟩
  rw [Scheme.Hom.fromNormalization_app f hU, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
    ← Polynomial.map_map, hm₁, hpushT]

theorem wcpa_dj_ssprf_local_split : ∀ (S T : Scheme.{u}) (t : T ⟶ S) [IsFinite t] [FormallyUnramified t] (U : S.Opens), IsAffineOpen U → ∀ (n : ℕ) (s : Fin n → Γ(T, t ⁻¹ᵁ U)) (F : Fin n → Polynomial Γ(S, U)), (∀ b : Γ(T, t ⁻¹ᵁ U), b ∈ Subring.closure (Set.range (t.app U).hom ∪ Set.range s)) → (∀ i, Polynomial.eval₂ (t.app U).hom (s i) (F i) = 0) → ∀ (Y : Scheme.{u}) (φ : Y ⟶ S) (y : Y) (hy : y ∈ φ ⁻¹ᵁ U), (∀ i, ∃ m : Multiset (Y.residueField y), (F i).map (φ.app U ≫ Y.evaluation (φ ⁻¹ᵁ U) y hy).hom = (m.map fun c => Polynomial.X - Polynomial.C c).prod) → ∀ w : ↥(Limits.pullback t (Y.fromSpecResidueField y ≫ φ)), ∃ W : (Limits.pullback t (Y.fromSpecResidueField y ≫ φ)).Opens, w ∈ W ∧ IsIso (W.ι ≫ Limits.pullback.snd t (Y.fromSpecResidueField y ≫ φ)) :=
by
  intro S T t _ _ U hU n s F hgen hroot Y φ y hy hsplit w
  classical

  have KEY : ∀ (A B K : Type u) [CommRing A] [CommRing B] [CommRing K] (hK : IsField K)
      [Algebra A B] [Algebra A K] [Module.Finite A B] [Algebra.FormallyUnramified A B]
      (n : ℕ) (s : Fin n → B) (F : Fin n → Polynomial A),
      (∀ b : B, b ∈ Subring.closure (Set.range (algebraMap A B) ∪ Set.range s)) →
      (∀ i, Polynomial.eval₂ (algebraMap A B) (s i) (F i) = 0) →
      (∀ i, ∃ m : Multiset K, (F i).map (algebraMap A K) =
        (m.map fun c => Polynomial.X - Polynomial.C c).prod) →
      ∀ P : Ideal (TensorProduct A K B), P.IsPrime → ∃ e ∉ P,
        Function.Bijective ((algebraMap (TensorProduct A K B) (Localization.Away e)).comp
          (algebraMap K (TensorProduct A K B))) := by
    intro A B K _ _ _ hK _ _ _ _ n s F hgen hroot hsplit P hP
    have hθ : ∀ c : K, algebraMap K (TensorProduct A K B) c = c ⊗ₜ[A] (1 : B) := fun c => by
      simp [Algebra.TensorProduct.algebraMap_apply]
    have hcomm : ∀ a : A, (1 : K) ⊗ₜ[A] algebraMap A B a = algebraMap A K a ⊗ₜ[A] (1 : B) := by
      intro a
      rw [Algebra.algebraMap_eq_smul_one a, Algebra.algebraMap_eq_smul_one a, TensorProduct.smul_tmul]
    let ψ : B →+* TensorProduct A K B := Algebra.TensorProduct.includeRight.toRingHom
    have hψ : ∀ b, ψ b = (1 : K) ⊗ₜ[A] b := fun b => rfl
    have hc : ψ.comp (algebraMap A B) = (algebraMap K (TensorProduct A K B)).comp (algebraMap A K) := by
      ext a
      rw [RingHom.comp_apply, RingHom.comp_apply, hψ, hθ, hcomm]

    have hR : ∀ b : B, ψ b ∈ Subring.closure (Set.range (algebraMap K (TensorProduct A K B)) ∪
        Set.range (fun i => ψ (s i))) := by
      intro b
      have hle : Subring.closure (Set.range (algebraMap A B) ∪ Set.range s) ≤
          (Subring.closure (Set.range (algebraMap K (TensorProduct A K B)) ∪
            Set.range (fun i => ψ (s i)))).comap ψ := by
        rw [Subring.closure_le]
        rintro x (⟨a, rfl⟩ | ⟨i, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap]
          have h1 : ψ (algebraMap A B a) = algebraMap K (TensorProduct A K B) (algebraMap A K a) :=
            RingHom.congr_fun hc a
          rw [h1]
          exact Subring.subset_closure (Or.inl ⟨_, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap]
          exact Subring.subset_closure (Or.inr ⟨i, rfl⟩)
      exact Subring.mem_comap.mp (hle (hgen b))
    have hgenC : ∀ r : TensorProduct A K B, r ∈ Subring.closure
        (Set.range (algebraMap K (TensorProduct A K B)) ∪ Set.range (fun i => ψ (s i))) := by
      intro r
      refine TensorProduct.induction_on r ?_ ?_ ?_
      · exact Subring.zero_mem _
      · intro x b
        have hxb : x ⊗ₜ[A] b = algebraMap K (TensorProduct A K B) x * ψ b := by
          rw [hθ, hψ, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hxb]
        exact Subring.mul_mem _ (Subring.subset_closure (Or.inl ⟨x, rfl⟩)) (hR b)
      · intro x y hx hy
        exact Subring.add_mem _ hx hy

    have hrel : ∀ i, ∃ m : Multiset K,
        (m.map fun c => ψ (s i) - algebraMap K (TensorProduct A K B) c).prod = 0 := by
      intro i
      obtain ⟨m, hm⟩ := hsplit i
      refine ⟨m, ?_⟩
      have h1 : Polynomial.eval₂ (algebraMap K (TensorProduct A K B)) (ψ (s i))
          ((F i).map (algebraMap A K)) = 0 := by
        rw [Polynomial.eval₂_map, ← hc, ← Polynomial.hom_eval₂, hroot i, map_zero]
      rw [hm, Polynomial.eval₂_multiset_prod, Multiset.map_map] at h1
      simpa [Function.comp_def] using h1

    haveI := hP
    have hsurj : Function.Surjective
        ((Ideal.Quotient.mk P).comp (algebraMap K (TensorProduct A K B))) := by
      have hle : Subring.closure (Set.range (algebraMap K (TensorProduct A K B)) ∪
          Set.range (fun i => ψ (s i))) ≤
          (((Ideal.Quotient.mk P).comp (algebraMap K (TensorProduct A K B))).range).comap
            (Ideal.Quotient.mk P) := by
        rw [Subring.closure_le]
        rintro x (⟨c, rfl⟩ | ⟨i, rfl⟩)
        · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨c, rfl⟩)
        · obtain ⟨m, hm⟩ := hrel i
          have h0 : (m.map fun c => Ideal.Quotient.mk P (ψ (s i)) -
              Ideal.Quotient.mk P (algebraMap K (TensorProduct A K B) c)).prod = 0 := by
            have h2 := congrArg (Ideal.Quotient.mk P) hm
            rw [map_zero, map_multiset_prod, Multiset.map_map] at h2
            simpa [Function.comp_def] using h2
          rw [Multiset.prod_eq_zero_iff] at h0
          obtain ⟨c, _, hc'⟩ := Multiset.mem_map.mp h0
          exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨c, (sub_eq_zero.mp hc').symm⟩)
      intro z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨c, hc'⟩ := RingHom.mem_range.mp (Subring.mem_comap.mp (hle (hgenC r)))
      exact ⟨c, hc'⟩

    haveI : IsArtinianRing K := by letI := hK.toField; infer_instance
    haveI : IsArtinianRing (TensorProduct A K B) := IsArtinianRing.of_finite K (TensorProduct A K B)
    haveI hred : _root_.IsReduced (TensorProduct A K B) := by
      letI := hK.toField
      exact Algebra.FormallyUnramified.isReduced_of_field K (TensorProduct A K B)
    obtain ⟨e, heP, hidem, hq⟩ := IsArtinianRing.exists_not_mem_forall_mem_of_ne P
    refine ⟨e, heP, ?_⟩
    have hu : IsUnit (algebraMap (TensorProduct A K B) (Localization.Away e) e) :=
      IsLocalization.Away.algebraMap_isUnit e
    have he1 : algebraMap (TensorProduct A K B) (Localization.Away e) e = 1 := by
      have h2 : algebraMap (TensorProduct A K B) (Localization.Away e) e *
          algebraMap (TensorProduct A K B) (Localization.Away e) e =
          algebraMap (TensorProduct A K B) (Localization.Away e) e * 1 := by
        rw [← map_mul, hidem.eq, mul_one]
      exact hu.mul_left_cancel h2
    have hP0 : ∀ r ∈ P, algebraMap (TensorProduct A K B) (Localization.Away e) r = 0 := by
      intro r hr
      have hnil : IsNilpotent (r * e) := by
        rw [nilpotent_iff_mem_prime]
        intro J hJ
        by_cases hJP : J = P
        · subst hJP; exact J.mul_mem_right e hr
        · exact J.mul_mem_left r (hq J hJ hJP)
      have h0 : r * e = 0 := IsReduced.eq_zero _ hnil
      calc algebraMap (TensorProduct A K B) (Localization.Away e) r
          = algebraMap (TensorProduct A K B) (Localization.Away e) r *
            algebraMap (TensorProduct A K B) (Localization.Away e) e := by rw [he1, mul_one]
        _ = algebraMap (TensorProduct A K B) (Localization.Away e) (r * e) := (map_mul _ _ _).symm
        _ = 0 := by rw [h0, map_zero]
    have hsurjι : Function.Surjective (algebraMap (TensorProduct A K B) (Localization.Away e)) := by
      intro z
      obtain ⟨⟨r, m⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers e) z
      obtain ⟨k, hk⟩ := m.2
      refine ⟨r, ?_⟩
      have h3 := IsLocalization.mk'_spec (Localization.Away e) r m
      rw [← hk, map_pow, he1, one_pow, mul_one] at h3
      exact h3.symm
    haveI hnt : Nontrivial (Localization.Away e) := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      have h1 : algebraMap (TensorProduct A K B) (Localization.Away e) 1 = 0 := by
        rw [map_one]; exact h.symm
      obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers e) (Localization.Away e) 1).mp h1
      have hk' : e ^ k = 0 := by simpa using hk
      apply heP
      have he0 : e = 0 := by
        calc e = e ^ (k + 1) := (hidem.pow_succ_eq k).symm
          _ = 0 := by rw [pow_succ, hk', zero_mul]
      rw [he0]; exact P.zero_mem
    constructor
    · rw [injective_iff_map_eq_zero]
      intro c hc0
      by_contra hne
      obtain ⟨b, hb⟩ := hK.mul_inv_cancel hne
      have h4 := congrArg ((algebraMap (TensorProduct A K B) (Localization.Away e)).comp
        (algebraMap K (TensorProduct A K B))) hb
      rw [map_mul, hc0, zero_mul, map_one] at h4
      exact zero_ne_one h4
    · intro z
      obtain ⟨r, rfl⟩ := hsurjι z
      obtain ⟨c, hc'⟩ := hsurj (Ideal.Quotient.mk P r)
      refine ⟨c, ?_⟩
      have hmem : algebraMap K (TensorProduct A K B) c - r ∈ P := Ideal.Quotient.eq.mp hc'
      have h5 := hP0 _ hmem
      rw [map_sub, sub_eq_zero] at h5
      exact h5

  have LSpec : ∀ (K C : Type u) [CommRing K] [CommRing C] [Algebra K C] (e : C),
      Function.Bijective ((algebraMap C (Localization.Away e)).comp (algebraMap K C)) →
      ∀ x : PrimeSpectrum C, e ∉ x.asIdeal →
      ∃ W : (Spec (CommRingCat.of C)).Opens, x ∈ W ∧
        IsIso (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K C))) := by
    intro K C _ _ _ e hbij x hx
    have hrange := PrimeSpectrum.localization_away_comap_range (Localization.Away e) e
    refine ⟨(Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away e)))).opensRange, ?_, ?_⟩
    · have hx' : x ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away e))) := by
        rw [hrange]; exact hx
      obtain ⟨z, hz⟩ := hx'
      show x ∈ ((Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away e)))).opensRange :
        Set (Spec (CommRingCat.of C)))
      rw [Scheme.Hom.coe_opensRange]
      exact ⟨z, hz⟩
    · have h1 := Scheme.Hom.isoOpensRange_hom_ι
        (Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away e))))
      have h2 : (Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away e)))).opensRange.ι =
          (Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away e)))).isoOpensRange.inv ≫
            Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away e))) := by
        rw [Iso.eq_inv_comp, h1]
      rw [h2, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      haveI : IsIso (Spec.map (CommRingCat.ofHom
          ((algebraMap C (Localization.Away e)).comp (algebraMap K C)))) :=
        isIso_SpecMap_iff.mpr hbij
      infer_instance

  have hU' : φ y ∈ U := hy
  have hV : IsAffineOpen (t ⁻¹ᵁ U) := hU.preimage t
  have hg : Y.fromSpecResidueField y ≫ φ =
      Spec.map (φ.app U ≫ Y.evaluation (φ ⁻¹ᵁ U) y hy) ≫ hU.fromSpec := by
    have key : S.presheaf.germ U (φ y) hU' ≫ φ.stalkMap y ≫ Y.residue y =
        φ.app U ≫ Y.evaluation (φ ⁻¹ᵁ U) y hy :=
      Scheme.Hom.germ_stalkMap_assoc φ U y hU' (Y.residue y)
    rw [Scheme.fromSpecResidueField, Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
      ← IsAffineOpen.fromSpecStalk_eq_fromSpecStalk hU hU', IsAffineOpen.fromSpecStalk, ← key,
      Spec.map_comp, Spec.map_comp]
    simp only [Category.assoc]
  have sq1 : IsPullback (Spec.map (t.app U)) hV.fromSpec hU.fromSpec t := by
    have h := IsOpenImmersion.isPullback (Spec.map (t.appLE U (t ⁻¹ᵁ U) le_rfl)) hV.fromSpec
      hU.fromSpec t (IsAffineOpen.SpecMap_appLE_fromSpec t hU hV le_rfl).symm
      (by rw [IsAffineOpen.opensRange_fromSpec, IsAffineOpen.opensRange_fromSpec])
    rwa [Scheme.Hom.appLE_eq_app] at h
  letI algB : Algebra Γ(S, U) Γ(T, t ⁻¹ᵁ U) := (t.app U).hom.toAlgebra
  letI algK : Algebra Γ(S, U) (Y.residueField y) :=
    (φ.app U ≫ Y.evaluation (φ ⁻¹ᵁ U) y hy).hom.toAlgebra
  haveI hfinB : Module.Finite Γ(S, U) Γ(T, t ⁻¹ᵁ U) := ((isFinite_iff t).mp inferInstance).2 U hU
  haveI hfuB : Algebra.FormallyUnramified Γ(S, U) Γ(T, t ⁻¹ᵁ U) := by
    have h := AlgebraicGeometry.FormallyUnramified.formallyUnramified_appLE (f := t) hU hV le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    exact h
  have hpo := CommRingCat.isPushout_tensorProduct Γ(S, U) (Y.residueField y) Γ(T, t ⁻¹ᵁ U)
  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hθeq : (Algebra.TensorProduct.includeLeftRingHom :
      (Y.residueField y) →+* TensorProduct Γ(S, U) (Y.residueField y) Γ(T, t ⁻¹ᵁ U)) =
      algebraMap _ _ := by
    ext c
    simp [Algebra.TensorProduct.algebraMap_apply]
  have sqC : IsPullback
      (Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫ hV.fromSpec)
      (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y)
        (TensorProduct Γ(S, U) (Y.residueField y) Γ(T, t ⁻¹ᵁ U))))) t
      (Y.fromSpecResidueField y ≫ φ) := by
    rw [hg, ← hθeq]
    exact IsPullback.paste_horiz hpb.flip sq1.flip
  have hK : IsField (Y.residueField y) := Field.toIsField _
  obtain ⟨x', hx'⟩ : ∃ x' : PrimeSpectrum (TensorProduct Γ(S, U) (Y.residueField y) Γ(T, t ⁻¹ᵁ U)),
      x' = sqC.isoPullback.inv w := ⟨_, rfl⟩
  obtain ⟨e, heP, hbij⟩ := KEY _ _ _ hK n s F hgen hroot hsplit x'.asIdeal inferInstance
  obtain ⟨W', hxW', hiso⟩ := LSpec _ _ e hbij x' heP
  refine ⟨sqC.isoPullback.inv ⁻¹ᵁ W', ?_, ?_⟩
  · show sqC.isoPullback.inv w ∈ W'
    rw [← hx']
    exact hxW'
  · rw [← IsPullback.isoPullback_inv_snd sqC, ← Category.assoc, ← morphismRestrict_ι,
      Category.assoc]
    infer_instance

theorem wcpa_dj_ssp_rationalize_finite : ∀ (k : Type u) [Field k] [Finite k] (P' T : Scheme.{u})
    [AlgebraicGeometry.IsIntegral P'] (sP' : P' ⟶ Spec (.of k)) (t : T ⟶ P'),
    wcpaDjIsProjOver k sP' → IsFinite t → FormallyUnramified t →
    ∃ (P'' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P'') (β : P'' ⟶ P'),
      wcpaDjIsProjOver k (β ≫ sP') ∧ IsProper β ∧ Surjective β ∧
      (∃ V : P'.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) ∧
      ∀ (p : P'') (w : ↥(Limits.pullback t (P''.fromSpecResidueField p ≫ β))),
        ∃ W : (Limits.pullback t (P''.fromSpecResidueField p ≫ β)).Opens, w ∈ W ∧
          IsIso (W.ι ≫ Limits.pullback.snd t (P''.fromSpecResidueField p ≫ β)) :=
by
  intro k _ _ P' T _ sP' t hP' htfin htunr
  haveI := htfin
  haveI := htunr
  haveI hsP' : IsProper sP' := wcpa_dj_proj_proper k sP' hP'
  haveI : CompactSpace P' := QuasiCompact.compactSpace_of_compactSpace sP'
  haveI : PerfectField k := PerfectField.ofFinite
  haveI hne : Nonempty P' := IsIntegral.nonempty
  obtain ⟨m, U, hUaff, hUne, hUcov, hpres⟩ := wcpa_dj_ssprf_affine_presentation P' T t
  choose n s F hgen hmon hroot using hpres
  have hη : ∀ a, genericPoint P' ∈ U a := fun a =>
    ((genericPoint_spec P').mem_open_set_iff (U a).isOpen).mpr (by simpa using hUne a)
  let G : (Σ a : Fin m, Fin (n a)) → Polynomial P'.functionField :=
    fun ai => (F ai.1 ai.2).map (P'.presheaf.germ (U ai.1) (genericPoint P') (hη ai.1)).hom
  have hGmon : ∀ ai, (G ai).Monic := fun ai => (hmon ai.1 ai.2).map _
  obtain ⟨L, iL, iA, hfin, hsplit⟩ := wcpa_dj_ssprf_splitting_field P'.functionField _ G hGmon
  obtain ⟨P₀, iP₀, β₀, hβ₀fin, hβ₀surj, htransfer⟩ := wcpa_dj_ssprf_normalize k P' sP' L
  haveI := iP₀
  have hspl0 : ∀ a i, ∃ m' : Multiset Γ(P₀, β₀ ⁻¹ᵁ U a), (F a i).map (β₀.app (U a)).hom =
      (m'.map fun c => Polynomial.X - Polynomial.C c).prod := by
    intro a i
    obtain ⟨mm, hmm⟩ := hsplit ⟨a, i⟩
    exact htransfer (U a) (hUaff a) (hη a) (F a i) (hmon a i)
      ⟨mm, by rw [← Polynomial.map_map]; exact hmm⟩
  have hSPL0 : ∀ (p : P₀) (w : ↥(Limits.pullback t (P₀.fromSpecResidueField p ≫ β₀))),
      ∃ W : (Limits.pullback t (P₀.fromSpecResidueField p ≫ β₀)).Opens, w ∈ W ∧
        IsIso (W.ι ≫ Limits.pullback.snd t (P₀.fromSpecResidueField p ≫ β₀)) := by
    intro p w
    have hp : β₀ p ∈ (⨆ a, U a) := by rw [hUcov]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
    have hy : p ∈ β₀ ⁻¹ᵁ U a := ha
    refine wcpa_dj_ssprf_local_split P' T t (U a) (hUaff a) (n a) (s a) (F a) (hgen a) (hroot a)
      P₀ β₀ p hy ?_ w
    intro i
    obtain ⟨m', hm'⟩ := hspl0 a i
    refine ⟨m'.map (P₀.evaluation (β₀ ⁻¹ᵁ U a) p hy).hom, ?_⟩
    rw [CommRingCat.hom_comp, ← Polynomial.map_map, hm', Polynomial.map_multiset_prod,
      Multiset.map_map, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro c _
    simp
  haveI : IsFinite β₀ := hβ₀fin
  haveI : IsProper (β₀ ≫ sP') := inferInstance
  obtain ⟨P'', iP'', α₀, hproj, hα₀p, hα₀s, hα₀f⟩ := wcpa_dj_cf_chow_projective k P₀ (β₀ ≫ sP')
  haveI := iP''
  haveI := hα₀p
  have htop : (⊤ : P'.Opens) ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    exact Set.univ_nonempty
  obtain ⟨hs, hf⟩ :=
    wcpa_dj_alteration_comp β₀ α₀ inferInstance hβ₀surj hα₀s ⟨⊤, htop, inferInstance⟩ hα₀f
  refine ⟨P'', iP'', α₀ ≫ β₀, by rw [Category.assoc]; exact hproj, inferInstance, hs, hf, ?_⟩
  exact wcpa_dj_ssprf_split_comp P' T P₀ P'' t β₀ α₀ hSPL0

theorem wcpa_dj_ss_split : ∀ (k : Type u) [Field k] [Finite k] (C P' : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] [AlgebraicGeometry.IsIntegral P'] (sP' : P' ⟶ Spec (.of k))
    (g : C ⟶ P'), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → wcpaDjSemistable g →
    ∀ U' : P'.Opens, U' ≠ ⊥ → SmoothOfRelativeDimension 1 (g ∣_ U') →
    GeometricallyConnected (g ∣_ U') →
    ∀ (n : ℕ) (τ : Fin n → (P' ⟶ C)), wcpaDjSections g n τ →
    ∃ (P'' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P'') (sP'' : P'' ⟶ Spec (.of k))
      (β₃ : P'' ⟶ P'),
      β₃ ≫ sP' = sP'' ∧ wcpaDjIsProjOver k sP'' ∧ IsProper β₃ ∧ Surjective β₃ ∧
      (∃ V : P'.Opens, V ≠ ⊥ ∧ IsFinite (β₃ ∣_ V)) ∧
      ∃ (C'' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C'') (g'' : C'' ⟶ P'')
        (h₃ : C'' ⟶ C),
        h₃ ≫ g = g'' ≫ β₃ ∧ wcpaDjIsProjOver k (g'' ≫ sP'') ∧ wcpaDjSplitSemistable g'' ∧
        IsProper h₃ ∧ Surjective h₃ ∧ (∃ V : C.Opens, V ≠ ⊥ ∧ IsFinite (h₃ ∣_ V)) ∧
        ∃ (U'' : P''.Opens) (m : ℕ) (τ'' : Fin m → (P'' ⟶ C'')),
          U'' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (g'' ∣_ U'') ∧ GeometricallyConnected (g'' ∣_ U'') ∧
          wcpaDjSections g'' m τ'' ∧
          ⇑h₃ ⁻¹' ((⋃ i, Set.range ⇑(τ i)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ)) ⊆
            (⋃ i, Set.range ⇑(τ'' i)) ∪ ⇑g'' ⁻¹' ((U'' : Set P'')ᶜ) :=
by
  intro k _ _ C P' _ _ sP' g hC hP' hss U' hU' hU'sm hU'gc n τ hτ
  have hgflat : Flat g := hss.1
  have hgprop : IsProper g := hss.2.1

  obtain ⟨T, t, htfin, htunr, hsplit⟩ := wcpa_dj_ssp_branch_witness k C P' sP' g hC hP' hss
  obtain ⟨P'', iP'', β, hP''proj, hβp, hβs, hβf, hres⟩ :=
    wcpa_dj_ssp_rationalize_finite k P' T sP' t hP' htfin htunr
  haveI := iP''
  haveI := hβs

  obtain ⟨hh₃p, hh₃s, hh₃f⟩ := wcpa_dj_tr_basechange_alteration P' P'' C β g hgflat hβp hβs hβf
  have hproj : wcpaDjIsProjOver k (Limits.pullback.snd g β ≫ (β ≫ sP')) :=
    wcpa_dj_tr_basechange_proj k P' P'' C sP' (β ≫ sP') β g rfl hP' hP''proj hC
  obtain ⟨τ'', hτ'', hτcont⟩ := wcpa_dj_tr_basechange_sections P' P'' C β g n τ hτ
  have hsm := wcpa_dj_tr_basechange_smooth P' P'' C β g U' hU'sm

  have hgc : GeometricallyConnected ((Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U')) := by
    have hA := isPullback_morphismRestrict g U'
    have hB := isPullback_morphismRestrict (Limits.pullback.snd g β) (β ⁻¹ᵁ U')
    have hC' : β ∣_ U' ≫ U'.ι = (β ⁻¹ᵁ U').ι ≫ β := morphismRestrict_ι β U'
    have hD : (Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U') ≫ (β ⁻¹ᵁ U').ι =
        ((Limits.pullback.snd g β) ⁻¹ᵁ (β ⁻¹ᵁ U')).ι ≫ Limits.pullback.snd g β :=
      morphismRestrict_ι _ _
    have hw : ((Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U') ≫ β ∣_ U') ≫ U'.ι =
        (((Limits.pullback.snd g β) ⁻¹ᵁ (β ⁻¹ᵁ U')).ι ≫ Limits.pullback.fst g β) ≫ g := by
      rw [Category.assoc, hC', ← Category.assoc, hD, Category.assoc, Category.assoc,
        Limits.pullback.condition]
    let h := hA.lift _ _ hw
    have hE : h ≫ g ∣_ U' = (Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U') ≫ β ∣_ U' :=
      hA.lift_fst _ _ hw
    have hF : h ≫ (g ⁻¹ᵁ U').ι =
        ((Limits.pullback.snd g β) ⁻¹ᵁ (β ⁻¹ᵁ U')).ι ≫ Limits.pullback.fst g β :=
      hA.lift_snd _ _ hw
    have hrect := IsPullback.paste_horiz hB.flip (IsPullback.of_hasPullback g β)
    rw [← hF, ← hC'] at hrect
    have hpb : IsPullback h ((Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U')) (g ∣_ U') (β ∣_ U') :=
      IsPullback.of_right hrect hE hA.flip
    exact MorphismProperty.of_isPullback (P := @GeometricallyConnected) hpb hU'gc

  have hU''ne : β ⁻¹ᵁ U' ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hU' ⊢
    obtain ⟨p, hp⟩ := hU'
    obtain ⟨q, hq⟩ := β.surjective p
    refine ⟨q, ?_⟩
    show q ∈ β ⁻¹ᵁ U'
    rw [Scheme.Hom.mem_preimage, hq]
    exact hp

  haveI : IsProper (β ≫ sP') := wcpa_dj_proj_proper k (β ≫ sP') hP''proj
  haveI : IsLocallyNoetherian P'' := LocallyOfFiniteType.isLocallyNoetherian (β ≫ sP')
  have hflat'' : Flat (Limits.pullback.snd g β) :=
    MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback g β) hgflat
  have hlft'' : LocallyOfFiniteType (Limits.pullback.snd g β) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback g β)
      (inferInstance : LocallyOfFiniteType g)
  have hC''int : AlgebraicGeometry.IsIntegral (Limits.pullback g β) :=
    wcpa_dj_ssp_integral_of_flat (Limits.pullback.snd g β) hflat'' hlft'' (β ⁻¹ᵁ U') hU''ne hsm hgc
  refine ⟨P'', iP'', β ≫ sP', β, rfl, hP''proj, hβp, hβs, hβf,
    Limits.pullback g β, hC''int, Limits.pullback.snd g β, Limits.pullback.fst g β,
    Limits.pullback.condition, hproj, hsplit P'' β hres, hh₃p, hh₃s, hh₃f,
    β ⁻¹ᵁ U', n, τ'', hU''ne, hsm, hgc, hτ'', ?_⟩
  intro x hx
  rw [Set.preimage_union] at hx
  rcases hx with hx | hx
  · exact Set.mem_union_left _ (hτcont hx)
  · refine Set.mem_union_right _ ?_
    have hx' : g (Limits.pullback.fst g β x) ∉ U' := hx
    have heq : g (Limits.pullback.fst g β x) = β (Limits.pullback.snd g β x) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    show Limits.pullback.snd g β x ∉ β ⁻¹ᵁ U'
    rw [Scheme.Hom.mem_preimage, ← heq]
    exact hx'

theorem wcpa_dj_mn_stalk_eft : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y), LocallyOfFiniteType g → IsNoetherianRing (S.presheaf.stalk (g y)) → letI := (g.stalkMap y).hom.toAlgebra; Algebra.EssFiniteType (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) ∧ IsNoetherianRing (Y.presheaf.stalk y) :=
by
  intro S Y g y hg hA
  haveI : LocallyOfFiniteType g := hg
  letI : Algebra (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) := (g.stalkMap y).hom.toAlgebra
  have hE : Algebra.EssFiniteType (S.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
    AlgebraicGeometry.LocallyOfFiniteType.stalkMap g y
  haveI := hE
  exact ⟨hE, Algebra.EssFiniteType.isNoetherianRing (S.presheaf.stalk (g y)) (Y.presheaf.stalk y)⟩

theorem wcpa_dj_mn_two_derivations : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsLocalRing A] [IsLocalRing R] [IsNoetherianRing A] [IsNoetherianRing R] [Algebra A R] [IsLocalHom (algebraMap A R)] [Algebra.EssFiniteType A R] (h : AdicCompletion (IsLocalRing.maximalIdeal A) A) (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) (AdicCompletion (IsLocalRing.maximalIdeal A) A) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h})), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp (algebraMap A R)) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) → ∀ q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), q.IsPrime → h ∈ q → ∃ P : Ideal R, ∃ _ : P.IsPrime, P.comap (algebraMap A R) = q.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) ∧ 2 ≤ Module.finrank P.ResidueField (TensorProduct R P.ResidueField (Ω[R⁄A])) :=
by
  intro A R _ _ _ _ _ _ _ _ _ h e compat q hq hhq
  classical

  have hmA : (IsLocalRing.maximalIdeal A ^ 1) ≠ ⊤ := by
    rw [pow_one]; exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
  have hk1 : (1 : A ⧸ IsLocalRing.maximalIdeal A ^ 1) ≠ 0 := by
    intro h1
    exact hmA (Ideal.Quotient.zero_eq_one_iff.mp h1.symm)



  have s1 : ∀ c : AdicCompletion (IsLocalRing.maximalIdeal A) A,
