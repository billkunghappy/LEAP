  obtain ⟨-, hQ2, -, -, hQ5, -, -, hQ8, -⟩ := hS
  obtain ⟨-, hrange, -, hgen, -⟩ := wcpa_dj_nccw_special_fibre_topology R Z' u' hst'.1.2.1
