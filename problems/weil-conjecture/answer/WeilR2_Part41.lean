    (⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) aW.isClosedEmbedding cW.isClosedEmbedding
    (Limits.pullback.fst q (nccwffG zk e)).continuous
    (fun w => by rw [← Scheme.Hom.comp_apply, hac]) (by rw [hrc]; exact hFB) hmaxN
  refine ⟨?_, ?_⟩
  ·
    intro m E p hE hEi hpi hinc
    refine T.2 ?_ m E p (fun i => ?_) hEi hpi hinc
    · intro m' E' r' hE' hE'i hr'i hinc'
      refine hFO.2 m' E' r' (fun i => ?_) hE'i hr'i hinc'
      unfold wcpaDjNcFibComp
      rw [← hra]
      exact hE' i
    · obtain ⟨⟨h1, h2, h3, -⟩, h5⟩ := hE i
