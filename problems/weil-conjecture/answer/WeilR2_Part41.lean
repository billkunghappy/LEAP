          Ideal.algebraMap_residueField_eq_zero.mpr ha, TensorProduct.tmul_zero]
      | zero => simp
      | add x y _ _ hx hy => rw [TensorProduct.add_tmul, hx, hy, add_zero]
      | smul a x _ hx =>
        have : (a • x) ⊗ₜ (1 : p.ResidueField) =
            (a ⊗ₜ (1 : p.ResidueField)) * (x ⊗ₜ (1 : p.ResidueField) : TensorProduct A B p.ResidueField) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, smul_eq_mul]
        rw [this, hx, mul_zero]
    have h1 : (y ⊗ₜ (1 : p.ResidueField) : TensorProduct A B p.ResidueField) = 0 := by
      apply IsReduced.eq_zero
      refine ⟨d + 1, ?_⟩
      rw [Algebra.TensorProduct.tmul_pow, one_pow]
      exact hzero _ hy
    have h2 : algebraMap Bb L (Ideal.Quotient.mk I y) = 0 := by
      rw [← hψ, h1, map_zero]
    obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff S L _).mp h2
    obtain ⟨t, ht, rfl⟩ := hm
    refine ⟨t, ht, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
    simpa using hm0
  have s9 : ∀ (A B C : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A] [CommRing B] [CommRing C] [Algebra A B] [Module.Flat A B] (φ : B →+* C), (∀ (P : Ideal A) [P.IsPrime], _root_.IsReduced (TensorProduct A B P.ResidueField)) → φ.Finite → Function.Injective φ → ∀ s : A, s ≠ 0 → (∀ c : C, φ (algebraMap A B s) * c = 0 → c = 0) → (∀ c : C, ∃ (n : ℕ) (b : B), φ (algebraMap A B s) ^ n * c = φ b) → Function.Bijective φ := by
    intro A B C _ _ _ _ _ _ _ _ φ hred hfin hinj s hs0 hnzd hgen
    refine ⟨hinj, fun c => ?_⟩
    obtain ⟨P, hPm, hP⟩ := hfin.to_isIntegral c
    obtain ⟨n, b, hb⟩ := hgen c
    set σ : A := s ^ n with hσ
    have hσ0 : σ ≠ 0 := pow_ne_zero n hs0
    have hσB : algebraMap A B σ = algebraMap A B s ^ n := by rw [hσ, map_pow]
    have hev : (P.scaleRoots (algebraMap A B σ)).eval b = 0 := by
      have h1 := Polynomial.scaleRoots_eval₂_eq_zero φ (s := algebraMap A B σ) hP
      rw [hσB, map_pow, hb, Polynomial.eval₂_at_apply] at h1
      apply hinj
      rw [hσB, h1, map_zero]
    have hmem : b ∈ Ideal.span {algebraMap A B σ} := by
      apply R2 A B σ b
      intro p hp
      haveI : p.IsPrime := hp.isPrime
      haveI hdvr := R3 A σ hσ0 p hp
      obtain ⟨ϖ, hϖp, hϖ0, hsat, hfac⟩ := R4 A p hdvr
      obtain ⟨k, e, s', he, hs', hes⟩ := hfac σ hσ0
      exact R5 A B p ϖ hϖp hϖ0 hsat (R6 A B p (hred p)) σ k e s' he hs' hes P hPm b hev
    obtain ⟨b1, hb1⟩ := Ideal.mem_span_singleton'.mp hmem
    have hpow : ∀ (m : ℕ) (d : C), φ (algebraMap A B s) ^ m * d = 0 → d = 0 := by
      intro m
      induction m with
      | zero => intro d hd; simpa using hd
      | succ m ih =>
        intro d hd
        apply hnzd
        apply ih
        rw [← mul_assoc, ← pow_succ]
        exact hd
    refine ⟨b1, ?_⟩
    symm
    rw [← sub_eq_zero]
    apply hpow n
    rw [mul_sub, hb, ← map_pow, ← hσB, ← map_mul, mul_comm, hb1, sub_self]
  intro k _ T _ sT hsT hnorm Z Z' u u' n τ τ' hn hst hst' hgc hgc' V Y v π a a' hv hV hpb hpb'
    hsec h G ι j hι hGred hj hjd hjι hjr hfin

  have s1 : ∀ (G Z : Scheme.{u}) (f : G ⟶ Z), IsFinite f →
      (∀ z : Z, ∃ W : Z.Opens, z ∈ W ∧ IsAffineOpen W ∧ Function.Bijective (f.app W).hom) →
      IsIso f := by
    intro G Z f _ H
    choose W hzW hW hb using H
    have hcov : iSup W = ⊤ := by
      rw [eq_top_iff]
      intro z _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzW z⟩
    show MorphismProperty.isomorphisms Scheme f
    rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme) W hcov]
    intro z
    haveI : IsAffine (W z) := hW z
    rw [@HasAffineProperty.iff_of_isAffine _ _
      instHasAffinePropertyIsomorphismsSchemeAndIsAffineIsIsoCommRingCatAppTop _ _ (f ∣_ W z) _]
    refine ⟨(hW z).preimage f, ?_⟩
    rw [morphismRestrict_appTop]
    have key : ∀ V : Z.Opens, V = W z → IsIso (f.app V) := by
      rintro V rfl
      exact (ConcreteCategory.isIso_iff_bijective _).mpr (hb z)
    have h1 : IsIso (f.app ((W z).ι ''ᵁ ⊤)) := key _ (Scheme.Opens.ι_image_top _)
    refine @IsIso.comp_isIso _ _ _ _ _ _ _ h1 ?_
    exact Functor.map_isIso _ _

  have s2 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y), AlgebraicGeometry.IsReduced Y →
      Dense (Set.range ⇑f) → ∀ U : Y.Opens, Function.Injective (f.app U).hom := by
    intro X Y f _ hd U
    rw [injective_iff_map_eq_zero]
    intro c hc
    have h1 : f ⁻¹ᵁ Y.basicOpen c = ⊥ := by
      rw [Scheme.preimage_basicOpen, hc, Scheme.basicOpen_zero]
    rw [← basicOpen_eq_bot_iff]
    by_contra hne
    obtain ⟨_, hy, x, rfl⟩ := hd.inter_open_nonempty _ (Y.basicOpen c).isOpen
      ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne)
    have : x ∈ f ⁻¹ᵁ Y.basicOpen c := hy
    rw [h1] at this
    exact this

  have s3 : ∀ (X Y Y' : Scheme.{u}) (f : X ⟶ Y) (j : Y' ⟶ X) (a : Y' ⟶ Y), IsOpenImmersion j →
      IsOpenImmersion a → j ≫ f = a → (∀ x : X, f x ∈ Set.range a → x ∈ Set.range j) →
      ∀ O : Y.Opens, (O : Set Y) ⊆ Set.range a → IsIso (f ∣_ O) := by
    intro X Y Y' f j a _ _ hja hjr O hO
    rw [isIso_iff_isOpenImmersion_and_surjective]
    have hr : Set.range (f ⁻¹ᵁ O).ι ⊆ Set.range j := by
      rw [Scheme.Opens.range_ι]
      intro x hx
      exact hjr x (hO hx)
    have hg : IsOpenImmersion.lift j (f ⁻¹ᵁ O).ι hr ≫ j = (f ⁻¹ᵁ O).ι :=
      IsOpenImmersion.lift_fac _ _ _
    refine ⟨?_, ?_⟩
    · haveI : IsOpenImmersion ((f ∣_ O) ≫ O.ι) := by
        rw [morphismRestrict_ι, ← hg, Category.assoc, hja]
        infer_instance
      exact IsOpenImmersion.of_comp (f ∣_ O) O.ι
    · constructor
      intro o
      have ho : O.ι o ∈ Set.range O.ι := ⟨o, rfl⟩
      rw [Scheme.Opens.range_ι] at ho
      obtain ⟨y, hy⟩ := hO ho
      have hjy : j y ∈ Set.range (f ⁻¹ᵁ O).ι := by
        rw [Scheme.Opens.range_ι]
        show f (j y) ∈ O
        rw [← Scheme.Hom.comp_apply, hja, hy]
        exact ho
      obtain ⟨x', hx'⟩ := hjy
      refine ⟨x', O.ι.isOpenEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply, hx',
        ← Scheme.Hom.comp_apply, hja, hy]

  have s4 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y), IsAffineHom f → ∀ (U : Y.Opens), IsAffineOpen U →
      ∀ (r : Γ(Y, U)), IsIso (f ∣_ Y.basicOpen r) → ∀ c : Γ(X, f ⁻¹ᵁ U),
      ∃ (n : ℕ) (b : Γ(Y, U)), (f.app U).hom r ^ n * c = (f.app U).hom b := by
    intro X Y f _ U hU r hiso c
    haveI := hiso
    have hI : IsIso (f.app (Y.basicOpen r)) := by
      have h1 : IsIso (f ∣_ Y.basicOpen r).appTop :=
        Scheme.Hom.instIsIsoCommRingCatApp (f ∣_ Y.basicOpen r) ⊤
      rw [morphismRestrict_appTop] at h1
      have h2 : IsIso (f.app ((Y.basicOpen r).ι ''ᵁ ⊤)) :=
        @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (Functor.map_isIso _ _) h1
      have key : ∀ V : Y.Opens, V = Y.basicOpen r → IsIso (f.app V) →
          IsIso (f.app (Y.basicOpen r)) := by
        rintro V rfl h; exact h
      exact key _ (Scheme.Opens.ι_image_top _) h2
    have hsurj : Function.Surjective (f.app (Y.basicOpen r)).hom :=
      ((ConcreteCategory.isIso_iff_bijective _).mp hI).2
    have hle : f ⁻¹ᵁ Y.basicOpen r ≤ f ⁻¹ᵁ U := fun x hx => Y.basicOpen_le r hx
    obtain ⟨β, hβ⟩ := hsurj ((X.presheaf.map (homOfLE hle).op).hom c)
    haveI := hU.isLocalization_basicOpen r
    obtain ⟨⟨b0, ⟨_, m, rfl⟩⟩, hb⟩ := IsLocalization.surj (Submonoid.powers r) β
    have hb' : β * (Y.presheaf.map (homOfLE (Y.basicOpen_le r)).op).hom (r ^ m) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le r)).op).hom b0 := hb
    have nat : ∀ x : Γ(Y, U), (f.app (Y.basicOpen r)).hom
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le r)).op).hom x) =
        (X.presheaf.map (homOfLE hle).op).hom ((f.app U).hom x) := by
      intro x
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, f.naturality]
      rfl
    have e1 := congrArg (f.app (Y.basicOpen r)).hom hb'
    rw [map_mul, hβ, nat, nat, map_pow] at e1
    have e2 : (X.presheaf.map (homOfLE hle).op).hom
        ((f.app U).hom r ^ m * c - (f.app U).hom b0) = 0 := by
      rw [map_sub, map_mul, ← e1]; ring
    have hbo : X.basicOpen ((f.app U).hom r) = f ⁻¹ᵁ Y.basicOpen r :=
      (Scheme.preimage_basicOpen f r).symm
    have key : ∀ (V : X.Opens) (hV : V = f ⁻¹ᵁ Y.basicOpen r) (h : V ≤ f ⁻¹ᵁ U),
        (X.presheaf.map (homOfLE h).op).hom ((f.app U).hom r ^ m * c - (f.app U).hom b0) = 0 := by
      rintro V rfl h; exact e2
    obtain ⟨N, hN⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X
      (hU.preimage f) ((f.app U).hom r ^ m * c - (f.app U).hom b0) ((f.app U).hom r)
      (key _ hbo _)
    refine ⟨N + m, r ^ N * b0, ?_⟩
    rw [map_mul, map_pow, pow_add, mul_assoc]
    linear_combination hN

  have s5 : ∀ (X : Scheme.{u}), AlgebraicGeometry.IsReduced X → ∀ (U : X.Opens) (s c : Γ(X, U)),
      (U : Set X) ⊆ closure (X.basicOpen s : Set X) → s * c = 0 → c = 0 := by
    intro X _ U s c hU hsc
    rw [← basicOpen_eq_bot_iff]
    by_contra hne
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    have hxU : x ∈ (U : Set X) := X.basicOpen_le c hx
    obtain ⟨y, hyc, hys⟩ := mem_closure_iff.mp (hU hxU) _ (X.basicOpen c).isOpen hx
    have : y ∈ X.basicOpen (s * c) := by rw [Scheme.basicOpen_mul]; exact ⟨hys, hyc⟩
    rw [hsc, Scheme.basicOpen_zero] at this
    exact this

  have s6 : ∀ (X Y Z : Scheme.{u}) (j : Y ⟶ X) (g : X ⟶ Z) (a : Y ⟶ Z), Dense (Set.range ⇑j) →
      IsOpenImmersion a → j ≫ g = a → ∀ D : Set Z, Dense D → Dense (⇑g ⁻¹' D) := by
    intro X Y Z j g a hj _ hja D hD
    have h1 : Dense (⇑a ⁻¹' D) := by
      rw [dense_iff_inter_open]
      intro O hO hne
      obtain ⟨_, ⟨y, hyO, rfl⟩, hyD⟩ :=
        hD.inter_open_nonempty _ (a.isOpenEmbedding.isOpenMap O hO) (hne.image _)
      exact ⟨y, hyO, hyD⟩
    have h2 : Dense (⇑j '' (⇑a ⁻¹' D)) := DenseRange.dense_image hj j.continuous h1
    refine h2.mono ?_
    rintro _ ⟨y, hy, rfl⟩
    show g (j y) ∈ D
    rw [← Scheme.Hom.comp_apply, hja]
    exact hy

  have s7 : ∀ (U : T.Opens), IsAffineOpen U → Nonempty U → IsIntegrallyClosed Γ(T, U) := by
    intro U hU hne
    haveI : IsDomain Γ(T, U) := IsIntegral.component_integral U
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    let P : Spec Γ(T, U) := ⟨p, hpm.isPrime⟩
    have hx : hU.fromSpec P ∈ U := by
      have := Set.mem_range_self (f := hU.fromSpec) P
      rwa [hU.range_fromSpec] at this
    let x : U := ⟨_, hx⟩
    have hq : hU.primeIdealOf x = P := by
      haveI := hU.isOpenImmersion_fromSpec
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [hU.fromSpec_primeIdealOf]
    letI : Algebra Γ(T, U) (T.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk T.presheaf x
    have hloc : IsLocalization.AtPrime (T.presheaf.stalk (x : T)) p := by
      have := hU.isLocalization_stalk x
      rw [hq] at this
      exact this
    let e := IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (T.presheaf.stalk (x : T))
    haveI := hnorm x
    exact IsIntegrallyClosed.of_equiv e.symm.toRingEquiv

  have node_red : ∀ (K : Type u) [Field K], _root_.IsReduced (MvPowerSeries (Fin 2) K ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) := by
    intro K _
    haveI : IsDomain (MvPowerSeries (Fin 2) K) := NoZeroDivisors.to_isDomain _
    have hc : ∀ (i : Fin 2) (φ : MvPowerSeries (Fin 2) K) (m : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff m (id (α := MvPowerSeries (Fin 2) K)
          (fun n => if n i = 0 then MvPowerSeries.coeff n φ else 0)) =
        if m i = 0 then MvPowerSeries.coeff m φ else 0 := fun _ _ _ => rfl
    have hρ : ∀ i : Fin 2, ∃ ρ : MvPowerSeries (Fin 2) K →+* MvPowerSeries (Fin 2) K,
        ∀ φ m, MvPowerSeries.coeff m (ρ φ) = if m i = 0 then MvPowerSeries.coeff m φ else 0 := by
      intro i
      refine ⟨{ toFun := fun φ => id (α := MvPowerSeries (Fin 2) K)
                  (fun n => if n i = 0 then MvPowerSeries.coeff n φ else 0)
                map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ },
        fun φ m => hc i φ m⟩
      · ext m
        rw [hc, MvPowerSeries.coeff_one]
        split_ifs with h1 h2 <;> simp_all
      · intro φ ψ
        ext m
        rw [hc, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
        split_ifs with h
        · refine Finset.sum_congr rfl (fun p hp => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have hpi := congrArg (fun f => f i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at hpi
          rw [hc, hc, if_pos (by omega), if_pos (by omega)]
        · symm
          refine Finset.sum_eq_zero (fun p hp => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have hpi := congrArg (fun f => f i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at hpi
          rw [hc, hc]
          by_cases h1 : p.1 i = 0
          · rw [if_neg (show ¬ p.2 i = 0 by omega), mul_zero]
          · rw [if_neg h1, zero_mul]
      · ext m
        rw [hc]
        simp
      · intro φ ψ
        ext m
        rw [map_add, hc, hc, hc, map_add]
        split_ifs <;> simp
    have hprime : ∀ i : Fin 2,
        (Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin 2) K)}).IsPrime := by
      intro i
      obtain ⟨ρ, hρ⟩ := hρ i
      have : Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin 2) K)} = RingHom.ker ρ := by
        ext φ
        rw [Ideal.mem_span_singleton, RingHom.mem_ker, MvPowerSeries.X_dvd_iff]
        constructor
        · intro h
          ext m
          rw [hρ, map_zero]
          split_ifs with hm
          · exact h m hm
          · rfl
        · intro h m hm
          have := congrArg (MvPowerSeries.coeff m) h
          rw [hρ, map_zero, if_pos hm] at this
          exact this
      rw [this]
      exact RingHom.ker_isPrime ρ
    have hinf : Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} =
        Ideal.span {MvPowerSeries.X 0} ⊓ Ideal.span {MvPowerSeries.X 1} := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ rfl
        exact ⟨Ideal.mem_span_singleton.mpr (dvd_mul_right _ _),
          Ideal.mem_span_singleton.mpr (dvd_mul_left _ _)⟩
      · intro f hf
        rw [Ideal.mem_inf] at hf
        obtain ⟨hx, hy⟩ := hf
        rw [Ideal.mem_span_singleton] at hx ⊢
        obtain ⟨g, rfl⟩ := hx
        rcases (hprime 1).mem_or_mem hy with h | h
        · exfalso
          rw [Ideal.mem_span_singleton, MvPowerSeries.X_dvd_iff] at h
          have := h (Finsupp.single 0 1) (by simp)
          rw [MvPowerSeries.coeff_X] at this
          simp at this
        · rw [Ideal.mem_span_singleton] at h
          obtain ⟨h', rfl⟩ := h
          exact ⟨h', by ring⟩
    rw [← Ideal.isRadical_iff_quotient_reduced, hinf]
    exact (hprime 0).isRadical.inf (hprime 1).isRadical
  have hss : wcpaDjSemistable u := hst.1
  haveI : Flat u := hss.1
  haveI : IsProper u := hss.2.1
  have hgeo : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
      AlgebraicGeometry.IsReduced (Limits.pullback u s) := by
    intro K _ _ s
    haveI : LocallyOfFiniteType (Limits.pullback.snd u s) := inferInstance
    haveI : IsLocallyNoetherian (Limits.pullback u s) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u s)
    haveI : ∀ w : ↥(Limits.pullback u s),
        _root_.IsReduced ((Limits.pullback u s).presheaf.stalk w) := by
      intro w
      rcases hss.2.2 K s w with ⟨W, hw, hsm⟩ | ⟨e, -⟩
      · haveI := hsm
        haveI := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ Limits.pullback.snd u s) 1 ⟨w, hw⟩
        have hinj : Function.Injective (W.stalkIso ⟨w, hw⟩).inv.hom :=
          (W.stalkIso ⟨w, hw⟩).commRingCatIsoToRingEquiv.symm.injective
        exact isReduced_of_injective _ hinj
      · haveI := node_red K
        let φ := e.toRingHom.comp (algebraMap ((Limits.pullback u s).presheaf.stalk w)
          (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w))
            ((Limits.pullback u s).presheaf.stalk w)))
        have hinj : Function.Injective φ := by
          intro a b hab
          apply AdicCompletion.of_injective
            (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w))
          apply e.injective
          simpa [φ, AdicCompletion.algebraMap_apply] using hab
        exact isReduced_of_injective φ hinj
    exact isReduced_of_isReduced_stalk _
  have s8 : ∀ (U : T.Opens) (W : Z.Opens) (hU : IsAffineOpen U) (hW : IsAffineOpen W)
      (e : W ≤ u ⁻¹ᵁ U) (P : Ideal Γ(T, U)) [P.IsPrime],
      letI := (u.appLE U W e).hom.toAlgebra
      _root_.IsReduced (TensorProduct Γ(T, U) Γ(Z, W) P.ResidueField) := by
    intro U W hU hW e P _
    have patch : ∀ (L : Type u) [CommRing L] [Algebra Γ(T, U) L],
        AlgebraicGeometry.IsReduced (Limits.pullback u
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec)) →
        letI := (u.appLE U W e).hom.toAlgebra
