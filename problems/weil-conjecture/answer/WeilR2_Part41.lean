        algebraMap (IsLocalRing.ResidueField R)
          ((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2)
            (IsLocalRing.ResidueField R)) MvPolynomial.gradedAlgebra).residueField (θ.hom pD)) := by
      rw [hA', RingHom.algebraMap_toAlgebra, ← hnat, hg₂]
    have hmem : ∀ m, (g.residueFieldMap (θ.hom pD)).hom m ∈ Subfield.closure (insert t₀
        (Set.range ((g.residueFieldMap (θ.hom pD)).hom.comp
          (algebraMap (IsLocalRing.ResidueField R) _)))) := by
      intro m
      rw [hcompat, Set.insert_eq, Set.union_comm, ← IntermediateField.adjoin_toSubfield, ht₀,
        IntermediateField.mem_toSubfield]
      exact IntermediateField.mem_top
    have htr : ∃ x : (Limits.pullback u' (Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue R)))).residueField (g (θ.hom pD)),
        Transcendental (IsLocalRing.ResidueField R) x := by
      by_contra hne
      have hne' : ∀ x, ¬ Transcendental (IsLocalRing.ResidueField R) x := fun x hx => hne ⟨x, hx⟩
      apply (wcpa_dj_lsp_generic_smooth (IsLocalRing.ResidueField R) _ _ hssP _ hξ).1
      apply wcpa_dj_p1rec_rational_closed (IsLocalRing.ResidueField R) _
        (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
      intro y
      have hy : IsAlgebraic (IsLocalRing.ResidueField R) y := by
        have h0 := hne' y
        unfold Transcendental at h0
        exact not_not.mp h0
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible (IsLocalRing.ResidueField R)
        (minpoly.irreducible hy.isIntegral)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one (IsLocalRing.ResidueField R) y hdeg
      exact ⟨c, by rw [← hA']; exact hc⟩
    exact cp1rr_luroth_transport (IsLocalRing.ResidueField R) _ _
      (g.residueFieldMap (θ.hom pD)).hom t₀ htr hmem

  have hnodes : ∀ c ∈ closure ({x₀} : Set ↥(Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
      IsClosed ({c} : Set ↥(Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) →
      (¬ ∃ W : (Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).Opens,
        c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫
          Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) →
      c ∈ closure (closure ({x₀} : Set ↥(Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))))ᶜ := by
    intro c hc _ hns
    by_contra hcl
    apply hsn
    refine ⟨c, hc, hcl, ?_⟩
    intro hsm
    obtain ⟨W, hW, hWsm⟩ := hsm
    apply hns
    refine ⟨Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) ⁻¹ᵁ W,
      by exact hW, ?_⟩
    have h1 := isPullback_morphismRestrict
      (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) W
    have h2 := h1.paste_vert
      (IsPullback.of_hasPullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

  letI : Algebra (IsLocalRing.ResidueField R) ((Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).residueField x₀) :=
    (wcpaDjFK (IsLocalRing.ResidueField R)
      (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x₀).toAlgebra
  have ht := hrat x₀ hXc hgp (RingHom.algebraMap_toAlgebra _)
  obtain ⟨Er, ιE, θE, h1, h2, h3, h4⟩ := wcpa_dj_csp_P1_recognition (IsLocalRing.ResidueField R)
    _ _ hssP x₀ hXc (RingHom.algebraMap_toAlgebra _) hnodes ht
  unfold wcpaDjNccP1
  exact ⟨Er, ιE, θE, h1, h2, h3, h4⟩

theorem wcpa_dj_nccw_chain_acyclic {N : Type*} (𝒦 : Set (Set N)) (h𝒦 : ∀ L ∈ 𝒦, L.Nonempty) (hF2 : nccwF2 𝒦) : (∀ (r : ℕ) (D Φ : Fin r → Set N), 2 ≤ r → Function.Injective D → (∀ i, D i ∈ 𝒦) → (∀ i j, i ≠ j → Disjoint (Φ i) (Φ j)) → (∀ i j, ¬ D j ⊆ Φ i) → (∀ i, nccwXChain 𝒦 (Φ i) (D i) (D (finRotate r i)) ∨ nccwXChain 𝒦 (Φ i) (D (finRotate r i)) (D i)) → False) ∧ (∀ (D Φ : Set N) (x y : N), D ∈ 𝒦 → ¬ D ⊆ Φ → x ∈ D → y ∈ D → x ≠ y → ¬ nccwXChain 𝒦 Φ {x} {y}) :=
by
  classical

  have hF2L : ∀ W : List (Set N × N), 2 ≤ W.length → (W.map Prod.fst).Nodup →
      (W.map Prod.snd).Nodup → (∀ a ∈ W, a.1 ∈ 𝒦 ∧ a.2 ∈ a.1) →
      W.IsChain (fun a b => a.2 ∈ b.1) →
      (∀ a ∈ W.getLast?, ∀ b ∈ W.head?, a.2 ∈ b.1) → False := by
    intro W hlen hn1 hn2 hmem hch hwrap
    obtain ⟨m, hm⟩ : ∃ m, W.length = m + 2 := ⟨W.length - 2, by omega⟩
    have key1 : ∀ (a b : ℕ) (ha : a < W.length) (hb : b < W.length), b = a + 1 →
        W[a].2 ∈ W[b].1 := by
      intro a b ha hb hab
      subst hab
      exact hch.getElem a hb
    have key2 : ∀ (a b : ℕ) (ha : a < W.length) (hb : b < W.length), a = W.length - 1 →
        b = 0 → W[a].2 ∈ W[b].1 := by
      intro a b ha hb hab hb0
      subst hab hb0
      refine hwrap _ ?_ _ ?_
      · rw [List.getLast?_eq_getElem?, List.getElem?_eq_getElem ha]; rfl
      · rw [List.head?_eq_getElem?, List.getElem?_eq_getElem hb]; rfl
    have inj1 : ∀ (a b : ℕ) (ha : a < W.length) (hb : b < W.length), W[a].1 = W[b].1 → a = b := by
      intro a b ha hb h
      exact (hn1.getElem_inj_iff (i := a) (j := b) (hi := by simpa using ha)
        (hj := by simpa using hb)).mp (by simpa using h)
    have inj2 : ∀ (a b : ℕ) (ha : a < W.length) (hb : b < W.length), W[a].2 = W[b].2 → a = b := by
      intro a b ha hb h
      exact (hn2.getElem_inj_iff (i := a) (j := b) (hi := by simpa using ha)
        (hj := by simpa using hb)).mp (by simpa using h)
    refine hF2 m (fun i => (W[i.val]'(by omega)).1) (fun i => (W[i.val]'(by omega)).2) ?_ ?_ ?_ ?_
    · intro i; exact (hmem _ (List.getElem_mem _)).1
    · intro i j hij; exact Fin.ext (inj1 _ _ _ _ hij)
    · intro i j hij; exact Fin.ext (inj2 _ _ _ _ hij)
    · intro i
      refine ⟨(hmem _ (List.getElem_mem _)).2, ?_⟩
      by_cases hi : i = Fin.last (m + 1)
      · subst hi
        have hr : finRotate (m + 2) (Fin.last (m + 1)) = 0 := finRotate_last
        exact key2 _ _ _ _ (by simp; omega) (by rw [hr]; rfl)
      · have hv : ((finRotate (m + 2) i : Fin (m + 2)) : ℕ) = i.val + 1 :=
          coe_finRotate_of_ne_last hi
        exact key1 _ _ _ _ hv

  have hrev : ∀ (Φ A B : Set N), nccwXChain 𝒦 Φ A B → nccwXChain 𝒦 Φ B A := by
    rintro Φ A B ⟨s, L, p, hL, hp, h0, hl, hst⟩
    refine ⟨s, fun t => L t.rev, fun k => p k.rev, fun t => hL _, fun k => hp _,
      by simpa using hl, by simpa using h0, fun t => ?_⟩
    simp only [Fin.rev_castSucc, Fin.rev_succ]
    exact ⟨(hst t.rev).2, (hst t.rev).1⟩

  have hconv : ∀ (Φ D A B : Set N), A ⊆ D → nccwXChain 𝒦 Φ A B →
      ∃ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      c 0 = D ∧ p 0 ∈ A ∧ p n ∈ B ∧ (∀ k ≤ n, p k ∈ Φ ∧ p k ∈ c k) ∧
      (∀ k, 1 ≤ k → k ≤ n → c k ∈ 𝒦 ∧ c k ⊆ Φ) ∧ (∀ k < n, p k ∈ c (k + 1)) := by
    rintro Φ D A B hAD ⟨s, L, p, hL, hp, h0, hl, hst⟩
    refine ⟨s, fun k => if h : 0 < k ∧ k ≤ s then L ⟨k - 1, by omega⟩ else D,
      fun k => if h : k ≤ s then p ⟨k, by omega⟩ else p 0, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp
    · simpa using h0
    · simp only [dif_pos (le_refl s)]; exact hl
    · intro k hk
      refine ⟨by simp only [dif_pos hk]; exact hp _, ?_⟩
      rcases Nat.eq_zero_or_pos k with rfl | hk0
      · simpa using hAD h0
      · simp only [dif_pos hk, dif_pos (And.intro hk0 hk)]
        have := (hst ⟨k - 1, by omega⟩).2
        convert this using 2
        ext; simp; omega
    · intro k hk1 hk
      simp only [dif_pos (show 0 < k ∧ k ≤ s from ⟨hk1, hk⟩)]; exact hL _
    · intro k hk
      simp only [dif_pos (by omega : k ≤ s), dif_pos (by omega : 0 < k + 1 ∧ k + 1 ≤ s)]
      have := (hst ⟨k, hk⟩).1
      convert this using 2 <;> ext <;> simp

  have hmin : ∀ (Φ D A B : Set N), ¬ D ⊆ Φ → (∃ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      c 0 = D ∧ p 0 ∈ A ∧ p n ∈ B ∧ (∀ k ≤ n, p k ∈ Φ ∧ p k ∈ c k) ∧
      (∀ k, 1 ≤ k → k ≤ n → c k ∈ 𝒦 ∧ c k ⊆ Φ) ∧ (∀ k < n, p k ∈ c (k + 1))) →
      ∃ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      (c 0 = D ∧ p 0 ∈ A ∧ p n ∈ B ∧ (∀ k ≤ n, p k ∈ Φ ∧ p k ∈ c k) ∧
      (∀ k, 1 ≤ k → k ≤ n → c k ∈ 𝒦 ∧ c k ⊆ Φ) ∧ (∀ k < n, p k ∈ c (k + 1))) ∧
      (∀ i j, i ≤ n → j ≤ n → c i = c j → i = j) ∧
      (∀ i j, i ≤ n → j ≤ n → p i = p j → i = j) := by
    intro Φ D A B hDΦ hex
    obtain ⟨c, p, hc0, hp0, hpn, hpk, hck, hch⟩ := Nat.find_spec hex
    have hmn := fun n' (h : n' < Nat.find hex) => Nat.find_min hex h
    generalize Nat.find hex = n at hpn hpk hck hch hmn
    have P1 : ∀ i j, i + 1 < j → j ≤ n → p i ∈ c j → False := by
      intro i j hij hjn hpij
      apply hmn (n - (j - i - 1)) (by omega)
      refine ⟨fun k => if k ≤ i then c k else c (k + (j - i - 1)),
        fun k => if k ≤ i then p k else p (k + (j - i - 1)), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · simp [hc0]
      · simpa using hp0
      · have h1 : ¬ (n - (j - i - 1) ≤ i) := by omega
        have h2 : n - (j - i - 1) + (j - i - 1) = n := by omega
        simp only [if_neg h1, h2]; exact hpn
      · intro k hk
        by_cases hki : k ≤ i
        · simp only [if_pos hki]; exact hpk k (by omega)
        · simp only [if_neg hki]; exact hpk _ (by omega)
      · intro k hk1 hk
        by_cases hki : k ≤ i
        · simp only [if_pos hki]; exact hck k hk1 (by omega)
        · simp only [if_neg hki]; exact hck _ (by omega) (by omega)
      · intro k hk
        by_cases hki : k + 1 ≤ i
        · simp only [if_pos hki, if_pos (by omega : k ≤ i)]; exact hch k (by omega)
        · by_cases hki' : k = i
          · subst hki'
            have h3 : k + 1 + (j - k - 1) = j := by omega
            simp only [if_pos (le_refl k), if_neg hki, h3]; exact hpij
          · simp only [if_neg hki, if_neg (by omega : ¬ k ≤ i)]
            have h4 : k + 1 + (j - i - 1) = k + (j - i - 1) + 1 := by omega
            rw [h4]; exact hch _ (by omega)
    have P2 : ∀ i < n, p i ∈ B → False := by
      intro i hi hpi
      exact hmn i hi ⟨c, p, hc0, hp0, hpi, fun k hk => hpk k (by omega),
        fun k h1 h2 => hck k h1 (by omega), fun k hk => hch k (by omega)⟩
    refine ⟨n, c, p, ⟨hc0, hp0, hpn, hpk, hck, hch⟩, ?_, ?_⟩
    · have key : ∀ i j, i < j → j ≤ n → c i = c j → False := by
        intro i j hij hjn he
        rcases Nat.eq_zero_or_pos i with rfl | hi0
        · apply hDΦ; rw [← hc0, he]; exact (hck j (by omega) hjn).2
        · have h1 := hch (i - 1) (by omega)
          rw [show i - 1 + 1 = i by omega, he] at h1
          exact P1 (i - 1) j (by omega) hjn h1
      intro i j hi hj he
      rcases lt_trichotomy i j with h | h | h
      · exact (key i j h hj he).elim
      · exact h
      · exact (key j i h hi he.symm).elim
    · have key : ∀ i j, i < j → j ≤ n → p i = p j → False := by
        intro i j hij hjn he
        rcases Nat.lt_or_ge j n with hjn' | hjn'
        · have h1 := hch j hjn'
          rw [← he] at h1
          exact P1 i (j + 1) (by omega) (by omega) h1
        · have hjn2 : j = n := by omega
          rw [hjn2] at he
          exact P2 i (by omega) (by rw [he]; exact hpn)
      intro i j hi hj he
      rcases lt_trichotomy i j with h | h | h
      · exact (key i j h hj he).elim
      · exact h
      · exact (key j i h hi he.symm).elim

  have hBmem : ∀ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N) (a : Set N × N),
      a ∈ List.ofFn (fun k : Fin (n + 1) => (c k.val, p k.val)) → ∃ k ≤ n, a = (c k, p k) := by
    intro n c p a ha
    obtain ⟨k, hk⟩ := List.mem_ofFn.mp ha
    exact ⟨k.val, by omega, hk.symm⟩
  have hBchain : ∀ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N), (∀ k < n, p k ∈ c (k + 1)) →
      (List.ofFn (fun k : Fin (n + 1) => (c k.val, p k.val))).IsChain (fun a b => a.2 ∈ b.1) := by
    intro n c p h
    rw [List.isChain_ofFn]
    intro i hi
    exact h i (by omega)
  have hBhead : ∀ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      (List.ofFn (fun k : Fin (n + 1) => (c k.val, p k.val))).head? = some (c 0, p 0) := by
    intro n c p
    rw [List.head?_eq_getElem?, List.getElem?_ofFn]; simp
  have hBlast : ∀ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      (List.ofFn (fun k : Fin (n + 1) => (c k.val, p k.val))).getLast? = some (c n, p n) := by
    intro n c p
    rw [List.getLast?_eq_getElem?, List.getElem?_ofFn]; simp
  have hBnodup1 : ∀ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      (∀ i j, i ≤ n → j ≤ n → c i = c j → i = j) →
      ((List.ofFn (fun k : Fin (n + 1) => (c k.val, p k.val))).map Prod.fst).Nodup := by
    intro n c p h
    rw [List.map_ofFn, List.nodup_ofFn]
    intro i j hij
    exact Fin.ext (h _ _ (by omega) (by omega) hij)
  have hBnodup2 : ∀ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
      (∀ i j, i ≤ n → j ≤ n → p i = p j → i = j) →
      ((List.ofFn (fun k : Fin (n + 1) => (c k.val, p k.val))).map Prod.snd).Nodup := by
    intro n c p h
    rw [List.map_ofFn, List.nodup_ofFn]
    intro i j hij
    exact Fin.ext (h _ _ (by omega) (by omega) hij)
  refine ⟨?_, ?_⟩
  ·
    intro r D Φ hr hDinj hD𝒦 hΦ hDΦ hch
    obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
    have hgood : ∀ i, ∃ (n : ℕ) (c : ℕ → Set N) (p : ℕ → N),
        (c 0 = D i ∧ p 0 ∈ D i ∧ p n ∈ D (finRotate (r' + 1) i) ∧
          (∀ k ≤ n, p k ∈ Φ i ∧ p k ∈ c k) ∧
          (∀ k, 1 ≤ k → k ≤ n → c k ∈ 𝒦 ∧ c k ⊆ Φ i) ∧ (∀ k < n, p k ∈ c (k + 1))) ∧
        (∀ i j, i ≤ n → j ≤ n → c i = c j → i = j) ∧
        (∀ i j, i ≤ n → j ≤ n → p i = p j → i = j) := by
      intro i
      have hx : nccwXChain 𝒦 (Φ i) (D i) (D (finRotate (r' + 1) i)) :=
        (hch i).elim id (hrev _ _ _)
      exact hmin _ _ _ _ (hDΦ i i) (hconv _ _ _ _ subset_rfl hx)
    choose n c p hG hic hip using hgood
    obtain ⟨Bl, hBl⟩ : ∃ Bl : Fin (r' + 1) → List (Set N × N),
        ∀ i, Bl i = List.ofFn (fun k : Fin (n i + 1) => (c i k.val, p i k.val)) :=
      ⟨_, fun i => rfl⟩
    have hcurve : ∀ i k, k ≤ n i → (c i k = D i) ∨
        (c i k ⊆ Φ i ∧ p i k ∈ c i k ∧ p i k ∈ Φ i) := by
      intro i k hk
      obtain ⟨hc0, hp0, hpn, hpk, hck, hch⟩ := hG i
      rcases Nat.eq_zero_or_pos k with rfl | hk0
      · exact Or.inl hc0
      · exact Or.inr ⟨(hck k hk0 hk).2, (hpk k hk).2, (hpk k hk).1⟩
    have hBmem' : ∀ i a, a ∈ Bl i → ∃ k ≤ n i, a = (c i k, p i k) := by
      intro i a h; rw [hBl] at h; exact hBmem _ _ _ _ h
    have hBne : [] ∉ List.ofFn Bl := by
      intro h
      obtain ⟨i, hi⟩ := List.mem_ofFn.mp h
      have := congrArg List.length hi
      rw [hBl] at this
      simp at this
    apply hF2L (List.ofFn Bl).flatten
    · rw [List.length_flatten, List.map_ofFn, List.sum_ofFn]
      calc 2 ≤ ∑ _i : Fin (r' + 1), 1 := by simp; omega
        _ ≤ _ := Finset.sum_le_sum (fun i _ => by simp [hBl])
    · rw [List.map_flatten, List.map_ofFn, List.nodup_flatten]
      refine ⟨?_, ?_⟩
      · intro l hl
        obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
        show ((Bl i).map Prod.fst).Nodup
        rw [hBl]; exact hBnodup1 _ _ _ (hic i)
      · rw [List.pairwise_ofFn]
        intro i j hij a hai haj
        have hai' : a ∈ (Bl i).map Prod.fst := hai
        have haj' : a ∈ (Bl j).map Prod.fst := haj
        obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hai'
        obtain ⟨b', hb', hbb⟩ := List.mem_map.mp haj'
        obtain ⟨k, hk, rfl⟩ := hBmem' _ _ hb
        obtain ⟨k', hk', rfl⟩ := hBmem' _ _ hb'
        simp only at hbb
        have hne : i ≠ j := ne_of_lt hij
        rcases hcurve i k hk with h1 | ⟨h1, h1p, h1Φ⟩ <;>
          rcases hcurve j k' hk' with h2 | ⟨h2, h2p, h2Φ⟩
        · exact hne (hDinj (h1.symm.trans (hbb.symm.trans h2)))
        · exact hDΦ j i (by rw [← h1, ← hbb]; exact h2)
        · exact hDΦ i j (by rw [← h2, hbb]; exact h1)
        · have : p i k ∈ Φ j := h2 (by rw [hbb]; exact h1p)
          exact Set.disjoint_left.mp (hΦ i j hne) h1Φ this
    · rw [List.map_flatten, List.map_ofFn, List.nodup_flatten]
      refine ⟨?_, ?_⟩
      · intro l hl
        obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
        show ((Bl i).map Prod.snd).Nodup
        rw [hBl]; exact hBnodup2 _ _ _ (hip i)
      · rw [List.pairwise_ofFn]
        intro i j hij a hai haj
        have hai' : a ∈ (Bl i).map Prod.snd := hai
        have haj' : a ∈ (Bl j).map Prod.snd := haj
        obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hai'
        obtain ⟨b', hb', hbb⟩ := List.mem_map.mp haj'
        obtain ⟨k, hk, rfl⟩ := hBmem' _ _ hb
        obtain ⟨k', hk', rfl⟩ := hBmem' _ _ hb'
        simp only at hbb
        have hne : i ≠ j := ne_of_lt hij
        have h1 : p i k ∈ Φ i := ((hG i).2.2.2.1 k hk).1
        have h2 : p j k' ∈ Φ j := ((hG j).2.2.2.1 k' hk').1
        rw [hbb] at h2
        exact Set.disjoint_left.mp (hΦ i j hne) h1 h2
    · intro a ha
      obtain ⟨l, hl, hal⟩ := List.mem_flatten.mp ha
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
      obtain ⟨k, hk, rfl⟩ := hBmem' _ _ hal
      obtain ⟨hc0, hp0, hpn, hpk, hck, hch⟩ := hG i
      refine ⟨?_, (hpk k hk).2⟩
      rcases Nat.eq_zero_or_pos k with rfl | hk0
      · show c i 0 ∈ 𝒦
        rw [hc0]; exact hD𝒦 i
      · exact (hck k hk0 hk).1
