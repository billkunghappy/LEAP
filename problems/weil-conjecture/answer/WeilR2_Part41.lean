      rfl
    have hθ0 : AdjoinRoot.root (wcpaBscPoly D i) ^ 2 -
        AdjoinRoot.of (wcpaBscPoly D i) (D.b i) * AdjoinRoot.root (wcpaBscPoly D i) +
        AdjoinRoot.of (wcpaBscPoly D i) (D.a i) * AdjoinRoot.of (wcpaBscPoly D i) (D.c i) = 0 := by
      have h : Polynomial.eval₂ (AdjoinRoot.of (wcpaBscPoly D i)) (AdjoinRoot.root (wcpaBscPoly D i))
          (Polynomial.X ^ 2 - Polynomial.C (D.b i) * Polynomial.X +
            Polynomial.C (D.a i * D.c i)) = 0 := AdjoinRoot.eval₂_root _
      simpa only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
