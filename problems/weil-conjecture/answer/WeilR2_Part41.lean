    exact hϖ.not_isUnit (isUnit_iff_exists_inv.mpr ⟨_, (mul_comm _ _).trans this⟩)

  have s3 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O],
      IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal O) O) → ∀ J : Ideal O,
      Ideal.comap (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
        (Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) J) = J := by
    intro O _ _ _ hl J
    have hloc : IsLocalHom (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) := by
      constructor
      intro a ha
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal O := hna
      have h1 := ha.map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) 1)
      rw [AlgHom.commutes] at h1
      have h2 : algebraMap O (O ⧸ IsLocalRing.maximalIdeal O ^ 1) a = 0 := by
        rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem, pow_one]; exact hm
      rw [h2] at h1
      haveI : (IsLocalRing.maximalIdeal O ^ 1).IsMaximal := by
        rw [pow_one]; exact IsLocalRing.maximalIdeal.isMaximal O
      exact not_isUnit_zero h1
    haveI : Module.FaithfullyFlat O (AdicCompletion (IsLocalRing.maximalIdeal O) O) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    exact Ideal.comap_map_eq_self_of_faithfullyFlat J

  have s2 : ∀ (O : Type u) [CommRing O] (I : Ideal O) [I.IsMaximal], I.FG →
      IsLocalRing (AdicCompletion I O) → ∀ (x : AdicCompletion I O), ¬ IsUnit x →
      x ∈ Ideal.map (algebraMap O (AdicCompletion I O)) I := by
    intro O _ I _ hfg hl x hx
    have hψι : ∀ r : O, AdicCompletion.evalₐ I 1 (algebraMap O (AdicCompletion I O) r) =
        Ideal.Quotient.mk (I ^ 1) r := by
      intro r
      rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    have hψsurj : Function.Surjective (AdicCompletion.evalₐ I 1) := by
      intro y
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨_, hψι r⟩
    haveI : (I ^ 1).IsMaximal := by rw [pow_one]; infer_instance
    have hkermax : (RingHom.ker ((AdicCompletion.evalₐ I 1 : AdicCompletion I O →ₐ[O] O ⧸ I ^ 1) :
        AdicCompletion I O →+* O ⧸ I ^ 1)).IsMaximal := by
      letI := Ideal.Quotient.field (I ^ 1)
      exact RingHom.ker_isMaximal_of_surjective _ hψsurj
    have hker := IsLocalRing.eq_maximalIdeal hkermax
    have hψx : AdicCompletion.evalₐ I 1 x = 0 := by
      have : x ∈ IsLocalRing.maximalIdeal (AdicCompletion I O) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hx
      rw [← hker, RingHom.mem_ker] at this
      exact this
    obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I O 1 x)
    have hy : x - algebraMap O (AdicCompletion I O) a ∈
        Ideal.map (algebraMap O (AdicCompletion I O)) I := by
      have h1 : x - algebraMap O (AdicCompletion I O) a ∈
          LinearMap.ker (AdicCompletion.eval I O 1) := by
        rw [LinearMap.mem_ker, map_sub, ← ha, AdicCompletion.algebraMap_apply,
          AdicCompletion.eval_of]
        exact sub_self _
      rw [← AdicCompletion.pow_smul_top_eq_ker_eval hfg, pow_one, Ideal.smul_top_eq_map] at h1
      exact h1
    have hψa : AdicCompletion.evalₐ I 1 (algebraMap O (AdicCompletion I O) a) = 0 := by
      have hle : Ideal.map (algebraMap O (AdicCompletion I O)) I ≤
          RingHom.ker ((AdicCompletion.evalₐ I 1 : AdicCompletion I O →ₐ[O] O ⧸ I ^ 1) :
            AdicCompletion I O →+* O ⧸ I ^ 1) := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap, RingHom.mem_ker]
        show AdicCompletion.evalₐ I 1 (algebraMap O (AdicCompletion I O) r) = 0
        rw [hψι, Ideal.Quotient.eq_zero_iff_mem, pow_one]; exact hr
      have h2 := hle hy
      rw [RingHom.mem_ker] at h2
      have h3 : AdicCompletion.evalₐ I 1 (x - algebraMap O (AdicCompletion I O) a) = 0 := h2
      rw [map_sub, hψx, zero_sub, neg_eq_zero] at h3
      exact h3
    have haI : a ∈ I := by
      rw [hψι, Ideal.Quotient.eq_zero_iff_mem, pow_one] at hψa; exact hψa
    have := Ideal.add_mem _ hy (Ideal.mem_map_of_mem (algebraMap O (AdicCompletion I O)) haI)
    rwa [sub_add_cancel] at this

  have s1 : ∀ Q : Spec (S.presheaf.stalk w),
      (g (S.fromSpecStalk w Q)).asIdeal =
        Ideal.comap ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤))
          (PrimeSpectrum.asIdeal Q) := by
    intro Q
    have hcomp : S.fromSpecStalk w ≫ g = Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫
        S.presheaf.germ ⊤ w trivial) := by
      calc S.fromSpecStalk w ≫ g
          = S.fromSpecStalk w ≫ g ≫ (Spec (.of R)).toSpecΓ ≫
              Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
            rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        _ = S.fromSpecStalk w ≫ S.toSpecΓ ≫ Spec.map g.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
            rw [Scheme.toSpecΓ_naturality_assoc]
        _ = Spec.map (S.presheaf.germ ⊤ w trivial) ≫ Spec.map g.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
            rw [Scheme.fromSpecStalk_toSpecΓ_assoc]
        _ = _ := by
            rw [Spec.map_comp, Spec.map_comp, Category.assoc]
    have h1 : g (S.fromSpecStalk w Q) = (Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫
        S.presheaf.germ ⊤ w trivial)) Q := by
      rw [← hcomp]
      rfl
    have hres : S.presheaf.map (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op ≫
        S.presheaf.germ ⊤ w trivial = S.presheaf.germ ⊤ w trivial :=
      TopCat.Presheaf.germ_res _ _ _ _
    have hσφ : ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫ S.presheaf.germ ⊤ w trivial).hom =
        (S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤) := by
      ext r
      have := congrArg (fun f => f.hom (g.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))) hres
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      simp only [wcCnSigma, CommRingCat.hom_comp, RingHom.comp_apply]
      exact this.symm
    rw [h1, Spec.map_apply]
    exact congrArg (fun f => Ideal.comap f (PrimeSpectrum.asIdeal Q)) hσφ

  have core : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (σ : R →+* O)
      (e : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* PowerSeries R),
      (∀ r : R, e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (σ r)) =
        PowerSeries.C r) → ∀ (ϖ : R), Irreducible ϖ →
      (Ideal.span {σ ϖ} : Ideal O).IsPrime ∧
        (Ideal.span {σ ϖ} : Ideal O) ≠ IsLocalRing.maximalIdeal O := by
    intro O _ _ _ σ e he' ϖ hϖ
    haveI : Nontrivial (AdicCompletion (IsLocalRing.maximalIdeal O) O) := e.toEquiv.nontrivial
    have hlocÔ : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal O) O) :=
      IsLocalRing.of_surjective' (e.symm : PowerSeries R →+* _) e.symm.surjective
    obtain ⟨hPprime, hXnot⟩ := s4 ϖ hϖ
    have hJ : ∀ a : O, a ∈ (Ideal.span {σ ϖ} : Ideal O) ↔
        e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) a) ∈
          (Ideal.span {PowerSeries.C ϖ} : Ideal (PowerSeries R)) := by
      intro a
      constructor
      · intro ha
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul, map_mul, he']
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · intro ha
        obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp ha
        have h2 : algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) a =
            e.symm h * algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (σ ϖ) := by
          apply e.injective
          rw [map_mul, RingEquiv.apply_symm_apply, he', hh]
        have h3 : algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) a ∈
            Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
              (Ideal.span {σ ϖ}) := by
          rw [h2]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _))
        have h4 : a ∈ Ideal.comap (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
            (Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
              (Ideal.span {σ ϖ})) := h3
        rwa [s3 O hlocÔ] at h4
    have hJprime : (Ideal.span {σ ϖ} : Ideal O).IsPrime := by
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : O) ∈ (Ideal.span {σ ϖ} : Ideal O) := by rw [htop]; exact Submodule.mem_top
        rw [hJ, map_one, map_one] at h1
        exact hPprime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · intro a b hab
        rw [hJ, map_mul, map_mul] at hab
        rcases hPprime.mem_or_mem hab with h | h
        · exact Or.inl ((hJ a).mpr h)
        · exact Or.inr ((hJ b).mpr h)
    refine ⟨hJprime, ?_⟩
    intro hJm
    have hXu : ¬ IsUnit (e.symm PowerSeries.X) := by
      intro hu
      have h1 := hu.map (e : AdicCompletion (IsLocalRing.maximalIdeal O) O →+* PowerSeries R)
      have h2 : IsUnit (PowerSeries.X : PowerSeries R) := by
        simpa using h1
      have h3 := h2.map (PowerSeries.constantCoeff (R := R))
      simp at h3
    haveI : (IsLocalRing.maximalIdeal O).IsMaximal := IsLocalRing.maximalIdeal.isMaximal O
    have hx := s2 O (IsLocalRing.maximalIdeal O) (IsNoetherian.noetherian _) hlocÔ _ hXu
    have hx' : e.symm PowerSeries.X ∈ Ideal.map
        (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) (Ideal.span {σ ϖ}) := by
      rw [hJm]; exact hx
    rw [Ideal.map_span, Set.image_singleton] at hx'
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hx'
    apply hXnot
    have : e (c * algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (σ ϖ)) =
        PowerSeries.X := by rw [hc, RingEquiv.apply_symm_apply]
    rw [map_mul, he'] at this
    rw [← this]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

  set σ : R →+* S.presheaf.stalk w := (S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)
    with hσdef
  have he' : ∀ r : R, e (algebraMap (S.presheaf.stalk w)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk w)) (S.presheaf.stalk w))
        (σ r)) = PowerSeries.C r := fun r => RingHom.congr_fun he r
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hmaxR : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  obtain ⟨hJprime, hJne⟩ := core (S.presheaf.stalk w) σ e he' ϖ hϖ
  let P₀ : PrimeSpectrum (S.presheaf.stalk w) := ⟨Ideal.span {σ ϖ}, hJprime⟩
  refine ⟨S.fromSpecStalk w P₀, ?_, ?_, ?_, ?_⟩
  · have hle : P₀ ⤳ IsLocalRing.closedPoint (S.presheaf.stalk w) :=
      (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal hJprime.ne_top)
    have := hle.map (S.fromSpecStalk w).continuous
    rwa [Scheme.fromSpecStalk_closedPoint] at this
  · intro heq
    have h2 : S.fromSpecStalk w P₀ =
        S.fromSpecStalk w (IsLocalRing.closedPoint (S.presheaf.stalk w)) := by
      rw [heq, Scheme.fromSpecStalk_closedPoint]
    have h1 := (S.fromSpecStalk w).isEmbedding.injective h2
    exact hJne (congrArg PrimeSpectrum.asIdeal h1)
  · apply PrimeSpectrum.ext
    rw [s1 P₀]
    show Ideal.comap σ (Ideal.span {σ ϖ}) = IsLocalRing.maximalIdeal R
    have hle : IsLocalRing.maximalIdeal R ≤ Ideal.comap σ (Ideal.span {σ ϖ}) := by
      rw [hmaxR, Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_span_singleton_self _
    exact ((IsLocalRing.maximalIdeal.isMaximal R).eq_of_le
      (Ideal.comap_isPrime σ (Ideal.span {σ ϖ})).ne_top hle).symm
  · intro ω hω hgω
    have hmem : ω ∈ Set.range (S.fromSpecStalk w) := by
      rw [Scheme.range_fromSpecStalk]; exact hω
    obtain ⟨Q, rfl⟩ := hmem
    have h1 := congrArg PrimeSpectrum.asIdeal hgω
    rw [s1 Q] at h1
    have hϖm : ϖ ∈ Ideal.comap σ (PrimeSpectrum.asIdeal Q) := by
      rw [h1]
      show ϖ ∈ IsLocalRing.maximalIdeal R
      rw [hmaxR]; exact Ideal.mem_span_singleton_self _
    have hle : P₀ ≤ Q := (Ideal.span_singleton_le_iff_mem _).mpr hϖm
    exact ((PrimeSpectrum.le_iff_specializes _ _).mp hle).map (S.fromSpecStalk w).continuous

theorem wcpa_dj_nccw_gnh_completion_map : ∀ (O O' : Type u) [CommRing O] [CommRing O'] [IsLocalRing O] [IsLocalRing O'] (φ : O →+* O'), IsLocalHom φ → ∃ ψ : AdicCompletion (IsLocalRing.maximalIdeal O) O →+* AdicCompletion (IsLocalRing.maximalIdeal O') O', ψ.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) = (algebraMap O' (AdicCompletion (IsLocalRing.maximalIdeal O') O')).comp φ :=
by
  intro O O' _ _ _ _ φ hφ
  haveI := hφ
  set I := IsLocalRing.maximalIdeal O with hIdef
  set J := IsLocalRing.maximalIdeal O' with hJdef
  have hI : I ≤ Ideal.comap φ J := Ideal.le_comap_of_map_le (IsLocalRing.map_maximalIdeal_le φ)
  have hIn : ∀ n : ℕ, I ^ n ≤ Ideal.comap φ (J ^ n) := fun n =>
    le_trans (Ideal.pow_right_mono hI n) (Ideal.le_comap_pow φ n)
  let φb : ∀ n : ℕ, O ⧸ I ^ n →+* O' ⧸ J ^ n := fun n => Ideal.quotientMap (J ^ n) φ (hIn n)
  let f : ∀ n : ℕ, AdicCompletion I O →+* O' ⧸ J ^ n := fun n =>
    (φb n).comp (AdicCompletion.evalₐ I n).toRingHom
  have s4 : ∀ {m n : ℕ} (hle : m ≤ n) (x : AdicCompletion I O),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro m n hle x
    induction x using AdicCompletion.induction_on with
    | h a =>
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      exact AdicCompletion.Ideal.mk_eq_mk I hle a
  have s5 : ∀ {m n : ℕ} (hle : m ≤ n) (y : O ⧸ I ^ n),
      Ideal.Quotient.factorPow J hle (φb n y) = φb m (Ideal.Quotient.factorPow I hle y) := by
    intro m n hle y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    simp only [φb, Ideal.Quotient.factorPow, Ideal.quotientMap_mk, Ideal.Quotient.factor_mk]
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp (f n) = f m := by
    intro m n hle
    refine RingHom.ext fun x => ?_
    simp only [f, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [s5 hle, s4 hle]
  refine ⟨AdicCompletion.liftRingHom J f hf, ?_⟩
  refine RingHom.ext fun x => AdicCompletion.ext_evalₐ fun n => ?_
  simp only [RingHom.comp_apply]
  rw [AdicCompletion.evalₐ_liftRingHom]
  simp only [f, φb, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.quotientMap_mk]

theorem wcpa_dj_nccw_gnh_completion_max : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] [IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal O) O)], IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal O) O) = Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) (IsLocalRing.maximalIdeal O) :=
by
  intro O _ _ _ _

  have hker : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) (n : ℕ),
      RingHom.ker (AdicCompletion.evalₐ I n) = Ideal.map (algebraMap A (AdicCompletion I A)) (I ^ n) := by
    intro A _ _ I n
    classical
    have hι : ∀ a : A, algebraMap A (AdicCompletion I A) a = AdicCompletion.of I A a := fun a => rfl
    apply le_antisymm
    · intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨r, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
        (IsNoetherian.noetherian (I ^ n))
      have hf' : Ideal.span (Set.range f) = I ^ n := hf
      obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
      rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
      have hcau : ∀ m m' : ℕ, m ≤ m' → s m' - s m ∈ I ^ m := by
        intro m m' h
        rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
        exact AdicCompletion.Ideal.mk_eq_mk I h s
      have h0 : s n ∈ Ideal.span (Set.range f) := by rw [hf']; exact hx
      obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp h0
      have hinc : ∀ k : ℕ, ∃ e : Fin r → A, (∀ i, e i ∈ I ^ k) ∧
          ∑ i, e i * f i = s (n + (k + 1)) - s (n + k) := by
        intro k
        have hmem : s (n + (k + 1)) - s (n + k) ∈ I ^ k • Submodule.span A (Set.range f) := by
          rw [hf, Ideal.smul_eq_mul, ← pow_add, add_comm k n]
          exact hcau (n + k) (n + (k + 1)) (by omega)
        obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp hmem
        refine ⟨fun i => a i, ha, ?_⟩
        rw [← hsum, Finsupp.sum_fintype]
        · simp [smul_eq_mul]
        · intro i; simp
      choose e he hesum using hinc
      let y : Fin r → ℕ → A := fun i k => c i + ∑ j ∈ Finset.range k, e j i
      have hy_succ : ∀ i k, y i (k + 1) - y i k = e k i := by
        intro i k; simp only [y, Finset.sum_range_succ]; ring
      have hy_sum : ∀ k, ∑ i, f i * y i k = s (n + k) := by
        intro k
        induction k with
        | zero =>
          simp only [y, Finset.sum_range_zero, add_zero]
          rw [← hc]
          exact Finset.sum_congr rfl (fun i _ => mul_comm _ _)
        | succ k ih =>
          have h1 : ∀ i, f i * y i (k + 1) = f i * y i k + e k i * f i := by
            intro i; rw [← hy_succ i k]; ring
          rw [Finset.sum_congr rfl (fun i _ => h1 i), Finset.sum_add_distrib, ih, hesum k]
          ring
      have hyc : ∀ i k, y i k ≡ y i (k + 1) [SMOD (I ^ k • ⊤ : Submodule A A)] := by
        intro i k
        rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
        have h2 := he k i
        rw [← hy_succ i k] at h2
        rw [← neg_sub]
        exact neg_mem h2
      let Y : Fin r → AdicCompletion I A := fun i =>
        AdicCompletion.mk I A (AdicCompletion.AdicCauchySequence.mk I A (y i) (hyc i))
      have hx_eq : AdicCompletion.mk I A s = ∑ i, algebraMap A (AdicCompletion I A) (f i) * Y i := by
        apply AdicCompletion.ext_evalₐ
        intro k
        rw [map_sum, AdicCompletion.evalₐ_mk]
        simp only [map_mul, hι, AdicCompletion.evalₐ_of, Y, AdicCompletion.evalₐ_mk,
          AdicCompletion.AdicCauchySequence.mk_coe]
        have h3 : ∑ i, Ideal.Quotient.mk (I ^ k) (f i) * Ideal.Quotient.mk (I ^ k) (y i k) =
            Ideal.Quotient.mk (I ^ k) (∑ i, f i * y i k) := by
          simp [map_sum, map_mul]
        rw [h3, hy_sum k]
        exact (AdicCompletion.Ideal.mk_eq_mk I (Nat.le_add_left k n) s).symm
      rw [hx_eq]
      refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_))
      rw [← hf']
      exact Ideal.subset_span ⟨i, rfl⟩
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, hι, AdicCompletion.evalₐ_of,
        Ideal.Quotient.eq_zero_iff_mem]
      exact ha

  have hsurj : Function.Surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) 1) :=
    AdicCompletion.surjective_evalₐ (IsLocalRing.maximalIdeal O) 1
  haveI hm1 : (IsLocalRing.maximalIdeal O ^ 1).IsMaximal := by
    rw [pow_one]; exact IsLocalRing.maximalIdeal.isMaximal O
  have hmax : (RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) 1)).IsMaximal := by
    rw [RingHom.ker_eq_comap_bot]
    letI : Field (O ⧸ IsLocalRing.maximalIdeal O ^ 1) := Ideal.Quotient.field _
    haveI : (⊥ : Ideal (O ⧸ IsLocalRing.maximalIdeal O ^ 1)).IsMaximal := Ideal.bot_isMaximal
    exact Ideal.comap_isMaximal_of_surjective _ hsurj
  rw [← IsLocalRing.eq_maximalIdeal hmax, hker, pow_one]

theorem wcpa_dj_nccw_gnh_node_ring : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsLocalRing (nccwffQ R 0) ∧ ∃ χ : nccwffQ R 0 →+* R, χ.comp (nccwffPsi R 0) = RingHom.id R ∧ χ (nccwffnzX R 0) = 0 ∧ χ (nccwffnzX R 1) = 0 ∧ (∀ s : nccwffQ R 0, ∃ G₀ G₁ : nccwffQ R 0, s = nccwffPsi R 0 (χ s) + nccwffnzX R 0 * G₀ + nccwffnzX R 1 * G₁) ∧ ∀ hP : (RingHom.ker χ).IsPrime, ¬ IsDomain (@Localization.AtPrime (nccwffQ R 0) _ (RingHom.ker χ) hP) :=
by
  intro R _ _ _
  classical

  have L1 : ∀ F : MvPowerSeries (Fin 2) R, ∃ G₀ G₁ : MvPowerSeries (Fin 2) R,
      F = MvPowerSeries.C (MvPowerSeries.constantCoeff F) + MvPowerSeries.X 0 * G₀ +
        MvPowerSeries.X 1 * G₁ := by
    intro F
    let G₀ : MvPowerSeries (Fin 2) R := fun m => MvPowerSeries.coeff (m + Finsupp.single 0 1) F
    let G₁ : MvPowerSeries (Fin 2) R := fun m =>
      if m 0 = 0 then MvPowerSeries.coeff (m + Finsupp.single 1 1) F else 0
    have hG₀ : ∀ m, MvPowerSeries.coeff m G₀ = MvPowerSeries.coeff (m + Finsupp.single 0 1) F :=
      fun m => rfl
    have hG₁ : ∀ m, MvPowerSeries.coeff m G₁ =
        if m 0 = 0 then MvPowerSeries.coeff (m + Finsupp.single 1 1) F else 0 := fun m => rfl
    refine ⟨G₀, G₁, ?_⟩
    ext n
    rw [map_add, map_add, MvPowerSeries.X_def, MvPowerSeries.X_def,
      MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_monomial_mul, hG₀, hG₁,
      MvPowerSeries.coeff_C, one_mul, one_mul]
    have hsub1 : (n - Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = n 0 := by simp
    by_cases h0 : n 0 = 0
    · have hn0 : ¬ Finsupp.single (0 : Fin 2) 1 ≤ n := by rw [Finsupp.single_le_iff]; omega
      by_cases h1 : n 1 = 0
      · have hn : n = 0 := by
          ext i
          fin_cases i
          · simpa using h0
          · simpa using h1
        have hn1 : ¬ Finsupp.single (1 : Fin 2) 1 ≤ n := by rw [Finsupp.single_le_iff]; omega
        rw [if_pos hn, if_neg hn0, if_neg hn1, hn, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        simp
      · have hn1 : Finsupp.single (1 : Fin 2) 1 ≤ n := by rw [Finsupp.single_le_iff]; omega
        have hn : n ≠ 0 := by intro h; apply h1; rw [h]; rfl
        rw [if_neg hn0, if_pos hn1, hsub1, if_pos h0, tsub_add_cancel_of_le hn1, if_neg hn]
        simp
    · have hn0 : Finsupp.single (0 : Fin 2) 1 ≤ n := by rw [Finsupp.single_le_iff]; omega
      have hn : n ≠ 0 := by intro h; apply h0; rw [h]; rfl
      rw [if_pos hn0, tsub_add_cancel_of_le hn0, hsub1, if_neg h0, ite_self, if_neg hn]
      simp

  have key2 : ∀ i : Fin 2,
      ¬ (Finsupp.single (0 : Fin 2) 1 + Finsupp.single 1 1 ≤ Finsupp.single i 1) := by
    intro i hle
    fin_cases i
    · have := Finsupp.le_def.mp hle 1
      simp at this
    · have := Finsupp.le_def.mp hle 0
      simp at this
  have L2 : ∀ (F H : MvPowerSeries (Fin 2) R) (i : Fin 2),
      F * MvPowerSeries.X i = H * (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C 0) →
      MvPowerSeries.constantCoeff F = 0 := by
    intro F H i hFH
    have h := congrArg (MvPowerSeries.coeff (Finsupp.single i 1)) hFH
    simp only [map_zero, sub_zero, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial,
      mul_one, MvPowerSeries.coeff_mul_monomial, if_neg (key2 i), le_refl, if_true,
      tsub_self, MvPowerSeries.coeff_zero_eq_constantCoeff_apply] at h
    exact h

  have hI : ∀ a ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C 0} :
      Ideal (MvPowerSeries (Fin 2) R)), MvPowerSeries.constantCoeff a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp
  obtain ⟨χ, hχmk⟩ : ∃ χ : nccwffQ R 0 →+* R, ∀ F : MvPowerSeries (Fin 2) R,
      χ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R)) F) =
        MvPowerSeries.constantCoeff F :=
    ⟨Ideal.Quotient.lift _ MvPowerSeries.constantCoeff hI, fun F => Ideal.Quotient.lift_mk _ _ _⟩
  refine ⟨?_, χ, ?_, ?_, ?_, ?_, ?_⟩
  · haveI : Nontrivial (nccwffQ R 0) := RingHom.domain_nontrivial χ
    exact IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 *
      MvPowerSeries.X 1 - MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R)))
      Ideal.Quotient.mk_surjective
  · refine RingHom.ext fun r => ?_
    rw [RingHom.comp_apply, RingHom.id_apply]
    change χ ((Ideal.Quotient.mk _) (MvPowerSeries.C r)) = r
    rw [hχmk]
    simp
  · change χ ((Ideal.Quotient.mk _) (MvPowerSeries.X 0)) = 0
    rw [hχmk]
    simp
  · change χ ((Ideal.Quotient.mk _) (MvPowerSeries.X 1)) = 0
    rw [hχmk]
    simp
  · intro s
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective (I := (Ideal.span {MvPowerSeries.X 0 *
      MvPowerSeries.X 1 - MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R))) s
    obtain ⟨G₀, G₁, hF⟩ := L1 F
    refine ⟨Ideal.Quotient.mk _ G₀, Ideal.Quotient.mk _ G₁, ?_⟩
    rw [hχmk]
    conv_lhs => rw [hF]
    rw [map_add, map_add, map_mul, map_mul]
    rfl
  · intro hP hdom
    have hx01 : nccwffnzX R 0 * nccwffnzX R 1 = 0 := by
      change (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R))) (MvPowerSeries.X 0) *
        (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R))) (MvPowerSeries.X 1) = 0
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      have := Ideal.mem_span_singleton_self
        (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C 0 : MvPowerSeries (Fin 2) R)
      simpa using this
    have hx : algebraMap (nccwffQ R 0) (@Localization.AtPrime (nccwffQ R 0) _ (RingHom.ker χ) hP)
        (nccwffnzX R 0) * algebraMap (nccwffQ R 0)
        (@Localization.AtPrime (nccwffQ R 0) _ (RingHom.ker χ) hP) (nccwffnzX R 1) = 0 := by
      rw [← map_mul, hx01]
      exact map_zero _
    have key : ∀ i : Fin 2, algebraMap (nccwffQ R 0)
        (@Localization.AtPrime (nccwffQ R 0) _ (RingHom.ker χ) hP) (nccwffnzX R i) = 0 →
        False := by
      intro i h
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (RingHom.ker χ).primeCompl
        (@Localization.AtPrime (nccwffQ R 0) _ (RingHom.ker χ) hP) _).mp h
      obtain ⟨F, hF⟩ := Ideal.Quotient.mk_surjective (I := (Ideal.span {MvPowerSeries.X 0 *
        MvPowerSeries.X 1 - MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R)))
        (m : nccwffQ R 0)
      have hmem : F * MvPowerSeries.X i ∈ (Ideal.span {MvPowerSeries.X 0 *
          MvPowerSeries.X 1 - MvPowerSeries.C 0} : Ideal (MvPowerSeries (Fin 2) R)) := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hF]
        exact hm
      obtain ⟨H, hH⟩ := Ideal.mem_span_singleton'.mp hmem
      have h0 := L2 F H i hH.symm
      apply m.2
      show (m : nccwffQ R 0) ∈ RingHom.ker χ
      rw [RingHom.mem_ker, ← hF, hχmk, h0]
    rcases mul_eq_zero.mp hx with h | h
    · exact key 0 h
    · exact key 1 h

theorem wcpa_dj_nccw_gnh_branch_dichotomy : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (χ : nccwffQ R 0 →+* R) (ψ : nccwffQ R 0 →+* PowerSeries R), χ.comp (nccwffPsi R 0) = RingHom.id R → (∀ s : nccwffQ R 0, ∃ G₀ G₁ : nccwffQ R 0, s = nccwffPsi R 0 (χ s) + nccwffnzX R 0 * G₀ + nccwffnzX R 1 * G₁) → ψ.comp (nccwffPsi R 0) = PowerSeries.C → ¬ IsUnit (ψ (nccwffnzX R 0)) → ¬ IsUnit (ψ (nccwffnzX R 1)) → (∀ s : nccwffQ R 0, ¬ IsUnit s → PowerSeries.map (IsLocalRing.residue R) (ψ s) = 0) ∨ ∃ f : PowerSeries R, ¬ IsUnit f ∧ PowerSeries.map (IsLocalRing.residue R) f ≠ 0 ∧ ∀ s : nccwffQ R 0, χ s = 0 → ψ s ∈ Ideal.span {f} :=
by
  intro R _ _ _ χ ψ _hχPsi hdec hψPsi hX0 hX1
  classical

  have hXX : nccwffnzX R 0 * nccwffnzX R 1 = 0 := by
    unfold nccwffnzX
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.subset_span
    simp
  have hf01 : ψ (nccwffnzX R 0) * ψ (nccwffnzX R 1) = 0 := by
    rw [← map_mul, hXX, map_zero]

  have hres : ∀ s : nccwffQ R 0, ¬ IsUnit s → IsLocalRing.residue R (χ s) = 0 := by
    intro s hs
    obtain ⟨G₀, G₁, hs'⟩ := hdec s
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hc
    apply hs
    obtain ⟨g₀, hg₀⟩ := Ideal.Quotient.mk_surjective G₀
    obtain ⟨g₁, hg₁⟩ := Ideal.Quotient.mk_surjective G₁
    have hF : s = Ideal.Quotient.mk _ (MvPowerSeries.C (χ s) + MvPowerSeries.X 0 * g₀ +
        MvPowerSeries.X 1 * g₁) := by
      rw [map_add, map_add, map_mul, map_mul, hg₀, hg₁]
      exact hs'
    rw [hF]
    apply IsUnit.map
    rw [MvPowerSeries.isUnit_iff_constantCoeff]
    simpa using hc

  have hψexp : ∀ (s G₀ G₁ : nccwffQ R 0),
      s = nccwffPsi R 0 (χ s) + nccwffnzX R 0 * G₀ + nccwffnzX R 1 * G₁ →
      ψ s = PowerSeries.C (χ s) + ψ (nccwffnzX R 0) * ψ G₀ + ψ (nccwffnzX R 1) * ψ G₁ := by
    intro s G₀ G₁ h
    have hC : ψ (nccwffPsi R 0 (χ s)) = PowerSeries.C (χ s) := RingHom.congr_fun hψPsi (χ s)
    have h2 := congrArg ψ h
    rw [h2, map_add, map_add, map_mul, map_mul, hC]

  by_cases hL : PowerSeries.map (IsLocalRing.residue R) (ψ (nccwffnzX R 0)) = 0 ∧
      PowerSeries.map (IsLocalRing.residue R) (ψ (nccwffnzX R 1)) = 0
  · left
    intro s hs
    obtain ⟨G₀, G₁, h⟩ := hdec s
    rw [hψexp s G₀ G₁ h, map_add, map_add, map_mul, map_mul, hL.1, hL.2, PowerSeries.map_C,
      hres s hs]
    simp
  · right
    rcases not_and_or.mp hL with h0 | h1
    · have hne : ψ (nccwffnzX R 0) ≠ 0 := fun h => h0 (by rw [h, map_zero])
      have hz : ψ (nccwffnzX R 1) = 0 := (mul_eq_zero.mp hf01).resolve_left hne
      refine ⟨ψ (nccwffnzX R 0), hX0, h0, fun s hs => ?_⟩
      obtain ⟨G₀, G₁, h⟩ := hdec s
      rw [hψexp s G₀ G₁ h, hz, hs, (map_zero PowerSeries.C : PowerSeries.C (0 : R) = 0), zero_mul, add_zero, zero_add]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · have hne : ψ (nccwffnzX R 1) ≠ 0 := fun h => h1 (by rw [h, map_zero])
      have hz : ψ (nccwffnzX R 0) = 0 := (mul_eq_zero.mp hf01).resolve_right hne
      refine ⟨ψ (nccwffnzX R 1), hX1, h1, fun s hs => ?_⟩
      obtain ⟨G₀, G₁, h⟩ := hdec s
      rw [hψexp s G₀ G₁ h, hz, hs, (map_zero PowerSeries.C : PowerSeries.C (0 : R) = 0), zero_mul, add_zero, zero_add]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

theorem wcpa_dj_nccw_gnh_ps_prime : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (f : PowerSeries R), ¬ IsUnit f → PowerSeries.map (IsLocalRing.residue R) f ≠ 0 → ∃ Q : Ideal (PowerSeries R), Q.IsPrime ∧ f ∈ Q ∧ ∀ r : R, PowerSeries.C r ∈ Q → r = 0 :=
by
  intro R _ _ _ f hfnu hfres
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hϖ.not_isUnit
  have hres : IsLocalRing.residue R ϖ = 0 := (IsLocalRing.residue_eq_zero_iff ϖ).mpr hϖm
  have hC0 : (PowerSeries.C ϖ : PowerSeries R) ≠ 0 := by
    intro h
    apply hϖ.ne_zero
    have : (PowerSeries.C ϖ : PowerSeries R) = PowerSeries.C 0 := by rw [h, map_zero]
    exact PowerSeries.C_injective this

  have s1 : ∀ g : PowerSeries R, PowerSeries.map (IsLocalRing.residue R) g = 0 →
      ∃ g' : PowerSeries R, g = PowerSeries.C ϖ * g' := by
    intro g hg
    have hc : ∀ n, ∃ a : R, a * ϖ = PowerSeries.coeff n g := by
      intro n
      have h1 : PowerSeries.coeff n (PowerSeries.map (IsLocalRing.residue R) g) = 0 := by
        rw [hg, map_zero]
      rw [PowerSeries.coeff_map] at h1
      have h2 : PowerSeries.coeff n g ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalRing.residue_eq_zero_iff _).mp h1
      rw [hϖ.maximalIdeal_eq, Ideal.mem_span_singleton'] at h2
      exact h2
    choose a ha using hc
    refine ⟨PowerSeries.mk a, ?_⟩
    ext n
    rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_mk, ← ha n, mul_comm]

  have s3 : ∀ n : ℕ, ∀ g : PowerSeries R, g * f ≠ PowerSeries.C ϖ ^ n := by
    intro n
    induction n with
    | zero =>
      intro g hg
      rw [pow_zero] at hg
      exact hfnu (isUnit_iff_exists_inv.mpr ⟨g, by rw [mul_comm]; exact hg⟩)
    | succ n ih =>
      intro g hg
      have h1 := congrArg (PowerSeries.map (IsLocalRing.residue R)) hg
      rw [map_mul, map_pow, PowerSeries.map_C, hres, map_zero,
        zero_pow (Nat.succ_ne_zero n)] at h1
      rcases mul_eq_zero.mp h1 with h | h
      · obtain ⟨g', rfl⟩ := s1 g h
        apply ih g'
        apply mul_left_cancel₀ hC0
        rw [← mul_assoc, hg, pow_succ']
      · exact hfres h
  have hdisj : Disjoint (↑(Ideal.span {f}) : Set (PowerSeries R))
      (↑(Submonoid.powers (PowerSeries.C ϖ)) : Set (PowerSeries R)) := by
    rw [Set.disjoint_left]
    intro x hx hx'
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp hx'
    exact s3 n a hn.symm
  obtain ⟨Q, hQ, hle, hQd⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
  refine ⟨Q, hQ, hle (Ideal.mem_span_singleton_self f), ?_⟩

  intro r hr
  by_contra hr0
  obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.associated_pow_irreducible hr0 hϖ
  have h1 : PowerSeries.C ϖ ^ n ∈ Q := by
    rw [← map_pow, ← hu, map_mul]
    exact Q.mul_mem_right _ hr
  exact Set.disjoint_left.mp hQd h1 ((Submonoid.mem_powers_iff _ _).mpr ⟨n, rfl⟩)

theorem wcpa_dj_nccw_gnh_point_base : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (h : X ⟶ Spec (.of R)) (x : X) (Q : Ideal (X.presheaf.stalk x)) (hQ : Q.IsPrime), (h (X.fromSpecStalk x ⟨Q, hQ⟩)).asIdeal = Q.comap ((X.presheaf.germ ⊤ x trivial).hom.comp (wcCnSigma h ⊤)) :=
by
  intro R _ X h x Q hQ
  set ρ : CommRingCat.of R ⟶ X.presheaf.stalk x :=
    (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ h.appTop ≫ X.presheaf.germ ⊤ x trivial with hρdef
  have key : X.fromSpecStalk x ≫ h = Spec.map ρ := by
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
    rw [← cancel_mono (Scheme.ΓSpecIso (X.presheaf.stalk x)).hom]
    rw [Scheme.ΓSpecIso_naturality]
    simp [hρdef]
  have hρ : ρ.hom = (X.presheaf.germ ⊤ x trivial).hom.comp (wcCnSigma h ⊤) := by
    unfold wcCnSigma
    rw [hρdef]
    ext r
    simp
  have e : ∀ p, h (X.fromSpecStalk x p) = (Spec.map ρ) p := fun p => by
    rw [← key, Scheme.Hom.comp_apply]
  have h1 := congrArg PrimeSpectrum.asIdeal (e ⟨Q, hQ⟩)
  have e2 : ∀ p : Spec (X.presheaf.stalk x), ((Spec.map ρ) p).asIdeal = p.asIdeal.comap ρ.hom :=
    fun p => by rw [Spec.map_apply]; rfl
  refine h1.trans ((e2 _).trans ?_)
  rw [hρ]

theorem wcpa_dj_nccw_gnh_excellent_nonsmooth : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], wcpaDjNccExcellent.{u} → IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), LocallyOfFiniteType u → ∀ z : Z, IsClosed ({z} : Set Z) → ∀ (A : Type u) [CommRing A] (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+* A) (Q : Ideal A) (hQ : Q.IsPrime), ¬ IsDomain (@Localization.AtPrime A _ Q hQ) → ∀ hP : (Q.comap (e.toRingHom.comp (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))))).IsPrime, ¬ nccwSm u (Z.fromSpecStalk z ⟨Q.comap (e.toRingHom.comp (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)))), hP⟩) :=
by
  intro R _ _ _ Exc hcomp Z u hu z hzcl A _ e Q hQ hnd hP
  rintro ⟨V, hξV, hVsm⟩
  classical
  set ξ := Z.fromSpecStalk z ⟨_, hP⟩ with hξdef
  have hξz : ξ ⤳ z := by
    have hmem : ξ ∈ Set.range (Z.fromSpecStalk z) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecStalk] at hmem
    exact hmem
  obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset
    (show z ∈ (⊤ : Z.Opens) from trivial)
  have hξU : ξ ∈ U := hξz.mem_open U.isOpen hzU
  obtain ⟨f, hfle, hξf⟩ := hU.exists_basicOpen_le (V := U ⊓ V) ⟨ξ, hξU, hξV⟩ hξU
  have hfV : Z.basicOpen f ≤ V := fun x hx => (hfle hx).2

  have hft : (wcCnSigma u U).FiniteType := by
    have h1 := LocallyOfFiniteType.finiteType_appLE u (isAffineOpen_top (Spec (.of R))) hU
      (fun x _ => by simp)
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _ (fun x => ⟨(Scheme.ΓSpecIso _).hom.hom x, by
        rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]⟩)
    have h3 := RingHom.FiniteType.comp h1 h2
    convert h3 using 1
    first
      | rfl
      | (unfold wcCnSigma Scheme.Hom.appLE Scheme.Hom.appTop; rfl)
      | (simp only [wcCnSigma, Scheme.Hom.appLE, Scheme.Hom.appTop, CommRingCat.hom_comp,
          RingHom.comp_assoc]; rfl)

  have hmax : (hU.primeIdealOf ⟨z, hzU⟩).asIdeal.IsMaximal := by
    rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal]
    have hset : ({hU.primeIdealOf ⟨z, hzU⟩} : Set _) = hU.fromSpec ⁻¹' {z} := by
      ext y
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hU.fromSpec_primeIdealOf ⟨z, hzU⟩
      · intro hy
        haveI := hU.isOpenImmersion_fromSpec
        exact hU.fromSpec.isOpenEmbedding.injective
          (hy.trans (hU.fromSpec_primeIdealOf ⟨z, hzU⟩).symm)
    rw [hset]
    exact hzcl.preimage hU.fromSpec.continuous

  have hgerm : (Z.presheaf.germ U z hzU).hom f ∉ Q.comap (e.toRingHom.comp (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)))) := by
    have h1 : ξ = hU.fromSpec (PrimeSpectrum.comap (Z.presheaf.germ U z hzU).hom ⟨_, hP⟩) := by
      rw [hξdef, ← hU.fromSpecStalk_eq_fromSpecStalk hzU]
      rfl
    have hξf' : ξ ∈ Z.basicOpen f := hξf
    have h3 : PrimeSpectrum.comap (Z.presheaf.germ U z hzU).hom ⟨_, hP⟩ ∈
        hU.fromSpec ⁻¹ᵁ Z.basicOpen f := by
      show hU.fromSpec _ ∈ Z.basicOpen f
      rw [← h1]
      exact hξf'
    rw [hU.fromSpec_preimage_basicOpen] at h3
    first
      | exact h3
      | exact (PrimeSpectrum.mem_basicOpen f _).mp h3

  haveI := hVsm
  have s4 : ∀ (𝔮 : Ideal Γ(Z, U)) [𝔮.IsPrime], f ∉ 𝔮 →
      IsDomain (Localization.AtPrime 𝔮) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔮) := by
    intro 𝔮 h𝔮 hf𝔮
    let p : PrimeSpectrum Γ(Z, U) := ⟨𝔮, h𝔮⟩
    have hyU : hU.fromSpec p ∈ U := by
      show hU.fromSpec p ∈ (U : Set Z)
      rw [← hU.range_fromSpec]
      exact ⟨p, rfl⟩
    have hyf : hU.fromSpec p ∈ Z.basicOpen f := by
      have : p ∈ hU.fromSpec ⁻¹ᵁ Z.basicOpen f := by
        rw [hU.fromSpec_preimage_basicOpen]
        exact hf𝔮
      exact this
    have hyV : hU.fromSpec p ∈ V := hfV hyf
    letI : Algebra Γ(Z, U) (Z.presheaf.stalk (hU.fromSpec p)) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨hU.fromSpec p, hyU⟩
    haveI : IsLocalization.AtPrime (Z.presheaf.stalk (hU.fromSpec p)) 𝔮 :=
      hU.isLocalization_stalk' p hyU
    obtain ⟨hd, hic⟩ := wcpa_dj_lus_cvs_ct_fcn_smooth_stalk_normal R V.toScheme (V.ι ≫ u) 1
      ⟨hU.fromSpec p, hyV⟩
    let ι1 := (Scheme.Opens.stalkIso V ⟨hU.fromSpec p, hyV⟩).commRingCatIsoToRingEquiv
    let κ := (IsLocalization.algEquiv 𝔮.primeCompl (Localization.AtPrime 𝔮)
      (Z.presheaf.stalk (hU.fromSpec p))).toRingEquiv
    let ε : Localization.AtPrime 𝔮 ≃+* V.toScheme.presheaf.stalk ⟨hU.fromSpec p, hyV⟩ :=
      κ.trans ι1.symm
    exact ⟨MulEquiv.isDomain _ ε.toMulEquiv, IsIntegrallyClosed.of_equiv ε.symm⟩

  have cmap : ∀ (S T : Type u) [CommRing S] [CommRing T] [IsLocalRing S] [IsLocalRing T]
      (φ : S →+* T),
      (∀ x ∈ IsLocalRing.maximalIdeal S, φ x ∈ IsLocalRing.maximalIdeal T) →
      ∃ ψ : AdicCompletion (IsLocalRing.maximalIdeal S) S →+*
          AdicCompletion (IsLocalRing.maximalIdeal T) T,
        ∀ (n : ℕ) (s : S) (x : AdicCompletion (IsLocalRing.maximalIdeal S) S),
          AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ s →
          AdicCompletion.evalₐ _ n (ψ x) = Ideal.Quotient.mk _ (φ s) := by
    intro S T _ _ _ _ φ hφ
    set I := IsLocalRing.maximalIdeal S with hIdef
    set J := IsLocalRing.maximalIdeal T with hJdef
    have hI : I ≤ Ideal.comap φ J := fun x hx => hφ x hx
    have hIn : ∀ n : ℕ, I ^ n ≤ Ideal.comap φ (J ^ n) := fun n =>
      le_trans (Ideal.pow_right_mono hI n) (Ideal.le_comap_pow φ n)
    let φb : ∀ n : ℕ, S ⧸ I ^ n →+* T ⧸ J ^ n := fun n => Ideal.quotientMap (J ^ n) φ (hIn n)
    let F : ∀ n : ℕ, AdicCompletion I S →+* T ⧸ J ^ n := fun n =>
      (φb n).comp (AdicCompletion.evalₐ I n).toRingHom
    have t4 : ∀ {m n : ℕ} (hle : m ≤ n) (x : AdicCompletion I S),
        Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n x) =
          AdicCompletion.evalₐ I m x := by
      intro m n hle x
      induction x using AdicCompletion.induction_on with
      | h a =>
        rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
        rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
        exact AdicCompletion.Ideal.mk_eq_mk I hle a
    have t5 : ∀ {m n : ℕ} (hle : m ≤ n) (y : S ⧸ I ^ n),
        Ideal.Quotient.factorPow J hle (φb n y) = φb m (Ideal.Quotient.factorPow I hle y) := by
      intro m n hle y
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective y
      simp only [φb, Ideal.Quotient.factorPow, Ideal.quotientMap_mk, Ideal.Quotient.factor_mk]
    have hF : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp (F n) = F m := by
      intro m n hle
      refine RingHom.ext fun x => ?_
      simp only [F, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [t5 hle, t4 hle]
    refine ⟨AdicCompletion.liftRingHom J F hF, fun n s x hx => ?_⟩
    rw [AdicCompletion.evalₐ_liftRingHom]
    simp only [F, φb, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hx, Ideal.quotientMap_mk]
  have s5 : ∀ (S T : Type u) [CommRing S] [CommRing T] [IsLocalRing S] [IsLocalRing T]
      (φ : S ≃+* T), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal S) S ≃+*
          AdicCompletion (IsLocalRing.maximalIdeal T) T,
        ∀ s : S, Φ (algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S) s) =
          algebraMap T (AdicCompletion (IsLocalRing.maximalIdeal T) T) (φ s) := by
    intro S T _ _ _ _ φ
    have h1 : ∀ x ∈ IsLocalRing.maximalIdeal S, φ.toRingHom x ∈ IsLocalRing.maximalIdeal T := by
      intro x hx
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu
      apply hx
      have := (isUnit_map_iff φ x).mp hu
      exact this
    have h2 : ∀ x ∈ IsLocalRing.maximalIdeal T, φ.symm.toRingHom x ∈
        IsLocalRing.maximalIdeal S := by
      intro x hx
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu
      apply hx
      have := (isUnit_map_iff φ.symm x).mp hu
      exact this
    obtain ⟨Φ₀, hΦ₀⟩ := cmap S T φ.toRingHom h1
    obtain ⟨Ψ₀, hΨ₀⟩ := cmap T S φ.symm.toRingHom h2
    have hc1 : ∀ x, Ψ₀ (Φ₀ x) = x := by
      intro x
      refine AdicCompletion.ext_evalₐ fun n => ?_
      obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      rw [hΨ₀ n (φ.toRingHom s) (Φ₀ x) (hΦ₀ n s x hs.symm), ← hs]
      simp
    have hc2 : ∀ y, Φ₀ (Ψ₀ y) = y := by
      intro y
      refine AdicCompletion.ext_evalₐ fun n => ?_
      obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [hΦ₀ n (φ.symm.toRingHom s) (Ψ₀ y) (hΨ₀ n s y hs.symm), ← hs]
      simp
    refine ⟨RingEquiv.ofRingHom Φ₀ Ψ₀ (RingHom.ext hc2) (RingHom.ext hc1), fun s => ?_⟩
    refine AdicCompletion.ext_evalₐ fun n => ?_
    show AdicCompletion.evalₐ _ n (Φ₀ _) = _
    rw [hΦ₀ n s _ (by rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]),
      AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    rfl

  have s6 : ∀ (B : Type u) [CommRing B] (𝔪 : Ideal B) [𝔪.IsPrime] (f : B),
      (∀ (𝔮 : Ideal B) [𝔮.IsPrime], f ∉ 𝔮 →
        IsDomain (Localization.AtPrime 𝔮) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔮)) →
      ∀ (P : Ideal (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))) [P.IsPrime],
        IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) := by
    intro B _ 𝔪 _ f hB P hPp
    haveI : IsLocalization (IsLocalization.localizationLocalizationSubmodule 𝔪.primeCompl
        (Submonoid.powers (algebraMap B (Localization.AtPrime 𝔪) f)))
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f)) :=
      IsLocalization.localization_localization_isLocalization _ _ _
    haveI hloc := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (IsLocalization.localizationLocalizationSubmodule 𝔪.primeCompl
        (Submonoid.powers (algebraMap B (Localization.AtPrime 𝔪) f)))
      (Localization.AtPrime P) P
    haveI h𝔮 : (Ideal.comap (algebraMap B
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))) P).IsPrime :=
      Ideal.IsPrime.comap _
    have hf : f ∉ Ideal.comap (algebraMap B
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))) P := by
      intro hmem
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply B (Localization.AtPrime 𝔪)
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))] at hmem
      exact hPp.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem
        (IsLocalization.Away.algebraMap_isUnit _))
    obtain ⟨hd, hic⟩ := hB (Ideal.comap (algebraMap B
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))) P) hf
    let κ := (IsLocalization.algEquiv (Ideal.comap (algebraMap B
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))) P).primeCompl
      (Localization.AtPrime (Ideal.comap (algebraMap B
        (Localization.Away (algebraMap B (Localization.AtPrime 𝔪) f))) P))
      (Localization.AtPrime P)).toRingEquiv
    exact ⟨MulEquiv.isDomain _ κ.symm.toMulEquiv, IsIntegrallyClosed.of_equiv κ⟩

  have s7 : ∀ (T : Type u) [CommRing T] (g : T) (Q₁ : Ideal T) [Q₁.IsPrime], g ∉ Q₁ →
      (∀ (Q' : Ideal (Localization.Away g)) [Q'.IsPrime], IsDomain (Localization.AtPrime Q')) →
      IsDomain (Localization.AtPrime Q₁) := by
    intro T _ g Q₁ hQ₁ hg hD
    have hdisj : Disjoint (Submonoid.powers g : Set T) (Q₁ : Set T) := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hg (hQ₁.mem_of_pow_mem n hx)
    haveI hQ' : (Ideal.map (algebraMap T (Localization.Away g)) Q₁).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g) _ Q₁ hQ₁ hdisj
    have hcomap : Ideal.comap (algebraMap T (Localization.Away g))
        (Ideal.map (algebraMap T (Localization.Away g)) Q₁) = Q₁ :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g) _ hQ₁ hdisj
    haveI hloc := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Submonoid.powers g) (Localization.AtPrime (Ideal.map (algebraMap T (Localization.Away g)) Q₁))
      (Ideal.map (algebraMap T (Localization.Away g)) Q₁)
    have hpc : (Ideal.comap (algebraMap T (Localization.Away g))
        (Ideal.map (algebraMap T (Localization.Away g)) Q₁)).primeCompl = Q₁.primeCompl := by
      ext x
      simp only [Ideal.mem_primeCompl_iff, hcomap]
    haveI hloc' : IsLocalization Q₁.primeCompl
        (Localization.AtPrime (Ideal.map (algebraMap T (Localization.Away g)) Q₁)) := by
      rw [← hpc]
      exact hloc
    haveI := hD (Ideal.map (algebraMap T (Localization.Away g)) Q₁)
    exact MulEquiv.isDomain _ (IsLocalization.algEquiv Q₁.primeCompl (Localization.AtPrime Q₁)
      (Localization.AtPrime (Ideal.map (algebraMap T (Localization.Away g)) Q₁))).toRingEquiv.toMulEquiv

  have s8 : ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B →
      ∀ (𝔪 : Ideal B) [𝔪.IsMaximal] (g : Localization.AtPrime 𝔪),
      (∀ (P : Ideal (Localization.Away g)) [P.IsPrime],
        IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) →
      ∀ (Q' : Ideal (Localization.Away (algebraMap (Localization.AtPrime 𝔪)
        (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
          (Localization.AtPrime 𝔪)) g))) [Q'.IsPrime], IsDomain (Localization.AtPrime Q') := by
    intro B _ _ hftB 𝔪 _ g hC Q' _
    letI algCD : Algebra (Localization.Away g) (Localization.Away (algebraMap
        (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
          (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) g)) :=
      (Localization.awayMap (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))) g).toAlgebra
    have hx : ∀ x : Localization.AtPrime 𝔪,
        algebraMap (Localization.AtPrime 𝔪) (Localization.Away (algebraMap (Localization.AtPrime 𝔪)
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
            (Localization.AtPrime 𝔪)) g)) x =
        algebraMap (Localization.Away g) (Localization.Away (algebraMap (Localization.AtPrime 𝔪)
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
            (Localization.AtPrime 𝔪)) g)) (algebraMap (Localization.AtPrime 𝔪)
              (Localization.Away g) x) := by
      intro x
      rw [RingHom.algebraMap_toAlgebra, Localization.awayMap, IsLocalization.Away.map,
        IsLocalization.map_eq]
      first
        | exact IsScalarTower.algebraMap_apply (Localization.AtPrime 𝔪)
            (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
              (Localization.AtPrime 𝔪)) _ x
        | rfl
    haveI tow : IsScalarTower (Localization.AtPrime 𝔪) (Localization.Away g)
        (Localization.Away (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) g)) := by
      first
        | exact IsScalarTower.of_algebraMap_eq (R := Localization.AtPrime 𝔪)
            (S := Localization.Away g) (A := Localization.Away (algebraMap (Localization.AtPrime 𝔪)
              (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
                (Localization.AtPrime 𝔪)) g)) hx
        | (refine ⟨fun x y w => ?_⟩
           simp only [Algebra.smul_def, map_mul, hx, mul_assoc])
    haveI : IsLocalization (Algebra.algebraMapSubmonoid (AdicCompletion
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))
        (Submonoid.powers g))
        (Localization.Away (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) g)) := by
      rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
      infer_instance
    have hpush := Algebra.isPushout_of_isLocalization (Submonoid.powers g) (Localization.Away g)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))
      (Localization.Away (algebraMap (Localization.AtPrime 𝔪) (AdicCompletion
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) g))
    have hftC : Algebra.FiniteType (Localization.AtPrime 𝔪) (Localization.Away g) :=
      IsLocalization.finiteType_of_monoid_fg (Submonoid.powers g) _
    exact (Exc R hcomp B hftB 𝔪 (Localization.Away g) hftC hC _ hpush Q').1

  have core : ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B →
      ∀ (𝔪 : Ideal B) [𝔪.IsMaximal] (f : B),
      (∀ (𝔮 : Ideal B) [𝔮.IsPrime], f ∉ 𝔮 →
        IsDomain (Localization.AtPrime 𝔮) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔮)) →
      ∀ (O : Type u) [CommRing O] [IsLocalRing O] [Algebra B O] [IsLocalization.AtPrime O 𝔪]
        (A : Type u) [CommRing A] (e : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* A)
        (Q : Ideal A) [Q.IsPrime],
        e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (algebraMap B O f)) ∉ Q →
        IsDomain (Localization.AtPrime Q) := by
    intro B _ _ hftB 𝔪 _ f hnorm O _ _ _ _ A _ e Q _ hfQ
    let κ : Localization.AtPrime 𝔪 ≃+* O :=
      (IsLocalization.algEquiv 𝔪.primeCompl (Localization.AtPrime 𝔪) O).toRingEquiv
    have hκ : ∀ b : B, κ (algebraMap B (Localization.AtPrime 𝔪) b) = algebraMap B O b := fun b =>
      (IsLocalization.algEquiv 𝔪.primeCompl (Localization.AtPrime 𝔪) O).commutes b
    obtain ⟨Φ, hΦ⟩ := s5 (Localization.AtPrime 𝔪) O κ
    haveI hQ₁ : (Q.comap (Φ.trans e).toRingHom).IsPrime := Ideal.IsPrime.comap _
    have hf₁ : algebraMap (Localization.AtPrime 𝔪) (AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) (algebraMap B (Localization.AtPrime 𝔪) f)
        ∉ Q.comap (Φ.trans e).toRingHom := by
      rw [Ideal.mem_comap]
      simp only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, RingEquiv.trans_apply]
      rw [hΦ, hκ]
      exact hfQ
    have hD := s8 B hftB 𝔪 (algebraMap B (Localization.AtPrime 𝔪) f) (s6 B 𝔪 f hnorm)
    haveI := s7 _ _ (Q.comap (Φ.trans e).toRingHom) hf₁ (fun Q' _ => hD Q')
    have Hsub : Submonoid.map (Φ.trans e).toMonoidHom (Q.comap (Φ.trans e).toRingHom).primeCompl =
        Q.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hy
        refine ⟨(Φ.trans e).symm y, ?_, ?_⟩
        · show (Φ.trans e).symm y ∉ Q.comap (Φ.trans e).toRingHom
          rw [Ideal.mem_comap]
          simpa using hy
        · simp
    exact MulEquiv.isDomain _ (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (Q.comap (Φ.trans e).toRingHom)) (Localization.AtPrime Q)
      (Φ.trans e) Hsub).symm.toMulEquiv

  haveI := hmax
  letI : Algebra R Γ(Z, U) := (wcCnSigma u U).toAlgebra
  letI : Algebra Γ(Z, U) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hzU⟩
  haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hU.primeIdealOf ⟨z, hzU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨z, hzU⟩
  rw [Ideal.mem_comap] at hgerm
  exact hnd (core Γ(Z, U) hft (hU.primeIdealOf ⟨z, hzU⟩).asIdeal f s4 (Z.presheaf.stalk z)
    A e Q hgerm)

theorem wcpa_dj_nccw_gn_horizontal_point : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ x' : Z', u' x' = IsLocalRing.closedPoint R → IsClosed ({x'} : Set Z') → ¬ nccwSm u' x' → ¬ IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk x')) (Z'.presheaf.stalk x')) → ∀ w : S', ν' w = x' → ∃ ζ : S', ζ ⤳ w ∧ (ν' ≫ u') ζ ≠ IsLocalRing.closedPoint R ∧ ¬ nccwSm u' (ν' ζ) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA x'
    hx'u hx'cl hns hnd w hw
  subst hw
  classical
  have hcomp := hA.1
  have halg := hA.2.1
  have hLoc := hA.2.2.1.2.1
  have hExc := hA.2.2.1.2.2.2.2.2.1
  have hsemi : wcpaDjSemistable u' := hA.2.2.2.1.2.2.1.1
  haveI : IsProper u' := hsemi.2.1
  haveI : LocallyOfFiniteType (ν' ≫ u') := hA.2.2.2.2.2.2.2.1.2.2.2.1
  haveI : IsLocallyNoetherian Z' := LocallyOfFiniteType.isLocallyNoetherian u'
  haveI : IsLocallyNoetherian S' := LocallyOfFiniteType.isLocallyNoetherian (ν' ≫ u')

  obtain ⟨W, -, hfib, hWε⟩ := wcpa_dj_nccw_gn_two_sheets R Z Z' Y G S S' N u u' n τ τ' π a a'
    h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA (ν' w) hx'u hx'cl hns hnd
  obtain ⟨ε, hε⟩ : ∃ ε, w = W ε := by
    rcases (hfib w).mp rfl with h0 | h1
    · exact ⟨0, h0⟩
