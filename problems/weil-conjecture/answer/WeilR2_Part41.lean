      μ q q' st zk η₀ η ηZ hA hzkc (PowerSeries R) hPc inferInstance hPd (Or.inl hPreg)
      PowerSeries.C hPinj e' he'
    exact nccwff_forest_descent R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st
      zk η₀ η ηZ hA hzkc (PowerSeries R) PowerSeries.C ρ hρ e' he' hFO
  rcases hL R hcomp halg Z u hst.1 (ν zk) (by rw [hzeq]; exact hu) (by rw [hzeq]; exact hz) with
    ⟨-, e, he⟩ | ⟨-, c, e, hcm, he⟩
  ·
    obtain ⟨⟨hdom, hic⟩, -⟩ := nccwff_model_rings_normal R hcomp
    haveI := hic
