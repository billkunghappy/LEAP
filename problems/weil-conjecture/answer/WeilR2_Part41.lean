theorem wcpa_dj_nccw_gntsn_completion_injective : ∀ (O A : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] [CommRing A] [IsLocalRing A] (φ : O →+* A), φ.Finite → Function.Injective φ → ∀ ψ : AdicCompletion (IsLocalRing.maximalIdeal O) O →+* AdicCompletion (IsLocalRing.maximalIdeal A) A, ψ.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) = (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ → Function.Injective ψ :=
by
  intro O A _ _ _ _ _ φ hfin hinj
  classical
  letI : Algebra O A := φ.toAlgebra
  haveI : Module.Finite O A := hfin
  haveI : IsNoetherianRing A := IsNoetherianRing.of_finite O A
  suffices key : ∀ (I : Ideal O) (J : Ideal A), I = IsLocalRing.maximalIdeal O →
      J = IsLocalRing.maximalIdeal A → ∀ ψ : AdicCompletion I O →+* AdicCompletion J A,
      ψ.comp (algebraMap O (AdicCompletion I O)) = (algebraMap A (AdicCompletion J A)).comp φ →
      Function.Injective ψ from key _ _ rfl rfl
  intro I J hI hJ ψ hψ

  obtain ⟨k, hk⟩ : ∃ k : ℕ, J ^ k ≤ Ideal.map φ I := by
    apply Ideal.exists_pow_le_of_le_radical_of_fg _ (IsNoetherian.noetherian J)
    intro x hx
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro P ⟨hKP, hP⟩
    haveI := hP
    have h1 : I ≤ P.comap φ := Ideal.le_comap_map.trans (Ideal.comap_mono hKP)
    have h2 : P.comap φ = I := by
      rw [hI] at h1 ⊢
      exact le_antisymm (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.comap φ).ne_top) h1
    have h3 : P.IsMaximal := by
      apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap φ (RingHom.Finite.to_isIntegral hfin) P
      rw [h2, hI]
      exact IsLocalRing.maximalIdeal.isMaximal O
    rw [hJ] at hx
    rw [IsLocalRing.eq_maximalIdeal h3]
    exact hx

  obtain ⟨c, hc⟩ : ∃ c : ℕ, ∀ (n : ℕ) (a : O), φ a ∈ Ideal.map φ I ^ (n + c) → a ∈ I ^ n := by
    obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul I (LinearMap.range (Algebra.linearMap O A))
    refine ⟨c, fun n a ha => ?_⟩
    have h0 : φ a ∈ (I ^ (n + c) • ⊤ : Submodule O A) := by
      rw [Ideal.smul_top_eq_map]
      change φ a ∈ Ideal.map φ (I ^ (n + c))
      rw [Ideal.map_pow]
      exact ha
    have h1 : φ a ∈ (I ^ (n + c) • ⊤ : Submodule O A) ⊓ LinearMap.range (Algebra.linearMap O A) :=
      Submodule.mem_inf.mpr ⟨h0, ⟨a, rfl⟩⟩
    rw [hc (n + c) (by omega), Nat.add_sub_cancel] at h1
    have h2 : φ a ∈ I ^ n • LinearMap.range (Algebra.linearMap O A) :=
      Submodule.smul_mono le_rfl inf_le_right h1
    have h3 : ∀ y ∈ I ^ n • LinearMap.range (Algebra.linearMap O A), ∃ b ∈ I ^ n, φ b = y := by
      intro y hy
      refine Submodule.smul_induction_on hy ?_ ?_
      · rintro r hr _ ⟨b, rfl⟩
        refine ⟨r * b, Ideal.mul_mem_right _ _ hr, ?_⟩
        rw [Algebra.linearMap_apply, Algebra.smul_def, map_mul]
        rfl
      · rintro y₁ y₂ ⟨b₁, hb₁, rfl⟩ ⟨b₂, hb₂, rfl⟩
        exact ⟨b₁ + b₂, add_mem hb₁ hb₂, map_add _ _ _⟩
    obtain ⟨b, hb, hba⟩ := h3 _ h2
    rw [← hinj hba]
    exact hb

  have hevA : ∀ (p : ℕ) (b : O), AdicCompletion.eval I O p (algebraMap O (AdicCompletion I O) b)
      = Submodule.Quotient.mk b := by
    intro p b
    rw [AdicCompletion.eval_apply, AdicCompletion.algebraMap_apply, AdicCompletion.of_apply]
    rfl

  rw [injective_iff_map_eq_zero]
  intro x hx
  apply AdicCompletion.ext
  intro n
  obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I O (n + c) x)
  have hyev : AdicCompletion.eval I O (n + c) (x - algebraMap O (AdicCompletion I O) a) = 0 := by
    rw [map_sub, ← ha, hevA, sub_self]

  have hymem : x - algebraMap O (AdicCompletion I O) a ∈
      Ideal.map (algebraMap O (AdicCompletion I O)) (I ^ (n + c)) := by
    have h1 : x - algebraMap O (AdicCompletion I O) a ∈
        (I ^ (n + c) • ⊤ : Submodule O (AdicCompletion I O)) := by
      rw [AdicCompletion.pow_smul_top_eq_ker_eval (IsNoetherian.noetherian I)]
      exact hyev
    rw [Ideal.smul_top_eq_map] at h1
    exact h1
  have h2 : ψ (x - algebraMap O (AdicCompletion I O) a) ∈
      Ideal.map (ψ.comp (algebraMap O (AdicCompletion I O))) (I ^ (n + c)) := by
    rw [← Ideal.map_map]
    exact Ideal.mem_map_of_mem ψ hymem
  have h3 : ψ (x - algebraMap O (AdicCompletion I O) a) =
      - algebraMap A (AdicCompletion J A) (φ a) := by
    rw [map_sub, hx, zero_sub, ← RingHom.comp_apply ψ, hψ, RingHom.comp_apply]
  rw [h3, neg_mem_iff, hψ, ← Ideal.map_map] at h2

  have hK : J ^ (k * (n + c)) ≤ Ideal.map φ (I ^ (n + c)) := by
    rw [pow_mul, Ideal.map_pow]
    exact Ideal.pow_right_mono hk (n + c)
  have h4 : φ a ∈ Ideal.map φ (I ^ (n + c)) := by
    let e : AdicCompletion J A →+* A ⧸ J ^ (k * (n + c)) :=
      (AdicCompletion.evalₐ J (k * (n + c))).toRingHom
    have he : e.comp (algebraMap A (AdicCompletion J A)) = Ideal.Quotient.mk (J ^ (k * (n + c))) := by
      ext b
      show (AdicCompletion.evalₐ J (k * (n + c))) (algebraMap A _ b) = Ideal.Quotient.mk _ b
      rw [AlgHom.commutes]
      rfl
    have h5 := Ideal.mem_map_of_mem e h2
    have h6 : e (algebraMap A (AdicCompletion J A) (φ a)) = Ideal.Quotient.mk _ (φ a) := by
      rw [← RingHom.comp_apply, he]
    rw [Ideal.map_map, he, h6, Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr hK] at h5
    exact h5

  have h7 : a ∈ I ^ n := hc n a (by rw [← Ideal.map_pow]; exact h4)

  have hyn : (x - algebraMap O (AdicCompletion I O) a).val n = 0 := by
    rw [← AdicCompletion.transitionMap_comp_eval_apply I O (show n ≤ n + c by omega),
      ← AdicCompletion.eval_apply, hyev, map_zero]
  have han : (algebraMap O (AdicCompletion I O) a).val n = 0 := by
    rw [← AdicCompletion.eval_apply, hevA, Submodule.Quotient.mk_eq_zero]
    have : a = a • (1 : O) := by rw [smul_eq_mul, mul_one]
    rw [this]
    exact Submodule.smul_mem_smul h7 Submodule.mem_top
  have hfin' := congrArg (fun z : AdicCompletion I O => z.val n)
    (sub_add_cancel x (algebraMap O (AdicCompletion I O) a))
  simp only [AdicCompletion.val_add, Pi.add_apply, hyn, han, add_zero] at hfin'
  rw [← hfin', AdicCompletion.val_zero]
  rfl

theorem wcpa_dj_nccw_gntsn_single_fibre_stalk : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z), IsFinite ν → Surjective ν → ∀ w : S, (∀ w' : S, ν w' = ν w → w' = w) → _root_.IsReduced (Z.presheaf.stalk (ν w)) → (ν.stalkMap w).hom.Finite ∧ Function.Injective (ν.stalkMap w).hom :=
by
  have gu_aux : ∀ {A₀ C : Type u} [CommRing A₀] [CommRing C] (f : A₀ →+* C) (hf : f.Finite) (p : Ideal A₀) [p.IsPrime] (q : Ideal C) (huniq : ∀ Q : Ideal C, Q.IsPrime → Ideal.comap f Q = p → Q = q) (Q : Ideal C) (hQ : Q.IsPrime) (hle : Ideal.comap f Q ≤ p), Q ≤ q := by
    intro A₀ C _ _ f hf p _ q huniq Q hQ hle
    letI := f.toAlgebra
    haveI : Module.Finite A₀ C := hf
    haveI : Algebra.IsIntegral A₀ C := inferInstance
    obtain ⟨Q', hQQ', hQ'p, hQ'u⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p Q hle
    have := huniq Q' hQ'p hQ'u
    rw [← this]; exact hQQ'
  have loc_finite : ∀ (A₀ C Rp Cq : Type u) [CommRing A₀] [CommRing C] [CommRing Rp] [CommRing Cq] [Algebra A₀ Rp] [Algebra C Cq] (f : A₀ →+* C) (hf : f.Finite) (p : Ideal A₀) [p.IsPrime] (q : Ideal C) [q.IsPrime] [IsLocalization.AtPrime Rp p] [IsLocalization.AtPrime Cq q] (hcomap : Ideal.comap f q = p) (huniq : ∀ Q : Ideal C, Q.IsPrime → Ideal.comap f Q = p → Q = q) (g : Rp →+* Cq) (hg : g.comp (algebraMap A₀ Rp) = (algebraMap C Cq).comp f), g.Finite := by
    intro A₀ C Rp Cq _ _ _ _ _ _ f hf p _ q _ _ _ hcomap huniq g hg
    let M := Submonoid.map f p.primeCompl
    let B := Localization M
    let α : Rp →+* B := IsLocalization.map B f (Submonoid.le_comap_map p.primeCompl)
    have hα : α.Finite := RingHom.finite_localizationPreserves f p.primeCompl Rp B hf
    have hMq : M ≤ q.primeCompl := by
      rintro _ ⟨s, hs, rfl⟩ h
      exact hs (by rw [← hcomap]; exact h)
    have hunit : ∀ c ∈ q.primeCompl, IsUnit (algebraMap C B c) := by
      intro c hc
      by_contra hnu
      obtain ⟨𝔐, h𝔐, hc𝔐⟩ := exists_max_ideal_of_mem_nonunits hnu
      have hQ : (Ideal.comap (algebraMap C B) 𝔐).IsPrime := Ideal.comap_isPrime _ _
      have hle : Ideal.comap f (Ideal.comap (algebraMap C B) 𝔐) ≤ p := by
        intro s hs
        by_contra hsp
        have hu : IsUnit (algebraMap C B (f s)) :=
          IsLocalization.map_units B (⟨f s, s, hsp, rfl⟩ : M)
        exact h𝔐.ne_top (Ideal.eq_top_of_isUnit_mem _ hs hu)
      exact hc (gu_aux f hf p q huniq _ hQ hle hc𝔐)
    haveI : IsLocalization q.primeCompl B := IsLocalization.of_le (S := B) M q.primeCompl hMq hunit
    let e : B ≃ₐ[C] Cq := IsLocalization.algEquiv q.primeCompl B Cq
    have hgeq : g = e.toRingHom.comp α := by
      apply IsLocalization.ringHom_ext p.primeCompl
      rw [hg, RingHom.comp_assoc, IsLocalization.map_comp, ← RingHom.comp_assoc]
      congr 1
      ext c
      simp [e]
    rw [hgeq]
    exact RingHom.Finite.comp (RingHom.Finite.of_surjective _ e.surjective) hα
  have loc_injective : ∀ (A₀ C Rp Cq : Type u) [CommRing A₀] [CommRing C] [CommRing Rp] [CommRing Cq] [Algebra A₀ Rp] [Algebra C Cq] (f : A₀ →+* C) (hf : f.Finite) (p : Ideal A₀) [p.IsPrime] (q : Ideal C) [q.IsPrime] [IsLocalization.AtPrime Rp p] [IsLocalization.AtPrime Cq q] (hcomap : Ideal.comap f q = p) (huniq : ∀ Q : Ideal C, Q.IsPrime → Ideal.comap f Q = p → Q = q) (hlo : ∀ P : Ideal A₀, P.IsPrime → ∃ Q : Ideal C, Q.IsPrime ∧ Ideal.comap f Q = P) (hred : _root_.IsReduced Rp) (g : Rp →+* Cq) (hg : g.comp (algebraMap A₀ Rp) = (algebraMap C Cq).comp f), Function.Injective g := by
    intro A₀ C Rp Cq _ _ _ _ _ _ f hf p _ q _ _ _ hcomap huniq hlo hred g hg
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
    have hspec := IsLocalization.mk'_spec Rp a s
    have h0 : algebraMap C Cq (f a) = 0 := by
      have h1 := congrArg g hspec
      rw [map_mul, hx, zero_mul] at h1
      rw [← RingHom.comp_apply, ← hg, RingHom.comp_apply, ← h1]
    obtain ⟨⟨c, hc⟩, hcfa⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl Cq (f a)).mp h0
    have hmem : ∀ 𝔓 : Ideal Rp, 𝔓.IsPrime → IsLocalization.mk' Rp a s ∈ 𝔓 := by
      intro 𝔓 h𝔓
      have hPp : Ideal.comap (algebraMap A₀ Rp) 𝔓 ≤ p := by
