  set W0 : S.Opens := ⨅ j, e j ⁻¹ᵁ Oo (Vs j) with hW0
  have hW0Oo : ∀ j, W0 ≤ e j ⁻¹ᵁ Oo (Vs j) := fun j => iInf_le (fun j => e j ⁻¹ᵁ Oo (Vs j)) j
