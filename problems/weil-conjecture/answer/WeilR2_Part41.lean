      Ideal.span (Set.range (fun i =>
        algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) (t i))) := by
    rw [← hM, ← hspan, Ideal.map_span, ← Set.range_comp]
    rfl
