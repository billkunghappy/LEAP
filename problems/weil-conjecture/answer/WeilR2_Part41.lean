    have f1 := (hQ8 _ (hxu x) hxm).2.1
    have f2 := (hQ8 _ (hxu x') hxm').2.1
    have e2 : Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x =
