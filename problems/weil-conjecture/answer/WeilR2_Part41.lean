      obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (Y.presheaf.stalk w)) (φ p)
      have hb0 : (b : Y.presheaf.stalk w) ≠ 0 := nonZeroDivisors.ne_zero b.2
