    have hloc : IsLocalization.AtPrime (X.presheaf.stalk g) (hU.primeIdealOf ⟨g, hgU⟩).asIdeal :=
      hU.isLocalization_stalk ⟨g, hgU⟩
    obtain ⟨p, hp⟩ := IsLocalization.surj (hU.primeIdealOf ⟨g, hgU⟩).asIdeal.primeCompl b
    have hu := IsLocalization.map_units (X.presheaf.stalk g)
      (M := (hU.primeIdealOf ⟨g, hgU⟩).asIdeal.primeCompl) p.2
    refine ⟨(X.presheaf.germ U x hx).hom p.1, (X.presheaf.germ U x hx).hom p.2, ?_, ?_⟩
    · rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
      exact hu
    · rw [TopCat.Presheaf.germ_stalkSpecializes_apply, TopCat.Presheaf.germ_stalkSpecializes_apply]
      exact hp
  set φ := (X.presheaf.stalkSpecializes hg).hom with hφ
  have crit : ∀ a : X.presheaf.stalk x,
      a ∈ RingHom.ker (X.presheaf.stalkSpecializes hg ≫ X.residue g).hom ↔ ¬ IsUnit (φ a) := by
    intro a
    rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply]
    show IsLocalRing.residue _ (φ a) = 0 ↔ _
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, ?_⟩
  intro b hb
  obtain ⟨r, s, hs, hbs⟩ := s2 b
  by_cases hr : IsUnit (φ r)
  · rw [← hbs] at hr
    exact (isUnit_of_mul_isUnit_left hr).exists_right_inv
  · exfalso
    obtain ⟨t, ht, htr⟩ := s1 _ hred _ hmin r ((crit r).mpr hr)
    have hφt : IsUnit (φ t) := by
      by_contra h
      exact ht ((crit t).mpr h)
    have h1 : φ t * φ r = 0 := by rw [← map_mul, htr, map_zero]
    have h2 : φ r = 0 := (IsUnit.mul_right_eq_zero hφt).mp h1
    rw [h2] at hbs
    exact hb ((IsUnit.mul_left_eq_zero hs).mp hbs)

theorem wcpa_dj_nccw_gntsl_axis_minimal : ∀ (R : Type u) [CommRing R] [IsDomain R] (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (eZ : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (π₀ π₁ : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries R), π₀ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = PowerSeries.X → π₀ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0 → π₁ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0 → π₁ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = PowerSeries.X → (∀ P : Ideal (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), P.IsPrime → RingHom.ker π₀ ≤ P ∨ RingHom.ker π₁ ≤ P) → RingHom.ker ((π₀.comp eZ.toRingHom).comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))) ∈ minimalPrimes O ∧ RingHom.ker ((π₁.comp eZ.toRingHom).comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))) ∈ minimalPrimes O :=
by
  intro R _ _ O _ _ _ eZ π₀ π₁ h00 h01 h10 h11 H
  classical
  have := AdicCompletion.flat_of_isNoetherian (R := O) (IsLocalRing.maximalIdeal O)
  have key : ∀ (πa πb : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries R),
      (∀ P : Ideal (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        P.IsPrime → RingHom.ker πa ≤ P ∨ RingHom.ker πb ≤ P) →
      ¬ (RingHom.ker πb ≤ RingHom.ker πa) →
      RingHom.ker ((πa.comp eZ.toRingHom).comp
        (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))) ∈ minimalPrimes O := by
    intro πa πb Hab hsep
    set Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal O) O) :=
      RingHom.ker (πa.comp eZ.toRingHom) with hQdef
    have hQp : Q.IsPrime := RingHom.ker_isPrime _
    have hPQ : RingHom.ker ((πa.comp eZ.toRingHom).comp
        (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))) = Q.under O := by
      ext a
      simp [Q, Ideal.under_def, RingHom.mem_ker]
    rw [hPQ]
    have hPp : (Q.under O).IsPrime := Ideal.IsPrime.under O Q
    refine ⟨⟨hPp, bot_le⟩, fun q hq hle => ?_⟩
    by_cases hqe : q = Q.under O
    · exact hqe ▸ le_rfl
    have : q.IsPrime := hq.1
    obtain ⟨Q', hQ'le, hQ'p, hQ'lo⟩ :=
      Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt Q (lt_of_le_of_ne hle hqe)
    let J := Ideal.comap eZ.symm.toRingHom Q'
    have hJp : J.IsPrime := Ideal.IsPrime.comap _
    have hJle : J ≤ RingHom.ker πa := fun c hc => by
      have h1 : eZ.symm.toRingHom c ∈ Q := hQ'le (Ideal.mem_comap.mp hc)
      have h2 := RingHom.mem_ker.mp h1
      rw [RingHom.mem_ker]
      simpa using h2
    rcases Hab J hJp with h | h
    · have hQQ' : Q ≤ Q' := fun b hb => by
        have hb' := RingHom.mem_ker.mp hb
        have h2 : eZ b ∈ J := h (RingHom.mem_ker.mpr (by simpa using hb'))
        have h3 := Ideal.mem_comap.mp h2
        simpa using h3
      rw [hQ'lo.over]
      exact Ideal.comap_mono hQQ'
    · exact absurd (h.trans hJle) hsep
  refine ⟨key π₀ π₁ H ?_, key π₁ π₀ (fun P hP => (H P hP).symm) ?_⟩
  · intro h
    have h1 := h (show Ideal.Quotient.mk _ (MvPowerSeries.X 0) ∈ RingHom.ker π₁ from h10)
    rw [RingHom.mem_ker, h00] at h1
    exact PowerSeries.X_ne_zero h1
  · intro h
    have h1 := h (show Ideal.Quotient.mk _ (MvPowerSeries.X 1) ∈ RingHom.ker π₀ from h01)
    rw [RingHom.mem_ker, h11] at h1
    exact PowerSeries.X_ne_zero h1

theorem wcpa_dj_nccw_gntsl_separate : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z), IsFinite ν → ∀ (x : Z) (w w' : S), ν w = x → ν w' = x → IsClosed ({w} : Set S) → IsClosed ({w'} : Set S) → w ≠ w' → ∃ (U : Z.Opens) (_ : x ∈ U) (c : Γ(S, ν ⁻¹ᵁ U)), (∀ hw : w ∈ ν ⁻¹ᵁ U, (S.presheaf.germ (ν ⁻¹ᵁ U) w hw).hom c ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk w)) ∧ (∀ hw' : w' ∈ ν ⁻¹ᵁ U, (S.presheaf.germ (ν ⁻¹ᵁ U) w' hw').hom (1 - c) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk w')) ∧ ∃ P : Polynomial Γ(Z, U), P.Monic ∧ P.eval₂ (ν.app U).hom c = 0 :=
by
  intro S Z ν hfin x w w' hwx hw'x hwcl hw'cl hne
  have : IsFinite ν := hfin
  obtain ⟨U, hU, hxU, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (show x ∈ (⊤ : Z.Opens) from trivial)
  have hV : IsAffineOpen (ν ⁻¹ᵁ U) := hU.preimage ν
  have hw : w ∈ ν ⁻¹ᵁ U := by rw [Scheme.Hom.mem_preimage, hwx]; exact hxU
  have hw' : w' ∈ ν ⁻¹ᵁ U := by rw [Scheme.Hom.mem_preimage, hw'x]; exact hxU
  have key : ∀ (y : S) (hy : y ∈ ν ⁻¹ᵁ U) (f : Γ(S, ν ⁻¹ᵁ U)),
      f ∈ (hV.primeIdealOf ⟨y, hy⟩).asIdeal →
      (S.presheaf.germ (ν ⁻¹ᵁ U) y hy).hom f ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk y) := by
    intro y hy f hf
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    have h1 : y ∈ S.basicOpen f := (Scheme.mem_basicOpen _ _ _ hy).mpr hunit
    have h2 := hV.fromSpec_preimage_basicOpen f
    have h3 : hV.fromSpec.base (hV.primeIdealOf ⟨y, hy⟩) ∈ S.basicOpen f := by
      rw [hV.fromSpec_primeIdealOf]; exact h1
    have h4 := (SetLike.ext_iff.mp h2 (hV.primeIdealOf ⟨y, hy⟩)).mp h3
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h4 hf
  have hmax := hV.primeIdealOf_isMaximal_of_isClosed (x := ⟨w, hw⟩) hwcl
  have hmax' := hV.primeIdealOf_isMaximal_of_isClosed (x := ⟨w', hw'⟩) hw'cl
  have hpne : (hV.primeIdealOf ⟨w, hw⟩).asIdeal ≠ (hV.primeIdealOf ⟨w', hw'⟩).asIdeal := by
    intro heq
    apply hne
    have e : hV.primeIdealOf ⟨w, hw⟩ = hV.primeIdealOf ⟨w', hw'⟩ := PrimeSpectrum.ext heq
    have e1 := hV.fromSpec_primeIdealOf ⟨w, hw⟩
    have e2 := hV.fromSpec_primeIdealOf ⟨w', hw'⟩
    rw [e] at e1
    exact e1.symm.trans e2
  have hcop := Ideal.IsMaximal.coprime_of_ne hmax hmax' hpne
  have h1mem : (1 : Γ(S, ν ⁻¹ᵁ U)) ∈ (hV.primeIdealOf ⟨w, hw⟩).asIdeal ⊔
      (hV.primeIdealOf ⟨w', hw'⟩).asIdeal := by
    rw [hcop]; exact Submodule.mem_top
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1mem
  have hb' : 1 - a = b := by rw [← hab]; ring
  have hfinapp := ν.finite_app U hU
  have hint := hfinapp.to_isIntegral
  refine ⟨U, hxU, a, fun hw₀ => key w hw₀ a ha, fun hw₀ => ?_, hint a⟩
  rw [hb']
  exact key w' hw₀ b hb

theorem wcpa_dj_nccw_gntsl_common_fraction : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z) (s₀ : S) (x : Z) (hg : ν s₀ ⤳ x), IsIso (ν.stalkMap s₀) → ∀ (U : Z.Opens) (hs : s₀ ∈ ν ⁻¹ᵁ U) (c : Γ(S, ν ⁻¹ᵁ U)), ∃ x₀ t : Z.presheaf.stalk x, IsUnit ((Z.presheaf.stalkSpecializes hg).hom t) ∧ (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom t) * (S.presheaf.germ (ν ⁻¹ᵁ U) s₀ hs).hom c = (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom x₀) :=
by
  intro S Z ν s₀ x hg hiso U hs c
  haveI := hiso
  have ha : (ν.stalkMap s₀).hom ((inv (ν.stalkMap s₀)).hom
      ((S.presheaf.germ (ν ⁻¹ᵁ U) s₀ hs).hom c)) = (S.presheaf.germ (ν ⁻¹ᵁ U) s₀ hs).hom c := by
    rw [← CommRingCat.comp_apply, IsIso.inv_hom_id, CommRingCat.id_apply]
  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (X := Z) (U := ⊤) (x := x) trivial
  have hξW : ν s₀ ∈ W := hg.mem_open W.isOpen hxW
  letI : Algebra Γ(Z, W) (Z.presheaf.stalk (ν s₀)) := (Z.presheaf.germ W (ν s₀) hξW).hom.toAlgebra
  haveI hloc : IsLocalization.AtPrime (Z.presheaf.stalk (ν s₀))
      (hW.primeIdealOf ⟨ν s₀, hξW⟩).asIdeal := hW.isLocalization_stalk ⟨ν s₀, hξW⟩
  obtain ⟨⟨r, m⟩, hrm⟩ := IsLocalization.surj (hW.primeIdealOf ⟨ν s₀, hξW⟩).asIdeal.primeCompl
    ((inv (ν.stalkMap s₀)).hom ((S.presheaf.germ (ν ⁻¹ᵁ U) s₀ hs).hom c))
  have hunit := IsLocalization.map_units (Z.presheaf.stalk (ν s₀)) m
  change _ * (Z.presheaf.germ W (ν s₀) hξW).hom (m : Γ(Z, W)) =
    (Z.presheaf.germ W (ν s₀) hξW).hom r at hrm
  change IsUnit ((Z.presheaf.germ W (ν s₀) hξW).hom (m : Γ(Z, W))) at hunit
  have e1 : ∀ y : Γ(Z, W), (Z.presheaf.stalkSpecializes hg).hom ((Z.presheaf.germ W x hxW).hom y) =
      (Z.presheaf.germ W (ν s₀) hξW).hom y := by
    intro y
    rw [← CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes]
  refine ⟨(Z.presheaf.germ W x hxW).hom r, (Z.presheaf.germ W x hxW).hom (m : Γ(Z, W)), ?_, ?_⟩
  · rw [e1]; exact hunit
  · rw [e1, e1, ← ha, ← map_mul, mul_comm, hrm]

theorem wcpa_dj_nccw_gntsl_transfer : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z) (s₀ w : S) (x : Z) (h : ν w = x) (hs : s₀ ⤳ w) (hg : ν s₀ ⤳ x), RingHom.ker (S.presheaf.stalkSpecializes hs ≫ S.residue s₀).hom = ⊥ → IsDomain (S.presheaf.stalk w) → ∀ (U : Z.Opens) (hx : x ∈ U) (hw : w ∈ ν ⁻¹ᵁ U) (hs₀ : s₀ ∈ ν ⁻¹ᵁ U) (c : Γ(S, ν ⁻¹ᵁ U)) (x₀ t : Z.presheaf.stalk x), IsUnit ((Z.presheaf.stalkSpecializes hg).hom t) → (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom t) * (S.presheaf.germ (ν ⁻¹ᵁ U) s₀ hs₀).hom c = (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom x₀) → ((Z.presheaf.stalkCongr (Inseparable.of_eq h.symm)).hom ≫ ν.stalkMap w).hom t ≠ 0 ∧ ((Z.presheaf.stalkCongr (Inseparable.of_eq h.symm)).hom ≫ ν.stalkMap w).hom t * (S.presheaf.germ (ν ⁻¹ᵁ U) w hw).hom c = ((Z.presheaf.stalkCongr (Inseparable.of_eq h.symm)).hom ≫ ν.stalkMap w).hom x₀ ∧ ((Z.presheaf.stalkCongr (Inseparable.of_eq h.symm)).hom ≫ ν.stalkMap w).hom.comp (Z.presheaf.germ U x hx).hom = (S.presheaf.germ (ν ⁻¹ᵁ U) w hw).hom.comp (ν.app U).hom :=
by
  intro S Z ν s₀ w x h hs hg hK _ U hx hw hs₀ c x₀ t hunit hR
  subst h
  simp only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
    Category.id_comp]
  have hinj : Function.Injective (S.presheaf.stalkSpecializes hs).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hmem : a ∈ RingHom.ker (S.presheaf.stalkSpecializes hs ≫ S.residue s₀).hom := by
      rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply, ha, map_zero]
    rw [hK] at hmem
    exact (Submodule.mem_bot _).mp hmem
  have N1 : ∀ y : Z.presheaf.stalk (ν w),
      (S.presheaf.stalkSpecializes hs).hom ((ν.stalkMap w).hom y) =
        (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom y) := by
    intro y
    have e := RingHom.congr_fun
      (congrArg CommRingCat.Hom.hom (Scheme.Hom.stalkSpecializes_stalkMap ν s₀ w hs)) y
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    exact e.symm
  have N2 : (S.presheaf.stalkSpecializes hs).hom ((S.presheaf.germ (ν ⁻¹ᵁ U) w hw).hom c) =
      (S.presheaf.germ (ν ⁻¹ᵁ U) s₀ hs₀).hom c := by
    have e := RingHom.congr_fun
      (congrArg CommRingCat.Hom.hom
        (TopCat.Presheaf.germ_stalkSpecializes S.presheaf (U := ν ⁻¹ᵁ U) hw hs)) c
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    exact e
  refine ⟨?_, ?_, ?_⟩
  · intro h0
    have e := N1 t
    rw [h0, map_zero] at e
    exact not_isUnit_zero (e ▸ hunit.map (ν.stalkMap s₀).hom)
  · apply hinj
    rw [map_mul, N1, N1, N2]
    exact hR
  · have e := congrArg CommRingCat.Hom.hom (Scheme.Hom.germ_stalkMap ν U w hx)
    simp only [CommRingCat.hom_comp] at e
    exact e

theorem wcpa_dj_nccw_gnts_fibre_le_two : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ x' : Z', u' x' = IsLocalRing.closedPoint R → IsClosed ({x'} : Set Z') → ¬ nccwSm u' x' → ∀ eZ : AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk x')) (Z'.presheaf.stalk x') ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), eZ.toRingHom.comp ((algebraMap (Z'.presheaf.stalk x') (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk x')) (Z'.presheaf.stalk x'))).comp ((Z'.presheaf.germ ⊤ x' trivial).hom.comp (wcCnSigma u' ⊤))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → ∀ w₁ w₂ w₃ : S', ν' w₁ = x' → ν' w₂ = x' → ν' w₃ = x' → w₁ = w₂ ∨ w₁ = w₃ ∨ w₂ = w₃ :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA x' hxu
    hxcl hns eZ heZ w₁ w₂ w₃ h₁ h₂ h₃
  classical

  have clash : ∀ (D T T' : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D]
      [IsLocalRing D] [CommRing T] [IsDomain T] [CommRing T'] [IsDomain T'] (θ : D →+* T)
      (θ' : D →+* T'), Function.Injective θ → Function.Injective θ' → ∀ (P : Polynomial D),
      P.Monic → ∀ (s a0 : D), s ≠ 0 → ∀ (b : T) (b' : T'), θ s * b = θ a0 → θ' s * b' = θ' a0 →
      P.eval₂ θ b = 0 → P.eval₂ θ' b' = 0 → ¬ IsUnit b → ¬ IsUnit (1 - b') → False := by
    intro D T T' _ _ _ _ _ _ _ _ θ θ' hθ hθ' P hP s a0 hs b b' hb hb' hPb hPb' hnb hnb'
    have hQa : (P.scaleRoots s).eval a0 = 0 := by
      apply hθ
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← hb, Polynomial.scaleRoots_eval₂_mul, hPb,
        mul_zero]
    have hs' : algebraMap D (FractionRing D) s ≠ 0 := by
      intro h0
      apply hs
      exact IsFractionRing.injective D (FractionRing D) (by rw [h0, map_zero])
    have hsk : algebraMap D (FractionRing D) s *
        (algebraMap D (FractionRing D) a0 / algebraMap D (FractionRing D) s) =
        algebraMap D (FractionRing D) a0 := by
      field_simp
    have hkint : IsIntegral D
        (algebraMap D (FractionRing D) a0 / algebraMap D (FractionRing D) s) := by
      refine ⟨P, hP, ?_⟩
      have e := Polynomial.scaleRoots_eval₂_mul (p := P) (algebraMap D (FractionRing D))
        (algebraMap D (FractionRing D) a0 / algebraMap D (FractionRing D) s) s
      rw [hsk, Polynomial.eval₂_at_apply, hQa, map_zero] at e
      exact (mul_eq_zero.mp e.symm).resolve_left (pow_ne_zero _ hs')
    obtain ⟨g, hg⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hkint
    have hsg : s * g = a0 := by
      apply IsFractionRing.injective D (FractionRing D)
      rw [map_mul, hg, hsk]
    have hθs : θ s ≠ 0 := fun h0 => hs (hθ (by rw [h0, map_zero]))
    have hθs' : θ' s ≠ 0 := fun h0 => hs (hθ' (by rw [h0, map_zero]))
    have hgb : θ g = b := mul_left_cancel₀ hθs (by rw [← map_mul, hsg, hb])
    have hgb' : θ' g = b' := mul_left_cancel₀ hθs' (by rw [← map_mul, hsg, hb'])
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self g with hu | hu
    · exact hnb (hgb ▸ hu.map θ)
    · apply hnb'
      rw [← hgb', ← map_one θ', ← map_sub]
      exact hu.map θ'

  obtain ⟨hcomp, -, -, hH, hS⟩ := id hA
  obtain ⟨_, _, hst', _⟩ := hH
  obtain ⟨_, hQ2, hQ3, _, _, _, _, _, _, _, _, _, hQ13, _⟩ := hS
  have hν'fin : IsFinite ν' := hQ2.2.1
  have hS'dom := hQ3.2.1
  haveI : IsProper u' := hst'.1.2.1
  haveI : IsLocallyNoetherian Z' := LocallyOfFiniteType.isLocallyNoetherian u'
  have hOred := (wcpa_dj_nccw_ebnb_stalk_q2_facts R hcomp (Z'.presheaf.stalk x') eZ).1
  obtain ⟨hDd, hDic⟩ := (nccwff_model_rings_normal R hcomp).1
  haveI := hDd
  haveI := hDic
  obtain ⟨π₀, π₁, hs₀, hs₁, hC₀, hC₁, h0x, h0y, h1x, h1y, hprime, -⟩ :=
    wcpa_dj_nccw_ebnb_q2_axes R
  obtain ⟨hmin₀, hmin₁⟩ := wcpa_dj_nccw_gntsl_axis_minimal R (Z'.presheaf.stalk x') eZ π₀ π₁
