  have hθf : wcpaLqTheta g ι s σ hs ≫ Limits.pullback.fst g (ι ≫ g) = Limits.pullback.fst g s := by
    unfold wcpaLqTheta; exact Limits.pullback.lift_fst _ _ _
  have hδf : wcpaLqDelta g ι ≫ Limits.pullback.fst g (ι ≫ g) = ι := by
    unfold wcpaLqDelta; exact Limits.pullback.lift_fst _ _ _
  have hcj : Spec.map (CommRingCat.ofHom χ) ≫ j = τ := by
