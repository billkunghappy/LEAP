      a ∈ Ideal.span {s} := by
    intro a s y hy
    have hH : IsHausdorff (IsLocalRing.maximalIdeal R) (R ⧸ Ideal.span {s}) := inferInstance
    have key : ∀ n : ℕ, ∃ c : R, a - s * c ∈ (IsLocalRing.maximalIdeal R) ^ n := by
      intro n
      obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n y)
      refine ⟨c, ?_⟩
      have h1 := congrArg (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n) hy
      rw [map_mul, AlgHom.commutes, AlgHom.commutes, ← hc, Ideal.Quotient.algebraMap_eq,
        ← map_mul] at h1
      exact Ideal.Quotient.eq.mp h1.symm
    have h0 : (Submodule.Quotient.mk a : R ⧸ Ideal.span {s}) = 0 := by
      apply hH.haus
      intro n
      obtain ⟨c, hc⟩ := key n
      have e : (Submodule.Quotient.mk a : R ⧸ Ideal.span {s}) =
          (a - s * c) • Submodule.Quotient.mk 1 := by
        rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.eq]
        have : a - (a - s * c) = c * s := by ring
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self s)
      rw [e]
      exact SModEq.zero.mpr (Submodule.smul_mem_smul hc Submodule.mem_top)
    exact (Submodule.Quotient.mk_eq_zero _).mp h0
  refine ⟨hinj, hRdom, ?_⟩

  rw [isIntegrallyClosed_iff (FractionRing R)]
  intro x hx
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors R) x
  have hspec := IsLocalization.mk'_spec' (FractionRing R) a s
  set x := IsLocalization.mk' (FractionRing R) a s with hxdef
  let j : FractionRing R →+* FractionRing (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
