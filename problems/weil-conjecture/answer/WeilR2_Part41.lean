          Spec.map (CommRingCat.ofHom (wcpaBscEval K σ V h)) ≫
            Spec.map ((wcpaLqDelta g ι).appLE Ω V hVΩ) := by
        rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        have : χ.comp (Algebra.TensorProduct.includeRight : Γ(wcpaLqY g ι, Ω) →ₐ[Γ(S, V)]
            TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω)).toRingHom =
