            IsLocalRing.ResidueField M)) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) =
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue M)) ≫
            Spec.map (CommRingCat.ofHom ψ) := by
        rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
