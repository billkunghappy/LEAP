          π V (r • x) j = (X.presheaf.map (homOfLE (inf_le_left : V ⊓ L.V j ≤ V)).op).hom r * π V x j) ∧
        (∀ (V W : X.Opens) (hWV : W ≤ V) (x : Γ(G, V)) (j : Fin L.m),
