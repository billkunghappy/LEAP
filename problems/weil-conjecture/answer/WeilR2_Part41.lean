    intro σ' hσ'
    subst hσ'
    subst hs
    refine ⟨Limits.pullbackLeftPullbackSndIso g (ι ≫ g) _,
      Limits.pullbackLeftPullbackSndIso_hom_snd _ _ _, ?_⟩
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, wcpaLqTheta, Limits.pullback.lift_fst,
        Limits.pullbackLeftPullbackSndIso_hom_fst]
    · rw [Category.assoc, wcpaLqTheta, Limits.pullback.lift_snd, ← Category.assoc,
