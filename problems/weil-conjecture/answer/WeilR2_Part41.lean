      (fun x y hy z hz => by
        obtain ⟨hΦ, hcl', hwu, hdom⟩ := hH1 x
        rw [hΦ] at hy hz ⊢
        exact wcpa_dj_nccw_fibre_walk R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q'
          st zk η₀ η ηZ hA (w x) hcl' hwu hdom y hy z hz)
      hH3
      (fun x x' hpx => by
        obtain ⟨hne', hpx', hw', hor⟩ := hH4 x x' hpx
        refine ⟨hne', hpx', by rw [(hH1 x').1, (hH1 x).1, hw'], ?_⟩
        rcases hor with hnc | ⟨hDD, hdd⟩
        · intro hc
          apply hnc
          obtain ⟨s, L, pp, c1, c2, c3, c4, c5⟩ := hc
          refine ⟨s, L, pp, c1, c2, ?_, ?_, c5⟩
          · rw [Set.mem_singleton_iff.mp c3]; exact (hH2 x).2.1
          · rw [Set.mem_singleton_iff.mp c4]; exact (hH2 x').2.1
