  haveI hfa : IsAffineHom (Limits.pullback.fst uu (S.fromSpecStalk y)) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip ‹_›
  have hpull : ∀ {Y' : Scheme.{u}} (h : Y' ⟶ Z), (∀ a, IsAffineOpen (h ⁻¹ᵁ L.V a)) →
      wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' h hA
    have key : ∀ (U V : Z.Opens) (r : V ≤ U) (O : Y'.Opens) (s2 : O ≤ h ⁻¹ᵁ V) (P : Y'.Opens)
        (i : P ⟶ h ⁻¹ᵁ U) (j : O ⟶ P) (x : Γ(Z, U)),
        (Y'.presheaf.map j.op).hom ((Y'.presheaf.map i.op).hom ((h.app U).hom x)) =
          (h.appLE V O s2).hom ((Z.presheaf.map (homOfLE r).op).hom x) := by
      intro U V r O s2 P i j x
      have e : h.app U ≫ Y'.presheaf.map i.op ≫ Y'.presheaf.map j.op =
          Z.presheaf.map (homOfLE r).op ≫ h.appLE V O s2 := by
        rw [← Functor.map_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
          Scheme.Hom.map_appLE]
      have e2 := congrArg (fun φ => φ.hom x) e
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e2
    refine ⟨hA, ?_, ?_, ?_⟩
    · show (⨆ a, h ⁻¹ᵁ L.V a) = ⊤
      rw [← Scheme.Hom.preimage_iSup, hL.2.1, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hL.2.2.1 a, map_one]
    · rintro (a : Fin L.m) (b : Fin L.m) (c : Fin L.m)
      have s2 : h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
        fun _ hx => hx
      have e := congrArg (h.appLE _ _ s2).hom (hL.2.2.2 a b c)
      rw [map_mul,
        ← key (L.V a ⊓ L.V b) _ _ _ s2 (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b) (homOfLE fun _ hx => hx)
          (homOfLE inf_le_left),
        ← key (L.V b ⊓ L.V c) _ _ _ s2 (h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c) (homOfLE fun _ hx => hx)
          (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right)),
        ← key (L.V a ⊓ L.V c) _ _ _ s2 (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V c) (homOfLE fun _ hx => hx)
          (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right))] at e
      exact e
  have hLB := hpull (Limits.pullback.fst uu (S.fromSpecStalk y)) (fun a => (hL.1 a).preimage _)
  have hpairZ : ∀ a b, IsAffineOpen (L.V a ⊓ L.V b) := by
    intro a b
    haveI : IsAffine (L.V a).toScheme := hL.1 a
    haveI : IsAffineHom (L.V a).ι := IsAffineHom.of_comp _ (uu ≫ sS)
    have h1 := ((hL.1 b).preimage (L.V a).ι).image_of_isOpenImmersion (L.V a).ι
    rwa [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h1
  have hpairB : ∀ a b, IsAffineOpen
      ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V b) := by
    intro a b
    show IsAffineOpen (Limits.pullback.fst uu (S.fromSpecStalk y) ⁻¹ᵁ L.V a ⊓
      Limits.pullback.fst uu (S.fromSpecStalk y) ⁻¹ᵁ L.V b)
    rw [← Scheme.Hom.preimage_inf]
    exact (hpairZ a b).preimage _
  exact core (S.presheaf.stalk y) inferInstance (IsLocalRing.maximalIdeal (S.presheaf.stalk y))
    (Limits.pullback uu (S.fromSpecStalk y)) hXn (Limits.pullback.snd uu (S.fromSpecStalk y)) hqp
    (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L) hLB hpairB d

theorem wcpa_dj_lcp_ls_fibre_transport : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L → ∀ (y : S),
    ∃ ρ : ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecStalk y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a) →
        Γ(Limits.pullback uu (S.fromSpecResidueField y),
          (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
            Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤),
      (∀ (d : ℕ) (τ : ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecResidueField y),
          (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
            Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤)),
        wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L)
          (Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤) d τ →
        ∃ x : ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecStalk y),
            (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a),
          wcpaDjCompatMod (Limits.pullback.snd uu (S.fromSpecStalk y))
            (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L)
            (IsLocalRing.maximalIdeal (S.presheaf.stalk y)) d x ∧
          ∀ a, ρ a (x a) = τ a) ∧
      (∀ (a : Fin L.m) (x x' : Γ(Limits.pullback uu (S.fromSpecStalk y),
          (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a)),
        x' - x ∈ Ideal.map (wcCnSigma (Limits.pullback.snd uu (S.fromSpecStalk y))
          ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a))
          (IsLocalRing.maximalIdeal (S.presheaf.stalk y)) → ρ a x' = ρ a x) ∧
      (∀ (N : S.Opens) (a : Fin L.m) (σ : Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N))
        (s : Γ(Limits.pullback uu (S.fromSpecStalk y),
          (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a)), y ∈ N →
        (∃ hle : (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a ≤
            Limits.pullback.fst uu (S.fromSpecStalk y) ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N),
          (Scheme.Hom.appLE (Limits.pullback.fst uu (S.fromSpecStalk y)) (L.V a ⊓ uu ⁻¹ᵁ N)
            ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a) hle).hom σ = s) →
        wcpaDjFibRes uu y L N a σ (ρ a s)) :=
by
  intro k _ S Z sS hS uu huu L hL y
  classical
  haveI : IsProper uu := huu
  haveI : IsSeparated sS := by
    obtain ⟨Nn, jP, hjP, hjPeq⟩ := hS
    haveI := hjP
    rw [← hjPeq]
    infer_instance

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X X₀ : Scheme.{u})
      (h : X ⟶ Spec (.of B)) (i : X₀ ⟶ X) (h₀ : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
      ∀ W : X.Opens, IsAffineOpen W → Function.Surjective (i.app W).hom ∧
        RingHom.ker (i.app W).hom = Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) := by
    intro B _ _ X X₀ h i h₀ hpb W hW
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    haveI : IsClosedImmersion i :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip ‹_›
    refine ⟨Scheme.Hom.app_surjective i W hW, le_antisymm ?_ ?_⟩
    ·
      intro r hr
      set I := Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) with hI
      let q : Γ(X, W) →+* Γ(X, W) ⧸ I := Ideal.Quotient.mk I
      let qκ : IsLocalRing.ResidueField B →+* Γ(X, W) ⧸ I :=
        Ideal.quotientMap I (wcCnSigma h W) Ideal.le_comap_map
      set t : Spec (.of (Γ(X, W) ⧸ I)) ⟶ X := Spec.map (CommRingCat.ofHom q) ≫ hW.fromSpec
        with ht_def
      have ht : t ≫ h = Spec.map (CommRingCat.ofHom qκ) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := by
        rw [ht_def, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec h (isAffineOpen_top _) hW
          le_top, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp,
          ← Spec.map_comp, ← Spec.map_comp]
        congr 1
      let t' := hpb.lift t (Spec.map (CommRingCat.ofHom qκ)) ht
      have ht' : t' ≫ i = t := hpb.lift_fst _ _ _
      have e : ⊤ ≤ t ⁻¹ᵁ W := by
        intro x _
        have : Spec.map (CommRingCat.ofHom q) x ∈ hW.fromSpec ⁻¹ᵁ W := by
          rw [hW.fromSpec_preimage_self]; trivial
        exact this
      have hzero : ∀ (φ : Spec (.of (Γ(X, W) ⧸ I)) ⟶ X) (_ : t' ≫ i = φ) (e' : ⊤ ≤ φ ⁻¹ᵁ W),
          (φ.appLE W ⊤ e').hom r = 0 := by
        rintro φ rfl e'
        rw [← Scheme.Hom.appLE_comp_appLE t' i W (i ⁻¹ᵁ W) ⊤ le_rfl e', CommRingCat.comp_apply,
          ← Scheme.Hom.app_eq_appLE]
        rw [RingHom.mem_ker.mp hr, map_zero]
      have hcomp : t.appLE W ⊤ e =
          CommRingCat.ofHom q ≫ (Scheme.ΓSpecIso (.of (Γ(X, W) ⧸ I))).inv := by
        rw [Scheme.ΓSpecIso_inv_naturality, Scheme.Hom.comp_appLE, hW.fromSpec_app_self,
          Category.assoc]
        congr 1
      have h1 := hzero t ht' e
      rw [hcomp, CommRingCat.comp_apply] at h1
      have h2 : q r = 0 := by
        have := congrArg (Scheme.ΓSpecIso (.of (Γ(X, W) ⧸ I))).hom.hom h1
        rwa [Iso.inv_hom_id_apply, map_zero] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
    ·
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have e1 : X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ i.app W =
          i.appTop ≫ X₀.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ W ≤ ⊤)).op :=
        Scheme.Hom.naturality _ _
      have e2 : h.appTop ≫ i.appTop =
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))).appTop ≫ h₀.appTop := by
        rw [← Scheme.Hom.comp_appTop, hpb.w, Scheme.Hom.comp_appTop]
      have e3 : (Scheme.ΓSpecIso (.of B)).inv ≫
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))).appTop =
          CommRingCat.ofHom (IsLocalRing.residue B) ≫ (Scheme.ΓSpecIso _).inv :=
        (Scheme.ΓSpecIso_inv_naturality _).symm
      have e4 : (Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop ≫
          X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ i.app W =
          CommRingCat.ofHom (IsLocalRing.residue B) ≫ (Scheme.ΓSpecIso _).inv ≫ h₀.appTop ≫
            X₀.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ W ≤ ⊤)).op := by
        rw [e1, ← Category.assoc h.appTop, e2, ← Category.assoc, ← Category.assoc, e3]
        simp only [Category.assoc]
      have key := congrArg (fun φ => φ.hom b) e4
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key
      show (i.app W).hom ((X.presheaf.map (homOfLE le_top).op).hom
        (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b))) = 0
      rw [key]
      have hres : IsLocalRing.residue B b = 0 := (IsLocalRing.residue_eq_zero_iff b).mpr hb
      rw [CommRingCat.hom_ofHom, hres, map_zero, map_zero, map_zero]

  have core : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Xb Zy : Scheme.{u})
      (fB : Xb ⟶ Z) (sB : Xb ⟶ Spec (.of B)) (fY : Zy ⟶ Z)
      (sY : Zy ⟶ Spec (.of (IsLocalRing.ResidueField B))) (j : Zy ⟶ Xb),
      j ≫ fB = fY → IsPullback j sY sB (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
      (∀ a, IsAffineOpen ((wcpaDjCocPull fB L).V a)) →
      (∀ a b, IsAffineOpen ((wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b)) →
      ∃ ρ : ∀ a : Fin L.m, Γ(Xb, (wcpaDjCocPull fB L).V a) →
          Γ(Zy, (wcpaDjCocPull fY L).V a ⊓ sY ⁻¹ᵁ ⊤),
        (∀ (d : ℕ) (τ : ∀ a : Fin L.m, Γ(Zy, (wcpaDjCocPull fY L).V a ⊓ sY ⁻¹ᵁ ⊤)),
          wcpaDjCompat (wcpaDjCocPull fY L) (sY ⁻¹ᵁ ⊤) d τ →
          ∃ x : ∀ a : Fin L.m, Γ(Xb, (wcpaDjCocPull fB L).V a),
            wcpaDjCompatMod sB (wcpaDjCocPull fB L) (IsLocalRing.maximalIdeal B) d x ∧
            ∀ a, ρ a (x a) = τ a) ∧
        (∀ (a : Fin L.m) (x x' : Γ(Xb, (wcpaDjCocPull fB L).V a)),
          x' - x ∈ Ideal.map (wcCnSigma sB ((wcpaDjCocPull fB L).V a))
            (IsLocalRing.maximalIdeal B) → ρ a x' = ρ a x) ∧
        (∀ (N : S.Opens) (a : Fin L.m) (σ : Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N))
          (s : Γ(Xb, (wcpaDjCocPull fB L).V a)),
          (∀ x : Zy, uu (fY x) ∈ N) →
          (∃ hle : (wcpaDjCocPull fB L).V a ≤ fB ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N),
            (fB.appLE (L.V a ⊓ uu ⁻¹ᵁ N) ((wcpaDjCocPull fB L).V a) hle).hom σ = s) →
          ∃ h : (wcpaDjCocPull fY L).V a ⊓ sY ⁻¹ᵁ ⊤ ≤ fY ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N),
            (fY.appLE (L.V a ⊓ uu ⁻¹ᵁ N) ((wcpaDjCocPull fY L).V a ⊓ sY ⁻¹ᵁ ⊤) h).hom σ =
              ρ a s) := by
    intro B _ _ Xb Zy fB sB fY sY j hj hpb hWa hWab
    subst hj
    have hU : ∀ a, (wcpaDjCocPull (j ≫ fB) L).V a ⊓ sY ⁻¹ᵁ ⊤ =
        j ⁻¹ᵁ ((wcpaDjCocPull fB L).V a) := by
      intro a
      show (j ≫ fB) ⁻¹ᵁ L.V a ⊓ sY ⁻¹ᵁ ⊤ = (j ≫ fB) ⁻¹ᵁ L.V a
      rw [Scheme.Hom.preimage_top, inf_top_eq]
    have hUab : ∀ a b, (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓
        sY ⁻¹ᵁ ⊤ = j ⁻¹ᵁ ((wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b) := by
      intro a b
      show (j ≫ fB) ⁻¹ᵁ L.V a ⊓ (j ≫ fB) ⁻¹ᵁ L.V b ⊓ sY ⁻¹ᵁ ⊤ =
        (j ≫ fB) ⁻¹ᵁ L.V a ⊓ (j ≫ fB) ⁻¹ᵁ L.V b
      rw [Scheme.Hom.preimage_top, inf_top_eq]
    have hρ : ∀ (W : Xb.Opens), IsAffineOpen W → ∀ (U : Zy.Opens) (_ : U = j ⁻¹ᵁ W)
        (e : U ≤ j ⁻¹ᵁ W), Function.Surjective (j.appLE W U e).hom ∧
          RingHom.ker (j.appLE W U e).hom =
            Ideal.map (wcCnSigma sB W) (IsLocalRing.maximalIdeal B) := by
      intro W hW U hUe e
      subst hUe
      have := s1 B Xb Zy sB j sY hpb W hW
      rwa [Scheme.Hom.app_eq_appLE] at this
    have hres : ∀ (W W' : Xb.Opens) (iW : W' ≤ W) (U U' : Zy.Opens) (iU : U' ≤ U)
        (e : U ≤ j ⁻¹ᵁ W) (e' : U' ≤ j ⁻¹ᵁ W') (z : Γ(Xb, W)),
        (j.appLE W' U' e').hom ((Xb.presheaf.map (homOfLE iW).op).hom z) =
          (Zy.presheaf.map (homOfLE iU).op).hom ((j.appLE W U e).hom z) := by
      intro W W' iW U U' iU e e' z
      have : Xb.presheaf.map (homOfLE iW).op ≫ j.appLE W' U' e' =
          j.appLE W U e ≫ Zy.presheaf.map (homOfLE iU).op := by
        rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using congrArg (fun φ => φ.hom z) this
    refine ⟨fun a => (j.appLE _ _ (hU a).le).hom, ?_, ?_, ?_⟩
    ·
      intro d τ hτ
      have hsurj : ∀ a, ∃ x, (j.appLE _ _ (hU a).le).hom x = τ a :=
        fun a => (hρ _ (hWa a) _ (hU a) (hU a).le).1 (τ a)
      choose x hx using hsurj
      refine ⟨x, ?_, hx⟩
      intro a b
      obtain ⟨_, hker⟩ := hρ _ (hWab a b) _ (hUab a b) (hUab a b).le
      rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_pow]
      have e_b := hres ((wcpaDjCocPull fB L).V b)
        ((wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b) inf_le_right
        ((wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤)
        ((wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤)
        (le_inf (inf_le_left.trans inf_le_right) inf_le_right) (hU b).le (hUab a b).le (x b)
      have e_a := hres ((wcpaDjCocPull fB L).V a)
        ((wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b) inf_le_left
        ((wcpaDjCocPull (j ≫ fB) L).V a ⊓ sY ⁻¹ᵁ ⊤)
        ((wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤)
        (le_inf (inf_le_left.trans inf_le_left) inf_le_right) (hU a).le (hUab a b).le (x a)
      have eg : (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤ ≤
          (j ≫ fB) ⁻¹ᵁ (L.V a ⊓ L.V b) := fun x hx => hx.1
      have e_g : (j.appLE ((wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b)
          ((wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤)
          (hUab a b).le).hom ((wcpaDjCocPull fB L).g a b :
            Γ(Xb, (wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b)) =
          ((j ≫ fB).appLE (L.V a ⊓ L.V b)
            ((wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤)
            eg).hom (L.g a b : Γ(Z, L.V a ⊓ L.V b)) :=
        congrArg (fun φ => φ.hom (L.g a b : Γ(Z, L.V a ⊓ L.V b)))
          (Scheme.Hom.appLE_comp_appLE j fB (L.V a ⊓ L.V b)
            ((wcpaDjCocPull fB L).V a ⊓ (wcpaDjCocPull fB L).V b) _ (fun _ hx => hx)
            (hUab a b).le)
      have egY : (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ≤
          (j ≫ fB) ⁻¹ᵁ (L.V a ⊓ L.V b) := fun _ hx => hx
      have hgY : (Zy.presheaf.map (homOfLE (inf_le_left :
            (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤ ≤
              (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b)).op).hom
            ((wcpaDjCocPull (j ≫ fB) L).g a b :
              Γ(Zy, (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b)) =
          ((j ≫ fB).appLE (L.V a ⊓ L.V b)
            ((wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤)
            eg).hom (L.g a b : Γ(Z, L.V a ⊓ L.V b)) :=
        congrArg (fun φ => φ.hom (L.g a b : Γ(Z, L.V a ⊓ L.V b)))
          (Scheme.Hom.appLE_map (j ≫ fB) egY (homOfLE (inf_le_left :
            (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b ⊓ sY ⁻¹ᵁ ⊤ ≤
              (wcpaDjCocPull (j ≫ fB) L).V a ⊓ (wcpaDjCocPull (j ≫ fB) L).V b)).op)
      rw [e_b, hx b, e_a, hx a, e_g, hτ a b, map_pow, hgY]
      exact sub_self _
    ·
      intro a x x' hxx
      obtain ⟨_, hker⟩ := hρ _ (hWa a) _ (hU a) (hU a).le
      rw [← hker, RingHom.mem_ker, map_sub, sub_eq_zero] at hxx
      exact hxx
    ·
      rintro N a σ s hN ⟨hle, rfl⟩
      refine ⟨fun x hx => ⟨hx.1, hN x⟩, ?_⟩
      exact (congrArg (fun φ => φ.hom σ)
        (Scheme.Hom.appLE_comp_appLE j fB (L.V a ⊓ uu ⁻¹ᵁ N) ((wcpaDjCocPull fB L).V a) _ hle
          (hU a).le)).symm

  have hw : Limits.pullback.fst uu (S.fromSpecResidueField y) ≫ uu =
      (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫ Spec.map (S.residue y)) ≫
        S.fromSpecStalk y := by
    rw [Limits.pullback.condition, Category.assoc]; rfl
  let j : Limits.pullback uu (S.fromSpecResidueField y) ⟶ Limits.pullback uu (S.fromSpecStalk y) :=
    Limits.pullback.lift _ _ hw
  have hj : j ≫ Limits.pullback.fst uu (S.fromSpecStalk y) =
      Limits.pullback.fst uu (S.fromSpecResidueField y) := Limits.pullback.lift_fst _ _ _
  have hj2 : j ≫ Limits.pullback.snd uu (S.fromSpecStalk y) =
      Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue (S.presheaf.stalk y))) :=
    Limits.pullback.lift_snd _ _ _
  have hpb : IsPullback j (Limits.pullback.snd uu (S.fromSpecResidueField y))
      (Limits.pullback.snd uu (S.fromSpecStalk y))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue (S.presheaf.stalk y)))) := by
    refine IsPullback.of_right ?_ hj2 (IsPullback.of_hasPullback uu (S.fromSpecStalk y))
    rw [hj]
    exact IsPullback.of_hasPullback uu (S.fromSpecResidueField y)

  haveI : IsAffineHom (S.fromSpecStalk y) := IsAffineHom.of_comp _ sS
  haveI : IsAffineHom (Limits.pullback.fst uu (S.fromSpecStalk y)) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip ‹_›
  have hVab : ∀ a b, IsAffineOpen (L.V a ⊓ L.V b) := by
    intro a b
    haveI : IsAffine (L.V a).toScheme := hL.1 a
    haveI : IsAffineHom ((L.V a).ι ≫ uu ≫ sS) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (L.V a).ι := IsAffineHom.of_comp _ (uu ≫ sS)
    have h1 := ((hL.1 b).preimage (L.V a).ι).image_of_isOpenImmersion (L.V a).ι
    rwa [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h1
  have hWa : ∀ a, IsAffineOpen
      ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a) :=
    fun a => (hL.1 a).preimage _
  have hWab : ∀ a b, IsAffineOpen
      ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V b) :=
    fun a b => (hVab a b).preimage _
  haveI hlocal : IsLocalRing (S.presheaf.stalk y) := by
    first
      | infer_instance
      | exact S.toLocallyRingedSpace.isLocalRing y
      | exact AlgebraicGeometry.LocallyRingedSpace.isLocalRing _ y
  obtain ⟨ρ, hA, hB, hC⟩ := @core (S.presheaf.stalk y) _ hlocal
    (Limits.pullback uu (S.fromSpecStalk y))
    (Limits.pullback uu (S.fromSpecResidueField y)) (Limits.pullback.fst uu (S.fromSpecStalk y))
    (Limits.pullback.snd uu (S.fromSpecStalk y)) (Limits.pullback.fst uu (S.fromSpecResidueField y))
    (Limits.pullback.snd uu (S.fromSpecResidueField y)) j hj hpb hWa hWab
  refine ⟨ρ, hA, hB, fun N a σ s hyN hs => hC N a σ s (fun x => ?_) hs⟩
  have hx : uu (Limits.pullback.fst uu (S.fromSpecResidueField y) x) = y := by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
      Scheme.fromSpecResidueField_apply]
  show uu (Limits.pullback.fst uu (S.fromSpecResidueField y) x) ∈ N
  rw [hx]
  exact hyN

theorem wcpa_dj_lcp_ls_spread : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L → ∀ (y : S) (d M : ℕ)
    (s : Fin (M + 1) → ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecStalk y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a)),
    (∀ J, wcpaDjCompatMod (Limits.pullback.snd uu (S.fromSpecStalk y))
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L) ⊥ d (s J)) →
    ∃ (N : S.Opens) (σ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N)),
      y ∈ N ∧ (∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N) d (σ J)) ∧
      ∀ J a, ∃ hle : (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a ≤
          Limits.pullback.fst uu (S.fromSpecStalk y) ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N),
        (Scheme.Hom.appLE (Limits.pullback.fst uu (S.fromSpecStalk y)) (L.V a ⊓ uu ⁻¹ᵁ N)
          ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a) hle).hom (σ J a) =
          s J a :=
by
  intro k _ S Z sS hS uu huu L hL y d M s hs
  classical
  haveI := huu

  have resres : ∀ {A : Scheme.{u}} {U V W : A.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (z : Γ(A, U)),
      (A.presheaf.map (homOfLE h2).op).hom ((A.presheaf.map (homOfLE h1).op).hom z) =
        (A.presheaf.map (homOfLE (h2.trans h1)).op).hom z := by
    intro A U V W h1 h2 z
    exact congrArg (fun φ => φ.hom z) (A.presheaf.map_comp (homOfLE h1).op (homOfLE h2).op).symm
  have res_appLE : ∀ {A B : Scheme.{u}} (f : A ⟶ B) {U : B.Opens} {V V' : A.Opens}
      (e : V ≤ f ⁻¹ᵁ U) (h : V' ≤ V) (z : Γ(B, U)),
      (A.presheaf.map (homOfLE h).op).hom ((f.appLE U V e).hom z) =
        (f.appLE U V' (h.trans e)).hom z := by
    intro A B f U V V' e h z
    exact congrArg (fun φ => φ.hom z) (Scheme.Hom.appLE_map f e (homOfLE h).op)
  have appLE_res : ∀ {A B : Scheme.{u}} (f : A ⟶ B) {U U' : B.Opens} {V : A.Opens}
      (h : U' ≤ U) (e : V ≤ f ⁻¹ᵁ U') (z : Γ(B, U)),
      (f.appLE U' V e).hom ((B.presheaf.map (homOfLE h).op).hom z) =
        (f.appLE U V (e.trans (fun _ hx => h hx))).hom z := by
    intro A B f U U' V h e z
    exact congrArg (fun φ => φ.hom z) (Scheme.Hom.map_appLE f e (homOfLE h).op)
  have appLE_comp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (U : C.Opens) (V : B.Opens)
      (W : A.Opens) (e1 : V ≤ g ⁻¹ᵁ U) (e2 : W ≤ f ⁻¹ᵁ V) (z : Γ(C, U)),
      (f.appLE V W e2).hom ((g.appLE U V e1).hom z) =
        ((f ≫ g).appLE U W (fun _ hx => e1 (e2 hx))).hom z := by
    intro A B C f g U V W e1 e2 z
    exact congrArg (fun φ => φ.hom z) (Scheme.Hom.appLE_comp_appLE f g U V W e1 e2)

  have alg1 : ∀ {R : Type u} [CommRing R] (A B Sa Sb Gd Fa Fb : R), Sb - Gd * Sa = 0 →
      Sb * B = Fb → Sa * A = Fa → A * Fb - Gd * B * Fa = 0 := by
    intro R _ A B Sa Sb Gd Fa Fb h1 h2 h3
    rw [← h2, ← h3]
    linear_combination (A * B) * h1
  have alg2 : ∀ {R : Type u} [CommRing R] (x E I F : R), x * E = F → I * E = 1 → F * I = x := by
    intro R _ x E I F h1 h2
    linear_combination (-I) * h1 + x * h2
  have alg3 : ∀ {R : Type u} [CommRing R] (Ra Rb G ta tb Ia Ib : R),
      ta * Rb - G * tb * Ra = 0 → Ia * ta = 1 → Ib * tb = 1 → Rb * Ib = G * (Ra * Ia) := by
    intro R _ Ra Rb G ta tb Ia Ib h1 h2 h3
    linear_combination (Ia * Ib) * h1 - (Rb * Ib) * h2 + (G * Ra * Ia) * h3

  obtain ⟨Nn, j, hj, hjs⟩ := hS
  haveI := hj
  haveI hsep : IsSeparated sS := by rw [← hjs]; infer_instance

  have hAff2 : ∀ (V W : Z.Opens), IsAffineOpen V → IsAffineOpen W → IsAffineOpen (V ⊓ W) := by
    intro V W hV hW
    haveI : IsAffine V.toScheme := hV
    haveI : IsAffineHom V.ι := IsAffineHom.of_comp V.ι (uu ≫ sS)
    have h1 := (hW.preimage V.ι).image_of_isOpenImmersion V.ι
    rwa [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h1

  obtain ⟨N₀, hN₀, hyN₀, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) (by simp)
  have hAff1 : ∀ (V : Z.Opens), IsAffineOpen V → IsAffineOpen (V ⊓ uu ⁻¹ᵁ N₀) := by
    intro V hV
    haveI : IsAffine V.toScheme := hV
    haveI : IsAffineHom (V.ι ≫ uu) := IsAffineHom.of_comp _ sS
    have h1 := (hN₀.preimage (V.ι ≫ uu)).image_of_isOpenImmersion V.ι
    rwa [Scheme.Hom.comp_preimage, Scheme.Hom.image_preimage_eq_opensRange_inf,
      Scheme.Opens.opensRange_ι] at h1
  have hTop : (⊤ : (Spec (S.presheaf.stalk y)).Opens) ≤ S.fromSpecStalk y ⁻¹ᵁ N₀ := by
    intro q _
    have h := Set.mem_range_self (f := ⇑(S.fromSpecStalk y)) q
    rw [Scheme.range_fromSpecStalk] at h
    exact h.mem_open N₀.isOpen hyN₀
  obtain ⟨p, hp⟩ : ∃ p, p = hN₀.primeIdealOf ⟨y, hyN₀⟩ := ⟨_, rfl⟩
  have hmem : ∀ t : Γ(S, N₀), t ∈ p.asIdeal.primeCompl ↔ y ∈ S.basicOpen t := by
    intro t
    letI : Algebra Γ(S, N₀) (S.presheaf.stalk y) := (S.presheaf.germ N₀ y hyN₀).hom.toAlgebra
    haveI : IsLocalization.AtPrime (S.presheaf.stalk y) p.asIdeal := by
      rw [hp]; exact hN₀.isLocalization_stalk ⟨y, hyN₀⟩
    rw [Scheme.mem_basicOpen S t y hyN₀]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff (S.presheaf.stalk y) p.asIdeal t).symm
  have hβloc : letI := ((S.fromSpecStalk y).appLE N₀ ⊤ hTop).hom.toAlgebra;
      IsLocalization p.asIdeal.primeCompl Γ(Spec (S.presheaf.stalk y), ⊤) := by
    letI algL : Algebra Γ(S, N₀) (S.presheaf.stalk y) := (S.presheaf.germ N₀ y hyN₀).hom.toAlgebra
    have hLP : IsLocalization.AtPrime (S.presheaf.stalk y) p.asIdeal := by
      rw [hp]; exact hN₀.isLocalization_stalk ⟨y, hyN₀⟩
    let eS : Γ(Spec (S.presheaf.stalk y), ⊤) ≃+* S.presheaf.stalk y :=
      (Scheme.ΓSpecIso (S.presheaf.stalk y)).commRingCatIsoToRingEquiv
    have h2 := (IsLocalization.isLocalization_iff_of_ringEquiv p.asIdeal.primeCompl eS.symm).mp hLP
    have hid : ∀ (h : (⊤ : (Spec (S.presheaf.stalk y)).Opens) ≤ ⊤) (w : Γ(Spec (S.presheaf.stalk y), ⊤)),
        ((Spec (S.presheaf.stalk y)).presheaf.map (homOfLE h).op).hom w = w := by
      intro h w
      rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : (Spec (S.presheaf.stalk y)).Opens)) from rfl,
        CategoryTheory.Functor.map_id]
      rfl
    have hEq : ((S.fromSpecStalk y).appLE N₀ ⊤ hTop).hom =
        eS.symm.toRingHom.comp (algebraMap Γ(S, N₀) (S.presheaf.stalk y)) := by
      ext z
      show ((Spec (S.presheaf.stalk y)).presheaf.map (homOfLE hTop).op).hom
          (((S.fromSpecStalk y).app N₀).hom z) =
        (Scheme.ΓSpecIso (S.presheaf.stalk y)).inv.hom ((S.presheaf.germ N₀ y hyN₀).hom z)
      rw [Scheme.fromSpecStalk_app hyN₀, CommRingCat.comp_apply, CommRingCat.comp_apply, resres]
      exact hid _ _
    show @IsLocalization _ _ _ _ _ (RingHom.toAlgebra _)
    rw [hEq]
    exact h2

  have s2 : ∀ {R R' S P : CommRingCat.{u}} (a : R ⟶ S) (b : R ⟶ R') (c : S ⟶ P) (d : R' ⟶ P),
      IsPushout a b c d → ∀ (M : Submonoid R), (letI : Algebra R R' := b.hom.toAlgebra;
        IsLocalization M R') → (letI : Algebra S P := c.hom.toAlgebra;
        IsLocalization (M.map a.hom) P) := by
    intro R R' S P a b c d h M hM
    letI : Algebra R S := a.hom.toAlgebra
    letI : Algebra R R' := b.hom.toAlgebra
    letI : Algebra S P := c.hom.toAlgebra
    letI : Algebra R' P := d.hom.toAlgebra
    letI : Algebra R P := (a ≫ c).hom.toAlgebra
    haveI : IsScalarTower R S P := .of_algebraMap_eq' rfl
    haveI : IsScalarTower R R' P := .of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h.w)
    have h' : Algebra.IsPushout R R' S P := CommRingCat.isPushout_iff_isPushout.mp h.flip
    exact (Algebra.isLocalization_iff_isPushout M R' (T := S) (B := P)).mpr h'.symm

  suffices main : ∀ (X : Scheme.{u}) (fst : X ⟶ Z) (snd : X ⟶ Spec (S.presheaf.stalk y)),
      IsPullback fst snd uu (S.fromSpecStalk y) →
      ∀ (s : Fin (M + 1) → ∀ a : Fin L.m, Γ(X, (wcpaDjCocPull fst L).V a)),
      (∀ J, wcpaDjCompatMod snd (wcpaDjCocPull fst L) ⊥ d (s J)) →
      ∃ (N : S.Opens) (σ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N)),
        y ∈ N ∧ (∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N) d (σ J)) ∧
        ∀ J a, ∃ hle : (wcpaDjCocPull fst L).V a ≤ fst ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N),
          (fst.appLE (L.V a ⊓ uu ⁻¹ᵁ N) ((wcpaDjCocPull fst L).V a) hle).hom (σ J a) = s J a by
    exact main _ _ _ (IsPullback.of_hasPullback _ _) s hs
  clear hs s
  intro X fst snd H s hs

  have hgen : ∀ N : S.Opens, y ∈ N → ∀ x : X, uu (fst x) ∈ N := by
    intro N hy x
    have e : uu (fst x) = S.fromSpecStalk y (snd x) := by
      simpa only [Scheme.Hom.comp_apply] using congrArg (fun φ : X ⟶ S => φ x) H.w
    rw [e]
    have h := Set.mem_range_self (f := ⇑(S.fromSpecStalk y)) (snd x)
    rw [Scheme.range_fromSpecStalk] at h
    exact h.mem_open N.isOpen hy

  have loc : ∀ (P : Z.Opens), IsAffineOpen P → ∀ (hP : P ≤ uu ⁻¹ᵁ N₀) (Q : X.Opens)
      (hQ : Q ≤ fst ⁻¹ᵁ P), fst ⁻¹ᵁ P ≤ Q →
      (∀ x : Γ(X, Q), ∃ (r : Γ(Z, P)) (t : Γ(S, N₀)), y ∈ S.basicOpen t ∧
        x * (fst.appLE P Q hQ).hom ((uu.appLE N₀ P hP).hom t) = (fst.appLE P Q hQ).hom r) ∧
      (∀ r : Γ(Z, P), (fst.appLE P Q hQ).hom r = 0 →
        ∃ t : Γ(S, N₀), y ∈ S.basicOpen t ∧ (uu.appLE N₀ P hP).hom t * r = 0) := by
    intro P hPa hP Q hQ hQ'
    have hUY : Q = fst ⁻¹ᵁ P ⊓ snd ⁻¹ᵁ ⊤ := by
      rw [Scheme.Hom.preimage_top, inf_top_eq]; exact le_antisymm hQ hQ'
    have hpo := (isIso_pushoutSection_iff H hTop hP hUY).mp
      (isIso_pushoutSection_of_isAffineOpen H hTop hP hUY hN₀ (isAffineOpen_top _) hPa)
    have hl := s2 _ _ _ _ hpo p.asIdeal.primeCompl hβloc
    letI : Algebra Γ(Z, P) Γ(X, Q) := (fst.appLE P Q hQ).hom.toAlgebra
    haveI : IsLocalization (p.asIdeal.primeCompl.map (uu.appLE N₀ P hP).hom) Γ(X, Q) := hl
    refine ⟨fun x => ?_, fun r hr => ?_⟩
    · obtain ⟨⟨r, m⟩, hm⟩ := IsLocalization.surj (p.asIdeal.primeCompl.map (uu.appLE N₀ P hP).hom) x
      obtain ⟨t, ht, htm⟩ := Submonoid.mem_map.mp m.2
      refine ⟨r, t, (hmem t).mp ht, ?_⟩
      rw [htm]; exact hm
    · obtain ⟨⟨m, hm⟩, hmr⟩ := (IsLocalization.map_eq_zero_iff
        (p.asIdeal.primeCompl.map (uu.appLE N₀ P hP).hom) Γ(X, Q) r).mp hr
      obtain ⟨t, ht, rfl⟩ := Submonoid.mem_map.mp hm
      exact ⟨t, (hmem t).mp ht, hmr⟩

  have hQP : ∀ a, (wcpaDjCocPull fst L).V a ≤ fst ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N₀) :=
    fun a x hx => ⟨hx, hgen N₀ hyN₀ x⟩
  have hPQ : ∀ a, fst ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N₀) ≤ (wcpaDjCocPull fst L).V a := fun a x hx => hx.1
  have hPle : ∀ a, L.V a ⊓ uu ⁻¹ᵁ N₀ ≤ uu ⁻¹ᵁ N₀ := fun a => inf_le_right
  have hPaff : ∀ a, IsAffineOpen (L.V a ⊓ uu ⁻¹ᵁ N₀) := fun a => hAff1 _ (hL.1 a)
  have hQQ : ∀ a b, (wcpaDjCocPull fst L).V a ⊓ (wcpaDjCocPull fst L).V b ≤
      fst ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀) :=
    fun a b x hx => ⟨⟨hx.1, hx.2⟩, hgen N₀ hyN₀ x⟩
  have hQQ' : ∀ a b, fst ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀) ≤
      (wcpaDjCocPull fst L).V a ⊓ (wcpaDjCocPull fst L).V b :=
    fun a b x hx => ⟨hx.1.1, hx.1.2⟩
  have hPPle : ∀ a b, L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀ ≤ uu ⁻¹ᵁ N₀ := fun a b => inf_le_right
  have hPPa : ∀ a b, L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀ ≤ L.V a ⊓ uu ⁻¹ᵁ N₀ :=
    fun a b => inf_le_inf_right _ inf_le_left
  have hPPb : ∀ a b, L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀ ≤ L.V b ⊓ uu ⁻¹ᵁ N₀ :=
    fun a b => inf_le_inf_right _ inf_le_right
  have hPPg : ∀ a b, L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀ ≤ L.V a ⊓ L.V b := fun a b => inf_le_left
  have hPPaff : ∀ a b, IsAffineOpen (L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀) :=
    fun a b => hAff1 _ (hAff2 _ _ (hL.1 a) (hL.1 b))

  have h1 := fun J a => (loc _ (hPaff a) (hPle a) _ (hQP a) (hPQ a)).1 (s J a)
  choose r t ht hrt using h1

  obtain ⟨ε, hε⟩ : ∃ ε : ∀ (J : Fin (M + 1)) (a b : Fin L.m), Γ(Z, L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀),
      ∀ J a b, ε J a b =
        (uu.appLE N₀ _ (hPPle a b)).hom (t J a) *
          (Z.presheaf.map (homOfLE (hPPb a b)).op).hom (r J b) -
        (Z.presheaf.map (homOfLE (hPPg a b)).op).hom ((L.g a b : Γ(Z, L.V a ⊓ L.V b)) ^ d) *
          (uu.appLE N₀ _ (hPPle a b)).hom (t J b) *
          (Z.presheaf.map (homOfLE (hPPa a b)).op).hom (r J a) := ⟨_, fun _ _ _ => rfl⟩
  have hφε : ∀ J a b, (fst.appLE _ _ (hQQ a b)).hom (ε J a b) = 0 := by
    intro J a b
    have hc := hs J a b
    rw [Ideal.map_bot, Ideal.mem_bot] at hc
    have hg : (((wcpaDjCocPull fst L).g a b) :
        Γ(X, (wcpaDjCocPull fst L).V a ⊓ (wcpaDjCocPull fst L).V b)) =
        (fst.appLE (L.V a ⊓ L.V b) ((wcpaDjCocPull fst L).V a ⊓ (wcpaDjCocPull fst L).V b)
          (fun _ hx => hx)).hom (L.g a b : Γ(Z, L.V a ⊓ L.V b)) := rfl
    rw [hg] at hc
    have hb' := congrArg (X.presheaf.map (homOfLE (inf_le_right :
      (wcpaDjCocPull fst L).V a ⊓ (wcpaDjCocPull fst L).V b ≤ (wcpaDjCocPull fst L).V b)).op).hom
      (hrt J b)
    rw [map_mul, res_appLE fst, res_appLE fst, appLE_comp] at hb'
    have ha' := congrArg (X.presheaf.map (homOfLE (inf_le_left :
      (wcpaDjCocPull fst L).V a ⊓ (wcpaDjCocPull fst L).V b ≤ (wcpaDjCocPull fst L).V a)).op).hom
      (hrt J a)
    rw [map_mul, res_appLE fst, res_appLE fst, appLE_comp] at ha'
    rw [hε J a b]
    simp only [map_sub, map_mul, map_pow, appLE_comp, appLE_res]
    exact alg1 _ _ _ _ _ _ _ hc hb' ha'

  have h2 := fun J a b => (loc _ (hPPaff a b) (hPPle a b) _ (hQQ a b) (hQQ' a b)).2 (ε J a b)
    (hφε J a b)
  choose c hc hcε using h2

  obtain ⟨T, hT⟩ : ∃ T : Γ(S, N₀), T = (∏ J, ∏ a, t J a) * ∏ J, ∏ a, ∏ b, c J a b := ⟨_, rfl⟩
  have htT : ∀ J a, t J a ∣ T := fun J a => by
    rw [hT]
    exact dvd_mul_of_dvd_left (dvd_trans
      (Finset.dvd_prod_of_mem (fun a => t J a) (Finset.mem_univ a))
      (Finset.dvd_prod_of_mem (fun J => ∏ a, t J a) (Finset.mem_univ J))) _
  have hcT : ∀ J a b, c J a b ∣ T := fun J a b => by
    rw [hT]
    exact dvd_mul_of_dvd_right (dvd_trans (dvd_trans
      (Finset.dvd_prod_of_mem (fun b => c J a b) (Finset.mem_univ b))
      (Finset.dvd_prod_of_mem (fun a => ∏ b, c J a b) (Finset.mem_univ a)))
      (Finset.dvd_prod_of_mem (fun J => ∏ a, ∏ b, c J a b) (Finset.mem_univ J))) _
  have hyT : y ∈ S.basicOpen T := by
    rw [Scheme.mem_basicOpen S T y hyN₀, hT, map_mul]
    simp only [map_prod]
    refine IsUnit.mul ?_ ?_
    · exact Finset.prod_induction _ IsUnit (fun _ _ h1 h2 => h1.mul h2) isUnit_one (fun J _ =>
        Finset.prod_induction _ IsUnit (fun _ _ h1 h2 => h1.mul h2) isUnit_one (fun a _ =>
          (Scheme.mem_basicOpen S _ y hyN₀).mp (ht J a)))
    · exact Finset.prod_induction _ IsUnit (fun _ _ h1 h2 => h1.mul h2) isUnit_one (fun J _ =>
        Finset.prod_induction _ IsUnit (fun _ _ h1 h2 => h1.mul h2) isUnit_one (fun a _ =>
          Finset.prod_induction _ IsUnit (fun _ _ h1 h2 => h1.mul h2) isUnit_one (fun b _ =>
            (Scheme.mem_basicOpen S _ y hyN₀).mp (hc J a b))))
  have hunitT : ∀ (W : Z.Opens) (h : W ≤ uu ⁻¹ᵁ N₀), W ≤ uu ⁻¹ᵁ S.basicOpen T →
      IsUnit ((uu.appLE N₀ W h).hom T) := by
    intro W h hW
    have hW' : W ≤ Z.basicOpen ((uu.app N₀).hom T) := by
      rw [← Scheme.Hom.preimage_basicOpen]; exact hW
    have hu := (RingedSpace.isUnit_res_basicOpen Z.toRingedSpace ((uu.app N₀).hom T)).map
      (Z.presheaf.map (homOfLE hW').op).hom
    have e : (uu.appLE N₀ W h).hom T = (Z.presheaf.map (homOfLE hW').op).hom
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le ((uu.app N₀).hom T))).op).hom
          ((uu.app N₀).hom T)) := by
      rw [resres]; rfl
    rw [e]; exact hu
  have hunit : ∀ (W : Z.Opens) (h : W ≤ uu ⁻¹ᵁ N₀), W ≤ uu ⁻¹ᵁ S.basicOpen T →
      ∀ f : Γ(S, N₀), f ∣ T → IsUnit ((uu.appLE N₀ W h).hom f) :=
    fun W h hW f hf => isUnit_of_dvd_unit (map_dvd _ hf) (hunitT W h hW)
  have hNN₀ : uu ⁻¹ᵁ S.basicOpen T ≤ uu ⁻¹ᵁ N₀ := fun x hx => S.basicOpen_le T hx
  have hOP : ∀ a, L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ L.V a ⊓ uu ⁻¹ᵁ N₀ :=
    fun a => inf_le_inf_left _ hNN₀
  have hOle : ∀ a, L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ uu ⁻¹ᵁ N₀ := fun a => inf_le_right.trans hNN₀
  have hOu : ∀ J a, IsUnit ((uu.appLE N₀ _ (hOle a)).hom (t J a)) :=
    fun J a => hunit _ _ inf_le_right _ (htT J a)

  obtain ⟨σ, hσ⟩ : ∃ σ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T),
      ∀ J a, σ J a = (Z.presheaf.map (homOfLE (hOP a)).op).hom (r J a) *
        (((hOu J a).unit⁻¹ : (Γ(Z, L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T))ˣ) :
          Γ(Z, L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T)) := ⟨_, fun _ _ => rfl⟩
  refine ⟨S.basicOpen T, σ, hyT, ?_, ?_⟩
  ·
    intro J a b
    have hWPP : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₀ :=
      inf_le_inf_left _ hNN₀
    have hWle : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ uu ⁻¹ᵁ N₀ := inf_le_right.trans hNN₀
    have hWa : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T :=
      le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hWb : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ L.V b ⊓ uu ⁻¹ᵁ S.basicOpen T :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have hcu := hunit _ hWle inf_le_right _ (hcT J a b)
    have hε0 := congrArg (Z.presheaf.map (homOfLE hWPP).op).hom (hcε J a b)
    rw [map_mul, map_zero, res_appLE] at hε0
    have hε1 := (hcu.mul_right_eq_zero).mp hε0
    rw [hε J a b] at hε1
    simp only [map_sub, map_mul, res_appLE, resres] at hε1
    have hIa := congrArg (Z.presheaf.map (homOfLE hWa).op).hom (hOu J a).val_inv_mul
    rw [map_mul, map_one, res_appLE] at hIa
    have hIb := congrArg (Z.presheaf.map (homOfLE hWb).op).hom (hOu J b).val_inv_mul
    rw [map_mul, map_one, res_appLE] at hIb
    show (Z.presheaf.map (homOfLE hWb).op).hom (σ J b) =
      (Z.presheaf.map (homOfLE (inf_le_left :
        L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ S.basicOpen T ≤ L.V a ⊓ L.V b)).op).hom
          ((L.g a b : Γ(Z, L.V a ⊓ L.V b)) ^ d) *
      (Z.presheaf.map (homOfLE hWa).op).hom (σ J a)
    rw [hσ J a, hσ J b]
    simp only [map_mul, resres]
    exact alg3 _ _ _ _ _ _ _ hε1 hIa hIb
  ·
    intro J a
    have hle : (wcpaDjCocPull fst L).V a ≤ fst ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ S.basicOpen T) :=
      fun x hx => ⟨hx, hgen _ hyT x⟩
    refine ⟨hle, ?_⟩
    have hI := congrArg (fst.appLE _ _ hle).hom (hOu J a).val_inv_mul
    rw [map_mul, map_one, appLE_comp] at hI
    have hr := hrt J a
    rw [appLE_comp] at hr
    rw [hσ J a, map_mul, appLE_res]
    exact alg2 _ _ _ _ hr hI

theorem wcpa_dj_lcp_ra_lift_sections : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L → ∀ (y : S) (e : ℕ), 0 < e →
    wcpaDjVA (Limits.pullback.snd uu (S.fromSpecResidueField y))
      (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L) ⊤ e →
    ∃ m : ℕ, 1 ≤ m ∧ ∀ (M : ℕ)
      (τ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecResidueField y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
          Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤)),
      (∀ J, wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L)
        (Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤) (e * m) (τ J)) →
      ∃ (N : S.Opens) (σ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N)),
        y ∈ N ∧ (∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N) (e * m) (σ J)) ∧
        ∀ J a, wcpaDjFibRes uu y L N a (σ J a) (τ J a) :=
by
  intro k _ S Z sS hS uu huu L hL y e he hva
  obtain ⟨m, hm, hstep⟩ := wcpa_dj_lcp_ls_uniform_step k S Z sS hS uu huu L hL y e he hva
  obtain ⟨c, hc⟩ := wcpa_dj_lcp_ls_artin_rees_lift k S Z sS hS uu huu L hL y (e * m)
  obtain ⟨ρ, hA, hB, hC⟩ := wcpa_dj_lcp_ls_fibre_transport k S Z sS hS uu huu L hL y
  refine ⟨m, hm, ?_⟩
  intro M τ hτ
  have key : ∀ J, ∃ s : ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecStalk y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a),
      wcpaDjCompatMod (Limits.pullback.snd uu (S.fromSpecStalk y))
          (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L) ⊥ (e * m) s ∧
      ∀ a, ρ a (s a) = τ J a := by
    intro J
    obtain ⟨x0, hx0, hx0τ⟩ := hA (e * m) (τ J) (hτ J)
    have iter : ∀ n : ℕ, ∃ x : ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecStalk y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a),
        wcpaDjCompatMod (Limits.pullback.snd uu (S.fromSpecStalk y))
          (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L)
          (IsLocalRing.maximalIdeal (S.presheaf.stalk y) ^ (n + 1)) (e * m) x ∧
        ∀ a, x a - x0 a ∈ Ideal.map (wcCnSigma (Limits.pullback.snd uu (S.fromSpecStalk y))
          ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a))
          (IsLocalRing.maximalIdeal (S.presheaf.stalk y)) := by
      intro n
      induction n with
      | zero =>
        refine ⟨x0, ?_, fun a => ?_⟩
        · rw [zero_add, pow_one]; exact hx0
        · rw [sub_self]; exact Ideal.zero_mem _
      | succ n ih =>
        obtain ⟨x, hx, hxx0⟩ := ih
        obtain ⟨x', hx'x, hx'⟩ := hstep n x hx
        refine ⟨x', hx', fun a => ?_⟩
        have h1 : x' a - x a ∈ Ideal.map (wcCnSigma (Limits.pullback.snd uu (S.fromSpecStalk y))
            ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecStalk y)) L).V a))
            (IsLocalRing.maximalIdeal (S.presheaf.stalk y)) :=
          Ideal.map_mono (Ideal.pow_le_self (Nat.succ_ne_zero n)) (hx'x a)
        have h2 := Ideal.add_mem _ h1 (hxx0 a)
        rwa [sub_add_sub_cancel] at h2
    obtain ⟨x, hx, hxx0⟩ := iter c
    obtain ⟨s, hs, hsx⟩ := hc x hx
    refine ⟨s, hs, fun a => ?_⟩
    have h2 := Ideal.add_mem _ (hsx a) (hxx0 a)
    rw [sub_add_sub_cancel] at h2
    rw [hB a (x0 a) (s a) h2, hx0τ a]
  choose s hs hsτ using key
  obtain ⟨N, σ, hyN, hσ, hσs⟩ :=
    wcpa_dj_lcp_ls_spread k S Z sS hS uu huu L hL y (e * m) M s hs
  refine ⟨N, σ, hyN, hσ, fun J a => ?_⟩
  have h3 := hC N a (σ J a) (s J a) hyN (hσs J a)
  rwa [hsτ J a] at h3

theorem wcpa_dj_lcp_la_chart_morphism : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)) (uu : Z ⟶ S) (L : wcpaDjCoc Z), wcpaDjCocOK L →
    ∀ (N₁ : S.Opens) (e M : ℕ) (σ' : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N₁)),
    (∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N₁) e (σ' J)) →
    uu ⁻¹ᵁ N₁ ≤ ⨆ J, ⨆ a, Z.basicOpen (σ' J a) →
    (∀ (K : Type u) [Field K] (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) {I : Type} (U : I → X.Opens), (⨆ i, U i) = ⊤ → ∀ (s : ∀ i, Fin (n + 1) → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) → ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) → (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) = w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) → ∃ φ : X ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fX ∧ (∀ i J, φ ⁻¹ᵁ wcSgD K n J ⊓ U i = X.basicOpen (s i J)) ∧ ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J) (hOi : O ≤ U i), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) * X.presheaf.map (homOfLE hOi).op (s i J) = X.presheaf.map (homOfLE hOi).op (s i L)) →
    ∃ φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ wcProjK k M, wcpaDjLaChart k sS uu L N₁ M σ' φ :=
by
  intro k _ S Z sS uu L _hL N₁ e M σ' hC hcov Hglue
  classical
  have hD : ∀ K a, Z.basicOpen (σ' K a) ≤ L.V a ⊓ uu ⁻¹ᵁ N₁ := fun K a => Z.basicOpen_le _
  let U : Fin L.m × Fin (M + 1) → (uu ⁻¹ᵁ N₁).toScheme.Opens :=
    fun i => (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' i.2 i.1)
  have hUW : ∀ i : Fin L.m × Fin (M + 1), U i ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (L.V i.1 ⊓ uu ⁻¹ᵁ N₁) :=
    fun i x hx => hD i.2 i.1 hx
  have hUV : ∀ i j : Fin L.m × Fin (M + 1),
      U i ⊓ U j ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (L.V i.1 ⊓ L.V j.1) :=
    fun i j x hx => ⟨(hD i.2 i.1 hx.1).1, (hD j.2 j.1 hx.2).1⟩
  obtain ⟨s, hs⟩ : ∃ s : ∀ i : Fin L.m × Fin (M + 1), Fin (M + 1) → Γ((uu ⁻¹ᵁ N₁).toScheme, U i),
      ∀ i J, s i J = (uu ⁻¹ᵁ N₁).ι.appLE (L.V i.1 ⊓ uu ⁻¹ᵁ N₁) (U i) (hUW i) (σ' J i.1) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : ∀ i j : Fin L.m × Fin (M + 1), Γ((uu ⁻¹ᵁ N₁).toScheme, U i ⊓ U j),
      ∀ i j, w i j = (uu ⁻¹ᵁ N₁).ι.appLE (L.V i.1 ⊓ L.V j.1) (U i ⊓ U j) (hUV i j)
        ((L.g i.1 j.1 : Γ(Z, L.V i.1 ⊓ L.V j.1)) ^ e) :=
    ⟨_, fun _ _ => rfl⟩

  have N1 : ∀ (A : Z.Opens) (P O : (uu ⁻¹ᵁ N₁).toScheme.Opens) (hP : P ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ A)
      (hOP : O ≤ P) (x : Γ(Z, A)),
      (uu ⁻¹ᵁ N₁).toScheme.presheaf.map (homOfLE hOP).op ((uu ⁻¹ᵁ N₁).ι.appLE A P hP x) =
        (uu ⁻¹ᵁ N₁).ι.appLE A O (hOP.trans hP) x := by
    intro A P O hP hOP x
    rw [← ConcreteCategory.comp_apply, Scheme.Hom.appLE_map]
  have N2 : ∀ (A T : Z.Opens) (hTA : T ≤ A) (O : (uu ⁻¹ᵁ N₁).toScheme.Opens)
      (hO : O ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ T) (hOA : O ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ A) (x : Γ(Z, A)),
      (uu ⁻¹ᵁ N₁).ι.appLE A O hOA x =
        (uu ⁻¹ᵁ N₁).ι.appLE T O hO (Z.presheaf.map (homOfLE hTA).op x) := by
    intro A T hTA O hO hOA x
    rw [← ConcreteCategory.comp_apply, Scheme.Hom.map_appLE]

  have s1 : (⨆ i, U i) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx0 : (uu ⁻¹ᵁ N₁).ι x ∈ uu ⁻¹ᵁ N₁ := by
      first
      | exact x.2
      | simpa [Scheme.Opens.ι_apply] using x.2
    have hx : (uu ⁻¹ᵁ N₁).ι x ∈ (⨆ J, ⨆ a, Z.basicOpen (σ' J a)) := hcov hx0
    obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hJ
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(a, J), ha⟩

  have s2 : ∀ i, Ideal.span (Set.range (s i)) = ⊤ := by
    rintro ⟨a, K⟩
    refine Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨K, rfl⟩) ?_
    rw [hs]
    have hu : IsUnit (Z.presheaf.map (homOfLE (Z.basicOpen_le (σ' K a))).op (σ' K a)) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace (σ' K a)
    have hO : U (a, K) ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' K a) := le_rfl
    rw [N2 _ _ (Z.basicOpen_le (σ' K a)) _ hO]
    exact hu.map _

  have s3 : ∀ i j, IsUnit (w i j) := fun i j => by
    rw [hw]; exact ((L.g i.1 j.1).isUnit.pow e).map _

  have s4 : ∀ i j J, (uu ⁻¹ᵁ N₁).toScheme.presheaf.map
      (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
      w i j * (uu ⁻¹ᵁ N₁).toScheme.presheaf.map
        (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J) := by
    rintro ⟨a, K⟩ ⟨b, K'⟩ J
    have hT : U (a, K) ⊓ U (b, K') ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₁) :=
      fun x hx => ⟨⟨(hD K a hx.1).1, (hD K' b hx.2).1⟩, (hD K a hx.1).2⟩
    have e1 : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₁ ≤ L.V b ⊓ uu ⁻¹ᵁ N₁ :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have e2 : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₁ ≤ L.V a ⊓ L.V b := inf_le_left
    have e3 : L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₁ ≤ L.V a ⊓ uu ⁻¹ᵁ N₁ :=
      le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hc : Z.presheaf.map (homOfLE e1).op (σ' J b) =
        Z.presheaf.map (homOfLE e2).op ((L.g a b : Γ(Z, L.V a ⊓ L.V b)) ^ e) *
          Z.presheaf.map (homOfLE e3).op (σ' J a) := hC J a b
    rw [hs, hs, hw, N1, N1, N2 _ _ e1 _ hT, N2 _ _ e2 _ hT, N2 _ _ e3 _ hT, hc, map_mul]
  obtain ⟨φ, h1, h2, h3⟩ :=
    Hglue k M (uu ⁻¹ᵁ N₁).toScheme ((uu ∣_ N₁) ≫ N₁.ι ≫ sS) U s1 s s2 w s3 s4
  have hB : ∀ i J, (uu ⁻¹ᵁ N₁).toScheme.basicOpen (s i J) =
      U i ⊓ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' J i.1) := by
    intro i J
    rw [hs]
    exact Scheme.basicOpen_appLE _ _ _ _ _
  refine ⟨φ, h1, ?_, ?_⟩
  · intro J
    rw [Scheme.Hom.preimage_iSup]
    apply le_antisymm
    · intro x hx
      have hx' : x ∈ (⨆ i, U i) := by rw [s1]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
      have hmem : x ∈ φ ⁻¹ᵁ wcSgD k M J ⊓ U i := ⟨hx, hi⟩
      rw [h2, hB] at hmem
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i.1, hmem.2⟩
    · intro x hx
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      have hmem : x ∈ U (a, J) ⊓ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' J a) := ⟨ha, ha⟩
      rw [← hB (a, J) J, ← h2] at hmem
      exact hmem.1
  · intro J l a O hO h' hOa
    have h3' := h3 (a, J) J l O hO hOa
    rw [hs, hs, N1, N1] at h3'
    exact h3'

theorem wcpa_dj_lcp_la_fibre_separate : ∀ (S Z : Scheme.{u}) (uu : Z ⟶ S) (L : wcpaDjCoc Z)
    (y : S) (e M : ℕ)
    (τ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecResidueField y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
          Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤))
    (N₀ : S.Opens), IsAffineOpen N₀ → y ∈ N₀ →
    ∀ hN₀ : ⊤ ≤ (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
      S.fromSpecResidueField y) ⁻¹ᵁ N₀,
    wcpaDjVAData (Limits.pullback.snd uu (S.fromSpecResidueField y))
      (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L) ⊤ e M τ →
    wcpaDjLaSep uu y L M τ N₀ hN₀ :=
by
  intro S Z uu L y e M τ N₀ hN₀aff hy hN₀ hVA

  have s1 : ∀ {R K : Type u} [CommRing R] [CommRing K] (ρ : R →+* K),
      (∀ c : K, ∃ α β : R, IsUnit (ρ β) ∧ ρ α = c * ρ β) →
      ∀ P : MvPolynomial (Fin (M + 1)) K, ∃ (Pol : MvPolynomial (Fin (M + 1)) R) (β : R),
        IsUnit (ρ β) ∧ MvPolynomial.map ρ Pol = MvPolynomial.C (ρ β) * P := by
    intro R K _ _ ρ hfr P
    refine MvPolynomial.induction_on (motive := fun P => ∃ (Pol : MvPolynomial (Fin (M + 1)) R)
      (β : R), IsUnit (ρ β) ∧ MvPolynomial.map ρ Pol = MvPolynomial.C (ρ β) * P) P ?_ ?_ ?_
    · intro c
      obtain ⟨α, β, hβ, hα⟩ := hfr c
      refine ⟨MvPolynomial.C α, β, hβ, ?_⟩
      rw [MvPolynomial.map_C, hα, MvPolynomial.C_mul, mul_comm]
    · intro p q hp hq
      obtain ⟨P1, b1, hb1, h1⟩ := hp
      obtain ⟨P2, b2, hb2, h2⟩ := hq
      refine ⟨MvPolynomial.C b2 * P1 + MvPolynomial.C b1 * P2, b1 * b2,
        by rw [map_mul]; exact hb1.mul hb2, ?_⟩
      simp only [map_add, map_mul, MvPolynomial.map_C, h1, h2]
      ring
    · intro p n hp
      obtain ⟨P1, b1, hb1, h1⟩ := hp
      exact ⟨P1 * MvPolynomial.X n, b1, hb1, by rw [map_mul, MvPolynomial.map_X, h1, mul_assoc]⟩

  have s3 : ∀ (X : Scheme.{u}) (D : X.Opens), IsAffineOpen D → ∀ w w' : X, w ≠ w' → w ∈ D →
      w' ∈ D → ∃ f : Γ(X, D), ¬ (w ∈ X.basicOpen f ↔ w' ∈ X.basicOpen f) := by
    intro X D hD w w' hne hw hw'
    obtain ⟨U, hU, hx⟩ := exists_isOpen_xor_mem hne
    rcases hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · obtain ⟨f, hfU, hwf⟩ := hD.exists_basicOpen_le (V := ⟨U, hU⟩) ⟨w, h1⟩ hw
      exact ⟨f, fun h => h2 (hfU (h.mp hwf))⟩
    · obtain ⟨f, hfU, hwf⟩ := hD.exists_basicOpen_le (V := ⟨U, hU⟩) ⟨w', h1⟩ hw'
      exact ⟨f, fun h => h2 (hfU (h.mpr hwf))⟩

  have s4 : ∀ {X T S : Scheme.{u}} (q : X ⟶ T) (r : T ⟶ S) (N₀ : S.Opens) (e₁ : ⊤ ≤ r ⁻¹ᵁ N₀)
      (hN : ⊤ ≤ (q ≫ r) ⁻¹ᵁ N₀) (C : X.Opens) (hC : C ≤ q ⁻¹ᵁ ⊤),
      (X.presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom.comp ((q ≫ r).appLE N₀ ⊤ hN).hom =
        ((X.presheaf.map (homOfLE hC).op).hom.comp (q.app ⊤).hom).comp (r.appLE N₀ ⊤ e₁).hom := by
    intro X T S q r N₀ e₁ hN C hC
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
    congr 1
    simp only [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map, Scheme.Hom.appLE_comp_appLE,
      Category.assoc]

  have s2 : ∀ (S : Scheme.{u}) (y : S) (N₀ : S.Opens), IsAffineOpen N₀ → ∀ (hy : y ∈ N₀)
      (e : ⊤ ≤ S.fromSpecResidueField y ⁻¹ᵁ N₀) (c : Γ(Spec (S.residueField y), ⊤)),
      ∃ α β : Γ(S, N₀), IsUnit (((S.fromSpecResidueField y).appLE N₀ ⊤ e).hom β) ∧
        ((S.fromSpecResidueField y).appLE N₀ ⊤ e).hom α =
          c * ((S.fromSpecResidueField y).appLE N₀ ⊤ e).hom β := by
    intro S y N₀ hN₀ hy e c
    have hid : (S.fromSpecResidueField y).appLE N₀ ⊤ e =
        S.evaluation N₀ y hy ≫ (Scheme.ΓSpecIso (S.residueField y)).inv := by
      refine (Scheme.Hom.comp_appLE (Spec.map (S.residue y)) (S.fromSpecStalk y) N₀ ⊤ e).trans ?_
      rw [Scheme.fromSpecStalk_app hy]
      simp only [Category.assoc, Scheme.Hom.map_appLE]
      rw [← Scheme.germ_residue, Category.assoc, Scheme.ΓSpecIso_inv_naturality]
      congr 2
    rw [hid]
    obtain ⟨x, rfl⟩ : ∃ x : N₀, (x : S) = y := ⟨⟨y, hy⟩, rfl⟩
    obtain ⟨s, hs⟩ : ∃ s, (S.residue x).hom s = (Scheme.ΓSpecIso (S.residueField x)).hom.hom c :=
      S.residue_surjective x _
    have hloc := hN₀.isLocalization_stalk x
    obtain ⟨⟨α, β⟩, hab⟩ := IsLocalization.mk'_surjective
      (S := S.presheaf.stalk (x : S)) (hN₀.primeIdealOf x).asIdeal.primeCompl s
    have hab' : IsLocalization.mk' (S.presheaf.stalk (x : S)) α β = s := hab
    have hspec := IsLocalization.mk'_spec (S.presheaf.stalk (x : S)) α β
    rw [hab'] at hspec
    have hu : IsUnit (algebraMap Γ(S, N₀) (S.presheaf.stalk (x : S)) β) :=
      IsLocalization.map_units _ β
    have hev : ∀ z : Γ(S, N₀), (S.evaluation N₀ x hy).hom z =
        (S.residue x).hom (algebraMap Γ(S, N₀) (S.presheaf.stalk (x : S)) z) := by
      intro z
      rw [← Scheme.germ_residue]
      rfl
    have hc : (Scheme.ΓSpecIso (S.residueField x)).inv.hom
        ((Scheme.ΓSpecIso (S.residueField x)).hom.hom c) = c := by
      show ((Scheme.ΓSpecIso (S.residueField x)).hom ≫
        (Scheme.ΓSpecIso (S.residueField x)).inv).hom c = c
      rw [Iso.hom_inv_id]
      rfl
    refine ⟨α, β, ?_, ?_⟩
    · rw [CommRingCat.hom_comp, RingHom.comp_apply, hev]
      exact (hu.map (S.residue x).hom).map _
    · rw [CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply, hev, hev, ← hspec,
        map_mul, map_mul, hs, hc]

  unfold wcpaDjLaSep
  intro J w w' hne hw hw'
  have hres : ∀ {U V W : (Limits.pullback uu (S.fromSpecResidueField y)).Opens} (i : U ≤ V)
      (j : V ≤ W) (x : Γ(Limits.pullback uu (S.fromSpecResidueField y), W)),
      ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map (homOfLE i).op).hom
        (((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map (homOfLE j).op).hom x) =
        ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE (i.trans j)).op).hom x := by
    intro U V W i j x
    show (((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map (homOfLE j).op ≫
      (Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map (homOfLE i).op).hom x) = _
    rw [← Functor.map_comp]
    rfl
  have hD := hVA.2.2.1 J
  obtain ⟨f, hf⟩ := s3 _ (⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a))
    hD w w' hne hw hw'
  obtain ⟨P, hP⟩ := hVA.2.2.2 J f
  have e₁ : ⊤ ≤ S.fromSpecResidueField y ⁻¹ᵁ N₀ := fun s _ => by
    show S.fromSpecResidueField y s ∈ N₀
    rw [Scheme.fromSpecResidueField_apply]
    exact hy
  obtain ⟨Pol, β, hβu, hmap⟩ := s1 ((S.fromSpecResidueField y).appLE N₀ ⊤ e₁).hom
    (s2 S y N₀ hN₀aff hy e₁) P
  have hCD : (⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a)) ≤
      Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤ := fun x _ => by
    rw [Scheme.Hom.mem_preimage]; trivial
  have h4D := s4 (Limits.pullback.snd uu (S.fromSpecResidueField y)) (S.fromSpecResidueField y)
    N₀ e₁ hN₀ _ hCD
  obtain ⟨b, hbdef⟩ : ∃ b : Γ(Limits.pullback uu (S.fromSpecResidueField y),
      ⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a)),
      b = ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
      (homOfLE (le_top : (⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen
        (τ J a)) ≤ ⊤)).op).hom
      (((Limits.pullback.snd uu (S.fromSpecResidueField y) ≫ S.fromSpecResidueField y).appLE
        N₀ ⊤ hN₀).hom β) := ⟨_, rfl⟩
  have hbu : IsUnit b := by
    have := congrArg (fun φ => φ β) h4D
    simp only [RingHom.comp_apply] at this
    rw [hbdef, this]
    exact (hβu.map _).map _
  refine ⟨Pol, b * f, ?_, ?_⟩
  · intro a
    obtain ⟨inv, hinv, hfa⟩ := hP a
    refine ⟨inv, hinv, ?_⟩
    have h4a := s4 (Limits.pullback.snd uu (S.fromSpecResidueField y)) (S.fromSpecResidueField y)
      N₀ e₁ hN₀ ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a))
      (((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le (τ J a)).trans inf_le_right)
    have hb := congrArg (fun φ => φ β) h4a
    simp only [RingHom.comp_apply] at hb
    rw [map_mul, h4a, ← MvPolynomial.eval₂_map, hmap, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C,
      ← hfa, hbdef, hres]
    exact congrArg (· * _) hb
  · have hbasic : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (b * f) =
        (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen f := by
      rw [Scheme.basicOpen_mul, Scheme.basicOpen_of_isUnit _ hbu]
      exact inf_eq_right.mpr ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le f)
    rw [hbasic]
    exact hf

theorem wcpa_dj_lcp_la_fibre_injective : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)) (uu : Z ⟶ S) (L : wcpaDjCoc Z), wcpaDjCocOK L →
    ∀ (y : S) (N₁ : S.Opens), IsAffineOpen N₁ → y ∈ N₁ → ∀ (M : ℕ)
    (σ' : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N₁))
    (τ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecResidueField y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
          Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤)),
    (∀ J a, wcpaDjFibRes uu y L N₁ a (σ' J a) (τ J a)) →
    uu ⁻¹ᵁ N₁ ≤ ⨆ J, ⨆ a, Z.basicOpen (σ' J a) →
    ∀ (hN₁ : ⊤ ≤ (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
      S.fromSpecResidueField y) ⁻¹ᵁ N₁),
    wcpaDjLaSep uu y L M τ N₁ hN₁ →
    ∀ (φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ wcProjK k M), wcpaDjLaChart k sS uu L N₁ M σ' φ →
    ∀ (Φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS)),
    Φ ≫ Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) = φ →
    Φ ≫ Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) = uu ∣_ N₁ →
    ∀ x x' : ↥(uu ⁻¹ᵁ N₁).toScheme, uu ((uu ⁻¹ᵁ N₁).ι x) = y → Φ x' = Φ x → x' = x :=
by
  intro k _ S Z sS uu L _hL y N₁ _hN₁aff hyN₁ M σ' τ hFib hcov hN₁ hSep φ hChart Φ hΦ1 hΦ2 x x'
    hx hΦx
  classical
  obtain ⟨_hφ1, hφ2, hφ3⟩ := hChart
  by_contra hne

  have appLE_congr' : ∀ {A B : Scheme.{u}} (g g' : A ⟶ B), g = g' → ∀ (U : B.Opens) (V : A.Opens)
      (e : V ≤ g ⁻¹ᵁ U) (e' : V ≤ g' ⁻¹ᵁ U), g.appLE U V e = g'.appLE U V e' := by
    rintro A B g _ rfl U V e e'
    rfl
  have pull : ∀ {A B C : Scheme.{u}} (g₁ : A ⟶ B) (g₂ : B ⟶ C) (U : C.Opens) (V : B.Opens)
      (W : A.Opens) (e₂ : V ≤ g₂ ⁻¹ᵁ U) (e₁ : W ≤ g₁ ⁻¹ᵁ V) (e₃ : W ≤ (g₁ ≫ g₂) ⁻¹ᵁ U)
      (s : Γ(C, U)),
      (g₁.appLE V W e₁).hom ((g₂.appLE U V e₂).hom s) = ((g₁ ≫ g₂).appLE U W e₃).hom s := by
    intro A B C g₁ g₂ U V W e₂ e₁ e₃ s
    show (g₂.appLE U V e₂ ≫ g₁.appLE V W e₁).hom s = _
    rw [Scheme.Hom.appLE_comp_appLE]

  have hry : ∀ p, S.fromSpecResidueField y p = y := fun p => by
    have h0 : S.fromSpecResidueField y p ∈ Set.range (S.fromSpecResidueField y) := ⟨p, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at h0
    exact h0
  have hfib : ∀ w : ↥(Limits.pullback uu (S.fromSpecResidueField y)),
      uu (Limits.pullback.fst uu (S.fromSpecResidueField y) w) = y := fun w => by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply, hry]

  have hφx : φ x' = φ x := by
    rw [← hΦ1, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΦx]
  have hιu : ∀ z : ↥(uu ⁻¹ᵁ N₁).toScheme, uu ((uu ⁻¹ᵁ N₁).ι z) = N₁.ι ((uu ∣_ N₁) z) :=
    fun z => by rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι]
  have hsnd : (uu ∣_ N₁) x' = (uu ∣_ N₁) x := by
    rw [← hΦ2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΦx]
  have hx' : uu ((uu ⁻¹ᵁ N₁).ι x') = y := by rw [hιu, hsnd, ← hιu, hx]

  have hmemU : ∀ z : ↥(uu ⁻¹ᵁ N₁).toScheme, (uu ⁻¹ᵁ N₁).ι z ∈ uu ⁻¹ᵁ N₁ := fun z => by
    have h0 : (uu ⁻¹ᵁ N₁).ι z ∈ Set.range (uu ⁻¹ᵁ N₁).ι := ⟨z, rfl⟩
    rwa [Scheme.Opens.range_ι] at h0
  obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcov (hmemU x))
  obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hJ
  have hxD : x ∈ φ ⁻¹ᵁ wcSgD k M J := by
    rw [hφ2 J, Scheme.Hom.mem_preimage]; exact hJ
  have hx'D : x' ∈ φ ⁻¹ᵁ wcSgD k M J := by
    rw [Scheme.Hom.mem_preimage, hφx, ← Scheme.Hom.mem_preimage]; exact hxD
  have hJ' : (uu ⁻¹ᵁ N₁).ι x' ∈ ⨆ a, Z.basicOpen (σ' J a) := by
    rw [hφ2 J, Scheme.Hom.mem_preimage] at hx'D; exact hx'D
  obtain ⟨a', hxa'⟩ := TopologicalSpace.Opens.mem_iSup.mp hJ'

  obtain ⟨pt, hpt⟩ : y ∈ Set.range (S.fromSpecResidueField y) := by
    rw [Scheme.range_fromSpecResidueField]; exact Set.mem_singleton y
  obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := uu)
    (g := S.fromSpecResidueField y) ((uu ⁻¹ᵁ N₁).ι x) pt (hx.trans hpt.symm)
  obtain ⟨w', hw'1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := uu)
    (g := S.fromSpecResidueField y) ((uu ⁻¹ᵁ N₁).ι x') pt (hx'.trans hpt.symm)
  have hιinj : Function.Injective (uu ⁻¹ᵁ N₁).ι := (uu ⁻¹ᵁ N₁).ι.isOpenEmbedding.injective
  have hww' : w ≠ w' := by
    intro h
    apply hne
    apply hιinj
    rw [← hw1, ← hw'1, h]
  have hrange : Set.range (Limits.pullback.fst uu (S.fromSpecResidueField y)) ⊆
      Set.range (uu ⁻¹ᵁ N₁).ι := by
    rintro _ ⟨w₀, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact (Scheme.Hom.mem_preimage uu).mpr (by rw [hfib]; exact hyN₁)
  obtain ⟨j, hj⟩ : ∃ j : Limits.pullback uu (S.fromSpecResidueField y) ⟶ (uu ⁻¹ᵁ N₁).toScheme,
      j ≫ (uu ⁻¹ᵁ N₁).ι = Limits.pullback.fst uu (S.fromSpecResidueField y) :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
  have hjpt : ∀ w₀, (uu ⁻¹ᵁ N₁).ι (j w₀) = Limits.pullback.fst uu (S.fromSpecResidueField y) w₀ :=
    fun w₀ => by rw [← Scheme.Hom.comp_apply, hj]
  have hjw : j w = x := hιinj (by rw [hjpt, hw1])
  have hjw' : j w' = x' := hιinj (by rw [hjpt, hw'1])
  have hψw : (j ≫ Φ) w = Φ x := by rw [Scheme.Hom.comp_apply, hjw]
  have hψw' : (j ≫ Φ) w' = Φ x := by rw [Scheme.Hom.comp_apply, hjw', hΦx]

  have hchart : ∀ (b : Fin L.m) (w₀ : ↥(Limits.pullback uu (S.fromSpecResidueField y))),
      w₀ ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ↔
        Limits.pullback.fst uu (S.fromSpecResidueField y) w₀ ∈ Z.basicOpen (σ' J b) := by
    intro b w₀
    obtain ⟨h0, hτ⟩ := hFib J b
    rw [← hτ, Scheme.basicOpen_appLE]
    constructor
    · rintro ⟨_, h2⟩
      exact h2
    · intro h2
      refine ⟨⟨?_, trivial⟩, h2⟩
      show Limits.pullback.fst uu (S.fromSpecResidueField y) w₀ ∈ L.V b
      exact (Z.basicOpen_le _ h2).1
  have hwmem : w ∈ ⨆ b, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) :=
    TopologicalSpace.Opens.mem_iSup.mpr ⟨a, (hchart a w).mpr (by rw [hw1]; exact hxa)⟩
  have hw'mem : w' ∈ ⨆ b, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) :=
    TopologicalSpace.Opens.mem_iSup.mpr ⟨a', (hchart a' w').mpr (by rw [hw'1]; exact hxa')⟩

  obtain ⟨Pol, h, hloc, hsep⟩ := hSep J w w' hww' hwmem hw'mem

  have hT : Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J ≤
      (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ≫ N₁.ι) ⁻¹ᵁ N₁ := by
    intro p _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
    have h0 : N₁.ι (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) p) ∈ Set.range N₁.ι :=
      ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at h0
  obtain ⟨G, hG⟩ : ∃ G : Γ(Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS),
      Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J),
      G = MvPolynomial.eval₂
        ((Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ≫ N₁.ι).appLE N₁ _ hT).hom
        (fun l => ((Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS)).appLE (wcSgD k M J) _
          le_rfl).hom (wcSgE k M J l)) Pol := ⟨_, rfl⟩

  have hm1 : (j ≫ Φ) ≫ Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) = j ≫ φ := by
    rw [Category.assoc, hΦ1]
  have hm2 : (j ≫ Φ) ≫ (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ≫ N₁.ι) =
      Limits.pullback.snd uu (S.fromSpecResidueField y) ≫ S.fromSpecResidueField y := by
    rw [Category.assoc, ← Category.assoc Φ, hΦ2, morphismRestrict_ι, ← Category.assoc, hj,
      Limits.pullback.condition]

  have hdet : ∀ (b : Fin L.m) (w₀ : ↥(Limits.pullback uu (S.fromSpecResidueField y))),
      w₀ ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) →
      (w₀ ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen h ↔
        (j ≫ Φ) w₀ ∈ (Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS)).basicOpen G) := by
    intro b w₀ hw₀

    have hCb : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
        (j ≫ Φ) ⁻¹ᵁ (Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J) := by
      intro w₁ hw₁
      have h1 := (hchart b w₁).mp hw₁
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply,
        Category.assoc, hΦ1, Scheme.Hom.comp_apply]
      have h2 : j w₁ ∈ φ ⁻¹ᵁ wcSgD k M J := by
        rw [hφ2 J, Scheme.Hom.mem_preimage, hjpt]
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨b, h1⟩
      exact h2

    have hcoef : ((j ≫ Φ).appLE _ _ hCb).hom.comp
        ((Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ≫ N₁.ι).appLE N₁ _ hT).hom =
        ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE (le_top : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
            ⊤)).op).hom.comp
          ((Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
            S.fromSpecResidueField y).appLE N₁ ⊤ hN₁).hom := by
      have e := Scheme.Hom.appLE_comp_appLE (j ≫ Φ)
        (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ≫ N₁.ι) N₁ _ _ hT hCb
      have e2 := Scheme.Hom.appLE_map (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
        S.fromSpecResidueField y) hN₁
        (homOfLE (le_top : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
            ⊤)).op
      have e3 : (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ≫ N₁.ι).appLE N₁ _ hT ≫
          (j ≫ Φ).appLE _ _ hCb =
          (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
            S.fromSpecResidueField y).appLE N₁ ⊤ hN₁ ≫
          (Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
            (homOfLE (le_top : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen
              (τ J b) ≤ ⊤)).op := by
        rw [e, e2]
        exact appLE_congr' _ _ hm2 _ _ _ _
      have e4 := congrArg CommRingCat.Hom.hom e3
      simpa only [CommRingCat.hom_comp] using e4

    obtain ⟨inv, hinv, hhb⟩ := hloc b
    have hF : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
        (j ≫ (uu ⁻¹ᵁ N₁).ι) ⁻¹ᵁ (L.V b ⊓ uu ⁻¹ᵁ N₁) := by
      rw [hj]
      intro w₁ hw₁
      exact Z.basicOpen_le _ ((hchart b w₁).mp hw₁)
    have hC : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
        j ⁻¹ᵁ ((uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' J b)) := by
      intro w₁ hw₁
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, hjpt]
      exact (hchart b w₁).mp hw₁
    have hO : (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' J b) ≤ φ ⁻¹ᵁ wcSgD k M J := by
      intro z hz
      rw [hφ2 J, Scheme.Hom.mem_preimage]
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨b, hz⟩
    have h' : (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' J b) ≤
        (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (L.V b ⊓ uu ⁻¹ᵁ N₁) := fun z hz => Z.basicOpen_le _ hz
    have hD : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
        (j ≫ φ) ⁻¹ᵁ wcSgD k M J := by
      rw [← hm1, Scheme.Hom.comp_preimage]; exact hCb
    have hres : ∀ m, ((j ≫ (uu ⁻¹ᵁ N₁).ι).appLE (L.V b ⊓ uu ⁻¹ᵁ N₁) _ hF).hom (σ' m b) =
        ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le
            (τ J b))).op).hom (τ m b) := by
      intro m
      obtain ⟨h0, hτ⟩ := hFib m b
      rw [← hτ]
      show _ = ((Limits.pullback.fst uu (S.fromSpecResidueField y)).appLE _ _ h0 ≫
        (Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map _).hom (σ' m b)
      rw [Scheme.Hom.appLE_map]
      exact congrArg (fun g => (CommRingCat.Hom.hom g) (σ' m b)) (appLE_congr' _ _ hj _ _ _ _)
    have hratio : ∀ l, ((j ≫ Φ).appLE _ _ hCb).hom
        (((Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS)).appLE (wcSgD k M J) _
          le_rfl).hom (wcSgE k M J l)) =
        ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le
            (τ J b))).op).hom (τ l b) * inv := by
      intro l
      have H := hφ3 J l b _ hO h' le_rfl
      have H2 := congrArg (j.appLE _ _ hC).hom H
      rw [map_mul, pull j φ _ _ _ hO hC hD, pull j (uu ⁻¹ᵁ N₁).ι _ _ _ h' hC hF,
        pull j (uu ⁻¹ᵁ N₁).ι _ _ _ h' hC hF, hres, hres] at H2
      rw [pull (j ≫ Φ) _ _ _ _ le_rfl hCb (by rw [Scheme.Hom.comp_preimage]; exact hCb),
        congrArg (fun g => (CommRingCat.Hom.hom g) (wcSgE k M J l))
          (appLE_congr' _ _ hm1 _ _ _ hD)]
      linear_combination (-(((j ≫ φ).appLE (wcSgD k M J) _ hD).hom (wcSgE k M J l))) * hinv +
        inv * H2

    have heval : MvPolynomial.eval₂
        (((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE (le_top : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ≤
            ⊤)).op).hom.comp
          ((Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
            S.fromSpecResidueField y).appLE N₁ ⊤ hN₁).hom)
        (fun l => ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le
            (τ J b))).op).hom (τ l b) * inv) Pol =
        ((j ≫ Φ).appLE _ _ hCb).hom G := by
      rw [hG, MvPolynomial.eval₂_comp_left, hcoef]
      congr 1
      funext l
      exact (hratio l).symm
    have key : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen
        (((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE (le_iSup (fun a' => (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen
            (τ J a')) b)).op).hom h) =
        (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ⊓
          (j ≫ Φ) ⁻¹ᵁ (Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS)).basicOpen G := by
      rw [hhb, heval, Scheme.basicOpen_appLE]
    rw [Scheme.basicOpen_res] at key
    constructor
    · intro hh
      have h3 : w₀ ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ⊓
          (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen h := ⟨hw₀, hh⟩
      rw [key] at h3
      exact h3.2
    · intro hh
      have h3 : w₀ ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J b) ⊓
          (j ≫ Φ) ⁻¹ᵁ (Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS)).basicOpen G := ⟨hw₀, hh⟩
      rw [← key] at h3
      exact h3.2

  apply hsep
  rw [hdet a w ((hchart a w).mpr (by rw [hw1]; exact hxa)),
    hdet a' w' ((hchart a' w').mpr (by rw [hw'1]; exact hxa')), hψw, hψw']

theorem wcpa_dj_lcp_la_amp_of_finite : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)) (uu : Z ⟶ S), IsProper uu → ∀ (L : wcpaDjCoc Z), wcpaDjCocOK L →
    ∀ (N₁ : S.Opens) (e M : ℕ) (σ' : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N₁)),
    (∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N₁) e (σ' J)) →
    uu ⁻¹ᵁ N₁ ≤ ⨆ J, ⨆ a, Z.basicOpen (σ' J a) →
    ∀ (φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ wcProjK k M), wcpaDjLaChart k sS uu L N₁ M σ' φ →
    ∀ (Φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS)),
    Φ ≫ Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) = φ →
    Φ ≫ Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) = uu ∣_ N₁ →
    ∀ N' : S.Opens, IsAffineOpen N' → N' ≤ N₁ →
    (∀ J, IsAffineOpen (Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J ⊓
        Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ (N₁.ι ⁻¹ᵁ N'))) →
    IsFinite (Φ ∣_ (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ (N₁.ι ⁻¹ᵁ N'))) →
    wcpaDjAmp uu L N' e :=
by
  intro k _ S Z sS uu huu L _hL N₁ e M σ' hσc hcov φ hφ Φ hΦ1 hΦ2 N' hN' hN'N₁ hAff hFin
  classical
  haveI := huu
  generalize Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) = pr1 at hΦ1 hAff
  generalize Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) = pr2 at hΦ2 hAff hFin

  have s1 : ∀ {X P : Scheme.{u}} (Ψ : X ⟶ P) (W T : P.Opens), IsFinite (Ψ ∣_ W) → T ≤ W →
      IsAffineOpen T → IsAffineOpen (Ψ ⁻¹ᵁ T) := by
    intro X P Ψ W T hfin hTW hT
    haveI := hfin
    have hT' : IsAffineOpen (W.ι ⁻¹ᵁ T) :=
      hT.preimage_of_isOpenImmersion W.ι (by rw [Scheme.Opens.opensRange_ι]; exact hTW)
    have h2 := (hT'.preimage (Ψ ∣_ W)).image_of_isOpenImmersion (Ψ ⁻¹ᵁ W).ι
    rw [← Scheme.Hom.comp_preimage, morphismRestrict_ι, Scheme.Hom.comp_preimage,
      Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h2
    have hle' : Ψ ⁻¹ᵁ T ≤ Ψ ⁻¹ᵁ W := fun x (hx : Ψ x ∈ T) => (hTW hx : Ψ x ∈ W)
    rwa [inf_eq_right.mpr hle'] at h2
  have s3 : ∀ {X Y : Scheme.{u}} (ι : X ⟶ Y) [IsOpenImmersion ι] (O : Y.Opens),
      O ≤ ι.opensRange → ι ''ᵁ (ι ⁻¹ᵁ O) = O := by
    intro X Y ι _ O hO
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
    exact inf_eq_right.mpr hO
  have hres : ∀ {U V W : Z.Opens} (i : U ≤ V) (j : V ≤ W) (x : Γ(Z, W)),
      (Z.presheaf.map (homOfLE i).op).hom ((Z.presheaf.map (homOfLE j).op).hom x) =
        (Z.presheaf.map (homOfLE (i.trans j)).op).hom x := by
    intro U V W i j x
    show ((Z.presheaf.map (homOfLE j).op ≫ Z.presheaf.map (homOfLE i).op).hom x) = _
    rw [← Functor.map_comp]
    rfl
  have hNN : uu ⁻¹ᵁ N' ≤ uu ⁻¹ᵁ N₁ := fun x (hx : uu x ∈ N') => (hN'N₁ hx : uu x ∈ N₁)
  have hle : ∀ a, L.V a ⊓ uu ⁻¹ᵁ N' ≤ L.V a ⊓ uu ⁻¹ᵁ N₁ := fun a x hx => ⟨hx.1, hNN hx.2⟩
  obtain ⟨t, ht⟩ : ∃ t : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N'),
      ∀ J a, t J a = (Z.presheaf.map (homOfLE (hle a)).op).hom (σ' J a) := ⟨_, fun _ _ => rfl⟩

  have hA1 : ∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N') e (t J) := by
    intro J a b
    have h1 := congrArg (Z.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N' ≤
      L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₁ from fun x hx => ⟨hx.1, hNN hx.2⟩)).op).hom (hσc J a b)
    simp only [map_mul, hres] at h1
    simp only [ht, hres]
    exact h1

  have hB : ∀ J a, Z.basicOpen (t J a) = (L.V a ⊓ uu ⁻¹ᵁ N') ⊓ Z.basicOpen (σ' J a) := by
    intro J a
    rw [ht, Scheme.basicOpen_res]
  have hDJ : ∀ J, (⨆ a, Z.basicOpen (t J a)) = (⨆ a, Z.basicOpen (σ' J a)) ⊓ uu ⁻¹ᵁ N' := by
    intro J
    apply le_antisymm
    · refine iSup_le fun a => ?_
      rw [hB]
      exact le_inf (inf_le_right.trans (le_iSup (fun a => Z.basicOpen (σ' J a)) a))
        (inf_le_left.trans inf_le_right)
    · intro x hx
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx.1
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ?_⟩
      rw [hB]
      exact ⟨⟨(Z.basicOpen_le _ ha).1, hx.2⟩, ha⟩

  have hA2 : (⨆ J, ⨆ a, Z.basicOpen (t J a)) = uu ⁻¹ᵁ N' := by
    simp only [hDJ]
    rw [← iSup_inf_eq]
    exact inf_eq_right.mpr (hNN.trans hcov)

  have hpre : ∀ J, Φ ⁻¹ᵁ (pr1 ⁻¹ᵁ wcSgD k M J ⊓ pr2 ⁻¹ᵁ (N₁.ι ⁻¹ᵁ N')) =
      (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ ((⨆ a, Z.basicOpen (σ' J a)) ⊓ uu ⁻¹ᵁ N') := by
    intro J
    have e1 : Φ ⁻¹ᵁ (pr1 ⁻¹ᵁ wcSgD k M J) = (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (⨆ a, Z.basicOpen (σ' J a)) := by
      rw [← Scheme.Hom.comp_preimage, hΦ1, hφ.2.1 J]
    have e2 : Φ ⁻¹ᵁ (pr2 ⁻¹ᵁ (N₁.ι ⁻¹ᵁ N')) = (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (uu ⁻¹ᵁ N') := by
      rw [← Scheme.Hom.comp_preimage, hΦ2, ← Scheme.Hom.comp_preimage, morphismRestrict_ι,
        Scheme.Hom.comp_preimage]
    simp only [Scheme.Hom.preimage_inf, e1, e2]

  have hA3 : ∀ J, IsAffineOpen (⨆ a, Z.basicOpen (t J a)) := by
    intro J
    have h1 := s1 Φ _ _ hFin inf_le_right (hAff J)
    rw [hpre J] at h1
    have h2 := h1.image_of_isOpenImmersion (uu ⁻¹ᵁ N₁).ι
    rw [s3 _ _ (by rw [Scheme.Opens.opensRange_ι]; exact inf_le_right.trans hNN)] at h2
    rw [hDJ J]
    exact h2

  refine ⟨M, t, hA1, hA2, hA3, fun J => ?_⟩
  have hh : (⨆ a, Z.basicOpen (t J a)) ≤ uu ⁻¹ᵁ N' :=
    iSup_le (fun a => (Z.basicOpen_le (t J a)).trans inf_le_right)
  have key : (Z.presheaf.map (homOfLE hh).op).hom.comp (uu.app N').hom =
      (uu.appLE N' (⨆ a, Z.basicOpen (t J a)) hh).hom := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
  have hft := LocallyOfFiniteType.finiteType_appLE uu hN' (hA3 J) hh
  rw [← key] at hft
  exact hft

theorem wcpa_dj_lcp_ra_local_amp : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L → ∀ (y : S) (N : S.Opens), y ∈ N → ∀ (e M : ℕ), 0 < e →
    ∀ σ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N),
    (∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N) e (σ J)) →
    ∀ τ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecResidueField y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
          Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤),
    (∀ J a, wcpaDjFibRes uu y L N a (σ J a) (τ J a)) →
    wcpaDjVAData (Limits.pullback.snd uu (S.fromSpecResidueField y))
      (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L) ⊤ e M τ →
    ∃ N' : S.Opens, IsAffineOpen N' ∧ y ∈ N' ∧ N' ≤ N ∧ wcpaDjAmp uu L N' e :=
by
  intro k _ S Z sS _hS uu huu L hL y N hyN e M _he σ hσc τ hFib hVA
  classical
  haveI := huu

  have hry : ∀ p, S.fromSpecResidueField y p = y := fun p => by
    have h0 : S.fromSpecResidueField y p ∈ Set.range (S.fromSpecResidueField y) := ⟨p, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at h0
    exact h0
  have hfibpt : ∀ w : ↥(Limits.pullback uu (S.fromSpecResidueField y)),
      uu (Limits.pullback.fst uu (S.fromSpecResidueField y) w) = y := fun w => by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply, hry]

  have hcov : ∀ z : Z, uu z = y → z ∈ (⨆ J, ⨆ a, Z.basicOpen (σ J a) : Z.Opens) := by
    intro z hz
    obtain ⟨pt, hpt⟩ : y ∈ Set.range (S.fromSpecResidueField y) := by
      rw [Scheme.range_fromSpecResidueField]; exact Set.mem_singleton y
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := uu)
      (g := S.fromSpecResidueField y) z pt (hz.trans hpt.symm)
    have hzV : z ∈ (⨆ a, L.V a : Z.Opens) := by rw [hL.2.1]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hzV
    have hwV : w ∈ (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
        Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤ :=
      ⟨show Limits.pullback.fst uu (S.fromSpecResidueField y) w ∈ L.V a by rw [hw1]; exact ha,
        trivial⟩
    obtain ⟨J, hJ⟩ : ∃ J, w ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a) := by
      by_contra hne
      push_neg at hne
      have hle : Ideal.span (Set.range fun J => τ J a) ≤
          Ideal.comap ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.germ _ w hwV).hom
            (IsLocalRing.maximalIdeal _) := by
        rw [Ideal.span_le]
        rintro _ ⟨J, rfl⟩
        exact Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr
          fun hu => hne J (((Limits.pullback uu (S.fromSpecResidueField y)).mem_basicOpen _ w
            hwV).mpr hu)))
      rw [hVA.2.1 a, top_le_iff] at hle
      exact Ideal.comap_ne_top _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top hle
    obtain ⟨h0, hτ⟩ := hFib J a
    rw [← hτ, Scheme.basicOpen_appLE] at hJ
    have h2 : z ∈ Z.basicOpen (σ J a) := by
      have h3 : Limits.pullback.fst uu (S.fromSpecResidueField y) w ∈ Z.basicOpen (σ J a) := hJ.2
      rwa [hw1] at h3
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨J, TopologicalSpace.Opens.mem_iSup.mpr ⟨a, h2⟩⟩

  have hCcl : IsClosed (uu '' ((⨆ J, ⨆ a, Z.basicOpen (σ J a) : Z.Opens) : Set Z)ᶜ) :=
    uu.isClosedMap _ (TopologicalSpace.Opens.isOpen _).isClosed_compl
  have hyC : y ∉ uu '' ((⨆ J, ⨆ a, Z.basicOpen (σ J a) : Z.Opens) : Set Z)ᶜ := by
    rintro ⟨z, hz, hzy⟩
    exact hz (hcov z hzy)
  obtain ⟨N₁, hN₁, hyN₁, hN₁sub⟩ := exists_isAffineOpen_mem_and_subset (x := y)
    (U := N ⊓ ⟨(uu '' ((⨆ J, ⨆ a, Z.basicOpen (σ J a) : Z.Opens) : Set Z)ᶜ)ᶜ,
      hCcl.isOpen_compl⟩) ⟨hyN, hyC⟩
  have hN₁N : N₁ ≤ N := fun x hx => (hN₁sub hx).1
  have hN₁C : ∀ x ∈ N₁, x ∉ uu '' ((⨆ J, ⨆ a, Z.basicOpen (σ J a) : Z.Opens) : Set Z)ᶜ :=
    fun x hx => (hN₁sub hx).2
  have hres : ∀ {U V W : Z.Opens} (i : U ≤ V) (j : V ≤ W) (x : Γ(Z, W)),
      (Z.presheaf.map (homOfLE i).op).hom ((Z.presheaf.map (homOfLE j).op).hom x) =
        (Z.presheaf.map (homOfLE (i.trans j)).op).hom x := by
    intro U V W i j x
    show ((Z.presheaf.map (homOfLE j).op ≫ Z.presheaf.map (homOfLE i).op).hom x) = _
    rw [← Functor.map_comp]
    rfl
  have hle : ∀ a, L.V a ⊓ uu ⁻¹ᵁ N₁ ≤ L.V a ⊓ uu ⁻¹ᵁ N := fun a x hx => ⟨hx.1, hN₁N hx.2⟩
  obtain ⟨σ', hσ'⟩ : ∃ σ' : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N₁),
      ∀ J a, σ' J a = (Z.presheaf.map (homOfLE (hle a)).op).hom (σ J a) := ⟨_, fun _ _ => rfl⟩
  have hσ'c : ∀ J, wcpaDjCompat L (uu ⁻¹ᵁ N₁) e (σ' J) := by
    intro J a b
    have h1 := congrArg (Z.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N₁ ≤
      L.V a ⊓ L.V b ⊓ uu ⁻¹ᵁ N from fun x hx => ⟨hx.1, hN₁N hx.2⟩)).op).hom (hσc J a b)
    simp only [map_mul, hres] at h1
    simp only [hσ', hres]
    exact h1
  have hFib' : ∀ J a, wcpaDjFibRes uu y L N₁ a (σ' J a) (τ J a) := by
    intro J a
    obtain ⟨h0, hτ⟩ := hFib J a
    have hle' : (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
        Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤ ≤
        Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N₁) :=
      fun w hw => ⟨(h0 hw).1,
        show uu (Limits.pullback.fst uu (S.fromSpecResidueField y) w) ∈ N₁ by
          rw [hfibpt]; exact hyN₁⟩
    refine ⟨hle', ?_⟩
    have key := Scheme.Hom.map_appLE (Limits.pullback.fst uu (S.fromSpecResidueField y)) hle'
      (homOfLE (hle a)).op
    rw [hσ', ← hτ, ← key]
    rfl
  have hcov' : uu ⁻¹ᵁ N₁ ≤ ⨆ J, ⨆ a, Z.basicOpen (σ' J a) := by
    intro x hx
    have hxU : x ∈ (⨆ J, ⨆ a, Z.basicOpen (σ J a) : Z.Opens) := by
      by_contra hn
      exact hN₁C _ hx ⟨x, hn, rfl⟩
    obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.mp hxU
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hJ
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨J, TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ?_⟩⟩
    rw [hσ', Scheme.basicOpen_res]
    exact ⟨⟨(Z.basicOpen_le _ ha).1, hx⟩, ha⟩

  obtain ⟨φ, hφ⟩ := wcpa_dj_lcp_la_chart_morphism k S Z sS uu L hL N₁ e M σ' hσ'c hcov'
    wcpa_dj_gsfp_proj_up
  have hφ1 : φ ≫ wcProjKStr k M = (uu ∣_ N₁) ≫ N₁.ι ≫ sS := hφ.1
  obtain ⟨Φ, hΦ1, hΦ2⟩ : ∃ Φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ Limits.pullback (wcProjKStr k M) (N₁.ι ≫ sS),
      Φ ≫ Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) = φ ∧
      Φ ≫ Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) = uu ∣_ N₁ :=
    ⟨Limits.pullback.lift φ (uu ∣_ N₁) hφ1, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  haveI hsep : IsSeparated (wcProjKStr k M) := by unfold wcProjKStr; infer_instance
  haveI : IsSeparated (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS)) :=
    MorphismProperty.of_isPullback (P := @IsSeparated) (IsPullback.of_hasPullback _ _) hsep
  haveI : IsProper (Φ ≫ Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS)) := by
    rw [hΦ2]; infer_instance
  haveI hΦp : IsProper Φ := IsProper.of_comp Φ (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS))

  have hN₁top : ⊤ ≤ (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
      S.fromSpecResidueField y) ⁻¹ᵁ N₁ := fun w _ =>
    show (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫ S.fromSpecResidueField y) w ∈ N₁ by
      rw [Scheme.Hom.comp_apply, hry]; exact hyN₁
  have hSep := wcpa_dj_lcp_la_fibre_separate S Z uu L y e M τ N₁ hN₁ hyN₁ hN₁top hVA
  have hinj := wcpa_dj_lcp_la_fibre_injective k S Z sS uu L hL y N₁ hN₁ hyN₁ M σ' τ hFib' hcov'
    hN₁top hSep φ hφ Φ hΦ1 hΦ2

  have zmt : ∀ {X P B : Scheme.{u}} (Φ : X ⟶ P) (p : P ⟶ B) [IsProper Φ] [IsProper (Φ ≫ p)]
      (b : B), (∀ x x' : X, p (Φ x) = b → Φ x' = Φ x → x' = x) →
      ∃ V : B.Opens, b ∈ V ∧ ∀ V' : B.Opens, V' ≤ V → IsFinite (Φ ∣_ (p ⁻¹ᵁ V')) := by
    intro X P B Φ p _ _ b hinj
    have hQ : ∀ x : X, p (Φ x) = b → x ∈ Φ.quasiFiniteLocus := by
      intro x hx
      rw [Scheme.Hom.mem_quasiFiniteLocus, Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber]
      haveI : Subsingleton (Φ.fiber (Φ x)) := by
        rw [(Φ.fiberHomeo (Φ x)).toEquiv.subsingleton_congr]
        exact ⟨fun a b => Subtype.ext ((hinj x a.1 hx a.2).trans (hinj x b.1 hx b.2).symm)⟩
      rw [show ({Φ.asFiber x} : Set (Φ.fiber (Φ x))) = Set.univ from
        Set.eq_univ_of_forall fun z => Subsingleton.elim _ _]
      exact isOpen_univ
    have hC : IsClosed ((Φ ≫ p) '' ((Φ.quasiFiniteLocus : Set X)ᶜ)) :=
      (Φ ≫ p).isClosedMap _ Φ.quasiFiniteLocus.isOpen.isClosed_compl
    refine ⟨⟨_, hC.isOpen_compl⟩, ?_, ?_⟩
    · rintro ⟨x, hx, hxb⟩
      exact hx (hQ x (by rw [← hxb, Scheme.Hom.comp_apply]))
    intro V' hV'
    haveI : LocallyQuasiFinite (Φ ∣_ (p ⁻¹ᵁ V')) := by
      rw [← Scheme.Hom.quasiFiniteLocus_eq_top_iff]
      refine eq_top_iff.mpr fun z _ => ?_
      rw [Scheme.Hom.mem_quasiFiniteLocus, ← Scheme.Hom.quasiFiniteAt_comp_iff (g := (p ⁻¹ᵁ V').ι),
        morphismRestrict_ι, Scheme.Hom.quasiFiniteAt_comp_iff_of_isOpenImmersion,
        ← Scheme.Hom.mem_quasiFiniteLocus]
      by_contra hz
      have hzV : p (Φ ((Φ ⁻¹ᵁ (p ⁻¹ᵁ V')).ι z)) ∈ V' := by
        first
        | exact z.2
        | simpa [Scheme.Opens.ι_apply] using z.2
      exact hV' hzV ⟨_, hz, by rw [Scheme.Hom.comp_apply]⟩
    exact IsFinite.of_isProper_of_locallyQuasiFinite _

  obtain ⟨V, hbV, hV⟩ := zmt Φ (Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS))
    (⟨y, hyN₁⟩ : N₁.toScheme) (by
      intro x x' hx hxx'
      refine hinj x x' ?_ hxx'
      have e1 : uu ((uu ⁻¹ᵁ N₁).ι x) = N₁.ι ((uu ∣_ N₁) x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι]
      have e2 : Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) (Φ x) = (uu ∣_ N₁) x := by
        rw [← Scheme.Hom.comp_apply, hΦ2]
      rw [e1, ← e2, hx]
      exact Scheme.Opens.ι_apply N₁ _)

  have hyimg : y ∈ N₁.ι ''ᵁ V := ⟨⟨y, hyN₁⟩, hbV, Scheme.Opens.ι_apply N₁ _⟩
  obtain ⟨N', hN', hyN', hN'sub⟩ := exists_isAffineOpen_mem_and_subset hyimg
  have hN'N₁ : N' ≤ N₁ := by
    intro x hx
    obtain ⟨v, -, rfl⟩ := hN'sub hx
    first
    | exact v.2
    | (convert v.2 using 1; exact Scheme.Opens.ι_apply N₁ v)
  have hV'V : N₁.ι ⁻¹ᵁ N' ≤ V := by
    intro x hx
    obtain ⟨v, hv, hvx⟩ := hN'sub hx
    have hvx' : v = x := N₁.ι.isOpenEmbedding.injective hvx
    rw [← hvx']; exact hv
  have hFin := hV (N₁.ι ⁻¹ᵁ N') hV'V
  have hV'aff : IsAffineOpen (N₁.ι ⁻¹ᵁ N') :=
    hN'.preimage_of_isOpenImmersion N₁.ι (by rw [Scheme.Opens.opensRange_ι]; exact hN'N₁)

  have hAff : ∀ J, IsAffineOpen (Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J ⊓
      Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ (N₁.ι ⁻¹ᵁ N')) := by
    intro J
    have hD : IsAffineOpen (wcSgD k M J) := by
      unfold wcSgD
      exact Proj.isAffineOpen_basicOpen _ _
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X _ _)) one_pos
    haveI : IsAffine (wcSgD k M J).toScheme := hD
    have h1 := isPullback_morphismRestrict (Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS))
      (wcSgD k M J)
    have h2 := h1.paste_vert (IsPullback.of_hasPullback (wcProjKStr k M) (N₁.ι ≫ sS))
    haveI : IsAffineHom ((Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J).ι ≫
        Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) h2 inferInstance
    have h3 := (hV'aff.preimage
      ((Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J).ι ≫
        Limits.pullback.snd (wcProjKStr k M) (N₁.ι ≫ sS))).image_of_isOpenImmersion
      (Limits.pullback.fst (wcProjKStr k M) (N₁.ι ≫ sS) ⁻¹ᵁ wcSgD k M J).ι
    rwa [Scheme.Hom.comp_preimage, Scheme.Hom.image_preimage_eq_opensRange_inf,
      Scheme.Opens.opensRange_ι] at h3

  exact ⟨N', hN', hyN', hN'N₁.trans hN₁N, wcpa_dj_lcp_la_amp_of_finite k S Z sS uu huu L hL N₁ e M
    σ' hσ'c hcov' φ hφ Φ hΦ1 hΦ2 N' hN' hN'N₁ hAff hFin⟩

theorem wcpa_dj_lcp_ra_amp_glue : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T), QuasiCompact q →
    QuasiSeparated q → ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → ∀ W : T.Opens, IsAffineOpen W →
    (∀ a, IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ W)) →
    (∀ y ∈ W, ∃ N : T.Opens, IsAffineOpen N ∧ y ∈ N ∧ ∃ e : ℕ, 0 < e ∧ wcpaDjAmp q L N e) →
    ∃ e : ℕ, 0 < e ∧ wcpaDjAmp q L W e :=
by
  intro Y T q _hqc hqs L _hL W hW hAW hloc
  haveI := hqs
  classical

  have resres : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  have bores : ∀ {A B : Y.Opens} (h : B ≤ A) (x : Γ(Y, A)),
      Y.basicOpen ((Y.presheaf.map (homOfLE h).op).hom x) = B ⊓ Y.basicOpen x :=
    fun h x => Y.basicOpen_res x _

  have ftc : ∀ (N : T.Opens) (D D' : Y.Opens) (h : D ≤ q ⁻¹ᵁ N) (h' : D' ≤ q ⁻¹ᵁ N), D = D' →
      (q.appLE N D h).hom.FiniteType → (q.appLE N D' h').hom.FiniteType := by
    rintro N D D' h h' rfl hD
    exact hD

  have s6 : ∀ (f : Γ(T, W)) (D : Y.Opens) (hD : D ≤ q ⁻¹ᵁ (T.basicOpen f)),
      (q.appLE (T.basicOpen f) D hD).hom.FiniteType →
      (q.appLE W D (hD.trans (fun x hx => T.basicOpen_le f hx))).hom.FiniteType := by
    intro f D hD h
    have hlocf : (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.FiniteType := by
      haveI := hW.isLocalization_basicOpen f
      haveI := IsLocalization.Away.finitePresentation (S := Γ(T, T.basicOpen f)) f
      exact Algebra.FiniteType.of_finitePresentation
    have e : (q.appLE W D (hD.trans (fun x hx => T.basicOpen_le f hx))).hom =
        (q.appLE (T.basicOpen f) D hD).hom.comp (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom := by
      rw [← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
    rw [e]
    exact h.comp hlocf

  have s3 : ∀ (P : T.Opens → Prop), (∀ y ∈ W, ∃ N : T.Opens, IsAffineOpen N ∧ y ∈ N ∧ P N) →
      ∃ (r : ℕ) (f : Fin r → Γ(T, W)), (⨆ i, T.basicOpen (f i)) = W ∧
        ∀ i, ∃ (N : T.Opens) (g : Γ(T, N)), IsAffineOpen N ∧ P N ∧
          T.basicOpen (f i) = T.basicOpen g := by
    intro P hP
    have h1 : ∀ y : W, ∃ fg : Γ(T, W), y.1 ∈ T.basicOpen fg ∧ ∃ (N : T.Opens) (g : Γ(T, N)),
        IsAffineOpen N ∧ P N ∧ T.basicOpen fg = T.basicOpen g := by
      intro y
      obtain ⟨N, hN, hyN, hPN⟩ := hP y.1 y.2
      obtain ⟨f, g, hfg, hy⟩ := exists_basicOpen_le_affine_inter hW hN y.1 ⟨y.2, hyN⟩
      exact ⟨f, hy, N, g, hN, hPN, hfg⟩
    choose F hF hFN using h1
    obtain ⟨S, hS⟩ := hW.isCompact.elim_finite_subcover (fun y : W => (T.basicOpen (F y) : Set T))
      (fun y => (T.basicOpen (F y)).isOpen)
      (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hF ⟨y, hy⟩⟩)
    refine ⟨S.card, fun i => F (S.equivFin.symm i).1, ?_, fun i => hFN _⟩
    apply le_antisymm
    · exact iSup_le fun i => T.basicOpen_le _
    · intro x hx
      have hx' := hS hx
      simp only [Set.mem_iUnion] at hx'
      obtain ⟨y, hyS, hxy⟩ := hx'
      rw [TopologicalSpace.Opens.mem_iSup]
      refine ⟨S.equivFin ⟨y, hyS⟩, ?_⟩
      show x ∈ T.basicOpen (F (S.equivFin.symm (S.equivFin ⟨y, hyS⟩)).1)
      rw [Equiv.symm_apply_apply]
      exact hxy

  have s4 : ∀ (N : T.Opens) (e k : ℕ), 0 < k → wcpaDjAmp q L N e → wcpaDjAmp q L N (e * k) := by
    rintro N e k hk ⟨M, t, hc, hcv, haff, hft⟩
    have hD : ∀ J, (⨆ a, Y.basicOpen (t J a ^ k)) = ⨆ a, Y.basicOpen (t J a) :=
      fun J => iSup_congr fun a => Y.basicOpen_pow _ hk
    refine ⟨M, fun J a => t J a ^ k, ?_, ?_, ?_, ?_⟩
    · intro J a b
      have h := congrArg (· ^ k) (hc J a b)
      simp only [map_pow, mul_pow] at h ⊢
      rw [h, ← pow_mul]
    · simp only [hD]
      exact hcv
    · intro J
      rw [hD]
      exact haff J
    · intro J
      have h0 : (q.appLE N _ (iSup_le fun a => (Y.basicOpen_le (t J a)).trans inf_le_right)).hom.FiniteType :=
        hft J
      exact ftc N _ _ _ _ (hD J).symm h0

  have s1 : ∀ (N : T.Opens) (e : ℕ), wcpaDjAmp q L N e → ∀ g : Γ(T, N),
      wcpaDjAmp q L (T.basicOpen g) e := by
    rintro N e ⟨M, t, hc, hcv, haff, hft⟩ g
    have hBN : T.basicOpen g ≤ N := T.basicOpen_le g
    have hU : q ⁻¹ᵁ T.basicOpen g ≤ q ⁻¹ᵁ N := fun x hx => hBN hx
    have hUΓ : q ⁻¹ᵁ T.basicOpen g = Y.basicOpen ((q.app N).hom g) := Scheme.preimage_basicOpen q g
    have hle : ∀ a, L.V a ⊓ q ⁻¹ᵁ T.basicOpen g ≤ L.V a ⊓ q ⁻¹ᵁ N := fun a => inf_le_inf_left _ hU
    have hDle : ∀ J, (⨆ a, Y.basicOpen (t J a)) ≤ q ⁻¹ᵁ N :=
      fun J => iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right
    have hbo : ∀ J a, Y.basicOpen ((Y.presheaf.map (homOfLE (hle a)).op).hom (t J a)) =
        q ⁻¹ᵁ T.basicOpen g ⊓ Y.basicOpen (t J a) := by
      intro J a
      rw [bores]
      have := Y.basicOpen_le (t J a)
      apply le_antisymm
      · exact le_inf (inf_le_left.trans inf_le_right) inf_le_right
      · exact le_inf (le_inf (inf_le_right.trans (this.trans inf_le_left)) inf_le_left) inf_le_right
    have hD' : ∀ J, (⨆ a, Y.basicOpen ((Y.presheaf.map (homOfLE (hle a)).op).hom (t J a))) =
        Y.basicOpen ((Y.presheaf.map (homOfLE (hDle J)).op).hom ((q.app N).hom g)) := by
      intro J
      rw [bores, ← hUΓ]
      simp only [hbo, ← inf_iSup_eq]
      exact inf_comm _ _
    refine ⟨M, fun J a => (Y.presheaf.map (homOfLE (hle a)).op).hom (t J a), ?_, ?_, ?_, ?_⟩
    · intro J a b
      have h := congrArg (Y.presheaf.map (homOfLE (inf_le_inf_left _ hU :
        L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ T.basicOpen g ≤ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ N)).op).hom (hc J a b)
      rw [map_mul] at h
      simp only [resres] at h ⊢
      exact h
    · simp only [hbo, ← inf_iSup_eq, hcv]
      exact inf_eq_left.mpr hU
    · intro J
      rw [hD']
      exact (haff J).basicOpen _
    · intro J
      have hD'B : (⨆ a, Y.basicOpen ((Y.presheaf.map (homOfLE (hle a)).op).hom (t J a))) ≤
          q ⁻¹ᵁ T.basicOpen g := iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right
      obtain ⟨γ, hγ⟩ : ∃ γ, γ = (Y.presheaf.map (homOfLE (hDle J)).op).hom ((q.app N).hom g) :=
        ⟨_, rfl⟩
      have hDJ := hD' J
      rw [← hγ] at hDJ
      have h0 : (q.appLE N _ (hDle J)).hom.FiniteType := hft J
      have hlocγ : (Y.presheaf.map (homOfLE (Y.basicOpen_le γ)).op).hom.FiniteType := by
        haveI := (haff J).isLocalization_basicOpen γ
        haveI := IsLocalization.Away.finitePresentation (S := Γ(Y, Y.basicOpen γ)) γ
        exact Algebra.FiniteType.of_finitePresentation
      have e2 : (q.appLE N (Y.basicOpen γ) ((Y.basicOpen_le γ).trans (hDle J))).hom =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le γ)).op).hom.comp (q.appLE N _ (hDle J)).hom := by
        rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_map]
      have h2 : (q.appLE N (Y.basicOpen γ) ((Y.basicOpen_le γ).trans (hDle J))).hom.FiniteType := by
        rw [e2]
        exact hlocγ.comp h0
      have h3 := ftc N _ _ _ (hD'B.trans hU) hDJ.symm h2
      have e4 : (q.appLE N _ (hD'B.trans hU)).hom =
          (q.appLE (T.basicOpen g) _ hD'B).hom.comp (T.presheaf.map (homOfLE hBN).op).hom := by
        rw [← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
      rw [e4] at h3
      exact RingHom.FiniteType.of_comp_finiteType h3

  have hqsW : IsQuasiSeparated ((q ⁻¹ᵁ W : Y.Opens) : Set Y) :=
    q.isQuasiSeparated_preimage hW.isQuasiSeparated
  have hcomp : ∀ a b, IsCompact ((L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W : Y.Opens) : Set Y) := by
    intro a b
    have := hqsW _ _ (fun x hx => hx.2) (L.V a ⊓ q ⁻¹ᵁ W).isOpen (hAW a).isCompact
      (fun x hx => hx.2) (L.V b ⊓ q ⁻¹ᵁ W).isOpen (hAW b).isCompact
    convert this using 1
    ext x
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff]
    tauto
  have s2 : ∀ (f : Γ(T, W)) (e : ℕ) (u : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ (T.basicOpen f))),
      wcpaDjCompat L (q ⁻¹ᵁ (T.basicOpen f)) e u →
      ∃ s : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W), wcpaDjCompat L (q ⁻¹ᵁ W) e s ∧
        ∀ a, Y.basicOpen (s a) = Y.basicOpen (u a) := by
    intro f e u hu
    have hBW : q ⁻¹ᵁ T.basicOpen f ≤ q ⁻¹ᵁ W := fun x hx => T.basicOpen_le f hx
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : Γ(Y, q ⁻¹ᵁ W), Φ = (q.app W).hom f := ⟨_, rfl⟩
    have hUΦ : q ⁻¹ᵁ T.basicOpen f = Y.basicOpen Φ := by
      rw [hΦ]; exact Scheme.preimage_basicOpen q f
    have hOa : ∀ a, L.V a ⊓ q ⁻¹ᵁ W ≤ q ⁻¹ᵁ W := fun a => inf_le_right
    obtain ⟨Φa, hΦa⟩ : ∃ Φa : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
        ∀ a, Φa a = (Y.presheaf.map (homOfLE (hOa a)).op).hom Φ := ⟨_, fun _ => rfl⟩
    have hboΦa : ∀ a, Y.basicOpen (Φa a) = L.V a ⊓ q ⁻¹ᵁ T.basicOpen f := by
      intro a
      rw [hΦa, bores, ← hUΦ, inf_assoc, inf_eq_right.mpr hBW]
    have hΦres : ∀ a (P : Y.Opens) (hP : P ≤ L.V a ⊓ q ⁻¹ᵁ W),
        (Y.presheaf.map (homOfLE hP).op).hom (Φa a) =
          (Y.presheaf.map (homOfLE (hP.trans inf_le_right)).op).hom Φ := by
      intro a P hP
      rw [hΦa, resres]

    have hstep1 : ∀ a, ∃ (n : ℕ) (y : Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (Φa a))).op).hom y =
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le (Φa a))).op).hom (Φa a)) ^ n *
            (Y.presheaf.map (homOfLE (hboΦa a).le).op).hom (u a) := by
      intro a
      exact exists_eq_pow_mul_of_isAffineOpen Y _ (hAW a) _ _
    choose n y hy using hstep1
    have hn : ∀ a, n a ≤ ∑ a, n a + 1 := fun a =>
      (Finset.single_le_sum (fun i _ => Nat.zero_le (n i)) (Finset.mem_univ a)).trans (Nat.le_succ _)
    obtain ⟨nt, hnt⟩ : ∃ nt, nt = ∑ a, n a + 1 := ⟨_, rfl⟩
    rw [← hnt] at hn
    have hntpos : 0 < nt := by rw [hnt]; exact Nat.succ_pos _
    obtain ⟨z, hz⟩ : ∃ z : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
        ∀ a, z a = Φa a ^ (nt - n a) * y a := ⟨_, fun _ => rfl⟩
    have h1 : ∀ a, (Y.presheaf.map (homOfLE (Y.basicOpen_le (Φa a))).op).hom (z a) =
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le (Φa a))).op).hom (Φa a)) ^ nt *
          (Y.presheaf.map (homOfLE (hboΦa a).le).op).hom (u a) := by
      intro a
      rw [hz, map_mul, map_pow, hy, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (hn a)]
    have hz' : ∀ a (P : Y.Opens) (hP : P ≤ Y.basicOpen (Φa a)),
        (Y.presheaf.map (homOfLE (hP.trans (Y.basicOpen_le (Φa a)))).op).hom (z a) =
          ((Y.presheaf.map (homOfLE ((hP.trans (Y.basicOpen_le (Φa a))).trans inf_le_right)).op).hom Φ) ^ nt *
            (Y.presheaf.map (homOfLE (hP.trans (hboΦa a).le)).op).hom (u a) := by
      intro a P hP
      have h := congrArg (Y.presheaf.map (homOfLE hP).op).hom (h1 a)
      rw [map_mul, map_pow] at h
      simp only [resres] at h
      rw [h, hΦres]

    have hstep2 : ∀ a b, ∃ k : ℕ,
        ((Y.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ q ⁻¹ᵁ W)).op).hom Φ) ^ k *
          ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W from
              le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (z b) -
            (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b from
              inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
            (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
              le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (z a)) = 0 := by
      intro a b
      apply exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact Y (hcomp a b)
      have hPa : Y.basicOpen ((Y.presheaf.map (homOfLE (inf_le_right :
          L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ q ⁻¹ᵁ W)).op).hom Φ) ≤ Y.basicOpen (Φa a) := by
        rw [bores, hΦa, bores]
        exact inf_le_inf_right _ (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      have hPb : Y.basicOpen ((Y.presheaf.map (homOfLE (inf_le_right :
          L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ q ⁻¹ᵁ W)).op).hom Φ) ≤ Y.basicOpen (Φa b) := by
        rw [bores, hΦa, bores]
        exact inf_le_inf_right _ (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      have hPab : Y.basicOpen ((Y.presheaf.map (homOfLE (inf_le_right :
          L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ q ⁻¹ᵁ W)).op).hom Φ) ≤
            L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ T.basicOpen f := by
        rw [bores, ← hUΦ]
        exact le_inf (inf_le_left.trans inf_le_left) inf_le_right
      show (Y.presheaf.map (homOfLE (Y.basicOpen_le _)).op).hom _ = 0
      simp only [map_sub, map_mul, resres]
      rw [hz' b _ hPb, hz' a _ hPa]
      have hc' := congrArg (Y.presheaf.map (homOfLE hPab).op).hom (hu a b)
      rw [map_mul] at hc'
      simp only [resres] at hc'
      rw [hc']
      ring
    choose k hk using hstep2
    obtain ⟨kt, hkt⟩ : ∃ kt, kt = ∑ p : Fin L.m × Fin L.m, k p.1 p.2 + 1 := ⟨_, rfl⟩
    have hkle : ∀ a b, k a b ≤ kt := fun a b => by
      rw [hkt]
      exact (Finset.single_le_sum (f := fun p : Fin L.m × Fin L.m => k p.1 p.2)
        (fun i _ => Nat.zero_le _) (Finset.mem_univ (a, b))).trans (Nat.le_succ _)
    have hktpos : 0 < kt := by rw [hkt]; exact Nat.succ_pos _
    refine ⟨fun a => Φa a ^ kt * z a, ?_, ?_⟩
    · intro a b
      simp only [map_mul, map_pow, resres]
      rw [hΦres b, hΦres a]
      have hk' := hk a b
      simp only [map_pow] at hk'
      rw [← Nat.sub_add_cancel (hkle a b), pow_add]
      linear_combination (((Y.presheaf.map (homOfLE (inf_le_right :
        L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ q ⁻¹ᵁ W)).op).hom Φ) ^ (kt - k a b)) * hk'
    · intro a
      rw [Scheme.basicOpen_mul, Y.basicOpen_pow _ hktpos, ← bores (Y.basicOpen_le (Φa a)) (z a),
        h1 a, Scheme.basicOpen_mul, Y.basicOpen_pow _ hntpos,
        bores (Y.basicOpen_le (Φa a)) (Φa a), bores (hboΦa a).le (u a), inf_idem, ← inf_assoc,
        inf_idem]
      exact inf_eq_right.mpr ((Y.basicOpen_le _).trans (hboΦa a).ge)

  have s5 : ∀ (e r : ℕ) (B : Fin r → T.Opens), (⨆ i, B i) = W →
      ∀ (M : Fin r → ℕ) (s : ∀ i, Fin (M i + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
      (∀ i J, wcpaDjCompat L (q ⁻¹ᵁ W) e (s i J)) →
      (∀ i, (⨆ J, ⨆ a, Y.basicOpen (s i J a)) = q ⁻¹ᵁ B i) →
      (∀ i J, IsAffineOpen (⨆ a, Y.basicOpen (s i J a))) →
      (∀ i J, (q.appLE W (⨆ a, Y.basicOpen (s i J a))
        (iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right)).hom.FiniteType) →
      wcpaDjAmp q L W e := by
    intro e r B hB M s hc hcv haff hft
    let ε := (finSigmaFinEquiv (n := fun i => M i + 1))
    let t : Fin (∑ i, (M i + 1) + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W) :=
      Fin.cases (fun _ => 0) (fun j => s (ε.symm j).1 (ε.symm j).2)
    have ht0 : ∀ a, t 0 a = 0 := fun a => rfl
    have htS : ∀ j a, t j.succ a = s (ε.symm j).1 (ε.symm j).2 a := fun j a => by
      simp only [t, Fin.cases_succ]
    have hbot : (⨆ a, Y.basicOpen (t 0 a)) = ⊥ := by
      simp only [ht0, Scheme.basicOpen_zero, iSup_bot]
    have hDS : ∀ j, (⨆ a, Y.basicOpen (t j.succ a)) =
        ⨆ a, Y.basicOpen (s (ε.symm j).1 (ε.symm j).2 a) := fun j => by simp only [htS]
    refine ⟨∑ i, (M i + 1), t, ?_, ?_, ?_, ?_⟩
    · intro J
      induction J using Fin.cases with
      | zero =>
        intro a b
        simp only [ht0, map_zero, mul_zero]
      | succ j =>
        intro a b
        simp only [htS]
        exact hc _ _ a b
    · apply le_antisymm
      · exact iSup_le fun J => iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right
      · refine (congrArg (fun O => q ⁻¹ᵁ O) hB.symm).le.trans ?_
        rw [Scheme.Hom.preimage_iSup]
        refine iSup_le fun i => ?_
        rw [← hcv i]
        refine iSup_le fun Jx => le_trans ?_ (le_iSup _ (ε ⟨i, Jx⟩).succ)
        rw [hDS, Equiv.symm_apply_apply]
    · intro J
      induction J using Fin.cases with
      | zero =>
        rw [hbot]
        exact isAffineOpen_bot _
      | succ j =>
        rw [hDS]
        exact haff _ _
    · intro J
      induction J using Fin.cases with
      | zero =>
        have hsub : ∀ D : Y.Opens, D = ⊥ → Subsingleton Γ(Y, D) := by
          rintro D rfl
          infer_instance
        haveI := hsub _ hbot
        exact RingHom.FiniteType.of_surjective _ (fun x => ⟨0, Subsingleton.elim _ _⟩)
      | succ j =>
        have h := hft (ε.symm j).1 (ε.symm j).2
        exact ftc W _ _ _ _ (hDS j).symm h

  obtain ⟨r, f, hcov, hfN⟩ := s3 (fun N => ∃ e, 0 < e ∧ wcpaDjAmp q L N e) hloc
  choose N g _hNaff hPN hbo using hfN
  choose e he hamp using hPN
  have hamp₁ : ∀ i, wcpaDjAmp q L (T.basicOpen (f i)) (e i) := fun i => by
    rw [hbo i]
    exact s1 (N i) (e i) (hamp i) (g i)
  obtain ⟨E, hEdef⟩ : ∃ E, E = ∏ i, e i := ⟨_, rfl⟩
  have hE : 0 < E := by rw [hEdef]; exact Finset.prod_pos fun i _ => he i
  have hdvd : ∀ i, e i ∣ E := fun i => by rw [hEdef]; exact Finset.dvd_prod_of_mem e (Finset.mem_univ i)
  have hamp₂ : ∀ i, wcpaDjAmp q L (T.basicOpen (f i)) E := fun i => by
    have h := s4 _ (e i) (E / e i) (Nat.div_pos (Nat.le_of_dvd hE (hdvd i)) (he i)) (hamp₁ i)
    rwa [Nat.mul_div_cancel' (hdvd i)] at h
  unfold wcpaDjAmp at hamp₂
  choose M u hc hcv haff hft using hamp₂
  choose s hs hsb using fun i J => s2 (f i) E (u i J) (hc i J)
  have hDs : ∀ i J, (⨆ a, Y.basicOpen (s i J a)) = ⨆ a, Y.basicOpen (u i J a) :=
    fun i J => iSup_congr (hsb i J)
  refine ⟨E, hE, s5 E r (fun i => T.basicOpen (f i)) hcov M s hs ?_ ?_ ?_⟩
  · intro i
    simp only [hDs]
    exact hcv i
  · intro i J
    rw [hDs]
    exact haff i J
  · intro i J
    have hD : (⨆ a, Y.basicOpen (u i J a)) ≤ q ⁻¹ᵁ T.basicOpen (f i) := by
      exact (le_iSup (fun J => ⨆ a, Y.basicOpen (u i J a)) J).trans (hcv i).le
    have h1 : (q.appLE (T.basicOpen (f i)) _ hD).hom.FiniteType := hft i J
    exact ftc W _ _ _ _ (hDs i J).symm (s6 (f i) _ hD h1)

theorem wcpa_dj_lcp_sp_relative_ample : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S),
        ∃ e : ℕ, 0 < e ∧ wcpaDjVA (Limits.pullback.snd uu s)
          (wcpaDjCocPull (Limits.pullback.fst uu s) L) ⊤ e) →
    ∀ W : S.Opens, IsAffineOpen W → ∃ e : ℕ, 0 < e ∧ wcpaDjVA uu L W e :=
by
  intro k _ S Z sS hS uu huu L hL hfib W hW
  haveI := huu
  haveI hsSp : IsProper sS := wcpa_dj_proj_proper k sS hS

  have hpull : ∀ {Y' : Scheme.{u}} (h : Y' ⟶ Z), (∀ a, IsAffineOpen (h ⁻¹ᵁ L.V a)) →
      wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' h hA
    have key : ∀ (U V : Z.Opens) (r : V ≤ U) (O : Y'.Opens) (s2 : O ≤ h ⁻¹ᵁ V) (P : Y'.Opens)
        (i : P ⟶ h ⁻¹ᵁ U) (j : O ⟶ P) (x : Γ(Z, U)),
        (Y'.presheaf.map j.op).hom ((Y'.presheaf.map i.op).hom ((h.app U).hom x)) =
          (h.appLE V O s2).hom ((Z.presheaf.map (homOfLE r).op).hom x) := by
      intro U V r O s2 P i j x
      have e : h.app U ≫ Y'.presheaf.map i.op ≫ Y'.presheaf.map j.op =
          Z.presheaf.map (homOfLE r).op ≫ h.appLE V O s2 := by
        rw [← Functor.map_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
          Scheme.Hom.map_appLE]
      have e2 := congrArg (fun φ => φ.hom x) e
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e2
    refine ⟨hA, ?_, ?_, ?_⟩
    · show (⨆ a, h ⁻¹ᵁ L.V a) = ⊤
      rw [← Scheme.Hom.preimage_iSup, hL.2.1, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hL.2.2.1 a, map_one]
    · rintro (a : Fin L.m) (b : Fin L.m) (c : Fin L.m)
      have s2 : h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
        fun _ hx => hx
      have e := congrArg (h.appLE _ _ s2).hom (hL.2.2.2 a b c)
      rw [map_mul,
        ← key (L.V a ⊓ L.V b) _ _ _ s2 (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b) (homOfLE fun _ hx => hx)
          (homOfLE inf_le_left),
        ← key (L.V b ⊓ L.V c) _ _ _ s2 (h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c) (homOfLE fun _ hx => hx)
          (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right)),
        ← key (L.V a ⊓ L.V c) _ _ _ s2 (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V c) (homOfLE fun _ hx => hx)
          (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right))] at e
      exact e

  have hloc : ∀ y ∈ W, ∃ N : S.Opens, IsAffineOpen N ∧ y ∈ N ∧
      ∃ e : ℕ, 0 < e ∧ wcpaDjAmp uu L N e := by
    intro y _
    haveI : IsAffineHom (S.fromSpecResidueField y) := IsAffineHom.of_comp _ sS
    haveI : IsAffineHom (Limits.pullback.fst uu (S.fromSpecResidueField y)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip
        ‹_›
    have hqp : IsProper (Limits.pullback.snd uu (S.fromSpecResidueField y)) :=
      MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) huu
    have hA : ∀ a, IsAffineOpen (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a) :=
      fun a => (hL.1 a).preimage _
    have hLy := hpull (Limits.pullback.fst uu (S.fromSpecResidueField y)) hA
    have hAy : ∀ a, IsAffineOpen
        ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
          Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤) := by
      intro a
      rw [Scheme.Hom.preimage_top, inf_top_eq]
      exact hA a
    have hcoh := wcpa_dj_lcp_ra_fibre_cohvan k S Z sS hS uu huu L hL hfib y
    obtain ⟨e₁, he₁, hamp⟩ := wcpa_dj_lcp_ra_coh_to_amp (S.residueField y)
      (Limits.pullback uu (S.fromSpecResidueField y))
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) hqp _ hLy hcoh
    obtain ⟨e₂, he₂, hva⟩ := wcpa_dj_lcp_ra_amp_to_va
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) hqp _ hLy ⊤ (isAffineOpen_top _) hAy
      e₁ he₁ hamp
    obtain ⟨m, hm, hlift⟩ := wcpa_dj_lcp_ra_lift_sections k S Z sS hS uu huu L hL y e₂ he₂ hva
    obtain ⟨M, τ, hτ⟩ := wcpa_dj_lcp_ra_veronese
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) _ ⊤ e₂ m hm hva
    obtain ⟨N, σ, hyN, hσc, hσf⟩ := hlift M τ (fun J a b => hτ.1 J a b)
    have hem : 0 < e₂ * m := Nat.mul_pos he₂ hm
    obtain ⟨N', hN', hyN', -, hamp'⟩ := wcpa_dj_lcp_ra_local_amp k S Z sS hS uu huu L hL y N hyN
      (e₂ * m) M hem σ hσc τ hσf hτ
    exact ⟨N', hN', hyN', e₂ * m, hem, hamp'⟩

  have hAW : ∀ a, IsAffineOpen (L.V a ⊓ uu ⁻¹ᵁ W) := by
    intro a
    haveI : IsAffine (L.V a).toScheme := hL.1 a
    haveI : IsAffineHom ((L.V a).ι ≫ uu) := IsAffineHom.of_comp _ sS
    have h1 := (hW.preimage ((L.V a).ι ≫ uu)).image_of_isOpenImmersion (L.V a).ι
    rwa [Scheme.Hom.comp_preimage, Scheme.Hom.image_preimage_eq_opensRange_inf,
      Scheme.Opens.opensRange_ι] at h1

  obtain ⟨E, hE, hampW⟩ := wcpa_dj_lcp_ra_amp_glue uu inferInstance inferInstance L hL W hW hAW hloc
  exact wcpa_dj_lcp_ra_amp_to_va uu huu L hL W hW hAW E hE hampW

theorem wcpa_dj_tgl_pole : ∀ (K : Type u) [Field K] (N : ℕ) {Z : Scheme.{u}} [QuasiSeparatedSpace Z]
    (ℓ : Z ⟶ wcProjK K N) (m : ℕ) (V : Fin m → Z.Opens) (r : Fin (N + 1) → ℕ)
    (σ : ∀ i, Fin (r i) → ∀ b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)),
    wcpaTglCF K N → (∀ b j, IsCompact ((V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j : Z.Opens) : Set Z)) →
    ∃ (D : ℕ) (γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)),
      (∀ i c b, γ i c i b = σ i c b) ∧ wcpaTglR1 ℓ V σ D γ :=
by
  intro K _ N Z _ ℓ m V r σ hCF hcpt
  classical
  have gen : ∀ {Y : Scheme.{u}} (Dd : Fin (N + 1) → Y.Opens) (e : ∀ j (_ : Fin (N + 1)), Γ(Y, Dd j))
      (ℓ : Z ⟶ Y) (σ : ∀ i, Fin (r i) → ∀ b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ Dd i)),
      (∀ j, e j j = 1) → (∀ j p, Y.basicOpen (e j p) = Dd j ⊓ Dd p) →
      (∀ b j, IsCompact ((V b ⊓ ℓ ⁻¹ᵁ Dd j : Z.Opens) : Set Z)) →
      ∃ (D : ℕ) (γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ Dd j)),
        (∀ i c b, γ i c i b = σ i c b) ∧ ∀ i (c : Fin (r i)) j b,
      Z.presheaf.map (homOfLE (inf_le_left : V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓ ℓ ⁻¹ᵁ Dd i ≤
          V b ⊓ ℓ ⁻¹ᵁ Dd j)).op (γ i c j b) =
        Z.presheaf.map (homOfLE (inf_le_left.trans inf_le_right : V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓
            ℓ ⁻¹ᵁ Dd i ≤ ℓ ⁻¹ᵁ Dd j)).op (ℓ.app (Dd j) (e j i)) ^ D *
          Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓ ℓ ⁻¹ᵁ Dd i ≤ V b ⊓ ℓ ⁻¹ᵁ Dd i)).op (σ i c b) := by
    intro Y Dd e ℓ σ h1 h2 hcpt
    have hbo : ∀ i j b, Z.basicOpen (Z.presheaf.map (homOfLE (inf_le_right :
        V b ⊓ ℓ ⁻¹ᵁ Dd j ≤ ℓ ⁻¹ᵁ Dd j)).op (ℓ.app (Dd j) (e j i))) =
        V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓ ℓ ⁻¹ᵁ Dd i := by
      intro i j b
      rw [Scheme.basicOpen_res, ← Scheme.preimage_basicOpen, h2, Scheme.Hom.preimage_inf]
      exact le_antisymm (le_inf inf_le_left (inf_le_right.trans inf_le_right))
        (le_inf inf_le_left (le_inf (inf_le_left.trans inf_le_right) inf_le_right))
    have s2 : ∀ (A B Q : Z.Opens) (hQA : Q ≤ A) (hQB : Q ≤ B), IsCompact (A : Set Z) →
        ∀ f : Γ(Z, A), Z.basicOpen f = Q → ∀ z : Γ(Z, B), ∃ (n : ℕ) (y : Γ(Z, A)),
          Z.presheaf.map (homOfLE hQA).op y =
            (Z.presheaf.map (homOfLE hQA).op f) ^ n * Z.presheaf.map (homOfLE hQB).op z := by
      intro A B Q hQA hQB hc f hQ z
      subst hQ
      obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isCompact_of_isQuasiSeparated Z A hc
        (IsQuasiSeparated.of_quasiSeparatedSpace _) f (Z.presheaf.map (homOfLE hQB).op z)
      exact ⟨n, y, hy⟩
    have hres : ∀ {U1 U2 U3 : Z.Opens} (h1 : U1 ≤ U2) (h2 : U2 ≤ U3) (x : Γ(Z, U3)),
        Z.presheaf.map (homOfLE h1).op (Z.presheaf.map (homOfLE h2).op x) =
          Z.presheaf.map (homOfLE (h1.trans h2)).op x := by
      intro U1 U2 U3 h1 h2 x
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    have hclear : ∀ i (c : Fin (r i)) j b, ∃ (n : ℕ) (y : Γ(Z, V b ⊓ ℓ ⁻¹ᵁ Dd j)),
        Z.presheaf.map (homOfLE (inf_le_left : V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓ ℓ ⁻¹ᵁ Dd i ≤
          V b ⊓ ℓ ⁻¹ᵁ Dd j)).op y =
        Z.presheaf.map (homOfLE (inf_le_left.trans inf_le_right : V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓
            ℓ ⁻¹ᵁ Dd i ≤ ℓ ⁻¹ᵁ Dd j)).op (ℓ.app (Dd j) (e j i)) ^ n *
          Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓ ℓ ⁻¹ᵁ Dd i ≤ V b ⊓ ℓ ⁻¹ᵁ Dd i)).op (σ i c b) := by
      intro i c j b
      obtain ⟨n, y, hy⟩ := s2 (V b ⊓ ℓ ⁻¹ᵁ Dd j) (V b ⊓ ℓ ⁻¹ᵁ Dd i)
        (V b ⊓ ℓ ⁻¹ᵁ Dd j ⊓ ℓ ⁻¹ᵁ Dd i) inf_le_left
        (le_inf (inf_le_left.trans inf_le_left) inf_le_right) (hcpt b j) _ (hbo i j b) (σ i c b)
      refine ⟨n, y, ?_⟩
      rw [hy, hres]
    choose n y hy using hclear
    let D : ℕ := Finset.univ.sup
      (fun p : (Σ i, Fin (r i)) × Fin (N + 1) × Fin m => n p.1.1 p.1.2 p.2.1 p.2.2)
    have hle : ∀ i c j b, n i c j b ≤ D := fun i c j b =>
      Finset.le_sup
        (f := fun p : (Σ i, Fin (r i)) × Fin (N + 1) × Fin m => n p.1.1 p.1.2 p.2.1 p.2.2)
        (Finset.mem_univ ⟨⟨i, c⟩, j, b⟩)
    let γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ Dd j) := fun i c j b =>
      if h : i = j then h ▸ σ i c b
      else Z.presheaf.map (homOfLE (inf_le_right : V b ⊓ ℓ ⁻¹ᵁ Dd j ≤ ℓ ⁻¹ᵁ Dd j)).op
        (ℓ.app (Dd j) (e j i)) ^ (D - n i c j b) * y i c j b
    have hdiag : ∀ i c b, γ i c i b = σ i c b := by
      intro i c b
      show (if h : i = i then h ▸ σ i c b else _) = _
      rw [dif_pos rfl]
    refine ⟨D, γ, hdiag, ?_⟩
    intro i c j b
    by_cases h : i = j
    · subst h
      rw [hdiag, h1, map_one, map_one, one_pow, one_mul]
    · have hγ : γ i c j b = Z.presheaf.map (homOfLE (inf_le_right :
          V b ⊓ ℓ ⁻¹ᵁ Dd j ≤ ℓ ⁻¹ᵁ Dd j)).op
          (ℓ.app (Dd j) (e j i)) ^ (D - n i c j b) * y i c j b := dif_neg h
      rw [hγ, map_mul, map_pow, hres, hy, ← mul_assoc, ← pow_add,
        Nat.sub_add_cancel (hle i c j b)]
  exact gen (wcSgD K N) (wcSgE K N) ℓ σ (fun j => (hCF j j j).1)
    (fun j p => (hCF j p j).2.1) hcpt

theorem wcpa_dj_tgl_fix : ∀ (K : Type u) [Field K] (N : ℕ) {Z : Scheme.{u}} [QuasiSeparatedSpace Z]
    (ℓ : Z ⟶ wcProjK K N) (L : wcpaDjCoc Z) (E : ℕ) (r : Fin (N + 1) → ℕ)
    (σ : ∀ i, Fin (r i) → ∀ b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)) (D : ℕ)
    (γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)),
    wcpaTglCF K N →
    (∀ b j b' j', IsCompact (((L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓ (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') :
      Z.Opens) : Set Z)) →
    (∀ i (c : Fin (r i)) (a b : Fin L.m),
      Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          L.V a ⊓ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)).op (σ i c b) =
        Z.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i ≤
            L.V a ⊓ L.V b)).op ((L.g a b : Γ(Z, L.V a ⊓ L.V b)) ^ E) *
          Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            L.V a ⊓ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i ≤ L.V a ⊓ ℓ ⁻¹ᵁ wcSgD K N i)).op (σ i c a)) →
    (∀ i c b, γ i c i b = σ i c b) → wcpaTglR1 ℓ L.V σ D γ →
    ∃ (D' : ℕ) (γ' : ∀ i, Fin (r i) → ∀ j b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)),
      (∀ i c b, γ' i c i b = σ i c b) ∧ wcpaTglR1 ℓ L.V σ D' γ' ∧ wcpaTglR2 ℓ L E D' γ' :=
by
  intro K _ N Z _ ℓ L E r σ D γ hcf hcpt hcompat hdiag hR1
  classical
  have hres : ∀ {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Z, A)),
      Z.presheaf.map (homOfLE h2).op (Z.presheaf.map (homOfLE h1).op x) =
        Z.presheaf.map (homOfLE (h2.trans h1)).op x := by
    intro A B C h1 h2 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hcoc : ∀ (j i i' : Fin (N + 1)) (O : Z.Opens) (h1 : O ≤ ℓ ⁻¹ᵁ wcSgD K N j)
      (h2 : O ≤ ℓ ⁻¹ᵁ wcSgD K N i),
      Z.presheaf.map (homOfLE h1).op (wcpaTglEps ℓ j i') =
        Z.presheaf.map (homOfLE h1).op (wcpaTglEps ℓ j i) *
          Z.presheaf.map (homOfLE h2).op (wcpaTglEps ℓ i i') := by
    intro j i i' O h1 h2
    have hO : O ≤ ℓ ⁻¹ᵁ (wcSgD K N j ⊓ wcSgD K N i) := by
      rw [Scheme.Hom.preimage_inf]; exact le_inf h1 h2
    have key : ∀ (V : (wcProjK K N).Opens) (hV : wcSgD K N j ⊓ wcSgD K N i ≤ V)
        (hV' : O ≤ ℓ ⁻¹ᵁ V) (x : Γ(wcProjK K N, V)),
        Z.presheaf.map (homOfLE hV').op (ℓ.app V x) =
          ℓ.appLE (wcSgD K N j ⊓ wcSgD K N i) O hO
            ((wcProjK K N).presheaf.map (homOfLE hV).op x) := by
      intro V hV hV' x
      rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, Scheme.Hom.map_appLE]
      rfl
    show Z.presheaf.map (homOfLE h1).op (ℓ.app (wcSgD K N j) (wcSgE K N j i')) =
        Z.presheaf.map (homOfLE h1).op (ℓ.app (wcSgD K N j) (wcSgE K N j i)) *
          Z.presheaf.map (homOfLE h2).op (ℓ.app (wcSgD K N i) (wcSgE K N i i'))
    rw [key (wcSgD K N j) inf_le_left h1, key (wcSgD K N j) inf_le_left h1,
      key (wcSgD K N i) inf_le_right h2, ← map_mul, (hcf j i i').2.2]
  have hbo0 : ∀ (j i' : Fin (N + 1)),
      Z.basicOpen (wcpaTglEps ℓ j i') = ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N i' := by
    intro j i'
    show Z.basicOpen (ℓ.app (wcSgD K N j) (wcSgE K N j i')) = _
    rw [← Scheme.preimage_basicOpen, (hcf j i' j).2.1, Scheme.Hom.preimage_inf]
  have hbo : ∀ (j i' : Fin (N + 1)) (O : Z.Opens) (h : O ≤ ℓ ⁻¹ᵁ wcSgD K N j),
      Z.basicOpen (Z.presheaf.map (homOfLE h).op (wcpaTglEps ℓ j i')) =
        O ⊓ ℓ ⁻¹ᵁ wcSgD K N i' := by
    intro j i' O h
    rw [Scheme.basicOpen_res, hbo0, ← inf_assoc, inf_eq_left.mpr h]
  have hR1O : ∀ i (c : Fin (r i)) (j : Fin (N + 1)) (b : Fin L.m) (O : Z.Opens)
      (hj : O ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) (hε : O ≤ ℓ ⁻¹ᵁ wcSgD K N j)
      (hi : O ≤ ℓ ⁻¹ᵁ wcSgD K N i) (hσ : O ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i),
      Z.presheaf.map (homOfLE hj).op (γ i c j b) =
        Z.presheaf.map (homOfLE hε).op (wcpaTglEps ℓ j i) ^ D *
          Z.presheaf.map (homOfLE hσ).op (σ i c b) := by
    intro i c j b O hj hε hi hσ
    have h := congrArg (fun x => Z.presheaf.map (homOfLE (le_inf hj hi)).op x) (hR1 i c j b)
    simp only [map_mul, map_pow] at h
    rw [hres, hres, hres] at h
    exact h
  have hCO : ∀ i (c : Fin (r i)) (a b : Fin L.m) (O : Z.Opens)
      (hO : O ≤ L.V a ⊓ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i) (hb : O ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)
      (hg : O ≤ L.V a ⊓ L.V b) (ha : O ≤ L.V a ⊓ ℓ ⁻¹ᵁ wcSgD K N i),
      Z.presheaf.map (homOfLE hb).op (σ i c b) =
        Z.presheaf.map (homOfLE hg).op (L.g a b : Γ(Z, L.V a ⊓ L.V b)) ^ E *
          Z.presheaf.map (homOfLE ha).op (σ i c a) := by
    intro i c a b O hO hb hg ha
    have h := congrArg (fun x => Z.presheaf.map (homOfLE hO).op x) (hcompat i c a b)
    simp only [map_mul, map_pow] at h
    rw [hres, hres, hres] at h
    exact h
  have hkill : ∀ i (c : Fin (r i)) (b : Fin L.m) (j : Fin (N + 1)) (b' : Fin L.m)
      (j' : Fin (N + 1)), ∃ n : ℕ,
      Z.presheaf.map (homOfLE (inf_le_right.trans inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ ℓ ⁻¹ᵁ wcSgD K N j')).op (wcpaTglEps ℓ j' i) ^ n *
      (Z.presheaf.map (homOfLE (inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
        (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j')).op (γ i c j' b') -
      Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
          (inf_le_right.trans inf_le_left) : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b ⊓ L.V b')).op
          ((L.g b b' : Γ(Z, L.V b ⊓ L.V b')) ^ E) *
        Z.presheaf.map (homOfLE (inf_le_right.trans inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ ℓ ⁻¹ᵁ wcSgD K N j')).op (wcpaTglEps ℓ j' j) ^ D *
        Z.presheaf.map (homOfLE (inf_le_left : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)).op (γ i c j b)) = 0 := by
    intro i c b j b' j'
    refine exists_of_res_zero_of_qcqs (hcpt b j b' j')
      (IsQuasiSeparated.of_quasiSeparatedSpace _) ?_
    have hW' := hbo j' i ((L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓ (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j'))
      (inf_le_right.trans inf_le_right)
    have hB := hW'.le
    have hB1 := hB.trans (inf_le_left.trans inf_le_right)
    have hBε' := hB.trans (inf_le_left.trans (inf_le_right.trans inf_le_right))
    have hBi := hB.trans inf_le_right
    have hBσ' := hB.trans (le_inf (inf_le_left.trans (inf_le_right.trans inf_le_left))
      inf_le_right)
    have hBj := hB.trans (inf_le_left.trans inf_le_left)
    have hBε := hB.trans (inf_le_left.trans (inf_le_left.trans inf_le_right))
    have hBσ := hB.trans (le_inf (inf_le_left.trans (inf_le_left.trans inf_le_left))
      inf_le_right)
    have hBg := hB.trans (le_inf (inf_le_left.trans (inf_le_left.trans inf_le_left))
      (inf_le_left.trans (inf_le_right.trans inf_le_left)))
    have hBC := hB.trans (le_inf (le_inf (inf_le_left.trans (inf_le_left.trans inf_le_left))
      (inf_le_left.trans (inf_le_right.trans inf_le_left))) inf_le_right)
    show Z.presheaf.map (homOfLE (Z.basicOpen_le _)).op _ = 0
    simp only [map_sub, map_mul, map_pow, hres]
    rw [hR1O i c j' b' _ hB1 hBε' hBi hBσ', hR1O i c j b _ hBj hBε hBi hBσ,
      hCO i c b b' _ hBC hBσ' hBg hBσ, hcoc j' j i _ hBε' hBε]
    ring
  choose n hn using hkill
  obtain ⟨n₀, hle⟩ : ∃ n₀ : ℕ, ∀ i c b j b' j', n i c b j b' j' ≤ n₀ :=
    ⟨Finset.univ.sup (fun t : (Σ i, Fin (r i)) × Fin L.m × Fin (N + 1) × Fin L.m × Fin (N + 1) =>
        n t.1.1 t.1.2 t.2.1 t.2.2.1 t.2.2.2.1 t.2.2.2.2),
      fun i c b j b' j' => Finset.le_sup
        (f := fun t : (Σ i, Fin (r i)) × Fin L.m × Fin (N + 1) × Fin L.m × Fin (N + 1) =>
          n t.1.1 t.1.2 t.2.1 t.2.2.1 t.2.2.2.1 t.2.2.2.2)
        (Finset.mem_univ (⟨i, c⟩, b, j, b', j'))⟩
  refine ⟨D + n₀, fun i c j b =>
    Z.presheaf.map (homOfLE (inf_le_right : L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ≤ ℓ ⁻¹ᵁ wcSgD K N j)).op
      (wcpaTglEps ℓ j i) ^ n₀ * γ i c j b, ?_, ?_, ?_⟩
  · intro i c b
    dsimp only
    have h1 : wcpaTglEps ℓ i i = 1 := by
      show ℓ.app (wcSgD K N i) (wcSgE K N i i) = 1
      rw [(hcf i i i).1, map_one]
    rw [h1, map_one, one_pow, one_mul, hdiag]
  · intro i c j b
    dsimp only
    simp only [map_mul, map_pow, hres]
    rw [hR1 i c j b]
    ring
  · intro i c b j b' j'
    dsimp only
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (hle i c b j b' j')
    have h := hn i c b j b' j'
    simp only [map_mul, map_pow, hres] at h ⊢
    rw [hcoc j' j i _ (inf_le_right.trans inf_le_right) (inf_le_left.trans inf_le_right)] at h ⊢
    rw [hk]
    linear_combination
      (Z.presheaf.map (homOfLE (inf_le_right.trans inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ ℓ ⁻¹ᵁ wcSgD K N j')).op (wcpaTglEps ℓ j' j) *
        Z.presheaf.map (homOfLE (inf_le_left.trans inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j i)) ^ k * h

theorem wcpa_dj_tgl_glue : ∀ (K : Type u) [Field K] (N : ℕ) {Z : Scheme.{u}}
    (ℓ : Z ⟶ wcProjK K N) (L : wcpaDjCoc Z) (E : ℕ) (r : Fin (N + 1) → ℕ)
    (σ : ∀ i, Fin (r i) → ∀ b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)) (D : ℕ)
    (γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)),
    wcpaTglCF K N → (⨆ a : Fin (N + 1), wcSgD K N a) = ⊤ → (⨆ a, L.V a) = ⊤ →
    (∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (I : Type) (U : I → X.Opens),
      (⨆ i, U i) = ⊤ → ∀ (s : ∀ i, Fin (n + 1) → Γ(X, U i)),
      (∀ i, Ideal.span (Set.range (s i)) = ⊤) → ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)),
      (∀ i j, IsUnit (w i j)) →
      (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
        w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) →
      ∃ φ : X ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fX ∧
        (∀ i J, φ ⁻¹ᵁ wcSgD K n J ⊓ U i = X.basicOpen (s i J)) ∧
        ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J) (hOi : O ≤ U i),
          φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) * X.presheaf.map (homOfLE hOi).op (s i J) =
            X.presheaf.map (homOfLE hOi).op (s i L)) →
    (∀ i, 0 < r i) → (∀ i c b, γ i c i b = σ i c b) → wcpaTglR2 ℓ L E D γ →
    (∀ j b, Ideal.span (Set.range (fun c => σ j c b)) = ⊤) →
    ∃ (M' : ℕ) (ψ : Z ⟶ wcProjK K M') (κ : ∀ i, Fin (N + 1) → Fin (r i) → Fin (M' + 1)),
      ψ ≫ wcProjKStr K M' = ℓ ≫ wcProjKStr K N ∧
      (∀ i p c b j, ψ ⁻¹ᵁ wcSgD K M' (κ i p c) ⊓ (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) =
        Z.basicOpen (Z.presheaf.map (homOfLE (inf_le_right : L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ≤
          ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j p) * γ i c j b)) ∧
      ∀ (b : Fin L.m) (j i p : Fin (N + 1)) (c : Fin (r i)) (i' p' : Fin (N + 1)) (c' : Fin (r i'))
        (O : Z.Opens) (hO : O ≤ ψ ⁻¹ᵁ wcSgD K M' (κ i p c)) (hOi : O ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j),
        ψ.appLE (wcSgD K M' (κ i p c)) O hO (wcSgE K M' (κ i p c) (κ i' p' c')) *
            Z.presheaf.map (homOfLE hOi).op (Z.presheaf.map (homOfLE (inf_le_right :
              L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ≤ ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j p) * γ i c j b) =
          Z.presheaf.map (homOfLE hOi).op (Z.presheaf.map (homOfLE (inf_le_right :
              L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ≤ ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j p') *
            γ i' c' j b) :=
by
  intro K _ N Z ℓ L E r σ D γ HS hcov hLcov HUP hr hdiag hR2 hspan

  have hresA : ∀ (D' : (wcProjK K N).Opens) (A : Z.Opens) (hA : A ≤ ℓ ⁻¹ᵁ D')
      (x : Γ(wcProjK K N, D')),
      Z.presheaf.map (homOfLE hA).op (ℓ.app D' x) = ℓ.appLE D' A hA x := by
    intro D' A hA x
    rw [Scheme.Hom.app_eq_appLE, ← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
  have hres : ∀ {U1 U2 U3 : Z.Opens} (h1 : U1 ≤ U2) (h2 : U2 ≤ U3) (x : Γ(Z, U3)),
      Z.presheaf.map (homOfLE h1).op (Z.presheaf.map (homOfLE h2).op x) =
        Z.presheaf.map (homOfLE (h1.trans h2)).op x := by
    intro U1 U2 U3 h1 h2 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have happ : ∀ {D' : (wcProjK K N).Opens} {V1 V2 : Z.Opens} (h1 : V1 ≤ ℓ ⁻¹ᵁ D')
      (h2 : V2 ≤ V1) (x : Γ(wcProjK K N, D')),
      Z.presheaf.map (homOfLE h2).op (ℓ.appLE D' V1 h1 x) = ℓ.appLE D' V2 (h2.trans h1) x := by
    intro D' V1 V2 h1 h2 x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]

  have cocyc : ∀ (J L' : Fin (N + 1)) (W : Z.Opens)
      (hJ : W ≤ ℓ ⁻¹ᵁ wcSgD K N J) (hL : W ≤ ℓ ⁻¹ᵁ wcSgD K N L'),
      (∀ j, ℓ.appLE (wcSgD K N J) W hJ (wcSgE K N J j) =
        ℓ.appLE (wcSgD K N J) W hJ (wcSgE K N J L') *
          ℓ.appLE (wcSgD K N L') W hL (wcSgE K N L' j)) ∧
      ℓ.appLE (wcSgD K N J) W hJ (wcSgE K N J L') *
        ℓ.appLE (wcSgD K N L') W hL (wcSgE K N L' J) = 1 := by
    intro J L' W hJ hL
    have hMle : W ≤ ℓ ⁻¹ᵁ (wcSgD K N J ⊓ wcSgD K N L') := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf hJ hL
    have K1 : ∀ x, ℓ.appLE (wcSgD K N J) W hJ x = ℓ.appLE _ W hMle
        ((wcProjK K N).presheaf.map
          (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L' ≤ wcSgD K N J)).op x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have K2 : ∀ x, ℓ.appLE (wcSgD K N L') W hL x = ℓ.appLE _ W hMle
        ((wcProjK K N).presheaf.map
          (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L' ≤ wcSgD K N L')).op x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have hc : ∀ j, ℓ.appLE (wcSgD K N J) W hJ (wcSgE K N J j) =
        ℓ.appLE (wcSgD K N J) W hJ (wcSgE K N J L') *
          ℓ.appLE (wcSgD K N L') W hL (wcSgE K N L' j) := by
      intro j
      rw [K1 (wcSgE K N J j), K1 (wcSgE K N J L'), K2 (wcSgE K N L' j), (HS J L' j).2.2, map_mul]
    refine ⟨hc, ?_⟩
    rw [← hc J, (HS J L' J).1, map_one]

  have hT : 0 < Fintype.card (Σ i : Fin (N + 1), Fin (N + 1) × Fin (r i)) :=
    Fintype.card_pos_iff.mpr ⟨⟨0, (0, ⟨0, hr 0⟩)⟩⟩
  obtain ⟨M', ⟨e⟩⟩ : ∃ M' : ℕ,
      Nonempty ((Σ i : Fin (N + 1), Fin (N + 1) × Fin (r i)) ≃ Fin (M' + 1)) := by
    refine ⟨Fintype.card (Σ i : Fin (N + 1), Fin (N + 1) × Fin (r i)) - 1,
      ⟨(Fintype.equivFin _).trans (finCongr ?_)⟩⟩
    omega

  have hU : (⨆ x : Fin L.m × Fin (N + 1), L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz1 : z ∈ ⨆ a, L.V a := by rw [hLcov]; trivial
    have hz2 : z ∈ ⨆ l, ℓ ⁻¹ᵁ wcSgD K N l := by
      rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hz1
    obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hz2
    have hz : z ∈ L.V a ⊓ ℓ ⁻¹ᵁ wcSgD K N l := ⟨ha, hl⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(a, l), hz⟩

  obtain ⟨s, ev⟩ : ∃ s : ∀ x : Fin L.m × Fin (N + 1), Fin (M' + 1) →
      Γ(Z, L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2),
      ∀ b j i p c, s (b, j) (e ⟨i, (p, c)⟩) =
        Z.presheaf.map (homOfLE (inf_le_right : L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ≤
          ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j p) * γ i c j b := by
    refine ⟨fun x J => Z.presheaf.map (homOfLE (inf_le_right : L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2 ≤
          ℓ ⁻¹ᵁ wcSgD K N x.2)).op (wcpaTglEps ℓ x.2 (e.symm J).2.1) *
        γ (e.symm J).1 (e.symm J).2.2 x.2 x.1, ?_⟩
    intro b j i p c
    dsimp only
    rw [Equiv.symm_apply_apply]

  have hone : ∀ j, wcpaTglEps ℓ j j = 1 := fun j => by
    show ℓ.app (wcSgD K N j) (wcSgE K N j j) = 1
    rw [(HS j j j).1, map_one]
  have hspanU : ∀ x : Fin L.m × Fin (N + 1), Ideal.span (Set.range (s x)) = ⊤ := by
    rintro ⟨b, j⟩
    have h1 : Ideal.span (Set.range (fun c => σ j c b)) ≤ Ideal.span (Set.range (s (b, j))) := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      apply Ideal.subset_span
      exact ⟨e ⟨j, (j, c)⟩, by rw [ev, hone, map_one, one_mul, hdiag]⟩
    rw [hspan j b] at h1
    exact top_le_iff.mp h1

  obtain ⟨w, hwdef⟩ : ∃ w : ∀ x x' : Fin L.m × Fin (N + 1),
      Γ(Z, (L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) ⊓ (L.V x'.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x'.2)),
      ∀ b j b' j', w (b, j) (b', j') =
        Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
          (inf_le_right.trans inf_le_left) : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b ⊓ L.V b')).op
          ((L.g b b' : Γ(Z, L.V b ⊓ L.V b')) ^ E) *
        Z.presheaf.map (homOfLE (inf_le_right.trans inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ ℓ ⁻¹ᵁ wcSgD K N j')).op (wcpaTglEps ℓ j' j) ^ (D + 1) :=
    ⟨fun x x' => Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
          (inf_le_right.trans inf_le_left) : (L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) ⊓
          (L.V x'.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x'.2) ≤ L.V x.1 ⊓ L.V x'.1)).op
          ((L.g x.1 x'.1 : Γ(Z, L.V x.1 ⊓ L.V x'.1)) ^ E) *
        Z.presheaf.map (homOfLE (inf_le_right.trans inf_le_right : (L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) ⊓
          (L.V x'.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x'.2) ≤ ℓ ⁻¹ᵁ wcSgD K N x'.2)).op
            (wcpaTglEps ℓ x'.2 x.2) ^ (D + 1),
     fun _ _ _ _ => rfl⟩
  have hw : ∀ x x' : Fin L.m × Fin (N + 1), IsUnit (w x x') := by
    rintro ⟨b, j⟩ ⟨b', j'⟩
    rw [hwdef]
    refine IsUnit.mul (IsUnit.map _ ((Units.isUnit (L.g b b')).pow E)) (IsUnit.pow _ ?_)
    simp only [wcpaTglEps, hresA]
    exact isUnit_iff_exists_inv.mpr ⟨_, (cocyc j' j
      ((L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓ (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j'))
      (inf_le_right.trans inf_le_right) (inf_le_left.trans inf_le_right)).2⟩

  have htr : ∀ (x x' : Fin L.m × Fin (N + 1)) (J : Fin (M' + 1)),
      Z.presheaf.map (homOfLE (inf_le_right : (L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) ⊓
          (L.V x'.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x'.2) ≤ L.V x'.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x'.2)).op (s x' J) =
        w x x' * Z.presheaf.map (homOfLE (inf_le_left : (L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) ⊓
          (L.V x'.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x'.2) ≤ L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2)).op (s x J) := by
    rintro ⟨b, j⟩ ⟨b', j'⟩ J
    obtain ⟨⟨i, p, c⟩, rfl⟩ := e.surjective J
    dsimp only
    rw [ev, ev, hwdef]
    simp only [map_mul]
    rw [hR2 i c b j b' j']
    simp only [wcpaTglEps, hres, hresA, happ]
    rw [(cocyc j' j ((L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓ (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j'))
      (inf_le_right.trans inf_le_right) (inf_le_left.trans inf_le_right)).1 p]
    ring

  obtain ⟨ψ, G1, G2, G3⟩ := HUP M' Z (ℓ ≫ wcProjKStr K N) (Fin L.m × Fin (N + 1))
    (fun x => L.V x.1 ⊓ ℓ ⁻¹ᵁ wcSgD K N x.2) hU s hspanU w hw htr
  refine ⟨M', ψ, fun i p c => e ⟨i, (p, c)⟩, G1, ?_, ?_⟩
  · intro i p c b j
    have h := G2 (b, j) (e ⟨i, (p, c)⟩)
    rw [ev] at h
    exact h
  · intro b j i p c i' p' c' O hO hOi
    have h := G3 (b, j) (e ⟨i, (p, c)⟩) (e ⟨i', (p', c')⟩) O hO hOi
    rw [ev, ev] at h
    exact h

theorem wcpa_dj_tgl_chart_preimage : ∀ (K : Type u) [Field K] (N : ℕ) {Z : Scheme.{u}}
    (ℓ : Z ⟶ wcProjK K N) (L : wcpaDjCoc Z) (r : Fin (N + 1) → ℕ)
    (σ : ∀ i, Fin (r i) → ∀ b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)) (D : ℕ)
    (γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)) (M' : ℕ)
    (ψ : Z ⟶ wcProjK K M') (κ : ∀ i, Fin (N + 1) → Fin (r i) → Fin (M' + 1)),
    wcpaTglCF K N → (⨆ a : Fin (N + 1), wcSgD K N a) = ⊤ → (⨆ a, L.V a) = ⊤ →
    wcpaTglR1 ℓ L.V σ D γ →
    (∀ i p c b j, ψ ⁻¹ᵁ wcSgD K M' (κ i p c) ⊓ (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) =
      Z.basicOpen (Z.presheaf.map (homOfLE (inf_le_right : L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ≤
        ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j p) * γ i c j b)) →
    ∀ l c₀, ψ ⁻¹ᵁ wcSgD K M' (κ l l c₀) = ⨆ b, Z.basicOpen (σ l c₀ b) :=
by
  intro K _ N Z ℓ L r σ D γ M' ψ κ hCF hcov hLcov hR1 hG2 l c₀
  have s1 : ∀ j, Z.basicOpen (wcpaTglEps ℓ j l) = ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N l := by
    intro j
    show Z.basicOpen (ℓ.app (wcSgD K N j) (wcSgE K N j l)) = _
    rw [← Scheme.preimage_basicOpen, (hCF j l l).2.1, Scheme.Hom.preimage_inf]
  have s5 : ∀ j b, ψ ⁻¹ᵁ wcSgD K M' (κ l l c₀) ⊓ (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) =
      ℓ ⁻¹ᵁ wcSgD K N j ⊓ Z.basicOpen (σ l c₀ b) := by
    intro j b
    have hσle : Z.basicOpen (σ l c₀ b) ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N l := Z.basicOpen_le _
    have hpow : Z.basicOpen ((Z.presheaf.map (homOfLE (inf_le_left.trans inf_le_right :
        L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N l ≤ ℓ ⁻¹ᵁ wcSgD K N j)).op
          (wcpaTglEps ℓ j l)) ^ D) = L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N l := by
      rcases Nat.eq_zero_or_pos D with rfl | hD
      · rw [pow_zero, Scheme.basicOpen_one]
      · rw [Scheme.basicOpen_pow Z _ hD, Scheme.basicOpen_res, s1]
        apply le_antisymm
        · exact inf_le_left
        · intro x hx
          exact ⟨hx, hx.1.2, hx.2⟩
    have h := congrArg Z.basicOpen (hR1 l c₀ j b)
    rw [Scheme.basicOpen_res, Scheme.basicOpen_mul, hpow, Scheme.basicOpen_res] at h
    rw [hG2 l l c₀ b j, Scheme.basicOpen_mul, Scheme.basicOpen_res, s1]
    apply le_antisymm
    · rintro x ⟨⟨⟨hb, hj⟩, -, hl⟩, hγ⟩
      have hx : x ∈ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N l ⊓
          Z.basicOpen (γ l c₀ j b) := ⟨⟨⟨hb, hj⟩, hl⟩, hγ⟩
      have hx2 := h.le hx
      exact ⟨hj, hx2.2.2⟩
    · rintro x ⟨hj, hσ⟩
      have hx' := hσle hσ
      have hx : x ∈ (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N l) ⊓
          ((L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N l) ⊓ Z.basicOpen (σ l c₀ b)) :=
        ⟨⟨⟨hx'.1, hj⟩, hx'.2⟩, ⟨⟨hx'.1, hj⟩, hx'.2⟩, hσ⟩
      have hx2 := h.ge hx
      exact ⟨⟨⟨hx'.1, hj⟩, hj, hx'.2⟩, hx2.2⟩
  apply le_antisymm
  · intro x hx
    have hx1 : x ∈ ⨆ a, L.V a := by rw [hLcov]; trivial
    have hx2 : x ∈ ⨆ a, ℓ ⁻¹ᵁ wcSgD K N a := by
      rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]; trivial
    obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hx1
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx2
    have hx3 : x ∈ ψ ⁻¹ᵁ wcSgD K M' (κ l l c₀) ⊓ (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) := ⟨hx, hb, hj⟩
    rw [s5 j b] at hx3
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨b, hx3.2⟩
  · intro x hx
    obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    have hVb := Z.basicOpen_le (σ l c₀ b) hb
    have hx3 : x ∈ ℓ ⁻¹ᵁ wcSgD K N l ⊓ Z.basicOpen (σ l c₀ b) := ⟨hVb.2, hb⟩
    rw [← s5 l b] at hx3
    exact hx3.1

theorem wcpa_dj_tgl_chart_surj : ∀ (K : Type u) [Field K] (N M' : ℕ) {S Z : Scheme.{u}}
    (ιS : S ⟶ wcProjK K N) (uu : Z ⟶ S) (ψ : Z ⟶ wcProjK K M') (l : Fin (N + 1))
    (T₀ : Fin (M' + 1)) (κ' : Fin (N + 1) → Fin (M' + 1)) (Ml : ℕ)
    (lam : Fin (Ml + 1) → Fin (M' + 1)) (L : wcpaDjCoc Z)
    (t : Fin (Ml + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ (ιS ⁻¹ᵁ wcSgD K N l)))
    (J : Fin (Ml + 1)) (hD : (⨆ a, Z.basicOpen (t J a)) ≤ ψ ⁻¹ᵁ wcSgD K M' T₀),
    IsClosedImmersion ιS → ψ ≫ wcProjKStr K M' = uu ≫ ιS ≫ wcProjKStr K N →
    (∀ a L', Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op
        (ψ.appLE (wcSgD K M' T₀) (⨆ a', Z.basicOpen (t J a')) hD (wcSgE K M' T₀ (lam L'))) *
        Z.presheaf.map (homOfLE (Z.basicOpen_le (t J a))).op (t J a) =
      Z.presheaf.map (homOfLE (Z.basicOpen_le (t J a))).op (t L' a)) →
    (∀ a m, Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op
        (ψ.appLE (wcSgD K M' T₀) (⨆ a', Z.basicOpen (t J a')) hD (wcSgE K M' T₀ (κ' m))) =
      Z.presheaf.map (homOfLE ((Z.basicOpen_le (t J a)).trans inf_le_right)).op
        ((uu ≫ ιS).app (wcSgD K N l) (wcSgE K N l m))) →
    (∀ f : Γ(Z, ⨆ a, Z.basicOpen (t J a)),
      ∃ P : MvPolynomial (Fin (Ml + 1)) Γ(S, ιS ⁻¹ᵁ wcSgD K N l),
      ∀ a, ∃ inv : Γ(Z, Z.basicOpen (t J a)),
        inv * (Z.presheaf.map (homOfLE (Z.basicOpen_le (t J a))).op).hom (t J a) = 1 ∧
        (Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op).hom f =
          MvPolynomial.eval₂
            ((Z.presheaf.map (homOfLE ((Z.basicOpen_le (t J a)).trans inf_le_right)).op).hom.comp
              (uu.app (ιS ⁻¹ᵁ wcSgD K N l)).hom)
            (fun l' => (Z.presheaf.map (homOfLE (Z.basicOpen_le (t J a))).op).hom (t l' a) * inv)
            P) →
    ∀ f : Γ(Z, ⨆ a, Z.basicOpen (t J a)),
      ∃ c, ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD c = f :=
by
  intro K _ N M' S Z ιS uu ψ l T₀ κ' Ml lam L t J hD hCI hG1 hC1 hC2 hVA3 f
  haveI := hCI
  have hDO : (⨆ a, Z.basicOpen (t J a)) ≤ uu ⁻¹ᵁ (ιS ⁻¹ᵁ wcSgD K N l) :=
    iSup_le fun a => (Z.basicOpen_le (t J a)).trans inf_le_right
  have hres : ∀ {U1 U2 U3 : Z.Opens} (h1 : U1 ≤ U2) (h2 : U2 ≤ U3) (x : Γ(Z, U3)),
      Z.presheaf.map (homOfLE h1).op (Z.presheaf.map (homOfLE h2).op x) =
        Z.presheaf.map (homOfLE (h1.trans h2)).op x := by
    intro U1 U2 U3 h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl


  have hgenP : ∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro n J x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩

  have hloc : ∀ x y : Γ(Z, ⨆ a, Z.basicOpen (t J a)),
      (∀ a, Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op x =
        Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op y) → x = y := by
    intro x y h
    exact TopCat.Sheaf.eq_of_locally_eq' Z.sheaf (fun a => Z.basicOpen (t J a))
      (⨆ a, Z.basicOpen (t J a))
      (fun a => homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)) le_rfl x y h

  have hcoord : ∀ m, ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD
      (wcSgE K M' T₀ (κ' m)) =
      Z.presheaf.map (homOfLE hDO).op ((uu ≫ ιS).app (wcSgD K N l) (wcSgE K N l m)) := by
    intro m
    apply hloc
    intro a
    rw [hC2 a m]
    exact (hres _ hDO _).symm

  have hc1 : ∀ {W P : Scheme.{u}} (h : W ⟶ P) (U : P.Opens) (V : W.Opens) (e : V ≤ h ⁻¹ᵁ U)
      (x : Γ(P, ⊤)),
      h.appLE U V e (P.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
        W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (h.appTop x) := by
    intro W P h U V e x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    rfl
  have hDO' : (⨆ a, Z.basicOpen (t J a)) ≤ (uu ≫ ιS) ⁻¹ᵁ wcSgD K N l := hDO
  have hconst : ∀ c : K, ∃ y, ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD y =
      Z.presheaf.map (homOfLE hDO).op ((uu ≫ ιS).app (wcSgD K N l)
        ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N l ≤ ⊤)).op
          ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro c
    refine ⟨(wcProjK K M').presheaf.map (homOfLE (le_top : wcSgD K M' T₀ ≤ ⊤)).op
      ((wcProjKStr K M').appTop ((Scheme.ΓSpecIso (.of K)).inv c)), ?_⟩
    have e1 : Z.presheaf.map (homOfLE hDO).op ((uu ≫ ιS).app (wcSgD K N l)
        ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N l ≤ ⊤)).op
          ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) =
        (uu ≫ ιS).appLE (wcSgD K N l) (⨆ a, Z.basicOpen (t J a)) hDO'
          ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N l ≤ ⊤)).op
            ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))) := rfl
    have hqc : ψ.appTop ((wcProjKStr K M').appTop ((Scheme.ΓSpecIso (.of K)).inv c)) =
        (uu ≫ ιS).appTop ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)) := by
      have := congrArg (fun h => (Scheme.Hom.appTop h).hom ((Scheme.ΓSpecIso (.of K)).inv c)) hG1
      simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
    rw [e1, hc1, hc1 (uu ≫ ιS), hqc]

  have hbase : ∀ x : Γ(S, ιS ⁻¹ᵁ wcSgD K N l),
      Z.presheaf.map (homOfLE hDO).op (uu.app (ιS ⁻¹ᵁ wcSgD K N l) x) ∈
        (ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD).hom.range := by
    let φ : Γ(wcProjK K N, wcSgD K N l) →+* Γ(Z, ⨆ a, Z.basicOpen (t J a)) :=
      (Z.presheaf.map (homOfLE hDO).op).hom.comp ((uu ≫ ιS).app (wcSgD K N l)).hom
    have hgen : ∀ y : Γ(wcProjK K N, wcSgD K N l), φ y ∈
        (ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD).hom.range := by
      intro y
      have hy := hgenP N l y
      refine Subring.mem_comap.mp ((Subring.closure_le (t := Subring.comap φ
        (ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD).hom.range)).mpr ?_ hy)
      rintro _ (⟨m, rfl⟩ | ⟨c, rfl⟩)
      · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨_, hcoord m⟩)
      · obtain ⟨y, hy⟩ := hconst c
        exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨y, hy⟩)
    intro x
    have hAff : IsAffineOpen (wcSgD K N l) := by
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
        MvPolynomial.gradedAlgebra
      exact Proj.isAffineOpen_basicOpen _ _
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K l))
        Nat.one_pos
    obtain ⟨y, rfl⟩ := Scheme.Hom.app_surjective ιS (wcSgD K N l) hAff x
    have e2 : φ y = Z.presheaf.map (homOfLE hDO).op
        (uu.app (ιS ⁻¹ᵁ wcSgD K N l) (ιS.app (wcSgD K N l) y)) := by
      show Z.presheaf.map (homOfLE hDO).op ((uu ≫ ιS).app (wcSgD K N l) y) = _
      rw [Scheme.Hom.comp_app]
      rfl
    rw [← e2]
    exact hgen y

  obtain ⟨P, hP⟩ := hVA3 f
  let ρ : Fin (Ml + 1) → Γ(Z, ⨆ a, Z.basicOpen (t J a)) := fun L' =>
    ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD (wcSgE K M' T₀ (lam L'))
  let g : Γ(S, ιS ⁻¹ᵁ wcSgD K N l) →+* Γ(Z, ⨆ a, Z.basicOpen (t J a)) :=
    (Z.presheaf.map (homOfLE hDO).op).hom.comp (uu.app (ιS ⁻¹ᵁ wcSgD K N l)).hom
  have hmem : MvPolynomial.eval₂ g ρ P ∈
      (ψ.appLE (wcSgD K M' T₀) (⨆ a, Z.basicOpen (t J a)) hD).hom.range :=
    MvPolynomial.eval₂_mem (fun i _ => hbase _) (fun L' => RingHom.mem_range.mpr ⟨_, rfl⟩)
  have h2 : ∀ {A : Type u} [CommRing A] (X p q i : A), X * p = q → i * p = 1 → q * i = X := by
    intro A _ X p q i h hi
    rw [← h]
    linear_combination X * hi
  have heq : f = MvPolynomial.eval₂ g ρ P := by
    apply hloc
    intro a
    obtain ⟨inv, hinv, hfa⟩ := hP a
    show (Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op).hom f =
      (Z.presheaf.map (homOfLE (le_iSup (fun a' => Z.basicOpen (t J a')) a)).op).hom
        (MvPolynomial.eval₂ g ρ P)
    rw [hfa, MvPolynomial.eval₂_comp_left]
    congr 1
    · refine RingHom.ext fun x => ?_
      exact (hres _ _ _).symm
    · funext L'
      exact h2 _ _ _ _ (hC1 a L') hinv
  obtain ⟨c, hc⟩ := RingHom.mem_range.mp hmem
  exact ⟨c, hc.trans heq.symm⟩

theorem wcpa_dj_lcp_sp_twist_glue : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L →
    (∀ W : S.Opens, IsAffineOpen W → ∃ e : ℕ, 0 < e ∧ wcpaDjVA uu L W e) →
    wcpaDjIsProjOver k (uu ≫ sS) :=
by
  intro k _ S Z sS hS uu huu L hL hVA
  obtain ⟨N, ιS, hιS, hιSs⟩ := hS
  have hιSs' : ιS ≫ wcProjKStr k N = sS := hιSs
  obtain ⟨haffN, hcfN⟩ := wcpa_dj_gsfp_chart_facts k N
  have hcov : (⨆ a : Fin (N + 1), wcSgD k N a) = ⊤ := wc_pp_basicOpen_cover k N
  haveI := hιS
  haveI := huu
  haveI : IsProper (wcProjKStr k N) := wc_proj_space_isProper k N
  haveI : IsProper (uu ≫ ιS ≫ wcProjKStr k N) := inferInstance
