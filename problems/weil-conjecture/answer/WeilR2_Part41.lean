      algebraMap (AdicCompletion (IsLocalRing.maximalIdeal R) R)
        (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) := by
    intro r
    exact IsLocalization.map_eq _ _
  have hcomm : (algebraMap (AdicCompletion (IsLocalRing.maximalIdeal R) R)
        (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal R) R))).comp
        (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) =
      j.comp (algebraMap R (FractionRing R)) := by
    ext r
    exact (hj r).symm
  have hjx : IsIntegral (AdicCompletion (IsLocalRing.maximalIdeal R) R) (j x) :=
    IsIntegral.map_of_comp_eq _ j hcomm hx
  obtain ⟨y, hy⟩ := (isIntegrallyClosed_iff
    (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal R) R))).mp hic hjx
  have hsy : algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) s * y =
      algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) a := by
    apply IsFractionRing.injective (AdicCompletion (IsLocalRing.maximalIdeal R) R)
      (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal R) R))
    rw [map_mul, hy, ← hj, ← hj, ← map_mul, hspec]
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hdesc a s y hsy)
  refine ⟨r, ?_⟩
  have hu : IsUnit (algebraMap R (FractionRing R) (s : R)) :=
    IsLocalization.map_units (FractionRing R) s
