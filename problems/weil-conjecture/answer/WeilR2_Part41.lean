      · exact absurd hE (key _ _ _ _ hX h)
      · exact h
      · exact absurd hE.symm (key _ _ _ _ hX' h)
    have hEqZ : (A : ℤ) + d = Bm + c := by exact_mod_cast hEq
    have hcZ : (c : ℤ) ≤ B := by exact_mod_cast hc
    have hdZ : (d : ℤ) ≤ B := by exact_mod_cast hd
    rw [abs_le]
    constructor <;> omega
  have hC5 : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (φ : Y.functionField) (y w : Y) (hsp : w ⤳ y)
      (num den : Y.presheaf.stalk y) (num' den' : Y.presheaf.stalk w),
      algebraMap (Y.presheaf.stalk y) Y.functionField num =
        φ * algebraMap (Y.presheaf.stalk y) Y.functionField den →
