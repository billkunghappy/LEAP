import WeilR2_Part40
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem nccwff_basechange_forest : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ →
    IsClosed ({zk} : Set S) →
    ∀ (M : Type u) [CommRing M] [IsDomain M] [IsLocalRing M] [IsNoetherianRing M],
      IsAdicComplete (IsLocalRing.maximalIdeal M) M → IsAlgClosed (IsLocalRing.ResidueField M) →
      ringKrullDim M = 2 → nccwffRingOK M →
      ∀ (ψ : R →+* M), Function.Injective ψ →
      ∀ (e : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
        (S.presheaf.stalk zk) ≃+* M), e.toRingHom.comp (nccwffSig (ν ≫ u) zk) = ψ →
      nccwffForestOut M (Limits.pullback.snd q (nccwffG zk e)) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hzk
    M _ _ _ _ hcompl halgM hdim hOK ψ hψ e he
  classical
  obtain ⟨hcomp, -, ⟨hF, -, -, -, -, hE, -⟩, -, hS⟩ := hA
  obtain ⟨-, -, ⟨-, -, hNnorm⟩, ⟨-, hSloft, -, -, hNflat, -⟩, ⟨hqprop, -⟩, ⟨⟨V, hV, hVi⟩, -⟩,
    -⟩ := hS

  have s1 : ∀ (T : Scheme.{u}) (s : T) (A B : Type u) [CommRing A] [CommRing B]
      (e : AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk s)) (T.presheaf.stalk s) ≃+* A)
      (hh : T ⟶ Spec (.of B)),
      nccwffG s e ≫ hh = Spec.map (CommRingCat.ofHom (e.toRingHom.comp (nccwffSig hh s))) := by
    intro T s A B _ _ e hh
    have hid : (Spec (.of B)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of B)).inv = 𝟙 _ := by
      rw [← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
    have h1 : hh = T.toSpecΓ ≫ Spec.map hh.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of B)).inv := by
      calc hh = hh ≫ 𝟙 _ := (Category.comp_id _).symm
        _ = hh ≫ (Spec (.of B)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of B)).inv := by rw [hid]
        _ = _ := by rw [← Category.assoc, Scheme.toSpecΓ_naturality, Category.assoc]
    have h2 : T.fromSpecStalk s ≫ hh = Spec.map ((Scheme.ΓSpecIso (.of B)).inv ≫ hh.appTop ≫
        T.presheaf.germ ⊤ s trivial) := by
      conv_lhs => rw [h1]
      rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp,
        Category.assoc]
    unfold nccwffG
    rw [Category.assoc, h2, ← Spec.map_comp]
    congr 1
    ext x
    simp only [nccwffSig, wcCnSigma, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
      RingHom.comp_apply]
    congr 3
    have : (homOfLE (le_top : (⊤ : T.Opens) ≤ ⊤)) = 𝟙 _ := rfl
    rw [this, op_id, T.presheaf.map_id]
    rfl

  have s2 : ∀ (T : Scheme.{u}) [IsLocallyNoetherian T] (s : T) (A : Type u) [CommRing A]
      (e : AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk s)) (T.presheaf.stalk s) ≃+* A),
      Flat (nccwffG s e) := by
    intro T _ s A _ e
    unfold nccwffG
    have hA : Flat (Spec.map (CommRingCat.ofHom (e.toRingHom.comp (algebraMap (T.presheaf.stalk s)
        (AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk s)) (T.presheaf.stalk s)))))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      simp only [CommRingCat.hom_ofHom]
      apply RingHom.Flat.comp
      · rw [RingHom.flat_algebraMap_iff]; exact AdicCompletion.flat_of_isNoetherian _
      · exact RingHom.Flat.of_bijective e.bijective
    have hB : Flat (T.fromSpecStalk s) := by
      obtain ⟨W, hW, hsW, -⟩ :=
        exists_isAffineOpen_mem_and_subset (show s ∈ (⊤ : T.Opens) from trivial)
      rw [← hW.fromSpecStalk_eq_fromSpecStalk hsW]
      show Flat (Spec.map (T.presheaf.germ W s hsW) ≫ hW.fromSpec)
      have : Flat (Spec.map (T.presheaf.germ W s hsW)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat)]
        letI : Algebra Γ(T, W) (T.presheaf.stalk s) := (T.presheaf.germ W s hsW).hom.toAlgebra
        haveI := hW.isLocalization_stalk ⟨s, hsW⟩
        have := IsLocalization.flat (T.presheaf.stalk s) (hW.primeIdealOf ⟨s, hsW⟩).asIdeal.primeCompl
        rw [← RingHom.flat_algebraMap_iff] at this
        exact this
      infer_instance
    infer_instance

  have s3 : ∀ (X : Scheme.{u}) (A : Type u) [CommRing A] [IsDomain A] (f : X ⟶ Spec (.of A))
      (U : (Spec (.of A)).Opens), U ≠ ⊥ → IsIso (f ∣_ U) →
      (∀ x : X, ∃ x' : X, x' ⤳ x ∧ f x' ∈ U) → (∀ x : X, IsDomain (X.presheaf.stalk x)) →
      AlgebraicGeometry.IsIntegral X := by
    intro X A _ _ f U hU hiso hgen hdom
    obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    have : Nonempty U.toScheme := ⟨⟨p, hp⟩⟩
    have : AlgebraicGeometry.IsIntegral U.toScheme := isIntegral_of_isOpenImmersion U.ι
    have : Nonempty (f ⁻¹ᵁ U).toScheme := ⟨inv (f ∣_ U) ⟨p, hp⟩⟩
    have : AlgebraicGeometry.IsIntegral (f ⁻¹ᵁ U).toScheme :=
      isIntegral_of_isOpenImmersion (f ∣_ U)
    have h2 := (IrreducibleSpace.isIrreducible_univ (f ⁻¹ᵁ U).toScheme).image
      (f ⁻¹ᵁ U).ι.base (f ⁻¹ᵁ U).ι.base.hom.continuous.continuousOn
    rw [Set.image_univ] at h2
    have hr : Set.range (f ⁻¹ᵁ U).ι.base = (f ⁻¹ᵁ U : Set X) := Scheme.Opens.range_ι _
    rw [hr] at h2
    have hcl : closure (f ⁻¹ᵁ U : Set X) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      obtain ⟨x', hx', hx'U⟩ := hgen x
      exact closure_mono (Set.singleton_subset_iff.mpr (show x' ∈ (f ⁻¹ᵁ U : Set X) from hx'U))
        (specializes_iff_mem_closure.mp hx')
    have h3 := h2.closure
    rw [hcl] at h3
    have : IrreducibleSpace X := (irreducibleSpace_def X).mpr h3
    have : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
      have := hdom x; infer_instance
    have : IsReduced X := isReduced_of_isReduced_stalk X
    exact isIntegral_of_irreducibleSpace_of_isReduced X

  have s4 : ∀ (N₀ S₀ T : Scheme.{u}) (q₀ : N₀ ⟶ S₀) (g₀ : T ⟶ S₀) (V₀ : S₀.Opens),
      IsIso (q₀ ∣_ V₀) → IsIso (Limits.pullback.snd q₀ g₀ ∣_ (g₀ ⁻¹ᵁ V₀)) := by
    intro N₀ S₀ T q₀ g₀ V₀ hV₀
    have H1 : IsPullback (Limits.pullback.fst q₀ g₀) (Limits.pullback.snd q₀ g₀) q₀ g₀ :=
      IsPullback.of_hasPullback q₀ g₀
    have H2 := isPullback_morphismRestrict (Limits.pullback.snd q₀ g₀) (g₀ ⁻¹ᵁ V₀)
    have big := H2.flip.paste_horiz H1
    have hres : (g₀ ⁻¹ᵁ V₀).ι ≫ g₀ = g₀.resLE V₀ (g₀ ⁻¹ᵁ V₀) le_rfl ≫ V₀.ι :=
      (Scheme.Hom.resLE_comp_ι _ _).symm
    rw [hres] at big
    have H3 := (isPullback_morphismRestrict q₀ V₀).flip
    let κ := H3.lift (((Limits.pullback.snd q₀ g₀) ⁻¹ᵁ (g₀ ⁻¹ᵁ V₀)).ι ≫ Limits.pullback.fst q₀ g₀)
      ((Limits.pullback.snd q₀ g₀ ∣_ (g₀ ⁻¹ᵁ V₀)) ≫ g₀.resLE V₀ (g₀ ⁻¹ᵁ V₀) le_rfl)
      (by rw [big.w, Category.assoc])
    have hκ1 : κ ≫ (q₀ ⁻¹ᵁ V₀).ι =
        ((Limits.pullback.snd q₀ g₀) ⁻¹ᵁ (g₀ ⁻¹ᵁ V₀)).ι ≫ Limits.pullback.fst q₀ g₀ :=
      H3.lift_fst _ _ _
    have hκ2 : κ ≫ (q₀ ∣_ V₀) =
        (Limits.pullback.snd q₀ g₀ ∣_ (g₀ ⁻¹ᵁ V₀)) ≫ g₀.resLE V₀ (g₀ ⁻¹ᵁ V₀) le_rfl :=
      H3.lift_snd _ _ _
    rw [← hκ1] at big
    have hsq := IsPullback.of_right big hκ2 H3
    exact MorphismProperty.of_isPullback (P := MorphismProperty.isomorphisms Scheme) hsq hV₀

  haveI := hSloft
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian (ν ≫ u)
  haveI := hqprop
  haveI := hNflat
  set g := nccwffG zk e with hg
  have hgψ : g ≫ (ν ≫ u) = Spec.map (CommRingCat.ofHom ψ) := by
    rw [hg, s1 S zk M R e (ν ≫ u), he]

  have hfprop : IsProper (Limits.pullback.snd q g) := inferInstance

  have hnorm := nccwbf_basechange_normal R hE hcomp S N (ν ≫ u) q hSloft inferInstance hNnorm zk
    hzk M e

  have hgenR : ∀ p : Spec (.of R), p.asIdeal = ⊥ → p ≠ IsLocalRing.closedPoint R := by
    intro p hp hpc
    apply IsDiscreteValuationRing.not_a_field R
    have h2 : (IsLocalRing.closedPoint R).asIdeal = IsLocalRing.maximalIdeal R := rfl
    rw [← h2, ← hpc, hp]

  set U := g ⁻¹ᵁ V with hUdef
  have hUi : IsIso (Limits.pullback.snd q g ∣_ U) := s4 N S (Spec (.of M)) q g V hVi
  have hU : U ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    let p₀ : Spec (.of M) := ⟨⊥, Ideal.isPrime_bot⟩
    refine ⟨p₀, ?_⟩
    show g p₀ ∈ V
    apply hV
    have e1 : (ν ≫ u) (g p₀) = Spec.map (CommRingCat.ofHom ψ) p₀ := by
      rw [← hgψ]; simp only [Scheme.Hom.comp_apply]
    rw [e1]
    apply hgenR
    rw [Spec.map_apply]
    change Ideal.comap ψ (⊥ : Ideal M) = ⊥
    exact Ideal.comap_bot_of_injective _ hψ

  haveI hgflat : Flat g := s2 S zk M e
  haveI : Flat (Limits.pullback.fst q g) := inferInstance
  have hgen : ∀ x : ↥(Limits.pullback q g), ∃ x' : ↥(Limits.pullback q g), x' ⤳ x ∧
      Limits.pullback.snd q g x' ∈ U := by
    intro x
    let ηR : Spec (.of R) := ⟨⊥, Ideal.isPrime_bot⟩
    have hsp : ηR ⤳ (Limits.pullback.fst q g ≫ q ≫ ν ≫ u) x :=
      (PrimeSpectrum.le_iff_specializes _ _).mp
        ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp bot_le)
    obtain ⟨x', hx', hx'e⟩ := Flat.generalizingMap (Limits.pullback.fst q g ≫ q ≫ ν ≫ u) hsp
    refine ⟨x', hx', ?_⟩
    show g (Limits.pullback.snd q g x') ∈ V
    have e2 : g (Limits.pullback.snd q g x') = q (Limits.pullback.fst q g x') := by
      rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [e2]
    apply hV
    have e3 : (ν ≫ u) (q (Limits.pullback.fst q g x')) =
        (Limits.pullback.fst q g ≫ q ≫ ν ≫ u) x' := by
      simp only [Scheme.Hom.comp_apply]
    rw [e3, hx'e]
    exact hgenR ηR rfl
  have hint : AlgebraicGeometry.IsIntegral (Limits.pullback q g) :=
    s3 _ M (Limits.pullback.snd q g) U hU hUi hgen (fun x => (hnorm x).1)

  exact hF M hcompl halgM hdim hOK (Limits.pullback q g) (Limits.pullback.snd q g) hfprop hint
    (fun x => (hnorm x).2) ⟨U, hU, hUi⟩

theorem nccwfd_residue_square : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (S : Scheme.{u}) (zk : S) (h : S ⟶ Spec (.of R)) (M : Type u) [CommRing M] [IsLocalRing M] (ψ : R →+* M) (ρ : IsLocalRing.ResidueField R ≃+* IsLocalRing.ResidueField M), ρ.toRingHom.comp (IsLocalRing.residue R) = (IsLocalRing.residue M).comp ψ → ∀ (e : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk) ≃+* M), e.toRingHom.comp (nccwffSig h zk) = ψ → nccwffG zk e ≫ h = Spec.map (CommRingCat.ofHom ψ) ∧ ∃ φ : S.residueField zk ⟶ CommRingCat.of (IsLocalRing.ResidueField M), IsIso φ ∧ Spec.map (CommRingCat.ofHom (IsLocalRing.residue M)) ≫ nccwffG zk e = Spec.map φ ≫ S.fromSpecResidueField zk :=
by
  intro R _ _ S zk h M _ _ ψ ρ hρ e he
  let O := S.presheaf.stalk zk
  let σ : R →+* O := (S.presheaf.germ ⊤ zk trivial).hom.comp (wcCnSigma h ⊤)
  let α : O →+* M :=
    e.toRingHom.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
  have hασ : α.comp σ = ψ := by rw [← he]; rfl
  have hG : nccwffG zk e = Spec.map (CommRingCat.ofHom α) ≫ S.fromSpecStalk zk := rfl

  have s1 : S.fromSpecStalk zk ≫ h = Spec.map (CommRingCat.ofHom σ) := by
    have h1 : h = S.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ h.appTop) := by
      rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
        ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
    have hσ : CommRingCat.ofHom σ =
        (Scheme.ΓSpecIso (.of R)).inv ≫ h.appTop ≫ S.presheaf.germ ⊤ zk trivial := by
      rw [show σ = ((Scheme.ΓSpecIso (.of R)).inv ≫ h.appTop ≫
          S.presheaf.map (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op ≫
          S.presheaf.germ ⊤ zk trivial).hom from rfl]
      have hres : S.presheaf.map (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op = 𝟙 _ := by
        rw [show (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op = 𝟙 (Opposite.op ⊤) from rfl,
          CategoryTheory.Functor.map_id]
      rw [CommRingCat.ofHom_hom, hres, Category.id_comp]
    conv_lhs => rw [h1]
    rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, hσ, Category.assoc]

  have hχ : ((IsLocalRing.residue M).comp α).comp σ =
      ρ.toRingHom.comp (IsLocalRing.residue R) := by
    rw [hρ, RingHom.comp_assoc, hασ]
  have hsurj : Function.Surjective ((IsLocalRing.residue M).comp α) := by
    have h2 : Function.Surjective (((IsLocalRing.residue M).comp α).comp σ) := by
      rw [hχ]; exact ρ.surjective.comp IsLocalRing.residue_surjective
    intro y
    obtain ⟨x, hx⟩ := h2 y
    exact ⟨σ x, hx⟩
  have hker : RingHom.ker ((IsLocalRing.residue M).comp α) = IsLocalRing.maximalIdeal O := by
    haveI := RingHom.ker_isMaximal_of_surjective _ hsurj
    exact IsLocalRing.eq_maximalIdeal this
  let φ₀ : IsLocalRing.ResidueField O →+* IsLocalRing.ResidueField M :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal O) ((IsLocalRing.residue M).comp α)
      (fun a ha => by rw [← RingHom.mem_ker, hker]; exact ha)
  have hφ₀ : φ₀.comp (IsLocalRing.residue O) = (IsLocalRing.residue M).comp α := by
    ext x
    rfl
  have hbij : Function.Bijective φ₀ :=
    ⟨φ₀.injective, Ideal.Quotient.lift_surjective_of_surjective _ _ hsurj⟩
  refine ⟨?_, (CommRingCat.ofHom φ₀ : S.residueField zk ⟶ _), ?_, ?_⟩
  · rw [hG, Category.assoc, s1, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hασ]
  · exact (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  · rw [hG, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← hφ₀,
      CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
    rfl

theorem nccwfd_fibre_immersions : ∀ (N S : Scheme.{u}) (q : N ⟶ S) (zk : S), IsClosed ({zk} : Set S) → ∀ (M : Type u) [CommRing M] [IsLocalRing M] (g : Spec (.of M) ⟶ S) (φ : S.residueField zk ⟶ CommRingCat.of (IsLocalRing.ResidueField M)), IsIso φ → Spec.map (CommRingCat.ofHom (IsLocalRing.residue M)) ≫ g = Spec.map φ ≫ S.fromSpecResidueField zk → ∃ (W : Scheme.{u}) (a : W ⟶ Limits.pullback q g) (b : W ⟶ Spec (.of (IsLocalRing.ResidueField M))) (c : W ⟶ N), IsClosedImmersion a ∧ IsClosedImmersion c ∧ a ≫ Limits.pullback.fst q g = c ∧ IsPullback a b (Limits.pullback.snd q g) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))) ∧ Set.range ⇑a = ⇑(Limits.pullback.snd q g) ⁻¹' {IsLocalRing.closedPoint M} ∧ Set.range ⇑c = ⇑q ⁻¹' {zk} :=
by
  intro N S q zk hzk M _ _ g φ hφ hsq
  have hsMci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hsMrange : Set.range ⇑(Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))) =
      {IsLocalRing.closedPoint M} := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact IsLocalRing.PrimeSpectrum.comap_residue M y
    · rintro rfl
      exact ⟨IsLocalRing.closedPoint _, IsLocalRing.PrimeSpectrum.comap_residue M _⟩
  have P1 : IsPullback (Limits.pullback.fst q g) (Limits.pullback.snd q g) q g :=
    IsPullback.of_hasPullback q g
  have P2 : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd q g) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))))
      (Limits.pullback.snd (Limits.pullback.snd q g) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))))
      (Limits.pullback.snd q g) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))) :=
    IsPullback.of_hasPullback _ _
  have Q0 := P2.flip.paste_vert P1.flip
  rw [hsq] at Q0
  have hr : IsClosedImmersion (S.fromSpecResidueField zk) :=
    IsClosedImmersion.of_isPreimmersion _ (by rw [Scheme.range_fromSpecResidueField]; exact hzk)
  have hcomp : IsClosedImmersion (Spec.map φ ≫ S.fromSpecResidueField zk) := inferInstance
  have hrange : Set.range ⇑(Spec.map φ ≫ S.fromSpecResidueField zk) = {zk} := by
    rw [← Scheme.range_fromSpecResidueField zk]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨_, (Scheme.Hom.comp_apply _ _ y).symm⟩
    · rintro ⟨y, rfl⟩
      obtain ⟨z, rfl⟩ := (Spec.map φ).surjective y
      exact ⟨z, Scheme.Hom.comp_apply _ _ z⟩
  have hfst : Set.range ⇑(Limits.pullback.fst q (Spec.map φ ≫ S.fromSpecResidueField zk)) =
      ⇑q ⁻¹' {zk} := by
    rw [Scheme.Pullback.range_fst, hrange]
  have hiso := Q0.flip.isoPullback_hom_fst
  refine ⟨_, Limits.pullback.fst (Limits.pullback.snd q g)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))),
    Limits.pullback.snd (Limits.pullback.snd q g)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue M))), _, ?_, ?_, rfl, P2, ?_, ?_⟩
  · exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) P2.flip hsMci
  · exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) Q0 hcomp
  · rw [Scheme.Pullback.range_fst, hsMrange]
  · rw [← hfst]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨Q0.flip.isoPullback.hom y, ?_⟩
      rw [← Scheme.Hom.comp_apply, hiso]
    · rintro ⟨y, rfl⟩
      obtain ⟨z, rfl⟩ := Q0.flip.isoPullback.hom.surjective y
      refine ⟨z, ?_⟩
      rw [← Scheme.Hom.comp_apply, hiso]

theorem nccwfd_reduced_to_closed_point : ∀ (T : Scheme.{u}) [AlgebraicGeometry.IsReduced T] (M : Type u) [CommRing M] [IsLocalRing M] (t : T ⟶ Spec (.of M)), (∀ x : T, t x = IsLocalRing.closedPoint M) → ∃ t' : T ⟶ Spec (.of (IsLocalRing.ResidueField M)), t' ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue M)) = t :=
by
  intro T _ M _ _ t ht
  set φ : CommRingCat.of M ⟶ Γ(T, ⊤) := (Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ t.appTop with hφ
  have s1 : t = T.toSpecΓ ≫ Spec.map φ := by
    calc t = t ≫ (Spec (CommRingCat.of M)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (CommRingCat.of M)).inv := by
          rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
      _ = T.toSpecΓ ≫ Spec.map t.appTop ≫ Spec.map (Scheme.ΓSpecIso (CommRingCat.of M)).inv := by
          rw [Scheme.toSpecΓ_naturality_assoc]
      _ = T.toSpecΓ ≫ Spec.map φ := by rw [hφ, Spec.map_comp]
  have s2 : ∀ m ∈ IsLocalRing.maximalIdeal M, φ.hom m = 0 := by
    intro m hm
    have h1 := Scheme.preimage_basicOpen_top t ((Scheme.ΓSpecIso (CommRingCat.of M)).inv.hom m)
    rw [basicOpen_eq_of_affine] at h1
    have h2 : T.basicOpen (t.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of M)).inv.hom m)) = ⊥ := by
      rw [← h1, eq_bot_iff]
      intro x hx
      exfalso
      have hx' : m ∉ (t x).asIdeal := hx
      exact hx' (by rw [ht x]; exact hm)
    have := (basicOpen_eq_bot_iff _).mp h2
    simpa [hφ] using this
  let ψ : IsLocalRing.ResidueField M →+* Γ(T, ⊤) :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal M) φ.hom s2
  have s3 : ψ.comp (IsLocalRing.residue M) = φ.hom := Ideal.Quotient.lift_comp_mk _ _ _
  refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ), ?_⟩
  rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, s3, CommRingCat.ofHom_hom, ← s1]

theorem nccwfd_component_transfer : ∀ {W X N : Type u} [TopologicalSpace W] [TopologicalSpace X] [TopologicalSpace N] (a : W → X) (c : W → N) (p : X → N) (B : Set N), Topology.IsClosedEmbedding a → Topology.IsClosedEmbedding c → Continuous p → (∀ w, p (a w) = c w) → Set.range c ⊆ B → (∀ L : Set N, IsClosed L → IsIrreducible L → L ⊆ B → L.Nontrivial → ∀ L' : Set N, IsIrreducible L' → L ⊆ L' → L' ⊆ B → L' = L) → (∀ L : Set N, IsClosed L → IsIrreducible L → L.Nontrivial → L ⊆ Set.range c → (IsIrreducible (a '' (c ⁻¹' L)) ∧ IsClosed (a '' (c ⁻¹' L)) ∧ a '' (c ⁻¹' L) ⊆ Set.range a ∧ ∀ E : Set X, IsIrreducible E → a '' (c ⁻¹' L) ⊆ E → E ⊆ Set.range a → E = a '' (c ⁻¹' L)) ∧ (a '' (c ⁻¹' L)).Nontrivial ∧ p '' (a '' (c ⁻¹' L)) = L) ∧ ((∀ (m : ℕ) (E : Fin (m + 2) → Set X) (r : Fin (m + 2) → X), (∀ i, IsIrreducible (E i) ∧ IsClosed (E i) ∧ E i ⊆ Set.range a ∧ ∀ E' : Set X, IsIrreducible E' → E i ⊆ E' → E' ⊆ Set.range a → E' = E i) → Function.Injective E → Function.Injective r → (∀ i, r i ∈ E i ∧ r i ∈ E (finRotate (m + 2) i)) → False) → ∀ (m : ℕ) (E : Fin (m + 2) → Set N) (r : Fin (m + 2) → N), (∀ i, E i ∈ {L : Set N | IsClosed L ∧ IsIrreducible L ∧ L.Nontrivial ∧ L ⊆ Set.range c}) → Function.Injective E → Function.Injective r → (∀ i, r i ∈ E i ∧ r i ∈ E (finRotate (m + 2) i)) → False) :=
by
  intro W X N _ _ _ a c p B ha hc hp hac hcB hmax
  have himg : ∀ L : Set N, L ⊆ Set.range c → p '' (a '' (c ⁻¹' L)) = L := by
    intro L hL
    rw [Set.image_image]
    have hfun : (fun w => p (a w)) = c := funext hac
    rw [hfun, Set.image_preimage_eq_of_subset hL]
  have hpre : ∀ L : Set N, L ⊆ Set.range c → IsIrreducible L → IsIrreducible (c ⁻¹' L) := by
    intro L hL hirr
    refine ⟨?_, ?_⟩
    · obtain ⟨y, hy⟩ := hirr.nonempty
      obtain ⟨w, hw⟩ := hL hy
      refine ⟨w, ?_⟩
      show c w ∈ L
      rw [hw]; exact hy
    · intro u v hu hv hu1 hv1
      obtain ⟨w₁, hw₁L, hw₁u⟩ := hu1
      obtain ⟨w₂, hw₂L, hw₂v⟩ := hv1
      obtain ⟨u', hu', rfl⟩ := hc.isInducing.isOpen_iff.mp hu
      obtain ⟨v', hv', rfl⟩ := hc.isInducing.isOpen_iff.mp hv
      obtain ⟨y, hyL, hyu, hyv⟩ :=
        hirr.isPreirreducible u' v' hu' hv' ⟨c w₁, hw₁L, hw₁u⟩ ⟨c w₂, hw₂L, hw₂v⟩
      obtain ⟨w, rfl⟩ := hL hyL
      exact ⟨w, hyL, hyu, hyv⟩
  have hP1 : ∀ L : Set N, IsClosed L → IsIrreducible L → L.Nontrivial → L ⊆ Set.range c →
      (IsIrreducible (a '' (c ⁻¹' L)) ∧ IsClosed (a '' (c ⁻¹' L)) ∧ a '' (c ⁻¹' L) ⊆ Set.range a ∧
        ∀ E : Set X, IsIrreducible E → a '' (c ⁻¹' L) ⊆ E → E ⊆ Set.range a →
          E = a '' (c ⁻¹' L)) ∧ (a '' (c ⁻¹' L)).Nontrivial ∧ p '' (a '' (c ⁻¹' L)) = L := by
    intro L hLcl hLirr hLnt hLc
    refine ⟨⟨(hpre L hLc hLirr).image a ha.continuous.continuousOn,
      ha.isClosedMap _ (hLcl.preimage hc.continuous), Set.image_subset_range a _, ?_⟩, ?_,
      himg L hLc⟩
    · intro E hE hsub hEa
      have hLB : L ⊆ B := hLc.trans hcB
      have hpE : p '' E ⊆ B := by
        rintro _ ⟨x, hx, rfl⟩
        obtain ⟨w, rfl⟩ := hEa hx
        rw [hac]; exact hcB ⟨w, rfl⟩
      have hLpE : L ⊆ p '' E := by
        rw [← himg L hLc]; exact Set.image_mono hsub
      have heq := hmax L hLcl hLirr hLB hLnt (p '' E) (hE.image p hp.continuousOn) hLpE hpE
      refine Set.Subset.antisymm ?_ hsub
      intro x hx
      obtain ⟨w, rfl⟩ := hEa hx
      refine ⟨w, ?_, rfl⟩
      show c w ∈ L
      rw [← hac, ← heq]; exact ⟨a w, hx, rfl⟩
    · obtain ⟨y₁, hy₁, y₂, hy₂, hne⟩ := hLnt
      obtain ⟨w₁, rfl⟩ := hLc hy₁
      obtain ⟨w₂, rfl⟩ := hLc hy₂
      refine ⟨a w₁, ⟨w₁, hy₁, rfl⟩, a w₂, ⟨w₂, hy₂, rfl⟩, ?_⟩
      intro h
      exact hne (congrArg c (ha.isEmbedding.injective h))
  refine ⟨hP1, ?_⟩
  intro HX m E r hE hEi hri hinc
  choose w hw using fun i => (hE i).2.2.2 (hinc i).1
  refine HX m (fun i => a '' (c ⁻¹' (E i))) (fun i => a (w i))
    (fun i => (hP1 (E i) (hE i).1 (hE i).2.1 (hE i).2.2.1 (hE i).2.2.2).1) ?_ ?_ ?_
  · intro i j hij
    apply hEi
    have h1 := congrArg (fun S => p '' S) hij
    simp only at h1
    rwa [himg _ (hE i).2.2.2, himg _ (hE j).2.2.2] at h1
  · intro i j hij
    apply hri
    simp only at hij
    rw [← hw i, ← hw j, ha.isEmbedding.injective hij]
  · intro i
    refine ⟨⟨w i, ?_, rfl⟩, ⟨w i, ?_, rfl⟩⟩
    · show c (w i) ∈ E i
      rw [hw i]; exact (hinc i).1
    · show c (w i) ∈ E (finRotate (m + 2) i)
      rw [hw i]; exact (hinc i).2

theorem nccwfd_proj_field_transport : ∀ (K L : Type u) [Field K] [Field L] (ρ : K ≃+* L), ∃ Φ : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) L) MvPolynomial.gradedAlgebra ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra, Φ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) L) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0))) ≫ Spec.map (CommRingCat.ofHom (ρ : K →+* L)) :=
by
  intro K L _ _ ρ

  have hspan : ∀ (E : Type u) [Field E],
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E));
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E)).toIdeal ≤
        Ideal.span (Set.range MvPolynomial.X) := by
    intro E _
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E))
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin 2) E) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) E)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin 2) E) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hXmem : ∀ (E : Type u) [Field E] (i : Fin 2), (MvPolynomial.X i : MvPolynomial (Fin 2) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) E 1 := fun E _ i =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X E i)

  have mk : ∀ (E E' : Type u) [Field E] [Field E'] (κ : E →+* E'),
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E));
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E'));
      ∃ f : MvPolynomial.homogeneousSubmodule (Fin 2) E →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin 2) E',
        (∀ p, f p = MvPolynomial.map κ p) ∧
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E') ≤
          HomogeneousIdeal.map f
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E)) := by
    intro E E' _ _ κ
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E'))
    obtain ⟨f, hfmap⟩ : ∃ f : MvPolynomial.homogeneousSubmodule (Fin 2) E →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin 2) E',
        ∀ p, f p = MvPolynomial.map κ p :=
      ⟨⟨MvPolynomial.map κ, fun {i} {x} hx =>
        (MvPolynomial.mem_homogeneousSubmodule i _).mpr
          (((MvPolynomial.mem_homogeneousSubmodule i x).mp hx).map κ)⟩,
        fun p => rfl⟩
    refine ⟨f, hfmap, ?_⟩
    have hfX : ∀ a : Fin 2, f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
      rw [hfmap, MvPolynomial.map_X]
    intro p hp
    have hp' : p ∈ Ideal.span (Set.range (MvPolynomial.X :
        Fin 2 → MvPolynomial (Fin 2) E')) := hspan E' hp
    change p ∈ (HomogeneousIdeal.map f _).toIdeal
    rw [HomogeneousIdeal.toIdeal_map]
    refine (Ideal.span_le.mpr ?_) hp'
    rintro _ ⟨i, rfl⟩
    rw [← hfX i]
    apply Ideal.mem_map_of_mem
    change MvPolynomial.X i ∈ HomogeneousIdeal.irrelevant _
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne _ (hXmem E i) one_ne_zero

  have V0 : ∀ (E : Type u) [Field E],
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E));
      ∀ (s : MvPolynomial (Fin 2) E) (c : E),
      (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) E)
        (Submonoid.powers s)
        (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
    intro E _
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) E))
    intro s c
    have h1 : ((algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0)) : MvPolynomial (Fin 2) E) =
        MvPolynomial.C c := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rw [← h1]
    rfl
  letI iK : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) :=
    MvPolynomial.gradedAlgebra
  letI iL : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) L) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨f, hfmap, hf⟩ := mk K L (ρ : K →+* L)
  obtain ⟨g, hgmap, hg⟩ := mk L K (ρ.symm : L →+* K)
  have fg : ∀ p, f (g p) = p := fun p => by
    have e : (ρ : K →+* L).comp (ρ.symm : L →+* K) = RingHom.id L :=
      RingHom.ext fun x => by simp
    rw [hfmap, hgmap, MvPolynomial.map_map, e, MvPolynomial.map_id]
  have gf : ∀ p, g (f p) = p := fun p => by
    have e : (ρ.symm : L →+* K).comp (ρ : K →+* L) = RingHom.id K :=
      RingHom.ext fun x => by simp
    rw [hfmap, hgmap, MvPolynomial.map_map, e, MvPolynomial.map_id]
  have idK : ∀ (h : MvPolynomial.homogeneousSubmodule (Fin 2) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin 2) K) hh,
      h = GradedRingHom.id _ → Proj.map h hh = 𝟙 _ := by
    rintro h hh rfl
    exact Proj.map_id
  have idL : ∀ (h : MvPolynomial.homogeneousSubmodule (Fin 2) L →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin 2) L) hh,
      h = GradedRingHom.id _ → Proj.map h hh = 𝟙 _ := by
    rintro h hh rfl
    exact Proj.map_id
  have hom_inv : Proj.map f hf ≫ Proj.map g hg = 𝟙 _ := by
    rw [← Proj.map_comp]
    exact idL _ _ (GradedRingHom.ext fun p => by
      rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, fg])
  have inv_hom : Proj.map g hg ≫ Proj.map f hf = 𝟙 _ := by
    rw [← Proj.map_comp]
    exact idK _ _ (GradedRingHom.ext fun p => by
      rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, gf])

  have s3 : ∀ {P : Submonoid (MvPolynomial (Fin 2) K)}
      {Q : Submonoid (MvPolynomial (Fin 2) L)} (comap_le : P ≤ Submonoid.comap f Q)
      (z : HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin 2) K) P)
      (n : MvPolynomial (Fin 2) K) (d : P), z.val = Localization.mk n d →
      (HomogeneousLocalization.map f comap_le z).val =
        Localization.mk (f n) ⟨f d, comap_le d.2⟩ := by
    intro P Q comap_le z n d h
    obtain ⟨x, rfl⟩ := HomogeneousLocalization.mk_surjective z
    rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
    rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h
    obtain ⟨c, hc⟩ := h
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨⟨f c, comap_le c.2⟩, ?_⟩
    have := congrArg f hc
    simp only [map_mul] at this
    exact this
  have hfX : ∀ a : Fin 2, f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
    rw [hfmap, MvPolynomial.map_X]
  have hsp : (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) L)).toIdeal ≤
      Ideal.span (Set.range (fun i : Fin 2 => f (MvPolynomial.X i))) := by
    have e : (fun i : Fin 2 => f (MvPolynomial.X i)) = MvPolynomial.X := funext hfX
    rw [e]
    exact hspan L
  have hc : ∀ x : Proj (MvPolynomial.homogeneousSubmodule (Fin 2) L), ∃ (i : Fin 2), ∃ y,
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) L) (f (MvPolynomial.X i))
        (f.map_mem (hXmem K i)) Nat.one_pos) y = x := by
    intro x
    have hx : x ∈ ⨆ i : Fin 2,
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) L) (f (MvPolynomial.X i)) := by
      rw [Proj.iSup_basicOpen_eq_top _ _ hsp]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    have hi' : x ∈ (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) L)
        (f (MvPolynomial.X i)) (f.map_mem (hXmem K i)) Nat.one_pos).opensRange := by
      rw [Proj.opensRange_awayι]; exact hi
    obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi'
    exact ⟨i, y, hy⟩
  have hK : ∀ i : Fin 2, Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        (MvPolynomial.X i) (hXmem K i) Nat.one_pos ≫
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫ Spec.map
        (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) =
      Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) := by
    intro i
    rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hL : ∀ i : Fin 2, Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) L)
        (f (MvPolynomial.X i)) (f.map_mem (hXmem K i)) Nat.one_pos ≫
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) L) ≫ Spec.map
        (CommRingCat.ofHom (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0))) ≫
        Spec.map (CommRingCat.ofHom (ρ : K →+* L))) =
      Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) L)
        (Submonoid.powers (f (MvPolynomial.X i)))).comp
        ((algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0)).comp
          (ρ : K →+* L)))) := by
    intro i
    rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
  have key : ∀ i : Fin 2, (HomogeneousLocalization.Away.map f (MvPolynomial.X i)).comp
      ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
      (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) L)
        (Submonoid.powers (f (MvPolynomial.X i)))).comp
        ((algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0)).comp
          (ρ : K →+* L)) := by
    intro i
    apply RingHom.ext
    intro c
    simp only [RingHom.comp_apply]
    apply HomogeneousLocalization.val_injective _
    rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ (MvPolynomial.C c) 1 (V0 K _ c),
      V0 L _ ((ρ : K →+* L) c)]
    congr 1
    · rw [hfmap, MvPolynomial.map_C]
    · ext
      simp
  have hchart : ∀ i : Fin 2, Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) L)
        (f (MvPolynomial.X i)) (f.map_mem (hXmem K i)) Nat.one_pos ≫
      (Proj.map f hf ≫ Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) =
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) L)
        (f (MvPolynomial.X i)) (f.map_mem (hXmem K i)) Nat.one_pos ≫
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) L) ≫ Spec.map (CommRingCat.ofHom
        (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0))) ≫
        Spec.map (CommRingCat.ofHom (ρ : K →+* L))) := by
    intro i
    rw [hL i, ← Category.assoc,
      Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X i) (hXmem K i),
      Category.assoc, hK i, ← Spec.map_comp, ← CommRingCat.ofHom_comp, key i]
  have hnat : Proj.map f hf ≫ Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
      Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) L) ≫ Spec.map (CommRingCat.ofHom
        (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0))) ≫
