    have hP' : IsPullback (fst ≫ X.toSpecΓ) (snd ≫ Y.toSpecΓ) (Spec.map f.appTop)
        (Spec.map g.appTop) := by
      refine IsPullback.of_iso hpb (Iso.refl P) X.isoSpec Y.isoSpec Z.isoSpec ?_ ?_ ?_ ?_
      · simp [Scheme.isoSpec_hom]
      · simp [Scheme.isoSpec_hom]
