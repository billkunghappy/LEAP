    exact ⟨⟨isClosed_closure, isIrreducible_singleton.closure, hnt, hns_sub⟩, hD⟩
  obtain ⟨Er, ιE, θ, hιE, -, hrng, -⟩ := (wcpa_dj_nccw_fibre_forest R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA).2 _ hKF

  obtain ⟨ε₀, hε₀, hres⟩ := nccwst_generic_residue_iso R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA _ (hxu x₀) hx₀max Er ιE hιE hrng
  haveI := hιE
  haveI := hQ5.2
  haveI := hQ2.2.1
  have hφp : IsProper (ιE ≫ q' ≫ ν') := inferInstance
  have hφε : (ιE ≫ q' ≫ ν') ε₀ = (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x₀ := by
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hε₀, hνq]

  have hlift : ∀ i, ∃ ℓ : Spec (.of (PowerSeries (IsLocalRing.ResidueField R))) ⟶ Er, ℓ ≫ (ιE ≫ q' ≫ ν') = Spec.map (CommRingCat.ofHom (ψ i)) ≫ Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) := by
    intro i
    have hg := nccwst_arc_generic_point R Z' u' hst'.1 x _ hXc hxX hxc (PowerSeries (IsLocalRing.ResidueField R)) (ψ i) (hkill i) ⟨f i, hfm i, hfne i⟩ x₀ rfl
    exact nccwst_arc_lift Er Z' _ hφp _ _ (ψ i) ε₀ hres (hg.trans hφε.symm)
  choose ℓ hℓ using hlift

  have hfib : ∀ i, ν' (q' (ιE (ℓ i (IsLocalRing.closedPoint (PowerSeries (IsLocalRing.ResidueField R)))))) = Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x := by
    intro i
    obtain ⟨hφe, -, -⟩ := nccwst_lift_stalk_factor Er Z' _ _ _ (ψ i) (hψloc i) (ℓ i) (hℓ i) _ rfl
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hφe
    exact hφe
  have hmem : ∀ i, ιE (ℓ i (IsLocalRing.closedPoint (PowerSeries (IsLocalRing.ResidueField R)))) ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η (closure {x₀}) := by
    intro i
    rw [hDt, ← hrng]
    exact ⟨_, rfl⟩
  refine ⟨_, hmem 0, _, hmem 1, ?_, hfib 0, hfib 1⟩

  intro hy
  have he10 : ℓ 1 (IsLocalRing.closedPoint (PowerSeries (IsLocalRing.ResidueField R))) = ℓ 0 (IsLocalRing.closedPoint (PowerSeries (IsLocalRing.ResidueField R))) :=
    (ιE.isClosedEmbedding.injective hy).symm
  obtain ⟨hφ0, lam0, hlam0⟩ := nccwst_lift_stalk_factor Er Z' _ _ _ (ψ 0) (hψloc 0) (ℓ 0) (hℓ 0) _ rfl
  obtain ⟨hφ1, lam1, hlam1⟩ := nccwst_lift_stalk_factor Er Z' _ _ _ (ψ 1) (hψloc 1) (ℓ 1) (hℓ 1) _ he10
  obtain ⟨α, hα⟩ : ∃ α : Z'.presheaf.stalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) → Er.presheaf.stalk (ℓ 0 (IsLocalRing.closedPoint (PowerSeries (IsLocalRing.ResidueField R)))),
      ∀ m, α m = ((ιE ≫ q' ≫ ν').stalkMap _).hom ((Z'.presheaf.stalkCongr (Inseparable.of_eq hφ0.symm)).hom m) :=
    ⟨_, fun _ => rfl⟩
  have hl0 : ∀ m, lam0 (α m) = ψ 0 m := fun m => by rw [hα]; exact hlam0 m
  have hl1 : ∀ m, lam1 (α m) = ψ 1 m := fun m => by rw [hα]; exact hlam1 m
  rcases (nccwst_p1_stalk_total _ Er θ _).2 (α (f 0)) (α (f 1)) with ⟨d, hd⟩ | ⟨d, hd⟩
  · have e1 : ψ 1 (f 1) = ψ 1 (f 0) * lam1 d := by
      rw [← hl1 (f 1), ← hl1 (f 0), hd, map_mul]
    have h2 : PowerSeries.X ^ 2 ∣ ψ 1 (f 1) := by
      rw [e1]; exact dvd_mul_of_dvd_left (hψij 1 0 (by decide)) _
    have h3 := dvd_sub h2 (hψii 1)
    rw [sub_sub_cancel] at h3
    exact hX2 h3
  · have e1 : ψ 0 (f 0) = ψ 0 (f 1) * lam0 d := by
      rw [← hl0 (f 1), ← hl0 (f 0), hd, map_mul]
    have h2 : PowerSeries.X ^ 2 ∣ ψ 0 (f 0) := by
      rw [e1]; exact dvd_mul_of_dvd_left (hψij 0 1 (by decide)) _
    have h3 := dvd_sub h2 (hψii 0)
    rw [sub_sub_cancel] at h3
    exact hX2 h3

theorem wcpa_dj_nccw_half_points : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ T : Finset (Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))), (∀ X, X ∈ T ↔ X ∈ nccwEE R u' η q zk) → ∃ (Hp : Type u) (Φ D Tg : Hp → Set N) (d e : Hp → N) (w : Hp → S') (partner : Hp → Option Hp), Nat.card Hp = ∑ X ∈ T, (((X ∩ closure Xᶜ) \ nccwEint R u u' ν ν' q q' zk η).ncard + Nat.card { i // ∃ x ∈ X, ∃ p, (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x = (τ' i) ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) p) } + nccwSN2 R u' X) ∧ (∀ x, Φ x = ⇑q' ⁻¹' {w x} ∧ IsClosed ({w x} : Set S') ∧ (ν' ≫ u') (w x) = IsLocalRing.closedPoint R ∧ IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk (w x))) (S'.presheaf.stalk (w x)))) ∧ (∀ x, D x ∈ nccwKF (q ≫ ν ≫ u) q zk ∧ d x ∈ D x ∧ d x ∈ Φ x ∧ ¬ D x ⊆ Φ x) ∧ (∀ x, partner x = none → Tg x ∈ nccwXs u ν q st zk ∧ e x ∈ Tg x ∧ e x ∈ Φ x) ∧ (∀ x x', partner x = some x' → x' ≠ x ∧ partner x' = some x ∧ w x' = w x ∧ (¬ nccwXChain (nccwKF (q ≫ ν ≫ u) q zk) (Φ x) (D x) (D x') ∨ (D x = D x' ∧ d x ≠ d x'))) ∧ (∀ x x', x ≠ x' → w x = w x' → partner x = some x') :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA T hT
  classical
  have hA0 := hA
  obtain ⟨hcomp, halg, hPr, hH, hS⟩ := hA0
  obtain ⟨_, hst, hst', _, _, _, _, _, _, _, _, _, _, _, _, _, hp, hu, _, _⟩ := hH
  obtain ⟨-, hQ2, -, -, -, -, hQ7, hQ8, -, hQ10, -, -, -⟩ := hS
  have hρ : ∀ p : ↥(Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p = IsLocalRing.closedPoint R := by
    intro p
    apply PrimeSpectrum.ext
    rw [Spec.map_apply]
    change Ideal.comap (IsLocalRing.residue R)
      (p : PrimeSpectrum (IsLocalRing.ResidueField R)).asIdeal = IsLocalRing.maximalIdeal R
    haveI := (p : PrimeSpectrum (IsLocalRing.ResidueField R)).isPrime
    rw [Ideal.eq_bot_of_prime (p : PrimeSpectrum (IsLocalRing.ResidueField R)).asIdeal,
      ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
  obtain ⟨hemb, hrange, hnoeth, hgen, -⟩ :=
    wcpa_dj_nccw_special_fibre_topology R Z' u' hst'.1.2.1
  obtain ⟨hndfin, hthree⟩ := wcpa_dj_ncc_fibre_points R halg Z' u' hst'.1
  set Eint := nccwEint R u u' ν ν' q q' zk η with hEintdef
  haveI := hnoeth
  obtain ⟨p0, hp0⟩ : ∃ p0 : ↥(Spec (.of R)), p0 ≠ IsLocalRing.closedPoint R :=
    ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R), fun h0 =>
      IsDiscreteValuationRing.not_a_field R (congrArg PrimeSpectrum.asIdeal h0).symm⟩

  have hxu : ∀ x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), u' ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x) = IsLocalRing.closedPoint R := by
    intro x
    have hx : (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x ∈ Set.range (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) := ⟨x, rfl⟩
    rw [hrange] at hx
    exact hx
  have hcl : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ X' ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      X' ≠ X → X' ⊆ closure Xᶜ := by
    intro X hX X' hX' hne'
    have hsub : X' ⊆ X ∪ closure Xᶜ := fun y _ => by
      by_cases hy : y ∈ X
      · exact Or.inl hy
      · exact Or.inr (subset_closure hy)
    rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hX'.1.2) X (closure Xᶜ)
      (isClosed_of_mem_irreducibleComponents X hX) isClosed_closure hsub with h1 | h1
    · exact absurd (le_antisymm h1 (hX'.2 hX.1 h1)) hne'
    · exact h1
  have hDt : ∀ x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η (closure {x}) = closure {η ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x)} := by
    intro x
    have hX : ∃ y, closure {y} = closure {x} := ⟨x, rfl⟩
    unfold nccwDt
    rw [dif_pos hX, (inseparable_iff_closure_eq.mpr hX.choose_spec).eq]
  have hTE : ∀ X ∈ T, X ∈ nccwEE R u' η q zk := fun X hX => (hT X).mp hX
  have hTc : ∀ X ∈ T, X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) := fun X hX => (hTE X hX).1
  have hDtKF : ∀ X ∈ nccwEE R u' η q zk, nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X ∈ nccwKF (q ≫ ν ≫ u) q zk := by
    intro X hX
    obtain ⟨x, hxX, hxmax⟩ := hgen X hX.1
    obtain ⟨-, -, -, -, -, -, hns, hnt⟩ := hQ8 _ (hxu x) hxmax
    have hD := hX.2
    rw [← hxX, hDt] at hD ⊢
    exact ⟨⟨isClosed_closure, isIrreducible_singleton.closure, hnt, hns⟩, hD⟩
  have hnotsub : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ w : S', ¬ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X ⊆ q' ⁻¹' {w} := by
    intro X hX w hsub
    obtain ⟨x, rfl, hxm⟩ := hgen X hX
    rw [hDt] at hsub
    obtain ⟨-, -, -, -, -, ⟨W', hW', hiso⟩, -, hnt⟩ := hQ8 _ (hxu x) hxm
    haveI := hiso
    have hq0 : q' (η ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x)) = w := hsub (subset_closure (Set.mem_singleton _))
    obtain ⟨y, hy, hyne⟩ := hnt.exists_ne (η ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x))
    have hqy : q' y = w := hsub hy
    have hmem : ∀ z, q' z = w → z ∈ q' ⁻¹ᵁ W' := fun z hz => by
      show q' z ∈ W'
      rw [hz, ← hq0]
      exact hW'
    have e1 : ∀ (z : N) (hz : z ∈ q' ⁻¹ᵁ W'), W'.ι ((q' ∣_ W') ⟨z, hz⟩) = q' z := by
      intro z hz
      show ((q' ∣_ W') ≫ W'.ι) ⟨z, hz⟩ = q' z
      rw [morphismRestrict_ι]
      rfl
    have e2 : (q' ∣_ W') ⟨y, hmem y hqy⟩ = (q' ∣_ W') ⟨η ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x), hmem _ hq0⟩ :=
      W'.ι.isOpenEmbedding.injective (by rw [e1, e1, hqy, hq0])
    exact hyne (congrArg Subtype.val ((q' ∣_ W').isOpenEmbedding.injective e2))
  have hXsOf : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), X ∉ nccwEE R u' η q zk →
      nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X ∈ nccwXs u ν q st zk := by
    intro X hX hXE
    have hsub : ¬ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X ⊆ q ⁻¹' {zk} := fun hs => hXE ⟨hX, hs⟩
    obtain ⟨x, rfl, hxm⟩ := hgen X hX
    obtain ⟨-, -, -, -, -, -, hns, hnt⟩ := hQ8 _ (hxu x) hxm
    rw [hDt] at hsub ⊢
    exact ⟨isClosed_closure, isIrreducible_singleton.closure, hsub,
      Or.inl ⟨isClosed_closure, isIrreducible_singleton.closure, hnt, hns⟩⟩
  have hT3 : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ x ∈ X, x ∈ closure Xᶜ →
      ∃ Xb ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), Xb ≠ X ∧ x ∈ Xb := by
    intro X hX x _ hxc
    have hfin : (irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) \ {X}).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset Set.diff_subset
    have hcl' : IsClosed (⋃ Y ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) \ {X}, Y) :=
      hfin.isClosed_biUnion (fun Y hY => isClosed_of_mem_irreducibleComponents Y hY.1)
    have hsub : Xᶜ ⊆ ⋃ Y ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) \ {X}, Y := by
      intro y hy
      refine Set.mem_biUnion (x := irreducibleComponent y)
        ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩ mem_irreducibleComponent
      intro e
      rw [Set.mem_singleton_iff] at e
      exact hy (e ▸ mem_irreducibleComponent)
    have := closure_minimal hsub hcl' hxc
    obtain ⟨Y, ⟨hY, hYX⟩, hxY⟩ := Set.mem_iUnion₂.mp this
    exact ⟨Y, hY, fun e => hYX (Set.mem_singleton_iff.mpr e), hxY⟩
  have hXbex : ∀ (X : Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) (x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))), ∃ Xb : Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → x ∈ X →
      x ∈ closure Xᶜ → Xb ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) ∧ Xb ≠ X ∧ x ∈ Xb := by
    intro X x
    by_cases hc : X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) ∧ x ∈ X ∧ x ∈ closure Xᶜ
    · obtain ⟨Xb, h1, h2, h3⟩ := hT3 X hc.1 x hc.2.1 hc.2.2
      exact ⟨Xb, fun _ _ _ => ⟨h1, h2, h3⟩⟩
    · exact ⟨∅, fun h1 h2 h3 => absurd ⟨h1, h2, h3⟩ hc⟩
  choose Xb hXb using hXbex
  have hXbuniq : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ x ∈ X, x ∈ closure Xᶜ →
      ∀ X' ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), X' ≠ X → x ∈ X' → X' = Xb X x := by
    intro X hX x hxX hxc X' hX' hne' hx'
    obtain ⟨h1, h2, h3⟩ := hXb X x hX hxX hxc
    rcases hthree x X (Xb X x) X' hX h1 hX' hxX h3 hx' with e | e | e
    · exact absurd e.symm h2
    · exact absurd e.symm hne'
    · exact e.symm
  have hXbmem : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ x ∈ (X ∩ closure Xᶜ) \ Eint,
      x ∈ (Xb X x ∩ closure (Xb X x)ᶜ) \ Eint := by
    intro X hX x hx
    obtain ⟨h1, h2, h3⟩ := hXb X x hX hx.1.1 hx.1.2
    exact ⟨⟨h3, hcl (Xb X x) h1 X hX h2.symm hx.1.1⟩, hx.2⟩
  have hAns : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ x ∈ X, x ∈ closure Xᶜ →
      ¬ nccwSm u' ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x) := by
    intro X hX x hxX hxc hsm
    obtain ⟨h1, h2, h3⟩ := hXb X x hX hxX hxc
    exact h2 (wcpa_dj_nccw_hp_smooth_one_component R Z' u' x hsm _ h1 _ hX h3 hxX)
  have hcl1 : ∀ x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ¬ nccwSm u' ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x) → IsClosed ({(Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x} : Set Z') := fun x hns =>
    wcpa_dj_nccw_hp_nonsmooth_closed R halg Z' u' hst'.1 ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x) (hxu x) hns
  have huN : ∀ y : N, q y = zk → (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R := by
    intro y hy
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hy, hQ7.1, hp, hu]
  have hstu : ∀ i p, (q ≫ ν ≫ u) (st i p) = p := by
    intro i p
    have e : st i ≫ q ≫ ν ≫ u = 𝟙 _ := by
      rw [← Category.assoc q, ← Category.assoc, (hQ10 i).1, hst.2.1.1 i]
    rw [← Scheme.Hom.comp_apply, e]
    simp
  have hWne : ∀ (W : Fin 2 → S'), W 0 ≠ W 1 → ∀ a b : Fin 2, W a = W b → a = b := by
    intro W hW a b hab
    revert hab
    fin_cases a <;> fin_cases b <;> intro hab
    · rfl
    · exact absurd hab hW
    · exact absurd hab.symm hW
    · rfl

  obtain ⟨dom, hdom⟩ : ∃ dom : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → Prop, ∀ x, dom x ↔ IsDomain (AdicCompletion
      (IsLocalRing.maximalIdeal (Z'.presheaf.stalk ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x))) (Z'.presheaf.stalk ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x))) :=
    ⟨_, fun _ => Iff.rfl⟩

  have hτu : ∀ i (p : ↥(Spec (.of R))), u' (τ' i p) = p := by
    intro i p
    rw [← Scheme.Hom.comp_apply, hst'.2.1.1 i]
    simp
  have hτcl : ∀ i, IsClosed ({τ' i (IsLocalRing.closedPoint R)} : Set Z') := by
    intro i
    haveI := hst'.1.2.1
    haveI : IsClosedImmersion (τ' i ≫ u') := by rw [hst'.2.1.1 i]; infer_instance
    haveI : IsClosedImmersion (τ' i) := IsClosedImmersion.of_comp (τ' i) u'
    have hrc : IsClosed (Set.range (τ' i)) := (τ' i).isClosedEmbedding.isClosed_range
    have heq : ({τ' i (IsLocalRing.closedPoint R)} : Set Z') =
        Set.range (τ' i) ∩ u' ⁻¹' {IsLocalRing.closedPoint R} := by
      ext z
      constructor
      · rintro rfl
        exact ⟨⟨_, rfl⟩, hτu i _⟩
      · rintro ⟨⟨p, rfl⟩, hp'⟩
        have hp'' : p = IsLocalRing.closedPoint R := (hτu i p).symm.trans hp'
        rw [hp'']
        rfl
