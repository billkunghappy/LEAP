      f ≫ wcpaBscChartMap D j = (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i ∧
      ∀ (h : ⊤ ≤ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ (D.V i ⊓ D.V j)),
      ((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D j)))).inv ≫ f.appTop).hom
          (AdjoinRoot.root (wcpaBscPoly D j)) =
        (((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤ h).hom
            (wcpaBscU D i j) *
          ((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D i)))).inv ≫
            (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι.appTop).hom (AdjoinRoot.root (wcpaBscPoly D i)) +
        (((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤ h).hom
            (wcpaBscBeta D i j) := by
    intro i j
    have hσij : ⊤ ≤ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
        (D.V i ⊓ D.V j) := fun y _ => memσ i j y
    have hσi : ⊤ ≤ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ D.V i :=
      fun y _ => (memσ i j y).1
    have hσj : ⊤ ≤ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ D.V j :=
      fun y _ => (memσ i j y).2
    have hc : ∀ x : Γ(S, D.V i),
        (((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤
          hσij).hom (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) x) =
        ((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D i)))).inv ≫
          (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι.appTop).hom (AdjoinRoot.of (wcpaBscPoly D i) x) := by
      intro x
