          (nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
            η (X (finRotate (m + 2) i)))
          (nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
