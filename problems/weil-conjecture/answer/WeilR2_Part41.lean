          φ p * algebraMap (Y.presheaf.stalk w) Y.functionField den ∧
        num ∉ IsLocalRing.maximalIdeal (Y.presheaf.stalk w) ^ (B + 1) ∧
        den ∉ IsLocalRing.maximalIdeal (Y.presheaf.stalk w) ^ (B + 1) := by
    intro Y _ ι _ φ hφ Pts hPts hN
    classical
    have one : ∀ p, ∀ w ∈ Pts, ∃ M : ℕ, ∃ num den : Y.presheaf.stalk w,
