      letI smulS : ∀ V : X.Opens, SMul Γ(X, V) (S V) := fun V =>
        ⟨fun r y => ⟨fun j => (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * y.1 j,
          smulMem V r y.1 y.2⟩⟩
      letI modS : ∀ V : X.Opens, Module Γ(X, V) (S V) := fun V =>
        Module.ofMinimalAxioms
          (fun r x y => by
            ext j
            exact mul_add _ _ _)
          (fun r s x => by
            ext j
            change (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom (r + s) * x.1 j =
              (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * x.1 j +
              (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom s * x.1 j
            rw [map_add, add_mul])
          (fun r s x => by
            ext j
