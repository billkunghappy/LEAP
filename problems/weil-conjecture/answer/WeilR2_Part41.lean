          (Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D k)))).inv ≫ f₂.appTop := by
      rw [← Fspec, ← Fspec, H1]
    apply Fext
    apply CommRingCat.hom_ext
    apply AdjoinRoot.ringHom_ext
    · have H3 := congrArg CommRingCat.Hom.hom H2
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using H3
    · exact Hr
  have LT2 : ∀ (i j : D.J) {R : Type u} [CommRing R] (ψ : Γ(S, D.V i ⊓ D.V j) →+* R)
      (g : Γ(S, D.V j) →+* R),
      (∀ x, g x = ψ (wcpaBscRes S (inf_le_right : D.V i ⊓ D.V j ≤ D.V j) x)) →
      ∀ (A B C θ : R), θ ^ 2 - B * θ + A * C = 0 →
      ψ (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) (D.a i)) = A →
      ψ (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) (D.b i)) = B →
      ψ (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) (D.c i)) = C →
      Polynomial.eval₂ g (ψ (wcpaBscU D i j) * θ + ψ (wcpaBscBeta D i j)) (wcpaBscPoly D j) = 0 := by
    intro i j R _ ψ g hg A B C θ hθ hA hB hC
    show Polynomial.eval₂ g _ (Polynomial.X ^ 2 - Polynomial.C (D.b j) * Polynomial.X +
      Polynomial.C (D.a j * D.c j)) = 0
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
      Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C, map_mul, hg, D.rule_a i j,
      D.rule_b i j, D.rule_c i j, wcpaBscU, wcpaBscBeta, map_add, map_sub, map_pow, map_ofNat,
      hA, hB, hC]
    linear_combination (ψ (D.lam i j : Γ(S, D.V i ⊓ D.V j)) * (ψ (D.M i j 0 0) * ψ (D.M i j 1 1) -
      ψ (D.M i j 0 1) * ψ (D.M i j 1 0))) ^ 2 * hθ
  have LC : ∀ (i j k : D.J) {R : Type u} [CommRing R] (Φij : Γ(S, D.V i ⊓ D.V j) →+* R)
      (Φjk : Γ(S, D.V j ⊓ D.V k) →+* R) (Φik : Γ(S, D.V i ⊓ D.V k) →+* R) (θ : R),
      (∀ x, Φjk (wcpaBscRes S (inf_le_left : D.V j ⊓ D.V k ≤ D.V j) x) =
        Φij (wcpaBscRes S (inf_le_right : D.V i ⊓ D.V j ≤ D.V j) x)) →
      (∀ x, Φik (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V k ≤ D.V i) x) =
        Φij (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) x)) →
      Φik (D.lam i k : Γ(S, D.V i ⊓ D.V k)) =
        Φij (D.lam i j : Γ(S, D.V i ⊓ D.V j)) * Φjk (D.lam j k : Γ(S, D.V j ⊓ D.V k)) →
      (∀ r s, Φik (D.M i k r s) = Φij (D.M i j r 0) * Φjk (D.M j k 0 s) +
        Φij (D.M i j r 1) * Φjk (D.M j k 1 s)) →
      Φjk (wcpaBscU D j k) * (Φij (wcpaBscU D i j) * θ + Φij (wcpaBscBeta D i j)) +
          Φjk (wcpaBscBeta D j k) =
        Φik (wcpaBscU D i k) * θ + Φik (wcpaBscBeta D i k) := by
    intro i j k R _ Φij Φjk Φik θ R1 R2 R3 R4
    simp only [wcpaBscU, wcpaBscBeta, map_mul, map_add, map_sub, R1, R2, R3, R4, D.rule_a i j,
      D.rule_b i j, D.rule_c i j, map_pow, map_ofNat]
    ring
  have key : ∀ i j, ∃ f : ((wcpaBscChartMap D i ⁻¹ᵁ D.V j : (wcpaBscChart D i).Opens) : Scheme.{u}) ⟶
