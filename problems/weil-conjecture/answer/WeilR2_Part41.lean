by
  intro Y T q n σ m V W hle r π f h hLC hnzd hE2 hE3 hcov hVaff _hWaff

  have resres : ∀ {O1 O2 O3 : Y.Opens} (h12 : O2 ≤ O1) (h23 : O3 ≤ O2) (x : Γ(Y, O1)),
      (Y.presheaf.map (homOfLE h23).op).hom ((Y.presheaf.map (homOfLE h12).op).hom x) =
        (Y.presheaf.map (homOfLE (h23.trans h12)).op).hom x := by
    intro O1 O2 O3 h12 h23 x
    show (Y.presheaf.map (homOfLE h12).op ≫ Y.presheaf.map (homOfLE h23).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resid : ∀ {O : Y.Opens} (hO : O ≤ O) (x : Γ(Y, O)),
      (Y.presheaf.map (homOfLE hO).op).hom x = x := by
    intro O hO x
    rw [show (homOfLE hO).op = 𝟙 (Opposite.op O) from rfl, CategoryTheory.Functor.map_id]
    rfl

  have restrict2 : ∀ {O O' : Y.Opens} {U U' : T.Opens} (hO : O' ≤ O) (hU : U' ≤ U)
      (h1 : O ≤ q ⁻¹ᵁ U) (h2 : O' ≤ q ⁻¹ᵁ U') (a1 a2 x1 x2 : Γ(Y, O)),
      (letI : Algebra Γ(T, U) Γ(Y, O) := (q.appLE U O h1).hom.toAlgebra;
        a1 • KaehlerDifferential.D Γ(T, U) Γ(Y, O) x1 =
          a2 • KaehlerDifferential.D Γ(T, U) Γ(Y, O) x2) →
      (letI : Algebra Γ(T, U') Γ(Y, O') := (q.appLE U' O' h2).hom.toAlgebra;
        (Y.presheaf.map (homOfLE hO).op).hom a1 • KaehlerDifferential.D Γ(T, U') Γ(Y, O')
            ((Y.presheaf.map (homOfLE hO).op).hom x1) =
          (Y.presheaf.map (homOfLE hO).op).hom a2 • KaehlerDifferential.D Γ(T, U') Γ(Y, O')
            ((Y.presheaf.map (homOfLE hO).op).hom x2)) := by
    intro O O' U U' hO hU h1 h2 a1 a2 x1 x2 H
    have H2 := wcpa_dj_lcfg_kaehler_restrict q O O' U U' hO hU h1 h2 2 ![a1, -a2] ![x1, x2]
      (by
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons, Matrix.cons_val_fin_one, neg_smul]
        exact add_neg_eq_zero.mpr H)
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.cons_val_fin_one, map_neg, neg_smul] at H2
    exact add_neg_eq_zero.mp H2

  have cert : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (Gab Gbc Gac A B C : R) (xa xb xc : M),
      (Gab * A) • xb = B • xa → (Gbc * B) • xc = C • xb → (Gac * A) • xc = C • xa →
      ((Gab * Gbc - Gac) * B * A) • xc = 0 := by
    intro R M _ _ _ Gab Gbc Gac A B C xa xb xc h1 h2 h3
    calc ((Gab * Gbc - Gac) * B * A) • xc
        = (Gab * A) • ((Gbc * B) • xc) - B • ((Gac * A) • xc) := by
          rw [smul_smul, smul_smul, ← sub_smul]
          congr 1
          ring
      _ = (Gab * A) • (C • xb) - B • (C • xa) := by rw [h2, h3]
      _ = (C * (Gab * A)) • xb - B • (C • xa) := by rw [smul_smul, mul_comm (Gab * A) C]
      _ = C • (B • xa) - B • (C • xa) := by rw [← smul_smul, h1]
      _ = 0 := by rw [smul_smul, smul_smul, mul_comm, sub_self]

  have hrel := fun a b => wcpa_dj_lcfg_local_rel q n σ (V a) (V b) (W a) (W b) (hle a) (hle b)
    (r a) (r b) (π a) (π b) (f a) (f b) (h a) (h b) (hLC a) (hLC b) (hnzd a) (hnzd b)
    (hE2 a) (hE2 b) (hE3 a) (hE3 b)
  choose S γ hzS hREL using hrel

  have hcompat : ∀ (a b : Fin m) (x y : Y) (hx : x ∈ V a ⊓ V b) (hy : y ∈ V a ⊓ V b),
      (Y.presheaf.map (homOfLE (inf_le_left : Y.basicOpen (S a b x hx) ⊓
          Y.basicOpen (S a b y hy) ≤ Y.basicOpen (S a b x hx))).op).hom
        (γ a b x hx : Γ(Y, Y.basicOpen (S a b x hx))) =
      (Y.presheaf.map (homOfLE (inf_le_right : Y.basicOpen (S a b x hx) ⊓
          Y.basicOpen (S a b y hy) ≤ Y.basicOpen (S a b y hy))).op).hom
        (γ a b y hy : Γ(Y, Y.basicOpen (S a b y hy))) := by
    intro a b x y hx hy
    have hDx : Y.basicOpen (S a b x hx) ≤ V a ⊓ V b := Y.basicOpen_le _
    have hOa : Y.basicOpen (S a b x hx) ⊓ Y.basicOpen (S a b y hy) ≤ V a :=
      inf_le_left.trans (hDx.trans inf_le_left)
    have hOb : Y.basicOpen (S a b x hx) ⊓ Y.basicOpen (S a b y hy) ≤ V b :=
      inf_le_left.trans (hDx.trans inf_le_right)
    have hOU : Y.basicOpen (S a b x hx) ⊓ Y.basicOpen (S a b y hy) ≤ q ⁻¹ᵁ (W a ⊓ W b) :=
      fun z hz => ⟨hle a (hOa hz), hle b (hOb hz)⟩
    rw [← sub_eq_zero]
    apply wcpa_dj_lcfg_local_annih (V a) (r a) n (fun j => π a (wcpaDjJacMinor (f a) j)) (h a)
      (hLC a).1 (hnzd a) (hE3 a) _ hOa
    intro j
    apply wcpa_dj_lcfg_local_rigid q (V b) (W b) (hle b) (r b) (π b) (f b) (hLC b).1 (hLC b).2.1
      (hLC b).2.2.1 (hLC b).2.2.2.1 (hLC b).2.2.2.2.1 (hE2 b) (hE3 b) _ (W a ⊓ W b) hOb hOU
    refine fun k => ?_
    have e1 := restrict2 (inf_le_left : Y.basicOpen (S a b x hx) ⊓ Y.basicOpen (S a b y hy) ≤
      Y.basicOpen (S a b x hx)) le_rfl _ hOU _ _ _ _ (hREL a b x hx j k)
    have e2 := restrict2 (inf_le_right : Y.basicOpen (S a b x hx) ⊓ Y.basicOpen (S a b y hy) ≤
      Y.basicOpen (S a b y hy)) le_rfl _ hOU _ _ _ _ (hREL a b y hy j k)
    simp only [map_mul, resres] at e1 e2
    simp only [map_mul]
    rw [sub_mul, sub_smul, e1, e2, sub_self]

  have hglue : ∀ a b : Fin m, ∃ g : (Γ(Y, V a ⊓ V b))ˣ, ∀ (z : Y) (hz : z ∈ V a ⊓ V b),
      (Y.presheaf.map (homOfLE (Y.basicOpen_le (S a b z hz))).op).hom (g : Γ(Y, V a ⊓ V b)) =
        γ a b z hz := by
    intro a b
    obtain ⟨g, hg⟩ := wcpa_dj_lcfg_glue_units (V a ⊓ V b) {z : Y // z ∈ V a ⊓ V b}
      (fun i => Y.basicOpen (S a b i.1 i.2)) (fun i => Y.basicOpen_le _)
      (fun x hx => TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hzS a b x hx⟩)
      (fun i => γ a b i.1 i.2) (fun i j => hcompat a b i.1 j.1 i.2 j.2)
    exact ⟨g, fun z hz => hg ⟨z, hz⟩⟩
  choose g hg using hglue

  have hR : ∀ (a b : Fin m) (j : Fin (r a + 1)) (k : Fin (r b + 1)),
      (letI : Algebra Γ(T, W a ⊓ W b) Γ(Y, V a ⊓ V b) :=
        (q.appLE (W a ⊓ W b) (V a ⊓ V b) (fun x hx => ⟨hle a hx.1, hle b hx.2⟩)).hom.toAlgebra;
      ((g a b : Γ(Y, V a ⊓ V b)) * (Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom
          ((∏ i, h a i) * π a (wcpaDjJacMinor (f a) j))) •
        KaehlerDifferential.D Γ(T, W a ⊓ W b) Γ(Y, V a ⊓ V b)
          ((Y.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom
            (π b (MvPolynomial.X k))) =
      (Y.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom
          ((∏ i, h b i) * π b (wcpaDjJacMinor (f b) k)) •
        KaehlerDifferential.D Γ(T, W a ⊓ W b) Γ(Y, V a ⊓ V b)
          ((Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom
            (π a (MvPolynomial.X j)))) := by
    intro a b j k
    have H := wcpa_dj_lcfg_kaehler_local q (V a ⊓ V b) (W a ⊓ W b)
      (fun x hx => ⟨hle a hx.1, hle b hx.2⟩) (hVaff a b) 2
      ![(g a b : Γ(Y, V a ⊓ V b)) *
          (Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom
            ((∏ i, h a i) * π a (wcpaDjJacMinor (f a) j)),
        -((Y.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom
            ((∏ i, h b i) * π b (wcpaDjJacMinor (f b) k)))]
      ![(Y.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom
          (π b (MvPolynomial.X k)),
        (Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom
          (π a (MvPolynomial.X j))]
      (by
        intro z hz
        refine ⟨S a b z hz, hzS a b z hz, ?_⟩
        have E := hREL a b z hz j k
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons, Matrix.cons_val_fin_one, map_neg, neg_smul, map_mul, resres, hg]
        simp only [map_mul] at E
        exact add_neg_eq_zero.mpr E)
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.cons_val_fin_one, neg_smul] at H
    exact add_neg_eq_zero.mp H

  have hcoc : ∀ a b c : Fin m,
      (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V c ≤ V a ⊓ V b from inf_le_left)).op).hom
          (g a b : Γ(Y, V a ⊓ V b)) *
        (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V c ≤ V b ⊓ V c from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom
          (g b c : Γ(Y, V b ⊓ V c)) =
      (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V c ≤ V a ⊓ V c from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom
          (g a c : Γ(Y, V a ⊓ V c)) := by
    intro a b c
    have hOa : V a ⊓ V b ⊓ V c ≤ V a := inf_le_left.trans inf_le_left
    have hOb : V a ⊓ V b ⊓ V c ≤ V b := inf_le_left.trans inf_le_right
    have hOc : V a ⊓ V b ⊓ V c ≤ V c := inf_le_right
    have hOU : V a ⊓ V b ⊓ V c ≤ q ⁻¹ᵁ (W a ⊓ W b ⊓ W c) :=
      fun x hx => ⟨⟨hle a hx.1.1, hle b hx.1.2⟩, hle c hx.2⟩
    rw [← sub_eq_zero]
    apply wcpa_dj_lcfg_local_annih (V b) (r b) n (fun k => π b (wcpaDjJacMinor (f b) k)) (h b)
      (hLC b).1 (hnzd b) (hE3 b) _ hOb
    intro k'
    apply wcpa_dj_lcfg_local_annih (V a) (r a) n (fun j => π a (wcpaDjJacMinor (f a) j)) (h a)
      (hLC a).1 (hnzd a) (hE3 a) _ hOa
    intro j
    apply wcpa_dj_lcfg_local_rigid q (V c) (W c) (hle c) (r c) (π c) (f c) (hLC c).1 (hLC c).2.1
      (hLC c).2.2.1 (hLC c).2.2.2.1 (hLC c).2.2.2.2.1 (hE2 c) (hE3 c) _ (W a ⊓ W b ⊓ W c) hOc hOU
    refine fun l => ?_
    have Tab := restrict2 (show V a ⊓ V b ⊓ V c ≤ V a ⊓ V b from inf_le_left)
      (show W a ⊓ W b ⊓ W c ≤ W a ⊓ W b from inf_le_left) _ hOU _ _ _ _ (hR a b j k')
    have Tbc := restrict2 (show V a ⊓ V b ⊓ V c ≤ V b ⊓ V c from
        le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      (show W a ⊓ W b ⊓ W c ≤ W b ⊓ W c from le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      _ hOU _ _ _ _ (hR b c k' l)
    have Tac := restrict2 (show V a ⊓ V b ⊓ V c ≤ V a ⊓ V c from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      (show W a ⊓ W b ⊓ W c ≤ W a ⊓ W c from le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      _ hOU _ _ _ _ (hR a c j l)
    simp only [map_mul, resres] at Tab Tbc Tac
    have key := cert _ _ _ _ _ _ _ _ _ Tab Tbc Tac
    simp only [map_mul]
    exact key

  have hgaa : ∀ a, g a a = 1 := by
    intro a
    have hu : IsUnit ((Y.presheaf.map (homOfLE (show V a ⊓ V a ⊓ V a ≤ V a ⊓ V a from
        inf_le_left)).op).hom (g a a : Γ(Y, V a ⊓ V a))) := (g a a).isUnit.map _
    have hx1 : (Y.presheaf.map (homOfLE (show V a ⊓ V a ⊓ V a ≤ V a ⊓ V a from
        inf_le_left)).op).hom (g a a : Γ(Y, V a ⊓ V a)) = 1 := by
      apply hu.mul_left_cancel
      rw [mul_one]
      exact hcoc a a a
    have e := resres (show V a ⊓ V a ⊓ V a ≤ V a ⊓ V a from inf_le_left)
      (show V a ⊓ V a ≤ V a ⊓ V a ⊓ V a from le_inf le_rfl inf_le_left)
      (g a a : Γ(Y, V a ⊓ V a))
    rw [hx1, map_one, resid] at e
    exact Units.ext e.symm

  refine ⟨⟨m, V, g⟩, ?_, ?_⟩
  · unfold wcpaDjCocOK
    exact ⟨fun a => (hLC a).1, hcov, hgaa, hcoc⟩
  · unfold wcpaDjLogCanon
    refine ⟨W, hle, r, π, f, h, hLC, ?_⟩
    intro a b j k
    unfold wcpaDjLogTrans
    refine ⟨0, ?_⟩
    rw [pow_zero, one_smul, sub_eq_zero]
    have E := hR a b j k
    simp only [map_mul] at E
    simpa only [map_mul, mul_assoc] using E

theorem wcpa_dj_lcp_fac_log_cocycle : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS →
    ∀ (uu : Z ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ Z)), wcpaDjSemistable uu →
    wcpaDjSections uu n τ → ∃ L : wcpaDjCoc Z, wcpaDjCocOK L ∧ wcpaDjLogCanon uu τ L :=
by
  intro k _ S Z sS hS uu n τ hss hsec
  have proj_proper : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)),
      wcpaDjIsProjOver k s → IsProper s := by
    intro Y s hs
    obtain ⟨N, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
          (x : MvPolynomial (Fin (N + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance
  haveI hsSp : IsProper sS := proj_proper sS hS
  haveI huup : IsProper uu := hss.2.1
  haveI : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace sS
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace uu
  haveI hk : IsSeparated (Limits.terminal.from (Spec (.of k))) :=
    Scheme.IsSeparated.isSeparated_terminal_from
  haveI hSsep : S.IsSeparated := ⟨by
    rw [show Limits.terminal.from S = sS ≫ Limits.terminal.from (Spec (.of k)) from
      Limits.terminal.hom_ext _ _]
    infer_instance⟩
  haveI hZsep : Z.IsSeparated := ⟨by
    rw [show Limits.terminal.from Z = uu ≫ sS ≫ Limits.terminal.from (Spec (.of k)) from
      Limits.terminal.hom_ext _ _]
    infer_instance⟩

  have hpt : ∀ z : Z, ∃ (V : Z.Opens) (W : S.Opens) (hle : V ≤ uu ⁻¹ᵁ W) (r : ℕ)
      (π : MvPolynomial (Fin (r + 1)) Γ(S, W) →+* Γ(Z, V))
      (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(S, W)) (h : Fin n → Γ(Z, V)),
      z ∈ V ∧ wcpaDjLogChart uu τ V W hle r π f h ∧ (∀ i, h i ∈ nonZeroDivisors Γ(Z, V)) ∧
      (∀ c : Fin r → MvPolynomial (Fin (r + 1)) Γ(S, W),
        ∑ i, c i * f i ∈ RingHom.ker π ^ 2 → ∀ i, c i ∈ RingHom.ker π) ∧
      (∀ v : Γ(Z, V), (∀ j, v * π (wcpaDjJacMinor f j) = 0) → v = 0) := by
    intro z
    obtain ⟨V, W, hle, r, π, f, hzV, hV, hW, hsurj, hC, hker, hE2, hE3⟩ :=
      wcpa_dj_lcf_syntomic_chart k S Z sS hS uu hss z
    obtain ⟨s, hzs, hsD⟩ :=
      wcpa_dj_lcf_section_equation k S Z sS hS uu n τ hss hsec V hV z hzV
    choose hA hsurjτ h hnzd hkerτ using hsD
    have hsc : Z.basicOpen s ≤ uu ⁻¹ᵁ S.basicOpen (1 : Γ(S, W)) := by
      rw [Scheme.basicOpen_one]
      exact (Z.basicOpen_le s).trans hle
    obtain ⟨π', f', hsurj', hC', hker', hE2', hE3', -, -⟩ :=
      wcpa_dj_lcf_chart_localize uu V W hle r π f hV hW hsurj hC hker hE2 hE3 s 1 hsc
    exact ⟨Z.basicOpen s, S.basicOpen (1 : Γ(S, W)), hsc, r + 1, π', f', h, hzs,
      ⟨hV.basicOpen s, hW.basicOpen 1, hsurj', hC', hker', fun i => ⟨hA i, hsurjτ i, hkerτ i⟩⟩,
      hnzd, hE2', hE3'⟩
  choose V W hle r π f h hzV hLC hnzd hE2 hE3 using hpt

  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun z => (V z : Set Z))
    (fun z => (V z).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hzV x⟩)
  let e := t.equivFin
  let pt : Fin t.card → Z := fun a => (e.symm a).1
  have hcov : (⨆ a, V (pt a)) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx := ht (Set.mem_univ x)
    rw [Set.mem_iUnion₂] at hx
    obtain ⟨i, hi, hxi⟩ := hx
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨e ⟨i, hi⟩, ?_⟩
    have hpe : pt (e ⟨i, hi⟩) = i := by simp [pt]
    rw [hpe]
    exact hxi

  exact wcpa_dj_lcf_glue uu n τ t.card (fun a => V (pt a)) (fun a => W (pt a))
    (fun a => hle (pt a)) (fun a => r (pt a)) (fun a => π (pt a)) (fun a => f (pt a))
    (fun a => h (pt a)) (fun a => hLC (pt a)) (fun a => hnzd (pt a)) (fun a => hE2 (pt a))
    (fun a => hE3 (pt a)) hcov (fun a b => (hLC (pt a)).1.inf (hLC (pt b)).1)
    (fun a b => (hLC (pt a)).2.1.inf (hLC (pt b)).2.1)

theorem wcpa_dj_lcp_fsb_logcanon_basechange_sec : ∀ {Y T T' : Scheme.{u}} (q : Y ⟶ T) (n : ℕ)
    (σ : Fin n → (T ⟶ Y)) (L : wcpaDjCoc Y) (b : T' ⟶ T), IsAffineHom b →
    (∀ i, σ i ≫ q = 𝟙 T) →
    wcpaDjLogCanon q σ L → ∀ σ' : Fin n → (T' ⟶ Limits.pullback q b),
    (∀ i, σ' i ≫ Limits.pullback.snd q b = 𝟙 T') →
    (∀ i, σ' i ≫ Limits.pullback.fst q b = b ≫ σ i) →
    wcpaDjLogCanon (Limits.pullback.snd q b) σ' (wcpaDjCocPull (Limits.pullback.fst q b) L) :=
by
  have s2 : ∀ {R R' A A' B B' : CommRingCat.{u}} (α : R ⟶ A) (ρ : R ⟶ R') (κ : A ⟶ A')
      (α' : R' ⟶ A') (β : R ⟶ B) (μ : B ⟶ B') (β' : R' ⟶ B') (φ : A ⟶ B) (φ' : A' ⟶ B')
      (hA : IsPushout α ρ κ α') (hB : IsPushout β ρ μ β') (h1 : α ≫ φ = β) (h2 : α' ≫ φ' = β')
      (h3 : κ ≫ φ' = φ ≫ μ) (hφ : Function.Surjective φ.hom) (G : Set A)
      (hG : RingHom.ker φ.hom = Ideal.span G),
      Function.Surjective φ'.hom ∧ RingHom.ker φ'.hom = Ideal.span (κ.hom '' G) := by
    intro R R' A A' B B' α ρ κ α' β μ β' φ φ' hA hB h1 h2 h3 hφ G hG
    have h3' : ∀ x, φ'.hom (κ.hom x) = μ.hom (φ.hom x) := fun x => by
      have := congrArg (fun f => f.hom x) h3
      simpa using this
    have h2' : ∀ x, φ'.hom (α'.hom x) = β'.hom x := fun x => by
      have := congrArg (fun f => f.hom x) h2
      simpa using this
    have hAw : ∀ x, κ.hom (α.hom x) = α'.hom (ρ.hom x) := fun x => by
      have := congrArg (fun f => f.hom x) hA.w
      simpa using this
    have hBw : ∀ x, μ.hom (β.hom x) = β'.hom (ρ.hom x) := fun x => by
      have := congrArg (fun f => f.hom x) hB.w
      simpa using this
    have h1' : ∀ x, φ.hom (α.hom x) = β.hom x := fun x => by
      have := congrArg (fun f => f.hom x) h1
      simpa using this
    set I := Ideal.span (κ.hom '' G) with hI
    have hIle : I ≤ RingHom.ker φ'.hom := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨g, hg, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker]
      rw [h3']
      have : g ∈ RingHom.ker φ.hom := hG ▸ Ideal.subset_span hg
      rw [RingHom.mem_ker] at this
      rw [this, map_zero]
    let mk := Ideal.Quotient.mk I
    have hker : RingHom.ker φ.hom ≤ RingHom.ker (mk.comp κ.hom) := by
      rw [hG, Ideal.span_le]
      intro g hg
      simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨g, hg, rfl⟩
    let ψ := φ.hom.liftOfSurjective hφ ⟨mk.comp κ.hom, hker⟩
    have hψ : ∀ x, ψ (φ.hom x) = mk (κ.hom x) := fun x =>
      RingHom.liftOfSurjective_comp_apply _ _ _ x
    have hcoc : β ≫ CommRingCat.ofHom ψ = ρ ≫ α' ≫ CommRingCat.ofHom mk := by
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [← h1', hψ, hAw]
    let θ := hB.desc (CommRingCat.ofHom ψ) (α' ≫ CommRingCat.ofHom mk) hcoc
    have hθ1 : μ ≫ θ = CommRingCat.ofHom ψ := hB.inl_desc _ _ _
    have hθ2 : β' ≫ θ = α' ≫ CommRingCat.ofHom mk := hB.inr_desc _ _ _
    have hφθ : φ' ≫ θ = CommRingCat.ofHom mk := by
      apply hA.hom_ext
      · rw [← Category.assoc, h3, Category.assoc, hθ1]
        ext x
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        exact hψ x
      · rw [← Category.assoc, h2, hθ2]
    have hφθ' : ∀ x, θ.hom (φ'.hom x) = mk x := fun x => by
      have := congrArg (fun f => f.hom x) hφθ
      simpa using this
    refine ⟨?_, ?_⟩
    · let S := φ'.hom.range
      have hμS : ∀ y, μ.hom y ∈ S := by
        intro y
        obtain ⟨a, rfl⟩ := hφ y
        exact ⟨κ.hom a, h3' a⟩
      have hβS : ∀ y, β'.hom y ∈ S := fun y => ⟨α'.hom y, h2' y⟩
      let μS : B →+* S := μ.hom.codRestrict S hμS
      let βS : R' →+* S := β'.hom.codRestrict S hβS
      have hcS : β ≫ CommRingCat.ofHom μS = ρ ≫ CommRingCat.ofHom βS := by
        ext x
        exact hBw x
      let s := hB.desc (CommRingCat.ofHom μS) (CommRingCat.ofHom βS) hcS
      have hs : s ≫ CommRingCat.ofHom S.subtype = 𝟙 B' := by
        apply hB.hom_ext
        · rw [← Category.assoc, hB.inl_desc, Category.comp_id]
          ext x
          rfl
        · rw [← Category.assoc, hB.inr_desc, Category.comp_id]
          ext x
          rfl
      intro y
      have := congrArg (fun f => f.hom y) hs
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        CommRingCat.hom_id, RingHom.id_apply] at this
      rw [← this]
      exact (s.hom y).2
    · apply le_antisymm _ hIle
      intro x hx
      rw [RingHom.mem_ker] at hx
      have := hφθ' x
      rw [hx, map_zero] at this
      exact (Ideal.Quotient.eq_zero_iff_mem).mp this.symm


  have s3 : ∀ {R R' : CommRingCat.{u}} (ρ : R ⟶ R') (r : ℕ),
      IsPushout (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin (r + 1)) R)) ρ
        (CommRingCat.ofHom (MvPolynomial.map ρ.hom))
        (CommRingCat.ofHom (MvPolynomial.C : R' →+* MvPolynomial (Fin (r + 1)) R')) := by
    intro R R' ρ r
    have w : CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin (r + 1)) R) ≫
        CommRingCat.ofHom (MvPolynomial.map ρ.hom) =
        ρ ≫ CommRingCat.ofHom (MvPolynomial.C : R' →+* MvPolynomial (Fin (r + 1)) R') := by
      ext x
      simp [MvPolynomial.map_C]
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ w) ?_
    refine Limits.PushoutCocone.IsColimit.mk _
      (fun s => CommRingCat.ofHom (MvPolynomial.eval₂Hom s.inr.hom
        (fun j => s.inl.hom (MvPolynomial.X j)))) ?_ ?_ ?_
    · intro s
      have hc : ∀ c, s.inl.hom (MvPolynomial.C c) = s.inr.hom (ρ.hom c) := fun c => by
        have := congrArg (fun f => f.hom c) s.condition
        simpa using this
      ext1
      apply MvPolynomial.ringHom_ext
      · intro c
        simp [hc]
      · intro j
        simp
    · intro s
      ext x
      simp
    · intro s m h1 h2
      have h1' : ∀ p, m.hom (MvPolynomial.map ρ.hom p) = s.inl.hom p := fun p => by
        have := congrArg (fun f => f.hom p) h1
        simpa using this
      have h2' : ∀ c, m.hom (MvPolynomial.C c) = s.inr.hom c := fun c => by
        have := congrArg (fun f => f.hom c) h2
        simpa using this
      ext1
      apply MvPolynomial.ringHom_ext
      · intro c
        simp [h2']
      · intro j
        have := h1' (MvPolynomial.X j)
        rw [MvPolynomial.map_X] at this
        simp [this]


  have s4 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) {r : ℕ}
      (f : Fin r → MvPolynomial (Fin (r + 1)) R) (j : Fin (r + 1)),
      MvPolynomial.map φ (wcpaDjJacMinor f j) =
        wcpaDjJacMinor (fun i => MvPolynomial.map φ (f i)) j := by
    intro R S _ _ φ r f j
    unfold wcpaDjJacMinor
    rw [map_mul, map_pow, map_neg, map_one, RingHom.map_det]
    congr 2
    ext i l
    simp [RingHom.mapMatrix_apply, MvPolynomial.pderiv_map]


  have s5 : ∀ {R A R' A' : Type u} [CommRing R] [CommRing A] [CommRing R'] [CommRing A']
      (α : R →+* A) (α' : R' →+* A') (ρ : R →+* R') (κ : A →+* A'),
      κ.comp α = α'.comp ρ → ∀ (N : ℕ) (c u v x y : A),
      (letI := α.toAlgebra; c ^ N • (u • KaehlerDifferential.D R A y -
        v • KaehlerDifferential.D R A x) = 0) →
      (letI := α'.toAlgebra; κ c ^ N • (κ u • KaehlerDifferential.D R' A' (κ y) -
        κ v • KaehlerDifferential.D R' A' (κ x)) = 0) := by
    intro R A R' A' _ _ _ _ α α' ρ κ
    intro hsq N c u v x y hN
    letI : Algebra R A := α.toAlgebra
    letI : Algebra R' A' := α'.toAlgebra
    letI : Algebra R R' := ρ.toAlgebra
    letI : Algebra A A' := κ.toAlgebra
    letI : Algebra R A' := (κ.comp α).toAlgebra
    haveI : IsScalarTower R A A' := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower R R' A' := IsScalarTower.of_algebraMap_eq' hsq
    haveI : SMulCommClass R' A A' := ⟨fun r a z => by
      simp only [Algebra.smul_def]
      ring⟩
    have h := congrArg (KaehlerDifferential.map R R' A A') hN
    rw [map_zero, map_smul, map_sub, map_smul, map_smul, KaehlerDifferential.map_D,
      KaehlerDifferential.map_D] at h
    rw [← algebraMap_smul A' (c ^ N), ← algebraMap_smul A' u, ← algebraMap_smul A' v, map_pow] at h
    exact h
  have key1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    simp only [Scheme.Opens.topIso_hom, Scheme.Hom.appTop]
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE]
    exact (Scheme.Hom.appLE_map _ _ _).trans (Scheme.Hom.map_appLE _ _ _).symm
  have key2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens),
      (f ∣_ U).appTop ≫ (f ⁻¹ᵁ U).topIso.hom = U.topIso.hom ≫ f.app U := by
    intro X Y f U
    rw [← Scheme.Hom.resLE_eq_morphismRestrict, key1, ← Scheme.Hom.app_eq_appLE]
  have s1 : ∀ {X X' T₀ T₀' : Scheme.{u}} (g₁ : X' ⟶ X) (g₂ : X' ⟶ T₀') (f₀ : X ⟶ T₀)
      (b₀ : T₀' ⟶ T₀) (hpb : IsPullback g₁ g₂ f₀ b₀) (V : X.Opens) (W : T₀.Opens)
      (hVW : V ≤ f₀ ⁻¹ᵁ W) (hle' : g₁ ⁻¹ᵁ V ≤ g₂ ⁻¹ᵁ (b₀ ⁻¹ᵁ W)) (hV : IsAffineOpen V)
      (hW : IsAffineOpen W) (hW' : IsAffineOpen (b₀ ⁻¹ᵁ W)),
      IsPushout (f₀.appLE W V hVW) (b₀.app W) (g₁.app V) (g₂.appLE (b₀ ⁻¹ᵁ W) (g₁ ⁻¹ᵁ V) hle') := by
    intro X X' T₀ T₀' g₁ g₂ f₀ b₀ hpb V W hVW hle' hV hW hW'
    have hbig : IsPullback (g₁ ∣_ V) (g₂.resLE (b₀ ⁻¹ᵁ W) (g₁ ⁻¹ᵁ V) hle' ≫ (b₀ ⁻¹ᵁ W).ι)
        (f₀.resLE W V hVW ≫ W.ι) b₀ := by
      rw [Scheme.Hom.resLE_comp_ι, Scheme.Hom.resLE_comp_ι]
      exact (isPullback_morphismRestrict g₁ V).paste_vert hpb
    have hsq : IsPullback (g₁ ∣_ V) (g₂.resLE (b₀ ⁻¹ᵁ W) (g₁ ⁻¹ᵁ V) hle')
        (f₀.resLE W V hVW) (b₀ ∣_ W) := by
      refine IsPullback.of_bot hbig ?_ (isPullback_morphismRestrict b₀ W)
      rw [← cancel_mono W.ι]
      simp only [Category.assoc, Scheme.Hom.resLE_comp_ι, morphismRestrict_ι]
      rw [← Category.assoc, morphismRestrict_ι, Category.assoc, hpb.w, ← Category.assoc,
        ← Category.assoc (Scheme.Hom.resLE g₂ _ _ _), Scheme.Hom.resLE_comp_ι]
    have iV : IsAffine V := hV
    have iW : IsAffine W := hW
    have iW' : IsAffine (b₀ ⁻¹ᵁ W) := hW'
    have hobj : ∀ i, IsAffine ((Limits.cospan (f₀.resLE W V hVW) (b₀ ∣_ W)).obj i) := by
      rintro (_ | _ | _)
      · exact iW
      · exact iV
      · exact iW'
    have : Limits.PreservesLimit (Limits.cospan (f₀.resLE W V hVW) (b₀ ∣_ W)) Scheme.Γ.rightOp :=
      AlgebraicGeometry.preservesLimit_rightOp_Γ _
    have h2 := (hsq.map Scheme.Γ.rightOp).unop.flip
    exact h2.of_iso W.topIso V.topIso (b₀ ⁻¹ᵁ W).topIso (g₁ ⁻¹ᵁ V).topIso
      (key1 _ _ _ _) (key2 _ _) (key2 _ _) (key1 _ _ _ _)
  have mainthm : ∀ {Y T T' P : Scheme.{u}} (q : Y ⟶ T) (n : ℕ)
      (σ : Fin n → (T ⟶ Y)) (L : wcpaDjCoc Y) (b : T' ⟶ T) (hb : IsAffineHom b)
      (hsec : ∀ i, σ i ≫ q = 𝟙 T) (hLC : wcpaDjLogCanon q σ L)
      (p₁ : P ⟶ Y) (p₂ : P ⟶ T') (hpb : IsPullback p₁ p₂ q b) (σ' : Fin n → (T' ⟶ P))
      (hσ's : ∀ i, σ' i ≫ p₂ = 𝟙 T') (hσ'f : ∀ i, σ' i ≫ p₁ = b ≫ σ i),
      wcpaDjLogCanon p₂ σ' (wcpaDjCocPull p₁ L) := by
    intro Y T T' P q n σ L b hb hsec hLC p₁ p₂ hpb σ' hσ's hσ'f
    have appLE_eq : ∀ {X Z : Scheme.{u}} (f g : X ⟶ Z), f = g → ∀ (U : Z.Opens) (V : X.Opens)
        (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
      intro X Z f g hfg U V e e'
      subst hfg
      rfl
    obtain ⟨W, hle, r, π, f, h, hchart, htrans⟩ := hLC
    have hcond : p₁ ≫ q = p₂ ≫ b := hpb.w
    haveI : IsAffineHom b := hb
    haveI hp₁a : IsAffineHom p₁ := MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip hb
    have hle' : ∀ a, p₁ ⁻¹ᵁ L.V a ≤ p₂ ⁻¹ᵁ (b ⁻¹ᵁ W a) := by
      intro a x hx
      have h1 : q (p₁ x) ∈ W a := hle a hx
      show b (p₂ x) ∈ W a
      rw [← Scheme.Hom.comp_apply, ← hcond, Scheme.Hom.comp_apply]
      exact h1
    obtain ⟨π', hπ'⟩ : ∃ π' : ∀ a, MvPolynomial (Fin (r a + 1)) Γ(T', b ⁻¹ᵁ W a) →+*
        Γ(P, p₁ ⁻¹ᵁ L.V a), ∀ a, π' a = MvPolynomial.eval₂Hom
          (p₂.appLE (b ⁻¹ᵁ W a) (p₁ ⁻¹ᵁ L.V a) (hle' a)).hom
          (fun j => (p₁.app (L.V a)).hom (π a (MvPolynomial.X j))) := ⟨_, fun _ => rfl⟩
    have hπ'C : ∀ a c, π' a (MvPolynomial.C c) =
        (p₂.appLE (b ⁻¹ᵁ W a) (p₁ ⁻¹ᵁ L.V a) (hle' a)).hom c := by
      intro a c
      rw [hπ', MvPolynomial.eval₂Hom_C]
    have hπ'X : ∀ a j, π' a (MvPolynomial.X j) = (p₁.app (L.V a)).hom (π a (MvPolynomial.X j)) := by
      intro a j
      rw [hπ', MvPolynomial.eval₂Hom_X']
    have KC : ∀ a, q.appLE (W a) (L.V a) (hle a) ≫ p₁.app (L.V a) =
        b.app (W a) ≫ p₂.appLE (b ⁻¹ᵁ W a) (p₁ ⁻¹ᵁ L.V a) (hle' a) := by
      intro a
      rw [Scheme.Hom.app_eq_appLE p₁, Scheme.Hom.app_eq_appLE b, Scheme.Hom.appLE_comp_appLE,
        Scheme.Hom.appLE_comp_appLE]
      exact appLE_eq _ _ hcond _ _ _ _
    have K1 : ∀ a, (π' a).comp (MvPolynomial.map (b.app (W a)).hom) =
        (p₁.app (L.V a)).hom.comp (π a) := by
      intro a
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C, hπ'C, (hchart a).2.2.2.1 c]
        exact (congrArg (fun φ => φ.hom c) (KC a)).symm
      · intro j
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_X, hπ'X]
    have I2 : ∀ a z, (p₁.app (L.V a)).hom (π a z) =
        π' a (MvPolynomial.map (b.app (W a)).hom z) := by
      intro a z
      exact (RingHom.congr_fun (K1 a) z).symm
    have PA : ∀ a, IsPushout (q.appLE (W a) (L.V a) (hle a)) (b.app (W a)) (p₁.app (L.V a))
        (p₂.appLE (b ⁻¹ᵁ W a) (p₁ ⁻¹ᵁ L.V a) (hle' a)) := fun a =>
      s1 p₁ p₂ q b hpb (L.V a) (W a) (hle a) (hle' a) (hchart a).1 (hchart a).2.1
        ((hchart a).2.1.preimage b)
    refine ⟨fun a => b ⁻¹ᵁ W a, hle', r, π',
      fun a i => MvPolynomial.map (b.app (W a)).hom (f a i),
      fun a i => (p₁.app (L.V a)).hom (h a i), ?_, ?_⟩
    · intro a
      obtain ⟨hV, hW, hπs, hπC, hπk, hsecs⟩ := hchart a
      have e1 : CommRingCat.ofHom (MvPolynomial.C : Γ(T, W a) →+* MvPolynomial (Fin (r a + 1)) Γ(T, W a))
          ≫ CommRingCat.ofHom (π a) = q.appLE (W a) (L.V a) (hle a) := by
        ext c
        exact hπC c
      have e2 : CommRingCat.ofHom
          (MvPolynomial.C : Γ(T', b ⁻¹ᵁ W a) →+* MvPolynomial (Fin (r a + 1)) Γ(T', b ⁻¹ᵁ W a))
          ≫ CommRingCat.ofHom (π' a) = p₂.appLE (b ⁻¹ᵁ W a) (p₁ ⁻¹ᵁ L.V a) (hle' a) := by
        ext c
        exact hπ'C a c
      have e3 : CommRingCat.ofHom (MvPolynomial.map (b.app (W a)).hom) ≫ CommRingCat.ofHom (π' a) =
          CommRingCat.ofHom (π a) ≫ p₁.app (L.V a) := by
        exact CommRingCat.hom_ext (K1 a)
      have hmain := s2 _ _ _ _ _ _ _ _ _ (s3 (b.app (W a)) (r a)) (PA a) e1 e2 e3 hπs
        (Set.range (f a)) hπk
      refine ⟨hV.preimage p₁, hW.preimage b, hmain.1, hπ'C a, ?_, ?_⟩
      · refine hmain.2.trans ?_
        rw [← Set.range_comp]
        rfl
      · intro i
        obtain ⟨hUa, hσs, hσk⟩ := hsecs i
        have hUW : σ i ⁻¹ᵁ L.V a ≤ (𝟙 T) ⁻¹ᵁ W a := by
          intro x hx
          have h1 : q (σ i x) ∈ W a := hle a hx
          rw [← Scheme.Hom.comp_apply, hsec i] at h1
          exact h1
        have hUb : b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a) ≤ (𝟙 T') ⁻¹ᵁ (b ⁻¹ᵁ W a) := by
          intro x hx
          have h1 : q (σ i (b x)) ∈ W a := hle a hx
          rw [← Scheme.Hom.comp_apply, hsec i] at h1
          exact h1
        have hσle : b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a) ≤ σ' i ⁻¹ᵁ (p₁ ⁻¹ᵁ L.V a) := by
          intro x hx
          show p₁ (σ' i x) ∈ L.V a
          rw [← Scheme.Hom.comp_apply, hσ'f i, Scheme.Hom.comp_apply]
          exact hx
        have A2 := s1 b (𝟙 T') (𝟙 T) b (IsPullback.id_vert b) (σ i ⁻¹ᵁ L.V a) (W a) hUW hUb hUa hW
          (hW.preimage b)
        have f1 : q.appLE (W a) (L.V a) (hle a) ≫ (σ i).app (L.V a) =
            Scheme.Hom.appLE (𝟙 T) (W a) (σ i ⁻¹ᵁ L.V a) hUW := by
          rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
          exact appLE_eq _ _ (hsec i) _ _ _ _
        have f2 : p₂.appLE (b ⁻¹ᵁ W a) (p₁ ⁻¹ᵁ L.V a) (hle' a) ≫
            (σ' i).appLE (p₁ ⁻¹ᵁ L.V a) (b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a)) hσle =
            Scheme.Hom.appLE (𝟙 T') (b ⁻¹ᵁ W a) (b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a)) hUb := by
          rw [Scheme.Hom.appLE_comp_appLE]
          exact appLE_eq _ _ (hσ's i) _ _ _ _
        have f3 : p₁.app (L.V a) ≫ (σ' i).appLE (p₁ ⁻¹ᵁ L.V a) (b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a)) hσle =
            (σ i).app (L.V a) ≫ b.app (σ i ⁻¹ᵁ L.V a) := by
          rw [Scheme.Hom.app_eq_appLE p₁, Scheme.Hom.app_eq_appLE (σ i), Scheme.Hom.app_eq_appLE b,
            Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
          exact appLE_eq _ _ (hσ'f i) _ _ _ _
        have hsm := s2 _ _ _ _ _ _ _ _ _ (PA a) A2 f1 f2 f3 hσs {h a i} hσk
        rw [Set.image_singleton] at hsm
        have E : b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a) = σ' i ⁻¹ᵁ (p₁ ⁻¹ᵁ L.V a) := by
          ext x
          show σ i (b x) ∈ L.V a ↔ p₁ (σ' i x) ∈ L.V a
          rw [← Scheme.Hom.comp_apply b (σ i), ← Scheme.Hom.comp_apply (σ' i) p₁, hσ'f i]
        have key : ∀ (V' : T'.Opens) (_ : b ⁻¹ᵁ (σ i ⁻¹ᵁ L.V a) = V')
            (e' : V' ≤ σ' i ⁻¹ᵁ (p₁ ⁻¹ᵁ L.V a)),
            Function.Surjective ((σ' i).appLE (p₁ ⁻¹ᵁ L.V a) V' e').hom ∧
            RingHom.ker ((σ' i).appLE (p₁ ⁻¹ᵁ L.V a) V' e').hom =
              Ideal.span {(p₁.app (L.V a)).hom (h a i)} := by
          rintro V' rfl e'
          exact hsm
        have hAff : IsAffineOpen (σ' i ⁻¹ᵁ (p₁ ⁻¹ᵁ L.V a)) := by
          rw [← E]
          exact hUa.preimage b
        refine ⟨hAff, ?_⟩
        rw [Scheme.Hom.app_eq_appLE]
        exact key _ E _
    · intro a c
      change Fin L.m at a c
      intro j k
      obtain ⟨N, hN⟩ := htrans a c j k
      have hsq : (p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx)).hom.comp
          (q.appLE (W a ⊓ W c) (L.V a ⊓ L.V c) (fun x hx => ⟨hle a hx.1, hle c hx.2⟩)).hom =
          (p₂.appLE (b ⁻¹ᵁ W a ⊓ b ⁻¹ᵁ W c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c)
            (fun x hx => ⟨hle' a hx.1, hle' c hx.2⟩)).hom.comp
          (b.appLE (W a ⊓ W c) (b ⁻¹ᵁ W a ⊓ b ⁻¹ᵁ W c) (fun _ hx => hx)).hom := by
        rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
        congr 1
        exact (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans ((appLE_eq _ _ hcond _ _ _ _).trans
          (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).symm)
      have h5 := s5 _ _ _ _ hsq N _ _ _ _ _ hN
      have I1a : ∀ z, (p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx)).hom
          ((Y.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V c ≤ L.V a)).op).hom z) =
          (P.presheaf.map (homOfLE
            (inf_le_left : p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c ≤ p₁ ⁻¹ᵁ L.V a)).op).hom
            ((p₁.app (L.V a)).hom z) := by
        intro z
        have e : Y.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V c ≤ L.V a)).op ≫
            p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx) =
            p₁.app (L.V a) ≫ P.presheaf.map (homOfLE
              (inf_le_left : p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c ≤ p₁ ⁻¹ᵁ L.V a)).op := by
          rw [Scheme.Hom.app_eq_appLE]
          exact (Scheme.Hom.map_appLE _ _ _).trans (Scheme.Hom.appLE_map _ _ _).symm
        exact congrArg (fun φ => φ.hom z) e
      have I1c : ∀ z, (p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx)).hom
          ((Y.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V c ≤ L.V c)).op).hom z) =
          (P.presheaf.map (homOfLE
            (inf_le_right : p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c ≤ p₁ ⁻¹ᵁ L.V c)).op).hom
            ((p₁.app (L.V c)).hom z) := by
        intro z
        have e : Y.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V c ≤ L.V c)).op ≫
            p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx) =
            p₁.app (L.V c) ≫ P.presheaf.map (homOfLE
              (inf_le_right : p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c ≤ p₁ ⁻¹ᵁ L.V c)).op := by
          rw [Scheme.Hom.app_eq_appLE]
          exact (Scheme.Hom.map_appLE _ _ _).trans (Scheme.Hom.appLE_map _ _ _).symm
        exact congrArg (fun φ => φ.hom z) e
      have I4 : (p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx)).hom
          (L.g a c : Γ(Y, L.V a ⊓ L.V c)) =
          Units.val ((wcpaDjCocPull p₁ L).g a c) := by
        have e : p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c) (fun _ hx => hx) =
            p₁.app (L.V a ⊓ L.V c) ≫ P.presheaf.map (homOfLE
              (show p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c ≤ p₁ ⁻¹ᵁ (L.V a ⊓ L.V c) from fun _ hx => hx)).op := by
          rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
        rw [e]
        rfl
      simp only [map_mul (p₁.appLE (L.V a ⊓ L.V c) (p₁ ⁻¹ᵁ L.V a ⊓ p₁ ⁻¹ᵁ L.V c)
          (fun _ hx => hx)).hom, I1a, I1c, I4, I2, s4, MvPolynomial.map_X,
        map_prod (p₁.app (L.V a)).hom, map_prod (p₁.app (L.V c)).hom] at h5
      exact ⟨N, h5⟩
  intro Y T T' q n σ L b hb hsec hLC σ' hσ's hσ'f
  exact mainthm q n σ L b hb hsec hLC _ _ (IsPullback.of_hasPullback q b) σ' hσ's hσ'f

theorem wcpa_dj_clr_smooth_derivations_dependent (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (V : C.Opens) (W : (Spec (.of K)).Opens) (hle : V ≤ q ⁻¹ᵁ W)
    (hV : IsAffineOpen V) (z : C) (hz : z ∈ V) (W₀ : C.Opens) (hz₀ : z ∈ W₀)
    (hsm : SmoothOfRelativeDimension 1 (W₀.ι ≫ q)) (δ δ' : Γ(C, V) → C.residueField z)
    (hδa : ∀ x y, δ (x + y) = δ x + δ y)
    (hδm : ∀ x y, δ (x * y) = (C.presheaf.germ V z hz ≫ C.residue z).hom x * δ y +
      (C.presheaf.germ V z hz ≫ C.residue z).hom y * δ x)
    (hδc : ∀ c, δ ((q.appLE W V hle).hom c) = 0)
    (hδa' : ∀ x y, δ' (x + y) = δ' x + δ' y)
    (hδm' : ∀ x y, δ' (x * y) = (C.presheaf.germ V z hz ≫ C.residue z).hom x * δ' y +
      (C.presheaf.germ V z hz ≫ C.residue z).hom y * δ' x)
    (hδc' : ∀ c, δ' ((q.appLE W V hle).hom c) = 0) :
    ∃ a b : C.residueField z, (a ≠ 0 ∨ b ≠ 0) ∧ ∀ x, a * δ x + b * δ' x = 0 :=
by
  classical

  have extL : ∀ (A O k : Type u) [CommRing A] [CommRing O] [Algebra A O] [Field k]
      (M : Submonoid A) [IsLocalization M O] (ρ : O →+* k) (D : A → k),
      (∀ x y, D (x + y) = D x + D y) →
      (∀ x y, D (x * y) = ρ (algebraMap A O x) * D y + ρ (algebraMap A O y) * D x) →
      ∃ D' : O → k, (∀ x y, D' (x + y) = D' x + D' y) ∧
        (∀ x y, D' (x * y) = ρ x * D' y + ρ y * D' x) ∧
        ∀ a, D' (algebraMap A O a) = D a := by
    intro A O k _ _ _ _ M _ ρ D hDa hDm
    have hD1 : D 1 = 0 := by
      have h := hDm 1 1
      simp only [mul_one, one_mul, map_one] at h
      linear_combination -h
    have hD0 : D 0 = 0 := by
      have h := hDa 0 0
      simp only [add_zero] at h
      linear_combination -h
    let φ : A →+* TrivSqZeroExt k k :=
      { toFun := fun x => TrivSqZeroExt.inl (ρ (algebraMap A O x)) + TrivSqZeroExt.inr (D x)
        map_one' := by
          ext <;> simp [hD1]
        map_mul' := by
          intro x y
          ext
          · simp
          · (simp [hDm, smul_eq_mul, op_smul_eq_mul]) <;> ring
        map_zero' := by
          ext <;> simp [hD0]
        map_add' := by
          intro x y
          ext
          · simp
          · simp [hDa] }
    have hφfst : ∀ a, (φ a).fst = ρ (algebraMap A O a) := fun a => by simp [φ]
    have hφsnd : ∀ a, (φ a).snd = D a := fun a => by simp [φ]
    have hunit : ∀ y : M, IsUnit (φ y) := by
      intro y
      rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, hφfst]
      exact (IsLocalization.map_units O y).map ρ
    let ψ : O →+* TrivSqZeroExt k k := IsLocalization.lift hunit
    have hψ : ∀ a, ψ (algebraMap A O a) = φ a := fun a => IsLocalization.lift_eq hunit a
    let fstH : TrivSqZeroExt k k →+* k :=
      { toFun := TrivSqZeroExt.fst
        map_one' := TrivSqZeroExt.fst_one
        map_mul' := TrivSqZeroExt.fst_mul
        map_zero' := TrivSqZeroExt.fst_zero
        map_add' := TrivSqZeroExt.fst_add }
    have hfst : fstH.comp ψ = ρ := by
      apply IsLocalization.ringHom_ext M
      ext a
      show (ψ (algebraMap A O a)).fst = ρ (algebraMap A O a)
      rw [hψ, hφfst]
    have hfst' : ∀ x, (ψ x).fst = ρ x := fun x => RingHom.congr_fun hfst x
    refine ⟨fun x => (ψ x).snd, ?_, ?_, ?_⟩
    · intro x y
      simp only [map_add, TrivSqZeroExt.snd_add]
    · intro x y
      simp only [map_mul, TrivSqZeroExt.snd_mul, hfst', smul_eq_mul, op_smul_eq_mul]
      ring
    · intro a
      simp only [hψ, hφsnd]

  have rank1 : ∀ (O k : Type u) [CommRing O] [Algebra K O] [Field k] (ρ : O →+* k),
      Module.Free O Ω[O⁄K] → Module.finrank O Ω[O⁄K] = 1 →
      ∀ (D₁ D₂ : O → k), (∀ x y, D₁ (x + y) = D₁ x + D₁ y) →
      (∀ x y, D₁ (x * y) = ρ x * D₁ y + ρ y * D₁ x) → (∀ c, D₁ (algebraMap K O c) = 0) →
      (∀ x y, D₂ (x + y) = D₂ x + D₂ y) →
      (∀ x y, D₂ (x * y) = ρ x * D₂ y + ρ y * D₂ x) → (∀ c, D₂ (algebraMap K O c) = 0) →
      ∃ a b : k, (a ≠ 0 ∨ b ≠ 0) ∧ ∀ x, a * D₁ x + b * D₂ x = 0 := by
    intro O k _ _ _ ρ hfree hrank D₁ D₂ h1a h1m h1c h2a h2m h2c
    haveI : Nontrivial O := ρ.domain_nontrivial
    letI : Algebra O k := ρ.toAlgebra
    letI : Algebra K k := (ρ.comp (algebraMap K O)).toAlgebra
    haveI : IsScalarTower K O k := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have mkDer : ∀ (D : O → k), (∀ x y, D (x + y) = D x + D y) →
        (∀ x y, D (x * y) = ρ x * D y + ρ y * D x) → (∀ c, D (algebraMap K O c) = 0) →
        ∃ δ : Derivation K O k, ∀ x, δ x = D x := by
      intro D hDa hDm hDc
      let δl : O →ₗ[K] k :=
        { toFun := D
          map_add' := hDa
          map_smul' := fun c x => by
            rw [Algebra.smul_def, hDm, hDc, mul_zero, add_zero, RingHom.id_apply,
              Algebra.smul_def]
            rfl }
      refine ⟨Derivation.mk' δl (fun a b => ?_), fun x => rfl⟩
      show D (a * b) = a • D b + b • D a
      rw [hDm, Algebra.smul_def, Algebra.smul_def]
      rfl
    obtain ⟨δ₁, hδ₁⟩ := mkDer D₁ h1a h1m h1c
    obtain ⟨δ₂, hδ₂⟩ := mkDer D₂ h2a h2m h2c
    let bs := Module.basisUnique Unit hrank
    have hrep : ∀ x : O, ∃ r : O, ∀ δ : Derivation K O k,
        δ x = ρ r * δ.liftKaehlerDifferential (bs default) := by
      intro x
      refine ⟨bs.repr (KaehlerDifferential.D K O x) default, fun δ => ?_⟩
      have h := bs.sum_repr (KaehlerDifferential.D K O x)
      rw [Fintype.sum_unique] at h
      rw [← Derivation.liftKaehlerDifferential_comp_D δ x]
      conv_lhs => rw [← h]
      rw [map_smul, Algebra.smul_def]
      rfl
    by_cases hα : δ₁.liftKaehlerDifferential (bs default) = 0
    · refine ⟨1, 0, Or.inl one_ne_zero, fun x => ?_⟩
      obtain ⟨r, hr⟩ := hrep x
      rw [← hδ₁, hr δ₁, hα]
      ring
    · refine ⟨δ₂.liftKaehlerDifferential (bs default), -δ₁.liftKaehlerDifferential (bs default),
        Or.inr (neg_ne_zero.mpr hα), fun x => ?_⟩
      obtain ⟨r, hr⟩ := hrep x
      rw [← hδ₁, ← hδ₂, hr δ₁, hr δ₂]
      ring

  letI iAO : Algebra Γ(C, V) (C.presheaf.stalk z) :=
    C.presheaf.algebra_section_stalk (⟨z, hz⟩ : V)
  haveI := hV.isLocalization_stalk ⟨z, hz⟩
  obtain ⟨D₁, hD₁a, hD₁m, hD₁r⟩ := extL Γ(C, V) (C.presheaf.stalk z) (C.residueField z)
    (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl (C.residue z).hom δ hδa hδm
  obtain ⟨D₂, hD₂a, hD₂m, hD₂r⟩ := extL Γ(C, V) (C.presheaf.stalk z) (C.residueField z)
    (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl (C.residue z).hom δ' hδa' hδm'
  obtain ⟨_, hfree, _, hrank⟩ := wcpa_dj_lr1k_gs_open_smooth_stalk_data K C q 1 z W₀ hz₀ hsm
  letI iKO : Algebra K (C.presheaf.stalk z) := (wcLdpConst K q z).toAlgebra
  have hconst : ∀ c : K, ∃ c' : Γ(Spec (.of K), W),
      algebraMap K (C.presheaf.stalk z) c =
        algebraMap Γ(C, V) (C.presheaf.stalk z) ((q.appLE W V hle).hom c') := by
    intro c
    have hW : W = ⊤ := by
      have hq : q z ∈ W := hle hz
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have : x = q z := Subsingleton.elim _ _
      rw [this]; exact hq
    subst hW
    refine ⟨(Scheme.ΓSpecIso (.of K)).inv.hom c, ?_⟩
    have e1 : q.appLE ⊤ V hle ≫ C.presheaf.germ V z hz =
        q.appTop ≫ C.presheaf.germ ⊤ z trivial := by
      rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
      rfl
    have e2 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    exact e2.symm
  obtain ⟨a, b, hab, h⟩ := rank1 (C.presheaf.stalk z) (C.residueField z) (C.residue z).hom
    hfree hrank D₁ D₂ hD₁a hD₁m
    (fun c => by obtain ⟨c', hc'⟩ := hconst c; rw [hc', hD₁r]; exact hδc c')
    hD₂a hD₂m
    (fun c => by obtain ⟨c', hc'⟩ := hconst c; rw [hc', hD₂r]; exact hδc' c')
  refine ⟨a, b, hab, fun x => ?_⟩
  have hx := h (algebraMap Γ(C, V) (C.presheaf.stalk z) x)
  rwa [hD₁r, hD₂r] at hx

theorem wcpa_dj_cdp_log_ratio (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C)
    (W : Fin L.m → (Spec (.of K)).Opens) (hle : ∀ a, L.V a ≤ q ⁻¹ᵁ W a) (r : Fin L.m → ℕ)
    (π : ∀ a, MvPolynomial (Fin (r a + 1)) Γ(Spec (.of K), W a) →+* Γ(C, L.V a))
    (f : ∀ a, Fin (r a) → MvPolynomial (Fin (r a + 1)) Γ(Spec (.of K), W a))
    (h : ∀ a, Fin n → Γ(C, L.V a))
    (hst : wcpaDjStablePtd q n σ) (hOK : wcpaDjCocOK L)
    (hchart : ∀ a, wcpaDjLogChart q σ (L.V a) (W a) (hle a) (r a) (π a) (f a) (h a))
    (htrans : ∀ a b (j : Fin (r a + 1)) (k : Fin (r b + 1)),
      wcpaDjLogTrans q (hle a) (hle b) (π a) (π b) (f a) (f b) (h a) (h b)
        (L.g a b : Γ(C, L.V a ⊓ L.V b)) j k)
    (ξ : C) (hξ : closure {ξ} ∈ irreducibleComponents C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (D : Derivation K (C.residueField ξ) (C.residueField ξ)) (hD : D ≠ 0) :
    ∃ φ : Fin L.m → C.residueField ξ,
      (∀ b (hb : ξ ∈ L.V b), φ b ≠ 0 ∧ wcpaDjLogGen ξ (L.V b) hb (π b) (f b) (h b) ⇑D (φ b)) ∧
      ∀ a b (hab : ξ ∈ L.V a ⊓ L.V b),
        (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom
          (L.g a b : Γ(C, L.V a ⊓ L.V b)) = φ a * (φ b)⁻¹ :=
by
  classical

  have wcpa_dj_clr_nilpotent_not_node (K O O' : Type u) [Field K] [CommRing O] [IsLocalRing O]
      [CommRing O'] [IsLocalRing O'] (e : O ≃+* O')
      (hN : IsNilpotent (IsLocalRing.maximalIdeal O')) :
      IsEmpty (AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span
          {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) := by
    constructor
    intro E
    obtain ⟨N, hNn⟩ := hN
    set 𝔪 := IsLocalRing.maximalIdeal O with h𝔪
    have hmap : Ideal.map e 𝔪 = IsLocalRing.maximalIdeal O' := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
        exact hx
      · intro y hy
        have : e.symm y ∈ 𝔪 := by
          rw [h𝔪, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← isUnit_map_iff e,
            RingEquiv.apply_symm_apply]
          exact hy
        have h2 := Ideal.mem_map_of_mem e this
        rwa [RingEquiv.apply_symm_apply] at h2
    have hpow : 𝔪 ^ N = ⊥ := by
      have h1 : Ideal.map e (𝔪 ^ N) = ⊥ := by rw [Ideal.map_pow, hmap, hNn]; rfl
      exact (Ideal.map_eq_bot_iff_of_injective e.injective).mp h1
    have hsm : ∀ n, N ≤ n → 𝔪 ^ n • (⊤ : Submodule O O) = ⊥ := by
      intro n hn
      rw [eq_bot_iff]
      calc 𝔪 ^ n • (⊤ : Submodule O O) ≤ 𝔪 ^ N • ⊤ :=
            Submodule.smul_mono_left (Ideal.pow_le_pow_right hn)
        _ = ⊥ := by rw [hpow, Submodule.bot_smul]
    haveI : IsHausdorff 𝔪 O := ⟨fun x hx => by
      have := hx N
      rw [SModEq, hsm N le_rfl, Submodule.Quotient.eq] at this
      simpa using this⟩
    haveI : IsPrecomplete 𝔪 O := ⟨fun f hf => by
      refine ⟨f N, fun n => ?_⟩
      rcases le_total n N with h | h
      · exact hf h
      · have := hf h
        rw [SModEq, hsm N le_rfl, Submodule.Quotient.eq] at this
        have h' : f N = f n := by simpa [sub_eq_zero] using this
        rw [h']⟩
    haveI : IsAdicComplete 𝔪 O := {}
    let F : (MvPowerSeries (Fin 2) K ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) ≃+* O' :=
      E.symm.trans ((AdicCompletion.ofAlgEquiv 𝔪).symm.toRingEquiv.trans e)
    set I := Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}
      with hI
    set s : MvPowerSeries (Fin 2) K ⧸ I := Ideal.Quotient.mk I (MvPowerSeries.X 0) with hs
    have hcc : ∀ a ∈ I, MvPowerSeries.constantCoeff a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp
    let ev : (MvPowerSeries (Fin 2) K ⧸ I) →+* K :=
      Ideal.Quotient.lift I MvPowerSeries.constantCoeff hcc
    have hsnu : ¬ IsUnit s := by
      intro hu
      have := hu.map ev
      simp [ev, hs] at this
    have hsnn : ¬ IsNilpotent s := by
      rintro ⟨m, hm⟩
      rw [hs, ← map_pow, Ideal.Quotient.eq_zero_iff_mem, hI, Ideal.mem_span_singleton'] at hm
      obtain ⟨c, hc⟩ := hm
      have h1 := congrArg (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) m)) hc
      rw [MvPowerSeries.X_pow_eq, MvPowerSeries.coeff_monomial_same, ← mul_assoc,
        MvPowerSeries.X_def (1 : Fin 2), MvPowerSeries.coeff_mul_monomial] at h1
      rw [if_neg] at h1
      · exact one_ne_zero h1.symm
      · intro hle
        have := hle 1
        simp at this
    apply hsnn
    have hFs : F s ∈ IsLocalRing.maximalIdeal O' := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
      exact hsnu
    have hnil : IsNilpotent (F s) := by
      refine ⟨N, ?_⟩
      have : F s ^ N ∈ IsLocalRing.maximalIdeal O' ^ N := Ideal.pow_mem_pow hFs N
      rw [hNn] at this
      exact this
    obtain ⟨k, hk⟩ := hnil
    refine ⟨k, F.injective ?_⟩
    rw [map_pow, hk, map_zero]

  have wcpa_dj_clr_generic_stalk_nilpotent (C : Scheme.{u}) [IsLocallyNoetherian C] (ξ : C)
      (hξ : closure {ξ} ∈ irreducibleComponents C) :
      IsNilpotent (IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)) := by
    obtain ⟨⟨V', hVa'⟩, hξV'⟩ : ∃ V : C.affineOpens, ξ ∈ (V : C.Opens) := by
      obtain ⟨_, ⟨V, hV, rfl⟩, hξV, -⟩ :=
        (C.isBasis_affineOpens).exists_subset_of_mem_open (Set.mem_univ ξ) isOpen_univ
      exact ⟨⟨V, hV⟩, hξV⟩
    have hVa : IsAffineOpen V' := hVa'
    change ξ ∈ V' at hξV'
    set p := hVa.primeIdealOf ⟨ξ, hξV'⟩ with hp
    have hmin : p.asIdeal ∈ minimalPrimes Γ(C, V') := by
      refine ⟨⟨p.isPrime, bot_le⟩, fun q hq hle => ?_⟩
      haveI := hq.1
      let qq : PrimeSpectrum Γ(C, V') := ⟨q, hq.1⟩
      have hsp : qq ⤳ p := (PrimeSpectrum.le_iff_specializes qq p).mp hle
      have hsp' : hVa.fromSpec qq ⤳ ξ := by
        have := hsp.map hVa.fromSpec.continuous
        rwa [hp, IsAffineOpen.fromSpec_primeIdealOf] at this
      have hcl : closure {ξ} ⊆ closure {hVa.fromSpec qq} :=
        (specializes_iff_closure_subset.mp hsp')
      have hirr : IsIrreducible (closure {hVa.fromSpec qq}) := isIrreducible_singleton.closure
      have heq := hξ.2 hirr hcl
      have hmem : hVa.fromSpec qq ∈ closure {ξ} := heq (subset_closure rfl)
      have hsp2 : ξ ⤳ hVa.fromSpec qq := specializes_iff_mem_closure.mpr hmem
      have hEq : hVa.fromSpec qq = ξ := (hsp'.antisymm hsp2).eq
      have hEq' : hVa.fromSpec qq = hVa.fromSpec p := by
        rw [hEq, hp, IsAffineOpen.fromSpec_primeIdealOf]
      have := hVa.fromSpec.isOpenEmbedding.injective hEq'
      rw [← this]
    letI := C.presheaf.algebra_section_stalk (⟨ξ, hξV'⟩ : V')
    haveI := hVa.isLocalization_stalk ⟨ξ, hξV'⟩
    haveI : Ring.KrullDimLE 0 (C.presheaf.stalk ξ) :=
      Ring.KrullDimLE.of_isLocalization p.asIdeal hmin (C.presheaf.stalk ξ)
    have hEq : IsLocalRing.maximalIdeal (C.presheaf.stalk ξ) = nilradical (C.presheaf.stalk ξ) := by
      ext x
      rw [mem_nilradical, Ring.KrullDimLE.isNilpotent_iff_mem_maximalIdeal]
    rw [hEq]
    exact IsNoetherianRing.isNilpotent_nilradical _

  have wcpa_dj_clr_semistable_point_dichotomy (K : Type u) [Field K] [IsAlgClosed K]
      (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (hq : wcpaDjSemistable q) (x : C) :
      (∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∨
      ∃ (O : Type u) (_ : CommRing O) (_ : IsLocalRing O), Nonempty (O ≃+* C.presheaf.stalk x) ∧
        Nonempty (AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span
            {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) := by
    obtain ⟨_, _, h3⟩ := hq
    haveI : IsIso (Limits.pullback.fst q (𝟙 (Spec (.of K)))) :=
      Limits.pullback_fst_iso_of_right_iso _ _
    obtain ⟨w, rfl⟩ : ∃ w, Limits.pullback.fst q (𝟙 (Spec (.of K))) w = x :=
      ⟨(inv (Limits.pullback.fst q (𝟙 (Spec (.of K))))) x, by
        rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]; rfl⟩
    rcases h3 K (𝟙 _) w with ⟨W, hwW, hsm⟩ | ⟨e, _⟩
    · left
      set fst := Limits.pullback.fst q (𝟙 (Spec (.of K)))
      refine ⟨fst ''ᵁ W, ⟨w, hwW, rfl⟩, ?_⟩
      have hsq : (fst.isoImage W).hom ≫ (fst ''ᵁ W).ι = W.ι ≫ fst :=
        Scheme.Hom.isoImage_hom_ι _ _
      have e1 : W.ι ≫ Limits.pullback.snd q (𝟙 _) =
          (fst.isoImage W).hom ≫ (fst ''ᵁ W).ι ≫ q := by
        rw [← Category.assoc, hsq, Category.assoc, Limits.pullback.condition, Category.comp_id]
      have e2 : (fst ''ᵁ W).ι ≫ q =
          (fst.isoImage W).inv ≫ W.ι ≫ Limits.pullback.snd q (𝟙 _) := by
        rw [e1, Iso.inv_hom_id_assoc]
      rw [e2]
      have hpb : IsPullback (fst.isoImage W).inv
          ((fst.isoImage W).inv ≫ W.ι ≫ Limits.pullback.snd q (𝟙 _))
          (W.ι ≫ Limits.pullback.snd q (𝟙 _)) (𝟙 _) :=
        IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm
    · right
      refine ⟨(Limits.pullback q (𝟙 (Spec (.of K)))).presheaf.stalk w, inferInstance,
        inferInstance,
        ⟨(asIso ((Limits.pullback.fst q (𝟙 (Spec (.of K)))).stalkMap w)).commRingCatIsoToRingEquiv.symm⟩,
        ⟨e⟩⟩

  have wcpa_dj_clr_jacobian_dual_derivation (R A k : Type u) [CommRing R] [CommRing A] [Field k]
      (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* A) (f : Fin r → MvPolynomial (Fin (r + 1)) R)
      (ev : A →+* k) (hsurj : Function.Surjective π)
      (hker : RingHom.ker π = Ideal.span (Set.range f)) (u : Fin (r + 1) → k)
      (hu : ∀ i, ∑ l, ev (π (MvPolynomial.pderiv l (f i))) * u l = 0) :
      ∃ δ : A → k, (∀ x y, δ (x + y) = δ x + δ y) ∧
        (∀ x y, δ (x * y) = ev x * δ y + ev y * δ x) ∧
        (∀ c, δ (π (MvPolynomial.C c)) = 0) ∧ ∀ l, δ (π (MvPolynomial.X l)) = u l := by
    set T : MvPolynomial (Fin (r + 1)) R → k :=
      fun P => ∑ l, ev (π (MvPolynomial.pderiv l P)) * u l with hT
    have Tadd : ∀ P Q, T (P + Q) = T P + T Q := by
      intro P Q
      simp only [hT, map_add, add_mul, Finset.sum_add_distrib]
    have Tmul : ∀ P Q, T (P * Q) = ev (π P) * T Q + ev (π Q) * T P := by
      intro P Q
      simp only [hT, Derivation.leibniz, smul_eq_mul, map_add, map_mul, add_mul,
        Finset.sum_add_distrib, Finset.mul_sum]
      congr 1 <;> refine Finset.sum_congr rfl (fun l _ => ?_) <;> ring
    have Tsub : ∀ P Q, T (P - Q) = T P - T Q := by
      intro P Q
      simp only [hT, map_sub, sub_mul, Finset.sum_sub_distrib]
    have Tker : ∀ P, π P = 0 → T P = 0 := by
      intro P hP
      have hmem : P ∈ Ideal.span (Set.range f) := by rw [← hker]; exact hP
      induction hmem using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact hu i
      | zero => simp [hT]
      | add x y hx hy ihx ihy =>
        have hx' : π x = 0 := by rw [← RingHom.mem_ker, hker]; exact hx
        have hy' : π y = 0 := by rw [← RingHom.mem_ker, hker]; exact hy
        rw [Tadd, ihx hx', ihy hy', add_zero]
      | smul a x hx ihx =>
        have hx' : π x = 0 := by rw [← RingHom.mem_ker, hker]; exact hx
        rw [smul_eq_mul, Tmul, ihx hx', hx', map_zero, zero_mul, mul_zero, add_zero]
    have Twd : ∀ P Q, π P = π Q → T P = T Q := by
      intro P Q h
      have := Tker (P - Q) (by rw [map_sub, h, sub_self])
      rw [Tsub, sub_eq_zero] at this
      exact this
    set s := Function.surjInv hsurj with hs
    have hss : ∀ y, π (s y) = y := Function.surjInv_eq hsurj
    refine ⟨fun y => T (s y), ?_, ?_, ?_, ?_⟩
    · intro x y
      show T (s (x + y)) = T (s x) + T (s y)
      rw [← Tadd]
      apply Twd
      rw [map_add, hss, hss, hss]
    · intro x y
      show T (s (x * y)) = ev x * T (s y) + ev y * T (s x)
      have : T (s (x * y)) = T (s x * s y) := Twd _ _ (by rw [map_mul, hss, hss, hss])
      rw [this, Tmul, hss, hss]
    · intro c
      show T (s (π (MvPolynomial.C c))) = 0
      rw [Twd _ (MvPolynomial.C c) (hss _)]
      simp [hT]
    · intro l
      show T (s (π (MvPolynomial.X l))) = u l
      rw [Twd _ (MvPolynomial.X l) (hss _)]
      simp only [hT, MvPolynomial.pderiv_X, Pi.single_apply]
      simp

  have wcpa_dj_clr_minors_zero_kernel (R A F : Type u) [CommRing R] [CommRing A] [Field F]
      (r : ℕ) (π : MvPolynomial (Fin (r + 1)) R →+* A) (f : Fin r → MvPolynomial (Fin (r + 1)) R)
      (ρ : A →+* F) (h0 : ∀ l, ρ (π (wcpaDjJacMinor f l)) = 0) :
      ∃ u u' : Fin (r + 1) → F, (∀ i, ∑ l, ρ (π (MvPolynomial.pderiv l (f i))) * u l = 0) ∧
        (∀ i, ∑ l, ρ (π (MvPolynomial.pderiv l (f i))) * u' l = 0) ∧
        LinearIndependent F ![u, u'] := by
    set J : Matrix (Fin r) (Fin (r + 1)) F :=
      Matrix.of fun i l => ρ (π (MvPolynomial.pderiv l (f i))) with hJ
    have hΔ : ∀ l, ρ (π (wcpaDjJacMinor f l)) =
        (-1) ^ (l : ℕ) * Matrix.det (Matrix.of fun (k m : Fin r) => J k (l.succAbove m)) := by
      intro l
      unfold wcpaDjJacMinor
      rw [map_mul, map_mul, map_pow, map_pow, map_neg, map_neg, map_one, map_one]
      congr 1
      rw [← RingHom.comp_apply, RingHom.map_det]
      congr 1
    let M : Matrix (Fin (r + 1)) (Fin (r + 1)) F :=
      Matrix.of fun a b => Fin.cases 0 (fun k => J k b) a
    have hM : M.det = 0 := Matrix.det_eq_zero_of_row_eq_zero 0 (fun b => by simp [M])
    obtain ⟨v, hv0, hMv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hM
    have hJv : ∀ i, ∑ l, J i l * v l = 0 := by
      intro i
      have := congrFun hMv i.succ
      simpa [M, Matrix.mulVec, dotProduct] using this
    obtain ⟨j, hj⟩ : ∃ j, v j ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hv0 (funext hcon)
    have hdet : (Matrix.of fun (k m : Fin r) => J k (j.succAbove m)).det = 0 := by
      have := h0 j
      rw [hΔ j] at this
      exact (mul_eq_zero.mp this).resolve_left (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
    obtain ⟨w', hw'0, hMw'⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    set w : Fin (r + 1) → F := Fin.insertNth j 0 w' with hw
    have hwj : w j = 0 := by simp [hw]
    have hJw : ∀ i, ∑ l, J i l * w l = 0 := by
      intro i
      rw [Fin.sum_univ_succAbove _ j, hwj, mul_zero, zero_add]
      have := congrFun hMw' i
      simpa [hw, Matrix.mulVec, dotProduct] using this
    refine ⟨v, w, hJv, hJw, ?_⟩
    rw [LinearIndependent.pair_iff]
    intro s t hst
    have hsj := congrFun hst j
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hwj, mul_zero, add_zero,
      Pi.zero_apply] at hsj
    have hs : s = 0 := (mul_eq_zero.mp hsj).resolve_right hj
    refine ⟨hs, ?_⟩
    rw [hs, zero_smul, zero_add] at hst
    obtain ⟨m, hm⟩ : ∃ m, w' m ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hw'0 (funext hcon)
    have := congrFun hst (j.succAbove m)
    simp only [Pi.smul_apply, smul_eq_mul, hw, Fin.insertNth_apply_succAbove,
      Pi.zero_apply] at this
    exact (mul_eq_zero.mp this).resolve_right hm

  have wcpa_dj_clr_chain_rule (R A F : Type u) [CommRing R] [CommRing A] [Field F] (r : ℕ)
      (π : MvPolynomial (Fin (r + 1)) R →+* A) (ρ : A →+* F) (D : F → F)
      (hadd : ∀ x y, D (x + y) = D x + D y) (hmul : ∀ x y, D (x * y) = x * D y + y * D x)
      (hc : ∀ c, D (ρ (π (MvPolynomial.C c))) = 0) :
      ∀ P, D (ρ (π P)) = ∑ l, ρ (π (MvPolynomial.pderiv l P)) * D (ρ (π (MvPolynomial.X l))) := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a => simp [hc]
    | add p q hp hq =>
      rw [map_add, map_add, hadd, hp, hq, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_add, map_add, map_add, add_mul]
    | mul_X p n hp =>
      rw [map_mul, map_mul, hmul, hp]
      have e : ∀ l, MvPolynomial.pderiv l (p * MvPolynomial.X n) =
          MvPolynomial.pderiv l p * MvPolynomial.X n + (if n = l then p else 0) := by
        intro l
        rw [Derivation.leibniz, MvPolynomial.pderiv_X, Pi.single_apply, smul_eq_mul, smul_eq_mul]
        split_ifs <;> ring
      simp only [e, map_add, add_mul, Finset.sum_add_distrib, apply_ite ρ, apply_ite π, map_zero,
        ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true, map_mul]
      rw [Finset.mul_sum]
      rw [add_comm]
      congr 1
      refine Finset.sum_congr rfl (fun l _ => ?_)
      ring

  have wcpa_dj_clr_cramer_line (R A F : Type u) [CommRing R] [CommRing A] [Field F] (r : ℕ)
      (π : MvPolynomial (Fin (r + 1)) R →+* A) (f : Fin r → MvPolynomial (Fin (r + 1)) R)
      (ρ : A →+* F) (u : Fin (r + 1) → F)
      (hu : ∀ i, ∑ l, ρ (π (MvPolynomial.pderiv l (f i))) * u l = 0) (j : Fin (r + 1))
      (hj : ρ (π (wcpaDjJacMinor f j)) ≠ 0) :
      ∃ lam : F, ∀ l, u l = lam * ρ (π (wcpaDjJacMinor f l)) := by
    set J : Matrix (Fin r) (Fin (r + 1)) F :=
      Matrix.of fun i l => ρ (π (MvPolynomial.pderiv l (f i))) with hJ
    have hΔ : ∀ l, ρ (π (wcpaDjJacMinor f l)) =
        (-1) ^ (l : ℕ) * Matrix.det (Matrix.of fun (k m : Fin r) => J k (l.succAbove m)) := by
      intro l
      unfold wcpaDjJacMinor
      rw [map_mul, map_mul, map_pow, map_pow, map_neg, map_neg, map_one, map_one]
      congr 1
      rw [← RingHom.comp_apply, RingHom.map_det]
      congr 1
    set Δ : Fin (r + 1) → F := fun l => ρ (π (wcpaDjJacMinor f l)) with hΔdef
    have laplace : ∀ i, ∑ l, J i l * Δ l = 0 := by
      intro i
      simp only [hΔdef, hΔ]
      let M : Matrix (Fin (r + 1)) (Fin (r + 1)) F :=
        Matrix.of fun a b => Fin.cases (J i b) (fun k => J k b) a
      have h0 : M.det = 0 := by
        apply Matrix.det_zero_of_row_eq (i := 0) (j := i.succ) (Fin.succ_ne_zero i).symm
        funext b
        simp [M]
      rw [Matrix.det_succ_row_zero] at h0
      rw [← h0]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      simp only [M, Matrix.of_apply, Fin.cases_zero]
      have : (Matrix.submatrix (Matrix.of fun a b => Fin.cases (J i b) (fun k => J k b) a)
          Fin.succ l.succAbove) = Matrix.of fun (k m : Fin r) => J k (l.succAbove m) := by
        ext k m
        simp
      rw [this]
      ring
    refine ⟨u j / Δ j, fun l => ?_⟩
    set v : Fin (r + 1) → F := fun l => u l - u j / Δ j * Δ l with hv
    have hvj : v j = 0 := by
      simp only [hv]
      rw [div_mul_cancel₀ _ hj, sub_self]
    have hJv : ∀ i, ∑ l, J i l * v l = 0 := by
      intro i
      simp only [hv, mul_sub, Finset.sum_sub_distrib]
      have e1 : ∑ l, J i l * u l = 0 := hu i
      have e2 : ∑ l, J i l * (u j / Δ j * Δ l) = u j / Δ j * ∑ l, J i l * Δ l := by
        rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun l _ => ?_); ring
      rw [e1, e2, laplace i, mul_zero, sub_zero]
    set Mj : Matrix (Fin r) (Fin r) F := Matrix.of fun (k m : Fin r) => J k (j.succAbove m)
      with hMj
    have hMjdet : Mj.det ≠ 0 := by
      intro h0
      apply hj
      show Δ j = 0
      simp only [hΔdef]
      rw [hΔ j, ← hMj, h0, mul_zero]
    have hMv : Mj.mulVec (fun m => v (j.succAbove m)) = 0 := by
      funext k
      have := hJv k
      rw [Fin.sum_univ_succAbove _ j, hvj, mul_zero, zero_add] at this
      simpa [Matrix.mulVec, dotProduct, hMj] using this
    have hv0 := Matrix.eq_zero_of_mulVec_eq_zero hMjdet hMv
    have hvall : v l = 0 := by
      rcases Fin.eq_self_or_eq_succAbove j l with h | ⟨m, rfl⟩
      · rw [h]; exact hvj
      · exact congrFun hv0 m
    have : u l - u j / Δ j * Δ l = 0 := hvall
    exact (sub_eq_zero.mp this)

  have wcpa_dj_clr_residue_derivation_zero (C : Scheme.{u}) (V : C.Opens) (hV : IsAffineOpen V)
      (ξ : C) (hξ : ξ ∈ V) (D : C.residueField ξ → C.residueField ξ)
      (hadd : ∀ x y, D (x + y) = D x + D y) (hmul : ∀ x y, D (x * y) = x * D y + y * D x)
      (hzero : ∀ a : Γ(C, V), D ((C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom a) = 0) :
      ∀ z, D z = 0 := by
    intro z
    have hD1 : D 1 = 0 := by
      have := hmul 1 1
      simp only [one_mul, mul_one] at this
      linear_combination -this
    have hinv : ∀ w : C.residueField ξ, w ≠ 0 → D w = 0 → D w⁻¹ = 0 := by
      intro w hw h0
      have := hmul w w⁻¹
      rw [mul_inv_cancel₀ hw, hD1, h0, mul_zero, add_zero] at this
      exact (mul_eq_zero.mp this.symm).resolve_left hw
    obtain ⟨g, rfl⟩ := C.residue_surjective ξ z
    letI := C.presheaf.algebra_section_stalk (⟨ξ, hξ⟩ : V)
    haveI := hV.isLocalization_stalk ⟨ξ, hξ⟩
    obtain ⟨⟨a, s⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (hV.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl g
    have hs := IsLocalization.mk'_spec (C.presheaf.stalk ξ) a s
    have hu : IsUnit (algebraMap Γ(C, V) (C.presheaf.stalk ξ) (s : Γ(C, V))) :=
      IsLocalization.map_units _ s
    have halg : ∀ t : Γ(C, V), (C.residue ξ).hom (algebraMap Γ(C, V) (C.presheaf.stalk ξ) t) =
        (C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom t := fun t => rfl
    have hs' := congrArg (C.residue ξ).hom hs
    rw [map_mul, halg, halg] at hs'
    have hsne : (C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom (s : Γ(C, V)) ≠ 0 := by
      rw [← halg]
      exact (hu.map (C.residue ξ).hom).ne_zero
    set m := (C.residue ξ).hom (IsLocalization.mk' (C.presheaf.stalk ξ) a s)
    have hm : m = (C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom a *
        ((C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom (s : Γ(C, V)))⁻¹ := by
      rw [eq_mul_inv_iff_mul_eq₀ hsne, ← hs']
    rw [hm, hmul, hzero, hinv _ hsne (hzero _), mul_zero, mul_zero, add_zero]

  have wcpa_dj_clr_section_kernel_const (K : Type u) [Field K] (C : Scheme.{u})
      (q : C ⟶ Spec (.of K)) (σ : Spec (.of K) ⟶ C) (hσ : σ ≫ q = 𝟙 _) (V : C.Opens)
      (h : Γ(C, V)) (hker : RingHom.ker (σ.app V).hom = Ideal.span {h}) (ξ : C) (hξ : ξ ∈ V)
      (h0 : (C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom h = 0) (a : Γ(C, V)) :
      ∃ c₀ : K, (C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom a = wcpaDjFK K q ξ c₀ := by
    have hsurjres : ∀ (U : (Spec (.of K)).Opens) (t : Γ(Spec (.of K), U)),
        ∃ x : Γ(Spec (.of K), ⊤),
          ((Spec (.of K)).presheaf.map (homOfLE le_top : U ⟶ ⊤).op).hom x = t := by
      intro U t
      by_cases hU : U = ⊤
      · subst hU
        refine ⟨t, ?_⟩
        have : (homOfLE le_top : (⊤ : (Spec (.of K)).Opens) ⟶ ⊤) = 𝟙 _ := Subsingleton.elim _ _
        rw [this, op_id, CategoryTheory.Functor.map_id]
        rfl
      · have hU' : U = ⊥ := by
          ext x
          simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
          intro hx
          apply hU
          ext y
          simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
          rwa [Subsingleton.elim y x]
        subst hU'
        exact ⟨0, Subsingleton.elim _ _⟩
    obtain ⟨x, hx⟩ := hsurjres (σ ⁻¹ᵁ V) ((σ.app V).hom a)
    have hVt : V ≤ q ⁻¹ᵁ ⊤ := fun _ _ => trivial
    set eV : Γ(C, V) := (q.appLE ⊤ V hVt).hom x with heV
    have hcomp : q.appLE ⊤ V hVt ≫ σ.app V =
        (Spec (.of K)).presheaf.map (homOfLE le_top : σ ⁻¹ᵁ V ⟶ ⊤).op := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
      have key : ∀ (g : Spec (.of K) ⟶ Spec (.of K)) (hg : g = 𝟙 _) (e : σ ⁻¹ᵁ V ≤ g ⁻¹ᵁ ⊤),
          g.appLE ⊤ (σ ⁻¹ᵁ V) e =
            (Spec (.of K)).presheaf.map (homOfLE le_top : σ ⁻¹ᵁ V ⟶ ⊤).op := by
        rintro g rfl e
        rw [Scheme.Hom.appLE, Scheme.Hom.id_app]
        rfl
      exact key _ hσ _
    have hσe : (σ.app V).hom eV = (σ.app V).hom a := by
      rw [heV, ← hx, ← CommRingCat.comp_apply, hcomp]
    have hmem : a - eV ∈ RingHom.ker (σ.app V).hom := by
      rw [RingHom.mem_ker, map_sub, hσe, sub_self]
    rw [hker, Ideal.mem_span_singleton'] at hmem
    obtain ⟨m, hm⟩ := hmem
    have ha : a = eV + m * h := by rw [hm]; ring
    refine ⟨(Scheme.ΓSpecIso (.of K)).hom.hom x, ?_⟩
    rw [ha, map_add, map_mul, h0, mul_zero, add_zero, heV]
    unfold wcpaDjFK
    have e1 : q.appLE ⊤ V hVt ≫ C.presheaf.germ V ξ hξ =
        q.appTop ≫ C.presheaf.germ ⊤ ξ trivial := by
      rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
      rfl
    have e2 := congrArg (fun φ => (φ ≫ C.residue ξ).hom x) e1
    simp only [Category.assoc] at e2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2 ⊢
    rw [e2]
    have e3 : (Scheme.ΓSpecIso (.of K)).inv.hom ((Scheme.ΓSpecIso (.of K)).hom.hom x) = x :=
      (Scheme.ΓSpecIso (.of K)).hom_inv_id_apply x
    rw [e3]

  have wcpa_dj_clr_const_residue (K : Type u) [Field K] (C : Scheme.{u})
      (q : C ⟶ Spec (.of K)) (V : C.Opens) (W : (Spec (.of K)).Opens) (hle : V ≤ q ⁻¹ᵁ W)
      (ξ : C) (hξ : ξ ∈ V) (c : Γ(Spec (.of K), W)) :
      ∃ c₀ : K, (C.presheaf.germ V ξ hξ ≫ C.residue ξ).hom ((q.appLE W V hle).hom c) =
        wcpaDjFK K q ξ c₀ := by
    have hW : W = ⊤ := by
      have hq : q ξ ∈ W := hle hξ
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have : x = q ξ := Subsingleton.elim _ _
      rw [this]; exact hq
    subst hW
    refine ⟨(Scheme.ΓSpecIso (.of K)).hom c, ?_⟩
    unfold wcpaDjFK
    have e1 : q.appLE ⊤ V hle ≫ C.presheaf.germ V ξ hξ =
        q.appTop ≫ C.presheaf.germ ⊤ ξ trivial := by
      rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
      rfl
    have e2 := congrArg (fun φ => (φ ≫ C.residue ξ).hom c) e1
    simp only [Category.assoc] at e2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2 ⊢
    rw [e2]
    have e3 : (Scheme.ΓSpecIso (.of K)).inv.hom ((Scheme.ΓSpecIso (.of K)).hom.hom c) = c :=
      (Scheme.ΓSpecIso (.of K)).hom_inv_id_apply c
    rw [e3]

  have wcpa_dj_clr_kaehler_push (R B F : Type u) [CommRing R] [CommRing B] [Algebra R B]
      [Field F] (ρ : B →+* F) (D : F → F) (hadd : ∀ x y, D (x + y) = D x + D y)
      (hmul : ∀ x y, D (x * y) = x * D y + y * D x) (hc : ∀ c : R, D (ρ (algebraMap R B c)) = 0)
      (s α β x y : B) (N : ℕ)
      (h : s ^ N • (α • KaehlerDifferential.D R B x - β • KaehlerDifferential.D R B y) = 0) :
      ρ s ^ N * (ρ α * D (ρ x) - ρ β * D (ρ y)) = 0 := by
    letI : Algebra B F := ρ.toAlgebra
    letI : Algebra R F := (ρ.comp (algebraMap R B)).toAlgebra
    haveI : IsScalarTower R B F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let δl : B →ₗ[R] F :=
      { toFun := fun b => D (ρ b)
        map_add' := fun a b => by simp only [map_add, hadd]
        map_smul' := fun c b => by
          simp only [RingHom.id_apply, Algebra.smul_def, map_mul, hmul, hc, mul_zero, add_zero]
          rfl }
    let δ : Derivation R B F := Derivation.mk' δl (fun a b => by
      show D (ρ (a * b)) = a • D (ρ b) + b • D (ρ a)
      rw [map_mul, hmul, Algebra.smul_def, Algebra.smul_def]
      rfl)
    have key := congrArg δ.liftKaehlerDifferential h
    rw [map_smul, map_sub, map_smul, map_smul, Derivation.liftKaehlerDifferential_comp_D,
      Derivation.liftKaehlerDifferential_comp_D, map_zero] at key
    have e : ∀ (b : B) (m : F), b • m = ρ b * m := fun b m => Algebra.smul_def b m
    rw [e, e, e, map_pow] at key
    exact key
  haveI hqp : IsProper q := hst.1.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q

  obtain ⟨W₀, hξW₀, hsm⟩ : ∃ W₀ : C.Opens, ξ ∈ W₀ ∧ SmoothOfRelativeDimension 1 (W₀.ι ≫ q) := by
    rcases wcpa_dj_clr_semistable_point_dichotomy K C q hst.1 ξ with h1 | ⟨O, _, _, ⟨e⟩, ⟨e'⟩⟩
    · exact h1
    · have hN := wcpa_dj_clr_generic_stalk_nilpotent C ξ hξ
      exact ((wcpa_dj_clr_nilpotent_not_node K O (C.presheaf.stalk ξ) e hN).false e').elim

  have hDadd : ∀ x y : C.residueField ξ, D (x + y) = D x + D y := fun x y => map_add D x y
  have hDmul : ∀ x y : C.residueField ξ, D (x * y) = x * D y + y * D x := fun x y => by
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
  have hDK : ∀ c₀ : K, D (wcpaDjFK K q ξ c₀) = 0 := fun c₀ => by
    rw [← hA]; exact D.map_algebraMap c₀
  have hDconst : ∀ (U : C.Opens) (W' : (Spec (.of K)).Opens) (hU : U ≤ q ⁻¹ᵁ W') (hξU : ξ ∈ U)
      (c : Γ(Spec (.of K), W')),
      D ((C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom ((q.appLE W' U hU).hom c)) = 0 := by
    intro U W' hU hξU c
    obtain ⟨c₀, hc₀⟩ := wcpa_dj_clr_const_residue K C q U W' hU ξ hξU c
    rw [hc₀]; exact hDK c₀
  have hres : ∀ (U U' : C.Opens) (hUU : U ≤ U') (hξU : ξ ∈ U) (t : Γ(C, U')),
      (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom ((C.presheaf.map (homOfLE hUU).op).hom t) =
      (C.presheaf.germ U' ξ (hUU hξU) ≫ C.residue ξ).hom t := by
    intro U U' hUU hξU t
    rw [← TopCat.Presheaf.germ_res C.presheaf (homOfLE hUU) ξ hξU]
    rfl

  have hchartfacts : ∀ b (hb : ξ ∈ L.V b), ∃ (j : Fin (r b + 1)) (lam : C.residueField ξ),
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (π b (wcpaDjJacMinor (f b) j)) ≠ 0 ∧
      lam ≠ 0 ∧
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (∏ i, h b i) ≠ 0 ∧
      ∀ l, D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (π b (MvPolynomial.X l))) =
        lam * (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (π b (wcpaDjJacMinor (f b) l)) := by
    intro b hb
    obtain ⟨hVaff, _, hsurj, hconst, hker, hsec⟩ := hchart b
    have hDc : ∀ c, D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        (π b (MvPolynomial.C c))) = 0 := by
      intro c; rw [hconst c]; exact hDconst _ _ (hle b) hb c
    have hchain := wcpa_dj_clr_chain_rule _ _ _ (r b) (π b)
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom ⇑D hDadd hDmul hDc
    have hDzero_of : (∀ a : Γ(C, L.V b),
        D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a) = 0) → False := by
      intro hz
      apply hD
      have h0 := wcpa_dj_clr_residue_derivation_zero C (L.V b) hVaff ξ hb ⇑D hDadd hDmul hz
      exact Derivation.ext fun z => by rw [h0 z, Derivation.zero_apply]
    have hja : ∃ j, (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        (π b (wcpaDjJacMinor (f b) j)) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      obtain ⟨u, u', hu, hu', hli⟩ := wcpa_dj_clr_minors_zero_kernel _ _ _ (r b) (π b) (f b)
        (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom hcon
      obtain ⟨δ, hδa, hδm, hδc, hδX⟩ := wcpa_dj_clr_jacobian_dual_derivation _ _ _ (r b) (π b)
        (f b) (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom hsurj hker u hu
      obtain ⟨δ', hδa', hδm', hδc', hδX'⟩ := wcpa_dj_clr_jacobian_dual_derivation _ _ _ (r b)
        (π b) (f b) (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom hsurj hker u' hu'
      obtain ⟨α, β, hne, hab⟩ := wcpa_dj_clr_smooth_derivations_dependent K C q (L.V b) (W b)
        (hle b) hVaff ξ hb W₀ hξW₀ hsm δ δ' hδa hδm
        (fun c => by rw [← hconst c]; exact hδc c) hδa' hδm'
        (fun c => by rw [← hconst c]; exact hδc' c)
      have hcomb : α • u + β • u' = 0 := by
        funext l
        have h1 := hab (π b (MvPolynomial.X l))
        rw [hδX, hδX'] at h1
        simpa [Pi.add_apply, Pi.smul_apply, smul_eq_mul] using h1
      have h2 := LinearIndependent.pair_iff.mp hli α β hcomb
      rcases hne with h1 | h1
      · exact h1 h2.1
      · exact h1 h2.2
    obtain ⟨j, hj⟩ := hja
    have hu : ∀ i, ∑ l, (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        (π b (MvPolynomial.pderiv l (f b i))) *
        D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (π b (MvPolynomial.X l))) = 0 := by
      intro i
      have hfi : π b (f b i) = 0 := by
        rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span ⟨i, rfl⟩
      rw [← hchain (f b i), hfi, map_zero, map_zero]
    obtain ⟨lam, hlam⟩ := wcpa_dj_clr_cramer_line _ _ _ (r b) (π b) (f b)
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom _ hu j hj
    refine ⟨j, lam, hj, ?_, ?_, hlam⟩
    · intro hl0
      apply hDzero_of
      intro a
      obtain ⟨P, rfl⟩ := hsurj a
      rw [hchain P]
      apply Finset.sum_eq_zero
      intro l _
      rw [hlam l, hl0, zero_mul, mul_zero]
    · intro h0
      rw [map_prod] at h0
      obtain ⟨i, _, hi⟩ := Finset.prod_eq_zero_iff.mp h0
      apply hDzero_of
      intro a
      obtain ⟨c₀, hc₀⟩ := wcpa_dj_clr_section_kernel_const K C q (σ i) (hst.2.1.1 i) (L.V b)
        (h b i) (hsec i).2.2 ξ hb hi a
      rw [hc₀]; exact hDK c₀
  choose jj lam hjj hlam0 hH0 hDX using hchartfacts

  have alg : ∀ (g Ha Hb Δa Δb la lb : C.residueField ξ) (N : ℕ), Ha ≠ 0 → Hb ≠ 0 → lb ≠ 0 →
      Δa ≠ 0 → Δb ≠ 0 →
      (Δa * Δb) ^ N * (g * Ha * Δa * (lb * Δb) - Hb * Δb * (la * Δa)) = 0 →
      g = la / Ha * (lb / Hb)⁻¹ := by
    intro g Ha Hb Δa Δb la lb N hHa hHb hlb hΔa hΔb hkey
    have hΔ : Δa * Δb ≠ 0 := mul_ne_zero hΔa hΔb
    have h2 := (mul_eq_zero.mp hkey).resolve_left (pow_ne_zero N hΔ)
    have h3 : (g * Ha * lb - Hb * la) * (Δa * Δb) = 0 := by linear_combination h2
    have h4 := (mul_eq_zero.mp h3).resolve_right hΔ
    rw [inv_div, div_mul_div_comm, eq_div_iff (mul_ne_zero hHa hlb)]
    linear_combination h4
  refine ⟨fun b => if hb : ξ ∈ L.V b then
      lam b hb / (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (∏ i, h b i) else 1, ?_, ?_⟩
  · intro b hb
    dsimp only
    rw [dif_pos hb]
    refine ⟨div_ne_zero (hlam0 b hb) (hH0 b hb), ?_⟩
    unfold wcpaDjLogGen
    intro l
    rw [hDX b hb l, div_mul_cancel₀ _ (hH0 b hb)]
  · intro a b hab
    have ha : ξ ∈ L.V a := hab.1
    have hb : ξ ∈ L.V b := hab.2
    dsimp only
    rw [dif_pos ha, dif_pos hb]
    obtain ⟨N, hN⟩ := htrans a b (jj a ha) (jj b hb)
    have key := @wcpa_dj_clr_kaehler_push Γ(Spec (.of K), W a ⊓ W b) Γ(C, L.V a ⊓ L.V b)
      (C.residueField ξ) _ _
      (q.appLE (W a ⊓ W b) (L.V a ⊓ L.V b) (fun x hx => ⟨hle a hx.1, hle b hx.2⟩)).hom.toAlgebra _
      (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom ⇑D hDadd hDmul
      (fun c => hDconst (L.V a ⊓ L.V b) (W a ⊓ W b) _ hab c) _ _ _ _ _ N hN
    simp only [map_mul, map_pow, hres] at key
    rw [hDX a ha, hDX b hb] at key
    exact alg _ _ _ _ _ _ _ N (hH0 a ha) (hH0 b hb) (hlam0 b hb) (hjj a ha) (hjj b hb) key

theorem wcpa_dj_cdp_le_center_unique (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (hq : IsSeparated q) (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (ξ : C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (V : ValuationSubring (C.residueField ξ))
    (hV : ∀ c : K, algebraMap K (C.residueField ξ) c ∈ V) (b b' : Fin L.m) (c c' : C)
    (h1 : wcpaDjCtr L ξ V b c) (h2 : wcpaDjCtr L ξ V b' c') : c = c' :=
by
  classical
  haveI hsep : IsSeparated q := hq
  have hdom : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S),
      Function.Injective f → IsDominant (Spec.map (CommRingCat.ofHom f)) := by
    intro R S _ _ f hf
    rw [isDominant_iff]
    have e : (⇑(Spec.map (CommRingCat.ofHom f)) : Spec (.of S) → Spec (.of R)) =
        PrimeSpectrum.comap f := by
      funext x; exact Spec.map_apply _ x
    rw [e]
    refine (PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical (f := f)).mpr ?_
    rw [(RingHom.injective_iff_ker_eq_bot f).mp hf]
    exact bot_le
  have hgen : ∀ (U : C.Opens) (hU : IsAffineOpen U) (hξ : ξ ∈ U)
      (hρ : ∀ x : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x ∈ V),
      Spec.map (CommRingCat.ofHom V.subtype) ≫ Spec.map (CommRingCat.ofHom
        ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ)) ≫ hU.fromSpec =
        C.fromSpecResidueField ξ := by
    intro U hU hξ hρ
    have ha : CommRingCat.ofHom ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ) ≫
        CommRingCat.ofHom V.subtype = C.presheaf.germ U ξ hξ ≫ C.residue ξ := by
      ext x; rfl
    rw [← Spec.map_comp_assoc, ha, Spec.map_comp_assoc,
      show Spec.map (C.presheaf.germ U ξ hξ) ≫ hU.fromSpec = hU.fromSpecStalk hξ from rfl,
      hU.fromSpecStalk_eq_fromSpecStalk]
    rfl
  have hpt : ∀ (U : C.Opens) (hU : IsAffineOpen U) (hξ : ξ ∈ U)
      (hρ : ∀ x : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x ∈ V) (c : C) (hc : c ∈ U),
      (∀ x : Γ(C, U), ((C.presheaf.germ U c hc).hom x ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk c) ↔
        (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x ∈ V.nonunits)) →
      (Spec.map (CommRingCat.ofHom ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ)) ≫
        hU.fromSpec) (show Spec (.of ↥V) from IsLocalRing.closedPoint ↥V) = c := by
    intro U hU hξ hρ c hc hi
    rw [Scheme.Hom.comp_apply]
    refine (congrArg hU.fromSpec ?_).trans (hU.fromSpec_primeIdealOf ⟨c, hc⟩)
    rw [hU.primeIdealOf_eq_map_closedPoint]
    apply PrimeSpectrum.ext
    ext x
    show x ∈ Ideal.comap ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ)
        (IsLocalRing.maximalIdeal V) ↔
      x ∈ Ideal.comap (C.presheaf.germ U c hc).hom (IsLocalRing.maximalIdeal (C.presheaf.stalk c))
    rw [Ideal.mem_comap, Ideal.mem_comap]
    rw [hi x, ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
    constructor
    · intro h
      exact ⟨hρ x, h⟩
    · rintro ⟨_, h⟩
      exact h
  obtain ⟨hb, hc, ⟨hb0, hρ⟩, hi⟩ := h1
  obtain ⟨hb', hc', ⟨hb0', hρ'⟩, hi'⟩ := h2
  obtain ⟨g, hg⟩ : ∃ g : Spec (.of ↥V) ⟶ C, g = Spec.map (CommRingCat.ofHom
      ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom.codRestrict V hρ)) ≫ (hOK.1 b).fromSpec :=
    ⟨_, rfl⟩
  obtain ⟨g', hg'⟩ : ∃ g' : Spec (.of ↥V) ⟶ C, g' = Spec.map (CommRingCat.ofHom
      ((C.presheaf.germ (L.V b') ξ hb' ≫ C.residue ξ).hom.codRestrict V hρ')) ≫
        (hOK.1 b').fromSpec :=
    ⟨_, rfl⟩
  haveI : IsDominant (Spec.map (CommRingCat.ofHom V.subtype)) :=
    hdom ↥V (C.residueField ξ) V.subtype Subtype.val_injective
  have e1 : Spec.map (CommRingCat.ofHom V.subtype) ≫ g =
      Spec.map (CommRingCat.ofHom V.subtype) ≫ g' := by
    rw [hg, hg']
    exact (hgen (L.V b) (hOK.1 b) hb hρ).trans (hgen (L.V b') (hOK.1 b') hb' hρ').symm
  have e2 : g ≫ q = g' ≫ q := by
    refine ext_of_isDominant (Spec.map (CommRingCat.ofHom V.subtype)) ?_
    have := congrArg (fun h => h ≫ q) e1
    simpa only [Category.assoc] using this
  have e3 : g = g' := ext_of_isDominant_of_isSeparated q e2 _ e1
  have k1 : g (show Spec (.of ↥V) from IsLocalRing.closedPoint ↥V) = c := by
    rw [hg]; exact hpt (L.V b) (hOK.1 b) hb hρ c hc hi
  have k2 : g' (show Spec (.of ↥V) from IsLocalRing.closedPoint ↥V) = c' := by
    rw [hg']; exact hpt (L.V b') (hOK.1 b') hb' hρ' c' hc' hi'
  rw [← k1, ← k2, e3]

theorem wcpa_dj_cdp_le_chart_derivation (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (U : C.Opens)
    (W : (Spec (.of K)).Opens) (hle : U ≤ q ⁻¹ᵁ W) (r : ℕ)
    (π : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W) →+* Γ(C, U))
    (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W)) (h : Fin n → Γ(C, U))
    (hchart : wcpaDjLogChart q σ U W hle r π f h) (ξ : C) (hξ : ξ ∈ U)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (D : Derivation K (C.residueField ξ) (C.residueField ξ)) (φ : C.residueField ξ)
    (hgen : wcpaDjLogGen ξ U hξ π f h ⇑D φ) (I : Ideal Γ(C, U))
    (hI : ∀ l, π (wcpaDjJacMinor f l) ∈ I) :
    ∀ a : Γ(C, U), ∃ a' ∈ I, D ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom a) =
      φ * (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom (∏ i, h i) *
        (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom a' :=
by
  classical
  unfold wcpaDjLogChart at hchart
  unfold wcpaDjLogGen at hgen

  have hW : W = ⊤ := by
    haveI : Subsingleton (Spec (.of K)) := inferInstanceAs (Subsingleton (PrimeSpectrum K))
    refine eq_top_iff.mpr (fun x _ => ?_)
    have hx : x = q ξ := Subsingleton.elim _ _
    rw [hx]
    exact hle hξ
  subst hW

  have hconst : ∀ c : Γ(Spec (.of K), ⊤),
      D ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom (π (MvPolynomial.C c))) = 0 := by
    intro c
    rw [hchart.2.2.2.1 c]
    obtain ⟨k, rfl⟩ : ∃ k, (Scheme.ΓSpecIso (.of K)).inv.hom k = c :=
      ⟨(Scheme.ΓSpecIso (.of K)).hom.hom c, by simp⟩
    have e : (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom
        ((q.appLE ⊤ U hle).hom ((Scheme.ΓSpecIso (.of K)).inv.hom k)) =
        algebraMap K (C.residueField ξ) k := by
      rw [hA]
      unfold wcpaDjFK
      rw [← TopCat.Presheaf.germ_res C.presheaf (homOfLE (le_top : U ≤ ⊤)) ξ hξ]
      rfl
    rw [e]
    exact D.map_algebraMap k

  have key : ∀ P, ∃ a' ∈ I, D ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom (π P)) =
      φ * (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom (∏ i, h i) *
        (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom a' := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C c => exact ⟨0, I.zero_mem, by rw [hconst c, map_zero, mul_zero]⟩
    | add p₁ p₂ hp₁ hp₂ =>
      obtain ⟨a₁, ha₁, e₁⟩ := hp₁
      obtain ⟨a₂, ha₂, e₂⟩ := hp₂
      refine ⟨a₁ + a₂, I.add_mem ha₁ ha₂, ?_⟩
      simp only [map_add]
      rw [e₁, e₂, mul_add]
    | mul_X p l hp =>
      obtain ⟨a₁, ha₁, e₁⟩ := hp
      refine ⟨π p * π (wcpaDjJacMinor f l) + π (MvPolynomial.X l) * a₁,
        I.add_mem (I.mul_mem_left _ (hI l)) (I.mul_mem_left _ ha₁), ?_⟩
      have hg := hgen l
      simp only [map_mul, map_add]
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, e₁, hg]
      ring

  intro a
  obtain ⟨P, rfl⟩ := hchart.2.2.1 a
  exact key P

theorem wcpa_dj_cdp_le_jacobian_smooth (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (U : C.Opens)
    (W : (Spec (.of K)).Opens) (hle : U ≤ q ⁻¹ᵁ W) (r : ℕ)
    (π : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W) →+* Γ(C, U))
    (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W)) (h : Fin n → Γ(C, U))
    (hchart : wcpaDjLogChart q σ U W hle r π f h) (c : C) (hc : c ∈ U) (l : Fin (r + 1))
    (hl : (C.presheaf.germ U c hc).hom (π (wcpaDjJacMinor f l)) ∉
      IsLocalRing.maximalIdeal (C.presheaf.stalk c)) :
    ∃ W' : C.Opens, c ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ q) :=
by
  classical
  obtain ⟨hU, hW, hπs, hπC, hker, -⟩ := hchart
  letI : Algebra Γ(Spec (.of K), W) Γ(C, U) := (q.appLE W U hle).hom.toAlgebra
  set g := wcpaDjJacMinor f l with hg
  set b := π g with hb
  clear_value b g

  have hstd : Algebra.IsStandardSmoothOfRelativeDimension 1 Γ(Spec (.of K), W)
      (Localization.Away b) := by
    let ren : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W) →ₐ[Γ(Spec (.of K), W)]
        MvPolynomial (Fin (r + 1) ⊕ Unit) Γ(Spec (.of K), W) := MvPolynomial.rename Sum.inl
    let val : Fin (r + 1) ⊕ Unit → Localization.Away b :=
      Sum.elim (fun i => algebraMap Γ(C, U) (Localization.Away b) (π (MvPolynomial.X i)))
        (fun _ => IsLocalization.Away.invSelf b)
    let φ : MvPolynomial (Fin (r + 1) ⊕ Unit) Γ(Spec (.of K), W) →ₐ[Γ(Spec (.of K), W)]
        Localization.Away b := MvPolynomial.aeval val
    let rel : Fin r ⊕ Unit → MvPolynomial (Fin (r + 1) ⊕ Unit) Γ(Spec (.of K), W) :=
      Sum.elim (fun i => ren (f i)) (fun _ => ren g * MvPolynomial.X (Sum.inr ()) - 1)
    have hinv : algebraMap Γ(C, U) (Localization.Away b) b * IsLocalization.Away.invSelf b = 1 :=
      IsLocalization.Away.mul_invSelf b
    have hφY : φ (MvPolynomial.X (Sum.inr ())) = IsLocalization.Away.invSelf b :=
      MvPolynomial.aeval_X _ _
    have hrenX : ∀ i, ren (MvPolynomial.X i) = MvPolynomial.X (Sum.inl i) :=
      fun i => MvPolynomial.rename_X _ _
    have hrenC : ∀ a, ren (MvPolynomial.C a) = MvPolynomial.C a :=
      fun a => MvPolynomial.rename_C _ _
    have hev : ∀ p, φ (ren p) = algebraMap Γ(C, U) (Localization.Away b) (π p) := by
      have hext : (MvPolynomial.aeval (val ∘ Sum.inl) :
          MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W) →ₐ[Γ(Spec (.of K), W)]
            Localization.Away b).toRingHom =
          (algebraMap Γ(C, U) (Localization.Away b)).comp π := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C,
            RingHom.comp_apply]
          rw [hπC]
          exact IsScalarTower.algebraMap_apply Γ(Spec (.of K), W) Γ(C, U) (Localization.Away b) a
        · intro i
          simp [val]
      intro p
      show MvPolynomial.aeval val (MvPolynomial.rename Sum.inl p) = _
      rw [MvPolynomial.aeval_rename]
      exact RingHom.congr_fun hext p
    have hsurj : Function.Surjective φ := by
      intro z
      obtain ⟨⟨a, s⟩, hz⟩ := IsLocalization.surj (Submonoid.powers b) z
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
      obtain ⟨p, rfl⟩ := hπs a
      refine ⟨ren p * MvPolynomial.X (Sum.inr ()) ^ k, ?_⟩
      simp only at hz
      rw [map_mul, map_pow, hev, hφY, ← hz, ← hk, map_pow, mul_assoc, ← mul_pow, hinv, one_pow,
        mul_one]
    have hrel0 : ∀ j, φ (rel j) = 0 := by
      rintro (i | ⟨⟩)
      · show φ (ren (f i)) = 0
        rw [hev]
        have : f i ∈ RingHom.ker π := by rw [hker]; exact Ideal.subset_span ⟨_, rfl⟩
        rw [RingHom.mem_ker.mp this, map_zero]
      · show φ (ren g * MvPolynomial.X (Sum.inr ()) - 1) = 0
        rw [map_sub, map_mul, hev, map_one, hφY, ← hb]
        exact sub_eq_zero.mpr hinv
    set J := Ideal.span (Set.range rel) with hJ
    have hJker : J ≤ RingHom.ker φ :=
      Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact RingHom.mem_ker.mpr (hrel0 j))
    let ρ := Ideal.Quotient.mk J
    have hγY : ρ (ren g) * ρ (MvPolynomial.X (Sum.inr ())) = 1 := by
      rw [← map_mul, ← map_one ρ]
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨Sum.inr (), rfl⟩)
    have hclear : ∀ P : MvPolynomial (Fin (r + 1) ⊕ Unit) Γ(Spec (.of K), W),
        ∃ (N : ℕ) (p : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W)),
        ρ (ren g ^ N * P) = ρ (ren p) := by
      intro P
      refine MvPolynomial.induction_on (motive := fun P => ∃ (N : ℕ)
        (p : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W)),
        ρ (ren g ^ N * P) = ρ (ren p)) P ?_ ?_ ?_
      · intro a
        exact ⟨0, MvPolynomial.C a, by rw [pow_zero, one_mul, hrenC]⟩
      · rintro P₁ P₂ ⟨N₁, h₁, e₁⟩ ⟨N₂, h₂, e₂⟩
        refine ⟨N₁ + N₂, g ^ N₂ * h₁ + g ^ N₁ * h₂, ?_⟩
        calc ρ (ren g ^ (N₁ + N₂) * (P₁ + P₂))
            = ρ (ren g) ^ N₂ * ρ (ren g ^ N₁ * P₁) + ρ (ren g) ^ N₁ * ρ (ren g ^ N₂ * P₂) := by
              simp only [map_add, map_mul, map_pow]; ring
          _ = _ := by rw [e₁, e₂]; simp only [map_add, map_mul, map_pow]
      · rintro P' v ⟨N, p, e⟩
        rcases v with i | ⟨⟩
        · refine ⟨N, p * MvPolynomial.X i, ?_⟩
          rw [← mul_assoc, map_mul, e, map_mul ren, hrenX, map_mul]
        · refine ⟨N + 1, p, ?_⟩
          calc ρ (ren g ^ (N + 1) * (P' * MvPolynomial.X (Sum.inr ())))
              = (ρ (ren g) * ρ (MvPolynomial.X (Sum.inr ()))) * ρ (ren g ^ N * P') := by
                simp only [map_mul, map_pow]; ring
            _ = _ := by rw [hγY, one_mul, e]
    have hmapF : Ideal.map ren (Ideal.span (Set.range f)) ≤ J := by
      rw [Ideal.map_span]
      apply Ideal.span_le.mpr
      rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      exact Ideal.subset_span ⟨Sum.inl j, rfl⟩
    have hkerJ : ∀ p, π p = 0 → ren p ∈ J := by
      intro p hp
      have hmem : p ∈ Ideal.span (Set.range f) := by rw [← hker]; exact RingHom.mem_ker.mpr hp
      exact hmapF (Ideal.mem_map_of_mem ren hmem)
    have hkerle : RingHom.ker φ ≤ J := by
      intro P hP
      obtain ⟨N, p, e⟩ := hclear P
      have h1 : ren g ^ N * P - ren p ∈ J := Ideal.Quotient.eq.mp e
      have h2 : φ (ren p) = 0 := by
        have h3 := hJker h1
        rw [RingHom.mem_ker, map_sub, map_mul, RingHom.mem_ker.mp hP, mul_zero, zero_sub,
          neg_eq_zero] at h3
        exact h3
      rw [hev] at h2
      obtain ⟨⟨_, M, rfl⟩, hM⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers b) (Localization.Away b) (π p)).mp h2
      have h3 : ren (g ^ M * p) ∈ J := hkerJ _ (by rw [map_mul, map_pow, ← hb]; exact hM)
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      calc ρ P = (ρ (ren g) * ρ (MvPolynomial.X (Sum.inr ()))) ^ (N + M) * ρ P := by
            rw [hγY, one_pow, one_mul]
        _ = ρ (MvPolynomial.X (Sum.inr ())) ^ (N + M) * ρ (ren (g ^ M * p)) := by
            rw [map_mul ren, map_pow ren, map_mul ρ, map_pow ρ, ← e]
            simp only [map_mul, map_pow]; ring
        _ = 0 := by rw [Ideal.Quotient.eq_zero_iff_mem.mpr h3, mul_zero]
    have hkerEq : Ideal.span (Set.range rel) = RingHom.ker φ := le_antisymm hJker hkerle
    let P₀ : Algebra.Generators Γ(Spec (.of K), W) (Localization.Away b) (Fin (r + 1) ⊕ Unit) :=
      Algebra.Generators.ofSurjective val hsurj
    let P₁ : Algebra.Presentation Γ(Spec (.of K), W) (Localization.Away b) (Fin (r + 1) ⊕ Unit)
        (Fin r ⊕ Unit) :=
      Algebra.Presentation.mk P₀ rel (by rw [Algebra.Generators.ker_eq_ker_aeval_val]; exact hkerEq)
    let P₂ : Algebra.PreSubmersivePresentation Γ(Spec (.of K), W) (Localization.Away b)
        (Fin (r + 1) ⊕ Unit) (Fin r ⊕ Unit) :=
      Algebra.PreSubmersivePresentation.mk P₁ (Sum.map l.succAbove id)
        (Fin.succAbove_right_injective.sumMap Function.injective_id)
    have hpY : ∀ x : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W),
        MvPolynomial.pderiv (Sum.inr () : Fin (r + 1) ⊕ Unit) (ren x) = 0 := by
      intro x
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hx
      obtain ⟨i, -, hi⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename _ _ hx)
      exact Sum.inl_ne_inr hi
    have h21 : P₂.jacobiMatrix.toBlocks₂₁ = 0 := by
      refine Matrix.ext fun a j => ?_
      rw [Matrix.toBlocks₂₁, Matrix.of_apply, Matrix.zero_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      exact hpY (f j)
    have h22 : P₂.jacobiMatrix.toBlocks₂₂.det = ren g := by
      rw [Matrix.det_unique, Matrix.toBlocks₂₂, Matrix.of_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      show MvPolynomial.pderiv (Sum.inr ()) (ren g * MvPolynomial.X (Sum.inr ()) - 1) = ren g
      rw [map_sub, MvPolynomial.pderiv_mul, hpY, zero_mul, zero_add, MvPolynomial.pderiv_X_self,
        mul_one, Derivation.map_one_eq_zero, sub_zero]
    have h11 : P₂.jacobiMatrix.toBlocks₁₁.det =
        ren (Matrix.of fun i j => MvPolynomial.pderiv (l.succAbove j) (f i)).det := by
      have hm : P₂.jacobiMatrix.toBlocks₁₁ = ((ren : MvPolynomial (Fin (r + 1))
          Γ(Spec (.of K), W) →ₐ[Γ(Spec (.of K), W)]
          MvPolynomial (Fin (r + 1) ⊕ Unit) Γ(Spec (.of K), W)).toRingHom.mapMatrix
          (Matrix.of fun i j => MvPolynomial.pderiv (l.succAbove j) (f i))).transpose := by
        refine Matrix.ext fun a j => ?_
        rw [Matrix.toBlocks₁₁, Matrix.of_apply, Matrix.transpose_apply, RingHom.mapMatrix_apply,
          Matrix.map_apply, Matrix.of_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        show MvPolynomial.pderiv (Sum.inl (l.succAbove a)) (MvPolynomial.rename Sum.inl (f j)) = _
        rw [MvPolynomial.pderiv_rename Sum.inl_injective]
        rfl
      rw [hm, Matrix.det_transpose, ← RingHom.map_det]
      rfl
    have hdet : P₂.jacobiMatrix.det =
        ren (Matrix.of fun i j => MvPolynomial.pderiv (l.succAbove j) (f i)).det * ren g := by
      rw [← Matrix.fromBlocks_toBlocks P₂.jacobiMatrix, h21, Matrix.det_fromBlocks_zero₂₁, h11,
        h22]
    have hjac : IsUnit P₂.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hdet]
      show IsUnit (φ (ren (Matrix.of fun i j => MvPolynomial.pderiv (l.succAbove j) (f i)).det *
        ren g))
      rw [map_mul, hev, hev, ← hb]
      have hub : IsUnit (algebraMap Γ(C, U) (Localization.Away b) b) :=
        IsLocalization.Away.algebraMap_isUnit b
      have hpg : b = π ((-1) ^ (l : ℕ)) *
          π (Matrix.of fun i j => MvPolynomial.pderiv (l.succAbove j) (f i)).det := by
        rw [hb, hg, wcpaDjJacMinor, map_mul]
      have hub' : IsUnit (algebraMap Γ(C, U) (Localization.Away b) (π ((-1) ^ (l : ℕ)) *
          π (Matrix.of fun i j => MvPolynomial.pderiv (l.succAbove j) (f i)).det)) := by
        rw [← hpg]; exact hub
      rw [map_mul] at hub'
      exact (isUnit_of_mul_isUnit_right hub').mul hub
    let P₃ : Algebra.SubmersivePresentation Γ(Spec (.of K), W) (Localization.Away b)
        (Fin (r + 1) ⊕ Unit) (Fin r ⊕ Unit) := Algebra.SubmersivePresentation.mk P₂ hjac
    refine ⟨⟨Fin (r + 1) ⊕ Unit, Fin r ⊕ Unit, inferInstance, inferInstance, P₃, ?_⟩⟩
    show Nat.card (Fin (r + 1) ⊕ Unit) - Nat.card (Fin r ⊕ Unit) = 1
    rw [Nat.card_sum, Nat.card_sum]
    simp only [Nat.card_eq_fintype_card, Fintype.card_fin, Fintype.card_unit]
    omega

  have hunit : IsUnit ((C.presheaf.germ U c hc).hom b) := by
    by_contra hcon
    exact hl ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hcon))
  have hxD : c ∈ C.basicOpen b := (Scheme.mem_basicOpen C b c hc).mpr hunit
  have hD : IsAffineOpen (C.basicOpen b) := hU.basicOpen b
  have e' : C.basicOpen b ≤ q ⁻¹ᵁ W := (C.basicOpen_le b).trans hle

  have hcomp : (q.appLE W (C.basicOpen b) e').hom =
      (C.presheaf.map (homOfLE (C.basicOpen_le b)).op).hom.comp (q.appLE W U hle).hom := by
    rw [← Scheme.Hom.appLE_map q hle (homOfLE (C.basicOpen_le b)).op]
    rfl
  have H : RingHom.IsStandardSmoothOfRelativeDimension 1
      ((algebraMap Γ(C, U) (Localization.Away b)).comp (q.appLE W U hle).hom) := by
    have h := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hstd
    have h2 : algebraMap Γ(Spec (.of K), W) (Localization.Away b) =
        (algebraMap Γ(C, U) (Localization.Away b)).comp (q.appLE W U hle).hom :=
      IsScalarTower.algebraMap_eq _ _ _
    rw [h2] at h
    exact h
  haveI hloc : IsLocalization.Away b Γ(C, C.basicOpen b) := hU.isLocalization_basicOpen b
  let ε := IsLocalization.algEquiv (Submonoid.powers b) (Localization.Away b)
    Γ(C, C.basicOpen b)
  have hε : (ε.toRingEquiv.toRingHom).comp (algebraMap Γ(C, U) (Localization.Away b)) =
      (C.presheaf.map (homOfLE (C.basicOpen_le b)).op).hom := by
    ext x
    exact ε.commutes x
  have hstd' := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).1 _ ε.toRingEquiv H
  rw [← RingHom.comp_assoc, hε, ← hcomp] at hstd'

  refine ⟨C.basicOpen b, hxD, ?_⟩
  clear hcomp hε ε hloc hxD
  revert hstd' e' hD
  generalize C.basicOpen b = V
  intro hD e' hstd'
  have : IsAffine V.toScheme := hD
  have e1 : (⊤ : V.toScheme.Opens) ≤ (V.ι ≫ q) ⁻¹ᵁ W := by
    intro z _
    show (V.ι ≫ q) z ∈ W
    rw [Scheme.Hom.comp_apply]
    exact e' z.2
  have h₀ : V.ι ''ᵁ ⊤ ≤ q ⁻¹ᵁ W := by
    rw [Scheme.Opens.ι_image_top]; exact e'
  have e'' : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ q ⁻¹ᵁ W := e1
  have key : (V.ι ≫ q).appLE W ⊤ e1 = q.appLE W (V.ι ''ᵁ ⊤) h₀ := by
    rw [Scheme.Hom.comp_appLE]
    have h2 := Scheme.Opens.ι_appLE V (q ⁻¹ᵁ W) ⊤ e''
    rw [h2]
    rfl
  have hstd'' : RingHom.IsStandardSmoothOfRelativeDimension 1 (q.appLE W (V.ι ''ᵁ ⊤) h₀).hom :=
    (Scheme.Hom.appLE_congr q e' rfl (Scheme.Opens.ι_image_top V).symm
      (fun φ => RingHom.IsStandardSmoothOfRelativeDimension 1 φ.hom)).mp hstd'
  refine SmoothOfRelativeDimension.mk ?_
  intro x
  refine ⟨W, hW, ⊤, isAffineOpen_top V.toScheme, trivial, e1, ?_⟩
  rw [key]
  exact hstd''

theorem wcpa_dj_cdp_le_mark (K : Type u) [Field K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K))
    (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C) (b : Fin L.m)
    (W : (Spec (.of K)).Opens) (hle : L.V b ≤ q ⁻¹ᵁ W) (r : ℕ)
    (π : MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W) →+* Γ(C, L.V b))
    (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(Spec (.of K), W)) (h : Fin n → Γ(C, L.V b))
    (hchart : wcpaDjLogChart q σ (L.V b) W hle r π f h) (ξ : C)
    (V : ValuationSubring (C.residueField ξ)) (c : C) (hctr : wcpaDjCtr L ξ V b c) (i : Fin n)
    (p : Spec (.of K)) (hp : σ i p = c) (hb : ξ ∈ L.V b) :
    (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom (h i) ∈ V.nonunits :=
by
  obtain ⟨hb', hc, -, hiff⟩ := hctr
  subst hp
  obtain ⟨-, -, -, -, -, hsec⟩ := hchart
  obtain ⟨-, -, hker⟩ := hsec i
  have h2 : ((σ i).app (L.V b)).hom (h i) = 0 := by
    have hm : h i ∈ RingHom.ker ((σ i).app (L.V b)).hom := by
      rw [hker]; exact Ideal.mem_span_singleton_self _
    exact (RingHom.mem_ker).1 hm
  have h3 : ((σ i).stalkMap p).hom (C.presheaf.germ (L.V b) (σ i p) hc (h i)) = 0 := by
    rw [Scheme.Hom.germ_stalkMap_apply, h2, map_zero]
  have h4 : C.presheaf.germ (L.V b) (σ i p) hc (h i) ∈
      IsLocalRing.maximalIdeal (C.presheaf.stalk (σ i p)) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map ((σ i).stalkMap p).hom
    rw [h3] at this
    exact not_isUnit_zero this
  exact (hiff (h i)).1 h4

theorem wcpa_dj_cdp_local_excess (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C)
    (W : Fin L.m → (Spec (.of K)).Opens) (hle : ∀ a, L.V a ≤ q ⁻¹ᵁ W a) (r : Fin L.m → ℕ)
    (π : ∀ a, MvPolynomial (Fin (r a + 1)) Γ(Spec (.of K), W a) →+* Γ(C, L.V a))
    (f : ∀ a, Fin (r a) → MvPolynomial (Fin (r a + 1)) Γ(Spec (.of K), W a))
    (h : ∀ a, Fin n → Γ(C, L.V a))
    (hst : wcpaDjStablePtd q n σ) (hOK : wcpaDjCocOK L)
    (hchart : ∀ a, wcpaDjLogChart q σ (L.V a) (W a) (hle a) (r a) (π a) (f a) (h a))
    (ξ : C) (hξ : closure {ξ} ∈ irreducibleComponents C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (D : Derivation K (C.residueField ξ) (C.residueField ξ))
    (V : ValuationSubring (C.residueField ξ)) (hV : wcpaDjNtV' K V)
    (b : Fin L.m) (hb : ξ ∈ L.V b) (hgood : wcpaDjChartGood L ξ V b)
    (φ : C.residueField ξ) (hφ : φ ≠ 0)
    (hgen : wcpaDjLogGen ξ (L.V b) hb (π b) (f b) (h b) ⇑D φ)
    (x : C.residueField ξ) (hx : wcpaDjValOrd V x = 1) (hDx : D x ≠ 0) :
    wcpaDjValOrd V φ ≤ wcpaDjValOrd V (D x) ∧
      (wcpaDjSpecialV q σ L ξ V → wcpaDjValOrd V φ + 1 ≤ wcpaDjValOrd V (D x)) :=
by
  classical
  have hss : wcpaDjSemistable q := hst.1
  haveI hprop : IsProper q := hst.1.2.1
  have hF := wcpa_dj_cdp_residue_ff1 K C q hss ξ hξ hA
  obtain ⟨-, hmul, -, -, -⟩ := wcpa_dj_cdp_ff_valuations K _ hF
  have mult := hmul V hV
  obtain ⟨hnn, hpos0⟩ := wcpa_dj_lsp_scd_valord_bounds _ V
  have hpos := hpos0 ⟨x, hx⟩ mult
  have hv1 : wcpaDjValOrd V (1 : C.residueField ξ) = 0 := by
    have := mult 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at this
    linarith
  have hnu : ∀ y : C.residueField ξ, y ≠ 0 → y ∈ V.nonunits → 1 ≤ wcpaDjValOrd V y := by
    intro y hy0 hy
    have hlt : V.valuation y < 1 := (V.mem_nonunits_iff).1 hy
    have hyV : y ∈ V := (V.valuation_le_one_iff y).1 hlt.le
    exact hpos y hyV hy0 ((V.valuation_lt_one_iff ⟨y, hyV⟩).2 hlt)
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hDx (map_zero D)
  have hxV : x ∈ V := by
    by_contra hxV
    have hxi : x⁻¹ ∈ V := (V.mem_or_inv_mem x).resolve_left hxV
    have hxinu : x⁻¹ ∈ V.nonunits := by
      rw [V.mem_nonunits_iff]
      refine lt_of_le_of_ne ((V.valuation_le_one_iff _).2 hxi) ?_
      intro h1
      apply hxV
      refine (V.valuation_le_one_iff x).1 ?_
      rw [← inv_inv x, map_inv₀, h1, inv_one]
    have h1 := hnu x⁻¹ (inv_ne_zero hx0) hxinu
    have h2 := mult x x⁻¹ hx0 (inv_ne_zero hx0)
    rw [mul_inv_cancel₀ hx0, hv1] at h2
    linarith
  have hU : IsAffineOpen (L.V b) := hOK.1 b
  have hcd := wcpa_dj_cdp_le_chart_derivation K C q n σ (L.V b) (W b) (hle b) (r b) (π b) (f b)
    (h b) (hchart b) ξ hb hA D φ hgen
  obtain ⟨a0, s0, hs0, hxas⟩ := wcpa_dj_cdp_le_residue_fractions C (L.V b) hU ξ hb x
  obtain ⟨c₀, hc₀⟩ := wcpa_dj_cdp_le_center_exists C L hOK ξ V b hgood
  set ρ := (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom with hρ
  set H := ρ (∏ i, h b i) with hH
  have hgood' : ∀ a, ρ a ∈ V := by
    obtain ⟨_, hg⟩ := hgood
    exact hg
  have hquot : ∀ (a s a' s' : C.residueField ξ), D a = φ * H * a' → D s = φ * H * s' →
      D (a * s⁻¹) = φ * H * (s⁻¹ * a' - a * (s⁻¹) ^ 2 * s') := by
    intro a s a' s' ha hs
    rw [Derivation.leibniz, Derivation.leibniz_inv, ha, hs]
    simp only [smul_eq_mul]
    ring
  have hH0 : H ≠ 0 := by
    intro hH0
    obtain ⟨a', -, ha'⟩ := hcd ⊤ (fun _ => Submodule.mem_top) a0
    obtain ⟨s', -, hs'⟩ := hcd ⊤ (fun _ => Submodule.mem_top) s0
    have e : D x = φ * H * ((ρ s0)⁻¹ * ρ a' - ρ a0 * ((ρ s0)⁻¹) ^ 2 * ρ s') := by
      rw [hxas]; exact hquot _ _ _ _ ha' hs'
    apply hDx
    rw [e, hH0, mul_zero, zero_mul]
  have hne : φ * H ≠ 0 := mul_ne_zero hφ hH0
  have key : ∃ t : C.residueField ξ, D x = φ * H * t ∧ t ≠ 0 ∧ 0 ≤ wcpaDjValOrd V t ∧
      ((¬ ∃ W' : C.Opens, c₀ ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ q)) →
        1 ≤ wcpaDjValOrd V t) := by
    by_cases hsm : ∃ W' : C.Opens, c₀ ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ q)
    · obtain ⟨a, s, hsu, hxas'⟩ :=
        wcpa_dj_cdp_le_smooth_center K C q ξ hξ L hOK V b c₀ hc₀ hsm hb x hxV
      obtain ⟨a', -, ha'⟩ := hcd ⊤ (fun _ => Submodule.mem_top) a
      obtain ⟨s', -, hs'⟩ := hcd ⊤ (fun _ => Submodule.mem_top) s
      have e : D x = φ * H * ((ρ s)⁻¹ * ρ a' - ρ a * ((ρ s)⁻¹) ^ 2 * ρ s') := by
        rw [hxas']; exact hquot _ _ _ _ ha' hs'
      have hsV : (ρ s)⁻¹ ∈ V := by
        have h1 : V.valuation (ρ s) = 1 := by
          refine le_antisymm ((V.valuation_le_one_iff _).2 (hgood' s)) ?_
          by_contra hlt
          push_neg at hlt
          exact hsu ((V.mem_nonunits_iff).2 hlt)
        refine (V.valuation_le_one_iff _).1 ?_
        rw [map_inv₀, h1, inv_one]
      refine ⟨_, e, ?_, ?_, fun h' => absurd hsm h'⟩
      · intro ht
        apply hDx
        rw [e, ht, mul_zero]
      · apply hnn
        exact sub_mem (mul_mem hsV (hgood' a'))
          (mul_mem (mul_mem (hgood' a) (pow_mem hsV 2)) (hgood' s'))
    · obtain ⟨hb', hc, -, hiff⟩ := id hc₀
      let I : Ideal Γ(C, L.V b) :=
        Ideal.comap (C.presheaf.germ (L.V b) c₀ hc).hom
          (IsLocalRing.maximalIdeal (C.presheaf.stalk c₀))
      have hI : ∀ l, π b (wcpaDjJacMinor (f b) l) ∈ I := by
        intro l
        by_contra hl
        exact hsm (wcpa_dj_cdp_le_jacobian_smooth K C q n σ (L.V b) (W b) (hle b) (r b) (π b)
          (f b) (h b) (hchart b) c₀ hc l hl)
      set θ : Derivation K (C.residueField ξ) (C.residueField ξ) := (φ * H)⁻¹ • D with hθdef
      have hθa : ∀ a, θ (ρ a) ∈ V.nonunits := by
        intro a
        obtain ⟨a', ha'I, ha'⟩ := hcd I hI a
        have e : θ (ρ a) = ρ a' := by
          rw [hθdef, Derivation.smul_apply, ha', smul_eq_mul]
          exact inv_mul_cancel_left₀ hne _
        rw [e]
        exact (hiff a').1 ha'I
      have hθx := wcpa_dj_cdp_le_node_branch K C q hss ξ hξ hA hF L hOK V hV b c₀ hc₀ hsm θ
        (fun _ a => hθa a) x hx
      have hDθ : D x = φ * H * θ x := by
        rw [hθdef, Derivation.smul_apply, smul_eq_mul]
        exact (mul_inv_cancel_left₀ hne (D x)).symm
      have ht0 : θ x ≠ 0 := by
        intro ht
        apply hDx
        rw [hDθ, ht, mul_zero]
      exact ⟨θ x, hDθ, ht0, le_trans zero_le_one (hnu _ ht0 hθx), fun _ => hnu _ ht0 hθx⟩
  obtain ⟨t, hDt, ht0, ht_nn, ht_node⟩ := key
  have hHnn : 0 ≤ wcpaDjValOrd V H := hnn H (hgood' _)
  have hval : wcpaDjValOrd V (D x) =
      wcpaDjValOrd V φ + wcpaDjValOrd V H + wcpaDjValOrd V t := by
    rw [hDt, mult _ _ hne ht0, mult _ _ hφ hH0]
  refine ⟨by linarith, ?_⟩
  rintro ⟨c, b', hctr', hcase⟩
  have hsep : IsSeparated q := inferInstance
  have hcc : c₀ = c :=
    wcpa_dj_cdp_le_center_unique K C q hsep L hOK ξ hA V hV.1 b b' c₀ c hc₀ hctr'
  rcases hcase with hns | ⟨i, p, hp⟩
  · have := ht_node (by rw [hcc]; exact hns)
    linarith
  · have hmk := wcpa_dj_cdp_le_mark K C q n σ L b (W b) (hle b) (r b) (π b) (f b) (h b)
      (hchart b) ξ V c₀ hc₀ i p (hp.trans hcc.symm) hb
    have hsplit : H = ρ (h b i) * ρ (∏ j ∈ Finset.univ.erase i, h b j) := by
      rw [← map_mul, Finset.mul_prod_erase _ _ (Finset.mem_univ i)]
    have hr0 : ρ (∏ j ∈ Finset.univ.erase i, h b j) ≠ 0 := by
      intro h0; apply hH0; rw [hsplit, h0, mul_zero]
    have hi0 : ρ (h b i) ≠ 0 := by
      intro h0; apply hH0; rw [hsplit, h0, zero_mul]
    have hvH : wcpaDjValOrd V H = wcpaDjValOrd V (ρ (h b i)) +
        wcpaDjValOrd V (ρ (∏ j ∈ Finset.univ.erase i, h b j)) := by
      rw [hsplit]; exact mult _ _ hi0 hr0
    have h1 := hnu _ hi0 hmk
    have h2 := hnn _ (hgood' (∏ j ∈ Finset.univ.erase i, h b j))
    linarith

theorem wcpa_dj_fva_logcanon_comp_deg_pos : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C),
    3 ≤ n → wcpaDjStablePtd q n σ → GeometricallyConnected q → wcpaDjCocOK L →
    wcpaDjLogCanon q σ L →
    ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ∀ a : Fin L.m, ξ ∈ L.V a →
      1 ≤ wcpaDjCompDeg L ξ a :=
by
  intro K _ _ C q n σ L hn hst hgc hOK hLC ξ hξ a ha
  classical
  obtain ⟨W, hle, r, π, f, h, hchart, htrans⟩ := hLC
  letI : Algebra K (C.residueField ξ) := (wcpaDjFK K q ξ).toAlgebra
  have hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ := rfl
  have hq : IsProper q := hst.1.2.1
  have hFF := wcpa_dj_cdp_residue_ff1 K C q hst.1 ξ hξ hA
  obtain ⟨⟨u, hu⟩, hmul, hfin, hsum, htop⟩ := wcpa_dj_cdp_ff_valuations K (C.residueField ξ) hFF
  obtain ⟨D, hD⟩ := wcpa_dj_cdp_ff_derivation K (C.residueField ξ) hFF
  obtain ⟨⟨V₀, hV₀, hV₀s⟩, h3⟩ :=
    wcpa_dj_cdp_special_points K C q n σ L hn hst hgc hOK ξ hξ hA
  have hD0 : D ≠ 0 := by
    intro h0
    apply hD V₀ (u V₀) hV₀ (hu V₀ hV₀)
    simp [h0]
  obtain ⟨φ, hφ, hratio⟩ := wcpa_dj_cdp_log_ratio K C q n σ L W hle r π f h hst hOK hchart htrans
    ξ hξ hA D hD0
  obtain ⟨hκfin, hκ, hκ2⟩ := wcpa_dj_cdp_canonical_degree K (C.residueField ξ) hFF D hD u hu

  have hv1 : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      wcpaDjValOrd V (1 : C.residueField ξ) = 0 := by
    intro V hV
    have := hmul V hV 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at this
    linarith
  have hvinv : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      ∀ x : C.residueField ξ, x ≠ 0 → wcpaDjValOrd V x⁻¹ = - wcpaDjValOrd V x := by
    intro V hV x hx
    have := hmul V hV x x⁻¹ hx (inv_ne_zero hx)
    rw [mul_inv_cancel₀ hx, hv1 V hV] at this
    linarith
  have hgb : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ξ ∈ L.V b := by
    intro V b hg
    obtain ⟨hb, _⟩ := hg
    exact hb

  have hconst : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ∀ c : K, algebraMap K (C.residueField ξ) c ∈ V := by
    intro V b hg c
    obtain ⟨hb, hgood⟩ := hg
    have key := hgood ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
    have e : algebraMap K (C.residueField ξ) c = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) := by
      rw [hA]
      unfold wcpaDjFK
      rw [← TopCat.Presheaf.germ_res C.presheaf (homOfLE (le_top : L.V b ≤ ⊤)) ξ hb]
      rfl
    rw [e]
    exact key
  have hNt_chart : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      ∃ b, wcpaDjChartGood L ξ V b :=
    fun V hV => wcpa_dj_cdp_chart_exists K C q hq L hOK ξ hA V hV

  suffices main : ∀ T : ValuationSubring (C.residueField ξ) → ℤ,
      (∀ V, ¬ wcpaDjNtV' K V → T V = 0) →
      (∀ V, wcpaDjNtV' K V → ∃ b, ∃ hb : ξ ∈ L.V b, wcpaDjChartGood L ξ V b ∧
          T V = wcpaDjValOrd V (φ a) - wcpaDjValOrd V (φ b)) →
      1 ≤ ∑ᶠ V, T V by
    unfold wcpaDjCompDeg
    apply main
    · intro V hV
      beta_reduce
      split_ifs with hP
      · obtain ⟨b, hgood⟩ := hP.2
        have hall := hconst V b hgood
        have hVtop : V = ⊤ := by
          by_contra hne
          exact hV ⟨hall, hne⟩
        subst hVtop
        exact htop _
      · rfl
    · intro V hV
      obtain ⟨b0, hb0⟩ := hNt_chart V hV
      have hP : ξ ∈ L.V a ∧ ∃ b, wcpaDjChartGood L ξ V b := ⟨ha, b0, hb0⟩
      refine ⟨hP.2.choose, hgb V _ hP.2.choose_spec, hP.2.choose_spec, ?_⟩
      beta_reduce
      rw [dif_pos hP]
      have hbm := hgb V _ hP.2.choose_spec
      rw [hratio a _ (TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hbm⟩)]
      rw [hmul V hV _ _ (hφ a ha).1 (inv_ne_zero (hφ _ hbm).1), hvinv V hV _ (hφ _ hbm).1]
      ring
  intro T hT0 hT1
  haveI : Nonempty (Fin L.m) := ⟨a⟩
  choose! bs hbsξ hbsg hbsT using hT1
  obtain ⟨A, hAd⟩ : ∃ A : ValuationSubring (C.residueField ξ) → ℤ,
      A = Set.indicator {V : ValuationSubring (C.residueField ξ) | wcpaDjNtV' K V}
        (fun V => wcpaDjValOrd V (φ a)) := ⟨_, rfl⟩
  obtain ⟨κf, hκd⟩ : ∃ κf : ValuationSubring (C.residueField ξ) → ℤ,
      κf = Set.indicator {V : ValuationSubring (C.residueField ξ) | wcpaDjNtV' K V}
        (fun V => -wcpaDjValOrd V (D (u V))) := ⟨_, rfl⟩
  obtain ⟨ε, hεd⟩ : ∃ ε : ValuationSubring (C.residueField ξ) → ℤ,
      ∀ V, ε V = T V - A V - κf V := ⟨fun V => T V - A V - κf V, fun V => rfl⟩
  have hA_in : ∀ V, wcpaDjNtV' K V → A V = wcpaDjValOrd V (φ a) := by
    intro V hV; rw [hAd]; exact Set.indicator_of_mem (show V ∈ {V | wcpaDjNtV' K V} from hV) _
  have hA_out : ∀ V, ¬ wcpaDjNtV' K V → A V = 0 := by
    intro V hV; rw [hAd]; exact Set.indicator_of_notMem (show V ∉ {V | wcpaDjNtV' K V} from hV) _
  have hκ_in : ∀ V, wcpaDjNtV' K V → κf V = -wcpaDjValOrd V (D (u V)) := by
    intro V hV; rw [hκd]; exact Set.indicator_of_mem (show V ∈ {V | wcpaDjNtV' K V} from hV) _
  have hκ_out : ∀ V, ¬ wcpaDjNtV' K V → κf V = 0 := by
    intro V hV; rw [hκd]; exact Set.indicator_of_notMem (show V ∉ {V | wcpaDjNtV' K V} from hV) _

  have hfinA : (Function.support A).Finite := by
    refine (hfin (φ a) (hφ a ha).1).subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · exact ⟨hN, by rwa [hA_in V hN] at hV'⟩
    · exact absurd (hA_out V hN) hV'
  have hfinκ : (Function.support κf).Finite := by
    refine hκfin.subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · refine ⟨hN, ?_⟩
      intro h0
      apply hV'
      rw [hκ_in V hN, h0, neg_zero]
    · exact absurd (hκ_out V hN) hV'
  have hfinT : (Function.support T).Finite := by
    have hU : (⋃ b : Fin L.m, {V : ValuationSubring (C.residueField ξ) |
        wcpaDjNtV' K V ∧ φ b ≠ 0 ∧ wcpaDjValOrd V (φ b) ≠ 0}).Finite := by
      apply Set.finite_iUnion
      intro b
      by_cases hb0 : φ b = 0
      · exact Set.finite_empty.subset (fun V hV => (hV.2.1 hb0).elim)
      · exact (hfin (φ b) hb0).subset (fun V hV => ⟨hV.1, hV.2.2⟩)
    refine ((hfin (φ a) (hφ a ha).1).union hU).subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · have hTV := hbsT V hN
      by_cases hva : wcpaDjValOrd V (φ a) = 0
      · right
        refine Set.mem_iUnion.mpr ⟨bs V, hN, (hφ _ (hbsξ V hN)).1, ?_⟩
        intro h0
        apply hV'
        rw [hTV, hva, h0, sub_zero]
      · left
        exact ⟨hN, hva⟩
    · exact absurd (hT0 V hN) hV'
  have hfinε : (Function.support ε).Finite := by
    refine ((hfinT.union hfinA).union hfinκ).subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_contra hc
    simp only [Set.mem_union, Function.mem_support, not_or, not_not] at hc
    apply hV'
    rw [hεd V, hc.1.1, hc.1.2, hc.2]
    norm_num
  have hfinκε : (Function.support (fun V => κf V + ε V)).Finite :=
    (hfinκ.union hfinε).subset (Function.support_add _ _)
  have hsplit : ∑ᶠ V, T V = ∑ᶠ V, A V + (∑ᶠ V, κf V + ∑ᶠ V, ε V) := by
    rw [← finsum_add_distrib (show Function.HasFiniteSupport κf from hfinκ)
        (show Function.HasFiniteSupport ε from hfinε),
      ← finsum_add_distrib (show Function.HasFiniteSupport A from hfinA)
        (show Function.HasFiniteSupport (fun V => κf V + ε V) from hfinκε)]
    apply finsum_congr
    intro V
    rw [hεd V]
    ring

  have hε : ∀ V, 0 ≤ ε V ∧ (wcpaDjNtV' K V → wcpaDjSpecialV q σ L ξ V → 1 ≤ ε V) := by
    intro V
    by_cases hN : wcpaDjNtV' K V
    · have hloc := wcpa_dj_cdp_local_excess K C q n σ L W hle r π f h hst hOK hchart ξ hξ hA D
        V hN (bs V) (hbsξ V hN) (hbsg V hN) (φ (bs V)) (hφ _ (hbsξ V hN)).1
        (hφ _ (hbsξ V hN)).2 (u V) (hu V hN) (hD V (u V) hN (hu V hN))
      have e : ε V = wcpaDjValOrd V (D (u V)) - wcpaDjValOrd V (φ (bs V)) := by
        rw [hεd V, hbsT V hN, hA_in V hN, hκ_in V hN]
        ring
      rw [e]
      exact ⟨by linarith [hloc.1], fun _ hs => by linarith [hloc.2 hs]⟩
    · have e : ε V = 0 := by
        rw [hεd V, hT0 V hN, hA_out V hN, hκ_out V hN]
        norm_num
      rw [e]
      exact ⟨le_rfl, fun h' => absurd h' hN⟩
  have hεsum : ∀ s : Finset (ValuationSubring (C.residueField ξ)),
      (∀ V ∈ s, wcpaDjNtV' K V ∧ wcpaDjSpecialV q σ L ξ V) → (s.card : ℤ) ≤ ∑ᶠ V, ε V := by
    intro s hs
    rw [finsum_eq_sum_of_support_subset ε (s := hfinε.toFinset ∪ s) (by
      intro V hV
      exact Finset.mem_coe.mpr (Finset.mem_union_left _ (hfinε.mem_toFinset.mpr hV)))]
    calc (s.card : ℤ) = ∑ V ∈ s, (1 : ℤ) := by simp
      _ ≤ ∑ V ∈ s, ε V := Finset.sum_le_sum (fun V hV => (hε V).2 (hs V hV).1 (hs V hV).2)
      _ ≤ ∑ V ∈ hfinε.toFinset ∪ s, ε V :=
          Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_right
            (fun V _ _ => (hε V).1)
  have hsumA : ∑ᶠ V, A V = 0 := by
    rw [hAd]
    exact hsum (φ a) (hφ a ha).1
  rw [hsplit, hsumA, hκd]
  rcases hκ with hκ' | hκ'
  · obtain ⟨V₁, V₂, V₃, h12, h13, h23, hs1, hs2, hs3⟩ := h3 (hκ2 hκ')
    have hc := hεsum {V₁, V₂, V₃} (by
      intro V hV
      simp only [Finset.mem_insert, Finset.mem_singleton] at hV
      rcases hV with rfl | rfl | rfl
      exacts [hs1, hs2, hs3])
    rw [Finset.card_eq_three.mpr ⟨V₁, V₂, V₃, h12, h13, h23, rfl⟩] at hc
    rw [hκ']
    push_cast at hc
    linarith
  · have hc := hεsum {V₀} (by
      intro V hV
      rw [Finset.mem_singleton] at hV
      subst hV
      exact ⟨hV₀, hV₀s⟩)
    rw [Finset.card_singleton] at hc
    push_cast at hc
    linarith

theorem wcpa_dj_lcp_fac_fibre_va : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C),
    3 ≤ n → wcpaDjStablePtd q n σ → GeometricallyConnected q → wcpaDjCocOK L →
    wcpaDjLogCanon q σ L → ∃ e : ℕ, 0 < e ∧ wcpaDjVA q L ⊤ e :=
by
  intro K _ _ C q n σ L hn hst hgc hOK hLC
  have hpos := wcpa_dj_fva_logcanon_comp_deg_pos K C q n σ L hn hst hgc hOK hLC
  obtain ⟨e, M, t, he, hsep⟩ := wcpa_dj_fva_separating_sections K C q L hst.1 hOK hpos
  exact ⟨e, he, wcpa_dj_fva_chart_criterion K C q L hst.1 hOK e M t hsep⟩

theorem wcpa_dj_lcp_sp_fibre_ample_cocycle : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS →
    ∀ (uu : Z ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ Z)), 3 ≤ n →
    wcpaDjStablePtd uu n τ → GeometricallyConnected uu →
    ∃ L : wcpaDjCoc Z, wcpaDjCocOK L ∧
      ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S),
        ∃ e : ℕ, 0 < e ∧ wcpaDjVA (Limits.pullback.snd uu s)
          (wcpaDjCocPull (Limits.pullback.fst uu s) L) ⊤ e :=
by
  intro k _ S Z sS hS uu n τ hn hst hgc

  have hpullOK : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y), IsAffineHom h →
      wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' Y h L hh hL
    haveI := hh
    obtain ⟨h1, h2, h3, h4⟩ := hL
    refine ⟨fun (a : Fin L.m) => (h1 a).preimage h, ?_, fun (a : Fin L.m) => ?_,
      fun (a b c : Fin L.m) => ?_⟩
    · show (⨆ a, h ⁻¹ᵁ L.V a) = ⊤
      rw [← Scheme.Hom.preimage_iSup, h2, Scheme.Hom.preimage_top]
    · show Units.map _ (L.g a a) = 1
      rw [h3 a, map_one]
    · have key : ∀ (U : Y.Opens) (O P : Y'.Opens) (hP : P ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c))
          (hU : L.V a ⊓ L.V b ⊓ L.V c ≤ U)
          (e1 : O ≤ h ⁻¹ᵁ U) (e2 : P ≤ O) (x : Γ(Y, U)),
          (Y'.presheaf.map (homOfLE e2).op).hom ((Y'.presheaf.map (homOfLE e1).op).hom
            ((h.app U).hom x)) =
          (h.appLE (L.V a ⊓ L.V b ⊓ L.V c) P hP).hom
            ((Y.presheaf.map (homOfLE hU).op).hom x) := by
        intro U O P hP hU e1 e2 x
        have e : h.app U ≫ Y'.presheaf.map (homOfLE e1).op ≫ Y'.presheaf.map (homOfLE e2).op =
            Y.presheaf.map (homOfLE hU).op ≫ h.appLE (L.V a ⊓ L.V b ⊓ L.V c) P hP := by
          rw [Scheme.Hom.map_appLE, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map_assoc,
            Scheme.Hom.appLE_map]
        have := congrArg (fun φ => φ.hom x) e
        simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
      simp only [wcpaDjCocPull, Units.coe_map, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe,
        RingHom.comp_apply]
      erw [key, key, key, ← map_mul]
      · exact congrArg _ (h4 a b c)
      all_goals first
        | exact fun _ hx => hx
        | exact inf_le_left
        | exact le_inf (inf_le_left.trans inf_le_right) inf_le_right
        | exact le_inf (inf_le_left.trans inf_le_left) inf_le_right

  obtain ⟨L, hOK, hLC⟩ := wcpa_dj_lcp_fac_log_cocycle k S Z sS hS uu n τ hst.1 hst.2.1
  refine ⟨L, hOK, ?_⟩
  intro K _ _ s
  obtain ⟨τ', hτ'st, hτ's, hτ'f⟩ := wcpa_dj_lcp_stableptd_basechange uu n τ s hst
  have hgc' : GeometricallyConnected (Limits.pullback.snd uu s) :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected)
      (IsPullback.of_hasPullback uu s) hgc
  haveI : IsProper sS := wcpa_dj_proj_proper k sS hS
  haveI hs : IsAffineHom s := IsAffineHom.of_comp s sS
  have hfst : IsAffineHom (Limits.pullback.fst uu s) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback uu s).flip hs
  have hOK' := hpullOK (Limits.pullback.fst uu s) L hfst hOK

  have hLC' := wcpa_dj_lcp_fsb_logcanon_basechange_sec uu n τ L s hs hst.2.1.1 hLC τ' hτ's hτ'f

  exact wcpa_dj_lcp_fac_fibre_va K (Limits.pullback uu s) (Limits.pullback.snd uu s) n τ' _ hn
    hτ'st hgc' hOK' hLC'

theorem wcpa_dj_lcp_ra_fibre_cohvan : ∀ (k : Type u) [Field k] (S Z : Scheme.{u})
    (sS : S ⟶ Spec (.of k)), wcpaDjIsProjOver k sS → ∀ (uu : Z ⟶ S), IsProper uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S),
        ∃ e : ℕ, 0 < e ∧ wcpaDjVA (Limits.pullback.snd uu s)
          (wcpaDjCocPull (Limits.pullback.fst uu s) L) ⊤ e) →
    ∀ (y : S) (F : (Limits.pullback uu (S.fromSpecResidueField y)).Modules), wcCoherentMod F →
      ∃ n₀ : ℕ, ∀ n ≥ n₀,
        wcpaDjTwH1 (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L) ⊤ F n :=
by
  intro k _ S Z sS hS uu huu L hL hfib y F hF
  classical
  haveI := huu
  haveI hsSp : IsProper sS := wcpa_dj_proj_proper k sS hS

  have hpull : ∀ {Y' : Scheme.{u}} (h : Y' ⟶ Z), (∀ a, IsAffineOpen (h ⁻¹ᵁ L.V a)) →
      wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' h hA
    have key : ∀ (U V : Z.Opens) (r : V ≤ U) (O : Y'.Opens) (s2 : O ≤ h ⁻¹ᵁ V) (P : Y'.Opens)
        (i : P ⟶ h ⁻¹ᵁ U) (j : O ⟶ P) (x : Γ(Z, U)),
        (Y'.presheaf.map j.op).hom ((Y'.presheaf.map i.op).hom ((h.app U).hom x)) =
          (h.appLE V O s2).hom ((Z.presheaf.map (homOfLE r).op).hom x) := by
      intro U V r O s2 P i j x
      have e : h.app U ≫ Y'.presheaf.map i.op ≫ Y'.presheaf.map j.op =
          Z.presheaf.map (homOfLE r).op ≫ h.appLE V O s2 := by
        rw [← Functor.map_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
          Scheme.Hom.map_appLE]
      have e2 := congrArg (fun φ => φ.hom x) e
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e2
    refine ⟨hA, ?_, ?_, ?_⟩
    · show (⨆ a, h ⁻¹ᵁ L.V a) = ⊤
      rw [← Scheme.Hom.preimage_iSup, hL.2.1, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hL.2.2.1 a, map_one]
    · rintro (a : Fin L.m) (b : Fin L.m) (c : Fin L.m)
      have s2 : h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
        fun _ hx => hx
      have e := congrArg (h.appLE _ _ s2).hom (hL.2.2.2 a b c)
      rw [map_mul,
        ← key (L.V a ⊓ L.V b) _ _ _ s2 (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b) (homOfLE fun _ hx => hx)
          (homOfLE inf_le_left),
        ← key (L.V b ⊓ L.V c) _ _ _ s2 (h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c) (homOfLE fun _ hx => hx)
          (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right)),
        ← key (L.V a ⊓ L.V c) _ _ _ s2 (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V c) (homOfLE fun _ hx => hx)
          (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right))] at e
      exact e

  obtain ⟨K, iK, hKac, ⟨iA⟩⟩ : ∃ (K : Type u) (_ : Field K), IsAlgClosed K ∧
      Nonempty (Algebra (S.residueField y) K) :=
    ⟨AlgebraicClosure (S.residueField y), inferInstance, inferInstance, ⟨inferInstance⟩⟩
  haveI := hKac
  set ρ : Spec (.of K) ⟶ Spec (S.residueField y) :=
    Spec.map (CommRingCat.ofHom (algebraMap (S.residueField y) K)) with hρ
  obtain ⟨e, he, hVA⟩ := hfib K (ρ ≫ S.fromSpecResidueField y)

  have hw : Limits.pullback.fst uu (ρ ≫ S.fromSpecResidueField y) ≫ uu =
      (Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y) ≫ ρ) ≫
        S.fromSpecResidueField y := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨π, hπp, hπq⟩ : ∃ π : Limits.pullback uu (ρ ≫ S.fromSpecResidueField y) ⟶
      Limits.pullback uu (S.fromSpecResidueField y),
      π ≫ Limits.pullback.fst uu (S.fromSpecResidueField y) =
        Limits.pullback.fst uu (ρ ≫ S.fromSpecResidueField y) ∧
      π ≫ Limits.pullback.snd uu (S.fromSpecResidueField y) =
        Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y) ≫ ρ :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hpb : IsPullback π (Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y))
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) ρ := by
    refine IsPullback.of_right ?_ hπq (IsPullback.of_hasPullback uu (S.fromSpecResidueField y))
    rw [hπp]
    exact IsPullback.of_hasPullback uu (ρ ≫ S.fromSpecResidueField y)
  haveI : IsAffineHom (S.fromSpecResidueField y) := IsAffineHom.of_comp _ sS
  haveI : IsAffineHom (ρ ≫ S.fromSpecResidueField y) := IsAffineHom.of_comp _ sS
  haveI hpaff : IsAffineHom (Limits.pullback.fst uu (S.fromSpecResidueField y)) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip
      (inferInstance : IsAffineHom (S.fromSpecResidueField y))
  haveI hpKaff : IsAffineHom (Limits.pullback.fst uu (ρ ≫ S.fromSpecResidueField y)) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip
      (inferInstance : IsAffineHom (ρ ≫ S.fromSpecResidueField y))
  haveI hqp : IsProper (Limits.pullback.snd uu (S.fromSpecResidueField y)) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) huu
  haveI hqKp : IsProper (Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y)) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) huu
  haveI hπaff : IsAffineHom π :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip (inferInstance : IsAffineHom ρ)

  have hLK : wcpaDjCocOK (wcpaDjCocPull (Limits.pullback.fst uu (ρ ≫ S.fromSpecResidueField y)) L) :=
    hpull _ (fun a => (hL.1 a).preimage _)
  have hsingle : ∀ a, IsAffineOpen
      ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓ ⊤) := by
    intro a
    rw [inf_top_eq]
    exact (hL.1 a).preimage _
  have hpair : ∀ a b, IsAffineOpen
      ((wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V b ⊓ ⊤) := by
    intro a b
    rw [inf_top_eq]
    have hA : IsAffineOpen (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a) :=
      (hL.1 a).preimage _
    have hB : IsAffineOpen (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V b) :=
      (hL.1 b).preimage _
    haveI : IsAffine (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a).toScheme := hA
    haveI : IsAffineHom ((Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a).ι ≫
        Limits.pullback.snd uu (S.fromSpecResidueField y)) := inferInstance
    haveI : IsAffineHom (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a).ι :=
      IsAffineHom.of_comp _ (Limits.pullback.snd uu (S.fromSpecResidueField y))
    have h1 := (hB.preimage (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a).ι
      ).image_of_isOpenImmersion (Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ L.V a).ι
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h1
    exact h1
  have hnoeth : IsNoetherianRing Γ(Spec (.of K), ⊤) :=
    isNoetherianRing_of_ringEquiv K (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv

  have hbot : ∀ (n : ℕ) (U : (Limits.pullback uu (S.fromSpecResidueField y)).Opens),
      Ideal.map (wcCnSigma (B := ↑(S.residueField y))
          (Limits.pullback.snd uu (S.fromSpecResidueField y)) U)
        ((⊥ : Ideal ↑(S.residueField y)) ^ (n + 1)) •
        (⊤ : Submodule Γ(Limits.pullback uu (S.fromSpecResidueField y), U) Γ(F, U)) = ⊥ := by
    intro n U
    rw [pow_succ, Ideal.mul_bot, Ideal.map_bot, Submodule.bot_smul]
  have hsys : wcCnAdicSys (B := ↑(S.residueField y))
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) ⊥ (fun _ => F) (fun _ => 𝟙 F) := by
    refine ⟨fun _ => hF, fun n U _ => ⟨?_, fun s => ?_⟩, fun n U _ => hbot n U⟩
    · intro s
      exact ⟨s, by simp⟩
    · have gen : ∀ {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M]
          {B : Type u} [CommRing B] (σ : B →+* R) (n : ℕ) (s : M),
          s ∈ Ideal.map σ ((⊥ : Ideal B) ^ (n + 1)) • (⊤ : Submodule R M) ↔ s = 0 := by
        intro R _ M _ _ B _ σ n s
        rw [pow_succ, Ideal.mul_bot, Ideal.map_bot, Submodule.bot_smul, Submodule.mem_bot]
      refine Iff.trans ?_ (gen (wcCnSigma (B := ↑(S.residueField y))
        (Limits.pullback.snd uu (S.fromSpecResidueField y)) U) n s).symm
      simp
  have hcohK : wcCoherentMod ((Scheme.Modules.pullback π).obj F) :=
    (wc_cn_pullback_adic_system (S.residueField y) ⊥ _ _
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) π (fun _ => F) (fun _ => 𝟙 F) hsys).1 0

  obtain ⟨n₀, hn₀⟩ := wcpa_dj_lcp_ra_serre_vanishing
    (Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y)) ⊤ (isAffineOpen_top _) hnoeth hqKp
    _ hLK e he hVA _ hcohK

  have hΘ := fun (O : (Limits.pullback uu (S.fromSpecResidueField y)).Opens) (hO : IsAffineOpen O) =>
    wcpa_dj_lcp_ra_fc_affine_bc_sections (S.residueField y) K _ _
      (Limits.pullback.snd uu (S.fromSpecResidueField y)) π
      (Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y)) hpb O hO
  obtain ⟨Λ₀, P1, P2, P3⟩ := wcpa_dj_lcp_ra_fc_struct_retraction (S.residueField y) K _ _
    (Limits.pullback.snd uu (S.fromSpecResidueField y)) π
    (Limits.pullback.snd uu (ρ ≫ S.fromSpecResidueField y)) hΘ
  obtain ⟨Λ, R1, R2, R3⟩ := wcpa_dj_lcp_ra_fc_module_retraction _ _ π F
    (fun O hO => wc_cn_pb_affine_tensor_sections _ _ π F hF.1 O (π ⁻¹ᵁ O) hO (hO.preimage π)
      (le_refl _)) Λ₀ P1 P2 P3

  refine ⟨n₀, fun n hn => ?_⟩
  have h := hn₀ n hn
  rw [Scheme.Hom.preimage_top, ← hπp] at h
  exact wcpa_dj_lcp_ra_fc_twh1_descent _ _ Z π (Limits.pullback.fst uu (S.fromSpecResidueField y))
