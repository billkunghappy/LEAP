      have a3 : (Spec.map i).appTop = (Scheme.ΓSpecIso _).hom ≫ i ≫ (Scheme.ΓSpecIso _).inv := by
        rw [← Category.assoc, ← a2, Category.assoc, Iso.hom_inv_id, Category.comp_id]
