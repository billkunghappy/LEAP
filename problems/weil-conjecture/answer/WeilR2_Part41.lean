      have hx : ∀ x : Y.presheaf.stalk w, x ≠ 0 →
          ∃ n, x ∉ IsLocalRing.maximalIdeal (Y.presheaf.stalk w) ^ n := by
        intro x hx
        by_contra h
        push_neg at h
        apply hx
        have : x ∈ ⨅ i, IsLocalRing.maximalIdeal (Y.presheaf.stalk w) ^ i := Ideal.mem_iInf.mpr h
        rw [hK] at this
        exact (Submodule.mem_bot _).mp this
      obtain ⟨na, hna⟩ := hx a ha0
      obtain ⟨nb, hnb⟩ := hx b hb0
      refine ⟨max na nb, a, b, hab'.symm, fun B hB => ⟨fun h => hna ?_, fun h => hnb ?_⟩⟩
      · exact Ideal.pow_le_pow_right (le_trans (le_max_left _ _) hB) h
      · exact Ideal.pow_le_pow_right (le_trans (le_max_right _ _) hB) h
    choose! M num den hrep hbd using one
    haveI := Fintype.ofFinite ι
    refine ⟨(Finset.univ ×ˢ hPts.toFinset).sup (fun q => M q.1 q.2), fun p w hw =>
      ⟨num p w, den p w, hrep p w hw, ?_⟩⟩
    have hle : M p w ≤ (Finset.univ ×ˢ hPts.toFinset).sup (fun q => M q.1 q.2) :=
      Finset.le_sup (f := fun q => M q.1 q.2) (b := (p, w))
        (Finset.mem_product.mpr ⟨Finset.mem_univ _, hPts.mem_toFinset.mpr hw⟩)
    exact hbd p w hw _ (le_trans hle (Nat.le_succ _))
  have hH' := hH
  obtain ⟨-, h2, -, -, -, -, -, -, -, h10, -, -, -, -, -⟩ := hH'
  have hprop := wcpa_dj_proj_proper k (g ≫ sS) h2
  obtain ⟨hNoeth, hstalk⟩ := hC1 k Y (g ≫ sS) hprop
  haveI := hNoeth
  let Mx : Fin mD → Set Y := fun j =>
    {w : Y | w ∈ (⇑g ⁻¹' Dc j) ∧ ∀ w' : Y, w' ⤳ w → w' ∈ (⇑g ⁻¹' Dc j) → w' = w}
  have hMx : ∀ j, (Mx j).Finite := fun j =>
    hC2 Y (⇑g ⁻¹' Dc j) ((h10.1 j).preimage g.continuous)
  have hPts : (⋃ j, Mx j).Finite := Set.finite_iUnion hMx
  let ι := {p : Fin (N + 1) × Fin (N + 1) // p.1 ∈ I ∧ p.2 ∈ I}
  have hgr := fun p : ι =>
    wcpa_dj_stc_kmn_generic_ratio k S Y sS g m τ W mD Dc N I O a hH p.1.1 p.2.1 p.1.2 p.2.2
