theorem wcpa_dj_lcfg_local_rel : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (n : ℕ) (σ : Fin n → (T ⟶ Y)) (Va Vb : Y.Opens) (Wa Wb : T.Opens) (ha : Va ≤ q ⁻¹ᵁ Wa) (hb : Vb ≤ q ⁻¹ᵁ Wb) (ra rb : ℕ) (πa : MvPolynomial (Fin (ra + 1)) Γ(T, Wa) →+* Γ(Y, Va)) (πb : MvPolynomial (Fin (rb + 1)) Γ(T, Wb) →+* Γ(Y, Vb)) (fa : Fin ra → MvPolynomial (Fin (ra + 1)) Γ(T, Wa)) (fb : Fin rb → MvPolynomial (Fin (rb + 1)) Γ(T, Wb)) (hA : Fin n → Γ(Y, Va)) (hB : Fin n → Γ(Y, Vb)), wcpaDjLogChart q σ Va Wa ha ra πa fa hA → wcpaDjLogChart q σ Vb Wb hb rb πb fb hB → (∀ i, hA i ∈ nonZeroDivisors Γ(Y, Va)) → (∀ i, hB i ∈ nonZeroDivisors Γ(Y, Vb)) → (∀ c : Fin ra → MvPolynomial (Fin (ra + 1)) Γ(T, Wa), ∑ i, c i * fa i ∈ RingHom.ker πa ^ 2 → ∀ i, c i ∈ RingHom.ker πa) → (∀ c : Fin rb → MvPolynomial (Fin (rb + 1)) Γ(T, Wb), ∑ i, c i * fb i ∈ RingHom.ker πb ^ 2 → ∀ i, c i ∈ RingHom.ker πb) → (∀ v : Γ(Y, Va), (∀ j, v * πa (wcpaDjJacMinor fa j) = 0) → v = 0) → (∀ v : Γ(Y, Vb), (∀ k, v * πb (wcpaDjJacMinor fb k) = 0) → v = 0) → ∀ z ∈ Va ⊓ Vb, ∃ (s : Γ(Y, Va ⊓ Vb)) (γ : (Γ(Y, Y.basicOpen s))ˣ), z ∈ Y.basicOpen s ∧ ∀ (j : Fin (ra + 1)) (k : Fin (rb + 1)), (letI : Algebra Γ(T, Wa ⊓ Wb) Γ(Y, Y.basicOpen s) := (q.appLE (Wa ⊓ Wb) (Y.basicOpen s) (fun x hx => ⟨ha (Y.basicOpen_le s hx).1, hb (Y.basicOpen_le s hx).2⟩)).hom.toAlgebra; ((γ : Γ(Y, Y.basicOpen s)) * (Y.presheaf.map (homOfLE ((Y.basicOpen_le s).trans inf_le_left)).op).hom ((∏ i, hA i) * πa (wcpaDjJacMinor fa j))) • KaehlerDifferential.D Γ(T, Wa ⊓ Wb) Γ(Y, Y.basicOpen s) ((Y.presheaf.map (homOfLE ((Y.basicOpen_le s).trans inf_le_right)).op).hom (πb (MvPolynomial.X k))) = (Y.presheaf.map (homOfLE ((Y.basicOpen_le s).trans inf_le_right)).op).hom ((∏ i, hB i) * πb (wcpaDjJacMinor fb k)) • KaehlerDifferential.D Γ(T, Wa ⊓ Wb) Γ(Y, Y.basicOpen s) ((Y.presheaf.map (homOfLE ((Y.basicOpen_le s).trans inf_le_left)).op).hom (πa (MvPolynomial.X j)))) :=
by
  intro Y T q n σ Va Vb Wa Wb ha hb ra rb πa πb fa fb hA hB LCa LCb hnzdA hnzdB hE2a hE2b hE3a
