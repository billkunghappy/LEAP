  obtain ⟨w, hsp, hwiff, hgw, hmax⟩ := hC3 S Y g y (Dc j) τ₀ hP hiff
  have hw : w ∈ ⋃ j, Mx j := Set.mem_iUnion.mpr ⟨j, hgw, hmax⟩
  obtain ⟨numw, denw, heqw, hnw, hdw⟩ := hB p w hw
  have hcmp := hC5 Y (φ p) y w hsp num den numw denw hy heqw
  letI : Algebra (Y.presheaf.stalk y) (Y.presheaf.stalk w) :=
    (Y.presheaf.stalkSpecializes hsp).hom.toAlgebra
  haveI := wc_ldp_nc_stalkSpecializes_isLocalization Y w y hsp
  have hPs : ∀ x, x ∈ (IsLocalRing.maximalIdeal (Y.presheaf.stalk w)).comap
      (Y.presheaf.stalkSpecializes hsp).hom ↔ (g.stalkMap y).hom τ₀ ∣ x :=
    fun x => Ideal.mem_comap.trans (hwiff x)
  exact hC4 (Y.presheaf.stalk y) (Y.presheaf.stalk w) _ hP _ hPs num den numw denw B hnum hden
    hcmp hnw hdw

theorem wcpa_dj_stc_km_base_offsec : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjStcKmHyp k S Y sS g m τ W mD Dc N I O a →
    ∃ B₁ : ℕ, ∀ i₀ ∈ I, ∀ y : Y,
      (∃ W' : Y.Opens, y ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g)) →
      y ∉ ⋃ j, Set.range ⇑(τ j) →
      ∀ (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (e : {i // g y ∈ Dc i} → Fin n)
        (J : Finset (Fin n)),
        wcpaDjStcSNCSys S mD Dc (g y) n t e → (∀ l, l ∈ J ↔ ∃ i, e i = l) →
        wcpaDjStcBaseMono k g m τ mD Dc I O a i₀ B₁ y n t J :=
by
  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a hH
  classical
  obtain ⟨B₁, hB₁⟩ := wcpa_dj_stc_kmo_exponent_bound k S Y sS g m τ W mD Dc N I O a hH
  refine ⟨B₁, ?_⟩
  intro i₀ hi₀ y hsm hy n t e J hsys hJ
  have hH' := hH
  obtain ⟨-, -, -, -, -, -, -, -, h9, h10, -, -, -, -, -⟩ := hH'
  have hsys' := hsys
  obtain ⟨hn, hspan, heinj, hiff⟩ := hsys'

  obtain ⟨hreg, e', f, hspan', hdim'⟩ :=
    wcpa_dj_stc_kmo_smooth_regular_params S Y g y n t (h9 (g y)) hsm hn hspan
  haveI := hreg
  obtain ⟨hdom, hprime, hndvd⟩ :=
    wcpa_dj_bko_regular_params (Y.presheaf.stalk y) (n + e') _ hdim' hspan'
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd (Y.presheaf.stalk y)
  haveI := hdom
  haveI := hufd
  have hsP : ∀ l, Prime ((g.stalkMap y).hom (t l)) := fun l => by
    have h := hprime (Fin.castAdd e' l)
    rwa [Fin.append_left] at h
  have hsD : ∀ l l', l ≠ l' → ¬ (g.stalkMap y).hom (t l) ∣ (g.stalkMap y).hom (t l') :=
    fun l l' hll' => by
      have h := hndvd (Fin.castAdd e' l) (Fin.castAdd e' l')
        (fun h => hll' (Fin.castAdd_injective _ _ h))
      rwa [Fin.append_left, Fin.append_left] at h

  have hper : ∀ i ∈ I, ∃ num den : Y.presheaf.stalk y, ∃ β : Fin n → ℤ,
      wcpaDjStcRatioLink (wcpaDjStcRatioSec k O a i₀ i) y num den ∧
      (∀ l, l ∉ J → β l = 0) ∧ (∀ l, |β l| ≤ (B₁ : ℤ)) ∧
      wcpaDjStcMonRel (1 : Y.presheaf.stalk y) (fun l => (g.stalkMap y).hom (t l)) num den 0 β := by
    intro i hi
    obtain ⟨hη, hne⟩ :=
      wcpa_dj_stc_kmn_generic_ratio k S Y sS g m τ W mD Dc N I O a hH i₀ hi₀ i hi
    obtain ⟨num, den, hlink, hden, hnum⟩ :=
      wcpa_dj_stc_kmn_ratio_link Y _ (wcpaDjStcRatioSec k O a i₀ i) y hη
    have hnum' := hnum hne
    obtain ⟨β, hβJ, hβv, hrel⟩ := wcpa_dj_stc_kmo_ufd_monomial (Y.presheaf.stalk y) n
      (fun l => (g.stalkMap y).hom (t l)) J num den (fun l _ => hsP l)
      (fun l _ l' _ h => hsD l l' h) hnum' hden
      (fun π hπ hπJ => wcpa_dj_stc_kmo_prime_off_boundary k S Y sS g m τ W mD Dc N I O a hH
        i₀ hi₀ i hi y hy n t e J hsys hJ num den hlink π hπ hπJ)
    refine ⟨num, den, β, hlink, hβJ, fun l => ?_, hrel⟩
    by_cases hl : l ∈ J
    · obtain ⟨i₁, rfl⟩ := (hJ l).mp hl
      rw [hβv _ hl]
      exact hB₁ i₀ hi₀ i hi y i₁.1 (t (e i₁)) hdom hufd (hsP _) (hiff i₁) num den hnum' hden
        hlink
    · rw [hβJ l hl]
      simp
  choose! num den β hlink hβJ hβB hrel using hper
  unfold wcpaDjStcBaseMono wcpaDjStcMonoData
  refine ⟨fun _ => 0, fun i => if i ∈ I then β i else 0, fun _ => 0, ?_, ?_, ?_, ?_⟩
  · intro i
    simp
  · intro i l
    by_cases hi : i ∈ I
    · show |(if i ∈ I then β i else 0) l| ≤ (B₁ : ℤ)
      rw [if_pos hi]
      exact hβB i hi l
    · show |(if i ∈ I then β i else 0) l| ≤ (B₁ : ℤ)
      rw [if_neg hi]
      simp
  · intro l
    simp
  · refine ⟨hn, hspan, ?_, ?_, ?_, Or.inr (Or.inr ⟨rfl, hsm, hy, fun _ => rfl, ?_⟩)⟩
    · intro p' h
      constructor
      · intro hp
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hp
        have hgy : g y ∈ Dc i := h.mem_closed (h10.1 i) hi
        exact ⟨e ⟨i, hgy⟩, (hJ _).mpr ⟨_, rfl⟩, (hiff ⟨i, hgy⟩ p' h).mp hi⟩
      · rintro ⟨j, hj, hmem⟩
        obtain ⟨i₁, rfl⟩ := (hJ j).mp hj
        exact Set.mem_iUnion.mpr ⟨i₁.1, (hiff i₁ p' h).mpr hmem⟩
    · intro i l hne
      by_cases hi : i ∈ I
      · have hne' : β i l ≠ 0 := by
          have : (if i ∈ I then β i else 0) l ≠ 0 := hne
          rwa [if_pos hi] at this
        by_contra hl
        exact hne' (hβJ i hi l hl)
      · exfalso
        have : (if i ∈ I then β i else 0) l ≠ 0 := hne
        rw [if_neg hi] at this
        exact this rfl
    · intro l hne
      exact absurd rfl hne
    · intro i hi
      refine ⟨num i, den i, hlink i hi, ?_⟩
      show wcpaDjStcMonRel (1 : Y.presheaf.stalk y) (fun l => (g.stalkMap y).hom (t l))
        (num i) (den i) 0 (if i ∈ I then β i else 0)
      rw [if_pos hi]
      exact hrel i hi

theorem wcpa_dj_stc_kms_ufd_monomial : ∀ (B : Type u) [CommRing B] [IsDomain B] [UniqueFactorizationMonoid B] (n : ℕ)
    (s : Fin n → B) (J : Finset (Fin n)) (z num den : B),
    num ≠ 0 → den ≠ 0 → Prime z → (∀ l ∈ J, Prime (s l)) → (∀ l ∈ J, ¬ Associated z (s l)) →
    (∀ l ∈ J, ∀ l' ∈ J, l ≠ l' → ¬ Associated (s l) (s l')) →
    (∀ π : B, Prime π → ¬ Associated π z → (∀ l ∈ J, ¬ Associated π (s l)) →
      ∃ u v : B, ¬ π ∣ u ∧ ¬ π ∣ v ∧ u * num = v * den) →
    ∃ (α : ℤ) (β : Fin n → ℤ), (∀ l, l ∉ J → β l = 0) ∧
      (∃ (e₁ e₂ : ℕ) (u₁ u₂ : B), num = z ^ e₁ * u₁ ∧ den = z ^ e₂ * u₂ ∧ ¬ z ∣ u₁ ∧ ¬ z ∣ u₂ ∧
        α = (e₁ : ℤ) - e₂) ∧
      (∀ l ∈ J, ∃ (e₁ e₂ : ℕ) (u₁ u₂ : B), num = s l ^ e₁ * u₁ ∧ den = s l ^ e₂ * u₂ ∧
        ¬ s l ∣ u₁ ∧ ¬ s l ∣ u₂ ∧ β l = (e₁ : ℤ) - e₂) ∧
      ∃ w : Bˣ, num * z ^ (-α).toNat * ∏ l, s l ^ (-(β l)).toNat =
        ↑w * den * z ^ α.toNat * ∏ l, s l ^ (β l).toNat :=
by
  classical
  intro B _ _ _ n s J z num den hnum hden hz hs hzs hss H

  have crit : ∀ a b : B, a ≠ 0 → b ≠ 0 →
      (∀ p : B, Prime p → emultiplicity p a = emultiplicity p b) → Associated a b := by
    intro a b ha hb h
    letI : StrongNormalizationMonoid B := UniqueFactorizationMonoid.strongNormalizationMonoid
    rw [UniqueFactorizationMonoid.associated_iff_normalizedFactors_eq_normalizedFactors ha hb]
    refine Multiset.ext' (fun q => ?_)
    by_cases hq : q ∈ UniqueFactorizationMonoid.normalizedFactors a ∨
        q ∈ UniqueFactorizationMonoid.normalizedFactors b
    · obtain ⟨hqi, hqn⟩ : Irreducible q ∧ normalize q = q := by
        rcases hq with hq | hq
        · exact ⟨UniqueFactorizationMonoid.irreducible_of_normalized_factor q hq,
            UniqueFactorizationMonoid.normalize_normalized_factor q hq⟩
        · exact ⟨UniqueFactorizationMonoid.irreducible_of_normalized_factor q hq,
            UniqueFactorizationMonoid.normalize_normalized_factor q hq⟩
      have h1 := UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hqi ha
      have h2 := UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hqi hb
      rw [hqn] at h1 h2
      have h3 := h q (UniqueFactorizationMonoid.irreducible_iff_prime.mp hqi)
      rw [h1, h2] at h3
      exact_mod_cast h3
    · push_neg at hq
      rw [Multiset.count_eq_zero.mpr hq.1, Multiset.count_eq_zero.mpr hq.2]

  obtain ⟨e₁, u₁, hu₁, hn₁⟩ := WfDvdMonoid.max_power_factor hnum hz.irreducible
  obtain ⟨e₂, u₂, hu₂, hd₂⟩ := WfDvdMonoid.max_power_factor hden hz.irreducible
  have hJex : ∀ l, l ∈ J → ∃ (f₁ f₂ : ℕ) (g₁ g₂ : B), num = s l ^ f₁ * g₁ ∧
      den = s l ^ f₂ * g₂ ∧ ¬ s l ∣ g₁ ∧ ¬ s l ∣ g₂ := by
    intro l hl
    obtain ⟨f₁, g₁, hg₁, h₁⟩ := WfDvdMonoid.max_power_factor hnum (hs l hl).irreducible
    obtain ⟨f₂, g₂, hg₂, h₂⟩ := WfDvdMonoid.max_power_factor hden (hs l hl).irreducible
    exact ⟨f₁, f₂, g₁, g₂, h₁, h₂, hg₁, hg₂⟩
  choose! f₁ f₂ g₁ g₂ hJ using hJex
  obtain ⟨α, hα⟩ : ∃ α : ℤ, α = (e₁ : ℤ) - e₂ := ⟨_, rfl⟩
  obtain ⟨β, hβ⟩ : ∃ β : Fin n → ℤ, β = fun l => if l ∈ J then (f₁ l : ℤ) - f₂ l else 0 :=
    ⟨_, rfl⟩
  have hβJ : ∀ l, l ∉ J → β l = 0 := by intro l hl; rw [hβ]; simp [hl]
  have hβm : ∀ l, l ∈ J → β l = (f₁ l : ℤ) - f₂ l := by intro l hl; rw [hβ]; simp [hl]
  refine ⟨α, β, hβJ, ⟨e₁, e₂, u₁, u₂, hn₁, hd₂, hu₁, hu₂, hα⟩, ?_, ?_⟩
  · intro l hl
    obtain ⟨h1, h2, h3, h4⟩ := hJ l hl
    exact ⟨f₁ l, f₂ l, g₁ l, g₂ l, h1, h2, h3, h4, hβm l hl⟩
  have hz0 := hz.ne_zero
  have hval : ∀ (q x c : B) (e : ℕ), Prime q → x = q ^ e * c → ¬ q ∣ c →
      emultiplicity q x = e := by
    intro q x c e hq hx hc
    rw [hx, emultiplicity_mul hq, emultiplicity_pow_self_of_prime hq,
      emultiplicity_eq_zero.mpr hc, add_zero]
  have hone : ∀ p q : B, Prime q → Associated p q → emultiplicity p q = 1 := by
    intro p q hq hpq
    rw [← emultiplicity_eq_of_associated_left hpq]
    have := emultiplicity_pow_self_of_prime hq 1
    rwa [pow_one, Nat.cast_one] at this
  have hzero : ∀ p q : B, Prime p → Prime q → ¬ Associated p q → emultiplicity p q = 0 := by
    intro p q hp hq h
    exact emultiplicity_eq_zero.mpr (fun hd => h (hp.associated_of_dvd hq hd))
  have hexp : ∀ p : B, Prime p → ∀ (x y : B) (a : ℕ) (k : Fin n → ℕ),
      emultiplicity p (x * y ^ a * ∏ l, s l ^ k l) = emultiplicity p x +
        (a : ℕ∞) * emultiplicity p y + ∑ l, (k l : ℕ∞) * emultiplicity p (s l) := by
    intro p hp x y a k
    rw [emultiplicity_mul hp, emultiplicity_mul hp, emultiplicity_pow hp,
      Finset.emultiplicity_prod hp]
    simp only [emultiplicity_pow hp]
  have hne : ∀ (x : B) (a : ℕ) (k : Fin n → ℕ), x ≠ 0 → (∀ l, l ∉ J → k l = 0) →
      x * z ^ a * ∏ l, s l ^ k l ≠ 0 := by
    intro x a k hx hk
    refine mul_ne_zero (mul_ne_zero hx (pow_ne_zero _ hz0)) ?_
    rw [Finset.prod_ne_zero_iff]
    intro l _
    by_cases hl : l ∈ J
    · exact pow_ne_zero _ (hs l hl).ne_zero
    · rw [hk l hl, pow_zero]; exact one_ne_zero
  have hkm : ∀ l, l ∉ J → (-(β l)).toNat = 0 := by intro l hl; rw [hβJ l hl]; rfl
  have hkp : ∀ l, l ∉ J → (β l).toNat = 0 := by intro l hl; rw [hβJ l hl]; rfl
  have hsum0 : ∀ p : B, Prime p → (∀ l ∈ J, ¬ Associated p (s l)) → ∀ k : Fin n → ℕ,
      (∀ l, l ∉ J → k l = 0) → ∑ l, (k l : ℕ∞) * emultiplicity p (s l) = 0 := by
    intro p hp hpJ k hk
    apply Finset.sum_eq_zero
    intro l _
    by_cases hl : l ∈ J
    · rw [hzero p (s l) hp (hs l hl) (hpJ l hl), mul_zero]
    · rw [hk l hl, Nat.cast_zero, zero_mul]
  have hsum1 : ∀ p : B, Prime p → ∀ m ∈ J, Associated p (s m) → ∀ k : Fin n → ℕ,
      (∀ l, l ∉ J → k l = 0) → ∑ l, (k l : ℕ∞) * emultiplicity p (s l) = k m := by
    intro p hp m hm hpm k hk
    rw [Finset.sum_eq_single m]
    · rw [hone p (s m) (hs m hm) hpm, mul_one]
    · intro l _ hlm
      by_cases hl : l ∈ J
      · rw [hzero p (s l) hp (hs l hl)
          (fun hpl => hss m hm l hl (Ne.symm hlm) (hpm.symm.trans hpl)), mul_zero]
      · rw [hk l hl, Nat.cast_zero, zero_mul]
    · intro h; exact absurd (Finset.mem_univ m) h
  have heq : ∀ p : B, Prime p →
      emultiplicity p (num * z ^ (-α).toNat * ∏ l, s l ^ (-(β l)).toNat) =
        emultiplicity p (den * z ^ α.toNat * ∏ l, s l ^ (β l).toNat) := by
    intro p hp
    rw [hexp p hp, hexp p hp]
    by_cases hpz : Associated p z
    · have hpJ : ∀ l ∈ J, ¬ Associated p (s l) := fun l hl hpl => hzs l hl (hpz.symm.trans hpl)
      have hnp : emultiplicity p num = e₁ :=
        (emultiplicity_eq_of_associated_left hpz).symm.trans (hval z num u₁ e₁ hz hn₁ hu₁)
      have hdp : emultiplicity p den = e₂ :=
        (emultiplicity_eq_of_associated_left hpz).symm.trans (hval z den u₂ e₂ hz hd₂ hu₂)
      rw [hsum0 p hp hpJ _ hkm, hsum0 p hp hpJ _ hkp, hone p z hz hpz, hnp, hdp]
      have key : e₁ + (-α).toNat = e₂ + α.toNat := by
        have h1 := Int.toNat_eq_max (-α)
        have h2 := Int.toNat_eq_max α
        omega
      simp only [mul_one, add_zero]
      exact_mod_cast key
    · by_cases hpm : ∃ m ∈ J, Associated p (s m)
      · obtain ⟨m, hm, hpm⟩ := hpm
        obtain ⟨h1, h2, h3, h4⟩ := hJ m hm
        have hnp : emultiplicity p num = f₁ m :=
          (emultiplicity_eq_of_associated_left hpm).symm.trans
            (hval (s m) num (g₁ m) (f₁ m) (hs m hm) h1 h3)
        have hdp : emultiplicity p den = f₂ m :=
          (emultiplicity_eq_of_associated_left hpm).symm.trans
            (hval (s m) den (g₂ m) (f₂ m) (hs m hm) h2 h4)
        rw [hsum1 p hp m hm hpm _ hkm, hsum1 p hp m hm hpm _ hkp, hzero p z hp hz hpz, hnp, hdp]
        have key : f₁ m + (-(β m)).toNat = f₂ m + (β m).toNat := by
          have e1 := Int.toNat_eq_max (-(β m))
          have e2 := Int.toNat_eq_max (β m)
          have e3 := hβm m hm
          omega
        simp only [mul_zero, add_zero]
        exact_mod_cast key
      · push_neg at hpm
        rw [hsum0 p hp hpm _ hkm, hsum0 p hp hpm _ hkp, hzero p z hp hz hpz]
        obtain ⟨u, v, hu, hv, huv⟩ := H p hp hpz hpm
        have h := congrArg (emultiplicity p) huv
        rw [emultiplicity_mul hp, emultiplicity_mul hp, emultiplicity_eq_zero.mpr hu,
          emultiplicity_eq_zero.mpr hv, zero_add, zero_add] at h
        simp only [mul_zero, add_zero]
        exact h
  obtain ⟨u, hu⟩ := crit _ _ (hne num _ _ hnum hkm) (hne den _ _ hden hkp) heq
  refine ⟨u⁻¹, ?_⟩
  have hR : (↑u⁻¹ : B) * den * z ^ α.toNat * ∏ l, s l ^ (β l).toNat =
      ↑u⁻¹ * (den * z ^ α.toNat * ∏ l, s l ^ (β l).toNat) := by ring
  rw [hR, ← hu, mul_comm _ (u : B), Units.inv_mul_cancel_left]

theorem wcpa_dj_stc_kms_prime_generization : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (y : X) (π : X.presheaf.stalk y),
    Prime π → ∃ (w : X) (h : w ⤳ y),
      (∀ a : X.presheaf.stalk y, (X.presheaf.stalkSpecializes h).hom a ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk w) ↔ π ∣ a) ∧
      (X.presheaf.stalkSpecializes h).hom π ≠ 0 ∧
      Ideal.span {(X.presheaf.stalkSpecializes h).hom π} = IsLocalRing.maximalIdeal (X.presheaf.stalk w) ∧
      (∀ (num den : X.presheaf.stalk y) (r : X.presheaf.stalk w),
        r * (X.presheaf.stalkSpecializes h).hom den = (X.presheaf.stalkSpecializes h).hom num →
        IsUnit r → ∃ u v : X.presheaf.stalk y, ¬ π ∣ u ∧ ¬ π ∣ v ∧ u * num = v * den) ∧
      ∀ (num den u₁ u₂ : X.presheaf.stalk y) (e₁ e₂ : ℕ) (f : X.functionField),
        num = π ^ e₁ * u₁ → den = π ^ e₂ * u₂ → ¬ π ∣ u₁ → ¬ π ∣ u₂ →
        f * (X.presheaf.stalkSpecializes (genericPoint_specializes y)).hom den =
          (X.presheaf.stalkSpecializes (genericPoint_specializes y)).hom num →
        ∃ u : (X.presheaf.stalk w)ˣ,
          f = ((X.presheaf.stalkSpecializes (genericPoint_specializes w)).hom
                ((X.presheaf.stalkSpecializes h).hom π) : X.functionField) ^ ((e₁ : ℤ) - e₂) *
              (X.presheaf.stalkSpecializes (genericPoint_specializes w)).hom
                (u : X.presheaf.stalk w) :=
by

  have halg : ∀ (R S K : Type u) [CommRing R] [CommRing S] [IsLocalRing S] [Field K]
      (φ : R →+* S) (ιR : R →+* K) (ιS : S →+* K) (π : R), Prime π → Function.Injective ιR →
      (∀ a : R, ιS (φ a) = ιR a) → (∀ a : R, φ a ∈ IsLocalRing.maximalIdeal S ↔ π ∣ a) →
      (∀ s : S, ∃ a b : R, ¬ π ∣ b ∧ s * φ b = φ a) →
      φ π ≠ 0 ∧ Ideal.span {φ π} = IsLocalRing.maximalIdeal S ∧
      (∀ (num den : R) (r : S), r * φ den = φ num → IsUnit r →
        ∃ u v : R, ¬ π ∣ u ∧ ¬ π ∣ v ∧ u * num = v * den) ∧
      ∀ (num den u₁ u₂ : R) (e₁ e₂ : ℕ) (f : K), num = π ^ e₁ * u₁ → den = π ^ e₂ * u₂ →
        ¬ π ∣ u₁ → ¬ π ∣ u₂ → f * ιR den = ιR num →
        ∃ u : Sˣ, f = ιS (φ π) ^ ((e₁ : ℤ) - e₂) * ιS (u : S) := by
    intro R S K _ _ _ _ φ ιR ιS π hπ hinj hC hA hB
    have hφinj : Function.Injective φ := fun a b h => hinj (by rw [← hC, ← hC, h])
    have hunit : ∀ c, ¬ π ∣ c → IsUnit (φ c) := fun c hc =>
      IsLocalRing.notMem_maximalIdeal.mp (fun h => hc ((hA c).mp h))
    have hunit' : ∀ c, IsUnit (φ c) → ¬ π ∣ c := fun c hc hd =>
      IsLocalRing.notMem_maximalIdeal.mpr hc ((hA c).mpr hd)
    refine ⟨fun h => hπ.ne_zero (hφinj (by rw [h, map_zero])), ?_, ?_, ?_⟩
    · apply le_antisymm
      · rw [Ideal.span_singleton_le_iff_mem]; exact (hA π).mpr dvd_rfl
      · intro s hs
        obtain ⟨a, b, hb, hab⟩ := hB s
        have ha : φ a ∈ IsLocalRing.maximalIdeal S := by
          rw [← hab]; exact Ideal.mul_mem_right _ _ hs
        obtain ⟨c, rfl⟩ := (hA a).mp ha
        obtain ⟨U, hU⟩ := hunit b hb
        rw [Ideal.mem_span_singleton']
        refine ⟨φ c * ↑U⁻¹, ?_⟩
        have hab' : s * φ b = φ π * φ c := by rw [hab, map_mul]
        have hinv : φ b * ↑U⁻¹ = 1 := by rw [← hU, Units.mul_inv]
        linear_combination (-(↑U⁻¹ : S)) * hab' + s * hinv
    · intro num den r hr hru
      obtain ⟨a, b, hb, hab⟩ := hB r
      have ha : ¬ π ∣ a := hunit' a (by rw [← hab]; exact hru.mul (hunit b hb))
      refine ⟨b, a, hb, ha, hφinj ?_⟩
      rw [map_mul, map_mul, ← hab, ← hr]; ring
    · intro num den u₁ u₂ e₁ e₂ f hn hd h1 h2 hf
      obtain ⟨U₁, hU₁⟩ := hunit u₁ h1
      obtain ⟨U₂, hU₂⟩ := hunit u₂ h2
      refine ⟨U₁ * U₂⁻¹, ?_⟩
      have hπ0 : ιR π ≠ 0 := fun h => hπ.ne_zero (hinj (by rw [h, map_zero]))
      have hu20 : ιR u₂ ≠ 0 := fun h =>
        h2 (by rw [hinj (h.trans (map_zero ιR).symm)]; exact dvd_zero π)
      have hinv : ιS (↑U₂⁻¹ : S) * ιR u₂ = 1 := by
        rw [← hC u₂, ← hU₂, ← map_mul, Units.inv_mul, map_one]
      have hv : ιS (↑U₂⁻¹ : S) = (ιR u₂)⁻¹ := eq_inv_of_mul_eq_one_left hinv
      rw [Units.val_mul, map_mul, hv, hU₁, hC, hC, zpow_sub₀ hπ0, zpow_natCast, zpow_natCast]
      rw [hd, hn, map_mul, map_mul, map_pow, map_pow] at hf
      have hD : ιR π ^ e₂ * ιR u₂ ≠ 0 := mul_ne_zero (pow_ne_zero _ hπ0) hu20
      calc f = f * (ιR π ^ e₂ * ιR u₂) * (ιR π ^ e₂ * ιR u₂)⁻¹ :=
            (mul_inv_cancel_right₀ hD f).symm
        _ = ιR π ^ e₁ * ιR u₁ * (ιR π ^ e₂ * ιR u₂)⁻¹ := by rw [hf]
        _ = _ := by rw [mul_inv]; ring

  intro X _ y π hπ
  obtain ⟨U, hU, hyU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show y ∈ (⊤ : X.Opens) from trivial)
  letI : Algebra Γ(X, U) (X.presheaf.stalk y) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hyU⟩
  haveI hRloc : IsLocalization.AtPrime (X.presheaf.stalk y) (hU.primeIdealOf ⟨y, hyU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨y, hyU⟩
  have hπ0 : π ≠ 0 := hπ.ne_zero
  haveI : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ0).mpr hπ
  let P : Ideal Γ(X, U) :=
    Ideal.comap (algebraMap Γ(X, U) (X.presheaf.stalk y)) (Ideal.span {π})
  haveI hPprime : P.IsPrime := Ideal.IsPrime.comap _
  have hstar : ∀ x, x ∈ P ↔ π ∣ algebraMap Γ(X, U) (X.presheaf.stalk y) x := fun x => by
    simp only [P, Ideal.mem_comap, Ideal.mem_span_singleton]
  have hPq : P ≤ (hU.primeIdealOf ⟨y, hyU⟩).asIdeal := by
    intro x hx
    rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk y)
      (hU.primeIdealOf ⟨y, hyU⟩).asIdeal x]
    exact (IsLocalRing.mem_maximalIdeal _).mpr
      (fun hu => hπ.not_isUnit (isUnit_of_dvd_unit ((hstar x).mp hx) hu))
  let P' : PrimeSpectrum Γ(X, U) := ⟨P, hPprime⟩
  have hPq' : P' ⤳ hU.primeIdealOf ⟨y, hyU⟩ :=
    (PrimeSpectrum.le_iff_specializes P' _).mp hPq
  have h : hU.fromSpec P' ⤳ y := by
    have h1 := hPq'.map hU.fromSpec.continuous
    have e := hU.fromSpec_primeIdealOf ⟨y, hyU⟩
    rw [e] at h1
    exact h1
  have hw : hU.fromSpec P' ∈ U := h.mem_open U.isOpen hyU
  letI : Algebra Γ(X, U) (X.presheaf.stalk (hU.fromSpec P')) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hU.fromSpec P', hw⟩
  haveI hSloc : IsLocalization.AtPrime (X.presheaf.stalk (hU.fromSpec P')) P :=
    hU.isLocalization_stalk' P' hw
  have hcompat : ∀ x : Γ(X, U), (X.presheaf.stalkSpecializes h).hom
      (algebraMap Γ(X, U) (X.presheaf.stalk y) x) =
      algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec P')) x := fun x =>
    TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hyU h x
  have hA : ∀ a, (X.presheaf.stalkSpecializes h).hom a ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk (hU.fromSpec P')) ↔ π ∣ a := by
    intro a
    obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.surj (hU.primeIdealOf ⟨y, hyU⟩).asIdeal.primeCompl a
    dsimp only at hxs
    have hsu : IsUnit (algebraMap Γ(X, U) (X.presheaf.stalk y) s) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ (hU.primeIdealOf ⟨y, hyU⟩).asIdeal s).mpr s.2
    have hsP : (s : Γ(X, U)) ∈ P.primeCompl := fun hs =>
      hπ.not_isUnit (isUnit_of_dvd_unit ((hstar s).mp hs) hsu)
    have hsu' : IsUnit (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec P')) s) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ P s).mpr hsP
    have e1 : (X.presheaf.stalkSpecializes h).hom a *
        algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec P')) s =
        algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec P')) x := by
      rw [← hcompat, ← hcompat, ← map_mul, hxs]
    rw [← Ideal.mul_unit_mem_iff_mem _ hsu', e1,
      IsLocalization.AtPrime.to_map_mem_maximal_iff _ P, hstar, ← hxs, hsu.dvd_mul_right]
  have hB : ∀ s : X.presheaf.stalk (hU.fromSpec P'), ∃ a b : X.presheaf.stalk y, ¬ π ∣ b ∧
      s * (X.presheaf.stalkSpecializes h).hom b = (X.presheaf.stalkSpecializes h).hom a := by
    intro s
    obtain ⟨⟨x, t⟩, hxt⟩ := IsLocalization.surj P.primeCompl s
    dsimp only at hxt
    refine ⟨algebraMap Γ(X, U) (X.presheaf.stalk y) x,
      algebraMap Γ(X, U) (X.presheaf.stalk y) (t : Γ(X, U)), fun hd => t.2 ((hstar t).mpr hd), ?_⟩
    rw [hcompat, hcompat]
    exact hxt
  refine ⟨hU.fromSpec P', h, hA, ?_⟩
  have hinj : Function.Injective
      (X.presheaf.stalkSpecializes (genericPoint_specializes y)).hom :=
    IsFractionRing.injective (X.presheaf.stalk y) X.functionField
  exact halg _ _ _ (X.presheaf.stalkSpecializes h).hom _ _ π hπ hinj
    (fun a => TopCat.Presheaf.stalkSpecializes_comp_apply X.presheaf
      (genericPoint_specializes (hU.fromSpec P')) h a) hA hB

theorem wcpa_dj_stc_kms_dvr_points_finite : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsNoetherian Y]
    (Bd : Set Y), IsClosed Bd → genericPoint Y ∉ Bd →
    ∃ F : Finset Y, ∀ w ∈ Bd, ∀ ϖ : Y.presheaf.stalk w, ϖ ≠ 0 →
      Ideal.span {ϖ} = IsLocalRing.maximalIdeal (Y.presheaf.stalk w) → w ∈ F :=
by
  intro Y _ _ Bd hBd hη
  classical
  have s1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (ϖ : R),
      Ideal.span {ϖ} = IsLocalRing.maximalIdeal R →
      ∀ q : Ideal R, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal R := by
    intro R _ _ _ ϖ hspan q hq
    by_cases hqm : q = IsLocalRing.maximalIdeal R
    · exact Or.inr hqm
    left
    have ha : q ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal hq.ne_top
    have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := hspan ▸ Ideal.mem_span_singleton_self ϖ
    have hb : ϖ ∉ q := by
      intro h
      apply hqm
      apply le_antisymm ha
      rw [← hspan]
      exact (Ideal.span_singleton_le_iff_mem q).mpr h
    have hc : ∀ n : ℕ, ∀ a ∈ q, a ∈ IsLocalRing.maximalIdeal R ^ n := by
      intro n
      induction n with
      | zero => intro a _; simp
      | succ n ih =>
        intro a haq
        have ham : a ∈ Ideal.span {ϖ} := hspan ▸ ha haq
        obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ham
        have hbq : b ∈ q := (hq.mem_or_mem haq).resolve_right hb
        rw [pow_succ]
        exact Ideal.mul_mem_mul (ih b hbq) hϖm
    have hd := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (Ideal.IsMaximal.ne_top (IsLocalRing.maximalIdeal.isMaximal R))
    rw [eq_bot_iff]
    intro a haq
    rw [← hd]
    exact Ideal.mem_iInf.mpr (fun i => hc i a haq)
  have s2 : ∀ (w : Y),
      (∀ q : Ideal (Y.presheaf.stalk w), q.IsPrime →
        q = ⊥ ∨ q = IsLocalRing.maximalIdeal (Y.presheaf.stalk w)) →
      ∀ ξ : Y, ξ ⤳ w → ξ = w ∨ ξ = genericPoint Y := by
    intro w hP ξ hξ
    have hr := Scheme.range_fromSpecStalk (X := Y) (x := w)
    have h1 : ξ ∈ Set.range ⇑(Y.fromSpecStalk w) := by rw [hr]; exact hξ
    have h2 : genericPoint Y ∈ Set.range ⇑(Y.fromSpecStalk w) := by
      rw [hr]; exact genericPoint_specializes w
    obtain ⟨q, rfl⟩ := h1
    obtain ⟨q', hq'⟩ := h2
    rcases hP q.asIdeal q.isPrime with h | h
    · right
      have hs : q ⤳ q' := (PrimeSpectrum.le_iff_specializes q q').mp
        (by show q.asIdeal ≤ q'.asIdeal; rw [h]; exact bot_le)
      have h3 : Y.fromSpecStalk w q ⤳ genericPoint Y :=
        hq' ▸ hs.map (Y.fromSpecStalk w).continuous
      exact (h3.antisymm (genericPoint_specializes _)).eq
    · left
      have : q = IsLocalRing.closedPoint (Y.presheaf.stalk w) := PrimeSpectrum.ext h
      rw [this, Scheme.fromSpecStalk_closedPoint]
  obtain ⟨S, hSfin, hScl, hTirr, hBdS⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hBd
  have hG : Set.Finite {x : Y | ∃ T ∈ S, IsGenericPoint x T} := by
    have : {x : Y | ∃ T ∈ S, IsGenericPoint x T} = ⋃ T ∈ S, {x | IsGenericPoint x T} := by
      ext x; simp
    rw [this]
    exact hSfin.biUnion (fun T _ => Set.Subsingleton.finite (fun x hx y hy => IsGenericPoint.eq hx hy))
  refine ⟨hG.toFinset, ?_⟩
  intro w hw ϖ _ hspan
  rw [Set.Finite.mem_toFinset]
  have hP := s1 (Y.presheaf.stalk w) ϖ hspan
  rw [hBdS] at hw
  obtain ⟨T, hTS, hwT⟩ := Set.mem_sUnion.mp hw
  have hgen : IsGenericPoint (hTirr T hTS).genericPoint T := by
    have := (hTirr T hTS).isGenericPoint_genericPoint_closure
    rwa [(hScl T hTS).closure_eq] at this
  have hsp : (hTirr T hTS).genericPoint ⤳ w := hgen.specializes hwT
  rcases s2 w hP _ hsp with h | h
  · exact ⟨T, hTS, h ▸ hgen⟩
  · exfalso
    have hmem : genericPoint Y ∈ Bd := by
      rw [hBdS, ← h]
      exact Set.mem_sUnion.mpr ⟨T, hTS, hgen.mem⟩
    exact hη hmem

theorem wcpa_dj_stc_kms_ord_bound : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (F : Finset Y)
    {ι : Type} (I : Finset ι) (f : ι → Y.functionField),
    ∃ B : ℕ, ∀ w ∈ F, ∀ ϖ : Y.presheaf.stalk w, ϖ ≠ 0 →
      Ideal.span {ϖ} = IsLocalRing.maximalIdeal (Y.presheaf.stalk w) →
      ∀ i ∈ I, ∀ (d : ℤ) (u : (Y.presheaf.stalk w)ˣ),
        f i = ((Y.presheaf.stalkSpecializes (genericPoint_specializes w)).hom ϖ : Y.functionField) ^ d *
          (Y.presheaf.stalkSpecializes (genericPoint_specializes w)).hom (u : Y.presheaf.stalk w) →
        |d| ≤ (B : ℤ) :=
by
  classical
  intro Y _ F ι I f

  have uniq : ∀ (R K : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [Field K]
      (φ : R →+* K), Function.Injective φ → ∀ (ϖ ϖ' : R), ϖ ≠ 0 →
      Ideal.span {ϖ} = IsLocalRing.maximalIdeal R → Ideal.span {ϖ'} = IsLocalRing.maximalIdeal R →
      ∀ (d d' : ℤ) (u u' : Rˣ), φ ϖ ^ d * φ (u : R) = φ ϖ' ^ d' * φ (u' : R) → d = d' := by
    intro R K _ _ _ _ φ hφ ϖ ϖ' h0 hs hs' d d' u u' h
    obtain ⟨v, hv⟩ : Associated ϖ ϖ' :=
      Ideal.span_singleton_eq_span_singleton.mp (hs.trans hs'.symm)
    have hnu : ¬ IsUnit ϖ := by
      have hm : ϖ ∈ IsLocalRing.maximalIdeal R := hs ▸ Ideal.mem_span_singleton_self ϖ
      exact (IsLocalRing.mem_maximalIdeal ϖ).mp hm
    have ha : φ ϖ ≠ 0 := (map_ne_zero_iff φ hφ).mpr h0
    have hunit : ∀ x : Rˣ, φ (x : R) ≠ 0 := fun x => ((x.isUnit).map φ).ne_zero
    set ψ : Rˣ →* Kˣ := Units.map (φ : R →* K) with hψdef
    have hψ : ∀ x : Rˣ, ((ψ x : Kˣ) : K) = φ (x : R) := fun x => rfl
    have hU : φ ((v ^ d' * u' * u⁻¹ : Rˣ) : R) = φ (v : R) ^ d' * φ (u' : R) * (φ (u : R))⁻¹ := by
      rw [← hψ, map_mul, map_mul, map_inv, map_zpow, Units.val_mul, Units.val_mul,
        Units.val_zpow_eq_zpow_val, Units.val_inv_eq_inv_val, hψ, hψ, hψ]
    have key : φ ϖ ^ (d - d') = φ ((v ^ d' * u' * u⁻¹ : Rˣ) : R) := by
      rw [hU, zpow_sub₀ ha]
      rw [← hv, map_mul, mul_zpow] at h
      have hu0 := hunit u
      have hd' : φ ϖ ^ d' ≠ 0 := zpow_ne_zero _ ha
      field_simp
      linear_combination h
    set U : Rˣ := v ^ d' * u' * u⁻¹
    obtain ⟨n, hn | hn⟩ := Int.eq_nat_or_neg (d - d')
    · rw [hn, zpow_natCast, ← map_pow] at key
      have hpow := hφ key
      by_contra hne
      have hn0 : n ≠ 0 := by
        rintro rfl
        apply hne
        omega
      apply hnu
      have : IsUnit (ϖ ^ n) := hpow ▸ U.isUnit
      exact (isUnit_pow_iff hn0).mp this
    · rw [hn, zpow_neg, zpow_natCast, ← map_pow] at key
      by_contra hne
      have hn0 : n ≠ 0 := by
        rintro rfl
        apply hne
        omega
      apply hnu
      have hp0 : φ (ϖ ^ n) ≠ 0 := by rw [map_pow]; exact pow_ne_zero _ ha
      have h1 : φ (ϖ ^ n * (U : R)) = φ 1 := by
        rw [map_mul, ← key, mul_inv_cancel₀ hp0, map_one]
      have h2 := hφ h1
      exact (isUnit_pow_iff hn0).mp (isUnit_iff_exists_inv.mpr ⟨_, h2⟩)

  let Rep : Y → ι → ℤ → Prop := fun w i d => ∃ ϖ : Y.presheaf.stalk w, ϖ ≠ 0 ∧
    Ideal.span {ϖ} = IsLocalRing.maximalIdeal (Y.presheaf.stalk w) ∧
    ∃ u : (Y.presheaf.stalk w)ˣ,
      f i = ((Y.presheaf.stalkSpecializes (genericPoint_specializes w)).hom ϖ : Y.functionField) ^ d *
        (Y.presheaf.stalkSpecializes (genericPoint_specializes w)).hom (u : Y.presheaf.stalk w)
  let b : Y → ι → ℕ := fun w i => if h : ∃ d, Rep w i d then (Classical.choose h).natAbs else 0
  refine ⟨∑ w ∈ F, ∑ i ∈ I, b w i, ?_⟩

  intro w hw ϖ hϖ0 hspan i hi d u heq
  have h : ∃ d, Rep w i d := ⟨d, ϖ, hϖ0, hspan, u, heq⟩
  obtain ⟨ϖ₀, _, hspan₀, u₀, heq₀⟩ := Classical.choose_spec h
  have hinj : Function.Injective (Y.presheaf.stalkSpecializes (genericPoint_specializes w)).hom :=
    IsFractionRing.injective (Y.presheaf.stalk w) Y.functionField
  have hdd := uniq _ _ _ hinj ϖ ϖ₀ hϖ0 hspan hspan₀ d _ u u₀ (heq.symm.trans heq₀)
  have hb : b w i = (Classical.choose h).natAbs := dif_pos h
  have h1 : b w i ≤ ∑ i' ∈ I, b w i' := Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi
  have h2 : ∑ i' ∈ I, b w i' ≤ ∑ w' ∈ F, ∑ i' ∈ I, b w' i' :=
    Finset.single_le_sum (f := fun w' => ∑ i' ∈ I, b w' i') (fun _ _ => Nat.zero_le _) hw
  have h3 : (Classical.choose h).natAbs ≤ ∑ w' ∈ F, ∑ i' ∈ I, b w' i' := hb ▸ (h1.trans h2)
  rw [hdd, Int.abs_eq_natAbs]
  exact_mod_cast h3

theorem wcpa_dj_stc_kms_boundary_iff : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (mD : ℕ)
    (Dc : Fin mD → Set S) (j : Fin m) (p₀ : S) (n : ℕ) (t : Fin n → S.presheaf.stalk (g (τ j p₀)))
    (e : {i // g (τ j p₀) ∈ Dc i} → Fin n) (J : Finset (Fin n)) (z : Y.presheaf.stalk (τ j p₀)),
    IsSeparated g → (∀ j', τ j' ≫ g = 𝟙 S) → (∀ i, IsClosed (Dc i)) →
    (∀ i j' (p q : S), i ≠ j' → τ i p ≠ τ j' q) →
    (∀ (i : {i // g (τ j p₀) ∈ Dc i}) (p' : S) (h : p' ⤳ g (τ j p₀)),
      p' ∈ Dc i ↔ (S.presheaf.stalkSpecializes h).hom (t (e i)) ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk p')) →
    (∀ l, l ∈ J ↔ ∃ i, e i = l) →
    (∀ (y' : Y) (h : y' ⤳ τ j p₀), y' ∈ Set.range ⇑(τ j) ↔
      (Y.presheaf.stalkSpecializes h).hom z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y')) →
    (∀ (p' : S) (h : p' ⤳ g (τ j p₀)), p' ∈ ⋃ i, Dc i ↔ ∃ l ∈ J,
      (S.presheaf.stalkSpecializes h).hom (t l) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p')) ∧
    ∀ (w : Y) (h : w ⤳ τ j p₀),
      (g w ∈ ⋃ i, Dc i ↔ ∃ l ∈ J, (Y.presheaf.stalkSpecializes h).hom
          ((g.stalkMap (τ j p₀)).hom (t l)) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w)) ∧
      (w ∈ ⋃ j', Set.range ⇑(τ j') ↔
        (Y.presheaf.stalkSpecializes h).hom z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w)) :=
by
  intro S Y g m τ mD Dc j p₀ n t e J z hsep hτ hcl hdisj h5 hJ h7
  have C1 : ∀ (p' : S) (h : p' ⤳ g (τ j p₀)), p' ∈ ⋃ i, Dc i ↔ ∃ l ∈ J,
      (S.presheaf.stalkSpecializes h).hom (t l) ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk p') := by
    intro p' h
    constructor
    · intro hp
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hp
      have hs : g (τ j p₀) ∈ Dc i := h.mem_closed (hcl i) hi
      exact ⟨e ⟨i, hs⟩, (hJ _).mpr ⟨⟨i, hs⟩, rfl⟩, (h5 ⟨i, hs⟩ p' h).mp hi⟩
    · rintro ⟨l, hl, hm⟩
      obtain ⟨i', rfl⟩ := (hJ l).mp hl
      exact Set.mem_iUnion.mpr ⟨i'.val, (h5 i' p' h).mpr hm⟩
  refine ⟨C1, fun w h => ⟨?_, ?_⟩⟩
  · have h' : g w ⤳ g (τ j p₀) := h.map g.continuous
    rw [C1 (g w) h']
    apply exists_congr
    intro l
    apply and_congr_right
    intro _
    have key : (Y.presheaf.stalkSpecializes h).hom ((g.stalkMap (τ j p₀)).hom (t l)) =
        (g.stalkMap w).hom ((S.presheaf.stalkSpecializes h').hom (t l)) :=
      (g.stalkSpecializes_stalkMap_apply w (τ j p₀) h (t l)).symm
    rw [key, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact (map_mem_nonunits_iff (g.stalkMap w).hom _).symm
  · constructor
    · intro hw
      obtain ⟨j', hj'⟩ := Set.mem_iUnion.mp hw
      have := hsep
      have : IsClosedImmersion (τ j' ≫ g) := by rw [hτ j']; infer_instance
      have : IsClosedImmersion (τ j') := IsClosedImmersion.of_comp (τ j') g
      have hclosed : IsClosed (Set.range ⇑(τ j')) := (τ j').isClosedEmbedding.isClosed_range
      obtain ⟨q, hq⟩ := h.mem_closed hclosed hj'
      by_cases hjj : j' = j
      · subst hjj
        exact (h7 w h).mp hj'
      · exact absurd hq (hdisj j' j q p₀ hjj)
    · intro hm
      exact Set.mem_iUnion.mpr ⟨j, (h7 w h).mpr hm⟩

theorem wcpa_dj_stc_kms_boundary_basic : ∀ (k : Type u) [Field k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    Flat g → IsProper g →
    (∀ j, τ j ≫ g = 𝟙 S) → (∀ i j (p q : S), i ≠ j → τ i p ≠ τ j q) →
    (∀ j (p : S), ∃ W : Y.Opens, τ j p ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) →
    (∀ i, IsClosed (Dc i)) → (∃ p₀ : S, ∀ i, p₀ ∉ Dc i) →
    (W : Set S)ᶜ ⊆ ⋃ i, Dc i → g ⁻¹ᵁ W ≤ O →
    (∀ c, (∃ i ∈ I, a c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
      O.ι c ∈ (⋃ j, Set.range ⇑(τ j)) ∪ ⇑g ⁻¹' ((W : Set S)ᶜ)) →
    IsClosed (⇑g ⁻¹' (⋃ i, Dc i) ∪ ⋃ j, Set.range ⇑(τ j)) ∧
    genericPoint Y ∉ (⇑g ⁻¹' (⋃ i, Dc i) ∪ ⋃ j, Set.range ⇑(τ j)) ∧
    ∀ w : Y, w ∉ (⇑g ⁻¹' (⋃ i, Dc i) ∪ ⋃ j, Set.range ⇑(τ j)) →
      ∃ hw : w ∈ O, ∀ i ∈ I, a ⟨w, hw⟩ ∈ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
          (MvPolynomial.X i) :=
by
  intro k _ S Y _ _ g m τ W mD Dc N I O a hflat hprop hτg hdisj hτsm hDc hp₀ hWD hO hC2
  have hDcl : IsClosed (⋃ i, Dc i) := isClosed_iUnion_of_finite hDc
  have hDne : (⋃ i, Dc i) ≠ Set.univ := by
    obtain ⟨p₀, hp⟩ := hp₀
    intro h
    have hmem : p₀ ∈ ⋃ i, Dc i := by rw [h]; exact Set.mem_univ _
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hmem
    exact hp i hi
  have hsec : wcpaDjSections g m τ := ⟨hτg, hdisj, hτsm⟩
  obtain ⟨hcl, hη⟩ := wcpa_dj_ts_boundary S Y g m τ (⋃ i, Dc i) hflat hprop hsec hDcl hDne
  refine ⟨hcl, hη, ?_⟩
  intro w hw
  have hgD : g w ∉ ⋃ i, Dc i := fun h => hw (Set.mem_union_left _ h)
  have hgW : g w ∈ (W : Set S) := by
    by_contra h
    exact hgD (hWD h)
  have hwO : w ∈ O := hO (show w ∈ g ⁻¹ᵁ W from hgW)
  refine ⟨hwO, ?_⟩
  intro i hi
  by_contra h
  have h2 := hC2 ⟨w, hwO⟩ ⟨i, hi, h⟩
  have e : O.ι ⟨w, hwO⟩ = w := rfl
  rw [e] at h2
  rcases h2 with h3 | h3
  · exact hw (Set.mem_union_right _ h3)
  · exact h3 hgW

theorem wcpa_dj_stc_km_base_section : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjStcKmHyp k S Y sS g m τ W mD Dc N I O a →
    ∃ B₂ : ℕ, ∀ i₀ ∈ I, ∀ y : Y, y ∈ ⋃ j, Set.range ⇑(τ j) →
      ∀ (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (e : {i // g y ∈ Dc i} → Fin n)
        (J : Finset (Fin n)),
        wcpaDjStcSNCSys S mD Dc (g y) n t e → (∀ l, l ∈ J ↔ ∃ i, e i = l) →
