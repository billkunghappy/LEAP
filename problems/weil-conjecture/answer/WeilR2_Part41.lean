  choose τ hτ1 hτ2 using key
  have HR : ∀ i j (Z : Scheme.{u})
      (z : Z ⟶ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j : (wcpaBscChart D i).Opens) : Scheme.{u}))
