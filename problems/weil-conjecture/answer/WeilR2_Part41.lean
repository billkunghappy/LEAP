    obtain ⟨σ, hσinj, hσ⟩ := wcpa_dj_nccw_walk (⇑q ⁻¹' {zk}) (nccwC (q ≫ ν ≫ u))
      (nccwXs u ν q st zk) Φ D Tg d e partner
      (fun L hL hLF => ⟨hL.1, hL.2.1, hLF, Or.inl hL⟩)
