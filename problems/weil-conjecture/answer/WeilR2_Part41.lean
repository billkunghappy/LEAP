    have hdet := congrArg Matrix.det (hF (Pi.single k 1))
    rw [Matrix.det_mul, hdetD, Matrix.det_fromBlocks_zero₁₂, Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, Matrix.det_one,
      mul_one, one_mul, Matrix.det_neg, Fintype.card_fin, hz, eS, eS', hBE, hBE] at hdet
    have hsum' : ∑ l, (Pi.single k (1 : B) : Fin (p + 1) → B) l * ((-1) ^ (l : ℕ) * (G'.submatrix id l.succAbove).det) = (-1) ^ (k : ℕ) * (G'.submatrix id k.succAbove).det := by
      rw [Finset.sum_eq_single k]
