    have hsp : S.fromSpecStalk w q ⤳ w := by
      have h : S.fromSpecStalk w q ∈ Set.range (S.fromSpecStalk w) := ⟨q, rfl⟩
      rwa [Scheme.range_fromSpecStalk] at h
    refine ⟨hsp, fun a => ?_⟩
