    apply IsFractionRing.injective (Y.presheaf.stalk w) Y.functionField
    rw [map_mul, map_mul, key, key, h1, h2]
    ring
  have hC6 : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (ι : Type) [Finite ι] (φ : ι → Y.functionField),
      (∀ p, φ p ≠ 0) → ∀ (Pts : Set Y), Pts.Finite →
      (∀ w ∈ Pts, IsNoetherianRing (Y.presheaf.stalk w)) →
      ∃ B : ℕ, ∀ p, ∀ w ∈ Pts, ∃ num den : Y.presheaf.stalk w,
