  have hs1 : ∀ i, s i ≫ (u ∣_ U₁) = 𝟙 _ := fun i => hR.lift_fst _ _ _
  have hs2 : ∀ i, s i ≫ (u ⁻¹ᵁ U₁).ι = U₁.ι ≫ τ i := fun i => hR.lift_snd _ _ _
  have hs3 : ∀ i, s i ≫ κ = ι₁ ≫ sw i := by
