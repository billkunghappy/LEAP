        rw [(hH1 x).1] at hz0
        rw [(hH1 x').1] at hz1
        have e0 : q' z = w x := hz0
        have e1 : q' z = w x' := hz1
        exact e0.symm.trans e1)
    obtain ⟨hExfin, hExcard⟩ := wcpa_dj_nccw_exit_bound R Z Z' Y G S S' N u u' n τ τ' π a a' h ι
      j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
    have hcard : Nat.card Hp ≤ 2 := by
      haveI := hExfin.to_subtype
      have h1 := Nat.card_le_card_of_injective
        (fun x => (⟨σ x, hσ x⟩ : ↥(nccwEx u ν q st zk)))
        (fun x y hxy => hσinj (congrArg Subtype.val hxy))
      rw [Nat.card_coe_set_eq] at h1
      omega
    rw [Set.Finite.coe_toFinset]
    have hle : ∀ X ∈ h𝓔fin.toFinset,
        (X ∩ closure Xᶜ).ncard +
          Nat.card { i // ∃ x ∈ X, ∃ p,
            (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x =
              (τ' i) ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) p) } +
