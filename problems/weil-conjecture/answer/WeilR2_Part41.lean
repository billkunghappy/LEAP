    have hPmin : Minimal (fun q : Ideal A => q.IsPrime ∧ ⊥ ≤ q) P := hP
    have hPp : P.IsPrime := hPmin.1.1
    have h0 : (0 : A) ∈ P.primeCompl ⊔ Submonoid.powers a := by
      by_contra hcon
      have hdisj : Disjoint (↑(⊥ : Ideal A)) (↑(P.primeCompl ⊔ Submonoid.powers a) : Set A) := by
        rw [Set.disjoint_left]
        intro y hy hyS
        have : y = 0 := hy
        subst this
        exact hcon hyS
