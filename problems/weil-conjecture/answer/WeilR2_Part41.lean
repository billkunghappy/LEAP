      (∀ a b, IsAffineOpen (L.V a ⊓ L.V b)) → ∀ d : ℕ, ∃ c : ℕ,
      ∀ x : ∀ a : Fin L.m, Γ(X, L.V a), wcpaDjCompatMod h L (I ^ (c + 1)) d x →
      ∃ s : ∀ a : Fin L.m, Γ(X, L.V a), wcpaDjCompatMod h L ⊥ d s ∧
