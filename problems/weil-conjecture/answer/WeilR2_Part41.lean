      nccwF2 (nccwKF (q ≫ ν ≫ u) q zk) ∧ nccwF1 R (q ≫ ν ≫ u) q zk :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hzk
    M _ _ ψ ρ hρ e he hFO
  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hp, hu, -, -⟩ := hH
  obtain ⟨-, -, -, -, -, -, ⟨hνzk, -⟩, -, -, -, ⟨-, -, -, hmaxN, -⟩, -⟩ := hS

  have hFB : ⇑q ⁻¹' {zk} ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} := by
    intro y hy
    have hy' : q y = zk := hy
    show (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hy', hνzk, hp]
    exact hu

  obtain ⟨hg, φ, hφ, hsq⟩ := nccwfd_residue_square R S zk (ν ≫ u) M ψ ρ hρ e he

  obtain ⟨W, aW, bW, cW, haW, hcW, hac, hpb, hra, hrc⟩ :=
    nccwfd_fibre_immersions N S q zk hzk M (nccwffG zk e) φ hφ hsq
  haveI := haW
  haveI := hcW

