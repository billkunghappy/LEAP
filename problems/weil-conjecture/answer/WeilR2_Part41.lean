    exact hc
  have transport : ∀ (O O' : Type u) [CommRing O] [CommRing O'] (I : Ideal O) (J : Ideal O')
      (φ : O ≃+* O'), J = Ideal.map φ I →
      Nonempty (AdicCompletion I O ≃+* AdicCompletion J O') := by
    intro O O' _ _ I J φ hJ
    have hJn : ∀ n : ℕ, J ^ n = Ideal.map φ (I ^ n) := fun n => by rw [Ideal.map_pow, hJ]
    have hIn : ∀ n : ℕ, I ^ n = Ideal.map φ.symm (J ^ n) := fun n => by
      rw [hJn]
      ext x
      rw [Ideal.map_symm, Ideal.mem_comap, Ideal.mem_map_of_equiv]
      constructor
      · intro hx; exact ⟨x, hx, rfl⟩
      · rintro ⟨y, hy, hxy⟩; rw [← φ.injective hxy]; exact hy
    let qq : ∀ n : ℕ, O ⧸ I ^ n ≃+* O' ⧸ J ^ n := fun n => Ideal.quotientEquiv _ _ φ (hJn n)
    let qq' : ∀ n : ℕ, O' ⧸ J ^ n ≃+* O ⧸ I ^ n := fun n =>
      Ideal.quotientEquiv _ _ φ.symm (hIn n)
    have hq : ∀ n x, qq n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ x) := fun n x =>
      Ideal.quotientEquiv_mk _ _ _ _ _
    have hq' : ∀ n x, qq' n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ.symm x) :=
      fun n x => Ideal.quotientEquiv_mk _ _ _ _ _
    have hF : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp
        ((qq n).toRingHom.comp (AdicCompletion.evalₐ I n).toRingHom) =
        (qq m).toRingHom.comp (AdicCompletion.evalₐ I m).toRingHom := by
      intro m n hle
      rw [← factorPow_evalₐ O I hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
      congr 1
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq,
        Ideal.Quotient.factor_mk]
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp
        ((qq' n).toRingHom.comp (AdicCompletion.evalₐ J n).toRingHom) =
        (qq' m).toRingHom.comp (AdicCompletion.evalₐ J m).toRingHom := by
      intro m n hle
      rw [← factorPow_evalₐ O' J hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
      congr 1
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq',
        Ideal.Quotient.factor_mk]
    let F := AdicCompletion.liftRingHom J _ hF
    let G := AdicCompletion.liftRingHom I _ hG
    have hFe : ∀ n x, AdicCompletion.evalₐ J n (F x) = qq n (AdicCompletion.evalₐ I n x) :=
      fun n x => AdicCompletion.evalₐ_liftRingHom J _ hF n x
    have hGe : ∀ n x, AdicCompletion.evalₐ I n (G x) = qq' n (AdicCompletion.evalₐ J n x) :=
      fun n x => AdicCompletion.evalₐ_liftRingHom I _ hG n x
    have hqq : ∀ n y, qq' n (qq n y) = y := by
      intro n y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hq, hq', RingEquiv.symm_apply_apply]
    have hqq' : ∀ n y, qq n (qq' n y) = y := by
      intro n y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hq', hq, RingEquiv.apply_symm_apply]
    refine ⟨RingEquiv.ofRingHom F G ?_ ?_⟩
    · refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hFe, hGe, hqq']
    · refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hGe, hFe, hqq]
  obtain ⟨-, -, -, -, hS⟩ := hA
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, ⟨hP12', -⟩⟩ := hS
  obtain ⟨w, hw, hiso⟩ := hP12' x' hdom hic
  have hwx : ν' w = x' := (hw w).mpr rfl
  refine ⟨w, hw, ?_, ?_, ?_⟩
  · apply isClosed_of_closure_subset
    intro w' hw'
    have hsp : w ⤳ w' := specializes_iff_mem_closure.mpr hw'
    have hsp' : ν' w ⤳ ν' w' := hsp.map ν'.continuous
    rw [hwx] at hsp'
    have hm : ν' w' ∈ ({x'} : Set Z') := hsp'.mem_closed hcl (Set.mem_singleton x')
    exact Set.mem_singleton_iff.mpr ((hw w').mp (Set.mem_singleton_iff.mp hm))
  · rw [Scheme.Hom.comp_apply, hwx]
    exact hu
  · subst hwx
    let φ := (asIso (ν'.stalkMap w)).commRingCatIsoToRingEquiv
    obtain ⟨Φ⟩ := transport _ _ (IsLocalRing.maximalIdeal _) (IsLocalRing.maximalIdeal _) φ
      (IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv φ)).symm
    exact MulEquiv.isDomain _ Φ.symm.toMulEquiv

theorem wcpa_dj_nccw_hp_strict_meets : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∀ x ∈ X, ∃ y ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X, ν' (q' y) = Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x :=
by
  classical
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA X hX x hx
  obtain ⟨hcomp, halg, hPr, hH, hS⟩ := hA
  have hst' := hH.2.2.1
  obtain ⟨-, ⟨-, hν'fin, -, -, -, -⟩, -, -, ⟨-, hq'p⟩, -, -, hQ8, -⟩ := hS
  haveI := hν'fin
  haveI := hq'p
  obtain ⟨hemb, hrange, hnoeth, hgen, hcompo⟩ :=
    wcpa_dj_nccw_special_fibre_topology R Z' u' hst'.1.2.1
  obtain ⟨x₀, rfl, hmax⟩ := hgen X hX
  have hxu : u' (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x₀) =
      IsLocalRing.closedPoint R := by
    have hx' : Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x₀ ∈
        Set.range ⇑(Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) :=
      ⟨x₀, rfl⟩
    rw [hrange] at hx'
    exact hx'
  have hDt : nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η
        (closure {x₀}) =
      closure {η (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x₀)} := by
    have hX' : ∃ y, closure {y} = closure {x₀} := ⟨x₀, rfl⟩
    unfold nccwDt
    rw [dif_pos hX', (inseparable_iff_closure_eq.mpr hX'.choose_spec).eq]
  have f1 := (hQ8 _ hxu hmax).2.1
  rw [hDt]
  set ξ := Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x₀ with hξ
  have hcm : IsClosedMap (q' ≫ ν').base := (q' ≫ ν').isClosedMap
  have hK : IsClosed ((q' ≫ ν').base '' closure {η ξ}) := hcm _ isClosed_closure
  have hξK : ξ ∈ (q' ≫ ν').base '' closure {η ξ} :=
    ⟨η ξ, subset_closure (Set.mem_singleton _), by rw [Scheme.Hom.comp_apply]; exact f1⟩
  have hsub : closure {ξ} ⊆ (q' ≫ ν').base '' closure {η ξ} :=
    closure_minimal (Set.singleton_subset_iff.mpr hξK) hK
  have hsp : x₀ ⤳ x := specializes_iff_mem_closure.mpr hx
  have hsp' : ξ ⤳ Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x :=
    hsp.map (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).continuous
  obtain ⟨y, hy, hfy⟩ := hsub (specializes_iff_mem_closure.mp hsp')
  refine ⟨y, hy, ?_⟩
  rw [Scheme.Hom.comp_apply] at hfy
  exact hfy

theorem wcpa_dj_nccw_gnh_sigma_stalkMap : ∀ (R : Type u) [CommRing R] (X Y : Scheme.{u}) (f : X ⟶ Y) (h : Y ⟶ Spec (.of R)) (x : X), (f.stalkMap x).hom.comp ((Y.presheaf.germ ⊤ (f x) trivial).hom.comp (wcCnSigma h ⊤)) = (X.presheaf.germ ⊤ x trivial).hom.comp (wcCnSigma (f ≫ h) ⊤) :=
by
  intro R _ X Y f h x
  ext r
  have e1 : (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
  have e2 : (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
  have key := Scheme.Hom.germ_stalkMap_apply f ⊤ x trivial
    (h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))
  simp only [wcCnSigma, RingHom.comp_apply, e1, e2, op_id, CategoryTheory.Functor.map_id,
    CommRingCat.id_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
  exact key

theorem wcpa_dj_nccw_gnts_special_generization : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ w : S', IsClosed ({w} : Set S') → (ν' ≫ u') w = IsLocalRing.closedPoint R → ∃ s s' : S', s' ⤳ s ∧ s ⤳ w ∧ s ≠ w ∧ (ν' ≫ u') s = IsLocalRing.closedPoint R ∧ (ν' ≫ u') s' ≠ IsLocalRing.closedPoint R :=
by

  have c1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X : Scheme.{u})
      (f : X ⟶ Spec (.of R)), Flat f → ∀ x : X, f x = IsLocalRing.closedPoint R →
      ∃ x' : X, x' ⤳ x ∧ f x' ≠ IsLocalRing.closedPoint R := by
    intro R _ _ _ X f hf x hx
    haveI := hf
    have hgen : GeneralizingMap ⇑f := Flat.generalizingMap f
    let ηR : Spec (.of R) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R)
    have hηsp : ηR ⤳ f x := by
      rw [hx]
      exact (PrimeSpectrum.le_iff_specializes _ _).mp
        (show (⊥ : Ideal R) ≤ IsLocalRing.maximalIdeal R from bot_le)
    obtain ⟨x', hx'x, hx'η⟩ := hgen hηsp
    refine ⟨x', hx'x, ?_⟩
    rw [hx'η]
    intro heq
    have h2 := congrArg PrimeSpectrum.asIdeal heq
    exact IsDiscreteValuationRing.not_a_field R h2.symm

  have c2 : ∀ (A B T : Type u) [CommRing A] [IsDomain A] [ValuationRing A] [CommRing B]
      [CommRing T] [IsDomain T] (φ : A →+* B), IsLocalHom φ → ∀ κ : B →+* T,
      Function.Injective κ → Function.Injective (κ.comp φ) →
      (∀ t : T, ∃ a b : A, b ≠ 0 ∧ κ (φ b) * t = κ (φ a)) → Function.Surjective φ := by
    intro A B T _ _ _ _ _ _ φ hφ κ hκ hθ hfr β
    obtain ⟨a, b, hb, hab⟩ := hfr (κ β)
    have hθ0 : ∀ x : A, x ≠ 0 → κ (φ x) ≠ 0 := by
      intro x hx h0
      apply hx
      apply hθ
      simp only [RingHom.comp_apply, map_zero]
      exact h0
    have key : b ∣ a → ∃ c, φ c = β := by
      rintro ⟨c, rfl⟩
      refine ⟨c, ?_⟩
      apply hκ
      have h1 : κ (φ b) * (κ β - κ (φ c)) = 0 := by
        rw [mul_sub, hab, map_mul, map_mul, sub_self]
      rcases mul_eq_zero.mp h1 with h | h
      · exact absurd h (hθ0 b hb)
      · exact (sub_eq_zero.mp h).symm
    rcases ValuationRing.dvd_total b a with h | h
    · exact key h
    · obtain ⟨m, rfl⟩ := h
      have ha : a ≠ 0 := by rintro rfl; exact hb (zero_mul m)
      have h1 : κ (φ a) * (κ (φ m) * κ β - 1) = 0 := by
        rw [mul_sub, ← mul_assoc, ← map_mul κ, ← map_mul φ, hab, mul_one, sub_self]
      have h2 : κ (φ m * β) = κ 1 := by
        rcases mul_eq_zero.mp h1 with h | h
        · exact absurd h (hθ0 a ha)
        · rw [map_mul, map_one]; exact sub_eq_zero.mp h
      have h3 : φ m * β = 1 := hκ h2
      have hu : IsUnit (φ m) := isUnit_iff_exists_inv.mpr ⟨β, h3⟩
      have hmu : IsUnit m := (isUnit_map_iff φ m).mp hu
      apply key
      obtain ⟨v, hv⟩ := hmu
      refine ⟨↑v⁻¹, ?_⟩
      rw [← hv, mul_assoc, Units.mul_inv, mul_one]

  have c3 : ∀ (R : Type u) [CommRing R] (S : Scheme.{u}) (g : S ⟶ Spec (.of R)) (w : S)
      (Q : Spec (S.presheaf.stalk w)), (g (S.fromSpecStalk w Q)).asIdeal =
      Ideal.comap ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)) Q.asIdeal := by
    intro R _ S g w Q
    have hcomp : S.fromSpecStalk w ≫ g = Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫
        S.presheaf.germ ⊤ w trivial) := by
      calc S.fromSpecStalk w ≫ g
          = S.fromSpecStalk w ≫ g ≫ (Spec (.of R)).toSpecΓ ≫
              Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
            rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        _ = S.fromSpecStalk w ≫ S.toSpecΓ ≫ Spec.map g.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
            rw [Scheme.toSpecΓ_naturality_assoc]
        _ = Spec.map (S.presheaf.germ ⊤ w trivial) ≫ Spec.map g.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
            rw [Scheme.fromSpecStalk_toSpecΓ_assoc]
        _ = _ := by
            rw [Spec.map_comp, Spec.map_comp, Category.assoc]
    have h1 : g (S.fromSpecStalk w Q) = (Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫
        S.presheaf.germ ⊤ w trivial)) Q := by
      rw [← hcomp]
      rfl
    have hres : S.presheaf.map (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op ≫
        S.presheaf.germ ⊤ w trivial = S.presheaf.germ ⊤ w trivial :=
      TopCat.Presheaf.germ_res _ _ _ _
    have hσφ : ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫ S.presheaf.germ ⊤ w trivial).hom =
        (S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤) := by
      ext r
      have := congrArg (fun f => f.hom (g.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))) hres
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      simp only [wcCnSigma, CommRingCat.hom_comp, RingHom.comp_apply]
      exact this.symm
    rw [h1, Spec.map_apply]
    exact congrArg (fun f => Ideal.comap f (PrimeSpectrum.asIdeal Q)) hσφ

  have c4 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V : Y.Opens), IsIso (f ∣_ V) → ∀ x : X,
      f x ∈ V → IsIso (f.stalkMap x) := by
    intro X Y f V hV x hx
    haveI := hV
    let x' : (f ⁻¹ᵁ V : X.Opens) := ⟨x, hx⟩
    have e := morphismRestrictStalkMap f V x'
    haveI : IsOpenImmersion (f ∣_ V) := inferInstance
    have : IsIso ((f ∣_ V).stalkMap x') := IsOpenImmersion.instIsIsoCommRingCatStalkMap (f ∣_ V) x'
    exact ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff e).mp this

  have e1 : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z),
      letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk x)
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
          (X.presheaf.stalkSpecializes h).hom) := by
    intro X x z h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
        have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
        have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
        have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
          exact Ideal.mem_map_of_mem _ haQ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
      haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
      show IsLocalization _ S
      refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        show φ (gR a) ∉ IsLocalRing.maximalIdeal S
        rw [hc a]
        exact IsLocalRing.notMem_maximalIdeal.mpr
          (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
      · intro r hr
        exact IsLocalRing.notMem_maximalIdeal.mp hr
    obtain ⟨W, hW, hzW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
    have hxW : x ∈ W := h.mem_open W.isOpen hzW
    have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
    have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
    have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z hzW).hom =
        (X.presheaf.germ W x hxW).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
    exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx

  have c5 : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z),
      (IsDomain (X.presheaf.stalk z) → Function.Injective (X.presheaf.stalkSpecializes h).hom) ∧
      ∀ c : X.presheaf.stalk x, ∃ a b : X.presheaf.stalk z, b ≠ 0 ∧
        (X.presheaf.stalkSpecializes h).hom b * c = (X.presheaf.stalkSpecializes h).hom a := by
    intro X x z h
    letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
    have hL := e1 X x z h
    set p := (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
      (X.presheaf.stalkSpecializes h).hom with hp
    have halg : algebraMap (X.presheaf.stalk z) (X.presheaf.stalk x) =
        (X.presheaf.stalkSpecializes h).hom :=
      RingHom.algebraMap_toAlgebra _
    constructor
    · intro hdom
      have hM : p.primeCompl ≤ nonZeroDivisors (X.presheaf.stalk z) :=
        le_nonZeroDivisors_of_noZeroDivisors (fun h0 => h0 p.zero_mem)
      have := IsLocalization.injective (M := p.primeCompl) (X.presheaf.stalk x) hM
      rwa [halg] at this
    · intro c
      obtain ⟨⟨a, ⟨b, hb⟩⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl c
      refine ⟨a, b, fun h0 => hb (h0 ▸ p.zero_mem), ?_⟩
      have := IsLocalization.mk'_spec (X.presheaf.stalk x) a ⟨b, hb⟩
      rw [halg] at this
      rw [mul_comm]
      exact this

  have c6 : ∀ (X : Type u) [TopologicalSpace X] (Z : Set X) (x : X), IsClosed Z → x ∈ Z →
      ∃ L : Set X, IsClosed L ∧ IsIrreducible L ∧ x ∈ L ∧ L ⊆ Z ∧
        ∀ L' : Set X, IsIrreducible L' → L ⊆ L' → L' ⊆ Z → L' = L := by
    intro X _ Z x hZ hx
    let C : Set Z := irreducibleComponent (⟨x, hx⟩ : Z)
    have hCc : IsClosed C := isClosed_irreducibleComponent
    have hCi : IsIrreducible C := isIrreducible_irreducibleComponent
    refine ⟨Subtype.val '' C, (hZ.isClosedEmbedding_subtypeVal).isClosedMap _ hCc,
      hCi.image _ continuous_subtype_val.continuousOn, ⟨⟨x, hx⟩, mem_irreducibleComponent, rfl⟩,
      by rintro _ ⟨y, -, rfl⟩; exact y.2, ?_⟩
    intro L' hL' hLL' hL'Z
    let C' : Set Z := Subtype.val ⁻¹' L'
    have hCC' : C ⊆ C' := fun y hy => hLL' ⟨y, hy, rfl⟩
    have hC'pre : IsPreirreducible C' := by
      intro U' V' hU' hV' ⟨p, hpC, hpU⟩ ⟨r, hrC, hrV⟩
      obtain ⟨U, hU, rfl⟩ := isOpen_induced_iff.mp hU'
      obtain ⟨V, hV, rfl⟩ := isOpen_induced_iff.mp hV'
      obtain ⟨z, hzL, hzU, hzV⟩ := hL'.2 U V hU hV ⟨p.1, hpC, hpU⟩ ⟨r.1, hrC, hrV⟩
      exact ⟨⟨z, hL'Z hzL⟩, hzL, hzU, hzV⟩
    have hEq : C' = C := eq_irreducibleComponent hC'pre hCC'
    apply Set.Subset.antisymm
    · intro z hz
      exact ⟨⟨z, hL'Z hz⟩, (hEq ▸ (show (⟨z, hL'Z hz⟩ : Z) ∈ C' from hz)), rfl⟩
    · exact hLL'

  have c7 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (S : Scheme.{u})
      [IsLocallyNoetherian S] (g : S ⟶ Spec (.of R)) (w : S) [IsDomain (S.presheaf.stalk w)],
      IsIntegrallyClosed (S.presheaf.stalk w) → g w = IsLocalRing.closedPoint R →
      (∀ t : S, t ⤳ w → g t = IsLocalRing.closedPoint R → t = w) →
      (∃ s₁ : S, s₁ ⤳ w ∧ g s₁ ≠ IsLocalRing.closedPoint R) →
      IsDiscreteValuationRing (S.presheaf.stalk w) := by
    intro R _ _ _ S _ g w _ hic hw hH hs1
    have PF := c3 R S g w
    have hi : ∀ Q : Ideal (S.presheaf.stalk w), Q.IsPrime →
        Q.comap ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)) =
          IsLocalRing.maximalIdeal R →
        Q = IsLocalRing.maximalIdeal (S.presheaf.stalk w) := by
      intro Q hQ hc
      let P : Spec (S.presheaf.stalk w) := (⟨Q, hQ⟩ : PrimeSpectrum (S.presheaf.stalk w))
      have h1 : g (S.fromSpecStalk w P) = IsLocalRing.closedPoint R := by
        apply PrimeSpectrum.ext
        rw [PF]
        exact hc
      have h2 : S.fromSpecStalk w P ⤳ w := by
        have : S.fromSpecStalk w P ∈ Set.range ⇑(S.fromSpecStalk w) := ⟨P, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      have h3 := hH _ h2 h1
      have h4 : P = IsLocalRing.closedPoint (S.presheaf.stalk w) :=
        (S.fromSpecStalk w).isEmbedding.injective (h3.trans Scheme.fromSpecStalk_closedPoint.symm)
      exact congrArg PrimeSpectrum.asIdeal h4
    have hmR : (IsLocalRing.maximalIdeal (S.presheaf.stalk w)).comap
        ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)) =
          IsLocalRing.maximalIdeal R := by
      have := PF (IsLocalRing.closedPoint _)
      rw [Scheme.fromSpecStalk_closedPoint, hw] at this
      exact this.symm
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hϖm : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hϖmem : ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)) ϖ ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk w) := by
      have : ϖ ∈ IsLocalRing.maximalIdeal R := hϖm ▸ Ideal.mem_span_singleton_self ϖ
      rw [← hmR] at this
      exact this
    have hmin : IsLocalRing.maximalIdeal (S.presheaf.stalk w) ∈
        (Ideal.span {((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)) ϖ}).minimalPrimes := by
      refine ⟨⟨(IsLocalRing.maximalIdeal.isMaximal _).isPrime, ?_⟩, ?_⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hϖmem
      · rintro Q ⟨hQ, hQle⟩ -
        haveI := hQ
        have hcQ : Q.comap ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤)) =
            IsLocalRing.maximalIdeal R := by
          symm
          apply Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal R)
            (inferInstance : (Q.comap ((S.presheaf.germ ⊤ w trivial).hom.comp
              (wcCnSigma g ⊤))).IsPrime).ne_top
          rw [hϖm, Ideal.span_le, Set.singleton_subset_iff]
          exact hQle (Ideal.mem_span_singleton_self _)
        exact (hi Q hQ hcQ).ge
    have hht : (IsLocalRing.maximalIdeal (S.presheaf.stalk w)).height ≤ 1 :=
      Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _ hmin
    have hbot : ∀ Q : Ideal (S.presheaf.stalk w), Q.IsPrime →
        Q ≠ IsLocalRing.maximalIdeal (S.presheaf.stalk w) → Q = ⊥ := by
      intro Q hQ hne
      haveI := hQ
      have hlt : Q < IsLocalRing.maximalIdeal (S.presheaf.stalk w) :=
        lt_of_le_of_ne (IsLocalRing.le_maximalIdeal hQ.ne_top) hne
      have h1 : Q.height < ((1 : ℕ) : ℕ∞) :=
        ((Ideal.height_le_iff (n := 1)).mp (by exact_mod_cast hht)) Q hQ hlt
      have h2 : Q.height = 0 := ENat.lt_one_iff_eq_zero.mp (by exact_mod_cast h1)
      have h3 : Q ∈ minimalPrimes (S.presheaf.stalk w) := Ideal.height_eq_zero_iff.mp h2
      exact le_bot_iff.mp (h3.2 ⟨Ideal.isPrime_bot, le_rfl⟩ bot_le)
    have hnf : ¬ IsField (S.presheaf.stalk w) := by
      obtain ⟨s₁, hs1w, hs1g⟩ := hs1
      have hs1R : s₁ ∈ Set.range ⇑(S.fromSpecStalk w) := by
        rw [Scheme.range_fromSpecStalk]; exact hs1w
      obtain ⟨P₁, hP₁⟩ := hs1R
      have hP₁ne : P₁.asIdeal ≠ IsLocalRing.maximalIdeal (S.presheaf.stalk w) := by
        intro heq
        apply hs1g
        have : P₁ = IsLocalRing.closedPoint (S.presheaf.stalk w) := PrimeSpectrum.ext heq
        rw [← hP₁, this, Scheme.fromSpecStalk_closedPoint, hw]
      intro hf
      have hm0 : IsLocalRing.maximalIdeal (S.presheaf.stalk w) = ⊥ :=
        (IsLocalRing.isField_iff_maximalIdeal_eq).mp hf
      apply hP₁ne
      have := IsLocalRing.le_maximalIdeal P₁.isPrime.ne_top
      rw [hm0] at this ⊢
      exact le_bot_iff.mp this
    have hmne : IsLocalRing.maximalIdeal (S.presheaf.stalk w) ≠ ⊥ := fun h =>
      hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
    have h4 : IsIntegrallyClosed (S.presheaf.stalk w) ∧
        ∃! P : Ideal (S.presheaf.stalk w), P ≠ ⊥ ∧ P.IsPrime := by
      refine ⟨hic, IsLocalRing.maximalIdeal _,
        ⟨hmne, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩, ?_⟩
      rintro P ⟨hP0, hPp⟩
      by_contra hne
      exact hP0 (hbot P hPp hne)
    exact ((IsDiscreteValuationRing.TFAE (S.presheaf.stalk w) hnf).out 4 1).mp h4

  have c8 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (S N : Scheme.{u})
      (g : S ⟶ Spec (.of R)) (q : N ⟶ S) (gN : N ⟶ Spec (.of R)), q ≫ g = gN →
      IsClosedMap ⇑q → ∀ V : S.Opens, (∀ s : S, g s ≠ IsLocalRing.closedPoint R → s ∈ V) →
      IsIso (q ∣_ V) →
      (∀ L : Set N, IsClosed L → IsIrreducible L → L ⊆ ⇑gN ⁻¹' {IsLocalRing.closedPoint R} →
        (∀ L' : Set N, IsIrreducible L' → L ⊆ L' →
          L' ⊆ ⇑gN ⁻¹' {IsLocalRing.closedPoint R} → L' = L) → L.Nontrivial) →
      ∀ w : S, IsClosed ({w} : Set S) → g w = IsLocalRing.closedPoint R →
      (∃ s₁ : S, s₁ ⤳ w ∧ g s₁ ≠ IsLocalRing.closedPoint R) →
      ∃ e ε : N, q e = w ∧ ε ⤳ e ∧ ε ≠ e ∧ g (q ε) = IsLocalRing.closedPoint R := by
    intro R _ _ _ S N g q gN hqg hqc V hV hVi hP10 w hwc hw hs1
    obtain ⟨s₁, hs1w, hs1g⟩ := hs1
    haveI := hVi
    obtain ⟨y0, hy0⟩ := (q ∣_ V).surjective ⟨s₁, hV s₁ hs1g⟩
    have e1 : V.ι ((q ∣_ V) y0) = q y0.1 := by
      show ((q ∣_ V) ≫ V.ι) y0 = q y0.1
      rw [morphismRestrict_ι]
      rfl
    have hqy0 : q y0.1 = s₁ := by
      rw [← e1, hy0]
      rfl
    have hrange : IsClosed (Set.range ⇑q) := hqc.isClosed_range
    obtain ⟨e₀, he₀⟩ : w ∈ Set.range ⇑q := hs1w.mem_closed hrange ⟨y0.1, hqy0⟩
    have hZc : IsClosed (⇑gN ⁻¹' {IsLocalRing.closedPoint R}) :=
      (IsLocalRing.isClosed_singleton_closedPoint R).preimage gN.continuous
    have he₀Z : e₀ ∈ ⇑gN ⁻¹' {IsLocalRing.closedPoint R} := by
      show gN e₀ = IsLocalRing.closedPoint R
      rw [← hqg, Scheme.Hom.comp_apply, he₀, hw]
    obtain ⟨L, hLc, hLi, he₀L, hLZ, hLmax⟩ := c6 N _ e₀ hZc he₀Z
    have hLnt := hP10 L hLc hLi hLZ hLmax
    have hgp := hLi.isGenericPoint_genericPoint hLc
    have hεZ := hLZ hgp.mem
    have hεg : g (q hLi.genericPoint) = IsLocalRing.closedPoint R := by
      have : gN hLi.genericPoint = IsLocalRing.closedPoint R := hεZ
      rw [← hqg, Scheme.Hom.comp_apply] at this
      exact this
    by_cases hεe : hLi.genericPoint = e₀
    · obtain ⟨e'', he''L, he''ne⟩ := hLnt.exists_ne hLi.genericPoint
      have hsp : hLi.genericPoint ⤳ e'' := hgp.specializes he''L
      have hsp2 := hsp.map q.continuous
      rw [hεe, he₀] at hsp2
      have hq'' : q e'' = w :=
        Set.mem_singleton_iff.mp (hsp2.mem_closed hwc (Set.mem_singleton w))
      exact ⟨e'', hLi.genericPoint, hq'', hsp, he''ne.symm, hεg⟩
    · exact ⟨e₀, hLi.genericPoint, he₀, hgp.specializes he₀L, hεe, hεg⟩

  have c9 : ∀ (S N : Scheme.{u}) (q : N ⟶ S) (e y : N), y ⤳ e →
      ∀ [IsDomain (S.presheaf.stalk (q e))] [ValuationRing (S.presheaf.stalk (q e))],
      IsDomain (N.presheaf.stalk e) → IsDomain (N.presheaf.stalk y) → IsIso (q.stalkMap y) →
      Function.Surjective (q.stalkMap e).hom := by
    intro S N q e y hye _ _ hBd hTd hiso
    have hnat : ∀ b, (N.presheaf.stalkSpecializes hye).hom ((q.stalkMap e).hom b) =
        (q.stalkMap y).hom ((S.presheaf.stalkSpecializes (hye.map q.continuous)).hom b) := by
      intro b
      have := Scheme.Hom.stalkSpecializes_stalkMap q y e hye
      have h2 := congrArg (fun f => f.hom b) this
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
      exact h2.symm
    have hψ : Function.Bijective (q.stalkMap y).hom := ConcreteCategory.bijective_of_isIso _
    have hκ : Function.Injective (N.presheaf.stalkSpecializes hye).hom := (c5 N y e hye).1 hBd
    have hsp : Function.Injective (S.presheaf.stalkSpecializes (hye.map q.continuous)).hom :=
      (c5 S (q y) (q e) (hye.map q.continuous)).1 inferInstance
    haveI : IsLocalHom (q.stalkMap e).hom := inferInstance
    refine c2 _ _ _ (q.stalkMap e).hom inferInstance (N.presheaf.stalkSpecializes hye).hom hκ ?_ ?_
    · intro x1 x2 hx
      simp only [RingHom.comp_apply, hnat] at hx
      exact hsp (hψ.1 hx)
    · intro t
      obtain ⟨c, rfl⟩ := hψ.2 t
      obtain ⟨a, b, hb, hab⟩ := (c5 S (q y) (q e) (hye.map q.continuous)).2 c
      refine ⟨a, b, hb, ?_⟩
      rw [hnat, hnat, ← map_mul, hab]

  have c10 : ∀ (S N : Scheme.{u}) (q : N ⟶ S) (e ε : N), ε ⤳ e → ε ≠ e → q ε = q e →
      Function.Surjective (q.stalkMap e).hom → False := by
    intro S N q e ε hεe hne hq hsurj
    have hεR : ε ∈ Set.range ⇑(N.fromSpecStalk e) := by
      rw [Scheme.range_fromSpecStalk]; exact hεe
    obtain ⟨Pε, hPε⟩ := hεR
    have hpt : ∀ P, q (N.fromSpecStalk e P) =
        S.fromSpecStalk (q e) (Spec.map (q.stalkMap e) P) := by
      intro P
      have := Scheme.SpecMap_stalkMap_fromSpecStalk q (x := e)
      rw [← Scheme.Hom.comp_apply, ← this, Scheme.Hom.comp_apply]
    have h2 := hpt (IsLocalRing.closedPoint _)
    rw [Scheme.fromSpecStalk_closedPoint] at h2
    have h1 : S.fromSpecStalk (q e) (Spec.map (q.stalkMap e) Pε) =
        S.fromSpecStalk (q e) (Spec.map (q.stalkMap e) (IsLocalRing.closedPoint _)) := by
      rw [← hpt Pε, hPε, hq]; exact h2
    have h3 := (S.fromSpecStalk (q e)).isEmbedding.injective h1
    have h4 : Ideal.comap (q.stalkMap e).hom Pε.asIdeal =
        Ideal.comap (q.stalkMap e).hom (IsLocalRing.maximalIdeal (N.presheaf.stalk e)) :=
      congrArg PrimeSpectrum.asIdeal h3
    have h5 := congrArg (Ideal.map (q.stalkMap e).hom) h4
    rw [Ideal.map_comap_of_surjective _ hsurj, Ideal.map_comap_of_surjective _ hsurj] at h5
    have h6 : Pε = IsLocalRing.closedPoint (N.presheaf.stalk e) := PrimeSpectrum.ext h5
    apply hne
    calc ε = N.fromSpecStalk e Pε := hPε.symm
      _ = N.fromSpecStalk e (IsLocalRing.closedPoint _) := congrArg _ h6
      _ = e := Scheme.fromSpecStalk_closedPoint

  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA w hwc hwu
  obtain ⟨-, -, -, -, hS⟩ := hA
  obtain ⟨hQ1, -, ⟨-, hnormS', hnormN⟩, ⟨-, -, hflatS', hlft', hflatN, -⟩, ⟨-, hq'prop⟩,
    ⟨-, hV'⟩, -, -, -, -, ⟨-, -, -, -, hP10N, -, -⟩, -, -⟩ := hS
  obtain ⟨V, hV, hVi⟩ := hV'
  have hT : q ≫ ν ≫ u = q' ≫ ν' ≫ u' := by
    rw [reassoc_of% hQ1.1, reassoc_of% hQ1.2, Limits.pullback.condition]
  have hTp : ∀ y : N, (q ≫ ν ≫ u) y = (ν' ≫ u') (q' y) := by
    intro y
    rw [hT]
    simp only [Scheme.Hom.comp_apply]
  haveI := hlft'
  haveI : IsLocallyNoetherian S' := LocallyOfFiniteType.isLocallyNoetherian (ν' ≫ u')
  haveI := hq'prop
  obtain ⟨s₁, hs1w, hs1g⟩ := c1 R S' (ν' ≫ u') hflatS' w hwu
  by_cases hex : ∃ s : S', s ⤳ w ∧ s ≠ w ∧ (ν' ≫ u') s = IsLocalRing.closedPoint R
  · obtain ⟨s, hsw, hsne, hsu⟩ := hex
    obtain ⟨s', hs's, hs'u⟩ := c1 R S' (ν' ≫ u') hflatS' s hsu
    exact ⟨s, s', hs's, hsw, hsne, hsu, hs'u⟩
  · exfalso
    have hH : ∀ t : S', t ⤳ w → (ν' ≫ u') t = IsLocalRing.closedPoint R → t = w := by
      intro t ht htu
      by_contra hne
      exact hex ⟨t, ht, hne, htu⟩
    obtain ⟨e, ε, hqe, hεe, hne, hεu⟩ := c8 R S' N (ν' ≫ u') q' (q ≫ ν ≫ u) hT.symm
      q'.isClosedMap V hV hVi hP10N w hwc hwu ⟨s₁, hs1w, hs1g⟩
    have hqε : q' ε = w := by
      have hsp := hεe.map q'.continuous
      rw [hqe] at hsp
      exact hH _ hsp hεu
    haveI := (hnormS' w).1
    haveI hdvr := c7 R S' (ν' ≫ u') w (hnormS' w).2 hwu hH ⟨s₁, hs1w, hs1g⟩
    subst hqe
    haveI : ValuationRing (S'.presheaf.stalk (q' e)) := inferInstance
    have hεN : (q ≫ ν ≫ u) ε = IsLocalRing.closedPoint R := by rw [hTp]; exact hεu
    obtain ⟨y, hyε, hyu⟩ := c1 R N (q ≫ ν ≫ u) hflatN ε hεN
    have hye : y ⤳ e := hyε.trans hεe
    have hyV : q' y ∈ V := hV _ (by rw [← hTp]; exact hyu)
    have hiso := c4 N S' q' V hVi y hyV
    have hsurj := c9 S' N q' e y hye (hnormN e).1 (hnormN y).1 hiso
    exact c10 S' N q' e ε hεe hne hqε hsurj

theorem wcpa_dj_nccw_gnts_birational : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (S Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z), IsFinite ν → (∀ x : S, IsDomain (S.presheaf.stalk x)) → (∀ x : Z, IsDomain (Z.presheaf.stalk x) → IsIntegrallyClosed (Z.presheaf.stalk x) → ∃ w : S, (∀ w' : S, ν w' = x ↔ w' = w) ∧ IsIso (ν.stalkMap w)) → ∀ w : S, _root_.IsReduced (Z.presheaf.stalk (ν w)) → (∀ p₀ p₁ p₂ p₃ : Ideal (Z.presheaf.stalk (ν w)), p₀.IsPrime → p₁.IsPrime → p₂.IsPrime → p₃.IsPrime → p₀ < p₁ → p₁ < p₂ → p₂ < p₃ → False) → (∃ s s' : S, s' ⤳ s ∧ s ⤳ w ∧ s ≠ w ∧ (ν ≫ u) s = IsLocalRing.closedPoint R ∧ (ν ≫ u) s' ≠ IsLocalRing.closedPoint R) → ∀ c : S.presheaf.stalk w, ∃ x t : Z.presheaf.stalk (ν w), (ν.stalkMap w).hom t ≠ 0 ∧ (ν.stalkMap w).hom t * c = (ν.stalkMap w).hom x :=
by
  intro R _ _ _ S Z u ν hνfin hdom hP12Z zk hred hchain hss c
  obtain ⟨s, s', hs's, hszk, hsne, hsu, hs'u⟩ := hss

  have t_generic : ∀ (X : Scheme.{u}) (x : X), IsDomain (X.presheaf.stalk x) → ∃ g : X, g ⤳ x ∧
      (∀ y : X, y ⤳ x → g ⤳ y) ∧ (∀ g' : X, g' ⤳ g → g' = g) := by
    intro X x hd
    let p0 : PrimeSpectrum (X.presheaf.stalk x) := ⟨⊥, Ideal.isPrime_bot⟩
    have hr : ∀ y : X, y ⤳ x → ∃ p : PrimeSpectrum (X.presheaf.stalk x),
        X.fromSpecStalk x p = y := by
      intro y hy
      have : y ∈ Set.range (X.fromSpecStalk x) := by rw [Scheme.range_fromSpecStalk]; exact hy
      exact this
    have hgen : ∀ y : X, y ⤳ x → X.fromSpecStalk x p0 ⤳ y := by
      intro y hy
      obtain ⟨p, rfl⟩ := hr y hy
      exact ((PrimeSpectrum.le_iff_specializes p0 p).mp bot_le).map (X.fromSpecStalk x).continuous
    refine ⟨X.fromSpecStalk x p0, hgen x specializes_rfl, hgen, ?_⟩
    intro g' hg'
    obtain ⟨p, rfl⟩ := hr g' (hg'.trans (hgen x specializes_rfl))
    have h2 : p ⤳ p0 := ((X.fromSpecStalk x).isEmbedding.isInducing.specializes_iff).mp hg'
    have h3 : p.asIdeal ≤ ⊥ := (PrimeSpectrum.le_iff_specializes p p0).mpr h2
    have : p = p0 := PrimeSpectrum.ext (le_antisymm h3 bot_le)
    rw [this]

  have t_chain : ∀ (X : Scheme.{u}) (x y₀ y₁ y₂ : X), (∀ p₀ p₁ p₂ p₃ : Ideal (X.presheaf.stalk x),
      p₀.IsPrime → p₁.IsPrime → p₂.IsPrime → p₃.IsPrime → p₀ < p₁ → p₁ < p₂ → p₂ < p₃ → False) →
      y₀ ⤳ y₁ → y₁ ⤳ y₂ → y₂ ⤳ x → y₀ ≠ y₁ → y₁ ≠ y₂ → y₂ ≠ x → False := by
    intro X x y₀ y₁ y₂ hc h01 h12 h2x n01 n12 n2x
    have hr : ∀ y : X, y ⤳ x → ∃ p : PrimeSpectrum (X.presheaf.stalk x),
        X.fromSpecStalk x p = y := by
      intro y hy
      have : y ∈ Set.range (X.fromSpecStalk x) := by rw [Scheme.range_fromSpecStalk]; exact hy
      exact this
    have hind := (X.fromSpecStalk x).isEmbedding.isInducing
    have lt : ∀ a b : PrimeSpectrum (X.presheaf.stalk x),
        X.fromSpecStalk x a ⤳ X.fromSpecStalk x b →
        X.fromSpecStalk x a ≠ X.fromSpecStalk x b → a.asIdeal < b.asIdeal := by
      intro a b hab nab
      refine lt_of_le_of_ne
        ((PrimeSpectrum.le_iff_specializes a b).mpr (hind.specializes_iff.mp hab)) ?_
      intro e
      exact nab (congrArg _ (PrimeSpectrum.ext e))
    have hcl : X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) = x :=
      Scheme.fromSpecStalk_closedPoint
    obtain ⟨q₂, rfl⟩ := hr y₂ h2x
    obtain ⟨q₁, rfl⟩ := hr _ (h12.trans h2x)
    obtain ⟨q₀, rfl⟩ := hr _ (h01.trans (h12.trans h2x))
    have h2x' : X.fromSpecStalk x q₂ ⤳
        X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) := by
      rw [hcl]; exact h2x
    have n2x' : X.fromSpecStalk x q₂ ≠
        X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) := by
      rw [hcl]; exact n2x
    exact hc _ _ _ _ q₀.isPrime q₁.isPrime q₂.isPrime (IsLocalRing.closedPoint _).isPrime
      (lt _ _ h01 n01) (lt _ _ h12 n12) (lt _ _ h2x' n2x')

  have t_fib : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z), IsFinite ν → ∀ s₁ s₂ : S, s₁ ⤳ s₂ →
      ν s₁ = ν s₂ → s₁ = s₂ := by
    intro S Z ν hν s₁ s₂ hsp he
    haveI : LocallyQuasiFinite ν := inferInstance
    have hd := ν.isDiscrete_preimage_singleton (ν s₂)
    rw [isDiscrete_iff_discreteTopology] at hd
    have h1 : (⟨s₁, he⟩ : ν ⁻¹' {ν s₂}) ⤳ ⟨s₂, rfl⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp hsp
    exact congrArg Subtype.val (specializes_iff_eq.mp h1)

  have t_loc : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z),
      letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk x)
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
          (X.presheaf.stalkSpecializes h).hom) := by
    intro X x z h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
        have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
        have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
        have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
          exact Ideal.mem_map_of_mem _ haQ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
      haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
      show IsLocalization _ S
      refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        show φ (gR a) ∉ IsLocalRing.maximalIdeal S
        rw [hc a]
        exact IsLocalRing.notMem_maximalIdeal.mpr
          (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
      · intro r hr
        exact IsLocalRing.notMem_maximalIdeal.mp hr
    obtain ⟨W, hW, hzW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
    have hxW : x ∈ W := h.mem_open W.isOpen hzW
    have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
    have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
    have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z hzW).hom =
        (X.presheaf.germ W x hxW).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
    exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx

  have t_field : ∀ (X : Scheme.{u}) (g x : X), g ⤳ x → _root_.IsReduced (X.presheaf.stalk x) →
      (∀ g' : X, g' ⤳ g → g' = g) → IsField (X.presheaf.stalk g) := by
    intro X g x hgx hred hmax
    letI := (X.presheaf.stalkSpecializes hgx).hom.toAlgebra
    haveI := t_loc X g x hgx
    haveI : _root_.IsReduced (X.presheaf.stalk g) :=
      isReduced_localizationPreserves ((IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap
        (X.presheaf.stalkSpecializes hgx).hom).primeCompl (X.presheaf.stalk g) hred
    have hprime : ∀ J : Ideal (X.presheaf.stalk g), J.IsPrime →
        J = IsLocalRing.maximalIdeal _ := by
      intro J hJ
      have hr : X.fromSpecStalk g ⟨J, hJ⟩ ⤳ g := by
        have : X.fromSpecStalk g ⟨J, hJ⟩ ∈ Set.range (X.fromSpecStalk g) := ⟨_, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      have e1 := hmax _ hr
      have e2 : X.fromSpecStalk g (IsLocalRing.closedPoint (X.presheaf.stalk g)) = g :=
        Scheme.fromSpecStalk_closedPoint
      have e3 := (X.fromSpecStalk g).isEmbedding.injective (e1.trans e2.symm)
      exact congrArg PrimeSpectrum.asIdeal e3
    rw [IsLocalRing.isField_iff_maximalIdeal_eq]
    rw [eq_bot_iff]
    intro m hm
    have hn : IsNilpotent m :=
      (nilpotent_iff_mem_prime).mpr (fun J hJ => by rw [hprime J hJ]; exact hm)
    exact (Submodule.mem_bot _).mpr hn.eq_zero

  have t_inj : ∀ (X : Scheme.{u}) (g y : X) (h : g ⤳ y), IsDomain (X.presheaf.stalk y) →
      Function.Injective (X.presheaf.stalkSpecializes h).hom := by
    intro X g y h hdom
    letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
    haveI := t_loc X g y h
    have hle : ((IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap
        (X.presheaf.stalkSpecializes h).hom).primeCompl ≤
          nonZeroDivisors (X.presheaf.stalk y) := by
      intro a ha
      apply mem_nonZeroDivisors_of_ne_zero
      rintro rfl
      exact ha (Ideal.zero_mem _)
    exact IsLocalization.injective (X.presheaf.stalk g) hle

  haveI hdomA : IsDomain (S.presheaf.stalk zk) := hdom zk
  obtain ⟨s₀, hs₀zk, hgen, hmax⟩ := t_generic S zk hdomA
  have hs₀s := hgen s hszk
  have hs₀s' := hgen s' (hs's.trans hszk)

  have hs₀cl : (ν ≫ u) s₀ ≠ IsLocalRing.closedPoint R := by
    intro e
    have h1 := hs₀s'.map (ν ≫ u).continuous
    have h2 : (ν ≫ u) s' ∈ ({IsLocalRing.closedPoint R} : Set (Spec (.of R))) :=
      h1.mem_closed (IsLocalRing.isClosed_singleton_closedPoint R) e
    exact hs'u h2

  have hνs₀s : ν s₀ ≠ ν s := by
    intro e
    apply hs₀cl
    have : (ν ≫ u) s₀ = (ν ≫ u) s := by simp only [Scheme.Hom.comp_apply, e]
    rw [this]; exact hsu
  have hνszk : ν s ≠ ν zk := fun e => hsne (t_fib S Z ν hνfin s zk hszk e)
  have hg : ν s₀ ⤳ ν zk := hs₀zk.map ν.continuous
  have hgmax : ∀ g' : Z, g' ⤳ ν s₀ → g' = ν s₀ := by
    intro g' hg'
    by_contra hne
    exact t_chain Z (ν zk) g' (ν s₀) (ν s) hchain hg' (hs₀s.map ν.continuous)
      (hszk.map ν.continuous) hne hνs₀s hνszk

  have hF : IsField (Z.presheaf.stalk (ν s₀)) := t_field Z (ν s₀) (ν zk) hg hred hgmax
  have hd : IsDomain (Z.presheaf.stalk (ν s₀)) := hF.isDomain
  have hic : IsIntegrallyClosed (Z.presheaf.stalk (ν s₀)) := by
    letI := hF.toField; infer_instance
  obtain ⟨w₁, hw₁, hiso⟩ := hP12Z (ν s₀) hd hic
  have hws : s₀ = w₁ := (hw₁ s₀).mp rfl
  subst hws
  have hθ : Function.Bijective (ν.stalkMap s₀).hom :=
    ConcreteCategory.bijective_of_isIso (ν.stalkMap s₀)

  have hspS := t_inj S s₀ zk hs₀zk hdomA
  have hnat : ∀ x, (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom x) =
      (S.presheaf.stalkSpecializes hs₀zk).hom ((ν.stalkMap zk).hom x) :=
    fun x => Scheme.Hom.stalkSpecializes_stalkMap_apply ν s₀ zk hs₀zk x
  letI := (Z.presheaf.stalkSpecializes hg).hom.toAlgebra
  haveI := t_loc Z (ν s₀) (ν zk) hg
  obtain ⟨y, hy⟩ := hθ.2 ((S.presheaf.stalkSpecializes hs₀zk).hom c)
  obtain ⟨⟨a0, ⟨t0, ht0⟩⟩, hmk⟩ := IsLocalization.mk'_surjective
    ((IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν s₀))).comap
      (Z.presheaf.stalkSpecializes hg).hom).primeCompl y
  have hspec := IsLocalization.mk'_spec (Z.presheaf.stalk (ν s₀)) a0 ⟨t0, ht0⟩
  have hunit := IsLocalization.map_units (Z.presheaf.stalk (ν s₀))
    (⟨t0, ht0⟩ : ((IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν s₀))).comap
      (Z.presheaf.stalkSpecializes hg).hom).primeCompl)
  have key : (Z.presheaf.stalkSpecializes hg).hom t0 * y =
      (Z.presheaf.stalkSpecializes hg).hom a0 := by
    rw [mul_comm, ← hmk]; exact hspec
  refine ⟨a0, t0, ?_, ?_⟩
  · intro h0
    have hu : IsUnit ((S.presheaf.stalkSpecializes hs₀zk).hom ((ν.stalkMap zk).hom t0)) := by
      rw [← hnat]; exact hunit.map (ν.stalkMap s₀).hom
    rw [h0, map_zero] at hu
    exact not_isUnit_zero hu
  · apply hspS
    rw [map_mul, ← hnat t0, ← hnat a0, ← hy, ← map_mul, key]

theorem wcpa_dj_nccw_gnts_axis_hom_kernel : ∀ (R : Type u) [CommRing R] (θ : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries R), (∀ r : R, θ (Ideal.Quotient.mk _ (MvPowerSeries.C r)) = PowerSeries.C r) → ((θ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = PowerSeries.X ∧ θ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0) → RingHom.ker θ = Ideal.span {Ideal.Quotient.mk _ (MvPowerSeries.X 1)}) ∧ ((θ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0 ∧ θ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = PowerSeries.X) → RingHom.ker θ = Ideal.span {Ideal.Quotient.mk _ (MvPowerSeries.X 0)}) :=
by
  intro R _ θ hC
  classical
  have axis : ∀ (s t : Fin 2), s ≠ t → ∀ m : Fin 2 →₀ ℕ, m t = 0 →
      m = Finsupp.single s (m s) := by
    intro s t hst m hm
    ext i
    by_cases his : i = s
    · rw [his, Finsupp.single_eq_same]
    · have hit : i = t := by
        fin_cases s <;> fin_cases t <;> fin_cases i <;> simp_all
      rw [hit, hm, Finsupp.single_apply, if_neg hst]
  have coeffF : ∀ (s t : Fin 2), s ≠ t → ∀ φ : MvPowerSeries (Fin 2) R →+* PowerSeries R,
      (∀ r : R, φ (MvPowerSeries.C r) = PowerSeries.C r) →
      φ (MvPowerSeries.X s) = PowerSeries.X → φ (MvPowerSeries.X t) = 0 →
      ∀ (f : MvPowerSeries (Fin 2) R) (N : ℕ),
        PowerSeries.coeff N (φ f) = MvPowerSeries.coeff (Finsupp.single s N) f := by
    intro s t hst φ hφC hφs hφt f N
    let a : ℕ → R := fun i => MvPowerSeries.coeff (Finsupp.single s i) f
    let P : MvPowerSeries (Fin 2) R :=
      ∑ i ∈ Finset.range (N + 1), MvPowerSeries.C (a i) * MvPowerSeries.X s ^ i
    have hPcoeff : ∀ k ≤ N, MvPowerSeries.coeff (Finsupp.single s k) P = a k := by
      intro k hk
      show MvPowerSeries.coeff (Finsupp.single s k)
        (∑ i ∈ Finset.range (N + 1), MvPowerSeries.C (a i) * MvPowerSeries.X s ^ i) = a k
      rw [map_sum]
      simp only [MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_X_pow]
      rw [Finset.sum_eq_single k]
      · simp
      · intro i _ hik
        rw [if_neg, mul_zero]
        intro h
        rw [Finsupp.single_eq_single_iff] at h
        rcases h with ⟨_, h⟩ | ⟨h1, h2⟩
        · exact hik h.symm
        · exact hik (by rw [h1, h2])
      · intro hk'
        exact absurd (Finset.mem_range.mpr (by omega)) hk'
    let r0 : MvPowerSeries (Fin 2) R :=
      fun m => if m t = 0 then MvPowerSeries.coeff m (f - P) else 0
    have hr0 : ∀ m, MvPowerSeries.coeff m r0 =
        if m t = 0 then MvPowerSeries.coeff m (f - P) else 0 := fun m => rfl
    have h3 : MvPowerSeries.X t ∣ (f - P) - r0 := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [map_sub (MvPowerSeries.coeff m) (f - P) r0, hr0, if_pos hm, sub_self]
    have h4 : MvPowerSeries.X s ^ (N + 1) ∣ r0 := by
      rw [MvPowerSeries.X_pow_dvd_iff]
      intro m hm
      rw [hr0]
      split_ifs with hmt
      · rw [axis s t hst m hmt, map_sub, hPcoeff _ (by omega)]
        exact sub_self _
      · rfl
    obtain ⟨g, hg⟩ := h3
    obtain ⟨h, hh⟩ := h4
    have hf : f = P + MvPowerSeries.X t * g + MvPowerSeries.X s ^ (N + 1) * h := by
      rw [← hg, ← hh]; ring
    have hφP : φ P = ∑ i ∈ Finset.range (N + 1), PowerSeries.C (a i) * PowerSeries.X ^ i := by
      show φ (∑ i ∈ Finset.range (N + 1), MvPowerSeries.C (a i) * MvPowerSeries.X s ^ i) = _
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, hφC, hφs]
    have hφf : φ f = ∑ i ∈ Finset.range (N + 1), PowerSeries.C (a i) * PowerSeries.X ^ i +
        PowerSeries.X ^ (N + 1) * φ h := by
      conv_lhs => rw [hf]
      rw [map_add, map_add, map_mul, map_mul, map_pow, hφt, hφs, zero_mul, add_zero, hφP]
    rw [hφf, map_add, map_sum, PowerSeries.coeff_X_pow_mul', if_neg (by omega), add_zero]
    simp only [PowerSeries.coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr (by omega))]
  have kerdvd : ∀ (s t : Fin 2), s ≠ t → ∀ φ : MvPowerSeries (Fin 2) R →+* PowerSeries R,
      (∀ r : R, φ (MvPowerSeries.C r) = PowerSeries.C r) →
      φ (MvPowerSeries.X s) = PowerSeries.X → φ (MvPowerSeries.X t) = 0 →
      ∀ f : MvPowerSeries (Fin 2) R, φ f = 0 ↔ MvPowerSeries.X t ∣ f := by
    intro s t hst φ hφC hφs hφt f
    constructor
    · intro h0
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [axis s t hst m hm, ← coeffF s t hst φ hφC hφs hφt f (m s), h0, map_zero]
    · rintro ⟨g, rfl⟩
      rw [map_mul, hφt, zero_mul]
  have main : ∀ (s t : Fin 2), s ≠ t →
      θ (Ideal.Quotient.mk _ (MvPowerSeries.X s)) = PowerSeries.X →
      θ (Ideal.Quotient.mk _ (MvPowerSeries.X t)) = 0 →
      RingHom.ker θ = Ideal.span {Ideal.Quotient.mk _ (MvPowerSeries.X t)} := by
    intro s t hst hs ht
    have key := kerdvd s t hst
      (θ.comp (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})))
      (fun r => hC r) hs ht
    apply le_antisymm
    · intro y hy
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [RingHom.mem_ker] at hy
      obtain ⟨g, rfl⟩ := (key f).mp hy
      rw [Ideal.mem_span_singleton, map_mul]
      exact dvd_mul_right _ _
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      exact ht
  exact ⟨fun h => main 0 1 (by decide) h.1 h.2, fun h => main 1 0 (by decide) h.2 h.1⟩

theorem wcpa_dj_nccw_gnts_sheet_branch : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ w : S', IsClosed ({w} : Set S') → (ν' ≫ u') w = IsLocalRing.closedPoint R → ∀ eZ : AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk (ν' w))) (Z'.presheaf.stalk (ν' w)) ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), eZ.toRingHom.comp ((algebraMap (Z'.presheaf.stalk (ν' w)) (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk (ν' w))) (Z'.presheaf.stalk (ν' w)))).comp ((Z'.presheaf.germ ⊤ (ν' w) trivial).hom.comp (wcCnSigma u' ⊤))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → ∃ (e : AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w) ≃+* PowerSeries R) (ψ : AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk (ν' w))) (Z'.presheaf.stalk (ν' w)) →+* AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w)), e.toRingHom.comp ((algebraMap (S'.presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w))).comp ((S'.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma (ν' ≫ u') ⊤))) = PowerSeries.C ∧ (∀ x : Z'.presheaf.stalk (ν' w), ψ (algebraMap _ _ x) = algebraMap (S'.presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w)) ((ν'.stalkMap w).hom x)) ∧ (RingHom.ker (ψ.comp eZ.symm.toRingHom) = Ideal.span {Ideal.Quotient.mk _ (MvPowerSeries.X 1)} ∨ RingHom.ker (ψ.comp eZ.symm.toRingHom) = Ideal.span {Ideal.Quotient.mk _ (MvPowerSeries.X 0)}) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA w hwc
    hwu eZ heZ
  classical
  have hA' := hA
  obtain ⟨hcomp, -, hPr, hH, hS⟩ := hA
  have hE : wcpaDjNccExcellent.{u} := hPr.2.2.2.2.2.1
  obtain ⟨-, ⟨-, hν'fin, -⟩, ⟨-, hnormS', -⟩, ⟨-, -, -, hlft', -⟩, -, -, -, -, -, -, -, -,
    ⟨hP12Z', -⟩⟩ := hS
  obtain ⟨-, -, hst', -⟩ := hH
  have hss : wcpaDjSemistable u' := by unfold wcpaDjStablePtd at hst'; exact hst'.1
  haveI hprop : IsProper u' := by unfold wcpaDjSemistable at hss; exact hss.2.1
  haveI : IsLocallyNoetherian Z' := LocallyOfFiniteType.isLocallyNoetherian u'
  haveI := hlft'
  haveI : IsLocallyNoetherian S' := LocallyOfFiniteType.isLocallyNoetherian (ν' ≫ u')
  haveI := (hnormS' w).1

  obtain ⟨hlocA, hcompA, -, -⟩ := wc_hnas_completion_local_complete (S'.presheaf.stalk w)
  obtain ⟨ψ, -, hψ⟩ := wcpa_dj_stc_ktc_compl_lift (Z'.presheaf.stalk (ν' w))
    (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w)) hcompA
    ((algebraMap (S'.presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal
      (S'.presheaf.stalk w)) (S'.presheaf.stalk w))).comp (ν'.stalkMap w).hom) inferInstance
  have hψx : ∀ x : Z'.presheaf.stalk (ν' w), ψ (algebraMap _ _ x) =
      algebraMap (S'.presheaf.stalk w)
      (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w))
      ((ν'.stalkMap w).hom x) := fun x => RingHom.congr_fun hψ x

  obtain ⟨s, s', hs's, hsw, hsne, hsu, hs'u⟩ := wcpa_dj_nccw_gnts_special_generization R Z Z' Y G
    S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA' w hwc hwu
  have hs'ne : s' ≠ s := by
    intro h3
    apply hs'u
    rw [h3]
    exact hsu
  have hsR : s ∈ Set.range ⇑(S'.fromSpecStalk w) := by
    rw [Scheme.range_fromSpecStalk]; exact hsw
  have hs'R : s' ∈ Set.range ⇑(S'.fromSpecStalk w) := by
    rw [Scheme.range_fromSpecStalk]; exact hs's.trans hsw
