      obtain ⟨hloc, hQc, hQd, hQinj, ρ, hρ⟩ := nccwff_node_ring_props R hcomp c hc0 hcm
      haveI := hloc
      haveI : IsAlgClosed (IsLocalRing.ResidueField (nccwffQ R c)) :=
        IsAlgClosed.of_ringEquiv _ _ ρ
      have hFO := nccwff_basechange_forest R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν'
        μ q q' st zk η₀ η ηZ hA hzkc (nccwffQ R c) hQc inferInstance hQd
        (Or.inr ⟨R, inferInstance, inferInstance, inferInstance, c, hc0, hcm, hcomp,
          ⟨RingEquiv.refl _⟩⟩)
