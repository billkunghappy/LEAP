  have R5 : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B] [Module.Flat A B] (p : Ideal A) [p.IsPrime] (ϖ : A), ϖ ∈ p → ϖ ≠ 0 → (∀ x ∈ p, ∃ s : A, s ∉ p ∧ s * x ∈ Ideal.span {ϖ}) → (∀ (y : B) (d : ℕ), y ^ (d + 1) ∈ Ideal.map (algebraMap A B) p → ∃ t : A, t ∉ p ∧ algebraMap A B t * y ∈ Ideal.map (algebraMap A B) p) → ∀ (σ : A) (k : ℕ) (e s : A), e ∉ p → s ∉ p → s * σ = e * ϖ ^ k → ∀ (Q : Polynomial B), Q.Monic → ∀ b : B, (Q.scaleRoots (algebraMap A B σ)).eval b = 0 → ∃ t : A, t ∉ p ∧ algebraMap A B t * b ∈ Ideal.span {algebraMap A B σ} := by
