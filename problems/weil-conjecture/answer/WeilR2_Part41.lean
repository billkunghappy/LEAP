      rw [← e1, hy0]
      rfl
    have huy0 : (q ≫ ν ≫ u) y0'.1 ≠ IsLocalRing.closedPoint R := by
      have h1 := hζh
      rw [Scheme.Hom.comp_apply] at h1
      rw [hT6, hqy0]
      exact h1
    have hHor : nccwHor u ν q st y0'.1 := by
      refine ⟨huy0, Or.inr ?_⟩
      intro hsm
      apply hζs
      rw [← hqy0]
      exact (hQ12 y0'.1 huy0).mp hsm
    have hnz : ¬ closure {y0'.1} ⊆ ⇑q ⁻¹' {zk} := by
      intro hsub
      have hz : q y0'.1 = zk := hsub (subset_closure (Set.mem_singleton _))
      apply huy0
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hz, hQ7.1, hp, hu]
    have hclJ : IsClosed (q' '' closure {y0'.1}) := hq'cl _ isClosed_closure
    have hζmem : ζ ∈ q' '' closure {y0'.1} :=
      ⟨y0'.1, subset_closure (Set.mem_singleton _), hqy0⟩
    obtain ⟨e, he, hqe⟩ := hζw.mem_closed hclJ hζmem
    exact ⟨closure {y0'.1}, ⟨isClosed_closure, isIrreducible_singleton.closure, hnz,
      Or.inr ⟨y0'.1, hHor, rfl⟩⟩, e, he, hqe⟩

  obtain ⟨W, hW01, hfib, hWε⟩ := wcpa_dj_nccw_gn_two_sheets R Z Z' Y G S S' N u u' n τ τ' π a a'
    h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA _ hxu hxcl hns hnd
  have hWν : ∀ ε, ν' (W ε) = (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x := by
    intro ε
    apply (hfib (W ε)).mpr
    fin_cases ε
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hWu : ∀ ε, (ν' ≫ u') (W ε) = IsLocalRing.closedPoint R := fun ε => by
    rw [Scheme.Hom.comp_apply, hWν ε, hxu]
  have hWdom : ∀ ε, IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk (W ε)))
      (S'.presheaf.stalk (W ε))) := fun ε => by
    obtain ⟨-, e, -⟩ := hWε ε
    exact Function.Injective.isDomain e e.injective

  have hω : ∀ ε, ∃ ω₀ : S', ω₀ ⤳ W ε ∧ ω₀ ≠ W ε ∧ (ν' ≫ u') ω₀ = IsLocalRing.closedPoint R ∧
      ∀ ω : S', ω ⤳ W ε → (ν' ≫ u') ω = IsLocalRing.closedPoint R → ω₀ ⤳ ω :=
    fun ε => wcpa_dj_nccw_gn_sheet_generization R S' (ν' ≫ u') (W ε) (hWu ε) (hWε ε).2
  choose ω hωW hωne hωu hωmin using hω

  have hkey : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      ∀ ε, ∀ y ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X,
      q' y = W ε → ∃ x₀ : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
        closure {x₀} = X ∧
        ν' (ω ε) = (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x₀ := by
    intro X hX ε y hy hqy
    obtain ⟨x₀, hx₀X, hx₀max⟩ := hgen X hX
    refine ⟨x₀, hx₀X, ?_⟩
    rw [← hx₀X, hDt] at hy
    obtain ⟨h81, h82, -, -, h85, -, -, -⟩ := hQ8 _ (hxu' x₀) hx₀max
    have hsp1 : η ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x₀) ⤳ y :=
      specializes_iff_mem_closure.mpr hy
    have hsp2 := hsp1.map q'.continuous
    rw [hqy] at hsp2
    have hgu : (ν' ≫ u') (q' (η ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x₀))) =
        IsLocalRing.closedPoint R := by
      rw [Scheme.Hom.comp_apply, h82, hxu' x₀]
    have hsp3 := hωmin ε _ hsp2 hgu
    have hsp4 := hsp3.map ν'.continuous
    rw [h82] at hsp4
    have hνωu := hωu ε
    rw [Scheme.Hom.comp_apply] at hνωu
    exact hx₀max _ hνωu hsp4

  have hG3 : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      x ∈ X → ∃ ε, ∃ y ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X,
        q' y = W ε := by
    intro X hX hxX
    obtain ⟨y, hy, e⟩ := wcpa_dj_nccw_hp_strict_meets R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ
      γ' ν ν' μ q q' st zk η₀ η ηZ hA X hX x hxX
    rcases (hfib (q' y)).mp e with h0 | h1
    · exact ⟨0, y, hy, h0⟩
    · exact ⟨1, y, hy, h1⟩

  have hG4 : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      ∀ X' ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      X ≠ X' → x ∈ X → x ∈ X' → ∀ ε,
      ¬ ((∃ y ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X, q' y = W ε) ∧
        (∃ y ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X', q' y = W ε)) := by
    rintro X hX X' hX' hne _ _ ε ⟨⟨y, hy, hqy⟩, ⟨y', hy', hqy'⟩⟩
    obtain ⟨x₀, hx₀, e0⟩ := hkey X hX ε y hy hqy
    obtain ⟨x₁, hx₁, e1⟩ := hkey X' hX' ε y' hy' hqy'
    have h01 : x₀ = x₁ := hemb.injective (e0.symm.trans e1)
    apply hne
    rw [← hx₀, ← hx₁, h01]

  have hG5 : ∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      x ∈ X → x ∉ closure Xᶜ → ∀ ε,
      ∃ y ∈ nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X, q' y = W ε := by
    intro X hX hxX hxc ε
    have hνωu := hωu ε
    rw [Scheme.Hom.comp_apply] at hνωu
    have hsp := (hωW ε).map ν'.continuous
    rw [hWν ε] at hsp
    have hne : ν' (ω ε) ≠ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x := by
      intro e
      have hcl0 : IsClosed ({ω ε} : Set S') := by
        rcases (hfib (ω ε)).mp e with h0 | h1
        · rw [h0]; exact (hWε 0).1
        · rw [h1]; exact (hWε 1).1
      exact hωne ε (Set.mem_singleton_iff.mp ((hωW ε).mem_closed hcl0 (Set.mem_singleton _))).symm
    have hmax : ∀ x₁ : Z', u' x₁ = IsLocalRing.closedPoint R → x₁ ⤳ ν' (ω ε) → x₁ = ν' (ω ε) := by
      intro x₁ hx₁ h1
      rcases wcpa_dj_ldx_ncds_chain_short_special R Z' u' hst'.1 x₁ (ν' (ω ε)) _ hx₁ h1 hsp with e | e
      · exact e
      · exact absurd e hne
    obtain ⟨xt, hxt, hxtc⟩ := hmaxgen (ν' (ω ε)) hνωu hmax
    have hxtx : xt ⤳ x := by
      apply hemb.isInducing.specializes_iff.mp
      rw [hxt]
      exact hsp
    have hXeq : closure {xt} = X := by
      by_contra hne'
      exact hxc (hcl X hX _ hxtc hne' (specializes_iff_mem_closure.mp hxtx))
    obtain ⟨-, -, -, -, h85, -, -, -⟩ := hQ8 (ν' (ω ε)) hνωu hmax
    have hωeq : ω ε = q' (η (ν' (ω ε))) := h85 (ω ε) rfl
    rw [← hXeq, hDt, hxt]
    have hcl2 : IsClosed (q' '' closure {η (ν' (ω ε))}) := hq'cl _ isClosed_closure
    have hmem : ω ε ∈ q' '' closure {η (ν' (ω ε))} :=
      ⟨η (ν' (ω ε)), subset_closure (Set.mem_singleton _), hωeq.symm⟩
    obtain ⟨y, hy, hqy⟩ := (hωW ε).mem_closed hcl2 hmem
    exact ⟨y, hy, hqy⟩
  refine ⟨W, hW01, fun ε => ⟨hWν ε, (hWε ε).1, hWu ε, hWdom ε, ?_⟩, hG3, hG4, hG5⟩

  obtain ⟨ζ, hζ, hζh, hζs⟩ := wcpa_dj_nccw_gn_horizontal_point R Z Z' Y G S S' N u u' n τ τ' π a
    a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA _ hxu hxcl hns hnd (W ε) (hWν ε)
  exact hexit ζ (W ε) hζ hζh hζs

theorem nccwst_node_arcs : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (σ : R →+* O) (c : R) (e : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})), c ∈ IsLocalRing.maximalIdeal R → e.toRingHom.comp ((algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)).comp σ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → ∃ (ψ : Fin 2 → (O →+* PowerSeries (IsLocalRing.ResidueField R))) (f : Fin 2 → O), (∀ i, IsLocalHom (ψ i)) ∧ (∀ i (r : R), ψ i (σ r) = PowerSeries.C (IsLocalRing.residue R r)) ∧ (∀ i, PowerSeries.X ^ 2 ∣ ψ i (f i) - PowerSeries.X) ∧ (∀ i j, i ≠ j → PowerSeries.X ^ 2 ∣ ψ i (f j)) :=
by
  intro R _ _ _ O _ _ _ σ c e hc heq
  classical

  have hbranch : ∀ i : Fin 2, ∃ χ : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) →+* PowerSeries (IsLocalRing.ResidueField R),
      IsLocalHom χ ∧
      (∀ r : R, χ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) (MvPowerSeries.C r)) = PowerSeries.C (IsLocalRing.residue R r)) ∧
      ∀ j : Fin 2, χ (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) (MvPowerSeries.X j)) = if j = i then PowerSeries.X else 0 := by
    intro i
    let a : Fin 2 → MvPowerSeries Unit (IsLocalRing.ResidueField R) :=
      fun j => if j = i then MvPowerSeries.X () else 0
    have ha0 : ∀ j, MvPowerSeries.constantCoeff (a j) = 0 := by
      intro j
      simp only [a]
      split_ifs <;> simp
    have ha : MvPowerSeries.HasSubst a := MvPowerSeries.hasSubst_of_constantCoeff_zero ha0
    let χ0 : MvPowerSeries (Fin 2) R →+* PowerSeries (IsLocalRing.ResidueField R) :=
      ((MvPowerSeries.substAlgHom (R := IsLocalRing.ResidueField R) ha).toRingHom).comp
        (MvPowerSeries.map (IsLocalRing.residue R))
    have hX : ∀ j, χ0 (MvPowerSeries.X j) = a j := by
      intro j
      simp only [χ0, RingHom.comp_apply, MvPowerSeries.map_X, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPowerSeries.substAlgHom_apply]
      exact MvPowerSeries.subst_X ha j
    have hC : ∀ r, χ0 (MvPowerSeries.C r) = MvPowerSeries.C (IsLocalRing.residue R r) := by
      intro r
      simp only [χ0, RingHom.comp_apply, MvPowerSeries.map_C, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPowerSeries.substAlgHom_apply]
      exact MvPowerSeries.subst_C _
    have hres : IsLocalRing.residue R c = 0 := (IsLocalRing.residue_eq_zero_iff c).mpr hc
    have hg : χ0 (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c) = 0 := by
      rw [map_sub, map_mul, hX, hX, hC, hres, map_zero, sub_zero]
      simp only [a]
      fin_cases i <;> simp
    have hker : ∀ y ∈ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c},
        χ0 y = 0 := by
      intro y hy
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [map_mul, hg, mul_zero]
    have hcc : ∀ F : MvPowerSeries (Fin 2) R, MvPowerSeries.constantCoeff (χ0 F) =
        IsLocalRing.residue R (MvPowerSeries.constantCoeff F) := by
      intro F
      have hsplit : F = MvPowerSeries.C (MvPowerSeries.constantCoeff F) +
          (F - MvPowerSeries.C (MvPowerSeries.constantCoeff F)) := by ring
      have h0 : MvPowerSeries.constantCoeff
          (χ0 (F - MvPowerSeries.C (MvPowerSeries.constantCoeff F))) = 0 := by
        simp only [χ0, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPowerSeries.substAlgHom_apply]
        apply MvPowerSeries.constantCoeff_subst_eq_zero ha ha0
        rw [MvPowerSeries.constantCoeff_map, map_sub, MvPowerSeries.constantCoeff_C, sub_self,
          map_zero]
      conv_lhs => rw [hsplit]
      rw [map_add, map_add, hC, h0, add_zero, MvPowerSeries.constantCoeff_C]
    refine ⟨Ideal.Quotient.lift _ χ0 hker, ⟨fun q hq => ?_⟩, fun r => ?_, fun j => ?_⟩
    · obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective q
      rw [Ideal.Quotient.lift_mk] at hq
      have h2 : IsUnit (MvPowerSeries.constantCoeff (χ0 F)) :=
        MvPowerSeries.isUnit_iff_constantCoeff.mp hq
      rw [hcc] at h2
      have h3 : IsUnit (MvPowerSeries.constantCoeff F) := by
        by_contra hn
        have hm : MvPowerSeries.constantCoeff F ∈ IsLocalRing.maximalIdeal R := hn
        rw [(IsLocalRing.residue_eq_zero_iff _).mpr hm] at h2
        exact not_isUnit_zero h2
      exact (MvPowerSeries.isUnit_iff_constantCoeff.mpr h3).map _
    · rw [Ideal.Quotient.lift_mk, hC]
      rfl
    · rw [Ideal.Quotient.lift_mk, hX]
      simp only [a]
      split_ifs <;> rfl
  choose χ hχloc hχC hχX using hbranch

  set alg := algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) with halg
  have halgof : ∀ p : O, alg p = AdicCompletion.of (IsLocalRing.maximalIdeal O) O p := by
    intro p
    rw [halg, AdicCompletion.algebraMap_apply]
    rfl
  have halg_loc : IsLocalHom alg := by
    constructor
    intro x hx
    have h1 := hx.map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) 1)
    rw [halgof, AdicCompletion.evalₐ_of] at h1
    by_contra hxu
    have hxm : x ∈ IsLocalRing.maximalIdeal O := hxu
    have h0 : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 1)) x = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_one]
      exact hxm
    rw [h0, isUnit_zero_iff] at h1
    have h2 := Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
    rw [pow_one] at h2
    exact (IsLocalRing.maximalIdeal.isMaximal O).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
  have hψloc : ∀ i, IsLocalHom (((χ i).comp e.toRingHom).comp alg) := by
    intro i
    constructor
    intro x hx
    have h1 : IsUnit (e (alg x)) := (hχloc i).map_nonunit (e (alg x)) hx
    have h2 : IsUnit (alg x) := by simpa using h1.map e.symm
    exact halg_loc.map_nonunit x h2
  have hσ : ∀ i (r : R), (((χ i).comp e.toRingHom).comp alg) (σ r) =
      PowerSeries.C (IsLocalRing.residue R r) := by
    intro i r
    have h := RingHom.congr_fun heq r
    simp only [RingHom.comp_apply] at h
    simp only [RingHom.comp_apply]
    rw [h]
    exact hχC i r
  have hXdvd : ∀ i, ∀ x ∈ IsLocalRing.maximalIdeal O,
      (PowerSeries.X : PowerSeries (IsLocalRing.ResidueField R)) ∣
        (((χ i).comp e.toRingHom).comp alg) x := by
    intro i x hx
    rw [PowerSeries.X_dvd_iff]
    have hxn : ¬ IsUnit x := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal x).mp hx)
    have hnu : ¬ IsUnit ((((χ i).comp e.toRingHom).comp alg) x) :=
      fun h => hxn ((hψloc i).map_nonunit x h)
    rw [PowerSeries.isUnit_iff_constantCoeff] at hnu
    by_contra hne
    exact hnu (isUnit_iff_ne_zero.mpr hne)
  have hX2 : ∀ i, ∀ y ∈ IsLocalRing.maximalIdeal O ^ 2,
      (PowerSeries.X : PowerSeries (IsLocalRing.ResidueField R)) ^ 2 ∣
        (((χ i).comp e.toRingHom).comp alg) y := by
    intro i y hy
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [map_mul, pow_two]
      exact mul_dvd_mul (hXdvd i a ha) (hXdvd i b hb)
    · intro x y hx hy
      rw [map_add]
      exact dvd_add hx hy
  have happrox : ∀ z : AdicCompletion (IsLocalRing.maximalIdeal O) O, ∃ p : O,
      z - alg p ∈ (IsLocalRing.maximalIdeal O ^ 2 •
        (⊤ : Submodule O (AdicCompletion (IsLocalRing.maximalIdeal O) O))) := by
    intro z
    obtain ⟨p, hp⟩ := Submodule.mkQ_surjective _
      (AdicCompletion.eval (IsLocalRing.maximalIdeal O) O 2 z)
    refine ⟨p, ?_⟩
    rw [AdicCompletion.pow_smul_top_eq_ker_eval (M := O) (IsNoetherian.noetherian _),
      LinearMap.mem_ker, map_sub, halgof, AdicCompletion.eval_of, hp, sub_self]
  have hstar : ∀ i, ∀ y ∈ (IsLocalRing.maximalIdeal O ^ 2 •
        (⊤ : Submodule O (AdicCompletion (IsLocalRing.maximalIdeal O) O))),
      (PowerSeries.X : PowerSeries (IsLocalRing.ResidueField R)) ^ 2 ∣ (χ i) (e y) := by
    intro i y hy
    refine Submodule.smul_induction_on hy ?_ ?_
    · intro r hr n _
      rw [Algebra.smul_def, map_mul, map_mul]
      exact dvd_mul_of_dvd_left (hX2 i r hr) _
    · intro x y hx hy
      rw [map_add, map_add]
      exact dvd_add hx hy
  choose f hf using fun j : Fin 2 =>
    happrox (e.symm (Ideal.Quotient.mk _ (MvPowerSeries.X j)))
  refine ⟨fun i => ((χ i).comp e.toRingHom).comp alg, f, hψloc, hσ, ?_, ?_⟩
  · intro i
    have h := hstar i _ (hf i)
    rw [map_sub, RingEquiv.apply_symm_apply, map_sub, hχX, if_pos rfl] at h
    show PowerSeries.X ^ 2 ∣ χ i (e (alg (f i))) - PowerSeries.X
    rw [← neg_sub, dvd_neg]
    exact h
  · intro i j hij
    have h := hstar i _ (hf j)
    rw [map_sub, RingEquiv.apply_symm_apply, map_sub, hχX, if_neg (Ne.symm hij), zero_sub,
      dvd_neg] at h
    exact h

theorem nccwst_p1_stalk_total : ∀ (K : Type u) [Field K] (Er : Scheme.{u}) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra) (e : Er), IsDomain (Er.presheaf.stalk e) ∧ ∀ a b : Er.presheaf.stalk e, a ∣ b ∨ b ∣ a :=
by
  intro K _ Er θ e
  let q : Er ⟶ Spec (.of K) := θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))
  obtain ⟨W, he, hsm⟩ := wcpa_dj_lcc_gs_p1_smooth K Er q θ rfl e
  haveI := hsm
  let w : (W : Scheme.{u}) := ⟨e, he⟩
  haveI hdom : IsDomain ((W : Scheme.{u}).presheaf.stalk w) :=
    wcpa_smooth_stalk_isDomain K W (W.ι ≫ q) 1 w
  haveI hval : ValuationRing ((W : Scheme.{u}).presheaf.stalk w) :=
    wcpa_dj_sgt_smooth_curve_stalk_valuation K W (W.ι ≫ q) w
  let φ : (W : Scheme.{u}).presheaf.stalk w ≃+* Er.presheaf.stalk e :=
    (Scheme.Opens.stalkIso W w).commRingCatIsoToRingEquiv
  refine ⟨MulEquiv.isDomain ((W : Scheme.{u}).presheaf.stalk w) φ.symm.toMulEquiv, ?_⟩
  intro a b
  rcases ValuationRing.dvd_total (φ.symm a) (φ.symm b) with h | h
  · left
    have h' := map_dvd φ h
    simpa using h'
  · right
    have h' := map_dvd φ h
    simpa using h'

theorem nccwst_arc_lift : ∀ (E Z : Scheme.{u}) (φ : E ⟶ Z), IsProper φ → ∀ (z : Z) (k : Type u) [Field k] (ψ : Z.presheaf.stalk z →+* PowerSeries k) (ε₀ : E), IsIso (φ.residueFieldMap ε₀) → Z.fromSpecStalk z (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩) = φ ε₀ → ∃ ℓ : Spec (.of (PowerSeries k)) ⟶ E, ℓ ≫ φ = Spec.map (CommRingCat.ofHom ψ) ≫ Z.fromSpecStalk z :=
by
  intro E Z φ hφ z k _ ψ ε₀ hres hgen
  classical
  let A := PowerSeries k
  let K := FractionRing A
  let i₂ : Spec (.of A) ⟶ Z := Spec.map (CommRingCat.ofHom ψ) ≫ Z.fromSpecStalk z
  let g : Spec (.of K) ⟶ Z := Spec.map (CommRingCat.ofHom (algebraMap A K)) ≫ i₂
  let s0 : Spec (.of K) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum K)

  have hg : g s0 = φ ε₀ := by
    rw [← hgen]
    show Z.fromSpecStalk z (PrimeSpectrum.comap ψ
      (PrimeSpectrum.comap (algebraMap A K) ⟨⊥, Ideal.isPrime_bot⟩)) = _
    congr 2
    ext1
    exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective A K)

  obtain ⟨i₁, hi₁⟩ : ∃ i₁ : Spec (.of K) ⟶ E, i₁ ≫ φ = g := by
    obtain ⟨⟨pt, ρ⟩, hp⟩ : ∃ p, Scheme.SpecToEquivOfField K Z g = p := ⟨_, rfl⟩
    have hg' : g = (Scheme.SpecToEquivOfField K Z).symm ⟨pt, ρ⟩ :=
      (Equiv.eq_symm_apply _).mpr hp
    have hpt : pt = φ ε₀ := by
      rw [← hg, hg', Scheme.SpecToEquivOfField_symm_apply]
      show pt = Z.fromSpecResidueField pt (Spec.map ρ s0)
      rw [Scheme.fromSpecResidueField_apply]
    subst hpt
    refine ⟨Spec.map (inv (φ.residueFieldMap ε₀) ≫ ρ) ≫ E.fromSpecResidueField ε₀, ?_⟩
    rw [hg', Scheme.SpecToEquivOfField_symm_apply, Category.assoc,
      ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
      ← Spec.map_comp, IsIso.hom_inv_id_assoc]

  have hV : ValuativeCriterion φ := by
    rw [IsProper.eq_valuativeCriterion] at hφ
    exact hφ.1.1.1
  let S : ValuativeCommSq φ := ⟨A, K, i₁, i₂, ⟨hi₁⟩⟩
  have hL : S.commSq.HasLift := hV.existence S
  exact ⟨S.commSq.lift, S.commSq.fac_right⟩

theorem nccwst_arc_generic_point : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of R)), wcpaDjSemistable u' → ∀ (x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) (X : Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))), X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → x ∈ X → x ∉ closure Xᶜ → ∀ (A : Type u) [CommRing A] [IsDomain A] (ψ : Z'.presheaf.stalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) →+* A), (∀ r ∈ IsLocalRing.maximalIdeal R, ψ ((Z'.presheaf.germ ⊤ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial).hom (wcCnSigma u' ⊤ r)) = 0) → (∃ m ∈ IsLocalRing.maximalIdeal (Z'.presheaf.stalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x)), ψ m ≠ 0) → ∀ x₀, closure {x₀} = X → Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩) = Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x₀ :=
by
  intro R _ _ _ Z' u' hss x X hX hxX hxc A _ _ ψ hkill hm x₀ hx₀
  obtain ⟨hemb, -, -, -, hmax⟩ := wcpa_dj_nccw_special_fibre_topology R Z' u' hss.2.1

  have key : Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) ≫ u' =
      Spec.map ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ u'.appTop ≫
        Z'.presheaf.germ ⊤ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial) := by
    rw [Spec.map_comp, Spec.map_comp, ← Scheme.fromSpecStalk_toSpecΓ]
    simp only [Category.assoc]
    rw [← Category.assoc Z'.toSpecΓ, ← Scheme.toSpecΓ_naturality, Category.assoc,
      ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]

  have hkill' : ∀ r ∈ IsLocalRing.maximalIdeal R,
      ψ (((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ u'.appTop ≫
        Z'.presheaf.germ ⊤ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial).hom r) = 0 := by
    intro r hr
    have e : (Z'.presheaf.germ ⊤ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial).hom (wcCnSigma u' ⊤ r) =
        (Z'.presheaf.germ ⊤ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial).hom
          (u'.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) :=
      TopCat.Presheaf.germ_res_apply Z'.presheaf (U := ⊤) (V := ⊤) (homOfLE le_top)
        (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial _
    have h1 := hkill r hr
    rw [e] at h1
    exact h1

  have hu : u' (Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩)) = IsLocalRing.closedPoint R := by
    have e : u' (Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩)) =
        (Spec.map ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ u'.appTop ≫
          Z'.presheaf.germ ⊤ (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) trivial))
          (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩) := by
      rw [← key]; rfl
    rw [e]
    apply PrimeSpectrum.ext
    symm
    apply (IsLocalRing.maximalIdeal.isMaximal R).eq_of_le (PrimeSpectrum.isPrime _).ne_top
    intro r hr
    show ψ _ ∈ (⊥ : Ideal A)
    rw [Ideal.mem_bot]
    exact hkill' r hr

  obtain ⟨m, hm1, hm2⟩ := hm
  have hpc : PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩ ≠ IsLocalRing.closedPoint _ := by
    intro h
    apply hm2
    have h2 : m ∈ (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩).asIdeal := by rw [h]; exact hm1
    exact Ideal.mem_bot.mp (h2 : ψ m ∈ (⊥ : Ideal A))
  have hgx : Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩) ⤳ Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x := by
    have h := (IsLocalRing.specializes_closedPoint (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩)).map
      (Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x)).continuous
    rwa [Scheme.fromSpecStalk_closedPoint] at h
  have hgne : Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩) ≠ Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x := by
    intro h
    apply hpc
    apply (Z'.fromSpecStalk (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x)).isEmbedding.injective
    rw [h, Scheme.fromSpecStalk_closedPoint]

  obtain ⟨x₁, hx₁, hcomp⟩ := hmax _ hu (fun w hw hwg =>
    (wcpa_dj_ldx_ncds_chain_short_special R Z' u' hss w _ _ hw hwg hgx).resolve_right hgne)

  have hx₁x : x₁ ⤳ x := hemb.isInducing.specializes_iff.mp (by rw [hx₁]; exact hgx)

  have hC : closure {x₁} = X := by
    have hXcl : IsClosed X := isClosed_of_mem_irreducibleComponents X hX
    have hcov : closure {x₁} ⊆ X ∪ closure Xᶜ := fun y _ => by
