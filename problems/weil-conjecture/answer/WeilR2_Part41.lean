    Function.Injective (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) ∧
      IsDomain R ∧ IsIntegrallyClosed R :=
by
  intro R _ _ _ hdom hic
  haveI := hdom
  haveI := hic

  have hinj : Function.Injective
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) := by
    have hfun : ⇑(algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) =
        ⇑(AdicCompletion.of (IsLocalRing.maximalIdeal R) R) := by
      funext r
      rw [AdicCompletion.algebraMap_apply]
      rfl
    rw [hfun]
    exact AdicCompletion.of_injective _ _
