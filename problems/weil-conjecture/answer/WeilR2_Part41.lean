theorem wcpa_dj_nccw_gntsl_minimal_field : ∀ (X : Scheme.{u}) (x g : X) (hg : g ⤳ x), _root_.IsReduced (X.presheaf.stalk x) → RingHom.ker (X.presheaf.stalkSpecializes hg ≫ X.residue g).hom ∈ minimalPrimes (X.presheaf.stalk x) → IsField (X.presheaf.stalk g) :=
