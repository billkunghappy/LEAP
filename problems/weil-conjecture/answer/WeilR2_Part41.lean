      ((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D j)))).inv ≫ (z ≫ τ i j).appTop).hom
          (AdjoinRoot.root (wcpaBscPoly D j)) =
        ((z ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤ h).hom
            (wcpaBscU D i j) *
          ((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D i)))).inv ≫
            (z ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι).appTop).hom (AdjoinRoot.root (wcpaBscPoly D i)) +
        ((z ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤ h).hom
            (wcpaBscBeta D i j) := by
    intro i j Z z h
    have hσ : ⊤ ≤ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ⁻¹ᵁ
