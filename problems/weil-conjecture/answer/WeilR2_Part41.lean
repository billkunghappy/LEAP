    have eS : ∀ z, S z = Matrix.of (Fin.snoc (α := fun _ => Fin (r + 1) → B) (fun i => G i) z) := fun z => by rw [hS]
    have eS' : ∀ z, S' z = Matrix.of (Fin.snoc (α := fun _ => Fin (p + 1) → B) (fun i => G' i) z) := fun z => by rw [hS']
    have hF : ∀ w : Fin (p + 1) → B,
        Matrix.fromBlocks Ch Ψ Ah (S' w) * Matrix.fromBlocks (-S (Matrix.vecMul w Φ)) 0 Φ 1 = Matrix.fromBlocks 1 Ψ 0 (S' w) := by
      intro w
      rw [Matrix.fromBlocks_multiply, Matrix.mul_neg, Matrix.mul_neg, eS, eS', hCh, hCS, hAh, hAS, hSM, ← R1, R3]
