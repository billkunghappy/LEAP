        _ = Spec.map (CommRingCat.ofHom (wcpaBscEval K σ V h)) ≫
              (hV.fromSpec ≫ wcpaLqDelta g ι) ≫ Limits.pullback.fst g (ι ≫ g) := by rw [hδΩ]
        _ = (Spec.map (CommRingCat.ofHom (wcpaBscEval K σ V h)) ≫ hV.fromSpec) ≫
              wcpaLqDelta g ι ≫ Limits.pullback.fst g (ι ≫ g) := by simp only [Category.assoc]
        _ = σ ≫ ι := by rw [hσfac, hδf]
    · rw [Category.assoc, hjs, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hχ2,
        CommRingCat.ofHom_id, Spec.map_id, hτs]
  obtain ⟨x, hxdef⟩ : ∃ x : Spec (.of (TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω))),
      x = Spec.map (CommRingCat.ofHom χ) (IsLocalRing.closedPoint K) := ⟨_, rfl⟩
  have hpt : j x = τ (IsLocalRing.closedPoint K) := by
