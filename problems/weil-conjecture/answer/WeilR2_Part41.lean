        intro V r y hy j l
        beta_reduce
        rw [map_mul, map_mul, resX, resX, hy j l]
        ring
      let P : (X.Opens)ᵒᵖ ⥤ Ab.{u} :=
        { obj := fun V => AddCommGrpCat.of (S V.unop)
          map := fun {V W} i => AddCommGrpCat.ofHom
            { toFun := fun p => ⟨fun j =>
                  (X.presheaf.map (homOfLE (inf_le_inf_right (U j) i.unop.le)).op).hom (p.1 j),
