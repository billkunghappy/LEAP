        have hpt' : pt ⟨X, Sum.inr ⟨⟨sc.down.1 + 1, sc.down.2⟩⟩⟩ = pt ⟨X, Sum.inr sc⟩ := by
          rw [hptC, hptC]
        have hd2 : dom (pt ⟨X, Sum.inr ⟨⟨sc.down.1 + 1, sc.down.2⟩⟩⟩) := by rw [hpt']; exact hd
        refine ⟨?_, ?_, ?_, Or.inr ⟨rfl, ?_⟩⟩
        · intro e
          have e2 : eps ⟨X, Sum.inr ⟨⟨sc.down.1 + 1, sc.down.2⟩⟩⟩ = eps ⟨X, Sum.inr sc⟩ := by rw [e]
          rw [hepsC, hepsC] at e2
          exact hf1 _ e2
        · rw [hpaC, if_pos hd2]
          congr 1
          exact hsigC _ _ _ (hf3 _)
        · rw [hwdom _ hd, hwdom _ hd2, hpt']
        · rw [hdC, hdC]
          have hd' := hd
          rw [hptC] at hd'
          rw [if_pos hd', if_pos hd']
          obtain ⟨hs1, hs2, hs3⟩ := hCprop X sc
          rw [hptC] at hs1 hs2 hs3
          exact hy01 _ ((hpairC X.1 _ (hTE X.1 X.2) hs1 hs2 hs3 hd').1) sc.down.1
      · rw [hpaC, if_neg hd] at hpx
        exact absurd hpx (by simp)
  ·
    have hpt0 : ∀ h1 h2 : (Σ X : ↥T, (↥(((X).1 ∩ closure (X).1ᶜ) \ nccwEint R u u' ν ν' q q' zk η) ⊕ ULift.{u} {i : Fin n // ∃ x ∈ (X).1, ∃ p, (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x = (τ' i) ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) p)}) ⊕ ULift.{u} {ε : Fin 2 // nccwSN R u' (X).1}), w h1 = w h2 → pt h1 = pt h2 := fun h1 h2 e =>
      hemb.injective (by rw [← hwν, ← hwν, e])
    rintro ⟨X, (sa | sb) | sc⟩ ⟨X', (sa' | sb') | sc'⟩ hne12 hw12 <;>
      have hpt := hpt0 _ _ hw12 <;> have hXc := hTc X.1 X.2 <;> have hX'c := hTc X'.1 X'.2
    ·
      rw [hptA, hptA] at hpt
      have hXX' : X.1 ≠ X'.1 := fun e => hne12 (hsigA _ _ _ _ e hpt)
      have hx' : sa.1 ∈ X'.1 := by rw [hpt]; exact sa'.2.1.1
      have hb : X'.1 = Xb X.1 sa.1 :=
        hXbuniq X.1 hXc sa.1 sa.2.1.1 sa.2.1.2 X'.1 hX'c (Ne.symm hXX') hx'
      have hns := (hAprop X sa).2
      by_cases hd : dom sa.1
      · rw [hpaA, dif_pos ⟨hd, by rw [← hb]; exact X'.2⟩]
        exact congrArg some (hsigA _ X' _ sa' hb.symm hpt)
      · have hd' : ¬ dom (pt ⟨X, Sum.inl (Sum.inl sa)⟩) := by rw [hptA]; exact hd
        have e1 := hwndom _ hd'
        rw [hptA, hepsA] at e1
        obtain ⟨g1, g2⟩ := hdgood ⟨X, Sum.inl (Sum.inl sa)⟩
        obtain ⟨g3, g4⟩ := hdgood ⟨X', Sum.inl (Sum.inl sa')⟩
        exact absurd ⟨⟨_, g1, g2.trans e1⟩, ⟨_, g3, g4.trans (hw12.symm.trans e1)⟩⟩
          ((hWg sa.1 hns hd).2.2.2.1 X.1 hXc X'.1 hX'c hXX' sa.2.1.1 hx' _)
    ·
      have hsm := (hmark _ _ (hBprop X' sb').2).1
      rw [← hpt, hptA] at hsm
      exact absurd hsm (hAprop X sa).2
    ·
      obtain ⟨hs1, hs2, -⟩ := hCprop X' sc'
      rw [← hpt, hptA] at hs1 hs2
      by_cases e : X.1 = X'.1
      · rw [← e] at hs2; exact absurd sa.2.1.2 hs2
      · exact absurd (hcl X'.1 hX'c X.1 hXc e sa.2.1.1) hs2
    ·
      have hsm := (hmark _ _ (hBprop X sb).2).1
      rw [hpt, hptA] at hsm
      exact absurd hsm (hAprop X' sa').2
    ·
      obtain ⟨hm1, hf1'⟩ := hBprop X sb
      obtain ⟨hm2, hf2'⟩ := hBprop X' sb'
      have hii : sb.down.1 = sb'.down.1 := by
        by_contra hii
        exact hst'.2.1.2.1 _ _ _ _ hii (hf1'.symm.trans ((congrArg _ hpt).trans hf2'))
      have hsm := (hmark _ _ hf1').1
      rw [hpt] at hm1 hsm
      have hXX := wcpa_dj_nccw_hp_smooth_one_component R Z' u' _ hsm _ hXc _ hX'c hm1 hm2
      exact absurd (hsigB _ _ _ _ hXX hii) hne12
    ·
      have hsm := (hmark _ _ (hBprop X sb).2).1
      rw [hpt] at hsm
      exact absurd hsm (hCprop X' sc').2.2
    ·
      obtain ⟨hs1, hs2, -⟩ := hCprop X sc
      rw [hpt, hptA] at hs1 hs2
      by_cases e : X'.1 = X.1
      · rw [← e] at hs2; exact absurd sa'.2.1.2 hs2
      · exact absurd (hcl X.1 hXc X'.1 hX'c e sa'.2.1.1) hs2
    ·
      have hsm := (hmark _ _ (hBprop X' sb').2).1
      rw [← hpt] at hsm
      exact absurd hsm (hCprop X sc).2.2
    ·
      obtain ⟨hs1, hs2, hs3⟩ := hCprop X sc
      obtain ⟨hs1', -, -⟩ := hCprop X' sc'
      have hXX : X = X' := by
        apply Subtype.ext
        by_contra e
        rw [← hpt] at hs1'
        exact hs2 (hcl X.1 hXc X'.1 hX'c (Ne.symm e) hs1')
      subst hXX
      have hεε : sc.down.1 ≠ sc'.down.1 := fun e => hne12 (hsigC _ _ _ e)
      by_cases hd : dom (pt ⟨X, Sum.inr sc⟩)
      · rw [hpaC, if_pos hd]
        exact congrArg some (hsigC _ _ _ (hf4 _ _ hεε).symm)
      · have hd2 : ¬ dom (pt ⟨X, Sum.inr sc'⟩) := by rw [← hpt]; exact hd
        have e1 := hwndom _ hd
        have e2 := hwndom _ hd2
        rw [hepsC] at e1 e2
        rw [e1, e2, ← hpt] at hw12
        exact absurd (hWne _ (hWg _ hs3 hd).1 _ _ hw12) hεε

theorem wcpa_dj_nccw_walk {N : Type*} (F : Set N) (𝒞 𝒳 : Set (Set N)) {Hp : Type*} (Φ D Tg : Hp → Set N) (d e : Hp → N) (partner : Hp → Option Hp) (A1 : ∀ L ∈ 𝒞, ¬ L ⊆ F → L ∈ 𝒳) (A3 : ∀ x, D x ⊆ F ∧ d x ∈ D x ∧ d x ∈ Φ x) (A4 : ∀ x, ∀ y ∈ Φ x, ∀ z ∈ Φ x, nccwXChain 𝒞 (Φ x) {y} {z}) (A5 : ∀ x, partner x = none → Tg x ∈ 𝒳 ∧ e x ∈ Tg x ∧ e x ∈ Φ x) (A6 : ∀ x x', partner x = some x' → x' ≠ x ∧ partner x' = some x ∧ Φ x' = Φ x ∧ ¬ nccwXChain {L | L ∈ 𝒞 ∧ L ⊆ F} (Φ x) {d x} {d x'}) (A7 : ∀ x x', x ≠ x' → (Φ x ∩ Φ x').Nonempty → partner x = some x') : ∃ σ : Hp → Set N × N, Function.Injective σ ∧ ∀ x, σ x ∈ {p : Set N × N | p.1 ∈ 𝒳 ∧ p.2 ∈ p.1 ∧ p.2 ∈ F} :=
by
  classical

  have s1a : ∀ (𝒦 : Set (Set N)) (Ψ : Set N) (a b : N), nccwXChain 𝒦 Ψ {a} {b} →
      a ∈ Ψ ∧ Relation.ReflTransGen (fun u v : N => ∃ L ∈ 𝒦, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) a b := by
    intro 𝒦 Ψ a b hc
    obtain ⟨s, L, p, hL, hp, h0, hs, hstep⟩ := hc
    rw [Set.mem_singleton_iff] at h0 hs
    subst h0
    subst hs
    refine ⟨hp 0, ?_⟩
    have key : ∀ t : Fin (s + 1),
        Relation.ReflTransGen (fun u v : N => ∃ L ∈ 𝒦, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) (p 0) (p t) := by
      intro t
      induction t using Fin.induction with
      | zero => exact Relation.ReflTransGen.refl
      | succ i ih => exact ih.tail ⟨L i, (hL i).1, (hL i).2, (hstep i).1, (hstep i).2⟩
    exact key _

  have s1b : ∀ (𝒦 : Set (Set N)) (Ψ : Set N) (a b : N), a ∈ Ψ →
      Relation.ReflTransGen (fun u v : N => ∃ L ∈ 𝒦, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) a b →
      nccwXChain 𝒦 Ψ {a} {b} := by
    intro 𝒦 Ψ a b ha h
    induction h with
    | refl =>
      exact ⟨0, fun i => i.elim0, fun _ => a, fun t => t.elim0, fun _ => ha, rfl, rfl,
        fun t => t.elim0⟩
    | @tail b c _ hbc ih =>
      obtain ⟨M, hM, hMΨ, hbM, hcM⟩ := hbc
      obtain ⟨s, L, p, hL, hp, h0, hs, hstep⟩ := ih
      rw [Set.mem_singleton_iff] at hs
      refine ⟨s + 1, Fin.snoc (α := fun _ => Set N) L M, Fin.snoc (α := fun _ => N) p c,
        ?_, ?_, ?_, ?_, ?_⟩
      · intro t
        refine Fin.lastCases ?_ (fun i => ?_) t
        · simp only [Fin.snoc_last]
          exact ⟨hM, hMΨ⟩
        · simp only [Fin.snoc_castSucc]
          exact hL i
      · intro t
        refine Fin.lastCases ?_ (fun i => ?_) t
        · simp only [Fin.snoc_last]
          exact hMΨ hcM
        · simp only [Fin.snoc_castSucc]
          exact hp i
      · rw [show (0 : Fin (s + 1 + 1)) = Fin.castSucc (0 : Fin (s + 1)) from
          Fin.castSucc_zero.symm, Fin.snoc_castSucc]
        exact h0
      · simp only [Fin.snoc_last]
        exact Set.mem_singleton c
      · intro t
        refine Fin.lastCases ?_ (fun i => ?_) t
        · simp only [Fin.snoc_castSucc, Fin.succ_last, Fin.snoc_last]
          rw [hs]
          exact ⟨hbM, hcM⟩
        · simp only [Fin.snoc_castSucc, Fin.succ_castSucc]
          exact hstep i

  have s2 : ∀ (Ψ : Set N) (a b : N),
      Relation.ReflTransGen (fun u v : N => ∃ L ∈ 𝒞, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) a b →
      Relation.ReflTransGen
          (fun u v : N => ∃ L ∈ {L | L ∈ 𝒞 ∧ L ⊆ F}, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) a b ∨
        ∃ L ∈ 𝒞, L ⊆ Ψ ∧ ¬ L ⊆ F ∧ ∃ p ∈ L, Relation.ReflTransGen
          (fun u v : N => ∃ L ∈ {L | L ∈ 𝒞 ∧ L ⊆ F}, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) a p := by
    intro Ψ a b h
    induction h with
    | refl => exact Or.inl Relation.ReflTransGen.refl
    | @tail b c _ hbc ih =>
      obtain ⟨M, hM, hMΨ, hbM, hcM⟩ := hbc
      rcases ih with hF | hex
      · by_cases hMF : M ⊆ F
        · exact Or.inl (hF.tail ⟨M, ⟨hM, hMF⟩, hMΨ, hbM, hcM⟩)
        · exact Or.inr ⟨M, hM, hMΨ, hMF, b, hbM, hF⟩
      · exact Or.inr hex

  have s3 : ∀ (Ψ : Set N) (a y : N), a ∈ F → a ∈ Ψ →
      Relation.ReflTransGen
          (fun u v : N => ∃ L ∈ {L | L ∈ 𝒞 ∧ L ⊆ F}, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) a y →
      y ∈ F ∧ y ∈ Ψ := by
    intro Ψ a y haF haΨ h
    induction h with
    | refl => exact ⟨haF, haΨ⟩
    | tail _ hbc _ =>
      obtain ⟨M, ⟨_, hMF⟩, hMΨ, _, hcM⟩ := hbc
      exact ⟨hMF hcM, hMΨ hcM⟩

  have hsymm : ∀ (Ψ : Set N) (u v : N),
      Relation.ReflTransGen
          (fun u v : N => ∃ L ∈ {L | L ∈ 𝒞 ∧ L ⊆ F}, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) u v →
      Relation.ReflTransGen
          (fun u v : N => ∃ L ∈ {L | L ∈ 𝒞 ∧ L ⊆ F}, L ⊆ Ψ ∧ u ∈ L ∧ v ∈ L) v u := by
    intro Ψ u v h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | tail _ hbc ih =>
      obtain ⟨M, hM, hMΨ, hb, hc⟩ := hbc
      exact Relation.ReflTransGen.head ⟨M, hM, hMΨ, hc, hb⟩ ih

  have s5 : ∀ x, ∃ q : Set N × N, (q.1 ∈ 𝒳 ∧ q.2 ∈ q.1 ∧ q.2 ∈ F) ∧ q.2 ∈ Φ x ∧
      ∀ x', partner x = some x' → Relation.ReflTransGen
        (fun u v : N => ∃ L ∈ {L | L ∈ 𝒞 ∧ L ⊆ F}, L ⊆ Φ x ∧ u ∈ L ∧ v ∈ L) (d x) q.2 := by
    intro x
    obtain ⟨hDF, hdD, hdΦ⟩ := A3 x
    have hdF : d x ∈ F := hDF hdD
    cases hpx : partner x with
    | some x' =>
      obtain ⟨_, _, hΦ', hno⟩ := A6 x x' hpx
      have hd' : d x' ∈ Φ x := by rw [← hΦ']; exact (A3 x').2.2
      obtain ⟨_, hw⟩ := s1a 𝒞 (Φ x) (d x) (d x') (A4 x (d x) hdΦ (d x') hd')
      rcases s2 (Φ x) _ _ hw with hF | ⟨L, hL, hLΦ, hLF, p, hpL, hp⟩
      · exact absurd (s1b _ (Φ x) (d x) (d x') hdΦ hF) hno
      · exact ⟨(L, p), ⟨A1 L hL hLF, hpL, (s3 _ _ _ hdF hdΦ hp).1⟩, hLΦ hpL, fun _ _ => hp⟩
    | none =>
      obtain ⟨hTg, he, heΦ⟩ := A5 x hpx
      obtain ⟨_, hw⟩ := s1a 𝒞 (Φ x) (d x) (e x) (A4 x (d x) hdΦ (e x) heΦ)
      rcases s2 (Φ x) _ _ hw with hF | ⟨L, hL, hLΦ, hLF, p, hpL, hp⟩
      · exact ⟨(Tg x, e x), ⟨hTg, he, (s3 _ _ _ hdF hdΦ hF).1⟩, heΦ,
          fun _ h => by simp at h⟩
      · exact ⟨(L, p), ⟨A1 L hL hLF, hpL, (s3 _ _ _ hdF hdΦ hp).1⟩, hLΦ hpL, fun _ _ => hp⟩

  choose σ hσmem hσΦ hσR using s5
  refine ⟨σ, ?_, fun x => hσmem x⟩
  intro x x' hxx'
  by_contra hne
  have hg' : (σ x).2 ∈ Φ x' := by rw [hxx']; exact hσΦ x'
  have hpx := A7 x x' hne ⟨(σ x).2, hσΦ x, hg'⟩
  obtain ⟨_, hpx', hΦ', hno⟩ := A6 x x' hpx
  have h1 := hσR x x' hpx
  have h2 := hσR x' x hpx'
  rw [hΦ', ← hxx'] at h2
  exact hno (s1b _ (Φ x) (d x) (d x') (A3 x).2.2 (h1.trans (hsymm _ _ _ h2)))

theorem wcpa_dj_nccw_fibre_walk : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ w : S', IsClosed ({w} : Set S') → (ν' ≫ u') w = IsLocalRing.closedPoint R → IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (S'.presheaf.stalk w)) (S'.presheaf.stalk w)) → ∀ x ∈ ⇑q' ⁻¹' {w}, ∀ y ∈ ⇑q' ⁻¹' {w}, nccwXChain (nccwC (q ≫ ν ≫ u)) (⇑q' ⁻¹' {w}) {x} {y} :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
    w hw1 hw2 hw3 x hx y hy
  obtain ⟨hcomp, -, ⟨-, -, hFC, -, -, -, hCh⟩, -, hS⟩ := hA
  obtain ⟨⟨h1a, h1b⟩, -, -, ⟨-, -, hfl', hlft', hflN, -⟩, ⟨-, hq'p⟩, ⟨-, hV'⟩, -, -, -, -,
    ⟨hnoeth, -⟩, -, -⟩ := hS

  have hcomp' : q' ≫ ν' ≫ u' = q ≫ ν ≫ u := by
    rw [← Category.assoc q' ν' u', h1b, ← Category.assoc q ν u, h1a]
    simp only [Category.assoc, Limits.pullback.condition]
  have hΦM : ⇑q' ⁻¹' {w} ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} := by
    intro z hz
    have hz' : q' z = w := hz
    show (q ≫ ν ≫ u) z = IsLocalRing.closedPoint R
    rw [← hcomp', Scheme.Hom.comp_apply, hz']
    exact hw2

  have hflat : Flat (q' ≫ ν' ≫ u') := by rw [hcomp']; exact hflN
  have hpc : _root_.IsPreconnected (⇑q' ⁻¹' {w}) :=
    hFC R hcomp S' N (ν' ≫ u') q' hfl' hlft' hq'p hflat hV' w hw2 hw1 hw3

  have hΦc : IsClosed (⇑q' ⁻¹' {w}) := hw1.preimage q'.continuous
  haveI : TopologicalSpace.NoetherianSpace
      ↥(⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) := hnoeth
  haveI : TopologicalSpace.NoetherianSpace ↥(⇑q' ⁻¹' {w}) :=
    (Topology.IsEmbedding.inclusion hΦM).isInducing.noetherianSpace

  obtain ⟨r, K, hK, hx0, hyr, hadj⟩ :=
    hCh ↥(⇑q' ⁻¹' {w}) (Subtype.preconnectedSpace hpc) ⟨x, hx⟩ ⟨y, hy⟩

  have mini : ∀ (C D : Set ↥(⇑q' ⁻¹' {w})) (p : ↥(⇑q' ⁻¹' {w})),
      C ∈ irreducibleComponents ↥(⇑q' ⁻¹' {w}) → D ∈ irreducibleComponents ↥(⇑q' ⁻¹' {w}) →
      C = {p} → (C ∩ D).Nonempty → D = {p} := by
    intro C D p hC hD hCp hCD
    obtain ⟨z, hzC, hzD⟩ := hCD
    rw [hCp] at hzC
    have hzp : z = p := hzC
    rw [hzp] at hzD
    have hsub : C ⊆ D := by rw [hCp]; exact Set.singleton_subset_iff.mpr hzD
    have hDC : D ⊆ C := hC.2 hD.1 hsub
    rw [hCp] at hDC
    exact Set.Subset.antisymm hDC (Set.singleton_subset_iff.mpr hzD)
  have prop : ∀ p : ↥(⇑q' ⁻¹' {w}), (∃ t, K t = {p}) → ∀ t, K t = {p} := by
    intro p ⟨t₀, ht₀⟩
    have down : ∀ m (hm : m ≤ r), K ⟨m, by omega⟩ = {p} → K ⟨0, by omega⟩ = {p} := by
      intro m
      induction m with
      | zero => intro _ hh; exact hh
      | succ m ih =>
        intro hm hh
        apply ih (by omega)
        have hI := hadj ⟨m, by omega⟩
        have e1 : (⟨m, by omega⟩ : Fin r).castSucc = ⟨m, by omega⟩ := rfl
        have e2 : (⟨m, by omega⟩ : Fin r).succ = ⟨m + 1, by omega⟩ := rfl
        rw [e1, e2] at hI
        exact mini _ _ p (hK _) (hK _) hh (by rwa [Set.inter_comm] at hI)
    have hK0 : K ⟨0, by omega⟩ = {p} := down t₀.val (by have := t₀.isLt; omega) ht₀
    have up : ∀ m (hm : m ≤ r), K ⟨m, by omega⟩ = {p} := by
      intro m
      induction m with
      | zero => intro _; exact hK0
      | succ m ih =>
        intro hm
        have hI := hadj ⟨m, by omega⟩
        have e1 : (⟨m, by omega⟩ : Fin r).castSucc = ⟨m, by omega⟩ := rfl
        have e2 : (⟨m, by omega⟩ : Fin r).succ = ⟨m + 1, by omega⟩ := rfl
        rw [e1, e2] at hI
        exact mini _ _ p (hK _) (hK _) (ih (by omega)) hI
    intro t
    exact up t.val (by have := t.isLt; omega)

  unfold nccwXChain nccwC
  by_cases hnt : ∀ t, (K t).Nontrivial
  ·
    choose c hc using hadj
    have hsub : ∀ t, Subtype.val '' K t ⊆ ⇑q' ⁻¹' {w} := by
      rintro t _ ⟨z, -, rfl⟩
      exact z.property
    refine ⟨r + 1, fun t => Subtype.val '' K t,
      Fin.cons (α := fun _ => (N : Type u)) x
        (Fin.snoc (α := fun _ => (N : Type u)) (fun j => (c j).val) y), ?_, ?_, ?_, ?_, ?_⟩
    · intro t
      refine ⟨?_, hsub t⟩
      rw [Set.mem_setOf_eq]
      refine ⟨?_, ?_, ?_, (hsub t).trans hΦM⟩
      · exact (isClosed_of_mem_irreducibleComponents _ (hK t)).trans hΦc
      · exact (hK t).1.image _ continuous_subtype_val.continuousOn
      · exact (hnt t).image Subtype.val_injective
    · intro t
      refine Fin.cases ?_ (fun k => ?_) t
      · rw [Fin.cons_zero]; exact hx
      · rw [Fin.cons_succ]
        refine Fin.lastCases ?_ (fun j => ?_) k
        · rw [Fin.snoc_last]; exact hy
        · rw [Fin.snoc_castSucc]; exact (c j).property
    · rw [Fin.cons_zero]; exact Set.mem_singleton _
    · rw [← Fin.succ_last, Fin.cons_succ, Fin.snoc_last]; exact Set.mem_singleton _
    · intro t
      constructor
      · refine Fin.cases ?_ (fun k => ?_) t
        · rw [Fin.castSucc_zero, Fin.cons_zero]; exact ⟨⟨x, hx⟩, hx0, rfl⟩
        · rw [← Fin.succ_castSucc, Fin.cons_succ, Fin.snoc_castSucc]
          exact ⟨c k, (hc k).2, rfl⟩
      · rw [Fin.cons_succ]
        refine Fin.lastCases ?_ (fun j => ?_) t
        · rw [Fin.snoc_last]; exact ⟨⟨y, hy⟩, hyr, rfl⟩
        · rw [Fin.snoc_castSucc]; exact ⟨c j, (hc j).1, rfl⟩
  · obtain ⟨t₀, ht₀⟩ := not_forall.mp hnt
    obtain ⟨p₀, hp₀⟩ := (hK t₀).1.nonempty
    have hsing : K t₀ = {p₀} := (Set.not_nontrivial_iff.mp ht₀).eq_singleton_of_mem hp₀
    have hall := prop p₀ ⟨t₀, hsing⟩
    rw [hall 0] at hx0
    rw [hall (Fin.last r)] at hyr
    have hx' : (⟨x, hx⟩ : ↥(⇑q' ⁻¹' {w})) = p₀ := hx0
    have hy' : (⟨y, hy⟩ : ↥(⇑q' ⁻¹' {w})) = p₀ := hyr
    have hxy : x = y := congrArg Subtype.val (hx'.trans hy'.symm)
    subst hxy
    exact ⟨0, fun t => t.elim0, fun _ => x, fun t => t.elim0, fun _ => hx, Set.mem_singleton x,
      Set.mem_singleton x, fun t => t.elim0⟩

theorem wcpa_dj_ncc_walk_injection : wcpaDjNcForest.{u} → wcpaDjNcLocStr.{u} → wcpaDjNcFibConn.{u} → wcpaDjNcGenIso.{u} → wcpaDjNccNagata.{u} → wcpaDjNccExcellent.{u} → wcpaDjNccChain.{u} → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (Z Z' : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')), 3 ≤ n → wcpaDjStablePtd u n τ → wcpaDjStablePtd u' n τ' → GeometricallyConnected u → GeometricallyConnected u' → ∀ (Y : Scheme.{u}) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u'), IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → IsPullback a' π u' (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → (∀ i, ∃ t : Spec (.of (FractionRing R)) ⟶ Y, t ≫ π = 𝟙 _ ∧ t ≫ a = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τ i ∧ t ≫ a' = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τ' i) → ∀ (G : Scheme.{u}) (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G), IsClosedImmersion ι → AlgebraicGeometry.IsReduced G → IsOpenImmersion j → Dense (Set.range ⇑j) → j ≫ ι = Limits.pullback.lift a a' h → (∀ γ : G, (ι ≫ Limits.pullback.fst u u') γ ∈ Set.range ⇑a → γ ∈ Set.range ⇑j) → ∀ γ γ' : G, γ' ⤳ γ → γ' ≠ γ → (ι ≫ Limits.pullback.fst u u') γ' = (ι ≫ Limits.pullback.fst u u') γ → u ((ι ≫ Limits.pullback.fst u u') γ) = IsLocalRing.closedPoint R → IsClosed ({(ι ≫ Limits.pullback.fst u u') γ} : Set Z) → (∀ x : Z', u' x = IsLocalRing.closedPoint R → x ⤳ (ι ≫ Limits.pullback.snd u u') γ' → x = (ι ≫ Limits.pullback.snd u u') γ') → wcpaDjNccWalkOut R u' n τ' :=
by
  classical
  intro hF hL hC hG hN hE hCh R _ _ _ hcomp halg Z Z' u u' n τ τ' hn hst hst' hgc hgc' Y π a a'
    h hpb hpb' hsec G ι j hι hGr hj hjd hjι hjr γ γ' hγ hne hp hu hz hmax
