theorem wcpa_dj_nccw_gn_sheet_generization : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (S : Scheme.{u}) [IsLocallyNoetherian S] (g : S ⟶ Spec (.of R)) (w : S), g w = IsLocalRing.closedPoint R → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk w)) (S.presheaf.stalk w) ≃+* PowerSeries R, e.toRingHom.comp ((algebraMap (S.presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk w)) (S.presheaf.stalk w))).comp ((S.presheaf.germ ⊤ w trivial).hom.comp (wcCnSigma g ⊤))) = PowerSeries.C) → ∃ ω₀ : S, ω₀ ⤳ w ∧ ω₀ ≠ w ∧ g ω₀ = IsLocalRing.closedPoint R ∧ ∀ ω : S, ω ⤳ w → g ω = IsLocalRing.closedPoint R → ω₀ ⤳ ω :=
