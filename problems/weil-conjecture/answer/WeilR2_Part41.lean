  obtain ⟨hndfin, hthree⟩ := wcpa_dj_ncc_fibre_points R halg Z' u' hst'.1
  obtain ⟨hF2, -⟩ := wcpa_dj_nccw_fibre_forest R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ'
    ν ν' μ q q' st zk η₀ η ηZ hA
  have hKne : ∀ L ∈ nccwKF (q ≫ ν ≫ u) q zk, L.Nonempty := fun L hL => hL.1.2.2.1.nonempty
  have hs5 := wcpa_dj_nccw_chain_acyclic (nccwKF (q ≫ ν ≫ u) q zk) hKne hF2

  have hxu : ∀ x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
