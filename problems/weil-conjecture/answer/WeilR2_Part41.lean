    have hθ := congrArg ((Scheme.ΓSpecIso (CommRingCat.of (AdjoinRoot (wcpaBscPoly D i)))).inv ≫
          (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι.appTop).hom hθ0
    simp only [map_add, map_sub, map_mul, map_pow, map_zero] at hθ
    have hroot := LT2 i j (R := Γ(((wcpaBscChartMap D i ⁻¹ᵁ D.V j : (wcpaBscChart D i).Opens) :
        Scheme.{u}), ⊤))
      (((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V i ⊓ D.V j) ⊤ hσij).hom
      (((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i).appLE (D.V j) ⊤ hσj).hom
      (fun x => (Fres _ _ _ _ hσij hσj x).symm) _ _ _ _ hθ (hc _) (hc _) (hc _)
    have mkφ : ∀ {R : CommRingCat.{u}} (g : Γ(S, D.V j) →+* R) (t : R),
