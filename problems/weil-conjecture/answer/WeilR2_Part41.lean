  choose ψ hψ using fun l : Fin (r + 1) => hsurj' (π (MvPolynomial.X l))
  have hΘ : ∀ Q : MvPolynomial (Fin (p + 1)) R, π (MvPolynomial.aeval φ Q) = π' Q := by
    intro Q
