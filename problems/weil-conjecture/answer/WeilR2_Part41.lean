      let U := L.V
      let S : ∀ V : X.Opens, AddSubgroup (∀ j : Fin L.m, Γ(X, V ⊓ U j)) := fun V =>
        { carrier := {y | ∀ (j l : Fin L.m),
            (X.presheaf.map (homOfLE (inf_le_left : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U j)).op).hom (y j) =
            (X.presheaf.map (homOfLE (le_inf (inf_le_right.trans inf_le_right)
              (inf_le_left.trans inf_le_right) : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ U l ⊓ U j)).op).hom (c l j) *
            (X.presheaf.map (homOfLE (inf_le_right : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U l)).op).hom (y l)}
          add_mem' := fun {y y'} hy hy' j l => by
            simp only [Pi.add_apply, map_add, mul_add]
            rw [hy j l, hy' j l]
          zero_mem' := fun j l => by
            simp only [Pi.zero_apply, map_zero, mul_zero]
          neg_mem' := fun {y} hy j l => by
            simp only [Pi.neg_apply, map_neg, mul_neg]
            rw [hy j l] }
      have resMem : ∀ (V W : X.Opens) (hh : W ≤ V) (y : ∀ j : Fin L.m, Γ(X, V ⊓ U j)), y ∈ S V →
          (fun j => (X.presheaf.map (homOfLE (inf_le_inf_right (U j) hh)).op).hom (y j)) ∈ S W := by
        intro V W hh y hy j l
        have hΩ : (W ⊓ U j) ⊓ (W ⊓ U l) ≤ (V ⊓ U j) ⊓ (V ⊓ U l) :=
          inf_le_inf (inf_le_inf_right (U j) hh) (inf_le_inf_right (U l) hh)
        have e := congrArg (X.presheaf.map (homOfLE hΩ).op).hom (hy j l)
        rw [map_mul, resX, resX, resX] at e
        beta_reduce
        rw [resX, resX]
        exact e
      have smulMem : ∀ (V : X.Opens) (r : Γ(X, V)) (y : ∀ j : Fin L.m, Γ(X, V ⊓ U j)), y ∈ S V →
