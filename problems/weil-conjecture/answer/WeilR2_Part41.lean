    intro B _ hBn I X hXn h hh L hL hpair d
    haveI := hBn
    haveI := hXn
    haveI := hh
    have resX : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
