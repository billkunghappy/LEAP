  have L1' : ∀ t, χ t ≠ 0 → IsUnit (Θ t) := fun t ht =>
    L1 t (by rw [hxid, RingHom.mem_ker]; exact ht)
  have L2' : ∀ y, ∃ t t', χ t' ≠ 0 ∧ y * Θ t' = Θ t := fun y => by
    obtain ⟨t, t', ht', he⟩ := L2 y
    exact ⟨t, t', by rwa [hxid, RingHom.mem_ker] at ht', he⟩
  have L3' : ∀ t, Θ t = 0 → ∃ t', χ t' ≠ 0 ∧ t' * t = 0 := fun t ht => by
    obtain ⟨t', ht', he⟩ := L3 t ht
    exact ⟨t', by rwa [hxid, RingHom.mem_ker] at ht', he⟩
  have hχs : Function.Surjective χ := fun k =>
    ⟨algebraMap K (TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω)) k, RingHom.congr_fun hχ2 k⟩
  obtain ⟨hcomap, hsurj⟩ := s10 K (TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω))
    ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) Θ χ hχs L1' L2' L3'

  refine ⟨?_, ?_⟩
  · apply RingHom.ext
    intro r
    have e1 : (Algebra.TensorProduct.includeRight : Γ(wcpaLqY g ι, Ω) →ₐ[Γ(S, V)]
        TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω))
          (((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom r) =
        algebraMap K (TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω)) (wcpaBscEval K σ V h r) := by
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply]
      exact (Algebra.TensorProduct.tmul_one_eq_one_tmul r).symm
    rw [RingHom.comp_apply, RingHom.comp_apply, ← hΘΨ, e1, hΘφ]
    rfl

  · intro n _
    obtain ⟨e₁, he₁⟩ := s9 Γ(S, V) K Γ(wcpaLqY g ι, Ω)
      (RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ n)
    obtain ⟨e₂, he₂⟩ := s11 K (TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω))
      ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))
      (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
        (τ (IsLocalRing.closedPoint K))) Θ
      (Ideal.map (Algebra.TensorProduct.includeRight : Γ(wcpaLqY g ι, Ω) →ₐ[Γ(S, V)]
        TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω))
        (RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ n))
      (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk
        (τ (IsLocalRing.closedPoint K))) ^ n) hΘa (by rw [hcomap n, hχn n]) (hsurj n)
    refine ⟨e₁.trans e₂, fun k a => ?_⟩
    rw [LinearEquiv.trans_apply, he₁, he₂]
    congr 1
    have e3 : k ⊗ₜ[Γ(S, V)] a = algebraMap K (TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω)) k *
        (Algebra.TensorProduct.includeRight : Γ(wcpaLqY g ι, Ω) →ₐ[Γ(S, V)]
          TensorProduct Γ(S, V) K Γ(wcpaLqY g ι, Ω)) a := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        one_mul]
    rw [e3, map_mul, hΘφ, hΘΨ]

theorem wcpa_dj_lq_prime_point : ∀ (S : Scheme.{u}) (V : S.Opens), IsAffineOpen V →
    ∀ (𝔭 : Ideal Γ(S, V)) [𝔭.IsPrime], ∃ (σ : Spec (.of 𝔭.ResidueField) ⟶ S)
      (h : ⊤ ≤ σ ⁻¹ᵁ V), wcpaBscEval 𝔭.ResidueField σ V h = algebraMap Γ(S, V) 𝔭.ResidueField :=
by
  intro S V hV 𝔭 _
  have hpre : ⊤ ≤ (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) 𝔭.ResidueField)) ≫
      hV.fromSpec) ⁻¹ᵁ V := by
    intro x _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
    have hx : hV.fromSpec ((Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) 𝔭.ResidueField))) x)
        ∈ Set.range hV.fromSpec := ⟨_, rfl⟩
    rw [hV.range_fromSpec] at hx
    exact hx
  refine ⟨Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) 𝔭.ResidueField)) ≫ hV.fromSpec,
    hpre, ?_⟩
  unfold wcpaBscEval
  have key : (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) 𝔭.ResidueField)) ≫
      hV.fromSpec).appLE V ⊤ hpre = (Scheme.ΓSpecIso Γ(S, V)).inv ≫
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) 𝔭.ResidueField))).appTop := by
    rw [Scheme.Hom.comp_appLE, IsAffineOpen.fromSpec_app_self, Category.assoc]
    erw [Scheme.Hom.map_appLE]
    rfl
  rw [key, Category.assoc, Scheme.ΓSpecIso_naturality]
  erw [Iso.inv_hom_id_assoc]
  rfl

theorem wcpa_dj_lq_fe_basis : ∀ (R A K O : Type u) [CommRing R] [CommRing A] [Field K] [CommRing O]
    [IsLocalRing O] [Algebra R K] (π : R →+* A) (μ : A →+* R), μ.comp π = RingHom.id R →
    ∀ (φ : K →+* O) (Ψ : A →+* O), Ψ.comp π = φ.comp (algebraMap R K) →
    (letI := π.toAlgebra
     letI := φ.toAlgebra
     ∀ n : ℕ, 1 ≤ n → n ≤ 2 → ∃ e : TensorProduct R K (A ⧸ RingHom.ker μ ^ n) ≃ₗ[K]
        (O ⧸ IsLocalRing.maximalIdeal O ^ n), ∀ (k : K) (a : A),
          e (k ⊗ₜ Ideal.Quotient.mk (RingHom.ker μ ^ n) a) =
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ n) (φ k * Ψ a)) →
    wcpaLqHilb K O φ → ∀ u v : A, μ u = 0 → μ v = 0 →
    (∀ x, μ x = 0 → x ∈ Ideal.span {u, v} ⊔ RingHom.ker μ ^ 2) →
    (∀ (j : ℕ) (x : A), x ∈ RingHom.ker μ ^ j → Ψ x ∈ IsLocalRing.maximalIdeal O ^ j) ∧
      wcpaLqBasis K O φ (Ψ u) (Ψ v) :=
by
  intro R A K O _ _ _ _ _ _ π μ hμπ φ Ψ hΨπ hE hHilb u v hu hv hspan
  letI := φ.toAlgebra

  have s1 : ∀ x : A, μ x = 0 → Ψ x ∈ IsLocalRing.maximalIdeal O := by
    intro x hx
    obtain ⟨e, he⟩ := hE 1 le_rfl (by norm_num)
    have h0 : Ideal.Quotient.mk (RingHom.ker μ ^ 1) x = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_one]; exact hx
    have h1 := he 1 x
    rw [h0, TensorProduct.tmul_zero, map_zero, map_one, one_mul] at h1
    have h2 := (Ideal.Quotient.eq_zero_iff_mem).mp h1.symm
    rwa [pow_one] at h2

  have s2 : ∀ (j : ℕ) (x : A), x ∈ RingHom.ker μ ^ j → Ψ x ∈ IsLocalRing.maximalIdeal O ^ j := by
    have hle : Ideal.map Ψ (RingHom.ker μ) ≤ IsLocalRing.maximalIdeal O := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact s1 x hx
    intro j x hx
    have h1 : Ψ x ∈ Ideal.map Ψ (RingHom.ker μ ^ j) := Ideal.mem_map_of_mem Ψ hx
    rw [Ideal.map_pow] at h1
    exact Ideal.pow_right_mono hle j h1

  have hΨπ' : ∀ s : R, Ψ (π s) = φ (algebraMap R K s) := fun s => RingHom.congr_fun hΨπ s
  have hμπ' : ∀ s : R, μ (π s) = s := fun s => RingHom.congr_fun hμπ s
  have hm2 : ∀ a b : O, a ∈ IsLocalRing.maximalIdeal O → b ∈ IsLocalRing.maximalIdeal O →
      a * b ∈ IsLocalRing.maximalIdeal O ^ 2 := fun a b ha hb => by
    rw [pow_two]; exact Ideal.mul_mem_mul ha hb
  have s3 : ∀ a : A, ∃ c c₁ c₂ : K,
      Ψ a - (φ c + φ c₁ * Ψ u + φ c₂ * Ψ v) ∈ IsLocalRing.maximalIdeal O ^ 2 := by
    intro a
    have hx : μ (a - π (μ a)) = 0 := by rw [map_sub, hμπ', sub_self]
    obtain ⟨y, hy, w, hw, hyw⟩ := Submodule.mem_sup.mp (hspan _ hx)
    obtain ⟨α, β, hαβ⟩ := Ideal.mem_span_pair.mp hy
    refine ⟨algebraMap R K (μ a), algebraMap R K (μ α), algebraMap R K (μ β), ?_⟩
    have hdα : μ (α - π (μ α)) = 0 := by rw [map_sub, hμπ', sub_self]
    have hdβ : μ (β - π (μ β)) = 0 := by rw [map_sub, hμπ', sub_self]
    have ha : a = π (μ a) + (α * u + β * v) + w := by
      rw [hαβ, add_assoc, hyw]; ring
    have hΨa : Ψ a = Ψ (π (μ a) + (α * u + β * v) + w) := congrArg Ψ ha
    have key : Ψ a - (φ (algebraMap R K (μ a)) + φ (algebraMap R K (μ α)) * Ψ u +
        φ (algebraMap R K (μ β)) * Ψ v)
        = Ψ w + Ψ (α - π (μ α)) * Ψ u + Ψ (β - π (μ β)) * Ψ v := by
      rw [hΨa]
      simp only [map_add, map_mul, map_sub, hΨπ']
      ring
    rw [key]
    exact add_mem (add_mem (s2 2 w hw) (hm2 _ _ (s1 _ hdα) (s1 _ hu)))
      (hm2 _ _ (s1 _ hdβ) (s1 _ hv))

  obtain ⟨e₂, he₂⟩ := hE 2 (by norm_num) le_rfl
  have s4 : ∀ t, ∃ c c₁ c₂ : K,
      e₂ t = Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (φ c + φ c₁ * Ψ u + φ c₂ * Ψ v) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, 0, by simp⟩
    | tmul k q =>
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨c, c₁, c₂, hc⟩ := s3 a
      refine ⟨k * c, k * c₁, k * c₂, ?_⟩
      rw [he₂, Ideal.Quotient.eq]
      have : φ k * Ψ a - (φ (k * c) + φ (k * c₁) * Ψ u + φ (k * c₂) * Ψ v) =
          φ k * (Ψ a - (φ c + φ c₁ * Ψ u + φ c₂ * Ψ v)) := by
        simp only [map_mul]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ hc
    | add x y hx hy =>
      obtain ⟨c, c₁, c₂, hc⟩ := hx
      obtain ⟨d, d₁, d₂, hd⟩ := hy
      refine ⟨c + d, c₁ + d₁, c₂ + d₂, ?_⟩
      rw [map_add, hc, hd, ← map_add]
      congr 1
      simp only [map_add]; ring

  have s6 : ∀ y ∈ IsLocalRing.maximalIdeal O, ∃ c₁ c₂ : K,
      y - (φ c₁ * Ψ u + φ c₂ * Ψ v) ∈ IsLocalRing.maximalIdeal O ^ 2 := by
    intro y hy
    obtain ⟨t, ht⟩ := e₂.surjective (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) y)
    obtain ⟨c, c₁, c₂, hc⟩ := s4 t
    rw [ht, Ideal.Quotient.eq] at hc
    have hD : y - (φ c + φ c₁ * Ψ u + φ c₂ * Ψ v) ∈ IsLocalRing.maximalIdeal O :=
      Ideal.pow_le_self two_ne_zero hc
    have hφc : φ c ∈ IsLocalRing.maximalIdeal O := by
      have e : φ c = y - φ c₁ * Ψ u - φ c₂ * Ψ v - (y - (φ c + φ c₁ * Ψ u + φ c₂ * Ψ v)) := by
        ring
      rw [e]
      exact sub_mem (sub_mem (sub_mem hy (Ideal.mul_mem_left _ _ (s1 u hu)))
        (Ideal.mul_mem_left _ _ (s1 v hv))) hD
    have hc0 : c = 0 := by
      by_contra hne
      exact (IsLocalRing.maximalIdeal.isMaximal O).ne_top
        (Ideal.eq_top_of_isUnit_mem _ hφc ((isUnit_iff_ne_zero.mpr hne).map φ))
    refine ⟨c₁, c₂, ?_⟩
    rw [hc0, map_zero, zero_add] at hc
    exact hc

  have hsmul : ∀ (c : K) (z : O), c • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) z =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (φ c * z) := by
    intro c z
    have h1 := map_smul (Ideal.Quotient.mkₐ K (IsLocalRing.maximalIdeal O ^ 2)) c z
    rw [Ideal.Quotient.mkₐ_eq_mk] at h1
    rw [← h1, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  have s7 : ∀ c₁ c₂ : K, φ c₁ * Ψ u + φ c₂ * Ψ v ∈ IsLocalRing.maximalIdeal O ^ 2 →
      c₁ = 0 ∧ c₂ = 0 := by
    intro c₁ c₂ hmem
    let b : Fin 3 → O ⧸ IsLocalRing.maximalIdeal O ^ 2 :=
      ![Ideal.Quotient.mk _ 1, Ideal.Quotient.mk _ (Ψ u), Ideal.Quotient.mk _ (Ψ v)]
    have hspanb : ⊤ ≤ Submodule.span K (Set.range b) := by
      intro z _
      obtain ⟨t, rfl⟩ := e₂.surjective z
      obtain ⟨c, d₁, d₂, hc⟩ := s4 t
      rw [hc]
      have e : Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (φ c + φ d₁ * Ψ u + φ d₂ * Ψ v) =
          c • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) 1 +
            d₁ • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (Ψ u) +
            d₂ • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (Ψ v) := by
        rw [hsmul, hsmul, hsmul, mul_one, map_add, map_add]
      rw [e]
      have h0 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) 1 ∈ Set.range b := ⟨0, rfl⟩
      have h1 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (Ψ u) ∈ Set.range b := ⟨1, rfl⟩
      have h2 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (Ψ v) ∈ Set.range b := ⟨2, rfl⟩
      exact add_mem (add_mem (Submodule.smul_mem _ _ (Submodule.subset_span h0))
        (Submodule.smul_mem _ _ (Submodule.subset_span h1)))
        (Submodule.smul_mem _ _ (Submodule.subset_span h2))
    have hfin : Module.finrank K (O ⧸ IsLocalRing.maximalIdeal O ^ 2) = 3 :=
      (hHilb 2 (by norm_num)).trans (by norm_num)
    have hli : LinearIndependent K b :=
      linearIndependent_of_top_le_span_of_card_eq_finrank hspanb (by rw [hfin, Fintype.card_fin])
    have hsum := Fintype.linearIndependent_iff.mp hli ![0, c₁, c₂] (by
      rw [Fin.sum_univ_three]
      show (0 : K) • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) 1 +
          c₁ • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (Ψ u) +
          c₂ • Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ 2) (Ψ v) = 0
      rw [zero_smul, zero_add, hsmul, hsmul, ← map_add, Ideal.Quotient.eq_zero_iff_mem]
      exact hmem)
    exact ⟨hsum 1, hsum 2⟩
  exact ⟨s2, s1 u hu, s1 v hv, s6, s7⟩

theorem wcpa_dj_lq_fe_loc_transfer : ∀ (R A R' A' : Type u) [CommRing R] [CommRing A] [CommRing R']
    [CommRing A'] (π : R →+* A) (μ : A →+* R), μ.comp π = RingHom.id R →
    ∀ (f : R) (ρR : R →+* R') (ρA : A →+* A') (π' : R' →+* A') (μ' : A' →+* R'),
    (letI := ρR.toAlgebra; IsLocalization.Away f R') →
    (letI := ρA.toAlgebra; IsLocalization.Away (π f) A') →
    π'.comp ρR = ρA.comp π → μ'.comp ρA = ρR.comp μ →
    ∀ u v : A, ∀ a b c : R, μ u = 0 → μ v = 0 →
    (∀ x, μ x = 0 → ∃ m : ℕ, π (f ^ m) * x ∈ Ideal.span {u, v} ⊔ RingHom.ker μ ^ 2) →
    (∃ m : ℕ, π (f ^ m) * (π a * u ^ 2 + π b * (u * v) + π c * v ^ 2) ∈ RingHom.ker μ ^ 3) →
    (∃ m : ℕ, f ^ m ∈ Ideal.span {a, b, c}) →
    μ' (ρA u) = 0 ∧ μ' (ρA v) = 0 ∧
      (∀ x', μ' x' = 0 → x' ∈ Ideal.span {ρA u, ρA v} ⊔ RingHom.ker μ' ^ 2) ∧
      π' (ρR a) * ρA u ^ 2 + π' (ρR b) * (ρA u * ρA v) + π' (ρR c) * ρA v ^ 2 ∈
        RingHom.ker μ' ^ 3 ∧
      Ideal.span {ρR a, ρR b, ρR c} = ⊤ :=
by
  intro R A R' A' _ _ _ _ π μ hμπ f ρR ρA π' μ' hR hA hπ' hμ' u v a b c hu hv hgen hrel hunim
  letI : Algebra R R' := ρR.toAlgebra
  letI : Algebra A A' := ρA.toAlgebra
  have hπ'x : ∀ r, π' (ρR r) = ρA (π r) := fun r => RingHom.congr_fun hπ' r
  have hμ'x : ∀ y, μ' (ρA y) = ρR (μ y) := fun y => RingHom.congr_fun hμ' y
  have hμπx : ∀ r, μ (π r) = r := fun r => RingHom.congr_fun hμπ r
  have Uf : ∀ n : ℕ, IsUnit (ρR (f ^ n)) := by
    intro n
    rw [map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit (S := R') f).pow n
  have UA : ∀ n : ℕ, IsUnit (ρA (π (f ^ n))) := by
    intro n
    rw [map_pow, map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit (S := A') (π f)).pow n
  have hker : ∀ n : ℕ, ∀ y ∈ RingHom.ker μ ^ n, ρA y ∈ RingHom.ker μ' ^ n := by
    intro n y hy
    have h1 : Ideal.map ρA (RingHom.ker μ) ≤ RingHom.ker μ' := by
      rw [Ideal.map_le_iff_le_comap]
      intro z hz
      rw [Ideal.mem_comap, RingHom.mem_ker, hμ'x, RingHom.mem_ker.mp hz, map_zero]
    have h2 : Ideal.map ρA (RingHom.ker μ ^ n) ≤ RingHom.ker μ' ^ n := by
      rw [Ideal.map_pow]
      exact Ideal.pow_right_mono h1 n
    exact h2 (Ideal.mem_map_of_mem ρA hy)
  have hI : ∀ y ∈ Ideal.span {u, v} ⊔ RingHom.ker μ ^ 2,
      ρA y ∈ Ideal.span {ρA u, ρA v} ⊔ RingHom.ker μ' ^ 2 := by
    intro y hy
    have hle : Ideal.span {u, v} ⊔ RingHom.ker μ ^ 2 ≤
        Ideal.comap ρA (Ideal.span {ρA u, ρA v} ⊔ RingHom.ker μ' ^ 2) := by
      apply sup_le
      · rw [Ideal.span_le]
        intro z hz
        rcases hz with hz | hz
        · rw [hz]
          exact Ideal.mem_comap.mpr (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
        · rw [Set.mem_singleton_iff.mp hz]
          exact Ideal.mem_comap.mpr (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
      · intro z hz
        exact Ideal.mem_comap.mpr (Ideal.mem_sup_right (hker 2 z hz))
    exact hle hy
  have C1 : μ' (ρA u) = 0 := by rw [hμ'x, hu, map_zero]
  have C2 : μ' (ρA v) = 0 := by rw [hμ'x, hv, map_zero]
  have C3 : ∀ x', μ' x' = 0 → x' ∈ Ideal.span {ρA u, ρA v} ⊔ RingHom.ker μ' ^ 2 := by
    intro x' hx'
    obtain ⟨⟨x, t⟩, hxt⟩ := IsLocalization.surj (Submonoid.powers (π f)) x'
    have hx : ρA x = x' * ρA (t : A) := hxt.symm
    have ht : IsUnit (ρA (t : A)) := IsLocalization.map_units A' t
    have h1 : ρR (μ x) = 0 := by
      rw [← hμ'x, hx, map_mul, hx', zero_mul]
    obtain ⟨⟨s, hs⟩, hs0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers f) R' (μ x)).mp h1
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff s f).mp hs
    have h2 : μ (π (f ^ k) * x) = 0 := by
      rw [map_mul, hμπx]
      exact hs0
    obtain ⟨m, hm⟩ := hgen _ h2
    have h3 := hI _ hm
    rw [map_mul, map_mul, hx, Ideal.unit_mul_mem_iff_mem _ (UA m),
      Ideal.unit_mul_mem_iff_mem _ (UA k), mul_comm, Ideal.unit_mul_mem_iff_mem _ ht] at h3
    exact h3
  have C4 : π' (ρR a) * ρA u ^ 2 + π' (ρR b) * (ρA u * ρA v) + π' (ρR c) * ρA v ^ 2 ∈
      RingHom.ker μ' ^ 3 := by
    obtain ⟨m, hm⟩ := hrel
    have h := hker 3 _ hm
    rw [map_mul ρA (π (f ^ m)), Ideal.unit_mul_mem_iff_mem _ (UA m)] at h
    simpa only [map_add, map_mul, map_pow, hπ'x] using h
  have C5 : Ideal.span {ρR a, ρR b, ρR c} = ⊤ := by
    obtain ⟨m, hm⟩ := hunim
    have hle : Ideal.span {a, b, c} ≤ Ideal.comap ρR (Ideal.span {ρR a, ρR b, ρR c}) := by
      rw [Ideal.span_le]
      intro z hz
      rcases hz with hz | hz | hz
      · rw [hz]; exact Ideal.mem_comap.mpr (Ideal.subset_span (by simp))
      · rw [hz]; exact Ideal.mem_comap.mpr (Ideal.subset_span (by simp))
      · rw [Set.mem_singleton_iff.mp hz]; exact Ideal.mem_comap.mpr (Ideal.subset_span (by simp))
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp (hle hm)) (Uf m)
  exact ⟨C1, C2, C3, C4, C5⟩

theorem wcpa_dj_lq_eval_unit : ∀ (S : Scheme.{u}) (N : S.Opens) (x : Γ(S, N)),
    (∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ N),
      wcpaBscEval K σ N h x ≠ 0) → IsUnit x :=
by
  intro S N x H
  refine RingedSpace.isUnit_of_isUnit_germ S.toRingedSpace N x (fun q hq => ?_)
  refine (S.mem_basicOpen x q hq).mp ?_
  have h : ⊤ ≤ (S.fromSpecResidueField q) ⁻¹ᵁ N := fun y _ =>
    (Scheme.Hom.mem_preimage _).mpr (by rw [Scheme.fromSpecResidueField_apply]; exact hq)
  have hne := H (S.residueField q) (S.fromSpecResidueField q) h
  unfold wcpaBscEval at hne
  rw [CommRingCat.comp_apply] at hne
  have hu : IsUnit (((S.fromSpecResidueField q).appLE N ⊤ h).hom x) := by
    have h1 := (isUnit_iff_ne_zero.mpr hne).map
      (Scheme.ΓSpecIso (.of (S.residueField q))).inv.hom
    rwa [Iso.hom_inv_id_apply] at h1
  have h2 := Scheme.basicOpen_of_isUnit _ hu
  rw [Scheme.basicOpen_appLE] at h2
  have h3 : IsLocalRing.closedPoint (S.residueField q) ∈
      (⊤ : (Spec (.of (S.residueField q))).Opens) := trivial
  rw [← h2] at h3
  have h4 := (TopologicalSpace.Opens.mem_inf.mp h3).2
  have key : ∀ s, (S.fromSpecResidueField q) s ∈ S.basicOpen x → q ∈ S.basicOpen x :=
    fun s hs => by rwa [Scheme.fromSpecResidueField_apply] at hs
  exact key _ h4

theorem wcpa_dj_lq_frame_exists : ∀ (k : Type u) [Field k] (C P' S : Scheme.{u})
    (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P') (ι : S ⟶ C), wcpaLqSH k sP' g ι →
    ∀ (p : S) (Ω' : (wcpaLqY g ι).Opens) (V' : S.Opens), p ∈ V' → wcpaLqDelta g ι p ∈ Ω' →
    ∃ F : wcpaLqFrame g ι, p ∈ F.V ∧ F.V ≤ V' ∧ F.Ω ≤ Ω' :=
by
  intro k _ C P' S sP' g ι hSH p Ω' V' hpV' hδΩ'
  obtain ⟨hgP, _hP', hι, hred, hgprop, hH⟩ := hSH
  haveI := hι
  haveI := hred
  haveI := hgprop
  haveI : IsProper (g ≫ sP') := wcpa_dj_proj_proper k _ hgP
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian (ι ≫ g ≫ sP')

  have hδpr : wcpaLqDelta g ι ≫ Limits.pullback.snd g (ι ≫ g) = 𝟙 S := by
    unfold wcpaLqDelta
    exact Limits.pullback.lift_snd _ _ _
  have hδx : ∀ x : S, Limits.pullback.snd g (ι ≫ g) (wcpaLqDelta g ι x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, hδpr]
    rfl
  have hid : ∀ (W : S.Opens) (φ : S ⟶ S), φ = 𝟙 S → ∀ (e : W ≤ φ ⁻¹ᵁ W),
      (φ.appLE W W e).hom = RingHom.id _ := by
    intro W φ hφ e
    subst hφ
    ext x
    simp [Scheme.Hom.appLE]
    exact congrFun (congrArg (fun ψ => ⇑(CommRingCat.Hom.hom ψ))
      (S.presheaf.map_id (Opposite.op W))) x

  have hμπ : ∀ (Ωa : (wcpaLqY g ι).Opens) (Va : S.Opens)
      (h1 : Ωa ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ Va) (h2 : Va ≤ wcpaLqDelta g ι ⁻¹ᵁ Ωa),
      ((wcpaLqDelta g ι).appLE Ωa Va h2).hom.comp
        ((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom = RingHom.id _ := by
    intro Ωa Va h1 h2
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
    exact hid Va _ hδpr _

  have shrink : ∀ (Ωa : (wcpaLqY g ι).Opens) (Va : S.Opens)
      (h1 : Ωa ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ Va) (t : Γ(S, Va)),
      S.basicOpen t ≤ wcpaLqDelta g ι ⁻¹ᵁ Ωa →
      (wcpaLqY g ι).basicOpen (((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom t) ≤
          Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ S.basicOpen t ∧
        S.basicOpen t ≤ wcpaLqDelta g ι ⁻¹ᵁ
          (wcpaLqY g ι).basicOpen (((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom t) := by
    intro Ωa Va h1 t ht
    rw [Scheme.basicOpen_appLE]
    refine ⟨inf_le_right, fun x hx => ?_⟩
    refine ⟨ht hx, ?_⟩
    show Limits.pullback.snd g (ι ≫ g) (wcpaLqDelta g ι x) ∈ S.basicOpen t
    rw [hδx]
    exact hx

  have hcpr : ∀ (V₁ V₂ : S.Opens) (Ω₁ Ω₂ : (wcpaLqY g ι).Opens) (hV : V₂ ≤ V₁) (hΩ : Ω₂ ≤ Ω₁)
      (e₁ : Ω₁ ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V₁)
      (e₂ : Ω₂ ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V₂),
      ((Limits.pullback.snd g (ι ≫ g)).appLE V₂ Ω₂ e₂).hom.comp
          (S.presheaf.map (homOfLE hV).op).hom =
        ((wcpaLqY g ι).presheaf.map (homOfLE hΩ).op).hom.comp
          ((Limits.pullback.snd g (ι ≫ g)).appLE V₁ Ω₁ e₁).hom := by
    intro V₁ V₂ Ω₁ Ω₂ hV hΩ e₁ e₂
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE,
      Scheme.Hom.appLE_map]
  have hcδ : ∀ (Ω₁ Ω₂ : (wcpaLqY g ι).Opens) (V₁ V₂ : S.Opens) (hΩ : Ω₂ ≤ Ω₁) (hV : V₂ ≤ V₁)
      (e₁ : V₁ ≤ wcpaLqDelta g ι ⁻¹ᵁ Ω₁) (e₂ : V₂ ≤ wcpaLqDelta g ι ⁻¹ᵁ Ω₂),
      ((wcpaLqDelta g ι).appLE Ω₂ V₂ e₂).hom.comp
          ((wcpaLqY g ι).presheaf.map (homOfLE hΩ).op).hom =
        (S.presheaf.map (homOfLE hV).op).hom.comp ((wcpaLqDelta g ι).appLE Ω₁ V₁ e₁).hom := by
    intro Ω₁ Ω₂ V₁ V₂ hΩ hV e₁ e₂
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE,
      Scheme.Hom.appLE_map]

  have hθ : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
      τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
      ∀ (hs : s = σ ≫ ι ≫ g) (Ω : (wcpaLqY g ι).Opens),
      wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) ∈ Ω →
      τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω := by
    intro K _ s τ σ hτs hτf hs Ω hΩ
    have e : τ ≫ wcpaLqTheta g ι s σ hs = σ ≫ wcpaLqDelta g ι := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst, hτf]
      · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd, ← Category.assoc, hτs, Category.id_comp, Category.comp_id]
    have h2 : wcpaLqTheta g ι s σ hs (τ (IsLocalRing.closedPoint K)) =
        wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) := by
      exact (Scheme.Hom.comp_apply τ (wcpaLqTheta g ι s σ hs) _).symm.trans
        ((congrArg (fun φ : Spec (.of K) ⟶ wcpaLqY g ι => φ (IsLocalRing.closedPoint K)) e).trans
          (Scheme.Hom.comp_apply σ (wcpaLqDelta g ι) _))
    rw [Scheme.Hom.mem_preimage, h2]
    exact hΩ
  have hpt : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (N : S.Opens), ⊤ ≤ σ ⁻¹ᵁ N →
      σ (IsLocalRing.closedPoint K) ∈ N := by
    intro K _ σ N h
    have := h (show IsLocalRing.closedPoint K ∈ (⊤ : (Spec (.of K)).Opens) from trivial)
    exact this
  have hRN : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
      τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
      wcpaLqRatNode K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))
        (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
          (τ (IsLocalRing.closedPoint K))) := by
    intro K _ s τ σ hτs hτf
    refine hH K s τ hτs ⟨σ (IsLocalRing.closedPoint K), ?_⟩
    exact (Scheme.Hom.comp_apply σ ι _).symm.trans
      ((congrArg (fun φ : Spec (.of K) ⟶ C => φ (IsLocalRing.closedPoint K)) hτf).symm.trans
        (Scheme.Hom.comp_apply τ (Limits.pullback.fst g s) _))
  have hpkg : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S),
      ∃ τ : Spec (.of K) ⟶ Limits.pullback g (σ ≫ ι ≫ g),
        τ ≫ Limits.pullback.snd g (σ ≫ ι ≫ g) = 𝟙 _ ∧
          τ ≫ Limits.pullback.fst g (σ ≫ ι ≫ g) = σ ≫ ι := by
    intro K _ σ
    exact ⟨Limits.pullback.lift (σ ≫ ι) (𝟙 _) (by rw [Category.id_comp, Category.assoc]),
      Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩

  have mkframe : ∀ (Ω : (wcpaLqY g ι).Opens) (V : S.Opens) (hΩ : IsAffineOpen Ω)
      (hV : IsAffineOpen V) (hΩV : Ω ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V)
      (hVΩ : V ≤ wcpaLqDelta g ι ⁻¹ᵁ Ω) (u v : Γ(wcpaLqY g ι, Ω)) (a b c : Γ(S, V)),
      ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom u = 0 →
      ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom v = 0 →
      (∀ x : Γ(wcpaLqY g ι, Ω), ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom x = 0 →
        x ∈ Ideal.span {u, v} ⊔ RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ 2) →
      ((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom a * u ^ 2 +
          ((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom b * (u * v) +
          ((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom c * v ^ 2 ∈
        RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ 3 →
      Ideal.span {a, b, c} = ⊤ →
      ∃ F : wcpaLqFrame g ι, F.Ω = Ω ∧ F.V = V := by
    intro Ω V hΩ hV hΩV hVΩ u v a b c hu hv hspan hrel hunim
    have hfpf : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
        (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
        τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
        ∀ (hs : s = σ ≫ ι ≫ g) (h : ⊤ ≤ σ ⁻¹ᵁ V)
          (hw : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω),
          wcpaLqBasis K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))
              (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
                (τ (IsLocalRing.closedPoint K)))
              (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw u)
              (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw v) ∧
            wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
                (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h a) *
                wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw u ^ 2 +
              wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
                (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h b) *
                (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw u *
                  wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw v) +
              wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
                (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h c) *
                wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw v ^ 2 ∈
              IsLocalRing.maximalIdeal
                ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 3 := by
      intro K _ s τ σ hτs hτf hs h hw
      letI : Algebra Γ(S, V) K := (wcpaBscEval K σ V h).toAlgebra
      obtain ⟨hcomp, he⟩ := wcpa_dj_lq_fe_bridge C P' S g ι Ω V hΩ hV hΩV hVΩ K s τ σ hτs hτf
        hs h hw rfl
      obtain ⟨hpow, hbas⟩ := wcpa_dj_lq_fe_basis Γ(S, V) Γ(wcpaLqY g ι, Ω) K _
        ((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom
        ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom (hμπ Ω V hΩV hVΩ) _ _ hcomp
        (fun n hn1 _ => he n hn1) (hRN K s τ σ hτs hτf).1 u v hu hv hspan
      refine ⟨hbas, ?_⟩
      have h3 := hpow 3 _ hrel
      have hc : ∀ r : Γ(S, V), wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw
          (((Limits.pullback.snd g (ι ≫ g)).appLE V Ω hΩV).hom r) =
          wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
            (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h r) :=
        fun r => RingHom.congr_fun hcomp r
      simp only [map_add, map_mul, map_pow, hc] at h3
      exact h3
    have hdisc : IsUnit (b ^ 2 - 4 * a * c) := by
      apply wcpa_dj_lq_eval_unit S V
      intro K _ σ h
      obtain ⟨τ, hτs, hτf⟩ := hpkg K σ
      have hw := hθ K _ τ σ hτs hτf rfl Ω (hVΩ (hpt K σ V h))
      obtain ⟨hbas, hq⟩ := hfpf K _ τ σ hτs hτf rfl h hw
      have hne : wcpaBscEval K σ V h a ≠ 0 ∨ wcpaBscEval K σ V h b ≠ 0 ∨
          wcpaBscEval K σ V h c ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        obtain ⟨ha0, hb0, hc0⟩ := hcon
        have hle : Ideal.span {a, b, c} ≤ RingHom.ker (wcpaBscEval K σ V h) := by
          rw [Ideal.span_le]
          rintro x (rfl | rfl | rfl)
          · exact ha0
          · exact hb0
          · exact hc0
        have h1 : (1 : Γ(S, V)) ∈ RingHom.ker (wcpaBscEval K σ V h) :=
          hle (by rw [hunim]; exact Submodule.mem_top)
        rw [RingHom.mem_ker, map_one] at h1
        exact one_ne_zero h1
      have := (hRN K _ τ σ hτs hτf).2 _ _ hbas _ _ _ hne hq
      simpa only [map_sub, map_mul, map_pow, map_ofNat] using this
    exact ⟨⟨Ω, V, hΩ, hV, hΩV, hVΩ, u, v, a, b, c, hu, hv, hspan, hdisc, hfpf⟩, rfl, rfl⟩

  have main : ∀ (Ωa : (wcpaLqY g ι).Opens) (Va : S.Opens), IsAffineOpen Ωa → IsAffineOpen Va →
      ∀ (h1 : Ωa ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ Va) (h2 : Va ≤ wcpaLqDelta g ι ⁻¹ᵁ Ωa),
      p ∈ Va → ∃ F : wcpaLqFrame g ι, p ∈ F.V ∧ F.V ≤ Va ∧ F.Ω ≤ Ωa := by
    intro Ωa Va hΩa hVa h1 h2 hpVa
    haveI : IsNoetherianRing Γ(S, Va) := IsLocallyNoetherian.component_noetherian ⟨Va, hVa⟩
    have hft : ((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom.FiniteType :=
      (Limits.pullback.snd g (ι ≫ g)).finiteType_appLE hVa hΩa h1
    have hfib : letI := ((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom.toAlgebra
        ∀ (𝔭 : Ideal Γ(S, Va)) [𝔭.IsPrime] (n : ℕ), 1 ≤ n → n ≤ 3 →
          Module.finrank 𝔭.ResidueField (TensorProduct Γ(S, Va) 𝔭.ResidueField
            (Γ(wcpaLqY g ι, Ωa) ⧸ RingHom.ker ((wcpaLqDelta g ι).appLE Ωa Va h2).hom ^ n)) =
            2 * n - 1 := by
      intro 𝔭 _ n hn1 _
      obtain ⟨σ, hσ, hev⟩ := wcpa_dj_lq_prime_point S Va hVa 𝔭
      obtain ⟨τ, hτs, hτf⟩ := hpkg 𝔭.ResidueField σ
      have hw := hθ 𝔭.ResidueField _ τ σ hτs hτf rfl Ωa (h2 (hpt _ σ Va hσ))
      obtain ⟨-, he⟩ := wcpa_dj_lq_fe_bridge C P' S g ι Ωa Va hΩa hVa h1 h2 𝔭.ResidueField _ τ σ
        hτs hτf rfl hσ hw hev.symm
      obtain ⟨e, -⟩ := he n hn1
      letI := (wcpaLqPhi 𝔭.ResidueField (Limits.pullback g (σ ≫ ι ≫ g))
        (Limits.pullback.snd g (σ ≫ ι ≫ g)) (τ (IsLocalRing.closedPoint 𝔭.ResidueField))).toAlgebra
      exact (LinearEquiv.finrank_eq e).trans ((hRN 𝔭.ResidueField _ τ σ hτs hτf).1 n hn1)
    obtain ⟨f, u, v, a, b, c, hf, hu, hv, hspan, hrel, hunim⟩ :=
      wcpa_dj_lq_conormal_frame Γ(S, Va) Γ(wcpaLqY g ι, Ωa)
        ((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom
        ((wcpaLqDelta g ι).appLE Ωa Va h2).hom (hμπ Ωa Va h1 h2) hft hfib
        (hVa.primeIdealOf ⟨p, hpVa⟩).asIdeal
    have hpD : p ∈ S.basicOpen f := by
      have h1' : hVa.primeIdealOf ⟨p, hpVa⟩ ∈ hVa.fromSpec ⁻¹ᵁ S.basicOpen f := by
        rw [hVa.fromSpec_preimage_basicOpen]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr hf
      have h3 : hVa.fromSpec (hVa.primeIdealOf ⟨p, hpVa⟩) ∈ S.basicOpen f := h1'
      rw [hVa.fromSpec_primeIdealOf] at h3
      exact h3
    obtain ⟨hΩV, hVΩ⟩ := shrink Ωa Va h1 f ((S.basicOpen_le f).trans h2)
    have hlocR := hVa.isLocalization_basicOpen f
    have hlocA := hΩa.isLocalization_basicOpen
      (((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom f)
    obtain ⟨hu', hv', hspan', hrel', hunim'⟩ := wcpa_dj_lq_fe_loc_transfer Γ(S, Va)
      Γ(wcpaLqY g ι, Ωa) Γ(S, S.basicOpen f)
      Γ(wcpaLqY g ι, (wcpaLqY g ι).basicOpen
        (((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom f))
      ((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom
      ((wcpaLqDelta g ι).appLE Ωa Va h2).hom (hμπ Ωa Va h1 h2) f
      (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom
      ((wcpaLqY g ι).presheaf.map (homOfLE ((wcpaLqY g ι).basicOpen_le
        (((Limits.pullback.snd g (ι ≫ g)).appLE Va Ωa h1).hom f))).op).hom
      ((Limits.pullback.snd g (ι ≫ g)).appLE (S.basicOpen f) _ hΩV).hom
      ((wcpaLqDelta g ι).appLE _ (S.basicOpen f) hVΩ).hom
      hlocR hlocA
      (hcpr Va (S.basicOpen f) Ωa _ (S.basicOpen_le f) ((wcpaLqY g ι).basicOpen_le _) h1 hΩV)
      (hcδ Ωa _ Va (S.basicOpen f) ((wcpaLqY g ι).basicOpen_le _) (S.basicOpen_le f) h2 hVΩ)
      u v a b c hu hv hspan hrel hunim
    obtain ⟨F, hFΩ, hFV⟩ := mkframe _ (S.basicOpen f) (hΩa.basicOpen _) (hVa.basicOpen f) hΩV
      hVΩ _ _ _ _ _ hu' hv' hspan' hrel' hunim'
    refine ⟨F, ?_, ?_, ?_⟩
    · rw [hFV]; exact hpD
    · rw [hFV]; exact S.basicOpen_le f
    · rw [hFΩ]; exact (wcpaLqY g ι).basicOpen_le _

  have hpmem0 : p ∈ V' ⊓ wcpaLqDelta g ι ⁻¹ᵁ Ω' :=
    TopologicalSpace.Opens.mem_inf.mpr ⟨hpV', hδΩ'⟩
  obtain ⟨V₀, hV₀, hpV₀, hV₀le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens) hpmem0
  have hV₀' : IsAffineOpen V₀ := hV₀
  have hδp : wcpaLqDelta g ι p ∈ Ω' ⊓ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V₀ := by
    refine TopologicalSpace.Opens.mem_inf.mpr ⟨hδΩ', ?_⟩
    show Limits.pullback.snd g (ι ≫ g) (wcpaLqDelta g ι p) ∈ V₀
    rw [hδx]
    exact hpV₀
  obtain ⟨Ω₀, hΩ₀, hδpΩ₀, hΩ₀le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (wcpaLqY g ι).isBasis_affineOpens) hδp
  have hΩ₀' : IsAffineOpen Ω₀ := hΩ₀
  have h1₀ : Ω₀ ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V₀ := hΩ₀le.trans inf_le_right
  have hpmem : p ∈ V₀ ⊓ wcpaLqDelta g ι ⁻¹ᵁ Ω₀ :=
    TopologicalSpace.Opens.mem_inf.mpr ⟨hpV₀, hδpΩ₀⟩
  obtain ⟨h₀, hh₀le, hph₀⟩ := hV₀'.exists_basicOpen_le (V := V₀ ⊓ wcpaLqDelta g ι ⁻¹ᵁ Ω₀)
    ⟨p, hpmem⟩ hpV₀
  obtain ⟨hΩV₁, hVΩ₁⟩ := shrink Ω₀ V₀ h1₀ h₀ (hh₀le.trans inf_le_right)
  obtain ⟨F, hpF, hFV, hFΩ⟩ := main _ _ (hΩ₀'.basicOpen _) (hV₀'.basicOpen h₀) hΩV₁ hVΩ₁ hph₀
  exact ⟨F, hpF, hFV.trans ((S.basicOpen_le h₀).trans (hV₀le.trans inf_le_left)),
    hFΩ.trans (((wcpaLqY g ι).basicOpen_le _).trans (hΩ₀le.trans inf_le_left))⟩

theorem wcpa_dj_lq_local_transition : ∀ (k : Type u) [Field k] (C P' S : Scheme.{u})
    (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P') (ι : S ⟶ C), wcpaLqSH k sP' g ι →
    ∀ (F₁ F₂ F₀ : wcpaLqFrame g ι), F₀.V ≤ F₁.V ⊓ F₂.V → F₀.Ω ≤ F₁.Ω ⊓ F₂.Ω →
    ∃ M : Matrix (Fin 2) (Fin 2) Γ(S, F₀.V), wcpaLqTrans F₁ F₂ F₀.V M :=
by
  intro k _ C P' S sP' g ι _hSH F₁ F₂ F₀ hV hΩ
  classical
  have hH : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U)
      (x : X) (hx : x ∈ V),
      f.appLE U V e ≫ X.presheaf.germ V x hx = f.app U ≫ X.presheaf.germ (f ⁻¹ᵁ U) x (e hx) := by
    intro X Y f U V e x hx
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
  have hA : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (τ : Spec (.of K) ⟶ X) (pt : ↥(Spec (.of K)))
      (hpt : pt ∈ (⊤ : (Spec (.of K)).Opens)) (U : X.Opens) (hx : τ pt ∈ U) (e : ⊤ ≤ τ ⁻¹ᵁ U),
      X.presheaf.germ U (τ pt) hx ≫ τ.stalkMap pt =
        τ.appLE U ⊤ e ≫ (Spec (.of K)).presheaf.germ ⊤ pt hpt := by
    intro K _ X τ pt hpt U hx e
    rw [Scheme.Hom.germ_stalkMap, hH]
  have hkey : ∀ (K : Type u) [Field K] {Z : Scheme.{u}} (pt : ↥(Spec (.of K)))
      (hpt : pt ∈ (⊤ : (Spec (.of K)).Opens)) (U : Z.Opens) (f f' : Spec (.of K) ⟶ Z), f = f' →
      ∀ (e : ⊤ ≤ f ⁻¹ᵁ U) (e' : ⊤ ≤ f' ⁻¹ᵁ U),
      f.appLE U ⊤ e ≫ (Spec (.of K)).presheaf.germ ⊤ pt hpt =
        f'.appLE U ⊤ e' ≫ (Spec (.of K)).presheaf.germ ⊤ pt hpt := by
    rintro K _ Z pt hpt U f _ rfl e e'
    rfl
  have psiRes : ∀ (X Y S : Scheme.{u}) (K : Type u) [Field K] (τ : Spec (.of K) ⟶ X) (θ : X ⟶ Y)
      (δ : S ⟶ Y) (σ : Spec (.of K) ⟶ S) (a : X ⟶ Spec (.of K)), τ ≫ a = 𝟙 _ → τ ≫ θ = σ ≫ δ →
      ∀ (pt : ↥(Spec (.of K))) (Ω : Y.Opens) (V : S.Opens) (hVΩ : V ≤ δ ⁻¹ᵁ Ω) (h : ⊤ ≤ σ ⁻¹ᵁ V)
      (hw : τ pt ∈ θ ⁻¹ᵁ Ω) (x : Γ(Y, Ω)),
      (θ.app Ω ≫ X.presheaf.germ (θ ⁻¹ᵁ Ω) _ hw).hom x -
        wcpaLqPhi K X a (τ pt) (wcpaBscEval K σ V h ((δ.appLE Ω V hVΩ).hom x))
        ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (τ pt)) := by
    intro X Y S K _ τ θ δ σ a hτa hE pt Ω V hVΩ h hw x
    have hpt : pt ∈ (⊤ : (Spec (.of K)).Opens) := trivial
    have hτpt : τ pt ∈ (⊤ : X.Opens) := trivial
    have e1 : θ.app Ω ≫ X.presheaf.germ (θ ⁻¹ᵁ Ω) _ hw ≫ τ.stalkMap pt =
        δ.appLE Ω V hVΩ ≫ σ.appLE V ⊤ h ≫ (Spec (.of K)).presheaf.germ ⊤ pt hpt := by
      have eτ : ⊤ ≤ τ ⁻¹ᵁ (θ ⁻¹ᵁ Ω) := fun y _ => by
        have hy : y = pt := Subsingleton.elim (α := PrimeSpectrum K) _ _
        rw [hy]; exact hw
      rw [hA K τ pt hpt _ hw eτ, Scheme.Hom.app_eq_appLE, ← Category.assoc,
        Scheme.Hom.appLE_comp_appLE, ← Category.assoc, Scheme.Hom.appLE_comp_appLE]
      exact hkey K pt hpt Ω _ _ hE _ _
    have e2 : a.appTop ≫ X.presheaf.germ ⊤ (τ pt) hτpt ≫ τ.stalkMap pt =
        (Spec (.of K)).presheaf.germ ⊤ pt hpt := by
      have eτ1 : (⊤ : (Spec (.of K)).Opens) ≤ τ ⁻¹ᵁ ⊤ := fun y _ => trivial
      have eτa : (⊤ : (Spec (.of K)).Opens) ≤ (τ ≫ a) ⁻¹ᵁ ⊤ := fun y _ => trivial
      have eid : (⊤ : (Spec (.of K)).Opens) ≤ (𝟙 (Spec (.of K))) ⁻¹ᵁ ⊤ := fun y _ => trivial
      have eT : a.appTop ≫ τ.appLE ⊤ ⊤ eτ1 = (τ ≫ a).appLE ⊤ ⊤ eτa := by
        rw [Scheme.Hom.comp_appLE]
        rfl
      rw [hA K τ pt hpt ⊤ hτpt eτ1, ← Category.assoc, eT, hkey K pt hpt ⊤ _ (𝟙 _) hτa eτa eid, hH,
        Scheme.Hom.id_app]
      first
        | exact Category.id_comp ((Spec (.of K)).presheaf.germ ⊤ pt hpt)
        | (erw [Category.id_comp])
        | rfl
    have l : (τ.stalkMap pt).hom ((θ.app Ω ≫ X.presheaf.germ (θ ⁻¹ᵁ Ω) _ hw).hom x) =
        (δ.appLE Ω V hVΩ ≫ σ.appLE V ⊤ h ≫ (Spec (.of K)).presheaf.germ ⊤ pt hpt).hom x := by
      rw [← e1]
      rfl
    have r : (τ.stalkMap pt).hom
        (wcpaLqPhi K X a (τ pt) (wcpaBscEval K σ V h ((δ.appLE Ω V hVΩ).hom x))) =
        (δ.appLE Ω V hVΩ ≫ σ.appLE V ⊤ h ≫ (Spec (.of K)).presheaf.germ ⊤ pt hpt).hom x := by
      have r0 := congrArg (fun f => CommRingCat.Hom.hom f
        ((σ.appLE V ⊤ h).hom ((δ.appLE Ω V hVΩ).hom x))) e2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at r0 ⊢
      rw [← r0]
      simp only [wcpaBscEval, CommRingCat.hom_comp, RingHom.comp_apply]
      rw [Iso.hom_inv_id_apply]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hu' := hu.map (τ.stalkMap pt).hom
    rw [map_sub, l, r, sub_self] at hu'
    exact not_isUnit_zero hu'
  have unitEval : ∀ (S : Scheme.{u}) (N : S.Opens) (x : Γ(S, N)),
      (∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ N),
        wcpaBscEval K σ N h x ≠ 0) → IsUnit x := by
    intro S N x H
    apply RingedSpace.isUnit_of_isUnit_germ S.toRingedSpace N x
    intro q hq
    obtain ⟨σ, hσ⟩ : ∃ σ : Spec (.of (S.residueField q)) ⟶ S, ∀ y, σ y = q := by
      refine ⟨S.fromSpecResidueField q, fun y => ?_⟩
      have : S.fromSpecResidueField q y ∈ Set.range (S.fromSpecResidueField q) := ⟨y, rfl⟩
      rwa [Scheme.range_fromSpecResidueField] at this
    have h : ⊤ ≤ σ ⁻¹ᵁ N := fun y _ => by
      show σ y ∈ N
      rw [hσ]
      exact hq
    have hne := H (S.residueField q) σ h
    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of (S.residueField q))) := ⟨IsLocalRing.closedPoint _⟩
    have hpt : pt ∈ (⊤ : (Spec (.of (S.residueField q))).Opens) := trivial
    have hu1 : IsUnit ((σ.appLE N ⊤ h).hom x) := by
      have hu0 : IsUnit (wcpaBscEval (S.residueField q) σ N h x) := hne.isUnit
      have := hu0.map (Scheme.ΓSpecIso (.of (S.residueField q))).inv.hom
      simp only [wcpaBscEval, CommRingCat.hom_comp, RingHom.comp_apply] at this
      rwa [Iso.hom_inv_id_apply] at this
    have hu2 : IsUnit (((Spec (.of (S.residueField q))).presheaf.germ ⊤ pt hpt).hom
        ((σ.appLE N ⊤ h).hom x)) := hu1.map _
    have e3 := hA (S.residueField q) σ pt hpt N (h hpt) h
    have hu3 : IsUnit ((σ.stalkMap pt).hom ((S.presheaf.germ N (σ pt) (h hpt)).hom x)) := by
      have := congrArg (fun f => CommRingCat.Hom.hom f x) e3
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      exact hu2
    have : IsLocalHom (σ.stalkMap pt).hom := inferInstance
    have hu4 := isUnit_of_map_unit (σ.stalkMap pt).hom _ hu3
    have tr : ∀ (q' : S) (hq' : q' ∈ N), q' = q →
        IsUnit ((S.presheaf.germ N q' hq').hom x) → IsUnit ((S.presheaf.germ N q hq).hom x) := by
      rintro _ _ rfl hh
      exact hh
    exact tr _ _ (hσ pt) hu4
  have basisDet : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (φ : K →+* R)
      (u v u' v' : R) (q00 q01 q10 q11 : K), wcpaLqBasis K R φ u v → wcpaLqBasis K R φ u' v' →
      u' - (φ q00 * u + φ q01 * v) ∈ IsLocalRing.maximalIdeal R ^ 2 →
      v' - (φ q10 * u + φ q11 * v) ∈ IsLocalRing.maximalIdeal R ^ 2 →
      q00 * q11 - q01 * q10 ≠ 0 := by
    intro K _ R _ _ φ u v u' v' q00 q01 q10 q11 hb hb' h1 h2
    obtain ⟨hu, hv, -, hind⟩ := hb
    obtain ⟨-, -, hsp, -⟩ := hb'
    obtain ⟨t00, t01, ht0⟩ := hsp u hu
    obtain ⟨t10, t11, ht1⟩ := hsp v hv
    have k0 : φ (1 - (t00 * q00 + t01 * q10)) * u + φ (-(t00 * q01 + t01 * q11)) * v ∈
        IsLocalRing.maximalIdeal R ^ 2 := by
      have e : φ (1 - (t00 * q00 + t01 * q10)) * u + φ (-(t00 * q01 + t01 * q11)) * v =
          (u - (φ t00 * u' + φ t01 * v')) + φ t00 * (u' - (φ q00 * u + φ q01 * v)) +
            φ t01 * (v' - (φ q10 * u + φ q11 * v)) := by
        simp only [map_sub, map_one, map_add, map_mul, map_neg]
        ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.add_mem _ ht0 (Ideal.mul_mem_left _ _ h1))
        (Ideal.mul_mem_left _ _ h2)
    have k1 : φ (-(t10 * q00 + t11 * q10)) * u + φ (1 - (t10 * q01 + t11 * q11)) * v ∈
        IsLocalRing.maximalIdeal R ^ 2 := by
      have e : φ (-(t10 * q00 + t11 * q10)) * u + φ (1 - (t10 * q01 + t11 * q11)) * v =
          (v - (φ t10 * u' + φ t11 * v')) + φ t10 * (u' - (φ q00 * u + φ q01 * v)) +
            φ t11 * (v' - (φ q10 * u + φ q11 * v)) := by
        simp only [map_sub, map_one, map_add, map_mul, map_neg]
        ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.add_mem _ ht1 (Ideal.mul_mem_left _ _ h1))
        (Ideal.mul_mem_left _ _ h2)
    obtain ⟨a0, a1⟩ := hind _ _ k0
    obtain ⟨b0, b1⟩ := hind _ _ k1
    intro hdet
    have key : (1 : K) = 0 := by
      linear_combination a0 + (t00 * q00 + t01 * q10) * b1 +
        (-(t10 * q00 + t11 * q10)) * a1 + (t00 * t11 - t01 * t10) * hdet
    exact one_ne_zero key
  have mm : ∀ (R : Type u) [CommRing R] (I : Ideal R) (p q : R), p ∈ I → q ∈ I → p * q ∈ I ^ 2 := by
    intro R _ I p q hp hq
    rw [pow_two]
    exact Ideal.mul_mem_mul hp hq
  have algT : ∀ (R : Type u) [CommRing R] (I : Ideal R)
      (X Y1 Y2 A B p0 p1 q00 q01 q10 q11 m0 m1 : R),
      X - (p0 * A + p1 * B) ∈ I → Y1 - (q00 * A + q01 * B) ∈ I → Y2 - (q10 * A + q11 * B) ∈ I →
      p0 = m0 * q00 + m1 * q10 → p1 = m0 * q01 + m1 * q11 → X - (m0 * Y1 + m1 * Y2) ∈ I := by
    intro R _ I X Y1 Y2 A B p0 p1 q00 q01 q10 q11 m0 m1 h1 h2 h3 hp0 hp1
    subst hp0 hp1
    have e : X - (m0 * Y1 + m1 * Y2) = (X - ((m0 * q00 + m1 * q10) * A + (m0 * q01 + m1 * q11) * B))
        - m0 * (Y1 - (q00 * A + q01 * B)) - m1 * (Y2 - (q10 * A + q11 * B)) := by ring
    rw [e]
    exact I.sub_mem (I.sub_mem h1 (I.mul_mem_left _ h2)) (I.mul_mem_left _ h3)
  have hE : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
      τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
      ∀ (hs : s = σ ≫ ι ≫ g), τ ≫ wcpaLqTheta g ι s σ hs = σ ≫ wcpaLqDelta g ι := by
    intro K _ s τ σ hτs hτf hs
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst, hτf]
    · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd, ← Category.assoc, hτs, Category.id_comp, Category.comp_id]
  have hW : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
      τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
      ∀ (hs : s = σ ≫ ι ≫ g) (h : ⊤ ≤ σ ⁻¹ᵁ F₀.V),
      τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ F₀.Ω := by
    intro K _ s τ σ hτs hτf hs h
    have e := hE K s τ σ hτs hτf hs
    have h2 : wcpaLqTheta g ι s σ hs (τ (IsLocalRing.closedPoint K)) =
        wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) := by
      exact (Scheme.Hom.comp_apply τ (wcpaLqTheta g ι s σ hs) _).symm.trans
        ((congrArg (fun φ : Spec (.of K) ⟶ wcpaLqY g ι => φ (IsLocalRing.closedPoint K)) e).trans
          (Scheme.Hom.comp_apply σ (wcpaLqDelta g ι) _))
    rw [Scheme.Hom.mem_preimage, h2]
    have h3 : σ (IsLocalRing.closedPoint K) ∈ F₀.V :=
      h (show IsLocalRing.closedPoint K ∈ (⊤ : (Spec (.of K)).Opens) from trivial)
    exact F₀.hVΩ h3
  have hres : ∀ (F : wcpaLqFrame g ι) (hΩF : F₀.Ω ≤ F.Ω) (hVF : F₀.V ≤ F.V)
      (x : Γ(wcpaLqY g ι, F.Ω)),
      ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom
        (((wcpaLqY g ι).presheaf.map (homOfLE hΩF).op).hom x) =
      (S.presheaf.map (homOfLE hVF).op).hom (((wcpaLqDelta g ι).appLE F.Ω F.V F.hVΩ).hom x) := by
    intro F hΩF hVF x
    have e : (wcpaLqY g ι).presheaf.map (homOfLE hΩF).op ≫
        (wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ =
        (wcpaLqDelta g ι).appLE F.Ω F.V F.hVΩ ≫ S.presheaf.map (homOfLE hVF).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    have := congrArg (fun f => CommRingCat.Hom.hom f x) e
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
  have hk : ∀ (F : wcpaLqFrame g ι) (hΩF : F₀.Ω ≤ F.Ω) (hVF : F₀.V ≤ F.V)
      (x : Γ(wcpaLqY g ι, F.Ω)), ((wcpaLqDelta g ι).appLE F.Ω F.V F.hVΩ).hom x = 0 →
      ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom
        (((wcpaLqY g ι).presheaf.map (homOfLE hΩF).op).hom x) = 0 := by
    intro F hΩF hVF x hx
    rw [hres F hΩF hVF x, hx, map_zero]
  have hdec : ∀ y : Γ(wcpaLqY g ι, F₀.Ω), ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom y = 0 →
      ∃ a b e : Γ(wcpaLqY g ι, F₀.Ω),
        e ∈ RingHom.ker ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom ^ 2 ∧
        y = a * F₀.u + b * F₀.v + e := by
    intro y hy
    obtain ⟨z, hz, e, he, hze⟩ := Submodule.mem_sup.mp (F₀.span y hy)
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hz
    exact ⟨a, b, e, he, by rw [← hze, ← hab]⟩
  have hcong : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S)
      (hτs : τ ≫ Limits.pullback.snd g s = 𝟙 _) (hτf : τ ≫ Limits.pullback.fst g s = σ ≫ ι)
      (hs : s = σ ≫ ι ≫ g) (h : ⊤ ≤ σ ⁻¹ᵁ F₀.V) (F : wcpaLqFrame g ι) (hΩF : F₀.Ω ≤ F.Ω)
      (hwF : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ F.Ω)
      (x : Γ(wcpaLqY g ι, F.Ω)) (a b e : Γ(wcpaLqY g ι, F₀.Ω)),
      e ∈ RingHom.ker ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom ^ 2 →
      ((wcpaLqY g ι).presheaf.map (homOfLE hΩF).op).hom x = a * F₀.u + b * F₀.v + e →
      wcpaLqPsi g ι s σ hs F.Ω (τ (IsLocalRing.closedPoint K)) hwF x -
        (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))
            (wcpaBscEval K σ F₀.V h (((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom a)) *
          wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) (hW K s τ σ hτs hτf hs h) F₀.u +
         wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))
            (wcpaBscEval K σ F₀.V h (((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom b)) *
          wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) (hW K s τ σ hτs hτf hs h) F₀.v)
        ∈ IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 2 := by
    intro K _ s τ σ hτs hτf hs h F hΩF hwF x a b e he hx
    have hw₀ := hW K s τ σ hτs hτf hs h
    have hE' := hE K s τ σ hτs hτf hs
    have hrestr : wcpaLqPsi g ι s σ hs F.Ω (τ (IsLocalRing.closedPoint K)) hwF x =
        wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) hw₀
          (((wcpaLqY g ι).presheaf.map (homOfLE hΩF).op).hom x) := by
      have em : (wcpaLqY g ι).presheaf.map (homOfLE hΩF).op ≫
          (wcpaLqTheta g ι s σ hs).app F₀.Ω ≫
            (Limits.pullback g s).presheaf.germ _ (τ (IsLocalRing.closedPoint K)) hw₀ =
          (wcpaLqTheta g ι s σ hs).app F.Ω ≫
            (Limits.pullback g s).presheaf.germ _ (τ (IsLocalRing.closedPoint K)) hwF := by
        rw [← Category.assoc, Scheme.Hom.naturality, Category.assoc, TopCat.Presheaf.germ_res]
      have := congrArg (fun f => CommRingCat.Hom.hom f x) em
      exact this.symm
    have hres0 : ∀ z : Γ(wcpaLqY g ι, F₀.Ω),
        wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) hw₀ z -
          wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))
            (wcpaBscEval K σ F₀.V h (((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom z)) ∈
        IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) := fun z =>
      psiRes (Limits.pullback g s) (wcpaLqY g ι) S K τ (wcpaLqTheta g ι s σ hs) (wcpaLqDelta g ι) σ
        (Limits.pullback.snd g s) hτs hE' (IsLocalRing.closedPoint K) F₀.Ω F₀.V F₀.hVΩ h hw₀ z
    have hm : ∀ z : Γ(wcpaLqY g ι, F₀.Ω), ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom z = 0 →
        wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) hw₀ z ∈
          IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) := by
      intro z hz
      have := hres0 z
      rwa [hz, map_zero, map_zero, sub_zero] at this
    have hI : Ideal.map (wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) hw₀)
        (RingHom.ker ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom) ≤
        IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) :=
      Ideal.map_le_iff_le_comap.mpr (fun z hz => Ideal.mem_comap.mpr (hm z (RingHom.mem_ker.mp hz)))
    have hI2 : wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) hw₀ e ∈
        IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 2 := by
      have h1 := Ideal.mem_map_of_mem (wcpaLqPsi g ι s σ hs F₀.Ω (τ (IsLocalRing.closedPoint K)) hw₀) he
      rw [Ideal.map_pow] at h1
      exact Ideal.pow_right_mono hI 2 h1
    have hu0 := hm _ F₀.hu
    have hv0 := hm _ F₀.hv
    rw [hrestr, hx, map_add, map_add, map_mul, map_mul]
    have eq : ∀ (Pa Pb U V Pe ca cb : (Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))),
        Pa * U + Pb * V + Pe - (ca * U + cb * V) = (Pa - ca) * U + (Pb - cb) * V + Pe := by
      intros; ring
    rw [eq]
    exact Ideal.add_mem _ (Ideal.add_mem _ (mm _ _ _ _ (hres0 a) hu0) (mm _ _ _ _ (hres0 b) hv0)) hI2
  have hΩ1 : F₀.Ω ≤ F₁.Ω := hΩ.trans inf_le_left
  have hΩ2 : F₀.Ω ≤ F₂.Ω := hΩ.trans inf_le_right
  have hV1 : F₀.V ≤ F₁.V := hV.trans inf_le_left
  have hV2 : F₀.V ≤ F₂.V := hV.trans inf_le_right
  obtain ⟨a1, b1, e1, he1, hx1⟩ := hdec _ (hk F₁ hΩ1 hV1 F₁.u F₁.hu)
  obtain ⟨c1, d1, e1', he1', hy1⟩ := hdec _ (hk F₁ hΩ1 hV1 F₁.v F₁.hv)
  obtain ⟨a2, b2, e2, he2, hx2⟩ := hdec _ (hk F₂ hΩ2 hV2 F₂.u F₂.hu)
  obtain ⟨c2, d2, e2', he2', hy2⟩ := hdec _ (hk F₂ hΩ2 hV2 F₂.v F₂.hv)
  have hD : IsUnit (((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom a2 *
      ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom d2 -
      ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom b2 *
      ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom c2) := by
    apply unitEval S F₀.V
    intro K _ σ h
    have hcomm : (σ ≫ ι) ≫ g = 𝟙 _ ≫ (σ ≫ ι ≫ g) := by rw [Category.id_comp, Category.assoc]
    let τ : Spec (.of K) ⟶ Limits.pullback g (σ ≫ ι ≫ g) := Limits.pullback.lift (σ ≫ ι) (𝟙 _) hcomm
    have hτs : τ ≫ Limits.pullback.snd g (σ ≫ ι ≫ g) = 𝟙 _ := Limits.pullback.lift_snd _ _ _
    have hτf : τ ≫ Limits.pullback.fst g (σ ≫ ι ≫ g) = σ ≫ ι := Limits.pullback.lift_fst _ _ _
    have hw₀ := hW K _ τ σ hτs hτf rfl h
    have hw₂ : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι _ σ rfl ⁻¹ᵁ F₂.Ω :=
      (wcpaLqTheta g ι _ σ rfl).preimage_mono hΩ2 hw₀
    have h₂ : ⊤ ≤ σ ⁻¹ᵁ F₂.V := h.trans (σ.preimage_mono hV2)
    have hb2 := (F₂.fpf K _ τ σ hτs hτf rfl h₂ hw₂).1
    have hb0 := (F₀.fpf K _ τ σ hτs hτf rfl h hw₀).1
    have c00 := hcong K _ τ σ hτs hτf rfl h F₂ hΩ2 hw₂ F₂.u a2 b2 e2 he2 hx2
    have c01 := hcong K _ τ σ hτs hτf rfl h F₂ hΩ2 hw₂ F₂.v c2 d2 e2' he2' hy2
    have := basisDet K _ _ _ _ _ _ _ _ _ _ hb0 hb2 c00 c01
    simpa only [map_sub, map_mul] using this
  set μ₀ := ((wcpaLqDelta g ι).appLE F₀.Ω F₀.V F₀.hVΩ).hom with hμ₀
  set d : Γ(S, F₀.V) := ↑hD.unit⁻¹ with hd
  have hdD : d * (μ₀ a2 * μ₀ d2 - μ₀ b2 * μ₀ c2) = 1 := hD.val_inv_mul
  set M : Matrix (Fin 2) (Fin 2) Γ(S, F₀.V) :=
    !![d * (μ₀ a1 * μ₀ d2 - μ₀ b1 * μ₀ c2), d * (μ₀ b1 * μ₀ a2 - μ₀ a1 * μ₀ b2);
      d * (μ₀ c1 * μ₀ d2 - μ₀ d1 * μ₀ c2), d * (μ₀ d1 * μ₀ a2 - μ₀ c1 * μ₀ b2)] with hM
  have hM00 : M 0 0 = d * (μ₀ a1 * μ₀ d2 - μ₀ b1 * μ₀ c2) := by rw [hM]; rfl
  have hM01 : M 0 1 = d * (μ₀ b1 * μ₀ a2 - μ₀ a1 * μ₀ b2) := by rw [hM]; rfl
  have hM10 : M 1 0 = d * (μ₀ c1 * μ₀ d2 - μ₀ d1 * μ₀ c2) := by rw [hM]; rfl
  have hM11 : M 1 1 = d * (μ₀ d1 * μ₀ a2 - μ₀ c1 * μ₀ b2) := by rw [hM]; rfl
  have i00 : μ₀ a1 = M 0 0 * μ₀ a2 + M 0 1 * μ₀ c2 := by
    rw [hM00, hM01]; linear_combination (-μ₀ a1) * hdD
  have i01 : μ₀ b1 = M 0 0 * μ₀ b2 + M 0 1 * μ₀ d2 := by
    rw [hM00, hM01]; linear_combination (-μ₀ b1) * hdD
  have i10 : μ₀ c1 = M 1 0 * μ₀ a2 + M 1 1 * μ₀ c2 := by
    rw [hM10, hM11]; linear_combination (-μ₀ c1) * hdD
  have i11 : μ₀ d1 = M 1 0 * μ₀ b2 + M 1 1 * μ₀ d2 := by
    rw [hM10, hM11]; linear_combination (-μ₀ d1) * hdD
  refine ⟨M, ?_⟩
  intro K _ s τ σ hτs hτf hs h hw₁ hw₂
  have c1u := hcong K s τ σ hτs hτf hs h F₁ hΩ1 hw₁ F₁.u a1 b1 e1 he1 hx1
  have c1v := hcong K s τ σ hτs hτf hs h F₁ hΩ1 hw₁ F₁.v c1 d1 e1' he1' hy1
  have c2u := hcong K s τ σ hτs hτf hs h F₂ hΩ2 hw₂ F₂.u a2 b2 e2 he2 hx2
  have c2v := hcong K s τ σ hτs hτf hs h F₂ hΩ2 hw₂ F₂.v c2 d2 e2' he2' hy2
  have tr : ∀ {x y : Γ(S, F₀.V)}, x = y →
      wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))
        (wcpaBscEval K σ F₀.V h x) =
      wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))
        (wcpaBscEval K σ F₀.V h y) := fun hxy => by rw [hxy]
  refine ⟨algT _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ c1u c2u c2v ?_ ?_,
    algT _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ c1v c2u c2v ?_ ?_⟩
  · rw [tr i00]; simp only [map_add, map_mul]
  · rw [tr i01]; simp only [map_add, map_mul]
  · rw [tr i10]; simp only [map_add, map_mul]
  · rw [tr i11]; simp only [map_add, map_mul]

theorem wcpa_dj_lq_trans_pointwise : ∀ (k : Type u) [Field k] (C P' S : Scheme.{u})
    (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P') (ι : S ⟶ C), wcpaLqSH k sP' g ι →
    ∀ (F₁ F₂ : wcpaLqFrame g ι) (N : S.Opens) (hN : N ≤ F₁.V ⊓ F₂.V)
      (M : Matrix (Fin 2) (Fin 2) Γ(S, N)), wcpaLqTrans F₁ F₂ N M →
    IsUnit M.det ∧ (∀ M' : Matrix (Fin 2) (Fin 2) Γ(S, N), wcpaLqTrans F₁ F₂ N M' → M' = M) ∧
      ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ N),
        wcpaLqConic (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) F₁.a))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) F₁.b))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) F₁.c))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) F₂.a))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) F₂.b))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) F₂.c))
          (wcpaBscEval K σ N h (M 0 0)) (wcpaBscEval K σ N h (M 0 1))
          (wcpaBscEval K σ N h (M 1 0)) (wcpaBscEval K σ N h (M 1 1)) :=
by
  intro k _ C P' S sP' g ι hSH F₁ F₂ N hN M hT



  have evRepr : ∀ (X : Scheme.{u}) (U : X.Opens) (x : Γ(X, U)) (K : Type u) [Field K]
      (σ : Spec (.of K) ⟶ X) (h : ⊤ ≤ σ ⁻¹ᵁ U),
      (σ.appLE U ⊤ h).hom x = (Scheme.ΓSpecIso (.of K)).inv.hom (wcpaBscEval K σ U h x) := by
    intro X U x K _ σ h
    simp only [wcpaBscEval, CommRingCat.hom_comp, RingHom.comp_apply]
    exact (Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of K)) _).symm
  have keyU : ∀ (X : Scheme.{u}) (U : X.Opens) (x : Γ(X, U)) (K : Type u) [Field K]
      (σ : Spec (.of K) ⟶ X) (h : ⊤ ≤ σ ⁻¹ᵁ U), wcpaBscEval K σ U h x ≠ 0 →
      σ (IsLocalRing.closedPoint K) ∈ X.basicOpen x := by
    intro X U x K _ σ h hx
    have hr : IsUnit ((σ.appLE U ⊤ h).hom x) := by
      rw [evRepr X U x K σ h]
      exact (IsUnit.mk0 _ hx).map _
    have hb : (⊤ : (Spec (.of K)).Opens) = ⊤ ⊓ σ ⁻¹ᵁ X.basicOpen x :=
      (Scheme.basicOpen_of_isUnit _ hr).symm.trans (Scheme.basicOpen_appLE σ ⊤ U h x)
    have hm : IsLocalRing.closedPoint K ∈ (⊤ ⊓ σ ⁻¹ᵁ X.basicOpen x : (Spec (.of K)).Opens) := by
      rw [← hb]; trivial
    exact (TopologicalSpace.Opens.mem_inf.mp hm).2
  have keyZ : ∀ (X : Scheme.{u}) (U : X.Opens) (x : Γ(X, U)) (K : Type u) [Field K]
      (σ : Spec (.of K) ⟶ X) (h : ⊤ ≤ σ ⁻¹ᵁ U), wcpaBscEval K σ U h x = 0 →
      σ (IsLocalRing.closedPoint K) ∉ X.basicOpen x := by
    intro X U x K _ σ h hx hmem
    have hr : (σ.appLE U ⊤ h).hom x = 0 := by
      rw [evRepr X U x K σ h, hx, map_zero]
    have h0 : (Spec (.of K)).basicOpen ((σ.appLE U ⊤ h).hom x) = ⊥ := by
      rw [hr]; exact Scheme.basicOpen_zero _ _
    have hb : (⊥ : (Spec (.of K)).Opens) = ⊤ ⊓ σ ⁻¹ᵁ X.basicOpen x :=
      h0.symm.trans (Scheme.basicOpen_appLE σ ⊤ U h x)
    have hm : IsLocalRing.closedPoint K ∈ (⊤ ⊓ σ ⁻¹ᵁ X.basicOpen x : (Spec (.of K)).Opens) :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨trivial, hmem⟩
    rw [← hb] at hm
    first
      | exact hm
      | (rw [← SetLike.mem_coe, TopologicalSpace.Opens.coe_bot] at hm; exact hm)
  have evalUnit : ∀ (X : Scheme.{u}) (U : X.Opens) (x : Γ(X, U)),
      (∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ X) (h : ⊤ ≤ σ ⁻¹ᵁ U),
        wcpaBscEval K σ U h x ≠ 0) → IsUnit x := by
    intro X U x hx
    apply RingedSpace.isUnit_of_isUnit_germ X.toRingedSpace U x
    intro p hp
    have hσ : ⊤ ≤ X.fromSpecResidueField p ⁻¹ᵁ U := by
      intro y _
      show X.fromSpecResidueField p y ∈ U
      rw [Scheme.fromSpecResidueField_apply]
      exact hp
    have h1 := keyU X U x (X.residueField p) (X.fromSpecResidueField p) hσ
      (hx (X.residueField p) (X.fromSpecResidueField p) hσ)
    have hq : (X.fromSpecResidueField p) (IsLocalRing.closedPoint (X.residueField p)) = p :=
      Scheme.fromSpecResidueField_apply p _
    have h1' : p ∈ X.basicOpen x := by rw [← hq]; exact h1
    exact (X.mem_basicOpen x p hp).mp h1'
  have evalZero : ∀ (X : Scheme.{u}) [IsReduced X] (U : X.Opens) (x : Γ(X, U)),
      (∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ X) (h : ⊤ ≤ σ ⁻¹ᵁ U),
        wcpaBscEval K σ U h x = 0) → x = 0 := by
    intro X _ U x hx
    rw [← basicOpen_eq_bot_iff, eq_bot_iff]
    intro p hp
    have hpU : p ∈ U := X.basicOpen_le x hp
    have hσ : ⊤ ≤ X.fromSpecResidueField p ⁻¹ᵁ U := by
      intro y _
      show X.fromSpecResidueField p y ∈ U
      rw [Scheme.fromSpecResidueField_apply]
      exact hpU
    have h1 := keyZ X U x (X.residueField p) (X.fromSpecResidueField p) hσ
      (hx (X.residueField p) (X.fromSpecResidueField p) hσ)
    have hq : (X.fromSpecResidueField p) (IsLocalRing.closedPoint (X.residueField p)) = p :=
      Scheme.fromSpecResidueField_apply p _
    exact absurd (show (X.fromSpecResidueField p) (IsLocalRing.closedPoint (X.residueField p)) ∈
      X.basicOpen x by rw [hq]; exact hp) h1



  have detNZ : ∀ (K : Type u) [Field K] (O : Type u) [CommRing O] [IsLocalRing O] (φ : K →+* O)
      (x₁ y₁ x₂ y₂ : O), wcpaLqBasis K O φ x₁ y₁ → wcpaLqBasis K O φ x₂ y₂ →
      ∀ m00 m01 m10 m11 : K, x₁ - (φ m00 * x₂ + φ m01 * y₂) ∈ IsLocalRing.maximalIdeal O ^ 2 →
      y₁ - (φ m10 * x₂ + φ m11 * y₂) ∈ IsLocalRing.maximalIdeal O ^ 2 →
      m00 * m11 - m01 * m10 ≠ 0 := by
    intro K _ O _ _ φ x₁ y₁ x₂ y₂ hB1 hB2 m00 m01 m10 m11 h1 h2
    obtain ⟨-, -, hsp1, -⟩ := hB1
    obtain ⟨hx2, hy2, -, hind2⟩ := hB2
    obtain ⟨n00, n01, hn0⟩ := hsp1 x₂ hx2
    obtain ⟨n10, n11, hn1⟩ := hsp1 y₂ hy2
    have r0 : φ (1 - (n00 * m00 + n01 * m10)) * x₂ + φ (-(n00 * m01 + n01 * m11)) * y₂ ∈
        IsLocalRing.maximalIdeal O ^ 2 := by
      have e : φ (1 - (n00 * m00 + n01 * m10)) * x₂ + φ (-(n00 * m01 + n01 * m11)) * y₂ =
          (x₂ - (φ n00 * x₁ + φ n01 * y₁)) + φ n00 * (x₁ - (φ m00 * x₂ + φ m01 * y₂)) +
            φ n01 * (y₁ - (φ m10 * x₂ + φ m11 * y₂)) := by
        simp only [map_sub, map_one, map_neg, map_add, map_mul]; ring
      rw [e]
      exact add_mem (add_mem hn0 (Ideal.mul_mem_left _ _ h1)) (Ideal.mul_mem_left _ _ h2)
    have r1 : φ (-(n10 * m00 + n11 * m10)) * x₂ + φ (1 - (n10 * m01 + n11 * m11)) * y₂ ∈
        IsLocalRing.maximalIdeal O ^ 2 := by
      have e : φ (-(n10 * m00 + n11 * m10)) * x₂ + φ (1 - (n10 * m01 + n11 * m11)) * y₂ =
          (y₂ - (φ n10 * x₁ + φ n11 * y₁)) + φ n10 * (x₁ - (φ m00 * x₂ + φ m01 * y₂)) +
            φ n11 * (y₁ - (φ m10 * x₂ + φ m11 * y₂)) := by
        simp only [map_sub, map_one, map_neg, map_add, map_mul]; ring
      rw [e]
      exact add_mem (add_mem hn1 (Ideal.mul_mem_left _ _ h1)) (Ideal.mul_mem_left _ _ h2)
    obtain ⟨a0, a1⟩ := hind2 _ _ r0
    obtain ⟨b0, b1⟩ := hind2 _ _ r1
    intro hdet
    have key : (n00 * n11 - n01 * n10) * (m00 * m11 - m01 * m10) = 1 := by
      linear_combination ((1 - (n10 * m01 + n11 * m11)) - 1) * a0 - b1 -
        (-(n00 * m01 + n01 * m11)) * b0
    rw [hdet, mul_zero] at key
    exact zero_ne_one key



  have transport : ∀ (K : Type u) [Field K] (O : Type u) [CommRing O] (I : Ideal O) (φ : K →+* O)
      (x₁ y₁ x₂ y₂ : O), x₁ ∈ I → y₁ ∈ I → x₂ ∈ I → y₂ ∈ I → ∀ m00 m01 m10 m11 a b c : K,
      x₁ - (φ m00 * x₂ + φ m01 * y₂) ∈ I ^ 2 → y₁ - (φ m10 * x₂ + φ m11 * y₂) ∈ I ^ 2 →
      φ a * x₁ ^ 2 + φ b * (x₁ * y₁) + φ c * y₁ ^ 2 ∈ I ^ 3 →
      φ (a * m00 ^ 2 + b * (m00 * m10) + c * m10 ^ 2) * x₂ ^ 2 +
        φ (2 * a * (m00 * m01) + b * (m00 * m11 + m01 * m10) + 2 * c * (m10 * m11)) * (x₂ * y₂) +
        φ (a * m01 ^ 2 + b * (m01 * m11) + c * m11 ^ 2) * y₂ ^ 2 ∈ I ^ 3 := by
    intro K _ O _ I φ x₁ y₁ x₂ y₂ hx1 hy1 hx2 hy2 m00 m01 m10 m11 a b c he1 he2 hq
    have hL1 : φ m00 * x₂ + φ m01 * y₂ ∈ I :=
      add_mem (Ideal.mul_mem_left _ _ hx2) (Ideal.mul_mem_left _ _ hy2)
    have hL2 : φ m10 * x₂ + φ m11 * y₂ ∈ I :=
      add_mem (Ideal.mul_mem_left _ _ hx2) (Ideal.mul_mem_left _ _ hy2)
    have m3 : ∀ e z : O, e ∈ I ^ 2 → z ∈ I → e * z ∈ I ^ 3 := by
      intro e z he hz
      have hp3 : I ^ 3 = I ^ 2 * I := pow_succ I 2
      rw [hp3]
      exact Ideal.mul_mem_mul he hz
    have e : φ (a * m00 ^ 2 + b * (m00 * m10) + c * m10 ^ 2) * x₂ ^ 2 +
        φ (2 * a * (m00 * m01) + b * (m00 * m11 + m01 * m10) + 2 * c * (m10 * m11)) * (x₂ * y₂) +
        φ (a * m01 ^ 2 + b * (m01 * m11) + c * m11 ^ 2) * y₂ ^ 2 =
        (φ a * x₁ ^ 2 + φ b * (x₁ * y₁) + φ c * y₁ ^ 2) -
        (φ a * ((x₁ - (φ m00 * x₂ + φ m01 * y₂)) * (x₁ + (φ m00 * x₂ + φ m01 * y₂))) +
          φ b * ((x₁ - (φ m00 * x₂ + φ m01 * y₂)) * y₁ +
            (y₁ - (φ m10 * x₂ + φ m11 * y₂)) * (φ m00 * x₂ + φ m01 * y₂)) +
          φ c * ((y₁ - (φ m10 * x₂ + φ m11 * y₂)) * (y₁ + (φ m10 * x₂ + φ m11 * y₂)))) := by
      simp only [map_add, map_mul, map_pow, map_ofNat]; ring
    rw [e]
    refine sub_mem hq (add_mem (add_mem ?_ ?_) ?_)
    · exact Ideal.mul_mem_left _ _ (m3 _ _ he1 (add_mem hx1 hL1))
    · exact Ideal.mul_mem_left _ _ (add_mem (m3 _ _ he1 hy1) (m3 _ _ he2 hL1))
    · exact Ideal.mul_mem_left _ _ (m3 _ _ he2 (add_mem hy1 hL2))



  have conicU : ∀ (K : Type u) [Field K] (O : Type u) [CommRing O] [IsLocalRing O] (φ : K →+* O),
      wcpaLqHilb K O φ → ∀ u v : O, wcpaLqBasis K O φ u v → ∀ a b c a' b' c' : K,
      (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0) →
      φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2 ∈ IsLocalRing.maximalIdeal O ^ 3 →
      φ a' * u ^ 2 + φ b' * (u * v) + φ c' * v ^ 2 ∈ IsLocalRing.maximalIdeal O ^ 3 →
      ∃ t : K, a' = t * a ∧ b' = t * b ∧ c' = t * c := by
    intro K _ O _ _ φ hH u v hB a b c a' b' c' hne hq hq'
    letI : Algebra K O := φ.toAlgebra
    obtain ⟨hu, hv, hsp, -⟩ := hB
    have h2 : Module.finrank K (O ⧸ IsLocalRing.maximalIdeal O ^ 2) = 3 := hH 2 (by norm_num)
    have h3 : Module.finrank K (O ⧸ IsLocalRing.maximalIdeal O ^ 3) = 5 := hH 3 (by norm_num)
    have hle : IsLocalRing.maximalIdeal O ^ 3 ≤ IsLocalRing.maximalIdeal O ^ 2 :=
      Ideal.pow_le_pow_right (by norm_num)
    let π : (O ⧸ IsLocalRing.maximalIdeal O ^ 3) →ₗ[K] (O ⧸ IsLocalRing.maximalIdeal O ^ 2) :=
      (Ideal.Quotient.factorₐ K hle).toLinearMap
    have hπ : ∀ y : O, π (Ideal.Quotient.mk _ y) = Ideal.Quotient.mk _ y := fun y =>
      Ideal.Quotient.factorₐ_apply_mk K hle y
    let Λ₀ : (Fin 3 → K) →ₗ[K] O :=
      { toFun := fun α => φ (α 0) * u ^ 2 + φ (α 1) * (u * v) + φ (α 2) * v ^ 2
        map_add' := by
          intro α β
          simp only [Pi.add_apply, map_add]
          ring
        map_smul' := by
          intro c α
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
          rw [Algebra.smul_def]
          change _ = φ c * _
          simp only [map_mul]
          ring }
    let Λ : (Fin 3 → K) →ₗ[K] (O ⧸ IsLocalRing.maximalIdeal O ^ 3) :=
      (Ideal.Quotient.mkₐ K (IsLocalRing.maximalIdeal O ^ 3)).toLinearMap ∘ₗ Λ₀
    have hΛ : ∀ α : Fin 3 → K, Λ α = Ideal.Quotient.mk _
        (φ (α 0) * u ^ 2 + φ (α 1) * (u * v) + φ (α 2) * v ^ 2) := fun α => rfl
    have hπs : Function.Surjective π := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact ⟨Ideal.Quotient.mk _ y, hπ y⟩
    haveI : FiniteDimensional K (O ⧸ IsLocalRing.maximalIdeal O ^ 3) :=
      Module.finite_of_finrank_pos (by rw [h3]; norm_num)
    have hkerπ : Module.finrank K (LinearMap.ker π) = 2 := by
      have e1 := LinearMap.finrank_range_add_finrank_ker π
      have e2 : Module.finrank K (LinearMap.range π) = 3 := by
        rw [LinearMap.range_eq_top.mpr hπs, finrank_top]; exact h2
      have e3 := e1.trans h3
      omega
    have claim : ∀ y ∈ IsLocalRing.maximalIdeal O ^ 2, ∃ α β γ : K,
        y - (φ α * u ^ 2 + φ β * (u * v) + φ γ * v ^ 2) ∈ IsLocalRing.maximalIdeal O ^ 3 := by
      intro y hy
      rw [sq] at hy
      refine Submodule.mul_induction_on (C := fun y => ∃ α β γ : K,
        y - (φ α * u ^ 2 + φ β * (u * v) + φ γ * v ^ 2) ∈ IsLocalRing.maximalIdeal O ^ 3) hy ?_ ?_
      · intro x hx z hz
        obtain ⟨c₁, c₂, hc⟩ := hsp x hx
        obtain ⟨d₁, d₂, hd⟩ := hsp z hz
        refine ⟨c₁ * d₁, c₁ * d₂ + c₂ * d₁, c₂ * d₂, ?_⟩
        have hL : φ c₁ * u + φ c₂ * v ∈ IsLocalRing.maximalIdeal O :=
          add_mem (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
        have e : x * z - (φ (c₁ * d₁) * u ^ 2 + φ (c₁ * d₂ + c₂ * d₁) * (u * v) +
            φ (c₂ * d₂) * v ^ 2) =
            (x - (φ c₁ * u + φ c₂ * v)) * z + (z - (φ d₁ * u + φ d₂ * v)) * (φ c₁ * u + φ c₂ * v) := by
          simp only [map_add, map_mul]; ring
        have hp3 : IsLocalRing.maximalIdeal O ^ 3 =
            IsLocalRing.maximalIdeal O ^ 2 * IsLocalRing.maximalIdeal O := pow_succ _ 2
        rw [e, hp3]
        exact add_mem (Ideal.mul_mem_mul hc hz) (Ideal.mul_mem_mul hd hL)
      · rintro x y ⟨α, β, γ, hx⟩ ⟨α', β', γ', hy⟩
        refine ⟨α + α', β + β', γ + γ', ?_⟩
        have e : x + y - (φ (α + α') * u ^ 2 + φ (β + β') * (u * v) + φ (γ + γ') * v ^ 2) =
            (x - (φ α * u ^ 2 + φ β * (u * v) + φ γ * v ^ 2)) +
              (y - (φ α' * u ^ 2 + φ β' * (u * v) + φ γ' * v ^ 2)) := by
          simp only [map_add]; ring
        rw [e]
        exact add_mem hx hy
    have hrange : LinearMap.range Λ = LinearMap.ker π := by
      apply le_antisymm
      · rintro _ ⟨α, rfl⟩
        rw [LinearMap.mem_ker, hΛ, hπ, Ideal.Quotient.eq_zero_iff_mem]
        have hu2 : u ^ 2 ∈ IsLocalRing.maximalIdeal O ^ 2 := Ideal.pow_mem_pow hu 2
        have hv2 : v ^ 2 ∈ IsLocalRing.maximalIdeal O ^ 2 := Ideal.pow_mem_pow hv 2
        have huv : u * v ∈ IsLocalRing.maximalIdeal O ^ 2 := by
          rw [sq]; exact Ideal.mul_mem_mul hu hv
        exact add_mem (add_mem (Ideal.mul_mem_left _ _ hu2) (Ideal.mul_mem_left _ _ huv))
          (Ideal.mul_mem_left _ _ hv2)
      · intro z hz
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
        rw [LinearMap.mem_ker, hπ, Ideal.Quotient.eq_zero_iff_mem] at hz
        obtain ⟨α, β, γ, hrep⟩ := claim y hz
        refine ⟨![α, β, γ], ?_⟩
        rw [hΛ, Ideal.Quotient.eq]
        have h1 := (IsLocalRing.maximalIdeal O ^ 3).neg_mem hrep
        rw [neg_sub] at h1
        exact h1
    have hkerΛ : Module.finrank K (LinearMap.ker Λ) = 1 := by
      have e1 := LinearMap.finrank_range_add_finrank_ker Λ
      rw [hrange, hkerπ, Module.finrank_fin_fun] at e1
      omega
    have hw : ![a, b, c] ∈ LinearMap.ker Λ := by
      rw [LinearMap.mem_ker, hΛ, Ideal.Quotient.eq_zero_iff_mem]
      exact hq
    have hw' : ![a', b', c'] ∈ LinearMap.ker Λ := by
      rw [LinearMap.mem_ker, hΛ, Ideal.Quotient.eq_zero_iff_mem]
      exact hq'
    have hw0 : (⟨![a, b, c], hw⟩ : LinearMap.ker Λ) ≠ 0 := by
      intro h0
      have e := congrArg Subtype.val h0
      have ea := congrFun e 0
      have eb := congrFun e 1
      have ec := congrFun e 2
      simp at ea eb ec
      rcases hne with h | h | h
      · exact h ea
      · exact h eb
      · exact h ec
    obtain ⟨t, ht⟩ := (finrank_eq_one_iff_of_nonzero' _ hw0).mp hkerΛ ⟨![a', b', c'], hw'⟩
    have e := congrArg Subtype.val ht
    have ea := congrFun e 0
    have eb := congrFun e 1
    have ec := congrFun e 2
    simp at ea eb ec
    exact ⟨t, ea.symm, eb.symm, ec.symm⟩



  have uniqAlg : ∀ (K : Type u) [Field K] (O : Type u) [CommRing O] (I : Ideal O) (φ : K →+* O)
      (x x₂ y₂ : O) (p q p' q' : K), x - (φ p * x₂ + φ q * y₂) ∈ I →
      x - (φ p' * x₂ + φ q' * y₂) ∈ I → φ (p' - p) * x₂ + φ (q' - q) * y₂ ∈ I := by
    intro K _ O _ I φ x x₂ y₂ p q p' q' h1 h2
    have e : φ (p' - p) * x₂ + φ (q' - q) * y₂ =
        (x - (φ p * x₂ + φ q * y₂)) - (x - (φ p' * x₂ + φ q' * y₂)) := by
      simp only [map_sub]; ring
    rw [e]
    exact sub_mem h1 h2
  have nondeg : ∀ (K : Type u) [Field K] (a b c m00 m01 m10 m11 : K), b ^ 2 - 4 * a * c ≠ 0 →
      m00 * m11 - m01 * m10 ≠ 0 →
      (a * m00 ^ 2 + b * (m00 * m10) + c * m10 ^ 2 ≠ 0 ∨
        2 * a * (m00 * m01) + b * (m00 * m11 + m01 * m10) + 2 * c * (m10 * m11) ≠ 0 ∨
        a * m01 ^ 2 + b * (m01 * m11) + c * m11 ^ 2 ≠ 0) := by
    intro K _ a b c m00 m01 m10 m11 hd hm
    by_contra hcon
    push_neg at hcon
    obtain ⟨hA, hB, hC⟩ := hcon
    exact mul_ne_zero (pow_ne_zero 2 hm) hd (by
      linear_combination
        (2 * a * (m00 * m01) + b * (m00 * m11 + m01 * m10) + 2 * c * (m10 * m11)) * hB -
          4 * (a * m01 ^ 2 + b * (m01 * m11) + c * m11 ^ 2) * hA)



  have hred : IsReduced S := hSH.2.2.2.1
  haveI := hred
  have hH := hSH.2.2.2.2.2
  have hres : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (N N' : S.Opens) (hle : N' ≤ N)
      (h' : ⊤ ≤ σ ⁻¹ᵁ N') (h : ⊤ ≤ σ ⁻¹ᵁ N) (x : Γ(S, N)),
      wcpaBscEval K σ N' h' (wcpaBscRes S hle x) = wcpaBscEval K σ N h x := by
    intro K _ σ N N' hle h' h x
    simp only [wcpaBscEval, wcpaBscRes]
    rw [← CommRingCat.comp_apply, ← Category.assoc, Scheme.Hom.map_appLE]
  have pw : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ N),
      wcpaBscEval K σ N h (M 0 0) * wcpaBscEval K σ N h (M 1 1) -
          wcpaBscEval K σ N h (M 0 1) * wcpaBscEval K σ N h (M 1 0) ≠ 0 ∧
      (∀ M' : Matrix (Fin 2) (Fin 2) Γ(S, N), wcpaLqTrans F₁ F₂ N M' →
        ∀ i j, wcpaBscEval K σ N h (M' i j) = wcpaBscEval K σ N h (M i j)) ∧
      wcpaLqConic (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) F₁.a))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) F₁.b))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) F₁.c))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) F₂.a))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) F₂.b))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) F₂.c))
          (wcpaBscEval K σ N h (M 0 0)) (wcpaBscEval K σ N h (M 0 1))
          (wcpaBscEval K σ N h (M 1 0)) (wcpaBscEval K σ N h (M 1 1)) := by
    intro K _ σ h
    obtain ⟨s, hs⟩ : ∃ s : Spec (.of K) ⟶ P', s = σ ≫ ι ≫ g := ⟨_, rfl⟩
    obtain ⟨τ, hτs, hτf⟩ : ∃ τ : Spec (.of K) ⟶ Limits.pullback g s,
        τ ≫ Limits.pullback.snd g s = 𝟙 _ ∧ τ ≫ Limits.pullback.fst g s = σ ≫ ι :=
      ⟨Limits.pullback.lift (σ ≫ ι) (𝟙 _) (by rw [hs, Category.id_comp, Category.assoc]),
        Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩
    have hθ : ∀ Ω : (wcpaLqY g ι).Opens, wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) ∈ Ω →
        τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω := by
      intro Ω hΩ
      have e : τ ≫ wcpaLqTheta g ι s σ hs = σ ≫ wcpaLqDelta g ι := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_fst,
            Limits.pullback.lift_fst, hτf]
        · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_snd,
            Limits.pullback.lift_snd, ← Category.assoc, hτs, Category.id_comp, Category.comp_id]
      have h2 : wcpaLqTheta g ι s σ hs (τ (IsLocalRing.closedPoint K)) =
          wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) := by
        exact (Scheme.Hom.comp_apply τ (wcpaLqTheta g ι s σ hs) _).symm.trans
          ((congrArg (fun φ : Spec (.of K) ⟶ wcpaLqY g ι => φ (IsLocalRing.closedPoint K)) e).trans
            (Scheme.Hom.comp_apply σ (wcpaLqDelta g ι) _))
      rw [Scheme.Hom.mem_preimage, h2]
      exact hΩ
    have hpN : σ (IsLocalRing.closedPoint K) ∈ N := by
      have := h (show IsLocalRing.closedPoint K ∈ (⊤ : (Spec (.of K)).Opens) from trivial)
      exact this
    have hp12 : σ (IsLocalRing.closedPoint K) ∈ F₁.V ⊓ F₂.V := hN hpN
    have hp1 : σ (IsLocalRing.closedPoint K) ∈ F₁.V := (TopologicalSpace.Opens.mem_inf.mp hp12).1
    have hp2 : σ (IsLocalRing.closedPoint K) ∈ F₂.V := (TopologicalSpace.Opens.mem_inf.mp hp12).2
    have h₁ : ⊤ ≤ σ ⁻¹ᵁ F₁.V := by
      intro x hx
      have hx' : σ x ∈ N := h hx
      exact (TopologicalSpace.Opens.mem_inf.mp (hN hx')).1
    have h₂ : ⊤ ≤ σ ⁻¹ᵁ F₂.V := by
      intro x hx
      have hx' : σ x ∈ N := h hx
      exact (TopologicalSpace.Opens.mem_inf.mp (hN hx')).2
    have hw₁ := hθ F₁.Ω (by
      have := F₁.hVΩ hp1
      exact this)
    have hw₂ := hθ F₂.Ω (by
      have := F₂.hVΩ hp2
      exact this)
    have hmem : Limits.pullback.fst g s (τ (IsLocalRing.closedPoint K)) ∈ Set.range ι := by
      refine ⟨σ (IsLocalRing.closedPoint K), ?_⟩
      first
        | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hτf])
        | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hτf]; rfl)
        | exact (congrArg (fun φ => φ (IsLocalRing.closedPoint K)) hτf).symm
        | simp only [← Scheme.Hom.comp_apply, hτf]
    have hHilb := (hH K s τ hτs hmem).1
    obtain ⟨B1, R1⟩ := F₁.fpf K s τ σ hτs hτf hs h₁ hw₁
    obtain ⟨B2, R2⟩ := F₂.fpf K s τ σ hτs hτf hs h₂ hw₂
    obtain ⟨T1, T2⟩ := hT K s τ σ hτs hτf hs h hw₁ hw₂
    have hdet := detNZ _ _ _ _ _ _ _ B1 B2 _ _ _ _ T1 T2
    have B1c := B1
    have B2c := B2
    obtain ⟨hx1m, hy1m, -, -⟩ := B1c
    obtain ⟨hx2m, hy2m, -, -⟩ := B2c
    refine ⟨hdet, ?_, ?_⟩
    · intro M' hT'
      obtain ⟨T1', T2'⟩ := hT' K s τ σ hτs hτf hs h hw₁ hw₂
      obtain ⟨-, -, -, hind⟩ := B2
      obtain ⟨e00, e01⟩ := hind _ _ (uniqAlg _ _ _ _ _ _ _ _ _ _ _ T1 T1')
      obtain ⟨e10, e11⟩ := hind _ _ (uniqAlg _ _ _ _ _ _ _ _ _ _ _ T2 T2')
      intro i j
      fin_cases i <;> fin_cases j
      · exact sub_eq_zero.mp e00
      · exact sub_eq_zero.mp e01
      · exact sub_eq_zero.mp e10
      · exact sub_eq_zero.mp e11
    · rw [hres K σ F₁.V N (hN.trans inf_le_left) h h₁ F₁.a,
        hres K σ F₁.V N (hN.trans inf_le_left) h h₁ F₁.b,
        hres K σ F₁.V N (hN.trans inf_le_left) h h₁ F₁.c,
        hres K σ F₂.V N (hN.trans inf_le_right) h h₂ F₂.a,
        hres K σ F₂.V N (hN.trans inf_le_right) h h₂ F₂.b,
        hres K σ F₂.V N (hN.trans inf_le_right) h h₂ F₂.c]
      have hdisc : wcpaBscEval K σ F₁.V h₁ F₁.b ^ 2 -
          4 * wcpaBscEval K σ F₁.V h₁ F₁.a * wcpaBscEval K σ F₁.V h₁ F₁.c ≠ 0 := by
        have := F₁.disc.map (wcpaBscEval K σ F₁.V h₁)
        simp only [map_sub, map_mul, map_pow, map_ofNat] at this
        exact this.ne_zero
      have Q := transport _ _ _ _ _ _ _ _ hx1m hy1m hx2m hy2m _ _ _ _ _ _ _ T1 T2 R1
      have hne := nondeg _ _ _ _ _ _ _ _ hdisc hdet
      obtain ⟨t, ht1, ht2, ht3⟩ := conicU _ _ _ hHilb _ _ B2 _ _ _ _ _ _ hne Q R2
      unfold wcpaLqConic
      exact ⟨t, ht1, ht2, ht3⟩
  refine ⟨?_, ?_, ?_⟩
  · apply evalUnit S N M.det
    intro K _ σ h
    rw [Matrix.det_fin_two, map_sub, map_mul, map_mul]
    exact (pw K σ h).1
  · intro M' hT'
    ext i j
    have h0 : M' i j - M i j = 0 := by
      apply evalZero S N (M' i j - M i j)
      intro K _ σ h
      rw [map_sub, sub_eq_zero]
      exact (pw K σ h).2.1 M' hT' i j
    exact sub_eq_zero.mp h0
  · intro K _ σ h
    exact (pw K σ h).2.2

theorem wcpa_dj_lq_assemble : ∀ (S : Scheme.{u}) [IsReduced S] (J : Type u) (V : J → S.Opens),
    (∀ i, IsAffineOpen (V i)) → (∀ x : S, ∃ i, x ∈ V i) →
    ∀ (a b c : ∀ i, Γ(S, V i)), (∀ i, IsUnit (b i ^ 2 - 4 * a i * c i)) →
    ∀ (T : ∀ (_ _ : J) (N : S.Opens), Matrix (Fin 2) (Fin 2) Γ(S, N) → Prop),
    (∀ i j (N N' : S.Opens) (hle : N' ≤ N) (M : Matrix (Fin 2) (Fin 2) Γ(S, N)),
      T i j N M → T i j N' (M.map (wcpaBscRes S hle))) →
    (∀ i j (N : S.Opens) (M : Matrix (Fin 2) (Fin 2) Γ(S, N)),
      (∀ p ∈ N, ∃ (N' : S.Opens) (hle : N' ≤ N), p ∈ N' ∧ T i j N' (M.map (wcpaBscRes S hle))) →
      T i j N M) →
    (∀ i j, ∀ p ∈ V i ⊓ V j, ∃ N : S.Opens, N ≤ V i ⊓ V j ∧ p ∈ N ∧
      ∃ M : Matrix (Fin 2) (Fin 2) Γ(S, N), T i j N M) →
    (∀ i (N : S.Opens), T i i N 1) →
    (∀ i j l (N : S.Opens) (M M' : Matrix (Fin 2) (Fin 2) Γ(S, N)), N ≤ V j →
      T i j N M → T j l N M' → T i l N (M * M')) →
    (∀ i j (N : S.Opens) (hN : N ≤ V i ⊓ V j) (M : Matrix (Fin 2) (Fin 2) Γ(S, N)), T i j N M →
      IsUnit M.det ∧ (∀ M' : Matrix (Fin 2) (Fin 2) Γ(S, N), T i j N M' → M' = M) ∧
      ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ N),
        wcpaLqConic (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) (a i)))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) (b i)))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_left) (c i)))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) (a j)))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) (b j)))
          (wcpaBscEval K σ N h (wcpaBscRes S (hN.trans inf_le_right) (c j)))
          (wcpaBscEval K σ N h (M 0 0)) (wcpaBscEval K σ N h (M 0 1))
          (wcpaBscEval K σ N h (M 1 0)) (wcpaBscEval K σ N h (M 1 1))) →
    ∃ D : wcpaBscChartData S, ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (i : D.J)
      (hi : ⊤ ≤ σ ⁻¹ᵁ D.V i), ∃ (j : J) (hj : ⊤ ≤ σ ⁻¹ᵁ V j),
        wcpaBscEval K σ (D.V i) hi (D.a i) = wcpaBscEval K σ (V j) hj (a j) ∧
        wcpaBscEval K σ (D.V i) hi (D.b i) = wcpaBscEval K σ (V j) hj (b j) ∧
        wcpaBscEval K σ (D.V i) hi (D.c i) = wcpaBscEval K σ (V j) hj (c j) :=
by
  intro S _ J V hV hcov a b c hdisc T hTres hTloc hTex hTid hTcomp hTpw

  have s1 : ∀ (N : S.Opens) (x : Γ(S, N)), (∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S)
      (h : ⊤ ≤ σ ⁻¹ᵁ N), wcpaBscEval K σ N h x = 0) → x = 0 := by
    intro N x hx
    apply eq_zero_of_basicOpen_eq_bot
    rw [eq_bot_iff]
    intro p hp
    exfalso
    have hpN : p ∈ N := S.basicOpen_le x hp
    let σ : Spec (.of (S.residueField p)) ⟶ S := S.fromSpecResidueField p
    have h : ⊤ ≤ σ ⁻¹ᵁ N := by
      intro y _
      show S.fromSpecResidueField p y ∈ N
      rw [Scheme.fromSpecResidueField_apply]
      exact hpN
    have h0 := hx (S.residueField p) σ h
    have hy0 : (σ.appLE N ⊤ h).hom x = 0 := by
      have e : (Scheme.ΓSpecIso (.of (S.residueField p))).inv.hom
          ((Scheme.ΓSpecIso (.of (S.residueField p))).hom.hom ((σ.appLE N ⊤ h).hom x)) =
          (σ.appLE N ⊤ h).hom x := by
        rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
      rw [← e]
      have h0' : (Scheme.ΓSpecIso (.of (S.residueField p))).hom.hom
          ((σ.appLE N ⊤ h).hom x) = 0 := by
        simpa [wcpaBscEval] using h0
      rw [h0', map_zero]
    have hb := Scheme.basicOpen_appLE σ ⊤ N h x
    rw [hy0, Scheme.basicOpen_zero] at hb
    have key : ∀ y : ↥(Spec (.of (S.residueField p))), y ∈ (⊤ ⊓ σ ⁻¹ᵁ S.basicOpen x) := by
      intro y
      refine ⟨trivial, ?_⟩
      show S.fromSpecResidueField p y ∈ S.basicOpen x
      rw [Scheme.fromSpecResidueField_apply]
      exact hp
    have hmem := key (show ↥(Spec (.of (S.residueField p))) from
      IsLocalRing.closedPoint (S.residueField p))
    rw [← hb] at hmem
    exact hmem

  have s2 : ∀ (O : S.Opens) (P : ∀ N : S.Opens, Matrix (Fin 2) (Fin 2) Γ(S, N) → Prop),
      (∀ (N N' : S.Opens) (hle : N' ≤ N) (M : Matrix (Fin 2) (Fin 2) Γ(S, N)),
        P N M → P N' (M.map (wcpaBscRes S hle))) →
      (∀ (N : S.Opens), N ≤ O → ∀ M M' : Matrix (Fin 2) (Fin 2) Γ(S, N),
        P N M → P N M' → M = M') →
      (∀ M : Matrix (Fin 2) (Fin 2) Γ(S, O), (∀ p ∈ O, ∃ (N' : S.Opens) (hle : N' ≤ O),
        p ∈ N' ∧ P N' (M.map (wcpaBscRes S hle))) → P O M) →
      (∀ p ∈ O, ∃ N : S.Opens, N ≤ O ∧ p ∈ N ∧
        ∃ M : Matrix (Fin 2) (Fin 2) Γ(S, N), P N M) →
      ∃ M : Matrix (Fin 2) (Fin 2) Γ(S, O), P O M := by
    intro O P hres huniq hloc hex
    choose Nf hNO hpN Mp hP using fun (p : {p : S // p ∈ O}) => hex p.1 p.2
    have hcov' : O ≤ iSup Nf := by
      intro q hq
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨q, hq⟩, hpN ⟨q, hq⟩⟩
    have hglue : ∀ k l : Fin 2, ∃ s : Γ(S, O), ∀ p, wcpaBscRes S (hNO p) s = Mp p k l := by
      intro k l
      have hcomp : TopCat.Presheaf.IsCompatible S.sheaf.obj Nf (fun p => Mp p k l) := by
        intro p q
        have h1 := hres _ _ (inf_le_left : Nf p ⊓ Nf q ≤ Nf p) _ (hP p)
        have h2 := hres _ _ (inf_le_right : Nf p ⊓ Nf q ≤ Nf q) _ (hP q)
        have := huniq _ (inf_le_left.trans (hNO p)) _ _ h1 h2
        exact congrFun (congrFun this k) l
      obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' S.sheaf Nf O
        (fun p => homOfLE (hNO p)) hcov' (fun p => Mp p k l) hcomp
      exact ⟨s, hs⟩
    choose s hs using hglue
    refine ⟨Matrix.of s, hloc _ ?_⟩
    intro p hp
    refine ⟨Nf ⟨p, hp⟩, hNO _, hpN _, ?_⟩
    have : (Matrix.of s).map (wcpaBscRes S (hNO ⟨p, hp⟩)) = Mp ⟨p, hp⟩ := by
      ext k l
      rw [Matrix.map_apply, Matrix.of_apply]
      exact hs k l _
    rw [this]
    exact hP _

  have s3 : ∀ (O : S.Opens) (a b c a' b' c' : Γ(S, O)) (M : Matrix (Fin 2) (Fin 2) Γ(S, O)),
      IsUnit (b ^ 2 - 4 * a * c) → IsUnit (b' ^ 2 - 4 * a' * c') → IsUnit M.det →
      (∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ O),
        wcpaLqConic (wcpaBscEval K σ O h a) (wcpaBscEval K σ O h b) (wcpaBscEval K σ O h c)
          (wcpaBscEval K σ O h a') (wcpaBscEval K σ O h b') (wcpaBscEval K σ O h c')
          (wcpaBscEval K σ O h (M 0 0)) (wcpaBscEval K σ O h (M 0 1))
          (wcpaBscEval K σ O h (M 1 0)) (wcpaBscEval K σ O h (M 1 1))) →
      ∃ lam : (Γ(S, O))ˣ,
        a' = (lam : Γ(S, O)) * (a * M 0 0 ^ 2 + b * (M 0 0 * M 1 0) + c * M 1 0 ^ 2) ∧
        b' = (lam : Γ(S, O)) * (2 * a * (M 0 0 * M 0 1) + b * (M 0 0 * M 1 1 + M 0 1 * M 1 0) +
          2 * c * (M 1 0 * M 1 1)) ∧
        c' = (lam : Γ(S, O)) * (a * M 0 1 ^ 2 + b * (M 0 1 * M 1 1) + c * M 1 1 ^ 2) := by
    intro O a b c a' b' c' M hd hd' hdet hcon
    set A := a * M 0 0 ^ 2 + b * (M 0 0 * M 1 0) + c * M 1 0 ^ 2 with hA
    set B := 2 * a * (M 0 0 * M 0 1) + b * (M 0 0 * M 1 1 + M 0 1 * M 1 0) +
      2 * c * (M 1 0 * M 1 1) with hB
    set C := a * M 0 1 ^ 2 + b * (M 0 1 * M 1 1) + c * M 1 1 ^ 2 with hC
    have hΔ : IsUnit (B ^ 2 - 4 * A * C) := by
      have e : B ^ 2 - 4 * A * C = M.det ^ 2 * (b ^ 2 - 4 * a * c) := by
        rw [Matrix.det_fin_two, hA, hB, hC]; ring
      rw [e]; exact (hdet.pow 2).mul hd
    set w : Γ(S, O) := ↑(hΔ.unit⁻¹) with hw
    have hinv : (B ^ 2 - 4 * A * C) * w = 1 := hΔ.mul_val_inv
    set l0 := (b' * B - 2 * a' * C - 2 * c' * A) * w with hl0
    have hpt : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (h : ⊤ ≤ σ ⁻¹ᵁ O),
        wcpaBscEval K σ O h (a' - l0 * A) = 0 ∧ wcpaBscEval K σ O h (b' - l0 * B) = 0 ∧
          wcpaBscEval K σ O h (c' - l0 * C) = 0 := by
      intro K _ σ h
      obtain ⟨t, ha, hb, hc⟩ := hcon K σ h
      set e := wcpaBscEval K σ O h with he
      have hA' : e a' = t * e A := by
        rw [ha, hA]; simp only [map_add, map_mul, map_pow]
      have hB' : e b' = t * e B := by
        rw [hb, hB]; simp only [map_add, map_mul, map_ofNat]
      have hC' : e c' = t * e C := by
        rw [hc, hC]; simp only [map_add, map_mul, map_pow]
      have hΔe : (e B ^ 2 - 4 * e A * e C) * e w = 1 := by
        have := congrArg e hinv
        simpa only [map_mul, map_sub, map_pow, map_ofNat, map_one] using this
      have hl : e l0 = t := by
        rw [hl0]
        simp only [map_mul, map_sub, map_ofNat]
        rw [hA', hB', hC']
        linear_combination t * hΔe
      refine ⟨?_, ?_, ?_⟩
      · rw [map_sub, map_mul, hl, hA', sub_self]
      · rw [map_sub, map_mul, hl, hB', sub_self]
      · rw [map_sub, map_mul, hl, hC', sub_self]
    have ra : a' = l0 * A := sub_eq_zero.mp (s1 _ _ (fun K _ σ h => (hpt K σ h).1))
    have rb : b' = l0 * B := sub_eq_zero.mp (s1 _ _ (fun K _ σ h => (hpt K σ h).2.1))
    have rc : c' = l0 * C := sub_eq_zero.mp (s1 _ _ (fun K _ σ h => (hpt K σ h).2.2))
    have hl0u : IsUnit l0 := by
      have e : b' ^ 2 - 4 * a' * c' = l0 * (l0 * (B ^ 2 - 4 * A * C)) := by
        rw [ra, rb, rc]; ring
      rw [e] at hd'
      exact isUnit_of_mul_isUnit_left hd'
    refine ⟨hl0u.unit, ?_, ?_, ?_⟩
    · rw [IsUnit.unit_spec]; exact ra
    · rw [IsUnit.unit_spec]; exact rb
    · rw [IsUnit.unit_spec]; exact rc

  have s4 : ∀ (R : Type u) [CommRing R] (a b c aj bj cj al bl cl r s t : R)
      (M N : Matrix (Fin 2) (Fin 2) R), IsUnit (b ^ 2 - 4 * a * c) → IsUnit (M * N).det →
      aj = s * (a * M 0 0 ^ 2 + b * (M 0 0 * M 1 0) + c * M 1 0 ^ 2) →
      bj = s * (2 * a * (M 0 0 * M 0 1) + b * (M 0 0 * M 1 1 + M 0 1 * M 1 0) +
        2 * c * (M 1 0 * M 1 1)) →
      cj = s * (a * M 0 1 ^ 2 + b * (M 0 1 * M 1 1) + c * M 1 1 ^ 2) →
      al = t * (aj * N 0 0 ^ 2 + bj * (N 0 0 * N 1 0) + cj * N 1 0 ^ 2) →
      bl = t * (2 * aj * (N 0 0 * N 0 1) + bj * (N 0 0 * N 1 1 + N 0 1 * N 1 0) +
        2 * cj * (N 1 0 * N 1 1)) →
      cl = t * (aj * N 0 1 ^ 2 + bj * (N 0 1 * N 1 1) + cj * N 1 1 ^ 2) →
      al = r * (a * (M * N) 0 0 ^ 2 + b * ((M * N) 0 0 * (M * N) 1 0) + c * (M * N) 1 0 ^ 2) →
      bl = r * (2 * a * ((M * N) 0 0 * (M * N) 0 1) +
        b * ((M * N) 0 0 * (M * N) 1 1 + (M * N) 0 1 * (M * N) 1 0) +
        2 * c * ((M * N) 1 0 * (M * N) 1 1)) →
      cl = r * (a * (M * N) 0 1 ^ 2 + b * ((M * N) 0 1 * (M * N) 1 1) + c * (M * N) 1 1 ^ 2) →
      r = s * t := by
    intro R _ a b c aj bj cj al bl cl r s t M N hd hdet ha hb hc hal hbl hcl hra hrb hrc
    rw [Matrix.det_fin_two] at hdet
    simp only [Matrix.mul_apply, Fin.sum_univ_two] at hdet hra hrb hrc
    set P00 := M 0 0 * N 0 0 + M 0 1 * N 1 0
    set P01 := M 0 0 * N 0 1 + M 0 1 * N 1 1
    set P10 := M 1 0 * N 0 0 + M 1 1 * N 1 0
    set P11 := M 1 0 * N 0 1 + M 1 1 * N 1 1
    set A := a * P00 ^ 2 + b * (P00 * P10) + c * P10 ^ 2
    set B := 2 * a * (P00 * P01) + b * (P00 * P11 + P01 * P10) + 2 * c * (P10 * P11)
    set C := a * P01 ^ 2 + b * (P01 * P11) + c * P11 ^ 2
    have eA : (r - s * t) * A = 0 := by
      subst ha hb hc; rw [hal] at hra; simp only [P00, P10, A] at hra ⊢; linear_combination -hra
    have eB : (r - s * t) * B = 0 := by
      subst ha hb hc; rw [hbl] at hrb; simp only [P00, P01, P10, P11, B] at hrb ⊢
      linear_combination -hrb
    have eC : (r - s * t) * C = 0 := by
      subst ha hb hc; rw [hcl] at hrc; simp only [P01, P11, C] at hrc ⊢; linear_combination -hrc
    have hΔ : IsUnit (B ^ 2 - 4 * A * C) := by
      have e : B ^ 2 - 4 * A * C = (P00 * P11 - P01 * P10) ^ 2 * (b ^ 2 - 4 * a * c) := by
        simp only [A, B, C]; ring
      rw [e]
      exact (hdet.pow 2).mul hd
    have hu : (r - s * t) * (B ^ 2 - 4 * A * C) = 0 := by
      linear_combination B * eB - 4 * C * eA
    have := (hΔ.mul_left_eq_zero).mp hu
    linear_combination this

  have RR : ∀ {U V W : S.Opens} (h₁ : V ≤ W) (h₂ : U ≤ V) (x : Γ(S, W)),
      wcpaBscRes S h₂ (wcpaBscRes S h₁ x) = wcpaBscRes S (h₂.trans h₁) x := by
    intro U V W h₁ h₂ x
    simp only [wcpaBscRes]
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hM : ∀ i j, ∃ M : Matrix (Fin 2) (Fin 2) Γ(S, V i ⊓ V j), T i j (V i ⊓ V j) M := by
    intro i j
    exact s2 (V i ⊓ V j) (T i j) (fun N N' hle M h => hTres i j N N' hle M h)
      (fun N hN M M' h₁ h₂ => ((hTpw i j N hN M h₁).2.1 M' h₂).symm)
      (fun M hloc => hTloc i j _ M hloc) (hTex i j)
  choose MF hMF using hM
  have detM : ∀ i j, IsUnit (MF i j).det := fun i j => (hTpw i j _ le_rfl _ (hMF i j)).1
  have M_self : ∀ i, MF i i = 1 := fun i =>
    (hTpw i i _ le_rfl 1 (hTid i _)).2.1 _ (hMF i i)
  have M_cocycle : ∀ i j l,
      (MF i l).map (wcpaBscRes S (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)) =
        (MF i j).map (wcpaBscRes S (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)) *
          (MF j l).map (wcpaBscRes S (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)) := by
    intro i j l
    have h₁ := hTres _ _ _ _ (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
      V i ⊓ V j ⊓ V l ≤ V i ⊓ V l) _ (hMF i l)
    have h₂ := hTres _ _ _ _ (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j) _ (hMF i j)
    have h₃ := hTres _ _ _ _ (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
      V i ⊓ V j ⊓ V l ≤ V j ⊓ V l) _ (hMF j l)
    have h₄ := hTcomp i j l (V i ⊓ V j ⊓ V l) _ _ (inf_le_left.trans inf_le_right) h₂ h₃
    exact ((hTpw i l (V i ⊓ V j ⊓ V l) (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      _ h₁).2.1 _ h₄).symm
  have hlam : ∀ i j, ∃ lam : (Γ(S, V i ⊓ V j))ˣ,
      wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (a j) =
        (lam : Γ(S, V i ⊓ V j)) *
          (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i) * MF i j 0 0 ^ 2 +
            wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i) * (MF i j 0 0 * MF i j 1 0) +
            wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i) * MF i j 1 0 ^ 2) ∧
      wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (b j) =
        (lam : Γ(S, V i ⊓ V j)) *
          (2 * wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i) * (MF i j 0 0 * MF i j 0 1) +
            wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i) *
              (MF i j 0 0 * MF i j 1 1 + MF i j 0 1 * MF i j 1 0) +
            2 * wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i) * (MF i j 1 0 * MF i j 1 1)) ∧
      wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (c j) =
        (lam : Γ(S, V i ⊓ V j)) *
          (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i) * MF i j 0 1 ^ 2 +
            wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i) * (MF i j 0 1 * MF i j 1 1) +
            wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i) * MF i j 1 1 ^ 2) := by
    intro i j
    have hdi := (hdisc i).map (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i))
    have hdj := (hdisc j).map (wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j))
    simp only [map_sub, map_mul, map_pow, map_ofNat] at hdi hdj
    exact s3 (V i ⊓ V j) (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i))
      (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i))
      (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i))
      (wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (a j))
      (wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (b j))
      (wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (c j))
      (MF i j) hdi hdj (detM i j) (hTpw i j _ le_rfl _ (hMF i j)).2.2
  choose lamF hrule using hlam
  have lam_self : ∀ i, lamF i i = 1 := by
    intro i
    obtain ⟨ha, hb, hc⟩ := hrule i i
    rw [M_self i] at ha hb hc
    simp only [Matrix.one_apply_eq, Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide),
      Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)] at ha hb hc
    have hdi := (hdisc i).map (wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i))
    simp only [map_sub, map_mul, map_pow, map_ofNat] at hdi
    have ea : wcpaBscRes S (inf_le_right : V i ⊓ V i ≤ V i) (a i) =
        wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (a i) := rfl
    have eb : wcpaBscRes S (inf_le_right : V i ⊓ V i ≤ V i) (b i) =
        wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (b i) := rfl
    have ec : wcpaBscRes S (inf_le_right : V i ⊓ V i ≤ V i) (c i) =
        wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (c i) := rfl
    rw [ea] at ha
    rw [eb] at hb
    rw [ec] at hc
    apply Units.ext
    rw [Units.val_one]
    have hu : ((lamF i i : Γ(S, V i ⊓ V i)) - 1) *
        (wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (b i) ^ 2 -
          4 * wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (a i) *
            wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (c i)) = 0 := by
      linear_combination (-(wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (b i))) * hb +
        4 * wcpaBscRes S (inf_le_left : V i ⊓ V i ≤ V i) (c i) * ha
    have := (hdi.mul_left_eq_zero).mp hu
    linear_combination this
  have lam_cocycle : ∀ i j l,
      wcpaBscRes S (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V i ⊓ V l) (lamF i l : Γ(S, V i ⊓ V l)) =
        wcpaBscRes S (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j) (lamF i j : Γ(S, V i ⊓ V j)) *
          wcpaBscRes S (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V i ⊓ V j ⊓ V l ≤ V j ⊓ V l) (lamF j l : Γ(S, V j ⊓ V l)) := by
    intro i j l
    have hil : V i ⊓ V j ⊓ V l ≤ V i ⊓ V l := le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hij : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j := inf_le_left
    have hjl : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l := le_inf (inf_le_left.trans inf_le_right) inf_le_right
    obtain ⟨a1, b1, c1⟩ := hrule i j
    obtain ⟨a2, b2, c2⟩ := hrule j l
    obtain ⟨a3, b3, c3⟩ := hrule i l
    replace a1 := congrArg (wcpaBscRes S hij) a1
    replace b1 := congrArg (wcpaBscRes S hij) b1
    replace c1 := congrArg (wcpaBscRes S hij) c1
    replace a2 := congrArg (wcpaBscRes S hjl) a2
    replace b2 := congrArg (wcpaBscRes S hjl) b2
    replace c2 := congrArg (wcpaBscRes S hjl) c2
    replace a3 := congrArg (wcpaBscRes S hil) a3
    replace b3 := congrArg (wcpaBscRes S hil) b3
    replace c3 := congrArg (wcpaBscRes S hil) c3
    simp only [map_add, map_mul, map_pow, map_ofNat] at a1 b1 c1 a2 b2 c2 a3 b3 c3
    simp only [RR] at a1 b1 c1 a2 b2 c2 a3 b3 c3
    have hMN := M_cocycle i j l
    have e : ∀ k m, wcpaBscRes S hil (MF i l k m) =
        ((MF i j).map (wcpaBscRes S hij) * (MF j l).map (wcpaBscRes S hjl)) k m := by
      intro k m
      rw [← hMN]
      rfl
    simp only [e] at a3 b3 c3
    have hd := (hdisc i).map (wcpaBscRes S (hij.trans inf_le_left))
    simp only [map_sub, map_mul, map_pow, map_ofNat] at hd
    have hdet : IsUnit ((MF i j).map (wcpaBscRes S hij) * (MF j l).map (wcpaBscRes S hjl)).det := by
      rw [← hMN]
      exact (hTpw i l _ hil _ (hTres _ _ _ _ hil _ (hMF i l))).1
    exact s4 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hd hdet a1 b1 c1 a2 b2 c2 a3 b3 c3
  refine ⟨⟨J, V, hV, hcov, a, b, c, hdisc, lamF, MF, detM, fun i j => (hrule i j).1,
    fun i j => (hrule i j).2.1, fun i j => (hrule i j).2.2, M_self, lam_self, M_cocycle,
    lam_cocycle⟩, ?_⟩
  intro K _ σ i hi
  exact ⟨i, hi, rfl, rfl, rfl⟩

theorem wcpa_dj_lq_conic_charts : ∀ (k : Type u) [Field k] (C P' S : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P') (ι : S ⟶ C), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → IsClosedImmersion ι → IsReduced S → IsProper g → (∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P') (τ : Spec (.of K) ⟶ Limits.pullback g s), τ ≫ Limits.pullback.snd g s = 𝟙 _ → Limits.pullback.fst g s (τ (IsLocalRing.closedPoint K)) ∈ Set.range ι → wcpaLqRatNode K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K)))) → ∃ D : wcpaBscChartData S, ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P') (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S), τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι → ∀ (i : D.J) (hi : ⊤ ≤ σ ⁻¹ᵁ D.V i), ∃ u v : (Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)), wcpaLqBasis K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K))) u v ∧ wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ (D.V i) hi (D.a i)) * u ^ 2 + wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ (D.V i) hi (D.b i)) * (u * v) + wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s) (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ (D.V i) hi (D.c i)) * v ^ 2 ∈ IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 3 :=
by
  intro k _ C P' S sP' g ι hgP hP' hι hred hgprop hH
  haveI := hred
  have hSH : wcpaLqSH k sP' g ι := ⟨hgP, hP', hι, hred, hgprop, hH⟩

  have hres : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (N N' : S.Opens) (hle : N' ≤ N)
      (h' : ⊤ ≤ σ ⁻¹ᵁ N') (h : ⊤ ≤ σ ⁻¹ᵁ N) (x : Γ(S, N)),
      wcpaBscEval K σ N' h' (wcpaBscRes S hle x) = wcpaBscEval K σ N h x := by
    intro K _ σ N N' hle h' h x
    simp only [wcpaBscEval, wcpaBscRes]
    rw [← CommRingCat.comp_apply, ← Category.assoc, Scheme.Hom.map_appLE]

  have hθ : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
      τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
      ∀ (hs : s = σ ≫ ι ≫ g) (Ω : (wcpaLqY g ι).Opens),
      wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) ∈ Ω →
      τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω := by
    intro K _ s τ σ hτs hτf hs Ω hΩ
    have e : τ ≫ wcpaLqTheta g ι s σ hs = σ ≫ wcpaLqDelta g ι := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst, hτf]
      · rw [Category.assoc, Category.assoc, wcpaLqTheta, wcpaLqDelta, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd, ← Category.assoc, hτs, Category.id_comp, Category.comp_id]
    have h2 : wcpaLqTheta g ι s σ hs (τ (IsLocalRing.closedPoint K)) =
        wcpaLqDelta g ι (σ (IsLocalRing.closedPoint K)) := by
      exact (Scheme.Hom.comp_apply τ (wcpaLqTheta g ι s σ hs) _).symm.trans
        ((congrArg (fun φ : Spec (.of K) ⟶ wcpaLqY g ι => φ (IsLocalRing.closedPoint K)) e).trans
          (Scheme.Hom.comp_apply σ (wcpaLqDelta g ι) _))
    rw [Scheme.Hom.mem_preimage, h2]
    exact hΩ
  have hpt : ∀ (K : Type u) [Field K] (σ : Spec (.of K) ⟶ S) (N : S.Opens), ⊤ ≤ σ ⁻¹ᵁ N →
      σ (IsLocalRing.closedPoint K) ∈ N := by
    intro K _ σ N h
    have := h (show IsLocalRing.closedPoint K ∈ (⊤ : (Spec (.of K)).Opens) from trivial)
    exact this
  have alg : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x y z p q m00 m01 n00 n01 n10 n11 : R),
      x - (m00 * y + m01 * z) ∈ I → y - (n00 * p + n01 * q) ∈ I → z - (n10 * p + n11 * q) ∈ I →
      x - ((m00 * n00 + m01 * n10) * p + (m00 * n01 + m01 * n11) * q) ∈ I := by
    intro R _ I x y z p q m00 m01 n00 n01 n10 n11 h1 h2 h3
    have e : x - ((m00 * n00 + m01 * n10) * p + (m00 * n01 + m01 * n11) * q) =
        (x - (m00 * y + m01 * z)) + m00 * (y - (n00 * p + n01 * q)) +
          m01 * (z - (n10 * p + n11 * q)) := by ring
    rw [e]
    exact add_mem (add_mem h1 (I.mul_mem_left _ h2)) (I.mul_mem_left _ h3)

  choose Fr hFr using fun p : S =>
    wcpa_dj_lq_frame_exists k C P' S sP' g ι hSH p ⊤ ⊤ trivial trivial
  obtain ⟨D, hD⟩ := wcpa_dj_lq_assemble S (↥S) (fun p => (Fr p).V) (fun p => (Fr p).hV)
    (fun x => ⟨x, (hFr x).1⟩) (fun p => (Fr p).a) (fun p => (Fr p).b) (fun p => (Fr p).c)
    (fun p => (Fr p).disc) (fun i j N M => wcpaLqTrans (Fr i) (Fr j) N M)
    (by

      intro i j N N' hle M hT K _ s τ σ hτs hτf hs h' hw₁ hw₂
      have h : ⊤ ≤ σ ⁻¹ᵁ N := by
        intro y hy
        exact hle (h' hy)
      have := hT K s τ σ hτs hτf hs h hw₁ hw₂
      simp only [Matrix.map_apply, hres K σ N N' hle h' h]
      exact this)
    (by

      intro i j N M hloc K _ s τ σ hτs hτf hs h hw₁ hw₂
      obtain ⟨N', hle, hp, hT⟩ := hloc (σ (IsLocalRing.closedPoint K)) (hpt K σ N h)
      have h' : ⊤ ≤ σ ⁻¹ᵁ N' := by
        intro x _
        have hx : x = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
        rw [hx]
        exact hp
      have := hT K s τ σ hτs hτf hs h' hw₁ hw₂
      simp only [Matrix.map_apply, hres K σ N N' hle h' h] at this
      exact this)
    (by

      intro i j p hp
      have hp1 : p ∈ (Fr i).V := (TopologicalSpace.Opens.mem_inf.mp hp).1
      have hp2 : p ∈ (Fr j).V := (TopologicalSpace.Opens.mem_inf.mp hp).2
      have hδ1 : wcpaLqDelta g ι p ∈ (Fr i).Ω := by
        have := (Fr i).hVΩ hp1
        exact this
      have hδ2 : wcpaLqDelta g ι p ∈ (Fr j).Ω := by
        have := (Fr j).hVΩ hp2
        exact this
      obtain ⟨F0, hp0, hV0, hΩ0⟩ := wcpa_dj_lq_frame_exists k C P' S sP' g ι hSH p
        ((Fr i).Ω ⊓ (Fr j).Ω) ((Fr i).V ⊓ (Fr j).V) hp
        (TopologicalSpace.Opens.mem_inf.mpr ⟨hδ1, hδ2⟩)
      obtain ⟨M, hM⟩ := wcpa_dj_lq_local_transition k C P' S sP' g ι hSH (Fr i) (Fr j) F0
        hV0 hΩ0
      exact ⟨F0.V, hV0, hp0, M, hM⟩)
    (by

      intro i N K _ s τ σ hτs hτf hs h hw₁ hw₂
      refine ⟨?_, ?_⟩ <;>
      · convert (Ideal.zero_mem (IsLocalRing.maximalIdeal
          ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 2)) using 1
        simp [Matrix.one_apply])
    (by

      intro i j l N M M' hNj hT1 hT2 K _ s τ σ hτs hτf hs h hw₁ hw₃
      have hw₂ := hθ K s τ σ hτs hτf hs (Fr j).Ω (by
        have := (Fr j).hVΩ (hNj (hpt K σ N h))
        exact this)
      obtain ⟨a1, a2⟩ := hT1 K s τ σ hτs hτf hs h hw₁ hw₂
      obtain ⟨b1, b2⟩ := hT2 K s τ σ hτs hτf hs h hw₂ hw₃
      simp only [Matrix.mul_apply, Fin.sum_univ_two, map_add, map_mul]
      exact ⟨alg _ _ _ _ _ _ _ _ _ _ _ _ _ a1 b1 b2, alg _ _ _ _ _ _ _ _ _ _ _ _ _ a2 b1 b2⟩)
    (fun i j N hN M hT =>
      wcpa_dj_lq_trans_pointwise k C P' S sP' g ι hSH (Fr i) (Fr j) N hN M hT)
  refine ⟨D, ?_⟩
  intro K _ s τ σ hτs hτf i hi
  have hs : s = σ ≫ ι ≫ g := by
    have h1 := congrArg (fun t => t ≫ s) hτs
    simp only [Category.assoc, Category.id_comp] at h1
    calc s = τ ≫ Limits.pullback.snd g s ≫ s := h1.symm
      _ = τ ≫ Limits.pullback.fst g s ≫ g := by rw [Limits.pullback.condition]
      _ = σ ≫ ι ≫ g := by rw [← Category.assoc, hτf, Category.assoc]
  obtain ⟨j, hj, ea, eb, ec⟩ := hD K σ i hi
  have hw := hθ K s τ σ hτs hτf hs (Fr j).Ω (by
    have := (Fr j).hVΩ (hpt K σ _ hj)
    exact this)
  obtain ⟨hb, hrel⟩ := (Fr j).fpf K s τ σ hτs hτf hs hj hw
  refine ⟨_, _, hb, ?_⟩
  rw [ea, eb, ec]
  exact hrel

theorem wcpa_dj_bsc_local_quadric : ∀ (k : Type u) [Field k] [Finite k] (C P' : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (g : C ⟶ P'), wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k sP' → wcpaDjSemistable g → ∃ (S : Scheme.{u}) (ι : S ⟶ C), IsClosedImmersion ι ∧ FormallyUnramified (ι ≫ g) ∧ (∀ x : C, x ∈ Set.range ι ↔ ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) ∧ ∃ D : wcpaBscChartData S, ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P') (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S), τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι → ∀ (i : D.J) (hi : ⊤ ≤ σ ⁻¹ᵁ D.V i), ∃ f : MvPowerSeries (Fin 2) K, 3 ≤ MvPowerSeries.order (f - wcpaBscQuad K (wcpaBscEval K σ (D.V i) hi (D.a i)) (wcpaBscEval K σ (D.V i) hi (D.b i)) (wcpaBscEval K σ (D.V i) hi (D.c i))) ∧ ∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))) ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f}), e.toRingHom.comp ((algebraMap ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))) ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g s).appTop ≫ (Limits.pullback g s).presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro k _ _ C P' sP' g hgP hP' hss
  let Sig : Set C := {x | ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)}
  have hSig : IsClosed Sig := by
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro x hx
    have hx' : ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g) := by
      by_contra hcon
      exact hx hcon
    obtain ⟨W, hxW, hW⟩ := hx'
    refine ⟨W, fun y hy => ?_, W.isOpen, hxW⟩
    exact fun h => h ⟨W, hy, hW⟩
  let Z : TopologicalSpace.Closeds C := ⟨Sig, hSig⟩
  let I := Scheme.IdealSheafData.vanishingIdeal Z
  have hred : IsReduced I.subscheme := wcpa_dj_lq_vanishing_reduced C Z
  have hι : IsClosedImmersion I.subschemeι := inferInstance
  have hset : ∀ x : C, x ∈ Set.range I.subschemeι ↔
      ¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g) := by
    intro x
    rw [Scheme.IdealSheafData.range_subschemeι]
    have h := Scheme.IdealSheafData.coe_support_vanishingIdeal Z
    rw [Set.ext_iff] at h
    exact h x
  have hunr := wcpa_dj_lq_unramified k C P' I.subscheme sP' g I.subschemeι hgP hP' hss hι hred hset
  haveI hgprop : IsProper g := hss.2.1
  have hH : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
      (τ : Spec (.of K) ⟶ Limits.pullback g s), τ ≫ Limits.pullback.snd g s = 𝟙 _ →
      Limits.pullback.fst g s (τ (IsLocalRing.closedPoint K)) ∈ Set.range I.subschemeι →
      wcpaLqRatNode K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))
        (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
          (τ (IsLocalRing.closedPoint K))) := by
    intro K _ s τ hτs hmem
    exact wcpa_dj_lq_rational_node k C P' sP' g hgP hP' hss K s τ hτs ((hset _).mp hmem)
  obtain ⟨D, hD⟩ := wcpa_dj_lq_conic_charts k C P' I.subscheme sP' g I.subschemeι hgP hP' hι hred
    hgprop hH
  refine ⟨I.subscheme, I.subschemeι, hι, hunr, hset, D, ?_⟩
  intro K _ s τ σ hτs hτf i hi
  have hmem : Limits.pullback.fst g s (τ (IsLocalRing.closedPoint K)) ∈
      Set.range I.subschemeι := by
    refine ⟨σ (IsLocalRing.closedPoint K), ?_⟩
    first
      | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hτf])
      | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hτf]; rfl)
      | exact (congrArg (fun φ => φ (IsLocalRing.closedPoint K)) hτf).symm
      | simp only [← Scheme.Hom.comp_apply, hτf]
  obtain ⟨hHilb, _⟩ := hH K s τ hτs hmem
  obtain ⟨u, v, hbas, hrel⟩ := hD K s τ σ hτs hτf i hi
  have hne : wcpaBscEval K σ (D.V i) hi (D.a i) ≠ 0 ∨ wcpaBscEval K σ (D.V i) hi (D.b i) ≠ 0 ∨
      wcpaBscEval K σ (D.V i) hi (D.c i) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨ha, hb, hc⟩ := hcon
    have h := (D.disc i).map (wcpaBscEval K σ (D.V i) hi)
    simp only [map_sub, map_mul, map_pow, map_ofNat] at h
    have h2 := h.ne_zero
    rw [ha, hb, hc] at h2
    simp at h2
  haveI : IsLocallyNoetherian (Limits.pullback g s) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g s)
  exact wcpa_dj_lq_completion_presentation K _ _ hHilb u v hbas _ _ _ hne hrel

theorem wcpa_dj_bsc_chart_props : ∀ (R : Type u) [CommRing R] (a b c : R), IsUnit (b ^ 2 - 4 * a * c) → IsFinite (Spec.map (CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c))))) ∧ FormallyUnramified (Spec.map (CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c))))) ∧ Surjective (Spec.map (CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c))))) :=
by
  intro R _ a b c hdisc
  set p : Polynomial R := Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c)
    with hp
  have hp' : p = Polynomial.X ^ 2 + Polynomial.C (-b) * Polynomial.X + Polynomial.C (a * c) := by
    rw [hp, Polynomial.C_neg]; ring
  have hmonic : p.Monic := by
    rcases subsingleton_or_nontrivial R with h | h
    · exact Polynomial.monic_of_subsingleton _
    · rw [hp']
      exact (Polynomial.isMonicOfDegree_add_add_two (-b) (a * c)).monic
  have hfin : Module.Finite R (AdjoinRoot p) := hmonic.finite_adjoinRoot
  have hφ : (CommRingCat.ofHom (AdjoinRoot.of p)).hom = algebraMap R (AdjoinRoot p) := by
    rw [CommRingCat.hom_ofHom, AdjoinRoot.algebraMap_eq]
  have hφfin : (algebraMap R (AdjoinRoot p)).Finite := RingHom.finite_algebraMap.mpr hfin

  have hunr : Algebra.FormallyUnramified R (AdjoinRoot p) := by
    have key1 : ∀ x : AdjoinRoot p, Polynomial.aeval x
        (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c)) =
        x ^ 2 - algebraMap R (AdjoinRoot p) b * x +
          algebraMap R (AdjoinRoot p) a * algebraMap R (AdjoinRoot p) c := by
      intro x
      simp only [map_add, map_sub, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    have key2 : ∀ x : AdjoinRoot p, Polynomial.aeval x (Polynomial.derivative
        (Polynomial.X ^ 2 - Polynomial.C b * Polynomial.X + Polynomial.C (a * c))) =
        2 * x - algebraMap R (AdjoinRoot p) b := by
      intro x
      simp
      ring
    have hr : Polynomial.aeval (AdjoinRoot.root p) p = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    have hE : AdjoinRoot.root p ^ 2 - algebraMap R (AdjoinRoot p) b * AdjoinRoot.root p +
        algebraMap R (AdjoinRoot p) a * algebraMap R (AdjoinRoot p) c = 0 := by
      rw [← key1 (AdjoinRoot.root p)]
      exact hr
    have hd : Polynomial.aeval (AdjoinRoot.root p) (Polynomial.derivative p) =
        2 * AdjoinRoot.root p - algebraMap R (AdjoinRoot p) b := key2 (AdjoinRoot.root p)
    have hsq : (2 * AdjoinRoot.root p - algebraMap R (AdjoinRoot p) b) *
        (2 * AdjoinRoot.root p - algebraMap R (AdjoinRoot p) b)
        = algebraMap R (AdjoinRoot p) (b ^ 2 - 4 * a * c) := by
      rw [map_sub, map_mul, map_mul, map_pow, map_ofNat]
      linear_combination 4 * hE
    have hu : IsUnit (2 * AdjoinRoot.root p - algebraMap R (AdjoinRoot p) b) :=
      isUnit_of_mul_isUnit_left (hsq ▸ hdisc.map (algebraMap R (AdjoinRoot p)))
    have hDr : KaehlerDifferential.D R (AdjoinRoot p) (AdjoinRoot.root p) = 0 := by
      have h := Derivation.map_aeval (KaehlerDifferential.D R (AdjoinRoot p)) p (AdjoinRoot.root p)
      rw [hr, map_zero, hd] at h
      exact hu.smul_eq_zero.mp h.symm
    have hD : ∀ x : AdjoinRoot p, KaehlerDifferential.D R (AdjoinRoot p) x = 0 := by
      intro x
      obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective x
      rw [← AdjoinRoot.aeval_eq, Derivation.map_aeval, hDr, smul_zero]
    constructor
    have hspan := KaehlerDifferential.span_range_derivation R (AdjoinRoot p)
    have hbot : Submodule.span (AdjoinRoot p)
        (Set.range (KaehlerDifferential.D R (AdjoinRoot p))) = ⊥ := by
      rw [Submodule.span_eq_bot]
      rintro _ ⟨x, rfl⟩
      exact hD x
    refine subsingleton_of_forall_eq 0 (fun ω => ?_)
    have hω : ω ∈ Submodule.span (AdjoinRoot p)
        (Set.range (KaehlerDifferential.D R (AdjoinRoot p))) := by
      rw [hspan]; exact Submodule.mem_top
    rw [hbot] at hω
    exact (Submodule.mem_bot (AdjoinRoot p)).mp hω

  have hinj : Function.Injective (algebraMap R (AdjoinRoot p)) := by
    rcases subsingleton_or_nontrivial R with h | h
    · exact Function.injective_of_subsingleton _
    · have hdeg : p.natDegree = 2 := by
        rw [hp']
        exact (Polynomial.isMonicOfDegree_add_add_two (-b) (a * c)).natDegree_eq
      rw [injective_iff_map_eq_zero]
      intro s hs
      rw [AdjoinRoot.algebraMap_eq, ← AdjoinRoot.mk_C, AdjoinRoot.mk_eq_zero] at hs
      by_contra hs0
      have hC : Polynomial.C s ≠ 0 := by
        rw [Ne, Polynomial.C_eq_zero]; exact hs0
      exact hmonic.not_dvd_of_natDegree_lt hC (by rw [Polynomial.natDegree_C, hdeg]; norm_num) hs
  have hint : (algebraMap R (AdjoinRoot p)).IsIntegral := hφfin.to_isIntegral
  refine ⟨?_, ?_, ?_⟩
  · rw [IsFinite.SpecMap_iff, hφ]
    exact hφfin
  · rw [HasRingHomProperty.Spec_iff (P := @FormallyUnramified), hφ]
    exact RingHom.formallyUnramified_algebraMap.mpr hunr
  · constructor
    intro x
    obtain ⟨y, hy⟩ := RingHom.IsIntegral.comap_surjective hint hinj x
    refine ⟨y, ?_⟩
    have h1 := Spec.map_apply (CommRingCat.ofHom (AdjoinRoot.of p)) y
    rw [hφ] at h1
    exact h1.trans hy

theorem wcpa_dj_bsc_transitions : ∀ (S : Scheme.{u}) (D : wcpaBscChartData S), ∃ τ : ∀ i j, ((wcpaBscChartMap D i ⁻¹ᵁ D.V j : (wcpaBscChart D i).Opens) : Scheme.{u}) ⟶ wcpaBscChart D j, (∀ i j, τ i j ≫ wcpaBscChartMap D j = (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) ∧ (∀ i (T : Scheme.{u}) (h : T ⟶ ((wcpaBscChartMap D i ⁻¹ᵁ D.V i : (wcpaBscChart D i).Opens) : Scheme.{u})), h ≫ τ i i = h ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V i).ι) ∧ (∀ i j k (T : Scheme.{u}) (h₁ : T ⟶ ((wcpaBscChartMap D i ⁻¹ᵁ D.V j : (wcpaBscChart D i).Opens) : Scheme.{u})) (h₂ : T ⟶ ((wcpaBscChartMap D j ⁻¹ᵁ D.V k : (wcpaBscChart D j).Opens) : Scheme.{u})) (h₃ : T ⟶ ((wcpaBscChartMap D i ⁻¹ᵁ D.V k : (wcpaBscChart D i).Opens) : Scheme.{u})), h₂ ≫ (wcpaBscChartMap D j ⁻¹ᵁ D.V k).ι = h₁ ≫ τ i j → h₃ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V k).ι = h₁ ≫ (wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι → h₂ ≫ τ j k = h₃ ≫ τ i k) :=
by
  intro S D
  have Fcomp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (k : X ⟶ Z), k = f ≫ g →
      ∀ (U : Z.Opens) (h : ⊤ ≤ g ⁻¹ᵁ U) (h' : ⊤ ≤ k ⁻¹ᵁ U),
      k.appLE U ⊤ h' = g.appLE U ⊤ h ≫ f.appTop := by
    intro X Y Z f g k hk U h h'
    subst hk
    have e : f.appLE ⊤ ⊤ (fun _ _ => trivial) = f.appTop := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    rw [← e]
    exact (Scheme.Hom.appLE_comp_appLE f g U ⊤ ⊤ h _).symm
  have Fcongr : ∀ {Y : Scheme.{u}} (f g : Y ⟶ S), f = g → ∀ (W : S.Opens) (h : ⊤ ≤ f ⁻¹ᵁ W)
      (h' : ⊤ ≤ g ⁻¹ᵁ W), f.appLE W ⊤ h = g.appLE W ⊤ h' := by
    rintro Y f g rfl W h h'
    rfl
  have Fres : ∀ {Y : Scheme.{u}} (σ : Y ⟶ S) (W W' : S.Opens) (hle : W ≤ W') (h : ⊤ ≤ σ ⁻¹ᵁ W)
      (h' : ⊤ ≤ σ ⁻¹ᵁ W') (x : Γ(S, W')),
      (σ.appLE W ⊤ h).hom (wcpaBscRes S hle x) = (σ.appLE W' ⊤ h').hom x := by
    intro Y σ W W' hle h h' x
    rw [← Scheme.Hom.map_appLE σ h (homOfLE hle).op]
    rfl
  have FS : ∀ i (h : ⊤ ≤ (D.affine i).fromSpec ⁻¹ᵁ D.V i),
      (D.affine i).fromSpec.appLE (D.V i) ⊤ h = (Scheme.ΓSpecIso Γ(S, D.V i)).inv := by
    intro i h
    simp [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, ← Functor.map_comp]
  have Fspec : ∀ {Y : Scheme.{u}} {R T : CommRingCat.{u}} (φ : R ⟶ T) (f : Y ⟶ Spec T),
      (Scheme.ΓSpecIso R).inv ≫ (f ≫ Spec.map φ).appTop =
        φ ≫ (Scheme.ΓSpecIso T).inv ≫ f.appTop := by
    intro Y R T φ f
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have Fext : ∀ {Y : Scheme.{u}} {R : CommRingCat.{u}} (f g : Y ⟶ Spec R),
      (Scheme.ΓSpecIso R).inv ≫ f.appTop = (Scheme.ΓSpecIso R).inv ≫ g.appTop → f = g := by
    intro Y R f g h
    exact ext_of_isAffine ((cancel_epi _).1 h)
  have Fmk : ∀ {Y : Scheme.{u}} {R : CommRingCat.{u}} (φ : R ⟶ Γ(Y, ⊤)),
      (Scheme.ΓSpecIso R).inv ≫ (Y.toSpecΓ ≫ Spec.map φ).appTop = φ := by
    intro Y R φ
    rw [Fspec, Scheme.toSpecΓ_appTop, Iso.inv_hom_id, Category.comp_id]
  have hq : ∀ i (x : wcpaBscChart D i), wcpaBscChartMap D i x ∈ D.V i := by
    intro i x
    show wcpaBscChartMap D i x ∈ (D.V i : Set S)
    rw [← (D.affine i).range_fromSpec]
    first
      | exact ⟨(Spec.map (CommRingCat.ofHom (AdjoinRoot.of (wcpaBscPoly D i)))) x, rfl⟩
      | exact ⟨_, (Scheme.Hom.comp_apply _ _ x).symm⟩
  have memσ : ∀ i j (y : ((wcpaBscChartMap D i ⁻¹ᵁ D.V j : (wcpaBscChart D i).Opens) : Scheme.{u})),
      ((wcpaBscChartMap D i ⁻¹ᵁ D.V j).ι ≫ wcpaBscChartMap D i) y ∈ D.V i ⊓ D.V j := by
    intro i j y
    rw [Scheme.Hom.comp_apply]
    refine ⟨hq i _, ?_⟩
