    rcases (isPreirreducible_iff_isClosed_union_isClosed.mp
        isIrreducible_singleton.closure.isPreirreducible) X (closure Xᶜ) hXcl isClosed_closure hcov with h | h
    · exact Maximal.eq_of_subset hcomp (Maximal.prop hX) h
    · exact absurd (h (specializes_iff_mem_closure.mp hx₁x)) hxc

  have hx₁₀ : x₁ = x₀ := (inseparable_iff_closure_eq.mpr (hC.trans hx₀.symm)).eq
  rw [← hx₁₀]
  exact hx₁.symm

theorem nccwst_generic_residue_iso : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ ξ : Z', u' ξ = IsLocalRing.closedPoint R → (∀ x' : Z', u' x' = IsLocalRing.closedPoint R → x' ⤳ ξ → x' = ξ) → ∀ (Er : Scheme.{u}) (ιE : Er ⟶ N), IsClosedImmersion ιE → Set.range ⇑ιE = closure {η ξ} → ∃ ε₀ : Er, ιE ε₀ = η ξ ∧ IsIso ((ιE ≫ q' ≫ ν').residueFieldMap ε₀) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA ξ hξ hmax Er ιE hιE hrng
  classical
  obtain ⟨_hcomp, halg, _hPr, hH, hS⟩ := hA
  obtain ⟨_, _, hst', -⟩ := hH
  obtain ⟨-, -, -, -, -, -, -, hQ8, -, -, -, -, hQ13⟩ := hS
  obtain ⟨-, hνq, -, -, -, ⟨W, hW, hWiso⟩, -, -⟩ := hQ8 ξ hξ hmax
  have hmemcl : η ξ ∈ Set.range ⇑ιE := by
    rw [hrng]; exact subset_closure (Set.mem_singleton _)
  obtain ⟨ε₀, hε₀⟩ := hmemcl

  have s1 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (x : X),
      Function.Surjective (f.stalkMap x).hom → IsIso (f.residueFieldMap x) := by
    intro X Y f x hs
    have hsq := Scheme.residue_residueFieldMap f x
    have hfun : ∀ s, (f.residueFieldMap x).hom ((Y.residue (f x)).hom s) =
        (X.residue x).hom ((f.stalkMap x).hom s) := by
      intro s
      have := congrArg (fun g => g.hom s) hsq
      simpa using this
    have hsurj : Function.Surjective (f.residueFieldMap x).hom := by
      intro t
      obtain ⟨s0, hs0⟩ := Scheme.residue_surjective X x t
      obtain ⟨s, rfl⟩ := hs s0
      exact ⟨_, (hfun s).trans hs0⟩
    have hinj : Function.Injective (f.residueFieldMap x).hom := RingHom.injective _
    exact (ConcreteCategory.isIso_iff_bijective _).mpr ⟨hinj, hsurj⟩

  have s2 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (W : Y.Opens), IsIso (f ∣_ W) →
      ∀ x : X, f x ∈ W → IsIso (f.stalkMap x) := by
    intro X Y f W hW x hx
    haveI := hW
    have hx' : x ∈ Set.range (f ⁻¹ᵁ W).ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    obtain ⟨y, rfl⟩ := hx'
    haveI : IsOpenImmersion ((f ⁻¹ᵁ W).ι ≫ f) := by
      rw [← morphismRestrict_ι]; infer_instance
    have h1 : IsIso (((f ⁻¹ᵁ W).ι ≫ f).stalkMap y) := inferInstance
    rw [Scheme.Hom.stalkMap_comp] at h1
    exact @IsIso.of_isIso_comp_right _ _ _ _ _ (f.stalkMap ((f ⁻¹ᵁ W).ι y))
      ((f ⁻¹ᵁ W).ι.stalkMap y) inferInstance h1
  have hsurjE : Function.Surjective (ιE.stalkMap ε₀).hom := ιE.stalkMap_surjective ε₀
  have hq : ∀ y : N, y = η ξ → Function.Surjective (q'.stalkMap y).hom := by
    rintro y rfl
    haveI := s2 N S' q' W hWiso (η ξ) hW
    exact (ConcreteCategory.bijective_of_isIso (q'.stalkMap (η ξ))).2
  obtain ⟨hdom, hic, -⟩ := wcpa_dj_nccw_max_point_dvr R halg Z' u' hst'.1 ξ ⟨hξ, hmax⟩
  obtain ⟨w, hw, hwiso⟩ := hQ13.1 ξ hdom hic
  have hν : ∀ y : S', y = w → Function.Surjective (ν'.stalkMap y).hom := by
    rintro y rfl
    haveI := hwiso
    exact (ConcreteCategory.bijective_of_isIso (ν'.stalkMap y)).2
  have hcomp' : Function.Surjective ((ιE ≫ q' ≫ ν').stalkMap ε₀).hom := by
    rw [Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp]
    simp only [CommRingCat.hom_comp, RingHom.coe_comp]
    exact (hsurjE.comp (hq _ hε₀)).comp (hν _ (by rw [hε₀]; exact (hw _).mp hνq))
  exact ⟨ε₀, hε₀, s1 _ _ _ ε₀ hcomp'⟩

theorem nccwst_lift_stalk_factor : ∀ (E Z : Scheme.{u}) (φ : E ⟶ Z) (z : Z) (A : Type u) [CommRing A] [IsLocalRing A] (ψ : Z.presheaf.stalk z →+* A), IsLocalHom ψ → ∀ (ℓ : Spec (.of A) ⟶ E), ℓ ≫ φ = Spec.map (CommRingCat.ofHom ψ) ≫ Z.fromSpecStalk z → ∀ e : E, ℓ (IsLocalRing.closedPoint A) = e → ∃ (hφe : φ e = z) (lam : E.presheaf.stalk e →+* A), ∀ m : Z.presheaf.stalk z, lam ((φ.stalkMap e).hom ((Z.presheaf.stalkCongr (Inseparable.of_eq hφe.symm)).hom m)) = ψ m :=
by
  intro E Z φ z A _ _ ψ hψ ℓ hℓ e he
  subst he
  have hψ' : IsLocalHom (CommRingCat.ofHom ψ).hom := hψ
  have hEq : SpecToEquivOfLocalRing Z (.of A) (ℓ ≫ φ) = ⟨z, ⟨CommRingCat.ofHom ψ, hψ'⟩⟩ := by
    have := (SpecToEquivOfLocalRing Z (.of A)).apply_symm_apply ⟨z, ⟨CommRingCat.ofHom ψ, hψ'⟩⟩
    rw [SpecToEquivOfLocalRing_symm_apply] at this
    rw [hℓ]
    exact this
  obtain ⟨h₁, h₂⟩ := (SpecToEquivOfLocalRing_eq_iff).mp hEq
  change φ (ℓ (IsLocalRing.closedPoint A)) = z at h₁
  change Scheme.stalkClosedPointTo (ℓ ≫ φ) = _ ≫ CommRingCat.ofHom ψ at h₂
  rw [Scheme.stalkClosedPointTo_comp] at h₂
  subst h₁
  refine ⟨rfl, (Scheme.stalkClosedPointTo ℓ).hom, fun m => ?_⟩
  have h3 := congrArg (fun g => g.hom m) h₂
  simp only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl] at h3 ⊢
  erw [TopCat.Presheaf.stalkSpecializes_refl] at h3
  exact h3

