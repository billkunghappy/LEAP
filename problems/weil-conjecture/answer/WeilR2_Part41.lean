      have hab' : φ p * algebraMap (Y.presheaf.stalk w) Y.functionField (b : Y.presheaf.stalk w) =
          algebraMap (Y.presheaf.stalk w) Y.functionField a := hab
      have ha0 : a ≠ 0 := by
        intro ha
        rw [ha, map_zero] at hab'
        have hb' : algebraMap (Y.presheaf.stalk w) Y.functionField (b : Y.presheaf.stalk w) ≠ 0 :=
