        ∃ u v : Y.presheaf.stalk (τ j p₀), ¬ π ∣ u ∧ ¬ π ∣ v ∧ u * num = v * den := by
      intro π hπ hπz hπs
      obtain ⟨w, hw, hw1, -, -, hw4, -⟩ := wcpa_dj_stc_kms_prime_generization Y _ π hπ
      have hwBd : w ∉ (⇑g ⁻¹' (⋃ i, Dc i) ∪ ⋃ j, Set.range ⇑(τ j)) := by
        intro hmem
        rcases hmem with hgw | hτw
        · obtain ⟨l, hl, hm⟩ := ((hDY w hw).1).mp hgw
          exact hπs l hl (hπ.associated_of_dvd (hs l) ((hw1 _).mp hm))
        · exact hπz (hπ.associated_of_dvd hz ((hw1 z).mp (((hDY w hw).2).mp hτw)))
      obtain ⟨hwO, hwI⟩ := hoff w hwBd
      obtain ⟨hwV, hwunit⟩ := wcpa_dj_stc_kms_ratio_unit k O a i₀ i w hwO (hwI i₀ hi₀) (hwI i hi)
      exact hw4 num den _ (hlink.2 w hwV hw) hwunit
    obtain ⟨α, β, hβsupp, ⟨e₁, e₂, u₁, u₂, hn1, hd1, hu1, hu2, hα⟩, hβmult, hmon⟩ :=
      wcpa_dj_stc_kms_ufd_monomial _ n (fun l => (g.stalkMap (τ j p₀)).hom (t l)) J z num den
        hnum0 hden0 hz (fun l _ => hs l) (fun l _ => hzs l) (fun l _ l' _ hne => hss' l l' hne)
        hcop
    have hfeq : f (i₀, i) =
        (Y.presheaf.germ _ (genericPoint Y) hηV).hom (wcpaDjStcRatioSec k O a i₀ i) :=
      dif_pos hηV
    have hbound : ∀ (π v₁ v₂ : Y.presheaf.stalk (τ j p₀)) (d₁ d₂ : ℕ), Prime π →
        (∀ (w : Y) (h : w ⤳ τ j p₀), (Y.presheaf.stalkSpecializes h).hom π ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk w) →
          w ∈ (⇑g ⁻¹' (⋃ i, Dc i) ∪ ⋃ j, Set.range ⇑(τ j))) →
        num = π ^ d₁ * v₁ → den = π ^ d₂ * v₂ → ¬ π ∣ v₁ → ¬ π ∣ v₂ →
        |((d₁ : ℤ) - d₂)| ≤ (B : ℤ) := by
      intro π v₁ v₂ d₁ d₂ hπ hπBd hn1 hd1 hv1 hv2
      obtain ⟨w, hw, hw1, hw2, hw3, -, hw5⟩ := wcpa_dj_stc_kms_prime_generization Y _ π hπ
      have hwBd := hπBd w hw ((hw1 π).mpr dvd_rfl)
      have hfη : f (i₀, i) *
          (Y.presheaf.stalkSpecializes (genericPoint_specializes (τ j p₀))).hom den =
          (Y.presheaf.stalkSpecializes (genericPoint_specializes (τ j p₀))).hom num := by
        rw [hfeq]
