theorem wcpa_dj_lc_generic_fibre_open : ∀ (S P : Scheme.{u}) [AlgebraicGeometry.IsIntegral S]
    [AlgebraicGeometry.IsIntegral P] (β : S ⟶ P), IsProper β → Surjective β →
    (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) → ∀ W : S.Opens, W ≠ ⊥ → ∀ U : P.Opens, U ≠ ⊥ →
    ∃ U₀ : P.Opens, U₀ ≠ ⊥ ∧ U₀ ≤ U ∧ β ⁻¹ᵁ U₀ ≤ W ∧ IsFinite (β ∣_ U₀) :=
by
  intro S P _ _ β hβp hβs ⟨V, hV, hVfin⟩ W hW U hU
  have := hβp
  have := hβs

  have s1 : ∀ U₀ : P.Opens, U₀ ≤ V → IsFinite (β ∣_ U₀) := by
    intro U₀ h
    have hle' : β ⁻¹ᵁ U₀ ≤ β ⁻¹ᵁ V := fun x hx => h hx
    have hcomm : S.homOfLE hle' ≫ (β ∣_ V) = (β ∣_ U₀) ≫ P.homOfLE h := by
      rw [← cancel_mono V.ι]
      simp only [Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι_assoc, Scheme.homOfLE_ι]
    have h1 : IsPullback (S.homOfLE hle' ≫ (β ⁻¹ᵁ V).ι) (β ∣_ U₀) β (P.homOfLE h ≫ V.ι) := by
      rw [Scheme.homOfLE_ι, Scheme.homOfLE_ι]
      exact (isPullback_morphismRestrict β U₀).flip
    have h2 : IsPullback (S.homOfLE hle') (β ∣_ U₀) (β ∣_ V) (P.homOfLE h) :=
      IsPullback.of_right h1 hcomm (isPullback_morphismRestrict β V).flip
    exact MorphismProperty.of_isPullback (P := @IsFinite) h2 hVfin

  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsFinite f] (x x' : X), x ⤳ x' → f x = f x' →
      x = x' := by
    intro X Y f _ x x' hxx' hf
    have : DiscreteTopology ↑(⇑f ⁻¹' {f x}) := (f.fiberHomeo (f x)).discreteTopology
    have a : (⟨x, rfl⟩ : ↑(⇑f ⁻¹' {f x})) ⤳ ⟨x', hf.symm⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp hxx'
    exact congrArg Subtype.val a.eq

  have hgen : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (O : X.Opens), O ≠ ⊥ →
      genericPoint X ∈ O := by
    intro X _ O hO
    have hne := (TopologicalSpace.Opens.ne_bot_iff_nonempty O).mp hO
    exact ((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr (by simpa using hne)

  have hβη : β (genericPoint S) = genericPoint P := by
    obtain ⟨t, ht⟩ := β.surjective (genericPoint P)
    have h1 : β (genericPoint S) ⤳ genericPoint P := by
      rw [← ht]; exact (genericPoint_specializes t).map β.continuous
    exact (h1.antisymm (genericPoint_specializes _)).eq
  have hηV := hgen P V hV

  have key : ∀ s : S, s ∉ W → β s ≠ genericPoint P := by
    intro s hs hβs'
    have hsV : s ∈ β ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hβs']; exact hηV
    have heV : genericPoint S ∈ β ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hβη]; exact hηV
    have hsR : s ∈ Set.range (β ⁻¹ᵁ V).ι := by rw [Scheme.Opens.range_ι]; exact hsV
    have heR : genericPoint S ∈ Set.range (β ⁻¹ᵁ V).ι := by rw [Scheme.Opens.range_ι]; exact heV
    obtain ⟨a, ha⟩ := heR
    obtain ⟨b, hb⟩ := hsR
    have hind := (β ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing
    have e1 : a ⤳ b := by
      rw [← hind.specializes_iff, ha, hb]
      exact genericPoint_specializes s
    have hcomp : ∀ y, V.ι ((β ∣_ V) y) = β ((β ⁻¹ᵁ V).ι y) := by
      intro y
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    have e2 : (β ∣_ V) a = (β ∣_ V) b := by
      apply V.ι.isOpenEmbedding.injective
      rw [hcomp, hcomp, ha, hb, hβη, hβs']
    have h3 := s2 (β ∣_ V) a b e1 e2
    have h4 : genericPoint S = s := by rw [← ha, ← hb, h3]
    exact hs (h4 ▸ hgen S W hW)

  have hZ : IsClosed (⇑β '' (W : Set S)ᶜ) := β.isClosedMap _ (isClosed_compl_iff.mpr W.isOpen)
  let O : P.Opens := ⟨(⇑β '' (W : Set S)ᶜ)ᶜ, hZ.isOpen_compl⟩
  refine ⟨U ⊓ V ⊓ O, ?_, inf_le_left.trans inf_le_left, ?_, s1 _ (inf_le_left.trans inf_le_right)⟩
  · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨genericPoint P, ⟨⟨hgen P U hU, hηV⟩, ?_⟩⟩
    rintro ⟨s, hs, hseq⟩
    exact key s hs hseq
  · intro x hx
    by_contra hxW
    exact hx.2 ⟨x, hxW, rfl⟩

theorem wcpa_dj_mm_level_classifying : ∀ (k : Type u) [Field k] [Finite k] (X P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    (f : X ⟶ P) (U : P.Opens) (n : ℕ) (σ : Fin n → (P ⟶ X)), wcpaDjSmIn k sP f U σ →
    ∃ (M Z : Scheme.{u}) (sM : M ⟶ Spec (.of k)) (u : Z ⟶ M) (τ : Fin n → (M ⟶ Z))
      (U₀ : P.Opens) (U₁ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral U₁)
      (e : U₁ ⟶ U₀.toScheme) (φ : U₁ ⟶ M) (Y₁ : Scheme.{u}) (π₁ : Y₁ ⟶ U₁) (χ : Y₁ ⟶ X)
      (ψ : Y₁ ⟶ Z) (s : Fin n → (U₁ ⟶ Y₁)),
      wcpaDjIsProjOver k sM ∧ wcpaDjIsProjOver k (u ≫ sM) ∧ wcpaDjSemistable u ∧
      wcpaDjSections u n τ ∧ U₀ ≠ ⊥ ∧ U₀ ≤ U ∧ IsFinite e ∧ Surjective e ∧
