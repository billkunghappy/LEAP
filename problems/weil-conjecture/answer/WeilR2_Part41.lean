    obtain ⟨Ch, hCh⟩ : ∃ X : Matrix (Fin (r + 1)) (Fin (r + 1)) B, X = Matrix.of fun l => Fin.snoc (α := fun _ => B) (C l) 0 := ⟨_, rfl⟩
