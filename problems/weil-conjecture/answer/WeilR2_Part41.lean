  have transport : ∀ (σ' : Spec (.of K) ⟶ S), σ' = σ →
      ∃ e : Limits.pullback (Limits.pullback.snd g (ι ≫ g)) σ' ≅ Limits.pullback g s,
        e.hom ≫ Limits.pullback.snd g s = Limits.pullback.snd (Limits.pullback.snd g (ι ≫ g)) σ' ∧
