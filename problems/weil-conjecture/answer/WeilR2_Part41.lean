    exact IsPullback.of_right h1 hκ2 hψ
  have hPB : IsPullback (κ ≫ χw) (u ∣_ U₁) f (e ≫ U₀.ι) := by
    have h1 := hκ.paste_horiz hχ
    rw [heι, ← hι₁, Category.assoc]
