    have hmem : ∀ z : (W : Scheme.{u}), W.ι z ∈ W := by
      intro z
      have : W.ι z ∈ Set.range W.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have hr : Set.range ⇑(W.ι ≫ Φ) ⊆ Set.range ⇑W.ι := by
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
      exact hW (hmem z)
    have hψ : IsOpenImmersion.lift W.ι (W.ι ≫ Φ) hr ≫ W.ι = W.ι ≫ Φ := IsOpenImmersion.lift_fac _ _ _
    set ψ := IsOpenImmersion.lift W.ι (W.ι ≫ Φ) hr
    haveI : IsAffine W := hWa
    have hcongr : ∀ (f g : (W : Scheme.{u}) ⟶ X) (_ : f = g) (e : (⊤ : (W : Scheme.{u}).Opens) ≤ f ⁻¹ᵁ W) (e' : (⊤ : (W : Scheme.{u}).Opens) ≤ g ⁻¹ᵁ W), f.appLE W ⊤ e = g.appLE W ⊤ e' := by
      rintro f g rfl e e'; rfl
    have hΦid : Φ.appLE W W hW = 𝟙 _ := by
      ext y; exact hid y
    have e0 : (⊤ : (W : Scheme.{u}).Opens) ≤ W.ι ⁻¹ᵁ W := fun z _ => hmem z
    have e2 : (⊤ : (W : Scheme.{u}).Opens) ≤ ψ ⁻¹ᵁ (⊤ : (W : Scheme.{u}).Opens) := fun _ _ => trivial
    have h1 : W.ι.appLE W ⊤ e0 ≫ ψ.appLE ⊤ ⊤ e2 = W.ι.appLE W ⊤ e0 := by
      rw [Scheme.Hom.appLE_comp_appLE]
      rw [hcongr _ _ hψ _ (fun z hz => hW (e0 hz))]
      have hc : Φ.appLE W W hW ≫ W.ι.appLE W ⊤ e0 = (W.ι ≫ Φ).appLE W ⊤ (fun z hz => hW (e0 hz)) :=
        Scheme.Hom.appLE_comp_appLE W.ι Φ W W ⊤ hW e0
      rw [← hc, hΦid, Category.id_comp]
    have h2 : IsIso (W.ι.appLE W ⊤ e0) := by
      rw [Scheme.Opens.ι_appLE]
      apply hiso
      intro z hz
      rw [Scheme.Opens.ι_image_top]
      exact hz
    have h3 : ψ.appTop = 𝟙 _ := by
      have h4 : ψ.appTop = ψ.appLE ⊤ ⊤ e2 := by
        rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]; rfl
      rw [h4]
      exact (cancel_epi (W.ι.appLE W ⊤ e0)).mp (h1.trans (Category.comp_id _).symm)
    have : ψ = 𝟙 _ := by
      apply ext_of_isAffine
      rw [h3, Scheme.Hom.id_appTop]
    rw [← hψ, this, Category.id_comp, Category.comp_id]
  intro k _ C c n τ hτ hder A _ _ _ s CA pA qA hpbA Ψ hΨq hmark hfib
  have hse : Spec.map (CommRingCat.ofHom s.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k A)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : s.toRingHom.comp (algebraMap k A) = RingHom.id k := by
      ext a; simp
    rw [this, CommRingCat.ofHom_id, Spec.map_id]
  obtain ⟨ι₀, hι₀p, hι₀q⟩ : ∃ ι₀ : C ⟶ CA, ι₀ ≫ pA = 𝟙 C ∧
      ι₀ ≫ qA = c ≫ Spec.map (CommRingCat.ofHom s.toRingHom) :=
    ⟨hpbA.lift (𝟙 C) (c ≫ Spec.map (CommRingCat.ofHom s.toRingHom))
      (by rw [Category.id_comp, Category.assoc, hse, Category.comp_id]),
      hpbA.lift_fst _ _ _, hpbA.lift_snd _ _ _⟩
  have hι₀Ψ := hfib ι₀ hι₀p hι₀q
  intro m
  induction m with
  | zero =>
    intro Cm ιm qm hpb
    haveI hsub : Subsingleton (A ⧸ RingHom.ker s.toRingHom ^ 0) :=
      Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
    haveI : IsEmpty Cm := ⟨fun x => by
      have h1 := (qm x).isPrime.ne_top
      apply h1
      rw [Ideal.eq_top_iff_one, Subsingleton.elim (1 : A ⧸ RingHom.ker s.toRingHom ^ 0) 0]
      exact Ideal.zero_mem _⟩
    exact Scheme.hom_ext_of_forall _ _ (fun x => isEmptyElim x)
  | succ m ih =>
    intro Cm ι q hpb
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · have key : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ (0 + 1)))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ Spec.map (CommRingCat.ofHom s.toRingHom) =
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ (0 + 1)))) := by
        rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext a
        simp only [RingHom.coe_comp, Function.comp_apply]
        apply Ideal.Quotient.eq.mpr
        rw [zero_add, pow_one, RingHom.mem_ker]
        simp
      have hι : ι = (ι ≫ pA) ≫ ι₀ := by
        apply hpbA.hom_ext
        · rw [Category.assoc, hι₀p, Category.comp_id]
        · simp only [Category.assoc]
          rw [hι₀q, reassoc_of% hpbA.w, reassoc_of% hpb.w, key, hpb.w]
      rw [hι, Category.assoc, hι₀Ψ]
    · obtain ⟨g, hg⟩ : ∃ g : (A ⧸ RingHom.ker s.toRingHom ^ (m + 1)) →ₐ[k] (A ⧸ RingHom.ker s.toRingHom ^ m),
          ∀ a, g (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ a :=
        ⟨Ideal.Quotient.factorₐ k (Ideal.pow_le_pow_right (Nat.le_succ m)), fun a => rfl⟩
      have hgs : Function.Surjective g := by
        intro x
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact ⟨_, hg a⟩
      have hsq : ∀ x y : A ⧸ RingHom.ker s.toRingHom ^ (m + 1), g x = 0 → g y = 0 → x * y = 0 := by
        intro x y hx hy
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [hg, Ideal.Quotient.eq_zero_iff_mem] at hx hy
        rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.pow_le_pow_right (by omega : m + 1 ≤ m + m)
          (by rw [pow_add]; exact Ideal.mul_mem_mul hx hy)
      have E1 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ (m + 1)))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap k A)) =
          Spec.map (CommRingCat.ofHom (algebraMap k (A ⧸ RingHom.ker s.toRingHom ^ (m + 1)))) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have E2 : Spec.map (CommRingCat.ofHom g.toRingHom) ≫
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ (m + 1)))) =
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ m))) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext a
        exact hg a
      have E3 : Spec.map (CommRingCat.ofHom g.toRingHom) ≫
          Spec.map (CommRingCat.ofHom (algebraMap k (A ⧸ RingHom.ker s.toRingHom ^ (m + 1)))) =
          Spec.map (CommRingCat.ofHom (algebraMap k (A ⧸ RingHom.ker s.toRingHom ^ m))) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        exact g.comp_algebraMap
      have hpbB : IsPullback (ι ≫ pA) q c
          (Spec.map (CommRingCat.ofHom (algebraMap k (A ⧸ RingHom.ker s.toRingHom ^ (m + 1))))) := by
        have h := hpb.paste_horiz hpbA
        rwa [E1] at h
      obtain ⟨Cm', i, qm, hpbi⟩ : ∃ (X : Scheme.{u}) (i : X ⟶ Cm)
          (qm : X ⟶ Spec (.of (A ⧸ RingHom.ker s.toRingHom ^ m))),
          IsPullback i qm q (Spec.map (CommRingCat.ofHom g.toRingHom)) :=
        ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
      have hih : (i ≫ ι) ≫ Ψ = i ≫ ι := by
        apply ih
        have h := hpbi.paste_horiz hpb
        rwa [E2] at h
      have hpbB' : IsPullback (i ≫ ι ≫ pA) qm c
          (Spec.map (CommRingCat.ofHom (algebraMap k (A ⧸ RingHom.ker s.toRingHom ^ m)))) := by
        have h := hpbi.paste_horiz hpbB
        rwa [E3] at h
      obtain ⟨Φ, hΦι, hΦq⟩ : ∃ Φ : Cm ⟶ Cm, Φ ≫ ι = ι ≫ Ψ ∧ Φ ≫ q = q :=
        ⟨hpb.lift (ι ≫ Ψ) q (by rw [Category.assoc, hΨq, hpb.w]),
          hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
      have hiΦ : i ≫ Φ = i := by
        apply hpb.hom_ext
        · rw [Category.assoc, hΦι, ← Category.assoc, hih]
        · rw [Category.assoc, hΦq]
      have hΦmark : ∀ (j : Fin n) (t : Spec (.of (A ⧸ RingHom.ker s.toRingHom ^ (m + 1))) ⟶ Cm),
          t ≫ q = 𝟙 _ → t ≫ (ι ≫ pA) =
            Spec.map (CommRingCat.ofHom (algebraMap k (A ⧸ RingHom.ker s.toRingHom ^ (m + 1)))) ≫ τ j →
          t ≫ Φ = t := by
        intro j t ht1 ht2
        obtain ⟨T, hT1, hT2⟩ : ∃ T : Spec (.of A) ⟶ CA,
            T ≫ pA = Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ j ∧ T ≫ qA = 𝟙 _ :=
          ⟨hpbA.lift (Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ j) (𝟙 _)
            (by rw [Category.assoc, hτ j, Category.comp_id, Category.id_comp]),
            hpbA.lift_fst _ _ _, hpbA.lift_snd _ _ _⟩
        have hT := hmark j T hT2 hT1
        have hST : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ (m + 1)))) ≫ T
            = t ≫ ι := by
          apply hpbA.hom_ext
          · simp only [Category.assoc]
            rw [hT1, reassoc_of% E1, ht2]
          · simp only [Category.assoc]
            rw [hT2, Category.comp_id, hpb.w, reassoc_of% ht1]
        apply hpb.hom_ext
        · rw [Category.assoc, hΦι, ← Category.assoc, ← hST, Category.assoc, hT]
        · rw [Category.assoc, hΦq]
      obtain ⟨ι₁, ι₂, b, b', hb₁, hb₂⟩ := wcpa_dj_lqcf_ir_adapted_basis k _ _ g.toLinearMap hgs
      have hb₁' : ∀ α, g (b (Sum.inl α)) = 0 := hb₁
      have hb₂' : ∀ β, g (b (Sum.inr β)) = b' β := hb₂
      have hbb : ∀ α γ, b (Sum.inl α) * b (Sum.inl γ) = 0 := fun α γ => hsq _ _ (hb₁' α) (hb₁' γ)
      have hK1 := wcpa_dj_lqcf_ir_affine_coords k C c _ Cm (ι ≫ pA) q hpbB (ι₁ ⊕ ι₂) b
      have hK1' := wcpa_dj_lqcf_ir_affine_coords k C c _ Cm' (i ≫ ι ≫ pA) qm hpbB' ι₂ b'
      have hpt : ∀ x : Cm, Φ x = x := by
        intro x
        obtain ⟨x', rfl⟩ := wcpa_dj_lqcf_ir_thickening_surj _ _ g.toRingHom hgs
          (fun x hx => ⟨2, by rw [pow_two]; exact hsq x x hx hx⟩) Cm Cm' q i qm hpbi x
        rw [← Scheme.Hom.comp_apply, hiΦ]
      have hK7 := wcpa_dj_lqcf_ir_square_zero_affine k C c n τ hτ hder _ _ g ι₁ ι₂ b b' hb₁' hb₂' hbb
        Cm Cm' (ι ≫ pA) q (i ≫ ι ≫ pA) qm i hpbB rfl hpbi.w
        (fun U hU => (hK1 U hU).2) (fun U hU => (hK1' U hU).2) Φ hΦq hiΦ hpt hΦmark
      have hΦ1 : Φ = 𝟙 Cm := by
        apply wcpa_dj_lqcf_ir_local_id
        intro x
        obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (Scheme.isBasis_affineOpens C)) (show (ι ≫ pA) x ∈ (⊤ : C.Opens) from trivial)
        have hW : (ι ≫ pA) ⁻¹ᵁ U ≤ Φ ⁻¹ᵁ ((ι ≫ pA) ⁻¹ᵁ U) := fun z hz => by
          show Φ z ∈ (ι ≫ pA) ⁻¹ᵁ U
          rw [hpt z]; exact hz
        exact ⟨(ι ≫ pA) ⁻¹ᵁ U, hW, hxU, (hK1 U hU).1, hK7 U hU hW⟩
      rw [← hΦι, hΦ1, Category.id_comp]

theorem wcpa_dj_cdp_cd_valfamily (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F) :
    ∃ w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ,
      (∀ V (f : Fˣ), w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F)) ∧
      wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w ∧
      Function.Injective w ∧ wcRRFinRank K F :=
by
  classical

  have hfd := wcpa_dj_ffv_finite_over_transc K F hF
  obtain ⟨z, hz, hsep, hsep'⟩ := wcpa_dj_ffv_separating K F hF

  have hz' : Transcendental K z⁻¹ := by
    unfold Transcendental at hz ⊢
    exact fun h => hz (IsAlgebraic.inv_iff.mp h)

  haveI := hfd z hz
  haveI := hfd z⁻¹ hz'
  haveI := hsep
  haveI := hsep'

  obtain ⟨A₁, hA₁d, hA₁f, hA₁⟩ := wcpa_dj_ffv_dedekind_subring K F z hz
  obtain ⟨A₂, hA₂d, hA₂f, hA₂⟩ := wcpa_dj_ffv_dedekind_subring K F z⁻¹ hz'
  haveI := hA₁d
  haveI := hA₁f
  haveI := hA₂d
  haveI := hA₂f

  have cover : ∀ V : ValuationSubring F, wcpaDjNtV' K V →
      A₁ ≤ V.toSubring ∨ A₂ ≤ V.toSubring := by
    intro V hV
    rcases V.mem_or_inv_mem z with h | h
    · exact Or.inl (hA₁ V hV.1 h)
    · exact Or.inr (hA₂ V hV.1 h)

  have hv : ∀ V : ValuationSubring F, wcpaDjNtV' K V →
      (∃ π : F, π ≠ 0 ∧ wcpaDjValOrd V π = 1) ∧
      (∀ x y : F, x ≠ 0 → y ≠ 0 →
        wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) ∧
      (∀ x : F, x ≠ 0 → (x ∈ V ↔ 0 ≤ wcpaDjValOrd V x)) ∧
      (∀ x y : F, x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
        min (wcpaDjValOrd V x) (wcpaDjValOrd V y) ≤ wcpaDjValOrd V (x + y)) ∧
      (∀ x : F, x ≠ 0 → (wcpaDjValOrd V x = 0 ↔ (x ∈ V ∧ x⁻¹ ∈ V))) := by
    intro V hV
    rcases cover V hV with h | h
    · haveI := (wcpa_dj_ffv_dedekind_local F A₁ V h hV.2).1
      exact wcpa_dj_ffv_valord_dvr F V
    · haveI := (wcpa_dj_ffv_dedekind_local F A₂ V h hV.2).1
      exact wcpa_dj_ffv_valord_dvr F V

  have hfin : ∀ x : F, x ≠ 0 →
      {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V x ≠ 0}.Finite := by
    intro x hx
    have h1 := wcpa_dj_ffv_dedekind_finite F A₁
      (fun V h h' => (wcpa_dj_ffv_dedekind_local F A₁ V h h').2) x hx
    have h2 := wcpa_dj_ffv_dedekind_finite F A₂
      (fun V h h' => (wcpa_dj_ffv_dedekind_local F A₂ V h h').2) x hx
    refine (h1.union h2).subset ?_
    rintro V ⟨hV, hne⟩
    have hnu : ¬ (x ∈ V ∧ x⁻¹ ∈ V) := fun h => hne (((hv V hV).2.2.2.2 x hx).mpr h)
    rcases cover V hV with h | h
    · exact Or.inl ⟨h, hV.2, hnu⟩
    · exact Or.inr ⟨h, hV.2, hnu⟩

  obtain ⟨w, hw⟩ : ∃ w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ,
      ∀ V (f : Fˣ), w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F) := by
    refine ⟨fun V => AddMonoidHom.mk'
      (fun a => wcpaDjValOrd V.1 ((Additive.toMul a : Fˣ) : F)) ?_, fun V f => rfl⟩
    intro a b
    show wcpaDjValOrd V.1 ((Additive.toMul (a + b) : Fˣ) : F) =
      wcpaDjValOrd V.1 ((Additive.toMul a : Fˣ) : F) + wcpaDjValOrd V.1 ((Additive.toMul b : Fˣ) : F)
    rw [toMul_add, Units.val_mul]
    exact (hv V.1 V.2).2.1 _ _ (Additive.toMul a).ne_zero (Additive.toMul b).ne_zero
  have hfam : wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro V a b h hab
      simp only [hw]
      rw [hab]
      have hne : (a : F) + (b : F) ≠ 0 := by rw [← hab]; exact h.ne_zero
      exact (hv V.1 V.2).2.2.2.1 _ _ a.ne_zero b.ne_zero hne
    · intro f
      have hpre := (hfin (f : F) f.ne_zero).preimage
        (f := (Subtype.val : {V : ValuationSubring F // wcpaDjNtV' K V} → ValuationSubring F))
        (fun _ _ _ _ h => Subtype.ext h)
      refine hpre.subset ?_
      intro V hV
      have hV' : w V (Additive.ofMul f) ≠ 0 := hV
      rw [hw] at hV'
      exact ⟨V.2, hV'⟩
    · intro V
      obtain ⟨π, hπ, hπ1⟩ := (hv V.1 V.2).1
      refine ⟨Units.mk0 π hπ, ?_⟩
      rw [hw]
      exact hπ1
    · intro f
      constructor
      · intro h
        refine (wcpa_dj_ffv_integral_const K F).2 (f : F) ?_
        intro V hV
        have h' := h ⟨V, hV⟩
        rw [hw] at h'
        exact ((hv V hV).2.2.1 _ f.ne_zero).mpr h'
      · rintro ⟨c, hc⟩ V
        rw [hw]
        apply ((hv V.1 V.2).2.2.1 _ f.ne_zero).mp
        rw [← hc]
        exact V.2.1 c

  have hinj : Function.Injective w := by
    intro V W hVW
    apply Subtype.ext
    ext x
    by_cases hx : x = 0
    · subst hx
      exact ⟨fun _ => W.1.zero_mem, fun _ => V.1.zero_mem⟩
    · have e1 := hw V (Units.mk0 x hx)
      have e2 := hw W (Units.mk0 x hx)
      rw [hVW] at e1
      rw [Units.val_mk0] at e1 e2
      have e : wcpaDjValOrd V.1 x = wcpaDjValOrd W.1 x := e1.symm.trans e2
      rw [(hv V.1 V.2).2.2.1 x hx, (hv W.1 W.2).2.2.1 x hx, e]

  have hA6 : wcRRFinRank K F := by
    refine wcpa_dj_ffv_finrank K F ?_ hfd
    intro f hf
    unfold Transcendental
    intro halg
    obtain ⟨c, hc⟩ := (wcpa_dj_ffv_integral_const K F).1 f halg
    exact hf ⟨c, hc⟩
  exact ⟨w, hw, hfam, hinj, hA6⟩

theorem wcpa_dj_cdp_cd_support_finite (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F) (D : Derivation K F F)
    (hD : ∀ (V : ValuationSubring F) (x : F), wcpaDjNtV' K V → wcpaDjValOrd V x = 1 → D x ≠ 0)
    (u : ValuationSubring F → F) (hu : ∀ V, wcpaDjNtV' K V → wcpaDjValOrd V (u V) = 1) :
    {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V (D (u V)) ≠ 0}.Finite :=
by
  classical
  obtain ⟨-, -, hfin, -, -⟩ := wcpa_dj_cdp_ff_valuations K F hF
  obtain ⟨z, hz, hsep, hsep'⟩ := wcpa_dj_ffv_separating K F hF
  have hz' : Transcendental K z⁻¹ := fun h => hz (IsAlgebraic.inv_iff.mp h)
  have hz0 : z ≠ 0 := hz.ne_zero
  haveI hfd : FiniteDimensional (IntermediateField.adjoin K {z}) F :=
    wcpa_dj_ffv_finite_over_transc K F hF z hz
  haveI hfd' : FiniteDimensional (IntermediateField.adjoin K {z⁻¹}) F :=
    wcpa_dj_ffv_finite_over_transc K F hF z⁻¹ hz'
  haveI := hsep
  haveI := hsep'

  have hDVR : ∀ V : ValuationSubring F, wcpaDjNtV' K V → IsDiscreteValuationRing ↥V := by
    intro V hV
    obtain ⟨A₁, hA₁d, hA₁f, hA₁c⟩ := wcpa_dj_ffv_dedekind_subring K F z hz
    obtain ⟨A₂, hA₂d, hA₂f, hA₂c⟩ := wcpa_dj_ffv_dedekind_subring K F z⁻¹ hz'
    rcases V.mem_or_inv_mem z with h | h
    · haveI := hA₁d; haveI := hA₁f
      exact (wcpa_dj_ffv_dedekind_local F A₁ V (hA₁c V hV.1 h) hV.2).1
    · haveI := hA₂d; haveI := hA₂f
      exact (wcpa_dj_ffv_dedekind_local F A₂ V (hA₂c V hV.1 h) hV.2).1
  have hU : ∀ V : ValuationSubring F, wcpaDjNtV' K V → ∀ x : F, x ≠ 0 →
      (wcpaDjValOrd V x = 0 ↔ (x ∈ V ∧ x⁻¹ ∈ V)) := by
    intro V hV x hx
    haveI := hDVR V hV
    exact (wcpa_dj_ffv_valord_dvr F V).2.2.2.2 x hx

  have hlt : ∀ (V : ValuationSubring F) (x y : F), V.valuation x < 1 → y ∈ V →
      V.valuation (x * y) < 1 := by
    intro V x y hx hy
    rw [map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' ((V.valuation_le_one_iff y).mpr hy)) hx

  have s1 : D z = 0 → ∀ x : F, D x = 0 := by
    intro hDz0
    have hpoly : ∀ p : Polynomial K, D (Polynomial.aeval z p) = 0 := by
      intro p
      rw [Derivation.map_aeval, hDz0, smul_zero]
    have hkill : ∀ l : IntermediateField.adjoin K {z}, D (l : F) = 0 := by
      intro l
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K (l : F)).mp l.2
      rw [hrs, div_eq_mul_inv, Derivation.leibniz, Derivation.leibniz_inv, hpoly, hpoly]
      simp
    let DL : Derivation (IntermediateField.adjoin K {z}) F F := Derivation.mk'
      { toFun := fun x => D x
        map_add' := fun x y => D.map_add x y
        map_smul' := fun l x => by
          show D (l • x) = l • D x
          rw [Algebra.smul_def, Algebra.smul_def, Derivation.leibniz, smul_eq_mul, smul_eq_mul,
            show algebraMap (IntermediateField.adjoin K {z}) F l = (l : F) from rfl, hkill l,
            mul_zero, add_zero] }
      (fun a b => D.leibniz a b)
    intro x
    have hsx : IsSeparable (IntermediateField.adjoin K {z}) x :=
      Algebra.IsSeparable.isSeparable _ x
    have h0 : DL (Polynomial.aeval x (minpoly (IntermediateField.adjoin K {z}) x)) = 0 := by
      rw [minpoly.aeval, map_zero]
    rw [Derivation.map_aeval, smul_eq_mul] at h0
    have hne := Polynomial.Separable.aeval_derivative_ne_zero hsx
      (minpoly.aeval (IntermediateField.adjoin K {z}) x)
    exact (mul_eq_zero.mp h0).resolve_left hne

  have s5 : ∀ V : ValuationSubring F, wcpaDjNtV' K V → z ∈ V →
      ∃ c : K, V.valuation (z - algebraMap K F c) < 1 := by
    intro V hV hzV
    by_contra hcon
    push_neg at hcon
    have hunit : ∀ c : K, V.valuation (z - algebraMap K F c) = 1 := fun c =>
      le_antisymm ((V.valuation_le_one_iff _).mpr (sub_mem hzV (hV.1 c))) (hcon c)
    have hconst : ∀ c : K, c ≠ 0 → V.valuation (algebraMap K F c) = 1 := by
      intro c hc
      apply le_antisymm ((V.valuation_le_one_iff _).mpr (hV.1 c))
      by_contra hlt'
      push_neg at hlt'
      have h1 := hlt V _ _ hlt' (hV.1 c⁻¹)
      rw [← map_mul, mul_inv_cancel₀ hc, map_one, map_one] at h1
      exact lt_irrefl _ h1
    have hpoly : ∀ p : Polynomial K, p ≠ 0 → V.valuation (Polynomial.aeval z p) = 1 := by
      intro p hp
      have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
        (IsAlgClosed.card_roots_eq_natDegree (p := p))
      rw [← hfac, map_mul, map_mul, Polynomial.aeval_C,
        hconst _ (Polynomial.leadingCoeff_ne_zero.mpr hp), one_mul, map_multiset_prod,
        map_multiset_prod, Multiset.map_map, Multiset.map_map]
      apply Multiset.prod_eq_one
      intro w hw
      obtain ⟨r, -, rfl⟩ := Multiset.mem_map.mp hw
      simp only [Function.comp_apply, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      exact hunit r
    have hpolyV : ∀ p : Polynomial K, Polynomial.aeval z p ∈ V := by
      intro p
      refine Polynomial.induction_on p ?_ ?_ ?_
      · intro a; rw [Polynomial.aeval_C]; exact hV.1 a
      · intro p q hp hq; rw [map_add]; exact add_mem hp hq
      · intro n a _
        rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        exact mul_mem (hV.1 a) (pow_mem hzV _)
    have hL : ∀ l : IntermediateField.adjoin K {z}, (l : F) ∈ V := by
      intro l
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K (l : F)).mp l.2
      rw [hrs]
      by_cases hs : s = 0
      · rw [hs, map_zero, div_zero]; exact zero_mem V
      · apply (V.valuation_le_one_iff _).mp
        rw [map_div₀, hpoly s hs, div_one, V.valuation_le_one_iff]
        exact hpolyV r
    apply hV.2
    refine eq_top_iff.mpr (fun x _ => ?_)
    have hint : _root_.IsIntegral (IntermediateField.adjoin K {z}) x := IsIntegral.of_finite _ x
    let ι : IntermediateField.adjoin K {z} →+* ↥V :=
      { toFun := fun r => ⟨r, hL r⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hcomp : (algebraMap ↥V F).comp ι = algebraMap (IntermediateField.adjoin K {z}) F := by
      ext r; rfl
    obtain ⟨p, hpm, hp⟩ := hint
    have hxV : _root_.IsIntegral ↥V x :=
      ⟨p.map ι, hpm.map ι, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxV
    rw [← hy]; exact y.2

  by_cases hDz : D z = 0
  · apply Set.finite_empty.subset
    intro V hV
    exact absurd (s1 hDz (u V)) (hD V (u V) hV.1 (hu V hV.1))

  obtain ⟨θ, hθ⟩ : ∃ θ : F → F, ∀ x, θ x = (D z)⁻¹ * D x := ⟨_, fun _ => rfl⟩
  have hθmul : ∀ a b, θ (a * b) = a * θ b + b * θ a := by
    intro a b; rw [hθ, hθ, hθ, Derivation.leibniz, smul_eq_mul, smul_eq_mul]; ring
  have hθadd : ∀ a b, θ (a + b) = θ a + θ b := by
    intro a b; rw [hθ, hθ, hθ, map_add]; ring
  have hθz : θ z = 1 := by rw [hθ]; exact inv_mul_cancel₀ hDz
  have hθc : ∀ c : K, θ (algebraMap K F c) = 0 := by
    intro c; rw [hθ, Derivation.map_algebraMap, mul_zero]
  have hθ0 : θ 0 = 0 := by rw [hθ, map_zero, mul_zero]

  have hDedR : IsDedekindDomain ↥(Algebra.adjoin K {z}) := by
    have hrange := Algebra.adjoin_singleton_eq_range_aeval K z
    haveI : IsPrincipalIdealRing ↥((Polynomial.aeval (R := K) z).range) :=
      IsPrincipalIdealRing.of_surjective (Polynomial.aeval (R := K) z).rangeRestrict
        (AlgHom.rangeRestrict_surjective _)
    haveI : IsPrincipalIdealRing ↥(Algebra.adjoin K {z}) := by rw [hrange]; infer_instance
    exact IsPrincipalIdealRing.isDedekindDomain _
  haveI := hDedR
  have hA1 : IsDedekindDomain ↥((integralClosure ↥(Algebra.adjoin K {z}) F).toSubring) := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact integralClosure.isDedekindDomain ↥(Algebra.adjoin K {z})
      ↥(IntermediateField.adjoin K {z}) F
  have hA2 : IsFractionRing ↥((integralClosure ↥(Algebra.adjoin K {z}) F).toSubring) F := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact integralClosure.isFractionRing_of_finite_extension (A := ↥(Algebra.adjoin K {z}))
      ↥(IntermediateField.adjoin K {z}) F
  have hCfin : Module.Finite ↥(Algebra.adjoin K {z}) ↥(integralClosure ↥(Algebra.adjoin K {z}) F) := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact IsIntegralClosure.finite ↥(Algebra.adjoin K {z}) (IntermediateField.adjoin K {z}) F
      ↥(integralClosure ↥(Algebra.adjoin K {z}) F)
  obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := ↥(Algebra.adjoin K {z}))
    (M := ↥(integralClosure ↥(Algebra.adjoin K {z}) F))
  have hspan : ∀ a : ↥(integralClosure ↥(Algebra.adjoin K {z}) F),
      ∃ c : Fin n → ↥(Algebra.adjoin K {z}), (a : F) = ∑ i, (c i : F) * (b i : F) := by
    intro a
    have ha : a ∈ Submodule.span ↥(Algebra.adjoin K {z}) (Set.range b) := by
      rw [hb]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp ha
    refine ⟨c, ?_⟩
    rw [← hc]
    simp [Algebra.smul_def]
  have hR : ∀ V : ValuationSubring F, (∀ c : K, algebraMap K F c ∈ V) → z ∈ V →
      ∀ r ∈ Algebra.adjoin K {z}, r ∈ V ∧ θ r ∈ V := by
    intro V hK hzV r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      obtain rfl := Set.mem_singleton_iff.mp hx
      rw [hθz]; exact ⟨hzV, one_mem V⟩
    | algebraMap c => rw [hθc]; exact ⟨hK c, zero_mem V⟩
    | add x y _ _ hx hy => rw [hθadd]; exact ⟨add_mem hx.1 hy.1, add_mem hx.2 hy.2⟩
    | mul x y _ _ hx hy =>
      rw [hθmul]
      exact ⟨mul_mem hx.1 hy.1, add_mem (mul_mem hx.1 hy.2) (mul_mem hy.1 hx.2)⟩
  have hcov : ∀ V : ValuationSubring F, (∀ c : K, algebraMap K F c ∈ V) → z ∈ V →
      ∀ x ∈ integralClosure ↥(Algebra.adjoin K {z}) F, x ∈ V := by
    intro V hK hzV x hx
    let ι : ↥(Algebra.adjoin K {z}) →+* ↥V :=
      { toFun := fun r => ⟨r, (hR V hK hzV r r.2).1⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hcomp : (algebraMap ↥V F).comp ι = algebraMap ↥(Algebra.adjoin K {z}) F := by
      ext r; rfl
    obtain ⟨p, hpm, hp⟩ := hx
    have hxV : _root_.IsIntegral ↥V x :=
      ⟨p.map ι, hpm.map ι, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxV
    rw [← hy]; exact y.2
  have hCV : ∀ V : ValuationSubring F, (∀ c : K, algebraMap K F c ∈ V) → z ∈ V →
      (∀ i, θ (b i : F) ∈ V) → ∀ a : ↥(integralClosure ↥(Algebra.adjoin K {z}) F),
      θ (a : F) ∈ V := by
    intro V hK hzV hθb a
    obtain ⟨c, hc⟩ := hspan a
    rw [hc]
    have hsum : ∀ s : Finset (Fin n), θ (∑ i ∈ s, (c i : F) * (b i : F)) ∈ V := by
      intro s
      induction s using Finset.induction_on with
      | empty => rw [Finset.sum_empty, hθ0]; exact zero_mem V
      | insert i s hi ih =>
        rw [Finset.sum_insert hi, hθadd, hθmul]
        exact add_mem (add_mem (mul_mem (hR V hK hzV _ (c i).2).1 (hθb i))
          (mul_mem (hcov V hK hzV _ (b i).2) (hR V hK hzV _ (c i).2).2)) ih
    exact hsum Finset.univ

  have hstab : ∀ V : ValuationSubring F, wcpaDjNtV' K V → z ∈ V → (∀ i, θ (b i : F) ∈ V) →
      ∀ x ∈ V, θ x ∈ V := by
    intro V hV hzV hθb x hx
    have hAV : (integralClosure ↥(Algebra.adjoin K {z}) F).toSubring ≤ V.toSubring :=
      fun y hy => hcov V hV.1 hzV y hy
    haveI := hA1
    haveI := hA2
    obtain ⟨-, hchar⟩ := wcpa_dj_ffv_dedekind_local F _ V hAV hV.2
    obtain ⟨a, s, ha, hs, hs0, hsinv, rfl⟩ := (hchar x).mp hx
    have hθa := hCV V hV.1 hzV hθb ⟨a, ha⟩
    have hθs := hCV V hV.1 hzV hθb ⟨s, hs⟩
    have key : θ (a / s) = s⁻¹ * (θ a - a / s * θ s) := by
      have e := hθmul (a / s) s
      rw [div_mul_cancel₀ a hs0] at e
      rw [e, add_sub_cancel_left, ← mul_assoc, inv_mul_cancel₀ hs0, one_mul]
    rw [key]
    exact mul_mem hsinv (sub_mem hθa (mul_mem hx hθs))

  have hfinZ : ({V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V z ≠ 0} ∪
      {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V (D z) ≠ 0} ∪
      ⋃ i : Fin n, {V : ValuationSubring F | wcpaDjNtV' K V ∧ θ (b i : F) ∉ V}).Finite := by
    refine ((hfin z hz0).union (hfin (D z) hDz)).union (Set.finite_iUnion fun i => ?_)
    by_cases h0 : θ (b i : F) = 0
    · exact Set.finite_empty.subset (fun V hV => hV.2 (by rw [h0]; exact zero_mem V))
    · exact (hfin _ h0).subset (fun V hV => ⟨hV.1, fun hv => hV.2 ((hU V hV.1 _ h0).mp hv).1⟩)
  refine hfinZ.subset ?_
  rintro V ⟨hV, hne⟩
  by_contra hZ
  have hvz : wcpaDjValOrd V z = 0 := by
    by_contra h; exact hZ (Or.inl (Or.inl ⟨hV, h⟩))
  have hvDz : wcpaDjValOrd V (D z) = 0 := by
    by_contra h; exact hZ (Or.inl (Or.inr ⟨hV, h⟩))
  have hθb : ∀ i, θ (b i : F) ∈ V := by
    intro i; by_contra h; exact hZ (Or.inr (Set.mem_iUnion.mpr ⟨i, hV, h⟩))
  have hzV : z ∈ V := ((hU V hV z hz0).mp hvz).1
  haveI := hDVR V hV
  obtain ⟨-, hM, hMem, -, hU'⟩ := wcpa_dj_ffv_valord_dvr F V
  have hst := hstab V hV hzV hθb
  obtain ⟨c, hc⟩ := s5 V hV hzV
  have hπ1 : wcpaDjValOrd V (u V) = 1 := hu V hV
  have hπ0 : u V ≠ 0 := by
    intro h; apply hD V (u V) hV hπ1; rw [h, map_zero]
  have hπV : u V ∈ V := (hMem (u V) hπ0).mpr (by rw [hπ1]; norm_num)
  have hπinv : (u V)⁻¹ ∉ V := fun h => by
    have := (hU' (u V) hπ0).mpr ⟨hπV, h⟩
    rw [hπ1] at this; norm_num at this
  have hv1 : wcpaDjValOrd V (1 : F) = 0 :=
    (hU' 1 one_ne_zero).mpr ⟨one_mem V, by rw [inv_one]; exact one_mem V⟩
  have hvπinv : wcpaDjValOrd V (u V)⁻¹ = -1 := by
    have := hM (u V) (u V)⁻¹ hπ0 (inv_ne_zero hπ0)
    rw [mul_inv_cancel₀ hπ0, hv1, hπ1] at this; linarith
  have hvalπ : V.valuation (u V) < 1 := by
    rcases lt_or_eq_of_le ((V.valuation_le_one_iff (u V)).mpr hπV) with h | h
    · exact h
    · exfalso; apply hπinv; rw [← V.valuation_le_one_iff, map_inv₀, h, inv_one]
  have hdiv : ∀ x : F, V.valuation x < 1 → x * (u V)⁻¹ ∈ V := by
    intro x hx
    by_cases hx0 : x = 0
    · rw [hx0, zero_mul]; exact zero_mem V
    have hxV : x ∈ V := (V.valuation_le_one_iff x).mp hx.le
    have hxinv : x⁻¹ ∉ V := by
      intro h
      have h2 := hlt V x x⁻¹ hx h
      rw [mul_inv_cancel₀ hx0, map_one] at h2
      exact lt_irrefl _ h2
    have hvx0 : 0 ≤ wcpaDjValOrd V x := (hMem x hx0).mp hxV
    have hvx1 : wcpaDjValOrd V x ≠ 0 := fun h => hxinv ((hU' x hx0).mp h).2
    apply (hMem _ (mul_ne_zero hx0 (inv_ne_zero hπ0))).mpr
    rw [hM x (u V)⁻¹ hx0 (inv_ne_zero hπ0), hvπinv]
    omega

  have hθπV : θ (u V) ∈ V := hst (u V) hπV
  have hθπ1 : V.valuation (θ (u V)) = 1 := by
    rcases lt_or_eq_of_le ((V.valuation_le_one_iff _).mpr hθπV) with h | h
    · exfalso
      have hall : ∀ x : F, V.valuation x < 1 → V.valuation (θ x) < 1 := by
        intro x hx
        have hq := hdiv x hx
        have hxe : x = u V * (x * (u V)⁻¹) := by
          rw [mul_left_comm, mul_inv_cancel₀ hπ0, mul_one]
        rw [hxe, hθmul]
        refine Valuation.map_add_lt _ ?_ ?_
        · exact hlt V _ _ hvalπ (hst _ hq)
        · rw [mul_comm (x * (u V)⁻¹) (θ (u V))]; exact hlt V _ _ h hq
      have hw := hall _ hc
      rw [hθ, map_sub, Derivation.map_algebraMap, sub_zero, inv_mul_cancel₀ hDz, map_one] at hw
      exact lt_irrefl _ hw
    · exact h
  have hθπ0 : θ (u V) ≠ 0 := by
    intro h; rw [h, map_zero] at hθπ1; exact zero_ne_one hθπ1
  have hvθπ : wcpaDjValOrd V (θ (u V)) = 0 :=
    (hU' _ hθπ0).mpr ⟨hθπV, by rw [← V.valuation_le_one_iff, map_inv₀, hθπ1, inv_one]⟩
  have hDπ : D (u V) = D z * θ (u V) := by
    rw [hθ, ← mul_assoc, mul_inv_cancel₀ hDz, one_mul]
  apply hne
  rw [hDπ, hM _ _ hDz hθπ0, hvDz, hvθπ, add_zero]

theorem wcpa_dj_cdp_cd_adele_finite (Ω K I : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hR : wcRRResidue Ω K I w)
    (hdim : wcRRDim Ω K I w) (i₀ : I) (g c : ℕ)
    (hRR : ∀ A : I →₀ ℤ, (c : ℤ) ≤ A.sum (fun _ k => k) →
      FiniteDimensional Ω (wcRRL Ω K I w A) ∧
      (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) = A.sum (fun _ k => k) + 1 - g) :
    ∃ (n : ℕ) (β : Fin n → I → K), ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      ∃ (a : Fin n → Ω) (f : K), ∀ i, wcValGe K (w i) 0 (α i - ∑ k, a k • β k i - f) :=
by
  classical

  have hmono : ∀ (i : I) (k k' : ℤ) (x : K), k ≤ k' → wcValGe K (w i) k' x →
      wcValGe K (w i) k x := by
    intro i k k' x hk hx
    rcases hx with h | ⟨hg, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨hg, le_trans hk h⟩
  have hneg1 : ∀ i, w i (Additive.ofMul (-1 : Kˣ)) = 0 := by
    intro i
    have h := (w i).map_add (Additive.ofMul (-1 : Kˣ)) (Additive.ofMul (-1 : Kˣ))
    rw [← ofMul_mul, neg_one_mul, neg_neg, ofMul_one, map_zero] at h
    omega
  have hadd : ∀ (i : I) (k : ℤ) (x y : K), wcValGe K (w i) k x → wcValGe K (w i) k y →
      wcValGe K (w i) k (x + y) := by
    intro i k x y hx hy
    rcases hx with rfl | ⟨hx0, hxk⟩
    · rw [zero_add]; exact hy
    rcases hy with rfl | ⟨hy0, hyk⟩
    · rw [add_zero]; exact Or.inr ⟨hx0, hxk⟩
    by_cases hs : x + y = 0
    · exact Or.inl hs
    · refine Or.inr ⟨hs, ?_⟩
      have := hw.1 i (Units.mk0 x hx0) (Units.mk0 y hy0) (Units.mk0 (x + y) hs) (by simp)
      exact le_trans (le_min hxk hyk) this
  have hneg : ∀ (i : I) (k : ℤ) (x : K), wcValGe K (w i) k x → wcValGe K (w i) k (-x) := by
    intro i k x hx
    rcases hx with rfl | ⟨hx0, hxk⟩
    · left; simp
    · right
      refine ⟨neg_ne_zero.mpr hx0, ?_⟩
      have e : Units.mk0 (-x) (neg_ne_zero.mpr hx0) = (-1 : Kˣ) * Units.mk0 x hx0 := by
        ext; simp
      rw [e, ofMul_mul, map_add, hneg1, zero_add]; exact hxk
  have hsub : ∀ (i : I) (k : ℤ) (x y : K), wcValGe K (w i) k x → wcValGe K (w i) k y →
      wcValGe K (w i) k (x - y) := by
    intro i k x y hx hy
    rw [sub_eq_add_neg]
    exact hadd i k x (-y) hx (hneg i k y hy)
  have hconst : ∀ (i : I) (c : Ω) (hc : algebraMap Ω K c ≠ 0),
      w i (Additive.ofMul (Units.mk0 (algebraMap Ω K c) hc)) = 0 := by
    intro i c hc
    have h1 := (hw.2.2.2 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ i
    have hc' : algebraMap Ω K c⁻¹ ≠ 0 := by rw [map_inv₀]; exact inv_ne_zero hc
    have h2 := (hw.2.2.2 (Units.mk0 _ hc')).mpr ⟨c⁻¹, rfl⟩ i
    have e : Units.mk0 (algebraMap Ω K c⁻¹) hc' = (Units.mk0 _ hc)⁻¹ := by
      ext; simp [map_inv₀]
    rw [e, ofMul_inv, map_neg] at h2
    omega
  have hsmul : ∀ (i : I) (k : ℤ) (c : Ω) (x : K), wcValGe K (w i) k x →
      wcValGe K (w i) k (c • x) := by
    intro i k c x hx
    rw [Algebra.smul_def]
    rcases hx with rfl | ⟨hx0, hxk⟩
    · left; simp
    by_cases hc : algebraMap Ω K c = 0
    · left; rw [hc, zero_mul]
    right
    refine ⟨mul_ne_zero hc hx0, ?_⟩
    have e : Units.mk0 (algebraMap Ω K c * x) (mul_ne_zero hc hx0) =
        Units.mk0 _ hc * Units.mk0 x hx0 := by ext; simp
    rw [e, ofMul_mul, map_add, hconst, zero_add]; exact hxk

  have hmem : ∀ (A : I →₀ ℤ) (f : K), f ∈ wcRRL Ω K I w A ↔ ∀ i, wcValGe K (w i) (-A i) f := by
    intro A f
    let M : Submodule Ω K :=
      { carrier := {f | ∀ i, wcValGe K (w i) (-A i) f}
        add_mem' := fun ha hb i => hadd _ _ _ _ (ha i) (hb i)
        zero_mem' := fun i => Or.inl rfl
        smul_mem' := fun c x hx i => hsmul _ _ c x (hx i) }
    constructor
    · intro hf
      have hle : wcRRL Ω K I w A ≤ M := by
        unfold wcRRL
        rw [Submodule.span_le]
        intro x hx
        obtain ⟨hx0, hxA⟩ := hx
        change ∀ i, wcValGe K (w i) (-A i) x
        intro i
        exact Or.inr ⟨hx0, by linarith [hxA i]⟩
      exact hle hf
    · intro hf
      by_cases h0 : f = 0
      · rw [h0]; exact Submodule.zero_mem _
      · unfold wcRRL
        apply Submodule.subset_span
        refine ⟨h0, fun i => ?_⟩
        rcases hf i with h | ⟨hg, hk⟩
        · exact absurd h h0
        · have hk' : -A i ≤ w i (Additive.ofMul (Units.mk0 f h0)) := hk
          linarith

  have hres : ∀ (j : I) (k : ℤ) (f₀ : Kˣ) (x : K), w j (Additive.ofMul f₀) = k →
      wcValGe K (w j) k x → ∃ c : Ω, wcValGe K (w j) (k + 1) (x - c • (f₀ : K)) := by
    intro j k f₀ x hf hx
    rcases hx with rfl | ⟨hx0, hxk⟩
    · exact ⟨0, Or.inl (by simp)⟩
    by_cases hlt : k + 1 ≤ w j (Additive.ofMul (Units.mk0 x hx0))
    · refine ⟨0, ?_⟩
      rw [zero_smul, sub_zero]
      exact Or.inr ⟨hx0, hlt⟩
    have hxv : w j (Additive.ofMul (Units.mk0 x hx0)) = k := by omega
    obtain ⟨c, hc⟩ := hR j (Units.mk0 x hx0 * f₀⁻¹)
      (by rw [ofMul_mul, map_add, ofMul_inv, map_neg, hxv, hf]; ring)
    refine ⟨c, ?_⟩
    rcases hc with h | ⟨h, hh1, hh2⟩
    · left
      rw [Algebra.smul_def, ← h, Units.val_mul, mul_assoc, Units.inv_mul, mul_one,
        Units.val_mk0, sub_self]
    · right
      have e : x - c • (f₀ : K) = ((h * f₀ : Kˣ) : K) := by
        rw [Units.val_mul, hh1, Units.val_mul, Units.val_mk0, Algebra.smul_def, sub_mul,
          mul_assoc, Units.inv_mul, mul_one]
      have hne : x - c • (f₀ : K) ≠ 0 := by rw [e]; exact Units.ne_zero _
      refine ⟨hne, ?_⟩
      have e2 : Units.mk0 (x - c • (f₀ : K)) hne = h * f₀ := by
        ext; rw [Units.val_mk0, e]
      rw [e2, ofMul_mul, map_add, hf]; omega

  have hdeg_sub : ∀ X Y : I →₀ ℤ, (X - Y).sum (fun _ k => k) =
      X.sum (fun _ k => k) - Y.sum (fun _ k => k) :=
    fun X Y => Finsupp.sum_sub_index (fun _ _ _ => rfl)
  have hdeg_add : ∀ X Y : I →₀ ℤ, (X + Y).sum (fun _ k => k) =
      X.sum (fun _ k => k) + Y.sum (fun _ k => k) :=
    fun X Y => Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)
  have hdeg_single : ∀ (j : I) (z : ℤ), (Finsupp.single j z).sum (fun _ k => k) = z :=
    fun j z => Finsupp.sum_single_index rfl
  have hsum_ge : ∀ E : I →₀ ℤ, (∀ i, 0 ≤ E i) → ∀ j, E j ≤ E.sum (fun _ k => k) := by
    intro E hE j
    unfold Finsupp.sum
    by_cases hj : j ∈ E.support
    · exact Finset.single_le_sum (f := fun i => E i) (fun i _ => hE i) hj
    · rw [Finsupp.notMem_support_iff.mp hj]
      exact Finset.sum_nonneg (fun i _ => hE i)

  obtain ⟨A₁, hA₁⟩ : ∃ A₁ : I →₀ ℤ, A₁ = Finsupp.single i₀ (c : ℤ) := ⟨_, rfl⟩
  have hA₁i₀ : A₁ i₀ = c := by rw [hA₁]; simp
  have hA₁ne : ∀ i, i ≠ i₀ → A₁ i = 0 := by
    intro i hi; rw [hA₁, Finsupp.single_apply, if_neg (Ne.symm hi)]
  have hA₁nn : ∀ i, 0 ≤ A₁ i := by
    intro i
    by_cases hi : i = i₀
    · rw [hi, hA₁i₀]; omega
    · rw [hA₁ne i hi]
  have hdegA₁ : A₁.sum (fun _ k => k) = c := by rw [hA₁, hdeg_single]

  have main : ∀ N : ℕ, ∀ B : I →₀ ℤ, (∀ i, A₁ i ≤ B i) → B.sum (fun _ k => k) = c + N →
      ∀ α : I → K, (∀ i, wcValGe K (w i) (-B i) (α i)) →
      ∃ f : K, ∀ i, wcValGe K (w i) (-A₁ i) (α i - f) := by
    intro N
    induction N with
    | zero =>
      intro B hB hdegB α hα
      by_cases hBA : ∀ i, B i ≤ A₁ i
      · refine ⟨0, fun i => ?_⟩
        rw [sub_zero, show A₁ i = B i from le_antisymm (hB i) (hBA i)]
        exact hα i
      · exfalso
        push_neg at hBA
        obtain ⟨j, hj⟩ := hBA
        have h1 := hsum_ge (B - A₁) (fun i => by simp [hB i]) j
        rw [hdeg_sub, hdegB, hdegA₁, Finsupp.coe_sub, Pi.sub_apply] at h1
        push_cast at h1
        omega
    | succ M ih =>
      intro B hB hdegB α hα
      by_cases hBA : ∀ i, B i ≤ A₁ i
      · refine ⟨0, fun i => ?_⟩
        rw [sub_zero, show A₁ i = B i from le_antisymm (hB i) (hBA i)]
        exact hα i
      push_neg at hBA
      obtain ⟨j, hj⟩ := hBA
      obtain ⟨B', hB'def⟩ : ∃ B' : I →₀ ℤ, B' = B - Finsupp.single j 1 := ⟨_, rfl⟩
      have hB'j : B' j = B j - 1 := by simp [hB'def]
      have hB'i : ∀ i, i ≠ j → B' i = B i := by
        intro i hi; simp [hB'def, Finsupp.single_apply, Ne.symm hi]
      have hdegB' : B'.sum (fun _ k => k) = c + M := by
        rw [hB'def, hdeg_sub, hdegB, hdeg_single]; push_cast; ring
      have hA₁B' : ∀ i, A₁ i ≤ B' i := by
        intro i
        by_cases hi : i = j
        · rw [hi, hB'j]; omega
        · rw [hB'i i hi]; exact hB i
      have hc1 : (c : ℤ) ≤ B.sum (fun _ k => k) := by rw [hdegB]; push_cast; omega
      have hc2 : (c : ℤ) ≤ B'.sum (fun _ k => k) := by rw [hdegB']; omega
      have hr1 := (hRR B hc1).2
      have hr2 := (hRR B' hc2).2
      have hle : wcRRL Ω K I w B' ≤ wcRRL Ω K I w B := by
        intro f hf
        rw [hmem] at hf ⊢
        intro i
        by_cases hi : i = j
        · rw [hi]; exact hmono _ _ _ _ (by rw [hB'j]; omega) (hf j)
        · rw [← hB'i i hi]; exact hf i
      have hnle : ¬ wcRRL Ω K I w B ≤ wcRRL Ω K I w B' := by
        intro h
        have heq := le_antisymm h hle
        rw [heq, hdegB] at hr1
        rw [hdegB'] at hr2
        push_cast at hr1 hr2
        omega
      obtain ⟨f₀, hf₀B, hf₀B'⟩ := SetLike.not_le_iff_exists.mp hnle
      have hf₀0 : f₀ ≠ 0 := by
        rintro rfl; exact hf₀B' (Submodule.zero_mem _)
      rw [hmem] at hf₀B hf₀B'
      push_neg at hf₀B'
      obtain ⟨i1, hi1⟩ := hf₀B'
      have hi1j : i1 = j := by
        by_contra hne
        rw [hB'i i1 hne] at hi1
        exact hi1 (hf₀B i1)
      rw [hi1j] at hi1
      have hv : w j (Additive.ofMul (Units.mk0 f₀ hf₀0)) = -B j := by
        rcases hf₀B j with h | ⟨hg, h⟩
        · exact absurd h hf₀0
        · have h' : -B j ≤ w j (Additive.ofMul (Units.mk0 f₀ hf₀0)) := h
          have : ¬ (-B' j ≤ w j (Additive.ofMul (Units.mk0 f₀ hf₀0))) :=
            fun h'' => hi1 (Or.inr ⟨hf₀0, h''⟩)
          rw [hB'j] at this
          omega
      obtain ⟨c₀, hc₀⟩ := hres j (-B j) (Units.mk0 f₀ hf₀0) (α j) hv (hα j)
      rw [Units.val_mk0] at hc₀
      obtain ⟨f', hf'⟩ := ih B' hA₁B' hdegB' (fun i => α i - c₀ • f₀) (by
        intro i
        by_cases hi : i = j
        · rw [hi, hB'j]; exact hmono _ _ _ _ (by omega) hc₀
        · rw [hB'i i hi]
          exact hsub _ _ _ _ (hα i) (hsmul _ _ c₀ f₀ (hf₀B i)))
      refine ⟨c₀ • f₀ + f', fun i => ?_⟩
      rw [← sub_sub]; exact hf' i

  obtain ⟨t, ht⟩ := hw.2.2.1 i₀
  have hpp : ∀ (m : ℕ) (x : K), wcValGe K (w i₀) (-(m : ℤ)) x →
      ∃ a : Fin m → Ω, wcValGe K (w i₀) 0 (x - ∑ k : Fin m, a k • (t : K)⁻¹ ^ ((k : ℕ) + 1)) := by
    intro m
    induction m with
    | zero =>
      intro x hx
      refine ⟨Fin.elim0, ?_⟩
      simpa using hx
    | succ m ih =>
      intro x hx
      have hv : w i₀ (Additive.ofMul (t⁻¹ ^ (m + 1))) = -((m + 1 : ℕ) : ℤ) := by
        rw [ofMul_pow, map_nsmul, ofMul_inv, map_neg, ht, nsmul_eq_mul]; push_cast; ring
      obtain ⟨c₀, hc₀⟩ := hres i₀ _ (t⁻¹ ^ (m + 1)) x hv hx
      rw [Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val] at hc₀
      obtain ⟨a', ha'⟩ := ih (x - c₀ • (t : K)⁻¹ ^ (m + 1))
        (hmono _ _ _ _ (by push_cast; omega) hc₀)
      refine ⟨Fin.snoc (α := fun _ => Ω) a' c₀, ?_⟩
      have e : x - ∑ k : Fin (m + 1), (Fin.snoc (α := fun _ => Ω) a' c₀ k) •
          (t : K)⁻¹ ^ ((k : ℕ) + 1) = (x - c₀ • (t : K)⁻¹ ^ (m + 1)) -
          ∑ k : Fin m, a' k • (t : K)⁻¹ ^ ((k : ℕ) + 1) := by
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.val_castSucc, Fin.val_last]
        abel
      rw [e]; exact ha'

  refine ⟨c, fun k i => if i = i₀ then (t : K)⁻¹ ^ ((k : ℕ) + 1) else 0, ?_⟩
  intro α hS
  obtain ⟨e, he⟩ : ∃ e : I → ℤ, e = fun i => if h : α i = 0 then 0 else
      max 0 (-(w i (Additive.ofMul (Units.mk0 (α i) h)))) := ⟨_, rfl⟩
  have he0 : ∀ i, 0 ≤ e i := by
    intro i; rw [he]; beta_reduce; split_ifs <;> omega
  have hesupp : (Function.support e).Finite := by
    refine hS.subset ?_
    intro i hi
    rw [Function.mem_support] at hi
    intro hv
    apply hi
    rw [he]
    beta_reduce
    rcases hv with h | ⟨hg, h⟩
    · rw [dif_pos h]
    · rw [dif_neg hg]; omega
  obtain ⟨E, hE⟩ : ∃ E : I →₀ ℤ, ∀ i, E i = e i :=
    ⟨Finsupp.ofSupportFinite e hesupp, fun i => by rw [Finsupp.ofSupportFinite_coe]⟩
  have hdegE : 0 ≤ E.sum (fun _ k => k) :=
    le_trans (by rw [hE]; exact he0 i₀) (hsum_ge E (fun i => by rw [hE]; exact he0 i) i₀)
  obtain ⟨f, hf⟩ := main (E.sum (fun _ k => k)).toNat (A₁ + E)
    (fun i => by rw [Finsupp.coe_add, Pi.add_apply, hE]; linarith [he0 i])
    (by rw [hdeg_add, hdegA₁, Int.toNat_of_nonneg hdegE])
    α (by
      intro i
      by_cases h : α i = 0
      · exact Or.inl h
      · refine Or.inr ⟨h, ?_⟩
        rw [Finsupp.coe_add, Pi.add_apply, hE, he]
        beta_reduce
        rw [dif_neg h]
        have := hA₁nn i
        omega)
  have hf₀ := hf i₀
  rw [hA₁i₀] at hf₀
  obtain ⟨a, ha⟩ := hpp c (α i₀ - f) hf₀
  refine ⟨a, f, fun i => ?_⟩
  beta_reduce
  by_cases hi : i = i₀
  · rw [hi]
    have hs : ∑ k, a k • (if i₀ = i₀ then (t : K)⁻¹ ^ ((k : ℕ) + 1) else 0) =
        ∑ k : Fin c, a k • (t : K)⁻¹ ^ ((k : ℕ) + 1) :=
      Finset.sum_congr rfl (fun k _ => by rw [if_pos rfl])
    rw [hs, sub_right_comm]
    exact ha
  · have hs : ∑ k, a k • (if i = i₀ then (t : K)⁻¹ ^ ((k : ℕ) + 1) else 0) = 0 := by
      simp [hi]
    rw [hs, sub_zero]
    have := hf i
    rw [hA₁ne i hi, neg_zero] at this
    exact this

theorem wd_approx (Ω K I : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hdim : wcRRDim Ω K I w) (g c : ℕ)
    (hRR : ∀ A : I →₀ ℤ, (c : ℤ) ≤ A.sum (fun _ k => k) →
      FiniteDimensional Ω (wcRRL Ω K I w A) ∧
      (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) = A.sum (fun _ k => k) + 1 - g)
    (hrel : ∀ A C : I →₀ ℤ, A ≤ C → ∃ (n : ℕ) (β : Fin n → I → K),
      (n : ℤ) = C.sum (fun _ k => k) - A.sum (fun _ k => k) ∧
      (∀ k i, wcValGe K (w i) (-C i) (β k i)) ∧
      (∀ α : I → K, (∀ i, wcValGe K (w i) (-C i) (α i)) →
        ∃ a : Fin n → Ω, ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • β k i)) ∧
      (∀ a : Fin n → Ω, (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • β k i)) → a = 0))
    (C : I →₀ ℤ) (hC : (c : ℤ) ≤ C.sum (fun _ k => k)) (α : I → K)
    (hα : {i | ¬ wcValGe K (w i) 0 (α i)}.Finite) :
    ∃ f : K, ∀ i, wcValGe K (w i) (-C i) (α i - f) :=
by
  classical

  have wmul : ∀ i (a b : Kˣ), w i (Additive.ofMul (a * b)) =
      w i (Additive.ofMul a) + w i (Additive.ofMul b) := by
    intro i a b; rw [ofMul_mul, map_add]
  have wone : ∀ i, w i (Additive.ofMul (1 : Kˣ)) = 0 := by
    intro i; rw [ofMul_one, map_zero]
  have wconst : ∀ i (a : Ω) (h : algebraMap Ω K a ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ h)) = 0 := by
    intro i a h
    have ha : a ≠ 0 := fun h0 => h (by rw [h0, map_zero])
    have h' : algebraMap Ω K a⁻¹ ≠ 0 := by
      rw [map_inv₀]; exact inv_ne_zero h
    have e1 := (hw.2.2.2 (Units.mk0 _ h)).mpr ⟨a, rfl⟩ i
    have e2 := (hw.2.2.2 (Units.mk0 _ h')).mpr ⟨a⁻¹, rfl⟩ i
    have e3 : Units.mk0 _ h * Units.mk0 _ h' = 1 := by
      ext; simp [map_inv₀, ha]
    have e4 := wmul i (Units.mk0 _ h) (Units.mk0 _ h')
    rw [e3, wone] at e4
    omega
  have vz : ∀ i (k : ℤ), wcValGe K (w i) k 0 := fun i k => Or.inl rfl
  have vadd : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f + g) := by
    intro i k f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [zero_add]; exact hg
    rcases hg with hg | ⟨hg0, hg⟩
    · subst hg; rw [add_zero]; exact Or.inr ⟨hf0, hf⟩
    by_cases hfg : f + g = 0
    · exact Or.inl hfg
    refine Or.inr ⟨hfg, ?_⟩
    have := hw.1 i (Units.mk0 f hf0) (Units.mk0 g hg0) (Units.mk0 (f + g) hfg) (by simp)
    exact le_trans (le_min hf hg) this
  have wneg1 : ∀ i (f : K) (hf : f ≠ 0) (hf' : -f ≠ 0),
      w i (Additive.ofMul (Units.mk0 (-f) hf')) = w i (Additive.ofMul (Units.mk0 f hf)) := by
    intro i f hf hf'
    have h1 : algebraMap Ω K (-1) ≠ 0 := by simp
    have e : Units.mk0 (-f) hf' = Units.mk0 _ h1 * Units.mk0 f hf := by ext; simp
    rw [e, wmul, wconst, zero_add]
  have vneg : ∀ i (k : ℤ) (f : K), wcValGe K (w i) k f → wcValGe K (w i) k (-f) := by
    intro i k f hf
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [neg_zero]; exact vz i k
    have hf' : -f ≠ 0 := neg_ne_zero.mpr hf0
    exact Or.inr ⟨hf', by rw [wneg1 i f hf0 hf']; exact hf⟩
  have vsub : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f - g) := by
    intro i k f g hf hg
    rw [sub_eq_add_neg]; exact vadd i k f (-g) hf (vneg i k g hg)
  have vsmul : ∀ i (k : ℤ) (a : Ω) (f : K), wcValGe K (w i) k f →
      wcValGe K (w i) k (a • f) := by
    intro i k a f hf
    by_cases haf : a • f = 0
    · exact Or.inl haf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact absurd (by rw [hf, smul_zero]) haf
    have ha : algebraMap Ω K a ≠ 0 := by
      intro h0; apply haf; rw [Algebra.smul_def, h0, zero_mul]
    have e : Units.mk0 (a • f) haf = Units.mk0 _ ha * Units.mk0 f hf0 := by
      ext; simp [Algebra.smul_def]
    exact Or.inr ⟨haf, by rw [e, wmul, wconst, zero_add]; exact hf⟩
  have hmem : ∀ (A : I →₀ ℤ) (f : K), f ∈ wcRRL Ω K I w A ↔ ∀ i, wcValGe K (w i) (-A i) f := by
    intro A f
    constructor
    · intro hf
      unfold wcRRL at hf
      induction hf using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨hx0, hx⟩ := hx
        intro i
        refine Or.inr ⟨hx0, ?_⟩
        have := hx i
        omega
      | zero => intro i; exact vz i _
      | add x y _ _ hx hy => intro i; exact vadd i _ x y (hx i) (hy i)
      | smul a x _ hx => intro i; exact vsmul i _ a x (hx i)
    · intro hf
      by_cases h0 : f = 0
      · rw [h0]; exact Submodule.zero_mem _
      · unfold wcRRL
        apply Submodule.subset_span
        refine ⟨h0, fun i => ?_⟩
        rcases hf i with h | ⟨hg, h⟩
        · exact absurd h h0
        · have h' : -A i ≤ w i (Additive.ofMul (Units.mk0 f h0)) := h
          omega

  have degsub : ∀ C A : I →₀ ℤ, (C - A).sum (fun _ k => k) =
      C.sum (fun _ k => k) - A.sum (fun _ k => k) := by
    intro C A
    exact Finsupp.sum_sub_index (fun _ _ _ => rfl)
  have degnn : ∀ D : I →₀ ℤ, 0 ≤ D → 0 ≤ D.sum (fun _ k => k) := by
    intro D hD
    unfold Finsupp.sum
    exact Finset.sum_nonneg (fun x _ => hD x)
  have degle : ∀ D : I →₀ ℤ, 0 ≤ D → ∀ i, D i ≤ D.sum (fun _ k => k) := by
    intro D hD i
    have hnn : ∀ x ∈ D.support, 0 ≤ D x := fun x _ => hD x
    by_cases hi : i ∈ D.support
    · unfold Finsupp.sum
      exact Finset.single_le_sum (f := fun x => D x) hnn hi
    · rw [Finsupp.notMem_support_iff.mp hi]
      exact degnn D hD
  have hCAnn : ∀ A C : I →₀ ℤ, A ≤ C → 0 ≤ C - A := by
    intro A C hAC x
    rw [Finsupp.sub_apply, Finsupp.coe_zero, Pi.zero_apply]
    have := hAC x; omega

  have enlarge : ∃ B : I →₀ ℤ, C ≤ B ∧ ∀ i, wcValGe K (w i) (-B i) (α i) := by
    let gfun : I → ℤ := fun i =>
      if h : α i = 0 then C i else max (C i) (-(w i (Additive.ofMul (Units.mk0 (α i) h))))
    have hg : ∀ i, gfun i ≠ 0 → i ∈ hα.toFinset ∪ C.support := by
      intro i hi
      by_contra hT
      rw [Finset.mem_union, not_or] at hT
      obtain ⟨h1, h2⟩ := hT
      rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq, not_not] at h1
      rw [Finsupp.notMem_support_iff] at h2
      apply hi
      simp only [gfun]
      split_ifs with h
      · exact h2
      · rcases h1 with h1 | ⟨h3, h4⟩
        · exact absurd h1 h
        · have h4' : 0 ≤ w i (Additive.ofMul (Units.mk0 (α i) h)) := h4
          rw [h2]
          exact max_eq_left (by linarith)
    refine ⟨Finsupp.onFinset _ gfun hg, ?_, ?_⟩
    · intro i
      rw [Finsupp.onFinset_apply]
      simp only [gfun]
      split_ifs with h
      · exact le_rfl
      · exact le_max_left _ _
    · intro i
      rw [Finsupp.onFinset_apply]
      simp only [gfun]
      by_cases h : α i = 0
      · exact Or.inl h
      · rw [dif_neg h]
        refine Or.inr ⟨h, ?_⟩
        have := le_max_right (C i) (-(w i (Additive.ofMul (Units.mk0 (α i) h))))
        linarith

  have step : ∀ (A : I →₀ ℤ) (j : I), (c : ℤ) ≤ A.sum (fun _ k => k) → ∀ α : I → K,
      (∀ i, wcValGe K (w i) (-((A + Finsupp.single j (1:ℤ) : I →₀ ℤ) i)) (α i)) →
      ∃ f : K, ∀ i, wcValGe K (w i) (-A i) (α i - f) := by
    intro A j hA α hα
    set A' : I →₀ ℤ := A + Finsupp.single j (1:ℤ) with hA'
    have hdegA' : A'.sum (fun _ k => k) = A.sum (fun _ k => k) + 1 := by
      rw [hA', Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_single_index rfl]
    have hAA' : A ≤ A' := by
      intro i
      rw [hA', Finsupp.add_apply, Finsupp.single_apply]
      split_ifs <;> omega
    obtain ⟨hfd, hl⟩ := hRR A hA
    obtain ⟨_, hl'⟩ := hRR A' (by omega)
    haveI := hfd
    have hs : ∃ s, s ∈ wcRRL Ω K I w A' ∧ s ∉ wcRRL Ω K I w A := by
      by_contra hcon
      push_neg at hcon
      have hle : wcRRL Ω K I w A' ≤ wcRRL Ω K I w A := fun s hs => hcon s hs
      have h1 := Submodule.finrank_mono hle
      have h2 : (Module.finrank Ω (wcRRL Ω K I w A') : ℤ) ≤
          Module.finrank Ω (wcRRL Ω K I w A) := by exact_mod_cast h1
      omega
    obtain ⟨s, hsA', hsA⟩ := hs
    obtain ⟨n, β, hn, hβ1, hβ2, -⟩ := hrel A A' hAA'
    have hn1 : n = 1 := by omega
    subst hn1
    obtain ⟨as, has⟩ := hβ2 (fun _ => s) (fun i => (hmem A' s).1 hsA' i)
    obtain ⟨aα, haα⟩ := hβ2 α hα
    simp only [Fin.sum_univ_one] at has haα
    have has0 : as 0 ≠ 0 := by
      intro h0
      apply hsA
      rw [hmem]
      intro i
      have := has i
      rw [h0, zero_smul, sub_zero] at this
      exact this
    refine ⟨(aα 0 / as 0) • s, fun i => ?_⟩
    have e : α i - (aα 0 / as 0) • s =
        (α i - aα 0 • β 0 i) - (aα 0 / as 0) • (s - as 0 • β 0 i) := by
      rw [smul_sub, smul_smul, div_mul_cancel₀ _ has0]; abel
    rw [e]
    exact vsub i _ _ _ (haα i) (vsmul i _ _ _ (has i))

  have key : ∀ N : ℕ, ∀ B : I →₀ ℤ, C ≤ B →
      B.sum (fun _ k => k) - C.sum (fun _ k => k) = (N : ℤ) →
      ∀ α : I → K, (∀ i, wcValGe K (w i) (-B i) (α i)) →
      ∃ f : K, ∀ i, wcValGe K (w i) (-C i) (α i - f) := by
    intro N
    induction N with
    | zero =>
      intro B hCB hdeg α hα
      have hBC : B = C := by
        ext i
        have h1 := degle (B - C) (hCAnn C B hCB) i
        rw [degsub, hdeg, Finsupp.sub_apply] at h1
        have h2 := hCB i
        push_cast at h1
        omega
      subst hBC
      exact ⟨0, fun i => by rw [sub_zero]; exact hα i⟩
    | succ N ih =>
      intro B hCB hdeg α hα
      obtain ⟨j, hj⟩ : ∃ j, C j < B j := by
        by_contra hc
        push_neg at hc
        have : B = C := by ext i; exact le_antisymm (hc i) (hCB i)
        subst this
        rw [sub_self] at hdeg
        omega
      set A : I →₀ ℤ := B - Finsupp.single j (1:ℤ) with hAdef
      have hAj : A j = B j - 1 := by
        rw [hAdef, Finsupp.sub_apply, Finsupp.single_eq_same]
      have hAne : ∀ i, i ≠ j → A i = B i := by
        intro i h
        rw [hAdef, Finsupp.sub_apply, Finsupp.single_eq_of_ne h, sub_zero]
      have hCA : C ≤ A := by
        intro i
        by_cases h : i = j
        · subst h; rw [hAj]; omega
        · rw [hAne i h]; exact hCB i
      have hdegA : A.sum (fun _ k => k) - C.sum (fun _ k => k) = (N : ℤ) := by
        rw [hAdef, degsub, Finsupp.sum_single_index rfl]
        push_cast at hdeg
        omega
      have hAB : A + Finsupp.single j (1:ℤ) = B := by rw [hAdef, sub_add_cancel]
      have hAc : (c : ℤ) ≤ A.sum (fun _ k => k) := by
        have := degnn _ (hCAnn C A hCA)
        rw [degsub] at this
        omega
      obtain ⟨f₁, hf₁⟩ := step A j hAc α (by rw [hAB]; exact hα)
      obtain ⟨f₂, hf₂⟩ := ih A hCA hdegA (fun i => α i - f₁) hf₁
      exact ⟨f₁ + f₂, fun i => by rw [← sub_sub]; exact hf₂ i⟩

  obtain ⟨B, hCB, hαB⟩ := enlarge
  have hnn : 0 ≤ B.sum (fun _ k => k) - C.sum (fun _ k => k) := by
    rw [← degsub]; exact degnn _ (hCAnn C B hCB)
  exact key _ B hCB (Int.toNat_of_nonneg hnn).symm α hαB

theorem wd_index (Ω K I : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hdim : wcRRDim Ω K I w)
    (i₀ : I) (g c : ℕ)
    (hRR : ∀ A : I →₀ ℤ, (c : ℤ) ≤ A.sum (fun _ k => k) →
      FiniteDimensional Ω (wcRRL Ω K I w A) ∧
      (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) = A.sum (fun _ k => k) + 1 - g)
    (hrel : ∀ A C : I →₀ ℤ, A ≤ C → ∃ (n : ℕ) (β : Fin n → I → K),
      (n : ℤ) = C.sum (fun _ k => k) - A.sum (fun _ k => k) ∧
      (∀ k i, wcValGe K (w i) (-C i) (β k i)) ∧
      (∀ α : I → K, (∀ i, wcValGe K (w i) (-C i) (α i)) →
        ∃ a : Fin n → Ω, ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • β k i)) ∧
      (∀ a : Fin n → Ω, (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • β k i)) → a = 0))
    (happrox : ∀ C : I →₀ ℤ, (c : ℤ) ≤ C.sum (fun _ k => k) → ∀ α : I → K,
      {i | ¬ wcValGe K (w i) 0 (α i)}.Finite → ∃ f : K, ∀ i, wcValGe K (w i) (-C i) (α i - f))
    (A : I →₀ ℤ) :
    ∃ (N : ℕ) (γ : Fin N → I → K),
      (N : ℤ) = (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) - A.sum (fun _ k => k) - 1 + g ∧
      (∀ k, {i | ¬ wcValGe K (w i) 0 (γ k i)}.Finite) ∧
      (∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        ∃ (a : Fin N → Ω) (f : K), ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • γ k i - f)) ∧
      (∀ (a : Fin N → Ω) (f : K),
        (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • γ k i - f)) → a = 0) :=
by
  classical

  have wmul : ∀ i (a b : Kˣ), w i (Additive.ofMul (a * b)) =
      w i (Additive.ofMul a) + w i (Additive.ofMul b) := by
    intro i a b; rw [ofMul_mul, map_add]
  have wone : ∀ i, w i (Additive.ofMul (1 : Kˣ)) = 0 := by
    intro i; rw [ofMul_one, map_zero]
  have wconst : ∀ i (a : Ω) (h : algebraMap Ω K a ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ h)) = 0 := by
    intro i a h
    have ha : a ≠ 0 := fun h0 => h (by rw [h0, map_zero])
    have h' : algebraMap Ω K a⁻¹ ≠ 0 := by
      rw [map_inv₀]; exact inv_ne_zero h
    have e1 := (hw.2.2.2 (Units.mk0 _ h)).mpr ⟨a, rfl⟩ i
    have e2 := (hw.2.2.2 (Units.mk0 _ h')).mpr ⟨a⁻¹, rfl⟩ i
    have e3 : Units.mk0 _ h * Units.mk0 _ h' = 1 := by
      ext; simp [map_inv₀, ha]
    have e4 := wmul i (Units.mk0 _ h) (Units.mk0 _ h')
    rw [e3, wone] at e4
    omega
  have vz : ∀ i (k : ℤ), wcValGe K (w i) k 0 := fun i k => Or.inl rfl
  have vadd : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f + g) := by
    intro i k f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [zero_add]; exact hg
    rcases hg with hg | ⟨hg0, hg⟩
    · subst hg; rw [add_zero]; exact Or.inr ⟨hf0, hf⟩
    by_cases hfg : f + g = 0
    · exact Or.inl hfg
    refine Or.inr ⟨hfg, ?_⟩
    have := hw.1 i (Units.mk0 f hf0) (Units.mk0 g hg0) (Units.mk0 (f + g) hfg) (by simp)
    exact le_trans (le_min hf hg) this
  have vsmul : ∀ i (k : ℤ) (a : Ω) (f : K), wcValGe K (w i) k f →
      wcValGe K (w i) k (a • f) := by
    intro i k a f hf
    by_cases haf : a • f = 0
    · exact Or.inl haf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact absurd (by rw [hf, smul_zero]) haf
    have ha : algebraMap Ω K a ≠ 0 := by
      intro h0; apply haf; rw [Algebra.smul_def, h0, zero_mul]
    have e : Units.mk0 (a • f) haf = Units.mk0 _ ha * Units.mk0 f hf0 := by
      ext; simp [Algebra.smul_def]
    exact Or.inr ⟨haf, by rw [e, wmul, wconst, zero_add]; exact hf⟩
  have vmono : ∀ i (k l : ℤ) (f : K), l ≤ k → wcValGe K (w i) k f → wcValGe K (w i) l f := by
    intro i k l f hlk hf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact Or.inl hf
    · exact Or.inr ⟨hf0, le_trans hlk hf⟩
  have vsum : ∀ i (k : ℤ) {n : ℕ} (a : Fin n → Ω) (β : Fin n → I → K),
      (∀ m, wcValGe K (w i) k (β m i)) → wcValGe K (w i) k (∑ m, a m • β m i) := by
    intro i k n a β hβ
    exact Finset.sum_induction _ (fun x => wcValGe K (w i) k x)
      (fun x y hx hy => vadd i k x y hx hy) (vz i k)
      (fun m _ => vsmul i k (a m) (β m i) (hβ m))

  let AA : (I →₀ ℤ) → Submodule Ω (I → K) := fun D =>
    { carrier := {α | ∀ i, wcValGe K (w i) (-D i) (α i)}
      add_mem' := fun {a b} ha hb i => vadd i _ _ _ (ha i) (hb i)
      zero_mem' := fun i => vz i _
      smul_mem' := fun a α h i => vsmul i _ a (α i) (h i) }
  have memAA : ∀ (D : I →₀ ℤ) (α : I → K), α ∈ AA D ↔ ∀ i, wcValGe K (w i) (-D i) (α i) :=
    fun D α => Iff.rfl
  let δ : K →ₗ[Ω] (I → K) :=
    { toFun := fun f _ => f, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
  have hmem : ∀ (D : I →₀ ℤ) (f : K), f ∈ wcRRL Ω K I w D ↔ δ f ∈ AA D := by
    intro D f
    constructor
    · intro hf
      have hle : wcRRL Ω K I w D ≤ (AA D).comap δ := by
        unfold wcRRL
        rw [Submodule.span_le]
        intro x hx
        obtain ⟨hx0, hxD⟩ := hx
        refine Submodule.mem_comap.mpr ((memAA D _).mpr fun i => Or.inr ⟨hx0, ?_⟩)
        have := hxD i
        show -D i ≤ w i (Additive.ofMul (Units.mk0 x hx0))
        omega
      exact hle hf
    · intro hf
      by_cases hf0 : f = 0
      · rw [hf0]; exact Submodule.zero_mem _
      · apply Submodule.subset_span
        refine ⟨hf0, fun i => ?_⟩
        rcases (memAA D _).mp hf i with h | ⟨h, hle⟩
        · exact absurd h hf0
        · have : -D i ≤ w i (Additive.ofMul (Units.mk0 f hf0)) := hle
          omega
  have hadele : ∀ (D : I →₀ ℤ) (α : I → K), α ∈ AA D →
      {i | ¬ wcValGe K (w i) 0 (α i)}.Finite := by
    intro D α hα
    refine (D.support.finite_toSet).subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq] at hi
    rw [Finset.mem_coe, Finsupp.mem_support_iff]
    intro h0
    have := (memAA D α).mp hα i
    rw [h0, neg_zero] at this
    exact hi this

  obtain ⟨C, hAC, hcC⟩ : ∃ C : I →₀ ℤ, A ≤ C ∧ (c : ℤ) ≤ C.sum (fun _ k => k) := by
    refine ⟨A + Finsupp.single i₀ ((((c : ℤ) - A.sum (fun _ k => k)).toNat : ℕ) : ℤ), ?_, ?_⟩
    · refine Finsupp.le_def.mpr fun i => ?_
      rw [Finsupp.add_apply, Finsupp.single_apply]
      split_ifs <;> omega
    · rw [Finsupp.sum_add_index' (h := fun _ k => k) (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_single_index rfl]
      have := Int.self_le_toNat ((c : ℤ) - A.sum (fun _ k => k))
      omega
  obtain ⟨hfdC, hℓC⟩ := hRR C hcC
  obtain ⟨n, β, hn, hβ1, hβ2, hβ3⟩ := hrel A C hAC
  have hPC : AA A ≤ AA C := fun α h => (memAA C α).mpr fun i =>
    vmono i _ _ _ (by have := Finsupp.le_def.mp hAC i; omega) ((memAA A α).mp h i)

  let T : (Fin n → Ω) →ₗ[Ω] (I → K) :=
    { toFun := fun a i => ∑ k, a k • β k i
      map_add' := fun a b => by
        funext i; simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun r a => by
        funext i
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
  have hTM : ∀ a, T a ∈ AA C := fun a => (memAA C _).mpr fun i => vsum i _ a β (fun k => hβ1 k i)
  have hU : ∀ (a a' : Fin n → Ω) (x : I → K), T a - x ∈ AA A → T a' - x ∈ AA A → a = a' := by
    intro a a' x h1 h2
    have h3 : T (a - a') ∈ AA A := by
      have := Submodule.sub_mem _ h1 h2
      rwa [sub_sub_sub_cancel_right, ← map_sub] at this
    have := hβ3 (a - a') (fun i => (memAA A _).mp h3 i)
    exact sub_eq_zero.mp this
  have hex0 : ∀ x ∈ AA C, ∃ a, T a - x ∈ AA A := by
    intro x hx
    obtain ⟨a, ha⟩ := hβ2 x ((memAA C x).mp hx)
    refine ⟨a, ?_⟩
    have h1 : x - T a ∈ AA A := (memAA A _).mpr fun i => ha i
    have := Submodule.neg_mem _ h1
    rwa [neg_sub] at this

  have hLC : ∀ y : wcRRL Ω K I w C, δ (y : K) ∈ AA C := fun y => (hmem C y).mp y.2
  choose φ₀ hφ₀ using fun y : wcRRL Ω K I w C => hex0 (δ (y : K)) (hLC y)
  let φ : wcRRL Ω K I w C →ₗ[Ω] (Fin n → Ω) :=
    { toFun := φ₀
      map_add' := fun y z => by
        apply hU _ _ (δ ((y + z : wcRRL Ω K I w C) : K)) (hφ₀ (y + z))
        have := Submodule.add_mem _ (hφ₀ y) (hφ₀ z)
        convert this using 1
        simp only [map_add, Submodule.coe_add]
        abel
      map_smul' := fun r y => by
        apply hU _ _ (δ ((r • y : wcRRL Ω K I w C) : K)) (hφ₀ (r • y))
        have := Submodule.smul_mem _ r (hφ₀ y)
        convert this using 1
        simp only [RingHom.id_apply, map_smul, Submodule.coe_smul, smul_sub] }
  have hLAC : wcRRL Ω K I w A ≤ wcRRL Ω K I w C := (hdim.2.2 A C hAC).1
  have hker : LinearMap.ker φ = (wcRRL Ω K I w A).comap (wcRRL Ω K I w C).subtype := by
    ext y
    rw [LinearMap.mem_ker, Submodule.mem_comap, Submodule.subtype_apply, hmem A]
    constructor
    · intro h
      have := hφ₀ y
      change T (φ y) - δ y ∈ AA A at this
      rw [h, map_zero, zero_sub] at this
      exact neg_mem_iff.mp this
    · intro h
      symm
      apply hU 0 (φ y) (δ y)
      · rw [map_zero, zero_sub]; exact Submodule.neg_mem _ h
      · exact hφ₀ y
  have hrank := LinearMap.finrank_range_add_finrank_ker φ
  have hkerdim : Module.finrank Ω (LinearMap.ker φ) = Module.finrank Ω (wcRRL Ω K I w A) :=
    ((LinearEquiv.ofEq _ _ hker).trans (Submodule.comapSubtypeEquivOfLe hLAC)).finrank_eq
  rw [hkerdim] at hrank

  obtain ⟨V', hc⟩ := Submodule.exists_isCompl (LinearMap.range φ)
  have hdimV := Submodule.finrank_add_eq_of_isCompl hc
  rw [Module.finrank_fin_fun] at hdimV
  have hpush : ∀ c' : Fin (Module.finrank Ω V') → Ω,
      (fun i => ∑ k, c' k • T ((Module.finBasis Ω V' k : V') : Fin n → Ω) i) =
        T (((∑ k, c' k • Module.finBasis Ω V' k : V')) : Fin n → Ω) := by
    intro c'
    rw [Submodule.coe_sum, map_sum]
    funext i
    rw [Finset.sum_apply]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Submodule.coe_smul, map_smul, Pi.smul_apply]
  refine ⟨Module.finrank Ω V', fun k => T ((Module.finBasis Ω V' k : V') : Fin n → Ω),
    ?_, ?_, ?_, ?_⟩
  ·
    have e1 : ((Module.finrank Ω (LinearMap.range φ) : ℕ) : ℤ) + (Module.finrank Ω V' : ℤ)
        = (n : ℤ) := by exact_mod_cast hdimV
    have e2 : ((Module.finrank Ω (LinearMap.range φ) : ℕ) : ℤ) +
        (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) = (Module.finrank Ω (wcRRL Ω K I w C) : ℤ) := by
      exact_mod_cast hrank
    linarith
  · intro k
    exact hadele C _ (hTM _)
  · intro α hα
    obtain ⟨f₁, hf₁⟩ := happrox C hcC α hα
    have hx : α - δ f₁ ∈ AA C := (memAA C _).mpr (fun i => hf₁ i)
    obtain ⟨a, ha⟩ := hex0 _ hx
    have ha' : a ∈ LinearMap.range φ ⊔ V' := by rw [hc.sup_eq_top]; exact Submodule.mem_top
    obtain ⟨s, hs, v, hv, hsv⟩ := Submodule.mem_sup.mp ha'
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hs
    refine ⟨(Module.finBasis Ω V').repr ⟨v, hv⟩, f₁ + y, fun i => ?_⟩
    have hTv : T v = fun i => ∑ k, (Module.finBasis Ω V').repr ⟨v, hv⟩ k •
        T ((Module.finBasis Ω V' k : V') : Fin n → Ω) i := by
      rw [hpush, (Module.finBasis Ω V').sum_repr]
    have key : α - T v - δ (f₁ + (y : K)) = -(T a - (α - δ f₁)) + (T (φ y) - δ y) := by
      rw [← hsv]
      simp only [map_add]
      abel
    have hmemkey : α - T v - δ (f₁ + (y : K)) ∈ AA A := by
      rw [key]; exact Submodule.add_mem _ (Submodule.neg_mem _ ha) (hφ₀ y)
    have := (memAA A _).mp hmemkey i
    rw [hTv] at this
    exact this
  · intro c' f hcf
    have h1 : T (((∑ k, c' k • Module.finBasis Ω V' k : V')) : Fin n → Ω) - δ f ∈ AA A := by
      rw [← hpush c']; exact (memAA A _).mpr (fun i => hcf i)
    have h2 : δ f ∈ AA C := by
      have := Submodule.sub_mem _ (hTM (((∑ k, c' k • Module.finBasis Ω V' k : V')) : Fin n → Ω))
        (hPC h1)
      rwa [sub_sub_cancel] at this
    have hfL : f ∈ wcRRL Ω K I w C := (hmem C f).mpr h2
    have h3 : φ ⟨f, hfL⟩ = (((∑ k, c' k • Module.finBasis Ω V' k : V')) : Fin n → Ω) :=
      hU _ _ (δ f) (hφ₀ ⟨f, hfL⟩) h1
    have h4 : (((∑ k, c' k • Module.finBasis Ω V' k : V')) : Fin n → Ω) = 0 :=
      (Submodule.disjoint_def.mp hc.disjoint) _ (LinearMap.mem_range.mpr ⟨_, h3⟩)
        (Submodule.coe_mem _)
    have h5 : (∑ k, c' k • Module.finBasis Ω V' k : V') = 0 := (Submodule.coe_eq_zero).mp h4
    exact funext (Fintype.linearIndependent_iff.mp (Module.finBasis Ω V').linearIndependent c' h5)

theorem wd_multiple (Ω K I : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hdim : wcRRDim Ω K I w)
    (i₀ : I) (g c : ℕ)
    (hRR : ∀ A : I →₀ ℤ, (c : ℤ) ≤ A.sum (fun _ k => k) →
      FiniteDimensional Ω (wcRRL Ω K I w A) ∧
      (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) = A.sum (fun _ k => k) + 1 - g)
    (hidx : ∀ A : I →₀ ℤ, ∃ (N : ℕ) (γ : Fin N → I → K),
      (N : ℤ) = (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) - A.sum (fun _ k => k) - 1 + g ∧
      (∀ k, {i | ¬ wcValGe K (w i) 0 (γ k i)}.Finite) ∧
      (∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        ∃ (a : Fin N → Ω) (f : K), ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • γ k i - f)) ∧
      (∀ (a : Fin N → Ω) (f : K),
        (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • γ k i - f)) → a = 0))
    (W : I → ℤ) (hW : (Function.support W).Finite) (lam : I → K →ₗ[Ω] Ω)
    (ha : ∀ i (f : K), wcValGe K (w i) (-W i) f → lam i f = 0)
    (hb : ∀ i, ∃ f : Kˣ, w i (Additive.ofMul f) = -W i - 1 ∧ lam i (f : K) ≠ 0)
    (hc : ∀ f : K, ∑ᶠ i, lam i f = 0)
    (A : I →₀ ℤ) (θ : (I → K) → Ω)
    (hθadd : ∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite → θ (α + β) = θ α + θ β)
    (hθsmul : ∀ (a : Ω) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      θ (a • α) = a * θ α)
    (hθA : ∀ α : I → K, (∀ i, wcValGe K (w i) (-A i) (α i)) → θ α = 0)
    (hθK : ∀ f : K, θ (fun _ => f) = 0) :
    ∃ z : K, (∀ i, wcValGe K (w i) (A i - W i) z) ∧
      ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite → θ α = ∑ᶠ i, lam i (z * α i) :=
by
  classical

  have wmul : ∀ i (a b : Kˣ), w i (Additive.ofMul (a * b)) =
      w i (Additive.ofMul a) + w i (Additive.ofMul b) := by
    intro i a b; rw [ofMul_mul, map_add]
  have wone : ∀ i, w i (Additive.ofMul (1 : Kˣ)) = 0 := by
    intro i; rw [ofMul_one, map_zero]
  have wconst : ∀ i (a : Ω) (h : algebraMap Ω K a ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ h)) = 0 := by
    intro i a h
    have ha : a ≠ 0 := fun h0 => h (by rw [h0, map_zero])
    have h' : algebraMap Ω K a⁻¹ ≠ 0 := by
      rw [map_inv₀]; exact inv_ne_zero h
    have e1 := (hw.2.2.2 (Units.mk0 _ h)).mpr ⟨a, rfl⟩ i
    have e2 := (hw.2.2.2 (Units.mk0 _ h')).mpr ⟨a⁻¹, rfl⟩ i
    have e3 : Units.mk0 _ h * Units.mk0 _ h' = 1 := by
      ext; simp [map_inv₀, ha]
    have e4 := wmul i (Units.mk0 _ h) (Units.mk0 _ h')
    rw [e3, wone] at e4
    omega
  have vz : ∀ i (k : ℤ), wcValGe K (w i) k 0 := fun i k => Or.inl rfl
  have vadd : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f + g) := by
    intro i k f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [zero_add]; exact hg
    rcases hg with hg | ⟨hg0, hg⟩
    · subst hg; rw [add_zero]; exact Or.inr ⟨hf0, hf⟩
    by_cases hfg : f + g = 0
    · exact Or.inl hfg
    refine Or.inr ⟨hfg, ?_⟩
    have := hw.1 i (Units.mk0 f hf0) (Units.mk0 g hg0) (Units.mk0 (f + g) hfg) (by simp)
    exact le_trans (le_min hf hg) this
  have vsmul : ∀ i (k : ℤ) (a : Ω) (f : K), wcValGe K (w i) k f →
      wcValGe K (w i) k (a • f) := by
    intro i k a f hf
    by_cases haf : a • f = 0
    · exact Or.inl haf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact absurd (by rw [hf, smul_zero]) haf
    have ha : algebraMap Ω K a ≠ 0 := by
      intro h0; apply haf; rw [Algebra.smul_def, h0, zero_mul]
    have e : Units.mk0 (a • f) haf = Units.mk0 _ ha * Units.mk0 f hf0 := by
      ext; simp [Algebra.smul_def]
    exact Or.inr ⟨haf, by rw [e, wmul, wconst, zero_add]; exact hf⟩
  have vmul : ∀ i (k l : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) l g →
      wcValGe K (w i) (k + l) (f * g) := by
    intro i k l f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · left; rw [hf, zero_mul]
    rcases hg with hg | ⟨hg0, hg⟩
    · left; rw [hg, mul_zero]
    refine Or.inr ⟨mul_ne_zero hf0 hg0, ?_⟩
    have e : Units.mk0 (f * g) (mul_ne_zero hf0 hg0) = Units.mk0 f hf0 * Units.mk0 g hg0 := by
      ext; simp
    rw [e, wmul]; omega

  have adeleOf : ∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      (∀ i, wcValGe K (w i) 0 (α i) → wcValGe K (w i) 0 (β i)) →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite := by
    intro α β hα h
    refine hα.subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq] at hi ⊢
    intro hαi
    exact hi (h i hαi)
  have adeleAdd : ∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite → {i | ¬ wcValGe K (w i) 0 ((α + β) i)}.Finite := by
    intro α β hα hβ
    refine (hα.union hβ).subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq, Set.mem_union] at hi ⊢
    by_contra hc
    push_neg at hc
    exact hi (vadd i 0 _ _ hc.1 hc.2)
  have adeleMul : ∀ (y : K) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (y * α i)}.Finite := by
    intro y α hα
    by_cases hy : y = 0
    · exact adeleOf α _ hα (fun i _ => by rw [hy, zero_mul]; exact vz i 0)
    refine (hα.union (hw.2.1 (Units.mk0 y hy))).subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq] at hi
    rcases Classical.em (wcValGe K (w i) 0 (α i)) with h1 | h1
    · right
      simp only [Set.mem_setOf_eq]
      intro h2
      apply hi
      have hyv : wcValGe K (w i) 0 y := Or.inr ⟨hy, h2.symm.le⟩
      have := vmul i 0 0 _ _ hyv h1
      rwa [zero_add] at this
    · left; exact h1
  have adeleConst : ∀ f : K, {i | ¬ wcValGe K (w i) 0 ((fun _ => f) i)}.Finite := by
    intro f
    by_cases hf : f = 0
    · refine Set.finite_empty.subset ?_
      intro i hi
      simp only [Set.mem_setOf_eq] at hi
      exact (hi (by rw [hf]; exact vz i 0)).elim
    · refine (hw.2.1 (Units.mk0 f hf)).subset ?_
      intro i hi
      simp only [Set.mem_setOf_eq] at hi ⊢
      intro h2
      exact hi (Or.inr ⟨hf, h2.symm.le⟩)
  have adeleA : ∀ (E : I →₀ ℤ) (α : I → K), (∀ i, wcValGe K (w i) (-E i) (α i)) →
      {i | ¬ wcValGe K (w i) 0 (α i)}.Finite := by
    intro E α h
    refine E.support.finite_toSet.subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq] at hi
    rw [Finset.mem_coe, Finsupp.mem_support_iff]
    intro hE
    apply hi
    have := h i
    rwa [hE, neg_zero] at this
  have adeleSingle : ∀ (j : I) (u : K),
      {i | ¬ wcValGe K (w i) 0 ((Pi.single j u : I → K) i)}.Finite := by
    intro j u
    refine (Set.finite_singleton j).subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq] at hi
    rw [Set.mem_singleton_iff]
    by_contra hne
    apply hi
    rw [Pi.single_eq_of_ne hne]
    exact vz i 0
  have FS : ∀ (y : K) (β : I → K), {i | ¬ wcValGe K (w i) 0 (β i)}.Finite →
      Function.HasFiniteSupport (fun i => lam i (y * β i)) := by
    intro y β hβ
    have hyβ := adeleMul y β hβ
    show (Function.support (fun i => lam i (y * β i))).Finite
    refine (hW.union hyβ).subset ?_
    intro i hi
    rw [Function.mem_support] at hi
    by_contra hc
    simp only [Set.mem_union, Function.mem_support, Set.mem_setOf_eq, not_or, not_not] at hc
    exact hi (ha i _ (by rw [hc.1, neg_zero]; exact hc.2))
  have memL : ∀ (E : I →₀ ℤ) (f : K), f ∈ wcRRL Ω K I w E → ∀ i, wcValGe K (w i) (-E i) f := by
    intro E f hf
    let T : Submodule Ω K :=
      { carrier := {f | ∀ i, wcValGe K (w i) (-E i) f}
        add_mem' := fun {f g} hf hg i => vadd i _ f g (hf i) (hg i)
        zero_mem' := fun i => vz i _
        smul_mem' := fun a {f} hf i => vsmul i _ a f (hf i) }
    have hle : wcRRL Ω K I w E ≤ T := by
      unfold wcRRL
      rw [Submodule.span_le]
      intro f' hf'
      obtain ⟨hf0, hfi⟩ := hf'
      show ∀ i, wcValGe K (w i) (-E i) f'
      intro i
      exact Or.inr ⟨hf0, by linarith [hfi i]⟩
    exact hle hf

  obtain ⟨W', hW'def⟩ : ∃ W' : I →₀ ℤ, W' = Finsupp.ofSupportFinite W hW := ⟨_, rfl⟩
  have hW'i : ∀ i, W' i = W i := fun i => by
    rw [hW'def]; exact congrFun Finsupp.ofSupportFinite_coe i
  obtain ⟨dA, hdA⟩ : ∃ d : ℤ, A.sum (fun _ k => k) = d := ⟨_, rfl⟩
  obtain ⟨dW, hdW⟩ : ∃ d : ℤ, W'.sum (fun _ k => k) = d := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℤ,
      M = max (max 1 ((c : ℤ) - dA)) (max ((c : ℤ) - dW) (3 * (g : ℤ) - dA - dW)) := ⟨_, rfl⟩
  have hM1 : 1 ≤ M := by rw [hM]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hM2 : (c : ℤ) - dA ≤ M := by rw [hM]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hM3 : (c : ℤ) - dW ≤ M := by rw [hM]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hM4 : 3 * (g : ℤ) - dA - dW ≤ M := by
    rw [hM]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  obtain ⟨D, hDdef⟩ : ∃ D : I →₀ ℤ, D = -(Finsupp.single i₀ M) := ⟨_, rfl⟩
  have hDle : ∀ i, D i ≤ 0 := by
    intro i
    rw [hDdef, Finsupp.neg_apply, Finsupp.single_apply]
    split_ifs <;> omega
  have hDi0 : D i₀ = -M := by rw [hDdef, Finsupp.neg_apply, Finsupp.single_eq_same]
  have hdegD : D.sum (fun _ k => k) = -M := by
    rw [hDdef, Finsupp.sum_neg_index (fun _ => rfl), Finsupp.sum_single_index (by simp)]
  have hdegsub : ∀ C E : I →₀ ℤ, (C - E).sum (fun _ k => k) =
      C.sum (fun _ k => k) - E.sum (fun _ k => k) :=
    fun C E => Finsupp.sum_sub_index (fun _ _ _ => rfl)
  have hLD : wcRRL Ω K I w D = ⊥ := by
    unfold wcRRL
    rw [Submodule.span_eq_bot]
    intro f hf
    obtain ⟨hf0, hfi⟩ := hf
    exfalso
    have hpos : ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf0)) := fun i => by
      have h1 := hfi i; have h2 := hDle i; linarith
    obtain ⟨c0, hc0⟩ := (hw.2.2.2 (Units.mk0 f hf0)).mp hpos
    have hne : algebraMap Ω K c0 ≠ 0 := by rw [hc0]; exact Units.ne_zero _
    have e1 := wconst i₀ c0 hne
    have e2 : Units.mk0 (algebraMap Ω K c0) hne = Units.mk0 f hf0 := Units.ext hc0
    rw [e2] at e1
    have h3 := hfi i₀
    rw [e1, hDi0] at h3
    linarith
  obtain ⟨N, γ, hNeq, hγ, hspan, -⟩ := hidx D
  have hNval : (N : ℤ) = M - 1 + g := by
    rw [hNeq, hLD, finrank_bot, hdegD]; push_cast; ring
  haveI := hdim.2.1 (A - D)
  haveI := hdim.2.1 (W' - D)
  have hP : (Module.finrank Ω (wcRRL Ω K I w (A - D)) : ℤ) = dA + M + 1 - g := by
    have h := (hRR (A - D) (by rw [hdegsub, hdA, hdegD]; linarith)).2
    rw [h, hdegsub, hdA, hdegD]; ring
  have hQ : (Module.finrank Ω (wcRRL Ω K I w (W' - D)) : ℤ) = dW + M + 1 - g := by
    have h := (hRR (W' - D) (by rw [hdegsub, hdW, hdegD]; linarith)).2
    rw [h, hdegsub, hdW, hdegD]; ring
  have hN : N < Module.finrank Ω (wcRRL Ω K I w (A - D)) +
      Module.finrank Ω (wcRRL Ω K I w (W' - D)) := by
    have : (N : ℤ) < (Module.finrank Ω (wcRRL Ω K I w (A - D)) : ℤ) +
        (Module.finrank Ω (wcRRL Ω K I w (W' - D)) : ℤ) := by
      rw [hNval, hP, hQ]; linarith
    exact_mod_cast this

  let FL : K →ₗ[Ω] (Fin N → Ω) :=
    { toFun := fun x k => θ (fun i => x * γ k i)
      map_add' := by
        intro x x'
        funext k
        have e : (fun i => (x + x') * γ k i) = (fun i => x * γ k i) + (fun i => x' * γ k i) := by
          funext i; simp only [Pi.add_apply]; ring
        simp only [Pi.add_apply]
        rw [e, hθadd _ _ (adeleMul x _ (hγ k)) (adeleMul x' _ (hγ k))]
      map_smul' := by
        intro a x
        funext k
        have e : (fun i => (a • x) * γ k i) = a • (fun i => x * γ k i) := by
          funext i; simp only [Pi.smul_apply]; rw [smul_mul_assoc]
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
        rw [e, hθsmul _ _ (adeleMul x _ (hγ k))] }
  let GLm : K →ₗ[Ω] (Fin N → Ω) :=
    { toFun := fun y k => ∑ᶠ i, lam i (y * γ k i)
      map_add' := by
        intro y y'
        funext k
        simp only [Pi.add_apply]
        rw [← finsum_add_distrib (FS y _ (hγ k)) (FS y' _ (hγ k))]
        apply finsum_congr
        intro i
        rw [add_mul, map_add]
      map_smul' := by
        intro a y
        funext k
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
        rw [mul_finsum]
        apply finsum_congr
        intro i
        rw [smul_mul_assoc, map_smul, smul_eq_mul] }
  obtain ⟨x, hxP, y, hyQ, hxy, hFG⟩ : ∃ x ∈ wcRRL Ω K I w (A - D), ∃ y ∈ wcRRL Ω K I w (W' - D),
      (x ≠ 0 ∨ y ≠ 0) ∧ ∀ k, θ (fun i => x * γ k i) + ∑ᶠ i, lam i (y * γ k i) = 0 := by
    let Φ := (FL.comp (wcRRL Ω K I w (A - D)).subtype).coprod
      (GLm.comp (wcRRL Ω K I w (W' - D)).subtype)
    have hker : LinearMap.ker Φ ≠ ⊥ := LinearMap.ker_ne_bot_of_finrank_lt
      (by rw [Module.finrank_prod, Module.finrank_fin_fun]; exact hN)
    obtain ⟨p, hp, hp0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
    rw [LinearMap.mem_ker, LinearMap.coprod_apply] at hp
    refine ⟨p.1, p.1.2, p.2, p.2.2, ?_, fun k => ?_⟩
    · by_contra hc
      push_neg at hc
      exact hp0 (Prod.ext (Subtype.ext hc.1) (Subtype.ext hc.2))
    · exact congrFun hp k
  have hx' : ∀ i, wcValGe K (w i) (-A i + D i) x := by
    intro i
    have h := memL _ _ hxP i
    have e : -((A - D) i) = -A i + D i := by rw [Finsupp.sub_apply]; ring
    rw [e] at h; exact h
  have hy' : ∀ i, wcValGe K (w i) (-W i + D i) y := by
    intro i
    have h := memL _ _ hyQ i
    have e : -((W' - D) i) = -W i + D i := by rw [Finsupp.sub_apply, hW'i]; ring
    rw [e] at h; exact h

  obtain ⟨ψ, hψdef⟩ : ∃ ψ : (I → K) → Ω,
      ∀ α, ψ α = θ (fun i => x * α i) + ∑ᶠ i, lam i (y * α i) := ⟨_, fun _ => rfl⟩
  have hψadd : ∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite → ψ (α + β) = ψ α + ψ β := by
    intro α β hα hβ
    rw [hψdef, hψdef, hψdef]
    have e1 : (fun i => x * (α + β) i) = (fun i => x * α i) + (fun i => x * β i) := by
      funext i; simp only [Pi.add_apply]; ring
    rw [e1, hθadd _ _ (adeleMul x α hα) (adeleMul x β hβ)]
    have e2 : ∑ᶠ i, lam i (y * (α + β) i) =
        ∑ᶠ i, lam i (y * α i) + ∑ᶠ i, lam i (y * β i) := by
      rw [← finsum_add_distrib (FS y α hα) (FS y β hβ)]
      apply finsum_congr
      intro i
      rw [Pi.add_apply, mul_add, map_add]
    rw [e2]; ring
  have hψsmul : ∀ (a : Ω) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      ψ (a • α) = a * ψ α := by
    intro a α hα
    rw [hψdef, hψdef]
    have e1 : (fun i => x * (a • α) i) = a • (fun i => x * α i) := by
      funext i; simp only [Pi.smul_apply]; rw [mul_smul_comm]
    rw [e1, hθsmul _ _ (adeleMul x α hα)]
    have e2 : ∑ᶠ i, lam i (y * (a • α) i) = a * ∑ᶠ i, lam i (y * α i) := by
      rw [mul_finsum]
      apply finsum_congr
      intro i
      rw [Pi.smul_apply, mul_smul_comm, map_smul, smul_eq_mul]
    rw [e2]; ring
  have hψD : ∀ α : I → K, (∀ i, wcValGe K (w i) (-D i) (α i)) → ψ α = 0 := by
    intro α hα
    rw [hψdef]
    have h1 : θ (fun i => x * α i) = 0 := hθA _ (fun i => by
      have := vmul i _ _ _ _ (hx' i) (hα i)
      rwa [show -A i + D i + -D i = -A i by ring] at this)
    have h2 : ∑ᶠ i, lam i (y * α i) = 0 := finsum_eq_zero_of_forall_eq_zero (fun i => ha i _ (by
      have := vmul i _ _ _ _ (hy' i) (hα i)
      rwa [show -W i + D i + -D i = -W i by ring] at this))
    rw [h1, h2, add_zero]
  have hψK : ∀ f : K, ψ (fun _ => f) = 0 := by
    intro f
    rw [hψdef]
    show θ (fun _ => x * f) + ∑ᶠ i, lam i (y * f) = 0
    rw [hθK, hc, add_zero]
  have hψγ : ∀ k, ψ (γ k) = 0 := fun k => by rw [hψdef]; exact hFG k

  have hψ0 : ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite → ψ α = 0 := by
    intro α hα
    obtain ⟨a, f, hres⟩ := hspan α hα
    have hpart : ∀ s : Finset (Fin N), {i | ¬ wcValGe K (w i) 0 (∑ j ∈ s, a j • γ j i)}.Finite ∧
        ψ (fun i => ∑ j ∈ s, a j • γ j i) = 0 := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        simp only [Finset.sum_empty]
        exact ⟨adeleConst 0, hψK 0⟩
      | insert k s hks ih =>
        have e : (fun i => ∑ j ∈ insert k s, a j • γ j i) =
            a k • γ k + (fun i => ∑ j ∈ s, a j • γ j i) := by
          funext i
          simp only [Finset.sum_insert hks, Pi.add_apply, Pi.smul_apply]
        have hak : {i | ¬ wcValGe K (w i) 0 ((a k • γ k) i)}.Finite :=
          adeleOf (γ k) _ (hγ k) (fun i h => vsmul i 0 (a k) (γ k i) h)
        have hadd := adeleAdd _ _ hak ih.1
        refine ⟨?_, ?_⟩
        · have e' : ∀ i, (∑ j ∈ insert k s, a j • γ j i) =
              (a k • γ k + (fun i => ∑ j ∈ s, a j • γ j i)) i := fun i => congrFun e i
          simp only [e']
          exact hadd
        · rw [e, hψadd _ _ hak ih.1, hψsmul _ _ (hγ k), hψγ k, ih.2]; ring
    have hS := hpart Finset.univ
    have hr : {i | ¬ wcValGe K (w i) 0 (α i - ∑ k, a k • γ k i - f)}.Finite := adeleA D _ hres
    have e : α = (fun i => α i - ∑ k, a k • γ k i - f) +
        ((fun i => ∑ k, a k • γ k i) + (fun _ => f)) := by
      funext i; simp only [Pi.add_apply]; ring
    rw [e, hψadd _ _ hr (adeleAdd _ _ hS.1 (adeleConst f)), hψadd _ _ hS.1 (adeleConst f),
      hψD _ hres, hS.2, hψK, add_zero, add_zero]

  have hx : x ≠ 0 := by
    intro hx0
    have hy : y ≠ 0 := hxy.resolve_left (not_not.mpr hx0)
    obtain ⟨f0, -, hf0l⟩ := hb i₀
    have h1 := hψ0 _ (adeleSingle i₀ ((f0 : K) * y⁻¹))
    rw [hψdef, hx0] at h1
    simp only [zero_mul] at h1
    rw [hθK 0, zero_add, finsum_eq_single
      (fun i => lam i (y * (Pi.single i₀ ((f0 : K) * y⁻¹) : I → K) i))
      i₀ (fun i hi => by rw [Pi.single_eq_of_ne hi, mul_zero, map_zero]), Pi.single_eq_same,
      mul_comm (f0 : K) y⁻¹, mul_inv_cancel_left₀ hy] at h1
    exact hf0l h1

  obtain ⟨z, hzdef⟩ : ∃ z : K, z = -(y * x⁻¹) := ⟨_, rfl⟩
  have hrep : ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      θ α = ∑ᶠ i, lam i (z * α i) := by
    intro α hα
    have h : θ (fun i => x * (x⁻¹ * α i)) + ∑ᶠ i, lam i (y * (x⁻¹ * α i)) = 0 := by
      have := hψ0 _ (adeleMul x⁻¹ α hα); rw [hψdef] at this; exact this
    have e : (fun i => x * (x⁻¹ * α i)) = α := by funext i; rw [mul_inv_cancel_left₀ hx]
    rw [e] at h
    rw [eq_neg_of_add_eq_zero_left h, ← finsum_neg_distrib]
    apply finsum_congr
    intro i
    rw [hzdef, show -(y * x⁻¹) * α i = -(y * (x⁻¹ * α i)) by ring, map_neg]
  refine ⟨z, ?_, hrep⟩
  intro j
  by_cases hz0 : z = 0
  · exact Or.inl hz0
  by_contra hcon
  have hlt : w j (Additive.ofMul (Units.mk0 z hz0)) < A j - W j := by
    by_contra h'
    push_neg at h'
    exact hcon (Or.inr ⟨hz0, h'⟩)
  obtain ⟨f0, hf0w, hf0l⟩ := hb j
  obtain ⟨u, hu⟩ : ∃ u : Kˣ, u = f0 * (Units.mk0 z hz0)⁻¹ := ⟨_, rfl⟩
  have hwu : w j (Additive.ofMul u) =
      w j (Additive.ofMul f0) - w j (Additive.ofMul (Units.mk0 z hz0)) := by
    rw [hu, wmul, ofMul_inv, map_neg]; ring
  have hαA : ∀ i, wcValGe K (w i) (-A i) ((Pi.single j (u : K) : I → K) i) := by
    intro i
    by_cases hij : i = j
    · subst hij
      rw [Pi.single_eq_same]
      exact Or.inr ⟨u.ne_zero, by rw [Units.mk0_val]; omega⟩
    · rw [Pi.single_eq_of_ne hij]; exact vz i _
  have e : z * (u : K) = f0 := by
    rw [hu, Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0, mul_comm (f0 : K) z⁻¹,
      mul_inv_cancel_left₀ hz0]
  have h1 := hrep _ (adeleSingle j (u : K))
  rw [hθA _ hαA, finsum_eq_single (fun i => lam i (z * (Pi.single j (u : K) : I → K) i)) j
    (fun i hi => by rw [Pi.single_eq_of_ne hi, mul_zero, map_zero]), Pi.single_eq_same, e] at h1
  exact hf0l h1.symm

theorem wd_duality (Ω K I : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hdim : wcRRDim Ω K I w)
    (i₀ : I) (g : ℕ)
    (hidx : ∀ A : I →₀ ℤ, ∃ (N : ℕ) (γ : Fin N → I → K),
      (N : ℤ) = (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) - A.sum (fun _ k => k) - 1 + g ∧
      (∀ k, {i | ¬ wcValGe K (w i) 0 (γ k i)}.Finite) ∧
      (∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        ∃ (a : Fin N → Ω) (f : K), ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • γ k i - f)) ∧
      (∀ (a : Fin N → Ω) (f : K),
        (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • γ k i - f)) → a = 0))
    (W : I → ℤ) (hW : (Function.support W).Finite) (lam : I → K →ₗ[Ω] Ω)
    (ha : ∀ i (f : K), wcValGe K (w i) (-W i) f → lam i f = 0)
    (hb : ∀ i, ∃ f : Kˣ, w i (Additive.ofMul f) = -W i - 1 ∧ lam i (f : K) ≠ 0)
    (hc : ∀ f : K, ∑ᶠ i, lam i f = 0)
    (hmult : ∀ (A : I →₀ ℤ) (θ : (I → K) → Ω),
      (∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        {i | ¬ wcValGe K (w i) 0 (β i)}.Finite → θ (α + β) = θ α + θ β) →
      (∀ (a : Ω) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        θ (a • α) = a * θ α) →
      (∀ α : I → K, (∀ i, wcValGe K (w i) (-A i) (α i)) → θ α = 0) →
      (∀ f : K, θ (fun _ => f) = 0) →
      ∃ z : K, (∀ i, wcValGe K (w i) (A i - W i) z) ∧
        ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite → θ α = ∑ᶠ i, lam i (z * α i))
    (A : I →₀ ℤ) :
    (Module.finrank Ω (wcRRL Ω K I w (Finsupp.ofSupportFinite W hW - A)) : ℤ) =
      (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) - A.sum (fun _ k => k) - 1 + g :=
by
  classical

  have wmul : ∀ i (a b : Kˣ), w i (Additive.ofMul (a * b)) =
      w i (Additive.ofMul a) + w i (Additive.ofMul b) := by
    intro i a b; rw [ofMul_mul, map_add]
  have wone : ∀ i, w i (Additive.ofMul (1 : Kˣ)) = 0 := by
    intro i; rw [ofMul_one, map_zero]
  have wconst : ∀ i (a : Ω) (h : algebraMap Ω K a ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ h)) = 0 := by
    intro i a h
    have ha : a ≠ 0 := fun h0 => h (by rw [h0, map_zero])
    have h' : algebraMap Ω K a⁻¹ ≠ 0 := by
      rw [map_inv₀]; exact inv_ne_zero h
    have e1 := (hw.2.2.2 (Units.mk0 _ h)).mpr ⟨a, rfl⟩ i
    have e2 := (hw.2.2.2 (Units.mk0 _ h')).mpr ⟨a⁻¹, rfl⟩ i
    have e3 : Units.mk0 _ h * Units.mk0 _ h' = 1 := by
      ext; simp [map_inv₀, ha]
    have e4 := wmul i (Units.mk0 _ h) (Units.mk0 _ h')
    rw [e3, wone] at e4
    omega
  have vz : ∀ i (k : ℤ), wcValGe K (w i) k 0 := fun i k => Or.inl rfl
  have vadd : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f + g) := by
    intro i k f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [zero_add]; exact hg
    rcases hg with hg | ⟨hg0, hg⟩
    · subst hg; rw [add_zero]; exact Or.inr ⟨hf0, hf⟩
    by_cases hfg : f + g = 0
    · exact Or.inl hfg
    refine Or.inr ⟨hfg, ?_⟩
    have := hw.1 i (Units.mk0 f hf0) (Units.mk0 g hg0) (Units.mk0 (f + g) hfg) (by simp)
    exact le_trans (le_min hf hg) this
  have wneg1 : ∀ i (f : K) (hf : f ≠ 0) (hf' : -f ≠ 0),
      w i (Additive.ofMul (Units.mk0 (-f) hf')) = w i (Additive.ofMul (Units.mk0 f hf)) := by
    intro i f hf hf'
    have h1 : algebraMap Ω K (-1) ≠ 0 := by simp
    have e : Units.mk0 (-f) hf' = Units.mk0 _ h1 * Units.mk0 f hf := by ext; simp
    rw [e, wmul, wconst, zero_add]
  have vneg : ∀ i (k : ℤ) (f : K), wcValGe K (w i) k f → wcValGe K (w i) k (-f) := by
    intro i k f hf
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [neg_zero]; exact vz i k
    have hf' : -f ≠ 0 := neg_ne_zero.mpr hf0
    exact Or.inr ⟨hf', by rw [wneg1 i f hf0 hf']; exact hf⟩
  have vsub : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f - g) := by
    intro i k f g hf hg
    rw [sub_eq_add_neg]; exact vadd i k f (-g) hf (vneg i k g hg)
  have vsmul : ∀ i (k : ℤ) (a : Ω) (f : K), wcValGe K (w i) k f →
      wcValGe K (w i) k (a • f) := by
    intro i k a f hf
    by_cases haf : a • f = 0
    · exact Or.inl haf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact absurd (by rw [hf, smul_zero]) haf
    have ha : algebraMap Ω K a ≠ 0 := by
      intro h0; apply haf; rw [Algebra.smul_def, h0, zero_mul]
    have e : Units.mk0 (a • f) haf = Units.mk0 _ ha * Units.mk0 f hf0 := by
      ext; simp [Algebra.smul_def]
    exact Or.inr ⟨haf, by rw [e, wmul, wconst, zero_add]; exact hf⟩
  have vmul : ∀ i (k l : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) l g →
      wcValGe K (w i) (k + l) (f * g) := by
    intro i k l f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · left; rw [hf, zero_mul]
    rcases hg with hg | ⟨hg0, hg⟩
    · left; rw [hg, mul_zero]
    refine Or.inr ⟨mul_ne_zero hf0 hg0, ?_⟩
    have e : Units.mk0 (f * g) (mul_ne_zero hf0 hg0) = Units.mk0 f hf0 * Units.mk0 g hg0 := by
      ext; simp
    rw [e, wmul]; omega
  have vsum : ∀ i (k : ℤ) {n : ℕ} (a : Fin n → Ω) (β : Fin n → I → K),
      (∀ m, wcValGe K (w i) k (β m i)) → wcValGe K (w i) k (∑ m, a m • β m i) := by
    intro i k n a β hβ
    exact Finset.sum_induction _ (fun x => wcValGe K (w i) k x)
      (fun x y hx hy => vadd i k x y hx hy) (vz i k)
      (fun m _ => vsmul i k (a m) (β m i) (hβ m))
  have memL : ∀ (D : I →₀ ℤ) (f : K), f ∈ wcRRL Ω K I w D ↔ ∀ i, wcValGe K (w i) (-D i) f := by
    intro D f
    constructor
    · intro hf
      unfold wcRRL at hf
      induction hf using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨hx0, hx⟩ := hx
        intro i
        exact Or.inr ⟨hx0, by have := hx i; omega⟩
      | zero => intro i; exact vz i _
      | add x y _ _ hx hy => intro i; exact vadd i _ _ _ (hx i) (hy i)
      | smul a x _ hx => intro i; exact vsmul i _ a x (hx i)
    · intro hf
      by_cases h0 : f = 0
      · rw [h0]; exact Submodule.zero_mem _
      · unfold wcRRL
        apply Submodule.subset_span
        refine ⟨h0, fun i => ?_⟩
        rcases hf i with h | ⟨h', hle⟩
        · exact absurd h h0
        · have hle' : -D i ≤ w i (Additive.ofMul (Units.mk0 f h0)) := hle
          omega

  have adA : ∀ (C : I →₀ ℤ) (α : I → K), (∀ i, wcValGe K (w i) (-C i) (α i)) →
      {i | ¬ wcValGe K (w i) 0 (α i)}.Finite := by
    intro C α hα
    refine (C.support.finite_toSet).subset ?_
    intro i hi
    rw [Finset.mem_coe, Finsupp.mem_support_iff]
    intro h0
    apply hi
    have := hα i
    rwa [h0, neg_zero] at this
  have adadd : ∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 ((α + β) i)}.Finite := by
    intro α β hα hβ
    refine (hα.union hβ).subset ?_
    intro i hi
    by_contra hc
    simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at hc
    exact hi (vadd i 0 _ _ hc.1 hc.2)
  have adsmul : ∀ (a : Ω) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 ((a • α) i)}.Finite := by
    intro a α hα
    refine hα.subset ?_
    intro i hi
    by_contra hc
    simp only [Set.mem_setOf_eq, not_not] at hc
    exact hi (vsmul i 0 a _ hc)
  have admul : ∀ (y : K) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (y * α i)}.Finite := by
    intro y α hα
    by_cases hy : y = 0
    · refine Set.finite_empty.subset ?_
      intro i hi
      apply hi
      rw [hy, zero_mul]; exact vz i 0
    · refine (hα.union (hw.2.1 (Units.mk0 y hy))).subset ?_
      intro i hi
      by_contra hc
      simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at hc
      apply hi
      have hy0 : wcValGe K (w i) 0 y := Or.inr ⟨hy, le_of_eq hc.2.symm⟩
      have := vmul i 0 0 _ _ hy0 hc.1
      rwa [add_zero] at this
  have adconst : ∀ f : K, {i | ¬ wcValGe K (w i) 0 f}.Finite := by
    intro f
    by_cases hf : f = 0
    · refine Set.finite_empty.subset ?_
      intro i hi
      apply hi
      rw [hf]; exact vz i 0
    · refine (hw.2.1 (Units.mk0 f hf)).subset ?_
      intro i hi
      by_contra hc
      simp only [Set.mem_setOf_eq, not_not] at hc
      exact hi (Or.inr ⟨hf, le_of_eq hc.symm⟩)
  have adsum : ∀ {n : ℕ} (c : Fin n → Ω) (β : Fin n → I → K),
      (∀ p, {i | ¬ wcValGe K (w i) 0 (β p i)}.Finite) →
      {i | ¬ wcValGe K (w i) 0 (∑ p, c p • β p i)}.Finite := by
    intro n c β hβ
    refine (Set.finite_iUnion hβ).subset ?_
    intro i hi
    rw [Set.mem_iUnion]
    by_contra hc
    push_neg at hc
    exact hi (vsum i 0 c β (fun p => by by_contra h; exact hc p h))

  have esupp : ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      (Function.support (fun i => lam i (α i))).Finite := by
    intro α hα
    refine (hW.union hα).subset ?_
    intro i hi
    rw [Function.mem_support] at hi
    by_contra hc
    simp only [Set.mem_union, Function.mem_support, Set.mem_setOf_eq, not_or, not_not] at hc
    apply hi
    apply ha
    rw [hc.1, neg_zero]; exact hc.2
  have eadd : ∀ α β : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite →
      ∑ᶠ i, lam i (α i + β i) = ∑ᶠ i, lam i (α i) + ∑ᶠ i, lam i (β i) := by
    intro α β hα hβ
    simp only [map_add]
    exact finsum_add_distrib (esupp α hα) (esupp β hβ)
  have esmul : ∀ (a : Ω) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      ∑ᶠ i, lam i (a • α i) = a * ∑ᶠ i, lam i (α i) := by
    intro a α _
    simp only [map_smul, smul_eq_mul]
    rw [mul_finsum]
  have esum : ∀ (n : ℕ) (c : Fin n → Ω) (β : Fin n → I → K),
      (∀ p, {i | ¬ wcValGe K (w i) 0 (β p i)}.Finite) →
      ∑ᶠ i, lam i (∑ p, c p • β p i) = ∑ p, c p * ∑ᶠ i, lam i (β p i) := by
    intro n c β hβ
    simp only [map_sum, map_smul, smul_eq_mul]
    rw [finsum_sum_comm]
    · refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [mul_finsum]
    · intro p _
      refine (esupp _ (hβ p)).subset ?_
      intro i hi
      rw [Function.mem_support] at hi ⊢
      intro h
      apply hi
      rw [h, mul_zero]

  obtain ⟨N, γ, hN, hγ, hex, huniq⟩ := hidx A
  set B : I →₀ ℤ := Finsupp.ofSupportFinite W hW - A with hBdef
  have hB : ∀ i, B i = W i - A i := by
    intro i
    rw [hBdef, Finsupp.sub_apply]
    rw [congrFun Finsupp.ofSupportFinite_coe i]

  let Φ : K →ₗ[Ω] (Fin N → Ω) :=
    { toFun := fun y k => ∑ᶠ i, lam i (y * γ k i)
      map_add' := by
        intro y y'
        funext k
        simp only [Pi.add_apply, add_mul]
        exact eadd (fun i => y * γ k i) (fun i => y' * γ k i)
          (admul y _ (hγ k)) (admul y' _ (hγ k))
      map_smul' := by
        intro a y
        funext k
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, smul_mul_assoc]
        exact esmul a (fun i => y * γ k i) (admul y _ (hγ k)) }
  have hinj : Function.Injective (Φ.domRestrict (wcRRL Ω K I w B)) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro y hy
    have hyB := (memL B (y : K)).mp y.2
    have h0 : ∀ k, ∑ᶠ i, lam i ((y : K) * γ k i) = 0 := fun k => congrFun hy k
    have hall : ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        ∑ᶠ i, lam i ((y : K) * α i) = 0 := by
      intro α hα
      obtain ⟨a, f, hx⟩ := hex α hα
      have hxad := adA A _ hx
      have e : ∀ i, (y : K) * α i = (y : K) * (α i - ∑ k, a k • γ k i - f) +
          (∑ k, a k • ((y : K) * γ k i) + (y : K) * f) := by
        intro i
        have : (y : K) * ∑ k, a k • γ k i = ∑ k, a k • ((y : K) * γ k i) := by
          rw [Finset.mul_sum]; simp only [mul_smul_comm]
        rw [mul_sub, mul_sub, this]; ring
      have hS : {i | ¬ wcValGe K (w i) 0 (∑ k, a k • ((y : K) * γ k i))}.Finite :=
        adsum a (fun k i => (y : K) * γ k i) (fun k => admul _ _ (hγ k))
      have hX : ∑ᶠ i, lam i ((y : K) * (α i - ∑ k, a k • γ k i - f)) = 0 := by
        have : ∀ i, lam i ((y : K) * (α i - ∑ k, a k • γ k i - f)) = 0 := by
          intro i
          apply ha
          have := vmul i _ _ _ _ (hyB i) (hx i)
          rwa [hB i, show -(W i - A i) + -A i = -W i by ring] at this
        rw [finsum_congr this, finsum_zero]
      have hSz : ∑ᶠ i, lam i (∑ k, a k • ((y : K) * γ k i)) = 0 := by
        rw [esum N a (fun k i => (y : K) * γ k i) (fun k => admul _ _ (hγ k))]
        simp only [h0, mul_zero, Finset.sum_const_zero]
      rw [finsum_congr (fun i => congrArg (lam i) (e i))]
      rw [eadd (fun i => (y : K) * (α i - ∑ k, a k • γ k i - f))
        (fun i => ∑ k, a k • ((y : K) * γ k i) + (y : K) * f) (admul _ _ hxad)
        (adadd (fun i => ∑ k, a k • ((y : K) * γ k i)) (fun _ => (y : K) * f) hS
          (adconst _))]
      rw [eadd (fun i => ∑ k, a k • ((y : K) * γ k i)) (fun _ => (y : K) * f) hS
        (adconst _)]
      rw [hX, hSz, hc]; ring
    have hy0 : (y : K) = 0 := by
      by_contra hne
      obtain ⟨f, _, hf2⟩ := hb i₀
      have hα : {i | ¬ wcValGe K (w i) 0
          ((Pi.single i₀ ((f : K) * (y : K)⁻¹) : I → K) i)}.Finite := by
        refine (Set.finite_singleton i₀).subset ?_
        intro i hi
        by_contra hne'
        apply hi
        have hne'' : i ≠ i₀ := hne'
        rw [Pi.single_apply, if_neg hne'']
        exact vz i 0
      have e1 : ∑ᶠ i, lam i ((y : K) * (Pi.single i₀ ((f : K) * (y : K)⁻¹) : I → K) i) =
          lam i₀ (f : K) := by
        rw [finsum_eq_single _ i₀]
        · rw [Pi.single_eq_same]
          congr 1
          rw [mul_comm, mul_assoc, inv_mul_cancel₀ hne, mul_one]
        · intro i hi
          rw [Pi.single_apply, if_neg hi, mul_zero, map_zero]
      exact hf2 (e1 ▸ hall _ hα)
    exact (Submodule.coe_eq_zero).mp hy0
  have hup : Module.finrank Ω (wcRRL Ω K I w B) ≤ N := by
    have := LinearMap.finrank_le_finrank_of_injective hinj
    rwa [Module.finrank_fin_fun] at this

  let coef : (I → K) → (Fin N → Ω) := fun α =>
    if h : {i | ¬ wcValGe K (w i) 0 (α i)}.Finite then Classical.choose (hex α h) else 0
  have coef_spec : ∀ α (h : {i | ¬ wcValGe K (w i) 0 (α i)}.Finite), ∃ f : K,
      ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, coef α k • γ k i - f) := by
    intro α h
    have : coef α = Classical.choose (hex α h) := dif_pos h
    rw [this]; exact Classical.choose_spec (hex α h)
  have U : ∀ α, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite → ∀ (a : Fin N → Ω) (f : K),
      (∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • γ k i - f)) → coef α = a := by
    intro α h a f hv
    obtain ⟨f', hv'⟩ := coef_spec α h
    have := huniq (a - coef α) (f' - f) (fun i => by
      have e : ∑ k, (a - coef α) k • γ k i - (f' - f) =
          (α i - ∑ k, coef α k • γ k i - f') - (α i - ∑ k, a k • γ k i - f) := by
        simp only [Pi.sub_apply, sub_smul, Finset.sum_sub_distrib]; ring
      rw [e]; exact vsub i _ _ _ (hv' i) (hv i))
    exact (sub_eq_zero.mp this).symm
  have θadd : ∀ k (α β : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      {i | ¬ wcValGe K (w i) 0 (β i)}.Finite → coef (α + β) k = coef α k + coef β k := by
    intro k α β hα hβ
    obtain ⟨fα, hfα⟩ := coef_spec α hα
    obtain ⟨fβ, hfβ⟩ := coef_spec β hβ
    have := U (α + β) (adadd α β hα hβ) (coef α + coef β) (fα + fβ) (fun i => by
      have e : (α + β) i - ∑ k, (coef α + coef β) k • γ k i - (fα + fβ) =
          (α i - ∑ k, coef α k • γ k i - fα) + (β i - ∑ k, coef β k • γ k i - fβ) := by
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]; ring
      rw [e]; exact vadd i _ _ _ (hfα i) (hfβ i))
    rw [this, Pi.add_apply]
  have θsmul : ∀ k (a : Ω) (α : I → K), {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
      coef (a • α) k = a * coef α k := by
    intro k a α hα
    obtain ⟨fα, hfα⟩ := coef_spec α hα
    have := U (a • α) (adsmul a α hα) (a • coef α) (a • fα) (fun i => by
      have e : (a • α) i - ∑ k, (a • coef α) k • γ k i - a • fα =
          a • (α i - ∑ k, coef α k • γ k i - fα) := by
        simp only [Pi.smul_apply, smul_eq_mul, smul_sub, Finset.smul_sum, mul_smul]
      rw [e]; exact vsmul i _ a _ (hfα i))
    rw [this, Pi.smul_apply, smul_eq_mul]
  have θA : ∀ k (α : I → K), (∀ i, wcValGe K (w i) (-A i) (α i)) → coef α k = 0 := by
    intro k α hα
    have := U α (adA A α hα) 0 0 (fun i => by
      simp only [Pi.zero_apply, zero_smul, Finset.sum_const_zero, sub_zero]; exact hα i)
    rw [this, Pi.zero_apply]
  have θK : ∀ k (f : K), coef (fun _ => f) k = 0 := by
    intro k f
    have := U (fun _ => f) (adconst f) 0 f (fun i => by
      simp only [Pi.zero_apply, zero_smul, Finset.sum_const_zero, sub_zero, sub_self]
      exact vz i _)
    rw [this, Pi.zero_apply]
  have θγ : ∀ k l, coef (γ l) k = if k = l then 1 else 0 := by
    intro k l
    have := U (γ l) (hγ l) (Pi.single l 1) 0 (fun i => by
      have hs : ∑ k, (Pi.single l (1 : Ω) : Fin N → Ω) k • γ k i = γ l i := by
        rw [Finset.sum_eq_single l]
        · rw [Pi.single_eq_same, one_smul]
        · intro b _ hb
          rw [Pi.single_apply, if_neg hb, zero_smul]
        · intro hl; exact absurd (Finset.mem_univ l) hl
      rw [hs, sub_self, sub_zero]; exact vz i _)
    rw [this, Pi.single_apply]
  have hz : ∀ k : Fin N, ∃ z : K, (∀ i, wcValGe K (w i) (A i - W i) z) ∧
      ∀ α : I → K, {i | ¬ wcValGe K (w i) 0 (α i)}.Finite →
        coef α k = ∑ᶠ i, lam i (z * α i) := fun k =>
    hmult A (fun α => coef α k) (θadd k) (θsmul k) (θA k) (θK k)
  choose z hzL hzθ using hz
  have hzmem : ∀ k, z k ∈ wcRRL Ω K I w B := by
    intro k
    refine (memL B (z k)).mpr (fun i => ?_)
    rw [hB i, neg_sub]; exact hzL k i
  let Z : Fin N → wcRRL Ω K I w B := fun k => ⟨z k, hzmem k⟩
  have hli : LinearIndependent Ω Z := by
    rw [Fintype.linearIndependent_iff]
    intro c hc l
    have hc' : ∑ k, c k • z k = 0 := by
      have := congrArg Subtype.val hc
      simpa [Z] using this
    have e1 : ∑ᶠ i, lam i ((∑ k, c k • z k) * γ l i) = 0 := by
      rw [hc']; simp
    have e2 : ∑ᶠ i, lam i ((∑ k, c k • z k) * γ l i) =
        ∑ k, c k * ∑ᶠ i, lam i (z k * γ l i) := by
      rw [← esum N c (fun k i => z k * γ l i) (fun k => admul (z k) _ (hγ l))]
      refine finsum_congr (fun i => ?_)
      rw [Finset.sum_mul]
      simp only [smul_mul_assoc]
    have e3 : ∑ k, c k * ∑ᶠ i, lam i (z k * γ l i) = c l := by
      rw [Finset.sum_congr rfl (fun k _ => by rw [← hzθ k (γ l) (hγ l), θγ k l])]
      simp
    rw [← e3, ← e2, e1]
  have hlo : N ≤ Module.finrank Ω (wcRRL Ω K I w B) := by
    haveI := hdim.2.1 B
    have := hli.fintype_card_le_finrank
    rwa [Fintype.card_fin] at this
  rw [le_antisymm hup hlo]
  exact hN

theorem wcpa_dj_cdp_cd_weil_degree (Ω K I : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hR : wcRRResidue Ω K I w)
    (hdim : wcRRDim Ω K I w) (i₀ : I) (g c : ℕ)
    (hRR : ∀ A : I →₀ ℤ, (c : ℤ) ≤ A.sum (fun _ k => k) →
      FiniteDimensional Ω (wcRRL Ω K I w A) ∧
      (Module.finrank Ω (wcRRL Ω K I w A) : ℤ) = A.sum (fun _ k => k) + 1 - g)
    (W : I → ℤ) (hW : (Function.support W).Finite) (lam : I → K →ₗ[Ω] Ω)
    (ha : ∀ i (f : K), wcValGe K (w i) (-W i) f → lam i f = 0)
    (hb : ∀ i, ∃ f : Kˣ, w i (Additive.ofMul f) = -W i - 1 ∧ lam i (f : K) ≠ 0)
    (hc : ∀ f : K, ∑ᶠ i, lam i f = 0) :
    ∑ᶠ i, W i = 2 * (g : ℤ) - 2 :=
by
  classical

  have wmul : ∀ i (a b : Kˣ), w i (Additive.ofMul (a * b)) =
      w i (Additive.ofMul a) + w i (Additive.ofMul b) := by
    intro i a b; rw [ofMul_mul, map_add]
  have wone : ∀ i, w i (Additive.ofMul (1 : Kˣ)) = 0 := by
    intro i; rw [ofMul_one, map_zero]
  have wconst : ∀ i (a : Ω) (h : algebraMap Ω K a ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ h)) = 0 := by
    intro i a h
    have ha : a ≠ 0 := fun h0 => h (by rw [h0, map_zero])
    have h' : algebraMap Ω K a⁻¹ ≠ 0 := by
      rw [map_inv₀]; exact inv_ne_zero h
    have e1 := (hw.2.2.2 (Units.mk0 _ h)).mpr ⟨a, rfl⟩ i
    have e2 := (hw.2.2.2 (Units.mk0 _ h')).mpr ⟨a⁻¹, rfl⟩ i
    have e3 : Units.mk0 _ h * Units.mk0 _ h' = 1 := by
      ext; simp [map_inv₀, ha]
    have e4 := wmul i (Units.mk0 _ h) (Units.mk0 _ h')
    rw [e3, wone] at e4
    omega
  have vz : ∀ i (k : ℤ), wcValGe K (w i) k 0 := fun i k => Or.inl rfl
  have vadd : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f + g) := by
    intro i k f g hf hg
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [zero_add]; exact hg
    rcases hg with hg | ⟨hg0, hg⟩
    · subst hg; rw [add_zero]; exact Or.inr ⟨hf0, hf⟩
    by_cases hfg : f + g = 0
    · exact Or.inl hfg
    refine Or.inr ⟨hfg, ?_⟩
    have := hw.1 i (Units.mk0 f hf0) (Units.mk0 g hg0) (Units.mk0 (f + g) hfg) (by simp)
    exact le_trans (le_min hf hg) this
  have wneg1 : ∀ i (f : K) (hf : f ≠ 0) (hf' : -f ≠ 0),
      w i (Additive.ofMul (Units.mk0 (-f) hf')) = w i (Additive.ofMul (Units.mk0 f hf)) := by
    intro i f hf hf'
    have h1 : algebraMap Ω K (-1) ≠ 0 := by simp
    have e : Units.mk0 (-f) hf' = Units.mk0 _ h1 * Units.mk0 f hf := by ext; simp
    rw [e, wmul, wconst, zero_add]
  have vneg : ∀ i (k : ℤ) (f : K), wcValGe K (w i) k f → wcValGe K (w i) k (-f) := by
    intro i k f hf
    rcases hf with hf | ⟨hf0, hf⟩
    · subst hf; rw [neg_zero]; exact vz i k
    have hf' : -f ≠ 0 := neg_ne_zero.mpr hf0
    exact Or.inr ⟨hf', by rw [wneg1 i f hf0 hf']; exact hf⟩
  have vsub : ∀ i (k : ℤ) (f g : K), wcValGe K (w i) k f → wcValGe K (w i) k g →
      wcValGe K (w i) k (f - g) := by
    intro i k f g hf hg
    rw [sub_eq_add_neg]; exact vadd i k f (-g) hf (vneg i k g hg)
  have vsmul : ∀ i (k : ℤ) (a : Ω) (f : K), wcValGe K (w i) k f →
      wcValGe K (w i) k (a • f) := by
    intro i k a f hf
    by_cases haf : a • f = 0
    · exact Or.inl haf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact absurd (by rw [hf, smul_zero]) haf
    have ha : algebraMap Ω K a ≠ 0 := by
      intro h0; apply haf; rw [Algebra.smul_def, h0, zero_mul]
    have e : Units.mk0 (a • f) haf = Units.mk0 _ ha * Units.mk0 f hf0 := by
      ext; simp [Algebra.smul_def]
    exact Or.inr ⟨haf, by rw [e, wmul, wconst, zero_add]; exact hf⟩
  have vmono : ∀ i (k l : ℤ) (f : K), l ≤ k → wcValGe K (w i) k f → wcValGe K (w i) l f := by
    intro i k l f hlk hf
    rcases hf with hf | ⟨hf0, hf⟩
    · exact Or.inl hf
    · exact Or.inr ⟨hf0, le_trans hlk hf⟩
  have vsum : ∀ i (k : ℤ) {n : ℕ} (a : Fin n → Ω) (β : Fin n → I → K),
      (∀ m, wcValGe K (w i) k (β m i)) → wcValGe K (w i) k (∑ m, a m • β m i) := by
    intro i k n a β hβ
    exact Finset.sum_induction _ (fun x => wcValGe K (w i) k x)
      (fun x y hx hy => vadd i k x y hx hy) (vz i k)
      (fun m _ => vsmul i k (a m) (β m i) (hβ m))

  have hloc : ∀ (A : I →₀ ℤ) (j : I), ∃ β : I → K,
      (∀ i, wcValGe K (w i) (-((A + Finsupp.single j (1:ℤ) : I →₀ ℤ) i)) (β i)) ∧
      ∀ α : I → K, (∀ i, wcValGe K (w i) (-((A + Finsupp.single j (1:ℤ) : I →₀ ℤ) i)) (α i)) →
        ∃! a : Ω, ∀ i, wcValGe K (w i) (-A i) (α i - a • β i) := by
    intro A j
    obtain ⟨t, ht⟩ := hw.2.2.1 j
    set s : Kˣ := t ^ (-(A j) - 1) with hs
    have hws : w j (Additive.ofMul s) = -(A j) - 1 := by
      rw [hs, ofMul_zpow, map_zsmul, ht, smul_eq_mul, mul_one]
    have hAjj : (A + Finsupp.single j (1:ℤ) : I →₀ ℤ) j = A j + 1 := by
      rw [Finsupp.add_apply, Finsupp.single_eq_same]
    have hAjne : ∀ i, i ≠ j → (A + Finsupp.single j (1:ℤ) : I →₀ ℤ) i = A i := by
      intro i h
      rw [Finsupp.add_apply, Finsupp.single_eq_of_ne h, add_zero]
    refine ⟨fun i => if i = j then (s : K) else 0, ?_, ?_⟩
    · intro i
      dsimp only
      by_cases h : i = j
      · subst h
        rw [if_pos rfl, hAjj]
        refine Or.inr ⟨s.ne_zero, ?_⟩
        rw [Units.mk0_val, hws]; omega
      · rw [if_neg h]; exact vz _ _
    · intro α hα
      have hjval : ∃ c : Ω, wcValGe K (w j) (-A j) (α j - c • (s : K)) := by
        by_cases hgood : wcValGe K (w j) (-A j) (α j)
        · exact ⟨0, by rw [zero_smul, sub_zero]; exact hgood⟩
        have hαj := hα j
        rw [hAjj] at hαj
        rcases hαj with h0 | ⟨h0, hle⟩
        · exact absurd (Or.inl h0) hgood
        have hlt : w j (Additive.ofMul (Units.mk0 (α j) h0)) < -A j := by
          by_contra hc; push_neg at hc; exact hgood (Or.inr ⟨h0, hc⟩)
        have hval : w j (Additive.ofMul (Units.mk0 (α j) h0)) = -(A j) - 1 := by omega
        set y : Kˣ := Units.mk0 (α j) h0 * s⁻¹ with hy
        have hwy : w j (Additive.ofMul y) = 0 := by
          rw [hy, wmul, hval, ofMul_inv, map_neg, hws]; ring
        obtain ⟨c, hc⟩ := hR j y hwy
        refine ⟨c, ?_⟩
        have hαs : α j = (y : K) * s := by
          rw [hy]; simp
        rcases hc with hc | ⟨h, hh, hpos⟩
        · left
          rw [hαs, hc, Algebra.smul_def]; ring
        · have e : α j - c • (s : K) = ((h * s : Kˣ) : K) := by
            rw [Units.val_mul, hh, hαs, Algebra.smul_def]; ring
          rw [e]
          refine Or.inr ⟨(h * s).ne_zero, ?_⟩
          rw [Units.mk0_val, wmul, hws]; omega
      obtain ⟨c, hc⟩ := hjval
      refine ⟨c, ?_, ?_⟩
      · intro i
        dsimp only
        by_cases h : i = j
        · subst h; rw [if_pos rfl]; exact hc
        · rw [if_neg h, smul_zero, sub_zero]
          have := hα i
          rw [hAjne i h] at this
          exact this
      · intro a' ha'
        have h1 := ha' j
        dsimp only at h1
        rw [if_pos rfl] at h1
        by_contra hne
        have h2 := vsub j _ _ _ hc h1
        have e : α j - c • (s : K) - (α j - a' • (s : K)) = (a' - c) • (s : K) := by
          rw [sub_smul]; ring
        rw [e] at h2
        have hne' : algebraMap Ω K (a' - c) ≠ 0 := by
          rw [Ne, map_eq_zero_iff _ (algebraMap Ω K).injective]
          exact sub_ne_zero.mpr hne
        have hnz : (a' - c) • (s : K) ≠ 0 := by
          rw [Algebra.smul_def]; exact mul_ne_zero hne' s.ne_zero
        rcases h2 with h2 | ⟨h2, hle⟩
        · exact hnz h2
        have e2 : Units.mk0 ((a' - c) • (s : K)) h2 = Units.mk0 _ hne' * s := by
          ext; simp [Algebra.smul_def]
        rw [e2, wmul, wconst, hws] at hle
        omega

  have degsub : ∀ C A : I →₀ ℤ, (C - A).sum (fun _ k => k) =
      C.sum (fun _ k => k) - A.sum (fun _ k => k) := by
    intro C A
    exact Finsupp.sum_sub_index (fun _ _ _ => rfl)
  have degnn : ∀ D : I →₀ ℤ, 0 ≤ D → 0 ≤ D.sum (fun _ k => k) := by
    intro D hD
    unfold Finsupp.sum
    exact Finset.sum_nonneg (fun x _ => hD x)
  have degle : ∀ D : I →₀ ℤ, 0 ≤ D → ∀ i, D i ≤ D.sum (fun _ k => k) := by
    intro D hD i
    have hnn : ∀ x ∈ D.support, 0 ≤ D x := fun x _ => hD x
    by_cases hi : i ∈ D.support
    · unfold Finsupp.sum
      exact Finset.single_le_sum (f := fun x => D x) hnn hi
    · rw [Finsupp.notMem_support_iff.mp hi]
      exact degnn D hD
  have hCAnn : ∀ A C : I →₀ ℤ, A ≤ C → 0 ≤ C - A := by
    intro A C hAC x
    rw [Finsupp.sub_apply, Finsupp.coe_zero, Pi.zero_apply]
    have := hAC x; omega

  have key : ∀ N : ℕ, ∀ A C : I →₀ ℤ, A ≤ C →
      C.sum (fun _ k => k) - A.sum (fun _ k => k) = (N : ℤ) → ∃ (β : Fin N → I → K),
      (∀ k i, wcValGe K (w i) (-C i) (β k i)) ∧
      (∀ α : I → K, (∀ i, wcValGe K (w i) (-C i) (α i)) →
        ∃ a : Fin N → Ω, ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • β k i)) ∧
      (∀ a : Fin N → Ω, (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • β k i)) → a = 0) := by
    intro N
    induction N with
    | zero =>
      intro A C hAC hdeg
      have hCA : C = A := by
        ext i
        have h1 := degle (C - A) (hCAnn A C hAC) i
        rw [degsub, hdeg, Finsupp.sub_apply] at h1
        have h2 := hAC i
        push_cast at h1
        omega
      subst hCA
      refine ⟨Fin.elim0, fun k => Fin.elim0 k, fun α hα => ⟨Fin.elim0, fun i => ?_⟩,
        fun a _ => funext (fun k => Fin.elim0 k)⟩
      rw [Finset.univ_eq_empty, Finset.sum_empty, sub_zero]
      exact hα i
    | succ N ih =>
      intro A C hAC hdeg
      obtain ⟨j, hj⟩ : ∃ j, A j < C j := by
        by_contra hc
        push_neg at hc
        have : C = A := by ext i; exact le_antisymm (hc i) (hAC i)
        subst this
        rw [sub_self] at hdeg
        omega
      set C' : I →₀ ℤ := C - Finsupp.single j (1:ℤ) with hC'
      have hC'j : C' j = C j - 1 := by
        rw [hC', Finsupp.sub_apply, Finsupp.single_eq_same]
      have hC'ne : ∀ i, i ≠ j → C' i = C i := by
        intro i h
        rw [hC', Finsupp.sub_apply, Finsupp.single_eq_of_ne h, sub_zero]
      have hAC' : A ≤ C' := by
        intro i
        by_cases h : i = j
        · subst h; rw [hC'j]; omega
        · rw [hC'ne i h]; exact hAC i
      have hC'C : ∀ i, -C i ≤ -C' i := by
        intro i
        by_cases h : i = j
        · subst h; rw [hC'j]; omega
        · rw [hC'ne i h]
      have hdeg' : C'.sum (fun _ k => k) - A.sum (fun _ k => k) = (N : ℤ) := by
        rw [hC', degsub, Finsupp.sum_single_index rfl]
        push_cast at hdeg
        omega
      have hCeq : C' + Finsupp.single j (1:ℤ) = C := by rw [hC', sub_add_cancel]
      obtain ⟨β', hβ'1, hβ'2, hβ'3⟩ := ih A C' hAC' hdeg'
      obtain ⟨β₀, hβ₀1, hβ₀2⟩ := hloc C' j
      rw [hCeq] at hβ₀1 hβ₀2
      refine ⟨Fin.cons β₀ β', ?_, ?_, ?_⟩
      · intro k i
        refine Fin.cases ?_ (fun k => ?_) k
        · rw [Fin.cons_zero]; exact hβ₀1 i
        · rw [Fin.cons_succ]; exact vmono i _ _ _ (hC'C i) (hβ'1 k i)
      · intro α hα
        obtain ⟨a₀, ha₀, -⟩ := hβ₀2 α hα
        obtain ⟨a', ha'⟩ := hβ'2 (fun i => α i - a₀ • β₀ i) ha₀
        refine ⟨Fin.cons a₀ a', fun i => ?_⟩
        rw [Fin.sum_univ_succ]
        simp only [Fin.cons_zero, Fin.cons_succ]
        have e : α i - (a₀ • β₀ i + ∑ k : Fin N, a' k • β' k i) =
            α i - a₀ • β₀ i - ∑ k : Fin N, a' k • β' k i := by ring
        rw [e]; exact ha' i
      · intro a ha
        have hsplit : ∀ i, ∑ k, a k • (Fin.cons β₀ β' : Fin (N+1) → I → K) k i =
            a 0 • β₀ i + ∑ k : Fin N, a k.succ • β' k i := by
          intro i; rw [Fin.sum_univ_succ]; simp only [Fin.cons_zero, Fin.cons_succ]
        have hS : ∀ i, wcValGe K (w i) (-C' i) (∑ k : Fin N, a k.succ • β' k i) :=
          fun i => vsum i _ (fun k => a k.succ) β' (fun k => hβ'1 k i)
        have hAC'v : ∀ i, -C' i ≤ -A i := fun i => by have := hAC' i; omega
        have h0 : ∀ i, wcValGe K (w i) (-C' i) (a 0 • β₀ i) := by
          intro i
          have h1 := vmono i _ _ _ (hAC'v i) (ha i)
          rw [hsplit] at h1
          have := vsub i _ _ _ h1 (hS i)
          rwa [add_sub_cancel_right] at this
        have ha0 : a 0 = 0 := by
          obtain ⟨b, -, hb⟩ := hβ₀2 (fun i => a 0 • β₀ i) (fun i => vsmul i _ _ _ (hβ₀1 i))
          have e1 := hb (a 0) (fun i => by rw [sub_self]; exact vz _ _)
          have e2 := hb 0 (fun i => by rw [zero_smul, sub_zero]; exact h0 i)
          rw [e1, e2]
        have hrest : (fun k : Fin N => a k.succ) = 0 := by
          apply hβ'3
          intro i
          have := ha i
          rw [hsplit, ha0, zero_smul, zero_add] at this
          exact this
        funext k
        refine Fin.cases ?_ (fun k => ?_) k
        · exact ha0
        · exact congrFun hrest k
  have hrel : ∀ A C : I →₀ ℤ, A ≤ C → ∃ (n : ℕ) (β : Fin n → I → K),
      (n : ℤ) = C.sum (fun _ k => k) - A.sum (fun _ k => k) ∧
      (∀ k i, wcValGe K (w i) (-C i) (β k i)) ∧
      (∀ α : I → K, (∀ i, wcValGe K (w i) (-C i) (α i)) →
        ∃ a : Fin n → Ω, ∀ i, wcValGe K (w i) (-A i) (α i - ∑ k, a k • β k i)) ∧
      (∀ a : Fin n → Ω, (∀ i, wcValGe K (w i) (-A i) (∑ k, a k • β k i)) → a = 0) := by
    intro A C hAC
    have hnn : 0 ≤ C.sum (fun _ k => k) - A.sum (fun _ k => k) := by
      rw [← degsub]
      exact degnn _ (hCAnn A C hAC)
    obtain ⟨β, h1, h2, h3⟩ := key (C.sum (fun _ k => k) - A.sum (fun _ k => k)).toNat A C hAC
      (Int.toNat_of_nonneg hnn).symm
    exact ⟨_, β, (Int.toNat_of_nonneg hnn), h1, h2, h3⟩

  have happrox := fun C hC α hα => wd_approx Ω K I w hw hdim g c hRR hrel C hC α hα
  have hidx := fun A => wd_index Ω K I w hw hdim i₀ g c hRR hrel happrox A
  have hmult := fun A θ h1 h2 h3 h4 =>
    wd_multiple Ω K I w hw hdim i₀ g c hRR hidx W hW lam ha hb hc A θ h1 h2 h3 h4
  have hdual := wd_duality Ω K I w hw hdim i₀ g hidx W hW lam ha hb hc hmult

  have hW'app : ∀ i, (Finsupp.ofSupportFinite W hW) i = W i :=
    fun i => congrFun Finsupp.ofSupportFinite_coe i
  have hdegW : ∑ᶠ i, W i = (Finsupp.ofSupportFinite W hW).sum (fun _ k => k) := by
    rw [finsum_eq_sum_of_support_subset W (s := (Finsupp.ofSupportFinite W hW).support) ?_]
    · unfold Finsupp.sum
      exact Finset.sum_congr rfl (fun i _ => (hW'app i).symm)
    · intro i hi
      rw [Finset.mem_coe, Finsupp.mem_support_iff, hW'app]
      exact hi
  have h0 := hdual 0
  rw [sub_zero, Finsupp.sum_zero_index, hdim.1] at h0
  have h1 := hdual (Finsupp.ofSupportFinite W hW)
  rw [sub_self, hdim.1] at h1
  push_cast at h0 h1
  rw [hdegW]
  linarith

theorem wcpa_dj_cdp_cd_theta_integral (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F) (D : Derivation K F F) (V : ValuationSubring F)
    (hV : wcpaDjNtV' K V)
    (hres : ∀ y : F, y ≠ 0 → wcpaDjValOrd V y = 0 → ∃ c : K, y = algebraMap K F c ∨
      (y - algebraMap K F c ≠ 0 ∧ 0 < wcpaDjValOrd V (y - algebraMap K F c)))
    (π y : F) (hπ : wcpaDjValOrd V π = 1) (hDπ : D π ≠ 0) (hy : y ∈ V) (hDy : D y ≠ 0) :
    wcpaDjValOrd V (D π) ≤ wcpaDjValOrd V (D y) :=
by
  classical

  have hfd := wcpa_dj_ffv_finite_over_transc K F hF
  obtain ⟨z0, hz0, hsep0, hsep0'⟩ := wcpa_dj_ffv_separating K F hF
  obtain ⟨z, hzV, hz, hsep⟩ : ∃ z : F, z ∈ V ∧ Transcendental K z ∧
      Algebra.IsSeparable (IntermediateField.adjoin K {z}) F := by
    rcases V.mem_or_inv_mem z0 with h | h
    · exact ⟨z0, h, hz0, hsep0⟩
    · refine ⟨z0⁻¹, h, ?_, hsep0'⟩
      unfold Transcendental at hz0 ⊢
      exact fun h' => hz0 (IsAlgebraic.inv_iff.mp h')
  haveI := hfd z hz
  haveI := hsep

  have hDed : IsDedekindDomain ↥(Algebra.adjoin K {z}) := by
    have hrange := Algebra.adjoin_singleton_eq_range_aeval K z
    haveI : IsPrincipalIdealRing ↥((Polynomial.aeval (R := K) z).range) :=
      IsPrincipalIdealRing.of_surjective (Polynomial.aeval (R := K) z).rangeRestrict
        (AlgHom.rangeRestrict_surjective _)
    haveI : IsPrincipalIdealRing ↥(Algebra.adjoin K {z}) := by rw [hrange]; infer_instance
    exact IsPrincipalIdealRing.isDedekindDomain _
  haveI := hDed

  have hRV : ∀ r ∈ Algebra.adjoin K {z}, r ∈ V := by
    intro r hr
    have hle : Algebra.adjoin K {z} ≤ { V.toSubring with algebraMap_mem' := hV.1 } :=
      Algebra.adjoin_le (by simpa using hzV)
    exact hle hr
  have hCV : ∀ x : F, x ∈ integralClosure ↥(Algebra.adjoin K {z}) F → x ∈ V := by
    intro x hx
    let ι : ↥(Algebra.adjoin K {z}) →+* ↥V :=
      { toFun := fun r => ⟨r, hRV r r.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hcomp : (algebraMap ↥V F).comp ι = algebraMap ↥(Algebra.adjoin K {z}) F := by
      ext r; rfl
    obtain ⟨p, hpm, hp⟩ := hx
    have hxV : _root_.IsIntegral ↥V x :=
      ⟨p.map ι, hpm.map ι, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxV
    rw [← hw]; exact w.2

  have hA1 : IsDedekindDomain ↥((integralClosure ↥(Algebra.adjoin K {z}) F).toSubring) := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact integralClosure.isDedekindDomain ↥(Algebra.adjoin K {z})
      ↥(IntermediateField.adjoin K {z}) F
  have hA2 : IsFractionRing ↥((integralClosure ↥(Algebra.adjoin K {z}) F).toSubring) F := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact integralClosure.isFractionRing_of_finite_extension (A := ↥(Algebra.adjoin K {z}))
      ↥(IntermediateField.adjoin K {z}) F
  have hfinC : Module.Finite ↥(Algebra.adjoin K {z})
      ↥(integralClosure ↥(Algebra.adjoin K {z}) F) := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact IsIntegralClosure.finite ↥(Algebra.adjoin K {z})
      ↥(IntermediateField.adjoin K {z}) F ↥(integralClosure ↥(Algebra.adjoin K {z}) F)
  haveI := hfinC
  obtain ⟨r, b, hb⟩ := Module.Finite.exists_fin (R := ↥(Algebra.adjoin K {z}))
    (M := ↥(integralClosure ↥(Algebra.adjoin K {z}) F))
  haveI := hA1
  haveI := hA2

  obtain ⟨hdvr, hloc0⟩ := wcpa_dj_ffv_dedekind_local F
    (integralClosure ↥(Algebra.adjoin K {z}) F).toSubring V (fun x hx => hCV x hx) hV.2
  haveI := hdvr
  obtain ⟨-, hmul, hmem, hult, hunit⟩ := wcpa_dj_ffv_valord_dvr F V
  set v : F → ℤ := wcpaDjValOrd V with hvdef
  have hD0 : D 0 = 0 := D.map_zero
  have hDc : ∀ c : K, D (algebraMap K F c) = 0 := fun c => D.map_algebraMap c

  obtain ⟨m, hm⟩ : ∃ m : ℕ, m = (-v (D z)).toNat + ∑ j : Fin r, (-v (D ((b j : F)))).toNat :=
    ⟨_, rfl⟩
  have hBadd : ∀ a c : F, (a = 0 ∨ -(m : ℤ) ≤ v a) → (c = 0 ∨ -(m : ℤ) ≤ v c) →
      (a + c = 0 ∨ -(m : ℤ) ≤ v (a + c)) := by
    intro a c ha hc
    by_cases ha0 : a = 0
    · rw [ha0, zero_add]; exact hc
    by_cases hc0 : c = 0
    · rw [hc0, add_zero]; exact ha
    by_cases hac : a + c = 0
    · exact Or.inl hac
    right
    have h1 := hult a c ha0 hc0 hac
    rcases ha with ha | ha
    · exact absurd ha ha0
    rcases hc with hc | hc
    · exact absurd hc hc0
    exact le_trans (le_min ha hc) h1
  have hBmul : ∀ x w : F, x ∈ V → (w = 0 ∨ -(m : ℤ) ≤ v w) →
      (x * w = 0 ∨ -(m : ℤ) ≤ v (x * w)) := by
    intro x w hx hw
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    by_cases hw0 : w = 0
    · left; rw [hw0, mul_zero]
    rcases hw with hw | hw
    · exact absurd hw hw0
    right
    rw [hmul x w hx0 hw0]
    have := (hmem x hx0).1 hx
    linarith
  have hBz : D z = 0 ∨ -(m : ℤ) ≤ v (D z) := by
    by_cases h0 : D z = 0
    · exact Or.inl h0
    right
    have h1 : -v (D z) ≤ ((-v (D z)).toNat : ℤ) := Int.self_le_toNat _
    have h2 : (-v (D z)).toNat ≤ m := by rw [hm]; exact Nat.le_add_right _ _
    omega
  have hBb : ∀ j, D (b j : F) = 0 ∨ -(m : ℤ) ≤ v (D (b j : F)) := by
    intro j
    by_cases h0 : D (b j : F) = 0
    · exact Or.inl h0
    right
    have h1 : -v (D (b j : F)) ≤ ((-v (D (b j : F))).toNat : ℤ) := Int.self_le_toNat _
    have h2 : (-v (D (b j : F))).toNat ≤ ∑ j : Fin r, (-v (D ((b j : F)))).toNat :=
      Finset.single_le_sum (f := fun j => (-v (D ((b j : F)))).toNat)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    have h3 : ∑ j : Fin r, (-v (D ((b j : F)))).toNat ≤ m := by
      rw [hm]; exact Nat.le_add_left _ _
    omega
  let G : Subalgebra K F :=
    { carrier := {a | a ∈ V ∧ (D a = 0 ∨ -(m : ℤ) ≤ v (D a))}
      mul_mem' := by
        rintro a c ⟨haV, ha⟩ ⟨hcV, hc⟩
        refine ⟨mul_mem haV hcV, ?_⟩
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact hBadd _ _ (hBmul _ _ haV hc) (hBmul _ _ hcV ha)
      add_mem' := by
        rintro a c ⟨haV, ha⟩ ⟨hcV, hc⟩
        refine ⟨add_mem haV hcV, ?_⟩
        rw [map_add]
        exact hBadd _ _ ha hc
      algebraMap_mem' := by
        intro c
        refine ⟨hV.1 c, ?_⟩
        rw [hDc]
        exact Or.inl rfl }
  have hzG : z ∈ G := ⟨hzV, hBz⟩
  have hRG : Algebra.adjoin K {z} ≤ G := Algebra.adjoin_le (Set.singleton_subset_iff.mpr hzG)
  have hCG : ∀ x : F, x ∈ integralClosure ↥(Algebra.adjoin K {z}) F → x ∈ G := by
    intro x hx
    have hmem' : (⟨x, hx⟩ : ↥(integralClosure ↥(Algebra.adjoin K {z}) F)) ∈
        Submodule.span ↥(Algebra.adjoin K {z}) (Set.range b) := by
      rw [hb]; exact Submodule.mem_top
    have key : ∀ (w : ↥(integralClosure ↥(Algebra.adjoin K {z}) F)),
        w ∈ Submodule.span ↥(Algebra.adjoin K {z}) (Set.range b) → (w : F) ∈ G := by
      intro w hw
      induction hw using Submodule.span_induction with
      | mem w hw =>
        obtain ⟨j, rfl⟩ := hw
        exact ⟨hCV _ (b j).2, hBb j⟩
      | zero => exact zero_mem G
      | add w1 w2 _ _ h1 h2 => exact add_mem h1 h2
      | smul c w _ h =>
        have e : ((c • w : ↥(integralClosure ↥(Algebra.adjoin K {z}) F)) : F) =
            (c : F) * (w : F) := rfl
        rw [e]
        exact mul_mem (hRG c.2) h
    exact key _ hmem'
  have hApriori : ∀ y' : F, y' ∈ V → D y' ≠ 0 → -(m : ℤ) ≤ v (D y') := by
    intro y' hy' hDy'
    obtain ⟨a, s, ha, hs, hs0, hsinv, rfl⟩ := (hloc0 y').1 hy'
    obtain ⟨haV, hBa⟩ := hCG a ha
    obtain ⟨hsV, hBs⟩ := hCG s hs
    obtain ⟨w, hw⟩ : ∃ w : F, w = s * D a + (-a) * D s := ⟨_, rfl⟩
    have hBw : w = 0 ∨ -(m : ℤ) ≤ v w := by
      rw [hw]; exact hBadd _ _ (hBmul _ _ hsV hBa) (hBmul _ _ (neg_mem haV) hBs)
    have hDe : D (a / s) = s⁻¹ * (s⁻¹ * w) := by
      rw [Derivation.leibniz_div, smul_eq_mul, smul_eq_mul, smul_eq_mul, hw]; ring
    have hsi0 : s⁻¹ ≠ 0 := inv_ne_zero hs0
    have hw0 : w ≠ 0 := by
      intro h; apply hDy'; rw [hDe, h, mul_zero, mul_zero]
    have hvsi : v s⁻¹ = 0 := (hunit s⁻¹ hsi0).2 ⟨hsinv, by rw [inv_inv]; exact hsV⟩
    rw [hDe, hmul _ _ hsi0 (mul_ne_zero hsi0 hw0), hmul _ _ hsi0 hw0, hvsi]
    rcases hBw with h | h
    · exact absurd h hw0
    · linarith

  have hπ0 : π ≠ 0 := by intro h; apply hDπ; rw [h, hD0]
  have hstep : ∀ k : ℕ,
      (∀ y' : F, y' ∈ V → D y' ≠ 0 → v (D π) - ((k + 1 : ℕ) : ℤ) ≤ v (D y')) →
      ∀ y' : F, y' ∈ V → D y' ≠ 0 → v (D π) - (k : ℤ) ≤ v (D y') := by
    intro k hk y' hy' hDy'
    have hy0 : y' ≠ 0 := by intro h; apply hDy'; rw [h, hD0]
    have hvy : 0 ≤ v y' := (hmem y' hy0).1 hy'
    obtain ⟨c, he0, hve⟩ : ∃ c : K, y' - algebraMap K F c ≠ 0 ∧
        0 < v (y' - algebraMap K F c) := by
      by_cases h0 : v y' = 0
      · obtain ⟨c, hc⟩ := hres y' hy0 h0
        rcases hc with hc | hc
        · exact (hDy' (by rw [hc, hDc])).elim
        · exact ⟨c, hc⟩
      · refine ⟨0, ?_, ?_⟩
        · rw [map_zero, sub_zero]; exact hy0
        · rw [map_zero, sub_zero]; omega
    obtain ⟨e, he⟩ : ∃ e : F, e = y' - algebraMap K F c := ⟨_, rfl⟩
    rw [← he] at he0 hve
    have hy1 : e * π⁻¹ * π = e := by field_simp
    have hy10 : e * π⁻¹ ≠ 0 := mul_ne_zero he0 (inv_ne_zero hπ0)
    have hv1 : v e = v (e * π⁻¹) + 1 := by
      have := hmul (e * π⁻¹) π hy10 hπ0
      rw [hy1, hπ] at this; exact this
    have hy1V : e * π⁻¹ ∈ V := (hmem _ hy10).2 (by omega)
    have hDy'eq : D y' = e * π⁻¹ * D π + π * D (e * π⁻¹) := by
      have hyy : y' = algebraMap K F c + π * (e * π⁻¹) := by
        rw [mul_comm π, hy1, he]; ring
      rw [hyy, map_add, hDc, zero_add, Derivation.leibniz, smul_eq_mul, smul_eq_mul]; ring
    have hT2 : v (D π) ≤ v (e * π⁻¹ * D π) := by
      rw [hmul _ _ hy10 hDπ]
      have := (hmem _ hy10).1 hy1V
      linarith
    rw [hDy'eq]
    by_cases hD1 : D (e * π⁻¹) = 0
    · rw [hD1, mul_zero, add_zero]
      have : (0 : ℤ) ≤ (k : ℤ) := Int.natCast_nonneg k
      linarith
    · have hT1 : v (D π) - k ≤ v (π * D (e * π⁻¹)) := by
        rw [hmul _ _ hπ0 hD1, hπ]
        have := hk _ hy1V hD1
        push_cast at this
        linarith
      have hsum0 : e * π⁻¹ * D π + π * D (e * π⁻¹) ≠ 0 := by rw [← hDy'eq]; exact hDy'
      have hu := hult _ _ (mul_ne_zero hy10 hDπ) (mul_ne_zero hπ0 hD1) hsum0
      have hk0 : (0 : ℤ) ≤ (k : ℤ) := Int.natCast_nonneg k
      have hmin : v (D π) - k ≤ min (v (e * π⁻¹ * D π)) (v (π * D (e * π⁻¹))) :=
        le_min (by linarith) hT1
      linarith
  have hbase : ∀ k : ℕ, (v (D π) + m).toNat ≤ k →
      ∀ y' : F, y' ∈ V → D y' ≠ 0 → v (D π) - (k : ℤ) ≤ v (D y') := by
    intro k hk y' hy' hDy'
    have h1 := hApriori y' hy' hDy'
    have h2 : v (D π) + m ≤ ((v (D π) + m).toNat : ℤ) := Int.self_le_toNat _
    have h3 : (((v (D π) + m).toNat : ℕ) : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk
    linarith
  have hdesc : ∀ n k : ℕ, (v (D π) + m).toNat ≤ k + n →
      ∀ y' : F, y' ∈ V → D y' ≠ 0 → v (D π) - (k : ℤ) ≤ v (D y') := by
    intro n
    induction n with
    | zero => intro k hk; exact hbase k (by omega)
    | succ n ih => intro k hk; exact hstep k (ih (k + 1) (by omega))
  have hfinal := hdesc (v (D π) + m).toNat 0 (by omega) y hy hDy
  simpa using hfinal

theorem wcpa_rf_pp_projection : ∀ (K F I : Type u) [Field K] [Field F] [Algebra K F] (w : I → Additive Fˣ →+ ℤ), wcValFamily K F I w → wcRRResidue K F I w → ∀ (i : I) (t : Fˣ), w i (Additive.ofMul t) = 1 → ∃ (e : F →ₗ[K] F) (c : F →ₗ[K] K), (∀ h, wcValGe F (w i) 0 (e h)) ∧ (∀ h, wcValGe F (w i) 0 h → e h = h) ∧ (∀ k : ℕ, e ((t : F)⁻¹ ^ (k + 1)) = 0) ∧ (∀ (N : ℕ) (h : F), wcValGe F (w i) (-(N : ℤ)) h → ∃ b : Fin N → K, h - e h = ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) ∧ (∀ h, algebraMap K F (c h) = e ((t : F) * (h - e h))) :=
by
  intro K F I _ _ _ w hfam hR i t ht
  classical
  have ht0 : (t : F) ≠ 0 := t.ne_zero

  have hmk : ∀ (g h : F) (hg : g ≠ 0) (hh : h ≠ 0),
      w i (Additive.ofMul (Units.mk0 (g * h) (mul_ne_zero hg hh))) =
        w i (Additive.ofMul (Units.mk0 g hg)) + w i (Additive.ofMul (Units.mk0 h hh)) := by
    intro g h hg hh
    rw [show Units.mk0 (g * h) (mul_ne_zero hg hh) = Units.mk0 g hg * Units.mk0 h hh from
      Units.ext rfl, ofMul_mul, map_add]
  have VG_mul : ∀ (a b c : ℤ) (g h : F), a + b = c → wcValGe F (w i) a g →
      wcValGe F (w i) b h → wcValGe F (w i) c (g * h) := by
    intro a b c g h habc hg hh
    rcases hg with rfl | ⟨hg0, hga⟩
    · left; rw [zero_mul]
    rcases hh with rfl | ⟨hh0, hhb⟩
    · left; rw [mul_zero]
    right
    refine ⟨mul_ne_zero hg0 hh0, ?_⟩
    rw [hmk g h hg0 hh0]
    omega
  have VG_mono : ∀ {a b : ℤ} {g : F}, b ≤ a → wcValGe F (w i) a g → wcValGe F (w i) b g := by
    rintro a b g hab (h | ⟨hg, hle⟩)
    · exact Or.inl h
    · exact Or.inr ⟨hg, le_trans hab hle⟩
  have VG_add : ∀ {a : ℤ} {g h : F}, wcValGe F (w i) a g → wcValGe F (w i) a h →
      wcValGe F (w i) a (g + h) := by
    intro a g h hg hh
    by_cases hs : g + h = 0
    · exact Or.inl hs
    rcases hg with rfl | ⟨hg0, hga⟩
    · rw [zero_add]; exact hh
    rcases hh with rfl | ⟨hh0, hhb⟩
    · rw [add_zero]; exact Or.inr ⟨hg0, hga⟩
    right
    refine ⟨hs, ?_⟩
    have := hfam.1 i (Units.mk0 g hg0) (Units.mk0 h hh0) (Units.mk0 (g + h) hs) rfl
    exact le_trans (le_min hga hhb) this
  have hconst : ∀ (c : K) (hc : algebraMap K F c ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro c hc
    have h1 : 0 ≤ w i (Additive.ofMul (Units.mk0 _ hc)) :=
      (hfam.2.2.2 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ i
    have hci : algebraMap K F c⁻¹ ≠ 0 := by rw [map_inv₀]; exact inv_ne_zero hc
    have h2 : 0 ≤ w i (Additive.ofMul (Units.mk0 _ hci)) :=
      (hfam.2.2.2 (Units.mk0 _ hci)).mpr ⟨c⁻¹, rfl⟩ i
    have h3 : Units.mk0 _ hci = (Units.mk0 _ hc)⁻¹ := Units.ext (by simp [map_inv₀])
    rw [h3, ofMul_inv, map_neg] at h2
    omega
  have VG_const : ∀ c : K, wcValGe F (w i) 0 (algebraMap K F c) := by
    intro c
    by_cases hc : algebraMap K F c = 0
    · exact Or.inl hc
    · exact Or.inr ⟨hc, (hconst c hc).ge⟩
  have VG_neg : ∀ {a : ℤ} {g : F}, wcValGe F (w i) a g → wcValGe F (w i) a (-g) := by
    intro a g hg
    have e : -g = algebraMap K F (-1) * g := by rw [map_neg, map_one, neg_one_mul]
    rw [e]
    exact VG_mul 0 a a _ _ (zero_add a) (VG_const _) hg
  have VG_sum : ∀ (n : ℕ) (a : ℤ) (f : Fin n → F), (∀ k, wcValGe F (w i) a (f k)) →
      wcValGe F (w i) a (∑ k : Fin n, f k) := by
    intro n a f hf
    exact Finset.sum_induction f (wcValGe F (w i) a) (fun _ _ h1 h2 => VG_add h1 h2)
      (Or.inl rfl) (fun k _ => hf k)
  have htpow : ∀ n : ℕ, wcValGe F (w i) (n : ℤ) ((t : F) ^ n) := by
    intro n
    right
    refine ⟨pow_ne_zero n ht0, ?_⟩
    have e : Units.mk0 ((t : F) ^ n) (pow_ne_zero n ht0) = t ^ n := Units.ext (by simp)
    rw [e, ofMul_pow, map_nsmul, ht]
    simp
  have htinv : ∀ n : ℕ, wcValGe F (w i) (-(n : ℤ)) ((t : F)⁻¹ ^ n) := by
    intro n
    right
    refine ⟨pow_ne_zero n (inv_ne_zero ht0), ?_⟩
    have e : Units.mk0 ((t : F)⁻¹ ^ n) (pow_ne_zero n (inv_ne_zero ht0)) = (t ^ n)⁻¹ :=
      Units.ext (by simp)
    rw [e, ofMul_inv, map_neg, ofMul_pow, map_nsmul, ht]
    simp

  have hres : ∀ y : F, wcValGe F (w i) 0 y → ∃ c₀ : K,
      wcValGe F (w i) 1 (y - algebraMap K F c₀) := by
    intro y hy
    rcases hy with rfl | ⟨hy0, hyv⟩
    · exact ⟨0, Or.inl (by rw [map_zero, sub_zero])⟩
    rcases lt_or_eq_of_le hyv with hlt | heq
    · refine ⟨0, ?_⟩
      rw [map_zero, sub_zero]
      exact Or.inr ⟨hy0, by omega⟩
    · obtain ⟨c₀, hc⟩ := hR i (Units.mk0 y hy0) heq.symm
      refine ⟨c₀, ?_⟩
      rcases hc with h | ⟨h, hh1, hh2⟩
      · left
        rw [Units.val_mk0] at h
        rw [h, sub_self]
      · rw [Units.val_mk0] at hh1
        rw [← hh1]
        right
        refine ⟨h.ne_zero, ?_⟩
        rw [Units.mk0_val]
        omega

  have hexist : ∀ (N : ℕ) (h : F), wcValGe F (w i) (-(N : ℤ)) h → ∃ b : Fin N → K,
      wcValGe F (w i) 0 (h - ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) := by
    intro N
    induction N with
    | zero =>
      intro h hh
      refine ⟨Fin.elim0, ?_⟩
      simpa using hh
    | succ N ih =>
      intro h hh
      have hy : wcValGe F (w i) 0 (h * (t : F) ^ (N + 1)) :=
        VG_mul _ _ _ _ _ (by push_cast; ring) hh (htpow (N + 1))
      obtain ⟨c₀, hc₀⟩ := hres _ hy
      have h1 : wcValGe F (w i) (-(N : ℤ)) (h - algebraMap K F c₀ * (t : F)⁻¹ ^ (N + 1)) := by
        have e1 : (h * (t : F) ^ (N + 1) - algebraMap K F c₀) * (t : F)⁻¹ ^ (N + 1) =
            h - algebraMap K F c₀ * (t : F)⁻¹ ^ (N + 1) := by
          rw [sub_mul, mul_assoc, ← mul_pow, mul_inv_cancel₀ ht0, one_pow, mul_one]
        rw [← e1]
        exact VG_mul _ _ _ _ _ (by push_cast; ring) hc₀ (htinv (N + 1))
      obtain ⟨b', hb'⟩ := ih _ h1
      refine ⟨Fin.snoc b' c₀, ?_⟩
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.val_castSucc, Fin.val_last]
      have e : h - (∑ k : Fin N, algebraMap K F (b' k) * (t : F)⁻¹ ^ ((k : ℕ) + 1) +
          algebraMap K F c₀ * (t : F)⁻¹ ^ (N + 1)) =
          (h - algebraMap K F c₀ * (t : F)⁻¹ ^ (N + 1)) -
            ∑ k : Fin N, algebraMap K F (b' k) * (t : F)⁻¹ ^ ((k : ℕ) + 1) := by ring
      rw [e]
      exact hb'

  have hbound : ∀ (N : ℕ) (b : Fin N → K), wcValGe F (w i) (-(N : ℤ))
      (∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) := by
    intro N b
    apply VG_sum
    intro k
    have hk := k.isLt
    exact VG_mono (by omega) (VG_mul 0 _ _ _ _ (zero_add _) (VG_const _) (htinv ((k : ℕ) + 1)))

  have huniq : ∀ (N : ℕ) (b : Fin N → K), wcValGe F (w i) 0
      (∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) → b = 0 := by
    intro N
    induction N with
    | zero => intro b _; funext k; exact k.elim0
    | succ N ih =>
      intro b hb
      rw [Fin.sum_univ_castSucc] at hb
      simp only [Fin.val_castSucc, Fin.val_last] at hb
      have hX : wcValGe F (w i) (-(N : ℤ))
          (algebraMap K F (b (Fin.last N)) * (t : F)⁻¹ ^ (N + 1)) := by
        have e : algebraMap K F (b (Fin.last N)) * (t : F)⁻¹ ^ (N + 1) =
            (∑ k : Fin N, algebraMap K F (b (Fin.castSucc k)) * (t : F)⁻¹ ^ ((k : ℕ) + 1) +
              algebraMap K F (b (Fin.last N)) * (t : F)⁻¹ ^ (N + 1)) +
            -(∑ k : Fin N, algebraMap K F (b (Fin.castSucc k)) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) := by
          ring
        rw [e]
        exact VG_add (VG_mono (by omega) hb) (VG_neg (hbound N _))
      have hc : wcValGe F (w i) 1 (algebraMap K F (b (Fin.last N))) := by
        have e : algebraMap K F (b (Fin.last N)) =
            (algebraMap K F (b (Fin.last N)) * (t : F)⁻¹ ^ (N + 1)) * (t : F) ^ (N + 1) := by
          rw [mul_assoc, ← mul_pow, inv_mul_cancel₀ ht0, one_pow, mul_one]
        rw [e]
        exact VG_mul _ _ _ _ _ (by push_cast; ring) hX (htpow (N + 1))
      have hb0 : b (Fin.last N) = 0 := by
        rcases hc with h0 | ⟨hne, hle⟩
        · exact (algebraMap K F).injective (h0.trans (map_zero _).symm)
        · rw [hconst _ hne] at hle
          omega
      have hb' : (fun k : Fin N => b (Fin.castSucc k)) = 0 := by
        apply ih
        rw [hb0, map_zero, zero_mul, add_zero] at hb
        exact hb
      funext k
      rcases Fin.eq_castSucc_or_eq_last k with ⟨j, rfl⟩ | rfl
      · exact congrFun hb' j
      · exact hb0

  have hpole : ∀ h : F, ∃ N : ℕ, wcValGe F (w i) (-(N : ℤ)) h := by
    intro h
    by_cases h0 : h = 0
    · exact ⟨0, Or.inl h0⟩
    · refine ⟨(-(w i (Additive.ofMul (Units.mk0 h h0)))).toNat, Or.inr ⟨h0, ?_⟩⟩
      have := Int.self_le_toNat (-(w i (Additive.ofMul (Units.mk0 h h0))))
      omega

  let O : Submodule K F :=
    { carrier := {h | wcValGe F (w i) 0 h}
      add_mem' := fun ha hb => VG_add ha hb
      zero_mem' := Or.inl rfl
      smul_mem' := fun c h hh => by
        show wcValGe F (w i) 0 (c • h)
        rw [Algebra.smul_def]
        exact VG_mul 0 0 0 _ _ (by ring) (VG_const c) hh }
  have hO : ∀ h, h ∈ O ↔ wcValGe F (w i) 0 h := fun h => Iff.rfl
  let P : Submodule K F := Submodule.span K (Set.range (fun k : ℕ => (t : F)⁻¹ ^ (k + 1)))
  have hmemP : ∀ (N : ℕ) (b : Fin N → K),
      ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1) ∈ P := by
    intro N b
    refine Submodule.sum_mem _ (fun k _ => ?_)
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(k : ℕ), rfl⟩)
  have hdisj : Disjoint O P := by
    rw [Submodule.disjoint_def]
    intro x hxO hxP
    obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hxP
    obtain ⟨N, hN⟩ := Finset.exists_nat_subset_range c.support
    have hx : x = ∑ k : Fin N, algebraMap K F (c k) * (t : F)⁻¹ ^ ((k : ℕ) + 1) := by
      rw [← hc, Finsupp.sum_of_support_subset c hN (fun j a => a • (t : F)⁻¹ ^ (j + 1))
          (fun _ _ => zero_smul _ _),
        ← Fin.sum_univ_eq_sum_range (fun j => c j • (t : F)⁻¹ ^ (j + 1)) N]
      exact Finset.sum_congr rfl (fun k _ => Algebra.smul_def _ _)
    have hb := huniq N (fun k => c k) (by rw [hx] at hxO; exact hxO)
    rw [hx]
    exact Finset.sum_eq_zero (fun k _ => by
      rw [show c k = 0 from congrFun hb k, map_zero, zero_mul])
  have hcodisj : Codisjoint O P := by
    rw [Submodule.codisjoint_iff_exists_add_eq]
    intro z
    obtain ⟨N, hN⟩ := hpole z
    obtain ⟨b, hb⟩ := hexist N z hN
    exact ⟨_, _, hb, hmemP N b, sub_add_cancel _ _⟩
  have hcompl : IsCompl O P := isCompl_iff.mpr ⟨hdisj, hcodisj⟩
  obtain ⟨e, he1, he2, heP⟩ : ∃ e : F →ₗ[K] F, (∀ h, e h ∈ O) ∧ (∀ h, h ∈ O → e h = h) ∧
      (∀ x, x ∈ P → e x = 0) :=
    ⟨O.subtype ∘ₗ O.projectionOnto P hcompl, fun h => (O.projectionOnto P hcompl h).2,
      fun h hh => congrArg Subtype.val (Submodule.projectionOnto_apply_left hcompl ⟨h, hh⟩),
      fun x hx => congrArg Subtype.val (Submodule.projectionOnto_apply_right hcompl ⟨x, hx⟩)⟩
  have hE3 : ∀ k : ℕ, e ((t : F)⁻¹ ^ (k + 1)) = 0 :=
    fun k => heP _ (Submodule.subset_span ⟨k, rfl⟩)
  have hE4 : ∀ (N : ℕ) (h : F), wcValGe F (w i) (-(N : ℤ)) h → ∃ b : Fin N → K,
      h - e h = ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1) := by
    intro N h hN
    obtain ⟨b, hb⟩ := hexist N h hN
    refine ⟨b, ?_⟩
    have h1 : e h = e (h - ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) +
        e (∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) := by
      rw [← map_add, sub_add_cancel]
    rw [h1, he2 _ hb, heP _ (hmemP N b)]
    ring
  have hone : (1 : F) ∈ O := Or.inr ⟨one_ne_zero, le_of_eq (by
    rw [show Units.mk0 (1 : F) one_ne_zero = 1 from Units.ext rfl, ofMul_one, map_zero])⟩

  obtain ⟨ψ, hψdef⟩ : ∃ ψ : F →ₗ[K] F, ∀ h, ψ h = e ((t : F) * (h - e h)) :=
    ⟨e ∘ₗ LinearMap.mulLeft K (t : F) ∘ₗ (LinearMap.id - e), fun h => rfl⟩
  have hψ : ∀ h, ∃ a : K, algebraMap K F a = ψ h := by
    intro h
    obtain ⟨N, hN⟩ := hpole h
    obtain ⟨b, hb⟩ := hE4 N h hN
    have hterm : ∀ k : Fin N, (t : F) * (algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) =
        b k • (t : F)⁻¹ ^ (k : ℕ) := by
      intro k
      have htt : (t : F) * (t : F)⁻¹ = 1 := mul_inv_cancel₀ ht0
      rw [Algebra.smul_def, pow_succ]
      linear_combination (algebraMap K F (b k) * (t : F)⁻¹ ^ (k : ℕ)) * htt
    rw [hψdef, hb, Finset.mul_sum, Finset.sum_congr rfl (fun k _ => hterm k), map_sum]
    cases N with
    | zero => exact ⟨0, by simp⟩
    | succ M =>
      have htail : ∀ j : Fin M, e (b j.succ • (t : F)⁻¹ ^ ((j.succ : ℕ))) = 0 := by
        intro j
        rw [Fin.val_succ, map_smul, hE3, smul_zero]
      rw [Fin.sum_univ_succ, Finset.sum_eq_zero (fun j _ => htail j), add_zero, Fin.val_zero,
        pow_zero, map_smul, he2 1 hone, ← Algebra.algebraMap_eq_smul_one]
      exact ⟨b 0, rfl⟩
  let L : K →ₗ[K] F := Algebra.linearMap K F
  have hLinj : Function.Injective L := fun a b hab => (algebraMap K F).injective hab
  have hmem : ∀ h, ψ h ∈ LinearMap.range L := fun h => by
    obtain ⟨a, ha⟩ := hψ h
    exact ⟨a, ha⟩
  refine ⟨e, (LinearEquiv.ofInjective L hLinj).symm.toLinearMap ∘ₗ
    ψ.codRestrict (LinearMap.range L) hmem, he1, he2, hE3, hE4, ?_⟩
  intro h
  have key := LinearEquiv.ofInjective_apply L (h := hLinj)
    ((LinearEquiv.ofInjective L hLinj).symm (ψ.codRestrict (LinearMap.range L) hmem h))
  rw [LinearEquiv.apply_symm_apply] at key
  rw [← hψdef]
  exact key.symm

theorem wcpa_rf_local_tres : ∀ (K F I : Type u) [Field K] [Field F] [Algebra K F] (w : I → Additive Fˣ →+ ℤ), wcValFamily K F I w → ∀ (i : I) (t : Fˣ), w i (Additive.ofMul t) = 1 → ∀ (e : F →ₗ[K] F) (c : F →ₗ[K] K), (∀ h, wcValGe F (w i) 0 (e h)) → (∀ h, wcValGe F (w i) 0 h → e h = h) → (∀ k : ℕ, e ((t : F)⁻¹ ^ (k + 1)) = 0) → (∀ (N : ℕ) (h : F), wcValGe F (w i) (-(N : ℤ)) h → ∃ b : Fin N → K, h - e h = ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) → (∀ h, algebraMap K F (c h) = e ((t : F) * (h - e h))) → (∀ g : F, FiniteDimensional K (LinearMap.range ((1 - e) * LinearMap.mulLeft K g * e))) ∧ (∀ g : F, wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K (t : F)) = c g) ∧ (∀ (m : ℕ) (g r : F), wcValGe F (w i) (-(m : ℤ)) g → wcValGe F (w i) ((m : ℤ) + 1) r → wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K r) = 0) ∧ (∀ (g : F) (a : K), wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K (algebraMap K F a)) = 0) ∧ (∀ h, wcValGe F (w i) 0 h → c h = 0) :=
by
  intro K F I _ _ _ w hfam i t ht e c E1 E2 _E3 E4 E5
  classical

  have hmk_mul : ∀ (x y : F) (hx : x ≠ 0) (hy : y ≠ 0),
      w i (Additive.ofMul (Units.mk0 (x * y) (mul_ne_zero hx hy))) =
        w i (Additive.ofMul (Units.mk0 x hx)) + w i (Additive.ofMul (Units.mk0 y hy)) := by
    intro x y hx hy
    rw [show Units.mk0 (x * y) (mul_ne_zero hx hy) = Units.mk0 x hx * Units.mk0 y hy from
      Units.ext rfl, ofMul_mul, map_add]
  have V1 : ∀ (a b : ℤ) (g h : F), wcValGe F (w i) a g → wcValGe F (w i) b h →
      wcValGe F (w i) (a + b) (g * h) := by
    intro a b g h hg hh
    rcases hg with hg | ⟨hg0, hga⟩
    · left; rw [hg, zero_mul]
    rcases hh with hh | ⟨hh0, hhb⟩
    · left; rw [hh, mul_zero]
    right
    refine ⟨mul_ne_zero hg0 hh0, ?_⟩
    rw [hmk_mul g h hg0 hh0]
    omega
  have V2 : ∀ (a : ℤ) (g h : F), wcValGe F (w i) a g → wcValGe F (w i) a h →
      wcValGe F (w i) a (g + h) := by
    intro a g h hg hh
    by_cases hs : g + h = 0
    · left; exact hs
    rcases hg with hg | ⟨hg0, hga⟩
    · rw [hg, zero_add]; exact hh
    rcases hh with hh | ⟨hh0, hhb⟩
    · rw [hh, add_zero]; right; exact ⟨hg0, hga⟩
    right
    refine ⟨hs, ?_⟩
    have := hfam.1 i (Units.mk0 g hg0) (Units.mk0 h hh0) (Units.mk0 (g + h) hs)
      (by simp only [Units.val_mk0])
    exact le_trans (le_min hga hhb) this
  have V4 : ∀ (a b : ℤ) (g : F), b ≤ a → wcValGe F (w i) a g → wcValGe F (w i) b g := by
    intro a b g hab hg
    rcases hg with hg | ⟨hg0, hga⟩
    · left; exact hg
    · right; exact ⟨hg0, le_trans hab hga⟩
  have V5 : ∀ a : K, wcValGe F (w i) 0 (algebraMap K F a) := by
    intro a
    by_cases ha : algebraMap K F a = 0
    · left; exact ha
    · right
      refine ⟨ha, ?_⟩
      exact (hfam.2.2.2 (Units.mk0 _ ha)).mpr ⟨a, by rw [Units.val_mk0]⟩ i
  have Vsum : ∀ (a : ℤ) (n : ℕ) (f : Fin n → F), (∀ k, wcValGe F (w i) a (f k)) →
      wcValGe F (w i) a (∑ k, f k) := by
    intro a n f hf
    exact Finset.sum_induction f (wcValGe F (w i) a) (fun x y hx hy => V2 a x y hx hy)
      (Or.inl rfl) (fun k _ => hf k)

  have Ee : ∀ h, e (e h) = e h := fun h => E2 _ (E1 h)
  have F1 : ∀ x, wcValGe F (w i) 0 x → ∀ z, e (x * e z) = x * e z := by
    intro x hx z
    apply E2
    have := V1 0 0 x (e z) hx (E1 z)
    rwa [zero_add] at this
  have ht0 : wcValGe F (w i) 0 (t : F) := by
    refine Or.inr ⟨t.ne_zero, ?_⟩
    rw [Units.mk0_val, ht]
    norm_num
  have hop : ∀ (x y z : F),
      (e * LinearMap.mulLeft K x * (1 - e) * LinearMap.mulLeft K y * e) z =
        e (x * (y * e z - e (y * e z))) := by
    intro x y z
    simp only [Module.End.mul_apply, LinearMap.sub_apply, Module.End.one_apply,
      LinearMap.mulLeft_apply]
  have F3 : ∀ x y : F, wcValGe F (w i) 0 x →
      e * LinearMap.mulLeft K y * (1 - e) * LinearMap.mulLeft K x * e = 0 := by
    intro x y hx
    apply LinearMap.ext
    intro z
    rw [hop, F1 x hx z, sub_self, mul_zero, map_zero, LinearMap.zero_apply]

  have hv : ∀ h, wcValGe F (w i) 0 h → c h = 0 := by
    intro h hh
    apply (algebraMap K F).injective
    rw [E5, E2 h hh, sub_self, mul_zero, map_zero, map_zero]

  have hi : ∀ g : F, FiniteDimensional K (LinearMap.range ((1 - e) * LinearMap.mulLeft K g * e)) := by
    intro g
    by_cases hg : g = 0
    · subst hg
      have h0 : (1 - e) * LinearMap.mulLeft K (0 : F) * e = 0 := by
        apply LinearMap.ext
        intro z
        simp only [Module.End.mul_apply, LinearMap.mulLeft_apply, zero_mul, map_zero,
          LinearMap.zero_apply]
      rw [h0, LinearMap.range_zero]
      infer_instance
    · obtain ⟨m, hm⟩ : ∃ m : ℕ, -(m : ℤ) ≤ w i (Additive.ofMul (Units.mk0 g hg)) :=
        ⟨(-(w i (Additive.ofMul (Units.mk0 g hg)))).toNat, by
          have := Int.self_le_toNat (-(w i (Additive.ofMul (Units.mk0 g hg))))
          omega⟩
      have hgm : wcValGe F (w i) (-(m : ℤ)) g := Or.inr ⟨hg, hm⟩
      have hspan : FiniteDimensional K
          (Submodule.span K (Set.range (fun k : Fin m => (t : F)⁻¹ ^ ((k : ℕ) + 1)))) :=
        FiniteDimensional.span_of_finite K (Set.finite_range _)
      apply Submodule.finiteDimensional_of_le
        (S₂ := Submodule.span K (Set.range (fun k : Fin m => (t : F)⁻¹ ^ ((k : ℕ) + 1))))
      rintro _ ⟨z, rfl⟩
      have hz : wcValGe F (w i) (-(m : ℤ)) (g * e z) := by
        have := V1 _ 0 g (e z) hgm (E1 z)
        rwa [add_zero] at this
      obtain ⟨b, hb⟩ := E4 m _ hz
      have hform : ((1 - e) * LinearMap.mulLeft K g * e) z = g * e z - e (g * e z) := by
        simp only [Module.End.mul_apply, LinearMap.sub_apply, Module.End.one_apply,
          LinearMap.mulLeft_apply]
      rw [hform, hb]
      refine Submodule.sum_mem _ (fun k _ => ?_)
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)

  have hii : ∀ g : F, wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K (t : F)) = c g := by
    intro g
    unfold wcpaRfTRes
    rw [F3 _ g ht0, sub_zero]
    set T := e * LinearMap.mulLeft K (t : F) * (1 - e) * LinearMap.mulLeft K g * e with hT
    have hTz : ∀ z, T z = algebraMap K F (c (g * e z)) := by
      intro z
      rw [hT, hop, E5]
    have he1 : e 1 = 1 := E2 1 (Or.inr ⟨one_ne_zero, by
      rw [show Units.mk0 (1 : F) one_ne_zero = 1 from Units.ext rfl, ofMul_one, map_zero]⟩)
    have hT1 : T 1 = algebraMap K F (c g) := by rw [hTz, he1, mul_one]
    have hR : LinearMap.range T ≤ Submodule.span K {(1 : F)} := by
      rintro _ ⟨z, rfl⟩
      rw [hTz, Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self 1)
    have : FiniteDimensional K (LinearMap.range T) := Submodule.finiteDimensional_of_le hR
    have hres : T.restrict (fun x _ => LinearMap.mem_range_self T x) = c g • LinearMap.id := by
      apply LinearMap.ext
      intro y
      apply Subtype.ext
      rw [LinearMap.coe_restrict_apply, LinearMap.smul_apply, LinearMap.id_apply,
        Submodule.coe_smul]
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hR y.2)
      rw [← ha, map_smul, hT1, Algebra.algebraMap_eq_smul_one, smul_comm]
    unfold wcpaRfFrTr
    rw [hres, map_smul, LinearMap.trace_id, smul_eq_mul]
    by_cases hc : c g = 0
    · rw [hc, zero_mul]
    · have hne : LinearMap.range T ≠ ⊥ := by
        intro hb
        have hmem : T 1 ∈ LinearMap.range T := LinearMap.mem_range_self T 1
        rw [hb, Submodule.mem_bot, hT1] at hmem
        exact hc ((algebraMap K F).injective (by rw [hmem, map_zero]))
      have h1 : Module.finrank K (LinearMap.range T) = 1 := by
        have hle := Submodule.finrank_mono hR
        rw [finrank_span_singleton one_ne_zero] at hle
        have h0 : Module.finrank K (LinearMap.range T) ≠ 0 :=
          fun h => hne (Submodule.finrank_eq_zero.mp h)
        omega
      rw [h1, Nat.cast_one, mul_one]

  have hiii : ∀ (m : ℕ) (g r : F), wcValGe F (w i) (-(m : ℤ)) g →
      wcValGe F (w i) ((m : ℤ) + 1) r →
      wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K r) = 0 := by
    intro m g r hg hr
    have hr0 : wcValGe F (w i) 0 r := V4 _ 0 r (by omega) hr
    unfold wcpaRfTRes
    rw [F3 _ g hr0, sub_zero]
    set N := e * LinearMap.mulLeft K r * (1 - e) * LinearMap.mulLeft K g * e with hN
    have n0 : ∀ n : ℕ, wcValGe F (w i) (-((n : ℤ) + 1)) ((t : F)⁻¹ ^ (n + 1)) := by
      intro n
      have hne : (t : F)⁻¹ ^ (n + 1) ≠ 0 := pow_ne_zero _ (inv_ne_zero t.ne_zero)
      refine Or.inr ⟨hne, ?_⟩
      have hu : Units.mk0 ((t : F)⁻¹ ^ (n + 1)) hne = t⁻¹ ^ (n + 1) := Units.ext (by simp)
      rw [hu, ofMul_pow, ofMul_inv, map_nsmul, map_neg, ht, smul_neg, nsmul_eq_mul, mul_one]
      push_cast
      omega
    have hNy : ∀ y, N y = e (r * (g * e y - e (g * e y))) := fun y => by rw [hN, hop]
    have n2 : ∀ (j : ℕ) (y : F), wcValGe F (w i) (j : ℤ) y →
        wcValGe F (w i) ((j : ℤ) + 1) (N y) ∧ (m ≤ j → N y = 0) := by
      intro j y hy
      have hy0 : wcValGe F (w i) 0 y := V4 _ 0 y (by omega) hy
      have hgy : wcValGe F (w i) (-(m : ℤ) + j) (g * y) := V1 _ _ g y hg hy
      rw [hNy, E2 y hy0]
      by_cases hmj : m ≤ j
      · have hgy0 : wcValGe F (w i) 0 (g * y) := V4 _ 0 _ (by omega) hgy
        rw [E2 _ hgy0, sub_self, mul_zero, map_zero]
        exact ⟨Or.inl rfl, fun _ => rfl⟩
      · refine ⟨?_, fun h => absurd h hmj⟩
        obtain ⟨b, hb⟩ := E4 (m - j) (g * y) (V4 _ _ _ (by omega) hgy)
        have hs : wcValGe F (w i) ((j : ℤ) + 1) (r * (g * y - e (g * y))) := by
          rw [hb, Finset.mul_sum]
          apply Vsum
          intro k
          have hk := k.2
          have h1 := V1 _ _ r _ hr (n0 k)
          have h2 := V1 0 _ (algebraMap K F (b k)) _ (V5 (b k))
            (V4 _ ((j : ℤ) + 1) _ (by omega) h1)
          rw [zero_add] at h2
          have hrw : r * (algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) =
              algebraMap K F (b k) * (r * (t : F)⁻¹ ^ ((k : ℕ) + 1)) := by ring
          rw [hrw]
          exact h2
        rw [E2 _ (V4 _ 0 _ (by omega) hs)]
        exact hs
    have n3 : ∀ (k : ℕ) (z : F), wcValGe F (w i) (k : ℤ) ((N ^ (k + 1)) z) := by
      intro k
      induction k with
      | zero =>
        intro z
        simp only [zero_add, pow_one, Nat.cast_zero]
        rw [hNy]
        exact E1 _
      | succ k ih =>
        intro z
        rw [pow_succ', Module.End.mul_apply]
        push_cast
        exact (n2 k _ (ih z)).1
    have hnil : N ^ (m + 2) = 0 := by
      show N ^ (m + 1 + 1) = 0
      apply LinearMap.ext
      intro z
      rw [pow_succ', Module.End.mul_apply, LinearMap.zero_apply]
      exact (n2 m _ (n3 m z)).2 le_rfl
    have hpow : ∀ (n : ℕ) (y : LinearMap.range N),
        (((N.restrict (fun x _ => LinearMap.mem_range_self N x)) ^ n) y : F) = (N ^ n) (y : F) := by
      intro n
      induction n with
      | zero => intro y; simp
      | succ n ih =>
        intro y
        rw [pow_succ', Module.End.mul_apply, LinearMap.coe_restrict_apply, ih]
        rw [pow_succ' N n]
        rfl
    unfold wcpaRfFrTr
    apply IsNilpotent.eq_zero
    apply LinearMap.isNilpotent_trace_of_isNilpotent
    refine ⟨m + 2, LinearMap.ext fun y => Subtype.ext ?_⟩
    rw [hpow, hnil]
    simp

  have hiv : ∀ (g : F) (a : K),
      wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K (algebraMap K F a)) = 0 := by
    intro g a
    unfold wcpaRfTRes
    rw [F3 _ g (V5 a), sub_zero]
    have h0 : e * LinearMap.mulLeft K (algebraMap K F a) * (1 - e) * LinearMap.mulLeft K g * e
        = 0 := by
      apply LinearMap.ext
      intro z
      rw [hop, LinearMap.zero_apply, ← Algebra.smul_def, map_smul, map_sub, Ee, sub_self,
        smul_zero]
    rw [h0]
    unfold wcpaRfFrTr
    apply IsNilpotent.eq_zero
    apply LinearMap.isNilpotent_trace_of_isNilpotent
    refine ⟨1, LinearMap.ext fun y => Subtype.ext ?_⟩
    rw [pow_one, LinearMap.coe_restrict_apply]
    simp
  exact ⟨hi, hii, hiii, hiv, hv⟩

theorem wcpa_rf_tres_leibniz : ∀ (K E : Type u) [Field K] [AddCommGroup E] [Module K E] (e f g h : Module.End K E), e * e = e → f * g = g * f → f * h = h * f → g * h = h * g → FiniteDimensional K (LinearMap.range ((1 - e) * f * e)) → FiniteDimensional K (LinearMap.range ((1 - e) * g * e)) → FiniteDimensional K (LinearMap.range ((1 - e) * h * e)) → wcpaRfTRes e f (g * h) = wcpaRfTRes e (f * g) h + wcpaRfTRes e (f * h) g ∧ wcpaRfTRes e f (g + h) = wcpaRfTRes e f g + wcpaRfTRes e f h ∧ ∀ a : K, wcpaRfTRes e f (a • g) = a * wcpaRfTRes e f g :=
by
  intro K E _ _ _ e f g h he hfg hfh hgh hf hg hh

  have s1 : ∀ (V : Submodule K E), FiniteDimensional K V → ∀ (α : E →ₗ[K] V) (β : V →ₗ[K] E),
      wcpaRfFrTr (β ∘ₗ α) = LinearMap.trace K V (α ∘ₗ β) := by
    intro V hV α β
    have hle : LinearMap.range (β ∘ₗ α) ≤ LinearMap.range β := LinearMap.range_comp_le_range α β
    haveI hRf : FiniteDimensional K (LinearMap.range β) := LinearMap.finiteDimensional_range β
    haveI hR0f : FiniteDimensional K (LinearMap.range (β ∘ₗ α)) :=
      Submodule.finiteDimensional_of_le hle
    let j : LinearMap.range (β ∘ₗ α) →ₗ[K] LinearMap.range β := Submodule.inclusion hle
    let ρ₀ : LinearMap.range β →ₗ[K] LinearMap.range (β ∘ₗ α) :=
      ((β ∘ₗ α) ∘ₗ (LinearMap.range β).subtype).codRestrict (LinearMap.range (β ∘ₗ α))
        (fun x => LinearMap.mem_range_self _ _)
    let β' : V →ₗ[K] LinearMap.range β := β.rangeRestrict
    let γ : LinearMap.range β →ₗ[K] V := α ∘ₗ (LinearMap.range β).subtype
    have e1 : (β ∘ₗ α).restrict (fun x _ => LinearMap.mem_range_self (β ∘ₗ α) x) = ρ₀ ∘ₗ j := by
      ext x; rfl
    have e2 : j ∘ₗ ρ₀ = β' ∘ₗ γ := by ext x; rfl
    have e3 : γ ∘ₗ β' = α ∘ₗ β := by ext x; rfl
    unfold wcpaRfFrTr
    rw [e1, LinearMap.trace_comp_comm' j ρ₀, e2, LinearMap.trace_comp_comm' γ β', e3]

  have kf : ∀ (W : Submodule K E), FiniteDimensional K W → ∀ (U : Module.End K E)
      (hU : ∀ x, U x ∈ W),
      wcpaRfFrTr U = LinearMap.trace K W ((U.codRestrict W hU) ∘ₗ W.subtype) := by
    intro W hW U hU
    have h1 := s1 W hW (U.codRestrict W hU) W.subtype
    have e : W.subtype ∘ₗ U.codRestrict W hU = U := by ext x; rfl
    rw [e] at h1
    exact h1

  have trA : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) →
      wcpaRfFrTr (S + T) = wcpaRfFrTr S + wcpaRfFrTr T := by
    intro S T hS hT
    have hW : FiniteDimensional K ↥(LinearMap.range S ⊔ LinearMap.range T) := inferInstance
    have mS : ∀ x, S x ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun x => Submodule.mem_sup_left (LinearMap.mem_range_self S x)
    have mT : ∀ x, T x ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun x => Submodule.mem_sup_right (LinearMap.mem_range_self T x)
    have mST : ∀ x, (S + T) x ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun x => Submodule.add_mem _ (mS x) (mT x)
    rw [kf _ hW (S + T) mST, kf _ hW S mS, kf _ hW T mT]
    have e : (S + T).codRestrict _ mST ∘ₗ (LinearMap.range S ⊔ LinearMap.range T).subtype =
        S.codRestrict _ mS ∘ₗ (LinearMap.range S ⊔ LinearMap.range T).subtype +
        T.codRestrict _ mT ∘ₗ (LinearMap.range S ⊔ LinearMap.range T).subtype := by
      ext x; rfl
    rw [e, LinearMap.map_add]
  have trS : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) →
      wcpaRfFrTr (S - T) = wcpaRfFrTr S - wcpaRfFrTr T := by
    intro S T hS hT
    have hW : FiniteDimensional K ↥(LinearMap.range S ⊔ LinearMap.range T) := inferInstance
    have mS : ∀ x, S x ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun x => Submodule.mem_sup_left (LinearMap.mem_range_self S x)
    have mT : ∀ x, T x ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun x => Submodule.mem_sup_right (LinearMap.mem_range_self T x)
    have mST : ∀ x, (S - T) x ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun x => Submodule.sub_mem _ (mS x) (mT x)
    rw [kf _ hW (S - T) mST, kf _ hW S mS, kf _ hW T mT]
    have e : (S - T).codRestrict _ mST ∘ₗ (LinearMap.range S ⊔ LinearMap.range T).subtype =
        S.codRestrict _ mS ∘ₗ (LinearMap.range S ⊔ LinearMap.range T).subtype -
        T.codRestrict _ mT ∘ₗ (LinearMap.range S ⊔ LinearMap.range T).subtype := by
      ext x; rfl
    rw [e, LinearMap.map_sub]
  have trM : ∀ T : Module.End K E, FiniteDimensional K (LinearMap.range T) →
      ∀ a : K, wcpaRfFrTr (a • T) = a * wcpaRfFrTr T := by
    intro T hT a
    have mT : ∀ x, T x ∈ LinearMap.range T := fun x => LinearMap.mem_range_self T x
    have maT : ∀ x, (a • T) x ∈ LinearMap.range T := fun x => Submodule.smul_mem _ a (mT x)
    rw [kf _ hT (a • T) maT, kf _ hT T mT]
    have e : (a • T).codRestrict _ maT ∘ₗ (LinearMap.range T).subtype =
        a • (T.codRestrict _ mT ∘ₗ (LinearMap.range T).subtype) := by
      ext x; rfl
    rw [e, LinearMap.map_smul, smul_eq_mul]

  have trC : ∀ P Q : Module.End K E, FiniteDimensional K (LinearMap.range Q) →
      wcpaRfFrTr (P * Q) = wcpaRfFrTr (Q * P) := by
    intro P Q hQ
    have e1 : P * Q = (P ∘ₗ (LinearMap.range Q).subtype) ∘ₗ Q.rangeRestrict := by ext x; rfl
    have e2 : Q * P = (LinearMap.range Q).subtype ∘ₗ (Q.rangeRestrict ∘ₗ P) := by ext x; rfl
    rw [e1, e2, s1 _ hQ Q.rangeRestrict, s1 _ hQ (Q.rangeRestrict ∘ₗ P)]
    rfl

  have frE : ∀ P Q : Module.End K E, FiniteDimensional K (LinearMap.range Q) →
      FiniteDimensional K (LinearMap.range (P * Q)) := by
    intro P Q hQ
    have hle : LinearMap.range (P * Q) ≤ LinearMap.range (P ∘ₗ (LinearMap.range Q).subtype) := by
      rintro _ ⟨y, rfl⟩
      exact ⟨⟨Q y, LinearMap.mem_range_self Q y⟩, rfl⟩
    exact Submodule.finiteDimensional_of_le hle
  have frF : ∀ P Q : Module.End K E, FiniteDimensional K (LinearMap.range Q) →
      FiniteDimensional K (LinearMap.range (Q * P)) := by
    intro P Q hQ
    have hle : LinearMap.range (Q * P) ≤ LinearMap.range Q := by
      rintro _ ⟨y, rfl⟩
      exact ⟨P y, rfl⟩
    exact Submodule.finiteDimensional_of_le hle
  have frA : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) → FiniteDimensional K (LinearMap.range (S + T)) := by
    intro S T hS hT
    have hle : LinearMap.range (S + T) ≤ LinearMap.range S ⊔ LinearMap.range T := by
      rintro _ ⟨y, rfl⟩
      exact Submodule.add_mem_sup (LinearMap.mem_range_self S y) (LinearMap.mem_range_self T y)
    exact Submodule.finiteDimensional_of_le hle
  have frS : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) → FiniteDimensional K (LinearMap.range (S - T)) := by
    intro S T hS hT
    have hle : LinearMap.range (S - T) ≤ LinearMap.range S ⊔ LinearMap.range T := by
      rintro _ ⟨y, rfl⟩
      exact Submodule.sub_mem _ (Submodule.mem_sup_left (LinearMap.mem_range_self S y))
        (Submodule.mem_sup_right (LinearMap.mem_range_self T y))
    exact Submodule.finiteDimensional_of_le hle

  have R1 : ∀ u v : Module.End K E, e * (u * v) * e = e * u * e * (e * v * e) + e * u * (1 - e) * v * e := by
    intro u v
    have h1 : e * u * e * (e * v * e) = e * u * e * v * e := by
      rw [show e * u * e * (e * v * e) = e * u * (e * e) * v * e by noncomm_ring, he]
    rw [h1]
    noncomm_ring
  have R2 : ∀ u v : Module.End K E, u * v = v * u →
      e * v * (1 - e) * u * e - e * u * (1 - e) * v * e =
        e * u * e * (e * v * e) - e * v * e * (e * u * e) := by
    intro u v huv
    have h1 := R1 u v
    have h2 := R1 v u
    rw [huv] at h1
    rw [h1] at h2
    rw [sub_eq_sub_iff_add_eq_add, h2]
    exact add_comm _ _
  have c1 : f * (g * h) = (g * h) * f := by
    rw [← mul_assoc f g h, hfg, mul_assoc g f h, hfh, ← mul_assoc g h f]
  have c2 : (f * g) * h = h * (f * g) := by
    rw [mul_assoc f g h, hgh, ← mul_assoc f h g, hfh, mul_assoc h f g]
  have c3 : (f * h) * g = g * (f * h) := by
    rw [mul_assoc f h g, ← hgh, ← mul_assoc f g h, hfg, mul_assoc g f h]
  have key : e * (g * h) * (1 - e) * f * e - e * f * (1 - e) * (g * h) * e =
      (e * h * (1 - e) * (f * g) * e - e * (f * g) * (1 - e) * h * e) +
      (e * g * (1 - e) * (f * h) * e - e * (f * h) * (1 - e) * g * e) +
      (e * g * e * (e * h * (1 - e) * f * e - e * f * (1 - e) * h * e) -
        (e * h * (1 - e) * f * e - e * f * (1 - e) * h * e) * (e * g * e)) +
      (e * f * e * (e * g * (1 - e) * h * e) - (e * g * (1 - e) * h * e) * (e * f * e)) +
      (e * h * e * (e * f * (1 - e) * g * e) - (e * f * (1 - e) * g * e) * (e * h * e)) +
      (e * g * e * (e * f * (1 - e) * h * e) - (e * f * (1 - e) * h * e) * (e * g * e)) := by
    rw [R2 f (g * h) c1, R2 (f * g) h c2, R2 (f * h) g c3, R2 f h hfh, R1 g h, R1 f g, R1 f h]
    generalize e * g * (1 - e) * h * e = x
    generalize e * f * (1 - e) * g * e = y
    generalize e * f * (1 - e) * h * e = z
    generalize e * f * e = F
    generalize e * g * e = G
    generalize e * h * e = H
    noncomm_ring

  have hb : ∀ u v : Module.End K E, FiniteDimensional K (LinearMap.range ((1 - e) * v * e)) →
      FiniteDimensional K (LinearMap.range (e * u * (1 - e) * v * e)) := by
    intro u v hv
    have e1 : e * u * (1 - e) * v * e = (e * u) * ((1 - e) * v * e) := by simp only [mul_assoc]
    rw [e1]
    exact frE _ _ hv
  have hc : ∀ u v : Module.End K E, FiniteDimensional K (LinearMap.range ((1 - e) * u * e)) →
      FiniteDimensional K (LinearMap.range ((1 - e) * v * e)) →
      FiniteDimensional K (LinearMap.range (e * v * (1 - e) * u * e - e * u * (1 - e) * v * e)) :=
    fun u v hu hv => frS _ _ (hb v u hu) (hb u v hv)
  have ha : ∀ u v : Module.End K E, FiniteDimensional K (LinearMap.range ((1 - e) * u * e)) →
      FiniteDimensional K (LinearMap.range ((1 - e) * v * e)) →
      FiniteDimensional K (LinearMap.range ((1 - e) * (u * v) * e)) := by
    intro u v hu hv
    have e1 : (1 - e) * (u * v) * e = ((1 - e) * u * e) * (v * e) + ((1 - e) * u) * ((1 - e) * v * e) := by
      noncomm_ring
    rw [e1]
    exact frA _ _ (frF _ _ hu) (frE _ _ hv)
  have hK : ∀ P Q : Module.End K E, FiniteDimensional K (LinearMap.range Q) →
      FiniteDimensional K (LinearMap.range (P * Q - Q * P)) ∧ wcpaRfFrTr (P * Q - Q * P) = 0 := by
    intro P Q hQ
    refine ⟨frS _ _ (frE _ _ hQ) (frF _ _ hQ), ?_⟩
    rw [trS _ _ (frE _ _ hQ) (frF _ _ hQ), trC P Q hQ, sub_self]
  have hA1 := hc (f * g) h (ha f g hf hg) hh
  have hA2 := hc (f * h) g (ha f h hf hh) hg
  have hXg := hc f g hf hg
  have hXh := hc f h hf hh
  obtain ⟨hK1, tK1⟩ := hK (e * g * e) _ hXh
  obtain ⟨hK2, tK2⟩ := hK (e * f * e) _ (hb g h hh)
  obtain ⟨hK3, tK3⟩ := hK (e * h * e) _ (hb f g hg)
  obtain ⟨hK4, tK4⟩ := hK (e * g * e) _ (hb f h hh)
  have h1 := frA _ _ hA1 hA2
  have h12 := frA _ _ h1 hK1
  have h123 := frA _ _ h12 hK2
  have h1234 := frA _ _ h123 hK3
  refine ⟨?_, ?_, ?_⟩
  · unfold wcpaRfTRes
    rw [key, trA _ _ h1234 hK4, tK4, add_zero, trA _ _ h123 hK3, tK3, add_zero,
      trA _ _ h12 hK2, tK2, add_zero, trA _ _ h1 hK1, tK1, add_zero, trA _ _ hA1 hA2]
  · unfold wcpaRfTRes
    have e1 : e * (g + h) * (1 - e) * f * e - e * f * (1 - e) * (g + h) * e =
        (e * g * (1 - e) * f * e - e * f * (1 - e) * g * e) +
        (e * h * (1 - e) * f * e - e * f * (1 - e) * h * e) := by
      noncomm_ring
    rw [e1, trA _ _ hXg hXh]
  · intro a
    unfold wcpaRfTRes
    have e1 : e * (a • g) * (1 - e) * f * e - e * f * (1 - e) * (a • g) * e =
        a • (e * g * (1 - e) * f * e - e * f * (1 - e) * g * e) := by
      simp only [mul_smul_comm, smul_mul_assoc, ← smul_sub]
    rw [e1, trM _ hXg a]

theorem wcpa_rf_chain_rule : ∀ (K F I : Type u) [Field K] [Field F] [Algebra K F] (w : I → Additive Fˣ →+ ℤ), wcValFamily K F I w → wcRRResidue K F I w → ∀ (i : I) (t : Fˣ), w i (Additive.ofMul t) = 1 → ∀ (e : F →ₗ[K] F) (c : F →ₗ[K] K), (∀ h, wcValGe F (w i) 0 (e h)) → (∀ h, wcValGe F (w i) 0 h → e h = h) → (∀ k : ℕ, e ((t : F)⁻¹ ^ (k + 1)) = 0) → (∀ (N : ℕ) (h : F), wcValGe F (w i) (-(N : ℤ)) h → ∃ b : Fin N → K, h - e h = ∑ k : Fin N, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1)) → (∀ h, algebraMap K F (c h) = e ((t : F) * (h - e h))) → ∀ (D : Derivation K F F) (hDt : D (t : F) ≠ 0), (∀ y : F, wcValGe F (w i) 0 y → ∀ hy : D y ≠ 0, w i (Additive.ofMul (Units.mk0 _ hDt)) ≤ w i (Additive.ofMul (Units.mk0 _ hy))) → ∀ g x : F, wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K x) = c (g * (D x / D (t : F))) :=
by
  intro K F I _ _ _ w hfam _hR i t ht e c E1 E2 E3 E4 E5 D hDt hθ
  obtain ⟨L1, L2, L3, L4, L5⟩ := wcpa_rf_local_tres K F I w hfam i t ht e c E1 E2 E3 E4 E5

  have ht0 : (t : F) ≠ 0 := Units.ne_zero t
  have hts : (t : F) * (t : F)⁻¹ = 1 := mul_inv_cancel₀ ht0
  have vmul : ∀ (a b : ℤ) (g h : F), wcValGe F (w i) a g → wcValGe F (w i) b h →
      wcValGe F (w i) (a + b) (g * h) := by
    intro a b g h hg hh
    rcases hg with hg | ⟨hg0, hga⟩
    · left; rw [hg, zero_mul]
    rcases hh with hh | ⟨hh0, hhb⟩
    · left; rw [hh, mul_zero]
    right
    refine ⟨mul_ne_zero hg0 hh0, ?_⟩
    have e1 : Units.mk0 (g * h) (mul_ne_zero hg0 hh0) = Units.mk0 g hg0 * Units.mk0 h hh0 :=
      Units.ext rfl
    rw [e1, ofMul_mul, map_add]
    linarith
  have vmono : ∀ (a b : ℤ) (g : F), b ≤ a → wcValGe F (w i) a g → wcValGe F (w i) b g := by
    intro a b g hab hg
    rcases hg with hg | ⟨hg0, hga⟩
    · left; exact hg
    · right; exact ⟨hg0, le_trans hab hga⟩
  have vt : wcValGe F (w i) 1 (t : F) := by
    right
    refine ⟨ht0, ?_⟩
    rw [show Units.mk0 (t : F) ht0 = t from Units.ext rfl, ht]
  have vs : wcValGe F (w i) (-1) (t : F)⁻¹ := by
    right
    refine ⟨inv_ne_zero ht0, ?_⟩
    rw [show Units.mk0 (t : F)⁻¹ (inv_ne_zero ht0) = t⁻¹ from Units.ext (by simp), ofMul_inv,
      map_neg, ht]
  have vall : ∀ g : F, ∃ n : ℕ, wcValGe F (w i) (-(n : ℤ)) g := by
    intro g
    by_cases hg : g = 0
    · exact ⟨0, Or.inl hg⟩
    · refine ⟨(-(w i (Additive.ofMul (Units.mk0 g hg)))).toNat, Or.inr ⟨hg, ?_⟩⟩
      have := Int.self_le_toNat (-(w i (Additive.ofMul (Units.mk0 g hg))))
      omega
  have vadd0 : ∀ a b : F, wcValGe F (w i) 0 a → wcValGe F (w i) 0 b →
      wcValGe F (w i) 0 (a + b) := by
    intro a b ha hb
    rcases ha with ha | ⟨ha0, hav⟩
    · rw [ha, zero_add]; exact hb
    rcases hb with hb | ⟨hb0, hbv⟩
    · rw [hb, add_zero]; exact Or.inr ⟨ha0, hav⟩
    by_cases hab : a + b = 0
    · left; exact hab
    right
    refine ⟨hab, ?_⟩
    have := hfam.1 i (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) rfl
    exact le_trans (le_min hav hbv) this

  have o1 : e * e = e := by
    apply LinearMap.ext
    intro h
    rw [Module.End.mul_apply]
    exact E2 _ (E1 h)
  have o2 : ∀ a b : F, LinearMap.mulLeft K a * LinearMap.mulLeft K b =
      LinearMap.mulLeft K b * LinearMap.mulLeft K a := by
    intro a b
    apply LinearMap.ext
    intro z
    simp only [Module.End.mul_apply, LinearMap.mulLeft_apply]
    ring
  have o3 : ∀ a b : F, LinearMap.mulLeft K a * LinearMap.mulLeft K b =
      LinearMap.mulLeft K (a * b) := by
    intro a b
    apply LinearMap.ext
    intro z
    simp only [Module.End.mul_apply, LinearMap.mulLeft_apply]
    ring
  have o4 : ∀ a b : F, LinearMap.mulLeft K a + LinearMap.mulLeft K b =
      LinearMap.mulLeft K (a + b) := by
    intro a b
    apply LinearMap.ext
    intro z
    simp only [LinearMap.add_apply, LinearMap.mulLeft_apply]
    ring
  have LB := fun g x y : F => wcpa_rf_tres_leibniz K F e (LinearMap.mulLeft K g)
    (LinearMap.mulLeft K x) (LinearMap.mulLeft K y) o1 (o2 g x) (o2 g y) (o2 x y)
    (L1 g) (L1 x) (L1 y)

  have hvanish : ∀ Φ : F → F → K, (∀ g x y : F, Φ g (x + y) = Φ g x + Φ g y) →
      (∀ g x y : F, Φ g (x * y) = Φ (g * x) y + Φ (g * y) x) →
      (∀ (g : F) (a : K), Φ g (algebraMap K F a) = 0) → (∀ g : F, Φ g (t : F) = 0) →
      (∀ g y : F, wcValGe F (w i) 0 g → wcValGe F (w i) 0 y → Φ g ((t : F) * y) = 0) →
      ∀ g x : F, Φ g x = 0 := by
    intro Φ hadd hleib hconst htt hdeep
    have h0 : ∀ g, Φ g 0 = 0 := fun g => by simpa using hconst g 0
    have h1 : ∀ g, Φ g 1 = 0 := fun g => by simpa using hconst g 1
    have hs : ∀ g, Φ g (t : F)⁻¹ = 0 := by
      intro g
      have := hleib (g * (t : F)⁻¹) (t : F) (t : F)⁻¹
      rw [hts, h1, htt, add_zero] at this
      have e2 : g * (t : F)⁻¹ * (t : F) = g := by
        rw [mul_assoc, inv_mul_cancel₀ ht0, mul_one]
      rw [e2] at this
      exact this.symm
    have hpow : ∀ k : ℕ, ∀ g, Φ g ((t : F)⁻¹ ^ (k + 1)) = 0 := by
      intro k
      induction k with
      | zero => intro g; rw [zero_add, pow_one]; exact hs g
      | succ k ih => intro g; rw [pow_succ, hleib, ih, hs, add_zero]
    have hscal : ∀ (k : ℕ) (a : K) (g : F),
        Φ g (algebraMap K F a * (t : F)⁻¹ ^ (k + 1)) = 0 := by
      intro k a g
      rw [hleib, hpow, hconst, add_zero]
    have taylor : ∀ y : F, wcValGe F (w i) 0 y → ∃ (b : K) (z : F), wcValGe F (w i) 0 z ∧
        y = algebraMap K F b + (t : F) * z := by
      intro y hy
      have hq : wcValGe F (w i) (-((1 : ℕ) : ℤ)) ((t : F)⁻¹ * y) := by
        have := vmul (-1) 0 _ _ vs hy
        have e3 : (-1 : ℤ) + 0 = -((1 : ℕ) : ℤ) := by norm_num
        rw [e3] at this
        exact this
      obtain ⟨b, hb⟩ := E4 1 _ hq
      refine ⟨b 0, e ((t : F)⁻¹ * y), E1 _, ?_⟩
      rw [Fin.sum_univ_one] at hb
      norm_num at hb
      linear_combination (t : F) * hb - (y - algebraMap K F (b 0)) * hts
    have hint : ∀ n : ℕ, ∀ g y : F, wcValGe F (w i) (-(n : ℤ)) g → wcValGe F (w i) 0 y →
        Φ g y = 0 := by
      intro n
      induction n with
      | zero =>
        intro g y hg hy
        obtain ⟨b, z, hz, rfl⟩ := taylor y hy
        rw [hadd, hconst, zero_add]
        exact hdeep g z (by simpa using hg) hz
      | succ n ih =>
        intro g y hg hy
        obtain ⟨b, z, hz, rfl⟩ := taylor y hy
        rw [hadd, hconst, zero_add, hleib, htt, add_zero]
        apply ih _ z _ hz
        have := vmul _ _ _ _ hg vt
        have e4 : -(((n + 1 : ℕ)) : ℤ) + 1 = -(n : ℤ) := by push_cast; ring
        rw [e4] at this
        exact this
    intro g x
    obtain ⟨p, hp⟩ := vall x
    obtain ⟨n, hn⟩ := vall g
    obtain ⟨b, hb⟩ := E4 p x hp
    have hx : x = e x + ∑ k : Fin p, algebraMap K F (b k) * (t : F)⁻¹ ^ ((k : ℕ) + 1) := by
      rw [← hb]; ring
    rw [hx, hadd, hint n g _ hn (E1 x), zero_add]
    apply Finset.sum_induction _ (fun y => Φ g y = 0)
    · intro y1 y2 hy1 hy2
      rw [hadd, hy1, hy2, add_zero]
    · exact h0 g
    · intro k _
      exact hscal (k : ℕ) (b k) g

  intro g x
  apply sub_eq_zero.mp
  refine hvanish (fun g x => wcpaRfTRes e (LinearMap.mulLeft K g) (LinearMap.mulLeft K x) -
    c (g * (D x / D (t : F)))) ?_ ?_ ?_ ?_ ?_ g x
  · intro g x y
    beta_reduce
    rw [← o4, (LB g x y).2.1, map_add D, add_div, mul_add, map_add c]
    ring
  · intro g x y
    beta_reduce
    rw [← o3 x y, (LB g x y).1, o3, o3, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    have e5 : g * ((x * D y + y * D x) / D (t : F)) =
        g * x * (D y / D (t : F)) + g * y * (D x / D (t : F)) := by ring
    rw [e5, map_add c]
    ring
  · intro g a
    beta_reduce
    rw [L4, Derivation.map_algebraMap, zero_div, mul_zero, map_zero, sub_zero]
  · intro g
    beta_reduce
    rw [L2, div_self hDt, mul_one, sub_self]
  · intro g y hg hy
    beta_reduce
    have P1 : wcValGe F (w i) 1 ((t : F) * y) := by
      have := vmul 1 0 _ _ vt hy
      rwa [add_zero] at this
    have hT := L3 0 g ((t : F) * y) (by simpa using hg) (by simpa using P1)
    have hq : wcValGe F (w i) 0 (D y / D (t : F)) := by
      by_cases hDy : D y = 0
      · left; rw [hDy, zero_div]
      · right
        refine ⟨div_ne_zero hDy hDt, ?_⟩
        have e1 : Units.mk0 (D y / D (t : F)) (div_ne_zero hDy hDt) =
            Units.mk0 (D y) hDy * (Units.mk0 (D (t : F)) hDt)⁻¹ :=
          Units.ext (by simp [div_eq_mul_inv])
        rw [e1, ofMul_mul, ofMul_inv, map_add, map_neg]
        have := hθ y hy hDy
        linarith
    have expand : g * (D ((t : F) * y) / D (t : F)) = g * y + g * (t : F) * (D y / D (t : F)) := by
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, add_div, mul_div_assoc, mul_div_assoc,
        div_self hDt]
      ring
    have P2 : wcValGe F (w i) 0 (g * (D ((t : F) * y) / D (t : F))) := by
      rw [expand]
      apply vadd0
      · have := vmul 0 0 _ _ hg hy
        rwa [add_zero] at this
      · have h1 := vmul 0 1 _ _ hg vt
        have h2 := vmul _ 0 _ _ h1 hq
        exact vmono _ 0 _ (by norm_num) h2
    rw [hT, L5 _ P2, sub_zero]

theorem wcpa_rf_frtr_diag : ∀ (K M I : Type u) [Field K] [AddCommGroup M] [Module K M] [DecidableEq I] (E : Submodule K (I → M)) (T : Module.End K E) (t : I → Module.End K M), (∀ (α : E) (i : I), (T α : I → M) i = t i ((α : I → M) i)) → ∀ (S : Finset I), (∀ i ∉ S, t i = 0) → (∀ i, FiniteDimensional K (LinearMap.range (t i))) → (∀ i ∈ S, ∀ m : M, (Pi.single i m : I → M) ∈ E) → FiniteDimensional K (LinearMap.range T) ∧ wcpaRfFrTr T = ∑ i ∈ S, wcpaRfFrTr (t i) :=
by
  intro K M I _ _ _ _ E T t hT S hS hfd hsingle
  haveI : ∀ j : S, FiniteDimensional K (LinearMap.range (t j.1)) := fun j => hfd j.1
  let B : ∀ j : S, E →ₗ[K] LinearMap.range (t j.1) := fun j =>
    LinearMap.codRestrict (LinearMap.range (t j.1))
      ((t j.1) ∘ₗ (LinearMap.proj j.1) ∘ₗ E.subtype) (fun α => LinearMap.mem_range_self _ _)
  let A : ∀ j : S, LinearMap.range (t j.1) →ₗ[K] E := fun j =>
    LinearMap.codRestrict E ((LinearMap.single K (fun _ : I => M) j.1) ∘ₗ
      (LinearMap.range (t j.1)).subtype) (fun r => hsingle j.1 j.2 (r : M))
  have hA : ∀ (j : S) (r : LinearMap.range (t j.1)), (A j r : I → M) = Pi.single j.1 (r : M) :=
    fun j r => rfl
  have hB : ∀ (j : S) (α : E), (B j α : M) = t j.1 ((α : I → M) j.1) := fun j α => rfl
  have hsum : ∀ α, T α = ∑ j : S, A j (B j α) := by
    intro α
    apply Subtype.ext
    rw [Submodule.coe_sum]
    funext k
    rw [Finset.sum_apply, hT]
    simp only [hA, hB]
    rw [Finset.sum_coe_sort S (fun i => Pi.single i (t i ((α : I → M) i)) k)]
    rw [Finset.sum_pi_single]
    split_ifs with hk
    · rfl
    · rw [hS k hk, LinearMap.zero_apply]
  have hAr : ∀ j r, A j r ∈ LinearMap.range T := by
    intro j r
    obtain ⟨m, hm⟩ := LinearMap.mem_range.mp r.2
    refine ⟨⟨Pi.single j.1 m, hsingle j.1 j.2 m⟩, ?_⟩
    apply Subtype.ext
    funext k
    rw [hT, hA]
    by_cases hk : k = j.1
    · rw [hk]
      show t j.1 ((Pi.single j.1 m : I → M) j.1) = (Pi.single j.1 (r : M) : I → M) j.1
      rw [Pi.single_eq_same, Pi.single_eq_same, hm]
    · show t k ((Pi.single j.1 m : I → M) k) = (Pi.single j.1 (r : M) : I → M) k
      rw [Pi.single_eq_of_ne hk, Pi.single_eq_of_ne hk, map_zero]
  haveI hUfd : FiniteDimensional K (LinearMap.range T) := by
    have hle : LinearMap.range T ≤ ⨆ j : S, LinearMap.range (A j) := by
      rintro _ ⟨x, rfl⟩
      rw [hsum x]
      exact Submodule.sum_mem _
        (fun j _ => Submodule.mem_iSup_of_mem j (LinearMap.mem_range_self (A j) _))
    haveI : ∀ j : S, FiniteDimensional K (LinearMap.range (A j)) :=
      fun j => LinearMap.finiteDimensional_range (A j)
    exact Submodule.finiteDimensional_of_le hle
  let A' : ∀ j : S, LinearMap.range (t j.1) →ₗ[K] LinearMap.range T := fun j =>
    LinearMap.codRestrict (LinearMap.range T) (A j) (hAr j)
  let B' : ∀ j : S, LinearMap.range T →ₗ[K] LinearMap.range (t j.1) := fun j =>
    (B j) ∘ₗ (LinearMap.range T).subtype
  have hres : T.restrict (fun x _ => LinearMap.mem_range_self T x) = ∑ j : S, (A' j) ∘ₗ (B' j) := by
    apply LinearMap.ext
    intro u
    apply Subtype.ext
    rw [LinearMap.coe_restrict_apply, LinearMap.sum_apply, Submodule.coe_sum, hsum]
    rfl
  have htr : wcpaRfFrTr T = ∑ j : S, LinearMap.trace K (LinearMap.range (t j.1)) ((B j) ∘ₗ (A j)) := by
    unfold wcpaRfFrTr
    rw [hres, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    haveI : Module.Free K (LinearMap.range T) :=
      Module.Free.of_basis (Module.Basis.ofVectorSpace K (LinearMap.range T))
    haveI : Module.Free K (LinearMap.range (t j.1)) :=
      Module.Free.of_basis (Module.Basis.ofVectorSpace K (LinearMap.range (t j.1)))
    have hc := LinearMap.trace_comp_comm' (R := K) (M := LinearMap.range T)
      (N := LinearMap.range (t j.1)) (B' j) (A' j)
    refine hc.trans ?_
    congr 1
  have hdiag : ∀ j : S, LinearMap.trace K (LinearMap.range (t j.1)) ((B j) ∘ₗ (A j)) =
      wcpaRfFrTr (t j.1) := by
    intro j
    unfold wcpaRfFrTr
    congr 1
    apply LinearMap.ext
    intro r
    apply Subtype.ext
    show t j.1 ((Pi.single j.1 (r : M) : I → M) j.1) = t j.1 (r : M)
    rw [Pi.single_eq_same]
  refine ⟨hUfd, ?_⟩
  rw [htr, Finset.sum_congr rfl (fun j _ => hdiag j)]
  exact Finset.sum_coe_sort S (fun i => wcpaRfFrTr (t i))

theorem wcpa_rf_tres_exact_vanish : ∀ (K E : Type u) [Field K] [AddCommGroup E] [Module K E] (A B : Submodule K E) (e f g : Module.End K E), (∀ z, e z ∈ A) → (∀ z ∈ A, e z = z) → f * g = g * f → (∀ z ∈ B, f z ∈ B) → (∀ z ∈ B, g z ∈ B) → FiniteDimensional K ↥(A ⊓ B) → FiniteDimensional K (E ⧸ (A ⊔ B)) → FiniteDimensional K (LinearMap.range ((1 - e) * f * e)) → FiniteDimensional K (LinearMap.range ((1 - e) * g * e)) → wcpaRfTRes e f g = 0 :=
by
  intro K E _ _ _ A B e f g hA1 hA2 hfg hBf hBg hAB hQ hf hg
  classical



  have key : ∀ (T : Module.End K E) (U : Submodule K E) [FiniteDimensional K U]
      (hU : ∀ z, T z ∈ U),
      wcpaRfFrTr T = LinearMap.trace K U (T.restrict (fun z _ => hU z)) := by
    intro T U _ hU
    have hle : LinearMap.range T ≤ U := by
      rintro _ ⟨z, rfl⟩
      exact hU z
    haveI : FiniteDimensional K (LinearMap.range T) := Submodule.finiteDimensional_of_le hle
    let ι : LinearMap.range T →ₗ[K] U := Submodule.inclusion hle
    let π : U →ₗ[K] LinearMap.range T := (T.rangeRestrict).comp U.subtype
    have h1 : T.restrict (fun z _ => hU z) = ι ∘ₗ π := by
      ext z
      rfl
    have h2 : T.restrict (fun x _ => LinearMap.mem_range_self T x) = π ∘ₗ ι := by
      ext z
      rfl
    unfold wcpaRfFrTr
    rw [h1, h2, LinearMap.trace_comp_comm']
  have frL : ∀ X Y : Module.End K E, FiniteDimensional K (LinearMap.range X) →
      FiniteDimensional K (LinearMap.range (X * Y)) := by
    intro X Y hX
    rw [Module.End.mul_eq_comp]
    exact Submodule.finiteDimensional_of_le (LinearMap.range_comp_le_range _ _)
  have frR : ∀ X Y : Module.End K E, FiniteDimensional K (LinearMap.range Y) →
      FiniteDimensional K (LinearMap.range (X * Y)) := by
    intro X Y hY
    rw [Module.End.mul_eq_comp, LinearMap.range_comp]
    exact Module.Finite.map _ _
  have fradd : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) → FiniteDimensional K (LinearMap.range (S + T)) := by
    intro S T hS hT
    exact Submodule.finiteDimensional_of_le (LinearMap.range_add_le S T)
  have frsub : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) → FiniteDimensional K (LinearMap.range (S - T)) := by
    intro S T hS hT
    have hle : LinearMap.range (S - T) ≤ LinearMap.range S ⊔ LinearMap.range T := by
      rintro _ ⟨z, rfl⟩
      rw [LinearMap.sub_apply]
      exact Submodule.sub_mem_sup (LinearMap.mem_range_self S z) (LinearMap.mem_range_self T z)
    exact Submodule.finiteDimensional_of_le hle
  have cyc : ∀ X Y : Module.End K E, FiniteDimensional K (LinearMap.range X) →
      wcpaRfFrTr (X * Y) = wcpaRfFrTr (Y * X) := by
    intro X Y hX
    haveI : FiniteDimensional K ((LinearMap.range X).map Y) := Module.Finite.map _ _
    have hXY : ∀ z, (X * Y) z ∈ LinearMap.range X := fun z => LinearMap.mem_range_self X (Y z)
    have hYX : ∀ z, (Y * X) z ∈ (LinearMap.range X).map Y :=
      fun z => Submodule.mem_map_of_mem (LinearMap.mem_range_self X z)
    rw [key (X * Y) _ hXY, key (Y * X) _ hYX]
    let α : (LinearMap.range X).map Y →ₗ[K] LinearMap.range X :=
      (X.comp ((LinearMap.range X).map Y).subtype).codRestrict (LinearMap.range X)
        (fun z => LinearMap.mem_range_self X _)
    let β : LinearMap.range X →ₗ[K] (LinearMap.range X).map Y :=
      (Y.comp (LinearMap.range X).subtype).codRestrict ((LinearMap.range X).map Y)
        (fun z => Submodule.mem_map_of_mem z.2)
    have h1 : (X * Y).restrict (fun z _ => hXY z) = α ∘ₗ β := by
      ext z
      rfl
    have h2 : (Y * X).restrict (fun z _ => hYX z) = β ∘ₗ α := by
      ext z
      rfl
    rw [h1, h2, LinearMap.trace_comp_comm']
  have tradd : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) →
      wcpaRfFrTr (S + T) = wcpaRfFrTr S + wcpaRfFrTr T := by
    intro S T hS hT
    have hS' : ∀ z, S z ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun z => Submodule.mem_sup_left (LinearMap.mem_range_self S z)
    have hT' : ∀ z, T z ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun z => Submodule.mem_sup_right (LinearMap.mem_range_self T z)
    have hST : ∀ z, (S + T) z ∈ LinearMap.range S ⊔ LinearMap.range T :=
      fun z => Submodule.add_mem _ (hS' z) (hT' z)
    rw [key _ _ hST, key _ _ hS', key _ _ hT']
    have : ((S + T).restrict (fun z _ => hST z) :
          Module.End K ↥(LinearMap.range S ⊔ LinearMap.range T)) =
        S.restrict (fun z _ => hS' z) + T.restrict (fun z _ => hT' z) := by
      ext z
      rfl
    rw [this, map_add]
  have trsub : ∀ S T : Module.End K E, FiniteDimensional K (LinearMap.range S) →
      FiniteDimensional K (LinearMap.range T) →
      wcpaRfFrTr (S - T) = wcpaRfFrTr S - wcpaRfFrTr T := by
    intro S T hS hT
    have h := tradd (S - T) T (frsub S T hS hT) hT
    rw [sub_add_cancel] at h
    rw [h]
    ring
  have comm0L : ∀ X Y : Module.End K E, FiniteDimensional K (LinearMap.range X) →
      FiniteDimensional K (LinearMap.range (X * Y - Y * X)) ∧ wcpaRfFrTr (X * Y - Y * X) = 0 := by
    intro X Y hX
    refine ⟨frsub _ _ (frL X Y hX) (frR Y X hX), ?_⟩
    rw [trsub _ _ (frL X Y hX) (frR Y X hX), cyc X Y hX, sub_self]
  have comm0R : ∀ X Y : Module.End K E, FiniteDimensional K (LinearMap.range Y) →
      FiniteDimensional K (LinearMap.range (X * Y - Y * X)) ∧ wcpaRfFrTr (X * Y - Y * X) = 0 := by
    intro X Y hY
    refine ⟨frsub _ _ (frR X Y hY) (frL Y X hY), ?_⟩
    rw [trsub _ _ (frR X Y hY) (frL Y X hY), cyc Y X hY, sub_self]
  have CP : ∀ X Y X' Y' : Module.End K E, FiniteDimensional K (LinearMap.range (X * Y - Y * X)) →
      FiniteDimensional K (LinearMap.range (X' - X)) → FiniteDimensional K (LinearMap.range (Y' - Y)) →
      FiniteDimensional K (LinearMap.range (X' * Y' - Y' * X')) ∧
        wcpaRfFrTr (X' * Y' - Y' * X') = wcpaRfFrTr (X * Y - Y * X) := by
    intro X Y X' Y' hXY hφ hγ
    have hid : X' * Y' - Y' * X' = (X * Y - Y * X) + (X * (Y' - Y) - (Y' - Y) * X) +
        ((X' - X) * Y' - Y' * (X' - X)) := by noncomm_ring
    obtain ⟨h1, h1'⟩ := comm0R X (Y' - Y) hγ
    obtain ⟨h2, h2'⟩ := comm0L (X' - X) Y' hφ
    rw [hid]
    refine ⟨fradd _ _ (fradd _ _ hXY h1) h2, ?_⟩
    rw [tradd _ _ (fradd _ _ hXY h1) h2, tradd _ _ hXY h1, h1', h2', add_zero, add_zero]
  have hfr0 : wcpaRfFrTr (0 : Module.End K E) = 0 := by
    unfold wcpaRfFrTr
    have e1 : ((0 : Module.End K E).restrict
        (fun x _ => LinearMap.mem_range_self (0 : Module.End K E) x) :
          Module.End K (LinearMap.range (0 : Module.End K E))) = 0 := by
      apply LinearMap.ext
      intro z
      apply Subtype.ext
      rfl
    rw [e1, map_zero]



  have hI : ∀ u : Module.End K E, u * u = u →
      u * g * (1 - u) * f * u - u * f * (1 - u) * g * u =
        (u * f * u) * (u * g * u) - (u * g * u) * (u * f * u) := by
    intro u hu
    have h0 : u * g * (1 - u) * f * u - u * f * (1 - u) * g * u -
        ((u * f * u) * (u * g * u) - (u * g * u) * (u * f * u)) =
        u * (g * f - f * g) * u - u * f * (u * u - u) * g * u + u * g * (u * u - u) * f * u := by
      noncomm_ring
    rw [show g * f = f * g from hfg.symm] at h0
    simp only [hu, sub_self, mul_zero, zero_mul, add_zero, sub_zero] at h0
    exact sub_eq_zero.mp h0



  have pl : ∀ (P Q : Submodule K E) (h : IsCompl P Q) (z : E), z ∈ P →
      (P.projectionOnto Q h z : E) = z := by
    intro P Q h z hz
    have h1 : P.projectionOnto Q h z = ⟨z, hz⟩ := Submodule.projectionOnto_apply_left h ⟨z, hz⟩
    rw [h1]
  have pr : ∀ (P Q : Submodule K E) (h : IsCompl P Q) (z : E), z ∈ Q →
      P.projectionOnto Q h z = 0 := by
    intro P Q h z hz
    exact Submodule.projectionOnto_apply_right h ⟨z, hz⟩
  have ps : ∀ (P Q : Submodule K E) (h : IsCompl P Q) (z : E),
      z - (P.projectionOnto Q h z : E) ∈ Q := by
    intro P Q h z
    obtain ⟨x, y, hx, hy, rfl⟩ := Submodule.codisjoint_iff_exists_add_eq.mp h.codisjoint z
    rw [map_add, Submodule.coe_add, pl P Q h x hx, pr P Q h y hy]
    simpa using hy



  obtain ⟨W', hW'⟩ := Submodule.exists_isCompl (A ⊔ B)
  haveI hW'fd : FiniteDimensional K W' :=
    Module.Finite.equiv (Submodule.quotientEquivOfIsCompl _ _ hW')
  haveI := hAB
  have hzall : ∀ z : E, ∃ a b w, a ∈ A ∧ b ∈ B ∧ w ∈ W' ∧ z = a + b + w := by
    intro z
    have hz : z ∈ (A ⊔ B) ⊔ W' := by rw [hW'.sup_eq_top]; trivial
    obtain ⟨ab, hab, w, hw, rfl⟩ := Submodule.mem_sup.mp hz
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
    exact ⟨a, b, w, ha, hb, hw, rfl⟩
  obtain ⟨Q1, hQ1⟩ := Submodule.exists_isCompl (A ⊓ (B ⊔ W'))
  obtain ⟨Q2, hQ2⟩ := Submodule.exists_isCompl ((A ⊔ W') ⊓ B)
  have hN : IsCompl A (Q1 ⊓ (B ⊔ W')) := by
    constructor
    · rw [Submodule.disjoint_def]
      intro x hxA hx
      exact (Submodule.disjoint_def.mp hQ1.disjoint) x
        (Submodule.mem_inf.mpr ⟨hxA, (Submodule.mem_inf.mp hx).2⟩) (Submodule.mem_inf.mp hx).1
    · rw [Submodule.codisjoint_iff_exists_add_eq]
      intro z
      obtain ⟨a, b, w, ha, hb, hw, rfl⟩ := hzall z
      have hbw : b + w ∈ B ⊔ W' := Submodule.add_mem_sup hb hw
      obtain ⟨y, q, hy, hq, hyq⟩ := Submodule.codisjoint_iff_exists_add_eq.mp hQ1.codisjoint (b + w)
      refine ⟨a + y, q, Submodule.add_mem _ ha (Submodule.mem_inf.mp hy).1,
        Submodule.mem_inf.mpr ⟨hq, ?_⟩, ?_⟩
      · have : q = (b + w) - y := by rw [← hyq]; abel
        rw [this]
        exact Submodule.sub_mem _ hbw (Submodule.mem_inf.mp hy).2
      · rw [show a + b + w = a + (b + w) by abel, ← hyq]
        abel
  have hM : IsCompl (Q2 ⊓ (A ⊔ W')) B := by
    constructor
    · rw [Submodule.disjoint_def]
      intro x hx hxB
      exact (Submodule.disjoint_def.mp hQ2.disjoint) x
        (Submodule.mem_inf.mpr ⟨(Submodule.mem_inf.mp hx).2, hxB⟩) (Submodule.mem_inf.mp hx).1
    · rw [Submodule.codisjoint_iff_exists_add_eq]
      intro z
      obtain ⟨a, b, w, ha, hb, hw, rfl⟩ := hzall z
      have haw : a + w ∈ A ⊔ W' := Submodule.add_mem_sup ha hw
      obtain ⟨y, q, hy, hq, hyq⟩ := Submodule.codisjoint_iff_exists_add_eq.mp hQ2.codisjoint (a + w)
      refine ⟨q, y + b, Submodule.mem_inf.mpr ⟨hq, ?_⟩,
        Submodule.add_mem _ (Submodule.mem_inf.mp hy).2 hb, ?_⟩
      · have : q = (a + w) - y := by rw [← hyq]; abel
        rw [this]
        exact Submodule.sub_mem _ haw (Submodule.mem_inf.mp hy).1
      · rw [show a + b + w = (a + w) + b by abel, ← hyq]
        abel
  set e1 : Module.End K E := A.subtype ∘ₗ A.projectionOnto _ hN with he1def
  set p : Module.End K E := (Q2 ⊓ (A ⊔ W')).subtype ∘ₗ (Q2 ⊓ (A ⊔ W')).projectionOnto B hM
    with hpdef
  have he1A : ∀ z, e1 z ∈ A := fun z => (A.projectionOnto _ hN z).2
  have he1fix : ∀ z ∈ A, e1 z = z := fun z hz => pl A _ hN z hz
  have he1s : ∀ z, z - e1 z ∈ Q1 ⊓ (B ⊔ W') := fun z => ps A _ hN z
  have hpM : ∀ z, p z ∈ Q2 ⊓ (A ⊔ W') := fun z => ((Q2 ⊓ (A ⊔ W')).projectionOnto B hM z).2
  have hpB : ∀ z ∈ B, p z = 0 := by
    intro z hz
    show (((Q2 ⊓ (A ⊔ W')).projectionOnto B hM z : _) : E) = 0
    rw [pr _ B hM z hz]
    rfl
  have hps : ∀ z, z - p z ∈ B := fun z => ps _ B hM z
  have hpfix : ∀ z ∈ Q2 ⊓ (A ⊔ W'), p z = z := fun z hz => pl _ B hM z hz

  have hpe1 : FiniteDimensional K (LinearMap.range (p - e1)) := by
    have hle : LinearMap.range (p - e1) ≤ (A ⊓ B) ⊔ W' := by
      rintro _ ⟨z, rfl⟩
      rw [LinearMap.sub_apply]
      have hxA : p z - e1 z ∈ A ⊔ W' :=
        Submodule.sub_mem _ (Submodule.mem_inf.mp (hpM z)).2 (Submodule.mem_sup_left (he1A z))
      have hxB : p z - e1 z ∈ B ⊔ W' := by
        have : p z - e1 z = (z - e1 z) - (z - p z) := by abel
        rw [this]
        exact Submodule.sub_mem _ (Submodule.mem_inf.mp (he1s z)).2
          (Submodule.mem_sup_left (hps z))
      obtain ⟨a, ha, w, hw, haw⟩ := Submodule.mem_sup.mp hxA
      obtain ⟨b, hb, w2, hw2, hbw⟩ := Submodule.mem_sup.mp hxB
      have hab : a - b = w2 - w := by
        have := haw.trans hbw.symm
        rw [sub_eq_sub_iff_add_eq_add, this, add_comm]
      have hab0 : a - b = 0 := by
        apply (Submodule.disjoint_def.mp hW'.disjoint)
        · exact Submodule.sub_mem _ (Submodule.mem_sup_left ha) (Submodule.mem_sup_right hb)
        · rw [hab]; exact Submodule.sub_mem _ hw2 hw
      have hab' : a = b := sub_eq_zero.mp hab0
      rw [← haw]
      exact Submodule.add_mem_sup (Submodule.mem_inf.mpr ⟨ha, hab' ▸ hb⟩) hw
    exact Submodule.finiteDimensional_of_le hle



  have hee : e * e = e := LinearMap.ext fun z => hA2 _ (hA1 z)
  have he1e1 : e1 * e1 = e1 := LinearMap.ext fun z => he1fix _ (he1A z)
  have hee1 : e * e1 = e1 := LinearMap.ext fun z => hA2 _ (he1A z)
  have he1e : e1 * e = e := LinearMap.ext fun z => he1fix _ (hA1 z)
  have hpp : p * p = p := LinearMap.ext fun z => hpfix _ (hpM z)



  have hTe : e * g * (1 - e) * f * e - e * f * (1 - e) * g * e =
      (e * f * e) * (e * g * e) - (e * g * e) * (e * f * e) := hI e hee
  have hTefd : FiniteDimensional K
      (LinearMap.range ((e * f * e) * (e * g * e) - (e * g * e) * (e * f * e))) := by
    rw [← hTe]
    have : e * g * (1 - e) * f * e - e * f * (1 - e) * g * e =
        (e * g) * ((1 - e) * f * e) - (e * f) * ((1 - e) * g * e) := by
      simp only [mul_assoc]
    rw [this]
    exact frsub _ _ (frR _ _ hf) (frR _ _ hg)



  have hdiff : ∀ h : Module.End K E, e1 * h * e - e * h * e = (e1 - e) * ((1 - e) * h * e) := by
    intro h
    have h0 : (e1 - e) * ((1 - e) * h * e) =
        e1 * h * e - e * h * e - (e1 * e - e) * h * e + (e * e - e) * h * e := by
      noncomm_ring
    simp only [he1e, hee, sub_self, zero_mul, sub_zero, add_zero] at h0
    exact h0.symm
  obtain ⟨hZfd, hZtr⟩ := CP (e * f * e) (e * g * e) (e1 * f * e) (e1 * g * e) hTefd
    (by rw [hdiff]; exact frR _ _ hf) (by rw [hdiff]; exact frR _ _ hg)
  set σ : Module.End K E := 1 + (e1 - e) with hσ
  set τ : Module.End K E := 1 - (e1 - e) with hτ
  have hτe1 : τ * e1 = e1 := by
    have h0 : τ * e1 = e1 - (e1 * e1 - e * e1) := by rw [hτ]; noncomm_ring
    rw [h0, he1e1, hee1, sub_self, sub_zero]
  have heσ : e * σ = e1 := by
    have h0 : e * σ = e + (e * e1 - e * e) := by rw [hσ]; noncomm_ring
    rw [h0, hee1, hee]
    abel
  have hστ : σ * τ = 1 := by
    have h0 : σ * τ = 1 - ((e1 * e1 - e1 * e) - (e * e1 - e * e)) := by
      rw [hσ, hτ]; noncomm_ring
    rw [h0, he1e1, he1e, hee1, hee]
    simp
  have hconj : ∀ h : Module.End K E, e1 * h * e1 = τ * (e1 * h * e) * σ := by
    intro h
    calc e1 * h * e1 = (τ * e1) * h * (e * σ) := by rw [hτe1, heσ]
      _ = τ * (e1 * h * e) * σ := by simp only [mul_assoc]
  have hT1 : (e1 * f * e1) * (e1 * g * e1) - (e1 * g * e1) * (e1 * f * e1) =
      τ * ((e1 * f * e) * (e1 * g * e) - (e1 * g * e) * (e1 * f * e)) * σ := by
    rw [hconj f, hconj g]
    calc τ * (e1 * f * e) * σ * (τ * (e1 * g * e) * σ) -
          τ * (e1 * g * e) * σ * (τ * (e1 * f * e) * σ)
        = τ * (e1 * f * e) * (σ * τ) * (e1 * g * e) * σ -
          τ * (e1 * g * e) * (σ * τ) * (e1 * f * e) * σ := by simp only [mul_assoc]
      _ = _ := by rw [hστ]; noncomm_ring
  have hT1fd : FiniteDimensional K (LinearMap.range
      ((e1 * f * e1) * (e1 * g * e1) - (e1 * g * e1) * (e1 * f * e1))) := by
    rw [hT1]
    exact frL _ _ (frR _ _ hZfd)
  have hT1tr : wcpaRfFrTr ((e1 * f * e1) * (e1 * g * e1) - (e1 * g * e1) * (e1 * f * e1)) =
      wcpaRfFrTr ((e * f * e) * (e * g * e) - (e * g * e) * (e * f * e)) := by
    rw [hT1, cyc _ σ (frR _ _ hZfd), ← mul_assoc, hστ, one_mul, hZtr]



  have hdiff2 : ∀ h : Module.End K E, FiniteDimensional K (LinearMap.range (p * h * p - e1 * h * e1)) := by
    intro h
    have h0 : p * h * p - e1 * h * e1 = (p - e1) * h * p + e1 * h * (p - e1) := by noncomm_ring
    rw [h0]
    exact fradd _ _ (frL _ _ (frL _ _ hpe1)) (frR _ _ hpe1)
  obtain ⟨-, hPtr⟩ := CP (e1 * f * e1) (e1 * g * e1) (p * f * p) (p * g * p) hT1fd
    (hdiff2 f) (hdiff2 g)



  have hpker : ∀ h : Module.End K E, (∀ z ∈ B, h z ∈ B) → p * h * (1 - p) = 0 := by
    intro h hh
    apply LinearMap.ext
    intro z
    show p (h (z - p z)) = 0
    exact hpB _ (hh _ (hps z))
  have hTp : (p * f * p) * (p * g * p) - (p * g * p) * (p * f * p) = 0 := by
    rw [← hI p hpp, hpker g hBg, hpker f hBf, zero_mul, zero_mul, zero_mul, zero_mul, sub_self]



  unfold wcpaRfTRes
  rw [hTe, ← hT1tr, ← hPtr, hTp, hfr0]

theorem wcpa_rf_global_vanish : ∀ (K F I : Type u) [Field K] [Field F] [Algebra K F] (w : I → Additive Fˣ →+ ℤ), wcValFamily K F I w → (∃ (n : ℕ) (β : Fin n → I → F), ∀ α : I → F, {i | ¬ wcValGe F (w i) 0 (α i)}.Finite → ∃ (a : Fin n → K) (f : F), ∀ i, wcValGe F (w i) 0 (α i - ∑ k, a k • β k i - f)) → ∀ (e : I → F →ₗ[K] F), (∀ i h, wcValGe F (w i) 0 (e i h)) → (∀ i h, wcValGe F (w i) 0 h → e i h = h) → (∀ i (g : F), FiniteDimensional K (LinearMap.range ((1 - e i) * LinearMap.mulLeft K g * e i))) → ∀ g x : F, ∑ᶠ i, wcpaRfTRes (e i) (LinearMap.mulLeft K g) (LinearMap.mulLeft K x) = 0 :=
by
  intro K F I _ _ _ w hfam hade e E1 E2 Efin g x
  classical

  have hOmul : ∀ i (a b : F), wcValGe F (w i) 0 a → wcValGe F (w i) 0 b →
      wcValGe F (w i) 0 (a * b) := by
    intro i a b ha hb
    rcases ha with ha | ⟨ha0, ha⟩
    · left; rw [ha, zero_mul]
    rcases hb with hb | ⟨hb0, hb⟩
    · left; rw [hb, mul_zero]
    right
    refine ⟨mul_ne_zero ha0 hb0, ?_⟩
    have e1 : Units.mk0 (a * b) (mul_ne_zero ha0 hb0) = Units.mk0 a ha0 * Units.mk0 b hb0 :=
      Units.ext rfl
    rw [e1, ofMul_mul, map_add]
    omega
  have hOadd : ∀ i (a b : F), wcValGe F (w i) 0 a → wcValGe F (w i) 0 b →
      wcValGe F (w i) 0 (a + b) := by
    intro i a b ha hb
    rcases ha with ha | ⟨ha0, ha⟩
    · rw [ha, zero_add]; exact hb
    rcases hb with hb | ⟨hb0, hb⟩
    · rw [hb, add_zero]; exact Or.inr ⟨ha0, ha⟩
    by_cases hab : a + b = 0
    · exact Or.inl hab
    refine Or.inr ⟨hab, ?_⟩
    exact le_trans (le_min ha hb)
      (hfam.1 i (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) rfl)
  have hOconst : ∀ i (c : K), wcValGe F (w i) 0 (algebraMap K F c) := by
    intro i c
    by_cases hc : algebraMap K F c = 0
    · exact Or.inl hc
    exact Or.inr ⟨hc, (hfam.2.2.2 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ i⟩
  have hOneg : ∀ i (a : F), wcValGe F (w i) 0 a → wcValGe F (w i) 0 (-a) := by
    intro i a ha
    have h1 := hOmul i (algebraMap K F (-1)) a (hOconst i _) ha
    rwa [map_neg, map_one, neg_one_mul] at h1
  have hOsub : ∀ i (a b : F), wcValGe F (w i) 0 a → wcValGe F (w i) 0 b →
      wcValGe F (w i) 0 (a - b) := by
    intro i a b ha hb
    rw [sub_eq_add_neg]
    exact hOadd i _ _ ha (hOneg i _ hb)
  have hOsmul : ∀ i (c : K) (a : F), wcValGe F (w i) 0 a → wcValGe F (w i) 0 (c • a) := by
    intro i c a ha
    rw [Algebra.smul_def]
    exact hOmul i _ _ (hOconst i c) ha

  have hSfin : ∀ y : F, {i | ¬ wcValGe F (w i) 0 y}.Finite := by
    intro y
    by_cases hy : y = 0
    · exact Set.finite_empty.subset (fun i hi => hi (Or.inl hy))
    · refine (hfam.2.1 (Units.mk0 y hy)).subset ?_
      intro i hi h0
      exact hi (Or.inr ⟨hy, le_of_eq h0.symm⟩)

  obtain ⟨Ead, hEad⟩ : ∃ E : Submodule K (I → F),
      ∀ α, α ∈ E ↔ {i | ¬ wcValGe F (w i) 0 (α i)}.Finite :=
    ⟨{ carrier := {α | {i | ¬ wcValGe F (w i) 0 (α i)}.Finite}
       add_mem' := by
         intro a b ha hb
         refine (Set.Finite.union ha hb).subset ?_
         intro i hi
         by_contra h
         simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at h
         exact hi (hOadd i _ _ h.1 h.2)
       zero_mem' := Set.finite_empty.subset (fun i hi => hi (Or.inl rfl))
       smul_mem' := by
         intro c a ha
         refine Set.Finite.subset ha ?_
         intro i hi h
         exact hi (hOsmul i c _ h) }, fun α => Iff.rfl⟩
  obtain ⟨A', hA'⟩ : ∃ A' : Submodule K (I → F),
      ∀ α, α ∈ A' ↔ ∀ i, wcValGe F (w i) 0 (α i) :=
    ⟨{ carrier := {α | ∀ i, wcValGe F (w i) 0 (α i)}
       add_mem' := fun ha hb i => hOadd i _ _ (ha i) (hb i)
       zero_mem' := fun i => Or.inl rfl
       smul_mem' := fun c a ha i => hOsmul i c _ (ha i) }, fun α => Iff.rfl⟩
  obtain ⟨B', hB'⟩ : ∃ B' : Submodule K (I → F), ∀ α, α ∈ B' ↔ ∃ f : F, α = fun _ => f :=
    ⟨{ carrier := {α | ∃ f : F, α = fun _ => f}
       add_mem' := by
         rintro a b ⟨f, rfl⟩ ⟨f', rfl⟩
         exact ⟨f + f', rfl⟩
       zero_mem' := ⟨0, rfl⟩
       smul_mem' := by
         rintro c a ⟨f, rfl⟩
         exact ⟨c • f, rfl⟩ }, fun α => Iff.rfl⟩
  have hB'E : ∀ α ∈ B', α ∈ Ead := by
    intro α hα
    obtain ⟨f, rfl⟩ := (hB' α).mp hα
    exact (hEad _).mpr (hSfin f)
  have hsingle : ∀ (i : I) (m : F), (Pi.single i m : I → F) ∈ Ead := by
    intro i m
    refine (hEad _).mpr ((Set.finite_singleton i).subset ?_)
    intro j hj
    by_contra hji
    have hji' : j ≠ i := hji
    apply hj
    simp only [Pi.single_apply, hji', if_false]
    exact Or.inl rfl
  obtain ⟨A, hA⟩ : ∃ A : Submodule K Ead, ∀ z, z ∈ A ↔ (z : I → F) ∈ A' :=
    ⟨Submodule.comap Ead.subtype A', fun z => Iff.rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : Submodule K Ead, ∀ z, z ∈ B ↔ (z : I → F) ∈ B' :=
    ⟨Submodule.comap Ead.subtype B', fun z => Iff.rfl⟩

  obtain ⟨Mop, hMd⟩ : ∃ M : F → Module.End K Ead, ∀ y α i,
      ((M y α : Ead) : I → F) i = LinearMap.mulLeft K y ((α : I → F) i) := by
    have hMmem : ∀ (y : F) (α : Ead), (fun i => y * (α : I → F) i) ∈ Ead := by
      intro y α
      refine (hEad _).mpr (((hSfin y).union ((hEad _).mp α.2)).subset ?_)
      intro i hi
      by_contra h
      simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at h
      exact hi (hOmul i _ _ h.1 h.2)
    refine ⟨fun y =>
      { toFun := fun α => ⟨fun i => y * (α : I → F) i, hMmem y α⟩
        map_add' := ?_
        map_smul' := ?_ }, fun y α i => rfl⟩
    · intro a b
      apply Subtype.ext
      funext i
      show y * ((a + b : Ead) : I → F) i = y * (a : I → F) i + y * (b : I → F) i
      rw [Submodule.coe_add, Pi.add_apply, mul_add]
    · intro c a
      apply Subtype.ext
      funext i
      show y * ((c • a : Ead) : I → F) i = c • (y * (a : I → F) i)
      rw [Submodule.coe_smul, Pi.smul_apply, mul_smul_comm]
  obtain ⟨Eop, hEd⟩ : ∃ P : Module.End K Ead, ∀ α i,
      ((P α : Ead) : I → F) i = e i ((α : I → F) i) := by
    have hEmem : ∀ (α : Ead), (fun i => e i ((α : I → F) i)) ∈ Ead := by
      intro α
      exact (hEad _).mpr (Set.finite_empty.subset (fun i hi => hi (E1 i _)))
    refine ⟨
      { toFun := fun α => ⟨fun i => e i ((α : I → F) i), hEmem α⟩
        map_add' := ?_
        map_smul' := ?_ }, fun α i => rfl⟩
    · intro a b
      apply Subtype.ext
      funext i
      show e i (((a + b : Ead) : I → F) i) = e i ((a : I → F) i) + e i ((b : I → F) i)
      rw [Submodule.coe_add, Pi.add_apply, map_add]
    · intro c a
      apply Subtype.ext
      funext i
      show e i (((c • a : Ead) : I → F) i) = c • e i ((a : I → F) i)
      rw [Submodule.coe_smul, Pi.smul_apply, map_smul]

  have dmul : ∀ (P Q : Module.End K Ead) (p q : I → Module.End K F),
      (∀ α i, ((P α : Ead) : I → F) i = p i ((α : I → F) i)) →
      (∀ α i, ((Q α : Ead) : I → F) i = q i ((α : I → F) i)) →
      ∀ α i, (((P * Q) α : Ead) : I → F) i = (p i * q i) ((α : I → F) i) := by
    intro P Q p q hP hQ α i
    rw [Module.End.mul_apply, hP, hQ, Module.End.mul_apply]
  have dsub : ∀ (P Q : Module.End K Ead) (p q : I → Module.End K F),
      (∀ α i, ((P α : Ead) : I → F) i = p i ((α : I → F) i)) →
      (∀ α i, ((Q α : Ead) : I → F) i = q i ((α : I → F) i)) →
      ∀ α i, (((P - Q) α : Ead) : I → F) i = (p i - q i) ((α : I → F) i) := by
    intro P Q p q hP hQ α i
    rw [LinearMap.sub_apply, Submodule.coe_sub, Pi.sub_apply, hP, hQ, LinearMap.sub_apply]
  have done : ∀ α i, (((1 : Module.End K Ead) α : Ead) : I → F) i =
      (fun _ : I => (1 : Module.End K F)) i ((α : I → F) i) := fun α i => rfl

  have hloc0 : ∀ i (y : F), wcValGe F (w i) 0 y → (1 - e i) * LinearMap.mulLeft K y * e i = 0 := by
    intro i y hy
    apply LinearMap.ext
    intro z
    rw [Module.End.mul_apply, Module.End.mul_apply, LinearMap.sub_apply, Module.End.one_apply,
      LinearMap.mulLeft_apply, E2 i _ (hOmul i _ _ hy (E1 i z)), sub_self, LinearMap.zero_apply]

  have hY : ∀ y : F, FiniteDimensional K (LinearMap.range ((1 - Eop) * Mop y * Eop)) := by
    intro y
    exact (wcpa_rf_frtr_diag K F I Ead ((1 - Eop) * Mop y * Eop)
      (fun i => (1 - e i) * LinearMap.mulLeft K y * e i)
      (dmul _ _ _ _ (dmul _ _ _ _ (dsub _ _ _ _ done hEd) (hMd y)) hEd) (hSfin y).toFinset
      (fun i hi => hloc0 i y (by
        by_contra h
        exact hi ((hSfin y).mem_toFinset.mpr h)))
      (fun i => Efin i y) (fun i _ m => hsingle i m)).1

  have hone : (fun _ : I => (1 : F)) ∈ Ead := hB'E _ ((hB' _).mpr ⟨1, rfl⟩)
  have hABle : A ⊓ B ≤ Submodule.span K {(⟨fun _ => 1, hone⟩ : Ead)} := by
    intro z hz
    obtain ⟨hzA, hzB⟩ := Submodule.mem_inf.mp hz
    have hzA' := (hA' _).mp ((hA z).mp hzA)
    obtain ⟨f, hf⟩ := (hB' _).mp ((hB z).mp hzB)
    rw [Submodule.mem_span_singleton]
    by_cases hf0 : f = 0
    · refine ⟨0, ?_⟩
      rw [zero_smul]
      apply Subtype.ext
      rw [hf, hf0]
      rfl
    · have hall : ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf0)) := by
        intro i
        have h1 := hzA' i
        rw [hf] at h1
        rcases h1 with h | ⟨_, h⟩
        · exact absurd h hf0
        · exact h
      obtain ⟨c, hc⟩ := (hfam.2.2.2 (Units.mk0 f hf0)).mp hall
      refine ⟨c, Subtype.ext ?_⟩
      funext i
      show c • (1 : F) = (z : I → F) i
      rw [hf, Algebra.smul_def, mul_one, hc]
      rfl
  have hABfd : FiniteDimensional K ↥(A ⊓ B) := Submodule.finiteDimensional_of_le hABle

  have hquot : FiniteDimensional K (Ead ⧸ (A ⊔ B)) := by
    obtain ⟨n, β, hβ⟩ := hade
    have hle : A ⊔ B ≤ Submodule.comap Ead.subtype (A' ⊔ B') :=
      sup_le (fun z hz => Submodule.mem_sup_left ((hA z).mp hz))
        (fun z hz => Submodule.mem_sup_right ((hB z).mp hz))
    set q := Submodule.mapQ (A ⊔ B) (A' ⊔ B') Ead.subtype hle with hq
    have hinj : Function.Injective q := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro z hz
      obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      rw [hq, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at hz
      rw [Submodule.Quotient.mk_eq_zero]
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hz
      have hbE : b ∈ Ead := hB'E b hb
      have haE : a ∈ Ead := by
        have e1 : a = (v : I → F) - b := eq_sub_of_add_eq hab
        rw [e1]
        exact Ead.sub_mem v.2 hbE
      exact Submodule.mem_sup.mpr ⟨⟨a, haE⟩, (hA _).mpr ha, ⟨b, hbE⟩, (hB _).mpr hb,
        Subtype.ext hab⟩
    set W := Submodule.span K (Set.range fun k => (A' ⊔ B').mkQ (β k)) with hW
    have hWfd : FiniteDimensional K W := FiniteDimensional.span_of_finite K (Set.finite_range _)
    have hrange : ∀ z, q z ∈ W := by
      intro z
      obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      obtain ⟨a, f, hf⟩ := hβ v ((hEad _).mp v.2)
      have h1 : (v : I → F) - ∑ k, a k • β k - (fun _ => f) ∈ A' := by
        refine (hA' _).mpr (fun i => ?_)
        simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply]
        exact hf i
      have h2 : (fun _ : I => f) ∈ B' := (hB' _).mpr ⟨f, rfl⟩
      have h3 : (v : I → F) - ∑ k, a k • β k ∈ A' ⊔ B' := by
        have h4 := Submodule.add_mem_sup h1 h2
        rwa [sub_add_cancel] at h4
      have h5 : (Submodule.Quotient.mk (v : I → F) : (I → F) ⧸ (A' ⊔ B')) =
          Submodule.Quotient.mk (∑ k, a k • β k) := (Submodule.Quotient.eq _).mpr h3
      rw [hq, Submodule.mapQ_apply, Submodule.subtype_apply, h5, ← Submodule.mkQ_apply,
        map_sum]
      refine Submodule.sum_mem _ (fun k _ => ?_)
      rw [map_smul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
    have hinj' : Function.Injective (LinearMap.codRestrict W q hrange) := by
      intro a b hab
      exact hinj (congrArg Subtype.val hab)
    exact Module.Finite.of_injective (LinearMap.codRestrict W q hrange) hinj'

  have hEA : ∀ z, Eop z ∈ A := fun z => (hA _).mpr ((hA' _).mpr (fun i => by rw [hEd]; exact E1 i _))
  have hEfix : ∀ z ∈ A, Eop z = z := by
    intro z hz
    apply Subtype.ext
    funext i
    rw [hEd]
    exact E2 i _ ((hA' _).mp ((hA z).mp hz) i)
  have hcomm : Mop g * Mop x = Mop x * Mop g := by
    apply LinearMap.ext
    intro z
    apply Subtype.ext
    funext i
    rw [Module.End.mul_apply, Module.End.mul_apply, hMd, hMd, hMd, hMd,
      LinearMap.mulLeft_apply, LinearMap.mulLeft_apply, LinearMap.mulLeft_apply,
      LinearMap.mulLeft_apply, mul_left_comm]
  have hBst : ∀ y, ∀ z ∈ B, Mop y z ∈ B := by
    intro y z hz
    obtain ⟨f, hf⟩ := (hB' _).mp ((hB z).mp hz)
    refine (hB _).mpr ((hB' _).mpr ⟨y * f, funext fun i => ?_⟩)
    rw [hMd, LinearMap.mulLeft_apply, hf]

  have hglob := wcpa_rf_tres_exact_vanish K Ead A B Eop (Mop g) (Mop x) hEA hEfix hcomm
    (hBst g) (hBst x) hABfd hquot (hY g) (hY x)

  obtain ⟨τ, hτ⟩ : ∃ τ : I → Module.End K F, ∀ i, τ i =
      e i * LinearMap.mulLeft K x * (1 - e i) * LinearMap.mulLeft K g * e i -
        e i * LinearMap.mulLeft K g * (1 - e i) * LinearMap.mulLeft K x * e i :=
    ⟨_, fun _ => rfl⟩
  have hTd : ∀ (α : Ead) (i : I),
      (((Eop * Mop x * (1 - Eop) * Mop g * Eop - Eop * Mop g * (1 - Eop) * Mop x * Eop) α : Ead)
        : I → F) i = τ i ((α : I → F) i) := by
    intro α i
    rw [hτ]
    exact dsub _ _ _ _
      (dmul _ _ _ _ (dmul _ _ _ _ (dmul _ _ _ _ (dmul _ _ _ _ hEd (hMd x))
        (dsub _ _ _ _ done hEd)) (hMd g)) hEd)
      (dmul _ _ _ _ (dmul _ _ _ _ (dmul _ _ _ _ (dmul _ _ _ _ hEd (hMd g))
        (dsub _ _ _ _ done hEd)) (hMd x)) hEd) α i
  set S : Finset I := (hSfin g).toFinset ∪ (hSfin x).toFinset with hS
  have hτ0 : ∀ i ∉ S, τ i = 0 := by
    intro i hi
    have hg : wcValGe F (w i) 0 g := by
      by_contra h
      exact hi (Finset.mem_union_left _ ((hSfin g).mem_toFinset.mpr h))
    have hx : wcValGe F (w i) 0 x := by
      by_contra h
      exact hi (Finset.mem_union_right _ ((hSfin x).mem_toFinset.mpr h))
    rw [hτ]
    calc _ = (e i * LinearMap.mulLeft K x) * ((1 - e i) * LinearMap.mulLeft K g * e i) -
          (e i * LinearMap.mulLeft K g) * ((1 - e i) * LinearMap.mulLeft K x * e i) := by
          simp only [mul_assoc]
      _ = 0 := by rw [hloc0 i g hg, hloc0 i x hx, mul_zero, mul_zero, sub_zero]
  have frmul : ∀ (X Y : Module.End K F), FiniteDimensional K (LinearMap.range Y) →
      FiniteDimensional K (LinearMap.range (X * Y)) := by
    intro X Y hY'
    rw [Module.End.mul_eq_comp, LinearMap.range_comp]
    exact Module.Finite.map _ _
  have frsub : ∀ (X Y : Module.End K F), FiniteDimensional K (LinearMap.range X) →
      FiniteDimensional K (LinearMap.range Y) → FiniteDimensional K (LinearMap.range (X - Y)) := by
    intro X Y hX hY'
    have hle : LinearMap.range (X - Y) ≤ LinearMap.range X ⊔ LinearMap.range Y := by
      rintro _ ⟨z, rfl⟩
      rw [LinearMap.sub_apply]
      exact Submodule.sub_mem_sup (LinearMap.mem_range_self X z) (LinearMap.mem_range_self Y z)
    exact Submodule.finiteDimensional_of_le hle
  have hτfd : ∀ i, FiniteDimensional K (LinearMap.range (τ i)) := by
    intro i
    have e1 : τ i = (e i * LinearMap.mulLeft K x) * ((1 - e i) * LinearMap.mulLeft K g * e i) -
          (e i * LinearMap.mulLeft K g) * ((1 - e i) * LinearMap.mulLeft K x * e i) := by
      rw [hτ]; simp only [mul_assoc]
    rw [e1]
    exact frsub _ _ (frmul _ _ (Efin i g)) (frmul _ _ (Efin i x))
  have hdiag := wcpa_rf_frtr_diag K F I Ead
    (Eop * Mop x * (1 - Eop) * Mop g * Eop - Eop * Mop g * (1 - Eop) * Mop x * Eop) τ hTd S
    hτ0 hτfd (fun i _ m => hsingle i m)

  have hfr0 : wcpaRfFrTr (0 : Module.End K F) = 0 := by
    unfold wcpaRfFrTr
    have e1 : ((0 : Module.End K F).restrict
        (fun x _ => LinearMap.mem_range_self (0 : Module.End K F) x) :
          Module.End K (LinearMap.range (0 : Module.End K F))) = 0 := by
      apply LinearMap.ext
      intro z
      apply Subtype.ext
      rfl
    rw [e1, map_zero]
  have hloc : ∀ i, wcpaRfTRes (e i) (LinearMap.mulLeft K g) (LinearMap.mulLeft K x) =
      wcpaRfFrTr (τ i) := by
    intro i
    rw [hτ]
    rfl
  have hsupp : Function.support (fun i => wcpaRfFrTr (τ i)) ⊆ (S : Set I) := by
    intro i hi
    by_contra h
    apply hi
    show wcpaRfFrTr (τ i) = 0
    rw [hτ0 i h, hfr0]
  rw [finsum_congr hloc, finsum_eq_sum_of_support_subset _ hsupp, ← hdiag.2]
  exact hglob

theorem wcpa_dj_cdp_cd_residue_functionals (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F) (D : Derivation K F F)
    (hD : ∀ (V : ValuationSubring F) (x : F), wcpaDjNtV' K V → wcpaDjValOrd V x = 1 → D x ≠ 0)
    (u : ValuationSubring F → F) (hu : ∀ V, wcpaDjNtV' K V → wcpaDjValOrd V (u V) = 1)
    (hfin : {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V (D (u V)) ≠ 0}.Finite)
    (w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ)
    (hw : ∀ V (f : Fˣ), w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F))
    (hfam : wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w)
    (hR : wcRRResidue K F {V : ValuationSubring F // wcpaDjNtV' K V} w)
    (i₀ : {V : ValuationSubring F // wcpaDjNtV' K V})
    (hθ : ∀ (V : {V : ValuationSubring F // wcpaDjNtV' K V}) (π y : F),
      wcpaDjValOrd V.1 π = 1 → D π ≠ 0 → y ∈ V.1 → D y ≠ 0 →
      wcpaDjValOrd V.1 (D π) ≤ wcpaDjValOrd V.1 (D y))
    (hade : ∃ (n : ℕ) (β : Fin n → {V : ValuationSubring F // wcpaDjNtV' K V} → F),
      ∀ α : {V : ValuationSubring F // wcpaDjNtV' K V} → F, {i | ¬ wcValGe F (w i) 0 (α i)}.Finite →
      ∃ (a : Fin n → K) (f : F), ∀ i, wcValGe F (w i) 0 (α i - ∑ k, a k • β k i - f)) :
    ∃ lam : {V : ValuationSubring F // wcpaDjNtV' K V} → F →ₗ[K] K,
      (∀ i (f : F), wcValGe F (w i) (wcpaDjValOrd i.1 (D (u i.1))) f → lam i f = 0) ∧
      (∀ i, ∃ f : Fˣ, w i (Additive.ofMul f) = wcpaDjValOrd i.1 (D (u i.1)) - 1 ∧
        lam i (f : F) ≠ 0) ∧
      (∀ f : F, ∑ᶠ i, lam i f = 0) :=
by
  classical

  have hv0 : ∀ V : ValuationSubring F, wcpaDjValOrd V (0 : F) = 0 := by
    intro V
    unfold wcpaDjValOrd
    rw [inv_zero, sub_self]
  have hnotin : ∀ (V : ValuationSubring F) (z : F), z ∉ V → wcpaDjValOrd V z ≤ 0 := by
    intro V z hz
    unfold wcpaDjValOrd
    have hS : {n : ℕ | ∃ h : z ∈ V, (⟨z, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} = ∅ := by
      ext n
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨h, -⟩
      exact hz h
    rw [hS, csSup_empty]
    simp
  have hwval : ∀ (i : {V : ValuationSubring F // wcpaDjNtV' K V}) (x : F) (hx : x ≠ 0),
      w i (Additive.ofMul (Units.mk0 x hx)) = wcpaDjValOrd i.1 x := by
    intro i x hx
    rw [hw, Units.val_mk0]
  have hwmul : ∀ (i : {V : ValuationSubring F // wcpaDjNtV' K V}) (x y : F) (hx : x ≠ 0)
      (hy : y ≠ 0) (hxy : x * y ≠ 0),
      w i (Additive.ofMul (Units.mk0 (x * y) hxy)) =
        w i (Additive.ofMul (Units.mk0 x hx)) + w i (Additive.ofMul (Units.mk0 y hy)) := by
    intro i x y hx hy hxy
    have e1 : Units.mk0 (x * y) hxy = Units.mk0 x hx * Units.mk0 y hy := Units.ext rfl
    rw [e1, ofMul_mul, map_add]
  have hwinv : ∀ (i : {V : ValuationSubring F // wcpaDjNtV' K V}) (x : F) (hx : x ≠ 0)
      (hxi : x⁻¹ ≠ 0),
      w i (Additive.ofMul (Units.mk0 x⁻¹ hxi)) = - w i (Additive.ofMul (Units.mk0 x hx)) := by
    intro i x hx hxi
    have e1 : Units.mk0 x⁻¹ hxi = (Units.mk0 x hx)⁻¹ := Units.ext rfl
    rw [e1, ofMul_inv, map_neg]

  have hu0 : ∀ i : {V : ValuationSubring F // wcpaDjNtV' K V}, u i.1 ≠ 0 := by
    intro i h0
    have h1 := hu i.1 i.2
    rw [h0, hv0] at h1
    exact absurd h1 (by norm_num)
  have hDu : ∀ i : {V : ValuationSubring F // wcpaDjNtV' K V}, D (u i.1) ≠ 0 :=
    fun i => hD i.1 (u i.1) i.2 (hu i.1 i.2)
  obtain ⟨t, htv⟩ : ∃ t : {V : ValuationSubring F // wcpaDjNtV' K V} → Fˣ,
      ∀ i, (t i : F) = u i.1 := ⟨fun i => Units.mk0 _ (hu0 i), fun i => rfl⟩
  have ht1 : ∀ i, w i (Additive.ofMul (t i)) = 1 := by
    intro i
    rw [hw, htv]
    exact hu i.1 i.2
  have hDt : ∀ i, D (t i : F) ≠ 0 := by
    intro i
    rw [htv]
    exact hDu i

  have hpp := fun i => wcpa_rf_pp_projection K F _ w hfam hR i (t i) (ht1 i)
  choose e c hE1 hE2 hE3 hE4 hE5 using hpp
  have hloc := fun i => wcpa_rf_local_tres K F _ w hfam i (t i) (ht1 i) (e i) (c i) (hE1 i)
    (hE2 i) (hE3 i) (hE4 i) (hE5 i)

  have hθ' : ∀ i, ∀ y : F, wcValGe F (w i) 0 y → ∀ hy : D y ≠ 0,
      w i (Additive.ofMul (Units.mk0 _ (hDt i))) ≤ w i (Additive.ofMul (Units.mk0 _ hy)) := by
    intro i y hy0 hDy
    rw [hwval, hwval, htv]
    have hy : y ≠ 0 := by
      intro h
      apply hDy
      rw [h, map_zero]
    have hle : 0 ≤ wcpaDjValOrd i.1 y := by
      unfold wcValGe at hy0
      rcases hy0 with h | ⟨hy', hle'⟩
      · exact absurd h hy
      · rw [hwval] at hle'
        exact hle'
    have hmem : y ∈ i.1 := by
      by_contra hyV
      have hy0' : wcpaDjValOrd i.1 y = 0 := le_antisymm (hnotin i.1 y hyV) hle
      obtain ⟨c0, hc0⟩ := hR i (Units.mk0 y hy) (by rw [hwval]; exact hy0')
      rcases hc0 with h | ⟨h, hh1, hh2⟩
      · apply hyV
        rw [Units.val_mk0] at h
        rw [h]
        exact i.2.1 c0
      · have hhV : (h : F) ∈ i.1 := by
          by_contra hn
          have := hnotin i.1 _ hn
          rw [hw] at hh2
          linarith
        apply hyV
        rw [Units.val_mk0] at hh1
        have : y = (h : F) + algebraMap K F c0 := by rw [hh1]; ring
        rw [this]
        exact add_mem hhV (i.2.1 c0)
    exact hθ i (u i.1) y (hu i.1 i.2) (hDu i) hmem hDy
  refine ⟨fun i => (c i).comp (LinearMap.mulLeft K (D (u i.1))⁻¹), ?_, ?_, ?_⟩
  ·
    intro i f hf
    show c i ((D (u i.1))⁻¹ * f) = 0
    apply (hloc i).2.2.2.2
    unfold wcValGe at hf ⊢
    rcases hf with h | ⟨hf0, hle⟩
    · left
      rw [h, mul_zero]
    · right
      refine ⟨mul_ne_zero (inv_ne_zero (hDu i)) hf0, ?_⟩
      rw [hwmul i _ _ (inv_ne_zero (hDu i)) hf0, hwinv i _ (hDu i), hwval i _ (hDu i)]
      linarith
  ·
    intro i
    have hui := hu0 i
    refine ⟨Units.mk0 ((u i.1)⁻¹ * D (u i.1)) (mul_ne_zero (inv_ne_zero hui) (hDu i)), ?_, ?_⟩
    · rw [hwmul i _ _ (inv_ne_zero hui) (hDu i), hwinv i _ hui, hwval i _ hui,
        hwval i _ (hDu i), hu i.1 i.2]
      ring
    · show c i ((D (u i.1))⁻¹ * ((u i.1)⁻¹ * D (u i.1))) ≠ 0
      have e1 : (D (u i.1))⁻¹ * ((u i.1)⁻¹ * D (u i.1)) = ((t i : F))⁻¹ := by
        rw [htv i, mul_left_comm, inv_mul_cancel₀ (hDu i), mul_one]
      rw [e1]
      intro h0
      have h5 := hE5 i ((t i : F)⁻¹)
      rw [h0, map_zero] at h5
      have h3 := hE3 i 0
      rw [zero_add, pow_one] at h3
      rw [h3, sub_zero, mul_inv_cancel₀ (Units.ne_zero (t i))] at h5
      have h1 : e i 1 = 1 := by
        apply hE2 i 1
        unfold wcValGe
        right
        refine ⟨one_ne_zero, ?_⟩
        rw [show Units.mk0 (1 : F) one_ne_zero = 1 from Units.ext rfl, ofMul_one, map_zero]
      rw [h1] at h5
      exact zero_ne_one h5
  ·
    intro f
    have hx := hDu i₀
    have key : ∀ i : {V : ValuationSubring F // wcpaDjNtV' K V},
        ((c i).comp (LinearMap.mulLeft K (D (u i.1))⁻¹)) f =
          wcpaRfTRes (e i) (LinearMap.mulLeft K (f / D (u i₀.1)))
            (LinearMap.mulLeft K (u i₀.1)) := by
      intro i
      rw [wcpa_rf_chain_rule K F _ w hfam hR i (t i) (ht1 i) (e i) (c i) (hE1 i) (hE2 i) (hE3 i)
        (hE4 i) (hE5 i) D (hDt i) (hθ' i)]
      rw [LinearMap.comp_apply, LinearMap.mulLeft_apply]
      congr 1
      rw [htv i, div_mul_div_comm, mul_comm f (D (u i₀.1)), mul_div_mul_left _ _ hx,
        div_eq_inv_mul]
    refine (finsum_congr key).trans ?_
    exact wcpa_rf_global_vanish K F _ w hfam hade e hE1 hE2 (fun i g => (hloc i).1 g) _ _

theorem wcpa_dj_cdp_cd_degree_eq (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F) (D : Derivation K F F)
    (hD : ∀ (V : ValuationSubring F) (x : F), wcpaDjNtV' K V → wcpaDjValOrd V x = 1 → D x ≠ 0)
    (u : ValuationSubring F → F) (hu : ∀ V, wcpaDjNtV' K V → wcpaDjValOrd V (u V) = 1)
    (hfin : {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V (D (u V)) ≠ 0}.Finite)
    (w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ)
    (hw : ∀ V (f : Fˣ), w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F))
    (hfam : wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w)
    (hdim : wcRRDim K F {V : ValuationSubring F // wcpaDjNtV' K V} w)
    (g c : ℕ)
    (hRR : ∀ A : {V : ValuationSubring F // wcpaDjNtV' K V} →₀ ℤ,
      (c : ℤ) ≤ A.sum (fun _ k => k) →
      FiniteDimensional K (wcRRL K F {V : ValuationSubring F // wcpaDjNtV' K V} w A) ∧
      (Module.finrank K (wcRRL K F {V : ValuationSubring F // wcpaDjNtV' K V} w A) : ℤ) =
        A.sum (fun _ k => k) + 1 - g) :
    ∑ᶠ V, Set.indicator {V : ValuationSubring F | wcpaDjNtV' K V}
        (fun V => -wcpaDjValOrd V (D (u V))) V = 2 * (g : ℤ) - 2 :=
by
  classical

  have hA6 : wcRRFinRank K F := by
    refine wcpa_dj_ffv_finrank K F ?_ (wcpa_dj_ffv_finite_over_transc K F hF)
    intro f hf halg
    obtain ⟨c0, hc0⟩ := (wcpa_dj_ffv_integral_const K F).1 f halg
    exact hf ⟨c0, hc0⟩

  have hR := wc_rr_residue_trivial K F _ w hfam hA6

  obtain ⟨t, ht, -⟩ := id hF
  have ht0 : t ≠ 0 := by
    intro h0
    apply ht
    rw [h0]
    exact isAlgebraic_zero
  have hnot : ¬ ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 t ht0)) := by
    intro hall
    obtain ⟨c0, hc0⟩ := (hfam.2.2.2 (Units.mk0 t ht0)).mp hall
    apply ht
    rw [Units.val_mk0] at hc0
    rw [← hc0]
    exact isAlgebraic_algebraMap c0
  push_neg at hnot
  obtain ⟨i₀, -⟩ := hnot

  have hres : ∀ V : {V : ValuationSubring F // wcpaDjNtV' K V}, ∀ y : F, y ≠ 0 →
      wcpaDjValOrd V.1 y = 0 → ∃ c : K, y = algebraMap K F c ∨
        (y - algebraMap K F c ≠ 0 ∧ 0 < wcpaDjValOrd V.1 (y - algebraMap K F c)) := by
    intro V y hy0 hy
    obtain ⟨c0, hc⟩ := hR V (Units.mk0 y hy0) (by rw [hw, Units.val_mk0]; exact hy)
    refine ⟨c0, ?_⟩
    rcases hc with h | ⟨h, hh1, hh2⟩
    · left
      rw [Units.val_mk0] at h
      exact h
    · right
      rw [Units.val_mk0] at hh1
      rw [hw] at hh2
      rw [← hh1]
      exact ⟨h.ne_zero, hh2⟩
  have hθ : ∀ (V : {V : ValuationSubring F // wcpaDjNtV' K V}) (π y : F),
      wcpaDjValOrd V.1 π = 1 → D π ≠ 0 → y ∈ V.1 → D y ≠ 0 →
      wcpaDjValOrd V.1 (D π) ≤ wcpaDjValOrd V.1 (D y) := by
    intro V π y h1 h2 h3 h4
    exact wcpa_dj_cdp_cd_theta_integral K F hF D V.1 V.2 (hres V) π y
      h1 h2 h3 h4

  have hade := wcpa_dj_cdp_cd_adele_finite K F _ w hfam hR hdim i₀ g c hRR
  obtain ⟨lam, ha, hb, hc⟩ := wcpa_dj_cdp_cd_residue_functionals K F hF D hD
    u hu hfin w hw hfam hR i₀ hθ hade

  obtain ⟨W, hWd⟩ : ∃ W : {V : ValuationSubring F // wcpaDjNtV' K V} → ℤ,
      W = fun i => -wcpaDjValOrd i.1 (D (u i.1)) := ⟨_, rfl⟩
  have hWneg : ∀ i, -W i = wcpaDjValOrd i.1 (D (u i.1)) := by
    intro i; rw [hWd, neg_neg]
  have hW : (Function.support W).Finite := by
    refine (Set.Finite.preimage Subtype.val_injective.injOn hfin).subset ?_
    intro i hi
    refine ⟨i.2, ?_⟩
    intro h0
    apply hi
    rw [hWd]
    show -wcpaDjValOrd i.1 (D (u i.1)) = 0
    rw [h0, neg_zero]
  have hsum := wcpa_dj_cdp_cd_weil_degree K F _ w hfam hR hdim i₀ g c hRR W hW lam
    (fun i f hf => ha i f (by rw [hWneg] at hf; exact hf))
    (fun i => by
      obtain ⟨f, hf1, hf2⟩ := hb i
      exact ⟨f, by rw [hf1, hWneg], hf2⟩) hc

  rw [← finsum_mem_def, ← finsum_set_coe_eq_finsum_mem, ← hsum, hWd]
  rfl

theorem wcpa_dj_cdp_cd_genus_zero (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F)
    (w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ)
    (hw : ∀ V (f : Fˣ), w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F))
    (hfam : wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w)
    (hdim : wcRRDim K F {V : ValuationSubring F // wcpaDjNtV' K V} w)
    (c : ℕ)
    (hRR : ∀ A : {V : ValuationSubring F // wcpaDjNtV' K V} →₀ ℤ,
      (c : ℤ) ≤ A.sum (fun _ k => k) →
      (Module.finrank K (wcRRL K F {V : ValuationSubring F // wcpaDjNtV' K V} w A) : ℤ) =
        A.sum (fun _ k => k) + 1) :
    ∃ t : F, IntermediateField.adjoin K {t} = ⊤ :=
by
  classical
  have key : ∀ (I : Type u) (w : I → Additive Fˣ →+ ℤ), wcValFamily K F I w →
      wcRRDim K F I w → ∀ c : ℕ, (∀ A : I →₀ ℤ, (c : ℤ) ≤ A.sum (fun _ k => k) →
        (Module.finrank K (wcRRL K F I w A) : ℤ) = A.sum (fun _ k => k) + 1) →
      ∃ t : F, IntermediateField.adjoin K {t} = ⊤ := by
    intro I w hfam hdim c hRR

    obtain ⟨t₀, ht₀, -⟩ := hF
    have ht₀0 : t₀ ≠ 0 := Transcendental.ne_zero ht₀
    have hi₀ : ∃ i₀ : I, w i₀ (Additive.ofMul (Units.mk0 t₀ ht₀0)) < 0 := by
      by_contra hcon
      push_neg at hcon
      obtain ⟨c0, hc0⟩ := (hfam.2.2.2 (Units.mk0 t₀ ht₀0)).mp hcon
      apply ht₀
      rw [Units.val_mk0] at hc0
      rw [← hc0]
      exact isAlgebraic_algebraMap c0
    obtain ⟨i₀, -⟩ := hi₀
    have hsumsingle : ∀ (j : I) (n : ℤ), (Finsupp.single j n).sum (fun _ k => k) = n := by
      intro j n
      exact Finsupp.sum_single_index rfl
    set P : I →₀ ℤ := Finsupp.single i₀ 1 with hP

    have hle : ∀ D : I →₀ ℤ, 0 ≤ D →
        (Module.finrank K (wcRRL K F I w D) : ℤ) ≤ D.sum (fun _ k => k) + 1 := by
      intro D hD
      have h := (hdim.2.2 0 D hD).2
      rw [hdim.1, sub_zero] at h
      push_cast at h
      linarith

    have hlP : (2 : ℤ) ≤ Module.finrank K (wcRRL K F I w P) := by
      have hA' := hRR (Finsupp.single i₀ ((c : ℤ) + 1)) (by rw [hsumsingle]; linarith)
      rw [hsumsingle] at hA'
      have hPA : P ≤ Finsupp.single i₀ ((c : ℤ) + 1) := by
        rw [hP]; exact Finsupp.single_le_single.mpr (by linarith)
      have h := (hdim.2.2 P _ hPA).2
      have hsub : Finsupp.single i₀ ((c : ℤ) + 1) - P = Finsupp.single i₀ (c : ℤ) := by
        rw [hP, ← Finsupp.single_sub]; congr 1; ring
      rw [hsub, hsumsingle] at h
      linarith

    have hex : ∃ t : F, ∃ ht : t ≠ 0, (∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 t ht)) + P i) ∧
        t ∉ Set.range (algebraMap K F) := by
      by_contra hcon
      push_neg at hcon
      have hsub : wcRRL K F I w P ≤ K ∙ (1 : F) := by
        unfold wcRRL
        rw [Submodule.span_le]
        rintro f ⟨hf, hS⟩
        obtain ⟨k, hk⟩ := hcon f hf hS
        rw [SetLike.mem_coe, Submodule.mem_span_singleton]
        exact ⟨k, by rw [← hk, Algebra.algebraMap_eq_smul_one]⟩
      have h1 := Submodule.finrank_mono hsub
      rw [finrank_span_singleton one_ne_zero] at h1
      have : (Module.finrank K (wcRRL K F I w P) : ℤ) ≤ 1 := by exact_mod_cast h1
      linarith
    obtain ⟨t, ht0, htP, htnc⟩ := hex

    have htr : Transcendental K t := by
      intro halg
      apply htnc
      have hint := halg.isIntegral
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible hint)
      obtain ⟨y, hy⟩ := RingHom.mem_range.mp (minpoly.mem_range_of_degree_eq_one K t hdeg)
      exact ⟨y, hy⟩
    have hmemp : ∀ p : Polynomial K, Polynomial.aeval t p ∈ IntermediateField.adjoin K {t} :=
      fun p => IntermediateField.algebra_adjoin_le_adjoin K {t}
        (Polynomial.aeval_mem_adjoin_singleton K t)

    have hmem : ∀ f : F, f ∈ IntermediateField.adjoin K {t} := by
      intro f
      by_cases hf : f = 0
      · rw [hf]; exact IntermediateField.zero_mem _
      set tu := Units.mk0 t ht0 with htu
      set fu := Units.mk0 f hf with hfu
      have hsuppfin : (Function.support (fun i => max 0 (-(w i (Additive.ofMul fu))))).Finite := by
        apply (hfam.2.1 fu).subset
        intro i hi
        simp only [Function.mem_support] at hi
        simp only [Set.mem_setOf_eq]
        intro h0; apply hi; rw [h0]; simp
      set E : I →₀ ℤ := Finsupp.ofSupportFinite _ hsuppfin with hE
      have hEi : ∀ i, E i = max 0 (-(w i (Additive.ofMul fu))) := fun i => by
        rw [hE, Finsupp.ofSupportFinite_coe]
      have hE0' : ∀ i, 0 ≤ E i := fun i => by rw [hEi]; exact le_max_left _ _
      have hdegE : 0 ≤ E.sum (fun _ k => k) := Finsupp.sum_nonneg (fun i _ => hE0' i)
      set m : ℕ := (E.sum (fun _ k => k)).toNat with hm
      have hmE : (m : ℤ) = E.sum (fun _ k => k) := Int.toNat_of_nonneg hdegE
      set D : I →₀ ℤ := E + Finsupp.single i₀ (m : ℤ) with hD
      have hDi : ∀ i, D i = E i + (if i₀ = i then (m : ℤ) else 0) := by
        intro i; rw [hD, Finsupp.add_apply, Finsupp.single_apply]
      have hD0 : 0 ≤ D := by
        rw [Finsupp.le_def]; intro i
        rw [Finsupp.coe_zero, Pi.zero_apply, hDi]
        have := hE0' i
        split_ifs <;> omega
      have hdegD : D.sum (fun _ k => k) = 2 * m := by
        rw [hD, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), hsumsingle, ← hmE]
        ring
      have hlD : (Module.finrank K (wcRRL K F I w D) : ℤ) ≤ 2 * m + 1 := by
        have := hle D hD0; rw [hdegD] at this; exact this
      have hta : ∀ i, ∀ j : ℕ, j ≤ m →
          0 ≤ (j : ℤ) * w i (Additive.ofMul tu) + (if i₀ = i then (m : ℤ) else 0) := by
        intro i j hj
        have h1 := htP i
        rw [hP, Finsupp.single_apply] at h1
        have hj' : (j : ℤ) ≤ m := by exact_mod_cast hj
        have hj0 : (0 : ℤ) ≤ j := by positivity
        split_ifs at h1 ⊢ with h
        · nlinarith [mul_nonneg hj0 (show (0 : ℤ) ≤ w i (Additive.ofMul tu) + 1 by linarith)]
        · rw [add_zero] at h1
          nlinarith [mul_nonneg hj0 h1]
      have hvt : ∀ (j : ℕ) (h : t ^ j ≠ 0) i,
          w i (Additive.ofMul (Units.mk0 (t ^ j) h)) = (j : ℤ) * w i (Additive.ofMul tu) := by
        intro j h i
        have : Units.mk0 (t ^ j) h = tu ^ j := Units.ext (by simp [htu])
        rw [this, ofMul_pow, map_nsmul, nsmul_eq_mul]
      have hvft : ∀ (j : ℕ) (h : f * t ^ j ≠ 0) i,
          w i (Additive.ofMul (Units.mk0 (f * t ^ j) h)) =
            w i (Additive.ofMul fu) + (j : ℤ) * w i (Additive.ofMul tu) := by
        intro j h i
        have : Units.mk0 (f * t ^ j) h = fu * tu ^ j := Units.ext (by simp [htu, hfu])
        rw [this, ofMul_mul, map_add, ofMul_pow, map_nsmul, nsmul_eq_mul]
      set v : Fin (m + 1) ⊕ Fin (m + 1) → F :=
        Sum.elim (fun j : Fin (m + 1) => t ^ (j : ℕ)) (fun j : Fin (m + 1) => f * t ^ (j : ℕ))
        with hv
      have hvmem : ∀ x, v x ∈ wcRRL K F I w D := by
        intro x
        apply Submodule.subset_span
        rcases x with j | j
        · have hne : t ^ (j : ℕ) ≠ 0 := pow_ne_zero _ ht0
          show ∃ hf : t ^ (j : ℕ) ≠ 0,
            ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 (t ^ (j : ℕ)) hf)) + D i
          refine ⟨hne, fun i => ?_⟩
          rw [hvt _ hne i, hDi i]
          have := hta i j (by have := j.isLt; omega)
          have := hE0' i
          linarith
        · have hne : f * t ^ (j : ℕ) ≠ 0 := mul_ne_zero hf (pow_ne_zero _ ht0)
          show ∃ hf : f * t ^ (j : ℕ) ≠ 0,
            ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 (f * t ^ (j : ℕ)) hf)) + D i
          refine ⟨hne, fun i => ?_⟩
          rw [hvft _ hne i, hDi i]
          have := hta i j (by have := j.isLt; omega)
          have h2 : 0 ≤ w i (Additive.ofMul fu) + E i := by
            rw [hEi]
            have := le_max_right (0 : ℤ) (-(w i (Additive.ofMul fu)))
            linarith
          linarith
      have hdep : ¬ LinearIndependent K v := by
        intro hli
        let v' : Fin (m + 1) ⊕ Fin (m + 1) → wcRRL K F I w D := fun x => ⟨v x, hvmem x⟩
        have hli' : LinearIndependent K v' := by
          apply LinearIndependent.of_comp (wcRRL K F I w D).subtype
          exact hli
        haveI := hdim.2.1 D
        have hcard := hli'.fintype_card_le_finrank
        simp only [Fintype.card_sum, Fintype.card_fin] at hcard
        have : ((m + 1 + (m + 1) : ℕ) : ℤ) ≤ Module.finrank K (wcRRL K F I w D) := by
          exact_mod_cast hcard
        push_cast at this
        linarith
      rw [Fintype.linearIndependent_iff] at hdep
      push_neg at hdep
      obtain ⟨g, hg, x₀, hx₀⟩ := hdep
      rw [Fintype.sum_sum_type] at hg
      simp only [hv, Sum.elim_inl, Sum.elim_inr] at hg
      set A : Polynomial K := ∑ j : Fin (m + 1), Polynomial.monomial (j : ℕ) (g (Sum.inl j)) with hA
      set B : Polynomial K := ∑ j : Fin (m + 1), Polynomial.monomial (j : ℕ) (g (Sum.inr j)) with hB
      have hAe : Polynomial.aeval t A = ∑ j : Fin (m + 1), g (Sum.inl j) • t ^ (j : ℕ) := by
        rw [hA, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Polynomial.aeval_monomial, Algebra.smul_def]
      have hBe : Polynomial.aeval t B = ∑ j : Fin (m + 1), g (Sum.inr j) • t ^ (j : ℕ) := by
        rw [hB, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Polynomial.aeval_monomial, Algebra.smul_def]
      have hrel : Polynomial.aeval t A + f * Polynomial.aeval t B = 0 := by
        rw [hAe, hBe, Finset.mul_sum]
        refine Eq.trans ?_ hg
        congr 1
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [mul_smul_comm]
      have hAc : ∀ j : Fin (m + 1), A.coeff (j : ℕ) = g (Sum.inl j) := by
        intro j
        rw [hA, Polynomial.finset_sum_coeff]
        simp only [Polynomial.coeff_monomial]
        rw [Finset.sum_eq_single j]
        · simp
        · intro b _ hb; rw [if_neg]; intro h; exact hb (Fin.ext h)
        · intro h; exact absurd (Finset.mem_univ j) h
      have hBc : ∀ j : Fin (m + 1), B.coeff (j : ℕ) = g (Sum.inr j) := by
        intro j
        rw [hB, Polynomial.finset_sum_coeff]
        simp only [Polynomial.coeff_monomial]
        rw [Finset.sum_eq_single j]
        · simp
        · intro b _ hb; rw [if_neg]; intro h; exact hb (Fin.ext h)
        · intro h; exact absurd (Finset.mem_univ j) h
      have hBt : Polynomial.aeval t B ≠ 0 := by
        intro hB0
        have hB0' : B = 0 := (transcendental_iff.mp htr) B hB0
        rw [hB0, mul_zero, add_zero] at hrel
        have hA0 : A = 0 := (transcendental_iff.mp htr) A hrel
        rcases x₀ with j | j
        · exact hx₀ (by rw [← hAc j, hA0, Polynomial.coeff_zero])
        · exact hx₀ (by rw [← hBc j, hB0', Polynomial.coeff_zero])
      have hfeq : f = -(Polynomial.aeval t A) / Polynomial.aeval t B := by
        rw [eq_div_iff hBt]; linear_combination hrel
      rw [hfeq]
      exact IntermediateField.div_mem _ (IntermediateField.neg_mem _ (hmemp A)) (hmemp B)
    exact ⟨t, eq_top_iff.mpr (fun f _ => hmem f)⟩
  exact key _ w hfam hdim c hRR

theorem wcpa_dj_cdp_canonical_degree (K F : Type u) [Field K] [IsAlgClosed K] [Field F]
    [Algebra K F] (hF : wcpaDjFF1 K F) (D : Derivation K F F)
    (hD : ∀ (V : ValuationSubring F) (x : F), wcpaDjNtV' K V → wcpaDjValOrd V x = 1 → D x ≠ 0)
    (u : ValuationSubring F → F) (hu : ∀ V, wcpaDjNtV' K V → wcpaDjValOrd V (u V) = 1) :
    {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V (D (u V)) ≠ 0}.Finite ∧
    (∑ᶠ V, Set.indicator {V : ValuationSubring F | wcpaDjNtV' K V}
        (fun V => -wcpaDjValOrd V (D (u V))) V = -2 ∨
      0 ≤ ∑ᶠ V, Set.indicator {V : ValuationSubring F | wcpaDjNtV' K V}
        (fun V => -wcpaDjValOrd V (D (u V))) V) ∧
    (∑ᶠ V, Set.indicator {V : ValuationSubring F | wcpaDjNtV' K V}
        (fun V => -wcpaDjValOrd V (D (u V))) V = -2 →
      ∃ t : F, IntermediateField.adjoin K {t} = ⊤) :=
by
  obtain ⟨w, hw, hfam, hinj, hfr⟩ := wcpa_dj_cdp_cd_valfamily K F hF
  have hR := wc_rr_residue_trivial K F _ w hfam hfr
  have hdim := wc_rr_dimension_step K F _ w hfam hR
  have hP := wc_rr_pole_degree_le K F _ w hfam hinj hR
  have h0 := wc_rr_degree_zero K F _ w hfam hfr hdim hP
  obtain ⟨g, c, hRR⟩ := wc_rr_abstract_large_degree K F _ w hfam hfr hdim hP h0
  have hfin := wcpa_dj_cdp_cd_support_finite K F hF D hD u hu
  have hκ := wcpa_dj_cdp_cd_degree_eq K F hF D hD u hu hfin w hw hfam hdim g c hRR
  refine ⟨hfin, ?_, ?_⟩
  · rw [hκ]
    rcases Nat.eq_zero_or_pos g with hg | hg
    · left; subst hg; norm_num
    · right; omega
  · intro h2
    rw [hκ] at h2
    have hg : g = 0 := by omega
    subst hg
    refine wcpa_dj_cdp_cd_genus_zero K F hF w hw hfam hdim c ?_
    intro A hA
    have := (hRR A hA).2
    simpa using this

theorem wcpa_dj_csp_ext_nonsmooth (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (hss : wcpaDjSemistable q) (ξ : C)
    (hξ : closure {ξ} ∈ irreducibleComponents C) (c : C)
    (hc : c ∈ closure ({ξ} : Set C) ∩ closure (closure ({ξ} : Set C))ᶜ) :
    ¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) :=
by
  rintro ⟨W, hcW, hWsm⟩
  haveI : IsProper q := hss.2.1
  haveI : SmoothOfRelativeDimension 1 (W.ι ≫ q) := hWsm
  haveI : Smooth (W.ι ≫ q) := SmoothOfRelativeDimension.smooth 1 (W.ι ≫ q)
  haveI hdomW := (wc_fntame_smooth_stalk_normal K W.toScheme (W.ι ≫ q) ⟨c, hcW⟩).1
  haveI hdom : IsDomain (C.presheaf.stalk c) :=
    MulEquiv.isDomain (W.toScheme.presheaf.stalk ⟨c, hcW⟩)
      (W.stalkIso ⟨c, hcW⟩).commRingCatIsoToRingEquiv.symm.toMulEquiv
  obtain ⟨ξ', hξ', h', hne⟩ := wcpa_dj_p1rec_other_component K C q ξ c hξ hc.2
  have h : ξ ⤳ c := specializes_iff_mem_closure.mpr hc.1
  have P1 := wcpa_dj_p1rec_stalk_primes C c ξ ξ' h h'
  have hmin := P1.1 hξ
  have hmin' := (wcpa_dj_p1rec_stalk_primes C c ξ' ξ h' h).1 hξ'
  have hbot : ∀ P ∈ minimalPrimes (C.presheaf.stalk c), P = ⊥ := by
    intro P hP
    have hb := @Ideal.minimalPrimes_eq_subsingleton_self (C.presheaf.stalk c) _ ⊥
      Ideal.isPrime_bot
    exact (show P ∈ ({⊥} : Set (Ideal (C.presheaf.stalk c))) from hb ▸ hP)
  exact hne (P1.2 ((hbot _ hmin).trans (hbot _ hmin').symm)).symm

theorem wcpa_dj_stc_kmnb_stalk_localization : ∀ (X : Scheme.{u}) (x : X) (q : Ideal (X.presheaf.stalk x))
    [q.IsPrime],
    ∃ (w : X) (hsp : w ⤳ x),
      (∀ b, (X.presheaf.stalkSpecializes hsp).hom b ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk w) ↔
        b ∈ q) ∧
      letI := (X.presheaf.stalkSpecializes hsp).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk w) q :=
by
  intro X x q hq
  have gen : ∀ (q : PrimeSpectrum (X.presheaf.stalk x)), ∃ hsp : X.fromSpecStalk x q ⤳ x,
      ∀ a : X.presheaf.stalk x, (X.presheaf.stalkSpecializes hsp).hom a ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk x q)) ↔ a ∈ q.asIdeal := by
    intro q
    have hsp : X.fromSpecStalk x q ⤳ x := by
      first
      | exact (Scheme.range_fromSpecStalk (X := X) (x := x)).subset ⟨q, rfl⟩
      | (have h : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x) := ⟨q, rfl⟩
         rwa [Scheme.range_fromSpecStalk] at h)
      | (have h1 : q ⤳ IsLocalRing.closedPoint (X.presheaf.stalk x) :=
           (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
         have h2 := h1.map (X.fromSpecStalk x).continuous
         rwa [Scheme.fromSpecStalk_closedPoint] at h2)
    refine ⟨hsp, fun a => ?_⟩
    have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = q := by
      apply (X.fromSpecStalk x).isEmbedding.injective
      first
      | (rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.fromSpecStalk_closedPoint])
      | (show (Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk x)
            (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = _
         rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
      | (have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk x q)) ⟶ X =>
            k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))))
            (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
         simp only [Scheme.Hom.comp_apply] at e
         rw [e, Scheme.fromSpecStalk_closedPoint])
    have h2 : a ∈ q.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q)))).asIdeal := by
      rw [key]
    rw [h2]
    first
    | exact Iff.rfl
    | (rw [Spec.map_base_apply]; exact Iff.rfl)
    | (rw [Scheme.Spec_map_base]; exact Iff.rfl)
    | simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, IsLocalRing.closedPoint]
  have locz : ∀ (x z : X) (h : x ⤳ z),
      letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk x)
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
          (X.presheaf.stalkSpecializes h).hom) := by
    intro x z h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
        have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
        have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
        have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
          exact Ideal.mem_map_of_mem _ haQ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
      haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
      show IsLocalization _ S
      refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        show φ (gR a) ∉ IsLocalRing.maximalIdeal S
        rw [hc a]
        exact IsLocalRing.notMem_maximalIdeal.mpr
          (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
      · intro r hr
        exact IsLocalRing.notMem_maximalIdeal.mp hr
    obtain ⟨W, hW, hzW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
    have hxW : x ∈ W := h.mem_open W.isOpen hzW
    have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
    have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
    have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z hzW).hom =
        (X.presheaf.germ W x hxW).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
    exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx
  obtain ⟨hsp, hiff⟩ := gen ⟨q, hq⟩
  refine ⟨X.fromSpecStalk x ⟨q, hq⟩, hsp, fun b => hiff b, ?_⟩
  have hloc := locz (X.fromSpecStalk x ⟨q, hq⟩) x hsp
  have hEq : (IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk x ⟨q, hq⟩))).comap
      (X.presheaf.stalkSpecializes hsp).hom = q :=
    Ideal.ext fun b => by rw [Ideal.mem_comap]; exact hiff b
  letI := (X.presheaf.stalkSpecializes hsp).hom.toAlgebra
  have key : ∀ (P : Ideal (X.presheaf.stalk x)) [P.IsPrime], P = q →
      IsLocalization.AtPrime (X.presheaf.stalk (X.fromSpecStalk x ⟨q, hq⟩)) P →
      IsLocalization.AtPrime (X.presheaf.stalk (X.fromSpecStalk x ⟨q, hq⟩)) q := by
    intro P _ h hP
    subst h
    exact hP
  exact key _ hEq hloc

theorem wcpa_dj_csp_selfnode_branches (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (hss : wcpaDjSemistable q) (ξ : C)
    (hξ : closure {ξ} ∈ irreducibleComponents C) (c : C) (h : ξ ⤳ c)
    (hcl : IsClosed ({c} : Set C))
    (hns : ¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q))
    (hnE : c ∉ closure (closure ({ξ} : Set C))ᶜ) :
    ∃ V₀ V₁ : ValuationSubring (C.residueField ξ), V₀ ≠ V₁ ∧
      (∀ a, (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a ∈ V₀) ∧
      (∀ a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk c),
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a ∈ V₀.nonunits) ∧
      (∀ a, (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a ∈ V₁) ∧
      (∀ a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk c),
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a ∈ V₁.nonunits) :=
by
  classical

  let σ : Fin 2 → MvPowerSeries (Fin 2) K →+* PowerSeries K := fun j =>
    { toFun := fun f => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
      map_one' := by
        ext n
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
        simp
      map_mul' := by
        intro f g
        ext n
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
          Finsupp.antidiagonal_single, Finset.sum_map]
        simp [PowerSeries.coeff_mk]
      map_zero' := by ext n; simp
      map_add' := by intro f g; ext n; simp }
  have hσc : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) K) (n : ℕ),
      PowerSeries.coeff n (σ j f) = MvPowerSeries.coeff (Finsupp.single j n) f :=
    fun j f n => PowerSeries.coeff_mk n (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
  have hσX : ∀ i j : Fin 2, i ≠ j → σ j (MvPowerSeries.X i) = 0 := by
    intro i j hij
    ext n
    rw [hσc, MvPowerSeries.coeff_X, map_zero, if_neg]
    intro h
    have h2 := congrArg (fun m : Fin 2 →₀ ℕ => m i) h
    simp [Finsupp.single_apply, hij, Ne.symm hij] at h2
  have hσXs : ∀ j : Fin 2, σ j (MvPowerSeries.X j) = PowerSeries.X := by
    intro j
    ext n
    rw [hσc, MvPowerSeries.coeff_X, PowerSeries.coeff_X]
    by_cases hn : n = 1
    · subst hn; simp
    · rw [if_neg hn, if_neg]
      intro h
      exact hn (Finsupp.single_injective j h)
  have hσker : ∀ i j : Fin 2, i ≠ j → (∀ l : Fin 2, l ≠ j → l = i) →
      ∀ f, σ j f = 0 → MvPowerSeries.X i ∣ f := by
    intro i j hij hk f hf
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    have hm' : m = Finsupp.single j (m j) := by
      ext l
      by_cases hlj : l = j
      · subst hlj; simp
      · rw [hk l hlj]
        simp [hm, Finsupp.single_apply, hij, Ne.symm hij]
    rw [hm', ← hσc, hf, map_zero]
  have hσspan : ∀ (j : Fin 2), ∀ a ∈ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}, σ j a = 0 := by
    intro j a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_mul]
    fin_cases j
    · simp [hσX 1 0 (by decide)]
    · simp [hσX 0 1 (by decide)]
  have hcc : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) K),
      PowerSeries.constantCoeff (σ j f) = MvPowerSeries.constantCoeff f := by
    intro j f
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, hσc, Finsupp.single_zero,
      ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
  have hM : ∀ m ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K),
      MvPowerSeries.constantCoeff m = 0 := by
    intro m hm
    by_contra h
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hm))
      (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr h))
  have hm2 : ∀ (j : Fin 2), ∀ G ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ 2,
      PowerSeries.X ^ 2 ∣ σ j G := by
    intro j G hG
    rw [pow_two] at hG
    refine Submodule.mul_induction_on hG ?_ ?_
    · intro m hm n hn
      have h1 : PowerSeries.X ∣ σ j m := PowerSeries.X_dvd_iff.mpr (by rw [hcc, hM m hm])
      have h2 : PowerSeries.X ∣ σ j n := PowerSeries.X_dvd_iff.mpr (by rw [hcc, hM n hn])
      rw [map_mul, pow_two]
      exact mul_dvd_mul h1 h2
    · intro x y hx hy
      rw [map_add]
      exact dvd_add hx hy

  let π : Fin 2 → (MvPowerSeries (Fin 2) K ⧸ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) →+* PowerSeries K :=
    fun j => Ideal.Quotient.lift _ (σ j) (hσspan j)
  have hπ : ∀ j F, π j (Ideal.Quotient.mk _ F) = σ j F := fun j F => Ideal.Quotient.lift_mk _ _ _
  have hπker0 : ∀ b, π 0 b = 0 → Ideal.Quotient.mk (Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X 0) * b = 0 := by
    intro b hb
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [hπ] at hb
    obtain ⟨g, rfl⟩ := hσker 1 0 (by decide) (fun l hl => by fin_cases l <;> simp_all) f hb
    rw [← map_mul, ← mul_assoc, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have hπker1 : ∀ b, π 1 b = 0 → Ideal.Quotient.mk (Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X 1) * b = 0 := by
    intro b hb
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [hπ] at hb
    obtain ⟨g, rfl⟩ := hσker 0 1 (by decide) (fun l hl => by fin_cases l <;> simp_all) f hb
    rw [← map_mul, ← mul_assoc, mul_comm (MvPowerSeries.X 1), Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have hz0 : Ideal.Quotient.mk (Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X 0) ≠ 0 := by
    intro h0
    have := congrArg (π 0) h0
    rw [hπ, hσXs, map_zero] at this
    exact PowerSeries.X_ne_zero this
  have hz1 : Ideal.Quotient.mk (Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X 1) ≠ 0 := by
    intro h0
    have := congrArg (π 1) h0
    rw [hπ, hσXs, map_zero] at this
    exact PowerSeries.X_ne_zero this

  have s8 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [IsDomain A]
      (e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) K ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}))
      (p : (MvPowerSeries (Fin 2) K ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) →+* PowerSeries K)
      (z : MvPowerSeries (Fin 2) K ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}),
      z ≠ 0 → (∀ b, p b = 0 → z * b = 0) →
      Function.Injective (p.comp (e.toRingHom.comp
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)))) := by
    intro A _ _ _ _ e p z hz hpz
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have hreg : IsSMulRegular A a := by
      intro x y hxy
      simp only [smul_eq_mul] at hxy
      exact mul_left_cancel₀ hne hxy
    haveI := AdicCompletion.flat_of_isNoetherian (IsLocalRing.maximalIdeal A)
    have hreg' := hreg.of_flat (S := AdicCompletion (IsLocalRing.maximalIdeal A) A)
    have h1 : z * e (algebraMap A _ a) = 0 := hpz _ ha
    have h2 : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a * e.symm z =
        algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a * 0 := by
      apply e.injective
      rw [map_mul, map_mul, map_zero, mul_zero, e.apply_symm_apply]
      exact (mul_comm _ _).trans h1
    have h3 : e.symm z = 0 := hreg' h2
    apply hz
    rw [← e.apply_symm_apply z, h3, map_zero]

  have s7 : ∀ (A F : Type u) [CommRing A] [IsLocalRing A] [Field F] (ρ : A →+* F)
      (ψ : A →+* PowerSeries K), Function.Injective ρ →
      (∀ x : F, ∃ a b : A, ρ b ≠ 0 ∧ x * ρ b = ρ a) → Function.Injective ψ →
      (∀ a ∈ IsLocalRing.maximalIdeal A, PowerSeries.constantCoeff (ψ a) = 0) →
      ∃ V : ValuationSubring F, (∀ a, ρ a ∈ V) ∧
        (∀ a ∈ IsLocalRing.maximalIdeal A, ρ a ∈ V.nonunits) ∧
        ∀ a a' : A, ρ a ≠ 0 → (ρ a' * (ρ a)⁻¹ ∈ V ↔ ψ a ∣ ψ a') := by
    intro A F _ _ _ ρ ψ hρ hfrac hψ hmax
    haveI : IsDomain A := Function.Injective.isDomain ρ hρ
    letI : Algebra A F := ρ.toAlgebra
    haveI hfr : IsFractionRing A F := by
      rw [IsFractionRing, isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · intro y
        exact isUnit_iff_ne_zero.mpr
          (fun h0 => nonZeroDivisors.ne_zero y.2 (hρ (h0.trans (map_zero ρ).symm)))
      · intro z
        obtain ⟨a, b, hb, hz⟩ := hfrac z
        have hb' : b ∈ nonZeroDivisors A :=
          mem_nonZeroDivisors_of_ne_zero (fun h => hb (by rw [h, map_zero]))
        exact ⟨⟨a, ⟨b, hb'⟩⟩, hz⟩
      · intro x y hxy
        exact ⟨1, by rw [hρ hxy]⟩
    let g : A →+* FractionRing (PowerSeries K) :=
      (algebraMap (PowerSeries K) (FractionRing (PowerSeries K))).comp ψ
    have hg : Function.Injective g :=
      (IsFractionRing.injective (PowerSeries K) (FractionRing (PowerSeries K))).comp hψ
    let lam : F →+* FractionRing (PowerSeries K) := IsFractionRing.lift hg
    have hlam : ∀ a, lam (ρ a) =
        algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) (ψ a) :=
      fun a => IsFractionRing.lift_algebraMap hg a
    let W : ValuationSubring (FractionRing (PowerSeries K)) :=
      (ValuationRing.valuation (PowerSeries K) (FractionRing (PowerSeries K))).valuationSubring
    have hW : ∀ z, z ∈ W ↔ ∃ p : PowerSeries K,
        algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) p = z := fun z => by
      rw [Valuation.mem_valuationSubring_iff, ← Valuation.mem_integer_iff]
      exact ValuationRing.mem_integer_iff (PowerSeries K) (FractionRing (PowerSeries K)) z
    have hinjL := IsFractionRing.injective (PowerSeries K) (FractionRing (PowerSeries K))
    have hmemV : ∀ a, ρ a ∈ W.comap lam := fun a => by
      rw [ValuationSubring.mem_comap, hlam, hW]
      exact ⟨ψ a, rfl⟩
    refine ⟨W.comap lam, hmemV, ?_, ?_⟩
    · intro a ha
      rw [ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
      refine ⟨hmemV a, ?_⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have h2 : ρ a * (v : F) = 1 := congrArg Subtype.val hv
      obtain ⟨p, hp⟩ := (hW _).mp (ValuationSubring.mem_comap.mp v.2)
      have h4 : algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) (ψ a * p) = 1 := by
        rw [map_mul, ← hlam, hp, ← map_mul, h2, map_one]
      have h5 : ψ a * p = 1 := hinjL (h4.trans (map_one _).symm)
      have h7 := PowerSeries.isUnit_iff_constantCoeff.mp (isUnit_iff_exists_inv.mpr ⟨p, h5⟩)
      rw [hmax a ha] at h7
      exact not_isUnit_zero h7
    · intro a a' ha
      have ha0 : a ≠ 0 := fun h => ha (by rw [h, map_zero])
      have hga : algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) (ψ a) ≠ 0 := by
        intro h0
        apply ha0
        apply hg
        rw [map_zero]
        exact h0
      rw [ValuationSubring.mem_comap, hW, map_mul, map_inv₀, hlam, hlam]
      constructor
      · rintro ⟨p, hp⟩
        refine ⟨p, ?_⟩
        apply hinjL
        rw [map_mul, hp, mul_comm, mul_assoc, inv_mul_cancel₀ hga, mul_one]
      · rintro ⟨p, hp⟩
        refine ⟨p, ?_⟩
        rw [hp, map_mul, mul_comm (algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) (ψ a)),
          mul_assoc, mul_inv_cancel₀ hga, mul_one]

  have s9 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
      (e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) K ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})),
      (∀ j, ∀ a ∈ IsLocalRing.maximalIdeal A,
        PowerSeries.constantCoeff (π j (e (algebraMap A _ a))) = 0) ∧
      ∃ r r' : A, π 0 (e (algebraMap A _ r)) ≠ 0 ∧
        π 0 (e (algebraMap A _ r)) ∣ π 0 (e (algebraMap A _ r')) ∧
        ¬ (π 1 (e (algebraMap A _ r)) ∣ π 1 (e (algebraMap A _ r'))) := by
    intro A _ _ _ e
    obtain ⟨hbr1, hbr2⟩ := wcpa_dj_lqr_completion_bridge K A e
    have hval : ∀ (t : MvPowerSeries (Fin 2) K), ∃ x : A, ∀ j, ∃ h : PowerSeries K,
        π j (e (algebraMap A _ x)) = σ j t + PowerSeries.X ^ 2 * h := by
      intro t
      obtain ⟨x, hx⟩ := hbr1 2 t
      rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hx
      obtain ⟨G, hG, hGe⟩ := hx
      refine ⟨x, fun j => ?_⟩
      obtain ⟨h, hh⟩ := hm2 j G hG
      refine ⟨h, ?_⟩
      rw [← hh, eq_add_of_sub_eq' hGe.symm, map_add, hπ, hπ]
    refine ⟨?_, ?_⟩
    · intro j a ha
      have := (hbr2 1 a).mpr (by rwa [pow_one])
      rw [pow_one, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at this
      obtain ⟨m, hm, hm'⟩ := this
      rw [← hm', hπ, hcc, hM m hm]
    · obtain ⟨r, hr⟩ := hval (MvPowerSeries.X 0)
      obtain ⟨r', hr'⟩ := hval (MvPowerSeries.X 1)
      obtain ⟨h0, e0⟩ := hr 0
      obtain ⟨h1, e1⟩ := hr 1
      obtain ⟨h0', e0'⟩ := hr' 0
      obtain ⟨h1', e1'⟩ := hr' 1
      rw [hσXs] at e0 e1'
      rw [hσX 1 0 (by decide)] at e0'
      rw [hσX 0 1 (by decide)] at e1
      have hu : IsUnit (1 + PowerSeries.X * h0 : PowerSeries K) := by
        rw [PowerSeries.isUnit_iff_constantCoeff]
        simp
      have e0n : π 0 (e (algebraMap A _ r)) = PowerSeries.X * (1 + PowerSeries.X * h0) := by
        rw [e0]; ring
      refine ⟨r, r', ?_, ?_, ?_⟩
      · rw [e0n]
        exact mul_ne_zero PowerSeries.X_ne_zero hu.ne_zero
      · rw [e0n, e0', hu.mul_right_dvd]
        exact ⟨PowerSeries.X * h0', by ring⟩
      · rw [e1, e1']
        intro hd
        have h2 : (PowerSeries.X : PowerSeries K) ^ 2 ∣ PowerSeries.X + PowerSeries.X ^ 2 * h1' :=
          dvd_trans (by rw [zero_add]; exact dvd_mul_right _ _) hd
        have h3 : (PowerSeries.X : PowerSeries K) ^ 2 ∣ PowerSeries.X :=
          (dvd_add_left (dvd_mul_right _ _)).mp h2
        have h4 : (PowerSeries.X : PowerSeries K) * PowerSeries.X ∣ PowerSeries.X * 1 := by
          rw [mul_one, ← pow_two]; exact h3
        have h5 := (mul_dvd_mul_iff_left PowerSeries.X_ne_zero).mp h4
        have h6 := PowerSeries.X_dvd_iff.mp h5
        rw [map_one] at h6
        exact one_ne_zero h6

  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q

  have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm.hom ≫
      Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hd := wcpa_dj_ssp_bw_ns_transport K (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
    q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ c (hss.2.2 K (𝟙 _) _)
  obtain ⟨e, he⟩ := hd.resolve_left hns

  haveI hred : _root_.IsReduced (C.presheaf.stalk c) :=
    wcpa_dj_nf_node_reduced K (C.presheaf.stalk c)
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ c trivial).hom ⟨e, he⟩

  have hker : ∀ (J : Ideal (C.presheaf.stalk c)), J.IsPrime → ∀ b,
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom b = 0 → b ∈ J := by
    intro J hJ b hb
    obtain ⟨w, hsp, hmem, -⟩ := wcpa_dj_stc_kmnb_stalk_localization C c J
    have hξw : ξ ⤳ w := by
      rw [specializes_iff_mem_closure]
      by_contra hw
      apply hnE
      have h1 : closure ({w} : Set C) ⊆ closure (closure ({ξ} : Set C))ᶜ :=
        closure_mono (Set.singleton_subset_iff.mpr hw)
      exact h1 (specializes_iff_mem_closure.mp hsp)
    have hcomp : C.presheaf.stalkSpecializes hsp ≫ C.presheaf.stalkSpecializes hξw =
        C.presheaf.stalkSpecializes h := C.presheaf.stalkSpecializes_comp hξw hsp
    rw [← hmem]
    by_contra hnm
    have hu : IsUnit ((C.presheaf.stalkSpecializes hsp).hom b) :=
      IsLocalRing.notMem_maximalIdeal.mp hnm
    have hu2 := hu.map (C.presheaf.stalkSpecializes hξw).hom
    have hu3 := hu2.map (C.residue ξ).hom
    have e1 : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom b = (C.residue ξ).hom
        ((C.presheaf.stalkSpecializes hξw).hom ((C.presheaf.stalkSpecializes hsp).hom b)) := by
      rw [← hcomp]; rfl
    rw [← e1, hb] at hu3
    exact not_isUnit_zero hu3
  have hinj : Function.Injective (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hnil : IsNilpotent a := nilpotent_iff_mem_prime.mpr (fun J hJ => hker J hJ a ha)
    exact hnil.eq_zero
  haveI hdom : IsDomain (C.presheaf.stalk c) := Function.Injective.isDomain _ hinj

  have hfrac : ∀ x : C.residueField ξ, ∃ a b : C.presheaf.stalk c,
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom b ≠ 0 ∧
      x * (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom b =
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a := by
    obtain ⟨w, hsp, hmem, hloc⟩ :=
      wcpa_dj_stc_kmnb_stalk_localization C c (⊥ : Ideal (C.presheaf.stalk c))
    have hkereq : RingHom.ker (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom =
        RingHom.ker (C.presheaf.stalkSpecializes hsp ≫ C.residue w).hom := by
      ext b
      rw [RingHom.mem_ker, RingHom.mem_ker]
      constructor
      · intro hb
        have : b = 0 := hinj (hb.trans (map_zero _).symm)
        rw [this, map_zero]
      · intro hb
        have h2 : IsLocalRing.residue _ ((C.presheaf.stalkSpecializes hsp).hom b) = 0 := hb
        have h1 := (IsLocalRing.residue_eq_zero_iff _).mp h2
        rw [Ideal.mem_bot.mp ((hmem b).mp h1), map_zero]
    have hξw : ξ = w := (wcpa_dj_p1rec_stalk_primes C c ξ w h hsp).2 hkereq
    subst hξw
    intro x
    letI := (C.presheaf.stalkSpecializes hsp).hom.toAlgebra
    haveI := hloc
    obtain ⟨y, rfl⟩ := C.residue_surjective ξ x
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj
      (Ideal.primeCompl (⊥ : Ideal (C.presheaf.stalk c))) (S := C.presheaf.stalk ξ) y
    refine ⟨a, s, ?_, ?_⟩
    · intro h0
      exact s.2 (Ideal.mem_bot.mpr (hinj (h0.trans (map_zero _).symm)))
    · have := congrArg (C.residue ξ).hom hs
      rw [map_mul] at this
      exact this

  have hψ0 := s8 (C.presheaf.stalk c) e (π 0) _ hz0 hπker0
  have hψ1 := s8 (C.presheaf.stalk c) e (π 1) _ hz1 hπker1
  obtain ⟨hmax, r, r', hr0, hdiv0, hndiv1⟩ := s9 (C.presheaf.stalk c) e
  obtain ⟨V₀, hV0a, hV0b, crit₀⟩ := s7 (C.presheaf.stalk c) (C.residueField ξ) _ _ hinj hfrac
    hψ0 (fun a ha => hmax 0 a ha)
  obtain ⟨V₁, hV1a, hV1b, crit₁⟩ := s7 (C.presheaf.stalk c) (C.residueField ξ) _ _ hinj hfrac
    hψ1 (fun a ha => hmax 1 a ha)
  have hr : r ≠ 0 := by
    rintro rfl
    apply hr0
    simp only [map_zero]
  have hρr : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom r ≠ 0 :=
    fun h0 => hr (hinj (h0.trans (map_zero _).symm))
  have hin0 := (crit₀ r r' hρr).mpr hdiv0
  have hout1 : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom r' *
      ((C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom r)⁻¹ ∉ V₁ :=
    fun hm => hndiv1 ((crit₁ r r' hρr).mp hm)
  refine ⟨V₀, V₁, ?_, hV0a, hV0b, hV1a, hV1b⟩
  rintro rfl
  exact hout1 hin0

theorem wcpa_dj_csp_dominate_ctr (K : Type u) [Field K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K))
    (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (ξ c : C) (h : ξ ⤳ c) (hne : ξ ≠ c)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (V : ValuationSubring (C.residueField ξ))
    (hV1 : ∀ a, (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a ∈ V)
    (hV2 : ∀ a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk c),
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a ∈ V.nonunits) :
    wcpaDjNtV' K V ∧ ∃ b, wcpaDjCtr L ξ V b c :=
by
  classical

  have key : ∀ (U : C.Opens) (hc : c ∈ U) (hξU : ξ ∈ U) (s : Γ(C, U)),
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom ((C.presheaf.germ U c hc).hom s) =
        (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom s := by
    intro U hc hξU s
    have e : C.presheaf.germ U c hc ≫ C.presheaf.stalkSpecializes h = C.presheaf.germ U ξ hξU :=
      C.presheaf.germ_stalkSpecializes hc h
    rw [← e]
    rfl

  have htop : ∀ y : C.residueField ξ, y ≠ 0 → y ∉ (⊤ : ValuationSubring (C.residueField ξ)).nonunits := by
    intro y hy hmem
    obtain ⟨ha, hmax⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp hmem
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmax
    exact hmax (isUnit_iff_exists_inv.mpr ⟨⟨y⁻¹, ValuationSubring.mem_top _⟩,
      Subtype.ext (mul_inv_cancel₀ hy)⟩)

  have hc_mem : c ∈ ⨆ a, L.V a := by rw [hOK.2.1]; trivial
  obtain ⟨b, hcb⟩ := TopologicalSpace.Opens.mem_iSup.mp hc_mem
  have hξb : ξ ∈ L.V b := h.mem_open (L.V b).isOpen hcb

  have hK : ∀ k : K, algebraMap K (C.residueField ξ) k ∈ V := by
    intro k
    rw [hA]
    rw [show (wcpaDjFK K q ξ) k = (C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ).hom
      (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop).hom k) from rfl]
    rw [← key ⊤ trivial trivial]
    exact hV1 _

  have hVne : V ≠ ⊤ := by
    have hn : ¬ c ⤳ ξ := fun hcs => hne (inseparable_iff_specializes_and.mpr ⟨h, hcs⟩).eq
    rw [specializes_iff_forall_open] at hn
    push_neg at hn
    obtain ⟨s, hs, hξs, hcs⟩ := hn
    let W : C.Opens := ⟨s, hs⟩ ⊓ L.V b
    have hξW : ξ ∈ W := ⟨hξs, hξb⟩
    obtain ⟨f, hfW, hξf⟩ := (hOK.1 b).exists_basicOpen_le (⟨ξ, hξW⟩ : W) hξb
    have hcf : c ∉ C.basicOpen f := fun hc' => hcs (hfW hc').1
    have hgc : (C.presheaf.germ (L.V b) c hcb).hom f ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk c) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => hcf ((Scheme.mem_basicOpen C f c hcb).mpr hu)
    have hne0 : (C.presheaf.germ (L.V b) ξ hξb ≫ C.residue ξ).hom f ≠ 0 := by
      have hu : IsUnit ((C.presheaf.germ (L.V b) ξ hξb).hom f) :=
        (Scheme.mem_basicOpen C f ξ hξb).mp hξf
      have hu' := hu.map (C.residue ξ).hom
      exact hu'.ne_zero
    intro hVt
    have h2 := hV2 _ hgc
    rw [key _ hcb hξb f, hVt] at h2
    exact htop _ hne0 h2
  refine ⟨⟨hK, hVne⟩, b, hξb, hcb, ⟨hξb, fun x => ?_⟩, fun x => ⟨fun hx => ?_, fun hx => ?_⟩⟩
  · rw [← key _ hcb hξb x]
    exact hV1 _
  · rw [← key _ hcb hξb x]
    exact hV2 _ hx
  · rw [← key _ hcb hξb x] at hx
    by_contra hna
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hna
    obtain ⟨w, hw⟩ := hna.exists_right_inv
    have h1 : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom
          ((C.presheaf.germ (L.V b) c hcb).hom x) *
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom w = 1 := by
      rw [← map_mul, hw, map_one]
    obtain ⟨ha, hmax⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmax
    exact hmax (isUnit_iff_exists_inv.mpr ⟨⟨_, hV1 w⟩, Subtype.ext h1⟩)

theorem wcpa_dj_csp_center_unique (K : Type u) [Field K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K))
    (hq : IsProper q) (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (ξ : C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (V : ValuationSubring (C.residueField ξ)) (hV : wcpaDjNtV' K V) (b b' : Fin L.m) (c c' : C)
    (h1 : wcpaDjCtr L ξ V b c) (h2 : wcpaDjCtr L ξ V b' c') : c = c' :=
by
  classical
  haveI hsep : IsSeparated q := inferInstance

  have hdom : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S),
      Function.Injective f → IsDominant (Spec.map (CommRingCat.ofHom f)) := by
    intro R S _ _ f hf
    rw [isDominant_iff]
    have e : (⇑(Spec.map (CommRingCat.ofHom f)) : Spec (.of S) → Spec (.of R)) =
        PrimeSpectrum.comap f := by
      funext x; exact Spec.map_apply _ x
    rw [e]
    refine (PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical (f := f)).mpr ?_
    rw [(RingHom.injective_iff_ker_eq_bot f).mp hf]
    exact bot_le

  have hgen : ∀ (U : C.Opens) (hU : IsAffineOpen U) (hξ : ξ ∈ U)
      (hρ : ∀ x : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x ∈ V),
      Spec.map (CommRingCat.ofHom V.subtype) ≫ Spec.map (CommRingCat.ofHom
        ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ)) ≫ hU.fromSpec =
        C.fromSpecResidueField ξ := by
    intro U hU hξ hρ
    have ha : CommRingCat.ofHom ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ) ≫
        CommRingCat.ofHom V.subtype = C.presheaf.germ U ξ hξ ≫ C.residue ξ := by
      ext x; rfl
    rw [← Spec.map_comp_assoc, ha, Spec.map_comp_assoc,
      show Spec.map (C.presheaf.germ U ξ hξ) ≫ hU.fromSpec = hU.fromSpecStalk hξ from rfl,
      hU.fromSpecStalk_eq_fromSpecStalk]
    rfl

  have hpt : ∀ (U : C.Opens) (hU : IsAffineOpen U) (hξ : ξ ∈ U)
      (hρ : ∀ x : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x ∈ V) (c : C) (hc : c ∈ U),
      (∀ x : Γ(C, U), ((C.presheaf.germ U c hc).hom x ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk c) ↔
        (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x ∈ V.nonunits)) →
      (Spec.map (CommRingCat.ofHom ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ)) ≫
        hU.fromSpec) (show Spec (.of ↥V) from IsLocalRing.closedPoint ↥V) = c := by
    intro U hU hξ hρ c hc hi
    rw [Scheme.Hom.comp_apply]
    refine (congrArg hU.fromSpec ?_).trans (hU.fromSpec_primeIdealOf ⟨c, hc⟩)
    rw [hU.primeIdealOf_eq_map_closedPoint]
    apply PrimeSpectrum.ext
    ext x
    show x ∈ Ideal.comap ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hρ)
        (IsLocalRing.maximalIdeal V) ↔
      x ∈ Ideal.comap (C.presheaf.germ U c hc).hom (IsLocalRing.maximalIdeal (C.presheaf.stalk c))
    rw [Ideal.mem_comap, Ideal.mem_comap]
    rw [hi x, ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
    constructor
    · intro h
      exact ⟨hρ x, h⟩
    · rintro ⟨_, h⟩
      exact h

  obtain ⟨hb, hc, ⟨hb0, hρ⟩, hi⟩ := h1
  obtain ⟨hb', hc', ⟨hb0', hρ'⟩, hi'⟩ := h2
  obtain ⟨g, hg⟩ : ∃ g : Spec (.of ↥V) ⟶ C, g = Spec.map (CommRingCat.ofHom
      ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom.codRestrict V hρ)) ≫ (hOK.1 b).fromSpec :=
    ⟨_, rfl⟩
  obtain ⟨g', hg'⟩ : ∃ g' : Spec (.of ↥V) ⟶ C, g' = Spec.map (CommRingCat.ofHom
      ((C.presheaf.germ (L.V b') ξ hb' ≫ C.residue ξ).hom.codRestrict V hρ')) ≫
        (hOK.1 b').fromSpec :=
    ⟨_, rfl⟩

  haveI : IsDominant (Spec.map (CommRingCat.ofHom V.subtype)) :=
    hdom ↥V (C.residueField ξ) V.subtype Subtype.val_injective

  have e1 : Spec.map (CommRingCat.ofHom V.subtype) ≫ g =
      Spec.map (CommRingCat.ofHom V.subtype) ≫ g' := by
    rw [hg, hg']
    exact (hgen (L.V b) (hOK.1 b) hb hρ).trans (hgen (L.V b') (hOK.1 b') hb' hρ').symm

  have e2 : g ≫ q = g' ≫ q := by
    refine ext_of_isDominant (Spec.map (CommRingCat.ofHom V.subtype)) ?_
    have := congrArg (fun h => h ≫ q) e1
    simpa only [Category.assoc] using this

  have e3 : g = g' := ext_of_isDominant_of_isSeparated q e2 _ e1

  have k1 : g (show Spec (.of ↥V) from IsLocalRing.closedPoint ↥V) = c := by
    rw [hg]; exact hpt (L.V b) (hOK.1 b) hb hρ c hc hi
  have k2 : g' (show Spec (.of ↥V) from IsLocalRing.closedPoint ↥V) = c' := by
    rw [hg']; exact hpt (L.V b') (hOK.1 b') hb' hρ' c' hc' hi'
  rw [← k1, ← k2, e3]

theorem wcpa_dj_csp_stability_at_id (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C))
    (hst : wcpaDjStablePtd q n σ) (E : Set C) (hE : E ∈ irreducibleComponents C)
    (hP1 : ∃ (Er : Scheme.{u}) (ι : Er ⟶ C)
      (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced Er ∧ Set.range ι = E ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ q) :
    3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin n // ∃ p, σ i p ∈ E} :=
by
  classical
  obtain ⟨Er, ι, θ, hι, hred, hrange, hcomp⟩ := hP1
  set φ := Limits.pullback.fst q (𝟙 (Spec (.of K))) with hφdef
  haveI : IsIso φ := inferInstance
  have hφq : φ ≫ q = Limits.pullback.snd q (𝟙 (Spec (.of K))) := by
    rw [hφdef, Limits.pullback.condition, Category.comp_id]
  have h1 : ∀ y : C, φ (inv φ y) = y := by
    intro y
    rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]
    rfl
  have h2 : ∀ x, inv φ (φ x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
    rfl
  let h := φ.homeomorph
  have hh : ∀ x, h x = φ x := fun x => rfl
  set E' := (⇑φ) ⁻¹' E with hE'def
  have hE'h : E' = h ⁻¹' E := rfl
  have hE' : h ⁻¹' E ∈ irreducibleComponents _ := by
    apply preimage_mem_irreducibleComponents_of_isPreirreducible_fiber hE h.continuous
      h.isOpenMap (fun y => (Set.subsingleton_singleton.preimage h.injective).isPreirreducible)
    rw [h.range_coe, Set.inter_univ]
    exact hE.1.nonempty
  rw [← hE'h] at hE'
  have hrange' : Set.range (ι ≫ inv φ) = E' := by
    ext z
    constructor
    · rintro ⟨e, rfl⟩
      show φ ((ι ≫ inv φ) e) ∈ E
      rw [Scheme.Hom.comp_apply, h1, ← hrange]
      exact ⟨e, rfl⟩
    · intro hz
      have hz' : φ z ∈ Set.range ι := by rw [hrange]; exact hz
      obtain ⟨e, he⟩ := hz'
      refine ⟨e, ?_⟩
      rw [Scheme.Hom.comp_apply, he, h2]
  have key := hst.2.2 K (𝟙 (Spec (.of K))) E' hE' ⟨Er, ι ≫ inv φ, θ, inferInstance, hred,
    hrange', hcomp.trans (by rw [← hφq, Category.assoc, IsIso.inv_hom_id_assoc])⟩
  have hS : E' ∩ closure E'ᶜ = h ⁻¹' (E ∩ closure Eᶜ) := by
    rw [hE'h, ← Set.preimage_compl, ← Homeomorph.preimage_closure, Set.preimage_inter]
  have hn1 : (E' ∩ closure E'ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
    rw [hS]
    exact Set.ncard_preimage_of_injective_subset_range h.injective
      (by rw [h.range_coe]; exact Set.subset_univ _)
  have hn2 : Nat.card {i : Fin n // ∃ x ∈ E', ∃ p : Spec (.of K),
      φ x = σ i ((𝟙 (Spec (.of K)) : Spec (.of K) ⟶ Spec (.of K)) p)} =
      Nat.card {i : Fin n // ∃ p, σ i p ∈ E} := by
    apply Nat.card_congr
    apply Equiv.subtypeEquivRight
    intro i
    constructor
    · rintro ⟨x, hx, p, hp⟩
      refine ⟨p, ?_⟩
      have hx' : φ x ∈ E := hx
      rw [hp] at hx'
      exact hx'
    · rintro ⟨p, hp⟩
      refine ⟨inv φ (σ i p), ?_, p, ?_⟩
      · show φ (inv φ (σ i p)) ∈ E
        rw [h1]
        exact hp
      · rw [h1]
        rfl
  rw [hn1, hn2] at key
  exact key

theorem wcpa_dj_cdp_special_points (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (n : ℕ) (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C)
    (hn : 3 ≤ n) (hst : wcpaDjStablePtd q n σ) (hgc : GeometricallyConnected q)
    (hOK : wcpaDjCocOK L) (ξ : C) (hξ : closure {ξ} ∈ irreducibleComponents C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ) :
    (∃ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V ∧ wcpaDjSpecialV q σ L ξ V) ∧
    ((∃ t : C.residueField ξ, IntermediateField.adjoin K {t} = ⊤) →
      ∃ V₁ V₂ V₃ : ValuationSubring (C.residueField ξ), V₁ ≠ V₂ ∧ V₁ ≠ V₃ ∧ V₂ ≠ V₃ ∧
        (wcpaDjNtV' K V₁ ∧ wcpaDjSpecialV q σ L ξ V₁) ∧
        (wcpaDjNtV' K V₂ ∧ wcpaDjSpecialV q σ L ξ V₂) ∧
        (wcpaDjNtV' K V₃ ∧ wcpaDjSpecialV q σ L ξ V₃)) :=
by
  classical
  have hss : wcpaDjSemistable q := hst.1
  have hq : IsProper q := hst.1.2.1
  haveI := hgc
  haveI hconn : ConnectedSpace C :=
    GeometricallyConnected.geometrically_connectedSpace (𝟙 (Spec (.of K))) (𝟙 C) q
      IsPullback.of_id_fst
  have hgen := wcpa_dj_lsp_generic_smooth K C q hss ξ hξ
  have hξnc : ¬ IsClosed ({ξ} : Set C) := hgen.1
  have hξE : ξ ∈ closure ({ξ} : Set C) := subset_closure rfl

  have s11 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (ρ : A →+* C.residueField ξ),
      ∃ V : ValuationSubring (C.residueField ξ), (∀ a, ρ a ∈ V) ∧
        ∀ a ∈ IsLocalRing.maximalIdeal A, ρ a ∈ V.nonunits := by
    intro A _ _ ρ
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.range ρ)
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hV
    have hmemR : ∀ a, ρ a ∈ (LocalSubring.range ρ).toSubring := fun a => ⟨a, rfl⟩
    have hmem : ∀ a, ρ a ∈ V := fun a => hle (hmemR a)
    refine ⟨V, hmem, fun a ha => ?_⟩
    rw [ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
    refine ⟨hmem a, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hu' : IsUnit (Subring.inclusion hle ⟨ρ a, hmemR a⟩) := hu
    have hu2 : IsUnit (⟨ρ a, hmemR a⟩ : (LocalSubring.range ρ).toSubring) :=
      hloc.map_nonunit _ hu'
    obtain ⟨w, hw⟩ := hu2.exists_right_inv
    obtain ⟨b, hb⟩ := w.2
    have h1 : ρ (a * b) = 1 := by
      rw [map_mul, hb]
      exact congrArg Subtype.val hw
    have hm : a * b - 1 ∈ IsLocalRing.maximalIdeal A := by
      by_contra hc
      have hunit : IsUnit (a * b - 1) := by
        rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
      have := hunit.map ρ
      rw [map_sub, h1, map_one, sub_self] at this
      exact not_isUnit_zero this
    have h1m : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
      have := Ideal.sub_mem _ (Ideal.mul_mem_right b _ ha) hm
      simpa using this
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h1m)

  have hprod : ∀ c : C, c ∈ closure ({ξ} : Set C) → c ≠ ξ →
      ((¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∨
        ∃ i p, σ i p = c) →
      ∃ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V ∧
        wcpaDjSpecialV q σ L ξ V ∧ ∃ b, wcpaDjCtr L ξ V b c := by
    intro c hc hcξ hsp
    have h : ξ ⤳ c := specializes_iff_mem_closure.mpr hc
    obtain ⟨V, hV1, hV2⟩ :=
      s11 (C.presheaf.stalk c) (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom
    obtain ⟨hNt, b, hctr⟩ :=
      wcpa_dj_csp_dominate_ctr K C q L hOK ξ c h (Ne.symm hcξ) hA V hV1 hV2
    exact ⟨V, hNt, ⟨c, b, hctr, hsp⟩, b, hctr⟩

  have hdist : ∀ (V V' : ValuationSubring (C.residueField ξ)) (c c' : C), wcpaDjNtV' K V →
      (∃ b, wcpaDjCtr L ξ V b c) → (∃ b, wcpaDjCtr L ξ V' b c') → c ≠ c' → V ≠ V' := by
    rintro V V' c c' hNt ⟨b, hb⟩ ⟨b', hb'⟩ hcc rfl
    exact hcc (wcpa_dj_csp_center_unique K C q hq L hOK ξ hA V hNt b b' c c' hb hb')

  obtain ⟨p₀⟩ : Nonempty (Spec (.of K)) := inferInstance
  have hσp : ∀ i p, σ i p = σ i p₀ := fun i p => by rw [Subsingleton.elim p p₀]
  have hmcl : ∀ i, IsClosed ({σ i p₀} : Set C) := by
    intro i
    haveI : IsClosedImmersion (σ i) := isClosedImmersion_of_comp_eq_id q (σ i) (hst.2.1.1 i)
    have hr : Set.range (σ i) = {σ i p₀} := by
      ext x
      constructor
      · rintro ⟨p, rfl⟩
        exact hσp i p
      · intro hx
        rw [Set.mem_singleton_iff] at hx
        exact ⟨p₀, hx.symm⟩
    rw [← hr]
    exact (σ i).isClosedEmbedding.isClosed_range
  have hmξ : ∀ i, σ i p₀ ≠ ξ := fun i h => hξnc (by rw [← h]; exact hmcl i)
  have hmsm : ∀ i, ∃ W : C.Opens, σ i p₀ ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) :=
    fun i => hst.2.1.2.2 i p₀
  have hminj : Function.Injective (fun i => σ i p₀) := by
    intro i j hij
    by_contra hne
    exact hst.2.1.2.1 i j p₀ p₀ hne hij

  have htop : closure ({ξ} : Set C) ≠ Set.univ →
      (closure ({ξ} : Set C) ∩ closure (closure ({ξ} : Set C))ᶜ).Nonempty := by
    intro hne
    by_contra hemp
    rw [Set.not_nonempty_iff_eq_empty] at hemp
    have hcl : IsClosed (closure ({ξ} : Set C))ᶜ := by
      have he : closure (closure ({ξ} : Set C))ᶜ = (closure ({ξ} : Set C))ᶜ := by
        apply subset_antisymm _ subset_closure
        intro x hx hxE
        have hx' : x ∈ closure ({ξ} : Set C) ∩ closure (closure ({ξ} : Set C))ᶜ := ⟨hxE, hx⟩
        rw [hemp] at hx'
        exact hx'
      rw [← he]
      exact isClosed_closure
    have hclo : IsClopen (closure ({ξ} : Set C)) := ⟨isClosed_closure, isClosed_compl_iff.mp hcl⟩
    rcases isClopen_iff.mp hclo with h | h
    · have hx := hξE
      rw [h] at hx
      exact hx
    · exact hne h
  have hext := fun c hc => wcpa_dj_csp_ext_nonsmooth K C q hss ξ hξ c hc
  have hextξ : ∀ c ∈ closure ({ξ} : Set C) ∩ closure (closure ({ξ} : Set C))ᶜ, c ≠ ξ := by
    intro c hc hcξ
    obtain ⟨U, hU, hUs⟩ := hgen.2
    exact hext c hc ⟨U, by rw [hcξ]; exact hU, hUs⟩

  have hcount : ∀ (S : Set C) (f : Fin n → C) (P : Fin n → Prop), Function.Injective f →
      (∀ i, P i → f i ∉ S) → 3 ≤ S.ncard + Nat.card {i : Fin n // P i} →
      ∃ x y z : C, x ∈ S ∪ f '' {i | P i} ∧ y ∈ S ∪ f '' {i | P i} ∧
        z ∈ S ∪ f '' {i | P i} ∧ x ≠ y ∧ x ≠ z ∧ y ≠ z := by
    intro S f P hf hPS h3
    by_cases hS : S.Finite
    · have hfin2 : (f '' {i | P i}).Finite := Set.toFinite _
      have hdisj : Disjoint S (f '' {i | P i}) := by
        rw [Set.disjoint_left]
        rintro x hxS ⟨i, hi, rfl⟩
        exact hPS i hi hxS
      have hc : (S ∪ f '' {i | P i}).ncard = S.ncard + Nat.card {i : Fin n // P i} := by
        rw [Set.ncard_union_eq hdisj hS hfin2, Set.ncard_image_of_injective _ hf,
          ← Nat.card_coe_set_eq {i | P i}]
        rfl
      have h2 : 2 < (S ∪ f '' {i | P i}).ncard := by omega
      exact (Set.two_lt_ncard_iff (hS.union hfin2)).mp h2
    · obtain ⟨t, hts, htf, htc⟩ := Set.Infinite.exists_subset_ncard_eq hS 3
      obtain ⟨x, y, z, hx, hy, hz, hxy, hxz, hyz⟩ :=
        (Set.two_lt_ncard_iff htf).mp (by omega)
      exact ⟨x, y, z, Or.inl (hts hx), Or.inl (hts hy), Or.inl (hts hz), hxy, hxz, hyz⟩
  refine ⟨?_, ?_⟩
  ·
    by_cases hEu : closure ({ξ} : Set C) = Set.univ
    · obtain ⟨V, hNt, hsp, -⟩ := hprod (σ ⟨0, by omega⟩ p₀) (by rw [hEu]; trivial) (hmξ _)
        (Or.inr ⟨_, p₀, rfl⟩)
      exact ⟨V, hNt, hsp⟩
    · obtain ⟨c, hc⟩ := htop hEu
      obtain ⟨V, hNt, hsp, -⟩ := hprod c hc.1 (hextξ c hc) (Or.inl (hext c hc))
      exact ⟨V, hNt, hsp⟩
  ·
    intro ht
    by_cases hEu : closure ({ξ} : Set C) = Set.univ
    ·
      let i0 : Fin n := ⟨0, by omega⟩
      let i1 : Fin n := ⟨1, by omega⟩
      let i2 : Fin n := ⟨2, by omega⟩
      have h01 : i0 ≠ i1 := by
        intro h
        have := congrArg Fin.val h
        simp [i0, i1] at this
      have h02 : i0 ≠ i2 := by
        intro h
        have := congrArg Fin.val h
        simp [i0, i2] at this
      have h12 : i1 ≠ i2 := by
        intro h
        have := congrArg Fin.val h
        simp [i1, i2] at this
      obtain ⟨V₁, hN1, hs1, hc1⟩ := hprod (σ i0 p₀) (by rw [hEu]; trivial) (hmξ _)
        (Or.inr ⟨_, p₀, rfl⟩)
      obtain ⟨V₂, hN2, hs2, hc2⟩ := hprod (σ i1 p₀) (by rw [hEu]; trivial) (hmξ _)
        (Or.inr ⟨_, p₀, rfl⟩)
      obtain ⟨V₃, hN3, hs3, hc3⟩ := hprod (σ i2 p₀) (by rw [hEu]; trivial) (hmξ _)
        (Or.inr ⟨_, p₀, rfl⟩)
      exact ⟨V₁, V₂, V₃,
        hdist _ _ _ _ hN1 hc1 hc2 (hst.2.1.2.1 i0 i1 p₀ p₀ h01),
        hdist _ _ _ _ hN1 hc1 hc3 (hst.2.1.2.1 i0 i2 p₀ p₀ h02),
        hdist _ _ _ _ hN2 hc2 hc3 (hst.2.1.2.1 i1 i2 p₀ p₀ h12),
        ⟨hN1, hs1⟩, ⟨hN2, hs2⟩, ⟨hN3, hs3⟩⟩
    · by_cases hB : ∃ c ∈ closure ({ξ} : Set C), IsClosed ({c} : Set C) ∧
          (¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∧
          c ∉ closure (closure ({ξ} : Set C))ᶜ
      ·
        obtain ⟨c, hcE, hccl, hcns, hcn⟩ := hB
        have h : ξ ⤳ c := specializes_iff_mem_closure.mpr hcE
        have hcξ : c ≠ ξ := fun e => hξnc (by rw [← e]; exact hccl)
        obtain ⟨V₀, V₁, h01, hV0a, hV0b, hV1a, hV1b⟩ :=
          wcpa_dj_csp_selfnode_branches K C q hss ξ hξ c h hccl hcns hcn
        obtain ⟨hN0, b0, hctr0⟩ :=
          wcpa_dj_csp_dominate_ctr K C q L hOK ξ c h (Ne.symm hcξ) hA V₀ hV0a hV0b
        obtain ⟨hN1, b1, hctr1⟩ :=
          wcpa_dj_csp_dominate_ctr K C q L hOK ξ c h (Ne.symm hcξ) hA V₁ hV1a hV1b
        obtain ⟨c', hc'⟩ := htop hEu
        obtain ⟨V₂, hN2, hs2, hc2⟩ := hprod c' hc'.1 (hextξ c' hc') (Or.inl (hext c' hc'))
        have hcc' : c ≠ c' := fun e => hcn (by rw [e]; exact hc'.2)
        exact ⟨V₀, V₁, V₂, h01,
          hdist _ _ _ _ hN0 ⟨b0, hctr0⟩ hc2 hcc',
          hdist _ _ _ _ hN1 ⟨b1, hctr1⟩ hc2 hcc',
          ⟨hN0, c, b0, hctr0, Or.inl hcns⟩, ⟨hN1, c, b1, hctr1, Or.inl hcns⟩, ⟨hN2, hs2⟩⟩
      ·
        have hC : ∀ c ∈ closure ({ξ} : Set C), IsClosed ({c} : Set C) →
            (¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) →
            c ∈ closure (closure ({ξ} : Set C))ᶜ :=
          fun c hc hcl hns => by_contra (fun h => hB ⟨c, hc, hcl, hns, h⟩)
        obtain ⟨Er, ι, θ, h1, h2, h3, h4⟩ :=
          wcpa_dj_csp_P1_recognition K C q hss ξ hξ hA hC ht
        have h3n := wcpa_dj_csp_stability_at_id K C q n σ hst (closure {ξ}) hξ
          ⟨Er, ι, θ, h1, h2, h3, h4⟩
        obtain ⟨x, y, z, hx, hy, hz, hxy, hxz, hyz⟩ :=
          hcount (closure ({ξ} : Set C) ∩ closure (closure ({ξ} : Set C))ᶜ)
            (fun i => σ i p₀) (fun i => ∃ p, σ i p ∈ closure ({ξ} : Set C)) hminj
            (fun i _ hiS => hext _ hiS (hmsm i)) h3n
        have hT : ∀ w ∈ (closure ({ξ} : Set C) ∩ closure (closure ({ξ} : Set C))ᶜ) ∪
            (fun i => σ i p₀) '' {i | ∃ p, σ i p ∈ closure ({ξ} : Set C)},
            ∃ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V ∧
              wcpaDjSpecialV q σ L ξ V ∧ ∃ b, wcpaDjCtr L ξ V b w := by
          rintro w (hw | ⟨i, ⟨p, hp⟩, rfl⟩)
          · exact hprod w hw.1 (hextξ w hw) (Or.inl (hext w hw))
          · exact hprod _ (by show σ i p₀ ∈ _; rw [← hσp i p]; exact hp) (hmξ i) (Or.inr ⟨i, p₀, rfl⟩)
        obtain ⟨V₁, hN1, hs1, hc1⟩ := hT x hx
        obtain ⟨V₂, hN2, hs2, hc2⟩ := hT y hy
        obtain ⟨V₃, hN3, hs3, hc3⟩ := hT z hz
        exact ⟨V₁, V₂, V₃,
          hdist _ _ _ _ hN1 hc1 hc2 hxy,
          hdist _ _ _ _ hN1 hc1 hc3 hxz,
          hdist _ _ _ _ hN2 hc2 hc3 hyz,
          ⟨hN1, hs1⟩, ⟨hN2, hs2⟩, ⟨hN3, hs3⟩⟩

theorem wcpa_dj_lqcf_nmd_generic_witness : ∀ (C : Scheme.{u}), AlgebraicGeometry.IsReduced C → ∀ (U : C.Opens), IsAffineOpen U → ∀ g : Γ(C, U), g ≠ 0 → ∃ (ξ : C) (hξ : ξ ∈ U), closure {ξ} ∈ irreducibleComponents C ∧ (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom g ≠ 0 :=
by
  intro C hred U _hU g hg
  haveI := hred
  have hne : C.basicOpen g ≠ ⊥ := fun h => hg ((AlgebraicGeometry.basicOpen_eq_bot_iff g).mp h)
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
  have hirr : IsIrreducible (irreducibleComponent x) := isIrreducible_irreducibleComponent
  have hgen := hirr.isGenericPoint_genericPoint isClosed_irreducibleComponent
  have hspec := hgen.specializes mem_irreducibleComponent
  have hξD : hirr.genericPoint ∈ C.basicOpen g := hspec.mem_open (C.basicOpen g).isOpen hx
  refine ⟨hirr.genericPoint, C.basicOpen_le g hξD, ?_, ?_⟩
  · rw [isGenericPoint_def.mp hgen]; exact irreducibleComponent_mem_irreducibleComponents x
  · rw [C.germ_residue]; exact (C.evaluation_ne_zero_iff_mem_basicOpen _ _ g).mpr hξD

theorem wcpa_dj_lqcf_nmd_generic_derivation (k : Type u) [Field k] (C : Scheme.{u})
    (c : C ⟶ Spec (.of k)) (hred : AlgebraicGeometry.IsReduced C)
    (θ : ∀ U : C.Opens, Γ(C, U) → Γ(C, U))
    (hR : ∀ (U V : C.Opens) (h : V ≤ U), IsAffineOpen U → IsAffineOpen V → ∀ f : Γ(C, U), θ V ((C.presheaf.map (homOfLE h).op).hom f) = (C.presheaf.map (homOfLE h).op).hom (θ U f))
    (hA : ∀ U : C.Opens, IsAffineOpen U → ∀ f g : Γ(C, U), θ U (f + g) = θ U f + θ U g)
    (hL : ∀ U : C.Opens, IsAffineOpen U → ∀ f g : Γ(C, U), θ U (f * g) = f * θ U g + g * θ U f)
    (hK : ∀ U : C.Opens, IsAffineOpen U → ∀ a : k, θ U ((c.appTop ≫ C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom ((Scheme.ΓSpecIso (.of k)).inv.hom a)) = 0)
    (ξ : C) (hξ : closure {ξ} ∈ irreducibleComponents C)
    [Algebra k (C.residueField ξ)] (hAlg : algebraMap k (C.residueField ξ) = wcpaDjFK k c ξ) :
    ∃ D : Derivation k (C.residueField ξ) (C.residueField ξ), ∀ (U : C.Opens) (hU : IsAffineOpen U) (hξU : ξ ∈ U) (a : Γ(C, U)), D ((C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom a) = (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom (θ U a) :=
by
  classical
  haveI := hred

  have AS : ∀ {V : C.Opens}, ξ ∈ V → ∃ W : C.Opens, IsAffineOpen W ∧ ξ ∈ W ∧ W ≤ V := by
    intro V hV
    obtain ⟨W, hW, hξW, hWV⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens hV
    exact ⟨W, hW, hξW, hWV⟩

  have GR : ∀ (U W : C.Opens) (h : W ≤ U) (hξW : ξ ∈ W) (a : Γ(C, U)),
      (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom ((C.presheaf.map (homOfLE h).op).hom a) =
      (C.presheaf.germ U ξ (h hξW) ≫ C.residue ξ).hom a := by
    intro U W h hξW a
    rw [← CommRingCat.comp_apply, ← Category.assoc, TopCat.Presheaf.germ_res]

  have ann : ∀ (U : C.Opens) (hU : IsAffineOpen U) (x : U), (x : C) = ξ → ∀ (g : Γ(C, U)),
      (C.presheaf.germ U x x.2 ≫ C.residue x).hom g = 0 →
      ∃ m : Γ(C, U), (C.presheaf.germ U x x.2 ≫ C.residue x).hom m ≠ 0 ∧ m * g = 0 := by
    intro U hU x hx g hg
    have hξx : Maximal IsIrreducible (closure {(x : C)}) := hx ▸ hξ
    haveI hloc : IsLocalization.AtPrime (C.presheaf.stalk (x : C)) (hU.primeIdealOf x).asIdeal :=
      hU.isLocalization_stalk x
    have hmin : (hU.primeIdealOf x).asIdeal ∈ minimalPrimes Γ(C, U) := by
      rw [← PrimeSpectrum.isMin_iff]
      intro Q hQ
      have hsp : Q ⤳ hU.primeIdealOf x := (PrimeSpectrum.le_iff_specializes Q _).mp hQ
      have hsp' : hU.fromSpec Q ⤳ (x : C) := by
        have h1 := hsp.map hU.fromSpec.continuous
        rwa [hU.fromSpec_primeIdealOf] at h1
      have hsub : closure {(x : C)} ⊆ closure {hU.fromSpec Q} := hsp'.closure_subset
      have hirr : IsIrreducible (closure {hU.fromSpec Q}) := isIrreducible_singleton.closure
      have heq : closure {hU.fromSpec Q} = closure {(x : C)} := Maximal.eq_of_ge hξx hirr hsub
      have hsp2 : (x : C) ⤳ hU.fromSpec Q := specializes_iff_closure_subset.mpr heq.le
      have hη : hU.fromSpec Q = (x : C) := (hsp'.antisymm hsp2).eq
      have hinj : Function.Injective hU.fromSpec := by
        haveI := hU.isOpenImmersion_fromSpec
        exact hU.fromSpec.isOpenEmbedding.isEmbedding.injective
      have hQP : Q = hU.primeIdealOf x := hinj (hη.trans (hU.fromSpec_primeIdealOf x).symm)
      exact le_of_eq hQP.symm
    haveI : Ring.KrullDimLE 0 (C.presheaf.stalk (x : C)) :=
      Ring.KrullDimLE.of_isLocalization _ hmin _
    have hF : IsField (C.presheaf.stalk (x : C)) := Ring.KrullDimLE.isField_of_isReduced
    have hmax : IsLocalRing.maximalIdeal (C.presheaf.stalk (x : C)) = ⊥ :=
      IsLocalRing.isField_iff_maximalIdeal_eq.mp hF
    have hg' : algebraMap Γ(C, U) (C.presheaf.stalk (x : C)) g = 0 := by
      have h1 : IsLocalRing.residue (C.presheaf.stalk (x : C))
          ((C.presheaf.germ U x x.2).hom g) = 0 := hg
      rw [IsLocalRing.residue_eq_zero_iff, hmax] at h1
      exact h1
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (hU.primeIdealOf x).asIdeal.primeCompl
      (C.presheaf.stalk (x : C)) g).mp hg'
    refine ⟨m, ?_, hm⟩
    intro h0
    have h1 : IsLocalRing.residue (C.presheaf.stalk (x : C))
        ((C.presheaf.germ U x x.2).hom m) = 0 := h0
    rw [IsLocalRing.residue_eq_zero_iff] at h1
    have h2 : algebraMap Γ(C, U) (C.presheaf.stalk (x : C)) m ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk (x : C)) := h1
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff _ (hU.primeIdealOf x).asIdeal] at h2
    exact m.2 h2

  have indep : ∀ (U V : C.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hξU : ξ ∈ U)
      (hξV : ξ ∈ V) (a : Γ(C, U)) (b : Γ(C, V)),
      (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom a = (C.presheaf.germ V ξ hξV ≫ C.residue ξ).hom b →
      (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom (θ U a) =
        (C.presheaf.germ V ξ hξV ≫ C.residue ξ).hom (θ V b) := by
    intro U V hU hV hξU hξV a b hab
    obtain ⟨W, hW, hξW, hWUV⟩ := AS (show ξ ∈ U ⊓ V from ⟨hξU, hξV⟩)
    have hWU : W ≤ U := hWUV.trans inf_le_left
    have hWV : W ≤ V := hWUV.trans inf_le_right
    have θ0 : θ W 0 = 0 := by
      have h1 := hA W hW 0 0
      rw [add_zero] at h1
      linear_combination -h1
    have θsub : ∀ x y : Γ(C, W), θ W (x - y) = θ W x - θ W y := by
      intro x y
      have h1 := hA W hW (x - y) y
      rw [sub_add_cancel] at h1
      linear_combination -h1
    obtain ⟨a', ha'⟩ : ∃ a', a' = (C.presheaf.map (homOfLE hWU).op).hom a := ⟨_, rfl⟩
    obtain ⟨b', hb'⟩ : ∃ b', b' = (C.presheaf.map (homOfLE hWV).op).hom b := ⟨_, rfl⟩
    have hρa' : (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom a' =
        (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom a := by rw [ha']; exact GR U W hWU hξW a
    have hρb' : (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom b' =
        (C.presheaf.germ V ξ hξV ≫ C.residue ξ).hom b := by rw [hb']; exact GR V W hWV hξW b
    have hg : (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom (a' - b') = 0 := by
      rw [map_sub, hρa', hρb', hab, sub_self]
    obtain ⟨m, hm0, hmg⟩ := ann W hW ⟨ξ, hξW⟩ rfl (a' - b') hg
    have h1 : θ W (m * (a' - b')) = 0 := by rw [hmg, θ0]
    rw [hL W hW] at h1
    have h2 := congrArg (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom h1
    rw [map_add, map_mul, map_mul, hg, map_zero, zero_mul, add_zero] at h2
    have h3 : (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom (θ W (a' - b')) = 0 :=
      (mul_eq_zero.mp h2).resolve_left hm0
    rw [θsub, map_sub, sub_eq_zero] at h3
    have e1 : (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom (θ W a') =
        (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom (θ U a) := by
      rw [ha', hR U W hWU hU hW a]; exact GR U W hWU hξW (θ U a)
    have e2 : (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom (θ W b') =
        (C.presheaf.germ V ξ hξV ≫ C.residue ξ).hom (θ V b) := by
      rw [hb', hR V W hWV hV hW b]; exact GR V W hWV hξW (θ V b)
    rw [← e1, ← e2]
    exact h3

  have repr : ∀ y : C.residueField ξ, ∃ (W : C.Opens) (_ : IsAffineOpen W) (hξW : ξ ∈ W)
      (a : Γ(C, W)), (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom a = y := by
    intro y
    obtain ⟨z, hz⟩ := C.residue_surjective ξ y
    obtain ⟨V, hξV, t, ht⟩ := C.presheaf.exists_germ_eq z
    obtain ⟨W, hW, hξW, hWV⟩ := AS hξV
    refine ⟨W, hW, hξW, (C.presheaf.map (homOfLE hWV).op).hom t, ?_⟩
    rw [GR V W hWV hξW t, CommRingCat.comp_apply, ht, hz]

  choose Wf hWf hξWf af haf using repr
  let f : C.residueField ξ → C.residueField ξ := fun y =>
    (C.presheaf.germ (Wf y) ξ (hξWf y) ≫ C.residue ξ).hom (θ (Wf y) (af y))
  have Fm : ∀ (U : C.Opens) (hU : IsAffineOpen U) (hξU : ξ ∈ U) (a : Γ(C, U)),
      f ((C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom a) =
        (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom (θ U a) := by
    intro U hU hξU a
    exact indep _ _ (hWf _) hU (hξWf _) hξU _ a (haf _)
  have CC : ∀ y₁ y₂ : C.residueField ξ, ∃ (W : C.Opens) (_ : IsAffineOpen W) (hξW : ξ ∈ W)
      (b₁ b₂ : Γ(C, W)), (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom b₁ = y₁ ∧
        (C.presheaf.germ W ξ hξW ≫ C.residue ξ).hom b₂ = y₂ := by
    intro y₁ y₂
    obtain ⟨W, hW, hξW, hWle⟩ := AS (show ξ ∈ Wf y₁ ⊓ Wf y₂ from ⟨hξWf y₁, hξWf y₂⟩)
    refine ⟨W, hW, hξW, (C.presheaf.map (homOfLE (hWle.trans inf_le_left)).op).hom (af y₁),
      (C.presheaf.map (homOfLE (hWle.trans inf_le_right)).op).hom (af y₂), ?_, ?_⟩
    · rw [GR _ W _ hξW]; exact haf y₁
    · rw [GR _ W _ hξW]; exact haf y₂
  have fadd : ∀ y₁ y₂, f (y₁ + y₂) = f y₁ + f y₂ := by
    intro y₁ y₂
    obtain ⟨W, hW, hξW, b₁, b₂, rfl, rfl⟩ := CC y₁ y₂
    rw [← map_add, Fm W hW hξW, Fm W hW hξW, Fm W hW hξW, hA W hW, map_add]
  have fmul : ∀ y₁ y₂, f (y₁ * y₂) = y₁ * f y₂ + y₂ * f y₁ := by
    intro y₁ y₂
    obtain ⟨W, hW, hξW, b₁, b₂, rfl, rfl⟩ := CC y₁ y₂
    rw [← map_mul, Fm W hW hξW, Fm W hW hξW, Fm W hW hξW, hL W hW, map_add, map_mul, map_mul]
  have fconst : ∀ c₀ : k, f (algebraMap k (C.residueField ξ) c₀) = 0 := by
    intro c₀
    obtain ⟨U₀, hU₀, hξU₀, -⟩ := AS (show ξ ∈ (⊤ : C.Opens) from trivial)
    have hgr : C.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op ≫ C.presheaf.germ U₀ ξ hξU₀ =
        C.presheaf.germ ⊤ ξ trivial := TopCat.Presheaf.germ_res _ _ _ _
    have e : algebraMap k (C.residueField ξ) c₀ = (C.presheaf.germ U₀ ξ hξU₀ ≫ C.residue ξ).hom
        ((c.appTop ≫ C.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op).hom
          ((Scheme.ΓSpecIso (.of k)).inv.hom c₀)) := by
      rw [hAlg]
      show ((Scheme.ΓSpecIso (.of k)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ ξ trivial ≫
        C.residue ξ).hom c₀ = _
      rw [← hgr]
      rfl
    rw [e, Fm U₀ hU₀ hξU₀, hK U₀ hU₀ c₀, map_zero]
  have fsmul : ∀ (c₀ : k) (y : C.residueField ξ), f (c₀ • y) = c₀ • f y := by
    intro c₀ y
    rw [Algebra.smul_def, Algebra.smul_def, fmul, fconst, mul_zero, add_zero]
  let fl : C.residueField ξ →ₗ[k] C.residueField ξ :=
    { toFun := f
      map_add' := fadd
      map_smul' := fun c₀ y => fsmul c₀ y }
  refine ⟨Derivation.mk' fl (fun a b => by
    show f (a * b) = a * f b + b * f a
    exact fmul a b), ?_⟩
  intro U hU hξU a
  exact Fm U hU hξU a

theorem wcpa_dj_cdp_ff_derivation (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (hF : wcpaDjFF1 K F) :
    ∃ D : Derivation K F F, ∀ (V : ValuationSubring F) (x : F),
      wcpaDjNtV' K V → wcpaDjValOrd V x = 1 → D x ≠ 0 :=
by
  classical
  obtain ⟨t, ht, hfin⟩ := hF
  haveI := hfin

  have hnc : ∀ f : F, f ∉ Set.range (algebraMap K F) → Transcendental K f := by
    intro f hf halg
    apply hf
    have hi : IsIntegral K f := halg.isIntegral
    exact minpoly.mem_range_of_degree_eq_one K f
      (IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible hi))

  have hEFT : Algebra.EssFiniteType K F := by
    apply IntermediateField.fg_top_iff.mp
    let B := Module.finBasis (IntermediateField.adjoin K {t}) F
    refine ⟨insert t (Finset.univ.image fun i => (B i : F)), ?_⟩
    rw [eq_top_iff]
    intro y _
    have hK : ∀ c : (IntermediateField.adjoin K {t}), (c : F) ∈ IntermediateField.adjoin K
        (↑(insert t (Finset.univ.image fun i => (B i : F))) : Set F) := by
      intro c
      have hle : (IntermediateField.adjoin K {t}) ≤ IntermediateField.adjoin K
          (↑(insert t (Finset.univ.image fun i => (B i : F))) : Set F) :=
        IntermediateField.adjoin_simple_le_iff.mpr
          (IntermediateField.subset_adjoin _ _ (by simp))
      exact hle c.2
    rw [← B.sum_repr y]
    refine sum_mem fun i _ => ?_
    rw [Algebra.smul_def]
    exact mul_mem (hK _) (IntermediateField.subset_adjoin _ _ (by simp))
  haveI := hEFT

  have hD : ∃ (D : Derivation K F F) (a : F), D a ≠ 0 := by
    have hnt : Nontrivial (Ω[F⁄K]) := by
      by_contra hsub
      rw [not_nontrivial_iff_subsingleton] at hsub
      have hFU : Algebra.FormallyUnramified K F := ⟨hsub⟩
      have hsep : Algebra.IsSeparable K F :=
        (Algebra.FormallyUnramified.iff_isSeparable K F).mp hFU
      exact ht (Algebra.IsSeparable.isSeparable K t).isIntegral.isAlgebraic
    obtain ⟨ω, hω⟩ := exists_ne (0 : Ω[F⁄K])
    have hex : ¬ ∀ φ : Module.Dual F (Ω[F⁄K]), φ ω = 0 :=
      fun h => hω ((Module.forall_dual_apply_eq_zero_iff F ω).mp h)
    push_neg at hex
    obtain ⟨φ, hφ⟩ := hex
    refine ⟨KaehlerDifferential.linearMapEquivDerivation K F φ, ?_⟩
    by_contra hall
    push_neg at hall
    apply hφ
    have hle : Submodule.span F (Set.range (KaehlerDifferential.D K F)) ≤ LinearMap.ker φ := by
      rw [Submodule.span_le]
      rintro _ ⟨a, rfl⟩
      have := hall a
      rw [KaehlerDifferential.linearMapEquivDerivation_apply_apply] at this
      exact this
    rw [KaehlerDifferential.span_range_derivation] at hle
    exact hle Submodule.mem_top

  have htrdeg : Algebra.trdeg K F = 1 := by
    have hai : AlgebraicIndependent K (fun _ : PUnit.{u+1} => t) :=
      algebraicIndependent_unique_type_iff.mpr ht
    have hb : IsTranscendenceBasis K (fun _ : PUnit.{u+1} => t) := by
      rw [hai.isTranscendenceBasis_iff_isAlgebraic, Set.range_const,
        ← IntermediateField.isAlgebraic_adjoin_iff_top]
      infer_instance
    rw [← hb.cardinalMk_eq_trdeg]
    simp
  have hfinf : ∀ f : F, Transcendental K f → FiniteDimensional (IntermediateField.adjoin K {f}) F := by
    intro f hf
    have hai : AlgebraicIndependent K (fun _ : PUnit.{u+1} => f) :=
      algebraicIndependent_unique_type_iff.mpr hf
    have hb : IsTranscendenceBasis K (fun _ : PUnit.{u+1} => f) :=
      hai.isTranscendenceBasis_of_trdeg_le_of_finite (by rw [htrdeg]; simp)
    have halg : Algebra.IsAlgebraic (IntermediateField.adjoin K {f}) F := by
      have := hb.isAlgebraic_field
      rwa [Set.range_const] at this
    obtain ⟨S, hS⟩ := IntermediateField.fg_top_iff.mpr hEFT
    have hS' : IntermediateField.adjoin (IntermediateField.adjoin K {f}) (S : Set F) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have hy : y ∈ IntermediateField.adjoin K (S : Set F) := by rw [hS]; trivial
      have hle : IntermediateField.adjoin K (S : Set F) ≤
          (IntermediateField.adjoin (IntermediateField.adjoin K {f}) (S : Set F)).restrictScalars K := by
        rw [IntermediateField.adjoin_le_iff]
        intro s hs
        exact IntermediateField.subset_adjoin _ _ hs
      exact hle hy
    have hfd : FiniteDimensional (IntermediateField.adjoin K {f}) (IntermediateField.adjoin (IntermediateField.adjoin K {f}) (S : Set F)) :=
      IntermediateField.finiteDimensional_adjoin
        (fun x _ => (Algebra.IsAlgebraic.isAlgebraic (R := (IntermediateField.adjoin K {f})) x).isIntegral)
    rw [hS'] at hfd
    exact (IntermediateField.topEquiv : (⊤ : IntermediateField (IntermediateField.adjoin K {f}) F) ≃ₐ[(IntermediateField.adjoin K {f})] F).toLinearEquiv.finiteDimensional

  have hval : ∀ (V : ValuationSubring F) (x : F), wcpaDjValOrd V x = 1 →
      x ≠ 0 ∧ x⁻¹ ∉ V ∧ ∀ (z : F) (n : ℕ), 2 ≤ n → z ^ n ≠ x := by
    intro V x hx
    unfold wcpaDjValOrd at hx
    set S₁ := {n : ℕ | ∃ h : x ∈ V, (⟨x, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n} with hS₁
    set S₂ := {n : ℕ | ∃ h : x⁻¹ ∈ V, (⟨x⁻¹, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n} with hS₂
    have ha : 1 ≤ sSup S₁ := by omega
    have hbdd : BddAbove S₁ := by
      by_contra hb
      rw [Nat.sSup_of_not_bddAbove hb] at ha
      omega
    have hne : S₁.Nonempty := by
      by_contra hn
      rw [Set.not_nonempty_iff_eq_empty] at hn
      have hse : sSup (∅ : Set ℕ) = 0 := by simp
      rw [hn, hse] at ha
      omega
    obtain ⟨hxV, hxm⟩ := Nat.sSup_mem hne hbdd
    have hxm1 : (⟨x, hxV⟩ : V) ∈ IsLocalRing.maximalIdeal V :=
      Ideal.pow_le_self (by omega) hxm
    have hx0 : x ≠ 0 := by
      intro h0
      obtain ⟨M, hM⟩ := hbdd
      have hmem : M + 1 ∈ S₁ := ⟨hxV, by
        have h00 : (⟨x, hxV⟩ : V) = 0 := Subtype.ext h0
        rw [h00]; exact Ideal.zero_mem _⟩
      have := hM hmem
      omega
    have hxinv : x⁻¹ ∉ V := by
      intro hinv
      exact (IsLocalRing.mem_maximalIdeal _).mp hxm1
        (isUnit_iff_exists_inv.mpr ⟨(⟨x⁻¹, hinv⟩ : V), Subtype.ext (mul_inv_cancel₀ hx0)⟩)
    have hS2 : S₂ = ∅ := by
      ext n
      simp only [hS₂, Set.mem_empty_iff_false, iff_false]
      rintro ⟨h, _⟩
      exact hxinv h
    have hse : sSup (∅ : Set ℕ) = 0 := by simp
    rw [hS2, hse] at hx
    have ha1 : sSup S₁ = 1 := by push_cast at hx; omega
    have hnot2 : (⟨x, hxV⟩ : V) ∉ IsLocalRing.maximalIdeal V ^ 2 := by
      intro h2
      have : 2 ≤ sSup S₁ := le_csSup hbdd ⟨hxV, h2⟩
      omega
    refine ⟨hx0, hxinv, ?_⟩
    intro z n hn hzx
    have hzV : z ∈ V := by
      by_contra hz
      have hzi : z⁻¹ ∈ V := (V.mem_or_inv_mem z).resolve_left hz
      apply hxinv
      rw [← hzx, ← inv_pow]
      exact V.pow_mem hzi n
    have hxeq : (⟨x, hxV⟩ : V) = (⟨z, hzV⟩ : V) ^ n := by
      apply Subtype.ext
      simp only [SubmonoidClass.coe_pow]
      exact hzx.symm
    have hzm : (⟨z, hzV⟩ : V) ∈ IsLocalRing.maximalIdeal V := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hxm1 (hxeq ▸ hu.pow n)
    apply hnot2
    rw [hxeq]
    obtain ⟨k, rfl⟩ : ∃ k, n = 2 + k := ⟨n - 2, by omega⟩
    rw [pow_add]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hzm 2)

  obtain ⟨D, a, ha⟩ := hD
  refine ⟨D, fun V x hV hx hDx => ?_⟩
  obtain ⟨hx0, hxinv, hroot⟩ := hval V x hx
  apply ha
  have hxnc : x ∉ Set.range (algebraMap K F) := by
    rintro ⟨c, rfl⟩
    apply hxinv
    rw [← map_inv₀]
    exact hV.1 _
  have hxt := hnc x hxnc
  haveI hfx : FiniteDimensional (IntermediateField.adjoin K {x}) F := hfinf x hxt
  have hker : ∀ e ∈ (IntermediateField.adjoin K {x}), D e = 0 := by
    intro e he
    rw [IntermediateField.mem_adjoin_simple_iff] at he
    obtain ⟨r, s, rfl⟩ := he
    rw [Derivation.leibniz_div, Derivation.map_aeval, Derivation.map_aeval, hDx]
    simp
  rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hp
  ·
    haveI : Fact (ringChar F).Prime := ⟨hp⟩
    have hRR : wcRRFinRank K F := by
      intro f hf
      have hft := hnc f hf
      haveI := hfinf f hft
      let b := Module.finBasis (IntermediateField.adjoin K {f}) F
      have hmem : ∀ p : Polynomial K, Polynomial.aeval f p ∈ (IntermediateField.adjoin K {f}) := fun p =>
        IntermediateField.algebra_adjoin_le_adjoin K _ (Polynomial.aeval_mem_adjoin_singleton K f)
      refine ⟨Module.finrank (IntermediateField.adjoin K {f}) F, ⟨fun i => b i, ?_⟩, ?_⟩
      · intro p hp0
        have hli := b.linearIndependent
        rw [Fintype.linearIndependent_iff] at hli
        have h1 := hli (fun j => ⟨Polynomial.aeval f (p j), hmem _⟩) hp0
        funext j
        have hj := congrArg Subtype.val (h1 j)
        exact (transcendental_iff_injective.mp hft) (by rw [Pi.zero_apply, map_zero]; exact hj)
      · intro v
        have hnli : ¬ LinearIndependent (IntermediateField.adjoin K {f}) v := by
          intro hli
          have := hli.fintype_card_le_finrank
          simp only [Fintype.card_fin] at this
          omega
        rw [Fintype.not_linearIndependent_iff] at hnli
        obtain ⟨g, hg, j₀, hj₀⟩ := hnli
        have hclr : ∀ c : (IntermediateField.adjoin K {f}), ∃ r s : Polynomial K, Polynomial.aeval f s ≠ 0 ∧
            (c : F) * Polynomial.aeval f s = Polynomial.aeval f r := by
          intro c
          have hc2 := c.2
          rw [IntermediateField.mem_adjoin_simple_iff] at hc2
          obtain ⟨r, s, hc⟩ := hc2
          by_cases hs0 : Polynomial.aeval f s = 0
          · refine ⟨0, 1, by simp, ?_⟩
            rw [hc, hs0, div_zero]
            simp
          · exact ⟨r, s, hs0, by rw [hc, div_mul_cancel₀ _ hs0]⟩
        choose r s hs hrs using hclr
        have hP0 : (∏ k, Polynomial.aeval f (s (g k))) ≠ 0 :=
          Finset.prod_ne_zero_iff.mpr (fun k _ => hs (g k))
        have hpj : ∀ j, Polynomial.aeval f (r (g j) * ∏ k ∈ Finset.univ.erase j, s (g k)) =
            (g j : F) * ∏ k, Polynomial.aeval f (s (g k)) := by
          intro j
          rw [map_mul, map_prod, ← hrs,
            ← Finset.mul_prod_erase Finset.univ (fun k => Polynomial.aeval f (s (g k)))
              (Finset.mem_univ j)]
          ring
        refine ⟨fun j => r (g j) * ∏ k ∈ Finset.univ.erase j, s (g k), ?_, ?_⟩
        · intro h0
          have h1 := congrArg (fun q => Polynomial.aeval f (q j₀)) h0
          simp only [Pi.zero_apply, map_zero, hpj] at h1
          have hg0 : (g j₀ : F) ≠ 0 := fun h => hj₀ (Subtype.ext h)
          exact mul_ne_zero hg0 hP0 h1
        · simp only [hpj]
          have hg' : ∑ j, (g j : F) * v j = 0 := hg
          calc ∑ j, (g j : F) * (∏ k, Polynomial.aeval f (s (g k))) * v j
              = (∏ k, Polynomial.aeval f (s (g k))) * ∑ j, (g j : F) * v j := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                ring
            _ = 0 := by rw [hg', mul_zero]
    have ht' : t ∉ Set.range (algebraMap K F) := by
      rintro ⟨c, rfl⟩
      exact ht (isAlgebraic_algebraMap c)
    have hpb := (wc_char_pbasis K F (ringChar F) hRR t ht').2 x
      (fun z hz => hroot z _ hp.two_le hz)
    obtain ⟨h, hy, _⟩ := hpb a
    rw [hy, map_sum]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [Derivation.leibniz, Derivation.leibniz_pow, Derivation.leibniz_pow, hDx]
    simp [nsmul_eq_mul]
  ·
    haveI : CharZero F := by
      have hc := ringChar.charP F
      rw [hp] at hc
      exact (CharP.charP_zero_iff_charZero F).mp hc
    haveI : CharZero (IntermediateField.adjoin K {x}) := RingHom.charZero (algebraMap (IntermediateField.adjoin K {x}) F)
    have hy : IsSeparable (IntermediateField.adjoin K {x}) a :=
      (minpoly.irreducible (IsIntegral.of_finite (IntermediateField.adjoin K {x}) a)).separable
    let L : F →ₗ[(IntermediateField.adjoin K {x})] F :=
      { toFun := fun z => D z
        map_add' := fun z w => D.map_add z w
        map_smul' := fun c z => by
          have hcz : c • z = (c : F) * z := rfl
          simp only [RingHom.id_apply]
          rw [hcz, D.leibniz, hker c c.2, smul_zero, add_zero]
          rfl }
    let DE : Derivation (IntermediateField.adjoin K {x}) F F := Derivation.mk' L (fun z w => D.leibniz z w)
    have h1 := DE.map_aeval (minpoly (IntermediateField.adjoin K {x}) a) a
    rw [minpoly.aeval, map_zero] at h1
    have h2 := hy.aeval_derivative_ne_zero (minpoly.aeval (IntermediateField.adjoin K {x}) a)
    have hDE : DE a = D a := rfl
    rw [hDE, smul_eq_mul] at h1
    exact (mul_eq_zero.mp h1.symm).resolve_left h2

theorem wcpa_dj_lqcf_nmd_der_rank_one : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F], wcpaDjFF1 K F → ∀ D : Derivation K F F, D ≠ 0 → ∀ (V : ValuationSubring F) (x : F), wcpaDjNtV' K V → wcpaDjValOrd V x = 1 → D x ≠ 0 :=
by
  intro K F _ _ _ _ hF D hD0 V x hV hx

  have kill : ∀ (z : F), Algebra.IsSeparable (IntermediateField.adjoin K {z}) F →
      ∀ E : Derivation K F F, E z = 0 → E = 0 := by
    intro z hsep E hEz

    have hEL : ∀ y ∈ IntermediateField.adjoin K {z}, E y = 0 := by
      intro y hy
      induction hy using IntermediateField.adjoin_induction with
      | mem a ha => rw [Set.mem_singleton_iff.mp ha]; exact hEz
      | algebraMap c => exact E.map_algebraMap c
      | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
      | inv a _ ha => rw [Derivation.leibniz_inv, ha]; simp
      | mul a b _ _ ha hb => rw [Derivation.leibniz, ha, hb, smul_zero, smul_zero, add_zero]

    let EL : Derivation (IntermediateField.adjoin K {z}) F F :=
      { toFun := E
        map_add' := E.map_add
        map_smul' := by
          intro l a
          show E ((l : F) * a) = (l : F) * E a
          rw [Derivation.leibniz, hEL _ l.2, smul_zero, add_zero, smul_eq_mul]
        map_one_eq_zero' := E.map_one_eq_zero
        leibniz' := E.leibniz }
    ext α
    have hsα : (minpoly (IntermediateField.adjoin K {z}) α).Separable :=
      Algebra.IsSeparable.isSeparable (IntermediateField.adjoin K {z}) α
    have h1 := EL.map_aeval (minpoly (IntermediateField.adjoin K {z}) α) α
    rw [minpoly.aeval, map_zero, smul_eq_mul] at h1
    have h2 := Polynomial.Separable.aeval_derivative_ne_zero hsα
      (minpoly.aeval (IntermediateField.adjoin K {z}) α)
    have h3 : EL α = E α := rfl
    rw [h3] at h1
    rw [Derivation.zero_apply]
    exact (mul_eq_zero.mp h1.symm).resolve_left h2

  obtain ⟨z, _, hsep, _⟩ := wcpa_dj_ffv_separating K F hF
  obtain ⟨D₀, hD₀⟩ := wcpa_dj_cdp_ff_derivation K F hF
  have hD₀x : D₀ x ≠ 0 := hD₀ V x hV hx
  have hD₀z : D₀ z ≠ 0 := by
    intro h
    apply hD₀x
    rw [kill z hsep D₀ h, Derivation.zero_apply]
  have hDz : D z ≠ 0 := fun h => hD0 (kill z hsep D h)
  have hE := kill z hsep (D₀ z • D - D z • D₀) (by
    rw [Derivation.sub_apply, Derivation.smul_apply, Derivation.smul_apply, smul_eq_mul,
      smul_eq_mul, mul_comm, sub_self])
  have hEx := congrArg (fun E : Derivation K F F => E x) hE
  simp only [Derivation.sub_apply, Derivation.smul_apply, smul_eq_mul,
    Derivation.zero_apply] at hEx
  intro hDx
  rw [hDx, mul_zero, zero_sub, neg_eq_zero] at hEx
  exact mul_ne_zero hDz hD₀x hEx

theorem wcpa_dj_cdp_le_center_exists (C : Scheme.{u}) (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (ξ : C) (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m) (hgood : wcpaDjChartGood L ξ V b) : ∃ c : C, wcpaDjCtr L ξ V b c :=
by
  classical
  have hU : IsAffineOpen (L.V b) := hOK.1 b
  obtain ⟨hb, hρV⟩ := id hgood
  let ρ' : Γ(C, L.V b) →+* ↥V :=
    RingHom.codRestrict (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom V hρV
  let P : Ideal Γ(C, L.V b) := Ideal.comap ρ' (IsLocalRing.maximalIdeal ↥V)
  haveI hP : P.IsPrime := Ideal.IsPrime.comap ρ'
  let p : PrimeSpectrum Γ(C, L.V b) := ⟨P, hP⟩
  let c : C := hU.fromSpec (show Spec Γ(C, L.V b) from p)
  have hc : c ∈ L.V b := by
    have h1 : c ∈ Set.range hU.fromSpec := ⟨_, rfl⟩
    rw [hU.range_fromSpec] at h1
    exact h1
  refine ⟨c, hb, hc, ⟨hb, hρV⟩, fun x => ?_⟩
  have h6 : c ∈ C.basicOpen x ↔ x ∉ P := by
    have e1 : c ∈ C.basicOpen x ↔
        (show Spec Γ(C, L.V b) from p) ∈ hU.fromSpec ⁻¹ᵁ C.basicOpen x :=
      (Scheme.Hom.mem_preimage _).symm
    rw [e1, hU.fromSpec_preimage_basicOpen]
    exact PrimeSpectrum.mem_basicOpen _ _
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen C x c hc, h6,
    not_not, ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
  constructor
  · intro h
    exact ⟨hρV x, h⟩
  · rintro ⟨_, h⟩
    exact h

theorem wcpa_dj_cdp_le_smooth_center (K : Type u) [Field K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (ξ : C) (hξ : closure {ξ} ∈ irreducibleComponents C) (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m) (c : C) (hctr : wcpaDjCtr L ξ V b c) (hsm : ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) (hb : ξ ∈ L.V b) : ∀ y ∈ V, ∃ a s : Γ(C, L.V b), (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s ∉ V.nonunits ∧ y = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a * ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ :=
by
  classical

  have transfer : ∀ (R O F : Type u) [CommRing R] [CommRing O] [Field F] (g : R →+* O)
      (ρ : R →+* F) (V : ValuationSubring F),
      (∀ w : O, ∃ a s : R, IsUnit (g s) ∧ w * g s = g a) →
      (∀ x y : R, g x = g y → ∃ t : R, IsUnit (g t) ∧ t * x = t * y) →
      (∀ x : R, IsUnit (g x) → ρ x ∉ V.nonunits) →
      (∀ a b : O, ∃ w : O, a * w = b ∨ b * w = a) →
      ∀ a₀ s₀ : R, ρ s₀ ≠ 0 → ρ a₀ * (ρ s₀)⁻¹ ∈ V →
      ∃ a s : R, ρ s ∉ V.nonunits ∧ ρ a₀ * (ρ s₀)⁻¹ = ρ a * (ρ s)⁻¹ := by
    intro R O F _ _ _ g ρ V hsurj heq hunit hcond a₀ s₀ hs₀ hy
    have P1 : ∀ x : F, x ∉ V.nonunits → x ≠ 0 := by
      intro x hx h0
      apply hx
      rw [h0, ValuationSubring.mem_nonunits_iff, map_zero]
      exact zero_lt_one
    obtain ⟨w, hw⟩ := hcond (g a₀) (g s₀)
    obtain ⟨a₁, s₁, hs₁u, hs₁⟩ := hsurj w
    have hρs₁ := hunit s₁ hs₁u
    have hρs₁0 := P1 _ hρs₁
    rcases hw with hI | hII
    · have hgeq : g (a₀ * a₁) = g (s₀ * s₁) := by
        rw [map_mul, map_mul, ← hs₁, ← mul_assoc, hI]
      obtain ⟨t, htu, ht⟩ := heq _ _ hgeq
      have hρt := P1 _ (hunit t htu)
      have e : ρ a₀ * ρ a₁ = ρ s₀ * ρ s₁ := by
        have h1 := congrArg ρ ht
        simp only [map_mul] at h1
        exact mul_left_cancel₀ hρt h1
      have hne : ρ s₀ * ρ s₁ ≠ 0 := mul_ne_zero hs₀ hρs₁0
      have ha₁ : ρ a₁ ≠ 0 := fun h => hne (by rw [← e, h, mul_zero])
      have hyeq : ρ a₀ * (ρ s₀)⁻¹ = ρ s₁ * (ρ a₁)⁻¹ := by
        rw [← div_eq_mul_inv, ← div_eq_mul_inv, div_eq_div_iff hs₀ ha₁, e, mul_comm]
      refine ⟨s₁, a₁, ?_, hyeq⟩
      intro hna
      have hinvV : (ρ s₁)⁻¹ ∈ V := by
        rw [← V.valuation_le_one_iff, map_inv₀]
        rw [ValuationSubring.mem_nonunits_iff, not_lt] at hρs₁
        exact inv_le_one_of_one_le₀ hρs₁
      rw [ValuationSubring.mem_nonunits_iff] at hna
      have hv1 : V.valuation (ρ a₁ * (ρ s₁)⁻¹) < 1 := by
        rw [map_mul]
        calc V.valuation (ρ a₁) * V.valuation ((ρ s₁)⁻¹) ≤ V.valuation (ρ a₁) :=
              mul_le_of_le_one_right' ((V.valuation_le_one_iff _).mpr hinvV)
          _ < 1 := hna
      have hv2 : V.valuation (ρ a₀ * (ρ s₀)⁻¹) ≤ 1 := (V.valuation_le_one_iff _).mpr hy
      have hprod : ρ a₀ * (ρ s₀)⁻¹ * (ρ a₁ * (ρ s₁)⁻¹) = 1 := by
        rw [hyeq, mul_assoc, inv_mul_cancel_left₀ ha₁, mul_inv_cancel₀ hρs₁0]
      have hlt : V.valuation (ρ a₀ * (ρ s₀)⁻¹ * (ρ a₁ * (ρ s₁)⁻¹)) < 1 := by
        rw [map_mul (V.valuation) (ρ a₀ * (ρ s₀)⁻¹)]
        calc V.valuation (ρ a₀ * (ρ s₀)⁻¹) * V.valuation (ρ a₁ * (ρ s₁)⁻¹)
            ≤ V.valuation (ρ a₁ * (ρ s₁)⁻¹) := mul_le_of_le_one_left' hv2
          _ < 1 := hv1
      rw [hprod, map_one] at hlt
      exact lt_irrefl _ hlt
    · have hgeq : g (s₀ * a₁) = g (a₀ * s₁) := by
        rw [map_mul, map_mul, ← hs₁, ← mul_assoc, hII]
      obtain ⟨t, htu, ht⟩ := heq _ _ hgeq
      have hρt := P1 _ (hunit t htu)
      have e : ρ s₀ * ρ a₁ = ρ a₀ * ρ s₁ := by
        have h1 := congrArg ρ ht
        simp only [map_mul] at h1
        exact mul_left_cancel₀ hρt h1
      refine ⟨a₁, s₁, hρs₁, ?_⟩
      rw [← div_eq_mul_inv, ← div_eq_mul_inv, div_eq_div_iff hs₀ hρs₁0, ← e, mul_comm]

  have hcond : ∀ a b : C.presheaf.stalk c, ∃ w, a * w = b ∨ b * w = a := by
    obtain ⟨W, hcW, hW⟩ := hsm
    haveI := hW
    let x : W := ⟨c, hcW⟩
    haveI : IsDomain ((W : Scheme).presheaf.stalk x) :=
      wcpa_smooth_stalk_isDomain K W (W.ι ≫ q) 1 x
    haveI : ValuationRing ((W : Scheme).presheaf.stalk x) :=
      wcpa_dj_sgt_smooth_curve_stalk_valuation K W (W.ι ≫ q) x
    let e := (W.stalkIso x).commRingCatIsoToRingEquiv
    intro a b
    obtain ⟨w', hw'⟩ := ValuationRing.cond (e.symm a) (e.symm b)
    refine ⟨e w', ?_⟩
    rcases hw' with h | h
    · left
      have h1 := congrArg e h
      rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at h1
    · right
      have h1 := congrArg e h
      rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at h1
  intro y hy
  obtain ⟨hb', hc, -, hiff⟩ := hctr
  have hU : IsAffineOpen (L.V b) := hOK.1 b

  have hloc : ∀ (p : C) (hp : p ∈ L.V b),
      (∀ w : C.presheaf.stalk p, ∃ a s : Γ(C, L.V b),
        IsUnit ((C.presheaf.germ (L.V b) p hp).hom s) ∧
        w * (C.presheaf.germ (L.V b) p hp).hom s = (C.presheaf.germ (L.V b) p hp).hom a) ∧
      (∀ x y : Γ(C, L.V b), (C.presheaf.germ (L.V b) p hp).hom x =
        (C.presheaf.germ (L.V b) p hp).hom y →
        ∃ t : Γ(C, L.V b), IsUnit ((C.presheaf.germ (L.V b) p hp).hom t) ∧ t * x = t * y) := by
    intro p hp
    let x : L.V b := ⟨p, hp⟩
    letI : Algebra Γ(C, L.V b) (C.presheaf.stalk (x : C)) :=
      TopCat.Presheaf.algebra_section_stalk C.presheaf x
    haveI := hU.isLocalization_stalk x
    have halg : ∀ r, algebraMap Γ(C, L.V b) (C.presheaf.stalk (x : C)) r =
        (C.presheaf.germ (L.V b) p hp).hom r := fun r => rfl
    refine ⟨fun w => ?_, fun r r' h => ?_⟩
    · obtain ⟨⟨a, s⟩, hw⟩ := IsLocalization.mk'_surjective (hU.primeIdealOf x).asIdeal.primeCompl
        (w : C.presheaf.stalk (x : C))
      refine ⟨a, s, ?_, ?_⟩
      · rw [← halg]
        exact IsLocalization.map_units (C.presheaf.stalk (x : C)) s
      · rw [← halg, ← halg, ← hw]
        exact IsLocalization.mk'_spec (C.presheaf.stalk (x : C)) a s
    · rw [← halg, ← halg] at h
      obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists (hU.primeIdealOf x).asIdeal.primeCompl
        (C.presheaf.stalk (x : C))).mp h
      refine ⟨t, ?_, ht⟩
      rw [← halg]
      exact IsLocalization.map_units (C.presheaf.stalk (x : C)) t
  set ρ := (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom with hρ
  have hunit : ∀ x : Γ(C, L.V b), IsUnit ((C.presheaf.germ (L.V b) c hc).hom x) →
      ρ x ∉ V.nonunits := by
    intro x hx hρx
    exact (IsLocalRing.notMem_maximalIdeal.mpr hx) ((hiff x).mpr hρx)
  obtain ⟨z, hz⟩ := C.residue_surjective ξ y
  obtain ⟨a₀, s₀, hs₀u, hs₀e⟩ := (hloc ξ hb).1 z
  have hρs₀ : IsUnit (ρ s₀) := hs₀u.map (C.residue ξ).hom
  have hmul : y * ρ s₀ = ρ a₀ := by
    rw [← hz]
    show (C.residue ξ).hom z * (C.residue ξ).hom ((C.presheaf.germ (L.V b) ξ hb).hom s₀) =
      (C.residue ξ).hom ((C.presheaf.germ (L.V b) ξ hb).hom a₀)
    rw [← map_mul, hs₀e]
  have hyeq : y = ρ a₀ * (ρ s₀)⁻¹ := by
    rw [← hmul, mul_inv_cancel_right₀ hρs₀.ne_zero]
  obtain ⟨a, s, hs, he⟩ := transfer _ _ _ (C.presheaf.germ (L.V b) c hc).hom ρ V
    (hloc c hc).1 (hloc c hc).2 hunit hcond a₀ s₀ hρs₀.ne_zero (by rw [← hyeq]; exact hy)
  exact ⟨a, s, hs, hyeq.trans he⟩

theorem wcpa_dj_lqcf_nmd_node_germ : ∀ (k : Type u) [Field k] (C : Scheme.{u}) (c : C ⟶ Spec (.of k)) (U : C.Opens), IsAffineOpen U → ∀ (θU : Γ(C, U) → Γ(C, U)), (∀ f g, θU (f + g) = θU f + θU g) → (∀ f g, θU (f * g) = f * θU g + g * θU f) → (∀ a : k, θU ((c.appTop ≫ C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom ((Scheme.ΓSpecIso (.of k)).inv.hom a)) = 0) → ∀ (x : C) (hx : x ∈ U), IsNoetherianRing (C.presheaf.stalk x) → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk x)) (C.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (C.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk x)) (C.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of k)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∀ f : Γ(C, U), (C.presheaf.germ U x hx).hom (θU f) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) :=
by
  intro k _ C c U hU θU hA hL hK x hx hNoeth he f

  have bridge : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), (∀ (n : ℕ) (t : MvPowerSeries (Fin 2) L), ∃ r : R, e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) ∧ (∀ (n : ℕ) (r : R), e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) ↔ r ∈ IsLocalRing.maximalIdeal R ^ n) := by
    intro L _ R _ _ _ e
    classical

    have hmax : ∀ (S : Type u) [CommRing S] (j : R →+* S),
        (∀ c : S, ∃ p : R, c - j p ∈ Ideal.map j (IsLocalRing.maximalIdeal R)) →
        (∀ p : R, j p ∈ Ideal.map j (IsLocalRing.maximalIdeal R) → p ∈ IsLocalRing.maximalIdeal R) →
        (Ideal.map j (IsLocalRing.maximalIdeal R)).IsMaximal := by
      intro S _ j hd hs
      rw [Ideal.isMaximal_iff]
      refine ⟨fun h1 => ?_, fun J x hle hx hxJ => ?_⟩
      · have h1' : (1 : R) ∈ IsLocalRing.maximalIdeal R := hs 1 (by rw [map_one]; exact h1)
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h1')
      · obtain ⟨p, hp⟩ := hd x
        have hpm : p ∉ IsLocalRing.maximalIdeal R := by
          intro hpm
          apply hx
          have h2 := Ideal.add_mem _ hp (Ideal.mem_map_of_mem j hpm)
          rwa [sub_add_cancel] at h2
        have hu : IsUnit (j p) := (IsLocalRing.notMem_maximalIdeal.mp hpm).map j
        have hjp : j p ∈ J := by
          have h3 := J.sub_mem hxJ (hle hp)
          rwa [sub_sub_cancel] at h3
        rw [Ideal.eq_top_of_isUnit_mem J hjp hu]
        exact Submodule.mem_top

    have hN : ∀ M : Ideal (MvPowerSeries (Fin 2) L ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), M.IsMaximal →
        M = Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) := by
      intro M hM
      have hle : M ≤ Ideal.map (Ideal.Quotient.mk
          (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) := by
        intro y hy
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
        apply Ideal.mem_map_of_mem
        by_contra hF
        have hu := (IsLocalRing.notMem_maximalIdeal.mp hF).map
          (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        exact hM.ne_top (Ideal.eq_top_of_isUnit_mem M hy hu)
      have hne : Ideal.map (Ideal.Quotient.mk
          (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) ≠ ⊤ := by
        intro htop
        have h1 : 1 ∈ Ideal.map (Ideal.Quotient.mk
            (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
            (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) := by
          rw [htop]; exact Submodule.mem_top
        rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at h1
        obtain ⟨F, hF, hF1⟩ := h1
        rw [← map_one (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
          Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hF1
        obtain ⟨G, hG⟩ := hF1
        have hc := congrArg MvPowerSeries.constantCoeff hG
        simp only [map_mul, map_sub, map_one, MvPowerSeries.constantCoeff_X, mul_zero] at hc
        have hF0 : MvPowerSeries.constantCoeff F ≠ 0 := by
          intro h0
          rw [h0] at hc
          simp at hc
        apply (IsLocalRing.mem_maximalIdeal _).mp hF
        exact MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr hF0)
      exact hM.eq_of_le hne hle


    have hlev : (∀ (k : ℕ) (c : AdicCompletion (IsLocalRing.maximalIdeal R) R), ∃ p : R, c - algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) (IsLocalRing.maximalIdeal R ^ k)) ∧ (∀ (k : ℕ) (p : R), algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) (IsLocalRing.maximalIdeal R ^ k) → p ∈ IsLocalRing.maximalIdeal R ^ k) := by
      have hfg : (IsLocalRing.maximalIdeal R).FG := IsNoetherian.noetherian _
      have hmem : ∀ (k : ℕ) (b : AdicCompletion (IsLocalRing.maximalIdeal R) R),
          b ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
            (IsLocalRing.maximalIdeal R ^ k) ↔
          AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k b = 0 := by
        intro k b
        have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := R) (n := k) hfg
        have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal R) R)
          (IsLocalRing.maximalIdeal R ^ k)
        have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
        rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
        exact h3
      have hof : ∀ (k : ℕ) (p : R), AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k
          (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p) =
          Submodule.Quotient.mk p := by
        intro k p
        change AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k
          (AdicCompletion.of (IsLocalRing.maximalIdeal R) R p) = _
        rw [AdicCompletion.eval_of]
        rfl
      refine ⟨fun k c => ?_, fun k p h => ?_⟩
      · obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
          (AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k c)
        refine ⟨p, (hmem k _).mpr ?_⟩
        rw [map_sub, hof, hp, sub_self]
      · rw [hmem, hof, Submodule.Quotient.mk_eq_zero] at h
        have hle : IsLocalRing.maximalIdeal R ^ k • (⊤ : Submodule R R) ≤
            IsLocalRing.maximalIdeal R ^ k := by
          rw [Ideal.smul_eq_mul, Ideal.mul_top]
        exact hle h
    obtain ⟨L1, L2⟩ := hlev
    have h𝔐 := hmax (AdicCompletion (IsLocalRing.maximalIdeal R) R)
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
      (fun c => by have h := L1 1 c; rwa [pow_one] at h)
      (fun p hp => by
        have h := L2 1 p (by rwa [pow_one]); rwa [pow_one] at h)
    haveI := h𝔐
    have hEq := hN _ (Ideal.map_isMaximal_of_equiv e
      (p := Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (IsLocalRing.maximalIdeal R)))
    have hPow : ∀ n : ℕ, Ideal.map e (Ideal.map
        (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (IsLocalRing.maximalIdeal R ^ n)) =
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) := by
      intro n
      rw [Ideal.map_pow, Ideal.map_pow, hEq, Ideal.map_pow]
    refine ⟨fun n t => ?_, fun n r => ⟨fun h => ?_, fun h => ?_⟩⟩
    · obtain ⟨r, hr⟩ := L1 n (e.symm
        (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t))
      refine ⟨r, ?_⟩
      have h := Ideal.mem_map_of_mem e hr
      rw [hPow, map_sub, RingEquiv.apply_symm_apply] at h
      rw [← neg_sub]
      exact (Ideal.neg_mem_iff _).mpr h
    · rw [← hPow, Ideal.mem_map_iff_of_surjective e e.surjective] at h
      obtain ⟨x, hx, hxe⟩ := h
      have hx' := e.injective hxe
      rw [hx'] at hx
      exact L2 n r hx
    · rw [← hPow]
      exact Ideal.mem_map_of_mem e (Ideal.mem_map_of_mem _ h)

  have t_s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (p : Ideal R) [p.IsPrime]
      [IsLocalization.AtPrime S p] (θ : R → R), (∀ a b, θ (a + b) = θ a + θ b) →
      (∀ a b, θ (a * b) = a * θ b + b * θ a) →
      ∃ δ : S → S, (∀ a b, δ (a + b) = δ a + δ b) ∧ (∀ a b, δ (a * b) = a * δ b + b * δ a) ∧
        ∀ a, δ (algebraMap R S a) = algebraMap R S (θ a) := by
    intro R S _ _ _ p _ _ θ hA hL
    have h0 : θ 0 = 0 := by
      have h := hA 0 0
      rw [add_zero] at h
      linear_combination -h
    have h1 : θ 1 = 0 := by
      have h := hL 1 1
      simp only [mul_one, one_mul] at h
      linear_combination -h
    let Θ : R →+* DualNumber S :=
      { toFun := fun a => TrivSqZeroExt.inl (algebraMap R S a) +
          TrivSqZeroExt.inr (algebraMap R S (θ a))
        map_one' := by
          ext
          · simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, map_one,
              add_zero, TrivSqZeroExt.fst_one]
          · simp only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, h1,
              map_zero, add_zero, TrivSqZeroExt.snd_one]
        map_mul' := fun a b => by
          ext
          · simp only [TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl,
              TrivSqZeroExt.fst_inr, add_zero, map_mul]
          · simp only [TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add,
              TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, TrivSqZeroExt.snd_inl,
              TrivSqZeroExt.snd_inr, add_zero, zero_add, hL, map_add, map_mul, smul_eq_mul,
              op_smul_eq_mul]
            ring
        map_zero' := by
          ext
          · simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, map_zero,
              add_zero, TrivSqZeroExt.fst_zero]
          · simp only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, h0,
              map_zero, add_zero, TrivSqZeroExt.snd_zero]
        map_add' := fun a b => by
          ext
          · simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, map_add,
              add_zero]
          · simp only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, hA,
              map_add, zero_add] }
    have hΘ : ∀ a, (Θ a).fst = algebraMap R S a ∧ (Θ a).snd = algebraMap R S (θ a) := by
      intro a
      constructor
      · show (TrivSqZeroExt.inl (algebraMap R S a) + TrivSqZeroExt.inr (algebraMap R S (θ a)) :
          DualNumber S).fst = _
        simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero]
      · show (TrivSqZeroExt.inl (algebraMap R S a) + TrivSqZeroExt.inr (algebraMap R S (θ a)) :
          DualNumber S).snd = _
        simp only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_add]
    have hunits : ∀ y : p.primeCompl, IsUnit (Θ y) := by
      intro y
      rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, (hΘ y).1]
      exact IsLocalization.map_units S y
    let Λ : S →+* DualNumber S := IsLocalization.lift (M := p.primeCompl) hunits
    have hΛ : ∀ a, Λ (algebraMap R S a) = Θ a := fun a => IsLocalization.lift_eq hunits a
    have hfst : ∀ s, (Λ s).fst = s := by
      have hj : (TrivSqZeroExt.fstHom S S S).toRingHom.comp Λ = RingHom.id S := by
        apply IsLocalization.ringHom_ext p.primeCompl
        ext a
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΛ]
        exact (hΘ a).1
      intro s
      exact RingHom.congr_fun hj s
    refine ⟨fun s => (Λ s).snd, ?_, ?_, ?_⟩
    · intro a b
      simp only [map_add, TrivSqZeroExt.snd_add]
    · intro a b
      simp only [map_mul, TrivSqZeroExt.snd_mul, hfst, smul_eq_mul, op_smul_eq_mul]
      ring
    · intro a
      simp only
      rw [hΛ]
      exact (hΘ a).2

  have t_s4 : ∀ (O : Type u) [CommRing O] (I : Ideal O) (δ : O → O),
      (∀ a b, δ (a + b) = δ a + δ b) → (∀ a b, δ (a * b) = a * δ b + b * δ a) →
      ∀ (n : ℕ) (z : O), z ∈ I ^ (n + 1) → δ z ∈ I ^ n := by
    intro O _ I δ hA hL
    intro n
    induction n with
    | zero => intro z _; simp
    | succ n ih =>
      intro z hz
      rw [pow_succ'] at hz
      refine Submodule.mul_induction_on hz ?_ ?_
      · intro a ha b hb
        rw [hL]
        refine Ideal.add_mem _ ?_ ?_
        · rw [pow_succ']; exact Ideal.mul_mem_mul ha (ih b hb)
        · exact Ideal.mul_mem_right _ _ hb
      · intro x y hx hy
        rw [hA]
        exact Ideal.add_mem _ hx hy

  have t_core : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (φ : k →+* O)
      (Ψ : O →+* (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
      (∀ c, Ψ (φ c) = Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.C c)) →
      (∀ (n : ℕ) (t : MvPowerSeries (Fin 2) k), ∃ r : O,
        Ψ r - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈
          Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
            (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) ^ n)) →
      (∀ (n : ℕ) (r : O), Ψ r ∈
          Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
            (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) ^ n) ↔
          r ∈ IsLocalRing.maximalIdeal O ^ n) →
      ∀ (δ : O → O), (∀ a b, δ (a + b) = δ a + δ b) →
      (∀ a b, δ (a * b) = a * δ b + b * δ a) → (∀ c, δ (φ c) = 0) →
      ∀ o, δ o ∈ IsLocalRing.maximalIdeal O := by
    intro O _ _ φ Ψ hΨφ B1 B2 δ hA hL hK
    classical
    have s4 := t_s4 O (IsLocalRing.maximalIdeal O) δ hA hL
    set mk := Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
      MvPowerSeries (Fin 2) k)}) with hmk
    set N := IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) with hN
    set m := IsLocalRing.maximalIdeal O with hm
    have hF1 : ∀ p : MvPowerSeries (Fin 2) k, p ∈ N ↔ MvPowerSeries.constantCoeff p = 0 := by
      intro p
      rw [hN, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
        isUnit_iff_ne_zero, not_not]
    have hMmul : ∀ (a b : ℕ) (x y), x ∈ Ideal.map mk (N ^ a) → y ∈ Ideal.map mk (N ^ b) →
        x * y ∈ Ideal.map mk (N ^ (a + b)) := by
      intro a b x y hx hy
      rw [pow_add, Ideal.map_mul]
      exact Ideal.mul_mem_mul hx hy
    have hMmono : ∀ (a b : ℕ) (x), a ≤ b → x ∈ Ideal.map mk (N ^ b) → x ∈ Ideal.map mk (N ^ a) :=
      fun a b x hab hx => Ideal.map_mono (Ideal.pow_le_pow_right hab) hx
    have hNM1 : ∀ p, p ∈ N → mk p ∈ Ideal.map mk (N ^ 1) := by
      intro p hp
      apply Ideal.mem_map_of_mem
      rwa [pow_one]
    have hX : ∀ i : Fin 2, MvPowerSeries.X i ∈ N := by
      intro i
      rw [hF1]
      simp
    have hmm : ∀ a b : O, a ∈ m → b ∈ m → a * b ∈ m ^ 2 := by
      intro a b ha hb
      rw [pow_two]
      exact Ideal.mul_mem_mul ha hb
    have hm2 : ∀ a : O, a ∈ m ^ 2 → a ∈ m := by
      intro a ha
      have := Ideal.pow_le_pow_right (I := m) (by norm_num : 1 ≤ 2) ha
      rwa [pow_one] at this

    have P1 : ∀ p : MvPowerSeries (Fin 2) k, MvPowerSeries.constantCoeff p = 0 →
        ∃ a b, p = MvPowerSeries.X 0 * a + MvPowerSeries.X 1 * b := by
      intro p hp
      let q1 : MvPowerSeries (Fin 2) k := fun n => if n 0 = 0 then MvPowerSeries.coeff n p else 0
      have hq1 : ∀ n, MvPowerSeries.coeff n q1 = if n 0 = 0 then MvPowerSeries.coeff n p else 0 :=
        fun n => rfl
      have d1 : MvPowerSeries.X 1 ∣ q1 := by
        rw [MvPowerSeries.X_dvd_iff]
        intro n hn
        rw [hq1]
        split_ifs with h0
        · have hn0 : n = 0 := by
            ext i
            fin_cases i
            · simpa using h0
            · simpa using hn
          rw [hn0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
          exact hp
        · rfl
      have d0 : MvPowerSeries.X 0 ∣ p - q1 := by
        rw [MvPowerSeries.X_dvd_iff]
        intro n hn
        rw [map_sub, hq1, if_pos hn, sub_self]
      obtain ⟨a, ha⟩ := d0
      obtain ⟨b, hb⟩ := d1
      refine ⟨a, b, ?_⟩
      rw [← ha, ← hb]
      ring

    have K : ∀ (i : Fin 2) (a b : MvPowerSeries (Fin 2) k), MvPowerSeries.constantCoeff a = 0 →
        MvPowerSeries.constantCoeff b = 0 → MvPowerSeries.coeff (Finsupp.single i 1) (a * b) = 0 := by
      intro i a b ha hb
      rw [MvPowerSeries.coeff_mul, Finsupp.antidiagonal_single, Finset.sum_map]
      simp [Finset.Nat.sum_antidiagonal_succ, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, ha, hb]

    have P2 : ∀ (i : Fin 2) (P : MvPowerSeries (Fin 2) k), mk P ∈ Ideal.map mk (N ^ 2) →
        MvPowerSeries.coeff (Finsupp.single i 1) P = 0 := by
      intro i P hP
      obtain ⟨p', hp', hpe⟩ := (Ideal.mem_map_iff_of_surjective mk Ideal.Quotient.mk_surjective).mp hP
      rw [hmk, Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hpe
      obtain ⟨q, hq⟩ := hpe
      have e1 : MvPowerSeries.coeff (Finsupp.single i 1) p' = 0 := by
        rw [pow_two] at hp'
        refine Submodule.mul_induction_on hp' ?_ ?_
        · intro a ha b hb
          exact K i a b ((hF1 a).mp ha) ((hF1 b).mp hb)
        · intro x y hx hy
          rw [map_add, hx, hy, add_zero]
      have e2 : MvPowerSeries.coeff (Finsupp.single i 1) (q * (MvPowerSeries.X 0 * MvPowerSeries.X 1))
          = 0 := by
        rw [← mul_assoc]
        exact K i _ _ (by simp) (by simp)
      have e3 : P = p' - q * (MvPowerSeries.X 0 * MvPowerSeries.X 1) := by
        rw [hq]; ring
      rw [e3, map_sub, e1, e2, sub_zero]

    obtain ⟨x0, hu⟩ := B1 2 (MvPowerSeries.X 0)
    obtain ⟨y0, hv⟩ := B1 2 (MvPowerSeries.X 1)
    have hx0 : x0 ∈ m := by
      have h := (B2 1 x0).mp (by
        have := Ideal.add_mem _ (hMmono 1 2 _ (by norm_num) hu) (hNM1 _ (hX 0))
        rwa [sub_add_cancel] at this)
      rwa [pow_one] at h
    have hy0 : y0 ∈ m := by
      have h := (B2 1 y0).mp (by
        have := Ideal.add_mem _ (hMmono 1 2 _ (by norm_num) hv) (hNM1 _ (hX 1))
        rwa [sub_add_cancel] at this)
      rwa [pow_one] at h
    have hxy : x0 * y0 ∈ m ^ 3 := by
      apply (B2 3 _).mp
      have e : Ψ (x0 * y0) = (Ψ x0 - mk (MvPowerSeries.X 0)) * (Ψ y0 - mk (MvPowerSeries.X 1)) +
          (Ψ x0 - mk (MvPowerSeries.X 0)) * mk (MvPowerSeries.X 1) +
          mk (MvPowerSeries.X 0) * (Ψ y0 - mk (MvPowerSeries.X 1)) +
          mk (MvPowerSeries.X 0 * MvPowerSeries.X 1) := by
        rw [map_mul, map_mul]; ring
      have hz : mk (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 := by
        rw [hmk, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton_self _
      rw [e, hz, add_zero]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
      · exact hMmono 3 4 _ (by norm_num) (hMmul 2 2 _ _ hu hv)
      · exact hMmul 2 1 _ _ hu (hNM1 _ (hX 1))
      · have := hMmul 1 2 _ _ (hNM1 _ (hX 0)) hv
        exact this

    have hD : ∀ o : O, ∃ (γ α β : k) (w : O), w ∈ m ^ 2 ∧
        o = φ γ + φ α * x0 + φ β * y0 + w := by
      intro o
      obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (I := Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) (Ψ o)
      obtain ⟨a, b, hab⟩ := P1 (p - MvPowerSeries.C (MvPowerSeries.constantCoeff p)) (by simp)
      refine ⟨MvPowerSeries.constantCoeff p, MvPowerSeries.constantCoeff a,
        MvPowerSeries.constantCoeff b,
        o - φ (MvPowerSeries.constantCoeff p) - φ (MvPowerSeries.constantCoeff a) * x0 -
          φ (MvPowerSeries.constantCoeff b) * y0, ?_, by ring⟩
      apply (B2 2 _).mp
      have e := congrArg mk hab
      have e' : Ψ (o - φ (MvPowerSeries.constantCoeff p) - φ (MvPowerSeries.constantCoeff a) * x0 -
          φ (MvPowerSeries.constantCoeff b) * y0) =
          mk (MvPowerSeries.X 0) * mk (a - MvPowerSeries.C (MvPowerSeries.constantCoeff a)) +
          mk (MvPowerSeries.X 1) * mk (b - MvPowerSeries.C (MvPowerSeries.constantCoeff b)) -
          mk (MvPowerSeries.C (MvPowerSeries.constantCoeff a)) * (Ψ x0 - mk (MvPowerSeries.X 0)) -
          mk (MvPowerSeries.C (MvPowerSeries.constantCoeff b)) * (Ψ y0 - mk (MvPowerSeries.X 1)) := by
        simp only [map_sub, map_mul, map_add, hΨφ] at e ⊢
        rw [← hp]
        linear_combination e
      rw [e']
      refine Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.add_mem _ ?_ ?_) ?_) ?_
      · exact hMmul 1 1 _ _ (hNM1 _ (hX 0)) (hNM1 _ ((hF1 _).mpr (by simp)))
      · exact hMmul 1 1 _ _ (hNM1 _ (hX 1)) (hNM1 _ ((hF1 _).mpr (by simp)))
      · exact Ideal.mul_mem_left _ _ hu
      · exact Ideal.mul_mem_left _ _ hv

    have hδ0 : δ 0 = 0 := by
      have h := hA 0 0
      rw [add_zero] at h
      linear_combination -h
    have hδsub : ∀ a b, δ (a - b) = δ a - δ b := by
      intro a b
      have h := hA (a - b) b
      rw [sub_add_cancel] at h
      rw [h]; ring
    have hδφmul : ∀ (c : k) (z : O), δ (φ c * z) = φ c * δ z := by
      intro c z
      rw [hL, hK, mul_zero, add_zero]

    obtain ⟨γ1, α1, β1, w1, hw1, h1⟩ := hD (δ x0)
    obtain ⟨γ2, α2, β2, w2, hw2, h2⟩ := hD (δ y0)
    have hm1 : δ x0 - φ γ1 ∈ m := by
      have : δ x0 - φ γ1 = φ α1 * x0 + φ β1 * y0 + w1 := by rw [h1]; ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hx0)
        (Ideal.mul_mem_left _ _ hy0)) (hm2 _ hw1)
    have hm2' : δ y0 - φ γ2 ∈ m := by
      have : δ y0 - φ γ2 = φ α2 * x0 + φ β2 * y0 + w2 := by rw [h2]; ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hx0)
        (Ideal.mul_mem_left _ _ hy0)) (hm2 _ hw2)
    have hδxy : δ (x0 * y0) ∈ m ^ 2 := s4 2 _ hxy
    have hz : φ γ2 * x0 + φ γ1 * y0 ∈ m ^ 2 := by
      have e : φ γ2 * x0 + φ γ1 * y0 = δ (x0 * y0) - x0 * (δ y0 - φ γ2) - y0 * (δ x0 - φ γ1) := by
        rw [hL]; ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ hδxy (hmm _ _ hx0 hm2')) (hmm _ _ hy0 hm1)
    have hP : mk (MvPowerSeries.C γ2 * MvPowerSeries.X 0 + MvPowerSeries.C γ1 * MvPowerSeries.X 1) ∈
        Ideal.map mk (N ^ 2) := by
      have hΨz := (B2 2 _).mpr hz
      have e : mk (MvPowerSeries.C γ2 * MvPowerSeries.X 0 + MvPowerSeries.C γ1 * MvPowerSeries.X 1) =
          Ψ (φ γ2 * x0 + φ γ1 * y0) - mk (MvPowerSeries.C γ2) * (Ψ x0 - mk (MvPowerSeries.X 0)) -
          mk (MvPowerSeries.C γ1) * (Ψ y0 - mk (MvPowerSeries.X 1)) := by
        simp only [map_add, map_mul, hΨφ]
        ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ hΨz (Ideal.mul_mem_left _ _ hu))
        (Ideal.mul_mem_left _ _ hv)
    have hγ2 : γ2 = 0 := by
      have h := P2 0 _ hP
      simpa [MvPowerSeries.coeff_X, MvPowerSeries.coeff_C_mul, Finsupp.single_left_inj] using h
    have hγ1 : γ1 = 0 := by
      have h := P2 1 _ hP
      simpa [MvPowerSeries.coeff_X, MvPowerSeries.coeff_C_mul, Finsupp.single_left_inj] using h
    have hδx0 : δ x0 ∈ m := by
      have := hm1
      rwa [hγ1, map_zero, sub_zero] at this
    have hδy0 : δ y0 ∈ m := by
      have := hm2'
      rwa [hγ2, map_zero, sub_zero] at this

    intro o
    obtain ⟨γ, α, β, w, hw, rfl⟩ := hD o
    rw [hA, hA, hA, hK, hδφmul, hδφmul, zero_add]
    have hδw : δ w ∈ m := by
      have := s4 1 w hw
      rwa [pow_one] at this
    exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hδx0)
      (Ideal.mul_mem_left _ _ hδy0)) hδw

  haveI := hNoeth
  obtain ⟨e, he⟩ := he
  letI : Algebra Γ(C, U) (C.presheaf.stalk (⟨x, hx⟩ : U).1) :=
    TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨x, hx⟩
  haveI : IsLocalization.AtPrime (C.presheaf.stalk (⟨x, hx⟩ : U).1)
      (hU.primeIdealOf ⟨x, hx⟩).asIdeal := hU.isLocalization_stalk ⟨x, hx⟩
  have halg : algebraMap Γ(C, U) (C.presheaf.stalk (⟨x, hx⟩ : U).1) =
      (C.presheaf.germ U x hx).hom := TopCat.Presheaf.stalk_open_algebraMap C.presheaf ⟨x, hx⟩
  obtain ⟨δ, hδA, hδL, hδg⟩ := t_s1 Γ(C, U) (C.presheaf.stalk (⟨x, hx⟩ : U).1)
    (hU.primeIdealOf ⟨x, hx⟩).asIdeal θU hA hL
  rw [halg] at hδg
  set φ : k →+* C.presheaf.stalk x :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ x trivial).hom with hφ
  have hδφ : ∀ a : k, δ (φ a) = 0 := by
    intro a
    have e1 : φ a = (C.presheaf.germ U x hx).hom
        ((c.appTop ≫ C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          ((Scheme.ΓSpecIso (.of k)).inv.hom a)) := by
      rw [hφ, CommRingCat.comp_apply, CommRingCat.comp_apply, CommRingCat.comp_apply,
        TopCat.Presheaf.germ_res_apply]
    rw [e1, hδg, hK, map_zero]
  have bri := bridge k (C.presheaf.stalk x) e
  have key := t_core (C.presheaf.stalk x) φ
    (e.toRingHom.comp (algebraMap (C.presheaf.stalk x)
      (AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk x)) (C.presheaf.stalk x))))
    (fun c => RingHom.congr_fun he c) bri.1 bri.2 δ hδA hδL hδφ
  rw [← hδg]
  exact key _

theorem wcpa_dj_cdp_le_residue_fractions (C : Scheme.{u}) (U : C.Opens) (hU : IsAffineOpen U)
    (ξ : C) (hξ : ξ ∈ U) :
    ∀ y : C.residueField ξ, ∃ a s : Γ(C, U),
      (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom s ≠ 0 ∧
      y = (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom a *
        ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom s)⁻¹ :=
by
  intro y
  obtain ⟨z, hz⟩ := C.residue_surjective ξ y
  let x₀ : U := ⟨ξ, hξ⟩
  letI : Algebra Γ(C, U) (C.presheaf.stalk (x₀ : C)) :=
    TopCat.Presheaf.algebra_section_stalk C.presheaf x₀
  have := hU.isLocalization_stalk x₀
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (hU.primeIdealOf x₀).asIdeal.primeCompl z
  have hu : IsUnit (algebraMap Γ(C, U) (C.presheaf.stalk (x₀ : C)) (s : Γ(C, U))) :=
    IsLocalization.map_units (C.presheaf.stalk (x₀ : C)) s
  have hgerm : ∀ t : Γ(C, U),
      algebraMap Γ(C, U) (C.presheaf.stalk (x₀ : C)) t = (C.presheaf.germ U ξ hξ).hom t :=
    fun t => rfl
  have hρ : ∀ t : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom t =
      (C.residue ξ).hom ((C.presheaf.germ U ξ hξ).hom t) := fun t => rfl
  simp only [hgerm] at hu hs
  have hsne : (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom (s : Γ(C, U)) ≠ 0 := by
    rw [hρ]
    exact (hu.map (C.residue ξ).hom).ne_zero
  refine ⟨a, s, hsne, ?_⟩
  have key : y * (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom (s : Γ(C, U)) =
      (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom a := by
    rw [hρ, hρ, ← hz, ← map_mul]
    exact congrArg _ hs
  exact (eq_mul_inv_iff_mul_eq₀ hsne).mpr key

theorem wcpa_dj_cdp_le_node_branch (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (hss : wcpaDjSemistable q) (ξ : C) (hξ : closure {ξ} ∈ irreducibleComponents C) [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ) (hF : wcpaDjFF1 K (C.residueField ξ)) (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (V : ValuationSubring (C.residueField ξ)) (hV : wcpaDjNtV' K V) (b : Fin L.m) (c : C) (hctr : wcpaDjCtr L ξ V b c) (hnode : ¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) (θ : Derivation K (C.residueField ξ) (C.residueField ξ)) (hθ : ∀ (hb : ξ ∈ L.V b) (a : Γ(C, L.V b)), θ ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a) ∈ V.nonunits) (y : C.residueField ξ) (hy : wcpaDjValOrd V y = 1) : θ y ∈ V.nonunits :=
by
  classical
  have t_nu : ∀ (F : Type u) [Field F] (V : ValuationSubring F), (∀ x z : F, x ∈ V → z ∈ V.nonunits → x * z ∈ V.nonunits) ∧
      (∀ x z : F, x ∈ V.nonunits → z ∈ V.nonunits → x - z ∈ V.nonunits) ∧
      (∀ x z : F, x ∈ V.nonunits → z ∈ V.nonunits → x + z ∈ V.nonunits) ∧
      (∀ x : F, x ∈ V.nonunits → x ∈ V) ∧
      (∀ x : F, x ≠ 0 → x ∈ V.nonunits → x⁻¹ ∈ V → False) := by
    intro F _ V
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro x z hx hz
      rw [ValuationSubring.mem_nonunits_iff] at hz ⊢
      rw [Valuation.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' ((V.valuation_le_one_iff x).mpr hx)) hz
    · intro x z hx hz
      rw [ValuationSubring.mem_nonunits_iff] at hx hz ⊢
      exact lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt hx hz)
    · intro x z hx hz
      rw [ValuationSubring.mem_nonunits_iff] at hx hz ⊢
      exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hx hz)
    · intro x hx
      rw [ValuationSubring.mem_nonunits_iff] at hx
      exact (V.valuation_le_one_iff x).mp hx.le
    · intro x hx0 hx hxi
      have h1 : x⁻¹ * x ∈ V.nonunits := by
        rw [ValuationSubring.mem_nonunits_iff] at hx ⊢
        rw [Valuation.map_mul]
        exact lt_of_le_of_lt (mul_le_of_le_one_left' ((V.valuation_le_one_iff _).mpr hxi)) hx
      rw [inv_mul_cancel₀ hx0, ValuationSubring.mem_nonunits_iff, map_one] at h1
      exact lt_irrefl _ h1

  have t_s5 : ∀ (K : Type u) [CommRing K] (k : ℕ) (S R : Polynomial K), Polynomial.X ^ k ∣ S → Polynomial.X ^ (k + 1) ∣ R →
      Polynomial.X ^ (2 * k) ∣ S * Polynomial.derivative R - R * Polynomial.derivative S := by
    intro K _ k S R
    intro hS hR
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · simp
    · have hR' : (Polynomial.X : Polynomial K) ^ k ∣ Polynomial.derivative R := by
        have := Polynomial.pow_sub_one_dvd_derivative_of_pow_dvd hR
        simpa using this
      have hS' : (Polynomial.X : Polynomial K) ^ (k - 1) ∣ Polynomial.derivative S :=
        Polynomial.pow_sub_one_dvd_derivative_of_pow_dvd hS
      apply dvd_sub
      · rw [two_mul, pow_add]; exact mul_dvd_mul hS hR'
      · have e : 2 * k = (k + 1) + (k - 1) := by omega
        rw [e, pow_add]; exact mul_dvd_mul hR hS'

  have t_s9 : ∀ (F : Type u) [Field F] (V : ValuationSubring F) (y : F), y ∈ V.nonunits → y ≠ 0 →
      ∀ (u₁ u₂ : F) (m n M : ℕ), u₁ ≠ 0 → u₁ ∈ V → u₁⁻¹ ∈ V → u₂ ≠ 0 → u₂ ∈ V → u₂⁻¹ ∈ V →
      m < M → (∃ t ∈ V, u₁ * y ^ m - u₂ * y ^ n = t * y ^ M) → m = n := by
    intro F _ V y
    intro hy hy0 u₁ u₂ m n M _ h1V h1i _ h2V h2i hmM ⟨t, ht, h⟩
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    have hpow : ∀ j : ℕ, y ^ (j + 1) ∈ V.nonunits := by
      intro j
      rw [pow_succ]
      exact hmul _ _ (V.pow_mem (hV y hy) j) hy
    rcases lt_trichotomy m n with hmn | hmn | hmn
    · exfalso
      obtain ⟨a, rfl⟩ := Nat.exists_eq_add_of_lt hmn
      obtain ⟨b, rfl⟩ := Nat.exists_eq_add_of_lt hmM
      have e : y ^ m * (u₁ - (u₂ * y ^ (a + 1) + t * y ^ (b + 1))) = 0 := by
        linear_combination h
      have e2 : u₁ = u₂ * y ^ (a + 1) + t * y ^ (b + 1) := by
        have := (mul_eq_zero.mp e).resolve_left (pow_ne_zero _ hy0)
        linear_combination this
      exact hnot u₁ (by assumption) (e2 ▸ hadd _ _ (hmul _ _ h2V (hpow a)) (hmul _ _ ht (hpow b))) h1i
    · exact hmn
    · exfalso
      obtain ⟨a, rfl⟩ := Nat.exists_eq_add_of_lt hmn
      obtain ⟨b, hb⟩ := Nat.exists_eq_add_of_lt (lt_trans hmn hmM)
      subst hb
      have e : y ^ n * (u₂ - (u₁ * y ^ (a + 1) - t * y ^ (b + 1))) = 0 := by
        linear_combination -h
      have e2 : u₂ = u₁ * y ^ (a + 1) - t * y ^ (b + 1) := by
        have := (mul_eq_zero.mp e).resolve_left (pow_ne_zero _ hy0)
        linear_combination this
      exact hnot u₂ (by assumption) (e2 ▸ hsub _ _ (hmul _ _ h1V (hpow a)) (hmul _ _ ht (hpow b))) h2i

  have t_s4 : ∀ (K F : Type u) [Field K] [Field F] [Algebra K F] (V : ValuationSubring F), (∀ c : K, algebraMap K F c ∈ V) → ∀ β : F, β ∈ V.nonunits → ∀ R : Polynomial K, R ≠ 0 →
      ∃ w : F, w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧
        Polynomial.aeval β R = w * β ^ R.natTrailingDegree := by
    intro K F _ _ _ V
    intro hK β hβ R hR
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    have hdvd : (Polynomial.X : Polynomial K) ^ R.natTrailingDegree ∣ R := by
      rw [Polynomial.X_pow_dvd_iff]
      intro d hd
      exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hd
    obtain ⟨R1, hR1⟩ := hdvd
    have hc0 : R1.coeff 0 ≠ 0 := by
      have h1 := congrArg (fun P => Polynomial.coeff P R.natTrailingDegree) hR1
      rw [Polynomial.coeff_X_pow_mul', if_pos le_rfl, Nat.sub_self] at h1
      rw [← h1]
      exact mt Polynomial.trailingCoeff_eq_zero.mp hR
    obtain ⟨R2, hR2⟩ := Polynomial.X_dvd_sub_C (p := R1)
    have hmemV : ∀ P : Polynomial K, Polynomial.aeval β P ∈ V := by
      intro P
      rw [Polynomial.aeval_eq_sum_range]
      refine Subring.sum_mem V.toSubring (fun i _ => ?_)
      rw [Algebra.smul_def]
      exact V.mul_mem _ _ (hK _) (V.pow_mem (hV β hβ) i)
    have hw : Polynomial.aeval β R1 =
        algebraMap K F (R1.coeff 0) + β * Polynomial.aeval β R2 := by
      have : R1 = Polynomial.C (R1.coeff 0) + Polynomial.X * R2 := by
        rw [← hR2]; ring
      conv_lhs => rw [this]
      simp
    have hκ0 : algebraMap K F (R1.coeff 0) ≠ 0 := (map_ne_zero _).mpr hc0
    have hκi : (algebraMap K F (R1.coeff 0))⁻¹ ∈ V := by
      rw [← map_inv₀]; exact hK _

    have hn : β * Polynomial.aeval β R2 ∈ V.nonunits := by
      rw [mul_comm]; exact hmul _ _ (hmemV R2) hβ
    set κ := algebraMap K F (R1.coeff 0)
    set w := Polynomial.aeval β R1 with hwdef
    have hwV : w ∈ V := hmemV R1
    have hκv : V.valuation κ = 1 := by
      have h1 := (V.valuation_le_one_iff _).mpr (hK (R1.coeff 0))
      by_contra h
      exact hnot κ hκ0 (V.mem_nonunits_iff.mpr (lt_of_le_of_ne h1 h)) hκi
    have hwv : V.valuation w = 1 := by
      rw [hw, Valuation.map_add_eq_of_lt_left]
      · exact hκv
      · rw [hκv]; exact V.mem_nonunits_iff.mp hn
    have hw0 : w ≠ 0 := by
      intro h; rw [h, map_zero] at hwv; exact zero_ne_one hwv
    refine ⟨w, hw0, hwV, ?_, ?_⟩
    · rw [← V.valuation_le_one_iff, map_inv₀, hwv, inv_one]
    · conv_lhs => rw [hR1]
      rw [map_mul, map_pow, Polynomial.aeval_X, mul_comm]

  have t_Z : ∀ (F : Type u) [Field F] (V : ValuationSubring F) (y : F) (hy : y ∈ V.nonunits) (hy0 : y ≠ 0), ∀ (u t : F) (m M : ℕ), u ≠ 0 → u⁻¹ ∈ V → t ∈ V → m < M →
      u * y ^ m = t * y ^ M → False := by
    intro F _ V y hy hy0
    intro u t m M hu hui ht hmM h
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    obtain ⟨b, rfl⟩ := Nat.exists_eq_add_of_lt hmM
    have e : y ^ m * (u - t * y ^ (b + 1)) = 0 := by linear_combination h
    have e2 : u = t * y ^ (b + 1) := by
      have := (mul_eq_zero.mp e).resolve_left (pow_ne_zero _ hy0)
      linear_combination this
    have hp : y ^ (b + 1) ∈ V.nonunits := by
      rw [pow_succ]; exact hmul _ _ (V.pow_mem (hV y hy) b) hy
    exact hnot u hu (e2 ▸ hmul _ _ ht hp) hui

  have t_s10 : ∀ (K F O : Type u) [Field K] [Field F] [Algebra K F] [CommRing O] [IsLocalRing O] (V : ValuationSubring F) (y : F) (ι : O →+* F) (θ : Derivation K F F), y ∈ V →
      (∀ o, ι o ∈ V) → (∀ o ∈ IsLocalRing.maximalIdeal O, ∃ t ∈ V, ι o = t * y) →
      (∀ o, ∃ t ∈ V, θ (ι o) = t * y) → ∀ (k : ℕ) (m : O),
      m ∈ IsLocalRing.maximalIdeal O ^ k →
      (∃ t ∈ V, ι m = t * y ^ k) ∧ (∃ t ∈ V, θ (ι m) = t * y ^ k) := by
    intro K F O _ _ _ _ _ V y ι θ
    intro hyV hιV hι𝔪 hθι k
    induction k with
    | zero =>
      intro m _
      obtain ⟨t, ht, h⟩ := hθι m
      exact ⟨⟨ι m, hιV m, by simp⟩, ⟨t * y, V.mul_mem _ _ ht hyV, by simp [h]⟩⟩
    | succ k ih =>
      intro m hm
      rw [pow_succ] at hm
      refine Submodule.mul_induction_on hm ?_ ?_
      · intro a ha b hb
        obtain ⟨⟨t1, ht1, h1⟩, ⟨t2, ht2, h2⟩⟩ := ih a ha
        obtain ⟨t3, ht3, h3⟩ := hι𝔪 b hb
        obtain ⟨t4, ht4, h4⟩ := hθι b
        refine ⟨⟨t1 * t3, V.mul_mem _ _ ht1 ht3, ?_⟩, ⟨t1 * t4 + t3 * t2,
          V.add_mem _ _ (V.mul_mem _ _ ht1 ht4) (V.mul_mem _ _ ht3 ht2), ?_⟩⟩
        · rw [map_mul, h1, h3]; ring
        · rw [map_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul, h2, h4, h1, h3]; ring
      · intro a b ha hb
        obtain ⟨⟨t1, ht1, h1⟩, ⟨t2, ht2, h2⟩⟩ := ha
        obtain ⟨⟨t3, ht3, h3⟩, ⟨t4, ht4, h4⟩⟩ := hb
        refine ⟨⟨t1 + t3, V.add_mem _ _ ht1 ht3, ?_⟩, ⟨t2 + t4, V.add_mem _ _ ht2 ht4, ?_⟩⟩
        · rw [map_add, h1, h3]; ring
        · rw [map_add, map_add, h2, h4]; ring

  have t_s6 : ∀ (K F : Type u) [Field K] [Field F] [Algebra K F] (V : ValuationSubring F) (y : F), y ∈ V.nonunits → y ≠ 0 → (∀ x ∈ V, x ≠ 0 → ∃ (n : ℕ) (w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ x = w * y ^ n) → (∀ c : K, algebraMap K F c ∈ V) → (∀ β : F, β ∈ V.nonunits → ∀ R : Polynomial K, R ≠ 0 → ∃ w : F, w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ Polynomial.aeval β R = w * β ^ R.natTrailingDegree) → (∀ (u₁ u₂ : F) (m n M : ℕ), u₁ ≠ 0 → u₁ ∈ V → u₁⁻¹ ∈ V → u₂ ≠ 0 → u₂ ∈ V → u₂⁻¹ ∈ V → m < M → (∃ t ∈ V, u₁ * y ^ m - u₂ * y ^ n = t * y ^ M) → m = n) → ∀ α : F, α ∈ V.nonunits → ∀ (B wB : F) (c : ℕ), wB ≠ 0 → wB ∈ V → wB⁻¹ ∈ V → B = wB * y ^ c → ∀ (T₁ T₂ : Polynomial K), (∃ t ∈ V, y * B - Polynomial.aeval α T₁ = t * y ^ (c + 2)) → (∃ t ∈ V, B - Polynomial.aeval α T₂ = t * y ^ (c + 2)) → ∃ w : F, w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ α = w * y := by
    intro K F _ _ _ V y hy hy0 hDEC hK H4 H9 α hα B wB c hwB0 hwBV hwBi hB T₁ T₂ hT1 hT2
    obtain ⟨t1, ht1, h1⟩ := hT1
    obtain ⟨t2, ht2, h2⟩ := hT2
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    subst hB
    have hZ := t_Z F V y hy hy0

    have hU : ∀ u v : F, u ≠ 0 → u ∈ V → u⁻¹ ∈ V → v ≠ 0 → v ∈ V → v⁻¹ ∈ V →
        u * v ≠ 0 ∧ u * v ∈ V ∧ (u * v)⁻¹ ∈ V := by
      intro u v hu0 huV hui hv0 hvV hvi
      refine ⟨mul_ne_zero hu0 hv0, V.mul_mem _ _ huV hvV, ?_⟩
      rw [mul_inv]; exact V.mul_mem _ _ hui hvi
    have hUp : ∀ (u : F) (k : ℕ), u ≠ 0 → u ∈ V → u⁻¹ ∈ V →
        u ^ k ≠ 0 ∧ u ^ k ∈ V ∧ (u ^ k)⁻¹ ∈ V := by
      intro u k hu0 huV hui
      refine ⟨pow_ne_zero _ hu0, V.pow_mem huV k, ?_⟩
      rw [← inv_pow]; exact V.pow_mem hui k
    have hT1ne : T₁ ≠ 0 := by
      rintro rfl
      rw [map_zero, sub_zero] at h1
      exact hZ wB t1 (c + 1) (c + 2) hwB0 hwBi ht1 (by omega) (by rw [← h1]; ring)
    have hT2ne : T₂ ≠ 0 := by
      rintro rfl
      rw [map_zero, sub_zero] at h2
      exact hZ wB t2 c (c + 2) hwB0 hwBi ht2 (by omega) h2
    obtain ⟨w1, hw10, hw1V, hw1i, hw1⟩ := H4 α hα T₁ hT1ne
    obtain ⟨w2, hw20, hw2V, hw2i, hw2⟩ := H4 α hα T₂ hT2ne
    have hα0 : α ≠ 0 := by
      intro hα0
      rw [hα0] at hw1 h1
      rcases Nat.eq_zero_or_pos T₁.natTrailingDegree with hk | hk
      · rw [hk, pow_zero, mul_one] at hw1
        have := H9 wB w1 (c + 1) 0 (c + 2) hwB0 hwBV hwBi hw10 hw1V hw1i (by omega)
          ⟨t1, ht1, by rw [← h1, hw1]; ring⟩
        omega
      · rw [zero_pow (by omega), mul_zero] at hw1
        rw [hw1, sub_zero] at h1
        exact hZ wB t1 (c + 1) (c + 2) hwB0 hwBi ht1 (by omega) (by rw [← h1]; ring)
    obtain ⟨e, wα, hwα0, hwαV, hwαi, hαe⟩ := hDEC α (hV α hα) hα0
    have he : e ≠ 0 := by
      rintro rfl
      rw [pow_zero, mul_one] at hαe
      exact hnot α hα0 hα (hαe ▸ hwαi)
    have hp : ∀ (w : F) (k : ℕ), w * α ^ k = (w * wα ^ k) * y ^ (e * k) := by
      intro w k; rw [hαe, mul_pow, pow_mul]; ring
    obtain ⟨hu10, hu1V, hu1i⟩ := hU w1 (wα ^ T₁.natTrailingDegree) hw10 hw1V hw1i
      (hUp wα _ hwα0 hwαV hwαi).1 (hUp wα _ hwα0 hwαV hwαi).2.1 (hUp wα _ hwα0 hwαV hwαi).2.2
    obtain ⟨hu20, hu2V, hu2i⟩ := hU w2 (wα ^ T₂.natTrailingDegree) hw20 hw2V hw2i
      (hUp wα _ hwα0 hwαV hwαi).1 (hUp wα _ hwα0 hwαV hwαi).2.1 (hUp wα _ hwα0 hwαV hwαi).2.2
    have e1 := H9 wB _ (c + 1) (e * T₁.natTrailingDegree) (c + 2) hwB0 hwBV hwBi hu10 hu1V hu1i
      (by omega) ⟨t1, ht1, by rw [← h1, hw1, hp]; ring⟩
    have e2 := H9 wB _ c (e * T₂.natTrailingDegree) (c + 2) hwB0 hwBV hwBi hu20 hu2V hu2i
      (by omega) ⟨t2, ht2, by rw [← h2, hw2, hp]⟩
    have hd : e ∣ 1 := by
      have : e * T₁.natTrailingDegree = e * T₂.natTrailingDegree + 1 := by omega
      exact (Nat.dvd_add_right (dvd_mul_right e _)).mp (this ▸ dvd_mul_right e _)
    have he1 : e = 1 := Nat.dvd_one.mp hd
    rw [he1, pow_one] at hαe
    exact ⟨wα, hwα0, hwαV, hwαi, hαe⟩

  have t_aevalV : ∀ (K F : Type u) [Field K] [Field F] [Algebra K F] (V : ValuationSubring F) (hK : ∀ c : K, algebraMap K F c ∈ V) (β : F) (hβ : β ∈ V) (P : Polynomial K), Polynomial.aeval β P ∈ V := by
    intro K F _ _ _ V hK β hβ P
    rw [Polynomial.aeval_eq_sum_range]
    refine Subring.sum_mem V.toSubring (fun i _ => ?_)
    rw [Algebra.smul_def]
    exact V.mul_mem _ _ (hK _) (V.pow_mem hβ i)

  have t_ntd_dvd : ∀ (K : Type u) [Field K] (R : Polynomial K) (k : ℕ) (h : R.natTrailingDegree = k), Polynomial.X ^ k ∣ R := by
    intro K _ R k h
    rw [Polynomial.X_pow_dvd_iff]
    intro d hd
    exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (h ▸ hd)

  have t_s8 : ∀ (K F : Type u) [Field K] [Field F] [Algebra K F] (V : ValuationSubring F) (y : F), y ∈ V.nonunits → y ≠ 0 → (∀ x ∈ V, x ≠ 0 → ∃ (n : ℕ) (w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ x = w * y ^ n) → (∀ c : K, algebraMap K F c ∈ V) → (∀ β : F, β ∈ V.nonunits → ∀ R : Polynomial K, R ≠ 0 → ∃ w : F, w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ Polynomial.aeval β R = w * β ^ R.natTrailingDegree) → (∀ (k : ℕ) (S R : Polynomial K), Polynomial.X ^ k ∣ S → Polynomial.X ^ (k + 1) ∣ R → Polynomial.X ^ (2 * k) ∣ S * Polynomial.derivative R - R * Polynomial.derivative S) → (∀ (u₁ u₂ : F) (m n M : ℕ), u₁ ≠ 0 → u₁ ∈ V → u₁⁻¹ ∈ V → u₂ ≠ 0 → u₂ ∈ V → u₂⁻¹ ∈ V → m < M → (∃ t ∈ V, u₁ * y ^ m - u₂ * y ^ n = t * y ^ M) → m = n) → ∀ (θ : Derivation K F F) (a b wb : F) (c : ℕ), wb ≠ 0 → wb ∈ V → wb⁻¹ ∈ V → b = wb * y ^ c → y = a * b⁻¹ → ∀ (β w : F), w ≠ 0 → w ∈ V → w⁻¹ ∈ V → β = w * y → θ β ∈ V.nonunits → ∀ (Ra Rb : Polynomial K), (∃ t ∈ V, a - Polynomial.aeval β Ra = t * y ^ (2 * c + 2)) → (∃ t ∈ V, θ a - Polynomial.aeval β (Polynomial.derivative Ra) * θ β = t * y ^ (2 * c + 2)) → (∃ t ∈ V, b - Polynomial.aeval β Rb = t * y ^ (2 * c + 2)) → (∃ t ∈ V, θ b - Polynomial.aeval β (Polynomial.derivative Rb) * θ β = t * y ^ (2 * c + 2)) → θ y ∈ V.nonunits := by
    intro K F _ _ _ V y hy hy0 hDEC hK H4 H5 H9 θ a b wb c hwb0 hwbV hwbi hb hya β w hw0 hwV hwi hβ hθβ Ra Rb ⟨t1, ht1, e1⟩ ⟨t3, ht3, e2⟩ ⟨t2, ht2, e3⟩ ⟨t4, ht4, e4⟩
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    have hZ := t_Z F V y hy hy0
    have hyV : y ∈ V := hV y hy
    have hb0 : b ≠ 0 := by rw [hb]; exact mul_ne_zero hwb0 (pow_ne_zero _ hy0)
    have ha : a = wb * y ^ (c + 1) := by
      have : a = y * b := by rw [hya, mul_assoc, inv_mul_cancel₀ hb0, mul_one]
      rw [this, hb]; ring
    have hβn : β ∈ V.nonunits := by rw [hβ]; exact hmul _ _ hwV hy
    have hβV : β ∈ V := hV β hβn
    have hAV := t_aevalV K F V hK β hβV
    have hUp : ∀ (u : F) (k : ℕ), u ≠ 0 → u ∈ V → u⁻¹ ∈ V →
        u ^ k ≠ 0 ∧ u ^ k ∈ V ∧ (u ^ k)⁻¹ ∈ V := by
      intro u k hu0 huV hui
      refine ⟨pow_ne_zero _ hu0, V.pow_mem huV k, ?_⟩
      rw [← inv_pow]; exact V.pow_mem hui k
    have hU : ∀ u v : F, u ≠ 0 → u ∈ V → u⁻¹ ∈ V → v ≠ 0 → v ∈ V → v⁻¹ ∈ V →
        u * v ≠ 0 ∧ u * v ∈ V ∧ (u * v)⁻¹ ∈ V := by
      intro u v hu0 huV hui hv0 hvV hvi
      refine ⟨mul_ne_zero hu0 hv0, V.mul_mem _ _ huV hvV, ?_⟩
      rw [mul_inv]; exact V.mul_mem _ _ hui hvi
    have hpβ : ∀ (u : F) (k : ℕ), u * β ^ k = (u * w ^ k) * y ^ k := by
      intro u k; rw [hβ, mul_pow]; ring

    have hRb0 : Rb ≠ 0 := by
      rintro rfl
      rw [map_zero, sub_zero, hb] at e3
      exact hZ wb t2 c (2 * c + 2) hwb0 hwbi ht2 (by omega) e3
    have hRa0 : Ra ≠ 0 := by
      rintro rfl
      rw [map_zero, sub_zero, ha] at e1
      exact hZ wb t1 (c + 1) (2 * c + 2) hwb0 hwbi ht1 (by omega) e1
    obtain ⟨ub, hub0, hubV, hubi, hub⟩ := H4 β hβn Rb hRb0
    obtain ⟨ua, hua0, huaV, huai, hua⟩ := H4 β hβn Ra hRa0
    have hkb : c = Rb.natTrailingDegree := by
      have hw' := hUp w Rb.natTrailingDegree hw0 hwV hwi
      obtain ⟨h0, h1, h2⟩ := hU ub _ hub0 hubV hubi hw'.1 hw'.2.1 hw'.2.2
      exact H9 wb _ c _ (2 * c + 2) hwb0 hwbV hwbi h0 h1 h2 (by omega)
        ⟨t2, ht2, by rw [← e3, hub, hpβ, hb]⟩
    have hka : c + 1 = Ra.natTrailingDegree := by
      have hw' := hUp w Ra.natTrailingDegree hw0 hwV hwi
      obtain ⟨h0, h1, h2⟩ := hU ua _ hua0 huaV huai hw'.1 hw'.2.1 hw'.2.2
      exact H9 wb _ (c + 1) _ (2 * c + 2) hwb0 hwbV hwbi h0 h1 h2 (by omega)
        ⟨t1, ht1, by rw [← e1, hua, hpβ, ha]⟩
    obtain ⟨W1, hW1⟩ := H5 c Rb Ra (t_ntd_dvd K Rb c hkb.symm) (t_ntd_dvd K Ra (c + 1) hka.symm)
    have eW : Polynomial.aeval β Rb * Polynomial.aeval β (Polynomial.derivative Ra) -
        Polynomial.aeval β Ra * Polynomial.aeval β (Polynomial.derivative Rb) =
        w ^ (2 * c) * y ^ (2 * c) * Polynomial.aeval β W1 := by
      have := congrArg (Polynomial.aeval β) hW1
      simp only [map_sub, map_mul, map_pow, Polynomial.aeval_X] at this
      rw [this, hβ, mul_pow]
    set A := Polynomial.aeval β Ra
    set A' := Polynomial.aeval β (Polynomial.derivative Ra)
    set B0 := Polynomial.aeval β Rb
    set B0' := Polynomial.aeval β (Polynomial.derivative Rb)
    set X1 := Polynomial.aeval β W1
    set G := B0 * t3 + t2 * A' * θ β + t2 * t3 * y ^ (2 * c + 2) - A * t4 - t1 * B0' * θ β -
      t1 * t4 * y ^ (2 * c + 2) with hG
    have hθβV : θ β ∈ V := hV _ hθβ
    have hGV : G ∈ V := by
      have hyM : y ^ (2 * c + 2) ∈ V := V.pow_mem hyV _
      refine V.sub_mem (V.sub_mem (V.sub_mem (V.add_mem _ _ (V.add_mem _ _ ?_ ?_) ?_) ?_) ?_) ?_
      · exact V.mul_mem _ _ (hAV _) ht3
      · exact V.mul_mem _ _ (V.mul_mem _ _ ht2 (hAV _)) hθβV
      · exact V.mul_mem _ _ (V.mul_mem _ _ ht2 ht3) hyM
      · exact V.mul_mem _ _ (hAV _) ht4
      · exact V.mul_mem _ _ (V.mul_mem _ _ ht1 (hAV _)) hθβV
      · exact V.mul_mem _ _ (V.mul_mem _ _ ht1 ht4) hyM
    have hnum : b * θ a - a * θ b = y ^ (2 * c) * (w ^ (2 * c) * X1 * θ β + y ^ 2 * G) := by
      rw [hG]
      linear_combination (θ a) * e3 - (θ b) * e1 + (B0 + t2 * y ^ (2 * c + 2)) * e2 -
        (A + t1 * y ^ (2 * c + 2)) * e4 + θ β * eW
    have hθy : θ y = (b * θ a - a * θ b) * (b ^ 2)⁻¹ := by
      rw [hya, Derivation.leibniz, Derivation.leibniz_inv, smul_eq_mul, smul_eq_mul, smul_eq_mul]
      field_simp
      ring
    have hfin : θ y = (wb ^ 2)⁻¹ * (w ^ (2 * c) * X1 * θ β + y ^ 2 * G) := by
      rw [hθy, hnum, hb]
      field_simp
      ring
    rw [hfin]
    refine hmul _ _ ?_ (hadd _ _ (hmul _ _ (V.mul_mem _ _ (V.pow_mem hwV _) (hAV _)) hθβ) ?_)
    · rw [← inv_pow]; exact V.pow_mem hwbi 2
    · rw [pow_two, mul_assoc]; exact hmul _ _ hyV (by rw [mul_comm]; exact hmul _ _ hGV hy)

  have t_ievalx : ∀ (K F O : Type u) [Field K] [Field F] [Algebra K F] [CommRing O] (φ : K →+* O) (ι : O →+* F) (hιφ : ι.comp φ = algebraMap K F) (P : Polynomial K) (x : O), ι (P.eval₂ φ x) = Polynomial.aeval (ι x) P := by
    intro K F O _ _ _ _ φ ι hιφ P x
    rw [Polynomial.hom_eval₂, hιφ, ← Polynomial.aeval_def]

  have t_split : ∀ (K F O : Type u) [Field K] [Field F] [Algebra K F] [CommRing O] (φ : K →+* O) (ι : O →+* F) (hιφ : ι.comp φ = algebraMap K F) (r x z : O) (lam : K) (P Q : Polynomial K), ι r = Polynomial.aeval (ι x) (Polynomial.C lam + Polynomial.X * P) +
        ι z * Polynomial.aeval (ι z) Q +
        ι (r - φ lam - x * P.eval₂ φ x - z * Q.eval₂ φ z) := by
    intro K F O _ _ _ _ φ ι hιφ r x z lam P Q
    have hφ : ι (φ lam) = algebraMap K F lam := by
      rw [← RingHom.comp_apply, hιφ]
    simp only [map_sub, map_mul, map_add, t_ievalx K F O φ ι hιφ, hφ, Polynomial.aeval_C,
      Polynomial.aeval_X]
    ring

  have t_key : ∀ (K F O : Type u) [Field K] [Field F] [Algebra K F] [CommRing O] [IsLocalRing O] (V : ValuationSubring F) (y : F) (hy : y ∈ V.nonunits) (hy0 : y ≠ 0) (H6 : ∀ α : F, α ∈ V.nonunits → ∀ (B wB : F) (c : ℕ), wB ≠ 0 → wB ∈ V → wB⁻¹ ∈ V →
        B = wB * y ^ c → ∀ (T₁ T₂ : Polynomial K),
        (∃ t ∈ V, y * B - Polynomial.aeval α T₁ = t * y ^ (c + 2)) →
        (∃ t ∈ V, B - Polynomial.aeval α T₂ = t * y ^ (c + 2)) →
        ∃ w : F, w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ α = w * y) (φ : K →+* O) (ι : O →+* F) (hιφ : ι.comp φ = algebraMap K F) (hιV : ∀ o, ι o ∈ V) (hι𝔪 : ∀ o ∈ IsLocalRing.maximalIdeal O, ι o ∈ V.nonunits) (θ : Derivation K F F) (hθι : ∀ o, θ (ι o) ∈ V.nonunits) (PB : ∀ (k : ℕ) (m : O), m ∈ IsLocalRing.maximalIdeal O ^ k →
        (∃ t ∈ V, ι m = t * y ^ k) ∧ (∃ t ∈ V, θ (ι m) = t * y ^ k)) (N c : ℕ) (a b : O) (wB : F) (hwB0 : wB ≠ 0) (hwBV : wB ∈ V) (hwBi : wB⁻¹ ∈ V) (hb : ι b = wB * y ^ c) (hab : ι a = y * ι b) (x z : O) (hx : x ∈ IsLocalRing.maximalIdeal O) (hzdeep : ∃ t ∈ V, ι z = t * y ^ (c + 2)) (hxz : x * z ∈ IsLocalRing.maximalIdeal O ^ (N + 2 * c + 2 + 1)) (hdec : ∀ r : O, ∃ (lam : K) (P Q : Polynomial K),
        r - φ lam - x * P.eval₂ φ x - z * Q.eval₂ φ z ∈ IsLocalRing.maximalIdeal O ^ (N + 2 * c + 2)), ∃ (β w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ β = w * y ∧ θ β ∈ V.nonunits ∧
        ∀ o : O, ∃ R : Polynomial K, (∃ t ∈ V, ι o - Polynomial.aeval β R = t * y ^ N) ∧
          (∃ t ∈ V, θ (ι o) - Polynomial.aeval β (Polynomial.derivative R) * θ β = t * y ^ N) := by
    intro K F O _ _ _ _ _ V y hy hy0 H6 φ ι hιφ hιV hι𝔪 θ hθι PB N c a b wB hwB0 hwBV hwBi hb hab x z hx hzdeep hxz hdec
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    have hyV : y ∈ V := hV y hy
    set N' := N + 2 * c + 2 with hN'
    obtain ⟨tz, htz, hz⟩ := hzdeep
    have hAV : ∀ (β : F), β ∈ V → ∀ P : Polynomial K, Polynomial.aeval β P ∈ V := by
      intro β hβ P
      rw [Polynomial.aeval_eq_sum_range]
      refine Subring.sum_mem V.toSubring (fun i _ => ?_)
      rw [Algebra.smul_def]
      have hK : algebraMap K F (P.coeff i) ∈ V := by
        rw [← hιφ, RingHom.comp_apply]; exact hιV _
      exact V.mul_mem _ _ hK (V.pow_mem hβ i)

    have happ : ∀ r : O, ∃ T : Polynomial K, ∃ t ∈ V,
        ι r - Polynomial.aeval (ι x) T = t * y ^ (c + 2) := by
      intro r
      obtain ⟨lam, P, Q, hm⟩ := hdec r
      obtain ⟨⟨tm, htm, hm'⟩, -⟩ := PB _ _ hm
      refine ⟨Polynomial.C lam + Polynomial.X * P,
        tz * Polynomial.aeval (ι z) Q + tm * y ^ (N + c), ?_, ?_⟩
      · exact V.add_mem _ _ (V.mul_mem _ _ htz (hAV _ (hιV z) Q))
          (V.mul_mem _ _ htm (V.pow_mem hyV _))
      · rw [t_split K F O φ ι hιφ r x z lam P Q, hm', hz]
        have : N' = (N + c) + (c + 2) := by omega
        rw [this, pow_add]; ring
    obtain ⟨T₁, t1, ht1, h1⟩ := happ a
    obtain ⟨T₂, t2, ht2, h2⟩ := happ b
    have hxn : ι x ∈ V.nonunits := hι𝔪 x hx
    obtain ⟨w, hw0, hwV, hwi, hxw⟩ := H6 (ι x) hxn (ι b) wB c hwB0 hwBV hwBi hb T₁ T₂
      ⟨t1, ht1, by rw [← hab]; exact h1⟩ ⟨t2, ht2, h2⟩
    refine ⟨ι x, w, hw0, hwV, hwi, hxw, hθι x, ?_⟩

    obtain ⟨⟨t0, ht0, h0⟩, ⟨t3, ht3, h3⟩⟩ := PB _ _ hxz
    obtain ⟨-, ⟨t4, ht4, h4⟩⟩ := PB 1 x (by rw [pow_one]; exact hx)
    have hwy0 : w * y ≠ 0 := mul_ne_zero hw0 hy0
    have hww : w * w⁻¹ = 1 := mul_inv_cancel₀ hw0
    rw [map_mul] at h0
    rw [map_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul] at h3
    have hZ : ι z = (w⁻¹ * t0) * y ^ N' := by
      have : w * y * (ι z - (w⁻¹ * t0) * y ^ N') = 0 := by
        linear_combination h0 - ι z * hxw - t0 * y ^ (N' + 1) * hww
      have := (mul_eq_zero.mp this).resolve_left hwy0
      linear_combination this
    have hZ' : θ (ι z) = (w⁻¹ * (t3 - w⁻¹ * t0 * t4)) * y ^ N' := by
      have : w * y * (θ (ι z) - (w⁻¹ * (t3 - w⁻¹ * t0 * t4)) * y ^ N') = 0 := by
        linear_combination h3 - θ (ι z) * hxw - θ (ι x) * hZ - w⁻¹ * t0 * y ^ N' * h4 +
          (w⁻¹ * t0 * t4 - t3) * y ^ (N' + 1) * hww
      have := (mul_eq_zero.mp this).resolve_left hwy0
      linear_combination this
    have hZV : w⁻¹ * t0 ∈ V := V.mul_mem _ _ hwi ht0
    have hZ'V : w⁻¹ * (t3 - w⁻¹ * t0 * t4) ∈ V :=
      V.mul_mem _ _ hwi (V.sub_mem ht3 (V.mul_mem _ _ hZV ht4))
    have hpN : y ^ N' = y ^ (2 * c + 2) * y ^ N := by
      rw [← pow_add]; congr 1; omega
    intro o
    obtain ⟨lam, P, Q, hm⟩ := hdec o
    obtain ⟨⟨tm, htm, hm1⟩, ⟨tm', htm', hm2⟩⟩ := PB _ _ hm
    have hsplit := t_split K F O φ ι hιφ o x z lam P Q
    set m := o - φ lam - x * P.eval₂ φ x - z * Q.eval₂ φ z with hmdef
    refine ⟨Polynomial.C lam + Polynomial.X * P, ⟨(w⁻¹ * t0 * Polynomial.aeval (ι z) Q + tm) *
      y ^ (2 * c + 2), ?_, ?_⟩, ⟨(w⁻¹ * t0 * Polynomial.aeval (ι z) (Polynomial.derivative Q) *
        θ (ι z) + Polynomial.aeval (ι z) Q * (w⁻¹ * (t3 - w⁻¹ * t0 * t4)) + tm') *
          y ^ (2 * c + 2), ?_, ?_⟩⟩
    · exact V.mul_mem _ _ (V.add_mem _ _ (V.mul_mem _ _ hZV (hAV _ (hιV z) Q)) htm)
        (V.pow_mem hyV _)
    · linear_combination hsplit + Polynomial.aeval (ι z) Q * hZ + hm1 +
        (w⁻¹ * t0 * Polynomial.aeval (ι z) Q + tm) * hpN
    · refine V.mul_mem _ _ (V.add_mem _ _ (V.add_mem _ _ ?_ ?_) htm') (V.pow_mem hyV _)
      · exact V.mul_mem _ _ (V.mul_mem _ _ hZV (hAV _ (hιV z) _)) (hV _ (hθι z))
      · exact V.mul_mem _ _ (hAV _ (hιV z) Q) hZ'V
    · rw [hsplit, map_add, map_add, Derivation.leibniz, Derivation.map_aeval,
        Derivation.map_aeval]
      simp only [smul_eq_mul]
      linear_combination (Polynomial.aeval (ι z) (Polynomial.derivative Q) * θ (ι z)) * hZ +
        Polynomial.aeval (ι z) Q * hZ' + hm2 +
        (w⁻¹ * t0 * Polynomial.aeval (ι z) (Polynomial.derivative Q) * θ (ι z) +
          Polynomial.aeval (ι z) Q * (w⁻¹ * (t3 - w⁻¹ * t0 * t4)) + tm') * hpN

  have t_s7 : ∀ (K F O : Type u) [Field K] [Field F] [Algebra K F] [CommRing O] [IsLocalRing O] (V : ValuationSubring F) (y : F) (hy : y ∈ V.nonunits) (hy0 : y ≠ 0) (hDEC : ∀ x ∈ V, x ≠ 0 → ∃ (n : ℕ) (w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ x = w * y ^ n) (H6 : ∀ α : F, α ∈ V.nonunits → ∀ (B wB : F) (c : ℕ), wB ≠ 0 → wB ∈ V → wB⁻¹ ∈ V →
        B = wB * y ^ c → ∀ (T₁ T₂ : Polynomial K),
        (∃ t ∈ V, y * B - Polynomial.aeval α T₁ = t * y ^ (c + 2)) →
        (∃ t ∈ V, B - Polynomial.aeval α T₂ = t * y ^ (c + 2)) →
        ∃ w : F, w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ α = w * y) (φ : K →+* O) (ι : O →+* F) (hιφ : ι.comp φ = algebraMap K F) (hιV : ∀ o, ι o ∈ V) (hι𝔪 : ∀ o ∈ IsLocalRing.maximalIdeal O, ι o ∈ V.nonunits) (TRUNC : ∀ N : ℕ, ∃ x z : O, x ∈ IsLocalRing.maximalIdeal O ∧ z ∈ IsLocalRing.maximalIdeal O ∧
        x * z ∈ IsLocalRing.maximalIdeal O ^ (N + 1) ∧ ∀ r : O, ∃ (lam : K) (P Q : Polynomial K),
        r - φ lam - x * P.eval₂ φ x - z * Q.eval₂ φ z ∈ IsLocalRing.maximalIdeal O ^ N) (θ : Derivation K F F) (hθι : ∀ o, θ (ι o) ∈ V.nonunits) (PB : ∀ (k : ℕ) (m : O), m ∈ IsLocalRing.maximalIdeal O ^ k →
        (∃ t ∈ V, ι m = t * y ^ k) ∧ (∃ t ∈ V, θ (ι m) = t * y ^ k)) (N c : ℕ) (a b : O) (wB : F) (hwB0 : wB ≠ 0) (hwBV : wB ∈ V) (hwBi : wB⁻¹ ∈ V) (hb : ι b = wB * y ^ c) (hab : ι a = y * ι b), ∃ (β w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ β = w * y ∧ θ β ∈ V.nonunits ∧
        ∀ o : O, ∃ R : Polynomial K, (∃ t ∈ V, ι o - Polynomial.aeval β R = t * y ^ N) ∧
          (∃ t ∈ V, θ (ι o) - Polynomial.aeval β (Polynomial.derivative R) * θ β = t * y ^ N) := by
    intro K F O _ _ _ _ _ V y hy hy0 hDEC H6 φ ι hιφ hιV hι𝔪 TRUNC θ hθι PB N c a b wB hwB0 hwBV hwBi hb hab
    obtain ⟨hmul, hsub, hadd, hV, hnot⟩ := t_nu F V
    obtain ⟨x, z, hx, hz, hxz, hdec⟩ := TRUNC (N + 2 * c + 2)
    obtain ⟨⟨t0, ht0, h0⟩, -⟩ := PB _ _ hxz
    rw [map_mul] at h0
    have hcase : (∃ t ∈ V, ι z = t * y ^ (c + 2)) ∨ (∃ t ∈ V, ι x = t * y ^ (c + 2)) := by
      by_cases hz0 : ι z = 0
      · exact Or.inl ⟨0, V.zero_mem, by rw [hz0, zero_mul]⟩
      obtain ⟨n, wz, hwz0, hwzV, hwzi, hzn⟩ := hDEC (ι z) (hιV z) hz0
      by_cases hn : c + 2 ≤ n
      · refine Or.inl ⟨wz * y ^ (n - (c + 2)), V.mul_mem _ _ hwzV (V.pow_mem (hV y hy) _), ?_⟩
        rw [hzn, mul_assoc, ← pow_add]; congr 2; omega
      · right
        refine ⟨wz⁻¹ * t0 * y ^ (N + 2 * c + 2 + 1 - n - (c + 2)),
          V.mul_mem _ _ (V.mul_mem _ _ hwzi ht0) (V.pow_mem (hV y hy) _), ?_⟩
        have hyn : y ^ n ≠ 0 := pow_ne_zero _ hy0
        have e : y ^ (N + 2 * c + 2 + 1) = y ^ n * (y ^ (N + 2 * c + 2 + 1 - n - (c + 2)) *
            y ^ (c + 2)) := by
          rw [← pow_add, ← pow_add]; congr 1; omega
        rw [hzn, e] at h0
        have : (wz * y ^ n) * (ι x - wz⁻¹ * t0 * y ^ (N + 2 * c + 2 + 1 - n - (c + 2)) *
            y ^ (c + 2)) = 0 := by
          have hww : wz * wz⁻¹ = 1 := mul_inv_cancel₀ hwz0
          linear_combination h0 - t0 * (y ^ n * (y ^ (N + 2 * c + 2 + 1 - n - (c + 2)) *
            y ^ (c + 2))) * hww
        have := (mul_eq_zero.mp this).resolve_left (mul_ne_zero hwz0 hyn)
        linear_combination this
    rcases hcase with hzd | hxd
    · exact t_key K F O V y hy hy0 H6 φ ι hιφ hιV hι𝔪 θ hθι PB N c a b wB hwB0 hwBV hwBi hb hab
        x z hx hzd hxz hdec
    · refine t_key K F O V y hy hy0 H6 φ ι hιφ hιV hι𝔪 θ hθι PB N c a b wB hwB0 hwBV hwBi hb hab
        z x hz hxd (by rw [mul_comm z x]; exact hxz) ?_
      intro r
      obtain ⟨lam, P, Q, hm⟩ := hdec r
      refine ⟨lam, Q, P, ?_⟩
      have : r - φ lam - z * Q.eval₂ φ z - x * P.eval₂ φ x =
          r - φ lam - x * P.eval₂ φ x - z * Q.eval₂ φ z := by ring
      rw [this]; exact hm

  have t_polydec : ∀ (K : Type u) [Field K] (p : MvPolynomial (Fin 2) K), ∃ (lam : K) (P Q : Polynomial K) (H : MvPolynomial (Fin 2) K),
        p = MvPolynomial.C lam + MvPolynomial.X 0 * P.eval₂ MvPolynomial.C (MvPolynomial.X 0) +
          MvPolynomial.X 1 * Q.eval₂ MvPolynomial.C (MvPolynomial.X 1) +
          MvPolynomial.X 0 * MvPolynomial.X 1 * H := by
    intro K _ p
    induction p using MvPolynomial.induction_on with
    | C a => exact ⟨a, 0, 0, 0, by simp⟩
    | add p q hp hq =>
      obtain ⟨l1, P1, Q1, H1, h1⟩ := hp
      obtain ⟨l2, P2, Q2, H2, h2⟩ := hq
      refine ⟨l1 + l2, P1 + P2, Q1 + Q2, H1 + H2, ?_⟩
      rw [h1, h2]
      simp only [Polynomial.eval₂_add, map_add]
      ring
    | mul_X p i hp =>
      obtain ⟨l, P, Q, H, h⟩ := hp
      fin_cases i
      · refine ⟨0, Polynomial.C l + Polynomial.X * P, 0,
          Q.eval₂ MvPolynomial.C (MvPolynomial.X 1) + H * MvPolynomial.X 0, ?_⟩
        rw [h]
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X, Polynomial.eval₂_zero, map_zero]
        simp
        ring
      · refine ⟨0, 0, Polynomial.C l + Polynomial.X * Q,
          P.eval₂ MvPolynomial.C (MvPolynomial.X 0) + H * MvPolynomial.X 1, ?_⟩
        rw [h]
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X, Polynomial.eval₂_zero, map_zero]
        simp
        ring

  have t_psdec : ∀ (K : Type u) [Field K] (N : ℕ) (T : MvPowerSeries (Fin 2) K), ∃ (p : MvPolynomial (Fin 2) K), T - (p : MvPowerSeries (Fin 2) K) ∈
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ N := by
    intro K _ N T
    refine ⟨MvPowerSeries.trunc K (Finsupp.single 0 N + Finsupp.single 1 N) T, ?_⟩
    have hspan : (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) K)) ≤ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) := by
      rw [Ideal.span_le]
      intro f hf
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf
      have hX : ∀ i : Fin 2, (MvPowerSeries.X i : MvPowerSeries (Fin 2) K) ∈
          IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) := by
        intro i
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
          MvPowerSeries.constantCoeff_X]
        exact not_isUnit_zero
      rcases hf with rfl | rfl
      · exact hX 0
      · exact hX 1
    apply Ideal.pow_right_mono hspan N
    apply wcpa_dj_nd_low_coeff_vanish_mem_pow
    intro d hd
    rw [map_sub, MvPolynomial.coeff_coe, MvPowerSeries.coeff_trunc, if_pos, sub_self]
    refine lt_of_le_of_ne ?_ ?_
    · intro i
      fin_cases i <;> simp <;> omega
    · intro h
      have := congrArg (fun f : Fin 2 →₀ ℕ => f 0) h
      simp at this
      omega

  have t_s3 : ∀ (K : Type u) [Field K] (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (φ : K →+* O) (e : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (he : e.toRingHom.comp ((algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C), ∀ N : ℕ, ∃ x z : O, x ∈ IsLocalRing.maximalIdeal O ∧ z ∈ IsLocalRing.maximalIdeal O ∧ x * z ∈ IsLocalRing.maximalIdeal O ^ (N + 1) ∧ ∀ r : O, ∃ (lam : K) (P Q : Polynomial K), r - φ lam - x * P.eval₂ φ x - z * Q.eval₂ φ z ∈ IsLocalRing.maximalIdeal O ^ N := by
    intro K _ O _ _ _ φ e he
    intro N
    obtain ⟨Br1, Br2⟩ := wcpa_dj_lqr_completion_bridge K O e
    set π := Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) with hπ
    set J : ℕ → Ideal (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) := fun n =>
      Ideal.map π (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ n) with hJ
    set ε : O →+* MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
      e.toRingHom.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) with hε
    have hεφ : ε.comp φ = π.comp MvPowerSeries.C := he
    have hεa : ∀ r, ε r = e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) r) :=
      fun r => rfl
    have hJmono : ∀ m n, m ≤ n → J n ≤ J m := fun m n h =>
      Ideal.map_mono (Ideal.pow_le_pow_right h)
    have hX : ∀ i : Fin 2, (MvPowerSeries.X i : MvPowerSeries (Fin 2) K) ∈
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) := by
      intro i
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
        MvPowerSeries.constantCoeff_X]
      exact not_isUnit_zero
    have hXJ : ∀ i : Fin 2, π (MvPowerSeries.X i) ∈ J 1 := by
      intro i
      exact Ideal.mem_map_of_mem _ (by rw [pow_one]; exact hX i)
    have hX01 : π (MvPowerSeries.X 0) * π (MvPowerSeries.X 1) = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    obtain ⟨x, hx⟩ := Br1 (N + 1) (MvPowerSeries.X 0)
    obtain ⟨z, hz⟩ := Br1 (N + 1) (MvPowerSeries.X 1)
    rw [← hεa] at hx hz
    have hxm : x ∈ IsLocalRing.maximalIdeal O := by
      rw [← pow_one (IsLocalRing.maximalIdeal O), ← Br2, ← hεa]
      have := (J 1).add_mem (hJmono 1 (N + 1) (by omega) hx) (hXJ 0)
      rwa [sub_add_cancel] at this
    have hzm : z ∈ IsLocalRing.maximalIdeal O := by
      rw [← pow_one (IsLocalRing.maximalIdeal O), ← Br2, ← hεa]
      have := (J 1).add_mem (hJmono 1 (N + 1) (by omega) hz) (hXJ 1)
      rwa [sub_add_cancel] at this
    refine ⟨x, z, hxm, hzm, ?_, ?_⟩
    · rw [← Br2, ← hεa, map_mul]
      have e1 : ε x * ε z = (ε x - π (MvPowerSeries.X 0)) * ε z +
          π (MvPowerSeries.X 0) * (ε z - π (MvPowerSeries.X 1)) +
          π (MvPowerSeries.X 0) * π (MvPowerSeries.X 1) := by ring
      rw [e1, hX01, add_zero]
      exact (J (N + 1)).add_mem ((J (N + 1)).mul_mem_right _ hx) ((J (N + 1)).mul_mem_left _ hz)
    · intro r
      obtain ⟨T, hT⟩ := Ideal.Quotient.mk_surjective (ε r)
      obtain ⟨p, hp⟩ := t_psdec K N T
      obtain ⟨lam, P, Q, H, hpd⟩ := t_polydec K p
      refine ⟨lam, P, Q, ?_⟩
      rw [← Br2, ← hεa, ← Ideal.Quotient.eq_zero_iff_mem]
      set ψ := Ideal.Quotient.mk (J N) with hψ
      set g : MvPolynomial (Fin 2) K →+* _ :=
        ψ.comp (π.comp MvPolynomial.coeToMvPowerSeries.ringHom) with hg
      have hgC : (ψ.comp ε).comp φ = g.comp MvPolynomial.C := by
        rw [RingHom.comp_assoc, hεφ]
        ext a
        simp [hg]
      have hgx : ψ (ε x) = g (MvPolynomial.X 0) := by
        simp only [hg, RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_X]
        rw [hψ, Ideal.Quotient.eq]
        exact hJmono N (N + 1) (by omega) hx
      have hgz : ψ (ε z) = g (MvPolynomial.X 1) := by
        simp only [hg, RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_X]
        rw [hψ, Ideal.Quotient.eq]
        exact hJmono N (N + 1) (by omega) hz
      have hgr : ψ (ε r) = g p := by
        simp only [hg, RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply]
        rw [← hT, hψ, Ideal.Quotient.eq, ← map_sub]
        exact Ideal.mem_map_of_mem _ hp
      have hev : ∀ (R : Polynomial K) (w : O) (i : Fin 2), ψ (ε w) = g (MvPolynomial.X i) →
          ψ (ε (R.eval₂ φ w)) = g (R.eval₂ MvPolynomial.C (MvPolynomial.X i)) := by
        intro R w i hw
        have h1 : ψ (ε (R.eval₂ φ w)) = R.eval₂ ((ψ.comp ε).comp φ) ((ψ.comp ε) w) := by
          rw [← Polynomial.hom_eval₂]; rfl
        rw [h1, hgC, RingHom.comp_apply, hw, Polynomial.hom_eval₂]
      have hg01 : g (MvPolynomial.X 0) * g (MvPolynomial.X 1) = 0 := by
        simp only [hg, RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_X]
        rw [← map_mul, hX01, map_zero]
      have hφl : ψ (ε (φ lam)) = g (MvPolynomial.C lam) := by
        rw [← RingHom.comp_apply ψ ε, ← RingHom.comp_apply (ψ.comp ε) φ, hgC, RingHom.comp_apply]
      simp only [map_sub, map_mul]
      rw [hgr, hφl, hgx, hgz, hev P x 0 hgx, hev Q z 1 hgz, hpd]
      simp only [map_add, map_mul]
      linear_combination g H * hg01

  have t_s1 : ∀ (F : Type u) [Field F] (V : ValuationSubring F) (hmult : ∀ x y : F, x ≠ 0 → y ≠ 0 → wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) (hbd : (∀ x : F, x ∈ V → 0 ≤ wcpaDjValOrd V x) ∧
        ((∃ u : F, wcpaDjValOrd V u = 1) →
          (∀ x y : F, x ≠ 0 → y ≠ 0 → wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) →
          ∀ (x : F) (hx : x ∈ V), x ≠ 0 → (⟨x, hx⟩ : V) ∈ IsLocalRing.maximalIdeal V →
            1 ≤ wcpaDjValOrd V x)) (y : F) (hy : wcpaDjValOrd V y = 1), y ∈ V.nonunits ∧ y ≠ 0 ∧
        (∀ x ∈ V, x ≠ 0 → ∃ (n : ℕ) (w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ x = w * y ^ n) ∧
        (∀ x ∈ V.nonunits, ∃ t ∈ V, x = t * y) := by
    intro F _ V hmult hbd y hy
    obtain ⟨hnn, hpos⟩ := hbd
    have hpos' := hpos ⟨y, hy⟩ hmult

    have hNU : ∀ x : F, x ≠ 0 → x ∈ V.nonunits → 1 ≤ wcpaDjValOrd V x := by
      intro x hx0 hx
      obtain ⟨hxV, hxm⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp hx
      exact hpos' x hxV hx0 hxm
    have h1 : wcpaDjValOrd V 1 = 0 := by
      have := hmult 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at this; omega
    have hinv : ∀ x : F, x ≠ 0 → wcpaDjValOrd V x⁻¹ = - wcpaDjValOrd V x := by
      intro x hx
      have := hmult x x⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, h1] at this; omega
    have hval0 : wcpaDjValOrd V 0 = 0 := by
      have hS : {n : ℕ | ∃ (h : (0 : F) ∈ V), (⟨0, h⟩ : V) ∈ IsLocalRing.maximalIdeal ↥V ^ n} =
          Set.univ := by
        ext n; simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
        exact ⟨V.zero_mem, Ideal.zero_mem _⟩
      have hS' : {n : ℕ | ∃ (h : (0 : F)⁻¹ ∈ V), (⟨(0 : F)⁻¹, h⟩ : V) ∈
          IsLocalRing.maximalIdeal ↥V ^ n} = Set.univ := by
        ext n; simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
        refine ⟨by rw [inv_zero]; exact V.zero_mem, ?_⟩
        have : (⟨(0 : F)⁻¹, by rw [inv_zero]; exact V.zero_mem⟩ : V) = 0 := by
          ext; simp
        rw [this]; exact (IsLocalRing.maximalIdeal ↥V ^ n).zero_mem
      unfold wcpaDjValOrd
      rw [hS, hS', Nat.sSup_of_not_bddAbove not_bddAbove_univ]
      simp
    have hy0 : y ≠ 0 := by rintro rfl; rw [hval0] at hy; exact zero_ne_one hy

    have hunit : ∀ x : F, x ≠ 0 → wcpaDjValOrd V x = 0 → x ∈ V ∧ x⁻¹ ∈ V := by
      intro x hx0 hx
      rcases V.mem_or_inv_mem x with h | h
      · refine ⟨h, ?_⟩
        by_contra hi
        have hn : x ∈ V.nonunits := by
          rw [ValuationSubring.mem_nonunits_iff]
          refine lt_of_le_of_ne ((V.valuation_le_one_iff x).mpr h) ?_
          intro h1'
          apply hi
          rw [← V.valuation_le_one_iff, map_inv₀, h1', inv_one]
        have := hNU x hx0 hn; omega
      · refine ⟨?_, h⟩
        by_contra hi
        have hn : x⁻¹ ∈ V.nonunits := by
          rw [ValuationSubring.mem_nonunits_iff]
          refine lt_of_le_of_ne ((V.valuation_le_one_iff _).mpr h) ?_
          intro h1'
          apply hi
          rw [← inv_inv x, ← V.valuation_le_one_iff, map_inv₀, h1', inv_one]
        have := hNU x⁻¹ (inv_ne_zero hx0) hn
        rw [hinv x hx0] at this; omega
    have hyV : y ∈ V := by
      by_contra hu
      rcases V.mem_or_inv_mem y with h | h
      · exact hu h
      · have hn : y⁻¹ ∈ V.nonunits := by
          rw [ValuationSubring.mem_nonunits_iff]
          refine lt_of_le_of_ne ((V.valuation_le_one_iff _).mpr h) ?_
          intro h1'
          apply hu
          rw [← inv_inv y, ← V.valuation_le_one_iff, map_inv₀, h1', inv_one]
        have := hNU y⁻¹ (inv_ne_zero hy0) hn
        rw [hinv y hy0] at this; omega
    have hyn : y ∈ V.nonunits := by
      rw [ValuationSubring.mem_nonunits_iff]
      refine lt_of_le_of_ne ((V.valuation_le_one_iff y).mpr hyV) ?_
      intro h1'
      have hyi : y⁻¹ ∈ V := by rw [← V.valuation_le_one_iff, map_inv₀, h1', inv_one]
      have a1 := hnn y⁻¹ hyi
      rw [hinv y hy0] at a1; omega
    have hpow : ∀ n : ℕ, wcpaDjValOrd V (y ^ n) = n := by
      intro n
      induction n with
      | zero => simpa using h1
      | succ n ih =>
        rw [pow_succ, hmult _ _ (pow_ne_zero _ hy0) hy0, ih, hy]; push_cast; ring
    have hDEC : ∀ x ∈ V, x ≠ 0 → ∃ (n : ℕ) (w : F), w ≠ 0 ∧ w ∈ V ∧ w⁻¹ ∈ V ∧ x = w * y ^ n := by
      intro x hx hx0
      have hn0 := hnn x hx
      refine ⟨(wcpaDjValOrd V x).toNat, x * (y ^ (wcpaDjValOrd V x).toNat)⁻¹, ?_⟩
      have hyp0 : y ^ (wcpaDjValOrd V x).toNat ≠ 0 := pow_ne_zero _ hy0
      have hw0 : x * (y ^ (wcpaDjValOrd V x).toNat)⁻¹ ≠ 0 := mul_ne_zero hx0 (inv_ne_zero hyp0)
      have hwv : wcpaDjValOrd V (x * (y ^ (wcpaDjValOrd V x).toNat)⁻¹) = 0 := by
        rw [hmult _ _ hx0 (inv_ne_zero hyp0), hinv _ hyp0, hpow]; omega
      obtain ⟨hwV, hwi⟩ := hunit _ hw0 hwv
      exact ⟨hw0, hwV, hwi, by rw [mul_assoc, inv_mul_cancel₀ hyp0, mul_one]⟩
    refine ⟨hyn, hy0, hDEC, ?_⟩
    intro x hx
    by_cases hx0 : x = 0
    · exact ⟨0, V.zero_mem, by rw [hx0, zero_mul]⟩
    have hxV : x ∈ V := by
      rw [ValuationSubring.mem_nonunits_iff] at hx
      exact (V.valuation_le_one_iff x).mp hx.le
    obtain ⟨n, w, hw0, hwV, hwi, hxw⟩ := hDEC x hxV hx0
    rcases n with _ | n
    · exfalso
      rw [pow_zero, mul_one] at hxw
      rw [← hxw] at hwi
      rw [ValuationSubring.mem_nonunits_iff] at hx
      have h2 := (V.valuation_le_one_iff _).mpr hwi
      have h3 : V.valuation (x * x⁻¹) = 1 := by rw [mul_inv_cancel₀ hx0, map_one]
      rw [map_mul] at h3
      have := lt_of_le_of_lt (mul_le_of_le_one_right' h2) hx
      rw [h3] at this
      exact lt_irrefl _ this
    · exact ⟨w * y ^ n, V.mul_mem _ _ hwV (V.pow_mem hyV n), by rw [hxw, pow_succ]; ring⟩


  obtain ⟨hb, hc, hgood, hiff⟩ := hctr
  have hρV : ∀ a : Γ(C, L.V b), (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a ∈ V := by
    obtain ⟨hb', hg'⟩ := hgood
    exact hg'
  have hU : IsAffineOpen (L.V b) := hOK.1 b
  obtain ⟨hmul, hsub, hadd, hVn, hnot⟩ := t_nu _ V
  have hinvV : ∀ x : C.residueField ξ, x ∈ V → x ∉ V.nonunits → x ≠ 0 ∧ x⁻¹ ∈ V := by
    intro x hx hxn
    have hval : V.valuation x = 1 := by
      rw [ValuationSubring.mem_nonunits_iff, not_lt] at hxn
      exact le_antisymm ((V.valuation_le_one_iff _).mpr hx) hxn
    refine ⟨?_, ?_⟩
    · intro h0; rw [h0, map_zero] at hval; exact zero_ne_one hval
    · rw [← V.valuation_le_one_iff, map_inv₀, hval, inv_one]
  letI alg : Algebra Γ(C, L.V b) (C.presheaf.stalk c) :=
    TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨c, hc⟩
  haveI hloc : IsLocalization.AtPrime (C.presheaf.stalk c) (hU.primeIdealOf ⟨c, hc⟩).asIdeal :=
    hU.isLocalization_stalk ⟨c, hc⟩
  have hgerm : ∀ a : Γ(C, L.V b), algebraMap Γ(C, L.V b) (C.presheaf.stalk c) a =
      (C.presheaf.germ (L.V b) c hc).hom a := fun a => rfl
  have hmaxiff : ∀ a : Γ(C, L.V b), a ∈ (hU.primeIdealOf ⟨c, hc⟩).asIdeal ↔
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a ∈ V.nonunits := by
    intro a
    rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff (C.presheaf.stalk c)
      (hU.primeIdealOf ⟨c, hc⟩).asIdeal a, hgerm]
    exact hiff a
  have hunit : ∀ s : (hU.primeIdealOf ⟨c, hc⟩).asIdeal.primeCompl,
      IsUnit ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s) := by
    intro s
    have h2 : (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s ∉ V.nonunits :=
      fun h => s.2 ((hmaxiff s).mpr h)
    exact (hinvV _ (hρV s) h2).1.isUnit
  set ι : C.presheaf.stalk c →+* C.residueField ξ :=
    IsLocalization.lift (M := (hU.primeIdealOf ⟨c, hc⟩).asIdeal.primeCompl)
      (S := C.presheaf.stalk c) hunit with hιdef
  have hιeq : ∀ a : Γ(C, L.V b), ι (algebraMap Γ(C, L.V b) (C.presheaf.stalk c) a) =
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a := fun a => IsLocalization.lift_eq hunit a
  have hsinv : ∀ s : (hU.primeIdealOf ⟨c, hc⟩).asIdeal.primeCompl,
      (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s ≠ 0 ∧
      ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ ∈ V := by
    intro s
    exact hinvV _ (hρV s) (fun h => s.2 ((hmaxiff s).mpr h))
  have hform : ∀ o : C.presheaf.stalk c, ∃ (a : Γ(C, L.V b))
      (s : (hU.primeIdealOf ⟨c, hc⟩).asIdeal.primeCompl),
      ι o = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a *
        ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ ∧
      (o ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk c) →
        (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a ∈ V.nonunits) := by
    intro o
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective
      (hU.primeIdealOf ⟨c, hc⟩).asIdeal.primeCompl o
    refine ⟨a, s, ?_, ?_⟩
    · have h1 := congrArg ι (IsLocalization.mk'_spec (C.presheaf.stalk c) a s)
      rw [map_mul, hιeq, hιeq] at h1
      rw [← h1, mul_assoc, mul_inv_cancel₀ (hsinv s).1, mul_one]
    · intro hm
      rw [IsLocalization.AtPrime.mk'_mem_maximal_iff (C.presheaf.stalk c) (hU.primeIdealOf ⟨c, hc⟩).asIdeal] at hm
      exact (hmaxiff a).mp hm
  have hιV : ∀ o, ι o ∈ V := by
    intro o
    obtain ⟨a, s, h, -⟩ := hform o
    rw [h]; exact V.mul_mem _ _ (hρV a) (hsinv s).2
  have hι𝔪 : ∀ o ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk c), ι o ∈ V.nonunits := by
    intro o ho
    obtain ⟨a, s, h, h'⟩ := hform o
    rw [h, mul_comm]; exact hmul _ _ (hsinv s).2 (h' ho)
  have hθι : ∀ o, θ (ι o) ∈ V.nonunits := by
    intro o
    obtain ⟨a, s, h, -⟩ := hform o
    rw [h, Derivation.leibniz, Derivation.leibniz_inv, smul_eq_mul, smul_eq_mul, smul_eq_mul]
    have hp2 : ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ ^ 2 ∈ V := by
      rw [pow_two]; exact V.mul_mem _ _ (hsinv s).2 (hsinv s).2
    refine hadd _ _ (hmul _ _ (hρV a) ?_) (hmul _ _ (hsinv s).2 (hθ hb a))
    rw [neg_mul, ← mul_neg]
    refine hmul _ _ hp2 ?_
    have := hθ hb s
    rw [ValuationSubring.mem_nonunits_iff] at this ⊢
    rwa [Valuation.map_neg]
  have hfrac : ∀ f : C.residueField ξ, ∃ r s : C.presheaf.stalk c, ι s ≠ 0 ∧
      f = ι r * (ι s)⁻¹ := by
    intro f
    obtain ⟨a, s, hs, hf⟩ := wcpa_dj_cdp_le_residue_fractions C (L.V b) hU ξ hb f
    refine ⟨algebraMap _ _ a, algebraMap _ _ s, ?_, ?_⟩
    · rw [hιeq]; exact hs
    · rw [hιeq, hιeq]; exact hf
  have hιφ : ι.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
      C.presheaf.germ ⊤ c trivial).hom = algebraMap K (C.residueField ξ) := by
    ext lam
    rw [hA]
    have e2 : ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ c trivial).hom lam =
        algebraMap Γ(C, L.V b) (C.presheaf.stalk c)
          ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
            (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom lam))) := by
      have := congrArg (fun f => CommRingCat.Hom.hom f
        (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom lam)))
        (C.presheaf.germ_res (homOfLE (le_top : L.V b ≤ ⊤)) c hc)
      exact this.symm
    have e4 : (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom lam))) =
        wcpaDjFK K q ξ lam := by
      have := congrArg (fun f => (C.residue ξ).hom (CommRingCat.Hom.hom f
        (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom lam))))
        (C.presheaf.germ_res (homOfLE (le_top : L.V b ≤ ⊤)) ξ hb)
      exact this
    rw [RingHom.comp_apply, e2, hιeq, e4]

  have hmultV := (wcpa_dj_cdp_ff_valuations K (C.residueField ξ) hF).2.1 V hV
  obtain ⟨hyn, hy0, hDEC, hNU⟩ :=
    t_s1 _ V hmultV (wcpa_dj_lsp_scd_valord_bounds (C.residueField ξ) V) y hy
  have hKV := hV.1

  have PB := t_s10 K (C.residueField ξ) (C.presheaf.stalk c) V y ι θ (hVn y hyn) hιV
    (fun o ho => hNU _ (hι𝔪 o ho)) (fun o => hNU _ (hθι o))

  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  have hcomp : inv (Limits.pullback.fst q (𝟙 (Spec (.of K)))) ≫
      Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have h3 := hss.2.2 K (𝟙 _) ((inv (Limits.pullback.fst q (𝟙 (Spec (.of K))))) c)
  obtain ⟨e, he⟩ := (wcpa_dj_ssp_bw_ns_transport K
    (asIso (inv (Limits.pullback.fst q (𝟙 (Spec (.of K)))))) q
    (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hcomp c h3).resolve_left hnode
  have TRUNC := t_s3 K (C.presheaf.stalk c)
    ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ c trivial).hom e he

  obtain ⟨r, s, hs0, hyrs⟩ := hfrac y
  obtain ⟨c₀, wb, hwb0, hwbV, hwbi, hsb⟩ := hDEC (ι s) (hιV s) hs0
  have H4 := t_s4 K (C.residueField ξ) V hKV
  have H9 := t_s9 (C.residueField ξ) V y hyn hy0
  have H6 := t_s6 K (C.residueField ξ) V y hyn hy0 hDEC hKV H4 H9
  have hab : ι r = y * ι s := by
    rw [hyrs, mul_assoc, inv_mul_cancel₀ hs0, mul_one]
  obtain ⟨β, w, hw0, hwV, hwi, hβw, hθβ, happrox⟩ :=
    t_s7 K (C.residueField ξ) (C.presheaf.stalk c) V y hyn hy0 hDEC H6 _ ι hιφ hιV hι𝔪 TRUNC
      θ hθι PB (2 * c₀ + 2) c₀ r s wb hwb0 hwbV hwbi hsb hab
  obtain ⟨Ra, hRa1, hRa2⟩ := happrox r
  obtain ⟨Rb, hRb1, hRb2⟩ := happrox s
  exact t_s8 K (C.residueField ξ) V y hyn hy0 hDEC hKV H4 (t_s5 K) H9 θ (ι r) (ι s) wb c₀
    hwb0 hwbV hwbi hsb hyrs β w hw0 hwV hwi hβw hθβ Ra Rb hRa1 hRa2 hRb1 hRb2

theorem wcpa_dj_lqcf_no_marked_derivation : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u}) (c : C ⟶ Spec (.of k)) (n : ℕ) (τ : Fin n → (Spec (.of k) ⟶ C)), 3 ≤ n → wcpaDjStablePtd c n τ → GeometricallyConnected c → ∀ (θ : ∀ U : C.Opens, Γ(C, U) → Γ(C, U)), (∀ (U V : C.Opens) (h : V ≤ U), IsAffineOpen U → IsAffineOpen V → ∀ f : Γ(C, U), θ V ((C.presheaf.map (homOfLE h).op).hom f) = (C.presheaf.map (homOfLE h).op).hom (θ U f)) → (∀ U : C.Opens, IsAffineOpen U → ∀ f g : Γ(C, U), θ U (f + g) = θ U f + θ U g) → (∀ U : C.Opens, IsAffineOpen U → ∀ f g : Γ(C, U), θ U (f * g) = f * θ U g + g * θ U f) → (∀ U : C.Opens, IsAffineOpen U → ∀ a : k, θ U ((c.appTop ≫ C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom ((Scheme.ΓSpecIso (.of k)).inv.hom a)) = 0) → (∀ (i : Fin n) (y : Spec (.of k)) (U : C.Opens) (hU : τ i y ∈ U), IsAffineOpen U → ∀ f : Γ(C, U), (C.presheaf.germ U (τ i y) hU).hom (θ U f) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk (τ i y))) → ∀ U : C.Opens, IsAffineOpen U → ∀ f : Γ(C, U), θ U f = 0 :=
by
  intro k _ _ C c n τ hn hst hgc θ hR hA hL hK hM U hU f
  classical
  by_contra hne

  have hss : wcpaDjSemistable c := hst.1
  haveI hcp : IsProper c := hst.1.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian c
  have hred : AlgebraicGeometry.IsReduced C := by
    haveI := wcpa_dj_ldx_semistable_fibre_reduced C _ c hss k (𝟙 _)
    exact isReduced_of_isOpenImmersion (inv (Limits.pullback.fst c (𝟙 (Spec (.of k)))))

  obtain ⟨ξ, hξU, hξ, hρ⟩ := wcpa_dj_lqcf_nmd_generic_witness C hred U hU (θ U f) hne
  letI : Algebra k (C.residueField ξ) := (wcpaDjFK k c ξ).toAlgebra
  have hAlg : algebraMap k (C.residueField ξ) = wcpaDjFK k c ξ := rfl
  obtain ⟨D, hD⟩ := wcpa_dj_lqcf_nmd_generic_derivation k C c hred θ hR hA hL hK ξ hξ hAlg
  have hD0 : D ≠ 0 := by
    intro h
    have h1 := hD U hU hξU f
    rw [h, Derivation.zero_apply] at h1
    exact hρ h1.symm
  have hF := wcpa_dj_cdp_residue_ff1 k C c hss ξ hξ hAlg
  have hDu := wcpa_dj_lqcf_nmd_der_rank_one k (C.residueField ξ) hF D hD0
  obtain ⟨⟨u, hu⟩, hmult, -, -, -⟩ := wcpa_dj_cdp_ff_valuations k (C.residueField ξ) hF

  obtain ⟨L, hOK⟩ : ∃ L : wcpaDjCoc C, wcpaDjCocOK L := by
    haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace c
    have hcov : ∀ x : C, ∃ W : C.affineOpens, x ∈ (W.1 : C.Opens) := by
      intro x
      obtain ⟨W, hW, hxW, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens
        (show x ∈ (⊤ : C.Opens) from trivial)
      exact ⟨⟨W, hW⟩, hxW⟩
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
      (fun W : C.affineOpens => ((W.1 : C.Opens) : Set C)) (fun W => W.1.isOpen) (by
        intro x _
        obtain ⟨W, hW⟩ := hcov x
        exact Set.mem_iUnion.mpr ⟨W, hW⟩)
    refine ⟨⟨t.card, fun a => (t.equivFin.symm a).1.1, fun _ _ => 1⟩, ?_, ?_, ?_, ?_⟩
    · intro a
      exact (t.equivFin.symm a).1.2
    · apply eq_top_iff.mpr
      intro x _
      have hx := ht (Set.mem_univ x)
      simp only [Set.mem_iUnion] at hx
      obtain ⟨W, hWt, hxW⟩ := hx
      rw [TopologicalSpace.Opens.mem_iSup]
      refine ⟨t.equivFin ⟨W, hWt⟩, ?_⟩
      simpa using hxW
    · intro a
      rfl
    · intro a b c'
      simp

  have hnu_V : ∀ (V : ValuationSubring (C.residueField ξ)) (x : C.residueField ξ),
      x ∈ V.nonunits → x ∈ V := by
    intro V x hx
    rw [ValuationSubring.mem_nonunits_iff] at hx
    exact (V.valuation_le_one_iff x).mp hx.le
  have hnu_mul : ∀ (V : ValuationSubring (C.residueField ξ)) (x z : C.residueField ξ),
      x ∈ V → z ∈ V.nonunits → x * z ∈ V.nonunits := by
    intro V x z hx hz
    rw [ValuationSubring.mem_nonunits_iff] at hz ⊢
    rw [Valuation.map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_left' ((V.valuation_le_one_iff x).mpr hx)) hz
  have hnu_sub : ∀ (V : ValuationSubring (C.residueField ξ)) (x z : C.residueField ξ),
      x ∈ V.nonunits → z ∈ V.nonunits → x - z ∈ V.nonunits := by
    intro V x z hx hz
    rw [ValuationSubring.mem_nonunits_iff] at hx hz ⊢
    exact lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt hx hz)

  have hloc : ∀ (V : ValuationSubring (C.residueField ξ)), wcpaDjNtV' k V →
      ∀ (b : Fin L.m) (c₀ : C), wcpaDjCtr L ξ V b c₀ → ∀ y : C.residueField ξ,
      wcpaDjValOrd V y = 1 → D y ∈ V ∧
        (((¬ ∃ W : C.Opens, c₀ ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c)) ∨
          ∃ i p, τ i p = c₀) → D y ∈ V.nonunits) := by
    intro V hV b c₀ hctr y hy
    obtain ⟨hb, hc₀, hgood, hiff⟩ := id hctr
    have hbaff : IsAffineOpen (L.V b) := hOK.1 b
    have hρV : ∀ a : Γ(C, L.V b), (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a ∈ V := by
      intro a
      obtain ⟨hb', hg'⟩ := hgood
      exact hg' a
    have hDρ : ∀ a : Γ(C, L.V b),
        D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a) ∈ V := by
      intro a
      rw [hD _ hbaff hb a]
      exact hρV _
    by_cases hsm : ∃ W : C.Opens, c₀ ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c)
    · have hyV : y ∈ V := by
        by_contra hyV
        have h1 : {n : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} = ∅ := by
          ext m
          simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
          rintro ⟨h, -⟩
          exact hyV h
        unfold wcpaDjValOrd at hy
        rw [h1, csSup_empty, bot_eq_zero] at hy
        push_cast at hy
        omega
      obtain ⟨a, s, hs, hys⟩ :=
        wcpa_dj_cdp_le_smooth_center k C c ξ hξ L hOK V b c₀ hctr hsm hb y hyV
      have hsV := hρV s
      have hval : V.valuation ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s) = 1 := by
        rw [ValuationSubring.mem_nonunits_iff, not_lt] at hs
        exact le_antisymm ((V.valuation_le_one_iff _).mpr hsV) hs
      have hinvV : ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ ∈ V := by
        rw [← V.valuation_le_one_iff, map_inv₀, hval, inv_one]
      have hDy : D y = ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ *
            D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a) -
          (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a *
            ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ ^ 2 *
            D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s) := by
        rw [hys, Derivation.leibniz, Derivation.leibniz_inv, smul_eq_mul, smul_eq_mul,
          smul_eq_mul]
        ring
      have hpowV : ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom s)⁻¹ ^ 2 ∈ V := by
        rw [pow_two]; exact V.mul_mem _ _ hinvV hinvV
      refine ⟨?_, ?_⟩
      · rw [hDy, sub_eq_add_neg]
        exact V.add_mem _ _ (V.mul_mem _ _ hinvV (hDρ a))
          (V.neg_mem _ (V.mul_mem _ _ (V.mul_mem _ _ (hρV a) hpowV) (hDρ s)))
      · rintro (hns | ⟨i, p, hip⟩)
        · exact absurd hsm hns
        · subst hip
          have hmk : ∀ a' : Γ(C, L.V b),
              D ((C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom a') ∈ V.nonunits := by
            intro a'
            rw [hD _ hbaff hb a']
            exact (hiff _).mp (hM i p (L.V b) hc₀ hbaff a')
          rw [hDy]
          exact hnu_sub V _ _ (hnu_mul V _ _ hinvV (hmk a))
            (hnu_mul V _ _ (V.mul_mem _ _ (hρV a) hpowV) (hmk s))
    ·
      have hcomp : inv (Limits.pullback.fst c (𝟙 (Spec (.of k)))) ≫
          Limits.pullback.snd c (𝟙 (Spec (.of k))) = c := by
        rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
      have h3 := hss.2.2 k (𝟙 _) ((inv (Limits.pullback.fst c (𝟙 (Spec (.of k))))) c₀)
      have hnode := (wcpa_dj_ssp_bw_ns_transport k
        (asIso (inv (Limits.pullback.fst c (𝟙 (Spec (.of k)))))) c
        (Limits.pullback.snd c (𝟙 (Spec (.of k)))) hcomp c₀ h3).resolve_left hsm
      have hθ' : ∀ (hb' : ξ ∈ L.V b) (a : Γ(C, L.V b)),
          D ((C.presheaf.germ (L.V b) ξ hb' ≫ C.residue ξ).hom a) ∈ V.nonunits := by
        intro hb' a
        rw [hD _ hbaff hb' a]
        exact (hiff _).mp (wcpa_dj_lqcf_nmd_node_germ k C c (L.V b) hbaff (θ (L.V b))
          (hA _ hbaff) (hL _ hbaff) (hK _ hbaff) c₀ hc₀ inferInstance hnode a)
      have hDy := wcpa_dj_cdp_le_node_branch k C c hss ξ hξ hAlg hF L hOK V hV b c₀ hctr hsm
        D hθ' y hy
      exact ⟨hnu_V V _ hDy, fun _ => hDy⟩

  have hcent : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' k V →
      ∃ b c₀, wcpaDjCtr L ξ V b c₀ := by
    intro V hV
    obtain ⟨b, hgood⟩ := wcpa_dj_cdp_chart_exists k C c hcp L hOK ξ hAlg V hV
    obtain ⟨c₀, hc₀⟩ := wcpa_dj_cdp_le_center_exists C L hOK ξ V b hgood
    exact ⟨b, c₀, hc₀⟩
  have hnonpos : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' k V →
      -wcpaDjValOrd V (D (u V)) ≤ 0 := by
    intro V hV
    obtain ⟨b, c₀, hc⟩ := hcent V hV
    have h1 := (hloc V hV b c₀ hc (u V) (hu V hV)).1
    have h2 := (wcpa_dj_lsp_scd_valord_bounds _ V).1 _ h1
    omega
  have hspec : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' k V →
      wcpaDjSpecialV c τ L ξ V → -wcpaDjValOrd V (D (u V)) ≤ -1 := by
    intro V hV hsp
    obtain ⟨c₀, b, hc, hor⟩ := hsp
    have h1 := (hloc V hV b c₀ hc (u V) (hu V hV)).2 hor
    obtain ⟨hmem, hmax⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp h1
    have h2 := (wcpa_dj_lsp_scd_valord_bounds _ V).2 ⟨u V, hu V hV⟩ (hmult V hV) _ hmem
      (hDu V (u V) hV (hu V hV)) hmax
    omega

  obtain ⟨hfin, hdich, hrat⟩ := wcpa_dj_cdp_canonical_degree k (C.residueField ξ) hF D hDu u hu
  obtain ⟨⟨V₀, hV₀, hsp₀⟩, h3⟩ := wcpa_dj_cdp_special_points k C c n τ L hn hst hgc hOK ξ hξ hAlg
  obtain ⟨g, hg⟩ : ∃ g : ValuationSubring (C.residueField ξ) → ℤ,
      g = Set.indicator {V : ValuationSubring (C.residueField ξ) | wcpaDjNtV' k V}
        (fun V => -wcpaDjValOrd V (D (u V))) := ⟨_, rfl⟩
  rw [← hg] at hdich hrat
  have hgV : ∀ V, wcpaDjNtV' k V → g V = -wcpaDjValOrd V (D (u V)) := by
    intro V hV
    rw [hg]
    exact Set.indicator_of_mem (show V ∈ {V : ValuationSubring (C.residueField ξ) |
      wcpaDjNtV' k V} from hV) _
  have hgN : ∀ V, ¬ wcpaDjNtV' k V → g V = 0 := by
    intro V hV
    rw [hg]
    exact Set.indicator_of_notMem (show V ∉ {V : ValuationSubring (C.residueField ξ) |
      wcpaDjNtV' k V} from hV) _
  have hgle : ∀ V, g V ≤ 0 := by
    intro V
    by_cases hN : wcpaDjNtV' k V
    · rw [hgV V hN]; exact hnonpos V hN
    · rw [hgN V hN]
  have hsupp : Function.support g ⊆ ↑hfin.toFinset := by
    intro V hV
    rw [Function.mem_support] at hV
    rw [Set.Finite.coe_toFinset]
    by_cases hN : wcpaDjNtV' k V
    · refine ⟨hN, ?_⟩
      intro h0
      apply hV
      rw [hgV V hN, h0, neg_zero]
    · exact absurd (hgN V hN) hV
  have hsum : ∑ᶠ V, g V = ∑ V ∈ hfin.toFinset, g V := finsum_eq_sum_of_support_subset g hsupp
  have hmemS : ∀ V, wcpaDjNtV' k V → wcpaDjSpecialV c τ L ξ V → V ∈ hfin.toFinset := by
    intro V hV hsp
    rw [Set.Finite.mem_toFinset]
    refine ⟨hV, ?_⟩
    have := hspec V hV hsp
    omega
  have hle1 : ∑ᶠ V, g V ≤ -1 := by
    rw [hsum]
    calc ∑ V ∈ hfin.toFinset, g V ≤ ∑ V ∈ {V₀}, g V :=
          Finset.sum_le_sum_of_subset_of_nonpos
            (Finset.singleton_subset_iff.mpr (hmemS V₀ hV₀ hsp₀)) (fun V _ _ => hgle V)
      _ ≤ -1 := by
          rw [Finset.sum_singleton, hgV V₀ hV₀]
          exact hspec V₀ hV₀ hsp₀
  rcases hdich with h2 | h0
  · obtain ⟨V₁, V₂, V₃, h12, h13, h23, ⟨hN1, hs1⟩, ⟨hN2, hs2⟩, ⟨hN3, hs3⟩⟩ := h3 (hrat h2)
    have hsub : ({V₁, V₂, V₃} : Finset (ValuationSubring (C.residueField ξ))) ⊆ hfin.toFinset := by
      intro V hV
      simp only [Finset.mem_insert, Finset.mem_singleton] at hV
      rcases hV with h | h | h
      · subst h; exact hmemS _ hN1 hs1
      · subst h; exact hmemS _ hN2 hs2
      · subst h; exact hmemS _ hN3 hs3
    have hle3 : ∑ V ∈ hfin.toFinset, g V ≤ -3 := by
      calc ∑ V ∈ hfin.toFinset, g V ≤ ∑ V ∈ ({V₁, V₂, V₃} : Finset _), g V :=
            Finset.sum_le_sum_of_subset_of_nonpos hsub (fun V _ _ => hgle V)
        _ = g V₁ + (g V₂ + g V₃) := by
            rw [Finset.sum_insert (by simp [h12, h13]), Finset.sum_insert (by simp [h23]),
              Finset.sum_singleton]
        _ ≤ -3 := by
            rw [hgV V₁ hN1, hgV V₂ hN2, hgV V₃ hN3]
            have e1 := hspec V₁ hN1 hs1
            have e2 := hspec V₂ hN2 hs2
            have e3 := hspec V₃ hN3 hs3
            omega
    rw [hsum] at h2
    omega
  · omega

theorem wcpa_dj_lqcf_formal_to_generic : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsDomain A] (𝔪 : Ideal A), 𝔪.IsMaximal → ∀ (Y Y' : Scheme.{u}) (q : Y ⟶ Spec (.of A)) (q' : Y' ⟶ Spec (.of A)), IsProper q → IsSeparated q' → ∀ (f g : Y ⟶ Y'), f ≫ q' = q → g ≫ q' = q → (∀ (m : ℕ) (Ym : Scheme.{u}) (ιm : Ym ⟶ Y) (qm : Ym ⟶ Spec (.of (A ⧸ 𝔪 ^ m))), IsPullback ιm qm q (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ m)))) → ιm ≫ f = ιm ≫ g) → ∀ (L : Type u) [Field L] (γ : A →+* L), Function.Injective γ → ∀ (X : Scheme.{u}) (x : X ⟶ Y) (y : X ⟶ Spec (.of L)), x ≫ q = y ≫ Spec.map (CommRingCat.ofHom γ) → x ≫ f = x ≫ g :=
by

  have s1 : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (J P : Ideal B), P.IsPrime →
      J ≤ P → ∀ S : Set B, (∀ d ∈ S, ∀ m : ℕ, d ∈ J ^ m) → ∃ s : B, s ∉ P ∧ ∀ d ∈ S, s * d = 0 := by
    intro B _ _ J P hP hJP S hS
    classical
    obtain ⟨T, hT⟩ := (IsNoetherian.noetherian (⨅ m : ℕ, J ^ m) : (⨅ m : ℕ, J ^ m).FG)
    have hkr : ∀ t ∈ T, ∃ r ∈ J, (1 - r) * t = 0 := by
      intro t ht
      have htN : t ∈ (⨅ m : ℕ, J ^ m) := hT ▸ Submodule.subset_span ht
      have e : (⨅ i : ℕ, J ^ i • (⊤ : Submodule B B)) = ⨅ m : ℕ, J ^ m := by
        simp only [Ideal.smul_eq_mul, Ideal.mul_top]
      have : t ∈ ⨅ i : ℕ, J ^ i • (⊤ : Submodule B B) := by rw [e]; exact htN
      obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff J t).mp this
      refine ⟨r, r.2, ?_⟩
      rw [sub_mul, one_mul, ← smul_eq_mul, hr, sub_self]
    choose! r hrJ hr using hkr
    refine ⟨∏ t ∈ T, (1 - r t), ?_, ?_⟩
    · intro hmem
      obtain ⟨t, ht, h⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hP)).mp hmem
      apply hP.ne_top
      rw [Ideal.eq_top_iff_one]
      have := P.add_mem h (hJP (hrJ t ht))
      simpa using this
    · have hkill : ∀ n ∈ (⨅ m : ℕ, J ^ m), (∏ t ∈ T, (1 - r t)) * n = 0 := by
        intro n hn
        rw [← hT] at hn
        induction hn using Submodule.span_induction with
        | mem x hx =>
          rw [← Finset.mul_prod_erase T _ hx, mul_comm (1 - r x), mul_assoc, hr x hx, mul_zero]
        | zero => simp
        | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
        | smul a x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]
      intro d hd
      exact hkill d (Submodule.mem_iInf _ |>.mpr (hS d hd))

  have s6 : ∀ (X Y Y' : Scheme.{u}) (x : X ⟶ Y) (f g : Y ⟶ Y'),
      (∀ p : X, ∃ (W : Scheme.{u}) (w : W ⟶ Y), IsOpenImmersion w ∧ x p ∈ Set.range w ∧
        w ≫ f = w ≫ g) → x ≫ f = x ≫ g := by
    intro X Y Y' x f g h
    choose W w hw hmem heq using h
    have hcov : ∀ p : X, ∃ j z, (Limits.pullback.fst x (w j)) z = p := by
      intro p
      have : p ∈ Set.range (Limits.pullback.fst x (w p)) := by
        rw [Scheme.Pullback.range_fst]; exact hmem p
      obtain ⟨z, hz⟩ := this
      exact ⟨p, z, hz⟩
    let 𝒰 : X.OpenCover := Scheme.Cover.mkOfCovers X (fun p => Limits.pullback x (w p))
      (fun p => Limits.pullback.fst x (w p)) hcov (fun p => inferInstance)
    have key : ∀ p : X, Limits.pullback.fst x (w p) ≫ x ≫ f =
        Limits.pullback.fst x (w p) ≫ x ≫ g := by
      intro p
      rw [Limits.pullback.condition_assoc, Limits.pullback.condition_assoc, heq]
    apply Scheme.Cover.hom_ext 𝒰
    intro p
    exact key p

  have s5 : ∀ (A : Type u) [CommRing A] (𝔪 : Ideal A), 𝔪.IsPrime → ∀ (Y : Scheme.{u})
      (q : Y ⟶ Spec (.of A)), IsProper q → ∀ U : Set Y, IsOpen U →
      (∀ y : Y, (q y).asIdeal = 𝔪 → y ∈ U) → ∀ y : Y, (q y).asIdeal = ⊥ → y ∈ U := by
    intro A _ 𝔪 h𝔪 Y q hq U hU hcl y hy
    haveI := hq
    by_contra hyU
    have hcl' : IsClosed (q '' Uᶜ) := q.isClosedMap _ hU.isClosed_compl
    let P0 : Spec (.of A) := ⟨𝔪, h𝔪⟩
    have hsp : q y ⤳ P0 := by
      refine (PrimeSpectrum.le_iff_specializes (q y) P0).mp ?_
      show (q y).asIdeal ≤ 𝔪
      rw [hy]; exact bot_le
    obtain ⟨z, hz, hzq⟩ := hsp.mem_closed hcl' ⟨y, hyU, rfl⟩
    exact hz (hcl z (by rw [hzq]))

  have s8 : ∀ (A : Type u) [CommRing A] (𝔪 : Ideal A), 𝔪.IsPrime → ∀ (Y Y' : Scheme.{u})
      (q : Y ⟶ Spec (.of A)) (f g : Y ⟶ Y'),
      (∀ (m : ℕ) (Ym : Scheme.{u}) (ιm : Ym ⟶ Y) (qm : Ym ⟶ Spec (.of (A ⧸ 𝔪 ^ m))),
        IsPullback ιm qm q (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ m)))) →
        ιm ≫ f = ιm ≫ g) → ∀ y : Y, (q y).asIdeal = 𝔪 → f y = g y := by
    intro A _ 𝔪 h𝔪 Y Y' q f g hth y hy
    have hker : RingHom.ker (Ideal.Quotient.mk (𝔪 ^ 1)) ≤ 𝔪 := by rw [Ideal.mk_ker, pow_one]
    haveI hpr : (𝔪.map (Ideal.Quotient.mk (𝔪 ^ 1))).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    let t : Spec (.of (A ⧸ 𝔪 ^ 1)) := ⟨𝔪.map (Ideal.Quotient.mk (𝔪 ^ 1)), hpr⟩
    have ht : q y = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ 1))) t := by
      apply PrimeSpectrum.ext
      rw [hy]
      show 𝔪 = Ideal.comap (Ideal.Quotient.mk (𝔪 ^ 1)) (𝔪.map (Ideal.Quotient.mk (𝔪 ^ 1)))
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
      exact (sup_eq_left.mpr hker).symm
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback y t ht
    have H := hth 1 _ _ _ (IsPullback.of_hasPullback q
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ 1)))))
    have H1 := congrArg (fun h : _ ⟶ Y' => h z) H
    simp only [Scheme.Hom.comp_apply] at H1
    rw [hz] at H1
    exact H1

  have s9 : ∀ (B B' : Type u) [CommRing B] [CommRing B'] (Y Y' : Scheme.{u})
      (a : Spec (.of B) ⟶ Y) (a' : Spec (.of B') ⟶ Y'), IsOpenImmersion a →
      ∀ (f g : Y ⟶ Y') (φf φg : B' →+* B), a ≫ f = Spec.map (CommRingCat.ofHom φf) ≫ a' →
      a ≫ g = Spec.map (CommRingCat.ofHom φg) ≫ a' → ∀ (s : B) (p : Spec (.of B)),
      s ∉ p.asIdeal → (∀ b : B', s * (φf b - φg b) = 0) →
      ∃ (W : Scheme.{u}) (w : W ⟶ Y), IsOpenImmersion w ∧ a p ∈ Set.range w ∧
        w ≫ f = w ≫ g := by
    intro B B' _ _ Y Y' a a' ha f g φf φg hf hg s p hs hkill
    haveI := ha
    refine ⟨Spec (.of (Localization.Away s)),
      Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away s))) ≫ a, inferInstance,
      ?_, ?_⟩
    · have hp : p ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away s))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s]
        exact hs
      obtain ⟨p0, hp0⟩ : ∃ p0 : Spec (.of (Localization.Away s)),
          Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away s))) p0 = p := by
        obtain ⟨p0, hp0⟩ := hp
        exact ⟨p0, hp0⟩
      exact ⟨p0, by rw [Scheme.Hom.comp_apply, hp0]⟩
    · have hring : (algebraMap B (Localization.Away s)).comp φf =
          (algebraMap B (Localization.Away s)).comp φg := by
        refine RingHom.ext fun b => ?_
        simp only [RingHom.comp_apply]
        have h1 : algebraMap B (Localization.Away s) s *
            algebraMap B (Localization.Away s) (φf b - φg b) = 0 := by
          rw [← map_mul, hkill, map_zero]
        have h2 := (IsUnit.mul_right_eq_zero (IsLocalization.Away.algebraMap_isUnit s)).mp h1
        rw [map_sub, sub_eq_zero] at h2
        exact h2
      rw [Category.assoc, Category.assoc, hf, hg, ← Category.assoc, ← Category.assoc,
        ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        hring]

  have s4 : ∀ (A : Type u) [CommRing A] (Y Y' : Scheme.{u}) [IsLocallyNoetherian Y]
      (q : Y ⟶ Spec (.of A)) (f g : Y ⟶ Y') (y : Y), f y = g y →
      ∃ (B B' : Type u) (_ : CommRing B) (_ : CommRing B') (_ : IsNoetherianRing B)
        (a : Spec (.of B) ⟶ Y) (a' : Spec (.of B') ⟶ Y') (ψ : A →+* B) (φf φg : B' →+* B)
        (p : Spec (.of B)), IsOpenImmersion a ∧ IsOpenImmersion a' ∧ a p = y ∧
        a ≫ q = Spec.map (CommRingCat.ofHom ψ) ∧
        a ≫ f = Spec.map (CommRingCat.ofHom φf) ≫ a' ∧
        a ≫ g = Spec.map (CommRingCat.ofHom φg) ≫ a' := by
    intro A _ Y Y' _ q f g y hfg
    obtain ⟨V', hV', hzV', -⟩ := exists_isAffineOpen_mem_and_subset (x := f y)
      (U := (⊤ : Y'.Opens)) trivial
    have hyO : y ∈ f ⁻¹ᵁ V' ⊓ g ⁻¹ᵁ V' := by
      refine ⟨?_, ?_⟩
      · show y ∈ f ⁻¹ᵁ V'
        rw [Scheme.Hom.mem_preimage]; exact hzV'
      · show y ∈ g ⁻¹ᵁ V'
        rw [Scheme.Hom.mem_preimage, ← hfg]; exact hzV'
    obtain ⟨V, hV, hyV, hVO⟩ := exists_isAffineOpen_mem_and_subset hyO
    haveI := hV.isOpenImmersion_fromSpec
    haveI := hV'.isOpenImmersion_fromSpec
    have hVmem : ∀ z, hV.fromSpec z ∈ V := by
      intro z
      have : hV.fromSpec z ∈ Set.range hV.fromSpec := ⟨z, rfl⟩
      rwa [hV.range_fromSpec] at this
    have hfr : Set.range ⇑(hV.fromSpec ≫ f) ⊆ Set.range hV'.fromSpec := by
      rw [hV'.range_fromSpec]
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      have := (hVO (hVmem z)).1
      exact (Scheme.Hom.mem_preimage f).mp this
    have hgr : Set.range ⇑(hV.fromSpec ≫ g) ⊆ Set.range hV'.fromSpec := by
      rw [hV'.range_fromSpec]
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      have := (hVO (hVmem z)).2
      exact (Scheme.Hom.mem_preimage g).mp this
    have hyr : y ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hyV
    obtain ⟨p, hp⟩ := hyr
    refine ⟨Γ(Y, V), Γ(Y', V'), inferInstance, inferInstance,
      IsLocallyNoetherian.component_noetherian ⟨V, hV⟩, hV.fromSpec, hV'.fromSpec,
      (Spec.preimage (hV.fromSpec ≫ q)).hom,
      (Spec.preimage (IsOpenImmersion.lift _ _ hfr)).hom,
      (Spec.preimage (IsOpenImmersion.lift _ _ hgr)).hom, p, inferInstance, inferInstance, hp,
      ?_, ?_, ?_⟩
    · exact (Spec.map_preimage _).symm
    · have e : Spec.map (CommRingCat.ofHom (Spec.preimage (IsOpenImmersion.lift _ _ hfr)).hom) =
          IsOpenImmersion.lift _ _ hfr := Spec.map_preimage _
      rw [e, IsOpenImmersion.lift_fac]
    · have e : Spec.map (CommRingCat.ofHom (Spec.preimage (IsOpenImmersion.lift _ _ hgr)).hom) =
          IsOpenImmersion.lift _ _ hgr := Spec.map_preimage _
      rw [e, IsOpenImmersion.lift_fac]

  have s2 : ∀ (A B B' : Type u) [CommRing A] [CommRing B] [CommRing B'] (𝔪 : Ideal A)
      (ψ : A →+* B) (Y Y' : Scheme.{u}) (q : Y ⟶ Spec (.of A)) (a : Spec (.of B) ⟶ Y)
      (a' : Spec (.of B') ⟶ Y'), IsOpenImmersion a' → ∀ (f g : Y ⟶ Y') (φf φg : B' →+* B),
      a ≫ q = Spec.map (CommRingCat.ofHom ψ) →
      a ≫ f = Spec.map (CommRingCat.ofHom φf) ≫ a' →
      a ≫ g = Spec.map (CommRingCat.ofHom φg) ≫ a' →
      (∀ (m : ℕ) (Ym : Scheme.{u}) (ιm : Ym ⟶ Y) (qm : Ym ⟶ Spec (.of (A ⧸ 𝔪 ^ m))),
        IsPullback ιm qm q (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ m)))) →
        ιm ≫ f = ιm ≫ g) → ∀ (m : ℕ) (b : B'), φf b - φg b ∈ (𝔪.map ψ) ^ m := by
    intro A B B' _ _ _ 𝔪 ψ Y Y' q a a' ha' f g φf φg hq hf hg hth m b
    haveI := ha'
    have hle : 𝔪 ^ m ≤ Ideal.comap ψ ((𝔪.map ψ) ^ m) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    have hcomp : (Ideal.quotientMap ((𝔪.map ψ) ^ m) ψ hle).comp (Ideal.Quotient.mk (𝔪 ^ m)) =
        (Ideal.Quotient.mk ((𝔪.map ψ) ^ m)).comp ψ := Ideal.quotientMap_comp_mk hle
    have hw : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk ((𝔪.map ψ) ^ m))) ≫ a) ≫ q =
        Spec.map (CommRingCat.ofHom (Ideal.quotientMap ((𝔪.map ψ) ^ m) ψ hle)) ≫
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ m))) := by
      rw [Category.assoc, hq, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp, hcomp]
    have H := hth m _ _ _ (IsPullback.of_hasPullback q
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ m)))))
    have H2 := congrArg (fun h => Limits.pullback.lift _ _ hw ≫ h) H
    simp only [Limits.pullback.lift_fst_assoc, Category.assoc] at H2
    rw [hf, hg, ← Category.assoc, ← Category.assoc, cancel_mono, ← Spec.map_comp,
      ← Spec.map_comp] at H2
    have H3 := Spec.map_injective H2
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at H3
    have H4 := congrArg (fun h => h b) (congrArg CommRingCat.Hom.hom H3)
    simp only [CommRingCat.hom_ofHom, RingHom.comp_apply] at H4
    rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem] at H4
    exact H4

  intro A _ _ _ 𝔪 h𝔪 Y Y' q q' hq _ f g _ _ hth L _ γ hγ X x y hxy
  haveI := hq
  have h𝔪p : 𝔪.IsPrime := h𝔪.isPrime
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian q
  set U : Set Y := {z | ∃ (W : Scheme.{u}) (w : W ⟶ Y), IsOpenImmersion w ∧ z ∈ Set.range w ∧
    w ≫ f = w ≫ g} with hUdef
  have hUo : IsOpen U := by
    rw [isOpen_iff_forall_mem_open]
    rintro z ⟨W, w, hw, hz, he⟩
    haveI := hw
    refine ⟨Set.range w, ?_, IsOpenImmersion.isOpen_range w, hz⟩
    intro z' hz'
    exact ⟨W, w, hw, hz', he⟩
  have hclosed : ∀ z : Y, (q z).asIdeal = 𝔪 → z ∈ U := by
    intro z hz
    have hfz := s8 A 𝔪 h𝔪p Y Y' q f g hth z hz
    obtain ⟨B, B', _, _, _, a, a', ψ, φf, φg, p, ha, ha', hap, haq, haf, hag⟩ :=
      s4 A Y Y' q f g z hfz
    have hJ : 𝔪.map ψ ≤ p.asIdeal := by
      have hc : Ideal.comap ψ p.asIdeal = 𝔪 := by
        rw [← hz, ← hap, ← Scheme.Hom.comp_apply, haq]
        rfl
      rw [← hc]
      exact Ideal.map_comap_le
    obtain ⟨s, hs, hsk⟩ := s1 B (𝔪.map ψ) p.asIdeal p.2 hJ (Set.range fun b => φf b - φg b)
      (by
        rintro _ ⟨b, rfl⟩ m
        exact s2 A B B' 𝔪 ψ Y Y' q a a' ha' f g φf φg haq haf hag hth m b)
    obtain ⟨W, w, hw, hpw, he⟩ := s9 B B' Y Y' a a' ha f g φf φg haf hag s p hs
      (fun b => hsk _ ⟨b, rfl⟩)
    rw [hap] at hpw
    exact ⟨W, w, hw, hpw, he⟩
  apply s6 X Y Y' x f g
  intro t
  apply s5 A 𝔪 h𝔪p Y q hq U hUo hclosed
  have h1 : q (x t) = Spec.map (CommRingCat.ofHom γ) (y t) := by
    rw [← Scheme.Hom.comp_apply, hxy, Scheme.Hom.comp_apply]
  rw [h1]
  show Ideal.comap γ (y t).asIdeal = ⊥
  haveI := (y t).2
  rw [Ideal.eq_bot_of_prime (y t).asIdeal]
  exact Ideal.comap_bot_of_injective γ hγ

theorem wcpa_dj_lqcf_rigid_extension : ∀ (k Ω : Type u) [Field k] [IsAlgClosed k] [Field Ω] [IsAlgClosed Ω] [Algebra k Ω] (C C' D D' : Scheme.{u}) (c : C ⟶ Spec (.of k)) (c' : C' ⟶ Spec (.of k)) (d : D ⟶ Spec (.of Ω)) (d' : D' ⟶ Spec (.of Ω)) (p : D ⟶ C) (p' : D' ⟶ C') (n : ℕ) (τ : Fin n → (Spec (.of k) ⟶ C)) (τ' : Fin n → (Spec (.of k) ⟶ C')), IsPullback p d c (Spec.map (CommRingCat.ofHom (algebraMap k Ω))) → IsPullback p' d' c' (Spec.map (CommRingCat.ofHom (algebraMap k Ω))) → 3 ≤ n → wcpaDjStablePtd c n τ → wcpaDjStablePtd c' n τ' → GeometricallyConnected c → GeometricallyConnected c' → ∀ Φ : D ⟶ D', IsIso Φ → Φ ≫ d' = d → (∀ (i : Fin n) (σ : Spec (.of Ω) ⟶ D) (σ' : Spec (.of Ω) ⟶ D'), σ ≫ d = 𝟙 _ → σ ≫ p = Spec.map (CommRingCat.ofHom (algebraMap k Ω)) ≫ τ i → σ' ≫ d' = 𝟙 _ → σ' ≫ p' = Spec.map (CommRingCat.ofHom (algebraMap k Ω)) ≫ τ' i → σ ≫ Φ = σ') → ∃ φ : C ⟶ C', φ ≫ c' = c ∧ Φ ≫ p' = p ≫ φ :=
by
  intro k Ω _ _ _ _ _ C C' D D' c c' d d' p p' n τ τ' hpb hpb' hn hst hst' hgc hgc' Φ hΦ hΦd hmark

  have hτ : ∀ i, τ i ≫ c = 𝟙 _ := hst.2.1.1
  have hτ' : ∀ i, τ' i ≫ c' = 𝟙 _ := hst'.2.1.1
  haveI hcp : IsProper c := hst.1.2.1
  haveI hcp' : IsProper c' := hst'.1.2.1
  obtain ⟨A, _, _, _, _, β, CA, C'A, pA, qA, p'A, q'A, G, H, jD, jD', hβ, hpbA, hpbA', hGq, hGH,
    hHG, hj1, hj2, hj1', hj2', hΦj, hGmark⟩ :=
    wcpa_dj_lqcf_spread_marked_iso k Ω C C' D D' c c' d d' p p' n τ τ' hpb hpb' hcp hcp' hτ hτ'
      Φ hΦ hΦd hmark
  haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A

  obtain ⟨s⟩ : Nonempty (A →ₐ[k] k) := by
    obtain ⟨M, hM⟩ := Ideal.exists_maximal A
    letI := Ideal.Quotient.field M
    haveI : Algebra.FiniteType k (A ⧸ M) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k M)
        (Ideal.Quotient.mkₐ_surjective k M)
    haveI : Module.Finite k (A ⧸ M) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ M)
    have hb : Function.Bijective (algebraMap k (A ⧸ M)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    exact ⟨((AlgEquiv.ofBijective (Algebra.ofId k (A ⧸ M)) hb).symm.toAlgHom).comp
      (Ideal.Quotient.mkₐ k M)⟩
  have hse : Spec.map (CommRingCat.ofHom s.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k A)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : s.toRingHom.comp (algebraMap k A) = RingHom.id k := by
      ext a; simp
    rw [this, CommRingCat.ofHom_id, Spec.map_id]
  have hmax : (RingHom.ker s.toRingHom).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ (fun a => ⟨algebraMap k A a, by simp⟩)

  obtain ⟨ι₀, hι₀p, hι₀q⟩ : ∃ ι₀ : C ⟶ CA, ι₀ ≫ pA = 𝟙 C ∧
      ι₀ ≫ qA = c ≫ Spec.map (CommRingCat.ofHom s.toRingHom) :=
    ⟨hpbA.lift (𝟙 C) (c ≫ Spec.map (CommRingCat.ofHom s.toRingHom))
      (by rw [Category.id_comp, Category.assoc, hse, Category.comp_id]),
      hpbA.lift_fst _ _ _, hpbA.lift_snd _ _ _⟩
  obtain ⟨ι₀', hι₀'p, hι₀'q⟩ : ∃ ι₀' : C' ⟶ C'A, ι₀' ≫ p'A = 𝟙 C' ∧
      ι₀' ≫ q'A = c' ≫ Spec.map (CommRingCat.ofHom s.toRingHom) :=
    ⟨hpbA'.lift (𝟙 C') (c' ≫ Spec.map (CommRingCat.ofHom s.toRingHom))
      (by rw [Category.id_comp, Category.assoc, hse, Category.comp_id]),
      hpbA'.lift_fst _ _ _, hpbA'.lift_snd _ _ _⟩
  have hHq : H ≫ qA = q'A := by
    rw [← hGq, ← Category.assoc, hHG, Category.id_comp]
  obtain ⟨φ, hφdef⟩ : ∃ φ : C ⟶ C', φ = ι₀ ≫ G ≫ p'A := ⟨_, rfl⟩
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : C' ⟶ C, ψ = ι₀' ≫ H ≫ pA := ⟨_, rfl⟩
  have hφc : φ ≫ c' = c := by
    rw [hφdef, Category.assoc, Category.assoc, hpbA'.w, reassoc_of% hGq, reassoc_of% hι₀q, hse,
      Category.comp_id]
  have hψc : ψ ≫ c = c' := by
    rw [hψdef, Category.assoc, Category.assoc, hpbA.w, reassoc_of% hHq, reassoc_of% hι₀'q, hse,
      Category.comp_id]
  have hι : ι₀ ≫ G = φ ≫ ι₀' := by
    apply hpbA'.hom_ext
    · rw [Category.assoc, Category.assoc, hι₀'p, Category.comp_id, hφdef]
    · rw [Category.assoc, Category.assoc, hGq, hι₀q, hι₀'q, reassoc_of% hφc]
  have hι' : ι₀' ≫ H = ψ ≫ ι₀ := by
    apply hpbA.hom_ext
    · rw [Category.assoc, Category.assoc, hι₀p, Category.comp_id, hψdef]
    · rw [Category.assoc, Category.assoc, hHq, hι₀'q, hι₀q, reassoc_of% hψc]
  have hφψ : φ ≫ ψ = 𝟙 C := by
    rw [hψdef, ← Category.assoc, ← hι, Category.assoc, reassoc_of% hGH, hι₀p]
  have hψφ : ψ ≫ φ = 𝟙 C' := by
    rw [hφdef, ← Category.assoc, ← hι', Category.assoc, reassoc_of% hHG, hι₀'p]

  have hτφ : ∀ i, τ i ≫ φ = τ' i := by
    intro i
    obtain ⟨t, ht1, ht2⟩ : ∃ t : Spec (.of A) ⟶ CA,
        t ≫ pA = Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ i ∧ t ≫ qA = 𝟙 _ :=
      ⟨hpbA.lift (Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ i) (𝟙 _)
        (by rw [Category.assoc, hτ i, Category.comp_id, Category.id_comp]),
        hpbA.lift_fst _ _ _, hpbA.lift_snd _ _ _⟩
    obtain ⟨t', ht'1, ht'2⟩ : ∃ t' : Spec (.of A) ⟶ C'A,
        t' ≫ p'A = Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ' i ∧ t' ≫ q'A = 𝟙 _ :=
      ⟨hpbA'.lift (Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ' i) (𝟙 _)
        (by rw [Category.assoc, hτ' i, Category.comp_id, Category.id_comp]),
        hpbA'.lift_fst _ _ _, hpbA'.lift_snd _ _ _⟩
    have htt' : t ≫ G = t' := hGmark i t t' ht2 ht1 ht'2 ht'1
    have hst_i : Spec.map (CommRingCat.ofHom s.toRingHom) ≫ t = τ i ≫ ι₀ := by
      apply hpbA.hom_ext
      · rw [Category.assoc, Category.assoc, ht1, hι₀p, Category.comp_id, reassoc_of% hse]
      · rw [Category.assoc, Category.assoc, ht2, hι₀q, Category.comp_id, reassoc_of% (hτ i)]
    rw [hφdef, ← Category.assoc, ← hst_i, Category.assoc, reassoc_of% htt', ht'1,
      reassoc_of% hse]
  have hτψ : ∀ i, τ' i ≫ ψ = τ i := by
    intro i
    rw [← hτφ i, Category.assoc, hφψ, Category.comp_id]

  obtain ⟨φA, hφAp, hφAq⟩ : ∃ φA : CA ⟶ C'A, φA ≫ p'A = pA ≫ φ ∧ φA ≫ q'A = qA :=
    ⟨hpbA'.lift (pA ≫ φ) qA (by rw [Category.assoc, hφc, hpbA.w]),
      hpbA'.lift_fst _ _ _, hpbA'.lift_snd _ _ _⟩
  obtain ⟨ψA, hψAp, hψAq⟩ : ∃ ψA : C'A ⟶ CA, ψA ≫ pA = p'A ≫ ψ ∧ ψA ≫ qA = q'A :=
    ⟨hpbA.lift (p'A ≫ ψ) q'A (by rw [Category.assoc, hψc, hpbA'.w]),
      hpbA.lift_fst _ _ _, hpbA.lift_snd _ _ _⟩
  have hψφA : ψA ≫ φA = 𝟙 C'A := by
    apply hpbA'.hom_ext
    · rw [Category.assoc, hφAp, reassoc_of% hψAp, hψφ, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, hφAq, hψAq, Category.id_comp]
  have hΨq : (G ≫ ψA) ≫ qA = qA := by
    rw [Category.assoc, hψAq, hGq]
  have hΨmark : ∀ (i : Fin n) (t : Spec (.of A) ⟶ CA), t ≫ qA = 𝟙 _ →
      t ≫ pA = Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ i → t ≫ (G ≫ ψA) = t := by
    intro i t h1 h2
    obtain ⟨t', ht'1, ht'2⟩ : ∃ t' : Spec (.of A) ⟶ C'A,
        t' ≫ p'A = Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ' i ∧ t' ≫ q'A = 𝟙 _ :=
      ⟨hpbA'.lift (Spec.map (CommRingCat.ofHom (algebraMap k A)) ≫ τ' i) (𝟙 _)
        (by rw [Category.assoc, hτ' i, Category.comp_id, Category.id_comp]),
        hpbA'.lift_fst _ _ _, hpbA'.lift_snd _ _ _⟩
    have htG : t ≫ G = t' := hGmark i t t' h1 h2 ht'2 ht'1
    have ht'ψ : t' ≫ ψA = t := by
      apply hpbA.hom_ext
      · rw [Category.assoc, hψAp, reassoc_of% ht'1, hτψ i, h2]
      · rw [Category.assoc, hψAq, ht'2, h1]
    rw [← Category.assoc, htG, ht'ψ]
  have hΨfib : ∀ ι : C ⟶ CA, ι ≫ pA = 𝟙 C →
      ι ≫ qA = c ≫ Spec.map (CommRingCat.ofHom s.toRingHom) → ι ≫ (G ≫ ψA) = ι := by
    intro ι h1 h2
    have hιeq : ι = ι₀ := hpbA.hom_ext (by rw [h1, hι₀p]) (by rw [h2, hι₀q])
    have hι₀'ψA : ι₀' ≫ ψA = ψ ≫ ι₀ := by
      apply hpbA.hom_ext
      · rw [Category.assoc, Category.assoc, hψAp, reassoc_of% hι₀'p, hι₀p, Category.comp_id]
      · rw [Category.assoc, Category.assoc, hψAq, hι₀'q, hι₀q, reassoc_of% hψc]
    rw [hιeq, ← Category.assoc, hι, Category.assoc, hι₀'ψA, reassoc_of% hφψ]

  have hder := wcpa_dj_lqcf_no_marked_derivation k C c n τ hn hst hgc
  have hthick := wcpa_dj_lqcf_infinitesimal_rigid k C c n τ hτ hder A s CA pA qA hpbA (G ≫ ψA)
    hΨq hΨmark hΨfib

  haveI hqAp : IsProper qA := MorphismProperty.of_isPullback (P := @IsProper) hpbA hcp
  haveI hq'Ap : IsProper q'A := MorphismProperty.of_isPullback (P := @IsProper) hpbA' hcp'
  have hthk : ∀ (m : ℕ) (Ym : Scheme.{u}) (ιm : Ym ⟶ CA)
      (qm : Ym ⟶ Spec (.of (A ⧸ RingHom.ker s.toRingHom ^ m))),
      IsPullback ιm qm qA (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (RingHom.ker s.toRingHom ^ m)))) → ιm ≫ G = ιm ≫ φA := by
    intro m Ym ιm qm hpbm
    have h := hthick m Ym ιm qm hpbm
    calc ιm ≫ G = ιm ≫ G ≫ ψA ≫ φA := by rw [hψφA, Category.comp_id]
      _ = (ιm ≫ G ≫ ψA) ≫ φA := by simp only [Category.assoc]
      _ = ιm ≫ φA := by rw [h]
  have hC5 : jD ≫ G = jD ≫ φA :=
    wcpa_dj_lqcf_formal_to_generic A (RingHom.ker s.toRingHom) hmax CA C'A qA q'A hqAp
      inferInstance G φA hGq hφAq hthk Ω β.toRingHom (fun a b h => hβ h) D jD d hj2
  refine ⟨φ, hφc, ?_⟩
  rw [← hj1', reassoc_of% hΦj, reassoc_of% hC5, hφAp, ← hj1, Category.assoc]

theorem wcpa_dj_lqg_closed_fibre_algebraic : ∀ (T Z Z' : Scheme.{u}) (u : Z ⟶ T) (u' : Z' ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T ⟶ Z')), 3 ≤ n → wcpaDjStablePtd u n τ → wcpaDjStablePtd u' n τ' → GeometricallyConnected u → GeometricallyConnected u' → ∀ (B : Scheme.{u}) (b : B ⟶ T) (Φ : Limits.pullback u b ⟶ Limits.pullback u' b), IsIso Φ → Φ ≫ Limits.pullback.snd u' b = Limits.pullback.snd u b → (∀ (i : Fin n) (σ : B ⟶ Limits.pullback u b) (σ' : B ⟶ Limits.pullback u' b), σ ≫ Limits.pullback.snd u b = 𝟙 B → σ ≫ Limits.pullback.fst u b = b ≫ τ i → σ' ≫ Limits.pullback.snd u' b = 𝟙 B → σ' ≫ Limits.pullback.fst u' b = b ≫ τ' i → σ ≫ Φ = σ') → ∀ (x : B ⟶ Limits.pullback u b) (g : B ⟶ Limits.pullback u u'), x ≫ Limits.pullback.snd u b = 𝟙 B → g ≫ Limits.pullback.fst u u' = x ≫ Limits.pullback.fst u b → g ≫ Limits.pullback.snd u u' = x ≫ Φ ≫ Limits.pullback.fst u' b → ∀ q ∈ Set.range g, ((Limits.pullback.fst u u').residueFieldMap q).hom.IsIntegral :=
by
  have hSB : ∀ {Z T T' : Scheme.{u}} (uu : Z ⟶ T) (n : ℕ)
      (τ : Fin n → (T ⟶ Z)) (b : T' ⟶ T), wcpaDjStablePtd uu n τ →
      ∃ τ' : Fin n → (T' ⟶ Limits.pullback uu b),
        wcpaDjStablePtd (Limits.pullback.snd uu b) n τ' ∧
        (∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T') ∧
        (∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i) := by
    have wcpa_dj_mm_section_point_unique : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
        (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
        τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
      intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
      have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
        intro x
        rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
      have hgτ : ∀ x : V, g (τ x) = x := by
        intro x
        rw [← Scheme.Hom.comp_apply, H3]
        rfl
      constructor
      · intro h
        have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
          rw [H3, H2]
          exact IsPullback.id_horiz b
        have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
        obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
        have hg : g c = p := by rw [← hp, hgτ]
        rw [hg, hp]
      · intro h
        calc ψ c = ψ (τ (g c)) := congrArg ψ h
          _ = σ (b (g c)) := hcomp (g c)
    have wcpa_dj_mm_semistable_basechange : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
        wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) := by
      have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
          (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
            Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
        intro A B _ _ _ _ σ n
        rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
        apply Ideal.pow_right_mono
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
        intro h
        exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
      have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
          (x : AdicCompletion I A),
          Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
        intro A _ I m n h x
        obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
        rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
          Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
        have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
        simpa [smul_eq_mul, Ideal.mul_top] using this
      have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
          (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
            AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
            AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
            AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
        intro A B _ _ _ _ σ
        let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
            B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
          (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
            (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
        have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
            f n x = Ideal.Quotient.mk _ (σ a) := by
          intro n x a ha
          show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
            (AdicCompletion.evalₐ _ n x) = _
          rw [ha, Ideal.quotientMap_mk]
          rfl
        have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
            (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
          intro m n hle
          ext x
          obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
          have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
            rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
          rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
            Ideal.Quotient.factor_mk]
        refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
        intro n x a ha
        rw [AdicCompletion.evalₐ_liftRingHom]
        exact hf n x a ha
      have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
          (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
            AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
            Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
              algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
        intro A B _ _ _ _ σ
        obtain ⟨Φ, hΦ⟩ := hmap A B σ
        obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
        have h1 : Φ.comp Ψ = RingHom.id _ := by
          ext1 y
          apply AdicCompletion.ext_evalₐ
          intro n
          obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
          rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
            RingHom.id_apply, hb]
        have h2 : Ψ.comp Φ = RingHom.id _ := by
          ext1 y
          apply AdicCompletion.ext_evalₐ
          intro n
          obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
          rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
            RingHom.id_apply, hb]
        refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
        intro a
        apply AdicCompletion.ext_evalₐ
        intro n
        have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
            AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
              Ideal.Quotient.mk _ r := by
          intro R _ I r
          rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
            RingHom.id_apply]
        show AdicCompletion.evalₐ _ n (Φ _) = _
        rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
      have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
          (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
            i.stalkMap x =
          (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
        intro K _ X Y i p q hi x
        have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
            i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
        rw [← hi, Scheme.Hom.comp_appTop]
        simp only [Category.assoc]
        exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
      have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
          ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
            SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
        intro X Y S i _ p q hi W' hW'
        have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
          rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
        have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
          IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
        rw [hfac']
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
      intro M P'' Z φ u hss
      obtain ⟨hflat, hprop, hfib⟩ := hss
      haveI := hflat
      haveI := hprop
      refine ⟨inferInstance, inferInstance, ?_⟩
      intro K _ _ s w
      set i := (Limits.pullbackLeftPullbackSndIso u φ s).hom with hi_def
      have hi : i ≫ Limits.pullback.snd u (s ≫ φ) =
          Limits.pullback.snd (Limits.pullback.snd u φ) s :=
        Limits.pullbackLeftPullbackSndIso_hom_snd u φ s
      rcases hfib K (s ≫ φ) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
      · left
        refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
        exact s3 i _ _ hi W' hsm
      · right
        let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
        obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
        refine ⟨Φ.trans e₀, ?_⟩
        have h2 := s2 K i _ _ hi w
        ext1 k
        have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
            (Limits.pullback.snd (Limits.pullback.snd u φ) s).appTop ≫
            (Limits.pullback (Limits.pullback.snd u φ) s).presheaf.germ ⊤ w trivial).hom k) =
            ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u (s ≫ φ)).appTop ≫
            (Limits.pullback u (s ≫ φ)).presheaf.germ ⊤ (i w) trivial).hom k := by
          rw [← h2, RingEquiv.symm_apply_eq]
          rfl
        have := RingHom.congr_fun he₀ k
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
        rw [RingEquiv.trans_apply, hΦ, hk]
        exact this
    intro Z T T' uu n τ b hst
    obtain ⟨hss, hsec, hstab⟩ := hst
    obtain ⟨hS1, hS2, hS3⟩ := hsec
    have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
        ∀ x, b (a x) = c x := by
      intro A B C a b c h x
      rw [← Scheme.Hom.comp_apply, h]
    let τ' : Fin n → (T' ⟶ Limits.pullback uu b) := fun i =>
      Limits.pullback.lift (b ≫ τ i) (𝟙 T')
        (by rw [Category.assoc, hS1 i, Category.comp_id, Category.id_comp])
    have E1 : ∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T' := fun i =>
      Limits.pullback.lift_snd _ _ _
    have E2 : ∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i := fun i =>
      Limits.pullback.lift_fst _ _ _
    have hpb : IsPullback (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) uu b :=
      IsPullback.of_hasPullback uu b

    have hsec' : wcpaDjSections (Limits.pullback.snd uu b) n τ' := by
      refine ⟨E1, ?_, ?_⟩
      · intro i i' p q hii' heq
        apply hS2 i i' (b p) (b q) hii'
        have h1 := congrArg (fun x => Limits.pullback.fst uu b x) heq
        simp only at h1
        rw [pt (E2 i) p, pt (E2 i') q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
        exact h1
      · intro i p
        obtain ⟨W, hW, hWsm⟩ := hS3 i (b p)
        refine ⟨Limits.pullback.fst uu b ⁻¹ᵁ W, ?_, ?_⟩
        · show Limits.pullback.fst uu b (τ' i p) ∈ W
          rw [pt (E2 i) p, Scheme.Hom.comp_apply]
          exact hW
        · have h1 : IsPullback (Limits.pullback.fst uu b ∣_ W) (Limits.pullback.fst uu b ⁻¹ᵁ W).ι
              W.ι (Limits.pullback.fst uu b) := isPullback_morphismRestrict _ W
          have h2 : IsPullback (Limits.pullback.fst uu b ∣_ W)
              ((Limits.pullback.fst uu b ⁻¹ᵁ W).ι ≫ Limits.pullback.snd uu b) (W.ι ≫ uu) b :=
            h1.paste_vert hpb
          exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

    have hstab' : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T')
        (E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s)),
        E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd uu b) s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) →
        3 ≤ (E ∩ closure Eᶜ).ncard +
          Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} := by
      intro K _ _ s E hE hdat
      obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
      obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd uu b) s ≅
          Limits.pullback uu (s ≫ b),
          e.hom ≫ Limits.pullback.fst uu (s ≫ b) =
            Limits.pullback.fst (Limits.pullback.snd uu b) s ≫ Limits.pullback.fst uu b ∧
          e.hom ≫ Limits.pullback.snd uu (s ≫ b) = Limits.pullback.snd (Limits.pullback.snd uu b) s :=
        ⟨_, Limits.pullbackLeftPullbackSndIso_hom_fst uu b s,
          Limits.pullbackLeftPullbackSndIso_hom_snd uu b s⟩
      obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s) ≃ₜ
          ↥(Limits.pullback uu (s ≫ b)), ∀ x, h x = e.hom x :=
        ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
      have hE0 : h '' E ∈ irreducibleComponents ↥(Limits.pullback uu (s ≫ b)) := by
        refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
          ?_ h.surjective hE
        intro y
        apply Set.Subsingleton.isPreirreducible
        intro a ha a' ha'
        exact h.injective (ha.trans ha'.symm)
      have hcnt : (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
        rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
        exact Set.ncard_image_of_injective _ h.injective
      have hdat0 : ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu (s ≫ b) := by
        refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
        · ext y
          constructor
          · rintro ⟨x, rfl⟩
            refine ⟨ι x, ?_, ?_⟩
            · rw [← hrange]; exact ⟨x, rfl⟩
            · rw [hh, Scheme.Hom.comp_apply]
          · rintro ⟨z, hz, rfl⟩
            rw [← hrange] at hz
            obtain ⟨x, rfl⟩ := hz
            exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
        · rw [hθ, Category.assoc, I2]
      have key := hstab K (s ≫ b) (h '' E) hE0 hdat0
      have hiff : ∀ i : Fin n,
          (∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)) ↔
          (∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)) := by
        intro i
        constructor
        · rintro ⟨x, hx, p, hp⟩
          refine ⟨h x, ⟨x, hx, rfl⟩, p, ?_⟩
          rw [hh, pt I1 x, Scheme.Hom.comp_apply, hp, pt (E2 i) (s p), Scheme.Hom.comp_apply,
            Scheme.Hom.comp_apply]
        · rintro ⟨y, ⟨x, hx, rfl⟩, p, hp⟩
          refine ⟨x, hx, p, ?_⟩
          set c := Limits.pullback.fst (Limits.pullback.snd uu b) s x with hc
          have e1 : Limits.pullback.fst uu b c = τ i (b (s p)) := by
            have h1 := pt I1 x
            rw [Scheme.Hom.comp_apply, ← hh, hp, Scheme.Hom.comp_apply] at h1
            exact h1.symm
          have e2 : Limits.pullback.snd uu b c = s p := by
            rw [hc, pt (Limits.pullback.condition (f := Limits.pullback.snd uu b) (g := s)) x,
              Scheme.Hom.comp_apply,
              Subsingleton.elim (Limits.pullback.snd (Limits.pullback.snd uu b) s x) p]
          have hc1 : Limits.pullback.fst uu b c = τ i (b (Limits.pullback.snd uu b c)) := by
            rw [e2]; exact e1
          have key2 := (wcpa_dj_mm_section_point_unique Z T T' (Limits.pullback uu b) uu b
            (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) (τ i) (τ' i) hpb (hS1 i) (E1 i)
            (E2 i) c).mp hc1
          rw [key2, e2]
      have hcard : Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} =
          Nat.card {i : Fin n // ∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)} :=
        Nat.card_congr (Equiv.subtypeEquivRight hiff)
      rw [hcard, ← hcnt]
      exact key
    exact ⟨τ', ⟨wcpa_dj_mm_semistable_basechange T T' Z b uu hss, hsec', hstab'⟩, E1, E2⟩

  have L5 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIntegralHom f] (x : X),
      (f.residueFieldMap x).hom.IsIntegral := by
    intro X Y f _ x
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := ⊤) trivial
    have hV : IsAffineOpen (f ⁻¹ᵁ U) := hU.preimage f
    have hφ : (f.app U).hom.IsIntegral := IsIntegralHom.isIntegral_app f U hU
    have hxV : x ∈ f ⁻¹ᵁ U := hxU
    have hnat := Scheme.evaluation_naturality f x hxU
    letI : Algebra (Y.residueField (f x)) (X.residueField x) := (f.residueFieldMap x).hom.toAlgebra
    have hcomp : (algebraMap (Y.residueField (f x)) (X.residueField x)).comp
        (Y.evaluation U (f x) hxU).hom =
