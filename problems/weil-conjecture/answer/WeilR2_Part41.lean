  have cσ : (ω ≫ x ≫ Limits.pullback.fst u b) ≫ u = 𝟙 _ ≫ w := by
    rw [Category.id_comp, Category.assoc, Category.assoc, Limits.pullback.condition,
      reassoc_of% hx, hwdef, hsq]
  obtain ⟨σx, hσxf, hσxs⟩ : ∃ σx : Spec (.of Ω) ⟶ Limits.pullback u w,
      σx ≫ Limits.pullback.fst u w = ω ≫ x ≫ Limits.pullback.fst u b ∧
      σx ≫ Limits.pullback.snd u w = 𝟙 _ :=
    ⟨Limits.pullback.lift _ _ cσ, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have cρ : Limits.pullback.fst u w ≫ u = (Limits.pullback.snd u w ≫ ω) ≫ b := by
    rw [Category.assoc, ← hsq, ← hwdef, Limits.pullback.condition]
  obtain ⟨ρ, hρf, hρs⟩ : ∃ ρ : Limits.pullback u w ⟶ Limits.pullback u b,
      ρ ≫ Limits.pullback.fst u b = Limits.pullback.fst u w ∧
      ρ ≫ Limits.pullback.snd u b = Limits.pullback.snd u w ≫ ω :=
    ⟨Limits.pullback.lift _ _ cρ, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hσρ : σx ≫ ρ = ω ≫ x := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hρf, hσxf, Category.assoc]
    · rw [Category.assoc, hρs, reassoc_of% hσxs, Category.assoc, hx, Category.comp_id]
  have hφ' : ∀ {Y : Scheme.{u}} (h : Limits.pullback u' ε ⟶ Y), p ≫ φ ≫ h = Φ' ≫ p' ≫ h := by
    intro Y h
    rw [← Category.assoc, ← hφ, Category.assoc]
  have key : σx ≫ p ≫ G = ω ≫ g := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hGf, hpf, hσxf, hg1]
    · simp only [Category.assoc]
      rw [hGs, hφ', hpf', hΦ'ρ ρ hρf hρs, reassoc_of% hσρ, hg2]
  obtain ⟨y⟩ := (inferInstance : Nonempty (Spec (.of Ω)))
  have hpt : g β = G (p (σx y)) := by
    have h1 := congrArg (fun (f : Spec (.of Ω) ⟶ Limits.pullback u u') => f y) key
    simp only [Scheme.Hom.comp_apply] at h1
    rw [h1, hω y]

  have hL3 := hP _ _ hGf.symm (L3 T Z u (b β) k ε hεdef)
  rw [hpt]
  have h2 := hL3 (p (σx y))
  rw [rfm_comp] at h2
  exact RingHom.IsIntegral.tower_bot _ _ (RingHom.injective _) h2

theorem wcpa_dj_lie_dvr_realize : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (x ξ : X), ξ ⤳ x → ξ ≠ x → ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsDiscreteValuationRing R) (h : Spec (.of R) ⟶ X), h (IsLocalRing.closedPoint R) = x ∧ ∀ y : Spec (.of R), y ≠ IsLocalRing.closedPoint R → h y = ξ :=
by
  intro X _ x ξ hspec hne
  have s1 : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (x ξ : X), ξ ⤳ x → ξ ≠ x → ∃ (D : Type u) (_ : CommRing D) (_ : IsDomain D) (_ : IsLocalRing D) (_ : IsNoetherianRing D) (g : Spec (.of D) ⟶ X), ¬ IsField D ∧ g (IsLocalRing.closedPoint D) = x ∧ ∀ p : Spec (.of D), p.asIdeal = ⊥ → g p = ξ := by
    intro X _ x ξ hspec hne
    have hξ : ξ ∈ Set.range (X.fromSpecStalk x) := by rw [Scheme.range_fromSpecStalk]; exact hspec
    obtain ⟨q, hq⟩ := hξ
    let q' : PrimeSpectrum (X.presheaf.stalk x) := q
    haveI : q'.asIdeal.IsPrime := q'.isPrime
    haveI : IsLocalRing (X.presheaf.stalk x ⧸ q'.asIdeal) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk q'.asIdeal) Ideal.Quotient.mk_surjective
    let π : X.presheaf.stalk x →+* (X.presheaf.stalk x ⧸ q'.asIdeal) := Ideal.Quotient.mk q'.asIdeal
    let g : Spec (.of (X.presheaf.stalk x ⧸ q'.asIdeal)) ⟶ X :=
      (Spec.map (CommRingCat.ofHom π) : Spec (.of (X.presheaf.stalk x ⧸ q'.asIdeal)) ⟶ Spec (X.presheaf.stalk x)) ≫ X.fromSpecStalk x
    have hg : ∀ p : Spec (.of (X.presheaf.stalk x ⧸ q'.asIdeal)),
        g p = X.fromSpecStalk x (PrimeSpectrum.comap π p) := fun p =>
      (Scheme.Hom.comp_apply _ _ p).trans (congrArg _ (Spec.map_apply _ p))
    have hcp : PrimeSpectrum.comap π (IsLocalRing.closedPoint (X.presheaf.stalk x ⧸ q'.asIdeal)) =
        IsLocalRing.closedPoint (X.presheaf.stalk x) := by
      apply PrimeSpectrum.ext
      haveI : (IsLocalRing.maximalIdeal (X.presheaf.stalk x ⧸ q'.asIdeal)).IsMaximal :=
        IsLocalRing.maximalIdeal.isMaximal _
      exact IsLocalRing.eq_maximalIdeal
        (Ideal.comap_isMaximal_of_surjective π Ideal.Quotient.mk_surjective
          (K := IsLocalRing.maximalIdeal (X.presheaf.stalk x ⧸ q'.asIdeal)))
    have hcl : g (IsLocalRing.closedPoint (X.presheaf.stalk x ⧸ q'.asIdeal)) = x :=
      (hg _).trans ((congrArg (X.fromSpecStalk x) hcp).trans Scheme.fromSpecStalk_closedPoint)
    have hgen : ∀ p : Spec (.of (X.presheaf.stalk x ⧸ q'.asIdeal)), p.asIdeal = ⊥ → g p = ξ := by
      intro p hp
      have e : PrimeSpectrum.comap π p = q' := by
        apply PrimeSpectrum.ext
        change Ideal.comap π p.asIdeal = q'.asIdeal
        rw [hp, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact (hg p).trans ((congrArg (X.fromSpecStalk x) e).trans hq)
    refine ⟨X.presheaf.stalk x ⧸ q'.asIdeal, inferInstance, inferInstance, inferInstance,
      inferInstance, g, ?_, hcl, hgen⟩
    intro hF
    exact hne ((hgen _ (IsLocalRing.isField_iff_maximalIdeal_eq.mp hF)).symm.trans hcl)
  have s2 : ∀ (D K : Type u) [CommRing D] [IsDomain D] [IsLocalRing D] [Field K] [Algebra D K], Function.Injective (algebraMap D K) → ∃ V : ValuationSubring K, (∀ d : D, algebraMap D K d ∈ V) ∧ ∀ d ∈ IsLocalRing.maximalIdeal D, V.valuation (algebraMap D K d) < 1 := by
    intro D K _ _ _ _ _ hinj
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.range (algebraMap D K))
    obtain ⟨hsub, hloc⟩ := LocalSubring.le_def.mp hV
    have hmemA : ∀ d : D, algebraMap D K d ∈ (LocalSubring.range (algebraMap D K)).toSubring :=
      fun d => ⟨d, rfl⟩
    refine ⟨V, fun d => hsub (hmemA d), ?_⟩
    intro d hd
    by_contra hlt
    let a : V := ⟨algebraMap D K d, hsub (hmemA d)⟩
    have hnm : a ∉ IsLocalRing.maximalIdeal V := fun h => hlt ((V.valuation_lt_one_iff a).mp h)
    have hu : IsUnit a := by
      by_contra h; exact hnm ((IsLocalRing.mem_maximalIdeal _).mpr h)
    obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.mp hu
    have hu' : IsUnit (⟨algebraMap D K d, hsub (hmemA d)⟩ : V.toLocalSubring.toSubring) :=
      isUnit_iff_exists_inv.mpr ⟨⟨b.1, b.2⟩, Subtype.ext (congrArg Subtype.val hb)⟩
    have hu2 : IsUnit (⟨algebraMap D K d, hmemA d⟩ : (LocalSubring.range (algebraMap D K)).toSubring) :=
      hloc.map_nonunit _ hu'
    obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu2
    obtain ⟨e, he⟩ := w.2
    have h1 : algebraMap D K (d * e) = algebraMap D K 1 := by
      rw [map_mul, map_one, he]; exact congrArg Subtype.val hw
    exact (IsLocalRing.mem_maximalIdeal d).mp hd (isUnit_iff_exists_inv.mpr ⟨e, hinj h1⟩)
  have s3 : ∀ (D K : Type u) [CommRing D] [IsDomain D] [IsLocalRing D] [IsNoetherianRing D] [Field K] [Algebra D K] (V : ValuationSubring K), Function.Injective (algebraMap D K) → ¬ IsField D → (∀ d : D, algebraMap D K d ∈ V) → (∀ d ∈ IsLocalRing.maximalIdeal D, V.valuation (algebraMap D K d) < 1) → ∃ (S : Subalgebra D K) (t : ↥S), S.FG ∧ ¬ IsUnit t ∧ ∀ d ∈ IsLocalRing.maximalIdeal D, algebraMap D ↥S d ∈ Ideal.span {t} := by
    intro D K _ _ _ _ _ _ V hinj hnf hmem hlt
    classical
    set ι := algebraMap D K with hι
    set v := V.valuation with hv
    obtain ⟨T, hT⟩ := (IsNoetherian.noetherian (IsLocalRing.maximalIdeal D) :
      (IsLocalRing.maximalIdeal D).FG)
    have hm0 : IsLocalRing.maximalIdeal D ≠ ⊥ := fun h =>
      hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
    have hTm : ∀ g ∈ T, g ∈ IsLocalRing.maximalIdeal D := fun g hg => by
      rw [← hT]; exact Submodule.subset_span hg
    obtain ⟨g₀, hg₀T, hg₀⟩ : ∃ g₀ ∈ T, g₀ ≠ 0 := by
      by_contra h
      push_neg at h
      apply hm0
      rw [← hT, Submodule.span_eq_bot]
      exact fun g hg => h g hg
    obtain ⟨t₀, ht₀T, ht₀max⟩ := Finset.exists_max_image T (fun g => v (ι g)) ⟨g₀, hg₀T⟩
    have hιt₀ : ι t₀ ≠ 0 := by
      intro h0
      have h1 := ht₀max g₀ hg₀T
      rw [h0, Valuation.map_zero] at h1
      have h2 : v (ι g₀) = 0 := le_antisymm h1 zero_le'
      rw [Valuation.zero_iff] at h2
      exact hg₀ (hinj (by rw [h2, map_zero]))
    let q : D → K := fun g => ι g / ι t₀
    let BV : Subalgebra D K := { V.toSubring with algebraMap_mem' := hmem }
    have hq : ∀ g ∈ T, q g ∈ V := by
      intro g hg
      apply V.mem_of_valuation_le_one
      show v (ι g / ι t₀) ≤ 1
      rw [Valuation.map_div]
      have hpos : (0 : _) < v (ι t₀) := by
        rw [zero_lt_iff]; exact (Valuation.ne_zero_iff v).mpr hιt₀
      exact div_le_one_of_le₀ (ht₀max g hg) (le_of_lt hpos)
    let S : Subalgebra D K := Algebra.adjoin D ((T.image q : Finset K) : Set K)
    have hSV : S ≤ BV := by
      apply Algebra.adjoin_le
      intro y hy
      rw [Finset.coe_image] at hy
      obtain ⟨g, hg, rfl⟩ := hy
      exact hq g hg
    let t : S := algebraMap D S t₀
    have htval : (t : K) = ι t₀ := rfl
    refine ⟨S, t, ⟨T.image q, rfl⟩, ?_, ?_⟩
    · intro hu
      obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu
      have h1 : ι t₀ * (w : K) = 1 := by
        rw [← htval]; exact congrArg Subtype.val hw
      have hwV : (w : K) ∈ V := hSV w.2
      have h2 : v (w : K) ≤ 1 := (V.valuation_le_one_iff _).mpr hwV
      have h3 := hlt t₀ (hTm t₀ ht₀T)
      have h4 : v (ι t₀ * (w : K)) = 1 := by rw [h1, Valuation.map_one]
      rw [Valuation.map_mul] at h4
      have h5 : v (ι t₀) * v (w : K) ≤ v (ι t₀) := mul_le_of_le_one_right' h2
      rw [h4] at h5
      exact absurd (lt_of_le_of_lt h5 h3) (lt_irrefl 1)
    · intro d hd
      rw [← hT] at hd
      induction hd using Submodule.span_induction with
      | mem g hg =>
        rw [Ideal.mem_span_singleton']
        refine ⟨⟨q g, Algebra.subset_adjoin (by
          rw [Finset.coe_image]; exact ⟨g, hg, rfl⟩)⟩, ?_⟩
        apply Subtype.ext
        show ι g / ι t₀ * ι t₀ = ι g
        exact div_mul_cancel₀ _ hιt₀
      | zero => rw [map_zero]; exact Ideal.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact Ideal.add_mem _ hx hy
      | smul c x _ hx =>
        rw [smul_eq_mul, map_mul]
        exact Ideal.mul_mem_left _ _ hx
  have s4 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] (t : B), ¬ IsUnit t → ∃ (D₁ : Type u) (_ : CommRing D₁) (_ : IsDomain D₁) (_ : IsLocalRing D₁) (_ : IsNoetherianRing D₁) (_ : Ring.KrullDimLE 1 D₁) (g : B →+* D₁), Function.Injective g ∧ g t ∈ IsLocalRing.maximalIdeal D₁ := by
    intro B _ _ _ t ht
    have hne : Ideal.span {t} ≠ ⊤ := fun h => ht (Ideal.span_singleton_eq_top.mp h)
    obtain ⟨⟨𝔯, h𝔯⟩⟩ := Ideal.nonempty_minimalPrimes hne
    haveI h𝔯p : 𝔯.IsPrime := h𝔯.1.1
    have hle : 𝔯.primeCompl ≤ nonZeroDivisors B :=
      le_nonZeroDivisors_of_noZeroDivisors (fun h => h 𝔯.zero_mem)
    haveI : IsDomain (Localization.AtPrime 𝔯) := IsLocalization.isDomain_localization hle
    haveI : IsNoetherianRing (Localization.AtPrime 𝔯) :=
      IsLocalization.isNoetherianRing 𝔯.primeCompl _ inferInstance
    have hht := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {t}) 𝔯 h𝔯
    haveI : Ring.KrullDimLE 1 (Localization.AtPrime 𝔯) := by
      rw [Ring.krullDimLE_iff, IsLocalization.AtPrime.ringKrullDim_eq_height 𝔯]
      exact_mod_cast hht
    refine ⟨Localization.AtPrime 𝔯, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, algebraMap B _, IsLocalization.injective _ hle, ?_⟩
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔯]
    exact h𝔯.1.2 (Ideal.subset_span rfl)
  have s5 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [Ring.KrullDimLE 1 A] (a : A), a ≠ 0 → Module.length A (A ⧸ Ideal.span {a}) ≠ ⊤ := by
    intro A _ _ _ _ a ha
    haveI : Ring.KrullDimLE 0 (A ⧸ Ideal.span {a}) := by
      rw [Ring.krullDimLE_zero_iff]
      intro P hP
      have hP' : (P.comap (Ideal.Quotient.mk (Ideal.span {a}))).IsPrime := Ideal.IsPrime.comap _
      have hne : P.comap (Ideal.Quotient.mk (Ideal.span {a})) ≠ ⊥ := by
        intro h
        apply ha
        have : a ∈ P.comap (Ideal.Quotient.mk (Ideal.span {a})) := by
          rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self a)]
          exact P.zero_mem
        rw [h] at this
        exact this
      have hmax := hP'.isMaximal_of_ne_bot hne
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk (Ideal.span {a})) Ideal.Quotient.mk_surjective hmax with h | h
      · rw [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective] at h
        exact absurd h hP.ne_top
      · rwa [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective] at h
    haveI : IsArtinianRing (A ⧸ Ideal.span {a}) :=
      IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
    haveI : IsArtinian A (A ⧸ Ideal.span {a}) :=
      isArtinian_of_surjective_algebraMap (Ideal.Quotient.mk_surjective (I := Ideal.span {a}))
    haveI : IsNoetherian A (A ⧸ Ideal.span {a}) := inferInstance
    rw [Module.length_ne_top_iff, isFiniteLength_iff_isNoetherian_isArtinian]
    exact ⟨inferInstance, inferInstance⟩
  have s6 : ∀ (A K : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K], (∀ c : A, c ≠ 0 → Module.length A (A ⧸ Ideal.span {c}) ≠ ⊤) → ∀ (a : A), a ≠ 0 → ∀ M : Submodule A K, M.FG → Module.length A (↥M ⧸ (Ideal.span {a} • (⊤ : Submodule A ↥M))) ≤ Module.length A (A ⧸ Ideal.span {a}) := by
    intro A K _ _ _ _ _ H a ha N hN
    classical

    have ses : ∀ (X Y : Submodule A A), Y ≤ X → Module.length A (A ⧸ Y) =
        Module.length A (X ⧸ Y.comap X.subtype) + Module.length A (A ⧸ X) := by
      intro X Y hYX
      apply Module.length_eq_add_of_exact
        (Submodule.mapQ (Y.comap X.subtype) Y X.subtype le_rfl) (Submodule.factor hYX)
      · rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        intro z hz
        obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
        rw [LinearMap.mem_ker, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at hz
        rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
        exact hz
      · exact Submodule.factor_surjective hYX
      · intro z
        constructor
        · intro hz
          obtain ⟨p, rfl⟩ := Submodule.Quotient.mk_surjective _ z
          have hp : p ∈ X := by
            change (Submodule.factor hYX) (Y.mkQ p) = 0 at hz
            rwa [Submodule.factor_mk, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hz
          exact ⟨Submodule.Quotient.mk ⟨p, hp⟩, by rw [Submodule.mapQ_apply]; rfl⟩
        · rintro ⟨w, rfl⟩
          obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ w
          rw [Submodule.mapQ_apply]
          change (Submodule.factor hYX) (Y.mkQ (X.subtype x)) = 0
          rw [Submodule.factor_mk, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
          exact x.2

    have hideal : ∀ I : Ideal A, I ≠ ⊥ →
        Module.length A (↥I ⧸ (Ideal.span {a} • (⊤ : Submodule A ↥I))) ≤
          Module.length A (A ⧸ Ideal.span {a}) := by
      intro I hI0
      obtain ⟨b, hbI, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI0
      have hfin : Module.length A (A ⧸ I) ≠ ⊤ := by
        have hle : Module.length A (A ⧸ I) ≤ Module.length A (A ⧸ Ideal.span {b}) :=
          Module.length_le_of_surjective _ (Submodule.factor_surjective
            (show Ideal.span {b} ≤ I from (Ideal.span_singleton_le_iff_mem I).mpr hbI))
        exact ne_top_of_le_ne_top (H b hb0) hle
      set sp : Ideal A := Ideal.span {a} with hsp
      set J : Submodule A A := sp • I with hJ
      have hJI : J ≤ I := Submodule.smul_le_right
      have hJsp : J ≤ sp := by
        rw [hJ, Submodule.smul_le]
        intro r hr n _
        rw [smul_eq_mul, mul_comm]
        exact Ideal.mul_mem_left _ _ hr
      have E1 := ses I J hJI
      have E2 := ses sp J hJsp
      have hbound : Module.length A (↥sp ⧸ J.comap sp.subtype) ≤ Module.length A (A ⧸ I) := by
        let σ : A →ₗ[A] ↥sp := LinearMap.toSpanSingleton A ↥sp ⟨a, Ideal.mem_span_singleton_self a⟩
        let τ : A →ₗ[A] (↥sp ⧸ J.comap sp.subtype) := (J.comap sp.subtype).mkQ ∘ₗ σ
        have hτs : Function.Surjective τ := by
          intro z
          obtain ⟨⟨y, hy⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ z
          obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy
          refine ⟨c, ?_⟩
          show Submodule.Quotient.mk (σ c) = _
          congr 1
          apply Subtype.ext
          show c * a = y
          exact hc
        have hIk : I ≤ LinearMap.ker τ := by
          intro x hx
          rw [LinearMap.mem_ker]
          show Submodule.Quotient.mk (σ x) = 0
          rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
          show x * a ∈ J
          rw [mul_comm]
          exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self a) hx
        apply Module.length_le_of_surjective (I.liftQ τ hIk)
        intro z
        obtain ⟨x, rfl⟩ := hτs z
        exact ⟨Submodule.Quotient.mk x, by rw [Submodule.liftQ_apply]⟩
      have hcomb : Module.length A (↥I ⧸ J.comap I.subtype) + Module.length A (A ⧸ I) ≤
          Module.length A (A ⧸ sp) + Module.length A (A ⧸ I) := by
        rw [← E1, E2, add_comm (Module.length A (A ⧸ sp))]
        exact add_le_add hbound le_rfl
      have h1 : Module.length A (↥I ⧸ J.comap I.subtype) ≤ Module.length A (A ⧸ sp) :=
        (ENat.add_le_add_iff_right hfin).mp hcomb
      have hsub : J.comap I.subtype ≤ (Ideal.span {a} • (⊤ : Submodule A ↥I)) := by
        intro x hx
        rw [Submodule.mem_comap, hJ, Submodule.ideal_span_singleton_smul,
          Submodule.mem_smul_pointwise_iff_exists] at hx
        obtain ⟨y, hy, hxy⟩ := hx
        have : x = a • (⟨y, hy⟩ : ↥I) := Subtype.ext hxy.symm
        rw [this]
        exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self a) Submodule.mem_top
      exact (Module.length_le_of_surjective _ (Submodule.factor_surjective hsub)).trans h1

    obtain ⟨s, hs⟩ := hN
    obtain ⟨c, hc⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A) s
    have hc0 : algebraMap A K (c : A) ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors c.2
    have hint : ∀ n ∈ N, ∃ x : A, algebraMap A K x = algebraMap A K (c : A) * n := by
      intro n hn
      rw [← hs] at hn
      induction hn using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨x, hx⟩ := hc y hy
        exact ⟨x, by rw [← Algebra.smul_def]; exact hx⟩
      | zero => exact ⟨0, by rw [map_zero, mul_zero]⟩
      | add y z _ _ hy hz =>
        obtain ⟨x, hx⟩ := hy
        obtain ⟨w, hw⟩ := hz
        exact ⟨x + w, by rw [map_add, hx, hw, mul_add]⟩
      | smul r y _ hy =>
        obtain ⟨x, hx⟩ := hy
        exact ⟨r * x, by rw [map_mul, hx, Algebra.smul_def]; ring⟩
    let L : A →ₗ[A] K :=
      LinearMap.mulLeft A ((algebraMap A K (c : A))⁻¹) ∘ₗ Algebra.linearMap A K
    have hL : ∀ x, L x = (algebraMap A K (c : A))⁻¹ * algebraMap A K x := fun x => rfl
    let I : Ideal A := N.comap L
    let ψ : ↥I →ₗ[A] ↥N := L.restrict (fun x hx => hx)
    have hψs : Function.Surjective ψ := by
      intro n
      obtain ⟨x, hx⟩ := hint n n.2
      have hLx : L x = n := by rw [hL, hx, ← mul_assoc, inv_mul_cancel₀ hc0, one_mul]
      have hxI : x ∈ I := by
        show L x ∈ N
        rw [hLx]; exact n.2
      exact ⟨⟨x, hxI⟩, Subtype.ext hLx⟩
    have hle : Ideal.span {a} • (⊤ : Submodule A ↥I) ≤
        (Ideal.span {a} • (⊤ : Submodule A ↥N)).comap ψ := by
      rw [Submodule.smul_le]
      intro r hr n _
      rw [Submodule.mem_comap, map_smul]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    have hsurj : Function.Surjective (Submodule.mapQ _ _ ψ hle) := by
      intro z
      obtain ⟨n, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      obtain ⟨x, rfl⟩ := hψs n
      exact ⟨Submodule.Quotient.mk x, by rw [Submodule.mapQ_apply]⟩
    refine (Module.length_le_of_surjective _ hsurj).trans ?_
    by_cases hI0 : I = ⊥
    · have hsub : Subsingleton ↥I := ⟨fun x y => by
        apply Subtype.ext
        have hx : (x : A) ∈ (⊥ : Ideal A) := hI0 ▸ x.2
        have hy : (y : A) ∈ (⊥ : Ideal A) := hI0 ▸ y.2
        rw [Submodule.mem_bot] at hx hy
        rw [hx, hy]⟩
      have : Subsingleton (↥I ⧸ (Ideal.span {a} • (⊤ : Submodule A ↥I))) := ⟨fun x y => by
        obtain ⟨x', rfl⟩ := Submodule.Quotient.mk_surjective _ x
        obtain ⟨y', rfl⟩ := Submodule.Quotient.mk_surjective _ y
        rw [Subsingleton.elim x' y']⟩
      rw [Module.length_eq_zero_iff.mpr this]
      exact zero_le
    · exact hideal I hI0
  have s7 : ∀ (A K : Type u) [CommRing A] [Field K] [Algebra A K] (B : Subalgebra A K) (a : A) (C : ℕ∞), (∀ M : Submodule A K, M.FG → M ≤ Subalgebra.toSubmodule B → Module.length A (↥M ⧸ (Ideal.span {a} • (⊤ : Submodule A ↥M))) ≤ C) → Module.length A (↥B ⧸ Ideal.span {algebraMap A ↥B a}) ≤ C := by
    intro A K _ _ _ B a C hM
    classical
    let πB : ↥B →ₗ[A] (↥B ⧸ Ideal.span {algebraMap A ↥B a}) :=
      (Ideal.Quotient.mkₐ A (Ideal.span {algebraMap A ↥B a})).toLinearMap

    have hfg : ∀ N : Submodule A (↥B ⧸ Ideal.span {algebraMap A ↥B a}), N.FG →
        Module.length A ↥N ≤ C := by
      intro N ⟨s, hs⟩
      have hlift : ∀ y : (↥B ⧸ Ideal.span {algebraMap A ↥B a}), ∃ b : ↥B, πB b = y := by
        intro y
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨b, hb⟩
      choose lift hlift using hlift
      let M : Submodule A K :=
        Submodule.span A ((s.image (fun y => ((lift y : ↥B) : K)) : Finset K) : Set K)
      have hMfg : M.FG := ⟨_, rfl⟩
      have hMB : M ≤ Subalgebra.toSubmodule B := by
        rw [Submodule.span_le]
        intro z hz
        rw [Finset.coe_image] at hz
        obtain ⟨y, _, rfl⟩ := hz
        exact (lift y).2
      let ι : ↥M →ₗ[A] ↥B :=
        (Subalgebra.toSubmoduleEquiv B).toLinearMap ∘ₗ Submodule.inclusion hMB
      let π : ↥M →ₗ[A] (↥B ⧸ Ideal.span {algebraMap A ↥B a}) := πB ∘ₗ ι
      have hker : Ideal.span {a} • (⊤ : Submodule A ↥M) ≤ LinearMap.ker π := by
        rw [Submodule.smul_le]
        intro r hr m _
        rw [LinearMap.mem_ker]
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hr
        show (Ideal.Quotient.mkₐ A (Ideal.span {algebraMap A ↥B a})) (ι ((c * a) • m)) = 0
        rw [map_smul ι, Algebra.smul_def, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem,
          map_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
      have hNr : N ≤ LinearMap.range (Submodule.liftQ _ π hker) := by
        rw [Submodule.range_liftQ, ← hs, Submodule.span_le]
        intro y hy
        refine ⟨⟨((lift y : ↥B) : K), Submodule.subset_span (by
          rw [Finset.coe_image]; exact ⟨y, hy, rfl⟩)⟩, ?_⟩
        exact hlift y
      calc Module.length A ↥N ≤ Module.length A ↥(LinearMap.range (Submodule.liftQ _ π hker)) :=
            Module.length_le_of_injective (Submodule.inclusion hNr)
              (Submodule.inclusion_injective hNr)
        _ ≤ Module.length A (↥M ⧸ (Ideal.span {a} • (⊤ : Submodule A ↥M))) :=
            Module.length_le_of_surjective _ (LinearMap.surjective_rangeRestrict _)
        _ ≤ C := hM M hMfg hMB

    have key : ∀ p : LTSeries (Submodule A (↥B ⧸ Ideal.span {algebraMap A ↥B a})),
        (p.length : ℕ∞) ≤ C := by
      intro p
      choose y hy1 hy2 using fun i : Fin p.length =>
        SetLike.exists_of_lt (p.strictMono (Fin.castSucc_lt_succ (i := i)))
      let N : Submodule A (↥B ⧸ Ideal.span {algebraMap A ↥B a}) := Submodule.span A (Set.range y)
      have hNfg : N.FG := Submodule.fg_span (Set.finite_range y)
      have hyN : ∀ i, y i ∈ N := fun i => Submodule.subset_span ⟨i, rfl⟩
      let q : LTSeries (Submodule A ↥N) := LTSeries.mk p.length
        (fun i => (p.toFun i).comap N.subtype) (by
          rw [Fin.strictMono_iff_lt_succ]
          intro i
          refine lt_of_le_of_ne
            (Submodule.comap_mono (le_of_lt (p.strictMono (Fin.castSucc_lt_succ (i := i))))) ?_
          intro heq
          have h1 : (⟨y i, hyN i⟩ : ↥N) ∈ (p.toFun i.succ).comap N.subtype := hy1 i
          rw [← heq] at h1
          exact hy2 i h1)
      have h1 := Order.LTSeries.length_le_krullDim q
      rw [← Module.coe_length] at h1
      have h2 : (q.length : ℕ∞) ≤ Module.length A ↥N := by exact_mod_cast h1
      exact h2.trans (hfg N hNfg)
    have : (Module.length A (↥B ⧸ Ideal.span {algebraMap A ↥B a}) : WithBot ℕ∞) ≤ (C : WithBot ℕ∞) := by
      rw [Module.coe_length]
      apply iSup_le
      intro p
      exact_mod_cast key p
    exact_mod_cast this
  have s8 : ∀ (A K : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K] (B : Subalgebra A K), (∀ a : A, a ≠ 0 → Module.length A (↥B ⧸ Ideal.span {algebraMap A ↥B a}) ≠ ⊤) → IsNoetherianRing ↥B := by
    intro A K _ _ _ _ _ B H
    rw [isNoetherianRing_iff, isNoetherian_def]
    intro J
    by_cases hJ : J = ⊥
    · rw [hJ]; exact Submodule.fg_bot
    obtain ⟨b, hbJ, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
    obtain ⟨x, s, hs, hxs⟩ := IsFractionRing.div_surjective (A := A) (b : K)
    have hs0 : algebraMap A K s ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
    have hxb : algebraMap A B x = algebraMap A B s * b := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap, ← hxs]
      field_simp
    have hx0 : x ≠ 0 := by
      intro h
      rw [h, map_zero] at hxb
      have h2 := congrArg Subtype.val hxb
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ZeroMemClass.coe_zero] at h2
      rcases mul_eq_zero.mp h2.symm with h3 | h3
      · exact hs0 h3
      · exact hb0 (Subtype.ext h3)
    set I : Ideal B := Ideal.span {algebraMap A B x} with hI
    have hIJ : I ≤ J := by
      rw [hI, Ideal.span_le, Set.singleton_subset_iff, hxb]
      exact Ideal.mul_mem_left J _ hbJ
    haveI : IsNoetherian A (B ⧸ I) := by
      have := H x hx0
      rw [Module.length_ne_top_iff, isFiniteLength_iff_isNoetherian_isArtinian] at this
      exact this.1
    have hmapFG : (Submodule.map (Submodule.mkQ I) J).FG := by
      have h1 : ((Submodule.map (Submodule.mkQ I) J).restrictScalars A).FG :=
        IsNoetherian.noetherian _
      exact Submodule.FG.of_restrictScalars A h1
    apply Submodule.fg_of_fg_map_of_fg_inf_ker (Submodule.mkQ I) hmapFG
    rw [Submodule.ker_mkQ, inf_eq_right.mpr hIJ]
    exact ⟨{algebraMap A B x}, by rw [Finset.coe_singleton]⟩
  have s10 : ∀ (D₁ K : Type u) [CommRing D₁] [IsDomain D₁] [IsLocalRing D₁] [Field K] [Algebra D₁ K] [IsFractionRing D₁ K] (V : ValuationSubring K), ¬ IsField D₁ → (∀ B : Subalgebra D₁ K, IsNoetherianRing ↥B) → (∀ d : D₁, algebraMap D₁ K d ∈ V) → (∀ d ∈ IsLocalRing.maximalIdeal D₁, V.valuation (algebraMap D₁ K d) < 1) → ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsDiscreteValuationRing R) (f : D₁ →+* R), Function.Injective f ∧ IsLocalHom f := by
    intro D₁ K _ _ _ _ _ _ V hnf hKA hmem hlt
    let BV : Subalgebra D₁ K := { V.toSubring with algebraMap_mem' := hmem }
    haveI : IsNoetherianRing BV := hKA BV
    let e : BV ≃+* V :=
      { toFun := fun x => ⟨x.1, x.2⟩
        invFun := fun x => ⟨x.1, x.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    haveI : IsNoetherianRing V := isNoetherianRing_of_ringEquiv BV e
    have hinj := IsFractionRing.injective D₁ K
    have hm0 : IsLocalRing.maximalIdeal D₁ ≠ ⊥ := fun h =>
      hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
    obtain ⟨d, hd, hd0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm0
    have hVnf : ¬ IsField V := by
      intro hF
      have h1 : (⟨algebraMap D₁ K d, hmem d⟩ : V) ∈ IsLocalRing.maximalIdeal V :=
        (V.valuation_lt_one_iff _).mpr (hlt d hd)
      rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp hF, Ideal.mem_bot] at h1
      apply hd0
      apply hinj
      rw [map_zero]
      exact congrArg Subtype.val h1
    haveI : IsDiscreteValuationRing V :=
      ((IsDiscreteValuationRing.TFAE V hVnf).out 1 2).mpr (inferInstance : ValuationRing V)
    let f : D₁ →+* V := (algebraMap D₁ K).codRestrict V hmem
    refine ⟨V, inferInstance, inferInstance, inferInstance, f, ?_, ?_⟩
    · intro a b hab
      apply hinj
      exact congrArg Subtype.val hab
    · constructor
      intro a ha
      by_contra hna
      have h1 := hlt a ((IsLocalRing.mem_maximalIdeal a).mpr hna)
      have h2 : f a ∈ IsLocalRing.maximalIdeal V := (V.valuation_lt_one_iff (f a)).mpr h1
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 ha
  classical

  obtain ⟨D, _, _, _, _, gX, hDnf, hgx, hgξ⟩ := s1 X x ξ hspec hne

  have hιinj : Function.Injective (algebraMap D (FractionRing D)) :=
    IsFractionRing.injective D (FractionRing D)
  obtain ⟨V, hVmem, hVlt⟩ := s2 D (FractionRing D) hιinj
  obtain ⟨S, t, hSfg, ht, hmt⟩ :=
    s3 D (FractionRing D) V hιinj hDnf hVmem hVlt
  haveI : Algebra.FiniteType D S := (Subalgebra.fg_iff_finiteType S).mp hSfg
  haveI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing D S
  obtain ⟨D₁, _, _, _, _, _, g, hginj, hgt⟩ := s4 S t ht
  let ψ : D →+* D₁ := g.comp (algebraMap D S)
  have hψinj : Function.Injective ψ := by
    intro a b hab
    apply hιinj
    have h1 : algebraMap D S a = algebraMap D S b := hginj hab
    have h2 := congrArg Subtype.val h1
    rwa [Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap] at h2
  have hψm : ∀ d ∈ IsLocalRing.maximalIdeal D, ψ d ∈ IsLocalRing.maximalIdeal D₁ := by
    intro d hd
    obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp (hmt d hd)
    show g (algebraMap D S d) ∈ _
    rw [← hs, map_mul]
    exact Ideal.mul_mem_left _ _ hgt
  haveI hψloc : IsLocalHom ψ := by
    constructor
    intro d hd
    by_contra hdu
    have hdm : d ∈ IsLocalRing.maximalIdeal D := (IsLocalRing.mem_maximalIdeal d).mpr hdu
    exact (IsLocalRing.mem_maximalIdeal _).mp (hψm d hdm) hd
  have hD₁nf : ¬ IsField D₁ := by
    intro hF
    have hm0 : IsLocalRing.maximalIdeal D ≠ ⊥ := fun h =>
      hDnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
    obtain ⟨d, hd, hd0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm0
    have h1 := hψm d hd
    rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp hF] at h1
    exact hd0 (hψinj (by rw [map_zero]; exact Ideal.mem_bot.mp h1))

  have hKA : ∀ B : Subalgebra D₁ (FractionRing D₁), IsNoetherianRing B := by
    intro B
    have H := s5 D₁
    apply s8 D₁ (FractionRing D₁) B
    intro a ha
    have hle := s7 D₁ (FractionRing D₁) B a
      (Module.length D₁ (D₁ ⧸ Ideal.span {a}))
      (fun M hM _ => s6 D₁ (FractionRing D₁) H a ha M hM)
    exact ne_top_of_le_ne_top (H a ha) hle

  obtain ⟨V₁, hV₁mem, hV₁lt⟩ := s2 D₁ (FractionRing D₁)
    (IsFractionRing.injective D₁ (FractionRing D₁))
  obtain ⟨R, _, _, _, f, hfinj, hfloc⟩ :=
    s10 D₁ (FractionRing D₁) V₁ hD₁nf hKA hV₁mem hV₁lt
  let F : D →+* R := f.comp ψ
  haveI : IsLocalHom F := RingHom.isLocalHom_comp f ψ
  have hFinj : Function.Injective F := hfinj.comp hψinj
  refine ⟨R, inferInstance, inferInstance, inferInstance,
    Spec.map (CommRingCat.ofHom F) ≫ gX, ?_, ?_⟩
  · have key : (Spec.map (CommRingCat.ofHom F)) (IsLocalRing.closedPoint R : Spec (.of R)) =
        (IsLocalRing.closedPoint D : Spec (.of D)) :=
      (Spec.map_apply (CommRingCat.ofHom F) _).trans (IsLocalRing.comap_closedPoint F)
    refine (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom F)) gX
      (IsLocalRing.closedPoint R : Spec (.of R))).trans ?_
    rw [key]
    exact hgx
  · intro y hy
    have hy0 : y.asIdeal = ⊥ := by
      by_contra h0
      apply hy
      haveI := y.isPrime
      have hmax := IsPrime.to_maximal_ideal h0
      exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
    refine (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom F)) gX y).trans ?_
    apply hgξ
    have e : (Spec.map (CommRingCat.ofHom F)) y = PrimeSpectrum.comap F y :=
      Spec.map_apply (CommRingCat.ofHom F) y
    rw [e]
    change Ideal.comap F y.asIdeal = ⊥
    rw [hy0]
    exact Ideal.comap_bot_of_injective F hFinj

theorem wcpa_dj_lqg_lqf_criterion : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), LocallyOfFiniteType f → (∀ x : X, (f.residueFieldMap x).hom.IsIntegral) → LocallyQuasiFinite f :=
by

  have L1 : ∀ (K F : Type u) [Field K] [CommRing F] [Algebra K F] [Algebra.FiniteType K F],
      (∀ 𝔔 : Ideal F, 𝔔.IsPrime → Algebra.IsIntegral K (F ⧸ 𝔔)) → Module.Finite K F := by
    intro K F _ _ _ _ h
    rw [Module.finite_iff_krullDimLE_zero]
    refine Ring.KrullDimLE.mk₀ fun I hI => ?_
    have := h I hI
    exact Ideal.Quotient.maximal_of_isField _
      (isField_of_isIntegral_of_isField' (R := K) (Field.toIsField K))

  have L2 : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S],
      (∀ (P : Ideal A) [P.IsPrime] (Q : Ideal S) [Q.IsPrime]
        (h : P = Q.comap (algebraMap A S)),
        (Ideal.ResidueField.map P Q (algebraMap A S) h).IsIntegral) →
      ∀ (P : Ideal A) [P.IsPrime] (𝔔 : Ideal (P.Fiber S)), 𝔔.IsPrime →
        Algebra.IsIntegral P.ResidueField (P.Fiber S ⧸ 𝔔) := by
    intro A S _ _ _ hint P _ 𝔔 h𝔔
    obtain ⟨q, hq0⟩ : ∃ q, q = (PrimeSpectrum.preimageOrderIsoFiber A S ⟨P, inferInstance⟩).symm
        ⟨𝔔, h𝔔⟩ := ⟨_, rfl⟩
    have hq := PrimeSpectrum.coe_preimageOrderIsoFiber_apply_asIdeal A S ⟨P, inferInstance⟩ q
    rw [hq0, OrderIso.apply_symm_apply] at hq
    rw [← hq0] at hq
    have hPQ : P = (q : PrimeSpectrum S).asIdeal.comap (algebraMap A S) := by
      have h2 : PrimeSpectrum.comap (algebraMap A S) (q : PrimeSpectrum S) =
          ⟨P, inferInstance⟩ := q.2
      have h3 := congrArg PrimeSpectrum.asIdeal h2
      rw [PrimeSpectrum.comap_asIdeal] at h3
      exact h3.symm
    have hPQ' : P = (q : PrimeSpectrum S).asIdeal.comap (Algebra.ofId A S).toRingHom := hPQ
    have hmem : ∀ x, x ∈ 𝔔 ↔ (Algebra.TensorProduct.lift
        (Ideal.ResidueField.mapₐ P (q : PrimeSpectrum S).asIdeal (Algebra.ofId A S) hPQ')
        (IsScalarTower.toAlgHom A S (q : PrimeSpectrum S).asIdeal.ResidueField)
        (fun _ _ => Commute.all _ _)) x = 0 := by
      intro x
      exact Set.ext_iff.mp hq x
    let ι : P.Fiber S ⧸ 𝔔 →+* (q : PrimeSpectrum S).asIdeal.ResidueField :=
      Ideal.Quotient.lift 𝔔 (Algebra.TensorProduct.lift
        (Ideal.ResidueField.mapₐ P (q : PrimeSpectrum S).asIdeal (Algebra.ofId A S) hPQ')
        (IsScalarTower.toAlgHom A S (q : PrimeSpectrum S).asIdeal.ResidueField)
        (fun _ _ => Commute.all _ _)).toRingHom (fun a ha => (hmem a).mp ha)
    have hinj : Function.Injective ι := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [Ideal.Quotient.eq_zero_iff_mem, hmem]
      exact hz
    have hcomp : ι.comp (algebraMap P.ResidueField (P.Fiber S ⧸ 𝔔)) =
        Ideal.ResidueField.map P (q : PrimeSpectrum S).asIdeal (algebraMap A S) hPQ := by
      refine RingHom.ext fun c => ?_
      rw [RingHom.comp_apply]
      change (Algebra.TensorProduct.lift
        (Ideal.ResidueField.mapₐ P (q : PrimeSpectrum S).asIdeal (Algebra.ofId A S) hPQ')
        (IsScalarTower.toAlgHom A S (q : PrimeSpectrum S).asIdeal.ResidueField)
        (fun _ _ => Commute.all _ _)) (c ⊗ₜ[A] (1 : S)) = _
      rw [Algebra.TensorProduct.lift_tmul, Ideal.ResidueField.mapₐ_apply, map_one, mul_one]
      rfl
    have h5 := hint P (q : PrimeSpectrum S).asIdeal hPQ
    rw [← hcomp] at h5
    have h6 : (algebraMap P.ResidueField (P.Fiber S ⧸ 𝔔)).IsIntegral :=
      RingHom.IsIntegral.tower_bot (algebraMap P.ResidueField (P.Fiber S ⧸ 𝔔)) ι hinj h5
    exact ⟨fun x => h6 x⟩

  have L3 : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (pt : Spec S),
      ((Spec.map φ).residueFieldMap pt).hom.IsIntegral →
      (@Ideal.ResidueField.map _ _ _ _ (PrimeSpectrum.comap φ.hom pt).asIdeal _
        (pt : PrimeSpectrum S).asIdeal pt.isPrime φ.hom rfl).IsIntegral := by
    intro R S φ pt hint
    have e := Scheme.localRingHom_comp_stalkIso φ pt
    haveI : pt.asIdeal.IsPrime := pt.isPrime
    have : IsLocalHom (Spec.stalkIso R ((Spec.map φ) pt)).hom.hom :=
      isLocalHom_of_isIso _
    have : IsLocalHom (Spec.stalkIso S pt).inv.hom :=
      isLocalHom_of_isIso _
    let mα := IsLocalRing.ResidueField.map (Spec.stalkIso R ((Spec.map φ) pt)).hom.hom
    let mβ := IsLocalRing.ResidueField.map (Spec.stalkIso S pt).inv.hom
    have key : ((Spec.map φ).residueFieldMap pt).hom =
        (mβ.comp (Ideal.ResidueField.map (PrimeSpectrum.comap φ.hom pt).asIdeal
          (pt : PrimeSpectrum S).asIdeal φ.hom rfl)).comp mα := by
      refine RingHom.ext fun z => ?_
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective
        (R := (Spec R).presheaf.stalk ((Spec.map φ) pt)) z
      change IsLocalRing.residue _ (((Spec.map φ).stalkMap pt).hom x) = _
      rw [← e]
      rfl
    rw [key] at hint
    exact RingHom.IsIntegral.tower_bot _ _ mβ.injective (RingHom.IsIntegral.tower_top _ _ hint)

  have L4 : ∀ {A B X Y : Scheme.{u}} (g : A ⟶ B) (i : B ⟶ Y) (j : A ⟶ X) (f : X ⟶ Y),
      IsOpenImmersion j → g ≫ i = j ≫ f → (∀ x : X, (f.residueFieldMap x).hom.IsIntegral) →
      ∀ a : A, (g.residueFieldMap a).hom.IsIntegral := by
    intro A B X Y g i j f hj hw hf a
    have hjf : ((j ≫ f).residueFieldMap a).hom.IsIntegral := by
      have e := congrArg CommRingCat.Hom.hom (Scheme.residueFieldMap_comp j f a)
      rw [e]
      exact RingHom.IsIntegral.trans (f.residueFieldMap (j a)).hom (j.residueFieldMap a).hom
        (hf (j a)) (RingHom.isIntegral_of_surjective _ (ConcreteCategory.bijective_of_isIso
          (j.residueFieldMap a)).2)
    have htr : ∀ h1 h2 : A ⟶ Y, h1 = h2 → (h2.residueFieldMap a).hom.IsIntegral →
        (h1.residueFieldMap a).hom.IsIntegral := by
      intro h1 h2 e
      subst e
      exact id
    have hgi := htr _ _ hw hjf
    have e2 := congrArg CommRingCat.Hom.hom (Scheme.residueFieldMap_comp g i a)
    rw [e2] at hgi
    exact RingHom.IsIntegral.tower_top (i.residueFieldMap (g a)).hom (g.residueFieldMap a).hom hgi

  intro X Y f hf hint
  rw [locallyQuasiFinite_iff]
  intro U hU V hV e
  have hft : (f.appLE U V e).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType f hf ⟨U, hU⟩ ⟨V, hV⟩ e
  have hg : ∀ a, ((Spec.map (f.appLE U V e)).residueFieldMap a).hom.IsIntegral :=
    L4 _ hU.fromSpec hV.fromSpec f hV.isOpenImmersion_fromSpec
      (IsAffineOpen.SpecMap_appLE_fromSpec f hU hV e) hint
  letI := (f.appLE U V e).hom.toAlgebra
  haveI : Algebra.FiniteType Γ(Y, U) Γ(X, V) := hft
  show Algebra.QuasiFinite Γ(Y, U) Γ(X, V)
  have hres : ∀ (P : Ideal Γ(Y, U)) [P.IsPrime] (Q : Ideal Γ(X, V)) [Q.IsPrime]
      (h : P = Q.comap (algebraMap Γ(Y, U) Γ(X, V))),
      (Ideal.ResidueField.map P Q (algebraMap Γ(Y, U) Γ(X, V)) h).IsIntegral := by
    intro P _ Q _ h
    subst h
    exact L3 _ _ (f.appLE U V e) (⟨Q, inferInstance⟩ : PrimeSpectrum Γ(X, V)) (hg _)
  refine ⟨fun P _ => ?_⟩
  exact L1 _ _ (fun 𝔔 h𝔔 => L2 _ _ hres P 𝔔 h𝔔)

theorem wcpa_dj_lie_graph_quasifinite : ∀ (k : Type u) [Field k] (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (sT : T ⟶ Spec (.of k)), LocallyOfFiniteType sT → (∀ x : T, IsIntegrallyClosed (T.presheaf.stalk x)) → ∀ (Z Z' : Scheme.{u}) (u : Z ⟶ T) (u' : Z' ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T ⟶ Z')), 3 ≤ n → wcpaDjStablePtd u n τ → wcpaDjStablePtd u' n τ' → GeometricallyConnected u → GeometricallyConnected u' → ∀ (V Y : Scheme.{u}) (v : V ⟶ T) (π : Y ⟶ V) (a : Y ⟶ Z) (a' : Y ⟶ Z'), IsOpenImmersion v → Nonempty V → IsPullback a π u v → IsPullback a' π u' v → (∀ i, ∃ t : V ⟶ Y, t ≫ π = 𝟙 V ∧ t ≫ a = v ≫ τ i ∧ t ≫ a' = v ≫ τ' i) → ∀ (h : a ≫ u = a' ≫ u') (Γ : Scheme.{u}) (ι : Γ ⟶ Limits.pullback u u') (j : Y ⟶ Γ), IsClosedImmersion ι → AlgebraicGeometry.IsReduced Γ → IsOpenImmersion j → Dense (Set.range ⇑j) → j ≫ ι = Limits.pullback.lift a a' h → (∀ γ : Γ, (ι ≫ Limits.pullback.fst u u') γ ∈ Set.range ⇑a → γ ∈ Set.range ⇑j) → LocallyQuasiFinite (ι ≫ Limits.pullback.fst u u') :=
by
  intro k _ T _ sT hsT _hnorm Z Z' u u' n τ τ' hn hst hst' hgc hgc' V Y v π a a' hv _hV hpb hpb'
    hsec h Γ ι j hι _hΓred hj hjd hjι _hjr
  classical
  haveI := hι
  haveI := hj
  haveI := hsT
  haveI hup : IsProper u := hst.1.2.1
  haveI hup' : IsProper u' := hst'.1.2.1
  haveI hav : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hv

  haveI hp1l : LocallyOfFiniteType (ι ≫ Limits.pullback.fst u u') := inferInstance
  haveI : LocallyOfFiniteType (ι ≫ Limits.pullback.fst u u' ≫ u ≫ sT) := inferInstance
  haveI hΓn : IsLocallyNoetherian Γ :=
    LocallyOfFiniteType.isLocallyNoetherian (ι ≫ Limits.pullback.fst u u' ≫ u ≫ sT)

  have s8 : ∀ γ : Γ, ((Limits.pullback.fst u u').residueFieldMap (ι γ)).hom.IsIntegral →
      ((ι ≫ Limits.pullback.fst u u').residueFieldMap γ).hom.IsIntegral := by
    intro γ hγ
    have hsurj : Function.Surjective (ι.residueFieldMap γ).hom := by
      have e := Scheme.residue_residueFieldMap ι γ
      have h2 : Function.Surjective ((ι.stalkMap γ ≫ Γ.residue γ).hom) := by
        rw [CommRingCat.hom_comp, RingHom.coe_comp]
        exact (Scheme.residue_surjective Γ γ).comp (ι.stalkMap_surjective γ)
      rw [← e, CommRingCat.hom_comp, RingHom.coe_comp] at h2
      exact h2.of_comp
    have key : ((ι ≫ Limits.pullback.fst u u').residueFieldMap γ).hom =
        (ι.residueFieldMap γ).hom.comp ((Limits.pullback.fst u u').residueFieldMap (ι γ)).hom := by
      rw [Scheme.residueFieldMap_comp]; rfl
    rw [key]
    exact RingHom.IsIntegral.trans _ _ hγ (RingHom.isIntegral_of_surjective _ hsurj)

  have hja : j ≫ ι ≫ Limits.pullback.fst u u' = a := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_fst]
  have s9 : ∀ y : Y, ((ι ≫ Limits.pullback.fst u u').residueFieldMap (j y)).hom.IsIntegral := by
    intro y
    have e1 := Scheme.residueFieldMap_comp j (ι ≫ Limits.pullback.fst u u') y
    have hopen : IsOpenImmersion (j ≫ ι ≫ Limits.pullback.fst u u') := by rw [hja]; exact hav
    have hiso1 := @Scheme.instIsIsoCommRingCatResidueFieldMapOfIsOpenImmersion _ _
      (j ≫ ι ≫ Limits.pullback.fst u u') hopen y
    rw [e1] at hiso1
    haveI : IsIso ((ι ≫ Limits.pullback.fst u u').residueFieldMap (j y)) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ _ (j.residueFieldMap y) inferInstance hiso1
    exact RingHom.isIntegral_of_surjective _ (ConcreteCategory.bijective_of_isIso _).2

  have s12 : ∀ (R : Type u) [CommRing R] [IsDomain R] {X S : Scheme.{u}} (s : X ⟶ S), IsSeparated s →
      ∀ (f g : Spec (.of R) ⟶ X), f ≫ s = g ≫ s →
      Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ f =
        Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ g → f = g := by
    intro R _ _ X S s hs f g h1 h2
    haveI := hs
    haveI : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
      apply isDominant_of_of_appTop_injective
      have e := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap R (FractionRing R)))
      intro x y hxy
      have h3 : ((Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))).appTop ≫
          (Scheme.ΓSpecIso (CommRingCat.of (FractionRing R))).hom).hom x =
          ((Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))).appTop ≫
          (Scheme.ΓSpecIso (CommRingCat.of (FractionRing R))).hom).hom y := by
        rw [CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
        exact congrArg _ hxy
      rw [e, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply,
        CommRingCat.hom_ofHom] at h3
      have h4 := IsFractionRing.injective R (FractionRing R) h3
      exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).hom).1 h4
    exact ext_of_isDominant_of_isSeparated s h1 _ h2

  apply wcpa_dj_lqg_lqf_criterion _ inferInstance
  intro γ
  by_cases hγ : γ ∈ Set.range j
  · obtain ⟨y, rfl⟩ := hγ
    exact s9 y
  · apply s8

    obtain ⟨ξ, hξj, hξγ⟩ := wcpa_dj_lqg_generization Γ (Set.range j)
      (IsOpenImmersion.isOpen_range j) hjd γ
    have hne : ξ ≠ γ := fun e => hγ (e ▸ hξj)
    obtain ⟨R, _, _, _, hR, hRc, hRg⟩ := wcpa_dj_lie_dvr_realize Γ γ ξ hξγ hne
    have hgenpt : ∀ p : Spec (.of (FractionRing R)),
        Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) p ≠
          IsLocalRing.closedPoint R := by
      intro p hp
      have h1 : (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) p).asIdeal = ⊥ := by
        have hp0 : (p : PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
          haveI := (p : PrimeSpectrum (FractionRing R)).isPrime
          exact Ideal.eq_bot_of_prime _
        rw [Spec.map_apply]
        change Ideal.comap (algebraMap R (FractionRing R))
          (p : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
        rw [hp0]
        exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))
      apply IsDiscreteValuationRing.not_a_field R
      have h2 : (IsLocalRing.closedPoint R).asIdeal = IsLocalRing.maximalIdeal R := rfl
      rw [← h2, ← h1, hp]
    have hrng : Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ hR).base ⊆
        Set.range j.base := by
      rintro _ ⟨p, rfl⟩
      have := hRg _ (hgenpt p)
      show (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ hR) p ∈ Set.range j
      rw [Scheme.Hom.comp_apply, this]
      exact hξj
    obtain ⟨e, he⟩ : ∃ e : Spec (.of (FractionRing R)) ⟶ Y,
        e ≫ j = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ hR :=
      ⟨IsOpenImmersion.lift j _ hrng, IsOpenImmersion.lift_fac _ _ _⟩
    have hefst : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ hR ≫ ι ≫
        Limits.pullback.fst u u' = e ≫ a := by
      rw [← Category.assoc, ← he, Category.assoc, ← Category.assoc j, hjι,
        Limits.pullback.lift_fst]
    have hesnd : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ hR ≫ ι ≫
        Limits.pullback.snd u u' = e ≫ a' := by
      rw [← Category.assoc, ← he, Category.assoc, ← Category.assoc j, hjι,
        Limits.pullback.lift_snd]

    obtain ⟨b, hb⟩ : ∃ b : Spec (.of R) ⟶ T, b = hR ≫ ι ≫ Limits.pullback.fst u u' ≫ u :=
      ⟨_, rfl⟩
    have hgb : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ b = e ≫ π ≫ v := by
      have h5 := congrArg (· ≫ u) hefst
      simp only [Category.assoc] at h5
      rw [hb, h5, hpb.w]
    obtain ⟨τb, τb', YK, πK, aK, aK', sK, hτbst, hτbst', hgcb, hgcb', hτb, hτb', hpbK, hpbK',
      hsecK, hsKπ, hsKa, hsKa'⟩ :=
      wcpa_dj_lqg_bc_config T Z Z' u u' n τ τ' hst hst' hgc hgc' V Y v π a a' hpb hpb' hsec R b e
        hgb
    obtain ⟨Φ, hΦiso, hΦu, hΦa⟩ := wcpa_dj_lie_dvr_extend R (Limits.pullback u b)
      (Limits.pullback u' b) (Limits.pullback.snd u b) (Limits.pullback.snd u' b) n τb τb' hn
      hτbst hτbst' hgcb hgcb' YK πK aK aK' hpbK hpbK' hsecK
    haveI hsep : IsSeparated (Limits.pullback.snd u' b) := inferInstance

    have hmark : ∀ (i : Fin n) (σ : Spec (.of R) ⟶ Limits.pullback u b)
        (σ' : Spec (.of R) ⟶ Limits.pullback u' b),
        σ ≫ Limits.pullback.snd u b = 𝟙 _ → σ ≫ Limits.pullback.fst u b = b ≫ τ i →
        σ' ≫ Limits.pullback.snd u' b = 𝟙 _ → σ' ≫ Limits.pullback.fst u' b = b ≫ τ' i →
        σ ≫ Φ = σ' := by
      intro i σ σ' h1 h2 h3 h4
      have eσ : σ = τb i :=
        Limits.pullback.hom_ext (by rw [h2, (hτb i).2]) (by rw [h1, (hτb i).1])
      have eσ' : σ' = τb' i :=
        Limits.pullback.hom_ext (by rw [h4, (hτb' i).2]) (by rw [h3, (hτb' i).1])
      subst eσ eσ'
      obtain ⟨t, _, ht2, ht3⟩ := hsecK i
      apply s12 R (Limits.pullback.snd u' b) hsep
      · rw [Category.assoc, hΦu, (hτb i).1, (hτb' i).1]
      · rw [← reassoc_of% ht2, hΦa, ht3]

    obtain ⟨x, hx1, hx2⟩ : ∃ x : Spec (.of R) ⟶ Limits.pullback u b,
        x ≫ Limits.pullback.fst u b = hR ≫ ι ≫ Limits.pullback.fst u u' ∧
        x ≫ Limits.pullback.snd u b = 𝟙 _ :=
      ⟨Limits.pullback.lift (hR ≫ ι ≫ Limits.pullback.fst u u') (𝟙 _)
          (by rw [Category.id_comp, hb]; simp only [Category.assoc]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨x', hx1', hx2'⟩ : ∃ x' : Spec (.of R) ⟶ Limits.pullback u' b,
        x' ≫ Limits.pullback.fst u' b = hR ≫ ι ≫ Limits.pullback.snd u u' ∧
        x' ≫ Limits.pullback.snd u' b = 𝟙 _ :=
      ⟨Limits.pullback.lift (hR ≫ ι ≫ Limits.pullback.snd u u') (𝟙 _)
          (by
            rw [Category.id_comp, hb]
            simp only [Category.assoc]
            rw [← Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hgx : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ x = sK ≫ aK := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hx1, hefst, hsKa]
      · simp only [Category.assoc]
        rw [hx2, Category.comp_id, hpbK.w, reassoc_of% hsKπ]
    have hgx' : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ x' = sK ≫ aK' := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hx1', hesnd, hsKa']
      · simp only [Category.assoc]
        rw [hx2', Category.comp_id, hpbK'.w, reassoc_of% hsKπ]
    have hxΦ : x ≫ Φ = x' := by
      apply s12 R (Limits.pullback.snd u' b) hsep
      · rw [Category.assoc, hΦu, hx2, hx2']
      · rw [← Category.assoc, hgx, Category.assoc, hΦa, hgx']

    have hL3 := wcpa_dj_lqg_closed_fibre_algebraic T Z Z' u u' n τ τ' hn hst hst' hgc hgc'
      (Spec (.of R)) b Φ hΦiso hΦu hmark x (hR ≫ ι) hx2
      (by rw [hx1, Category.assoc])
      (by rw [← Category.assoc x, hxΦ, hx1', Category.assoc])
    obtain ⟨c, hc⟩ : ∃ c : Spec (.of R), hR c = γ := ⟨_, hRc⟩
    exact hL3 (ι γ) ⟨c, by rw [Scheme.Hom.comp_apply, hc]⟩

theorem wcpa_dj_lie_graph_finite_iso : ∀ (k : Type u) [Field k] (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (sT : T ⟶ Spec (.of k)), LocallyOfFiniteType sT → (∀ x : T, IsIntegrallyClosed (T.presheaf.stalk x)) → ∀ (Z Z' : Scheme.{u}) (u : Z ⟶ T) (u' : Z' ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T ⟶ Z')), 3 ≤ n → wcpaDjStablePtd u n τ → wcpaDjStablePtd u' n τ' → GeometricallyConnected u → GeometricallyConnected u' → ∀ (V Y : Scheme.{u}) (v : V ⟶ T) (π : Y ⟶ V) (a : Y ⟶ Z) (a' : Y ⟶ Z'), IsOpenImmersion v → Nonempty V → IsPullback a π u v → IsPullback a' π u' v → (∀ i, ∃ t : V ⟶ Y, t ≫ π = 𝟙 V ∧ t ≫ a = v ≫ τ i ∧ t ≫ a' = v ≫ τ' i) → ∀ (h : a ≫ u = a' ≫ u') (Γ : Scheme.{u}) (ι : Γ ⟶ Limits.pullback u u') (j : Y ⟶ Γ), IsClosedImmersion ι → AlgebraicGeometry.IsReduced Γ → IsOpenImmersion j → Dense (Set.range ⇑j) → j ≫ ι = Limits.pullback.lift a a' h → (∀ γ : Γ, (ι ≫ Limits.pullback.fst u u') γ ∈ Set.range ⇑a → γ ∈ Set.range ⇑j) → IsFinite (ι ≫ Limits.pullback.fst u u') → IsIso (ι ≫ Limits.pullback.fst u u') :=
by

  have H0 : ∀ {B : Type u} [CommRing B] (P : Polynomial B) (c r x : B),
      (P.scaleRoots (c * r)).eval (c * x) = c ^ P.natDegree * (P.scaleRoots r).eval x := by
    intro B _ P c r x
    simp only [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have hi' : i ≤ P.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [Polynomial.coeff_scaleRoots, Polynomial.coeff_scaleRoots]
    have : c ^ P.natDegree = c ^ (P.natDegree - i) * c ^ i := by
      rw [← pow_add, Nat.sub_add_cancel hi']
    rw [this, mul_pow, mul_pow]
    ring
  have R1 : ∀ (B : Type u) [CommRing B] (S : Submonoid B) (ϖ : B), (∀ x : B, ϖ * x = 0 → x = 0) → (∀ (y : B) (d : ℕ), y ^ (d + 1) ∈ Ideal.span {ϖ} → ∃ t ∈ S, t * y ∈ Ideal.span {ϖ}) → ∀ (k : ℕ) (Q : Polynomial B), Q.Monic → ∀ y : B, (Q.scaleRoots (ϖ ^ k)).eval y = 0 → ∃ t ∈ S, t * y ∈ Ideal.span {ϖ ^ k} := by
    intro B _ S ϖ hreg hR k
    have hregp : ∀ (m : ℕ) (x : B), ϖ ^ m * x = 0 → x = 0 := by
      intro m
      induction m with
      | zero => intro x h; simpa using h
      | succ m ih => intro x h; apply ih; apply hreg; rw [← mul_assoc, ← pow_succ']; exact h
    induction k with
    | zero =>
      intro Q _ y _
      exact ⟨1, S.one_mem, by rw [pow_zero, Ideal.span_singleton_one]; trivial⟩
    | succ k ih =>
      intro Q hQ y hy
      have e := hy
      rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.sum_range_succ, Polynomial.coeff_scaleRoots,
        Nat.sub_self, pow_zero, mul_one, hQ.coeff_natDegree, one_mul] at e
      rcases Nat.eq_zero_or_pos Q.natDegree with hd0 | hdpos
      · rw [hd0, Finset.sum_range_zero, zero_add, pow_zero] at e
        have hy0 : y = 0 := by rw [← one_mul y, e, zero_mul]
        exact ⟨1, S.one_mem, by rw [hy0, mul_zero]; exact Ideal.zero_mem _⟩
      · have hyd : y ^ (Q.natDegree - 1 + 1) ∈ Ideal.span {ϖ} := by
          rw [Nat.sub_add_cancel hdpos]
          have : y ^ Q.natDegree =
              -∑ i ∈ Finset.range Q.natDegree, (Q.scaleRoots (ϖ ^ (k + 1))).coeff i * y ^ i := by
            rw [eq_neg_iff_add_eq_zero, add_comm]; exact e
          rw [this]
          refine neg_mem (Ideal.sum_mem _ (fun i hi => ?_))
          rw [Polynomial.coeff_scaleRoots]
          have hi : i < Q.natDegree := Finset.mem_range.mp hi
          apply Ideal.mul_mem_right
          apply Ideal.mul_mem_left
          rw [← pow_mul]
          apply Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self ϖ)
          exact Nat.mul_pos (Nat.succ_pos k) (Nat.sub_pos_of_lt hi)
        obtain ⟨t₁, ht₁S, ht₁⟩ := hR y (Q.natDegree - 1) hyd
        obtain ⟨y₁, hy₁⟩ := Ideal.mem_span_singleton'.mp ht₁
        have e1 : (Q.scaleRoots (t₁ * ϖ ^ (k + 1))).eval (t₁ * y) = 0 := by
          rw [H0, hy, mul_zero]
        have e2 : t₁ * ϖ ^ (k + 1) = ϖ * (t₁ * ϖ ^ k) := by ring
        rw [e2, ← hy₁, mul_comm y₁ ϖ, H0] at e1
        have e3 : (Q.scaleRoots (t₁ * ϖ ^ k)).eval y₁ = 0 := hregp _ _ e1
        rw [Polynomial.scaleRoots_mul] at e3
        have hQ' : (Q.scaleRoots t₁).Monic := (Polynomial.monic_scaleRoots_iff t₁).mpr hQ
        obtain ⟨t₂, ht₂S, ht₂⟩ := ih (Q.scaleRoots t₁) hQ' y₁ e3
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp ht₂
        refine ⟨t₂ * t₁, S.mul_mem ht₂S ht₁S, Ideal.mem_span_singleton'.mpr ⟨w, ?_⟩⟩
        calc w * ϖ ^ (k + 1) = (w * ϖ ^ k) * ϖ := by ring
          _ = t₂ * y₁ * ϖ := by rw [hw]
          _ = t₂ * (y₁ * ϖ) := by ring
          _ = t₂ * (t₁ * y) := by rw [hy₁]
          _ = t₂ * t₁ * y := by ring
