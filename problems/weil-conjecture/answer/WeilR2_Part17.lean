          (DerivedCategory.Q.map eK)⟦((n - 1 : ℕ) : ℤ)⟧' ∧
      (Abelian.Ext.mapExactFunctor Di.Φ y).comp (Abelian.Ext.mk₀ Di.μ.hom) (add_zero (n - 1)) ≠ 0 :=
by

  have s5 : ∀ {S : Scheme.{u}} (Vt Dt : S.ProEt) (ιD : Dt ⟶ Vt)
      (X X' : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (X ⟶ M) ≃ M.val.obj (Opposite.op Vt))
      (_ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : X ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op Vt)).hom (ev M g))
      (ev' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (X' ⟶ M) ≃ M.val.obj (Opposite.op Dt))
      (_ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : X' ⟶ M),
        ev' N (g ≫ ψ) = (ψ.val.app (Opposite.op Dt)).hom (ev' M g)),
      ∃ ι : X' ⟶ X, ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : X ⟶ M),
        ev' M (ι ≫ g) = (M.val.map ιD.op).hom (ev M g) := by
    intro S Vt Dt ιD X X' ev hnat ev' hnat'
    obtain ⟨s, hs⟩ : ∃ s : X.val.obj (Opposite.op Dt), s = (X.val.map ιD.op).hom (ev X (𝟙 X)) :=
      ⟨_, rfl⟩
    refine ⟨(ev' X).symm s, fun M g => ?_⟩
    rw [hnat', Equiv.apply_symm_apply, hs]
    have h1 := hnat X M g (𝟙 X)
