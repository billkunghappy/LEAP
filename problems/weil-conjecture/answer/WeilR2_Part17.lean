    have hinj : ∀ n : ℕ, Function.Injective (μs n) := by
      intro n
      refine G2 (μs n) (τs n) ℓ (hexs n) ?_ (hup (n + 1)).1 hBfin hBc ?_
      · intro x
        obtain ⟨x', hx'⟩ := hsurj n x
        exact ⟨x', by rw [hτs]; exact hx'⟩
      · rw [hcard, hcard, pow_succ']
    have hC3 : ∀ (n M : ℕ), M + 1 = N →
        ∀ e : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) M,
          ∃ e' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) M,
            e'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
              continuous_of_discreteTopology)) (add_zero M) = e := by
      intro n M hM e
      apply Abelian.Ext.covariant_sequence_exact₃ P (hSES n) e hM
      have hc : (hSES n).extClass.comp (Abelian.Ext.mk₀ (μ n)) (add_zero 1) = 0 :=
