      have hemb : Topology.IsEmbedding φ :=
        (Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap continuous_of_discreteTopology
          hφinj (fun s _ => isOpen_discrete _)).isEmbedding
      have hψ : ∀ j : ℤ, wcTowerCast ℓ n (j : ZMod (ℓ ^ (n + 1))) = (j : ZMod (ℓ ^ n)) := by
        intro j
        change (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n)))
          (j : ZMod (ℓ ^ (n + 1))) = _
        exact map_intCast _ j
      have hexact : ∀ b, wcTowerCast ℓ n b = 0 ↔ ∃ a, φ a = b := by
        intro b
        obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
        rw [hψ, ZMod.intCast_zmod_eq_zero_iff_dvd]
        constructor
        · rintro ⟨j, hj⟩
          refine ⟨(j : ZMod ℓ), ?_⟩
          rw [hφ, hj]
          push_cast
          ring
        · rintro ⟨a, ha⟩
          obtain ⟨j, rfl⟩ := ZMod.intCast_surjective a
          rw [hφ] at ha
          have h1 : ((j * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) = (kb : ZMod (ℓ ^ (n + 1))) := by
            push_cast at ha ⊢
            exact ha
          rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
          have h2 : ((ℓ ^ n : ℕ) : ℤ) ∣ kb - j * ((ℓ ^ n : ℕ) : ℤ) :=
            (Int.natCast_dvd_natCast.mpr (pow_dvd_pow ℓ (Nat.le_succ n))).trans h1
          have h3 : ((ℓ ^ n : ℕ) : ℤ) ∣ j * ((ℓ ^ n : ℕ) : ℤ) := Dvd.intro_left _ rfl
          have h4 := dvd_add h2 h3
          rwa [sub_add_cancel] at h4
      have hsurj : Function.Surjective (wcTowerCast ℓ n) :=
        ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ n))
      obtain ⟨hz, hS⟩ := hcse φ continuous_of_discreteTopology
        (wcTowerCast ℓ n) continuous_of_discreteTopology hemb hexact
        ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
      exact ⟨wcContSheafMap S φ continuous_of_discreteTopology, hz, hS⟩
    choose μ hz hSES using hses
    have hex : ∀ (n : ℕ) (a : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N),
        a.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology))
          (add_zero N) = 0 ↔
        ∃ b : Abelian.Ext P (wcZModSheaf S ℓ) N, b.comp (Abelian.Ext.mk₀ (μ n)) (add_zero N) = a := by
      intro n a
      constructor
      · intro h
        exact Abelian.Ext.covariant_sequence_exact₂ P (hSES n) a h
      · rintro ⟨b, rfl⟩
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hz n,
          Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have G1 : ∀ {B A C : Type (u+1)} [AddCommGroup B] [AddCommGroup A] [AddCommGroup C]
        (f : B →+ A) (g : A →+ C), (∀ a, g a = 0 ↔ ∃ b, f b = a) → Finite B → Finite C →
        Finite A ∧ Nat.card A ≤ Nat.card B * Nat.card C := by
      intro B A C _ _ _ f g hfg hB hC
      let pre : C → A := fun z => if hz : ∃ y, g y = z then hz.choose else 0
      have hpre : ∀ y, g (pre (g y)) = g y := by
        intro y
        have hz : ∃ y', g y' = g y := ⟨y, rfl⟩
        simp only [pre, dif_pos hz]
        exact hz.choose_spec
      have hmem : ∀ y, y - pre (g y) ∈ Set.range f := by
        intro y
        exact Set.mem_range.mpr ((hfg _).mp (by rw [map_sub, hpre, sub_self]))
      haveI : Finite (Set.range f) := (Set.finite_range f).to_subtype
      let Fm : A → C × Set.range f := fun y => (g y, ⟨y - pre (g y), hmem y⟩)
      have hF : Function.Injective Fm := by
        intro y y' hyy
        simp only [Fm, Prod.mk.injEq, Subtype.mk.injEq] at hyy
        obtain ⟨e1, e2⟩ := hyy
        rw [e1] at e2
        exact sub_left_injective e2
      haveI hAfin : Finite A := Finite.of_injective Fm hF
      refine ⟨hAfin, ?_⟩
      calc Nat.card A ≤ Nat.card (C × Set.range f) := Nat.card_le_card_of_injective Fm hF
        _ = Nat.card C * Nat.card (Set.range f) := Nat.card_prod _ _
        _ ≤ Nat.card C * Nat.card B :=
            Nat.mul_le_mul_left _ (Nat.card_le_card_of_surjective (Set.rangeFactorization (⇑f))
              Set.rangeFactorization_surjective)
        _ = Nat.card B * Nat.card C := mul_comm _ _
    have G2 : ∀ {B A C : Type (u+1)} [AddCommGroup B] [AddCommGroup A] [AddCommGroup C]
        (f : B →+ A) (g : A →+ C) (k : ℕ), (∀ a, g a = 0 ↔ ∃ b, f b = a) →
        Function.Surjective g → Finite A → Finite B → Nat.card B ≤ k →
        Nat.card A = k * Nat.card C → Function.Injective f := by
      intro B A C _ _ _ f g k hfg hg hA hB hBk hAk
      haveI : Finite C := Finite.of_surjective g hg
      let f' : B → g.ker := fun b =>
        ⟨f b, (AddMonoidHom.mem_ker).mpr ((hfg (f b)).mpr ⟨b, rfl⟩)⟩
      have hf' : Function.Surjective f' := by
        intro x
        obtain ⟨b, hb⟩ := (hfg x.1).mp (AddMonoidHom.mem_ker.mp x.2)
        exact ⟨b, Subtype.ext hb⟩
      have hcardA : Nat.card A = Nat.card C * Nat.card g.ker := by
        rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup g.ker,
          Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective g hg).toEquiv]
      have hCpos : 0 < Nat.card C := Nat.card_pos
      have hK : Nat.card g.ker = k := by
        apply Nat.eq_of_mul_eq_mul_left hCpos
        rw [← hcardA, hAk, mul_comm]
      have hbij := hf'.bijective_of_nat_card_le (by rw [hK]; exact hBk)
      intro b b' hbb
      apply hbij.1
      exact Subtype.ext hbb
    have hT0 : ∀ y : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ 0))) N, y = 0 := by
      intro y
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      have h0 : 𝟙 (wcContSheaf S (ZMod (ℓ ^ 0))) = 0 := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro y
        apply ULift.ext
        apply ContinuousMap.ext
        intro t
        exact Subsingleton.elim _ _
      rw [← Abelian.Ext.comp_mk₀_id y, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    haveI hsub0 : Subsingleton (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ 0))) N) :=
