    have hc : WeaklyEtale (Vt.left.fromSpecStalk z ≫ Vt.hom ≫ 𝟙 (Spec (.of B))) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hf
        (@MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ Vt.prop
          (@MorphismProperty.id_mem _ _ @WeaklyEtale
            MorphismProperty.IsMultiplicative.toContainsIdentities _))
    refine @hbij (Vt.left.presheaf.stalk z) _ (hW.2.2.2.2 z hz).1 (hW.2.2.2.2 z hz).2
      (Vt.left.fromSpecStalk z ≫ Vt.hom ≫ 𝟙 (Spec (.of B))) hc ?_ Pq q' t hP k hk D hD j
    show Vt.hom (Vt.left.fromSpecStalk z (IsLocalRing.closedPoint (Vt.left.presheaf.stalk z))) ∈ _
    rw [Scheme.fromSpecStalk_closedPoint]
    exact hrange z hz
  haveI : IsAffine (Limits.pullback Vt.hom g) :=
