        (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 := by
      rw [hydef]; exact hy0 _
    obtain ⟨e₁, he₁def⟩ : ∃ e₁ : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev (2 * r)))).val.obj
        (Opposite.op ((wcEtBaseChange i).obj W)),
        e₁ = ((R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev (2 * r)))).val.map hV.op).hom e :=
      ⟨_, rfl⟩
    have hres1 : ((R.obj (I.cocomplex.X (2 * r))).val.map hV.op).hom
        ((cb.val.app (Opposite.op V)).hom (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op V))) = y := by
      have h1 : ((SheafOfModules.unit (wcEtZModRing Z ℓ)).val.map hV.op).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op V)) =
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))) :=
        PresheafOfModules.unit_map_one _ _
      have h2 := PresheafOfModules.naturality_apply cb.val hV.op
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op V))
      rw [h1] at h2
      rw [hydef]
      exact h2.symm
    have he₁ : ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev (2 * r)) (2 * r))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom e₁ = a • y := by
      rw [he₁def, PresheafOfModules.naturality_apply, he', map_nsmul, hres1]
      all_goals first | rfl | exact rfl | simp
    obtain ⟨EW, γW, hθW, hclW'⟩ := hThomW W
    generalize hω : wcEtSuppRestr D EW (DW W) γW (2 * r) θ = ω at hθW hclW'
    have hclW : cl W y = ω := by rw [hydef]; exact hclW'
    have haω : a • ω = 0 := by
      rw [← hclW, ← P1 W y a hyc, ← he₁]
      exact P5 W e₁
    haveI : Etale W.hom := W.prop
    haveI := hWsm W
    haveI := hZWsm W
    obtain ⟨N, fN, f, x', g, hsmN, hsep, hf, hx', hpb⟩ :=
      wc_smooth_pair_transversal_point_slice K W.left (Limits.pullback W.hom i) (W.hom ≫ pY) n r
        (Limits.pullback.fst W.hom i) hrn ⟨x⟩
    haveI := hsmN
    haveI := hsep
    obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists f ℓ
    obtain ⟨Dx⟩ := wc_et_zmod_pull_data_exists x' ℓ
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change (Limits.pullback.fst W.hom i) f x' g hpb
      (DW W) Df Dx
    haveI hx0 : SmoothOfRelativeDimension (r - r) (x' ≫ fN) := by
      rw [hx', Nat.sub_self]; infer_instance
    have ht := wc_et_thom_class_restrict K ℓ hℓ T hGL hNat (W.hom ≫ pY) fN f hf n r r
      (Limits.pullback.fst W.hom i) x' hrn le_rfl g hpb (DW W) Df Dx γ hγ ω hθW
    have hne := wc_et_thom_class_point_ne_zero K ℓ hℓ T hPt N fN r x' hx' Dx _ ht
    have hω0 : ω ≠ 0 := by
      intro h0
      apply hne
      rw [h0, map_zero]
    have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
    have htorG : ∀ (S : Scheme.{u}) (P : SheafOfModules.{u+1} (wcEtZModRing S ℓ)) (q : ℕ)
        (z : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) _ _ (HasExt.standard _)
          P (SheafOfModules.unit (wcEtZModRing S ℓ)) q), ℓ • z = 0 := by
      intro S P q z
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) := HasExt.standard _
      have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit
            (wcEtZModRing S ℓ))) =
          m • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S ℓ))) :
            Abelian.Ext (SheafOfModules.unit (wcEtZModRing S ℓ))
              (SheafOfModules.unit (wcEtZModRing S ℓ)) 0) := by
        intro m
        induction m with
        | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
        | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
      have hzero : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing S ℓ)) = 0 := by
        have h := (wc_et_zmod_unit_pow_exact S ℓ 1 hℓpos).1
        rw [pow_one] at h
        exact h
      have hlin := map_nsmul (Abelian.Ext.bilinearComp P
        (SheafOfModules.unit (wcEtZModRing S ℓ))
        (SheafOfModules.unit (wcEtZModRing S ℓ))
        q 0 q (add_zero _) z) ℓ
        (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S ℓ))))
      simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
      rw [Abelian.Ext.comp_mk₀_id] at hlin
      rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have htor : ℓ • ω = 0 := htorG _ _ _ ω
    have hord : addOrderOf ω = ℓ := by
      rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
          (addOrderOf_dvd_of_nsmul_eq_zero htor) with h | h
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hω0
      · exact h
    rw [← hord]
    exact addOrderOf_dvd_of_nsmul_eq_zero haω
  haveI := hEpi
  haveI := hMono
  exact ⟨_, isIso_of_mono_of_epi (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).liftCycles cb (2 * r + 1) (CochainComplex.next ℕ (2 * r)) hk ≫
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ (2 * r))⟩

theorem wc_et_coh_card_le_prime_pow : ∀ (Y : Scheme.{u}) (ℓ : ℕ), ℓ.Prime → ∀ (N : ℕ), Finite (wcEtCoh Y ℓ N) → Nat.card (wcEtCoh Y ℓ N) ≤ ℓ → ∀ k : ℕ, 1 ≤ k → Finite (wcEtCoh Y (ℓ ^ k) N) ∧ Nat.card (wcEtCoh Y (ℓ ^ k) N) ≤ ℓ ^ k :=
by
  intro Y ℓ hℓ N hfin hcard k hk
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero

  have hcount : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
      (α : A →+ B) (β : B →+ D), (∀ b, β b = 0 → ∃ a, α a = b) → Finite A → Finite D →
      Finite B ∧ Nat.card B ≤ Nat.card A * Nat.card D := by
    intro A B D _ _ _ α β hex hA hD
    have hK : β.ker ≤ α.range := by
      intro b hb
      obtain ⟨a, ha⟩ := hex b ((AddMonoidHom.mem_ker).mp hb)
      exact AddMonoidHom.mem_range.mpr ⟨a, ha⟩
    have e0 := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker
    have e1 : Nat.card (B ⧸ β.ker) = Nat.card β.range :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivRange β).toEquiv
    haveI : Finite α.range := Finite.of_surjective _ α.rangeRestrict_surjective
    haveI : Finite β.ker :=
      Finite.of_injective (AddSubgroup.inclusion hK) (AddSubgroup.inclusion_injective hK)
    haveI : Finite β.range :=
      Finite.of_injective (Subtype.val : β.range → D) Subtype.val_injective
    have h1 : Nat.card β.ker ≤ Nat.card A :=
      (Nat.card_le_card_of_injective _ (AddSubgroup.inclusion_injective hK)).trans
        (Nat.card_le_card_of_surjective _ α.rangeRestrict_surjective)
    have h2 : Nat.card β.range ≤ Nat.card D :=
      Nat.card_le_card_of_injective _ Subtype.val_injective
    have hp1 : 0 < Nat.card β.range := Nat.card_pos
    have hp2 : 0 < Nat.card β.ker := Nat.card_pos
    have hB : Nat.card B = Nat.card β.range * Nat.card β.ker := by rw [e0, e1]
    have hpos : 0 < Nat.card β.range * Nat.card β.ker := Nat.mul_pos hp1 hp2
    refine ⟨Nat.finite_of_card_ne_zero (by omega), ?_⟩
    rw [hB, mul_comm]
    exact Nat.mul_le_mul h1 h2

  have habs : ∀ (P : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})),
      S.ShortExact → Finite (Abelian.Ext P S.X₁ N) → Finite (Abelian.Ext P S.X₃ N) →
      Finite (Abelian.Ext P S.X₂ N) ∧
        Nat.card (Abelian.Ext P S.X₂ N) ≤
          Nat.card (Abelian.Ext P S.X₁ N) * Nat.card (Abelian.Ext P S.X₃ N) := by
    intro P S hS hf1 hf3
    let α : Abelian.Ext P S.X₁ N →+ Abelian.Ext P S.X₂ N :=
      (Abelian.Ext.mk₀ S.f).postcomp P (add_zero N)
    let β : Abelian.Ext P S.X₂ N →+ Abelian.Ext P S.X₃ N :=
      (Abelian.Ext.mk₀ S.g).postcomp P (add_zero N)
    have hα : ∀ (x : Abelian.Ext P S.X₁ N),
        α x = x.comp (Abelian.Ext.mk₀ S.f) (add_zero N) := by
      intro x
      simp only [α, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply]
    have hβ : ∀ (x : Abelian.Ext P S.X₂ N),
        β x = x.comp (Abelian.Ext.mk₀ S.g) (add_zero N) := by
      intro x
      simp only [β, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply]
    have hex : ∀ b, β b = 0 → ∃ a, α a = b := by
      intro b hb
      rw [hβ] at hb
      obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS b hb
      exact ⟨a, by rw [hα]; exact ha⟩
    exact hcount α β hex hf1 hf3

  have hses : ∀ (p k : ℕ), p ≠ 0 →
      ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
        (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
        (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
    intro p k hp
    have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
        ZMod.natCast_self]
    let α : ZMod k →+ ZMod (p * k) :=
      ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
      intro z
      show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
      rw [ZMod.lift_coe]
      change z • (p : ZMod (p * k)) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
      map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ g = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Y)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  induction k, hk using Nat.le_induction with
  | base => rw [pow_one]; exact ⟨hfin, hcard⟩
  | succ j hj ih =>
    obtain ⟨hfj, hcj⟩ := ih
    have hp : ℓ ^ j ≠ 0 := pow_ne_zero j hℓ0
    obtain ⟨f, g, hw, hS₀⟩ := hses (ℓ ^ j) ℓ hp
    have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    obtain ⟨hB, hBc⟩ := habs ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS
      (by change Finite (wcEtCoh Y ℓ N); exact hfin)
      (by change Finite (wcEtCoh Y (ℓ ^ j) N); exact hfj)
    change Finite (wcEtCoh Y (ℓ ^ j * ℓ) N) at hB
    change Nat.card (wcEtCoh Y (ℓ ^ j * ℓ) N) ≤
      Nat.card (wcEtCoh Y ℓ N) * Nat.card (wcEtCoh Y (ℓ ^ j) N) at hBc
    rw [pow_succ]
    refine ⟨hB, hBc.trans ?_⟩
    calc Nat.card (wcEtCoh Y ℓ N) * Nat.card (wcEtCoh Y (ℓ ^ j) N) ≤ ℓ * ℓ ^ j :=
          Nat.mul_le_mul hcard hcj
      _ = ℓ ^ j * ℓ := mul_comm _ _

theorem wc_et_punct_affine_top_card_prime_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c : ℕ), 2 ≤ c → ∀ (U : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh (U : Scheme.{u}) (ℓ ^ k) (2 * c - 1)) = ℓ ^ k :=
by
  intro K _ _ ℓ _ hℓK c hc U hU k hk
  classical
  have hℓ : ℓ.Prime := Fact.out
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero

  have htors : ∀ (Z : Scheme.{u}) (m q : ℕ) (y : wcEtZModExt Z m q), m • y = 0 := by
    intro Z m q y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have hsm : ∀ (c : ℕ) X (s : (SheafOfModules.unit (wcEtZModRing Z m)).val.obj X),
        ((c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m))).val.app X).hom s = c • s := by
      intro c X s
      induction c with
      | zero =>
        rw [zero_smul, zero_smul]
        have h00 : ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s =
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s +
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s := by
          conv_lhs => rw [← add_zero (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
            SheafOfModules.unit (wcEtZModRing Z m))]
          rw [SheafOfModules.add_val, PresheafOfModules.add_app]
          rfl
        exact add_left_cancel (h00.symm.trans (add_zero _).symm)
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app]
        rw [ModuleCat.hom_add, LinearMap.add_apply, ih]
        rfl
    obtain ⟨-, -, -, hm⟩ := wc_et_zmod_ring_locbij Z m
    have hmU : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      rw [hsm m X s, show (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
          SheafOfModules.unit (wcEtZModRing Z m)) =
          0 • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) from (zero_smul _ _).symm, hsm 0 X s,
        zero_smul, ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Z m).obj.obj X), hm X, zero_smul]
    have hcomp : ∀ c : ℕ, y.comp (Abelian.Ext.mk₀ (c • 𝟙 (SheafOfModules.unit
        (wcEtZModRing Z m)))) (add_zero q) = c • y := by
      intro c
      induction c with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id]
    rw [← hcomp m, hmU, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have S6 : ∀ (Z : Scheme.{u}) (q : ℕ), Finite (wcEtCoh Z ℓ q) → Nat.card (wcEtCoh Z ℓ q) ≤ ℓ →
      (∃ ω : wcEtZModExt Z ℓ q, ω ≠ 0) → Nat.card (wcEtCoh Z ℓ q) = ℓ := by
    intro Z q hfin hcard hex
    obtain ⟨ω, hω⟩ := hex
    obtain ⟨EO⟩ := wc_et_zmodext_coh_equiv Z ℓ q
    haveI := hfin
    haveI : Finite (wcEtZModExt Z ℓ q) := Finite.of_equiv _ EO.symm
    have hG : Nat.card (wcEtZModExt Z ℓ q) ≤ ℓ := (Nat.card_congr EO).trans_le hcard
    have hord : addOrderOf ω = ℓ := addOrderOf_eq_prime (htors Z ℓ q ω) hω
    have hlow : ℓ ≤ Nat.card (wcEtZModExt Z ℓ q) := by
      have h1 : Nat.card (AddSubgroup.zmultiples ω) = ℓ := by rw [Nat.card_zmultiples, hord]
      have h2 := Nat.card_le_card_of_injective
        (Subtype.val : AddSubgroup.zmultiples ω → wcEtZModExt Z ℓ q) Subtype.val_injective
      exact (le_of_eq h1.symm).trans h2
    rw [← Nat.card_congr EO]
    exact le_antisymm hG hlow

  have S1 : ∀ (Z : Scheme.{u}) (N : ℕ), 1 ≤ N → Nat.card (wcEtCoh Z ℓ N) = ℓ →
      Subsingleton (wcEtCoh Z ℓ (N + 1)) →
      (∀ j : ℕ, 1 ≤ j → Subsingleton (wcEtCoh Z (ℓ ^ j) (N - 1))) →
      ∀ kk : ℕ, 1 ≤ kk → Nat.card (wcEtCoh Z (ℓ ^ kk) N) = ℓ ^ kk := by
    intro Z N hN h1 h2 hlow kk hkk
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hN1 : N - 1 + 1 = N := by omega
    have hcard : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
        (α : A →+ B) (β : B →+ D), Function.Injective α → (∀ b, β b = 0 ↔ ∃ a, α a = b) →
        Nat.card B = Nat.card A * Nat.card β.range := by
      intro A B D _ _ _ α β hα hex
      have hker : β.ker = α.range := by
        ext b
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        exact hex b
      have e1 : Nat.card (B ⧸ β.ker) = Nat.card β.range :=
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange β).toEquiv
      have e2 : Nat.card β.ker = Nat.card A := by
        rw [hker]
        exact (Nat.card_congr (AddMonoidHom.ofInjective hα).toEquiv).symm
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker, e1, e2, mul_comm]
    have habsN : ∀ (P : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})),
        S.ShortExact → Subsingleton (Abelian.Ext P S.X₁ (N + 1)) →
        (∀ z : Abelian.Ext P S.X₁ N, z.comp (Abelian.Ext.mk₀ S.f) (add_zero N) = 0 → z = 0) →
        Nat.card (Abelian.Ext P S.X₂ N) =
          Nat.card (Abelian.Ext P S.X₁ N) * Nat.card (Abelian.Ext P S.X₃ N) := by
      intro P S hS hsub hinj
      let α : Abelian.Ext P S.X₁ N →+ Abelian.Ext P S.X₂ N :=
        (Abelian.Ext.mk₀ S.f).postcomp P (add_zero N)
      let β : Abelian.Ext P S.X₂ N →+ Abelian.Ext P S.X₃ N :=
        (Abelian.Ext.mk₀ S.g).postcomp P (add_zero N)
      have hα : ∀ (x : Abelian.Ext P S.X₁ N),
          α x = x.comp (Abelian.Ext.mk₀ S.f) (add_zero N) := by
        intro x
        simp only [α, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
          Abelian.Ext.bilinearComp_apply_apply]
      have hβ : ∀ (x : Abelian.Ext P S.X₂ N),
          β x = x.comp (Abelian.Ext.mk₀ S.g) (add_zero N) := by
        intro x
        simp only [β, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
          Abelian.Ext.bilinearComp_apply_apply]
      have hex : ∀ b, β b = 0 ↔ ∃ a, α a = b := by
        intro b
        rw [hβ]
        constructor
        · intro hb
          obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS b hb
          exact ⟨a, by rw [hα]; exact ha⟩
        · rintro ⟨a, rfl⟩
          rw [hα, Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ S.f) (Abelian.Ext.mk₀ S.g) (add_zero N)
            (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero,
            Abelian.Ext.comp_zero]
      have hinjN : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        rw [hα] at hz
        exact hinj z hz
      have hsurjN : Function.Surjective β := by
        intro x₃
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x₃ (rfl : N + 1 = N + 1)
          (Subsingleton.elim _ _)
        exact ⟨x₂, by rw [hβ]; exact hx₂⟩
      rw [hcard α β hinjN hex, AddMonoidHom.range_eq_top.mpr hsurjN, AddSubgroup.card_top]
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Z)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    induction kk, hkk using Nat.le_induction with
    | base => rw [pow_one]; exact h1
    | succ j hj ih =>
      have hp : ℓ ^ j ≠ 0 := pow_ne_zero j hℓ0
      obtain ⟨f, g, hw, hS₀⟩ := hses (ℓ ^ j) ℓ hp
      have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      have key := habsN ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS h2 (fun z hz => by
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS z hz hN1
        obtain ⟨hs⟩ := hlow j hj
        have h0 : x₃ = 0 := (hs x₃ (x₃ - x₃)).trans (sub_self x₃)
        rw [← hx₃, h0, Abelian.Ext.zero_comp])
      change Nat.card (wcEtCoh Z (ℓ ^ j * ℓ) N) =
        Nat.card (wcEtCoh Z ℓ N) * Nat.card (wcEtCoh Z (ℓ ^ j) N) at key
      rw [pow_succ, key, h1, ih, mul_comm]

  obtain ⟨hfin, hcard⟩ := wc_et_punctured_affine_coh_card_le K c (by omega) ℓ hℓ hℓK U hU
  obtain ⟨ω, hω⟩ := wc_et_punctured_affine_top_ne_zero K ℓ hℓK c (by omega) U hU
  have h1 := S6 (U : Scheme.{u}) (2 * c - 1) hfin hcard ⟨ω, hω⟩
  have hE : (U : Set (Spec (.of (MvPolynomial (Fin c) K)))) =
      {x | ∃ j : Fin c, j.val < c ∧ (MvPolynomial.X j : MvPolynomial (Fin c) K) ∉ x.asIdeal} := by
    rw [hU]
    ext x
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall, Set.mem_setOf_eq]
    exact ⟨fun ⟨j, hj⟩ => ⟨j, j.isLt, hj⟩, fun ⟨j, _, hj⟩ => ⟨j, hj⟩⟩
  have h2 := wc_et_affine_partial_punct_vanishing K ℓ hℓ hℓK c c le_rfl U hE (2 * c - 1 + 1)
    (by omega)
  have h3 : ∀ j : ℕ, 1 ≤ j → Subsingleton (wcEtCoh (U : Scheme.{u}) (ℓ ^ j) (2 * c - 1 - 1)) := by
    intro j hj
    obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
    have h0 := wc_rpss_punct_affine_low_vanishing K c ℓ hℓK U hU (2 * c - 1 - 1) (by omega)
      (by omega)
    exact wc_et_coh_zmod_prime_pow_of_prime _ ℓ hℓ _ h0 i
  exact S1 _ (2 * c - 1) (by omega) h1 h2 h3 k hk

theorem wc_et_open_restr_pull_of_supp_vanish : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (O : Y.Opens), (O : Set Y) = (Set.range i)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ), (∀ (D : wcEtPullData i ℓ) (q : ℕ), (q = N ∨ q = N + 1) → Subsingleton (wcEtSuppExt D q)) → (∀ (Dj : wcEtPullData O.ι ℓ) (q : ℕ), (q = N ∨ q = N + 1) → Function.Injective (wcEtPull Dj q)) ∧ ∀ k : ℕ, 1 ≤ k → ∀ (Dj : wcEtPullData O.ι (ℓ ^ k)), Function.Surjective (wcEtPull Dj N) :=
by
  classical
  intro Y Z i _ O hO ℓ _ N hvan
  have hrange : Set.range O.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι, hO]

  have L : ∀ (M : ℕ), 0 < M → ∀ (D : wcEtPullData i M) (Dj : wcEtPullData O.ι M),
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y M)) := HasExt.standard _
      (∀ (k : ℕ) (y : wcEtZModExt Y M k), wcEtPull Dj k y = 0 →
        ∃ x : wcEtSuppExt D k, (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add k) = y) ∧
      (∀ s k : ℕ, 1 + s = k → ∃ δ : wcEtZModExt O.toScheme M s →+ wcEtSuppExt D k,
        ∀ b, δ b = 0 → ∃ v : wcEtZModExt Y M s, wcEtPull Dj s v = b) := by
    intro M hM D Dj
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y M)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing O.toScheme M)) := HasExt.standard _
    letI : Dj.Φ.Additive := Dj.additive
    letI : Limits.PreservesFiniteLimits Dj.Φ := Dj.presLim
    letI : Limits.PreservesFiniteColimits Dj.Φ := Dj.presColim
    haveI hepi : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
        (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D))
        (show Mono (Limits.kernel.ι (wcEtSuppUnitMap D)) from inferInstance)
        (show Epi (wcEtSuppUnitMap D) from hepi)

    have hB0 : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
      have hsq := IsPullback.of_hasPullback i O.ι
      haveI : IsClosedImmersion (Limits.pullback.snd i O.ι) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
      have hE : IsEmpty ↥(Limits.pullback i O.ι : Scheme.{u}) := by
        apply Scheme.isEmpty_of_commSq hsq.toCommSq
        rw [hrange]
        exact disjoint_compl_right
      obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i O.ι) M
      obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change i O.ι (Limits.pullback.snd i O.ι)
        (Limits.pullback.fst i O.ι) hsq D Dj D'
      have hZ' : Limits.IsZero (wcEtSuppObj D') := by
        rw [Limits.IsZero.iff_id_eq_zero]
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro V
        haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd i O.ι) M D' V.unop
          (fun _ ⟨p, _⟩ => hE.false p)
        exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
      have h0 : Dj.μ.inv ≫ Dj.Φ.map (wcEtSuppUnitMap D) = 0 := by
        rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
      haveI : Dj.Φ.IsLeftAdjoint := Dj.adj.isLeftAdjoint
      haveI : Epi (Dj.Φ.map (wcEtSuppUnitMap D)) := Dj.Φ.map_epi _
      exact Limits.IsZero.of_epi_eq_zero _ h0
    have hSΦ := hS.map_of_exact Dj.Φ
    haveI hιiso : IsIso (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      hSΦ.isIso_f_iff.mpr hB0
    obtain ⟨c, hcdef⟩ : ∃ c, c = Dj.μ.inv ≫ inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      ⟨_, rfl⟩
    haveI hciso : IsIso c := by rw [hcdef]; infer_instance
    have hc1 : c ≫ Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dj.μ.inv := by
      rw [hcdef, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y M)) :=
      sheafOfModules_enoughInjectives _ _

    have hbij : ∀ k : ℕ, Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y M)) k =>
        (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp
          (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) := by
      intro k
      have hA : Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing Y M)) k => Abelian.Ext.mapExactFunctor Dj.Φ x) := by
        have h := ext_transfer_of_corep Dj.Φ (Limits.kernel (wcEtSuppUnitMap D))
          (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
          (fun T => wc_et_open_restr_ker_corep i O.ι hrange M hM D Dj T)
          (fun I _ m e => by
            haveI : Injective (Dj.Φ.obj I) :=
              wc_et_open_pull_preserves_injective O.ι M Dj I inferInstance
            exact Abelian.Ext.eq_zero_of_injective e)
          (SheafOfModules.unit (wcEtZModRing Y M)) k
        have e : (fun β : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
            (SheafOfModules.unit (wcEtZModRing Y M)) k =>
            (Abelian.Ext.mk₀ (𝟙 (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))))).comp
              (Abelian.Ext.mapExactFunctor Dj.Φ β) (zero_add k)) =
            fun β => Abelian.Ext.mapExactFunctor Dj.Φ β :=
          funext fun β => Abelian.Ext.mk₀_id_comp _
        rw [e] at h
        exact h
      have hB : Function.Bijective (fun y : Abelian.Ext (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
          (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y M))) k =>
          (Abelian.Ext.mk₀ c).comp (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) := by
        rw [Function.bijective_iff_has_inverse]
        refine ⟨fun z => ((Abelian.Ext.mk₀ (inv c)).comp z (zero_add k)).comp
          (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero k), ?_, ?_⟩
        · intro y
          simp only
          rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
            IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        · intro z
          simp only
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
            Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      exact hB.comp hA

    let Ψ : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y M)) k →+ wcEtZModExt O.toScheme M k := fun k =>
      ((Abelian.Ext.mk₀ c).precomp (SheafOfModules.unit (wcEtZModRing O.toScheme M))
        (zero_add k)).comp
        (((Abelian.Ext.mk₀ Dj.μ.hom).postcomp (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
          (add_zero k)).comp
          (Dj.Φ.mapExtAddHom (Limits.kernel (wcEtSuppUnitMap D))
            (SheafOfModules.unit (wcEtZModRing Y M)) k))
    have hΨapp : ∀ (k : ℕ) (x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y M)) k),
        Ψ k x = (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp
          (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k) := fun k x => rfl
    have hΨ : ∀ k : ℕ, Function.Bijective (Ψ k) := by
      intro k
      have hb := hbij k
      have hfun : (Ψ k : _ → _) = (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing Y M)) k => (Abelian.Ext.mk₀ c).comp
            ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
            (zero_add k)) := funext (hΨapp k)
      rw [hfun]
      exact hb
    let Ψe : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y M)) k ≃+ wcEtZModExt O.toScheme M k :=
      fun k => AddEquiv.ofBijective (Ψ k) (hΨ k)
    have hΨe : ∀ k x, Ψe k x = Ψ k x := fun k x => rfl
    have KI : ∀ (k : ℕ) (w : wcEtZModExt Y M k),
        Ψ k ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add k)) =
          wcEtPull Dj k w := by
      intro k w
      have hpull : wcEtPull Dj k w = (Abelian.Ext.mk₀ Dj.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor Dj.Φ w).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
          (zero_add k) := rfl
      rw [hpull, hΨapp, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc, hc1]
    refine ⟨fun k y hy => ?_, fun s k h => ?_⟩
    · have hy' : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp y (zero_add k) = 0 := by
        rw [← KI] at hy
        exact (hΨ k).1 (hy.trans (map_zero (Ψ k)).symm)
      exact Abelian.Ext.contravariant_sequence_exact₂ hS _ y hy'
    · let δ : wcEtZModExt O.toScheme M s →+ wcEtSuppExt D k :=
        (hS.extClass.precomp (SheafOfModules.unit (wcEtZModRing Y M)) h).comp
          (Ψe s).symm.toAddMonoidHom
      have hδ : ∀ b, δ b = hS.extClass.comp ((Ψe s).symm b) h := fun b => rfl
      refine ⟨δ, fun b hb => ?_⟩
      rw [hδ] at hb
      obtain ⟨v, hv⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ ((Ψe s).symm b) h hb
      refine ⟨v, ?_⟩
      have hv' : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp v (zero_add s) =
          (Ψe s).symm b := hv
      rw [← KI, hv', ← hΨe]
      exact (Ψe s).apply_symm_apply b
  refine ⟨fun Dj q hq => ?_, fun k hk Dj => ?_⟩
  ·
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
    obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
    haveI := hvan D q hq
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨x, hx⟩ := (L ℓ (Fact.out : Nat.Prime ℓ).pos D Dj).1 q y hy
    rw [Subsingleton.elim x 0, Abelian.Ext.comp_zero] at hx
    exact hx.symm
  ·
    have hM : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists i (ℓ ^ k)
    obtain ⟨hfin, hcard⟩ := wc_et_supp_ext_card_pow_of_prime i ℓ k hk (N + 1) 1
      (fun D₁ => by
        haveI := hvan D₁ (N + 1) (Or.inr rfl)
        exact ⟨Finite.of_subsingleton, Finite.card_le_one_iff_subsingleton.mpr inferInstance⟩) D'
    rw [one_pow] at hcard
    haveI := hfin
    haveI hsub : Subsingleton (wcEtSuppExt D' (N + 1)) :=
      Finite.card_le_one_iff_subsingleton.mp hcard
    obtain ⟨δ, hδ⟩ := (L (ℓ ^ k) hM D' Dj).2 N (N + 1) (by omega)
    intro b
    exact hδ b (Subsingleton.elim _ _)

theorem wc_quad_cone_punct_top_counts (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (n : ℕ) (hn : Even n) (h4 : 4 ≤ n)
    (c : Matrix (Fin n) (Fin n) K) (hc : IsUnit (c + c.transpose).det)
    (Oc : (Spec (.of (wcQuadModelRing K n 0 c))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing K n 0 c)))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal}) :
    Nat.card (wcEtCoh (Oc : Scheme.{u}) ℓ (n - 1)) = ℓ ∧
    Subsingleton (wcEtCoh (Oc : Scheme.{u}) ℓ (n - 1 + 1)) ∧
    ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh (Oc : Scheme.{u}) (ℓ ^ k) (n - 1)) = ℓ ^ k :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  obtain ⟨e, rfl⟩ : ∃ e, n = 2 * e + 1 + 1 := by
    obtain ⟨r, hr⟩ := hn
    exact ⟨r - 1, by omega⟩
  have he : 1 ≤ e := by omega
  rw [show 2 * e + 1 + 1 - 1 = 2 * e + 1 by omega]

  have hopen : ∀ {R : Type u} [CommRing R] {ι : Type} (f : ι → R),
      IsOpen ({y | ∃ i, f i ∉ y.asIdeal} : Set (Spec (.of R))) := by
    intro R _ ι f
    have hU : ({y | ∃ i, f i ∉ y.asIdeal} : Set (Spec (.of R))) =
        ⋃ i, (PrimeSpectrum.zeroLocus {f i})ᶜ := by
      ext y
      constructor
      · rintro ⟨i, hi⟩
        exact Set.mem_iUnion.mpr ⟨i, fun h => hi (h (Set.mem_singleton _))⟩
      · intro h
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp h
        exact ⟨i, fun h' => hi (Set.singleton_subset_iff.mpr h')⟩
    rw [hU]
    exact isOpen_iUnion fun i => (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl
  obtain ⟨Oh, hOh⟩ : ∃ Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens, (Oh : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} :=
    ⟨⟨_, hopen (fun p : Fin (2 * e + 1 + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p))⟩, rfl⟩
  obtain ⟨Ou, hOu⟩ : ∃ Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens, (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉ y.asIdeal} :=
    ⟨⟨_, hopen (fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))))⟩, rfl⟩
  obtain ⟨W, hW0⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens, (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = {y | ∃ t : Fin (e + 1), (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) K) ∉ y.asIdeal} :=
    ⟨⟨_, hopen (fun t : Fin (e + 1) => (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) K))⟩, rfl⟩
  have hW : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ := by
    rw [hW0]
    ext y
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall]
    exact Iff.rfl
  have hE : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = {x | ∃ j : Fin (e + 1), j.val < e + 1 ∧ (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) K) ∉ x.asIdeal} := by
    rw [hW0]
    ext y
    constructor
    · rintro ⟨t, ht⟩
      exact ⟨t, t.isLt, ht⟩
    · rintro ⟨t, -, ht⟩
      exact ⟨t, ht⟩
  have hWne : Nonempty (W : Scheme.{u}) := by
    have hmem : (⟨⊥, inferInstance⟩ : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K)) ∈
        (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) := by
      rw [hW0]
      exact ⟨0, fun h => MvPolynomial.X_ne_zero (R := K) (0 : Fin (e + 1)) (Ideal.mem_bot.mp h)⟩
    exact ⟨⟨_, hmem⟩⟩

  obtain ⟨P, hP, hPq⟩ := wc_quadric_split_normal_form_alg_closed K (2 * e) (even_two_mul e) c
    hc.ne_zero
  have Ec : ∀ M q : ℕ, Nonempty (wcEtCoh (Oc : Scheme.{u}) M q ≃ wcEtCoh (Oh : Scheme.{u}) M q) :=
    fun M q => wc_quad_cone_punct_linear_change_coh_equiv K (2 * e) c
      (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)
      P hP hPq Oc hOc Oh hOh M q

  obtain ⟨hsm, hcpt, hsep⟩ := wc_hyp_quad_cone_punct_smooth_qcsep K e Oh hOh
  obtain ⟨iZ, O', eO, πy, s, hci, hO', hstr, hsec⟩ :=
    wc_hyp_quad_cone_punct_strata K e Oh Ou hOh hOu W hW
  haveI := hsm
  haveI := hcpt
  haveI := hsep
  haveI := hci
  have hZsm : SmoothOfRelativeDimension (e + 1) (iZ ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
      (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := by
    rw [hstr]
    haveI := wc_mvpoly_spec_smoothOfRelDim K (e + 1)
    simpa using (inferInstance : SmoothOfRelativeDimension (0 + (e + 1))
      (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K)))))
  haveI := hZsm

  have hvan : ∀ (D : wcEtPullData iZ ℓ) (q : ℕ), (q = 2 * e + 1 ∨ q = 2 * e + 1 + 1) →
      Subsingleton (wcEtSuppExt D q) := by
    intro D q hq
    have key : ∀ j : ℕ, 1 ≤ j → j ≤ 2 → Subsingleton (wcEtSuppExt D (j + 2 * e)) := by
      intro j hj1 hj2
      obtain ⟨E⟩ := wc_et_smooth_pair_purity_ext_equiv K (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
        (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
        (2 * e + 1) (e + 1) e (by omega) iZ ℓ hℓ hWne D j
      obtain ⟨E2⟩ := wc_et_zmodext_coh_equiv (W : Scheme.{u}) ℓ j
      haveI := wc_rpss_punct_affine_low_vanishing K (e + 1) ℓ hℓ W hW j hj1 (by omega)
      haveI : Subsingleton (wcEtZModExt (W : Scheme.{u}) ℓ j) := E2.subsingleton
      exact E.symm.subsingleton
    rcases hq with rfl | rfl
    · have h1 := key 1 le_rfl (by norm_num)
      rwa [show 1 + 2 * e = 2 * e + 1 by omega] at h1
    · have h2 := key 2 (by norm_num) le_rfl
      rwa [show 2 + 2 * e = 2 * e + 1 + 1 by omega] at h2

  obtain ⟨hinj, hsurj⟩ := wc_et_open_restr_pull_of_supp_vanish iZ O' hO' ℓ (2 * e + 1) hvan
  have chain : ∀ q : ℕ, Nonempty (wcEtZModExt (O' : Scheme.{u}) ℓ q ≃ wcEtCoh (W : Scheme.{u}) ℓ q) := by
    intro q
    obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (O' : Scheme.{u}) ℓ q
    obtain ⟨E2⟩ := wc_et_coh_iso_invariance eO.hom ℓ q
    obtain ⟨E3⟩ := wc_hyp_quad_cone_even_open_coh_equiv K ℓ hℓ e Ou hOu W hW q
    exact ⟨E1.trans (E2.symm.trans E3)⟩
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O'.ι ℓ

  have hsub2 : Subsingleton (wcEtCoh (Oh : Scheme.{u}) ℓ (2 * e + 1 + 1)) := by
    obtain ⟨E⟩ := chain (2 * e + 1 + 1)
    haveI : Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ (2 * e + 1 + 1)) :=
      wc_et_affine_partial_punct_vanishing K ℓ hℓp hℓ (e + 1) (e + 1) le_rfl W hE
        (2 * e + 1 + 1) (by omega)
    haveI : Subsingleton (wcEtZModExt (O' : Scheme.{u}) ℓ (2 * e + 1 + 1)) := E.subsingleton
    haveI : Subsingleton (wcEtZModExt (Oh : Scheme.{u}) ℓ (2 * e + 1 + 1)) :=
      (hinj Dj (2 * e + 1 + 1) (Or.inr rfl)).subsingleton
    obtain ⟨E'⟩ := wc_et_zmodext_coh_equiv (Oh : Scheme.{u}) ℓ (2 * e + 1 + 1)
    exact E'.symm.subsingleton

  have hup1 : Finite (wcEtCoh (Oh : Scheme.{u}) ℓ (2 * e + 1)) ∧
      Nat.card (wcEtCoh (Oh : Scheme.{u}) ℓ (2 * e + 1)) ≤ ℓ := by
    obtain ⟨E⟩ := chain (2 * e + 1)
    obtain ⟨hf, hcd⟩ := wc_et_punctured_affine_coh_card_le K (e + 1) (by omega) ℓ hℓp hℓ W hW
    rw [show 2 * (e + 1) - 1 = 2 * e + 1 by omega] at hf hcd
    haveI := hf
    haveI : Finite (wcEtZModExt (O' : Scheme.{u}) ℓ (2 * e + 1)) := Finite.of_equiv _ E.symm
    have hi := hinj Dj (2 * e + 1) (Or.inl rfl)
    haveI : Finite (wcEtZModExt (Oh : Scheme.{u}) ℓ (2 * e + 1)) := Finite.of_injective _ hi
    obtain ⟨E'⟩ := wc_et_zmodext_coh_equiv (Oh : Scheme.{u}) ℓ (2 * e + 1)
    refine ⟨Finite.of_equiv _ E', ?_⟩
    calc Nat.card (wcEtCoh (Oh : Scheme.{u}) ℓ (2 * e + 1))
        = Nat.card (wcEtZModExt (Oh : Scheme.{u}) ℓ (2 * e + 1)) := (Nat.card_congr E').symm
      _ ≤ Nat.card (wcEtZModExt (O' : Scheme.{u}) ℓ (2 * e + 1)) :=
          Nat.card_le_card_of_injective _ hi
      _ = Nat.card (wcEtCoh (W : Scheme.{u}) ℓ (2 * e + 1)) := Nat.card_congr E
      _ ≤ ℓ := hcd
  have hupk := wc_et_coh_card_le_prime_pow (Oh : Scheme.{u}) ℓ hℓp (2 * e + 1) hup1.1 hup1.2

  have hlow : ∀ k : ℕ, 1 ≤ k → ℓ ^ k ≤ Nat.card (wcEtCoh (Oh : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) := by
    intro k hk
    obtain ⟨Djk⟩ := wc_et_zmod_pull_data_exists O'.ι (ℓ ^ k)
    obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists (s ≫ eO.inv) (ℓ ^ k)
    obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists (eO.hom ≫ πy) (ℓ ^ k)
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (W : Scheme.{u})) (ℓ ^ k)
    have hid : ∀ x, wcEtPull Did (2 * e + 1) x = x := by
      intro x
      have h1 := wc_et_pull_comp (𝟙 _) (𝟙 _) (𝟙 _) (Category.id_comp _) Did Did Did (2 * e + 1) x
      have h2 := wc_et_pull_id_injective Did (2 * e + 1) (wcEtPull Did (2 * e + 1) x - x)
      rw [map_sub, ← h1, sub_self] at h2
      exact sub_eq_zero.mp (h2 rfl)
    have hsec' : (s ≫ eO.inv) ≫ (eO.hom ≫ πy) = 𝟙 _ := by
      rw [Category.assoc, Iso.inv_hom_id_assoc, hsec]
    have hsurj_s : Function.Surjective (wcEtPull Ds (2 * e + 1)) := by
      intro y
      exact ⟨wcEtPull Dπ (2 * e + 1) y,
        (wc_et_pull_comp (eO.hom ≫ πy) (s ≫ eO.inv) (𝟙 _) hsec' Dπ Ds Did (2 * e + 1) y).symm.trans
          (hid y)⟩
    have hcomp : Function.Surjective
        (fun x => wcEtPull Ds (2 * e + 1) (wcEtPull Djk (2 * e + 1) x)) :=
      hsurj_s.comp (hsurj k hk Djk)
    obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (Oh : Scheme.{u}) (ℓ ^ k) (2 * e + 1)
    obtain ⟨E2⟩ := wc_et_zmodext_coh_equiv (W : Scheme.{u}) (ℓ ^ k) (2 * e + 1)
    haveI : Finite (wcEtCoh (Oh : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) := (hupk k hk).1
    haveI : Finite (wcEtZModExt (Oh : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) := Finite.of_equiv _ E1.symm
    have h8 := wc_et_punct_affine_top_card_prime_pow K ℓ hℓ (e + 1) (by omega) W hW k hk
    rw [show 2 * (e + 1) - 1 = 2 * e + 1 by omega] at h8
    calc ℓ ^ k = Nat.card (wcEtCoh (W : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) := h8.symm
      _ = Nat.card (wcEtZModExt (W : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) := (Nat.card_congr E2).symm
      _ ≤ Nat.card (wcEtZModExt (Oh : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) :=
          Nat.card_le_card_of_surjective _ hcomp
      _ = Nat.card (wcEtCoh (Oh : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) := Nat.card_congr E1

  have hOck : ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh (Oc : Scheme.{u}) (ℓ ^ k) (2 * e + 1)) = ℓ ^ k := by
    intro k hk
    obtain ⟨E⟩ := Ec (ℓ ^ k) (2 * e + 1)
    rw [Nat.card_congr E]
    exact le_antisymm (hupk k hk).2 (hlow k hk)
  refine ⟨?_, ?_, hOck⟩
  · have h1 := hOck 1 le_rfl
    rwa [pow_one] at h1
  · obtain ⟨E⟩ := Ec ℓ (2 * e + 1 + 1)
    haveI := hsub2
    exact E.subsingleton

theorem wc_et_split_quad_cone_punct_counts (K : Type u) [Field K] [IsAlgClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (n : ℕ) (hn : Even n) (h4 : 4 ≤ n)
    (x₀ : Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∈ x₀.asIdeal)
    (O : (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hO : (O : Set (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {x₀}ᶜ) :
    (∀ k : ℕ, 1 ≤ k → Finite (wcEtCoh (O : Scheme.{u}) (ℓ ^ k) (n - 1)) ∧
      Nat.card (wcEtCoh (O : Scheme.{u}) (ℓ ^ k) (n - 1)) = ℓ ^ k) ∧
    Subsingleton (wcEtCoh (O : Scheme.{u}) (ℓ ^ 1) n) :=
by
  classical

  have hev : n % 2 = 0 := Nat.even_iff.mp hn
  have hM : ∀ p q : Fin n, ((Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) + (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0).transpose) p q =
      if q.val = (if p.val % 2 = 0 then p.val + 1 else p.val - 1) then 1 else 0 := by
    intro p q
    simp only [Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply]
    split_ifs <;> first | omega | simp
  have hτ : ∀ p : Fin n, (if p.val % 2 = 0 then p.val + 1 else p.val - 1) < n := by
    intro p
    have := p.isLt
    split_ifs <;> omega
  have hdet : IsUnit ((Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) + (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0).transpose).det := by
    apply Matrix.isUnit_det_of_right_inverse (B := (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) + (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0).transpose)
    ext p r
    rw [Matrix.mul_apply, Matrix.one_apply]
    rw [Finset.sum_eq_single (⟨_, hτ p⟩ : Fin n)]
    · rw [hM, hM, if_pos rfl, one_mul]
      by_cases hpr : p = r
      · subst hpr
        rw [if_pos rfl, if_pos]
        change p.val = (if (if p.val % 2 = 0 then p.val + 1 else p.val - 1) % 2 = 0 then
          (if p.val % 2 = 0 then p.val + 1 else p.val - 1) + 1 else
          (if p.val % 2 = 0 then p.val + 1 else p.val - 1) - 1)
        have := p.isLt
        split_ifs <;> omega
      · rw [if_neg hpr, if_neg]
        intro h
        apply hpr
        apply Fin.ext
        change r.val = (if (if p.val % 2 = 0 then p.val + 1 else p.val - 1) % 2 = 0 then
          (if p.val % 2 = 0 then p.val + 1 else p.val - 1) + 1 else
          (if p.val % 2 = 0 then p.val + 1 else p.val - 1) - 1) at h
        split_ifs at h <;> omega
    · intro b _ hb
      rw [hM p b, if_neg, zero_mul]
      intro h
      exact hb (Fin.ext h)
    · intro h
      exact absurd (Finset.mem_univ _) h

  have hvert : ∀ (c : Matrix (Fin n) (Fin n) K), ∃ x₁ : Spec (.of (wcQuadModelRing K n 0 c)),
      {y : Spec (.of (wcQuadModelRing K n 0 c)) |
        ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal} =
        {x₁}ᶜ := by
    intro c
    have hle : wcQuadModelIdeal K n 0 c ≤
        RingHom.ker (MvPolynomial.constantCoeff (R := K) (σ := Fin n)) := by
      unfold wcQuadModelIdeal
      rw [Ideal.span_le]
      intro x hx
      simp only [Set.mem_singleton_iff] at hx
      subst hx
      simp [RingHom.mem_ker, MvPolynomial.constantCoeff_X]
    have h1 : ∀ a ∈ wcQuadModelIdeal K n 0 c, MvPolynomial.constantCoeff a = 0 :=
      fun a ha => hle ha
    let ev : (MvPolynomial (Fin n) K ⧸ wcQuadModelIdeal K n 0 c) →+* K :=
      Ideal.Quotient.lift (wcQuadModelIdeal K n 0 c) MvPolynomial.constantCoeff h1
    have hev' : ∀ f, ev (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) f) =
        MvPolynomial.constantCoeff f := fun f => Ideal.Quotient.lift_mk _ _ _
    have hsurj : Function.Surjective ev := by
      intro a
      refine ⟨Ideal.Quotient.mk _ (MvPolynomial.C a), ?_⟩
      rw [hev', MvPolynomial.constantCoeff_C]
    have hMax : (RingHom.ker ev).IsMaximal := RingHom.ker_isMaximal_of_surjective ev hsurj
    let x₁ : PrimeSpectrum (MvPolynomial (Fin n) K ⧸ wcQuadModelIdeal K n 0 c) :=
      ⟨RingHom.ker ev, hMax.isPrime⟩
    have hXmem : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈
        RingHom.ker ev := by
      intro p
      rw [RingHom.mem_ker, hev', MvPolynomial.constantCoeff_X]
