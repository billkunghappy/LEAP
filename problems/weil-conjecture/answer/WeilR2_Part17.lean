            exact hcard.trans (Nat.le_self_pow hj0 ℓ)
          have htop := AddSubgroup.eq_top_of_le_card _ hle
          have hmem : r x ∈ AddSubgroup.zmultiples (r y) := by
            rw [htop]; exact AddSubgroup.mem_top _
          obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
          have hz : r (x - c • y) = 0 := by rw [map_sub, map_zsmul, hc, sub_self]
          obtain ⟨w, hw⟩ := hker _ hz
          exact ⟨c, w, by rw [← hw]; abel⟩
      obtain ⟨y, hy⟩ := hstep
      have hiter : ∀ j : ℕ, ∀ x, ∃ (c : ℤ)
          (w : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N), x = c • y + (ℓ ^ j) • w := by
        intro j
        induction j with
        | zero => intro x; exact ⟨0, x, by simp⟩
        | succ j ih =>
          intro x
          obtain ⟨c, w, hw⟩ := ih x
          obtain ⟨c', w', hw'⟩ := hy w
          refine ⟨c + ((ℓ ^ j : ℕ) : ℤ) * c', w', ?_⟩
          rw [hw, hw', smul_add, add_smul, mul_smul ((ℓ ^ j : ℕ) : ℤ) c' y, natCast_zsmul,
            pow_succ ℓ j, mul_smul (ℓ ^ j) ℓ w', add_assoc]
      refine ⟨y, fun x => ?_⟩
      obtain ⟨c, w, hw⟩ := hiter (k + 1) x
      exact ⟨c, by rw [hw, htor, add_zero]⟩

  set P := Limits.cokernel (wcFreeSheafMap S
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) with hP
  obtain ⟨hcnt, hsN, hsM⟩ := s1 P N hfin1 hcard1 hge
  have hcyc := s2 P N hfin1 hcard1 (fun n => ⟨(hcnt n).1, (hcnt n).2⟩)
  obtain ⟨g, hg1, hg2, hg3⟩ := hltg
    (fun n => Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N)
    (fun n => (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
      continuous_of_discreteTopology)).postcomp P (add_zero N))
    hcnt hcyc (fun n t => hsN n t)
  obtain ⟨y₀, hy₀⟩ := wc_int_ext_procyclic_of_tower S ℓ P N g hg1 hg2 hg3 hsM
  haveI hXc : CompactSpace S := inferInstance
  haveI hXqs : QuasiSeparatedSpace S := IsLocallyNoetherian.quasiSeparatedSpace
  haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
  haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace
  have hmono := wc_free_sheaf_map_mono S _ _
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) (IsOpenImmersion.mono O.ι)
  have hrat := @proet_free_coker_ladic_rationalization S
    (Scheme.ProEt.mk (𝟙 S)) (Scheme.ProEt.mk O.ι)
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) hXc hXqs hOc hOqs ℓ _ hmono
  obtain ⟨hs1, hsmul, hsadd⟩ := wc_ladic_scalar_ring S ℓ
  have hi4 := (wc_int_scalar_ring S ℓ).2.2.2
  have hs0 : wcLadicScalar S ℓ 0 = 0 := by
    have h := hsadd 0 0
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hsnat : ∀ m : ℕ, wcLadicScalar S ℓ (m : ℚ_[ℓ]) = m • 𝟙 _ := by
    intro m
    induction m with
    | zero => rw [Nat.cast_zero, hs0, zero_nsmul]
    | succ k ih => rw [Nat.cast_succ, hsadd, ih, hs1, succ_nsmul]
  have hznat : ∀ (m : ℕ) (w : Abelian.Ext P (wcLadicSheaf S ℓ) N),
      w.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (m : ℚ_[ℓ]))) (add_zero _) = m • w := by
    intro m w
    rw [hsnat m]
    induction m with
    | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
    | succ k ih =>
      rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
        succ_nsmul]
  have e2 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (v : Abelian.Ext A B N) (p : B ⟶ C') (q : C' ⟶ D'),
      (v.comp (Abelian.Ext.mk₀ p) (add_zero _)).comp (Abelian.Ext.mk₀ q) (add_zero _) =
        v.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero _) := by
    intro A B C' D' v p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  refine ⟨y₀.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero _), fun z => ?_⟩
  obtain ⟨n, w, hw⟩ := hrat N z
  obtain ⟨a, ha⟩ := hy₀ w
  have hℓ0' : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  refine ⟨((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (a : ℚ_[ℓ]), ?_⟩
  have hya : (y₀.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero _)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (a : ℚ_[ℓ]))) (add_zero _) = ℓ ^ n • z := by
    rw [e2, ← hi4, ← e2, ← ha, hw]
  have hz : z = (z.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ])))
      (add_zero _)).comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)))
      (add_zero _) := by
    rw [e2, ← hsmul, Nat.cast_pow, inv_mul_cancel₀ hℓ0', hs1, Abelian.Ext.comp_mk₀_id]
  rw [hsmul, ← e2, hya, ← hznat]
  exact hz

theorem wc_quad_cone_vertex_point (K : Type u) [Field K] (n : ℕ) (c : Matrix (Fin n) (Fin n) K) :
    ∃ x₀ : Spec (.of (wcQuadModelRing K n 0 c)),
      {y : Spec (.of (wcQuadModelRing K n 0 c)) |
        ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal} = {x₀}ᶜ :=
by
  classical
  have hle : wcQuadModelIdeal K n 0 c ≤
      RingHom.ker (MvPolynomial.constantCoeff (R := K) (σ := Fin n)) := by
    unfold wcQuadModelIdeal
    rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    subst hx
    simp [RingHom.mem_ker, MvPolynomial.constantCoeff_X]
  have h1 : ∀ a ∈ wcQuadModelIdeal K n 0 c, MvPolynomial.constantCoeff a = 0 :=
    fun a ha => hle ha
  let ev : (MvPolynomial (Fin n) K ⧸ wcQuadModelIdeal K n 0 c) →+* K :=
    Ideal.Quotient.lift (wcQuadModelIdeal K n 0 c) MvPolynomial.constantCoeff h1
  have hev : ∀ f, ev (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) f) =
      MvPolynomial.constantCoeff f := fun f => Ideal.Quotient.lift_mk _ _ _
  have hsurj : Function.Surjective ev := by
    intro a
    refine ⟨Ideal.Quotient.mk _ (MvPolynomial.C a), ?_⟩
    rw [hev, MvPolynomial.constantCoeff_C]
  have hM : (RingHom.ker ev).IsMaximal := RingHom.ker_isMaximal_of_surjective ev hsurj
  let x₀ : PrimeSpectrum (MvPolynomial (Fin n) K ⧸ wcQuadModelIdeal K n 0 c) :=
    ⟨RingHom.ker ev, hM.isPrime⟩
  have hXmem : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈
      RingHom.ker ev := by
    intro p
    rw [RingHom.mem_ker, hev, MvPolynomial.constantCoeff_X]
  refine ⟨x₀, ?_⟩
  ext y
  simp only [Set.mem_setOf_eq, Set.mem_compl_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨p, hp⟩ rfl
    exact hp (hXmem p)
  · intro hy
    by_contra hcon
    push_neg at hcon
    apply hy
    have hMy : RingHom.ker ev ≤ y.asIdeal := by
      intro r hr
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
      have hcomp : (Ideal.Quotient.mk y.asIdeal).comp
            (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c)) =
          (((Ideal.Quotient.mk y.asIdeal).comp
            (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c))).comp MvPolynomial.C).comp
            MvPolynomial.constantCoeff := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [MvPolynomial.constantCoeff_C]
        · intro i
          simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (hcon i)
      have h2 := congrArg (fun φ => φ f) hcomp
      simp only [RingHom.comp_apply] at h2
      rw [RingHom.mem_ker, hev] at hr
      rw [hr, map_zero, map_zero, map_zero] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
    have := hM.eq_of_le y.isPrime.ne_top hMy
    exact PrimeSpectrum.ext this.symm

theorem wc_quad_cone_punct_coh_hyperbolic_transport (K : Type u) [Field K] [IsAlgClosed K]
    (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (c : Matrix (Fin n) (Fin n) K) (hc : IsUnit (c + c.transpose).det)
    (Oc : (Spec (.of (wcQuadModelRing K n 0 c))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing K n 0 c)))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal})
    (Oh : (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 (Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (m q : ℕ) :
    Nonempty (wcEtCoh (Oc : Scheme.{u}) m q ≃ wcEtCoh (Oh : Scheme.{u}) m q) :=
by
  classical

  have hNF : ∃ P : Matrix (Fin n) (Fin n) K, IsUnit P.det ∧
      (∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C ((P.transpose * c * P) p q) *
        MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) K) =
      ∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) p q) *
        MvPolynomial.X p * MvPolynomial.X q := by
    clear Oc hOc Oh hOh
    obtain ⟨d, rfl⟩ : ∃ d, n = d + 1 + 1 := ⟨n - 2, by omega⟩
    have hd : Even d := by
      obtain ⟨t, ht⟩ := hn
      exact ⟨t - 1, by omega⟩
    obtain ⟨P, hP, hN⟩ := wc_quadric_split_normal_form_alg_closed K d hd c hc.ne_zero
    refine ⟨P, hP, ?_⟩
    have h1 : (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
        MvPolynomial.C ((P.transpose * c * P) p q) * (MvPolynomial.X p * MvPolynomial.X q) :
          MvPolynomial (Fin (d + 1 + 1)) K) =
        ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
          MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) *
            (MvPolynomial.X p * MvPolynomial.X q) :=
      congrArg Subtype.val hN
    simp only [← mul_assoc] at h1
    exact h1

  have hIso : ∀ (h P : Matrix (Fin n) (Fin n) K), IsUnit P.det →
      (∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C ((P.transpose * c * P) p q) *
        MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) K) =
      ∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C (h p q) * MvPolynomial.X p * MvPolynomial.X q →
      ∀ (Oh : (Spec (.of (wcQuadModelRing K n 0 h))).Opens),
      (Oh : Set (Spec (.of (wcQuadModelRing K n 0 h)))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 h) (MvPolynomial.X p) ∉ y.asIdeal} →
      Nonempty ((Oh : Scheme.{u}) ≅ (Oc : Scheme.{u})) := by
    intro h P hP hQ Oh hOh
    let Xv : Fin n → MvPolynomial (Fin n) K := fun i => MvPolynomial.X i
    let lin : Matrix (Fin n) (Fin n) K → Fin n → MvPolynomial (Fin n) K :=
      fun M => Matrix.mulVec (M.map MvPolynomial.C) Xv
    have hlin : ∀ M i, lin M i = ∑ q, MvPolynomial.C (M i q) * MvPolynomial.X q := by
      intro M i
      simp [lin, Xv, Matrix.mulVec, dotProduct]
    let φ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K := MvPolynomial.aeval (lin P)
    let φ' : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K := MvPolynomial.aeval (lin P⁻¹)
    have hcomp : ∀ (M N : Matrix (Fin n) (Fin n) K), M * N = 1 → ∀ i,
        MvPolynomial.aeval (lin N) (lin M i) = Xv i := by
      intro M N hMN i
      have e1 : MvPolynomial.aeval (lin N) (lin M i) =
          Matrix.mulVec (M.map MvPolynomial.C) (lin N) i := by
        rw [hlin]
        simp [Matrix.mulVec, dotProduct, map_sum, map_mul]
      rw [e1]
      show Matrix.mulVec (M.map MvPolynomial.C) (Matrix.mulVec (N.map MvPolynomial.C) Xv) i = Xv i
      rw [Matrix.mulVec_mulVec, ← Matrix.map_mul, hMN, Matrix.map_one _ (map_zero _) (map_one _),
        Matrix.one_mulVec]
    have hb : φ.comp φ' = AlgHom.id K (MvPolynomial (Fin n) K) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, AlgHom.id_apply, φ, φ', MvPolynomial.aeval_X]
      exact hcomp P⁻¹ P (Matrix.nonsing_inv_mul P hP) i
    have hc' : φ'.comp φ = AlgHom.id K (MvPolynomial (Fin n) K) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, AlgHom.id_apply, φ, φ', MvPolynomial.aeval_X]
      exact hcomp P P⁻¹ (Matrix.mul_nonsing_inv P hP) i
    let Φ : MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K := AlgEquiv.ofAlgHom φ φ' hb hc'
    have hform : ∀ (M : Matrix (Fin n) (Fin n) K) (w : Fin n → MvPolynomial (Fin n) K),
        ∑ p, ∑ q, MvPolynomial.C (M p q) * w p * w q =
          dotProduct w (Matrix.mulVec (M.map MvPolynomial.C) w) := by
      intro M w
      simp only [dotProduct, Matrix.mulVec, Matrix.map_apply, Finset.mul_sum]
      exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by ring
    have hφQ : φ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        ∑ p, ∑ q, MvPolynomial.C (h p q) * MvPolynomial.X p * MvPolynomial.X q := by
      rw [← hQ]
      have e1 : φ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
          ∑ p, ∑ q, MvPolynomial.C (c p q) * lin P p * lin P q := by
        simp [φ, map_sum, map_mul]
      rw [e1, hform, hform (P.transpose * c * P) (fun i => MvPolynomial.X i)]
      show dotProduct (Matrix.mulVec (P.map MvPolynomial.C) Xv)
          (Matrix.mulVec (c.map MvPolynomial.C) (Matrix.mulVec (P.map MvPolynomial.C) Xv)) =
        dotProduct Xv (Matrix.mulVec ((P.transpose * c * P).map MvPolynomial.C) Xv)
      rw [dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, dotProduct_comm,
        Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.map_mul, Matrix.map_mul,
        Matrix.transpose_map, Matrix.mul_assoc]
    have hIJ : wcQuadModelIdeal K n 0 h =
        Ideal.map (Φ.toRingEquiv : MvPolynomial (Fin n) K →+* MvPolynomial (Fin n) K)
          (wcQuadModelIdeal K n 0 c) := by
      simp only [wcQuadModelIdeal, Ideal.map_span, Set.image_singleton]
      congr 1
      rw [Set.singleton_eq_singleton_iff]
      show _ = φ _
      rw [map_sub, hφQ]
      simp
    let ψ : wcQuadModelRing K n 0 c ≃+* wcQuadModelRing K n 0 h :=
      Ideal.quotientEquiv _ _ Φ.toRingEquiv hIJ
    have hψ : ∀ x : MvPolynomial (Fin n) K, ψ (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) x) =
        Ideal.Quotient.mk (wcQuadModelIdeal K n 0 h) (φ x) := fun x =>
      Ideal.quotientEquiv_mk _ _ _ _ x
    have KEY : ∀ y : PrimeSpectrum (wcQuadModelRing K n 0 h),
        (∀ p, ψ (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p)) ∈ y.asIdeal) ↔
        (∀ q, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 h) (MvPolynomial.X q) ∈ y.asIdeal) := by
      intro y
      constructor
      · intro H q
        have e : (MvPolynomial.X q : MvPolynomial (Fin n) K) = φ (φ' (MvPolynomial.X q)) := by
          rw [← AlgHom.comp_apply, hb, AlgHom.id_apply]
        rw [e]
        simp only [φ', MvPolynomial.aeval_X, hlin, map_sum, map_mul]
        refine Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ ?_
        rw [← hψ]
        exact H r
      · intro H p
        rw [hψ]
        simp only [φ, MvPolynomial.aeval_X, hlin, map_sum, map_mul]
        exact Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ (H r)
    let s : Spec (.of (wcQuadModelRing K n 0 h)) ⟶ Spec (.of (wcQuadModelRing K n 0 c)) :=
      Spec.map ψ.toCommRingCatIso.hom
    have hpt : ∀ (y : Spec (.of (wcQuadModelRing K n 0 h))) (x : wcQuadModelRing K n 0 c),
        x ∈ (s y).asIdeal ↔ ψ x ∈ y.asIdeal := by
      intro y x
      rfl
    have KEY' : ∀ y : Spec (.of (wcQuadModelRing K n 0 h)),
        s y ∈ (Oc : Set _) ↔ y ∈ (Oh : Set _) := by
      intro y
      rw [hOc, hOh]
      simp only [Set.mem_setOf_eq, hpt]
      rw [← not_iff_not]
      push_neg
      exact KEY y
    have hrange : Set.range (Oh.ι ≫ s) = Set.range Oc.ι := by
      rw [Scheme.Opens.range_ι]
      ext x
      constructor
      · rintro ⟨z, rfl⟩
        rw [Scheme.Hom.comp_apply, KEY']
        exact Scheme.Opens.range_ι Oh ▸ ⟨z, rfl⟩
      · intro hx
        obtain ⟨y, rfl⟩ := (Scheme.Hom.homeomorph s).surjective x
        rw [Scheme.Hom.homeomorph_apply, KEY'] at hx
        rw [← Scheme.Opens.range_ι Oh] at hx
        obtain ⟨z, rfl⟩ := hx
        exact ⟨z, by rw [Scheme.Hom.homeomorph_apply, Scheme.Hom.comp_apply]⟩
    exact ⟨IsOpenImmersion.isoOfRangeEq (Oh.ι ≫ s) Oc.ι hrange⟩

  obtain ⟨P, hP, hQ⟩ := hNF
  obtain ⟨E⟩ := hIso _ P hP hQ Oh hOh
  exact wc_et_coh_iso_invariance E.hom m q

theorem wc_hyp_cone_punct_mid_coh_mod_ell (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (n : ℕ) (hn : Even n) (h4 : 4 ≤ n)
    (Oh : (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 (Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal}) :
    Subsingleton (wcEtCoh (Oh : Scheme.{u}) ℓ (n - 3)) ∧ Finite (wcEtCoh (Oh : Scheme.{u}) ℓ (n - 2)) ∧
      Nat.card (wcEtCoh (Oh : Scheme.{u}) ℓ (n - 2)) = ℓ :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  obtain ⟨e, rfl⟩ : ∃ e, n = 2 * e + 1 + 1 := by
    obtain ⟨r, hr⟩ := hn
    exact ⟨r - 1, by omega⟩
  have he : 1 ≤ e := by omega
  rw [show 2 * e + 1 + 1 - 3 = 2 * e - 1 by omega, show 2 * e + 1 + 1 - 2 = 2 * e - 1 + 1 by omega]

  have hopen : ∀ {R : Type u} [CommRing R] {ι : Type} (f : ι → R),
      IsOpen ({y | ∃ i, f i ∉ y.asIdeal} : Set (Spec (.of R))) := by
    intro R _ ι f
    have hU : ({y | ∃ i, f i ∉ y.asIdeal} : Set (Spec (.of R))) =
        ⋃ i, (PrimeSpectrum.zeroLocus {f i})ᶜ := by
      ext y
      constructor
      · rintro ⟨i, hi⟩
        exact Set.mem_iUnion.mpr ⟨i, fun h => hi (h (Set.mem_singleton _))⟩
      · intro h
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp h
        exact ⟨i, fun h' => hi (Set.singleton_subset_iff.mpr h')⟩
    rw [hU]
    exact isOpen_iUnion fun i => (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl
  obtain ⟨Ou, hOu⟩ : ∃ Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens, (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉ y.asIdeal} :=
    ⟨⟨_, hopen (fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))))⟩, rfl⟩
  obtain ⟨W, hW0⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens, (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = {y | ∃ t : Fin (e + 1), (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) K) ∉ y.asIdeal} :=
    ⟨⟨_, hopen (fun t : Fin (e + 1) => (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) K))⟩, rfl⟩
  have hW : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ := by
    rw [hW0]
    ext y
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall]
    exact Iff.rfl
  have hmem : (⟨⊥, inferInstance⟩ : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K)) ∈
      (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) := by
    rw [hW0]
    exact ⟨0, fun h => MvPolynomial.X_ne_zero (R := K) (0 : Fin (e + 1)) (Ideal.mem_bot.mp h)⟩
  have hWne : Nonempty (W : Scheme.{u}) := ⟨⟨_, hmem⟩⟩
  haveI hWirr : IrreducibleSpace (W : Scheme.{u}) :=
    Subtype.irreducibleSpace ⟨⟨_, hmem⟩, (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
      W.isOpen (Set.subset_univ _)⟩

  obtain ⟨hsm, hcpt, hsep⟩ := wc_hyp_quad_cone_punct_smooth_qcsep K e Oh hOh
  obtain ⟨iZ, O', eO, πy, s, hci, hO', hstr, -⟩ :=
    wc_hyp_quad_cone_punct_strata K e Oh Ou hOh hOu W hW
  haveI := hsm
  haveI := hcpt
  haveI := hsep
  haveI := hci
  have hZsm : SmoothOfRelativeDimension (e + 1) (iZ ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
      (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := by
    rw [hstr]
    haveI := wc_mvpoly_spec_smoothOfRelDim K (e + 1)
    simpa using (inferInstance : SmoothOfRelativeDimension (0 + (e + 1))
      (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K)))))
  haveI := hZsm
  have hZsm' : SmoothOfRelativeDimension (2 * e + 1 - e) (iZ ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
      (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := by
    rw [show 2 * e + 1 - e = e + 1 by omega]
    exact hZsm

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iZ ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O'.ι ℓ

  have hS : ∀ θ : wcEtSuppExt D (2 * e - 1), θ = 0 := by
    haveI := hZsm'
    exact wc_et_supp_semipurity K (Oh : Scheme.{u}) (W : Scheme.{u})
      (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
        (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
      (2 * e + 1) e iZ (by omega) ℓ hℓ D (2 * e - 1) (by omega)

  have chain : ∀ q : ℕ, Nonempty (wcEtZModExt (O' : Scheme.{u}) ℓ q ≃ wcEtCoh (W : Scheme.{u}) ℓ q) := by
    intro q
    obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (O' : Scheme.{u}) ℓ q
    obtain ⟨E2⟩ := wc_et_coh_iso_invariance eO.hom ℓ q
    obtain ⟨E3⟩ := wc_hyp_quad_cone_even_open_coh_equiv K ℓ hℓ e Ou hOu W hW q
    exact ⟨E1.trans (E2.symm.trans E3)⟩
  have hO'sub : ∀ q : ℕ, 1 ≤ q → q + 2 ≤ 2 * (e + 1) →
      Subsingleton (wcEtZModExt (O' : Scheme.{u}) ℓ q) := by
    intro q h1 h2
    obtain ⟨E⟩ := chain q
    haveI := wc_rpss_punct_affine_low_vanishing K (e + 1) ℓ hℓ W hW q h1 h2
    exact E.subsingleton
  have hO1 := hO'sub (2 * e - 1) (by omega) (by omega)
  have hO2 := hO'sub (2 * e - 1 + 1) (by omega) (by omega)

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Oh : Scheme.{u}) ℓ)) := HasExt.standard _
  obtain ⟨C1, -, C3⟩ := wc_et_supp_open_les iZ O' hO' ℓ D Dj
  have hlowE : ∀ y : wcEtZModExt (Oh : Scheme.{u}) ℓ (2 * e - 1), y = 0 := by
    intro y
    haveI := hO1
    obtain ⟨x, hx⟩ := (C1 (2 * e - 1) y).mp (Subsingleton.elim _ _)
    rw [← hx, hS x, Abelian.Ext.comp_zero]
  let φ : wcEtSuppExt D (2 * e - 1 + 1) → wcEtZModExt (Oh : Scheme.{u}) ℓ (2 * e - 1 + 1) :=
    fun x => (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add _)
  have hφsurj : Function.Surjective φ := by
    intro y
    haveI := hO2
    obtain ⟨x, hx⟩ := (C1 (2 * e - 1 + 1) y).mp (Subsingleton.elim _ _)
    exact ⟨x, hx⟩
  have hφinj : Function.Injective φ := by
    intro x₁ x₂ h
    obtain ⟨δ, hδ, -⟩ := C3 (2 * e - 1) (2 * e - 1 + 1) (by omega)
    have h0 : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp (x₁ - x₂) (zero_add _) = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg]
      change φ x₁ + -φ x₂ = 0
      rw [h, add_neg_cancel]
    obtain ⟨b, hb⟩ := (hδ _).mp h0
    haveI := hO1
    rw [Subsingleton.elim b 0, map_zero] at hb
    exact sub_eq_zero.mp hb.symm

  obtain ⟨E6⟩ : Nonempty (wcEtZModExt (W : Scheme.{u}) ℓ 0 ≃ wcEtSuppExt D (2 * e - 1 + 1)) := by
    have h := wc_et_smooth_pair_purity_ext_equiv K (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0
        (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
      (2 * e + 1) (e + 1) e (by omega) iZ ℓ hℓ hWne D 0
    rwa [show 0 + 2 * e = 2 * e - 1 + 1 by omega] at h

  obtain ⟨EO1⟩ := wc_et_zmodext_coh_equiv (Oh : Scheme.{u}) ℓ (2 * e - 1)
  obtain ⟨EO2⟩ := wc_et_zmodext_coh_equiv (Oh : Scheme.{u}) ℓ (2 * e - 1 + 1)
  obtain ⟨EW⟩ := wc_et_zmodext_coh_equiv (W : Scheme.{u}) ℓ 0
  have E5 := Equiv.ofBijective φ ⟨hφinj, hφsurj⟩
  have hcard : Nat.card (wcEtCoh (Oh : Scheme.{u}) ℓ (2 * e - 1 + 1)) = ℓ := by
    rw [← Nat.card_congr EO2, ← Nat.card_congr E5, ← Nat.card_congr E6, Nat.card_congr EW]
    exact wc_et_coh_zero_connected_card _ ℓ hℓp.ne_zero
  refine ⟨?_, ?_, hcard⟩
  · haveI : Subsingleton (wcEtZModExt (Oh : Scheme.{u}) ℓ (2 * e - 1)) :=
      ⟨fun a b => (hlowE a).trans (hlowE b).symm⟩
    exact EO1.symm.subsingleton
  · exact Nat.finite_of_card_ne_zero (by rw [hcard]; exact hℓp.ne_zero)

theorem wc_zmod_ext_tower_mid_card (S : Scheme.{u})
    (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ)
    (hlow : ∀ x : Abelian.Ext Q (wcZModSheaf S ℓ) N, x = 0)
    (hmid1 : Finite (Abelian.Ext Q (wcZModSheaf S ℓ) (N + 1)))
    (hmid2 : Nat.card (Abelian.Ext Q (wcZModSheaf S ℓ) (N + 1)) = ℓ)
    (hhigh : ∀ j : ℕ, 1 ≤ j → Finite (Abelian.Ext Q (wcZModSheaf S (ℓ ^ j)) (N + 2)) ∧
      Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ j)) (N + 2)) = ℓ ^ j) :
    ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext Q (wcZModSheaf S (ℓ ^ k)) (N + 1)) ∧
      Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ k)) (N + 1)) = ℓ ^ k :=
by
  classical
  have hp : ℓ.Prime := Fact.out

  have low : ∀ k : ℕ, ∀ x : Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k + 1))) N, x = 0 := by
    intro k
    induction k with
    | zero => rw [zero_add, pow_one]; exact hlow
    | succ k ih =>
      intro x
      obtain ⟨f, g, f', p, hfg, hfp, hS1, -, -⟩ := wc_glc_zmod_ses S ℓ (k + 1)
      have h0 : x.comp (Abelian.Ext.mk₀ g) (add_zero N) = 0 := hlow _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ Q hS1 x h0
      rw [← hx₁, ih x₁, Abelian.Ext.zero_comp]
  intro k hk
  induction k, hk using Nat.le_induction with
  | base =>
    rw [pow_one]
    exact ⟨hmid1, hmid2⟩
  | succ k hk ih =>
    obtain ⟨hAfin, hAcard⟩ := ih
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    obtain ⟨f, g, f', p, hfg, hfp, -, hS2, -⟩ := wc_glc_zmod_ses S ℓ (k' + 1)
    let φ : ∀ d : ℕ, Abelian.Ext Q (wcZModSheaf S ℓ) d →+
        Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) d :=
      fun d => (Abelian.Ext.mk₀ f').postcomp Q (add_zero d)
    let ψ : ∀ d : ℕ, Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) d →+
        Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) d :=
      fun d => (Abelian.Ext.mk₀ p).postcomp Q (add_zero d)
    have hφ : ∀ (d : ℕ) (y : Abelian.Ext Q (wcZModSheaf S ℓ) d),
        φ d y = y.comp (Abelian.Ext.mk₀ f') (add_zero d) := fun _ _ => rfl
    have hψ : ∀ (d : ℕ) (y : Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) d),
        ψ d y = y.comp (Abelian.Ext.mk₀ p) (add_zero d) := fun _ _ => rfl

    have hzero : ∀ (d : ℕ) (y : Abelian.Ext Q (wcZModSheaf S ℓ) d), ψ d (φ d y) = 0 := by
      intro d y
      rw [hψ, hφ, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hfp,
        Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have hker : ∀ (d : ℕ) (z : Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) d),
        ψ d z = 0 → ∃ y : Abelian.Ext Q (wcZModSheaf S ℓ) d, φ d y = z := by
      intro d z hz
      exact Abelian.Ext.covariant_sequence_exact₂ Q hS2 z hz

    have hφinj2 : Function.Injective (φ (N + 2)) := by
      have hG := (hhigh 1 le_rfl).1
      have cG := (hhigh 1 le_rfl).2
      rw [pow_one] at hG cG
      have hH := (hhigh (k' + 1 + 1) (by omega)).1
      have cH := (hhigh (k' + 1 + 1) (by omega)).2
      have hK := (hhigh (k' + 1) (by omega)).1
      have cK := (hhigh (k' + 1) (by omega)).2
      have hle : (ψ (N + 2)).ker ≤ (φ (N + 2)).range := by
        intro z hz
        obtain ⟨y, hy⟩ := hker (N + 2) z ((AddMonoidHom.mem_ker).mp hz)
        exact ⟨y, hy⟩
      have c1 := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (ψ (N + 2)).ker
      have c2 : Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) (N + 2) ⧸
          (ψ (N + 2)).ker) = Nat.card (ψ (N + 2)).range :=
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (ψ (N + 2))).toEquiv
      have c3 : Nat.card (ψ (N + 2)).range ≤
          Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) (N + 2)) :=
        AddSubgroup.card_le_card_addGroup _
      have c4 : Nat.card (ψ (N + 2)).ker ≤ Nat.card (φ (N + 2)).range :=
        AddSubgroup.card_le_of_le hle
      have c5 := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (φ (N + 2)).ker
      have c6 : Nat.card (Abelian.Ext Q (wcZModSheaf S ℓ) (N + 2) ⧸ (φ (N + 2)).ker) =
          Nat.card (φ (N + 2)).range :=
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (φ (N + 2))).toEquiv
      have pK : 0 < Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) (N + 2)) :=
        Nat.card_pos
      have pR : 0 < Nat.card (φ (N + 2)).range := Nat.card_pos
      have hcard : Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) (N + 2)) =
          Nat.card (Abelian.Ext Q (wcZModSheaf S ℓ) (N + 2)) *
            Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) (N + 2)) := by
        rw [cH, cG, cK, pow_succ' ℓ (k' + 1)]
      have e1 : Nat.card (Abelian.Ext Q (wcZModSheaf S ℓ) (N + 2)) *
            Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) (N + 2)) ≤
          Nat.card (φ (N + 2)).range *
            Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) (N + 2)) := by
        rw [← hcard, c1, c2, mul_comm (Nat.card (φ (N + 2)).range)]
        exact Nat.mul_le_mul c3 c4
      have e2 := Nat.le_of_mul_le_mul_right e1 pK
      rw [c5, c6] at e2
      have e3 : Nat.card (φ (N + 2)).range * Nat.card (φ (N + 2)).ker ≤
          Nat.card (φ (N + 2)).range * 1 := by rw [mul_one]; exact e2
      have e4 := Nat.le_of_mul_le_mul_left e3 pR
      exact (AddMonoidHom.ker_eq_bot_iff _).mp (AddSubgroup.eq_bot_of_card_le _ e4)

    have hφinj : Function.Injective (φ (N + 1)) := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ Q hS2 y hy (n₀ := N) rfl
      rw [← hx₃, low k' x₃, Abelian.Ext.zero_comp]

    have hψsurj : Function.Surjective (ψ (N + 1)) := by
      intro x
      have hE : hS2.extClass.comp (Abelian.Ext.mk₀ f') (add_zero 1) = 0 := hS2.extClass_comp
      have hδ : x.comp hS2.extClass (rfl : N + 1 + 1 = N + 2) = 0 := by
        apply hφinj2
        rw [map_zero, hφ, Abelian.Ext.comp_assoc_of_third_deg_zero, hE, Abelian.Ext.comp_zero]
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ Q hS2 x rfl hδ
      exact ⟨x₂, hx₂⟩

    have hkr : (ψ (N + 1)).ker = (φ (N + 1)).range := by
      ext z
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
      constructor
      · exact hker (N + 1) z
      · rintro ⟨y, rfl⟩
        exact hzero (N + 1) y
    have d1 := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (ψ (N + 1)).ker
    have d2 : Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) (N + 1) ⧸
        (ψ (N + 1)).ker) = Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1))) (N + 1)) :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective (ψ (N + 1)) hψsurj).toEquiv
    have d3 : Nat.card (φ (N + 1)).range = Nat.card (Abelian.Ext Q (wcZModSheaf S ℓ) (N + 1)) :=
      (Nat.card_congr (AddMonoidHom.ofInjective hφinj).toEquiv).symm
    have hc : Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k' + 1 + 1))) (N + 1)) =
        ℓ ^ (k' + 1) * ℓ := by
      rw [d1, d2, hkr, d3, hAcard, hmid2]
    refine ⟨Nat.finite_of_card_ne_zero ?_, ?_⟩
    · rw [hc]
      exact Nat.mul_ne_zero (pow_ne_zero _ hp.ne_zero) hp.ne_zero
    · rw [hc, ← pow_succ]

theorem wc_quad_cone_dim_two_pieces (K : Type u) [Field K] [IsAlgClosed K]
    (c : Matrix (Fin 2) (Fin 2) K) (hc : IsUnit (c + c.transpose).det)
    (Oc : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∉ y.asIdeal}) :
    PreconnectedSpace (Spec (.of (wcQuadModelRing K 2 0 c))) ∧
    ∃ A B : Set (Spec (.of (wcQuadModelRing K 2 0 c))), IsOpen A ∧ IsOpen B ∧ Disjoint A B ∧
      A ∪ B = (Oc : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) ∧ A.Nonempty ∧ B.Nonempty ∧
      _root_.IsPreconnected A ∧ _root_.IsPreconnected B :=
by
  classical

  have hdet : (c + c.transpose).det ≠ 0 := hc.ne_zero
  have hdet' : (c 0 0 + c 0 0) * (c 1 1 + c 1 1) - (c 0 1 + c 1 0) * (c 1 0 + c 0 1) ≠ 0 := by
    rw [Matrix.det_fin_two] at hdet
    simp only [Matrix.add_apply, Matrix.transpose_apply] at hdet
    exact hdet
  have key : ∀ u0 u1 v0 v1 : K, c 0 0 = u0 * v0 → c 0 1 + c 1 0 = u0 * v1 + u1 * v0 →
      c 1 1 = u1 * v1 → u0 * v1 - u1 * v0 ≠ 0 := by
    intro u0 u1 v0 v1 e1 e2 e3 hD0
    apply hdet'
    linear_combination (4 * c 1 1) * e1 + (4 * u0 * v0) * e3 -
      (c 0 1 + c 1 0 + (u0 * v1 + u1 * v0)) * e2 - (u0 * v1 - u1 * v0) * hD0
  obtain ⟨u0, u1, v0, v1, hD, h00, h01, h11⟩ : ∃ u0 u1 v0 v1 : K, u0 * v1 - u1 * v0 ≠ 0 ∧
      c 0 0 = u0 * v0 ∧ c 0 1 + c 1 0 = u0 * v1 + u1 * v0 ∧ c 1 1 = u1 * v1 := by
    by_cases ha : c 0 0 = 0
    · have e1 : c 0 0 = 0 * (c 0 1 + c 1 0) := by rw [ha]; ring
      have e2 : c 0 1 + c 1 0 = 0 * c 1 1 + 1 * (c 0 1 + c 1 0) := by ring
      have e3 : c 1 1 = 1 * c 1 1 := by ring
      exact ⟨_, _, _, _, key _ _ _ _ e1 e2 e3, e1, e2, e3⟩
    · obtain ⟨t, ht⟩ := IsAlgClosed.exists_root (Polynomial.C (c 0 0) * Polynomial.X ^ 2 +
        Polynomial.C (c 0 1 + c 1 0) * Polynomial.X + Polynomial.C (c 1 1))
        (by rw [Polynomial.degree_quadratic ha]; first | exact two_ne_zero | decide | simp)
      have ht' : c 0 0 * t ^ 2 + (c 0 1 + c 1 0) * t + c 1 1 = 0 := by
        have := ht.eq_zero
        simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X] at this
        exact this
      have hb : c 0 0 * ((c 0 1 + c 1 0) / c 0 0) = c 0 1 + c 1 0 := mul_div_cancel₀ _ ha
      have e1 : c 0 0 = c 0 0 * 1 := by ring
      have e2 : c 0 1 + c 1 0 =
          c 0 0 * ((c 0 1 + c 1 0) / c 0 0 + t) + (-(c 0 0 * t)) * 1 := by
        linear_combination -hb
      have e3 : c 1 1 = (-(c 0 0 * t)) * ((c 0 1 + c 1 0) / c 0 0 + t) := by
        linear_combination t * hb + ht'
      exact ⟨_, _, _, _, key _ _ _ _ e1 e2 e3, e1, e2, e3⟩
  obtain ⟨U, hU⟩ : ∃ U : MvPolynomial (Fin 2) K,
      U = MvPolynomial.C u0 * MvPolynomial.X 0 + MvPolynomial.C u1 * MvPolynomial.X 1 :=
    ⟨_, rfl⟩
  obtain ⟨V, hV⟩ : ∃ V : MvPolynomial (Fin 2) K,
      V = MvPolynomial.C v0 * MvPolynomial.X 0 + MvPolynomial.C v1 * MvPolynomial.X 1 :=
    ⟨_, rfl⟩
  have hQ : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C 0 : MvPolynomial (Fin 2) K) = U * V := by
    have e01 : c 0 1 = u0 * v1 + u1 * v0 - c 1 0 := by rw [← h01]; ring
    simp only [Fin.sum_univ_two, map_zero, sub_zero]
    rw [h00, h11, e01, hU, hV]
    simp only [map_mul, map_add, map_sub]
    ring

  have genpt : ∀ (a0 a1 b0 b1 : K) (A B : MvPolynomial (Fin 2) K), a0 * b1 - a1 * b0 ≠ 0 →
      A = MvPolynomial.C a0 * MvPolynomial.X 0 + MvPolynomial.C a1 * MvPolynomial.X 1 →
      B = MvPolynomial.C b0 * MvPolynomial.X 0 + MvPolynomial.C b1 * MvPolynomial.X 1 →
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 0 : MvPolynomial (Fin 2) K) = A * B →
      ∃ P : Spec (.of (wcQuadModelRing K 2 0 c)),
        Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) B ∈ P.asIdeal ∧
        Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) A ∉ P.asIdeal ∧
        ∀ y : Spec (.of (wcQuadModelRing K 2 0 c)),
          Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) B ∈ y.asIdeal →
            P.asIdeal ≤ y.asIdeal := by
    intro a0 a1 b0 b1 A B hD hA hB hAB
    let φ0 : MvPolynomial (Fin 2) K →+* Polynomial K :=
      MvPolynomial.eval₂Hom Polynomial.C
        ![Polynomial.C b1 * Polynomial.X, Polynomial.C (-b0) * Polynomial.X]
    have hφX0 : φ0 (MvPolynomial.X 0) = Polynomial.C b1 * Polynomial.X := by
      simp [φ0]
    have hφX1 : φ0 (MvPolynomial.X 1) = Polynomial.C (-b0) * Polynomial.X := by
      simp [φ0]
    have hφC : ∀ r : K, φ0 (MvPolynomial.C r) = Polynomial.C r := by
      intro r
      simp [φ0]
    have hφA : φ0 A = Polynomial.C (a0 * b1 - a1 * b0) * Polynomial.X := by
      rw [hA, map_add, map_mul, map_mul, hφX0, hφX1, hφC, hφC]
      simp only [Polynomial.C_sub, Polynomial.C_mul, Polynomial.C_neg]
      ring
    have hφB : φ0 B = 0 := by
      rw [hB, map_add, map_mul, map_mul, hφX0, hφX1, hφC, hφC]
      simp only [Polynomial.C_neg]
      ring
    have hker : ∀ a ∈ wcQuadModelIdeal K 2 0 c, φ0 a = 0 := by
      intro a ha
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hAB, map_mul, hφB, mul_zero, mul_zero]
    let φ : wcQuadModelRing K 2 0 c →+* Polynomial K := Ideal.Quotient.lift _ φ0 hker
    have hφ : ∀ g, φ (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) g) = φ0 g :=
      fun g => Ideal.Quotient.lift_mk _ _ _
    refine ⟨⟨RingHom.ker φ, RingHom.ker_isPrime φ⟩, ?_, ?_, ?_⟩
    · show _ ∈ RingHom.ker φ
      rw [RingHom.mem_ker, hφ, hφB]
    · show _ ∉ RingHom.ker φ
      rw [RingHom.mem_ker, hφ, hφA]
      exact mul_ne_zero (Polynomial.C_ne_zero.mpr hD) Polynomial.X_ne_zero
    · intro y hy r hr
      change r ∈ RingHom.ker φ at hr
      obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [RingHom.mem_ker, hφ] at hr
      have hE : (MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) *
          (MvPolynomial.C a0 * MvPolynomial.C b1 - MvPolynomial.C a1 * MvPolynomial.C b0) :
            MvPolynomial (Fin 2) K) = 1 := by
        have : (MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹ * (a0 * b1 - a1 * b0)) :
            MvPolynomial (Fin 2) K) = 1 := by
          rw [inv_mul_cancel₀ hD, map_one]
        simpa only [map_mul, map_sub] using this
      have id0 : (MvPolynomial.X 0 - MvPolynomial.C b1 *
          (MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) * A) : MvPolynomial (Fin 2) K) =
          MvPolynomial.C (-a1) * MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) * B := by
        rw [hA, hB, map_neg]
        linear_combination (-(MvPolynomial.X 0 : MvPolynomial (Fin 2) K)) * hE
      have id1 : (MvPolynomial.X 1 - MvPolynomial.C (-b0) *
          (MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) * A) : MvPolynomial (Fin 2) K) =
          MvPolynomial.C a0 * MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) * B := by
        rw [hA, hB, map_neg]
        linear_combination (-(MvPolynomial.X 1 : MvPolynomial (Fin 2) K)) * hE
      let ε : Polynomial K →+* wcQuadModelRing K 2 0 c :=
        Polynomial.eval₂RingHom
          ((Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c)).comp MvPolynomial.C)
          (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c)
            (MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) * A))
      have hεC : ∀ r : K, ε (Polynomial.C r) =
          Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.C r) := by
        intro r
        simp [ε]
      have hεX : ε Polynomial.X = Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c)
            (MvPolynomial.C ((a0 * b1 - a1 * b0)⁻¹) * A) := by
        simp [ε]
      have hmemB : ∀ s : MvPolynomial (Fin 2) K,
          Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (s * B) ∈ y.asIdeal := by
        intro s
        rw [map_mul]
        exact y.asIdeal.mul_mem_left _ hy
      have hcomp : (Ideal.Quotient.mk y.asIdeal).comp
            (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c)) =
          ((Ideal.Quotient.mk y.asIdeal).comp ε).comp φ0 := by
        apply MvPolynomial.ringHom_ext
        · intro s
          simp only [RingHom.comp_apply, hφC, hεC]
        · intro i
          simp only [RingHom.comp_apply]
          rw [Ideal.Quotient.eq]
          fin_cases i
          · simp only [Fin.zero_eta, Fin.isValue]
            rw [hφX0, map_mul, hεC, hεX, ← map_mul, ← map_sub, id0]
            exact hmemB _
          · simp only [Fin.mk_one, Fin.isValue]
            rw [hφX1, map_mul, hεC, hεX, ← map_mul, ← map_sub, id1]
            exact hmemB _
      have h2 := congrArg (fun ψ => ψ (g : MvPolynomial (Fin 2) K)) hcomp
      simp only [RingHom.comp_apply] at h2
      rw [hr, map_zero, map_zero] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
  obtain ⟨pb, hpb1, hpb2, hpb3⟩ := genpt u0 u1 v0 v1 U V hD hU hV hQ
  obtain ⟨pa, hpa1, hpa2, hpa3⟩ := genpt v0 v1 u0 u1 V U
    (by intro h; apply hD; linear_combination -h) hV hU (hQ.trans (mul_comm U V))

  have huv : Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) U *
      Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) V = 0 := by
    rw [← map_mul, ← hQ, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_singleton _)
  have KF : ∀ y : Spec (.of (wcQuadModelRing K 2 0 c)),
      Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) U ∈ y.asIdeal ∨
        Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) V ∈ y.asIdeal := by
    intro y
    apply y.isPrime.mem_or_mem
    have h0 := y.asIdeal.zero_mem
    rwa [← huv] at h0

  have hle : ∀ a ∈ wcQuadModelIdeal K 2 0 c, MvPolynomial.constantCoeff a = 0 := by
    intro a ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp [MvPolynomial.constantCoeff_X]
  let ev : wcQuadModelRing K 2 0 c →+* K := Ideal.Quotient.lift _ MvPolynomial.constantCoeff hle
  let x₀ : Spec (.of (wcQuadModelRing K 2 0 c)) := ⟨RingHom.ker ev, RingHom.ker_isPrime ev⟩
  have hx0U : Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) U ∈ x₀.asIdeal := by
    show _ ∈ RingHom.ker ev
    rw [RingHom.mem_ker]
    simp [ev, hU]
  have hx0V : Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) V ∈ x₀.asIdeal := by
    show _ ∈ RingHom.ker ev
    rw [RingHom.mem_ker]
    simp [ev, hV]

  have hE : (MvPolynomial.C ((u0 * v1 - u1 * v0)⁻¹) *
      (MvPolynomial.C u0 * MvPolynomial.C v1 - MvPolynomial.C u1 * MvPolynomial.C v0) :
        MvPolynomial (Fin 2) K) = 1 := by
    have : (MvPolynomial.C ((u0 * v1 - u1 * v0)⁻¹ * (u0 * v1 - u1 * v0)) :
        MvPolynomial (Fin 2) K) = 1 := by
      rw [inv_mul_cancel₀ hD, map_one]
    simpa only [map_mul, map_sub] using this
  have idX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) =
      MvPolynomial.C ((u0 * v1 - u1 * v0)⁻¹) *
        (MvPolynomial.C v1 * U - MvPolynomial.C u1 * V) := by
    rw [hU, hV]
    linear_combination (-(MvPolynomial.X 0 : MvPolynomial (Fin 2) K)) * hE
  have idX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) K) =
      MvPolynomial.C ((u0 * v1 - u1 * v0)⁻¹) *
        (MvPolynomial.C u0 * V - MvPolynomial.C v0 * U) := by
    rw [hU, hV]
    linear_combination (-(MvPolynomial.X 1 : MvPolynomial (Fin 2) K)) * hE
  have punct : ∀ y : Spec (.of (wcQuadModelRing K 2 0 c)),
      (∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∉ y.asIdeal) ↔
        (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) U ∉ y.asIdeal ∨
          Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) V ∉ y.asIdeal) := by
    intro y
    rw [← not_iff_not]
    simp only [not_exists, not_or, not_not, Fin.forall_fin_two]
    constructor
    · rintro ⟨h0, h1⟩
      constructor
      · rw [hU]
        simp only [map_add, map_mul]
        exact y.asIdeal.add_mem (y.asIdeal.mul_mem_left _ h0) (y.asIdeal.mul_mem_left _ h1)
      · rw [hV]
        simp only [map_add, map_mul]
        exact y.asIdeal.add_mem (y.asIdeal.mul_mem_left _ h0) (y.asIdeal.mul_mem_left _ h1)
    · rintro ⟨hu, hv⟩
      constructor
      · rw [idX0]
        simp only [map_mul, map_sub]
        exact y.asIdeal.mul_mem_left _
          (y.asIdeal.sub_mem (y.asIdeal.mul_mem_left _ hu) (y.asIdeal.mul_mem_left _ hv))
      · rw [idX1]
        simp only [map_mul, map_sub]
        exact y.asIdeal.mul_mem_left _
          (y.asIdeal.sub_mem (y.asIdeal.mul_mem_left _ hv) (y.asIdeal.mul_mem_left _ hu))

  have clos : ∀ P y : Spec (.of (wcQuadModelRing K 2 0 c)), P.asIdeal ≤ y.asIdeal →
      y ∈ closure ({P} : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) :=
    fun P y h => (PrimeSpectrum.le_iff_mem_closure P y).mp h
  refine ⟨⟨?_⟩, {y | Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) U ∉ y.asIdeal},
    {y | Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) V ∉ y.asIdeal},
    ?_, ?_, ?_, ?_, ⟨pb, hpb2⟩, ⟨pa, hpa2⟩, ?_, ?_⟩
  · have hS : closure ({pa} : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) ∪
        closure ({pb} : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro y
      rcases KF y with h | h
      · exact Or.inl (clos pa y (hpa3 y h))
      · exact Or.inr (clos pb y (hpb3 y h))
    rw [← hS]
    exact IsPreconnected.union x₀ (clos pa x₀ (hpa3 x₀ hx0U)) (clos pb x₀ (hpb3 x₀ hx0V))
      isPreconnected_singleton.closure isPreconnected_singleton.closure
  · exact PrimeSpectrum.isOpen_basicOpen
  · exact PrimeSpectrum.isOpen_basicOpen
  · rw [Set.disjoint_left]
    intro y h1 h2
    rcases KF y with h | h
    · exact h1 h
    · exact h2 h
  · rw [hOc]
    ext y
    simp only [Set.mem_union, Set.mem_setOf_eq]
    exact (punct y).symm
  · refine IsPreconnected.subset_closure isPreconnected_singleton
      (Set.singleton_subset_iff.mpr hpb2) ?_
    intro y hy
    rcases KF y with h | h
    · exact absurd h hy
    · exact clos pb y (hpb3 y h)
  · refine IsPreconnected.subset_closure isPreconnected_singleton
      (Set.singleton_subset_iff.mpr hpa2) ?_
    intro y hy
    rcases KF y with h | h
    · exact clos pa y (hpa3 y h)
    · exact absurd h hy

theorem wc_free_coker_ext_one_card_of_two_pieces (S : Scheme.{u}) [PreconnectedSpace S]
    (O : S.Opens) (A B : Set S) (hA : IsOpen A) (hB : IsOpen B) (hAB : Disjoint A B)
    (hU : A ∪ B = (O : Set S)) (hAn : A.Nonempty) (hBn : B.Nonempty)
    (hAc : _root_.IsPreconnected A) (hBc : _root_.IsPreconnected B) (m : ℕ) (hm : m ≠ 0)
    (hvan : ∀ x : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcZModSheaf S m) 1, x = 0) :
    Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S m) 1) ∧
    Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S m) 1) = m :=
by
  classical
  set ι : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial with hιdef

  have hmono : Mono (wcFreeSheafMap S ι) := by
    haveI : Mono ι.left := IsOpenImmersion.mono O.ι
    haveI : Mono ι := ⟨fun g h e => MorphismProperty.Over.Hom.ext ((cancel_mono ι.left).mp
      (by
        have e' := congrArg (fun t => t.left) e
        first
          | exact e'
          | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e'))⟩
    unfold wcFreeSheafMap
    exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (Functor.whiskerRight (yoneda.map ι) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hS : (ShortComplex.mk (wcFreeSheafMap S ι)
      (Limits.cokernel.π (wcFreeSheafMap S ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  let δ : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk O.ι)) (wcZModSheaf S m) 0 →+
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcZModSheaf S m) 1 :=
    hS.extClass.precomp (wcZModSheaf S m) (add_zero 1)
  let r : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcZModSheaf S m) 0 →+
      Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk O.ι)) (wcZModSheaf S m) 0 :=
    (Abelian.Ext.mk₀ (wcFreeSheafMap S ι)).precomp (wcZModSheaf S m) (zero_add 0)
  have hδs : Function.Surjective δ := by
    intro x₃
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS (wcZModSheaf S m) x₃
      (hvan _) (add_zero 1)
    exact ⟨x₁, hx₁⟩
  have hker : δ.ker = r.range := by
    ext x
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hx
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS (wcZModSheaf S m) x
        (add_zero 1) hx
      exact ⟨x₂, hx₂⟩
    · rintro ⟨y, rfl⟩
      show hS.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S ι)).comp y (zero_add 0))
        (add_zero 1) = 0
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 0) (by omega),
        show hS.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S ι)) (add_zero 1) = 0 from
          hS.extClass_comp, Abelian.Ext.zero_comp]

  have hYon : ∀ (S : Scheme.{u}), ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    intro S
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]
  obtain ⟨η, hY1, hY2⟩ := hYon S
  let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
  let V : S.ProEt := Scheme.ProEt.mk O.ι
  let G := wcZModSheaf S m
  let rs : G.obj.obj (Opposite.op T) → G.obj.obj (Opposite.op V) :=
    fun t => (G.obj.map ι.op).hom t

  have hpre : PreconnectedSpace S := inferInstance
  have hcov : ∀ z : O.toScheme, O.ι z ∈ A ∨ O.ι z ∈ B := by
    intro z
    have h : O.ι z ∈ Set.range O.ι := ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι, ← hU] at h
    exact h
  obtain ⟨a, ha⟩ := hAn
  obtain ⟨b, hb⟩ := hBn
  obtain ⟨a', ha'⟩ : a ∈ Set.range O.ι := by
    rw [Scheme.Opens.range_ι, ← hU]; exact Or.inl ha
  obtain ⟨b', hb'⟩ : b ∈ Set.range O.ι := by
    rw [Scheme.Opens.range_ι, ← hU]; exact Or.inr hb
  have ha'A : O.ι a' ∈ A := by rw [ha']; exact ha
  have hb'B : O.ι b' ∈ B := by rw [hb']; exact hb
  have hA'c : _root_.IsPreconnected (O.ι ⁻¹' A) :=
    hAc.preimage_of_isOpenMap O.ι.isOpenEmbedding.injective O.ι.isOpenEmbedding.isOpenMap
      (by rw [Scheme.Opens.range_ι, ← hU]; exact Set.subset_union_left)
  have hB'c : _root_.IsPreconnected (O.ι ⁻¹' B) :=
    hBc.preimage_of_isOpenMap O.ι.isOpenEmbedding.injective O.ι.isOpenEmbedding.isOpenMap
      (by rw [Scheme.Opens.range_ι, ← hU]; exact Set.subset_union_right)
  have hA'o : IsOpen (O.ι ⁻¹' A) := hA.preimage O.ι.isOpenEmbedding.continuous
  have hB'o : IsOpen (O.ι ⁻¹' B) := hB.preimage O.ι.isOpenEmbedding.continuous
  have hcompl : (O.ι ⁻¹' A)ᶜ = O.ι ⁻¹' B := by
    ext z
    show ¬ (O.ι z ∈ A) ↔ O.ι z ∈ B
    constructor
    · intro h; exact (hcov z).resolve_left h
    · intro h hA'; exact Set.disjoint_left.mp hAB hA' h
  have hA'cl : IsClosed (O.ι ⁻¹' A) := by
    rw [← isOpen_compl_iff, hcompl]; exact hB'o
  have hfr : frontier (O.ι ⁻¹' A) = ∅ := IsClopen.frontier_eq ⟨hA'cl, hA'o⟩
  have hsep : ∀ f g : C(O.toScheme, ZMod m), f a' = g a' → f b' = g b' → f = g := by
    intro f g h1 h2
    ext z
    rcases hcov z with hz | hz
    · exact (hA'c.constant f.continuous.continuousOn hz ha'A).trans
        (h1.trans (hA'c.constant g.continuous.continuousOn ha'A hz))
    · exact (hB'c.constant f.continuous.continuousOn hz hb'B).trans
        (h2.trans (hB'c.constant g.continuous.continuousOn hb'B hz))

  have hrsinj : Function.Injective rs := by
    intro t t' h
    let f1 : C(S, ZMod m) := ULift.down t
    let f2 : C(S, ZMod m) := ULift.down t'
    have h1 : ∀ z : O.toScheme, f1 (O.ι z) = f2 (O.ι z) := fun z => by
      have := congrArg (fun w : G.obj.obj (Opposite.op V) =>
        (ULift.down w : C(O.toScheme, ZMod m)) z) h
      exact this
    apply ULift.ext
    apply ContinuousMap.ext
    intro x
    change f1 x = f2 x
    exact (PreconnectedSpace.constant hpre f1.continuous).trans
      ((h1 a').trans (PreconnectedSpace.constant hpre f2.continuous))

  have hint : ∀ φ : wcFreeSheaf S T ⟶ G,
      ((wcFreeSheafMap S ι ≫ φ).hom.app (Opposite.op V)).hom (η V) =
        rs ((φ.hom.app (Opposite.op T)).hom (η T)) := by
    intro φ
    change (φ.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap S ι).hom.app (Opposite.op V)).hom (η V)) = _
    rw [hY2 T V ι]
    exact NatTrans.naturality_apply φ.hom ι.op (η T)
  have hrinj : Function.Injective r := by
    intro x y hxy
    obtain ⟨φ1, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    obtain ⟨φ2, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hxy' : Abelian.Ext.mk₀ (wcFreeSheafMap S ι ≫ φ1) =
        Abelian.Ext.mk₀ (wcFreeSheafMap S ι ≫ φ2) := by
      rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
      exact hxy
    have h2 := (Abelian.Ext.mk₀_bijective _ _).1 hxy'
    have h3 : rs ((φ1.hom.app (Opposite.op T)).hom (η T)) =
        rs ((φ2.hom.app (Opposite.op T)).hom (η T)) :=
      (hint φ1).symm.trans
        ((congrArg (fun ψ : wcFreeSheaf S V ⟶ G => (ψ.hom.app (Opposite.op V)).hom (η V)) h2).trans
          (hint φ2))
    have h4 := hrsinj h3
    have h5 : φ1 = φ2 := (hY1 T G ((φ2.hom.app (Opposite.op T)).hom (η T))).unique h4 rfl
    rw [h5]

  have hcardT : Nat.card (wcFreeSheaf S T ⟶ G) = m := by
    have hbij : Function.Bijective (fun φ : wcFreeSheaf S T ⟶ G =>
        (ULift.down ((φ.hom.app (Opposite.op T)).hom (η T)) : C(S, ZMod m)) a) := by
      constructor
      · intro φ1 φ2 h
        have h' : (φ1.hom.app (Opposite.op T)).hom (η T) =
            (φ2.hom.app (Opposite.op T)).hom (η T) := by
          let f1 : C(S, ZMod m) := ULift.down ((φ1.hom.app (Opposite.op T)).hom (η T))
          let f2 : C(S, ZMod m) := ULift.down ((φ2.hom.app (Opposite.op T)).hom (η T))
          have h0 : f1 a = f2 a := h
          apply ULift.ext
          apply ContinuousMap.ext
          intro x
          change f1 x = f2 x
          exact (PreconnectedSpace.constant hpre f1.continuous).trans
            (h0.trans (PreconnectedSpace.constant hpre f2.continuous))
        exact (hY1 T G ((φ2.hom.app (Opposite.op T)).hom (η T))).unique h' rfl
      · intro z
        obtain ⟨φ, hφ, -⟩ := hY1 T G (ULift.up (ContinuousMap.const S z))
        refine ⟨φ, ?_⟩
        show (ULift.down ((φ.hom.app (Opposite.op T)).hom (η T)) : C(S, ZMod m)) a = z
        rw [hφ]
        rfl
    rw [Nat.card_congr (Equiv.ofBijective _ hbij), Nat.card_zmod]
  have hcardV : Nat.card (wcFreeSheaf S V ⟶ G) = m * m := by
    have hbij : Function.Bijective (fun φ : wcFreeSheaf S V ⟶ G =>
        ((ULift.down ((φ.hom.app (Opposite.op V)).hom (η V)) : C(O.toScheme, ZMod m)) a',
          (ULift.down ((φ.hom.app (Opposite.op V)).hom (η V)) : C(O.toScheme, ZMod m)) b')) := by
      constructor
      · intro φ1 φ2 h
        have hp := Prod.ext_iff.mp h
        have h' : (φ1.hom.app (Opposite.op V)).hom (η V) =
            (φ2.hom.app (Opposite.op V)).hom (η V) := by
          apply ULift.ext
          exact hsep _ _ hp.1 hp.2
        exact (hY1 V G ((φ2.hom.app (Opposite.op V)).hom (η V))).unique h' rfl
      · rintro ⟨u, v⟩
        let hfun : C(O.toScheme, ZMod m) := ⟨fun z => if O.ι z ∈ A then u else v, by
          apply continuous_if
          · intro z hz
            have hz' : z ∈ frontier (O.ι ⁻¹' A) := hz
            rw [hfr] at hz'
            exact absurd hz' (Set.notMem_empty z)
          · exact continuousOn_const
          · exact continuousOn_const⟩
        obtain ⟨φ, hφ, -⟩ := hY1 V G (ULift.up hfun)
        refine ⟨φ, ?_⟩
        show ((ULift.down ((φ.hom.app (Opposite.op V)).hom (η V)) : C(O.toScheme, ZMod m)) a',
          (ULift.down ((φ.hom.app (Opposite.op V)).hom (η V)) : C(O.toScheme, ZMod m)) b') = (u, v)
        rw [hφ]
        show (hfun a', hfun b') = (u, v)
        have e1 : hfun a' = u := by
          show (if O.ι a' ∈ A then u else v) = u
          rw [if_pos ha'A]
        have e2 : hfun b' = v := by
          show (if O.ι b' ∈ A then u else v) = v
          rw [if_neg (fun h => Set.disjoint_left.mp hAB h hb'B)]
        rw [e1, e2]
    rw [Nat.card_congr (Equiv.ofBijective _ hbij), Nat.card_prod, Nat.card_zmod]
  have hcardExtT : Nat.card (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
      (wcZModSheaf S m) 0) = m :=
    (Nat.card_congr (Equiv.ofBijective _ (Abelian.Ext.mk₀_bijective (wcFreeSheaf S T) G))).symm.trans
      hcardT
  have hcardExtV : Nat.card (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk O.ι))
      (wcZModSheaf S m) 0) = m * m :=
    (Nat.card_congr (Equiv.ofBijective _ (Abelian.Ext.mk₀_bijective (wcFreeSheaf S V) G))).symm.trans
      hcardV

  have hcard : Nat.card (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk O.ι)) (wcZModSheaf S m) 0) =
      Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcZModSheaf S m) 1) *
        Nat.card (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcZModSheaf S m) 0) := by
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup δ.ker,
      Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective δ hδs).toEquiv, hker,
      Nat.card_congr (AddMonoidHom.ofInjective hrinj).toEquiv.symm]
  have hfin1 : Finite (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk O.ι)) (wcZModSheaf S m) 0) := by
    apply Nat.finite_of_card_ne_zero
    rw [hcardExtV]
    exact mul_ne_zero hm hm
  have hfin3 : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcZModSheaf S m) 1) :=
    Finite.of_surjective δ hδs
  refine ⟨hfin3, ?_⟩
  rw [hcardExtV, hcardExtT] at hcard
  exact (Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hm) hcard).symm

theorem wc_quad_cone_vertex_supp_mid_counts (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (c : Matrix (Fin n) (Fin n) K) (hc : IsUnit (c + c.transpose).det)
    (Oc : (Spec (.of (wcQuadModelRing K n 0 c))).Opens)
    (hOc : (Oc : Set (Spec (.of (wcQuadModelRing K n 0 c)))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal}) :
    ∀ k : ℕ, 1 ≤ k →
      Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) (n - 1)) ∧
      Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) (n - 1)) = ℓ ^ k :=
by
  classical
  intro k hk
  have hp : ℓ.Prime := Fact.out
  rcases Nat.lt_or_ge n 4 with h4 | h4
  ·
    have h2 : n = 2 := by
      obtain ⟨t, ht⟩ := hn
      omega
    subst h2
    obtain ⟨hpc, A, B, hA, hB, hAB, hU, hAn, hBn, hAc, hBc⟩ :=
      wc_quad_cone_dim_two_pieces K c hc Oc hOc
    haveI := hpc
    have hC1 := (wc_et_quadric_cone_acyclic K ℓ hp hℓ 2 c).2 1 le_rfl
    have hCk := wc_et_coh_zmod_prime_pow_of_prime _ ℓ hp 1 hC1 (k - 1)
    rw [Nat.sub_add_cancel hk] at hCk
    haveI hcC : CompactSpace
        (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K 2 0 c))))).left := by
      show CompactSpace (Spec (.of (wcQuadModelRing K 2 0 c)))
      infer_instance
    haveI hsC : IsSeparated (Limits.terminal.from
        (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K 2 0 c))))).left) := by
      show IsSeparated (Limits.terminal.from (Spec (.of (wcQuadModelRing K 2 0 c))))
      infer_instance
    have hvan := wc_proet_free_zmod_ext_vanish_of_et_qcsep (Spec (.of (wcQuadModelRing K 2 0 c)))
      (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K 2 0 c))))) (ℓ ^ k) 1 hCk
    exact wc_free_coker_ext_one_card_of_two_pieces _ Oc A B hA hB hAB hU hAn hBn hAc hBc (ℓ ^ k)
      (pow_ne_zero _ hp.ne_zero) hvan
  ·
    obtain ⟨x₀, hx₀⟩ := wc_quad_cone_vertex_point K n c
    have hO : (Oc : Set (Spec (.of (wcQuadModelRing K n 0 c)))) = {x₀}ᶜ := hOc.trans hx₀
    obtain ⟨Oh, hOh⟩ : ∃ Oh : (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens,
        (Oh : Set (Spec (.of (wcQuadModelRing K n 0 (Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 (Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉
            y.asIdeal} := by
      refine ⟨⟨{y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 (Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉
            y.asIdeal}, ?_⟩, rfl⟩
      rw [Set.setOf_exists]
      exact isOpen_iUnion fun p => PrimeSpectrum.isOpen_basicOpen
    obtain ⟨h3a, h3b, h3c⟩ := wc_hyp_cone_punct_mid_coh_mod_ell K ℓ hℓ n hn h4 Oh hOh
    have tr : ∀ m q : ℕ,
        Nonempty (wcEtCoh (Oc : Scheme.{u}) m q ≃ wcEtCoh (Oh : Scheme.{u}) m q) :=
      fun m q => wc_quad_cone_punct_coh_hyperbolic_transport K n hn hn2 c hc Oc hOc Oh hOh m q

    have El := ((wc_quad_cone_vertex_coker_ext K ℓ hℓ n c x₀ Oc hO 1 (n - 3) le_rfl
      (by omega)).some).trans (tr (ℓ ^ 1) (n - 3)).some
    rw [pow_one] at El
    have hlow : ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap
        (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) ℓ) (n - 3 + 1), x = 0 := by
      intro x
      haveI := h3a
      exact El.injective (Subsingleton.elim _ _)

    have e2 : n - 2 = n - 3 + 1 := by omega
    rw [e2] at h3b h3c
    have Em := ((wc_quad_cone_vertex_coker_ext K ℓ hℓ n c x₀ Oc hO 1 (n - 3 + 1) le_rfl
      (by omega)).some).trans (tr (ℓ ^ 1) (n - 3 + 1)).some
    rw [pow_one] at Em
    haveI := h3b

    have hhigh : ∀ j : ℕ, 1 ≤ j → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap
        (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ j)) (n - 3 + 1 + 2)) ∧
        Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap
        (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ j)) (n - 3 + 1 + 2)) = ℓ ^ j := by
      intro j hj
      have Eh := (wc_quad_cone_vertex_coker_ext K ℓ hℓ n c x₀ Oc hO j (n - 1) hj
        (by omega)).some
      have e3 : n - 1 + 1 = n - 3 + 1 + 2 := by omega
      rw [e3] at Eh
      have hcard := (wc_quad_cone_punct_top_counts K ℓ hℓ n hn h4 c hc Oc hOc).2.2 j hj
      haveI : Finite (wcEtCoh (Oc : Scheme.{u}) (ℓ ^ j) (n - 1)) :=
        Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero _ hp.ne_zero)
      exact ⟨Finite.of_equiv _ Eh.symm, (Nat.card_congr Eh).trans hcard⟩

    have e1 : n - 1 = n - 3 + 1 + 1 := by omega
    rw [e1]
    exact wc_zmod_ext_tower_mid_card _ _ ℓ (n - 3 + 1) hlow (Finite.of_equiv _ Em.symm)
      ((Nat.card_congr Em).trans h3c) hhigh k hk

theorem wc_pmn_lup_mid_local_coh_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcRingSheaf
            (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))⟦
          ((n - 1 : ℕ) : ℤ)⟧, a ≠ 0 →
      ∃ c : wcSuppObj Dx ⟶ wcSuppObj Dx,
        w = DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a :=
by
  classical

  have toDer : ∀ (X : Scheme.{u}) (S : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (m : ℕ) (k : ℤ),
      (m : ℤ) = k →
      letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (∀ a w : Abelian.Ext S (SheafOfModules.unit (wcRingSheaf X ℓ)) m, a ≠ 0 →
        ∃ c : S ⟶ S, w = (Abelian.Ext.mk₀ c).comp a (zero_add m)) →
      ∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
            (SheafOfModules.unit (wcRingSheaf X ℓ))))⟦k⟧, a ≠ 0 →
        ∃ c : S ⟶ S, w = DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a := by
    intro X S m k hk
    letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    subst hk
    intro H a w ha
    let ι := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) 0
    let Φ : Abelian.Ext S (SheafOfModules.unit (wcRingSheaf X ℓ)) m →
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
            (SheafOfModules.unit (wcRingSheaf X ℓ))))⟦(m : ℤ)⟧) :=
      fun z => ι.inv.app S ≫ z.hom ≫ (ι.hom.app (SheafOfModules.unit (wcRingSheaf X ℓ)))⟦(m : ℤ)⟧'
    have hsurj : ∀ f, ∃ z, Φ z = f := by
      intro f
      refine ⟨Abelian.Ext.homEquiv.symm (ι.hom.app S ≫ f ≫
        (ι.inv.app (SheafOfModules.unit (wcRingSheaf X ℓ)))⟦(m : ℤ)⟧'), ?_⟩
      show ι.inv.app S ≫ Abelian.Ext.homEquiv (Abelian.Ext.homEquiv.symm _) ≫ _ = f
      rw [Equiv.apply_symm_apply]
