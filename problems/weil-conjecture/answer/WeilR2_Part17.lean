  have s1 : ∀ {C 𝒟 : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasExt.{u+2} C]
      [Category.{u+1} 𝒟] [Abelian 𝒟] [HasExt.{u+2} 𝒟]
      (F : C ⥤ 𝒟) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (P One : C) (U : 𝒟) (ε : U ⟶ F.obj P) (ι : U ⟶ F.obj One) [IsIso ι]
      (_ : ∀ (Y : C) (k : ℕ), Function.Bijective (fun β : Abelian.Ext P Y k =>
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F β) (zero_add k)))
      (a b c : ℕ) (h : a + b = c) (ζ : Abelian.Ext U U a) (ω : Abelian.Ext U U b)
      (_ : ζ.comp ω h ≠ 0),
      ∃ (zt : Abelian.Ext P P a) (a₁ : Abelian.Ext P One b), zt.comp a₁ h ≠ 0 := by
    intro C 𝒟 _ _ _ _ _ _ F _ _ _ P One U ε ι _ hT a b c h ζ ω hne
    obtain ⟨zt, hzt⟩ := (hT P a).2 (ζ.comp (Abelian.Ext.mk₀ ε) (add_zero a))
    obtain ⟨a₁, ha₁⟩ := (hT One b).2 (ω.comp (Abelian.Ext.mk₀ ι) (add_zero b))
    simp only at hzt ha₁
    refine ⟨zt, a₁, fun h0 => hne ?_⟩
    have key : (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (zt.comp a₁ h))
        (zero_add c) = (ζ.comp ω h).comp (Abelian.Ext.mk₀ ι) (add_zero c) := by
      rw [Abelian.Ext.mapExactFunctor_comp]
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add a) h (by omega), hzt,
        Abelian.Ext.comp_assoc _ _ _ (add_zero a) (zero_add b) (by omega), ha₁,
        ← Abelian.Ext.comp_assoc _ _ _ h (add_zero b) (by omega)]
    have hz : Abelian.Ext.mapExactFunctor F (0 : Abelian.Ext P One c) = 0 := by
      have e := Abelian.Ext.mapExactFunctor_add F P One c 0 0
      rw [add_zero] at e
      exact left_eq_add.mp e
    rw [h0, hz, Abelian.Ext.comp_zero] at key
    have e2 := congrArg (fun t => t.comp (Abelian.Ext.mk₀ (inv ι)) (add_zero c)) key
    simp only [Abelian.Ext.zero_comp] at e2
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero c) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at e2
    exact e2.symm


