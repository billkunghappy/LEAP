        exact hQ (Limits.pullback.fst Q.hom i z) ⟨Limits.pullback.snd Q.hom i z, e.symm⟩
      have h0 : ((wcSuppUnitMap D).val.app (Opposite.op Q)).hom
          (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) = 0 := by
        change (((wcSuppUnitMap D).val.app (Opposite.op Q)).hom
          (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) :
            C(↥(Limits.pullback Q.hom i), ULift.{u+1} ℚ_[ℓ])) = 0
        exact ContinuousMap.ext (fun z => (hempty z).elim)
      change (f.val.app (Opposite.op Q)).hom (((wcSuppUnitMap D).val.app (Opposite.op Q)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q)))) = 0
