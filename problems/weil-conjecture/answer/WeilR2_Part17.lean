        w = DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a +
          DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map d) ≫ b :=
by
  classical
  have toDer2 : ∀ (X : Scheme.{u}) (S : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (m : ℕ) (k : ℤ),
      (m : ℤ) = k →
      letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (∀ a b w : Abelian.Ext S (SheafOfModules.unit (wcRingSheaf X ℓ)) m,
        (∀ c d : S ⟶ S, (Abelian.Ext.mk₀ c).comp a (zero_add m) +
          (Abelian.Ext.mk₀ d).comp b (zero_add m) = 0 → c = 0 ∧ d = 0) →
        ∃ c d : S ⟶ S, w = (Abelian.Ext.mk₀ c).comp a (zero_add m) +
          (Abelian.Ext.mk₀ d).comp b (zero_add m)) →
      ∀ a b w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
            (SheafOfModules.unit (wcRingSheaf X ℓ))))⟦k⟧,
        (∀ c d : S ⟶ S,
          DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a +
            DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map d) ≫ b = 0 →
          c = 0 ∧ d = 0) →
        ∃ c d : S ⟶ S,
          w = DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a +
            DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map d) ≫ b := by
    intro X S m k hk
    letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    subst hk
    intro H a b w hab
    let ι := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) 0
    let Φ : Abelian.Ext S (SheafOfModules.unit (wcRingSheaf X ℓ)) m →
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
            (SheafOfModules.unit (wcRingSheaf X ℓ))))⟦(m : ℤ)⟧) :=
      fun z => ι.inv.app S ≫ z.hom ≫ (ι.hom.app (SheafOfModules.unit (wcRingSheaf X ℓ)))⟦(m : ℤ)⟧'
    have hsurj : ∀ f, ∃ z, Φ z = f := by
