      Scheme.fromSpecStalk_closedPoint
    calc i (Limits.pullback.snd V.hom i w) = V.hom (Limits.pullback.fst V.hom i w) := hc.symm
      _ = V.hom z := congrArg _ hw
      _ = V.hom (V.left.fromSpecStalk z (IsLocalRing.closedPoint (V.left.presheaf.stalk z))) :=
          congrArg _ hcp.symm
      _ = (V.left.fromSpecStalk z ≫ V.hom) (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) :=
          (Scheme.Hom.comp_apply _ _ _).symm
  have ht := hτ (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hk hzY _ _ _ hP
    Dk hDk Dz hDz hepiz γ₁₂ hγ₁₂
