      rw [Abelian.Ext.add_comp, Abelian.Ext.comp_assoc_of_third_deg_zero, ← hv₀, preN, hv,
        postN, ← smul_add, sub_add_cancel, smul_smul, smul_smul, ← pow_add, ← pow_add]

  have hRg : Set.range (Limits.pullback.fst V.hom i) = V.hom ⁻¹' Set.range i :=
    Scheme.Pullback.range_fst V.hom i
  have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ V.left), ∃ (N' : ℕ) (f : Fin N' → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range (Limits.pullback.fst V.hom i) ↔
        ∃ k, x ∈ W.basicOpen (f k)) := by
    intro W _ p
    obtain ⟨N', f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ V.hom)
    refine ⟨N', f, fun x => ?_⟩
    rw [← hf x, hRg, Set.mem_preimage, Scheme.Hom.comp_apply]
  have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
  have hO : ((V.hom ⁻¹ᵁ U : V.left.Opens) : Set V.left) =
      (Set.range (Limits.pullback.fst V.hom i))ᶜ := by
    rw [hRg, Scheme.Hom.coe_preimage, hU, Set.preimage_compl]
  haveI hUqc : QuasiCompact U.ι :=
    AlgebraicGeometry.instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion (X := Y) (f := U.ι)
  haveI : QuasiCompact (V.hom ⁻¹ᵁ U).ι :=
