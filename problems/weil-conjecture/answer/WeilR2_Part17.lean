      (SheafOfModules.unit (wcRingSheaf
        (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))
    let Sb := R.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)))
    let ub : Lb ⟶ Sb :=
      R.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map (wcSuppUnitMap Dx)))
    ∀ (Kp : DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)))
      (ι : Kp ⟶ Lb) (δ : Sb ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι ub δ ∈ distTriang _ →
      ∀ a₀' a₁' : Kp ⟶ Lb⟦((n - 1 : ℕ) : ℤ)⟧, a₀' ≠ 0 →
        ∃ φ : Kp ⟶ Kp, a₁' = φ ≫ a₀' :=
by

  have gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One S : 𝒞) (OneW : 𝒞W) (μ : Φ.obj One ≅ OneW)
      (_hP : Projective OneW) (ū : One ⟶ S) (M : ℤ) (_hM : 1 ≤ M) (s : ℤ) (hs : M + 1 = s)
      (s' : ℤ) (hss : s = s')
      (hτ : Function.Bijective (fun f : DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj S) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            One))⟦s⟧ =>
