        have hk : w ≫ b = ((w ≫ b) ≫ σ.hom) ≫ σ.inv := by
          rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
        by_cases hd0 : (w ≫ b) ≫ σ.hom = 0
        · rw [hk, hd0, Limits.zero_comp]
        · exfalso
