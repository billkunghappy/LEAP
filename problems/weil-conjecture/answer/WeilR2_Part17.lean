      Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w ≠ xs
  constructor
  · rintro ⟨p, hp⟩ h
    exact hp ((key w).2 h p)
  · intro h
    by_contra hc
    push_neg at hc
    exact h ((key w).1 hc)

theorem wc_qcl_ruling_geometry (K : Type u) [Field K] (e : ℕ)
    (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal}) :
    ∃ (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens)
      (_ : (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ)
      (ie i_f : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u}))
      (Uev Uodd : (Oh : Scheme.{u}).Opens)
      (πf : (Uev : Scheme.{u}) ⟶ (W : Scheme.{u})) (se : (W : Scheme.{u}) ⟶ (Uev : Scheme.{u})),
      IsClosedImmersion ie ∧ IsClosedImmersion i_f ∧
      ie ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) =
        W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) ∧
      i_f ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) =
        W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) ∧
      (Uev : Set ↥(Oh : Scheme.{u})) = (Set.range i_f)ᶜ ∧
      (Uodd : Set ↥(Oh : Scheme.{u})) = (Set.range ie)ᶜ ∧
      se ≫ Uev.ι = ie ∧ se ≫ πf = 𝟙 _ ∧
      ∀ y : ↥(Oh : Scheme.{u}), y ∈ Uodd ↔ ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
          (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
          (Oh.ι y).asIdeal :=
by
  classical
  revert Oh hOh
  generalize hMAT : (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) = MAT
  intro Oh hOh

  have hsurjc : Function.Surjective
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K) :=
    fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩
  haveI hcc : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))) :=
    IsClosedImmersion.spec_of_surjective _ hsurjc
  obtain ⟨W, hW⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens,
      (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ :=
    ⟨⟨_, (Scheme.Hom.isClosedEmbedding _).isClosed_range.isOpen_compl⟩, rfl⟩
  have horig : ∀ x : Spec (.of (MvPolynomial (Fin (e + 1)) K)), x ∈ Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))) ↔ ∀ i : Fin (e + 1), (MvPolynomial.X i : MvPolynomial (Fin (e + 1)) K) ∈ x.asIdeal := by
    intro x
    constructor
    · rintro ⟨p, rfl⟩ i
      rw [Spec.map_apply]
      change MvPolynomial.constantCoeff (MvPolynomial.X i : MvPolynomial (Fin (e + 1)) K) ∈
        PrimeSpectrum.asIdeal (R := K) p
      rw [MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro h
      have hker : ((RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K) :
          Ideal (MvPolynomial (Fin (e + 1)) K)) : Set (MvPolynomial (Fin (e + 1)) K)) ⊆
          (x.asIdeal : Set (MvPolynomial (Fin (e + 1)) K)) := by
        intro q hq
        have hq0 : MvPolynomial.constantCoeff q = 0 := RingHom.mem_ker.mp hq
        have hspan : q ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (e + 1)))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          rw [MvPolynomial.mem_support_iff] at hm
          by_contra hc
          push_neg at hc
          apply hm
          have hm0 : m = 0 := Finsupp.ext (fun i => hc i (Set.mem_univ i))
          rw [hm0]
          exact hq0
        have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (e + 1)))) ≤ x.asIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨i, _, rfl⟩
          exact h i
        exact hle hspan
      have hx : (x : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K)) ∈ Set.range
          (PrimeSpectrum.comap (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K)) := by
        rw [range_comap_of_surjective _ _ hsurjc]
        exact (PrimeSpectrum.mem_zeroLocus _ _).mpr hker
      obtain ⟨p, hp⟩ := hx
      exact ⟨p, hp⟩
  have hMATpq : ∀ p q : Fin (2 * e + 1 + 1),
      MAT p q = if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 := by
    intro p q; rw [← hMAT]; rfl
  obtain ⟨half, hhalf⟩ : ∃ h : Fin (2 * e + 1 + 1) → Fin (e + 1), ∀ p, (h p).val = p.val / 2 :=
    ⟨fun p => ⟨p.val / 2, by have := p.isLt; omega⟩, fun p => rfl⟩
  have hSpecI : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B) (y : Spec (.of B)),
      (Spec.map (CommRingCat.ofHom f) y).asIdeal = Ideal.comap f y.asIdeal := by
    intro A B _ _ f y
    rw [Spec.map_apply]
    rfl

  have hkill : ∀ f : MvPolynomial (Fin (2 * e + 1 + 1)) K →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      (∀ p q : Fin (2 * e + 1 + 1), p.val % 2 = 0 → q.val = p.val + 1 →
        f (MvPolynomial.X p) * f (MvPolynomial.X q) = 0) →
      ∀ a ∈ wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT, f a = 0 := by
    intro f hf a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have hQ : f (∑ p, ∑ q, MvPolynomial.C (MAT p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 0) = 0 := by
      rw [map_sub, map_sum, MvPolynomial.C_0, map_zero, sub_zero]
      apply Finset.sum_eq_zero
      intro p _
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro q _
      rw [map_mul, map_mul, MvPolynomial.algHom_C]
      by_cases h : p.val % 2 = 0 ∧ q.val = p.val + 1
      · rw [mul_assoc, hf p q h.1 h.2, mul_zero]
      · simp only [hMATpq, if_neg h, map_zero, zero_mul]
    rw [hQ, mul_zero]

  obtain ⟨ζ, hζx⟩ : ∃ ζ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      ∀ p, ζ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) (MvPolynomial.X p)) =
        if p.val % 2 = 0 then 0 else MvPolynomial.X (half p) := by
    refine ⟨Ideal.Quotient.liftₐ _ (MvPolynomial.aeval fun p : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 then (0 : MvPolynomial (Fin (e + 1)) K) else MvPolynomial.X (half p))
      (hkill _ ?_), ?_⟩
    · intro p q hp _
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, if_pos hp, zero_mul]
    · intro p
      exact (Ideal.Quotient.liftₐ_apply _ _ _ _).trans
        ((Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.aeval_X _ _))
  obtain ⟨σ, hσx⟩ : ∃ σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      ∀ p, σ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) (MvPolynomial.X p)) =
        if p.val % 2 = 0 then MvPolynomial.X (half p) else 0 := by
    refine ⟨Ideal.Quotient.liftₐ _ (MvPolynomial.aeval fun p : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 then MvPolynomial.X (half p) else (0 : MvPolynomial (Fin (e + 1)) K))
      (hkill _ ?_), ?_⟩
    · intro p q hp hq
      have hq2 : ¬ q.val % 2 = 0 := by omega
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, if_neg hq2, mul_zero]
    · intro p
      exact (Ideal.Quotient.liftₐ_apply _ _ _ _).trans
        ((Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.aeval_X _ _))
  obtain ⟨φo, hφo⟩ : ∃ φo : MvPolynomial (Fin (e + 1)) K →ₐ[K] wcQuadModelRing K (2 * e + 1 + 1) 0 MAT,
      ∀ k : Fin (e + 1), φo (MvPolynomial.X k) = Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) :=
    ⟨MvPolynomial.aeval fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))),
      fun k => MvPolynomial.aeval_X _ _⟩
  obtain ⟨φe, hφe⟩ : ∃ φe : MvPolynomial (Fin (e + 1)) K →ₐ[K] wcQuadModelRing K (2 * e + 1 + 1) 0 MAT,
      ∀ k : Fin (e + 1), φe (MvPolynomial.X k) = Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) :=
    ⟨MvPolynomial.aeval fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))),
      fun k => MvPolynomial.aeval_X _ _⟩
  have hζev : ∀ k : Fin (e + 1), ζ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) = 0 := by
    intro k
    rw [hζx]
    split_ifs with h
    · rfl
    · exfalso; revert h; simp only [Fin.val_mk]; omega
  have hζod : ∀ k : Fin (e + 1), ζ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) =
        MvPolynomial.X k := by
    intro k
    rw [hζx]
    split_ifs with h
    · exfalso; revert h; simp only [Fin.val_mk]; omega
    · congr 1
      exact Fin.ext (by rw [hhalf]; simp only [Fin.val_mk]; omega)
  have hσev : ∀ k : Fin (e + 1), σ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) =
        MvPolynomial.X k := by
    intro k
    rw [hσx]
    split_ifs with h
    · congr 1
      exact Fin.ext (by rw [hhalf]; simp only [Fin.val_mk]; omega)
    · exfalso; revert h; simp only [Fin.val_mk]; omega
  have hσod : ∀ k : Fin (e + 1), σ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) = 0 := by
    intro k
    rw [hσx]
    split_ifs with h
    · exfalso; revert h; simp only [Fin.val_mk]; omega
    · rfl
  have hζφo : ζ.comp φo = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro k
    rw [AlgHom.comp_apply, hφo, hζod, AlgHom.id_apply]
  have hσφe : σ.comp φe = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro k
    rw [AlgHom.comp_apply, hφe, hσev, AlgHom.id_apply]

  have hpar0 : ∀ I : Ideal (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT),
      (∀ r, φo (ζ r) - r ∈ I) ↔ ∀ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∈ I := by
    intro I
    constructor
    · intro h k
      have h1 := h (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))))
      rw [hζev, map_zero, zero_sub, neg_mem_iff] at h1
      exact h1
    · intro hz r
      have hext : (Ideal.Quotient.mkₐ K I).comp (φo.comp ζ) = Ideal.Quotient.mkₐ K I := by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro p
        simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
        rw [hζx]
        by_cases h : p.val % 2 = 0
        · rw [if_pos h, map_zero, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
          have hp : (⟨2 * (half p).val, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
            Fin.ext (by show 2 * (half p).val = p.val; rw [hhalf]; omega)
          have hzk := hz (half p)
          rw [hp] at hzk
          exact hzk
        · rw [if_neg h, hφo]
          have hp : (⟨2 * (half p).val + 1, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
            Fin.ext (by show 2 * (half p).val + 1 = p.val; rw [hhalf]; omega)
          rw [hp]
      have h2 := AlgHom.congr_fun hext r
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h2
      exact Ideal.Quotient.eq.mp h2
  have hpar1 : ∀ I : Ideal (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT),
      (∀ r, φe (σ r) - r ∈ I) ↔ ∀ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∈ I := by
    intro I
    constructor
    · intro h k
      have h1 := h (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))))
      rw [hσod, map_zero, zero_sub, neg_mem_iff] at h1
      exact h1
    · intro hz r
      have hext : (Ideal.Quotient.mkₐ K I).comp (φe.comp σ) = Ideal.Quotient.mkₐ K I := by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro p
        simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
        rw [hσx]
        by_cases h : p.val % 2 = 0
        · rw [if_pos h, hφe]
          have hp : (⟨2 * (half p).val, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
            Fin.ext (by show 2 * (half p).val = p.val; rw [hhalf]; omega)
          rw [hp]
        · rw [if_neg h, map_zero, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
          have hp : (⟨2 * (half p).val + 1, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
            Fin.ext (by show 2 * (half p).val + 1 = p.val; rw [hhalf]; omega)
          have hzk := hz (half p)
          rw [hp] at hzk
          exact hzk
      have h2 := AlgHom.congr_fun hext r
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h2
      exact Ideal.Quotient.eq.mp h2

  have hemb : ∀ (ζ' : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →ₐ[K] MvPolynomial (Fin (e + 1)) K)
      (φ' : MvPolynomial (Fin (e + 1)) K →ₐ[K] wcQuadModelRing K (2 * e + 1 + 1) 0 MAT),
      ζ'.comp φ' = AlgHom.id K _ →
      (∀ i : Fin (e + 1), ∃ p, ζ' (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X p)) = MvPolynomial.X i) →
      (∀ p, ζ' (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X p)) = 0 ∨ ∃ i : Fin (e + 1), ζ' (Ideal.Quotient.mk
          (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) (MvPolynomial.X p)) = MvPolynomial.X i) →
      ∃ iZ : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u}), IsClosedImmersion iZ ∧
        iZ ≫ Oh.ι = W.ι ≫ Spec.map (CommRingCat.ofHom (ζ' : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
          MvPolynomial (Fin (e + 1)) K)) ∧
        ∀ z : (Oh : Scheme.{u}), z ∈ Set.range iZ ↔ ∀ r, φ' (ζ' r) - r ∈ (Oh.ι z).asIdeal := by
    intro ζ' φ' hζφ' hA hB
    have hsurj : Function.Surjective ζ' :=
      Function.LeftInverse.surjective (g := φ') (fun t => by
        rw [← AlgHom.comp_apply, hζφ', AlgHom.id_apply])
    obtain ⟨j, hjci, hjI, hjeq⟩ : ∃ j : Spec (.of (MvPolynomial (Fin (e + 1)) K)) ⟶
        Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)),
        IsClosedImmersion j ∧
        (∀ x, (j x).asIdeal = Ideal.comap (ζ' : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
          MvPolynomial (Fin (e + 1)) K) x.asIdeal) ∧
        j = Spec.map (CommRingCat.ofHom (ζ' : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
          MvPolynomial (Fin (e + 1)) K)) :=
      ⟨_, IsClosedImmersion.spec_of_surjective _ hsurj, fun x => hSpecI _ x, rfl⟩
    haveI := hjci
    have hWj : W = j ⁻¹ᵁ Oh := by
      apply TopologicalSpace.Opens.ext
      ext x
      rw [show x ∈ ((j ⁻¹ᵁ Oh : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens) : Set _) ↔
        j x ∈ (Oh : Set _) from Scheme.Hom.mem_preimage j, hW, hOh, Set.mem_setOf_eq,
        Set.mem_compl_iff, horig, not_forall, hjI]
      constructor
      · rintro ⟨i, hi⟩
        obtain ⟨p, hp⟩ := hA i
        refine ⟨p, ?_⟩
        rw [Ideal.mem_comap]
        intro h
        apply hi
        rw [← hp]
        exact h
      · rintro ⟨p, hp⟩
        rw [Ideal.mem_comap] at hp
        rcases hB p with h0 | ⟨i, hi⟩
        · exact (hp (by change ζ' _ ∈ _; rw [h0]; exact zero_mem _)).elim
        · refine ⟨i, fun h => hp ?_⟩
          change ζ' _ ∈ _
          rw [hi]
          exact h
    obtain ⟨iZ, hci, hfac⟩ : ∃ iZ : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u}),
        IsClosedImmersion iZ ∧ iZ ≫ Oh.ι = W.ι ≫ j := by
      refine ⟨((Spec (.of (MvPolynomial (Fin (e + 1)) K))).isoOfEq hWj).hom ≫ (j ∣_ Oh),
        inferInstance, ?_⟩
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, Scheme.isoOfEq_hom_ι]
    have hpt : ∀ w, Oh.ι (iZ w) = j (W.ι w) := by
      intro w
      have h1 := Scheme.Hom.comp_apply iZ Oh.ι w
      rw [hfac, Scheme.Hom.comp_apply] at h1
      exact h1.symm
    refine ⟨iZ, hci, by rw [hfac, hjeq], ?_⟩
    intro z
    constructor
    · rintro ⟨w, rfl⟩ r
      rw [hpt, hjI, Ideal.mem_comap]
      change ζ' (φ' (ζ' r) - r) ∈ _
      rw [map_sub, ← AlgHom.comp_apply ζ' φ', hζφ', AlgHom.id_apply, sub_self]
      exact zero_mem _
    · intro hκ
      have hx : j (Spec.map (CommRingCat.ofHom (φ' : MvPolynomial (Fin (e + 1)) K →+*
          wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) (Oh.ι z)) = Oh.ι z := by
        apply PrimeSpectrum.ext
        rw [hjI, hSpecI]
        ext r
        rw [Ideal.mem_comap, Ideal.mem_comap]
        change φ' (ζ' r) ∈ _ ↔ _
        constructor
        · intro h
          simpa using sub_mem h (hκ r)
        · intro h
          simpa using add_mem (hκ r) h
      have hxW : Spec.map (CommRingCat.ofHom (φ' : MvPolynomial (Fin (e + 1)) K →+*
          wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) (Oh.ι z) ∈ Set.range W.ι := by
        rw [Scheme.Opens.range_ι, hWj, SetLike.mem_coe,
          Scheme.Hom.mem_preimage, hx, ← SetLike.mem_coe, ← Scheme.Opens.range_ι]
        exact ⟨z, rfl⟩
      obtain ⟨w, hw⟩ := hxW
      refine ⟨w, ?_⟩
      apply Oh.ι.isOpenEmbedding.injective
      rw [hpt, hw]
      exact hx

  obtain ⟨i_f, hif, hifι, hifR⟩ := hemb ζ φo hζφo
    (fun i => ⟨⟨2 * i.val + 1, by have := i.isLt; omega⟩, hζod i⟩)
    (fun p => by
      rw [hζx]
      split_ifs
      · exact Or.inl rfl
      · exact Or.inr ⟨half p, rfl⟩)
  obtain ⟨ie, hie, hieι, hieR⟩ := hemb σ φe hσφe
    (fun i => ⟨⟨2 * i.val, by have := i.isLt; omega⟩, hσev i⟩)
    (fun p => by
      rw [hσx]
      split_ifs
      · exact Or.inr ⟨half p, rfl⟩
      · exact Or.inl rfl)
  have hif_range : ∀ z : (Oh : Scheme.{u}), z ∈ Set.range i_f ↔ ∀ k : Fin (e + 1),
      Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∈
          (Oh.ι z).asIdeal := fun z => (hifR z).trans (hpar0 _)
  have hie_range : ∀ z : (Oh : Scheme.{u}), z ∈ Set.range ie ↔ ∀ k : Fin (e + 1),
      Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∈
          (Oh.ι z).asIdeal := fun z => (hieR z).trans (hpar1 _)
  haveI := hie
  haveI := hif
  obtain ⟨Uev, hUev⟩ : ∃ U : (Oh : Scheme.{u}).Opens,
      (U : Set ↥(Oh : Scheme.{u})) = (Set.range i_f)ᶜ :=
    ⟨⟨_, i_f.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  obtain ⟨Uodd, hUodd⟩ : ∃ U : (Oh : Scheme.{u}).Opens,
      (U : Set ↥(Oh : Scheme.{u})) = (Set.range ie)ᶜ :=
    ⟨⟨_, ie.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩

  have hdisj : Set.range ie ⊆ Set.range Uev.ι := by
    rw [Scheme.Opens.range_ι, hUev]
    intro z hz hzf
    have h1 := (hie_range z).mp hz
    have h2 := (hif_range z).mp hzf
    have hmem : Oh.ι z ∈ (Oh : Set _) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨z, rfl⟩
    rw [hOh] at hmem
    obtain ⟨p, hp⟩ := hmem
    apply hp
    by_cases h : p.val % 2 = 0
    · have hp' : (⟨2 * (half p).val, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
        Fin.ext (by show 2 * (half p).val = p.val; rw [hhalf]; omega)
      have h3 := h2 (half p)
      rw [hp'] at h3
      exact h3
    · have hp' : (⟨2 * (half p).val + 1, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
        Fin.ext (by show 2 * (half p).val + 1 = p.val; rw [hhalf]; omega)
      have h3 := h1 (half p)
      rw [hp'] at h3
      exact h3
  obtain ⟨se, hse1⟩ : ∃ se : (W : Scheme.{u}) ⟶ (Uev : Scheme.{u}), se ≫ Uev.ι = ie :=
    ⟨IsOpenImmersion.lift Uev.ι ie hdisj, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨g, hgdef⟩ : ∃ g : (Uev : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin (e + 1)) K)),
      g = Uev.ι ≫ Oh.ι ≫ Spec.map (CommRingCat.ofHom (φe : MvPolynomial (Fin (e + 1)) K →+*
        wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) := ⟨_, rfl⟩
  have hg : Set.range g ⊆ Set.range W.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι, hW, Set.mem_compl_iff, horig, not_forall]
    have hy : Uev.ι y ∈ (Uev : Set _) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨y, rfl⟩
    rw [hUev, Set.mem_compl_iff, hif_range, not_forall] at hy
    obtain ⟨k, hk⟩ := hy
    refine ⟨k, ?_⟩
    rw [hgdef, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hSpecI, Ideal.mem_comap]
    intro h
    apply hk
    rw [← hφe]
    exact h
  obtain ⟨πf, hπf⟩ : ∃ πf : (Uev : Scheme.{u}) ⟶ (W : Scheme.{u}), πf ≫ W.ι = g :=
    ⟨IsOpenImmersion.lift W.ι g hg, IsOpenImmersion.lift_fac _ _ _⟩
  have hSP : Spec.map (CommRingCat.ofHom (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        MvPolynomial (Fin (e + 1)) K)) ≫
      Spec.map (CommRingCat.ofHom (φe : MvPolynomial (Fin (e + 1)) K →+*
        wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+* MvPolynomial (Fin (e + 1)) K).comp
        (φe : MvPolynomial (Fin (e + 1)) K →+* wcQuadModelRing K (2 * e + 1 + 1) 0 MAT) =
        RingHom.id _ :=
      RingHom.ext fun t => AlgHom.congr_fun hσφe t
    rw [h1, CommRingCat.ofHom_id, Spec.map_id]
  have hse2 : se ≫ πf = 𝟙 _ := by
    rw [← cancel_mono W.ι, Category.assoc, hπf, hgdef, ← Category.assoc, hse1,
      ← Category.assoc, hieι, Category.assoc, hSP, Category.comp_id, Category.id_comp]
  have hstr : ∀ ζ' : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      Spec.map (CommRingCat.ofHom (ζ' : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        MvPolynomial (Fin (e + 1)) K)) ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 MAT =
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) := by
    intro ζ'
    dsimp only [wcQuadModelStr]
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
  have hieK : ie ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 MAT =
      W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) := by
    rw [← Category.assoc, hieι, Category.assoc, hstr]
  have hifK : i_f ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 MAT =
      W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) := by
    rw [← Category.assoc, hifι, Category.assoc, hstr]
  have hmem : ∀ y : ↥(Oh : Scheme.{u}), y ∈ Uodd ↔ ∃ k : Fin (e + 1),
      Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
        (Oh.ι y).asIdeal := by
    intro y
    rw [← SetLike.mem_coe, hUodd, Set.mem_compl_iff, hie_range, not_forall]
  exact ⟨W, hW, ie, i_f, Uev, Uodd, πf, se, hie, hif, hieK, hifK, hUev, hUodd, hse1, hse2, hmem⟩

theorem wc_qcl_punct_affine_top_ne_zero (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (e : ℕ)
    (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens)
    (hW : (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ) :
    ∃ ω₀ : wcHM (W : Scheme.{u}) ℓ (2 * e + 1), ω₀ ≠ 0 :=
by
  classical
  obtain ⟨U₀, hU₀, ω, hω⟩ := wc_punct_affine_strict_local_top_nonzero K ℓ hℓ (e + 1) (2 * e + 1)
    (by omega) (by omega)
  have hUW : U₀ = W := TopologicalSpace.Opens.ext (hU₀.trans hW.symm)
  subst hUW
  refine ⟨ω, fun h0 => ?_⟩

  let ε : MvPolynomial (Fin (e + 1)) K →+* K := MvPolynomial.constantCoeff
  let p : Ideal (MvPolynomial (Fin (e + 1)) K) := RingHom.ker ε
  haveI hp : p.IsPrime := RingHom.ker_isPrime ε
  haveI : IsNoetherianRing (Localization.AtPrime p) :=
    IsLocalization.isNoetherianRing p.primeCompl (Localization.AtPrime p) inferInstance
  obtain ⟨H, _, _, _, ι, hι, happ, -, -, hwe⟩ :=
    wc_lfi_henselization_weaklyEtale (Localization.AtPrime p)
  haveI := hι
  let α : MvPolynomial (Fin (e + 1)) K →+* Localization.AtPrime p :=
    algebraMap (MvPolynomial (Fin (e + 1)) K) (Localization.AtPrime p)
  have hαmem : ∀ b, b ∈ p → α b ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
    intro b hb
    have h := Localization.AtPrime.under_maximalIdeal (I := p)
    rw [← h] at hb
    exact hb
  let k : Spec (.of H) ⟶ Spec (.of (MvPolynomial (Fin (e + 1)) K)) :=
    Spec.map (CommRingCat.ofHom (ι.comp α))

  have hk : WeaklyEtale k := by
    have h1 : WeaklyEtale (Spec.map (CommRingCat.ofHom α)) :=
      wc_lfi_specMap_weaklyEtale _ _
        (wc_localization_weaklyEtale _ (Localization.AtPrime p) p.primeCompl)
    have h2 : WeaklyEtale (Spec.map (CommRingCat.ofHom ι)) := by
      letI := ι.toAlgebra
      exact wc_lfi_specMap_weaklyEtale _ _ hwe
    have hcomp : k = Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (CommRingCat.ofHom α) := by
      simp only [k, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hcomp]
    exact @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ h2 h1

  have hpt : k (IsLocalRing.closedPoint H) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin (e + 1))))
        (IsLocalRing.closedPoint K) := by
    show PrimeSpectrum.comap (ι.comp α) (IsLocalRing.closedPoint H) =
      PrimeSpectrum.comap ε (IsLocalRing.closedPoint K)
    rw [PrimeSpectrum.comap_comp, Function.comp_apply, IsLocalRing.comap_closedPoint ι]
    apply PrimeSpectrum.ext
    show Ideal.comap α (IsLocalRing.maximalIdeal (Localization.AtPrime p)) =
      Ideal.comap ε (IsLocalRing.maximalIdeal K)
    rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot]
    exact Localization.AtPrime.under_maximalIdeal (I := p)

  have hsurj : Function.Surjective
      ((IsLocalRing.residue H).comp (ι.comp (α.comp MvPolynomial.C))) := by
    intro r
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective r
    obtain ⟨y, hy⟩ := happ x
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl y
    have hs : ε s ≠ 0 := fun h => s.2 (RingHom.mem_ker.mpr h)
    set c : K := ε a / ε s with hc
    refine ⟨c, ?_⟩
    have hbp : a - MvPolynomial.C c * (s : MvPolynomial (Fin (e + 1)) K) ∈ p := by
      rw [RingHom.mem_ker, map_sub, map_mul]
      show ε a - ε (MvPolynomial.C c) * ε s = 0
      have : ε (MvPolynomial.C c) = c := MvPolynomial.constantCoeff_C _ _
      rw [this, hc]
      field_simp
      ring
    have hu := IsLocalization.mk'_spec (Localization.AtPrime p) (1 : MvPolynomial (Fin (e + 1)) K) s
    have hy' : IsLocalization.mk' (Localization.AtPrime p) a s =
        α a * IsLocalization.mk' (Localization.AtPrime p) (1 : MvPolynomial (Fin (e + 1)) K) s :=
      IsLocalization.mk'_eq_mul_mk'_one _ _
    have hdiff : IsLocalization.mk' (Localization.AtPrime p) a s - α (MvPolynomial.C c) =
        α (a - MvPolynomial.C c * (s : MvPolynomial (Fin (e + 1)) K)) *
          IsLocalization.mk' (Localization.AtPrime p) (1 : MvPolynomial (Fin (e + 1)) K) s := by
      rw [hy', map_sub, map_mul]
      rw [map_one] at hu
      linear_combination (α (MvPolynomial.C c)) * hu
    have hmP : IsLocalization.mk' (Localization.AtPrime p) a s - α (MvPolynomial.C c) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
      rw [hdiff]
      exact Ideal.mul_mem_right _ _ (hαmem _ hbp)
    have hmH := map_nonunit ι _ hmP
    have hsum : x - ι (α (MvPolynomial.C c)) =
        (x - ι (IsLocalization.mk' (Localization.AtPrime p) a s)) +
          ι (IsLocalization.mk' (Localization.AtPrime p) a s - α (MvPolynomial.C c)) := by
      rw [map_sub]; ring
    have hmem : x - ι (α (MvPolynomial.C c)) ∈ IsLocalRing.maximalIdeal H := by
      rw [hsum]; exact Ideal.add_mem _ hy hmH
    have h0' := (IsLocalRing.residue_eq_zero_iff _).mpr hmem
    rw [map_sub, sub_eq_zero] at h0'
    exact h0'.symm
  haveI : IsAlgClosed (IsLocalRing.ResidueField H) :=
    IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ ⟨RingHom.injective _, hsurj⟩)
  haveI : IsSepClosed (IsLocalRing.ResidueField H) := IsSepClosed.of_isAlgClosed _
  obtain ⟨DT, hDT⟩ := wc_hm_pull_data_exists (Limits.pullback.fst U₀.ι k) ℓ
  exact hω H k hk hpt (Limits.pullback U₀.ι k) (Limits.pullback.snd U₀.ι k)
    (Limits.pullback.fst U₀.ι k) (IsPullback.of_hasPullback U₀.ι k) DT hDT
    (by rw [h0, map_zero])

theorem wc_qcl_plane_supp_vanish (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (e : ℕ) (he : 1 ≤ e)
    (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens)
    (hW : (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ)
    (i : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u})) [IsClosedImmersion i]
    (hiK : i ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) =
        W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))))
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) :
    ∀ θ : wcSuppExt D (2 * e + 1 + 1), θ = 0 :=
by
  classical

  obtain ⟨hsm, hcpt, hsep⟩ := wc_hyp_quad_cone_punct_smooth_qcsep K e Oh hOh
  haveI := hsm
  haveI := hcpt
  haveI := hsep
  haveI hR : IsNoetherianRing (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := Ideal.Quotient.isNoetherianRing _
  have hset : ∀ {X : Scheme.{u}} [TopologicalSpace.NoetherianSpace ↥X] (U : X.Opens),
      TopologicalSpace.NoetherianSpace ↥(U : Scheme.{u}) :=
    fun {X} _ U => TopologicalSpace.NoetherianSpace.set (U : Set ↥X)
  haveI : TopologicalSpace.NoetherianSpace ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0
      (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))) := inferInstance
  haveI hNOh : TopologicalSpace.NoetherianSpace ↥(Oh : Scheme.{u}) := hset Oh
  haveI : QuasiSeparatedSpace ↥(Oh : Scheme.{u}) := inferInstance
  haveI : IsLocallyNoetherian (Oh : Scheme.{u}) := inferInstance
  obtain ⟨O, hO⟩ : ∃ O : (Oh : Scheme.{u}).Opens, (O : Set ↥(Oh : Scheme.{u})) = (Set.range i)ᶜ :=
    ⟨⟨_, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  haveI hNO : TopologicalSpace.NoetherianSpace ↥(O : Scheme.{u}) := hset O
  haveI : CompactSpace ↥(O : Scheme.{u}) := inferInstance
  haveI : QuasiSeparatedSpace ↥(O : Scheme.{u}) := inferInstance

  have s1 : ∀ D' : wcEtPullData i ℓ, Subsingleton (wcEtSuppExt D' (2 * e + 1 + 1)) := by
    intro D'
    haveI : SmoothOfRelativeDimension (e + 1)
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K)))) :=
      wc_mvpoly_spec_smooth_reldim K (e + 1)
    have hWs : SmoothOfRelativeDimension (e + 1)
        (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K)))) := by
      have := smoothOfRelativeDimension_comp 0 (e + 1) W.ι
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))))
      rwa [zero_add] at this
    haveI : SmoothOfRelativeDimension (e + 1)
        (i ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) := by
      rw [hiK]
      exact hWs
    have hne : Nonempty ↥(W : Scheme.{u}) := by
      have hmem : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K)) ∈
          (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) := by
        rw [hW]
        rintro ⟨q, hq⟩
        have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin (e + 1)) K) ∈
            (Spec.map (CommRingCat.ofHom
              (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K)) q).asIdeal := by
          rw [Spec.map_base]
          show (MvPolynomial.constantCoeff (MvPolynomial.X 0 : MvPolynomial (Fin (e + 1)) K)) ∈
            q.asIdeal
          rw [MvPolynomial.constantCoeff_X]
          exact zero_mem _
        rw [hq] at h1
        exact MvPolynomial.X_ne_zero _ h1
      exact ⟨⟨_, hmem⟩⟩
    obtain ⟨E⟩ := wc_et_smooth_pair_purity_ext_equiv K
      (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
      (2 * e + 1) (e + 1) e (by omega) i ℓ hℓ hne D' 2
    obtain ⟨E2⟩ := wc_et_zmodext_coh_equiv (W : Scheme.{u}) ℓ 2
    haveI : Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ 2) :=
      wc_rpss_punct_affine_low_vanishing K (e + 1) ℓ hℓ W hW 2 (by norm_num) (by omega)
    haveI : Subsingleton (wcEtZModExt (W : Scheme.{u}) ℓ 2) := E2.subsingleton
    have h : Subsingleton (wcEtSuppExt D' (2 + 2 * e)) := E.symm.subsingleton
    have he2 : 2 + 2 * e = 2 * e + 1 + 1 := by omega
    rw [he2] at h
    exact h

  have s2 : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
      [CompactSpace Y] [QuasiSeparatedSpace Y] (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
      [CompactSpace O.toScheme] [QuasiSeparatedSpace O.toScheme] (d : ℕ)
      (hsupp : ∀ D : wcEtPullData i ℓ, Subsingleton (wcEtSuppExt D (d + 1))),
      ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y ℓ) (d + 1), x = 0 := by
    intro Y Z i _ _ _ O hO _ _ d hsupp
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
    obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O.ι ℓ
    haveI hDs := hsupp D
    obtain ⟨ha, -, hc⟩ := wc_et_supp_open_les i O hO ℓ D Dj
    have hinj : ∀ y : wcEtZModExt Y ℓ (d + 1), wcEtPull Dj (d + 1) y = 0 → y = 0 := by
      intro y hy
      obtain ⟨x', hx'⟩ := (ha (d + 1) y).mp hy
      rw [← hx', Subsingleton.elim x' 0, Abelian.Ext.comp_zero]
    obtain ⟨δ, -, hδ⟩ := hc d (d + 1) (by omega)
    have hsurj : ∀ b : wcEtZModExt O.toScheme ℓ d, ∃ v, wcEtPull Dj d v = b := by
      intro b
      exact (hδ b).mp (Subsingleton.elim _ _)
    obtain ⟨FY, FO, hF⟩ := wc_proet_open_restr_et_model Y O ℓ (d + 1) Dj
    obtain ⟨FY', FO', hF'⟩ := wc_proet_open_restr_et_model Y O ℓ d Dj
    set f := wcFreeSheafMap Y (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)) with hfdef
    intro x
    have hmono : Mono f := wc_free_sheaf_map_mono Y _ _ _ (IsOpenImmersion.mono O.ι)
    have hS : (ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)).ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel f)) hmono inferInstance
    have hz : (Abelian.Ext.mk₀ (Limits.cokernel.π f)).comp x (zero_add (d + 1)) = 0 := by
      have h1 : FO (wcEtPull Dj (d + 1)
          (FY.symm ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).comp x (zero_add (d + 1))))) = 0 := by
        rw [← hF, AddEquiv.apply_symm_apply,
          ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (d + 1)) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
          Abelian.Ext.zero_comp]
      have h2 := hinj _ ((AddEquiv.map_eq_zero_iff FO).mp h1)
      rw [← FY.apply_symm_apply ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).comp x (zero_add (d + 1))),
        h2, map_zero]
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS (wcZModSheaf Y ℓ) x hz
      (show 1 + d = d + 1 by omega)
    obtain ⟨v', hv'⟩ := hsurj (FO'.symm x₁)
    have hx1 : x₁ = (Abelian.Ext.mk₀ f).comp (FY' v') (zero_add d) := by
      rw [hF', hv', AddEquiv.apply_symm_apply]
    have hE : hS.extClass.comp (Abelian.Ext.mk₀ f) (add_zero 1) = 0 := hS.extClass_comp
    rw [← hx₁, hx1, ← Abelian.Ext.comp_assoc_of_second_deg_zero, hE, Abelian.Ext.zero_comp]

  have s3 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
      (h1 : ∀ x : Abelian.Ext P (wcZModSheaf S ℓ) N, x = 0),
      ∀ (k : ℕ) (x : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N), x = 0 := by
    intro S P N h1 k
    induction k with
    | zero =>
      have e0 : ℓ ^ (0 + 1) = ℓ := by ring
      rw [e0]
      exact h1
    | succ k ih =>
      intro x
      obtain ⟨f, g, f', p, hfg, hfp, hS, -, -⟩ := wc_glc_zmod_ses S ℓ (k + 1)
      have hx : x.comp (Abelian.Ext.mk₀ g) (add_zero N) = 0 := h1 _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x hx
      rw [← hx₁, ih x₁, Abelian.Ext.zero_comp]

  have s4 : ∀ (Y : Scheme.{u}) (P0 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (j : ℕ)
      (h : ∀ k : ℕ, ∀ y : Abelian.Ext P0 (wcZModSheaf Y (ℓ ^ (k + 1))) (j + 1), y = 0),
      ∀ y : Abelian.Ext P0 (wcIntSheaf Y ℓ) (j + 1), y = 0 := by
    intro Y P0 j h

    have N1 : ∀ (P Z Y' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
        (B : ℕ → Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (pr : ∀ n, Y' ⟶ B n)
        (c : ∀ n, B (n + 1) ⟶ B n) (T : Y' ⟶ Y') (hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n)
        (f : Z ⟶ Y') (hzero : f ≫ T = 0) (hS : (ShortComplex.mk f T hzero).ShortExact)
        (hinj : ∀ (N : ℕ) (x : Abelian.Ext P Y' N),
          (∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = 0) → x = 0)
        (hsurj : ∀ (N : ℕ) (y : ∀ n, Abelian.Ext P (B n) N), ∃ x : Abelian.Ext P Y' N,
          ∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = y n)
        (hB : ∀ (n : ℕ) (x : Abelian.Ext P (B n) (j + 1)), x = 0)
        (hc : ∀ (n : ℕ) (y : Abelian.Ext P (B n) j), ∃ z : Abelian.Ext P (B (n + 1)) j,
          z.comp (Abelian.Ext.mk₀ (c n)) (add_zero j) = y),
        ∀ x : Abelian.Ext P Z (j + 1), x = 0 := by
      intro P Z Y' B pr c T hT f hzero hS hinj hsurj hB hc
      have s4 : ∀ y : Abelian.Ext P Y' j, ∃ w : Abelian.Ext P Y' j,
          w.comp (Abelian.Ext.mk₀ T) (add_zero j) = y := by
        intro y
        choose g hg using hc
        let x : ∀ n, Abelian.Ext P (B n) j := fun n =>
          Nat.rec (motive := fun n => Abelian.Ext P (B n) j) 0
            (fun n xn => g n (xn - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j))) n
        have hx : ∀ n, (x (n + 1)).comp (Abelian.Ext.mk₀ (c n)) (add_zero j) =
            x n - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) := fun n => hg n _
        obtain ⟨w, hw⟩ := hsurj j x
        refine ⟨w, ?_⟩
        rw [← sub_eq_zero]
        apply hinj j
        intro n
        have key : ∀ (a b : Abelian.Ext P Y' j) (g : Y' ⟶ B n),
            (a - b).comp (Abelian.Ext.mk₀ g) (add_zero j) =
              a.comp (Abelian.Ext.mk₀ g) (add_zero j) - b.comp (Abelian.Ext.mk₀ g) (add_zero j) := by
          intro a b g
          rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
        have h1 : (w.comp (Abelian.Ext.mk₀ T) (add_zero j)).comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) =
            w.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) -
              (w.comp (Abelian.Ext.mk₀ (pr (n + 1))) (add_zero j)).comp (Abelian.Ext.mk₀ (c n))
                (add_zero j) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hT n,
            Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
            sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.comp_add,
            Abelian.Ext.comp_neg, ← sub_eq_add_neg]
        rw [key, h1, hw, hw, hx]
        abel
      intro z
      have h0 : z.comp (Abelian.Ext.mk₀ f) (add_zero (j + 1)) = 0 := hinj _ _ (fun n => hB n _)
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z h0 (rfl : j + 1 = j + 1)
      rw [← hx₃]
      obtain ⟨w, hw⟩ := s4 x₃
      rw [← hw, Abelian.Ext.comp_assoc_of_second_deg_zero]
      have h2 := hS.comp_extClass
      erw [h2, Abelian.Ext.comp_zero]

    have N3 : ∀ k : ℕ, ∃ φ : ZMod (ℓ ^ (0 + 1)) →+ ZMod (ℓ ^ (k + 1 + 1)),
        Function.Injective φ ∧
          ∀ b : ZMod (ℓ ^ (k + 1 + 1)), wcTowerCast ℓ (k + 1) b = 0 ↔ ∃ a, φ a = b := by
      intro k
      have hℓ1 : 1 < ℓ := (Fact.out : Nat.Prime ℓ).one_lt
      have hℓ0 : ℓ ≠ 0 := by omega
      have hqpos : 0 < ℓ ^ (k + 1) := pow_pos (by omega) _
      haveI : NeZero (ℓ ^ (0 + 1)) := ⟨pow_ne_zero _ hℓ0⟩
      haveI : NeZero (ℓ ^ (k + 1 + 1)) := ⟨pow_ne_zero _ hℓ0⟩
      have hφc : (zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1))) ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))))
          ((ℓ ^ (0 + 1) : ℕ) : ℤ) = 0 := by
        rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul,
          ZMod.natCast_eq_zero_iff]
        exact ⟨1, by ring⟩
      obtain ⟨φ, hφdef⟩ : ∃ φ : ZMod (ℓ ^ (0 + 1)) →+ ZMod (ℓ ^ (k + 1 + 1)),
          φ = ZMod.lift (ℓ ^ (0 + 1)) ⟨zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1)))
            ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))), hφc⟩ := ⟨_, rfl⟩
      have hF : ∀ m : ℕ, φ (m : ZMod (ℓ ^ (0 + 1))) =
          ((m * ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))) := by
        intro m
        rw [show ((m : ℕ) : ZMod (ℓ ^ (0 + 1))) = ((m : ℤ) : ZMod (ℓ ^ (0 + 1))) from
          (Int.cast_natCast m).symm, hφdef, ZMod.lift_coe]
        show (zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1))) ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))))
          ((m : ℕ) : ℤ) = _
        rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, Nat.cast_mul]
      have hcast : ∀ m : ℕ, wcTowerCast ℓ (k + 1) (m : ZMod (ℓ ^ (k + 1 + 1))) =
          (m : ZMod (ℓ ^ (k + 1))) := by
        intro m
        show (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (k + 1))) (ZMod (ℓ ^ (k + 1))))
          (m : ZMod (ℓ ^ (k + 1 + 1))) = _
        exact map_natCast _ m
      refine ⟨φ, ?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro a ha
        have e := hF a.val
        rw [ZMod.natCast_zmod_val] at e
        rw [e, ZMod.natCast_eq_zero_iff] at ha
        have hN : ℓ ^ (k + 1 + 1) = ℓ * ℓ ^ (k + 1) := by ring
        rw [hN] at ha
        have hdvd : ℓ ∣ a.val := Nat.dvd_of_mul_dvd_mul_right hqpos ha
        have hlt : a.val < ℓ := by
          have := ZMod.val_lt a
          simpa using this
        have h0 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
        exact (ZMod.val_eq_zero a).mp h0
      · intro b
        constructor
        · intro hb
          rw [← ZMod.natCast_zmod_val b, hcast, ZMod.natCast_eq_zero_iff] at hb
          obtain ⟨m, hm⟩ := hb
          refine ⟨(m : ZMod (ℓ ^ (0 + 1))), ?_⟩
          rw [hF, ← ZMod.natCast_zmod_val b, hm]
          push_cast
          ring
        · rintro ⟨a, rfl⟩
          have e := hF a.val
          rw [ZMod.natCast_zmod_val] at e
          rw [e, hcast, ZMod.natCast_eq_zero_iff]
          exact dvd_mul_left _ _

    have hzero0 : (𝟙 (wcContSheaf Y (ZMod (ℓ ^ 0))) : _ ⟶ _) = 0 := by
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact Subsingleton.elim _ _
    have hB0 : ∀ (N : ℕ) (x : Abelian.Ext P0 (wcContSheaf Y (ZMod (ℓ ^ 0))) N),
        x = 0 := by
      intro N x
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero N) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = 0 := by rw [hzero0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

    haveI := wc_proet_products_exact Y
    obtain ⟨hcont_incl, hemb, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
    obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact Y (wcTowerIncl ℓ) hcont_incl
      (wcTowerShift ℓ) hcont_shift hemb hker hsec
    have hY := (wc_contSheaf_pi_isLimit Y (fun n => ZMod (ℓ ^ n))).some
    have hprod := fun N => wc_ext_prod_bijective P0
      (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
      (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
        (continuous_apply n)) hY N
    have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
        (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
        wcContSheafMap Y φ hφ = wcContSheafMap Y φ' hφ' := by
      intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
      subst e
      rfl
    have hTn : ∀ n, wcContSheafMap Y (wcTowerShift ℓ) hcont_shift ≫
        wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
        wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
        wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
          (continuous_apply (n + 1)) ≫
        wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology := by
      intro n
      have e1 := (wc_contSheafMap_comp_sub Y (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
        hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
      have e2 := (wc_contSheafMap_comp_sub Y
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
        (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
      have e3 := (wc_contSheafMap_comp_sub Y
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
        ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
        (continuous_apply n)
        ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
        (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
      rw [← e1, ← e2, ← e3]
      exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _

    have hB : ∀ (n : ℕ) (x : Abelian.Ext P0 (wcContSheaf Y (ZMod (ℓ ^ n))) (j + 1)),
        x = 0 := by
      intro n x
      cases n with
      | zero => exact hB0 _ x
      | succ k => exact h k x

    have hc : ∀ (n : ℕ) (y : Abelian.Ext P0 (wcContSheaf Y (ZMod (ℓ ^ n))) j),
        ∃ z : Abelian.Ext P0 (wcContSheaf Y (ZMod (ℓ ^ (n + 1)))) j,
          z.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerCast ℓ n)
            continuous_of_discreteTopology)) (add_zero j) = y := by
      intro n y
      cases n with
      | zero =>
        refine ⟨0, ?_⟩
        rw [Abelian.Ext.zero_comp, hB0 j y]
      | succ k =>
        obtain ⟨φ, hφinj, hker'⟩ := N3 k
        have hφemb : Topology.IsEmbedding φ :=
          (Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap
            continuous_of_discreteTopology hφinj (fun s _ => isClosed_discrete _)).isEmbedding
        have hsurj : Function.Surjective (wcTowerCast ℓ (k + 1)) :=
          ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ (k + 1)))
        obtain ⟨hzk, hSk⟩ := wc_contSheaf_shortExact Y φ continuous_of_discreteTopology
          (wcTowerCast ℓ (k + 1)) continuous_of_discreteTopology hφemb hker'
          ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
        have hob : y.comp hSk.extClass (rfl : j + 1 = j + 1) = 0 := h 0 _
        obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P0 hSk y rfl hob
        exact ⟨z, hz⟩
    have hvan := N1 P0 _ _
      (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
      (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
        (continuous_apply n))
      (fun n => wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology)
      _ hTn _ hz2 hS2 (fun N => (hprod N).1) (fun N => (hprod N).2) hB hc
    intro y
    exact hvan y

  have s5 : ∀ (S : Scheme.{u}) [CompactSpace S] [QuasiSeparatedSpace S]
      (O : S.Opens) [CompactSpace O.toScheme] [QuasiSeparatedSpace O.toScheme] (N : ℕ)
      (hint : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcIntSheaf S ℓ) N, y = 0),
      ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcLadicSheaf S ℓ) N, x = 0 := by
    intro S _ _ O _ _ N hint x
    have hmono := wc_free_sheaf_map_mono S _ _
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) (IsOpenImmersion.mono O.ι)
    haveI : CompactSpace (Scheme.ProEt.mk (𝟙 S)).left := inferInstanceAs (CompactSpace S)
    haveI : QuasiSeparatedSpace (Scheme.ProEt.mk (𝟙 S)).left :=
      inferInstanceAs (QuasiSeparatedSpace S)
    haveI : CompactSpace (Scheme.ProEt.mk O.ι).left := inferInstanceAs (CompactSpace O.toScheme)
    haveI : QuasiSeparatedSpace (Scheme.ProEt.mk O.ι).left :=
      inferInstanceAs (QuasiSeparatedSpace O.toScheme)
    obtain ⟨n, y, hy⟩ := proet_free_coker_ladic_rationalization S _ _ _ ℓ hmono N x
    rw [hint y, Abelian.Ext.zero_comp] at hy
    obtain ⟨h1, hmul, hadd⟩ := wc_ladic_scalar_ring S ℓ
    have h0 : wcLadicScalar S ℓ 0 = 0 := by
      have e0 : wcLadicScalar S ℓ 0 + wcLadicScalar S ℓ 0 = wcLadicScalar S ℓ 0 + 0 := by
        rw [add_zero, ← hadd, add_zero]
      exact add_left_cancel e0
    have hA : ∀ m : ℕ, x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (m : ℚ_[ℓ]))) (add_zero N) =
        m • x := by
      intro m
      induction m with
      | zero =>
        rw [Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
      | succ m ih =>
        rw [Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hc : ((ℓ ^ n : ℕ) : ℚ_[ℓ]) ≠ 0 :=
      Nat.cast_ne_zero.mpr (pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero)
    have hx0 : x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ]))) (add_zero N) =
        0 := by
      rw [hA, hy]
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero N) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ]) ≫
            wcLadicScalar S ℓ (((ℓ ^ n : ℕ) : ℚ_[ℓ]))⁻¹)) (add_zero N) := by
          rw [← hmul, inv_mul_cancel₀ hc, h1]
      _ = (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ]))) (add_zero N)).comp
            (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (((ℓ ^ n : ℕ) : ℚ_[ℓ]))⁻¹)) (add_zero N) := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]
      _ = 0 := by rw [hx0, Abelian.Ext.zero_comp]

  have s7 : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y]
      (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) (O : Y.Opens)
      (hO : (O : Set Y) = (Set.range i)ᶜ) (n : ℕ)
      (hv : ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcLadicSheaf Y ℓ) n, x = 0),
      ∀ θ : wcSuppExt D n, θ = 0 := by
    intro Y Z i _ _ D hD O hO n hv θ
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    have htf : ∀ (V : (Y.ProEt)ᵒᵖ) (k : ℕ)
        (r : ↑((wcRingSheaf Y ℓ).obj.obj V)), k ≠ 0 → k • r = 0 → r = 0 := by
      intro V k r hk hr
      have hc : ((k : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
      have key2 : ∀ {T : Type u} [TopologicalSpace T] (a : C(T, ULift.{u+1} ℚ_[ℓ])),
          k • a = 0 → a = 0 := by
        intro T _ a h
        refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
        have h1 : k • (a t).down = 0 :=
          congrArg (fun g : C(T, ULift.{u+1} ℚ_[ℓ]) => (g t).down) h
        rw [nsmul_eq_mul] at h1
        exact (mul_eq_zero.mp h1).resolve_left hc
      exact key2 (T := ↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj
        (Opposite.unop V))) r hr
    obtain ⟨L, adj, hA, hL, hC⟩ := sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
      (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ) htf
    haveI := hA
    haveI := hL
    haveI := hC
    obtain ⟨ε, hσρ, hex⟩ := wc_closed_supp_kernel_free i ℓ D hD L adj O hO
    haveI := wc_supp_unit_epi_of_closed i ℓ D hD
    have hc := hex.gIsCokernel
    let e := (Limits.cokernelIsCokernel _).coconePointUniqueUpToIso hc
    let Ψ := fun v' : wcSuppExt D n => (Abelian.Ext.mk₀ e.hom).comp v' (zero_add n)
    have hΨinj : Function.Injective Ψ := by
      intro v₁ v₂ h
      have k : ∀ v' : wcSuppExt D n,
          (Abelian.Ext.mk₀ e.inv).comp (Ψ v') (zero_add _) = v' := by
        intro v'
        show (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp v' (zero_add _))
          (zero_add _) = v'
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      rw [← k v₁, ← k v₂, h]
    have hΨ0 : Ψ 0 = 0 := Abelian.Ext.comp_zero _ _ _ _ _
    obtain ⟨Θ, -⟩ := wc_free_coker_module_ext_transfer Y ℓ L adj ε
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)) n
    apply hΨinj
    apply Θ.injective
    rw [hΨ0, map_zero]
    exact hv _

  have h2 := s2 i O hO (2 * e + 1) s1
  have h3 := s3 _ _ _ h2
  have h4 := s4 _ _ _ h3
  have h5 := s5 _ O _ h4
  exact s7 i D hD O hO _ h5

theorem wc_qcl_restrict_surj_of_supp_vanish {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (O : Y.Opens) (hO : (O : Set ↥Y) = (Set.range i)ᶜ) (q : ℕ)
    (hv : ∀ θ : wcSuppExt D (q + 1), θ = 0)
    (Do : wcHMPullData O.ι ℓ) (hDo : wcHMPullCanonical Do) :
    Function.Surjective (wcHMPull Do q) :=
by
  classical
  letI instV : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf O.toScheme ℓ)) := HasExt.standard _
  haveI := Do.additive
  haveI := Do.presLim
  haveI := Do.presColim
  haveI hepi : Epi (wcSuppUnitMap D) := wc_supp_unit_epi_of_noetherian i ℓ D hD
  have hker := fun U k W g hW => wc_supp_kernel_section_local_cover i D hD U k W g hW

  have hdisj : ∀ (t : ↥O.toScheme) (z : ↥Z), O.ι t ≠ i z := by
    intro t z h
    have h1 : O.ι t ∈ (O : Set ↥Y) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨t, rfl⟩
    rw [hO, h] at h1
    exact h1 ⟨z, rfl⟩
  have hempty : IsEmpty ↥(Limits.pullback O.ι i) := by
    refine ⟨fun x => hdisj ((Limits.pullback.fst O.ι i) x) ((Limits.pullback.snd O.ι i) x) ?_⟩
    have h : (Limits.pullback.fst O.ι i ≫ O.ι) x = (Limits.pullback.snd O.ι i ≫ i) x := by
      rw [Limits.pullback.condition]
    rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h

  have hkey : Do.μ.inv ≫ Do.Φ.map (wcSuppUnitMap D) = 0 := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have h7 := wc_supp_pull_unit_vanish_off i O.ι (Limits.pullback.fst O.ι i)
      (Limits.pullback.snd O.ι i) (IsPullback.of_hasPullback O.ι i) ℓ D Do (Opposite.unop X)
      (fun x hx => by
        obtain ⟨p, _⟩ := hx
        exact hempty.false p)
    refine Eq.trans h7 ?_
    first
      | rfl
      | simp

  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcRingSheaf O.toScheme ℓ) ⟶
      Do.Φ.obj (Limits.kernel (wcSuppUnitMap D)),
      ε ≫ Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)) = Do.μ.inv := by
    obtain ⟨ε0, hε0⟩ := Limits.KernelFork.IsLimit.lift'
      (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcSuppUnitMap D)) Do.Φ)
      Do.μ.inv hkey
    exact ⟨ε0, hε0⟩
  haveI hmonoΦι : Mono (Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D))) := inferInstance
  have h1 : ε ≫ (Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)) ≫ Do.μ.hom) = 𝟙 _ := by
    rw [← Category.assoc, hε, Iso.inv_hom_id]
  have h2 : (Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)) ≫ Do.μ.hom) ≫ ε = 𝟙 _ := by
    rw [← cancel_mono (Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)))]
    simp only [Category.assoc, hε, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
  haveI hεiso : IsIso ε := ⟨⟨_, h1, h2⟩⟩
  let Vo : Y.ProEt := Scheme.ProEt.mk O.ι
  haveI hVo : IsOpenImmersion Vo.hom := (inferInstance : IsOpenImmersion O.ι)
  haveI hG : (wcSliceFunctor Y Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
      (Scheme.ProEt.topology Y) := by
    haveI h1' := (wc_slice_over_sites_cont Y Vo).1
    haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology Y).over Vo)
        (Scheme.ProEt.topology Y) := inferInstance
    have h3 : (wcSliceToOver Y Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology Y) :=
      Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology Y).over Vo) _
    exact h3
  have hVorange : Set.range Vo.hom = (Set.range i)ᶜ := by
    show Set.range O.ι = _
    rw [Scheme.Opens.range_ι, hO]
  obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso Y ℓ Vo Do hDo

  have fin_covers : ∀ (U : Y.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → Y.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology Y U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have affine_local : ∀ (U : Y.ProEt) (T' : Sieve U),
      (∀ (V' : Y.ProEt) (f : V' ⟶ U), IsAffine V'.left →
        T'.pullback f ∈ Scheme.ProEt.topology Y V') →
      T' ∈ Scheme.ProEt.topology Y U := by
    intro U T' hT
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → Y.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i =>
      MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage Y).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T' ?_
    intro Y₀ f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
  have hcov : ∀ (U : Y.ProEt) (k : (Limits.kernel (wcSuppUnitMap D)).val.obj (Opposite.op U))
      (R : Sieve U), (∀ (U' : Y.ProEt) (a : U' ⟶ U),
        ((∀ x : ↥U'.left, U'.hom x ∉ Set.range i) ∨
          ((Limits.kernel (wcSuppUnitMap D)).val.map a.op).hom k = 0) → R.arrows a) →
      R ∈ Scheme.ProEt.topology Y U := by
    intro U k R hR
    apply affine_local U R
    intro W' g hW'
    obtain ⟨n, W'', e, haff, hsurj, hdis⟩ := hker U k W' g hW'
    haveI : IsAffine W'.left := hW'
    refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W' n W'' e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨m⟩
    exact hR _ _ (hdis m)

  have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      Function.Bijective (fun φ : Limits.kernel (wcSuppUnitMap D) ⟶ N => ε ≫ Do.Φ.map φ) := by
    intro N
    obtain ⟨hinj, hsurj⟩ := wc_supp_kernel_open_res_bijective i D Vo hVorange hcov N
    have e : ∀ φ : Limits.kernel (wcSuppUnitMap D) ⟶ N, (wcSliceRes Y ℓ Vo).map φ =
        Φiso.inv.app _ ≫ Do.Φ.map φ ≫ Φiso.hom.app N :=
      fun φ => (NatIso.naturality_1 Φiso φ).symm
    refine ⟨fun φ₁ φ₂ h => hinj ?_, fun g => ?_⟩
    · have h' : Do.Φ.map φ₁ = Do.Φ.map φ₂ := (cancel_epi ε).mp h
      show (wcSliceRes Y ℓ Vo).map φ₁ = (wcSliceRes Y ℓ Vo).map φ₂
      rw [e, e, h']
    · obtain ⟨φ, hφ⟩ := hsurj (Φiso.inv.app _ ≫
        ((Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)) ≫ Do.μ.hom) ≫ g) ≫ Φiso.hom.app N)
      refine ⟨φ, ?_⟩
      have hφ' : (wcSliceRes Y ℓ Vo).map φ = Φiso.inv.app _ ≫
          ((Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)) ≫ Do.μ.hom) ≫ g) ≫
            Φiso.hom.app N := hφ
      have k0 := (e φ).symm.trans hφ'
      have k : Do.Φ.map φ =
          (Do.Φ.map (Limits.kernel.ι (wcSuppUnitMap D)) ≫ Do.μ.hom) ≫ g :=
        (cancel_mono (Φiso.hom.app N)).mp ((cancel_epi (Φiso.inv.app _)).mp k0)
      show ε ≫ Do.Φ.map φ = g
      rw [k, ← Category.assoc, h1, Category.id_comp]
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf O.toScheme ℓ)) (Do.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have hRI : Injective ((wcSliceRes Y ℓ Vo).obj I) :=
      @wc_open_slice_res_preserves_injective Y ℓ _ Vo hVo hG I hI
    haveI : Injective (Do.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  have hT := ext_transfer_of_corep Do.Φ (Limits.kernel (wcSuppUnitMap D))
    (SheafOfModules.unit (wcRingSheaf O.toScheme ℓ)) ε hhom hvan
    (SheafOfModules.unit (wcRingSheaf Y ℓ)) q
  have hP : Function.Bijective
      (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf O.toScheme ℓ))
          (Do.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ))) q =>
        x.comp (Abelian.Ext.mk₀ Do.μ.hom) (add_zero q)) := by
    refine ⟨fun x y h => ?_, fun y => ⟨y.comp (Abelian.Ext.mk₀ Do.μ.inv) (add_zero q), ?_⟩⟩
    · have h' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ Do.μ.inv) (add_zero q)) h
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at h'
      exact h'
    · simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  have h10 : 1 + q = q + 1 := by omega
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcSuppUnitMap D)) (wcSuppUnitMap D)
      (Limits.kernel.condition (wcSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcSuppUnitMap D)) inferInstance hepi
  let Ψh : Abelian.Ext (Limits.kernel (wcSuppUnitMap D)) (SheafOfModules.unit (wcRingSheaf Y ℓ)) q →+
      wcHM O.toScheme ℓ q :=
    ((Abelian.Ext.mk₀ ε).precomp _ (zero_add q)).comp
      (((Abelian.Ext.mk₀ Do.μ.hom).postcomp _ (add_zero q)).comp (Do.Φ.mapExtAddHom _ _ q))
  have hΨb : Function.Bijective Ψh := by
    show Function.Bijective _
    convert hP.comp hT using 1
    funext x
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  let Ψe := AddEquiv.ofBijective Ψh hΨb
  have hfree : ∀ x : wcHM Y ℓ q,
      Ψe ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap D))).comp x (zero_add q)) =
        wcHMPull Do q x := by
    intro x
    show (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ
        ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap D))).comp x (zero_add q))).comp
        (Abelian.Ext.mk₀ Do.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ Do.μ.inv).comp ((Abelian.Ext.mapExactFunctor Do.Φ x).comp
        (Abelian.Ext.mk₀ Do.μ.hom) (add_zero q)) (zero_add q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← hε, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero]

  intro α
  have hz : hS.extClass.comp (Ψe.symm α) h10 = 0 := hv _
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS
    (SheafOfModules.unit (wcRingSheaf Y ℓ)) (Ψe.symm α) h10 hz
  refine ⟨x₂, ?_⟩
  rw [← hfree x₂]
  have hx₂' : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap D))).comp x₂ (zero_add q) =
      Ψe.symm α := hx₂
  rw [hx₂', AddEquiv.apply_symm_apply]

theorem wc_qcl_supp_class_inj_of_open_vanish {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (O : Y.Opens) (hO : (O : Set ↥Y) = (Set.range i)ᶜ) (q : ℕ)
    (Do : wcHMPullData O.ι ℓ) (hDo : wcHMPullCanonical Do)
    (hv : ∀ x : wcHM (O : Scheme.{u}) ℓ q, x = 0) :
    ∀ θ : wcSuppExt D (q + 1), wcSuppClass D (q + 1) θ = 0 → θ = 0 :=
by
  intro θ hθ
  have hepi := wc_supp_unit_epi_of_closed i ℓ D hD
  obtain ⟨δ, hδ, -⟩ := wc_supp_les_open_boundary i D hD hepi
    (fun U k W g hW => wc_supp_kernel_section_local_cover i D hD U k W g hW) O hO Do hDo
    q (q + 1) rfl
  obtain ⟨α, hα⟩ := hδ θ hθ
  rw [hv α, map_zero] at hα
  exact hα.symm

theorem wc_qcl_odd_open_vanish (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (e : ℕ) (he : 1 ≤ e)
    (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (Uodd : (Oh : Scheme.{u}).Opens)
    (hU : ∀ y : ↥(Oh : Scheme.{u}), y ∈ Uodd ↔ ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
          (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
          (Oh.ι y).asIdeal) :
    ∀ x : wcHM (Uodd : Scheme.{u}) ℓ (4 * e), x = 0 :=
by
  classical
  have hE1 := wc_hyp_quad_cone_even_open_coh_equiv K ℓ hℓ e
  revert Oh hOh Uodd hU hE1
  generalize hMAT : (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) = MAT
  intro Oh hOh Uodd hU hE1
  have hMATpq : ∀ p q : Fin (2 * e + 1 + 1),
      MAT p q = if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 := by
    intro p q; rw [← hMAT]; rfl
  have hSpecI : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B) (y : Spec (.of B)),
      (Spec.map (CommRingCat.ofHom f) y).asIdeal = Ideal.comap f y.asIdeal := by
    intro A B _ _ f y
    rw [Spec.map_apply]
    rfl

  have hsurjc : Function.Surjective
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K) :=
    fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩
  haveI hcc : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))) :=
    IsClosedImmersion.spec_of_surjective _ hsurjc
  obtain ⟨W, hW⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens,
      (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ :=
    ⟨⟨_, (Scheme.Hom.isClosedEmbedding _).isClosed_range.isOpen_compl⟩, rfl⟩
  have hE : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
      {x | ∃ j : Fin (e + 1), j.val < e + 1 ∧
        (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) K) ∉ x.asIdeal} := by
    rw [hW]
    ext x
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff K (e + 1) x, not_forall]
    exact ⟨fun ⟨j, hj⟩ => ⟨j, j.isLt, hj⟩, fun ⟨j, _, hj⟩ => ⟨j, hj⟩⟩
  have hW0 : Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ (4 * e)) :=
    wc_et_affine_partial_punct_vanishing K ℓ Fact.out hℓ (e + 1) (e + 1) le_rfl W hE (4 * e)
      (by omega)

  obtain ⟨Ou, hOu⟩ : ∃ Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT))).Opens,
      (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)))) =
        {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
            y.asIdeal} := by
    have heq : {y : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) | ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
            y.asIdeal} =
        (PrimeSpectrum.zeroLocus (Set.range fun k : Fin (e + 1) =>
          Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
            (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))))ᶜ := by
      ext y
      constructor
      · rintro ⟨k, hk⟩ h
        exact hk ((PrimeSpectrum.mem_zeroLocus _ _).mp h ⟨k, rfl⟩)
      · intro h
        by_contra hc
        apply h
        refine (PrimeSpectrum.mem_zeroLocus _ _).mpr ?_
        rintro _ ⟨k, rfl⟩
        by_contra hk
        exact hc ⟨k, hk⟩
    exact ⟨⟨{y : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) | ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
            y.asIdeal}, by rw [heq]; exact (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl⟩, rfl⟩
  obtain ⟨eq1⟩ := hE1 Ou hOu W hW (4 * e)
  have hOu0 : Subsingleton (wcEtCoh (Ou : Scheme.{u}) ℓ (4 * e)) := by
    haveI := hW0
    exact eq1.subsingleton

  obtain ⟨τ, hτ⟩ : ∃ τ : Fin (2 * e + 1 + 1) → Fin (2 * e + 1 + 1),
      ∀ p, (τ p).val = if p.val % 2 = 0 then p.val + 1 else p.val - 1 :=
    ⟨fun p => ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, by
      have := p.isLt; split_ifs <;> omega⟩, fun p => rfl⟩
  have hττ : ∀ p, τ (τ p) = p := by
    intro p
