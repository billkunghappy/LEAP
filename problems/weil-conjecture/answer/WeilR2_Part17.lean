      rw [← hχ, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      have hhom : (g ≫ wcIntFun V.left ℓ χ.toContinuousMap) ≫
          Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) = 0 := by
        rw [← cancel_epi (wcIntSuppπ DV), Limits.comp_zero, ← Category.assoc, ← Category.assoc,
          hε, hfac, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
