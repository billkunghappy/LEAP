  exact hres h1

theorem wc_pmn_sfu_cw_punct_restr_nonzero {S Z : Scheme.{u}} (iS : Z ⟶ S) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Vt : S.ProEt) (K : Type u) [Field K] (m q : ℕ)
    (ψ : Vt.left ⟶ Spec (.of (MvPolynomial (Fin m) K)))
    (U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens) (ω : wcHM U₀.toScheme ℓ q)
    (hω : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
        [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec (.of R) ⟶ Spec (.of (MvPolynomial (Fin m) K))), WeaklyEtale k →
        k (IsLocalRing.closedPoint R) =
          Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))
            (IsLocalRing.closedPoint K) →
        ∀ (T : Scheme.{u}) (jT : T ⟶ Spec (.of R)) (kT : T ⟶ U₀.toScheme),
          IsPullback kT jT U₀.ι k →
          ∀ DT : wcHMPullData kT ℓ, wcHMPullCanonical DT → wcHMPull DT q ω ≠ 0)
    (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (σ : Spec (.of R) ⟶ Limits.pullback Vt.hom iS)
    (hσ : WeaklyEtale (σ ≫ Limits.pullback.fst Vt.hom iS ≫ ψ))
    (hσ0 : (σ ≫ Limits.pullback.fst Vt.hom iS ≫ ψ) (IsLocalRing.closedPoint R) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))
        (IsLocalRing.closedPoint K)) :
    ∃ z : wcHM (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).left ℓ q,
      ∀ Dg : wcHMPullData (Limits.pullback.fst (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom iS) ℓ,
        wcHMPullCanonical Dg → wcHMPull Dg q z ≠ 0 :=
by
  classical

  have hR : IsPullback (ψ ∣_ U₀) (ψ ⁻¹ᵁ U₀).ι U₀.ι ψ := isPullback_morphismRestrict ψ U₀
  obtain ⟨Dψ, hDψ⟩ := wc_hm_pull_data_exists (ψ ∣_ U₀) ℓ
  refine ⟨wcHMPull Dψ q ω, ?_⟩
  intro Dg hDg hz

  set k : Spec (.of R) ⟶ Spec (.of (MvPolynomial (Fin m) K)) :=
    σ ≫ Limits.pullback.fst Vt.hom iS ≫ ψ with hk
  have hT : IsPullback (Limits.pullback.fst U₀.ι k) (Limits.pullback.snd U₀.ι k) U₀.ι k :=
    IsPullback.of_hasPullback U₀.ι k
  set kT := Limits.pullback.fst U₀.ι k with hkT
  set jT := Limits.pullback.snd U₀.ι k with hjT
  have hC1 : kT ≫ U₀.ι = (jT ≫ σ ≫ Limits.pullback.fst Vt.hom iS) ≫ ψ := by
    rw [hkT, hjT, Limits.pullback.condition]
    simp only [hk, Category.assoc]
  let a : Limits.pullback U₀.ι k ⟶ (ψ ⁻¹ᵁ U₀).toScheme := hR.lift kT _ hC1
  have hA1 : a ≫ (ψ ∣_ U₀) = kT := hR.lift_fst _ _ _
  have hA2 : a ≫ (ψ ⁻¹ᵁ U₀).ι = jT ≫ σ ≫ Limits.pullback.fst Vt.hom iS := hR.lift_snd _ _ _
  have hw : a ≫ (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom = (jT ≫ σ ≫ Limits.pullback.snd Vt.hom iS) ≫ iS := by
    show a ≫ ((ψ ⁻¹ᵁ U₀).ι ≫ Vt.hom) = _
    rw [← Category.assoc, hA2]
    simp only [Category.assoc, Limits.pullback.condition]
  let t : Limits.pullback U₀.ι k ⟶ Limits.pullback (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom iS :=
    Limits.pullback.lift a _ hw
  have hT1 : t ≫ Limits.pullback.fst (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom iS = a :=
    Limits.pullback.lift_fst _ _ _
  have hT2 : t ≫ (Limits.pullback.fst (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom iS ≫ (ψ ∣_ U₀)) = kT :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (fun x : Limits.pullback U₀.ι k ⟶ (ψ ⁻¹ᵁ U₀).toScheme => x ≫ (ψ ∣_ U₀)) hT1).trans
        hA1)
  obtain ⟨Dc, hDc⟩ := wc_hm_pull_data_exists
    (Limits.pullback.fst (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom iS ≫ (ψ ∣_ U₀)) ℓ
  obtain ⟨Dt, hDt⟩ := wc_hm_pull_data_exists t ℓ
  obtain ⟨DkT, hDkT⟩ := wc_hm_pull_data_exists kT ℓ
  have E1 := wc_hm_pull_comp (ψ ∣_ U₀) (Limits.pullback.fst (wcVRes S Vt (ψ ⁻¹ᵁ U₀)).hom iS)
    _ rfl Dψ hDψ Dg hDg Dc hDc q ω
  have E2 := wc_hm_pull_comp _ t kT hT2 Dc hDc Dt hDt DkT hDkT q ω
  have h0 : wcHMPull DkT q ω = 0 :=
    E2.trans ((congrArg (wcHMPull Dt q) (E1.trans hz)).trans (map_zero _))
  exact hω R k hσ hσ0 _ jT kT hT DkT hDkT h0

theorem wc_pmn_cw_total_kummer_witness (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
