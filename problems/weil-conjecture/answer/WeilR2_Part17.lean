    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists ((wcProEtBC V.ι).obj W').hom ℓ
    obtain ⟨Θ, -⟩ := wc_proet_free_slice_module_ext (V : Scheme.{u}) ℓ
