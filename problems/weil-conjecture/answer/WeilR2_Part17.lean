theorem wc_tla_shens_noeth_unram : ∀ (C A : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C] [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (θ : C →+* A), IsLocalHom θ → @Algebra.WeaklyEtale C A _ _ θ.toAlgebra → IsNoetherianRing A ∧ Ideal.map θ (IsLocalRing.maximalIdeal C) = IsLocalRing.maximalIdeal A :=
by
  intro C A _ _ _ _ _ _ θ hloc hW

  have hmap : Ideal.map θ (IsLocalRing.maximalIdeal C) = IsLocalRing.maximalIdeal A := by
    letI := θ.toAlgebra
    haveI := hW
    have hIle : Ideal.map θ (IsLocalRing.maximalIdeal C) ≤ IsLocalRing.maximalIdeal A := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact ((IsLocalRing.mem_maximalIdeal _).mp hx) (isUnit_of_map_unit θ x hu)
    refine le_antisymm hIle ?_
    intro a ha
    letI : Field (C ⧸ IsLocalRing.maximalIdeal C) := Ideal.Quotient.field _
    let S₀ := TensorProduct C (C ⧸ IsLocalRing.maximalIdeal C) A
    haveI hWk : Algebra.WeaklyEtale (C ⧸ IsLocalRing.maximalIdeal C) S₀ := inferInstance
    let Φ : (A ⧸ Ideal.map (algebraMap C A) (IsLocalRing.maximalIdeal C)) ≃+* S₀ :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (IsLocalRing.maximalIdeal C)).toRingEquiv.trans
        (Algebra.TensorProduct.comm C A (C ⧸ IsLocalRing.maximalIdeal C)).toRingEquiv
    set s : S₀ := Φ (Ideal.Quotient.mk _ a) with hs
    have key : ∀ (k S : Type u) [Field k] [CommRing S] [Algebra k S], Algebra.WeaklyEtale k S →
        ∀ s : S, ∃ c : S, s * (c * s) = s := by
      intro k S _ _ _ hkS s
      haveI : Module.Free k (S ⧸ Ideal.span {s}) := Module.Free.of_divisionRing _ _
      have hflat : Module.Flat S (S ⧸ Ideal.span {s}) :=
        wc_weaklyEtale_flat_transfer k S hkS (S ⧸ Ideal.span {s}) (Module.Flat.of_free)
      obtain ⟨z, hz, hsz⟩ :=
        wc_flat_quot_absorb S (Ideal.span {s}) hflat s (Ideal.mem_span_singleton_self s)
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      exact ⟨c, hsz⟩
    obtain ⟨c, hsz⟩ := key _ S₀ hWk s
    obtain ⟨c', hc'⟩ := Ideal.Quotient.mk_surjective (Φ.symm c)
    have e1 : Φ.symm (s * (c * s)) = Φ.symm s := by rw [hsz]
    rw [map_mul, map_mul, hs, RingEquiv.symm_apply_apply, ← hc', ← map_mul, ← map_mul,
      Ideal.Quotient.eq] at e1
    have hu : IsUnit (1 - c' * a) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
        ((IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_left _ c' ha))
    have e2 : a = (a * (c' * a) - a) * ↑(-hu.unit)⁻¹ := by
      rw [show a * (c' * a) - a = a * (-(1 - c' * a)) by ring]
      rw [show (-(1 - c' * a) : A) = ↑(-hu.unit) by simp, mul_assoc, Units.mul_inv, mul_one]
    rw [e2]
    exact Ideal.mul_mem_right _ _ e1
  refine ⟨?_, hmap⟩

  have happrox : ∀ (n : ℕ) (a : Fin n → A), ∃ (B : Type u) (_ : CommRing B) (_ : IsLocalRing B)
      (_ : IsNoetherianRing B) (γ : B →+* A), IsLocalHom γ ∧ γ.Flat ∧
      Ideal.map γ (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A ∧
      ∃ b : Fin n → B, ∀ i, γ (b i) = a i := by
    intro n a
    obtain ⟨E, _, _, hEt, β, e, hβ, he⟩ := wc_lpkt_indetale_factor C A θ hW n a
    set q : Ideal E := Ideal.comap β (IsLocalRing.maximalIdeal A) with hq
    haveI : q.IsPrime := Ideal.comap_isPrime β _
    haveI : Algebra.FiniteType C E := inferInstance
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing C E
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
    have hunit : ∀ s : q.primeCompl, IsUnit (β s) := by
      intro s
      have h : (s : E) ∉ q := s.prop
      exact IsLocalRing.notMem_maximalIdeal.mp h
    let γ : Localization.AtPrime q →+* A :=
      IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit
    have hγβ' : ∀ x, γ (algebraMap E (Localization.AtPrime q) x) = β x := fun x =>
      IsLocalization.lift_eq hunit x
    have hmB : Ideal.map (algebraMap E (Localization.AtPrime q)) q =
        IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      IsLocalization.AtPrime.map_eq_maximalIdeal q (Localization.AtPrime q)
    have hγle : Ideal.map γ (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ≤
        IsLocalRing.maximalIdeal A := by
      rw [← hmB, Ideal.map_map]
      have : γ.comp (algebraMap E (Localization.AtPrime q)) = β := RingHom.ext hγβ'
      rw [this, hq]
      exact Ideal.map_comap_le
    have hγloc : IsLocalHom γ := by
      constructor
      intro y hy
      by_contra hn
      have hy' : y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        (IsLocalRing.mem_maximalIdeal _).mpr hn
      have := hγle (Ideal.mem_map_of_mem γ hy')
      exact (IsLocalRing.mem_maximalIdeal _).mp this hy
    refine ⟨Localization.AtPrime q, inferInstance, inferInstance, inferInstance, γ, hγloc, ?_, ?_,
      fun i => algebraMap E (Localization.AtPrime q) (e i), fun i => by rw [hγβ', he]⟩
    · haveI hCE : Algebra.WeaklyEtale C E := Algebra.WeaklyEtale.instOfEtale
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime q) :=
        wc_localization_weaklyEtale E _ q.primeCompl
      haveI : Algebra.WeaklyEtale C (Localization.AtPrime q) :=
        Algebra.WeaklyEtale.trans C E (Localization.AtPrime q)
      letI := θ.toAlgebra
      letI := γ.toAlgebra
      haveI : IsScalarTower C (Localization.AtPrime q) A := by
        apply IsScalarTower.of_algebraMap_eq
        intro c
        change θ c = γ (algebraMap C (Localization.AtPrime q) c)
        rw [IsScalarTower.algebraMap_apply C E (Localization.AtPrime q), hγβ', ← hβ]
        rfl
      have hWB := wc_weaklyEtale_cancel C (Localization.AtPrime q) A inferInstance hW
      exact RingHom.flat_algebraMap_iff.mpr hWB.flat
    · apply le_antisymm hγle
      rw [← hmap]
      have hι : γ.comp (algebraMap C (Localization.AtPrime q)) = θ := by
        ext c
        rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply C E (Localization.AtPrime q),
          hγβ', ← hβ]
        rfl
      rw [← hι, ← Ideal.map_map]
      apply Ideal.map_mono
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' : IsUnit (θ c) := by rw [← hι]; exact hu.map γ
      exact (IsLocalRing.mem_maximalIdeal _).mp hc (isUnit_of_map_unit θ c hu')

  have hclosed : ∀ (n : ℕ) (g : Fin n → A) (x : A),
      (∀ k : ℕ, x ∈ Ideal.span (Set.range g) ⊔ IsLocalRing.maximalIdeal A ^ k) →
      x ∈ Ideal.span (Set.range g) := by
    intro n g x hx
    obtain ⟨B, _, _, _, γ, hγloc, hγflat, hγmap, b, hb⟩ :=
      happrox (n + 1) (Fin.snoc g x : Fin (n + 1) → A)
    letI := γ.toAlgebra
    haveI : IsLocalHom (algebraMap B A) := hγloc
    haveI : Module.Flat B A := RingHom.flat_algebraMap_iff.mp hγflat
    haveI : Module.FaithfullyFlat B A := Module.FaithfullyFlat.of_flat_of_isLocalHom
    set bg : Fin n → B := fun i => b (Fin.castSucc i) with hbgdef
    have hbg : ∀ i, γ (bg i) = g i := fun i => by simp only [hbgdef, hb, Fin.snoc_castSucc]
    set y : B := b (Fin.last n) with hydef
    have hy : γ y = x := by simp only [hydef, hb, Fin.snoc_last]
    have himg : (γ : B → A) '' Set.range bg = Set.range g := by
      rw [← Set.range_comp]; congr 1; funext i; exact hbg i
    have hyk : ∀ k : ℕ, y ∈ Ideal.span (Set.range bg) ⊔ IsLocalRing.maximalIdeal B ^ k := by
      intro k
      have hmapK : Ideal.map (algebraMap B A)
          (Ideal.span (Set.range bg) ⊔ IsLocalRing.maximalIdeal B ^ k)
          = Ideal.span (Set.range g) ⊔ IsLocalRing.maximalIdeal A ^ k := by
        rw [Ideal.map_sup, Ideal.map_span, Ideal.map_pow]
        change Ideal.span ((γ : B → A) '' Set.range bg) ⊔
          Ideal.map γ (IsLocalRing.maximalIdeal B) ^ k = _
        rw [himg, hγmap]
      rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (A := B) (B := A)
        (Ideal.span (Set.range bg) ⊔ IsLocalRing.maximalIdeal B ^ k), Ideal.mem_comap, hmapK]
      change γ y ∈ _
      rw [hy]; exact hx k
    have hyI : y ∈ Ideal.span (Set.range bg) := by
      have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (R := B)
        (M := B ⧸ Ideal.span (Set.range bg))
        (IsLocalRing.maximalIdeal B) (IsLocalRing.maximalIdeal.isMaximal B).ne_top
      have hmem : (Ideal.Quotient.mk (Ideal.span (Set.range bg)) y) ∈
          (⨅ i : ℕ, IsLocalRing.maximalIdeal B ^ i •
            (⊤ : Submodule B (B ⧸ Ideal.span (Set.range bg)))) := by
        rw [Submodule.mem_iInf]
        intro k
        obtain ⟨i, hi, z, hz, hiz⟩ := Submodule.mem_sup.mp (hyk k)
        have : Ideal.Quotient.mk (Ideal.span (Set.range bg)) y =
            z • Ideal.Quotient.mk (Ideal.span (Set.range bg)) 1 := by
          rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul, mul_one,
            Ideal.Quotient.eq, ← hiz]
          simpa using hi
        rw [this]
        exact Submodule.smul_mem_smul hz Submodule.mem_top
      rw [hK, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at hmem
      exact hmem
    have := Ideal.mem_map_of_mem γ hyI
    rw [Ideal.map_span, himg, hy] at this
    exact this

  have s6a : ∀ (R : Type u) [CommRing R] (n : ℕ) (H F : MvPolynomial (Fin n) R) (e d : ℕ),
      F.IsHomogeneous e → MvPolynomial.homogeneousComponent d (H * F) =
        if e ≤ d then MvPolynomial.homogeneousComponent (d - e) H * F else 0 := by
    intro R _ n H F e d hF
    classical
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent H]
    rw [Finset.sum_mul, map_sum]
    have hterm : ∀ j ∈ Finset.range (H.totalDegree + 1),
        MvPolynomial.homogeneousComponent d (MvPolynomial.homogeneousComponent j H * F) =
          if j = d - e ∧ e ≤ d then MvPolynomial.homogeneousComponent j H * F else 0 := by
      intro j _
      have hm : MvPolynomial.homogeneousComponent j H * F ∈
          MvPolynomial.homogeneousSubmodule (Fin n) R (j + e) :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          ((MvPolynomial.homogeneousComponent_isHomogeneous j H).mul hF)
      rw [MvPolynomial.homogeneousComponent_of_mem hm]
      by_cases h : d = j + e
      · rw [if_pos h, if_pos ⟨by omega, by omega⟩]
      · rw [if_neg h, if_neg (by omega)]
    rw [Finset.sum_congr rfl hterm]
    by_cases hed : e ≤ d
    · simp only [hed, and_true, if_true]
      rw [Finset.sum_ite_eq']
      split_ifs with hmem
      · rfl
      · rw [MvPolynomial.homogeneousComponent_eq_zero, zero_mul]
        simp only [Finset.mem_range, not_lt] at hmem
        omega
    · simp [hed]

  have s6bi : ∀ (n : ℕ) (t : Fin n → A) (d : ℕ) (y : A),
      y ∈ Ideal.span (Set.range t) ^ d →
        ∃ P : MvPolynomial (Fin n) A, P.IsHomogeneous d ∧ MvPolynomial.eval t P = y := by
    intro n t d
    induction d with
    | zero =>
      intro y _
      exact ⟨MvPolynomial.C y, MvPolynomial.isHomogeneous_C _ y, MvPolynomial.eval_C y⟩
    | succ d ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro u hu v hv
        obtain ⟨P, hP, hPu⟩ := ih u hu
        obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hv
        refine ⟨P * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
        · apply hP.mul
          apply MvPolynomial.IsHomogeneous.sum
          intro i _
          simpa using (MvPolynomial.isHomogeneous_C (Fin n) (c i)).mul
            (MvPolynomial.isHomogeneous_X A i)
        · simp [hPu, ← hc]
      · rintro a b ⟨P, hP, rfl⟩ ⟨Q, hQ, rfl⟩
        exact ⟨P + Q, hP.add hQ, by simp⟩

  have s6bii : ∀ (n : ℕ) (t : Fin n → A) (K : Ideal A) (d : ℕ)
      (P : MvPolynomial (Fin n) A), P.IsHomogeneous d → (∀ α, P.coeff α ∈ K) →
        MvPolynomial.eval t P ∈ K * Ideal.span (Set.range t) ^ d := by
    intro n t K d P hP hK
    classical
    rw [MvPolynomial.eval_eq]
    apply Ideal.sum_mem
    intro α hα
    apply Ideal.mul_mem_mul (hK α)
    have hdeg : ∑ i ∈ α.support, α i = d := by
      by_contra hne
      apply (MvPolynomial.mem_support_iff.mp hα)
      apply hP.coeff_eq_zero
      exact fun h => hne (by rw [← h]; rfl)
    rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
    apply Ideal.prod_mem_prod
    intro i _
    exact Ideal.pow_mem_pow
      (Ideal.subset_span (Set.mem_range_self i) : t i ∈ Ideal.span (Set.range t)) _

  have hfg : (IsLocalRing.maximalIdeal A).FG := by
    rw [← hmap]
    exact ((isNoetherianRing_iff_ideal_fg C).mp inferInstance _).map θ

  have hinit : ∀ J : Ideal A, ∃ (r : ℕ) (g : Fin r → A), (∀ i, g i ∈ J) ∧
      ∀ (d : ℕ) (x : A), x ∈ J → x ∈ IsLocalRing.maximalIdeal A ^ d →
        x ∈ Ideal.span (Set.range g) ⊔ (J ⊓ IsLocalRing.maximalIdeal A ^ (d + 1)) := by
    intro J
    classical
    obtain ⟨n, t, ht⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hm : Ideal.span (Set.range t) = IsLocalRing.maximalIdeal A := ht
    set π : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) (IsLocalRing.ResidueField A) :=
      MvPolynomial.map (IsLocalRing.residue A) with hπ
    set Sig : Set (MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) :=
      {Q | ∃ (d : ℕ) (P : MvPolynomial (Fin n) A), P.IsHomogeneous d ∧
        MvPolynomial.eval t P ∈ J ∧ π P = Q} with hSig
    have hfgS : (Ideal.span Sig).FG := (isNoetherianRing_iff_ideal_fg _).mp inferInstance _
    obtain ⟨s', hs'sub, hs'span⟩ := (Submodule.fg_span_iff_fg_span_finset_subset Sig).mp hfgS
    set r := s'.card with hr
    let eqv := s'.equivFin
    set q : Fin r → MvPolynomial (Fin n) (IsLocalRing.ResidueField A) :=
      fun j => ((eqv.symm j : s') : MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) with hqdef
    have hqS : ∀ j, ∃ (d : ℕ) (P : MvPolynomial (Fin n) A), P.IsHomogeneous d ∧
        MvPolynomial.eval t P ∈ J ∧ π P = q j := fun j => hs'sub (eqv.symm j).prop
    choose dj Pj hPj hPJ hπP using hqS
    have hrange : Set.range q = (s' : Set _) := by
      ext y
      constructor
      · rintro ⟨j, rfl⟩; exact (eqv.symm j).prop
      · intro hy; exact ⟨eqv ⟨y, hy⟩, by simp [hqdef]⟩
    have hspanq : Ideal.span Sig = Ideal.span (Set.range q) := by
      rw [hrange]; exact hs'span
    have hπhom : ∀ (k : ℕ) (Q : MvPolynomial (Fin n) A),
        π (MvPolynomial.homogeneousComponent k Q) =
          MvPolynomial.homogeneousComponent k (π Q) := by
      intro k Q
      ext α
      rw [hπ, MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent,
        MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_map]
      split_ifs <;> simp
    refine ⟨r, fun j => MvPolynomial.eval t (Pj j), hPJ, ?_⟩
    intro d x hxJ hxm
    rw [← hm] at hxm
    obtain ⟨P, hP, hPx⟩ := s6bi n t d x hxm
    have hπPS : π P ∈ Ideal.span (Set.range q) := by
      rw [← hspanq]
      exact Ideal.subset_span ⟨d, P, hP, hPx ▸ hxJ, rfl⟩
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hπPS
    have hπPhom : (π P).IsHomogeneous d := hP.map _
    have hcomp : π P = ∑ j, (if dj j ≤ d then
        MvPolynomial.homogeneousComponent (d - dj j) (c j) * q j else 0) := by
      have h1 : MvPolynomial.homogeneousComponent d (π P) = π P := by
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hπPhom), if_pos rfl]
      rw [← h1, ← hc, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      apply s6a
      rw [← hπP j]
      exact (hPj j).map _
    choose Q' hQ' using fun j => MvPolynomial.map_surjective (σ := Fin n)
      (IsLocalRing.residue A) IsLocalRing.residue_surjective (c j)
    set Qj : Fin r → MvPolynomial (Fin n) A := fun j =>
      if dj j ≤ d then MvPolynomial.homogeneousComponent (d - dj j) (Q' j) else 0 with hQjdef
    set D := P - ∑ j, Qj j * Pj j with hD
    have hDhom : D.IsHomogeneous d := by
      apply hP.sub
      apply MvPolynomial.IsHomogeneous.sum
      intro j _
      simp only [hQjdef]
      split_ifs with h
      · have := (MvPolynomial.homogeneousComponent_isHomogeneous (d - dj j) (Q' j)).mul (hPj j)
        rwa [Nat.sub_add_cancel h] at this
      · rw [zero_mul]; exact MvPolynomial.isHomogeneous_zero _ _ _
    have hπD : π D = 0 := by
      rw [hD, map_sub, map_sum, sub_eq_zero, hcomp]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hπP j]
      simp only [hQjdef]
      split_ifs with h
      · rw [hπhom, hπ, hQ' j]
      · rw [map_zero, zero_mul]
    have hDcoeff : ∀ α, D.coeff α ∈ IsLocalRing.maximalIdeal A := by
      intro α
      rw [← IsLocalRing.residue_eq_zero_iff]
      have := congrArg
        (fun F : MvPolynomial (Fin n) (IsLocalRing.ResidueField A) => F.coeff α) hπD
      simpa [hπ, MvPolynomial.coeff_map] using this
    have hDm : MvPolynomial.eval t D ∈ IsLocalRing.maximalIdeal A ^ (d + 1) := by
      have := s6bii n t (IsLocalRing.maximalIdeal A) d D hDhom hDcoeff
      rwa [hm, ← pow_succ'] at this
    have hDeval : MvPolynomial.eval t D =
        x - ∑ j, MvPolynomial.eval t (Qj j) * MvPolynomial.eval t (Pj j) := by
      rw [hD, map_sub, map_sum, hPx]
      simp only [map_mul]
    have hsumg : ∑ j, MvPolynomial.eval t (Qj j) * MvPolynomial.eval t (Pj j) ∈
        Ideal.span (Set.range fun j => MvPolynomial.eval t (Pj j)) := by
      apply Ideal.sum_mem
      intro j _
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    have hDJ : MvPolynomial.eval t D ∈ J := by
      rw [hDeval]
      apply J.sub_mem hxJ
      apply Ideal.sum_mem
      intro j _
      exact Ideal.mul_mem_left _ _ (hPJ j)
    have hx : x = ∑ j, MvPolynomial.eval t (Qj j) * MvPolynomial.eval t (Pj j) +
        MvPolynomial.eval t D := by
      rw [hDeval]; ring
    rw [hx]
    exact Ideal.add_mem _ (Ideal.mem_sup_left hsumg)
      (Ideal.mem_sup_right (Submodule.mem_inf.mpr ⟨hDJ, hDm⟩))

  rw [isNoetherianRing_iff_ideal_fg]
  intro J
  obtain ⟨r, g, hgJ, hstep⟩ := hinit J
  have hclaim : ∀ d : ℕ, ∀ x ∈ J,
      x ∈ Ideal.span (Set.range g) ⊔ (J ⊓ IsLocalRing.maximalIdeal A ^ d) := by
    intro d
    induction d with
    | zero =>
      intro x hx
      apply Ideal.mem_sup_right
      exact Submodule.mem_inf.mpr ⟨hx, by simp⟩
    | succ d ih =>
      intro x hx
      obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.mp (ih x hx)
      have hj' := hstep d j (Submodule.mem_inf.mp hj).1 (Submodule.mem_inf.mp hj).2
      exact Ideal.add_mem _ (Ideal.mem_sup_left hi) hj'
  have hJ : J = Ideal.span (Set.range g) := by
    apply le_antisymm
    · intro x hx
      apply hclosed r g x
      intro k
      obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.mp (hclaim k x hx)
      rw [← hij]
      exact Ideal.add_mem _ (Ideal.mem_sup_left hi)
        (Ideal.mem_sup_right (Submodule.mem_inf.mp hj).2)
    · rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact hgJ i
  rw [hJ]
  exact Submodule.fg_span (Set.finite_range g)

theorem wc_pmn_ldp_node_coords (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a') (h2 : n = 2) (G : Prop)
    (k : ∀ (C : Type u) (_ : CommRing C) (_ : IsLocalRing C)
      (_ : Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≅ Spec (.of C))
      (a b : C), a * b = 0 → Ideal.span {a, b} = IsLocalRing.maximalIdeal C →
      ∀ (K₁ K₂ : Type u) (_ : Field K₁) (_ : Field K₂) (_ : Algebra C K₁) (_ : Algebra C K₂),
        IsLocalization.Away b K₁ → IsLocalization.Away a K₂ → G) : G :=
by
  classical
  subst h2

  have c2 : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
      (a b : C), a * b = 0 → Ideal.span {a, b} = IsLocalRing.maximalIdeal C →
      (∀ n : ℕ, b ^ n ≠ 0) →
      ∃ (K : Type u) (_ : Field K) (_ : Algebra C K), IsLocalization.Away b K := by
    intro C _ _ _ a b hab hspan hb
    have ha𝔪 : a ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
    have hb𝔪 : b ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
    have hbu : IsUnit (algebraMap C (Localization.Away b) b) :=
      IsLocalization.Away.algebraMap_isUnit b
    have hι0 : algebraMap C (Localization.Away b) a = 0 := by
      have : algebraMap C (Localization.Away b) a * algebraMap C (Localization.Away b) b = 0 := by
        rw [← map_mul, hab, map_zero]
      exact hbu.mul_left_eq_zero.mp this
    have hI𝔪 : Ideal.span {a} ≤ IsLocalRing.maximalIdeal C :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha𝔪)
    have hkrull : ∀ c : C, (∀ N : ℕ, c ∈ Ideal.span {b ^ N} ⊔ Ideal.span {a}) →
        c ∈ Ideal.span {a} := by
      intro c hc
