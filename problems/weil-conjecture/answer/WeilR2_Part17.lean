  have hbij : ∀ p : P, Function.Bijective ((wcEtStalk P p).map
      ((SheafOfModules.toSheaf (wcEtZModRing P m)).map (wcEtSuppUnitMap D))).hom := by
    intro p
    haveI := (wc_et_stalk_exact P p).1
    have hmono' : Mono ((wcEtStalk P p).map
        ((SheafOfModules.toSheaf (wcEtZModRing P m)).map (wcEtSuppUnitMap D))) := inferInstance
    have hinj := (AddCommGrpCat.mono_iff_injective _).mp hmono'

    obtain ⟨-, hS0, -⟩ := wc_et_const_zmod_stalk_cyclic P m hm0 p
    obtain ⟨e₁⟩ := wc_et_zmod_unit_toSheaf_iso P m
    have hS : Nat.card ((wcEtStalk P p).obj ((SheafOfModules.toSheaf (wcEtZModRing P m)).obj
        (SheafOfModules.unit (wcEtZModRing P m)))) = m :=
      (Nat.card_congr ((wcEtStalk P p).mapIso e₁).addCommGroupIsoToAddEquiv.toEquiv).trans hS0

    obtain ⟨C, _, _, _, Λ, _, _, W', φ, ap, e', hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
      wc_et_geom_strict_henselization p
