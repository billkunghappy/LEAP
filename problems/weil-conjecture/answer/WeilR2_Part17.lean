      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →+* B :=
    (Spec.preimage a₀).hom
  let P : Ideal (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) :=
    Ideal.comap ψ (IsLocalRing.maximalIdeal B)
