    refine core _ _ _ _ hT' ?_
    rcases hcase with hK | ⟨hσ, hend, hs4, θ₀, hθ₀⟩
    · exact Or.inl hK
    refine Or.inr ⟨hσ, ?_, ?_, ⟨θ₀ ≫ (α _).hom, ?_⟩⟩
    ·
      intro c hc
      have hfull : ∃ h₀ : Sx ⟶ Sx,
          DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map h₀) = c := by
        refine ⟨(DerivedCategory.singleFunctor 𝒞 0).preimage
          ((DerivedCategory.singleFunctorIsoCompQ 𝒞 0).hom.app Sx ≫ c ≫
