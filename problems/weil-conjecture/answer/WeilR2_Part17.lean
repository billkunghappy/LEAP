by
  classical

  have hlow : ∀ (O : V.left.Opens),
      (O : Set ↥V.left) = (Set.range (Limits.pullback.fst V.hom i))ᶜ →
      ∀ (k : ℕ), 1 ≤ k → k + 2 ≤ 2 * r → Subsingleton (wcEtCoh O.toScheme ℓ k) := ?_

  have hqcqs : ∀ (O : V.left.Opens),
      (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ →
      IsCompact (O : Set ↥V.left) ∧ CompactSpace O.toScheme ∧ QuasiSeparatedSpace O.toScheme ∧
