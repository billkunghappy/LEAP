      (wc_et_coh_zmod_prime_pow_of_prime (Uodd : Scheme.{u}) ℓ Fact.out (j + 1) hU0 k) y
  have h3 := wc_proet_int_ext_vanish_of_zmod_deg (Uodd : Scheme.{u}) ℓ
