import WeilR2_Part16
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_pmn_tsl_odp_stalk_datum (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x) :
    ∃ (R : Type u) (_ : CommRing R) (_ : IsLocalRing R) (_ : IsNoetherianRing R)
      (t : Fin n → R) (h : R) (M : Matrix (Fin n) (Fin n) R),
      ringKrullDim R = n ∧ IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) ∧
      h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 ∧
      IsUnit (M + M.transpose).det ∧
      Nonempty ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).presheaf.stalk xs ≃+*
        R ⧸ Ideal.span {h}) :=
by
  classical
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance
  haveI hSi : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  haveI hYp := D.proper
  haveI hYs := D.smooth

  have hρpt : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A := by
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
      | exact (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
      | (erw [Spec.map_apply]; exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
  have ht₀ : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      D.S i (IsLocalRing.closedPoint F'') :=
    (congrArg (fun p => V.hom (e.inv p)) hρpt).trans hV

  obtain ⟨σ, hσdef⟩ : ∃ σ : F'' →+* IsLocalRing.ResidueField A,
      σ = (Spec.preimage ((wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom)).hom := ⟨_, rfl⟩
  have e1 : Spec.map (CommRingCat.ofHom σ) = (wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom := by
    rw [hσdef]; exact Spec.map_preimage _
  have hA1 : (wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom =
      (Spec.map (CommRingCat.ofHom σ) ≫ D.S i) ≫ (wcP1Over F'').hom := by
    rw [Category.assoc (Spec.map (CommRingCat.ofHom σ)), D.hS i, Category.comp_id, e1]
  have hA2 : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      (Spec.map (CommRingCat.ofHom σ) ≫ D.S i)
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) :=
    ht₀.trans (congrArg (D.S i) (Subsingleton.elim (α := (Spec (.of F'') : Scheme.{u}))
      (IsLocalRing.closedPoint F'') _))
  have hsurj0 : Function.Surjective
      (Scheme.Hom.residueFieldMap (wcP1Over F'').hom (D.S i (IsLocalRing.closedPoint F''))).hom := by
    have hc := Scheme.residueFieldMap_comp (D.S i) (wcP1Over F'').hom (IsLocalRing.closedPoint F'')
    have hcc := Scheme.Hom.residueFieldMap_congr (D.hS i) (IsLocalRing.closedPoint F'')
    have hid := Scheme.residueFieldMap_id (X := Spec (.of F'')) (IsLocalRing.closedPoint F'')
    first
      | (rw [hid, Category.comp_id] at hcc)
      | (erw [hid, Category.comp_id] at hcc)
      | (simp only [Scheme.residueFieldMap_id, Category.comp_id] at hcc)
    have hnt : ∀ (X : Scheme.{u}) (x : X), Nontrivial (X.residueField x) := by
      intro X x
      first
        | infer_instance
        | exact inferInstanceAs (Nontrivial (IsLocalRing.ResidueField (X.presheaf.stalk x)))
        | exact (inferInstance : Field (X.residueField x)).toNontrivial
        | exact (inferInstanceAs (Field (IsLocalRing.ResidueField (X.presheaf.stalk x)))).toNontrivial
    haveI : Nontrivial ((Spec (.of F'')).residueField (IsLocalRing.closedPoint F'')) :=
      hnt _ _
    have hinj : Function.Injective
        (Scheme.Hom.residueFieldMap (D.S i) (IsLocalRing.closedPoint F'')).hom :=
      RingHom.injective _
    have gen : ∀ {K1 K2 K3 : CommRingCat.{u}} (a : K1 ⟶ K2) (b : K2 ⟶ K3) (c : K1 ≅ K3),
        c.hom = a ≫ b → Function.Injective b.hom → Function.Surjective a.hom := by
      intro K1 K2 K3 a b c hcab hb y
      refine ⟨c.inv.hom (b.hom y), hb ?_⟩
      have h1 : (c.inv ≫ c.hom).hom (b.hom y) = b.hom y := by rw [c.inv_hom_id]; rfl
      rw [hcab] at h1
      exact h1
    exact gen _ _ _ (hcc.symm.trans hc) hinj
  have cancel : ∀ {X X' Z : Scheme.{u}} (r : X ⟶ X') (s : X' ⟶ X) (f g : X ⟶ Z),
      r ≫ s = 𝟙 _ → s ≫ f = s ≫ g → f = g := by
    intro X X' Z r s f g h hsf
    calc f = (r ≫ s) ≫ f := by rw [h, Category.id_comp]
      _ = r ≫ (s ≫ f) := Category.assoc _ _ _
      _ = r ≫ (s ≫ g) := by rw [hsf]
      _ = (r ≫ s) ≫ g := (Category.assoc _ _ _).symm
      _ = g := by rw [h, Category.id_comp]
  have hfac : wcQmSp A ≫ e.inv ≫ V.hom = Spec.map (CommRingCat.ofHom σ) ≫ D.S i := by
    have hd := wc_spec_residue_maps_eq_of_surj (wcP1Over F'').hom (wcQmSp A ≫ e.inv ≫ V.hom)
      (Spec.map (CommRingCat.ofHom σ) ≫ D.S i) hA1 _ hA2 (by rw [ht₀]; exact hsurj0)
    have hr := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField
      (IsLocalRing.ResidueField A) (Spec (.of (IsLocalRing.ResidueField A))) (𝟙 _)
    exact cancel _ _ _ _ hr hd

  have Sq1 := IsPullback.of_hasPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
  have B : IsPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (Limits.pullback.snd V.hom D.f)
      (e.inv ≫ V.hom) D.f :=
    IsPullback.of_iso (IsPullback.of_hasPullback V.hom D.f) (Iso.refl _) e (Iso.refl _)
      (Iso.refl _) (by simp) (by simp) (by simp) (by simp)
  have Big := Sq1.paste_horiz B.flip
  rw [hfac] at Big
  obtain ⟨π₁, hπ₁⟩ : ∃ π : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
        D.Yt.left,
      π = Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Limits.pullback.snd V.hom D.f := ⟨_, rfl⟩
  rw [← hπ₁] at Big
  have Sq3 := IsPullback.of_hasPullback D.f (D.S i)
  obtain ⟨r, hR, hr1⟩ : ∃ r : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
        Limits.pullback D.f (D.S i),
      IsPullback r (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        (Limits.pullback.snd D.f (D.S i)) (Spec.map (CommRingCat.ofHom σ)) ∧
      r ≫ Limits.pullback.fst D.f (D.S i) = π₁ :=
    ⟨_, IsPullback.of_right' Big Sq3, IsPullback.lift_fst _ _ _ _⟩
  have hw : π₁ ≫ D.Yt.hom =
      Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Spec.map (CommRingCat.ofHom σ) := by
    have h1 := Big.w
    rw [← D.hf, ← Category.assoc, h1, Category.assoc, Category.assoc, D.hS i, Category.comp_id]
  obtain ⟨j, hj1, hj2⟩ : ∃ j : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
        Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ)),
      j ≫ Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) = π₁ ∧
      j ≫ Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) =
        Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hιY : Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom = Limits.pullback.snd D.f (D.S i) := by
    rw [← D.hf, ← Category.assoc, Limits.pullback.condition, Category.assoc, D.hS i,
      Category.comp_id]
  have hBot := IsPullback.of_hasPullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))
  have hOut : IsPullback r (j ≫ Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)))
      (Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom) (Spec.map (CommRingCat.ofHom σ)) := by
    rw [hj2, hιY]; exact hR
  have hB : IsPullback r j (Limits.pullback.fst D.f (D.S i))
      (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
    IsPullback.of_bot hOut (hr1.trans hj1.symm) hBot
  have hC := hB.flip.paste_vert Sq3
  haveI hjCI : IsClosedImmersion j :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hC.flip hSi
  have hpY : Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) (j xs) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    have e2 : (j ≫ Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) xs = π₁ xs := by
      rw [hj1]
    rw [Scheme.Hom.comp_apply] at e2
    rw [e2, hπ₁, Scheme.Hom.comp_apply, hxs]
    exact hx₂
  have hcl := (wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs).1
  have hyc := j.isClosedEmbedding.isClosedMap _ hcl
  rw [Set.image_singleton] at hyc

  have key : ∀ y' : D.Yt.left, y' = D.xs i (IsLocalRing.closedPoint F'') →
      ∃ (t : Fin n → D.Yt.left.presheaf.stalk y')
        (τ' : (wcP1Over F'').left.presheaf.stalk (D.f y'))
        (M : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk y')),
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') = Ideal.span (Set.range t) ∧
        IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.f y')) = Ideal.span {τ'} ∧
        (D.f.stalkMap y').hom τ' - ∑ a, ∑ c, M a c * t a * t c ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') ^ 3 ∧
        IsUnit (M + M.transpose).det := by
    rintro _ rfl
    exact D.odp i
  obtain ⟨t, τ', M, hmt, hmτ, hcub, hdet⟩ := key _ hpY
  have hker := wc_cpfo_stalk_ker_closed_pt_base_change j
    (r ≫ Limits.pullback.snd D.f (D.S i))
    (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) D.f (D.S i) hC xs τ' hmτ
  haveI hqYs : SmoothOfRelativeDimension n (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hBot D.smooth
  haveI : LocallyOfFiniteType (Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hBot inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ)))
  have hdim := wc_lfi_smooth_stalk_dim (IsLocalRing.ResidueField A) _ (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ))) n (j xs) hyc
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hmapm := wc_lfi_rational_fibre_maxIdeal F'' (IsLocalRing.ResidueField A) σ D.Yt.left _
    D.Yt.hom (Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)))
    (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) hBot (D.xs i) hxsY
    (j xs) ⟨IsLocalRing.closedPoint F'', hpY.symm⟩
  obtain ⟨ρ, hρ⟩ : ∃ ρ, ρ = ((Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ))).stalkMap (j xs)).hom := ⟨_, rfl⟩
  rw [← hρ] at hmapm hker
  have hsurj : Function.Surjective (j.stalkMap xs).hom := by
    first
      | exact j.stalkMap_surjective xs
      | exact Scheme.Hom.stalkMap_surjective j xs
      | exact SurjectiveOnStalks.stalkMap_surjective j xs
  have hmax : IsLocalRing.maximalIdeal ((Limits.pullback D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ))).presheaf.stalk (j xs)) =
        Ideal.span (Set.range (fun a => ρ (t a))) := by
    rw [← hmapm, hmt, Ideal.map_span, ← Set.range_comp]
    try rfl
  have hcub' : ρ ((D.f.stalkMap _).hom τ') - ∑ a, ∑ c, (M.map ρ) a c * ρ (t a) * ρ (t c) ∈
      IsLocalRing.maximalIdeal ((Limits.pullback D.Yt.hom
        (Spec.map (CommRingCat.ofHom σ))).presheaf.stalk (j xs)) ^ 3 := by
    have e2 : ρ ((D.f.stalkMap _).hom τ') - ∑ a, ∑ c, (M.map ρ) a c * ρ (t a) * ρ (t c) =
        ρ ((D.f.stalkMap _).hom τ' - ∑ a, ∑ c, M a c * t a * t c) := by
      simp only [map_sub, map_sum, map_mul, Matrix.map_apply]
    rw [e2, ← hmapm, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem ρ hcub
  have hdet' : IsUnit (M.map ρ + (M.map ρ).transpose).det := by
    have e3 : M.map ρ + (M.map ρ).transpose = (M + M.transpose).map ρ := by
      ext a c
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [e3, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hdet.map ρ
  exact ⟨((Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))).presheaf.stalk (j xs)),
    inferInstance, inferInstance, inferInstance,
    (fun a => ρ (t a)), ρ ((D.f.stalkMap _).hom τ'), M.map ρ,
    by exact_mod_cast hdim, hmax, hcub', hdet',
    ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hker)⟩⟩

theorem wc_local_binary_quadric_split (R O : Type u) [CommRing R] [IsLocalRing R] [CommRing O]
    [IsLocalRing O] [IsSepClosed (IsLocalRing.ResidueField O)] (π : R →+* O)
    (hπ : Function.Surjective π) (t : Fin 2 → R)
    (ht : IsLocalRing.maximalIdeal R = Ideal.span (Set.range t))
    (M : Matrix (Fin 2) (Fin 2) R) (hdet : IsUnit (M + M.transpose).det) :
    ∃ ℓ₁ ℓ₂ : R, Ideal.span {ℓ₁, ℓ₂} = IsLocalRing.maximalIdeal R ∧
      (∑ a, ∑ c, M a c * t a * t c) - ℓ₁ * ℓ₂ ∈ IsLocalRing.maximalIdeal R ^ 3 :=
by
  classical
  have quad : ∀ (a b c : IsLocalRing.ResidueField O), b ^ 2 - 4 * a * c ≠ 0 →
      ∃ x, a * x ^ 2 + b * x + c = 0 := by
    intro a b c hD
    by_cases ha : a = 0
    · subst ha
      have hb : b ≠ 0 := by
        intro hb; apply hD; rw [hb]; ring
      refine ⟨-c / b, ?_⟩
      field_simp
      ring
    · have hdeg : (Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b * Polynomial.X +
          Polynomial.C c).degree ≠ 0 := by
        rw [Polynomial.degree_quadratic ha]; decide
      have hder : Polynomial.derivative (Polynomial.C a * Polynomial.X ^ 2 +
          Polynomial.C b * Polynomial.X + Polynomial.C c) =
          Polynomial.C (2 * a) * Polynomial.X + Polynomial.C b := by
        simp only [Polynomial.derivative_add, Polynomial.derivative_C_mul_X_sq,
          Polynomial.derivative_C_mul_X, Polynomial.derivative_C, add_zero]
        rw [mul_comm a 2]
      have hsep : (Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b * Polynomial.X +
          Polynomial.C c).Separable := by
        rw [Polynomial.separable_def, hder]
        refine ⟨Polynomial.C (-4 * a * (b ^ 2 - 4 * a * c)⁻¹),
          Polynomial.C (b ^ 2 - 4 * a * c)⁻¹ * (Polynomial.C (2 * a) * Polynomial.X +
            Polynomial.C b), ?_⟩
        have hCD : Polynomial.C (b ^ 2 - 4 * a * c)⁻¹ * Polynomial.C (b ^ 2 - 4 * a * c) = 1 := by
          rw [← Polynomial.C_mul, inv_mul_cancel₀ hD, Polynomial.C_1]
        simp only [map_mul, map_neg, map_sub, map_pow, map_ofNat] at hCD ⊢
        linear_combination hCD
      obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hdeg hsep
      refine ⟨x, ?_⟩
      simpa [Polynomial.eval_add, Polynomial.eval_mul] using hx
  let ρ : R →+* IsLocalRing.ResidueField O := (IsLocalRing.residue O).comp π
  have hρs : Function.Surjective ρ := IsLocalRing.residue_surjective.comp hπ
  have hker : RingHom.ker ρ = IsLocalRing.maximalIdeal R := by
    have := RingHom.ker_isMaximal_of_surjective ρ hρs
    exact IsLocalRing.eq_maximalIdeal this
  have hmem : ∀ x : R, x ∈ IsLocalRing.maximalIdeal R ↔ ρ x = 0 := by
    intro x; rw [← hker, RingHom.mem_ker]
  have hQ : (∑ a, ∑ c, M a c * t a * t c) =
      M 0 0 * t 0 ^ 2 + (M 0 1 + M 1 0) * t 0 * t 1 + M 1 1 * t 1 ^ 2 := by
    simp only [Fin.sum_univ_two]; ring
  have hdet' : (M + M.transpose).det = 4 * M 0 0 * M 1 1 - (M 0 1 + M 1 0) ^ 2 := by
    rw [Matrix.det_fin_two]
    simp only [Matrix.add_apply, Matrix.transpose_apply]
    ring
  have hD : ρ (M 0 1 + M 1 0) ^ 2 - 4 * ρ (M 0 0) * ρ (M 1 1) ≠ 0 := by
    have h1 : ρ (M 0 1 + M 1 0) ^ 2 - 4 * ρ (M 0 0) * ρ (M 1 1) =
        ρ (-(M + M.transpose).det) := by
      rw [hdet']; simp only [map_neg, map_sub, map_mul, map_pow, map_ofNat]; ring
    rw [h1]; exact (hdet.neg.map ρ).ne_zero
  obtain ⟨x, hx⟩ := quad _ _ _ hD
  obtain ⟨r, hr⟩ := hρs x
  have hf : M 0 0 * r ^ 2 + (M 0 1 + M 1 0) * r + M 1 1 ∈ IsLocalRing.maximalIdeal R := by
    rw [hmem]; simpa only [map_add, map_mul, map_pow, hr] using hx
  have hs : IsUnit ((M 0 1 + M 1 0) + 2 * M 0 0 * r) := by
    apply IsLocalRing.notMem_maximalIdeal.mp
    rw [hmem]
    intro h0
    apply hD
    have h0' : ρ (M 0 1 + M 1 0) + 2 * ρ (M 0 0) * x = 0 := by
      rw [← h0]; simp only [map_add, map_mul, map_ofNat, hr]
    linear_combination (ρ (M 0 1 + M 1 0) + 2 * ρ (M 0 0) * x) * h0' - 4 * ρ (M 0 0) * hx
  have ht0 : t 0 ∈ IsLocalRing.maximalIdeal R := by rw [ht]; exact Ideal.subset_span ⟨0, rfl⟩
  have ht1 : t 1 ∈ IsLocalRing.maximalIdeal R := by rw [ht]; exact Ideal.subset_span ⟨1, rfl⟩
  obtain ⟨w, hw⟩ := hs.exists_left_inv
  refine ⟨t 0 - r * t 1, M 0 0 * t 0 + ((M 0 1 + M 1 0) + M 0 0 * r) * t 1,
    le_antisymm ?_ ?_, ?_⟩
  · rw [Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact Ideal.sub_mem _ ht0 (Ideal.mul_mem_left _ _ ht1)
    · exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ ht0) (Ideal.mul_mem_left _ _ ht1)
  · rw [ht, Ideal.span_le, Set.range_subset_iff, Fin.forall_fin_two]
    constructor
    · rw [SetLike.mem_coe, Ideal.mem_span_pair]
      exact ⟨w * ((M 0 1 + M 1 0) + M 0 0 * r), w * r, by linear_combination t 0 * hw⟩
    · rw [SetLike.mem_coe, Ideal.mem_span_pair]
      exact ⟨w * (-M 0 0), w, by linear_combination t 1 * hw⟩
  · rw [hQ]
    have e : M 0 0 * t 0 ^ 2 + (M 0 1 + M 1 0) * t 0 * t 1 + M 1 1 * t 1 ^ 2 -
        (t 0 - r * t 1) * (M 0 0 * t 0 + ((M 0 1 + M 1 0) + M 0 0 * r) * t 1) =
        t 1 ^ 2 * (M 0 0 * r ^ 2 + (M 0 1 + M 1 0) * r + M 1 1) := by ring
    rw [e, pow_succ]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ht1 2) hf

theorem wc_reg2_node_branch_pow_not_mem (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (ℓ₁ ℓ₂ h : R)
    (hspan : Ideal.span {ℓ₁, ℓ₂} = IsLocalRing.maximalIdeal R)
    (hdim : ringKrullDim R = ((2 : ℕ) : WithBot ℕ∞))
    (hh : h - ℓ₁ * ℓ₂ ∈ IsLocalRing.maximalIdeal R ^ 3) :
    ∀ (n : ℕ) (r : R), ℓ₁ ^ n - h * r ∉ IsLocalRing.maximalIdeal R ^ (n + 1) :=
by
  classical
  intro n r hz
  set m := IsLocalRing.maximalIdeal R with hm
  have h1 : (1 : R) ∉ m := fun h0 =>
    (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h0)
  have hl1 : ℓ₁ ∈ m := by rw [← hspan]; exact Ideal.subset_span (by simp)
  have hl2 : ℓ₂ ∈ m := by rw [← hspan]; exact Ideal.subset_span (by simp)
  set t : Fin 2 → R := ![ℓ₁, ℓ₂] with ht_def
  have ht : m = Ideal.span (Set.range t) := by
    rw [ht_def, Matrix.range_cons_cons_empty]; exact hspan.symm
  have hQR := wc_rl_param_quasi_regular R 2 t ht (by exact_mod_cast hdim)
  have hh2 : h ∈ m ^ 2 := by
    have e0 : h = (h - ℓ₁ * ℓ₂) + ℓ₁ * ℓ₂ := by ring
    rw [e0]
    exact add_mem (Ideal.pow_le_pow_right (by norm_num) hh)
      (by rw [sq]; exact Ideal.mul_mem_mul hl1 hl2)
  have hwr : ∀ (k : ℕ) (s : R), s ∈ m ^ k → (h - ℓ₁ * ℓ₂) * s ∈ m ^ (k + 3) := by
    intro k s hs
    have := Ideal.mul_mem_mul hh hs
    rwa [← pow_add, add_comm] at this
  have hP : ∀ k : ℕ, ℓ₁ ^ k ∉ m ^ (k + 1) := by
    intro k hk
    have hc := hQR k (MvPolynomial.X 0 ^ k) (MvPolynomial.isHomogeneous_X_pow 0 k)
      (by rw [map_pow, MvPolynomial.eval_X]; exact hk) (Finsupp.single 0 k)
    rw [MvPolynomial.coeff_X_pow, if_pos rfl] at hc
    exact h1 hc
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · apply h1
    rw [zero_add, pow_one] at hz
    have hhr : h * r ∈ m := Ideal.mul_mem_right r _ (Ideal.pow_le_self (by norm_num) hh2)
    have e0 : (1 : R) = (ℓ₁ ^ 0 - h * r) + h * r := by ring
    rw [e0]
    exact add_mem hz hhr
  by_cases hA : r ∈ m ^ (n - 1)
  · apply hP n
    have hr : h * r ∈ m ^ (n + 1) := by
      have := Ideal.mul_mem_mul hh2 hA
      rw [← pow_add] at this
      rwa [show 2 + (n - 1) = n + 1 by omega] at this
    have e0 : ℓ₁ ^ n = (ℓ₁ ^ n - h * r) + h * r := by ring
    rw [e0]
    exact add_mem hz hr
  have hex : ∃ N, r ∉ m ^ N := ⟨n - 1, hA⟩
  have hN0spec : r ∉ m ^ (Nat.find hex) := Nat.find_spec hex
  have hN0le : Nat.find hex ≤ n - 1 := Nat.find_min' hex hA
  have hN0pos : Nat.find hex ≠ 0 := by
    intro h0
    apply hN0spec
    rw [h0, pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  obtain ⟨e, he⟩ : ∃ e, Nat.find hex = e + 1 := ⟨Nat.find hex - 1, by omega⟩
  have hre : r ∈ m ^ e := by
    have := Nat.find_min hex (show e < Nat.find hex by omega)
    exact not_not.mp this
  have hre1 : r ∉ m ^ (e + 1) := by rw [← he]; exact hN0spec
  have hle : e + 2 ≤ n := by omega
  obtain ⟨G, hG, -, hGr⟩ := (wc_pfe_hom_poly_repr R 2 t ⊤ e r).mp
    (by rw [Ideal.top_mul, ← ht]; exact hre)
  have hXX : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) R) =
      MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
    rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul]
  have hHhom : (G * (MvPolynomial.X 0 * MvPolynomial.X 1)).IsHomogeneous (e + 2) :=
    hG.mul ((MvPolynomial.isHomogeneous_X R 0).mul (MvPolynomial.isHomogeneous_X R 1))
  have hHeval : MvPolynomial.eval t (G * (MvPolynomial.X 0 * MvPolynomial.X 1)) =
      ℓ₁ * ℓ₂ * r := by
    rw [map_mul, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, hGr]
    show r * (ℓ₁ * ℓ₂) = ℓ₁ * ℓ₂ * r
    ring
  rcases lt_or_eq_of_le hle with hlt | heq
  ·
    have hmem : MvPolynomial.eval t (G * (MvPolynomial.X 0 * MvPolynomial.X 1)) ∈
        m ^ (e + 2 + 1) := by
      rw [hHeval]
      have e0 : ℓ₁ * ℓ₂ * r = ℓ₁ ^ n - (ℓ₁ ^ n - h * r) - (h - ℓ₁ * ℓ₂) * r := by ring
      rw [e0]
      refine sub_mem (sub_mem ?_ ?_) ?_
      · exact Ideal.pow_le_pow_right (by omega) (Ideal.pow_mem_pow hl1 n)
      · exact Ideal.pow_le_pow_right (by omega) hz
      · exact hwr e r hre
    have hc := hQR (e + 2) _ hHhom hmem
    apply hre1
    have hr' : r ∈ m * Ideal.span (Set.range t) ^ e := by
      refine (wc_pfe_hom_poly_repr R 2 t m e r).mpr ⟨G, hG, fun α => ?_, hGr⟩
      have := hc (α + (Finsupp.single 0 1 + Finsupp.single 1 1))
      rw [hXX, MvPolynomial.coeff_mul_monomial, mul_one] at this
      exact this
    rw [← ht, ← pow_succ'] at hr'
    exact hr'
  ·
    have hFhom : (MvPolynomial.X 0 ^ n - G * (MvPolynomial.X 0 * MvPolynomial.X 1)).IsHomogeneous n :=
      (MvPolynomial.isHomogeneous_X_pow 0 n).sub (by rw [← heq]; exact hHhom)
    have hmem : MvPolynomial.eval t
        (MvPolynomial.X 0 ^ n - G * (MvPolynomial.X 0 * MvPolynomial.X 1)) ∈ m ^ (n + 1) := by
      rw [map_sub, map_pow, MvPolynomial.eval_X, hHeval]
      have e0 : t 0 ^ n - ℓ₁ * ℓ₂ * r = (ℓ₁ ^ n - h * r) + (h - ℓ₁ * ℓ₂) * r := by
        show ℓ₁ ^ n - ℓ₁ * ℓ₂ * r = _
        ring
      rw [e0]
      refine add_mem hz ?_
      have := hwr e r hre
      rwa [show e + 3 = n + 1 by omega] at this
    have hc := hQR n _ hFhom hmem (Finsupp.single 0 n)
    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_X_pow, if_pos rfl, hXX,
      MvPolynomial.coeff_mul_monomial', if_neg, sub_zero] at hc
    · exact h1 hc
    · intro hle'
      have := hle' 1
      simp at this

theorem wc_flat_local_node_transfer (R O B : Type u) [CommRing R] [IsLocalRing R] [CommRing O]
    [IsLocalRing O] [CommRing B] [IsLocalRing B] (π : R →+* O) (hπ : Function.Surjective π)
    (h ℓ₁ ℓ₂ : R) (hker : RingHom.ker π = Ideal.span {h})
    (hspan : Ideal.span {ℓ₁, ℓ₂} = IsLocalRing.maximalIdeal R)
    (hh : h - ℓ₁ * ℓ₂ ∈ IsLocalRing.maximalIdeal R ^ 3)
    (h₁ : ∀ (n : ℕ) (r : R), ℓ₁ ^ n - h * r ∉ IsLocalRing.maximalIdeal R ^ (n + 1))
    (h₂ : ∀ (n : ℕ) (r : R), ℓ₂ ^ n - h * r ∉ IsLocalRing.maximalIdeal R ^ (n + 1))
    (φ : O →+* B) [IsLocalHom φ] (hφ : φ.Flat)
    (hmax : Ideal.map φ (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal B) :
    Ideal.span {φ (π ℓ₁), φ (π ℓ₂)} = IsLocalRing.maximalIdeal B ∧
    φ (π ℓ₁) * φ (π ℓ₂) ∈ IsLocalRing.maximalIdeal B ^ 3 ∧
    (∀ n : ℕ, φ (π ℓ₁) ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1)) ∧
    (∀ n : ℕ, φ (π ℓ₂) ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1)) :=
by
  have hmO : Ideal.map π (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal O :=
    IsLocalRing.map_maximalIdeal_of_surjective π hπ
  have hmB : Ideal.map (φ.comp π) (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal B := by
    rw [← Ideal.map_map, hmO, hmax]
  have hcm : ∀ I : Ideal O, Ideal.comap φ (Ideal.map φ I) = I := by
    letI : Algebra O B := φ.toAlgebra
    haveI : Module.Flat O B := hφ
    haveI : IsLocalHom (algebraMap O B) := ‹IsLocalHom φ›
    haveI : Module.FaithfullyFlat O B := Module.FaithfullyFlat.of_flat_of_isLocalHom
    intro I
    exact Ideal.comap_map_eq_self_of_faithfullyFlat I
  have hπh : π h = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self h
  have key : ∀ c : R, (∀ (n : ℕ) (r : R), c ^ n - h * r ∉ IsLocalRing.maximalIdeal R ^ (n + 1)) →
      ∀ n : ℕ, φ (π c) ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1) := by
    intro c hc n H
    rw [← map_pow, ← map_pow, ← hmax, ← Ideal.map_pow, ← Ideal.mem_comap, hcm, ← hmO,
      ← Ideal.map_pow, ← Ideal.mem_comap, Ideal.comap_map_of_surjective' π hπ, hker,
      Submodule.mem_sup] at H
    obtain ⟨z, hz, w, hw, hzw⟩ := H
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hw
    apply hc n a
    have : c ^ n - h * a = z := by rw [← hzw]; ring
    rw [this]
    exact hz
  refine ⟨?_, ?_, key ℓ₁ h₁, key ℓ₂ h₂⟩
  · rw [← hmB, ← hspan, Ideal.map_span, Set.image_pair]
    rfl
  · have e : φ (π ℓ₁) * φ (π ℓ₂) = (φ.comp π) h - (φ.comp π) (h - ℓ₁ * ℓ₂) := by
      simp only [RingHom.comp_apply, map_sub, map_mul, hπh, map_zero]
      ring
    rw [e]
    refine Ideal.sub_mem _ ?_ ?_
    · simp [hπh]
    · rw [← hmB, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hh

theorem wc_henselian_node_split (B : Type u) [CommRing B] [HenselianLocalRing B] (x y : B)
    (hspan : Ideal.span {x, y} = IsLocalRing.maximalIdeal B)
    (hxy : x * y ∈ IsLocalRing.maximalIdeal B ^ 3)
    (hx : ∀ n : ℕ, x ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1))
    (hy : ∀ n : ℕ, y ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1)) :
    ∃ a b : B, a * b = 0 ∧ Ideal.span {a, b} = IsLocalRing.maximalIdeal B ∧
      (∀ n : ℕ, a ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1)) ∧
      (∀ n : ℕ, b ^ n ∉ IsLocalRing.maximalIdeal B ^ (n + 1)) :=
by
  classical
  set m := IsLocalRing.maximalIdeal B with hm
  have hxm : x ∈ m := hspan ▸ Ideal.subset_span (by simp)
  have hym : y ∈ m := hspan ▸ Ideal.subset_span (by simp)

  have unit_sub : ∀ z t : B, IsUnit z → t ∈ m → IsUnit (z - t) := by
    intro z t hz ht
    by_contra h
    have h1 : z - t ∈ m := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)
    have h2 : z ∈ m := by simpa using m.add_mem h1 ht
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h2) hz
  have sq_mem : ∀ z : B, z ∈ m → z ^ 2 ∈ m ^ 2 := fun z hz => Ideal.pow_mem_pow hz 2
  have sq_mem' : ∀ z : B, z ∈ m → z ^ 2 ∈ m := fun z hz => by
    rw [pow_two]; exact m.mul_mem_left z hz

  have Q2 : ∀ r ∈ Ideal.span ({x, y} : Set B) ^ 2,
      ∃ c₁ c₂ c₃ : B, r = c₁ * x ^ 2 + c₂ * x * y + c₃ * y ^ 2 := by
    intro r hr
    rw [pow_two] at hr
    refine Submodule.mul_induction_on hr ?_ ?_
    · intro p hp q hq
      obtain ⟨a₁, b₁, rfl⟩ := Ideal.mem_span_pair.mp hp
      obtain ⟨a₂, b₂, rfl⟩ := Ideal.mem_span_pair.mp hq
      exact ⟨a₁ * a₂, a₁ * b₂ + b₁ * a₂, b₁ * b₂, by ring⟩
    · rintro p q ⟨c₁, c₂, c₃, rfl⟩ ⟨d₁, d₂, d₃, rfl⟩
      exact ⟨c₁ + d₁, c₂ + d₂, c₃ + d₃, by ring⟩
  have Q3 : ∀ r ∈ Ideal.span ({x, y} : Set B) ^ 3,
      ∃ α β γ δ : B, r = α * x ^ 3 + β * x ^ 2 * y + γ * x * y ^ 2 + δ * y ^ 3 := by
    intro r hr
    rw [pow_succ] at hr
    refine Submodule.mul_induction_on hr ?_ ?_
    · intro p hp q hq
      obtain ⟨c₁, c₂, c₃, rfl⟩ := Q2 p hp
      obtain ⟨d₁, d₂, rfl⟩ := Ideal.mem_span_pair.mp hq
      exact ⟨c₁ * d₁, c₁ * d₂ + c₂ * d₁, c₂ * d₂ + c₃ * d₁, c₃ * d₂, by ring⟩
    · rintro p q ⟨a₁, a₂, a₃, a₄, rfl⟩ ⟨b₁, b₂, b₃, b₄, rfl⟩
      exact ⟨a₁ + b₁, a₂ + b₂, a₃ + b₃, a₄ + b₄, by ring⟩
  have hI3 : x * y ∈ Ideal.span ({x, y} : Set B) ^ 3 := by rw [hspan]; exact hxy
  obtain ⟨α, β, γ, δ, hrel⟩ := Q3 (x * y) hI3

  have hensel : ∀ u e : B, IsUnit u → e ∈ m → ∃ w : B, w ^ 2 - u * w + e = 0 ∧ w - u ∈ m := by
    intro u e hu he
    let f : Polynomial B := Polynomial.X ^ 2 - Polynomial.C u * Polynomial.X + Polynomial.C e
    have hmon : f.Monic := by
      have hf : f = Polynomial.X ^ 2 + (Polynomial.C e - Polynomial.C u * Polynomial.X) := by
        simp only [f]; ring
      rw [hf]
      apply Polynomial.monic_X_pow_add
      calc (Polynomial.C e - Polynomial.C u * Polynomial.X).degree
          ≤ max (Polynomial.C e).degree (Polynomial.C u * Polynomial.X).degree :=
            Polynomial.degree_sub_le _ _
        _ ≤ 1 := max_le (Polynomial.degree_C_le.trans (by norm_num)) (Polynomial.degree_C_mul_X_le u)
        _ < 2 := by norm_num
    have hev : Polynomial.eval u f = e := by simp [f]; ring
    have hder : Polynomial.eval u (Polynomial.derivative f) = u := by simp [f]; ring
    obtain ⟨w, hroot, hwu⟩ := HenselianLocalRing.is_henselian f hmon u (by rw [hev]; exact he)
      (by rw [hder]; exact hu)
    refine ⟨w, ?_, hwu⟩
    have h := hroot.eq_zero
    simp [f] at h
    linear_combination h
  have hu_unit : IsUnit (1 - β * x - γ * y) := by
    have := unit_sub 1 (β * x + γ * y) isUnit_one
      (m.add_mem (m.mul_mem_left β hxm) (m.mul_mem_left γ hym))
    convert this using 1; ring
  have he_m : α * δ * (x * y) ∈ m := m.mul_mem_left _ (m.mul_mem_right y hxm)
  obtain ⟨w, hw, hwu⟩ := hensel _ _ hu_unit he_m
  have hw_unit : IsUnit w := by
    have h1 : (1 - β * x - γ * y) - w ∈ m := by
      rw [← neg_sub]; exact m.neg_mem hwu
    have := unit_sub _ _ hu_unit h1
    simpa using this

  have transfer : ∀ (x a : B), a ∈ m → a - w * x ∈ m ^ 2 → x ∈ m →
      (∀ n : ℕ, x ^ n ∉ m ^ (n + 1)) → ∀ n : ℕ, a ^ n ∉ m ^ (n + 1) := by
    intro x a ha had hxm hx
    have K : ∀ n : ℕ, a ^ n - w ^ n * x ^ n ∈ m ^ (n + 1) := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        have e : a ^ (n + 1) - w ^ (n + 1) * x ^ (n + 1)
            = (a ^ n - w ^ n * x ^ n) * a + w ^ n * (x ^ n * (a - w * x)) := by ring
        rw [e]
        refine Ideal.add_mem _ ?_ ?_
        · rw [pow_succ m (n + 1)]
          exact Ideal.mul_mem_mul ih ha
        · apply Ideal.mul_mem_left
          have h2 : m ^ (n + 1 + 1) = m ^ n * m ^ 2 := by rw [← pow_add]
          rw [h2]
          exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hxm n) had
    intro n hn
    apply hx n
    have h1 : w ^ n * x ^ n ∈ m ^ (n + 1) := by
      have := (m ^ (n + 1)).sub_mem hn (K n)
      simpa using this
    exact (Ideal.unit_mul_mem_iff_mem _ (hw_unit.pow n)).mp h1
  have haM : w * x - δ * y ^ 2 ∈ m := m.sub_mem (m.mul_mem_left w hxm) (m.mul_mem_left δ (sq_mem' y hym))
  have hbM : w * y - α * x ^ 2 ∈ m := m.sub_mem (m.mul_mem_left w hym) (m.mul_mem_left α (sq_mem' x hxm))
  refine ⟨w * x - δ * y ^ 2, w * y - α * x ^ 2, ?_, ?_, ?_, ?_⟩
  ·
    linear_combination (x * y) * hw + w * hrel
  ·
    apply le_antisymm
    · rw [Ideal.span_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact haM
      · exact hbM
    · rw [← hspan, Ideal.span_le]
      set J := Ideal.span ({w * x - δ * y ^ 2, w * y - α * x ^ 2} : Set B) with hJ
      have haJ : w * x - δ * y ^ 2 ∈ J := Ideal.subset_span (by simp)
      have hbJ : w * y - α * x ^ 2 ∈ J := Ideal.subset_span (by simp)
      have hv : IsUnit (w ^ 3 - α * δ ^ 2 * y ^ 3) :=
        unit_sub _ _ (hw_unit.pow 3) (m.mul_mem_left _ (m.pow_mem_of_mem hym 3 (by norm_num)))
      obtain ⟨v', hv'⟩ := hv.exists_left_inv
      obtain ⟨w', hw'⟩ := hw_unit.exists_left_inv
      have hyJ : y ∈ J := by
        have hmem : v' * (w ^ 2 * (w * y - α * x ^ 2) +
            (α * ((w * x - δ * y ^ 2) + 2 * δ * y ^ 2)) * (w * x - δ * y ^ 2)) ∈ J :=
          J.mul_mem_left _ (J.add_mem (J.mul_mem_left _ hbJ) (J.mul_mem_left _ haJ))
        convert hmem using 1
        linear_combination (-y) * hv'
      have hxJ : x ∈ J := by
        have hmem : w' * ((w * x - δ * y ^ 2) + (δ * y) * y) ∈ J :=
          J.mul_mem_left _ (J.add_mem haJ (J.mul_mem_left _ hyJ))
        convert hmem using 1
        linear_combination (-x) * hw'
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hxJ
      · exact hyJ
  ·
    refine transfer x _ haM ?_ hxm hx
    have : w * x - δ * y ^ 2 - w * x = -(δ * y ^ 2) := by ring
    rw [this]
    exact (m ^ 2).neg_mem ((m ^ 2).mul_mem_left δ (sq_mem y hym))
  ·
    refine transfer y _ hbM ?_ hym hy
    have : w * y - α * x ^ 2 - w * y = -(α * x ^ 2) := by ring
    rw [this]
    exact (m ^ 2).neg_mem ((m ^ 2).mul_mem_left α (sq_mem x hxm))

theorem wc_node_branch_kummer_field (B : Type u) [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓB : IsUnit ((ℓ : ℕ) : B))
    (hroot : ∀ m : ℕ, ∀ u : Bˣ, ∃ v : B, v ^ (ℓ ^ m) = u)
    (hmu : ∀ m : ℕ, ∃ s : Finset B, s.card = ℓ ^ m ∧ ∀ ζ ∈ s, ζ ^ (ℓ ^ m) = 1)
    (a b : B) (hab : a * b = 0) (hspan : Ideal.span {a, b} = IsLocalRing.maximalIdeal B)
    (hb : ∀ n : ℕ, b ^ n ≠ 0) :
    ∃ (K : Type u) (_ : Field K) (_ : Algebra B K), IsLocalization.Away b K ∧
      ((ℓ : ℕ) : K) ≠ 0 ∧ algebraMap B K b ≠ 0 ∧
      (∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
      (∀ m : ℕ, ∀ y : K, y ≠ 0 → ∃ (k : ℤ) (z : K), z ≠ 0 ∧ y = algebraMap B K b ^ k * z ^ (ℓ ^ m)) ∧
      (∀ m : ℕ, ∀ k : ℤ, (∃ z : K, algebraMap B K b ^ k = z ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k) :=
by
  classical
  set I : Ideal B := Ideal.span {a} with hIdef
  set q : B →+* B ⧸ I := Ideal.Quotient.mk I with hqdef
  have hqsurj : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hIm : I ≤ IsLocalRing.maximalIdeal B := by
    rw [← hspan]
    exact Ideal.span_mono (by simp)
  have hbm : b ∈ IsLocalRing.maximalIdeal B := by
    rw [← hspan]
    exact Ideal.subset_span (by simp)
  have hmtop : IsLocalRing.maximalIdeal B ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal B).ne_top
  have hItop : I ≠ ⊤ := fun h => hmtop (top_le_iff.mp (h ▸ hIm))
  haveI : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
  haveI : IsLocalRing (B ⧸ I) := IsLocalRing.of_surjective' q hqsurj
  have hqa : q a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)

  have hlift : ∀ w : B, IsUnit (q w) → IsUnit w := by
    intro w hw
    obtain ⟨y', hy'⟩ := hw.exists_right_inv
    obtain ⟨y, rfl⟩ := hqsurj y'
    have h1 : w * y - 1 ∈ IsLocalRing.maximalIdeal B := by
      apply hIm
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change q (w * y - 1) = 0
      rw [map_sub, map_mul, map_one, hy', sub_self]
    by_contra hwu
    have hwm : w ∈ IsLocalRing.maximalIdeal B :=
      (IsLocalRing.mem_maximalIdeal w).mpr (mem_nonunits_iff.mpr hwu)
    have h2 : w * y ∈ IsLocalRing.maximalIdeal B := Ideal.mul_mem_right y _ hwm
    have h3 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
      have := Ideal.sub_mem _ h2 h1
      simpa using this
    exact hmtop ((Ideal.eq_top_iff_one _).mpr h3)
  set β : B ⧸ I := q b with hβdef

  have hnu : ∀ z : B ⧸ I, ¬ IsUnit z → ∃ c, z = c * β := by
    intro z hz
    obtain ⟨w, rfl⟩ := hqsurj z
    have hwu : ¬ IsUnit w := fun h => hz (h.map q)
    have hwm : w ∈ Ideal.span {a, b} := by
      rw [hspan]
      exact (IsLocalRing.mem_maximalIdeal w).mpr (mem_nonunits_iff.mpr hwu)
    obtain ⟨r, s, hrs⟩ := Ideal.mem_span_pair.mp hwm
    refine ⟨q s, ?_⟩
    rw [← hrs, map_add, map_mul, map_mul, hqa, mul_zero, zero_add]
  have hβnu : ¬ IsUnit β := fun h =>
    mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal b).mp hbm) (hlift b h)
  have hpow : ∀ n : ℕ, β ^ n ≠ 0 := by
    intro n h0
    have hmem : b ^ n ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change q (b ^ n) = 0
      rw [map_pow]
      exact h0
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
    apply hb (n + 1)
    rw [pow_succ, ← hc, mul_assoc, hab, mul_zero]

  have hmax : IsLocalRing.maximalIdeal (B ⧸ I) = Ideal.span {β} := by
    ext z
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, Ideal.mem_span_singleton']
    constructor
    · intro hz
      obtain ⟨c, hc⟩ := hnu z hz
      exact ⟨c, hc.symm⟩
    · rintro ⟨c, rfl⟩ h
      exact hβnu (isUnit_of_mul_isUnit_right h)

  have hKr := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal (B ⧸ I))
    (IsLocalRing.maximalIdeal.isMaximal _).ne_top
  have hnotall : ∀ z : B ⧸ I, z ≠ 0 → ∃ N : ℕ, ¬ ∃ c, z = c * β ^ N := by
    intro z hz
    by_contra hcon
    push_neg at hcon
    apply hz
    have hmem : z ∈ (⨅ i, IsLocalRing.maximalIdeal (B ⧸ I) ^ i) := by
      rw [Ideal.mem_iInf]
      intro i
      obtain ⟨c, hc⟩ := hcon i
      rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
      exact ⟨c, hc.symm⟩
    rw [hKr] at hmem
    exact (Submodule.mem_bot _).mp hmem
  have hind : ∀ N : ℕ, ∀ z : B ⧸ I, (¬ ∃ c, z = c * β ^ N) →
      ∃ (u : (B ⧸ I)ˣ) (n : ℕ), z = u * β ^ n := by
    intro N
    induction N with
    | zero =>
      intro z hz
      exact (hz ⟨z, by simp⟩).elim
    | succ N ih =>
      intro z hz
      by_cases hzu : IsUnit z
      · exact ⟨hzu.unit, 0, by simp⟩
      · obtain ⟨c, rfl⟩ := hnu z hzu
        have hc : ¬ ∃ c', c = c' * β ^ N := by
          rintro ⟨c', rfl⟩
          exact hz ⟨c', by ring⟩
        obtain ⟨u, n, rfl⟩ := ih c hc
        exact ⟨u, n + 1, by ring⟩
  have hnf : ∀ z : B ⧸ I, z ≠ 0 → ∃ (u : (B ⧸ I)ˣ) (n : ℕ), z = u * β ^ n := by
    intro z hz
    obtain ⟨N, hN⟩ := hnotall z hz
    exact hind N z hN

  haveI : NoZeroDivisors (B ⧸ I) := by
    constructor
    intro x y hxy
    by_contra hcon
    push_neg at hcon
    obtain ⟨u, e, rfl⟩ := hnf x hcon.1
    obtain ⟨u', e', rfl⟩ := hnf y hcon.2
    have h0 : ((u * u' : (B ⧸ I)ˣ) : B ⧸ I) * β ^ (e + e') = 0 := by
      rw [← hxy, Units.val_mul]
      ring
    exact hpow _ ((Units.mul_right_eq_zero _).mp h0)
  haveI : IsDomain (B ⧸ I) := NoZeroDivisors.to_isDomain _

  have hβm : β ∈ IsLocalRing.maximalIdeal (B ⧸ I) :=
    (IsLocalRing.mem_maximalIdeal β).mpr (mem_nonunits_iff.mpr hβnu)
  have hβ0 : β ≠ 0 := by simpa using hpow 1
  have hℓA : IsUnit ((ℓ : ℕ) : B ⧸ I) := by simpa using hℓB.map q
  have hroot' : ∀ m : ℕ, ∀ u : (B ⧸ I)ˣ, ∃ v : B ⧸ I, v ^ (ℓ ^ m) = u := by
    intro m u
    obtain ⟨w, hw⟩ := hqsurj (u : B ⧸ I)
    have hwu : IsUnit w := hlift w (by rw [hw]; exact u.isUnit)
    obtain ⟨v, hv⟩ := hroot m hwu.unit
    exact ⟨q v, by rw [← map_pow, hv, IsUnit.unit_spec, hw]⟩
  have hmu' : ∀ m : ℕ, ∃ s : Finset (B ⧸ I), s.card = ℓ ^ m ∧ ∀ ζ ∈ s, ζ ^ (ℓ ^ m) = 1 := by
    intro m
    obtain ⟨s, hs, hs1⟩ := hmu m
    have hNu : IsUnit ((ℓ ^ m : ℕ) : B) := by rw [Nat.cast_pow]; exact hℓB.pow m
    generalize ℓ ^ m = N at hs hs1 hNu ⊢
    refine ⟨s.image q, ?_, ?_⟩
    · rw [Finset.card_image_of_injOn, hs]
      intro ζ hζ ζ' hζ' heq
      have hd : ζ - ζ' ∈ IsLocalRing.maximalIdeal B := hIm (Ideal.Quotient.eq.mp heq)
      have hN0 : N ≠ 0 := by
        rintro rfl
        rw [Nat.cast_zero] at hNu
        exact not_isUnit_zero hNu
      have hζ'1 : ζ' * ζ' ^ (N - 1) = 1 := by
        rw [← pow_succ', Nat.sub_add_cancel (Nat.pos_of_ne_zero hN0)]; exact hs1 ζ' hζ'
      have hζ'u : IsUnit ζ' :=
        ⟨⟨ζ', ζ' ^ (N - 1), hζ'1, by rw [mul_comm]; exact hζ'1⟩, rfl⟩
      have hSd : (∑ i ∈ Finset.range N, ζ ^ i * ζ' ^ (N - 1 - i)) * (ζ - ζ') = 0 := by
        rw [Commute.geom_sum₂_mul (Commute.all ζ ζ') N, hs1 ζ hζ, hs1 ζ' hζ', sub_self]
      have hres : IsLocalRing.residue B ζ = IsLocalRing.residue B ζ' := by
        rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
        exact hd
      have hSu : IsUnit (∑ i ∈ Finset.range N, ζ ^ i * ζ' ^ (N - 1 - i)) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_sum]
        have hterm : ∀ i ∈ Finset.range N, IsLocalRing.residue B (ζ ^ i * ζ' ^ (N - 1 - i)) =
            IsLocalRing.residue B ζ' ^ (N - 1) := by
          intro i hi
          rw [map_mul, map_pow, map_pow, hres, ← pow_add]
          congr 1
          have := Finset.mem_range.mp hi
          omega
        rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        apply mul_ne_zero
        · have := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hNu
          rwa [map_natCast] at this
        · exact pow_ne_zero _ ((IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hζ'u)
      exact sub_eq_zero.mp ((hSu.mul_right_eq_zero).mp hSd)
    · intro ζ hζ
      obtain ⟨ζ0, hζ0, rfl⟩ := Finset.mem_image.mp hζ
      rw [← map_pow, hs1 ζ0 hζ0, map_one]
  obtain ⟨hloc, h1, h2, h3, h4, h5⟩ :=
    wc_stpf_kummer_frac (B ⧸ I) β ℓ hβm hβ0 hnf hℓA hroot' hmu'
  have hbK : ∀ x : B, algebraMap B (FractionRing (B ⧸ I)) x =
      algebraMap (B ⧸ I) (FractionRing (B ⧸ I)) (q x) := by
    intro x
    rw [IsScalarTower.algebraMap_apply B (B ⧸ I) (FractionRing (B ⧸ I)) x,
      Ideal.Quotient.algebraMap_eq]
  have hAway : IsLocalization.Away b (FractionRing (B ⧸ I)) := by
    haveI := hloc
    refine IsLocalization.Away.mk b ?_ ?_ ?_
    · rw [hbK]
      exact IsLocalization.Away.algebraMap_isUnit β
    · intro s
      obtain ⟨n, x, hx⟩ := IsLocalization.Away.surj β s
      obtain ⟨y, rfl⟩ := hqsurj x
      exact ⟨n, y, by rw [hbK, hbK]; exact hx⟩
    · intro x y hxy
      rw [hbK, hbK] at hxy
      obtain ⟨⟨c, hc⟩, hcxy⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers β) hxy
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
      have hmem : b ^ n * (x - y) ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change q (b ^ n * (x - y)) = 0
        rw [map_mul, map_sub, map_pow, mul_sub, sub_eq_zero]
        exact hcxy
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hmem
      refine ⟨n + 1, ?_⟩
      linear_combination (-b) * hr + r * hab
  refine ⟨FractionRing (B ⧸ I), inferInstance, inferInstance, hAway, h1, ?_, h3, ?_, ?_⟩
  · rw [hbK]
    exact h2
  · intro m y hy
    rw [hbK]
    exact h4 m y hy
  · intro m k hk
    rw [hbK] at hk
    exact h5 m k hk

theorem wc_spec_local_flat_stalk_fibre_max {X T : Scheme.{u}} (g : T ⟶ X) [Flat g]
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : T ≅ Spec (.of B)) (x : X)
    (hx : g (eB.inv (IsLocalRing.closedPoint B)) = x)
    (hfib : IsIso (Limits.pullback.snd g (X.fromSpecResidueField x))) :
    ∃ φ : X.presheaf.stalk x →+* B, IsLocalHom φ ∧ φ.Flat ∧
      Ideal.map φ (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) = IsLocalRing.maximalIdeal B :=
by
  classical
  subst hx

  have alg : ∀ (O Ω : Type u) [CommRing O] [IsLocalRing O] [Algebra O B] [Field Ω]
      (ρ : TensorProduct O B (IsLocalRing.ResidueField O) ≃+* Ω),
      Ideal.map (algebraMap O B) (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal B := by
    intro O Ω _ _ _ _ ρ
    have hsurj : Function.Surjective (Algebra.ofId O (IsLocalRing.ResidueField O)) := by
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      exact ⟨a, by simp [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]⟩
    have hker : IsLocalRing.maximalIdeal O =
        RingHom.ker (Algebra.ofId O (IsLocalRing.ResidueField O)) := by
      rw [← IsLocalRing.ker_residue]
      ext a
      simp [RingHom.mem_ker, Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    let Q : (O ⧸ IsLocalRing.maximalIdeal O) ≃ₐ[O] IsLocalRing.ResidueField O :=
      (Ideal.quotientEquivAlgOfEq O hker).trans (Ideal.quotientKerAlgEquivOfSurjective hsurj)
    let E1 := Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (IsLocalRing.maximalIdeal O)
    let E2 : TensorProduct O B (O ⧸ IsLocalRing.maximalIdeal O) ≃ₐ[O]
        TensorProduct O B (IsLocalRing.ResidueField O) :=
      Algebra.TensorProduct.congr AlgEquiv.refl Q
    let E : (B ⧸ Ideal.map (algebraMap O B) (IsLocalRing.maximalIdeal O)) ≃+* Ω :=
      (E1.toRingEquiv.trans E2.toRingEquiv).trans ρ
    have hfield : IsField (B ⧸ Ideal.map (algebraMap O B) (IsLocalRing.maximalIdeal O)) :=
      MulEquiv.isField (Field.toIsField Ω) E.toMulEquiv
    have hmax : (Ideal.map (algebraMap O B) (IsLocalRing.maximalIdeal O)).IsMaximal :=
      Ideal.Quotient.maximal_of_isField _ hfield
    exact IsLocalRing.eq_maximalIdeal hmax

  have key : ∀ (f : Spec (.of B) ⟶ X) [Flat f],
      IsIso (Limits.pullback.snd f (X.fromSpecResidueField (f (IsLocalRing.closedPoint B)))) →
      ∃ φ : X.presheaf.stalk (f (IsLocalRing.closedPoint B)) →+* B, IsLocalHom φ ∧ φ.Flat ∧
        Ideal.map φ (IsLocalRing.maximalIdeal (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))) =
          IsLocalRing.maximalIdeal B := by
    intro f _ hsnd
    have hloc : IsLocalHom (Scheme.stalkClosedPointTo f).hom :=
      Scheme.isLocalHom_stalkClosedPointTo f
    have hflat : (Scheme.stalkClosedPointTo f).hom.Flat := by
      rw [Scheme.stalkClosedPointTo.eq_def f, CommRingCat.hom_comp]
      apply RingHom.Flat.comp
      · exact Flat.stalkMap f _
      · apply RingHom.Flat.of_bijective
        exact ConcreteCategory.bijective_of_isIso (stalkClosedPointIso (CommRingCat.of B)).hom
    letI : Algebra (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B :=
      (Scheme.stalkClosedPointTo f).hom.toAlgebra
    have hA : algebraMap (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B =
        (Scheme.stalkClosedPointTo f).hom :=
      RingHom.algebraMap_toAlgebra _
    have hf' : f = Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B)) ≫
          X.fromSpecStalk (f (IsLocalRing.closedPoint B)) := by
      rw [hA, CommRingCat.ofHom_hom]
      exact (Scheme.Spec_stalkClosedPointTo_fromSpecStalk f).symm
    have hr' : X.fromSpecResidueField (f (IsLocalRing.closedPoint B)) =
        Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))
          (IsLocalRing.ResidueField (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))))) ≫
          X.fromSpecStalk (f (IsLocalRing.closedPoint B)) := by
      rw [Scheme.fromSpecResidueField.eq_def, Scheme.residue.eq_def,
        IsLocalRing.ResidueField.algebraMap_eq]
      rfl
    let φ1 := Limits.pullback.congrHom hf' hr'
    let φ2 := Limits.IsLimit.conePointUniqueUpToIso (Limits.pullbackIsPullback _ _)
      (Limits.pullbackIsPullbackOfCompMono
        (Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B)))
        (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))
          (IsLocalRing.ResidueField (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))))))
        (X.fromSpecStalk (f (IsLocalRing.closedPoint B))))
    let φ4 := pullbackSpecIso (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B
      (IsLocalRing.ResidueField (X.presheaf.stalk (f (IsLocalRing.closedPoint B))))
    let Λ : Spec (.of (TensorProduct (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B
        (IsLocalRing.ResidueField (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))))) ≅
        Spec (X.residueField (f (IsLocalRing.closedPoint B))) :=
      (φ1 ≪≫ φ2 ≪≫ φ4).symm ≪≫ asIso (Limits.pullback.snd f _)
    let ρ : X.residueField (f (IsLocalRing.closedPoint B)) ≃+*
        TensorProduct (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B
          (IsLocalRing.ResidueField (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))) :=
      (Spec.fullyFaithful.preimageIso
      (X := Opposite.op (CommRingCat.of (TensorProduct (X.presheaf.stalk (f (IsLocalRing.closedPoint B))) B
        (IsLocalRing.ResidueField (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))))))
      (Y := Opposite.op (X.residueField (f (IsLocalRing.closedPoint B)))) Λ).unop.commRingCatIsoToRingEquiv
    have h := alg (X.presheaf.stalk (f (IsLocalRing.closedPoint B)))
      (X.residueField (f (IsLocalRing.closedPoint B))) ρ.symm
    refine ⟨(Scheme.stalkClosedPointTo f).hom, hloc, hflat, ?_⟩
    rw [← hA]
    exact h
  have hsnd : IsIso (Limits.pullback.snd (eB.inv ≫ g)
      (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B))))) := by
    have hm : IsIso (Limits.pullback.map (eB.inv ≫ g)
        (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B)))) g
        (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B)))) eB.inv (𝟙 _) (𝟙 _)
        (by simp) (by simp)) := inferInstance
    have e : Limits.pullback.snd (eB.inv ≫ g)
        (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B)))) =
        Limits.pullback.map (eB.inv ≫ g)
          (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B)))) g
          (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B)))) eB.inv (𝟙 _) (𝟙 _)
          (by simp) (by simp) ≫
        Limits.pullback.snd g (X.fromSpecResidueField (g (eB.inv (IsLocalRing.closedPoint B)))) := by
      rw [Limits.pullback.map]
      erw [Limits.pullback.lift_snd]
      rw [Category.comp_id]
    rw [e]
    infer_instance
  exact key (eB.inv ≫ g) hsnd

theorem wc_proet_punct_two_branch_opens {S : Scheme.{u}} (Th VT : S.ProEt)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th.left ≅ Spec (.of B))
    (j : VT ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (a b : B) (hab : a * b = 0) (hspan : Ideal.span {a, b} = IsLocalRing.maximalIdeal B)
    (K₁ K₂ : Type u) [Field K₁] [Field K₂] [Algebra B K₁] [Algebra B K₂]
    [IsLocalization.Away b K₁] [IsLocalization.Away a K₂] :
    ∃ (VT₁ VT₂ : S.ProEt) (k₁ : VT₁ ⟶ VT) (k₂ : VT₂ ⟶ VT),
      IsOpenImmersion k₁.left ∧ IsOpenImmersion k₂.left ∧
      Disjoint (Set.range k₁.left) (Set.range k₂.left) ∧
      Set.range k₁.left ∪ Set.range k₂.left = Set.univ ∧
      Nonempty (VT₁.left ≅ Spec (CommRingCat.of K₁)) ∧ Nonempty (VT₂.left ≅ Spec (CommRingCat.of K₂)) :=
by
  classical
  haveI := hj
  let ψ : VT.left ⟶ Spec (.of B) := j.left ≫ eB.hom
  haveI : IsOpenImmersion ψ := IsOpenImmersion.comp _ _
  have hcp : ∀ p : Spec (.of B), p ∈ Set.range ψ ↔ p ≠ IsLocalRing.closedPoint B := by
    intro p
    constructor
    · rintro ⟨z, rfl⟩ h
      have h1 : j.left z ∈ Set.range j.left := ⟨z, rfl⟩
      rw [hrange, Set.mem_compl_singleton_iff] at h1
      apply h1
      rw [← h]
      show j.left z = eB.inv (eB.hom (j.left z))
      rw [Scheme.hom_inv_apply]
    · intro hp
      have h1 : eB.inv p ∈ Set.range j.left := by
        rw [hrange, Set.mem_compl_singleton_iff]
        intro h
        apply hp
        have h2 : eB.hom (eB.inv p) = eB.hom (eB.inv (IsLocalRing.closedPoint B)) := by
          rw [h]
        rw [Scheme.inv_hom_apply] at h2
        exact h2.trans (Scheme.inv_hom_apply eB _)
      obtain ⟨z, hz⟩ := h1
      refine ⟨z, ?_⟩
      show eB.hom (j.left z) = p
      rw [hz, Scheme.inv_hom_apply]
  have ha : a ∈ IsLocalRing.maximalIdeal B := hspan ▸ Ideal.subset_span (by simp)
  have hb : b ∈ IsLocalRing.maximalIdeal B := hspan ▸ Ideal.subset_span (by simp)
  have key : ∀ (f : B), f ∈ IsLocalRing.maximalIdeal B → ∀ (K : Type u) [CommRing K]
      [Algebra B K] [IsLocalization.Away f K],
      Nonempty (((ψ ⁻¹ᵁ PrimeSpectrum.basicOpen f : VT.left.Opens) : Scheme.{u}) ≅
        Spec (CommRingCat.of K)) := by
    intro f hf K _ _ _
    haveI := IsOpenImmersion.of_isLocalization (S := K) f
    have hr1 : Set.range ((ψ ⁻¹ᵁ PrimeSpectrum.basicOpen f).ι ≫ ψ) =
        (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum B)) := by
      ext p
      constructor
      · rintro ⟨z, rfl⟩
        exact z.2
      · intro hp
        have hne : p ≠ IsLocalRing.closedPoint B := by
          rintro rfl
          exact (PrimeSpectrum.mem_basicOpen _ _).mp hp hf
        obtain ⟨x, rfl⟩ := (hcp p).mpr hne
        exact ⟨⟨x, hp⟩, rfl⟩
    have hr2 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap B K))) =
        (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum B)) := by
      rw [← PrimeSpectrum.localization_away_comap_range K f]
      rfl
    exact ⟨IsOpenImmersion.isoOfRangeEq _ _ (hr1.trans hr2.symm)⟩
  let U₁ := ψ ⁻¹ᵁ PrimeSpectrum.basicOpen b
  let U₂ := ψ ⁻¹ᵁ PrimeSpectrum.basicOpen a
  let VT₁ : S.ProEt := MorphismProperty.Over.mk ⊤ (U₁.ι ≫ VT.hom)
    (@MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ (etale_le_weaklyEtale _ _ _ inferInstance) VT.prop)
  let VT₂ : S.ProEt := MorphismProperty.Over.mk ⊤ (U₂.ι ≫ VT.hom)
    (@MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ (etale_le_weaklyEtale _ _ _ inferInstance) VT.prop)
  let k₁ : VT₁ ⟶ VT := MorphismProperty.Over.homMk (A := VT₁) (B := VT) U₁.ι rfl trivial
  let k₂ : VT₂ ⟶ VT := MorphismProperty.Over.homMk (A := VT₂) (B := VT) U₂.ι rfl trivial
  refine ⟨VT₁, VT₂, k₁, k₂, ?_, ?_, ?_, ?_, key b hb K₁, key a ha K₂⟩
  · show IsOpenImmersion U₁.ι
    infer_instance
  · show IsOpenImmersion U₂.ι
    infer_instance
  · show Disjoint (Set.range U₁.ι) (Set.range U₂.ι)
    rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι, Set.disjoint_left]
    intro z h1 h2
    have h1' : b ∉ (ψ z).asIdeal := h1
    have h2' : a ∉ (ψ z).asIdeal := h2
    have hmem : a * b ∈ (ψ z).asIdeal := hab ▸ Ideal.zero_mem _
    rcases (ψ z).isPrime.mem_or_mem hmem with h | h
    · exact h2' h
    · exact h1' h
  · show Set.range U₁.ι ∪ Set.range U₂.ι = Set.univ
    rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι]
    apply Set.eq_univ_of_forall
    intro z
    by_contra hz
    rw [Set.mem_union, not_or] at hz
    obtain ⟨h1, h2⟩ := hz
    have hb' : b ∈ (ψ z).asIdeal := by
      by_contra h
      exact h1 h
    have ha' : a ∈ (ψ z).asIdeal := by
      by_contra h
      exact h2 h
    have hle : IsLocalRing.maximalIdeal B ≤ (ψ z).asIdeal := by
      rw [← hspan, Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact ha'
      · exact hb'
    have heq := (IsLocalRing.maximalIdeal.isMaximal B).eq_of_le (ψ z).isPrime.ne_top hle
    have hpt : ψ z = IsLocalRing.closedPoint B := PrimeSpectrum.ext heq.symm
    exact ((hcp _).mp ⟨z, rfl⟩) hpt

theorem wc_pmn_node_shens_punct_two_fields (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (h2 : n = 2)
    (Th VT : (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).ProEt)
    (g : Th ⟶ Scheme.ProEt.mk (𝟙 (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))))
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xs} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).fromSpecResidueField xs)))
    (j : VT ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ) :
    ∃ (VT₁ VT₂ : (Limits.pullback (C := Scheme.{u})
        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).ProEt) (k₁ : VT₁ ⟶ VT) (k₂ : VT₂ ⟶ VT),
      IsOpenImmersion k₁.left ∧ IsOpenImmersion k₂.left ∧
      Disjoint (Set.range k₁.left) (Set.range k₂.left) ∧
      Set.range k₁.left ∪ Set.range k₂.left = Set.univ ∧
      (∃ (K : Type u) (_ : Field K) (iK : VT₁.left ≅ Spec (CommRingCat.of K)) (ϖ : K),
        ((ℓ : ℕ) : K) ≠ 0 ∧ ϖ ≠ 0 ∧ (∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
        (∀ m : ℕ, ∀ y : K, y ≠ 0 → ∃ (k : ℤ) (z : K), z ≠ 0 ∧ y = ϖ ^ k * z ^ (ℓ ^ m)) ∧
        (∀ m : ℕ, ∀ k : ℤ, (∃ z : K, ϖ ^ k = z ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k)) ∧
      (∃ (K : Type u) (_ : Field K) (iK : VT₂.left ≅ Spec (CommRingCat.of K)) (ϖ : K),
        ((ℓ : ℕ) : K) ≠ 0 ∧ ϖ ≠ 0 ∧ (∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
        (∀ m : ℕ, ∀ y : K, y ≠ 0 → ∃ (k : ℤ) (z : K), z ≠ 0 ∧ y = ϖ ^ k * z ^ (ℓ ^ m)) ∧
        (∀ m : ℕ, ∀ k : ℤ, (∃ z : K, ϖ ^ k = z ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k)) :=
by
  classical
  subst h2

  obtain ⟨_hcl, hsep, _hln, -⟩ :=
    wc_pmn_vp_node_point_geom F' F'' Y 2 D i V A e x hx₁ hx₂ xs hxs
  haveI hsepO : IsSepClosed (IsLocalRing.ResidueField
      ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A)).presheaf.stalk xs)) := hsep
  obtain ⟨R, iR, lR, nR, t, h, M, hdim, hm, hcub, hdet, ⟨ψ⟩⟩ :=
    wc_pmn_tsl_odp_stalk_datum F' F'' Y 2 D i V A e hV x hx₁ hx₂ xs hxs
  let π : R →+* ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A)).presheaf.stalk xs) :=
    ψ.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {h}))
  have hπ : Function.Surjective π :=
    ψ.symm.surjective.comp Ideal.Quotient.mk_surjective
  have hker : RingHom.ker π = Ideal.span {h} := by
    show RingHom.ker (ψ.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {h}))) = _
    rw [RingHom.ker_comp_of_injective _ ψ.symm.injective, Ideal.mk_ker]

  obtain ⟨ℓ₁, ℓ₂, hsp, hq⟩ := wc_local_binary_quadric_split R _ π hπ t hm M hdet
  have hh : h - ℓ₁ * ℓ₂ ∈ IsLocalRing.maximalIdeal R ^ 3 := by
    have h3 := Ideal.add_mem _ hcub hq
    convert h3 using 1
    ring

  have h₁ := wc_reg2_node_branch_pow_not_mem R ℓ₁ ℓ₂ h hsp hdim hh
  have h₂ := wc_reg2_node_branch_pow_not_mem R ℓ₂ ℓ₁ h
    (by rw [Set.pair_comm]; exact hsp) hdim (by rw [mul_comm ℓ₂ ℓ₁]; exact hh)

  have hgw : g.left = Th.hom := by
    rw [← MorphismProperty.Over.w g]
    exact (Category.comp_id _).symm
  haveI hwe : WeaklyEtale g.left := by rw [hgw]; exact Th.prop
  haveI : Flat g.left := WeaklyEtale.flat
  have hx : g.left (eB.inv (IsLocalRing.closedPoint B)) = xs := by
    have hmem : eB.inv (IsLocalRing.closedPoint B) ∈ g.left ⁻¹' {xs} := by
      rw [hpre]; exact Set.mem_singleton _
    exact hmem
  obtain ⟨φ, hφl, hφf, hφm⟩ := wc_spec_local_flat_stalk_fibre_max g.left B eB xs hx hfib
  haveI := hφl

  obtain ⟨hspB, hxyB, hxB, hyB⟩ :=
    @wc_flat_local_node_transfer R _ B _ _ _ _ _ _ π hπ h ℓ₁ ℓ₂ hker hsp hh h₁ h₂ φ hφl hφf hφm
  obtain ⟨a, b, hab, hspab, ha, hb⟩ := wc_henselian_node_split B _ _ hspB hxyB hxB hyB
  have ha0 : ∀ n : ℕ, a ^ n ≠ 0 := by
    intro n h0
    apply ha n
    rw [h0]
    exact Ideal.zero_mem _
  have hb0 : ∀ n : ℕ, b ^ n ≠ 0 := by
    intro n h0
    apply hb n
    rw [h0]
    exact Ideal.zero_mem _

  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have h1 : ringChar F'' ∣ ℓ := ringChar.dvd h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h1
    have h3 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd (Nat.cast_card_eq_zero F'')
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h3
  let σ : F'' →+* B := (Spec.preimage (eB.inv ≫ g.left ≫
    Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫ wcQmSp A ≫
    e.inv ≫ V.hom ≫ (wcP1Over F'').hom)).hom
  have hℓB : IsUnit ((ℓ : ℕ) : B) := by
    have h1 := (IsUnit.mk0 _ hℓF).map σ
    rwa [map_natCast] at h1
  have hℓm : ∀ m : ℕ, IsUnit (((ℓ ^ m : ℕ) : B)) := by
    intro m
    rw [Nat.cast_pow]
    exact hℓB.pow m
  have hroot : ∀ m : ℕ, ∀ u : Bˣ, ∃ v : B, v ^ (ℓ ^ m) = u := fun m =>
    (wc_stpf_hensel_roots B (ℓ ^ m) (hℓm m)).1
  have hmu : ∀ m : ℕ, ∃ s : Finset B, s.card = ℓ ^ m ∧ ∀ ζ ∈ s, ζ ^ (ℓ ^ m) = 1 := fun m =>
    (wc_stpf_hensel_roots B (ℓ ^ m) (hℓm m)).2

  obtain ⟨K₁, fK₁, aK₁, hloc₁, a1, a2, a3, a4, a5⟩ :=
    wc_node_branch_kummer_field B ℓ hℓB hroot hmu a b hab hspab hb0
  obtain ⟨K₂, fK₂, aK₂, hloc₂, b1, b2, b3, b4, b5⟩ :=
    wc_node_branch_kummer_field B ℓ hℓB hroot hmu b a (by rw [mul_comm]; exact hab)
      (by rw [Set.pair_comm]; exact hspab) ha0

  obtain ⟨VT₁, VT₂, k₁, k₂, hk₁, hk₂, hd, hc, ⟨i₁⟩, ⟨i₂⟩⟩ :=
    wc_proet_punct_two_branch_opens Th VT B eB j hj hrange a b hab hspab K₁ K₂
  exact ⟨VT₁, VT₂, k₁, k₂, hk₁, hk₂, hd, hc,
    ⟨K₁, fK₁, i₁, algebraMap B K₁ b, a1, a2, a3, a4, a5⟩,
    ⟨K₂, fK₂, i₂, algebraMap B K₂ a, b1, b2, b3, b4, b5⟩⟩

theorem wc_free_sheaf_two_open_cover_ext_inj (S : Scheme.{u}) (W W₁ W₂ : S.ProEt)
    (k₁ : W₁ ⟶ W) (k₂ : W₂ ⟶ W) (h₁ : IsOpenImmersion k₁.left) (h₂ : IsOpenImmersion k₂.left)
    (hdisj : Disjoint (Set.range k₁.left) (Set.range k₂.left))
    (hcov : Set.range k₁.left ∪ Set.range k₂.left = Set.univ)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q : ℕ) :
    ∀ x : Abelian.Ext (wcFreeSheaf S W) G q,
      (Abelian.Ext.mk₀ (wcFreeSheafMap S k₁)).comp x (zero_add q) = 0 →
      (Abelian.Ext.mk₀ (wcFreeSheafMap S k₂)).comp x (zero_add q) = 0 → x = 0 :=
by
  classical

  have hNat : ∃ e : ∀ (U : S.ProEt) (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U),
      ∀ (U V : S.ProEt) (f : U ⟶ V) (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (g : wcFreeSheaf S V ⟶ F),
        e U F (wcFreeSheafMap S f ≫ g) = F.obj.map f.op (e V F g) := by
    let e2 : ∀ (U : S.ProEt) (G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}),
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op U) :=
      fun U G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    let e : ∀ (U : S.ProEt) (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun U F =>
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 U F.obj)
    refine ⟨e, fun U V f F g => ?_⟩
    have hA := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g
    have hB := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map f) uliftFunctor.{u+1, u})
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g)
    have hC := uliftYonedaEquiv_naturality.{u+1} (F := F.obj ⋙ forget AddCommGrpCat.{u+1})
      ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u}) F.obj
        ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g)) f.op
    show uliftYonedaEquiv.{u+1} ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) F.obj
        ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F
          (wcFreeSheafMap S f ≫ g))) = _
    erw [hA, hB]
    exact hC.symm

  have hEmpty : ∀ (Z : S.ProEt), IsEmpty Z.left →
      ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (a b : F.obj.obj (Opposite.op Z)),
        a = b := by
    intro Z hZ F a b
    have hmem : Presieve.ofArrows (fun _ : PEmpty.{1} => Z) (fun i => i.elim) ∈
        (Scheme.ProEt.precoverage S).coverings Z := by
      rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      have hz := (Scheme.ofArrows_mem_precoverage_iff @IsOpenImmersion
        (X := fun _ : PEmpty.{1} => (Scheme.ProEt.forget S ⋙ Over.forget S).obj Z)
        (f := fun i => (Scheme.ProEt.forget S ⋙ Over.forget S).map i.elim)).mpr
        ⟨fun x => (hZ.false x).elim, fun i => i.elim⟩
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage _ hz,
        (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => (hZ.false x).elim, fun i => i.elim⟩⟩
    refine Sheaf.isSeparated F Z _ (Precoverage.generate_mem_toGrothendieck hmem) a b ?_
    intro Y f hf
    obtain ⟨Y', h, g', hg', -⟩ := hf
    rcases hg' with ⟨i⟩
    exact i.elim

  let X : Bool → S.ProEt := fun b => match b with
    | true => W₁
    | false => W₂
  let π : (b : Bool) → X b ⟶ W := fun b => match b with
    | true => k₁
    | false => k₂
  have hπ : ∀ b, IsOpenImmersion (π b).left := by
    intro b; cases b
    · exact h₂
    · exact h₁
  have hsurj : ∀ x : W.left, ∃ b, x ∈ Set.range (π b).left := by
    intro x
    have hx : x ∈ Set.range k₁.left ∪ Set.range k₂.left := hcov ▸ Set.mem_univ x
    rcases hx with h | h
    · exact ⟨true, h⟩
    · exact ⟨false, h⟩
  have hmemW : Presieve.ofArrows X π ∈ (Scheme.ProEt.precoverage S).coverings W := by
    rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    have hz := (Scheme.ofArrows_mem_precoverage_iff @IsOpenImmersion
      (X := fun b => (Scheme.ProEt.forget S ⋙ Over.forget S).obj (X b))
      (f := fun b => (Scheme.ProEt.forget S ⋙ Over.forget S).map (π b))).mpr
      ⟨hsurj, hπ⟩
    exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage _ hz,
      (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨hsurj, fun b => by
        have := hπ b
        show WeaklyEtale (π b).left
        infer_instance⟩⟩
  have hBij : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun s : F.obj.obj (Opposite.op W) =>
        (F.obj.map k₁.op s, F.obj.map k₂.op s)) := by
    intro F
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology S) (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj F).cond
    have hsF : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat.{u+1}) (Presieve.ofArrows X π) :=
      (Presieve.isSheafFor_iff_generate _).mpr
        (hsh _ (Precoverage.generate_mem_toGrothendieck hmemW))
    rw [Presieve.isSheafFor_arrows_iff] at hsF
    have hcompat : ∀ x : (b : Bool) → (F.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (X b)),
        Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat.{u+1}) π x := by
      intro x i j Z gi gj hij
      have e : gi.left ≫ (π i).left = gj.left ≫ (π j).left := congrArg (fun t => t.left) hij
      by_cases hij' : i = j
      · subst hij'
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          have := hπ i
          exact (cancel_mono (π i).left).mp e
        rw [hg]
      · have hZ : IsEmpty Z.left := by
          refine Scheme.isEmpty_of_commSq (f := (π i).left) (g := (π j).left)
            (i := gi.left) (j := gj.left) ⟨e⟩ ?_
          cases i <;> cases j
          · exact absurd rfl hij'
          · exact hdisj.symm
          · exact hdisj
          · exact absurd rfl hij'
        exact hEmpty Z hZ F _ _
    constructor
    · intro s s' hss
      simp only [Prod.mk.injEq] at hss
      obtain ⟨t, -, huniq⟩ := hsF (fun b => (F.obj ⋙ forget AddCommGrpCat.{u+1}).map (π b).op s)
        (hcompat _)
      have e1 := huniq s (fun b => rfl)
      have e2 := huniq s' (fun b => by
        cases b
        · exact hss.2.symm
        · exact hss.1.symm)
      exact e1.trans e2.symm
    · rintro ⟨a₁, a₂⟩
      obtain ⟨t, ht, -⟩ := hsF (fun b => match b with
        | true => a₁
        | false => a₂) (hcompat _)
      exact ⟨t, Prod.ext (ht true) (ht false)⟩

  obtain ⟨e, he⟩ := hNat
  have hΦ : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : wcFreeSheaf S W ⟶ F =>
        (wcFreeSheafMap S k₁ ≫ g, wcFreeSheafMap S k₂ ≫ g)) := by
    intro F
    have heq : (fun g : wcFreeSheaf S W ⟶ F => (wcFreeSheafMap S k₁ ≫ g, wcFreeSheafMap S k₂ ≫ g)) =
        (Equiv.prodCongr (e W₁ F).symm (e W₂ F).symm) ∘
          (fun s : F.obj.obj (Opposite.op W) => (F.obj.map k₁.op s, F.obj.map k₂.op s)) ∘
          (e W F) := by
      funext g
      exact Prod.ext ((Equiv.eq_symm_apply _).mpr (he _ _ k₁ F g))
        ((Equiv.eq_symm_apply _).mpr (he _ _ k₂ F g))
    rw [heq]
    exact (Equiv.bijective _).comp ((hBij F).comp (e W F).bijective)

  have hiso : IsIso (Limits.biprod.desc (wcFreeSheafMap S k₁) (wcFreeSheafMap S k₂)) := by
    apply isIso_of_coyoneda_map_bijective
    intro T
    have hβ : Function.Bijective (fun u : wcFreeSheaf S W₁ ⊞ wcFreeSheaf S W₂ ⟶ T =>
        (Limits.biprod.inl ≫ u, Limits.biprod.inr ≫ u)) := by
      constructor
      · intro u v huv
        simp only [Prod.mk.injEq] at huv
        exact Limits.biprod.hom_ext' _ _ huv.1 huv.2
      · rintro ⟨a, b⟩
        exact ⟨Limits.biprod.desc a b, by simp⟩
    have hcomp : (fun u : wcFreeSheaf S W₁ ⊞ wcFreeSheaf S W₂ ⟶ T =>
          (Limits.biprod.inl ≫ u, Limits.biprod.inr ≫ u)) ∘
        (fun g => Limits.biprod.desc (wcFreeSheafMap S k₁) (wcFreeSheafMap S k₂) ≫ g) =
        (fun g : wcFreeSheaf S W ⟶ T => (wcFreeSheafMap S k₁ ≫ g, wcFreeSheafMap S k₂ ≫ g)) := by
      funext g
      simp
    have h := hΦ T
    rw [← hcomp] at h
    exact (Function.Bijective.of_comp_iff' hβ _).mp h

  intro x hx1 hx2
  have hy : (Abelian.Ext.mk₀ (Limits.biprod.desc (wcFreeSheafMap S k₁) (wcFreeSheafMap S k₂))).comp
      x (zero_add q) = 0 := by
    apply Abelian.Ext.biprod_ext
    · rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Limits.biprod.inl_desc, hx1, Abelian.Ext.comp_zero]
    · rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Limits.biprod.inr_desc, hx2, Abelian.Ext.comp_zero]
  have hx : x = (Abelian.Ext.mk₀ (inv (Limits.biprod.desc (wcFreeSheafMap S k₁)
      (wcFreeSheafMap S k₂)))).comp ((Abelian.Ext.mk₀ (Limits.biprod.desc (wcFreeSheafMap S k₁)
        (wcFreeSheafMap S k₂))).comp x (zero_add q)) (zero_add q) := by
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  rw [hx, hy, Abelian.Ext.comp_zero]

theorem wc_proet_field_point_ladic_ext_one_line (S : Scheme.{u}) (U : S.ProEt) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (K : Type u) [Field K] (iK : U.left ≅ Spec (CommRingCat.of K)) (ϖ : K)
    (hℓK : ((ℓ : ℕ) : K) ≠ 0) (hϖ : ϖ ≠ 0)
    (hK1 : ∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m)
    (hK2 : ∀ m : ℕ, ∀ x : K, x ≠ 0 → ∃ (k : ℤ) (y : K), y ≠ 0 ∧ x = ϖ ^ k * y ^ (ℓ ^ m))
    (hK3 : ∀ m : ℕ, ∀ k : ℤ, (∃ y : K, ϖ ^ k = y ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k) :
    ∃ η : Abelian.Ext (wcFreeSheaf S U) (wcLadicSheaf S ℓ) 1 →+ ℚ_[ℓ], Function.Injective η ∧
      ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf S U) (wcLadicSheaf S ℓ) 1),
        η (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero 1)) = c * η x :=
by
  obtain ⟨τ, hτs, hτT⟩ := wc_contSheaf_rank_one_over_triv S U ℓ
  have key : ∀ (c : ℚ_[ℓ]) (V : (S.ProEt)ᵒᵖ) (x : ((wcContSheaf S ℚ_[ℓ]).obj.obj V : Type (u+1))),
      (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c)).hom.app V x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop V)))
          (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c)
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop V)),
            ℚ_[ℓ]))) : _) := by
    intro c V x; rfl
  have keyL : ∀ (c : ℚ_[ℓ]) (V : (S.ProEt)ᵒᵖ) (x : ((wcLadicSheaf S ℓ).obj.obj V : Type (u+1))),
      (wcLadicScalar S ℓ c).hom.app V x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙
          Over.forget S).obj (Opposite.unop V)), ℚ_[ℓ]))) : _) := by
    intro c V x; rfl
  have hL : ∀ c : ℚ_[ℓ], wcLadicScalar S ℓ c =
      (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c) :
        wcLadicSheaf S ℓ ⟶ wcLadicSheaf S ℓ) := by
    intro c
    apply Sheaf.hom_ext; apply NatTrans.ext; funext V; apply AddCommGrpCat.ext; intro x
    rw [keyL]
    exact (key c V x).symm
  have h2 : Spec.map (CommRingCat.ofHom ((RingEquiv.refl K : K ≃+* K) : K →+* K)) = 𝟙 _ := by
    first
    | rw [RingEquiv.toRingHom_refl, CommRingCat.ofHom_id, Spec.map_id]
    | (rw [show ((RingEquiv.refl K : K ≃+* K) : K →+* K) = RingHom.id K from rfl,
        CommRingCat.ofHom_id, Spec.map_id])
    | simp
  have h3 : iK.inv ≫ 𝟙 _ ≫ iK.hom = 𝟙 _ := by rw [Category.id_comp, Iso.inv_hom_id]
  have hτs' : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
          (wcLadicScalar S ℓ c) ≫ τ.hom =
        τ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin 1 → ℚ_[ℓ]) c)
            (continuous_const_smul c)) := by
    intro c
    rw [hL c]
    exact hτs c
  obtain ⟨ρL, Φ1, Φ0, -, hΦinj, hΦhom, -, hΦsc, -, -, -⟩ :=
    wc_field_point_ext_galois ℓ S U (𝟙 _) K iK (RingEquiv.refl K) (h3.trans h2.symm)
      (wcLadicSheaf S ℓ) (fun c => wcLadicScalar S ℓ c) 1 LinearMap.id τ hτs' hτT
  obtain ⟨γ, hγ0, -, -⟩ := wc_kummer_ladic_galois K ℓ 1 ϖ (RingEquiv.refl K) hℓK hϖ rfl
    hK1 hK2 hK3 (fun m ζ _ => pow_one ζ) 1
  let η : Abelian.Ext (wcFreeSheaf S U) (wcLadicSheaf S ℓ) 1 →+ ℚ_[ℓ] :=
    AddMonoidHom.mk' (fun x => Φ1 x γ 0) (fun x y => by rw [map_add]; rfl)
  refine ⟨η, ?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro x hx
    have hx' : Φ1 x γ 0 = 0 := hx
    have h1 : Φ1 x γ = 0 := by
      funext i
      rw [Fin.fin_one_eq_zero i]
      exact hx'
    have h4 : Φ1 x = 0 := hγ0 (Φ1 x) (hΦhom x).1 (hΦhom x).2 h1
    exact hΦinj (by rw [h4, map_zero])
  · intro c x
    show Φ1 (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero 1)) γ 0 = c * Φ1 x γ 0
    rw [hΦsc c x, Pi.smul_apply, Pi.smul_apply, smul_eq_mul]

theorem wc_pmn_tsl_node_local_coh_rank_two (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
