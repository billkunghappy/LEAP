    apply unitExt
    intro T
    have e1 : ∀ T' : V'.left.ProEt,
        ConcreteCategory.hom ((wcSliceUnit S' ℓ V').val.app (Opposite.op T'))
          (1 : (wcRingSheaf V'.left ℓ).obj.obj (Opposite.op T')) =
        (1 : (wcRingSheaf S' ℓ).obj.obj (Opposite.op ((wcSliceFunctor S' V').obj T'))) :=
      fun T' => rfl
    have e2 : ConcreteCategory.hom (((wcSliceRes S' ℓ V').map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC w) _ _ Dw.cont Dw.φ)).val.app (Opposite.op T))
        (1 : (wcRingSheaf S' ℓ).obj.obj (Opposite.op ((wcSliceFunctor S' V').obj T))) =
        (1 : (wcRingSheaf S' ℓ).obj.obj
          (Opposite.op ((wcProEtBC w).obj ((wcSliceFunctor S' V').obj T)))) :=
      (pfMapEval (F := wcSliceFunctor S' V') (R := wcRingSheaf S' ℓ) (𝟙 (wcRingSheaf V'.left ℓ)) _ T _).trans
        ((SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dw.φ
          (X := Opposite.op ((wcSliceFunctor S' V').obj T))
          (1 : (wcRingSheaf S' ℓ).obj.obj (Opposite.op ((wcSliceFunctor S' V').obj T)))).trans
          (map_one (ConcreteCategory.hom (Dw.φ.hom.app (Opposite.op ((wcSliceFunctor S' V').obj T))))))
    have e3 := hβw (SheafOfModules.unit (wcRingSheaf S' ℓ)) T
      (1 : (wcRingSheaf S' ℓ).obj.obj
          (Opposite.op ((wcProEtBC w).obj ((wcSliceFunctor S' V').obj T))))
    have e4 : ConcreteCategory.hom ((SheafOfModules.unit (wcRingSheaf S' ℓ)).val.map
        (zw.app T).op) (1 : (wcRingSheaf S' ℓ).obj.obj
          (Opposite.op ((wcProEtBC w).obj ((wcSliceFunctor S' V').obj T)))) =
        (1 : (wcRingSheaf S' ℓ).obj.obj
          (Opposite.op ((wcSliceFunctor S' V').obj ((wcProEtBC wU).obj T)))) :=
      PresheafOfModules.unit_map_one _ _
    have e5 : ConcreteCategory.hom ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC wU) _ _ DwU.cont DwU.φ).val.app (Opposite.op T))
        (1 : (wcRingSheaf V'.left ℓ).obj.obj (Opposite.op T)) =
        (1 : (wcRingSheaf V'.left ℓ).obj.obj (Opposite.op ((wcProEtBC wU).obj T))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply DwU.φ (X := Opposite.op T)
        (1 : (wcRingSheaf V'.left ℓ).obj.obj (Opposite.op T))).trans
        (map_one (ConcreteCategory.hom (DwU.φ.hom.app (Opposite.op T))))
    have e6 := pfMapEval DwU.φ (wcSliceUnit S' ℓ V') T
      (1 : (wcRingSheaf V'.left ℓ).obj.obj (Opposite.op ((wcProEtBC wU).obj T)))
    refine (compEval _ _ _ _).trans ((compEval _ _ _ _).trans ?_)
    refine Eq.trans ?_ (compEval _ _ _ _).symm
    refine (congrArg _ ((congrArg _ (e1 T)).trans e2)).trans (e3.trans (e4.trans ?_))
    exact ((congrArg _ e5).trans (e6.trans (e1 _))).symm
  intro α αU hφ hφU P Pw PU PwU γ γU
  subst hρ hρ'
  haveI := Df.cont
  haveI := Dw.cont
  haveI := DfU.cont
  haveI := DwU.cont
  obtain ⟨ζ, hζ⟩ := s1 f (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt)
    (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) fU hpbf
  obtain ⟨ζw, hζw⟩ := s1 w (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt)
    (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) wU hpbw
  obtain ⟨β, hβ⟩ := s2 f (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt)
    (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) fU Df hDf DfU hDfU ζ (fun T => (hζ T).1)
  obtain ⟨β₀, hβ₀⟩ := s2 w (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt)
    (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) wU Dw hDw DwU hDwU ζw (fun T => (hζw T).1)
  haveI := unitIsoAux ℓ (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt)
  refine ⟨β, β₀.hom, (asIso (wcSliceUnit S' ℓ
    (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt))).symm, ?_, ?_⟩
  · exact s4 (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt)
      (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) Df Dw DfU DwU α αU hφ hφU ζ.hom ζw.hom β β₀.hom hβ hβ₀
      (s3 (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt) (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) hwU α (alphaEval hcomp) αU (alphaEval hcompU) ζ.hom hζ ζw.hom hζw)
  · exact s5 (MorphismProperty.Over.mk ⊤ u' (inferInstance : WeaklyEtale u') : S'.ProEt) Dw DwU ζw.hom β₀.hom hβ₀

theorem wc_pltr_T_restrict {S S' Z U S'U ZU : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'}
    {g : Z ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (hcomp : w ≫ f = f)
    (u : U ⟶ S) [WeaklyEtale u] (u' : S'U ⟶ S') (fU : S'U ⟶ U) (hpbf : IsPullback u' fU f u)
    (uZ : ZU ⟶ Z) (gU : ZU ⟶ U) (hpbg : IsPullback uZ gU g u)
    (wU : S'U ⟶ S'U) (hcompU : wU ≫ fU = fU) (hwU : wU ≫ u' = u' ≫ w)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg) :
    (∀ (DfU : wcHMPullData fU ℓ), wcHMPullCanonical DfU →
      ∀ (DwU : wcHMPullData wU ℓ), wcHMPullCanonical DwU →
      ∀ (DgU : wcHMPullData gU ℓ), wcHMPullCanonical DgU →
      ∀ (IU : InjectiveResolution (SheafOfModules.unit (wcRingSheaf S'U ℓ))),
      haveI := DfU.cont
      haveI := DwU.cont
      haveI : (wcProEtBC fU ⋙ wcProEtBC wU).IsContinuous
          (Scheme.ProEt.topology U) (Scheme.ProEt.topology S'U) :=
        Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S'U) _
      let αU : wcProEtBC fU ⟶ wcProEtBC fU ⋙ wcProEtBC wU :=
        letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) fU :=
          ⟨fun _ _ => inferInstance⟩
        letI : MorphismProperty.IsStableUnderBaseChangeAlong
            (@WeaklyEtale : MorphismProperty Scheme.{u}) fU :=
          (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
            (inferInstance : Pr.IsStableUnderBaseChangeAlong fU))
            (@WeaklyEtale : MorphismProperty Scheme.{u})
        letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) wU :=
          ⟨fun _ _ => inferInstance⟩
        letI : MorphismProperty.IsStableUnderBaseChangeAlong
            (@WeaklyEtale : MorphismProperty Scheme.{u}) wU :=
          (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
            (inferInstance : Pr.IsStableUnderBaseChangeAlong wU))
            (@WeaklyEtale : MorphismProperty Scheme.{u})
        (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
          (Q := ⊤) _ _ _ hcompU.symm).hom
      haveI := DfU.additive
      haveI := DwU.additive
      haveI := DgU.additive
      ∀ (hφU : (DfU.φ ≫ ((wcProEtBC fU).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology U) (Scheme.ProEt.topology S'U)).map DwU.φ) ≫
          (Functor.sheafPushforwardContinuousNatTrans αU RingCat.{u+1}
            (Scheme.ProEt.topology U) (Scheme.ProEt.topology S'U)).app
            (wcRingSheaf S'U ℓ) = DfU.φ)
        (tU : (DwU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj IU.cochainComplex ⟶
          IU.cochainComplex),
        (DwU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map IU.ι' ≫ tU =
          (HomologicalComplex.singleMapHomologicalComplex DwU.Φ (ComplexShape.up ℤ) 0).hom.app
            (SheafOfModules.unit (wcRingSheaf S'U ℓ)) ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
            ((DwU.adj.homEquiv _ _).symm
              (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
                (wcProEtBC wU) _ _ DwU.cont DwU.φ)) ≫
          IU.ι' →
      let PU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC fU) _ _ DfU.cont DfU.φ
      haveI : PU.Additive := Adjunction.right_adjoint_additive DfU.adj
      let PwU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC wU) _ _ DwU.cont DwU.φ
      haveI : PwU.Additive := Adjunction.right_adjoint_additive DwU.adj
      let KU := (PU.mapHomologicalComplex (ComplexShape.up ℤ)).obj IU.cochainComplex
      let γU : PwU ⋙ PU ⟶ PU := (SheafOfModules.pushforwardComp DfU.φ DwU.φ).hom ≫
          SheafOfModules.pushforwardNatTrans _ αU ≫ (SheafOfModules.pushforwardCongr hφU).hom
      let TflatU := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
            IU.cochainComplex ≫
          (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ DwU.Φ ⋙ PwU from DwU.adj.unit)
            (ComplexShape.up ℤ)).app IU.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (DwU.Φ ⋙ PwU))
            (ComplexShape.up ℤ)).inv.app IU.cochainComplex ≫
          (PwU.mapHomologicalComplex (ComplexShape.up ℤ)).map tU
      let TU : KU ⟶ KU := (PU.mapHomologicalComplex (ComplexShape.up ℤ)).map TflatU ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (PwU ⋙ PU))
            (ComplexShape.up ℤ)).hom.app IU.cochainComplex ≫
          (NatTrans.mapHomologicalComplex γU (ComplexShape.up ℤ)).app IU.cochainComplex
      let TΨU := (DgU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map TU
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf ZU ℓ))
      DerivedCategory.Q.map TΨU ≠ 𝟙 _) →
    ∀ (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf S' ℓ))),
      haveI := Df.cont
      haveI := Dw.cont
      haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
        Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
      let α : wcProEtBC f ⟶ wcProEtBC f ⋙ wcProEtBC w :=
        letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
          ⟨fun _ _ => inferInstance⟩
        letI : MorphismProperty.IsStableUnderBaseChangeAlong
            (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
          (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
            (inferInstance : Pr.IsStableUnderBaseChangeAlong f))
            (@WeaklyEtale : MorphismProperty Scheme.{u})
        letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
          ⟨fun _ _ => inferInstance⟩
        letI : MorphismProperty.IsStableUnderBaseChangeAlong
            (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
          (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
            (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
            (@WeaklyEtale : MorphismProperty Scheme.{u})
        (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
          (Q := ⊤) _ _ _ hcomp.symm).hom
      haveI := Df.additive
      haveI := Dw.additive
      haveI := Dg.additive
      ∀ (hφ : (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dw.φ) ≫
          (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
            (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).app
            (wcRingSheaf S' ℓ) = Df.φ)
        (t : (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
          I.cochainComplex),
        (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
          (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
            (SheafOfModules.unit (wcRingSheaf S' ℓ)) ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
            ((Dw.adj.homEquiv _ _).symm
              (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
                (wcProEtBC w) _ _ Dw.cont Dw.φ)) ≫
          I.ι' →
      let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC f) _ _ Df.cont Df.φ
      haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
      let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC w) _ _ Dw.cont Dw.φ
      haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
      let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
      let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
          SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
      let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
            I.cochainComplex ≫
          (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dw.Φ ⋙ Pw from Dw.adj.unit)
            (ComplexShape.up ℤ)).app I.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Dw.Φ ⋙ Pw))
            (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
      let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
            (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
          (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
      let TΨ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
      DerivedCategory.Q.map TΨ ≠ 𝟙 _ :=
by
  classical
  intro H I α hφ t hLP P Pw K γ Tflat T TΨ hQ
  haveI := Df.cont
  haveI := Dw.cont
  haveI := Df.additive
  haveI := Dw.additive
  haveI := Dg.additive
  haveI hPadd : P.Additive := Adjunction.right_adjoint_additive Df.adj
  haveI hPwadd : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj

  haveI hu' : WeaklyEtale u' :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpbf.flip (inferInstance : WeaklyEtale u)

  have hs : IsPullback u' (wU ≫ fU) (w ≫ f) u := by rw [hcompU, hcomp]; exact hpbf
  have hpbw : IsPullback u' wU w u' := IsPullback.of_bot hs hwU.symm hpbf

  obtain ⟨hcV, -, -⟩ := wc_lpsc_site S (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt)
  obtain ⟨hcV', -, -⟩ := wc_lpsc_site S' (MorphismProperty.Over.mk ⊤ u' hu' : S'.ProEt)
  haveI := hcV
  haveI := hcV'

  obtain ⟨ρ, hρ⟩ : ∃ ρ : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤
      SheafOfModules.{u+1} (wcRingSheaf U ℓ),
      ρ = wcSliceRes S ℓ (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt) := ⟨_, rfl⟩
  obtain ⟨ρ', hρ'⟩ : ∃ ρ' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ) ⥤
      SheafOfModules.{u+1} (wcRingSheaf S'U ℓ),
      ρ' = wcSliceRes S' ℓ (MorphismProperty.Over.mk ⊤ u' hu' : S'.ProEt) := ⟨_, rfl⟩
  obtain ⟨hρadd, -, -⟩ : ρ.Additive ∧ Limits.PreservesFiniteLimits ρ ∧
      Limits.PreservesFiniteColimits ρ := by
    rw [hρ]; exact wc_slice_res_exact S ℓ (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt)
  obtain ⟨hρ'add, hρ'lim, hρ'colim⟩ : ρ'.Additive ∧ Limits.PreservesFiniteLimits ρ' ∧
      Limits.PreservesFiniteColimits ρ' := by
    rw [hρ']; exact wc_slice_res_exact S' ℓ (MorphismProperty.Over.mk ⊤ u' hu' : S'.ProEt)

  obtain ⟨DfU, hDfU⟩ := wc_hm_pull_data_exists fU ℓ
  obtain ⟨DwU, hDwU⟩ := wc_hm_pull_data_exists wU ℓ
  obtain ⟨DgU, hDgU⟩ := wc_hm_pull_data_exists gU ℓ
  obtain ⟨DuZ, hDuZ⟩ := wc_hm_pull_data_exists uZ ℓ
  obtain ⟨Du, hDu⟩ := wc_hm_pull_data_exists u ℓ
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (uZ ≫ g) ℓ
  haveI := DfU.cont
  haveI := DwU.cont
  haveI := DfU.additive
  haveI := DwU.additive
  haveI := DgU.additive
  haveI := DuZ.additive
  haveI := DuZ.presLim
  haveI := DuZ.presColim
  let PU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC fU) _ _ DfU.cont DfU.φ
  let PwU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC wU) _ _ DwU.cont DwU.φ
  haveI hPUadd : PU.Additive := Adjunction.right_adjoint_additive DfU.adj
  haveI hPwUadd : PwU.Additive := Adjunction.right_adjoint_additive DwU.adj
  have hφU := wc_pmn_compat hcompU DfU hDfU DwU hDwU

  obtain ⟨β, βw, μ', hBC4, hBC6'⟩ := wc_pltr_slice_push_bc hcomp u u' fU hpbf wU hcompU hwU hpbw
    Df hDf Dw hDw DfU hDfU DwU hDwU ρ hρ ρ' hρ' hφ hφU

  obtain ⟨α', hBC3, hBC6⟩ := wc_pltr_abs_mate Dw.adj DwU.adj ρ' βw _ _ μ' _ _ hBC6'

  obtain ⟨IU, θ, hθ⟩ := wc_pltr_exact_injres ρ'
    (fun J hJ => by
      haveI := hJ
      rw [hρ']
      exact wc_slice_res_preserves_injective S' ℓ
        (MorphismProperty.Over.mk ⊤ u' hu' : S'.ProEt) J)
    _ _ μ' I

  let tU : (DwU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj IU.cochainComplex ⟶
      IU.cochainComplex :=
    (DwU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map θ.inv ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (ρ' ⋙ DwU.Φ))
        (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex α' (ComplexShape.up ℤ)).app I.cochainComplex ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Dw.Φ ⋙ ρ'))
        (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
      (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).map t ≫ θ.hom
  have hLPU := wc_pltr_abs_lift Dw.Φ DwU.Φ ρ' α' _ _ μ' _ _ hBC6 I.cochainComplex I.ι'
    IU.cochainComplex IU.ι' θ hθ t hLP tU rfl

  let δ : Dg.Φ ⋙ DuZ.Φ ≅ ρ ⋙ DgU.Φ :=
    (wc_hm_pull_data_comp_Phi_iso g uZ (uZ ≫ g) rfl Dg hDg DuZ hDuZ Dk hDk).some.symm ≪≫
      (wc_hm_pull_data_comp_Phi_iso u gU (uZ ≫ g) hpbg.w.symm Du hDu DgU hDgU Dk hDk).some ≪≫
      Functor.isoWhiskerRight
        ((wc_hm_pull_Phi_slice_iso S ℓ (MorphismProperty.Over.mk ⊤ u (inferInstance : WeaklyEtale u) : S.ProEt)
          Du hDu).some ≪≫ eqToIso hρ.symm) DgU.Φ

  obtain ⟨χ, hχ⟩ := wc_pltr_abs_conj P Pw Dw.Φ Dg.Φ Dw.adj γ PU PwU DwU.Φ DgU.Φ DwU.adj _
    ρ' ρ DuZ.Φ β βw α' δ hBC3 hBC4 I.cochainComplex IU.cochainComplex θ t tU rfl T rfl _ rfl

  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf ZU ℓ))
  have hQU := wc_pltr_derived_conj DuZ.Φ _ TΨ hQ _ _ χ hχ
  exact H DfU hDfU DwU hDwU DgU hDgU IU hφU tU hLPU hQU

theorem wc_qmssl_mv_exact : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)]
      (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    WeaklyEtale a₀ →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B))
      (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (wcQmSp A) →
    ∀ (D₁ : Scheme.{u}) (i₁ : D₁ ⟶ Xs)
      (k₁ : D₁ ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))}))),
    IsPullback i₁ k₁ ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (D₂ : Scheme.{u}) (i₂ : D₂ ⟶ Xs)
      (k₂ : D₂ ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback i₂ k₂ ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (Y : Scheme.{u}) (iY : Y ⟶ Xs)
      (kY : Y ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback iY kY ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (E₁ : wcHMPullData i₁ ℓ), wcHMPullCanonical E₁ →
    ∀ (E₂ : wcHMPullData i₂ ℓ), wcHMPullCanonical E₂ →
    ∀ (EY : wcHMPullData iY ℓ), wcHMPullCanonical EY →
    ∃ (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
      (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
        Limits.biprod.desc ρ₁ (-ρ₂) = 0),
      (ShortComplex.mk _ _ hz).ShortExact :=
by
  intro A _ _ _ _ _ ℓ _ _hℓ π hπ r B _ _ _ a₀ _ha₀ _hx0 _hx1 Xs ι s hps D₁ i₁ k₁ hD1 D₂ i₂ k₂ hD2
    Y iY kY hDY E₁ hE₁ E₂ hE₂ EY hEY
  classical

  have s1 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
      {L E₁ E₂ EY : 𝒞} (u₁ : L ⟶ E₁) (u₂ : L ⟶ E₂) (uY : L ⟶ EY)
      (hu₁ : Epi u₁) (hu₂ : Epi u₂) (huY : Epi uY)
      (ρ₁ : E₁ ⟶ EY) (ρ₂ : E₂ ⟶ EY) (h₁ : u₁ ≫ ρ₁ = uY) (h₂ : u₂ ≫ ρ₂ = uY)
      (hmono : ∀ {P : 𝒞} (g : P ⟶ L), g ≫ u₁ = 0 → g ≫ u₂ = 0 → g = 0)
      (hsplit : ∀ {P : 𝒞} (d : P ⟶ L), d ≫ uY = 0 →
        ∃ k₁ k₂ : P ⟶ L, k₁ ≫ u₁ = 0 ∧ k₂ ≫ u₂ = 0 ∧ d = k₁ + k₂)
      (hz : Limits.biprod.lift u₁ u₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0),
      (ShortComplex.mk _ _ hz).ShortExact := by
    intro 𝒞 _ _ L E₁ E₂ EY u₁ u₂ uY hu₁ hu₂ huY ρ₁ ρ₂ h₁ h₂ hmono hsplit hz
    have hmf : Mono (Limits.biprod.lift u₁ u₂) := by
      apply Preadditive.mono_of_cancel_zero
      intro P q hq
      apply hmono q
      · have := congrArg (· ≫ Limits.biprod.fst) hq
        simpa using this
      · have := congrArg (· ≫ Limits.biprod.snd) hq
        simpa using this
    have hρ₁ : Epi ρ₁ := epi_of_epi_fac h₁
    have heg : Epi (Limits.biprod.desc ρ₁ (-ρ₂)) := epi_of_epi_fac (Limits.biprod.inl_desc ρ₁ (-ρ₂))
    refine @ShortComplex.ShortExact.mk _ _ _ _ ?_ hmf heg
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro P (x₂ : P ⟶ E₁ ⊞ E₂) hx₂
    have hx₂' : x₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0 := hx₂
    set y₁ := x₂ ≫ Limits.biprod.fst
    set y₂ := x₂ ≫ Limits.biprod.snd
    have hstar : y₁ ≫ ρ₁ = y₂ ≫ ρ₂ := by
      have e : x₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = y₁ ≫ ρ₁ - y₂ ≫ ρ₂ := by
        rw [Limits.biprod.desc_eq]
        simp [y₁, y₂, Preadditive.comp_add, Preadditive.comp_neg, sub_eq_add_neg]
      rw [hx₂'] at e
      exact (sub_eq_zero.mp e.symm)
    obtain ⟨P₁, π₁, hπ₁, a₁, ha₁⟩ := surjective_up_to_refinements_of_epi u₁ y₁
    obtain ⟨P₂, π₂, hπ₂, a₂, ha₂⟩ := surjective_up_to_refinements_of_epi u₂ (π₁ ≫ y₂)
    have e1 : a₁ ≫ uY = π₁ ≫ y₁ ≫ ρ₁ := by
      rw [← h₁, ← Category.assoc, ← ha₁, Category.assoc]
    have e2 : a₂ ≫ uY = π₂ ≫ π₁ ≫ y₂ ≫ ρ₂ := by
      rw [← h₂, ← Category.assoc, ← ha₂]
      simp only [Category.assoc]
    obtain ⟨k₁, k₂, hk₁, hk₂, hd⟩ := hsplit (π₂ ≫ a₁ - a₂) (by
      rw [Preadditive.sub_comp, Category.assoc, e1, e2, hstar, sub_self])
    refine ⟨P₂, π₂ ≫ π₁, epi_comp _ _, π₂ ≫ a₁ - k₁, ?_⟩
    apply Limits.biprod.hom_ext
    · show ((π₂ ≫ π₁) ≫ x₂) ≫ Limits.biprod.fst =
        ((π₂ ≫ a₁ - k₁) ≫ Limits.biprod.lift u₁ u₂) ≫ Limits.biprod.fst
      simp only [Category.assoc, Limits.biprod.lift_fst, Preadditive.sub_comp, hk₁, sub_zero]
      change π₂ ≫ π₁ ≫ y₁ = _
      rw [ha₁]
    · show ((π₂ ≫ π₁) ≫ x₂) ≫ Limits.biprod.snd =
        ((π₂ ≫ a₁ - k₁) ≫ Limits.biprod.lift u₁ u₂) ≫ Limits.biprod.snd
      simp only [Category.assoc, Limits.biprod.lift_snd]
      have e : π₂ ≫ a₁ - k₁ = a₂ + k₂ := by
        have h' := hd
        rw [sub_eq_iff_eq_add] at h'
        rw [h']
        abel
      rw [e, Preadditive.add_comp, hk₂, add_zero, ← ha₂]

  have s2 : ∀ {X : Scheme.{u}} {i : X ⟶ Xs} (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E)
      {P : SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)}
      (g : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ)),
      g ≫ wcSuppUnitMap E = 0 ↔
        ∀ (V : Xs.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left),
          V.hom x ∈ Set.range i →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p)) x = 0 := by
    intro X i E hE P g
    constructor
    · intro h0 V p x hx
      have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom p) h0
      change ((wcSuppUnitMap E).val.app (Opposite.op V)).hom
        ((g.val.app (Opposite.op V)).hom p) = 0 at hk
      have hx' : x ∈ Set.range (Limits.pullback.fst V.hom i) := by
        rw [Scheme.Pullback.range_fst]; exact hx
      obtain ⟨z, rfl⟩ := hx'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit E
      have htw := wc_supp_hom_twist_formula E hE (wcSuppUnitMap E) V
        ((g.val.app (Opposite.op V)).hom p)
      rw [hk] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
      have h2 := congrArg (fun φ : C(↥X, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd V.hom i).base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
              ((Limits.pullback.fst V.hom i).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap E))
              ((Limits.pullback.snd V.hom i).base.hom z) := h1
      show (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
        ((Limits.pullback.fst V.hom i).base.hom z) = 0
      linear_combination
        (-(c' ((Limits.pullback.snd V.hom i).base.hom z))) * h1' -
        ((@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
          ((Limits.pullback.fst V.hom i).base.hom z)) * h2
    · intro hv
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro p
      induction W using Opposite.rec with
      | op W =>
      change ((wcSuppUnitMap E).val.app (Opposite.op W)).hom
        ((g.val.app (Opposite.op W)).hom p) = 0
      have htw := wc_supp_hom_twist_formula E hE (wcSuppUnitMap E) W
        ((g.val.app (Opposite.op W)).hom p)
      refine htw.trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst W.hom i).base z) ∈ Set.range i :=
        ⟨(Limits.pullback.snd W.hom i).base z,
          (congrArg (fun φ => φ.base z) (Limits.pullback.condition (f := W.hom) (g := i))).symm⟩
      have h0 := hv W p _ hz
      show (@id C(↥W.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op W)).hom p))
          ((Limits.pullback.fst W.hom i).base.hom z) *
        (wcSuppTwist (wcSuppUnitMap E)) ((Limits.pullback.snd W.hom i).base.hom z) = 0
      rw [h0, zero_mul]

  have s3 : ∀ (Z₁ Z₂ : Set ↥Xs) (hZ₁ : IsClosed Z₁) (hZ₂ : IsClosed Z₂)
      (hcov : ∀ y : ↥Xs, y ∈ Z₁ ∨ y ∈ Z₂)
      {P : SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)}
      (d : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ))
      (hd : ∀ (V : Xs.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left),
        V.hom x ∈ Z₁ → V.hom x ∈ Z₂ →
        (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((d.val.app (Opposite.op V)).hom p)) x = 0),
      ∃ k₁ k₂ : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ), d = k₁ + k₂ ∧
        (∀ (V : Xs.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left), V.hom x ∈ Z₁ →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((k₁.val.app (Opposite.op V)).hom p)) x = 0) ∧
        (∀ (V : Xs.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left), V.hom x ∈ Z₂ →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((k₂.val.app (Opposite.op V)).hom p)) x = 0) := by
    intro Z₁ Z₂ hZ₁ hZ₂ hcov P d hd
    classical
    let ds : ∀ (V : Xs.ProEt), P.val.obj (Opposite.op V) → C(↥V.left, ULift.{u+1} ℚ_[ℓ]) :=
      fun V p => (d.val.app (Opposite.op V)).hom p
    let pst : ∀ (V : Xs.ProEt), P.val.obj (Opposite.op V) → C(↥V.left, ULift.{u+1} ℚ_[ℓ]) :=
      fun V p => ⟨fun x => if V.hom x ∈ Z₁ then ds V p x else 0, by
        have hA₁ : IsClosed (V.hom ⁻¹' Z₁) := hZ₁.preimage V.hom.continuous
        have hA₂ : IsClosed (V.hom ⁻¹' Z₂) := hZ₂.preimage V.hom.continuous
        have hU : (V.hom ⁻¹' Z₁ ∪ V.hom ⁻¹' Z₂) = Set.univ :=
          Set.eq_univ_of_forall (fun x => hcov (V.hom x))
        rw [← continuousOn_univ, ← hU]
        refine ContinuousOn.union_of_isClosed ?_ ?_ hA₁ hA₂
        · exact (ds V p).continuous.continuousOn.congr (fun x hx => if_pos hx)
        · refine (continuousOn_const (c := (0 : ULift.{u+1} ℚ_[ℓ]))).congr (fun x hx => ?_)
          by_cases h : V.hom x ∈ Z₁
          · rw [if_pos h]; exact hd V p x h hx
          · rw [if_neg h]⟩
    have hpst : ∀ V p x, pst V p x = if V.hom x ∈ Z₁ then ds V p x else 0 := fun _ _ _ => rfl
    have hds_add : ∀ V (p q : P.val.obj (Opposite.op V)), ds V (p + q) = ds V p + ds V q :=
      fun V p q => map_add _ p q
    have hds_smul : ∀ (V : Xs.ProEt) (r : (wcRingSheaf Xs ℓ).obj.obj (Opposite.op V))
        (p : P.val.obj (Opposite.op V)),
        ds V (r • p) = (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) r) * ds V p :=
      fun V r p => map_smul (d.val.app (Opposite.op V)).hom r p
    have hds_nat : ∀ {V W : Xs.ProEt} (g : W ⟶ V) (p : P.val.obj (Opposite.op V)),
        ds W ((P.val.map g.op).hom p) = (ds V p).comp g.left.base.hom := by
      intro V W g p
      exact PresheafOfModules.naturality_apply d.val g.op p
    let φ : P.val.presheaf ⟶ (SheafOfModules.unit (wcRingSheaf Xs ℓ)).val.presheaf :=
      { app := fun X => AddCommGrpCat.ofHom
          { toFun := fun p => (pst X.unop p : C(↥X.unop.left, ULift.{u+1} ℚ_[ℓ]))
            map_zero' := by
              apply ContinuousMap.ext; intro x
              rw [hpst]
              split_ifs
              · rw [show ds X.unop 0 = 0 from map_zero _]; rfl
              · rfl
            map_add' := by
              intro p q
              apply ContinuousMap.ext; intro x
              change pst X.unop (p + q) x = pst X.unop p x + pst X.unop q x
              rw [hpst, hpst, hpst, hds_add]
              split_ifs
              · rfl
              · rw [add_zero] }
        naturality := by
          intro X Y g
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro p
          apply ContinuousMap.ext
          intro y
          have hw : Y.unop.hom y = X.unop.hom (g.unop.left y) := by
            exact (congrArg (fun k => k.base y) (MorphismProperty.Over.w g.unop)).symm
          show (if Y.unop.hom y ∈ Z₁ then ds Y.unop ((P.val.map g).hom p) y else 0) =
            (if X.unop.hom (g.unop.left y) ∈ Z₁ then ds X.unop p (g.unop.left y) else 0)
          rw [hw]
          split_ifs
          · exact congrArg (fun f : C(↥Y.unop.left, ULift.{u+1} ℚ_[ℓ]) => f y) (hds_nat g.unop p)
          · rfl }
    let k₂ : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ) :=
      ⟨PresheafOfModules.homMk φ (by
        intro X r p
        apply ContinuousMap.ext
        intro x
        show (if X.unop.hom x ∈ Z₁ then ds X.unop (r • p) x else 0) =
          (@id C(↥X.unop.left, ULift.{u+1} ℚ_[ℓ]) r) x *
            (if X.unop.hom x ∈ Z₁ then ds X.unop p x else 0)
        rw [hds_smul]
        split_ifs
        · rfl
        · rw [mul_zero])⟩
    have hk₂ : ∀ (V : Xs.ProEt) (p : P.val.obj (Opposite.op V)), (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((k₂.val.app (Opposite.op V)).hom p)) =
        pst V p := fun V p => rfl
    refine ⟨d - k₂, k₂, (sub_add_cancel d k₂).symm, ?_, ?_⟩
    · intro V p x hx
      change (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) (((d.val - k₂.val).app (Opposite.op V)).hom p)) x = 0
      rw [PresheafOfModules.sub_app, ModuleCat.hom_sub, LinearMap.sub_apply]
      change (ds V p - pst V p) x = 0
      rw [ContinuousMap.sub_apply, hpst, if_pos hx, sub_self]
    · intro V p x hx
      rw [hk₂, hpst]
      split_ifs with h
      · exact hd V p x h hx
      · rfl

  have s5 : ∀ {J : Ideal B} {D : Scheme.{u}} (i : D ⟶ Xs) (k : D ⟶ Spec (.of (B ⧸ J))),
      IsPullback i k ι (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) →
      IsClosedImmersion i ∧ ∀ x : ↥Xs, x ∈ Set.range i ↔ J ≤ PrimeSpectrum.asIdeal (ι x) := by
    intro J D i k h
    have hci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    refine ⟨MorphismProperty.of_isPullback (P := @IsClosedImmersion) h.flip hci, ?_⟩
    intro x
    have hr : Set.range i = Set.range (Limits.pullback.fst ι
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨h.isoPullback.hom z, by rw [← Scheme.Hom.comp_apply, h.isoPullback_hom_fst]⟩
      · rintro ⟨z, rfl⟩
        exact ⟨h.isoPullback.inv z, by rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]⟩
    rw [hr, Scheme.Pullback.range_fst, Set.mem_preimage]
    have hS : Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) =
        PrimeSpectrum.zeroLocus (J : Set B) := by
      have := range_comap_of_surjective (B ⧸ J) (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker] at this
      rw [← this]
      rfl
    rw [hS]
    exact PrimeSpectrum.mem_zeroLocus (ι x) (J : Set B)

  have hπ' : π ∈ IsLocalRing.maximalIdeal A := hπ ▸ Ideal.mem_span_singleton_self π
  have hw := hps.w
  have s4 : ∀ x : Xs, (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) * (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ PrimeSpectrum.asIdeal (ι x) := by
    intro x
    have hπ := hπ'
    have key : ∀ {R S : CommRingCat.{u}} (g : R ⟶ S) (y : Spec S),
        ((Spec.map g) y).asIdeal = Ideal.comap g.hom y.asIdeal := fun g y => rfl
    have hrel : ∀ (c₀ : Matrix (Fin (r + 2)) (Fin (r + 2)) A),
        c₀ = (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c₀)
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c₀)
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
        algebraMap A (wcQuadModelRing A (r + 2) π c₀) π := by
      intro c₀ hc₀
      have hsum : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin (r + 2)) A) =
          MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
            MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
        rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
        · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
          · rw [hc₀, Matrix.of_apply, if_pos ⟨rfl, rfl⟩, map_one, one_mul]
          · intro q hq
            have : ¬ (q.val = 1) := fun h => hq (Fin.ext h)
            rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
        · intro p hp
          apply Finset.sum_eq_zero
          intro q _
          have : ¬ (p.val = 0) := fun h => hp (Fin.ext h)
          rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
      have hmem : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π : MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π c₀ :=
        Ideal.mem_span_singleton_self _
      rw [hsum] at hmem
      have hal : algebraMap A (wcQuadModelRing A (r + 2) π c₀) π =
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c₀) (MvPolynomial.C π) := by
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      rw [hal, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact hmem
    have h1 := congrArg (fun f => f x) hw
    simp only [Scheme.Hom.comp_apply] at h1
    have h2 := congrArg PrimeSpectrum.asIdeal h1
    rw [← Spec.map_preimage a₀] at h2
    simp only [wcQuadModelStr, wcQmSp, key] at h2
    haveI := (s x).isPrime
    rw [Ideal.eq_bot_of_prime (s x).asIdeal, ← RingHom.ker_eq_comap_bot] at h2
    change _ = RingHom.ker (IsLocalRing.residue A) at h2
    rw [IsLocalRing.ker_residue] at h2
    have h3 : π ∈ Ideal.comap (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))).hom
        (Ideal.comap (Spec.preimage a₀).hom (ι x).asIdeal) := by
      rw [h2]; exact hπ
    rw [Ideal.mem_comap, Ideal.mem_comap] at h3
    rw [← map_mul, hrel _ rfl]
    exact h3

  obtain ⟨hci₁, hr₁⟩ := s5 i₁ k₁ hD1
  obtain ⟨hci₂, hr₂⟩ := s5 i₂ k₂ hD2
  obtain ⟨hciY, hrY⟩ := s5 iY kY hDY
  have R₁ : ∀ x : Xs, x ∈ Set.range i₁ ↔ (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ PrimeSpectrum.asIdeal (ι x) := fun x =>
    (hr₁ x).trans (Ideal.span_singleton_le_iff_mem _)
  have R₂ : ∀ x : Xs, x ∈ Set.range i₂ ↔ (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ PrimeSpectrum.asIdeal (ι x) := fun x =>
    (hr₂ x).trans (Ideal.span_singleton_le_iff_mem _)
  have RY : ∀ x : Xs, x ∈ Set.range iY ↔ ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ PrimeSpectrum.asIdeal (ι x) ∧
      (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ PrimeSpectrum.asIdeal (ι x)) := fun x => by
    rw [hrY x, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    rfl

  have G1 : ∀ x : Xs, x ∈ Set.range i₁ ∨ x ∈ Set.range i₂ := fun x => by
    rw [R₁, R₂]; exact (ι x).isPrime.mem_or_mem (s4 x)
  have G2 : ∀ x : Xs, x ∈ Set.range i₁ → x ∈ Set.range i₂ → x ∈ Set.range iY := fun x h1 h2 =>
    (RY x).2 ⟨(R₁ x).1 h1, (R₂ x).1 h2⟩
  have G31 : ∀ x : Xs, x ∈ Set.range iY → x ∈ Set.range i₁ := fun x h => (R₁ x).2 ((RY x).1 h).1
  have G32 : ∀ x : Xs, x ∈ Set.range iY → x ∈ Set.range i₂ := fun x h => (R₂ x).2 ((RY x).1 h).2

  haveI hu₁ : Epi (wcSuppUnitMap E₁) := wc_supp_unit_epi_of_closed i₁ ℓ E₁ hE₁
  haveI hu₂ : Epi (wcSuppUnitMap E₂) := wc_supp_unit_epi_of_closed i₂ ℓ E₂ hE₂
  haveI huY : Epi (wcSuppUnitMap EY) := wc_supp_unit_epi_of_closed iY ℓ EY hEY

  have hk₁ : Limits.kernel.ι (wcSuppUnitMap E₁) ≫ wcSuppUnitMap EY = 0 := by
    have hv := (s2 E₁ hE₁ _).1 (Limits.kernel.condition _)
    exact (s2 EY hEY _).2 (fun V p x hx => hv V p x (G31 _ hx))
  have hk₂ : Limits.kernel.ι (wcSuppUnitMap E₂) ≫ wcSuppUnitMap EY = 0 := by
    have hv := (s2 E₂ hE₂ _).1 (Limits.kernel.condition _)
    exact (s2 EY hEY _).2 (fun V p x hx => hv V p x (G32 _ hx))
  let ρ₁ := Abelian.epiDesc (wcSuppUnitMap E₁) (wcSuppUnitMap EY) hk₁
  let ρ₂ := Abelian.epiDesc (wcSuppUnitMap E₂) (wcSuppUnitMap EY) hk₂
  have h₁ : wcSuppUnitMap E₁ ≫ ρ₁ = wcSuppUnitMap EY := Abelian.comp_epiDesc _ _ _
  have h₂ : wcSuppUnitMap E₂ ≫ ρ₂ = wcSuppUnitMap EY := Abelian.comp_epiDesc _ _ _

  have hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0 := by
    rw [Limits.biprod.lift_desc, Preadditive.comp_neg, h₁, h₂, add_neg_cancel]

  have hmono : ∀ {P : SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)}
      (g : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ)),
      g ≫ wcSuppUnitMap E₁ = 0 → g ≫ wcSuppUnitMap E₂ = 0 → g = 0 := by
    intro P g hg₁ hg₂
    have v₁ := (s2 E₁ hE₁ g).1 hg₁
    have v₂ := (s2 E₂ hE₂ g).1 hg₂
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro p
    induction W using Opposite.rec with
    | op W =>
    change (@id C(↥W.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op W)).hom p)) = 0
    apply ContinuousMap.ext
    intro x
    rcases G1 (W.hom x) with h | h
    · exact v₁ W p x h
    · exact v₂ W p x h

  have hsplit : ∀ {P : SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)}
      (d : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ)), d ≫ wcSuppUnitMap EY = 0 →
      ∃ k₁ k₂ : P ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ),
        k₁ ≫ wcSuppUnitMap E₁ = 0 ∧ k₂ ≫ wcSuppUnitMap E₂ = 0 ∧ d = k₁ + k₂ := by
    intro P d hd
    have vY := (s2 EY hEY d).1 hd
    obtain ⟨k₁, k₂, hdk, hv₁, hv₂⟩ := s3 (Set.range i₁) (Set.range i₂)
      (Scheme.Hom.isClosedEmbedding i₁).isClosed_range
      (Scheme.Hom.isClosedEmbedding i₂).isClosed_range G1 d
      (fun V p x h1 h2 => vY V p x (G2 _ h1 h2))
    exact ⟨k₁, k₂, (s2 E₁ hE₁ k₁).2 hv₁, (s2 E₂ hE₂ k₂).2 hv₂, hdk⟩

  exact ⟨ρ₁, ρ₂, hz, s1 _ _ _ hu₁ hu₂ huY ρ₁ ρ₂ h₁ h₂ hmono hsplit hz⟩

theorem wc_qmssl_nu_ne_zero : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)]
      (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    WeaklyEtale a₀ →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B))
      (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (wcQmSp A) →
    ∀ (D₁ : Scheme.{u}) (i₁ : D₁ ⟶ Xs)
      (k₁ : D₁ ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))}))),
    IsPullback i₁ k₁ ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (D₂ : Scheme.{u}) (i₂ : D₂ ⟶ Xs)
      (k₂ : D₂ ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback i₂ k₂ ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (Y : Scheme.{u}) (iY : Y ⟶ Xs)
      (kY : Y ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback iY kY ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (E₁ : wcHMPullData i₁ ℓ), wcHMPullCanonical E₁ →
    ∀ (E₂ : wcHMPullData i₂ ℓ), wcHMPullCanonical E₂ →
    ∀ (EY : wcHMPullData iY ℓ), wcHMPullCanonical EY →
    ∀ (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
      (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
        Limits.biprod.desc ρ₁ (-ρ₂) = 0)
      (hS : (ShortComplex.mk _ _ hz).ShortExact),
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    hS.singleδ ≠ 0 :=
by
  intro A _ _ _ _ _ ℓ _ _hℓ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 Xs ι s hps D₁ i₁ k₁ hD1 D₂ i₂ k₂ hD2
    Y iY kY hDY E₁ _hE₁ E₂ _hE₂ EY _hEY ρ₁ ρ₂ hz hS
  classical
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
  intro hδ

  obtain ⟨ρ, hρ⟩ : ∃ ρ : (wcSuppObj E₁ ⊞ wcSuppObj E₂) ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ),
      Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫ ρ = 𝟙 _ := by
    have hT := hS.singleTriangle_distinguished
    have hm3 : hS.singleTriangle.mor₃ = 0 := (hS.singleTriangle_mor₃).trans hδ
    obtain ⟨e, he1, -⟩ := Pretriangulated.exists_iso_binaryBiproduct_of_distTriang _ hT hm3
    have h1 : hS.singleTriangle.mor₁ ≫ (e.hom ≫ Limits.biprod.fst) = 𝟙 _ := by
      rw [← Category.assoc, he1, Limits.biprod.inl_fst]
    refine ⟨(DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).preimage
      (e.hom ≫ Limits.biprod.fst), ?_⟩
    apply (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).map_injective
    rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_preimage,
      CategoryTheory.Functor.map_id]
    exact h1
  have hH : wcSuppUnitMap E₁ ≫ Limits.biprod.inl ≫ ρ + wcSuppUnitMap E₂ ≫ Limits.biprod.inr ≫ ρ =
      𝟙 _ := by
    rw [← hρ, Limits.biprod.lift_eq, Preadditive.add_comp, Category.assoc, Category.assoc]

  let top : Xs.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Xs) (inferInstance : WeaklyEtale (𝟙 Xs))
  let σ : (SheafOfModules.unit (wcRingSheaf Xs ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ)) →
      C(↥Xs, ULift.{u+1} ℚ_[ℓ]) := fun g =>
    (g.val.app (Opposite.op top)).hom (1 : C(↥Xs, ULift.{u+1} ℚ_[ℓ]))
  have hSig : σ (wcSuppUnitMap E₁ ≫ Limits.biprod.inl ≫ ρ) +
      σ (wcSuppUnitMap E₂ ≫ Limits.biprod.inr ≫ ρ) = 1 := by
    have h := congrArg σ hH
    first
    | exact h
    | (simp only [σ, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
        LinearMap.add_apply, SheafOfModules.id_val, PresheafOfModules.id_app, ModuleCat.hom_id,
        LinearMap.id_apply] at h; exact h)

  have van : ∀ {Z : Scheme.{u}} {i : Z ⟶ Xs} (E : wcHMPullData i ℓ)
      (rr : wcSuppObj E ⟶ SheafOfModules.unit (wcRingSheaf Xs ℓ)) (O : Xs.Opens),
      (∀ z : Z, i z ∉ O) → ∀ y : Xs, y ∈ O → σ (wcSuppUnitMap E ≫ rr) y = 0 := by
    intro Z i E rr O hO y hy
    let W : Xs.ProEt := MorphismProperty.Over.mk ⊤ O.ι (inferInstance : WeaklyEtale O.ι)
    let a : W ⟶ top := MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
    have hnat : @id C(↥W.left, ULift.{u+1} ℚ_[ℓ])
        (((wcSuppUnitMap E ≫ rr).val.app (Opposite.op W)).hom
          (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))) =
        (σ (wcSuppUnitMap E ≫ rr)).comp O.ι.base.hom :=
      PresheafOfModules.naturality_apply (wcSuppUnitMap E ≫ rr).val a.op
        (1 : C(↥Xs, ULift.{u+1} ℚ_[ℓ]))
    have hemp : IsEmpty ↥(Limits.pullback O.ι i) := ⟨fun w => by
      have e : O.ι (Limits.pullback.fst O.ι i w) = i (Limits.pullback.snd O.ι i w) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      have hm : O.ι (Limits.pullback.fst O.ι i w) ∈ O := by
        have h := Set.mem_range_self (f := ⇑O.ι) (Limits.pullback.fst O.ι i w)
        rwa [Scheme.Opens.range_ι] at h
      exact hO _ (by rw [← e]; exact hm)⟩
    have hu0 : ((wcSuppUnitMap E).val.app (Opposite.op W)).hom
        (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
      have : (@id C(↥(Limits.pullback O.ι i), ULift.{u+1} ℚ_[ℓ])
          (((wcSuppUnitMap E).val.app (Opposite.op W)).hom
            (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])))) = 0 :=
        ContinuousMap.ext (fun w => (hemp.false w).elim)
      exact this
    have hW0 : @id C(↥W.left, ULift.{u+1} ℚ_[ℓ])
        (((wcSuppUnitMap E ≫ rr).val.app (Opposite.op W)).hom
          (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))) = 0 := by
      show (rr.val.app (Opposite.op W)).hom (((wcSuppUnitMap E).val.app (Opposite.op W)).hom
        (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))) = 0
      rw [hu0, map_zero]
    have h2 := congrArg (fun f : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) => f ⟨y, hy⟩) (hnat.symm.trans hW0)
    first
    | exact h2
    | simpa using h2

  have quad : ∀ (c₀ : Matrix (Fin (r + 2)) (Fin (r + 2)) A),
      c₀ = (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →
      wcQuadModelIdeal A (r + 2) π c₀ = Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    intro c₀ hc₀
    have hsum : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · rw [hc₀, Matrix.of_apply, if_pos ⟨rfl, rfl⟩, map_one, one_mul]
        · intro q hq
          have : ¬ (q.val = 1) := fun h => hq (Fin.ext h)
          rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have : ¬ (p.val = 0) := fun h => hp (Fin.ext h)
        rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
    show Ideal.span {_ - _} = _
    rw [hsum]
  have hIeq := quad _ rfl
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
    have hmem : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
          MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [hIeq]; exact Ideal.mem_span_singleton_self _
    have hal : algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.C π) := by
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [hal, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem

  have branch : ∀ {σ' : Type} (I : Ideal (MvPolynomial σ' A)) (a b : σ'), a ≠ b →
      (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) ∈ I →
      I ≤ Ideal.span {MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π} →
      ∀ (𝔮 : Ideal (MvPolynomial σ' A ⧸ I)) [𝔮.IsPrime],
      Ideal.Quotient.mk I (MvPolynomial.X a) ∈ 𝔮 → Ideal.Quotient.mk I (MvPolynomial.X b) ∈ 𝔮 →
      ∃ 𝔭 : Ideal (MvPolynomial σ' A ⧸ I), 𝔭.IsPrime ∧ 𝔭 ≤ 𝔮 ∧
        Ideal.Quotient.mk I (MvPolynomial.X a) ∉ 𝔭 ∧ Ideal.Quotient.mk I (MvPolynomial.X b) ∈ 𝔭 := by
    intro σ' I a b hab hmem hle 𝔮 _ ha hb
    letI : CommRing ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.commRing 𝔮
    haveI : IsDomain ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.isDomain 𝔮
    letI : CommRing (Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮)) := Polynomial.commRing
    let q : MvPolynomial σ' A →+* ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := (Ideal.Quotient.mk 𝔮).comp (Ideal.Quotient.mk I)
    let v : σ' → Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := fun i => if i = a then Polynomial.X else if i = b then 0
      else Polynomial.C (q (MvPolynomial.X i))
    let Ψt : MvPolynomial σ' A →+* Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp (q.comp MvPolynomial.C)) v
    have hqa : q (MvPolynomial.X a) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
    have hqb : q (MvPolynomial.X b) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb
    have hπq : q (MvPolynomial.C π) = 0 := by
      have h1 : q (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) = 0 := by
        show Ideal.Quotient.mk 𝔮 (Ideal.Quotient.mk I _) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
      rw [map_sub, map_mul, hqa, zero_mul, zero_sub, neg_eq_zero] at h1
      exact h1
    have hva : v a = Polynomial.X := if_pos rfl
    have hvb : v b = 0 := by
      show (if b = a then Polynomial.X else if b = b then 0 else _) = 0
      rw [if_neg hab.symm, if_pos rfl]
    have hG : Ψt (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) = 0 := by
      rw [map_sub, map_mul]
      simp only [Ψt, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      rw [hva, hvb, hπq, mul_zero, map_zero, sub_zero]
    let Ψ : (MvPolynomial σ' A ⧸ I) →+* Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.lift I Ψt (fun z hz => by
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp (hle hz)
      rw [map_mul, hG, mul_zero])
    have hΨX : ∀ i, Ψ (Ideal.Quotient.mk I (MvPolynomial.X i)) = v i := fun i => by
      simp only [Ψ, Ideal.Quotient.lift_mk, Ψt, MvPolynomial.eval₂Hom_X']
    have hev : (Polynomial.evalRingHom (0 : ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮))).comp Ψ = Ideal.Quotient.mk 𝔮 := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, Ψ, Ideal.Quotient.lift_mk, Ψt, MvPolynomial.eval₂Hom_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C]
        rfl
      · intro i
        simp only [RingHom.comp_apply]
        rw [hΨX, Polynomial.coe_evalRingHom]
        by_cases hia : i = a
        · rw [hia, hva, Polynomial.eval_X]
          exact hqa.symm
        · by_cases hib : i = b
          · rw [hib, hvb, Polynomial.eval_zero]
            exact hqb.symm
          · have : v i = Polynomial.C (q (MvPolynomial.X i)) := by
              show (if i = a then _ else if i = b then _ else _) = _
              rw [if_neg hia, if_neg hib]
            rw [this, Polynomial.eval_C]
            rfl
    refine ⟨RingHom.ker Ψ, RingHom.ker_isPrime Ψ, ?_, ?_, ?_⟩
    · intro z hz
      have h1 : Ψ z = 0 := RingHom.mem_ker.mp hz
      have h2 := congrArg (fun f : (MvPolynomial σ' A ⧸ I) →+* ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) => f z) hev
      simp only [RingHom.comp_apply, h1, map_zero] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2.symm
    · intro h
      have h1 := RingHom.mem_ker.mp h
      rw [hΨX, hva] at h1
      exact Polynomial.X_ne_zero h1
    · exact RingHom.mem_ker.mpr ((hΨX b).trans hvb)

  have gd : ∀ {R' : Type u} [CommRing R'] (ψ : R' →+* B), ψ.Flat → ∀ (𝔭 : Ideal R') [𝔭.IsPrime],
      𝔭 ≤ Ideal.comap ψ (IsLocalRing.maximalIdeal B) →
      ∃ P : Ideal B, P.IsPrime ∧ Ideal.comap ψ P = 𝔭 := by
    intro R' _ ψ hψ 𝔭 _ hle
    letI := ψ.toAlgebra
    haveI : Module.Flat R' B := hψ
    haveI : Algebra.HasGoingDown R' B := Algebra.HasGoingDown.of_flat
    haveI : (Ideal.comap ψ (IsLocalRing.maximalIdeal B)).IsPrime := Ideal.comap_isPrime _ _
    haveI : (IsLocalRing.maximalIdeal B).LiesOver (Ideal.comap ψ (IsLocalRing.maximalIdeal B)) :=
      ⟨by rw [Ideal.under_def, RingHom.algebraMap_toAlgebra]⟩
    obtain ⟨P, -, hP, hPo⟩ := Ideal.exists_ideal_le_liesOver_of_le (IsLocalRing.maximalIdeal B) hle
    refine ⟨P, hP, ?_⟩
    have := hPo.over
    rw [Ideal.under_def, RingHom.algebraMap_toAlgebra] at this
    exact this.symm

  have hptg : ∀ {R' : CommRingCat.{u}} (g : Spec (.of B) ⟶ Spec R') (p : Spec (.of B)),
      (g p).asIdeal = Ideal.comap (Spec.preimage g).hom p.asIdeal := by
    intro R' g p
    conv_lhs => rw [← Spec.map_preimage g]
    rfl
  have hpt : ∀ p : Spec (.of B), (a₀ p).asIdeal = Ideal.comap (Spec.preimage a₀).hom p.asIdeal :=
    fun p => hptg a₀ p
  have hflat : (Spec.preimage a₀).hom.Flat := by
    haveI := ha₀
    have hf : Flat (Spec.map (Spec.preimage a₀)) := by
      rw [Spec.map_preimage]; exact WeaklyEtale.flat
    exact (HasRingHomProperty.Spec_iff (P := @Flat)).mp hf
  have hm0 : _ ∈ Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B) :=
    (hpt (IsLocalRing.closedPoint B)).le hx0
  have hm1 : _ ∈ Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B) :=
    (hpt (IsLocalRing.closedPoint B)).le hx1
  haveI hci : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  have hspec : ∀ x y : Xs, (ι x).asIdeal ≤ (ι y).asIdeal → x ⤳ y := by
    intro x y h
    exact (Scheme.Hom.isClosedEmbedding ι).isInducing.specializes_iff.mp
      ((PrimeSpectrum.le_iff_specializes _ _).mp h)
  have hπ' : π ∈ IsLocalRing.maximalIdeal A := hπ ▸ Ideal.mem_span_singleton_self π
  have hlift : ∀ P : Ideal B, P.IsPrime →
      (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π) ∈ P →
      ∃ x : Xs, (ι x).asIdeal = P := by
    intro P hP hπP
    let p : Spec (.of B) := ⟨P, hP⟩
    let z : Spec (.of (IsLocalRing.ResidueField A)) := IsLocalRing.closedPoint _
    have heq : (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) p =
        wcQmSp A z := by
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap A _) (a₀ p).asIdeal =
        Ideal.comap (IsLocalRing.residue A) z.asIdeal
      haveI := z.isPrime
      rw [Ideal.eq_bot_of_prime z.asIdeal, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue,
        hpt p]
      haveI := hP
      symm
      refine (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le (Ideal.comap_isPrime _ _).ne_top ?_
      rw [hπ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, Ideal.mem_comap]
      exact hπP
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback p z heq
    refine ⟨hps.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, hps.isoPullback_inv_fst, hw1]
  have rng : ∀ {J : Ideal B} {D : Scheme.{u}} (i : D ⟶ Xs) (k : D ⟶ Spec (.of (B ⧸ J))),
      IsPullback i k ι (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) →
      ∀ d : D, J ≤ (ι (i d)).asIdeal := by
    intro J D i k h d j hj
    have e := congrArg (fun f : D ⟶ Spec (.of B) => (f d).asIdeal) h.w
    simp only [Scheme.Hom.comp_apply] at e
    rw [e]
    show Ideal.Quotient.mk J j ∈ (k d).asIdeal
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hj]
    exact zero_mem _

  have hπm : (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π) ∈
      IsLocalRing.maximalIdeal B := by
    rw [← hrel, map_mul]; exact Ideal.mul_mem_right _ _ (Ideal.mem_comap.mp hm0)
  obtain ⟨c, hc⟩ := hlift _ (IsLocalRing.maximalIdeal.isMaximal B).isPrime hπm
  have hsp : ∀ x : Xs, x ⤳ c := fun x => hspec x c (by
    rw [hc]; exact IsLocalRing.le_maximalIdeal (ι x).2.ne_top)
  haveI h𝔮 : (Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B)).IsPrime :=
    Ideal.comap_isPrime _ _
  have h01 : (⟨0, by omega⟩ : Fin (r + 2)) ≠ ⟨1, by omega⟩ := by
    intro h; have := congrArg Fin.val h; simp at this
  have hcomm : (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π := by ring

  have hmemI : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    rw [hIeq]; exact Ideal.mem_span_singleton_self _
  have hmemI' : (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    rw [hcomm]; exact hmemI
  obtain ⟨𝔭₁, h𝔭₁, hle₁, hn₁, hy₁⟩ := @branch (Fin (r + 2)) (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    ⟨0, by omega⟩ ⟨1, by omega⟩ h01 hmemI hIeq.le (Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B)) h𝔮 hm0 hm1
  haveI := h𝔭₁
  obtain ⟨P₁, hP₁, hcP₁⟩ := gd _ hflat 𝔭₁ hle₁

  obtain ⟨𝔭₂, h𝔭₂, hle₂, hn₂, hy₂⟩ := @branch (Fin (r + 2)) (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    ⟨1, by omega⟩ ⟨0, by omega⟩ (Ne.symm h01) hmemI'
    (by rw [hcomm]; exact hIeq.le) (Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B)) h𝔮 hm1 hm0
  haveI := h𝔭₂
  obtain ⟨P₂, hP₂, hcP₂⟩ := gd _ hflat 𝔭₂ hle₂
  have hx0P₁ : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∉ P₁ := by
    intro h; apply hn₁; rw [← hcP₁]; exact h
  have hx1P₁ : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ P₁ := by
    rw [← hcP₁] at hy₁; exact hy₁
  have hx1P₂ : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∉ P₂ := by
    intro h; apply hn₂; rw [← hcP₂]; exact h
  have hx0P₂ : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ P₂ := by
    rw [← hcP₂] at hy₂; exact hy₂
  obtain ⟨y₁, hy₁e⟩ := hlift P₁ hP₁ (by rw [← hrel, map_mul]; exact Ideal.mul_mem_left _ _ hx1P₁)
  obtain ⟨y₂, hy₂e⟩ := hlift P₂ hP₂ (by rw [← hrel, map_mul]; exact Ideal.mul_mem_right _ _ hx0P₂)

  let O₁ : Xs.Opens := ⟨ι ⁻¹' (PrimeSpectrum.basicOpen ((Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))) : Set (PrimeSpectrum B)),
    (PrimeSpectrum.basicOpen _).isOpen.preimage ι.continuous⟩
  let O₂ : Xs.Opens := ⟨ι ⁻¹' (PrimeSpectrum.basicOpen ((Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))) : Set (PrimeSpectrum B)),
    (PrimeSpectrum.basicOpen _).isOpen.preimage ι.continuous⟩
  have hO₁ : ∀ d : D₁, i₁ d ∉ O₁ := by
    intro d hd
    have h1 := (PrimeSpectrum.mem_basicOpen _ _).mp hd
    exact h1 (rng i₁ k₁ hD1 d (Ideal.mem_span_singleton_self _))
  have hO₂ : ∀ d : D₂, i₂ d ∉ O₂ := by
    intro d hd
    have h1 := (PrimeSpectrum.mem_basicOpen _ _).mp hd
    exact h1 (rng i₂ k₂ hD2 d (Ideal.mem_span_singleton_self _))
  have hyO₁ : y₁ ∈ O₁ := by
    show ι y₁ ∈ ((PrimeSpectrum.basicOpen _ : TopologicalSpace.Opens (PrimeSpectrum B)) :
      Set (PrimeSpectrum B))
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr (by rw [hy₁e]; exact hx0P₁)
  have hyO₂ : y₂ ∈ O₂ := by
    show ι y₂ ∈ ((PrimeSpectrum.basicOpen _ : TopologicalSpace.Opens (PrimeSpectrum B)) :
      Set (PrimeSpectrum B))
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr (by rw [hy₂e]; exact hx1P₂)
  have hv₁ := van E₁ (Limits.biprod.inl ≫ ρ) O₁ hO₁ y₁ hyO₁
  have hv₂ := van E₂ (Limits.biprod.inr ≫ ρ) O₂ hO₂ y₂ hyO₂
  have hc₁ := ((hsp y₁).map (σ (wcSuppUnitMap E₁ ≫ Limits.biprod.inl ≫ ρ)).continuous).eq
  have hc₂ := ((hsp y₂).map (σ (wcSuppUnitMap E₂ ≫ Limits.biprod.inr ≫ ρ)).continuous).eq
  have hfin := congrArg (fun f : C(↥Xs, ULift.{u+1} ℚ_[ℓ]) => f c) hSig
  simp only [ContinuousMap.add_apply, ContinuousMap.one_apply] at hfin
  rw [← hc₁, ← hc₂, hv₁, hv₂, add_zero] at hfin
  exact zero_ne_one hfin

theorem wc_smooth_open_shens_milnor_fibre_conn : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) (U : Y.Opens), Smooth (U.ι ≫ f) → ∀ (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (x : Y), x ∈ U → f x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData x B Λ W' φ a → ∀ (L : Type u) [Field L] (t : Spec (.of L) ⟶ Spec (.of A)), ConnectedSpace ↥(Limits.pullback (a ≫ f) t) :=
by
  intro A _ _ _ Y f U hsm ℓ hℓ hunit x hxU hfx B _ _ _ Λ _ _ W' φ a hsh L _ t
  let σ : Spec (.of (AlgebraicClosure L)) ⟶ Spec (.of L) :=
    Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))
  have hac := wc_smooth_open_shens_milnor_fibre_acyclic A Y f U hsm ℓ hunit x hxU hfx B Λ W' φ a
    hsh (AlgebraicClosure L) (σ ≫ t)
  haveI hQ : ConnectedSpace ↥(Limits.pullback (a ≫ f) (σ ≫ t)) :=
    wc_et_coh0_card_prime_connected _ ℓ hℓ hac.1
  have wQ : Limits.pullback.fst (a ≫ f) (σ ≫ t) ≫ (a ≫ f) =
      (Limits.pullback.snd (a ≫ f) (σ ≫ t) ≫ σ) ≫ t := by
    rw [Limits.pullback.condition, Category.assoc]
  let g : Limits.pullback (a ≫ f) (σ ≫ t) ⟶ Limits.pullback (a ≫ f) t :=
    Limits.pullback.lift (Limits.pullback.fst (a ≫ f) (σ ≫ t))
      (Limits.pullback.snd (a ≫ f) (σ ≫ t) ≫ σ) wQ
  have hg1 : g ≫ Limits.pullback.fst (a ≫ f) t = Limits.pullback.fst (a ≫ f) (σ ≫ t) :=
    Limits.pullback.lift_fst _ _ _
  have hg2 : g ≫ Limits.pullback.snd (a ≫ f) t = Limits.pullback.snd (a ≫ f) (σ ≫ t) ≫ σ :=
    Limits.pullback.lift_snd _ _ _
  have outer : IsPullback (g ≫ Limits.pullback.fst (a ≫ f) t)
      (Limits.pullback.snd (a ≫ f) (σ ≫ t)) (a ≫ f) (σ ≫ t) := by
    rw [hg1]; exact IsPullback.of_hasPullback _ _
  have Sg : IsPullback g (Limits.pullback.snd (a ≫ f) (σ ≫ t))
      (Limits.pullback.snd (a ≫ f) t) σ :=
    IsPullback.of_right outer hg2 (IsPullback.of_hasPullback (a ≫ f) t)
  haveI hσ : Surjective σ := inferInstance
  haveI hgs : Surjective g := MorphismProperty.of_isPullback (P := @Surjective) Sg.flip hσ
  exact @Function.Surjective.connectedSpace _ _ _ hQ _ _ (Scheme.Hom.surjective g)
    (Scheme.Hom.continuous g)

theorem wc_qmssl_offdouble_smooth : ∀ (A : Type u) [CommRing A] (r : ℕ) (π : A) (y : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal y ∨ Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal y) → ∃ U : (Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))).Opens, y ∈ U ∧ Smooth (U.ι ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) :=
by
  intro A _ r π y hy

  have hs3 : ∀ (R : Type u) [CommRing R] [Algebra A R] (f : R),
      Algebra.Smooth A (Localization.Away f) →
      ∃ U : (Spec (.of R)).Opens, U = PrimeSpectrum.basicOpen f ∧
        Smooth (U.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap A R))) := by
    intro R _ _ f h
    let U : (Spec (.of R)).Opens := PrimeSpectrum.basicOpen f
    refine ⟨U, rfl, ?_⟩
    let g := Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))
    have : IsOpenImmersion g := IsOpenImmersion.of_isLocalization f
    have hrange : Set.range U.ι = Set.range g := by
      rw [Scheme.Opens.range_ι]
      ext z
      constructor
      · intro hz
        have h3 : z ∈ Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away f))) := by
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away f) f]; exact hz
        obtain ⟨x, hx⟩ := h3
        refine ⟨x, ?_⟩
        rw [← hx]
        exact Spec.map_apply (CommRingCat.ofHom (algebraMap R (Localization.Away f))) x
      · rintro ⟨x, rfl⟩
        have h3 : g x ∈ Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away f))) :=
          ⟨x, (Spec.map_apply (CommRingCat.ofHom (algebraMap R (Localization.Away f))) x).symm⟩
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away f) f] at h3
        exact h3
    have hfac := IsOpenImmersion.isoOfRangeEq_hom_fac U.ι g hrange
    rw [← hfac, Category.assoc]
    have hcomp : g ≫ Spec.map (CommRingCat.ofHom (algebraMap A R)) =
        Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away f))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    rw [hcomp]
    apply MorphismProperty.comp_mem
    · infer_instance
    · rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
      exact RingHom.smooth_algebraMap.mpr h

  have hs1 : wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
      Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    have key : (∑ p : Fin (r + 2), ∑ q : Fin (r + 2),
        MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      rw [Fintype.sum_eq_single ⟨0, by omega⟩]
      · rw [Fintype.sum_eq_single ⟨1, by omega⟩]
        · simp
        · intro q hq
          have : q.val ≠ 1 := fun h => hq (Fin.ext h)
          rw [Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
      · intro p hp
        have : p.val ≠ 0 := fun h => hp (Fin.ext h)
        apply Finset.sum_eq_zero
        intro q _
        rw [Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
    show Ideal.span {_ - _} = _
    rw [key]

  have hs2 : ∀ (I : Ideal (MvPolynomial (Fin (r + 2)) A)) (a b : Fin (r + 2)),
      I = Ideal.span {MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π} →
      b.succAbove 0 = a →
      Algebra.Smooth A (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.X a))) := by
    intro I a b hI hab
    classical
    let y0 : MvPolynomial (Fin (r + 1)) A := MvPolynomial.X 0
    let u : MvPolynomial (Fin (r + 2)) A ⧸ I := Ideal.Quotient.mk I (MvPolynomial.X a)
    let t : Localization.Away y0 := IsLocalization.Away.invSelf y0
    have h1 : algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0) y0 * t = 1 :=
      IsLocalization.Away.mul_invSelf y0
    let Ψt : MvPolynomial (Fin (r + 2)) A →ₐ[A] Localization.Away y0 :=
      MvPolynomial.aeval (Fin.insertNth (α := fun _ => Localization.Away y0) b
        (algebraMap A (Localization.Away y0) π * t)
        (fun j : Fin (r + 1) => algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0)
          (MvPolynomial.X j)))
    have hΨb : Ψt (MvPolynomial.X b) = algebraMap A (Localization.Away y0) π * t := by
      simp [Ψt, Fin.insertNth_apply_same]
    have hΨs : ∀ j, Ψt (MvPolynomial.X (b.succAbove j)) =
        algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0) (MvPolynomial.X j) := by
      intro j; simp [Ψt, Fin.insertNth_apply_succAbove]
    have hΨa : Ψt (MvPolynomial.X a) =
        algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0) y0 := by
      rw [← hab, hΨs]
    have hker : ∀ p ∈ I, Ψt p = 0 := by
      rw [hI]
      intro p hp
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, map_sub, map_mul, hΨa, hΨb, MvPolynomial.aeval_C]
      linear_combination (Ψt c * algebraMap A (Localization.Away y0) π) * h1
    let Ψq : (MvPolynomial (Fin (r + 2)) A ⧸ I) →ₐ[A] Localization.Away y0 :=
      Ideal.Quotient.liftₐ I Ψt hker
    have hΨq : ∀ p, Ψq (Ideal.Quotient.mk I p) = Ψt p := fun p => rfl
    have hu : IsUnit (Ψq u) := by
      rw [hΨq, hΨa]; exact IsLocalization.Away.algebraMap_isUnit y0
    let Ψ : Localization.Away u →ₐ[A] Localization.Away y0 := IsLocalization.Away.liftAlgHom u hu
    have hΨι : ∀ q, Ψ (algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u) q) =
        Ψq q := by
      intro q
      show (IsLocalization.Away.liftAlgHom u hu)
        (algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u) q) = _
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    let Θt : MvPolynomial (Fin (r + 1)) A →ₐ[A] Localization.Away u :=
      MvPolynomial.aeval (fun j : Fin (r + 1) => algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I)
        (Localization.Away u) (Ideal.Quotient.mk I (MvPolynomial.X (b.succAbove j))))
    have hΘX : ∀ j, Θt (MvPolynomial.X j) =
        algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u)
          (Ideal.Quotient.mk I (MvPolynomial.X (b.succAbove j))) := by
      intro j; simp [Θt]
    have hΘ0 : Θt y0 = algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u) u := by
      show Θt (MvPolynomial.X 0) = _
      rw [hΘX, hab]
    have hΘu : IsUnit (Θt y0) := by
      rw [hΘ0]; exact IsLocalization.Away.algebraMap_isUnit u
    let Θ : Localization.Away y0 →ₐ[A] Localization.Away u :=
      IsLocalization.Away.liftAlgHom y0 hΘu
    have hΘι : ∀ s, Θ (algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0) s) =
        Θt s := by
      intro s
      show (IsLocalization.Away.liftAlgHom y0 hΘu)
        (algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0) s) = _
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    have hrelQ : u * Ideal.Quotient.mk I (MvPolynomial.X b) = algebraMap A _ π := by
      have hmem : MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π ∈ I := by
        rw [hI]; exact Ideal.subset_span rfl
      have := (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
      rw [map_sub, map_mul, sub_eq_zero] at this
      rw [this]
      rfl
    have hΘΨ : Θ.comp Ψ = AlgHom.id A (Localization.Away u) := by
      apply IsLocalization.algHom_ext (Submonoid.powers u)
      apply Ideal.Quotient.algHom_ext A
      apply MvPolynomial.algHom_ext
      intro i
      show Θ (Ψ (algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u)
          (Ideal.Quotient.mk I (MvPolynomial.X i)))) =
        algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u)
          (Ideal.Quotient.mk I (MvPolynomial.X i))
      rw [hΨι, hΨq]
      rcases Fin.eq_self_or_eq_succAbove b i with h | ⟨j, rfl⟩
      · subst h
        rw [hΨb, map_mul, AlgHom.commutes]
        have e1 : algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u) u * Θ t = 1 := by
          rw [← hΘ0, ← hΘι, ← map_mul, h1, map_one]
        have e2 : algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u) u *
            algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u)
              (Ideal.Quotient.mk I (MvPolynomial.X i)) =
            algebraMap A (Localization.Away u) π := by
          rw [← map_mul, hrelQ, ← IsScalarTower.algebraMap_apply]
        linear_combination (-Θ t) * e2 +
          algebraMap (MvPolynomial (Fin (r + 2)) A ⧸ I) (Localization.Away u)
            (Ideal.Quotient.mk I (MvPolynomial.X i)) * e1
      · rw [hΨs, hΘι, hΘX]
    have hΨΘ : Ψ.comp Θ = AlgHom.id A (Localization.Away y0) := by
      apply IsLocalization.algHom_ext (Submonoid.powers y0)
      apply MvPolynomial.algHom_ext
      intro j
      show Ψ (Θ (algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0)
          (MvPolynomial.X j))) =
        algebraMap (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0) (MvPolynomial.X j)
      rw [hΘι, hΘX, hΨι, hΨq, hΨs]
    let e : Localization.Away y0 ≃ₐ[A] Localization.Away u := AlgEquiv.ofAlgHom Θ Ψ hΘΨ hΨΘ
    have : Algebra.Smooth A (Localization.Away y0) :=
      Algebra.Smooth.comp A (MvPolynomial (Fin (r + 1)) A) (Localization.Away y0)
    exact Algebra.Smooth.of_equiv e

  rcases hy with h0 | h1
  · have hab : (⟨1, by omega⟩ : Fin (r + 2)).succAbove 0 = ⟨0, by omega⟩ := by
      ext; simp [Fin.succAbove]
    obtain ⟨U, hU, hsm⟩ := hs3 _ _ (hs2 _ ⟨0, by omega⟩ ⟨1, by omega⟩ hs1 hab)
    refine ⟨U, ?_, hsm⟩
    rw [hU]
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr h0
  · have hab : (⟨0, by omega⟩ : Fin (r + 2)).succAbove 0 = ⟨1, by omega⟩ := by
      ext; simp [Fin.succAbove]
    have hI : wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
        Ideal.span {MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
      rw [hs1, mul_comm]
    obtain ⟨U, hU, hsm⟩ := hs3 _ _ (hs2 _ ⟨1, by omega⟩ ⟨0, by omega⟩ hI hab)
    refine ⟨U, ?_, hsm⟩
    rw [hU]
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr h1

theorem wc_qmssl_mfc_double : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) → ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (r : ℕ) (y : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) y = IsLocalRing.closedPoint A → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))) y)) (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), wcHalShData y B Λ W' φ a → ∀ (L : Type u) [Field L] (φA : A →+* L), Function.Injective φA → ConnectedSpace ↥(Limits.pullback (a ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (Spec.map (CommRingCat.ofHom φA))) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r y hy hx0 hx1 B _ _ _ Λ _ _ W' φ a hsh L _ φA hφA
  classical
  have L1test : ∀ (A : Type u) [CommRing A] (r : ℕ) (π : A),
    ∃ g : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
      g ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) ∧ Smooth g ∧
      ∀ (y : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y →
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y →
        ∀ p : Fin 2, Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (g y) := by
    intro A _ r π
    classical
    have K1 : ∀ (m : ℕ) (h1 : 1 < m),
        (∑ p : Fin m, ∑ q : Fin m, MvPolynomial.C ((Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin m) A) = MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ := by
      intro m h1
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin m)]
      · rw [Finset.sum_eq_single (⟨1, h1⟩ : Fin m)]
        · simp
        · intro q _ hq
          have : q.val ≠ 1 := fun h => hq (Fin.ext h)
          simp [this]
        · intro h; exact absurd (Finset.mem_univ _) h
      · intro p _ hp
        have : p.val ≠ 0 := fun h => hp (Fin.ext h)
        apply Finset.sum_eq_zero
        intro q _
        simp [this]
      · intro h; exact absurd (Finset.mem_univ _) h
    have liftH : ∀ (m : ℕ) (h1 : 1 < m) (S : Type u) [CommRing S] [Algebra A S] (v : Fin m → S),
        v ⟨0, by omega⟩ * v ⟨1, h1⟩ = algebraMap A S π →
        ∀ x ∈ wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0), MvPolynomial.aeval v x = 0 := by
      intro m h1 S _ _ v hv x hx
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [K1 m h1, map_mul]
      simp [hv]
    have relH : ∀ (m : ℕ) (h1 : 1 < m),
        Ideal.Quotient.mk (wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨0, by omega⟩) *
        Ideal.Quotient.mk (wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨1, h1⟩) =
        algebraMap A (wcQuadModelRing A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
      intro m h1
      have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ - MvPolynomial.C π :
          MvPolynomial (Fin m) A) ∈ wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
        rw [← K1 m h1]
        exact Ideal.subset_span (Set.mem_singleton _)
      have := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_mul, sub_eq_zero] at this
      rw [this, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]

    let Q2 := wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
    let I2 := wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
    let Qr := wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
