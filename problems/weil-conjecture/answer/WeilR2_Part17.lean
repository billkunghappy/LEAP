    let eΨ := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map Di.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)) ≫
        (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    let Ψ := (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∀ w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj Ψ)⟦((n - 1 : ℕ) : ℤ)⟧,
      ∃ w' : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
            (SheafOfModules.unit (wcRingSheaf
              (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))⟦((n - 1 : ℕ) : ℤ)⟧,
        w = w' ≫ (DerivedCategory.Q.map eΨ)⟦((n - 1 : ℕ) : ℤ)⟧' :=
by
  have keyAll : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (N : ℤ) (One Sx : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (eΨ : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One ⟶ Ψ),
