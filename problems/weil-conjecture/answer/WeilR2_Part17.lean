        (a'' ≫ Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) c δ (𝟙 _) (𝟙 _)
        eq₁ eq₂) ℓ q
    refine ⟨?_, fun q hq => ?_⟩
    · obtain ⟨E0⟩ := E 0
      rw [← Nat.card_congr E0]
      exact H.1
    · obtain ⟨Eq⟩ := E q
      haveI := H.2 q hq
