  suffices H : ∀ (a b c : ℕ) (ha : a = 2 * e) (hb : b = 2 * e + 1) (hc : c = 4 * e + 1)
      (h : a + b = c), ∃ (ζ : wcHM (Oc : Scheme.{u}) ℓ a) (ω : wcHM (Oc : Scheme.{u}) ℓ b),
        wcHMCup (Oc : Scheme.{u}) ℓ a b c h ζ ω ≠ 0 by
    exact H _ _ _ (by omega) (by omega) (by omega) _
  intro a b c ha hb hc h
  subst ha hb hc
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Oc : Scheme.{u}) ℓ)) := HasExt.standard _
  obtain ⟨W, hW, ie, i_f, Uev, Uodd, πf, se, hie, hif, hieK, hifK, hUev, hUodd, hse1, hse2,
    hUoddmem⟩ := wc_qcl_ruling_geometry K e Oc hOc
  haveI := hie
  haveI := hif
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists πf ℓ
  obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists ie ℓ
  obtain ⟨Df, hDf⟩ := wc_hm_pull_data_exists i_f ℓ
  obtain ⟨Dev, hDev⟩ := wc_hm_pull_data_exists Uev.ι ℓ
  obtain ⟨Dodd, hDodd⟩ := wc_hm_pull_data_exists Uodd.ι ℓ
  obtain ⟨Dse, hDse⟩ := wc_hm_pull_data_exists se ℓ
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (W : Scheme.{u})) ℓ

  obtain ⟨ω₀, h0⟩ := wc_qcl_punct_affine_top_ne_zero K ℓ hℓ e W hW

  obtain ⟨ω, hω⟩ := wc_qcl_restrict_surj_of_supp_vanish i_f ℓ Df hDf Uev hUev (2 * e + 1)
    (wc_qcl_plane_supp_vanish K ℓ hℓ e he Oc hOc W hW i_f hifK Df hDf) Dev hDev
    (wcHMPull Dπ (2 * e + 1) ω₀)

  have hres : wcHMPull De (2 * e + 1) ω ≠ 0 := by
    rw [wc_hm_pull_comp Uev.ι se ie hse1 Dev hDev Dse hDse De hDe, hω,
      ← wc_hm_pull_comp πf se (𝟙 _) hse2 Dπ hDπ Dse hDse Did hDid,
      wc_hm_pull_id _ rfl Did hDid]
    exact h0

  obtain ⟨τ, hτ⟩ := wc_qcl_thom_right_detect K ℓ hℓ e he Oc hOc W hW ie hieK De hDe
  have hne := hτ (2 * e + 1) (4 * e + 1) (by omega) ω hres
  have hinj := wc_qcl_supp_class_inj_of_open_vanish ie ℓ De hDe Uodd hUodd (4 * e) Dodd hDodd
    (wc_qcl_odd_open_vanish K ℓ hℓ e he Oc hOc Uodd hUoddmem)
  refine ⟨wcSuppClass De (2 * e) τ, ω, ?_⟩
  intro hzero
  apply hne
  apply hinj
  rw [← hzero]
  unfold wcHMCup wcSuppClass
  rw [Abelian.Ext.bilinearComp_apply_apply, Abelian.Ext.comp_assoc]
  omega

theorem wc_pmn_ldp_shens_germ_xs_point_unique (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x) :
    (∃ w : ↥(Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))),
      Limits.pullback.snd a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w = xs) ∧
    ∀ w w' : ↥(Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))),
      Limits.pullback.snd a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w = xs →
      Limits.pullback.snd a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w' = xs →
      w = w' :=
by
  classical

  have ha'x : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨ee, -, he⟩ := hsh.2.2.2.2.2
    have h1 : ∀ g g' : Spec (.of (AlgebraicClosure
        ((((wcProEtPullback D.f).obj V).left).residueField x))) ⟶ ((wcProEtPullback D.f).obj V).left,
        g = g' → g (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))) =
          g' (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))) := by
      rintro g _ rfl; rfl
    have h2 := h1 _ _ he
    have h3 : a' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        ((Spec.map (CommRingCat.ofHom ee)) (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))))) = x :=
      h2.trans (Scheme.fromSpecResidueField_apply x _)
    have hsub : (Spec.map (CommRingCat.ofHom ee)) (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))) =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField B) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField B)) _ _
    have hres : Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField B)) = IsLocalRing.closedPoint B := by
      haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue B))) := by
        rw [CommRingCat.hom_ofHom]; infer_instance
      exact Spec_closedPoint
    rw [hsub, hres] at h3
    exact h3

  have hfinj : Function.Injective (Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) := by
    obtain ⟨J, c, hpb, -⟩ :=
      wc_pmn_shens_closed_fibre_square F' F'' Y n D V A e x hx₁ B Λ' W'' φ' a' hsh
    haveI : IsIso c := hpb.isIso_snd_of_isIso
    have hw := hpb.w
    rw [Category.comp_id] at hw
    intro w₁ w₂ h
    have h' : (c ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) w₁ =
        (c ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) w₂ := by
      rw [← hw]; exact h
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Spec.map_apply, Spec.map_apply,
      CommRingCat.hom_ofHom] at h'
    have h2 : c w₁ = c w₂ :=
      PrimeSpectrum.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective h'
    have h3 : Scheme.homeoOfIso (asIso c) w₁ = Scheme.homeoOfIso (asIso c) w₂ := by
      rw [Scheme.homeoOfIso_apply, Scheme.homeoOfIso_apply]; exact h2
    exact (Scheme.homeoOfIso (asIso c)).injective h3

  haveI := wc_pmn_vp_node_residue_sepClosed F' F'' Y n D i V A e x hx₁ hx₂
  have hfib : ∀ b : Spec (.of B), a' b = x → b = IsLocalRing.closedPoint B := by
    obtain ⟨c1, -, hpb1, -, -⟩ := wc_ppu_closed_fibre_square x B Λ' W'' φ' a' hsh
    have hw1 := hpb1.w
    rw [Category.comp_id] at hw1
    intro b hb
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := a')
      (g := (((wcProEtPullback D.f).obj V).left).fromSpecResidueField x) b
      (IsLocalRing.closedPoint ((((wcProEtPullback D.f).obj V).left).residueField x))
      (hb.trans (Scheme.fromSpecResidueField_apply x _).symm)
    have hb' : b = (c1 ≫ Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)))) z := by
      rw [← hw1]; exact hz1.symm
    rw [hb', Scheme.Hom.comp_apply, Spec.map_apply, CommRingCat.hom_ofHom]
    apply PrimeSpectrum.ext
    show Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)) (c1 z).asIdeal =
      IsLocalRing.maximalIdeal B
    symm
    refine (IsLocalRing.maximalIdeal.isMaximal B).eq_of_le ?_ ?_
    · intro htop
      have h1 : (1 : B) ∈ Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B))
          (c1 z).asIdeal := by rw [htop]; exact Submodule.mem_top
      rw [Ideal.mem_comap, map_one] at h1
      exact (c1 z).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    · intro a ha
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact Ideal.zero_mem _

  have hax : ∀ w, Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w = xs →
      a' (Limits.pullback.fst a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w) = x := by
    intro w hw
    have hcond := congrArg (fun g : Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ⟶
          ((wcProEtPullback D.f).obj V).left => g w)
      (Limits.pullback.condition (f := a')
        (g := Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    have hcond' : a' (Limits.pullback.fst a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w) =
        Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
          (Limits.pullback.snd a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w) := hcond
    rw [hcond', hw, hxs]
  refine ⟨?_, ?_⟩
  ·
    obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := a')
      (g := Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (IsLocalRing.closedPoint B) xs (ha'x.trans hxs.symm)
    exact ⟨z, hz⟩
  · intro w w' hw hw'
    apply hfinj
    rw [hfib _ (hax w hw), hfib _ (hax w' hw')]

theorem wc_weaklyEtale_algClosed_fibre_isIso (K : Type u) [Field K] [IsAlgClosed K]
    {W C : Scheme.{u}} [IsAffine W] [IsAffine C] (κ : W ⟶ C) [WeaklyEtale κ]
    (v : Spec (.of K) ⟶ C) [IsClosedImmersion v]
    (hex : ∃ w : W, κ w ∈ Set.range v)
    (huniq : ∀ w w' : W, κ w ∈ Set.range v → κ w' ∈ Set.range v → w = w') :
    IsIso (Limits.pullback.snd κ v) :=
by
  classical

  have hfst_inj : Function.Injective (Limits.pullback.fst κ v) :=
    (IsClosedImmersion.isClosedEmbedding (Limits.pullback.fst κ v)).isEmbedding.injective
  have hne : Nonempty ↥(Limits.pullback κ v) := by
    obtain ⟨w, hw⟩ := hex
    have hw' : w ∈ Set.range (Limits.pullback.fst κ v) := by
      rw [Scheme.Pullback.range_fst]; exact hw
    obtain ⟨p, _⟩ := hw'
    exact ⟨p⟩
  have hsub : Subsingleton ↥(Limits.pullback κ v) := by
    constructor
    intro p p'
    apply hfst_inj
    have h1 : Limits.pullback.fst κ v p ∈ κ ⁻¹' Set.range v := by
      rw [← Scheme.Pullback.range_fst]; exact ⟨p, rfl⟩
    have h2 : Limits.pullback.fst κ v p' ∈ κ ⁻¹' Set.range v := by
      rw [← Scheme.Pullback.range_fst]; exact ⟨p', rfl⟩
    exact huniq _ _ h1 h2

  obtain ⟨ψ, hψ⟩ : ∃ ψ : CommRingCat.of K ⟶ Γ(Limits.pullback κ v, ⊤),
      Spec.map ψ = (Limits.pullback κ v).isoSpec.inv ≫ Limits.pullback.snd κ v :=
    ⟨_, Spec.map_preimage _⟩
  have hWEs : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ.hom)) := by
    rw [CommRingCat.ofHom_hom, hψ]; infer_instance
  have hWE := wc_lpkt_specMap_weaklyEtale_ring K (Γ(Limits.pullback κ v, ⊤)) ψ.hom hWEs
  letI : Algebra K (Γ(Limits.pullback κ v, ⊤)) := ψ.hom.toAlgebra
  have hvnr := wc_weaklyEtale_field_vnr K (Γ(Limits.pullback κ v, ⊤)) hWE
    (fun M _ _ _ _ hM => wc_weaklyEtale_flat_transfer K (Γ(Limits.pullback κ v, ⊤)) hWE M hM)

  have hPne : Nonempty (PrimeSpectrum (Γ(Limits.pullback κ v, ⊤))) :=
    @Equiv.nonempty _ _ (Scheme.homeoOfIso (Limits.pullback κ v).isoSpec).symm.toEquiv hne
  have hPsub : Subsingleton (PrimeSpectrum (Γ(Limits.pullback κ v, ⊤))) :=
    @Equiv.subsingleton _ _ (Scheme.homeoOfIso (Limits.pullback κ v).isoSpec).symm.toEquiv hsub
  haveI : Nontrivial (Γ(Limits.pullback κ v, ⊤)) := PrimeSpectrum.nonempty_iff_nontrivial.mp hPne
  haveI : IsLocalRing (Γ(Limits.pullback κ v, ⊤)) := by
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (Γ(Limits.pullback κ v, ⊤))
    refine IsLocalRing.of_unique_max_ideal ⟨M, hM, fun I hI => ?_⟩
    exact congrArg PrimeSpectrum.asIdeal
      (Subsingleton.elim (⟨I, hI.isPrime⟩ : PrimeSpectrum (Γ(Limits.pullback κ v, ⊤)))
        ⟨M, hM.isPrime⟩)

  have hm : IsLocalRing.maximalIdeal (Γ(Limits.pullback κ v, ⊤)) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Ideal.mem_bot]
    obtain ⟨t, ht⟩ := hvnr x
    have hxt : x * t ∈ IsLocalRing.maximalIdeal (Γ(Limits.pullback κ v, ⊤)) :=
      Ideal.mul_mem_right t _ hx
    have hu : IsUnit (1 - x * t) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro h
      have h1 : (1 : Γ(Limits.pullback κ v, ⊤)) ∈
          IsLocalRing.maximalIdeal (Γ(Limits.pullback κ v, ⊤)) := by
        have := Ideal.add_mem _ h hxt
        simpa using this
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have h0 : x * (1 - x * t) = 0 := by
      have e1 : x * (1 - x * t) = x - x * x * t := by ring
      rw [e1, ht, sub_self]
    exact hu.mul_left_eq_zero.mp h0
  have hfield : IsField (Γ(Limits.pullback κ v, ⊤)) :=
    IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm
  haveI : IsDomain (Γ(Limits.pullback κ v, ⊤)) := hfield.isDomain
  have hinj : Function.Injective (IsLocalRing.residue (Γ(Limits.pullback κ v, ⊤))) := by
    rw [RingHom.injective_iff_ker_eq_bot, IsLocalRing.ker_residue, hm]

  haveI hint : Algebra.IsIntegral K (Γ(Limits.pullback κ v, ⊤)) := by
    refine Algebra.IsIntegral.mk (fun b => ?_)
    obtain ⟨f, hf0, hf⟩ := wc_weaklyEtale_point_algebraic K (Γ(Limits.pullback κ v, ⊤))
      (IsLocalRing.ResidueField (Γ(Limits.pullback κ v, ⊤))) hWE
      (IsLocalRing.residue (Γ(Limits.pullback κ v, ⊤))) b
    apply IsAlgebraic.isIntegral
    refine ⟨f, ?_, ?_⟩
    · rintro rfl
      exact hf0 (Polynomial.map_zero _)
    · apply hinj
      rw [Polynomial.aeval_def, Polynomial.hom_eval₂, map_zero]
      exact hf
  have hbij : Function.Bijective (algebraMap K (Γ(Limits.pullback κ v, ⊤))) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  haveI : IsIso ψ := (ConcreteCategory.isIso_iff_bijective ψ).mpr hbij
  have hsnd : Limits.pullback.snd κ v = (Limits.pullback κ v).isoSpec.hom ≫ Spec.map ψ := by
    rw [hψ, Iso.hom_inv_id_assoc]
  rw [hsnd]
  infer_instance

theorem wc_supp_hom_bij_weaklyEtale_affine {X Z W : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : Z ⟶ X) [IsClosedImmersion i] [IsLocallyNoetherian X]
    (f : W ⟶ X) [WeaklyEtale f] [IsAffine W]
    (hfib : IsIso (Limits.pullback.snd f i))
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Di : wcHMPullData (Limits.pullback.fst f i) ℓ) (hDi : wcHMPullCanonical Di)
    (hepi : Epi (wcSuppUnitMap Di))
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (γ : wcSuppObj Di ⟶ Df.Φ.obj (wcSuppObj D))
    (hγ : wcSuppUnitMap Di ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))
    (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) :
    Function.Bijective (fun g : wcSuppObj D ⟶ N => γ ≫ Df.Φ.map g) :=
by
  classical

  have sepAff : ∀ {X U : Scheme.{u}} (f : U ⟶ X), IsAffine U → IsSeparated f := by
    intro X U f hU
    haveI := hU
    have h1 : f ≫ Limits.terminal.from X = Limits.terminal.from U := Limits.terminal.hom_ext _ _
    haveI : IsSeparated (f ≫ Limits.terminal.from X) := by rw [h1]; infer_instance
    exact IsSeparated.of_comp f (Limits.terminal.from X)
  have qcOpen : ∀ {X : Scheme.{u}} (O : X.Opens), IsLocallyNoetherian X → QuasiCompact O.ι := by
    intro X O hX
    haveI := hX
    infer_instance
  have qcAff : ∀ {X U : Scheme.{u}} (f : U ⟶ X), IsAffine U → IsLocallyNoetherian X →
      QuasiCompact f := by
    intro X U f hU hX
    haveI := hU
    haveI := hX
    exact quasiCompact_of_compactSpace f

  have QCCOV : ∀ (S : Scheme.{u}) (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, QuasiCompact (h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro S Q n W h hq hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hw : ∀ k, WeaklyEtale (h k).left := fun k => by
      have h1 : WeaklyEtale ((h k).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h k)]
        exact (W k).prop
      exact @WeaklyEtale.of_comp _ _ _ (h k).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun k => (W k).left) (fun k => (h k).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun k => (W k).left) (fun k => (h k).left)
          hs (fun _ => trivial)) _ hq (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have L2 : ∀ {X Z Z' : Scheme.{u}} (U : X.ProEt) (hUa : IsAffine U.left) [IsLocallyNoetherian X]
      (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ U.left) (g' : Z' ⟶ Z)
      (hsq : IsPullback i' g' U.hom i) (hg' : IsIso g') (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (t : ↑(N.val.obj (Opposite.op ((wcSliceFunctor X U).obj (MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left)))))))
      (ht : ∀ (Q : X.ProEt) (a : Q ⟶ (wcSliceFunctor X U).obj (MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left)))),
        (∀ q : ↥Q.left, Q.hom q ∉ Set.range i) → (N.val.map a.op).hom t = 0)
      (Q : X.ProEt) (a b : Q ⟶ (wcSliceFunctor X U).obj (MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left)))),
      (N.val.map a.op).hom t = (N.val.map b.op).hom t := by
    intro X Z Z' U hUa hXn i _ i' g' hsq hg' N t ht Q a b
