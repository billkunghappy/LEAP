        _ = Limits.pullback.snd π (Limits.pullback.diagonal U.hom) := by
              rw [hc, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
        _ = (m₁ ≫ π) ≫ Limits.pullback.snd U.hom U.hom := by
              rw [hc, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
        _ = m₁ ≫ β := by rw [Category.assoc, hπ2]

    have hZ : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    let O : X.Opens := ⟨(Set.range ⇑i)ᶜ, hZ.isOpen_compl⟩
    obtain ⟨m₂, hm₂⟩ : ∃ m₂, m₂ = Limits.pullback.fst Q.hom O.ι := ⟨_, rfl⟩
    haveI hm₂w : WeaklyEtale m₂ := by
