  obtain ⟨B₀, _, _, _, h₀, β, w, hcomp, hw, hWw, hℓ₀, hdl⟩ :=
    wc_qmssl_cb_vertex_proj A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1
