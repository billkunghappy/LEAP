        (ShortComplex.mk μ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)
          hz).ShortExact := by
      intro n
      obtain ⟨φ, hφ⟩ : ∃ φ : ZMod ℓ →+ ZMod (ℓ ^ (n + 1)), ∀ j : ℤ,
          φ (j : ZMod ℓ) = (j : ZMod (ℓ ^ (n + 1))) * ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))) :=
        ⟨ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (n + 1))) ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))),
          by
            rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul]
            exact (ZMod.natCast_eq_zero_iff _ _).mpr ⟨1, by ring⟩⟩,
          fun j => by
            rw [ZMod.lift_coe]
            change zmultiplesHom (ZMod (ℓ ^ (n + 1))) ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))) j = _
            rw [zmultiplesHom_apply, zsmul_eq_mul]⟩
      have hφinj : Function.Injective φ := by
        intro a b hab
        obtain ⟨ka, rfl⟩ := ZMod.intCast_surjective a
        obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
        rw [hφ, hφ] at hab
        have h1 : ((ka * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) =
            ((kb * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) := by
          push_cast at hab ⊢
          exact hab
        rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
        rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
        have hl : ((ℓ ^ n : ℕ) : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓ0)
        have e1 : kb * ((ℓ ^ n : ℕ) : ℤ) - ka * ((ℓ ^ n : ℕ) : ℤ) =
            ((ℓ ^ n : ℕ) : ℤ) * (kb - ka) := by ring
        have e2 : ((ℓ ^ (n + 1) : ℕ) : ℤ) = ((ℓ ^ n : ℕ) : ℤ) * ((ℓ : ℕ) : ℤ) := by
          push_cast; ring
