theorem wc_free_coker_ladic_line_of_card_bounds (S : Scheme.{u}) [CompactSpace S] [IsLocallyNoetherian S]
    (O : S.Opens) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ)
    (hfin1 : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) N))
    (hcard1 : Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) N) ≤ ℓ)
    (hge : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S (ℓ ^ k)) N) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S (ℓ ^ k)) N)) :
    ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcLadicSheaf S ℓ) N,
      ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcLadicSheaf S ℓ) N,
        ∃ c : ℚ_[ℓ], z = y.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero N) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  haveI : NeZero ℓ := ⟨hℓ0⟩

  have G3 : ∀ {A B C : Type (u+1)} [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
      (f : A →+ B) (g : B →+ C), (∀ b, g b = 0 → ∃ a, f a = b) →
      Finite A → Finite B → Finite C → Nat.card A * Nat.card C ≤ Nat.card B →
      Function.Surjective g := by
    intro A B C _ _ _ f g hfg hA hB hC hcd
    have h1 : Nat.card B = Nat.card g.range * Nat.card g.ker := by
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup g.ker,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange g).toEquiv]
    have h2 : g.ker ≤ f.range := by
      intro b hb
      obtain ⟨a, ha⟩ := hfg b (AddMonoidHom.mem_ker.mp hb)
      exact AddMonoidHom.mem_range.mpr ⟨a, ha⟩
    have h3 : Nat.card g.ker ≤ Nat.card f.range := AddSubgroup.card_le_of_le h2
    have h4 : Nat.card f.range ≤ Nat.card A :=
      Nat.card_le_card_of_surjective f.rangeRestrict f.rangeRestrict_surjective
    have hApos : 0 < Nat.card A := Nat.card_pos
    have h5 : Nat.card C * Nat.card A ≤ Nat.card g.range * Nat.card A := by
      calc Nat.card C * Nat.card A = Nat.card A * Nat.card C := mul_comm _ _
        _ ≤ Nat.card B := hcd
        _ = Nat.card g.range * Nat.card g.ker := h1
        _ ≤ Nat.card g.range * Nat.card A := Nat.mul_le_mul_left _ (h3.trans h4)
    have h6 : Nat.card C ≤ Nat.card g.range := Nat.le_of_mul_le_mul_right h5 hApos
    exact AddMonoidHom.range_eq_top.mp (AddSubgroup.eq_top_of_le_card _ h6)
  have hcse : ∀ {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C]
        [TopologicalSpace C] [IsTopologicalAddGroup C] (φ : A →+ B) (hφ : Continuous φ) (ψ : B →+ C)
        (hψ : Continuous ψ), Topology.IsEmbedding φ → (∀ b : B, ψ b = 0 ↔ ∃ a : A, φ a = b) →
        (∃ σ : C → B, Continuous σ ∧ ∀ c, ψ (σ c) = c) →
        ∃ hzero : wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = 0,
          (ShortComplex.mk (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) hzero).ShortExact := by
      intro A B C _ _ _ _ _ _ _ _ _ φ hφ ψ hψ hemb hker hsec
      obtain ⟨σ, hσc, hσ⟩ := hsec
      have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
          (g : G ⟶ H),
          (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
          (∀ U, Function.Injective (f.hom.app U)) →
          (∀ U, Function.Surjective (g.hom.app U)) →
          (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
          ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
        intro F G H f g h1 h0 h2 h3
        have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
            (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
          intro X Y U y
          rfl
        have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
            (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
            (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
          intro X Y Z p q U y
          rfl
        have w : f ≫ g = 0 := by
          apply Sheaf.hom_ext
          ext U x
          rw [hcomp, hzero, h1]
        haveI : Epi g := by
          haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
          haveI : Epi g.hom := NatTrans.epi_of_epi_app _
          exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
        haveI : Mono f := by
          haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
          haveI : Mono f.hom := NatTrans.mono_of_mono_app _
          exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
