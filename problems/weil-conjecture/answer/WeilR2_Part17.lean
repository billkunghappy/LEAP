      cases X with
      | op W =>
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      obtain ⟨a', b', hab, ha1, ha2⟩ : ∃ (a' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))
