      rw [preN]; exact hc
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS Y₁ _ hc'
    have hd : (Abelian.Ext.mk₀ SC.g).comp ((ℓ ^ c : ℕ) • (ℓ ^ a : ℕ) • u' -
        x₃.comp (Abelian.Ext.mk₀ g) (add_zero q)) (zero_add q) = 0 := by
      rw [preS, preN, preN, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hx₃, postN, ← hw₂,
