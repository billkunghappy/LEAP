  have hs2 : ((n - 1 + 1 : ℕ) : ℤ) = ((n - 1 : ℕ) : ℤ) + 1 := hs1.symm
  exact gen Dw.Φ _ (wcSuppObj Dx) _ Dw.μ hproj (wcSuppUnitMap Dx) ((n - 1 : ℕ) : ℤ) (by omega)
