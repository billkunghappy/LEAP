        (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))
        (CommRingCat.ofHom (MvPolynomial.map (algebraMap R B₀))) := by
    intro R B₀ _ _ _ r
    refine (CommRingCat.isPushout_tensorProduct R B₀ (MvPolynomial (Fin r) R)).of_iso (Iso.refl _)
      (Iso.refl _) (Iso.refl _)
      (MvPolynomial.algebraTensorAlgEquiv R B₀).toRingEquiv.toCommRingCatIso ?_ ?_ ?_ ?_
    · simp
    · simp
    · ext x
      simp [Algebra.smul_def]
    · apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        simp [MvPolynomial.algebraTensorAlgEquiv_tmul, Algebra.smul_def]
      · intro x
        simp [MvPolynomial.algebraTensorAlgEquiv_tmul]

  have L1test : ∀ (A : Type u) [CommRing A] (r : ℕ) (π : A),
    ∃ g : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
      g ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) ∧
      (∀ (y : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y →
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y →
        ∀ p : Fin 2, Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (g y)) ∧
      ∀ (B₀ : Type u) [CommRing B₀] (b : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        ∃ fst : Spec (.of (MvPolynomial (Fin r) B₀)) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
          IsPullback fst (Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) g b := by
    intro A _ r π
    classical
    have K1 : ∀ (m : ℕ) (h1 : 1 < m),
        (∑ p : Fin m, ∑ q : Fin m, MvPolynomial.C ((Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin m) A) = MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ := by
      intro m h1
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin m)]
