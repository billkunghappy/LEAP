      (k : ℤ) (_ : 0 < k)
      (c : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx)) ⟶
          (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx)))⟦k⟧), c = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ Sx htr hpt k hk c
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hk.le
    obtain ⟨f₀, hf₀⟩ := (htr m).2 c
    have hf₁ : Φ.mapDerivedCategory.map f₀ ≫
        (Φ.mapDerivedCategory.commShiftIso (m : ℤ)).hom.app
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            Sx)) = c := hf₀
    rw [← hf₁, hpt (m : ℤ) hk f₀, Functor.map_zero, Limits.zero_comp]
  have htrX := wc_pmn_ldp_supp_derived_transfer _ ℓ Dw (wcSuppObj Dx) hinj hbij
  have hSSpos : ∀ k : ℤ, 0 < k → ∀ c : Sb ⟶ Sb⟦k⟧, c = 0 :=
    fun k hk c => sspos Dw.Φ (wcSuppObj Dx) (fun m => htrX _ m) hpt k hk c

  have fin : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One Sx : 𝒞) (ub0 : One ⟶ Sx),
      (∀ g : Φ.obj One ⟶ Φ.obj Sx, ∃ c : Φ.obj Sx ⟶ Φ.obj Sx, g = Φ.map ub0 ≫ c) →
      (∀ c : Φ.obj Sx ⟶ Φ.obj Sx, Φ.map ub0 ≫ c = 0 → c = 0) →
      Projective (Φ.obj One) →
      (∀ k : ℤ, 0 < k → ∀ c : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx)) ⟶
          (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx)))⟦k⟧, c = 0) →
      ∀ (Kp : DerivedCategory 𝒞W)
        (ι : Kp ⟶ Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))
        (δ : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((CochainComplex.singleFunctor 𝒞 0).obj Sx)) ⟶ Kp⟦(1 : ℤ)⟧),
        Pretriangulated.Triangle.mk ι (Φ.mapDerivedCategory.map (DerivedCategory.Q.map
          ((CochainComplex.singleFunctor 𝒞 0).map ub0))) δ ∈ distTriang _ →
        ∀ (k : ℤ) (f : Kp ⟶ (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((CochainComplex.singleFunctor 𝒞 0).obj Sx)))⟦k⟧), f = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ One Sx ub0 G1 G2 GP GS Kp ι δ hT k f
    refine t1 ι _ δ hT ?_ ?_ ?_ ?_ k f
    · exact (dlem Φ ub0 G1 G2).1
    · exact (dlem Φ ub0 G1 G2).2
    · intro k hk g
      rcases lt_or_gt_of_ne hk with h | h
      · exact dvan Φ One Sx k (Or.inl h) g
      · exact dvan Φ One Sx k (Or.inr ⟨h, GP⟩) g
    · intro k hk c
      rcases lt_or_gt_of_ne hk with h | h
      · exact dvan Φ Sx Sx k (Or.inl h) c
      · exact GS k h c
  exact fin Dw.Φ _ (wcSuppObj Dx) (wcSuppUnitMap Dx) H1 H2 hPΦ hSSpos Kp ι δ hT k f

theorem wc_pmn_ldp_shens_forget_supp_zero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx)
    (Dw : wcHMPullData (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (hDw : wcHMPullCanonical Dw) :
    haveI := Dp.additive
    haveI := Di.additive
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
    let Ψ := (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    let R := Dw.Φ.mapDerivedCategory
    let Lb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      (SheafOfModules.unit (wcRingSheaf
        (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))
    let Sb := R.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)))
    let ub : Lb ⟶ Sb :=
      R.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map (wcSuppUnitMap Dx)))
    ∀ g : Sb ⟶ (R.obj (DerivedCategory.Q.obj Ψ))⟦((n - 1 : ℕ) : ℤ)⟧, ub ≫ g = 0 :=
by
  intro P K Ψ R Lb Sb ub g
  haveI := Dp.additive
  haveI := Di.additive
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))

  have retr : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (T : Pretriangulated.Triangle (DerivedCategory 𝒞)), T ∈ distTriang _ → T.mor₃ = 0 →
      ∃ r : T.obj₂ ⟶ T.obj₁, T.mor₁ ≫ r = 𝟙 _ := by
    intro 𝒞 _ _ _ T hT h3
    have hT' := Pretriangulated.inv_rot_of_distTriang T hT
    obtain ⟨r, hr⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hT'
      (𝟙 T.obj₁ : T.invRotate.obj₂ ⟶ T.obj₁) (by
        rw [Pretriangulated.Triangle.invRotate_mor₁, h3, Functor.map_zero, Limits.zero_comp,
          neg_zero]
        exact Limits.zero_comp)
    let r' : T.obj₂ ⟶ T.obj₁ := r
    have hr' : T.mor₁ ≫ r' = 𝟙 T.obj₁ := by
      rw [Pretriangulated.Triangle.invRotate_mor₂] at hr
      exact hr.symm
    exact ⟨r', hr'⟩

  have key : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (T : Pretriangulated.Triangle (DerivedCategory 𝒞)) (_ : T ∈ distTriang _) (N M : ℤ)
      (S : DerivedCategory 𝒞) (σ : T.obj₃⟦N⟧ ≅ S)
      (_ : ∀ a : T.obj₁ ⟶ T.obj₁⟦N⟧, a = 0)
      (_ : ∀ c : S ⟶ S, c = 0 ∨ IsIso c)
      (θ : S ⟶ T.obj₁⟦M⟧) (_ : θ ≠ 0) (_ : θ ≫ T.mor₁⟦M⟧' = 0)
      (u : T.obj₁ ⟶ S) (g : S ⟶ T.obj₂⟦N⟧), u ≫ g = 0 := by
    intro 𝒞 _ _ _ T hT N M S σ h1 h2 θ hθ0 hθe u g
    obtain ⟨c, hcdef⟩ : ∃ c : S ⟶ S, c = g ≫ T.mor₂⟦N⟧' ≫ σ.hom := ⟨_, rfl⟩
    have e1 : g ≫ T.mor₂⟦N⟧' = c ≫ σ.inv := by
      rw [hcdef, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rcases h2 c with hc | hc
    · have hg : g ≫ T.mor₂⟦N⟧' = 0 := by
        rw [e1, hc, Limits.zero_comp]
      let TN := (shiftFunctor (Pretriangulated.Triangle (DerivedCategory 𝒞)) N).obj T
      have hTN : TN ∈ distTriang _ := Pretriangulated.Triangle.shift_distinguished T hT N
      obtain ⟨a, ha⟩ : ∃ a : T.obj₁ ⟶ T.obj₁⟦N⟧, u ≫ g = a ≫ (N.negOnePow • T.mor₁⟦N⟧') :=
        Pretriangulated.Triangle.coyoneda_exact₂ TN hTN (u ≫ g) (by
          change (u ≫ g) ≫ (N.negOnePow • T.mor₂⟦N⟧') = 0
          rw [Units.smul_def, Preadditive.comp_zsmul, Category.assoc, hg, Limits.comp_zero,
            smul_zero])
      have ha0 : a = 0 := h1 a
      rw [ha, ha0, Limits.zero_comp]
    · exfalso
      haveI := hc
      have hs : (σ.hom ≫ inv c ≫ g) ≫ T.mor₂⟦N⟧' = 𝟙 _ := by
        rw [Category.assoc, Category.assoc, e1, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]
      have h3N : T.mor₃⟦N⟧' = 0 := by
        calc T.mor₃⟦N⟧' = ((σ.hom ≫ inv c ≫ g) ≫ T.mor₂⟦N⟧') ≫ T.mor₃⟦N⟧' := by
              rw [hs, Category.id_comp]
          _ = (σ.hom ≫ inv c ≫ g) ≫ (T.mor₂ ≫ T.mor₃)⟦N⟧' := by
              rw [Functor.map_comp, Category.assoc]
          _ = 0 := by
              rw [Pretriangulated.comp_distTriang_mor_zero₂₃ _ hT, Functor.map_zero,
                Limits.comp_zero]
      have h3 : T.mor₃ = 0 :=
        (shiftFunctor (DerivedCategory 𝒞) N).map_injective (by rw [h3N, Functor.map_zero])
      obtain ⟨r, hr⟩ := retr T hT h3
      apply hθ0
      calc θ = θ ≫ (T.mor₁ ≫ r)⟦M⟧' := by
            rw [hr, CategoryTheory.Functor.map_id, Category.comp_id]
        _ = (θ ≫ T.mor₁⟦M⟧') ≫ r⟦M⟧' := by
            rw [Functor.map_comp, Category.assoc]
        _ = 0 := by rw [hθe, Limits.zero_comp]

  have obs : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (N : ℤ) (S : DerivedCategory 𝒞) (T : Pretriangulated.Triangle (DerivedCategory 𝒞))
      (_ : T ∈ Pretriangulated.distinguishedTriangles),
      Nonempty (T.obj₃⟦N⟧ ≅ S) →
      (∀ r : T.obj₂ ⟶ T.obj₁, T.mor₁ ≫ r ≠ 𝟙 _) →
      ∃ θ : S ⟶ T.obj₁⟦N + 1⟧, θ ≠ 0 ∧ θ ≫ T.mor₁⟦N + 1⟧' = 0 := by
    intro 𝒞 _ _ _ N S T hT hσ hnr
    obtain ⟨σ⟩ := hσ
    have hmor3 : T.mor₃ ≠ 0 := by
      intro h3
      obtain ⟨r, hr⟩ := retr T hT h3
      exact hnr r hr
    let α := shiftFunctorAdd' (DerivedCategory 𝒞) 1 N (N + 1) (by omega)
    refine ⟨σ.inv ≫ T.mor₃⟦N⟧' ≫ α.inv.app T.obj₁, ?_, ?_⟩
    · intro h0
      apply hmor3
      have e : T.mor₃⟦N⟧' = 0 := by
        have : T.mor₃⟦N⟧' =
            σ.hom ≫ (σ.inv ≫ T.mor₃⟦N⟧' ≫ α.inv.app T.obj₁) ≫ α.hom.app T.obj₁ := by
          simp only [Category.assoc, Iso.inv_hom_id_app, Iso.hom_inv_id_assoc]
          exact (Category.comp_id _).symm
        rw [this, h0, Limits.zero_comp, Limits.comp_zero]
      exact (shiftFunctor (DerivedCategory 𝒞) N).map_injective (by rw [e, Functor.map_zero])
    · have hn := α.inv.naturality T.mor₁
      rw [Functor.comp_map] at hn
      rw [Category.assoc, Category.assoc, ← hn, ← Category.assoc (T.mor₃⟦N⟧'),
        ← CategoryTheory.Functor.map_comp, Pretriangulated.comp_distTriang_mor_zero₃₁ _ hT,
        Functor.map_zero, Limits.zero_comp, Limits.comp_zero]

  have proj : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
      {_hD : HasDerivedCategory.{u+2} 𝒞}
      (Pt One : 𝒞) [Projective Pt] (m : ℕ) (k : ℤ) (_ : ((m + 1 : ℕ) : ℤ) = k)
      (g : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Pt) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One))⟦k⟧),
      g = 0 := by
    intro 𝒞 _ _ _ Pt One _ m k hk g
    subst hk
    let _ : HasExt 𝒞 := HasExt.standard 𝒞
    let ι := DerivedCategory.singleFunctorIsoCompQ 𝒞 0
    let g' : ShiftedHom ((DerivedCategory.singleFunctor 𝒞 0).obj Pt)
        ((DerivedCategory.singleFunctor 𝒞 0).obj One) ((m + 1 : ℕ) : ℤ) :=
      ι.hom.app Pt ≫ g ≫ (ι.inv.app One)⟦((m + 1 : ℕ) : ℤ)⟧'
    have hg' : g' = 0 := by
      have h0 := Abelian.Ext.eq_zero_of_projective (Abelian.Ext.homEquiv.symm g')
      rw [← Abelian.Ext.homEquiv.apply_symm_apply g', h0]
      change (0 : Abelian.Ext Pt One (m + 1)).hom = 0
      rw [Abelian.Ext.zero_hom]
    have h1 : ι.hom.app Pt ≫ g ≫ (ι.inv.app One)⟦((m + 1 : ℕ) : ℤ)⟧' =
        ι.hom.app Pt ≫ 0 ≫ (ι.inv.app One)⟦((m + 1 : ℕ) : ℤ)⟧' := by
      rw [Limits.zero_comp, Limits.comp_zero]
      exact hg'
    rwa [cancel_epi, cancel_mono] at h1

  have h1gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One : 𝒞) (OneW : 𝒞W) (μ : Φ.obj One ≅ OneW)
      (_ : Projective OneW) (m : ℕ) (k : ℤ) (_ : ((m + 1 : ℕ) : ℤ) = k)
      (a : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) ⟶
        (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦k⟧), a = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ One OneW μ hP m k hk a
    haveI := hP
    let ιL : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).obj
        OneW) ≅ Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) :=
      DerivedCategory.Q.mapIso ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).mapIso
          μ.symm) ≪≫
        DerivedCategory.Q.mapIso ((HomologicalComplex.singleMapHomologicalComplex Φ
          (ComplexShape.up ℤ) 0).symm.app One) ≪≫
        ((Φ.mapDerivedCategoryFactors).app _).symm
    have h0 : ιL.hom ≫ a ≫ (ιL.inv)⟦k⟧' = 0 := proj OneW OneW m k hk _
    rw [← cancel_epi ιL.hom, ← cancel_mono ((ιL.inv)⟦k⟧'), Limits.comp_zero, Limits.zero_comp]
    simpa only [Category.assoc] using h0

  have h2gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (Sx : 𝒞)
      (_ : ∀ c : Sx ⟶ Sx, c ≠ 0 → IsIso c)
      (_ : Function.Bijective (fun f : DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            Sx))⟦((0 : ℕ) : ℤ)⟧ =>
        Φ.mapDerivedCategory.map f ≫ (Φ.mapDerivedCategory.commShiftIso ((0 : ℕ) : ℤ)).hom.app
            (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
              Sx))))
      (c : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx)) ⟶
          Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor 𝒞 0).obj Sx))),
      c = 0 ∨ IsIso c := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ Sx hfield htr c
    let zW := shiftFunctorZero' (DerivedCategory 𝒞W) ((0 : ℕ) : ℤ) (by simp)
    let zX := shiftFunctorZero' (DerivedCategory 𝒞) ((0 : ℕ) : ℤ) (by simp)
    obtain ⟨f, hf⟩ := htr.2 (c ≫ zW.inv.app (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
      ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx))))
    have hf2 : Φ.mapDerivedCategory.map f ≫
        (Φ.mapDerivedCategory.commShiftIso ((0 : ℕ) : ℤ)).hom.app
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)) =
        c ≫ zW.inv.app (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx))) := hf
    have hc : c = (c ≫ zW.inv.app (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
