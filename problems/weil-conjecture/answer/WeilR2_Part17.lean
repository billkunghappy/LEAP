      intro W' k hk
      have e1 : (N.val.map (k ≫ a).op).hom t = (N.val.map k.op).hom ta := by
        rw [hta, op_comp, PresheafOfModules.map_comp_apply]
      have e2 : (N.val.map (k ≫ b).op).hom t = (N.val.map k.op).hom tb := by
        rw [htb, op_comp, PresheafOfModules.map_comp_apply]
      have key : (N.val.map k.op).hom ta = (N.val.map k.op).hom tb := by
        rcases hk with h | h
