  choose Dk hDk using fun k : ℕ => wc_zmod_pull_data_exists (((wcProEtBC g).obj Vt).hom ≫ 𝟙 X) (ℓ ^ k)
  have htor := fun (k j : ℕ) (hk : 1 ≤ k) =>
    wc_wcontr_torsion_kunneth_of_base_bij g g (𝟙 X) (𝟙 (Spec (.of B))) IsPullback.of_id_fst
      inferInstance inferInstance (ℓ ^ k) Vt hW (hb k hk) j (Dk k) (hDk k)
  have he : Function.Bijective (fun c : Fin 1 → ℚ_[ℓ] =>
      ∑ a, wcHMScalar X ℓ q (c a) ((fun _ : Fin 1 => y) a)) := by
    have := hy.comp (Equiv.funUnique (Fin 1) ℚ_[ℓ]).bijective
    convert this using 1
    funext c
    rw [Fin.sum_univ_one]
    rfl
  have hK := wc_hm_ladic_kunneth_passage (Y := X) (T := Limits.pullback Vt.hom g) (W₀ := Vt.left) ℓ
    (Limits.pullback.fst Vt.hom g) (((wcProEtBC g).obj Vt).hom ≫ 𝟙 X) Dc hDc Dk hDk hfin htor q 1
    (fun _ => y) he
  have hκ : Function.Bijective (fun r : (wcRingSheaf (Spec (.of B)) ℓ).obj.obj (Opposite.op Vt) =>
      (fun _ : Fin 1 => (show C(↥Vt.left, ULift.{u+1} ℚ_[ℓ]) from r))) :=
    ⟨fun a b h => congrFun h 0, fun c => ⟨c 0, funext fun x => by fin_cases x; rfl⟩⟩
  refine (Function.Bijective.of_comp_iff' (Ψ Vt hVt).bijective _).mp ?_
  convert hK.comp hκ using 1
  funext r
  simp only [Function.comp_apply, Fin.sum_univ_one]
  refine (hlin Vt hVt r _).trans ?_
  erw [hn, ← hcomp]
