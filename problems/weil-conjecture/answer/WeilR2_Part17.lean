    rw [hτ (τ p), hτ p]
    split_ifs <;> omega
  let T : Equiv.Perm (Fin (2 * e + 1 + 1)) :=
    { toFun := τ, invFun := τ, left_inv := hττ, right_inv := hττ }
  have hT : ∀ p, T p = τ p := fun _ => rfl
  have hc : ∀ p q, MAT (τ p) (τ q) = MAT q p := by
    intro p q
    rw [hMATpq, hMATpq]
    have hiff : ((τ p).val % 2 = 0 ∧ (τ q).val = (τ p).val + 1) ↔
        (q.val % 2 = 0 ∧ p.val = q.val + 1) := by
      rw [hτ p, hτ q]
      split_ifs <;> constructor <;> intro h <;> omega
    exact if_congr hiff rfl rfl
  have hAf : MvPolynomial.rename τ (∑ p, ∑ q, MvPolynomial.C (MAT p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C 0 : MvPolynomial (Fin (2 * e + 1 + 1)) K) =
      ∑ p, ∑ q, MvPolynomial.C (MAT p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 0 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.rename_C, MvPolynomial.rename_X]
    congr 1
    calc ∑ p, ∑ q, (MvPolynomial.C (MAT p q) * MvPolynomial.X (τ p) * MvPolynomial.X (τ q) :
          MvPolynomial (Fin (2 * e + 1 + 1)) K)
        = ∑ p, ∑ q, (MvPolynomial.C (MAT (τ p) (τ q)) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin (2 * e + 1 + 1)) K) := by
