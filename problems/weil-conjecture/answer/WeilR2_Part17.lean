    IsPullback.isoIsPullback_hom_fst _ _ hT (isPullback_morphismRestrict k U₀)
  obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists e.hom ℓ
  have hcomp := wc_hm_pull_comp (k ∣_ U₀) e.hom kT he DfO hDfO De hDe DT hDT q ω
