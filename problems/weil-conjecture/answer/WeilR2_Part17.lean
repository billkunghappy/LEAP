        ∀ w : S0 ⟶ A2, ∃ w' : S0 ⟶ A1, w = w' ≫ a := by
      intro A1 A2 A3 S0 a b h ε hT hc
      have hK : ∀ w : S0 ⟶ A2, w ≫ b = 0 := by
