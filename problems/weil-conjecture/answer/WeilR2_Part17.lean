  obtain ⟨εY, -, hεY⟩ := wc_int_supp_rat_eps ℓ Di hepiY EY hEY
  refine ⟨wcIntSuppRat Di EY εY (2 * r), ?_⟩
  intro R _ _ k hk hz T iT g hP Dk hDk DT hDT hepi γ hγ DΛ hDΛ γΛ hγΛ
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
