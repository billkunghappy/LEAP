theorem wc_pmn_sfu_cw_kinj_precomp_surj {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
    [HasDerivedCategory.{u+2} 𝒞] [HasExt.{u+2} 𝒞] (L : CochainComplex 𝒞 ℤ) (d : ℤ)
    (hL : L.IsStrictlyGE d)
    (hinj : ∀ q : ℤ, Injective (L.X q)) {X X' : 𝒞} (ι : X' ⟶ X)
    (hι : ∀ q : ℤ, Function.Bijective (fun g : X ⟶ L.X q => ι ≫ g))
    (One : 𝒞) (eK : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One ⟶ L)
    (N : ℕ) (y : Abelian.Ext X' One N) :
    ∃ h : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj X) ⟶
        (DerivedCategory.Q.obj L)⟦(N : ℤ)⟧,
      DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map ι) ≫ h =
        ((DerivedCategory.singleFunctorIsoCompQ 𝒞 0).inv.app X' ≫ y.hom ≫
          ((DerivedCategory.singleFunctorIsoCompQ 𝒞 0).hom.app One)⟦(N : ℤ)⟧') ≫
          (DerivedCategory.Q.map eK)⟦(N : ℤ)⟧' :=
by
  haveI := hL
  haveI := hinj
  haveI hK : L.IsKInjective := CochainComplex.isKInjective_of_injective L d
  haveI hMK : ((shiftFunctor (CochainComplex 𝒞 ℤ) (N : ℤ)).obj L).IsKInjective :=
    CochainComplex.instIsKInjectiveObjIntShiftFunctor L (N : ℤ)

  have s2 : ∀ (A M : CochainComplex 𝒞 ℤ) [M.IsKInjective]
      (g : DerivedCategory.Q.obj A ⟶ DerivedCategory.Q.obj M),
      ∃ f : A ⟶ M, DerivedCategory.Q.map f = g := by
    intro A M _ g
    let θ := DerivedCategory.quotientCompQhIso 𝒞
    obtain ⟨k, hk⟩ := (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj A) M).2
        (θ.hom.app A ≫ g ≫ θ.inv.app M)
    obtain ⟨f, rfl⟩ := (HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).map_surjective k
    refine ⟨f, ?_⟩
    have hnat := θ.hom.naturality f
    rw [← cancel_epi (θ.hom.app A), ← hnat]
    simp only [Functor.comp_map]
    rw [hk]
    simp

  have s3 : ∀ (M : CochainComplex 𝒞 ℤ),
      (∀ k : ℤ, Function.Bijective (fun g : X ⟶ M.X k => ι ≫ g)) →
      ∀ f' : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj X' ⟶ M,
      ∃ f : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj X ⟶ M,
        (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ι ≫ f = f' := by
    intro M hM f'
    obtain ⟨φ, hφ⟩ := (hM 0).2
      ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 X').inv ≫ f'.f 0)
    have hφ' : ι ≫ φ =
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 X').inv ≫ f'.f 0 := hφ
    have hcyc : ∀ k : ℤ, (ComplexShape.up ℤ).Rel 0 k → φ ≫ M.d 0 k = 0 := by
      intro k _
      apply (hM k).1
      show ι ≫ (φ ≫ M.d 0 k) = ι ≫ 0
      rw [← Category.assoc, hφ', Category.assoc, f'.comm 0 k,
        HomologicalComplex.single_obj_d]
      simp
    refine ⟨HomologicalComplex.mkHomFromSingle φ hcyc, ?_⟩
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, HomologicalComplex.mkHomFromSingle_f,
      HomologicalComplex.single_map_f_self]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [hφ', Iso.hom_inv_id_assoc]

  have main : ∀ g : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj X') ⟶
      (DerivedCategory.Q.obj L)⟦(N : ℤ)⟧,
      ∃ h : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj X) ⟶
        (DerivedCategory.Q.obj L)⟦(N : ℤ)⟧,
        DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map ι) ≫ h = g := by
    intro g
    let c := (DerivedCategory.Q.commShiftIso (N : ℤ)).app L
    obtain ⟨f', hf'⟩ := s2 ((CochainComplex.singleFunctor 𝒞 0).obj X')
      ((shiftFunctor (CochainComplex 𝒞 ℤ) (N : ℤ)).obj L) (g ≫ c.inv)
    obtain ⟨f, hf⟩ := s3 ((shiftFunctor (CochainComplex 𝒞 ℤ) (N : ℤ)).obj L)
      (fun k => hι (k + N)) f'
    have hf2 : (CochainComplex.singleFunctor 𝒞 0).map ι ≫ f = f' := hf
    refine ⟨DerivedCategory.Q.map f ≫ c.hom, ?_⟩
    rw [← Category.assoc, ← Functor.map_comp, hf2, hf']
    simp
  exact main _

