  obtain ⟨D₁, hD₁⟩ := wc_zmod_pull_data_exists σ₁ (ℓ ^ k)
  obtain ⟨D₂, hD₂⟩ := wc_zmod_pull_data_exists (q' ≫ σ₁) (ℓ ^ k)
  have z₁ := wc_zmod_proet_pull_bij_of_et_pull_bij σ₁ (ℓ ^ k) hn D₁ hD₁ E₁ j b₁
  have z₂ := wc_zmod_proet_pull_bij_of_et_pull_bij (q' ≫ σ₁) (ℓ ^ k) hn D₂ hD₂ E₂ j b₂
  have hfun : ⇑(wcZModPull D₂ j) = ⇑(wcZModPull D j) ∘ ⇑(wcZModPull D₁ j) :=
