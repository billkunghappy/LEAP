  have hSl : ∀ {S X : Scheme.{u}} (w : S ⟶ X) (hw : WeaklyEtale w) (Dw : wcHMPullData w ℓ)
      (hDw : wcHMPullCanonical Dw) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (f : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ M) (W : S.ProEt),
      ∃ n : C(↥W.left, ULift.{u+1} ℚ_[ℓ]), (∃ n' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]), n * n' = 1) ∧
        ∀ t : (SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op W),
          ((Dw.μ.inv ≫ Dw.Φ.map f).val.app (Opposite.op W)).hom t = 0 ↔
          (f.val.app (Opposite.op ((wcSliceFunctor X
            (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).obj W))).hom
            ((show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from t) * n) = 0 := by
    intro S X w hw Dw hDw M f W
    obtain ⟨hcont, -, -⟩ := wc_lpsc_site X (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)
    haveI := hcont
    obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso X ℓ (MorphismProperty.Over.mk ⊤ w hw : X.ProEt) Dw hDw
    let ν := Dw.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf X ℓ))
    let ν' := θ.inv.app (SheafOfModules.unit (wcRingSheaf X ℓ)) ≫ Dw.μ.hom
    have hνν : ν ≫ ν' = 𝟙 _ :=
      (Category.assoc _ _ _).trans ((congrArg (Dw.μ.inv ≫ ·)
        (θ.hom_inv_id_app_assoc (SheafOfModules.unit (wcRingSheaf X ℓ)) Dw.μ.hom)).trans
        Dw.μ.inv_hom_id)
    let n : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) :=
      (ν.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
    let n' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) :=
      (ν'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
    have hν : ∀ s : C(↥W.left, ULift.{u+1} ℚ_[ℓ]),
        ((ν.val.app (Opposite.op W)).hom s : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = s * n := by
      intro s
      have e := (ν.val.app (Opposite.op W)).hom.map_smul s (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
      have e2 : (ν.val.app (Opposite.op W)).hom s =
          (ν.val.app (Opposite.op W)).hom (s * 1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) :=
        congrArg (fun y => (ν.val.app (Opposite.op W)).hom y) (mul_one s).symm
      exact e2.trans e
    have hν' : ∀ s : C(↥W.left, ULift.{u+1} ℚ_[ℓ]),
        ((ν'.val.app (Opposite.op W)).hom s : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = s * n' := by
      intro s
      have e := (ν'.val.app (Opposite.op W)).hom.map_smul s (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
      have e2 : (ν'.val.app (Opposite.op W)).hom s =
          (ν'.val.app (Opposite.op W)).hom (s * 1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) :=
        congrArg (fun y => (ν'.val.app (Opposite.op W)).hom y) (mul_one s).symm
      exact e2.trans e
    have hnn' : n * n' = 1 := by
      have e1 : ((ν ≫ ν').val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) =
          (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) := by
        rw [hνν] <;> rfl
      have e2 : ((ν ≫ ν').val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) =
          n * n' := hν' n
      exact e2.symm.trans e1
    refine ⟨n, ⟨n', hnn'⟩, fun t => ?_⟩
    have hθinj : ∀ y : (Dw.Φ.obj M).val.obj (Opposite.op W),
        ((θ.hom.app M).val.app (Opposite.op W)).hom y = 0 → y = 0 := by
      intro y hy
      have e1 : ((θ.hom.app M ≫ θ.inv.app M).val.app (Opposite.op W)).hom y = y := by
        rw [Iso.hom_inv_id_app] <;> rfl
      have e2 : ((θ.hom.app M ≫ θ.inv.app M).val.app (Opposite.op W)).hom y =
          ((θ.inv.app M).val.app (Opposite.op W)).hom
            (((θ.hom.app M).val.app (Opposite.op W)).hom y) := rfl
      exact e1.symm.trans (e2.trans
        ((congrArg ((θ.inv.app M).val.app (Opposite.op W)).hom hy).trans (map_zero _)))
    have hstep : ((Dw.μ.inv ≫ Dw.Φ.map f).val.app (Opposite.op W)).hom t = 0 ↔
        (((Dw.μ.inv ≫ Dw.Φ.map f) ≫ θ.hom.app M).val.app (Opposite.op W)).hom t = 0 := by
      constructor
      · intro h
        exact (congrArg ((θ.hom.app M).val.app (Opposite.op W)).hom h).trans (map_zero _)
      · intro h
        exact hθinj _ h
    have hnat : (Dw.μ.inv ≫ Dw.Φ.map f) ≫ θ.hom.app M =
        ν ≫ (wcSliceRes X ℓ (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).map f :=
      (Category.assoc _ _ _).trans ((congrArg (Dw.μ.inv ≫ ·) (θ.hom.naturality f)).trans
        (Category.assoc _ _ _).symm)
    have e3 : ((ν ≫ (wcSliceRes X ℓ (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).map f).val.app
          (Opposite.op W)).hom t =
        (f.val.app (Opposite.op ((wcSliceFunctor X
            (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).obj W))).hom
          ((show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from t) * n) := by
      show (f.val.app (Opposite.op ((wcSliceFunctor X
          (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).obj W))).hom
          ((ν.val.app (Opposite.op W)).hom t) = _
      exact congrArg (fun y : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) => (f.val.app (Opposite.op
        ((wcSliceFunctor X (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).obj W))).hom y) (hν t)
    have e4 : (((Dw.μ.inv ≫ Dw.Φ.map f) ≫ θ.hom.app M).val.app (Opposite.op W)).hom t =
        ((ν ≫ (wcSliceRes X ℓ (MorphismProperty.Over.mk ⊤ w hw : X.ProEt)).map f).val.app
          (Opposite.op W)).hom t :=
      congrArg (fun φ => (φ.val.app (Opposite.op W)).hom t) hnat
    refine hstep.trans ⟨fun h => ?_, fun h => ?_⟩
    · exact (e4.trans e3).symm.trans h
    · exact (e4.trans e3).trans h

  have hgeom : ∀ y, y ∈ Set.range (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ↔ y = xs := by
    intro y
    constructor
    · rintro ⟨z, rfl⟩
      exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply xs _)
    · intro hy
      exact ⟨IsLocalRing.closedPoint (AlgebraicClosure
        ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs)),
