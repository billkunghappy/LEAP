theorem wc_smooth_pair_qcsep_strict_local_supp_line (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (k : Spec R ⟶ Y) (hk : WeaklyEtale k)
    (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z) (hP : IsPullback g iT i k)
    (DT : wcHMPullData iT ℓ) (hDT : wcHMPullCanonical DT) (hepi : Epi (wcSuppUnitMap DT)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
    ∀ v w : wcSuppExt DT (2 * r), v ≠ 0 →
      ∃ c : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst (Spec R) ℓ c)) (add_zero (2 * r)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
  intro v w hv
  haveI : WeaklyEtale k := hk

  have hdom : IsDomain R := by
    let e := stalkClosedPointIso R
    have h1 : HenselianLocalRing ((Spec R).presheaf.stalk (IsLocalRing.closedPoint R)) :=
      wc_henselian_sepClosed_transfer.1 _ _ e.symm.commRingCatIsoToRingEquiv inferInstance
    have h2 : IsSepClosed (IsLocalRing.ResidueField
        ((Spec R).presheaf.stalk (IsLocalRing.closedPoint R))) :=
      wc_henselian_sepClosed_transfer.2 _ _
        (IsLocalRing.ResidueField.mapEquiv e.symm.commRingCatIsoToRingEquiv) inferInstance
    have hd : IsDomain ((Spec R).presheaf.stalk (IsLocalRing.closedPoint R)) :=
      wc_weaklyEtale_smooth_stalk_isDomain K pY n (Scheme.ProEt.mk k)
        (IsLocalRing.closedPoint R) ⟨h1, h2⟩
    haveI := hd
