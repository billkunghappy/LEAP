    hprojFib _ _ (wc_pmn_shens_closed_fibre_square F' F'' Y n D V A e x hx₁ B Λ' W'' φ' a' hsh)

  have hlift : ∀ c : wcSuppObj Dx ⟶ wcSuppObj Dx,
      ∃ v : SheafOfModules.unit (wcRingSheaf
