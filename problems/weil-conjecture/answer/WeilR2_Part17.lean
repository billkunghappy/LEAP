      _ = _ := by rw [hlin, hav]

theorem wc_smooth_pair_qcsep_int_supp_rat_restrict (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
