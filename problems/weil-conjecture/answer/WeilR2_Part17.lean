  haveI hc' : CompactSpace (Scheme.ProEt.mk (𝟙 (Uodd : Scheme.{u}))).left := hUc
  haveI hs' : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 (Uodd : Scheme.{u}))).left) :=
    hsep

  obtain ⟨j, hj⟩ : ∃ j, 4 * e = j + 1 := ⟨4 * e - 1, by omega⟩
