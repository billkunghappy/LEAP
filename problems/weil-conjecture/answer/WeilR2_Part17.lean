  have s2 : ∀ {X : Scheme.{u}} [IsLocallyNoetherian X] (x : X), IsClosed ({x} : Set X) →
      ∀ [IsSepClosed (X.residueField x)] (Dx : wcHMPullData (wcEtGeomPt X x) ℓ),
      wcHMPullCanonical Dx → wcSuppUnitMap Dx ≠ 0 → ∀ (Ox : X.Opens), (Ox : Set X) = {x}ᶜ →
      ∃ (P : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
        (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf X ℓ),
          (P ⟶ M) ≃ M.val.obj (Opposite.op (Scheme.ProEt.mk Ox.ι)))
        (_ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
          ev N (g ≫ ψ) = (ψ.val.app (Opposite.op (Scheme.ProEt.mk Ox.ι))).hom (ev M g))
        (f : P ⟶ SheafOfModules.unit (wcRingSheaf X ℓ)) (hf : f ≫ wcSuppUnitMap Dx = 0),
        (ShortComplex.mk f (wcSuppUnitMap Dx) hf).ShortExact := by
    intro X _ x hx _ Dx hDx hne Ox hOx
    haveI : IsClosedImmersion (X.fromSpecResidueField x) :=
      isClosed_singleton_iff_isClosedImmersion.mp hx
    have hO' : (Ox : Set X) = (Set.range (X.fromSpecResidueField x))ᶜ := by
      rw [Scheme.range_fromSpecResidueField, hOx]
    obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists (X.fromSpecResidueField x) ℓ
    have htf : ∀ (V : (X.ProEt)ᵒᵖ) (m : ℕ)
        (r : ↑((wcRingSheaf X ℓ).obj.obj V)), m ≠ 0 → m • r = 0 → r = 0 := by
      intro V m r hm hr
      have key : ∀ (T : Type u) [TopologicalSpace T] (s : C(T, ULift.{u+1} ℚ_[ℓ])),
          m • s = 0 → s = 0 := by
        intro T _ s hs
        refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
        let g : C(T, ULift.{u+1} ℚ_[ℓ]) →+ ℚ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
          ((Pi.evalAddMonoidHom (fun _ : T => ULift.{u+1} ℚ_[ℓ]) t).comp
            ContinuousMap.coeFnAddMonoidHom)
        have h1 : m • g s = 0 := ((map_nsmul g m s).symm.trans (congrArg g hs)).trans (map_zero g)
        rw [nsmul_eq_mul] at h1
        exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hm)
      exact key ↥((Opposite.unop V).left) r hr
    obtain ⟨L, adj, hLA, hLL, hLC⟩ :=
      sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree (Scheme.ProEt.topology X)
        (wcRingSheaf X ℓ) htf
    haveI := hLA
    haveI := hLL
    haveI := hLC
    obtain ⟨ε, h, hex⟩ := wc_closed_supp_kernel_free (X.fromSpecResidueField x) ℓ Dι hDι L adj Ox hO'
    haveI : Mono (wcFreeSheafMap X (MorphismProperty.Over.homMk Ox.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk Ox.ι ⟶ Scheme.ProEt.mk (𝟙 X))) :=
      wc_free_sheaf_map_mono X _ _ _ (show Mono Ox.ι from inferInstance)
    haveI := wc_supp_unit_epi_of_closed (X.fromSpecResidueField x) ℓ Dι hDι
    obtain ⟨σ⟩ := wc_supp_obj_sepClosed_geomPt_iso x Dι hDι Dx hDx
    have hh₀ : wcSuppUnitMap Dι ≫ σ.hom ≠ 0 := by
      intro h0
      apply hne
      have hσ : σ.hom = 0 := by
        rw [← cancel_epi (wcSuppUnitMap Dι), h0, Limits.comp_zero]
      rw [← Category.comp_id (wcSuppUnitMap Dx), ← σ.inv_hom_id, hσ, Limits.comp_zero,
