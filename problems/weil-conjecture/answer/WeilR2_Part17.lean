  have hrange : Set.range (Uodd.ι ≫ Oh.ι ≫ Φ) = Set.range Ou.ι := by
    rw [Scheme.Opens.range_ι, hOu]
    ext z
    constructor
    · rintro ⟨y, rfl⟩
      have hy : Uodd.ι y ∈ Uodd := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
        exact ⟨y, rfl⟩
      obtain ⟨k, hk⟩ := (hU _).mp hy
      refine ⟨k, ?_⟩
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΦpt, Ideal.mem_comap]
      change σ _ ∉ _
      rw [hσ k]
      exact hk
    · rintro ⟨k, hk⟩
      obtain ⟨w, hwdef⟩ : ∃ w : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)),
          w = Spec.map (CommRingCat.ofHom (σ.symm : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
            wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) z := ⟨_, rfl⟩
      have hw : Φ w = z := by
        apply PrimeSpectrum.ext
        rw [hΦpt, hwdef, hSpecI]
        ext r
        rw [Ideal.mem_comap, Ideal.mem_comap]
        change σ.symm (σ r) ∈ _ ↔ _
        rw [RingEquiv.symm_apply_apply]
      have hbw : Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
            w.asIdeal := by
        rw [hwdef, hSpecI, Ideal.mem_comap]
        change σ.symm _ ∉ _
        rw [← hσ k, RingEquiv.symm_apply_apply]
        exact hk
      have hwOh : w ∈ Set.range Oh.ι := by
        rw [Scheme.Opens.range_ι, hOh]
        exact ⟨_, hbw⟩
      obtain ⟨w', hw'⟩ := hwOh
      have hw'U : w' ∈ Set.range Uodd.ι := by
        rw [Scheme.Opens.range_ι]
        exact (hU w').mpr ⟨k, by rw [hw']; exact hbw⟩
      obtain ⟨y, hy⟩ := hw'U
      exact ⟨y, by rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hy, hw', hw]⟩
  let φ : (Uodd : Scheme.{u}) ≅ (Ou : Scheme.{u}) :=
    IsOpenImmersion.isoOfRangeEq (Uodd.ι ≫ Oh.ι ≫ Φ) Ou.ι hrange
  obtain ⟨eq2⟩ := wc_et_coh_iso_invariance φ.hom ℓ (4 * e)
  have hU0 : Subsingleton (wcEtCoh (Uodd : Scheme.{u}) ℓ (4 * e)) := by
    haveI := hOu0
    exact eq2.symm.subsingleton

  haveI hN1 : TopologicalSpace.NoetherianSpace (Oh : Scheme.{u}) :=
    TopologicalSpace.NoetherianSpace.set
      (Oh : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT))))
  haveI hN2 : TopologicalSpace.NoetherianSpace (Uodd : Scheme.{u}) :=
    TopologicalSpace.NoetherianSpace.set (Uodd : Set (Oh : Scheme.{u}))
  haveI hUc : CompactSpace (Uodd : Scheme.{u}) := inferInstance
  haveI hUq : QuasiSeparatedSpace (Uodd : Scheme.{u}) := inferInstance
  haveI hoi : IsOpenImmersion (Uodd.ι ≫ Oh.ι) := inferInstance
