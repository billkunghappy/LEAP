      have h2 : F.map a ≫ c' = 0 := H.map_injective (by rw [h1, H.map_zero])
      have h3 : c' = 0 := H2 c' h2
      have e : c = β.hom.app B ≫ (β.inv.app B ≫ c ≫ β.hom.app B) ≫ β.inv.app B := by
        simp only [Category.assoc, Iso.hom_inv_id_app, Iso.hom_inv_id_app_assoc]
        exact (Category.comp_id c).symm
      rw [e, ← hc', h3, H.map_zero, Limits.zero_comp, Limits.comp_zero]

  have dvan : ∀ {C₁ C₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂] [Abelian C₁]
      [Abelian C₂] {_h1 : HasDerivedCategory.{u+2} C₁} {_h2 : HasDerivedCategory.{u+2} C₂}
      (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F]
      [Limits.PreservesFiniteColimits F] (X Y : C₁) (k : ℤ),
      (k < 0 ∨ (0 < k ∧ Projective (F.obj X))) →
      ∀ f : F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj X)) ⟶
        (F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj Y)))⟦k⟧,
        f = 0 := by
    intro C₁ C₂ _ _ _ _ _ _ F _ _ _ X Y k hk f
    let β := F.mapDerivedCategorySingleFunctor 0
    let H := DerivedCategory.singleFunctor C₂ 0
    have van : ∀ (X Y : C₂) (k : ℤ), (k < 0 ∨ (0 < k ∧ Projective X)) →
        ∀ f : H.obj X ⟶ (H.obj Y)⟦k⟧, f = 0 := by
      intro X Y k hk f
      let ε : (H.obj Y)⟦k⟧ ≅ DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₂ (-k)).obj Y) :=
        ((DerivedCategory.singleFunctors C₂).shiftIso k (-k) 0 (by omega)).app Y ≪≫
          (DerivedCategory.singleFunctorIsoCompQ C₂ (-k)).app Y
      suffices h : f ≫ ε.hom = 0 by
        rw [← cancel_mono ε.hom, h, Limits.zero_comp]
      rcases hk with hk | ⟨hk, hP⟩
      · have hsub := DerivedCategory.subsingleton_hom_of_isStrictlyLE_of_isStrictlyGE
          ((CochainComplex.singleFunctor C₂ 0).obj X)
          ((CochainComplex.singleFunctor C₂ (-k)).obj Y) 0 (-k) (by omega)
        exact @Subsingleton.elim _ hsub _ _
      · exact DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective (P := X) (i := 0) _
          (-k) (by omega)
    have h0 := van (F.obj X) (F.obj Y) k (by
        rcases hk with hk | ⟨hk, hP⟩
        · exact Or.inl hk
