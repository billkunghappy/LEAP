      obtain ⟨v', rfl⟩ := hlift v
      obtain ⟨w', rfl⟩ := hlift w
      have hind : ∀ c d : Sx ⟶ Sx,
          DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ v' +
            DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map d) ≫ b = 0 →
          c = 0 ∧ d = 0 := by
        intro c d hcd
        have hc : c = 0 := by
          by_contra hc
          haveI := h3 c hc
          apply hv
          have e1 : v' = inv (DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c)) ≫
              (-(DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map d) ≫ b)) := by
            have : DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ v' =
                -(DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map d) ≫ b) :=
              eq_neg_of_add_eq_zero_left hcd
            rw [← this, IsIso.inv_hom_id_assoc]
          rw [e1, Category.assoc, Preadditive.neg_comp, Category.assoc, hbE, Limits.comp_zero,
            neg_zero, Limits.comp_zero]
        subst hc
        refine ⟨rfl, ?_⟩
        by_contra hd
        haveI := h3 d hd
        apply hb0
        rw [Functor.map_zero, Functor.map_zero, Limits.zero_comp, zero_add] at hcd
        rw [← IsIso.inv_hom_id_assoc (DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map d))
          b, hcd, Limits.comp_zero]
      obtain ⟨c, d, hcd⟩ := h5 hN1 v' b w' hind
      exact ⟨c, by rw [hcd, Preadditive.add_comp, Category.assoc, Category.assoc, hbE,
        Limits.comp_zero, add_zero]⟩
    ·
      obtain ⟨v', rfl⟩ := hlift v
      obtain ⟨w', rfl⟩ := hlift w
      have hv' : v' ≠ 0 := by
        rintro rfl
        exact hv Limits.zero_comp
      obtain ⟨c, hc⟩ := h4 hN1 v' w' hv'
      exact ⟨c, by rw [hc, Category.assoc]⟩
  have key : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (N : ℕ) (One Sx : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (eΨ : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One ⟶ Ψ),
      1 ≤ N →
      Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(N : ℤ)⟧ ≅
          DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx)) →
      (∀ k : ℤ, 0 < k → ∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx))⟦k⟧, f = 0) →
      (∀ c : Sx ⟶ Sx, c ≠ 0 → IsIso c) →
      (N ≠ 1 → ∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj One))⟦(N : ℤ) + (N : ℤ)⟧,
        a ≠ 0 →
        ∃ c : Sx ⟶ Sx, w = DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ a) →
      (N = 1 → ∀ a b w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj One))⟦(N : ℤ) + (N : ℤ)⟧,
        (∀ c d : Sx ⟶ Sx,
          DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ a +
            DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map d) ≫ b = 0 →
          c = 0 ∧ d = 0) →
        ∃ c d : Sx ⟶ Sx,
          w = DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ a +
            DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map d) ≫ b) →
      (N = 1 → ∀ w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj Ψ)⟦(N : ℤ)⟧,
        w ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦(N : ℤ)⟧' = 0) →
      ∀ v w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj Ψ)⟦(N : ℤ) + (N : ℤ)⟧, v ≠ 0 →
        ∃ c : Sx ⟶ Sx, w = DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ v := by
    intro 𝒞 _ _ _ N One Sx Ψ eΨ hN hc h2 h3 h4 h5 h6
    exact abs N Sx (DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle eΨ))
