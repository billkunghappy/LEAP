    (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hk _ _ _ hP Dz hDz hepiz
  generalize (Abelian.Ext.mk₀ γ₁₂).comp (wcSuppPullExt Di Dk (2 * r) τ) (zero_add _) = t at ht hline ⊢
  obtain ⟨c, hc⟩ := hline t y ht
  refine ⟨c, hc, ?_⟩
  intro c' hc'
  obtain ⟨hC1, hCmul, hCadd⟩ := wc_hm_const_ring (Spec (V.left.presheaf.stalk z)) ℓ
  by_contra hne
  have hd : c' - c ≠ 0 := sub_ne_zero.mpr hne
  have hsplit : t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c'))
        (add_zero _) =
      t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c)) (add_zero _) +
      t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
        (add_zero _) := by
    rw [← Abelian.Ext.comp_add, ← Abelian.Ext.mk₀_add, ← hCadd, add_sub_cancel]
  rw [← hc', ← hc] at hsplit
  have hzero : t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
      (add_zero _) = 0 := by
    have h2 : y + t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
