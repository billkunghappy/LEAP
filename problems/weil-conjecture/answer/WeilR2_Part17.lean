        have h0 := h2 (N : ℤ) (by omega) (w ≫ T.mor₂⟦(N : ℤ) + (N : ℤ)⟧' ≫ α.hom ≫ β.hom)
        have : w ≫ T.mor₂⟦(N : ℤ) + (N : ℤ)⟧' =
            (w ≫ T.mor₂⟦(N : ℤ) + (N : ℤ)⟧' ≫ α.hom ≫ β.hom) ≫ β.inv ≫ α.inv := by simp
        rw [this, h0, Limits.zero_comp]
      obtain ⟨g, hg⟩ : ∃ g : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          T.obj₁⟦(N : ℤ) + (N : ℤ)⟧,
          w = g ≫ (((N : ℤ) + (N : ℤ)).negOnePow • T.mor₁⟦(N : ℤ) + (N : ℤ)⟧') :=
        Pretriangulated.Triangle.coyoneda_exact₂ _ hT' w (by
          change w ≫ (((N : ℤ) + (N : ℤ)).negOnePow • T.mor₂⟦(N : ℤ) + (N : ℤ)⟧') = 0
          rw [Units.smul_def, Preadditive.comp_zsmul, hf, zsmul_zero])
      refine ⟨((N : ℤ) + (N : ℤ)).negOnePow • g, ?_⟩
      rw [hg, Units.smul_def, Units.smul_def, Preadditive.comp_zsmul, Preadditive.zsmul_comp]
    by_cases hN1 : N = 1
    ·
      have hk : (N : ℤ) + 1 = (N : ℤ) + (N : ℤ) := by omega
      have hT'' := Pretriangulated.Triangle.shift_distinguished T hT (N : ℤ)
      obtain ⟨b, hbdef⟩ : ∃ b : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          T.obj₁⟦(N : ℤ) + (N : ℤ)⟧,
          b = σ.inv ≫ ((N : ℤ).negOnePow • (T.mor₃⟦(N : ℤ)⟧' ≫
            (shiftFunctorComm (DerivedCategory 𝒞) 1 (N : ℤ)).hom.app T.obj₁)) ≫
            (shiftFunctorAdd' (DerivedCategory 𝒞) (N : ℤ) 1 ((N : ℤ) + (N : ℤ)) hk).inv.app T.obj₁ :=
        ⟨_, rfl⟩
      have h31 : ((N : ℤ).negOnePow • (T.mor₃⟦(N : ℤ)⟧' ≫
            (shiftFunctorComm (DerivedCategory 𝒞) 1 (N : ℤ)).hom.app T.obj₁)) ≫
          (T.mor₁⟦(N : ℤ)⟧')⟦(1 : ℤ)⟧' = 0 := by
        have h0 := Pretriangulated.comp_distTriang_mor_zero₃₁ _ hT''
        change ((N : ℤ).negOnePow • (T.mor₃⟦(N : ℤ)⟧' ≫
            (shiftFunctorComm (DerivedCategory 𝒞) 1 (N : ℤ)).hom.app T.obj₁)) ≫
          (shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map ((N : ℤ).negOnePow • T.mor₁⟦(N : ℤ)⟧') = 0
          at h0
        rw [Units.smul_def ((N : ℤ).negOnePow) (T.mor₁⟦(N : ℤ)⟧'), Functor.map_zsmul,
          Preadditive.comp_zsmul] at h0
        exact hunit _ _ h0
      have hbE : b ≫ T.mor₁⟦(N : ℤ) + (N : ℤ)⟧' = 0 := by
        have hnat := (shiftFunctorAdd' (DerivedCategory 𝒞) (N : ℤ) 1 ((N : ℤ) + (N : ℤ)) hk).inv.naturality
          T.mor₁
        rw [Functor.comp_map] at hnat
        rw [hbdef, Category.assoc, Category.assoc, ← hnat, ← Category.assoc _ _
          ((shiftFunctorAdd' (DerivedCategory 𝒞) (N : ℤ) 1 ((N : ℤ) + (N : ℤ)) hk).inv.app T.obj₂),
          h31, Limits.zero_comp, Limits.comp_zero]
      have hb0 : b ≠ 0 := by
        intro hb
        have h1 : σ.inv ≫ ((N : ℤ).negOnePow • (T.mor₃⟦(N : ℤ)⟧' ≫
            (shiftFunctorComm (DerivedCategory 𝒞) 1 (N : ℤ)).hom.app T.obj₁)) = 0 := by
          have : σ.inv ≫ ((N : ℤ).negOnePow • (T.mor₃⟦(N : ℤ)⟧' ≫
              (shiftFunctorComm (DerivedCategory 𝒞) 1 (N : ℤ)).hom.app T.obj₁)) =
              b ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) (N : ℤ) 1 ((N : ℤ) + (N : ℤ)) hk).hom.app
                T.obj₁ := by
            rw [hbdef, Category.assoc, Category.assoc, Iso.inv_hom_id_app, Category.comp_id]
          rw [this, hb, Limits.zero_comp]
        obtain ⟨h, hh⟩ : ∃ h : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
            T.obj₂⟦(N : ℤ)⟧, σ.inv = h ≫ ((N : ℤ).negOnePow • T.mor₂⟦(N : ℤ)⟧') :=
          Pretriangulated.Triangle.coyoneda_exact₃ _ hT'' σ.inv h1
        rw [Units.smul_def, Preadditive.comp_zsmul, h6 hN1 h, zsmul_zero] at hh
