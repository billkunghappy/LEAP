  have htfΛ : ∀ (V' : (V.left.ProEt)ᵒᵖ) (m' : ℕ)
      (r' : ↑((wcIntRingSheaf V.left ℓ).obj.obj V')), m' ≠ 0 → m' • r' = 0 → r' = 0 := by
    intro V' m' r' hm hr
    have key : ∀ (T' : Type u) [TopologicalSpace T'] (s : C(T', ULift.{u+1} ℤ_[ℓ])),
        m' • s = 0 → s = 0 := by
      intro T' _ s hs
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      let g : C(T', ULift.{u+1} ℤ_[ℓ]) →+ ℤ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
        ((Pi.evalAddMonoidHom (fun _ : T' => ULift.{u+1} ℤ_[ℓ]) t).comp
          ContinuousMap.coeFnAddMonoidHom)
      have h1 : m' • g s = 0 :=
        ((map_nsmul g m' s).symm.trans (congrArg g hs)).trans (map_zero g)
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hm)
    exact key ↥((Opposite.unop V').left) r' hr
  obtain ⟨LAb, adjΛ, hLA, hLL, hLC⟩ :=
    sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
      (Scheme.ProEt.topology V.left) (wcIntRingSheaf V.left ℓ) htfΛ
  haveI := hLA
  haveI := hLL
  haveI := hLC
  have hK := fun V' f => wc_int_supp_kernel_sections_gen ℓ (Limits.pullback.fst V.hom i) DV hDV V' f
  have hcov := fun U' k W g hW =>
    wc_int_kernel_section_local_cover_qc (Limits.pullback.fst V.hom i) ℓ hqc (wcIntSuppπ DV) hK
      U' k W g hW
  obtain ⟨ε₀, h, hex⟩ :=
    wc_int_kernel_free_of_local_cover ℓ (Set.range (Limits.pullback.fst V.hom i)) (wcIntSuppπ DV)
      hK hcov LAb adjΛ (V.hom ⁻¹ᵁ U) hO
  haveI hm1 : Mono (wcFreeSheafMap V.left (MorphismProperty.Over.homMk (V.hom ⁻¹ᵁ U).ι
      (Category.comp_id _) trivial :
      Scheme.ProEt.mk (V.hom ⁻¹ᵁ U).ι ⟶ Scheme.ProEt.mk (𝟙 V.left))) :=
    wc_free_sheaf_map_mono V.left _ _ _ (show Mono (V.hom ⁻¹ᵁ U).ι by infer_instance)
  have hmono : Mono (LAb.map (wcFreeSheafMap V.left (MorphismProperty.Over.homMk (V.hom ⁻¹ᵁ U).ι
      (Category.comp_id _) trivial :
      Scheme.ProEt.mk (V.hom ⁻¹ᵁ U).ι ⟶ Scheme.ProEt.mk (𝟙 V.left))) ≫ ε₀.hom) :=
    inferInstance
  have hepiπ : Epi (wcIntSuppπ DV) := by
    unfold wcIntSuppπ
    infer_instance
  have hSC := ShortComplex.ShortExact.mk' hex hmono hepiπ
  haveI : CompactSpace (Scheme.ProEt.mk (V.hom ⁻¹ᵁ U).ι).left := hOc
  haveI : QuasiSeparatedSpace (Scheme.ProEt.mk (V.hom ⁻¹ᵁ U).ι).left :=
    QuasiSeparatedSpace.of_isOpenEmbedding (V.hom ⁻¹ᵁ U).ι.isOpenEmbedding
  haveI : CompactSpace (Scheme.ProEt.mk (𝟙 V.left)).left := (inferInstance : CompactSpace V.left)
  haveI : QuasiSeparatedSpace (Scheme.ProEt.mk (𝟙 V.left)).left :=
    (inferInstance : QuasiSeparatedSpace V.left)
  have hback : ∀ {M : SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)} {m' : ℕ}
      (z : Abelian.Ext (wcIntUnit V.left ℓ) M m'),
      (Abelian.Ext.mk₀ ε₀.inv).comp ((Abelian.Ext.mk₀ ε₀.hom).comp z (zero_add m')) (zero_add m') =
        z := by
    intro M m' z
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]
  have c₂ : ∀ w : Abelian.Ext (wcIntUnit V.left ℓ)
      ((SheafOfModules.restrictScalars (wcIntRatRingSheafMap V.left ℓ)).obj
        (SheafOfModules.unit (wcRingSheaf V.left ℓ))) (2 * r),
      ∃ (b : ℕ) (w₀ : Abelian.Ext (wcIntUnit V.left ℓ) (wcIntUnit V.left ℓ) (2 * r)),
        (ℓ ^ b : ℕ) • w = w₀.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap V.left ℓ)))
          (add_zero (2 * r)) := by
    intro w
    obtain ⟨b, w₀', hw⟩ := (wc_int_free_qcqs_unit_restrict_rational V.left
      (Scheme.ProEt.mk (𝟙 V.left)) ℓ LAb adjΛ (2 * r)).1
        ((Abelian.Ext.mk₀ ε₀.hom).comp w (zero_add (2 * r)))
    refine ⟨b, (Abelian.Ext.mk₀ ε₀.inv).comp w₀' (zero_add (2 * r)), ?_⟩
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, ← hw, ← preN, hback]
  have hcok := chase hSC (wcUnitRestrict (wcIntRatRingSheafMap V.left ℓ)) (2 * r) c₂
    (fun x hx => (wc_int_free_qcqs_unit_restrict_rational V.left
      (Scheme.ProEt.mk (V.hom ⁻¹ᵁ U).ι) ℓ LAb adjΛ (2 * r)).2 x hx)
    (fun q₀ _ w => (wc_int_free_qcqs_unit_restrict_rational V.left
      (Scheme.ProEt.mk (V.hom ⁻¹ᵁ U).ι) ℓ LAb adjΛ q₀).1 w)
  have hsurj : ∀ w' : Abelian.Ext (E.L.obj (wcIntSuppObj DV))
      (SheafOfModules.unit (wcRingSheaf V.left ℓ)) (2 * r),
      ∃ (N : ℕ) (x : Abelian.Ext (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r)),
        wcIntRatExt E (wcIntSuppObj DV) (2 * r) x = (ℓ ^ N : ℕ) • w' := by
    intro w'
    obtain ⟨N, x, hx⟩ := hcok ((Abelian.Ext.mk₀ (E.adj.unit.app (wcIntSuppObj DV))).comp
      (Abelian.Ext.mapExactFunctor
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)) w')
      (zero_add (2 * r)))
    refine ⟨N, x, hΦ.1 ?_⟩
    dsimp only
    rw [key, hmN, preN]
    exact hx

  haveI := hεi
  intro w
  obtain ⟨N, x, hx⟩ := hsurj ((Abelian.Ext.mk₀ (inv ε)).comp w (zero_add (2 * r)))
  refine ⟨N, x, ?_⟩
  have hrat : wcIntSuppRat DV E ε (2 * r) x = (ℓ ^ N : ℕ) • w := by
    have hunf : wcIntSuppRat DV E ε (2 * r) x = (Abelian.Ext.mk₀ ε).comp
        (wcIntRatExt E (wcIntSuppObj DV) (2 * r) x) (zero_add (2 * r)) := rfl
    have e1 : (Abelian.Ext.mk₀ ε).comp ((ℓ ^ N : ℕ) • (Abelian.Ext.mk₀ (inv ε)).comp w
        (zero_add (2 * r))) (zero_add (2 * r)) = (ℓ ^ N : ℕ) • (Abelian.Ext.mk₀ ε).comp
        ((Abelian.Ext.mk₀ (inv ε)).comp w (zero_add (2 * r))) (zero_add (2 * r)) :=
      map_nsmul ((Abelian.Ext.mk₀ ε).precomp _ (zero_add (2 * r))) _ _
    rw [hunf, hx, e1, ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  have hK0 : wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0 = 0 := by
    have h := (wc_hm_const_ring ((𝟭 Scheme).obj V.left) ℓ).2.2 0 0
    rw [add_zero] at h
    calc wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0 =
          (wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0 + wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0) -
            wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0 := (add_sub_cancel_right _ _).symm
      _ = wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0 - wcHMConst ((𝟭 Scheme).obj V.left) ℓ 0 := by
          rw [← h]
      _ = 0 := sub_self _
  have hns : ∀ k : ℕ, k • w =
      w.comp (Abelian.Ext.mk₀ (wcHMConst ((𝟭 Scheme).obj V.left) ℓ (k : ℚ_[ℓ]))) (add_zero _) := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, Nat.cast_zero, hK0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, (wc_hm_const_ring ((𝟭 Scheme).obj V.left) ℓ).2.2,
        Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, (wc_hm_const_ring ((𝟭 Scheme).obj V.left) ℓ).1,
        Abelian.Ext.comp_mk₀_id]
  rw [hrat, hns, Nat.cast_pow]

theorem wc_qcsep_wcontr_stalk_int_rat_injective (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (z : V.left) (hz : IsClosed ({z} : Set V.left))
    (hzr : z ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
    (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
      (Limits.pullback.fst V.hom i)) ℓ) (hDz : wcHMPullCanonical Dz)
    (hepiz : Epi (wcSuppUnitMap Dz))
    (E' : wcIntRatData (Spec (V.left.presheaf.stalk z)) ℓ)
    (hE' : E'.adj.homEquiv _ _ E'.μ.hom =
      wcUnitRestrict (wcIntRatRingSheafMap (Spec (V.left.presheaf.stalk z)) ℓ))
    (εR : wcSuppObj Dz ⟶ E'.L.obj (wcIntSuppObj Dz)) (hεi : IsIso εR)
    (hεR : wcSuppUnitMap Dz ≫ εR = E'.μ.inv ≫ E'.L.map (wcIntSuppπ Dz)) :
    ∀ w : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ))
        _ _ (HasExt.standard _) (wcIntSuppObj Dz)
        (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
      wcIntSuppRat Dz E' εR (2 * r) w = 0 → w = 0 :=
by
  classical
  intro w hw
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  haveI := hεi
  haveI : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
  haveI : HenselianLocalRing (V.left.presheaf.stalk z) := (h5 z hz).1
  haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := (h5 z hz).2

  have h0 : (Abelian.Ext.mk₀ εR).comp (wcIntRatExt E' (wcIntSuppObj Dz) (2 * r) w)
      (zero_add _) = 0 := hw
  have hX : wcIntRatExt E' (wcIntSuppObj Dz) (2 * r) w = 0 := by
    have h1 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (inv εR))
      (Abelian.Ext.mk₀ εR) (wcIntRatExt E' (wcIntSuppObj Dz) (2 * r) w) (zero_add (2 * r))
    rw [Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, h0] at h1
    rw [h1, Abelian.Ext.comp_zero]
  have hj := (wc_int_rat_ext_eq_zero_iff (Spec (V.left.presheaf.stalk z)) ℓ E' hE'
    (wcIntSuppObj Dz) (2 * r) w).mp hX

  have hP : IsPullback
      (Limits.pullback.snd (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i) ≫
        Limits.pullback.snd V.hom i)
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) i
      (V.left.fromSpecStalk z ≫ V.hom) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback _ _).flip
      (IsPullback.of_hasPullback _ _).flip

  have hcp : (V.left.fromSpecStalk z ≫ V.hom)
      (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) ∈ Set.range i := by
    obtain ⟨zt, hzt⟩ := hzr
    refine ⟨Limits.pullback.snd V.hom i zt, ?_⟩
    have h2 := Scheme.Hom.comp_apply (Limits.pullback.snd V.hom i) i zt
    rw [← Limits.pullback.condition, Scheme.Hom.comp_apply, hzt] at h2
    refine h2.symm.trans ?_
    refine (congrArg (fun x => V.hom x)
      (Scheme.fromSpecStalk_closedPoint (X := V.left) (x := z)).symm).trans ?_
    exact (Scheme.Hom.comp_apply (V.left.fromSpecStalk z) V.hom _).symm

  have hrangeT : Set.range
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) =
      (V.left.fromSpecStalk z ≫ V.hom) ⁻¹' Set.range i := by
    ext x
    simp only [Scheme.Pullback.range_fst, Set.mem_preimage, Scheme.Hom.comp_apply]

  have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
  have hWo : (((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U :
      (Spec (V.left.presheaf.stalk z)).Opens) : Set (Spec (V.left.presheaf.stalk z))) =
      (Set.range
        (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)))ᶜ := by
    rw [hrangeT, Scheme.Hom.coe_preimage, hU, Set.preimage_compl]
  have hPU := isPullback_morphismRestrict (V.left.fromSpecStalk z ≫ V.hom) U
  have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Spec (V.left.presheaf.stalk z)),
      ∃ (N : ℕ) (f : Fin N → Γ(W, ⊤)), ∀ x : ↥W,
        (p x ∉ Set.range
          (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) ↔
          ∃ a, x ∈ W.basicOpen (f a)) := by
    intro W _ p
    obtain ⟨N, f, hf⟩ :=
      wc_affine_complement_basicOpen_cover i W (p ≫ V.left.fromSpecStalk z ≫ V.hom)
    refine ⟨N, f, fun x => ?_⟩
    rw [← hf x, hrangeT, Set.mem_preimage]
    simp only [Scheme.Hom.comp_apply]
  haveI : QuasiCompact U.ι :=
    instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion (X := Y) (f := U.ι)
  haveI : QuasiCompact ((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U).ι :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hPU inferInstance
  have hOc : CompactSpace ↥((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U).toScheme :=
    QuasiCompact.compactSpace_of_compactSpace ((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U).ι
  obtain ⟨e, he⟩ := wc_int_supp_unit_restrict_ker_torsion_qc
    (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) hqc
    ((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U) hWo hOc ℓ Dz hDz (2 * r) w hj

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  have tf := wc_smooth_pair_qcsep_int_supp_local_torsion_free K pY n m r hmr i ℓ hℓ Di hDi
    (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) inferInstance hcp _ _ _ hP
    Dz hDz hepiz
  have claim : ∀ e : ℕ, ∀ y : Abelian.Ext (wcIntSuppObj Dz)
      (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
      (ℓ ^ e : ℕ) • y = 0 → y = 0 := by
    intro e
    induction e with
    | zero => intro y hy; simpa using hy
    | succ e ih =>
      intro y hy
      apply tf
      apply ih
      rw [← mul_nsmul', ← pow_succ]
      exact hy
  exact claim e w he

theorem wc_qcsep_wcontr_int_supp_tors_clopen_kill (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV)) (hr : 1 ≤ r)
    (x : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ (HasExt.standard _)
      (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r))
    (k : ℕ) (z₀ : V.left) (hz₀ : IsClosed ({z₀} : Set V.left))
    (hz₀r : z₀ ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
    (D₀ : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z₀)
      (Limits.pullback.fst V.hom i)) ℓ) (hD₀ : wcHMPullCanonical D₀)
    (hepi₀ : Epi (wcSuppUnitMap D₀))
    (DΛ₀ : wcIntPullData (V.left.fromSpecStalk z₀) ℓ) (hDΛ₀ : wcIntPullCanonical DΛ₀)
    (γΛ₀ : wcIntSuppObj D₀ ⟶ DΛ₀.Φ.obj (wcIntSuppObj DV))
    (hγΛ₀ : wcIntSuppπ D₀ ≫ γΛ₀ = DΛ₀.μ.inv ≫ DΛ₀.Φ.map (wcIntSuppπ DV))
    (h0 : letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _
      ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x) (zero_add _)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π
          ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)))) (add_zero _) = 0) :
    ∃ (C : Set V.left) (hC : IsClopen C), z₀ ∈ C ∧
      letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
      (x.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
          (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero _)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)))) (add_zero _) = 0 :=
by
  classical
  letI iV : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
  letI i0 : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _
  haveI := DΛ₀.additive
  haveI := DΛ₀.presLim
  haveI := DΛ₀.presColim
  haveI : IsAffine V.left := h1
  have hp : 1 + (2 * r - 1) = 2 * r := by omega

  have hnπ : ∀ (S : Scheme.{u}),
      (ℓ ^ k : ℕ) • Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) = 0 := by
    intro S
    rw [← Category.id_comp (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))),
      ← Preadditive.nsmul_comp, Limits.cokernel.condition]

  have hnu : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcIntPullData f ℓ),
      ∃ ν : D.Φ.obj (wcIntTors S ℓ k) ⟶ wcIntTors S' ℓ k,
        D.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ ν =
          D.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S' ℓ)) := by
    intro S S' f D
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hcok := Limits.CokernelCofork.mapIsColimit _
      (Limits.cokernelIsCokernel ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) D.Φ
    obtain ⟨ν, hν⟩ := Limits.CokernelCofork.IsColimit.desc' hcok
      (D.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S' ℓ))) (by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
          Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, hnπ,
          Limits.comp_zero])
    exact ⟨ν, hν⟩

  let SV : ShortComplex (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) :=
    ShortComplex.mk (Limits.kernel.ι (wcIntSuppπ DV)) (wcIntSuppπ DV) (Limits.kernel.condition _)
  have hSV : SV.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance inferInstance
  let S₀ : ShortComplex (SheafOfModules.{u+1}
      (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) :=
    ShortComplex.mk (Limits.kernel.ι (wcIntSuppπ D₀)) (wcIntSuppπ D₀) (Limits.kernel.condition _)
  have hS₀ : S₀.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance inferInstance
  have hSVΦ : (SV.map DΛ₀.Φ).ShortExact := hSV.map_of_exact DΛ₀.Φ

  have hcok := Limits.CokernelCofork.mapIsColimit _
    (Limits.cokernelIsCokernel ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))) DΛ₀.Φ
  obtain ⟨ν₀, hν₀⟩ := Limits.CokernelCofork.IsColimit.desc' hcok
    (DΛ₀.μ.hom ≫ Limits.cokernel.π
      ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ))) (by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.nsmul_comp, Category.id_comp,
        ← Preadditive.comp_nsmul, hnπ, Limits.comp_zero])
  have hν₀' : DΛ₀.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))) ≫ ν₀ =
      DΛ₀.μ.hom ≫ Limits.cokernel.π
        ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)) := hν₀

  have hker := Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcIntSuppπ DV)) DΛ₀.Φ
  obtain ⟨τ₀, hτ₀⟩ := Limits.KernelFork.IsLimit.lift' hker
    (Limits.kernel.ι (wcIntSuppπ D₀) ≫ DΛ₀.μ.inv) (by
      rw [Category.assoc, ← hγΛ₀, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp])
  have hτ₀' : τ₀ ≫ DΛ₀.Φ.map (Limits.kernel.ι (wcIntSuppπ DV)) =
      Limits.kernel.ι (wcIntSuppπ D₀) ≫ DΛ₀.μ.inv := hτ₀

  obtain ⟨ybar, hybar⟩ : ∃ y : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ iV
      (wcIntSuppObj DV) (wcIntTors V.left ℓ k) (2 * r),
      y = x.comp (Abelian.Ext.mk₀
        (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)))) (add_zero _) := ⟨_, rfl⟩
  have hy0 : (Abelian.Ext.mk₀ SV.g).comp ybar (zero_add _) = 0 :=
    (wc_wcontr_int_tors_unit_ext_vanish K pY ℓ hℓ V h1 h2 h3 h4 h5 k (2 * r)
      (by omega)).1 _
  obtain ⟨β, hβ⟩ := Abelian.Ext.contravariant_sequence_exact₃ hSV _ ybar hy0 hp

  have eA : (Abelian.Ext.mapExactFunctor DΛ₀.Φ x).comp (Abelian.Ext.mk₀
        (DΛ₀.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))) ≫ ν₀))
        (add_zero _) =
      (Abelian.Ext.mapExactFunctor DΛ₀.Φ ybar).comp (Abelian.Ext.mk₀ ν₀) (add_zero _) := by
    rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← Abelian.Ext.mapExactFunctor_mk₀ DΛ₀.Φ, ← Abelian.Ext.mapExactFunctor_comp, hybar]
  have hext : Abelian.Ext.mapExactFunctor DΛ₀.Φ ybar =
      hSVΦ.extClass.comp (Abelian.Ext.mapExactFunctor DΛ₀.Φ β) hp := by
    rw [← hβ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass]
  have hnat : hS₀.extClass.comp (Abelian.Ext.mk₀ τ₀) (add_zero 1) =
      (Abelian.Ext.mk₀ γΛ₀).comp hSVΦ.extClass (zero_add 1) :=
    hS₀.extClass_naturality hSVΦ (ShortComplex.homMk τ₀ DΛ₀.μ.inv γΛ₀ hτ₀' hγΛ₀.symm)
  have hkey : hS₀.extClass.comp ((Abelian.Ext.mk₀ τ₀).comp
        ((Abelian.Ext.mapExactFunctor DΛ₀.Φ β).comp (Abelian.Ext.mk₀ ν₀) (add_zero _))
        (zero_add _)) hp =
      ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x) (zero_add _)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π
          ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)))) (add_zero _) := by
    have e1 : ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x) (zero_add _)).comp
          (Abelian.Ext.mk₀ (Limits.cokernel.π
            ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)))) (add_zero _) =
        (Abelian.Ext.mk₀ γΛ₀).comp ((Abelian.Ext.mapExactFunctor DΛ₀.Φ ybar).comp
          (Abelian.Ext.mk₀ ν₀) (add_zero _)) (zero_add _) := by
      unfold wcIntSuppPullExt
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, ← hν₀', eA]
    have e2 : (Abelian.Ext.mapExactFunctor DΛ₀.Φ ybar).comp (Abelian.Ext.mk₀ ν₀) (add_zero _) =
        hSVΦ.extClass.comp ((Abelian.Ext.mapExactFunctor DΛ₀.Φ β).comp
          (Abelian.Ext.mk₀ ν₀) (add_zero _)) hp := by
      rw [hext, Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [e1, e2, ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ γΛ₀) hSVΦ.extClass
        ((Abelian.Ext.mapExactFunctor DΛ₀.Φ β).comp (Abelian.Ext.mk₀ ν₀) (add_zero _))
        (zero_add 1) hp (by omega), ← hnat,
      Abelian.Ext.comp_assoc hS₀.extClass (Abelian.Ext.mk₀ τ₀)
        ((Abelian.Ext.mapExactFunctor DΛ₀.Φ β).comp (Abelian.Ext.mk₀ ν₀) (add_zero _))
        (add_zero 1) (zero_add _) (by omega)]
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS₀ _
    ((Abelian.Ext.mk₀ τ₀).comp
        ((Abelian.Ext.mapExactFunctor DΛ₀.Φ β).comp (Abelian.Ext.mk₀ ν₀) (add_zero _))
        (zero_add _)) hp (hkey.trans h0)
  have hx₂0 : x₂ = 0 :=
    (wc_wcontr_int_tors_unit_ext_vanish K pY ℓ hℓ V h1 h2 h3 h4 h5 k (2 * r - 1)
      (by omega)).2 z₀ hz₀ x₂
  have hβ₀ : (Abelian.Ext.mk₀ τ₀).comp
      ((Abelian.Ext.mapExactFunctor DΛ₀.Φ β).comp (Abelian.Ext.mk₀ ν₀) (add_zero _))
      (zero_add _) = 0 := by
    rw [← hx₂, hx₂0, Abelian.Ext.comp_zero]

  obtain ⟨C, hC, hz₀C, hkill⟩ : ∃ (C : Set V.left) (hC : IsClopen C), z₀ ∈ C ∧
      ∀ χ : wcIntTors V.left ℓ k ⟶ wcIntTors V.left ℓ k,
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) ≫ χ =
          wcIntFun V.left ℓ (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap ≫
            Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) →
        β.comp (Abelian.Ext.mk₀ χ) (add_zero (2 * r - 1)) = 0 := by
    let O : V.left.Opens := ⟨(Set.range (Limits.pullback.fst V.hom i))ᶜ,
      (Limits.pullback.fst V.hom i).isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have hO : (O : Set V.left) = (Set.range (Limits.pullback.fst V.hom i))ᶜ := rfl
    have hOmem : ∀ x : O.toScheme, O.ι x ∈ (O : Set V.left) := by
      intro x
      rw [← Scheme.Opens.range_ι]
      exact ⟨x, rfl⟩
    obtain ⟨Do, hDo⟩ := wc_int_pull_data_exists O.ι ℓ
    letI iO : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O.toScheme ℓ)) := HasExt.standard _
    haveI := Do.additive
    haveI := Do.presLim
    haveI := Do.presColim
    have hzero := wc_int_supp_pull_off_zero DV hDV O.ι (fun x => hOmem x) Do hDo
    have hkerV := Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcIntSuppπ DV)) Do.Φ
    obtain ⟨ε, hε⟩ := Limits.KernelFork.IsLimit.lift' hkerV Do.μ.inv hzero
    have hε' : ε ≫ Do.Φ.map (Limits.kernel.ι (wcIntSuppπ DV)) = Do.μ.inv := hε
    obtain ⟨νo, hνo⟩ := hnu Do
    obtain ⟨Do', hDo'⟩ := wc_int_pull_data_exists
      (Limits.pullback.fst (V.left.fromSpecStalk z₀) O.ι) ℓ
    obtain ⟨DfO, hDfO⟩ := wc_int_pull_data_exists
      (Limits.pullback.snd (V.left.fromSpecStalk z₀) O.ι) ℓ
    obtain ⟨Dc, hDc⟩ := wc_int_pull_data_exists
      (Limits.pullback.snd (V.left.fromSpecStalk z₀) O.ι ≫ O.ι) ℓ
    letI iO' : HasExt (SheafOfModules.{u+1}
      (wcIntRingSheaf (Limits.pullback (V.left.fromSpecStalk z₀) O.ι) ℓ)) := HasExt.standard _
    haveI := Do'.additive
    haveI := Do'.presLim
    haveI := Do'.presColim
    haveI := DfO.additive
    haveI := DfO.presLim
    haveI := DfO.presColim
    have hsq : Limits.pullback.fst (V.left.fromSpecStalk z₀) O.ι ≫ V.left.fromSpecStalk z₀ =
        Limits.pullback.snd (V.left.fromSpecStalk z₀) O.ι ≫ O.ι := Limits.pullback.condition
    let θ₁ := (wc_int_pull_data_comp_Phi_iso (V.left.fromSpecStalk z₀)
      (Limits.pullback.fst (V.left.fromSpecStalk z₀) O.ι) _ hsq DΛ₀ hDΛ₀ Do' hDo' Dc hDc).some
    let θ₂ := (wc_int_pull_data_comp_Phi_iso O.ι
      (Limits.pullback.snd (V.left.fromSpecStalk z₀) O.ι) _ rfl Do hDo DfO hDfO Dc hDc).some
    let θ : DΛ₀.Φ ⋙ Do'.Φ ≅ Do.Φ ⋙ DfO.Φ := θ₁.symm ≪≫ θ₂
    have hdisj' : ∀ q : ↥(Limits.pullback (V.left.fromSpecStalk z₀) O.ι : Scheme.{u}),
        Limits.pullback.fst (V.left.fromSpecStalk z₀) O.ι q ∉
          Set.range (Limits.pullback.fst (V.left.fromSpecStalk z₀)
            (Limits.pullback.fst V.hom i)) := by
      rintro q ⟨y, hy⟩
      have e1 : V.left.fromSpecStalk z₀ (Limits.pullback.fst (V.left.fromSpecStalk z₀)
            (Limits.pullback.fst V.hom i) y) =
          Limits.pullback.fst V.hom i (Limits.pullback.snd (V.left.fromSpecStalk z₀)
            (Limits.pullback.fst V.hom i) y) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      have e2 : V.left.fromSpecStalk z₀ (Limits.pullback.fst (V.left.fromSpecStalk z₀) O.ι q) =
          O.ι (Limits.pullback.snd (V.left.fromSpecStalk z₀) O.ι q) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      have hmem := hOmem (Limits.pullback.snd (V.left.fromSpecStalk z₀) O.ι q)
      rw [← e2, ← hy, e1] at hmem
      exact hmem ⟨_, rfl⟩
    have hzero' := wc_int_supp_pull_off_zero D₀ hD₀
      (Limits.pullback.fst (V.left.fromSpecStalk z₀) O.ι) hdisj' Do' hDo'
    have hker₀ := Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcIntSuppπ D₀)) Do'.Φ
    obtain ⟨ε₀, hε₀⟩ := Limits.KernelFork.IsLimit.lift' hker₀ Do'.μ.inv hzero'
    have hε₀' : ε₀ ≫ Do'.Φ.map (Limits.kernel.ι (wcIntSuppπ D₀)) = Do'.μ.inv := hε₀
    obtain ⟨νo', hνo'⟩ := hnu Do'
    obtain ⟨νfO, hνfO⟩ := hnu DfO
    have hF0 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcIntPullData f ℓ)
        {A B : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)},
        letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
        letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) := HasExt.standard _
        haveI := D.additive; haveI := D.presLim; haveI := D.presColim
        Abelian.Ext.mapExactFunctor D.Φ (0 : Abelian.Ext A B (2 * r - 1)) = 0 := by
      intro S S' f D A B
      letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) := HasExt.standard _
      haveI := D.additive
      haveI := D.presLim
      haveI := D.presColim
      have h : Abelian.Ext.mapExactFunctor D.Φ ((0 : Abelian.Ext A B (2 * r - 1)) + 0) =
          Abelian.Ext.mapExactFunctor D.Φ (0 : Abelian.Ext A B (2 * r - 1)) +
            Abelian.Ext.mapExactFunctor D.Φ (0 : Abelian.Ext A B (2 * r - 1)) := by
        rw [Abelian.Ext.mapExactFunctor_add]
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
    have hK3 := wc_int_open_kernel_tors_transfer_natural Do Do' DΛ₀ DfO θ
      (Limits.kernel (wcIntSuppπ DV)) (Limits.kernel.ι (wcIntSuppπ DV))
      (Limits.kernel (wcIntSuppπ D₀)) (Limits.kernel.ι (wcIntSuppπ D₀))
      ε hε' ε₀ hε₀' τ₀ hτ₀' k (2 * r - 1) νo hνo νo' hνo' ν₀ hν₀' νfO hνfO β
    rw [hβ₀, hF0 Do', Abelian.Ext.zero_comp, Abelian.Ext.comp_zero] at hK3

    haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
    haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated pY
    let fV : V.left ⟶ Y := V.hom
    haveI : QuasiCompact fV := quasiCompact_of_compactSpace fV
    have hW : IsOpen (Set.range ⇑i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
    have hWc : IsCompact (Set.range ⇑i)ᶜ := TopologicalSpace.NoetherianSpace.isCompact _
    have hOc' : IsCompact (O : Set ↥V.left) := by
      rw [hO, Scheme.Pullback.range_fst, ← Set.preimage_compl]
      exact QuasiCompact.isCompact_preimage (f := fV) _ hW hWc
    haveI : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc'
    have hqc : QuasiCompact O.ι := quasiCompact_of_compactSpace O.ι
    have hqs : QuasiSeparated O.ι := inferInstance
    obtain ⟨C, hC, hz₀C, hkillO⟩ := wc_int_tors_wlocal_closed_point_continuity h1 h2 h3 O.ι
      hqc hqs ℓ k (2 * r - 1) z₀ hz₀ DfO hDfO νfO hνfO
      ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
        (Abelian.Ext.mk₀ νo) (add_zero (2 * r - 1))) (zero_add (2 * r - 1))) hK3.symm
    refine ⟨C, hC, hz₀C, ?_⟩
    intro χ hχ
    have hK5 := wc_int_open_transfer_fun_compat O.ι Do hDo ε k (2 * r - 1) νo hνo
      (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap χ hχ β
    have hinj := wc_int_open_kernel_tors_restrict_injective (Limits.pullback.fst V.hom i) DV hDV
      O hO Do hDo ε hε' k (2 * r - 1) νo hνo
    refine hinj ?_
    beta_reduce
    rw [hK5, hkillO, hF0 Do, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
  have hw : ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) ≫
      (wcIntFun V.left ℓ (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap ≫
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))) = 0 := by
    rw [Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, hnπ,
      Limits.comp_zero]
  let χb := Limits.cokernel.desc ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))
    (wcIntFun V.left ℓ (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap ≫
      Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))) hw
  have hχb : Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) ≫ χb =
      wcIntFun V.left ℓ (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap ≫
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) :=
    Limits.cokernel.π_desc _ _ _
  have hk0 : β.comp (Abelian.Ext.mk₀ χb) (add_zero _) = 0 := hkill χb hχb

  refine ⟨C, hC, hz₀C, ?_⟩
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hχb,
    ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, ← hybar, ← hβ,
    Abelian.Ext.comp_assoc_of_third_deg_zero, hk0, Abelian.Ext.comp_zero]

theorem wc_qcsep_wcontr_int_supp_stalk_divisible_near (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (x τ' : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ (HasExt.standard _)
      (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r)) (a : ℤ_[ℓ])
    (k : ℕ) (z₀ : V.left) (hz₀ : IsClosed ({z₀} : Set V.left))
    (hz₀r : z₀ ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
    (D₀ : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z₀)
      (Limits.pullback.fst V.hom i)) ℓ) (hD₀ : wcHMPullCanonical D₀)
    (hepi₀ : Epi (wcSuppUnitMap D₀))
    (DΛ₀ : wcIntPullData (V.left.fromSpecStalk z₀) ℓ) (hDΛ₀ : wcIntPullCanonical DΛ₀)
    (γΛ₀ : wcIntSuppObj D₀ ⟶ DΛ₀.Φ.obj (wcIntSuppObj DV))
    (hγΛ₀ : wcIntSuppπ D₀ ≫ γΛ₀ = DΛ₀.μ.inv ≫ DΛ₀.Φ.map (wcIntSuppπ DV))
    (w₀ : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ))
      _ _ (HasExt.standard _) (wcIntSuppObj D₀)
      (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ) (2 * r))
    (hx₀ : letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x) (zero_add _) =
        ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) τ') (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z₀)) ℓ
            (ContinuousMap.const _ (ULift.up a)))) (add_zero _) + (ℓ ^ k : ℕ) • w₀) :
    ∃ W : Set V.left, IsOpen W ∧ z₀ ∈ W ∧
      ∀ z : V.left, z ∈ W → IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (_ : Epi (wcSuppUnitMap Dz))
        (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ) (_ : wcIntPullCanonical DΛz)
        (γΛz : wcIntSuppObj Dz ⟶ DΛz.Φ.obj (wcIntSuppObj DV)),
        wcIntSuppπ Dz ≫ γΛz = DΛz.μ.inv ≫ DΛz.Φ.map (wcIntSuppπ DV) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∃ w : Abelian.Ext (wcIntSuppObj Dz) (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
