    haveI hΔq : QuasiCompact (Limits.pullback.diagonal U.hom) := inferInstance

    obtain ⟨m₁, hm₁⟩ : ∃ m₁, m₁ = Limits.pullback.fst π (Limits.pullback.diagonal U.hom) :=
