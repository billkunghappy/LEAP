    haveI := Limits.pullback.map_isIso β c
      (a'' ≫ Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) c δ (𝟙 _) (𝟙 _) eq₁ eq₂
    have E : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback
        (a'' ≫ Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) c) ℓ q ≃
