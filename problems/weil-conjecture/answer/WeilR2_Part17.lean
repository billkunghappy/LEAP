        (ContinuousMap.const _ (ULift.up a)))) (add_zero _) := ⟨_, rfl⟩
  have hdecomp : ∀ (z : V.left) (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ)
      (hDΛz : wcIntPullCanonical DΛz)
      {P' : SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)}
      (γ : P' ⟶ DΛz.Φ.obj (wcIntSuppObj DV)),
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) x) (zero_add _) =
        (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) x') (zero_add _) +
