        Functor.map_comp, Category.assoc]
      rw [Functor.commShiftIso_hom_naturality]
    have hfac : (fun f : X' ⟶ Y'⟦a⟧ => R.map f ≫ (R.commShiftIso a).hom.app Y') =
        H₂ ∘ (fun g : X ⟶ Y⟦a⟧ => R.map g ≫ (R.commShiftIso a).hom.app Y) ∘ H₁.symm := by
      funext f
      simp only [Function.comp_apply]
      rw [← hN, Equiv.apply_symm_apply]
    rw [hfac]
    exact H₂.bijective.comp (h.comp H₁.symm.bijective)

  intro M k
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
