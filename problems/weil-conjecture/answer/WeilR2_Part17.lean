      DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map ι) ≫ ht =
        ((DerivedCategory.singleFunctorIsoCompQ _ 0).inv.app X' ≫ y.hom ≫
          ((DerivedCategory.singleFunctorIsoCompQ _ 0).hom.app
            (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)))⟦
