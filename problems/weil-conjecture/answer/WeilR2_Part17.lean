    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (h2 : n = 2) :
    haveI := Dp.additive
    haveI := Di.additive
    haveI := Di.presLim
    haveI := Di.presColim
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let eK := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ))
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)) :=
      HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)) :=
      HasExt.standard _
    ∃ (X X' : SheafOfModules.{u+1} (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ))
      (ι : X' ⟶ X) (Vt : ((wcProEtPullback D.f).obj V).left.ProEt)
      (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ),
        (X ⟶ M) ≃ M.val.obj (Opposite.op Vt))
      (_ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ))
        (ψ : M ⟶ N) (g : X ⟶ M), ev N (g ≫ ψ) = (ψ.val.app (Opposite.op Vt)).hom (ev M g))
      (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B)
      (_ : IsSepClosed (IsLocalRing.ResidueField B)) (J : Ideal B) (_ : J ≠ ⊤)
      (_ : ((wcProEtBC (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom)
          (wcQmSp A))).obj Vt).left ≅ Spec (.of (B ⧸ J)))
      (y : Abelian.Ext X'
        (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)) (n - 1))
      (ht : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj X) ⟶
        (DerivedCategory.Q.obj ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj
