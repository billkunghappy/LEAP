        (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))
        (CommRingCat.ofHom (MvPolynomial.map (algebraMap R B₀))) := by
    intro R B₀ _ _ _ r
    refine (CommRingCat.isPushout_tensorProduct R B₀ (MvPolynomial (Fin r) R)).of_iso (Iso.refl _)
      (Iso.refl _) (Iso.refl _)
      (MvPolynomial.algebraTensorAlgEquiv R B₀).toRingEquiv.toCommRingCatIso ?_ ?_ ?_ ?_
    · simp
    · simp
    · ext x
      simp [Algebra.smul_def]
    · apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        simp [MvPolynomial.algebraTensorAlgEquiv_tmul, Algebra.smul_def]
      · intro x
        simp [MvPolynomial.algebraTensorAlgEquiv_tmul]

  have L1test : ∀ (A : Type u) [CommRing A] (r : ℕ) (π : A),
    ∃ g : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
      g ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) ∧
      (∀ (y : Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y →
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y →
        ∀ p : Fin 2, Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (g y)) ∧
      ∀ (B₀ : Type u) [CommRing B₀] (b : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        ∃ fst : Spec (.of (MvPolynomial (Fin r) B₀)) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
          IsPullback fst (Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) g b := by
    intro A _ r π
    classical
    have K1 : ∀ (m : ℕ) (h1 : 1 < m),
        (∑ p : Fin m, ∑ q : Fin m, MvPolynomial.C ((Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin m) A) = MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ := by
      intro m h1
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin m)]
      · rw [Finset.sum_eq_single (⟨1, h1⟩ : Fin m)]
        · simp
        · intro q _ hq
          have : q.val ≠ 1 := fun h => hq (Fin.ext h)
          simp [this]
        · intro h; exact absurd (Finset.mem_univ _) h
      · intro p _ hp
        have : p.val ≠ 0 := fun h => hp (Fin.ext h)
        apply Finset.sum_eq_zero
        intro q _
        simp [this]
      · intro h; exact absurd (Finset.mem_univ _) h
    have liftH : ∀ (m : ℕ) (h1 : 1 < m) (S : Type u) [CommRing S] [Algebra A S] (v : Fin m → S),
        v ⟨0, by omega⟩ * v ⟨1, h1⟩ = algebraMap A S π →
        ∀ x ∈ wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0), MvPolynomial.aeval v x = 0 := by
      intro m h1 S _ _ v hv x hx
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [K1 m h1, map_mul]
      simp [hv]
    have relH : ∀ (m : ℕ) (h1 : 1 < m),
        Ideal.Quotient.mk (wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨0, by omega⟩) *
        Ideal.Quotient.mk (wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨1, h1⟩) =
        algebraMap A (wcQuadModelRing A m π (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
      intro m h1
      have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ - MvPolynomial.C π :
          MvPolynomial (Fin m) A) ∈ wcQuadModelIdeal A m π (Matrix.of fun i j : Fin m =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
        rw [← K1 m h1]
        exact Ideal.subset_span (Set.mem_singleton _)
      have := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_mul, sub_eq_zero] at this
      rw [this, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]

    let Q2 := wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
    let I2 := wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
    let Qr := wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
    let Ir := wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)

    let ι : Q2 →ₐ[A] Qr :=
      Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (fun p : Fin 2 =>
        Ideal.Quotient.mk Ir (MvPolynomial.X (Fin.castLE (by omega) p))))
        (liftH 2 (by norm_num) _ _ (relH (r + 2) (by omega)))
    have hιX : ∀ p : Fin 2, ι (Ideal.Quotient.mk I2 (MvPolynomial.X p)) =
        Ideal.Quotient.mk Ir (MvPolynomial.X (Fin.castLE (by omega) p)) := by
      intro p
      rw [Ideal.Quotient.liftₐ_apply]
      erw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.aeval_X _ _

    let χ : Fin (r + 2) → MvPolynomial (Fin r) Q2 := fun j =>
      if h0 : j.val = 0 then MvPolynomial.C (Ideal.Quotient.mk I2 (MvPolynomial.X 0))
      else if h1 : j.val = 1 then MvPolynomial.C (Ideal.Quotient.mk I2 (MvPolynomial.X 1))
      else MvPolynomial.X ⟨j.val - 2, by omega⟩
    have hχ : χ ⟨0, by omega⟩ * χ ⟨1, by omega⟩ = algebraMap A (MvPolynomial (Fin r) Q2) π := by
      simp only [χ, dite_true, one_ne_zero, dite_false]
      rw [← map_mul, MvPolynomial.algebraMap_apply]
      congr 1
      exact relH 2 (by norm_num)
    let Φ : Qr →ₐ[A] MvPolynomial (Fin r) Q2 :=
      Ideal.Quotient.liftₐ _ (MvPolynomial.aeval χ) (liftH (r + 2) (by omega) _ χ hχ)
    have hΦX : ∀ j : Fin (r + 2), Φ (Ideal.Quotient.mk Ir (MvPolynomial.X j)) = χ j := by
      intro j
      rw [Ideal.Quotient.liftₐ_apply]
      erw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.aeval_X _ _
    let Ψ : MvPolynomial (Fin r) Q2 →+* Qr :=
      MvPolynomial.eval₂Hom (ι : Q2 →+* Qr) (fun k : Fin r =>
        Ideal.Quotient.mk Ir (MvPolynomial.X ⟨k.val + 2, by omega⟩))
    have hΦι : ∀ q : Q2, Φ (ι q) = MvPolynomial.C q := by
      intro q
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
      induction f using MvPolynomial.induction_on with
      | C a =>
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, AlgHom.commutes,
          AlgHom.commutes, MvPolynomial.algebraMap_apply]
      | add f g hf hg => rw [map_add, map_add, map_add, hf, hg, map_add]
      | mul_X f p hf =>
        rw [map_mul, map_mul, map_mul, hf, hιX, hΦX, map_mul]
        congr 1
        fin_cases p
        · exact dif_pos rfl
        · exact (dif_neg one_ne_zero).trans (dif_pos rfl)
    have hΦΨ : Φ.toRingHom.comp Ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro q
        simp only [RingHom.comp_apply, Ψ, MvPolynomial.eval₂Hom_C, RingHom.id_apply]
        exact hΦι q
      · intro k
        simp only [RingHom.comp_apply, Ψ, MvPolynomial.eval₂Hom_X', RingHom.id_apply]
        erw [hΦX]
        have h0 : k.val + 2 ≠ 0 := by omega
        have h1 : k.val + 2 ≠ 1 := by omega
        simp only [χ, h0, h1, dite_false]
        congr 1
    have hΨΦ : Ψ.comp Φ.toRingHom = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
        erw [AlgHom.commutes]
        rw [MvPolynomial.algebraMap_apply]
        simp only [Ψ, MvPolynomial.eval₂Hom_C]
        exact AlgHom.commutes ι a
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply]
        erw [hΦX]
        rcases j with ⟨_ | _ | k, hk⟩
        · show Ψ (MvPolynomial.C (Ideal.Quotient.mk I2 (MvPolynomial.X 0))) = _
          simp only [Ψ, MvPolynomial.eval₂Hom_C]
          exact hιX 0
        · show Ψ (MvPolynomial.C (Ideal.Quotient.mk I2 (MvPolynomial.X 1))) = _
          simp only [Ψ, MvPolynomial.eval₂Hom_C]
          exact hιX 1
        · have h0 : k + 2 ≠ 0 := by omega
          have h1 : k + 2 ≠ 1 := by omega
          simp only [χ, Fin.val_mk, h0, h1, dite_false]
          simp only [Ψ, MvPolynomial.eval₂Hom_X']
          rfl
    have hΨbij : Function.Bijective Ψ := by
      refine Function.bijective_iff_has_inverse.mpr ⟨Φ, fun x => ?_, fun x => ?_⟩
      · exact congrArg (fun h => h x) hΦΨ
      · exact congrArg (fun h => h x) hΨΦ
    have hιeq : (ι : Q2 →+* Qr) = Ψ.comp (algebraMap Q2 (MvPolynomial (Fin r) Q2)) := by
      refine RingHom.ext fun q => ?_
      show (ι : Q2 →+* Qr) q = Ψ (MvPolynomial.C q)
      simp only [Ψ, MvPolynomial.eval₂Hom_C]
    let ΨE : MvPolynomial (Fin r) Q2 ≃+* Qr := RingEquiv.ofBijective Ψ hΨbij
    let eΨ := @RingEquiv.toCommRingCatIso (MvPolynomial (Fin r) Q2) Qr _ _ ΨE
    have hgd : Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr)) =
        Spec.map eΨ.hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap Q2 (MvPolynomial (Fin r) Q2))) := by
      rw [← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro q
      show (ι : Q2 →+* Qr) q = Ψ (algebraMap Q2 (MvPolynomial (Fin r) Q2) q)
      exact RingHom.congr_fun hιeq q
    refine ⟨Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr)), ?_, ?_, ?_⟩
    · show Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A Q2)) = Spec.map (CommRingCat.ofHom (algebraMap A Qr))
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
    · intro y hx0 hx1 p
      rw [Spec.map_apply]
      change Ideal.Quotient.mk I2 (MvPolynomial.X p) ∈
        Ideal.comap (CommRingCat.Hom.hom (CommRingCat.ofHom (ι : Q2 →+* Qr))) (PrimeSpectrum.asIdeal y)
      rw [Ideal.mem_comap, CommRingCat.hom_ofHom]
      erw [hιX]
      fin_cases p
      · exact hx0
      · exact hx1
    · intro B₀ _ b
      letI : Algebra Q2 B₀ := (Spec.preimage b).hom.toAlgebra
      have hPB := (isPullback_SpecMap_of_isPushout _ _ _ _ (hPOgen Q2 B₀ r)).flip
      have hb : Spec.map (CommRingCat.ofHom (algebraMap Q2 B₀)) = b := by
        show Spec.map (CommRingCat.ofHom (Spec.preimage b).hom) = b
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      rw [hb] at hPB
      refine ⟨Spec.map (CommRingCat.ofHom (MvPolynomial.map (algebraMap Q2 B₀))) ≫
        (Scheme.Spec.mapIso eΨ.op).inv, ?_⟩
      refine hPB.of_iso (Iso.refl _) (Scheme.Spec.mapIso eΨ.op).symm (Iso.refl _)
        (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · show Spec.map (CommRingCat.ofHom (algebraMap Q2 (MvPolynomial (Fin r) Q2))) ≫ 𝟙 _ =
          Spec.map eΨ.inv ≫ Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr))
        rw [hgd, ← Category.assoc, ← Spec.map_comp, eΨ.hom_inv_id, Spec.map_id, Category.id_comp,
          Category.comp_id]
      · simp

  have L4atest : ∀ {Y Y' : Scheme.{u}} (f : Y' ⟶ Y) (y' : Y') (B₀ : Type u) [CommRing B₀] [IsLocalRing B₀] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y (f y'))) (Scheme.Etale.forget Y)) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Y), wcHalShData (f y') B₀ Λ₀ W₀ φ₀ a₀ → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y' y')) (Scheme.Etale.forget Y')) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y'), wcHalShData y' B Λ W' φ a → ∃ β : Spec (.of B) ⟶ Spec (.of B₀), β ≫ a₀ = a ≫ f ∧ β (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint B₀ := by
    intro Y Y' f y' B₀ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh₀ B _ _ Λ _ _ W' φ a hsh
    let K := Y.residueField (f y')
    let K' := Y'.residueField y'
    let ρ : K →+* K' := (f.residueFieldMap y').hom
    letI alg : Algebra K (AlgebraicClosure K') :=
      ((algebraMap K' (AlgebraicClosure K')).comp ρ).toAlgebra
    let j : AlgebraicClosure K →ₐ[K] AlgebraicClosure K' :=
      IsAlgClosed.lift (M := AlgebraicClosure K') (R := K) (S := AlgebraicClosure K)
    let ι : Spec (.of (AlgebraicClosure K')) ⟶ Spec (.of (AlgebraicClosure K)) :=
      Spec.map (CommRingCat.ofHom (j : AlgebraicClosure K →+* AlgebraicClosure K'))
    have hι : ι ≫ wcEtGeomPt Y (f y') = wcEtGeomPt Y' y' ≫ f := by
      have e1 : (j : AlgebraicClosure K →+* AlgebraicClosure K').comp (algebraMap K (AlgebraicClosure K)) =
          (algebraMap K' (AlgebraicClosure K')).comp ρ := j.comp_algebraMap
      show ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ Y.fromSpecResidueField (f y') =
        (Spec.map (CommRingCat.ofHom (algebraMap K' (AlgebraicClosure K'))) ≫ Y'.fromSpecResidueField y') ≫ f
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, e1, Category.assoc,
        ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
        ← Spec.map_comp]
      rfl
    have hsh₀' := hsh₀
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh₀'
    obtain ⟨e', he'⟩ := wc_shdata_normalized_residue y' B Λ W' φ a hsh
    obtain ⟨β, hβ₁, hβ₂⟩ := wc_shdata_comparison_map f (f y') y' ι hι B₀ Λ₀ W₀ φ₀ a₀ hsh₀ e he
      B Λ W' φ a hsh e' he'
    refine ⟨β, hβ₁, ?_⟩
    have h := congrArg (fun g => g (IsLocalRing.closedPoint (AlgebraicClosure K'))) hβ₂
    have hL := (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
      (congrArg β (hresG B (Spec.map (CommRingCat.ofHom e') (IsLocalRing.closedPoint (AlgebraicClosure K'))))))
    have hR := (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
      (hresG B₀ (Spec.map (CommRingCat.ofHom e) (ι (IsLocalRing.closedPoint (AlgebraicClosure K'))))))
    exact hL.symm.trans (h.trans hR)

  obtain ⟨g, hg, hgv, hchart⟩ := L1test A r π
  have hv := hgv y hx0 hx1
  have hv' : wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) (g y) = IsLocalRing.closedPoint A :=
    (Scheme.Hom.comp_apply g _ y).symm.trans (by rw [hg]; exact hy)

  obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, av, e₀, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (g y)
  have hshv : wcHalShData (g y) B₀ Λ₀ W₀ φ₀ av := ⟨hI, haff, hcomp, hφa, hlim, e₀, hint, heq⟩
  have hdet : IsUnit ((Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) +
      (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0).transpose).det := by
    rw [Matrix.det_fin_two]
    simp

  obtain ⟨β, hβ, hβloc⟩ := L4atest g y B₀ Λ₀ W₀ φ₀ av hshv B Λ W' φ a hsh
  have hWa := wc_shdata_weaklyEtale y B Λ W' φ a hsh
  have hWv := wc_shdata_weaklyEtale (g y) B₀ Λ₀ W₀ φ₀ av hshv
  have hℓ₀ : IsUnit ((ℓ : ℕ) : B₀) := by
    have := hℓ.map (Spec.preimage (av ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))).hom
    rwa [map_natCast] at this
  obtain ⟨fst', hpb⟩ := hchart B₀ av
  have hWfst : WeaklyEtale fst' := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb.flip hWv
  let w := hpb.lift a β hβ.symm
  have hw₁ : w ≫ fst' = a := hpb.lift_fst _ _ _
  have hw₂ : w ≫ Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀))) = β :=
    hpb.lift_snd _ _ _
  have hWw : WeaklyEtale w :=
    MorphismProperty.of_postcomp (W := @WeaklyEtale) (W' := @WeaklyEtale) w fst' hWfst
      (by rw [hw₁]; exact hWa)
  have hwpt : Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))
      (w (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint B₀ := by
    have := Scheme.Hom.comp_apply w (Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) (IsLocalRing.closedPoint B)
    rw [hw₂] at this
    exact this.symm.trans hβloc

  have hfibβ : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
      (c : Spec (.of C) ⟶ Spec (.of B₀)),
      Nat.card (wcEtCoh (Limits.pullback β c) ℓ 0) = ℓ ∧
        ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback β c) ℓ q) := by
    intro C _ _ _ c
    obtain ⟨B'', _, _, _, Λ'', _, _, W'', φ'', a'', e'', hI'', haff'', hcomp'', hφa'', hlim'', hint'', heq''⟩ :=
      wc_et_geom_strict_henselization (w (IsLocalRing.closedPoint B))
    have hsh'' : wcHalShData (w (IsLocalRing.closedPoint B)) B'' Λ'' W'' φ'' a'' :=
      ⟨hI'', haff'', hcomp'', hφa'', hlim'', e'', hint'', heq''⟩
    obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point (w (IsLocalRing.closedPoint B)) B w hWw rfl
    have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))
        (IsLocalRing.closedPoint (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin r) B₀))).residueField
          (w (IsLocalRing.closedPoint B))))) =
        IsLocalRing.closedPoint B :=
      (Scheme.Hom.comp_apply _ _ _).trans (hresG B _)
    have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ w =
        wcEtGeomPt (Spec (.of (MvPolynomial (Fin r) B₀))) (w (IsLocalRing.closedPoint B)) :=
      (Category.assoc _ _ _).trans hε
    obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point (w (IsLocalRing.closedPoint B)) B'' Λ'' W'' φ'' a''
