    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (k : X ⟶ M),
      ev N (k ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev M k))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (k k' : X ⟶ M),
      ev M (k + k') = ev M k + ev M k')
    (q : ℕ) (z : wcHM V.left ℓ q)
    (hz : ∀ DV : wcHMPullData (Limits.pullback.fst V.hom g) ℓ, wcHMPullCanonical DV →
      wcHMPull DV q z ≠ 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Dg.additive
    haveI := Dg.presLim
    haveI := Dg.presColim
    ∃ y : Abelian.Ext X (SheafOfModules.unit (wcRingSheaf S ℓ)) q,
      (Abelian.Ext.mapExactFunctor Dg.Φ y).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero q) ≠ 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback V.hom g) ℓ)) :=
    HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit S).obj V.right) ℓ)) :=
    HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  classical

  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists V.hom ℓ
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (Limits.pullback.fst V.hom g) ℓ
  obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists (Limits.pullback.snd V.hom g) ℓ
  obtain ⟨Dh, hDh⟩ := wc_hm_pull_data_exists (Limits.pullback.snd V.hom g ≫ g) ℓ
  haveI := DV.additive
  haveI := DV.presLim
  haveI := DV.presColim
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim

  obtain ⟨i₁⟩ := wc_hm_pull_data_comp_Phi_iso V.hom (Limits.pullback.fst V.hom g)
    (Limits.pullback.snd V.hom g ≫ g) Limits.pullback.condition DV hDV Dk hDk Dh hDh
  obtain ⟨i₂⟩ := wc_hm_pull_data_comp_Phi_iso g (Limits.pullback.snd V.hom g)
    (Limits.pullback.snd V.hom g ≫ g) rfl Dg hDg Dw hDw Dh hDh
  obtain ⟨σ, -⟩ : ∃ σ : DV.Φ ⋙ Dk.Φ ≅ Dg.Φ ⋙ Dw.Φ, σ = i₁.symm ≪≫ i₂ := ⟨_, rfl⟩

  haveI hσ' : (wcSliceToOver S V).IsContinuous (Scheme.ProEt.topology V.left)
      ((Scheme.ProEt.topology S).over V) := (wc_slice_over_sites_cont S V).1
  haveI hj : (wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology S) := by
    have h := Functor.isContinuous_comp (wcSliceToOver S V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology S)
    exact h
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  haveI : EnoughInjectives
      (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit S).obj V.right) ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso S ℓ V DV hDV
  obtain ⟨ε₀, hA1, -⟩ := wc_slice_res_free_corep S ℓ V X ev hnat
  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ DV.Φ.obj X,
      ε = ε₀ ≫ θ.inv.app X := ⟨_, rfl⟩
  have hhom : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun f : X ⟶ Y => ε ≫ DV.Φ.map f) := by
    intro Y
    have e1 : (fun f : X ⟶ Y => ε ≫ DV.Φ.map f) =
        (fun g' : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj Y =>
          g' ≫ θ.inv.app Y) ∘ (fun f : X ⟶ Y => ε₀ ≫ (wcSliceRes S ℓ V).map f) := by
      funext f
      simp only [Function.comp_apply, hε, Category.assoc, NatTrans.naturality]
    have hb2 : Function.Bijective
        (fun g' : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj Y =>
          g' ≫ θ.inv.app Y) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun g' => g' ≫ θ.hom.app Y, fun g' => ?_, fun g' => ?_⟩
      · simp only [Category.assoc, Iso.inv_hom_id_app, Iso.hom_inv_id_app, Category.comp_id]
      · simp only [Category.assoc, Iso.inv_hom_id_app, Iso.hom_inv_id_app, Category.comp_id]
    rw [e1]
    exact hb2.comp (hA1 Y)
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf V.left ℓ)) (DV.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have h1 := wc_slice_res_toSheaf_injective S ℓ V I hI
    have h2 := wc_ring_sheaf_unit_ext_vanish V.left ℓ ((wcSliceRes S ℓ V).obj I) h1 k
    have h3 : e.comp (Abelian.Ext.mk₀ (θ.hom.app I)) (add_zero _) = 0 := h2 _
    calc e = (e.comp (Abelian.Ext.mk₀ (θ.hom.app I)) (add_zero _)).comp
          (Abelian.Ext.mk₀ (θ.inv.app I)) (add_zero _) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
            Iso.hom_inv_id_app, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h3, Abelian.Ext.zero_comp]
  have hbij := ext_transfer_of_corep DV.Φ X (SheafOfModules.unit (wcRingSheaf V.left ℓ)) ε hhom
    hvan (SheafOfModules.unit (wcRingSheaf S ℓ)) q
  have hpost : Function.Bijective (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf V.left ℓ))
      (DV.Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ))) q =>
        x.comp (Abelian.Ext.mk₀ DV.μ.hom) (add_zero q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => z.comp (Abelian.Ext.mk₀ DV.μ.inv) (add_zero q), fun x => ?_, fun z => ?_⟩
    · show (x.comp (Abelian.Ext.mk₀ DV.μ.hom) (add_zero q)).comp (Abelian.Ext.mk₀ DV.μ.inv)
        (add_zero q) = x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · show (z.comp (Abelian.Ext.mk₀ DV.μ.inv) (add_zero q)).comp (Abelian.Ext.mk₀ DV.μ.hom)
        (add_zero q) = z
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  have hΘbij : Function.Bijective
      (fun β : Abelian.Ext X (SheafOfModules.unit (wcRingSheaf S ℓ)) q =>
        ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor DV.Φ β) (zero_add q)).comp
          (Abelian.Ext.mk₀ DV.μ.hom) (add_zero q)) := hpost.comp hbij
  obtain ⟨y, hy⟩ := hΘbij.2 z

  refine ⟨y, fun H => ?_⟩
  have h1 : Abelian.Ext.mapExactFunctor Dg.Φ y = 0 := by
    calc Abelian.Ext.mapExactFunctor Dg.Φ y
        = ((Abelian.Ext.mapExactFunctor Dg.Φ y).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero q)).comp
          (Abelian.Ext.mk₀ Dg.μ.inv) (add_zero q) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
            Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [H, Abelian.Ext.zero_comp]
  have h2 : Abelian.Ext.mapExactFunctor (Dg.Φ ⋙ Dw.Φ) y = 0 := by
    rw [Abelian.Ext.comp_mapExactFunctor, h1, Abelian.Ext.mapExactFunctor_zero]
  have h3 : Abelian.Ext.mapExactFunctor (DV.Φ ⋙ Dk.Φ) y = 0 := by
    have hn := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y σ.hom
    rw [h2, Abelian.Ext.comp_zero] at hn
    calc Abelian.Ext.mapExactFunctor (DV.Φ ⋙ Dk.Φ) y
        = ((Abelian.Ext.mapExactFunctor (DV.Φ ⋙ Dk.Φ) y).comp
            (Abelian.Ext.mk₀ (σ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))) (add_zero q)).comp
          (Abelian.Ext.mk₀ (σ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)))) (add_zero q) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
            Iso.hom_inv_id_app, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [hn, Abelian.Ext.zero_comp]
  have h4 : Abelian.Ext.mapExactFunctor Dk.Φ (Abelian.Ext.mapExactFunctor DV.Φ y) = 0 := by
    rw [← Abelian.Ext.comp_mapExactFunctor]
    exact h3
  apply hz Dk hDk
  rw [← hy]
  show (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ
      (((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor DV.Φ y) (zero_add q)).comp
        (Abelian.Ext.mk₀ DV.μ.hom) (add_zero q))).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero q))
      (zero_add q) = 0
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp, h4,
    Abelian.Ext.comp_zero, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]

theorem wc_proet_bc_open_restr_isIso {S S' : Scheme.{u}} (g : S' ⟶ S) (V : S.ProEt)
    (O : V.left.Opens)
    (hO : ∀ w : ↥(Limits.pullback V.hom g), Limits.pullback.fst V.hom g w ∈ O) :
    IsIso ((wcProEtBC g).map
      (MorphismProperty.Over.homMk O.ι rfl trivial : wcVRes S V O ⟶ V)) :=
by
  have hfst : Set.range (Limits.pullback.fst V.hom g) ⊆ Set.range O.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨w, rfl⟩
    exact hO w
  let l : Limits.pullback V.hom g ⟶ O.toScheme :=
    IsOpenImmersion.lift O.ι (Limits.pullback.fst V.hom g) hfst
  have hl : l ≫ O.ι = Limits.pullback.fst V.hom g := IsOpenImmersion.lift_fac _ _ _
  let m' : Limits.pullback V.hom g ⟶ Limits.pullback (O.ι ≫ V.hom) g :=
    Limits.pullback.lift l (Limits.pullback.snd V.hom g)
      (by rw [← Category.assoc, hl, Limits.pullback.condition])
  have hm1 : m' ≫ Limits.pullback.fst (O.ι ≫ V.hom) g = l := Limits.pullback.lift_fst _ _ _
  have hm2 : m' ≫ Limits.pullback.snd (O.ι ≫ V.hom) g = Limits.pullback.snd V.hom g :=
    Limits.pullback.lift_snd _ _ _
  let m : Limits.pullback (O.ι ≫ V.hom) g ⟶ Limits.pullback V.hom g :=
    Limits.pullback.lift (Limits.pullback.fst (O.ι ≫ V.hom) g ≫ O.ι)
      (Limits.pullback.snd (O.ι ≫ V.hom) g)
      (by rw [Category.assoc, Limits.pullback.condition])
  have E1 : m ≫ Limits.pullback.fst V.hom g = Limits.pullback.fst (O.ι ≫ V.hom) g ≫ O.ι :=
    Limits.pullback.lift_fst _ _ _
  have E2 : m ≫ Limits.pullback.snd V.hom g = Limits.pullback.snd (O.ι ≫ V.hom) g :=
    Limits.pullback.lift_snd _ _ _
  have s4 : m ≫ m' = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hm1, Category.id_comp]
      rw [← cancel_mono O.ι, Category.assoc, hl, E1]
    · rw [Category.assoc, hm2, Category.id_comp, E2]
  have s5 : m' ≫ m = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, E1, ← Category.assoc, hm1, hl, Category.id_comp]
    · rw [Category.assoc, E2, hm2, Category.id_comp]
  have hΦl : (((wcProEtBC g).map
      (MorphismProperty.Over.homMk O.ι rfl trivial : wcVRes S V O ⟶ V)).left :
        Limits.pullback (O.ι ≫ V.hom) g ⟶ Limits.pullback V.hom g) = m := by
    first
    | rfl
    | (unfold wcProEtBC; exact MorphismProperty.Over.pullback_map_left _ _ _ _)
    | (simp [wcProEtBC]; rfl)
  let inv : (wcProEtBC g).obj V ⟶ (wcProEtBC g).obj (wcVRes S V O) :=
    MorphismProperty.Over.homMk m' hm2 trivial
  refine ⟨⟨inv, ?_, ?_⟩⟩
  · apply MorphismProperty.Over.Hom.ext
    exact (congrArg (fun x => x ≫ m') hΦl).trans s4
  · apply MorphismProperty.Over.Hom.ext
    exact (congrArg (fun x => m' ≫ x) hΦl).trans s5

theorem wc_pmn_hc_coeff_field (F'' : Type u) [Field F''] [Finite F'']
    (s : Spec (.of F'') ⟶ (wcP1Over F'').left) (hs : s ≫ (wcP1Over F'').hom = 𝟙 _)
    (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = s (IsLocalRing.closedPoint F''))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') :
    ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (ι : K →+* A),
      Function.Bijective ((IsLocalRing.residue A).comp ι) ∧ ((ℓ : ℕ) : K) ≠ 0 :=
by
  classical
  obtain ⟨c, ψ, j, hj, hchart, hsec, -, hwe⟩ := wc_stpf_chart F'' s hs V A e hV

  have hpt : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint A) =
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) (IsLocalRing.closedPoint F'') := by
    haveI := hj
    apply j.isOpenEmbedding.isEmbedding.injective
    have h1 := congrArg (fun φ : Spec (.of A) ⟶ (wcP1Over F'').left =>
      φ (IsLocalRing.closedPoint A)) hchart
    have h2 := congrArg (fun φ : Spec (.of F'') ⟶ (wcP1Over F'').left =>
      φ (IsLocalRing.closedPoint F'')) hsec
    calc j ((Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint A))
        = (Spec.map (CommRingCat.ofHom ψ) ≫ j) (IsLocalRing.closedPoint A) :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = (e.inv ≫ V.hom) (IsLocalRing.closedPoint A) := h1.symm
      _ = V.hom (e.inv (IsLocalRing.closedPoint A)) := Scheme.Hom.comp_apply _ _ _
      _ = s (IsLocalRing.closedPoint F'') := hV
      _ = (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) ≫ j)
            (IsLocalRing.closedPoint F'') := h2.symm
      _ = j ((Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)))
            (IsLocalRing.closedPoint F'')) := Scheme.Hom.comp_apply _ _ _
  have hmem : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h3 := congrArg PrimeSpectrum.asIdeal hpt
    have hQ : Polynomial.X - Polynomial.C c ∈
        Ideal.comap (Polynomial.evalRingHom c) (IsLocalRing.maximalIdeal F'') := by
      rw [Ideal.mem_comap, Polynomial.coe_evalRingHom, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C, sub_self]
      exact Ideal.zero_mem _
    have hP : Polynomial.X - Polynomial.C c ∈
        Ideal.comap ψ (IsLocalRing.maximalIdeal A) := by
      have h4 : Ideal.comap ψ (IsLocalRing.maximalIdeal A) =
          Ideal.comap (Polynomial.evalRingHom c) (IsLocalRing.maximalIdeal F'') := h3
      rw [h4]
      exact hQ
    exact hP
  have hstar : IsLocalRing.residue A (ψ Polynomial.X) =
      IsLocalRing.residue A (ψ (Polynomial.C c)) := by
    rw [← sub_eq_zero, ← map_sub, ← map_sub]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr hmem

  let ι₀ : F'' →+* IsLocalRing.ResidueField A :=
    (IsLocalRing.residue A).comp (ψ.comp Polynomial.C)
  have hfac : (IsLocalRing.residue A).comp ψ = ι₀.comp (Polynomial.evalRingHom c) := by
    apply Polynomial.ringHom_ext
    · intro a
      simp [ι₀]
    · simp [ι₀, hstar]

  have halg : ∀ x : IsLocalRing.ResidueField A,
      ∃ f : Polynomial F'', f ≠ 0 ∧ f.eval₂ ι₀ x = 0 := by
    intro x
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective x
    letI : Algebra (Polynomial F'') A := ψ.toAlgebra
    obtain ⟨f, hf1, hf2⟩ := wc_weaklyEtale_point_algebraic (Polynomial F'') A
      (IsLocalRing.ResidueField A) hwe (IsLocalRing.residue A) b
    have hal : algebraMap (Polynomial F'') A = ψ := rfl
    rw [hal, hfac] at hf1 hf2
    refine ⟨f.map (Polynomial.evalRingHom c), ?_, ?_⟩
    · intro h0
      apply hf1
      rw [← Polynomial.map_map, h0, Polynomial.map_zero]
    · rw [Polynomial.eval₂_map]
      exact hf2

  have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
  have hcharF : ∀ r : ℕ, ((r : ℕ) : IsLocalRing.ResidueField A) = 0 → ringChar F'' ∣ r := by
    intro r hr
    have h0 : ((r : ℕ) : F'') = 0 := by
      apply ι₀.injective
      rw [map_natCast, map_zero]
      exact hr
    exact (ringChar.spec F'' r).mp h0
  have hchar : ∀ r : ℕ, r.Prime → (r : IsLocalRing.ResidueField A) = 0 → (r : A) = 0 := by
    intro r _ hr0
    have h3 : ((r : ℕ) : F'') = 0 := (ringChar.spec F'' r).mpr (hcharF r hr0)
    have h4 : ((r : ℕ) : A) = (ψ.comp Polynomial.C) ((r : ℕ) : F'') := (map_natCast _ r).symm
    rw [h4, h3, map_zero]
  obtain ⟨K, iK, hK, ⟨ι⟩⟩ := wc_shens_equal_char_alg_closed_subfield A hchar

  have hint : ((IsLocalRing.residue A).comp ι).IsIntegral := by
    intro x
    letI : Algebra F'' (IsLocalRing.ResidueField A) := ι₀.toAlgebra
    obtain ⟨f, hf0, hfx⟩ := halg x
    have hxa : IsAlgebraic F'' x := ⟨f, hf0, by rw [Polynomial.aeval_def]; exact hfx⟩
    have hx : IsIntegral F'' x := hxa.isIntegral
    haveI : FiniteDimensional F'' (IntermediateField.adjoin F'' {x}) :=
      IntermediateField.adjoin.finiteDimensional hx
    haveI : Finite (IntermediateField.adjoin F'' {x}) := Module.finite_of_finite F''
    letI := Fintype.ofFinite (IntermediateField.adjoin F'' {x})
    have hN : 1 < Fintype.card (IntermediateField.adjoin F'' {x}) := Fintype.one_lt_card
    have hxN : x ^ Fintype.card (IntermediateField.adjoin F'' {x}) = x := by
      have h1 := FiniteField.pow_card
        (⟨x, IntermediateField.mem_adjoin_simple_self F'' x⟩ : IntermediateField.adjoin F'' {x})
      have h2 := congrArg (fun z : IntermediateField.adjoin F'' {x} =>
        (z : IsLocalRing.ResidueField A)) h1
      simpa using h2
    refine ⟨Polynomial.X ^ Fintype.card (IntermediateField.adjoin F'' {x}) - Polynomial.X, ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      rw [Polynomial.degree_X]
      exact_mod_cast hN
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, hxN, sub_self]
  have hbij : Function.Bijective ((IsLocalRing.residue A).comp ι) :=
    IsAlgClosed.ringHom_bijective_of_isIntegral _ hint
  have hℓK : ((ℓ : ℕ) : K) ≠ 0 := by
    intro h
    have h1 : ((ℓ : ℕ) : IsLocalRing.ResidueField A) = 0 := by
      rw [← map_natCast ((IsLocalRing.residue A).comp ι) ℓ, h, map_zero]
    have h2 := hcharF ℓ h1
    have h3 : ringChar F'' = ℓ :=
      (Nat.Prime.eq_one_or_self_of_dvd (Fact.out : ℓ.Prime) _ h2).resolve_left hp.ne_one
    have h4 : ringChar F'' ∣ Nat.card F'' := by
      apply (ringChar.spec F'' _).mp
      letI := Fintype.ofFinite F''
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F''
    exact hℓ (h3 ▸ h4)
  exact ⟨K, iK, hK, ι, hbij, hℓK⟩

theorem wc_quadric_split_normal_form_alg_closed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (d : ℕ), Even d → ∀ (A : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) Ω), (A + A.transpose).det ≠ 0 → ∃ P : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) Ω, IsUnit P.det ∧ wcLdpQuad Ω (d + 1) (fun p q => (P.transpose * A * P) p q) = wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :=
by
  have t_s1 : ∀ (L : Type u) [Field L] (N : ℕ) (a b : Fin (N + 1) → Fin (N + 1) → L),
      (∀ p, a p p = b p p) → (∀ p q, a p q + a q p = b p q + b q p) →
      wcLdpQuad L N a = wcLdpQuad L N b := by
    intro L _ N a b hd hs
    apply Subtype.ext
    show (∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
      ∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (b p q) * (MvPolynomial.X p * MvPolynomial.X q)
    obtain ⟨F, hF⟩ : ∃ F : Fin (N + 1) → Fin (N + 1) → MvPolynomial (Fin (N + 1)) L,
        ∀ p q, F p q = MvPolynomial.C (a p q - b p q) * (MvPolynomial.X p * MvPolynomial.X q) :=
      ⟨_, fun _ _ => rfl⟩
    have key : ∑ x : Fin (N + 1) × Fin (N + 1), F x.1 x.2 = 0 := by
      refine Finset.sum_involution (fun x _ => (x.2, x.1)) ?_ ?_
        (fun _ _ => Finset.mem_univ _) (fun _ _ => rfl)
      · intro x _
        show F x.1 x.2 + F x.2 x.1 = 0
        rw [hF, hF, mul_comm (MvPolynomial.X x.2) (MvPolynomial.X x.1), ← add_mul, ← map_add]
        have h0 : a x.1 x.2 - b x.1 x.2 + (a x.2 x.1 - b x.2 x.1) = 0 := by
          linear_combination hs x.1 x.2
        rw [h0, map_zero, zero_mul]
      · intro x _ hx heq
        apply hx
        have h21 : x.2 = x.1 := congrArg Prod.fst heq
        rw [hF, h21, hd, sub_self, map_zero, zero_mul]
    have key2 : ∑ x : Fin (N + 1), ∑ y : Fin (N + 1), F x y = 0 :=
      (Fintype.sum_prod_type' F).symm.trans key
    rw [← sub_eq_zero]
    refine Eq.trans ?_ key2
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [hF, map_sub, sub_mul]
  have t_s2a : ∀ (K : Type u) [Field K] (n m : ℕ) (f : ℕ → Fin n → K), m + 2 ≤ n →
      ∃ u₁ u₂ : Fin n → K, (∀ p < m, f p ⬝ᵥ u₁ = 0) ∧ (∀ p < m, f p ⬝ᵥ u₂ = 0) ∧
        ∀ s t : K, s • u₁ + t • u₂ = 0 → s = 0 ∧ t = 0 := by
    intro K _ n m f hmn
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin n → K) →ₗ[K] (Fin m → K), ∀ u p, Φ u p = f p.val ⬝ᵥ u :=
      ⟨(Matrix.of (fun (p : Fin m) (i : Fin n) => f p.val i)).mulVecLin, fun _ _ => rfl⟩
    have hrank := LinearMap.finrank_range_add_finrank_ker Φ
    rw [Module.finrank_fin_fun] at hrank
    have hr : Module.finrank K (LinearMap.range Φ) ≤ m := by
      have := Submodule.finrank_le (LinearMap.range Φ)
      rwa [Module.finrank_fin_fun] at this
    have hk : 1 < Module.finrank K (LinearMap.ker Φ) := by omega
    obtain ⟨x, hx⟩ := Module.finrank_pos_iff_exists_ne_zero.mp
      (by omega : 0 < Module.finrank K (LinearMap.ker Φ))
    obtain ⟨y, hy⟩ := exists_linearIndependent_pair_of_one_lt_finrank hk hx
    refine ⟨(x : Fin n → K), (y : Fin n → K), ?_, ?_, ?_⟩
    · intro p hp
      have h0 : Φ x = 0 := x.2
      have := congrFun h0 ⟨p, hp⟩
      rw [hΦ] at this
      exact this
    · intro p hp
      have h0 : Φ y = 0 := y.2
      have := congrFun h0 ⟨p, hp⟩
      rw [hΦ] at this
      exact this
    · intro s t hst
      apply LinearIndependent.pair_iff.mp hy
      apply Subtype.ext
      simpa using hst
  have t_s2b : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ) (A : Matrix (Fin n) (Fin n) Ω)
      (u₁ u₂ : Fin n → Ω), ∃ s t : Ω, (s ≠ 0 ∨ t ≠ 0) ∧
        (s • u₁ + t • u₂) ⬝ᵥ (A.mulVec (s • u₁ + t • u₂)) = 0 := by
    intro Ω _ _ n A u₁ u₂
    have expand : ∀ s t : Ω, (s • u₁ + t • u₂) ⬝ᵥ (A.mulVec (s • u₁ + t • u₂)) =
        s ^ 2 * (u₁ ⬝ᵥ A.mulVec u₁) + s * t * (u₁ ⬝ᵥ A.mulVec u₂ + u₂ ⬝ᵥ A.mulVec u₁) +
          t ^ 2 * (u₂ ⬝ᵥ A.mulVec u₂) := by
      intro s t
      simp only [Matrix.mulVec_add, Matrix.mulVec_smul, dotProduct_add, add_dotProduct,
        dotProduct_smul, smul_dotProduct, smul_eq_mul]
      ring
    by_cases hα : u₁ ⬝ᵥ A.mulVec u₁ = 0
    · exact ⟨1, 0, Or.inl one_ne_zero, by rw [expand, hα]; ring⟩
    · obtain ⟨r, hr⟩ := IsAlgClosed.exists_root
        (Polynomial.C (u₁ ⬝ᵥ A.mulVec u₁) * Polynomial.X ^ 2 +
          Polynomial.C (u₁ ⬝ᵥ A.mulVec u₂ + u₂ ⬝ᵥ A.mulVec u₁) * Polynomial.X +
          Polynomial.C (u₂ ⬝ᵥ A.mulVec u₂))
        (by rw [Polynomial.degree_quadratic hα]; decide)
      refine ⟨r, 1, Or.inr one_ne_zero, ?_⟩
      rw [expand]
      simp only [Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X] at hr
      linear_combination hr
  have t_s3 : ∀ (K : Type u) [Field K] (n : ℕ) (A M : Matrix (Fin n) (Fin n) K),
      M = A + A.transpose → M.det ≠ 0 → ∀ (m : ℕ) (e : ℕ → Fin n → K), Even m →
      (∀ p < m, ∀ q < m, e p ⬝ᵥ M.mulVec (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
      ∀ v : Fin n → K, v ≠ 0 → v ⬝ᵥ A.mulVec v = 0 → (∀ p < m, e p ⬝ᵥ M.mulVec v = 0) →
      ∃ w : Fin n → K, w ⬝ᵥ A.mulVec w = 0 ∧ v ⬝ᵥ M.mulVec w = 1 ∧
        ∀ p < m, e p ⬝ᵥ M.mulVec w = 0 := by
    intro K _ n A M hMdef hA m e hm he v hv hQv hve
    have hMT : M.transpose = M := by
      rw [hMdef, Matrix.transpose_add, Matrix.transpose_transpose]; exact add_comm _ _
    have hB : ∀ x y : Fin n → K, x ⬝ᵥ M.mulVec y = y ⬝ᵥ M.mulVec x := by
      intro x y
      rw [Matrix.dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hMT]
    have hI3 : ∀ x y : Fin n → K, x ⬝ᵥ A.mulVec y + y ⬝ᵥ A.mulVec x = x ⬝ᵥ M.mulVec y := by
      intro x y
      rw [hMdef, Matrix.add_mulVec, dotProduct_add, Matrix.mulVec_transpose,
        Matrix.dotProduct_mulVec y A x, dotProduct_comm (Matrix.vecMul y A) x]
    have hMv : M.mulVec v ≠ 0 := by
      intro h
      exact hA (Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv, h⟩)
    obtain ⟨r, hr⟩ := Function.ne_iff.mp hMv
    have hr' : M.mulVec v r ≠ 0 := hr
    obtain ⟨y, hy⟩ : ∃ y : Fin n → K, y = Pi.single r (M.mulVec v r)⁻¹ := ⟨_, rfl⟩
    have hvy : v ⬝ᵥ M.mulVec y = 1 := by
      rw [hB, hy, single_dotProduct, inv_mul_cancel₀ hr']
    obtain ⟨π, hπdef⟩ : ∃ π : ℕ → ℕ, π = fun j => if j % 2 = 0 then j + 1 else j - 1 :=
      ⟨_, rfl⟩
    have hπ1 : ∀ q j, (q / 2 = j / 2 ∧ q ≠ j) ↔ j = π q := by
      intro q j
      rw [hπdef]
      dsimp only
      split_ifs <;> constructor <;> intro h <;> omega
    have hπ2 : ∀ q, π (π q) = q := by
      intro q
      rw [hπdef]
      dsimp only
      split_ifs <;> omega
    obtain ⟨t, ht⟩ := hm
    have hπ3 : ∀ q < m, π q < m := by
      intro q hq
      rw [hπdef]
      dsimp only
      split_ifs <;> omega
    obtain ⟨z, hz⟩ : ∃ z : Fin n → K,
        z = y - ∑ j ∈ Finset.range m, (e (π j) ⬝ᵥ M.mulVec y) • e j := ⟨_, rfl⟩
    have hBz : ∀ x : Fin n → K, x ⬝ᵥ M.mulVec z = x ⬝ᵥ M.mulVec y -
        ∑ j ∈ Finset.range m, (e (π j) ⬝ᵥ M.mulVec y) * (x ⬝ᵥ M.mulVec (e j)) := by
      intro x
      rw [hz, Matrix.mulVec_sub, dotProduct_sub, Matrix.mulVec_sum, dotProduct_sum]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Matrix.mulVec_smul, dotProduct_smul, smul_eq_mul]
    have hez : ∀ q < m, e q ⬝ᵥ M.mulVec z = 0 := by
      intro q hq
      rw [hBz, Finset.sum_eq_single (π q)]
      · rw [he q hq (π q) (hπ3 q hq), if_pos ((hπ1 q (π q)).mpr rfl), hπ2, mul_one, sub_self]
      · intro j hj hjne
        rw [he q hq j (Finset.mem_range.mp hj), if_neg (fun h => hjne ((hπ1 q j).mp h)),
          mul_zero]
      · intro hnot
        exact absurd (Finset.mem_range.mpr (hπ3 q hq)) hnot
    have hvz : v ⬝ᵥ M.mulVec z = 1 := by
      rw [hBz, hvy, Finset.sum_eq_zero, sub_zero]
      intro j hj
      rw [hB v (e j), hve j (Finset.mem_range.mp hj), mul_zero]
    have hvv : v ⬝ᵥ M.mulVec v = 0 := by
      rw [← hI3, hQv, add_zero]
    refine ⟨z - (z ⬝ᵥ A.mulVec z) • v, ?_, ?_, ?_⟩
    · have hzv : z ⬝ᵥ A.mulVec v + v ⬝ᵥ A.mulVec z = 1 := by
        rw [hI3, hB, hvz]
      simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, sub_dotProduct,
        dotProduct_smul, smul_dotProduct, smul_eq_mul]
      linear_combination (-(z ⬝ᵥ A.mulVec z)) * hzv + (z ⬝ᵥ A.mulVec z) ^ 2 * hQv
    · rw [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, dotProduct_smul, hvz, hvv,
        smul_zero, sub_zero]
    · intro p hp
      rw [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, dotProduct_smul, hez p hp,
        hve p hp, smul_zero, sub_zero]
  have t_s4 : ∀ (K : Type u) [Field K] (n : ℕ) (Q : (Fin n → K) → K)
      (B : (Fin n → K) → (Fin n → K) → K), (∀ x y, B x y = B y x) → (∀ x, B x x = 2 * Q x) →
      (∀ (m : ℕ) (e : ℕ → Fin n → K), Even m → m + 2 ≤ n → (∀ p < m, Q (e p) = 0) →
        (∀ p < m, ∀ q < m, B (e p) (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
        ∃ v w : Fin n → K, Q v = 0 ∧ Q w = 0 ∧ B v w = 1 ∧ (∀ p < m, B (e p) v = 0) ∧
          (∀ p < m, B (e p) w = 0)) →
      ∀ k : ℕ, 2 * k ≤ n → ∃ e : ℕ → Fin n → K, (∀ p < 2 * k, Q (e p) = 0) ∧
        ∀ p < 2 * k, ∀ q < 2 * k, B (e p) (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0 := by
    intro K _ n Q B hBs hBd step k
    induction k with
    | zero =>
      intro _
      exact ⟨fun _ => 0, fun p hp => absurd hp (by omega), fun p hp => absurd hp (by omega)⟩
    | succ k ih =>
      intro hk
      obtain ⟨e, hQ, hBe⟩ := ih (by omega)
      obtain ⟨v, w, hQv, hQw, hvw, hev, hew⟩ := step (2 * k) e ⟨k, by ring⟩ (by omega) hQ hBe
      obtain ⟨e', he'⟩ : ∃ e' : ℕ → Fin n → K,
          ∀ p, e' p = if p = 2 * k then v else if p = 2 * k + 1 then w else e p :=
        ⟨_, fun _ => rfl⟩
      have e1 : e' (2 * k) = v := by rw [he', if_pos rfl]
      have e2 : e' (2 * k + 1) = w := by
        rw [he', if_neg (show ¬ (2 * k + 1 = 2 * k) by omega), if_pos rfl]
      have e3 : ∀ p < 2 * k, e' p = e p := by
        intro p hp
        rw [he', if_neg (show ¬ (p = 2 * k) by omega), if_neg (show ¬ (p = 2 * k + 1) by omega)]
      refine ⟨e', ?_, ?_⟩
      · intro p hp
        rcases (show p < 2 * k ∨ p = 2 * k ∨ p = 2 * k + 1 by omega) with h | rfl | rfl
        · rw [e3 p h]; exact hQ p h
        · rw [e1]; exact hQv
        · rw [e2]; exact hQw
      · intro p hp q hq
        rcases (show p < 2 * k ∨ p = 2 * k ∨ p = 2 * k + 1 by omega) with h | rfl | rfl <;>
        rcases (show q < 2 * k ∨ q = 2 * k ∨ q = 2 * k + 1 by omega) with h' | rfl | rfl
        · rw [e3 p h, e3 q h']; exact hBe p h q h'
        · rw [e3 p h, e1, hev p h, if_neg]; omega
        · rw [e3 p h, e2, hew p h, if_neg]; omega
        · rw [e1, e3 q h', hBs, hev q h', if_neg]; omega
        · rw [e1, hBd, hQv, mul_zero, if_neg]; omega
        · rw [e1, e2, hvw, if_pos]; omega
        · rw [e2, e3 q h', hBs, hew q h', if_neg]; omega
        · rw [e2, e1, hBs, hvw, if_pos]; omega
        · rw [e2, hBd, hQw, mul_zero, if_neg]; omega
  have t_s6 : ∀ (K : Type u) [Field K] (n : ℕ) (M : Matrix (Fin n) (Fin n) K)
      (e : ℕ → Fin n → K), Even n →
      (∀ p < n, ∀ q < n, e p ⬝ᵥ M.mulVec (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
      IsUnit (Matrix.of fun (i : Fin n) (p : Fin n) => e p.val i).det := by
    intro K _ n M e hn he
    rw [isUnit_iff_ne_zero]
    intro hdet
    obtain ⟨c, hc, hPc⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    apply hc
    have hsum : (Matrix.of fun (i : Fin n) (p : Fin n) => e p.val i).mulVec c =
        ∑ p : Fin n, c p • e p.val := by
      ext i
      rw [Finset.sum_apply]
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.smul_apply, smul_eq_mul, mul_comm]
    rw [hsum] at hPc
    obtain ⟨t, ht⟩ := hn
    funext q
    obtain ⟨q', hq'n, hq'⟩ : ∃ q' : ℕ, q' < n ∧
        ∀ j : ℕ, (q' / 2 = j / 2 ∧ q' ≠ j) ↔ j = q.val := by
      refine ⟨if q.val % 2 = 0 then q.val + 1 else q.val - 1, ?_, ?_⟩
      · have := q.isLt
        split_ifs <;> omega
      · intro j
        have := q.isLt
        split_ifs <;> constructor <;> intro h <;> omega
    have h0 := congrArg (fun x => e q' ⬝ᵥ M.mulVec x) hPc
    simp only [Matrix.mulVec_sum, Matrix.mulVec_smul, dotProduct_sum, dotProduct_smul,
      Matrix.mulVec_zero, dotProduct_zero, smul_eq_mul] at h0
    rw [Finset.sum_eq_single q] at h0
    · rw [he q' hq'n q.val q.isLt, if_pos ((hq' q.val).mpr rfl), mul_one] at h0
      exact h0
    · intro p _ hpq
      rw [he q' hq'n p.val p.isLt, if_neg, mul_zero]
      intro h
      exact hpq (Fin.ext ((hq' p.val).mp h))
    · intro h
      exact absurd (Finset.mem_univ q) h
  intro Ω _ _ d hd A hA
  obtain ⟨M, hMdef⟩ : ∃ M, M = A + A.transpose := ⟨_, rfl⟩
  have hMT : M.transpose = M := by
    rw [hMdef, Matrix.transpose_add, Matrix.transpose_transpose]; exact add_comm _ _
  have hB : ∀ x y : Fin (d + 1 + 1) → Ω, x ⬝ᵥ M.mulVec y = y ⬝ᵥ M.mulVec x := by
    intro x y
    rw [Matrix.dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hMT]
  have hI3 : ∀ x y : Fin (d + 1 + 1) → Ω,
      x ⬝ᵥ A.mulVec y + y ⬝ᵥ A.mulVec x = x ⬝ᵥ M.mulVec y := by
    intro x y
    rw [hMdef, Matrix.add_mulVec, dotProduct_add, Matrix.mulVec_transpose,
      Matrix.dotProduct_mulVec y A x, dotProduct_comm (Matrix.vecMul y A) x]
  have hAM : M.det ≠ 0 := by rw [hMdef]; exact hA
  have step : ∀ (m : ℕ) (e : ℕ → Fin (d + 1 + 1) → Ω), Even m → m + 2 ≤ d + 1 + 1 →
      (∀ p < m, e p ⬝ᵥ A.mulVec (e p) = 0) →
      (∀ p < m, ∀ q < m, e p ⬝ᵥ M.mulVec (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
      ∃ v w : Fin (d + 1 + 1) → Ω, v ⬝ᵥ A.mulVec v = 0 ∧ w ⬝ᵥ A.mulVec w = 0 ∧
        v ⬝ᵥ M.mulVec w = 1 ∧ (∀ p < m, e p ⬝ᵥ M.mulVec v = 0) ∧
        (∀ p < m, e p ⬝ᵥ M.mulVec w = 0) := by
    intro m e hm hmn _ hBe
    obtain ⟨u₁, u₂, h1, h2, hind⟩ :=
      t_s2a Ω (d + 1 + 1) m (fun p => Matrix.vecMul (e p) M) hmn
    obtain ⟨s, s', hss, hQv⟩ := t_s2b Ω (d + 1 + 1) A u₁ u₂
    have hv0 : s • u₁ + s' • u₂ ≠ 0 := by
      intro h0
      obtain ⟨hs0, hs'0⟩ := hind s s' h0
      rcases hss with h | h
      · exact h hs0
      · exact h hs'0
    have hev : ∀ p < m, e p ⬝ᵥ M.mulVec (s • u₁ + s' • u₂) = 0 := by
      intro p hp
      have k1 : Matrix.vecMul (e p) M ⬝ᵥ u₁ = 0 := h1 p hp
      have k2 : Matrix.vecMul (e p) M ⬝ᵥ u₂ = 0 := h2 p hp
      rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, dotProduct_add,
        dotProduct_smul, dotProduct_smul, Matrix.dotProduct_mulVec, Matrix.dotProduct_mulVec,
        k1, k2, smul_zero, smul_zero, add_zero]
    obtain ⟨w, hQw, hvw, hew⟩ :=
      t_s3 Ω (d + 1 + 1) A M hMdef hAM m e hm hBe (s • u₁ + s' • u₂) hv0 hQv hev
    exact ⟨s • u₁ + s' • u₂, w, hQv, hQw, hvw, hev, hew⟩
  obtain ⟨t, ht⟩ := hd
  obtain ⟨e, hQe, hBe⟩ := t_s4 Ω (d + 1 + 1) (fun x => x ⬝ᵥ A.mulVec x)
    (fun x y => x ⬝ᵥ M.mulVec y) hB
    (fun x => by
      show x ⬝ᵥ M.mulVec x = 2 * (x ⬝ᵥ A.mulVec x)
      rw [← hI3, two_mul])
    step (t + 1) (by omega)
  have hPdet := t_s6 Ω (d + 1 + 1) M e ⟨t + 1, by omega⟩
    (fun p hp q hq => hBe p (by omega) q (by omega))
  have hent : ∀ p q : Fin (d + 1 + 1),
      ((Matrix.of fun (i : Fin (d + 1 + 1)) (p : Fin (d + 1 + 1)) => e p.val i).transpose * A *
        (Matrix.of fun (i : Fin (d + 1 + 1)) (p : Fin (d + 1 + 1)) => e p.val i)) p q =
      e p.val ⬝ᵥ A.mulVec (e q.val) := by
    intro p q
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Matrix.mulVec,
      dotProduct, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  refine ⟨_, hPdet, t_s1 Ω (d + 1) _ _ ?_ ?_⟩
  · intro p
    rw [hent, if_neg]
    · exact hQe p.val (by omega)
    · omega
  · intro p q
    rw [hent, hent, hI3]
    have hpq : e p.val ⬝ᵥ M.mulVec (e q.val) =
        if p.val / 2 = q.val / 2 ∧ p.val ≠ q.val then 1 else 0 :=
      hBe p.val (by omega) q.val (by omega)
    rw [hpq]
    split_ifs <;> first | (norm_num; done) | (exfalso; omega)

theorem wc_pmn_hc_hyperbolic_change (Ac : Type u) [CommRing Ac] [IsLocalRing Ac]
    [IsAlgClosed (IsLocalRing.ResidueField Ac)] (π : Ac)
    (hπ : IsLocalRing.maximalIdeal Ac = Ideal.span {π}) (m n : ℕ) (hnm : n = 2 * m) (hm : 1 ≤ m)
    (c : Matrix (Fin n) (Fin n) Ac) (hc : IsUnit (c + c.transpose).det) :
    ∃ (P : Matrix (Fin n) (Fin n) Ac) (D' : MvPolynomial (Fin n) Ac), IsUnit P.det ∧
      MvPolynomial.constantCoeff D' = 0 ∧
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D' :=
by

  have hexp : ∀ (R : Type u) [CommRing R] (c P : Matrix (Fin n) (Fin n) R),
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) R) =
        ∑ a, ∑ b, MvPolynomial.C ((P.transpose * c * P) a b) *
          (MvPolynomial.X a * MvPolynomial.X b) := by
    intro R _ c P
    have key : ∀ f : Fin n → Fin n → Fin n → Fin n → MvPolynomial (Fin n) R,
        (∑ p, ∑ q, ∑ a, ∑ b, f p q a b) = ∑ a, ∑ b, ∑ q, ∑ p, f p q b a := by
      intro f
      calc (∑ p, ∑ q, ∑ a, ∑ b, f p q a b) = ∑ p, ∑ a, ∑ b, ∑ q, f p q a b := by
            refine Finset.sum_congr rfl fun p _ => ?_
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => ?_
            exact Finset.sum_comm
        _ = ∑ a, ∑ b, ∑ q, ∑ p, f p q a b := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun b _ => ?_
            exact Finset.sum_comm
        _ = ∑ a, ∑ b, ∑ q, ∑ p, f p q b a := Finset.sum_comm
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul, Finset.mul_sum, map_sum,
      map_mul]
    refine (key _).trans (Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ =>
      Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun p _ => by ring)

  have hhyp : ∀ (R : Type u) [CommRing R],
      (∑ p : Fin n, ∑ q : Fin n,
        MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : R) else 0) *
          (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin n) R) =
        ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) := by
    intro R _
    have hp : ∀ p : Fin n, (∑ q : Fin n,
        MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : R) else 0) *
          (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin n) R) =
        ∑ j : Fin m, if p.val = 2 * j.val then MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) else 0 := by
      intro p
      by_cases he : p.val % 2 = 0
      · have hj : p.val / 2 < m := by omega
        have hq : p.val + 1 < n := by omega
        rw [Fintype.sum_eq_single (⟨p.val + 1, hq⟩ : Fin n),
          Fintype.sum_eq_single (⟨p.val / 2, hj⟩ : Fin m)]
        · have e1 : (if p.val % 2 = 0 ∧ (⟨p.val + 1, hq⟩ : Fin n).val = p.val + 1
              then (1 : R) else 0) = 1 := if_pos ⟨he, rfl⟩
          have e2 : p.val = 2 * (⟨p.val / 2, hj⟩ : Fin m).val := by simp only; omega
          rw [e1, if_pos e2, map_one, one_mul]
          congr 1 <;> congr 1 <;> exact Fin.ext (by simp only; omega)
        · intro j hj'
          rw [if_neg]
          intro h
          apply hj'
          exact Fin.ext (by simp only; omega)
        · intro q hq'
          rw [if_neg, map_zero, zero_mul]
          rintro ⟨_, h⟩
          exact hq' (Fin.ext h)
      · rw [Finset.sum_eq_zero, Finset.sum_eq_zero]
        · intro j _
          rw [if_neg]
          omega
        · intro q _
          rw [if_neg, map_zero, zero_mul]
          rintro ⟨h, _⟩
          exact he h
    rw [Finset.sum_congr rfl (fun p _ => hp p), Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Fintype.sum_eq_single (⟨2 * j.val, by omega⟩ : Fin n)]
    · exact if_pos rfl
    · intro x hx
      rw [if_neg]
      intro h
      exact hx (Fin.ext h)

  have hdiv : ∀ F : MvPolynomial (Fin n) Ac,
      MvPolynomial.map (IsLocalRing.residue Ac) F = 0 → MvPolynomial.constantCoeff F = 0 →
      ∃ D' : MvPolynomial (Fin n) Ac, MvPolynomial.constantCoeff D' = 0 ∧
        F = MvPolynomial.C π * D' := by
    classical
    intro F hF h0
    have hcoef : ∀ μ, ∃ e : Ac, F.coeff μ = π * e := by
      intro μ
      have h1 : IsLocalRing.residue Ac (F.coeff μ) = 0 := by
        have := MvPolynomial.ext_iff.mp hF μ
        rwa [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at this
      have h2 : F.coeff μ ∈ IsLocalRing.maximalIdeal Ac :=
        (IsLocalRing.residue_eq_zero_iff _).mp h1
      rw [hπ, Ideal.mem_span_singleton'] at h2
      obtain ⟨e, he⟩ := h2
      exact ⟨e, by rw [← he, mul_comm]⟩
    choose e he using hcoef
    refine ⟨∑ μ ∈ F.support, MvPolynomial.monomial μ (if μ = 0 then 0 else e μ), ?_, ?_⟩
    · rw [map_sum]
      apply Finset.sum_eq_zero
      intro μ _
      rw [MvPolynomial.constantCoeff_monomial]
      split_ifs <;> rfl
    · ext ν
      rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      rw [Finset.sum_ite_eq']
      split_ifs with h1 h2
      · subst h2
        rw [mul_zero, ← MvPolynomial.constantCoeff_eq, h0]
      · exact he ν
      · rw [mul_zero]
        exact MvPolynomial.notMem_support_iff.mp h1

  obtain ⟨d, hd⟩ : ∃ d, n = d + 1 + 1 := ⟨n - 2, by omega⟩
  subst hd
  have hEven : Even d := ⟨m - 1, by omega⟩

  have hdet : (c.map (IsLocalRing.residue Ac) +
      (c.map (IsLocalRing.residue Ac)).transpose).det ≠ 0 := by
    have e : c.map (IsLocalRing.residue Ac) + (c.map (IsLocalRing.residue Ac)).transpose =
        (c + c.transpose).map (IsLocalRing.residue Ac) := by
      ext i j
      simp [Matrix.map_apply]
    rw [e, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (hc.map (IsLocalRing.residue Ac)).ne_zero
  obtain ⟨Pb, hPb, hNF⟩ := wc_quadric_split_normal_form_alg_closed
    (IsLocalRing.ResidueField Ac) d hEven (c.map (IsLocalRing.residue Ac)) hdet
  have hNF' := congrArg Subtype.val hNF
  change (∑ p, ∑ q, MvPolynomial.C ((Pb.transpose * c.map (IsLocalRing.residue Ac) * Pb) p q) *
      (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (d + 1 + 1)) _) =
    ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
      MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : IsLocalRing.ResidueField Ac)
        else 0) * (MvPolynomial.X p * MvPolynomial.X q) at hNF'

  let P : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) Ac :=
    Matrix.of fun a b => Function.surjInv IsLocalRing.residue_surjective (Pb a b)
  have hPmap : P.map (IsLocalRing.residue Ac) = Pb := by
    ext a b
    simp only [P, Matrix.map_apply, Matrix.of_apply]
    exact Function.surjInv_eq IsLocalRing.residue_surjective (Pb a b)
  have hPunit : IsUnit P.det := by
    have h1 : IsLocalRing.residue Ac P.det = Pb.det := by
      rw [RingHom.map_det, RingHom.mapMatrix_apply, hPmap]
    have h2 : IsLocalRing.residue Ac P.det ≠ 0 := h1 ▸ hPb.ne_zero
    have h3 : P.det ∉ IsLocalRing.maximalIdeal Ac :=
      fun h => h2 ((IsLocalRing.residue_eq_zero_iff _).mpr h)
    exact IsLocalRing.notMem_maximalIdeal.mp h3

  set L : MvPolynomial (Fin (d + 1 + 1)) Ac := ∑ p, ∑ q, MvPolynomial.C (c p q) *
      (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
        (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) with hL
  set h : MvPolynomial (Fin (d + 1 + 1)) Ac := ∑ j : Fin m,
      MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (d + 1 + 1)) *
        MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin (d + 1 + 1)) with hh
  have hmapL : MvPolynomial.map (IsLocalRing.residue Ac) L =
      ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (d + 1 + 1)) *
        MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin (d + 1 + 1)) := by
    rw [← hhyp (IsLocalRing.ResidueField Ac), ← hNF', ← hexp, ← hPmap]
    simp only [hL, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, Matrix.map_apply]
  have hmaph : MvPolynomial.map (IsLocalRing.residue Ac) h =
      ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (d + 1 + 1)) *
        MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin (d + 1 + 1)) := by
    simp only [hh, map_sum, map_mul, MvPolynomial.map_X]
  have hmap0 : MvPolynomial.map (IsLocalRing.residue Ac) (L - h) = 0 := by
    rw [map_sub, hmapL, hmaph, sub_self]

  have hcc : MvPolynomial.constantCoeff (L - h) = 0 := by
    simp only [hL, hh, map_sub, map_sum, map_mul, MvPolynomial.constantCoeff_C,
      MvPolynomial.constantCoeff_X, mul_zero, Finset.sum_const_zero, sub_zero]

  obtain ⟨D', hD0, hD⟩ := hdiv (L - h) hmap0 hcc
  exact ⟨P, D', hPunit, hD0, by linear_combination hD⟩

theorem wc_pmn_hc_slice_weaklyEtale (Ac : Type u) [CommRing Ac] [IsLocalRing Ac] (π : Ac)
    (hπ : IsLocalRing.maximalIdeal Ac = Ideal.span {π})
    (K : Type u) [Field K] (ι : K →+* Ac)
    (hι : Function.Bijective ((IsLocalRing.residue Ac).comp ι))
    (m n : ℕ) (hnm : n = 2 * m) (c P : Matrix (Fin n) (Fin n) Ac) (hP : IsUnit P.det)
    (D' : MvPolynomial (Fin n) Ac) (hD0 : MvPolynomial.constantCoeff D' = 0)
    (hid : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (B₀ : Type u) [CommRing B₀] [IsLocalRing B₀]
    (β : wcQuadModelRing Ac n π c →+* B₀) (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (ht : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B₀) :
    ∃ (y : Fin m → B₀) (I : Ideal B₀), I ≠ ⊤ ∧
      β (algebraMap Ac (wcQuadModelRing Ac n π c) π) ∈ I ∧
      (∀ j, y j ∈ IsLocalRing.maximalIdeal B₀) ∧
      (∀ 𝔮 : Ideal B₀, 𝔮.IsPrime → (∀ j, y j ∈ 𝔮) →
        β (algebraMap Ac (wcQuadModelRing Ac n π c) π) ∈ 𝔮) ∧
      WeaklyEtale (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp
        (MvPolynomial.eval₂Hom ((β.comp (algebraMap Ac (wcQuadModelRing Ac n π c))).comp ι) y)))) :=
by
  classical

  have hmat : ∀ {R' : Type u} [CommRing R'] (ρ : Ac →+* R') (M N : Matrix (Fin n) (Fin n) Ac)
      (v : Fin n → R') (i : Fin n),
      ∑ d, ρ (M i d) * ∑ a, ρ (N d a) * v a = ∑ a, ρ ((M * N) i a) * v a := by
    intro R' _ ρ M N v i
    simp only [Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun d _ => ?_))
    rw [map_mul]; ring
  have hone : ∀ {R' : Type u} [CommRing R'] (ρ : Ac →+* R') (v : Fin n → R') (i : Fin n),
      ∑ a, ρ ((1 : Matrix (Fin n) (Fin n) Ac) i a) * v a = v i := by
    intro R' _ ρ v i
    rw [Finset.sum_eq_single i]
    · rw [Matrix.one_apply_eq, map_one, one_mul]
    · intro a _ ha
      rw [Matrix.one_apply_ne' ha, map_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ i) h
  have hPP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
  have hPP' : P⁻¹ * P = 1 := Matrix.nonsing_inv_mul P hP

  obtain ⟨S, hS⟩ : ∃ S : Fin n → wcQuadModelRing Ac n π c, ∀ i, S i =
      Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c)
        (∑ d, MvPolynomial.C (P⁻¹ i d) * MvPolynomial.X d) := ⟨_, fun _ => rfl⟩
  have hAlg : ∀ a : Ac, algebraMap Ac (wcQuadModelRing Ac n π c) a =
      Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.C a) := fun _ => rfl

  have hexp : ∀ b, Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.X b) =
      ∑ a, algebraMap Ac (wcQuadModelRing Ac n π c) (P b a) * S a := by
    intro b
    have h1 := hmat MvPolynomial.C P P⁻¹ MvPolynomial.X b
    rw [hPP, hone] at h1
    rw [← h1, map_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [map_mul, hS, hAlg]

  have hφlin : ∀ p, MvPolynomial.aeval S (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) =
      Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.X p) := by
    intro p
    rw [hexp p, map_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
  have hF : Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
      algebraMap Ac (wcQuadModelRing Ac n π c) π := by
    rw [hAlg, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hrel0 : algebraMap Ac (wcQuadModelRing Ac n π c) π * (1 - MvPolynomial.aeval S D') =
      ∑ j : Fin m, S ⟨2 * j.val, by omega⟩ * S ⟨2 * j.val + 1, by omega⟩ := by
    have h1 := congrArg (MvPolynomial.aeval S) hid
    have hL : MvPolynomial.aeval S (∑ p, ∑ q, MvPolynomial.C (c p q) *
        (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
        (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        algebraMap Ac (wcQuadModelRing Ac n π c) π := by
      rw [← hF]
      simp only [map_sum]
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
      simp only [map_mul]
      rw [hφlin, hφlin, MvPolynomial.aeval_C, hAlg]
    rw [hL] at h1
    simp only [map_add, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C] at h1
    linear_combination h1

  have hSm : ∀ a, β (S a) ∈ IsLocalRing.maximalIdeal B₀ := by
    intro a
    rw [hS]
    simp only [map_sum, map_mul]
    exact Ideal.sum_mem _ (fun d _ => Ideal.mul_mem_left _ _ (ht d))

  have hevalm : ∀ q : MvPolynomial (Fin n) Ac,
      β (MvPolynomial.aeval S q) -
        β (algebraMap Ac (wcQuadModelRing Ac n π c) (MvPolynomial.constantCoeff q)) ∈
        IsLocalRing.maximalIdeal B₀ := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have h := Ideal.add_mem _ hp hq
      convert h using 1
      simp only [map_add]
      ring
    | mul_X p i _ =>
      simp only [map_mul, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, mul_zero,
        map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hSm i)
  have hDm : β (MvPolynomial.aeval S D') ∈ IsLocalRing.maximalIdeal B₀ := by
    have h := hevalm D'
    rwa [hD0, map_zero, map_zero, sub_zero] at h
  obtain ⟨U, hUdef⟩ : ∃ U : wcQuadModelRing Ac n π c, U = 1 - MvPolynomial.aeval S D' :=
    ⟨_, rfl⟩
  have hU : IsUnit (β U) := by
    rw [hUdef, map_sub, map_one]
    exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
      ((IsLocalRing.mem_maximalIdeal _).mp hDm)
  have hrel : algebraMap Ac (wcQuadModelRing Ac n π c) π * U =
      ∑ j : Fin m, S ⟨2 * j.val, by omega⟩ * S ⟨2 * j.val + 1, by omega⟩ := by
    rw [hUdef]; exact hrel0

  obtain ⟨Ĩ, hĨ⟩ : ∃ Ĩ : Ideal (wcQuadModelRing Ac n π c),
      Ĩ = Ideal.span (Set.range fun j : Fin m => S ⟨2 * j.val, by omega⟩) := ⟨_, rfl⟩
  have hSĨ : ∀ j : Fin m, S ⟨2 * j.val, by omega⟩ ∈ Ĩ := by
    intro j
    rw [hĨ]
    exact Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal B₀, I = Ideal.map β Ĩ := ⟨_, rfl⟩
  have hgenI : ∀ j : Fin m, β (S ⟨2 * j.val, by omega⟩) ∈ I := by
    intro j
    rw [hIdef]
    exact Ideal.mem_map_of_mem β (hSĨ j)
  have hrelB : β (algebraMap Ac (wcQuadModelRing Ac n π c) π) * β U =
      ∑ j : Fin m, β (S ⟨2 * j.val, by omega⟩) * β (S ⟨2 * j.val + 1, by omega⟩) := by
    have h := congrArg β hrel
    simpa only [map_mul, map_sum] using h
  refine ⟨fun j => β (S ⟨2 * j.val + 1, by omega⟩), I, ?_, ?_, ?_, ?_, ?_⟩
  · intro hI
    have hle : I ≤ IsLocalRing.maximalIdeal B₀ := by
      rw [hIdef, Ideal.map_le_iff_le_comap, hĨ, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hSm _
    rw [hI] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B₀).ne_top (top_le_iff.mp hle)
  · rw [← Ideal.mul_unit_mem_iff_mem I hU, hrelB]
    exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ (hgenI j))
  · intro j
    exact hSm _
  · intro 𝔮 _ hy
    rw [← Ideal.mul_unit_mem_iff_mem 𝔮 hU, hrelB]
    exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hy j))
  · subst hIdef

    have hbc : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S) (J : Ideal R),
        WeaklyEtale (Spec.map (CommRingCat.ofHom f)) →
        WeaklyEtale (Spec.map (CommRingCat.ofHom
          (Ideal.quotientMap (J.map f) f Ideal.le_comap_map))) := by
      intro R S _ _ f J hf
      have hcomm : CommRingCat.ofHom f ≫ CommRingCat.ofHom (Ideal.Quotient.mk (J.map f)) =
          CommRingCat.ofHom (Ideal.Quotient.mk J) ≫
            CommRingCat.ofHom (Ideal.quotientMap (J.map f) f Ideal.le_comap_map) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, Ideal.quotientMap_comp_mk]
      have hpo : IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom (Ideal.Quotient.mk J))
          (CommRingCat.ofHom (Ideal.Quotient.mk (J.map f)))
          (CommRingCat.ofHom (Ideal.quotientMap (J.map f) f Ideal.le_comap_map)) := by
        refine IsPushout.of_isColimit' (CommSq.mk hcomm) ?_
        have hker : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom f)
            (CommRingCat.ofHom (Ideal.Quotient.mk J))), ∀ r : R,
            s.inl.hom (f r) = s.inr.hom (Ideal.Quotient.mk J r) := by
          intro s r
          have hc := congrArg (fun φ => CommRingCat.Hom.hom φ r) s.condition
          simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using hc
        have hH : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom f)
            (CommRingCat.ofHom (Ideal.Quotient.mk J))), ∀ a ∈ J.map f, s.inl.hom a = 0 := by
          intro s a ha
          have hle : J.map f ≤ RingHom.ker s.inl.hom := by
            rw [Ideal.map_le_iff_le_comap]
            intro r hr
            rw [Ideal.mem_comap, RingHom.mem_ker, hker s r,
              Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]
          exact hle ha
        refine Limits.PushoutCocone.IsColimit.mk _
          (fun s => CommRingCat.ofHom (Ideal.Quotient.lift (J.map f) s.inl.hom (hH s)))
          (fun s => ?_) (fun s => ?_) (fun s m h1 _ => ?_)
        · apply CommRingCat.hom_ext
          rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
          exact Ideal.Quotient.lift_comp_mk _ _ _
        · apply CommRingCat.hom_ext
          rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
          apply Ideal.Quotient.ringHom_ext
          refine RingHom.ext (fun r => ?_)
          rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, Ideal.quotientMap_mk,
            Ideal.Quotient.lift_mk]
          exact hker s r
        · apply CommRingCat.hom_ext
          rw [CommRingCat.hom_ofHom]
          apply Ideal.Quotient.ringHom_ext
          have h2 := congrArg CommRingCat.Hom.hom h1
          rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h2
          rw [h2, Ideal.Quotient.lift_comp_mk]
      exact MorphismProperty.of_isPullback (P := @WeaklyEtale)
        (isPullback_SpecMap_of_isPushout _ _ _ _ hpo) hf
    obtain ⟨ψbar, hψbardef⟩ : ∃ ψbar : wcQuadModelRing Ac n π c ⧸ Ĩ →+* B₀ ⧸ Ideal.map β Ĩ,
        ψbar = Ideal.quotientMap (Ideal.map β Ĩ) β Ideal.le_comap_map := ⟨_, rfl⟩
    have hψbar : WeaklyEtale (Spec.map (CommRingCat.ofHom (R := wcQuadModelRing Ac n π c ⧸ Ĩ)
        (S := B₀ ⧸ Ideal.map β Ĩ) ψbar)) := by
      rw [hψbardef]; exact hbc _ _ β Ĩ hβ
    have hψbarmk : ∀ q, ψbar (Ideal.Quotient.mk Ĩ q) = Ideal.Quotient.mk (Ideal.map β Ĩ) (β q) := by
      intro q; rw [hψbardef, Ideal.quotientMap_mk]

    have hloc : ∀ (R : Type u) [CommRing R] (x : R), ∃ (L : Type u) (_ : CommRing L)
        (loc : R →+* L), IsUnit (loc x) ∧ IsOpenImmersion (Spec.map (CommRingCat.ofHom loc)) ∧
        (∀ (T : Type u) [CommRing T] (g : R →+* T), IsUnit (g x) →
          ∃ g' : L →+* T, g'.comp loc = g) ∧
        (∀ (T : Type u) [CommRing T] (g₁ g₂ : L →+* T), g₁.comp loc = g₂.comp loc → g₁ = g₂) := by
      intro R _ x
      exact ⟨Localization.Away x, inferInstance, algebraMap R (Localization.Away x),
        IsLocalization.Away.algebraMap_isUnit x, IsOpenImmersion.of_isLocalization x,
        fun T _ g hg => ⟨IsLocalization.Away.lift x hg, IsLocalization.Away.lift_comp x hg⟩,
        fun T _ g₁ g₂ h => IsLocalization.ringHom_ext (Submonoid.powers x) h⟩
    obtain ⟨Ub, hUb⟩ : ∃ Ub : wcQuadModelRing Ac n π c ⧸ Ĩ, Ub = Ideal.Quotient.mk Ĩ U :=
      ⟨_, rfl⟩
    have hψU : IsUnit (ψbar Ub) := by
      rw [hUb, hψbarmk]
      exact hU.map _
    obtain ⟨Lu, _, locU, hlocUunit, hlocu, hliftU, hextU⟩ :=
      hloc (wcQuadModelRing Ac n π c ⧸ Ĩ) Ub
    haveI := hlocu
    obtain ⟨ψu, hψucomp⟩ := hliftU _ ψbar hψU
    have hψuWE : WeaklyEtale (Spec.map (CommRingCat.ofHom ψu)) := by
      haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom ψu) ≫
          Spec.map (CommRingCat.ofHom locU)) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψucomp]
        exact hψbar
      exact WeaklyEtale.of_comp _ (Spec.map (CommRingCat.ofHom locU))

    obtain ⟨θ, hθ⟩ : ∃ θ : wcQuadModelRing Ac n π c →+* Lu,
        θ = locU.comp (Ideal.Quotient.mk Ĩ) := ⟨_, rfl⟩
    have hθa : ∀ q, θ q = locU (Ideal.Quotient.mk Ĩ q) := by
      intro q; rw [hθ, RingHom.comp_apply]
    have hθev : ∀ j : Fin m, θ (S ⟨2 * j.val, by omega⟩) = 0 := by
      intro j
      rw [hθa, Ideal.Quotient.eq_zero_iff_mem.mpr (hSĨ j), map_zero]
    have hθU : IsUnit (θ U) := by
      rw [hθa, ← hUb]; exact hlocUunit
    have hθπ : θ (algebraMap Ac (wcQuadModelRing Ac n π c) π) = 0 := by
      have h := congrArg θ hrel
      simp only [map_mul, map_sum, hθev, zero_mul, Finset.sum_const_zero] at h
      exact (IsUnit.mul_left_eq_zero hθU).mp h

    obtain ⟨κ, hκι, hκres⟩ : ∃ κ : Ac →+* K, (∀ k, κ (ι k) = k) ∧
        ∀ a, IsLocalRing.residue Ac (ι (κ a)) = IsLocalRing.residue Ac a := by
      let e := RingEquiv.ofBijective ((IsLocalRing.residue Ac).comp ι) hι
      refine ⟨e.symm.toRingHom.comp (IsLocalRing.residue Ac), fun k => ?_, fun a => ?_⟩
      · exact e.symm_apply_apply k
      · exact e.apply_symm_apply (IsLocalRing.residue Ac a)
    have hres0 : IsLocalRing.residue Ac π = 0 :=
      (IsLocalRing.residue_eq_zero_iff π).mpr (by rw [hπ]; exact Ideal.mem_span_singleton_self π)
    have hκπ : κ π = 0 := by
      apply hι.1
      simp only [RingHom.comp_apply, hκres, hres0, map_zero]
    have hdec : ∀ a, ∃ r, a - ι (κ a) = r * π := by
      intro a
      have h : a - ι (κ a) ∈ IsLocalRing.maximalIdeal Ac := by
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hκres, sub_self]
      rw [hπ, Ideal.mem_span_singleton'] at h
      obtain ⟨r, hr⟩ := h
      exact ⟨r, hr.symm⟩
    have hθκ : ∀ a, θ (algebraMap Ac (wcQuadModelRing Ac n π c) (ι (κ a))) =
        θ (algebraMap Ac (wcQuadModelRing Ac n π c) a) := by
      intro a
      obtain ⟨r, hr⟩ := hdec a
      have h : θ (algebraMap Ac (wcQuadModelRing Ac n π c) a) -
          θ (algebraMap Ac (wcQuadModelRing Ac n π c) (ι (κ a))) = 0 := by
        rw [← map_sub, ← map_sub, hr, map_mul, map_mul, hθπ, mul_zero]
      exact (sub_eq_zero.mp h).symm

    obtain ⟨z, hz⟩ : ∃ z : Fin n → MvPolynomial (Fin m) K, ∀ i, z i =
        if h : i.val % 2 = 1 then MvPolynomial.X (⟨i.val / 2, by omega⟩ : Fin m) else 0 :=
      ⟨_, fun _ => rfl⟩
    have hzev : ∀ j : Fin m, z ⟨2 * j.val, by omega⟩ = 0 := by
      intro j
      rw [hz]
      split_ifs with h
      · exfalso
        change (2 * j.val) % 2 = 1 at h
        omega
      · rfl
    have hzod : ∀ j : Fin m, z ⟨2 * j.val + 1, by omega⟩ = MvPolynomial.X j := by
      intro j
      rw [hz]
      split_ifs with h
      · congr 1
        apply Fin.ext
        show (2 * j.val + 1) / 2 = j.val
        omega
      · exfalso
        change ¬ (2 * j.val + 1) % 2 = 1 at h
        omega

    obtain ⟨ν, hν1, hν2⟩ : ∃ ν : (wcQuadModelRing Ac n π c ⧸ Ĩ) →+* MvPolynomial (Fin m) K,
        (∀ a, ν (Ideal.Quotient.mk Ĩ (algebraMap Ac _ a)) = MvPolynomial.C (κ a)) ∧
        (∀ i, ν (Ideal.Quotient.mk Ĩ (S i)) = z i) := by
      let ν₀ : MvPolynomial (Fin n) Ac →+* MvPolynomial (Fin m) K :=
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp κ)
          (fun b => ∑ a, MvPolynomial.C (κ (P b a)) * z a)
      have hν₀F : ν₀ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π) = 0 := by
        have h1 := congrArg (MvPolynomial.eval₂Hom (MvPolynomial.C.comp κ) z) hid
        simp only [map_sum, map_mul, map_add, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', RingHom.comp_apply, hzev, hκπ, map_zero, zero_mul,
          Finset.sum_const_zero, zero_add] at h1
        simp only [ν₀, map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', RingHom.comp_apply, hκπ, map_zero, sub_zero]
        exact h1
      have hker : ∀ a ∈ wcQuadModelIdeal Ac n π c, ν₀ a = 0 := by
        intro a ha
        have hle : wcQuadModelIdeal Ac n π c ≤ RingHom.ker ν₀ :=
          (Ideal.span_singleton_le_iff_mem _).mpr (RingHom.mem_ker.mpr hν₀F)
        exact hle ha
      obtain ⟨νQ, hνQ⟩ : ∃ νQ : wcQuadModelRing Ac n π c →+* MvPolynomial (Fin m) K,
          νQ = Ideal.Quotient.lift (wcQuadModelIdeal Ac n π c) ν₀ hker := ⟨_, rfl⟩
      have hνQS : ∀ i, νQ (S i) = z i := by
        intro i
        rw [hνQ, hS, Ideal.Quotient.lift_mk]
        simp only [ν₀, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
          RingHom.comp_apply]
        have h := hmat (MvPolynomial.C.comp κ) P⁻¹ P z i
        rw [hPP', hone] at h
        simpa only [RingHom.comp_apply] using h
      have hkerĨ : ∀ a ∈ Ĩ, νQ a = 0 := by
        intro a ha
        have hle : Ĩ ≤ RingHom.ker νQ := by
          rw [hĨ, Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          exact RingHom.mem_ker.mpr ((hνQS _).trans (hzev j))
        exact hle ha
      refine ⟨Ideal.Quotient.lift Ĩ νQ hkerĨ, fun a => ?_, fun i => ?_⟩
      · rw [Ideal.Quotient.lift_mk, hAlg, hνQ, Ideal.Quotient.lift_mk]
        simp only [ν₀, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · rw [Ideal.Quotient.lift_mk, hνQS]

    obtain ⟨Φ₀, hΦ₀⟩ : ∃ Φ₀ : MvPolynomial (Fin m) K →+* Lu,
        Φ₀ = MvPolynomial.eval₂Hom ((θ.comp (algebraMap Ac (wcQuadModelRing Ac n π c))).comp ι)
          (fun j => θ (S ⟨2 * j.val + 1, by omega⟩)) := ⟨_, rfl⟩
    have hΦ₀C : ∀ k, Φ₀ (MvPolynomial.C k) =
        θ (algebraMap Ac (wcQuadModelRing Ac n π c) (ι k)) := by
      intro k
      simp only [hΦ₀, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    have hΦ₀X : ∀ j : Fin m, Φ₀ (MvPolynomial.X j) = θ (S ⟨2 * j.val + 1, by omega⟩) := by
      intro j
      rw [hΦ₀, MvPolynomial.eval₂Hom_X']
    have hΦz : ∀ i, Φ₀ (z i) = θ (S i) := by
      intro i
      rw [hz]
      split_ifs with h
      · rw [hΦ₀X]
        exact congrArg (fun x => θ (S x))
          (Fin.ext (by show 2 * (i.val / 2) + 1 = i.val; omega))
      · rw [map_zero]
        obtain ⟨j, hj⟩ : ∃ j : Fin m, (⟨2 * j.val, by omega⟩ : Fin n) = i :=
          ⟨⟨i.val / 2, by omega⟩, Fin.ext (show 2 * (i.val / 2) = i.val by omega)⟩
        rw [← hj, hθev]
    have hstar : ∀ q, Φ₀ (ν (Ideal.Quotient.mk Ĩ q)) = θ q := by
      intro q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      induction p using MvPolynomial.induction_on with
      | C a =>
        rw [← hAlg, hν1, hΦ₀C, hθκ]
      | add p q hp hq =>
        simp only [map_add]
        rw [hp, hq]
      | mul_X p i hp =>
        simp only [map_mul]
        rw [hp]
        congr 1
        rw [hexp i]
        simp only [map_sum, map_mul]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [hν1, hν2, hΦ₀C, hΦz, hθκ]
    have hstar' : Φ₀.comp ν = locU := by
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext (fun q => ?_)
      simp only [RingHom.comp_apply]
      rw [hstar, hθa]
    have hstarU : Φ₀ (ν Ub) = θ U := by
      have h := hstar U
      rwa [← hUb] at h
    obtain ⟨w, hw⟩ : ∃ w : MvPolynomial (Fin m) K, w = ν Ub := ⟨_, rfl⟩
    obtain ⟨Lw, _, locW, hlocWunit, hlocw, hliftW, hextW⟩ := hloc (MvPolynomial (Fin m) K) w
    haveI := hlocw
    have hμunit : IsUnit ((locW.comp ν) Ub) := by
      rw [RingHom.comp_apply, ← hw]; exact hlocWunit
    have hΦunit : IsUnit (Φ₀ w) := by
      rw [hw, hstarU]; exact hθU
    obtain ⟨μ, hμcomp⟩ := hliftU _ (locW.comp ν) hμunit
    obtain ⟨Φ, hΦcomp⟩ := hliftW _ Φ₀ hΦunit
    have hμθ : ∀ q, μ (θ q) = locW (ν (Ideal.Quotient.mk Ĩ q)) := by
      intro q
      rw [hθa, ← RingHom.comp_apply μ locU, hμcomp, RingHom.comp_apply]
    have hψuθ : ∀ q, ψu (θ q) = Ideal.Quotient.mk (Ideal.map β Ĩ) (β q) := by
      intro q
      rw [hθa, ← RingHom.comp_apply ψu locU, hψucomp, hψbarmk]
    have hΦμ : Φ.comp μ = RingHom.id _ := by
      apply hextU
      rw [RingHom.comp_assoc, hμcomp, ← RingHom.comp_assoc, hΦcomp, hstar',
        RingHom.id_comp]
    have hμΦ : μ.comp Φ = RingHom.id _ := by
      apply hextW
      rw [RingHom.comp_assoc, hΦcomp, RingHom.id_comp]
      apply MvPolynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, hΦ₀C, hμθ, hν1, hκι]
      · intro j
        rw [RingHom.comp_apply, hΦ₀X, hμθ, hν2, hzod]
    haveI hiso : IsIso (CommRingCat.ofHom Φ) :=
      ⟨⟨CommRingCat.ofHom μ, by rw [← CommRingCat.ofHom_comp, hμΦ, CommRingCat.ofHom_id],
        by rw [← CommRingCat.ofHom_comp, hΦμ, CommRingCat.ofHom_id]⟩⟩

    have hfac : (Ideal.Quotient.mk (Ideal.map β Ĩ)).comp (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap Ac (wcQuadModelRing Ac n π c))).comp ι)
        (fun j => β (S ⟨2 * j.val + 1, by omega⟩))) =
        ψu.comp (Φ.comp locW) := by
      rw [hΦcomp]
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hΦ₀C, hψuθ]
      · intro j
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hΦ₀X, hψuθ]
    rw [hfac, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp]
    haveI := hψuWE
    infer_instance

theorem wc_pmn_hc_morse_at_x (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} ∧
      IsUnit (c + c.transpose).det ∧
      ∃ β : wcQuadModelRing A n π c →+* B,
        WeaklyEtale (Spec.map (CommRingCat.ofHom β)) ∧
        (∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
          IsLocalRing.maximalIdeal B) ∧
        Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))) =
          a' ≫ Limits.pullback.fst V.hom D.f ≫ e.hom :=
by
  classical

  have specIso : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : Spec (.of S) ≅ Spec (.of R)),
      ∃ τ : R ≃+* S, Spec.map (CommRingCat.ofHom (τ : R →+* S)) = f.hom := by
    intro R S _ _ f
    have hgh : Spec.preimage f.hom ≫ Spec.preimage f.inv = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_id, Iso.inv_hom_id]
    have hhg : Spec.preimage f.inv ≫ Spec.preimage f.hom = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_id, Iso.hom_inv_id]
    let ε : CommRingCat.of R ≅ CommRingCat.of S :=
      ⟨Spec.preimage f.hom, Spec.preimage f.inv, hgh, hhg⟩
    refine ⟨ε.commRingCatIsoToRingEquiv, ?_⟩
    have hε : CommRingCat.ofHom (ε.commRingCatIsoToRingEquiv : R →+* S) = Spec.preimage f.hom := by
      first
        | rfl
        | (rw [Iso.commRingCatIsoToRingEquiv_toRingHom]; rfl)
        | (rw [Iso.commRingCatIsoToRingEquiv_toRingHom, CommRingCat.ofHom_hom])
    rw [hε, Spec.map_preimage]

  have shCl : ∀ {Y₀ : Scheme.{u}} (y : Y₀) (B' : Type u) [CommRing B'] [IsLocalRing B']
      (Λ₂ : Type u) [SmallCategory Λ₂] [IsCofiltered Λ₂]
      (W₂ : Λ₂ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y₀ y)) (Scheme.Etale.forget Y₀))
      (φ₂ : ∀ l, Spec (.of B') ⟶ (W₂.obj l).right.left) (a₂ : Spec (.of B') ⟶ Y₀),
      wcHalShData y B' Λ₂ W₂ φ₂ a₂ → a₂ (IsLocalRing.closedPoint B') = y := by
    intro Y₀ y B' _ _ Λ₂ _ _ W₂ φ₂ a₂ h
    unfold wcHalShData at h
    obtain ⟨-, -, -, -, -, eB, -, heq⟩ := h
    have hres : ∀ w : Spec (.of (IsLocalRing.ResidueField B')),
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) w = IsLocalRing.closedPoint B' := by
      intro w
      rw [Spec.map_apply]
      exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue B'))
        (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField B')) w _)).trans
        ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue B')).mp inferInstance)
    have key : ∀ pt : Spec (.of (AlgebraicClosure (Y₀.residueField y))),
        a₂ (IsLocalRing.closedPoint B') = y := by
      intro pt
      have h1 : (Spec.map (CommRingCat.ofHom eB) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ a₂) pt =
          (wcEtGeomPt Y₀ y) pt := by
        rw [heq]
      simp only [Scheme.Hom.comp_apply, wcEtGeomPt, hres] at h1
      exact h1.trans (Scheme.fromSpecResidueField_apply _ _)
    exact key (IsLocalRing.closedPoint _)

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨Ac, _, _, _, Λ, _, _, W', φ, ac, eA, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (D.S i (IsLocalRing.closedPoint F''))
  have hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) Ac Λ W' φ ac := by
    unfold wcHalShData
    exact ⟨hI, haff, hcomp, hφa, hlim, eA, hint, heq⟩
  have hacl : ac (IsLocalRing.closedPoint Ac) = D.S i (IsLocalRing.closedPoint F'') :=
    shCl _ Ac Λ W' φ ac hA
  have hWa : WeaklyEtale ac := wc_shdata_weaklyEtale _ Ac Λ W' φ ac hA
  let VA : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ ac hWa
  obtain ⟨vA⟩ := wc_P1_strict_local_geomPoint_map F'' hP VA Ac (Iso.refl _)
  obtain ⟨v₀⟩ := wc_P1_strict_local_geomPoint_map F'' hP V A e
  obtain ⟨c, -⟩ := wc_pencil_PL_shens_nbhd_rigid F'' hP (D.S i) (D.hS i) VA vA Ac (Iso.refl _)
    hacl V v₀ A e hV
  have hγ1 : c.inv.left ≫ c.hom.left = 𝟙 V.left :=
    (MorphismProperty.Comma.comp_left c.inv c.hom).symm.trans
      ((congrArg (fun (f : V ⟶ V) => f.left) c.inv_hom_id).trans rfl)
  have hγ2 : c.hom.left ≫ c.inv.left = 𝟙 VA.left :=
    (MorphismProperty.Comma.comp_left c.hom c.inv).symm.trans
      ((congrArg (fun (f : VA ⟶ VA) => f.left) c.hom_inv_id).trans rfl)
  have hγ : c.hom.left ≫ V.hom = ac := MorphismProperty.Over.w c.hom
  have hinvA : c.inv.left ≫ ac = V.hom := by
    rw [← hγ, ← Category.assoc, hγ1, Category.id_comp]
  obtain ⟨γ, hγh⟩ : ∃ γ : V.left ≅ Spec (.of Ac), γ.hom = c.inv.left :=
    ⟨⟨c.inv.left, c.hom.left, hγ1, hγ2⟩, rfl⟩
  have hγV : γ.hom ≫ ac = V.hom := by rw [hγh]; exact hinvA

  have hisoG : ∀ {X₁ Pb T₁ T₂ : Scheme.{u}} (ff : X₁ ⟶ Pb) (uu : T₁ ⟶ Pb) (aa : T₂ ⟶ Pb)
      (γ' : T₁ ≅ T₂), γ'.hom ≫ aa = uu →
      ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa, IsIso κ ∧
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γ'.hom := by
    intro X₁ Pb T₁ T₂ ff uu aa γ' hγ'
    have hγi : γ'.inv ≫ uu = aa := by rw [← hγ', Iso.inv_hom_id_assoc]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa,
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γ'.hom :=
      ⟨Limits.pullback.lift (Limits.pullback.snd uu ff) (Limits.pullback.fst uu ff ≫ γ'.hom)
        (by rw [Category.assoc, hγ']; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨κ', hκ'1, hκ'2⟩ : ∃ κ' : Limits.pullback ff aa ⟶ Limits.pullback uu ff,
        κ' ≫ Limits.pullback.fst uu ff = Limits.pullback.snd ff aa ≫ γ'.inv ∧
        κ' ≫ Limits.pullback.snd uu ff = Limits.pullback.fst ff aa :=
      ⟨Limits.pullback.lift (Limits.pullback.snd ff aa ≫ γ'.inv) (Limits.pullback.fst ff aa)
        (by rw [Category.assoc, hγi]; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hκκ' : κ ≫ κ' = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ'1, reassoc_of% hκ2, Iso.hom_inv_id, Category.comp_id,
          Category.id_comp]
      · rw [Category.assoc, hκ'2, hκ1, Category.id_comp]
    have hκ'κ : κ' ≫ κ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ1, hκ'2, Category.id_comp]
      · rw [Category.assoc, hκ2, reassoc_of% hκ'1, Iso.inv_hom_id, Category.comp_id,
          Category.id_comp]
    exact ⟨κ, ⟨⟨κ', hκκ', hκ'κ⟩⟩, hκ1, hκ2⟩
  obtain ⟨κ, hκiso, hκ1, hκ2⟩ := hisoG D.f V.hom ac γ hγV
  haveI := hκiso
  have hx₀ : Limits.pullback.fst D.f ac (κ x) = D.xs i (IsLocalRing.closedPoint F'') := by
    have h1 := Scheme.Hom.comp_apply κ (Limits.pullback.fst D.f ac) x
    rw [hκ1] at h1
    exact h1.symm.trans hx₂
  obtain ⟨ι, hι⟩ := wc_etale_geom_point_residue_iso κ x (κ x) rfl
  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, b₁, e₁', h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (κ x)
  have hB₁ : wcHalShData (κ x) B₁ Λ₁ W₁ φ₁ b₁ := ⟨h1, h2, h3, h4, h5, e₁', h6, h7⟩
  obtain ⟨θ₁, hθ₁⟩ := wc_shdata_etale_iso κ x (κ x) ι hι B Λ' W'' φ' a' hsh B₁ Λ₁ W₁ φ₁ b₁ hB₁
  have hc : θ₁.hom ≫ (b₁ ≫ Limits.pullback.snd D.f ac) =
      a' ≫ Limits.pullback.fst V.hom D.f ≫ γ.hom := by
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ Limits.pullback.snd D.f ac) hθ₁).trans
        ((Category.assoc _ _ _).trans (congrArg (a' ≫ ·) hκ2)))

  obtain ⟨_, _, π₀, c₀, hmax₀, hdet₀, x₀, hx₀X, -, B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, hB₀,
    θ₂, hθ₂⟩ :=
    wc_pencil_odp_shens_morse_model F' F'' Y n hn hn2 D i Ac Λ W' φ ac hA (κ x) hx₀
      B₁ Λ₁ W₁ φ₁ b₁ hB₁
  have hθ : (θ₁ ≪≫ θ₂).hom ≫ a₀ ≫ wcQuadModelStr Ac n π₀ c₀ =
      a' ≫ Limits.pullback.fst V.hom D.f ≫ γ.hom := by
    rw [Iso.trans_hom, Category.assoc, hθ₂, hc]

  obtain ⟨β₀, hβ₀a⟩ : ∃ β₀ : wcQuadModelRing Ac n π₀ c₀ →+* B₀,
      Spec.map (CommRingCat.ofHom β₀) = a₀ :=
    ⟨(Spec.preimage a₀).hom, by rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage a₀⟩
  have hWβ₀ : WeaklyEtale (Spec.map (CommRingCat.ofHom β₀)) := by
    rw [hβ₀a]; exact wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀
  have hcl₀ := shCl x₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀
  have ht₀ : ∀ p, β₀ (Ideal.Quotient.mk (wcQuadModelIdeal Ac n π₀ c₀) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B₀ := by
    intro p
    have h := hx₀X p
    rw [← hcl₀, ← hβ₀a] at h
    first
      | (rw [Spec.map_apply] at h; exact h)
      | (erw [Spec.map_apply] at h; exact h)
      | (simp only [Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at h; exact h)
      | exact h
      | (have e1 := Spec.map_apply (CommRingCat.ofHom β₀) (IsLocalRing.closedPoint B₀)
         rw [e1] at h; exact h)

  obtain ⟨ρ, hρ⟩ := specIso A Ac (γ.symm ≪≫ e)
  obtain ⟨τ, hτ⟩ := specIso B₀ B (θ₁ ≪≫ θ₂)

  have hunit : ∀ y : A, IsUnit y ↔ IsUnit (ρ y) := fun y =>
    ⟨fun h => h.map ρ, fun h => by simpa using h.map ρ.symm⟩
  have hmax : IsLocalRing.maximalIdeal A = Ideal.span {ρ.symm π₀} := by
    ext y
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, Ideal.mem_span_singleton', hunit y,
      ← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal, hmax₀, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨ρ.symm a, by rw [← map_mul, ha, RingEquiv.symm_apply_apply]⟩
    · rintro ⟨b, hb⟩
      exact ⟨ρ b, by rw [← hb, map_mul, RingEquiv.apply_symm_apply]⟩
  have hdet : IsUnit (c₀.map ρ.symm + (c₀.map ρ.symm).transpose).det := by
    convert hdet₀.map (ρ.symm : Ac →+* A) using 1
    rw [RingHom.map_det, RingHom.mapMatrix_apply]
    congr 1
    ext p q
    simp
  obtain ⟨Φ, hΦC, hΦX⟩ : ∃ Φ : MvPolynomial (Fin n) A ≃+* MvPolynomial (Fin n) Ac,
      (∀ a, Φ (MvPolynomial.C a) = MvPolynomial.C (ρ a)) ∧
      (∀ p, Φ (MvPolynomial.X p) = MvPolynomial.X p) :=
    ⟨MvPolynomial.mapEquiv (Fin n) ρ, fun a => by simp [MvPolynomial.mapEquiv_apply],
      fun p => by simp [MvPolynomial.mapEquiv_apply]⟩
  have hΦg : (Φ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) Ac)
      (∑ p, ∑ q, MvPolynomial.C ((c₀.map ρ.symm) p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (ρ.symm π₀)) =
      ∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π₀ := by
    simp only [RingEquiv.coe_toRingHom, map_sub, map_sum, map_mul, hΦC, hΦX, Matrix.map_apply,
      RingEquiv.apply_symm_apply]
  have hideal : wcQuadModelIdeal Ac n π₀ c₀ =
      Ideal.map (Φ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) Ac)
        (wcQuadModelIdeal A n (ρ.symm π₀) (c₀.map ρ.symm)) := by
    show Ideal.span _ = Ideal.map _ (Ideal.span _)
    rw [Ideal.map_span, Set.image_singleton, hΦg]
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : wcQuadModelRing A n (ρ.symm π₀) (c₀.map ρ.symm) ≃+*
      wcQuadModelRing Ac n π₀ c₀, ∀ f, Ψ (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (Φ f) :=
    ⟨Ideal.quotientEquiv _ _ Φ hideal, fun f => by
      first
        | exact Ideal.quotientEquiv_mk _ _ _ _ f
        | simp [Ideal.quotientEquiv_mk]⟩
  have hΨalg : ∀ a : A, Ψ (algebraMap A (wcQuadModelRing A n (ρ.symm π₀) (c₀.map ρ.symm)) a) =
      algebraMap Ac (wcQuadModelRing Ac n π₀ c₀) (ρ a) := by
    intro a
    have e1 : algebraMap A (wcQuadModelRing A n (ρ.symm π₀) (c₀.map ρ.symm)) a =
        Ideal.Quotient.mk _ (MvPolynomial.C a) := rfl
    have e2 : algebraMap Ac (wcQuadModelRing Ac n π₀ c₀) (ρ a) =
        Ideal.Quotient.mk _ (MvPolynomial.C (ρ a)) := rfl
    rw [e1, e2, hΨ, hΦC]
  haveI iτ : IsIso (Spec.map (CommRingCat.ofHom (τ : B₀ →+* B))) := by
    rw [← RingEquiv.toCommRingCatIso_hom]; infer_instance
  haveI iΨ : IsIso (Spec.map (CommRingCat.ofHom (Ψ : wcQuadModelRing A n (ρ.symm π₀)
      (c₀.map ρ.symm) →+* wcQuadModelRing Ac n π₀ c₀))) := by
    rw [← RingEquiv.toCommRingCatIso_hom]; infer_instance
  refine ⟨ρ.symm π₀, c₀.map ρ.symm, hmax, hdet,
    (τ : B₀ →+* B).comp (β₀.comp (Ψ : wcQuadModelRing A n (ρ.symm π₀) (c₀.map ρ.symm) →+*
      wcQuadModelRing Ac n π₀ c₀)), ?_, ?_, ?_⟩
  ·
    rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp]
    exact (MorphismProperty.cancel_left_of_respectsIso @WeaklyEtale _ _).mpr
      ((MorphismProperty.cancel_right_of_respectsIso @WeaklyEtale _ _).mpr hWβ₀)
  ·
    intro p
    simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom]
    rw [hΨ, hΦX]
    have h := ht₀ p
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
    exact fun hu => h (by simpa using hu.map τ.symm)
  ·
    have hcompβ : ((τ : B₀ →+* B).comp (β₀.comp (Ψ : wcQuadModelRing A n (ρ.symm π₀)
        (c₀.map ρ.symm) →+* wcQuadModelRing Ac n π₀ c₀))).comp
          (algebraMap A (wcQuadModelRing A n (ρ.symm π₀) (c₀.map ρ.symm))) =
        (τ : B₀ →+* B).comp (β₀.comp ((algebraMap Ac (wcQuadModelRing Ac n π₀ c₀)).comp
          (ρ : A →+* Ac))) := by
      apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom]
      rw [hΨalg]
    rw [hcompβ, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
      Spec.map_comp, Spec.map_comp, Spec.map_comp, hτ, hβ₀a, hρ]
    calc _ = ((θ₁ ≪≫ θ₂).hom ≫ a₀ ≫ wcQuadModelStr Ac n π₀ c₀) ≫ γ.inv ≫ e.hom := by
          simp only [Category.assoc, Iso.trans_hom, Iso.symm_hom] <;> rfl
      _ = (a' ≫ Limits.pullback.fst V.hom D.f ≫ γ.hom) ≫ γ.inv ≫ e.hom := by rw [hθ]
      _ = a' ≫ Limits.pullback.fst V.hom D.f ≫ e.hom := by
          first
            | rw [Category.assoc, Category.assoc, Iso.hom_inv_id_assoc]
            | (erw [Category.assoc, Category.assoc, Iso.hom_inv_id_assoc])
            | simp

theorem wc_pmn_cw_odp_hyperbolic_coords (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F'')) :
    ∃ (Vt : ((wcProEtPullback D.f).obj V).left.ProEt)
      (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B)
      (_ : IsSepClosed (IsLocalRing.ResidueField B)) (J : Ideal B) (_ : J ≠ ⊤)
      (_ : ((wcProEtBC (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom)
          (wcQmSp A))).obj Vt).left ≅ Spec (.of (B ⧸ J)))
      (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (_ : ((ℓ : ℕ) : K) ≠ 0)
      (ψ : Vt.left ⟶ Spec (.of (MvPolynomial (Fin (n / 2)) K))),
      (∀ w : ↥(Limits.pullback Vt.hom ((wcProEtPullback D.f).map a₀).left),
        ψ (Limits.pullback.fst Vt.hom ((wcProEtPullback D.f).map a₀).left w) ∉
          Set.range (Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff (R := K) (σ := Fin (n / 2)))))) ∧
      ∃ (R : Type u) (_ : CommRing R) (_ : HenselianLocalRing R)
        (_ : IsSepClosed (IsLocalRing.ResidueField R))
        (σ : Spec (.of R) ⟶ Limits.pullback Vt.hom
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))),
        WeaklyEtale (σ ≫ Limits.pullback.fst Vt.hom
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫ ψ) ∧
        (σ ≫ Limits.pullback.fst Vt.hom
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫ ψ)
            (IsLocalRing.closedPoint R) =
          Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin (n / 2))))
            (IsLocalRing.closedPoint K) :=
by
  classical
  have hm2 : 2 * (n / 2) = n := Nat.two_mul_div_two_of_even hn
  have hm1 : 1 ≤ n / 2 := by omega

  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization x
  have hsh : wcHalShData x B Λ' W'' φ' a' := ⟨h1, h2, h3, h4, h5, eB, h6, h7⟩
  have hWa : WeaklyEtale a' := wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh
  let Vt : ((wcProEtPullback D.f).obj V).left.ProEt := MorphismProperty.Over.mk ⊤ a' hWa

  obtain ⟨J, c₀, hpb, hJ⟩ :=
    wc_pmn_shens_closed_fibre_square F' F'' Y n D V A e x hx₁ B Λ' W'' φ' a' hsh
  haveI : IsIso c₀ := hpb.isIso_snd_of_isIso

  obtain ⟨K, _, _, ιA, hbij, hℓK⟩ := wc_pmn_hc_coeff_field F'' (D.S i) (D.hS i) V A e hV ℓ hℓ
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) :=
    IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ hbij)

  obtain ⟨π, c, hπ, hc, β, hβ, ht, hβa⟩ :=
    wc_pmn_hc_morse_at_x F' F'' Y n hn hn2 D i V A e hV x hx₁ hx₂ B Λ' W'' φ' a' hsh
  obtain ⟨P, D', hP, hD0, hid⟩ := wc_pmn_hc_hyperbolic_change A π hπ (n / 2) n hm2.symm hm1 c hc
  obtain ⟨y, I, hI, hπI, hym, hyπ, hWE⟩ :=
    wc_pmn_hc_slice_weaklyEtale A π hπ K ιA hbij (n / 2) n hm2.symm c P hP D' hD0 hid B β hβ ht
  obtain ⟨ζ, hζ⟩ : ∃ ζ : MvPolynomial (Fin (n / 2)) K →+* B,
      ζ = MvPolynomial.eval₂Hom ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ιA) y :=
    ⟨_, rfl⟩
  rw [← hζ] at hWE
  have hζX : ∀ j, ζ (MvPolynomial.X j) = y j := by
    intro j; rw [hζ]; exact MvPolynomial.eval₂Hom_X' _ _ _
  obtain ⟨g, hg⟩ : ∃ g : A →+* B, g = β.comp (algebraMap A (wcQuadModelRing A n π c)) :=
    ⟨_, rfl⟩
  rw [← hg] at hβa
  have hgπ : g π = β (algebraMap A (wcQuadModelRing A n π c) π) := by rw [hg]; rfl
  have hã1 : (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
        Limits.pullback.fst V.hom D.f = Limits.pullback.fst E.hom D.f ≫ a₀.left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have eW : Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≅
        Spec (.of (B ⧸ J)) := asIso c₀
  refine ⟨Vt, B, inferInstance, inferInstance, inferInstance, J, hJ, eW, K, inferInstance,
    inferInstance, hℓK, Spec.map (CommRingCat.ofHom ζ), ?_, ?_⟩
  ·
    intro w hw
    obtain ⟨b, hb⟩ : ∃ b : Spec (.of B),
        b = Limits.pullback.fst Vt.hom ((wcProEtPullback D.f).map a₀).left w := ⟨_, rfl⟩
    rw [← hb] at hw
    have hX := (wc_affine_origin_range_iff K (n / 2) _).mp hw
    have hyb : ∀ j, y j ∈ b.asIdeal := by
      intro j
      have h' : ζ (MvPolynomial.X j) ∈ b.asIdeal := by
        first
          | exact hX j
          | simpa only [Spec.map_apply] using hX j
      rwa [hζX] at h'
    have hπb : g π ∈ b.asIdeal := by rw [hgπ]; exact hyπ _ b.isPrime hyb
    have hcl : Spec.map (CommRingCat.ofHom g) b = IsLocalRing.closedPoint A := by
      apply PrimeSpectrum.ext
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Spec.map (CommRingCat.ofHom g) b).isPrime.ne_top
      · show IsLocalRing.maximalIdeal A ≤ _
        rw [hπ, Ideal.span_le, Set.singleton_subset_iff]
        show π ∈ (Spec.map (CommRingCat.ofHom g) b).asIdeal
        rw [Spec.map_apply]
        exact hπb
    rw [hβa] at hcl
    obtain ⟨q, hq⟩ : ∃ q : ((wcProEtPullback D.f).obj E).left,
        q = Limits.pullback.snd Vt.hom ((wcProEtPullback D.f).map a₀).left w := ⟨_, rfl⟩
    have hcond : (Limits.pullback.fst Vt.hom ((wcProEtPullback D.f).map a₀).left ≫ Vt.hom) w =
        (Limits.pullback.snd Vt.hom ((wcProEtPullback D.f).map a₀).left ≫
          ((wcProEtPullback D.f).map a₀).left) w := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ← hb, ← hq] at hcond
    have hcond' : a' b = ((wcProEtPullback D.f).map a₀).left q := hcond
    have hz : Limits.pullback.fst V.hom D.f (((wcProEtPullback D.f).map a₀).left q) =
        a₀.left (Limits.pullback.fst E.hom D.f q) := by
      have key : ∀ {X₁ Y₁ : Scheme.{u}} (f₁ g₁ : X₁ ⟶ Y₁), f₁ = g₁ → ∀ p, f₁ p = g₁ p := by
        intro X₁ Y₁ f₁ g₁ h p; subst h; rfl
      have h1 := key _ _ hã1 q
      exact (Scheme.Hom.comp_apply _ _ q).symm.trans (h1.trans (Scheme.Hom.comp_apply _ _ q))
    have hcl1 : (Limits.pullback.fst V.hom D.f ≫ e.hom) (a' b) = IsLocalRing.closedPoint A :=
      (Scheme.Hom.comp_apply a' (Limits.pullback.fst V.hom D.f ≫ e.hom) b).symm.trans hcl
    have hcl2 : e.hom (Limits.pullback.fst V.hom D.f (a' b)) = IsLocalRing.closedPoint A :=
      (Scheme.Hom.comp_apply (Limits.pullback.fst V.hom D.f) e.hom (a' b)).symm.trans hcl1
    rw [hcond', hz] at hcl2
    have h3 : a₀.left (Limits.pullback.fst E.hom D.f q) = e.inv (IsLocalRing.closedPoint A) :=
      (Scheme.hom_inv_apply e _).symm.trans (congrArg e.inv hcl2)
    have h4 := congrArg (fun (f : E.left ⟶ (wcP1Over F'').left) => f (Limits.pullback.fst E.hom D.f q))
      (MorphismProperty.Over.w a₀)
    have h5 : V.hom (a₀.left (Limits.pullback.fst E.hom D.f q)) =
        E.hom (Limits.pullback.fst E.hom D.f q) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans h4
    rw [h3, hV] at h5
    exact hE (Limits.pullback.fst E.hom D.f q) i h5.symm
  ·
    obtain ⟨hR, hRs⟩ := wc_quot_strictly_henselian_of_ne_top B I hI
    have hgm : ∀ a ∈ IsLocalRing.maximalIdeal A, (Ideal.Quotient.mk I) (g a) = 0 := by
      intro a ha
      rw [hπ, Ideal.mem_span_singleton'] at ha
      obtain ⟨r, rfl⟩ := ha
      rw [Ideal.Quotient.eq_zero_iff_mem, map_mul, hgπ]
      exact I.mul_mem_left _ hπI
    let rb : IsLocalRing.ResidueField A →+* B ⧸ I :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) ((Ideal.Quotient.mk I).comp g) hgm
    have hr : rb.comp (IsLocalRing.residue A) = (Ideal.Quotient.mk I).comp g := by
      ext a
      first
        | rfl
        | exact Ideal.Quotient.lift_mk _ _ _
    have hw : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a') ≫
        (Limits.pullback.fst V.hom D.f ≫ e.hom) =
        Spec.map (CommRingCat.ofHom rb) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) := by
      rw [Category.assoc, ← hβa, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp, hr]
    obtain ⟨σs, hσs⟩ : ∃ σs : Spec (.of (B ⧸ I)) ⟶
        Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A),
        σs ≫ Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) =
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a' :=
      ⟨Limits.pullback.lift (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a')
        (Spec.map (CommRingCat.ofHom rb)) hw, Limits.pullback.lift_fst _ _ _⟩
    have hσw : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ Vt.hom =
        σs ≫ Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) :=
      hσs.symm
    obtain ⟨σ, hσ⟩ : ∃ σ : Spec (.of (B ⧸ I)) ⟶ Limits.pullback Vt.hom
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)),
        σ ≫ Limits.pullback.fst Vt.hom
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) =
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) :=
      ⟨Limits.pullback.lift (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) σs hσw,
        Limits.pullback.lift_fst _ _ _⟩
    have hcomp : σ ≫ Limits.pullback.fst Vt.hom
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
          Spec.map (CommRingCat.ofHom ζ) =
        Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp ζ)) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp, ← hσ]
      exact (Category.assoc _ _ _).symm
    refine ⟨B ⧸ I, inferInstance, hR, hRs, σ, ?_, ?_⟩
    · rw [hcomp]; exact hWE
    · rw [hcomp]
      have hyR : ∀ j, Ideal.Quotient.mk I (y j) ∈ IsLocalRing.maximalIdeal (B ⧸ I) := by
        intro j
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        rintro ⟨u, hu⟩
        obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : B ⧸ I)
        have e1 : Ideal.Quotient.mk I (y j * z - 1) = 0 := by
          rw [map_sub, map_mul, map_one, hz, ← hu, Units.mul_inv, sub_self]
        have e2 : y j * z - 1 ∈ IsLocalRing.maximalIdeal B :=
          IsLocalRing.le_maximalIdeal hI (Ideal.Quotient.eq_zero_iff_mem.mp e1)
        have e3 : y j * z ∈ IsLocalRing.maximalIdeal B := Ideal.mul_mem_right _ _ (hym j)
        have e4 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
          have e5 := Ideal.sub_mem _ e3 e2
          rwa [sub_sub_cancel] at e5
        exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr e4)
      have hmem : Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp ζ))
          (IsLocalRing.closedPoint (B ⧸ I)) ∈ Set.range (Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff (R := K) (σ := Fin (n / 2))))) := by
        rw [wc_affine_origin_range_iff]
        intro j
        show (Ideal.Quotient.mk I) (ζ (MvPolynomial.X j)) ∈ IsLocalRing.maximalIdeal (B ⧸ I)
        rw [hζX]
        exact hyR j
      obtain ⟨pt, hpt⟩ := hmem
      have hpt' : pt = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
      rw [← hpt, hpt']

theorem wc_mvpoly_origin_thom_strict_nonzero (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (m : ℕ) (hm : 1 ≤ m)
    (D₀ : wcHMPullData (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))) ℓ) (hD₀ : wcHMPullCanonical D₀) :
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Spec (.of (MvPolynomial (Fin m) K))) ℓ)) := HasExt.standard _
    ∃ τ : wcSuppExt D₀ (2 * m),
      ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec R ⟶ Spec (.of (MvPolynomial (Fin m) K))), WeaklyEtale k →
        k (IsLocalRing.closedPoint R) ∈ Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))) →
        ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Spec (.of K)),
          IsPullback g iT (Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))) k →
        ∀ (Dk : wcHMPullData k ℓ) (_ : wcHMPullCanonical Dk)
          (DT : wcHMPullData iT ℓ) (_ : wcHMPullCanonical DT), Epi (wcSuppUnitMap DT) →
        ∀ (γ : wcSuppObj DT ⟶ Dk.Φ.obj (wcSuppObj D₀)),
          wcSuppUnitMap DT ≫ γ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap D₀) →
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D₀ Dk (2 * m) τ) (zero_add _) ≠ 0 :=
by
  classical

  have hchart : ∃ j : Spec (.of (MvPolynomial (Fin m) K)) ⟶ wcProjK K m, IsOpenImmersion j ∧
      j ≫ wcProjKStr K m = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K))) := by
    obtain ⟨e0, he0⟩ := wc_pp_dehomogenize_ringEquiv K m 0
    obtain ⟨φ0, hφ0⟩ := wc_pp_chart_iso K m 0 e0 he0
    obtain ⟨q, hqpb, -⟩ := wc_affine_space_ulift_mvpoly_zero_pullback K (Spec (.of K)) (𝟙 _) m
    haveI : IsIso q := hqpb.isIso_snd_of_isIso
    have hw : (AffineSpace (ULift.{u} (Fin m)) (Spec (.of K)) ↘ Spec (.of K)) =
        q ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K))) := by
      have := hqpb.toCommSq.w
      rwa [Category.comp_id] at this
    refine ⟨inv q ≫ φ0.inv ≫ (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X 0)).ι, inferInstance, ?_⟩
    have e1 : (inv q ≫ φ0.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X 0)).ι) ≫ wcProjKStr K m =
        inv q ≫ φ0.inv ≫ ((@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X 0)).ι ≫ (@Proj.toSpecZero _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0))))) := by
      simp only [Category.assoc]
    rw [e1, hφ0, Iso.inv_hom_id_assoc, hw, IsIso.inv_hom_id_assoc]
  obtain ⟨j, hjo, hjp⟩ := hchart
  haveI := hjo

  haveI := wc_proj_space_isProper K m
  haveI := wc_proj_space_irreducible K m
  haveI := wc_proj_space_smooth K m
  haveI : IsLocallyNoetherian (wcProjK K m) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr K m)

  have hi : (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j) ≫
      wcProjKStr K m = 𝟙 (Spec (.of K)) := by
    rw [Category.assoc, hjp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      MvPolynomial.constantCoeff_comp_algebraMap, CommRingCat.ofHom_id, Spec.map_id]
  haveI : IsClosedImmersion
      ((Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j) ≫
        wcProjKStr K m) := by
    rw [hi]; infer_instance
  haveI : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j) :=
    IsClosedImmersion.of_comp _ (wcProjKStr K m)
  haveI : SmoothOfRelativeDimension 0
      ((Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j) ≫
        wcProjKStr K m) := by
    rw [hi]; infer_instance

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists
    (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j) ℓ
  obtain ⟨τ', hτ'⟩ := wc_smooth_pair_ladic_thom_strict_nonzero K (wcProjKStr K m) m 0 m
    (zero_add m) _ ℓ hℓ Di hDi

  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists j ℓ
  obtain ⟨κ, hκ, -⟩ := wc_supp_open_excision_exists _ j _ rfl Di hDi D₀ hD₀ Dj hDj
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (.of (MvPolynomial (Fin m) K))) ℓ)) := HasExt.standard _
  refine ⟨(Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj (2 * m) τ') (zero_add _), ?_⟩
  intro R _ _ k hk hpt T iT g hpb Dk hDk DT hDT hepi γ hγ
  haveI := hk
  have hkY : WeaklyEtale (k ≫ j) := inferInstance
  have hptY : (k ≫ j) (IsLocalRing.closedPoint R) ∈ Set.range
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j) := by
    obtain ⟨z, hz⟩ := hpt
    refine ⟨z, ?_⟩
    rw [Scheme.Hom.comp_apply, hz]
    rfl
  have hpbY : IsPullback g iT
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) ≫ j)
      (k ≫ j) :=
    IsPullback.of_isLimit (Limits.PullbackCone.isLimitOfCompMono _ k j hpb.cone hpb.isLimit)
  obtain ⟨DkY, hDkY⟩ := wc_hm_pull_data_exists (k ≫ j) ℓ
  obtain ⟨γ₁₂, hγ₁₂, heq⟩ := wc_supp_pull_comp_exists j k (k ≫ j) rfl Di D₀ DT Dj hDj Dk hDk
    DkY hDkY κ hκ γ hγ
  have hne := hτ' R (k ≫ j) hkY hptY T iT g hpbY DkY hDkY DT hDT hepi γ₁₂ hγ₁₂
  rw [heq] at hne
  exact hne

theorem wc_mvpoly_origin_supp_class_zero (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓK : ((ℓ : ℕ) : K) ≠ 0) (m : ℕ) (hm : 1 ≤ m)
    (D₀ : wcHMPullData (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))) ℓ) (hD₀ : wcHMPullCanonical D₀)
    (n : ℕ) (θ : wcSuppExt D₀ n) : wcSuppClass D₀ n θ = 0 :=
by
  classical
  haveI hci : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))) :=
    IsClosedImmersion.spec_of_surjective _
      (fun c => ⟨MvPolynomial.C c, MvPolynomial.constantCoeff_C _ c⟩)

  let p : Spec (.of (MvPolynomial (Fin m) K)) ⟶ Spec (.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))
  let s₁ : Spec (.of K) ⟶ Spec (.of (MvPolynomial (Fin m) K)) :=
    Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin m => (1 : K))))
  have hs : s₁ ≫ p = 𝟙 _ := by
    have e : (MvPolynomial.eval (fun _ : Fin m => (1 : K))).comp
        (algebraMap K (MvPolynomial (Fin m) K)) = RingHom.id K := by
      ext a; simp [MvPolynomial.algebraMap_eq]
    show Spec.map _ ≫ Spec.map _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, e, CommRingCat.ofHom_id, Spec.map_id]
  have hdisj : ∀ (t : ↥(Spec (.of K))) (z : ↥(Spec (.of K))),
      s₁ t ≠ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) z := by
    intro t z h
    have hr : s₁ t ∈ Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))) := ⟨z, h.symm⟩
    rw [wc_affine_origin_range_iff] at hr
    have h1 : (MvPolynomial.eval (fun _ : Fin m => (1 : K))) (MvPolynomial.X ⟨0, hm⟩) ∈
        t.asIdeal := hr ⟨0, hm⟩
    rw [MvPolynomial.eval_X] at h1
    exact t.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)

  obtain ⟨q, hqpb, -⟩ := wc_affine_space_ulift_mvpoly_zero_pullback K (Spec (.of K)) (𝟙 _) m
  haveI : IsIso q := hqpb.isIso_snd_of_isIso
  have hk : q ≫ p = (AffineSpace (ULift.{u} (Fin m)) (Spec (.of K)) ↘ Spec (.of K)) := by
    have := hqpb.w
    rw [Category.comp_id] at this
    exact this.symm
  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists p ℓ
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s₁ ℓ
  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (𝟙 (Spec (.of K))) ℓ
  obtain ⟨DA, hDA⟩ := wc_hm_pull_data_exists
    (AffineSpace (ULift.{u} (Fin m)) (Spec (.of K)) ↘ Spec (.of K)) ℓ
  obtain ⟨Dq, hDq⟩ := wc_hm_pull_data_exists q ℓ
  obtain ⟨Dinv, hDinv⟩ := wc_hm_pull_data_exists (inv q) ℓ
  obtain ⟨D1A, hD1A⟩ := wc_hm_pull_data_exists (𝟙 (Spec (.of (MvPolynomial (Fin m) K)))) ℓ
  have hs1 : wcHMPull Ds n (wcSuppClass D₀ n θ) = 0 :=
    wc_supp_class_pull_zero_of_disjoint _ s₁ hdisj D₀ hD₀ Ds hDs n θ
  obtain ⟨x, hx⟩ := wc_hm_affine_space_pull_surj K ℓ hℓK (𝟙 (Spec (.of K))) m DA hDA n
    (wcHMPull Dq n (wcSuppClass D₀ n θ))
  have hqinj : ∀ y, wcHMPull Dinv n (wcHMPull Dq n y) = y := by
    intro y
    rw [← wc_hm_pull_comp q (inv q) (𝟙 _) (IsIso.inv_hom_id q) Dq hDq Dinv hDinv D1A hD1A n y]
    exact wc_hm_pull_id _ rfl D1A hD1A n y
  have hpx : wcHMPull Dp n x = wcSuppClass D₀ n θ := by
    have h1 := wc_hm_pull_comp p q _ hk Dp hDp Dq hDq DA hDA n x
    rw [hx] at h1
    have h2 := congrArg (wcHMPull Dinv n) h1
    rw [hqinj, hqinj] at h2
    exact h2.symm
  have hx0 : x = 0 := by
    have h1 := wc_hm_pull_comp p s₁ (𝟙 _) hs Dp hDp Ds hDs D1 hD1 n x
    rw [wc_hm_pull_id _ rfl D1 hD1, hpx, hs1] at h1
    exact h1
  rw [← hpx, hx0, map_zero]

theorem wc_punct_affine_strict_local_top_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : ((ℓ : ℕ) : K) ≠ 0) (m q : ℕ) (hm : 1 ≤ m)
    (hq : q + 1 = 2 * m) :
    ∃ (U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens)
      (_ : (U₀ : Set ↥(Spec (.of (MvPolynomial (Fin m) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))))ᶜ)
      (ω : wcHM U₀.toScheme ℓ q),
      ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec (.of R) ⟶ Spec (.of (MvPolynomial (Fin m) K))), WeaklyEtale k →
        k (IsLocalRing.closedPoint R) =
          Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m)))
            (IsLocalRing.closedPoint K) →
        ∀ (T : Scheme.{u}) (jT : T ⟶ Spec (.of R)) (kT : T ⟶ U₀.toScheme),
          IsPullback kT jT U₀.ι k →
          ∀ DT : wcHMPullData kT ℓ, wcHMPullCanonical DT → wcHMPull DT q ω ≠ 0 :=
by
  classical
  set i₀ : Spec (.of K) ⟶ Spec (.of (MvPolynomial (Fin m) K)) :=
    Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin m))) with hi₀
  haveI hci : IsClosedImmersion i₀ :=
    IsClosedImmersion.spec_of_surjective _
      (fun c => ⟨MvPolynomial.C c, MvPolynomial.constantCoeff_C _ c⟩)
  have hU : IsOpen (Set.range i₀)ᶜ :=
    (Scheme.Hom.isClosedEmbedding i₀).isClosed_range.isOpen_compl
  let U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens := ⟨(Set.range i₀)ᶜ, hU⟩
  obtain ⟨D₀, hD₀⟩ := wc_hm_pull_data_exists i₀ ℓ
  have hepi : Epi (wcSuppUnitMap D₀) := wc_supp_unit_epi_of_noetherian i₀ ℓ D₀ hD₀
  obtain ⟨δ, hexact, hnat⟩ := wc_supp_les_boundary_natural_qc i₀ D₀ hD₀ hepi
    (fun U k W g hW => wc_supp_kernel_section_local_cover i₀ D₀ hD₀ U k W g hW) U₀ rfl q (2 * m) hq
  obtain ⟨τ, hτ⟩ := wc_mvpoly_origin_thom_strict_nonzero K ℓ hℓK m hm D₀ hD₀
  obtain ⟨ω, hω⟩ := hexact τ (wc_mvpoly_origin_supp_class_zero K ℓ hℓK m hm D₀ hD₀ (2 * m) τ)
  refine ⟨U₀, rfl, ω, ?_⟩
  intro R _ _ _ k hk hpt T jT kT hT DT hDT h0
  haveI := hk
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists k ℓ
  obtain ⟨Di, hDi, γ, hγ, hepi'⟩ :=
    wc_closed_supp_base_change_weaklyEtale_affine i₀ k D₀ hD₀ Dk hDk
  have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Spec (.of R)), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range (Limits.pullback.fst k i₀) ↔ ∃ j, x ∈ W.basicOpen (f j)) := by
    intro W _ p
    refine ⟨m, fun j => (p ≫ k).appTop
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin m) K))).inv (MvPolynomial.X j)), ?_⟩
    intro x
    have key : ∀ j : Fin m, x ∈ W.basicOpen ((p ≫ k).appTop
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin m) K))).inv (MvPolynomial.X j))) ↔
        (MvPolynomial.X j : MvPolynomial (Fin m) K) ∉ (k (p x)).asIdeal := by
      intro j
      rw [← Scheme.preimage_basicOpen_top, Scheme.Hom.mem_preimage, basicOpen_eq_of_affine,
        Scheme.Hom.comp_apply]
      exact PrimeSpectrum.mem_basicOpen _ _
    rw [Scheme.Pullback.range_fst, Set.mem_preimage, hi₀, wc_affine_origin_range_iff, not_forall]
    exact exists_congr (fun j => (key j).symm)
  have hW' : ((k ⁻¹ᵁ U₀ : (Spec (.of R)).Opens) : Set ↥(Spec (.of R))) =
