        E.adj.unit.app (wcIntSuppObj DV) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)).map f) := by
    intro Y'
    have e : (fun f : E.L.obj (wcIntSuppObj DV) ⟶ Y' => E.adj.unit.app (wcIntSuppObj DV) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)).map f) =
        ⇑(E.adj.homEquiv (wcIntSuppObj DV) Y') := by
