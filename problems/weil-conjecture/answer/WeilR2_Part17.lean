        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    WeaklyEtale a₀ → IsNoetherianRing B :=
by
  intro A _ _ _ _ _ π _ r B _ _ _ a₀ ha₀
