      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G] {O' : 𝒜'} (I : InjectiveResolution O') (q : ℕ),
      Nonempty (((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)).homology (q : ℤ) ≅
        G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ G _ _ _ O' I q
