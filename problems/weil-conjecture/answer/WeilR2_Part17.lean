  obtain ⟨Kθ⟩ := wc_et_coh_iso_invariance θ'.hom ℓ 1
  obtain ⟨O, hO⟩ : ∃ O : (Spec (.of (MvPolynomial (Fin (0 + 1)) Ω))).Opens,
