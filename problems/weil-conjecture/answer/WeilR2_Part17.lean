          | rfl
          | (rw [ModuleCat.hom_nsmul]; rfl)
        exact e4.trans (e5 y)
      have evM : ∀ (S : Scheme.{u}) (e : wcIntUnit S ℓ ⟶ wcIntUnit S ℓ),
          ((SheafOfModules.unitHomEquiv _ (e ≫ ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
              (Opposite.op (TT S)) : C(↥S, ULift.{u+1} ℤ_[ℓ])) =
            (ℓ ^ k : ℕ) • ((SheafOfModules.unitHomEquiv _ e).1 (Opposite.op (TT S)) :
              C(↥S, ULift.{u+1} ℤ_[ℓ])) := by
        intro S e
        show (((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)).val.app (Opposite.op (TT S))).hom
