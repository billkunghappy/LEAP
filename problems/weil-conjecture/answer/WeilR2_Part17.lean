      apply hinj n
      rw [map_zero, hμs, Abelian.Ext.comp_assoc_of_third_deg_zero, hc, Abelian.Ext.comp_zero]
    exact ⟨fun n => ⟨(hup n).1, hcard n⟩, hsurj, hC3⟩

  have s2 : ∀ (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ),
      Finite (Abelian.Ext P (wcZModSheaf S ℓ) N) → Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) ≤ ℓ →
      (∀ n : ℕ, Finite (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) ∧
        Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) = ℓ ^ n) →
      ∀ n : ℕ, ∃ y : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N,
        ∀ x : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N, ∃ k : ℤ, x = k • y := by
    intro P N hfin hcard hcnt n
    have hkill : ∀ (n : ℕ) (x : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N), ℓ ^ n • x = 0 := by
      intro n x
      have h := card_nsmul_eq_zero' (G := Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) (x := x)
      rw [(hcnt n).2] at h
      exact h
    have hsm : ∀ {Q M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {i : ℕ}
        (v : Abelian.Ext Q M i) (m : ℕ),
        v.comp (Abelian.Ext.mk₀ (m • 𝟙 M)) (add_zero i) = m • v := by
      intro Q M i v m
      induction m with
      | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
      | succ k ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    cases n with
    | zero =>
      refine ⟨0, fun x => ⟨0, ?_⟩⟩
      have e : x = 0 :=
        calc x = 1 • x := (one_nsmul x).symm
          _ = ℓ ^ 0 • x := (congrArg (fun m : ℕ => m • x) (pow_zero ℓ)).symm
          _ = 0 := hkill 0 x
      rw [e, zero_smul]
    | succ k =>
      obtain ⟨f, g, f', p, hfg, hfp, hS₁, hS₂, hpf⟩ := hglc k
      let fs : Abelian.Ext P (wcZModSheaf S ℓ) N →+ Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N :=
        AddMonoidHom.mk' (fun a => a.comp (Abelian.Ext.mk₀ f') (add_zero N))
          (fun a b => Abelian.Ext.add_comp _ _ _ _)
      let ps : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N →+ Abelian.Ext P (wcZModSheaf S (ℓ ^ k)) N :=
        AddMonoidHom.mk' (fun a => a.comp (Abelian.Ext.mk₀ p) (add_zero N))
          (fun a b => Abelian.Ext.add_comp _ _ _ _)
      have hp_surj : ∀ z₁ : Abelian.Ext P (wcZModSheaf S (ℓ ^ k)) N,
          ∃ z₂ : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N,
            z₂.comp (Abelian.Ext.mk₀ p) (add_zero N) = z₁ := by
        intro z₁
        have hcd : Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) *
            Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ k)) N) ≤
            Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N) := by
          rw [(hcnt k).2, (hcnt (k + 1)).2, pow_succ']
          exact Nat.mul_le_mul hcard le_rfl
        exact G3 fs ps (fun b hb => Abelian.Ext.covariant_sequence_exact₂ P hS₂ b hb) hfin
          (hcnt (k + 1)).1 (hcnt k).1 hcd z₁
      let r : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N →+ Abelian.Ext P (wcZModSheaf S ℓ) N :=
        AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ g) (add_zero N))
          (fun a b => Abelian.Ext.add_comp _ _ _ _)
      have hr : ∀ x, r x = x.comp (Abelian.Ext.mk₀ g) (add_zero N) := fun x => rfl
      have hker : ∀ x, r x = 0 → ∃ w, x = ℓ • w := by
        intro x hx
        rw [hr] at hx
        obtain ⟨z₁, hz₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS₁ x hx
        have hz₁' : z₁.comp (Abelian.Ext.mk₀ f) (add_zero N) = x := hz₁
        obtain ⟨z₂, hz₂⟩ := hp_surj z₁
        have hz₂' : z₂.comp (Abelian.Ext.mk₀ p) (add_zero N) = z₁ := hz₂
        refine ⟨z₂, ?_⟩
        rw [← hz₁', ← hz₂', Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          hpf, hsm]
      have htor : ∀ x : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N, ℓ ^ (k + 1) • x = 0 :=
        hkill (k + 1)
      have hstep : ∃ y : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N, ∀ x, ∃ (c : ℤ)
          (w : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N), x = c • y + ℓ • w := by
        by_cases h0 : ∀ x, r x = 0
        · refine ⟨0, fun x => ?_⟩
          obtain ⟨w, hw⟩ := hker x (h0 x)
          exact ⟨0, w, by rw [hw]; simp⟩
        · push_neg at h0
          obtain ⟨y, hy⟩ := h0
          refine ⟨y, fun x => ?_⟩
          have hord : addOrderOf (r y) ∣ ℓ ^ (k + 1) := by
            apply addOrderOf_dvd_of_nsmul_eq_zero
            have h1 := map_nsmul r (ℓ ^ (k + 1)) y
            rw [htor, map_zero] at h1
            exact h1.symm
          obtain ⟨j, _, hj'⟩ := (Nat.dvd_prime_pow (Fact.out : Nat.Prime ℓ)).mp hord
          have hj0 : j ≠ 0 := by
            rintro rfl
            rw [pow_zero, AddMonoid.addOrderOf_eq_one_iff] at hj'
            exact hy hj'
          have hle : Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) ≤
