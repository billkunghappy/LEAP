    have eq₁ : β ≫ 𝟙 _ = δ ≫ (a'' ≫ Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) := by
      rw [Category.comp_id, ← Category.assoc, hδ, hw₂]
