by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  obtain ⟨τ, hτ⟩ := wc_smooth_pair_qcsep_ladic_thom_strict_nonzero K pY n m r hmr i ℓ hℓ Di hDi
