    have hτs : ∀ (n : ℕ) (a : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N),
        τs n a = a.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
          continuous_of_discreteTopology)) (add_zero N) := fun n a => rfl
