  have T := wc_et_coh_transfer_of_shens_fibres (Spec (.of B)) (Spec (.of B₀))
    (Limits.pullback (av ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ξ)
    β (Limits.pullback.fst (av ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ξ)
    ℓ hℓ0 (fun p Cp _ _ _ Λp _ _ Wp φp ap hdp =>
      hfibβ Cp (ap ≫ Limits.pullback.fst (av ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ξ))
  let e := Limits.pullback.congrHom hc (rfl : ξ = ξ) ≪≫
    (Limits.pullbackRightPullbackFstIso (av ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ξ β).symm
  have Ecomp : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (a ≫ wcQuadModelStr A (r + 2) π
