      let b : C(↥V.left, ULift.{u+1} ℤ_[ℓ]) :=
        ⟨fun p => ULift.up ⟨β p, hβ p⟩, continuous_uliftUp.comp (Continuous.subtype_mk hβc hβ)⟩
      have hkey : ∀ q, (a₁ q).down * (χ q).down = ((ℓ ^ k : ℕ) : ℤ_[ℓ]) * (b q).down := by
