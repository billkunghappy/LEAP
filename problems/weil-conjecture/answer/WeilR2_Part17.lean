      have hℓQ : (ℓ : ℚ_[ℓ]) ≠ 0 := by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero
      obtain ⟨β, hβdef⟩ : ∃ β : V.left → ℚ_[ℓ], β = fun p =>
