      ∀ j : ℕ, Function.Bijective (wcZModPull D j) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 L _ _ φA hφA halg XE p q hpb
    Xs ι s hps Y iY kY hY C _ _ _ c hc hrange Pq q' t hP k hk D hD j
