        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} ∧
      (O : Set ↥(Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))) =
        {w | Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w ≠ xs} ∧
      WeaklyEtale κ ∧ κ ⁻¹ᵁ Oc = O ∧ IsAlgClosed (IsLocalRing.ResidueField A) ∧
      ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 :=
by
  classical
  obtain ⟨W, -, φ, hφ, ψ, hψ, w₀, v₀, hφw₀, hφfib, hψfib, -, -, hvert, -, hℓK⟩ :=
    wc_pmn_sls_odp_split_cone_span F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂ xs hxs
  haveI := hφ
  haveI := hψ
  have hK : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  obtain ⟨J, c, hpb, hJ⟩ :=
    wc_pmn_shens_closed_fibre_square F' F'' Y n D V A e x hx₁ B Λ' W'' φ' a' hsh
  obtain ⟨hxsC, -, -, hnode⟩ := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  obtain ⟨hH, hSC⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ
  letI := hH
  haveI := hSC
  haveI : IsIso c := hpb.isIso_snd_of_isIso

  have hfc : inv c ≫ Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) := by
    have hw := hpb.w
    rw [Category.comp_id] at hw
    rw [hw, IsIso.inv_hom_id_assoc]

  have hcl : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) (IsLocalRing.closedPoint (B ⧸ J)) =
      IsLocalRing.closedPoint B := by
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
      rw [CommRingCat.hom_ofHom]
      exact IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    exact Spec_closedPoint

  have ha'x : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨ee, -, he⟩ := hsh.2.2.2.2.2
    have h1 : ∀ g g' : Spec (.of (AlgebraicClosure
        ((((wcProEtPullback D.f).obj V).left).residueField x))) ⟶ ((wcProEtPullback D.f).obj V).left,
        g = g' → g (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))) =
          g' (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))) := by
      rintro g _ rfl; rfl
    have h2 := h1 _ _ he
    have h3 : a' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        ((Spec.map (CommRingCat.ofHom ee)) (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))))) = x :=
      h2.trans (Scheme.fromSpecResidueField_apply x _)
    have hsub : (Spec.map (CommRingCat.ofHom ee)) (IsLocalRing.closedPoint (AlgebraicClosure
          ((((wcProEtPullback D.f).obj V).left).residueField x))) =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField B) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField B)) _ _
    have hres : Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField B)) = IsLocalRing.closedPoint B := by
      haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue B))) := by
        rw [CommRingCat.hom_ofHom]; infer_instance
      exact Spec_closedPoint
    rw [hsub, hres] at h3
    exact h3

  have hfz : Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) = IsLocalRing.closedPoint B := by
    have h : (inv c ≫ Limits.pullback.fst a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
          (IsLocalRing.closedPoint (B ⧸ J)) =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) (IsLocalRing.closedPoint (B ⧸ J)) := by
      rw [hfc]
    exact h.trans hcl
  have hcond : (Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫ a')
        ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) =
      (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
        Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) :=
    congrArg (fun g : Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ⟶
          ((wcProEtPullback D.f).obj V).left => g ((inv c) (IsLocalRing.closedPoint (B ⧸ J))))
      (Limits.pullback.condition (f := a')
        (g := Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
  have hcond' : a' (Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        ((inv c) (IsLocalRing.closedPoint (B ⧸ J)))) =
      Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
        (Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
          ((inv c) (IsLocalRing.closedPoint (B ⧸ J)))) := hcond
  have hwz : Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) = xs := by
    apply hnode
    rw [← hcond', hfz, ha'x]
    exact hx₂
  have hw : φ w₀ = (inv c ≫ Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
        (IsLocalRing.closedPoint (B ⧸ J)) := hφw₀.trans hwz.symm
  obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift (B ⧸ J) (inv c ≫ Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) φ w₀ hw

  haveI : WeaklyEtale a' := wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh
  haveI : WeaklyEtale (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ‹_›
  haveI : WeaklyEtale (σ ≫ φ) := by rw [hσ]; infer_instance
  haveI : WeaklyEtale σ := WeaklyEtale.of_comp σ φ

  have hσ' : c ≫ σ ≫ φ = Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) := by
    rw [hσ, IsIso.hom_inv_id_assoc]
  have hφt : ∀ w, φ (σ (c w)) = Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w := by
    intro w
    have h : (c ≫ σ ≫ φ) w = Limits.pullback.snd a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w := by
      rw [hσ']
    exact h
  have hvu := (wc_lup_quad_cone_vertex (IsLocalRing.ResidueField A) n
    (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
      then (1 : IsLocalRing.ResidueField A) else 0)).1
  have key : ∀ w, (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p) ∈
            ((c ≫ σ ≫ ψ) w).asIdeal) ↔
        Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w = xs := by
    intro w
    have hκw : (c ≫ σ ≫ ψ) w = ψ (σ (c w)) := rfl
    rw [hκw]
    constructor
    · intro hv
      have h1 : ψ (σ (c w)) = ψ w₀ := hvu _ _ hv hvert
      rw [← hφt, hψfib _ h1, hφw₀]
    · intro h
      have h1 : σ (c w) = w₀ := hφfib _ (by rw [hφt, h])
      rw [h1]
      exact hvert

  have hOc : IsOpen {y : ↥(Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)))) |
        ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
