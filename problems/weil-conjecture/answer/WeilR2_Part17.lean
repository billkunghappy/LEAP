        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
      (SheafOfModules.unit (wcEtZModRing Z ℓ)) γ hγ1 hγmul hγadd
      (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * r)
      (fun p => if p = 0 then 1 else 0)
      (by
        intro p hp
        have key : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
            ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
              D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
              (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                (2 * r - p)) p) ∧
            Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
            ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
              D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
              (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                (2 * r - p)) p) ≤ ℓ ^ (if p = 0 then 1 else 0) := by
          rcases Nat.eq_zero_or_pos p with h0 | hpos
          · subst h0
            rw [if_pos rfl, pow_one, Nat.sub_zero]
            obtain ⟨φ, hφ⟩ := hTop D
              (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                D.cont D.φ).rightAdjoint
              (Adjunction.ofIsLeftAdjoint
                (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
              (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ)))
            haveI := hφ
            let f : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
                ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                  D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                  (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                    (2 * r)) 0 →
                Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
                  (SheafOfModules.unit (wcEtZModRing Z ℓ)) 0 :=
              fun x => x.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero 0)
            have hf : Function.Injective f := by
              intro x y hxy
              have h1 : (f x).comp (Abelian.Ext.mk₀ φ) (add_zero 0) =
                  (f y).comp (Abelian.Ext.mk₀ φ) (add_zero 0) := by rw [hxy]
              simp only [f] at h1
              rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id,
                Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id] at h1
              exact h1
            obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv Z ℓ 0
            obtain ⟨hfin0, hcard0⟩ := wc_et_coh_zero_irreducible_card_le Z ℓ (by omega)
            haveI := hfin0
            have hg : Function.Injective (E0 ∘ f) := E0.injective.comp hf
            exact ⟨Finite.of_injective _ hg, (Nat.card_le_card_of_injective _ hg).trans hcard0⟩
          · have hz := wc_et_closed_rightAdj_low_homology_zero K pY n m r hmr i ℓ hℓ D
              (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                D.cont D.φ).rightAdjoint
              (Adjunction.ofIsLeftAdjoint
                (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
              (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * r - p)
              (by omega)
            have h0 : ∀ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
                ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                  D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                  (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                    (2 * r - p)) p, y = 0 := by
              intro y
              calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) :=
                    (Abelian.Ext.comp_mk₀_id y).symm
                _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
                _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
            haveI hsub : Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
                ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                  D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                  (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                    (2 * r - p)) p) := ⟨fun a b => (h0 a).trans (h0 b).symm⟩
            refine ⟨inferInstance, ?_⟩
            rw [if_neg (by omega), pow_zero]
            exact Finite.card_le_one_iff_subsingleton.mpr hsub
        obtain ⟨hfin, hcard⟩ := key
        obtain ⟨np, e, he, hnp⟩ := wc_zmod_ext_linear_equiv_of_finite ℓ
          (SheafOfModules.unit (wcEtZModRing Z ℓ)) _ γ hγ1 hγmul hγadd p hfin
        refine ⟨np, e, he, ?_⟩
        rw [← hnp] at hcard
        exact (Nat.pow_le_pow_iff_right (by omega)).mp hcard)
    have hsum : ∑ p ∈ Finset.range (2 * r + 1), (if p = 0 then 1 else 0) = 1 := by
      rw [Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr (by omega))]
    rw [hsum] at hN
    have hfinE : Finite (Abelian.Ext
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcEtZModRing Z ℓ))) (SheafOfModules.unit (wcEtZModRing Y ℓ))
          (2 * r)) := Finite.of_equiv _ e.toEquiv.symm
    have hcardE : Nat.card (Abelian.Ext
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcEtZModRing Z ℓ))) (SheafOfModules.unit (wcEtZModRing Y ℓ))
          (2 * r)) ≤ ℓ := by
      rw [Nat.card_congr e.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card (α := Fin N),
        Fintype.card_fin]
      calc ℓ ^ N ≤ ℓ ^ 1 := Nat.pow_le_pow_right (by omega) hN
        _ = ℓ := pow_one ℓ
    exact ⟨hfinE, hcardE⟩
  exact hTr hD

theorem wc_smooth_pair_qcsep_local_zmod_codim_card_ge (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) :
    ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * r)) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * r)) :=
by
  intro k hk hfin

  haveI : Smooth pY := SmoothOfRelativeDimension.smooth n pY
  have hrn : r ≤ n := by omega
  have hm' : m = n - r := by omega
  subst hm'
  have hNpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  have hzero : (ℓ ^ k) • 𝟙 (wcZModSheaf Y (ℓ ^ k)) = 0 := by
    apply Sheaf.hom_ext
    ext U x
    show ((sheafToPresheaf _ _).map ((ℓ ^ k) • 𝟙 (wcZModSheaf Y (ℓ ^ k)))).app U x = 0
    rw [Functor.map_nsmul, NatTrans.app_nsmul, CategoryTheory.Functor.map_id, NatTrans.id_app]
    show ((ℓ ^ k) • AddMonoidHom.id _) x = 0
    rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
    have key : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ZMod (ℓ ^ k))), (ℓ ^ k) • g = 0 := by
      intro T _ g
      ext t
      first
        | (simp only [ContinuousMap.coe_nsmul, Pi.smul_apply, ContinuousMap.zero_apply, nsmul_eq_mul]
           rw [ZMod.natCast_self, zero_mul])
        | (simp
           rw [← Nat.cast_pow, ZMod.natCast_self, zero_mul])
    obtain ⟨f⟩ := x
    apply ULift.ext
    exact key _ f
  have htors : ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * r),
      (ℓ ^ k) • x = 0 := by
    intro x
    have key : ∀ j : ℕ,
        x.comp (Abelian.Ext.mk₀ (j • 𝟙 (wcZModSheaf Y (ℓ ^ k)))) (add_zero (2 * r)) = j • x := by
      intro j
      induction j with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ j ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    rw [← key (ℓ ^ k), hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i (ℓ ^ k)
  have hsp : ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ)
      [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i]
      [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n →
      ∀ (D : wcEtPullData i (ℓ ^ k)) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0 := by
    intro X Z fX n c _ i _ _ hc D q hq θ
    exact wc_et_supp_semipurity_pow K X Z fX n c i hc ℓ hℓ k hk D q hq θ
  obtain ⟨T, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom_pow K ℓ hℓ k hk
  obtain ⟨θ, hθ⟩ := wc_et_thom_class_glue_pow K (ℓ ^ k) hsp T hGL hNat Y Z pY n r i hrn D

  have hθne : ℓ ^ (k - 1) • θ ≠ 0 := by
    obtain ⟨z⟩ : Nonempty Z := inferInstance
    obtain ⟨W, -, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout K Y Z pY n r i hrn z
    have sq : IsPullback (i ⁻¹ᵁ W).ι (i ∣_ W) i W.ι := (isPullback_morphismRestrict i W).flip
    obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (i ∣_ W) (ℓ ^ k)
    obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists W.ι (ℓ ^ k)
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change i W.ι (i ∣_ W) (i ⁻¹ᵁ W).ι sq D EW DW
    have hθW := hθ W _ (i ∣_ W) (i ⁻¹ᵁ W).ι sq DW EW γ hγ h hcut
    haveI hsmW : SmoothOfRelativeDimension n (W.ι ≫ pY) := by
      have := smoothOfRelativeDimension_comp 0 n W.ι pY
      rwa [Nat.zero_add] at this
    have e : (i ∣_ W) ≫ W.ι ≫ pY = (i ⁻¹ᵁ W).ι ≫ i ≫ pY := by
      rw [← Category.assoc, morphismRestrict_ι, Category.assoc]
    haveI hsmZW : SmoothOfRelativeDimension (n - r) ((i ∣_ W) ≫ W.ι ≫ pY) := by
      rw [e]
      have := smoothOfRelativeDimension_comp 0 (n - r) (i ⁻¹ᵁ W).ι (i ≫ pY)
      rwa [Nat.zero_add] at this
    have hneW : Nonempty (i ⁻¹ᵁ W).toScheme := ⟨⟨z, hzW⟩⟩
    obtain ⟨zK, hzK⟩ := wc_alg_closed_lft_section K (i ⁻¹ᵁ W).toScheme
      ((i ∣_ W) ≫ W.ι ≫ pY) hneW
    obtain ⟨S, ZS, f, iS, g, hSaff, hpb, hsm, hsm0, hne⟩ :=
      wc_smooth_cutout_transversal_slice K (W.ι ≫ pY) n r (i ∣_ W) h hrn hcut zK hzK
    obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists f (ℓ ^ k)
    obtain ⟨DS⟩ := wc_et_zmod_pull_data_exists iS (ℓ ^ k)
    obtain ⟨γf, hγf, -⟩ := wc_et_closed_supp_base_change (i ∣_ W) f iS g hpb DW Df DS
    have hcutS := wc_et_cutout_base_change (i ∣_ W) h f iS g hcut hSaff hpb
    have hgoodW : wcEtGoodChart K (W.ι ≫ pY) (i ∣_ W) r h := ⟨n, hrn, hsmW, hsmZW, hcut⟩
    have hgoodS : wcEtGoodChart K (f ≫ W.ι ≫ pY) iS r (fun j => f.appTop.hom (h j)) :=
      ⟨r, le_rfl, hsm, by rw [Nat.sub_self]; exact hsm0, hcutS⟩
    have hNatS := hNat (W.ι ≫ pY) (f ≫ W.ι ≫ pY) f rfl (i ∣_ W) iS g hpb DW Df DS γf hγf r h
      hgoodW hgoodS
    have hPtS := hPt (f ≫ W.ι ≫ pY) iS DS r (fun j => f.appTop.hom (h j)) hsm hsm0 hcutS hne
    intro h0
    apply hPtS
    have key : ℓ ^ (k - 1) • T (f ≫ W.ι ≫ pY) iS DS r (fun j => f.appTop.hom (h j)) =
        wcEtSuppRestr DW Df DS γf (2 * r) (wcEtSuppRestr D EW DW γ (2 * r) (ℓ ^ (k - 1) • θ)) := by
      rw [map_nsmul, map_nsmul]
      exact congrArg (fun x => ℓ ^ (k - 1) • x)
        ((congrArg (wcEtSuppRestr DW Df DS γf (2 * r)) hθW).trans hNatS).symm
    rw [key, h0, map_zero, map_zero]

  obtain ⟨Ψ, hΨ⟩ := wc_et_proet_free_coker_supp_ext_inj i O hO (ℓ ^ k) hNpos D (2 * r)
  have hx1 : ¬ ℓ ^ (k - 1) • Ψ θ = 0 := by
    rw [← map_nsmul]
    intro h0
    exact hθne (hΨ (h0.trans (map_zero Ψ).symm))
  have hx2 : ℓ ^ (k - 1 + 1) • Ψ θ = 0 := by
    rw [Nat.sub_add_cancel hk]
    exact htors _

  have hord := addOrderOf_eq_prime_pow hx1 hx2
  haveI := hfin
  calc ℓ ^ k = ℓ ^ (k - 1 + 1) := by rw [Nat.sub_add_cancel hk]
    _ = addOrderOf (Ψ θ) := hord.symm
    _ ≤ _ := addOrderOf_le_card

theorem wc_smooth_pair_qcsep_int_supp_red_surj (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ θ1 : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r),
      ∃ θ : Abelian.Ext (wcIntSuppObj Di) (wcIntUnit Y ℓ) (2 * r),
        θ.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
          (add_zero _) = θ1 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  intro θ1
  have hℓ2 : 2 ≤ ℓ := (Fact.out : ℓ.Prime).two_le
  have hℓpos : 0 < ℓ := by omega
  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hO : (O : Set Y) = (Set.range i)ᶜ := rfl

  obtain ⟨hf1', hle1'⟩ := wc_smooth_pair_qcsep_local_zmod_codim_card_le K pY n m r hmr i ℓ hℓ O hO
  obtain ⟨E1⟩ := wc_closed_int_supp_tors_ext_equiv i ℓ Di hDi O hO 1 (2 * r) le_rfl
  have hfin1 : Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) :=
    Finite.of_equiv _ E1.symm
  have hle1 : Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) ≤ ℓ := by
    rw [Nat.card_congr E1]; exact hle1'
  have hge : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) := by
    intro k hk hf
    obtain ⟨Ek⟩ := wc_closed_int_supp_tors_ext_equiv i ℓ Di hDi O hO k (2 * r) hk
    rw [Nat.card_congr Ek]
    exact wc_smooth_pair_qcsep_local_zmod_codim_card_ge K pY n m r hmr i ℓ hℓ O hO k hk
      (Finite.of_equiv _ Ek)

  have hmono : ∀ k : ℕ, Mono ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) := by
    intro k
    have hN : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
    have hc : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hN
    have key : ∀ {T : Type u} [TopologicalSpace T] (a b : C(T, ULift.{u+1} ℤ_[ℓ])),
        (ℓ ^ k : ℕ) • a = (ℓ ^ k : ℕ) • b → a = b := by
      intro T _ a b h
      ext t
      have h1 : (ℓ ^ k : ℕ) • (a t).down = (ℓ ^ k : ℕ) • (b t).down :=
        congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul, nsmul_eq_mul] at h1
      exact mul_left_cancel₀ hc h1
    apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf Y ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply PresheafOfModules.mono_of_injective
    intro X x y hxy
    have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf Y ℓ)).obj
        (wcIntUnit Y ℓ))).app X = (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    rw [e] at hxy
    simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply] at hxy
    exact key (T := ↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj (Opposite.unop X))) x y hxy

  have tors : ∀ (U : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) (nn : ℕ → (U ⟶ U)),
      (∀ k, Mono (nn k)) → (∀ a b, nn a ≫ nn b = nn (a + b)) → ∀ k : ℕ,
      ∃ (ι : Limits.cokernel (nn 1) ⟶ Limits.cokernel (nn (k + 1)))
        (t₀ : Limits.cokernel (nn (k + 1)) ⟶ Limits.cokernel (nn k)) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π (nn (k + 1)) ≫ t₀ = Limits.cokernel.π (nn k) ∧
        Limits.cokernel.π (nn 1) ≫ ι = nn k ≫ Limits.cokernel.π (nn (k + 1)) ∧
          (ShortComplex.mk ι t₀ w).ShortExact := by
    intro U nn hmono hnn k
    have E1 : nn (k + 1) ≫ Limits.cokernel.π (nn k) = 0 := by
      rw [show k + 1 = 1 + k by omega, ← hnn, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have E2 : nn 1 ≫ (nn k ≫ Limits.cokernel.π (nn (k + 1))) = 0 := by
      rw [← Category.assoc, hnn, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
    obtain ⟨t₀, F1⟩ : ∃ t₀ : Limits.cokernel (nn (k + 1)) ⟶ Limits.cokernel (nn k),
        Limits.cokernel.π (nn (k + 1)) ≫ t₀ = Limits.cokernel.π (nn k) :=
      ⟨Limits.cokernel.desc _ _ E1, Limits.cokernel.π_desc _ _ _⟩
    obtain ⟨ι, F2⟩ : ∃ ι : Limits.cokernel (nn 1) ⟶ Limits.cokernel (nn (k + 1)),
        Limits.cokernel.π (nn 1) ≫ ι = nn k ≫ Limits.cokernel.π (nn (k + 1)) :=
      ⟨Limits.cokernel.desc _ _ E2, Limits.cokernel.π_desc _ _ _⟩
    have F3 : ι ≫ t₀ = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (nn 1)), Limits.comp_zero, reassoc_of% F2, F1,
        Limits.cokernel.condition]
    haveI : Epi t₀ := epi_of_epi_fac F1
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π (nn 1)) g
      have h1 : (y ≫ nn k) ≫ Limits.cokernel.π (nn (k + 1)) = 0 := by
        simp only [Category.assoc]
        rw [← F2, ← reassoc_of% hy, hg, Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (nn (k + 1))).exact_up_to_refinements (y ≫ nn k) h1
      have hz' : π' ≫ y ≫ nn k = z ≫ nn (k + 1) := hz
      haveI := hπ
      haveI := hπ'
      haveI := hmono k
      have h2 : π' ≫ y = z ≫ nn 1 := by
        rw [← cancel_mono (nn k)]
        simp only [Category.assoc]
        rw [hnn, show 1 + k = k + 1 by omega]
        exact hz'
      have h3 : (π' ≫ π) ≫ g = 0 := by
        simp only [Category.assoc]
        rw [hy, reassoc_of% h2, Limits.cokernel.condition, Limits.comp_zero]
      exact (cancel_epi (π' ≫ π)).1 (h3.trans Limits.comp_zero.symm)
    have hexact : (ShortComplex.mk ι t₀ F3).Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ t₀ = 0 := hx₂
      obtain ⟨A', π, hπ, y, hy⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (nn (k + 1))) x₂
      have h1 : y ≫ Limits.cokernel.π (nn k) = 0 := by
        rw [← F1, ← reassoc_of% hy, hx₂', Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (nn k)).exact_up_to_refinements y h1
      have hz' : π' ≫ y = z ≫ nn k := hz
      haveI := hπ
      haveI := hπ'
      refine ⟨A'', π' ≫ π, inferInstance, z ≫ Limits.cokernel.π (nn 1), ?_⟩
      show (π' ≫ π) ≫ x₂ = (z ≫ Limits.cokernel.π (nn 1)) ≫ ι
      simp only [Category.assoc]
      rw [F2, hy, reassoc_of% hz']
    exact ⟨ι, t₀, F3, F1, F2, ShortComplex.ShortExact.mk' hexact inferInstance inferInstance⟩
  have hnn : ∀ a b : ℕ, ((ℓ ^ a : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫
      ((ℓ ^ b : ℕ) • 𝟙 (wcIntUnit Y ℓ)) =
        ((ℓ ^ (a + b) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) := by
    intro a b
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.add_comm b a]
  have hk : ∀ k : ℕ, ∃ (ι : wcIntTors Y ℓ 1 ⟶ wcIntTors Y ℓ (k + 1))
      (t : wcIntTors Y ℓ (k + 1) ⟶ wcIntTors Y ℓ k) (w : ι ≫ t = 0),
      Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t =
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ∧
      Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ ι =
        ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ∧
      (ShortComplex.mk ι t w).ShortExact :=
    fun k => tors (wcIntUnit Y ℓ) (fun k => (ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) hmono hnn k
  choose ι t w F1 F2 hS using hk

  have hker : ∀ (k : ℕ) (y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)),
      y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) = 0 →
      ∃ a : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r),
        a.comp (Abelian.Ext.mk₀ (ι k)) (add_zero (2 * r)) = y := by
    intro k y hy
    exact Abelian.Ext.covariant_sequence_exact₂ (wcIntSuppObj Di) (hS k) y hy
  have hsubc : ∀ (k : ℕ) (y y' : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)),
      (y - y').comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) =
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) -
          y'.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) := by
    intro k y y'
    rw [eq_sub_iff_add_eq, ← Abelian.Ext.add_comp, sub_add_cancel]

  have hA : ∀ k : ℕ, Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) →
      Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)) ∧
      Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)) ≤
        Nat.card (Set.range (fun y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r) =>
          y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)))) * ℓ := by
    intro k hfk
    haveI := hfk
    haveI := hfin1
    let T := fun y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r) =>
      y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))
    let Φ : Set.range T × Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r) →
        Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r) :=
      fun q => Classical.choose q.1.2 + q.2.comp (Abelian.Ext.mk₀ (ι k)) (add_zero (2 * r))
    have hΦ : Function.Surjective Φ := by
      intro b
      have hTs : T (Classical.choose (⟨T b, b, rfl⟩ : Set.range T).2) = T b :=
        Classical.choose_spec (⟨T b, b, rfl⟩ : Set.range T).2
      have h0 : (b - Classical.choose (⟨T b, b, rfl⟩ : Set.range T).2).comp
          (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) = 0 := by
        rw [hsubc]
        exact sub_eq_zero.mpr hTs.symm
      obtain ⟨a, ha⟩ := hker k _ h0
      refine ⟨(⟨T b, b, rfl⟩, a), ?_⟩
      show Classical.choose (⟨T b, b, rfl⟩ : Set.range T).2 +
        a.comp (Abelian.Ext.mk₀ (ι k)) (add_zero (2 * r)) = b
      rw [ha]
      abel
    haveI : Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)) :=
      Finite.of_surjective Φ hΦ
    refine ⟨inferInstance, ?_⟩
    calc Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r))
        ≤ Nat.card (Set.range T × Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) :=
          Nat.card_le_card_of_surjective Φ hΦ
      _ = Nat.card (Set.range T) *
            Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) := Nat.card_prod _ _
      _ ≤ Nat.card (Set.range T) * ℓ := Nat.mul_le_mul_left _ hle1

  have hcard : ∀ k : ℕ, 1 ≤ k →
      Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) ∧
      Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) ≤ ℓ ^ k := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base => exact ⟨hfin1, by rw [pow_one]; exact hle1⟩
    | succ k hk ih =>
      obtain ⟨hfk, hck⟩ := ih
      haveI := hfk
      obtain ⟨hfk1, hck1⟩ := hA k hfk
      refine ⟨hfk1, ?_⟩
      have hR := Nat.card_le_card_of_injective
        (Subtype.val : Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))) →
          Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) Subtype.val_injective
      calc _ ≤ _ := hck1
        _ ≤ ℓ ^ k * ℓ := Nat.mul_le_mul_right _ (hR.trans hck)
        _ = ℓ ^ (k + 1) := (pow_succ ℓ k).symm

  have hsurj : ∀ k : ℕ, 1 ≤ k →
      ∀ x : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r),
      ∃ y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r),
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) = x := by
    intro k hk x
    obtain ⟨hfk, hck⟩ := hcard k hk
    haveI := hfk
    obtain ⟨hfk1, hck1⟩ := hA k hfk
    have hg := hge (k + 1) (by omega) hfk1
    have hR := Nat.card_le_card_of_injective
      (Subtype.val : Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))) →
        Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r))
      Subtype.val_injective
    have h1 : ℓ ^ k * ℓ ≤ Nat.card (Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))))
          * ℓ := by
      rw [← pow_succ]; exact hg.trans hck1
    have h2 := Nat.le_of_mul_le_mul_right h1 hℓpos
    have hinj : Function.Injective
      (Subtype.val : Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))) →
        Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) := Subtype.val_injective
    have hbij := hinj.bijective_of_nat_card_le (hck.trans h2)
    obtain ⟨⟨z, hz⟩, hzx⟩ := hbij.2 x
    obtain ⟨y, hy⟩ := hz
    exact ⟨y, hy.trans hzx⟩

  have hlift : ∀ (mm : ℕ), 1 ≤ mm →
      ∀ a : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ mm) (2 * r),
      ∃ a' : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (mm + 1)) (2 * r),
        ∀ t' : wcIntTors Y ℓ (mm + 1) ⟶ wcIntTors Y ℓ mm,
          Limits.cokernel.π ((ℓ ^ (mm + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t' =
            Limits.cokernel.π ((ℓ ^ mm : ℕ) • 𝟙 (wcIntUnit Y ℓ)) →
          a'.comp (Abelian.Ext.mk₀ t') (add_zero (2 * r)) = a := by
    intro mm hmm a
    obtain ⟨a', ha'⟩ := hsurj mm hmm a
    refine ⟨a', fun t' ht' => ?_⟩
    have htt : t' = t mm := (cancel_epi _).1 (ht'.trans (F1 mm).symm)
    rw [htt]
    exact ha'
  choose f hf using hlift

  let a : ∀ k : ℕ, Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (1 + k)) (2 * r) :=
    fun k => Nat.rec (motive := fun k =>
      Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (1 + k)) (2 * r))
      θ1 (fun k ak => f (1 + k) (by omega) ak) k
  have ha : ∀ (k : ℕ) (t' : wcIntTors Y ℓ (1 + k + 1) ⟶ wcIntTors Y ℓ (1 + k)),
      Limits.cokernel.π ((ℓ ^ (1 + k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t' =
        Limits.cokernel.π ((ℓ ^ (1 + k) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) →
      (a (k + 1)).comp (Abelian.Ext.mk₀ t') (add_zero (2 * r)) = a k := by
    intro k t' ht'
    exact hf (1 + k) (by omega) (a k) t' ht'
  obtain ⟨θz, hθz⟩ := wc_int_ext_tower_milnor Y ℓ (wcIntSuppObj Di) (2 * r) 1 a ha
  exact ⟨θz, hθz 0⟩

theorem wc_smooth_pair_qcsep_zmod_thom_strict_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∃ θ1 : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r),
      ∀ θ : Abelian.Ext (wcIntSuppObj Di) (wcIntUnit Y ℓ) (2 * r),
        θ.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
          (add_zero _) = θ1 →
      ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec R ⟶ Y), WeaklyEtale k → k (IsLocalRing.closedPoint R) ∈ Set.range i →
        ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k →
        ∀ (DT : wcHMPullData iT ℓ), wcHMPullCanonical DT → Epi (wcSuppUnitMap DT) →
        ∀ (DΛ : wcIntPullData k ℓ) (_ : wcIntPullCanonical DΛ)
          (γΛ : wcIntSuppObj DT ⟶ DΛ.Φ.obj (wcIntSuppObj Di)),
          wcIntSuppπ DT ≫ γΛ = DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di) →
          letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
          ((Abelian.Ext.mk₀ γΛ).comp (wcIntSuppPullExt Di DΛ (2 * r) θ) (zero_add _)).comp
            (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit (Spec R) ℓ))))
            (add_zero _) ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated pY
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth n pY
  haveI : LocallyOfFiniteType pY := inferInstance
  have hrn : r ≤ n := by omega
  haveI : SmoothOfRelativeDimension (n - r) (i ≫ pY) := by
    have e : n - r = m := by omega
    rw [e]; infer_instance

  obtain ⟨Tt, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom K ℓ hℓ
  obtain ⟨De⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨θe, hθe⟩ := wc_et_thom_class_glue K ℓ hℓ Tt hGL hNat Y Z pY n r i hrn De

  obtain ⟨Θ, hsurj, hnat⟩ := wc_int_supp_zmod_et_transport ℓ (2 * r)
  obtain ⟨θ1, hθ1⟩ := hsurj i Di hDi De θe
  refine ⟨θ1, ?_⟩
  intro θ hθ R _ _ k hk hz T iT g hP DT hDT hepi DΛ hDΛ γΛ hγΛ
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
  intro h0

  obtain ⟨ν, hν, hcomp⟩ := wc_int_red_supp_pull_compat Di DΛ (2 * r)
  have hred : wcIntSuppRedRestr Di DΛ γΛ ν (2 * r) θ1 = 0 := by
    have h1 := hcomp _ γΛ θ
    rw [hθ] at h1
    rw [← h1]
    exact h0
  obtain ⟨Ek⟩ := wc_et_zmod_pull_data_exists k ℓ
  obtain ⟨DTe⟩ := wc_et_zmod_pull_data_exists iT ℓ
  obtain ⟨γe, hγe, -⟩ := wc_et_closed_supp_base_change i k iT g hP De Ek DTe
  have E0 : wcEtSuppRestr De Ek DTe γe (2 * r) θe = 0 := by
    have h1 := hnat i k iT g hP inferInstance inferInstance inferInstance inferInstance
      Di hDi DT hDT hepi DΛ hDΛ γΛ hγΛ ν hν De DTe Ek γe hγe θ1
    rw [hred, map_zero, hθ1] at h1
    exact h1.symm

  obtain ⟨W, v, w, hv, hWa, hwv, hkill⟩ :=
    wc_et_supp_strict_local_limit_kill i ℓ R k hk T iT g hP De DTe Ek γe hγe (2 * r) θe E0
  haveI : Etale v := hv
  haveI : IsAffine W := hWa
  have hZ : IsPullback (Limits.pullback.fst i v) (Limits.pullback.snd i v) i v :=
    IsPullback.of_hasPullback i v
  obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i v) ℓ
  obtain ⟨Ev⟩ := wc_et_zmod_pull_data_exists v ℓ
  obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i v (Limits.pullback.snd i v)
    (Limits.pullback.fst i v) hZ De Ev DW
  have hW0 := hkill _ (Limits.pullback.snd i v) (Limits.pullback.fst i v) hZ DW Ev γW hγW
  haveI : SmoothOfRelativeDimension n (v ≫ pY) := by
    have h : SmoothOfRelativeDimension (0 + n) (v ≫ pY) := inferInstance
    simpa using h
  have e : Limits.pullback.snd i v ≫ v ≫ pY = Limits.pullback.fst i v ≫ i ≫ pY := by
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc]
  haveI : SmoothOfRelativeDimension (n - r) (Limits.pullback.snd i v ≫ v ≫ pY) := by
    rw [e]
    have h : SmoothOfRelativeDimension (0 + (n - r)) (Limits.pullback.fst i v ≫ i ≫ pY) :=
      inferInstance
    simpa using h
  have hThom := wc_et_thom_class_restrict K ℓ hℓ Tt hGL hNat pY (v ≫ pY) v rfl n n r i
    (Limits.pullback.snd i v) hrn hrn (Limits.pullback.fst i v) hZ De Ev DW γW hγW θe hθe
  obtain ⟨z0, hz0⟩ := hz
  obtain ⟨t, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := i) (g := v) z0
    (w (IsLocalRing.closedPoint R)) (by
      rw [hz0, ← hwv]
      first
        | rfl
        | exact Scheme.Hom.comp_apply _ _ _
        | simp)
  obtain ⟨zK, hzK⟩ := wc_alg_closed_lft_section K (Limits.pullback i v)
    (Limits.pullback.snd i v ≫ v ≫ pY) ⟨t⟩
  exact wc_et_thom_ne_zero_of_point K ℓ hℓ Tt hGL hNat hPt W (Limits.pullback i v) (v ≫ pY) n r
    (Limits.pullback.snd i v) hrn DW _ hThom zK hzK hW0

theorem wc_smooth_pair_qcsep_ladic_thom_strict_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    ∃ τ : wcSuppExt Di (2 * r),
      ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec R ⟶ Y), WeaklyEtale k → k (IsLocalRing.closedPoint R) ∈ Set.range i →
        ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k →
        ∀ (Dk : wcHMPullData k ℓ) (_ : wcHMPullCanonical Dk)
          (DT : wcHMPullData iT ℓ) (_ : wcHMPullCanonical DT), Epi (wcSuppUnitMap DT) →
        ∀ (γ : wcSuppObj DT ⟶ Dk.Φ.obj (wcSuppObj Di)),
          wcSuppUnitMap DT ≫ γ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap Di) →
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Di Dk (2 * r) τ) (zero_add _) ≠ 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  obtain ⟨ratY, hrat⟩ := wc_smooth_pair_qcsep_int_supp_rat_restrict K pY n m r hmr i ℓ hℓ Di hDi
  obtain ⟨θ1, hθ1⟩ := wc_smooth_pair_qcsep_zmod_thom_strict_nonzero K pY n m r hmr i ℓ hℓ Di hDi
  obtain ⟨θ, hθ⟩ := wc_smooth_pair_qcsep_int_supp_red_surj K pY n m r hmr i ℓ hℓ Di hDi θ1
  refine ⟨ratY θ, ?_⟩
  intro R _ _ k hk hz T iT g hP Dk hDk DT hDT hepi γ hγ
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
