          rfl
        have e2 : (SheafOfModules.forget (wcIntRingSheaf S ℓ)).map
            ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) = (ℓ ^ k : ℕ) • 𝟙 _ := by
