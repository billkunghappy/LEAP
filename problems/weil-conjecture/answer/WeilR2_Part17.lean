        exact Limits.comp_zero
      exact (shiftFunctor (DerivedCategory 𝒞W) (1 : ℤ)).map_injective
        (h1.trans (Functor.map_zero _ _ _).symm)

    obtain ⟨θ, hθ⟩ : ∃ θ : ((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦M⟧)⟦(1 : ℤ)⟧ ⟶
        (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦s⟧, IsIso θ :=
      ⟨(shiftFunctorAdd' (DerivedCategory 𝒞W) M 1 s hs).inv.app _, inferInstance⟩
    haveI := hθ
    have hβ : ∀ a a' : Kp ⟶ (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦M⟧,
        δ ≫ a⟦(1 : ℤ)⟧' ≫ θ = δ ≫ a'⟦(1 : ℤ)⟧' ≫ θ → a = a' := by
      intro a a' h
      have h' : δ ≫ a⟦(1 : ℤ)⟧' = δ ≫ a'⟦(1 : ℤ)⟧' := by
