theorem wc_pmn_nbr_hyperbolic_swap (Ac : Type u) [CommRing Ac] (π : Ac) (n : ℕ)
    (hnm : n = 2 * 1) (c P : Matrix (Fin n) (Fin n) Ac) (hP : IsUnit P.det)
    (D' : MvPolynomial (Fin n) Ac) (hD0 : MvPolynomial.constantCoeff D' = 0)
    (hid : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin 1, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D') :
    ∃ (P' : Matrix (Fin n) (Fin n) Ac) (D'' : MvPolynomial (Fin n) Ac), IsUnit P'.det ∧
      MvPolynomial.constantCoeff D'' = 0 ∧
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P' p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P' q b) * MvPolynomial.X b)) =
        ∑ j : Fin 1, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D'' ∧
      ∀ d : Fin n, P'⁻¹ (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) d =
        P⁻¹ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n) d :=
by
  classical
  obtain ⟨σ, hσ⟩ : ∃ σ : Equiv.Perm (Fin n), σ = Equiv.swap
      (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n) :=
    ⟨_, rfl⟩
  have hσe : σ (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) =
      (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n) := by
    rw [hσ]; exact Equiv.swap_apply_left _ _
  have hσo : σ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n) =
      (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) := by
    rw [hσ]; exact Equiv.swap_apply_right _ _
  have hσσ : ∀ a, σ (σ a) = a := by
    intro a; rw [hσ]; exact Equiv.swap_apply_self _ _ _
  refine ⟨P.submatrix id σ, MvPolynomial.rename σ D', ?_, ?_, ?_, ?_⟩
  · rw [Matrix.det_permute']
    exact ((Equiv.Perm.sign σ).isUnit.map (Int.castRingHom Ac)).mul hP
  · rw [MvPolynomial.constantCoeff_rename, hD0]
  · have hin : ∀ p, (∑ a, MvPolynomial.C (P.submatrix id σ p a) * MvPolynomial.X a :
        MvPolynomial (Fin n) Ac) = ∑ a, MvPolynomial.C (P p a) * MvPolynomial.X (σ a) := by
      intro p
      rw [← Equiv.sum_comp σ (fun a => MvPolynomial.C (P p a) * MvPolynomial.X (σ a))]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      simp only [Matrix.submatrix_apply, id, hσσ]
    have h := congrArg (MvPolynomial.rename σ) hid
    simp only [map_add, map_sum, map_mul, MvPolynomial.rename_C, MvPolynomial.rename_X,
      Fin.sum_univ_one] at h
    rw [hσe, hσo] at h
    simp only [hin, Fin.sum_univ_one]
    rw [h]
    ring
  · intro d
    rw [show P.submatrix id σ = P.submatrix (Equiv.refl (Fin n)) σ from rfl,
      Matrix.inv_submatrix_equiv, Matrix.submatrix_apply, hσe]
    rfl

theorem wc_pmn_nbr_slice_explicit (Ac : Type u) [CommRing Ac] [IsLocalRing Ac] (π : Ac)
    (hπ : IsLocalRing.maximalIdeal Ac = Ideal.span {π})
    (K : Type u) [Field K] (ι : K →+* Ac)
    (hι : Function.Bijective ((IsLocalRing.residue Ac).comp ι))
    (m n : ℕ) (hnm : n = 2 * m) (c P : Matrix (Fin n) (Fin n) Ac) (hP : IsUnit P.det)
    (D' : MvPolynomial (Fin n) Ac) (hD0 : MvPolynomial.constantCoeff D' = 0)
    (hid : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (B₀ : Type u) [CommRing B₀] [IsLocalRing B₀]
    (β : wcQuadModelRing Ac n π c →+* B₀) (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (ht : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B₀)
    (S : Fin n → wcQuadModelRing Ac n π c)
    (hS : ∀ i, S i = Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c)
      (∑ d, MvPolynomial.C (P⁻¹ i d) * MvPolynomial.X d)) :
    ∃ u : B₀, IsUnit u ∧
      β (algebraMap Ac (wcQuadModelRing Ac n π c) π) * u =
        ∑ j : Fin m, β (S ⟨2 * j.val, by omega⟩) * β (S ⟨2 * j.val + 1, by omega⟩) ∧
      (∀ i : Fin n, β (S i) ∈ IsLocalRing.maximalIdeal B₀) ∧
      Ideal.map β (Ideal.span (Set.range fun j : Fin m => S ⟨2 * j.val, by omega⟩)) ≠ ⊤ ∧
      WeaklyEtale (Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (Ideal.map β (Ideal.span (Set.range fun j : Fin m =>
            S ⟨2 * j.val, by omega⟩)))).comp
          (MvPolynomial.eval₂Hom ((β.comp (algebraMap Ac (wcQuadModelRing Ac n π c))).comp ι)
            (fun j : Fin m => β (S ⟨2 * j.val + 1, by omega⟩)))))) :=
by
  classical

  have hmat : ∀ {R' : Type u} [CommRing R'] (ρ : Ac →+* R') (M N : Matrix (Fin n) (Fin n) Ac)
      (v : Fin n → R') (i : Fin n),
      ∑ d, ρ (M i d) * ∑ a, ρ (N d a) * v a = ∑ a, ρ ((M * N) i a) * v a := by
    intro R' _ ρ M N v i
    simp only [Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun d _ => ?_))
    rw [map_mul]; ring
  have hone : ∀ {R' : Type u} [CommRing R'] (ρ : Ac →+* R') (v : Fin n → R') (i : Fin n),
      ∑ a, ρ ((1 : Matrix (Fin n) (Fin n) Ac) i a) * v a = v i := by
    intro R' _ ρ v i
    rw [Finset.sum_eq_single i]
    · rw [Matrix.one_apply_eq, map_one, one_mul]
    · intro a _ ha
      rw [Matrix.one_apply_ne' ha, map_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ i) h
  have hPP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
  have hPP' : P⁻¹ * P = 1 := Matrix.nonsing_inv_mul P hP
  have hAlg : ∀ a : Ac, algebraMap Ac (wcQuadModelRing Ac n π c) a =
      Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.C a) := fun _ => rfl

  have hexp : ∀ b, Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.X b) =
      ∑ a, algebraMap Ac (wcQuadModelRing Ac n π c) (P b a) * S a := by
    intro b
    have h1 := hmat MvPolynomial.C P P⁻¹ MvPolynomial.X b
    rw [hPP, hone] at h1
    rw [← h1, map_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [map_mul, hS, hAlg]

  have hφlin : ∀ p, MvPolynomial.aeval S (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) =
      Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c) (MvPolynomial.X p) := by
    intro p
    rw [hexp p, map_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
  have hF : Ideal.Quotient.mk (wcQuadModelIdeal Ac n π c)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
      algebraMap Ac (wcQuadModelRing Ac n π c) π := by
    rw [hAlg, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hrel0 : algebraMap Ac (wcQuadModelRing Ac n π c) π * (1 - MvPolynomial.aeval S D') =
      ∑ j : Fin m, S ⟨2 * j.val, by omega⟩ * S ⟨2 * j.val + 1, by omega⟩ := by
    have h1 := congrArg (MvPolynomial.aeval S) hid
    have hL : MvPolynomial.aeval S (∑ p, ∑ q, MvPolynomial.C (c p q) *
        (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
        (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        algebraMap Ac (wcQuadModelRing Ac n π c) π := by
      rw [← hF]
      simp only [map_sum]
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
      simp only [map_mul]
      rw [hφlin, hφlin, MvPolynomial.aeval_C, hAlg]
    rw [hL] at h1
    simp only [map_add, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C] at h1
    linear_combination h1

  have hSm : ∀ a, β (S a) ∈ IsLocalRing.maximalIdeal B₀ := by
    intro a
    rw [hS]
    simp only [map_sum, map_mul]
    exact Ideal.sum_mem _ (fun d _ => Ideal.mul_mem_left _ _ (ht d))

  have hevalm : ∀ q : MvPolynomial (Fin n) Ac,
      β (MvPolynomial.aeval S q) -
        β (algebraMap Ac (wcQuadModelRing Ac n π c) (MvPolynomial.constantCoeff q)) ∈
        IsLocalRing.maximalIdeal B₀ := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have h := Ideal.add_mem _ hp hq
      convert h using 1
      simp only [map_add]
      ring
    | mul_X p i _ =>
      simp only [map_mul, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, mul_zero,
        map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hSm i)
  have hDm : β (MvPolynomial.aeval S D') ∈ IsLocalRing.maximalIdeal B₀ := by
    have h := hevalm D'
    rwa [hD0, map_zero, map_zero, sub_zero] at h
  obtain ⟨U, hUdef⟩ : ∃ U : wcQuadModelRing Ac n π c, U = 1 - MvPolynomial.aeval S D' :=
    ⟨_, rfl⟩
  have hU : IsUnit (β U) := by
    rw [hUdef, map_sub, map_one]
    exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
      ((IsLocalRing.mem_maximalIdeal _).mp hDm)
  have hrel : algebraMap Ac (wcQuadModelRing Ac n π c) π * U =
      ∑ j : Fin m, S ⟨2 * j.val, by omega⟩ * S ⟨2 * j.val + 1, by omega⟩ := by
    rw [hUdef]; exact hrel0

  obtain ⟨Ĩ, hĨ⟩ : ∃ Ĩ : Ideal (wcQuadModelRing Ac n π c),
      Ĩ = Ideal.span (Set.range fun j : Fin m => S ⟨2 * j.val, by omega⟩) := ⟨_, rfl⟩
  have hSĨ : ∀ j : Fin m, S ⟨2 * j.val, by omega⟩ ∈ Ĩ := by
    intro j
    rw [hĨ]
    exact Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal B₀, I = Ideal.map β Ĩ := ⟨_, rfl⟩
  have hrelB : β (algebraMap Ac (wcQuadModelRing Ac n π c) π) * β U =
      ∑ j : Fin m, β (S ⟨2 * j.val, by omega⟩) * β (S ⟨2 * j.val + 1, by omega⟩) := by
    have h := congrArg β hrel
    simpa only [map_mul, map_sum] using h
  rw [← hĨ, ← hIdef]
  refine ⟨β U, hU, hrelB, hSm, ?_, ?_⟩
  · intro hI
    have hle : I ≤ IsLocalRing.maximalIdeal B₀ := by
      rw [hIdef, Ideal.map_le_iff_le_comap, hĨ, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hSm _
    rw [hI] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B₀).ne_top (top_le_iff.mp hle)
  · subst hIdef

    have hbc : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S) (J : Ideal R),
        WeaklyEtale (Spec.map (CommRingCat.ofHom f)) →
        WeaklyEtale (Spec.map (CommRingCat.ofHom
          (Ideal.quotientMap (J.map f) f Ideal.le_comap_map))) := by
      intro R S _ _ f J hf
      have hcomm : CommRingCat.ofHom f ≫ CommRingCat.ofHom (Ideal.Quotient.mk (J.map f)) =
          CommRingCat.ofHom (Ideal.Quotient.mk J) ≫
            CommRingCat.ofHom (Ideal.quotientMap (J.map f) f Ideal.le_comap_map) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, Ideal.quotientMap_comp_mk]
      have hpo : IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom (Ideal.Quotient.mk J))
          (CommRingCat.ofHom (Ideal.Quotient.mk (J.map f)))
          (CommRingCat.ofHom (Ideal.quotientMap (J.map f) f Ideal.le_comap_map)) := by
        refine IsPushout.of_isColimit' (CommSq.mk hcomm) ?_
        have hker : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom f)
            (CommRingCat.ofHom (Ideal.Quotient.mk J))), ∀ r : R,
            s.inl.hom (f r) = s.inr.hom (Ideal.Quotient.mk J r) := by
          intro s r
          have hc := congrArg (fun φ => CommRingCat.Hom.hom φ r) s.condition
          simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using hc
        have hH : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom f)
            (CommRingCat.ofHom (Ideal.Quotient.mk J))), ∀ a ∈ J.map f, s.inl.hom a = 0 := by
          intro s a ha
          have hle : J.map f ≤ RingHom.ker s.inl.hom := by
            rw [Ideal.map_le_iff_le_comap]
            intro r hr
            rw [Ideal.mem_comap, RingHom.mem_ker, hker s r,
              Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]
          exact hle ha
        refine Limits.PushoutCocone.IsColimit.mk _
          (fun s => CommRingCat.ofHom (Ideal.Quotient.lift (J.map f) s.inl.hom (hH s)))
          (fun s => ?_) (fun s => ?_) (fun s m h1 _ => ?_)
        · apply CommRingCat.hom_ext
          rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
          exact Ideal.Quotient.lift_comp_mk _ _ _
        · apply CommRingCat.hom_ext
          rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
          apply Ideal.Quotient.ringHom_ext
          refine RingHom.ext (fun r => ?_)
          rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, Ideal.quotientMap_mk,
            Ideal.Quotient.lift_mk]
          exact hker s r
        · apply CommRingCat.hom_ext
          rw [CommRingCat.hom_ofHom]
          apply Ideal.Quotient.ringHom_ext
          have h2 := congrArg CommRingCat.Hom.hom h1
          rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h2
          rw [h2, Ideal.Quotient.lift_comp_mk]
      exact MorphismProperty.of_isPullback (P := @WeaklyEtale)
        (isPullback_SpecMap_of_isPushout _ _ _ _ hpo) hf
    obtain ⟨ψbar, hψbardef⟩ : ∃ ψbar : wcQuadModelRing Ac n π c ⧸ Ĩ →+* B₀ ⧸ Ideal.map β Ĩ,
        ψbar = Ideal.quotientMap (Ideal.map β Ĩ) β Ideal.le_comap_map := ⟨_, rfl⟩
    have hψbar : WeaklyEtale (Spec.map (CommRingCat.ofHom (R := wcQuadModelRing Ac n π c ⧸ Ĩ)
        (S := B₀ ⧸ Ideal.map β Ĩ) ψbar)) := by
      rw [hψbardef]; exact hbc _ _ β Ĩ hβ
    have hψbarmk : ∀ q, ψbar (Ideal.Quotient.mk Ĩ q) = Ideal.Quotient.mk (Ideal.map β Ĩ) (β q) := by
      intro q; rw [hψbardef, Ideal.quotientMap_mk]

    have hloc : ∀ (R : Type u) [CommRing R] (x : R), ∃ (L : Type u) (_ : CommRing L)
        (loc : R →+* L), IsUnit (loc x) ∧ IsOpenImmersion (Spec.map (CommRingCat.ofHom loc)) ∧
        (∀ (T : Type u) [CommRing T] (g : R →+* T), IsUnit (g x) →
          ∃ g' : L →+* T, g'.comp loc = g) ∧
        (∀ (T : Type u) [CommRing T] (g₁ g₂ : L →+* T), g₁.comp loc = g₂.comp loc → g₁ = g₂) := by
      intro R _ x
      exact ⟨Localization.Away x, inferInstance, algebraMap R (Localization.Away x),
        IsLocalization.Away.algebraMap_isUnit x, IsOpenImmersion.of_isLocalization x,
        fun T _ g hg => ⟨IsLocalization.Away.lift x hg, IsLocalization.Away.lift_comp x hg⟩,
        fun T _ g₁ g₂ h => IsLocalization.ringHom_ext (Submonoid.powers x) h⟩
    obtain ⟨Ub, hUb⟩ : ∃ Ub : wcQuadModelRing Ac n π c ⧸ Ĩ, Ub = Ideal.Quotient.mk Ĩ U :=
      ⟨_, rfl⟩
    have hψU : IsUnit (ψbar Ub) := by
      rw [hUb, hψbarmk]
      exact hU.map _
    obtain ⟨Lu, _, locU, hlocUunit, hlocu, hliftU, hextU⟩ :=
      hloc (wcQuadModelRing Ac n π c ⧸ Ĩ) Ub
    haveI := hlocu
    obtain ⟨ψu, hψucomp⟩ := hliftU _ ψbar hψU
    have hψuWE : WeaklyEtale (Spec.map (CommRingCat.ofHom ψu)) := by
      haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom ψu) ≫
          Spec.map (CommRingCat.ofHom locU)) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψucomp]
        exact hψbar
      exact WeaklyEtale.of_comp _ (Spec.map (CommRingCat.ofHom locU))

    obtain ⟨θ, hθ⟩ : ∃ θ : wcQuadModelRing Ac n π c →+* Lu,
        θ = locU.comp (Ideal.Quotient.mk Ĩ) := ⟨_, rfl⟩
    have hθa : ∀ q, θ q = locU (Ideal.Quotient.mk Ĩ q) := by
      intro q; rw [hθ, RingHom.comp_apply]
    have hθev : ∀ j : Fin m, θ (S ⟨2 * j.val, by omega⟩) = 0 := by
      intro j
      rw [hθa, Ideal.Quotient.eq_zero_iff_mem.mpr (hSĨ j), map_zero]
    have hθU : IsUnit (θ U) := by
      rw [hθa, ← hUb]; exact hlocUunit
    have hθπ : θ (algebraMap Ac (wcQuadModelRing Ac n π c) π) = 0 := by
      have h := congrArg θ hrel
      simp only [map_mul, map_sum, hθev, zero_mul, Finset.sum_const_zero] at h
      exact (IsUnit.mul_left_eq_zero hθU).mp h

    obtain ⟨κ, hκι, hκres⟩ : ∃ κ : Ac →+* K, (∀ k, κ (ι k) = k) ∧
        ∀ a, IsLocalRing.residue Ac (ι (κ a)) = IsLocalRing.residue Ac a := by
      let e := RingEquiv.ofBijective ((IsLocalRing.residue Ac).comp ι) hι
      refine ⟨e.symm.toRingHom.comp (IsLocalRing.residue Ac), fun k => ?_, fun a => ?_⟩
      · exact e.symm_apply_apply k
      · exact e.apply_symm_apply (IsLocalRing.residue Ac a)
    have hres0 : IsLocalRing.residue Ac π = 0 :=
      (IsLocalRing.residue_eq_zero_iff π).mpr (by rw [hπ]; exact Ideal.mem_span_singleton_self π)
    have hκπ : κ π = 0 := by
      apply hι.1
      simp only [RingHom.comp_apply, hκres, hres0, map_zero]
    have hdec : ∀ a, ∃ r, a - ι (κ a) = r * π := by
      intro a
      have h : a - ι (κ a) ∈ IsLocalRing.maximalIdeal Ac := by
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hκres, sub_self]
      rw [hπ, Ideal.mem_span_singleton'] at h
      obtain ⟨r, hr⟩ := h
      exact ⟨r, hr.symm⟩
    have hθκ : ∀ a, θ (algebraMap Ac (wcQuadModelRing Ac n π c) (ι (κ a))) =
        θ (algebraMap Ac (wcQuadModelRing Ac n π c) a) := by
      intro a
      obtain ⟨r, hr⟩ := hdec a
      have h : θ (algebraMap Ac (wcQuadModelRing Ac n π c) a) -
          θ (algebraMap Ac (wcQuadModelRing Ac n π c) (ι (κ a))) = 0 := by
        rw [← map_sub, ← map_sub, hr, map_mul, map_mul, hθπ, mul_zero]
      exact (sub_eq_zero.mp h).symm

    obtain ⟨z, hz⟩ : ∃ z : Fin n → MvPolynomial (Fin m) K, ∀ i, z i =
        if h : i.val % 2 = 1 then MvPolynomial.X (⟨i.val / 2, by omega⟩ : Fin m) else 0 :=
      ⟨_, fun _ => rfl⟩
    have hzev : ∀ j : Fin m, z ⟨2 * j.val, by omega⟩ = 0 := by
      intro j
      rw [hz]
      split_ifs with h
      · exfalso
        change (2 * j.val) % 2 = 1 at h
        omega
      · rfl
    have hzod : ∀ j : Fin m, z ⟨2 * j.val + 1, by omega⟩ = MvPolynomial.X j := by
      intro j
      rw [hz]
      split_ifs with h
      · congr 1
        apply Fin.ext
        show (2 * j.val + 1) / 2 = j.val
        omega
      · exfalso
        change ¬ (2 * j.val + 1) % 2 = 1 at h
        omega

    obtain ⟨ν, hν1, hν2⟩ : ∃ ν : (wcQuadModelRing Ac n π c ⧸ Ĩ) →+* MvPolynomial (Fin m) K,
        (∀ a, ν (Ideal.Quotient.mk Ĩ (algebraMap Ac _ a)) = MvPolynomial.C (κ a)) ∧
        (∀ i, ν (Ideal.Quotient.mk Ĩ (S i)) = z i) := by
      let ν₀ : MvPolynomial (Fin n) Ac →+* MvPolynomial (Fin m) K :=
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp κ)
          (fun b => ∑ a, MvPolynomial.C (κ (P b a)) * z a)
      have hν₀F : ν₀ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π) = 0 := by
        have h1 := congrArg (MvPolynomial.eval₂Hom (MvPolynomial.C.comp κ) z) hid
        simp only [map_sum, map_mul, map_add, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', RingHom.comp_apply, hzev, hκπ, map_zero, zero_mul,
          Finset.sum_const_zero, zero_add] at h1
        simp only [ν₀, map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', RingHom.comp_apply, hκπ, map_zero, sub_zero]
        exact h1
      have hker : ∀ a ∈ wcQuadModelIdeal Ac n π c, ν₀ a = 0 := by
        intro a ha
        have hle : wcQuadModelIdeal Ac n π c ≤ RingHom.ker ν₀ :=
          (Ideal.span_singleton_le_iff_mem _).mpr (RingHom.mem_ker.mpr hν₀F)
        exact hle ha
      obtain ⟨νQ, hνQ⟩ : ∃ νQ : wcQuadModelRing Ac n π c →+* MvPolynomial (Fin m) K,
          νQ = Ideal.Quotient.lift (wcQuadModelIdeal Ac n π c) ν₀ hker := ⟨_, rfl⟩
      have hνQS : ∀ i, νQ (S i) = z i := by
        intro i
        rw [hνQ, hS, Ideal.Quotient.lift_mk]
        simp only [ν₀, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
          RingHom.comp_apply]
        have h := hmat (MvPolynomial.C.comp κ) P⁻¹ P z i
        rw [hPP', hone] at h
        simpa only [RingHom.comp_apply] using h
      have hkerĨ : ∀ a ∈ Ĩ, νQ a = 0 := by
        intro a ha
        have hle : Ĩ ≤ RingHom.ker νQ := by
          rw [hĨ, Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          exact RingHom.mem_ker.mpr ((hνQS _).trans (hzev j))
        exact hle ha
      refine ⟨Ideal.Quotient.lift Ĩ νQ hkerĨ, fun a => ?_, fun i => ?_⟩
      · rw [Ideal.Quotient.lift_mk, hAlg, hνQ, Ideal.Quotient.lift_mk]
        simp only [ν₀, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · rw [Ideal.Quotient.lift_mk, hνQS]

    obtain ⟨Φ₀, hΦ₀⟩ : ∃ Φ₀ : MvPolynomial (Fin m) K →+* Lu,
        Φ₀ = MvPolynomial.eval₂Hom ((θ.comp (algebraMap Ac (wcQuadModelRing Ac n π c))).comp ι)
          (fun j => θ (S ⟨2 * j.val + 1, by omega⟩)) := ⟨_, rfl⟩
    have hΦ₀C : ∀ k, Φ₀ (MvPolynomial.C k) =
        θ (algebraMap Ac (wcQuadModelRing Ac n π c) (ι k)) := by
      intro k
      simp only [hΦ₀, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    have hΦ₀X : ∀ j : Fin m, Φ₀ (MvPolynomial.X j) = θ (S ⟨2 * j.val + 1, by omega⟩) := by
      intro j
      rw [hΦ₀, MvPolynomial.eval₂Hom_X']
    have hΦz : ∀ i, Φ₀ (z i) = θ (S i) := by
      intro i
      rw [hz]
      split_ifs with h
      · rw [hΦ₀X]
        exact congrArg (fun x => θ (S x))
          (Fin.ext (by show 2 * (i.val / 2) + 1 = i.val; omega))
      · rw [map_zero]
        obtain ⟨j, hj⟩ : ∃ j : Fin m, (⟨2 * j.val, by omega⟩ : Fin n) = i :=
          ⟨⟨i.val / 2, by omega⟩, Fin.ext (show 2 * (i.val / 2) = i.val by omega)⟩
        rw [← hj, hθev]
    have hstar : ∀ q, Φ₀ (ν (Ideal.Quotient.mk Ĩ q)) = θ q := by
      intro q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      induction p using MvPolynomial.induction_on with
      | C a =>
        rw [← hAlg, hν1, hΦ₀C, hθκ]
      | add p q hp hq =>
        simp only [map_add]
        rw [hp, hq]
      | mul_X p i hp =>
        simp only [map_mul]
        rw [hp]
        congr 1
        rw [hexp i]
        simp only [map_sum, map_mul]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [hν1, hν2, hΦ₀C, hΦz, hθκ]
    have hstar' : Φ₀.comp ν = locU := by
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext (fun q => ?_)
      simp only [RingHom.comp_apply]
      rw [hstar, hθa]
    have hstarU : Φ₀ (ν Ub) = θ U := by
      have h := hstar U
      rwa [← hUb] at h
    obtain ⟨w, hw⟩ : ∃ w : MvPolynomial (Fin m) K, w = ν Ub := ⟨_, rfl⟩
    obtain ⟨Lw, _, locW, hlocWunit, hlocw, hliftW, hextW⟩ := hloc (MvPolynomial (Fin m) K) w
    haveI := hlocw
    have hμunit : IsUnit ((locW.comp ν) Ub) := by
      rw [RingHom.comp_apply, ← hw]; exact hlocWunit
    have hΦunit : IsUnit (Φ₀ w) := by
      rw [hw, hstarU]; exact hθU
    obtain ⟨μ, hμcomp⟩ := hliftU _ (locW.comp ν) hμunit
    obtain ⟨Φ, hΦcomp⟩ := hliftW _ Φ₀ hΦunit
    have hμθ : ∀ q, μ (θ q) = locW (ν (Ideal.Quotient.mk Ĩ q)) := by
      intro q
      rw [hθa, ← RingHom.comp_apply μ locU, hμcomp, RingHom.comp_apply]
    have hψuθ : ∀ q, ψu (θ q) = Ideal.Quotient.mk (Ideal.map β Ĩ) (β q) := by
      intro q
      rw [hθa, ← RingHom.comp_apply ψu locU, hψucomp, hψbarmk]
    have hΦμ : Φ.comp μ = RingHom.id _ := by
      apply hextU
      rw [RingHom.comp_assoc, hμcomp, ← RingHom.comp_assoc, hΦcomp, hstar',
        RingHom.id_comp]
    have hμΦ : μ.comp Φ = RingHom.id _ := by
      apply hextW
      rw [RingHom.comp_assoc, hΦcomp, RingHom.id_comp]
      apply MvPolynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, hΦ₀C, hμθ, hν1, hκι]
      · intro j
        rw [RingHom.comp_apply, hΦ₀X, hμθ, hν2, hzod]
    haveI hiso : IsIso (CommRingCat.ofHom Φ) :=
      ⟨⟨CommRingCat.ofHom μ, by rw [← CommRingCat.ofHom_comp, hμΦ, CommRingCat.ofHom_id],
        by rw [← CommRingCat.ofHom_comp, hΦμ, CommRingCat.ofHom_id]⟩⟩

    have hfac : (Ideal.Quotient.mk (Ideal.map β Ĩ)).comp (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap Ac (wcQuadModelRing Ac n π c))).comp ι)
        (fun j => β (S ⟨2 * j.val + 1, by omega⟩))) =
        ψu.comp (Φ.comp locW) := by
      rw [hΦcomp]
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hΦ₀C, hψuθ]
      · intro j
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hΦ₀X, hψuθ]
    rw [hfac, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp]
    haveI := hψuWE
    infer_instance

theorem wc_pmn_nbr_germ_ring (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (C : Type u) [CommRing C] [IsLocalRing C]
    (eC : Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≅ Spec (.of C)) :
    ∃ ρ : B →+* C, Function.Surjective ρ ∧
      Spec.map (CommRingCat.ofHom ρ) = eC.inv ≫ Limits.pullback.fst a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
      ∀ g : A →+* B, Spec.map (CommRingCat.ofHom g) = a' ≫ Limits.pullback.fst V.hom D.f ≫ e.hom →
        ∀ r ∈ IsLocalRing.maximalIdeal A, ρ (g r) = 0 :=
by
  classical
  haveI h0 : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI h1 : IsClosedImmersion
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback _ _).flip h0
  haveI h2 : IsClosedImmersion (Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback _ _).flip h1
  haveI hci : IsClosedImmersion (eC.inv ≫ Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :=
    IsClosedImmersion.comp _ _
  obtain ⟨ρ, hρ, hρS⟩ : ∃ ρ : B →+* C, Function.Surjective ρ ∧
      Spec.map (CommRingCat.ofHom ρ) = eC.inv ≫ Limits.pullback.fst a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) := by
    obtain ⟨I, e', he'⟩ := IsClosedImmersion.Spec_iff.mp hci
    have hτS : Spec.map (Spec.preimage e'.hom) = e'.hom := Spec.map_preimage _
    have hτb : Function.Bijective (Spec.preimage e'.hom).hom := by
      rw [← isIso_SpecMap_iff, hτS]; infer_instance
    refine ⟨(Spec.preimage e'.hom).hom.comp (Ideal.Quotient.mk I),
      hτb.2.comp Ideal.Quotient.mk_surjective, ?_⟩
    have h1 : CommRingCat.ofHom ((Spec.preimage e'.hom).hom.comp (Ideal.Quotient.mk I)) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫ Spec.preimage e'.hom := rfl
    rw [h1, Spec.map_comp, hτS, he']
  refine ⟨ρ, hρ, hρS, ?_⟩
  intro g hg r hr
  have hθ := Spec.map_preimage (eC.inv ≫ Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
      Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
  have hc1 : Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫ a' =
      Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
      Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) :=
    Limits.pullback.condition
  have hc2 : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
      (Limits.pullback.fst V.hom D.f ≫ e.hom) =
      Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫ wcQmSp A :=
    Limits.pullback.condition
  have key : CommRingCat.ofHom (ρ.comp g) = CommRingCat.ofHom (IsLocalRing.residue A) ≫
      Spec.preimage (eC.inv ≫ Limits.pullback.snd a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
        Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) := by
    apply Spec.map_injective
    rw [Spec.map_comp, hθ, CommRingCat.ofHom_comp, Spec.map_comp, hρS, hg]
    calc (eC.inv ≫ Limits.pullback.fst a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ≫
          (a' ≫ Limits.pullback.fst V.hom D.f ≫ e.hom)
        = eC.inv ≫ (Limits.pullback.fst a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫ a') ≫
          (Limits.pullback.fst V.hom D.f ≫ e.hom) := by
          simp only [Category.assoc]
      _ = eC.inv ≫ (Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
          Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
          (Limits.pullback.fst V.hom D.f ≫ e.hom) :=
          congrArg (fun t => eC.inv ≫ t ≫ (Limits.pullback.fst V.hom D.f ≫ e.hom)) hc1
      _ = eC.inv ≫ Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
          (Limits.pullback.fst V.hom D.f ≫ e.hom)) := by
          simp only [Category.assoc]
      _ = eC.inv ≫ Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫
          (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
          wcQmSp A) :=
          congrArg (fun t => eC.inv ≫ Limits.pullback.snd a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≫ t) hc2
      _ = _ := by first | rfl | simp only [Category.assoc]
  have h2 := congrArg (fun φ => φ.hom r) key
  simp only [CommRingCat.hom_ofHom, CommRingCat.hom_comp, RingHom.comp_apply] at h2
  rw [h2, (IsLocalRing.residue_eq_zero_iff r).mpr hr, map_zero]

theorem wc_pmn_nbr_slice_dvr (K : Type u) [Field K] (R : Type u) [CommRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (ζ : MvPolynomial (Fin 1) K →+* R) (hζ : WeaklyEtale (Spec.map (CommRingCat.ofHom ζ)))
    (hζm : ζ (MvPolynomial.X 0) ∈ IsLocalRing.maximalIdeal R) :
    IsNoetherianRing R ∧ IsLocalRing.maximalIdeal R = Ideal.span {ζ (MvPolynomial.X 0)} ∧
    Spec.map (CommRingCat.ofHom ζ) (IsLocalRing.closedPoint R) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)))
        (IsLocalRing.closedPoint K) :=
by
  classical
  set q : Ideal (MvPolynomial (Fin 1) K) := Ideal.comap ζ (IsLocalRing.maximalIdeal R) with hqdef

  have s1 : q = RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K) := by
    let g : K →+* IsLocalRing.ResidueField R :=
      (IsLocalRing.residue R).comp (ζ.comp MvPolynomial.C)
    have hcomp : (IsLocalRing.residue R).comp ζ = g.comp MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [g]
      · intro i
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr hζm
    ext f
    rw [hqdef, Ideal.mem_comap, RingHom.mem_ker, ← IsLocalRing.residue_eq_zero_iff]
    have := congrArg (fun φ => φ f) hcomp
    simp only [RingHom.comp_apply] at this
    rw [this]
    exact map_eq_zero_iff g g.injective

  have s2 : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K) =
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} := by
    apply le_antisymm
    · intro f hf
      rw [RingHom.mem_ker] at hf
      have himg : ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 1) K)) =
          MvPolynomial.X '' ({0} : Set (Fin 1)) := by simp
      rw [himg, MvPolynomial.mem_ideal_span_X_image]
      intro n hn
      refine ⟨0, rfl, ?_⟩
      intro h0
      have hn0 : n = 0 := by
        refine Finsupp.ext fun i => ?_
        rw [Subsingleton.elim i 0]
        simpa using h0
      rw [MvPolynomial.mem_support_iff, hn0] at hn
      exact hn hf
    · rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      simp

  haveI : q.IsPrime := Ideal.comap_isPrime ζ _
  have hunit : ∀ y : q.primeCompl, IsUnit (ζ y) := by
    intro y
    exact IsLocalRing.notMem_maximalIdeal.mp y.2
  obtain ⟨θ, hθ⟩ : ∃ θ : Localization.AtPrime q →+* R,
      θ.comp (algebraMap (MvPolynomial (Fin 1) K) (Localization.AtPrime q)) = ζ :=
    ⟨IsLocalization.lift hunit, IsLocalization.lift_comp hunit⟩
  have hθ' : ∀ x, θ (algebraMap (MvPolynomial (Fin 1) K) (Localization.AtPrime q) x) = ζ x := by
    intro x
    rw [← hθ]
    rfl
  have hloc : IsLocalHom θ := by
    constructor
    intro x hx
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
    have h1 : θ (IsLocalization.mk' (Localization.AtPrime q) a s) * ζ s = ζ a := by
      have := congrArg θ (IsLocalization.mk'_spec (Localization.AtPrime q) a s)
      rwa [map_mul, hθ', hθ'] at this
    have hζa : IsUnit (ζ a) := h1 ▸ hx.mul (hunit s)
    have ha : a ∈ q.primeCompl := fun ha => (IsLocalRing.notMem_maximalIdeal.mpr hζa) ha
    apply isUnit_of_mul_isUnit_left (y := algebraMap _ (Localization.AtPrime q) (s : MvPolynomial (Fin 1) K))
    rw [IsLocalization.mk'_spec]
    exact IsLocalization.map_units (Localization.AtPrime q) ⟨a, ha⟩
  have hW : @Algebra.WeaklyEtale (MvPolynomial (Fin 1) K) R _ _ ζ.toAlgebra :=
    wc_lpkt_specMap_weaklyEtale_ring _ _ ζ hζ
  have hWθ : @Algebra.WeaklyEtale (Localization.AtPrime q) R _ _ θ.toAlgebra := by
    letI : Algebra (MvPolynomial (Fin 1) K) R := ζ.toAlgebra
    letI : Algebra (Localization.AtPrime q) R := θ.toAlgebra
    haveI : IsScalarTower (MvPolynomial (Fin 1) K) (Localization.AtPrime q) R :=
      IsScalarTower.of_algebraMap_eq' hθ.symm
    exact wc_weaklyEtale_cancel _ _ _
      (wc_localization_weaklyEtale _ (Localization.AtPrime q) q.primeCompl) hW
  haveI : IsNoetherianRing (Localization.AtPrime q) :=
    IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
  obtain ⟨hN, hm⟩ := wc_tla_shens_noeth_unram (Localization.AtPrime q) R θ hloc hWθ
  have hmP : Ideal.map (algebraMap (MvPolynomial (Fin 1) K) (Localization.AtPrime q)) q =
      IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
    IsLocalization.AtPrime.map_eq_maximalIdeal q _
  refine ⟨hN, ?_, ?_⟩
  · rw [← hm, ← hmP, Ideal.map_map, hθ, s1, s2, Ideal.map_span, Set.image_singleton]
  · apply PrimeSpectrum.ext
    change Ideal.comap ζ (IsLocalRing.maximalIdeal R) =
      Ideal.comap (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)) (IsLocalRing.maximalIdeal K)
    rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot]
    exact s1

theorem wc_pmn_nbr_branch_nondeg (B : Type u) [CommRing B] [IsLocalRing B]
    (R : Type u) [CommRing R] [IsLocalRing R] (q : B →+* R) (hq : Function.Surjective q)
    (yb : B) (hmR : IsLocalRing.maximalIdeal R = Ideal.span {q yb})
    (C : Type u) [CommRing C] [IsLocalRing C] (ρ : B →+* C) (hρ : Function.Surjective ρ)
    (a b : C) (hspan : Ideal.span {a, b} = IsLocalRing.maximalIdeal C)
    (Kb : Type u) [Field Kb] [Algebra C Kb] [IsLocalization.Away b Kb]
    (φ : R →+* Kb) (hφ : φ.comp q = (algebraMap C Kb).comp ρ) :
    φ (q yb) ≠ 0 ∧ ∀ κ : Kb, ∃ r s : R, φ s ≠ 0 ∧ κ * φ s = φ r :=
by
  have H : ∀ x : B, φ (q x) = algebraMap C Kb (ρ x) := fun x => by
    have := RingHom.congr_fun hφ x
    simpa only [RingHom.comp_apply] using this
  have hb : b ∈ IsLocalRing.maximalIdeal C := by
    rw [← hspan]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  rw [← IsLocalRing.map_maximalIdeal_of_surjective ρ hρ] at hb
  obtain ⟨r₀, hr₀, hr₀b⟩ := (Ideal.mem_map_iff_of_surjective ρ hρ).mp hb
  have hu : IsUnit (algebraMap C Kb b) := IsLocalization.Away.algebraMap_isUnit (S := Kb) b
  refine ⟨?_, ?_⟩
  · intro h0
    have hqr : q r₀ ∈ Ideal.map q (IsLocalRing.maximalIdeal B) := Ideal.mem_map_of_mem q hr₀
    rw [IsLocalRing.map_maximalIdeal_of_surjective q hq, hmR] at hqr
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hqr
    apply hu.ne_zero
    rw [← hr₀b, ← H, ← ht, map_mul, h0, mul_zero]
  · intro κ
    obtain ⟨N, c', hc'⟩ := IsLocalization.Away.surj b κ
    obtain ⟨c₀, hc₀⟩ := hρ c'
    refine ⟨q c₀, q (r₀ ^ N), ?_, ?_⟩
    · rw [H, map_pow, map_pow, hr₀b]
      exact (hu.pow N).ne_zero
    · rw [H, H, map_pow, map_pow, hr₀b, hc₀]
      exact hc'

theorem wc_pmn_nbr_dvr_branch_away (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (y : R) (hy : IsLocalRing.maximalIdeal R = Ideal.span {y}) (Kb : Type u) [Field Kb]
    (φ : R →+* Kb) (hφy : φ y ≠ 0)
    (hgen : ∀ κ : Kb, ∃ r s : R, φ s ≠ 0 ∧ κ * φ s = φ r) :
    @IsLocalization.Away R _ y Kb _ φ.toAlgebra :=
by
  classical
  have s1 : ∀ r : R, r ≠ 0 → ∃ (v : R) (k : ℕ), IsUnit v ∧ r = v * y ^ k := by
    intro r hr
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hex : ∃ i, r ∉ IsLocalRing.maximalIdeal R ^ i := by
      by_contra hcon
      push_neg at hcon
      apply hr
      have : r ∈ ⨅ i, IsLocalRing.maximalIdeal R ^ i := Ideal.mem_iInf.mpr hcon
      rw [hK] at this
      exact (Ideal.mem_bot).mp this
    have H : ∃ k, r ∉ IsLocalRing.maximalIdeal R ^ (k + 1) := by
      obtain ⟨i, hi⟩ := hex
      cases i with
      | zero => exact absurd (by simp : r ∈ IsLocalRing.maximalIdeal R ^ 0) hi
      | succ j => exact ⟨j, hi⟩
    obtain ⟨k, hk1, hkmin⟩ : ∃ k, r ∉ IsLocalRing.maximalIdeal R ^ (k + 1) ∧
        ∀ j < k, ¬ (r ∉ IsLocalRing.maximalIdeal R ^ (j + 1)) :=
      ⟨Nat.find H, Nat.find_spec H, fun j hj => Nat.find_min H hj⟩
    have hk0 : r ∈ IsLocalRing.maximalIdeal R ^ k := by
      by_cases h0 : k = 0
      · rw [h0]; simp
      · obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero h0
        have := hkmin j (by omega)
        rw [hj]; exact not_not.mp this
    rw [hy, Ideal.span_singleton_pow] at hk0 hk1
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hk0
    refine ⟨v, k, ?_, hv.symm⟩
    rw [← IsLocalRing.notMem_maximalIdeal, hy]
    intro hvm
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hvm
    apply hk1
    refine Ideal.mem_span_singleton'.mpr ⟨w, ?_⟩
    rw [← hv, ← hw]; ring
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨v, k, hv, rfl⟩ := s1 a hne
    rw [map_mul, map_pow] at ha
    exact mul_ne_zero (hv.map φ).ne_zero (pow_ne_zero k hφy) ha
  letI := φ.toAlgebra
  have hal : algebraMap R Kb = φ := RingHom.algebraMap_toAlgebra φ
  refine IsLocalization.Away.mk y ?_ ?_ ?_
  · rw [hal]; exact isUnit_iff_ne_zero.mpr hφy
  · intro κ
    obtain ⟨r', s', hs', hκ⟩ := hgen κ
    have hs0 : s' ≠ 0 := by rintro rfl; exact hs' (map_zero φ)
    obtain ⟨v, k, hv, hsv⟩ := s1 s' hs0
    refine ⟨k, r' * ↑(hv.unit⁻¹), ?_⟩
    have hu : φ v * φ ↑(hv.unit⁻¹) = 1 := by
      rw [← map_mul, hv.mul_val_inv, map_one]
    rw [hal, map_mul, ← hκ, hsv, map_mul, map_pow]
    calc κ * φ y ^ k = κ * φ y ^ k * (φ v * φ ↑(hv.unit⁻¹)) := by rw [hu, mul_one]
      _ = _ := by ring
  · intro a b hab
    rw [hal] at hab
    exact ⟨0, by rw [hinj hab]⟩

theorem wc_pmn_nbr_branch_pullback (K : Type u) [Field K] (B : Type u) [CommRing B]
    (ζ : MvPolynomial (Fin 1) K →+* B) (R : Type u) [CommRing R] (q : B →+* R)
    (Kb : Type u) [Field Kb] (φ : R →+* Kb)
    (hAway : @IsLocalization.Away R _ (q (ζ (MvPolynomial.X 0))) Kb _ φ.toAlgebra)
    (T : Scheme.{u}) (eT : T ≅ Spec (.of Kb)) (g : T ⟶ Spec (.of B))
    (hg : eT.inv ≫ g = Spec.map (CommRingCat.ofHom (φ.comp q)))
    (U₀ : (Spec (.of (MvPolynomial (Fin 1) K))).Opens)
    (hU₀ : (U₀ : Set ↥(Spec (.of (MvPolynomial (Fin 1) K)))) =
      (Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)))))ᶜ) :
    (∀ p : Spec (.of B), p ∈ Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀ ↔
      ζ (MvPolynomial.X 0) ∉ p.asIdeal) ∧
    ∃ uD : T ⟶ (Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀).toScheme,
      uD ≫ (Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀).ι = g ∧
      IsPullback (uD ≫ (Spec.map (CommRingCat.ofHom ζ) ∣_ U₀))
        (eT.hom ≫ Spec.map (CommRingCat.ofHom φ)) U₀.ι
        (Spec.map (CommRingCat.ofHom (q.comp ζ))) :=
by
  classical
  letI : Algebra R Kb := φ.toAlgebra
  haveI : IsLocalization.Away (q (ζ (MvPolynomial.X 0))) Kb := hAway

  have orig : ∀ y : Spec (.of (MvPolynomial (Fin 1) K)),
      y ∈ Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)))) ↔
      (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∈ y.asIdeal := by
    intro y
    constructor
    · rintro ⟨κ, rfl⟩
      rw [Spec.map_apply]
      show (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∈
        Ideal.comap (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)) κ.asIdeal
      rw [Ideal.mem_comap, MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro hX
      have hker : ∀ p : MvPolynomial (Fin 1) K, MvPolynomial.constantCoeff p = 0 →
          p ∈ y.asIdeal := by
        intro p hp
        have hspan : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 1))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          refine ⟨0, Set.mem_univ _, ?_⟩
          intro h0
          have hm0 : m = 0 :=
            Finsupp.ext fun i => by
              rw [Fin.eq_zero i, Finsupp.coe_zero, Pi.zero_apply]; exact h0
          rw [MvPolynomial.mem_support_iff, hm0] at hm
          exact hm (by rw [← MvPolynomial.constantCoeff_eq]; exact hp)
        have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 1))) ≤ y.asIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨i, _, rfl⟩
          rw [Fin.eq_zero i]
          exact hX
        exact hle hspan
      refine ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum K),
        (Spec.map_apply (CommRingCat.ofHom (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)))
          (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum K)).trans ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (MvPolynomial.constantCoeff (R := K) (σ := Fin 1)) ⊥ = y.asIdeal
      ext p
      rw [Ideal.mem_comap, Ideal.mem_bot]
      constructor
      · exact hker p
      · intro hp
        by_contra hc
        have h1 : p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈ y.asIdeal := by
          apply hker
          rw [map_sub, MvPolynomial.constantCoeff_C, sub_self]
        have h2 : MvPolynomial.C (MvPolynomial.constantCoeff p) ∈ y.asIdeal := by
          have := y.asIdeal.sub_mem hp h1
          rwa [sub_sub_cancel] at this
        exact y.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ h2 ((Ne.isUnit hc).map MvPolynomial.C))

  have crit : ∀ (S : Type u) [CommRing S] (χ : MvPolynomial (Fin 1) K →+* S)
      (x : Spec (.of S)),
      Spec.map (CommRingCat.ofHom χ) x ∈ U₀ ↔ χ (MvPolynomial.X 0) ∉ x.asIdeal := by
    intro S _ χ x
    have h1 : Spec.map (CommRingCat.ofHom χ) x ∈ U₀ ↔
        Spec.map (CommRingCat.ofHom χ) x ∈
          (U₀ : Set ↥(Spec (.of (MvPolynomial (Fin 1) K)))) := Iff.rfl
    rw [h1, hU₀, Set.mem_compl_iff, orig]
    have h2 : (Spec.map (CommRingCat.ofHom χ) x).asIdeal = Ideal.comap χ x.asIdeal := by
      rw [Spec.map_apply]; rfl
    rw [h2, Ideal.mem_comap]

  have P1 : ∀ p : Spec (.of B), p ∈ Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀ ↔
      ζ (MvPolynomial.X 0) ∉ p.asIdeal := by
    intro p
    rw [Scheme.Hom.mem_preimage]
    exact crit B ζ p

  have hg' : g = eT.hom ≫ Spec.map (CommRingCat.ofHom (φ.comp q)) := by
    rw [← hg, Iso.hom_inv_id_assoc]
  have hunit : IsUnit (φ (q (ζ (MvPolynomial.X 0)))) :=
    IsLocalization.Away.algebraMap_isUnit (S := Kb) (q (ζ (MvPolynomial.X 0)))

  have hrng : Set.range ⇑g ⊆ Set.range ⇑(Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    rw [SetLike.mem_coe, P1, hg', Scheme.Hom.comp_apply, Spec.map_apply]
    intro hmem
    have hmem' : φ (q (ζ (MvPolynomial.X 0))) ∈ (eT.hom t).asIdeal := hmem
    exact (eT.hom t).isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem' hunit)

  obtain ⟨uD, huD⟩ : ∃ uD : T ⟶ (Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀).toScheme,
      uD ≫ (Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀).ι = g :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrng⟩

  haveI hφoi : IsOpenImmersion (Spec.map (CommRingCat.ofHom φ)) :=
    IsOpenImmersion.of_isLocalization (R := R) (S := Kb) (q (ζ (MvPolynomial.X 0)))
  haveI hjT : IsOpenImmersion (eT.hom ≫ Spec.map (CommRingCat.ofHom φ)) := inferInstance

  have hcomm : (eT.hom ≫ Spec.map (CommRingCat.ofHom φ)) ≫
      Spec.map (CommRingCat.ofHom (q.comp ζ)) =
      (uD ≫ Spec.map (CommRingCat.ofHom ζ) ∣_ U₀) ≫ U₀.ι := by
    simp only [Category.assoc]
    rw [morphismRestrict_ι, ← Category.assoc uD, huD, hg']
    simp only [Category.assoc]
    congr 1
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]

  have hr : Set.range ⇑(eT.hom ≫ Spec.map (CommRingCat.ofHom φ)) =
      Set.range ⇑(Spec.map (CommRingCat.ofHom φ)) := by
    ext z
    constructor
    · rintro ⟨t, rfl⟩
      exact ⟨eT.hom t, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨κ, rfl⟩
      exact ⟨eT.inv κ, by rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply]⟩
  have hr2 : ∀ x : Spec (.of R), x ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom φ)) ↔
      q (ζ (MvPolynomial.X 0)) ∉ x.asIdeal := by
    intro x
    have hL := PrimeSpectrum.localization_away_comap_range Kb (q (ζ (MvPolynomial.X 0)))
    constructor
    · rintro ⟨κ, rfl⟩ hmem
      rw [Spec.map_apply] at hmem
      have hmem' : φ (q (ζ (MvPolynomial.X 0))) ∈ κ.asIdeal := hmem
      exact κ.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem' hunit)
    · intro hx
      have hx' : (x : PrimeSpectrum R) ∈ Set.range (PrimeSpectrum.comap (algebraMap R Kb)) := by
        rw [hL]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr hx
      obtain ⟨κ, hκ⟩ := hx'
      exact ⟨κ, (Spec.map_apply (CommRingCat.ofHom φ) κ).trans hκ⟩
  have hopen : Spec.map (CommRingCat.ofHom (q.comp ζ)) ⁻¹ᵁ U₀.ι.opensRange =
      (eT.hom ≫ Spec.map (CommRingCat.ofHom φ)).opensRange := by
    rw [Scheme.Opens.opensRange_ι]
    apply TopologicalSpace.Opens.ext
    rw [Scheme.Hom.coe_opensRange, hr]
    ext x
    rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, crit R (q.comp ζ) x, hr2 x]
    rfl

  exact ⟨P1, uD, huD, IsOpenImmersion.isPullback _ _ _ _ hcomm hopen⟩

theorem wc_pmn_nbr_branch_kummer_class (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a') (h2 : n = 2)
    (C : Type u) [CommRing C] [IsLocalRing C]
    (eC : Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≅ Spec (.of C))
    (a b : C) (hab : a * b = 0) (hspan : Ideal.span {a, b} = IsLocalRing.maximalIdeal C)
    (Kb : Type u) [Field Kb] [Algebra C Kb] [IsLocalization.Away b Kb]
    (U : (Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))).ProEt)
    (eU : U.left ≅ Spec (.of Kb))
    (hU : eU.inv ≫ U.hom ≫ eC.hom = Spec.map (CommRingCat.ofHom (algebraMap C Kb))) :
    ∃ (O : (Spec (.of B)).Opens),
      (∀ w : ↥(Limits.pullback a' ((wcProEtPullback D.f).map a₀).left),
        Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left w ∈ O) ∧
      ∃ (uD : U.left ⟶ O.toScheme),
        uD ≫ O.ι = U.hom ≫ Limits.pullback.fst a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
        ∃ z : wcHM O.toScheme ℓ (n - 1),
          ∀ DU : wcHMPullData uD ℓ, wcHMPullCanonical DU → wcHMPull DU (n - 1) z ≠ 0 :=
by
  classical
  have hnm : n = 2 * 1 := by omega
  have hq : n - 1 + 1 = 2 * 1 := by omega

  obtain ⟨K, _, _, ιA, hbij, hℓK⟩ := wc_pmn_hc_coeff_field F'' (D.S i) (D.hS i) V A e hV ℓ hℓ
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) :=
    IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ hbij)
  obtain ⟨π, c, hπ, hc, β, hβ, ht, hβa⟩ :=
    wc_pmn_hc_morse_at_x F' F'' Y n hn hn2 D i V A e hV x hx₁ hx₂ B Λ' W'' φ' a' hsh
  obtain ⟨P, D', hP, hD0, hid⟩ := wc_pmn_hc_hyperbolic_change A π hπ 1 n hnm le_rfl c hc
  obtain ⟨g, hg⟩ : ∃ g : A →+* B, g = β.comp (algebraMap A (wcQuadModelRing A n π c)) :=
    ⟨_, rfl⟩
  rw [← hg] at hβa
  have hgπ : g π = β (algebraMap A (wcQuadModelRing A n π c) π) := by rw [hg]; rfl

  obtain ⟨ρ, hρ, hρSpec, hρkill⟩ :=
    wc_pmn_nbr_germ_ring F' F'' Y n D V A e x hx₁ B Λ' W'' φ' a' hsh C eC
  obtain ⟨lam, hlam⟩ : ∃ lam : B →+* Kb, lam = (algebraMap C Kb).comp ρ := ⟨_, rfl⟩
  have hlamπ : lam (g π) = 0 := by
    rw [hlam, RingHom.comp_apply,
      hρkill g hβa π (by rw [hπ]; exact Ideal.mem_span_singleton_self π), map_zero]
  have hgU : eU.inv ≫ (U.hom ≫ Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) =
      Spec.map (CommRingCat.ofHom lam) := by
    rw [hlam, CommRingCat.ofHom_comp, Spec.map_comp, hρSpec, ← hU]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]

  obtain ⟨P₀, D₀, hP₀, hD₀, hid₀, hkill⟩ : ∃ (P₀ : Matrix (Fin n) (Fin n) A)
      (D₀ : MvPolynomial (Fin n) A), IsUnit P₀.det ∧ MvPolynomial.constantCoeff D₀ = 0 ∧
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P₀ p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P₀ q b) * MvPolynomial.X b)) =
        ∑ j : Fin 1, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D₀ ∧
      lam (β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ d, MvPolynomial.C (P₀⁻¹ (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) d) *
          MvPolynomial.X d))) = 0 := by
    obtain ⟨SP, hSP⟩ : ∃ S : Fin n → wcQuadModelRing A n π c, ∀ i, S i =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ d, MvPolynomial.C (P⁻¹ i d) * MvPolynomial.X d) := ⟨_, fun _ => rfl⟩
    obtain ⟨u, hu, hrel, -, -, -⟩ :=
      wc_pmn_nbr_slice_explicit A π hπ K ιA hbij 1 n hnm c P hP D' hD0 hid B β hβ ht SP hSP
    rw [Fin.sum_univ_one, ← hgπ] at hrel
    have h0 := congrArg lam hrel
    rw [map_mul, map_mul, hlamπ, zero_mul] at h0
    rcases mul_eq_zero.mp h0.symm with h | h
    · rw [hSP] at h
      exact ⟨P, D', hP, hD0, hid, h⟩
    · obtain ⟨P', D'', hP', hD0', hid', hPinv⟩ :=
        wc_pmn_nbr_hyperbolic_swap A π n hnm c P hP D' hD0 hid
      refine ⟨P', D'', hP', hD0', hid', ?_⟩
      rw [hSP] at h
      simp only [hPinv]
      exact h

  obtain ⟨S, hS⟩ : ∃ S : Fin n → wcQuadModelRing A n π c, ∀ i, S i =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ d, MvPolynomial.C (P₀⁻¹ i d) * MvPolynomial.X d) := ⟨_, fun _ => rfl⟩
  have hx0 : lam (β (S ⟨2 * (0 : Fin 1).val, by omega⟩)) = 0 := by rw [hS]; exact hkill
  obtain ⟨u, hu, hrel, hSm, hI, hWE⟩ :=
    wc_pmn_nbr_slice_explicit A π hπ K ιA hbij 1 n hnm c P₀ hP₀ D₀ hD₀ hid₀ B β hβ ht S hS
  rw [Fin.sum_univ_one, ← hgπ] at hrel
  obtain ⟨ζ, hζ⟩ : ∃ ζ : MvPolynomial (Fin 1) K →+* B,
      ζ = MvPolynomial.eval₂Hom ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ιA)
        (fun j : Fin 1 => β (S ⟨2 * j.val + 1, by omega⟩)) := ⟨_, rfl⟩
  rw [← hζ] at hWE
  have hζX : ζ (MvPolynomial.X 0) = β (S ⟨2 * (0 : Fin 1).val + 1, by omega⟩) := by
    rw [hζ]; exact MvPolynomial.eval₂Hom_X' _ _ _
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal B, I = Ideal.map β
      (Ideal.span (Set.range fun j : Fin 1 => S ⟨2 * j.val, by omega⟩)) := ⟨_, rfl⟩
  rw [← hIdef] at hI hWE
  obtain ⟨hR, hRs⟩ := wc_quot_strictly_henselian_of_ne_top B I hI
  have hyR : Ideal.Quotient.mk I (ζ (MvPolynomial.X 0)) ∈ IsLocalRing.maximalIdeal (B ⧸ I) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨v, hv⟩
    obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (↑v⁻¹ : B ⧸ I)
    have e1 : Ideal.Quotient.mk I (ζ (MvPolynomial.X 0) * z - 1) = 0 := by
      rw [map_sub, map_mul, map_one, hz, ← hv, Units.mul_inv, sub_self]
    have e2 : ζ (MvPolynomial.X 0) * z - 1 ∈ IsLocalRing.maximalIdeal B :=
      IsLocalRing.le_maximalIdeal hI (Ideal.Quotient.eq_zero_iff_mem.mp e1)
    have e3 : ζ (MvPolynomial.X 0) * z ∈ IsLocalRing.maximalIdeal B := by
      rw [hζX]; exact Ideal.mul_mem_right _ _ (hSm _)
    have e4 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
      have e5 := Ideal.sub_mem _ e3 e2
      rwa [sub_sub_cancel] at e5
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr e4)

  obtain ⟨hnoeth, hmR, hk0⟩ :=
    wc_pmn_nbr_slice_dvr K (B ⧸ I) ((Ideal.Quotient.mk I).comp ζ) hWE hyR

  have hlamI : ∀ r ∈ I, lam r = 0 := by
    intro r hr
    have hle : I ≤ RingHom.ker lam := by
      rw [hIdef, Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      obtain rfl : j = 0 := Subsingleton.elim _ _
      simp only [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
      exact hx0
    exact (RingHom.mem_ker).mp (hle hr)
  obtain ⟨φ, hφdef⟩ : ∃ φ : B ⧸ I →+* Kb, φ = Ideal.Quotient.lift I lam hlamI := ⟨_, rfl⟩
  have hφ : φ.comp (Ideal.Quotient.mk I) = lam := by
    rw [hφdef]; exact Ideal.Quotient.lift_comp_mk I lam hlamI
  have hφ' : φ.comp (Ideal.Quotient.mk I) = (algebraMap C Kb).comp ρ := by rw [hφ, hlam]
  obtain ⟨hφy, hgen⟩ := wc_pmn_nbr_branch_nondeg B (B ⧸ I) (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective (ζ (MvPolynomial.X 0)) hmR C ρ hρ a b hspan Kb φ hφ'
  have hAway := wc_pmn_nbr_dvr_branch_away (B ⧸ I) (Ideal.Quotient.mk I (ζ (MvPolynomial.X 0)))
    hmR Kb φ hφy hgen

  obtain ⟨U₀, hU₀, ω, hω⟩ := wc_punct_affine_strict_local_top_nonzero K ℓ hℓK 1 (n - 1) le_rfl hq
  have hg' : eU.inv ≫ (U.hom ≫ Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) =
      Spec.map (CommRingCat.ofHom (φ.comp (Ideal.Quotient.mk I))) := by
    rw [hφ]; exact hgU
  obtain ⟨hpt, uD, huD, hpb⟩ := wc_pmn_nbr_branch_pullback K B ζ (B ⧸ I) (Ideal.Quotient.mk I)
    Kb φ hAway U.left eU _ hg' U₀ hU₀
  have hT : ∀ DT : wcHMPullData (uD ≫ (Spec.map (CommRingCat.ofHom ζ) ∣_ U₀)) ℓ,
      wcHMPullCanonical DT → wcHMPull DT (n - 1) ω ≠ 0 := fun DT hDT =>
    hω (B ⧸ I) (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp ζ))) hWE hk0 U.left _ _
      hpb DT hDT
  obtain ⟨Dψ, hDψ⟩ := wc_hm_pull_data_exists (Spec.map (CommRingCat.ofHom ζ) ∣_ U₀) ℓ
  refine ⟨Spec.map (CommRingCat.ofHom ζ) ⁻¹ᵁ U₀, ?_, uD, huD, wcHMPull Dψ (n - 1) ω, ?_⟩
  ·
    intro w
    rw [hpt, hζX]
    intro hw
    obtain ⟨bp, hb⟩ : ∃ bp : Spec (.of B),
        bp = Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left w := ⟨_, rfl⟩
    rw [← hb] at hw
    have hπb : g π ∈ bp.asIdeal := by
      rw [← Ideal.mul_unit_mem_iff_mem bp.asIdeal hu, hrel]
      exact Ideal.mul_mem_left _ _ hw
    have hcl : Spec.map (CommRingCat.ofHom g) bp = IsLocalRing.closedPoint A := by
      apply PrimeSpectrum.ext
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Spec.map (CommRingCat.ofHom g) bp).isPrime.ne_top
      · show IsLocalRing.maximalIdeal A ≤ _
        rw [hπ, Ideal.span_le, Set.singleton_subset_iff]
        show π ∈ (Spec.map (CommRingCat.ofHom g) bp).asIdeal
        rw [Spec.map_apply]
        exact hπb
    rw [hβa] at hcl
    have hã1 : (((wcProEtPullback D.f).map a₀).left :
        Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
          Limits.pullback.fst V.hom D.f = Limits.pullback.fst E.hom D.f ≫ a₀.left := by
      first
        | exact Limits.pullback.lift_fst _ _ _
        | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
    obtain ⟨q, hq'⟩ : ∃ q : ((wcProEtPullback D.f).obj E).left,
        q = Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left w := ⟨_, rfl⟩
    have hcond : (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left ≫ a') w =
        (Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left ≫
          ((wcProEtPullback D.f).map a₀).left) w := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ← hb, ← hq'] at hcond
    have hz : Limits.pullback.fst V.hom D.f (((wcProEtPullback D.f).map a₀).left q) =
        a₀.left (Limits.pullback.fst E.hom D.f q) := by
      have key : ∀ {X₁ Y₁ : Scheme.{u}} (f₁ g₁ : X₁ ⟶ Y₁), f₁ = g₁ → ∀ p, f₁ p = g₁ p := by
        intro X₁ Y₁ f₁ g₁ h p; subst h; rfl
      have h1 := key _ _ hã1 q
      exact (Scheme.Hom.comp_apply _ _ q).symm.trans (h1.trans (Scheme.Hom.comp_apply _ _ q))
    have hcl1 : (Limits.pullback.fst V.hom D.f ≫ e.hom) (a' bp) = IsLocalRing.closedPoint A :=
      (Scheme.Hom.comp_apply a' (Limits.pullback.fst V.hom D.f ≫ e.hom) bp).symm.trans hcl
    have hcl2 : e.hom (Limits.pullback.fst V.hom D.f (a' bp)) = IsLocalRing.closedPoint A :=
      (Scheme.Hom.comp_apply (Limits.pullback.fst V.hom D.f) e.hom (a' bp)).symm.trans hcl1
    rw [hcond, hz] at hcl2
    have h3 : a₀.left (Limits.pullback.fst E.hom D.f q) = e.inv (IsLocalRing.closedPoint A) :=
      (Scheme.hom_inv_apply e _).symm.trans (congrArg e.inv hcl2)
    have h4 := congrArg
      (fun (f : E.left ⟶ (wcP1Over F'').left) => f (Limits.pullback.fst E.hom D.f q))
      (MorphismProperty.Over.w a₀)
    have h5 : V.hom (a₀.left (Limits.pullback.fst E.hom D.f q)) =
        E.hom (Limits.pullback.fst E.hom D.f q) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans h4
    rw [h3, hV] at h5
    exact hE (Limits.pullback.fst E.hom D.f q) i h5.symm
  ·
    intro DU hDU
    obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (uD ≫ (Spec.map (CommRingCat.ofHom ζ) ∣_ U₀)) ℓ
    rw [← wc_hm_pull_comp _ uD _ rfl Dψ hDψ DU hDU Dk hDk (n - 1) ω]
    exact hT Dk hDk

theorem wc_hm_pull_unit_transpose_isIso {Y Y' : Scheme.{u}} (f : Y' ⟶ Y) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D) :
    IsIso ((D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ)) :=
by
  classical
  letI := D.cont

  have hfun : wcHMFun Y' ℓ 1 = 𝟙 _ ∧ ∀ r r' : C(↥Y', ULift.{u+1} ℚ_[ℓ]),
      wcHMFun Y' ℓ (r * r') = wcHMFun Y' ℓ r ≫ wcHMFun Y' ℓ r' := by
    refine ⟨?_, ?_⟩
    · apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      rw [← SheafOfModules.unitHomEquiv_apply_coe]
      simp only [wcHMFun, Equiv.apply_symm_apply]
      rfl
    · intro r r'
      apply (SheafOfModules.unitHomEquiv _).injective
      rw [SheafOfModules.unitHomEquiv_comp_apply]
      apply Subtype.ext
      funext V
      have hvalP : ∀ c : C(↥Y', ULift.{u+1} ℚ_[ℓ]),
          ((SheafOfModules.unitHomEquiv _) (wcHMFun Y' ℓ c)).1 V =
          (c.comp (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
        intro c
        simp only [wcHMFun, Equiv.apply_symm_apply]
        rfl
      show _ = ((wcHMFun Y' ℓ r').val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcHMFun Y' ℓ r)).1 V)
      rw [hvalP, hvalP]
      apply ContinuousMap.ext
      intro x
      rfl

  have hisUnit : ∃ c' : C(↥Y', ULift.{u+1} ℚ_[ℓ]), wcSuppTwist (wcSuppUnitMap D) * c' = 1 := by
    let u := SheafOfModules.unitToPushforwardObjUnit D.φ
    let ψ₁ := (D.adj.homEquiv _ _).symm u
    let h : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Y' ℓ) :=
      D.μ.inv ≫ ψ₁
    have hfac : u = wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
      have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
        _ = D.adj.homEquiv _ _ D.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcSuppUnitMap D ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let T : Y.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Y) (inferInstance : WeaklyEtale (𝟙 Y))
    let cT : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥Y, ULift.{u+1} ℚ_[ℓ]))
    let a : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom
        (1 : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ]))
    have hu1 : (u.val.app (Opposite.op T)).hom (1 : C(↥Y, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ])) :=
      (D.φ.hom.app (Opposite.op T)).hom.map_one
    have hev : (u.val.app (Opposite.op T)).hom (1 : C(↥Y, ULift.{u+1} ℚ_[ℓ])) =
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ]),
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom.map_smul x
        (1 : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ]))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cT * a = 1 := by
      rw [← hlin cT, ← hev, hu1]
    refine ⟨a.comp (Limits.pullback.lift f (𝟙 Y')
      ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom, ?_⟩
    show cT.comp (Limits.pullback.lift f (𝟙 Y')
        ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom *
      a.comp (Limits.pullback.lift f (𝟙 Y')
        ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom = 1
    rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]

  have hfactor : wcSuppUnitMap D =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
        (wcHMFun Y' ℓ (wcSuppTwist (wcSuppUnitMap D))) := by
    have hlam1 : Limits.pullback.lift f (𝟙 Y')
        ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
        Limits.pullback.fst (𝟙 Y) f = f := Limits.pullback.lift_fst _ _ _
    have hlam2 : Limits.pullback.lift f (𝟙 Y')
        ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
        Limits.pullback.snd (𝟙 Y) f = 𝟙 Y' := Limits.pullback.lift_snd _ _ _
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    obtain ⟨V⟩ := X
    let T : Y.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Y) (inferInstance : WeaklyEtale (𝟙 Y))
    let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    let β : Limits.pullback V.hom f ⟶ Limits.pullback (𝟙 Y) f := ((wcProEtBC f).map e).left
    have hβw : β ≫ Limits.pullback.snd (𝟙 Y) f = Limits.pullback.snd V.hom f :=
      MorphismProperty.Over.w ((wcProEtBC f).map e)
    have hβ : β = Limits.pullback.snd V.hom f ≫
        Limits.pullback.lift f (𝟙 Y') ((Category.comp_id f).trans (Category.id_comp f).symm) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
          Category.comp_id]
      · rw [Category.assoc, hlam2, Category.comp_id, hβw]
    let m1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    let mT : C(↥(Limits.pullback (𝟙 Y) f), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥Y, ULift.{u+1} ℚ_[ℓ]))
    have e1 : m1 = mT.comp β.base.hom :=
      PresheafOfModules.naturality_apply (wcSuppUnitMap D).val e.op (1 : C(↥Y, ULift.{u+1} ℚ_[ℓ]))
    have e3 : mT.comp (Limits.pullback.snd V.hom f ≫
        Limits.pullback.lift f (𝟙 Y')
          ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom =
        (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom f).base.hom :=
      ContinuousMap.ext fun _ => rfl
    have hL : m1 = (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom f).base.hom := by
      rw [e1, hβ, e3]
    let h := wcHMFun Y' ℓ (wcSuppTwist (wcSuppUnitMap D))
    let r1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom
        (1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]))
    have hR : r1 = (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom f).base.hom := by
      have e4 : r1 = (SheafOfModules.unitHomEquiv _ h).1 (Opposite.op ((wcProEtBC f).obj V)) :=
        (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm
      rw [e4]
      simp only [h]
      unfold wcHMFun
      rw [Equiv.apply_symm_apply]
      rfl
    show m1 = (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom
      ((D.φ.hom.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])))
    have key := congrArg (fun x => (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom x)
      ((D.φ.hom.app (Opposite.op V)).hom.map_one)
    exact hL.trans (hR.symm.trans key.symm)

  obtain ⟨c', hc'⟩ := hisUnit
  have hh1 : wcHMFun Y' ℓ (wcSuppTwist (wcSuppUnitMap D)) ≫ wcHMFun Y' ℓ c' = 𝟙 _ := by
    rw [← hfun.2, hc', hfun.1]
  have hμ : D.μ.hom = (D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) ≫
      wcHMFun Y' ℓ (wcSuppTwist (wcSuppUnitMap D)) := by
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
    exact hfactor
  have hμ0 : (D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) =
      D.μ.hom ≫ wcHMFun Y' ℓ c' := by
    rw [hμ, Category.assoc, hh1, Category.comp_id]
  refine ⟨⟨wcHMFun Y' ℓ (wcSuppTwist (wcSuppUnitMap D)) ≫ D.μ.inv, ?_, ?_⟩⟩
  · rw [← Category.assoc, ← hμ, Iso.hom_inv_id]
  · rw [hμ0]
    simp only [Category.assoc, Iso.inv_hom_id_assoc, hh1]

theorem wc_pmn_nbr_ext_mate_chase_gen {A : Type*} [Category A] [Abelian A] [HasExt A]
    {A' : Type*} [Category A'] [Abelian A'] [HasExt A']
    {B : Type*} [Category B] [Abelian B] [HasExt B]
    {C : Type*} [Category C] [Abelian C] [HasExt C]
    {Φw : A ⥤ A'} {Pw : A' ⥤ A} (adjw : Φw ⊣ Pw) {ΦD : B ⥤ C} {PD : C ⥤ B} (adjD : ΦD ⊣ PD)
    (ρ : A ⥤ B) (ρ' : A' ⥤ C)
    [Φw.Additive] [Limits.PreservesFiniteLimits Φw] [Limits.PreservesFiniteColimits Φw]
    [ΦD.Additive] [Limits.PreservesFiniteLimits ΦD] [Limits.PreservesFiniteColimits ΦD]
    [ρ.Additive] [Limits.PreservesFiniteLimits ρ] [Limits.PreservesFiniteColimits ρ]
    [ρ'.Additive] [Limits.PreservesFiniteLimits ρ'] [Limits.PreservesFiniteColimits ρ']
    (β : Pw ⋙ ρ ⟶ ρ' ⋙ PD) (X O : A) (X' O' : A') (OB : B) (OC : C)
    (ε : OB ⟶ ρ.obj X) (u : OB ⟶ ρ.obj O) [IsIso u]
    (ε' : OC ⟶ ρ'.obj X') (u' : OC ⟶ ρ'.obj O') [IsIso u']
    (κ : X' ⟶ Φw.obj X) (e : Φw.obj O ⟶ O') (ηw : O ⟶ Pw.obj O')
    (he : e = (adjw.homEquiv O O').symm ηw)
    (ηD : OB ⟶ PD.obj OC) [IsIso ((adjD.homEquiv OB OC).symm ηD)] (μ : ΦD.obj OB ≅ OC) :
    ε ≫ ρ.map (adjw.unit.app X) ≫ β.app (Φw.obj X) = ηD ≫ PD.map (ε' ≫ ρ'.map κ) →
    u ≫ ρ.map ηw ≫ β.app O' = ηD ≫ PD.map u' →
    (∀ (c : OC ⟶ OC) (n : ℕ) (y : Abelian.Ext OC OC n),
      (Abelian.Ext.mk₀ c).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ c) (add_zero n)) →
    ∀ (q : ℕ) (b : Abelian.Ext X O q),
      ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor ρ'
          ((Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Φw b).comp
            (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q))) (zero_add q)).comp
          (Abelian.Ext.mk₀ (inv u')) (add_zero q) =
        (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor ΦD
          (((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor ρ b) (zero_add q)).comp
            (Abelian.Ext.mk₀ (inv u)) (add_zero q))).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q))
          (zero_add q) :=
by
  intro H1 H2 Hc q b
  set ν := (adjD.homEquiv OB OC).symm ηD with hν
  have hνη : adjD.homEquiv OB OC ν = ηD := Equiv.apply_symm_apply _ _
  obtain ⟨σ, hU⟩ : ∃ σ : ρ ⋙ ΦD ⟶ Φw ⋙ ρ', ∀ M : A,
      ρ.map (adjw.unit.app M) ≫ β.app (Φw.obj M) =
        adjD.unit.app (ρ.obj M) ≫ PD.map (σ.app M) := by
    refine ⟨(mateEquiv adjw adjD).symm β, fun M => ?_⟩
    have := unit_mateEquiv adjw adjD ((mateEquiv adjw adjD).symm β) M
    have e0 : (mateEquiv adjw adjD) ((mateEquiv adjw adjD).symm β) = β :=
      (mateEquiv adjw adjD).apply_symm_apply β
    rw [e0] at this
    exact this
  have G1 : ΦD.map ε ≫ σ.app X = ν ≫ ε' ≫ ρ'.map κ := by
    have h1 : adjD.homEquiv OB (ρ'.obj (Φw.obj X)) (ΦD.map ε ≫ σ.app X) =
        ε ≫ adjD.unit.app (ρ.obj X) ≫ PD.map (σ.app X) := by
      rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_unit]
    have h2 : adjD.homEquiv OB (ρ'.obj (Φw.obj X)) (ν ≫ ε' ≫ ρ'.map κ) =
        ηD ≫ PD.map (ε' ≫ ρ'.map κ) := by
      rw [Adjunction.homEquiv_naturality_right, hνη]
    apply (adjD.homEquiv OB (ρ'.obj (Φw.obj X))).injective
    rw [h1, h2, ← hU X, H1]
  have hηw : adjw.unit.app O ≫ Pw.map e = ηw := by
    rw [he]
    exact (adjw.homEquiv_unit O O' _).symm.trans (Equiv.apply_symm_apply _ _)
  have hn : ρ.map (Pw.map e) ≫ β.app O' = β.app (Φw.obj O) ≫ PD.map (ρ'.map e) :=
    β.naturality e
  have hK : ρ.map ηw ≫ β.app O' =
      adjD.unit.app (ρ.obj O) ≫ PD.map (σ.app O ≫ ρ'.map e) := by
    calc ρ.map ηw ≫ β.app O'
        = ρ.map (adjw.unit.app O) ≫ (ρ.map (Pw.map e) ≫ β.app O') := by
          rw [← hηw, Functor.map_comp, Category.assoc]
      _ = (ρ.map (adjw.unit.app O) ≫ β.app (Φw.obj O)) ≫ PD.map (ρ'.map e) := by
          rw [hn, Category.assoc]
      _ = adjD.unit.app (ρ.obj O) ≫ PD.map (σ.app O ≫ ρ'.map e) := by
          rw [hU O, Category.assoc, Functor.map_comp]
  have G2 : ΦD.map u ≫ σ.app O ≫ ρ'.map e = ν ≫ u' := by
    have h1 : adjD.homEquiv OB (ρ'.obj O') (ΦD.map u ≫ σ.app O ≫ ρ'.map e) =
        u ≫ adjD.unit.app (ρ.obj O) ≫ PD.map (σ.app O ≫ ρ'.map e) := by
      rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_unit]
    have h2 : adjD.homEquiv OB (ρ'.obj O') (ν ≫ u') = ηD ≫ PD.map u' := by
      rw [Adjunction.homEquiv_naturality_right, hνη]
    apply (adjD.homEquiv OB (ρ'.obj O')).injective
    rw [h1, h2, ← hK, H2]
  have hZ : ΦD.map (inv u) ≫ μ.hom =
      σ.app O ≫ (ρ'.map e ≫ inv u' ≫ inv ν ≫ μ.hom) := by
    have h3 : σ.app O ≫ ρ'.map e = ΦD.map (inv u) ≫ ν ≫ u' := by
      rw [← G2, ← Category.assoc, ← Functor.map_comp, IsIso.inv_hom_id,
        CategoryTheory.Functor.map_id, Category.id_comp]
    rw [← Category.assoc, h3]
    simp
  have R0 : ∀ {P Q R S : C} {n : ℕ} (x : Abelian.Ext P Q n) (f : Q ⟶ R) (g : R ⟶ S),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro P Q R S n x f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have hnat : (Abelian.Ext.mapExactFunctor ΦD (Abelian.Ext.mapExactFunctor ρ b)).comp
      (Abelian.Ext.mk₀ (σ.app O)) (add_zero q) =
      (Abelian.Ext.mk₀ (σ.app X)).comp
        (Abelian.Ext.mapExactFunctor ρ' (Abelian.Ext.mapExactFunctor Φw b)) (zero_add q) := by
    rw [← Abelian.Ext.comp_mapExactFunctor, ← Abelian.Ext.comp_mapExactFunctor]
    exact Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp b σ
  have hRHS : (Abelian.Ext.mapExactFunctor ΦD (Abelian.Ext.mapExactFunctor ρ b)).comp
      (Abelian.Ext.mk₀ (ΦD.map (inv u) ≫ μ.hom)) (add_zero q) =
      (Abelian.Ext.mk₀ (σ.app X)).comp
        ((Abelian.Ext.mapExactFunctor ρ' (Abelian.Ext.mapExactFunctor Φw b)).comp
          (Abelian.Ext.mk₀ (ρ'.map e ≫ inv u' ≫ inv ν ≫ μ.hom)) (add_zero q)) (zero_add q) := by
    rw [hZ, ← R0, hnat, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hcc : (μ.inv ≫ ν) ≫ (inv ν ≫ μ.hom) = 𝟙 OC := by simp
  set L := ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor ρ'
          ((Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Φw b).comp
            (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q))) (zero_add q)).comp
          (Abelian.Ext.mk₀ (inv u')) (add_zero q) with hL
  have hcentral : L = (((Abelian.Ext.mk₀ (μ.inv ≫ ν)).comp L (zero_add q)).comp
      (Abelian.Ext.mk₀ (inv ν ≫ μ.hom)) (add_zero q)) := by
    rw [Hc (μ.inv ≫ ν) q L, R0, hcc, Abelian.Ext.comp_mk₀_id]
  rw [hcentral, hL]
  simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
  rw [hRHS]
  simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
  have ha : μ.inv ≫ ΦD.map ε ≫ σ.app X = μ.inv ≫ ν ≫ ε' ≫ ρ'.map κ := by
    rw [G1]
  rw [ha]

theorem wc_pmn_nbr_push_slice_nat {S Z W : Scheme.{u}} (i : Z ⟶ S) (w : W ⟶ Z) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw)
    (V : S.ProEt) (V' : W.ProEt) (fU : V'.left ⟶ V.left) (hK : fU ≫ V.hom = V'.hom ≫ w ≫ i)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor W V').IsContinuous (Scheme.ProEt.topology V'.left) (Scheme.ProEt.topology W)]
    (D : wcHMPullData fU ℓ) (hD : wcHMPullCanonical D) :
    ∃ β : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) ⋙
          wcSliceRes S ℓ V ⟶
        wcSliceRes W ℓ V' ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC fU) _ _ D.cont D.φ,
      ∀ (M : SheafOfModules.{u+1} (wcRingSheaf W ℓ)) (T : V.left.ProEt)
        (ζ : (wcSliceFunctor W V').obj ((wcProEtBC fU).obj T) ⟶
          (wcProEtBC w).obj ((wcProEtBC i).obj ((wcSliceFunctor S V).obj T))),
        ζ.left ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
            Limits.pullback.fst (T.hom ≫ V.hom) i = Limits.pullback.fst T.hom fU →
        ζ.left ≫ Limits.pullback.snd (Limits.pullback.snd (T.hom ≫ V.hom) i) w =
            Limits.pullback.snd T.hom fU ≫ V'.hom →
        ∀ x : ((wcSliceRes S ℓ V).obj
            ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj
              ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ).obj
                M))).val.obj (Opposite.op T),
          ((β.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x :=
by
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC h).map g).left ≫ Limits.pullback.snd B.hom h = Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have sqAux : ∀ {P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z : Scheme.{u}} (a : P₁ ⟶ P₂) (b : Q₁ ⟶ Q₂)
      (e₁ : P₁ ⟶ Q₁) (e₂ : P₂ ⟶ Q₂) (x₁ : P₁ ⟶ A₁) (x₂ : P₂ ⟶ A₂) (y₁ : P₁ ⟶ B₁) (y₂ : P₂ ⟶ B₂)
      (p₁ : Q₁ ⟶ A₁) (p₂ : Q₂ ⟶ A₂) (q₁ : Q₁ ⟶ Z) (q₂ : Q₂ ⟶ Z) (gA : A₁ ⟶ A₂) (v₁ : B₁ ⟶ Z)
      (v₂ : B₂ ⟶ Z) (hext : ∀ φ ψ : P₁ ⟶ Q₂, φ ≫ p₂ = ψ ≫ p₂ → φ ≫ q₂ = ψ ≫ q₂ → φ = ψ)
      (h1 : e₁ ≫ p₁ = x₁) (h2 : e₂ ≫ p₂ = x₂) (h3 : e₁ ≫ q₁ = y₁ ≫ v₁) (h4 : e₂ ≫ q₂ = y₂ ≫ v₂)
      (ha1 : a ≫ x₂ = x₁ ≫ gA) (ha2 : a ≫ y₂ ≫ v₂ = y₁ ≫ v₁) (hb1 : b ≫ p₂ = p₁ ≫ gA)
      (hb2 : b ≫ q₂ = q₁),
      a ≫ e₂ = e₁ ≫ b := by
    intro P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z a b e₁ e₂ x₁ x₂ y₁ y₂ p₁ p₂ q₁ q₂ gA v₁ v₂ hext h1 h2 h3 h4
      ha1 ha2 hb1 hb2
    apply hext
    · rw [Category.assoc, Category.assoc, h2, ha1, hb1, ← Category.assoc, h1]
    · rw [Category.assoc, Category.assoc, h4, ha2, hb2, h3]

  have hin : ∀ T : V.left.ProEt, Limits.pullback.fst T.hom fU ≫ (T.hom ≫ V.hom) =
      (Limits.pullback.snd T.hom fU ≫ V'.hom ≫ w) ≫ i := by
    intro T
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hK]
    simp only [Category.assoc]
  have hlam : ∀ T : V.left.ProEt, ∃ l : Limits.pullback T.hom fU ⟶
      Limits.pullback (T.hom ≫ V.hom) i,
      l ≫ Limits.pullback.fst (T.hom ≫ V.hom) i = Limits.pullback.fst T.hom fU ∧
      l ≫ Limits.pullback.snd (T.hom ≫ V.hom) i = Limits.pullback.snd T.hom fU ≫ (V'.hom ≫ w) :=
    fun T => ⟨Limits.pullback.lift _ _ (hin T), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  choose lam hlam1 hlam2 using hlam
  have hout : ∀ T : V.left.ProEt, lam T ≫ Limits.pullback.snd (T.hom ≫ V.hom) i =
      (Limits.pullback.snd T.hom fU ≫ V'.hom) ≫ w := by
    intro T
    rw [hlam2, Category.assoc]
  have ha0 : ∀ T : V.left.ProEt, ∃ a : Limits.pullback T.hom fU ⟶
      Limits.pullback (Limits.pullback.snd (T.hom ≫ V.hom) i) w,
      a ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w = lam T ∧
      a ≫ Limits.pullback.snd (Limits.pullback.snd (T.hom ≫ V.hom) i) w =
        Limits.pullback.snd T.hom fU ≫ V'.hom :=
    fun T => ⟨Limits.pullback.lift _ _ (hout T), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  choose a0 ha01 ha02 using ha0
  have ha0fa : ∀ T : V.left.ProEt,
      a0 T ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
        Limits.pullback.fst (T.hom ≫ V.hom) i = Limits.pullback.fst T.hom fU := by
    intro T
    rw [← Category.assoc, ha01, hlam1]
  let α : wcProEtBC fU ⋙ wcSliceFunctor W V' ⟶
      (wcSliceFunctor S V ⋙ wcProEtBC i) ⋙ wcProEtBC w :=
    { app := fun T => MorphismProperty.Over.homMk (a0 T) (ha02 T) trivial
      naturality := by
        intro T₁ T₂ g
        have hm1 : ((wcProEtBC fU).map g).left ≫ Limits.pullback.fst T₂.hom fU =
            Limits.pullback.fst T₁.hom fU ≫ g.left := hBCfst fU g
        have hm2 : ((wcProEtBC fU).map g).left ≫ Limits.pullback.snd T₂.hom fU =
            Limits.pullback.snd T₁.hom fU := hBCsnd fU g
        have hn1 : ((wcProEtBC i).map ((wcSliceFunctor S V).map g)).left ≫
            Limits.pullback.fst (T₂.hom ≫ V.hom) i =
              Limits.pullback.fst (T₁.hom ≫ V.hom) i ≫ g.left :=
          hBCfst i ((wcSliceFunctor S V).map g)
        have hn2 : ((wcProEtBC i).map ((wcSliceFunctor S V).map g)).left ≫
            Limits.pullback.snd (T₂.hom ≫ V.hom) i = Limits.pullback.snd (T₁.hom ≫ V.hom) i :=
          hBCsnd i ((wcSliceFunctor S V).map g)
        have hk1 : ((wcProEtBC w).map ((wcProEtBC i).map ((wcSliceFunctor S V).map g))).left ≫
            Limits.pullback.fst (Limits.pullback.snd (T₂.hom ≫ V.hom) i) w =
              Limits.pullback.fst (Limits.pullback.snd (T₁.hom ≫ V.hom) i) w ≫
                ((wcProEtBC i).map ((wcSliceFunctor S V).map g)).left :=
          hBCfst w ((wcProEtBC i).map ((wcSliceFunctor S V).map g))
        have hk2 : ((wcProEtBC w).map ((wcProEtBC i).map ((wcSliceFunctor S V).map g))).left ≫
            Limits.pullback.snd (Limits.pullback.snd (T₂.hom ≫ V.hom) i) w =
              Limits.pullback.snd (Limits.pullback.snd (T₁.hom ≫ V.hom) i) w :=
          hBCsnd w ((wcProEtBC i).map ((wcSliceFunctor S V).map g))
        have hinner : ((wcProEtBC fU).map g).left ≫ lam T₂ =
            lam T₁ ≫ ((wcProEtBC i).map ((wcSliceFunctor S V).map g)).left :=
          sqAux _ _ _ _ _ _ _ _ _ _ _ _ g.left (V'.hom ≫ w) (V'.hom ≫ w)
            (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
            (hlam1 T₁) (hlam1 T₂) (hlam2 T₁) (hlam2 T₂) hm1
            ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ (V'.hom ≫ w)) hm2)) hn1 hn2
        apply MorphismProperty.Over.Hom.ext
        exact sqAux _ _ _ _ _ _ _ _ _ _ _ _ _ V'.hom V'.hom
          (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
          (ha01 T₁) (ha01 T₂) (ha02 T₁) (ha02 T₂) hinner
          ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ V'.hom) hm2)) hk1 hk2 }

  haveI := Di.cont
  haveI := Dw.cont
  haveI := D.cont
  haveI : (wcSliceFunctor S V ⋙ wcProEtBC i).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology Z) := Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S) _
  haveI : ((wcSliceFunctor S V ⋙ wcProEtBC i) ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology W) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology Z) _
  haveI : (wcProEtBC fU ⋙ wcSliceFunctor W V').IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology W) := Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology V'.left) _
  let φ₀ : wcRingSheaf V.left ℓ ⟶ ((wcSliceFunctor S V ⋙ wcProEtBC i).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Z)).obj
        (wcRingSheaf Z ℓ) :=
    (𝟙 (wcRingSheaf V.left ℓ)) ≫ ((wcSliceFunctor S V).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).map Di.φ
  let φG : wcRingSheaf V.left ℓ ⟶
      (((wcSliceFunctor S V ⋙ wcProEtBC i) ⋙ wcProEtBC w).sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology W)).obj
          (wcRingSheaf W ℓ) :=
    φ₀ ≫ ((wcSliceFunctor S V ⋙ wcProEtBC i).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Z)).map Dw.φ
  let φF : wcRingSheaf V.left ℓ ⟶ ((wcProEtBC fU ⋙ wcSliceFunctor W V').sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology W)).obj
        (wcRingSheaf W ℓ) :=
    D.φ ≫ ((wcProEtBC fU).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology V'.left)).map
        (𝟙 (wcRingSheaf V'.left ℓ))
  have h : φG ≫ (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology W)).app (wcRingSheaf W ℓ) = φF := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    cases T with
    | op T =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    have e1 := hDi ((wcSliceFunctor S V).obj T) s
    have e3 := hD T s
    change ((Dw.φ.hom.app (Opposite.op ((wcProEtBC i).obj ((wcSliceFunctor S V).obj T)))).hom
        ((Di.φ.hom.app (Opposite.op ((wcSliceFunctor S V).obj T))).hom s)).comp
          (a0 T).base.hom = (D.φ.hom.app (Opposite.op T)).hom s
    rw [e1]
    have e2 := hDw ((wcProEtBC i).obj ((wcSliceFunctor S V).obj T))
      (s.comp (Limits.pullback.fst ((wcSliceFunctor S V).obj T).hom i).base.hom)
    erw [e2]
    rw [e3, ← ha0fa T]
    rfl
  refine ⟨(Functor.associator _ _ _).hom ≫
      (Functor.isoWhiskerLeft
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ)
        (SheafOfModules.pushforwardComp (F := wcSliceFunctor S V) (G := wcProEtBC i)
          (S := wcRingSheaf V.left ℓ) (R := wcRingSheaf S ℓ) (R' := wcRingSheaf Z ℓ)
          (𝟙 (wcRingSheaf V.left ℓ)) Di.φ)).hom ≫
      (SheafOfModules.pushforwardComp (F := wcSliceFunctor S V ⋙ wcProEtBC i) (G := wcProEtBC w)
          (S := wcRingSheaf V.left ℓ) (R := wcRingSheaf Z ℓ) (R' := wcRingSheaf W ℓ)
          φ₀ Dw.φ).hom ≫
      SheafOfModules.pushforwardNatTrans φG α ≫
      (SheafOfModules.pushforwardCongr h).hom ≫
      (SheafOfModules.pushforwardComp (F := wcProEtBC fU) (G := wcSliceFunctor W V')
          (S := wcRingSheaf V.left ℓ) (R := wcRingSheaf V'.left ℓ) (R' := wcRingSheaf W ℓ)
          D.φ (𝟙 (wcRingSheaf V'.left ℓ))).inv, ?_⟩
  intro M T ζ h1 h2 x
  have k1 : ζ.left ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
      Limits.pullback.fst (T.hom ≫ V.hom) i =
        a0 T ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
          Limits.pullback.fst (T.hom ≫ V.hom) i := h1.trans (ha0fa T).symm
  have k2 : ζ.left ≫ Limits.pullback.snd (Limits.pullback.snd (T.hom ≫ V.hom) i) w =
      a0 T ≫ Limits.pullback.snd (Limits.pullback.snd (T.hom ≫ V.hom) i) w :=
    h2.trans (ha02 T).symm
  have k3 : ζ.left ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
      Limits.pullback.snd (T.hom ≫ V.hom) i =
        a0 T ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
          Limits.pullback.snd (T.hom ≫ V.hom) i := by
    have hc := Limits.pullback.condition (f := Limits.pullback.snd (T.hom ≫ V.hom) i) (g := w)
    exact (congrArg (ζ.left ≫ ·) hc).trans ((Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ w) k2).trans ((Category.assoc _ _ _).trans
        (congrArg (a0 T ≫ ·) hc.symm))))
  have key : ζ = α.app T := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.hom_ext
      (Limits.pullback.hom_ext ((Category.assoc _ _ _).trans (k1.trans (Category.assoc _ _ _).symm))
        ((Category.assoc _ _ _).trans (k3.trans (Category.assoc _ _ _).symm))) k2
  subst key
  exact SheafOfModules.pushforwardNatTrans_app_val_app φG α M (Opposite.op T) x

theorem wc_pmn_nbr_bc_unit_compat {S Z W : Scheme.{u}} (i : Z ⟶ S) (w : W ⟶ Z) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw)
    (V : S.ProEt) (V' : W.ProEt) (fU : V'.left ⟶ V.left) (hK : fU ≫ V.hom = V'.hom ≫ w ≫ i)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor W V').IsContinuous (Scheme.ProEt.topology V'.left) (Scheme.ProEt.topology W)]
    (D : wcHMPullData fU ℓ) (hD : wcHMPullCanonical D)
    (X' : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (evX' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (X' ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnatX' : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (k : X' ⟶ M),
      evX' N (k ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (evX' M k))
    (PU : SheafOfModules.{u+1} (wcRingSheaf W ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf W ℓ), (PU ⟶ M) ≃ M.val.obj (Opposite.op V'))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf W ℓ)) (ψ : M ⟶ N) (g : PU ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op V')).hom (ev M g))
    (β : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) ⋙
          wcSliceRes S ℓ V ⟶
        wcSliceRes W ℓ V' ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC fU) _ _ D.cont D.φ)
    (hβ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf W ℓ)) (T : V.left.ProEt)
        (ζ : (wcSliceFunctor W V').obj ((wcProEtBC fU).obj T) ⟶
          (wcProEtBC w).obj ((wcProEtBC i).obj ((wcSliceFunctor S V).obj T))),
