  have chase : ∀ {SC : ShortComplex (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ))}
      (hS : SC.ShortExact) {Y₁ Y₂ : SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)}
      (g : Y₁ ⟶ Y₂) (q : ℕ)
      (_c₂ : ∀ w : Abelian.Ext SC.X₂ Y₂ q, ∃ (b : ℕ) (w₀ : Abelian.Ext SC.X₂ Y₁ q),
        (ℓ ^ b : ℕ) • w = w₀.comp (Abelian.Ext.mk₀ g) (add_zero q))
      (_k₁ : ∀ x : Abelian.Ext SC.X₁ Y₁ q, x.comp (Abelian.Ext.mk₀ g) (add_zero q) = 0 →
        ∃ e : ℕ, (ℓ ^ e : ℕ) • x = 0)
      (_c₁ : ∀ q₀ : ℕ, q₀ + 1 = q → ∀ w : Abelian.Ext SC.X₁ Y₂ q₀,
        ∃ (b : ℕ) (w₀ : Abelian.Ext SC.X₁ Y₁ q₀),
          (ℓ ^ b : ℕ) • w = w₀.comp (Abelian.Ext.mk₀ g) (add_zero q₀)),
      ∀ u' : Abelian.Ext SC.X₃ Y₂ q, ∃ (N : ℕ) (x : Abelian.Ext SC.X₃ Y₁ q),
