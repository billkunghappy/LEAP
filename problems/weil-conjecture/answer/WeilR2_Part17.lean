theorem wc_et_pull_bij_of_shens_fibres : ∀ (E S P X : Scheme.{u}) (f : E ⟶ S) [IsAffineHom f] [Surjective f] (pr : P ⟶ S) (fX : X ⟶ E) (g : X ⟶ P), IsPullback fX g f pr → ∀ (m : ℕ), m ≠ 0 → (∀ (p : P) (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P p)) (Scheme.Etale.forget P)) (φ : ∀ l, Spec (.of C) ⟶ (W'.obj l).right.left) (ap : Spec (.of C) ⟶ P), wcHalShData p C Λ W' φ ap → Nat.card (wcEtCoh (Limits.pullback f (ap ≫ pr)) m 0) = m ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback f (ap ≫ pr)) m q)) → ∀ (D : wcEtPullData g m) (j : ℕ), Function.Bijective (wcEtPull D j) :=
by
  intro E S P X f _ _ pr fX g h m hm H D j
  classical
  haveI : IsAffineHom g := MorphismProperty.of_isPullback (P := @IsAffineHom) h inferInstance
  haveI : Surjective g := MorphismProperty.of_isPullback (P := @Surjective) h inferInstance

  have hfib : ∀ (p : P) (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P p)) (Scheme.Etale.forget P))
      (φ : ∀ l, Spec (.of C) ⟶ (W'.obj l).right.left) (ap : Spec (.of C) ⟶ P),
      wcHalShData p C Λ W' φ ap → ∀ q : ℕ,
      Nonempty (wcEtCoh (Limits.pullback f (ap ≫ pr)) m q ≃ wcEtCoh (Limits.pullback g ap) m q) := by
    intro p C _ _ _ Λ _ _ W' φ ap _ q
    have sq := IsPullback.paste_vert (IsPullback.of_hasPullback g ap).flip h.flip
    exact wc_et_coh_iso_invariance sq.flip.isoPullback.hom m q
  have H0 : ∀ (p : P) (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P p)) (Scheme.Etale.forget P))
      (φ : ∀ l, Spec (.of C) ⟶ (W'.obj l).right.left) (ap : Spec (.of C) ⟶ P),
      wcHalShData p C Λ W' φ ap → Nat.card (wcEtCoh (Limits.pullback g ap) m 0) = m := by
    intro p C _ _ _ Λ _ _ W' φ ap hd
    obtain ⟨e⟩ := hfib p C Λ W' φ ap hd 0
    rw [← Nat.card_congr e]
    exact (H p C Λ W' φ ap hd).1
  have Hq : ∀ (p : P) (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P p)) (Scheme.Etale.forget P))
      (φ : ∀ l, Spec (.of C) ⟶ (W'.obj l).right.left) (ap : Spec (.of C) ⟶ P),
      wcHalShData p C Λ W' φ ap → ∀ q : ℕ, 1 ≤ q →
        Subsingleton (wcEtCoh (Limits.pullback g ap) m q) := by
    intro p C _ _ _ Λ _ _ W' φ ap hd q hq
    obtain ⟨e⟩ := hfib p C Λ W' φ ap hd q
    haveI := (H p C Λ W' φ ap hd).2 q hq
    exact e.symm.subsingleton
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology X) (wcEtZModRing X m)
  let I := InjectiveResolution.of (SheafOfModules.unit (wcEtZModRing X m))
  have hR := wc_et_mod_push_higher_isZero_of_shens_fibres g m hm D I Hq
  have hu := wc_et_supp_unit_isIso_of_shens_h0 g m hm D H0
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).Additive :=
    Adjunction.right_adjoint_additive D.adj
  have hunit : IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing P m))) := by
    haveI : IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing P m)) ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).map D.μ.hom) := hu
    exact IsIso.of_isIso_comp_right _
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).map D.μ.hom)
  exact wc_ext_map_bijective_of_degenerate_leray D.Φ _ D.adj _ _ D.μ hunit I hR j

theorem wc_pltr_shdata_iso_transport : ∀ {Y : Scheme.{u}} (y : Y) (B R : Type u) [CommRing B] [IsLocalRing B] [CommRing R] [IsLocalRing R] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (δ : Spec (.of R) ⟶ Spec (.of B)), IsIso δ → ∀ (ε : IsLocalRing.ResidueField R →+* AlgebraicClosure (Y.residueField y)), ε.IsIntegral → Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) ≫ δ ≫ a = wcEtGeomPt Y y → wcHalShData y R Λ W' (fun l => δ ≫ φ l) (δ ≫ a) :=
by
  intro Y y B R _ _ _ _ Λ _ _ W' φ a h δ hδ ε hε heq
  haveI := hδ
  obtain ⟨h1, h2, h3, h4, h5, -⟩ := h
  refine ⟨h1, h2, ?_, ?_, ?_, ε, hε, heq⟩
  · intro l l' t
    show (δ ≫ φ l) ≫ (W'.map t).right.left = δ ≫ φ l'
    rw [Category.assoc, h3 t]
  · intro l
    show (δ ≫ φ l) ≫ (W'.obj l).right.hom = δ ≫ a
    rw [Category.assoc, h4 l]
  · intro T z hz
    obtain ⟨z₀, hz₀, huniq⟩ := h5 T z hz
    refine ⟨z₀ ≫ inv δ, fun l => ?_, fun w hw => ?_⟩
    · show (z₀ ≫ inv δ) ≫ δ ≫ φ l = z l
      rw [Category.assoc, IsIso.inv_hom_id_assoc, hz₀ l]
    · have hw' : w ≫ δ = z₀ := huniq (w ≫ δ) (fun l => by
        rw [Category.assoc]
        exact hw l)
      exact (IsIso.eq_comp_inv δ).mpr hw'

theorem wc_qmssl_cb_vertex_proj : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) → ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), WeaklyEtale a₀ → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : HenselianLocalRing B₀) (_ : IsSepClosed (IsLocalRing.ResidueField B₀)) (h₀ : Spec (.of B₀) ⟶ Spec (.of A)) (β : Spec (.of B) ⟶ Spec (.of B₀)) (w : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Fin r) B₀))), a₀ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = β ≫ h₀ ∧ w ≫ Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀))) = β ∧ WeaklyEtale w ∧ IsUnit ((ℓ : ℕ) : B₀) ∧ ∀ z : Spec (.of B), Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ z) → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ z) → β z = IsLocalRing.closedPoint B₀ :=
