    have hχ : χ ⟨0, by omega⟩ * χ ⟨1, by omega⟩ = algebraMap A (MvPolynomial (Fin r) Q2) π := by
      simp only [χ, dite_true, one_ne_zero, dite_false]
      rw [← map_mul, MvPolynomial.algebraMap_apply]
      congr 1
      exact relH 2 (by norm_num)
    let Φ : Qr →ₐ[A] MvPolynomial (Fin r) Q2 :=
      Ideal.Quotient.liftₐ _ (MvPolynomial.aeval χ) (liftH (r + 2) (by omega) _ χ hχ)
    have hΦX : ∀ j : Fin (r + 2), Φ (Ideal.Quotient.mk Ir (MvPolynomial.X j)) = χ j := by
      intro j
      rw [Ideal.Quotient.liftₐ_apply]
      erw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.aeval_X _ _
    let Ψ : MvPolynomial (Fin r) Q2 →+* Qr :=
      MvPolynomial.eval₂Hom (ι : Q2 →+* Qr) (fun k : Fin r =>
        Ideal.Quotient.mk Ir (MvPolynomial.X ⟨k.val + 2, by omega⟩))
    have hΦι : ∀ q : Q2, Φ (ι q) = MvPolynomial.C q := by
      intro q
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
      induction f using MvPolynomial.induction_on with
      | C a =>
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, AlgHom.commutes,
          AlgHom.commutes, MvPolynomial.algebraMap_apply]
      | add f g hf hg => rw [map_add, map_add, map_add, hf, hg, map_add]
      | mul_X f p hf =>
        rw [map_mul, map_mul, map_mul, hf, hιX, hΦX, map_mul]
        congr 1
        fin_cases p
        · exact dif_pos rfl
        · exact (dif_neg one_ne_zero).trans (dif_pos rfl)
    have hΦΨ : Φ.toRingHom.comp Ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro q
        simp only [RingHom.comp_apply, Ψ, MvPolynomial.eval₂Hom_C, RingHom.id_apply]
        exact hΦι q
      · intro k
        simp only [RingHom.comp_apply, Ψ, MvPolynomial.eval₂Hom_X', RingHom.id_apply]
        erw [hΦX]
        have h0 : k.val + 2 ≠ 0 := by omega
        have h1 : k.val + 2 ≠ 1 := by omega
        simp only [χ, h0, h1, dite_false]
        congr 1
    have hΨΦ : Ψ.comp Φ.toRingHom = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
        erw [AlgHom.commutes]
        rw [MvPolynomial.algebraMap_apply]
        simp only [Ψ, MvPolynomial.eval₂Hom_C]
        exact AlgHom.commutes ι a
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply]
        erw [hΦX]
        rcases j with ⟨_ | _ | k, hk⟩
        · show Ψ (MvPolynomial.C (Ideal.Quotient.mk I2 (MvPolynomial.X 0))) = _
          simp only [Ψ, MvPolynomial.eval₂Hom_C]
          exact hιX 0
        · show Ψ (MvPolynomial.C (Ideal.Quotient.mk I2 (MvPolynomial.X 1))) = _
          simp only [Ψ, MvPolynomial.eval₂Hom_C]
          exact hιX 1
        · have h0 : k + 2 ≠ 0 := by omega
          have h1 : k + 2 ≠ 1 := by omega
          simp only [χ, Fin.val_mk, h0, h1, dite_false]
          simp only [Ψ, MvPolynomial.eval₂Hom_X']
          rfl
    have hΨbij : Function.Bijective Ψ := by
      refine Function.bijective_iff_has_inverse.mpr ⟨Φ, fun x => ?_, fun x => ?_⟩
      · exact congrArg (fun h => h x) hΦΨ
      · exact congrArg (fun h => h x) hΨΦ
    have hιeq : (ι : Q2 →+* Qr) = Ψ.comp (algebraMap Q2 (MvPolynomial (Fin r) Q2)) := by
      refine RingHom.ext fun q => ?_
      show (ι : Q2 →+* Qr) q = Ψ (MvPolynomial.C q)
      simp only [Ψ, MvPolynomial.eval₂Hom_C]
