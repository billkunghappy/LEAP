  intro A _ _ _ _ _ ℓ _ hℓ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 L _ _ φA hφA halg XE p q hpb
    Xs ι s hps Y iY kY hY Dp hDp Di hDi I O hO Dj hDj n hn
  intro P
  haveI := Dp.additive
  obtain ⟨j, rfl⟩ : ∃ j, n = j + 1 := ⟨n - 1, by omega⟩

  have gen : ∀ (R' : Type u) [CommRing R'] (a : Spec (.of B) ⟶ Spec (.of R')) (f g : R')
      (k' : Y ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g}))),
      IsPullback iY k' ι (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g})))) →
      ∀ z : Xs, z ∉ Set.range iY →
