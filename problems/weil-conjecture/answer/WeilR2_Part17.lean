          (c.comp (Opposite.unop W).hom.base.hom :
            C(↥((Opposite.unop W).left), ULift.{u+1} ℤ_[ℓ])) := by
        intro S c W
        simp only [wcIntFun, Equiv.apply_symm_apply]
        rfl

