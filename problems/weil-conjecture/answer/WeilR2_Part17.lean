  haveI : Surjective β := C5 B₀ B β hflat hβB
  haveI : Surjective (c ≫ β) := C5 B₀ C (c ≫ β) hflat2 hloc2
  haveI : IsAffineHom β := isAffineHom_of_isAffine β
  haveI : IsAffineHom (c ≫ β) := isAffineHom_of_isAffine (c ≫ β)

  have hwpt : Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))
