    obtain ⟨Kz, hKz, ⟨eZ⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isLE
      (((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0))⟦N⟧)⟦M⟧) (-M)
    let ιL : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).obj
