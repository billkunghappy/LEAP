    by_contra hcon
    simp only [not_or, not_not] at hcon
    obtain ⟨hf, hg⟩ := hcon
    apply hz
    have e : a (ι z) = Spec.map (Spec.preimage a) (ι z) := by rw [Spec.map_preimage]
    rw [e, Spec.map_apply] at hf hg
    have hf' : (Spec.preimage a).hom f ∈ (ι z).asIdeal := hf
    have hg' : (Spec.preimage a).hom g ∈ (ι z).asIdeal := hg
    have hJ : Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g} ≤ (ι z).asIdeal := by
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨hf', hg'⟩
    haveI : (ι z).asIdeal.IsPrime := (ι z).isPrime
    let Q : PrimeSpectrum (B ⧸ Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g}) :=
      ⟨Ideal.map (Ideal.Quotient.mk _) (ι z).asIdeal,
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker]; exact hJ)⟩
    have hQ : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
        (Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g}))) Q = ι z := by
      refine (Spec.map_apply (CommRingCat.ofHom (Ideal.Quotient.mk
        (Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g}))) Q).trans
        (PrimeSpectrum.ext ?_)
      show Ideal.comap (Ideal.Quotient.mk _) (Ideal.map (Ideal.Quotient.mk _) (ι z).asIdeal) = _
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr hJ]
    have hr : z ∈ Set.range (Limits.pullback.fst ι (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk
          (Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g}))))) := by
      rw [Scheme.Pullback.range_fst]
      exact ⟨Q, hQ⟩
    obtain ⟨w, hw⟩ := hr
    refine ⟨hk.isoPullback.inv w, ?_⟩
    rw [← hw, ← Scheme.Hom.comp_apply, hk.isoPullback_inv_fst]
  have key := gen _ a₀ _ _ kY hY

  haveI hQm : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip hQm

  have hclA : ∀ z : Xs, wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
      (a₀ (ι z)) = IsLocalRing.closedPoint A := by
    intro z
    have h1 : (ι ≫ a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) z =
        (s ≫ wcQmSp A) z := by rw [hps.w]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    rw [h1]
    have hs : s z = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField A)) _ _
    rw [hs]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)

  let k := O.ι ≫ ι
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists k ℓ
  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso ι O.ι k rfl Di hDi Dj hDj Dk hDk
  refine Limits.IsZero.of_iso ?_ (c.app _).symm
  apply wc_proet_pull_isZero_of_local_death k ℓ Dk
  intro W sec
  refine ⟨_, wc_proet_closed_open_thickening_sieve ι O ((wcProEtBC k).obj W), ?_⟩
  rintro U e' ⟨T, g, θ, ⟨Vt, ιt, hVt, hclos, hsurj⟩, rfl⟩
  obtain ⟨c₀, hc₀⟩ := hsurj W (ιt.hom ≫ θ)
  have hc₀' : (wcProEtBC k).map c₀ = ιt.hom ≫ θ := hc₀
  refine ⟨Vt, c₀, g ≫ ιt.inv, ?_, ?_⟩
  · rw [Category.assoc, hc₀', Iso.inv_hom_id_assoc]
  · have hVaff : IsAffine Vt.left := hVt.1
    have hAH : IsAffineHom p :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip
        (inferInstance : IsAffineHom (Spec.map (CommRingCat.ofHom φA)))
    have hYaff : IsAffine ((wcProEtBC p).obj Vt).left :=
      @AlgebraicGeometry.instIsAffinePullbackSchemeOfIsAffineHom_1 _ _ _ Vt.hom p hAH hVaff

    have hpt : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
        ∃ z ∈ O, Vt.hom x = ι z := by
      intro x hx
      obtain ⟨pp, hpp⟩ := hclos x hx
      refine ⟨O.ι (Limits.pullback.snd Vt.hom k pp), ?_, ?_⟩
      · have hm : O.ι (Limits.pullback.snd Vt.hom k pp) ∈ Set.range O.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at hm
      · rw [← hpp]
        have h1 : (Limits.pullback.fst Vt.hom k ≫ Vt.hom) pp =
            (Limits.pullback.snd Vt.hom k ≫ k) pp := by rw [Limits.pullback.condition]
        exact h1

    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    haveI hW : WeaklyEtale (Vt.hom ≫ a₀) :=
      MorphismProperty.comp_mem (W := @WeaklyEtale) _ _ Vt.prop ha₀
    let Vt' := Scheme.ProEt.mk (Vt.hom ≫ a₀)
    have hVt'x : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
        ∃ z ∈ O, Vt'.hom x = a₀ (ι z) := by
      intro x hx
      obtain ⟨z, hz, hxz⟩ := hpt x hx
      refine ⟨z, hz, ?_⟩
      show (Vt.hom ≫ a₀) x = _
      rw [Scheme.Hom.comp_apply, hxz]
    have hsm' : ∀ x : Vt'.left, IsClosed ({x} : Set Vt'.left) →
        ∃ U : (Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))).Opens,
          Vt'.hom x ∈ U ∧ Smooth (U.ι ≫ wcQuadModelStr A (r + 2) π
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
      intro x hx
      obtain ⟨z, hz, hxz⟩ := hVt'x x hx
      rw [hxz]
      exact wc_qmssl_offdouble_smooth A r π (a₀ (ι z)) (key z (hO z hz))
    have hcl' : ∀ x : Vt'.left, IsClosed ({x} : Set Vt'.left) →
        wcQuadModelStr A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
          (Vt'.hom x) = IsLocalRing.closedPoint A := by
      intro x hx
      obtain ⟨z, hz, hxz⟩ := hVt'x x hx
      rw [hxz]
      exact hclA z
    have htube := fun j' : ℕ => wc_wstrict_smooth_tube_et_vanish A _ L
      (Spec.map (CommRingCat.ofHom φA)) ℓ hℓ Vt' hVt hsm' hcl' j'

    have hsq := (IsPullback.paste_horiz (IsPullback.of_hasPullback Vt.hom p).flip hpb.flip).flip
    rw [← Category.assoc] at hsq
    let eP := hsq.isoPullback
    have hYet : ∀ j' : ℕ, Subsingleton (wcEtCoh ((wcProEtBC p).obj Vt).left ℓ (j' + 1)) := by
      intro j'
      obtain ⟨eqv⟩ := wc_et_coh_iso_invariance eP.hom ℓ (j' + 1)
      have h := htube j'
      first
        | exact @Equiv.subsingleton _ _ eqv.symm h
        | (refine @Equiv.subsingleton _ _ eqv.symm ?_
           convert h using 3 <;> simp [Category.assoc])

    exact wc_proet_push_homology_section_local_death p ℓ Dp I (j + 1) Vt
      (wc_proet_free_projective_wcontractible _ Vt hVt)
      (@wc_hm_vanish_of_et_vanish_affine _ hYaff ℓ _ hYet j) _

theorem wc_qmssl_ry_closed_pull_unit_of_top_sections {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (m : M.val.obj (Opposite.op (Scheme.ProEt.mk (𝟙 X))))
    (hm : ∀ (Vt : X.ProEt),
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) →
      Function.Bijective (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) =>
        r • (M.val.map (@Quiver.Hom.op X.ProEt _ _ _
          (MorphismProperty.Over.homMk (A := Vt) (B := Scheme.ProEt.mk (𝟙 X)) Vt.hom
            (Category.comp_id _) trivial))).hom m)) :
    Nonempty (Di.Φ.obj M ≅ SheafOfModules.unit (wcRingSheaf Z ℓ)) :=
by
  classical
  haveI := Di.cont
  let toTop : ∀ V : X.ProEt, V ⟶ Scheme.ProEt.mk (𝟙 X) := fun V =>
    MorphismProperty.Over.homMk (A := V) (B := Scheme.ProEt.mk (𝟙 X)) V.hom
      (Category.comp_id _) trivial
  let s : ∀ W : X.ProEtᵒᵖ, M.val.obj W := fun W => (M.val.map (toTop W.unop).op).hom m
  have hs : ∀ ⦃W W' : X.ProEtᵒᵖ⦄ (f : W ⟶ W'), (M.val.map f).hom (s W) = s W' := by
    intro W W' f
    have heq : (toTop W.unop).op ≫ f = (toTop W'.unop).op := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact MorphismProperty.Over.w f.unop
    show (M.val.map f).hom ((M.val.map (toTop W.unop).op).hom m) =
      (M.val.map (toTop W'.unop).op).hom m
    rw [← PresheafOfModules.map_comp_apply]
    exact congrArg (fun φ : Opposite.op (Scheme.ProEt.mk (𝟙 X)) ⟶ W' =>
      ((M.val.map φ).hom m : M.val.obj W')) heq
  let g : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ M :=
    (SheafOfModules.unitHomEquiv M).symm (PresheafOfModules.sectionsMk s hs)
  have hg : ∀ (Vt : X.ProEt) (r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt)),
      (g.val.app (Opposite.op Vt)).hom r = r • (M.val.map (toTop Vt).op).hom m := by
    intro Vt r
    have h1 := SheafOfModules.unitHomEquiv_apply_coe M
      ((SheafOfModules.unitHomEquiv M).symm (PresheafOfModules.sectionsMk s hs)) (Opposite.op Vt)
    rw [Equiv.apply_symm_apply, PresheafOfModules.sectionsMk_coe] at h1
    have e1 : (g.val.app (Opposite.op Vt)).hom r =
        (g.val.app (Opposite.op Vt)).hom (r * (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt))) :=
      congrArg (fun x : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) =>
        (g.val.app (Opposite.op Vt)).hom x) (mul_one r).symm
    have e2 : (g.val.app (Opposite.op Vt)).hom (r * (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt))) =
        r • (g.val.app (Opposite.op Vt)).hom (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt)) :=
      LinearMap.map_smul (g.val.app (Opposite.op Vt)).hom r _
    have e3 : (g.val.app (Opposite.op Vt)).hom (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt)) =
        s (Opposite.op Vt) := h1.symm
    exact e1.trans (e2.trans (congrArg (fun y => r • y) e3))
  let α := (SheafOfModules.toSheaf _).map (Di.Φ.map g)
  haveI hα : IsIso α := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_pmn_vp_thick_cover i ℓ Di hDi U)
    intro T f hf
    obtain ⟨Vt, κ, hW, hcl, hunit⟩ := hf
    have hgb : Function.Bijective ((g.val.app (Opposite.op Vt)).hom) := by
      have h : Function.Bijective (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) =>
          (g.val.app (Opposite.op Vt)).hom r) := by
        have hfun : (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) =>
            (g.val.app (Opposite.op Vt)).hom r) =
            (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) =>
              r • (M.val.map (toTop Vt).op).hom m) := funext (hg Vt)
        rw [hfun]
        exact hm Vt hW hcl
      exact h
    have h2b : Function.Bijective
        ⇑((g ≫ Di.adj.unit.app _).val.app (Opposite.op Vt)).hom := (hunit _).comp hgb
    have hb : Function.Bijective
        ⇑(((SheafOfModules.pushforward Di.φ).map (Di.Φ.map g)).val.app (Opposite.op Vt)).hom := by
      refine (Function.Bijective.of_comp_iff _
        (hunit (SheafOfModules.unit (wcRingSheaf X ℓ)))).mp ?_
      have key := Di.adj.unit_naturality g
      first
        | (rw [key]; exact h2b)
        | (erw [key]; exact h2b)
        | exact (congrArg (fun h : (SheafOfModules.unit (wcRingSheaf X ℓ) ⟶
              (SheafOfModules.pushforward Di.φ).obj (Di.Φ.obj M)) =>
            Function.Bijective ⇑(h.val.app (Opposite.op Vt)).hom) key).mpr h2b
    have hn := α.hom.naturality κ.hom.op
    have iA := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (Di.Φ.obj (SheafOfModules.unit _))).obj.map κ.hom.op)
    have iB := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op)
    have h4 : Function.Bijective (⇑(ConcreteCategory.hom
        (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op)) ∘
        ⇑(ConcreteCategory.hom (α.hom.app (Opposite.op T)))) := by
      show Function.Bijective ⇑(ConcreteCategory.hom (α.hom.app (Opposite.op T) ≫
        ((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op))
      rw [← hn]
      exact hb.comp iA
    exact (Function.Bijective.of_comp_iff' iB _).mp h4
  haveI : IsIso (Di.Φ.map g) := isIso_of_reflects_iso _ (SheafOfModules.toSheaf _)
  exact ⟨(asIso (Di.Φ.map g)).symm ≪≫ Di.μ⟩

theorem wc_hm_line_of_et_counts_affine : ∀ (Y : Scheme.{u}) [IsAffine Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ), (∀ k j : ℕ, 1 ≤ k → Finite (wcEtCoh Y (ℓ ^ k) j)) → (∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Y (ℓ ^ k) N) = ℓ ^ k) → Subsingleton (wcEtCoh Y ℓ (N + 1)) → ∃ y : wcHM Y ℓ N, Function.Bijective (fun c : ℚ_[ℓ] => wcHMScalar Y ℓ N c y) ∧ ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j) :=
by
  intro Y _ ℓ _ N hfin hcard htopE
  classical
  have hℓp : ℓ.Prime := Fact.out
  haveI hcY : CompactSpace Y := inferInstance
  haveI hqY : QuasiSeparatedSpace Y := inferInstance
  haveI : IsSeparated (Limits.terminal.from Y) := inferInstance

  have EP : ∀ m j : ℕ, Nonempty (wcZModProEtExt Y m j ≃ wcEtCoh Y m j) := by
    intro m j
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} m j
    obtain ⟨Ez⟩ := wc_et_zmodext_coh_equiv Y m j
    exact ⟨(Equiv.ofBijective (Θ Y) (hΘ Y hcY hqY)).symm.trans Ez⟩
  have hfinPE : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j) := by
    intro k j hk
    haveI := hfin k j hk
    exact Finite.of_equiv _ (EP (ℓ ^ k) j).some.symm

  have hfin1 : ∀ j : ℕ, Finite (wcEtCoh Y ℓ j) := by
    intro j
    have h := hfin 1 j le_rfl
    rwa [pow_one] at h
  have hcard1 : Nat.card (wcEtCoh Y ℓ N) ≤ ℓ := by
    have h := hcard 1 le_rfl
    rw [pow_one] at h
    exact le_of_eq h
  obtain ⟨η, hηi, hηl⟩ := wc_hm_line_of_et_tors_qcsep Y ℓ N hfin1 hcard1

  have passage : ∀ (S : Scheme.{u}) (_ : CompactSpace S) (_ : QuasiSeparatedSpace S) (N : ℕ),
      Finite (wcZModProEtExt S ℓ N) → Nat.card (wcZModProEtExt S ℓ N) ≤ ℓ →
      Subsingleton (wcZModProEtExt S ℓ (N + 1)) →
      (∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt S (ℓ ^ k) N) ∧
        ℓ ^ k ≤ Nat.card (wcZModProEtExt S (ℓ ^ k) N)) →
      ∃ y : wcHM S ℓ N, y ≠ 0 := by
    intro S hcS hqS N hfin1 hcard1 htop hge
    let U : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    have Em : ∀ m : ℕ, 0 < m → ∀ j : ℕ,
        Nonempty (wcZModProEtExt S m j ≃+ Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S m) j) := by
      intro m hm j
      obtain ⟨Φ, hΦb, -, -⟩ := wc_proet_free_zmod_ext_mod_model.{u} m j hm
      exact ⟨AddEquiv.ofBijective (Φ S U) (hΦb S U)⟩
    have hℓpos : 0 < ℓ := hℓp.pos
    obtain ⟨E1⟩ := Em ℓ hℓpos N
    obtain ⟨E2⟩ := Em ℓ hℓpos (N + 1)
    have h1 : Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) :=
      Finite.of_equiv _ E1.toEquiv
    have h2 : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) ≤ ℓ := by
      rw [← Nat.card_congr E1.toEquiv]
      exact hcard1
    have h3 : ∀ z : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) (N + 1), z = 0 := by
      intro z
      rw [← E2.apply_symm_apply z, Subsingleton.elim (E2.symm z) 0, map_zero]
    have h4 : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) →
        ℓ ^ k ≤ Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) := by
      intro k hk _
      obtain ⟨Ek⟩ := Em (ℓ ^ k) (pow_pos hℓpos k) N
      rw [← Nat.card_congr Ek.toEquiv]
      exact (hge k hk).2
    obtain ⟨hcnt, hsN, -⟩ := wc_local_tower_counts S ℓ (wcFreeSheaf S U) N h1 h2 h3 h4
    have hkill : ∀ (m : ℕ) (t : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N),
        ℓ ^ m • t = 0 := by
      intro m t
      have hc' : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N) = ℓ ^ m :=
        (hcnt m).2
      have h := card_nsmul_eq_zero' (G := Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N)
        (x := t)
      rw [hc'] at h
      exact h
    have hcyc := wc_zmod_local_nakayama_cyclic S ℓ (wcFreeSheaf S U) N h1 h2 h3 hkill
    obtain ⟨g, hg1, hg2, hg3⟩ := ladic_tower_compatible_generators ℓ
      (fun m => Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod (ℓ ^ m))) N)
      (fun m => (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ m)
        continuous_of_discreteTopology)).postcomp (wcFreeSheaf S U) (add_zero N))
      hcnt hcyc (fun m t => hsN m t)
    have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := by
      intro k
      show Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) k x)
      rw [continuous_discrete_rng]
      intro b
      rw [Metric.isOpen_iff]
      intro x hx
      have hℓ' : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓpos
      refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ' _, fun y hy => ?_⟩
      have e1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
        rw [Metric.mem_ball, dist_eq_norm] at hy
        exact hy.le
      have e2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) k).mp e1
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at e2
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
      rw [e2]
      exact hx
    have hg1' : ∀ k : ℕ, (g (k + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ k)
        continuous_of_discreteTopology)) (add_zero N) = g k := by
      intro k
      have h := hg1 k
      simpa only [Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply] using h
    obtain ⟨xI, hxI⟩ := wc_proet_int_lim_surj S U ℓ hc N g hg1'
    have hnt : ∀ r : ℕ, ℓ ^ r • xI ≠ 0 := by
      intro r hr
      obtain ⟨xC, hxCdef⟩ : ∃ xC : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S ℤ_[ℓ]) N,
          xC = xI := ⟨xI, rfl⟩
      have hxC : xC.comp (Abelian.Ext.mk₀ (wcContSheafMap S
