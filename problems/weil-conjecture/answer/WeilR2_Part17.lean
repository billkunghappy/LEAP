        (DerivedCategory.quotientCompQhIso 𝒞).inv.app A0 ≫ DerivedCategory.Qh.map c₀ ≫
            (DerivedCategory.Qh.commShiftIso n).hom.app
              ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj Ψ0) ≫
            ((DerivedCategory.quotientCompQhIso 𝒞).hom.app Ψ0)⟦n⟧' =
          DerivedCategory.Q.map χ₀ ≫ (DerivedCategory.Q.commShiftIso n).hom.app Ψ0 := by
    intro 𝒞 _ _
    letI := HasDerivedCategory.standard 𝒞
    intro A0 Ψ0 n χ₀ c₀ h
    subst h
    have hsh := NatTrans.shift_app_comm (DerivedCategory.quotientCompQhIso 𝒞).hom n Ψ0
    rw [Functor.commShiftIso_comp_hom_app] at hsh
    simp only [Category.assoc] at hsh
    have hn := (DerivedCategory.quotientCompQhIso 𝒞).hom.naturality χ₀
    simp only [Functor.comp_map] at hn
    rw [Functor.map_comp, Category.assoc, hsh, reassoc_of% hn, Iso.inv_hom_id_app_assoc]



  have s4 : ∀ {V V' W : Type (u+2)} [Category.{u+1} V] [Category.{u+1} V'] [Category.{u+1} W]
      [Preadditive V] [Preadditive V'] [Preadditive W]
      [Limits.HasZeroObject V] [Limits.HasZeroObject V'] [Limits.HasZeroObject W]
      (F1 : V ⥤ V') (F2 : V' ⥤ W) [F1.Additive] [F2.Additive]
      {A0 : W} {X : V} (v : A0 ⟶ (F1 ⋙ F2).obj X) (L : CochainComplex V ℤ) (n : ℤ)
      (φ : (HomologicalComplex.single V (ComplexShape.up ℤ) 0).obj X ⟶ L⟦n⟧)
      (x : (HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj
          ((HomologicalComplex.single V (ComplexShape.up ℤ) 0).obj X) ⟶
        (HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj
          ((shiftFunctor (HomologicalComplex V (ComplexShape.up ℤ)) n).obj L)),
      (HomotopyCategory.quotient V (ComplexShape.up ℤ)).map φ = x →
      (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.single W (ComplexShape.up ℤ) 0).map v) ≫
        (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.singleMapHomologicalComplex (F1 ⋙ F2) (ComplexShape.up ℤ) 0).inv.app
            X) ≫
        ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
        ((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).map x ≫
        ((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).map
          (((HomotopyCategory.quotient V (ComplexShape.up ℤ)).commShiftIso n).hom.app L) ≫
        (((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso n).hom.app
          ((HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj L) ≫
        (((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app L)⟦n⟧' ≫
        ((HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((Functor.mapHomologicalComplexCompIso (Iso.refl (F1 ⋙ F2)) (ComplexShape.up ℤ)).inv.app
            L))⟦n⟧' =
      (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.single W (ComplexShape.up ℤ) 0).map v ≫
            (HomologicalComplex.singleMapHomologicalComplex (F1 ⋙ F2) (ComplexShape.up ℤ) 0).inv.app
              X ≫
            ((F1 ⋙ F2).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
            (((F1 ⋙ F2).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫
            ((Functor.mapHomologicalComplexCompIso (Iso.refl (F1 ⋙ F2))
              (ComplexShape.up ℤ)).inv.app L)⟦n⟧') ≫
        ((HomotopyCategory.quotient W (ComplexShape.up ℤ)).commShiftIso n).hom.app _ := by
    intro V V' W _ _ _ _ _ _ _ _ _ F1 F2 _ _ A0 X v L n φ x hx
    subst hx
    have hinv : ∀ K, ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app K =
        𝟙 _ := by
      intro K
      have := ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom_inv_id_app K
      rwa [Functor.mapHomotopyCategoryFactors_hom_app, Category.id_comp] at this
    have hsh := NatTrans.shift_app_comm
      ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom n L
    simp only [Functor.mapHomotopyCategoryFactors_hom_app, CategoryTheory.Functor.map_id,
      Functor.commShiftIso_comp_hom_app] at hsh
    simp only [Functor.mapHomotopyCategoryFactors_hom_app, hinv]
    rw [reassoc_of% hsh]
    simp only [Functor.map_comp, Category.assoc]
    rw [Functor.commShiftIso_hom_naturality]
    erw [Category.id_comp]
    erw [CategoryTheory.Functor.map_id]
    erw [Category.id_comp]
    rfl



  have hφy : Hq'.map (I.ι' ≫ yh) =
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y) := by
    rw [← hy, Equiv.apply_symm_apply, CochainComplex.HomComplex.CohomologyClass.homAddEquiv_apply,
      CochainComplex.HomComplex.CohomologyClass.toHom_mk, AddEquiv.symm_apply_apply]



  have e4 := s4 P Di.Φ (Di.μ.inv ≫ Di.Φ.map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ))
    I.cochainComplex ((n - 1 : ℕ) : ℤ) (I.ι' ≫ yh) _ hφy
  have e1 := s1 P Di.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ)
    Di.μ.inv I.cochainComplex I.ι' ((n - 1 : ℕ) : ℤ) yh
  have e6 := s6 _ Ψ ((n - 1 : ℕ) : ℤ) _ (c y) e4
  have hβ : β y = _ := e6
  have hL := DerivedCategory.Q.map_comp eΨ
    ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map yh ≫
        (P.mapCochainComplexShiftIso ((n - 1 : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
      (Di.Φ.mapCochainComplexShiftIso ((n - 1 : ℕ) : ℤ)).hom.app K)
  have h3 := congrArg (fun g => DerivedCategory.Q.map g ≫
    (DerivedCategory.Q.commShiftIso ((n - 1 : ℕ) : ℤ)).hom.app Ψ) e1
  have hL2 := congrArg (fun g => g ≫
    (DerivedCategory.Q.commShiftIso ((n - 1 : ℕ) : ℤ)).hom.app Ψ) hL
  have key := ((hL2.trans (Category.assoc _ _ _)).symm.trans h3).trans hβ.symm
  exact ⟨1, key.trans (one_smul ℤ (β y)).symm⟩

theorem wc_pmn_sls_odp_split_cone_span (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x) :
    ∃ (W : Scheme.{u}) (_ : IsAffine W)
      (φ : W ⟶ Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (_ : Etale φ)
      (ψ : W ⟶ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
         (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
           then (1 : IsLocalRing.ResidueField A) else 0)))) (_ : Etale ψ) (w₀ : W)
      (v₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of (wcQuadModelRing
         (IsLocalRing.ResidueField A) n 0 (Matrix.of fun p q : Fin n =>
           if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : IsLocalRing.ResidueField A) else 0)))),
      φ w₀ = xs ∧ (∀ w : W, φ w = xs → w = w₀) ∧ (∀ w : W, ψ w = ψ w₀ → w = w₀) ∧
      v₀ ≫ wcQuadModelStr (IsLocalRing.ResidueField A) n 0 (Matrix.of fun p q : Fin n =>
           if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : IsLocalRing.ResidueField A) else 0) = 𝟙 _ ∧
      v₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) = ψ w₀ ∧
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p) ∈ (ψ w₀).asIdeal) ∧
      IsClosed ({ψ w₀} : Set ↥(Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
         (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
           then (1 : IsLocalRing.ResidueField A) else 0))))) ∧
      ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 :=
by
  classical

  have s1 : ∀ {Y P V' B T U M N C : Scheme.{u}}
      (f : Y ⟶ P) (h : V' ⟶ P) (E : V' ≅ B) (r : T ⟶ B)
      (u : U ⟶ Y) [Etale u] (φ₀ : U ⟶ M) (q : M ⟶ N) (j : N ⟶ P) [Mono j]
      (mm : C ⟶ M) (str : C ⟶ T) (g' : T ⟶ N)
      (hsq : IsPullback mm str q g')
      (hchart : u ≫ f = φ₀ ≫ q ≫ j)
      (hg : g' ≫ j = (r ≫ E.inv) ≫ h),
      ∃ φ₁ : Limits.pullback φ₀ mm ⟶ Limits.pullback (Limits.pullback.fst h f ≫ E.hom) r,
        Etale φ₁ ∧
        φ₁ ≫ Limits.pullback.fst (Limits.pullback.fst h f ≫ E.hom) r ≫ Limits.pullback.snd h f =
          Limits.pullback.fst φ₀ mm ≫ u ∧
        φ₁ ≫ Limits.pullback.snd (Limits.pullback.fst h f ≫ E.hom) r =
          Limits.pullback.snd φ₀ mm ≫ str := by
    intro Y P V' B T U M N C f h E r u _ φ₀ q j _ mm str g' hsq hchart hg
    have sqA : IsPullback (Limits.pullback.fst (Limits.pullback.fst h f ≫ E.hom) r)
        (Limits.pullback.snd (Limits.pullback.fst h f ≫ E.hom) r) (Limits.pullback.fst h f)
        (r ≫ E.inv) :=
      IsPullback.of_iso (IsPullback.of_hasPullback (Limits.pullback.fst h f ≫ E.hom) r)
        (Iso.refl _) (Iso.refl _) (Iso.refl _) E.symm (by simp) (by simp) (by simp) (by simp)
    have sqX := sqA.paste_horiz (IsPullback.of_hasPullback h f).flip
    have sqM : IsPullback mm str (q ≫ j) (g' ≫ j) :=
      IsPullback.of_isLimit (Limits.PullbackCone.isLimitOfCompMono q g' j hsq.cone hsq.isLimit)
    rw [hg] at sqM
    have sqW := (IsPullback.of_hasPullback φ₀ mm).paste_vert sqM
    rw [← hchart] at sqW
    let φ₁ := sqX.lift (Limits.pullback.fst φ₀ mm ≫ u) (Limits.pullback.snd φ₀ mm ≫ str)
      (by rw [Category.assoc]; exact sqW.w)
    have l1 : φ₁ ≫ (Limits.pullback.fst (Limits.pullback.fst h f ≫ E.hom) r ≫
        Limits.pullback.snd h f) = Limits.pullback.fst φ₀ mm ≫ u := sqX.lift_fst _ _ _
    have l2 : φ₁ ≫ Limits.pullback.snd (Limits.pullback.fst h f ≫ E.hom) r =
        Limits.pullback.snd φ₀ mm ≫ str := sqX.lift_snd _ _ _
    rw [← l2] at sqW
    have sqT := IsPullback.of_bot sqW l1.symm sqX
    exact ⟨φ₁, MorphismProperty.of_isPullback (P := @Etale) sqT ‹Etale u›, l1, l2⟩

  have s3 : ∀ (K : Type u) [Field K] (n : ℕ) (π : K) (hπ : π = 0)
      (c : Matrix (Fin n) (Fin n) K),
      ∃ v₀ : Spec (.of K) ⟶ Spec (.of (wcQuadModelRing K n π c)),
        v₀ ≫ wcQuadModelStr K n π c = 𝟙 _ ∧
        (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n π c) (MvPolynomial.X p) ∈
            (v₀ (IsLocalRing.closedPoint K)).asIdeal) ∧
        IsClosed ({v₀ (IsLocalRing.closedPoint K)} : Set ↥(Spec (.of (wcQuadModelRing K n π c)))) ∧
        ∀ z : ↥(Spec (.of (wcQuadModelRing K n π c))),
          (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n π c) (MvPolynomial.X p) ∈ z.asIdeal) →
          z = v₀ (IsLocalRing.closedPoint K) := by
    intro K _ n π hπ c
    subst hπ
    have hXspan : ∀ F : MvPolynomial (Fin n) K, MvPolynomial.constantCoeff F = 0 →
        F ∈ Ideal.span (MvPolynomial.X '' Set.univ) := by
      intro F hF
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact hm hF
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have hI : ∀ a ∈ wcQuadModelIdeal K n 0 c, (MvPolynomial.aeval (0 : Fin n → K)) a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul]
      apply mul_eq_zero_of_right
      simp
    obtain ⟨ε, hε1, hε2⟩ : ∃ ε : wcQuadModelRing K n 0 c →+* K,
        (∀ a, ε (algebraMap K _ a) = a) ∧
        ∀ F, ε (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) F) = MvPolynomial.constantCoeff F :=
      ⟨(Ideal.Quotient.liftₐ (wcQuadModelIdeal K n 0 c) (MvPolynomial.aeval (0 : Fin n → K)) hI :
          _ →+* K),
        fun a => (Ideal.Quotient.liftₐ (wcQuadModelIdeal K n 0 c) _ hI).commutes a,
        fun F => by simp⟩
    have hsurj : Function.Surjective ε := fun a => ⟨algebraMap K _ a, hε1 a⟩
    have hmax : (RingHom.ker ε).IsMaximal := RingHom.ker_isMaximal_of_surjective ε hsurj
    have hv : (Spec.map (CommRingCat.ofHom ε) (IsLocalRing.closedPoint K)).asIdeal =
        RingHom.ker ε := by
      ext y
      change ε y ∈ IsLocalRing.maximalIdeal K ↔ _
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, RingHom.mem_ker]
    refine ⟨Spec.map (CommRingCat.ofHom ε), ?_, ?_, ?_, ?_⟩
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← Spec.map_id]
      congr 1
      ext x
      exact hε1 x
    · intro p
      rw [hv, RingHom.mem_ker, hε2, MvPolynomial.constantCoeff_X]
    · refine (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr ?_
      rw [hv]
      exact hmax
    · intro z hz
      have hle : RingHom.ker ε ≤ z.asIdeal := by
        intro y hy
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [RingHom.mem_ker, hε2] at hy
        have h1 := Ideal.mem_map_of_mem (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c)) (hXspan F hy)
        refine Ideal.map_le_iff_le_comap.mpr ?_ h1
        rw [Ideal.span_le]
        rintro _ ⟨i, -, rfl⟩
        exact hz i
      apply PrimeSpectrum.ext
      rw [hv]
      exact (hmax.eq_of_le z.isPrime.ne_top hle).symm

  have s2 : ∀ (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ), Even m → 2 ≤ m → ∀ (π : k), π = 0 →
      ∀ (c : Matrix (Fin m) (Fin m) k), (c + c.transpose).det ≠ 0 →
      ∃ θ : wcQuadModelRing k m π c ≃+* wcQuadModelRing k m 0
          (Matrix.of fun p q : Fin m => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0),
        ∀ r : Fin m, θ.symm (Ideal.Quotient.mk (wcQuadModelIdeal k m 0
            (Matrix.of fun p q : Fin m => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0))
            (MvPolynomial.X r)) ∈
          Ideal.span (Set.range fun q : Fin m =>
            Ideal.Quotient.mk (wcQuadModelIdeal k m π c) (MvPolynomial.X q)) := by
    intro k _ _ m hm hm2 π hπ c hc
    subst hπ
    obtain ⟨d, rfl⟩ : ∃ d, m = d + 1 + 1 := ⟨m - 2, by omega⟩
    have hd : Even d := by
      obtain ⟨t, ht⟩ := hm
      exact ⟨t - 1, by omega⟩
    obtain ⟨P, hP, hform⟩ := wc_quadric_split_normal_form_alg_closed k d hd c hc
    have hval' : ∑ p, ∑ q, MvPolynomial.C ((P.transpose * c * P) p q) *
          (MvPolynomial.X p * MvPolynomial.X q) =
        ∑ p, ∑ q, MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) *
          (MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (d + 1 + 1)) k) :=
      congrArg Subtype.val hform
    let Φ : ∀ M : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
        MvPolynomial (Fin (d + 1 + 1)) k →ₐ[k] MvPolynomial (Fin (d + 1 + 1)) k :=
      fun M => MvPolynomial.aeval (fun i => ∑ j, MvPolynomial.C (M i j) * MvPolynomial.X j)
    have hΦX : ∀ M i, Φ M (MvPolynomial.X i) = ∑ j, MvPolynomial.C (M i j) * MvPolynomial.X j :=
      fun M i => MvPolynomial.aeval_X _ _
    have hcomp : ∀ M N : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
        (Φ M).comp (Φ N) = Φ (N * M) := by
      intro M N
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, hΦX, hΦX, map_sum]
      simp_rw [map_mul, hΦX, Φ, MvPolynomial.aeval_C, Finset.mul_sum, Matrix.mul_apply, map_sum,
        Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun j _ => ?_))
      rw [MvPolynomial.algebraMap_eq, map_mul]
      ring
    have hone : Φ 1 = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [hΦX, AlgHom.id_apply, Finset.sum_eq_single i]
      · simp
      · intro b _ hb
        rw [Matrix.one_apply_ne (Ne.symm hb), map_zero, zero_mul]
      · intro hi
        exact absurd (Finset.mem_univ i) hi
    have hPi : P⁻¹ * P = 1 := Matrix.nonsing_inv_mul P hP
    have hiP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
    let Φe : MvPolynomial (Fin (d + 1 + 1)) k ≃+* MvPolynomial (Fin (d + 1 + 1)) k :=
      (AlgEquiv.ofAlgHom (Φ P) (Φ P⁻¹) (by rw [hcomp, hPi, hone])
        (by rw [hcomp, hiP, hone])).toRingEquiv
    have hΦeX : ∀ x, Φe x = Φ P x := fun x => rfl
    have hΦesymm : ∀ x, Φe.symm x = Φ P⁻¹ x := fun x => rfl
    have hkey : ∀ M : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
        Φ P (∑ p, ∑ q, MvPolynomial.C (M p q) * MvPolynomial.X p * MvPolynomial.X q) =
          ∑ p, ∑ q, MvPolynomial.C ((P.transpose * M * P) p q) * MvPolynomial.X p *
            MvPolynomial.X q := by
      intro M
      have hdot : ∀ N : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
          ∑ p, ∑ q, MvPolynomial.C (N p q) * MvPolynomial.X p * MvPolynomial.X q =
            dotProduct (MvPolynomial.X : Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1 + 1)) k)
              (Matrix.mulVec (N.map MvPolynomial.C) MvPolynomial.X) := by
        intro N
        simp only [dotProduct, Matrix.mulVec, Matrix.map_apply, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
        ring
      rw [hdot, hdot]
      have hcomp' : (fun i => Φ P (MvPolynomial.X i)) =
          Matrix.mulVec (P.map MvPolynomial.C) MvPolynomial.X := by
        funext i
        rw [hΦX]
        rfl
      have hmap : ∀ v w : Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1 + 1)) k,
          Φ P (dotProduct v w) = dotProduct (fun i => Φ P (v i)) (fun i => Φ P (w i)) := by
        intro v w
        simp only [dotProduct, map_sum, map_mul]
      have hmv : (fun i => Φ P (Matrix.mulVec (M.map MvPolynomial.C) MvPolynomial.X i)) =
          Matrix.mulVec (M.map MvPolynomial.C) (fun i => Φ P (MvPolynomial.X i)) := by
        funext i
        simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, Matrix.map_apply, Φ,
          MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      rw [hmap, hmv, hcomp', Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
        ← Matrix.vecMul_transpose, Matrix.vecMul_vecMul, ← Matrix.dotProduct_mulVec,
        ← Matrix.transpose_map, ← Matrix.map_mul, ← Matrix.map_mul, Matrix.mul_assoc]
    have hQ : Φe (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C 0) =
        ∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C 0 := by
      rw [map_zero MvPolynomial.C, sub_zero, sub_zero, hΦeX, hkey]
      refine Eq.trans (Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl
        (fun q _ => mul_assoc _ _ _))) (Eq.trans hval' (Finset.sum_congr rfl (fun p _ =>
          Finset.sum_congr rfl (fun q _ => ?_))))
      rw [Matrix.of_apply, mul_assoc]
    have hIJ : wcQuadModelIdeal k (d + 1 + 1) 0
        (Matrix.of fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) =
        Ideal.map (Φe : MvPolynomial (Fin (d + 1 + 1)) k →+* MvPolynomial (Fin (d + 1 + 1)) k)
          (wcQuadModelIdeal k (d + 1 + 1) 0 c) := by
      show Ideal.span {_} = Ideal.map _ (Ideal.span {_})
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun z => Ideal.span {z}) hQ.symm
    refine ⟨Ideal.quotientEquiv _ _ Φe hIJ, fun r => ?_⟩
    have e : (Ideal.quotientEquiv _ _ Φe hIJ).symm (Ideal.Quotient.mk _ (MvPolynomial.X r)) =
        Ideal.Quotient.mk (wcQuadModelIdeal k (d + 1 + 1) 0 c) (Φe.symm (MvPolynomial.X r)) :=
      Ideal.quotientEquiv_symm_mk _ _ Φe hIJ _
    rw [e, hΦesymm, hΦX, map_sum]
    apply Ideal.sum_mem
    intro j _
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

  have key : ∀ (F'' k : Type u) [Field F''] [Finite F''] [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    {Yt P V' : Scheme.{u}} (B : Scheme.{u})
    (f : Yt ⟶ P) (h : V' ⟶ P) (E : V' ≅ B) (r : Spec (.of k) ⟶ B)
    (s : Spec (.of F'') ⟶ P) (x0 : Spec (.of F'') ⟶ Yt)
    (j : Spec (.of (Polynomial F'')) ⟶ P) (β : F'') [IsOpenImmersion j]
    (hjβ : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) ≫ j = s)
    (hr : ((r ≫ E.inv) ≫ h) (IsLocalRing.closedPoint k) = s (IsLocalRing.closedPoint F''))
    (U : Scheme.{u}) (u : U ⟶ Yt) (φ₀ : U ⟶ Spec (.of (MvPolynomial (Fin n) F'')))
    (c : Matrix (Fin n) (Fin n) F'') (σ : Spec (.of F'') ⟶ U) [Etale u] [Etale φ₀]
    (hc : (c + c.transpose).det ≠ 0)
    (hchart : u ≫ f = φ₀ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C
      (MvPolynomial.C β + ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) ≫ j)
    (hσ : σ ≫ u = x0)
    (hσ0 : ∀ p, (MvPolynomial.X p : MvPolynomial (Fin n) F'') ∈
      (φ₀ (σ (IsLocalRing.closedPoint F''))).asIdeal)
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst h f ≫ E.hom) r))
    (huniq : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst h f ≫ E.hom) r),
      Limits.pullback.snd h f (Limits.pullback.fst (Limits.pullback.fst h f ≫ E.hom) r z) =
        x0 (IsLocalRing.closedPoint F'') → z = xs),
    ∃ (W : Scheme.{u}) (_ : IsAffine W)
      (φ : W ⟶ Limits.pullback (Limits.pullback.fst h f ≫ E.hom) r) (_ : Etale φ)
      (ψ : W ⟶ Spec (.of (wcQuadModelRing k n 0
         (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
           then (1 : k) else 0)))) (_ : Etale ψ) (w₀ : W)
      (v₀ : Spec (.of k) ⟶ Spec (.of (wcQuadModelRing k n 0 (Matrix.of fun p q : Fin n =>
           if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0)))),
      φ w₀ = xs ∧ (∀ w : W, φ w = xs → w = w₀) ∧ (∀ w : W, ψ w = ψ w₀ → w = w₀) ∧
      v₀ ≫ wcQuadModelStr k n 0 (Matrix.of fun p q : Fin n =>
           if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) = 𝟙 _ ∧
      v₀ (IsLocalRing.closedPoint k) = ψ w₀ ∧
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal k n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : k) else 0)) (MvPolynomial.X p) ∈ (ψ w₀).asIdeal) ∧
      IsClosed ({ψ w₀} : Set ↥(Spec (.of (wcQuadModelRing k n 0
         (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
           then (1 : k) else 0))))) ∧
      ((ℓ : ℕ) : k) ≠ 0 := by
    intro F'' k _ _ _ _ n hn hn2 ℓ _ hℓ Yt P V' B f h E r s x0 j β _ hjβ hr U u φ₀ c σ _ _ hc
      hchart hσ hσ0 xs huniq

    have s5 : ∀ (x y : ↥(Spec (.of (MvPolynomial (Fin n) F'')))),
        (∀ p, (MvPolynomial.X p : MvPolynomial (Fin n) F'') ∈ x.asIdeal) →
        (∀ p, (MvPolynomial.X p : MvPolynomial (Fin n) F'') ∈ y.asIdeal) → x = y := by
      have hmax : (Ideal.span (Set.range
          (MvPolynomial.X : Fin n → MvPolynomial (Fin n) F''))).IsMaximal := by
        have hk : Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) F'')) =
            RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin n) F'' →+* F'') := by
          ext a
          rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image, RingHom.mem_ker]
          constructor
          · intro H
            by_contra h0
            obtain ⟨i, -, hi⟩ := H 0 (by rw [MvPolynomial.mem_support_iff]; exact h0)
            exact hi rfl
          · intro H m hm
            rw [MvPolynomial.mem_support_iff] at hm
            have hm0 : m ≠ 0 := by
              rintro rfl
              exact hm H
            obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
            exact ⟨i, Set.mem_univ _, hi⟩
        rw [hk]
        exact RingHom.ker_isMaximal_of_surjective _
          (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ _⟩)
      have hle : ∀ z : ↥(Spec (.of (MvPolynomial (Fin n) F''))),
          (∀ p, (MvPolynomial.X p : MvPolynomial (Fin n) F'') ∈ z.asIdeal) →
          Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) F'')) =
            z.asIdeal := by
        intro z hz
        exact hmax.eq_of_le z.isPrime.ne_top
          (Ideal.span_le.mpr (by rintro _ ⟨p, rfl⟩; exact hz p))
      intro x y hx hy
      exact PrimeSpectrum.ext ((hle x hx).symm.trans (hle y hy))

    have s6 : ∀ (ι : F'' →+* k), ((ℓ : ℕ) : k) ≠ 0 := by
      intro ι hk0
      have hF : ((ℓ : ℕ) : F'') = 0 := by
        apply ι.injective
        rw [map_natCast, hk0, map_zero]
      have hpp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
      have hpl : ringChar F'' ∣ ℓ := (CharP.cast_eq_zero_iff F'' (ringChar F'') ℓ).mp hF
      have hpl' : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hpl
      letI := Fintype.ofFinite F''
      have hc0 : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
      have hpc : ringChar F'' ∣ Fintype.card F'' :=
        (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp hc0
      apply hℓ
      rw [← hpl', Nat.card_eq_fintype_card]
      exact hpc

    obtain ⟨g', hg⟩ : ∃ g' : Spec (.of k) ⟶ Spec (.of (Polynomial F'')),
        g' ≫ j = (r ≫ E.inv) ≫ h := by
      have hrange : Set.range ((r ≫ E.inv) ≫ h) ⊆ Set.range j := by
        rintro _ ⟨y, rfl⟩
        rw [Subsingleton.elim y (IsLocalRing.closedPoint k), hr, ← hjβ]
        exact ⟨_, (Scheme.Hom.comp_apply _ _ _).symm⟩
      exact ⟨IsOpenImmersion.lift j _ hrange, IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨ρ, rfl⟩ : ∃ ρ : Polynomial F'' →+* k, Spec.map (CommRingCat.ofHom ρ) = g' :=
      ⟨(Spec.preimage g').hom, by rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage g'⟩
    have hπ : ρ (Polynomial.X - Polynomial.C β) = 0 := by
      have hpt : (Spec.map (CommRingCat.ofHom ρ)) (IsLocalRing.closedPoint k) =
          (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)))
            (IsLocalRing.closedPoint F'') := by
        apply j.isOpenEmbedding.injective
        have e1 := congrArg (fun m => m (IsLocalRing.closedPoint k)) hg
        have e2 := congrArg (fun m => m (IsLocalRing.closedPoint F'')) hjβ
        simp only at e1 e2
        exact (Scheme.Hom.comp_apply _ _ _).symm.trans
          (e1.trans (hr.trans (e2.symm.trans (Scheme.Hom.comp_apply _ _ _))))
      have hmem : Polynomial.X - Polynomial.C β ∈
          ((Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)))
            (IsLocalRing.closedPoint F'')).asIdeal := by
        show Polynomial.evalRingHom β (Polynomial.X - Polynomial.C β) ∈
          IsLocalRing.maximalIdeal F''
        simp
      rw [← hpt] at hmem
      change ρ (Polynomial.X - Polynomial.C β) ∈ IsLocalRing.maximalIdeal k at hmem
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot] at hmem
      exact hmem
    have hc' : ((c.map (ρ.comp Polynomial.C)) +
        (c.map (ρ.comp Polynomial.C)).transpose).det ≠ 0 := by
      have e : (c.map (ρ.comp Polynomial.C)) + (c.map (ρ.comp Polynomial.C)).transpose =
          (ρ.comp Polynomial.C).mapMatrix (c + c.transpose) := by
        ext a b
        simp [Matrix.transpose_apply]
      rw [e, ← RingHom.map_det]
      exact fun h0 => hc ((ρ.comp Polynomial.C).injective (h0.trans (map_zero _).symm))

    have hsq := wc_morse_quad_model_isPullback F'' k n β c ρ
    obtain ⟨mm, hmm⟩ : ∃ mm, mm = Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk
        (wcQuadModelIdeal k n (ρ (Polynomial.X - Polynomial.C β))
          (c.map (ρ.comp Polynomial.C)))).comp (MvPolynomial.map (ρ.comp Polynomial.C)))) :=
      ⟨_, rfl⟩
    rw [← hmm] at hsq
    obtain ⟨φ₁, hφ₁, e1, e2⟩ := s1 f h E r u φ₀ _ j _ _ _ hsq hchart hg
    haveI := hφ₁
    obtain ⟨θ, hθ⟩ := s2 k n hn hn2 _ hπ (c.map (ρ.comp Polynomial.C)) hc'
    obtain ⟨v', -, hv'X, -, -⟩ := s3 k n _ hπ (c.map (ρ.comp Polynomial.C))
    obtain ⟨ψ₁, hψ₁⟩ : ∃ ψ₁, ψ₁ = Limits.pullback.snd φ₀ mm ≫
        Spec.map θ.symm.toCommRingCatIso.hom := ⟨_, rfl⟩
    haveI : Etale ψ₁ := by rw [hψ₁]; infer_instance
    have hmeet : φ₀ (σ (IsLocalRing.closedPoint F'')) = mm (v' (IsLocalRing.closedPoint k)) := by
      apply s5 _ _ hσ0
      intro p
      rw [hmm]
      show (Ideal.Quotient.mk _) (MvPolynomial.map (ρ.comp Polynomial.C) (MvPolynomial.X p)) ∈
        (v' (IsLocalRing.closedPoint k)).asIdeal
      rw [MvPolynomial.map_X]
      exact hv'X p
    obtain ⟨w₁, hw₁a, hw₁b⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hmeet
    have hφw : φ₁ w₁ = xs := by
      apply huniq
      have := congrArg (fun m => m w₁) e1
      simp only [Scheme.Hom.comp_apply] at this
      rw [this, hw₁a, ← hσ]
      exact (Scheme.Hom.comp_apply _ _ _).symm

    obtain ⟨U₁, hU₁, hU₁u⟩ := wc_etale_fibre_point_isolated φ₁ w₁
    obtain ⟨U₂, hU₂, hU₂u⟩ := wc_etale_fibre_point_isolated ψ₁ w₁
    obtain ⟨W', hW'a, hw₁W', hsub⟩ :=
      exists_isAffineOpen_mem_and_subset (show w₁ ∈ U₁ ⊓ U₂ from ⟨hU₁, hU₂⟩)
    have hmemW : ∀ w : W'.toScheme, W'.ι w ∈ U₁ ∧ W'.ι w ∈ U₂ := fun w => by
      have hw : W'.ι w ∈ (W' : Set _) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨w, rfl⟩
      exact hsub hw
    obtain ⟨w₀, hw₀⟩ : ∃ w₀ : W'.toScheme, W'.ι w₀ = w₁ := by
      rw [← Set.mem_range, Scheme.Opens.range_ι]
      exact hw₁W'
    obtain ⟨v₀, hv₀s, -, hv₀cl, hv₀u⟩ := s3 k n 0 rfl
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0)
    have hvert : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal k n 0
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0))
        (MvPolynomial.X p) ∈ ((W'.ι ≫ ψ₁) w₀).asIdeal := by
      intro p
      have hpt : (W'.ι ≫ ψ₁) w₀ =
          Spec.map θ.symm.toCommRingCatIso.hom (v' (IsLocalRing.closedPoint k)) := by
        rw [Scheme.Hom.comp_apply, hw₀, hψ₁, Scheme.Hom.comp_apply, hw₁b]
      rw [hpt]
      show θ.symm (Ideal.Quotient.mk _ (MvPolynomial.X p)) ∈
        (v' (IsLocalRing.closedPoint k)).asIdeal
      exact Ideal.span_le.mpr (by rintro _ ⟨q, rfl⟩; exact hv'X q) (hθ p)
    refine ⟨W', hW'a, W'.ι ≫ φ₁, inferInstance, W'.ι ≫ ψ₁, inferInstance, w₀, v₀,
      ?_, ?_, ?_, hv₀s, (hv₀u _ hvert).symm, hvert, ?_, s6 (ρ.comp Polynomial.C)⟩
    · rw [Scheme.Hom.comp_apply, hw₀]
      exact hφw
    · intro w hw
      rw [Scheme.Hom.comp_apply] at hw
      have h1 := hU₁u _ (hmemW w).1 (hw.trans hφw.symm)
      exact W'.ι.isOpenEmbedding.injective (h1.trans hw₀.symm)
    · intro w hw
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hw₀] at hw
      have h1 := hU₂u _ (hmemW w).2 hw
      exact W'.ι.isOpenEmbedding.injective (h1.trans hw₀.symm)
    · rw [hv₀u _ hvert]
      exact hv₀cl

  haveI hac : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  obtain ⟨j, β, hjo, hjstr, hjβ⟩ := wc_morse_p1_rational_chart F'' (D.S i) (D.hS i)
  haveI := hjo
  obtain ⟨U, u, φ₀, c, σ, hu, hφ₀, hc, hchart, hσ, hσ0⟩ :=
    wc_morse_odp_etale_chart F' F'' Y n hn2 D i j β hjo hjstr hjβ
  haveI := hu
  haveI := hφ₀
  have hqm : wcQmSp A (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A :=
    IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
  have hr : ((wcQmSp A ≫ e.inv) ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      D.S i (IsLocalRing.closedPoint F'') := by
    show V.hom (e.inv (wcQmSp A (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) = _
    rw [hqm]
    exact hV
  have huniq := (wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs).2.2.2
  exact key F'' (IsLocalRing.ResidueField A) n hn hn2 ℓ hℓ (Spec (.of A)) D.f V.hom e (wcQmSp A)
    (D.S i) (D.xs i) j β hjβ hr U u φ₀ c σ hc hchart hσ hσ0 xs huniq

theorem wc_point_coker_ext_etale_excision (K : Type u) [Field K] [IsAlgClosed K]
    {X W : Scheme.{u}} (fX : X ⟶ Spec (.of K)) [IsLocallyNoetherian X] [QuasiSeparatedSpace X]
    (φ : W ⟶ X) [Etale φ] [IsAffine W]
    (x₀ : Spec (.of K) ⟶ X) (hx₀ : x₀ ≫ fX = 𝟙 _) (w₀ : W)
    (hw₀ : φ w₀ = x₀ (IsLocalRing.closedPoint K))
    (huniq : ∀ w : W, φ w = x₀ (IsLocalRing.closedPoint K) → w = w₀)
    (OX : X.Opens) (hOX : (OX : Set X) = {x₀ (IsLocalRing.closedPoint K)}ᶜ)
    (OW : W.Opens) (hOW : (OW : Set W) = {w₀}ᶜ) (M q : ℕ) :
    Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X
        (MorphismProperty.Over.homMk OX.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk OX.ι ⟶ Scheme.ProEt.mk (𝟙 X)))) (wcZModSheaf X M) q ≃
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap W
        (MorphismProperty.Over.homMk OW.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk OW.ι ⟶ Scheme.ProEt.mk (𝟙 W)))) (wcZModSheaf W M) q) :=
by
  classical
  set x : X := x₀ (IsLocalRing.closedPoint K) with hxdef
  have hpre : (φ ⁻¹' {x} : Set W) = {w₀} := by
    ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨fun h => huniq w h, fun h => h ▸ hw₀⟩
  have H' : Set.range (OW.ι ≫ φ) ⊆ Set.range OX.ι := by
    rintro y ⟨w', rfl⟩
    rw [Scheme.Opens.range_ι, hOX]
    intro hy
    have hw' : (OW.ι w') ∈ (OW : Set W) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨w', rfl⟩
    rw [hOW] at hw'
    apply hw'
    exact huniq _ (by simpa using hy)
  haveI hOXi : IsOpenImmersion OX.ι := inferInstance
  haveI hOWi : IsOpenImmersion OW.ι := inferInstance
  let lf : (OW : Scheme) ⟶ (OX : Scheme) := IsOpenImmersion.lift OX.ι (OW.ι ≫ φ) H'
  have hlf : lf ≫ OX.ι = OW.ι ≫ φ := IsOpenImmersion.lift_fac OX.ι (OW.ι ≫ φ) H'
  let U : X.ProEt := Scheme.ProEt.mk (𝟙 X)
  let V : X.ProEt := Scheme.ProEt.mk OX.ι
  let T : X.ProEt := Scheme.ProEt.mk φ
  let VT : X.ProEt := Scheme.ProEt.mk (OW.ι ≫ φ)
  let ι : V ⟶ U := MorphismProperty.Over.homMk OX.ι (Category.comp_id _) trivial
  let g : T ⟶ U := MorphismProperty.Over.homMk φ (Category.comp_id _) trivial
  let j : VT ⟶ T := MorphismProperty.Over.homMk OW.ι rfl trivial
  let gV : VT ⟶ V := MorphismProperty.Over.homMk lf hlf trivial
  have hι : IsOpenImmersion ι.left := hOXi
  have hj : IsOpenImmersion j.left := hOWi
  have hr : Set.range ι.left = {x}ᶜ := by
    show Set.range OX.ι = ({x}ᶜ : Set X)
    rw [Scheme.Opens.range_ι]
    exact hOX
  have hrj : Set.range j.left = g.left ⁻¹' {x}ᶜ := by
    show Set.range OW.ι = φ ⁻¹' ({x}ᶜ : Set X)
    rw [Scheme.Opens.range_ι, hOW, Set.preimage_compl, hpre]
  have hgV : gV ≫ ι = j ≫ g := by
    apply MorphismProperty.Over.Hom.ext
    exact hlf
  have hfib : IsIso (Limits.pullback.snd g.left (U.left.fromSpecResidueField x)) :=
    wc_glc_etale_fibre_iso K X W fX φ x₀ hx₀ x rfl w₀ hw₀ huniq
  have hT : CompactSpace T.left := (inferInstance : CompactSpace W)
  have hqs : QuasiSeparatedSpace U.left := (inferInstance : QuasiSeparatedSpace X)
  have hln : IsLocallyNoetherian U.left := (inferInstance : IsLocallyNoetherian X)
  obtain ⟨κ, hκ, -⟩ :=
    wc_lfi_point_excision X U V T VT ι hι x hr g j hj hrj gV hgV hfib hT hqs hln
  haveI := hκ
  have E₁ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X ι)) (wcZModSheaf X M) q ≃
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap X j)) (wcZModSheaf X M) q :=
    { toFun := fun e => (Abelian.Ext.mk₀ κ).comp e (zero_add q)
      invFun := fun e => (Abelian.Ext.mk₀ (inv κ)).comp e (zero_add q)
      left_inv := fun e => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun e => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
  haveI : IsOpenImmersion j.left := hj
  have E₂ := (wc_glc_coker_slice X T VT j M q).some
  exact ⟨E₁.trans E₂⟩

theorem wc_quad_cone_vertex_coker_ext (K : Type u) [Field K] [IsSepClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (n : ℕ) (c : Matrix (Fin n) (Fin n) K)
    (x₀ : Spec (.of (wcQuadModelRing K n 0 c)))
    (O : (Spec (.of (wcQuadModelRing K n 0 c))).Opens)
    (hO : (O : Set (Spec (.of (wcQuadModelRing K n 0 c)))) = {x₀}ᶜ) (k j : ℕ) (hk : 1 ≤ k)
    (hj : 1 ≤ j) :
    Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) (j + 1) ≃
      wcEtCoh (O : Scheme.{u}) (ℓ ^ k) j) :=
by
  classical

  haveI : IsNoetherianRing (wcQuadModelRing K n 0 c) := by
    unfold wcQuadModelRing; infer_instance
  haveI hcO : CompactSpace (Scheme.ProEt.mk O.ι).left :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact
      (O : Set (Spec (.of (wcQuadModelRing K n 0 c)))))
  have hsepO : IsSeparated (Limits.terminal.from (O : Scheme.{u})) := by
    have e : Limits.terminal.from (O : Scheme.{u}) =
        O.ι ≫ Limits.terminal.from (Spec (.of (wcQuadModelRing K n 0 c))) :=
      Limits.terminal.hom_ext _ _
    haveI : IsSeparated O.ι := IsSeparated.isSeparated_of_mono O.ι
    rw [e]
    infer_instance
  haveI hsO : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk O.ι).left) := hsepO
  haveI hcC : CompactSpace
      (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c))))).left := by
    show CompactSpace (Spec (.of (wcQuadModelRing K n 0 c)))
    infer_instance
  haveI hsC : IsSeparated (Limits.terminal.from
      (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c))))).left) := by
    show IsSeparated (Limits.terminal.from (Spec (.of (wcQuadModelRing K n 0 c))))
    infer_instance

  have hmono : Mono (wcFreeSheafMap (Spec (.of (wcQuadModelRing K n 0 c)))
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))) :=
    wc_free_sheaf_map_mono _ _ _ _ (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap (Spec (.of (wcQuadModelRing K n 0 c)))
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c))))))
      (Limits.cokernel.π _) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  have hp : ℓ.Prime := Fact.out
  have s3 : ∀ q : ℕ, 1 ≤ q →
      Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k) q) := by
    intro q hq
    have h1 := (wc_et_quadric_cone_acyclic K ℓ hp hℓ n c).2 q hq
    have h2 := wc_et_coh_zmod_prime_pow_of_prime _ ℓ hp q h1 (k - 1)
    rwa [Nat.sub_add_cancel hk] at h2

  have s4 : ∀ q : ℕ, 1 ≤ q → ∀ x : Abelian.Ext
      (wcFreeSheaf (Spec (.of (wcQuadModelRing K n 0 c)))
        (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c))))))
      (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) q, x = 0 :=
    fun q hq => wc_proet_free_zmod_ext_vanish_of_et_qcsep _
      (Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c))))) (ℓ ^ k) q (s3 q hq)

  have hjj : 1 + j = j + 1 := by omega
  let δ : Abelian.Ext (wcFreeSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (Scheme.ProEt.mk O.ι))
      (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) j →
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (wcQuadModelRing K n 0 c)))
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (wcQuadModelRing K n 0 c)))))))
        (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) (j + 1) :=
    fun x => hS.extClass.comp x hjj
  have hinj : Function.Injective δ := by
    intro a b hab
    have h0 : hS.extClass.comp (a - b) hjj = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg]
      change δ a + -δ b = 0
      rw [hab, add_neg_cancel]
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ (a - b) hjj h0
    rw [s4 j hj x₂, Abelian.Ext.comp_zero] at hx₂
    exact sub_eq_zero.mp hx₂.symm
  have hsurj : Function.Surjective δ := by
    intro x₃
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS _ x₃
      (s4 (j + 1) (by omega) _) hjj
    exact ⟨x₁, hx₁⟩

  obtain ⟨E₁⟩ := wc_ext_free_slice_zmod (Spec (.of (wcQuadModelRing K n 0 c)))
    (Scheme.ProEt.mk O.ι) (ℓ ^ k) j
  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont (Scheme.ProEt.mk O.ι).left
  haveI := hcont
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Scheme.ProEt.mk O.ι).left)
    AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep (Scheme.ProEt.mk O.ι).left
    ((constantSheaf (Scheme.smallEtaleTopology (Scheme.ProEt.mk O.ι).left) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) j
  let χ : (wcEpsInv (Scheme.ProEt.mk O.ι).left).obj ((constantSheaf (Scheme.smallEtaleTopology
        (Scheme.ProEt.mk O.ι).left) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) ≅
      wcZModSheaf (Scheme.ProEt.mk O.ι).left (ℓ ^ k) :=
    (wc_epsInv_const (Scheme.ProEt.mk O.ι).left
      (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))).some ≪≫
      (wc_zmod_sheaf_const (Scheme.ProEt.mk O.ι).left (ℓ ^ k)).some.symm
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology (Scheme.ProEt.mk O.ι).left)
      AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B j ≃ Abelian.Ext A B' j) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero j)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf (Scheme.ProEt.mk O.ι).left
    (Scheme.ProEt.mk (𝟙 (Scheme.ProEt.mk O.ι).left))) χ.symm
  let Ec : Abelian.Ext (wcFreeSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (Scheme.ProEt.mk O.ι))
      (wcZModSheaf (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ k)) j ≃
      wcEtCoh (O : Scheme.{u}) (ℓ ^ k) j := E₁.trans (E₂.trans E₀)

  exact ⟨(Equiv.ofBijective δ ⟨hinj, hsurj⟩).symm.trans Ec⟩

theorem wc_quad_cone_punct_linear_change_coh_equiv : ∀ (K : Type u) [Field K] (d : ℕ) (A B P : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) K), IsUnit P.det → wcLdpQuad K (d + 1) (fun p q => (P.transpose * A * P) p q) = wcLdpQuad K (d + 1) (fun p q => B p q) → ∀ (OA : (Spec (.of (wcQuadModelRing K (d + 1 + 1) 0 A))).Opens), (OA : Set (Spec (.of (wcQuadModelRing K (d + 1 + 1) 0 A)))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 A) (MvPolynomial.X p) ∉ y.asIdeal} → ∀ (OB : (Spec (.of (wcQuadModelRing K (d + 1 + 1) 0 B))).Opens), (OB : Set (Spec (.of (wcQuadModelRing K (d + 1 + 1) 0 B)))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 B) (MvPolynomial.X p) ∉ y.asIdeal} → ∀ (M q : ℕ), Nonempty (wcEtCoh (OA : Scheme.{u}) M q ≃ wcEtCoh (OB : Scheme.{u}) M q) :=
by
  intro K _ d A B P hP hQ OA hOA OB hOB M q
  classical

  have hQ' : (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
      MvPolynomial.C ((P.transpose * A * P) p q) * (MvPolynomial.X p * MvPolynomial.X q) :
        MvPolynomial (Fin (d + 1 + 1)) K) =
      ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
        MvPolynomial.C (B p q) * (MvPolynomial.X p * MvPolynomial.X q) :=
    congrArg Subtype.val hQ

  obtain ⟨lin, hlin⟩ : ∃ lin : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) K →
      Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1 + 1)) K,
      ∀ R i, lin R i = ∑ j, MvPolynomial.C (R i j) * MvPolynomial.X j :=
    ⟨fun R i => ∑ j, MvPolynomial.C (R i j) * MvPolynomial.X j, fun _ _ => rfl⟩
  have hcomp : ∀ (R S : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) K) (i : Fin (d + 1 + 1)),
      MvPolynomial.aeval (lin R) (lin S i) = lin (S * R) i := by
    intro R S i
    rw [hlin S, hlin (S * R)]
    simp only [map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq, hlin R, Matrix.mul_apply, Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_comm.trans ?_
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun p _ => ?_
    ring
  have hone : ∀ i, lin 1 i = MvPolynomial.X i := by
    intro i
    rw [hlin, Finset.sum_eq_single i
      (fun j _ hj => by rw [Matrix.one_apply_ne' hj, map_zero, zero_mul])
      (fun h => absurd (Finset.mem_univ i) h), Matrix.one_apply_eq, map_one, one_mul]

  set α : MvPolynomial (Fin (d + 1 + 1)) K →ₐ[K] MvPolynomial (Fin (d + 1 + 1)) K :=
    MvPolynomial.aeval (lin P) with hα
  set β : MvPolynomial (Fin (d + 1 + 1)) K →ₐ[K] MvPolynomial (Fin (d + 1 + 1)) K :=
    MvPolynomial.aeval (lin P⁻¹) with hβ
  have hαβX : ∀ i, α (lin P⁻¹ i) = MvPolynomial.X i := by
    intro i
    rw [hα, hcomp, Matrix.nonsing_inv_mul P hP, hone]
  have hβαX : ∀ i, β (lin P i) = MvPolynomial.X i := by
    intro i
    rw [hβ, hcomp, Matrix.mul_nonsing_inv P hP, hone]
  have h1 : α.comp β = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, AlgHom.id_apply]
    have e : β (MvPolynomial.X i) = lin P⁻¹ i := by rw [hβ, MvPolynomial.aeval_X]
    rw [e, hαβX]
  have h2 : β.comp α = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, AlgHom.id_apply]
    have e : α (MvPolynomial.X i) = lin P i := by rw [hα, MvPolynomial.aeval_X]
    rw [e, hβαX]
  let αe := AlgEquiv.ofAlgHom α β h1 h2

  have hαF : α (∑ p, ∑ q, MvPolynomial.C (A p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C 0) =
      ∑ p, ∑ q, MvPolynomial.C (B p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C 0 := by
    rw [hα]
    simp only [map_sub, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq]
    congr 1
    calc (∑ p, ∑ q, MvPolynomial.C (A p q) * lin P p * lin P q)
        = ∑ p, ∑ q, ∑ i, ∑ j, MvPolynomial.C (A p q) * (MvPolynomial.C (P p i) *
            MvPolynomial.X i * (MvPolynomial.C (P q j) * MvPolynomial.X j)) := by
          refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
          rw [hlin, hlin, mul_assoc, Finset.sum_mul_sum, Finset.mul_sum]
          exact Finset.sum_congr rfl fun i _ => by rw [Finset.mul_sum]
      _ = ∑ i, ∑ p, ∑ q, ∑ j, MvPolynomial.C (A p q) * (MvPolynomial.C (P p i) *
            MvPolynomial.X i * (MvPolynomial.C (P q j) * MvPolynomial.X j)) := by
          refine (Finset.sum_congr rfl fun p _ => Finset.sum_comm).trans ?_
          exact Finset.sum_comm
      _ = ∑ i, ∑ j, ∑ p, ∑ q, MvPolynomial.C (A p q) * (MvPolynomial.C (P p i) *
            MvPolynomial.X i * (MvPolynomial.C (P q j) * MvPolynomial.X j)) := by
          refine (Finset.sum_congr rfl fun i _ => (Finset.sum_congr rfl fun p _ =>
            Finset.sum_comm).trans ?_)
          exact Finset.sum_comm
      _ = ∑ i, ∑ j, MvPolynomial.C ((P.transpose * A * P) i j) *
            (MvPolynomial.X i * MvPolynomial.X j) := by
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          refine Finset.sum_comm.trans ?_
          simp only [Matrix.mul_apply, Matrix.transpose_apply, map_sum, map_mul, Finset.sum_mul]
          exact Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun p _ => by ring
      _ = ∑ i, ∑ j, MvPolynomial.C (B i j) * (MvPolynomial.X i * MvPolynomial.X j) := hQ'
      _ = ∑ i, ∑ j, MvPolynomial.C (B i j) * MvPolynomial.X i * MvPolynomial.X j := by
          simp only [mul_assoc]

  have hIJ : wcQuadModelIdeal K (d + 1 + 1) 0 B =
      Ideal.map αe (wcQuadModelIdeal K (d + 1 + 1) 0 A) := by
    show Ideal.span _ = Ideal.map _ (Ideal.span _)
    rw [Ideal.map_span, Set.image_singleton]
    exact congrArg (fun x => Ideal.span {x}) hαF.symm
  let ψ : wcQuadModelRing K (d + 1 + 1) 0 A ≃+* wcQuadModelRing K (d + 1 + 1) 0 B :=
    (Ideal.quotientEquivAlg (wcQuadModelIdeal K (d + 1 + 1) 0 A)
      (wcQuadModelIdeal K (d + 1 + 1) 0 B) αe hIJ).toRingEquiv
  have hψmk : ∀ x, ψ (Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 A) x) =
      Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 B) (α x) := fun x => rfl
  have crit : ∀ J : Ideal (wcQuadModelRing K (d + 1 + 1) 0 B),
      (∀ p, ψ (Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 A) (MvPolynomial.X p)) ∈ J) ↔
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 B) (MvPolynomial.X p) ∈ J) := by
    intro J
    constructor
    · intro h i
      have e : Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 B) (MvPolynomial.X i) =
          ψ (Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 A) (lin P⁻¹ i)) := by
        rw [hψmk, hαβX]
      rw [e, hlin]
      simp only [map_sum, map_mul]
      exact Ideal.sum_mem J fun p _ => J.mul_mem_left _ (h p)
    · intro h p
      rw [hψmk, hα, MvPolynomial.aeval_X, hlin]
      simp only [map_sum, map_mul]
      exact Ideal.sum_mem J fun i _ => J.mul_mem_left _ (h i)

  let Φ : Spec (.of (wcQuadModelRing K (d + 1 + 1) 0 B)) ⟶
      Spec (.of (wcQuadModelRing K (d + 1 + 1) 0 A)) := Spec.map ψ.toCommRingCatIso.hom
  have hmem : ∀ y, Φ.base y ∈ (OA : Set _) ↔ y ∈ (OB : Set _) := by
    intro y
    have e : (Φ.base y).asIdeal = Ideal.comap (ψ : wcQuadModelRing K (d + 1 + 1) 0 A →+*
        wcQuadModelRing K (d + 1 + 1) 0 B) y.asIdeal := by
      rw [Spec.map_apply]
      rfl
    rw [hOA, hOB]
    show (∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 A) (MvPolynomial.X p) ∉
        (Φ.base y).asIdeal) ↔
      (∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (d + 1 + 1) 0 B) (MvPolynomial.X p) ∉ y.asIdeal)
    rw [e]
    simp only [Ideal.mem_comap, RingEquiv.coe_toRingHom]
    rw [← not_forall, ← not_forall, not_iff_not]
    exact crit y.asIdeal
  have hsec : ∀ x, Φ.base ((inv Φ).base x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]
    rfl
  have hrange : Set.range (OB.ι ≫ Φ).base = Set.range OA.ι.base := by
    rw [Scheme.Opens.range_ι]
    ext x
    constructor
    · rintro ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      refine (hmem _).2 ?_
      have hz : OB.ι.base z ∈ Set.range OB.ι.base := Set.mem_range_self z
      rwa [Scheme.Opens.range_ι] at hz
    · intro hx
      have hy : (inv Φ).base x ∈ Set.range OB.ι.base := by
        rw [Scheme.Opens.range_ι]
        refine (hmem _).1 ?_
        rw [hsec]
        exact hx
      obtain ⟨z, hz⟩ := hy
      exact ⟨z, by rw [Scheme.Hom.comp_apply, hz, hsec]⟩
  let E : (OB : Scheme.{u}) ≅ (OA : Scheme.{u}) :=
    IsOpenImmersion.isoOfRangeEq (OB.ι ≫ Φ) OA.ι hrange
  exact wc_et_coh_iso_invariance E.hom M q

theorem wc_hyp_quad_cone_punct_smooth_qcsep : ∀ (K : Type u) [Field K] [IsAlgClosed K] (e : ℕ) (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens), (Oh : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} → SmoothOfRelativeDimension (2 * e + 1) (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) ∧ CompactSpace ↥(Oh : Scheme.{u}) ∧ IsSeparated (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) :=
by
  intro K _ _ e Oh hOh
  classical



  have hs1 : ∀ (R : Type u) [CommRing R] [Algebra K R] {ι : Type} (f : ι → R)
      (O : (Spec (.of R)).Opens), (O : Set (Spec (.of R))) = {y | ∃ i, f i ∉ y.asIdeal} →
      ∀ (N : ℕ), (∀ i, Algebra.IsStandardSmoothOfRelativeDimension N K (Localization.Away (f i))) →
      SmoothOfRelativeDimension N (O.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K R))) := by
    intro R _ _ ι f O hO N hsm
    have hle : ∀ i, @LE.le (Spec (.of R)).Opens _ (PrimeSpectrum.basicOpen (f i)) O := by
      intro i y hy
      have h1 : y ∈ (O : Set (Spec (.of R))) := by
        rw [hO]
        exact ⟨i, (PrimeSpectrum.mem_basicOpen _ _).mp hy⟩
      exact h1
    have hU : iSup (fun i => O.ι ⁻¹ᵁ (PrimeSpectrum.basicOpen (f i) : (Spec (.of R)).Opens)) = ⊤ := by
      rw [eq_top_iff]
      rintro x -
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx : (O.ι x : Spec (.of R)) ∈ (O : Set (Spec (.of R))) := by
        rw [← Scheme.Opens.range_ι O]
