      ((Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dx)).val.app (Opposite.op W)).hom t = 0 ↔
        ∀ z : W.left, eC.hom (W.hom z) = IsLocalRing.closedPoint C →
          (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from t) z = 0 :=
by
  intro W t
  classical

  have hTop : ∀ {S X : Scheme.{u}} (w : S ⟶ X) (xs : X) (hcl : IsClosed ({xs} : Set X))
      (hex : ∃ s : S, w s = xs) (huniq : ∀ s s' : S, w s = xs → w s' = xs → s = s')
      (eC : S ≅ Spec (.of C)), ∀ s : S, w s = xs ↔ eC.hom s = IsLocalRing.closedPoint C := by
    intro S X w xs hcl hex huniq eC
    have back : ∀ s : S, eC.hom s = IsLocalRing.closedPoint C → w s = xs := by
      intro s hs
      obtain ⟨s₀, hs₀⟩ := hex
      have h1 : eC.hom s₀ ⤳ eC.hom s := by
        rw [hs]; exact IsLocalRing.specializes_closedPoint _
      have h2 : s₀ ⤳ s := by
        have := h1.map eC.inv.continuous
        simpa only [Scheme.hom_inv_apply] using this
      have h3 : w s₀ ⤳ w s := h2.map w.continuous
      rw [hs₀] at h3
      exact Set.mem_singleton_iff.mp (h3.mem_closed hcl (Set.mem_singleton xs))
    intro s
    refine ⟨fun hs => ?_, back s⟩
    have hc : w (eC.inv (IsLocalRing.closedPoint C)) = xs := back _ (Scheme.inv_hom_apply _ _)
    exact (congrArg eC.hom (huniq s _ hs hc)).trans (Scheme.inv_hom_apply _ _)

  have hTw : ∀ {X Z : Scheme.{u}} (ι : Z ⟶ X) (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
      (U : X.ProEt) (s : C(↥U.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom s = 0 ↔
        ∀ z : U.left, U.hom z ∈ Set.range ι → s z = 0 := by
    intro X Z ι Di hDi U s
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Di
    have hτ : ∀ y : Z, wcSuppTwist (wcSuppUnitMap Di) y ≠ 0 := by
      intro y hy
      have h1 : wcSuppTwist (wcSuppUnitMap Di) y * c' y = 1 :=
        congrArg (fun g : C(↥Z, ULift.{u+1} ℚ_[ℓ]) => g y) hc'
      rw [hy, zero_mul] at h1
      exact zero_ne_one h1
    have hF := wc_supp_hom_twist_formula Di hDi (wcSuppUnitMap Di) U s
    have key : ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom s = 0 ↔
        (s.comp (Limits.pullback.fst U.hom ι).base.hom *
          (wcSuppTwist (wcSuppUnitMap Di)).comp (Limits.pullback.snd U.hom ι).base.hom) = 0 := by
      constructor
      · intro h; exact hF.symm.trans h
      · intro h; exact hF.trans h
    rw [key]
    constructor
    · intro h z hz
      obtain ⟨y, hy⟩ := hz
      obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback (f := U.hom) (g := ι) z y hy.symm
      have e : s (Limits.pullback.fst U.hom ι q) *
          wcSuppTwist (wcSuppUnitMap Di) (Limits.pullback.snd U.hom ι q) = 0 :=
        congrArg (fun g : C(↥(Limits.pullback U.hom ι), ULift.{u+1} ℚ_[ℓ]) => g q) h
      rw [hq1, hq2] at e
      exact (mul_eq_zero.mp e).resolve_right (hτ y)
    · intro h
      apply ContinuousMap.ext
      intro q
      show s (Limits.pullback.fst U.hom ι q) *
        wcSuppTwist (wcSuppUnitMap Di) (Limits.pullback.snd U.hom ι q) = 0
      have hc : U.hom (Limits.pullback.fst U.hom ι q) = ι (Limits.pullback.snd U.hom ι q) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
