theorem wc_pmn_nbs_p_kernel_char (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx)
    (Dw : wcHMPullData (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (hDw : wcHMPullCanonical Dw) (h2 : n = 2)
    (C : Type u) [CommRing C] [IsLocalRing C]
    (eC : Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≅ Spec (.of C)) :
    ∀ (W : (Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))).ProEt)
      (t : (SheafOfModules.unit (wcRingSheaf (Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)).val.obj
