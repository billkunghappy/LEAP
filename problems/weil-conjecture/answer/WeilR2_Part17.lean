      Function.Injective (fun f : wcSuppObj D ⟶ N => γ ≫ (wcSliceRes S ℓ U).map f) := by
    intro S Z Z' U _ hUa hSn i _ i' g' hsq hg' D hepiD D' μ γ hγ N
    haveI := hepiD
    haveI := hg'
    have sep : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (W : S.ProEt) (R : Sieve W),
        R ∈ Scheme.ProEt.topology S W → ∀ x : ↑(M.val.obj (Opposite.op W)),
        (∀ (Q : S.ProEt) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
      intro M W R hR x h
      have hs := ((SheafOfModules.toSheaf _).obj M).cond
      have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
        (forget AddCommGrpCat.{u+1})).1 hs
      exact (h2.isSeparated W R hR) x 0
        (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
    intro f₁ f₂ hf
    have hf' : γ ≫ (wcSliceRes S ℓ U).map f₁ = γ ≫ (wcSliceRes S ℓ U).map f₂ := hf
    have hRw : (wcSliceRes S ℓ U).map (wcSuppUnitMap D ≫ f₁) =
        (wcSliceRes S ℓ U).map (wcSuppUnitMap D ≫ f₂) := by
      have key : ∀ f : wcSuppObj D ⟶ N, (wcSliceRes S ℓ U).map (wcSuppUnitMap D ≫ f) =
          μ.hom ≫ wcSuppUnitMap D' ≫ γ ≫ (wcSliceRes S ℓ U).map f := by
        intro f
        rw [Functor.map_comp, reassoc_of% hγ, Iso.hom_inv_id_assoc]
      rw [key, key, hf']
    have hnatw : ∀ (w : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ N) {P Q : S.ProEt} (h : Q ⟶ P),
