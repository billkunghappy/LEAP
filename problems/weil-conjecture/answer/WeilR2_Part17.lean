by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r y hy hx0 hx1 B _ _ _ Λ _ _ W' φ a hsh Ω _ _ ξ hξ q hq
  classical
  have hℓp : ℓ.Prime := Fact.out
