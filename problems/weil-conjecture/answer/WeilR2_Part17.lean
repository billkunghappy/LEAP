  have ha' := wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh
  have hw : WeaklyEtale (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback a' _) ha'
  have hgeo := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  obtain ⟨hex, huniq⟩ := wc_pmn_ldp_shens_germ_xs_point_unique F' F'' Y n D i V A e x hx₁ hx₂
    B Λ' W'' φ' a' hsh xs hxs
  have hpt := hTop (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) xs hgeo.1 hex huniq eC
  obtain ⟨m, ⟨m', hmm'⟩, hiff⟩ := hSl _ hw Dw hDw _ (wcSuppUnitMap Dx) W
  have hfin : ∀ z : W.left,
      ((wcSliceFunctor _ (MorphismProperty.Over.mk ⊤ _ hw : (Limits.pullback
        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).ProEt)).obj W).hom z ∈
        Set.range (wcEtGeomPt
          (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ↔
      eC.hom (W.hom z) = IsLocalRing.closedPoint C := by
    intro z
    have e2 : ((wcSliceFunctor _ (MorphismProperty.Over.mk ⊤ _ hw : (Limits.pullback
        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).ProEt)).obj W).hom z =
        Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (W.hom z) := by
      show (W.hom ≫ Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) z = _
      exact Scheme.Hom.comp_apply _ _ _
    exact (Eq.to_iff (congrArg (· ∈ Set.range (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs)) e2)).trans
      ((hgeom _).trans (hpt _))
  refine (hiff t).trans ?_
  refine (hTw _ Dx hDx _ _).trans ?_
  refine forall_congr' fun z => ?_
  have hmz : m z ≠ 0 := by
    intro h
    have h1 : m z * m' z = 1 := congrArg (fun g : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) => g z) hmm'
    rw [h, zero_mul] at h1
    exact zero_ne_one h1
  have h2 : ∀ tt : C(↥W.left, ULift.{u+1} ℚ_[ℓ]), (tt * m) z = 0 ↔ tt z = 0 := by
    intro tt
    have e : (tt * m) z = tt z * m z := ContinuousMap.mul_apply tt m z
    exact (Eq.to_iff (congrArg (· = 0) e)).trans (mul_eq_zero.trans (or_iff_left hmz))
  exact imp_congr (hfin z) (h2 _)

theorem wc_pmn_nbs_p_epi (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx)
    (Dw : wcHMPullData (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (hDw : wcHMPullCanonical Dw) (h2 : n = 2) :
    Epi (Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dx)) :=
by
  obtain ⟨hcl, hsep, -, -⟩ :=
    wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  haveI := hsep
  haveI : IsClosedImmersion
      ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).fromSpecResidueField
        xs) :=
    AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion.mp hcl
  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists
    ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).fromSpecResidueField
      xs) ℓ
  have hι : Epi (wcSuppUnitMap Dι) := wc_supp_unit_epi_of_closed _ ℓ Dι hDι
  obtain ⟨φ⟩ := wc_supp_obj_sepClosed_geomPt_iso xs Dι hDι Dx hDx
  have h₀epi : Epi (wcSuppUnitMap Dι ≫ φ.hom) := epi_comp _ _
  have hsx : Epi (wcSuppUnitMap Dx) := by
    by_cases h0 : wcSuppUnitMap Dι ≫ φ.hom = 0
    · constructor
      intro T g₁ g₂ _
      apply (cancel_epi (wcSuppUnitMap Dι ≫ φ.hom)).mp
      rw [h0, Limits.zero_comp, Limits.zero_comp]
    · obtain ⟨u, hu⟩ := wc_pmn_supp_unit_line _ _ Dx hDx _ h0
      have : wcSuppUnitMap Dx = u.inv ≫ (wcSuppUnitMap Dι ≫ φ.hom) := by
        rw [hu, Iso.inv_hom_id_assoc]
      rw [this]
      exact epi_comp _ _
  haveI : Dw.Φ.IsLeftAdjoint := Dw.adj.isLeftAdjoint
  exact epi_comp _ _

theorem wc_proet_node_branch_kernel_lift {S : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (C : Type u) [CommRing C] [IsLocalRing C] (eC : S ≅ Spec (.of C))
    (a b : C) (hab : a * b = 0) (hspan : Ideal.span {a, b} = IsLocalRing.maximalIdeal C)
    (P₁ P₂ : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (ev₁ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (P₁ ⟶ M) ≃ M.val.obj (Opposite.op (wcNodeBranchU eC b)))
    (ev₂ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (P₂ ⟶ M) ≃ M.val.obj (Opposite.op (wcNodeBranchU eC a)))
    (hnat₁ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P₁ ⟶ M),
      ev₁ N (g ≫ ψ) = (ψ.val.app (Opposite.op (wcNodeBranchU eC b))).hom (ev₁ M g))
    (hadd₁ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : P₁ ⟶ M),
      ev₁ M (g + g') = ev₁ M g + ev₁ M g')
    (hnat₂ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P₂ ⟶ M),
      ev₂ N (g ≫ ψ) = (ψ.val.app (Opposite.op (wcNodeBranchU eC a))).hom (ev₂ M g))
    (hadd₂ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : P₂ ⟶ M),
      ev₂ M (g + g') = ev₂ M g + ev₂ M g')
    (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (p : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M)
    (hker : ∀ (W : S.ProEt) (t : (SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op W)),
      (p.val.app (Opposite.op W)).hom t = 0 ↔
        ∀ z : W.left, eC.hom (W.hom z) = IsLocalRing.closedPoint C →
          (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from t) z = 0)
    (hz : Limits.biprod.desc
        ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC b)))
        ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC a))) ≫ p = 0) :
    (ShortComplex.mk _ _ hz).Exact :=
by
  classical

  have hlift : ∀ (U₀ : S.ProEt) (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (P ⟶ M) ≃ M.val.obj (Opposite.op U₀))
      (_ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U₀)).hom (ev M g))
      (gg : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (_ : gg = (ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm (wcModUnitOne _ U₀))
      (V : S.ProEt) (_ : V ⟶ U₀) (f : (wcRingSheaf S ℓ).val.obj (Opposite.op V)),
      ∃ y : P.val.obj (Opposite.op V), (gg.val.app (Opposite.op V)).hom y = f := by
    intro U₀ P ev hnat gg hgg V c f
    have e1 : ev (SheafOfModules.unit (wcRingSheaf S ℓ)) gg = wcModUnitOne _ U₀ := by
      rw [hgg]; exact Equiv.apply_symm_apply _ _
    have h1 := hnat P (SheafOfModules.unit (wcRingSheaf S ℓ)) gg (𝟙 P)
    rw [Category.id_comp, e1] at h1
    refine ⟨f • (P.val.map c.op).hom (ev P (𝟙 P)), ?_⟩
    have e2 := (gg.val.app (Opposite.op V)).hom.map_smul f ((P.val.map c.op).hom (ev P (𝟙 P)))
    have e3 := PresheafOfModules.naturality_apply gg.val c.op (ev P (𝟙 P))
    have h2 : ((SheafOfModules.unit (wcRingSheaf S ℓ)).val.map c.op).hom
        ((gg.val.app (Opposite.op U₀)).hom (ev P (𝟙 P))) =
        (1 : (wcRingSheaf S ℓ).val.obj (Opposite.op V)) := by
      rw [← h1]; exact PresheafOfModules.unit_map_one _ _
    exact e2.trans ((congrArg (fun z => f • z) (e3.trans h2)).trans (mul_one f))
  have key : ∀ (g₁ : P₁ ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (g₂ : P₂ ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)),
      g₁ = (ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC b)) →
      g₂ = (ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC a)) →
      ∀ hz' : Limits.biprod.desc g₁ g₂ ≫ p = 0, (ShortComplex.mk _ _ hz').Exact := by
    intro g₁ g₂ hg₁ hg₂ hz'
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    show Epi (Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz')
    apply Abelian.epi_of_cokernel_π_eq_zero
    have hl : ∀ (V : (S.ProEt)ᵒᵖ) (z : (Limits.biprod P₁ P₂).val.obj V),
        ((Limits.kernel.ι p).val.app V).hom
          (((Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz').val.app V).hom z) =
          ((Limits.biprod.desc g₁ g₂).val.app V).hom z := fun V z =>
      congrArg (fun ψ => (ψ.val.app V).hom z) (Limits.kernel.lift_ι p _ hz')
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
    rcases U with ⟨U⟩
    ext k
    change ((Limits.cokernel.π (Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz')).val.app
      (Opposite.op U)).hom k = 0
    apply wc_proet_module_section_eq_zero_of_affine_covers
      (Limits.cokernel (Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz')) U
    intro W g hW
    haveI : IsAffine W.left := hW
    haveI : WeaklyEtale W.hom := W.prop
    let t : C(↥U.left, ULift.{u+1} ℚ_[ℓ]) := ((Limits.kernel.ι p).val.app (Opposite.op U)).hom k
    have hk0 : (p.val.app (Opposite.op U)).hom
        (((Limits.kernel.ι p).val.app (Opposite.op U)).hom k) = 0 := by
      have hk := congrArg (fun φ => (φ.val.app (Opposite.op U)).hom k) (Limits.kernel.condition p)
      change (p.val.app (Opposite.op U)).hom
        (((Limits.kernel.ι p).val.app (Opposite.op U)).hom k) = 0 at hk
      exact hk
    have hvan := (hker U (((Limits.kernel.ι p).val.app (Opposite.op U)).hom k)).mp hk0
    have hτ : ∀ x : ↥W.left, eC.hom (W.hom x) = IsLocalRing.closedPoint C →
        (t.comp g.left.base.hom) x = 0 := by
      intro x hx
      have e : U.hom (g.left x) = W.hom x := by
        rw [← MorphismProperty.Over.w g]; rfl
      exact hvan (g.left x) (by rw [e]; exact hx)
    obtain ⟨W₀, q, hW₀, hq, hq0, hqr⟩ :=
      wc_affine_zero_locus_weaklyEtale W.left ℓ (t.comp g.left.base.hom)
    haveI := hq
    let B : C → W.left.Opens := fun f => (W.hom ≫ eC.hom) ⁻¹ᵁ PrimeSpectrum.basicOpen f
    have hBaff : ∀ f : C, IsAffineOpen (B f) := by
      intro f
      have e := Scheme.preimage_basicOpen (W.hom ≫ eC.hom)
        ((Scheme.ΓSpecIso (CommRingCat.of C)).inv f)
      rw [basicOpen_eq_of_affine] at e
      show IsAffineOpen ((W.hom ≫ eC.hom) ⁻¹ᵁ PrimeSpectrum.basicOpen f)
      rw [e]
      exact (isAffineOpen_top W.left).basicOpen _
    let Wf : C → S.ProEt := fun f => wcVRes S W (B f)
    let ef : ∀ f, Wf f ⟶ W := fun f => MorphismProperty.Over.homMk (B f).ι rfl trivial
    have hcf : ∀ f : C, Nonempty (Wf f ⟶ wcNodeBranchU eC f) := by
      intro f
      let O : S.Opens := eC.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f
      have hle : B f ≤ W.hom ⁻¹ᵁ O := by
        intro x hx
        first
          | exact hx
          | simpa [O, B, Scheme.Hom.comp_apply] using hx
      exact ⟨MorphismProperty.Over.homMk (W.hom.resLE O (B f) hle)
        (by
          show W.hom.resLE O (B f) hle ≫ (O.ι ≫ 𝟙 S) = (B f).ι ≫ W.hom
          rw [Category.comp_id, Scheme.Hom.resLE_comp_ι]) trivial⟩
    let Z : S.ProEt := MorphismProperty.Over.mk ⊤ (q ≫ W.hom) inferInstance
    let W' : Fin 3 → S.ProEt := Fin.cases Z (Fin.cases (Wf b) (fun _ => Wf a))
    let e : ∀ j, W' j ⟶ W := Fin.cases (motive := fun j => W' j ⟶ W)
      (MorphismProperty.Over.homMk q rfl trivial)
      (Fin.cases (motive := fun j => W' j.succ ⟶ W) (ef b) (fun _ => ef a))
    have hcases : ∀ j, t.comp (e j ≫ g).left.base.hom = 0 ∨
        Nonempty (W' j ⟶ wcNodeBranchU eC b) ∨ Nonempty (W' j ⟶ wcNodeBranchU eC a) := by
      intro j
      fin_cases j
      · left
        ext w
        exact congrArg ULift.down (hq0 w)
      · exact Or.inr (Or.inl (hcf b))
      · exact Or.inr (Or.inr (hcf a))
    refine ⟨3, W', e, ?_, ?_, fun j => ?_⟩
    · intro j
      fin_cases j
      · exact hW₀
      · exact hBaff b
      · exact hBaff a
    · intro x
      let 𝔭 : PrimeSpectrum C := eC.hom (W.hom x)
      by_cases hx : eC.hom (W.hom x) = IsLocalRing.closedPoint C
      · exact ⟨0, hqr x (hτ x hx)⟩
      · have hab' : b ∉ 𝔭.asIdeal ∨ a ∉ 𝔭.asIdeal := by
          by_contra hcon
          push_neg at hcon
          apply hx
          have h1 : IsLocalRing.maximalIdeal C ≤ 𝔭.asIdeal := by
            rw [← hspan, Ideal.span_le]
            intro y hy
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
            rcases hy with rfl | rfl
            · exact hcon.2
            · exact hcon.1
          have h2 : 𝔭.asIdeal ≤ IsLocalRing.maximalIdeal C :=
            IsLocalRing.le_maximalIdeal 𝔭.isPrime.ne_top
          exact PrimeSpectrum.ext (le_antisymm h2 h1)
        rcases hab' with hb | ha
        · refine ⟨1, ?_⟩
          show x ∈ Set.range (B b).ι
          rw [Scheme.Opens.range_ι]
          exact (PrimeSpectrum.mem_basicOpen b 𝔭).mpr hb
        · refine ⟨2, ?_⟩
          show x ∈ Set.range (B a).ι
          rw [Scheme.Opens.range_ι]
          exact (PrimeSpectrum.mem_basicOpen a 𝔭).mpr ha
    · have hn := PresheafOfModules.naturality_apply
        (Limits.cokernel.π (Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz')).val
        (e j ≫ g).op k
      refine hn.symm.trans ?_
      have hinj : Function.Injective
          ((Limits.kernel.ι p).val.app (Opposite.op (W' j))).hom := by
        let G := SheafOfModules.forget (wcRingSheaf S ℓ) ⋙
          PresheafOfModules.evaluation _ (Opposite.op (W' j))
        have hmono : Mono (G.map (Limits.kernel.ι p)) := Functor.map_mono G _
        exact (ModuleCat.mono_iff_injective _).mp hmono
      have hιkj : ((Limits.kernel.ι p).val.app (Opposite.op (W' j))).hom
          (((Limits.kernel p).val.map (e j ≫ g).op).hom k) = t.comp (e j ≫ g).left.base.hom :=
        PresheafOfModules.naturality_apply (Limits.kernel.ι p).val (e j ≫ g).op k
      have hfin : ∀ z : (Limits.biprod P₁ P₂).val.obj (Opposite.op (W' j)),
          ((Limits.biprod.desc g₁ g₂).val.app (Opposite.op (W' j))).hom z =
            t.comp (e j ≫ g).left.base.hom →
          ((Limits.cokernel.π (Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz')).val.app
            (Opposite.op (W' j))).hom (((Limits.kernel p).val.map (e j ≫ g).op).hom k) = 0 := by
        intro z hz2
        have hκz : ((Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz').val.app
            (Opposite.op (W' j))).hom z = ((Limits.kernel p).val.map (e j ≫ g).op).hom k :=
          hinj ((hl _ z).trans (hz2.trans hιkj.symm))
        rw [← hκz]
        exact congrArg (fun ψ => (ψ.val.app (Opposite.op (W' j))).hom z)
          (Limits.cokernel.condition (Limits.kernel.lift p (Limits.biprod.desc g₁ g₂) hz'))
      rcases hcases j with h0 | hc | hc
      · have hk0' : ((Limits.kernel p).val.map (e j ≫ g).op).hom k = 0 :=
          hinj (hιkj.trans (h0.trans (map_zero _).symm))
        rw [hk0']
        exact map_zero _
      · obtain ⟨c⟩ := hc
        obtain ⟨y, hy⟩ := hlift _ P₁ ev₁ hnat₁ g₁ hg₁ (W' j) c (t.comp (e j ≫ g).left.base.hom)
        have h : ((Limits.biprod.desc g₁ g₂).val.app (Opposite.op (W' j))).hom
            (((Limits.biprod.inl : P₁ ⟶ Limits.biprod P₁ P₂).val.app (Opposite.op (W' j))).hom y) =
            (g₁.val.app (Opposite.op (W' j))).hom y :=
          congrArg (fun ψ => (ψ.val.app (Opposite.op (W' j))).hom y) (Limits.biprod.inl_desc g₁ g₂)
        exact hfin _ (h.trans hy)
      · obtain ⟨c⟩ := hc
        obtain ⟨y, hy⟩ := hlift _ P₂ ev₂ hnat₂ g₂ hg₂ (W' j) c (t.comp (e j ≫ g).left.base.hom)
        have h : ((Limits.biprod.desc g₁ g₂).val.app (Opposite.op (W' j))).hom
            (((Limits.biprod.inr : P₂ ⟶ Limits.biprod P₁ P₂).val.app (Opposite.op (W' j))).hom y) =
            (g₂.val.app (Opposite.op (W' j))).hom y :=
          congrArg (fun ψ => (ψ.val.app (Opposite.op (W' j))).hom y) (Limits.biprod.inr_desc g₁ g₂)
        exact hfin _ (h.trans hy)
  exact key _ _ rfl rfl hz

theorem wc_proet_disjoint_opens_desc_mono {S : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (O₁ O₂ : S.Opens) (hO : O₁ ⊓ O₂ = ⊥)
    (P₁ P₂ : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (ev₁ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (P₁ ⟶ M) ≃ M.val.obj (Opposite.op (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₁)))
    (ev₂ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (P₂ ⟶ M) ≃ M.val.obj (Opposite.op (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₂)))
    (hnat₁ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P₁ ⟶ M),
      ev₁ N (g ≫ ψ) = (ψ.val.app (Opposite.op (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₁))).hom (ev₁ M g))
    (hadd₁ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : P₁ ⟶ M),
      ev₁ M (g + g') = ev₁ M g + ev₁ M g')
    (hnat₂ : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P₂ ⟶ M),
      ev₂ N (g ≫ ψ) = (ψ.val.app (Opposite.op (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₂))).hom (ev₂ M g))
    (hadd₂ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : P₂ ⟶ M),
      ev₂ M (g + g') = ev₂ M g + ev₂ M g') :
    Mono (Limits.biprod.desc
      ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₁)))
      ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₂)))) :=
by
  classical

  have sEI : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}), EnoughInjectives (SheafOfModules.{u+1} R) := by
    intro C _ J _ _ R
    have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
      let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
        (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
      have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
          uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
            φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
        intro X M N φ h
        rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
        rfl
      have hsep : (ObjectProperty.ofObj G).IsSeparating := by
        intro M N f g hfg
        apply PresheafOfModules.hom_ext
        intro Y
        obtain ⟨X⟩ := Y
        ext m
        let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
          (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
        have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
        have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
          ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
        rw [key, key] at h2
        have h3 : uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
          e.apply_symm_apply m
        rw [h3] at h2
        exact h2
      exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
    have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
      ⟨fun K _ _ =>
        haveI := HasExactColimitsOfShape.domain_of_functor K
          (PresheafOfModules.toPresheaf.{u+1} R.obj)
        (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
    have hs : HasSeparator (SheafOfModules.{u+1} R) :=
      HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
    exact @IsGrothendieckAbelian.enoughInjectives _ _ _
      (IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance h5 hs)


  have sRS : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (I : SheafOfModules.{u+1} R) [Injective I] {U V : C}
      (m : U ⟶ V) [Mono m], Function.Surjective (((SheafOfModules.toSheaf R).obj I).obj.map m.op).hom := by
    intro C _ J _ _ R I _ U V m _
    let adj := (PresheafOfModules.freeAdjunction.{u+1} R.obj).comp
      (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj))
    have hfree : Mono ((PresheafOfModules.free.{u+1} R.obj).map (uliftYoneda.{u+1}.map m)) := by
      rw [PresheafOfModules.mono_iff_surjective]
      intro X
      have h1 : Mono ((uliftYoneda.{u+1}.map m).app X) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance X
      have h2 : Function.Injective ((uliftYoneda.{u+1}.map m).app X) := (mono_iff_injective _).mp h1
      rw [PresheafOfModules.free_map_app]
      exact Finsupp.mapDomain_injective h2
    have hL : Mono ((PresheafOfModules.free.{u+1} R.obj ⋙
        PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m)) := by
      rw [Functor.comp_map]
      exact Functor.map_mono _ _
    intro x
    let b := (adj.homEquiv (uliftYoneda.{u+1}.obj U) I).symm (uliftYonedaEquiv.symm x)
    let c := Injective.factorThru b ((PresheafOfModules.free.{u+1} R.obj ⋙
        PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m))
    have hc : _ ≫ c = b := Injective.comp_factorThru b _
    have key : uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c = uliftYonedaEquiv.symm x := by
      rw [← Adjunction.homEquiv_naturality_left, hc, Equiv.apply_symm_apply]
    refine ⟨uliftYonedaEquiv (adj.homEquiv _ I c), ?_⟩
    have nat := uliftYonedaEquiv_naturality (adj.homEquiv _ I c) m.op
    have e2 : uliftYonedaEquiv (uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c) = x := by
      rw [key]; exact Equiv.apply_symm_apply _ _
    exact nat.trans e2

  have hT : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 S)) :=
    Limits.IsTerminal.ofUniqueHom (C := S.ProEt) (X := Scheme.ProEt.mk (𝟙 S))
      (fun W => MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial)
      (fun _ m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have s1 : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (s : M.val.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S)))),
      ∃ φ : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M, ∀ V : S.ProEt,
        (φ.val.app (Opposite.op V)).hom (wcModUnitOne (wcRingSheaf S ℓ) V) =
          (M.val.map (hT.from V).op).hom s := by
    intro M s
    have huniq : ∀ (X : (S.ProEt)ᵒᵖ) (a b : Opposite.op (Scheme.ProEt.mk (𝟙 S)) ⟶ X), a = b :=
      fun X a b => Quiver.Hom.unop_inj (hT.hom_ext _ _)
    let σ : M.sections := PresheafOfModules.sectionsMk
      (fun X => (M.val.map (hT.from X.unop).op).hom s) (by
        intro X X' f
        have e : (hT.from X'.unop).op = (hT.from X.unop).op ≫ f := huniq X' _ _
        first
          | (rw [e, PresheafOfModules.map_comp]; rfl)
          | (simp only [e, PresheafOfModules.map_comp]; rfl)
          | (rw [e]; simp [PresheafOfModules.map_comp])
          | (rw [e]; simp))
    refine ⟨M.unitHomEquiv.symm σ, fun V => ?_⟩
    have h := SheafOfModules.unitHomEquiv_apply_coe M (M.unitHomEquiv.symm σ) (Opposite.op V)
    rw [Equiv.apply_symm_apply] at h
    exact h.symm

  have s2a : ∀ {Z : Scheme.{u}} (U : Z.ProEt) (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ U),
      (∀ k, IsOpenImmersion (ι k).left) → (∀ x : U.left, ∃ k, x ∈ Set.range ⇑(ι k).left) →
      Presieve.ofArrows P ι ∈ (Scheme.ProEt.precoverage Z).coverings U := by
    intro Z U n P ι hopen hsurj
    show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Z ⋙ Over.forget Z)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    let 𝒰 : Scheme.Cover (Scheme.precoverage @IsOpenImmersion) U.left :=
      Scheme.Cover.mkOfCovers (Fin n) (fun k => (P k).left) (fun k => (ι k).left)
        (fun x => by
          obtain ⟨k, y, hy⟩ := hsurj x
          exact ⟨k, y, hy⟩) (fun k => hopen k)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      QuasiCompactCover.of_isOpenMap (fun k => by
        have := hopen k
        exact (ι k).left.isOpenEmbedding.isOpenMap)
    have h1 : 𝒰.presieve₀ ∈ Scheme.qcPrecoverage.coverings U.left :=
      Scheme.presieve₀_mem_qcPrecoverage_iff.mpr hqc
    change Presieve.ofArrows (fun k => (P k).left) (fun k => (ι k).left) ∈
      Scheme.proetalePrecoverage.coverings U.left
    exact ⟨h1, (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr ⟨hsurj, fun k => by
      have := hopen k
      infer_instance⟩⟩

  have s2b : ∀ {Z : Scheme.{u}} (F : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (U : Z.ProEt) (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ U),
      Presieve.ofArrows P ι ∈ (Scheme.ProEt.precoverage Z).coverings U →
      (∀ k, IsOpenImmersion (ι k).left) →
      (∀ (j k : Fin n) (x : U.left), x ∈ Set.range ⇑(ι j).left → x ∈ Set.range ⇑(ι k).left →
        j = k) →
      Function.Bijective (fun t : F.obj.obj (Opposite.op U) =>
        fun k => (F.obj.map (ι k).op).hom t) := by
    intro Z F U n P ι hcov hopen hdisj
    have hF : Presieve.IsSheaf (Scheme.ProEt.topology Z) (F.obj ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp (GrothendieckTopology.HasSheafCompose.isSheaf _ F.2)
    have hSF : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat) (Presieve.ofArrows P ι) :=
      Presieve.IsSheaf.isSheafFor_of_mem_precoverage (J := Scheme.ProEt.precoverage Z) hF hcov
    rw [Presieve.isSheafFor_arrows_iff] at hSF
    have hcompat : ∀ x : ∀ k, (F.obj ⋙ forget AddCommGrpCat).obj (Opposite.op (P k)),
        Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat) ι x := by
      intro x j k W a b hab
      by_cases hjk : j = k
      · subst hjk
        have := hopen j
        have hm : Mono ((Scheme.ProEt.forget Z ⋙ Over.forget Z).map (ι j)) :=
          IsOpenImmersion.mono (ι j).left
        have : Mono (ι j) := Functor.mono_of_mono_map (Scheme.ProEt.forget Z ⋙ Over.forget Z) hm
        rw [(cancel_mono (ι j)).mp hab]
      · have : IsEmpty W.left := ⟨fun w => hjk (hdisj j k ((ι j).left (a.left w))
          ⟨a.left w, rfl⟩ ⟨b.left w, by
            have e : a.left ≫ (ι j).left = b.left ≫ (ι k).left := congrArg (fun h => h.left) hab
            have hw := congrArg (fun g : W.left ⟶ U.left => g w) e
            simp only [Scheme.Hom.comp_apply] at hw
            exact hw.symm⟩)⟩
        have ht := Sheaf.isTerminalOfBotCover F W (Scheme.ProEt.bot_mem_topology W)
        have hsub : ∀ y : ToType (F.obj.obj (Opposite.op W)), y = 0 := by
          intro y
          have h0 : 𝟙 (F.obj.obj (Opposite.op W)) = 0 := ht.hom_ext _ _
          have := congrArg (fun g => g.hom y) h0
          simpa using this
        exact (hsub _).trans (hsub _).symm
    constructor
    · intro t t' htt
      obtain ⟨u, hu, huniq⟩ := hSF (fun k => (F.obj.map (ι k).op).hom t) (hcompat _)
      have h1 := huniq t (fun k => rfl)
      have h2 := huniq t' (fun k => (congrFun htt k).symm)
      exact h1.trans h2.symm
    · intro x
      obtain ⟨u, hu, -⟩ := hSF x (hcompat x)
      exact ⟨u, funext hu⟩

  let U : S.ProEt := wcVRes S (Scheme.ProEt.mk (𝟙 S)) (O₁ ⊔ O₂)
  let Ok : Fin 2 → S.Opens := ![O₁, O₂]
  have hk : ∀ k : Fin 2, Ok k ≤ O₁ ⊔ O₂ := by
    intro k
    fin_cases k
    · exact le_sup_left
    · exact le_sup_right
  let P : Fin 2 → S.ProEt := fun k => wcVRes S (Scheme.ProEt.mk (𝟙 S)) (Ok k)
  let ι : ∀ k, P k ⟶ U := fun k => wcVResLE S (Scheme.ProEt.mk (𝟙 S)) (hk k)
  have hopen : ∀ k, IsOpenImmersion (ι k).left := fun k =>
    (inferInstance : IsOpenImmersion (S.homOfLE (hk k)))
  have hcomp' : ∀ k : Fin 2, (ι k).left ≫ (O₁ ⊔ O₂).ι = (Ok k).ι := fun k =>
    Scheme.homOfLE_ι S (hk k)
  have hcomp : ∀ (k : Fin 2) (y : (P k).left), (O₁ ⊔ O₂).ι ((ι k).left y) = (Ok k).ι y := by
    intro k y
    have := congrArg (fun g : (P k).left ⟶ S => g y) (hcomp' k)
    simp only [Scheme.Hom.comp_apply] at this
    exact this
  have hmem : ∀ (k : Fin 2) (y : (P k).left), (O₁ ⊔ O₂).ι ((ι k).left y) ∈ Ok k := by
    intro k y
    rw [hcomp k y]
    show _ ∈ ((Ok k : S.Opens) : Set S)
    rw [← Scheme.Opens.range_ι (Ok k)]
    exact ⟨y, rfl⟩
  have hdisj : ∀ (j k : Fin 2) (x : U.left), x ∈ Set.range ⇑(ι j).left →
      x ∈ Set.range ⇑(ι k).left → j = k := by
    intro j k x hj hk'
    obtain ⟨y, rfl⟩ := hj
    obtain ⟨z, hz⟩ := hk'
    have h1 := hmem j y
    have h2 := hmem k z
    rw [hz] at h2
    have hne : ∀ p : S, p ∈ O₁ → p ∈ O₂ → False := by
      intro p hp1 hp2
      have h3 : p ∈ O₁ ⊓ O₂ := TopologicalSpace.Opens.mem_inf.mpr ⟨hp1, hp2⟩
      rw [hO] at h3
      simp at h3
    fin_cases j <;> fin_cases k
    · rfl
    · exact (hne _ h1 h2).elim
    · exact (hne _ h2 h1).elim
    · rfl
  have hsurj : ∀ x : U.left, ∃ k, x ∈ Set.range ⇑(ι k).left := by
    intro x
    have hx : (O₁ ⊔ O₂).ι x ∈ O₁ ⊔ O₂ := by
      show _ ∈ ((O₁ ⊔ O₂ : S.Opens) : Set S)
      rw [← Scheme.Opens.range_ι (O₁ ⊔ O₂)]
      exact ⟨x, rfl⟩
    have hrange : ∀ k : Fin 2, (O₁ ⊔ O₂).ι x ∈ Ok k → x ∈ Set.range ⇑(ι k).left := by
      intro k hk'
      have hk'' : (O₁ ⊔ O₂).ι x ∈ Set.range ⇑(Ok k).ι := by
        rw [Scheme.Opens.range_ι]; exact hk'
      obtain ⟨y, hy⟩ := hk''
      exact ⟨y, (O₁ ⊔ O₂).ι.isOpenEmbedding.injective ((hcomp k y).trans hy)⟩
    rcases TopologicalSpace.Opens.mem_sup.mp hx with h | h
    · exact ⟨0, hrange 0 h⟩
    · exact ⟨1, hrange 1 h⟩

  haveI hm : Mono (hT.from U) := by
    constructor
    intro W g h _
    apply MorphismProperty.Over.Hom.ext
    have e1 : g.left ≫ U.hom = h.left ≫ U.hom :=
      (MorphismProperty.Over.w g).trans (MorphismProperty.Over.w h).symm
    have e4 : g.left ≫ ((O₁ ⊔ O₂).ι ≫ 𝟙 S) = h.left ≫ ((O₁ ⊔ O₂).ι ≫ 𝟙 S) := e1
    haveI : Mono (O₁ ⊔ O₂).ι := IsOpenImmersion.mono _
    exact (cancel_mono ((O₁ ⊔ O₂).ι ≫ 𝟙 S)).mp e4

  haveI := sEI (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  let I := Injective.under (P₁ ⊞ P₂)
  let ιA : P₁ ⊞ P₂ ⟶ I := Injective.ι (P₁ ⊞ P₂)
  haveI : Injective I := Injective.injective_under _
  let F := (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj I
  let x : ∀ k : Fin 2, ToType (F.obj.obj (Opposite.op (P k))) := fun k =>
    Fin.cases (motive := fun k => ToType (F.obj.obj (Opposite.op (P k))))
      (ev₁ I (Limits.biprod.inl ≫ ιA))
      (fun j => Fin.cases (motive := fun j : Fin 1 => ToType (F.obj.obj (Opposite.op (P j.succ))))
        (ev₂ I (Limits.biprod.inr ≫ ιA)) (fun i => i.elim0) j) k

  have hbij := s2b F U 2 P ι (s2a U 2 P ι hopen hsurj) hopen hdisj
  obtain ⟨t, ht⟩ := hbij.2 x

  obtain ⟨s, hs⟩ := sRS (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) I (hT.from U) t

  obtain ⟨φ, hφ⟩ := s1 I s

  have hφk : ∀ k : Fin 2,
      (φ.val.app (Opposite.op (P k))).hom (wcModUnitOne (wcRingSheaf S ℓ) (P k)) = x k := by
    intro k
    refine (hφ (P k)).trans ?_
    have e : hT.from (P k) = ι k ≫ hT.from U := hT.hom_ext _ _
    show (F.obj.map (hT.from (P k)).op).hom s = x k
    rw [e, op_comp, Functor.map_comp]
    exact (congrArg (F.obj.map (ι k).op).hom hs).trans (congrFun ht k)
  have hD : Limits.biprod.desc
      ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₁)))
      ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcVRes S (Scheme.ProEt.mk (𝟙 S)) O₂)))
      ≫ φ = ιA := by
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc_assoc]
      apply (ev₁ I).injective
      refine (hnat₁ _ _ φ _).trans ?_
      rw [Equiv.apply_symm_apply]
      exact hφk 0
    · rw [Limits.biprod.inr_desc_assoc]
      apply (ev₂ I).injective
      refine (hnat₂ _ _ φ _).trans ?_
      rw [Equiv.apply_symm_apply]
      exact hφk 1
  refine Preadditive.mono_of_cancel_zero _ (fun {Z} h hh => ?_)
  have h1 : h ≫ ιA = 0 := by
    rw [← hD, ← Category.assoc, hh, Limits.zero_comp]
  exact (cancel_mono ιA).mp (by rw [h1, Limits.zero_comp])

theorem wc_pmn_ldp_node_branch_ses (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx)
    (Dw : wcHMPullData (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (hDw : wcHMPullCanonical Dw) (h2 : n = 2)
    (C : Type u) [CommRing C] [IsLocalRing C]
    (eC : Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ≅ Spec (.of C))
    (a b : C) (hab : a * b = 0) (hspan : Ideal.span {a, b} = IsLocalRing.maximalIdeal C)
    (K₁ K₂ : Type u) [Field K₁] [Field K₂] [Algebra C K₁] [Algebra C K₂]
    [IsLocalization.Away b K₁] [IsLocalization.Away a K₂] (G : Prop)
    (k : ∀ (U₁ U₂ : (Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))).ProEt)
      (eU₁ : U₁.left ≅ Spec (.of K₁)) (eU₂ : U₂.left ≅ Spec (.of K₂)),
      eU₁.inv ≫ U₁.hom ≫ eC.hom = Spec.map (CommRingCat.ofHom (algebraMap C K₁)) →
      eU₂.inv ≫ U₂.hom ≫ eC.hom = Spec.map (CommRingCat.ofHom (algebraMap C K₂)) →
      ∀ (P₁ P₂ : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
        (ev₁ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ),
          (P₁ ⟶ M) ≃ M.val.obj (Opposite.op U₁))
        (ev₂ : ∀ M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ),
          (P₂ ⟶ M) ≃ M.val.obj (Opposite.op U₂)),
        (∀ (M N : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
            (ψ : M ⟶ N) (g : P₁ ⟶ M),
          ev₁ N (g ≫ ψ) = (ψ.val.app (Opposite.op U₁)).hom (ev₁ M g)) →
        (∀ (M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
            (g g' : P₁ ⟶ M), ev₁ M (g + g') = ev₁ M g + ev₁ M g') →
        (∀ (M N : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
            (ψ : M ⟶ N) (g : P₂ ⟶ M),
          ev₂ N (g ≫ ψ) = (ψ.val.app (Opposite.op U₂)).hom (ev₂ M g)) →
        (∀ (M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
            (g g' : P₂ ⟶ M), ev₂ M (g + g') = ev₂ M g + ev₂ M g') →
        ∀ hz : Limits.biprod.desc
            ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ U₁))
            ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ U₂)) ≫
            (Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dx)) = 0,
          (ShortComplex.mk _ _ hz).ShortExact → G) : G :=
by
  classical
  have ha : a ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
  have hb : b ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)

  have hU : ∀ (f : C) (K : Type u) [Field K] [Algebra C K] [IsLocalization.Away f K],
      ∃ eU : (wcNodeBranchU eC f).left ≅ Spec (.of K),
        eU.inv ≫ (wcNodeBranchU eC f).hom ≫ eC.hom =
          Spec.map (CommRingCat.ofHom (algebraMap C K)) := by
    have gen : ∀ {X : Scheme.{u}} (eX : X ≅ Spec (.of C)) (f : C) (K : Type u) [Field K]
        [Algebra C K] [IsLocalization.Away f K],
        ∃ eU : ((eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f : X.Opens) : Scheme.{u}) ≅ Spec (.of K),
          eU.inv ≫ (eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f).ι ≫ eX.hom =
            Spec.map (CommRingCat.ofHom (algebraMap C K)) := by
      intro X eX f K _ _ _
      haveI hK : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap C K))) :=
        IsOpenImmersion.of_isLocalization (S := K) f
      haveI hO : IsOpenImmersion ((eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f).ι ≫ eX.hom) :=
        inferInstance
      have hr1 : Set.range ((eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f).ι ≫ eX.hom) =
          (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum C)) := by
        ext q
        constructor
        · rintro ⟨z, rfl⟩
          exact z.2
        · intro hq
          refine ⟨⟨eX.inv q, ?_⟩, ?_⟩
          · show eX.hom (eX.inv q) ∈ PrimeSpectrum.basicOpen f
            rw [Scheme.inv_hom_apply]
            exact hq
          · show eX.hom (eX.inv q) = q
            rw [Scheme.inv_hom_apply]
      have hr2 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap C K))) =
          (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum C)) := by
        rw [← PrimeSpectrum.localization_away_comap_range K f]
        rfl
      exact ⟨IsOpenImmersion.isoOfRangeEq _ _ (hr1.trans hr2.symm),
        IsOpenImmersion.isoOfRangeEq_inv_fac _ _ _⟩
    intro f K _ _ _
    obtain ⟨eU, heU⟩ := gen eC f K
    refine ⟨eU, ?_⟩
    show _ ≫ ((eC.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f).ι ≫ 𝟙 _) ≫ eC.hom = _
    rw [Category.comp_id]
    exact heU
  obtain ⟨eU₁, hU₁⟩ := hU b K₁
  obtain ⟨eU₂, hU₂⟩ := hU a K₂

  obtain ⟨P₁, ev₁, hnat₁, hadd₁⟩ := sheafOfModules_free_yoneda
    (Scheme.ProEt.topology _) (wcRingSheaf (Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (wcNodeBranchU eC b)
  obtain ⟨P₂, ev₂, hnat₂, hadd₂⟩ := sheafOfModules_free_yoneda
    (Scheme.ProEt.topology _) (wcRingSheaf (Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (wcNodeBranchU eC a)

  have hkc := wc_pmn_nbs_p_kernel_char F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂ B Λ' W'' φ'
    a' hsh xs hxs Dx hDx Dw hDw h2 C eC

  have hnone : ∀ (f : C), f ∈ IsLocalRing.maximalIdeal C → ∀ z : (wcNodeBranchU eC f).left,
      eC.hom ((wcNodeBranchU eC f).hom z) ≠ IsLocalRing.closedPoint C := by
    intro f hf z hz
    have h1 : eC.hom z.1 ∈ PrimeSpectrum.basicOpen f := z.2
    have h3 : (wcNodeBranchU eC f).hom z = z.1 := by
      show (Scheme.Opens.ι _ ≫ 𝟙 _) z = z.1
      rw [Category.comp_id]
      rfl
    rw [h3] at hz
    rw [hz] at h1
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h1 hf

  have hgen : ∀ (f : C), f ∈ IsLocalRing.maximalIdeal C →
      ∀ (P : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
        (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ),
          (P ⟶ M) ≃ M.val.obj (Opposite.op (wcNodeBranchU eC f))),
        (∀ (M N : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
            (ψ : M ⟶ N) (g : P ⟶ M),
          ev N (g ≫ ψ) = (ψ.val.app (Opposite.op (wcNodeBranchU eC f))).hom (ev M g)) →
        (∀ (M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
            (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
            (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
        (ev (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC f)) ≫
          (Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dx)) = 0 := by
    intro f hf P ev hnat hadd
    apply (ev _).injective
    have h0 : ev (Dw.Φ.obj (wcSuppObj Dx)) 0 = 0 := by
      have h := hadd (Dw.Φ.obj (wcSuppObj Dx)) 0 0
      rw [add_zero] at h
      exact (add_eq_left.mp h.symm)
    rw [h0, hnat, Equiv.apply_symm_apply]
    exact (hkc _ _).2 (fun z hz => absurd hz (hnone f hf z))
  have hz : Limits.biprod.desc
      ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC b)))
      ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ (wcNodeBranchU eC a))) ≫
      (Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dx)) = 0 := by
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc_assoc, Limits.comp_zero]
      exact hgen b hb P₁ ev₁ hnat₁ hadd₁
    · rw [Limits.biprod.inr_desc_assoc, Limits.comp_zero]
      exact hgen a ha P₂ ev₂ hnat₂ hadd₂

  have hO : (eC.hom ⁻¹ᵁ PrimeSpectrum.basicOpen b) ⊓ (eC.hom ⁻¹ᵁ PrimeSpectrum.basicOpen a) = ⊥ := by
    apply le_antisymm _ bot_le
    intro z hz
    exfalso
    have h1 : b ∉ (eC.hom z).asIdeal := hz.1
    have h2 : a ∉ (eC.hom z).asIdeal := hz.2
    have hmem : a * b ∈ (eC.hom z).asIdeal := hab ▸ Ideal.zero_mem _
    rcases (eC.hom z).isPrime.mem_or_mem hmem with h | h
    · exact h2 h
    · exact h1 h

  have hex := wc_proet_node_branch_kernel_lift ℓ C eC a b hab hspan P₁ P₂ ev₁ ev₂ hnat₁ hadd₁
    hnat₂ hadd₂ _ (Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dx)) hkc hz
  have hmono := wc_proet_disjoint_opens_desc_mono ℓ _ _ hO P₁ P₂ ev₁ ev₂ hnat₁ hadd₁ hnat₂ hadd₂
  have hepi := wc_pmn_nbs_p_epi F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂ B Λ' W'' φ'
    a' hsh xs hxs Dx hDx Dw hDw h2
  exact k _ _ eU₁ eU₂ hU₁ hU₂ P₁ P₂ ev₁ ev₂ hnat₁ hadd₁ hnat₂ hadd₂ hz
    (ShortComplex.ShortExact.mk' hex hmono hepi)

theorem wc_pmn_nbr_psi_h1_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
