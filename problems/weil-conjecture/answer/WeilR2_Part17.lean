      iY ≫ ι = k' ≫ Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a).hom f, (Spec.preimage a).hom g}))) →
      ∀ z : Spec (.of B), z ∈ Set.range (iY ≫ ι) →
