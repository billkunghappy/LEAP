            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} := by
    rw [Set.setOf_exists]
    exact isOpen_iUnion fun p => (PrimeSpectrum.basicOpen (Ideal.Quotient.mk
      (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p))).isOpen
  have hO : IsOpen {w : ↥(Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) |
        Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w ≠ xs} :=
    hxsC.isOpen_compl.preimage (Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))).continuous
  refine ⟨⟨_, hOc⟩, ⟨_, hO⟩, c ≫ σ ≫ ψ, rfl, rfl, inferInstance, ?_, hK, hℓK⟩
  apply TopologicalSpace.Opens.ext
  ext w
  show (∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
