    let eΨ := @RingEquiv.toCommRingCatIso (MvPolynomial (Fin r) Q2) Qr _ _ ΨE
    have hgd : Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr)) =
        Spec.map eΨ.hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap Q2 (MvPolynomial (Fin r) Q2))) := by
      rw [← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro q
      show (ι : Q2 →+* Qr) q = Ψ (algebraMap Q2 (MvPolynomial (Fin r) Q2) q)
      exact RingHom.congr_fun hιeq q
    refine ⟨Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr)), ?_, ?_, ?_⟩
    · show Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A Q2)) = Spec.map (CommRingCat.ofHom (algebraMap A Qr))
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
    · intro y hx0 hx1 p
      rw [Spec.map_apply]
      change Ideal.Quotient.mk I2 (MvPolynomial.X p) ∈
        Ideal.comap (CommRingCat.Hom.hom (CommRingCat.ofHom (ι : Q2 →+* Qr))) (PrimeSpectrum.asIdeal y)
      rw [Ideal.mem_comap, CommRingCat.hom_ofHom]
      erw [hιX]
      fin_cases p
      · exact hx0
      · exact hx1
    · intro B₀ _ b
      letI : Algebra Q2 B₀ := (Spec.preimage b).hom.toAlgebra
      have hPB := (isPullback_SpecMap_of_isPushout _ _ _ _ (hPOgen Q2 B₀ r)).flip
      have hb : Spec.map (CommRingCat.ofHom (algebraMap Q2 B₀)) = b := by
        show Spec.map (CommRingCat.ofHom (Spec.preimage b).hom) = b
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      rw [hb] at hPB
      refine ⟨Spec.map (CommRingCat.ofHom (MvPolynomial.map (algebraMap Q2 B₀))) ≫
        (Scheme.Spec.mapIso eΨ.op).inv, ?_⟩
      refine hPB.of_iso (Iso.refl _) (Scheme.Spec.mapIso eΨ.op).symm (Iso.refl _)
        (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · show Spec.map (CommRingCat.ofHom (algebraMap Q2 (MvPolynomial (Fin r) Q2))) ≫ 𝟙 _ =
          Spec.map eΨ.inv ≫ Spec.map (CommRingCat.ofHom (ι : Q2 →+* Qr))
        rw [hgd, ← Category.assoc, ← Spec.map_comp, eΨ.hom_inv_id, Spec.map_id, Category.id_comp,
          Category.comp_id]
      · simp

  have L4atest : ∀ {Y Y' : Scheme.{u}} (f : Y' ⟶ Y) (y' : Y') (B₀ : Type u) [CommRing B₀] [IsLocalRing B₀] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y (f y'))) (Scheme.Etale.forget Y)) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Y), wcHalShData (f y') B₀ Λ₀ W₀ φ₀ a₀ → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y' y')) (Scheme.Etale.forget Y')) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y'), wcHalShData y' B Λ W' φ a → ∃ β : Spec (.of B) ⟶ Spec (.of B₀), β ≫ a₀ = a ≫ f ∧ β (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint B₀ := by
    intro Y Y' f y' B₀ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh₀ B _ _ Λ _ _ W' φ a hsh
    let K := Y.residueField (f y')
    let K' := Y'.residueField y'
    let ρ : K →+* K' := (f.residueFieldMap y').hom
    letI alg : Algebra K (AlgebraicClosure K') :=
      ((algebraMap K' (AlgebraicClosure K')).comp ρ).toAlgebra
    let j : AlgebraicClosure K →ₐ[K] AlgebraicClosure K' :=
      IsAlgClosed.lift (M := AlgebraicClosure K') (R := K) (S := AlgebraicClosure K)
    let ι : Spec (.of (AlgebraicClosure K')) ⟶ Spec (.of (AlgebraicClosure K)) :=
      Spec.map (CommRingCat.ofHom (j : AlgebraicClosure K →+* AlgebraicClosure K'))
    have hι : ι ≫ wcEtGeomPt Y (f y') = wcEtGeomPt Y' y' ≫ f := by
      have e1 : (j : AlgebraicClosure K →+* AlgebraicClosure K').comp (algebraMap K (AlgebraicClosure K)) =
          (algebraMap K' (AlgebraicClosure K')).comp ρ := j.comp_algebraMap
      show ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ Y.fromSpecResidueField (f y') =
        (Spec.map (CommRingCat.ofHom (algebraMap K' (AlgebraicClosure K'))) ≫ Y'.fromSpecResidueField y') ≫ f
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, e1, Category.assoc,
        ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
        ← Spec.map_comp]
      rfl
    have hsh₀' := hsh₀
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh₀'
    obtain ⟨e', he'⟩ := wc_shdata_normalized_residue y' B Λ W' φ a hsh
    obtain ⟨β, hβ₁, hβ₂⟩ := wc_shdata_comparison_map f (f y') y' ι hι B₀ Λ₀ W₀ φ₀ a₀ hsh₀ e he
      B Λ W' φ a hsh e' he'
    refine ⟨β, hβ₁, ?_⟩
    have h := congrArg (fun g => g (IsLocalRing.closedPoint (AlgebraicClosure K'))) hβ₂
    have hL := (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
      (congrArg β (hresG B (Spec.map (CommRingCat.ofHom e') (IsLocalRing.closedPoint (AlgebraicClosure K'))))))
    have hR := (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
      (hresG B₀ (Spec.map (CommRingCat.ofHom e) (ι (IsLocalRing.closedPoint (AlgebraicClosure K'))))))
    exact hL.symm.trans (h.trans hR)

  have C4 : ∀ (y₁ y₂ : Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      (∀ p : Fin 2, Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y₁) →
      (∀ p : Fin 2, Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y₂) →
      y₁ = y₂ := by
    have K1 : (∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C ((Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin 2) A) = MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin 2)]
      · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin 2)]
        · simp
        · intro q _ hq
          have : q.val ≠ 1 := fun h => hq (Fin.ext h)
          simp [this]
        · intro h; exact absurd (Finset.mem_univ _) h
      · intro p _ hp
        have : p.val ≠ 0 := fun h => hp (Fin.ext h)
        have hp0 : p ≠ 0 := fun h => this (by rw [h]; rfl)
        apply Finset.sum_eq_zero
        intro q _
        simp [this, hp0]
      · intro h; exact absurd (Finset.mem_univ _) h
    have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨0, by omega⟩) *
        Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨1, by omega⟩) =
        algebraMap A (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
      have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ - MvPolynomial.C π :
          MvPolynomial (Fin 2) A) ∈ wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
        rw [← K1]
        exact Ideal.subset_span (Set.mem_singleton _)
      have := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_mul, sub_eq_zero] at this
      rw [this, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    have hD : ∀ F : MvPolynomial (Fin 2) A, F - MvPolynomial.C (MvPolynomial.constantCoeff F) ∈
        Ideal.span {(MvPolynomial.X ⟨0, by omega⟩ : MvPolynomial (Fin 2) A), MvPolynomial.X ⟨1, by omega⟩} := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.constantCoeff_C, sub_self]; exact Ideal.zero_mem _
      | add f g hf hg =>
        have e : f + g - MvPolynomial.C (MvPolynomial.constantCoeff (f + g)) =
            (f - MvPolynomial.C (MvPolynomial.constantCoeff f)) +
              (g - MvPolynomial.C (MvPolynomial.constantCoeff g)) := by
          rw [map_add, map_add]; ring
        rw [e]; exact Ideal.add_mem _ hf hg
      | mul_X f n _ =>
        have e : MvPolynomial.constantCoeff (f * MvPolynomial.X n) = 0 := by
          rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero]
        rw [e, map_zero, sub_zero]
        apply Ideal.mul_mem_left
        fin_cases n
        · exact Ideal.subset_span (Set.mem_insert _ _)
        · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hM : ∀ (𝔮 : Ideal (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))), 𝔮.IsPrime →
        (∀ p : Fin 2, Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈ 𝔮) →
        ∀ F : MvPolynomial (Fin 2) A, (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) F ∈ 𝔮 ↔
          MvPolynomial.constantCoeff F ∈ IsLocalRing.maximalIdeal A) := by
      intro 𝔮 h𝔮 hX F
      obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp (hD F)
      have hab' := congrArg (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) hab
      rw [map_add, map_mul, map_mul, map_sub, ← MvPolynomial.algebraMap_eq,
        Ideal.Quotient.mk_algebraMap] at hab'
      have hF : Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) F =
          algebraMap A (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.constantCoeff F) +
          (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) a *
            Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
              if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨0, by omega⟩) +
          Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) b *
            Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
              if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨1, by omega⟩)) := by
        rw [hab']; ring
      have hrest : Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) a *
            Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
              if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨0, by omega⟩) +
          Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
            if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) b *
            Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 =>
              if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X ⟨1, by omega⟩) ∈ 𝔮 :=
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hX _)) (Ideal.mul_mem_left _ _ (hX _))
      rw [hF]
      constructor
      · intro hmem
        by_contra hnot
        have hu : IsUnit (MvPolynomial.constantCoeff F) := IsLocalRing.notMem_maximalIdeal.mp hnot
        have hin := Ideal.sub_mem _ hmem hrest
        rw [add_sub_cancel_right] at hin
        exact h𝔮.ne_top (Ideal.eq_top_of_isUnit_mem _ hin (hu.map _))
      · intro hc
        rw [hπ] at hc
        obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hc
        refine Ideal.add_mem _ ?_ hrest
        rw [← ht, map_mul, ← hrel]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (hX _))
    intro y₁ y₂ h₁ h₂
    apply PrimeSpectrum.ext
    ext x
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [hM _ y₁.isPrime h₁ F, hM _ y₂.isPrime h₂ F]

  obtain ⟨B'', _, _, _, Λ'', _, _, W'', φ'', a'', e'', hI'', haff'', hcomp'', hφa'', hlim'', hint'', heq''⟩ :=
    wc_et_geom_strict_henselization (a₀ (IsLocalRing.closedPoint B))
  have hsh'' : wcHalShData (a₀ (IsLocalRing.closedPoint B)) B'' Λ'' W'' φ'' a'' :=
    ⟨hI'', haff'', hcomp'', hφa'', hlim'', e'', hint'', heq''⟩
