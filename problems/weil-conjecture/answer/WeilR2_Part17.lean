        ((CochainComplex.singleFunctor 𝒞 0).map v)))
      (Φ.mapDerivedCategory.map (DerivedCategory.Q.map
        ((CochainComplex.singleFunctor 𝒞 0).map c))) hsq
    have hφ' : δ ≫ φ⟦(1 : ℤ)⟧' = Φ.mapDerivedCategory.map (DerivedCategory.Q.map
