      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨k⟩
      exact (Fin.forall_fin_two.mpr ⟨hS0, hS1⟩ : ∀ k : Fin 2, Sv.arrows (pcs k).2) k
    have sep : ∀ (W : X.ProEt) (R : Sieve W), R ∈ Scheme.ProEt.topology X W →
        ∀ x : ↑(N.val.obj (Opposite.op W)),
        (∀ (Q' : X.ProEt) (k : Q' ⟶ W), R.arrows k → (N.val.map k.op).hom x = 0) → x = 0 := by
      intro W R hR x h
      have hs := ((SheafOfModules.toSheaf _).obj N).cond
      have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology X) _
        (forget AddCommGrpCat.{u+1})).1 hs
      exact (h2.isSeparated W R hR) x 0
        (fun Q' k hk => (h Q' k hk).trans (map_zero ((N.val.map k.op).hom)).symm)
    obtain ⟨ta, hta⟩ : ∃ ta : ↑(N.val.obj (Opposite.op Q)), ta = (N.val.map a.op).hom t :=
      ⟨_, rfl⟩
    obtain ⟨tb, htb⟩ : ∃ tb : ↑(N.val.obj (Opposite.op Q)), tb = (N.val.map b.op).hom t :=
      ⟨_, rfl⟩
