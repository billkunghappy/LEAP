    intro C _ _ P One S S' f₀ g h hex _ _ σ g' u hu
    have hf : (f₀ ≫ u.hom) ≫ g' = 0 := by
      rw [Category.assoc, ← hu, ← Category.assoc, h, Limits.zero_comp]
    refine ⟨hf, ShortComplex.shortExact_of_iso (S₁ := ShortComplex.mk f₀ g h)
      (ShortComplex.isoMk (Iso.refl _) u σ (by simp) hu.symm)
