      _ = ∑ p, ∑ q, (MvPolynomial.C (MAT p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin (2 * e + 1 + 1)) K) := Finset.sum_comm
  obtain ⟨σ, hσ⟩ : ∃ σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT ≃+*
        wcQuadModelRing K (2 * e + 1 + 1) 0 MAT, ∀ k : Fin (e + 1),
      σ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) =
      Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) := by
    obtain ⟨σ0, hσ0⟩ : ∃ σ0 : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT ≃ₐ[K]
          wcQuadModelRing K (2 * e + 1 + 1) 0 MAT, ∀ x : MvPolynomial (Fin (2 * e + 1 + 1)) K,
        σ0 (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) x) =
          Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
            (MvPolynomial.renameEquiv K T x) := by
      refine ⟨Ideal.quotientEquivAlg (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) (MvPolynomial.renameEquiv K T) ?_,
        fun x => Ideal.quotientEquivAlg_mk _ _ _ x⟩
      dsimp only [wcQuadModelIdeal]
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun t => Ideal.span {t}) hAf.symm
    refine ⟨σ0.toRingEquiv, fun k => ?_⟩
    have hTk : T (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)) =
        (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)) := by
      rw [hT]
      apply Fin.ext
      rw [hτ]
      show (if (2 * k.val) % 2 = 0 then 2 * k.val + 1 else 2 * k.val - 1) = 2 * k.val + 1
      split_ifs <;> omega
    refine (hσ0 _).trans ?_
    rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, hTk]

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) ⟶
      Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)),
      Φ = Spec.map (CommRingCat.ofHom (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) := ⟨_, rfl⟩
  haveI : IsIso Φ := by
    rw [hΦ, ← RingEquiv.toCommRingCatIso_hom]
    infer_instance
  have hΦpt : ∀ y, (Φ y).asIdeal = Ideal.comap (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
      wcQuadModelRing K (2 * e + 1 + 1) 0 MAT) y.asIdeal := by
    intro y
    rw [hΦ]
