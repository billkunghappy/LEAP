    have hF : Nat.card (wcEtCoh (Limits.pullback g ap) m 0) = m := H p C Λ W' φ ap hd

    have hTc : Nat.card ((wcEtStalk P p).obj ((wcEtPush g).obj
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
