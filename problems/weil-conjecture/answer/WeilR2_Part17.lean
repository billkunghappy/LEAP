    (tU : PU ⟶ Dw.Φ.obj (Di.Φ.obj X'))
    (htU : ev _ tU = ((Dw.Φ.obj (Di.Φ.obj X')).val.map d'.op).hom θ') :
    ∃ s : SheafOfModules.unit (wcRingSheaf (Limits.pullback a' iS) ℓ) ⟶ Dw.Φ.obj (Di.Φ.obj X),
      (ev (SheafOfModules.unit _)).symm (wcModUnitOne _ U) ≫ s = tU ≫ Dw.Φ.map (Di.Φ.map ι) :=
by

  have hext : ∀ {V : S.ProEt} {T : (Limits.pullback a' iS).ProEt}
      (k l : T ⟶ (wcProEtBC (Limits.pullback.snd a' iS)).obj ((wcProEtBC iS).obj V)),
      k.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS) (Limits.pullback.snd a' iS) ≫
          Limits.pullback.fst V.hom iS =
        l.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS) (Limits.pullback.snd a' iS) ≫
          Limits.pullback.fst V.hom iS → k = l := by
    intro V T k l h
    apply MorphismProperty.Over.Hom.ext
    have hk : k.left ≫ Limits.pullback.snd (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS) = T.hom := MorphismProperty.Over.w k
    have hl : l.left ≫ Limits.pullback.snd (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS) = T.hom := MorphismProperty.Over.w l
    have ck : (k.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS)) ≫ Limits.pullback.snd V.hom iS =
        T.hom ≫ Limits.pullback.snd a' iS :=
      (Category.assoc _ _ _).trans ((whisker_eq k.left Limits.pullback.condition).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker hk _)))
    have cl : (l.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS)) ≫ Limits.pullback.snd V.hom iS =
        T.hom ≫ Limits.pullback.snd a' iS :=
      (Category.assoc _ _ _).trans ((whisker_eq l.left Limits.pullback.condition).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker hl _)))
    refine Limits.pullback.hom_ext (f := Limits.pullback.snd V.hom iS)
      (g := Limits.pullback.snd a' iS) ?_ ?_
    · refine Limits.pullback.hom_ext (f := V.hom) (g := iS) ?_ ?_
      · exact (Category.assoc _ _ _).trans (h.trans (Category.assoc _ _ _).symm)
      · exact ck.trans cl.symm
    · exact hk.trans hl.symm

  have cV : ∀ V : (Limits.pullback a' iS).ProEt,
      (V.hom ≫ Limits.pullback.fst a' iS ≫ σV.inv) ≫ Vt.hom =
        (V.hom ≫ Limits.pullback.snd a' iS) ≫ iS := by
    intro V
    simp only [Category.assoc]
    rw [hσV, Limits.pullback.condition]
  obtain ⟨δ, hδ⟩ : ∃ δ : ∀ V : (Limits.pullback a' iS).ProEt,
      V ⟶ (wcProEtBC (Limits.pullback.snd a' iS)).obj ((wcProEtBC iS).obj Vt),
      ∀ V, (δ V).left ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom iS)
          (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst Vt.hom iS =
        V.hom ≫ Limits.pullback.fst a' iS ≫ σV.inv := by
    refine ⟨fun V => MorphismProperty.Over.homMk
      (Limits.pullback.lift (f := Limits.pullback.snd Vt.hom iS) (g := Limits.pullback.snd a' iS)
        (Limits.pullback.lift (f := Vt.hom) (g := iS)
          (V.hom ≫ Limits.pullback.fst a' iS ≫ σV.inv)
          (V.hom ≫ Limits.pullback.snd a' iS) (cV V)) V.hom (Limits.pullback.lift_snd _ _ _))
      (Limits.pullback.lift_snd _ _ _) trivial, fun V => ?_⟩
    show Limits.pullback.lift (f := Limits.pullback.snd Vt.hom iS)
        (g := Limits.pullback.snd a' iS) _ _ _ ≫ _ ≫ _ = _
    rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_fst]

  have hcomp : ∀ {V₁ V₂ : (Limits.pullback a' iS).ProEt} (f : V₁ ⟶ V₂), f ≫ δ V₂ = δ V₁ := by
    intro V₁ V₂ f
    apply hext
    have e : (f ≫ δ V₂).left = f.left ≫ (δ V₂).left := MorphismProperty.Comma.comp_left _ _
    rw [e, Category.assoc, hδ, hδ, ← Category.assoc, MorphismProperty.Over.w f]

  have hd : d' ≫ (wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD) = δ U := by
    apply hext
    have e : (d' ≫ (wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).left =
        d'.left ≫ ((wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).left :=
      MorphismProperty.Comma.comp_left _ _
    have f1 : ((wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).left ≫
        Limits.pullback.fst (Limits.pullback.snd Vt.hom iS) (Limits.pullback.snd a' iS) =
        Limits.pullback.fst (Limits.pullback.snd (wcVRes S Vt O).hom iS)
          (Limits.pullback.snd a' iS) ≫ ((wcProEtBC iS).map ιD).left :=
      Limits.pullback.lift_fst _ _ _
    have f2 : ((wcProEtBC iS).map ιD).left ≫ Limits.pullback.fst Vt.hom iS =
        Limits.pullback.fst (wcVRes S Vt O).hom iS ≫ ιD.left :=
      Limits.pullback.lift_fst _ _ _
    have f1' : ((wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).left ≫
        Limits.pullback.fst (Limits.pullback.snd Vt.hom iS) (Limits.pullback.snd a' iS) ≫
          Limits.pullback.fst Vt.hom iS =
        Limits.pullback.fst (Limits.pullback.snd (wcVRes S Vt O).hom iS)
          (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcVRes S Vt O).hom iS ≫ ιD.left :=
      (Category.assoc _ _ _).symm.trans ((eq_whisker f1 _).trans
        ((Category.assoc _ _ _).trans (whisker_eq _ f2)))
    have hd'' : d'.left ≫ Limits.pullback.fst (Limits.pullback.snd (wcVRes S Vt O).hom iS)
          (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcVRes S Vt O).hom iS ≫ ιD.left =
        uD ≫ O.ι :=
      ((whisker_eq d'.left (Category.assoc _ _ _).symm).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker hd' _))).trans
        (congrArg (fun t => uD ≫ t) hιD)
    have hU' : uD ≫ O.ι = U.hom ≫ Limits.pullback.fst a' iS ≫ σV.inv := by
      rw [← Category.assoc, ← huD]
      simp
    rw [hδ, e]
    exact (Category.assoc _ _ _).trans ((whisker_eq d'.left f1').trans (hd''.trans hU'))

  obtain ⟨θ, hθ⟩ : ∃ θ : (Dw.Φ.obj (Di.Φ.obj X)).val.obj (Opposite.op
      ((wcProEtBC (Limits.pullback.snd a' iS)).obj ((wcProEtBC iS).obj Vt))),
      (((Di.adj.comp Dw.adj).unit.app X).val.app (Opposite.op Vt)).hom (evX X (𝟙 X)) = θ :=
    ⟨_, rfl⟩
  have htr : ((Dw.Φ.map (Di.Φ.map ι)).val.app (Opposite.op
        ((wcProEtBC (Limits.pullback.snd a' iS)).obj ((wcProEtBC iS).obj (wcVRes S Vt O))))).hom θ' =
      ((Dw.Φ.obj (Di.Φ.obj X)).val.map
        ((wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).op).hom θ := by
    have a1 := (Di.adj.comp Dw.adj).unit_naturality ι
    have a2 := congrArg (fun φ => (φ.val.app (Opposite.op (wcVRes S Vt O))).hom (evX' X' (𝟙 X'))) a1
    simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply] at a2
    have a3 : (ι.val.app (Opposite.op (wcVRes S Vt O))).hom (evX' X' (𝟙 X')) =
        (X.val.map ιD.op).hom (evX X (𝟙 X)) := by
      rw [← hnatX', ← hι, Category.id_comp, Category.comp_id]
    rw [hθ', a3] at a2
    have a4 := PresheafOfModules.naturality_apply ((Di.adj.comp Dw.adj).unit.app X).val ιD.op
      (evX X (𝟙 X))
    exact a2.trans (a4.trans (congrArg (fun y => ((Dw.Φ.obj (Di.Φ.obj X)).val.map
      ((wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).op).hom y) hθ))

  let σ : (Y : ((Limits.pullback a' iS).ProEt)ᵒᵖ) → (Dw.Φ.obj (Di.Φ.obj X)).val.obj Y :=
    fun Y => ((Dw.Φ.obj (Di.Φ.obj X)).val.map (δ Y.unop).op).hom θ
  have hσ : ∀ ⦃Y₁ Y₂ : ((Limits.pullback a' iS).ProEt)ᵒᵖ⦄ (f : Y₁ ⟶ Y₂),
      ((Dw.Φ.obj (Di.Φ.obj X)).val.map f).hom (σ Y₁) = σ Y₂ := by
    intro Y₁ Y₂ f
    have hf : (δ Y₁.unop).op ≫ f = (δ Y₂.unop).op := by
      rw [← hcomp f.unop, op_comp, Quiver.Hom.op_unop]
    have e1 := PresheafOfModules.map_comp_apply (Dw.Φ.obj (Di.Φ.obj X)).val (δ Y₁.unop).op f θ
    rw [hf] at e1
    exact e1.symm
  obtain ⟨s, hs⟩ : ∃ s : SheafOfModules.unit (wcRingSheaf (Limits.pullback a' iS) ℓ) ⟶
      Dw.Φ.obj (Di.Φ.obj X),
      (Dw.Φ.obj (Di.Φ.obj X)).unitHomEquiv s = PresheafOfModules.sectionsMk σ hσ :=
    ⟨_, Equiv.apply_symm_apply _ _⟩
  have hsU := (SheafOfModules.unitHomEquiv_apply_coe _ s (Opposite.op U)).symm.trans
    ((congrArg (fun t => t.1 (Opposite.op U)) hs).trans
      (PresheafOfModules.sectionsMk_coe σ hσ (Opposite.op U)))

  have e2 := PresheafOfModules.map_comp_apply (Dw.Φ.obj (Di.Φ.obj X)).val
    ((wcProEtBC (Limits.pullback.snd a' iS)).map ((wcProEtBC iS).map ιD)).op d'.op θ
  rw [← op_comp, hd] at e2
  have n1 := PresheafOfModules.naturality_apply (Dw.Φ.map (Di.Φ.map ι)).val d'.op θ'
  refine ⟨s, (ev (Dw.Φ.obj (Di.Φ.obj X))).injective ?_⟩
  rw [hnat, hnat, Equiv.apply_symm_apply, htU]
  refine hsU.trans (e2.trans ?_)
  exact (n1.trans (congrArg (fun y => ((Dw.Φ.obj (Di.Φ.obj X)).val.map d'.op).hom y) htr)).symm

theorem wc_pmn_nbr_branch_ext_nonzero {S Z : Scheme.{u}} (iS : Z ⟶ S) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Di : wcHMPullData iS ℓ) (hDi : wcHMPullCanonical Di)
    (B : Type u) [CommRing B] (a' : Spec (.of B) ⟶ S)
    (Dw : wcHMPullData (Limits.pullback.snd a' iS) ℓ) (hDw : wcHMPullCanonical Dw)
    (U : (Limits.pullback a' iS).ProEt)
    (PU : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a' iS) ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a' iS) ℓ),
      (PU ⟶ M) ≃ M.val.obj (Opposite.op U))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a' iS) ℓ))
      (ψ : M ⟶ N) (g : PU ⟶ M), ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a' iS) ℓ))
      (g g' : PU ⟶ M), ev M (g + g') = ev M g + ev M g')
    (Vt : S.ProEt) (σV : Vt.left ≅ Spec (.of B)) (hσV : σV.inv ≫ Vt.hom = a')
    (O : Vt.left.Opens)
    (X X' : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (evX : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (X ⟶ M) ≃ M.val.obj (Opposite.op Vt))
    (hnatX : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (k : X ⟶ M),
      evX N (k ≫ ψ) = (ψ.val.app (Opposite.op Vt)).hom (evX M k))
    (haddX : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (k k' : X ⟶ M),
      evX M (k + k') = evX M k + evX M k')
    (evX' : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (X' ⟶ M) ≃ M.val.obj (Opposite.op (wcVRes S Vt O)))
    (hnatX' : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (k : X' ⟶ M),
      evX' N (k ≫ ψ) = (ψ.val.app (Opposite.op (wcVRes S Vt O))).hom (evX' M k))
    (haddX' : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (k k' : X' ⟶ M),
      evX' M (k + k') = evX' M k + evX' M k')
    (ι : X' ⟶ X)
    (ιD : wcVRes S Vt O ⟶ Vt) (hιD : ιD.left = O.ι)
    (hι : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (k : X ⟶ M),
      evX' M (ι ≫ k) = (M.val.map ιD.op).hom (evX M k))
    (uD : U.left ⟶ O.toScheme)
    (huD : uD ≫ O.ι ≫ σV.hom = U.hom ≫ Limits.pullback.fst a' iS)
    (q : ℕ) (z : wcHM O.toScheme ℓ q)
    (hz : ∀ DU : wcHMPullData uD ℓ, wcHMPullCanonical DU → wcHMPull DU q z ≠ 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a' iS) ℓ)) :=
      HasExt.standard _
    haveI := Di.additive
    haveI := Di.presLim
    haveI := Di.presColim
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    ∃ (y : Abelian.Ext X' (SheafOfModules.unit (wcRingSheaf S ℓ)) q)
      (s : SheafOfModules.unit (wcRingSheaf (Limits.pullback a' iS) ℓ) ⟶ Dw.Φ.obj (Di.Φ.obj X))
      (tU : PU ⟶ Dw.Φ.obj (Di.Φ.obj X')),
      (ev (SheafOfModules.unit _)).symm (wcModUnitOne _ U) ≫ s = tU ≫ Dw.Φ.map (Di.Φ.map ι) ∧
      (Abelian.Ext.mk₀ tU).comp ((Abelian.Ext.mapExactFunctor Dw.Φ
          (Abelian.Ext.mapExactFunctor Di.Φ y)).comp (Abelian.Ext.mk₀ (Dw.Φ.map Di.μ.hom ≫ Dw.μ.hom))
          (add_zero q)) (zero_add q) ≠ 0 :=
by
  letI hE : ∀ T : Scheme.{u}, HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) :=
    fun T => HasExt.standard _
  classical
  have hcont : ∀ (T : Scheme.{u}) (V : T.ProEt),
      (wcSliceFunctor T V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology T) := by
    intro T V
    haveI : (wcSliceToOver T V).IsContinuous (Scheme.ProEt.topology V.left)
        ((Scheme.ProEt.topology T).over V) := (wc_slice_over_sites_cont T V).1
    exact Functor.isContinuous_comp (wcSliceToOver T V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology T).over V) (Scheme.ProEt.topology T)
  haveI := hcont
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), (wcSliceRes T ℓ V).Additive :=
    fun T V => (wc_slice_res_exact T ℓ V).1
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), Limits.PreservesFiniteLimits (wcSliceRes T ℓ V) :=
    fun T V => (wc_slice_res_exact T ℓ V).2.1
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), Limits.PreservesFiniteColimits (wcSliceRes T ℓ V) :=
    fun T V => (wc_slice_res_exact T ℓ V).2.2
  haveI : ∀ (T : Scheme.{u}) (V : T.ProEt), IsIso (wcSliceUnit T ℓ V) :=
    fun T V => wc_slice_unit_isIso T ℓ V
  haveI := Di.additive
  haveI := Di.presLim
  haveI := Di.presColim
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  have h3 : ∀ (T : Scheme.{u}) {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf T ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro T A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]

  have hK : uD ≫ (wcVRes S Vt O).hom = U.hom ≫ Limits.pullback.snd a' iS ≫ iS := by
    have h1 : Vt.hom = σV.hom ≫ a' := by rw [← hσV, Iso.hom_inv_id_assoc]
    show uD ≫ O.ι ≫ Vt.hom = _
    calc uD ≫ O.ι ≫ Vt.hom = (uD ≫ O.ι ≫ σV.hom) ≫ a' := by
          rw [h1]; simp only [Category.assoc]
      _ = (U.hom ≫ Limits.pullback.fst a' iS) ≫ a' := by rw [huD]
      _ = U.hom ≫ Limits.pullback.snd a' iS ≫ iS := by
          rw [Category.assoc, Limits.pullback.condition]
  have hc1 : uD ≫ (wcVRes S Vt O).hom = (U.hom ≫ Limits.pullback.snd a' iS) ≫ iS := by
    rw [hK, Category.assoc]

  obtain ⟨d'0, hd'01, hd'02⟩ : ∃ d'0 : U.left ⟶ Limits.pullback
      (Limits.pullback.snd (wcVRes S Vt O).hom iS) (Limits.pullback.snd a' iS),
      d'0 ≫ Limits.pullback.fst (Limits.pullback.snd (wcVRes S Vt O).hom iS)
        (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcVRes S Vt O).hom iS = uD ∧
      d'0 ≫ Limits.pullback.snd (Limits.pullback.snd (wcVRes S Vt O).hom iS)
        (Limits.pullback.snd a' iS) = U.hom := by
    refine ⟨Limits.pullback.lift (Limits.pullback.lift uD (U.hom ≫ Limits.pullback.snd a' iS) hc1)
      U.hom (Limits.pullback.lift_snd _ _ _), ?_, Limits.pullback.lift_snd _ _ _⟩
    rw [← Category.assoc, Limits.pullback.lift_fst]
    exact Limits.pullback.lift_fst _ _ _
  let d' : U ⟶ (wcProEtBC (Limits.pullback.snd a' iS)).obj ((wcProEtBC iS).obj (wcVRes S Vt O)) :=
    MorphismProperty.Over.homMk d'0 hd'02 trivial
  have hd' : d'.left ≫ Limits.pullback.fst (Limits.pullback.snd (wcVRes S Vt O).hom iS)
      (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcVRes S Vt O).hom iS = uD := hd'01

  obtain ⟨θ', hθ'⟩ : ∃ θ' : (Dw.Φ.obj (Di.Φ.obj X')).val.obj (Opposite.op
      ((wcProEtBC (Limits.pullback.snd a' iS)).obj ((wcProEtBC iS).obj (wcVRes S Vt O)))),
      (((Di.adj.comp Dw.adj).unit.app X').val.app (Opposite.op (wcVRes S Vt O))).hom
        (evX' X' (𝟙 X')) = θ' := ⟨_, rfl⟩
  obtain ⟨tU, htU⟩ : ∃ tU : PU ⟶ Dw.Φ.obj (Di.Φ.obj X'),
      ev _ tU = ((Dw.Φ.obj (Di.Φ.obj X')).val.map d'.op).hom θ' :=
    ⟨(ev _).symm (((Dw.Φ.obj (Di.Φ.obj X')).val.map d'.op).hom θ'), Equiv.apply_symm_apply _ _⟩

  obtain ⟨s, hf⟩ := wc_pmn_nbr_section_factor iS ℓ Di B a' Dw U PU ev hnat Vt σV hσV O X X'
    evX hnatX evX' hnatX' ι ιD hιD hι uD huD d' hd' θ' hθ' tU htU
  obtain ⟨DU, hDU⟩ := wc_hm_pull_data_exists (S := (wcVRes S Vt O).left) uD ℓ
  haveI := DU.additive
  haveI := DU.presLim
  haveI := DU.presColim
  haveI := wc_hm_pull_unit_transpose_isIso uD ℓ DU hDU
  obtain ⟨β, hβ⟩ := wc_pmn_nbr_push_slice_nat iS (Limits.pullback.snd a' iS) ℓ Di hDi Dw hDw
    (wcVRes S Vt O) U uD hK DU hDU
  obtain ⟨εO, hεObij, hεO⟩ := wc_slice_res_free_corep_val S ℓ (wcVRes S Vt O) X' evX' hnatX'
  obtain ⟨εU, -, hεU⟩ := wc_slice_res_free_corep_val _ ℓ U PU ev hnat
  obtain ⟨H1, H2⟩ := wc_pmn_nbr_bc_unit_compat iS (Limits.pullback.snd a' iS) ℓ Di hDi Dw hDw
    (wcVRes S Vt O) U uD hK DU hDU X' evX' hnatX' PU ev hnat β hβ εO hεO εU hεU d' hd' θ' hθ'
    tU htU

