  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists σ₁ (ℓ ^ k)
  obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (q' ≫ σ₁) (ℓ ^ k)
