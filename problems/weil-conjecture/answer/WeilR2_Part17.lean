  have b₂ := wc_et_pull_bij_of_shens_fibres (Spec (.of C)) (Spec (.of B₀))
    (Limits.pullback h₀ (Spec.map (CommRingCat.ofHom φA))) Pq (c ≫ β)
    (Limits.pullback.fst h₀ (Spec.map (CommRingCat.ofHom φA))) t (q' ≫ σ₁) Sq2 (ℓ ^ k) hn.ne'
    (fun p' C' _ _ _ Λ _ _ W' φ ap _ => by
