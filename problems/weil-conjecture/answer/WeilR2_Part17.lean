theorem wc_supp_class_geomPt_of_section (K : Type u) [Field K] [IsAlgClosed K] {Y : Scheme.{u}}
    (pY : Y ⟶ Spec (.of K)) (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _) (y : Y)
    (hy : y₀ (IsLocalRing.closedPoint K) = y) {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy)
    (Dx : wcHMPullData (wcEtGeomPt Y y) ℓ) (hDx : wcHMPullCanonical Dx) (m : ℕ) :
    (∃ θ : wcSuppExt Dy m, wcSuppClass Dy m θ ≠ 0) → ∃ θ : wcSuppExt Dx m, wcSuppClass Dx m θ ≠ 0 :=
by
  classical
  rintro ⟨θ, hθ⟩
  subst hy

  let φ : Y.residueField (y₀ (IsLocalRing.closedPoint K)) ⟶ CommRingCat.of K :=
    Scheme.descResidueField (Scheme.stalkClosedPointTo y₀)
  have hφ : Spec.map φ ≫ Y.fromSpecResidueField (y₀ (IsLocalRing.closedPoint K)) = y₀ :=
    Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K Y y₀
  let ψ : CommRingCat.of K ⟶ Y.residueField (y₀ (IsLocalRing.closedPoint K)) :=
    Spec.preimage (Y.fromSpecResidueField (y₀ (IsLocalRing.closedPoint K)) ≫ pY)
  have hψφ : ψ ≫ φ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, ← Category.assoc, hφ, hy₀, Spec.map_id]
  have hφbij : Function.Bijective φ.hom := by
    refine ⟨RingHom.injective φ.hom, fun a => ⟨ψ.hom a, ?_⟩⟩
    have h1 := congrArg (fun f => f.hom a) hψφ
    simpa using h1
  let eK : Y.residueField (y₀ (IsLocalRing.closedPoint K)) ≃+* K :=
    RingEquiv.ofBijective φ.hom hφbij
  haveI : IsAlgClosed (Y.residueField (y₀ (IsLocalRing.closedPoint K))) :=
    IsAlgClosed.of_ringEquiv K _ eK.symm
  haveI : IsSepClosed (Y.residueField (y₀ (IsLocalRing.closedPoint K))) := inferInstance
  haveI hφiso : IsIso φ := (ConcreteCategory.isIso_iff_bijective φ).mpr hφbij
  haveI : IsIso (Spec.map φ) := inferInstance

  have s3 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (D : wcHMPullData f ℓ), wcHMPullCanonical D →
      (∀ V : S.ProEt, IsHomeomorph ⇑(Limits.pullback.fst V.hom f)) →
      IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) := by
    intro S S' f D hD hf
    refine @Functor.FullyFaithful.isIso_of_isIso_map _ _ _ _ _
      (SheafOfModules.fullyFaithfulForget _) _ _ _ ?_
    refine @isIso_of_reflects_iso _ _ _ _ _ _ _ (PresheafOfModules.toPresheaf _) ?_ _
    refine @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ (fun V => ?_)
    refine (ConcreteCategory.isIso_iff_bijective _).mpr ?_
    let H := IsHomeomorph.homeomorph _ (hf V.unop)
    have key : ∀ s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]),
        (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map ((SheafOfModules.forget _).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ))).app V)) s =
          s.comp (Limits.pullback.fst V.unop.hom f).base.hom :=
      fun s => (@SheafOfModules.unitToPushforwardObjUnit_val_app_apply _ _ _ _ _ _ _ _ _ D.cont D.φ
        _ s).trans (hD V.unop s)
    have hb : Function.Bijective (fun s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) =>
        s.comp (Limits.pullback.fst V.unop.hom f).base.hom) := by
      refine ⟨fun a b hab => ?_, fun t => ⟨t.comp ⟨H.symm, H.symm.continuous⟩, ?_⟩⟩
      · refine ContinuousMap.ext (fun v => ?_)
        have h1 : (Limits.pullback.fst V.unop.hom f).base.hom (H.symm v) = v := H.apply_symm_apply v
        have h2 := DFunLike.congr_fun hab (H.symm v)
        change a ((Limits.pullback.fst V.unop.hom f).base.hom (H.symm v)) =
          b ((Limits.pullback.fst V.unop.hom f).base.hom (H.symm v)) at h2
        rwa [h1] at h2
      · refine ContinuousMap.ext (fun w => ?_)
        change t (H.symm ((Limits.pullback.fst V.unop.hom f).base.hom w)) = t w
        rw [show (Limits.pullback.fst V.unop.hom f).base.hom w = H w from rfl, H.symm_apply_apply]
    have he : (fun s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) =>
        s.comp (Limits.pullback.fst V.unop.hom f).base.hom) =
        (fun s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) =>
          (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map ((SheafOfModules.forget _).map
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ))).app V)) s) :=
      funext (fun s => (key s).symm)
    rw [he] at hb
    exact hb

  have hg : ∀ V : (Spec (Y.residueField (y₀ (IsLocalRing.closedPoint K)))).ProEt,
      IsHomeomorph ⇑(Limits.pullback.fst V.hom (Spec.map φ)) := by
    intro V
    haveI : IsIso (Limits.pullback.fst V.hom (Spec.map φ)) :=
      Limits.pullback_fst_iso_of_right_iso _ _
    exact (Scheme.homeoOfIso (asIso (Limits.pullback.fst V.hom (Spec.map φ)))).isHomeomorph
  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists
    (Y.fromSpecResidueField (y₀ (IsLocalRing.closedPoint K))) ℓ
  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (Spec.map φ) ℓ
  haveI hu := s3 (Spec.map φ) Dg hDg hg
  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso
    (Y.fromSpecResidueField (y₀ (IsLocalRing.closedPoint K))) (Spec.map φ) y₀ hφ
    Dι hDι Dg hDg Dy hDy
  let adj' := (Dι.adj.comp Dg.adj).ofNatIsoLeft c.symm
  let r := Dy.adj.rightAdjointUniq adj'
  let γ₁ : wcSuppObj Dι ≅ wcSuppObj Dy :=
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC (Y.fromSpecResidueField (y₀ (IsLocalRing.closedPoint K)))) _ _
      Dι.cont Dι.φ).mapIso
      (asIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC (Spec.map φ)) _ _
        Dg.cont Dg.φ)) ≪≫ (r.app _).symm
  obtain ⟨γ₂⟩ := wc_supp_obj_sepClosed_geomPt_iso (y₀ (IsLocalRing.closedPoint K)) Dι hDι Dx hDx
  let γ : wcSuppObj Dy ≅ wcSuppObj Dx := γ₁.symm ≪≫ γ₂

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  have hθ' : (Abelian.Ext.mk₀ (wcSuppUnitMap Dy)).comp θ (zero_add m) ≠ 0 := hθ
  have huy : wcSuppUnitMap Dy ≠ 0 := by
    intro h
    apply hθ'
    rw [h, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
  have hh0 : wcSuppUnitMap Dy ≫ γ.hom ≠ 0 := by
    intro h
    apply huy
    rw [← Category.comp_id (wcSuppUnitMap Dy), ← γ.hom_inv_id, ← Category.assoc, h,
      Limits.zero_comp]
  obtain ⟨w, hw⟩ := wc_pmn_supp_unit_line
    (AlgebraicClosure (Y.residueField (y₀ (IsLocalRing.closedPoint K))))
    (wcEtGeomPt Y (y₀ (IsLocalRing.closedPoint K))) Dx hDx _ hh0
  have hx : wcSuppUnitMap Dx ≫ γ.inv = w.inv ≫ wcSuppUnitMap Dy := by
    calc wcSuppUnitMap Dx ≫ γ.inv = w.inv ≫ (w.hom ≫ wcSuppUnitMap Dx) ≫ γ.inv := by
          simp only [Category.assoc, Iso.inv_hom_id_assoc]
      _ = w.inv ≫ (wcSuppUnitMap Dy ≫ γ.hom) ≫ γ.inv := by rw [hw]
      _ = w.inv ≫ wcSuppUnitMap Dy := by
          simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  refine ⟨(Abelian.Ext.mk₀ γ.inv).comp θ (zero_add m), ?_⟩
  show (Abelian.Ext.mk₀ (wcSuppUnitMap Dx)).comp ((Abelian.Ext.mk₀ γ.inv).comp θ (zero_add m))
    (zero_add m) ≠ 0
  rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hx, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
  intro h0
  apply hθ'
  have h1 := congrArg (fun z => (Abelian.Ext.mk₀ w.hom).comp z (zero_add m)) h0
  simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id_assoc, Iso.hom_inv_id,
    Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_zero] at h1
  exact h1

theorem wc_isp_dim_bounds (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [ConnectedSpace Y] (N : ℕ)
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (O : Y.Opens) (hO : (O : Set Y) = {y₀ (IsLocalRing.closedPoint K)}ᶜ) (hOne : Nonempty O)
    [SmoothOfRelativeDimension N (O.ι ≫ pY)] :
    topologicalKrullDim Y ≤ (N : WithBot ℕ∞) ∧ 1 ≤ N :=
by
  classical
  obtain ⟨o⟩ := hOne

  have hdense : closure (O : Set Y) = Set.univ := by
    have hpcl : y₀ (IsLocalRing.closedPoint K) ∈ closure (O : Set Y) := by
      by_contra hp
      have hsub : closure (O : Set Y) ⊆ (O : Set Y) := by
        intro x hx
        rw [hO]
        intro hxp
        rw [Set.mem_singleton_iff] at hxp
        rw [hxp] at hx
        exact hp hx
      have hcl : IsClosed (O : Set Y) := closure_subset_iff_isClosed.mp hsub
      have hclo : IsClopen (O : Set Y) := ⟨hcl, O.isOpen⟩
      rcases isClopen_iff.mp hclo with h | h
      · have ho : o.1 ∈ (O : Set Y) := o.2
        rw [h] at ho
        exact ho
      · have hp' : y₀ (IsLocalRing.closedPoint K) ∈ (O : Set Y) := by
          rw [h]; exact Set.mem_univ _
        rw [hO] at hp'
        exact hp' rfl
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x = y₀ (IsLocalRing.closedPoint K)
    · rw [hx]; exact hpcl
    · apply subset_closure
      rw [hO]; exact hx

  have hOdim : topologicalKrullDim (O : Set Y) ≤ (N : WithBot ℕ∞) :=
    wc_smooth_alg_closed_dim_le K (O : Scheme) (O.ι ≫ pY) N
  have h1 := wc_dim_le_dim_dense_open_part K Y pY Set.univ (O : Set Y) isClosed_univ O.isOpen
    (by rw [Set.univ_inter, hdense])
  rw [IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ (Y : Type u)).isHomeomorph,
    IsHomeomorph.topologicalKrullDim_eq _
      (Homeomorph.setCongr (Set.univ_inter (O : Set Y))).isHomeomorph] at h1
  refine ⟨h1.trans hOdim, ?_⟩


  have key : ∀ (X : Type u) [TopologicalSpace X] [T0Space X] [TopologicalSpace.NoetherianSpace X],
      topologicalKrullDim X ≤ 0 → DiscreteTopology X := by
    intro X _ _ _ hX
    have hX' : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 0 := hX
    have hmax : ∀ Z : TopologicalSpace.IrreducibleCloseds X, IsMax Z :=
      Order.krullDim_nonpos_iff_forall_isMax.mp hX'
    let c : X → TopologicalSpace.IrreducibleCloseds X := fun x =>
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hT1 : T1Space X := by
      refine ⟨fun x => ?_⟩
      apply closure_subset_iff_isClosed.mp
      intro y hy
      have hle : c y ≤ c x := by
        show closure {y} ⊆ closure {x}
        exact closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
      have hge : c x ≤ c y := hmax (c y) hle
      have hle' : closure ({y} : Set X) ⊆ closure {x} := hle
      have hge' : closure ({x} : Set X) ⊆ closure {y} := hge
      have heq : closure ({y} : Set X) = closure {x} := Set.Subset.antisymm hle' hge'
      exact (inseparable_iff_closure_eq.mpr heq).eq
    haveI := hT1
    have hcomp : ∀ C ∈ irreducibleComponents X, C.Finite := by
      intro C hC
      apply Set.Subsingleton.finite
      intro a ha b hb
      let C' : TopologicalSpace.IrreducibleCloseds X :=
        ⟨C, hC.1,
          isClosed_of_mem_irreducibleComponents C hC⟩
      have ha' : c a ≤ C' := by
        show closure {a} ⊆ C
        exact closure_minimal (Set.singleton_subset_iff.mpr ha)
          (isClosed_of_mem_irreducibleComponents C hC)
      have h2 : C' ≤ c a := hmax (c a) ha'
      have h2' : C ⊆ closure {a} := h2
      have hba : b ∈ closure ({a} : Set X) := h2' hb
      rw [closure_singleton] at hba
      exact (Set.mem_singleton_iff.mp hba).symm
    have hU : (Set.univ : Set X).Finite := by
      rw [← sUnion_irreducibleComponents]
      exact (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents).sUnion hcomp
    haveI : Finite X := Set.finite_univ_iff.mp hU
    exact Finite.instDiscreteTopology
  by_contra hN
  obtain rfl : N = 0 := by omega
  have h0 : topologicalKrullDim (O : Set Y) ≤ 0 := by simpa using hOdim
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI : IsNoetherian Y := ⟨⟩
  haveI : TopologicalSpace.NoetherianSpace (O : Set Y) := TopologicalSpace.NoetherianSpace.set _
  haveI : DiscreteTopology (O : Set Y) := key _ h0
  have hopen : IsOpen ({o.1} : Set Y) := by
    have hs : IsOpen ({o} : Set (O : Set Y)) := isOpen_discrete _
    have h2 := O.isOpen.isOpenMap_subtype_val _ hs
    convert h2 using 1
    exact Set.image_singleton.symm
  have hclosed : IsClosed ({o.1} : Set Y) := by
    have hc : IsClosed ({o} : Set (O : Set Y)) := isClosed_discrete _
    have h3 := wc_closed_point_image_closed K (O : Scheme) Y (O.ι ≫ pY) pY O.ι rfl o hc
    convert h3 using 2
    first
      | rfl
      | exact (Scheme.Opens.ι_apply _ _).symm
      | simp [Scheme.Opens.ι_apply]
  rcases isClopen_iff.mp ⟨hclosed, hopen⟩ with h | h
  · exact (Set.singleton_ne_empty _) h
  · have hmem : y₀ (IsLocalRing.closedPoint K) ∈ ({o.1} : Set Y) := by
      rw [h]; exact Set.mem_univ _
    have ho : o.1 ∈ (O : Set Y) := o.2
    rw [hO] at ho
    exact ho (Set.mem_singleton_iff.mp hmem).symm

theorem wc_isp_int_tors_succ_top_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] (N : ℕ)
    (hdim : topologicalKrullDim Y ≤ (N : WithBot ℕ∞))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ x : Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ 1) (2 * N + 1), x = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  intro x
  have hcast : ((ℓ ^ 1 : ℕ) : K) ≠ 0 := by
    rw [Nat.cast_pow]; exact pow_ne_zero 1 hℓ

  haveI hsubEt : Subsingleton (wcEtCoh Y (ℓ ^ 1) (2 * N + 1)) := by
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hv := wc_et_cd_proper_torsion K Y pY N hdim (ℓ ^ 1)
      hcast ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ 1)))))
      (wc_et_const_zmod_nsmul_zero Y (ℓ ^ 1)) (2 * N + 1) (by omega)
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ 1))))) (2 * N + 1))
    exact ⟨fun a b => (hv a).trans (hv b).symm⟩

  obtain ⟨E3⟩ := wc_proet_etale_comparison_zmod K Y pY (ℓ ^ 1) (2 * N + 1)
  haveI hsub1 : Subsingleton (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y (ℓ ^ 1)) (2 * N + 1)) := E3.subsingleton

  obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod Y ℓ 1
  have key : ∀ z : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ 1)) (2 * N + 1),
      z = 0 := by
    intro z
    have hy : z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _) = 0 := Subsingleton.elim _ _
    have hz : z = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp
        (Abelian.Ext.mk₀ e.inv) (add_zero _) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [hz, hy, Abelian.Ext.zero_comp]
  haveI hsub2 : Subsingleton (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ 1)) (2 * N + 1)) :=
    ⟨fun a b => (key a).trans (key b).symm⟩

  obtain ⟨Φ⟩ := wc_int_unit_ext_free_equiv Y ℓ (wcIntTors Y ℓ 1) (2 * N + 1)
  haveI : Subsingleton (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ 1) (2 * N + 1)) :=
    Φ.subsingleton
  exact Subsingleton.elim x 0

theorem wc_int_tors_ext_growth_of_unbounded (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (N : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    (∀ w : Abelian.Ext P (wcIntTors S ℓ 1) (N + 1), w = 0) →
    (∀ m : ℕ, 1 ≤ m → ℓ ^ m ≤ Nat.card (Abelian.Ext P (wcIntTors S ℓ m) N)) →
    ∀ e : ℕ, ∃ b : Abelian.Ext P (wcIntTors S ℓ (e + 1)) N, ℓ ^ e • b ≠ 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro hV hC e
  by_contra hne
  push_neg at hne

  have torsG : ∀ (U : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (n : ℕ → (U ⟶ U)),
      (∀ k, Mono (n k)) → (∀ a b, n a ≫ n b = n (a + b)) → ∀ k : ℕ,
      ∃ (ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)))
        (t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k)) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) ∧
          Limits.cokernel.π (n 1) ≫ ι = n k ≫ Limits.cokernel.π (n (k + 1)) ∧
          (ShortComplex.mk ι t₀ w).ShortExact := by
    intro U n hmono hnn k
    have E1 : n (k + 1) ≫ Limits.cokernel.π (n k) = 0 := by
      rw [show k + 1 = 1 + k by omega, ← hnn, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have E2 : n 1 ≫ (n k ≫ Limits.cokernel.π (n (k + 1))) = 0 := by
      rw [← Category.assoc, hnn, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
    obtain ⟨t₀, F1⟩ : ∃ t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) :=
      ⟨Limits.cokernel.desc _ _ E1, Limits.cokernel.π_desc _ _ _⟩
    obtain ⟨ι, F2⟩ : ∃ ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)),
        Limits.cokernel.π (n 1) ≫ ι = n k ≫ Limits.cokernel.π (n (k + 1)) :=
      ⟨Limits.cokernel.desc _ _ E2, Limits.cokernel.π_desc _ _ _⟩
    have F3 : ι ≫ t₀ = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (n 1)), Limits.comp_zero, reassoc_of% F2, F1,
        Limits.cokernel.condition]
    haveI : Epi t₀ := epi_of_epi_fac F1
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π (n 1)) g
      have h1 : (y ≫ n k) ≫ Limits.cokernel.π (n (k + 1)) = 0 := by
        simp only [Category.assoc]
        rw [← F2, ← reassoc_of% hy, hg, Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (n (k + 1))).exact_up_to_refinements (y ≫ n k) h1
      have hz' : π' ≫ y ≫ n k = z ≫ n (k + 1) := hz
      haveI := hπ
      haveI := hπ'
      haveI := hmono k
      have h2 : π' ≫ y = z ≫ n 1 := by
        rw [← cancel_mono (n k)]
        simp only [Category.assoc]
        rw [hnn, show 1 + k = k + 1 by omega]
        exact hz'
      have h3 : (π' ≫ π) ≫ g = 0 := by
        simp only [Category.assoc]
        rw [hy, reassoc_of% h2, Limits.cokernel.condition, Limits.comp_zero]
      exact (cancel_epi (π' ≫ π)).1 (h3.trans Limits.comp_zero.symm)
    have hexact : (ShortComplex.mk ι t₀ F3).Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ t₀ = 0 := hx₂
      obtain ⟨A', π, hπ, y, hy⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (n (k + 1))) x₂
      have h1 : y ≫ Limits.cokernel.π (n k) = 0 := by
        rw [← F1, ← reassoc_of% hy, hx₂', Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ := (ShortComplex.exact_cokernel (n k)).exact_up_to_refinements y h1
      have hz' : π' ≫ y = z ≫ n k := hz
      haveI := hπ
      haveI := hπ'
      refine ⟨A'', π' ≫ π, inferInstance, z ≫ Limits.cokernel.π (n 1), ?_⟩
      show (π' ≫ π) ≫ x₂ = (z ≫ Limits.cokernel.π (n 1)) ≫ ι
      simp only [Category.assoc]
      rw [F2, hy, reassoc_of% hz']
    exact ⟨ι, t₀, F3, F1, F2, ShortComplex.ShortExact.mk' hexact inferInstance inferInstance⟩
  have hnn : ∀ a b : ℕ, ((ℓ ^ a : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
      ((ℓ ^ b : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
        ((ℓ ^ (a + b) : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro a b
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.add_comm b a]
  have tors : ∀ k : ℕ,
      ∃ (ι : wcIntTors S ℓ 1 ⟶ wcIntTors S ℓ (k + 1))
        (t₀ : wcIntTors S ℓ (k + 1) ⟶ wcIntTors S ℓ k) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t₀ =
            Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) ∧
          Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ ι =
            ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
              Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ∧
          (ShortComplex.mk ι t₀ w).ShortExact :=
    fun k => torsG (wcIntUnit S ℓ) (fun k => (ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))
      (fun k => wc_int_unit_pow_mono S ℓ k) hnn k
  choose ι t w F1 F2 hS using tors

  have nsid : ∀ {Y Z : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (x : Abelian.Ext Y Z N)
      (k : ℕ), x.comp (Abelian.Ext.mk₀ (k • 𝟙 Z)) (add_zero N) = k • x := by
    intro Y Z x k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  have compc : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (x : Abelian.Ext P A N)
      (f : A ⟶ B) (g : B ⟶ C),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero N)).comp (Abelian.Ext.mk₀ g) (add_zero N) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero N) := by
    intro A B C x f g
    rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ g) (add_zero N)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]

  have hρex : ∀ k : ℕ, ∃ ρ : wcIntTors S ℓ (k + 1) ⟶ wcIntTors S ℓ 1,
      Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ ρ =
        Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro k
    have E : ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
        Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) = 0 := by
      rw [← hnn k 1, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    exact ⟨Limits.cokernel.desc _ _ E, Limits.cokernel.π_desc _ _ _⟩

  have hsurj : ∀ (k : ℕ) (ρ : wcIntTors S ℓ (k + 1) ⟶ wcIntTors S ℓ 1),
      Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ ρ =
        Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) →
      ∀ c : Abelian.Ext P (wcIntTors S ℓ 1) N,
        ∃ b : Abelian.Ext P (wcIntTors S ℓ (k + 1)) N,
          b.comp (Abelian.Ext.mk₀ ρ) (add_zero N) = c := by
    intro k
    induction k with
    | zero =>
      intro ρ hρ c
      have h1 : ρ = 𝟙 _ :=
        (cancel_epi (Limits.cokernel.π ((ℓ ^ (0 + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
          (hρ.trans (Category.comp_id _).symm)
      subst h1
      exact ⟨c, Abelian.Ext.comp_mk₀_id c⟩
    | succ k ih =>
      intro ρ' hρ' c
      obtain ⟨ρ, hρ⟩ := hρex k
      have hfac : ρ' = t (k + 1) ≫ ρ := by
        rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ (k + 1 + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ))), hρ',
          reassoc_of% (F1 (k + 1)), hρ]
      obtain ⟨b, hb⟩ := ih ρ hρ c
      have hobs : b.comp (hS (k + 1)).extClass (rfl : N + 1 = N + 1) = 0 := hV _
      obtain ⟨b', hb'⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS (k + 1)) b rfl hobs
      have hb'' : b'.comp (Abelian.Ext.mk₀ (t (k + 1))) (add_zero N) = b := hb'
      refine ⟨b', ?_⟩
      rw [hfac, ← compc, hb'', hb]

  obtain ⟨ρe, hρe⟩ := hρex e
  have hρι : ρe ≫ ι e = (ℓ ^ e : ℕ) • 𝟙 (wcIntTors S ℓ (e + 1)) := by
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ))),
      reassoc_of% hρe, F2 e, Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul,
      Category.comp_id]
  have hK0 : ∀ c : Abelian.Ext P (wcIntTors S ℓ 1) N,
      c.comp (Abelian.Ext.mk₀ (ι e)) (add_zero N) = 0 := by
    intro c
    obtain ⟨b, rfl⟩ := hsurj e ρe hρe c
    rw [compc, hρι, nsid, hne]
  have hK : ∀ m : ℕ, e ≤ m → ∀ c : Abelian.Ext P (wcIntTors S ℓ 1) N,
      c.comp (Abelian.Ext.mk₀ (ι m)) (add_zero N) = 0 := by
    intro m hm c
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hm
    have Es : ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
        (((ℓ ^ j : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ (e + j + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ))) = 0 := by
      rw [← Category.assoc, hnn, show e + 1 + j = e + j + 1 by omega, Limits.cokernel.condition]
    obtain ⟨s, hs⟩ : ∃ s : wcIntTors S ℓ (e + 1) ⟶ wcIntTors S ℓ (e + j + 1),
        Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ s =
          ((ℓ ^ j : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
            Limits.cokernel.π ((ℓ ^ (e + j + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) :=
      ⟨Limits.cokernel.desc _ _ Es, Limits.cokernel.π_desc _ _ _⟩
    have hfac : ι (e + j) = ι e ≫ s := by
      rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ))), F2 (e + j),
        reassoc_of% (F2 e), hs, ← Category.assoc, hnn]
    rw [hfac, ← compc, hK0, Abelian.Ext.zero_comp]

  have hinj : ∀ m : ℕ, e ≤ m →
      Function.Injective ((Abelian.Ext.mk₀ (t m)).postcomp P (add_zero N)) := by
    intro m hm
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS m) x hx
    rw [← hx₁]
    exact hK m hm x₁

  have hℓ2 : 2 ≤ ℓ := (Fact.out : Nat.Prime ℓ).two_le
  have hfin : ∀ m : ℕ, 1 ≤ m → Finite (Abelian.Ext P (wcIntTors S ℓ m) N) := by
    intro m hm
    apply Nat.finite_of_card_ne_zero
    have h1 : 0 < ℓ ^ m := pow_pos (by omega) m
    have h2 := hC m hm
    omega
  have hbd : ∀ m : ℕ, e + 1 ≤ m → Nat.card (Abelian.Ext P (wcIntTors S ℓ m) N) ≤
      Nat.card (Abelian.Ext P (wcIntTors S ℓ (e + 1)) N) := by
    intro m hm
    induction m, hm using Nat.le_induction with
    | base => exact le_rfl
    | succ m hm ih =>
      haveI := hfin m (by omega)
      exact le_trans (Nat.card_le_card_of_injective _ (hinj m (by omega))) ih
  set B := Nat.card (Abelian.Ext P (wcIntTors S ℓ (e + 1)) N) with hB
  have h1 := hC (e + 1 + B) (by omega)
  have h2 := hbd (e + 1 + B) (by omega)
  have h3 : e + 1 + B < 2 ^ (e + 1 + B) := Nat.lt_two_pow_self
  have h4 : 2 ^ (e + 1 + B) ≤ ℓ ^ (e + 1 + B) := Nat.pow_le_pow_left hℓ2 _
  omega

theorem wc_isp_irreducible_top_piece (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] (N : ℕ)
    (hdim : topologicalKrullDim Y ≤ (N : WithBot ℕ∞))
    (O : Y.Opens) (hOne : Nonempty O) [SmoothOfRelativeDimension N (O.ι ≫ pY)] :
    ∃ (Y₁ : Scheme.{u}) (i : Y₁ ⟶ Y), IsClosedImmersion i ∧ IrreducibleSpace Y₁ ∧
      topologicalKrullDim Y₁ = (N : WithBot ℕ∞) :=
by
  obtain ⟨o⟩ := hOne
  obtain ⟨N', _hoN', hN'irr⟩ :=
    wc_smooth_field_exists_irreducible_open_nbhd K (O : Scheme.{u}) (O.ι ≫ pY) N o
  haveI := hN'irr
  haveI h0 : SmoothOfRelativeDimension (0 + N) (N'.ι ≫ (O.ι ≫ pY)) := inferInstance
  rw [zero_add] at h0
  have hdimN' : (N : WithBot ℕ∞) ≤ topologicalKrullDim (N' : Scheme.{u}) :=
    wc_smooth_irreducible_dim_ge K (N' : Scheme.{u}) (N'.ι ≫ (O.ι ≫ pY)) N
  let W : Y.Opens := Scheme.Hom.opensRange (N'.ι ≫ O.ι)
  let hW : (N' : Scheme.{u}) ≃ₜ (W : Scheme.{u}) :=
    Scheme.homeoOfIso (Scheme.Hom.isoOpensRange (N'.ι ≫ O.ι))
  have hWirr : IrreducibleSpace W :=
    Function.Surjective.irreducibleSpace hW.continuous hW.surjective
  have hdimW : topologicalKrullDim (N' : Scheme.{u}) = topologicalKrullDim (W : Scheme.{u}) :=
    IsHomeomorph.topologicalKrullDim_eq hW (Homeomorph.isHomeomorph hW)
  obtain ⟨Z, i, hi, hZirr, hiso⟩ := wc_closed_irreducible_model_of_open K Y pY W hWirr
  haveI := hi
  haveI := hiso
  have hle : topologicalKrullDim Z ≤ topologicalKrullDim Y :=
    (Scheme.Hom.isClosedEmbedding i).isInducing.topologicalKrullDim_le
  let hV : ((i ⁻¹ᵁ W : Z.Opens) : Scheme.{u}) ≃ₜ (W : Scheme.{u}) :=
    Scheme.homeoOfIso (asIso (i ∣_ W))
  have hdimV : topologicalKrullDim ((i ⁻¹ᵁ W : Z.Opens) : Scheme.{u}) =
      topologicalKrullDim (W : Scheme.{u}) :=
    IsHomeomorph.topologicalKrullDim_eq hV (Homeomorph.isHomeomorph hV)
  have hVle : topologicalKrullDim ((i ⁻¹ᵁ W : Z.Opens) : Scheme.{u}) ≤ topologicalKrullDim Z :=
    (Scheme.Hom.isOpenEmbedding (i ⁻¹ᵁ W).ι).isInducing.topologicalKrullDim_le
  refine ⟨Z, i, hi, hZirr, le_antisymm (hle.trans hdim) ?_⟩
  calc (N : WithBot ℕ∞) ≤ topologicalKrullDim (N' : Scheme.{u}) := hdimN'
    _ = topologicalKrullDim (W : Scheme.{u}) := hdimW
    _ = topologicalKrullDim ((i ⁻¹ᵁ W : Z.Opens) : Scheme.{u}) := hdimV.symm
    _ ≤ topologicalKrullDim Z := hVle

theorem wc_isp_int_tors_top_card_ge (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] (N : ℕ)
    (hdim : topologicalKrullDim Y ≤ (N : WithBot ℕ∞))
    (Y₁ : Scheme.{u}) (i : Y₁ ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Y₁]
    (hdim₁ : topologicalKrullDim Y₁ = (N : WithBot ℕ∞))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ m : ℕ, 1 ≤ m → ℓ ^ m ≤ Nat.card (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) (2 * N)) :=
by
  classical

  have hrestr : ∀ (m : ℕ), (m : K) ≠ 0 →
      Nat.card (wcEtCoh Y₁ m (2 * N)) ≤ Nat.card (wcEtCoh Y m (2 * N)) := by
    intro m hm
    have hmono : Mono (wcEtExtZeroι Y (Set.range i)ᶜ m) := by
      let α : wcEtExtZeroPre Y (Set.range i)ᶜ m ⟶
          (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
        { app := fun V => AddCommGrpCat.ofHom
            (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range i)ᶜ)).subtype
          naturality := fun _ _ _ => rfl }
      haveI : ∀ V, Mono (α.app V) := fun V =>
        (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
      haveI : Mono α := NatTrans.mono_of_mono_app α
      exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) α
    let T := ShortComplex.mk (wcEtExtZeroι Y (Set.range i)ᶜ m) (Limits.cokernel.π _)
      (Limits.cokernel.condition _)
    have hTs : T.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))

    have hMY : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
      have h0 : (m : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
        ext x
        simp
      rw [← natCast_zsmul, ← CategoryTheory.Functor.map_id (constantSheaf
        (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ← CategoryTheory.Functor.map_zsmul, h0,
        CategoryTheory.Functor.map_zero]

    have hG : m • 𝟙 T.X₁ = 0 := by
      haveI : Mono T.f := hmono
      rw [← cancel_mono T.f]
      rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
      have : m • T.f = T.f ≫ (m • 𝟙 T.X₂) := by
        rw [Preadditive.comp_nsmul, Category.comp_id]
      rw [this]
      change T.f ≫ (m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) = 0
      rw [hMY, Limits.comp_zero]
    have hvan := wc_et_cd_proper_torsion K Y pY N hdim m hm T.X₁ hG (2 * N + 1) (by omega)
    have hsurj : Function.Surjective
        (fun x₂ : Abelian.Ext P T.X₂ (2 * N) => x₂.comp (Abelian.Ext.mk₀ T.g) (add_zero _)) := by
      intro x₃
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hTs x₃ rfl (hvan _)
      exact ⟨x₂, hx₂⟩
    obtain ⟨e⟩ := wc_et_closed_complement_coh Y Y₁ i m (2 * N)
    haveI hfin : Finite (wcEtCoh Y m (2 * N)) := wc_etale_proper_finite K Y pY m hm (2 * N)
    change Nat.card (wcEtCoh Y₁ m (2 * N)) ≤ Nat.card (Abelian.Ext P T.X₂ (2 * N))
    haveI : Finite (Abelian.Ext P T.X₂ (2 * N)) := hfin
    let e' : Abelian.Ext P T.X₃ (2 * N) ≃ wcEtCoh Y₁ m (2 * N) := e
    exact Nat.card_le_card_of_surjective (fun x₂ => e' (x₂.comp (Abelian.Ext.mk₀ T.g) (add_zero _)))
      (e'.surjective.comp hsurj)
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _

  have hE : ∀ m : ℕ, Nonempty (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) (2 * N) ≃
      wcEtCoh Y (ℓ ^ m) (2 * N)) := by
    intro m
    obtain ⟨Φ⟩ := wc_int_unit_ext_free_equiv Y ℓ (wcIntTors Y ℓ m) (2 * N)
    obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod Y ℓ m
    obtain ⟨E3⟩ := wc_proet_etale_comparison_zmod K Y pY (ℓ ^ m) (2 * N)
    let Ψ : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ m)) (2 * N) ≃
        Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y (ℓ ^ m)) (2 * N) :=
      { toFun := fun z => z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)
        invFun := fun w => w.comp (Abelian.Ext.mk₀ e.inv) (add_zero _)
        left_inv := fun z => by
          show (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp
            (Abelian.Ext.mk₀ e.inv) (add_zero _) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
        right_inv := fun w => by
          show (w.comp (Abelian.Ext.mk₀ e.inv) (add_zero _)).comp
            (Abelian.Ext.mk₀ e.hom) (add_zero _) = w
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id] }
    exact ⟨(Φ.trans Ψ).trans E3⟩

  intro m hm
  obtain ⟨Em⟩ := hE m
  rw [Nat.card_congr Em]
  have h1 : ℓ ^ m ≤ Nat.card (wcEtCoh Y₁ (ℓ ^ m) (2 * N)) :=
    wc_et_top_coh_card_ge K Y₁ (i ≫ pY) N hdim₁ ℓ Fact.out hℓ m hm
  have hℓm : ((ℓ ^ m : ℕ) : K) ≠ 0 := by rw [Nat.cast_pow]; exact pow_ne_zero _ hℓ
  exact h1.trans (hrestr (ℓ ^ m) hℓm)

theorem wc_isp_int_supp_kernel_tors_vanish (K : Type u) [Field K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] (N : ℕ)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (O : Y.Opens) (hO : (O : Set Y) = {y₀ (IsLocalRing.closedPoint K)}ᶜ)
    (hvan : Subsingleton (wcEtCoh (O : Scheme.{u}) ℓ (2 * N)))
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ (m : ℕ), 1 ≤ m →
    ∀ y : Abelian.Ext (Limits.kernel (wcIntSuppπ Dy)) (wcIntTors Y ℓ m) (2 * N), y = 0 :=
by
  classical

  have hdev : ∀ (W : Scheme.{u}) (p i : ℕ), p ≠ 0 → Subsingleton (wcEtCoh W p i) →
      ∀ k : ℕ, Subsingleton (wcEtCoh W (p ^ k) i) := by
    intro W p i hp hsp
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hsub : ∀ (X₀ : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Subsingleton (Abelian.Ext X₀ S.X₁ m) → Subsingleton (Abelian.Ext X₀ S.X₃ m) →
          Subsingleton (Abelian.Ext X₀ S.X₂ m) := by
      intro X₀ S hS m h1 h3
      have hz : ∀ y : Abelian.Ext X₀ S.X₂ m, y = 0 := by
        intro y
        obtain ⟨y₁, hy₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X₀ hS y (Subsingleton.elim _ _)
        rw [← hy₁, Subsingleton.elim y₁ 0, Abelian.Ext.zero_comp]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hzero : ∀ (X₀ Z : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}),
        Limits.IsZero Z → ∀ m, Subsingleton (Abelian.Ext X₀ Z m) := by
      intro X₀ Z hZ m
      have hx : ∀ x : Abelian.Ext X₀ Z m, x = 0 := by
        intro x
        have := Abelian.Ext.comp_mk₀_id x
        rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
        exact this.symm
      exact ⟨fun x y => by rw [hx x, hx y]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale W)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
    intro k
    induction k with
    | zero =>
      rw [pow_zero]
      exact hzero _ _ (Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)) i
    | succ k ih =>
      obtain ⟨f, g, hw, hS₀⟩ := hses p (p ^ k) hp
      have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
      rw [pow_succ']
      exact hsub ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS i ih hsp
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  intro m _hm y

  let VU : Y.ProEt :=
    MorphismProperty.Over.mk ⊤ O.ι (etale_le_weaklyEtale _ _ _ inferInstance)
  have hVUo : IsOpenImmersion VU.hom := (inferInstance : IsOpenImmersion O.ι)
  have hrange : Set.range y₀ = {y₀ (IsLocalRing.closedPoint K)} := by
    ext z
    constructor
    · rintro ⟨p, rfl⟩
      rw [Set.mem_singleton_iff, Subsingleton.elim p (IsLocalRing.closedPoint K)]
    · intro h
      rw [Set.mem_singleton_iff.mp h]
      exact ⟨_, rfl⟩
  have hVU : Set.range VU.hom = (Set.range y₀)ᶜ := by
    rw [hrange, ← hO]
    exact Scheme.Opens.range_ι O

  have hvanZ : ∀ x : Abelian.Ext (wcFreeSheaf Y VU) (wcZModSheaf Y (ℓ ^ m)) (2 * N), x = 0 := by
    intro x
    haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
    haveI := hVUo
    haveI : CompactSpace VU.left := by
      have hqc : QuasiCompact (VU.hom : VU.left ⟶ Y) :=
        @instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion Y VU.left _ VU.hom hVUo
      exact @QuasiCompact.compactSpace_of_compactSpace VU.left Y VU.hom hqc _
    haveI : IsSeparated (Limits.terminal.from VU.left) := by
      have e : Limits.terminal.from VU.left =
          VU.hom ≫ pY ≫ Limits.terminal.from (Spec (.of K)) :=
        Limits.terminal.hom_ext _ _
      rw [e]; infer_instance
    obtain ⟨E₁⟩ := wc_ext_free_slice_zmod Y VU (ℓ ^ m) (2 * N)
    obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont VU.left
    haveI := hcont
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep VU.left
      ((constantSheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) (2 * N)
    let χ : (wcEpsInv VU.left).obj ((constantSheaf (Scheme.smallEtaleTopology VU.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) ≅
        wcZModSheaf VU.left (ℓ ^ m) :=
      (wc_epsInv_const VU.left (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))).some ≪≫
        (wc_zmod_sheaf_const VU.left (ℓ ^ m)).some.symm
    have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology VU.left) AddCommGrpCat.{u+1}}
        (e : B ≅ B'), Nonempty (Abelian.Ext A B (2 * N) ≃ Abelian.Ext A B' (2 * N)) := by
      intro A B B' e
      refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (2 * N))
                invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (2 * N))
                left_inv := fun y => ?_
                right_inv := fun y => ?_ }⟩
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * N)) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * N)) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    obtain ⟨E₂⟩ := post (A := wcFreeSheaf VU.left (Scheme.ProEt.mk (𝟙 VU.left))) χ.symm
    have h1 : Subsingleton (wcEtCoh VU.left ℓ (2 * N)) := hvan
    haveI hnn := hdev VU.left ℓ (2 * N) (Fact.out : ℓ.Prime).ne_zero h1 m
