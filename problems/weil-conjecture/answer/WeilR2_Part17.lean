    haveI hm₂q : QuasiCompact m₂ := by
      rw [hm₂]
      exact MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback Q.hom O.ι).flip (qcOpen O hXn)
    let Q₁ : X.ProEt := MorphismProperty.Over.mk ⊤ (m₁ ≫ Q.hom) inferInstance
    let Q₂ : X.ProEt := MorphismProperty.Over.mk ⊤ (m₂ ≫ Q.hom) inferInstance
    let k₁ : Q₁ ⟶ Q := MorphismProperty.Over.homMk m₁ rfl trivial
    let k₂ : Q₂ ⟶ Q := MorphismProperty.Over.homMk m₂ rfl trivial
    let pcs : Fin 2 → Σ P : X.ProEt, (P ⟶ Q) := ![⟨Q₁, k₁⟩, ⟨Q₂, k₂⟩]
    have hqc : ∀ k, QuasiCompact (pcs k).2.left := by
      refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · show QuasiCompact m₁
