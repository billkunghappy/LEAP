          apply hθ
          have hσinv : σ.inv = inv ((w ≫ b) ≫ σ.hom) ≫ w ≫ b := by
            rw [IsIso.eq_inv_comp, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
          have : θ = g ≫ σ.hom ≫ σ.inv ≫ h := by
            rw [Iso.hom_inv_id_assoc]; exact hg
          rw [this, hσinv]
          simp only [Category.assoc, hk3, Limits.comp_zero]
      intro w
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT w (by
        change w ≫ (ε • b) = 0
        rw [Units.smul_def, Preadditive.comp_zsmul, hK w, smul_zero])
      refine ⟨(ε : ℤ) • g, ?_⟩
      change w = g ≫ (ε • a) at hg
      rw [hg, Units.smul_def, Preadditive.comp_zsmul, Preadditive.zsmul_comp]

    have hT := Pretriangulated.Triangle.shift_distinguished _
      (DerivedCategory.mappingCone_triangle_distinguished eΨ) N
    have hT' : Pretriangulated.Triangle.mk (N.negOnePow • (DerivedCategory.Q.map eΨ)⟦N⟧')
        (N.negOnePow • (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦N⟧')
