        rw [nsmul_eq_mul]
        exact hkey _
      haveI hπepi : Epi (wcIntSuppπ DV) := inferInstanceAs (Epi (Limits.factorThruImage _))
      refine ⟨C, hC, (hCmem z₀).mpr hz, ?_⟩
      show ((Abelian.Ext.mk₀ g).comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
              (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero 0)).comp
            (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))))
