          [IsNoetherianRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
          (eB : Th.left ≅ Spec (.of B)), g.left ⁻¹' {y} = {eB.inv (IsLocalRing.closedPoint B)} →
          IsIso (Limits.pullback.snd g.left (Ys.fromSpecResidueField y)) →
          ∀ (j : VT ⟶ Th), IsOpenImmersion j.left →
          Set.range j.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ →
          ∃ (VT₁ VT₂ : Ys.ProEt) (k₁ : VT₁ ⟶ VT) (k₂ : VT₂ ⟶ VT),
            IsOpenImmersion k₁.left ∧ IsOpenImmersion k₂.left ∧
            Disjoint (Set.range k₁.left) (Set.range k₂.left) ∧
            Set.range k₁.left ∪ Set.range k₂.left = Set.univ ∧
            (∃ η : Abelian.Ext (wcFreeSheaf Ys VT₁) (wcLadicSheaf Ys ℓ) 1 →+ ℚ_[ℓ],
              Function.Injective η ∧ ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf Ys VT₁)
                (wcLadicSheaf Ys ℓ) 1),
                η (z.comp (Abelian.Ext.mk₀ (wcLadicScalar Ys ℓ c)) (add_zero 1)) = c * η z) ∧
            (∃ η : Abelian.Ext (wcFreeSheaf Ys VT₂) (wcLadicSheaf Ys ℓ) 1 →+ ℚ_[ℓ],
              Function.Injective η ∧ ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf Ys VT₂)
                (wcLadicSheaf Ys ℓ) 1),
                η (z.comp (Abelian.Ext.mk₀ (wcLadicScalar Ys ℓ c)) (add_zero 1)) = c * η z)),
      letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf Ys ℓ))
      ∀ a b w : Abelian.Ext (wcSuppObj Dx) (SheafOfModules.unit (wcRingSheaf Ys ℓ)) 2,
        (∀ c d : wcSuppObj Dx ⟶ wcSuppObj Dx, (Abelian.Ext.mk₀ c).comp a (zero_add 2) +
          (Abelian.Ext.mk₀ d).comp b (zero_add 2) = 0 → c = 0 ∧ d = 0) →
        ∃ c d : wcSuppObj Dx ⟶ wcSuppObj Dx, w = (Abelian.Ext.mk₀ c).comp a (zero_add 2) +
          (Abelian.Ext.mk₀ d).comp b (zero_add 2) := by
    intro Ys y _ hcl hsep Dx hDx hsplit
