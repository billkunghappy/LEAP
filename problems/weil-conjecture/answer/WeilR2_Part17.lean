  have hc : a ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
      β ≫ (av ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
