            MvPolynomial.algebraMap_eq, hφC, hRkΩ] }
    let gA : MvPolynomial (Fin e) K →ₐ[K] Localization.Away (φ (MvPolynomial.X k)) :=
      MvPolynomial.aeval (fun i : Fin e => algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
        (Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * (k.succAbove i).val + 1, by omega⟩ : Fin (2 * e + 1 + 1)))))
    let ΘA := Algebra.TensorProduct.productMap fA gA
    have G1 : ∀ a, ΘA (a ⊗ₜ[K] (1 : MvPolynomial (Fin e) K)) = fL a := by
      intro a
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    have G2 : ∀ b, ΘA ((1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) ⊗ₜ[K] b) = gA b := by
      intro b
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
    have G3 : ∀ c : K, ΘA (algebraMap K _ c) = algebraMap K _ c := fun c => ΘA.commutes c
    have hgAX : ∀ i : Fin e, gA (MvPolynomial.X i) = algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
        (Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * (k.succAbove i).val + 1, by omega⟩ : Fin (2 * e + 1 + 1)))) := by
      intro i
      simp [gA]

    set yinv : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K) := IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K) with hyinvdef
    have hyinv : algebraMap _ _ (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K) * yinv = 1 :=
      IsLocalization.Away.mul_invSelf _
    obtain ⟨Y, hY⟩ : ∃ Y : Fin (e + 1) → TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K),
        ∀ j, Y j = algebraMap (MvPolynomial (Fin (e + 1)) K) (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial.X j) ⊗ₜ[K] (1 : MvPolynomial (Fin e) K) :=
      ⟨fun j => algebraMap (MvPolynomial (Fin (e + 1)) K) (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial.X j) ⊗ₜ[K] (1 : MvPolynomial (Fin e) K), fun _ => rfl⟩
    obtain ⟨z, hz⟩ : ∃ z : Fin e → TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K),
        ∀ i, z i = (1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) ⊗ₜ[K] (MvPolynomial.X i : MvPolynomial (Fin e) K) :=
      ⟨fun i => (1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) ⊗ₜ[K] (MvPolynomial.X i : MvPolynomial (Fin e) K), fun _ => rfl⟩
    obtain ⟨sv, hsv⟩ : ∃ sv : TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K),
        sv = (yinv ⊗ₜ[K] (1 : MvPolynomial (Fin e) K)) * (0 - ∑ i : Fin e, Y (k.succAbove i) * z i) :=
      ⟨_, rfl⟩
    obtain ⟨o, ho_k, ho_sa⟩ : ∃ o : Fin (e + 1) → TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K),
        o k = sv ∧ ∀ i, o (k.succAbove i) = z i :=
      ⟨Fin.insertNth (α := fun _ => TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K)) k sv z,
        Fin.insertNth_apply_same _ _ _, fun i => Fin.insertNth_apply_succAbove _ _ _ _⟩
    obtain ⟨vβ, hve, hvo⟩ : ∃ vβ : Fin (2 * e + 1 + 1) → TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K),
        (∀ j : Fin (e + 1), vβ ⟨2 * j.val, by omega⟩ = Y j) ∧ (∀ j : Fin (e + 1), vβ ⟨2 * j.val + 1, by omega⟩ = o j) := by
      refine ⟨fun p => if p.val % 2 = 0 then Y ⟨p.val / 2, by omega⟩ else o ⟨p.val / 2, by omega⟩, ?_, ?_⟩
      · intro j
        have h1 : (2 * j.val) % 2 = 0 := by omega
        have h2 : (⟨(2 * j.val) / 2, by omega⟩ : Fin (e + 1)) = j := Fin.ext (by simp only; omega)
        simp only [h1, if_true, h2]
      · intro j
        have h1 : ¬ ((2 * j.val + 1) % 2 = 0) := by omega
        have h2 : (⟨(2 * j.val + 1) / 2, by omega⟩ : Fin (e + 1)) = j := Fin.ext (by simp only; omega)
        simp only [h1, if_false, h2]
    have hYk : Y k * (yinv ⊗ₜ[K] (1 : MvPolynomial (Fin e) K)) = 1 := by
      rw [hY, Algebra.TensorProduct.tmul_mul_tmul, hyinv, mul_one]
      rfl
    set β₀ : MvPolynomial (Fin (2 * e + 1 + 1)) K →+* TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K) :=
      MvPolynomial.eval₂Hom (algebraMap K _) vβ with hβ₀def
    have hβ₀X : ∀ p, β₀ (MvPolynomial.X p) = vβ p := fun p => MvPolynomial.eval₂Hom_X' _ _ _
    have hβ₀C : ∀ c, β₀ (MvPolynomial.C c) = algebraMap K _ c := fun c => MvPolynomial.eval₂Hom_C _ _ _
    have hβ₀gen : β₀ (∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ - MvPolynomial.C 0) = 0 := by
      rw [map_sub, map_sum, hβ₀C, map_zero]
      simp only [map_mul, hβ₀X, hve, hvo]
      rw [Fin.sum_univ_succAbove _ k, ho_k]
      simp only [ho_sa]
      rw [hsv]
      linear_combination (0 - ∑ i : Fin e, Y (k.succAbove i) * z i) * hYk
    have hker : ∀ a ∈ I, β₀ a = 0 := by
      intro a ha
      have ha' : a ∈ Ideal.span {(∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ - MvPolynomial.C 0 : MvPolynomial (Fin (2 * e + 1 + 1)) K)} := by
        rw [← hQ]
        exact ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha'
      rw [map_mul, hβ₀gen, mul_zero]
    set β : MvPolynomial (Fin (2 * e + 1 + 1)) K ⧸ I →+* TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K) :=
      Ideal.Quotient.lift I β₀ hker with hβdef
    have hβmk : ∀ a, β (Ideal.Quotient.mk I a) = β₀ a := fun a => Ideal.Quotient.lift_mk _ _ _
    have hunit : IsUnit (β (φ (MvPolynomial.X k))) := by
      rw [hφX, hβmk, hβ₀X, hve]
      exact IsUnit.of_mul_eq_one _ hYk
    set Θ' : Localization.Away (φ (MvPolynomial.X k)) →+* TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K) :=
      IsLocalization.Away.lift (φ (MvPolynomial.X k)) hunit with hΘ'def
    have hΘ'alg : ∀ a, Θ' (algebraMap _ _ a) = β a := fun a => IsLocalization.Away.lift_eq _ _ _
    have F1 : ∀ p, Θ' (algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (Ideal.Quotient.mk I (MvPolynomial.X p))) = vβ p := by
      intro p
      rw [hΘ'alg, hβmk, hβ₀X]
    have F2 : ∀ c : K, Θ' (algebraMap K (Localization.Away (φ (MvPolynomial.X k))) c) = algebraMap K _ c := by
      intro c
      rw [← hRkΩ, hΘ'alg, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, hβmk, hβ₀C]
    set Θ := ΘA.toRingHom with hΘdef
    have hparity : ∀ p : Fin (2 * e + 1 + 1), ∃ j : Fin (e + 1),
        p = ⟨2 * j.val, by omega⟩ ∨ p = ⟨2 * j.val + 1, by omega⟩ := by
      intro p
      refine ⟨⟨p.val / 2, by omega⟩, ?_⟩
      rcases Nat.mod_two_eq_zero_or_one p.val with h | h
      · left; exact Fin.ext (by simp only; omega)
      · right; exact Fin.ext (by simp only; omega)
    have hA : Θ.comp Θ' = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (φ (MvPolynomial.X k)))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hRkΩ, F2]
        exact G3 c
      · intro p
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [F1]
        obtain ⟨j, hj | hj⟩ := hparity p
        · subst hj
          rw [hve, hY]
          show ΘA _ = _
          rw [G1, hfL_alg]
          exact congrArg _ (hφX j)
        · subst hj
          rw [hvo]
          by_cases hjk : j = k
          · subst hjk
            rw [ho_k, hsv]
            show ΘA _ = _
            rw [map_mul, G1, map_sub, map_zero, map_sum]
            simp only [map_mul, hY, hz, G1, G2, hfL_alg, hφX, hgAX]
            have hu : algebraMap _ (Localization.Away (φ (MvPolynomial.X j))) (Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val, by omega⟩)) * fL yinv = 1 := by
              rw [← hφX, ← hfL_alg, ← map_mul, hyinv, map_one]
            have hr := congrArg (algebraMap _ (Localization.Away (φ (MvPolynomial.X j)))) hrel
            rw [map_sum, map_zero, Fin.sum_univ_succAbove _ j] at hr
            simp only [map_mul] at hr
            linear_combination (-(fL yinv)) * hr + algebraMap _ (Localization.Away (φ (MvPolynomial.X j))) (Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val + 1, by omega⟩)) * hu
          · obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hjk
            rw [ho_sa, hz]
            show ΘA _ = _
            rw [G2, hgAX]
    have hB : Θ'.comp Θ = RingHom.id _ := by
      have HL : Θ'.comp fL = Algebra.TensorProduct.includeLeftRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K))
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
          rw [hfL_alg, hφC, hRkΩ, F2, Algebra.TensorProduct.algebraMap_apply,
            ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
        · intro j
          simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
          rw [hfL_alg, hφX j, F1, hve, hY]
      have HR : ∀ b, Θ' (gA b) = (1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) ⊗ₜ[K] b := by
        intro b
        have : Θ'.comp gA.toRingHom = Algebra.TensorProduct.includeRight.toRingHom := by
          apply MvPolynomial.ringHom_ext
          · intro c
            show Θ' (gA (MvPolynomial.C c)) = Algebra.TensorProduct.includeRight (MvPolynomial.C c)
            rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes, F2]
          · intro i
            show Θ' (gA (MvPolynomial.X i)) = Algebra.TensorProduct.includeRight (MvPolynomial.X i)
            rw [hgAX, F1, hvo, ho_sa, hz]
            rfl
        exact congrArg (fun f => f b) this
      apply RingHom.ext
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        have hab : a ⊗ₜ[K] b = (a ⊗ₜ[K] (1 : MvPolynomial (Fin e) K)) * ((1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) ⊗ₜ[K] b) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hab, map_mul, map_mul, RingHom.id_apply]
        show Θ' (ΘA _) * Θ' (ΘA _) = _
        rw [G1, G2, HR]
        have := congrArg (fun f => f a) HL
        simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply] at this
        rw [this]
        rfl
      | add x y hx hy => rw [map_add, hx, hy, map_add]
    refine ⟨RingEquiv.ofRingHom Θ Θ' hA hB, ?_⟩
    apply RingHom.ext
    intro a
    show ΘA (a ⊗ₜ[K] 1) = _
    rw [G1]



  have hs4 : ∀ (K S R T : Type u) [CommRing K] [CommRing S] [CommRing R] [CommRing T] [Algebra K S] [Algebra K T] (φ : S →+* R) (r : S) (Ψ : TensorProduct K (Localization.Away r) T ≃+* Localization.Away (φ r)), Ψ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom = Localization.awayMap φ r → ∃ q : ((Spec.map (CommRingCat.ofHom φ) ⁻¹ᵁ PrimeSpectrum.basicOpen r : (Spec (.of R)).Opens) : Scheme.{u}) ⟶ Spec (.of T), IsPullback (Spec.map (CommRingCat.ofHom φ) ∣_ PrimeSpectrum.basicOpen r) q (Scheme.Opens.ι (X := Spec (.of S)) (PrimeSpectrum.basicOpen r) ≫ Spec.map (CommRingCat.ofHom (algebraMap K S))) (Spec.map (CommRingCat.ofHom (algebraMap K T))) := by
    intro K S R T _ _ _ _ _ _ φ r Ψ hΨ
    have hpb := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct K (Localization.Away r) T)
    let e₁ : Spec (.of (TensorProduct K (Localization.Away r) T)) ≅ Spec (.of (Localization.Away (φ r))) :=
      { hom := Spec.map (CommRingCat.ofHom Ψ.symm.toRingHom)
        inv := Spec.map (CommRingCat.ofHom Ψ.toRingHom)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have : Ψ.symm.toRingHom.comp Ψ.toRingHom = RingHom.id _ := RingHom.ext fun x => by simp
          rw [this, CommRingCat.ofHom_id, Spec.map_id]
        inv_hom_id := by
