    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx)
    (Dw : wcHMPullData (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (hDw : wcHMPullCanonical Dw) :
    Dw.Φ.map (wcSuppUnitMap Dx) ≠ 0 :=
by
  classical

  have key : ∀ {X W : Scheme.{u}} (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X) (w : W ⟶ X)
      (hw : WeaklyEtale w) (Dx : wcHMPullData xb ℓ) (_ : wcHMPullCanonical Dx)
      (Dw : wcHMPullData w ℓ) (_ : wcHMPullCanonical Dw) (w₀ : ↥W) (q₀ : ↥(Spec (.of Ω))),
      w w₀ = xb q₀ → Dw.Φ.map (wcSuppUnitMap Dx) ≠ 0 := by
    intro X W Ω _ xb w hw Dx hDx Dw hDw w₀ q₀ h h0
    let Wt : X.ProEt := MorphismProperty.Over.mk ⊤ w hw
    obtain ⟨hc, -, -⟩ := wc_lpsc_site X Wt
    haveI := hc
    obtain ⟨α⟩ := wc_hm_pull_Phi_slice_iso X ℓ Wt Dw hDw
    have hR : (wcSliceRes X ℓ Wt).map (wcSuppUnitMap Dx) = 0 := by
      rw [← NatIso.naturality_1 α (wcSuppUnitMap Dx), h0]
      first
        | exact (congrArg (fun k => α.inv.app _ ≫ k) Limits.zero_comp).trans Limits.comp_zero
        | exact (congrArg (fun k => α.inv.app _ ≫ k)
            (Preadditive.leftComp _ (α.hom.app (wcSuppObj Dx))).map_zero).trans Limits.comp_zero
        | (simp; exact Limits.zero_comp)
    let T₀ : W.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 W) (inferInstance : WeaklyEtale (𝟙 W))
    let V' : X.ProEt := (wcSliceFunctor X Wt).obj T₀
    have h3 : ((wcSliceRes X ℓ Wt).map (wcSuppUnitMap Dx)).val.app (Opposite.op T₀) = 0 := by
      rw [hR, ← SheafOfModules.forget_map, Functor.map_zero, PresheafOfModules.zero_app]
      rfl
    have E1 : ((wcSuppUnitMap Dx).val.app (Opposite.op V')).hom
        (1 : C(↥W, ULift.{u+1} ℚ_[ℓ])) = 0 := by
      change (((wcSliceRes X ℓ Wt).map (wcSuppUnitMap Dx)).val.app (Opposite.op T₀)).hom
        (1 : C(↥W, ULift.{u+1} ℚ_[ℓ])) = 0
      rw [h3]
      rfl
    obtain ⟨u, hu, hsec⟩ := wc_supp_unit_section Dx hDx
    have E2 : u.comp (Limits.pullback.snd V'.hom xb).base.hom = 0 := by
      rw [← hsec V', SheafOfModules.unitHomEquiv_apply_coe]
      exact E1
    have hV' : V'.hom w₀ = xb q₀ := by
      show (𝟙 W ≫ w) w₀ = xb q₀
      rw [Category.id_comp]
      exact h
    obtain ⟨p, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V'.hom) (g := xb) w₀ q₀ hV'
    have E3 : (u ((Limits.pullback.snd V'.hom xb).base.hom p)).down = 0 := by
      have h5 := congrArg (fun f : C(↥(Limits.pullback V'.hom xb), ULift.{u+1} ℚ_[ℓ]) =>
        (f p).down) E2
      exact h5
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have E4 := congrArg (fun f : C(↥(Spec (.of Ω)), ULift.{u+1} ℚ_[ℓ]) =>
      (f ((Limits.pullback.snd V'.hom xb).base.hom p)).down) hv
    change (u ((Limits.pullback.snd V'.hom xb).base.hom p)).down *
      (v ((Limits.pullback.snd V'.hom xb).base.hom p)).down = 1 at E4
    rw [E3, zero_mul] at E4
    exact zero_ne_one E4

  have ha' : WeaklyEtale a' := wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh
  have hw : WeaklyEtale (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _) ha'

  have hax : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨-, -, -, -, -, e', -, he⟩ := hsh
    have hgeom : ∀ z, wcEtGeomPt _ x z = x := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply x _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
        IsLocalRing.closedPoint B :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure
      (((wcProEtPullback D.f).obj V).left.residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'

  have hpt : a' (IsLocalRing.closedPoint B) =
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs :=
    hax.trans hxs.symm
  obtain ⟨w₀, -, hw₀⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hpt
  have hgeom2 : ∀ z, wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs z = xs := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply xs _

  exact key _ _ _ hw Dx hDx Dw hDw w₀ (IsLocalRing.closedPoint _)
    (hw₀.trans (hgeom2 _).symm)

theorem wc_pmn_ldp_shens_punct_supp_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx)
    (Dw : wcHMPullData (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)
    (hDw : wcHMPullCanonical Dw) :
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))
    let R := Dw.Φ.mapDerivedCategory
    let Lb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      (SheafOfModules.unit (wcRingSheaf
        (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))
    let Sb := R.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)))
    let ub : Lb ⟶ Sb :=
      R.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map (wcSuppUnitMap Dx)))
    ∀ (Kp : DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ)))
      (ι : Kp ⟶ Lb) (δ : Sb ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι ub δ ∈ distTriang _ →
      ∀ (k : ℤ) (f : Kp ⟶ Sb⟦k⟧), f = 0 :=
by
  classical
  intro R Lb Sb ub Kp ι δ hT k f
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ℓ))

  have t1 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      {Kp L S : DerivedCategory 𝒞} (ι : Kp ⟶ L) (uu : L ⟶ S) (δ : S ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι uu δ ∈ distTriang _ →
      (∀ g : L ⟶ S, ∃ c : S ⟶ S, g = uu ≫ c) →
      (∀ c : S ⟶ S, uu ≫ c = 0 → c = 0) →
      (∀ k : ℤ, k ≠ 0 → ∀ g : L ⟶ S⟦k⟧, g = 0) →
      (∀ k : ℤ, k ≠ 0 → ∀ c : S ⟶ S⟦k⟧, c = 0) →
      ∀ (k : ℤ) (f : Kp ⟶ S⟦k⟧), f = 0 := by
    intro 𝒞 _ _ _ Kp L S ι uu δ hT hI0 hS0 hL hSS
    have hI : ∀ (k : ℤ) (g : L ⟶ S⟦k⟧), ∃ c : S ⟶ S⟦k⟧, g = uu ≫ c := by
      intro k g
      by_cases hk : k = 0
      · subst hk
        obtain ⟨c₀, hc₀⟩ := hI0 (g ≫ ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).hom)
        refine ⟨c₀ ≫ ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).inv, ?_⟩
        rw [← Category.assoc, ← hc₀, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      · exact ⟨0, by rw [hL k hk g, Limits.comp_zero]⟩
    have hS : ∀ (k : ℤ) (c : S ⟶ S⟦k⟧), uu ≫ c = 0 → c = 0 := by
      intro k c hc
      by_cases hk : k = 0
      · subst hk
        have h1 : c ≫ ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).hom = 0 :=
          hS0 _ (by rw [← Category.assoc, hc, Limits.zero_comp])
        rw [← cancel_mono ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).hom, h1,
          Limits.zero_comp]
      · exact hSS k hk c
    intro k f
    let α := (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 (k + 1) rfl).app S
    have h12 : ι ≫ uu = 0 := Pretriangulated.comp_distTriang_mor_zero₁₂ _ hT
    have h23 : uu ≫ δ = 0 := Pretriangulated.comp_distTriang_mor_zero₂₃ _ hT
    have ha : δ ≫ f⟦(1 : ℤ)⟧' = 0 := by
      have hc := hS (k + 1) (δ ≫ f⟦(1 : ℤ)⟧' ≫ α.inv)
        (by rw [← Category.assoc, h23, Limits.zero_comp])
      have : δ ≫ f⟦(1 : ℤ)⟧' = (δ ≫ f⟦(1 : ℤ)⟧' ≫ α.inv) ≫ α.hom := by
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [this, hc, Limits.zero_comp]
    have hrot := Pretriangulated.rot_of_distTriang _ hT
    obtain ⟨g, hg⟩ : ∃ g : L⟦(1 : ℤ)⟧ ⟶ (S⟦k⟧)⟦(1 : ℤ)⟧, f⟦(1 : ℤ)⟧' = (-(ι⟦(1 : ℤ)⟧')) ≫ g :=
      Pretriangulated.Triangle.yoneda_exact₃ _ hrot (f⟦(1 : ℤ)⟧') ha
    have hg' : f⟦(1 : ℤ)⟧' =
        (ι ≫ (-((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).preimage g)))⟦(1 : ℤ)⟧' := by
      rw [hg, Functor.map_comp, Functor.map_neg, Functor.map_preimage, Preadditive.comp_neg,
        Preadditive.neg_comp]
    have hf : f = ι ≫ (-((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).preimage g)) :=
      (shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map_injective hg'
    obtain ⟨c₁, hc₁⟩ := hI k ((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).preimage g)
    rw [hf, hc₁, Preadditive.comp_neg, ← Category.assoc, h12, Limits.zero_comp, neg_zero]

  have dlem : ∀ {C₁ C₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂] [Abelian C₁]
      [Abelian C₂] {_h1 : HasDerivedCategory.{u+2} C₁} {_h2 : HasDerivedCategory.{u+2} C₂}
      (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F]
      [Limits.PreservesFiniteColimits F] {A B : C₁} (a : A ⟶ B),
      (∀ g : F.obj A ⟶ F.obj B, ∃ c : F.obj B ⟶ F.obj B, g = F.map a ≫ c) →
      (∀ c : F.obj B ⟶ F.obj B, F.map a ≫ c = 0 → c = 0) →
      (∀ g : F.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj A)) ⟶
          F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)),
        ∃ c : F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)) ⟶
            F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)),
          g = F.mapDerivedCategory.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map a)) ≫ c) ∧
      (∀ c : F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)) ⟶
          F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)),
        F.mapDerivedCategory.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map a)) ≫ c = 0 →
