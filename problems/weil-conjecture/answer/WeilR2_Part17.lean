  obtain ⟨Φ1⟩ := wc_hyperbolic_affine_quadric_punct_coh_equiv Ω ℓ hℓp hℓΩ 0 O hOset 1
  obtain ⟨hfin, hcard⟩ := wc_et_punctured_affine_coh_card_le Ω (0 + 1) (by omega) ℓ hℓp hℓΩ O hOset
  obtain ⟨ω, hω⟩ := wc_et_punctured_affine_top_ne_zero Ω ℓ hℓΩ (0 + 1) (by omega) O hOset
  have hO' : Nat.card (wcEtCoh O ℓ 1) = ℓ := S6 _ (2 * (0 + 1) - 1) hfin hcard ⟨ω, hω⟩
