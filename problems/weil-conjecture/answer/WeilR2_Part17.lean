    rw [← hp]
    exact Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv (2 * e + 1) E

theorem wc_hyp_quad_cone_punct_strata : ∀ (K : Type u) [Field K] (e : ℕ) (Oh Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens), (Oh : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} → (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉ y.asIdeal} → ∀ (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens), (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ → ∃ (iZ : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u})) (O' : (Oh : Scheme.{u}).Opens) (eO : (O' : Scheme.{u}) ≅ (Ou : Scheme.{u})) (πy : (Ou : Scheme.{u}) ⟶ (W : Scheme.{u})) (s : (W : Scheme.{u}) ⟶ (Ou : Scheme.{u})), IsClosedImmersion iZ ∧ (O' : Set ↥(Oh : Scheme.{u})) = (Set.range iZ)ᶜ ∧ iZ ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) = W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) ∧ s ≫ πy = 𝟙 _ :=
by
  intro K _ e
  classical
  generalize hMAT : (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) = MAT
  intro Oh Ou hOh hOu W hW
  have horig : ∀ x : Spec (.of (MvPolynomial (Fin (e + 1)) K)), x ∈ Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))) ↔ ∀ i : Fin (e + 1), (MvPolynomial.X i : MvPolynomial (Fin (e + 1)) K) ∈ x.asIdeal := by
    intro x
    constructor
    · rintro ⟨p, rfl⟩ i
      rw [Spec.map_apply]
      change MvPolynomial.constantCoeff (MvPolynomial.X i : MvPolynomial (Fin (e + 1)) K) ∈
        PrimeSpectrum.asIdeal (R := K) p
      rw [MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro h
      have hsurj : Function.Surjective
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K) :=
        fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩
      have hker : ((RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K) :
          Ideal (MvPolynomial (Fin (e + 1)) K)) : Set (MvPolynomial (Fin (e + 1)) K)) ⊆
          (x.asIdeal : Set (MvPolynomial (Fin (e + 1)) K)) := by
        intro q hq
        have hq0 : MvPolynomial.constantCoeff q = 0 := RingHom.mem_ker.mp hq
        have hspan : q ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (e + 1)))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          rw [MvPolynomial.mem_support_iff] at hm
          by_contra hc
          push_neg at hc
          apply hm
          have hm0 : m = 0 := Finsupp.ext (fun i => hc i (Set.mem_univ i))
          rw [hm0]
          exact hq0
        have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (e + 1)))) ≤ x.asIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨i, _, rfl⟩
          exact h i
        exact hle hspan
      have hx : (x : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K)) ∈ Set.range
          (PrimeSpectrum.comap (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K)) := by
        rw [range_comap_of_surjective _ _ hsurj]
        exact (PrimeSpectrum.mem_zeroLocus _ _).mpr hker
      obtain ⟨p, hp⟩ := hx
      exact ⟨p, hp⟩
  have hMATpq : ∀ p q : Fin (2 * e + 1 + 1),
      MAT p q = if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 := by
    intro p q; rw [← hMAT]; rfl
  obtain ⟨half, hhalf⟩ : ∃ h : Fin (2 * e + 1 + 1) → Fin (e + 1), ∀ p, (h p).val = p.val / 2 :=
    ⟨fun p => ⟨p.val / 2, by have := p.isLt; omega⟩, fun p => rfl⟩

  have hSpecI : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B) (y : Spec (.of B)),
      (Spec.map (CommRingCat.ofHom f) y).asIdeal = Ideal.comap f y.asIdeal := by
    intro A B _ _ f y
    rw [Spec.map_apply]
    rfl

  have hkill : ∀ f : MvPolynomial (Fin (2 * e + 1 + 1)) K →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      (∀ p q : Fin (2 * e + 1 + 1), p.val % 2 = 0 → q.val = p.val + 1 →
        f (MvPolynomial.X p) * f (MvPolynomial.X q) = 0) →
      ∀ a ∈ wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT, f a = 0 := by
    intro f hf a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have hQ : f (∑ p, ∑ q, MvPolynomial.C (MAT p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 0) = 0 := by
      rw [map_sub, map_sum, MvPolynomial.C_0, map_zero, sub_zero]
      apply Finset.sum_eq_zero
      intro p _
      rw [map_sum]
      apply Finset.sum_eq_zero
      intro q _
      rw [map_mul, map_mul, MvPolynomial.algHom_C]
      by_cases h : p.val % 2 = 0 ∧ q.val = p.val + 1
      · rw [mul_assoc, hf p q h.1 h.2, mul_zero]
      · simp only [hMATpq, if_neg h, map_zero, zero_mul]
    rw [hQ, mul_zero]
  obtain ⟨ζ, hζx⟩ : ∃ ζ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      ∀ p, ζ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) (MvPolynomial.X p)) =
        if p.val % 2 = 0 then 0 else MvPolynomial.X (half p) := by
    refine ⟨Ideal.Quotient.liftₐ _ (MvPolynomial.aeval fun p : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 then (0 : MvPolynomial (Fin (e + 1)) K) else MvPolynomial.X (half p))
      (hkill _ ?_), ?_⟩
    · intro p q hp _
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, if_pos hp, zero_mul]
    · intro p
      exact (Ideal.Quotient.liftₐ_apply _ _ _ _).trans
        ((Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.aeval_X _ _))
  obtain ⟨σ, hσx⟩ : ∃ σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →ₐ[K] MvPolynomial (Fin (e + 1)) K,
      ∀ p, σ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT) (MvPolynomial.X p)) =
        if p.val % 2 = 0 then MvPolynomial.X (half p) else 0 := by
    refine ⟨Ideal.Quotient.liftₐ _ (MvPolynomial.aeval fun p : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 then MvPolynomial.X (half p) else (0 : MvPolynomial (Fin (e + 1)) K))
      (hkill _ ?_), ?_⟩
    · intro p q hp hq
      have hq2 : ¬ q.val % 2 = 0 := by omega
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, if_neg hq2, mul_zero]
    · intro p
      exact (Ideal.Quotient.liftₐ_apply _ _ _ _).trans
        ((Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.aeval_X _ _))
  obtain ⟨φo, hφo⟩ : ∃ φo : MvPolynomial (Fin (e + 1)) K →ₐ[K] wcQuadModelRing K (2 * e + 1 + 1) 0 MAT,
      ∀ k : Fin (e + 1), φo (MvPolynomial.X k) = Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) :=
    ⟨MvPolynomial.aeval fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))),
      fun k => MvPolynomial.aeval_X _ _⟩
  obtain ⟨φe, hφe⟩ : ∃ φe : MvPolynomial (Fin (e + 1)) K →ₐ[K] wcQuadModelRing K (2 * e + 1 + 1) 0 MAT,
      ∀ k : Fin (e + 1), φe (MvPolynomial.X k) = Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) :=
    ⟨MvPolynomial.aeval fun k : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))),
      fun k => MvPolynomial.aeval_X _ _⟩
  have hζev : ∀ k : Fin (e + 1), ζ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) = 0 := by
    intro k
    rw [hζx]
    split_ifs with h
    · rfl
    · exfalso; revert h; simp only [Fin.val_mk]; omega
  have hζod : ∀ k : Fin (e + 1), ζ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) =
        MvPolynomial.X k := by
    intro k
    rw [hζx]
    split_ifs with h
    · exfalso; revert h; simp only [Fin.val_mk]; omega
    · congr 1
      exact Fin.ext (by rw [hhalf]; simp only [Fin.val_mk]; omega)
  have hσev : ∀ k : Fin (e + 1), σ (Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
      (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))) =
        MvPolynomial.X k := by
    intro k
    rw [hσx]
    split_ifs with h
    · congr 1
      exact Fin.ext (by rw [hhalf]; simp only [Fin.val_mk]; omega)
    · exfalso; revert h; simp only [Fin.val_mk]; omega
  have hζφo : ζ.comp φo = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro k
    rw [AlgHom.comp_apply, hφo, hζod, AlgHom.id_apply]
  have hσφe : σ.comp φe = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro k
    rw [AlgHom.comp_apply, hφe, hσev, AlgHom.id_apply]
  have hζsurj : Function.Surjective ζ :=
    Function.LeftInverse.surjective (g := φo) (fun t => by
      rw [← AlgHom.comp_apply, hζφo, AlgHom.id_apply])

  obtain ⟨j, hjci, hjI, hjstr⟩ : ∃ j : Spec (.of (MvPolynomial (Fin (e + 1)) K)) ⟶
      Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)),
      IsClosedImmersion j ∧
      (∀ x, (j x).asIdeal = Ideal.comap (ζ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        MvPolynomial (Fin (e + 1)) K) x.asIdeal) ∧
      j ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 MAT =
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))) := by
    refine ⟨Spec.map (CommRingCat.ofHom (ζ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        MvPolynomial (Fin (e + 1)) K)), ?_, fun x => hSpecI _ x, ?_⟩
    · apply IsClosedImmersion.spec_of_surjective
      exact hζsurj
    · dsimp only [wcQuadModelStr]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
  haveI := hjci
  have hWj : W = j ⁻¹ᵁ Oh := by
    apply TopologicalSpace.Opens.ext
    ext x
    rw [show x ∈ ((j ⁻¹ᵁ Oh : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens) : Set _) ↔
      j x ∈ (Oh : Set _) from Scheme.Hom.mem_preimage j, hW, hOh, Set.mem_setOf_eq,
      Set.mem_compl_iff, horig, not_forall, hjI]
    constructor
    · rintro ⟨i, hi⟩
      refine ⟨⟨2 * i.val + 1, by have := i.isLt; omega⟩, ?_⟩
      rw [Ideal.mem_comap]
      intro h
      apply hi
      rw [← hζod i]
      exact h
    · rintro ⟨p, hp⟩
      rw [Ideal.mem_comap] at hp
      refine ⟨half p, ?_⟩
      intro h
      apply hp
      change ζ _ ∈ _
      rw [hζx]
      split_ifs with h'
      · exact zero_mem _
      · exact h
  obtain ⟨iZ, hci, hfac⟩ : ∃ iZ : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u}),
      IsClosedImmersion iZ ∧ iZ ≫ Oh.ι = W.ι ≫ j := by
    refine ⟨((Spec (.of (MvPolynomial (Fin (e + 1)) K))).isoOfEq hWj).hom ≫ (j ∣_ Oh),
      inferInstance, ?_⟩
    rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, Scheme.isoOfEq_hom_ι]
  have hpt : ∀ w, Oh.ι (iZ w) = j (W.ι w) := by
    intro w
    have h1 := Scheme.Hom.comp_apply iZ Oh.ι w
    rw [hfac, Scheme.Hom.comp_apply] at h1
    exact h1.symm
  have hrange : ∀ z : (Oh : Scheme.{u}), z ∈ Set.range iZ ↔ ∀ k : Fin (e + 1),
      Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
        (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∈
          (Oh.ι z).asIdeal := by
    intro z
    constructor
    · rintro ⟨w, rfl⟩ k
      rw [hpt, hjI, Ideal.mem_comap]
      change ζ _ ∈ _
      rw [hζev]
      exact zero_mem _
    · intro hz
      have hκ : ∀ r, φo (ζ r) - r ∈ (Oh.ι z).asIdeal := by
        intro r
        have hext : (Ideal.Quotient.mkₐ K (Oh.ι z).asIdeal).comp (φo.comp ζ) =
            Ideal.Quotient.mkₐ K (Oh.ι z).asIdeal := by
          apply Ideal.Quotient.algHom_ext
          apply MvPolynomial.algHom_ext
          intro p
          simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
          rw [hζx]
          by_cases h : p.val % 2 = 0
          · rw [if_pos h, map_zero, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
            have hp : (⟨2 * (half p).val, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
              Fin.ext (by show 2 * (half p).val = p.val; rw [hhalf]; omega)
            have hzk := hz (half p)
            rw [hp] at hzk
            exact hzk
          · rw [if_neg h, hφo]
            have hp : (⟨2 * (half p).val + 1, by have := (half p).isLt; omega⟩ : Fin (2 * e + 1 + 1)) = p :=
              Fin.ext (by show 2 * (half p).val + 1 = p.val; rw [hhalf]; omega)
            rw [hp]
        have h2 := AlgHom.congr_fun hext r
        simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h2
        exact Ideal.Quotient.eq.mp h2
      have hx : j (Spec.map (CommRingCat.ofHom (φo : MvPolynomial (Fin (e + 1)) K →+*
          wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) (Oh.ι z)) = Oh.ι z := by
        apply PrimeSpectrum.ext
        rw [hjI, hSpecI]
        ext r
        rw [Ideal.mem_comap, Ideal.mem_comap]
        change φo (ζ r) ∈ _ ↔ _
        constructor
        · intro h
          simpa using sub_mem h (hκ r)
        · intro h
          simpa using add_mem (hκ r) h
      have hxW : Spec.map (CommRingCat.ofHom (φo : MvPolynomial (Fin (e + 1)) K →+*
          wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) (Oh.ι z) ∈ Set.range W.ι := by
        rw [Scheme.Opens.range_ι, hWj, SetLike.mem_coe,
          Scheme.Hom.mem_preimage, hx, ← SetLike.mem_coe, ← Scheme.Opens.range_ι]
        exact ⟨z, rfl⟩
      obtain ⟨w, hw⟩ := hxW
      refine ⟨w, ?_⟩
      apply Oh.ι.isOpenEmbedding.injective
      rw [hpt, hw]
      exact hx

  have hOuOh : ∀ y, y ∈ (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)))) →
      y ∈ (Oh : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)))) := by
    intro y hy
    rw [hOu] at hy
    rw [hOh]
    obtain ⟨k, hk⟩ := hy
    exact ⟨_, hk⟩
  have hR : Set.range (((Oh.ι ⁻¹ᵁ Ou : (Oh : Scheme.{u}).Opens)).ι ≫ Oh.ι) = Set.range Ou.ι := by
    rw [Scheme.Opens.range_ι]
    ext y
    constructor
    · rintro ⟨w, rfl⟩
      rw [Scheme.Hom.comp_apply]
      have hw : (Oh.ι ⁻¹ᵁ Ou).ι w ∈ ((Oh.ι ⁻¹ᵁ Ou : (Oh : Scheme.{u}).Opens) : Set _) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨w, rfl⟩
      exact (Scheme.Hom.mem_preimage _).mp hw
    · intro hy
      have hy' := hOuOh y hy
      rw [← Scheme.Opens.range_ι Oh] at hy'
      obtain ⟨z, rfl⟩ := hy'
      have hz : z ∈ ((Oh.ι ⁻¹ᵁ Ou : (Oh : Scheme.{u}).Opens) : Set _) :=
        (Scheme.Hom.mem_preimage _).mpr hy
      rw [← Scheme.Opens.range_ι] at hz
      obtain ⟨w, rfl⟩ := hz
      exact ⟨w, Scheme.Hom.comp_apply _ _ w⟩

  have hSP : Spec.map (CommRingCat.ofHom (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        MvPolynomial (Fin (e + 1)) K)) ≫
      Spec.map (CommRingCat.ofHom (φe : MvPolynomial (Fin (e + 1)) K →+*
        wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+* MvPolynomial (Fin (e + 1)) K).comp
        (φe : MvPolynomial (Fin (e + 1)) K →+* wcQuadModelRing K (2 * e + 1 + 1) 0 MAT) =
        RingHom.id _ :=
      RingHom.ext fun t => AlgHom.congr_fun hσφe t
    rw [h1, CommRingCat.ofHom_id, Spec.map_id]
  have hP : Ou ≤ Spec.map (CommRingCat.ofHom (φe : MvPolynomial (Fin (e + 1)) K →+*
        wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) ⁻¹ᵁ W := by
    intro y hy
    have hy' : y ∈ (Ou : Set _) := hy
    rw [hOu] at hy'
    obtain ⟨k, hk⟩ := hy'
    rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, hW, Set.mem_compl_iff,
      horig, not_forall]
    refine ⟨k, ?_⟩
    rw [hSpecI, Ideal.mem_comap]
    intro h
    apply hk
    rw [← hφe]
    exact h
  have hS : W ≤ Spec.map (CommRingCat.ofHom (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
        MvPolynomial (Fin (e + 1)) K)) ⁻¹ᵁ Ou := by
    intro x hx
    have hx' : x ∈ (W : Set _) := hx
    rw [hW, Set.mem_compl_iff, horig, not_forall] at hx'
    obtain ⟨i, hi⟩ := hx'
    rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, hOu]
    refine ⟨i, ?_⟩
    rw [hSpecI, Ideal.mem_comap]
    intro h
    apply hi
    rw [← hσev i]
    exact h
  refine ⟨iZ, Oh.ι ⁻¹ᵁ Ou, IsOpenImmersion.isoOfRangeEq _ Ou.ι hR,
    Scheme.Hom.resLE _ W Ou hP, Scheme.Hom.resLE _ Ou W hS, hci, ?_, ?_, ?_⟩
  · ext z
    rw [Set.mem_compl_iff, hrange z, not_forall]
    rw [show z ∈ ((Oh.ι ⁻¹ᵁ Ou : (Oh : Scheme.{u}).Opens) : Set _) ↔
      Oh.ι z ∈ (Ou : Set _) from Scheme.Hom.mem_preimage _, hOu]
    exact Iff.rfl
  · rw [← Category.assoc, hfac, Category.assoc, hjstr]
  · rw [← cancel_mono W.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
      Scheme.Hom.resLE_comp_ι, Category.assoc, hSP, Category.comp_id, Category.id_comp]

theorem wc_hyp_quad_cone_even_open_coh_equiv : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (e : ℕ) (Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens), (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉ y.asIdeal} → ∀ (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens), (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ → ∀ q : ℕ, Nonempty (wcEtCoh (Ou : Scheme.{u}) ℓ q ≃ wcEtCoh (W : Scheme.{u}) ℓ q) :=
by
  intro K _ _ ℓ _ hℓ e Ou hOu W hW q
  classical

  obtain ⟨φe, hφe⟩ : ∃ f : MvPolynomial (Fin (e + 1)) K →+* MvPolynomial (Fin (2 * e + 1 + 1)) K ⧸ wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0), f = (MvPolynomial.aeval (R := K) (fun j : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (2 * e + 1 + 1))))).toRingHom := ⟨_, rfl⟩



  have hs3 : ∀ k : Fin (e + 1), ∃ Ψ : TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K)) (MvPolynomial (Fin e) K) ≃+* Localization.Away (φe (MvPolynomial.X k)), Ψ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom = Localization.awayMap φe (MvPolynomial.X k) := by
    intro k
    subst hφe
    classical
    have C0 : ∀ (A : Type u) [CommRing A] (v : Fin (2 * e + 1 + 1) → A),
        ∑ p : Fin (2 * e + 1 + 1), ∑ q : Fin (2 * e + 1 + 1),
          (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) * v p * v q =
        ∑ j : Fin (e + 1), v ⟨2 * j.val, by omega⟩ * v ⟨2 * j.val + 1, by omega⟩ := by
      intro A _ v
      symm
      refine Fintype.sum_of_injective (fun j : Fin (e + 1) => (⟨2 * j.val, by omega⟩ : Fin (2 * e + 1 + 1)))
        ?_ _ _ ?_ ?_
      · intro a b hab
        have := congrArg Fin.val hab
        simp only at this
        exact Fin.ext (by omega)
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have hpodd : ¬ (p.val % 2 = 0) := by
          intro h
          exact hp ⟨⟨p.val / 2, by omega⟩, Fin.ext (by simp only; omega)⟩
        simp [hpodd]
      · intro j
        rw [Fintype.sum_eq_single (⟨2 * j.val + 1, by omega⟩ : Fin (2 * e + 1 + 1))]
        · simp
        · intro q hq
          have hq' : ¬ (q.val = 2 * j.val + 1) := fun h => hq (Fin.ext h)
          simp [hq']
    have hQ : (∑ p : Fin (2 * e + 1 + 1), ∑ q : Fin (2 * e + 1 + 1), MvPolynomial.C ((Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (2 * e + 1 + 1)) K) = ∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ := by
      refine Eq.trans ?_ (C0 _ (fun p => MvPolynomial.X p))
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
      simp only [Matrix.of_apply]
      split_ifs <;> simp
    set I := wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) with hI
    have hgen : (∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ - MvPolynomial.C 0 : MvPolynomial (Fin (2 * e + 1 + 1)) K) ∈ I := by
      rw [← hQ]
      exact Ideal.subset_span rfl
    have hrel : ∑ j : Fin (e + 1), Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val, by omega⟩) * Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val + 1, by omega⟩) = 0 := by
      have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr hgen
      rw [map_sub, sub_eq_zero, map_sum, MvPolynomial.C_0, map_zero] at h0
      simpa only [map_mul] using h0
    set φ : MvPolynomial (Fin (e + 1)) K →+* MvPolynomial (Fin (2 * e + 1 + 1)) K ⧸ I := (MvPolynomial.aeval (R := K) (fun j : Fin (e + 1) => Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (2 * e + 1 + 1))))).toRingHom with hφ
    have hφX : ∀ j : Fin (e + 1), φ (MvPolynomial.X j) = Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val, by omega⟩) := by
      intro j
      simp [hφ]
    have hφC : ∀ c : K, φ (MvPolynomial.C c) = algebraMap K _ c := by
      intro c
      simp [hφ]

    set fL : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K) →+* Localization.Away (φ (MvPolynomial.X k)) := Localization.awayMap φ (MvPolynomial.X k) with hfL
    have hfL_alg : ∀ a, fL (algebraMap _ _ a) = algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (φ a) := by
      intro a
      exact IsLocalization.map_eq _ _
    have hRkΩ : ∀ c : K, algebraMap (MvPolynomial (Fin (2 * e + 1 + 1)) K ⧸ I) (Localization.Away (φ (MvPolynomial.X k))) (algebraMap K _ c) = algebraMap K (Localization.Away (φ (MvPolynomial.X k))) c := by
      intro c
      exact (IsScalarTower.algebraMap_apply K _ _ c).symm
    let fA : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) K) →ₐ[K] Localization.Away (φ (MvPolynomial.X k)) :=
      { fL with
        commutes' := fun c => by
          show fL (algebraMap K _ c) = _
