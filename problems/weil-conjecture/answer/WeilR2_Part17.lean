    let Ψ := (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj Ψ)⟦((n - 1 : ℕ) : ℤ) + 1⟧, f = 0 :=
by
  have keyAll : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
      {_hD : HasDerivedCategory.{u+2} 𝒞}
      (N : ℤ) (One Sx : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (eΨ : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One ⟶ Ψ),
      Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦N⟧ ≅
        DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx)) →
      (∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx))⟦(1 : ℤ)⟧, f = 0) →
      (∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One))⟦N + 1⟧,
          a ≠ 0 → ∃ c : Sx ⟶ Sx,
            w = DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ a) →
      (∀ r : DerivedCategory.Q.obj Ψ ⟶
          DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One),
          DerivedCategory.Q.map eΨ ≫ r ≠ 𝟙 _) →
      ∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx) ⟶
          (DerivedCategory.Q.obj Ψ)⟦N + 1⟧, f = 0 := by
    intro 𝒞 _ _ _ N One Sx Ψ eΨ hσ H2 H3 H4
    have core : ∀ (T : Pretriangulated.Triangle (DerivedCategory 𝒞)) (S0 : DerivedCategory 𝒞),
        T ∈ distTriang (DerivedCategory 𝒞) →
        Nonempty (T.obj₃⟦N⟧ ≅ S0) →
        (∀ f : S0 ⟶ S0⟦(1 : ℤ)⟧, f = 0) →
        (∀ a w : S0 ⟶ T.obj₁⟦N + 1⟧, a ≠ 0 → ∃ c : S0 ⟶ S0, w = c ≫ a) →
        (∀ r : T.obj₂ ⟶ T.obj₁, T.mor₁ ≫ r ≠ 𝟙 _) →
        ∀ f : S0 ⟶ T.obj₂⟦N + 1⟧, f = 0 := by
      intro T S0 hT hσ' H2' H3' H4'
      obtain ⟨σ⟩ := hσ'

      have k1 : T.mor₃ ≠ 0 := by
        intro h0
        obtain ⟨e, he1, _⟩ := Pretriangulated.exists_iso_binaryBiproduct_of_distTriang T hT h0
        apply H4' (e.hom ≫ Limits.biprod.fst)
        rw [← Category.assoc, he1, Limits.biprod.inl_fst]

      let θ : S0 ⟶ (T.obj₁⟦(1 : ℤ)⟧)⟦N⟧ := σ.inv ≫ T.mor₃⟦N⟧'
      have hθ : θ ≠ 0 := by
        intro h0
        apply k1
        apply (shiftFunctor (DerivedCategory 𝒞) N).map_injective
        rw [Functor.map_zero]
        have : T.mor₃⟦N⟧' = σ.hom ≫ θ := by
          show _ = σ.hom ≫ σ.inv ≫ _
          rw [Iso.hom_inv_id_assoc]
        rw [this, h0, Limits.comp_zero]

      have k3 : θ ≫ (T.mor₁⟦(1 : ℤ)⟧')⟦N⟧' = 0 := by
        show (σ.inv ≫ _) ≫ _ = 0
        rw [Category.assoc, ← Functor.map_comp, Pretriangulated.comp_distTriang_mor_zero₃₁ T hT,
          Functor.map_zero, Limits.comp_zero]

      have hadd : (1 : ℤ) + N = N + 1 := add_comm 1 N
      let β := fun Z : DerivedCategory 𝒞 =>
        (shiftFunctorAdd' (DerivedCategory 𝒞) (1 : ℤ) N (N + 1) hadd).app Z
      let θ₀ : S0 ⟶ T.obj₁⟦N + 1⟧ := θ ≫ (β T.obj₁).inv
      have hθ₀ : θ₀ ≠ 0 := by
        intro h0
        apply hθ
        have : θ = θ₀ ≫ (β T.obj₁).hom := by
          show _ = (θ ≫ _) ≫ _
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [this, h0, Limits.zero_comp]
      have hnat : (T.mor₁⟦(1 : ℤ)⟧')⟦N⟧' ≫ (β T.obj₂).inv = (β T.obj₁).inv ≫ T.mor₁⟦N + 1⟧' :=
        (shiftFunctorAdd' (DerivedCategory 𝒞) (1 : ℤ) N (N + 1) hadd).inv.naturality T.mor₁
      have k4 : θ₀ ≫ T.mor₁⟦N + 1⟧' = 0 := by
        show (θ ≫ (β T.obj₁).inv) ≫ _ = 0
        rw [Category.assoc, ← hnat, ← Category.assoc, k3, Limits.zero_comp]

      have hT' : Pretriangulated.Triangle.mk ((N + 1).negOnePow • T.mor₁⟦N + 1⟧')
          ((N + 1).negOnePow • T.mor₂⟦N + 1⟧')
          ((N + 1).negOnePow • (T.mor₃⟦N + 1⟧' ≫
            (shiftFunctorComm (DerivedCategory 𝒞) 1 (N + 1)).hom.app T.obj₁)) ∈
          distTriang (DerivedCategory 𝒞) :=
        Pretriangulated.Triangle.shift_distinguished T hT (N + 1)
      intro f
      have hf2 : f ≫ T.mor₂⟦N + 1⟧' = 0 := by
        let γ := (shiftFunctorAdd' (DerivedCategory 𝒞) N 1 (N + 1) rfl).app T.obj₃
        have hv := H2' (f ≫ T.mor₂⟦N + 1⟧' ≫ γ.hom ≫ σ.hom⟦(1 : ℤ)⟧')
        have : f ≫ T.mor₂⟦N + 1⟧' =
            (f ≫ T.mor₂⟦N + 1⟧' ≫ γ.hom ≫ σ.hom⟦(1 : ℤ)⟧') ≫ σ.inv⟦(1 : ℤ)⟧' ≫ γ.inv := by
          simp only [Category.assoc, Iso.map_hom_inv_id_assoc, Iso.hom_inv_id, Category.comp_id]
        rw [this, hv, Limits.zero_comp]
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT' f (by
        change f ≫ ((N + 1).negOnePow • T.mor₂⟦N + 1⟧') = 0
        rw [Units.smul_def, Preadditive.comp_zsmul, hf2, smul_zero])
      change f = g ≫ ((N + 1).negOnePow • T.mor₁⟦N + 1⟧') at hg

      obtain ⟨c, hc⟩ := H3' θ₀ g hθ₀
      rw [hg, hc, Units.smul_def, Preadditive.comp_zsmul, Category.assoc, k4, Limits.comp_zero,
        smul_zero]
    exact core (DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle eΨ))
      (DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Sx))
      (DerivedCategory.mappingCone_triangle_distinguished eΨ) hσ H2
      (fun a w ha => by
        obtain ⟨c, hc⟩ := H3 a w ha
        exact ⟨_, hc⟩) H4
  exact keyAll _ _ _ _ _
    (wc_pmn_tsl_cone_point_iso F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
      x hx₁ hx₂ Dp hDp Di hDi I xs hxs Dx hDx)
    (fun f => wc_pmn_tsl_point_self_ext_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂
      xs hxs Dx hDx 1 one_pos f)
    (wc_pmn_sfu_lam_supp_succ_line F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂ xs hxs
      Dx hDx h4)
    (wc_pmn_sfu_psi_no_retraction F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
      x hx₁ hx₂ Dp hDp Di hDi I xs hxs h4)

theorem wc_free_coker_ladic_nonzero_of_counts (S : Scheme.{u}) [CompactSpace S] [IsLocallyNoetherian S]
    (O : S.Opens) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ)
    (hfin1 : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) N))
    (hcard1 : Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) N) ≤ ℓ)
    (hvan : ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) (N + 1), z = 0)
    (hge : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S (ℓ ^ k)) N) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S (ℓ ^ k)) N)) :
    ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcLadicSheaf S ℓ) N, y ≠ 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hℓp.pos



  have nsmul_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c) (m : ℕ), (m • α).comp β h = m • α.comp β h := by
    intro X Y Z a b c α β h m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ m ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have comp_nsmul : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c) (m : ℕ), α.comp (m • β) h = m • α.comp β h := by
    intro X Y Z a b c α β h m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.comp_zero]
    | succ m ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have sub_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α α' : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c), (α - α').comp β h = α.comp β h - α'.comp β h := by
    intro X Y Z a b c α α' β h
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
  have comp_sub : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β β' : Abelian.Ext Y Z b)
      (h : a + b = c), α.comp (β - β') h = α.comp β h - α.comp β' h := by
    intro X Y Z a b c α β β' h
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]



  have htors : ∀ (U V : S.ProEt) (φ : V ⟶ U) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
      [CompactSpace V.left] [QuasiSeparatedSpace V.left], Mono (wcFreeSheafMap S φ) →
      ∀ (i : ℕ) (y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S φ)) (wcIntSheaf S ℓ) i),
        y.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i) = 0 → ∃ r : ℕ, ℓ ^ r • y = 0 := by
    intro U V φ _ _ _ _ hmono i y hy
    have hS₀ : (ShortComplex.mk (wcFreeSheafMap S φ) (Limits.cokernel.π (wcFreeSheafMap S φ))
        (Limits.cokernel.condition (wcFreeSheafMap S φ))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (wcFreeSheafMap S φ)) hmono
        inferInstance
    have h1 : ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S φ))).comp y
        (zero_add i)).comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i) = 0 := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hy, Abelian.Ext.comp_zero]
    obtain ⟨a, ha⟩ := (proet_qcqs_ladic_rationalization S U ℓ i).2 _ h1
    have ha' : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S φ))).comp (ℓ ^ a • y)
        (zero_add i) = 0 := by
      rw [comp_nsmul]; exact ha
    cases i with
    | zero =>
      refine ⟨a, ?_⟩
      have hinj := Abelian.Ext.precomp_mk₀_injective_of_epi (wcIntSheaf S ℓ)
        (Limits.cokernel.π (wcFreeSheafMap S φ))
      apply hinj
      rw [map_zero]
      exact ha'
    | succ i₀ =>
      obtain ⟨w, hw⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ (wcIntSheaf S ℓ)
        (ℓ ^ a • y) ha' (show 1 + i₀ = i₀ + 1 by omega)
      have hw' : hS₀.extClass.comp w (show 1 + i₀ = i₀ + 1 by omega) = ℓ ^ a • y := hw
      have hδrat : hS₀.extClass.comp (w.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i₀))
          (show 1 + i₀ = i₀ + 1 by omega) = 0 := by
        rw [← Abelian.Ext.comp_assoc_of_third_deg_zero, hw', nsmul_comp, hy, smul_zero]
      obtain ⟨vQ, hvQ⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS₀ (wcLadicSheaf S ℓ) _
        (show 1 + i₀ = i₀ + 1 by omega) hδrat
      have hvQ' : (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp vQ (zero_add i₀) =
          w.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i₀) := hvQ
      obtain ⟨b, v, hv⟩ := (proet_qcqs_ladic_rationalization S U ℓ i₀).1 vQ
      have ht : (ℓ ^ b • w - (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp v (zero_add i₀)).comp
          (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i₀) = 0 := by
        rw [sub_comp, nsmul_comp, Abelian.Ext.comp_assoc_of_third_deg_zero, ← hv, comp_nsmul,
          hvQ', sub_self]
      obtain ⟨c, hc⟩ := (proet_qcqs_ladic_rationalization S V ℓ i₀).2 _ ht
      have hEf : hS₀.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)) (add_zero 1) = 0 :=
        hS₀.extClass_comp
      have hext0 : hS₀.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp v
          (zero_add i₀)) (show 1 + i₀ = i₀ + 1 by omega) = 0 := by
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hEf, Abelian.Ext.zero_comp]
      have key : ℓ ^ (c + b + a) • y =
          hS₀.extClass.comp (ℓ ^ c • (ℓ ^ b • w -
            (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp v (zero_add i₀)))
            (show 1 + i₀ = i₀ + 1 by omega) +
          ℓ ^ c • hS₀.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp v
            (zero_add i₀)) (show 1 + i₀ = i₀ + 1 by omega) := by
        rw [comp_nsmul, comp_sub, comp_nsmul, hw', ← smul_add, sub_add_cancel, smul_smul,
          smul_smul, ← pow_add, ← pow_add]
      refine ⟨c + b + a, ?_⟩
      rw [hc, Abelian.Ext.comp_zero, hext0, smul_zero, add_zero] at key
      exact key



  set P := Limits.cokernel (wcFreeSheafMap S
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) with hP
  obtain ⟨hcnt, hsN, -⟩ := wc_local_tower_counts S ℓ P N hfin1 hcard1 hvan hge
  have hkill : ∀ (n : ℕ) (t : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N), ℓ ^ n • t = 0 := by
    intro n t
    have hc' : Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) = ℓ ^ n := (hcnt n).2
    have h := card_nsmul_eq_zero' (G := Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) (x := t)
    rw [hc'] at h
    exact h
  have hcyc := wc_zmod_local_nakayama_cyclic S ℓ P N hfin1 hcard1 hvan hkill
  obtain ⟨g, hg1, hg2, hg3⟩ := ladic_tower_compatible_generators ℓ
    (fun n => Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N)
    (fun n => (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
      continuous_of_discreteTopology)).postcomp P (add_zero N))
    hcnt hcyc (fun n t => hsN n t)
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := by
    intro k
    show Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) k x)
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro x hx
    have hℓ' : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓpos
    refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ' _, fun y hy => ?_⟩
    have e1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
      rw [Metric.mem_ball, dist_eq_norm] at hy
      exact hy.le
    have e2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) k).mp e1
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at e2
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
    rw [e2]
    exact hx
  have hg1' : ∀ k : ℕ, (g (k + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ k)
      continuous_of_discreteTopology)) (add_zero N) = g k := by
    intro k
    have h := hg1 k
    simpa only [Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
      Abelian.Ext.bilinearComp_apply_apply] using h



  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl
  have hc2 : ∀ {A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (x : Abelian.Ext A B p) (f : B ⟶ C) (h : C ⟶ D),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ h) (add_zero p) =
        x.comp (Abelian.Ext.mk₀ (f ≫ h)) (add_zero p) := by
    intro A B C D p x f h
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have hsubmk : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (α : Abelian.Ext A B p) (β₁ β₂ : Abelian.Ext B C 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A B C p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  obtain ⟨hci, hemb, hcs, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact S (wcTowerIncl ℓ) hci
    (wcTowerShift ℓ) hcs hemb hker hsec
  haveI := wc_proet_products_exact S
  have hY := (wc_contSheaf_pi_isLimit S (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun M => wc_ext_prod_bijective P
    (wcContSheaf S ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf S (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY M
  have hTn : ∀ n, wcContSheafMap S (wcTowerShift ℓ) hcs ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub S (wcTowerShift ℓ) (wcTowerShift ℓ) hcs
      hcs (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
  have hredk : ∀ k, wcContSheafMap S (wcTowerIncl ℓ) hci ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k) =
      wcContSheafMap S (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k) := by
    intro k
    rw [← (wc_contSheafMap_comp_sub S (wcTowerIncl ℓ) (wcTowerIncl ℓ) hci hci
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k)).1]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
  obtain ⟨G, hG⟩ := (hprod N).2 g
  have hGs : G.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcs)) (add_zero N) = 0 := by
    apply (hprod N).1
    intro n
    rw [hc2, hTn n, hsubmk, hcompsub, ← hc2, hG, hG, hg1', sub_self]
  obtain ⟨xI, hxI0⟩ : ∃ x : Abelian.Ext P (wcContSheaf S ℤ_[ℓ]) N,
      x.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerIncl ℓ) hci)) (add_zero N) = G :=
    Abelian.Ext.covariant_sequence_exact₂ P hS2 G hGs
  have hxI : ∀ k, xI.comp (Abelian.Ext.mk₀ (wcContSheafMap S
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero N) = g k := by
    intro k
    rw [← hredk k, ← hc2, hxI0, hG]



  have hnt : ∀ r : ℕ, ℓ ^ r • xI ≠ 0 := by
    intro r hr
    have hlin : ∀ c : ℕ, (c • xI).comp (Abelian.Ext.mk₀ (wcContSheafMap S
        (PadicInt.toZModPow (p := ℓ) (r + 1)).toAddMonoidHom (hc (r + 1)))) (add_zero N) =
        c • g (r + 1) := by
      intro c
      induction c with
      | zero =>
        rw [zero_smul, zero_smul, Abelian.Ext.zero_comp]
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih, hxI]
    have h0 := hlin (ℓ ^ r)
    rw [hr, Abelian.Ext.zero_comp] at h0
    have h0z : (ℓ ^ r) • g (r + 1) = 0 := h0.symm
    have h0' : ((ℓ ^ r : ℕ) : ℤ) • g (r + 1) = 0 := by rw [natCast_zsmul]; exact h0z
    have hdvd := hg3 (r + 1) _ h0'
    have hdvd' : ℓ ^ (r + 1) ∣ ℓ ^ r := by exact_mod_cast hdvd
    have hle := Nat.le_of_dvd (pow_pos hℓpos r) hdvd'
    have hlt : ℓ ^ r < ℓ ^ (r + 1) := Nat.pow_lt_pow_right hℓp.one_lt (Nat.lt_succ_self r)
    omega



  haveI hXc : CompactSpace S := inferInstance
  haveI hXqs : QuasiSeparatedSpace S := IsLocallyNoetherian.quasiSeparatedSpace
  haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
  haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace
  have hmono := wc_free_sheaf_map_mono S _ _
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) (IsOpenImmersion.mono O.ι)
  refine ⟨xI.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero N), fun h0 => ?_⟩
  obtain ⟨r, hr⟩ := @htors (Scheme.ProEt.mk (𝟙 S)) (Scheme.ProEt.mk O.ι)
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) hXc hXqs hOc hOqs hmono N xI h0
  exact hnt r hr

theorem wc_lup_quad_cone_vertex (K : Type u) [Field K] (n : ℕ) (c : Matrix (Fin n) (Fin n) K) :
    (∀ y y' : Spec (.of (wcQuadModelRing K n 0 c)),
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ y.asIdeal) →
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ y'.asIdeal) →
      y = y') ∧
    ∃ v₀ : Spec (.of K) ⟶ Spec (.of (wcQuadModelRing K n 0 c)),
      v₀ ≫ wcQuadModelStr K n 0 c = 𝟙 _ ∧
      ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈
        (v₀ (IsLocalRing.closedPoint K)).asIdeal :=
by
  classical
  have hG : wcQuadModelIdeal K n 0 c ≤
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K) := by
    unfold wcQuadModelIdeal
    rw [Ideal.span_le, Set.singleton_subset_iff]
    simp [RingHom.mem_ker]
  let ev : wcQuadModelRing K n 0 c →+* K :=
    Ideal.Quotient.lift (wcQuadModelIdeal K n 0 c) MvPolynomial.constantCoeff
      (fun a ha => hG ha)
  have hev : ∀ h : MvPolynomial (Fin n) K,
      ev (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) h) = MvPolynomial.constantCoeff h :=
    fun h => Ideal.Quotient.lift_mk _ _ _
  have hsec : ev.comp (algebraMap K (wcQuadModelRing K n 0 c)) = RingHom.id K := by
    ext a
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [← Ideal.Quotient.mk_algebraMap, hev, MvPolynomial.algebraMap_eq,
      MvPolynomial.constantCoeff_C]
  have hX : ∀ p, ev (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p)) = 0 := by
    intro p
    rw [hev, MvPolynomial.constantCoeff_X]
  have hsurj : Function.Surjective ev := fun a =>
    ⟨algebraMap K _ a, by
      have := congrArg (fun f => f a) hsec
      simpa using this⟩
  have hmax : (RingHom.ker ev).IsMaximal := RingHom.ker_isMaximal_of_surjective ev hsurj
  have hle : ∀ y : PrimeSpectrum (wcQuadModelRing K n 0 c),
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ y.asIdeal) →
      RingHom.ker ev = y.asIdeal := by
    intro y hy
    apply hmax.eq_of_le y.isPrime.ne_top
    intro r hr
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [RingHom.mem_ker, hev] at hr
    have h1 : h ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin n))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hcon
      push_neg at hcon
      have hm0 : m = 0 := by
        ext i
        simpa using hcon i (Set.mem_univ i)
      rw [hm0, MvPolynomial.mem_support_iff, ← MvPolynomial.constantCoeff_eq] at hm
      exact hm hr
    have h2 : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin n))) ≤
        Ideal.comap (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c)) y.asIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨p, -, rfl⟩
      exact hy p
    exact h2 h1
  refine ⟨fun y y' hy hy' => ?_, Spec.map (CommRingCat.ofHom ev), ?_, ?_⟩
  · apply PrimeSpectrum.ext
    rw [← hle y hy, ← hle y' hy']
  · unfold wcQuadModelStr
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hsec, CommRingCat.ofHom_id, Spec.map_id]
  · intro p
    have hpt : ev (Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p)) ∈
        (IsLocalRing.closedPoint K).asIdeal := by
      rw [hX]; exact zero_mem _
    exact hpt

theorem wc_lup_two_sided_point_excision_ext (K : Type u) [Field K] [IsAlgClosed K]
    {X C W : Scheme.{u}} [IsLocallyNoetherian X] [IsLocallyNoetherian C]
    (pX : X ⟶ Spec (.of K)) (pC : C ⟶ Spec (.of K)) (a : W ⟶ X) (b : W ⟶ C) [Etale a] [Etale b]
    (x₀ : Spec (.of K) ⟶ X) (c₀ : Spec (.of K) ⟶ C) (hx₀ : x₀ ≫ pX = 𝟙 _) (hc₀ : c₀ ≫ pC = 𝟙 _)
    (w₀ : W) (ha : a w₀ = x₀ (IsLocalRing.closedPoint K)) (hb : b w₀ = c₀ (IsLocalRing.closedPoint K))
    (OX : X.Opens) (hOX : (OX : Set X) = {x₀ (IsLocalRing.closedPoint K)}ᶜ)
    (OC : C.Opens) (hOC : (OC : Set C) = {c₀ (IsLocalRing.closedPoint K)}ᶜ) (m i : ℕ) :
    Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X
        (MorphismProperty.Over.homMk OX.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk OX.ι ⟶ Scheme.ProEt.mk (𝟙 X)))) (wcZModSheaf X m) i ≃
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap C
        (MorphismProperty.Over.homMk OC.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk OC.ι ⟶ Scheme.ProEt.mk (𝟙 C)))) (wcZModSheaf C m) i) :=
by
  classical

  have s1 : ∀ {Y T : Scheme.{u}} [IsLocallyNoetherian Y] [CompactSpace T]
      (pY : Y ⟶ Spec (.of K)) (g : T ⟶ Y) [Etale g]
      (y₀ : Spec (.of K) ⟶ Y) (_hy₀ : y₀ ≫ pY = 𝟙 _)
      (t₀ : T) (_ht₀ : g t₀ = y₀ (IsLocalRing.closedPoint K))
      (_huniq : ∀ t : T, g t = y₀ (IsLocalRing.closedPoint K) → t = t₀)
      (OY : Y.Opens) (_hOY : (OY : Set Y) = {y₀ (IsLocalRing.closedPoint K)}ᶜ)
      (OT : T.Opens) (_hOT : (OT : Set T) = {t₀}ᶜ),
      Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
          (MorphismProperty.Over.homMk OY.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk OY.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y m) i ≃
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap T
          (MorphismProperty.Over.homMk OT.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk OT.ι ⟶ Scheme.ProEt.mk (𝟙 T)))) (wcZModSheaf T m) i) := by
    intro Y T _ _ pY g _ y₀ hy₀ t₀ ht₀ huniq OY hOY OT hOT
    have hle : OT ≤ g ⁻¹ᵁ OY := by
      intro t ht
      have ht' : t ∈ (OT : Set T) := ht
      rw [hOT] at ht'
      rw [Scheme.Hom.mem_preimage]
      show g t ∈ (OY : Set Y)
      rw [hOY]
      intro hgt
      exact ht' (huniq t hgt)
    let U : Y.ProEt := Scheme.ProEt.mk (𝟙 Y)
    let V : Y.ProEt := Scheme.ProEt.mk OY.ι
    let T' : Y.ProEt := Scheme.ProEt.mk g
    let VT : Y.ProEt := Scheme.ProEt.mk (OT.ι ≫ g)
    let ι : V ⟶ U := MorphismProperty.Over.homMk OY.ι (Category.comp_id _) trivial
    let g' : T' ⟶ U := MorphismProperty.Over.homMk g (Category.comp_id _) trivial
    let j : VT ⟶ T' := MorphismProperty.Over.homMk OT.ι rfl trivial
    let gV : VT ⟶ V := MorphismProperty.Over.homMk (g.resLE OY OT hle)
      (Scheme.Hom.resLE_comp_ι g hle) trivial
    have hι : IsOpenImmersion ι.left := (inferInstance : IsOpenImmersion OY.ι)
    have hr : Set.range ι.left = {y₀ (IsLocalRing.closedPoint K)}ᶜ := by
      show Set.range OY.ι = _
      rw [Scheme.Opens.range_ι]
      exact hOY
    have hj : IsOpenImmersion j.left := (inferInstance : IsOpenImmersion OT.ι)
    have hrj : Set.range j.left = g'.left ⁻¹' {y₀ (IsLocalRing.closedPoint K)}ᶜ := by
      show Set.range OT.ι = g ⁻¹' {y₀ (IsLocalRing.closedPoint K)}ᶜ
      rw [Scheme.Opens.range_ι, hOT]
      ext t
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · intro h hgt
        exact h (huniq t hgt)
      · rintro h rfl
        exact h ht₀
    have hgV : gV ≫ ι = j ≫ g' := by
      apply MorphismProperty.Over.Hom.ext
      exact Scheme.Hom.resLE_comp_ι g hle
    have hfib : IsIso (Limits.pullback.snd g'.left
        (U.left.fromSpecResidueField (y₀ (IsLocalRing.closedPoint K)))) :=
      wc_glc_etale_fibre_iso K Y T pY g y₀ hy₀ _ rfl t₀ ht₀ huniq
    have hT : CompactSpace T'.left := (inferInstance : CompactSpace T)
    have hqs : QuasiSeparatedSpace U.left := (inferInstance : QuasiSeparatedSpace Y)
    have hln : IsLocallyNoetherian U.left := (inferInstance : IsLocallyNoetherian Y)
    obtain ⟨κ, hκ, -⟩ := wc_lfi_point_excision Y U V T' VT ι hι _ hr g' j hj hrj gV hgV
      hfib hT hqs hln
    haveI := hκ
    let e1 : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ι)) (wcZModSheaf Y m) i ≃
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y j)) (wcZModSheaf Y m) i :=
      { toFun := fun z => (Abelian.Ext.mk₀ κ).comp z (zero_add i)
        invFun := fun z => (Abelian.Ext.mk₀ (inv κ)).comp z (zero_add i)
        left_inv := fun z => by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        right_inv := fun z => by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
    haveI : IsOpenImmersion j.left := hj
    exact ⟨e1.trans (wc_glc_coker_slice Y T' VT j m i).some⟩

  obtain ⟨U₁, hw₁, hU₁⟩ := wc_etale_fibre_point_isolated a w₀
  obtain ⟨U₂, hw₂, hU₂⟩ := wc_etale_fibre_point_isolated b w₀
  obtain ⟨W', hW'aff, hw', hsub⟩ := exists_isAffineOpen_mem_and_subset (x := w₀)
    (U := U₁ ⊓ U₂) (TopologicalSpace.Opens.mem_inf.mpr ⟨hw₁, hw₂⟩)
  haveI : IsAffine (W' : Scheme) := hW'aff
  let t₀ : (W' : Scheme) := ⟨w₀, hw'⟩
  have hmem : ∀ t : (W' : Scheme), (t.1 : W) ∈ U₁ ∧ (t.1 : W) ∈ U₂ := fun t =>
    TopologicalSpace.Opens.mem_inf.mp (hsub t.2)
  have hgX : ∀ t : (W' : Scheme), (W'.ι ≫ a) t = a t.1 := fun t => by
    rw [Scheme.Hom.comp_apply]
    exact congrArg a (Scheme.Opens.ι_apply W' t)
  have hgC : ∀ t : (W' : Scheme), (W'.ι ≫ b) t = b t.1 := fun t => by
    rw [Scheme.Hom.comp_apply]
    exact congrArg b (Scheme.Opens.ι_apply W' t)
  have ht₀X : (W'.ι ≫ a) t₀ = x₀ (IsLocalRing.closedPoint K) := by rw [hgX]; exact ha
  have ht₀C : (W'.ι ≫ b) t₀ = c₀ (IsLocalRing.closedPoint K) := by rw [hgC]; exact hb
  have uX : ∀ t : (W' : Scheme), (W'.ι ≫ a) t = x₀ (IsLocalRing.closedPoint K) → t = t₀ := by
    intro t ht
    rw [hgX, ← ha] at ht
    exact Subtype.ext (hU₁ t.1 (hmem t).1 ht)
  have uC : ∀ t : (W' : Scheme), (W'.ι ≫ b) t = c₀ (IsLocalRing.closedPoint K) → t = t₀ := by
    intro t ht
    rw [hgC, ← hb] at ht
    exact Subtype.ext (hU₂ t.1 (hmem t).2 ht)
  let OT : (W' : Scheme).Opens := (W'.ι ≫ a) ⁻¹ᵁ OX
  have hOT : (OT : Set (W' : Scheme)) = {t₀}ᶜ := by
    rw [Scheme.Hom.coe_preimage, hOX]
    ext t
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · intro h ht
      apply h
      rw [ht]
      exact ht₀X
    · intro h hgt
      exact h (uX t hgt)
  obtain ⟨eX⟩ := s1 pX (W'.ι ≫ a) x₀ hx₀ t₀ ht₀X uX OX hOX OT hOT
  obtain ⟨eC⟩ := s1 pC (W'.ι ≫ b) c₀ hc₀ t₀ ht₀C uC OC hOC OT hOT
  exact ⟨eX.trans eC.symm⟩

theorem wc_pmn_lup_odp_closed_fibre_double_chart (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x) :
    ∃ c : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField A), IsUnit (c + c.transpose).det ∧
      ∃ (W : Scheme.{u})
        (a : W ⟶ Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        (b : W ⟶ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c))) (w₀ : W),
        Etale a ∧ Etale b ∧ a w₀ = xs ∧
        ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 c)
          (MvPolynomial.X p) ∈ (b w₀).asIdeal :=
by
  classical

  have s3 : ∀ {Yt P U Xs An A1 Sk Cn : Scheme.{u}}
      (f : Yt ⟶ P) (j : A1 ⟶ P) [Mono j]
      (G : An ⟶ A1) (Tk : Sk ⟶ A1) (M : Cn ⟶ An) (Q : Cn ⟶ Sk) (hC : IsPullback M Q G Tk)
      (u : U ⟶ Yt) (φ : U ⟶ An) (hu : Etale u) (hφ : Etale φ) (hcomm : u ≫ f = φ ≫ G ≫ j)
      (πs : Xs ⟶ Yt) (ps : Xs ⟶ Sk) (hsq : IsPullback πs ps f (Tk ≫ j)),
      ∃ (W : Scheme.{u}) (a : W ⟶ Xs) (b : W ⟶ Cn) (ua : W ⟶ U),
        Etale a ∧ Etale b ∧ b ≫ M = ua ≫ φ ∧
        ∀ (w : U) (z : Xs), u w = πs z → ∃ w' : W, ua w' = w ∧ a w' = z := by
    intro Yt P U Xs An A1 Sk Cn f j _ G Tk M Q hC u φ hu hφ hcomm πs ps hsq
    have A₀ := IsPullback.of_hasPullback u πs
    have ha : Etale (Limits.pullback.snd u πs) :=
      MorphismProperty.of_isPullback (P := @Etale) A₀ hu
    have B₀ := A₀.paste_vert hsq
    rw [hcomm] at B₀
    have C₀ : IsPullback M Q (G ≫ j) (Tk ≫ j) :=
      IsPullback.of_isLimit (Limits.PullbackCone.isLimitOfCompMono G Tk j hC.cone hC.isLimit)
    have hw : (Limits.pullback.fst u πs ≫ φ) ≫ G ≫ j =
        (Limits.pullback.snd u πs ≫ ps) ≫ Tk ≫ j := by
      rw [Category.assoc]; exact B₀.w
    let b := C₀.lift (Limits.pullback.fst u πs ≫ φ) (Limits.pullback.snd u πs ≫ ps) hw
    have hbM : b ≫ M = Limits.pullback.fst u πs ≫ φ := C₀.lift_fst _ _ _
    have hbQ : b ≫ Q = Limits.pullback.snd u πs ≫ ps := C₀.lift_snd _ _ _
    rw [← hbQ] at B₀
    have T₀ : IsPullback (Limits.pullback.fst u πs) b φ M := IsPullback.of_bot B₀ hbM.symm C₀
    have hb : Etale b := MorphismProperty.of_isPullback (P := @Etale) T₀ hφ
    refine ⟨Limits.pullback u πs, Limits.pullback.snd u πs, b, Limits.pullback.fst u πs,
      ha, hb, hbM, ?_⟩
    intro w z h
    exact Scheme.Pullback.exists_preimage_pullback w z h

  have s1 : ∀ (F₀ k₀ : Type u) [Field F₀] [Field k₀] {P : Scheme.{u}}
      (j : Spec (.of (Polynomial F₀)) ⟶ P) [IsOpenImmersion j] (β : F₀) (s : Spec (.of F₀) ⟶ P)
      (hs : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) ≫ j = s)
      (t : Spec (.of k₀) ⟶ P)
      (ht : t (IsLocalRing.closedPoint k₀) = s (IsLocalRing.closedPoint F₀)),
      ∃ ρ : F₀ →+* k₀, Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom ρ (ρ β))) ≫ j = t := by
    intro F₀ k₀ _ _ P j _ β s hs t ht
    have hpt : ∀ z, t z = j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
        (IsLocalRing.closedPoint F₀)) := by
      intro z
      rw [Subsingleton.elim z (IsLocalRing.closedPoint k₀), ht, ← hs]
      exact Scheme.Hom.comp_apply _ _ _
    have hr : Set.range t ⊆ Set.range j := by
      rintro _ ⟨z, rfl⟩
      exact ⟨_, (hpt z).symm⟩
    have hfac : IsOpenImmersion.lift j t hr ≫ j = t := IsOpenImmersion.lift_fac j t hr
    have hτt : Spec.map (CommRingCat.ofHom (Spec.preimage (IsOpenImmersion.lift j t hr)).hom) =
        IsOpenImmersion.lift j t hr := by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    set τ := (Spec.preimage (IsOpenImmersion.lift j t hr)).hom with hτ
    refine ⟨τ.comp Polynomial.C, ?_⟩
    have hX : τ = Polynomial.eval₂RingHom (τ.comp Polynomial.C) ((τ.comp Polynomial.C) β) := by
      apply Polynomial.ringHom_ext
      · intro a
        simp
      · have h1 : (IsOpenImmersion.lift j t hr) (IsLocalRing.closedPoint k₀) =
            Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β))
              (IsLocalRing.closedPoint F₀) := by
          apply j.isOpenEmbedding.injective
          exact (Scheme.Hom.comp_apply _ _ _).symm.trans
            ((congrArg (fun g : Spec (.of k₀) ⟶ P => g (IsLocalRing.closedPoint k₀)) hfac).trans
              (hpt _))
        have h2 : Ideal.comap τ (IsLocalRing.closedPoint k₀).asIdeal =
            Ideal.comap (Polynomial.evalRingHom β) (IsLocalRing.closedPoint F₀).asIdeal := by
          have h3 := congrArg PrimeSpectrum.asIdeal h1
          rw [← hτt] at h3
          exact h3
        have hmem : Polynomial.X - Polynomial.C β ∈
            Ideal.comap (Polynomial.evalRingHom β) (IsLocalRing.closedPoint F₀).asIdeal := by
          rw [Ideal.mem_comap]
          simp
        rw [← h2, Ideal.mem_comap] at hmem
        have hmem' : τ (Polynomial.X - Polynomial.C β) ∈ IsLocalRing.maximalIdeal k₀ := hmem
        rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, map_sub, sub_eq_zero] at hmem'
        simp [hmem']
    rw [← hX, hτt, hfac]

  have s2 : ∀ (F₀ k₀ : Type u) [Field F₀] [Field k₀] (ρ : F₀ →+* k₀)
      (β : F₀) (n : ℕ) (c₀ : Matrix (Fin n) (Fin n) F₀),
      IsPushout
        (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β +
          ∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q)))
        (CommRingCat.ofHom (Polynomial.eval₂RingHom ρ (ρ β)))
        (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span {∑ p, ∑ q,
          MvPolynomial.C ((c₀.map ρ) p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C (0 : k₀)})).comp (MvPolynomial.map ρ)))
        (CommRingCat.ofHom (algebraMap k₀ (MvPolynomial (Fin n) k₀ ⧸ (Ideal.span {∑ p, ∑ q,
          MvPolynomial.C ((c₀.map ρ) p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C (0 : k₀)})))) := by
    intro F₀ k₀ _ _ ρ β n c₀
    set I : Ideal (MvPolynomial (Fin n) k₀) := Ideal.span {∑ p, ∑ q,
      MvPolynomial.C ((c₀.map ρ) p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (0 : k₀)} with hI
    set q₀ : MvPolynomial (Fin n) F₀ :=
      ∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q with hq₀
    have hgen : MvPolynomial.map ρ q₀ = ∑ p, ∑ q, MvPolynomial.C ((c₀.map ρ) p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (0 : k₀) := by
      simp [hq₀, Matrix.map_apply]
    have hq0 : Ideal.Quotient.mk I (MvPolynomial.map ρ q₀) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, hgen]
      exact Ideal.mem_span_singleton_self _
    have halg : ∀ a : k₀, algebraMap k₀ (MvPolynomial (Fin n) k₀ ⧸ I) a =
        Ideal.Quotient.mk I (MvPolynomial.C a) := by
      intro a
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    have heq : CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + q₀)) ≫
        CommRingCat.ofHom ((Ideal.Quotient.mk I).comp (MvPolynomial.map ρ)) =
        CommRingCat.ofHom (Polynomial.eval₂RingHom ρ (ρ β)) ≫
        CommRingCat.ofHom (algebraMap k₀ (MvPolynomial (Fin n) k₀ ⧸ I)) := by
      apply CommRingCat.hom_ext
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      apply Polynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          MvPolynomial.map_C, halg]
      · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, map_add,
          MvPolynomial.map_C, halg, hq0, add_zero]
    have key : ∀ s : Limits.PushoutCocone
        (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + q₀)))
        (CommRingCat.ofHom (Polynomial.eval₂RingHom ρ (ρ β))),
        (MvPolynomial.eval₂Hom s.inr.hom (fun p => s.inl.hom (MvPolynomial.X p))).comp
          (MvPolynomial.map ρ) = s.inl.hom ∧
        s.inl.hom q₀ = 0 := by
      intro s
      have hc : ∀ x, s.inl.hom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β + q₀) x) =
          s.inr.hom (Polynomial.eval₂RingHom ρ (ρ β) x) := by
        intro x
        have := congrArg (fun φ => φ.hom x) s.condition
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] using this
      have hC : ∀ a : F₀, s.inl.hom (MvPolynomial.C a) = s.inr.hom (ρ a) := by
        intro a
        have := hc (Polynomial.C a)
        simpa only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C] using this
      have hXc := hc Polynomial.X
      simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, map_add, hC] at hXc
      refine ⟨?_, ?_⟩
      · apply MvPolynomial.ringHom_ext
        · intro a
          simp [hC]
        · intro p
          simp
      · have := hXc
        rw [add_eq_left] at this
        exact this
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk heq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift I
        (MvPolynomial.eval₂Hom s.inr.hom (fun p => s.inl.hom (MvPolynomial.X p))) ?_)) ?_ ?_ ?_)
    · intro a ha
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, ← hgen, ← RingHom.comp_apply, (key s).1, (key s).2, mul_zero]
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, ← RingHom.comp_assoc,
        Ideal.Quotient.lift_comp_mk, (key s).1]
    · intro s
      apply CommRingCat.hom_ext
      ext a
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, RingHom.comp_apply,
        halg, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m h1 h2
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have := congrArg (fun φ => φ.hom a) h2
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, halg] at this
        rw [RingHom.comp_apply, RingHom.comp_apply, this, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C]
      · intro p
        have := congrArg (fun φ => φ.hom (MvPolynomial.X p)) h1
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          MvPolynomial.map_X] at this
        rw [RingHom.comp_apply, RingHom.comp_apply, this, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']

  obtain ⟨j, β, hj, hjP, hjS⟩ := wc_morse_p1_rational_chart F'' (D.S i) (D.hS i)
  haveI := hj
  obtain ⟨U, u, φ, c₀, σ, hu, hφ, hdet, hcomm, hσ, hσX⟩ :=
    wc_morse_odp_etale_chart F' F'' Y n hn2 D i j β hj hjP hjS

  have hq : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A :=
    IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
  have ht : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      D.S i (IsLocalRing.closedPoint F'') :=
    (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun z => V.hom (e.inv z)) hq).trans hV))

  obtain ⟨ρ, hρ⟩ := s1 F'' (IsLocalRing.ResidueField A) j β (D.S i) hjS _ ht

  have sq₁ : IsPullback (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (Limits.pullback.fst V.hom D.f) (wcQmSp A ≫ e.inv) :=
    (IsPullback.of_hasPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).of_iso
      (Iso.refl _) (Iso.refl _) (Iso.refl _) e.symm (by simp) (by simp) (by simp) (by simp)
  have sq₂ := (IsPullback.of_hasPullback V.hom D.f).flip
  have hsq0 := sq₁.paste_horiz sq₂
  have hTk : (wcQmSp A ≫ e.inv) ≫ V.hom =
      Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom ρ (ρ β))) ≫ j := by
    rw [Category.assoc, hρ]
  rw [hTk] at hsq0

  have hC := isPullback_SpecMap_of_isPushout _ _ _ _ (s2 F'' (IsLocalRing.ResidueField A) ρ β n c₀)

  obtain ⟨W, a, b, ua, ha, hb, hbM, hpts⟩ := s3 D.f j _ _ _ _ hC u φ hu hφ hcomm _ _ hsq0

  have hu' : u (σ (IsLocalRing.closedPoint F'')) =
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Limits.pullback.snd V.hom D.f) xs := by
    refine (Scheme.Hom.comp_apply σ u _).symm.trans ?_
    refine (congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hσ).trans
      ?_
    refine Eq.symm ((Scheme.Hom.comp_apply _ _ _).trans ?_)
    exact (congrArg (Limits.pullback.snd V.hom D.f) hxs).trans hx₂
  obtain ⟨w₀, hw₁, hw₂⟩ := hpts _ _ hu'

  have hdet' : ((c₀.map ρ) + (c₀.map ρ).transpose).det = ρ (c₀ + c₀.transpose).det := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.map_add _ (map_add ρ), Matrix.transpose_map]
  have hunit : IsUnit ((c₀.map ρ) + (c₀.map ρ).transpose).det := by
    rw [hdet']
    exact isUnit_iff_ne_zero.mpr (fun h => hdet (ρ.injective (h.trans (map_zero ρ).symm)))
  refine ⟨c₀.map ρ, hunit, W, a, b, w₀, ha, hb, hw₂, ?_⟩

  intro p
  have hMb := (Scheme.Hom.comp_apply b _ w₀).symm.trans ((congrArg (fun g => g w₀) hbM).trans
    ((Scheme.Hom.comp_apply ua φ w₀).trans (congrArg φ hw₁)))
  have h1 : (MvPolynomial.X p : MvPolynomial (Fin n) F'') ∈
      ((Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal
        (IsLocalRing.ResidueField A) n 0 (c₀.map ρ))).comp (MvPolynomial.map ρ)))) (b w₀)).asIdeal := by
    rw [hMb]
    exact hσX p
  have h2 : ((Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 (c₀.map ρ))).comp
      (MvPolynomial.map ρ)) (MvPolynomial.X p) ∈ (b w₀).asIdeal := h1
  rw [RingHom.comp_apply, MvPolynomial.map_X] at h2
  exact h2

theorem wc_pmn_lup_odp_supp_cone_excision (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (O : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens)
    (hO : (O : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))) = {xs}ᶜ) :
    ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 ∧
    ∃ c : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField A), IsUnit (c + c.transpose).det ∧
      ∀ (Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c))).Opens),
        (Oc : Set (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c)))) =
          {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 c)
            (MvPolynomial.X p) ∉ y.asIdeal} →
        ∀ (k j : ℕ),
          Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap
              (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
              (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
                Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk
                  (𝟙 (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))))))
              (wcZModSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (ℓ ^ k)) j ≃
            Abelian.Ext (Limits.cokernel (wcFreeSheafMap
              (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c)))
              (MorphismProperty.Over.homMk Oc.ι (Category.comp_id _) trivial :
                Scheme.ProEt.mk Oc.ι ⟶ Scheme.ProEt.mk
                  (𝟙 (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c)))))))
              (wcZModSheaf (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c))) (ℓ ^ k)) j) :=
by
  classical
  obtain ⟨-, -, hln, -⟩ := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  haveI := hln
  haveI hac := wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    let ρ : F'' →+* IsLocalRing.ResidueField A :=
      (Spec.preimage (wcQmSp A ≫ e.inv ≫ V.hom ≫ (wcP1Over F'').hom)).hom
    intro h0
    have hF : ((ℓ : ℕ) : F'') = 0 := by
      apply ρ.injective
      rw [map_natCast, map_zero]
      exact h0
    haveI := Fintype.ofFinite F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ := ringChar.dvd hF
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h1
    have h3 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h3
  obtain ⟨c, hc, W, a, b, w₀, ha, hb, haw, hbw⟩ :=
    wc_pmn_lup_odp_closed_fibre_double_chart F' F'' Y n hn2 D i V A e hV x hx₂ xs hxs
  haveI := ha
  haveI := hb
  obtain ⟨-, -, ⟨y₀, hy₀, hy₀pt⟩, -⟩ :=
    wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs
  obtain ⟨huniq, v₀, hv₀, hv₀X⟩ := wc_lup_quad_cone_vertex (IsLocalRing.ResidueField A) n c
  refine ⟨hℓk, c, hc, fun Oc hOc k' j' => ?_⟩
  have hO' : (O : Set _) = {y₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))}ᶜ := by
    rw [hO, hy₀pt]
  have hOc' : (Oc : Set (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c)))) =
      {v₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))}ᶜ := by
    rw [hOc]
    ext y
    simp only [Set.mem_setOf_eq, Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨p, hp⟩ rfl
      exact hp (hv₀X p)
    · intro hy
      by_contra hcon
      push_neg at hcon
      exact hy (huniq _ _ hcon hv₀X)
  have ha' : a w₀ = y₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    rw [haw, hy₀pt]
  have hb' : b w₀ = v₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) :=
    huniq _ _ hbw hv₀X
  exact wc_lup_two_sided_point_excision_ext (IsLocalRing.ResidueField A) _
    (wcQuadModelStr _ n 0 c) a b y₀ v₀ hy₀ hv₀ w₀ ha' hb' O hO' Oc hOc' (ℓ ^ k') j'

