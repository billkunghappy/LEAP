    refine ⟨g, ?_⟩
    change γ ≫ Df.Φ.map g = k
    have h1 : (γ ≫ Df.Φ.map g) ≫ η.hom.app N = k ≫ η.hom.app N := (hnat g).symm.trans hg
    first
      | exact (Iso.cancel_iso_hom_right _ _ (η.app N)).mp h1
      | exact (cancel_mono (η.hom.app N)).mp h1

theorem wc_pmn_ldp_shens_cone_top_pull_injective (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (hK : IsAlgClosed (IsLocalRing.ResidueField A)) (h4 : 4 ≤ n)
    (Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)))).Opens)
    (hOc : (Oc : Set ↥(Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0))))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (O : (Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))).Opens)
    (hO : (O : Set ↥(Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))) =
        {w | Limits.pullback.snd a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w ≠ xs})
    (κ : Limits.pullback a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ⟶
        Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0))))
    (hκ : WeaklyEtale κ) (hpre : κ ⁻¹ᵁ Oc = O)
    (κo : (O : Scheme.{u}) ⟶ (Oc : Scheme.{u})) (hκo : κo ≫ Oc.ι = O.ι ≫ κ)
    (Dκ : wcHMPullData κo ℓ) (hDκ : wcHMPullCanonical Dκ) :
    Function.Injective (wcHMPull Dκ (2 * n - 3)) :=
by
  classical

  have sepAff : ∀ {X U : Scheme.{u}} (f : U ⟶ X), IsAffine U → IsSeparated f := by
    intro X U f hU
    haveI := hU
    have h1 : f ≫ Limits.terminal.from X = Limits.terminal.from U := Limits.terminal.hom_ext _ _
    haveI : IsSeparated (f ≫ Limits.terminal.from X) := by rw [h1]; infer_instance
    exact IsSeparated.of_comp f (Limits.terminal.from X)

  have hvanC : ∀ (K : Type u) [Field K] [IsSepClosed K], ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (m : ℕ) (c : Matrix (Fin m) (Fin m) K) (q : ℕ), 1 ≤ q →
      ∀ z : wcHM (Spec (.of (wcQuadModelRing K m 0 c))) ℓ q, z = 0 := by
    intro K _ _ hℓK m c q hq z
    obtain ⟨-, hsub⟩ := wc_et_quadric_cone_acyclic K ℓ Fact.out hℓK m c
    obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
    exact wc_hm_vanish_of_int_ext_vanish _ ℓ j
      (wc_proet_int_ext_vanish_of_zmod _ ℓ _ (fun k j' => wc_proet_zmod_ext_vanish_of_et _ _ j'
        (wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out (j' + 1) (hsub (j' + 1) (by omega)) k)) j) z

  have extinj : ∀ {X Z W T' : Scheme.{u}} {i : Z ⟶ X} (f : W ⟶ X) [WeaklyEtale f] {i' : T' ⟶ W}
      (D : wcHMPullData i ℓ) (D' : wcHMPullData i' ℓ) (Df : wcHMPullData f ℓ),
      wcHMPullCanonical Df → ∀ (γ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D)),
      (∀ N : SheafOfModules.{u+1} (wcRingSheaf X ℓ),
        Function.Bijective (fun g : wcSuppObj D ⟶ N => γ ≫ Df.Φ.map g)) →
      ∀ (m : ℕ), (letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _;
        Function.Injective (fun θ : wcSuppExt D m =>
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df m θ) (zero_add _))) := by
    intro X Z W T' i f _ i' D D' Df hDf γ hhom m
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology X) (wcRingSheaf X ℓ)
    obtain ⟨hcont, -, -⟩ := wc_lpsc_site X (Scheme.ProEt.mk f)
    haveI := hcont
    obtain ⟨η⟩ := wc_hm_pull_Phi_slice_iso X ℓ (Scheme.ProEt.mk f) Df hDf
    have hinj : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) [Injective I],
        Injective (Df.Φ.obj I) := by
      intro I _
      exact Injective.of_iso (η.app I).symm (wc_slice_res_preserves_injective X ℓ _ I)
    have hbij := ext_transfer_of_corep Df.Φ (wcSuppObj D) (wcSuppObj D') γ hhom
      (fun I _ n e => by haveI := hinj I; exact Abelian.Ext.eq_zero_of_injective e)
      (SheafOfModules.unit (wcRingSheaf X ℓ)) m
    have key : ∀ θ : wcSuppExt D m,
        (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df m θ) (zero_add _) =
          ((Abelian.Ext.mk₀ γ).comp (Abelian.Ext.mapExactFunctor Df.Φ θ) (zero_add m)).comp
            (Abelian.Ext.mk₀ Df.μ.hom) (add_zero m) := by
      intro θ
      unfold wcSuppPullExt
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    have cancel : ∀ y : Abelian.Ext (wcSuppObj D') (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf X ℓ))) m,
        (y.comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero m)).comp (Abelian.Ext.mk₀ Df.μ.inv)
          (add_zero m) = y := by
      intro y
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    intro θ₁ θ₂ h
    have h' := (key θ₁).symm.trans (h.trans (key θ₂))
    have h'' := congrArg (fun y => y.comp (Abelian.Ext.mk₀ Df.μ.inv) (add_zero m)) h'
    simp only [cancel] at h''
    exact hbij.1 h''

  have chase : ∀ {T V T' V' : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] [IsLocallyNoetherian V]
      (Dj : wcHMPullData j ℓ), wcHMPullCanonical Dj → ∀ (Wo : V.Opens),
      (Wo : Set ↥V) = (Set.range j)ᶜ → ∀ (j' : T' ⟶ V') [IsClosedImmersion j'],
      (∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ V'), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range j' ↔ ∃ k, x ∈ W.basicOpen (f k))) →
      ∀ (f : V' ⟶ V) (Dj' : wcHMPullData j' ℓ), wcHMPullCanonical Dj' →
      Epi (wcSuppUnitMap Dj') → ∀ (Wo' : V'.Opens), (Wo' : Set ↥V') = (Set.range j')ᶜ →
      ∀ (fO : Wo'.toScheme ⟶ Wo.toScheme), fO ≫ Wo.ι = Wo'.ι ≫ f →
      ∀ (Df : wcHMPullData f ℓ), wcHMPullCanonical Df →
      ∀ (γ : wcSuppObj Dj' ⟶ Df.Φ.obj (wcSuppObj Dj)),
      wcSuppUnitMap Dj' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap Dj) →
      ∀ (DfO : wcHMPullData fO ℓ), wcHMPullCanonical DfO → ∀ (N : ℕ),
      (∀ x : wcHM V ℓ N, x = 0) →
      (letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _;
        Function.Injective (fun θ : wcSuppExt Dj (N + 1) =>
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Dj Df (N + 1) θ) (zero_add _))) →
      Function.Injective (wcHMPull DfO N) := by
    intro T V T' V' j _ _ Dj hDj Wo hW j' _ hqc f Dj' hDj' hepi' Wo' hW' fO hfO Df hDf γ hγ
      DfO hDfO N hvan hexc
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
    have hepi := wc_supp_unit_epi_of_closed j ℓ Dj hDj
    obtain ⟨δ, -, hnat⟩ := wc_supp_les_boundary_natural_qc j Dj hDj hepi
      (fun U k W g hW => wc_supp_kernel_section_local_cover j Dj hDj U k W g hW) Wo hW N (N + 1) rfl
    obtain ⟨Dw', hDw'⟩ := wc_hm_pull_data_exists Wo'.ι ℓ
    obtain ⟨δ', -, hA⟩ := hnat j' f Dj' hDj' hepi'
      (fun U k W g hW => wc_supp_kernel_section_local_cover_qc j' hqc Dj' hDj' U k W g hW)
      Wo' hW' fO hfO Df hDf γ hγ Dw' hDw' DfO hDfO
    obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (𝟙 V) ℓ
    obtain ⟨Dj₁, hDj₁, γ₁, hγ₁, hepi₁⟩ := wc_closed_supp_base_change_noeth j (𝟙 V) Dj hDj D1 hD1
    have hW₁ : (Wo : Set ↥V) = (Set.range (Limits.pullback.fst (𝟙 V) j))ᶜ := by
      rw [hW, Scheme.Pullback.range_fst]
      rfl
    obtain ⟨Dw₁, hDw₁⟩ := wc_hm_pull_data_exists Wo.ι ℓ
    obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 Wo.toScheme) ℓ
    obtain ⟨δ₁, hex₁, hB⟩ := hnat (Limits.pullback.fst (𝟙 V) j) (𝟙 V) Dj₁ hDj₁ hepi₁
      (fun U k W g hW => wc_supp_kernel_section_local_cover _ Dj₁ hDj₁ U k W g hW)
      Wo hW₁ (𝟙 _) (by simp) D1 hD1 γ₁ hγ₁ Dw₁ hDw₁ Did hDid
    have hE0 : (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Dj Df (N + 1) 0) (zero_add _) = 0 := by
      have := hA 0
      simp only [map_zero] at this
      exact this.symm
    have hE1 : (Abelian.Ext.mk₀ γ₁).comp (wcSuppPullExt Dj D1 (N + 1) 0) (zero_add _) = 0 := by
      have := hB 0
      simp only [map_zero] at this
      exact this.symm
    refine (injective_iff_map_eq_zero (wcHMPull DfO N)).mpr ?_
    intro α hα
    have hδ : δ α = 0 := by
      have := hA α
      rw [hα, map_zero] at this
      exact hexc (this.symm.trans hE0.symm)
    have h1 : δ₁ α = 0 := by
      have := hB α
      rw [wc_hm_pull_id (𝟙 _) rfl Did hDid N α, hδ] at this
      exact this.trans hE1
    obtain ⟨z, hz⟩ := hex₁ α h1
    rw [← hz, hvan z, map_zero]

  have main : ∀ (K : Type u) [Field K] [IsAlgClosed K], ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (m : ℕ) (c : Matrix (Fin m) (Fin m) K) (Oc : (Spec (.of (wcQuadModelRing K m 0 c))).Opens),
      (Oc : Set ↥(Spec (.of (wcQuadModelRing K m 0 c)))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K m 0 c) (MvPolynomial.X p) ∉ y.asIdeal} →
      ∀ {Ws : Scheme.{u}} [IsAffine Ws] (κ : Ws ⟶ Spec (.of (wcQuadModelRing K m 0 c)))
        [WeaklyEtale κ] (O : Ws.Opens), κ ⁻¹ᵁ Oc = O → (∃ w : Ws, w ∉ O) →
      (∀ w w' : Ws, w ∉ O → w' ∉ O → w = w') →
      ∀ (κo : (O : Scheme.{u}) ⟶ (Oc : Scheme.{u})), κo ≫ Oc.ι = O.ι ≫ κ →
      ∀ (Dκ : wcHMPullData κo ℓ), wcHMPullCanonical Dκ → ∀ N : ℕ, 1 ≤ N →
      Function.Injective (wcHMPull Dκ N) := by
    intro K _ _ hℓK m c Oc hOc Ws _ κ _ O hpre hex huniq κo hκo Dκ hDκ N hN
    obtain ⟨huV, v₀, hv₀s, hv₀X⟩ := wc_lup_quad_cone_vertex K m c
    haveI := sepAff (wcQuadModelStr K m 0 c) inferInstance
    haveI : IsClosedImmersion (v₀ ≫ wcQuadModelStr K m 0 c) := by rw [hv₀s]; infer_instance
    haveI : IsClosedImmersion v₀ := IsClosedImmersion.of_comp v₀ (wcQuadModelStr K m 0 c)
    haveI : IsLocallyNoetherian (Spec (.of (wcQuadModelRing K m 0 c))) := by
      first
        | infer_instance
        | (unfold wcQuadModelRing; infer_instance)
    have hmemv : ∀ y : ↥(Spec (.of (wcQuadModelRing K m 0 c))), y ∈ Set.range v₀ ↔
        ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K m 0 c) (MvPolynomial.X p) ∈ y.asIdeal := by
      intro y
      constructor
      · rintro ⟨t, rfl⟩
        have ht : t = IsLocalRing.closedPoint K := @Subsingleton.elim (PrimeSpectrum K) _ t _
        rw [ht]
        exact hv₀X
      · intro h
        exact ⟨IsLocalRing.closedPoint K, (huV y _ h hv₀X).symm⟩
    have hOcv : (Oc : Set ↥(Spec (.of (wcQuadModelRing K m 0 c)))) = (Set.range v₀)ᶜ := by
      ext y
      rw [hOc, Set.mem_compl_iff, hmemv]
      simp only [Set.mem_setOf_eq, not_forall]
    have hmemO : ∀ w : Ws, w ∈ O ↔ κ w ∉ Set.range v₀ := by
      intro w
      rw [← hpre, Scheme.Hom.mem_preimage]
      show κ w ∈ (Oc : Set ↥(Spec (.of (wcQuadModelRing K m 0 c)))) ↔ _
      rw [hOcv]
      exact Iff.rfl
    have hfib : IsIso (Limits.pullback.snd κ v₀) := by
      apply wc_weaklyEtale_algClosed_fibre_isIso K κ v₀
      · obtain ⟨w, hw⟩ := hex
        exact ⟨w, by by_contra h; exact hw ((hmemO w).mpr h)⟩
      · intro w w' h h'
        apply huniq w w'
        · intro hw; exact (hmemO w).mp hw h
        · intro hw; exact (hmemO w').mp hw h'
    obtain ⟨Dv, hDv⟩ := wc_hm_pull_data_exists v₀ ℓ
    obtain ⟨Df, hDf⟩ := wc_hm_pull_data_exists κ ℓ
    obtain ⟨Di, hDi, γ, hγ, hepi⟩ :=
      wc_closed_supp_base_change_weaklyEtale_affine v₀ κ Dv hDv Df hDf
    have hW' : (O : Set Ws) = (Set.range (Limits.pullback.fst κ v₀))ᶜ := by
      ext w
      rw [Scheme.Pullback.range_fst]
      exact hmemO w
    have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Ws), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range (Limits.pullback.fst κ v₀) ↔ ∃ k, x ∈ W.basicOpen (f k)) := by
      intro W _ p
      obtain ⟨m', g, hg⟩ := wc_affine_complement_basicOpen_cover v₀ W (p ≫ κ)
      refine ⟨m', g, fun x => ?_⟩
      rw [Scheme.Pullback.range_fst, ← hg x, Scheme.Hom.comp_apply]
      exact Iff.rfl
    have hvan := hvanC K hℓK m c N hN
    have hhom := wc_supp_hom_bij_weaklyEtale_affine v₀ κ hfib Dv hDv Di hDi hepi Df hDf γ hγ
    have hexc := extinj κ Dv Di Df hDf γ hhom (N + 1)
    exact chase v₀ Dv hDv Oc hOcv (Limits.pullback.fst κ v₀) hqc κ Di hDi hepi O hW' κo hκo
      Df hDf γ hγ Dκ hDκ N hvan hexc

  haveI := hK
  haveI := hκ
  obtain ⟨_, _, _, -, -, -, -, -, hℓK⟩ := wc_pmn_ldp_shens_cone_chart F' F'' Y n hn hn2 D ℓ hℓ i V
    A e hV x hx₁ hx₂ B Λ' W'' φ' a' hsh xs hxs
  obtain ⟨J, c, hpb, -⟩ :=
    wc_pmn_shens_closed_fibre_square F' F'' Y n D V A e x hx₁ B Λ' W'' φ' a' hsh
  haveI : IsIso c := hpb.isIso_snd_of_isIso
  haveI hWa : IsAffine (Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :=
    IsAffine.of_isIso c
  obtain ⟨hex, huniq⟩ := wc_pmn_ldp_shens_germ_xs_point_unique F' F'' Y n D i V A e x hx₁ hx₂
    B Λ' W'' φ' a' hsh xs hxs
  have hnotO : ∀ w, w ∉ O ↔ Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w = xs := by
    intro w
    have h1 : w ∈ O ↔ Limits.pullback.snd a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) w ≠ xs := by
      show w ∈ (O : Set ↥(Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))) ↔ _
      rw [hO]
      exact Iff.rfl
    rw [h1]
    exact not_not
  exact main (IsLocalRing.ResidueField A) hℓK n _ Oc hOc κ O hpre
    (by obtain ⟨w, hw⟩ := hex; exact ⟨w, (hnotO w).mpr hw⟩)
    (fun w w' h h' => huniq w w' ((hnotO w).mp h) ((hnotO w').mp h'))
    κo hκo Dκ hDκ (2 * n - 3) (by omega)

theorem wc_pmn_ldp_shens_punct_cup_transport (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
