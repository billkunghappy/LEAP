      (hline : ∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj S) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            One))⟦s'⟧, a ≠ 0 →
          ∃ c : S ⟶ S, w = DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map c) ≫ a)
      (hlift : ∀ c : S ⟶ S, ∃ v : One ⟶ One, ū ≫ c = v ≫ ū)
      (Kp : DerivedCategory 𝒞W)
      (ι : Kp ⟶ Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))
      (δ : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
        ((CochainComplex.singleFunctor 𝒞 0).obj S)) ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι (Φ.mapDerivedCategory.map (DerivedCategory.Q.map
        ((CochainComplex.singleFunctor 𝒞 0).map ū))) δ ∈ distTriang (DerivedCategory 𝒞W) →
      ∀ a₀ a₁ : Kp ⟶ (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦M⟧,
        a₀ ≠ 0 → ∃ φ : Kp ⟶ Kp, a₁ = φ ≫ a₀ := by
    intro 𝒞 𝒞W _ _ _ _ _hD _hDW Φ _ _ _ One S OneW μ hP ū M hM s hs s' hss hτ hline hlift Kp ι
      δ hT a₀ a₁ ha₀
    subst hss
    haveI := hP

    have hZ : ∀ g : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) ⟶
        (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦M⟧, g = 0 := by
      intro g
      let ιL : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).obj
          OneW) ≅ Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) :=
        DerivedCategory.Q.mapIso ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).mapIso
            μ.symm) ≪≫
          DerivedCategory.Q.mapIso ((HomologicalComplex.singleMapHomologicalComplex Φ
            (ComplexShape.up ℤ) 0).symm.app One) ≪≫
          ((Φ.mapDerivedCategoryFactors).app _).symm
      haveI h0 : DerivedCategory.TStructure.t.IsLE (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).obj OneW)) 0 :=
        (inferInstance : (DerivedCategory.Q.obj
          ((CochainComplex.singleFunctor 𝒞W 0).obj OneW)).IsLE 0)
      haveI h1 : DerivedCategory.TStructure.t.IsLE (Φ.mapDerivedCategory.obj
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))
          0 :=
        DerivedCategory.TStructure.t.isLE_of_iso ιL 0
      haveI h2 : DerivedCategory.TStructure.t.IsLE ((Φ.mapDerivedCategory.obj
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            One)))⟦M⟧) (-M) :=
        DerivedCategory.TStructure.t.isLE_shift _ 0 M (-M) (by omega)
      obtain ⟨Kz, hKz, ⟨eZ⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isLE
        ((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦M⟧) (-M)
      have h3 : ιL.hom ≫ g ≫ eZ.hom = 0 :=
        DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective
          (P := OneW) (i := 0) _ (-M) (by omega)
      rw [← cancel_epi ιL.hom, ← cancel_mono eZ.hom, Limits.comp_zero, Limits.zero_comp]
      simpa only [Category.assoc] using h3

    have hinj : ∀ a : Kp ⟶ (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦M⟧,
        δ ≫ a⟦(1 : ℤ)⟧' = 0 → a = 0 := by
      intro a ha
      have hR := Pretriangulated.rot_of_distTriang _ hT
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hR (a⟦(1 : ℤ)⟧') ha
      obtain ⟨g₁, rfl⟩ := (shiftFunctor (DerivedCategory 𝒞W) (1 : ℤ)).map_surjective g
      have hg0 : g₁ = 0 := hZ g₁
      have h1 : a⟦(1 : ℤ)⟧' = 0 := by
