  have hc := wc_pmn_tsl_cone_point_iso F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE x hx₁ hx₂
    Dp hDp Di hDi I xs hxs Dx hDx
  have hs2 := wc_pmn_tsl_point_self_ext_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂
    xs hxs Dx hDx
  have hs3 := wc_pmn_tsl_supp_end_field F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂
    xs hxs Dx hDx
  have hs4 := wc_pmn_tsl_local_coh_line F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂
    xs hxs Dx hDx
  have hs5 := wc_pmn_tsl_node_local_coh_rank_two F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂
    xs hxs Dx hDx
  have hs6 := wc_pmn_tsl_node_forget_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE x
    hx₁ hx₂ Dp hDp Di hDi I xs hxs Dx hDx
  obtain ⟨k, hk⟩ := hn
  intro P K Ψ v w hv
  exact key (n - 1) _ _ _ _ (by omega) hc hs2 hs3 (fun h => hs4 (by omega))
