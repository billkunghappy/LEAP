      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∀ a b w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (SheafOfModules.unit
          (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))⟦
          ((n - 1 : ℕ) : ℤ) + ((n - 1 : ℕ) : ℤ)⟧,
      (∀ c d : wcSuppObj Dx ⟶ wcSuppObj Dx,
        DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a +
          DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map d) ≫ b = 0 →
