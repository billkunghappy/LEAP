      exact hn.symm
    let topU : U.left.ProEt :=
      MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left))
    let topS : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    let V₁ : S.ProEt := (wcSliceFunctor S U).obj topU
    have hV1 : ((wcSuppUnitMap D ≫ f₁).val.app (Opposite.op V₁)).hom
          (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V₁))) =
        ((wcSuppUnitMap D ≫ f₂).val.app (Opposite.op V₁)).hom
          (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V₁))) := by
      have h := congrArg (fun φ => (φ.val.app (Opposite.op topU)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V₁)))) hRw
      exact h
    have hzero : ∀ (Q : S.ProEt), (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) →
        ∀ f : wcSuppObj D ⟶ N, ((wcSuppUnitMap D ≫ f).val.app (Opposite.op Q)).hom
          (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) = 0 := by
      intro Q hQ f
