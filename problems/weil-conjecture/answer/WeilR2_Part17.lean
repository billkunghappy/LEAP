  ·
    have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
    have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
    haveI : IsClosedImmersion iT :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP inferInstance
    have hrangeT : Set.range iT = k ⁻¹' Set.range i := by
      rw [← Scheme.Pullback.range_snd i k]
      ext x
      constructor
      · rintro ⟨t, rfl⟩
        refine ⟨hP.isoPullback.hom t, ?_⟩
        have h := Scheme.Hom.comp_apply hP.isoPullback.hom (Limits.pullback.snd i k) t
        rw [hP.isoPullback_hom_snd] at h
        exact h.symm
      · rintro ⟨t, rfl⟩
        refine ⟨hP.isoPullback.inv t, ?_⟩
        have h := Scheme.Hom.comp_apply hP.isoPullback.inv iT t
        rw [hP.isoPullback_inv_snd] at h
        exact h.symm
    have hWo : ((k ⁻¹ᵁ U : (Spec R).Opens) : Set (Spec R)) = (Set.range iT)ᶜ := by
      rw [hrangeT, Scheme.Hom.coe_preimage, hU, Set.preimage_compl]
    have hPU := isPullback_morphismRestrict k U
    have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Spec R), ∃ (N : ℕ) (f : Fin N → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range iT ↔ ∃ a, x ∈ W.basicOpen (f a)) := by
      intro W _ p
      obtain ⟨N, f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ k)
      refine ⟨N, f, fun x => ?_⟩
      rw [← hf x, hrangeT, Set.mem_preimage, Scheme.Hom.comp_apply]
    obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists (k ⁻¹ᵁ U).ι ℓ
    obtain ⟨δ, hlift, -, hlin⟩ := wc_supp_les_open_boundary_scalar iT DT hDT hepi
      (fun U' kk W g hW => wc_supp_kernel_section_local_cover_qc iT hqc DT hDT U' kk W g hW)
      (k ⁻¹ᵁ U) hWo Dw hDw (2 * r - 1) (2 * r) (by omega)

    have hvanR : ∀ q : ℕ, ∀ x : wcHM (Spec R) ℓ (q + 1), x = 0 := by
      intro q x
      obtain ⟨Θ, -⟩ := wc_hm_ladic_bridge (Spec R) ℓ (q + 1)
      haveI : Projective (wcFreeSheaf (Spec R) (Scheme.ProEt.mk (𝟙 (Spec R)))) :=
        wc_proet_free_projective_strict_local (Spec R) (Scheme.ProEt.mk (𝟙 (Spec R))) R
          (Iso.refl _)
      have hs := Abelian.Ext.subsingleton_of_projective
        (wcFreeSheaf (Spec R) (Scheme.ProEt.mk (𝟙 (Spec R)))) (wcLadicSheaf (Spec R) ℓ) q
      apply Θ.injective
      rw [map_zero]
      exact @Subsingleton.elim _ hs _ _
    have hvanR' : ∀ q : ℕ, 1 ≤ q → ∀ x : wcHM (Spec R) ℓ q, x = 0 := by
      intro q hq x
      obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
      exact hvanR q' x
    have hsurj : ∀ θ : wcSuppExt DT (2 * r), ∃ α : wcHM (k ⁻¹ᵁ U).toScheme ℓ (2 * r - 1),
        δ α = θ :=
      fun θ => hlift θ (hvanR' (2 * r) (by omega) _)

    haveI : QuasiCompact (k ⁻¹ᵁ U).ι :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) hPU inferInstance
    haveI : CompactSpace ↥(k ⁻¹ᵁ U).toScheme :=
      QuasiCompact.compactSpace_of_compactSpace (k ⁻¹ᵁ U).ι
    haveI : QuasiSeparatedSpace ↥(k ⁻¹ᵁ U).toScheme :=
      quasiSeparatedSpace_of_quasiSeparated (k ⁻¹ᵁ U).ι
    haveI : IsSeparated (Limits.terminal.from (k ⁻¹ᵁ U).toScheme) := by
      rw [show Limits.terminal.from (k ⁻¹ᵁ U).toScheme =
          (k ⁻¹ᵁ U).ι ≫ Limits.terminal.from (Spec R) from Limits.terminal.hom_ext _ _]
      infer_instance
    have htop := wc_smooth_pair_compl_strict_stalk_et_top_card_le K pY n m i ℓ hℓ U hU R k hk
      (k ∣_ U) (k ⁻¹ᵁ U).ι hPU (2 * r - 1) (by omega) (by omega)
    have hfin : ∀ j : ℕ, Finite (wcEtCoh (k ⁻¹ᵁ U).toScheme ℓ j) := by
      intro j
      rcases Nat.eq_zero_or_pos j with hj | hj
      · subst hj
        by_cases hne : Nonempty ↥(k ⁻¹ᵁ U).toScheme
        · haveI := hne
          haveI : IrreducibleSpace ↥(k ⁻¹ᵁ U).toScheme :=
            (k ⁻¹ᵁ U).ι.isOpenEmbedding.irreducibleSpace
          exact (wc_et_coh_zero_irreducible_card_le (k ⁻¹ᵁ U).toScheme ℓ hℓ0).1
        · haveI : IsEmpty ↥(k ⁻¹ᵁ U).toScheme := not_nonempty_iff.mp hne
          letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (k ⁻¹ᵁ U).toScheme ℓ)) :=
            HasExt.standard _
          obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (k ⁻¹ᵁ U).toScheme ℓ 0
          have hz := wc_et_zmod_modules_zero_of_isEmpty (k ⁻¹ᵁ U).toScheme ℓ inferInstance
            (SheafOfModules.unit (wcEtZModRing (k ⁻¹ᵁ U).toScheme ℓ))
          have h1 : ∀ x : wcEtZModExt (k ⁻¹ᵁ U).toScheme ℓ 0, x = 0 := by
            intro x
            rw [← Abelian.Ext.mk₀_id_comp x, hz.eq_zero_of_src (𝟙 _), Abelian.Ext.mk₀_zero,
              Abelian.Ext.zero_comp]
          haveI : Subsingleton (wcEtZModExt (k ⁻¹ᵁ U).toScheme ℓ 0) :=
            ⟨fun a b => by rw [h1 a, h1 b]⟩
          haveI : Finite (wcEtZModExt (k ⁻¹ᵁ U).toScheme ℓ 0) := Finite.of_subsingleton
          exact Finite.of_equiv _ e
      · by_cases hj2 : j + 2 + 2 * m ≤ 2 * n
        · haveI := wc_smooth_pair_compl_strict_stalk_et_low_vanish K pY n m i ℓ hℓ U hU R k hk
            (k ∣_ U) (k ⁻¹ᵁ U).ι hPU j hj hj2
          exact Finite.of_subsingleton
        · by_cases hj3 : j + 1 + 2 * m = 2 * n
          · exact (wc_smooth_pair_compl_strict_stalk_et_top_card_le K pY n m i ℓ hℓ U hU R k hk
              (k ∣_ U) (k ⁻¹ᵁ U).ι hPU j hj hj3).1
          · haveI := wc_smooth_pair_compl_strict_stalk_et_vanish K pY n m i ℓ hℓ U hU R k hk
              (k ∣_ U) (k ⁻¹ᵁ U).ι hPU j hj (by omega)
            exact Finite.of_subsingleton
    obtain ⟨η, hηinj, hηlin⟩ := wc_hm_line_of_et_tors_qcsep (k ⁻¹ᵁ U).toScheme ℓ (2 * r - 1)
      hfin htop.2

    obtain ⟨av, hav⟩ := hsurj v
    obtain ⟨aw, haw⟩ := hsurj w
    have hav0 : η av ≠ 0 := by
      intro h0
      apply hv
      have h00 : av = 0 := hηinj (h0.trans (map_zero η).symm)
      rw [← hav, h00, map_zero]
    obtain ⟨c, hc⟩ : ∃ c : ℚ_[ℓ], c = η aw / η av := ⟨_, rfl⟩
    refine ⟨c, ?_⟩
    have hsc : wcHMScalar (k ⁻¹ᵁ U).toScheme ℓ (2 * r - 1) c av = aw := by
      apply hηinj
      rw [hηlin, hc, div_mul_cancel₀ _ hav0]
    calc w = δ aw := haw.symm
