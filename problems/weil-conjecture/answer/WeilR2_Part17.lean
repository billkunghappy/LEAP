  rw [hj]
  exact wc_hm_vanish_of_int_ext_vanish (Uodd : Scheme.{u}) ℓ j h3

theorem wc_tns_gen_package : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1}) (hR : Presheaf.IsSheaf J (R0 ⋙ forget₂ CommRingCat RingCat)),
    (∀ K, ((wcTnsGen J R0 hR).obj K).Additive ∧ Limits.PreservesFiniteColimits ((wcTnsGen J R0 hR).obj K)) ∧
    (∀ N, ((wcTnsGen J R0 hR).flip.obj N).Additive ∧
      Limits.PreservesFiniteColimits ((wcTnsGen J R0 hR).flip.obj N)) ∧
    Nonempty (wcTnsGen J R0 hR ≅ (wcTnsGen J R0 hR).flip) ∧
    Nonempty ((wcTnsGen J R0 hR).obj (SheafOfModules.unit
      (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅ 𝟭 _) ∧
    ∀ N, ∃ (P : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))
      (π : P ⟶ N), Epi π ∧ Limits.PreservesFiniteLimits ((wcTnsGen J R0 hR).obj P) :=
by
  intro C _ J _ _ R0 hR

  have hflat : ∀ M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat),
      ∃ (F : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) (e : F ⟶ M),
        Epi e ∧ Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft F) := by
    intro M
    obtain ⟨F, L, i, e, -, hsurj, hF⟩ := wcst_flat_presentation R0 M
    obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 F
    exact ⟨F, e, PresheafOfModules.epi_of_surjective (fun X => hsurj X),
      @wcst_tensorLeft_flat_leftExact _ _ R0 F h1 h2 hF⟩

  have core : ∀ (a : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))
        (ι : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
        (adj : a ⊣ ι)
        (Tns : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})),
        Tns = ι ⋙ MonoidalCategory.curriedTensor _ ⋙ (Functor.whiskeringLeft _ _ _).obj ι ⋙
          (Functor.whiskeringRight _ _ _).obj a →
        IsIso adj.counit → ι.Additive → a.Additive → Limits.PreservesFiniteLimits a →
        Nonempty (ι.obj (SheafOfModules.unit
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅
          MonoidalCategoryStruct.tensorUnit (PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))) →
        (∀ (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
          {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
          IsIso (a.map φ) → IsIso (a.map (MonoidalCategoryStruct.whiskerLeft M φ))) →
        (∀ K, (Tns.obj K).Additive ∧ Limits.PreservesFiniteColimits (Tns.obj K)) ∧
        (∀ N, (Tns.flip.obj N).Additive ∧ Limits.PreservesFiniteColimits (Tns.flip.obj N)) ∧
        Nonempty (Tns ≅ Tns.flip) ∧
        Nonempty (Tns.obj (SheafOfModules.unit
          (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅ 𝟭 _) ∧
        ∀ N, ∃ (P : SheafOfModules.{u+1}
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) (π : P ⟶ N),
          Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P) := by
    intro a ι adj Tns hT hcounit hιadd haadd hafl hU star
    subst hT
    obtain ⟨eU⟩ := hU
    haveI := hcounit
    haveI := hιadd
    haveI := haadd
    haveI := hafl
    haveI : Limits.PreservesLimitsOfSize.{0, 0} ι := adj.rightAdjoint_preservesLimits
    haveI : Limits.PreservesColimitsOfSize.{0, 0} a := adj.leftAdjoint_preservesColimits
    haveI : a.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩

    have starR : ∀ (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
        {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
        IsIso (a.map φ) → IsIso (a.map (MonoidalCategoryStruct.whiskerRight φ M)) := by
      intro M P₁ P₂ φ hφ
      have e : MonoidalCategoryStruct.whiskerRight φ M = (BraidedCategory.braiding P₁ M).hom ≫
          MonoidalCategoryStruct.whiskerLeft M φ ≫ (BraidedCategory.braiding P₂ M).inv := by
        rw [← BraidedCategory.braiding_naturality_left_assoc, Iso.hom_inv_id, Category.comp_id]
      haveI := star M φ hφ
      rw [e, a.map_comp, a.map_comp]
      infer_instance

    have hTR : ∀ M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat),
        (MonoidalCategory.tensorRight M).Additive ∧
          Limits.PreservesFiniteColimits (MonoidalCategory.tensorRight M) := by
      intro M
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 M
      let e : MonoidalCategory.tensorLeft M ≅ MonoidalCategory.tensorRight M :=
        NatIso.ofComponents (fun Y => BraidedCategory.braiding M Y)
          (fun f => BraidedCategory.braiding_naturality_right M f)
      exact ⟨Functor.additive_of_iso e, Limits.preservesFiniteColimits_of_natIso e⟩
    refine ⟨?_, ?_, ⟨?_⟩, ⟨?_⟩, ?_⟩
    ·
      intro K
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 (ι.obj K)
      haveI := h1
      haveI := h2
      haveI : Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a)) :=
        wcst_reflective_preservesFiniteColimits adj _ (fun φ hφ => star (ι.obj K) φ hφ)
      show (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a)).Additive ∧
        Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a))
      exact ⟨inferInstance, inferInstance⟩
    ·
      intro N
      obtain ⟨h1, h2⟩ := hTR (ι.obj N)
      haveI := h1
      haveI := h2
      haveI : Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a)) :=
        wcst_reflective_preservesFiniteColimits adj _ (fun φ hφ => starR (ι.obj N) φ hφ)
      show (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a)).Additive ∧
        Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a))
      exact ⟨inferInstance, inferInstance⟩
    ·
      refine NatIso.ofComponents (fun K => NatIso.ofComponents
        (fun N => a.mapIso (BraidedCategory.braiding (ι.obj K) (ι.obj N))) ?_) ?_
      · intro N N' g
        show a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj K) (ι.map g)) ≫
            a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N')).hom =
          a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N)).hom ≫
            a.map (MonoidalCategoryStruct.whiskerRight (ι.map g) (ι.obj K))
        rw [← a.map_comp, ← a.map_comp, BraidedCategory.braiding_naturality_right]
      · intro K K' f
        refine NatTrans.ext (funext fun N => ?_)
        show a.map (MonoidalCategoryStruct.whiskerRight (ι.map f) (ι.obj N)) ≫
            a.map (BraidedCategory.braiding (ι.obj K') (ι.obj N)).hom =
          a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N)).hom ≫
            a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj N) (ι.map f))
        rw [← a.map_comp, ← a.map_comp, BraidedCategory.braiding_naturality_left]
    ·
      refine NatIso.ofComponents (fun N => a.mapIso (MonoidalCategory.whiskerRightIso eU (ι.obj N) ≪≫
        MonoidalCategoryStruct.leftUnitor (ι.obj N)) ≪≫ asIso (adj.counit.app N)) ?_
      intro N N' g
      show a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj (SheafOfModules.unit
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))) (ι.map g)) ≫
          (a.map (MonoidalCategoryStruct.whiskerRight eU.hom (ι.obj N') ≫
            (MonoidalCategoryStruct.leftUnitor (ι.obj N')).hom) ≫ adj.counit.app N') =
        (a.map (MonoidalCategoryStruct.whiskerRight eU.hom (ι.obj N) ≫
            (MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom) ≫ adj.counit.app N) ≫ g
      rw [← a.map_comp_assoc, MonoidalCategory.whisker_exchange_assoc,
        MonoidalCategory.leftUnitor_naturality]
      have hn : a.map (ι.map g) ≫ adj.counit.app N' = adj.counit.app N ≫ g :=
        adj.counit_naturality g
      simp only [Functor.map_comp, Category.assoc]
      rw [hn]
    ·
      intro N
      obtain ⟨F, e, he, hFfl⟩ := hflat (ι.obj N)
      haveI := he
      haveI := hFfl
      refine ⟨a.obj F, a.map e ≫ adj.counit.app N, inferInstance, ?_⟩
      have hη : IsIso (a.map (adj.unit.app F)) := by
        have h := adj.left_triangle_components F
        haveI : IsIso (a.map (adj.unit.app F) ≫ adj.counit.app (a.obj F)) := by
          rw [h]
          infer_instance
        exact IsIso.of_isIso_comp_right _ (adj.counit.app (a.obj F))
      let θ : ι ⋙ (MonoidalCategory.tensorLeft F ⋙ a) ≅
          ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a) :=
        NatIso.ofComponents (fun Y => @asIso _ _ _ _
            (a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y)))
            (starR (ι.obj Y) (adj.unit.app F) hη))
          (by
            intro Y Y' g
            show a.map (MonoidalCategoryStruct.whiskerLeft F (ι.map g)) ≫
                a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y')) =
              a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y)) ≫
                a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj (a.obj F)) (ι.map g))
            rw [← a.map_comp, ← a.map_comp, MonoidalCategory.whisker_exchange]
            rfl)
      haveI : Limits.PreservesFiniteLimits (ι ⋙ (MonoidalCategory.tensorLeft F ⋙ a)) := inferInstance
      haveI : Limits.PreservesFiniteLimits
          (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a)) :=
        Limits.preservesFiniteLimits_of_natIso θ
      show Limits.PreservesFiniteLimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a))
      infer_instance

  haveI hιA : (SheafOfModules.forget.{u+1}
      (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⋙
      PresheafOfModules.restrictScalars (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat))).Additive :=
    (fun (R : Sheaf J RingCat.{u+1}) => (inferInstance :
      (SheafOfModules.forget.{u+1} R ⋙ PresheafOfModules.restrictScalars.{u+1} (𝟙 R.obj)).Additive)) _
  let adj₀ := PresheafOfModules.sheafificationAdjunction
    (R := (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))
    (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat))
  refine core _ _ adj₀ (wcTnsGen J R0 hR) rfl inferInstance hιA adj₀.left_adjoint_additive
    inferInstance ⟨Iso.refl _⟩ ?_
  intro M P₁ P₂ φ hφ
  have h := (wcst_sheafification_isIso_iff J
    (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) φ).1 hφ
  obtain ⟨F, L, i, e, hex, hsurj, hF⟩ := wcst_flat_presentation R0 M
  have hL := wcst_whiskerLeft_locallySurjective J R0 L φ h.2
  have hFi := wcst_whiskerLeft_locallyInjective_of_flat J R0 F φ hF h.1
  have hMi := wcst_whiskerLeft_locallyInjective_of_presentation J R0 i e hex hsurj φ hL hFi
  have hMs := wcst_whiskerLeft_locallySurjective J R0 M φ h.2
  exact (wcst_sheafification_isIso_iff J
    (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})
    (MonoidalCategoryStruct.whiskerLeft M φ)).2 ⟨hMi, hMs⟩

theorem wc_tns_supp_comparison (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {X : Scheme.{u}}
    (i : X ⟶ S) (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) :
    ∃ θ : (wcTns S ℓ).obj (wcSuppObj D) ⟶
        D.Φ ⋙ @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ,
      ∀ N : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
        ∃ ψ : ((wcTns S ℓ).obj (SheafOfModules.unit (wcRingSheaf S ℓ))).obj N ≅ N,
          ((wcTns S ℓ).map (wcSuppUnitMap D)).app N ≫ θ.app N = ψ.hom ≫ D.adj.unit.app N :=
by
  classical

  have twist_inv : ∃ c' : C(↥X, ULift.{u+1} ℚ_[ℓ]), wcSuppTwist (wcSuppUnitMap D) * c' = 1 := by
    letI := D.cont
    let u0 := SheafOfModules.unitToPushforwardObjUnit D.φ
    let ψ₁ := (D.adj.homEquiv _ _).symm u0
    let h : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ SheafOfModules.unit (wcRingSheaf X ℓ) :=
      D.μ.inv ≫ ψ₁
    have hfac : u0 = wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map h := by
      have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u0 = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
        _ = D.adj.homEquiv _ _ D.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcSuppUnitMap D ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    let cT : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
    let a0 : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom
        (1 : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ]))
    have hu1 : (u0.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ])) :=
      (D.φ.hom.app (Opposite.op T)).hom.map_one
    have hev : (u0.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
        (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ]),
        (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom x = x * a0 := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom.map_smul x
        (1 : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ]))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC i).obj T))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cT * a0 = 1 := by
      rw [← hlin cT, ← hev, hu1]
    refine ⟨a0.comp (Limits.pullback.lift i (𝟙 X)
      ((Category.comp_id i).trans (Category.id_comp i).symm)).base.hom, ?_⟩
    show cT.comp (Limits.pullback.lift i (𝟙 X)
        ((Category.comp_id i).trans (Category.id_comp i).symm)).base.hom *
      a0.comp (Limits.pullback.lift i (𝟙 X)
        ((Category.comp_id i).trans (Category.id_comp i).symm)).base.hom = 1
    rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]

  have twist_formula : ∀ (ρ' : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ wcSuppObj D) (V : S.ProEt)
      (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((ρ'.val.app (Opposite.op V)).hom t : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) =
        t.comp (Limits.pullback.fst V.hom i).base.hom *
          (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom i).base.hom := by
    intro ρ' V t
    have hlam1 : Limits.pullback.lift i (𝟙 X) ((Category.comp_id i).trans (Category.id_comp i).symm) ≫
        Limits.pullback.fst (𝟙 S) i = i := Limits.pullback.lift_fst _ _ _
    have hlam2 : Limits.pullback.lift i (𝟙 X) ((Category.comp_id i).trans (Category.id_comp i).symm) ≫
        Limits.pullback.snd (𝟙 S) i = 𝟙 X := Limits.pullback.lift_snd _ _ _
    let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    let β : Limits.pullback V.hom i ⟶ Limits.pullback (𝟙 S) i := ((wcProEtBC i).map e).left
    have hβw : β ≫ Limits.pullback.snd (𝟙 S) i = Limits.pullback.snd V.hom i :=
      MorphismProperty.Over.w ((wcProEtBC i).map e)
    have hβ : β = Limits.pullback.snd V.hom i ≫
        Limits.pullback.lift i (𝟙 X) ((Category.comp_id i).trans (Category.id_comp i).symm) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
          Category.comp_id]
      · rw [Category.assoc, hlam2, Category.comp_id, hβw]
    let m1 : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    let mT : C(↥(Limits.pullback (𝟙 S) i), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
    have e1 : m1 = mT.comp β.base.hom :=
      PresheafOfModules.naturality_apply ρ'.val e.op (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
    let mt : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op V)).hom t
    let φt : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) :=
      (D.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom i).base.hom := hD V t
    have e2 : mt = t.comp (Limits.pullback.fst V.hom i).base.hom * m1 := by
      have h := (ρ'.val.app (Opposite.op V)).hom.map_smul t (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
      have h' : ((ρ'.val.app (Opposite.op V)).hom (t * 1) :
            C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) = φt * m1 := h
      rw [hφ] at h'
      have h0 : ((ρ'.val.app (Opposite.op V)).hom (t * 1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) :
          C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) = mt :=
        congrArg (fun x => (ρ'.val.app (Opposite.op V)).hom x) (mul_one t)
      exact h0.symm.trans h'
    have e3 : mT.comp (Limits.pullback.snd V.hom i ≫
        Limits.pullback.lift i (𝟙 X) ((Category.comp_id i).trans (Category.id_comp i).symm)).base.hom =
        (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom i).base.hom :=
      ContinuousMap.ext fun _ => rfl
    show mt = _
    rw [e2, e1, hβ, e3]
  obtain ⟨c', hc'⟩ := twist_inv

  have tl : ∀ (M₁ M₂ P : PresheafOfModulesOfCommRing.{u+1} (wcR0 S ℓ))
      (f : ∀ W : (S.ProEt)ᵒᵖ, M₁.obj W → M₂.obj W → P.obj W)
      (h₁ : ∀ W (m m' : M₁.obj W) (n : M₂.obj W), f W (m + m') n = f W m n + f W m' n)
      (h₂ : ∀ W (r : (wcR0 S ℓ).obj W) (m : M₁.obj W) (n : M₂.obj W), f W (r • m) n = r • f W m n)
      (h₃ : ∀ W (m : M₁.obj W) (n n' : M₂.obj W), f W m (n + n') = f W m n + f W m n')
      (h₄ : ∀ W (r : (wcR0 S ℓ).obj W) (m : M₁.obj W) (n : M₂.obj W), f W m (r • n) = r • f W m n)
      (hnat : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (m : M₁.obj W) (n : M₂.obj W),
        (P.map g).hom (f W m n) = f W' ((M₁.map g).hom m) ((M₂.map g).hom n)),
      ∃ β : MonoidalCategoryStruct.tensorObj M₁ M₂ ⟶ P, ∀ (W : (S.ProEt)ᵒᵖ) (m : M₁.obj W)
        (n : M₂.obj W), (β.app W).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] n) = f W m n := by
    intro M₁ M₂ P f h₁ h₂ h₃ h₄ hnat
    refine ⟨PresheafOfModulesOfCommRing.homMk
      (fun W => ModuleCat.MonoidalCategory.tensorLift (f W) (h₁ W) (h₂ W) (h₃ W) (h₄ W)) ?_, ?_⟩
    · intro W W' g
      apply ModuleCat.MonoidalCategory.tensor_ext
      intro m n
      have e1 := PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul (M₁ := M₁) (M₂ := M₂) g m n
      have e2 := ModuleCat.MonoidalCategory.tensorLift_tmul (f W') (h₁ W') (h₂ W') (h₃ W') (h₄ W')
        ((M₁.map g).hom m) ((M₂.map g).hom n)
      have e3 := ModuleCat.MonoidalCategory.tensorLift_tmul (f W) (h₁ W) (h₂ W) (h₃ W) (h₄ W) m n
      change (ModuleCat.MonoidalCategory.tensorLift (f W') (h₁ W') (h₂ W') (h₃ W') (h₄ W')).hom
          (((PresheafOfModulesOfCommRing.Monoidal.tensorObj M₁ M₂).map g).hom
            (m ⊗ₜ[(wcR0 S ℓ).obj W] n)) =
        (P.map g).hom ((ModuleCat.MonoidalCategory.tensorLift (f W) (h₁ W) (h₂ W) (h₃ W)
          (h₄ W)).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] n))
      erw [e1, e2, e3]
      exact (hnat g m n).symm
    · intro W m n
      exact ModuleCat.MonoidalCategory.tensorLift_tmul _ _ _ _ _ m n

  have text : ∀ {M₁ M₂ P : PresheafOfModulesOfCommRing.{u+1} (wcR0 S ℓ)}
      (φ₁ φ₂ : MonoidalCategoryStruct.tensorObj M₁ M₂ ⟶ P),
      (∀ (W : (S.ProEt)ᵒᵖ) (m : M₁.obj W) (n : M₂.obj W),
        (φ₁.app W).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] n) = (φ₂.app W).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] n)) →
      φ₁ = φ₂ := by
    intro M₁ M₂ P φ₁ φ₂ h
    apply PresheafOfModules.hom_ext
    intro W
    exact ModuleCat.MonoidalCategory.tensor_ext (h W)

  let R' : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1} :=
    ⟨wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat, (wcRingSheaf S ℓ).property⟩
  let ι : SheafOfModules.{u+1} R' ⥤ PresheafOfModulesOfCommRing.{u+1} (wcR0 S ℓ) :=
    SheafOfModules.forget R' ⋙
      PresheafOfModules.restrictScalars (𝟙 (wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat))
  let a : PresheafOfModulesOfCommRing.{u+1} (wcR0 S ℓ) ⥤ SheafOfModules.{u+1} R' :=
    PresheafOfModules.sheafification (R := R') (𝟙 (wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat))
  let adj : a ⊣ ι :=
    PresheafOfModules.sheafificationAdjunction (R := R') (𝟙 (wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat))
  let G := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ
  let M : SheafOfModules.{u+1} R' := wcSuppObj D

  let RX : (S.ProEt)ᵒᵖ → RingCat.{u+1} := fun W =>
    (wcRingSheaf X ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj W.unop))
  let PX : SheafOfModules.{u+1} (wcRingSheaf S ℓ) → ∀ W : (S.ProEt)ᵒᵖ, ModuleCat.{u+1} (RX W) :=
    fun N W => (D.Φ.obj N).val.obj (Opposite.op ((wcProEtBC i).obj W.unop))
  let cW : ∀ W : (S.ProEt)ᵒᵖ, C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) := fun W =>
    c'.comp (Limits.pullback.snd W.unop.hom i).base.hom
  let sc : ∀ W : (S.ProEt)ᵒᵖ, (ι.obj M).obj W → RX W := fun W m =>
    (show ↑(RX W) from ((show C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) from m) * cW W))
  let ηv : ∀ (N : SheafOfModules.{u+1} R') (W : (S.ProEt)ᵒᵖ), (ι.obj N).obj W → PX N W :=
    fun N W n => (show ↑(PX N W) from ((D.adj.unit.app N).val.app W).hom n)
  let fN : ∀ (N : SheafOfModules.{u+1} R') (W : (S.ProEt)ᵒᵖ),
      (ι.obj M).obj W → (ι.obj N).obj W → (ι.obj (G.obj (D.Φ.obj N))).obj W :=
    fun N W m n => (show ↑((ι.obj (G.obj (D.Φ.obj N))).obj W) from (sc W m • ηv N W n))
  have h₁ : ∀ N W (m m' : (ι.obj M).obj W) (n : (ι.obj N).obj W),
      fN N W (m + m') n = fN N W m n + fN N W m' n := by
    intro N W m m' n
    show (sc W (m + m')) • ηv N W n = sc W m • ηv N W n + sc W m' • ηv N W n
    rw [← add_smul]
    congr 1
    exact (add_mul (show C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) from m)
      (show C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) from m') (cW W) : _)
  have h₂ : ∀ N W (r : (wcR0 S ℓ).obj W) (m : (ι.obj M).obj W) (n : (ι.obj N).obj W),
      fN N W (r • m) n = r • fN N W m n := by
    intro N W r m n
    show (sc W (r • m)) • ηv N W n =
      (show ↑(RX W) from (D.φ.hom.app W).hom r) • (sc W m • ηv N W n)
    rw [← mul_smul]
    congr 1
    exact mul_assoc _ _ _
  have h₃ : ∀ N W (m : (ι.obj M).obj W) (n n' : (ι.obj N).obj W),
      fN N W m (n + n') = fN N W m n + fN N W m n' := by
    intro N W m n n'
    show sc W m • ηv N W (n + n') = sc W m • ηv N W n + sc W m • ηv N W n'
    rw [← smul_add]
    congr 1
    exact map_add _ _ _
  have h₄ : ∀ N W (r : (wcR0 S ℓ).obj W) (m : (ι.obj M).obj W) (n : (ι.obj N).obj W),
      fN N W m (r • n) = r • fN N W m n := by
    intro N W r m n
    have e : ηv N W (r • n) = (show ↑(RX W) from (D.φ.hom.app W).hom r) • ηv N W n :=
      ((D.adj.unit.app N).val.app W).hom.map_smul r n
    show sc W m • ηv N W (r • n) =
      (show ↑(RX W) from (D.φ.hom.app W).hom r) • (sc W m • ηv N W n)
    rw [e, smul_smul, smul_smul]
    congr 1
    exact (mul_comm (show C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) from sc W m)
      (show C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) from
        (D.φ.hom.app W).hom r) : _)
  have hnat : ∀ N {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (m : (ι.obj M).obj W) (n : (ι.obj N).obj W),
      ((ι.obj (G.obj (D.Φ.obj N))).map g).hom (fN N W m n) =
        fN N W' (((ι.obj M).map g).hom m) (((ι.obj N).map g).hom n) := by
    intro N W W' g m n
    have hw : ((wcProEtBC i).map g.unop).left ≫ Limits.pullback.snd W.unop.hom i =
        Limits.pullback.snd W'.unop.hom i := MorphismProperty.Over.w ((wcProEtBC i).map g.unop)
    have e1 := PresheafOfModules.map_smul (D.Φ.obj N).val ((wcProEtBC i).map g.unop).op
      (sc W m) (ηv N W n)
    have e3 : ((wcRingSheaf X ℓ).obj.map ((wcProEtBC i).map g.unop).op).hom
        (show ↑(RX W) from cW W) = (show ↑(RX W') from cW W') :=
      ContinuousMap.ext fun x =>
        congrArg (fun k : Limits.pullback W'.unop.hom i ⟶ X => c' (k.base x)) hw
    have e2 : ((wcRingSheaf X ℓ).obj.map ((wcProEtBC i).map g.unop).op).hom (sc W m) =
        sc W' (((ι.obj M).map g).hom m) :=
      (map_mul _ _ _).trans (congrArg (fun z => _ * z) e3)
    have e4 : ((D.Φ.obj N).val.map ((wcProEtBC i).map g.unop).op).hom (ηv N W n) =
        ηv N W' (((ι.obj N).map g).hom n) :=
      (PresheafOfModules.naturality_apply (D.adj.unit.app N).val g n).symm
    show ((D.Φ.obj N).val.map ((wcProEtBC i).map g.unop).op).hom (sc W m • ηv N W n) =
      sc W' (((ι.obj M).map g).hom m) • ηv N W' (((ι.obj N).map g).hom n)
    rw [e1, e2, e4]
    rfl
  obtain ⟨β, hβ⟩ : ∃ β : ∀ N : SheafOfModules.{u+1} R',
      MonoidalCategoryStruct.tensorObj (ι.obj M) (ι.obj N) ⟶ ι.obj (G.obj (D.Φ.obj N)),
      ∀ N W m n, ((β N).app W).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] n) = fN N W m n := by
    choose β hβ using fun N => tl (ι.obj M) (ι.obj N) (ι.obj (G.obj (D.Φ.obj N))) (fN N)
      (h₁ N) (h₂ N) (h₃ N) (h₄ N) (fun g m n => hnat N g m n)
    exact ⟨β, hβ⟩

  have hNβ : ∀ {N N' : SheafOfModules.{u+1} R'} (g : N ⟶ N'),
      MonoidalCategoryStruct.whiskerLeft (ι.obj M) (ι.map g) ≫ β N' =
        β N ≫ ι.map (G.map (D.Φ.map g)) := by
    intro N N' g
    apply text
    intro W m n
    have hu : ((D.Φ.map g).val.app (Opposite.op ((wcProEtBC i).obj W.unop))).hom (ηv N W n) =
        ηv N' W ((g.val.app W).hom n) :=
      congrArg (fun φ => (φ.val.app W).hom n) (D.adj.unit_naturality g)
    change ((β N').app W).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] ((g.val.app W).hom n)) =
      ((G.map (D.Φ.map g)).val.app W).hom (((β N).app W).hom (m ⊗ₜ[(wcR0 S ℓ).obj W] n))
    refine (hβ N' W m ((g.val.app W).hom n)).trans ?_
    refine Eq.trans ?_
      (congrArg (fun x => ((G.map (D.Φ.map g)).val.app W).hom x) (hβ N W m n)).symm
    change sc W m • ηv N' W ((g.val.app W).hom n) =
      ((D.Φ.map g).val.app (Opposite.op ((wcProEtBC i).obj W.unop))).hom (sc W m • ηv N W n)
    rw [← hu]
    exact (LinearMap.map_smul _ _ _).symm

  have hUβ : ∀ N : SheafOfModules.{u+1} R',
      MonoidalCategoryStruct.whiskerRight (ι.map (wcSuppUnitMap D)) (ι.obj N) ≫ β N =
        (MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom ≫ ι.map (D.adj.unit.app N) := by
    intro N
    apply text
    intro W r n
    let r' : ↑((wcR0 S ℓ).obj W) := r
    change ((β N).app W).hom (((wcSuppUnitMap D).val.app W).hom r' ⊗ₜ[(wcR0 S ℓ).obj W] n) =
      ((D.adj.unit.app N).val.app W).hom (r' • n)
    refine (hβ N W _ n).trans ?_
    have hs : sc W (((wcSuppUnitMap D).val.app W).hom r') =
        (show ↑(RX W) from (D.φ.hom.app W).hom r') := by
      show (show C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ]) from
          ((wcSuppUnitMap D).val.app W).hom r') * cW W = (D.φ.hom.app W).hom r'
      rw [twist_formula (wcSuppUnitMap D) W.unop r', hD W.unop r', mul_assoc,
        ← ContinuousMap.mul_comp, hc', ContinuousMap.one_comp, mul_one]
    change sc W (((wcSuppUnitMap D).val.app W).hom r') • ηv N W n = _
    rw [hs]
    exact (((D.adj.unit.app N).val.app W).hom.map_smul r' n).symm

  let θ : (wcTns S ℓ).obj (wcSuppObj D) ⟶ D.Φ ⋙ G :=
    { app := fun N => (adj.homEquiv _ _).symm (β N)
      naturality := by
        intro N N' g
        have e1 := adj.homEquiv_naturality_left_symm
          (MonoidalCategoryStruct.whiskerLeft (ι.obj M) (ι.map g)) (β N')
        have e2 := adj.homEquiv_naturality_right_symm (β N) (G.map (D.Φ.map g))
        rw [hNβ g] at e1
        exact e1.symm.trans e2 }

  let ψ : ∀ N : SheafOfModules.{u+1} R',
      a.obj (MonoidalCategoryStruct.tensorObj (ι.obj (SheafOfModules.unit R')) (ι.obj N)) ≅ N :=
    fun N => a.mapIso (MonoidalCategoryStruct.leftUnitor (ι.obj N)) ≪≫
      @asIso _ _ _ _ (adj.counit.app N) (NatIso.isIso_app_of_isIso adj.counit N)
  have key : ∀ N : SheafOfModules.{u+1} R',
      a.map (MonoidalCategoryStruct.whiskerRight (ι.map (wcSuppUnitMap D)) (ι.obj N)) ≫
        (adj.homEquiv _ _).symm (β N) =
      (a.map (MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom ≫ adj.counit.app N) ≫
        D.adj.unit.app N := by
    intro N
    have e1 := adj.homEquiv_naturality_left_symm
      (MonoidalCategoryStruct.whiskerRight (ι.map (wcSuppUnitMap D)) (ι.obj N)) (β N)
    rw [hUβ N] at e1
    have e2 := adj.homEquiv_counit _ _
      ((MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom ≫ ι.map (D.adj.unit.app N))
    have e3 := adj.counit_naturality (D.adj.unit.app N)
    refine e1.symm.trans ?_
    refine e2.trans ?_
    refine (congrArg (fun k => k ≫ adj.counit.app (G.obj (D.Φ.obj N))) (a.map_comp _ _)).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (fun k => a.map (MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom ≫ k)
      e3).trans ?_
    exact (Category.assoc _ _ _).symm
  exact ⟨θ, fun N => ⟨ψ N, key N⟩⟩

theorem wc_tns_supp_sections_off (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {X : Scheme.{u}}
    (i : X ⟶ S) (D : wcHMPullData i ℓ) (N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (W : S.ProEt)
    (hW : ∀ x : ↥W.left, W.hom x ∉ Set.range i) :
    Subsingleton ↑((((wcTns S ℓ).obj (wcSuppObj D)).obj N).val.obj (Opposite.op W)) :=
by
  classical

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (P : PresheafOfModules.{u+1} R.obj) (U : C),
      (∀ (V : C) (_ : V ⟶ U), Subsingleton ↑(P.obj (Opposite.op V))) →
      Subsingleton ↑(((PresheafOfModules.sheafification.{u+1} (𝟙 R.obj)).obj P).val.obj
        (Opposite.op U)) := by
    intro C _ J _ _ R P U hP
    let f := (PresheafOfModules.toPresheaf R.obj).map
      ((PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).unit.app P)
    have hf : f = toSheafify J P.presheaf :=
      PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app (𝟙 R.obj) P
    have : Presheaf.IsLocallySurjective J f := by
      rw [hf]; exact Presheaf.isLocallySurjective_toSheafify' J P.presheaf
    have hsep := (((PresheafOfModules.sheafification (𝟙 R.obj)).obj P).isSheaf).isSeparated
    have hzero : ∀ x : ↑(((PresheafOfModules.sheafification.{u+1} (𝟙 R.obj)).obj P).val.obj
        (Opposite.op U)), x = 0 := by
      intro x
      refine hsep U (Presheaf.imageSieve f x) (Presheaf.imageSieve_mem J f x) x 0 ?_
      intro V g hg
      obtain ⟨t, ht⟩ := hg
      have ht0 : t = 0 := @Subsingleton.elim _ (hP V g) t 0
      rw [map_zero]
      rw [ht0, map_zero] at ht
      exact ht.symm
    exact ⟨fun x y => (hzero x).trans (hzero y).symm⟩

  have s3 : ∀ {C : Type (u+1)} [Category.{u} C] (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
      (A B : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) (V : Cᵒᵖ),
      Subsingleton ↑(A.obj V) → Subsingleton ↑((MonoidalCategoryStruct.tensorObj A B).obj V) := by
    intro C _ R0 A B V hA
    change Subsingleton (TensorProduct (R0.obj V) (A.obj V) (B.obj V))
    infer_instance

  have hM : ∀ (V : S.ProEt) (_ : V ⟶ W),
      Subsingleton ↑((wcSuppObj D).val.obj (Opposite.op V)) := by
    intro V g
    have hEmpty : IsEmpty ↥(Limits.pullback V.hom i) :=
      Scheme.isEmpty_pullback V.hom i (Set.disjoint_left.2 (by
        rintro _ ⟨w, rfl⟩ ⟨x, hx⟩
        apply hW (g.left w)
        refine ⟨x, ?_⟩
        rw [hx, ← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]))
    haveI : IsEmpty ((wcProEtBC i).obj V).left := hEmpty
    exact AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcRingSheaf X ℓ)).obj
        (SheafOfModules.unit (wcRingSheaf X ℓ))) ((wcProEtBC i).obj V)
        (Scheme.ProEt.bot_mem_topology _)).isZero

  have hP : ∀ (V : S.ProEt) (_ : V ⟶ W), Subsingleton ↑((MonoidalCategoryStruct.tensorObj
      ((SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars
        (𝟙 (wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat))).obj (wcSuppObj D))
      ((SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars
        (𝟙 (wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat))).obj N)).obj (Opposite.op V)) :=
    fun V g => s3 (wcR0 S ℓ) _ _ (Opposite.op V) (hM V g)

  exact s1 (Scheme.ProEt.topology S)
    ⟨wcR0 S ℓ ⋙ forget₂ CommRingCat RingCat, (wcRingSheaf S ℓ).property⟩ _ W hP

theorem wc_sheaf_tensor_closed_proj_formula (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [IsLocallyNoetherian S] :
    ∃ Tns : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤
        SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (∀ K, (Tns.obj K).Additive ∧ Limits.PreservesFiniteColimits (Tns.obj K)) ∧
      (∀ N, (Tns.flip.obj N).Additive ∧ Limits.PreservesFiniteColimits (Tns.flip.obj N)) ∧
      Nonempty (Tns ≅ Tns.flip) ∧
      Nonempty (Tns.obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅ 𝟭 _) ∧
      (∀ N, ∃ (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (π : P ⟶ N),
        Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P)) ∧
      ∀ {X : Scheme.{u}} (i : X ⟶ S) [IsClosedImmersion i] (D : wcHMPullData i ℓ),
        wcHMPullCanonical D →
        Nonempty (Tns.obj (wcSuppObj D) ≅
          D.Φ ⋙ @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) :=
by
  classical

  have hpkg : (∀ K, ((wcTns S ℓ).obj K).Additive ∧
        Limits.PreservesFiniteColimits ((wcTns S ℓ).obj K)) ∧
      (∀ N, ((wcTns S ℓ).flip.obj N).Additive ∧
        Limits.PreservesFiniteColimits ((wcTns S ℓ).flip.obj N)) ∧
      Nonempty (wcTns S ℓ ≅ (wcTns S ℓ).flip) ∧
      Nonempty ((wcTns S ℓ).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅ 𝟭 _) ∧
      (∀ N, ∃ (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (π : P ⟶ N),
        Epi π ∧ Limits.PreservesFiniteLimits ((wcTns S ℓ).obj P)) :=
    wc_tns_gen_package (Scheme.ProEt.topology S) (wcR0 S ℓ) (wcRingSheaf S ℓ).property
  obtain ⟨hT1, hT2, hT3, hT4, hT5⟩ := hpkg
  refine ⟨wcTns S ℓ, hT1, hT2, hT3, hT4, hT5, ?_⟩

  intro X i _ D hD
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  let V : S.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hV : (V : Set S) = (Set.range i)ᶜ := rfl
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists V.ι ℓ
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim

  have hstar : ∀ N : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Limits.IsZero (Dj.Φ.obj N) → Limits.IsZero (D.Φ.obj N) → Limits.IsZero N := by
    intro N hj hi
    have hall := wc_proet_closed_module_zero_of_local_vanishing i
      wc_proet_affine_sieve_finite_jointly_surjective wc_proet_compact_affine_open_cover N
      (wc_proet_open_pull_isZero_vanish_off i ℓ V hV Dj hDj N hj)
      (wc_proet_closed_pull_isZero_local_factor i ℓ wc_lan_flat_unit_eq_zero_factor D hD N hi)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    ext x
    rw [hall W.unop x]
    simp only [map_zero]
  haveI : Dj.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : Dj.Φ.PreservesEpimorphisms := preservesEpimorphisms_of_preservesColimitsOfShape _
  haveI : D.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : D.Φ.PreservesEpimorphisms := preservesEpimorphisms_of_preservesColimitsOfShape _

  obtain ⟨hfull, hfaith⟩ := wc_proet_closed_push_modules_full_faithful i ℓ D hD
  haveI := hfull
  haveI := hfaith
  haveI hε : IsIso D.adj.counit := D.adj.counit_isIso_of_R_fully_faithful
  have hΦη : ∀ N, IsIso (D.Φ.map (D.adj.unit.app N)) := by
    intro N
    have h := D.adj.left_triangle_components N
    have hc : IsIso (D.Φ.map (D.adj.unit.app N) ≫ D.adj.counit.app (D.Φ.obj N)) := by
      rw [h]; infer_instance
    exact IsIso.of_isIso_comp_right _ (D.adj.counit.app (D.Φ.obj N))

  obtain ⟨θ, hθ⟩ := wc_tns_supp_comparison S ℓ i D hD

  haveI hu : Epi (wcSuppUnitMap D) := wc_supp_unit_epi_of_noetherian i ℓ D hD

  have hjT : ∀ N, Limits.IsZero (Dj.Φ.obj (((wcTns S ℓ).obj (wcSuppObj D)).obj N)) := by
    intro N
    have hunit : Dj.adj.unit.app (((wcTns S ℓ).obj (wcSuppObj D)).obj N) = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      ext t
      have ht : ∀ (W' : S.ProEt) (g : W' ⟶ W.unop),
          (∀ x : ↥W'.left, W'.hom x ∈ (V : Set ↥S)) →
          ((((wcTns S ℓ).obj (wcSuppObj D)).obj N).val.map g.op).hom t = 0 := by
        intro W' g hW'
        have hsub := wc_tns_supp_sections_off S ℓ i D N W' (fun x => hW' x)
        exact @Subsingleton.elim _ hsub _ _
      have hk := wc_proet_open_unit_kills_vanishing_section V ℓ Dj hDj _ W.unop t ht
      refine hk.trans ?_
      symm
      first
        | rfl
        | simp
        | (erw [SheafOfModules.zero_val]; rfl)
    rw [Limits.IsZero.iff_id_eq_zero, ← Dj.adj.left_triangle_components, hunit, Functor.map_zero,
      Limits.zero_comp]

  have hiso : ∀ N, IsIso (θ.app N) := by
    intro N
    obtain ⟨ψ, hψ⟩ := hθ N
    have hp : Epi (((wcTns S ℓ).map (wcSuppUnitMap D)).app N) := by
      haveI : Limits.PreservesFiniteColimits ((wcTns S ℓ).flip.obj N) := (hT2 N).2
      haveI : ((wcTns S ℓ).flip.obj N).PreservesEpimorphisms :=
        preservesEpimorphisms_of_preservesColimitsOfShape _
      rw [← Functor.flip_obj_map]
      exact Functor.map_epi _ _
    haveI := hp
    have hcomp : D.Φ.map (((wcTns S ℓ).map (wcSuppUnitMap D)).app N) ≫ D.Φ.map (θ.app N) =
        D.Φ.map ψ.hom ≫ D.Φ.map (D.adj.unit.app N) := by
      rw [← D.Φ.map_comp, ← D.Φ.map_comp, hψ]
    haveI := hΦη N
    have hΦp : IsIso (D.Φ.map (((wcTns S ℓ).map (wcSuppUnitMap D)).app N)) := by
      haveI : Mono (D.Φ.map (((wcTns S ℓ).map (wcSuppUnitMap D)).app N) ≫
          D.Φ.map (θ.app N)) := by
        rw [hcomp]; infer_instance
      haveI := mono_of_mono (D.Φ.map (((wcTns S ℓ).map (wcSuppUnitMap D)).app N))
        (D.Φ.map (θ.app N))
      exact isIso_of_mono_of_epi _
    haveI := hΦp
    haveI hΦθ : IsIso (D.Φ.map (θ.app N)) := by
      haveI : IsIso (D.Φ.map (((wcTns S ℓ).map (wcSuppUnitMap D)).app N) ≫
          D.Φ.map (θ.app N)) := by
        rw [hcomp]; infer_instance
      exact IsIso.of_isIso_comp_left (D.Φ.map (((wcTns S ℓ).map (wcSuppUnitMap D)).app N)) _
    have hmono : Mono (θ.app N) := by
      apply Abelian.mono_of_kernel_ι_eq_zero
      have h1 : Limits.IsZero (Dj.Φ.obj (Limits.kernel (θ.app N))) :=
        Limits.IsZero.of_mono (Dj.Φ.map (Limits.kernel.ι (θ.app N))) (hjT N)
      have h2 : D.Φ.map (Limits.kernel.ι (θ.app N)) = 0 := by
        rw [← cancel_mono (D.Φ.map (θ.app N)), ← D.Φ.map_comp, Limits.kernel.condition,
          D.Φ.map_zero, Limits.zero_comp]
      have h3 : Limits.IsZero (D.Φ.obj (Limits.kernel (θ.app N))) :=
        Limits.IsZero.of_mono_eq_zero _ h2
      exact (hstar _ h1 h3).eq_of_src _ _
    have hepi : Epi (θ.app N) := by
      apply Abelian.epi_of_cokernel_π_eq_zero
      have h0 := wc_proet_open_pull_closed_push_isZero i ℓ V hV D Dj hDj (D.Φ.obj N)
      have h1 : Limits.IsZero (Dj.Φ.obj (Limits.cokernel (θ.app N))) :=
        Limits.IsZero.of_epi (Dj.Φ.map (Limits.cokernel.π (θ.app N))) h0
      have h2 : D.Φ.map (Limits.cokernel.π (θ.app N)) = 0 := by
        rw [← cancel_epi (D.Φ.map (θ.app N)), ← D.Φ.map_comp, Limits.cokernel.condition,
          D.Φ.map_zero, Limits.comp_zero]
      have h3 : Limits.IsZero (D.Φ.obj (Limits.cokernel (θ.app N))) :=
        Limits.IsZero.of_epi_eq_zero _ h2
      exact (hstar _ h1 h3).eq_of_tgt _ _
    haveI := hmono
    haveI := hepi
    exact isIso_of_mono_of_epi _
  haveI := @NatIso.isIso_of_isIso_app _ _ _ _ _ _ θ hiso
  exact ⟨asIso θ⟩

theorem wc_closed_supp_right_proj_formula {X Y : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (hex : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ))
    (k j N : ℕ) (hk : Even k) (hN : k + j = N) (hN' : j + k = N)
    (τ : wcSuppExt D k) (ω : wcHM Y ℓ j) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    τ.comp ω hN = wcSuppGysin D hex j k N hN' (wcHMPull D j ω) τ :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI hGadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).Additive :=
    Adjunction.right_adjoint_additive D.adj
  haveI hGlim : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) := by
    haveI := D.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI hGcolim := hex
  haveI hGfull : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).Full :=
    (wc_proet_closed_push_modules_full_faithful i ℓ D hD).1
  show τ.comp ω hN = (Abelian.Ext.mapExactFunctor
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
    (wcHMPull D j ω)).comp τ hN'
  obtain ⟨Tns, hT1, hT2, ⟨β⟩, ⟨lam⟩, hfl, hPF⟩ := wc_sheaf_tensor_closed_proj_formula Y ℓ
  obtain ⟨ψ⟩ := hPF i D hD
  haveI i1 : ∀ K, (Tns.obj K).Additive := fun K => (hT1 K).1
  haveI i2 : ∀ K, Limits.PreservesFiniteColimits (Tns.obj K) := fun K => (hT1 K).2
  haveI i3 : ∀ N, (Tns.flip.obj N).Additive := fun N => (hT2 N).1
  haveI i4 : ∀ N, Limits.PreservesFiniteColimits (Tns.flip.obj N) := fun N => (hT2 N).2
  haveI hMfl : Limits.PreservesFiniteLimits (Tns.obj (wcSuppObj D)) :=
    Limits.preservesFiniteLimits_of_natIso ψ.symm
  set U := SheafOfModules.unit (wcRingSheaf Y ℓ) with hU
  have hsmulL : ∀ {A₁ A₂ A₃ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} {a b c : ℕ}
      (α : Abelian.Ext A₁ A₂ a) (γ : Abelian.Ext A₂ A₃ b) (h : a + b = c) (n : ℤ),
      (n • α).comp γ h = n • α.comp γ h := by
    intro A₁ A₂ A₃ a b c α γ h n
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, AddMonoidHom.zsmul_apply,
      Abelian.Ext.bilinearComp_apply_apply]
  have hsmulR : ∀ {A₁ A₂ A₃ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} {a b c : ℕ}
      (α : Abelian.Ext A₁ A₂ a) (γ : Abelian.Ext A₂ A₃ b) (h : a + b = c) (n : ℤ),
      α.comp (n • γ) h = n • α.comp γ h := by
    intro A₁ A₂ A₃ a b c α γ h n
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, Abelian.Ext.bilinearComp_apply_apply]
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ∀ K, (Tns.obj K).obj U ≅ K,
      ∀ K, ρ K = (β.app K).app U ≪≫ lam.app K := ⟨_, fun _ => rfl⟩
  have hρ : ∀ {K K' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : K ⟶ K'),
      (Tns.map f).app U ≫ (ρ K').hom = (ρ K).hom ≫ f := by
    intro K K' f
    have h1 := congrArg (fun t => t.app U) (β.hom.naturality f)
    have h2 := lam.hom.naturality f
    simp only [NatTrans.comp_app, Functor.flip_map_app, Functor.id_map] at h1 h2
    rw [hρdef, hρdef]
    simp only [Iso.trans_hom, Iso.app_hom]
    rw [← Category.assoc, h1, Category.assoc, Category.assoc, h2]
  have hρ' : ∀ {K K' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : K ⟶ K'),
      (ρ K).inv ≫ (Tns.map f).app U = f ≫ (ρ K').inv := by
    intro K K' f
    rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
    exact hρ f

  have hmk : ∀ {A₁ A₂ A₃ A₄ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : A₁ ⟶ A₂) (g : A₂ ⟶ A₃)
      {n : ℕ} (z : Abelian.Ext A₃ A₄ n),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add n) := by
    intro A₁ A₂ A₃ A₄ f g n z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have hmk' : ∀ {A₁ A₂ A₃ A₄ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} {n : ℕ}
      (z : Abelian.Ext A₁ A₂ n) (f : A₂ ⟶ A₃) (g : A₃ ⟶ A₄),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro A₁ A₂ A₃ A₄ n z f g
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hA0 : ∀ {A₁ A₂ A₃ A₄ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} {a b c : ℕ} (f : A₁ ⟶ A₂)
      (β' : Abelian.Ext A₂ A₃ a) (γ : Abelian.Ext A₃ A₄ b) (h : a + b = c),
      ((Abelian.Ext.mk₀ f).comp β' (zero_add a)).comp γ h =
        (Abelian.Ext.mk₀ f).comp (β'.comp γ h) (zero_add c) := by
    intro A₁ A₂ A₃ A₄ a b c f β' γ h
    exact Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)
  haveI hUfl : Limits.PreservesFiniteLimits (Tns.obj U) :=
    Limits.preservesFiniteLimits_of_natIso lam.symm

  have P1 : (Abelian.Ext.mk₀ (ρ U).inv).comp
      ((Abelian.Ext.mapExactFunctor (Tns.obj U) ω).comp (Abelian.Ext.mk₀ (ρ U).hom) (add_zero j))
      (zero_add j) = ω := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp ω lam.hom
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    have hc := wc_hm_unit_end_central Y ℓ ((lam.app U).inv ≫ (ρ U).hom) j ω
    have hρU : (ρ U).hom = lam.hom.app U ≫ ((lam.app U).inv ≫ (ρ U).hom) := by
      rw [← Category.assoc, ← Iso.app_hom, Iso.hom_inv_id, Category.id_comp]
    conv_lhs => rw [hρU, ← hmk', h, Abelian.Ext.comp_assoc_of_third_deg_zero, ← hc,
      hmk (lam.hom.app U) ((lam.app U).inv ≫ (ρ U).hom) ω, ← hρU, hmk, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]

  have P2 : ∀ (K K' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      [Limits.PreservesFiniteLimits (Tns.obj K)] [Limits.PreservesFiniteLimits (Tns.obj K')]
      (f : K ⟶ K'),
      ((Abelian.Ext.mk₀ (ρ K).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K) ω).comp (Abelian.Ext.mk₀ (ρ K).hom) (add_zero j))
        (zero_add j)).comp (Abelian.Ext.mk₀ f) (add_zero j) =
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ (ρ K').inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K') ω).comp (Abelian.Ext.mk₀ (ρ K').hom) (add_zero j))
        (zero_add j)) (zero_add j) := by
    intro K K' _ _ f
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp ω (Tns.map f)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hmk', ← hρ f, ← hmk', h,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hmk, hρ' f, ← hmk]

  have P3 : ∀ {X₁ X₂ X₃ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
      (hfg : f ≫ g = 0) (hT : (ShortComplex.mk f g hfg).ShortExact)
      [Limits.PreservesFiniteLimits (Tns.obj X₁)] [Limits.PreservesFiniteLimits (Tns.obj X₂)]
      [Limits.PreservesFiniteLimits (Tns.obj X₃)] (m : ℕ) (h₁ : j + 1 = m) (h₂ : 1 + j = m),
      ((Abelian.Ext.mk₀ (ρ X₃).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj X₃) ω).comp (Abelian.Ext.mk₀ (ρ X₃).hom) (add_zero j))
        (zero_add j)).comp hT.extClass h₁ =
      ((-1 : ℤ) ^ j) • hT.extClass.comp ((Abelian.Ext.mk₀ (ρ X₁).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj X₁) ω).comp (Abelian.Ext.mk₀ (ρ X₁).hom) (add_zero j))
        (zero_add j)) h₂ := by
    intro X₁ X₂ X₃ f g hfg hT _ _ _ m h₁ h₂
    have hzero : ∀ N, (Tns.map f).app N ≫ (Tns.map g).app N = 0 := by
      intro N
      rw [← Functor.flip_obj_map, ← Functor.flip_obj_map, ← Functor.map_comp, hfg,
        Functor.map_zero]
    have h5 := tensor_flat_two_of_three Tns ⟨β⟩ hfl (ShortComplex.mk f g hfg) hT
      (show Limits.PreservesFiniteLimits (Tns.obj X₃) from inferInstance)
    have hS : ∀ N, (ShortComplex.mk ((Tns.map f).app N) ((Tns.map g).app N)
        (hzero N)).ShortExact := fun N => h5.1 N
    have hs3 := ext_mapExact_ses_sign (Tns.obj X₁) (Tns.obj X₂) (Tns.obj X₃) (Tns.map f)
      (Tns.map g) hzero hS ω h₁ h₂
    have hM : (hS U).extClass.comp (Abelian.Ext.mk₀ (ρ X₁).hom) (add_zero 1) =
        (Abelian.Ext.mk₀ (ρ X₃).hom).comp hT.extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality (hS U) hT
        (ShortComplex.homMk (ρ X₁).hom (ρ X₂).hom (ρ X₃).hom (hρ f).symm (hρ g).symm)
    have hN0 : hT.extClass.comp (Abelian.Ext.mk₀ (ρ X₁).inv) (add_zero 1) =
        (Abelian.Ext.mk₀ (ρ X₃).inv).comp (hS U).extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality hT (hS U)
        (ShortComplex.homMk (ρ X₁).inv (ρ X₂).inv (ρ X₃).inv (hρ' f) (hρ' g))
    conv_lhs => rw [hA0, Abelian.Ext.comp_assoc_of_second_deg_zero, ← hM,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hs3, hsmulL,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hsmulR, ← hA0, ← hN0,
      Abelian.Ext.comp_assoc_of_second_deg_zero]

  have C : ∀ (n : ℕ) (K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      [Limits.PreservesFiniteLimits (Tns.obj K)] (z : Abelian.Ext K U n) (m : ℕ)
      (h₁ : j + n = m) (h₂ : n + j = m),
      ((Abelian.Ext.mk₀ (ρ K).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K) ω).comp (Abelian.Ext.mk₀ (ρ K).hom) (add_zero j))
        (zero_add j)).comp z h₁ = ((-1 : ℤ) ^ (j * n)) • z.comp ω h₂ := by
    intro n
    induction n with
    | zero =>
      intro K _ z m h₁ h₂
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective K U).2 z
      obtain rfl : m = j := by omega
      rw [P2 K U f, P1, mul_zero, pow_zero, one_smul]
    | succ n ih =>
      intro K _ z m h₁ h₂
      obtain ⟨E', π, hπ, hz⟩ := ext_epi_effaces z
      obtain ⟨P, q, hq, hP⟩ := hfl E'
      haveI := hπ
      haveI := hq
      haveI := hP
      have hpz : (Abelian.Ext.mk₀ (q ≫ π)).comp z (zero_add (n + 1)) = 0 := by
        rw [← hmk, hz, Abelian.Ext.comp_zero]
      have hT : (ShortComplex.mk (Limits.kernel.ι (q ≫ π)) (q ≫ π)
          (Limits.kernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.kernelSequence_exact (q ≫ π))
          (show Mono (Limits.kernel.ι (q ≫ π)) from inferInstance)
          (show Epi (q ≫ π) from inferInstance)
      have h5 := tensor_flat_two_of_three Tns ⟨β⟩ hfl _ hT
        (show Limits.PreservesFiniteLimits (Tns.obj K) from inferInstance)
      haveI hK' : Limits.PreservesFiniteLimits (Tns.obj (Limits.kernel (q ≫ π))) := h5.2 hP
      obtain ⟨z'', rfl⟩ := Abelian.Ext.contravariant_sequence_exact₃ hT U z hpz
        (show 1 + n = n + 1 by omega)
      rw [← Abelian.Ext.comp_assoc _ hT.extClass z'' (show j + 1 = j + 1 from rfl)
          (show 1 + n = n + 1 by omega) (show j + 1 + n = m by omega),
        P3 _ _ _ hT (j + 1) rfl (by omega), hsmulL,
        Abelian.Ext.comp_assoc hT.extClass _ z'' (show 1 + j = j + 1 by omega)
          (show j + n = n + j by omega) (show 1 + j + n = m by omega),
        ih _ z'' (n + j) (by omega) rfl, hsmulR, smul_smul,
        Abelian.Ext.comp_assoc hT.extClass z'' ω (show 1 + n = n + 1 by omega)
          (show n + j = n + j from rfl) (show 1 + n + j = m by omega)]
      have hs : ((-1 : ℤ) ^ j * (-1) ^ (j * n)) = (-1) ^ (j * (n + 1)) := by ring
      rw [hs]

  have hfin := C k (wcSuppObj D) τ N hN' hN
  rw [(hk.mul_left j).neg_one_pow, one_smul] at hfin

  have h7c : wcHMPull D j ω = (Abelian.Ext.mk₀ D.μ.inv).comp
      ((Abelian.Ext.mapExactFunctor D.Φ ω).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j))
      (zero_add j) := rfl
  have h7Y : Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
      (wcHMPull D j ω) =
      (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).map D.μ.inv)).comp
      ((Abelian.Ext.mapExactFunctor
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
        (Abelian.Ext.mapExactFunctor D.Φ ω)).comp
        (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          D.cont D.φ).map D.μ.hom)) (add_zero j)) (zero_add j) := by
    rw [h7c, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀]
  have hGΦ : Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
      (Abelian.Ext.mapExactFunctor D.Φ ω) =
      (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).map D.μ.hom)).comp
      ((Abelian.Ext.mapExactFunctor
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
        (wcHMPull D j ω)).comp
        (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          D.cont D.φ).map D.μ.inv)) (add_zero j)) (zero_add j) := by
    rw [h7Y, hA0, hmk', hmk, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id, CategoryTheory.Functor.map_id,
      Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_mk₀_id]
  obtain ⟨a, ha⟩ : ∃ a : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).obj (SheafOfModules.unit (wcRingSheaf X ℓ)) ⟶
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).obj (SheafOfModules.unit (wcRingSheaf X ℓ)),
      a = ((ρ (wcSuppObj D)).inv ≫ ψ.hom.app U) ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map D.μ.hom :=
    ⟨_, rfl⟩
  obtain ⟨a', ha'⟩ : ∃ a' : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).obj (SheafOfModules.unit (wcRingSheaf X ℓ)) ⟶
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).obj (SheafOfModules.unit (wcRingSheaf X ℓ)),
      a' = (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
        D.μ.inv ≫ (ψ.inv.app U ≫ (ρ (wcSuppObj D)).hom) :=
    ⟨_, rfl⟩
  have haa' : a ≫ a' = 𝟙 _ := by
    rw [ha, ha']
    exact (((ρ (wcSuppObj D)).symm ≪≫ ψ.app U) ≪≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).mapIso
        D.μ).hom_inv_id
  have hcent : (Abelian.Ext.mk₀ a).comp (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
      (wcHMPull D j ω)) (zero_add j) =
      (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
      (wcHMPull D j ω)).comp (Abelian.Ext.mk₀ a) (add_zero j) := by
    have hc := (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
      D.cont D.φ).map_preimage a
    have hXc := wc_hm_unit_end_central X ℓ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC i) _ _ D.cont D.φ).preimage a) j (wcHMPull D j ω)
    rw [← hc, ← Abelian.Ext.mapExactFunctor_mk₀, ← Abelian.Ext.mapExactFunctor_comp, hXc,
      Abelian.Ext.mapExactFunctor_comp]
  have hε : (Abelian.Ext.mk₀ (ρ (wcSuppObj D)).inv).comp
      ((Abelian.Ext.mapExactFunctor (Tns.obj (wcSuppObj D)) ω).comp
        (Abelian.Ext.mk₀ (ρ (wcSuppObj D)).hom) (add_zero j)) (zero_add j) =
      Abelian.Ext.mapExactFunctor
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
        (wcHMPull D j ω) := by
    have h7a := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp ω ψ.hom
    have h7b := Abelian.Ext.comp_mapExactFunctor ω D.Φ
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
    have hρM : (ρ (wcSuppObj D)).hom = ψ.hom.app U ≫ (ψ.inv.app U ≫ (ρ (wcSuppObj D)).hom) := by
      rw [Iso.hom_inv_id_app_assoc]
    conv_lhs => rw [hρM]
    rw [← hmk', h7a, Abelian.Ext.comp_assoc_of_third_deg_zero, hmk, h7b, hGΦ, hA0, hmk', hmk,
      ← ha, ← ha', ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    erw [hcent]
    erw [hmk', haa']
    exact Abelian.Ext.comp_mk₀_id _
  rw [hε] at hfin
  exact hfin.symm

theorem wc_qsf_quad_prime (K : Type u) [Field K] (d : ℕ) (hd1 : 1 ≤ d)
    (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0) :
    Prime ((wcLdpQuad K (d + 1) a : MvPolynomial (Fin (d + 1 + 1)) K)) :=
by
  classical
  set G : MvPolynomial (Fin (d + 1 + 1)) K :=
    (wcLdpQuad K (d + 1) a : MvPolynomial (Fin (d + 1 + 1)) K) with hGdef
  have hG : G = ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
      MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) := rfl
  have hGh : G.IsHomogeneous 2 :=
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mp (wcLdpQuad K (d + 1) a).2

  have s1 : ∀ l m : Fin (d + 1 + 1) → K,
      (Matrix.of fun i j : Fin (d + 1 + 1) => l i * m j + m i * l j).det = 0 := by
    intro l m
    let φ := (Matrix.of ![l, m]).mulVecLin
    have hlt : Module.finrank K (Fin 2 → K) < Module.finrank K (Fin (d + 1 + 1) → K) := by
      simp only [Module.finrank_fin_fun]; omega
    have hker := LinearMap.ker_ne_bot_of_finrank_lt (f := φ) hlt
    obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).mp hker
    rw [LinearMap.mem_ker] at hv
    have hA : l ⬝ᵥ v = 0 := by
      have := congrFun hv 0
      simpa [φ, Matrix.mulVec] using this
    have hB : m ⬝ᵥ v = 0 := by
      have := congrFun hv 1
      simpa [φ, Matrix.mulVec] using this
    apply Matrix.exists_mulVec_eq_zero_iff.mp
    refine ⟨v, hv0, ?_⟩
    ext i
    have : (Matrix.of fun i j : Fin (d + 1 + 1) => l i * m j + m i * l j).mulVec v i =
        l i * (m ⬝ᵥ v) + m i * (l ⬝ᵥ v) := by
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, add_mul, Finset.sum_add_distrib,
        Finset.mul_sum, mul_assoc]
    rw [this, hA, hB]
    simp

  have s2 : ∀ i j : Fin (d + 1 + 1), MvPolynomial.pderiv i (MvPolynomial.pderiv j G) =
      MvPolynomial.C (a i j + a j i) := by
    intro i j
    have hm : ∀ p q : Fin (d + 1 + 1), MvPolynomial.pderiv j
        (MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) :
          MvPolynomial (Fin (d + 1 + 1)) K) =
        (if p = j then MvPolynomial.C (a p q) * MvPolynomial.X q else 0) +
          (if q = j then MvPolynomial.C (a p q) * MvPolynomial.X p else 0) := by
      intro p q
      rw [MvPolynomial.pderiv_C_mul, Derivation.leibniz, MvPolynomial.pderiv_X,
        MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
      by_cases hp : p = j <;> by_cases hq : q = j <;> simp [hp, hq] <;> ring
    have h1 : MvPolynomial.pderiv j G
        = ∑ q, MvPolynomial.C (a j q) * MvPolynomial.X q +
          ∑ p, MvPolynomial.C (a p j) * MvPolynomial.X p := by
      rw [hG]
      simp only [map_sum, hm, Finset.sum_add_distrib]
      congr 1
      · rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun q _ => ?_)
        rw [Finset.sum_ite_eq' Finset.univ j
          (fun p => MvPolynomial.C (a p q) * MvPolynomial.X q)]
        simp
      · refine Finset.sum_congr rfl (fun p _ => ?_)
        rw [Finset.sum_ite_eq' Finset.univ j
          (fun q => MvPolynomial.C (a p q) * MvPolynomial.X p)]
        simp
    have hlin : ∀ b : Fin (d + 1 + 1) → K, MvPolynomial.pderiv i
        (∑ q, MvPolynomial.C (b q) * MvPolynomial.X q : MvPolynomial (Fin (d + 1 + 1)) K) =
          MvPolynomial.C (b i) := by
      intro b
      simp only [map_sum, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, Pi.single_apply,
        mul_ite, mul_one, mul_zero]
      rw [Finset.sum_ite_eq' Finset.univ i (fun q => MvPolynomial.C (b q))]
      simp
    rw [h1, map_add, hlin (fun q => a j q), hlin (fun p => a p j), map_add]
    exact add_comm _ _

  have s3 : ∀ f : MvPolynomial (Fin (d + 1 + 1)) K, f.totalDegree ≤ 1 → ∀ j,
      MvPolynomial.pderiv j f = MvPolynomial.C (f.coeff (Finsupp.single j 1)) := by
    intro f hf j
    ext m
    rw [MvPolynomial.coeff_pderiv, MvPolynomial.coeff_C]
    split_ifs with hm
    · subst hm; simp
    · rw [MvPolynomial.coeff_eq_zero_of_totalDegree_lt, zero_mul]
      have h1 : Finsupp.degree m ≠ 0 := fun h => hm ((Finsupp.degree_eq_zero_iff m).mp h).symm
      have h2 : Finsupp.degree (m + Finsupp.single j 1) = Finsupp.degree m + 1 := by
        rw [map_add, Finsupp.degree_single]
      rw [← Finsupp.degree_apply, h2]
      omega

  have s4 : ∀ f g : MvPolynomial (Fin (d + 1 + 1)) K, ¬ IsUnit f → ¬ IsUnit g →
      f * g ≠ 0 → (f * g).totalDegree ≤ 2 → f.totalDegree ≤ 1 ∧ g.totalDegree ≤ 1 := by
    intro f g hfu hgu h0 h2
    have hf0 : f ≠ 0 := by rintro rfl; simp at h0
    have hg0 : g ≠ 0 := by rintro rfl; simp at h0
    rw [MvPolynomial.totalDegree_mul_of_isDomain hf0 hg0] at h2
    have key : ∀ h : MvPolynomial (Fin (d + 1 + 1)) K, h ≠ 0 → ¬ IsUnit h →
        h.totalDegree ≠ 0 := by
      intro h hh0 hhu hdeg
      apply hhu
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at hdeg
      have hc : h.coeff 0 ≠ 0 := by
        intro hc; rw [hc, MvPolynomial.C_0] at hdeg; exact hh0 hdeg
      rw [hdeg]
      exact (isUnit_iff_ne_zero.mpr hc).map MvPolynomial.C
    have := key f hf0 hfu
    have := key g hg0 hgu
    omega

  have K1 : (∀ i j : Fin (d + 1 + 1), MvPolynomial.pderiv i (MvPolynomial.pderiv j G) = 0) →
      False := by
    intro h
    apply ha
    have hS : Matrix.of a + (Matrix.of a).transpose = 0 := by
      ext i j
      have e := h i j
      rw [s2, MvPolynomial.C_eq_zero] at e
      simpa [Matrix.add_apply] using e
    rw [hS]
    exact Matrix.det_zero
  have hG0 : G ≠ 0 := by
    intro h0
    exact K1 (fun i j => by rw [h0, map_zero, map_zero])
  have hGu : ¬ IsUnit G := by
    intro hu
    obtain ⟨r, -, hr⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
    exact K1 (fun i j => by rw [hr, MvPolynomial.pderiv_C, map_zero])
  rw [← UniqueFactorizationMonoid.irreducible_iff_prime]
  refine irreducible_iff.mpr ⟨hGu, fun f g hfg => ?_⟩
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨hfu, hgu⟩ := hcon
  have h0 : f * g ≠ 0 := hfg ▸ hG0
  have h2 : (f * g).totalDegree ≤ 2 := by rw [← hfg, hGh.totalDegree hG0]
  obtain ⟨hf1, hg1⟩ := s4 f g hfu hgu h0 h2
  set lam : Fin (d + 1 + 1) → K := fun k => f.coeff (Finsupp.single k 1) with hlam
  set mu : Fin (d + 1 + 1) → K := fun k => g.coeff (Finsupp.single k 1) with hmu
  have hfd : ∀ k, MvPolynomial.pderiv k f = MvPolynomial.C (lam k) := fun k => s3 f hf1 k
  have hgd : ∀ k, MvPolynomial.pderiv k g = MvPolynomial.C (mu k) := fun k => s3 g hg1 k
  have hij : ∀ i j : Fin (d + 1 + 1), a i j + a j i = lam i * mu j + mu i * lam j := by
    intro i j
    have e := s2 i j
    rw [hfg] at e
    simp only [Derivation.leibniz, map_add, hfd, hgd, MvPolynomial.pderiv_C, smul_eq_mul,
      mul_zero, zero_add] at e
    have e' : MvPolynomial.C (lam i * mu j + mu i * lam j) =
        (MvPolynomial.C (a i j + a j i) : MvPolynomial (Fin (d + 1 + 1)) K) := by
      simp only [map_add, map_mul]; rw [← e]; ring
    exact (MvPolynomial.C_injective (Fin (d + 1 + 1)) K e').symm
  have hS : Matrix.of a + (Matrix.of a).transpose =
      Matrix.of fun i j : Fin (d + 1 + 1) => lam i * mu j + mu i * lam j := by
    ext i j
    simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply]
    exact hij i j
  rw [hS] at ha
  exact ha (s1 lam mu)

theorem wc_qcl_cone_pair_irreducible (K : Type u) [Field K] (e : ℕ) (he : 1 ≤ e)
    (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens)
    (hW : (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ) :
    IrreducibleSpace ↥(Oh : Scheme.{u}) ∧ IrreducibleSpace ↥(W : Scheme.{u}) :=
by
  classical

  have hB : IrreducibleSpace ↥(W : Scheme.{u}) := by
    let η : PrimeSpectrum (MvPolynomial (Fin (e + 1)) K) := ⟨⊥, Ideal.isPrime_bot⟩
    have hη : η ∈ (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) := by
      rw [hW]
      rintro ⟨x, hx⟩
      have h1 := congrArg PrimeSpectrum.asIdeal hx
      rw [Spec.map_apply] at h1
      have h3 : (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K)).hom
              (MvPolynomial.X 0) ∈ x.asIdeal := by
        rw [CommRingCat.hom_ofHom, MvPolynomial.constantCoeff_X]
        exact zero_mem _
      have h2 : (MvPolynomial.X 0 : MvPolynomial (Fin (e + 1)) K) ∈ η.asIdeal := by
        rw [← h1]
        exact h3
      exact MvPolynomial.X_ne_zero (0 : Fin (e + 1)) ((Ideal.mem_bot).mp h2)
    haveI : Nonempty ↥(W : Scheme.{u}) := ⟨⟨η, hη⟩⟩
    exact W.ι.isOpenEmbedding.irreducibleSpace

  have hdet : (Matrix.of (fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) +
      (Matrix.of (fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)).transpose).det ≠ 0 := by
    set M := (Matrix.of (fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) +
      (Matrix.of (fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)).transpose) with hM
    have hσlt : ∀ p : Fin (2 * e + 1 + 1),
        (if p.val % 2 = 0 then p.val + 1 else p.val - 1) < 2 * e + 1 + 1 := by
      intro p
      have := p.isLt
      split_ifs <;> omega
    let s : Fin (2 * e + 1 + 1) → Fin (2 * e + 1 + 1) := fun p =>
      ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, hσlt p⟩
    have hss : ∀ p, s (s p) = p := by
      intro p
      apply Fin.ext
      simp only [s]
      split_ifs <;> omega
    have hentry : ∀ p q, M p q = if q = s p then 1 else 0 := by
      intro p q
      simp only [hM, Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply, s, Fin.ext_iff]
      split_ifs <;> first | (exfalso; omega) | simp
    have hMM : M * M = 1 := by
      ext p r
      rw [Matrix.mul_apply, Finset.sum_eq_single (s p)]
      · rw [hentry p (s p), if_pos rfl, one_mul, hentry (s p) r, hss, Matrix.one_apply]
        rcases eq_or_ne p r with h | h
        · subst h; simp
        · simp [h, Ne.symm h]
      · intro q _ hq
        rw [hentry p q, if_neg hq, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ _) h
    exact Matrix.det_ne_zero_of_left_inverse hMM

  have key : ∀ (a : Fin (2 * e + 1 + 1) → Fin (2 * e + 1 + 1) → K),
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 → a 0 0 = 0 →
      ∀ (O : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of a)))).Opens),
      (O : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of a))))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of a))
          (MvPolynomial.X p) ∉ y.asIdeal} →
      IrreducibleSpace ↥(O : Scheme.{u}) := by
    intro a hc hc00 O hO
    have hP := wc_qsf_quad_prime K (2 * e) (by omega) a hc
    have hfP : (∑ p, ∑ q, MvPolynomial.C (Matrix.of a p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 0 : MvPolynomial (Fin (2 * e + 1 + 1)) K) =
        (wcLdpQuad K (2 * e + 1) a : MvPolynomial (Fin (2 * e + 1 + 1)) K) := by
      simp only [wcLdpQuad, map_zero, sub_zero, mul_assoc, Matrix.of_apply]
    have hprime : (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of a)).IsPrime := by
      show (Ideal.span {∑ p, ∑ q, MvPolynomial.C (Matrix.of a p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C 0}).IsPrime
      rw [hfP]
      exact (Ideal.span_singleton_prime hP.ne_zero).mpr hP
    haveI : IsDomain (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of a)) :=
      (Ideal.Quotient.isDomain_iff_prime _).mpr hprime
    let η : PrimeSpectrum (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of a)) :=
      ⟨⊥, Ideal.isPrime_bot⟩
    have hη : η ∈ (O : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of a))))) := by
      rw [hO]
      refine ⟨0, ?_⟩
      intro h
      have h' : Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of a))
          (MvPolynomial.X 0) = 0 := (Ideal.mem_bot).mp h
      rw [Ideal.Quotient.eq_zero_iff_mem] at h'
      obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp h'
      let v : Fin (2 * e + 1 + 1) → K := fun i => if i = 0 then 1 else 0
      have hf0 : MvPolynomial.eval v (∑ p, ∑ q, MvPolynomial.C (Matrix.of a p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C 0) = 0 := by
        simp [v, hc00]
      have h2 := congrArg (MvPolynomial.eval v) hg
      rw [map_mul, hf0, mul_zero, MvPolynomial.eval_X] at h2
      simp [v] at h2
    haveI : Nonempty ↥(O : Scheme.{u}) := ⟨⟨η, hη⟩⟩
    exact O.ι.isOpenEmbedding.irreducibleSpace
  refine ⟨key _ hdet ?_ Oh hOh, hB⟩
  simp

theorem wc_smooth_pair_qcsep_proet_shriek_low_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsSeparated pY] [CompactSpace Y]
    [IsLocallyNoetherian Y] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Rs : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (adj : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ ⊣ Rs)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf Y ℓ))) (q : ℕ) (hq : q < 2 * r) :
    letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
    letI : Rs.Additive := Adjunction.right_adjoint_additive adj
    Limits.IsZero (((Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical

  suffices hsupp : ∀ (V : Y.ProEt)
      (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
        (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
        (∀ x : V.left, IsClosed ({x} : Set V.left) →
          HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
      (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
      (q : ℕ) (hq : q < 2 * r), ∀ θ : wcSuppExt DV q, θ = 0 by
    haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
    haveI : Rs.Additive := Adjunction.right_adjoint_additive adj
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    refine rightAdj_homology_zero_of_free_ext_local (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) Rs adj
      (SheafOfModules.unit (wcRingSheaf Y ℓ)) I q ?_
    intro W
    refine (Scheme.ProEt.topology Z).superset_covering ?_ (wc_proet_closed_bc_wcontr_cover i W)
    rw [Sieve.generate_le_iff]
    rintro W' f ⟨V, rfl, h1, h2, h3, h4, h5⟩
    refine ⟨_, 𝟙 _, f, ?_, Category.id_comp f⟩
    intro P ev hnat hadd x
    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists (Limits.pullback.fst V.hom i) ℓ
    obtain ⟨e⟩ := wc_shriek_free_ext_slice_supp_equiv i ℓ Di hDi Rs adj V P ev hnat hadd DV hDV q
    have hc := hsupp V ⟨h1, h2, h3, h4, h5⟩ DV hDV q hq
    exact e.injective ((hc (e x)).trans (hc (e 0)).symm)

  suffices hcompl : ∀ (V : Y.ProEt)
      (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
        (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
        (∀ x : V.left, IsClosed ({x} : Set V.left) →
          HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
      (O : V.left.Opens) (hO : (O : Set ↥V.left) = (Set.range (Limits.pullback.fst V.hom i))ᶜ)
      (k : ℕ) (hk1 : 1 ≤ k) (hk2 : k + 2 ≤ 2 * r),
      Subsingleton (wcEtCoh O.toScheme ℓ k) by
    intro V hV DV hDV q hq θ
    haveI hVaff : IsAffine V.left := hV.1
    haveI hVwe : WeaklyEtale V.hom := V.prop
    have hVfl : Flat V.hom := inferInstance
    have hmn : m < n := by omega
    have hj : Set.range (Limits.pullback.fst V.hom i) = V.hom ⁻¹' Set.range i :=
      Scheme.Pullback.range_fst V.hom i
    have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ V.left), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range (Limits.pullback.fst V.hom i) ↔ ∃ k, x ∈ W.basicOpen (f k)) := by
      intro W _ p
      obtain ⟨n', f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ V.hom)
      refine ⟨n', f, fun x => ?_⟩
      have e : (p x ∉ Set.range (Limits.pullback.fst V.hom i)) ↔ ((p ≫ V.hom) x ∉ Set.range i) := by
        rw [hj, Scheme.Hom.comp_apply]
        exact Iff.rfl
      exact e.trans (hf x)
    have hrange_closed : IsClosed (Set.range (Limits.pullback.fst V.hom i)) :=
      (Limits.pullback.fst V.hom i).isClosedEmbedding.isClosed_range
    obtain ⟨O, hO⟩ : ∃ O : V.left.Opens,
        (O : Set V.left) = (Set.range (Limits.pullback.fst V.hom i))ᶜ :=
      ⟨⟨_, hrange_closed.isOpen_compl⟩, rfl⟩
    have hOc : IsCompact (O : Set V.left) := by
      obtain ⟨n', f, hf⟩ := wc_affine_complement_basicOpen_cover i V.left V.hom
      have e : (O : Set V.left) = ⋃ k, (V.left.basicOpen (f k) : Set V.left) := by
        ext x
        rw [hO, Set.mem_compl_iff, hj, Set.mem_iUnion]
        exact hf x
      rw [e]
      exact isCompact_iUnion fun k => ((isAffineOpen_top V.left).basicOpen (f k)).isCompact
    haveI hOcs : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc
    haveI hOsep : IsSeparated (Limits.terminal.from O.toScheme) := by
      have e : Limits.terminal.from O.toScheme = O.ι ≫ Limits.terminal.from V.left :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    have c5 : ∀ (Y' : Scheme.{u}) [CompactSpace Y'] [IsSeparated (Limits.terminal.from Y')] (j' : ℕ),
        Subsingleton (wcEtCoh Y' ℓ (j' + 1)) → ∀ x : wcHM Y' ℓ (j' + 1), x = 0 := by
      intro Y' _ _ j' h5
      have hN4 : ∀ (m' : ℕ), Subsingleton (wcEtCoh Y' m' (j' + 1)) →
          ∀ y : Abelian.Ext (wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y'))) (wcZModSheaf Y' m') (j' + 1),
            y = 0 := by
        intro m' h y
        obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y'
        haveI := hcont
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}) := HasExt.standard _
        obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep Y'
          ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m')))) (j' + 1)
        let χ : (wcEpsInv Y').obj ((constantSheaf (Scheme.smallEtaleTopology Y')
              AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m')))) ≅
            wcZModSheaf Y' m' :=
          (wc_epsInv_const Y' (AddCommGrpCat.of (ULift.{u+1} (ZMod m')))).some ≪≫
            (wc_zmod_sheaf_const Y' m').some.symm
        have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}} (e : B ≅ B'),
            Nonempty (Abelian.Ext A B (j' + 1) ≃ Abelian.Ext A B' (j' + 1)) := by
          intro A B B' e
          refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (j' + 1))
                    invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (j' + 1))
                    left_inv := fun y => ?_
                    right_inv := fun y => ?_ }⟩
          · simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j' + 1)) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
          · simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j' + 1)) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
        obtain ⟨E₂⟩ := post (A := wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y'))) χ.symm
        let E : Abelian.Ext (wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y'))) (wcZModSheaf Y' m') (j' + 1) ≃
            wcEtCoh Y' m' (j' + 1) := E₂.trans E₀
        apply E.injective
        exact Subsingleton.elim _ _
      have h4 : ∀ k : ℕ, Subsingleton (wcEtCoh Y' (ℓ ^ (k + 1)) (j' + 1)) :=
        fun k => wc_et_coh_zmod_prime_pow_of_prime Y' ℓ (Fact.out) (j' + 1) h5 k
      haveI : QuasiSeparatedSpace Y' := (quasiSeparatedSpace_iff_quasiSeparated Y').2 inferInstance
      have h2 : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y')))
          (wcZModSheaf Y' (ℓ ^ (k + 1))) (j' + 1), y = 0 :=
        fun k => hN4 (ℓ ^ (k + 1)) (h4 k)
      have h1 := wc_proet_int_ext_vanish_of_zmod_deg Y' ℓ (Scheme.ProEt.mk (𝟙 Y')) j' h2
      exact wc_hm_vanish_of_int_ext_vanish Y' ℓ j' h1
    have hgenY : ∀ {U' : Scheme.{u}} (g : U' ⟶ V.left), Flat (g ≫ V.hom) →
        ∀ u' : U', ∃ x : U', x ⤳ u' ∧ g x ∉ Set.range (Limits.pullback.fst V.hom i) := by
      intro U' g hfl u'
      haveI := hfl
      obtain ⟨x, hx, hxi⟩ := wc_flat_generic_lift_off_closed K pY n m hmn i (g ≫ V.hom) u'
      refine ⟨x, hx, ?_⟩
      rw [hj]
      exact fun h => hxi (by rw [Scheme.Hom.comp_apply]; exact h)
    obtain ⟨Do, hDo⟩ := wc_hm_pull_data_exists O.ι ℓ
    have hepi := wc_supp_unit_epi_of_closed (Limits.pullback.fst V.hom i) ℓ DV hDV
    rcases Nat.eq_zero_or_pos q with hq0 | hqpos
    · subst hq0
      obtain ⟨φ, rfl⟩ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).2 θ
      have hφ := wc_supp_hom_zero_of_dense (Limits.pullback.fst V.hom i) DV hDV hepi (fun U => by
        rw [dense_iff_inter_open]
