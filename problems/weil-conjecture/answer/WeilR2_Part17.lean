    obtain ⟨u', hu⟩ := wc_pmn_supp_unit_line _ (wcEtGeomPt X x) Dx hDx _ hh₀
    obtain ⟨hf, hSE⟩ := s2core _ _ h hex σ (wcSuppUnitMap Dx) u' hu
    obtain ⟨e, he, -⟩ := proet_free_sheaf_hom_equiv X (Scheme.ProEt.mk Ox.ι)
    refine ⟨L.obj (wcFreeSheaf X (Scheme.ProEt.mk Ox.ι)),
      fun M => (adj.homEquiv _ M).trans (e ((SheafOfModules.toSheaf _).obj M)), ?_, _, hf, hSE⟩
    intro M N ψ g
    have h1 := he _ _ ((SheafOfModules.toSheaf _).map ψ) (adj.homEquiv _ M g)
    rw [← Adjunction.homEquiv_naturality_right] at h1
    exact h1


  have s3 : ∀ {X W : Scheme.{u}} (w : W ⟶ X) (Dw : wcHMPullData w ℓ) (Ox : X.Opens) (O : W.Opens),
