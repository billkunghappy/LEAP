theorem wc_pmn_ldp_supp_derived_transfer {X W : Scheme.{u}} (w : W ⟶ X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dw : wcHMPullData w ℓ)
    (S : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (hinj : ∀ I : SheafOfModules.{u+1} (wcRingSheaf X ℓ), Injective I → Injective (Dw.Φ.obj I))
    (hhom : ∀ M : SheafOfModules.{u+1} (wcRingSheaf X ℓ),
      Function.Bijective (fun f : S ⟶ M => Dw.Φ.map f)) :
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf W ℓ))
