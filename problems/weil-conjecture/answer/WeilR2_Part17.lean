        refine ⟨1, p, ?_⟩
        show m₂ p = x
        rw [hm₂]
        exact hp1
    have hcov := QCCOV X Q 2 (fun k => (pcs k).1) (fun k => (pcs k).2) hqc hjs
    let Sv : Sieve Q :=
      { arrows := fun W' g => g.left ≫ α = g.left ≫ β ∨
