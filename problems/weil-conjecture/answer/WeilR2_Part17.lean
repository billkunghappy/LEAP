          ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)).obj
            (wcIntUnit Y ℓ)) (2 * N),
        ∀ a, BA a = (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) a) (zero_add (2 * N)) :=
      ⟨AddMonoidHom.mk' (fun a => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) a) (zero_add (2 * N)))
        (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ => rfl⟩
    have hBAb : Function.Bijective BA := by
      have e : (⇑BA) = fun a => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) a) (zero_add (2 * N)) :=
        funext hBA
      rw [e]
      exact ext_transfer_of_hom_bijective LΛ
        (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) adjΛ _
        (wcIntUnit Y ℓ) ε Hε (wcIntUnit Y ℓ) (2 * N)

    have K2 : (BA y).comp (Abelian.Ext.mk₀
        ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)).map
          (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)))) (add_zero (2 * N)) =
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ))
          (y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)))
            (add_zero (2 * N)))) (zero_add (2 * N)) := by
      rw [hBA, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    rw [hyj, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero] at K2
    have hwz : ((BA y).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero (2 * N))).comp
        (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero (2 * N)) = 0 := by
      have e : ((BA y).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero (2 * N))).comp
          (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero (2 * N)) =
          ((BA y).comp (Abelian.Ext.mk₀
            ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)).map
              (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)))) (add_zero (2 * N))).comp
            (Abelian.Ext.mk₀ ιQ'.hom) (add_zero (2 * N)) := by
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hι']
      rw [e, K2, Abelian.Ext.zero_comp]

    have hqc : QuasiCompact pY := inferInstance
    have hqs : QuasiSeparated pY := inferInstance
    have hcpt : CompactSpace ↥Y :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ pY hqc _
    have hqsp : QuasiSeparatedSpace ↥Y :=
      @quasiSeparatedSpace_of_quasiSeparated _ _ pY _ hqs
    haveI hT1 : CompactSpace
        (MorphismProperty.Over.mk ⊤ (𝟙 Y) inferInstance : Y.ProEt).left := hcpt
    haveI hT2 : QuasiSeparatedSpace
        (MorphismProperty.Over.mk ⊤ (𝟙 Y) inferInstance : Y.ProEt).left := hqsp

    obtain ⟨r, hr⟩ := (proet_qcqs_ladic_rationalization Y
      (MorphismProperty.Over.mk ⊤ (𝟙 Y) inferInstance : Y.ProEt) ℓ (2 * N)).2 _ hwz
    refine ⟨r, ?_⟩
    have hcancelZ : ∀ (a b : Abelian.Ext (wcFreeSheaf Y
            (MorphismProperty.Over.mk ⊤ (𝟙 Y) inferInstance : Y.ProEt))
          ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)).obj
            (wcIntUnit Y ℓ)) (2 * N)),
        a.comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero (2 * N)) =
          b.comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero (2 * N)) → a = b := by
      intro a b hab
      have := congrArg (fun w => w.comp (Abelian.Ext.mk₀ ιZ.inv) (add_zero (2 * N))) hab
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id] at this
      exact this
    have e4 : (ℓ ^ r • BA y).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero (2 * N)) =
        ℓ ^ r • (BA y).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero (2 * N)) :=
      map_nsmul ((Abelian.Ext.mk₀ ιZ.hom).postcomp _ (add_zero (2 * N))) (ℓ ^ r) (BA y)
    apply hBAb.1
    apply hcancelZ
    rw [map_nsmul, e4, hr]
    simp only [map_zero, Abelian.Ext.zero_comp]

theorem wc_isolated_sing_point_supp_class_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [ConnectedSpace Y] (N : ℕ)
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (O : Y.Opens) (hO : (O : Set Y) = {y₀ (IsLocalRing.closedPoint K)}ᶜ) (hOne : Nonempty O)
    [SmoothOfRelativeDimension N (O.ι ≫ pY)]
    (Yb E : Scheme.{u}) (fY : Yb ⟶ Spec (.of K)) [IsProper fY] [SmoothOfRelativeDimension N fY]
    (iE : E ⟶ Yb) [IsClosedImmersion iE] (U : Yb.Opens) (hU : (U : Set Yb) = (Set.range iE)ᶜ)
    (hOU : Nonempty ((O : Scheme.{u}) ≅ (U : Scheme.{u})))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy) :
    ∃ θ : wcSuppExt Dy (2 * N), wcSuppClass Dy (2 * N) θ ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _

  obtain ⟨hdim, hN⟩ := wc_isp_dim_bounds K pY N y₀ hy₀ O hO hOne

  obtain ⟨φ⟩ := hOU
  have hne : (O : Set Y) ≠ Set.univ := by
    rw [hO]
    intro h
    have hmem : y₀ (IsLocalRing.closedPoint K) ∈
        ({y₀ (IsLocalRing.closedPoint K)}ᶜ : Set Y) := by
      rw [h]; exact Set.mem_univ _
    exact hmem rfl
  have hmeet := wc_isp_resolution_components_meet K pY O hne N Yb E fY iE U hU ⟨φ⟩
  haveI hUv : Subsingleton (wcEtCoh (U : Scheme.{u}) ℓ (2 * N)) :=
    wc_et_smooth_proper_open_top_vanish_of_meets K Yb fY N hN U hmeet ℓ Fact.out hℓ
  obtain ⟨eU⟩ := wc_et_coh_iso_invariance φ.hom ℓ (2 * N)
  haveI hvanO : Subsingleton (wcEtCoh (O : Scheme.{u}) ℓ (2 * N)) := eU.symm.subsingleton

  obtain ⟨inst, hfin⟩ := wc_hm_int_fg K pY ℓ hℓ (2 * N)
  letI := inst
  haveI := hfin
  obtain ⟨e, he⟩ := (padic_fg_torsion_primitive ℓ
    (Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (2 * N))).1

  have hvan := wc_isp_int_tors_succ_top_vanish K pY N hdim ℓ hℓ
  obtain ⟨Y₁, i, hi, hirr, hd₁⟩ := wc_isp_irreducible_top_piece K pY N hdim O hOne
  haveI := hi
  haveI := hirr
  have hge := wc_isp_int_tors_top_card_ge K pY N hdim Y₁ i hd₁ ℓ hℓ
  obtain ⟨b, hb⟩ :=
    wc_int_tors_ext_growth_of_unbounded Y ℓ (wcIntUnit Y ℓ) (2 * N) hvan hge e

  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcIntSuppπ Dy)) (wcIntSuppπ Dy)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _)
      (inferInstance : Mono (Limits.kernel.ι (wcIntSuppπ Dy)))
      (inferInstance : Epi (Limits.factorThruImage (wcIntSuppMap Dy)))

  have hvanC : ∀ w : Abelian.Ext (wcIntSuppObj Dy) (wcIntTors Y ℓ 1) (2 * N + 1), w = 0 := by
    intro w
    have h0 : (Abelian.Ext.mk₀ (wcIntSuppπ Dy)).comp w (zero_add (2 * N + 1)) = 0 := hvan _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS' (wcIntTors Y ℓ 1) w h0
      (by omega : 1 + 2 * N = 2 * N + 1)
    rw [← hx₁, wc_isp_int_supp_kernel_tors_vanish K pY N ℓ y₀ hy₀ O hO hvanO Dy hDy 1 le_rfl x₁,
      Abelian.Ext.comp_zero]

  have h0b : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcIntSuppπ Dy))).comp b (zero_add (2 * N)) = 0 :=
    wc_isp_int_supp_kernel_tors_vanish K pY N ℓ y₀ hy₀ O hO hvanO Dy hDy (e + 1) (by omega) _
  obtain ⟨a₀, ha₀⟩ :=
    Abelian.Ext.contravariant_sequence_exact₂ hS' (wcIntTors Y ℓ (e + 1)) b h0b

  have hlift := wc_int_tors_ext_lift_of_vanish Y ℓ (wcIntSuppObj Dy) (2 * N) hvanC
  choose f hf using hlift
  let a : ∀ k : ℕ, Abelian.Ext (wcIntSuppObj Dy) (wcIntTors Y ℓ (e + 1 + k)) (2 * N) :=
    fun k => Nat.rec
      (motive := fun k => Abelian.Ext (wcIntSuppObj Dy) (wcIntTors Y ℓ (e + 1 + k)) (2 * N))
      a₀ (fun k ak => f (e + 1 + k) (by omega) ak) k
  have ha : ∀ (k : ℕ) (t : wcIntTors Y ℓ (e + 1 + k + 1) ⟶ wcIntTors Y ℓ (e + 1 + k)),
      Limits.cokernel.π ((ℓ ^ (e + 1 + k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t =
        Limits.cokernel.π ((ℓ ^ (e + 1 + k) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) →
      (a (k + 1)).comp (Abelian.Ext.mk₀ t) (add_zero (2 * N)) = a k := by
    intro k t ht
    exact hf (e + 1 + k) (by omega) (a k) t ht

  obtain ⟨θz, hθz⟩ := wc_int_ext_tower_milnor Y ℓ (wcIntSuppObj Dy) (2 * N) (e + 1) a ha
  have hθ0 : θz.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero (2 * N)) = a₀ :=
    hθz 0

  obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (2 * N),
      y = (Abelian.Ext.mk₀ (wcIntSuppπ Dy)).comp θz (zero_add (2 * N)) := ⟨_, rfl⟩
  have hred : y.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero (2 * N)) = b := by
    rw [hy, Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcIntSuppπ Dy)) θz
      (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
      (zero_add (2 * N)) (add_zero (2 * N)) (by omega), hθ0]
    exact ha₀

  obtain ⟨rat, ratB, hsq, hker⟩ := wc_isp_int_supp_rational K pY N ℓ hℓ y₀ hy₀ Dy hDy
  refine ⟨rat θz, fun h0 => ?_⟩
  have hy0 : ratB y = 0 := by rw [hy, ← hsq θz]; exact h0
  obtain ⟨r, hr⟩ := hker y hy0
  have hey : ℓ ^ e • y = 0 := he y ⟨r, hr⟩
  apply hb
  rw [← hred]
  have hpost := map_nsmul ((Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)))).postcomp
        (wcIntUnit Y ℓ) (add_zero (2 * N))) (ℓ ^ e) y
  rw [hey, map_zero] at hpost
  exact hpost.symm

theorem wc_pmn_odp_point_class_nonzero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∃ θ : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (SheafOfModules.unit
          (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))⟦((n - 1 : ℕ) : ℤ) + ((n - 1 : ℕ) : ℤ)⟧,
      DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map (wcSuppUnitMap Dx)) ≫ θ ≠ 0 :=
by
  classical

  have key : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hE : HasExt.{u+2} 𝒞}
      {_hD : HasDerivedCategory.{u+2} 𝒞} (X S : 𝒞) (v : X ⟶ S) (m : ℕ) (k : ℤ)
      (hk : (m : ℤ) = k) (θ : Abelian.Ext S X m), (Abelian.Ext.mk₀ v).comp θ (zero_add m) ≠ 0 →
      ∃ θ' : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj X))⟦k⟧,
        DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map v) ≫ θ' ≠ 0 := by
    intro 𝒞 _ _ _ _ X S v m k hk θ hθ
    subst hk
    obtain ⟨ι, -⟩ : ∃ ι : DerivedCategory.singleFunctor 𝒞 0 ≅
        CochainComplex.singleFunctor 𝒞 0 ⋙ DerivedCategory.Q,
        ι = DerivedCategory.singleFunctorIsoCompQ 𝒞 0 := ⟨_, rfl⟩
    have hH : ((Abelian.Ext.mk₀ v).comp θ (zero_add m)).hom ≠ 0 := by
      intro h0
      apply hθ
      apply Abelian.Ext.homEquiv.injective
      change ((Abelian.Ext.mk₀ v).comp θ (zero_add m)).hom = (0 : Abelian.Ext X X m).hom
      rw [h0, Abelian.Ext.zero_hom]
    have hc : ((Abelian.Ext.mk₀ v).comp θ (zero_add m)).hom =
        (DerivedCategory.singleFunctor 𝒞 0).map v ≫ θ.hom := by
      rw [Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, ShiftedHom.mk₀_comp]
    have hnat : DerivedCategory.Q.map ((CochainComplex.singleFunctor 𝒞 0).map v) ≫ ι.inv.app S =
        ι.inv.app X ≫ (DerivedCategory.singleFunctor 𝒞 0).map v := ι.inv.naturality v
    refine ⟨ι.inv.app S ≫ θ.hom ≫ (ι.hom.app X)⟦((m : ℕ) : ℤ)⟧', ?_⟩
    intro h0
    apply hH
    rw [hc]
    have h1 : ι.inv.app X ≫ ((DerivedCategory.singleFunctor 𝒞 0).map v ≫ θ.hom) ≫
        (ι.hom.app X)⟦((m : ℕ) : ℤ)⟧' = 0 := by
      rw [← Category.assoc, ← Category.assoc, ← hnat, Category.assoc, Category.assoc]
      exact h0
    calc (DerivedCategory.singleFunctor 𝒞 0).map v ≫ θ.hom
        = ι.hom.app X ≫ (ι.inv.app X ≫ ((DerivedCategory.singleFunctor 𝒞 0).map v ≫ θ.hom) ≫
            (ι.hom.app X)⟦((m : ℕ) : ℤ)⟧') ≫ (ι.inv.app X)⟦((m : ℕ) : ℤ)⟧' := by
          simp only [Category.assoc, Iso.hom_inv_id_app_assoc, ← Functor.map_comp,
            Iso.hom_inv_id_app]
          rw [CategoryTheory.Functor.map_id, Category.comp_id]
      _ = 0 := by rw [h1, Limits.zero_comp, Limits.comp_zero]

  haveI hkac : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV

  have hfb := wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs
  obtain ⟨hprop, hconn, ⟨y₀, hy₀, hy₀xs⟩, O, hO, hOne, hsm⟩ := hfb
  haveI := hprop
  haveI := hconn
  haveI := hsm

  have hres := wc_pmn_odp_fibre_resolution F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs O hO
  obtain ⟨Yb, E, fY, hfY, hsY, iE, hiE, U, hU, hOU⟩ := hres
  haveI := hfY
  haveI := hsY
  haveI := hiE
  have hDex := wc_hm_pull_data_exists y₀ ℓ
  obtain ⟨Dy, hDy⟩ := hDex

  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    let g : Spec (.of A) ⟶ Spec (.of F'') := e.inv ≫ V.hom ≫ (wcP1Over F'').hom
    let ψ : F'' →+* IsLocalRing.ResidueField A :=
      (IsLocalRing.residue A).comp (Spec.preimage g).hom
    intro h0
    have h1 : ((ℓ : ℕ) : F'') = 0 := by
      apply ψ.injective
      rw [map_natCast, map_zero]
      exact h0
    have h2 : ringChar F'' ∣ ℓ := ringChar.dvd h1
    have h3 : ringChar F'' = ℓ :=
      ((Nat.dvd_prime (Fact.out : ℓ.Prime)).mp h2).resolve_left CharP.ringChar_ne_one
    haveI : Fintype F'' := Fintype.ofFinite F''
    have h4 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [Nat.card_eq_fintype_card, ← h3]
    exact h4
  have hO' : (O : Set _) = {y₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))}ᶜ := by
    rw [hO, hy₀xs]

  have hcrux := wc_isolated_sing_point_supp_class_nonzero (IsLocalRing.ResidueField A)
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (n - 1) y₀ hy₀ O hO'
    hOne Yb E fY iE U hU hOU ℓ hℓk Dy hDy
  obtain ⟨θ, hθ⟩ := hcrux

  have htr := wc_supp_class_geomPt_of_section (IsLocalRing.ResidueField A)
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) y₀ hy₀ xs hy₀xs
    Dy hDy Dx hDx (2 * (n - 1)) ⟨θ, hθ⟩
  obtain ⟨θx, hθx⟩ := htr
  have hk : ((2 * (n - 1) : ℕ) : ℤ) = ((n - 1 : ℕ) : ℤ) + ((n - 1 : ℕ) : ℤ) := by
    push_cast; ring
  letI hExt : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)) :=
    HasExt.standard _
  have hθx' : (Abelian.Ext.mk₀ (wcSuppUnitMap Dx)).comp θx (zero_add (2 * (n - 1))) ≠ 0 := hθx
  exact key (_hE := hExt) _ _ (wcSuppUnitMap Dx) (2 * (n - 1)) _ hk θx hθx'

theorem wc_pmn_point_push_ext_vanish {X : Scheme.{u}} (Ω : Type u) [Field Ω] [IsSepClosed Ω]
    (xb : Spec (.of Ω) ⟶ X) {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Dx : wcHMPullData xb ℓ) (hDx : wcHMPullCanonical Dx) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    ∀ (k : ℤ), 0 < k → ∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
        (SheafOfModules.unit (wcRingSheaf X ℓ))) ⟶
      (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)))⟦k⟧, f = 0 :=
by
  classical
  intro k hk f
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec (.of Ω)) ℓ)) := HasExt.standard _

  have s1 : ∀ (B : Type u) [CommRing B] [Algebra Ω B], Algebra.WeaklyEtale Ω B →
      (∀ f : B, ∃ s : B, f * f * s = f) ∧
      ∀ (R : Type u) [CommRing R] [IsLocalRing R] [Algebra B R] (M : Submonoid B),
        IsLocalization M R → IsSepClosed (IsLocalRing.ResidueField R) := by
