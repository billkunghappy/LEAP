      (N.val.map a.op).hom t = (N.val.map b.op).hom t := by
    intro X Z Z' U hUa hXn i _ i' g' hsq hg' N t ht Q a b
    haveI := hUa
    haveI : IsIso g' := hg'
    haveI : WeaklyEtale Q.hom := Q.prop
    haveI : WeaklyEtale U.hom := U.prop
    have capp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : A), (f ≫ g) x = g (f x) :=
      fun f g x => Scheme.Hom.comp_apply f g x
    have hP0 : IsPullback (𝟙 Z) (inv g' ≫ i') i U.hom :=
      IsPullback.of_iso hsq.flip (asIso g') (Iso.refl Z) (Iso.refl U.left) (Iso.refl X)
        (by simp) (by simp) (by simp) (by simp)
    obtain ⟨e, hP⟩ : ∃ e : Z ⟶ U.left, IsPullback (𝟙 Z) e i U.hom := ⟨_, hP0⟩
    have hw0 : e ≫ U.hom = i := (hP.toCommSq.w).symm.trans (Category.id_comp i)
    have hP'' : IsPullback (𝟙 Z) e (e ≫ U.hom) U.hom := hw0 ▸ hP
    have s1 : ∀ (v : U.left) (z : Z), U.hom v = i z → v = e z := by
      intro v z h
      obtain ⟨q, hq1, hq2⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := i) (g := U.hom) z v h.symm
      have h3 : (hP.isoPullback.inv ≫ e) q = Limits.pullback.snd i U.hom q := by
        rw [hP.isoPullback_inv_snd]
      have h4 : (hP.isoPullback.inv ≫ 𝟙 Z) q = Limits.pullback.fst i U.hom q := by
        rw [hP.isoPullback_inv_fst]
      rw [capp] at h3 h4
      have h5 : hP.isoPullback.inv q = z := h4.trans hq1
      rw [← hq2, ← h3, h5]
    have s2 : ∀ (p : ↥(Limits.pullback U.hom U.hom)) (z : Z),
        Limits.pullback.fst U.hom U.hom p = e z → p = Limits.pullback.diagonal U.hom (e z) := by
      intro p z hp
      let κ : Limits.pullback e (Limits.pullback.fst U.hom U.hom) ≅ Z :=
        Limits.pullbackRightPullbackFstIso U.hom U.hom e ≪≫ hP''.isoPullback.symm
      have hb : κ.hom = Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) := by
        have h1 : hP''.isoPullback.inv = Limits.pullback.fst (e ≫ U.hom) U.hom := by
          rw [← hP''.isoPullback_inv_fst, Category.comp_id]
        show (Limits.pullbackRightPullbackFstIso U.hom U.hom e).hom ≫ hP''.isoPullback.inv = _
        rw [h1, Limits.pullbackRightPullbackFstIso_hom_fst]
      have hinj : ∀ y₁ y₂ : ↥(Limits.pullback e (Limits.pullback.fst U.hom U.hom)),
          Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) y₁ =
          Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) y₂ → y₁ = y₂ := by
        intro y₁ y₂ h
        rw [← hb] at h
        calc y₁ = κ.inv (κ.hom y₁) := (Scheme.hom_inv_apply κ y₁).symm
          _ = κ.inv (κ.hom y₂) := by rw [h]
          _ = y₂ := Scheme.hom_inv_apply κ y₂
      obtain ⟨y, hy1, hy2⟩ := Scheme.Pullback.exists_preimage_pullback (f := e)
        (g := Limits.pullback.fst U.hom U.hom) z p hp.symm
      have H : 𝟙 Z ≫ e =
          (e ≫ Limits.pullback.diagonal U.hom) ≫ Limits.pullback.fst U.hom U.hom := by
        rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id, Category.id_comp]
      obtain ⟨y', hy'1, hy'2⟩ : ∃ y' : Z ⟶ Limits.pullback e (Limits.pullback.fst U.hom U.hom),
