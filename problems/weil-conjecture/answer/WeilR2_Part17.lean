  have hR := @hτ (CommRingCat.of R) (inferInstanceAs (HenselianLocalRing R))
    (inferInstanceAs (IsSepClosed (IsLocalRing.ResidueField R))) k hk
    ⟨IsLocalRing.closedPoint K, hpt.symm⟩ (Limits.pullback k i₀)
    (Limits.pullback.fst k i₀) (Limits.pullback.snd k i₀) (IsPullback.of_hasPullback k i₀).flip
    Dk hDk Di hDi hepi' γ hγ
  have hres : wcHMPull DfO q ω ≠ 0 := by
    intro h
    apply hR
    have h2 := hδ' ω
    rw [h, map_zero, hω] at h2
    exact h2.symm
