theorem wc_qmssl_ry_kunneth_sections_line {X : Scheme.{u}} [IsAffine X] (B : Type u) [CommRing B]
    [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (g : X ⟶ Spec (.of B))
    {Z : Scheme.{u}} (i : Z ⟶ Spec (.of B)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X ℓ))) (q : ℕ) (y : wcHM X ℓ q)
    (hy : Function.Bijective (fun c : ℚ_[ℓ] => wcHMScalar X ℓ q c y))
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt X (ℓ ^ k) j))
    (hbij : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of B)), WeaklyEtale c →
      c (IsLocalRing.closedPoint C) ∈ Set.range i →
      ∀ {Pq : Scheme.{u}} (q' : Pq ⟶ X) (t : Pq ⟶ Spec (.of C)), IsPullback q' t g c →
      ∀ k : ℕ, 1 ≤ k → ∀ (D : wcZModPullData q' (ℓ ^ k)), wcZModPullCanonical D →
      ∀ j : ℕ, Function.Bijective (wcZModPull D j)) :
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    ∃ m : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
        (Opposite.op (Scheme.ProEt.mk (𝟙 (Spec (.of B))))),
      ∀ (Vt : (Spec (.of B)).ProEt),
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) →
      Function.Bijective (fun r : (wcRingSheaf (Spec (.of B)) ℓ).obj.obj (Opposite.op Vt) =>
        r • ((((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.map
            (@Quiver.Hom.op (Spec (.of B)).ProEt _ _ _
              (MorphismProperty.Over.homMk (A := Vt) (B := Scheme.ProEt.mk (𝟙 (Spec (.of B))))
                Vt.hom (Category.comp_id _) trivial))).hom m) :=
by
  intro P
  haveI := Dg.additive
  obtain ⟨Ψ, hlin, hnat⟩ := wc_proet_push_homology_sections_hm g ℓ Dg hDg I q
  have hTop : Projective (wcFreeSheaf (Spec (.of B)) (Scheme.ProEt.mk (𝟙 (Spec (.of B))))) :=
    wc_proet_free_projective_strict_local (Spec (.of B)) (Scheme.ProEt.mk (𝟙 (Spec (.of B)))) B
      (Iso.refl _)
  obtain ⟨D₀, hD₀⟩ := wc_hm_pull_data_exists
    (Limits.pullback.snd (Scheme.ProEt.mk (𝟙 (Spec (.of B)))).hom g) ℓ
  refine ⟨(Ψ _ hTop).symm (wcHMPull D₀ q y), ?_⟩
  intro Vt hW hrange
  haveI : IsAffine Vt.left := hW.1
  have hVt : Projective (wcFreeSheaf (Spec (.of B)) Vt) :=
    wc_proet_free_projective_wcontractible (Spec (.of B)) Vt hW
  have w : (Limits.pullback.fst Vt.hom g ≫ Vt.hom) ≫ (Scheme.ProEt.mk (𝟙 (Spec (.of B)))).hom =
      Limits.pullback.snd Vt.hom g ≫ g := by
    show (Limits.pullback.fst Vt.hom g ≫ Vt.hom) ≫ 𝟙 _ = _
    rw [Category.comp_id]
    exact Limits.pullback.condition
  obtain ⟨pS, hp1, hp2⟩ : ∃ pS : Limits.pullback Vt.hom g ⟶
      Limits.pullback (Scheme.ProEt.mk (𝟙 (Spec (.of B)))).hom g,
      pS ≫ Limits.pullback.fst (Scheme.ProEt.mk (𝟙 (Spec (.of B)))).hom g =
        Limits.pullback.fst Vt.hom g ≫ Vt.hom ∧
      pS ≫ Limits.pullback.snd (Scheme.ProEt.mk (𝟙 (Spec (.of B)))).hom g =
        Limits.pullback.snd Vt.hom g :=
    ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨Db, hDb⟩ := wc_hm_pull_data_exists pS ℓ
  have hn := hnat (Scheme.ProEt.mk (𝟙 (Spec (.of B)))) Vt hTop hVt
    (MorphismProperty.Over.homMk (A := Vt) (B := Scheme.ProEt.mk (𝟙 (Spec (.of B))))
      Vt.hom (Category.comp_id _) trivial) pS hp1 hp2 Db hDb ((Ψ _ hTop).symm (wcHMPull D₀ q y))
  have hy' : (Ψ _ hTop) ((Ψ _ hTop).symm (wcHMPull D₀ q y)) = wcHMPull D₀ q y :=
    AddEquiv.apply_symm_apply _ _
  erw [hy'] at hn
  have hk : pS ≫ Limits.pullback.snd (Scheme.ProEt.mk (𝟙 (Spec (.of B)))).hom g =
      ((wcProEtBC g).obj Vt).hom ≫ 𝟙 X :=
    hp2.trans (Category.comp_id (Limits.pullback.snd Vt.hom g)).symm
  obtain ⟨Dc, hDc⟩ := wc_hm_pull_data_exists (((wcProEtBC g).obj Vt).hom ≫ 𝟙 X) ℓ
  have hcomp := wc_hm_pull_comp _ pS _ hk D₀ hD₀ Db hDb Dc hDc q y

  have hb : ∀ k : ℕ, 1 ≤ k → ∀ (z : Vt.left), IsClosed ({z} : Set Vt.left) →
      ∀ {Pq : Scheme.{u}} (q' : Pq ⟶ X) (t : Pq ⟶ Spec (Vt.left.presheaf.stalk z)),
      IsPullback q' t g (Vt.left.fromSpecStalk z ≫ Vt.hom ≫ 𝟙 (Spec (.of B))) →
