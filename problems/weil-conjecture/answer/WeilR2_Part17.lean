    intro 𝒞 _ _ _ N One Sx Ψ eΨ hcase

    have core : ∀ {A1 A2 A3 S0 : DerivedCategory 𝒞} (a : A1 ⟶ A2) (b : A2 ⟶ A3)
        (h : A3 ⟶ A1⟦(1 : ℤ)⟧) (ε : ℤˣ),
        Pretriangulated.Triangle.mk (ε • a) (ε • b) h ∈ distTriang (DerivedCategory 𝒞) →
        ((∀ w : S0 ⟶ A2, w ≫ b = 0) ∨
          (Nonempty (A3 ≅ S0) ∧ (∀ c : S0 ⟶ S0, c ≠ 0 → IsIso c) ∧
