  have hE : Function.Bijective (fun β : Abelian.Ext S M k => Abelian.Ext.mapExactFunctor Dw.Φ β) := by
    simp only [Abelian.Ext.mk₀_id_comp] at hT
    exact hT
  have h3 := s3 Dw.Φ S M k hE
  have h4 := s4 Dw.Φ.mapDerivedCategory
    ((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) 0).app S)
    ((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) 0).app M)
    (k : ℤ) h3
