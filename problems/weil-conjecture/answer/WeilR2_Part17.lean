  have s1 : ∀ (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ),
      Finite (Abelian.Ext P (wcZModSheaf S ℓ) N) → Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) ≤ ℓ →
      (∀ n : ℕ, 1 ≤ n → Finite (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) →
        ℓ ^ n ≤ Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N)) →
      (∀ n : ℕ, Finite (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) ∧
        Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) = ℓ ^ n) ∧
      (∀ (n : ℕ) (x : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N),
