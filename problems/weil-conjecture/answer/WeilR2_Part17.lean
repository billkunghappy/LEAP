    have hcard : ∀ n : ℕ, Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) = ℓ ^ n := by
      intro n
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · exact Nat.card_unique.trans (pow_zero ℓ).symm
      · exact le_antisymm (hup n).2 (hge n hn (hup n).1)
    have hsurj : ∀ (n : ℕ) (x : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N),
        ∃ x' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N,
          x'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
            continuous_of_discreteTopology)) (add_zero N) = x := by
      intro n x
      have hcd : Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) *
          Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) ≤
          Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N) := by
        rw [hcard n, hcard (n + 1), pow_succ']
        exact Nat.mul_le_mul hBc le_rfl
      obtain ⟨x', hx'⟩ := G3 (μs n) (τs n) (fun a ha => (hexs n a).mp ha) hBfin
        (hup (n + 1)).1 (hup n).1 hcd x
