    intro SC hS Y₁ Y₂ g q c₂ k₁ c₁ u'
    obtain ⟨a, w₂, hw₂⟩ := c₂ ((Abelian.Ext.mk₀ SC.g).comp u' (zero_add q))
    have hfg : (Abelian.Ext.mk₀ SC.f).comp ((Abelian.Ext.mk₀ SC.g).comp u' (zero_add q))
