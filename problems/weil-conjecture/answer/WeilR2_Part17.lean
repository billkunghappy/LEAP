    rw [e]
    exact (E.adj.homEquiv (wcIntSuppObj DV) Y').bijective
  have hΦ := ext_transfer_of_hom_bijective E.L
    (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)) E.adj
    (wcIntSuppObj DV) (E.L.obj (wcIntSuppObj DV)) (E.adj.unit.app (wcIntSuppObj DV)) hhom
    (SheafOfModules.unit (wcRingSheaf V.left ℓ)) (2 * r)
  have hj : E.adj.unit.app (wcIntUnit V.left ℓ) ≫
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)).map E.μ.hom =
      wcUnitRestrict (wcIntRatRingSheafMap V.left ℓ) := by
    rw [← hE, Adjunction.homEquiv_unit]
  have keyG : ∀ (X : SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ))
      (z : Abelian.Ext X (wcIntUnit V.left ℓ) (2 * r)),
      (Abelian.Ext.mk₀ (E.adj.unit.app X)).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ))
        (wcIntRatExt E X (2 * r) z)) (zero_add (2 * r)) =
      z.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap V.left ℓ))) (add_zero (2 * r)) := by
    intro X z
    have hunfold : wcIntRatExt E X (2 * r) z =
        (Abelian.Ext.mapExactFunctor E.L z).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero (2 * r)) := rfl
    have hstar : z.comp (Abelian.Ext.mk₀ (E.adj.unit.app (wcIntUnit V.left ℓ))) (add_zero (2 * r)) =
        (Abelian.Ext.mk₀ (E.adj.unit.app X)).comp
          (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ))
            (Abelian.Ext.mapExactFunctor E.L z)) (zero_add (2 * r)) := by
