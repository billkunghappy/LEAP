    exact (wc_pmn_vp_restr_higher_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
      Dp hDp Di hDi I k hk1 hkN).of_iso iso

  have gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One : 𝒞) (OneW : 𝒞W) (μ : Φ.obj One ≅ OneW)
      [Projective OneW] (Ψ0 : CochainComplex 𝒞 ℤ) (N M : ℤ) (_hM : 0 < M)
      (_hΨ : ∀ q : ℤ, N < q → Limits.IsZero (Ψ0.homology q)),
      ∀ g : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) ⟶
        ((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0))⟦N⟧)⟦M⟧, g = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ One OneW μ _ Ψ0 N M hM hΨ0 g
    have hLE : (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0)).IsLE N := by
