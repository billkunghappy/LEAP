  have hflat : Flat β := by
    haveI := hWw
    haveI : Flat (Spec.map (CommRingCat.ofHom (algebraMap B₀ (MvPolynomial (Fin r) B₀)))) :=
      (HasRingHomProperty.Spec_iff (P := @Flat)).mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
    rw [← hw₂]
