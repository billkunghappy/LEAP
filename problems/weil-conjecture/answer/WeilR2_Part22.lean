            (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op No)).hom s := by
    intro F H _ ψ res θ h1 h2 hS hKη hθ hθK htw hext No hNo l₁ s
    haveI := hcofη
    have P1 : ∀ (N N' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))
        (f : N' ⟶ N) (s : F.obj.obj (Opposite.op N.right)),
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op N)).hom s =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
