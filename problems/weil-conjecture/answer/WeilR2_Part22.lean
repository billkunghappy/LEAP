        (FractionRing (X.presheaf.stalk x)))) =
      Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  have he : (Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x)).isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))) =
      Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x) := by
