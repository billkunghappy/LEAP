    haveI : IsClosedImmersion z' :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    have hptw : ∀ {Pp A B Ss : Scheme.{u}} {fst : Pp ⟶ A} {snd : Pp ⟶ B} {f1 : A ⟶ Ss}
