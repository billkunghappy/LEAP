  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : (wcContSheaf (wcP1Over K).left (Fin (r₁ + r₂) → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP) ⟶ X.over (wcGeomPoint K (wcP1Over K) hP),
      Φ = θG.inv ≫ (wcSupRho K hP).map f := ⟨_, rfl⟩
  obtain ⟨Φ', hΦ'def⟩ : ∃ Φ' : (wcContSheaf (wcP1Over K).left (Fin (r₁ + r₂) → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP) ⟶
        (Subobject.underlying.obj M).over (wcGeomPoint K (wcP1Over K) hP),
      Φ' = θG.inv ≫ (wcSupRho K hP).map e := ⟨_, rfl⟩
  have hΦ : Φ' ≫ (wcSupRho K hP).map M.arrow = Φ := by
    rw [hΦ'def, hΦdef, Category.assoc, ← Functor.map_comp, hef]
  haveI : Epi ((wcSupRho K hP).map e) := Functor.map_epi _ _
  haveI hΦ'epi : Epi Φ' := by rw [hΦ'def]; infer_instance
  haveI : Mono ((wcSupRho K hP).map M.arrow) := Functor.map_mono _ _

  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over K).left ℓ W hW (r₁ + r₂) N
    ((show (wcContSheaf (wcP1Over K).left (Fin (r₁ + r₂) → ℚ_[ℓ])).over W ⟶ X.over W from
      ((Scheme.ProEt.topology (wcP1Over K).left).overMapPullback AddCommGrpCat.{u+1} w).map Φ) ≫
        θ.hom)
  have star : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W)
      (s : (wcContSheaf (wcP1Over K).left (Fin (r₁ + r₂) → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s) =
      ((wcSupLin K ℓ A).hom.app (Opposite.op V)).hom s := by
    intro V h' s
    exact congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom s) hA
  have star2 : ∀ (b : ℕ) (B : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r₁ + r₂) → ℚ_[ℓ]))
      (T' : Over (wcGeomPoint K (wcP1Over K) hP))
      (s : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T'.left))
      (V : (wcP1Over K).left.ProEt) (h : V ⟶ T'.left) (h' : V ⟶ W), h' ≫ w = h ≫ T'.hom →
      (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((X.obj.map h.op).hom
        ((((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ).hom.app (Opposite.op T')).hom s)) =
      ((wcSupLin K ℓ (A ∘ₗ B)).hom.app (Opposite.op V)).hom
        (((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom s) := by
    intro b B T' s V h h' hh
    have hn := (((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ).hom.naturality
      (Over.homMk h rfl : Over.mk (h ≫ T'.hom) ⟶ T').op)
    have hn' := congrArg (fun q => AddCommGrpCat.Hom.hom q s) hn
    have nat : (X.obj.map h.op).hom
        ((((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ).hom.app (Opposite.op T')).hom s) =
      (Φ.hom.app (Opposite.op (Over.mk (h ≫ T'.hom)))).hom
        (((wcSupLin K ℓ B).hom.app (Opposite.op V)).hom
          (((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom s)) :=
      hn'.symm
    have key : ∀ m : V ⟶ wcGeomPoint K (wcP1Over K) hP, m = h' ≫ w →
        ∀ y : (wcContSheaf (wcP1Over K).left (Fin (r₁ + r₂) → ℚ_[ℓ])).obj.obj (Opposite.op V),
          (Φ.hom.app (Opposite.op (Over.mk m))).hom y =
            (Φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y := by
      intro m hm y
      subst hm
      rfl
