        rw [hsp, Ideal.span_singleton_eq_top]; exact hu.map lamS
      exact (IsLocalRing.maximalIdeal.isMaximal S).ne_top htop
    · intro hc
      have h1 : lamS c ∈ Ideal.map lamS (IsLocalRing.maximalIdeal R ^ 2) :=
        Ideal.mem_map_of_mem _ hc
      rw [Ideal.map_pow] at h1
      have h2 : Ideal.map lamS (IsLocalRing.maximalIdeal R) ≤ IsLocalRing.maximalIdeal S := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact ((IsLocalRing.mem_maximalIdeal _).mp hx) (isUnit_of_map_unit lamS x hu)
      have h3 : lamS c ∈ IsLocalRing.maximalIdeal S ^ 2 := Ideal.pow_right_mono h2 2 h1
      have hπm : lamS c ∈ IsLocalRing.maximalIdeal S := by
        rw [hsp]; exact Ideal.mem_span_singleton_self _
      generalize lamS c = π at h3 hπm hsp
      rw [hsp, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h3
      obtain ⟨r, hr⟩ := h3
      have hmul : π * (1 - r * π) = 0 := by linear_combination (-1 : S) * hr
      have hrπ : r * π ∈ IsLocalRing.maximalIdeal S := Ideal.mul_mem_left _ r hπm
      have hu : IsUnit (1 - r * π) :=
        IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hrπ)
      have hπ0 : π = 0 := (IsUnit.mul_left_eq_zero hu).mp hmul
      apply hnf
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, hsp, hπ0, Ideal.span_singleton_eq_bot]

  haveI : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  haveI : SmoothOfRelativeDimension 1 (wcP1Over F'').hom := wc_proj_space_smooth F'' 1
  have hσ : (D.S j ≫ lam) ≫ wcProjKStr F'' M' = 𝟙 _ := by
    rw [Category.assoc, hlamstr, D.hS j]
  have hregC := (wc_tla_smooth_rational_stalk_regular F'' (wcProjK F'' M') (wcProjKStr F'' M') M'
    (D.S j ≫ lam) hσ (lam (D.S j (IsLocalRing.closedPoint F''))) rfl).1
  have hP1 := wc_tla_smooth_rational_stalk_regular F'' (wcP1Over F'').left (wcP1Over F'').hom 1
    (D.S j) (D.hS j) (D.S j (IsLocalRing.closedPoint F'')) rfl
  have hnf : ¬ IsField ((wcP1Over F'').left.presheaf.stalk (D.S j (IsLocalRing.closedPoint F''))) := by
    intro hF
    have h0 := ringKrullDim_eq_zero_of_isField hF
    rw [hP1.2] at h0
    simp at h0
  obtain ⟨hg1, hg2⟩ := s3 _ _ (lam.stalkMap (D.S j (IsLocalRing.closedPoint F''))).hom
    inferInstance _ hspan hnf

  have main : ∀ (w : Spec (.of A) ⟶ wcProjK F'' M'), WeaklyEtale w →
      ∀ (y' : wcProjK F'' M') (hy' : y' ∈ U),
      IsRegularLocalRing ((wcProjK F'' M').presheaf.stalk y') →
      ((wcProjK F'' M').presheaf.germ U y' hy').hom φ ∈
        IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk y') →
      ((wcProjK F'' M').presheaf.germ U y' hy').hom φ ∉
        IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk y') ^ 2 →
      w (IsLocalRing.closedPoint A) = y' →
      ∃ f : A, IsNoetherianRing A ∧ IsRegularLocalRing A ∧ IsDomain A ∧
        f ∈ IsLocalRing.maximalIdeal A ∧ f ∉ IsLocalRing.maximalIdeal A ^ 2 ∧
        IsDomain (A ⧸ Ideal.span {f}) ∧ IsRegularLocalRing (A ⧸ Ideal.span {f}) ∧
        (∀ q : PrimeSpectrum A, w q ∈ Δ ↔ f ∈ q.asIdeal) ∧
        ((ringChar F'' : A) = 0) := by
    intro w hw y' hy' hreg h1 h2 hwy
    subst hwy

    have hθloc : IsLocalHom (Scheme.stalkClosedPointTo w).hom :=
      Scheme.isLocalHom_stalkClosedPointTo w
    have hcomp := Scheme.Spec_stalkClosedPointTo_fromSpecStalk w
    haveI : WeaklyEtale ((wcProjK F'' M').fromSpecStalk (w (IsLocalRing.closedPoint A))) :=
      wc_fromSpecStalk_weaklyEtale _ _
    haveI : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo w) ≫
        (wcProjK F'' M').fromSpecStalk (w (IsLocalRing.closedPoint A))) := by
      rw [hcomp]; exact hw
    have hspec := WeaklyEtale.of_comp (Spec.map (Scheme.stalkClosedPointTo w))
      ((wcProjK F'' M').fromSpecStalk (w (IsLocalRing.closedPoint A)))
    have hθ := wc_lpkt_specMap_weaklyEtale_ring _ _ (Scheme.stalkClosedPointTo w).hom hspec

    haveI := hreg
    obtain ⟨hNA, hmap⟩ := wc_tla_shens_noeth_unram _ A (Scheme.stalkClosedPointTo w).hom hθloc hθ
    haveI := hNA
    letI := (Scheme.stalkClosedPointTo w).hom.toAlgebra
    haveI : IsLocalHom (algebraMap ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A)))
      A) := hθloc
    haveI : Module.Flat ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A :=
      hθ.flat
    haveI : Module.FaithfullyFlat
        ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hquot : IsRegularLocalRing (A ⧸ Ideal.map (algebraMap
        ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A)
        (IsLocalRing.maximalIdeal
          ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))))) := by
      have hm' : Ideal.map (algebraMap
          ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A)
          (IsLocalRing.maximalIdeal
            ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A)))) =
          IsLocalRing.maximalIdeal A := hmap
      rw [hm']
      letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
      exact IsRegularLocalRing.instOfIsLocalRingOfIsDomainOfIsPrincipalIdealRing _
    have hRA : IsRegularLocalRing A := wc_hnas_pfc_regular_flat_ascent _ A hreg hquot

    have hf1 : (Scheme.stalkClosedPointTo w).hom
        (((wcProjK F'' M').presheaf.germ U _ hy').hom φ) ∈ IsLocalRing.maximalIdeal A := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact ((IsLocalRing.mem_maximalIdeal _).mp h1)
        (isUnit_of_map_unit (Scheme.stalkClosedPointTo w).hom _ hu)
    have hf2 : (Scheme.stalkClosedPointTo w).hom
        (((wcProjK F'' M').presheaf.germ U _ hy').hom φ) ∉ IsLocalRing.maximalIdeal A ^ 2 := by
      intro hc
      apply h2
      have hc' : algebraMap ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A
          (((wcProjK F'' M').presheaf.germ U _ hy').hom φ) ∈
          Ideal.map (algebraMap ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A)
            (IsLocalRing.maximalIdeal
              ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) ^ 2) := by
        rw [Ideal.map_pow]
        have hm' : Ideal.map (algebraMap
            ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) A)
            (IsLocalRing.maximalIdeal
              ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A)))) =
            IsLocalRing.maximalIdeal A := hmap
        rw [hm']
        exact hc
      have hcm := Ideal.comap_map_eq_self_of_faithfullyFlat
        (A := ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A)))) (B := A)
        (IsLocalRing.maximalIdeal
          ((wcProjK F'' M').presheaf.stalk (w (IsLocalRing.closedPoint A))) ^ 2)
      rw [← hcm, Ideal.mem_comap]
      exact hc'

    have hDA : IsDomain A := wc_rl_isDomain wc_rl_quot_embdim (wc_rl_quot_regular wc_rl_quot_embdim) A hRA
    obtain ⟨hRf, -⟩ := wc_rl_quot_regular wc_rl_quot_embdim A hRA _ hf1 hf2
    have hDf := by
      haveI := hRf
      exact wc_rl_isDomain wc_rl_quot_embdim (wc_rl_quot_regular wc_rl_quot_embdim) _ hRf

    have hall : ∀ z : Spec (.of A), w z ∈ U := by
      intro z
      have hz : z ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
      exact (hz.map w.continuous).mem_open U.isOpen hy'
    have hle : (⊤ : (Spec (.of A)).Opens) ≤ w ⁻¹ᵁ U := fun z _ => hall z
    have hid : (Scheme.stalkClosedPointTo w).hom
        (((wcProjK F'' M').presheaf.germ U _ hy').hom φ) =
        (Scheme.ΓSpecIso (.of A)).hom ((w.appLE U ⊤ hle).hom φ) := by
      show (((wcProjK F'' M').presheaf.germ U _ hy') ≫ Scheme.stalkClosedPointTo w).hom φ = _
      rw [Scheme.germ_stalkClosedPointTo]
      rfl
    have e4 : (Spec (.of A)).basicOpen ((w.appLE U ⊤ hle).hom φ) =
        ⊤ ⊓ w ⁻¹ᵁ (wcProjK F'' M').basicOpen φ := Scheme.basicOpen_appLE _ _ _ _ _
    have e6 := basicOpen_eq_of_affine' ((w.appLE U ⊤ hle).hom φ)
    have hΔA : ∀ q : ↥(Spec (.of A)), w q ∈ Δ ↔ (Scheme.stalkClosedPointTo w).hom
        (((wcProjK F'' M').presheaf.germ U _ hy').hom φ) ∈ q.asIdeal := by
      intro q
      have m1 : q ∈ (Spec (.of A)).basicOpen ((w.appLE U ⊤ hle).hom φ) ↔
          w q ∈ (wcProjK F'' M').basicOpen φ := by
        rw [e4, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage]
        exact ⟨fun h => h.2, fun h => ⟨trivial, h⟩⟩
      have m2 : q ∈ (Spec (.of A)).basicOpen ((w.appLE U ⊤ hle).hom φ) ↔
          (Scheme.ΓSpecIso (.of A)).hom ((w.appLE U ⊤ hle).hom φ) ∉ q.asIdeal := by
        rw [e6]
        exact PrimeSpectrum.mem_basicOpen _ _
      have m3 : w q ∈ Δ ↔ w q ∉ (wcProjK F'' M').basicOpen φ := by
        rw [hΔ _ (hall q), Scheme.mem_basicOpen _ _ _ (hall q), IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff]
      rw [m3, ← m1, m2, not_not, hid]

    have hch : ((ringChar F'' : ℕ) : A) = 0 := by
      let ι : F'' →+* A := (Spec.preimage (w ≫ wcProjKStr F'' M')).hom
      rw [← map_natCast ι, ringChar.Nat.cast_ringChar, map_zero]
    exact ⟨_, hNA, hRA, hDA, hf1, hf2, hDf, hRf, fun q => hΔA q, hch⟩
  haveI : WeaklyEtale Vy.hom := Vy.prop
  obtain ⟨f, hN, hR, hD, hm, hm2, hDf, hRf, hΔf, hch⟩ :=
    main (e.inv ≫ Vy.hom) inferInstance _ hU hregC hg1 hg2 hVy
  exact ⟨f, hN, hR, hD, hm, hm2, hDf, hRf, hΔf, hch⟩

theorem wc_pfam_ltd_line_dvr (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (j : Fin D.m)
    (Vy Vx : (wcProjK F'' M').ProEt) (uyx : Vx ⟶ Vy)
    (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    [IsSepClosed (IsLocalRing.ResidueField Ay)] (ey : Vy.left ≅ Spec (.of Ay))
    (Ax : Type u) [CommRing Ax] [HenselianLocalRing Ax] (ex : Vx.left ≅ Spec (.of Ax))
    (hy : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (t₀ : (wcP1Over F'').left) (ht₀ : closure {t₀} = Set.univ)
    (hx : Vx.hom (ex.inv (IsLocalRing.closedPoint Ax)) = lam t₀) :
    ∃ φy : Ay, (∀ z : Vy.left, Vy.hom z ∈ Δ ↔ φy ∈ (ey.hom z).asIdeal) ∧
      φy ∈ IsLocalRing.maximalIdeal Ay ∧
      IsLocalRing.residue Ax (wcLtdRing ey ex uyx.left φy) ≠ 0 ∧
      ∀ a : Ay, IsLocalRing.residue Ax (wcLtdRing ey ex uyx.left a) ≠ 0 →
        ∃ (w v : Ay) (k : ℕ),
          IsLocalRing.residue Ax (wcLtdRing ey ex uyx.left a) =
            IsLocalRing.residue Ax (wcLtdRing ey ex uyx.left w) *
              IsLocalRing.residue Ax (wcLtdRing ey ex uyx.left φy) ^ k ∧
          IsLocalRing.residue Ax (wcLtdRing ey ex uyx.left (w * v)) = 1 :=
by
  classical

  have s3 : ∀ (A B : Type u) [CommRing A] [HenselianLocalRing A] [CommRing B]
      [Nontrivial B] (χ : A →+* B), Function.Surjective χ → True ∧ HenselianLocalRing B := by
    intro A B _ _ _ _ χ hχ
    refine ⟨trivial, ?_⟩
    haveI : IsLocalRing B := IsLocalRing.of_surjective' χ hχ
    haveI : IsLocalHom χ := IsLocalHom.of_surjective χ hχ
    refine { is_henselian := ?_ }
    intro f hf b₀ hfb hfd
    obtain ⟨F, hFmap, -, hFm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      (Polynomial.map_surjective χ hχ f) hf
    obtain ⟨a₀, rfl⟩ := hχ b₀
    have e1 : χ (F.eval a₀) = f.eval (χ a₀) := by
      rw [← hFmap, Polynomial.eval_map_apply]
    have e2 : χ (F.derivative.eval a₀) = f.derivative.eval (χ a₀) := by
      rw [← hFmap, Polynomial.derivative_map, Polynomial.eval_map_apply]
    have h1 : F.eval a₀ ∈ IsLocalRing.maximalIdeal A := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      rw [← e1] at hfb
      exact (IsLocalRing.mem_maximalIdeal _).1 hfb (hu.map χ)
    have h2 : IsUnit (F.derivative.eval a₀) := by
      rw [← e2] at hfd
      exact isUnit_of_map_unit χ _ hfd
    obtain ⟨a, ha, ham⟩ := HenselianLocalRing.is_henselian F hFm a₀ h1 h2
    refine ⟨χ a, ?_, ?_⟩
    · rw [← hFmap, Polynomial.IsRoot, Polynomial.eval_map_apply, ha.eq_zero, map_zero]
    · rw [← map_sub]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).1 ham (isUnit_of_map_unit χ _ hu)
  have s4 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] [CommRing B] [IsLocalRing B] (χ : A →+* B),
      Function.Surjective χ → True ∧ IsSepClosed (IsLocalRing.ResidueField B) := by
    intro A B _ _ _ _ _ χ hχ
    refine ⟨trivial, ?_⟩
    haveI : IsLocalHom χ := IsLocalHom.of_surjective χ hχ
    let e := IsLocalRing.ResidueField.map χ
    have hsurj : Function.Surjective e := by
      intro y
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨a, rfl⟩ := hχ b
      exact ⟨IsLocalRing.residue A a, IsLocalRing.ResidueField.map_residue χ a⟩
    let E := RingEquiv.ofBijective e ⟨e.injective, hsurj⟩
    apply IsSepClosed.of_exists_root
    intro p _ hpi hps
    let q := p.map E.symm.toRingHom
    have hqs : q.Separable := hps.map
    have hqd : q.degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (Irreducible.degree_pos hpi).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root q hqd hqs
    refine ⟨E.toRingHom x, ?_⟩
    have hpq : p = q.map E.toRingHom := by
      rw [Polynomial.map_map, RingEquiv.toRingHom_comp_symm_toRingHom, Polynomial.map_id]
    have h1 : (q.map E.toRingHom).eval (E.toRingHom x) = E.toRingHom (q.eval x) := by
      rw [Polynomial.eval_map_apply]
    rw [hx.eq_zero, map_zero] at h1
    rw [hpq]; exact h1
  have s5 : ∀ (A B K : Type u) [CommRing A] [CommRing B] [IsDomain B] [Field K]
      (χ : A →+* B), Function.Surjective χ → ∀ (ρ : A →+* K),
      (∀ a : A, ρ a = 0 ↔ χ a = 0) → ∀ (t : B), t ≠ 0 → ¬ IsUnit t →
      (∀ b : B, b ≠ 0 → ∃ (u : Bˣ) (n : ℕ), b = u * t ^ n) →
      ∀ (φ : A) (r : B), ¬ IsUnit (χ φ) → t = r * χ φ →
      ρ φ ≠ 0 ∧ ∀ a : A, ρ a ≠ 0 → ∃ (w v : A) (k : ℕ), ρ a = ρ w * ρ φ ^ k ∧ ρ (w * v) = 1 := by
    intro A B K _ _ _ _ χ hχ ρ hker t ht0 htu hfac φ r hφu htr
    have hχφ : χ φ ≠ 0 := by
      intro h; apply ht0; rw [htr, h, mul_zero]
    have hr0 : r ≠ 0 := by
      intro h; apply ht0; rw [htr, h, zero_mul]
    have hru : IsUnit r := by
      obtain ⟨u1, m, hm⟩ := hfac r hr0
      obtain ⟨u2, l, hl⟩ := hfac (χ φ) hχφ
      have hl1 : l ≠ 0 := by
        rintro rfl
        apply hφu
        rw [hl, pow_zero, mul_one]
        exact u2.isUnit
      obtain ⟨s, hs⟩ : ∃ s, m + l = s + 1 := ⟨m + l - 1, by omega⟩
      have key : t * 1 = t * ((u1 * u2 : Bˣ) * t ^ s) := by
        calc t * 1 = r * χ φ := by rw [mul_one, htr]
          _ = (u1 * t ^ m) * (u2 * t ^ l) := by rw [hm, hl]
          _ = (u1 * u2 : Bˣ) * t ^ (m + l) := by push_cast; ring
          _ = t * ((u1 * u2 : Bˣ) * t ^ s) := by rw [hs, pow_succ]; ring
      have key2 := mul_left_cancel₀ ht0 key
      by_cases hs0 : s = 0
      · have hm0 : m = 0 := by omega
        rw [hm, hm0, pow_zero, mul_one]
        exact u1.isUnit
      · exfalso
        apply htu
        have : IsUnit ((u1 * u2 : Bˣ) * t ^ s : B) := by rw [← key2]; exact isUnit_one
        have h2 := isUnit_of_mul_isUnit_right this
        obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hs0
        rw [hk, pow_succ] at h2
        exact isUnit_of_mul_isUnit_right h2
    refine ⟨fun h => hχφ ((hker φ).1 h), ?_⟩
    intro a ha
    have hχa : χ a ≠ 0 := fun h => ha ((hker a).2 h)
    obtain ⟨u, n, hn⟩ := hfac (χ a) hχa
    obtain ⟨ru, hru'⟩ := hru
    obtain ⟨w, hw⟩ := hχ ((u * ru ^ n : Bˣ) : B)
    obtain ⟨v, hv⟩ := hχ (((u * ru ^ n)⁻¹ : Bˣ) : B)
    refine ⟨w, v, n, ?_, ?_⟩
    · have h1 : χ (a - w * φ ^ n) = 0 := by
        rw [map_sub, map_mul, map_pow, hw, hn, htr, ← hru']
        simp only [Units.val_mul, Units.val_pow_eq_pow_val]
        ring
      have h2 := (hker _).2 h1
      rw [map_sub, map_mul, map_pow, sub_eq_zero] at h2
      exact h2
    · have h1 : χ (w * v - 1) = 0 := by
        rw [map_sub, map_mul, hw, hv, map_one, Units.mul_inv, sub_self]
      have h2 := (hker _).2 h1
      rw [map_sub, map_one, sub_eq_zero] at h2
      exact h2
  have s6 : ∀ (B : Type u) [CommRing B] (t : B),
      (∀ b : B, b ≠ 0 → ∃ (u : Bˣ) (n : ℕ), b = u * t ^ n) →
      ∀ (P : Ideal B), P.IsPrime → t ∉ P → P = ⊥ := by
    intro B _ t hfac P hP htP
    rw [Submodule.eq_bot_iff]
    intro b hb
    by_contra hb0
    obtain ⟨u, n, rfl⟩ := hfac b hb0
    have h1 : t ^ n ∈ P := by
      have := P.mul_mem_left (↑u⁻¹ : B) hb
      rwa [← mul_assoc, Units.inv_mul, one_mul] at this
    rcases n with _ | n
    · rw [pow_zero] at h1
      exact hP.ne_top ((Ideal.eq_top_iff_one P).2 h1)
    · exact htP (hP.mem_of_pow_mem _ h1)
  have s7 : ∀ (k : Type u) [Field k] (Y₁ Z₁ : Scheme.{u}) (lm : Y₁ ⟶ Z₁)
      (B : Type u) [CommRing B] [IsLocalRing B] (ψ : Polynomial k →+* B)
      (j₁ : Spec (.of (Polynomial k)) ⟶ Y₁) [IsOpenImmersion j₁] (g : Spec (.of B) ⟶ Y₁),
      g = Spec.map (CommRingCat.ofHom ψ) ≫ j₁ → ∀ (s : Y₁), g (IsLocalRing.closedPoint B) = s →
      ∀ (U₁ : Z₁.Opens) (hU₁ : lm s ∈ U₁) (φ₁ : Γ(Z₁, U₁)),
      IsLocalRing.maximalIdeal (Y₁.presheaf.stalk s) =
        Ideal.span {(lm.stalkMap s).hom ((Z₁.presheaf.germ U₁ (lm s) hU₁).hom φ₁)} →
      ∀ (hle : (⊤ : (Spec (.of B)).Opens) ≤ (g ≫ lm) ⁻¹ᵁ U₁) (a : Polynomial k),
      ψ a ∈ IsLocalRing.maximalIdeal B →
      ∃ r : B, ψ a = r * (Scheme.ΓSpecIso (CommRingCat.of B)).hom
        (((g ≫ lm).appLE U₁ ⊤ hle).hom φ₁) := by
    intro k _ Y₁ Z₁ lm B _ _ ψ j₁ _ g hg s hs U₁ hU₁ φ₁ hgen' hle a ha
    subst hs
    haveI := Scheme.isLocalHom_stalkClosedPointTo g
    have hA : (Scheme.ΓSpecIso (CommRingCat.of B)).hom (((g ≫ lm).appLE U₁ ⊤ hle).hom φ₁) =
        (Scheme.stalkClosedPointTo g).hom ((lm.stalkMap (g (IsLocalRing.closedPoint B))).hom
          ((Z₁.presheaf.germ U₁ _ hU₁).hom φ₁)) := by
      have e1 := Scheme.stalkClosedPointTo_comp g lm
      have e2 := Scheme.germ_stalkClosedPointTo (g ≫ lm) U₁ hU₁
      have e3 : (Scheme.stalkClosedPointTo g).hom ((lm.stalkMap (g (IsLocalRing.closedPoint B))).hom
          ((Z₁.presheaf.germ U₁ _ hU₁).hom φ₁)) =
          (Scheme.stalkClosedPointTo (g ≫ lm)).hom ((Z₁.presheaf.germ U₁ _ hU₁).hom φ₁) := by
        rw [e1]; rfl
      rw [e3]
      have e4 := congrArg (fun f => f.hom φ₁) e2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e4
      erw [e4]
      rw [Scheme.Hom.appLE]
      simp only [Iso.trans_hom, Functor.mapIso_hom, CommRingCat.hom_comp, RingHom.comp_apply]
      rfl
    have hσex : ∃ σ : Y₁.presheaf.stalk (g (IsLocalRing.closedPoint B)),
        (Scheme.stalkClosedPointTo g).hom σ = ψ a := by
      subst hg
      have hΘ := Scheme.stalkClosedPointTo_comp (Spec.map (CommRingCat.ofHom ψ)) j₁
      have hS := Scheme.germ_stalkClosedPointTo_Spec (CommRingCat.ofHom ψ)
      let σ0 := ((Spec (CommRingCat.of (Polynomial k))).presheaf.germ ⊤
        ((Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint B)) trivial).hom
        ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv a)
      have hσ0 : (Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom ψ))).hom σ0 = ψ a := by
        have := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv a)) hS
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
        erw [this]
        simp
      let E := asIso (j₁.stalkMap ((Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint B)))
      refine ⟨E.inv.hom σ0, ?_⟩
      rw [hΘ]
      have h2 : (j₁.stalkMap ((Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint B))).hom
          (E.inv.hom σ0) = σ0 := by
        change (E.inv ≫ E.hom).hom σ0 = σ0
        rw [E.inv_hom_id]
        rfl
      change (Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom ψ))).hom
        ((j₁.stalkMap ((Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint B))).hom
          (E.inv.hom σ0)) = ψ a
      rw [h2]
      exact hσ0
    obtain ⟨σ, hσ⟩ := hσex
    have hσm : σ ∈ IsLocalRing.maximalIdeal _ := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      rw [← hσ] at ha
      exact (IsLocalRing.mem_maximalIdeal _).1 ha (hu.map _)
    rw [hgen'] at hσm
    obtain ⟨r', hr'⟩ := Ideal.mem_span_singleton'.1 hσm
    refine ⟨(Scheme.stalkClosedPointTo g).hom r', ?_⟩
    rw [hA, ← map_mul, hr', hσ]
  have appLE_top : ∀ (X₁ Y₁ Z₁ : Scheme.{u}) (a : X₁ ⟶ Y₁) (b : Y₁ ⟶ Z₁) (U₁ : Z₁.Opens)
      (h1 : (⊤ : Y₁.Opens) ≤ b ⁻¹ᵁ U₁) (h2 : (⊤ : X₁.Opens) ≤ (a ≫ b) ⁻¹ᵁ U₁) (s : Γ(Z₁, U₁)),
      a.appTop.hom ((b.appLE U₁ ⊤ h1).hom s) = ((a ≫ b).appLE U₁ ⊤ h2).hom s := by
    intro X₁ Y₁ Z₁ a b U₁ h1 h2 s
    have := Scheme.Hom.appLE_comp_appLE a b U₁ ⊤ ⊤ h1 le_top
    rw [← this]
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  have appLE_eq : ∀ (X₁ Z₁ : Scheme.{u}) (m1 m2 : X₁ ⟶ Z₁), m1 = m2 → ∀ (U₁ : Z₁.Opens)
      (h1 : (⊤ : X₁.Opens) ≤ m1 ⁻¹ᵁ U₁) (h2 : (⊤ : X₁.Opens) ≤ m2 ⁻¹ᵁ U₁) (s : Γ(Z₁, U₁)),
      (m1.appLE U₁ ⊤ h1).hom s = (m2.appLE U₁ ⊤ h2).hom s := by
    intro X₁ Z₁ m1 m2 hm U₁ h1 h2 s
    subst hm
    rfl
  have s8 : ∀ (W V Z₁ : Scheme.{u}) (A B : Type u) [CommRing A] [CommRing B]
      (eV : V ≅ Spec (.of A)) (eW : W ≅ Spec (.of B)) (f : W ⟶ V) (π : V ⟶ Z₁)
      (h' : Spec (.of B) ⟶ Z₁), eW.inv ≫ f ≫ π = h' → ∀ (U₁ : Z₁.Opens)
      (hle1 : (⊤ : V.Opens) ≤ π ⁻¹ᵁ U₁) (hle2 : (⊤ : (Spec (.of B)).Opens) ≤ h' ⁻¹ᵁ U₁)
      (φ₁ : Γ(Z₁, U₁)),
      (Spec.preimage (eW.inv ≫ f ≫ eV.hom)).hom
          ((Scheme.ΓSpecIso (CommRingCat.of A)).hom (eV.inv.appTop.hom ((π.appLE U₁ ⊤ hle1).hom φ₁))) =
        (Scheme.ΓSpecIso (CommRingCat.of B)).hom ((h'.appLE U₁ ⊤ hle2).hom φ₁) := by
    intro W V Z₁ A B _ _ eV eW f π h' hh U₁ hle1 hle2 φ₁
    have hnat := Scheme.ΓSpecIso_naturality (Spec.preimage (eW.inv ≫ f ≫ eV.hom))
    have h1 := congrArg (fun m => m.hom (eV.inv.appTop.hom ((π.appLE U₁ ⊤ hle1).hom φ₁))) hnat
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    refine h1.symm.trans ?_
    congr 1
    have hle3 : (⊤ : (Spec (.of A)).Opens) ≤ (eV.inv ≫ π) ⁻¹ᵁ U₁ := fun z _ => hle1 trivial
    have hle4 : (⊤ : (Spec (.of B)).Opens) ≤
        (Spec.map (Spec.preimage (eW.inv ≫ f ≫ eV.hom)) ≫ eV.inv ≫ π) ⁻¹ᵁ U₁ := by
      have : Spec.map (Spec.preimage (eW.inv ≫ f ≫ eV.hom)) ≫ eV.inv ≫ π = h' := by
        rw [Spec.map_preimage, ← hh]; simp
      rw [this]; exact hle2
    rw [appLE_top _ _ _ eV.inv π U₁ hle1 hle3, appLE_top _ _ _ _ _ U₁ hle3 hle4]
    apply appLE_eq
    rw [Spec.map_preimage, ← hh]; simp
  have s9 : ∀ (P Q : Scheme.{u}) (lm : Q ⟶ P) [IsClosedImmersion lm]
      (V : P.ProEt) (A : Type u) [CommRing A] (e : V.left ≅ Spec (.of A)),
      ∃ (T : Q.ProEt) (B : Type u) (_ : CommRing B) (eT : T.left ≅ Spec (.of B))
        (fT : T.left ⟶ V.left), fT ≫ V.hom = T.hom ≫ lm ∧
        Function.Surjective (Spec.preimage (eT.inv ≫ fT ≫ e.hom)).hom ∧
        ∀ (x : V.left) (t : Q), V.hom x = lm t → ∃ x' : T.left, fT x' = x ∧ T.hom x' = t := by
    intro P Q lm _ V A _ e
    haveI hVa : IsAffine V.left := IsAffine.of_isIso e.hom
    haveI hVa' : IsAffine ((𝟭 Scheme).obj V.left) := hVa
    haveI hci : IsClosedImmersion (Limits.pullback.fst V.hom lm) := inferInstance
    haveI hPa : IsAffine (Limits.pullback V.hom lm) :=
      isAffine_of_isAffineHom (Limits.pullback.fst V.hom lm)
    let T : Q.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.snd V.hom lm)
      (MorphismProperty.of_isPullback (IsPullback.of_hasPullback V.hom lm) V.prop)
    refine ⟨T, Γ(Limits.pullback V.hom lm, ⊤), inferInstance, (Limits.pullback V.hom lm).isoSpec,
      Limits.pullback.fst V.hom lm, Limits.pullback.condition, ?_, ?_⟩
    · have hs := (IsClosedImmersion.isAffine_surjective_of_isAffine
        ((Limits.pullback V.hom lm).isoSpec.inv ≫ Limits.pullback.fst V.hom lm ≫ e.hom)).2
      have hnat := Scheme.ΓSpecIso_naturality
        (Spec.preimage ((Limits.pullback V.hom lm).isoSpec.inv ≫ Limits.pullback.fst V.hom lm ≫ e.hom))
      rw [Spec.map_preimage] at hnat
      intro b
      obtain ⟨c, hc⟩ := hs ((Scheme.ΓSpecIso _).inv b)
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of A)).hom c, ?_⟩
      have h1 := congrArg (fun f => f.hom c) hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
      refine h1.symm.trans ?_
      erw [hc]
      simp
    · intro x t hxt
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback x t hxt
      exact ⟨z, hz1, hz2⟩
  have s10 : ∀ {X₁ Y₁ : Scheme.{u}} {R S : Type u} [CommRing R] [CommRing S]
      (eX : X₁ ≅ Spec (.of R)) (eY : Y₁ ≅ Spec (.of S)) (g : Y₁ ⟶ X₁) (y : Y₁) (a : R),
      a ∈ (eX.hom (g y)).asIdeal ↔
        (Spec.preimage (eY.inv ≫ g ≫ eX.hom)).hom a ∈ (eY.hom y).asIdeal := by
    intro X₁ Y₁ R S _ _ eX eY g y a
    have h1 : Spec.map (Spec.preimage (eY.inv ≫ g ≫ eX.hom)) = eY.inv ≫ g ≫ eX.hom :=
      Spec.map_preimage _
    have h2 : (Spec.map (Spec.preimage (eY.inv ≫ g ≫ eX.hom))) (eY.hom y) = eX.hom (g y) := by
      rw [h1]
      simp
    rw [← h2]
    rfl

  obtain ⟨U, hU, φ, hΔ, hgen⟩ := hH.2.2.2.2.2.2.2.2.2.2.2.2 j
  have hlamCI : IsClosedImmersion lam := hH.2.2.2.2.2.2.2.1
  have hlamΔ := hH.2.2.2.2.2.2.2.2.2.2.2.1
  have hall : ∀ z : Vy.left, Vy.hom z ∈ U := by
    intro z
    have h1 : ey.hom z ⤳ IsLocalRing.closedPoint Ay := IsLocalRing.specializes_closedPoint _
    have h2 := h1.map ey.inv.continuous
    rw [Scheme.hom_inv_apply] at h2
    have h3 := h2.map Vy.hom.continuous
    rw [hy] at h3
    exact h3.mem_open U.isOpen hU
  have hle1 : (⊤ : Vy.left.Opens) ≤ Vy.hom ⁻¹ᵁ U := fun z _ => hall z
  set ψ0 := (Vy.hom.appLE U ⊤ hle1).hom φ with hψ0
  set g0 := ey.inv.appTop.hom ψ0 with hg0
  set φy := (Scheme.ΓSpecIso (CommRingCat.of Ay)).hom g0 with hφydef
  have hA : ∀ z : Vy.left, Vy.hom z ∈ Δ ↔ φy ∈ (ey.hom z).asIdeal := by
    intro z
    have e4 : Vy.left.basicOpen ψ0 = ⊤ ⊓ Vy.hom ⁻¹ᵁ (wcProjK F'' M').basicOpen φ :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have e5 : ey.inv ⁻¹ᵁ Vy.left.basicOpen ψ0 = (Spec (CommRingCat.of Ay)).basicOpen g0 :=
      Scheme.preimage_basicOpen_top _ _
    have e6 := basicOpen_eq_of_affine' g0
    have m1 : z ∈ Vy.left.basicOpen ψ0 ↔ Vy.hom z ∈ (wcProjK F'' M').basicOpen φ := by
      rw [e4, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage]
      exact ⟨fun h => h.2, fun h => ⟨trivial, h⟩⟩
    have m2 : ey.hom z ∈ (Spec (CommRingCat.of Ay)).basicOpen g0 ↔ z ∈ Vy.left.basicOpen ψ0 := by
      rw [← e5, Scheme.Hom.mem_preimage, Scheme.hom_inv_apply]
    have m2' : ey.hom z ∈ (Spec (CommRingCat.of Ay)).basicOpen g0 ↔
        (Scheme.ΓSpecIso (CommRingCat.of Ay)).hom g0 ∉ (ey.hom z).asIdeal := by
      rw [e6]
      exact PrimeSpectrum.mem_basicOpen _ _
    have m3 : Vy.hom z ∈ Δ ↔ Vy.hom z ∉ (wcProjK F'' M').basicOpen φ := by
      rw [hΔ _ (hall z), Scheme.mem_basicOpen _ _ _ (hall z), IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff]
    rw [m3, ← m1, ← m2, m2', not_not]
  have hB : φy ∈ IsLocalRing.maximalIdeal Ay := by
    have h1 := (hA (ey.inv (IsLocalRing.closedPoint Ay))).1
      (by rw [hy]; exact (hlamΔ _).2 ⟨j, rfl⟩)
    have e3 : ey.hom (ey.inv (IsLocalRing.closedPoint Ay)) = IsLocalRing.closedPoint Ay :=
      Scheme.inv_hom_apply ey _
    first | exact e3 ▸ h1 | simpa only [e3] using h1 | (erw [e3] at h1; exact h1)

  obtain ⟨T, B, _, eT, fT, hsq, hχs, hlift⟩ := s9 _ _ lam Vy Ay ey
  set χ := (Spec.preimage (eT.inv ≫ fT ≫ ey.hom)).hom with hχdef
  have hcomp : ∀ x : T.left, Vy.hom (fT x) = lam (T.hom x) := by
    intro x
    have e : (fT ≫ Vy.hom) x = (T.hom ≫ lam) x := by rw [hsq]
    simpa only [Scheme.Hom.comp_apply] using e
  obtain ⟨xs, -, -⟩ := hlift (ey.inv (IsLocalRing.closedPoint Ay))
    (D.S j (IsLocalRing.closedPoint F'')) hy
  haveI : Nontrivial B := PrimeSpectrum.nonempty_iff_nontrivial.1 ⟨eT.hom xs⟩
  haveI hHB : HenselianLocalRing B := (s3 Ay B χ hχs).2
  haveI hSB : IsSepClosed (IsLocalRing.ResidueField B) := (s4 Ay B χ hχs).2
  haveI hχloc : IsLocalHom χ := IsLocalHom.of_surjective χ hχs

  set x₀ := eT.inv (IsLocalRing.closedPoint B) with hx₀
  have hfx₀ : fT x₀ = ey.inv (IsLocalRing.closedPoint Ay) := by
    have hideal : (ey.hom (fT x₀)).asIdeal = Ideal.comap χ (IsLocalRing.maximalIdeal B) := by
      ext a
      have e3 : eT.hom (eT.inv (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint B :=
        Scheme.inv_hom_apply eT _
      rw [s10 ey eT fT x₀ a, Ideal.mem_comap, hx₀]
      first | (rw [e3]; rfl) | (erw [e3]; rfl) | (simp only [e3]; rfl)
    have hmax : (ey.hom (fT x₀)).asIdeal.IsMaximal := by
      rw [hideal]; exact Ideal.comap_isMaximal_of_surjective χ hχs
    have hpt : ey.hom (fT x₀) = IsLocalRing.closedPoint Ay :=
      PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
    rw [← hpt, Scheme.hom_inv_apply]
  have hv : T.hom x₀ = D.S j (IsLocalRing.closedPoint F'') := by
    apply lam.isClosedEmbedding.injective
    rw [← hcomp, hfx₀, hy]

  obtain ⟨c, ψ, j', hj', hfac', hWE, hclos⟩ :=
    wc_skc_chart_factor F'' (D.S j) (D.hS j) T B eT hv
  haveI := hj'
  have htm : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal B := by
    have h1 := (hclos x₀).1 (by rw [hv]; exact subset_closure rfl)
    have e3 : eT.hom (eT.inv (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint B :=
      Scheme.inv_hom_apply eT _
    rw [hx₀] at h1
    first | exact e3 ▸ h1 | simpa only [e3] using h1 | (erw [e3] at h1; exact h1)
  obtain ⟨hdomB, ht0, hfacB⟩ := wc_skc_dvr F'' B c ψ hWE htm
  haveI := hdomB

  have hgl : (eT.inv ≫ T.hom) ≫ lam = eT.inv ≫ fT ≫ Vy.hom := by
    rw [Category.assoc, ← hsq]
  have hle2 : (⊤ : (Spec (.of B)).Opens) ≤ ((eT.inv ≫ T.hom) ≫ lam) ⁻¹ᵁ U := by
    intro z _
    rw [Scheme.Hom.mem_preimage, hgl]
    simp only [Scheme.Hom.comp_apply]
    exact hall _
  have hs0 : (eT.inv ≫ T.hom) (IsLocalRing.closedPoint B) = D.S j (IsLocalRing.closedPoint F'') := by
    first | exact hv | (rw [Scheme.Hom.comp_apply]; exact hv) | (erw [Scheme.Hom.comp_apply]; exact hv)
  obtain ⟨r, hr⟩ := s7 F'' _ _ lam B ψ j' (eT.inv ≫ T.hom) hfac' _ hs0 U hU φ hgen hle2
    (Polynomial.X - Polynomial.C c) htm
  have hχφ := s8 T.left Vy.left _ Ay B ey eT fT Vy.hom ((eT.inv ≫ T.hom) ≫ lam) hgl.symm U hle1
    hle2 φ
  have htr : ψ (Polynomial.X - Polynomial.C c) = r * χ φy := by
    rw [hr, ← hχφ]

  set x₁ := ex.inv (IsLocalRing.closedPoint Ax) with hx₁
  have hy₁ : Vy.hom (uyx.left x₁) = lam t₀ := by
    rw [← hx]
    have e : (uyx.left ≫ Vy.hom) x₁ = Vx.hom x₁ := by rw [MorphismProperty.Over.w uyx]
    simpa only [Scheme.Hom.comp_apply] using e
  obtain ⟨x'', hx''1, hx''2⟩ := hlift (uyx.left x₁) t₀ hy₁
  have htP : ψ (Polynomial.X - Polynomial.C c) ∉ (eT.hom x'').asIdeal := by
    intro htP
    have h1 := (hclos x'').2 htP
    rw [hx''2] at h1
    have h2 : closure {t₀} ⊆ closure {D.S j (IsLocalRing.closedPoint F'')} :=
      closure_minimal (Set.singleton_subset_iff.2 h1) isClosed_closure
    rw [ht₀] at h2
    have h3 := (hclos (eT.inv ⟨⊥, Ideal.isPrime_bot⟩)).1 (h2 (Set.mem_univ _))
    have e3 : eT.hom (eT.inv ⟨⊥, Ideal.isPrime_bot⟩) = ⟨⊥, Ideal.isPrime_bot⟩ :=
      Scheme.inv_hom_apply eT _
    have h4 : ψ (Polynomial.X - Polynomial.C c) ∈ (⊥ : Ideal B) := by
      first | exact e3 ▸ h3 | simpa only [e3] using h3 | (erw [e3] at h3; exact h3)
    exact ht0 ((Submodule.mem_bot _).1 h4)
  have hPbot := s6 B _ hfacB (eT.hom x'').asIdeal (eT.hom x'').isPrime htP
  have hker : ∀ a : Ay, ((IsLocalRing.residue Ax).comp (wcLtdRing ey ex uyx.left)) a = 0 ↔
      χ a = 0 := by
    intro a
    rw [RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff]
    have e1 : wcLtdRing ey ex uyx.left a ∈ IsLocalRing.maximalIdeal Ax ↔
        a ∈ (ey.hom (uyx.left x₁)).asIdeal := by
      have e3 : ex.hom (ex.inv (IsLocalRing.closedPoint Ax)) = IsLocalRing.closedPoint Ax :=
        Scheme.inv_hom_apply ex _
      rw [s10 ey ex uyx.left x₁ a, hx₁]
      first | (rw [e3]; rfl) | (erw [e3]; rfl) | (simp only [e3]; rfl)
    rw [e1, ← hx''1, s10 ey eT fT x'' a, hPbot]
    exact Submodule.mem_bot _

  have hφu : ¬ IsUnit (χ φy) := by
    intro hu
    exact (IsLocalRing.mem_maximalIdeal _).1 hB (isUnit_of_map_unit χ _ hu)
  have htu : ¬ IsUnit (ψ (Polynomial.X - Polynomial.C c)) :=
    (IsLocalRing.mem_maximalIdeal _).1 htm
  obtain ⟨hc, hd⟩ := s5 Ay B (IsLocalRing.ResidueField Ax) χ hχs
    ((IsLocalRing.residue Ax).comp (wcLtdRing ey ex uyx.left)) hker _ ht0 htu hfacB φy r hφu htr
  exact ⟨φy, hA, hB, hc, hd⟩

theorem wc_pfam_ltd_ufd_power (A K : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    [UniqueFactorizationMonoid A] [Field K] (ρ : A →+* K) (f φ : A)
    (hfφ : ∀ q : PrimeSpectrum A, f ∈ q.asIdeal ↔ φ ∈ q.asIdeal)
    (hφm : φ ∈ IsLocalRing.maximalIdeal A) (hρφ : ρ φ ≠ 0)
    (hker : ∀ a : A, ρ a = 0 → a ∈ IsLocalRing.maximalIdeal A)
    (hval : ∀ a : A, ρ a ≠ 0 → ∃ (w v : A) (k : ℕ), ρ a = ρ w * ρ φ ^ k ∧ ρ (w * v) = 1) :
    ∃ (u : Aˣ) (k : ℕ), f = u * φ ^ k :=
by
  classical

  have L1 : ∀ a v : A, ρ (a * v) = 1 → IsUnit a := by
    intro a v h
    have h1 : a * v - 1 ∈ IsLocalRing.maximalIdeal A :=
      hker _ (by rw [map_sub, h, map_one, sub_self])
    have h2 : 1 - a * v ∈ nonunits A := by
      rw [← IsLocalRing.mem_maximalIdeal]
      have := (Ideal.neg_mem_iff (I := IsLocalRing.maximalIdeal A)).mpr h1
      rwa [neg_sub] at this
    exact isUnit_of_mul_isUnit_left (IsLocalRing.isUnit_of_mem_nonunits_one_sub_self (a * v) h2)
  have hφnu : ¬ IsUnit φ := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hφm
    exact hφm

  have L2 : ∀ a : A, ¬ IsUnit a → ρ a ≠ 0 → ∃ (w : A) (j : ℕ), ρ a = ρ w * ρ φ ^ (j + 1) := by
    intro a ha hρa
    obtain ⟨w, v, k, hk, hwv⟩ := hval a hρa
    cases k with
    | zero =>
      exfalso
      apply ha
      apply L1 a v
      rw [map_mul, hk, pow_zero, mul_one, ← map_mul, hwv]
    | succ j => exact ⟨w, j, hk⟩

  have hirr : Irreducible φ := by
    refine irreducible_iff.mpr ⟨hφnu, fun a b hab => ?_⟩
    by_contra hcon
    push_neg at hcon
    obtain ⟨ha, hb⟩ := hcon
    have hρab : ρ a * ρ b ≠ 0 := by rw [← map_mul, ← hab]; exact hρφ
    obtain ⟨w₁, j₁, h₁⟩ := L2 a ha (left_ne_zero_of_mul hρab)
    obtain ⟨w₂, j₂, h₂⟩ := L2 b hb (right_ne_zero_of_mul hρab)
    apply hφnu
    apply L1 φ (w₁ * w₂ * φ ^ (j₁ + j₂))
    have e : ρ φ * 1 = ρ φ * (ρ (φ * (w₁ * w₂ * φ ^ (j₁ + j₂)))) := by
      calc ρ φ * 1 = ρ φ := mul_one _
        _ = ρ a * ρ b := by rw [hab, map_mul]
        _ = _ := by rw [h₁, h₂]; simp only [map_mul, map_pow]; ring
    exact (mul_left_cancel₀ hρφ e).symm

  have hf0 : f ≠ 0 := by
    intro hf
    have h1 := (hfφ ⟨⊥, Ideal.isPrime_bot⟩).mp (by rw [hf]; exact Ideal.zero_mem _)
    have h2 : φ = 0 := Ideal.mem_bot.mp h1
    exact hρφ (by rw [h2, map_zero])

  have hC : ∀ p : A, Irreducible p → p ∣ f → Associated p φ := by
    intro p hp hpf
    have hpp : Prime p := UniqueFactorizationMonoid.irreducible_iff_prime.mp hp
    have hI : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hpp.ne_zero).mpr hpp
    have h1 := (hfφ ⟨Ideal.span {p}, hI⟩).mp (Ideal.mem_span_singleton.mpr hpf)
    have h2 : p ∣ φ := Ideal.mem_span_singleton.mp h1
    exact hp.associated_of_dvd hirr h2
  have key : ∀ a : A, a ∣ f → ∃ (u : Aˣ) (k : ℕ), a = u * φ ^ k := by
    intro a
    refine WfDvdMonoid.induction_on_irreducible a ?_ ?_ ?_
    · intro h
      exact absurd (zero_dvd_iff.mp h) hf0
    · intro c hc _
      exact ⟨hc.unit, 0, by rw [pow_zero, mul_one, IsUnit.unit_spec]⟩
    · intro c i _ hi ih h
      obtain ⟨u, k, hu⟩ := ih (dvd_of_mul_left_dvd h)
      obtain ⟨w, hw⟩ := hC i hi (dvd_of_mul_right_dvd h)
      refine ⟨w⁻¹ * u, k + 1, ?_⟩
      have hi' : i = φ * ↑w⁻¹ := by rw [← hw, Units.mul_inv_cancel_right]
      rw [hi', hu, Units.val_mul, pow_succ]
      ring
  exact key f dvd_rfl

theorem wc_pfam_ltd_kummer_char (A L : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] [Field L] [IsSepClosed L] (pc : ℕ)
    (hunit : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → IsUnit (m : A))
    (ι : A →+* L) (σ' : L →+* L) (hσ' : σ'.comp ι = ι) (φ : A) (hφ : ι φ ≠ 0)
    (hμ : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ z : L, z ^ m = 1 → ∃ ζ : A, ζ ^ m = 1 ∧ ι ζ = z) :
    ∃ c : ℕ → A, (∀ m : ℕ, 0 < m → ¬ pc ∣ m → c m ^ m = 1 ∧
        ∀ w : L, w ^ m = ι φ → σ' w = ι (c m) * w) ∧
      ∀ m d : ℕ, 0 < m → 0 < d → ¬ pc ∣ m * d → c (m * d) ^ d = c m :=
by
  classical
  have s1 : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → (m : L) ≠ 0 := by
    intro m hm hpm
    rw [← map_natCast ι m]
    exact ((hunit m hm hpm).map ι).ne_zero
  have s2 : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∃ w : L, w ^ m = ι φ ∧ w ≠ 0 := by
    intro m hm hpm
    haveI : NeZero (m : L) := ⟨s1 m hm hpm⟩
    obtain ⟨w₀, hw₀⟩ := IsSepClosed.exists_pow_nat_eq (ι φ) m
    refine ⟨w₀, hw₀, ?_⟩
    intro h0
    apply hφ
    rw [← hw₀, h0, zero_pow hm.ne']
  have hfix : ∀ a : A, σ' (ι a) = ι a := fun a => by
    have := DFunLike.congr_fun hσ' a
    rw [RingHom.comp_apply] at this
    exact this
  have s3 : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ z : L, z ^ m = 1 → σ' z = z := by
    intro m hm hpm z hz
    obtain ⟨ζ, -, hζ⟩ := hμ m hm hpm z hz
    rw [← hζ]
    exact hfix ζ
  have s4 : ∀ m : ℕ, ∃ ζ : A, 0 < m → ¬ pc ∣ m →
      ζ ^ m = 1 ∧ ∀ w : L, w ^ m = ι φ → σ' w = ι ζ * w := by
    intro m
    by_cases hadm : 0 < m ∧ ¬ pc ∣ m
    · obtain ⟨hm, hpm⟩ := hadm
      obtain ⟨w₀, hw₀, hw₀0⟩ := s2 m hm hpm
      have hσφ : σ' w₀ ^ m = ι φ := by rw [← map_pow, hw₀, hfix]
      have hz : (σ' w₀ * w₀⁻¹) ^ m = 1 := by
        rw [mul_pow, inv_pow, hσφ, hw₀, mul_inv_cancel₀ hφ]
      obtain ⟨ζ, hζm, hζ⟩ := hμ m hm hpm _ hz
      refine ⟨ζ, fun _ _ => ⟨hζm, fun w hw => ?_⟩⟩
      have hη : (w * w₀⁻¹) ^ m = 1 := by
        rw [mul_pow, inv_pow, hw, hw₀, mul_inv_cancel₀ hφ]
      have hση := s3 m hm hpm _ hη
      have hw_eq : w = (w * w₀⁻¹) * w₀ := by
        rw [mul_assoc, inv_mul_cancel₀ hw₀0, mul_one]
      have hσw₀ : σ' w₀ = (σ' w₀ * w₀⁻¹) * w₀ := by
        rw [mul_assoc, inv_mul_cancel₀ hw₀0, mul_one]
      calc σ' w = σ' ((w * w₀⁻¹) * w₀) := by rw [← hw_eq]
        _ = σ' (w * w₀⁻¹) * σ' w₀ := map_mul _ _ _
        _ = (w * w₀⁻¹) * ((σ' w₀ * w₀⁻¹) * w₀) := by rw [hση, ← hσw₀]
        _ = (σ' w₀ * w₀⁻¹) * ((w * w₀⁻¹) * w₀) := by ring
        _ = ι ζ * w := by rw [← hw_eq, hζ]
    · exact ⟨1, fun hm hpm => absurd ⟨hm, hpm⟩ hadm⟩
  choose c hc using s4
  have s5 : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ ζ₁ ζ₂ : A, ζ₁ ^ m = 1 → ζ₂ ^ m = 1 →
      ι ζ₁ = ι ζ₂ → ζ₁ = ζ₂ := by
    intro m hm hpm ζ₁ ζ₂ h₁ h₂ hι
    have hmem : ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have h3 := hu.map ι
      rw [map_sub, hι, sub_self] at h3
      exact not_isUnit_zero h3
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    have hηζ : (ζ₁ * ζ₂ ^ k) * ζ₂ = ζ₁ := by rw [mul_assoc, ← pow_succ, h₂, mul_one]
    have hηm : (ζ₁ * ζ₂ ^ k) ^ (k + 1) = 1 := by
      rw [mul_pow, h₁, one_mul, ← pow_mul, mul_comm k (k + 1), pow_mul, h₂, one_pow]
    have hres : IsLocalRing.residue A ζ₁ = IsLocalRing.residue A ζ₂ := by
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact hmem
    have hηres : IsLocalRing.residue A (ζ₁ * ζ₂ ^ k) = 1 := by
      rw [map_mul, hres, map_pow, ← pow_succ', ← map_pow, h₂, map_one]
    have hS : IsUnit (∑ i ∈ Finset.range (k + 1), (ζ₁ * ζ₂ ^ k) ^ i) := by
      by_contra hn
      have h0 : IsLocalRing.residue A (∑ i ∈ Finset.range (k + 1), (ζ₁ * ζ₂ ^ k) ^ i) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).2
          (by rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hn)
      rw [map_sum] at h0
      simp only [map_pow, hηres, one_pow, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul, mul_one] at h0
      have hu := (hunit (k + 1) hm hpm).map (IsLocalRing.residue A)
      rw [map_natCast] at hu
      push_cast at h0 hu
      exact hu.ne_zero h0
    have hgeom := geom_sum_mul (ζ₁ * ζ₂ ^ k) (k + 1)
    rw [hηm, sub_self] at hgeom
    have hη1 : ζ₁ * ζ₂ ^ k = 1 := sub_eq_zero.1 (hS.mul_right_eq_zero.1 hgeom)
    rw [← hηζ, hη1, one_mul]
  refine ⟨c, fun m hm hpm => hc m hm hpm, ?_⟩
  intro m d hm hd hpmd
  have hpm : ¬ pc ∣ m := fun h => hpmd (h.mul_right d)
  have hmd : 0 < m * d := Nat.mul_pos hm hd
  obtain ⟨w, hw, hw0⟩ := s2 (m * d) hmd hpmd
  have e1 := (hc (m * d) hmd hpmd).2 w hw
  have hwd : (w ^ d) ^ m = ι φ := by rw [← pow_mul, mul_comm d m, hw]
  have e2 := (hc m hm hpm).2 (w ^ d) hwd
  have e3 : ι (c (m * d) ^ d) * w ^ d = ι (c m) * w ^ d := by
    calc ι (c (m * d) ^ d) * w ^ d = (ι (c (m * d)) * w) ^ d := by rw [map_pow, mul_pow]
      _ = (σ' w) ^ d := by rw [e1]
      _ = σ' (w ^ d) := (map_pow _ _ _).symm
      _ = ι (c m) * w ^ d := e2
  have e4 := mul_right_cancel₀ (pow_ne_zero d hw0) e3
  apply s5 m hm hpm _ _ ?_ (hc m hm hpm).1 e4
  rw [← pow_mul, mul_comm d m]
  exact (hc (m * d) hmd hpmd).1

theorem wc_pfam_ltd_mu_transport (A K : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] [Field K] (h : A →+* K) (m : ℕ) (hm : 0 < m)
    (hmu : IsUnit (m : A)) :
    ∀ z : K, z ^ m = 1 → ∃ ζ : A, ζ ^ m = 1 ∧ h ζ = z :=
by
  classical
  have key : ∀ N : ℕ, IsUnit (N : A) → Nat.card {ζ : A // ζ ^ N = 1} = N ∧
      ∀ ζ₁ ζ₂ : A, ζ₁ ^ N = 1 → ζ₂ ^ N = 1 → ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A →
        ζ₁ = ζ₂ := by
    intro N hN
    have hN0 : N ≠ 0 := by
      rintro rfl
      simp at hN
    have hNk : ((N : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue A)]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hN
    have rigid : ∀ ζ₁ ζ₂ : A, ζ₁ ^ N = 1 → ζ₂ ^ N = 1 →
        ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A → ζ₁ = ζ₂ := by
      intro ζ₁ ζ₂ h1 h2 hm
      have hSm : (∑ i ∈ Finset.range N, ζ₁ ^ i * ζ₂ ^ (N - 1 - i)) * (ζ₁ - ζ₂) = 0 := by
        rw [geom_sum₂_mul, h1, h2, sub_self]
      have hr12 : IsLocalRing.residue A ζ₁ = IsLocalRing.residue A ζ₂ := by
        have := (IsLocalRing.residue_eq_zero_iff _).mpr hm
        rw [map_sub, sub_eq_zero] at this
        exact this
      have hy : IsLocalRing.residue A ζ₂ ≠ 0 := by
        intro h0
        have : IsLocalRing.residue A (ζ₂ ^ N) = 1 := by rw [h2, map_one]
        rw [map_pow, h0, zero_pow hN0] at this
        exact zero_ne_one this
      have hrS : IsLocalRing.residue A (∑ i ∈ Finset.range N, ζ₁ ^ i * ζ₂ ^ (N - 1 - i)) =
          (N : IsLocalRing.ResidueField A) * IsLocalRing.residue A ζ₂ ^ (N - 1) := by
        rw [map_sum]
        rw [Finset.sum_congr rfl (g := fun _ => IsLocalRing.residue A ζ₂ ^ (N - 1))]
        · rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        · intro i hi
          rw [Finset.mem_range] at hi
          rw [map_mul, map_pow, map_pow, hr12, ← pow_add]
          congr 1
          omega
      have hSu : IsUnit (∑ i ∈ Finset.range N, ζ₁ ^ i * ζ₂ ^ (N - 1 - i)) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hrS]
        exact mul_ne_zero hNk (pow_ne_zero _ hy)
      have : ζ₁ - ζ₂ = 0 := hSu.mul_right_eq_zero.mp hSm
      exact sub_eq_zero.mp this
    have lift : ∀ c a₀ : A, IsUnit a₀ → a₀ ^ N - c ∈ IsLocalRing.maximalIdeal A →
        ∃ a : A, a ^ N = c ∧ a - a₀ ∈ IsLocalRing.maximalIdeal A := by
      intro c a₀ ha₀ hc
      have hmon : (Polynomial.X ^ N - Polynomial.C c : Polynomial A).Monic :=
        Polynomial.monic_X_pow_sub_C c hN0
      have heval : (Polynomial.X ^ N - Polynomial.C c : Polynomial A).eval a₀ ∈
          IsLocalRing.maximalIdeal A := by
        simpa using hc
      have hder : IsUnit ((Polynomial.derivative
          (Polynomial.X ^ N - Polynomial.C c : Polynomial A)).eval a₀) := by
        rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X]
        simpa using hN.mul (ha₀.pow (N - 1))
      obtain ⟨a, ha, ham⟩ := HenselianLocalRing.is_henselian
        (Polynomial.X ^ N - Polynomial.C c) hmon a₀ heval hder
      refine ⟨a, ?_, ham⟩
      have h := ha.eq_zero
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at h
      exact sub_eq_zero.mp h
    have cardk : Nat.card {x : IsLocalRing.ResidueField A // x ^ N = 1} = N := by
      haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField A) := ⟨hNk⟩
      haveI : NeZero N := ⟨hN0⟩
      haveI := IsSepClosed.hasEnoughRootsOfUnity (IsLocalRing.ResidueField A) N
      obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (IsLocalRing.ResidueField A) N
      have hNpos : 0 < N := Nat.pos_of_ne_zero hN0
      rw [Nat.card_congr (Equiv.subtypeEquivRight (fun x =>
        (Polynomial.mem_nthRootsFinset hNpos (1 : IsLocalRing.ResidueField A) (x := x)).symm)),
        Nat.card_eq_finsetCard]
      exact hζ.card_nthRootsFinset
    refine ⟨?_, rigid⟩
    let Φ : {ζ : A // ζ ^ N = 1} → {x : IsLocalRing.ResidueField A // x ^ N = 1} :=
      fun ζ => ⟨IsLocalRing.residue A ζ.1, by rw [← map_pow, ζ.2, map_one]⟩
    have hinj : Function.Injective Φ := by
      intro ζ₁ ζ₂ h
      have h' : IsLocalRing.residue A ζ₁.1 = IsLocalRing.residue A ζ₂.1 :=
        congrArg Subtype.val h
      apply Subtype.ext
      apply rigid _ _ ζ₁.2 ζ₂.2
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, h', sub_self]
    have hsurj : Function.Surjective Φ := by
      rintro ⟨x, hx⟩
      have hx0 : x ≠ 0 := by
        rintro rfl
        rw [zero_pow hN0] at hx
        exact zero_ne_one hx
      obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective x
      have hua : IsUnit a₀ :=
        (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [ha₀]; exact hx0)
      obtain ⟨a, ha, ham⟩ := lift 1 a₀ hua (by
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, ha₀, hx, map_one, sub_self])
      refine ⟨⟨a, ha⟩, Subtype.ext ?_⟩
      show IsLocalRing.residue A a = x
      have := (IsLocalRing.residue_eq_zero_iff _).mpr ham
      rw [map_sub, sub_eq_zero, ha₀] at this
      exact this
    rw [Nat.card_eq_of_bijective Φ ⟨hinj, hsurj⟩, cardk]
  obtain ⟨hcard, hsep⟩ := key m hmu
  let f : {ζ : A // ζ ^ m = 1} → {z : K // z ^ m = 1} :=
    fun ζ => ⟨h ζ.1, by rw [← map_pow, ζ.2, map_one]⟩
  have hinj : Function.Injective f := by
    intro ζ₁ ζ₂ hf
    have hval : h ζ₁.1 = h ζ₂.1 := congrArg Subtype.val hf
    apply Subtype.ext
    apply hsep ζ₁.1 ζ₂.1 ζ₁.2 ζ₂.2
    by_contra hnot
    have hu : IsUnit (ζ₁.1 - ζ₂.1) := (IsLocalRing.notMem_maximalIdeal).mp hnot
    have hu' : IsUnit (h (ζ₁.1 - ζ₂.1)) := hu.map h
    rw [map_sub, hval, sub_self] at hu'
    exact not_isUnit_zero hu'
  let S : Finset K := Polynomial.nthRootsFinset m (1 : K)
  let g : {z : K // z ^ m = 1} → S :=
    fun z => ⟨z.1, (Polynomial.mem_nthRootsFinset hm (1 : K)).2 z.2⟩
  have hg : Function.Injective g := by
    intro a b hab
    have hab' : (g a).1 = (g b).1 := congrArg Subtype.val hab
    exact Subtype.ext hab'
  haveI : Finite {z : K // z ^ m = 1} := Finite.of_injective g hg
  have hle : Nat.card {z : K // z ^ m = 1} ≤ m := by
    have h1 := Nat.card_le_card_of_injective g hg
    rw [Nat.card_eq_finsetCard] at h1
    refine h1.trans ?_
    show (Polynomial.nthRootsFinset m (1 : K)).card ≤ m
    rw [Polynomial.nthRootsFinset_def]
    exact (Multiset.toFinset_card_le _).trans (Polynomial.card_nthRoots m 1)
  have hbij : Function.Bijective f :=
    hinj.bijective_of_nat_card_le (by rw [hcard]; exact hle)
  intro z hz
  obtain ⟨ζ, hζ⟩ := hbij.2 ⟨z, hz⟩
  exact ⟨ζ.1, ζ.2, congrArg Subtype.val hζ⟩

theorem wc_pfam_ltd_residue_kummer (A K : Type u) [CommRing A] [Field K] [IsSepClosed K]
    (pc : ℕ) (hpc : pc.Prime) (hpK : (pc : K) = 0) (ρ : A →+* K) (φ : A) (hρφ : ρ φ ≠ 0)
    (hnu : ¬ ∃ v : A, ρ (φ * v) = 1)
    (hval : ∀ a : A, ρ a ≠ 0 → ∃ (w v : A) (k : ℕ), ρ a = ρ w * ρ φ ^ k ∧ ρ (w * v) = 1)
    (hsep : ∀ x : K, ∃ P : Polynomial A, (P.map ρ).Separable ∧ (P.map ρ).eval x = 0)
    (hμ : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ z : K, z ^ m = 1 → ∃ a : A, ρ a = z)
    (c : ℕ → A) (hc : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ρ (c m) ^ m = 1)
    (hcc : ∀ m d : ℕ, 0 < m → 0 < d → ¬ pc ∣ m * d → ρ (c (m * d)) ^ d = ρ (c m)) :
    ∃ g : K →+* K, g.comp ρ = ρ ∧
      ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ t : K, t ^ m = ρ φ → g t = ρ (c m) * t :=
by
  classical

  haveI : CharP K pc := (CharP.charP_iff_prime_eq_zero hpc).mpr hpK
  have hNK : ∀ N : ℕ, ¬ pc ∣ N → (N : K) ≠ 0 := fun N h h0 =>
    h ((CharP.cast_eq_zero_iff K pc N).mp h0)

  have hrig : ∀ (a b : A) (N d : ℕ), ρ a ≠ 0 → ρ b ≠ 0 →
      ρ φ ^ d * ρ b ^ N = ρ a ^ N → N ∣ d := by
    intro a b N d ha hb h
    obtain ⟨w1, v1, k1, ha1, hw1⟩ := hval a ha
    obtain ⟨w2, v2, k2, hb2, hw2⟩ := hval b hb
    rw [ha1, hb2, mul_pow, mul_pow, ← pow_mul, ← pow_mul] at h
    have hw1' : ρ w1 * ρ v1 = 1 := by rw [← map_mul]; exact hw1
    have hw2' : ρ w2 * ρ v2 = 1 := by rw [← map_mul]; exact hw2
    have hE : ρ φ ^ (d + k2 * N) * ρ w2 ^ N = ρ φ ^ (k1 * N) * ρ w1 ^ N := by
      rw [pow_add]; linear_combination h
    have key : d + k2 * N = k1 * N := by
      rcases lt_trichotomy (d + k2 * N) (k1 * N) with hlt | heq | hgt
      · exfalso
        obtain ⟨r, hr⟩ := Nat.exists_eq_add_of_lt hlt
        have hp : ρ φ ^ (k1 * N) = ρ φ ^ (d + k2 * N) * ρ φ ^ (r + 1) := by
          rw [← pow_add]; congr 1
        have h2 : ρ φ ^ (d + k2 * N) * ρ w2 ^ N
            = ρ φ ^ (d + k2 * N) * (ρ φ ^ (r + 1) * ρ w1 ^ N) := by
          rw [hE, hp]; ring
        have h3 := mul_left_cancel₀ (pow_ne_zero _ hρφ) h2
        apply hnu
        refine ⟨φ ^ r * w1 ^ N * v2 ^ N, ?_⟩
        simp only [map_mul, map_pow]
        calc ρ φ * (ρ φ ^ r * ρ w1 ^ N * ρ v2 ^ N)
            = (ρ φ ^ (r + 1) * ρ w1 ^ N) * ρ v2 ^ N := by ring
          _ = ρ w2 ^ N * ρ v2 ^ N := by rw [h3]
          _ = (ρ w2 * ρ v2) ^ N := by ring
          _ = 1 := by rw [hw2', one_pow]
      · exact heq
      · exfalso
        obtain ⟨r, hr⟩ := Nat.exists_eq_add_of_lt hgt
        have hp : ρ φ ^ (d + k2 * N) = ρ φ ^ (k1 * N) * ρ φ ^ (r + 1) := by
          rw [← pow_add]; congr 1
        have h2 : ρ φ ^ (k1 * N) * (ρ φ ^ (r + 1) * ρ w2 ^ N)
            = ρ φ ^ (k1 * N) * ρ w1 ^ N := by
          rw [← hE, hp]; ring
        have h3 := mul_left_cancel₀ (pow_ne_zero _ hρφ) h2
        apply hnu
        refine ⟨φ ^ r * w2 ^ N * v1 ^ N, ?_⟩
        simp only [map_mul, map_pow]
        calc ρ φ * (ρ φ ^ r * ρ w2 ^ N * ρ v1 ^ N)
            = (ρ φ ^ (r + 1) * ρ w2 ^ N) * ρ v1 ^ N := by ring
          _ = ρ w1 ^ N * ρ v1 ^ N := by rw [h3]
          _ = (ρ w1 * ρ v1) ^ N := by ring
          _ = 1 := by rw [hw1', one_pow]
    have h1 : N ∣ d + k2 * N := key ▸ dvd_mul_left N k1
    have h2 := Nat.dvd_sub h1 (dvd_mul_left N k2)
    simpa using h2

  obtain ⟨K0, hK0⟩ : ∃ K0 : Subfield K, K0 = Subfield.closure (Set.range ρ) := ⟨_, rfl⟩
  have hsub : ∀ a : A, ρ a ∈ K0 := fun a => hK0 ▸ Subfield.subset_closure ⟨a, rfl⟩
  have hfrac : ∀ x ∈ K0, ∃ a b : A, ρ a / ρ b = x := by
    intro x hx
    rw [hK0] at hx
    obtain ⟨y, hy, z, hz, hyz⟩ := Subfield.mem_closure_iff.mp hx
    have hR : Subring.closure (Set.range ρ) = ρ.range := by
      rw [← RingHom.coe_range]; exact Subring.closure_eq _
    rw [hR] at hy hz
    obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hy
    obtain ⟨b, rfl⟩ := RingHom.mem_range.mp hz
    exact ⟨a, b, hyz⟩
  let ϖ0 : K0 := ⟨ρ φ, hsub φ⟩

  have hmin : ∀ N : ℕ, 0 < N → ¬ pc ∣ N → ∀ t : K, t ^ N = ρ φ →
      minpoly K0 t = Polynomial.X ^ N - Polynomial.C ϖ0 := by
    intro N hN hpN t ht
    set Q : Polynomial K0 := Polynomial.X ^ N - Polynomial.C ϖ0 with hQdef
    have hQm : Q.Monic := Polynomial.monic_X_pow_sub_C _ hN.ne'
    have hQd : Q.natDegree = N := Polynomial.natDegree_X_pow_sub_C
    have hQt : Polynomial.aeval t Q = 0 := by
      rw [hQdef, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C]
      show t ^ N - ρ φ = 0
      rw [ht, sub_self]
    have hint : IsIntegral K0 t := ⟨Q, hQm, by rw [← Polynomial.aeval_def]; exact hQt⟩
    have hqm := minpoly.monic hint
    have hqQ : minpoly K0 t ∣ Q := minpoly.dvd K0 t hQt
    have hQ0 : Q ≠ 0 := hQm.ne_zero
    have hdpos := minpoly.natDegree_pos hint
    have hdle : (minpoly K0 t).natDegree ≤ N := hQd ▸ Polynomial.natDegree_le_of_dvd hqQ hQ0
    set ι := algebraMap K0 K with hι
    have hQmap : Q.map ι = Polynomial.X ^ N - Polynomial.C (ρ φ) := by
      rw [hQdef, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
      rfl
    have hQsep : (Q.map ι).Separable := by
      rw [hQmap]; exact Polynomial.separable_X_pow_sub_C _ (hNK N hpN) hρφ
    have hQspl : (Q.map ι).Splits := IsSepClosed.splits_of_separable _ hQsep
    have hQmap0 : Q.map ι ≠ 0 := (hQm.map ι).ne_zero
    have hqdvd : (minpoly K0 t).map ι ∣ Q.map ι := Polynomial.map_dvd ι hqQ
    have hqspl : ((minpoly K0 t).map ι).Splits := hQspl.of_dvd hQmap0 hqdvd
    have hqmm : ((minpoly K0 t).map ι).Monic := hqm.map ι
    have hqdeg : ((minpoly K0 t).map ι).natDegree = (minpoly K0 t).natDegree :=
      hqm.natDegree_map ι
    set d := (minpoly K0 t).natDegree with hd
    set R := ((minpoly K0 t).map ι).roots with hRdef
    have hcard : R.card = d := by
      rw [← hqdeg]; exact Polynomial.splits_iff_card_roots.mp hqspl
    have hc0 : ((minpoly K0 t).map ι).coeff 0 = (-1) ^ d * R.prod := by
      rw [← hqdeg]; exact hqspl.coeff_zero_eq_prod_roots_of_monic hqmm
    have hRroot : ∀ r ∈ R, r ^ N = ρ φ := by
      intro r hr
      have h1 : r ∈ (Q.map ι).roots := Multiset.mem_of_le (Polynomial.roots.le_of_dvd hQmap0 hqdvd) hr
      rw [Polynomial.mem_roots hQmap0, hQmap, Polynomial.IsRoot, Polynomial.eval_sub,
        Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at h1
      exact h1
    have ht0 : t ≠ 0 := by
      rintro rfl; apply hρφ; rw [← ht, zero_pow hN.ne']
    have hprod : R.prod = (R.map (fun r => r / t)).prod * t ^ d := by
      have e1 : R.prod = (R.map (fun r => r / t * t)).prod := by
        rw [Multiset.map_congr rfl (fun r _ => div_mul_cancel₀ r ht0), Multiset.map_id']
      rw [e1, Multiset.prod_map_mul, Multiset.map_const', Multiset.prod_replicate, hcard]
    have hΞmem : (R.map (fun r => r / t)).prod ∈ K0 := by
      apply Subfield.multiset_prod_mem
      intro x hx
      obtain ⟨r, hr, rfl⟩ := Multiset.mem_map.mp hx
      have h1 : (r / t) ^ N = 1 := by rw [div_pow, hRroot r hr, ht, div_self hρφ]
      obtain ⟨a, ha⟩ := hμ N hN hpN _ h1
      rw [← ha]; exact hsub a
    have hΞ0 : (R.map (fun r => r / t)).prod ≠ 0 := by
      apply Multiset.prod_ne_zero
      intro h0
      obtain ⟨r, hr, hr0⟩ := Multiset.mem_map.mp h0
      rcases div_eq_zero_iff.mp hr0 with h | h
      · apply hρφ; rw [← hRroot r hr, h, zero_pow hN.ne']
      · exact ht0 h
    have htd : t ^ d ∈ K0 := by
      have hc0mem : ((minpoly K0 t).map ι).coeff 0 ∈ K0 := by
        rw [Polynomial.coeff_map]; exact SetLike.coe_mem _
      have e2 : t ^ d = (-1) ^ d * ((minpoly K0 t).map ι).coeff 0 /
          (R.map (fun r => r / t)).prod := by
        rw [hc0, hprod, ← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]
        exact (mul_div_cancel_left₀ _ hΞ0).symm
      rw [e2]
      exact K0.div_mem (K0.mul_mem (K0.pow_mem (K0.neg_mem K0.one_mem) _) hc0mem) hΞmem
    obtain ⟨a, b, hab⟩ := hfrac _ htd
    have htd0 : t ^ d ≠ 0 := pow_ne_zero _ ht0
    have hb0 : ρ b ≠ 0 := by
      intro h; rw [h, div_zero] at hab; exact htd0 hab.symm
    have ha0 : ρ a ≠ 0 := by
      intro h; rw [h, zero_div] at hab; exact htd0 hab.symm
    have heq : ρ φ ^ d * ρ b ^ N = ρ a ^ N := by
      have e3 : ρ a = t ^ d * ρ b := by rw [← hab, div_mul_cancel₀ _ hb0]
      rw [e3, mul_pow, ← pow_mul, mul_comm d N, pow_mul, ht]
    have hdvd := hrig a b N d ha0 hb0 heq
    have hNd : N ≤ d := Nat.le_of_dvd hdpos hdvd
    exact (Polynomial.eq_of_monic_of_dvd_of_natDegree_le hqm hQm hqQ (by omega)).symm

  let ρ0 : A →+* K0 := ρ.codRestrict K0 hsub
  have hρ0 : (algebraMap K0 K).comp ρ0 = ρ := by ext a; rfl
  have hall : ∀ s : K, IsIntegral K0 s ∧ ((minpoly K0 s).map (algebraMap K0 K)).Splits := by
    intro s
    obtain ⟨P, hPs, hPe⟩ := hsep s
    have hP0map : (P.map ρ0).map (algebraMap K0 K) = P.map ρ := by
      rw [Polynomial.map_map, hρ0]
    have hP0sep : (P.map ρ0).Separable :=
      (Polynomial.separable_map (algebraMap K0 K)).mp (hP0map ▸ hPs)
    have hP0e : Polynomial.aeval s (P.map ρ0) = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map, hP0map]; exact hPe
    have hint : IsIntegral K0 s :=
      IsAlgebraic.isIntegral ⟨P.map ρ0, hP0sep.ne_zero, hP0e⟩
    exact ⟨hint, IsSepClosed.splits_codomain _ (hP0sep.of_dvd (minpoly.dvd K0 s hP0e))⟩
  have hext : ∀ t t' : K, Polynomial.aeval t' (minpoly K0 t) = 0 →
      ∃ g : K →+* K, g.comp ρ = ρ ∧ g t = t' := by
    intro t t' ht'
    have hint := (hall t).1
    have hmem : t' ∈ (minpoly K0 t).aroots K :=
      Polynomial.mem_aroots.mpr ⟨minpoly.ne_zero hint, ht'⟩
    obtain ⟨Φ, hΦ⟩ := IntermediateField.exists_algHom_of_splits hall
      ((IntermediateField.algHomAdjoinIntegralEquiv K0 hint).symm ⟨t', hmem⟩)
    refine ⟨Φ.toRingHom, ?_, ?_⟩
    · ext a
      show Φ (algebraMap K0 K (ρ0 a)) = algebraMap K0 K (ρ0 a)
      exact Φ.commutes (ρ0 a)
    · have h1 := congrArg (fun F => F (IntermediateField.AdjoinSimple.gen K0 t)) hΦ
      simp only [AlgHom.comp_apply] at h1
      rw [IntermediateField.algHomAdjoinIntegralEquiv_symm_apply_gen] at h1
      exact h1

  have hlevel : ∀ N : ℕ, 0 < N → ¬ pc ∣ N → ∃ g : K →+* K, g.comp ρ = ρ ∧
      ∀ m : ℕ, 0 < m → m ∣ N → ∀ t : K, t ^ m = ρ φ → g t = ρ (c m) * t := by
    intro N hN hpN
    haveI : NeZero (N : K) := ⟨hNK N hpN⟩
    obtain ⟨tN, htN⟩ := IsSepClosed.exists_pow_nat_eq (ρ φ) N
    have htN0 : tN ≠ 0 := by
      rintro rfl; apply hρφ; rw [← htN, zero_pow hN.ne']
    have hmp := hmin N hN hpN tN htN
    obtain ⟨g, hgρ, hgt⟩ := hext tN (ρ (c N) * tN) (by
      rw [hmp, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C, mul_pow, htN,
        hc N hN hpN, one_mul]
      show ρ φ - ρ φ = 0
      exact sub_self _)
    refine ⟨g, hgρ, ?_⟩
    intro m hm hmN t ht
    obtain ⟨d, rfl⟩ := hmN
    have hd : 0 < d := Nat.pos_of_ne_zero (by rintro rfl; simp at hN)
    have hpm : ¬ pc ∣ m := fun h => hpN (dvd_mul_of_dvd_left h d)
    have hξ : (t / tN ^ d) ^ m = 1 := by
      rw [div_pow, ht, ← pow_mul, mul_comm d m, htN, div_self hρφ]
    obtain ⟨a, ha⟩ := hμ m hm hpm _ hξ
    have hga : g (t / tN ^ d) = t / tN ^ d := by
      rw [← ha]; exact RingHom.congr_fun hgρ a
    have htt : t = (t / tN ^ d) * tN ^ d := (div_mul_cancel₀ _ (pow_ne_zero _ htN0)).symm
    calc g t = g (t / tN ^ d) * g tN ^ d := by rw [← map_pow, ← map_mul, ← htt]
      _ = (t / tN ^ d) * (ρ (c (m * d)) * tN) ^ d := by rw [hga, hgt]
      _ = ρ (c (m * d)) ^ d * ((t / tN ^ d) * tN ^ d) := by ring
      _ = ρ (c m) * t := by rw [← htt, hcc m d hm hd hpN]

  let Ns : ℕ → ℕ := fun s => ∏ i ∈ (Finset.Icc 1 s).filter (fun i => ¬ pc ∣ i), i
  have hNs_pos : ∀ s, 0 < Ns s := fun s => Finset.prod_pos (fun i hi => by
    simp only [Finset.mem_filter, Finset.mem_Icc] at hi; omega)
  have hNs_p : ∀ s, ¬ pc ∣ Ns s := by
    intro s h
    obtain ⟨i, hi, hdi⟩ := (Prime.dvd_finsetProd_iff hpc.prime _).mp h
    exact (Finset.mem_filter.mp hi).2 hdi
  have hNs_dvd : ∀ s m, 0 < m → ¬ pc ∣ m → m ≤ s → m ∣ Ns s := fun s m hm hpm hms =>
    Finset.dvd_prod_of_mem _ (Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hm, hms⟩, hpm⟩)
  choose G hG hGlev using fun s => hlevel (Ns s) (hNs_pos s) (hNs_p s)

  have hfin : ∀ x : K, ∃ S : Set K, S.Finite ∧ ∀ s, G s x ∈ S := by
    intro x
    obtain ⟨P, hPs, hPe⟩ := hsep x
    refine ⟨{y | (P.map ρ).IsRoot y}, Polynomial.finite_setOfPred_isRoot hPs.ne_zero,
      fun s => ?_⟩
    show Polynomial.eval (G s x) (P.map ρ) = 0
    rw [Polynomial.eval_map, ← hG s, ← Polynomial.hom_eval₂, ← Polynomial.eval_map, hPe,
      map_zero]
  have hex : ∀ x : K, ∃ y, {s | G s x = y} ∈ (Filter.hyperfilter ℕ : Filter ℕ) := by
    intro x
    obtain ⟨S, hS, hGS⟩ := hfin x
    have huniv : (⋃ y ∈ S, {s | G s x = y}) ∈ Filter.hyperfilter ℕ := by
      apply Filter.univ_mem'
      intro s
      simp only [Set.mem_iUnion, Set.mem_setOf_eq]
      exact ⟨G s x, hGS s, rfl⟩
    obtain ⟨y, -, hy⟩ := (Ultrafilter.finite_biUnion_mem_iff hS).mp huniv
    exact ⟨y, hy⟩
  choose g0 hg0 using hex
  have h3 : ∀ x y z : K, ∃ s, G s x = g0 x ∧ G s y = g0 y ∧ G s z = g0 z := by
    intro x y z
    obtain ⟨s, hs⟩ := Filter.nonempty_of_mem
      (Filter.inter_mem (hg0 x) (Filter.inter_mem (hg0 y) (hg0 z)))
    exact ⟨s, hs.1, hs.2.1, hs.2.2⟩
  let g : K →+* K :=
    { toFun := g0
      map_one' := by
        obtain ⟨s, h1, -, -⟩ := h3 1 1 1
        show g0 1 = 1
        rw [← h1, map_one]
      map_mul' := fun x y => by
        obtain ⟨s, h1, h2, h12⟩ := h3 (x * y) x y
        show g0 (x * y) = g0 x * g0 y
        rw [← h1, ← h2, ← h12, map_mul]
      map_zero' := by
        obtain ⟨s, h1, -, -⟩ := h3 0 0 0
        show g0 0 = 0
        rw [← h1, map_zero]
      map_add' := fun x y => by
        obtain ⟨s, h1, h2, h12⟩ := h3 (x + y) x y
        show g0 (x + y) = g0 x + g0 y
        rw [← h1, ← h2, ← h12, map_add] }
  refine ⟨g, ?_, ?_⟩
  · ext a
    show g0 (ρ a) = ρ a
    obtain ⟨s, h1, -, -⟩ := h3 (ρ a) 0 0
    rw [← h1]
    exact RingHom.congr_fun (hG s) a
  · intro m hm hpm t ht
    have hcof : {s : ℕ | m ≤ s} ∈ (Filter.hyperfilter ℕ : Filter ℕ) :=
      Filter.hyperfilter_le_cofinite (by rw [Nat.cofinite_eq_atTop]; exact Filter.mem_atTop m)
    obtain ⟨s, hs1, hs2⟩ := Filter.nonempty_of_mem (Filter.inter_mem (hg0 t) hcof)
    show g0 t = _
    rw [← hs1]
    exact hGlev s m hm (hNs_dvd s m hm hpm hs2) t ht

theorem wc_skc_rho_bijective : ∀ (O A : Type u) [CommRing O] [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (ψ : O →+* A) (ρ : A →+* A),
    @Algebra.WeaklyEtale O A _ _ ψ.toAlgebra → ρ.comp ψ = ψ → IsLocalHom ρ →
    Function.Bijective ρ :=
by
  intro O A _ _ _ _ ψ ρ hW hρψ hloc
  have hT : @IsScalarTower O A A ψ.toAlgebra.toSMul ρ.toAlgebra.toSMul ψ.toAlgebra.toSMul := by
    refine @IsScalarTower.mk O A A ψ.toAlgebra.toSMul ρ.toAlgebra.toSMul ψ.toAlgebra.toSMul ?_
    intro x y z
    show ρ (ψ x * y) * z = ψ x * (ρ y * z)
    have h1 : ρ (ψ x) = ψ x := RingHom.congr_fun hρψ x
    rw [map_mul, h1, mul_assoc]
  have hρW := @wc_weaklyEtale_cancel O A A _ _ _ ψ.toAlgebra ψ.toAlgebra ρ.toAlgebra hT hW hW
  exact @wc_olivier A A _ _ ρ.toAlgebra _ _ inferInstance inferInstance hloc hρW

theorem wc_pfam_ltd_hensel_aut_lift (A B : Type u) [CommRing A] [CommRing B]
    [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] [IsDomain B]
    (β : A →+* B) (hβ : @Algebra.WeaklyEtale A B _ _ β.toAlgebra)
    (g : IsLocalRing.ResidueField B →+* IsLocalRing.ResidueField B)
    (hg : g.comp ((IsLocalRing.residue B).comp β) = (IsLocalRing.residue B).comp β) :
    ∃ α : B →+* B, α.comp β = β ∧ (∀ b, IsLocalRing.residue B (α b) = g (IsLocalRing.residue B b)) ∧
      Function.Injective α :=
by
  classical
  letI : Algebra A B := β.toAlgebra
  haveI : Algebra.WeaklyEtale A B := hβ
  letI : Algebra A (IsLocalRing.ResidueField B) := ((IsLocalRing.residue B).comp β).toAlgebra
  let f₁ : B →ₐ[A] IsLocalRing.ResidueField B :=
    { IsLocalRing.residue B with commutes' := fun a => rfl }
  let f₂ : B →ₐ[A] IsLocalRing.ResidueField B :=
    { g.comp (IsLocalRing.residue B) with commutes' := fun a => RingHom.congr_fun hg a }
  let φ : TensorProduct A B B →ₐ[A] IsLocalRing.ResidueField B := Algebra.TensorProduct.productMap f₁ f₂
  have hφ : ∀ x y : B, φ (TensorProduct.tmul A (x) (y)) = IsLocalRing.residue B x * g (IsLocalRing.residue B y) :=
    fun x y => Algebra.TensorProduct.productMap_apply_tmul f₁ f₂ x y
  let φr : TensorProduct A B B →+* IsLocalRing.ResidueField B := φ.toRingHom
  let q : Ideal (TensorProduct A B B) := RingHom.ker φr
  haveI hq : q.IsPrime := RingHom.ker_isPrime φr
  let ι : TensorProduct A B B →+* Localization.AtPrime q := algebraMap (TensorProduct A B B) (Localization.AtPrime q)
  have hunit : ∀ y : q.primeCompl, IsUnit (φr y) := fun y =>
    isUnit_iff_ne_zero.mpr (fun h => y.2 (RingHom.mem_ker.mpr h))
  let φq : Localization.AtPrime q →+* IsLocalRing.ResidueField B :=
    IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit
  have hφq : ∀ c, φq (ι c) = φr c := fun c => IsLocalization.lift_eq hunit c
  haveI : Algebra.WeaklyEtale (TensorProduct A B B) (Localization.AtPrime q) :=
    wc_localization_weaklyEtale _ _ q.primeCompl
  haveI : Algebra.WeaklyEtale B (TensorProduct A B B) := inferInstance
  have hWE : Algebra.WeaklyEtale B (Localization.AtPrime q) :=
    Algebra.WeaklyEtale.trans B (TensorProduct A B B) (Localization.AtPrime q)
  have hj₁ : ∀ b : B, algebraMap B (Localization.AtPrime q) b = ι (TensorProduct.tmul A (b) (1)) := by
    intro b
    rw [IsScalarTower.algebraMap_apply B (TensorProduct A B B) (Localization.AtPrime q) b,
      Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  have hφ1 : ∀ b : B, φr (TensorProduct.tmul A (b) (1)) = IsLocalRing.residue B b := by
    intro b
    show φ (TensorProduct.tmul A (b) (1)) = _
    rw [hφ]
    simp only [map_one, mul_one]
  have hφ2 : ∀ b : B, φr (TensorProduct.tmul A (1) (b)) = g (IsLocalRing.residue B b) := by
    intro b
    show φ (TensorProduct.tmul A (1) (b)) = _
    rw [hφ]
    simp only [map_one, one_mul]
  haveI hloc1 : IsLocalHom (algebraMap B (Localization.AtPrime q)) := by
    refine ⟨fun b hb => ?_⟩
    rw [hj₁] at hb
    have hnq : TensorProduct.tmul A b (1 : B) ∉ q := fun hmem =>
      (IsLocalRing.notMem_maximalIdeal.mpr hb)
        ((IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q _).mpr hmem)
    have hne : φr (TensorProduct.tmul A (b) (1)) ≠ 0 := fun h => hnq (RingHom.mem_ker.mpr h)
    rw [hφ1] at hne
    exact (IsLocalRing.residue_ne_zero_iff_isUnit b).mp hne
  have hbij : Function.Bijective (algebraMap B (Localization.AtPrime q)) :=
    wc_olivier B (Localization.AtPrime q) inferInstance inferInstance hloc1 hWE
  let e : B ≃+* Localization.AtPrime q := RingEquiv.ofBijective _ hbij
  let j₂ : B →+* Localization.AtPrime q :=
    ι.comp (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A B B).toRingHom
  let α : B →+* B := e.symm.toRingHom.comp j₂
  have hK : ∀ b : B, algebraMap B (Localization.AtPrime q) (α b) = ι (TensorProduct.tmul A (1) (b)) := by
    intro b
    have h1 : algebraMap B (Localization.AtPrime q) (α b) = e (e.symm (j₂ b)) := rfl
    rw [h1, RingEquiv.apply_symm_apply]
    rfl
  have hαβ : α.comp β = β := by
    ext a
    show α (β a) = β a
    apply hbij.1
    rw [hK, hj₁]
    congr 1
    exact (Algebra.TensorProduct.tmul_one_eq_one_tmul (R := A) (A := B) (B := B) a).symm
  have hres : ∀ b, IsLocalRing.residue B (α b) = g (IsLocalRing.residue B b) := by
    intro b
    calc IsLocalRing.residue B (α b) = φr (TensorProduct.tmul A (α b) (1)) := (hφ1 _).symm
      _ = φq (ι (TensorProduct.tmul A (α b) (1))) := (hφq _).symm
      _ = φq (algebraMap B (Localization.AtPrime q) (α b)) := by rw [hj₁]
      _ = φq (ι (TensorProduct.tmul A (1) (b))) := by rw [hK]
      _ = φr (TensorProduct.tmul A (1) (b)) := hφq _
      _ = g (IsLocalRing.residue B b) := hφ2 b
  have hloc2 : IsLocalHom α := by
    refine ⟨fun b hb => ?_⟩
    have h1 := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hb
    rw [hres] at h1
    apply (IsLocalRing.residue_ne_zero_iff_isUnit b).mp
    intro h
    apply h1
    rw [h, map_zero]
  exact ⟨α, hαβ, hres, (wc_skc_rho_bijective A B β α hβ hαβ hloc2).1⟩

theorem wc_pfam_ltd_sepclosure_extend (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    [IsSepClosed L] (ι : B →+* L) (hι : @Algebra.WeaklyEtale B L _ _ ι.toAlgebra)
    (α : B →+* B) (hα : Function.Injective α) :
    Function.Injective ι ∧ ∃ σ : L →+* L, σ.comp ι = ι.comp α :=
by
  classical
  letI : Algebra B L := ι.toAlgebra
  haveI := hι

  have hinj : Function.Injective ι := by
    haveI : Module.Flat B L := Algebra.WeaklyEtale.flat
    rw [injective_iff_map_eq_zero]
    intro b hb
    by_contra hb0
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := L)
      (mem_nonZeroDivisors_of_ne_zero hb0)
    have h1 : b • (1 : L) = b • (0 : L) := by
      rw [smul_zero, Algebra.smul_def, mul_one]; exact hb
    exact one_ne_zero (hreg h1)

  have casimir : ∀ t : L, ∃ (n : ℕ) (u v : Fin n → L), ∑ i, u i * v i = 1 ∧
      ∑ i, u i ⊗ₜ[B] (t * v i) = ∑ i, (t * u i) ⊗ₜ[B] v i := by
    intro t
    have hμ : ∀ a c : L, Algebra.TensorProduct.lmul' B (a ⊗ₜ[B] c) = a * c :=
      fun a c => Algebra.TensorProduct.lmul'_apply_tmul a c
    letI : Algebra (TensorProduct B L L) L :=
      (Algebra.TensorProduct.lmul' B (S := L)).toRingHom.toAlgebra
    haveI : Module.Flat (TensorProduct B L L) L := Algebra.WeaklyEtale.flat_lmul' B L
    have hsmul : ∀ (x : TensorProduct B L L) (y : L),
        x • y = Algebra.TensorProduct.lmul' B x * y := fun x y => rfl
    let f : Fin 1 → TensorProduct B L L := fun _ => (1 : L) ⊗ₜ[B] t - t ⊗ₜ[B] (1 : L)
    obtain ⟨k, a, y, hx, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := TensorProduct B L L) (M := L) (f := f) (x := fun _ : Fin 1 => (1 : L)) (by
        rw [Fin.sum_univ_one]
        show Algebra.TensorProduct.lmul' B (f 0) * 1 = 0
        simp only [f, map_sub, hμ, one_mul, mul_one, sub_self])
    set e : TensorProduct B L L := ∑ j, a 0 j * (y j ⊗ₜ[B] (1 : L)) with he
    have hμe : Algebra.TensorProduct.lmul' B e = 1 := by
      have h0 : (1 : L) = ∑ j, Algebra.TensorProduct.lmul' B (a 0 j) * y j := hx 0
      rw [he, map_sum]
      simp only [map_mul, hμ, mul_one]
      exact h0.symm
    have hfe : ((1 : L) ⊗ₜ[B] t - t ⊗ₜ[B] (1 : L)) * e = 0 := by
      rw [he, Finset.mul_sum]
      apply Finset.sum_eq_zero
      intro j _
      have h0 := hrel j
      simp only [Fin.sum_univ_one, f] at h0
      rw [← mul_assoc, h0, zero_mul]
    obtain ⟨n, u, v, huv⟩ := TensorProduct.exists_sum_tmul_eq e
    refine ⟨n, u, v, ?_, ?_⟩
    · rw [← hμe, huv, map_sum]
      simp only [hμ]
    · rw [huv, sub_mul, Finset.mul_sum, Finset.mul_sum, sub_eq_zero] at hfe
      simpa only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one] using hfe

  have shift : ∀ (t : L) (n : ℕ) (u v : Fin n → L),
      ∑ i, u i ⊗ₜ[B] (t * v i) = ∑ i, (t * u i) ⊗ₜ[B] v i →
      ∀ (N : Type u) [AddCommGroup N] [Module L N] (Φ : L →+ N),
        (∀ (b : B) (x : L), Φ (ι b * x) = ι b • Φ x) →
        ∑ i, (t * v i) • Φ (u i) = ∑ i, v i • Φ (t * u i) := by
    intro t n u v h N _ _ Φ hΦ
    letI : Module B N := Module.compHom N ι
    let β : L →ₗ[B] L →ₗ[B] N := LinearMap.mk₂ B (fun x c => c • Φ x)
      (fun x₁ x₂ c => by simp only [map_add, smul_add])
      (fun b x c => by
        show c • Φ (ι b * x) = ι b • (c • Φ x)
        rw [hΦ, smul_smul, smul_smul, mul_comm])
      (fun x c₁ c₂ => by simp only [add_smul])
      (fun b x c => by
        show (ι b * c) • Φ x = ι b • (c • Φ x)
        rw [mul_smul])
    have h2 := congrArg (TensorProduct.lift β) h
    simpa only [map_sum, TensorProduct.lift.tmul, β, LinearMap.mk₂_apply] using h2

  obtain ⟨K, _, _, _⟩ : ∃ (K : Type u) (_ : Field K) (_ : Algebra B K), IsFractionRing B K :=
    ⟨FractionRing B, inferInstance, inferInstance, inferInstance⟩
  let ιK : K →+* L := IsFractionRing.lift hinj
  letI : Algebra K L := ιK.toAlgebra
  haveI : IsScalarTower B K L := IsScalarTower.of_algebraMap_eq
    (fun b => (IsFractionRing.lift_algebraMap (K := K) hinj b).symm)
  have hlin : ∀ (N : Type u) [AddCommGroup N] [Module L N] [Module K N] [IsScalarTower K L N]
      (Φ : L →ₗ[K] N) (b : B) (x : L), Φ (ι b * x) = ι b • Φ x := by
    intro N _ _ _ _ Φ b x
    have h1 : ι b * x = (algebraMap B K b) • x := by
      rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply]; rfl
    rw [h1, map_smul, ← algebraMap_smul L (algebraMap B K b) (Φ x),
      ← IsScalarTower.algebraMap_apply]
    rfl

  have nondeg : ∀ (E : Type u) [Field E] [Algebra E L] (n : ℕ) (u v : Fin n → L),
      ∑ i, u i * v i = 1 → ∃ φ : Module.Dual E L, ∑ i, φ (u i) • v i ≠ 0 := by
    intro E _ _ n u v h
    by_contra hcon
    push_neg at hcon
    let b := Module.Basis.ofVectorSpace E L
    let S := Finset.univ.biUnion (fun i => (b.repr (u i)).support)
    have hu : ∀ i, u i = ∑ β ∈ S, b.repr (u i) β • b β := by
      intro i
      conv_lhs => rw [← b.linearCombination_repr (u i)]
      rw [Finsupp.linearCombination_apply, Finsupp.sum]
      apply Finset.sum_subset
      · intro β hβ; exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hβ⟩
      · intro β _ hβ; rw [Finsupp.notMem_support_iff.mp hβ, zero_smul]
    have h10 : (1 : L) = 0 := by
      calc (1 : L) = ∑ i, u i * v i := h.symm
        _ = ∑ i, ∑ β ∈ S, (b.repr (u i) β • b β) * v i := by
          refine Finset.sum_congr rfl (fun i _ => ?_); rw [← Finset.sum_mul, ← hu i]
        _ = ∑ β ∈ S, b β * ∑ i, b.coord β (u i) • v i := by
          rw [Finset.sum_comm]; refine Finset.sum_congr rfl (fun β _ => ?_)
          rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Module.Basis.coord_apply, smul_mul_assoc, mul_smul_comm]
        _ = 0 := Finset.sum_eq_zero (fun β _ => by rw [hcon (b.coord β), mul_zero])
    exact one_ne_zero h10

  have integral : ∀ (t : L) (n : ℕ) (u v : Fin n → L),
      (∀ Φ : L →ₗ[K] L, ∑ i, (t * v i) * Φ (u i) = ∑ i, v i * Φ (t * u i)) →
      (∃ φ : Module.Dual K L, ∑ i, φ (u i) • v i ≠ 0) → IsIntegral K t := by
    intro t n u v hsh hnd
    let Γ : Module.Dual K L →ₗ[K] L :=
      { toFun := fun φ => ∑ i, φ (u i) • v i
        map_add' := fun φ ψ => by simp [add_smul, Finset.sum_add_distrib]
        map_smul' := fun c φ => by simp [Finset.smul_sum, smul_smul] }
    have hΓ : ∀ φ, Γ φ = ∑ i, φ (u i) • v i := fun φ => rfl
    have hNle : LinearMap.range Γ ≤ Submodule.span K (Set.range v) := by
      rintro _ ⟨φ, rfl⟩
      rw [hΓ]
      exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
    have hFG : (LinearMap.range Γ).FG := by
      haveI : FiniteDimensional K (Submodule.span K (Set.range v)) :=
        FiniteDimensional.span_of_finite K (Set.finite_range v)
      haveI : FiniteDimensional K (LinearMap.range Γ) := Submodule.finiteDimensional_of_le hNle
      exact Module.Finite.iff_fg.mp inferInstance
    have hN0 : LinearMap.range Γ ≠ ⊥ := by
      obtain ⟨φ, hφ⟩ := hnd
      intro hb
      apply hφ
      have hm : Γ φ ∈ LinearMap.range Γ := LinearMap.mem_range_self Γ φ
      rw [hb, Submodule.mem_bot] at hm
      exact hm
    refine isIntegral_of_smul_mem_submodule (LinearMap.range Γ) hN0 hFG t ?_
    rintro _ ⟨φ, rfl⟩
    refine ⟨φ ∘ₗ LinearMap.mulLeft K t, ?_⟩
    have h1 := hsh (Algebra.linearMap K L ∘ₗ φ)
    simp only [LinearMap.comp_apply, Algebra.linearMap_apply] at h1
    rw [hΓ, hΓ, smul_eq_mul]
    simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, Algebra.smul_def]
    calc ∑ i, algebraMap K L (φ (t * u i)) * v i
        = ∑ i, v i * algebraMap K L (φ (t * u i)) :=
          Finset.sum_congr rfl (fun i _ => mul_comm _ _)
      _ = ∑ i, (t * v i) * algebraMap K L (φ (u i)) := h1.symm
      _ = t * ∑ i, algebraMap K L (φ (u i)) * v i := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun i _ => by ring)

  have separable : ∀ (t : L) (n : ℕ) (u v : Fin n → L), IsIntegral K t →
      (∀ (Φ : L →ₗ[K] Polynomial L), ∑ i, (t * v i) • Φ (u i) = ∑ i, v i • Φ (t * u i)) →
      (∃ φ : Module.Dual (IntermediateField.adjoin K ({t} : Set L)) L,
        ∑ i, φ (u i) • v i ≠ 0) →
      IsSeparable K t := by
    intro t n u v ht hsh hnd
    obtain ⟨lam, hlam⟩ := hnd
    let g : IntermediateField.adjoin K ({t} : Set L) := IntermediateField.AdjoinSimple.gen K t
    have hg : algebraMap (IntermediateField.adjoin K ({t} : Set L)) L g = t :=
      IntermediateField.AdjoinSimple.algebraMap_gen K t
    let pb := IntermediateField.adjoin.powerBasis ht
    have hpb : pb.gen = g := IntermediateField.adjoin.powerBasis_gen ht
    let Q : IntermediateField.adjoin K ({t} : Set L) →ₗ[K] Polynomial K :=
      ∑ k : Fin pb.dim, (Polynomial.monomial (k : ℕ)) ∘ₗ pb.basis.coord k
    have hQ : ∀ y, Polynomial.aeval g (Q y) = y := by
      intro y
      rw [LinearMap.sum_apply, map_sum]
      conv_rhs => rw [← pb.basis.sum_repr y]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [LinearMap.comp_apply, Polynomial.aeval_monomial, Module.Basis.coord_apply,
        pb.basis_eq_pow, hpb, Algebra.smul_def]
    have hQt : ∀ y, Polynomial.aeval t (Q y) =
        algebraMap (IntermediateField.adjoin K ({t} : Set L)) L y := by
      intro y
      conv_rhs => rw [← hQ y]
      rw [← Polynomial.aeval_algebraMap_apply, hg]
    have hmg : minpoly K g = minpoly K t := IntermediateField.minpoly_gen K t
    have hgu : ∀ x : L, lam (t * x) = g * lam x := by
      intro x
      have h1 : t * x = g • x := by rw [Algebra.smul_def, hg]
      rw [h1, map_smul, smul_eq_mul]
    have hdvd : ∀ y, minpoly K t ∣ Q y * Polynomial.X - Q (g * y) := by
      intro y
      rw [← hmg]
      apply minpoly.dvd
      rw [map_sub, map_mul, hQ, hQ, Polynomial.aeval_X, mul_comm, sub_self]
    choose D hD using fun i => hdvd (lam (u i))
    let Φ : L →ₗ[K] Polynomial L :=
      { toFun := fun x => (Q (lam x)).map (algebraMap K L)
        map_add' := fun x y => by simp only [map_add, Polynomial.map_add]
        map_smul' := fun c x => by
          simp only [RingHom.id_apply]
          rw [LinearMap.map_smul_of_tower lam, map_smul, Polynomial.map_smul, algebraMap_smul] }
    have hs := hsh Φ
    set R : Polynomial L := ∑ i, (Q (lam (u i))).map (algebraMap K L) * Polynomial.C (v i)
      with hR
    set S : Polynomial L := ∑ i, (D i).map (algebraMap K L) * Polynomial.C (v i) with hS
    set mL : Polynomial L := (minpoly K t).map (algebraMap K L) with hmL
    have hs' : ∑ i, Polynomial.C (t * v i) * (Q (lam (u i))).map (algebraMap K L) =
        ∑ i, Polynomial.C (v i) * (Q (g * lam (u i))).map (algebraMap K L) := by
      have h1 : ∀ x, Φ x = (Q (lam x)).map (algebraMap K L) := fun x => rfl
      simp only [h1, Polynomial.smul_eq_C_mul, hgu] at hs
      exact hs
    have hD' : ∀ i, (Q (lam (u i))).map (algebraMap K L) * Polynomial.X -
        (Q (g * lam (u i))).map (algebraMap K L) = mL * (D i).map (algebraMap K L) := by
      intro i
      have h1 := congrArg (Polynomial.map (algebraMap K L)) (hD i)
      simpa only [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_X] using h1
    have hkey : (Polynomial.X - Polynomial.C t) * R = mL * S := by
      calc (Polynomial.X - Polynomial.C t) * R
          = ∑ i, ((((Q (lam (u i))).map (algebraMap K L) * Polynomial.X -
              (Q (g * lam (u i))).map (algebraMap K L)) * Polynomial.C (v i)) +
              (Polynomial.C (v i) * (Q (g * lam (u i))).map (algebraMap K L) -
                Polynomial.C (t * v i) * (Q (lam (u i))).map (algebraMap K L))) := by
            rw [hR, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Polynomial.C_mul]; ring
        _ = mL * S + (∑ i, Polynomial.C (v i) * (Q (g * lam (u i))).map (algebraMap K L) -
              ∑ i, Polynomial.C (t * v i) * (Q (lam (u i))).map (algebraMap K L)) := by
            rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, hS, Finset.mul_sum]
            congr 1
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [hD', mul_assoc]
        _ = mL * S := by rw [hs', sub_self, add_zero]
    have hroot : (Polynomial.X - Polynomial.C t) * (mL /ₘ (Polynomial.X - Polynomial.C t)) = mL := by
      rw [Polynomial.mul_divByMonic_eq_iff_isRoot, Polynomial.IsRoot, hmL,
        Polynomial.eval_map_algebraMap]
      exact minpoly.aeval K t
    set hq := mL /ₘ (Polynomial.X - Polynomial.C t) with hhq
    have hRh : R = hq * S := by
      apply mul_left_cancel₀ (Polynomial.X_sub_C_ne_zero t)
      rw [hkey, ← mul_assoc, hroot]
    have hRt : Polynomial.eval t R ≠ 0 := by
      have h1 : Polynomial.eval t R = ∑ i, lam (u i) • v i := by
        rw [hR, Polynomial.eval_finset_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_map_algebraMap, hQt,
          Algebra.smul_def]
      rw [h1]; exact hlam
    have hht : Polynomial.eval t hq ≠ 0 := by
      intro h0; apply hRt; rw [hRh, Polynomial.eval_mul, h0, zero_mul]
    have hder : Polynomial.eval t (Polynomial.derivative mL) ≠ 0 := by
      rw [← hroot, Polynomial.derivative_mul]
      simpa using hht
    have hder' : Polynomial.derivative (minpoly K t) ≠ 0 := by
      intro h0; apply hder
      rw [hmL, Polynomial.derivative_map, h0, Polynomial.map_zero, Polynomial.eval_zero]
    exact (Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible ht)).mpr hder'

  have hsepK : Algebra.IsSeparable K L := by
    refine ⟨fun t => ?_⟩
    obtain ⟨n, u, v, h1, h2⟩ := casimir t
    have hsh := shift t n u v h2
    have hsh' : ∀ (N : Type u) [AddCommGroup N] [Module L N] [Module K N] [IsScalarTower K L N]
        (Φ : L →ₗ[K] N), ∑ i, (t * v i) • Φ (u i) = ∑ i, v i • Φ (t * u i) :=
      fun N _ _ _ _ Φ => hsh N Φ.toAddMonoidHom (hlin N Φ)
    have ht : IsIntegral K t := integral t n u v
      (fun Φ => by simpa only [smul_eq_mul] using hsh' L Φ) (nondeg K n u v h1)
    exact separable t n u v ht (fun Φ => hsh' (Polynomial L) Φ) (nondeg _ n u v h1)

  have liftGen : ∀ (M : Type u) [Field M] [IsSepClosed M] (j : K →+* M),
      ∃ f : L →+* M, ∀ k : K, f (algebraMap K L k) = j k := by
    intro M _ _ j
    letI : Algebra K M := j.toAlgebra
    exact ⟨(IsSepClosed.lift : L →ₐ[K] M).toRingHom, fun k => (IsSepClosed.lift : L →ₐ[K] M).commutes k⟩
  have hj : Function.Injective ((algebraMap B K).comp α) :=
    (IsFractionRing.injective B K).comp hα
  let αK : K →+* K := IsFractionRing.lift hj
  obtain ⟨σ₀, hσ₀⟩ := liftGen L (ιK.comp αK)
  refine ⟨hinj, σ₀, ?_⟩
  ext b
  have h1 : σ₀ (algebraMap K L (algebraMap B K b)) = ιK (αK (algebraMap B K b)) :=
    hσ₀ _
  have e1 : ι b = algebraMap K L (algebraMap B K b) :=
    (IsFractionRing.lift_algebraMap (K := K) hinj b).symm
  have e2 : αK (algebraMap B K b) = algebraMap B K (α b) :=
    IsFractionRing.lift_algebraMap (K := K) hj b
  have e3 : ιK (algebraMap B K (α b)) = ι (α b) :=
    IsFractionRing.lift_algebraMap (K := K) hinj (α b)
  show σ₀ (ι b) = ι (α b)
  rw [e1, h1, e2, e3]

theorem wc_pfam_ltd_root_compare (B L : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] [Field L] (pc : ℕ)
    (hunit : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → IsUnit (m : B))
    (ι : B →+* L) (α : B →+* B) (σ σ' : L →+* L) (hσ : σ.comp ι = ι.comp α)
    (u e : B) (hu : IsUnit u) (he : IsUnit e) (hαe : α e = e) (k : ℕ)
    (hζ : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ ζ : B, ζ ^ m = 1 → α ζ = ζ ∧ σ' (ι ζ) = ι ζ)
    (hv : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∃ v : B, v ^ m = u ∧ α v = v ∧ σ' (ι v) = ι v)
    (c : ℕ → B)
    (hc : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → c m ^ m = 1 ∧
      (∀ w : L, w ^ m = ι e → σ' w = ι (c m) * w) ∧
      (∀ a : B, a ^ m = e → IsLocalRing.residue B (α a) = IsLocalRing.residue B (c m * a)))
    (hμ : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ z : L, z ^ m = 1 → ∃ ζ : B, ζ ^ m = 1 ∧ ι ζ = z) :
    ∀ (w : L) (m : ℕ), 0 < m → ¬ pc ∣ m → w ^ m = ι (u * e ^ k) → σ w = σ' w :=
by
  intro w m hm hpm hw
  have H1 : ∀ x : B, IsUnit x → ∃ b : B, b ^ m = x := by
    intro x hx
    have hmK : ((m : ℕ) : IsLocalRing.ResidueField B) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue B)]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr (hunit m hm hpm)
    haveI : NeZero ((m : ℕ) : IsLocalRing.ResidueField B) := ⟨hmK⟩
    obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue B x) m
    obtain ⟨b₀, hb₀⟩ := IsLocalRing.residue_surjective z
    have hxK : IsLocalRing.residue B x ≠ 0 := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hx
    have hb₀u : IsUnit b₀ := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hb₀]
      rintro rfl
      rw [zero_pow hm.ne'] at hz
      exact hxK hz.symm
    have hder : Polynomial.eval b₀ (Polynomial.derivative (Polynomial.X ^ m - Polynomial.C x))
        = (m : B) * b₀ ^ (m - 1) := by
      rw [Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
        Polynomial.derivative_X_pow]
      simp
    obtain ⟨b, hbr, -⟩ := HenselianLocalRing.is_henselian (Polynomial.X ^ m - Polynomial.C x)
      (Polynomial.monic_X_pow_sub_C x hm.ne') b₀ (by
        rw [← IsLocalRing.residue_eq_zero_iff]
        simp [hb₀, hz]) (by
        rw [hder]
        exact (hunit m hm hpm).mul (hb₀u.pow _))
    refine ⟨b, ?_⟩
    have h0 : Polynomial.eval b (Polynomial.X ^ m - Polynomial.C x) = 0 := hbr
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at h0
    exact sub_eq_zero.mp h0
  have H3 : ∀ ζ₁ ζ₂ : B, ζ₁ ^ m = 1 → ζ₂ ^ m = 1 →
      ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal B → ζ₁ = ζ₂ := by
    intro ζ₁ ζ₂ h1 h2 h12
    have hres : IsLocalRing.residue B ζ₁ = IsLocalRing.residue B ζ₂ := by
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact h12
    have hgeom := geom_sum₂_mul ζ₁ ζ₂ m
    rw [h1, h2, sub_self] at hgeom
    have hζ₂u : IsUnit ζ₂ := (isUnit_pow_iff hm.ne').mp (by rw [h2]; exact isUnit_one)
    have hSu : IsUnit (∑ i ∈ Finset.range m, ζ₁ ^ i * ζ₂ ^ (m - 1 - i)) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_sum]
      simp only [map_mul, map_pow, hres]
      rw [geom_sum₂_self, ← map_pow, ← map_natCast (IsLocalRing.residue B), ← map_mul,
        IsLocalRing.residue_ne_zero_iff_isUnit]
      exact (hunit m hm hpm).mul (hζ₂u.pow _)
    exact sub_eq_zero.mp (hSu.mul_right_eq_zero.mp hgeom)
  obtain ⟨b, hb⟩ := H1 e he
  obtain ⟨v, hvm, hαv, hσv⟩ := hv m hm hpm
  obtain ⟨hcm, hc2, hc3⟩ := hc m hm hpm
  have hbu : IsUnit b := (isUnit_pow_iff hm.ne').mp (by rw [hb]; exact he)
  obtain ⟨bi, hbi⟩ := hbu.exists_right_inv
  have ham : (v * b ^ k) ^ m = u * e ^ k := by
    rw [mul_pow, hvm, ← pow_mul, mul_comm k m, pow_mul, hb]
  have hau : IsUnit (v * b ^ k) :=
    (isUnit_pow_iff hm.ne').mp (by rw [ham]; exact hu.mul (he.pow k))
  obtain ⟨ai, hai⟩ := hau.exists_right_inv
  have hz : (w * ι ai) ^ m = 1 := by
    rw [mul_pow, hw, ← ham, ← (map_pow ι ai m), ← (map_mul ι), ← mul_pow, hai, one_pow,
      map_one]
  obtain ⟨ζ, hζm, hιζ⟩ := hμ m hm hpm _ hz
  have hwζ : w = ι (ζ * (v * b ^ k)) := by
    rw [map_mul ι ζ, hιζ, mul_assoc, ← (map_mul ι), mul_comm ai, hai, map_one, mul_one]
  obtain ⟨hαζ, hσζ⟩ := hζ m hm hpm ζ hζm
  have hr : (α b * bi) ^ m = 1 := by
    rw [mul_pow, ← (map_pow α b m), hb, hαe, ← hb, ← mul_pow, hbi, one_pow]
  have hres : IsLocalRing.residue B (α b * bi) = IsLocalRing.residue B (c m) := by
    rw [map_mul (IsLocalRing.residue B) (α b) bi, hc3 b hb,
      map_mul (IsLocalRing.residue B) (c m) b, mul_assoc,
      ← map_mul (IsLocalRing.residue B) b bi, hbi, map_one, mul_one]
  have hrc : α b * bi = c m := by
    apply H3 _ _ hr hcm
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hres, sub_self]
  have hαb : α b = c m * b := by
    calc α b = α b * (b * bi) := by rw [hbi, mul_one]
      _ = (α b * bi) * b := by ring
      _ = c m * b := by rw [hrc]
  have hσx : ∀ x, σ (ι x) = ι (α x) := fun x => by
    have := DFunLike.congr_fun hσ x
    simpa using this
  have hσb : σ' (ι b) = ι (c m) * ι b := hc2 _ (by rw [← map_pow, hb])
  have e1 : σ w = ι (c m) ^ k * w := by
    rw [hwζ, hσx]
    simp only [map_mul, map_pow, hαζ, hαv, hαb, mul_pow]
    ring
  have e2 : σ' w = ι (c m) ^ k * w := by
    rw [hwζ]
    simp only [map_mul, map_pow, hσζ, hσv, hσb, mul_pow]
    ring
  rw [e1, e2]

theorem wc_pfam_ltd_residue_separable (A B : Type u) [CommRing A] [CommRing B]
    [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (β : A →+* B) (hβ : @Algebra.WeaklyEtale A B _ _ β.toAlgebra) :
    ∀ x : IsLocalRing.ResidueField B, ∃ P : Polynomial A,
      (P.map ((IsLocalRing.residue B).comp β)).Separable ∧
      (P.map ((IsLocalRing.residue B).comp β)).eval x = 0 :=
by

  have s3 : ∀ (E K : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E] [Field K]
      (χ : E →+* K) (p : Ideal A) [p.IsPrime]
      (hp : p = Ideal.comap (algebraMap A E) (RingHom.ker χ)) (e : E),
      ∃ (ρ' : p.ResidueField →+* K) (μ : Polynomial p.ResidueField),
        ρ'.comp (algebraMap A p.ResidueField) = χ.comp (algebraMap A E) ∧
          (μ.map ρ').Separable ∧ (μ.map ρ').eval (χ e) = 0 := by
    intro E K _ _ _ _ χ p _ hp e
    set q := RingHom.ker χ with hq
    have : q.IsPrime := RingHom.ker_isPrime χ
    have : q.LiesOver p := (Ideal.liesOver_iff q p).mpr hp
    letI : Algebra (Localization.AtPrime p) (Localization.AtPrime q) :=
      Localization.AtPrime.algebraOfLiesOver p q
    have hsep : Algebra.IsSeparable p.ResidueField q.ResidueField :=
      ((Algebra.isUnramifiedAt_iff_map_eq A p q).mp inferInstance).1
    have hT1 : IsScalarTower A p.ResidueField q.ResidueField := inferInstance
    have hT2 : IsScalarTower A E q.ResidueField := inferInstance
    set y := algebraMap E q.ResidueField e with hy
    set μ := minpoly p.ResidueField y with hμ
    have hμs : μ.Separable := Algebra.IsSeparable.isSeparable p.ResidueField y
    have hμr : Polynomial.aeval y μ = 0 := minpoly.aeval _ _
    have h₂ : q.primeCompl ≤ Submonoid.comap χ (IsUnit.submonoid K) := by
      intro s hs
      have : χ s ≠ 0 := fun h => hs ((RingHom.mem_ker).mpr h)
      exact (IsUnit.mem_submonoid_iff _).mpr (isUnit_iff_ne_zero.mpr this)
    set ι := Ideal.ResidueField.lift q χ le_rfl h₂ with hι
    have hιe : ∀ s : E, ι (algebraMap E q.ResidueField s) = χ s :=
      Ideal.ResidueField.lift_algebraMap q χ le_rfl h₂
    refine ⟨ι.comp (algebraMap p.ResidueField q.ResidueField), μ, ?_, hμs.map, ?_⟩
    · apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply A E q.ResidueField, hιe]
    · rw [Polynomial.eval_map, ← hιe e, ← hy, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, hμr,
        map_zero]

  have s4 : ∀ (K : Type u) [Field K] (p : Ideal A) [p.IsPrime]
      (ρ' : p.ResidueField →+* K) (μ : Polynomial p.ResidueField) (x : K),
      (μ.map ρ').Separable → (μ.map ρ').eval x = 0 →
      ∃ P : Polynomial A, (P.map (ρ'.comp (algebraMap A p.ResidueField))).Separable ∧
        (P.map (ρ'.comp (algebraMap A p.ResidueField))).eval x = 0 := by
    intro K _ p _ ρ' μ x hsep hroot
    obtain ⟨b, hbmem, hb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors (A ⧸ p)) μ
    set Q := IsLocalization.integerNormalization (nonZeroDivisors (A ⧸ p)) μ with hQ
    obtain ⟨P, hP⟩ :=
      Polynomial.map_surjective (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective Q
    have hAk : algebraMap A p.ResidueField =
        (algebraMap (A ⧸ p) p.ResidueField).comp (Ideal.Quotient.mk p) := by
      rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
    have hQmap : Q.map (algebraMap (A ⧸ p) p.ResidueField) =
        Polynomial.C (algebraMap (A ⧸ p) p.ResidueField b) * μ := by
      rw [hb, Algebra.smul_def, Polynomial.algebraMap_apply]
    set c := ρ' (algebraMap (A ⧸ p) p.ResidueField b) with hc
    have hPm : P.map (ρ'.comp (algebraMap A p.ResidueField)) = Polynomial.C c * μ.map ρ' := by
      rw [hAk, ← Polynomial.map_map, ← Polynomial.map_map, hP, hQmap, Polynomial.map_mul,
        Polynomial.map_C]
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hbmem
    have hc0 : c ≠ 0 := by
      rw [hc]
      refine (map_ne_zero ρ').mpr ?_
      intro h
      apply hb0
      exact (IsFractionRing.injective (A ⧸ p) p.ResidueField) (h.trans (map_zero _).symm)
    refine ⟨P, ?_, ?_⟩
    · rw [hPm]
      exact hsep.unit_mul (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr hc0))
    · rw [hPm, Polynomial.eval_mul, Polynomial.eval_C, hroot, mul_zero]

  intro x
  obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective x
  obtain ⟨E, iE, aE, hE, π, e₁, hπ, he₁⟩ :=
    wc_lpkt_indetale_factor A B β hβ 1 (fun _ => b)
  set χ : E →+* IsLocalRing.ResidueField B := (IsLocalRing.residue B).comp π with hχ
  have hχe : χ (e₁ 0) = x := by
    show IsLocalRing.residue B (π (e₁ 0)) = x
    rw [he₁ 0, hb]
  have hχA : χ.comp (algebraMap A E) = (IsLocalRing.residue B).comp β := by
    rw [hχ, RingHom.comp_assoc, hπ]
  haveI : (RingHom.ker χ).IsPrime := RingHom.ker_isPrime χ
  obtain ⟨ρ', μ, hcomp, hsep, hroot⟩ :=
    s3 E (IsLocalRing.ResidueField B) χ (Ideal.comap (algebraMap A E) (RingHom.ker χ)) rfl (e₁ 0)
  obtain ⟨P, hP1, hP2⟩ := s4 (IsLocalRing.ResidueField B) _ ρ' μ (χ (e₁ 0)) hsep hroot
  rw [hcomp, hχA, hχe] at hP2
  rw [hcomp, hχA] at hP1
  exact ⟨P, hP1, hP2⟩

theorem wc_pfam_ltd_transversal (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (j : Fin D.m)
    (Vy Vx Ty : (wcProjK F'' M').ProEt) (uyx : Vx ⟶ Vy) (uy' : Ty ⟶ Vx)
    (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    [IsSepClosed (IsLocalRing.ResidueField Ay)] (ey : Vy.left ≅ Spec (.of Ay))
    (Ax : Type u) [CommRing Ax] [HenselianLocalRing Ax]
    [IsSepClosed (IsLocalRing.ResidueField Ax)] (ex : Vx.left ≅ Spec (.of Ax))
    (Ly : Type u) [Field Ly] [IsSepClosed Ly] (eLy : Ty.left ≅ Spec (.of Ly))
    (hy : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (t₀ : (wcP1Over F'').left) (ht₀ : closure {t₀} = Set.univ)
    (hx : Vx.hom (ex.inv (IsLocalRing.closedPoint Ax)) = lam t₀)
    (f : Ay) (hf : ∀ z : Vy.left, Vy.hom z ∈ Δ ↔ f ∈ (ey.hom z).asIdeal) :
    ∀ τ' : Ty ⟶ Ty, τ' ≫ uy' ≫ uyx = uy' ≫ uyx →
      ∃ (α : Vx ⟶ Vx) (τ'' : Ty ⟶ Ty), α ≫ uyx = uyx ∧ τ'' ≫ uy' = uy' ≫ α ∧
        wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy (uy' ≫ uyx).left) f
          (wcLtdRing eLy eLy τ''.left) (wcLtdRing eLy eLy τ'.left) :=
by
  intro τ' hτ'
  classical

  have hinjSpec : ∀ {R S : CommRingCat.{u}} (φ ψ : R ⟶ S), Spec.map φ = Spec.map ψ → φ = ψ := by
    intro R S φ ψ h
    rw [← Spec.preimage_map φ, ← Spec.preimage_map ψ, h]
  have W1 : ∀ {X Y Z : Scheme.{u}} {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
      (eX : X ≅ Spec (.of R)) (eY : Y ≅ Spec (.of S)) (eZ : Z ≅ Spec (.of T)) (g : Z ⟶ Y)
      (h : Y ⟶ X),
      wcLtdRing eX eZ (g ≫ h) = (wcLtdRing eY eZ g).comp (wcLtdRing eX eY h) := by
    intro X Y Z R S T _ _ _ eX eY eZ g h
    unfold wcLtdRing
    rw [← CommRingCat.hom_comp]
    congr 1
    apply hinjSpec
    simp only [Spec.map_comp, Spec.map_preimage, Category.assoc, Iso.hom_inv_id_assoc]
  have W2 : ∀ {X Y : Scheme.{u}} {R S : Type u} [CommRing R] [CommRing S]
      (eX : X ≅ Spec (.of R)) (eY : Y ≅ Spec (.of S)) (g g' : Y ⟶ X),
      wcLtdRing eX eY g = wcLtdRing eX eY g' → g = g' := by
    intro X Y R S _ _ eX eY g g' hgg
    have h1 : Spec.preimage (eY.inv ≫ g ≫ eX.hom) = Spec.preimage (eY.inv ≫ g' ≫ eX.hom) :=
      CommRingCat.hom_ext hgg
    have h2 := congrArg Spec.map h1
    simp only [Spec.map_preimage] at h2
    have h3 := congrArg (fun k => eY.hom ≫ k ≫ eX.inv) h2
    simpa using h3
  have W3 : ∀ {X Y : Scheme.{u}} {R S : Type u} [CommRing R] [CommRing S]
      (eX : X ≅ Spec (.of R)) (eY : Y ≅ Spec (.of S)) (φ : R →+* S),
      wcLtdRing eX eY (eY.hom ≫ Spec.map (CommRingCat.ofHom φ) ≫ eX.inv) = φ := by
    intro X Y R S _ _ eX eY φ
    unfold wcLtdRing
    simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id,
      Spec.preimage_map, CommRingCat.hom_ofHom]
  set β := wcLtdRing ey ex uyx.left with hβdef
  set ιx := wcLtdRing ex eLy uy'.left with hιxdef
  set σ' := wcLtdRing eLy eLy τ'.left with hσ'def
  have hιy : wcLtdRing ey eLy (uy' ≫ uyx).left = ιx.comp β := W1 ey ex eLy uy'.left uyx.left
  have hσ' : σ'.comp (ιx.comp β) = ιx.comp β := by
    rw [← hιy]
    have e1 : wcLtdRing ey eLy (τ' ≫ uy' ≫ uyx).left = wcLtdRing ey eLy (uy' ≫ uyx).left := by
      rw [hτ']
    have e2 : (τ' ≫ uy' ≫ uyx).left = τ'.left ≫ (uy' ≫ uyx).left := rfl
    rw [e2, W1 ey eLy eLy τ'.left (uy' ≫ uyx).left] at e1
    exact e1

  have hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨vy⟩ := wc_pfam_ltd_wt_geom_lift F'' M' hPP Vy Ay ey
  obtain ⟨-, -, hreg, -, -, -, -, -, -, hpA⟩ :=
    wc_tps_local_algebra F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy vy Ay ey hy
  obtain ⟨hdomA, hufdA⟩ := @wc_fco_regular_local_ufd Ay _ hreg
  haveI := hdomA
  haveI := hufdA
  haveI : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  haveI : WeaklyEtale Vx.hom := Vx.prop
  have hdomAx : IsDomain Ax :=
    wc_strictHensel_weaklyEtale_smooth_isDomain F'' (wcProjKStr F'' M') M'
      (CommRingCat.of Ax) (ex.inv ≫ Vx.hom) inferInstance
  haveI := hdomAx
  have hβ : @Algebra.WeaklyEtale Ay Ax _ _ β.toAlgebra :=
    wc_mnt_point_map_weaklyEtale (wcProjK F'' M') Vy Vx uyx Ay Ax ey ex
  have hιx : @Algebra.WeaklyEtale Ax Ly _ _ ιx.toAlgebra :=
    wc_mnt_point_map_weaklyEtale (wcProjK F'' M') Vx Ty uy' Ax Ly ex eLy

  set pc := ringChar F'' with hpcdef
  have hpc : pc.Prime := CharP.char_is_prime F'' pc
  have hunitR : ∀ (R : Type u) [CommRing R], (pc : R) = 0 →
      ∀ m : ℕ, 0 < m → ¬ pc ∣ m → IsUnit (m : R) := by
    intro R _ hR m _ hpm
    have hcop : Nat.Coprime pc m := (Nat.Prime.coprime_iff_not_dvd hpc).2 hpm
    have h1 := Nat.gcd_eq_gcd_ab pc m
    rw [hcop.gcd_eq_one] at h1
    have h2 := congrArg (Int.cast : ℤ → R) h1
    push_cast at h2
    rw [hR, zero_mul, zero_add] at h2
    exact isUnit_iff_exists_inv.2 ⟨_, h2.symm⟩
  have hunitA := hunitR Ay hpA
  have hpAx : (pc : Ax) = 0 := by rw [← map_natCast β, hpA, map_zero]
  have hunitAx := hunitR Ax hpAx
  have hpK : (pc : IsLocalRing.ResidueField Ax) = 0 := by
    rw [← map_natCast (IsLocalRing.residue Ax), hpAx, map_zero]

  obtain ⟨φy, hφΔ, hφm, hρφ, hval⟩ :=
    wc_pfam_ltd_line_dvr F' F'' Y n D M' Xu h Δ lam p hH j Vy Vx uyx Ay ey Ax ex hy t₀ ht₀ hx
  have hfφ : ∀ q : PrimeSpectrum Ay, f ∈ q.asIdeal ↔ φy ∈ q.asIdeal := by
    intro q
    have e1 := hf (ey.inv q)
    have e2 := hφΔ (ey.inv q)
    have e3 : ey.hom (ey.inv q) = q := by
      have := congrArg (fun k => k.base q) ey.inv_hom_id
      first | exact this | simpa using this
    rw [e3] at e1 e2
    exact e1.symm.trans e2
  have hker : ∀ a : Ay, ((IsLocalRing.residue Ax).comp β) a = 0 →
      a ∈ IsLocalRing.maximalIdeal Ay := by
    intro a ha
    have ha' : IsLocalRing.residue Ax (β a) = 0 := ha
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h2 : β a ∈ IsLocalRing.maximalIdeal Ax := (IsLocalRing.residue_eq_zero_iff _).1 ha'
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2
    exact h2 (hu.map β)
  obtain ⟨u, k, hfu⟩ := wc_pfam_ltd_ufd_power Ay (IsLocalRing.ResidueField Ax)
    ((IsLocalRing.residue Ax).comp β) f φy hfφ hφm hρφ hker hval

  have hφu : IsUnit (β φy) := by
    by_contra hn
    apply hρφ
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hn
  have hιyφ : (ιx.comp β) φy ≠ 0 := (hφu.map ιx).ne_zero

  have hμy : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ z : Ly, z ^ m = 1 →
      ∃ ζ : Ay, ζ ^ m = 1 ∧ (ιx.comp β) ζ = z :=
    fun m hm hpm => wc_pfam_ltd_mu_transport Ay Ly (ιx.comp β) m hm (hunitA m hm hpm)
  obtain ⟨c, hc, hcc⟩ :=
    wc_pfam_ltd_kummer_char Ay Ly pc hunitA (ιx.comp β) σ' hσ' φy hιyφ hμy

  have hμK : ∀ m : ℕ, 0 < m → ¬ pc ∣ m → ∀ z : IsLocalRing.ResidueField Ax, z ^ m = 1 →
      ∃ a : Ay, ((IsLocalRing.residue Ax).comp β) a = z := by
    intro m hm hpm z hz
    obtain ⟨ζ, -, hζ⟩ := wc_pfam_ltd_mu_transport Ay _ ((IsLocalRing.residue Ax).comp β) m hm
      (hunitA m hm hpm) z hz
    exact ⟨ζ, hζ⟩
  have hsep := wc_pfam_ltd_residue_separable Ay Ax β hβ
  have hnu : ¬ ∃ v : Ay, ((IsLocalRing.residue Ax).comp β) (φy * v) = 1 := by
    rintro ⟨v, hv⟩
    have h1 : φy * v - 1 ∈ IsLocalRing.maximalIdeal Ay :=
      hker _ (by rw [map_sub, hv, map_one, sub_self])
    have h2 : φy * v ∈ IsLocalRing.maximalIdeal Ay := Ideal.mul_mem_right _ _ hφm
    have h3 : (1 : Ay) ∈ IsLocalRing.maximalIdeal Ay := by
      have := Ideal.sub_mem _ h2 h1
      simpa using this
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h3
    exact h3 isUnit_one
  obtain ⟨g, hgρ, hgt⟩ := wc_pfam_ltd_residue_kummer Ay (IsLocalRing.ResidueField Ax) pc hpc hpK
    ((IsLocalRing.residue Ax).comp β) φy hρφ hnu hval hsep hμK c
    (fun m hm hpm => by rw [← map_pow, (hc m hm hpm).1, map_one])
    (fun m d hm hd hpm => by rw [← map_pow, hcc m d hm hd hpm])

  obtain ⟨αs, hαβ, hαres, hαinj⟩ := wc_pfam_ltd_hensel_aut_lift Ay Ax β hβ g hgρ
  obtain ⟨hιinj, σ, hσ⟩ := wc_pfam_ltd_sepclosure_extend Ax Ly ιx hιx αs hαinj
  have hαe : ∀ a : Ay, αs (β a) = β a := fun a => DFunLike.congr_fun hαβ a
  have hσ'y : ∀ a : Ay, σ' (ιx (β a)) = ιx (β a) := fun a => DFunLike.congr_fun hσ' a

  have hmain := wc_pfam_ltd_root_compare Ax Ly pc hunitAx ιx αs σ σ' hσ (β u) (β φy)
    ((Units.isUnit u).map β) hφu (hαe φy) k
    (fun m hm hpm ζ hζ => by
      obtain ⟨ζ', _, hζ'2⟩ := hμy m hm hpm (ιx ζ) (by rw [← map_pow, hζ, map_one])
      have h' : ιx (β ζ') = ιx ζ := hζ'2
      have hb : β ζ' = ζ := hιinj h'
      rw [← hb]
      exact ⟨hαe ζ', hσ'y ζ'⟩)
    (fun m hm hpm => by
      obtain ⟨v0, hv0⟩ := (wc_skc_hensel_roots Ay m (hunitA m hm hpm)).1 u
      exact ⟨β v0, by rw [← map_pow, hv0], hαe v0, hσ'y v0⟩)
    (fun m => β (c m))
    (fun m hm hpm => by
      refine ⟨by rw [← map_pow, (hc m hm hpm).1, map_one],
        fun w hw => (hc m hm hpm).2 w hw, fun a ha => ?_⟩
      rw [hαres, map_mul]
      have ht : (IsLocalRing.residue Ax a) ^ m = ((IsLocalRing.residue Ax).comp β) φy := by
        rw [← map_pow, ha]; rfl
      exact hgt m hm hpm _ ht)
    (fun m hm hpm z hz => by
      obtain ⟨ζ', hζ'1, hζ'2⟩ := hμy m hm hpm z hz
      exact ⟨β ζ', by rw [← map_pow, hζ'1, map_one], hζ'2⟩)

  set Aα : Vx.left ⟶ Vx.left := ex.hom ≫ Spec.map (CommRingCat.ofHom αs) ≫ ex.inv with hAα
  set Aτ : Ty.left ⟶ Ty.left := eLy.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eLy.inv with hAτ
  have hAαu : Aα ≫ uyx.left = uyx.left := by
    apply W2 ey ex
    rw [W1 ey ex ex Aα uyx.left, hAα, W3 ex ex αs]
    exact hαβ
  have hAτu : Aτ ≫ uy'.left = uy'.left ≫ Aα := by
    apply W2 ex eLy
    rw [W1 ex eLy eLy Aτ uy'.left, W1 ex ex eLy uy'.left Aα, hAτ, hAα, W3 eLy eLy σ,
      W3 ex ex αs]
    exact hσ
  have hAαw : Aα ≫ Vx.hom = Vx.hom := by
    rw [← MorphismProperty.Over.w uyx, ← Category.assoc, hAαu]
  have hAτw : Aτ ≫ Ty.hom = Ty.hom := by
    rw [← MorphismProperty.Over.w uy', ← Category.assoc, hAτu, Category.assoc, hAαw]
  let α : Vx ⟶ Vx := MorphismProperty.Over.homMk Aα hAαw trivial
  let τ'' : Ty ⟶ Ty := MorphismProperty.Over.homMk Aτ hAτw trivial
  refine ⟨α, τ'', ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact hAαu
  · apply MorphismProperty.Over.Hom.ext
    exact hAτu
  · have hτl : wcLtdRing eLy eLy τ''.left = σ := W3 eLy eLy σ
    rw [hτl, hιy]
    intro w m hm hpm hw
    apply hmain w m hm hpm
    rw [hw, hfu]
    simp [map_mul, map_pow]

theorem wc_pfam_ltd_wt_xi_generic (F'' : Type u) [Field F''] [Finite F''] (M' : ℕ)
    (Δ : Set (wcProjK F'' M')) (hΔc : IsClosed Δ)
    (hirr : IsIrreducible (⇑(wcLdpProjMap F'' (AlgebraicClosure F'') M') ⁻¹' Δ))
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Vy : (wcProjK F'' M').ProEt)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (Ay : Type u) [CommRing Ay] [IsLocalRing Ay] (ey : Vy.left ≅ Spec (.of Ay))
    (hyΔ : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) ∈ Δ)
    (f : Ay) (hf : ∀ z : Vy.left, Vy.hom z ∈ Δ ↔ f ∈ (ey.hom z).asIdeal)
    (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [IsLocalRing B]
    (eZ : Z.left ≅ Spec (.of B)) (ιZ : Z ⟶ Vy)
    (hξgen : ∀ q : PrimeSpectrum Ay, f ∈ q.asIdeal →
      (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal ≤ q.asIdeal) :
    ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ιZ ≫ vy).left (eZ.inv (IsLocalRing.closedPoint B))} :=
by
  classical
  intro y hy
  have hpb := wc_ldnm_di_projmap_pb F'' (AlgebraicClosure F'') M'

  have hcl' : IsClosed (⇑(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ) :=
    hΔc.preimage (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom.continuous

  have hirr' : IsIrreducible
      (⇑(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ) := by
    let c := hpb.isoPullback
    have hc : ∀ x, (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (c.hom x) =
        wcLdpProjMap F'' (AlgebraicClosure F'') M' x := by
      intro x
      have h1 := hpb.isoPullback_hom_fst
      rw [← h1, Scheme.Hom.comp_apply]
      rfl
    have himg : ⇑(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ =
        c.hom '' (⇑(wcLdpProjMap F'' (AlgebraicClosure F'') M') ⁻¹' Δ) := by
      ext w
      constructor
      · intro hw
        obtain ⟨x, rfl⟩ : ∃ x, c.hom x = w := ⟨c.inv w, Scheme.inv_hom_apply c w⟩
        refine ⟨x, ?_, rfl⟩
        show wcLdpProjMap F'' (AlgebraicClosure F'') M' x ∈ Δ
        rw [← hc]
        exact hw
      · rintro ⟨x, hx, rfl⟩
        show (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (c.hom x) ∈ Δ
        rw [hc]
        exact hx
    rw [himg]
    exact hirr.image _ c.hom.continuous.continuousOn
  have hη := hirr'.isGenericPoint_genericPoint hcl'
  have hηsp := isGenericPoint_iff_specializes.mp hη
  have hw : vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Vy.hom :=
    MorphismProperty.Over.w vy
  have hwa : ∀ a, (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (vy.left a) =
      Vy.hom a := by
    intro a
    rw [← hw, Scheme.Hom.comp_apply]

  have hηy : hirr'.genericPoint ⤳ vy.left (ey.inv (IsLocalRing.closedPoint Ay)) := by
    rw [hηsp]
    show (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (vy.left (ey.inv (IsLocalRing.closedPoint Ay))) ∈ Δ
    rw [hwa]
    exact hyΔ

  haveI : WeaklyEtale (vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [hw]; exact Vy.prop
  haveI : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  haveI : WeaklyEtale vy.left :=
    WeaklyEtale.of_comp vy.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  have hgen : GeneralizingMap ⇑vy.left := Flat.generalizingMap vy.left
  obtain ⟨z, -, hz⟩ := hgen hηy

  have hzΔ : Vy.hom z ∈ Δ := by
    rw [← hwa, hz]
    exact hη.mem
  have hfz := (hf z).mp hzΔ
  have hq := hξgen (ey.hom z) hfz
  have hsp1 : ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B))) ⤳ ey.hom z :=
    (PrimeSpectrum.le_iff_specializes _ _).mp ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp hq)
  have hsp2 := hsp1.map ey.inv.continuous
  rw [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at hsp2
  have hsp3 := hsp2.map vy.left.continuous
  rw [hz] at hsp3
  have hξ : (ιZ ≫ vy).left (eZ.inv (IsLocalRing.closedPoint B)) =
      vy.left (ιZ.left (eZ.inv (IsLocalRing.closedPoint B))) := by
    first
      | (show (ιZ.left ≫ vy.left) (eZ.inv (IsLocalRing.closedPoint B)) = _
         rw [Scheme.Hom.comp_apply])
      | rfl
      | simp only [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply]
  rw [← specializes_iff_mem_closure, hξ]
  exact hsp3.trans ((hηsp y).mpr hy)

theorem wc_pfam_ltd_wt_point_alg (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    (β : B →+* L) (hβ : @Algebra.WeaklyEtale B L _ _ β.toAlgebra) :
    Function.Injective β ∧
    ∀ x : L, ∃ P : Polynomial B, (P.map β).Separable ∧ Polynomial.eval₂ β x P = 0 :=
by
  classical
  letI : Algebra B L := β.toAlgebra
  haveI : Module.Flat B L := hβ.flat
  have hinj : Function.Injective β := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    by_contra hb0
    have hreg : IsSMulRegular L b :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hb0)
    have h1 : b • (1 : L) = b • (0 : L) := by
      rw [smul_zero, Algebra.smul_def, mul_one]
      exact hb
    exact one_ne_zero (hreg h1)
  refine ⟨hinj, ?_⟩
  let γ : FractionRing B →+* L := IsFractionRing.lift hinj
  letI : Algebra (FractionRing B) L := γ.toAlgebra
  have hγ : ∀ b : B, γ (algebraMap B (FractionRing B) b) = β b := fun b =>
    IsFractionRing.lift_algebraMap hinj b
  haveI : IsScalarTower B (FractionRing B) L :=
    IsScalarTower.of_algebraMap_eq (fun b => (hγ b).symm)
  obtain ⟨hWE, hAlg⟩ := wc_mnt_fraction_field_weaklyEtale_algebraic B L hβ
  haveI : Algebra.IsSeparable (FractionRing B) L :=
    wc_mnt_weaklyEtale_field_isSeparable (FractionRing B) L hWE hAlg
  intro x
  have hqs : (minpoly (FractionRing B) x).Separable :=
    Algebra.IsSeparable.isSeparable (FractionRing B) x
  have hqa : Polynomial.aeval x (minpoly (FractionRing B) x) = 0 := minpoly.aeval _ x
  obtain ⟨b, hbM, hP⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors B)
    (minpoly (FractionRing B) x)
  refine ⟨IsLocalization.integerNormalization (nonZeroDivisors B) (minpoly (FractionRing B) x),
    ?_, ?_⟩
  · have hcomp : γ.comp (algebraMap B (FractionRing B)) = β := RingHom.ext hγ
    rw [← hcomp, ← Polynomial.map_map, hP,
      ← algebraMap_smul (FractionRing B) b (minpoly (FractionRing B) x),
      Polynomial.smul_eq_C_mul, Polynomial.map_mul, Polynomial.map_C]
    apply Polynomial.Separable.unit_mul
    · apply Polynomial.isUnit_C.mpr
      apply IsUnit.mk0
      rw [hγ]
      intro h0
      exact nonZeroDivisors.ne_zero hbM (hinj (h0.trans (map_zero β).symm))
    · exact hqs.map
  · have h := IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors B)
      (minpoly (FractionRing B) x) hqa
    rw [Polynomial.aeval_def] at h
    exact h

theorem wc_pfam_ltd_wt_unif_roots (B : Type u) [CommRing B] [IsDomain B]
    [IsDiscreteValuationRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (L : Type u) [Field L] (p : ℕ) (hp : p.Prime) (hpL : (p : L) = 0)
    (β : B →+* L) (hβ : Function.Injective β) (σ : L →+* L) (hσB : ∀ b, σ (β b) = β b)
    (fB : B) (hf0 : fB ≠ 0) (hfm : fB ∈ IsLocalRing.maximalIdeal B)
    (htame : ∀ (w : L) (m : ℕ), 0 < m → ¬ p ∣ m → w ^ m = β fB → σ w = w)
    (π : B) (hπ : Irreducible π) :
    ∀ (w : L) (m : ℕ), 0 < m → ¬ p ∣ m → w ^ m = β π → σ w = w :=
by
  intro w m hm hpm hw
  classical
  have hpB : (p : B) = 0 := hβ (by rw [map_natCast, hpL, map_zero])
  obtain ⟨n, u, hfu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hf0 hπ
  have hn0 : n ≠ 0 := by
    rintro rfl
    rw [pow_zero, mul_one] at hfu
    exact (IsLocalRing.mem_maximalIdeal _).mp hfm (hfu ▸ u.isUnit)
  obtain ⟨e, n', hn', hn⟩ := Nat.exists_eq_pow_mul_and_not_dvd hn0 p hp.ne_one
  have hn'0 : n' ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hn
    exact hn0 hn
  obtain ⟨N, hNdef⟩ : ∃ N, N = m * n' := ⟨_, rfl⟩
  have hN0 : 0 < N := hNdef ▸ Nat.mul_pos hm (Nat.pos_of_ne_zero hn'0)
  have hpN : ¬ p ∣ N := by
    rw [hNdef, hp.dvd_mul]
    push_neg
    exact ⟨hpm, hn'⟩
  have hNu : IsUnit (N : B) := by
    have hcop : Nat.Coprime p N := (hp.coprime_iff_not_dvd).mpr hpN
    have h1 := Nat.gcd_eq_gcd_ab p N
    rw [Nat.Coprime.gcd_eq_one hcop] at h1
    have h2 := congrArg (Int.cast : ℤ → B) h1
    push_cast at h2
    rw [hpB, zero_mul, zero_add] at h2
    exact ⟨⟨(N : B), _, h2.symm, by rw [mul_comm]; exact h2.symm⟩, rfl⟩
  have hensel : ∃ v : B, v ^ N = (u : B) := by
    have hNk : ((N : ℕ) : IsLocalRing.ResidueField B) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue B)]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hNu
    haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField B) := ⟨hNk⟩
    have hu0 : IsLocalRing.residue B (u : B) ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr u.isUnit
    obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue B (u : B)) N
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective z
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hN0.ne'] at hz
      exact hu0 hz.symm
    have ha₀u : IsUnit a₀ := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (ha₀ ▸ hz0)
    have hmon : (Polynomial.X ^ N - Polynomial.C (u : B)).Monic :=
      Polynomial.monic_X_pow_sub_C _ hN0.ne'
    have hev : (Polynomial.X ^ N - Polynomial.C (u : B)).eval a₀ ∈
        IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp [ha₀, hz]
    have hder : IsUnit ((Polynomial.derivative
        (Polynomial.X ^ N - Polynomial.C (u : B))).eval a₀) := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow,
        Polynomial.derivative_C, sub_zero, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X]
      exact hNu.mul (ha₀u.pow _)
    obtain ⟨v, hv, -⟩ := HenselianLocalRing.is_henselian _ hmon a₀ hev hder
    refine ⟨v, ?_⟩
    have hv' := hv.eq_zero
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at hv'
    exact sub_eq_zero.mp hv'
  obtain ⟨v, hv⟩ := hensel
  have hexp : p ^ e * N = m * n := by rw [hNdef, hn]; ring
  have hy : (β v * w ^ (p ^ e)) ^ N = β fB := by
    rw [mul_pow, ← pow_mul, ← map_pow, hv, hfu, map_mul, map_pow, ← hw, ← pow_mul, hexp]
  have hσy := htame _ N hN0 hpN hy
  rw [map_mul, map_pow, hσB] at hσy
  have hv0 : β v ≠ 0 := by
    intro h0
    have : v = 0 := hβ (h0.trans (map_zero β).symm)
    rw [this, zero_pow hN0.ne'] at hv
    exact u.ne_zero hv.symm
  have hpow := mul_left_cancel₀ hv0 hσy
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : CharP L p := (CharP.charP_iff_prime_eq_zero hp).mpr hpL
  have h3 : (σ w - w) ^ (p ^ e) = 0 := by rw [sub_pow_char_pow, hpow, sub_self]
  exact sub_eq_zero.mp ((pow_eq_zero_iff (pow_ne_zero e hp.ne_zero)).mp h3)

theorem wc_wto_layer_valuation (B : Type u) [CommRing B] [IsDomain B]
    [IsDiscreteValuationRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (L : Type u) [Field L] (p : ℕ) (hp : p.Prime) (hpL : (p : L) = 0)
    (β : B →+* L) (hβ : Function.Injective β)
    (hsep : ∀ x : L, ∃ P : Polynomial B, (P.map β).Separable ∧ Polynomial.eval₂ β x P = 0)
    (π : B) (hπ : Irreducible π) (T : Finset L) (N : Subfield L)
    (hBN : ∀ b, β b ∈ N) (hNT : N ≤ Subfield.closure (Set.range β ∪ ↑T)) :
    ∃ ϖ ∈ N, ϖ ≠ 0 ∧
      (∀ c ∈ N, c ≠ 0 → ∃ k : ℤ, ∀ m : ℕ, 0 < m → ¬ p ∣ m →
         ∃ r ∈ N, r ^ m * ϖ ^ k = c) ∧
      ∃ E : ℕ, 0 < E ∧ ∀ m : ℕ, 0 < m → ¬ p ∣ m → ∃ r ∈ N, r ^ m * ϖ ^ E = β π :=
by
  classical

  have s1 : ∃ (_ : Algebra B N) (_ : Algebra (FractionRing B) N),
      IsScalarTower B (FractionRing B) N ∧ FiniteDimensional (FractionRing B) N ∧
      Algebra.IsSeparable (FractionRing B) N ∧ ∀ b : B, ((algebraMap B N b : N) : L) = β b := by
    let j : FractionRing B →+* L := IsFractionRing.lift hβ
    have hj : ∀ b : B, j (algebraMap B (FractionRing B) b) = β b :=
      fun b => IsFractionRing.lift_algebraMap hβ b
    have hjc : j.comp (algebraMap B (FractionRing B)) = β := RingHom.ext hj
    have hjN : ∀ z : FractionRing B, j z ∈ N := by
      intro z
      obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective B z
      rw [map_div₀, hj, hj]
      exact N.div_mem (hBN a) (hBN b)
    letI algB : Algebra B N := (β.codRestrict N hBN).toAlgebra
    letI algK : Algebra (FractionRing B) N := (j.codRestrict N hjN).toAlgebra
    have hB : ∀ b : B, ((algebraMap B N b : N) : L) = β b := fun b => rfl
    have hK : ∀ z : FractionRing B, ((algebraMap (FractionRing B) N z : N) : L) = j z :=
      fun z => rfl
    have htow : IsScalarTower B (FractionRing B) N := IsScalarTower.of_algebraMap_eq (fun b => by
      apply Subtype.ext
      rw [hB, hK, hj])
    letI algKL : Algebra (FractionRing B) L := j.toAlgebra
    have hKL : ∀ z : FractionRing B, algebraMap (FractionRing B) L z = j z := fun z => rfl
    set M := IntermediateField.adjoin (FractionRing B) (↑T : Set L) with hM
    have hTsep : ∀ t ∈ (↑T : Set L), IsSeparable (FractionRing B) t := by
      intro t _
      obtain ⟨P, hPs, hPe⟩ := hsep t
      set PK := P.map (algebraMap B (FractionRing B))
      have hmap : PK.map j = P.map β := by
        rw [Polynomial.map_map, hjc]
      have hPKs : PK.Separable := (Polynomial.separable_map j).mp (by rw [hmap]; exact hPs)
      have hev : Polynomial.aeval t PK = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have : (algebraMap (FractionRing B) L).comp (algebraMap B (FractionRing B)) = β := hjc
        rw [this]
        exact hPe
      exact hPKs.of_dvd (minpoly.dvd (FractionRing B) t hev)
    have hTint : ∀ t ∈ (↑T : Set L), IsIntegral (FractionRing B) t :=
      fun t ht => (hTsep t ht).isIntegral
    haveI hMfd : FiniteDimensional (FractionRing B) M :=
      IntermediateField.finiteDimensional_adjoin hTint
    haveI hMsep : Algebra.IsSeparable (FractionRing B) M :=
      (IntermediateField.isSeparable_adjoin_iff_isSeparable (FractionRing B) L).mpr hTsep
    have hclM : Subfield.closure (Set.range β ∪ ↑T) ≤ M.toSubfield := by
      rw [Subfield.closure_le]
      rintro x (⟨b, rfl⟩ | hx)
      · rw [← hj, ← hKL]
        exact M.algebraMap_mem _
      · exact IntermediateField.subset_adjoin (FractionRing B) _ hx
    have hNM : ∀ x : N, (x : L) ∈ M := fun x => hclM (hNT x.2)
    let f : N →ₐ[FractionRing B] M :=
      { toFun := fun x => ⟨x, hNM x⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl
        commutes' := fun z => by
          apply Subtype.ext
          show j z = algebraMap (FractionRing B) L z
          rfl }
    have hf : Function.Injective f := fun x y h => by
      apply Subtype.ext
      have := congrArg (fun z : M => (z : L)) h
      exact this
    haveI : FiniteDimensional (FractionRing B) N := FiniteDimensional.of_injective f.toLinearMap hf
    haveI : Algebra.IsSeparable (FractionRing B) N := Algebra.IsSeparable.of_algHom _ M f
    exact ⟨algB, algK, htow, inferInstance, inferInstance, hB⟩

  have s2 : ∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra B C], Module.Finite B C →
      IsLocalRing C ∧ ∀ m : ℕ, IsUnit (m : C) → ∀ u : Cˣ, ∃ v : C, v ^ m = u := by
    intro C _ _ _ hfin
    obtain ⟨n, e, hidem, -, hsum, hloc⟩ := wc_strictHensel_finite_idem_decomp B C hfin
    have hs : ∑ i, e i ≠ 0 := by rw [hsum]; exact one_ne_zero
    obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hs
    have hi1 : e i = 1 := ((IsIdempotentElem.iff_eq_zero_or_one).mp (hidem i)).resolve_left hi
    obtain ⟨hH, hsc, -⟩ := hloc i
    have hu : IsUnit (e i) := by rw [hi1]; exact isUnit_one
    let φ : C ≃ₐ[C] Localization.Away (e i) := IsLocalization.atUnit C _ (e i) hu
    have hlocC : IsLocalRing C :=
      IsLocalRing.of_surjective' (φ.symm : Localization.Away (e i) →+* C) φ.symm.surjective
    refine ⟨hlocC, fun m hm u => ?_⟩
    have hmS : IsUnit (m : Localization.Away (e i)) := by
      have := hm.map φ
      rwa [map_natCast] at this
    obtain ⟨v, hv⟩ := (wc_skc_hensel_roots (Localization.Away (e i)) m hmS).1 (Units.map φ u)
    refine ⟨φ.symm v, ?_⟩
    rw [← map_pow, hv]
    simp

  have s3 : ∀ (N' : Type u) [Field N'] [Algebra B N'] [Algebra (FractionRing B) N']
      [IsScalarTower B (FractionRing B) N'] [FiniteDimensional (FractionRing B) N']
      [Algebra.IsSeparable (FractionRing B) N'],
      Module.Finite B (integralClosure B N') ∧
        (IsLocalRing (integralClosure B N') → IsDiscreteValuationRing (integralClosure B N')) := by
    intro N' _ _ _ _ _ _
    refine ⟨IsIntegralClosure.finite B (FractionRing B) N' (integralClosure B N'), fun hloc => ?_⟩
    haveI := IsIntegralClosure.isDedekindDomain B (FractionRing B) N' (integralClosure B N')
    haveI := IsIntegralClosure.isNoetherianRing B (FractionRing B) N' (integralClosure B N')
    have hinj : Function.Injective (algebraMap B (integralClosure B N')) := by
      have h1 : Function.Injective (algebraMap B N') := by
        rw [IsScalarTower.algebraMap_eq B (FractionRing B) N']
        exact (algebraMap (FractionRing B) N').injective.comp (IsFractionRing.injective B _)
      rw [IsScalarTower.algebraMap_eq B (integralClosure B N') N', RingHom.coe_comp] at h1
      exact Function.Injective.of_comp h1
    haveI : FaithfulSMul B (integralClosure B N') :=
      (faithfulSMul_iff_algebraMap_injective B (integralClosure B N')).mpr hinj
    haveI := Algebra.IsIntegral.isLocalHom B (integralClosure B N')
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible B
    have hnf : ¬ IsField (integralClosure B N') := by
      intro hf
      have hx0 : algebraMap B (integralClosure B N') ϖ ≠ 0 := fun h =>
        hϖ.ne_zero (hinj (by rw [h, map_zero]))
      obtain ⟨y, hy⟩ := hf.mul_inv_cancel hx0
      exact hϖ.not_isUnit (isUnit_of_map_unit _ _ (IsUnit.of_mul_eq_one y hy))
    exact ((IsDiscreteValuationRing.TFAE (integralClosure B N') hnf).out 1 3).mpr ‹_›

  have s4 : ∀ (C : Type u) [CommRing C] [IsDomain C] [IsDiscreteValuationRing C]
      (N' : Type u) [Field N'] [Algebra C N'] [IsFractionRing C N'], (p : C) = 0 →
      (∀ m : ℕ, IsUnit (m : C) → ∀ u : Cˣ, ∃ v : C, v ^ m = u) →
      ∃ ϖ : C, Irreducible ϖ ∧
        (∀ c : N', c ≠ 0 → ∃ k : ℤ, ∀ m : ℕ, 0 < m → ¬ p ∣ m →
            ∃ r : C, (algebraMap C N' r) ^ m * (algebraMap C N' ϖ) ^ k = c) ∧
        ∀ x : C, x ≠ 0 → ¬ IsUnit x → ∃ E : ℕ, 0 < E ∧ ∀ m : ℕ, 0 < m → ¬ p ∣ m →
            ∃ r : C, r ^ m * ϖ ^ E = x := by
    intro C _ _ _ N' _ _ _ hpC hroot
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible C
    have hu : ∀ m : ℕ, ¬ p ∣ m → IsUnit (m : C) := by
      intro m hpm
      obtain ⟨a, b, hab⟩ := Nat.Coprime.isCoprime ((Nat.Prime.coprime_iff_not_dvd hp).mpr hpm)
      have h1 : ((a * (p : ℤ) + b * (m : ℤ) : ℤ) : C) = 1 := by rw [hab]; simp
      push_cast at h1
      rw [hpC, mul_zero, zero_add] at h1
      exact IsUnit.of_mul_eq_one (b : C) (by rw [mul_comm]; exact h1)
    have hinj := IsFractionRing.injective C N'
    have hϖ0 : algebraMap C N' ϖ ≠ 0 := fun h => hϖ.ne_zero (hinj (by rw [h, map_zero]))
    refine ⟨ϖ, hϖ, ?_, ?_⟩
    · intro c hc
      obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective C c
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [map_zero, zero_div] at hab
        exact hc hab.symm
      obtain ⟨i, u, hau⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hϖ
      obtain ⟨j, v, hbv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
      refine ⟨(i : ℤ) - j, fun m hm hpm => ?_⟩
      obtain ⟨r, hr⟩ := hroot m (hu m hpm) (u * v⁻¹)
      refine ⟨r, ?_⟩
      have hv0 : algebraMap C N' (v : C) ≠ 0 := fun h =>
        v.ne_zero (hinj (by rw [h, map_zero]))
      have hpow : algebraMap C N' ϖ ^ j ≠ 0 := pow_ne_zero _ hϖ0
      rw [← map_pow, hr, ← hab, hau, hbv, zpow_sub₀ hϖ0, zpow_natCast, zpow_natCast]
      simp only [Units.val_mul, map_mul, map_pow, map_units_inv]
      rw [eq_div_iff (mul_ne_zero hv0 hpow)]
      field_simp
    · intro x hx hxu
      obtain ⟨E, u, hxu'⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx hϖ
      have hE : 0 < E := by
        rcases Nat.eq_zero_or_pos E with h | h
        · exfalso; apply hxu; rw [hxu', h, pow_zero, mul_one]; exact u.isUnit
        · exact h
      refine ⟨E, hE, fun m hm hpm => ?_⟩
      obtain ⟨r, hr⟩ := hroot m (hu m hpm) u
      exact ⟨r, by rw [hr, hxu']⟩

  obtain ⟨algB, algK, htow, hfd, hsepN, hcompat⟩ := s1
  obtain ⟨hfin, hdvr⟩ := s3 N
  obtain ⟨hloc, hroot⟩ := s2 (integralClosure B N) hfin
  haveI := hdvr hloc
  haveI : IsFractionRing (integralClosure B N) N :=
    integralClosure.isFractionRing_of_finite_extension (FractionRing B) N
  let ι : integralClosure B N →+* L := N.subtype.comp (algebraMap (integralClosure B N) N)
  have hι : Function.Injective ι :=
    Subtype.val_injective.comp (IsFractionRing.injective (integralClosure B N) N)
  have hιB : ∀ b : B, ι (algebraMap B (integralClosure B N) b) = β b := by
    intro b
    show ((algebraMap (integralClosure B N) N (algebraMap B (integralClosure B N) b) : N) : L) = β b
    rw [← IsScalarTower.algebraMap_apply]
    exact hcompat b
  have hpC : (p : integralClosure B N) = 0 := hι (by rw [map_natCast, map_zero]; exact hpL)
  obtain ⟨ϖC, hϖirr, hdec, hnon⟩ := s4 (integralClosure B N) N hpC hroot
  refine ⟨ι ϖC, (algebraMap (integralClosure B N) N ϖC).2, ?_, ?_, ?_⟩
  · intro h
    exact hϖirr.ne_zero (hι (by rw [h, map_zero]))
  · intro c hc hc0
    have hc0' : (⟨c, hc⟩ : N) ≠ 0 := fun h => hc0 (congrArg Subtype.val h)
    obtain ⟨k, hk⟩ := hdec ⟨c, hc⟩ hc0'
    refine ⟨k, fun m hm hpm => ?_⟩
    obtain ⟨r, hr⟩ := hk m hm hpm
    refine ⟨ι r, (algebraMap (integralClosure B N) N r).2, ?_⟩
    have h2 := congrArg N.subtype hr
    rw [map_mul, map_pow, map_zpow₀] at h2
    exact h2
  · have hinjBC : Function.Injective (algebraMap B (integralClosure B N)) := by
      intro a b h
      apply hβ
      rw [← hιB, ← hιB, h]
    haveI : FaithfulSMul B (integralClosure B N) :=
      (faithfulSMul_iff_algebraMap_injective B (integralClosure B N)).mpr hinjBC
    haveI := Algebra.IsIntegral.isLocalHom B (integralClosure B N)
    have hx0 : algebraMap B (integralClosure B N) π ≠ 0 := fun h =>
      hπ.ne_zero (hinjBC (by rw [h, map_zero]))
    have hxu : ¬ IsUnit (algebraMap B (integralClosure B N) π) := fun h =>
      hπ.not_isUnit (isUnit_of_map_unit _ _ h)
    obtain ⟨E, hE, hEm⟩ := hnon _ hx0 hxu
    refine ⟨E, hE, fun m hm hpm => ?_⟩
    obtain ⟨r, hr⟩ := hEm m hm hpm
    refine ⟨ι r, (algebraMap (integralClosure B N) N r).2, ?_⟩
    rw [← map_pow, ← map_pow, ← map_mul, hr, hιB]

theorem wc_pfam_ltd_wt_tame_order (B : Type u) [CommRing B] [IsDomain B]
    [IsDiscreteValuationRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (L : Type u) [Field L] [IsSepClosed L] (p : ℕ) (hp : p.Prime) (hpL : (p : L) = 0)
    (β : B →+* L) (hβ : Function.Injective β)
    (hsep : ∀ x : L, ∃ P : Polynomial B, (P.map β).Separable ∧ Polynomial.eval₂ β x P = 0)
    (π : B) (hπ : Irreducible π) (σ : L →+* L) (hσB : ∀ b, σ (β b) = β b)
    (htame : ∀ (w : L) (m : ℕ), 0 < m → ¬ p ∣ m → w ^ m = β π → σ w = w) :
    ∀ S : Finset L, ∃ b : ℕ, ∀ x ∈ S, (⇑σ)^[p ^ b] x = x :=
by
  classical
  haveI hchar : CharP L p := (CharP.charP_iff_prime_eq_zero hp).mpr hpL
  have hβπ0 : β π ≠ 0 := by
    intro h
    apply hπ.ne_zero
    apply hβ
    rw [h, map_zero]

  have s1 : ∀ (τ : L →+* L), (∀ b, τ (β b) = β b) → ∀ (x : L) (P : Polynomial B),
      P.map β ≠ 0 → Polynomial.eval₂ β x P = 0 → ∃ o : ℕ, 0 < o ∧ (⇑τ)^[o] x = x := by
    intro τ hτ x P hP hx
    have hτβ : τ.comp β = β := RingHom.ext hτ
    have hroot : ∀ t : L, Polynomial.eval₂ β t P = 0 → Polynomial.eval₂ β (τ t) P = 0 := by
      intro t ht
      have h := Polynomial.hom_eval₂ P β τ t
      rw [ht, map_zero, hτβ] at h
      exact h.symm
    have hit : ∀ k : ℕ, Polynomial.eval₂ β ((⇑τ)^[k] x) P = 0 := by
      intro k
      induction k with
      | zero => rw [Function.iterate_zero_apply]; exact hx
      | succ k ih => rw [Function.iterate_succ_apply']; exact hroot _ ih
    have hmem : ∀ k : ℕ, (⇑τ)^[k] x ∈ (P.map β).roots.toFinset := by
      intro k
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP, Polynomial.IsRoot.def,
        Polynomial.eval_map]
      exact hit k
    obtain ⟨i, j, hij, heq⟩ := Finite.exists_ne_map_eq_of_infinite
      (fun k : ℕ => (⟨(⇑τ)^[k] x, hmem k⟩ : (P.map β).roots.toFinset))
    have heq' : (⇑τ)^[i] x = (⇑τ)^[j] x := congrArg Subtype.val heq
    have hinj : ∀ n : ℕ, Function.Injective ((⇑τ)^[n]) := fun n => τ.injective.iterate n
    rcases lt_or_gt_of_ne hij with h | h
    · refine ⟨j - i, by omega, ?_⟩
      apply hinj i
      rw [← Function.iterate_add_apply, Nat.add_sub_cancel' h.le]
      exact heq'.symm
    · refine ⟨i - j, by omega, ?_⟩
      apply hinj j
      rw [← Function.iterate_add_apply, Nat.add_sub_cancel' h.le]
      exact heq'

  have s2 : ∀ (ρ : L →+* L) (ℓ : ℕ), ℓ.Prime → (ℓ : L) ≠ 0 → ∀ ζ : L, IsPrimitiveRoot ζ ℓ →
      ρ ζ = ζ → ∀ x : L, (⇑ρ)^[ℓ] x = x → ρ x ≠ x →
      ∃ i : ℕ, 0 < i ∧ i < ℓ ∧
        (∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x) ≠ 0 ∧
        ζ ^ i * ρ (∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x) =
          ∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x := by
    intro ρ ℓ hℓ hℓL ζ hζ hρζ x hxℓ hx
    have ha : ∀ i : ℕ, ζ ^ i * ρ (∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x) =
        ∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x := by
      intro i
      have e1 : ζ ^ i * ρ (∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x) =
          ∑ j ∈ Finset.range ℓ, ζ ^ (i * (j + 1)) * (⇑ρ)^[j + 1] x := by
        rw [map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, map_pow, hρζ, Function.iterate_succ_apply', mul_add, mul_one, pow_add]
        ring
      have e2 := Finset.sum_range_succ' (fun j => ζ ^ (i * j) * (⇑ρ)^[j] x) ℓ
      have e3 := Finset.sum_range_succ (fun j => ζ ^ (i * j) * (⇑ρ)^[j] x) ℓ
      have e4 : ζ ^ (i * ℓ) * (⇑ρ)^[ℓ] x = ζ ^ (i * 0) * (⇑ρ)^[0] x := by
        rw [hxℓ, mul_comm i ℓ, pow_mul, hζ.pow_eq_one, one_pow, mul_zero, pow_zero,
          Function.iterate_zero_apply]
      beta_reduce at e2 e3
      rw [e1]
      linear_combination e3 - e2 + e4
    have hb : ∑ i ∈ Finset.range ℓ, (∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x) =
        (ℓ : L) * x := by
      rw [Finset.sum_comm]
      have hinner : ∀ j ∈ Finset.range ℓ, ∑ i ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x =
          if j = 0 then (ℓ : L) * x else 0 := by
        intro j hj
        rw [← Finset.sum_mul]
        split_ifs with h0
        · subst h0
          simp
        · have hq : ζ ^ j ≠ 1 := hζ.pow_ne_one_of_pos_of_lt h0 (Finset.mem_range.mp hj)
          have hq1 : (ζ ^ j) ^ ℓ = 1 := by
            rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
          have hgs : ∑ i ∈ Finset.range ℓ, ζ ^ (i * j) = 0 := by
            have e : ∑ i ∈ Finset.range ℓ, ζ ^ (i * j) =
                ∑ i ∈ Finset.range ℓ, (ζ ^ j) ^ i := by
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [← pow_mul, mul_comm]
            rw [e]
            have hm := geom_sum_mul (ζ ^ j) ℓ
            rw [hq1, sub_self] at hm
            exact (mul_eq_zero.mp hm).resolve_right (sub_ne_zero.mpr hq)
          rw [hgs, zero_mul]
      rw [Finset.sum_congr rfl hinner]
      simp [hℓ.pos]
    by_contra hcon
    have hzero : ∀ i ∈ Finset.range ℓ, i ≠ 0 →
        (∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x) = 0 := by
      intro i hi h0
      by_contra hne
      exact hcon ⟨i, Nat.pos_of_ne_zero h0, Finset.mem_range.mp hi, hne, ha i⟩
    have hy0 : (∑ j ∈ Finset.range ℓ, ζ ^ (0 * j) * (⇑ρ)^[j] x) = (ℓ : L) * x := by
      rw [← hb]
      symm
      apply Finset.sum_eq_single 0
      · intro i hi h0
        exact hzero i hi h0
      · intro h
        exact absurd (Finset.mem_range.mpr hℓ.pos) h
    have hρy0 := ha 0
    rw [pow_zero, one_mul, hy0, map_mul, map_natCast] at hρy0
    exact hx (mul_left_cancel₀ hℓL hρy0)

  have s4 : ∀ (ρ : L →+* L) (ℓ : ℕ), ℓ.Prime → ℓ ≠ p → (ℓ : L) ≠ 0 → ∀ ζ : L,
      IsPrimitiveRoot ζ ℓ → ρ ζ = ζ → ∀ y : L, y ≠ 0 → ∀ i : ℕ, 0 < i → i < ℓ →
      ζ ^ i * ρ y = y → ∀ ϖ : L, ϖ ≠ 0 → ρ ϖ = ϖ → ∀ r : L, ρ r = r → ∀ k : ℤ,
      r ^ ℓ * ϖ ^ k = y ^ ℓ → ∀ E : ℕ, 0 < E →
      (∀ m : ℕ, 0 < m → ¬ p ∣ m → ∃ r' : L, ρ r' = r' ∧ r' ^ m * ϖ ^ E = β π) →
      (∀ (w : L) (m : ℕ), 0 < m → ¬ p ∣ m → w ^ m = β π → ρ w = w) → False := by
    intro ρ ℓ hℓ hℓp hℓL ζ hζ hρζ y hy i hi0 hiℓ hyρ ϖ hϖ hρϖ r hρr k hyk E hE hπE htameρ
    haveI : NeZero (ℓ : L) := ⟨hℓL⟩
    haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
    have hpℓ : ¬ p ∣ ℓ := fun h => hℓp ((Nat.prime_dvd_prime_iff_eq hp hℓ).mp h).symm
    obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq ϖ ℓ
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero] at hz
      exact hϖ hz.symm
    obtain ⟨a, e₁, he₁, hEa⟩ := Nat.exists_eq_pow_mul_and_not_dvd hE.ne' p hp.one_lt.ne'
    have he₁0 : 0 < e₁ := by
      rcases Nat.eq_zero_or_pos e₁ with h | h
      · rw [h, mul_zero] at hEa
        omega
      · exact h
    have hm0 : 0 < ℓ * e₁ := Nat.mul_pos hℓ.pos he₁0
    have hmp : ¬ p ∣ ℓ * e₁ := fun h => (hp.dvd_mul.mp h).elim hpℓ he₁
    obtain ⟨r', hρr', hr'⟩ := hπE (ℓ * e₁) hm0 hmp
    have hzE : (z ^ (p ^ a)) ^ (ℓ * e₁) = ϖ ^ E := by
      rw [← pow_mul, show p ^ a * (ℓ * e₁) = ℓ * E by rw [hEa]; ring, pow_mul, hz]
    have hw : (r' * z ^ (p ^ a)) ^ (ℓ * e₁) = β π := by
      rw [mul_pow, hzE, hr']
    have hρw := htameρ _ _ hm0 hmp hw
    rw [map_mul, map_pow, hρr'] at hρw
    have hr'0 : r' ≠ 0 := by
      rintro rfl
      rw [zero_pow (by omega), zero_mul] at hr'
      exact hβπ0 hr'.symm
    have hpa : (ρ z) ^ (p ^ a) = z ^ (p ^ a) := mul_left_cancel₀ hr'0 hρw
    have hρzℓ : (ρ z) ^ ℓ = ϖ := by rw [← map_pow, hz, hρϖ]
    have hωℓ : (ρ z * z⁻¹) ^ ℓ = 1 := by
      rw [mul_pow, inv_pow, hρzℓ, hz, mul_inv_cancel₀ hϖ]
    have hωp : (ρ z * z⁻¹) ^ (p ^ a) = 1 := by
      rw [mul_pow, inv_pow, hpa, mul_inv_cancel₀ (pow_ne_zero _ hz0)]
    have hcop : Nat.gcd ℓ (p ^ a) = 1 :=
      Nat.Coprime.pow_right a ((Nat.coprime_primes hℓ hp).mpr hℓp)
    have hω1 : ρ z * z⁻¹ = 1 := by
      have h := pow_gcd_eq_one.mpr ⟨hωℓ, hωp⟩
      rwa [hcop, pow_one] at h
    have hρz : ρ z = z := (mul_inv_eq_one₀ hz0).mp hω1
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero, zero_mul] at hyk
      exact hy ((pow_eq_zero_iff hℓ.ne_zero).mp hyk.symm)
    have hd0 : r * z ^ k ≠ 0 := mul_ne_zero hr0 (zpow_ne_zero k hz0)
    have hρd : ρ (r * z ^ k) = r * z ^ k := by rw [map_mul, map_zpow₀, hρr, hρz]
    have hzk : (z ^ k) ^ ℓ = ϖ ^ k := by
      rw [← hz, ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, mul_comm]
    have hdℓ : (r * z ^ k) ^ ℓ = y ^ ℓ := by rw [mul_pow, hzk, hyk]
    have hq : (y / (r * z ^ k)) ^ ℓ = 1 := by
      rw [div_pow, ← hdℓ, div_self (pow_ne_zero _ hd0)]
    obtain ⟨j, -, hj⟩ := hζ.eq_pow_of_pow_eq_one hq
    have hρq : ρ (y / (r * z ^ k)) = y / (r * z ^ k) := by rw [← hj, map_pow, hρζ]
    rw [map_div₀, hρd] at hρq
    have hρy : ρ y = y := (div_left_inj' hd0).mp hρq
    rw [hρy] at hyρ
    have hζi : ζ ^ i = 1 := mul_right_cancel₀ hy (hyρ.trans (one_mul y).symm)
    exact hζ.pow_ne_one_of_pos_of_lt hi0.ne' hiℓ hζi

  have s5 : ∀ x : L, ∃ a : ℕ, (⇑σ)^[p ^ a] x = x := by
    intro x
    obtain ⟨P, hPsep, hPx⟩ := hsep x
    obtain ⟨o, ho, hox⟩ := s1 σ hσB x P hPsep.ne_zero hPx
    have hper : Function.IsPeriodicPt (⇑σ) o x := hox
    obtain ⟨d, hd⟩ : ∃ d, d = Function.minimalPeriod (⇑σ) x := ⟨_, rfl⟩
    have hd0 : 0 < d := by rw [hd]; exact Function.IsPeriodicPt.minimalPeriod_pos ho hper
    have hdx : (⇑σ)^[d] x = x := by rw [hd]; exact Function.isPeriodicPt_minimalPeriod (⇑σ) x
    obtain ⟨a, n, hn, hdan⟩ := Nat.exists_eq_pow_mul_and_not_dvd hd0.ne' p hp.one_lt.ne'
    by_cases hn1 : n = 1
    · refine ⟨a, ?_⟩
      rw [hdan, hn1, mul_one] at hdx
      exact hdx
    exfalso
    have hn0 : n ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hdan
      omega
    obtain ⟨ℓ, hℓdef⟩ : ∃ ℓ, ℓ = n.minFac := ⟨_, rfl⟩
    have hℓ : ℓ.Prime := by rw [hℓdef]; exact Nat.minFac_prime hn1
    have hℓn : ℓ ∣ n := by rw [hℓdef]; exact Nat.minFac_dvd n
    have hℓp : ℓ ≠ p := by
      intro h
      apply hn
      rw [← h]
      exact hℓn
    obtain ⟨n', hn'⟩ := hℓn
    have hn'0 : 0 < n' := by
      rcases Nat.eq_zero_or_pos n' with h | h
      · rw [h, mul_zero] at hn'
        exact absurd hn' hn0
      · exact h
    obtain ⟨e, he⟩ : ∃ e, e = p ^ a * n' := ⟨_, rfl⟩
    have hpa : 0 < p ^ a := pow_pos hp.pos a
    have hedl : e * ℓ = d := by rw [he, hdan, hn']; ring
    have he0 : 0 < e := by rw [he]; exact Nat.mul_pos hpa hn'0
    have hed : e < d := by
      rw [← hedl]
      exact lt_mul_of_one_lt_right he0 hℓ.one_lt
    obtain ⟨ρ, hρdef⟩ : ∃ ρ : L →+* L, ρ = σ ^ e := ⟨_, rfl⟩
    have hρcoe : (⇑ρ) = (⇑σ)^[e] := by rw [hρdef, RingHom.coe_pow]
    have hρx : (⇑ρ)^[ℓ] x = x := by
      rw [hρcoe, ← Function.iterate_mul, hedl]
      exact hdx
    have hρx' : ρ x ≠ x := by
      intro h
      apply Function.not_isPeriodicPt_of_pos_of_lt_minimalPeriod he0.ne'
        (by rw [← hd]; exact hed)
      show (⇑σ)^[e] x = x
      rw [← hρcoe]
      exact h
    have hρB : ∀ b, ρ (β b) = β b := fun b => by
      rw [hρcoe]
      exact Function.iterate_fixed (hσB b) e
    have hρtame : ∀ (w : L) (m : ℕ), 0 < m → ¬ p ∣ m → w ^ m = β π → ρ w = w := by
      intro w m hm hpm hw
      rw [hρcoe]
      exact Function.iterate_fixed (htame w m hm hpm hw) e
    have hpℓ : ¬ p ∣ ℓ := fun h => hℓp ((Nat.prime_dvd_prime_iff_eq hp hℓ).mp h).symm
    have hℓL : (ℓ : L) ≠ 0 := by
      rw [Ne, CharP.cast_eq_zero_iff L p]
      exact hpℓ
    haveI : NeZero (ℓ : L) := ⟨hℓL⟩
    haveI : HasEnoughRootsOfUnity L ℓ := IsSepClosed.hasEnoughRootsOfUnity L ℓ
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L ℓ
    have hρζ : ρ ζ = ζ := by
      obtain ⟨w₀, hw₀⟩ := IsSepClosed.exists_pow_nat_eq (β π) ℓ
      have hw₀0 : w₀ ≠ 0 := by
        rintro rfl
        rw [zero_pow hℓ.ne_zero] at hw₀
        exact hβπ0 hw₀.symm
      have h1 := hρtame w₀ ℓ hℓ.pos hpℓ hw₀
      have h2 := hρtame (ζ * w₀) ℓ hℓ.pos hpℓ (by rw [mul_pow, hζ.pow_eq_one, one_mul, hw₀])
      rw [map_mul, h1] at h2
      exact mul_right_cancel₀ hw₀0 h2
    obtain ⟨i, hi0, hiℓ, hy0, hyρ⟩ := s2 ρ ℓ hℓ hℓL ζ hζ hρζ x hρx hρx'
    obtain ⟨y, hy⟩ : ∃ y, y = ∑ j ∈ Finset.range ℓ, ζ ^ (i * j) * (⇑ρ)^[j] x := ⟨_, rfl⟩
    rw [← hy] at hy0 hyρ
    obtain ⟨T, hT⟩ : ∃ T : Finset L, T = (Finset.range ℓ).image (fun j => (⇑ρ)^[j] x) ∪ {ζ} :=
      ⟨_, rfl⟩
    obtain ⟨N, hN⟩ : ∃ N : Subfield L,
        N = Subfield.closure (Set.range β ∪ ↑T) ⊓ ρ.eqLocusField (RingHom.id L) := ⟨_, rfl⟩
    have hmemN : ∀ c, c ∈ N ↔ c ∈ Subfield.closure (Set.range β ∪ ↑T) ∧ ρ c = c := by
      intro c
      rw [hN, Subfield.mem_inf, RingHom.mem_eqLocusField, RingHom.id_apply]
    have hBN : ∀ b, β b ∈ N := fun b => (hmemN _).mpr
      ⟨Subfield.subset_closure (Or.inl ⟨b, rfl⟩), hρB b⟩
    have hTM : ∀ t ∈ T, t ∈ Subfield.closure (Set.range β ∪ ↑T) :=
      fun t ht => Subfield.subset_closure (Or.inr ht)
    have hζM : ζ ∈ Subfield.closure (Set.range β ∪ ↑T) := by
      apply hTM
      rw [hT]
      exact Finset.mem_union_right _ (Finset.mem_singleton_self ζ)
    have hyM : y ∈ Subfield.closure (Set.range β ∪ ↑T) := by
      rw [hy]
      refine Subfield.sum_mem _ (fun j hj => ?_)
      refine mul_mem (pow_mem hζM _) (hTM _ ?_)
      rw [hT]
      exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ hj)
    have hcN : y ^ ℓ ∈ N := by
      refine (hmemN _).mpr ⟨pow_mem hyM ℓ, ?_⟩
      have h1 : (ζ ^ i * ρ y) ^ ℓ = y ^ ℓ := by rw [hyρ]
      rw [mul_pow, ← pow_mul, mul_comm i ℓ, pow_mul, hζ.pow_eq_one, one_pow, one_mul] at h1
      rw [map_pow]
      exact h1
    have hNT : N ≤ Subfield.closure (Set.range β ∪ ↑T) := by
      rw [hN]
      exact inf_le_left
    obtain ⟨ϖ, hϖN, hϖ0, hdec, E, hE, hβπE⟩ :=
      wc_wto_layer_valuation B L p hp hpL β hβ hsep π hπ T N hBN hNT
    obtain ⟨k, hk⟩ := hdec (y ^ ℓ) hcN (pow_ne_zero _ hy0)
    obtain ⟨r, hrN, hr⟩ := hk ℓ hℓ.pos hpℓ
    exact s4 ρ ℓ hℓ hℓp hℓL ζ hζ hρζ y hy0 i hi0 hiℓ hyρ ϖ hϖ0 ((hmemN _).mp hϖN).2 r
      ((hmemN _).mp hrN).2 k hr E hE
      (fun m hm hpm => by
        obtain ⟨r', hr'N, hr'⟩ := hβπE m hm hpm
        exact ⟨r', ((hmemN _).mp hr'N).2, hr'⟩) hρtame

  intro S
  choose a ha using s5
  refine ⟨S.sup a, fun x hx => ?_⟩
  have hle : a x ≤ S.sup a := Finset.le_sup hx
  have hpow : p ^ S.sup a = p ^ a x * p ^ (S.sup a - a x) := by
    rw [← pow_add, Nat.add_sub_cancel' hle]
  rw [hpow]
  exact Function.IsPeriodicPt.mul_const (ha x) _

theorem wc_pfam_ltd_wt_point_transfer (P : Scheme.{u}) (Z Ty E : P.ProEt)
    (B : Type u) [CommRing B] (eZ : Z.left ≅ Spec (.of B))
    (Ly : Type u) [Field Ly] (eLy : Ty.left ≅ Spec (.of Ly))
    (uZ : Ty ⟶ Z) (τ : Ty ⟶ Ty) (hτ : τ ≫ uZ = uZ)
    (πE : E ⟶ Z) (eE : Ty ⟶ E) (hEt : Etale πE.left) (heE : eE ≫ πE = uZ) (N : ℕ)
    (H : ∀ S : Finset Ly, ∃ k : ℕ, ∀ x ∈ S,
      (⇑(wcLtdRing eLy eLy τ.left))^[N ^ k] x = x) :
    ∃ k : ℕ, (fun g : Ty ⟶ E => τ ≫ g)^[N ^ k] eE = eE :=
by
  classical
  unfold wcLtdRing at H
  have hcl : ∀ {X Y W : P.ProEt} (f : X ⟶ Y) (g : Y ⟶ W), (f ≫ g).left = f.left ≫ g.left :=
    fun _ _ => rfl
  have hil : ∀ (X : P.ProEt), (𝟙 X : X ⟶ X).left = 𝟙 X.left := fun _ => rfl

  have s1 : ∀ m : ℕ, (fun g : Ty ⟶ E => τ ≫ g)^[m] eE =
        ((fun g : Ty ⟶ Ty => τ ≫ g)^[m] (𝟙 Ty)) ≫ eE ∧
      eLy.inv ≫ ((fun g : Ty ⟶ Ty => τ ≫ g)^[m] (𝟙 Ty)).left ≫ eLy.hom =
        Spec.map (CommRingCat.ofHom ((Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom)).hom ^ m)) := by
    intro m
    induction m with
    | zero =>
      refine ⟨by simp, ?_⟩
      simp only [Function.iterate_zero, id_eq, pow_zero]
      rw [hil, Category.id_comp, Iso.inv_hom_id, RingHom.one_def,
        CommRingCat.ofHom_id, Spec.map_id]
    | succ m ih =>
      obtain ⟨ih1, ih2⟩ := ih
      refine ⟨?_, ?_⟩
      · rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih1, Category.assoc]
      · rw [Function.iterate_succ_apply', hcl]
        have e1 : eLy.inv ≫ (τ.left ≫ ((fun g : Ty ⟶ Ty => τ ≫ g)^[m] (𝟙 Ty)).left) ≫ eLy.hom
            = (eLy.inv ≫ τ.left ≫ eLy.hom) ≫
              (eLy.inv ≫ ((fun g : Ty ⟶ Ty => τ ≫ g)^[m] (𝟙 Ty)).left ≫ eLy.hom) := by
          simp only [Category.assoc, Iso.hom_inv_id_assoc]
        rw [e1, ih2]
        set σ := (Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom)).hom with hσ
        have hm : eLy.inv ≫ τ.left ≫ eLy.hom = Spec.map (CommRingCat.ofHom σ) := by
          rw [hσ, CommRingCat.ofHom_hom, Spec.map_preimage]
        rw [hm, ← Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, pow_succ',
          RingHom.mul_def]
        rfl

  have hτl : τ.left ≫ uZ.left = uZ.left := by
    have := congrArg (fun g => g.left) hτ
    rwa [hcl] at this
  have G1 : Spec.preimage (eLy.inv ≫ uZ.left ≫ eZ.hom) ≫
      Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom) = Spec.preimage (eLy.inv ≫ uZ.left ≫ eZ.hom) := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, reassoc_of% hτl]
  have heEl : eE.left ≫ πE.left = uZ.left := by
    have := congrArg (fun g => g.left) heE
    rwa [hcl] at this

  haveI := hEt
  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := (eLy.inv ≫ eE.left) (IsLocalRing.closedPoint Ly)) (U := ⊤) trivial
  have hrange : Set.range (eLy.inv ≫ eE.left) ⊆ Set.range hW.fromSpec := by
    rintro _ ⟨z, rfl⟩
    rw [hW.range_fromSpec]
    have : z = IsLocalRing.closedPoint Ly := Subsingleton.elim _ _
    subst this
    exact hxW
  obtain ⟨l, hl⟩ : ∃ l, l ≫ hW.fromSpec = eLy.inv ≫ eE.left :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
  have hft : (Spec.preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom)).hom.FiniteType := by
    have h1 : LocallyOfFiniteType (hW.fromSpec ≫ πE.left ≫ eZ.hom) := inferInstance
    rw [← Spec.map_preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom)] at h1
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h1
  have G3 : Spec.preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom) ≫ Spec.preimage l =
      Spec.preimage (eLy.inv ≫ uZ.left ≫ eZ.hom) := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage]
    simp only [reassoc_of% hl, reassoc_of% heEl, Category.assoc]
  have hσB : ∀ b : B, (Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom)).hom
      ((Spec.preimage l).hom ((Spec.preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom)).hom b)) =
      (Spec.preimage l).hom ((Spec.preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom)).hom b) := by
    intro b
    have e1 : (Spec.preimage l).hom ((Spec.preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom)).hom b) =
        (Spec.preimage (eLy.inv ≫ uZ.left ≫ eZ.hom)).hom b := by
      rw [← G3]; rfl
    rw [e1]
    have := congrArg (fun φ => φ.hom b) G1
    simpa using this

  letI : Algebra B Γ(E.left, W) := (Spec.preimage (hW.fromSpec ≫ πE.left ≫ eZ.hom)).hom.toAlgebra
  obtain ⟨t, ht⟩ := hft.out
  obtain ⟨k, hk⟩ := H (t.image (Spec.preimage l).hom)
  refine ⟨k, ?_⟩
  have hagree : ∀ c : Γ(E.left, W),
      ((Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom)).hom ^ (N ^ k)) ((Spec.preimage l).hom c) =
        (Spec.preimage l).hom c := by
    have hG : Set.EqOn (((Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom)).hom ^ (N ^ k)).comp
        (Spec.preimage l).hom) (Spec.preimage l).hom
        (Set.range (algebraMap B Γ(E.left, W)) ∪ (↑t : Set Γ(E.left, W))) := by
      rintro c (⟨b, rfl⟩ | hc)
      · rw [RingHom.comp_apply, RingHom.coe_pow]
        exact Function.iterate_fixed (hσB b) _
      · rw [RingHom.comp_apply, RingHom.coe_pow]
        exact hk _ (Finset.mem_image_of_mem _ hc)
    have hcl := RingHom.eqOn_set_closure hG
    intro c
    have hc : c ∈ Subring.closure (Set.range (algebraMap B Γ(E.left, W)) ∪ (↑t : Set Γ(E.left, W))) := by
      rw [← Algebra.adjoin_eq_ring_closure, ht]
      exact Subalgebra.mem_toSubring.mpr Algebra.mem_top
    exact hcl hc
  rw [(s1 (N ^ k)).1]
  apply MorphismProperty.Over.Hom.ext
  rw [hcl, ← Iso.cancel_iso_inv_left eLy]
  calc eLy.inv ≫ ((fun g : Ty ⟶ Ty => τ ≫ g)^[N ^ k] (𝟙 Ty)).left ≫ eE.left
      = (eLy.inv ≫ ((fun g : Ty ⟶ Ty => τ ≫ g)^[N ^ k] (𝟙 Ty)).left ≫ eLy.hom) ≫
          eLy.inv ≫ eE.left := by simp
    _ = Spec.map (CommRingCat.ofHom
          ((Spec.preimage (eLy.inv ≫ τ.left ≫ eLy.hom)).hom ^ (N ^ k))) ≫
          Spec.map (Spec.preimage l) ≫ hW.fromSpec := by
        rw [(s1 _).2, Spec.map_preimage, hl]
    _ = Spec.map (Spec.preimage l) ≫ hW.fromSpec := by
        rw [← Category.assoc, ← Spec.map_comp]
        congr 2
        apply CommRingCat.hom_ext
        ext c
        exact hagree c
    _ = eLy.inv ≫ eE.left := by rw [Spec.map_preimage, hl]

theorem wc_pfam_xwt_unipotent_algebra (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) (hq : ¬ ℓ ∣ q)
    {V : Type*} [AddCommGroup V] (s : ℚ_[ℓ] → V →+ V)
    (hs1 : ∀ x, s 1 x = x) (hsm : ∀ a b x, s (a * b) x = s a (s b x))
    (hsa : ∀ a b x, s (a + b) x = s a x + s b x)
    (g : V →+ V) (hgs : ∀ a x, g (s a x) = s a (g x))
    (W : AddSubgroup V) (hWs : ∀ a, ∀ w ∈ W, s a w ∈ W) (hgW : ∀ w ∈ W, g w = w)
    (hcod : ∀ x y : V, ∃ a b : ℚ_[ℓ], (a ≠ 0 ∨ b ≠ 0) ∧ s a x + s b y ∈ W)
    (B : V →+ V →+ ℚ_[ℓ]) (hBs : ∀ a x y, B (s a x) y = a * B x y)
    (hBalt : ∀ x y, B x y = -(B y x)) (hBnd : ∀ x, (∀ y, B x y = 0) → x = 0)
    (hBg : ∀ x y, B (g x) (g y) = B x y)
    (Λ : AddSubgroup V) (hΛs : ∀ a : ℚ_[ℓ], ‖a‖ ≤ 1 → ∀ x ∈ Λ, s a x ∈ Λ)
    (hΛspan : ∀ x, ∃ j : ℕ, s ((ℓ : ℚ_[ℓ]) ^ j) x ∈ Λ)
    (hΛsep : ∀ x, (∀ N : ℕ, ∃ y ∈ Λ, x = s ((ℓ : ℚ_[ℓ]) ^ N) y) → x = 0)
    (hcont : ∀ N : ℕ, ∃ k : ℕ, ∀ x ∈ Λ, ∃ y ∈ Λ,
      (⇑g)^[q ^ k] x - x = s ((ℓ : ℚ_[ℓ]) ^ N) y) :
    ∀ x, g x = x :=
by
  classical
  have hp : ℓ.Prime := Fact.out
  have s0 : ∀ x, s 0 x = 0 := fun x => by simpa using hsa 0 0 x
  have sinv : ∀ a : ℚ_[ℓ], a ≠ 0 → ∀ x, s a⁻¹ (s a x) = x := by
    intro a ha x
    rw [← hsm, inv_mul_cancel₀ ha, hs1]

  have hsq : ∀ x, g (g x - x) = g x - x := by
    have hdW : ∀ w ∈ W, g w - w = 0 := fun w hw => by rw [hgW w hw, sub_self]
    have hBdW : ∀ x, ∀ w ∈ W, B (g x - x) w = 0 := by
      intro x w hw
      have h := hBg x w
      rw [hgW w hw] at h
      rw [map_sub, AddMonoidHom.sub_apply, h, sub_self]
    have hBzz : ∀ z, B z z = 0 := by
      intro z
      have h2 : (2 : ℚ_[ℓ]) * B z z = 0 := by linear_combination hBalt z z
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hBr : ∀ z c v, B z (s c v) = c * B z v := by
      intro z c v
      rw [hBalt, hBs, hBalt v z]
      ring
    by_cases hall : ∀ y, y ∈ W
    · intro x
      exact sub_eq_zero.mp (hdW (g x - x) (hall _))
    push_neg at hall
    obtain ⟨y₀, hy₀⟩ := hall
    have claim1 : ∀ x, ∃ a b : ℚ_[ℓ], a ≠ 0 ∧ s a x + s b y₀ ∈ W := by
      intro x
      obtain ⟨a, b, hab, hmem⟩ := hcod x y₀
      refine ⟨a, b, ?_, hmem⟩
      rintro rfl
      have hb : b ≠ 0 := hab.resolve_left (fun h => h rfl)
      rw [s0, zero_add] at hmem
      have h3 := hWs b⁻¹ _ hmem
      rw [sinv b hb] at h3
      exact hy₀ h3
    obtain ⟨z, hz⟩ : ∃ z, z = g y₀ - y₀ := ⟨_, rfl⟩
    have hzW : z ∈ W := by
      obtain ⟨a₁, b₁, ha₁, hmem₁⟩ := claim1 z
      by_cases hb₁ : b₁ = 0
      · rw [hb₁, s0, add_zero] at hmem₁
        have h3 := hWs a₁⁻¹ _ hmem₁
        rwa [sinv a₁ ha₁] at h3
      · have hzy : B z y₀ = 0 := by
          have h1 := hBdW y₀ _ hmem₁
          rw [← hz, map_add, hBr, hBr, hBzz, mul_zero, zero_add] at h1
          exact (mul_eq_zero.mp h1).resolve_left hb₁
        have hz0 : z = 0 := by
          apply hBnd
          intro v
          obtain ⟨a, b, ha, hmem⟩ := claim1 v
          have h1 := hBdW y₀ _ hmem
          rw [← hz, map_add, hBr, hBr, hzy, mul_zero, add_zero] at h1
          exact (mul_eq_zero.mp h1).resolve_left ha
        rw [hz0]
        exact W.zero_mem
    have hgz : g z = z := hgW z hzW
    intro x
    obtain ⟨a, b, ha, hmem⟩ := claim1 x
    have h1 := hdW _ hmem
    rw [map_add, hgs, hgs] at h1
    have h2 : s a (g x - x) + s b z = 0 := by
      rw [hz, map_sub (s a), map_sub (s b)]
      calc s a (g x) - s a x + (s b (g y₀) - s b y₀)
          = s a (g x) + s b (g y₀) - (s a x + s b y₀) := by abel
        _ = 0 := h1
    have h4 : s a (g x - x) = -(s b z) := eq_neg_of_add_eq_zero_left h2
    have h3 : s a (g (g x - x) - (g x - x)) = 0 := by
      rw [map_sub (s a) (g (g x - x)) (g x - x), ← hgs, h4, map_neg g, hgs, hgz, sub_self]
    have h5 := sinv a ha (g (g x - x) - (g x - x))
    rw [h3, map_zero] at h5
    exact sub_eq_zero.mp h5.symm

  have hiter : ∀ (j : ℕ) x, (⇑g)^[j] x = x + j • (g x - x) := by
    intro j
    induction j with
    | zero => intro x; simp
    | succ j ih =>
      intro x
      rw [Function.iterate_succ_apply', ih, map_add, map_nsmul, hsq, succ_nsmul]
      abel
  have hnat : ∀ (n : ℕ) x, s (n : ℚ_[ℓ]) x = n • x := by
    intro n
    induction n with
    | zero => intro x; simp [s0]
    | succ n ih => intro x; rw [Nat.cast_succ, hsa, ih, hs1, succ_nsmul]
  have hΛ : ∀ x ∈ Λ, g x - x = 0 := by
    intro x hx
    apply hΛsep
    intro N
    obtain ⟨k, hk⟩ := hcont N
    obtain ⟨y, hy, hxy⟩ := hk x hx
    rw [hiter, add_sub_cancel_left, ← hnat] at hxy
    have hcop : Nat.Coprime ℓ (q ^ k) :=
      ((Nat.Prime.coprime_iff_not_dvd hp).mpr hq).pow_right k
    have hu1 : ‖((q ^ k : ℕ) : ℚ_[ℓ])‖ = 1 := Padic.norm_natCast_eq_one_iff.mpr hcop
    have hu0 : ((q ^ k : ℕ) : ℚ_[ℓ]) ≠ 0 := by
      intro h
      rw [h, norm_zero] at hu1
      exact zero_ne_one hu1
    refine ⟨s ((q ^ k : ℕ) : ℚ_[ℓ])⁻¹ y, hΛs _ ?_ y hy, ?_⟩
    · rw [norm_inv, hu1, inv_one]
    · rw [← hsm, mul_comm, hsm, ← hxy, sinv _ hu0]
  intro x
  obtain ⟨j, hj⟩ := hΛspan x
  have hc : ((ℓ : ℚ_[ℓ]) ^ j) ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hp.ne_zero)
  have h1 := hΛ _ hj
  rw [hgs, ← map_sub (s ((ℓ : ℚ_[ℓ]) ^ j))] at h1
  have h2 := sinv _ hc (g x - x)
  rw [h1, map_zero] at h2
  exact sub_eq_zero.mp h2.symm

theorem wc_xwtlc_point_topology (S : Scheme.{u}) (T : S.ProEt) (K : Type u) [Field K]
    (eK : T.left ≅ Spec (.of K)) :
    Subsingleton ↥T.left ∧ Nonempty ↥T.left ∧ ConnectedSpace ↥T.left ∧
      CompactSpace ↥T.left ∧ QuasiSeparatedSpace ↥T.left :=
by
  letI : Unique ↥T.left := (Scheme.homeoOfIso eK).toEquiv.unique
  exact ⟨inferInstance, inferInstance, inferInstance, inferInstance, inferInstance⟩

theorem wc_xwtlc_point_generic_off (P : Scheme.{u}) [IrreducibleSpace ↥P] (T : P.ProEt)
    (K : Type u) [Field K] (eK : T.left ≅ Spec (.of K)) (Δ : Set P) (hΔ : IsClosed Δ)
    (hne : ∃ y : P, y ∉ Δ) :
    ∀ z : T.left, T.hom z ∉ Δ :=
by
  intro z hz
  obtain ⟨y, hy⟩ := hne
  have hgen : ∀ ⦃a : T.left⦄ ⦃b : P⦄, b ⤳ T.hom a → ∃ a', a' ⤳ a ∧ T.hom a' = b :=
    Flat.generalizingMap T.hom
  have hη : genericPoint P ⤳ (T.hom z : P) := genericPoint_specializes (α := ↥P) _
  obtain ⟨z', -, hz'⟩ := hgen hη
  have hsub : ∀ a b : T.left, a = b := by
    intro a b
    apply (Scheme.homeoOfIso eK).injective
    exact Subsingleton.elim _ _
  rw [hsub z' z] at hz'
  have hηΔ : genericPoint P ∈ Δ := by rw [← hz']; exact hz
  exact hy ((genericPoint_specializes (α := ↥P) y).mem_closed hΔ hηΔ)

theorem wc_xwtlc_torsion_triv_at_point (F'' : Type u) [Field F''] [Finite F''] (M' : ℕ)
    (X : Scheme.{u}) (h : X ⟶ wcProjK F'' M') [IsProper h] (Δ : Set (wcProjK F'' M'))
    (hΔ : IsClosed Δ)
    (hsm : ∀ x : X, h x ∉ Δ → ∃ U : X.Opens, x ∈ U ∧ Smooth (U.ι ≫ h))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ty : (wcProjK F'' M').ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eL : Ty.left ≅ Spec (.of L))
    (t : Ty ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (hoff : ∀ z : Ty.left, Ty.hom z ∉ Δ) (q k : ℕ) :
    ∃ (W : (wcProjK F'' M').ProEt) (w : W ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
      (c : Ty ⟶ W) (b : ℕ) (e : Fin b → ℕ), Etale w.left ∧ c ≫ w = t ∧
      Nonempty ((((wcProEtPush h).rightDerived q).obj (wcContSheaf X (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcProjK F'' M') ((i : Fin b) → ZMod (ℓ ^ e i))).over W) :=
by
  classical

  let U₀ : (wcProjK F'' M').Opens := ⟨Δᶜ, isOpen_compl_iff.mpr hΔ⟩
  let Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹ᵁ U₀
  have hUb : ∀ x : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, x ∈ Ub ↔
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom x ∉ Δ := fun x => Iff.rfl

  haveI hpr : IsProper (Over.mk (wcProjKStr F'' M')).hom := wc_proj_space_isProper F'' M'
  haveI : IsLocallyNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd _ _)
  haveI : CompactSpace ↥(Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd _ _)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI hN : TopologicalSpace.NoetherianSpace
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    (inferInstance : TopologicalSpace.NoetherianSpace ↥(Limits.pullback
      (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  haveI hNU : TopologicalSpace.NoetherianSpace Ub.toScheme :=
    TopologicalSpace.NoetherianSpace.set
      (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
  haveI hcpt : CompactSpace Ub.toScheme := inferInstance

  obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
    wc_pfam_Rq_torsion_etale_locally_const F'' M' X h Δ hΔ hsm ℓ hℓ hPP Ub hUb hcpt q k

  have hwt : t.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Ty.hom :=
    MorphismProperty.Over.w t
  have hrange : Set.range t.left ⊆ Set.range Ub.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    show t.left z ∈ Ub
    rw [hUb]
    have h1 : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (t.left z) = Ty.hom z := by
      rw [← Scheme.Hom.comp_apply, hwt]
    rw [h1]
    exact hoff z
  let f₀ : Ty.left ⟶ Ub.toScheme := IsOpenImmersion.lift Ub.ι t.left hrange
  have hf₀ : f₀ ≫ Ub.ι = t.left := IsOpenImmersion.lift_fac _ _ _

  obtain ⟨j, w₀, hw₀⟩ := hcov (f₀ (eL.inv (IsLocalRing.closedPoint L)))

  haveI hresL : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let φ : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    set q : Polynomial L := p.map (φ.symm : IsLocalRing.ResidueField L →+* L) with hq
    have hqs : q.Separable := hsep.map
    have hdeg : q.degree ≠ 0 := by
      rw [hq, Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root q hdeg hqs
    refine ⟨φ y, ?_⟩
    have hp : p = q.map (φ : L →+* IsLocalRing.ResidueField L) := by
      rw [hq, Polynomial.map_map]
      have : ((φ : L →+* IsLocalRing.ResidueField L).comp
          (φ.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
        ext z; simp
      rw [this, Polynomial.map_id]
    rw [hp, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (φ : L →+* IsLocalRing.ResidueField L) y).trans
      (by rw [hy.eq_zero, map_zero])

  haveI := het j
  have hw : v j w₀ = (eL.inv ≫ f₀) (IsLocalRing.closedPoint L) :=
    hw₀.trans (Scheme.Hom.comp_apply eL.inv f₀ _).symm
  obtain ⟨σ', hσ'⟩ := wc_strictHensel_etale_point_lift L (eL.inv ≫ f₀) (v j) w₀ hw
  have hσ : (eL.hom ≫ σ') ≫ v j = f₀ := by
    rw [Category.assoc, hσ', Iso.hom_inv_id_assoc]

  have hcW : (eL.hom ≫ σ') ≫ (v j ≫ Ub.ι ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) = Ty.hom := by
    calc (eL.hom ≫ σ') ≫ (v j ≫ Ub.ι ≫
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)
        = (((eL.hom ≫ σ') ≫ v j) ≫ Ub.ι) ≫
            (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := by
          simp only [Category.assoc]
      _ = (f₀ ≫ Ub.ι) ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := by
          rw [hσ]
      _ = Ty.hom := by rw [hf₀, hwt]
  let W : (wcProjK F'' M').ProEt :=
    MorphismProperty.Over.mk ⊤ (v j ≫ Ub.ι ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) (hV j)
  let w : W ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP :=
    MorphismProperty.Over.homMk (v j ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let c : Ty ⟶ W := MorphismProperty.Over.homMk (eL.hom ≫ σ') hcW trivial
  refine ⟨W, w, c, b j, e j, ?_, ?_, hiso j⟩
  · show Etale (v j ≫ Ub.ι)
    infer_instance
  · apply MorphismProperty.Over.Hom.ext
    show (eL.hom ≫ σ') ≫ (v j ≫ Ub.ι) = t.left
    rw [← Category.assoc, hσ, hf₀]

theorem wc_xwtlc_etale_nbhd (P : Scheme.{u}) (G0 Vξ Ty W : P.ProEt) (a : Vξ ⟶ G0)
    (uξ : Ty ⟶ Vξ) (w : W ⟶ G0) (hw : Etale w.left) (c : Ty ⟶ W) (hc : c ≫ w = uξ ≫ a) :
    ∃ (E : P.ProEt) (πE : E ⟶ Vξ) (eE : Ty ⟶ E) (pr : E ⟶ W),
      Etale πE.left ∧ eE ≫ πE = uξ ∧ eE ≫ pr = c :=
by
  haveI : Etale w.left := hw
  have hp₁ : Etale (Limits.pullback.fst a.left w.left) := inferInstance
  have hE : WeaklyEtale (Limits.pullback.fst a.left w.left ≫ Vξ.hom) := by
    haveI : WeaklyEtale Vξ.hom := Vξ.prop
    infer_instance
  let E : P.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst a.left w.left ≫ Vξ.hom) hE
  let πE : E ⟶ Vξ := MorphismProperty.Over.homMk (Limits.pullback.fst a.left w.left) rfl trivial
  have h₂ : Limits.pullback.snd a.left w.left ≫ W.hom =
      Limits.pullback.fst a.left w.left ≫ Vξ.hom := by
    rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Limits.pullback.condition,
      Category.assoc, MorphismProperty.Over.w a]
  let pr : E ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd a.left w.left) h₂ trivial
  have hc' : uξ.left ≫ a.left = c.left ≫ w.left := by
    have h0 : (c ≫ w).left = (uξ ≫ a).left := congrArg (fun f => f.left) hc
    have h1 : c.left ≫ w.left = uξ.left ≫ a.left := h0
    exact h1.symm
  have h₃ : Limits.pullback.lift uξ.left c.left hc' ≫
      (Limits.pullback.fst a.left w.left ≫ Vξ.hom) = Ty.hom := by
    rw [← Category.assoc, Limits.pullback.lift_fst, MorphismProperty.Over.w uξ]
  let eE : Ty ⟶ E := MorphismProperty.Over.homMk (Limits.pullback.lift uξ.left c.left hc') h₃ trivial
  refine ⟨E, πE, eE, pr, hp₁, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_fst uξ.left c.left hc'
  · apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd uξ.left c.left hc'

theorem wc_xwtlc_point_fixed (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W T : S.ProEt)
    (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
    (θ : G.over W ≅ (wcContSheaf S A).over W) (hT : Subsingleton ↥T.left)
    (c : T ⟶ W) (m : T ⟶ T) (hm : m ≫ c = c) :
    ∀ z : G.obj.obj (Opposite.op T), (G.obj.map m.op).hom z = z :=
by
  intro z
  let T' : Over W := Over.mk c
  let μ : T' ⟶ T' := Over.homMk m hm
  have hC : ∀ f : ((wcContSheaf S A).over W).obj.obj (Opposite.op T'),
      (((wcContSheaf S A).over W).obj.map μ.op).hom f = f := by
    intro f
    apply ULift.ext
    exact ContinuousMap.ext (fun t => by
      show (show C(_, A) from f.down) (m.left t) = (show C(_, A) from f.down) t
      rw [Subsingleton.elim (m.left t) t])
  have hnat : (θ.hom.hom.app (Opposite.op T')).hom ((G.obj.map m.op).hom z) =
      (((wcContSheaf S A).over W).obj.map μ.op).hom
        ((θ.hom.hom.app (Opposite.op T')).hom z) :=
    congrArg (fun ψ => AddCommGrpCat.Hom.hom ψ z) (θ.hom.hom.naturality μ.op)
  have h1 : (θ.hom.hom.app (Opposite.op T')).hom ((G.obj.map m.op).hom z) =
      (θ.hom.hom.app (Opposite.op T')).hom z :=
    hnat.trans (hC _)
  have hinv : ∀ x : (G.over W).obj.obj (Opposite.op T'),
      (θ.inv.hom.app (Opposite.op T')).hom ((θ.hom.hom.app (Opposite.op T')).hom x) = x := by
    intro x
    exact congrArg (fun ψ => (ψ.hom.app (Opposite.op T')).hom x) θ.hom_inv_id
  have h2 := congrArg (θ.inv.hom.app (Opposite.op T')).hom h1
  exact (hinv ((G.obj.map m.op).hom z)).symm.trans (h2.trans (hinv z))

theorem wc_xwtlc_int_red_exact {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (q N : ℕ) (hc : Continuous (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom) (V : B.ProEt)
    (hV : Projective (wcFreeSheaf B V))
    (y : (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)).obj.obj (Opposite.op V))
    (hy : ((((wcProEtPush g).rightDerived q).map (wcContSheafMap X
        (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom hc)).hom.app (Opposite.op V)).hom y = 0) :
    ∃ w, y = (ℓ ^ N) • w :=
by
  classical
  have hp : ℓ.Prime := Fact.out
  obtain ⟨c₀, hc₀def⟩ : ∃ c : ℤ_[ℓ], c = ((ℓ ^ N : ℕ) : ℤ_[ℓ]) := ⟨_, rfl⟩
  have hc₀ : c₀ ≠ 0 := by
    rw [hc₀def]; exact Nat.cast_ne_zero.mpr (pow_ne_zero N hp.ne_zero)
  have hφ : Continuous (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) := continuous_const_smul c₀

  have hemb : Topology.IsEmbedding (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) := by
    refine (hφ.isClosedEmbedding ?_).isEmbedding
    intro a a' h
    have h' : c₀ * a = c₀ * a' := h
    exact mul_left_cancel₀ hc₀ h'
  have hex : ∀ b : ℤ_[ℓ], (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom b = 0 ↔
      ∃ a : ℤ_[ℓ], DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀ a = b := by
    intro b
    have e1 : (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom b = PadicInt.toZModPow N b := rfl
    rw [e1, ← RingHom.mem_ker, PadicInt.ker_toZModPow, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, ha⟩
      refine ⟨a, ?_⟩
      show c₀ * a = b
      rw [hc₀def, Nat.cast_pow, mul_comm]
      exact ha
    · rintro ⟨a, ha⟩
      refine ⟨a, ?_⟩
      have ha' : c₀ * a = b := ha
      rw [hc₀def, Nat.cast_pow, mul_comm] at ha'
      exact ha'
  have hsec : ∃ σ : ZMod (ℓ ^ N) → ℤ_[ℓ], Continuous σ ∧
      ∀ c, (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (σ c) = c := by
    haveI : NeZero (ℓ ^ N) := ⟨pow_ne_zero N hp.ne_zero⟩
    refine ⟨fun c => ((c.val : ℕ) : ℤ_[ℓ]), continuous_of_discreteTopology, fun c => ?_⟩
    show PadicInt.toZModPow N ((c.val : ℕ) : ℤ_[ℓ]) = c
    rw [map_natCast, ZMod.natCast_zmod_val]

  obtain ⟨hzero, hS⟩ := wc_contSheaf_shortExact X (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) hφ
    (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom hc hemb hex hsec
  haveI : Limits.PreservesFiniteLimits (wcProEtPush g) := inferInstance
  obtain ⟨-, -, hq⟩ := wc_rightDerived_les_package (wcProEtPush g) _ hS
  obtain ⟨⟨h0, hEx⟩, -⟩ := hq q

  have hns : ∀ {S : Scheme.{u}} {U : S.ProEt}
      {F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G) (n : ℕ)
      (x : F.obj.obj (Opposite.op U)),
      ((n • f).hom.app (Opposite.op U)).hom x = n • (f.hom.app (Opposite.op U)).hom x := by
    intro S U F G f n x
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      have h1 := congrArg (fun φ : F ⟶ G => (φ.hom.app (Opposite.op U)).hom x)
        (add_zero (0 : F ⟶ G))
      simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h1
      exact add_left_cancel (h1.trans (add_zero _).symm)
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, ← ih]
      simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply]

  have key : ∀ z : ℤ_[ℓ], DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀ z = (ℓ ^ N) • z := by
    intro z
    rw [hc₀def]
    exact Nat.cast_smul_eq_nsmul ℤ_[ℓ] (ℓ ^ N) z
  have hmul : wcContSheafMap X (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) hφ =
      (ℓ ^ N) • 𝟙 (wcContSheaf X ℤ_[ℓ]) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro s
    refine Eq.trans ?_ (hns (U := Opposite.unop U) (𝟙 (wcContSheaf X ℤ_[ℓ])) (ℓ ^ N) s).symm
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact key ((ULift.down s : C(_, ℤ_[ℓ])) t)
  let F2 := ((wcProEtPush g).rightDerived q).obj (wcContSheaf X ℤ_[ℓ])
  let F3 := ((wcProEtPush g).rightDerived q).obj (wcContSheaf X (ZMod (ℓ ^ N)))
  have hR : ((wcProEtPush g).rightDerived q).map
      (wcContSheafMap X (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) hφ) = (ℓ ^ N) • 𝟙 F2 := by
    rw [hmul]
    exact wc_rightDerived_map_nsmul_id (wcProEtPush g) q (ℓ ^ N) _

  obtain ⟨e, hnat, he0⟩ := proet_free_sheaf_hom_equiv B V
  let k : wcFreeSheaf B V ⟶ F2 := (e F2).symm y
  have hy' : e F2 k = y := (e F2).apply_symm_apply y
  have hk : k ≫ ((wcProEtPush g).rightDerived q).map
      (wcContSheafMap X (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom hc) = 0 := by
    apply (e F3).injective
    rw [hnat, he0, hy']
    exact hy
  haveI := hV
  let w' := hEx.liftFromProjective k hk
  have hw2 : w' ≫ ((wcProEtPush g).rightDerived q).map
      (wcContSheafMap X (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) hφ) = k :=
    hEx.liftFromProjective_comp k hk
  refine ⟨e F2 w', ?_⟩
  have hfin := hnat F2 F2 (((wcProEtPush g).rightDerived q).map
    (wcContSheafMap X (DistribSMul.toAddMonoidHom ℤ_[ℓ] c₀) hφ)) w'
  rw [hw2, hy', hR] at hfin
  exact hfin.trans ((hns (𝟙 F2) (ℓ ^ N) (e F2 w')).trans rfl)

theorem wc_xwtlc_int_rat_qcqs {X B : Scheme.{u}} (g : X ⟶ B) [QuasiCompact g]
    [QuasiSeparated g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) (U : B.ProEt)
    [CompactSpace U.left] [QuasiSeparatedSpace U.left] :
    (∀ x : (wcRq g ℓ q).obj.obj (Opposite.op U), ∃ (n : ℕ)
      (y : (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)).obj.obj (Opposite.op U)),
      ((wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n)).hom.app (Opposite.op U)).hom x =
        ((((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ)).hom.app
          (Opposite.op U)).hom y) ∧
    (∀ y : (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)).obj.obj (Opposite.op U),
      ((((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ)).hom.app
        (Opposite.op U)).hom y = 0 → ∃ r : ℕ, ℓ ^ r • y = 0) :=
by
  classical
  haveI hexX : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology X) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  haveI hexB : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology B) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  haveI hRfin : Limits.PreservesFiniteLimits (wcProEtPush g) := inferInstance
  obtain ⟨hi1, himul, -, -⟩ := wc_int_scalar_ring X ℓ
  obtain ⟨hl1, hlmul, -⟩ := wc_ladic_scalar_ring X ℓ
  obtain ⟨κ, ⟨hκ⟩, hκapp⟩ := wc_ladic_tower_colimit X ℓ
  obtain ⟨h1⟩ := wc_rightDerived_preserves_seq_colimit (wcProEtPush g)
    (fun G c hc => wc_proet_push_preserves_seq_colimit g G c hc)
    (fun I hI c hc k => wc_proet_push_colim_injective_acyclic g I hI c hc k) _ _ hκ q
  obtain ⟨hsurj, hinj⟩ := proet_free_hom_seq_colimit B U _ _ h1
  obtain ⟨e, hnat, h0⟩ := proet_free_sheaf_hom_equiv B U
  have hne : ∀ n : ℕ, ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 := fun n =>
    pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero)
  have hleg : ∀ n : ℕ, ((wcProEtPush g).rightDerived q).map (κ.app n) ≫
      wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n) =
      ((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ) := by
    intro n
    have hk : (wcIntToLadic X ℓ ≫ wcLadicScalar X ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)) ≫
        wcLadicScalar X ℓ ((ℓ : ℚ_[ℓ]) ^ n) = wcIntToLadic X ℓ := by
      rw [Category.assoc, ← hlmul, mul_inv_cancel₀ (hne n), hl1, Category.comp_id]
    have hk2 : κ.app n ≫ wcLadicScalar X ℓ ((ℓ : ℚ_[ℓ]) ^ n) = wcIntToLadic X ℓ :=
      (congrArg (fun z => z ≫ wcLadicScalar X ℓ ((ℓ : ℚ_[ℓ]) ^ n)) (hκapp n)).trans hk
    show _ ≫ ((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ ((ℓ : ℚ_[ℓ]) ^ n)) = _
    exact (Functor.map_comp _ _ _).symm.trans
      (congrArg (fun z => ((wcProEtPush g).rightDerived q).map z) hk2)
  have hns : ∀ (F : Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}) (N : ℕ)
      (z : F.obj.obj (Opposite.op U)), ((N • 𝟙 F).hom.app (Opposite.op U)).hom z = N • z := by
    intro F N z
    have e1 : (N • 𝟙 F).hom = N • 𝟙 F.obj := by
      have h := (sheafToPresheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).map_nsmul
        (f := 𝟙 F) (n := N)
      rw [CategoryTheory.Functor.map_id] at h
      exact h
    rw [e1, NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
    rfl
  have htr : ∀ (m : ℕ) (hm : 0 ≤ m), (Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf X ℓ)
      (fun _ => wcIntScalar X ℓ (ℓ : ℤ_[ℓ]))).map (homOfLE hm) =
      wcIntScalar X ℓ ((ℓ : ℤ_[ℓ]) ^ m) := by
    intro m
    induction m with
    | zero =>
      intro hm
      have hid : homOfLE hm = 𝟙 (0 : ℕ) := Subsingleton.elim _ _
      rw [hid, CategoryTheory.Functor.map_id, pow_zero, hi1]
      rfl
    | succ m ih =>
      intro hm
      rw [← homOfLE_comp (Nat.zero_le m) (Nat.le_succ m), Functor.map_comp, ih,
        Functor.ofSequence_map_homOfLE_succ, pow_succ', himul]
      rfl
  refine ⟨fun x => ?_, fun y hy => ?_⟩
  · obtain ⟨n, g', hg'⟩ := hsurj ((e (wcRq g ℓ q)).symm x)
    refine ⟨n, e (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)) g', ?_⟩
    have h4 : (e (wcRq g ℓ q)).symm x ≫ wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n) =
        g' ≫ ((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ) := by
      have e1 : (e (wcRq g ℓ q)).symm x ≫ wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n) =
          (g' ≫ ((wcProEtPush g).rightDerived q).map (κ.app n)) ≫
            wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n) :=
        congrArg (fun z => z ≫ wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n)) hg'
      exact e1.trans ((Category.assoc _ _ _).trans (congrArg (fun z => g' ≫ z) (hleg n)))
    have h5 := congrArg (e (wcRq g ℓ q)) h4
    have h6 := hnat (wcRq g ℓ q) (wcRq g ℓ q) (wcRqScalar g ℓ q ((ℓ : ℚ_[ℓ]) ^ n))
      ((e (wcRq g ℓ q)).symm x)
    have h7 := hnat (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)) (wcRq g ℓ q)
      (((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ)) g'
    rw [Equiv.apply_symm_apply] at h6
    exact h6.symm.trans (h5.trans h7)
  · obtain ⟨γ, rfl⟩ : ∃ γ, e (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)) γ = y :=
      ⟨_, Equiv.apply_symm_apply _ _⟩
    have hc0 : ((wcProEtPush g).rightDerived q).map (κ.app 0) =
        ((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ) := by
      have k0 : wcIntToLadic X ℓ ≫ wcLadicScalar X ℓ (((ℓ : ℚ_[ℓ]) ^ 0)⁻¹) =
          wcIntToLadic X ℓ := by
        rw [pow_zero, inv_one, hl1, Category.comp_id]
      exact congrArg (fun z => ((wcProEtPush g).rightDerived q).map z) ((hκapp 0).trans k0)
    have hι0 : (((wcProEtPush g).rightDerived q).mapCocone (Limits.Cocone.mk _ κ)).ι.app 0 =
        ((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ) := hc0
    have hγ0 : γ ≫ (((wcProEtPush g).rightDerived q).mapCocone (Limits.Cocone.mk _ κ)).ι.app 0
        = 0 := by
      have h7 := hnat (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)) (wcRq g ℓ q)
        (((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ)) γ
      have h8 : γ ≫ ((wcProEtPush g).rightDerived q).map (wcIntToLadic X ℓ) = 0 :=
        (e (wcRq g ℓ q)).injective (h7.trans (hy.trans (h0 _).symm))
      exact (congrArg (fun z => γ ≫ z) hι0).trans h8
    obtain ⟨m, hm, hgm⟩ := hinj 0 γ hγ0
    have k1 : wcIntScalar X ℓ ((ℓ : ℤ_[ℓ]) ^ m) = (ℓ ^ m : ℕ) • 𝟙 (wcIntSheaf X ℓ) := by
      rw [← Nat.cast_pow]
