      (Oc : Set _) = (Set.range ((v₀ ≫ ψ) ≫ e))ᶜ := ⟨⟨_, hclosed.isOpen_compl⟩, rfl⟩
  have hOcset : (Set.range ((v₀ ≫ ψ) ≫ e))ᶜ = {y : Spec (.of (wcQuadModelRing
      (IsLocalRing.ResidueField A) 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧
        q.val = p.val + 1 then (1 : IsLocalRing.ResidueField A) else 0))) |
      ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) 2 0
        (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then
