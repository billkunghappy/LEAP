          (Scheme.Etale.forget B)) (f : N' ⟶ N), res f.right x = 0) →
      (∀ (σ : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶
          Spec (.of (AlgebraicClosure (B.residueField η)))) (hσ : σ ≫ ξ = ξ)
        (N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))
