  haveI hac : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  have hbasic := wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x' hx₁ hx₂ (τ xs) hxs'
  haveI hprop' := hbasic.1
  haveI hprop : IsProper (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A)) := by
    rw [← hτsnd]; infer_instance
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have hu := (wc_pmn_vp_off_node_smooth F' F'' Y n D ℓ hℓ i V A e hV ⊥
      (fun z hz => by simp at hz)).1
    have hu' := hu.map (IsLocalRing.residue A)
    rw [map_natCast] at hu'
    exact hu'.ne_zero
  obtain ⟨Xt, E, b', iE, hb', hiE, hiso', hrE', hsmX', hsmE', hirrX, hirrE⟩ :=
    wc_pmn_tsl_odp_fibre_blowup F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x' hx₁ hx₂ (τ xs) hxs' h4
  haveI := hb'
  have hpre : ∀ w, (inv τ) w = xs ↔ w = τ xs := by
    intro w
