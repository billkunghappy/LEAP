import WeilR2_Part21
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_pub_quotient_model : ∀ (R H B A : Type u) [CommRing R] [CommRing H] [CommRing B] [CommRing A] [Algebra R H] [Algebra R B] [Algebra R A] (ψ : B →+* A), Function.Surjective ψ → ψ.comp (algebraMap R B) = algebraMap R A → ∀ (I : Ideal R), RingHom.ker ψ = Ideal.map (algebraMap R B) I → ∀ (n : ℕ) (e : Fin n → ℕ) (w : Fin n → H), (TensorProduct R H B ≃ₐ[H] ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j)))) → Nonempty (TensorProduct R H A ≃+* ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (Ideal.Quotient.mk (Ideal.map (algebraMap R H) I) (w j))))) :=
by
  intro R H B A _ _ _ _ _ _ _ ψ hψs hcomm I hker n e w E
  classical
  set J : Ideal H := Ideal.map (algebraMap R H) I with hJ

  let ψ' : B →ₐ[R] A := { ψ with commutes' := fun r => RingHom.congr_fun hcomm r }
  let Θ : TensorProduct R H B →ₐ[R] TensorProduct R H A :=
    Algebra.TensorProduct.map (AlgHom.id R H) ψ'
  have hΘs : Function.Surjective (Θ : TensorProduct R H B →+* TensorProduct R H A) :=
    Algebra.TensorProduct.map_surjective _ _ Function.surjective_id hψs
  have hkerψ' : RingHom.ker ψ' = RingHom.ker ψ := by
    ext x; exact Iff.rfl
  have hkerΘ : RingHom.ker (Θ : TensorProduct R H B →+* TensorProduct R H A) =
      Ideal.map (algebraMap H (TensorProduct R H B)) J := by
    have h1 := Algebra.TensorProduct.lTensor_ker (A := H) ψ' hψs
    change RingHom.ker Θ = _
    have h2 : Ideal.map (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R H B)
        (Ideal.map (algebraMap R B) I) =
        Ideal.map ((Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R H B) :
          B →+* TensorProduct R H B) (Ideal.map (algebraMap R B) I) := rfl
    have h3 : ((Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R H B) :
          B →+* TensorProduct R H B).comp (algebraMap R B) =
        (algebraMap H (TensorProduct R H B)).comp (algebraMap R H) := by
      ext r
      change Algebra.TensorProduct.includeRight (algebraMap R B r) =
        algebraMap H (TensorProduct R H B) (algebraMap R H r)
      rw [← IsScalarTower.algebraMap_apply R H (TensorProduct R H B) r]
      exact AlgHom.commutes _ r
    rw [h1, hkerψ', hker, hJ, h2, Ideal.map_map, Ideal.map_map, h3]
  have e₁ : TensorProduct R H A ≃+*
      (TensorProduct R H B ⧸ Ideal.map (algebraMap H (TensorProduct R H B)) J) :=
    (RingHom.quotientKerEquivOfSurjective hΘs).symm.trans (Ideal.quotEquivOfEq hkerΘ)

  have e₂ : (TensorProduct R H B ⧸ Ideal.map (algebraMap H (TensorProduct R H B)) J) ≃+*
      (((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j))) ⧸
        Ideal.map (algebraMap H ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j)))) J) := by
    refine Ideal.quotientEquiv _ _ E.toRingEquiv ?_
    have hE : ((E.toRingEquiv : TensorProduct R H B →+*
        ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j))))).comp
          (algebraMap H (TensorProduct R H B)) =
        algebraMap H ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j))) := by
      apply RingHom.ext
      intro h
      exact E.commutes h
    have h4 : Ideal.map (E.toRingEquiv : TensorProduct R H B →+*
        ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j))))
          (Ideal.map (algebraMap H (TensorProduct R H B)) J) =
        Ideal.map (algebraMap H ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) -
          Polynomial.C (w j)))) J := by
      rw [Ideal.map_map, hE]
    exact h4.symm

  have hpi : ∀ (M : Fin n → Type u) [∀ j, CommRing (M j)] [∀ j, Algebra H (M j)],
      Nonempty ((((j : Fin n) → M j) ⧸ Ideal.map (algebraMap H ((j : Fin n) → M j)) J) ≃+*
        ((j : Fin n) → (M j ⧸ Ideal.map (algebraMap H (M j)) J))) := by
    intro M _ _
    let Φ : ((j : Fin n) → M j) →+* ((j : Fin n) → (M j ⧸ Ideal.map (algebraMap H (M j)) J)) :=
      RingHom.pi (fun j => (Ideal.Quotient.mk (Ideal.map (algebraMap H (M j)) J)).comp
        (Pi.evalRingHom M j))
    have hΦ : ∀ x j, Φ x j = Ideal.Quotient.mk (Ideal.map (algebraMap H (M j)) J) (x j) :=
      fun x j => rfl
    have hΦs : Function.Surjective Φ := by
      intro y
      refine ⟨fun j => (Ideal.Quotient.mk_surjective (y j)).choose, ?_⟩
      funext j
      rw [hΦ]
      exact (Ideal.Quotient.mk_surjective (y j)).choose_spec
    have hkerΦ : RingHom.ker Φ = Ideal.map (algebraMap H ((j : Fin n) → M j)) J := by
      apply le_antisymm
      · intro x hx
        have hxj : ∀ j, x j ∈ Ideal.map (algebraMap H (M j)) J := by
          intro j
          have := congrFun ((RingHom.mem_ker).mp hx) j
          rw [hΦ] at this
          exact Ideal.Quotient.eq_zero_iff_mem.mp this
        rw [← Finset.univ_sum_single x]
        refine Ideal.sum_mem _ (fun j _ => ?_)
        let L : Ideal (M j) :=
          { carrier := {y | Pi.single j y ∈ Ideal.map (algebraMap H ((j : Fin n) → M j)) J}
            add_mem' := by
              intro a b ha hb
              simp only [Set.mem_setOf_eq] at ha hb ⊢
              rw [Pi.single_add]
              exact add_mem ha hb
            zero_mem' := by
              simp only [Set.mem_setOf_eq, Pi.single_zero]
              exact zero_mem _
            smul_mem' := by
              intro c a ha
              simp only [Set.mem_setOf_eq, smul_eq_mul] at ha ⊢
              rw [Pi.single_mul]
              exact Ideal.mul_mem_left _ _ ha }
        have hle : Ideal.map (algebraMap H (M j)) J ≤ L := by
          rw [Ideal.map_le_iff_le_comap]
          intro h hh
          rw [Ideal.mem_comap]
          change Pi.single j (algebraMap H (M j) h) ∈
            Ideal.map (algebraMap H ((j : Fin n) → M j)) J
          have : Pi.single j (algebraMap H (M j) h) =
              Pi.single j 1 * algebraMap H ((j : Fin n) → M j) h := by
            ext i
            rcases eq_or_ne i j with rfl | hij
            · simp
            · simp [hij]
          rw [this]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hh)
        exact hle (hxj j)
      · rw [Ideal.map_le_iff_le_comap]
        intro h hh
        rw [Ideal.mem_comap, RingHom.mem_ker]
        funext j
        rw [hΦ]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hh)
    exact ⟨(Ideal.quotEquivOfEq hkerΦ.symm).trans (RingHom.quotientKerEquivOfSurjective hΦs)⟩

  have hadj : ∀ (k : ℕ) (c : H),
      Nonempty ((AdjoinRoot (Polynomial.X ^ k - Polynomial.C c) ⧸
        Ideal.map (algebraMap H (AdjoinRoot (Polynomial.X ^ k - Polynomial.C c))) J) ≃+*
        AdjoinRoot (Polynomial.X ^ k - Polynomial.C (Ideal.Quotient.mk J c))) := by
    intro k c
    have h1 : Ideal.map (algebraMap H (AdjoinRoot (Polynomial.X ^ k - Polynomial.C c))) J =
        Ideal.map (AdjoinRoot.of (Polynomial.X ^ k - Polynomial.C c)) J := by
      rw [AdjoinRoot.algebraMap_eq]
    have h2 : (Polynomial.X ^ k - Polynomial.C c).map (Ideal.Quotient.mk J) =
        Polynomial.X ^ k - Polynomial.C (Ideal.Quotient.mk J c) := by
      simp
    have h3 : Ideal.span {(Polynomial.X ^ k - Polynomial.C c).map (Ideal.Quotient.mk J)} =
        Ideal.span {Polynomial.X ^ k - Polynomial.C (Ideal.Quotient.mk J c)} := by
      rw [h2]
    exact ⟨(Ideal.quotEquivOfEq h1).trans
      ((AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot J _).trans (Ideal.quotEquivOfEq h3))⟩
  obtain ⟨e₃⟩ := hpi (fun j => AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j)))
  exact ⟨e₁.trans (e₂.trans (e₃.trans
    (RingEquiv.piCongrRight fun j => (hadj (e j) (w j)).some)))⟩

theorem wc_pub_henselization_mod_dvr : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (H : Type u) [CommRing H] [HenselianLocalRing H] [IsNoetherianRing H] (ι : R →+* H) [IsLocalHom ι], (∀ x : H, ∃ y : R, x - ι y ∈ IsLocalRing.maximalIdeal H) → Ideal.map ι (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal H → @Algebra.WeaklyEtale R H _ _ ι.toAlgebra → ∀ (I : Ideal R) [IsDomain (R ⧸ I)], IsDiscreteValuationRing (R ⧸ I) → ∀ φ : R, Irreducible (Ideal.Quotient.mk I φ) → ∃ (_ : IsDomain (H ⧸ Ideal.map ι I)), IsDiscreteValuationRing (H ⧸ Ideal.map ι I) ∧ Irreducible (Ideal.Quotient.mk (Ideal.map ι I) (ι φ)) :=
by
  intro R _ _ _ H _ _ _ ι _ happrox hmax hwe I _ hI φ hφ

  have hss : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] (H : Type u) [CommRing H] [IsLocalRing H] [IsNoetherianRing H] (ι : O →+* H) [IsLocalHom ι], (∀ x : H, ∃ y : O, x - ι y ∈ IsLocalRing.maximalIdeal H) → Ideal.map ι (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal H → @Algebra.WeaklyEtale O H _ _ ι.toAlgebra → ∃ (_ : IsDomain H), IsDiscreteValuationRing H ∧ (∀ ϖ : O, Irreducible ϖ → Irreducible (ι ϖ)) := by
    intro O _ _ _ H _ _ _ ι _ _ hmax hWE
    letI : Algebra O H := ι.toAlgebra
    haveI : Module.Flat O H := hWE.flat
    have hsmul : ∀ (a : O) (h : H), a • h = ι a * h := fun a h => by
      rw [Algebra.smul_def]; rfl
    have s1 : ∀ a : O, a ≠ 0 → ∀ h : H, ι a * h = 0 → h = 0 := by
      intro a ha h hh
      have hreg : IsSMulRegular H a :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha)
      apply hreg
      show a • h = a • (0 : H)
      rw [hsmul, hh, smul_zero]
    have s2 : Function.Injective ι := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      by_contra hne
      exact one_ne_zero (s1 a hne 1 (by rw [ha, zero_mul]))
    have s3 : ∀ ϖ : O, Irreducible ϖ →
        IsLocalRing.maximalIdeal H = Ideal.span {ι ϖ} ∧ ι ϖ ≠ 0 := by
      intro ϖ hϖ
      refine ⟨?_, ?_⟩
      · rw [← hmax, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
      · intro h0
        exact hϖ.ne_zero (s2 (by rw [h0, map_zero]))
    obtain ⟨ϖ₀, hϖ₀⟩ := IsDiscreteValuationRing.exists_irreducible O
    obtain ⟨hm0, hπ0⟩ := s3 ϖ₀ hϖ₀
    set π := ι ϖ₀ with hπdef
    have hreg : ∀ h : H, π * h = 0 → h = 0 := s1 ϖ₀ hϖ₀.ne_zero
    have hregn : ∀ n : ℕ, ∀ h : H, π ^ n * h = 0 → h = 0 := by
      intro n
      induction n with
      | zero => intro h hh; simpa using hh
      | succ n ih =>
        intro h hh
        apply hreg
        apply ih
        rw [← mul_assoc, ← pow_succ]
        exact hh
    have hpow : ∀ n : ℕ, IsLocalRing.maximalIdeal H ^ n = Ideal.span {π ^ n} := by
      intro n; rw [hm0, Ideal.span_singleton_pow]
    have hfact : ∀ a : H, a ≠ 0 → ∃ (k : ℕ) (u : H), IsUnit u ∧ a = π ^ k * u := by
      intro a ha
      have hkrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal H)
        (IsLocalRing.maximalIdeal.isMaximal H).ne_top
      have hex : ∃ n, a ∉ Ideal.span {π ^ n} := by
        by_contra hcon
        push_neg at hcon
        apply ha
        have hmem : a ∈ ⨅ i, IsLocalRing.maximalIdeal H ^ i := by
          rw [Ideal.mem_iInf]; intro i; rw [hpow]; exact hcon i
        rw [hkrull] at hmem
        exact (Submodule.mem_bot H).mp hmem
      classical
      obtain ⟨N, hN, hmin⟩ : ∃ N, a ∉ Ideal.span {π ^ N} ∧ ∀ m < N, a ∈ Ideal.span {π ^ m} :=
        ⟨Nat.find hex, Nat.find_spec hex, fun m hm => by simpa using Nat.find_min hex hm⟩
      have hN0 : N ≠ 0 := by
        intro h0
        apply hN
        rw [h0, pow_zero, Ideal.span_singleton_one]
        exact Submodule.mem_top
      obtain ⟨k, rfl⟩ : ∃ k, N = k + 1 := ⟨N - 1, by omega⟩
      have hk : a ∈ Ideal.span {π ^ k} := hmin k (by omega)
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hk
      refine ⟨k, u, ?_, by rw [← hu, mul_comm]⟩
      by_contra hnu
      have hum : u ∈ IsLocalRing.maximalIdeal H := (IsLocalRing.mem_maximalIdeal u).mpr hnu
      rw [hm0] at hum
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hum
      apply hN
      rw [Ideal.mem_span_singleton']
      refine ⟨w, ?_⟩
      rw [← hu, ← hw, pow_succ]
      ring
    haveI hnzd : NoZeroDivisors H := by
      constructor
      intro a b hab
      by_contra hne
      push_neg at hne
      obtain ⟨k, u, hu, hau⟩ := hfact a hne.1
      obtain ⟨l, v, hv, hbv⟩ := hfact b hne.2
      have h1 : π ^ (k + l) * (u * v) = 0 := by rw [← hab, hau, hbv]; ring
      exact (hu.mul hv).ne_zero (hregn _ _ h1)
    haveI hdom : IsDomain H := NoZeroDivisors.to_isDomain H
    have hirr : ∀ x : H, x ≠ 0 → IsLocalRing.maximalIdeal H = Ideal.span {x} → Irreducible x :=
      fun x hx h => IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal x hx h
    have hdvr : IsDiscreteValuationRing H := by
      apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
      refine ⟨π, hirr π hπ0 hm0, ?_⟩
      intro x hx
      obtain ⟨k, u, hu, hxu⟩ := hfact x hx
      exact ⟨k, hu.unit, by rw [hxu, IsUnit.unit_spec]⟩
    exact ⟨hdom, hdvr, fun ϖ hϖ => hirr _ (s3 ϖ hϖ).2 (s3 ϖ hϖ).1⟩

  have hWEtrans : ∀ (A B B' : Type u) [CommRing A] [CommRing B] [CommRing B'] [Algebra A B]
      [Algebra.WeaklyEtale A B] (e : B ≃+* B') (f : A →+* B'),
      (e : B →+* B').comp (algebraMap A B) = f → @Algebra.WeaklyEtale A B' _ _ f.toAlgebra := by
    intro A B B' _ _ _ _ _ e f hf
    letI : Algebra A B' := f.toAlgebra
    let ê : B ≃ₐ[A] B' := AlgEquiv.ofRingEquiv (f := e) (fun a => by
      show e (algebraMap A B a) = f a
      rw [← hf]; rfl)
    haveI : Module.Flat A B := Algebra.WeaklyEtale.flat
    haveI : Module.Flat A B' := Module.Flat.of_linearEquiv ê.symm.toLinearEquiv
    refine ⟨inferInstance, ?_⟩
    let T := Algebra.TensorProduct.congr ê ê
    have hμ := Algebra.WeaklyEtale.flat_lmul' A B
    have hkey1 : (Algebra.TensorProduct.lmul' A : TensorProduct A B' B' →ₐ[A] B').comp T.toAlgHom
        = ê.toAlgHom.comp (Algebra.TensorProduct.lmul' A : TensorProduct A B B →ₐ[A] B) := by
      apply Algebra.TensorProduct.ext'
      intro x y
      simp [T, Algebra.TensorProduct.lmul'_apply_tmul]
    have hkey2 : (Algebra.TensorProduct.lmul' A : TensorProduct A B' B' →ₐ[A] B').toRingHom
        = ((ê.toAlgHom.comp (Algebra.TensorProduct.lmul' A : TensorProduct A B B →ₐ[A] B)).toRingHom).comp
            T.symm.toAlgHom.toRingHom := by
      rw [← hkey1]
      apply RingHom.ext
      intro x
      show _ = (Algebra.TensorProduct.lmul' A : TensorProduct A B' B' →ₐ[A] B') (T (T.symm x))
      rw [AlgEquiv.apply_symm_apply]
      rfl
    show RingHom.Flat _
    rw [hkey2]
    refine RingHom.Flat.comp (RingHom.Flat.of_bijective T.symm.bijective) ?_
    exact RingHom.Flat.comp hμ (RingHom.Flat.of_bijective ê.bijective)

  have hBC : letI := ι.toAlgebra; ∃ e : (H ⧸ Ideal.map ι I) ≃+* TensorProduct R (R ⧸ I) H,
      (e : (H ⧸ Ideal.map ι I) →+* TensorProduct R (R ⧸ I) H).comp
        (Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map) =
          algebraMap (R ⧸ I) (TensorProduct R (R ⧸ I) H) := by
    letI := ι.toAlgebra
    refine ⟨(Algebra.TensorProduct.quotIdealMapEquivTensorQuot H I).toRingEquiv.trans
      (Algebra.TensorProduct.comm R H (R ⧸ I)).toRingEquiv, ?_⟩
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro r
    simp only [RingHom.comp_apply, Ideal.quotientMap_mk]
    show (Algebra.TensorProduct.comm R H (R ⧸ I)) ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot H I)
      (Ideal.Quotient.mk (Ideal.map (algebraMap R H) I) (algebraMap R H r))) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk, Algebra.TensorProduct.comm_tmul,
      Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
    congr 1
    rw [Algebra.smul_def, mul_one]
    rfl

  haveI := hI
  have hItop : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have hJle : Ideal.map ι I ≤ IsLocalRing.maximalIdeal H := by
    rw [← hmax]; exact Ideal.map_mono (IsLocalRing.le_maximalIdeal hItop)
  have hJtop : Ideal.map ι I ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal H).ne_top (top_le_iff.mp (h ▸ hJle))
  haveI : Nontrivial (H ⧸ Ideal.map ι I) := Ideal.Quotient.nontrivial_iff.mpr hJtop
  haveI : IsLocalRing (H ⧸ Ideal.map ι I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.map ι I)) Ideal.Quotient.mk_surjective
  haveI : IsNoetherianRing (H ⧸ Ideal.map ι I) := Ideal.Quotient.isNoetherianRing _
  haveI hmkJ : IsLocalHom (Ideal.Quotient.mk (Ideal.map ι I)) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hmaxJ : IsLocalRing.maximalIdeal (H ⧸ Ideal.map ι I) =
      Ideal.map (Ideal.Quotient.mk (Ideal.map ι I)) (IsLocalRing.maximalIdeal H) :=
    (IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm
  have hloc₀ : IsLocalHom (Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map) := by
    constructor
    intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.quotientMap_mk] at hx
    have h1 : IsUnit (ι a) := isUnit_of_map_unit (Ideal.Quotient.mk (Ideal.map ι I)) _ hx
    have h2 : IsUnit a := isUnit_of_map_unit ι _ h1
    exact h2.map _
  have happrox₀ : ∀ x : H ⧸ Ideal.map ι I, ∃ y : R ⧸ I,
      x - Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map y ∈
        IsLocalRing.maximalIdeal (H ⧸ Ideal.map ι I) := by
    intro x
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y, hy⟩ := happrox h
    refine ⟨Ideal.Quotient.mk I y, ?_⟩
    rw [Ideal.quotientMap_mk, ← map_sub, hmaxJ]
    exact Ideal.mem_map_of_mem _ hy
  have hmax₀ : Ideal.map (Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map)
      (IsLocalRing.maximalIdeal (R ⧸ I)) = IsLocalRing.maximalIdeal (H ⧸ Ideal.map ι I) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective, Ideal.map_map, Ideal.quotientMap_comp_mk, ← Ideal.map_map,
      hmax, hmaxJ]

  letI : Algebra R H := ι.toAlgebra
  haveI : Algebra.WeaklyEtale R H := hwe
  have hwe₀ : @Algebra.WeaklyEtale (R ⧸ I) (H ⧸ Ideal.map ι I) _ _
      (Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map).toAlgebra := by
    obtain ⟨e, he⟩ := hBC
    refine hWEtrans (R ⧸ I) (TensorProduct R (R ⧸ I) H) (H ⧸ Ideal.map ι I) e.symm _ ?_
    rw [← he]
    apply RingHom.ext
    intro x
    simp

  obtain ⟨hdom, hdvr, hirr⟩ := hss (R ⧸ I) (H ⧸ Ideal.map ι I)
    (Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map) happrox₀ hmax₀ hwe₀
  refine ⟨hdom, hdvr, ?_⟩
  have hφ' : Ideal.Quotient.mk (Ideal.map ι I) (ι φ) =
      Ideal.quotientMap (Ideal.map ι I) ι Ideal.le_comap_map (Ideal.Quotient.mk I φ) := by
    rw [Ideal.quotientMap_mk]
  rw [hφ']
  exact hirr _ hφ

theorem wc_pub_eisenstein_product_stalks : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] (π : O), Irreducible π → ∀ (n : ℕ) (e : Fin n → ℕ) (w : Fin n → O), (∀ j, 0 < e j) → (∀ j, ∃ v : Oˣ, w j = (v : O) * π) → ∀ (P : Ideal ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j)))) [P.IsPrime], IsDomain (Localization.AtPrime P) :=
by
  intro O _ _ _ π hπ n e w he hw P _
  classical
  have hA : ∀ (k : ℕ) (c : O), 0 < k → (∃ v : Oˣ, c = (v : O) * π) →
      IsDomain (AdjoinRoot (Polynomial.X ^ k - Polynomial.C c)) := by
    intro k c hk hc
    obtain ⟨v, hv⟩ := hc
    have hk0 : k ≠ 0 := hk.ne'
    have hmon : (Polynomial.X ^ k - Polynomial.C c).Monic := Polynomial.monic_X_pow_sub_C c hk0
    have hdeg : (Polynomial.X ^ k - Polynomial.C c).natDegree = k := Polynomial.natDegree_X_pow_sub_C
    have hM : IsLocalRing.maximalIdeal O = Ideal.span {π} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ
    have hcM : c ∈ IsLocalRing.maximalIdeal O := by
      rw [hM, Ideal.mem_span_singleton]
      exact ⟨v, by rw [hv, mul_comm]⟩
    have hEis : (Polynomial.X ^ k - Polynomial.C c).IsEisensteinAt (IsLocalRing.maximalIdeal O) := by
      refine ⟨?_, @fun m hm => ?_, ?_⟩
      · rw [hmon.leadingCoeff]
        exact fun h => (IsLocalRing.maximalIdeal.isMaximal O).ne_top ((Ideal.eq_top_iff_one _).mpr h)
      · rw [hdeg] at hm
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C, if_neg hm.ne]
        split_ifs
        · simpa using hcM
        · simp
      · rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C, if_neg (Ne.symm hk0),
          if_pos rfl, zero_sub, hM, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        rintro ⟨d, hd⟩
        apply hπ.not_isUnit
        have h1 : π * (π * d) = π * (-(v : O)) := by
          rw [hv] at hd
          linear_combination -hd
        have h2 := mul_left_cancel₀ hπ.ne_zero h1
        refine isUnit_iff_exists_inv.mpr ⟨d * (-((v⁻¹ : Oˣ) : O)), ?_⟩
        rw [← mul_assoc, h2]
        simp
    have hirr : Irreducible (Polynomial.X ^ k - Polynomial.C c) :=
      hEis.irreducible (IsLocalRing.maximalIdeal.isMaximal O).isPrime hmon.isPrimitive (by omega)
    exact AdjoinRoot.isDomain_of_prime hirr.prime
  have hB : ∀ (R : Fin n → Type u) [∀ j, CommRing (R j)] [∀ j, IsDomain (R j)]
      (P : Ideal ((j : Fin n) → R j)) [P.IsPrime], IsDomain (Localization.AtPrime P) := by
    intro R _ _ P hP
    let ε : Fin n → ((j : Fin n) → R j) := fun j => Pi.single j 1
    have hsum : ∑ j, ε j = 1 := by
      have := Finset.univ_sum_single (1 : (j : Fin n) → R j)
      simp only [Pi.one_apply] at this
      exact this
    obtain ⟨j0, hj0⟩ : ∃ j0, ε j0 ∉ P := by
      by_contra h
      push_neg at h
      apply hP.ne_top
      rw [Ideal.eq_top_iff_one, ← hsum]
      exact Ideal.sum_mem _ (fun j _ => h j)
    have hε_mul : ∀ a : (j : Fin n) → R j, a j0 = 0 → ε j0 * a = 0 := by
      intro a ha
      funext j
      by_cases hj : j = j0
      · subst hj
        simp [ε, ha]
      · simp [ε, hj]
    have hS : ∀ s : (j : Fin n) → R j, s ∉ P → s j0 ≠ 0 := by
      intro s hs h0
      have h1 : ε j0 * s = 0 := hε_mul s h0
      have h2 : ε j0 * s ∈ P := by rw [h1]; exact P.zero_mem
      rcases hP.mem_or_mem h2 with h | h
      · exact hj0 h
      · exact hs h
    have key : ∀ (a : (j : Fin n) → R j) (s : P.primeCompl),
        IsLocalization.mk' (Localization.AtPrime P) a s = 0 ↔ a j0 = 0 := by
      intro a s
      rw [IsLocalization.mk'_eq_zero_iff]
      constructor
      · rintro ⟨m, hm⟩
        have h1 := congrFun hm j0
        simp only [Pi.mul_apply, Pi.zero_apply] at h1
        exact (mul_eq_zero.mp h1).resolve_left (hS m m.2)
      · intro ha
        exact ⟨⟨ε j0, hj0⟩, hε_mul a ha⟩
    have : NoZeroDivisors (Localization.AtPrime P) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨a, s, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl x
      obtain ⟨b, t, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl y
      rw [← IsLocalization.mk'_mul, key] at hxy
      rw [key, key]
      exact mul_eq_zero.mp hxy
    exact NoZeroDivisors.to_isDomain _
  have hdom : ∀ j, IsDomain (AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j))) :=
    fun j => hA (e j) (w j) (he j) (hw j)
  exact hB (fun j => AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C (w j))) P

theorem wc_pub_ff_domain_stalk_descent : ∀ (R H A : Type u) [CommRing R] [CommRing H] [CommRing A] [Algebra R H] [Algebra R A] [Module.FaithfullyFlat R H], (∀ (P : Ideal (TensorProduct R H A)) [P.IsPrime], IsDomain (Localization.AtPrime P)) → ∀ (N : Ideal A) [N.IsPrime], IsDomain (Localization.AtPrime N) :=
by
  intro R H A _ _ _ _ _ _ hstalk N _
  obtain ⟨P', hP'prime, hP'lies⟩ :=
    Ideal.exists_isPrime_liesOver_of_faithfullyFlat (A := A) (B := TensorProduct R A H) N
  have hP' : N = Ideal.comap (algebraMap A (TensorProduct R A H)) P' := by
    rw [hP'lies.over, Ideal.under_def]
  let e : TensorProduct R A H ≃+* TensorProduct R H A := (Algebra.TensorProduct.comm R A H).toRingEquiv
  let g : A →+* TensorProduct R H A := e.toRingHom.comp (algebraMap A (TensorProduct R A H))
  let P : Ideal (TensorProduct R H A) := Ideal.comap e.symm.toRingHom P'
  haveI : P.IsPrime := Ideal.IsPrime.comap _
  have hNP : N = Ideal.comap g P := by
    rw [hP']
    ext x
    simp [g, P, Ideal.mem_comap]
  have hAB' : (algebraMap A (TensorProduct R A H)).Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  have he : e.toRingHom.Flat := RingHom.Flat.of_bijective e.bijective
  have hg : g.Flat := RingHom.Flat.comp hAB' he
  let φ := Localization.localRingHom N P g hNP
  have hφflat : φ.Flat := RingHom.Flat.localRingHom hg P N hNP
  haveI hloc : IsLocalHom φ := Localization.isLocalHom_localRingHom N P g hNP
  letI : Algebra (Localization.AtPrime N) (Localization.AtPrime P) := φ.toAlgebra
  haveI : Module.Flat (Localization.AtPrime N) (Localization.AtPrime P) := hφflat
  haveI : IsLocalHom (algebraMap (Localization.AtPrime N) (Localization.AtPrime P)) := hloc
  haveI : Module.FaithfullyFlat (Localization.AtPrime N) (Localization.AtPrime P) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hinj : Function.Injective φ :=
    FaithfulSMul.algebraMap_injective (Localization.AtPrime N) (Localization.AtPrime P)
  haveI := hstalk P
  exact Function.Injective.isDomain φ hinj

theorem wc_plt_ub_abhyankar_unibranch (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R]
    [IsIntegrallyClosed R] (hk : IsAlgClosed (IsLocalRing.ResidueField R))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : R))
    (φ : R) (hφm : φ ∈ IsLocalRing.maximalIdeal R) (hφm2 : φ ∉ IsLocalRing.maximalIdeal R ^ 2)
    (I : Ideal R) [IsDomain (R ⧸ I)] (hI : IsDiscreteValuationRing (R ⧸ I))
    (hIφ : Irreducible (Ideal.Quotient.mk I φ))
    (C : Type u) [CommRing C] [Algebra R C] [Algebra (Localization.Away φ) C]
    [IsScalarTower R (Localization.Away φ) C] [Algebra.Etale (Localization.Away φ) C]
    [Module.Finite (Localization.Away φ) C] (hBfin : Module.Finite R (integralClosure R C))
    (hT : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H]
      [IsSepClosed (IsLocalRing.ResidueField H)] (hh : R →+* H),
      @Algebra.WeaklyEtale R H _ _ hh.toAlgebra →
      (IsLocalRing.maximalIdeal H).comap hh = Ideal.span {φ} →
      ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H →+* Ω),
        @Algebra.WeaklyEtale H Ω _ _ j.toAlgebra →
      ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) →
      ∀ χ : C →+* Ω, χ.comp (algebraMap R C) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ)
    (A : Type u) [CommRing A] (ψ : integralClosure R C →+* A) (hψs : Function.Surjective ψ)
    (hψk : RingHom.ker ψ = Ideal.map (algebraMap R (integralClosure R C)) I)
    (N : Ideal A) [N.IsPrime] :
    IsDomain (Localization.AtPrime N) :=
by
  classical

  obtain ⟨H, _, _, _, ι, hloc, happrox, hmax, hind⟩ := wc_pub_henselization_indEtale R
  letI : Algebra R H := ι.toAlgebra
  have hwe : Algebra.WeaklyEtale R H := wc_indEtale_weaklyEtale ι hind

  obtain ⟨hregH, hdomH, hsepH, hℓH, hφmH, hφm2H, hff, hcomap⟩ :=
    wc_pub_henselization_regular_package R hk H ι happrox hmax hwe ℓ hℓ φ hφm hφm2
  haveI : Module.FaithfullyFlat R H := hff

  obtain ⟨algD, towerD, hetD, hfinD⟩ := wc_pub_cover_baseChange R H C φ
  have hTD := wc_pub_tame_baseChange R H C φ ℓ hwe hcomap hT

  obtain ⟨n, e, u, he, ⟨E₁⟩⟩ := wc_pub_abhyankar_strict H ℓ hℓH (algebraMap R H φ) hφmH hφm2H
    (TensorProduct R H C) hTD

  obtain ⟨E₀, -⟩ := wc_pub_integralClosure_indEtale_baseChange R H C hind

  letI : Algebra R A := (ψ.comp (algebraMap R (integralClosure R C))).toAlgebra
  obtain ⟨F⟩ := wc_pub_quotient_model R H (integralClosure R C) A ψ hψs rfl I hψk n e
    (fun j => (u j : H) * algebraMap R H φ) (E₀.trans E₁)

  obtain ⟨hdomO, hdvrO, hirrO⟩ :=
    wc_pub_henselization_mod_dvr R H ι happrox hmax hwe I hI φ hIφ

  have hPi := wc_pub_eisenstein_product_stalks (H ⧸ Ideal.map ι I)
    (Ideal.Quotient.mk (Ideal.map ι I) (ι φ)) hirrO n e
    (fun j => Ideal.Quotient.mk (Ideal.map (algebraMap R H) I) ((u j : H) * algebraMap R H φ))
    (fun j => (he j).1)
    (fun j => ⟨Units.map (Ideal.Quotient.mk (Ideal.map ι I)).toMonoidHom (u j), by
      rw [Units.coe_map, map_mul]; rfl⟩)

  have hstalk : ∀ (P : Ideal (TensorProduct R H A)) [P.IsPrime],
      IsDomain (Localization.AtPrime P) := by
    intro P _
    have hsub : Submonoid.map F.toMonoidHom P.primeCompl =
        (Ideal.comap F.symm P).primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        show F y ∉ Ideal.comap F.symm P
        rw [Ideal.mem_comap]
        simpa using hy
      · intro hx
        refine ⟨F.symm x, hx, ?_⟩
        simp
    haveI := hPi (Ideal.comap F.symm P)
    exact MulEquiv.isDomain _ (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime P)
      (Localization.AtPrime (Ideal.comap F.symm P)) F hsub).toMulEquiv

  exact wc_pub_ff_domain_stalk_descent R H A hstalk N

theorem wc_plt_ub_stalk_model (X E' Z : Scheme.{u}) (U : X.Opens) (πE : E' ⟶ U.toScheme)
    [IsFinite πE] [QuasiCompact (πE ≫ U.ι)] (lb : Z ⟶ X) [IsClosedImmersion lb]
    (y : ↥(Limits.pullback (πE ≫ U.ι).fromNormalization lb))
    (W : X.Opens) (hW : IsAffineOpen W)
    (hxW : lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y) ∈ W) (f : Γ(X, W))
    (hWU : (W : Set X) ∩ U = X.basicOpen f) :
    letI : Algebra (X.presheaf.stalk (lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y)))
        Γ(Limits.pullback (πE ≫ U.ι)
          (X.fromSpecStalk (lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y))), ⊤) :=
      ((Scheme.ΓSpecIso
          (X.presheaf.stalk (lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y)))).inv ≫
        (Limits.pullback.snd (πE ≫ U.ι)
          (X.fromSpecStalk (lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y)))).appTop).hom.toAlgebra
    ∃ (A : Type u) (_ : CommRing A)
      (ψ : integralClosure
          (X.presheaf.stalk (lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y)))
          Γ(Limits.pullback (πE ≫ U.ι)
            (X.fromSpecStalk (lb (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y))), ⊤) →+* A),
      Function.Surjective ψ ∧
      RingHom.ker ψ = Ideal.map (algebraMap _ _)
        (RingHom.ker (lb.stalkMap (Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y)).hom) ∧
      ∃ (N : Ideal A) (_ : N.IsPrime),
        Nonempty ((Limits.pullback (πE ≫ U.ι).fromNormalization lb).presheaf.stalk y ≃+*
          Localization.AtPrime N) :=
by

  have hs1 : ∀ (X E' : Scheme.{u}) (U : X.Opens) (πE : E' ⟶ U.toScheme) [IsFinite πE]
      (W : X.Opens), IsAffineOpen W → ∀ (f : Γ(X, W)), (W : Set X) ∩ U = X.basicOpen f →
      IsAffineOpen ((πE ≫ U.ι) ⁻¹ᵁ W) := by
    intro X E' U πE _ W hW f hWU
    have hV : IsAffineOpen (U.ι ⁻¹ᵁ W) := by
      rw [← Scheme.Hom.isAffineOpen_iff_of_isOpenImmersion U.ι]
      have : U.ι ''ᵁ (U.ι ⁻¹ᵁ W) = X.basicOpen f := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        apply SetLike.coe_injective
        rw [← hWU]
        simp [Set.inter_comm]
      rw [this]
      exact hW.basicOpen f
    rw [Scheme.Hom.comp_preimage]
    exact hV.preimage πE

  have hs2 : ∀ (X P : Scheme.{u}) (g : P ⟶ X) [QuasiCompact g] [QuasiSeparated g] (U : X.Opens),
      IsAffineOpen U → IsAffineOpen (g ⁻¹ᵁ U) → ∀ (x : X), x ∈ U →
      letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) :=
        ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
          (Limits.pullback.snd g (X.fromSpecStalk x)).appTop).hom.toAlgebra
      ∃ e : Limits.pullback (Scheme.Hom.fromNormalization g) (X.fromSpecStalk x) ≅
          Spec (.of (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤))),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
          (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤)))) =
        Limits.pullback.snd (Scheme.Hom.fromNormalization g) (X.fromSpecStalk x) := by
    intro X P g _ _ U hU hV x hxU
    letI iZ : Algebra (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) :=
      ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
        (Limits.pullback.snd g (X.fromSpecStalk x)).appTop).hom.toAlgebra
    letI iB : Algebra Γ(X, U) Γ(P, g ⁻¹ᵁ U) := (g.app U).hom.toAlgebra
    letI iO : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hxU).hom.toAlgebra
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
      hU.isLocalization_stalk ⟨x, hxU⟩
    have s1 : ∀ {Z : Scheme.{u}} (ν : Z ⟶ X) (C : Type u) [CommRing C] [Algebra Γ(X, U) C]
        (i : Spec (.of C) ⟶ Z),
        IsPullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) C))) i hU.fromSpec ν →
        ∃ e : Limits.pullback ν (X.fromSpecStalk x) ≅
            Spec (.of (TensorProduct Γ(X, U) (X.presheaf.stalk x) C)),
          e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
            (TensorProduct Γ(X, U) (X.presheaf.stalk x) C))) =
            Limits.pullback.snd ν (X.fromSpecStalk x) := by
      intro Z ν C _ _ i H₁
      have H₂ := isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct Γ(X, U) (X.presheaf.stalk x) C)
      have H := H₂.flip.paste_horiz H₁.flip
      have hb : Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (X.presheaf.stalk x))) ≫
          hU.fromSpec = X.fromSpecStalk x := by
        rw [← hU.fromSpecStalk_eq_fromSpecStalk hxU]; rfl
      rw [hb] at H
      refine ⟨H.isoPullback.symm, ?_⟩
      rw [Iso.symm_hom]
      exact H.isoPullback_inv_snd
    have s4 : ∀ (T : Type u) [CommRing T] [Algebra (X.presheaf.stalk x) T]
        (e : Limits.pullback g (X.fromSpecStalk x) ≅ Spec (.of T)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) T)) =
          Limits.pullback.snd g (X.fromSpecStalk x) →
        Nonempty (T ≃ₐ[X.presheaf.stalk x] Γ(Limits.pullback g (X.fromSpecStalk x), ⊤)) := by
      intro T _ _ e he
      let ρ : CommRingCat.of T ≅ Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) :=
        (Scheme.ΓSpecIso (CommRingCat.of T)).symm ≪≫ Scheme.Γ.mapIso e.op
      have hρ : ρ.hom = (Scheme.ΓSpecIso (CommRingCat.of T)).inv ≫ e.hom.appTop := rfl
      have key : CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) T) ≫ ρ.hom =
          (Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
            (Limits.pullback.snd g (X.fromSpecStalk x)).appTop := by
        rw [hρ, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
          ← Scheme.Hom.comp_appTop, he]
        rfl
      let r : T ≃+* Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) := ρ.commRingCatIsoToRingEquiv
      refine ⟨AlgEquiv.ofRingEquiv (f := r) ?_⟩
      intro o
      exact congrArg (fun f => CommRingCat.Hom.hom f o) key
    have H₁ : IsPullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) Γ(P, g ⁻¹ᵁ U))))
        hV.fromSpec hU.fromSpec g := by
      refine IsOpenImmersion.isPullback _ _ _ _ ?_ ?_
      · have hφ : CommRingCat.ofHom (algebraMap Γ(X, U) Γ(P, g ⁻¹ᵁ U)) =
            g.appLE U (g ⁻¹ᵁ U) le_rfl := by
          rw [← Scheme.Hom.app_eq_appLE]; rfl
        rw [hφ]
        exact (IsAffineOpen.SpecMap_appLE_fromSpec g hU hV le_rfl).symm
      · rw [hU.opensRange_fromSpec, hV.opensRange_fromSpec]
    obtain ⟨e₁, he₁⟩ := s1 g Γ(P, g ⁻¹ᵁ U) hV.fromSpec H₁
    obtain ⟨ε⟩ := s4 _ e₁ he₁
    let κ := AlgEquiv.ofBijective
      (TensorProduct.toIntegralClosure Γ(X, U) (X.presheaf.stalk x) Γ(P, g ⁻¹ᵁ U))
      (TensorProduct.toIntegralClosure_bijective_of_isLocalization (B := Γ(P, g ⁻¹ᵁ U))
        (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl)
    let θ := κ.trans ε.mapIntegralClosure
    have hoi : IsOpenImmersion (g.normalizationOpenCover.f ⟨U, hU⟩) :=
      g.normalizationOpenCover.map_prop ⟨U, hU⟩
    letI hAI : Algebra Γ(X, U) (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)) := inferInstance
    have H₂ : IsPullback (Spec.map (CommRingCat.ofHom
        (algebraMap Γ(X, U) (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)))))
        (g.normalizationOpenCover.f ⟨U, hU⟩) hU.fromSpec g.fromNormalization := by
      refine @IsOpenImmersion.isPullback _ _ _ _ _ _ _ _ hoi _ ?_ ?_
      · exact Scheme.Hom.ι_fromNormalization g ⟨U, hU⟩
      · rw [hU.opensRange_fromSpec]; exact Scheme.Hom.fromNormalization_preimage g ⟨U, hU⟩
    obtain ⟨e₂, he₂⟩ := @s1 _ g.fromNormalization (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)) _ hAI
      (g.normalizationOpenCover.f ⟨U, hU⟩) H₂
    let α := θ.toRingEquiv.toCommRingCatIso
    have hα : CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤))) ≫ α.inv =
        CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
          (TensorProduct Γ(X, U) (X.presheaf.stalk x) (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)))) := by
      ext o
      exact θ.symm.commutes o
    refine ⟨e₂ ≪≫ (Scheme.Spec.mapIso α.op).symm, ?_⟩
    change (e₂.hom ≫ Spec.map α.inv) ≫ _ = _
    rw [Category.assoc, ← Spec.map_comp, hα, he₂]

  have hs3 : ∀ (R B T : Type u) [CommRing R] [CommRing B] [CommRing T] [Algebra R B] [Algebra R T],
      Function.Surjective (algebraMap R T) →
      Function.Surjective (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct R B T) ∧
      RingHom.ker (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct R B T) =
        Ideal.map (algebraMap R B) (RingHom.ker (algebraMap R T)) := by
    intro R B T _ _ _ _ _ h
    have hJ : RingHom.ker (Algebra.ofId R T) = RingHom.ker (algebraMap R T) := by
      ext r; simp [RingHom.mem_ker]
    let κ : (R ⧸ RingHom.ker (algebraMap R T)) ≃ₐ[R] T :=
      (Ideal.quotientEquivAlgOfEq R hJ).symm.trans
        (Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R T) h)
    let Φ : (B ⧸ (RingHom.ker (algebraMap R T)).map (algebraMap R B)) ≃ₐ[B] TensorProduct R B T :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (RingHom.ker (algebraMap R T))).trans
        (Algebra.TensorProduct.congr AlgEquiv.refl κ)
    have hcomp : (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct R B T) =
        Φ.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk _) := by
      ext b
      simp [Φ, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk,
        Algebra.TensorProduct.congr_apply]
    rw [hcomp]
    refine ⟨Φ.surjective.comp Ideal.Quotient.mk_surjective, ?_⟩
    rw [RingHom.ker_comp_of_injective _ Φ.toRingEquiv.injective, Ideal.mk_ker]

  have hflat : ∀ (X : Scheme.{u}) (x : X), Flat (X.fromSpecStalk x) := by
    intro X x
    obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
    show Flat (Spec.map (X.presheaf.germ U x hx) ≫ hU.fromSpec)
    have : Flat (Spec.map (X.presheaf.germ U x hx)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
      haveI := hU.isLocalization_stalk ⟨x, hx⟩
      exact RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl)
    have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
    exact MorphismProperty.comp_mem @Flat _ _ this hfs

  have hs4 : ∀ (Q Z P : Scheme.{u}) (q : Q ⟶ Z) (s : Z) (t : P ⟶ Q)
      (v : P ⟶ Spec (Z.presheaf.stalk s)), IsPullback t v q (Z.fromSpecStalk s) →
      ∀ p : P, Function.Bijective (t.stalkMap p).hom := by
    intro Q Z P q s t v h p
    haveI : IsPreimmersion t :=
      MorphismProperty.of_isPullback (P := @IsPreimmersion) h.flip inferInstance
    haveI : Flat t := MorphismProperty.of_isPullback (P := @Flat) h.flip (hflat Z s)
    refine ⟨?_, SurjectiveOnStalks.stalkMap_surjective t p⟩
    letI := (t.stalkMap p).hom.toAlgebra
    haveI hf : Module.Flat (Q.presheaf.stalk (t p)) (P.presheaf.stalk p) := Flat.stalkMap t p
    haveI hl : IsLocalHom (algebraMap (Q.presheaf.stalk (t p)) (P.presheaf.stalk p)) :=
      (inferInstance : IsLocalHom (t.stalkMap p).hom)
    haveI : Module.FaithfullyFlat (Q.presheaf.stalk (t p)) (P.presheaf.stalk p) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    exact RingHom.FaithfullyFlat.injective (f := (t.stalkMap p).hom) this

  have hs5 : ∀ (X Eb Z : Scheme.{u}) (ν : Eb ⟶ X) (lb : Z ⟶ X) (s : Z) (Bring : Type u)
      [CommRing Bring] [Algebra (X.presheaf.stalk (lb s)) Bring]
      (e : Limits.pullback ν (X.fromSpecStalk (lb s)) ≅ Spec (.of Bring)),
      e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk (lb s)) Bring)) =
        Limits.pullback.snd ν (X.fromSpecStalk (lb s)) →
      letI : Algebra (X.presheaf.stalk (lb s)) (Z.presheaf.stalk s) := (lb.stalkMap s).hom.toAlgebra
      ∃ t : Spec (.of (TensorProduct (X.presheaf.stalk (lb s)) Bring (Z.presheaf.stalk s))) ⟶
          Limits.pullback ν lb,
        IsPullback t (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
            (Z.presheaf.stalk s) →+* TensorProduct (X.presheaf.stalk (lb s)) Bring
              (Z.presheaf.stalk s))))
          (Limits.pullback.snd ν lb) (Z.fromSpecStalk s) := by
    intro X Eb Z ν lb s Bring _ _ e he
    letI : Algebra (X.presheaf.stalk (lb s)) (Z.presheaf.stalk s) := (lb.stalkMap s).hom.toAlgebra
    have Q1 := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct (X.presheaf.stalk (lb s)) Bring (Z.presheaf.stalk s))
    have Q2 : IsPullback (e.inv ≫ Limits.pullback.fst ν (X.fromSpecStalk (lb s)))
        (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk (lb s)) Bring))) ν
        (X.fromSpecStalk (lb s)) := by
      refine IsPullback.of_iso (IsPullback.of_hasPullback ν (X.fromSpecStalk (lb s))) e
        (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp [he]
      · simp
      · simp
    have H := Q1.paste_horiz Q2
    have hsq : Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk (lb s)) (Z.presheaf.stalk s))) ≫ X.fromSpecStalk (lb s) =
        Z.fromSpecStalk s ≫ lb :=
      Scheme.SpecMap_stalkMap_fromSpecStalk lb
    rw [hsq] at H
    let t := Limits.pullback.lift _ _ (H.w.trans (Category.assoc _ _ _).symm)
    have ht : _ = t ≫ Limits.pullback.fst ν lb := (Limits.pullback.lift_fst _ _ _).symm
    rw [ht] at H
    refine ⟨t, IsPullback.of_right H ?_ (IsPullback.of_hasPullback ν lb)⟩
    exact Limits.pullback.lift_snd _ _ _

  have hs6 : ∀ (Q Z : Scheme.{u}) (q : Q ⟶ Z) (s : Z) (A : Type u) [CommRing A]
      (t : Spec (.of A) ⟶ Q) (v : Spec (.of A) ⟶ Spec (Z.presheaf.stalk s)),
      IsPullback t v q (Z.fromSpecStalk s) →
      (∀ p : ↥(Spec (.of A)), Function.Bijective (t.stalkMap p).hom) →
      ∀ y : Q, q y = s →
      ∃ (N : Ideal A) (_ : N.IsPrime), Nonempty (Q.presheaf.stalk y ≃+* Localization.AtPrime N) := by
    intro Q Z q s A _ t v h hb y hy
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q)
      (g := Z.fromSpecStalk s) y (IsLocalRing.closedPoint (Z.presheaf.stalk s))
      (by rw [Scheme.fromSpecStalk_closedPoint, hy])
    have hp : t (h.isoPullback.inv z) = y := by
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hz1]
    generalize h.isoPullback.inv z = p at hp
    subst hp
    let p' : PrimeSpectrum A := p
    let e0 := (StructureSheaf.stalkIso A p').toRingEquiv
    exact ⟨p'.asIdeal, p'.isPrime, ⟨(RingEquiv.ofBijective _ (hb p)).trans e0.symm⟩⟩

  have hV := hs1 X E' U πE W hW f hWU
  generalize hs : Limits.pullback.snd (πE ≫ U.ι).fromNormalization lb y = s at hxW ⊢
  letI algC : Algebra (X.presheaf.stalk (lb s))
      Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk (lb s)), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk (lb s))).inv ≫
      (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk (lb s))).appTop).hom.toAlgebra
  obtain ⟨e, he⟩ := hs2 X E' (πE ≫ U.ι) W hW hV (lb s) hxW
  letI algT : Algebra (X.presheaf.stalk (lb s)) (Z.presheaf.stalk s) :=
    (lb.stalkMap s).hom.toAlgebra
  obtain ⟨t, ht⟩ := hs5 X _ Z (πE ≫ U.ι).fromNormalization lb s _ e he
  have hb := hs4 _ Z _ (Limits.pullback.snd _ lb) s t _ ht
  obtain ⟨N, hN, ⟨φ⟩⟩ := hs6 _ Z (Limits.pullback.snd _ lb) s _ t _ ht hb y hs
  have hτ : Function.Surjective (algebraMap (X.presheaf.stalk (lb s)) (Z.presheaf.stalk s)) :=
    SurjectiveOnStalks.stalkMap_surjective lb s
  obtain ⟨hsurj, hker⟩ := hs3 _ (integralClosure (X.presheaf.stalk (lb s))
    Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk (lb s)), ⊤)) _ hτ
  exact ⟨_, inferInstance, Algebra.TensorProduct.includeLeftRingHom, hsurj, hker, N, hN, ⟨φ⟩⟩

theorem wc_plt_line_unibranch_at_delta (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) [IsFinite πE] [Etale πE] (hEc : ConnectedSpace E)
    (hEt : wcPfamEllTame M' Δ ℓ hPP Ub πE) [QuasiCompact (πE ≫ Ub.ι)]
    (lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
    (hlb1 : lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam)
    (hlb2 : lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :
    ∀ y : ↥(Limits.pullback (πE ≫ Ub.ι).fromNormalization lb),
      lb (Limits.pullback.snd (πE ≫ Ub.ι).fromNormalization lb y) ∉ Ub →
      ∀ Z₁ ∈ irreducibleComponents (↥(Limits.pullback (πE ≫ Ub.ι).fromNormalization lb)),
      ∀ Z₂ ∈ irreducibleComponents (↥(Limits.pullback (πE ≫ Ub.ι).fromNormalization lb)),
      y ∈ Z₁ → y ∈ Z₂ → Z₁ = Z₂ :=
by
  classical
  obtain ⟨_, _, _, _, _, _, _, hlamCI, hlamstr, _, _, _, _⟩ := id hH
  have hsq : IsPullback lb (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) lam := by
    refine IsPullback.of_right ?_ ?_ (IsPullback.of_hasPullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).flip
    · rw [hlb2]
      have hl' : lam ≫ (Over.mk (wcProjKStr F'' M')).hom = (wcP1Over F'').hom := hlamstr
      rw [hl']
      exact (IsPullback.of_hasPullback _ _).flip
    · exact hlb1
  haveI hlbCI : IsClosedImmersion lb :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hlamCI
  intro y hy Z₁ hZ₁ Z₂ hZ₂ hyZ₁ hyZ₂
  obtain ⟨W, hxW, f, hW, hWU, hreg, hdom, hic, hac, hℓu, hφm, hφm2, ⟨hdI, hdvr⟩, hirr, Q, hQ,
      hgen⟩ :=
    wc_plt_ub_local_regular_data F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH hPP Ub hUb lb hlb1 hlb2
      (Limits.pullback.snd (πE ≫ Ub.ι).fromNormalization lb y) hy
  haveI := hreg
  haveI := hdom
  haveI := hic
  haveI := hdI
  letI algR : Algebra ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk
        (lb (Limits.pullback.snd (πE ≫ Ub.ι).fromNormalization lb y)))
      Γ(Limits.pullback (πE ≫ Ub.ι)
        ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk
          (lb (Limits.pullback.snd (πE ≫ Ub.ι).fromNormalization lb y))), ⊤) :=
    ((Scheme.ΓSpecIso ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk
        (lb (Limits.pullback.snd (πE ≫ Ub.ι).fromNormalization lb y)))).inv ≫
      (Limits.pullback.snd (πE ≫ Ub.ι)
        ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk
          (lb (Limits.pullback.snd (πE ≫ Ub.ι).fromNormalization lb y)))).appTop).hom.toAlgebra
  obtain ⟨alg, tower, het, hfin, hBfin⟩ :=
    wc_plt_ub_local_finite_etale _ E Ub πE _ W hW hxW f hWU
  letI := alg
  haveI := tower
  haveI := het
  haveI := hfin
  have hT := wc_plt_ub_tame_transfer F'' M' Δ ℓ hPP Ub hUb E πE hEt _ hy W hW hxW f hWU Q hQ hgen
  obtain ⟨A, _, ψ, hψs, hψk, N, hN, ⟨e⟩⟩ :=
    wc_plt_ub_stalk_model _ E _ Ub πE lb y W hW hxW f hWU
  haveI := hN
  haveI := wc_plt_ub_abhyankar_unibranch _ hac ℓ hℓu _ hφm hφm2 _ hdvr hirr _ hBfin hT A ψ hψs
    hψk N
  haveI hdomY : IsDomain ((Limits.pullback (πE ≫ Ub.ι).fromNormalization lb).presheaf.stalk y) :=
    MulEquiv.isDomain (Localization.AtPrime N) e.toMulEquiv
  have key : ∀ Z ∈ irreducibleComponents ↥(Limits.pullback (πE ≫ Ub.ι).fromNormalization lb),
      y ∈ Z → Z = closure (Set.range
        ((Limits.pullback (πE ≫ Ub.ι).fromNormalization lb).fromSpecStalk y)) := by
    intro Z hZ hyZ
    have hirrG : IsIrreducible (Set.range
        ((Limits.pullback (πE ≫ Ub.ι).fromNormalization lb).fromSpecStalk y)) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ _).image _
        (Scheme.Hom.continuous _).continuousOn
    have hZirr : IsIrreducible Z := hZ.prop
    have hZc : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
    have hg := hZirr.isGenericPoint_genericPoint_closure
    rw [hZc.closure_eq] at hg
    have hsp : hZirr.genericPoint ⤳ y := hg.specializes hyZ
    have hmem : hZirr.genericPoint ∈ Set.range
        ((Limits.pullback (πE ≫ Ub.ι).fromNormalization lb).fromSpecStalk y) := by
      rw [Scheme.range_fromSpecStalk]
      exact hsp
    have hsub : Z ⊆ closure (Set.range
        ((Limits.pullback (πE ≫ Ub.ι).fromNormalization lb).fromSpecStalk y)) := by
      calc Z = closure {hZirr.genericPoint} := hg.def.symm
        _ ⊆ _ := closure_mono (Set.singleton_subset_iff.mpr hmem)
    exact hZ.eq_of_le hirrG.closure hsub
  rw [key Z₁ hZ₁ hyZ₁, key Z₂ hZ₂ hyZ₂]

theorem wc_pfam_lfl_lefschetz_transitive (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) [IsFinite πE] [Etale πE] (hEc : ConnectedSpace E)
    (hEt : wcPfamEllTame M' Δ ℓ hPP Ub πE)
    (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eL : T.left ≅ Spec (.of L)) (e₁ e₂ : T.left ⟶ E)
    (h12 : e₁ ≫ πE ≫ Ub.ι = e₂ ≫ πE ≫ Ub.ι)
    (hlam : e₁ ≫ πE ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      T.hom ≫ lam) :
    ∃ τ : T ⟶ T, τ.left ≫ e₁ = e₂ :=
by
  classical
  obtain ⟨_, _, _, hM, _, _, _, _, hlamstr, hlin, _⟩ := id hH
  have hcond : (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam) ≫
        (Over.mk (wcProjKStr F'' M')).hom =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    have hl' : lam ≫ (Over.mk (wcProjKStr F'' M')).hom = (wcP1Over F'').hom := hlamstr
    rw [Category.assoc, hl']
    exact Limits.pullback.condition
  obtain ⟨lb, hlb1, hlb2⟩ : ∃ lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam ∧
      lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    ⟨Limits.pullback.lift _ _ hcond, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨hqc, hνfin, hνsurj, hirr⟩ := wc_plt_normalization_facts F'' M' hPP Ub E πE hEc
  haveI := hqc
  haveI := hνfin
  haveI := hνsurj
  haveI := hirr
  have hj := wc_hfe_normalization_restrict _ E Ub πE inferInstance
  obtain ⟨ψ, Lk, hLk, hψ⟩ := wc_plt_geom_line_range F'' M' lam hlamstr hlin hPP lb hlb1 hlb2
  have hFH := wc_plt_fulton_hansen_line (AlgebraicClosure F'') M' hM
    (πE ≫ Ub.ι).normalization ((πE ≫ Ub.ι).fromNormalization ≫ ψ.hom) Lk hLk
  have hY : _root_.IsPreconnected (⇑(πE ≫ Ub.ι).fromNormalization ⁻¹' Set.range ⇑lb) := by
    rw [← hψ]
    exact hFH
  have hU := wc_plt_line_unibranch_at_delta F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH hPP Ub hUb
    E πE hEc hEt lb hlb1 hlb2
  have hC := wc_plt_line_connected_glue F' F'' Y n D M' Xu h Δ lam p hH hPP Ub hUb E πE
    lb hlb1 hlb2 _ (πE ≫ Ub.ι).fromNormalization _ hj hY hU
  exact wc_plt_galois_of_line_connected F'' M' lam hlamstr hPP Ub E πE lb hlb1 hlb2 hC
    T L eL e₁ e₂ h12 hlam

theorem wc_pfam_lms_field_lefschetz (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eL : T.left ≅ Spec (.of L)) (b : T.left ⟶ Ω.W'.left) (hb : b ≫ Ω.W'.hom = T.hom ≫ lam) :
    ∀ (σ' : Ω.W' ⟶ Ω.W') (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      σ' ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ' g' →
      ∃ (τ : T ⟶ T) (σ'' : Ω.W' ⟶ Ω.W'), σ'' ≫ Ω.w' = Ω.w' ∧ wcPfamFrame Ω σ'' g' ∧
        τ.left ≫ b = b ≫ σ''.left :=
by
  intro σ' g' hσ' hfr'
  have kσ' : σ'.left ≫ Ω.w'.left = Ω.w'.left := congrArg (fun x => x.left) hσ'
  obtain ⟨A, hA⟩ := wc_pfam_lfl_deck_frames_lattice F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH
    hPP Ω
  have hU := wc_pfam_lfl_inertia_unipotent F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP Ω
  refine wc_pfam_lfl_line_frames_closed F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP Ω
    T L eL b hb g' ?_
  intro ε hε
  obtain ⟨Ub, E, πE, e, hUb, hfin, het, hEc, htame, he, hC1⟩ :=
    wc_pfam_lfl_finite_monodromy_cover F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP Ω
      A hA hU ε hε
  haveI := hfin
  haveI := het
  have kw : Ω.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Ω.W'.hom :=
    MorphismProperty.Over.w Ω.w'
  have he' : ∀ {Z : Scheme.{u}} (k : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left ⟶ Z),
      e ≫ πE ≫ Ub.ι ≫ k = Ω.w'.left ≫ k := by
    intro Z k
    rw [← he]
    simp only [Category.assoc]
  have h12 : (b ≫ e) ≫ πE ≫ Ub.ι = (b ≫ σ'.left ≫ e) ≫ πE ≫ Ub.ι := by
    simp only [Category.assoc, he, kσ']
  have hlam : (b ≫ e) ≫ πE ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      T.hom ≫ lam := by
    rw [Category.assoc, he', kw, hb]
  obtain ⟨τ, hτ⟩ := wc_pfam_lfl_lefschetz_transitive F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH hPP
    Ub hUb E πE hEc htame T L eL (b ≫ e) (b ≫ σ'.left ≫ e) h12 hlam
  have hw : τ.left ≫ b ≫ Ω.w'.left = b ≫ Ω.w'.left := by
    have := congrArg (fun k => k ≫ πE ≫ Ub.ι) hτ
    simp only [Category.assoc, he, kσ'] at this
    exact this
  obtain ⟨σ'', hσ'', hb''⟩ := wc_pfam_lfl_fibre_transitive M' h Δ ℓ (n - 1) hPP Ω L T.left eL
    b (τ.left ≫ b) (by rw [Category.assoc, hw])
  obtain ⟨g'', hg''⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
    Ω.hconn' Ω.r' Ω.θ' σ''
  have hfr'' : wcPfamFrame Ω σ'' g'' := fun s z =>
    hg'' Ω.W' (𝟙 Ω.W') σ'' (Category.id_comp σ'').symm s z
  refine ⟨τ, σ'', g'', hσ'', hfr'', hb'', ?_⟩
  have hne : Nonempty T.left := ⟨eL.inv (IsLocalRing.closedPoint L)⟩
  have heq : b ≫ σ''.left ≫ e = b ≫ σ'.left ≫ e := by
    rw [← Category.assoc, ← hb'', Category.assoc]
    exact hτ
  exact hC1 σ'' σ' g'' g' hσ'' hσ' hfr'' hfr' T.left b hne heq

theorem wc_pfam_line_monodromy_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (β : wcPfamLineBeta D ℓ h lam) (hβ : wcPfamLineBC π Ω lam β)
    (T₀ : (wcP1Over F'').left.ProEt) (a₀ : T₀ ⟶ π.W) (b₀ : T₀.left ⟶ Ω.W'.left)
    (hb₀ : b₀ ≫ Ω.W'.hom = T₀.hom ≫ lam)
    (M₀ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (hM₀ : wcPfamLineCmp π Ω lam β T₀ a₀ b₀ hb₀ M₀) :
    ∀ (σ' : Ω.W' ⟶ Ω.W') (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      σ' ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ' g' →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧
        wcHonestFrame D ℓ π.W π.r π.θ σ (M₀.symm.toLinearMap ∘ₗ g' ∘ₗ M₀.toLinearMap) :=
by
  classical
  intro σ' g' hσ' hfr'
  obtain ⟨hT₀c, hC2₀, hC3₀⟩ := hM₀
  obtain ⟨hB1, hB2, -⟩ := hβ

  have hNθ : ∀ (V V' : (wcP1Over F'').left.ProEt) (g : V' ⟶ V) (c : V ⟶ π.W) (u : V' ⟶ π.W),
      g ≫ c = u → ∀ (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V'.left),
      (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk u))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map g.op).hom y)).down) z =
      (show C(↥V.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) (g.left z) := by
    rintro V V' g c u rfl y z
    have e := congrArg (fun m => m.hom y)
      (π.θ.hom.hom.naturality (Over.homMk g rfl : Over.mk (g ≫ c) ⟶ Over.mk c).op)
    exact congrArg (fun w : ULift.{u+1} C(↥V'.left, Fin π.r → ℚ_[ℓ]) => w.down z) e

  have hNθ' : ∀ (V V' : (wcProjK F'' M').ProEt) (g : V' ⟶ V) (c : V ⟶ Ω.W') (u : V' ⟶ Ω.W'),
      g ≫ c = u → ∀ (y : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V'.left),
      (show C(↥V'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk u))).hom
          (((wcRq h ℓ (n - 1)).obj.map g.op).hom y)).down) z =
      (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) (g.left z) := by
    rintro V V' g c u rfl y z
    have e := congrArg (fun m => m.hom y)
      (Ω.θ'.hom.hom.naturality (Over.homMk g rfl : Over.mk (g ≫ c) ⟶ Over.mk c).op)
    exact congrArg (fun w : ULift.{u+1} C(↥V'.left, Fin Ω.r' → ℚ_[ℓ]) => w.down z) e

  have hcancel2' : ∀ (V : Over Ω.W')
      (c : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op V)),
      (Ω.θ'.hom.hom.app (Opposite.op V)).hom ((Ω.θ'.inv.hom.app (Opposite.op V)).hom c) = c := by
    intro V c
    exact congrArg (fun m => (m.hom.app (Opposite.op V)).hom c) Ω.θ'.inv_hom_id
  have hconst' : ∀ v : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W'),
      ∀ z : Ω.W'.left, (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom c, fun z => ?_⟩
    have hs := hcancel2' (Over.mk (𝟙 Ω.W')) c
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) hs

  obtain ⟨T, f, L, _, _, ⟨eL⟩⟩ := wc_pfam_lms_sep_field_point F'' T₀ hT₀c
  have hconnT : ConnectedSpace T.left := by
    have hsub : ∀ x y : T.left, x = y := by
      intro x y
      have h1 : eL.hom x = eL.hom y :=
        @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
      have hx : eL.inv (eL.hom x) = x := by simp
      have hy : eL.inv (eL.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    haveI : Nonempty T.left := ⟨eL.inv (IsLocalRing.closedPoint L)⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun x _ y _ => hsub x y)⟩
  have t₀ : T.left := eL.inv (IsLocalRing.closedPoint L)
  have hb : (f.left ≫ b₀) ≫ Ω.W'.hom = T.hom ≫ lam := by
    rw [Category.assoc, hb₀, ← Category.assoc, MorphismProperty.Over.w f]

  have hC3 : ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')) (t : T.left),
      (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) ((f.left ≫ b₀) t) =
      M₀ ((show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (f ≫ a₀)))).hom
          (β Ω.W' T (f.left ≫ b₀) hb s)).down) t) := by
    intro s t
    have e1 := hB1 Ω.W' T₀ T f b₀ hb₀ hb s
    have e2 := hNθ T₀ T f a₀ (f ≫ a₀) rfl (β Ω.W' T₀ b₀ hb₀ s) t
    have e3 : (f.left ≫ b₀) t = b₀ (f.left t) := by simp only [Scheme.Hom.comp_apply]
    refine (congrArg (fun z => (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z) e3).trans ?_
    refine (hC3₀ s (f.left t)).trans ?_
    refine congrArg M₀ (e2.symm.trans ?_)
    exact congrArg (fun y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T) =>
      (show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (f ≫ a₀)))).hom y).down) t) e1

  obtain ⟨τ, σ'', hσ'', hfr'', hτb⟩ := wc_pfam_lms_field_lefschetz F' F'' Y n hn hn2 D ℓ hℓ
    M' Xu h Δ lam p hH hPP Ω T L eL (f.left ≫ b₀) hb σ' g' hσ' hfr'
  have kσ'' : σ''.left ≫ Ω.w'.left = Ω.w'.left := congrArg (fun x => x.left) hσ''
  have kσ : ∀ {Z : Scheme.{u}} (k : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left ⟶ Z),
      σ''.left ≫ Ω.w'.left ≫ k = Ω.w'.left ≫ k := by
    intro Z k
    rw [← Category.assoc, kσ'']
  have hτb' : ∀ {Z : Scheme.{u}} (k : Ω.W'.left ⟶ Z),
      τ.left ≫ f.left ≫ b₀ ≫ k = f.left ≫ b₀ ≫ σ''.left ≫ k := by
    intro Z k
    have := congrArg (fun x => x ≫ k) hτb
    simpa only [Category.assoc] using this
  have kfst : π.w.left ≫ Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = π.W.hom :=
    MorphismProperty.Over.w π.w

  have hw : (f ≫ a₀) ≫ π.w = (τ ≫ f ≫ a₀) ≫ π.w := by
    apply MorphismProperty.Over.Hom.ext
    change f.left ≫ a₀.left ≫ π.w.left = τ.left ≫ f.left ≫ a₀.left ≫ π.w.left
    apply Limits.pullback.hom_ext
    · show f.left ≫ a₀.left ≫ π.w.left ≫ Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        τ.left ≫ f.left ≫ a₀.left ≫ π.w.left ≫ Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      rw [kfst, MorphismProperty.Over.w a₀, MorphismProperty.Over.w f, MorphismProperty.Over.w τ]
    · show f.left ≫ a₀.left ≫ π.w.left ≫ Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        τ.left ≫ f.left ≫ a₀.left ≫ π.w.left ≫ Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      rw [hC2₀, hτb']
      exact congrArg (fun k => f.left ≫ b₀ ≫ k) (kσ _).symm
  obtain ⟨σ, hσ, hτa⟩ := hgal T (f ≫ a₀) (τ ≫ f ≫ a₀) hconnT hw

  obtain ⟨h₀, hh₀⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
    π.W π.hconn π.r π.θ σ
  have hfr0 : wcHonestFrame D ℓ π.W π.r π.θ σ h₀ := fun s z =>
    hh₀ π.W (𝟙 π.W) σ (Category.id_comp σ).symm s z

  have hG : ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')) (z : Ω.W'.left),
      (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) (σ''.left z) =
      g' ((show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom
          (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s)).down) z) := by
    intro s z
    exact (hNθ' Ω.W' Ω.W' σ'' (𝟙 Ω.W') σ'' (Category.comp_id σ'') s z).symm.trans
      (hfr'' _ z)
  have hb2 : ((f.left ≫ b₀) ≫ σ''.left) ≫ Ω.W'.hom = T.hom ≫ lam := by
    rw [Category.assoc, MorphismProperty.Over.w σ'', hb]
  have hb3 : (τ.left ≫ f.left ≫ b₀) ≫ Ω.W'.hom = T.hom ≫ lam := by
    rw [Category.assoc, hb, ← Category.assoc, MorphismProperty.Over.w τ]
  have hβcong : ∀ (b1 b2 : T.left ⟶ Ω.W'.left) (_ : b1 = b2)
      (h1 : b1 ≫ Ω.W'.hom = T.hom ≫ lam) (h2 : b2 ≫ Ω.W'.hom = T.hom ≫ lam)
      (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')),
      β Ω.W' T b1 h1 s = β Ω.W' T b2 h2 s := by
    intro b1 b2 e h1 h2 s
    subst e
    rfl

  have hkey : ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')) (t : T.left),
      M₀ (h₀ ((show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (f ≫ a₀)))).hom
          (β Ω.W' T (f.left ≫ b₀) hb (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s))).down) t)) =
      g' (M₀ ((show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (f ≫ a₀)))).hom
          (β Ω.W' T (f.left ≫ b₀) hb (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s))).down) t)) := by
    intro s t
    have i1 := hh₀ T (f ≫ a₀) (τ ≫ f ≫ a₀) hτa
      (β Ω.W' T (f.left ≫ b₀) hb (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s)) t
    have i2 : β Ω.W' T (f.left ≫ b₀) hb (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s) =
        ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom (β Ω.W' T (f.left ≫ b₀) hb s) :=
      (hB2 Ω.W' Ω.W' σ'' T (f.left ≫ b₀) hb hb2 s).trans
        ((hβcong _ _ hτb.symm hb2 hb3 s).trans (hB1 Ω.W' T T τ (f.left ≫ b₀) hb hb3 s).symm)
    have c1 := congrArg (fun y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T) =>
      (show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (τ ≫ f ≫ a₀)))).hom y).down) t) i2
    have i3 := hNθ T T τ (f ≫ a₀) (τ ≫ f ≫ a₀) rfl (β Ω.W' T (f.left ≫ b₀) hb s) t
    have i4 := hC3 s (τ.left t)
    have i5 : (f.left ≫ b₀) (τ.left t) = σ''.left ((f.left ≫ b₀) t) := by
      have := congrArg (fun k : T.left ⟶ Ω.W'.left => k t) hτb
      simpa only [Scheme.Hom.comp_apply] using this
    have i6 := hG s ((f.left ≫ b₀) t)
    have i7 := hC3 (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s) t
    exact (congrArg M₀ (i1.symm.trans (c1.trans i3))).trans
      (i4.symm.trans ((congrArg (fun z => (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z) i5).trans
          (i6.trans (congrArg g' i7))))

  have hg'surj : Function.Surjective g' := by
    intro w
    obtain ⟨s, hs⟩ := hconst' w
    exact ⟨_, (hG s ((f.left ≫ b₀) t₀)).symm.trans (hs _)⟩
  have hg'inj : Function.Injective g' := LinearMap.injective_iff_surjective.mpr hg'surj
  have hall : ∀ x, M₀ (h₀ x) = g' (M₀ x) := by
    intro x
    obtain ⟨s, hs⟩ := hconst' (g' (M₀ x))
    have e1 := hg'inj ((hG s ((f.left ≫ b₀) t₀)).symm.trans (hs _))
    have e2 := M₀.injective ((hC3 (((wcRq h ℓ (n - 1)).obj.map σ''.op).hom s) t₀).symm.trans e1)
    exact (congrArg (fun X => M₀ (h₀ X)) e2).symm.trans
      ((hkey s t₀).trans (congrArg (fun X => g' (M₀ X)) e2))
  refine ⟨σ, hσ, ?_⟩
  have hh : h₀ = M₀.symm.toLinearMap ∘ₗ g' ∘ₗ M₀.toLinearMap := by
    apply LinearMap.ext
    intro x
    show h₀ x = M₀.symm (g' (M₀ x))
    rw [← hall x, LinearEquiv.symm_apply_apply]
  rw [← hh]
  exact hfr0

theorem wc_pcl_sep_points_coincide (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (T₁ T₂ : (wcP1Over F'').left.ProEt) (L₁ L₂ : Type u) [Field L₁] [IsSepClosed L₁]
    [Field L₂] [IsSepClosed L₂] (e₁ : T₁.left ≅ Spec (.of L₁)) (e₂ : T₂.left ≅ Spec (.of L₂))
    (c₁ : T₁ ⟶ W) (c₂ : T₂ ⟶ W) :
    c₁.left (e₁.inv (IsLocalRing.closedPoint L₁)) = c₂.left (e₂.inv (IsLocalRing.closedPoint L₂)) :=
by
  haveI hirr : IrreducibleSpace W.left :=
    wc_proet_P1bar_qc_conn_irreducible F'' hP W w hqc hconn
  have key : ∀ (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L]
      (e : T.left ≅ Spec (.of L)) (c : T ⟶ W),
      c.left (e.inv (IsLocalRing.closedPoint L)) = genericPoint W.left := by
    intro T L _ e c
    have hc : WeaklyEtale c.left := by
      have h1 : WeaklyEtale (c.left ≫ W.hom) := by
        rw [MorphismProperty.Over.w c]; exact T.prop
      haveI : WeaklyEtale W.hom := W.prop
      exact WeaklyEtale.of_comp c.left W.hom
    have hgen : GeneralizingMap c.left := Flat.generalizingMap c.left
    have hsub : ∀ x y : T.left, x = y := by
      intro x y
      have h1 : e.hom x = e.hom y :=
        @Subsingleton.elim (PrimeSpectrum L) inferInstance (e.hom x) (e.hom y)
      have hx : e.inv (e.hom x) = x := by simp
      have hy : e.inv (e.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    obtain ⟨a', -, ha'⟩ :=
      hgen (genericPoint_specializes (c.left (e.inv (IsLocalRing.closedPoint L))))
    rw [hsub (e.inv (IsLocalRing.closedPoint L)) a']
    exact ha'
  rw [key T₁ L₁ e₁ c₁, key T₂ L₂ e₂ c₂]

theorem wc_pfam_line_cmp_orbit (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (β : wcPfamLineBeta D ℓ h lam) (hβ : wcPfamLineBC π Ω lam β)
    (T₀ : (wcP1Over F'').left.ProEt) (a₀ : T₀ ⟶ π.W) (b₀ : T₀.left ⟶ Ω.W'.left)
    (hb₀ : b₀ ≫ Ω.W'.hom = T₀.hom ≫ lam)
    (M₀ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (hM₀ : wcPfamLineCmp π Ω lam β T₀ a₀ b₀ hb₀ M₀)
    (T₁ : (wcP1Over F'').left.ProEt) (a₁ : T₁ ⟶ π.W) (b₁ : T₁.left ⟶ Ω.W'.left)
    (hb₁ : b₁ ≫ Ω.W'.hom = T₁.hom ≫ lam)
    (M₁ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (hM₁ : wcPfamLineCmp π Ω lam β T₁ a₁ b₁ hb₁ M₁) :
    ∃ (σ' : Ω.W' ⟶ Ω.W') (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      σ' ≫ Ω.w' = Ω.w' ∧ wcPfamFrame Ω σ' g' ∧ ∀ x, M₁ x = g' (M₀ x) :=
by
  classical

  have hSpecConn : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
    intro R _
    have hne : Nonempty (Spec R) := ⟨IsLocalRing.closedPoint R⟩
    have hpre : PreconnectedSpace (Spec R) := by
      rw [preconnectedSpace_iff_clopen]
      intro s hs
      by_cases hc : IsLocalRing.closedPoint R ∈ s
      · right
        have h1 := (IsLocalRing.closedPoint_mem_iff
          (⟨s, hs.isOpen⟩ : TopologicalSpace.Opens (PrimeSpectrum R))).mp hc
        exact congrArg SetLike.coe h1
      · left
        have h1 := (IsLocalRing.closedPoint_mem_iff
          (⟨sᶜ, hs.isClosed.isOpen_compl⟩ : TopologicalSpace.Opens (PrimeSpectrum R))).mp hc
        have h2 : sᶜ = Set.univ := congrArg SetLike.coe h1
        exact Set.compl_univ_iff.mp h2
    exact { toPreconnectedSpace := hpre, toNonempty := hne }

  have hconnField : ∀ (Tx : Scheme.{u}) (L : Type u) [Field L] (eL : Tx ≅ Spec (.of L)),
      ConnectedSpace Tx := by
    intro Tx L _ eL
    have hsub : ∀ x y : Tx, x = y := by
      intro x y
      have h1 : eL.hom x = eL.hom y :=
        @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
      have hx : eL.inv (eL.hom x) = x := by simp
      have hy : eL.inv (eL.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    haveI : Nonempty Tx := ⟨eL.inv (IsLocalRing.closedPoint L)⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun x _ y _ => hsub x y)⟩

  have hR : ∀ {S : Scheme.{u}} (X₀ X₁ B : S.ProEt) (x₀ : X₀ ⟶ B) (x₁ : X₁ ⟶ B)
      (y : ↥(Limits.pullback x₀.left x₁.left)),
      ∃ (E : S.ProEt) (v₀ : E ⟶ X₀) (v₁ : E ⟶ X₁), v₀ ≫ x₀ = v₁ ≫ x₁ ∧ ConnectedSpace E.left ∧
        ∀ (Rg : CommRingCat.{u}) [IsLocalRing Rg]
          (φ : Spec Rg ⟶ Limits.pullback x₀.left x₁.left),
          φ (IsLocalRing.closedPoint Rg) = y →
          ∃ ψ : Spec Rg ⟶ E.left, ψ ≫ v₀.left = φ ≫ Limits.pullback.fst x₀.left x₁.left ∧
            ψ ≫ v₁.left = φ ≫ Limits.pullback.snd x₀.left x₁.left := by
    intro S X₀ X₁ B x₀ x₁ y
    have hx₁ : WeaklyEtale x₁.left := by
      have h1 : WeaklyEtale (x₁.left ≫ B.hom) := by
        rw [MorphismProperty.Over.w x₁]; exact X₁.prop
      haveI : WeaklyEtale B.hom := B.prop
      exact WeaklyEtale.of_comp x₁.left B.hom
    have hfst : WeaklyEtale (Limits.pullback.fst x₀.left x₁.left) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hx₁
    have hj := wc_fromSpecStalk_weaklyEtale (Limits.pullback x₀.left x₁.left) y
    have hE : WeaklyEtale ((Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
        Limits.pullback.fst x₀.left x₁.left ≫ X₀.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hj
        (@MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hfst X₀.prop)
    refine ⟨MorphismProperty.Over.mk ⊤ _ hE,
      MorphismProperty.Over.homMk ((Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
        Limits.pullback.fst x₀.left x₁.left) (Category.assoc _ _ _) trivial,
      MorphismProperty.Over.homMk ((Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
        Limits.pullback.snd x₀.left x₁.left) ?_ trivial, ?_, ?_, ?_⟩
    · have h1 := MorphismProperty.Over.w x₀
      have h2 := MorphismProperty.Over.w x₁
      calc ((Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
            Limits.pullback.snd x₀.left x₁.left) ≫ X₁.hom
          = (Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
            Limits.pullback.snd x₀.left x₁.left ≫ x₁.left ≫ B.hom := by
            rw [h2, Category.assoc]
        _ = (Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
            Limits.pullback.fst x₀.left x₁.left ≫ x₀.left ≫ B.hom := by
            rw [Limits.pullback.condition_assoc]
        _ = (Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
            Limits.pullback.fst x₀.left x₁.left ≫ X₀.hom := by rw [h1]
    · apply MorphismProperty.Over.Hom.ext
      change ((Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
          Limits.pullback.fst x₀.left x₁.left) ≫ x₀.left =
        ((Limits.pullback x₀.left x₁.left).fromSpecStalk y ≫
          Limits.pullback.snd x₀.left x₁.left) ≫ x₁.left
      rw [Category.assoc, Category.assoc, Limits.pullback.condition]
    · exact hSpecConn ((Limits.pullback x₀.left x₁.left).presheaf.stalk y)
    · intro Rg _ φ hφ
      subst hφ
      refine ⟨Spec.map (Scheme.stalkClosedPointTo φ), ?_, ?_⟩
      · show Spec.map (Scheme.stalkClosedPointTo φ) ≫
          ((Limits.pullback x₀.left x₁.left).fromSpecStalk (φ (IsLocalRing.closedPoint Rg)) ≫
            Limits.pullback.fst x₀.left x₁.left) = _
        rw [← Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
      · show Spec.map (Scheme.stalkClosedPointTo φ) ≫
          ((Limits.pullback x₀.left x₁.left).fromSpecStalk (φ (IsLocalRing.closedPoint Rg)) ≫
            Limits.pullback.snd x₀.left x₁.left) = _
        rw [← Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk]

  have hnat : ∀ (S : Scheme.{u}) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (W : S.ProEt) (k : ℕ) (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
      (Tb Ta : S.ProEt) (f : Ta ⟶ Tb) (a : Tb ⟶ W) (x : G.obj.obj (Opposite.op Tb))
      (t : Ta.left),
      (show C(↥Ta.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ a)))).hom
          ((G.obj.map f.op).hom x)).down) t =
      (show C(↥Tb.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) (f.left t) := by
    intro S G W k θ Tb Ta f a x t
    have hn := θ.hom.hom.naturality (Over.homMk f rfl : Over.mk (f ≫ a) ⟶ Over.mk a).op
    have h2 := congrArg (fun m => m.hom x) hn
    exact congrArg (fun y : ULift.{u+1} C(↥Ta.left, Fin k → ℚ_[ℓ]) => y.down t) h2

  have hRef : ∀ (Tb Ta : (wcP1Over F'').left.ProEt) (f : Ta ⟶ Tb) (a : Tb ⟶ π.W)
      (b : Tb.left ⟶ Ω.W'.left) (hb : b ≫ Ω.W'.hom = Tb.hom ≫ lam)
      (M : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamLineCmp π Ω lam β Tb a b hb M → ConnectedSpace Ta.left →
      ∀ hb' : (f.left ≫ b) ≫ Ω.W'.hom = Ta.hom ≫ lam,
      wcPfamLineCmp π Ω lam β Ta (f ≫ a) (f.left ≫ b) hb' M := by
    intro Tb Ta f a b hb M hM hTa hb'
    refine ⟨hTa, ?_, ?_⟩
    · exact (Category.assoc f.left a.left _).trans ((congrArg (fun k => f.left ≫ k)
        hM.2.1).trans (Category.assoc _ _ _).symm)
    · intro s t
      have e1 := hM.2.2 s (f.left t)
      have e3 := hnat (wcP1Over F'').left (wcRq D.f ℓ (n - 1)) π.W π.r π.θ Tb Ta f a
        (β Ω.W' Tb b hb s) t
      rw [hβ.1 Ω.W' Tb Ta f b hb hb' s] at e3
      exact e1.trans (congrArg M e3.symm)

  have hcancel2 : ∀ (T : Over Ω.W')
      (c : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op T)),
      (Ω.θ'.hom.hom.app (Opposite.op T)).hom ((Ω.θ'.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) Ω.θ'.inv_hom_id
  have hconst : ∀ v : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W'),
      ∀ z : Ω.W'.left, (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 Ω.W')) c
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) hs

  have core : ∀ (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L]
      (e : T.left ≅ Spec (.of L)) (a : T ⟶ π.W) (c₀ c₁ : T.left ⟶ Ω.W'.left)
      (hc₀ : c₀ ≫ Ω.W'.hom = T.hom ≫ lam) (hc₁ : c₁ ≫ Ω.W'.hom = T.hom ≫ lam),
      wcPfamLineCmp π Ω lam β T a c₀ hc₀ M₀ → wcPfamLineCmp π Ω lam β T a c₁ hc₁ M₁ →
      ∃ (σ' : Ω.W' ⟶ Ω.W') (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        σ' ≫ Ω.w' = Ω.w' ∧ wcPfamFrame Ω σ' g' ∧ ∀ x, M₁ x = g' (M₀ x) := by
    intro T L _ e a c₀ c₁ hc₀ hc₁ hC₀ hC₁
    have hw' : Ω.w'.left ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = Ω.W'.hom :=
      MorphismProperty.Over.w Ω.w'
    have hbb : c₀ ≫ Ω.w'.left = c₁ ≫ Ω.w'.left := by
      refine Limits.pullback.hom_ext (f := (Over.mk (wcProjKStr F'' M')).hom)
        (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ?_ ?_
      · exact (Category.assoc _ _ _).trans ((congrArg (fun k => c₀ ≫ k) hw').trans
          (hc₀.trans (hc₁.symm.trans ((congrArg (fun k => c₁ ≫ k) hw').symm.trans
            (Category.assoc _ _ _).symm))))
      · exact (Category.assoc _ _ _).trans (hC₀.2.1.symm.trans (hC₁.2.1.trans
          (Category.assoc _ _ _).symm))

    obtain ⟨E, v₀', v₁', hv', hEc, hfac⟩ := hR (S := wcProjK F'' M') Ω.W' Ω.W' _ Ω.w' Ω.w'
      ((e.inv ≫ Limits.pullback.lift c₀ c₁ hbb) (IsLocalRing.closedPoint L))
    obtain ⟨σ', hσ', hσeq⟩ := Ω.hgal' E v₀' v₁' hEc hv'
    obtain ⟨ψ, hψ₀, hψ₁⟩ := hfac (CommRingCat.of L) (e.inv ≫ Limits.pullback.lift c₀ c₁ hbb) rfl
    have q0 : ψ ≫ v₀'.left = e.inv ≫ c₀ := by
      rw [hψ₀, Category.assoc, Limits.pullback.lift_fst]
    have q1 : ψ ≫ v₁'.left = e.inv ≫ c₁ := by
      rw [hψ₁, Category.assoc, Limits.pullback.lift_snd]
    have q2 : ψ ≫ v₀'.left ≫ σ'.left = e.inv ≫ c₁ := by
      rw [← q1, hσeq]
      rfl
    rw [← Category.assoc, q0, Category.assoc] at q2
    have hc : c₁ = c₀ ≫ σ'.left := ((cancel_epi e.inv).mp q2).symm

    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
      Ω.hconn' Ω.r' Ω.θ' σ'
    have hFr : wcPfamFrame Ω σ' A := fun s z =>
      hA Ω.W' (𝟙 Ω.W') σ' (Category.id_comp σ').symm s z
    subst hc

    have hshift : ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')) (t : T.left),
        (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down)
            ((c₀ ≫ σ'.left) t) =
        A (M₀ ((show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk a))).hom
            (β Ω.W' T (c₀ ≫ σ'.left) hc₁ s)).down) t)) := by
      intro s t
      have e3 := hnat (wcProjK F'' M') (wcRq h ℓ (n - 1)) Ω.W' Ω.r' Ω.θ' Ω.W' Ω.W' σ' (𝟙 Ω.W')
        s (c₀ t)
      rw [Category.comp_id] at e3
      have e4 := hC₀.2.2 (((wcRq h ℓ (n - 1)).obj.map σ'.op).hom s) t
      rw [hβ.2.1 Ω.W' Ω.W' σ' T c₀ hc₀ hc₁ s] at e4
      exact e3.symm.trans ((hFr (((wcRq h ℓ (n - 1)).obj.map σ'.op).hom s) (c₀ t)).trans
        (congrArg A e4))

    refine ⟨σ', A, hσ', hFr, fun x => ?_⟩
    obtain ⟨s, hs⟩ := hconst (M₁ x)
    have t₀ : T.left := e.inv (IsLocalRing.closedPoint L)
    have k1 := hC₁.2.2 s t₀
    have k2 := hshift s t₀
    rw [hs] at k1 k2
    have hu := M₁.injective k1
    rw [← hu] at k2
    exact k2

  obtain ⟨T₀', f₀, L₀, _, _, ⟨e₀⟩⟩ := wc_pfam_lms_sep_field_point F'' T₀ hM₀.1
  obtain ⟨T₁', f₁, L₁, _, _, ⟨e₁⟩⟩ := wc_pfam_lms_sep_field_point F'' T₁ hM₁.1

  have hpt := wc_pcl_sep_points_coincide F'' hP D.m D.S D.hS π.W π.w π.hqc π.hconn π.hoff
    π.hcov hgal T₀' T₁' L₀ L₁ e₀ e₁ (f₀ ≫ a₀) (f₁ ≫ a₁)

  obtain ⟨y, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := (f₀ ≫ a₀).left)
    (g := (f₁ ≫ a₁).left) _ _ hpt
  obtain ⟨E₂, v₀, v₁, hv, hE₂, -⟩ := hR T₀' T₁' π.W (f₀ ≫ a₀) (f₁ ≫ a₁) y
  obtain ⟨T, f₂, L, _, _, ⟨e⟩⟩ := wc_pfam_lms_sep_field_point F'' E₂ hE₂
  have hT : ConnectedSpace T.left := hconnField T.left L e
  have ha : (f₂ ≫ v₀ ≫ f₀) ≫ a₀ = (f₂ ≫ v₁ ≫ f₁) ≫ a₁ := by
    simp only [Category.assoc]
    rw [hv]
  have hOw : ∀ {X₁ Y₁ : (wcP1Over F'').left.ProEt} (g : X₁ ⟶ Y₁), g.left ≫ Y₁.hom = X₁.hom :=
    fun g => MorphismProperty.Over.w g
  have hb₀' : ((f₂ ≫ v₀ ≫ f₀).left ≫ b₀) ≫ Ω.W'.hom = T.hom ≫ lam := by
    rw [Category.assoc, hb₀, ← Category.assoc]
    exact congrArg (fun k => k ≫ lam) (hOw (f₂ ≫ v₀ ≫ f₀))
  have hb₁' : ((f₂ ≫ v₁ ≫ f₁).left ≫ b₁) ≫ Ω.W'.hom = T.hom ≫ lam := by
    rw [Category.assoc, hb₁, ← Category.assoc]
    exact congrArg (fun k => k ≫ lam) (hOw (f₂ ≫ v₁ ≫ f₁))

  have H₀ := hRef T₀ T (f₂ ≫ v₀ ≫ f₀) a₀ b₀ hb₀ M₀ hM₀ hT hb₀'
  have H₁ := hRef T₁ T (f₂ ≫ v₁ ≫ f₁) a₁ b₁ hb₁ M₁ hM₁ hT hb₁'
  rw [ha] at H₀

  exact core T L e ((f₂ ≫ v₁ ≫ f₁) ≫ a₁) _ _ hb₀' hb₁' H₀ H₁

theorem wc_pfam_line_rebase (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (β : wcPfamLineBeta D ℓ h lam) (hβ : wcPfamLineBC π Ω lam β)
    (T₀ : (wcP1Over F'').left.ProEt) (a₀ : T₀ ⟶ π.W) (b₀ : T₀.left ⟶ Ω.W'.left)
    (hb₀ : b₀ ≫ Ω.W'.hom = T₀.hom ≫ lam)
    (M₀ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (hM₀ : wcPfamLineCmp π Ω lam β T₀ a₀ b₀ hb₀ M₀)
    (T₁ : (wcP1Over F'').left.ProEt) (a₁ : T₁ ⟶ π.W) (b₁ : T₁.left ⟶ Ω.W'.left)
    (hb₁ : b₁ ≫ Ω.W'.hom = T₁.hom ≫ lam)
    (M₁ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (hM₁ : wcPfamLineCmp π Ω lam β T₁ a₁ b₁ hb₁ M₁) :
    ∃ κ : Ω.W' ⟶ Ω.W', κ ≫ Ω.w' = Ω.w' ∧
      ∀ (V T : (wcProjK F'' M').ProEt) (u : T ⟶ V) (c : T ⟶ Ω.W')
        (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
        (M₁.toLinearMap ∘ₗ g ∘ₗ M₁.symm.toLinearMap) ∈ wcPfamInertFr Ω u c ↔
          (M₀.toLinearMap ∘ₗ g ∘ₗ M₀.symm.toLinearMap) ∈ wcPfamInertFr Ω u (c ≫ κ) :=
by
  classical
  obtain ⟨σ₁, g₁, hσ₁, hFr₁, hM⟩ := wc_pfam_line_cmp_orbit F' F'' Y n hn hn2 D ℓ hℓ hP π hgal
    M' Xu h Δ lam p hH hPP Ω β hβ T₀ a₀ b₀ hb₀ M₀ hM₀ T₁ a₁ b₁ hb₁ M₁ hM₁

  have hcancel2 : ∀ (T : Over Ω.W')
      (c : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op T)),
      (Ω.θ'.hom.hom.app (Opposite.op T)).hom ((Ω.θ'.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) Ω.θ'.inv_hom_id
  obtain ⟨z₀⟩ : Nonempty Ω.W'.left := @ConnectedSpace.toNonempty _ _ Ω.hconn'
  have hconst : ∀ v : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W'),
      ∀ z : Ω.W'.left, (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 Ω.W')) c
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) hs

  have huniq : ∀ (σ : Ω.W' ⟶ Ω.W') (k₁ k₂ : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamFrame Ω σ k₁ → wcPfamFrame Ω σ k₂ → ∀ v, k₁ v = k₂ v := by
    intro σ k₁ k₂ h₁ h₂ v
    obtain ⟨s, hs⟩ := hconst v
    exact (congrArg k₁ (hs z₀)).symm.trans ((h₁ s z₀).symm.trans ((h₂ s z₀).trans
      (congrArg k₂ (hs z₀))))
  have hEx : ∀ σ : Ω.W' ⟶ Ω.W', ∃ k : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
      wcPfamFrame Ω σ k := by
    intro σ
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
      Ω.hconn' Ω.r' Ω.θ' σ
    exact ⟨A, fun s z => hA Ω.W' (𝟙 Ω.W') σ (Category.id_comp σ).symm s z⟩
  have hComp : ∀ (a b : Ω.W' ⟶ Ω.W')
      (ga gb : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamFrame Ω a ga → wcPfamFrame Ω b gb → wcPfamFrame Ω (a ≫ b) (gb ∘ₗ ga) := by
    intro a b ga gb ha hb s z
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
      Ω.hconn' Ω.r' Ω.θ' b
    have hAb : ∀ v, A v = gb v := by
      intro v
      obtain ⟨t, ht⟩ := hconst v
      have e1 := hA Ω.W' (𝟙 Ω.W') b (Category.id_comp b).symm t z₀
      exact (congrArg A (ht z₀)).symm.trans (e1.symm.trans ((hb t z₀).trans
        (congrArg gb (ht z₀))))
    have e2 := hA Ω.W' a (a ≫ b) rfl s z
    exact e2.trans ((hAb _).trans (congrArg gb (ha s z)))
  have hId : wcPfamFrame Ω (𝟙 Ω.W') LinearMap.id := fun s z => rfl

  obtain ⟨ρ, hρ, h1⟩ := Ω.hgal' Ω.W' σ₁ (𝟙 Ω.W') Ω.hconn' (by rw [hσ₁, Category.id_comp])
  obtain ⟨ρ', hρ', h1'⟩ := Ω.hgal' Ω.W' ρ (𝟙 Ω.W') Ω.hconn' (by rw [hρ, Category.id_comp])
  have hσρ' : σ₁ = ρ' := by
    calc σ₁ = σ₁ ≫ 𝟙 _ := (Category.comp_id _).symm
      _ = σ₁ ≫ ρ ≫ ρ' := by rw [h1']
      _ = (σ₁ ≫ ρ) ≫ ρ' := (Category.assoc _ _ _).symm
      _ = ρ' := by rw [← h1, Category.id_comp]
  have h2 : ρ ≫ σ₁ = 𝟙 Ω.W' := by rw [hσρ']; exact h1'.symm
  obtain ⟨gρ, hFrρ⟩ := hEx ρ
  have inv1 : ∀ x, gρ (g₁ x) = x := fun x =>
    huniq (σ₁ ≫ ρ) (gρ ∘ₗ g₁) LinearMap.id (hComp _ _ _ _ hFr₁ hFrρ) (by rw [← h1]; exact hId) x
  have inv2 : ∀ x, g₁ (gρ x) = x := fun x =>
    huniq (ρ ≫ σ₁) (g₁ ∘ₗ gρ) LinearMap.id (hComp _ _ _ _ hFrρ hFr₁) (by rw [h2]; exact hId) x

  have hsymm : ∀ y, M₁.symm y = M₀.symm (gρ y) := by
    intro y
    apply M₁.injective
    rw [LinearEquiv.apply_symm_apply, hM, LinearEquiv.apply_symm_apply, inv2]
  have hconjEq : ∀ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      M₁.toLinearMap ∘ₗ g ∘ₗ M₁.symm.toLinearMap =
        g₁ ∘ₗ (M₀.toLinearMap ∘ₗ g ∘ₗ M₀.symm.toLinearMap) ∘ₗ gρ := by
    intro g
    apply LinearMap.ext
    intro y
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [hsymm, hM]
  refine ⟨ρ, hρ, ?_⟩
  intro V T u c g
  rw [hconjEq g]
  constructor
  · rintro ⟨τ, σ, hτu, hσ, hτc, hFr⟩
    refine ⟨τ, σ₁ ≫ σ ≫ ρ, hτu, ?_, ?_, ?_⟩
    · simp only [Category.assoc, hρ, hσ, hσ₁]
    · calc τ ≫ c ≫ ρ = (τ ≫ c) ≫ ρ := (Category.assoc _ _ _).symm
        _ = c ≫ σ ≫ ρ := by rw [hτc, Category.assoc]
        _ = (c ≫ ρ) ≫ σ₁ ≫ σ ≫ ρ := by
          rw [Category.assoc, ← Category.assoc ρ σ₁, h2, Category.id_comp]
    · have e := hComp _ _ _ _ hFr₁ (hComp _ _ _ _ hFr hFrρ)
      intro s z
      refine (e s z).trans ?_
      simp only [LinearMap.comp_apply, inv1]
  · rintro ⟨τ, σ, hτu, hσ, hτc, hFr⟩
    refine ⟨τ, ρ ≫ σ ≫ σ₁, hτu, ?_, ?_, ?_⟩
    · simp only [Category.assoc, hσ₁, hσ, hρ]
    · calc τ ≫ c = τ ≫ c ≫ 𝟙 _ := by rw [Category.comp_id]
        _ = τ ≫ c ≫ ρ ≫ σ₁ := by rw [h2]
        _ = (τ ≫ c ≫ ρ) ≫ σ₁ := by simp only [Category.assoc]
        _ = ((c ≫ ρ) ≫ σ) ≫ σ₁ := by rw [hτc]
        _ = c ≫ ρ ≫ σ ≫ σ₁ := by simp only [Category.assoc]
    · have e := hComp _ _ _ _ hFrρ (hComp _ _ _ _ hFr hFr₁)
      intro s z
      refine (e s z).trans ?_
      simp only [LinearMap.comp_apply]

theorem wc_yjl_olivier_section : ∀ {Q X : Scheme.{u}} (f : Q ⟶ X), WeaklyEtale f →
    ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
      (eX : X ≅ Spec (.of R)) (q : Q), f q = eX.inv (IsLocalRing.closedPoint R) →
      ∃ s : X ⟶ Q, s ≫ f = 𝟙 X ∧ s (eX.inv (IsLocalRing.closedPoint R)) = q ∧
        ∀ (K : Type u) [Field K] (t : Spec (.of K) ⟶ Q), t (IsLocalRing.closedPoint K) = q →
          t ≫ f ≫ s = t :=
by
  intro Q X f hf R _ _ _ eX q hq
  haveI : WeaklyEtale f := hf
  haveI : WeaklyEtale (Q.fromSpecStalk q) := wc_fromSpecStalk_weaklyEtale Q q
  obtain ⟨k, hkdef⟩ : ∃ k, k = Q.fromSpecStalk q ≫ f ≫ eX.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have h2 : ∀ y : Spec (CommRingCat.of R), eX.hom (eX.inv y) = y := by
    intro y
    first
      | simp
      | (rw [← Scheme.Hom.comp_apply, eX.inv_hom_id]; rfl)
      | exact congrArg (fun g : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of R) => g y)
          eX.inv_hom_id
  have hk_pt : k (IsLocalRing.closedPoint (Q.presheaf.stalk q)) =
      IsLocalRing.closedPoint R := by
    have h1 : k (IsLocalRing.closedPoint (Q.presheaf.stalk q)) =
        eX.hom (f (Q.fromSpecStalk q (IsLocalRing.closedPoint (Q.presheaf.stalk q)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    rw [h1, Scheme.fromSpecStalk_closedPoint, hq]
    exact h2 _
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint (Q.presheaf.stalk q)) = IsLocalRing.closedPoint R := by
    have h5 : (Spec.map (Spec.preimage k)) (IsLocalRing.closedPoint (Q.presheaf.stalk q)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint (Q.presheaf.stalk q)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance
  have hcq : Q.fromSpecStalk q ≫ f = k ≫ eX.inv := by
    rw [hkdef]; simp
  have hkey : Q.fromSpecStalk q ≫ f ≫ (eX.hom ≫ inv k ≫ Q.fromSpecStalk q) =
      Q.fromSpecStalk q := by
    rw [← Category.assoc, hcq, Category.assoc, Iso.inv_hom_id_assoc, IsIso.hom_inv_id_assoc]
  refine ⟨eX.hom ≫ inv k ≫ Q.fromSpecStalk q, ?_, ?_, ?_⟩
  · rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]
  · have e1 : (inv k) (IsLocalRing.closedPoint R) =
        IsLocalRing.closedPoint (Q.presheaf.stalk q) := by
      rw [← hk_pt]
      first
        | exact Scheme.hom_inv_apply k _
        | exact congrArg (fun g : Spec (Q.presheaf.stalk q) ⟶ Spec (Q.presheaf.stalk q) =>
            g (IsLocalRing.closedPoint (Q.presheaf.stalk q))) (IsIso.hom_inv_id k)
        | simp
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    first
      | exact (congrArg (fun y => Q.fromSpecStalk q ((inv k) y)) (h2 _)).trans
          ((congrArg (fun y => Q.fromSpecStalk q y) e1).trans
            (Scheme.fromSpecStalk_closedPoint (X := Q) (x := q)))
      | (erw [h2, e1]; exact Scheme.fromSpecStalk_closedPoint)
      | (simp only [h2, e1]; exact Scheme.fromSpecStalk_closedPoint)
  · intro K _ t ht
    subst ht
    have ht' := Scheme.Spec_stalkClosedPointTo_fromSpecStalk t
    calc t ≫ f ≫ eX.hom ≫ inv k ≫ Q.fromSpecStalk (t (IsLocalRing.closedPoint K))
        = (Spec.map (Scheme.stalkClosedPointTo t) ≫
            Q.fromSpecStalk (t (IsLocalRing.closedPoint K))) ≫
            f ≫ eX.hom ≫ inv k ≫ Q.fromSpecStalk (t (IsLocalRing.closedPoint K)) := by
          rw [ht']
      _ = Spec.map (Scheme.stalkClosedPointTo t) ≫
            Q.fromSpecStalk (t (IsLocalRing.closedPoint K)) := by
          rw [Category.assoc, hkey]
      _ = t := ht'

theorem wc_yjl_closed_strict_hull_surj : ∀ {X Z : Scheme.{u}} (i : X ⟶ Z) [IsClosedImmersion i]
    (A : Type u) [CommRing A] [HenselianLocalRing A] (w : Spec (.of A) ⟶ X), WeaklyEtale w →
    ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
      (σ : Z.presheaf.stalk ((w ≫ i) (IsLocalRing.closedPoint A)) →+* R) (ρ : R →+* A),
      wcIndEtale σ → IsLocalHom ρ → ρ.comp σ = (Scheme.stalkClosedPointTo (w ≫ i)).hom →
      Function.Surjective ρ :=
by
  intro X Z i _ A _ _ w hw R _ _ _ σ ρ hσ hρ hcomp
  have hσW : @Algebra.WeaklyEtale _ _ _ _ σ.toAlgebra := wc_indEtale_weaklyEtale σ hσ

  have key : ∀ (S O : Type u) [CommRing S] [CommRing O] (π : S →+* O) (g : O →+* A)
      (σ : S →+* R), Function.Surjective π → @Algebra.WeaklyEtale S R _ _ σ.toAlgebra →
      @Algebra.WeaklyEtale O A _ _ g.toAlgebra → ρ.comp σ = g.comp π →
      Function.Surjective ρ := by
    intro S O _ _ π g σ hπ hσW hgW hc
    letI : Algebra S O := π.toAlgebra
    letI : Algebra S R := σ.toAlgebra
    letI : Algebra S A := (ρ.comp σ).toAlgebra
    let f₂ : R →ₐ[S] A := { ρ with commutes' := fun s => rfl }
    let f₁ : O →ₐ[S] A := { g with commutes' := fun s => (RingHom.congr_fun hc s).symm }
    let Φa := Algebra.TensorProduct.productMap f₁ f₂
    have hsurjR : Function.Surjective
        (Algebra.TensorProduct.includeRight : R →ₐ[S] TensorProduct S O R) :=
      Algebra.TensorProduct.includeRight_surjective R hπ
    have hΦr : ∀ r : R, Φa (1 ⊗ₜ[S] r) = ρ r := fun r =>
      Algebra.TensorProduct.productMap_right_apply f₁ f₂ r
    have hΦl : ∀ o : O, Φa (o ⊗ₜ[S] 1) = g o := fun o =>
      Algebra.TensorProduct.productMap_left_apply f₁ f₂ o
    haveI : Nontrivial (TensorProduct S O R) := RingHom.domain_nontrivial Φa.toRingHom

    let q : R →+* TensorProduct S O R :=
      (Algebra.TensorProduct.includeRight : R →ₐ[S] TensorProduct S O R).toRingHom
    have hq : Function.Surjective q := hsurjR
    have hker : RingHom.ker q ≠ ⊤ := by
      intro h
      have h1 : (1 : R) ∈ RingHom.ker q := h ▸ Submodule.mem_top
      rw [RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    obtain ⟨h₀, hs₀⟩ := wc_quot_strictly_henselian_of_ne_top R (RingHom.ker q) hker
    let e := RingHom.quotientKerEquivOfSurjective hq
    have hT : HenselianLocalRing (TensorProduct S O R) :=
      wc_henselian_sepClosed_transfer.1 _ _ e h₀
    letI : IsLocalRing (TensorProduct S O R) := hT.toIsLocalRing
    letI : IsLocalRing (R ⧸ RingHom.ker q) := h₀.toIsLocalRing
    have hTs : IsSepClosed (IsLocalRing.ResidueField (TensorProduct S O R)) :=
      wc_henselian_sepClosed_transfer.2 _ _ (IsLocalRing.ResidueField.mapEquiv e) hs₀

    have hΦloc : IsLocalHom Φa.toRingHom := IsLocalHom.mk (fun t ht => by
      obtain ⟨r, rfl⟩ := hsurjR t
      change IsUnit (Φa (Algebra.TensorProduct.includeRight r)) at ht
      rw [Algebra.TensorProduct.includeRight_apply, hΦr] at ht
      exact (isUnit_of_map_unit ρ r ht).map _)

    letI : Algebra O A := g.toAlgebra
    letI : Algebra (TensorProduct S O R) A := Φa.toRingHom.toAlgebra
    haveI : IsScalarTower O (TensorProduct S O R) A := IsScalarTower.of_algebraMap_eq (fun o => by
      show g o = Φa (algebraMap O (TensorProduct S O R) o)
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      exact (hΦl o).symm)
    haveI := hσW
    have hOT : Algebra.WeaklyEtale O (TensorProduct S O R) := inferInstance
    have hTA : Algebra.WeaklyEtale (TensorProduct S O R) A :=
      wc_weaklyEtale_cancel O _ A hOT hgW
    have hloc : IsLocalHom (algebraMap (TensorProduct S O R) A) := hΦloc
    have hbij := wc_olivier (TensorProduct S O R) A hT hTs hloc hTA
    intro a
    obtain ⟨t, ht⟩ := hbij.2 a
    obtain ⟨r, rfl⟩ := hsurjR t
    refine ⟨r, ?_⟩
    rw [← ht]
    show ρ r = Φa (Algebra.TensorProduct.includeRight r)
    rw [Algebra.TensorProduct.includeRight_apply, hΦr]

  have hgW : @Algebra.WeaklyEtale (X.presheaf.stalk (w (IsLocalRing.closedPoint A))) A _ _
      (Scheme.stalkClosedPointTo w).hom.toAlgebra := by
    haveI := wc_fromSpecStalk_weaklyEtale X (w (IsLocalRing.closedPoint A))
    haveI : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo w) ≫
        X.fromSpecStalk (w (IsLocalRing.closedPoint A))) := by
      rw [Scheme.Spec_stalkClosedPointTo_fromSpecStalk]; exact hw
    have h3 : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo w)) :=
      WeaklyEtale.of_comp _ (X.fromSpecStalk (w (IsLocalRing.closedPoint A)))
    exact wc_lpkt_specMap_weaklyEtale_ring _ _ _ h3
  have hκ : (Scheme.stalkClosedPointTo (w ≫ i)).hom =
      (Scheme.stalkClosedPointTo w).hom.comp (i.stalkMap (w (IsLocalRing.closedPoint A))).hom := by
    first
      | exact (congrArg CommRingCat.Hom.hom (Scheme.stalkClosedPointTo_comp w i)).trans
          (CommRingCat.hom_comp _ _)
      | (rw [Scheme.stalkClosedPointTo_comp]; rfl)
  exact key (Z.presheaf.stalk ((w ≫ i) (IsLocalRing.closedPoint A)))
    (X.presheaf.stalk (w (IsLocalRing.closedPoint A)))
    (i.stalkMap (w (IsLocalRing.closedPoint A))).hom (Scheme.stalkClosedPointTo w).hom σ
    (Scheme.Hom.stalkMap_surjective i (w (IsLocalRing.closedPoint A))) hσW hgW (hcomp.trans hκ)

theorem wc_pfam_yj_local_nbhds (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (M' : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (hlam : IsClosedImmersion lam)
    (hlamstr : lam ≫ wcProjKStr F'' M' = (wcP1Over F'').hom)
    (Δ : Set (wcProjK F'' M')) (hΔ : IsClosed Δ) (m : ℕ)
    (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ t : (wcP1Over F'').left, lam t ∈ Δ ↔ ∃ i, t = S i (IsLocalRing.closedPoint F''))
    (j : Fin m) (V : (wcP1Over F'').left.ProEt)
    (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = S j (IsLocalRing.closedPoint F''))
    (T : (wcP1Over F'').left.ProEt) (u : T ⟶ V)
    (L : Type u) [Field L] [IsSepClosed L] (eL : T.left ≅ Spec (.of L))
    (hT : ∀ (z : T.left) (i : Fin m), T.hom z ≠ S i (IsLocalRing.closedPoint F'')) :
    ∃ (Vy Vx Ty : (wcProjK F'' M').ProEt)
      (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
      (vx : Vx ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
      (uyx : Vx ⟶ Vy) (uy' : Ty ⟶ Vx)
      (Ay : Type u) (_ : CommRing Ay) (_ : HenselianLocalRing Ay)
      (_ : IsSepClosed (IsLocalRing.ResidueField Ay)) (ey : Vy.left ≅ Spec (.of Ay))
      (Ax : Type u) (_ : CommRing Ax) (_ : HenselianLocalRing Ax)
      (_ : IsSepClosed (IsLocalRing.ResidueField Ax)) (ex : Vx.left ≅ Spec (.of Ax))
      (Ly : Type u) (_ : Field Ly) (_ : IsSepClosed Ly) (eLy : Ty.left ≅ Spec (.of Ly))
      (tx : T.left ⟶ Vx.left),
      uyx ≫ vy = vx ∧
      Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (S j (IsLocalRing.closedPoint F'')) ∧
      tx ≫ Vx.hom = T.hom ≫ lam ∧
      tx ≫ vx.left ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        u.left ≫ v.left ≫ Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ∧
      (∀ z : Vx.left, Vx.hom z ∉ Δ) ∧
      ConnectedSpace Vx.left ∧
      (∀ α : Vx ⟶ Vx, α ≫ uyx = uyx →
        ∃ τ : T ⟶ T, τ ≫ u = u ∧ τ.left ≫ tx = tx ≫ α.left) ∧
      (∀ τ : T ⟶ T, τ ≫ u = u →
        ∃ α : Vx ⟶ Vx, α ≫ uyx = uyx ∧ τ.left ≫ tx = tx ≫ α.left) ∧
      (∀ α : Vx ⟶ Vx, α ≫ uyx = uyx → ∃ τ'' : Ty ⟶ Ty, τ'' ≫ uy' = uy' ≫ α) ∧
      ∃ t₀ : (wcP1Over F'').left, closure {t₀} = Set.univ ∧
        Vx.hom (ex.inv (IsLocalRing.closedPoint Ax)) = lam t₀ :=
by
  classical
  have hProEt : ∀ {Sc : Scheme.{u}} {X Y : Sc.ProEt} (f : X ⟶ Y), WeaklyEtale f.left := by
    intro Sc X Y f
    haveI : WeaklyEtale (f.left ≫ Y.hom) := by rw [MorphismProperty.Over.w f]; exact X.prop
    haveI : WeaklyEtale Y.hom := Y.prop
    exact WeaklyEtale.of_comp f.left Y.hom
  have hsepF : ∀ (K : Type u) [Field K] [IsSepClosed K], IsSepClosed (IsLocalRing.ResidueField K) :=
    fun K _ _ => wc_henselian_sepClosed_transfer.2 K _ (RingEquiv.ofBijective
      (IsLocalRing.residue K) ⟨(IsLocalRing.residue K).injective, IsLocalRing.residue_surjective⟩)
      inferInstance

  have hc7 : ∀ (K : Type u) [Field K] [IsSepClosed K] {Z W' : Scheme.{u}} (eZ : Z ≅ Spec (.of K))
      (t : Z ⟶ W'), WeaklyEtale t → ∀ β : W' ⟶ W',
      β (t (eZ.inv (IsLocalRing.closedPoint K))) = t (eZ.inv (IsLocalRing.closedPoint K)) →
      ∃ τ : Z ⟶ Z, τ ≫ t = t ≫ β := by
    intro K _ _ Z W' eZ t ht β hβ
    haveI := ht
    haveI := hsepF K
    obtain ⟨q, -, hq2⟩ := Scheme.Pullback.exists_preimage_pullback (f := t) (g := t ≫ β)
      (eZ.inv (IsLocalRing.closedPoint K)) (eZ.inv (IsLocalRing.closedPoint K)) hβ.symm
    obtain ⟨s, hs, -, -⟩ := wc_yjl_olivier_section (Limits.pullback.snd t (t ≫ β)) inferInstance
      K eZ q hq2
    refine ⟨s ≫ Limits.pullback.fst _ _, ?_⟩
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]

  obtain ⟨lb, hlbfst, hlbsnd, hlbci⟩ : ∃ lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))),
      lb ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ lam ∧
      lb ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ∧ IsClosedImmersion lb := by
    have h' : lam ≫ (Over.mk (wcProjKStr F'' M')).hom = (wcP1Over F'').hom := hlamstr
    have hsq : (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam) ≫
        (Over.mk (wcProjKStr F'' M')).hom = Limits.pullback.snd _ _ ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
      rw [Category.assoc, h']; exact Limits.pullback.condition
    refine ⟨Limits.pullback.lift _ _ hsq, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _, ?_⟩
    have hout : IsPullback (Limits.pullback.lift _ _ hsq ≫ Limits.pullback.snd _ _)
        (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
        (lam ≫ (Over.mk (wcProjKStr F'' M')).hom) := by
      rw [Limits.pullback.lift_snd, h']
      exact (IsPullback.of_hasPullback _ _).flip
    have hleft := IsPullback.of_right hout (Limits.pullback.lift_fst _ _ _)
      (IsPullback.of_hasPullback _ _).flip
    exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) hleft.flip hlam
  haveI := hlbci
  obtain ⟨vl, hvl⟩ : ∃ f : V.left ⟶ Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))), f = v.left :=
    ⟨v.left, rfl⟩
  haveI hvlWE : WeaklyEtale vl := by rw [hvl]; exact hProEt v
  have hv' : vl ≫ Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = V.hom := by
    rw [hvl]; exact MorphismProperty.Over.w v
  have hvpt : ∀ p, (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (vl p) =
      V.hom p := fun p => congrArg (fun f => f p) hv'
  have hpt : ∀ p, (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (lb p) =
      lam ((Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) p) :=
    fun p => congrArg (fun f => f p) hlbfst
  obtain ⟨ul, hul⟩ : ∃ f : T.left ⟶ V.left, f = u.left := ⟨u.left, rfl⟩
  have hu' : ul ≫ V.hom = T.hom := by rw [hul]; exact MorphismProperty.Over.w u
  have hulWE : WeaklyEtale ul := by rw [hul]; exact hProEt u

  obtain ⟨Ry, _, _, _, γy, hγyWE, hγycp, ι, hιγ, hιci⟩ : ∃ (Ry : Type u) (_ : CommRing Ry)
      (_ : HenselianLocalRing Ry) (_ : IsSepClosed (IsLocalRing.ResidueField Ry))
      (γy : Spec (.of Ry) ⟶ Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))),
      WeaklyEtale γy ∧
      γy (IsLocalRing.closedPoint Ry) = lb (vl (e.inv (IsLocalRing.closedPoint A))) ∧
      ∃ ι : V.left ⟶ Spec (.of Ry), ι ≫ γy = vl ≫ lb ∧ IsClosedImmersion ι := by
    obtain ⟨Ry, _, σy, ρy, _, hρσ, hhy, hsy, hly, hiy⟩ :=
      @wc_strict_hull _ A _ _ (Scheme.stalkClosedPointTo ((e.inv ≫ vl) ≫ lb)).hom.toAlgebra
        _ inferInstance
    have hσloc : IsLocalHom σy := by
      haveI : IsLocalHom (ρy.comp σy) := by
        rw [hρσ]
        exact (inferInstance : IsLocalHom (Scheme.stalkClosedPointTo ((e.inv ≫ vl) ≫ lb)).hom)
      exact isLocalHom_of_comp σy ρy
    haveI := hhy
    haveI := hsy
    refine ⟨Ry, inferInstance, hhy, hsy, Spec.map (CommRingCat.ofHom σy) ≫
      Scheme.fromSpecStalk _ (((e.inv ≫ vl) ≫ lb) (IsLocalRing.closedPoint A)), ?_, ?_,
      e.hom ≫ Spec.map (CommRingCat.ofHom ρy), ?_, ?_⟩
    · letI := σy.toAlgebra
      haveI := wc_indEtale_weaklyEtale σy hiy
      haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom σy)) :=
        wc_lfi_specMap_weaklyEtale _ Ry this
      haveI := wc_fromSpecStalk_weaklyEtale (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
        (((e.inv ≫ vl) ≫ lb) (IsLocalRing.closedPoint A))
      infer_instance
    · have h1 : (Spec.map (CommRingCat.ofHom σy)) (IsLocalRing.closedPoint Ry) =
          IsLocalRing.closedPoint _ := IsLocalRing.comap_closedPoint σy
      have h2 : (Spec.map (CommRingCat.ofHom σy) ≫
          Scheme.fromSpecStalk _ (((e.inv ≫ vl) ≫ lb) (IsLocalRing.closedPoint A)))
            (IsLocalRing.closedPoint Ry) =
          Scheme.fromSpecStalk _ (((e.inv ≫ vl) ≫ lb) (IsLocalRing.closedPoint A))
            ((Spec.map (CommRingCat.ofHom σy)) (IsLocalRing.closedPoint Ry)) := rfl
      rw [h2, h1, Scheme.fromSpecStalk_closedPoint]
      rfl
    · rw [Category.assoc, ← Category.assoc (Spec.map (CommRingCat.ofHom ρy)), ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, hρσ]
      change e.hom ≫ (Spec.map (Scheme.stalkClosedPointTo ((e.inv ≫ vl) ≫ lb)) ≫ _) = _
      rw [Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
    · haveI : WeaklyEtale (e.inv ≫ vl) := inferInstance
      have hsurj := wc_yjl_closed_strict_hull_surj lb A (e.inv ≫ vl) this Ry σy ρy
        hiy hly hρσ
      haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom ρy)) :=
        IsClosedImmersion.spec_of_surjective _ hsurj
      infer_instance
  haveI := hιci
  haveI := hγyWE

  obtain ⟨Rx, _, _, _, gx, tx, hgxWE, htx, htxpt⟩ : ∃ (Rx : Type u) (_ : CommRing Rx)
      (_ : HenselianLocalRing Rx) (_ : IsSepClosed (IsLocalRing.ResidueField Rx))
      (gx : Spec (.of Rx) ⟶ Spec (.of Ry)) (tx : T.left ⟶ Spec (.of Rx)),
      WeaklyEtale gx ∧ tx ≫ gx = ul ≫ ι ∧
      tx (eL.inv (IsLocalRing.closedPoint L)) = IsLocalRing.closedPoint Rx := by
    haveI := hsepF L
    letI algRL : Algebra Ry L := (Spec.preimage (eL.inv ≫ ul ≫ ι)).hom.toAlgebra
    obtain ⟨Rx, _, σx, ρx, _, hρσx, hhx, hsx, hlx, hix⟩ := wc_strict_hull Ry L ‹_›
    haveI := hhx
    refine ⟨Rx, inferInstance, hhx, hsx, Spec.map (CommRingCat.ofHom σx),
      eL.hom ≫ Spec.map (CommRingCat.ofHom ρx), ?_, ?_, ?_⟩
    · letI := σx.toAlgebra
      haveI := wc_indEtale_weaklyEtale σx hix
      exact wc_lfi_specMap_weaklyEtale Ry Rx this
    · rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hρσx]
      change eL.hom ≫ Spec.map (Spec.preimage (eL.inv ≫ ul ≫ ι)) = _
      rw [Spec.map_preimage, Iso.hom_inv_id_assoc]
    · have h1 : eL.hom (eL.inv (IsLocalRing.closedPoint L)) = IsLocalRing.closedPoint L :=
        Subsingleton.elim _ _
      show (Spec.map (CommRingCat.ofHom ρx)) (eL.hom (eL.inv (IsLocalRing.closedPoint L))) = _
      rw [h1]
      exact IsLocalRing.comap_closedPoint ρx
  haveI := hgxWE
  haveI : SmoothOfRelativeDimension M' (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension M')
      (IsPullback.of_hasPullback _ _) (wc_proj_space_smooth F'' M')
  haveI : IsDomain Rx := wc_strictHensel_weaklyEtale_smooth_isDomain (AlgebraicClosure F'')
    (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) M'
    (CommRingCat.of Rx) (gx ≫ γy) inferInstance

  have hpPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := hPP
  obtain ⟨hy, hhy⟩ : ∃ f : Spec (.of Ry) ⟶ wcProjK F'' M',
      f = γy ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := ⟨_, rfl⟩
  have hyWE : WeaklyEtale hy := by rw [hhy]; infer_instance
  have hxWE : WeaklyEtale (gx ≫ hy) := by haveI := hyWE; infer_instance
  let γ : Spec (.of (SeparableClosure (FractionRing Rx))) ⟶ Spec (.of Rx) :=
    Spec.map (CommRingCat.ofHom (algebraMap (FractionRing Rx) (SeparableClosure (FractionRing Rx))))
      ≫ Spec.map (CommRingCat.ofHom (algebraMap Rx (FractionRing Rx)))
  have hγWE : WeaklyEtale γ := by
    haveI := wc_fpe_sepClosure_weaklyEtale (FractionRing Rx)
    haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap Rx (FractionRing Rx)))) :=
      wc_lfi_specMap_weaklyEtale _ _
        (wc_localization_weaklyEtale Rx (FractionRing Rx) (nonZeroDivisors Rx))
    infer_instance
  have hTyWE : WeaklyEtale (γ ≫ gx ≫ hy) := by haveI := hγWE; haveI := hxWE; infer_instance

  let Vy : (wcProjK F'' M').ProEt := MorphismProperty.Over.mk ⊤ hy hyWE
  let vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP :=
    MorphismProperty.Over.homMk γy hhy.symm trivial
  let Vx : (wcProjK F'' M').ProEt := MorphismProperty.Over.mk ⊤ (gx ≫ hy) hxWE
  let uyx : Vx ⟶ Vy := MorphismProperty.Over.homMk gx rfl trivial
  let Ty : (wcProjK F'' M').ProEt := MorphismProperty.Over.mk ⊤ (γ ≫ gx ≫ hy) hTyWE
  let uy' : Ty ⟶ Vx := MorphismProperty.Over.homMk γ rfl trivial
  have hVxhom : Vx.hom = gx ≫ hy := rfl
  have htxι : tx ≫ gx ≫ γy = ul ≫ vl ≫ lb := by
    rw [← Category.assoc, htx, Category.assoc, hιγ]

  have h3' : tx ≫ gx ≫ hy = T.hom ≫ lam := by
    have e := congrArg (· ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) htxι
    simp only [Category.assoc] at e
    have e2 : ul ≫ vl ≫ lb ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = T.hom ≫ lam :=
      (congrArg (fun f => ul ≫ vl ≫ f) hlbfst).trans
        ((congrArg (ul ≫ ·) (Category.assoc vl _ lam).symm).trans
          ((congrArg (fun f => ul ≫ f ≫ lam) hv').trans
            ((Category.assoc ul V.hom lam).symm.trans (congrArg (· ≫ lam) hu'))))
    subst hhy
    exact e.trans e2
  have h3 : tx ≫ Vx.hom = T.hom ≫ lam := h3'

  have h4' : tx ≫ (gx ≫ γy) ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      ul ≫ vl ≫ Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := by
    have e := congrArg (· ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) htxι
    simp only [Category.assoc] at e
    exact ((congrArg (tx ≫ ·) (Category.assoc gx γy _)).trans e).trans
      (congrArg (fun f => ul ≫ vl ≫ f) hlbsnd)
  have hcpVx : (gx ≫ hy) (IsLocalRing.closedPoint Rx) =
      lam (T.hom (eL.inv (IsLocalRing.closedPoint L))) := by
    rw [← htxpt]; exact congrArg (fun f => f (eL.inv (IsLocalRing.closedPoint L))) h3'

  have h5 : ∀ z : Vx.left, Vx.hom z ∉ Δ := by
    intro z hz
    have hsp : (gx ≫ hy) z ⤳ (gx ≫ hy) (IsLocalRing.closedPoint Rx) :=
      (IsLocalRing.specializes_closedPoint (R := Rx) z).map (gx ≫ hy).continuous
    have h1 := hsp.mem_closed hΔ hz
    rw [hcpVx, hS] at h1
    obtain ⟨i, hi⟩ := h1
    exact hT _ i hi
  have hfix : ∀ α : Vx ⟶ Vx, α ≫ uyx = uyx → α.left ≫ gx = gx :=
    fun α h => congrArg (fun f => f.left) h

  have h6' : ∀ al : Spec (.of Rx) ⟶ Spec (.of Rx), al ≫ gx = gx →
      ∃ τ' : T.left ⟶ T.left, τ' ≫ ul = ul ∧ τ' ≫ tx = tx ≫ al := by
    intro al hαg
    have hαcp : al (IsLocalRing.closedPoint Rx) = IsLocalRing.closedPoint Rx :=
      wc_yjl_weaklyEtale_fibre_specializes gx hgxWE (al (IsLocalRing.closedPoint Rx))
        (IsLocalRing.closedPoint Rx)
        (IsLocalRing.specializes_closedPoint (R := Rx) (al (IsLocalRing.closedPoint Rx)))
        (congrArg (fun f => f (IsLocalRing.closedPoint Rx)) hαg)
    have hcondt : ul ≫ ι = tx ≫ gx := htx.symm
    have hcondβ : Limits.pullback.fst ι gx ≫ ι = (Limits.pullback.snd ι gx ≫ al) ≫ gx := by
      rw [Category.assoc, hαg]; exact Limits.pullback.condition
    let tW := Limits.pullback.lift ul tx hcondt
    let β := Limits.pullback.lift (Limits.pullback.fst ι gx) (Limits.pullback.snd ι gx ≫ al) hcondβ
    have htWf : tW ≫ Limits.pullback.fst ι gx = ul := Limits.pullback.lift_fst _ _ _
    have htWs : tW ≫ Limits.pullback.snd ι gx = tx := Limits.pullback.lift_snd _ _ _
    have hβf : β ≫ Limits.pullback.fst ι gx = Limits.pullback.fst ι gx :=
      Limits.pullback.lift_fst _ _ _
    have hβs : β ≫ Limits.pullback.snd ι gx = Limits.pullback.snd ι gx ≫ al :=
      Limits.pullback.lift_snd _ _ _
    have htWWE : WeaklyEtale tW := by
      haveI : WeaklyEtale (tW ≫ Limits.pullback.fst ι gx) := by rw [htWf]; exact hulWE
      exact WeaklyEtale.of_comp tW (Limits.pullback.fst ι gx)
    have hβpt : β (tW (eL.inv (IsLocalRing.closedPoint L))) =
        tW (eL.inv (IsLocalRing.closedPoint L)) := by
      apply (Limits.pullback.snd ι gx).isClosedEmbedding.injective
      have e1 := congrArg (fun f => f (tW (eL.inv (IsLocalRing.closedPoint L)))) hβs
      have e2 := congrArg (fun f => f (eL.inv (IsLocalRing.closedPoint L))) htWs
      simp only [Scheme.Hom.comp_apply] at e1 e2
      rw [e1, e2, htxpt, hαcp]
    obtain ⟨τ', hτ'⟩ := hc7 L eL tW htWWE β hβpt
    refine ⟨τ', ?_, ?_⟩
    · rw [← htWf, ← Category.assoc, hτ', Category.assoc, hβf]
    · rw [← htWs, ← Category.assoc, hτ', Category.assoc, hβs, ← Category.assoc]
  have h6 : ∀ α : Vx ⟶ Vx, α ≫ uyx = uyx →
      ∃ τ : T ⟶ T, τ ≫ u = u ∧ τ.left ≫ tx = tx ≫ α.left := by
    intro α hα
    obtain ⟨τ', hτu, hτx⟩ := h6' α.left (hfix α hα)
    have hτu' : τ' ≫ T.hom = T.hom := by rw [← hu', ← Category.assoc, hτu]
