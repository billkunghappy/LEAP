    let eζ : (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) ⟶ T) ≃+
        (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) ⟶
          DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)) :=
      { toFun := fun f => f ≫ ζ.hom
        invFun := fun g => g ≫ ζ.inv
        left_inv := fun f => by simp
        right_inv := fun g => by simp
        map_add' := fun f g => Preadditive.add_comp _ _ _ _ _ _ }
    let eG := eζ.trans (Fe.symm.trans e0.symm)
    let κ' : H →+ ZMod (ℓ ^ k) := AddMonoidHom.mk' (fun y => eG (κ y)) (fun y y' => by
      simp only [hκ, map_add])
    let ρ' : H →+ ZMod (ℓ ^ k) := eM.toAddMonoidHom.comp ρ
    have hker' : ∀ y, κ' y = 0 ↔ ρ' y = 0 := by
      intro y
      rcases Nat.eq_zero_or_pos k with hk | hk
      · have h2 : ℓ ^ k = 1 := by rw [hk, pow_zero]
        have hs : ∀ z : ZMod (ℓ ^ k), z = 0 := fun z =>
          (ZMod.val_eq_zero z).mp (by have := lt_of_lt_of_eq (ZMod.val_lt z) h2; omega)
        exact ⟨fun _ => hs _, fun _ => hs _⟩
      · show eG (κ y) = 0 ↔ eM (ρ y) = 0
