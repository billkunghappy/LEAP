      refine ⟨θ₀, ?_⟩
      rw [hθ₀]
      letI hExt : HasExt (SheafOfModules.{u+1} (wcEtZModRing Xs (ℓ ^ k))) := HasExt.standard _
      have hunit := (wc_et_zmod_unit_pow_exact Xs ℓ k (Fact.out : ℓ.Prime).pos).1
