    exact isCompact_univ_iff.mp (by rw [← hr]; exact isCompact_range Ub0.ι.continuous)
  haveI : QuasiCompact w.left := hqc
  have hWc : CompactSpace W.left := QuasiCompact.compactSpace_of_compactSpace w.left

  obtain ⟨C, hC⟩ := wc_proet_frames_bounded (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
    (wcGeomPoint F'' (wcP1Over F'') hP) W w hWc ⟨z₀⟩ hqc r θ
  obtain ⟨q, π, hπa, hπb, hπc⟩ := wc_padic_stable_lattice_coords ℓ r U₁ U₂ h12 GG hGid hGmul
    hGst C (by rintro g₁ ⟨γ₁, hγ₁, hg₁⟩ j; exact hC γ₁ g₁ hγ₁ hg₁ j)

  obtain ⟨Ub, hUb, -, -, -, -⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  have hin' : ∀ (i : Fin D.m) (σ : W ⟶ W) (g' : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      wcHonestIsInertia D hP W w i σ → wcHonestFrame D ℓ W r θ σ g' →
      ∀ y ∈ U₂, π (g' y) = π y := by
    intro i σ g' hσ hg' y hy
    have h1 : g' y - y ∈ U₁ := hin i σ g' hσ hg' y hy
    have h2 : g' y - y ∈ U₂ := U₂.sub_mem (hstab σ g' hσ.1 hg' y hy).1 hy
    have h3 := (hπa _ h2).mpr h1
    rw [map_sub, sub_eq_zero] at h3
    exact h3
  have hst' : ∀ (γ' : W ⟶ W) (g' : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      γ' ≫ w = w → wcHonestFrame D ℓ W r θ γ' g' →
      ∀ y ∈ U₂, g' y ∈ U₂ ∧ ((∀ j, ‖π y j‖ ≤ 1) → ∀ j, ‖π (g' y) j‖ ≤ 1) := by
    intro γ' g' hγ' hg' y hy
    exact ⟨(hstab γ' g' hγ' hg' y hy).1, hπc g' ⟨γ', hγ', hg'⟩ y hy⟩
  have hk : ∀ k : ℕ, ∀ y ∈ U₂, (∀ j, ‖π y j‖ ≤ 1) →
      ∀ j, ‖π (g y) j - π y j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
    intro k y hy hyi j
    obtain ⟨E, πE, hfin, het, hsurj, hsplit, htriv⟩ := wc_hmg_torsion_cover F' F'' Y n hn hn2
