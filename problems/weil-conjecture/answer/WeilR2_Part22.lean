    rw [← hΦs, Iso.inv_hom_id_assoc]
  refine ⟨hac, ?_, ?_, Xt, (I.comap r).subscheme, r ≫ Φ.inv, (I.comap r).subschemeι, inferInstance,
    inferInstance, hne, ?_, ?_, ?_, ?_⟩
  · rw [← hΦs]
    infer_instance
  · exact Function.Surjective.connectedSpace (f := Φ.inv)
      (fun z => ⟨Φ.hom z, Scheme.hom_inv_apply Φ z⟩) Φ.inv.continuous
  · intro U hU
    have hU' : ((Φ.inv ⁻¹ᵁ U : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A)).Opens) : Set _) = {xs'}ᶜ := by
      ext z
      change Φ.inv z ∈ (U : Set _) ↔ z ∈ ({xs'}ᶜ : Set _)
      rw [hU]
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      constructor
      · intro h1 h2
        exact h1 ((congrArg Φ.inv h2).trans (Scheme.hom_inv_apply Φ xs))
      · intro h1 h2
        exact h1 ((Scheme.inv_hom_apply Φ z).symm.trans (congrArg Φ.hom h2))
    have h3 : IsIso (r ∣_ (Φ.inv ⁻¹ᵁ U)) := hiso _ hU'
    have h4 : IsIso (Φ.inv ∣_ U) := inferInstance
    rw [morphismRestrict_comp r Φ.inv U]
    exact IsIso.comp_isIso' h3 h4
  · rw [hrange]
    ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    constructor
    · intro h1
      exact (congrArg Φ.inv h1).trans (Scheme.hom_inv_apply Φ xs)
    · intro h1
      exact (Scheme.inv_hom_apply Φ (r w)).symm.trans (congrArg Φ.hom h1)
  · rw [Category.assoc, hinvσ]
    exact hsmX
  · simp only [Category.assoc]
    rw [hinvσ]
    exact hsmE

theorem wc_et_fibre_coh_vanish_of_smooth_exc (K : Type u) [Field K] [IsAlgClosed K]
    (Y X' Z E : Scheme.{u}) (pY : Y ⟶ Spec (.of K)) (b : X' ⟶ Y) [IsProper (b ≫ pY)]
    (iZ : Z ⟶ Y) [IsClosedImmersion iZ] (iE : E ⟶ X') [IsClosedImmersion iE]
    (hE : Set.range iE = b ⁻¹' Set.range iZ) (d : ℕ) [SmoothOfRelativeDimension d (iE ≫ b ≫ pY)]
    (m : ℕ) (hm : (m : K) ≠ 0) (q : ℕ) (hq : 2 * d < q) :
    Subsingleton (wcEtCoh (Limits.pullback b iZ) m q) :=
by
  haveI : IsClosedImmersion (Limits.pullback.fst b iZ) := inferInstance
  haveI : IsProper (Limits.pullback.fst b iZ) := inferInstance
  haveI : IsProper (Limits.pullback.fst b iZ ≫ b ≫ pY) := inferInstance
  have hj : Topology.IsEmbedding (Limits.pullback.fst b iZ) :=
    (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst b iZ)).isEmbedding
  have hi : Topology.IsEmbedding iE := (Scheme.Hom.isClosedEmbedding iE).isEmbedding
  have hset : Set.range (Limits.pullback.fst b iZ) = Set.range iE :=
    (Scheme.Pullback.range_fst b iZ).trans hE.symm
  let h : (Limits.pullback b iZ : Scheme.{u}) ≃ₜ E :=
    hj.toHomeomorph.trans ((Homeomorph.setCongr hset).trans hi.toHomeomorph.symm)
  have hdimE : topologicalKrullDim E ≤ (d : WithBot ℕ∞) :=
    wc_smooth_alg_closed_dim_le K E (iE ≫ b ≫ pY) d
  have heq : topologicalKrullDim (Limits.pullback b iZ : Scheme.{u}) = topologicalKrullDim E :=
    IsHomeomorph.topologicalKrullDim_eq (⇑h) h.isHomeomorph
  have hdim : topologicalKrullDim (Limits.pullback b iZ : Scheme.{u}) ≤ (d : WithBot ℕ∞) :=
    heq.trans_le hdimE
  have hG := wc_et_const_zmod_nsmul_zero (Limits.pullback b iZ) m
  have H := wc_et_cd_proper_torsion K (Limits.pullback b iZ) (Limits.pullback.fst b iZ ≫ b ≫ pY)
    d hdim m hm _ hG q hq
  exact ⟨fun x y => (H x).trans (H y).symm⟩

theorem wc_et_top_strict_elt_of_smooth_modification (K : Type u) [Field K] [IsAlgClosed K]
    (Y Xt Z : Scheme.{u}) (pY : Y ⟶ Spec (.of K)) (b : Xt ⟶ Y) [IsProper b] (N : ℕ)
    [IsProper (b ≫ pY)] [SmoothOfRelativeDimension N (b ≫ pY)] (iZ : Z ⟶ Y) [IsClosedImmersion iZ]
    (hiso : ∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) (hne : Nonempty Xt)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (k : ℕ) (hk : 1 ≤ k)
    (hfib : Subsingleton (wcEtCoh (Limits.pullback b iZ) (ℓ ^ k) (2 * N))) :
    ∃ g : wcEtZModExt Y (ℓ ^ k) (2 * N), ℓ ^ (k - 1) • g ≠ 0 :=
