  refine ⟨(πE ≫ Ub.ι).normalization, (πE ≫ Ub.ι).fromNormalization,
    (πE ≫ Ub.ι).toNormalization, hfinN, ?_, ?_, hpb⟩
  ·
    have hW : ∀ x : (wcGeomPoint F'' (wcP1Over F'') hP).left,
