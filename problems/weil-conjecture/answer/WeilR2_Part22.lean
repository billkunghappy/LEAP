          Limits.pullback.fst φ (X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint K))) :=
      ⟨_, rfl⟩
    have hv : v ≫ φ = x₀ := by
      rw [hvdef, Category.assoc, Category.assoc, Limits.pullback.condition, IsIso.inv_hom_id_assoc]
      exact Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K X x₀
    refine ⟨v, hv, huniq0 _ ?_⟩
    have e := Scheme.Hom.comp_apply v φ (IsLocalRing.closedPoint K)
    rw [hv] at e
    exact e.symm

  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k
  set o : Spec (.of K) ⟶ Spec (.of (MvPolynomial (Fin μ) K)) := Spec.map (CommRingCat.ofHom
    (MvPolynomial.constantCoeff : MvPolynomial (Fin μ) K →+* K)) with ho
  set p : Spec (.of (MvPolynomial (Fin μ) K)) ⟶ Spec (.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin μ) K))) with hp
  haveI hoC : IsClosedImmersion o :=
    IsClosedImmersion.spec_of_surjective _ (fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩)
  have hsec : o ≫ p = 𝟙 _ := by
    rw [ho, hp, ← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext r
    simp [MvPolynomial.algebraMap_eq]

  have c4 : ∀ (D₀ : wcEtPullData o (ℓ ^ k)), ∃ θ₀ : wcEtSuppExt D₀ (2 * μ), ∀ j : ℕ, j • θ₀ = 0 → ℓ ^ k ∣ j := by
    intro D₀
    obtain ⟨qq, hP, hzq⟩ := wc_affine_space_ulift_mvpoly_zero_pullback K (Spec (.of K)) (𝟙 _) μ
    rw [Category.id_comp] at hzq
    haveI : IsIso qq := hP.isIso_snd_of_isIso
    have hpb : IsPullback (𝟙 (Spec (.of K)))
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin μ) → Γ(Spec (.of K), ⊤)))
        o qq :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp]; exact hzq.symm⟩
    obtain ⟨Eq⟩ := wc_et_zmod_pull_data_exists qq (ℓ ^ k)
    obtain ⟨Dz⟩ := wc_et_zmod_pull_data_exists
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin μ) → Γ(Spec (.of K), ⊤))) (ℓ ^ k)
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change o qq _ (𝟙 _) hpb D₀ Eq Dz
    have hR := wc_et_supp_restr_iso_bijective qq o _ (𝟙 _) hpb D₀ Eq Dz γ hγ (2 * μ)
    obtain ⟨ωz, hωz⟩ := wc_et_affine_origin_supp_ext_exact_order_pow K ℓ hℓK k hk μ Dz
    obtain ⟨θ₀, hθ₀⟩ := hR.2 ωz
    have hne : ℓ ^ (k - 1) • θ₀ ≠ 0 := by
      intro h
      apply hωz
      rw [← hθ₀, ← map_nsmul, h, map_zero]
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k))) :=
      HasExt.standard _
    have hid : (ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k))) = 0 := by
      apply (SheafOfModules.toSheaf (wcEtZModRing (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k))).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
      exact wc_et_zmod_toSheaf_nsmul_zero _ (ℓ ^ k) _
    have htor : ∀ (A : SheafOfModules.{u+1} (wcEtZModRing (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k)))
        (d n : ℕ) (x : Abelian.Ext A (SheafOfModules.unit (wcEtZModRing (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k))) d),
        n • x = x.comp (Abelian.Ext.mk₀ (n • 𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k))))) (add_zero d) := by
      intro A d n x
      induction n with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, ih, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
          Abelian.Ext.comp_mk₀_id]
    have hm0 : (ℓ ^ k) • θ₀ = 0 := by
      rw [htor _ _ _ θ₀, hid, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    refine ⟨θ₀, fun j hj => ?_⟩
    have hpr : ℓ.Prime := Fact.out
    have ha : addOrderOf θ₀ ∣ ℓ ^ k := addOrderOf_dvd_of_nsmul_eq_zero hm0
    obtain ⟨e, he, hae⟩ := (Nat.dvd_prime_pow hpr).1 ha
    have hek : e = k := by
      by_contra hne'
      apply hne
      apply addOrderOf_dvd_iff_nsmul_eq_zero.1
      rw [hae]
      exact Nat.pow_dvd_pow ℓ (by omega)
    rw [← hek, ← hae]
    exact addOrderOf_dvd_of_nsmul_eq_zero hj

  let U₀ : (Spec (.of (MvPolynomial (Fin μ) K))).Opens :=
    ⟨(Set.range o)ᶜ, (o.isClosedEmbedding.isClosed_range).isOpen_compl⟩
  have hrU : Set.range U₀.ι = (Set.range o)ᶜ := (Scheme.Opens.range_ι U₀).trans rfl

  obtain ⟨D₀⟩ := wc_et_zmod_pull_data_exists o (ℓ ^ k)
  obtain ⟨θ₀, hθ₀⟩ : ∃ θ : wcEtSuppExt D₀ (q + 1), ∀ j : ℕ, j • θ = 0 → ℓ ^ k ∣ j := by
    rw [hq]; exact c4 D₀

  have h1 := wc_et_affine_space_coh_vanishing K ℓ (Fact.out) hℓK μ (q + 1) (by omega)
  have h2 := wc_et_coh_zmod_prime_pow_of_prime _ ℓ (Fact.out) (q + 1) h1 (k - 1)
  rw [Nat.sub_add_cancel hk] at h2
  haveI h3 : Subsingleton (wcEtZModExt (Spec (.of (MvPolynomial (Fin μ) K))) (ℓ ^ k) (q + 1)) :=
    (wc_et_zmodext_coh_equiv _ (ℓ ^ k) (q + 1)).some.subsingleton
  have hcls : wcEtSuppClass D₀ (q + 1) θ₀ = 0 := Subsingleton.elim _ _

  obtain ⟨ω, hω⟩ := c2 o U₀.ι hrU (ℓ ^ k) hm D₀ q θ₀ hcls
  refine ⟨U₀, rfl, ω, ?_⟩
  intro S φ hφ s hs φo hφo Dφ j₀ hj₀
  haveI := hφ

  obtain ⟨t, ht⟩ := hs
  have hpt : φ s = o (IsLocalRing.closedPoint K) := by
    rw [← ht, Subsingleton.elim t (IsLocalRing.closedPoint K)]
  obtain ⟨U, hsU, hU⟩ := wc_etale_fibre_point_isolated φ s
  obtain ⟨W, hWaff, hsW, hWU⟩ := exists_isAffineOpen_mem_and_subset hsU
  haveI : IsAffine W.toScheme := hWaff
  set f : W.toScheme ⟶ Spec (.of (MvPolynomial (Fin μ) K)) := W.ι ≫ φ with hf
  haveI : Etale f := by rw [hf]; infer_instance
  haveI : IsSeparated f := inferInstance
  let w₀ : W.toScheme := ⟨s, hsW⟩
  have hfw₀ : f w₀ = o (IsLocalRing.closedPoint K) := by
    rw [hf, Scheme.Hom.comp_apply]; exact hpt
  have huniq : ∀ w : W.toScheme, f w = o (IsLocalRing.closedPoint K) → w = w₀ := by
    intro w hw
    rw [hf, Scheme.Hom.comp_apply] at hw
    exact Subtype.ext (hU w.1 (hWU w.2) (hw.trans hpt.symm))

  obtain ⟨v₀, hv₀, hv₀pt⟩ :=
    c3 _ W.toScheme p f o hsec w₀ hfw₀ huniq
  haveI : IsClosedImmersion (v₀ ≫ f) := by rw [hv₀]; exact hoC
  haveI : IsClosedImmersion v₀ := IsClosedImmersion.of_comp v₀ f
  have hZ : IsPullback (𝟙 (Spec (.of K))) v₀ o f :=
    wc_et_point_fibre_isPullback K _ W.toScheme f o v₀ hv₀
      (fun v hv => (huniq v hv).trans hv₀pt.symm)
  obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₀ (ℓ ^ k)
  obtain ⟨Ef⟩ := wc_et_zmod_pull_data_exists f (ℓ ^ k)
  obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change o f v₀ (𝟙 _) hZ D₀ Ef Dv
  have hinj := wc_et_supp_restr_etale_excision_injective f o v₀ (𝟙 _) hZ inferInstance
    D₀ Ef Dv γ hγ (q + 1)

  have hUp := isPullback_morphismRestrict f U₀
  obtain ⟨Dw⟩ := wc_et_zmod_pull_data_exists (f ∣_ U₀) (ℓ ^ k)
  have hω' := hω W.toScheme f (f ⁻¹ᵁ U₀).toScheme (f ⁻¹ᵁ U₀).ι (f ∣_ U₀) hUp
    (Spec (.of K)) v₀ (𝟙 _) hZ Dv Ef γ hγ Dw j₀

  have hle : f ⁻¹ᵁ U₀ ≤ W.ι ⁻¹ᵁ (φ ⁻¹ᵁ U₀) := by
    intro x hx
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
    rw [Scheme.Hom.mem_preimage, hf, Scheme.Hom.comp_apply] at hx
    exact hx
  have hlam : W.ι.resLE (φ ⁻¹ᵁ U₀) (f ⁻¹ᵁ U₀) hle ≫ φo = f ∣_ U₀ := by
    rw [← cancel_mono U₀.ι, Category.assoc, hφo, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
      Category.assoc, morphismRestrict_ι]
  obtain ⟨Dlam⟩ := wc_et_zmod_pull_data_exists (W.ι.resLE (φ ⁻¹ᵁ U₀) (f ⁻¹ᵁ U₀) hle) (ℓ ^ k)
  have hpc := wc_et_pull_comp φo _ (f ∣_ U₀) hlam Dφ Dlam Dw q ω
  have hjw : j₀ • wcEtPull Dw q ω = 0 := by
    rw [hpc, ← map_nsmul, hj₀, map_zero]

  have hr := hω' hjw
  have hθ0 : j₀ • θ₀ = 0 := by
    apply hinj
    rw [map_nsmul, map_zero]
    exact hr
  exact hθ₀ j₀ hθ0

theorem wc_npr_refine_through_slice {S Z : Scheme.{u}} (ιs : Z ⟶ S) [IsClosedImmersion ιs]
    (m : ℕ) (hm : m ≠ 0) (N : ℕ) (hN : 1 ≤ N) (T₀ : S.Etale) (K : Type u) [Field K] (μ : ℕ)
    (ψ : T₀.left ⟶ Spec (.of (MvPolynomial (Fin μ) K)))
    (U₀ : (Spec (.of (MvPolynomial (Fin μ) K))).Opens) (ω : wcEtZModExt U₀.toScheme m N)
    (hω : ∀ (S' : Scheme.{u}) (φ : S' ⟶ Spec (.of (MvPolynomial (Fin μ) K))), Etale φ →
      ∀ s : S', φ s ∉ U₀ →
      ∀ (φo : (φ ⁻¹ᵁ U₀).toScheme ⟶ U₀.toScheme), φo ≫ U₀.ι = (φ ⁻¹ᵁ U₀).ι ≫ φ →
      ∀ (Dφ : wcEtPullData φo m) (j : ℕ), j • wcEtPull Dφ N ω = 0 → m ∣ j)
    (S₀ : Scheme.{u}) (σ : S₀ ⟶ Limits.pullback T₀.hom ιs) (s₀ : S₀)
    (hσ : Etale (σ ≫ Limits.pullback.fst T₀.hom ιs ≫ ψ))
    (hσ0 : (σ ≫ Limits.pullback.fst T₀.hom ιs ≫ ψ) s₀ ∉ U₀)
    (β : wcEtZModExt ((wcEtBaseChange ιs).obj T₀).left m N) :
    ∃ (T₁ : S.Etale) (r₁ : T₁ ⟶ T₀),
      (∀ D : wcEtPullData ((wcEtBaseChange ιs).map r₁).left m, wcEtPull D N β = 0) ∧
      ∀ (D : wcEtPullData (Limits.pullback.fst (wcEtOpen S T₁ (r₁.left ⁻¹ᵁ (ψ ⁻¹ᵁ U₀))).hom ιs ≫
          r₁.left.resLE (ψ ⁻¹ᵁ U₀) (r₁.left ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)) le_rfl ≫
          ψ.resLE U₀ (ψ ⁻¹ᵁ U₀) le_rfl) m) (j : ℕ),
        j • wcEtPull D N ω = 0 → m ∣ j :=
by
  classical

  obtain ⟨S', s', hs', ⟨q', hq'⟩, hkill'⟩ :=
    wc_et_zmodext_pos_locally_zero (Limits.pullback T₀.hom ιs) m hm N hN β (σ s₀)
  haveI : Etale s' := hs'

  obtain ⟨V', e, he, h, x', hh, hx'⟩ : ∃ (V' : Scheme.{u}) (e : V' ⟶ T₀.left) (_ : Etale e)
      (h : Limits.pullback e (Limits.pullback.fst T₀.hom ιs) ⟶ S')
      (x' : ↥(Limits.pullback e (Limits.pullback.fst T₀.hom ιs))),
      h ≫ s' = Limits.pullback.snd e (Limits.pullback.fst T₀.hom ιs) ∧ h x' = q' :=
    @wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _
      (Limits.pullback.fst T₀.hom ιs) _ _ s' hs' q'
  haveI : Etale e := he
  haveI : Etale T₀.hom := T₀.prop

  let T₁ : S.Etale := MorphismProperty.Over.mk ⊤ (e ≫ T₀.hom) (by infer_instance)
  let r₁ : T₁ ⟶ T₀ := MorphismProperty.Over.homMk e rfl trivial

  obtain ⟨b', hb'⟩ : ∃ b' : Limits.pullback (e ≫ T₀.hom) ιs ⟶ Limits.pullback T₀.hom ιs,
      b' = (Limits.pullbackRightPullbackFstIso T₀.hom ιs e).inv ≫
        Limits.pullback.snd e (Limits.pullback.fst T₀.hom ιs) := ⟨_, rfl⟩
  have hb'fst : b' ≫ Limits.pullback.fst T₀.hom ιs =
      Limits.pullback.fst (e ≫ T₀.hom) ιs ≫ e := by
    rw [hb', Category.assoc, ← Limits.pullback.condition, ← Category.assoc,
      Limits.pullbackRightPullbackFstIso_inv_fst]
  have hb'snd : b' ≫ Limits.pullback.snd T₀.hom ιs = Limits.pullback.snd (e ≫ T₀.hom) ιs := by
    rw [hb', Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd]
  have hbB : b' = ((wcEtBaseChange ιs).map r₁).left := by
    apply Limits.pullback.hom_ext
    · rw [hb'fst]; exact (Limits.pullback.lift_fst _ _ _).symm
    · rw [hb'snd]; exact (Limits.pullback.lift_snd _ _ _).symm
  have hb'pt : (Limits.pullbackRightPullbackFstIso T₀.hom ιs e).hom ≫ b' = h ≫ s' := by
    rw [hb', Iso.hom_inv_id_assoc]; exact hh.symm
  haveI hb'et : Etale b' := by rw [hb']; infer_instance
  refine ⟨T₁, r₁, ?_, ?_⟩
  ·
    intro D
    have hcomp : ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).inv ≫ h) ≫ s' =
        ((wcEtBaseChange ιs).map r₁).left := by
      rw [Category.assoc, hh, ← hb']; exact hbB
    have e1 := wc_et_pull_comp s' ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).inv ≫ h)
      (((wcEtBaseChange ιs).map r₁).left) hcomp (wc_et_zmod_pull_data_exists s' m).some
      (wc_et_zmod_pull_data_exists
        ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).inv ≫ h) m).some D N β
    refine e1.trans ?_
    rw [hkill']
    exact map_zero _
  · show ∀ (D : wcEtPullData (Limits.pullback.fst ((e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι ≫ e ≫ T₀.hom) ιs ≫
          e.resLE (ψ ⁻¹ᵁ U₀) (e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)) le_rfl ≫
          ψ.resLE U₀ (ψ ⁻¹ᵁ U₀) le_rfl) m) (j : ℕ), j • wcEtPull D N ω = 0 → m ∣ j

    have hbt : b' ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).hom x') = σ s₀ := by
      calc b' ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).hom x')
          = ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).hom ≫ b') x' :=
            (Scheme.Hom.comp_apply _ _ _).symm
        _ = (h ≫ s') x' := by rw [hb'pt]
        _ = s' (h x') := Scheme.Hom.comp_apply _ _ _
        _ = σ s₀ := by rw [hx', hq']
    obtain ⟨s₁, hs₁f, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := σ) (g := b') s₀
      ((Limits.pullbackRightPullbackFstIso T₀.hom ιs e).hom x') hbt.symm
    obtain ⟨φ₁, hφ₁def⟩ : ∃ φ : Limits.pullback σ b' ⟶ Spec (.of (MvPolynomial (Fin μ) K)),
        φ = Limits.pullback.fst σ b' ≫ σ ≫ Limits.pullback.fst T₀.hom ιs ≫ ψ := ⟨_, rfl⟩
    have hφ₁ : Etale φ₁ := by rw [hφ₁def]; infer_instance
    have hs₁ : φ₁ s₁ ∉ U₀ := by
      rw [hφ₁def, Scheme.Hom.comp_apply, hs₁f]; exact hσ0

    obtain ⟨g₁, hg₁⟩ : ∃ g : (φ₁ ⁻¹ᵁ U₀).toScheme ⟶ V',
        g = (φ₁ ⁻¹ᵁ U₀).ι ≫ Limits.pullback.snd σ b' ≫ Limits.pullback.fst (e ≫ T₀.hom) ιs :=
      ⟨_, rfl⟩
    have key1 : g₁ ≫ e = (φ₁ ⁻¹ᵁ U₀).ι ≫ Limits.pullback.fst σ b' ≫ σ ≫
        Limits.pullback.fst T₀.hom ιs := by
      rw [hg₁]
      simp only [Category.assoc]
      rw [← hb'fst, ← Limits.pullback.condition_assoc]
    have hrange : Set.range g₁ ⊆ Set.range (e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      have hw : (φ₁ ⁻¹ᵁ U₀).ι w ∈ φ₁ ⁻¹ᵁ U₀ := by
        have h0 : (φ₁ ⁻¹ᵁ U₀).ι w ∈ Set.range (φ₁ ⁻¹ᵁ U₀).ι := ⟨w, rfl⟩
        rwa [Scheme.Opens.range_ι] at h0
      rw [Scheme.Hom.mem_preimage] at hw
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
      have h1 : ψ (e (g₁ w)) = (g₁ ≫ e ≫ ψ) w := by
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      rw [h1, reassoc_of% key1, ← hφ₁def, Scheme.Hom.comp_apply]
      exact hw
    obtain ⟨a, ha⟩ : ∃ a : (φ₁ ⁻¹ᵁ U₀).toScheme ⟶ (e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).toScheme,
        a ≫ (e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι = g₁ :=
      ⟨IsOpenImmersion.lift _ g₁ hrange, IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨c, hc⟩ : ∃ c : (φ₁ ⁻¹ᵁ U₀).toScheme ⟶ Z,
        c = (φ₁ ⁻¹ᵁ U₀).ι ≫ Limits.pullback.snd σ b' ≫ Limits.pullback.snd (e ≫ T₀.hom) ιs :=
      ⟨_, rfl⟩
    have hcone : a ≫ ((e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι ≫ e ≫ T₀.hom) = c ≫ ιs := by
      rw [reassoc_of% ha, hg₁, hc]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    obtain ⟨lam, hlam⟩ : ∃ l : (φ₁ ⁻¹ᵁ U₀).toScheme ⟶
        Limits.pullback ((e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι ≫ e ≫ T₀.hom) ιs,
        l ≫ Limits.pullback.fst ((e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι ≫ e ≫ T₀.hom) ιs = a :=
      ⟨Limits.pullback.lift a c hcone, Limits.pullback.lift_fst _ _ _⟩

    generalize hχdef : Limits.pullback.fst ((e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)).ι ≫ e ≫ T₀.hom) ιs ≫
          e.resLE (ψ ⁻¹ᵁ U₀) (e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀)) le_rfl ≫
          ψ.resLE U₀ (ψ ⁻¹ᵁ U₀) le_rfl = χ
    have hχ : (lam ≫ χ) ≫ U₀.ι = (φ₁ ⁻¹ᵁ U₀).ι ≫ φ₁ := by
      rw [← hχdef]
      simp only [Category.assoc]
      rw [Scheme.Hom.resLE_comp_ι,
        reassoc_of% (Scheme.Hom.resLE_comp_ι e
          (le_rfl : e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀) ≤ e ⁻¹ᵁ (ψ ⁻¹ᵁ U₀))),
        reassoc_of% hlam, reassoc_of% ha, reassoc_of% key1, ← hφ₁def]
    intro D j hj
    have e1 := wc_et_pull_comp χ lam (lam ≫ χ) rfl D (wc_et_zmod_pull_data_exists lam m).some
      (wc_et_zmod_pull_data_exists (lam ≫ χ) m).some N ω
    refine hω (Limits.pullback σ b') φ₁ hφ₁ s₁ hs₁ (lam ≫ χ) hχ
      (wc_et_zmod_pull_data_exists (lam ≫ χ) m).some j ?_
    rw [e1, ← map_nsmul, hj]
    exact map_zero _

theorem wc_et_tpl_snkc_cospec_system (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
