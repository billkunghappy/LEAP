            Spec (.of (AlgebraicClosure (B.residueField η)))) (hσ : σ ≫ ξ = ξ),
          ∃ Dσ : wcEtPullData (Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) σ (𝟙 B)
