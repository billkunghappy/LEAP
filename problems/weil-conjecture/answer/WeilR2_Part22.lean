  have hacyc := wc_et_quadric_cone_acyclic (IsLocalRing.ResidueField A) ℓ hp hℓκ 2
    (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then
