theorem wc_pencil_honest_monodromy_generated (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (U₁ U₂ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) (h12 : U₁ ≤ U₂)
    (hstab : ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      γ ≫ w = w → wcHonestFrame D ℓ W r θ γ g →
      ∀ x ∈ U₂, g x ∈ U₂ ∧ (x ∈ U₁ → g x ∈ U₁))
    (hin : ∀ (i : Fin D.m) (σ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      wcHonestIsInertia D hP W w i σ → wcHonestFrame D ℓ W r θ σ g →
      ∀ x ∈ U₂, g x - x ∈ U₁) :
    ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      γ ≫ w = w → wcHonestFrame D ℓ W r θ γ g → ∀ x ∈ U₂, g x - x ∈ U₁ :=
by
  classical
  intro γ g hγ hg x hx
  haveI := hconn
  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt

  have hcancel1 : ∀ (T : Over W)
      (s : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
  have hs3 : ∀ σ : W ⟶ W, ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ σ = u →
      ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk u))).hom t).down) z =
      A ((show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) z) := by
    intro σ
    let θσ : (wcRq D.f ℓ (n - 1)).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W :=
      ⟨{ app := fun T => θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ σ = u →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
