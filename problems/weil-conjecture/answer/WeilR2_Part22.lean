    have k2 : ((wcProEtPush g).rightDerived q).map (wcIntScalar X ℓ ((ℓ : ℤ_[ℓ]) ^ m)) =
        (ℓ ^ m : ℕ) • 𝟙 (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)) := by
      rw [k1]
