    refine hev.trans ?_
    have h1 : @Eq ((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj (wcEtTop S))))
        ((Dg.φ.hom.app (Opposite.op (wcEtTop S))).hom
          (1 : (wcEtZModRing S m).obj.obj (Opposite.op (wcEtTop S)))) 1 := map_one _
    exact (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dg.φ _).trans h1
  haveI := s4 _ s3 _ _ key
  rw [← hν]
  infer_instance

theorem wc_npr_et_slice_push_bc : ∀ {S S' : Scheme.{u}} {m : ℕ} (g : S' ⟶ S) (V : S.Etale) (V' : S'.Etale) (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU g V.hom) [hc : (wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)] [hc' : (wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')] (ψ : wcEtZModRing V.left m ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).obj (wcEtZModRing S m)) (ψ' : wcEtZModRing V'.left m ⟶ ((wcEtSlice V').sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' m)) (Dg : wcEtPullData g m) (DfU : wcEtPullData fU m), ∃ β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ ⋙ SheafOfModules.pushforward.{u+1} ψ ≅ SheafOfModules.pushforward.{u+1} ψ' ⋙ @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange fU) _ _ DfU.cont DfU.φ, ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)) (T : V.left.Etale) (ζ : (wcEtSlice V').obj ((wcEtBaseChange fU).obj T) ⟶ (wcEtBaseChange g).obj ((wcEtSlice V).obj T)), ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) g = Limits.pullback.fst T.hom fU → ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) g = Limits.pullback.snd T.hom fU ≫ V'.hom → ∀ x : ((SheafOfModules.pushforward.{u+1} ψ).obj ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ).obj M)).val.obj (Opposite.op T), ((β.hom.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x :=
by
  have zmodExt : ∀ (Y : Scheme.{u}) (m : ℕ)
      (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R),
      φ = ψ := by
    intro Y m R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _
      R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.snd B.hom h =
        Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have sqAux : ∀ {P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z : Scheme.{u}} (a : P₁ ⟶ P₂) (b : Q₁ ⟶ Q₂)
      (e₁ : P₁ ⟶ Q₁) (e₂ : P₂ ⟶ Q₂) (x₁ : P₁ ⟶ A₁) (x₂ : P₂ ⟶ A₂) (y₁ : P₁ ⟶ B₁) (y₂ : P₂ ⟶ B₂)
      (p₁ : Q₁ ⟶ A₁) (p₂ : Q₂ ⟶ A₂) (q₁ : Q₁ ⟶ Z) (q₂ : Q₂ ⟶ Z) (gA : A₁ ⟶ A₂) (v₁ : B₁ ⟶ Z)
      (v₂ : B₂ ⟶ Z)
      (hext : ∀ φ ψ : P₁ ⟶ Q₂, φ ≫ p₂ = ψ ≫ p₂ → φ ≫ q₂ = ψ ≫ q₂ → φ = ψ)
      (h1 : e₁ ≫ p₁ = x₁) (h2 : e₂ ≫ p₂ = x₂) (h3 : e₁ ≫ q₁ = y₁ ≫ v₁) (h4 : e₂ ≫ q₂ = y₂ ≫ v₂)
      (ha1 : a ≫ x₂ = x₁ ≫ gA) (ha2 : a ≫ y₂ ≫ v₂ = y₁ ≫ v₁) (hb1 : b ≫ p₂ = p₁ ≫ gA)
      (hb2 : b ≫ q₂ = q₁),
      a ≫ e₂ = e₁ ≫ b := by
    intro P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z a b e₁ e₂ x₁ x₂ y₁ y₂ p₁ p₂ q₁ q₂ gA v₁ v₂ hext h1 h2 h3 h4
      ha1 ha2 hb1 hb2
    apply hext
    · rw [Category.assoc, Category.assoc, h2, ha1, hb1, ← Category.assoc, h1]
    · rw [Category.assoc, Category.assoc, h4, ha2, hb2, h3]
  have s1 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (V : S.Etale) (V' : S'.Etale)
      (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU f V.hom),
      ∃ ζ : wcEtBaseChange fU ⋙ wcEtSlice V' ≅ wcEtSlice V ⋙ wcEtBaseChange f,
        ∀ T : V.left.Etale,
          (ζ.hom.app T).left ≫ Limits.pullback.fst (T.hom ≫ V.hom) f =
