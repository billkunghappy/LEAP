    refine ((map_nsmul (hS'.extClass.precomp (SheafOfModules.unit (wcEtZModRing P' m))
      (add_comm 1 M)) n _).symm.trans ?_)
    show hS'.extClass.comp (n • _) (add_comm 1 M) = 0
