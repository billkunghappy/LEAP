    · exact (MorphismProperty.Over.w f).trans (Limits.pullback.lift_snd _ _ _).symm

  have hν : Dg.μ.hom ≫ (Dg.μ.inv ≫ (Dg.adj.homEquiv (SheafOfModules.unit (wcEtZModRing S m))
      (SheafOfModules.unit (wcEtZModRing S' m))).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ)) =
      (Dg.adj.homEquiv (SheafOfModules.unit (wcEtZModRing S m))
      (SheafOfModules.unit (wcEtZModRing S' m))).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ) :=
    Iso.hom_inv_id_assoc _ _
  have he := congrArg (Dg.adj.homEquiv (SheafOfModules.unit (wcEtZModRing S m))
      (SheafOfModules.unit (wcEtZModRing S' m))) hν
  rw [Equiv.apply_symm_apply, Adjunction.homEquiv_naturality_right] at he
  have hev := congrArg (fun F => (F.val.app (Opposite.op (wcEtTop S))).hom
    (1 : (wcEtZModRing S m).obj.obj (Opposite.op (wcEtTop S)))) he
  have key : @Eq ((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj (wcEtTop S))))
      (((Dg.μ.inv ≫ (Dg.adj.homEquiv (SheafOfModules.unit (wcEtZModRing S m))
      (SheafOfModules.unit (wcEtZModRing S' m))).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ)).val.app
        (Opposite.op ((wcEtBaseChange g).obj (wcEtTop S)))).hom
        (((Dg.adj.homEquiv (SheafOfModules.unit (wcEtZModRing S m))
