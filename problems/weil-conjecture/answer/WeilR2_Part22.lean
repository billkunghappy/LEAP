  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (∑ j, ‖π x j‖) hℓ1
  have hc0 : ((ℓ : ℚ_[ℓ]) ^ N) ≠ 0 :=
    pow_ne_zero N (by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero)
  have hcn : ‖((ℓ : ℚ_[ℓ]) ^ N)‖ = ((ℓ : ℝ) ^ N)⁻¹ := by
    rw [norm_pow, Padic.norm_p, inv_pow]
  have hcx : ((ℓ : ℚ_[ℓ]) ^ N) • x ∈ U₂ := U₂.smul_mem _ hx
  have hcxi : ∀ j, ‖π (((ℓ : ℚ_[ℓ]) ^ N) • x) j‖ ≤ 1 := by
    intro j
    rw [map_smul, Pi.smul_apply, smul_eq_mul, norm_mul, hcn]
    have hle : ‖π x j‖ ≤ ∑ j, ‖π x j‖ :=
      Finset.single_le_sum (fun i _ => norm_nonneg (π x i)) (Finset.mem_univ j)
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ N := by positivity
    rw [inv_mul_le_iff₀ hpos, mul_one]
    linarith
  have h1 := hzero _ hcx hcxi
  simp only [map_smul] at h1
  have h2 : π (g x) = π x := smul_right_injective _ hc0 h1
  have h3 : g x - x ∈ U₂ := U₂.sub_mem (hstab γ g hγ hg x hx).1 hx
  exact (hπa _ h3).mp (by rw [map_sub, h2, sub_self])

theorem wc_pencil_honest_inertia_PL (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (i : Fin D.m) (γ : W ⟶ W) (hγw : γ ≫ w = w)
    (lam : Module.Dual ℚ_[ℓ] (Fin r → ℚ_[ℓ])) (d : Fin r → ℚ_[ℓ]) (hdz : d = 0 ↔ lam = 0)
    (gγ : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) (hgγ : wcHonestFrame D ℓ W r θ γ gγ)
    (hgγf : ∀ x, gγ x = x + lam x • d)
    (hloc : ∀ (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : V.left ≅ Spec (.of A)),
      V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
      ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ W) (z : V'.left),
        a ≫ v = b ≫ w ∧
        (∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
          (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = 0 → s = 0) ∧
        ∀ x : Fin r → ℚ_[ℓ], lam x = 0 ↔
          ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
            (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
              (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = x)
    (σ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
    (hσ : wcHonestIsInertia D hP W w i σ) (hg : wcHonestFrame D ℓ W r θ σ g) :
    ∃ (h h' : W ⟶ W) (gh gh' : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) (c : ℚ_[ℓ]),
      h ≫ w = w ∧ h' ≫ w = w ∧ wcHonestFrame D ℓ W r θ h gh ∧
      wcHonestFrame D ℓ W r θ h' gh' ∧ (∀ x, gh' (gh x) = x) ∧
      ∀ x, g x = x + (c * lam (gh x)) • gh' d :=
by
  classical
  haveI := hconn

  have hcancel1 : ∀ (T : Over W)
      (s : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id

  have hnat : ∀ (V V' : (wcP1Over F'').left.ProEt) (h : V ⟶ W) (a : V' ⟶ V) (h' : V' ⟶ W),
      a ≫ h = h' → ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (v : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) v =
      (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s).down) (a.left v) := by
    rintro V V' h a h' rfl s v
    have hN := θ.hom.hom.naturality (Over.homMk a rfl : Over.mk (a ≫ h) ⟶ Over.mk h).op
    exact congrArg (fun m => (show C(↥V'.left, Fin r → ℚ_[ℓ]) from (m.hom s).down) v) hN

  have hRcomp : ∀ {V₁ V₂ V₃ : (wcP1Over F'').left.ProEt} (f : V₂ ⟶ V₁) (f' : V₃ ⟶ V₂)
      (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₁)),
      ((wcRq D.f ℓ (n - 1)).obj.map f'.op).hom (((wcRq D.f ℓ (n - 1)).obj.map f.op).hom s) =
        ((wcRq D.f ℓ (n - 1)).obj.map (f' ≫ f).op).hom s := by
    intro V₁ V₂ V₃ f f' s
    rw [op_comp, Functor.map_comp]
    rfl

  have hs3 : ∀ σ : W ⟶ W, ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ σ = u →
      ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk u))).hom t).down) z =
      A ((show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) z) := by
    intro σ
    let θσ : (wcRq D.f ℓ (n - 1)).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W :=
      ⟨{ app := fun T => θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ σ = u →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t =
          (θ.hom.hom.app (Opposite.op (Over.mk u))).hom t := by
      rintro V' c u rfl t
      rfl
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ W hconn r r
      (θ.inv ≫ θσ)
    have hPt : ∀ (T : Over W)
        (c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin r → ℚ_[ℓ]) from
          (((θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    refine ⟨A, ?_⟩
    intro V' c u hcu t z
    have e1 : ((θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk c))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) =
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk c))).hom (hcancel1 (Over.mk c) t)
    have E := e1.trans (hres V' c u hcu t)
    have h1 := hPt (Over.mk c) ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin r → ℚ_[ℓ]) => y.down z) E
    exact h4.symm.trans h1
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty
  have hconst : ∀ v : Fin r → ℚ_[ℓ], ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) hs
  have huniq : ∀ (γ : W ⟶ W) (g g' : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      wcHonestFrame D ℓ W r θ γ g → wcHonestFrame D ℓ W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply LinearMap.ext
    intro v
    obtain ⟨s, hs⟩ := hconst v
    have h1 := hg s z₀
    have h2 := hg' s z₀
    rw [hs z₀] at h1 h2
    exact h1.symm.trans h2
  choose fr hfr0 using hs3
  have hfr : ∀ γ : W ⟶ W, wcHonestFrame D ℓ W r θ γ (fr γ) := by
    intro γ s z
    exact hfr0 γ W (𝟙 W) γ (Category.id_comp γ) s z
  have hfr1 : fr (𝟙 W) = LinearMap.id := by
    apply huniq (𝟙 W) _ _ (hfr _)
    intro s z
    rfl
  have hcomp : ∀ γ γ' : W ⟶ W, fr (γ ≫ γ') = fr γ' ∘ₗ fr γ := by
    intro γ γ'
    apply huniq (γ ≫ γ') _ _ (hfr _)
    intro s z
    rw [LinearMap.comp_apply, ← hfr γ s z]
    exact hfr0 γ' W γ (γ ≫ γ') rfl s z
  have hinv : ∀ σ : W ⟶ W, σ ≫ w = w → ∃ σ' : W ⟶ W, σ' ≫ w = w ∧
      (∀ x, fr σ' (fr σ x) = x) ∧ (∀ x, fr σ (fr σ' x) = x) := by
    have hl : ∀ σ : W ⟶ W, σ ≫ w = w →
        ∃ σ' : W ⟶ W, σ' ≫ w = w ∧ ∀ x, fr σ' (fr σ x) = x := by
      intro σ hσ
      obtain ⟨σ', hσ', he⟩ := hgal W σ (𝟙 W) hconn (by rw [hσ, Category.id_comp])
      refine ⟨σ', hσ', fun x => ?_⟩
      have := congrArg (fun γ => fr γ x) he
      simp only [hfr1, hcomp, LinearMap.id_apply, LinearMap.comp_apply] at this
      exact this.symm
    intro σ hσ
    obtain ⟨σ', hσ', h1⟩ := hl σ hσ
    obtain ⟨ρ, -, h2⟩ := hl σ' hσ'
    have hρ : ∀ y, fr ρ y = fr σ y := fun y => by
      calc fr ρ y = fr ρ (fr σ' (fr σ y)) := by rw [h1]
        _ = fr σ y := h2 _
    exact ⟨σ', hσ', h1, fun x => (hρ _).symm.trans (h2 x)⟩
  have hgσ : g = fr σ := huniq σ _ _ hg (hfr σ)

  obtain ⟨hσw, V, v, A, iCR, iH, iS, e, hV, L, iF, iSC, Vt, eVt, u', c, τ, hc, hτu, hτc⟩ := hσ
  obtain ⟨V', a, b, z, hab, -, hker⟩ := hloc V v A e hV

  have hVt1 : ∀ x y : Vt.left, x = y := by
    haveI hsub : Subsingleton ↥(Spec (CommRingCat.of L)) :=
      inferInstanceAs (Subsingleton (PrimeSpectrum L))
    have hback : ∀ x : Vt.left, eVt.inv (eVt.hom x) = x := by
      intro x
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, eVt.hom_inv_id]; rfl)
        | exact congrArg (fun f : Vt.left ⟶ Vt.left => f x) eVt.hom_inv_id
    intro x y
    rw [← hback x, ← hback y, Subsingleton.elim (eVt.hom x) (eVt.hom y)]
  obtain ⟨pt⟩ : Nonempty Vt.left := ⟨eVt.inv (IsLocalRing.closedPoint L)⟩

  obtain ⟨K, hK⟩ : ∃ K : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) → (Fin r → ℚ_[ℓ]),
      ∀ s, K s = (show C(↥Vt.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map u'.op).hom s)).down) pt := ⟨_, fun _ => rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) → (Fin r → ℚ_[ℓ]),
      ∀ s, M s = (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z := ⟨_, fun _ => rfl⟩

  have hfixK : ∀ s, g (K s) = K s := by
    intro s
    rw [hgσ, hK]
    have h1 := hfr0 σ Vt c (c ≫ σ) rfl (((wcRq D.f ℓ (n - 1)).obj.map u'.op).hom s) pt
    have h2 := hnat Vt Vt c τ (c ≫ σ) hτc (((wcRq D.f ℓ (n - 1)).obj.map u'.op).hom s) pt
    rw [hRcomp, hτu, hVt1 (τ.left pt) pt] at h2
    exact h1.symm.trans h2

  have hoffpt : V.hom (u'.left pt) ≠ D.S i (IsLocalRing.closedPoint F'') := by
    have e1 : (u'.left ≫ V.hom) pt = (c.left ≫ W.hom) pt := by
      rw [MorphismProperty.Over.w u', MorphismProperty.Over.w c]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    rw [e1]
    exact hoff _ i
  have hoffz : V.hom (a.left z) ≠ D.S i (IsLocalRing.closedPoint F'') := by
    have e1 : (a.left ≫ V.hom) z = (b.left ≫ W.hom) z := by
      rw [MorphismProperty.Over.w a, MorphismProperty.Over.w b]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    rw [e1]
    exact hoff _ i
  have hsame : u'.left pt = a.left z :=
    wc_shens_nbhd_offpoint_unique F'' (D.S i) (D.hS i) V A e hV _ _ hoffpt hoffz

  obtain ⟨X, q₁, q₂, x₀, hXc, hsq, hq1, hq2⟩ :=
    wc_proet_connected_refinement (wcP1Over F'').left V Vt V' u' a pt z hsame

  have hcomm : (q₁ ≫ c) ≫ w = (q₂ ≫ b) ≫ w := by
    simp only [Category.assoc]
    rw [← hc, ← Category.assoc q₁ u' v, hsq, Category.assoc, hab]
  obtain ⟨ρ, hρw, hρ⟩ := hgal X (q₁ ≫ c) (q₂ ≫ b) hXc hcomm
  obtain ⟨ρb, hρbw, hρb1, hρb2⟩ := hinv ρ hρw

  have hmK : ∀ s, M s = fr ρ (K s) := by
    intro s
    have e1 := hnat V' X b q₂ (q₂ ≫ b) rfl (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s) x₀
    rw [hq2] at e1
    have e2 := hfr0 ρ X (q₁ ≫ c) (q₂ ≫ b) hρ.symm
      (((wcRq D.f ℓ (n - 1)).obj.map q₁.op).hom
        (((wcRq D.f ℓ (n - 1)).obj.map u'.op).hom s)) x₀
    have e3 := hnat Vt X c q₁ (q₁ ≫ c) rfl (((wcRq D.f ℓ (n - 1)).obj.map u'.op).hom s) x₀
    rw [hq1] at e3
    have e4 : ((wcRq D.f ℓ (n - 1)).obj.map q₂.op).hom
        (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s) =
        ((wcRq D.f ℓ (n - 1)).obj.map q₁.op).hom
          (((wcRq D.f ℓ (n - 1)).obj.map u'.op).hom s) := by
      rw [hRcomp, hRcomp, hsq]
    rw [e4] at e1
    rw [hM, hK, ← e1, e2, e3]

  have hfixρ : ∀ y, lam (fr ρ y) = 0 → g y = y := by
    intro y hy
    obtain ⟨s, hs⟩ := (hker (fr ρ y)).mp hy
    have h1 : fr ρ (K s) = fr ρ y := by
      rw [← hmK, hM]
      exact hs
    have h2 : K s = y := by
      have h3 := congrArg (fr ρb) h1
      rwa [hρb1, hρb1] at h3
    rw [← h2]
    exact hfixK s

  obtain ⟨J, hJalt, hJunit, hJinv⟩ :=
    wc_pencil_PL_cup_form F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc hconn hoff hcov hgal
  have hγJ : (LinearMap.toMatrix' gγ).transpose * J * LinearMap.toMatrix' gγ = J :=
    hJinv γ hγw gγ hgγ
  have hhJ : (LinearMap.toMatrix' (fr ρ)).transpose * J * LinearMap.toMatrix' (fr ρ) = J :=
    hJinv ρ hρw (fr ρ) (hfr ρ)
  have hgJ : (LinearMap.toMatrix' g).transpose * J * LinearMap.toMatrix' g = J :=
    hJinv σ hσw g hg

  have hLA : ∃ c0 : ℚ_[ℓ], ∀ x, g x = x + (c0 * lam (fr ρ x)) • fr ρb d := by
    obtain ⟨B, hB⟩ : ∃ B : (Fin r → ℚ_[ℓ]) → (Fin r → ℚ_[ℓ]) → ℚ_[ℓ],
        ∀ x y, B x y = dotProduct x (J.mulVec y) := ⟨_, fun _ _ => rfl⟩
    have hBadd1 : ∀ x x' y, B (x + x') y = B x y + B x' y := by
      intro x x' y; rw [hB, hB, hB, add_dotProduct]
    have hBadd2 : ∀ x y y', B x (y + y') = B x y + B x y' := by
      intro x y y'; rw [hB, hB, hB, Matrix.mulVec_add, dotProduct_add]
    have hBsm1 : ∀ (a : ℚ_[ℓ]) x y, B (a • x) y = a * B x y := by
      intro a x y; rw [hB, hB, smul_dotProduct, smul_eq_mul]
    have hBsm2 : ∀ (a : ℚ_[ℓ]) x y, B x (a • y) = a * B x y := by
      intro a x y; rw [hB, hB, Matrix.mulVec_smul, dotProduct_smul, smul_eq_mul]
    have hBsub1 : ∀ x x' y, B (x - x') y = B x y - B x' y := by
      intro x x' y; rw [hB, hB, hB, sub_dotProduct]
    have hBalt : ∀ x y, B x y = -B y x := by
      intro x y
      rw [hB, hB, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hJalt, Matrix.neg_mulVec,
        neg_dotProduct, dotProduct_comm]
    have hBzero : ∀ x, B x x = 0 := by
      intro x
      have h := hBalt x x
      have h2 : (2 : ℚ_[ℓ]) * B x x = 0 := by linear_combination h
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hBnd : ∀ x, (∀ y, B x y = 0) → x = 0 := by
      intro x hx
      have hinj : Function.Injective fun v => Matrix.vecMul v J :=
        Matrix.vecMul_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det J).mpr hJunit)
      apply hinj
      show Matrix.vecMul x J = Matrix.vecMul 0 J
      rw [Matrix.zero_vecMul]
      funext j
      have h := hx (Pi.single j 1)
      rw [hB, Matrix.dotProduct_mulVec, dotProduct_single_one] at h
      exact h
    have hiso : ∀ M : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
        (LinearMap.toMatrix' M).transpose * J * LinearMap.toMatrix' M = J →
        ∀ x y, B (M x) (M y) = B x y := by
      intro M hM x y
      rw [hB, hB, ← LinearMap.toMatrix'_mulVec M x, ← LinearMap.toMatrix'_mulVec M y,
        ← Matrix.vecMul_transpose, ← Matrix.dotProduct_mulVec, Matrix.mulVec_mulVec,
        Matrix.mulVec_mulVec, hM]
    by_cases hl : lam = 0
    · refine ⟨0, fun x => ?_⟩
      rw [hfixρ x (by rw [hl]; rfl), zero_mul, zero_smul, add_zero]
    · have hd : d ≠ 0 := fun h => hl (hdz.mp h)
      obtain ⟨x0, hx0⟩ : ∃ x0, lam x0 ≠ 0 := by
        by_contra h
        push_neg at h
        exact hl (LinearMap.ext h)
      obtain ⟨x1, hx1⟩ : ∃ x1, lam x1 = 1 :=
        ⟨(lam x0)⁻¹ • x0, by rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hx0]⟩
      have hA : ∀ x y, lam x * B d y = lam y * B d x := by
        intro x y
        have h := hiso gγ hγJ x y
        rw [hgγf, hgγf] at h
        simp only [hBadd1, hBadd2, hBsm1, hBsm2] at h
        have hdd := hBzero d
        have hxd := hBalt x d
        linear_combination h - lam y * hxd - lam x * lam y * hdd
      set κ := B d x1 with hκdef
      have hBd : ∀ y, B d y = lam y * κ := by
        intro y
        have h := hA x1 y
        rw [hx1, one_mul] at h
        exact h
      have hκ : κ ≠ 0 := by
        intro h0
        apply hd
        apply hBnd
        intro y
        rw [hBd, h0, mul_zero]
      have hBd' : ∀ y, B (fr ρb d) y = lam (fr ρ y) * κ := by
        intro y
        rw [← hiso (fr ρ) hhJ, hρb2, hBd]
      set x2 := fr ρb x1 with hx2def
      have hφx2 : lam (fr ρ x2) = 1 := by rw [hx2def, hρb2, hx1]
      set w' := g x2 - x2 with hw'def
      have hD : ∀ x, g x = x + lam (fr ρ x) • w' := by
        intro x
        have h0 : lam (fr ρ (x - lam (fr ρ x) • x2)) = 0 := by
          rw [map_sub, map_smul, map_sub, map_smul, hφx2, smul_eq_mul, mul_one, sub_self]
        have h := hfixρ _ h0
        rw [map_sub, map_smul] at h
        calc g x = (g x - lam (fr ρ x) • g x2) + lam (fr ρ x) • g x2 :=
              (sub_add_cancel _ _).symm
          _ = (x - lam (fr ρ x) • x2) + lam (fr ρ x) • g x2 := by rw [h]
          _ = x + lam (fr ρ x) • w' := by rw [hw'def, smul_sub]; abel
      set κ' := B w' x2 with hκ'def
      have hBw : ∀ y, B w' y = lam (fr ρ y) * κ' := by
        intro y
        have h := hiso g hgJ x2 y
        rw [hD x2, hD y, hφx2] at h
        simp only [hBadd1, hBadd2, hBsm1, hBsm2] at h
        have hww := hBzero w'
        have hxw := hBalt x2 w'
        linear_combination h - lam (fr ρ y) * hxw - lam (fr ρ y) * hww
      have hw' : w' = (κ' * κ⁻¹) • fr ρb d := by
        have h0 : w' - (κ' * κ⁻¹) • fr ρb d = 0 := by
          apply hBnd
          intro y
          rw [hBsub1, hBsm1, hBw, hBd']
          field_simp
          ring
        exact sub_eq_zero.mp h0
      refine ⟨κ' * κ⁻¹, fun x => ?_⟩
      rw [hD x, hw', smul_smul, mul_comm (lam (fr ρ x))]
  obtain ⟨c0, hc0⟩ := hLA
  exact ⟨ρ, ρb, fr ρ, fr ρb, c0, hρw, hρbw, hfr ρ, hfr ρb, hρb1, hc0⟩

theorem wc_pencil_honest_PL_of_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP) (hπ : wcPencilConj π)
    (W₀ : (wcP1Over F'').left.ProEt) (w₀ : W₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (N₀ : ℕ)
    (θ₀ : (Subobject.underlying.obj (⊤ : Subobject (wcRq D.f ℓ (n - 1)))).over W₀ ≅
      (wcContSheaf (wcP1Over F'').left (Fin N₀ → ℚ_[ℓ])).over W₀)
    (hqc₀ : QuasiCompact w₀.left) (hconn₀ : ConnectedSpace W₀.left)
    (hcov₀ : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W₀.left, w₀.left z = p)
    (hgal₀ : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W₀), ConnectedSpace V.left →
      a ≫ w₀ = b ≫ w₀ → ∃ γ : W₀ ⟶ W₀, γ ≫ w₀ = w₀ ∧ b = a ≫ γ) :
    Nonempty (wcHonestPL D ℓ hP) :=
by
  classical

  obtain ⟨W, w, r, θ, hθc, hqc, hconn, hoff, hcov, hgal⟩ :=
    wc_pencil_PL_galois_cover F' F'' Y n hn hn2 D ℓ hℓ hP
  haveI := hconn
  have hcancel1 : ∀ (T : Over W)
      (s : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id

  have hs3 : ∀ σ : W ⟶ W, ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ σ = u →
      ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk u))).hom t).down) z =
      A ((show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) z) := by
    intro σ
    let θσ : (wcRq D.f ℓ (n - 1)).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W :=
      ⟨{ app := fun T => θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ σ = u →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t =
          (θ.hom.hom.app (Opposite.op (Over.mk u))).hom t := by
      rintro V' c u rfl t
      rfl
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ W hconn r r
      (θ.inv ≫ θσ)
    have hPt : ∀ (T : Over W)
        (c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin r → ℚ_[ℓ]) from
          (((θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    refine ⟨A, ?_⟩
    intro V' c u hcu t z
    have e1 : ((θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk c))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) =
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk c))).hom (hcancel1 (Over.mk c) t)
    have E := e1.trans (hres V' c u hcu t)
    have h1 := hPt (Over.mk c) ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin r → ℚ_[ℓ]) => y.down z) E
    exact h4.symm.trans h1

  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty
  have hconst : ∀ v : Fin r → ℚ_[ℓ], ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) hs
  have huniq : ∀ (γ : W ⟶ W) (g g' : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      wcHonestFrame D ℓ W r θ γ g → wcHonestFrame D ℓ W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply LinearMap.ext
    intro v
    obtain ⟨s, hs⟩ := hconst v
    have h1 := hg s z₀
    have h2 := hg' s z₀
    rw [hs z₀] at h1 h2
    exact h1.symm.trans h2

  choose fr hfr0 using hs3
  have hfr : ∀ γ : W ⟶ W, wcHonestFrame D ℓ W r θ γ (fr γ) := by
    intro γ s z
    exact hfr0 γ W (𝟙 W) γ (Category.id_comp γ) s z
  have hfr1 : fr (𝟙 W) = LinearMap.id := by
    apply huniq (𝟙 W) _ _ (hfr _)
    intro s z
    rfl
  have hcomp : ∀ γ γ' : W ⟶ W, fr (γ ≫ γ') = fr γ' ∘ₗ fr γ := by
    intro γ γ'
    apply huniq (γ ≫ γ') _ _ (hfr _)
    intro s z
    rw [LinearMap.comp_apply, ← hfr γ s z]
    exact hfr0 γ' W γ (γ ≫ γ') rfl s z
  have hinv : ∀ σ : W ⟶ W, σ ≫ w = w → ∃ σ' : W ⟶ W, σ' ≫ w = w ∧
      (∀ x, fr σ' (fr σ x) = x) ∧ (∀ x, fr σ (fr σ' x) = x) := by
    have hl : ∀ σ : W ⟶ W, σ ≫ w = w →
        ∃ σ' : W ⟶ W, σ' ≫ w = w ∧ ∀ x, fr σ' (fr σ x) = x := by
      intro σ hσ
      obtain ⟨σ', hσ', he⟩ := hgal W σ (𝟙 W) hconn (by rw [hσ, Category.id_comp])
      refine ⟨σ', hσ', fun x => ?_⟩
      have := congrArg (fun γ => fr γ x) he
      simp only [hfr1, hcomp, LinearMap.id_apply, LinearMap.comp_apply] at this
      exact this.symm
    intro σ hσ
    obtain ⟨σ', hσ', h1⟩ := hl σ hσ
    obtain ⟨ρ, -, h2⟩ := hl σ' hσ'
    have hρ : ∀ y, fr ρ y = fr σ y := fun y => by
      calc fr ρ y = fr ρ (fr σ' (fr σ y)) := by rw [h1]
        _ = fr σ y := h2 _
    exact ⟨σ', hσ', h1, fun x => (hρ _).symm.trans (h2 x)⟩

  have hdata : ∃ (d : Fin D.m → (Fin r → ℚ_[ℓ]))
      (lam : Fin D.m → Module.Dual ℚ_[ℓ] (Fin r → ℚ_[ℓ])),
      (∀ i, d i = 0 ↔ lam i = 0) ∧
      (∀ i, ∃ γ : W ⟶ W, γ ≫ w = w ∧ ∀ x, fr γ x = x + lam i x • d i) ∧
      (∀ i i' : Fin D.m, ∃ (γ : W ⟶ W) (c : ℚ_[ℓ]), γ ≫ w = w ∧ c ≠ 0 ∧
        fr γ (d i) = c • d i' ∧ ∀ x, lam i' (fr γ x) = c⁻¹ * lam i x) ∧
      (∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
        (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)]
        (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
        ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ W) (z : V'.left),
          a ≫ v = b ≫ w ∧
          (∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
            (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
              (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = 0 → s = 0) ∧
          ∀ x : Fin r → ℚ_[ℓ], lam i x = 0 ↔
            ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
              (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
                (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = x) := by
    rcases Nat.eq_zero_or_pos D.m with hm0 | hmpos
    · refine ⟨fun _ => 0, fun _ => 0, ?_, ?_, ?_, ?_⟩
      · intro i; exact absurd i.2 (by omega)
      · intro i; exact absurd i.2 (by omega)
      · intro i; exact absurd i.2 (by omega)
      · intro i; exact absurd i.2 (by omega)
    · have hs1 := fun i => wc_pencil_PL_local_inertia F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc
        hqc hconn hoff hcov hgal i
      choose γl hγlw gl hgl u d' hgf hlocl using hs1
      have hglfr : ∀ i, gl i = fr (γl i) := fun i => huniq _ _ _ (hgl i) (hfr _)
      let H : Fin D.m → Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
        fun i => LinearMap.ker (gl i - LinearMap.id)
      have hHmem : ∀ i x, x ∈ H i ↔ gl i x = x := by
        intro i x
        show x ∈ LinearMap.ker (gl i - LinearMap.id) ↔ _
        rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, sub_eq_zero]
      have hH : ∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
          (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
          (A : Type u) [CommRing A] [HenselianLocalRing A]
          [IsSepClosed (IsLocalRing.ResidueField A)]
          (e : V.left ≅ Spec (.of A)),
          V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
          ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ W) (z : V'.left),
            a ≫ v = b ≫ w ∧
            (∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
              (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
                ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
                (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = 0 → s = 0) ∧
            ∀ x : Fin r → ℚ_[ℓ], x ∈ H i ↔
              ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
                (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
                  ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
                  (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = x := by
        intro i V v A _ _ _ e hV
        obtain ⟨V', a, b, z, h1, h2, h3⟩ := hlocl i V v A e hV
        exact ⟨V', a, b, z, h1, h2, fun x => (hHmem i x).trans (h3 x)⟩
      let i₀ : Fin D.m := ⟨0, hmpos⟩
      have hnorm : ∃ (d₀ : Fin r → ℚ_[ℓ]) (lam₀ : Module.Dual ℚ_[ℓ] (Fin r → ℚ_[ℓ])),
          (d₀ = 0 ↔ lam₀ = 0) ∧ (∀ x, gl i₀ x = x + lam₀ x • d₀) ∧
          (∀ x, lam₀ x = 0 ↔ x ∈ H i₀) := by
        by_cases hc : d' i₀ ≠ 0 ∧ u i₀ ≠ 0
        · let L : Module.Dual ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
            { toFun := fun x => dotProduct (u i₀) x
              map_add' := fun x y => dotProduct_add _ _ _
              map_smul' := fun c x => by rw [dotProduct_smul, RingHom.id_apply] }
          refine ⟨d' i₀, L, ⟨fun h => absurd h hc.1, fun hL => ?_⟩, fun x => hgf i₀ x, ?_⟩
          · exfalso
            apply hc.2
            funext j
            have := LinearMap.congr_fun hL (Pi.single j 1)
            simpa [L, dotProduct_single_one] using this
          · intro x
            rw [hHmem, hgf i₀ x]
            constructor
            · intro h
              have h' : dotProduct (u i₀) x = 0 := h
              rw [h', zero_smul, add_zero]
            · intro h
              have h2 : dotProduct (u i₀) x • d' i₀ = 0 := by
                have := congrArg (fun y => y - x) h
                simpa using this
              exact (smul_eq_zero.mp h2).resolve_right hc.1
        · have hid : ∀ x, gl i₀ x = x := by
            intro x
            rw [hgf i₀ x]
            rcases not_and_or.mp hc with h | h
            · push_neg at h
              rw [h, smul_zero, add_zero]
            · push_neg at h
              rw [h, zero_dotProduct, zero_smul, add_zero]
          refine ⟨0, 0, ⟨fun _ => rfl, fun _ => rfl⟩, fun x => ?_, fun x => ?_⟩
          · rw [hid x]
            simp
          · rw [hHmem, hid x]
            simp
      obtain ⟨d₀, lam₀, hd0, hform, hlam0H⟩ := hnorm
      have hs5 := fun i => wc_pencil_honest_fix_conj F' F'' Y n hn hn2 D ℓ hℓ hP π hπ W w r θ hθc
        hqc hconn hoff hcov hgal H hH i₀ i
      choose σ gσ hσw hσfr hσH using hs5
      have hgσ : ∀ i, gσ i = fr (σ i) := fun i => huniq _ _ _ (hσfr i) (hfr _)
      choose σb hσbw hσb1 hσb2 using fun i => hinv (σ i) (hσw i)
      refine ⟨fun i => fr (σ i) d₀, fun i => lam₀ ∘ₗ fr (σb i), ?_, ?_, ?_, ?_⟩
      · intro i
        constructor
        · intro h
          have h0 : d₀ = 0 := by
            have := hσb1 i d₀
            rw [show fr (σ i) d₀ = 0 from h, map_zero] at this
            exact this.symm
          show lam₀ ∘ₗ fr (σb i) = 0
          rw [hd0.mp h0, LinearMap.zero_comp]
        · intro h
          have hl0 : lam₀ = 0 := by
            apply LinearMap.ext
            intro x
            have := LinearMap.congr_fun h (fr (σ i) x)
            rw [LinearMap.comp_apply, hσb1] at this
            exact this
          show fr (σ i) d₀ = 0
          rw [hd0.mpr hl0, map_zero]
      · intro i
        refine ⟨σb i ≫ γl i₀ ≫ σ i, by rw [Category.assoc, Category.assoc, hσw, hγlw, hσbw],
          fun x => ?_⟩
        show fr (σb i ≫ γl i₀ ≫ σ i) x = x + (lam₀ ∘ₗ fr (σb i)) x • fr (σ i) d₀
        rw [hcomp, hcomp, LinearMap.comp_apply, LinearMap.comp_apply, ← hglfr i₀, hform,
          map_add, map_smul, hσb2, LinearMap.comp_apply]
      · intro i i'
        refine ⟨σb i ≫ σ i', 1, by rw [Category.assoc, hσw, hσbw], one_ne_zero, ?_, fun x => ?_⟩
        · show fr (σb i ≫ σ i') (fr (σ i) d₀) = (1 : ℚ_[ℓ]) • fr (σ i') d₀
          rw [hcomp, LinearMap.comp_apply, hσb1, one_smul]
        · show (lam₀ ∘ₗ fr (σb i')) (fr (σb i ≫ σ i') x) = 1⁻¹ * (lam₀ ∘ₗ fr (σb i)) x
          simp only [hcomp, LinearMap.comp_apply, hσb1, inv_one, one_mul]
      · intro i V v A _ _ _ e hV
        obtain ⟨V', a, b, z, h1, h2, h3⟩ := hlocl i V v A e hV
        refine ⟨V', a, b, z, h1, h2, fun x => Iff.trans ?_ (h3 x)⟩
        show lam₀ (fr (σb i) x) = 0 ↔ gl i x = x
        rw [hlam0H, hσH i, hgσ i, hσb2, hHmem]
  obtain ⟨d, lam, hdz, htv, hconj, hloc⟩ := hdata

  have hs7 : ∀ (i : Fin D.m) (σ' : W ⟶ W), wcHonestIsInertia D hP W w i σ' →
      ∃ (h h' : W ⟶ W) (c : ℚ_[ℓ]), h ≫ w = w ∧ h' ≫ w = w ∧
        ∀ x, fr σ' x = x + (c * lam i (fr h x)) • fr h' (d i) := by
    intro i σ' hσ'
    obtain ⟨γ, hγw, hγf⟩ := htv i
    obtain ⟨h, h', gh, gh', c, hw, hw', hgh, hgh', -, hf⟩ :=
      wc_pencil_honest_inertia_PL F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc hconn hoff hcov
        hgal i γ hγw (lam i) (d i) (hdz i) (fr γ) (hfr γ) hγf (hloc i) σ' (fr σ') hσ' (hfr σ')
    refine ⟨h, h', c, hw, hw', fun x => ?_⟩
    rw [hf x, huniq h _ _ hgh (hfr h), huniq h' _ _ hgh' (hfr h')]
  let E : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) := Submodule.span ℚ_[ℓ]
    {v | ∃ (γ' : W ⟶ W) (i : Fin D.m), γ' ≫ w = w ∧ fr γ' (d i) = v}
  have hEstab : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ x ∈ E, fr γ x ∈ E := by
    intro γ hγ x hx
    induction hx using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨γ', i, hγ', rfl⟩ := hv
      apply Submodule.subset_span
      refine ⟨γ' ≫ γ, i, ?_, ?_⟩
      · rw [Category.assoc, hγ, hγ']
      · rw [hcomp]
        rfl
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      exact add_mem hx hy
    | smul a x _ hx =>
      rw [map_smul]
      exact Submodule.smul_mem _ a hx
  have hrange : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ x, fr γ x - x ∈ E := by
    intro γ hγ x
    have hst : ∀ (γ' : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
        γ' ≫ w = w → wcHonestFrame D ℓ W r θ γ' g →
        ∀ y ∈ (⊤ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])), g y ∈ (⊤ : Submodule ℚ_[ℓ] _) ∧
          (y ∈ E → g y ∈ E) := by
      intro γ' g hγ' hg y _
      rw [huniq γ' _ _ hg (hfr γ')]
      exact ⟨Submodule.mem_top, hEstab γ' hγ' y⟩
    have hin : ∀ (i : Fin D.m) (σ' : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
        wcHonestIsInertia D hP W w i σ' → wcHonestFrame D ℓ W r θ σ' g →
        ∀ y ∈ (⊤ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])), g y - y ∈ E := by
      intro i σ' g hσ' hg y _
      rw [huniq σ' _ _ hg (hfr σ')]
      obtain ⟨h, h', c, -, hw', hf⟩ := hs7 i σ' hσ'
      rw [hf y, add_sub_cancel_left]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨h', i, hw', rfl⟩)
    exact wc_pencil_honest_monodromy_generated F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc hconn
      hoff hcov hgal E ⊤ le_top hst hin γ (fr γ) hγ (hfr γ) x Submodule.mem_top
  have hgen : ∀ U : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
      (∀ (γ : W ⟶ W) (i : Fin D.m), γ ≫ w = w → ∀ u ∈ U, lam i (fr γ u) = 0) →
      ∀ γ : W ⟶ W, γ ≫ w = w → ∀ u ∈ U, fr γ u = u := by
    intro U hU γ hγ u hu
    let U₂ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) := Submodule.span ℚ_[ℓ]
      {v | ∃ (γ' : W ⟶ W) (u' : Fin r → ℚ_[ℓ]), γ' ≫ w = w ∧ u' ∈ U ∧ fr γ' u' = v}
    have hU2stab : ∀ γ' : W ⟶ W, γ' ≫ w = w → ∀ y ∈ U₂, fr γ' y ∈ U₂ := by
      intro γ' hγ' y hy
      induction hy using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨γ'', u', hγ'', hu', rfl⟩ := hv
        apply Submodule.subset_span
        refine ⟨γ'' ≫ γ', u', ?_, hu', ?_⟩
        · rw [Category.assoc, hγ', hγ'']
        · rw [hcomp]
          rfl
      | zero => simp
      | add x y _ _ hx hy =>
        rw [map_add]
        exact add_mem hx hy
      | smul a x _ hx =>
        rw [map_smul]
        exact Submodule.smul_mem _ a hx
    have hU2lam : ∀ (h : W ⟶ W) (i : Fin D.m), h ≫ w = w → ∀ y ∈ U₂, lam i (fr h y) = 0 := by
      intro h i hh y hy
      induction hy using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨γ'', u', hγ'', hu', rfl⟩ := hv
        have := hU (γ'' ≫ h) i (by rw [Category.assoc, hh, hγ'']) u' hu'
        rwa [hcomp, LinearMap.comp_apply] at this
      | zero => simp
      | add x y _ _ hx hy => rw [map_add, map_add, hx, hy, add_zero]
      | smul a x _ hx => rw [map_smul, map_smul, hx, smul_zero]
    have hmem : u ∈ U₂ :=
      Submodule.subset_span ⟨𝟙 W, u, Category.id_comp w, hu, by rw [hfr1]; rfl⟩
    have hst : ∀ (γ' : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
        γ' ≫ w = w → wcHonestFrame D ℓ W r θ γ' g →
        ∀ y ∈ U₂, g y ∈ U₂ ∧ (y ∈ (⊥ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) →
          g y ∈ (⊥ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]))) := by
      intro γ' g hγ' hg y hy
      rw [huniq γ' _ _ hg (hfr γ')]
      refine ⟨hU2stab γ' hγ' y hy, fun h0 => ?_⟩
      rw [Submodule.mem_bot] at h0 ⊢
      rw [h0, map_zero]
    have hin : ∀ (i : Fin D.m) (σ' : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
        wcHonestIsInertia D hP W w i σ' → wcHonestFrame D ℓ W r θ σ' g →
        ∀ y ∈ U₂, g y - y ∈ (⊥ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) := by
      intro i σ' g hσ' hg y hy
      rw [huniq σ' _ _ hg (hfr σ')]
      obtain ⟨h, h', c, hw, -, hf⟩ := hs7 i σ' hσ'
      rw [hf y, add_sub_cancel_left, hU2lam h i hw y hy, mul_zero, zero_smul]
      exact Submodule.zero_mem _
    have key := wc_pencil_honest_monodromy_generated F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc
      hconn hoff hcov hgal ⊥ U₂ bot_le hst hin γ (fr γ) hγ (hfr γ) u hmem
    rw [Submodule.mem_bot, sub_eq_zero] at key
    exact key
  exact ⟨⟨W, w, r, θ, hθc, hqc, hconn, hcov, hgal, fr, fun γ _ => hfr γ, hfr1,
    fun γ γ' _ _ => hcomp γ γ', d, lam, hdz, htv, hconj, hrange, hgen, hloc⟩⟩

theorem wc_epsInv_no_punct_of_cospec (B : Scheme.{u})
    (H : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (Z : Set B) (hZ : IsClosed Z)
    (hcosp : ∀ (V : B.Etale) (h : H.obj.obj (Opposite.op V)) (v v' : V.left),
      V.hom v ∈ Z → v' ⤳ v → V.hom v' ∉ Z →
      (∃ (W : B.Etale) (f : W ⟶ V), v' ∈ Set.range f.left ∧ (H.obj.map f.op).hom h = 0) →
      ∃ (W : B.Etale) (f : W ⟶ V), v ∈ Set.range f.left ∧ (H.obj.map f.op).hom h = 0)
    (hgen : ∀ (T : B.ProEt) (t : T.left), T.hom t ∈ Z → ∃ t' : T.left, t' ⤳ t ∧ T.hom t' ∉ Z) :
    ∀ (T : B.ProEt) (y : ((wcEpsInv B).obj H).obj.obj (Opposite.op T)),
      (∀ (V : B.ProEt) (h : V ⟶ T), (∀ v : V.left, V.hom v ∉ Z) →
        (((wcEpsInv B).obj H).obj.map h.op).hom y = 0) → y = 0 :=
by
  intro T y hy
  classical

  have opensub : ∀ (X : B.ProEt) (E : Set X.left), IsOpen E →
      ∃ (X' : B.ProEt) (ι : X' ⟶ X), Set.range ι.left = E := by
    intro X E hE
    obtain ⟨U, hUE⟩ : ∃ U : X.left.Opens, (U : Set X.left) = E := ⟨⟨E, hE⟩, rfl⟩
    have hW : WeaklyEtale (U.ι ≫ X.hom) := by
      haveI : WeaklyEtale X.hom := X.prop
      haveI : WeaklyEtale U.ι := etale_le_weaklyEtale _ _ _ inferInstance
      infer_instance
    refine ⟨MorphismProperty.Over.mk ⊤ (U.ι ≫ X.hom) hW,
      MorphismProperty.Over.homMk U.ι rfl trivial, ?_⟩
    show Set.range U.ι = E
    rw [Scheme.Opens.range_ι, hUE]

  have key : ∃ η : ∀ V : B.Etale, H.obj.obj (Opposite.op V) →
        ((wcEpsInv B).obj H).obj.obj (Opposite.op ((wcEtToProEt B).obj V)),
      (∀ V, Function.Bijective (η V)) ∧ (∀ V, η V 0 = 0) ∧
      ∀ (V₁ V₂ : B.Etale) (b : V₂ ⟶ V₁) (h : H.obj.obj (Opposite.op V₁)),
        η V₂ ((H.obj.map b.op).hom h) =
          (((wcEpsInv B).obj H).obj.map ((wcEtToProEt B).map b).op).hom (η V₁ h) := by
    haveI := (wc_etToProEt_flat_cont B).2
    haveI hiso := wc_epsInv_unit_iso B H
    haveI : IsIso ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt B)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.ProEt.topology B)).unit.app H).hom :=
      (inferInstance : IsIso ((sheafToPresheaf _ _).map
        ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt B)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.ProEt.topology B)).unit.app H)))
    refine ⟨fun V h => ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt B)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.ProEt.topology B)).unit.app H).hom.app
          (Opposite.op V) h, fun V => ?_, fun V => map_zero _, fun V₁ V₂ b h => ?_⟩
    · exact (ConcreteCategory.isIso_iff_bijective _).mp inferInstance
    · exact NatTrans.naturality_apply ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
        (wcEtToProEt B) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B)
        (Scheme.ProEt.topology B)).unit.app H).hom b.op h
  obtain ⟨η, hηbij, hη0, hηnat⟩ := key

  have hmap : ∀ {X Y W : B.ProEt} (a : X ⟶ Y) (b : Y ⟶ W)
      (z : ((wcEpsInv B).obj H).obj.obj (Opposite.op W)),
      ((wcEpsInv B).obj H).obj.map (a ≫ b).op z =
        ((wcEpsInv B).obj H).obj.map a.op (((wcEpsInv B).obj H).obj.map b.op z) := by
    intro X Y W a b z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have hw : ∀ {X Y : B.ProEt} (k : X ⟶ Y) (x : X.left), X.hom x = Y.hom (k.left x) := by
    intro X Y k x
    rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
  have happ : ∀ {X Y W : B.ProEt} (a : X ⟶ Y) (b : Y ⟶ W) (x : X.left),
      (a ≫ b).left x = b.left (a.left x) := fun a b x => rfl

  obtain ⟨O, hO, hZL⟩ := wc_epsInv_zero_locus B H T y

  have hOff : ∀ t : T.left, T.hom t ∉ Z → t ∈ O := by
    have hEopen : IsOpen (T.hom ⁻¹' Zᶜ) := hZ.isOpen_compl.preimage T.hom.continuous
    obtain ⟨T0, ι, hι⟩ := opensub T _ hEopen
    have h0 : ((wcEpsInv B).obj H).obj.map ι.op y = 0 := by
      refine hy T0 ι (fun v hv => ?_)
      have hv' : ι.left v ∈ T.hom ⁻¹' Zᶜ := by rw [← hι]; exact ⟨v, rfl⟩
      exact hv' (by rw [← hw ι v]; exact hv)
    have hsub := (hZL T0 ι).mp h0
    intro t ht
    apply hsub
    rw [hι]
    exact ht

  have hall : ∀ t : T.left, t ∈ O := by
    intro t
    by_cases ht : T.hom t ∈ Z
    swap
    · exact hOff t ht
    obtain ⟨W, f, V₁, c, s₀, ⟨w, hwt⟩, hP⟩ := wc_epsInv_locally_etale_section B H T y t
    obtain ⟨h, hh⟩ := (hηbij V₁).2 s₀
    obtain ⟨O₁, hO₁, hZL₁⟩ := wc_epsInv_zero_locus B H ((wcEtToProEt B).obj V₁) s₀

    have htr : ∀ (V₂ : B.Etale) (e : V₂ ⟶ V₁),
        (H.obj.map e.op).hom h = 0 ↔ Set.range e.left ⊆ O₁ := by
      intro V₂ e
      have h1 : ((wcEpsInv B).obj H).obj.map ((wcEtToProEt B).map e).op s₀ =
          η V₂ ((H.obj.map e.op).hom h) := by
        rw [hηnat V₁ V₂ e h, hh]
      constructor
      · intro he
        exact (hZL₁ _ ((wcEtToProEt B).map e)).mp (by rw [h1, he, hη0])
      · intro hsub
        have h2 := (hZL₁ _ ((wcEtToProEt B).map e)).mpr hsub
        rw [h1, ← hη0 V₂] at h2
        exact (hηbij V₂).1 h2

    have hfc : ∀ (W' : B.ProEt) (k : W' ⟶ W),
        Set.range (k ≫ f).left ⊆ O ↔ Set.range (k ≫ c).left ⊆ O₁ := by
      intro W' k
      rw [← hZL W' (k ≫ f), ← hZL₁ W' (k ≫ c), hmap, hmap, hP]
    have hWw : W.hom w ∈ Z := by rw [hw f w, hwt]; exact ht
    obtain ⟨w', hsp, hw'⟩ := hgen W w hWw
    have hfw' : f.left w' ∈ O := hOff _ (by rw [← hw f w']; exact hw')

    obtain ⟨WN, ιN, hιN⟩ := opensub W (f.left ⁻¹' O) (hO.preimage f.left.continuous)
    have hcw' : c.left w' ∈ O₁ := by
      have h1 : Set.range (ιN ≫ f).left ⊆ O := by
        rintro _ ⟨x, rfl⟩
        have hx : ιN.left x ∈ f.left ⁻¹' O := by rw [← hιN]; exact ⟨x, rfl⟩
        rw [happ]
        exact hx
      have h2 := (hfc WN ιN).mp h1
      obtain ⟨x, hx⟩ : w' ∈ Set.range ιN.left := by rw [hιN]; exact hfw'
      have h3 := h2 ⟨x, rfl⟩
      rw [happ, hx] at h3
      exact h3

    obtain ⟨V₂, e, he, -, -⟩ := wc_etale_open_subobject B V₁ O₁ hO₁
    have hhe : (H.obj.map e.op).hom h = 0 := (htr V₂ e).mpr he.le
    have hv1 : V₁.hom (c.left w) ∈ Z := by
      have e1 : V₁.hom (c.left w) = W.hom w := (hw c w).symm
      rw [e1]; exact hWw
    have hv2 : V₁.hom (c.left w') ∉ Z := by
      have e1 : V₁.hom (c.left w') = W.hom w' := (hw c w').symm
      rw [e1]; exact hw'
    obtain ⟨W₂, g, hcw, hg⟩ := hcosp V₁ h (c.left w) (c.left w') hv1
      (hsp.map c.left.continuous) hv2 ⟨V₂, e, by rw [he]; exact hcw', hhe⟩
    have hcwO : c.left w ∈ O₁ := (htr W₂ g).mp hg hcw

    obtain ⟨W0, ι0, hι0⟩ := opensub W (c.left ⁻¹' O₁) (hO₁.preimage c.left.continuous)
    have h1 : Set.range (ι0 ≫ c).left ⊆ O₁ := by
      rintro _ ⟨x, rfl⟩
      have hx : ι0.left x ∈ c.left ⁻¹' O₁ := by rw [← hι0]; exact ⟨x, rfl⟩
      rw [happ]
      exact hx
    have h2 := (hfc W0 ι0).mpr h1
    obtain ⟨x, hx⟩ : w ∈ Set.range ι0.left := by rw [hι0]; exact hcwO
    have h3 := h2 ⟨x, rfl⟩
    rw [happ, hx, hwt] at h3
    exact h3

  have h1 := (hZL T (𝟙 T)).mpr (fun x _ => hall x)
  have h2 : ((wcEpsInv B).obj H).obj.map (𝟙 (Opposite.op T)) = 𝟙 _ :=
    CategoryTheory.Functor.map_id _ _
  rw [op_id, h2] at h1
  simpa using h1

theorem wc_P1_etale_generization_unique (K : Type u) [Field K]
    (s : Spec (.of K) ⟶ (wcP1Over K).left) (hs : s ≫ (wcP1Over K).hom = 𝟙 _)
    (V : (wcP1Over K).left.Etale) (v w w' : V.left)
    (hv : V.hom v = s (IsLocalRing.closedPoint K))
    (hw : w ⤳ v) (hw' : w' ⤳ v)
    (hwv : V.hom w ≠ V.hom v) (hw'v : V.hom w' ≠ V.hom v) : w = w' :=
by
  classical
  haveI hPp : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI hLN : IsLocallyNoetherian (wcP1Over K).left :=
    LocallyOfFiniteType.isLocallyNoetherian (wcP1Over K).hom
  haveI : IsLocallyNoetherian ((Functor.fromPUnit (wcP1Over K).left).obj V.right) := hLN
  haveI : Etale V.hom := V.prop

  have hP : wcIsDVR ((wcP1Over K).left.presheaf.stalk (s (IsLocalRing.closedPoint K))) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    set x := s (IsLocalRing.closedPoint K) with hxdef

    haveI hsub : Subsingleton (Spec (.of K)) := by
      show Subsingleton (PrimeSpectrum K); infer_instance
    have hxcl : IsClosed ({x} : Set (wcP1Over K).left) := by
      haveI := isClosedImmersion_of_comp_eq_id (wcP1Over K).hom s hs
      have hr : IsClosed (Set.range s) := s.isClosedEmbedding.isClosed_range
      have e : Set.range s = {x} := by
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        constructor
        · rintro ⟨p, rfl⟩; rw [Subsingleton.elim p (IsLocalRing.closedPoint K)]
        · rintro rfl; exact ⟨_, rfl⟩
      rw [← e]; exact hr

    have hcov := wc_pp_basicOpen_cover K 1
    have hxtop : x ∈ (⊤ : (wcP1Over K).left.Opens) := trivial
    rw [← hcov, TopologicalSpace.Opens.mem_iSup] at hxtop
    obtain ⟨a, hxU⟩ := hxtop
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
    have hU : IsAffineOpen (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a)) :=
      Proj.isAffineOpen_basicOpen _ (MvPolynomial.X a) hXa one_pos

    obtain ⟨e₂, -⟩ := wc_pp_dehomogenize_ringEquiv K 1 a
    let e₃ := (Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X a) hXa one_pos).commRingCatIsoToRingEquiv
    let e₁ : Polynomial K ≃+* MvPolynomial (Fin 1) K :=
      ((MvPolynomial.pUnitAlgEquiv.{u, 0} K).symm.toRingEquiv).trans
        (MvPolynomial.renameEquiv K (Equiv.equivPUnit.{1, 1} (Fin 1)).symm).toRingEquiv
    let E := (e₁.trans e₂).trans e₃
    haveI hRdom : IsDomain Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a)) :=
      Function.Injective.isDomain E.symm.toRingHom (by exact E.symm.injective)
    haveI hRpid : IsPrincipalIdealRing Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a)) :=
      IsPrincipalIdealRing.of_surjective E.toRingHom (by exact E.surjective)
    haveI hRded : IsDedekindDomain Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a)) :=
      IsPrincipalIdealRing.isDedekindDomain _
    have hnf : ¬ IsField Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a)) := by
      intro h
      apply Polynomial.not_isField K
      first
      | exact MulEquiv.isField h E.toMulEquiv
      | exact MulEquiv.isField h E.symm.toMulEquiv

    have hfp := hU.fromSpec_primeIdealOf ⟨x, hxU⟩
    have hpre : hU.fromSpec ⁻¹' {x} = {hU.primeIdealOf ⟨x, hxU⟩} := by
      ext p
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hp
        apply hU.fromSpec.isOpenEmbedding.injective
        rw [hp, hfp]
      · rintro rfl; exact hfp
    have hpcl : IsClosed ({hU.primeIdealOf ⟨x, hxU⟩} : Set (Spec Γ((wcP1Over K).left,
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (MvPolynomial.X a)))) := by
      rw [← hpre]; exact hxcl.preimage hU.fromSpec.continuous
    have hmax : (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hpcl
    have hne : (hU.primeIdealOf ⟨x, hxU⟩).asIdeal ≠ ⊥ := by
      intro h0
      apply hnf
      rw [Ring.isField_iff_maximal_bot, ← h0]
      exact hmax

    let xU : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) : (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).Opens) :=
      ⟨x, hxU⟩
    letI : Algebra Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a))
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).presheaf.stalk
          (xU : Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) :=
      TopCat.Presheaf.algebra_section_stalk _ xU
    haveI := hU.isLocalization_stalk xU
    haveI hSdom : IsDomain ((Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).presheaf.stalk
        (xU : Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) :=
      IsLocalization.isDomain_of_atPrime _ (hU.primeIdealOf xU).asIdeal
    have hdvr : IsDiscreteValuationRing
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).presheaf.stalk
          (xU : Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain _ hne _
    exact ⟨hSdom, hdvr⟩

  have hV : wcIsDVR (V.left.presheaf.stalk v) := by
    rw [← hv] at hP
    exact (wc_etale_stalk_dvr V.hom v hP).1

  obtain ⟨hdom, hdvr⟩ := hV
  have key : ∀ y : V.left, y ≠ v → ∀ q : PrimeSpectrum (V.left.presheaf.stalk v),
      V.left.fromSpecStalk v q = y → q.asIdeal = ⊥ := by
    intro y hyv q hq
    by_contra hne
    apply hyv
    have hmax : q.asIdeal = IsLocalRing.maximalIdeal _ := by
      obtain ⟨_, P, _, huniq⟩ :=
        (IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime _).mp hdvr
      have h1 := huniq q.asIdeal ⟨hne, q.isPrime⟩
      have h2 := huniq (IsLocalRing.maximalIdeal _)
        ⟨IsDiscreteValuationRing.not_a_field _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩
      rw [h1, h2]
    have hq' : q = IsLocalRing.closedPoint _ := PrimeSpectrum.ext hmax
    rw [← hq, hq', Scheme.fromSpecStalk_closedPoint]
  have hwne : w ≠ v := fun h => hwv (by rw [h])
  have hw'ne : w' ≠ v := fun h => hw'v (by rw [h])
  have hwr : w ∈ Set.range (V.left.fromSpecStalk v) := by
    rw [Scheme.range_fromSpecStalk]; exact hw
  have hw'r : w' ∈ Set.range (V.left.fromSpecStalk v) := by
    rw [Scheme.range_fromSpecStalk]; exact hw'
  obtain ⟨q, hq⟩ := hwr
  obtain ⟨q', hq'⟩ := hw'r
  have hqq : q = q' :=
    PrimeSpectrum.ext ((key w hwne q hq).trans (key w' hw'ne q' hq').symm)
  rw [← hq, ← hq', hqq]

theorem wc_et_push_homology_cospec_germ_of_pull_inj {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g]
    (m : ℕ) (hm : m ≠ 0)
