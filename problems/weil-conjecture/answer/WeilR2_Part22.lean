    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k)) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    ∃ θ : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧,
      ∀ j : ℕ, j • (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcEtSuppUnitMap Dx)) ≫ θ) = 0 →
