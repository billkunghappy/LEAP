  have c3 : ∀ (X W : Scheme.{u}) (f0 : X ⟶ Spec (.of K)) (φ : W ⟶ X) [Etale φ] (x₀ : Spec (.of K) ⟶ X), x₀ ≫ f0 = 𝟙 _ → ∀ (w₀ : W), φ w₀ = x₀ (IsLocalRing.closedPoint K) → (∀ w : W, φ w = x₀ (IsLocalRing.closedPoint K) → w = w₀) → ∃ v₀ : Spec (.of K) ⟶ W, v₀ ≫ φ = x₀ ∧ v₀ (IsLocalRing.closedPoint K) = w₀ := by
    intro X W f0 φ _ x₀ hsec0 w₀ hw₀ huniq0
