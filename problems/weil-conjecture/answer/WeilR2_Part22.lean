        exact Nat.le_of_dvd Nat.card_pos (addOrderOf_dvd_natCard w)
      have hcardeq : Nat.card G = ℓ ^ t := le_antisymm hcard hle2
      have hcyc : IsAddCyclic G := isAddCyclic_of_addOrderOf_eq_card w (hto.trans hcardeq.symm)
      exact ⟨(ZMod.ringEquivCongr hcardeq.symm).toAddEquiv.trans (zmodAddCyclicAddEquiv hcyc)⟩

