theorem wc_closed_fibre_quad_cone_chart : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (XA U : Scheme.{u}) (sA : XA ⟶ Spec (.of A)) (jU : U ⟶ XA) (eU : U ⟶ Spec (.of (wcQuadModelRing A n π c))), Etale jU → Etale eU → jU ≫ sA = eU ≫ wcQuadModelStr A n π c → ∀ (u : U), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (eU u)) → ∀ (xs : ↥(Limits.pullback sA (wcQmSp A))), Limits.pullback.fst sA (wcQmSp A) xs = jU u → ∃ (W : Scheme.{u}) (_ : IsAffine W) (φW : W ⟶ Limits.pullback sA (wcQmSp A)) (_ : Etale φW) (ψ : W ⟶ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A))))) (_ : Etale ψ) (w₀ : W), φW w₀ = xs ∧ (∀ w : W, φW w = xs → w = w₀) ∧ (∀ w : W, ψ w = ψ w₀ → w = w₀) ∧ (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (ψ w₀)) ∧ φW ≫ Limits.pullback.snd sA (wcQmSp A) = ψ ≫ wcQuadModelStr (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A)) ∧ IsUnit ((c.map (IsLocalRing.residue A)) + (c.map (IsLocalRing.residue A)).transpose).det :=
by
  intro A _ _ n π c hπ hc XA U sA jU eU hjU heU hsq u hu xs hxs
  haveI := hjU
  haveI := heU
  classical

  have hg : (IsLocalRing.residue A) π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]
    exact Ideal.mem_span_singleton_self π

  have key : ∀ g : IsLocalRing.ResidueField A, g = 0 →
      (∃ m : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n g
          (c.map (IsLocalRing.residue A)))) ⟶ Spec (.of (wcQuadModelRing A n π c)),
        IsPullback m (wcQuadModelStr (IsLocalRing.ResidueField A) n g
          (c.map (IsLocalRing.residue A))) (wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ∧
        ∀ (x : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n g
            (c.map (IsLocalRing.residue A))))) (q : Fin n),
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X q) ∈ (m x).asIdeal →
          Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n g
            (c.map (IsLocalRing.residue A))) (MvPolynomial.X q) ∈ x.asIdeal) →
      ∃ m : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A)))) ⟶ Spec (.of (wcQuadModelRing A n π c)),
        IsPullback m (wcQuadModelStr (IsLocalRing.ResidueField A) n 0
          (c.map (IsLocalRing.residue A))) (wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ∧
        ∀ (x : Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
            (c.map (IsLocalRing.residue A))))) (q : Fin n),
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X q) ∈ (m x).asIdeal →
          Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
            (c.map (IsLocalRing.residue A))) (MvPolynomial.X q) ∈ x.asIdeal := by
    intro g hg0 h
    subst hg0
    exact h
  obtain ⟨m, hm, hmv⟩ := key _ hg
    (wc_quad_model_base_change_isPullback A (IsLocalRing.ResidueField A) n π c
      (IsLocalRing.residue A))

  have sq1 := IsPullback.of_hasPullback jU (Limits.pullback.fst sA (wcQmSp A))
  have sq2 := IsPullback.of_hasPullback sA (wcQmSp A)
  have big := sq1.paste_vert sq2
  rw [hsq] at big

  let ψ₁ := hm.lift (Limits.pullback.fst jU (Limits.pullback.fst sA (wcQmSp A)) ≫ eU)
    (Limits.pullback.snd jU (Limits.pullback.fst sA (wcQmSp A)) ≫
      Limits.pullback.snd sA (wcQmSp A))
    (by rw [Category.assoc]; exact big.w)
  have l1 : ψ₁ ≫ m = Limits.pullback.fst jU (Limits.pullback.fst sA (wcQmSp A)) ≫ eU :=
    hm.lift_fst _ _ _
  have l2 : ψ₁ ≫ wcQuadModelStr (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A)) =
      Limits.pullback.snd jU (Limits.pullback.fst sA (wcQmSp A)) ≫
        Limits.pullback.snd sA (wcQmSp A) := hm.lift_snd _ _ _
  rw [← l2] at big
  have sqT := IsPullback.of_bot big l1.symm hm
  haveI hψ₁ : Etale ψ₁ := MorphismProperty.of_isPullback (P := @Etale) sqT heU

  obtain ⟨w₁, hw₁a, hw₁b⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := jU) (g := Limits.pullback.fst sA (wcQmSp A)) u xs hxs.symm
  have hmw : m (ψ₁ w₁) = eU u := by
    have := congrArg (fun h => h w₁) l1
    simp only [Scheme.Hom.comp_apply] at this
    rw [this, hw₁a]
  have hvert₁ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
      (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∈ (ψ₁ w₁).asIdeal := by
    intro p
    exact hmv (ψ₁ w₁) p (by rw [hmw]; exact hu p)

  obtain ⟨U₁, hU₁, hU₁u⟩ := wc_etale_fibre_point_isolated
    (Limits.pullback.snd jU (Limits.pullback.fst sA (wcQmSp A))) w₁
  obtain ⟨U₂, hU₂, hU₂u⟩ := wc_etale_fibre_point_isolated ψ₁ w₁
  obtain ⟨W', hW'a, hw₁W', hsub⟩ :=
    exists_isAffineOpen_mem_and_subset (show w₁ ∈ U₁ ⊓ U₂ from ⟨hU₁, hU₂⟩)
  have hmemW : ∀ w : W'.toScheme, W'.ι w ∈ U₁ ∧ W'.ι w ∈ U₂ := fun w => by
    have hw : W'.ι w ∈ (W' : Set _) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨w, rfl⟩
    exact hsub hw
  obtain ⟨w₀, hw₀⟩ : ∃ w₀ : W'.toScheme, W'.ι w₀ = w₁ := by
    rw [← Set.mem_range, Scheme.Opens.range_ι]
    exact hw₁W'

  have s7 : IsUnit ((c.map (IsLocalRing.residue A)) +
      (c.map (IsLocalRing.residue A)).transpose).det := by
    have e : (c.map (IsLocalRing.residue A)) + (c.map (IsLocalRing.residue A)).transpose =
        (IsLocalRing.residue A).mapMatrix (c + c.transpose) := by
      ext a b
      simp [Matrix.transpose_apply]
    rw [e, ← RingHom.map_det]
    exact hc.map _

  refine ⟨W', hW'a, W'.ι ≫ Limits.pullback.snd jU (Limits.pullback.fst sA (wcQmSp A)),
    inferInstance, W'.ι ≫ ψ₁, inferInstance, w₀, ?_, ?_, ?_, ?_, ?_, s7⟩
  · rw [Scheme.Hom.comp_apply, hw₀]
    exact hw₁b
  · intro w hw
    rw [Scheme.Hom.comp_apply] at hw
    have h1 := hU₁u _ (hmemW w).1 (hw.trans hw₁b.symm)
    exact W'.ι.isOpenEmbedding.injective (h1.trans hw₀.symm)
  · intro w hw
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hw₀] at hw
    have h1 := hU₂u _ (hmemW w).2 hw
    exact W'.ι.isOpenEmbedding.injective (h1.trans hw₀.symm)
  · intro p
    rw [Scheme.Hom.comp_apply, hw₀]
    exact hvert₁ p
  · rw [Category.assoc, Category.assoc, l2]

theorem wc_et_tpl_sfu_geom_pt_base_closed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x) :
    IsClosedImmersion (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs ≫
      Limits.pullback.snd (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) :=
by
  classical
  have isoSurj : ∀ {R S : CommRingCat.{u}} (e : R ≅ S), Function.Surjective e.hom.hom :=
    fun e t => ⟨e.inv.hom t, by rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]⟩

  have s1 : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) [SurjectiveOnStalks φ] (x : X),
      Function.Surjective (φ.residueFieldMap x).hom := by
    intro X Y φ _ x
    have h := Scheme.residue_residueFieldMap φ x
    have h2 : (φ.residueFieldMap x).hom ∘ (Y.residue (φ x)).hom =
        (X.residue x).hom ∘ (φ.stalkMap x).hom := by
      funext t
      have := congrArg (fun k => k.hom t) h
      simpa using this
    have h3 : Function.Surjective ((X.residue x).hom ∘ (φ.stalkMap x).hom) :=
      (Scheme.residue_surjective X x).comp (φ.stalkMap_surjective x)
    rw [← h2] at h3
    exact Function.Surjective.of_comp h3

  have s3 : ∀ {Y V P : Scheme.{u}} {K : Type u} [Field K] (f : Y ⟶ P) (g : V ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g w = s (IsLocalRing.closedPoint K) →
      Function.Surjective ((Limits.pullback.snd f g).residueFieldMap w).hom := by
    intro Y V P K _ f g s _ w hw
    obtain ⟨q, -, rfl⟩ := Scheme.Pullback.exists_preimage_pullback _ w hw.symm
    have hE : Limits.pullback.snd s (Limits.pullback.fst f g) ≫ Limits.pullback.snd f g =
        (Limits.pullbackRightPullbackFstIso f g s).hom ≫ Limits.pullback.snd (s ≫ f) g :=
      (Limits.pullbackRightPullbackFstIso_hom_snd f g s).symm
    have hc := s1 (Limits.pullback.snd (s ≫ f) g) ((Limits.pullbackRightPullbackFstIso f g s).hom q)
    have hd := s1 (Limits.pullbackRightPullbackFstIso f g s).hom q
    have hcomp : Function.Surjective
        (((Limits.pullbackRightPullbackFstIso f g s).hom ≫
          Limits.pullback.snd (s ≫ f) g).residueFieldMap q).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hd.comp hc
    have h3 := Scheme.Hom.residueFieldMap_congr hE q
    have hba : Function.Surjective
        ((Limits.pullback.snd s (Limits.pullback.fst f g) ≫
          Limits.pullback.snd f g).residueFieldMap q).hom := by
      rw [h3]
      exact hcomp.comp (isoSurj _)
    rw [Scheme.residueFieldMap_comp] at hba
    have hba' : Function.Surjective
        (⇑((Limits.pullback.snd s (Limits.pullback.fst f g)).residueFieldMap q).hom ∘
          ⇑((Limits.pullback.snd f g).residueFieldMap
            ((Limits.pullback.snd s (Limits.pullback.fst f g)) q)).hom) := hba
    intro t
    obtain ⟨r, hr⟩ := hba'
      (((Limits.pullback.snd s (Limits.pullback.fst f g)).residueFieldMap q).hom t)
    exact ⟨r, ((Limits.pullback.snd s (Limits.pullback.fst f g)).residueFieldMap q).hom.injective hr⟩
  haveI hsf : IsClosedImmersion (D.xs i ≫ D.f) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.xs i ≫ D.f) (by rw [D.hxs i, D.hS i])
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective

  have gen : ∀ {T B : Scheme.{u}} (g : T ⟶ Spec (.of A)) (j : B ⟶ T)
      (σ : B ⟶ Spec (.of (IsLocalRing.ResidueField A))), j ≫ g = σ ≫ wcQmSp A → ∀ b : B,
      Function.Surjective (j.residueFieldMap b).hom →
      Function.Surjective (g.residueFieldMap (j b)).hom →
      Function.Surjective (σ.residueFieldMap b).hom := by
    intro T B g j σ hsq b hj hg
    have hcomp : Function.Surjective ((j ≫ g).residueFieldMap b).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hj.comp hg
    rw [Scheme.Hom.residueFieldMap_congr hsq b] at hcomp
    have hcomp' : Function.Surjective ((σ ≫ wcQmSp A).residueFieldMap b).hom := by
      have : Function.Surjective
          (⇑((σ ≫ wcQmSp A).residueFieldMap b).hom ∘ ⇑(Scheme.residueFieldCongr
            (congrArg (fun φ => φ b) hsq)).hom.hom) := hcomp
      exact Function.Surjective.of_comp this
    rw [Scheme.residueFieldMap_comp] at hcomp'
    have : Function.Surjective
        (⇑(σ.residueFieldMap b).hom ∘ ⇑((wcQmSp A).residueFieldMap (σ b)).hom) := hcomp'
    exact Function.Surjective.of_comp this
  have hx₂' : Limits.pullback.fst D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) xs) =
      D.xs i (IsLocalRing.closedPoint F'') := by rw [hxs]; exact hx
  have hg := s3 D.f a (D.xs i) _ hx₂'
  have hσ := gen (Limits.pullback.snd D.f a)
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))
    (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A))
    Limits.pullback.condition xs
    (s1 (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) xs) hg

  haveI : IsClosedImmersion (Spec.map ((Limits.pullback.snd (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueFieldMap xs)) :=
    IsClosedImmersion.spec_of_surjective _ hσ

  haveI : IsClosedImmersion ((Spec (.of (IsLocalRing.ResidueField A))).fromSpecResidueField
      ((Limits.pullback.snd (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs)) := by
    apply isClosed_singleton_iff_isClosedImmersion.mp
    have hu : ({(Limits.pullback.snd (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs} :
        Set ↥(Spec (.of (IsLocalRing.ResidueField A)))) = Set.univ :=
      Set.eq_univ_of_forall (fun z => Subsingleton.elim z _)
    rw [hu]
    exact isClosed_univ

  have s4 : ∀ (K : Type u) [Field K] [Finite K] (X : Scheme.{u}) (s : Spec (.of K) ⟶ X),
      Finite (X.residueField (s (IsLocalRing.closedPoint K))) := by
    intro K _ _ X s
    have hsurj : Function.Surjective ((stalkClosedPointIso (CommRingCat.of K)).inv ≫
        (Spec (.of K)).residue (IsLocalRing.closedPoint K)).hom := by
      rw [CommRingCat.hom_comp]
      exact (Scheme.residue_surjective _ _).comp
        (isoSurj (stalkClosedPointIso (CommRingCat.of K)).symm)
    haveI : Finite ((Spec (.of K)).residueField (IsLocalRing.closedPoint K)) :=
      Finite.of_surjective _ hsurj
    have key : ∀ (Z : Scheme.{u}) (z : Z), Finite (Z.residueField z) → ∀ (X' : Scheme.{u})
        (s' : Z ⟶ X'), Finite (X'.residueField (s' z)) := by
      intro Z z _ X' s'
      exact Finite.of_injective _ (s'.residueFieldMap z).hom.injective
    exact key (Spec (.of K)) (IsLocalRing.closedPoint K) inferInstance X s
  have s5 : ∀ (k K₀ : Type u) [Field k] [IsSepClosed k] [Field K₀] [Finite K₀]
      (e : k →+* AlgebraicClosure K₀), IsAlgClosed k := by
    intro k K₀ _ _ _ _ e
    obtain ⟨p, hchar⟩ := CharP.exists K₀
    have hp : p.Prime := CharP.char_is_prime K₀ p
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP (AlgebraicClosure K₀) p :=
      (RingHom.charP_iff_charP (algebraMap K₀ (AlgebraicClosure K₀)) p).mp hchar
    haveI : CharP k p := (RingHom.charP_iff_charP e p).mpr inferInstance
    haveI : ExpChar k p := ExpChar.prime hp
    have htor : ∀ b : k, ∃ m : ℕ, b ^ (p ^ (m + 1)) = b := by
      intro b
      have hx : IsIntegral K₀ (e b) := Algebra.IsIntegral.isIntegral (e b)
      haveI : FiniteDimensional K₀ (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) :=
        IntermediateField.adjoin.finiteDimensional hx
      haveI : Finite (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) :=
        Module.finite_of_finite K₀
      letI := Fintype.ofFinite (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)))
      haveI : CharP (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) p :=
        (RingHom.charP_iff_charP
          (algebraMap K₀ (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)))) p).mp hchar
      obtain ⟨N, -, hcard⟩ :=
        FiniteField.card (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) p
      have hy := FiniteField.pow_card
        (⟨e b, IntermediateField.mem_adjoin_simple_self K₀ (e b)⟩ :
          IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)))
      rw [hcard] at hy
      have hx' : (e b) ^ (p ^ (N : ℕ)) = e b := by
        have := congrArg
          (fun z : IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)) =>
            (z : AlgebraicClosure K₀)) hy
        simpa using this
      have hb : b ^ (p ^ (N : ℕ)) = b := e.injective (by rw [map_pow]; exact hx')
      refine ⟨(N : ℕ) - 1, ?_⟩
      rw [Nat.sub_add_cancel N.pos]
      exact hb
    have hsurj : Function.Surjective (frobenius k p) := by
      intro b
      obtain ⟨m, hm⟩ := htor b
      refine ⟨b ^ (p ^ m), ?_⟩
      rw [frobenius_def, ← pow_mul, ← pow_succ]
      exact hm
    haveI : PerfectRing k p := PerfectRing.ofSurjective k p hsurj
    haveI : PerfectField k := PerfectRing.toPerfectField k p
    exact IsSepClosed.isAlgClosed_of_perfectField k
  have s6 : ∀ (K : Type u) [Field K] [IsAlgClosed K] {X : Scheme.{u}} (σ : X ⟶ Spec (.of K))
      (x : X), Function.Surjective (σ.residueFieldMap x).hom → IsAlgClosed (X.residueField x) := by
    intro K _ _ X σ x h
    have hp : σ x = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    let Φ : CommRingCat.of K ⟶ X.residueField x :=
      (stalkClosedPointIso (CommRingCat.of K)).inv ≫
        (Spec (.of K)).residue (IsLocalRing.closedPoint K) ≫
        (Scheme.residueFieldCongr hp).inv ≫ σ.residueFieldMap x
    have hΦ : Function.Surjective Φ.hom := by
      simp only [Φ, CommRingCat.hom_comp]
      refine h.comp (Function.Surjective.comp (isoSurj (Scheme.residueFieldCongr hp).symm)
        ((Scheme.residue_surjective _ _).comp (isoSurj (stalkClosedPointIso (CommRingCat.of K)).symm)))
    exact IsAlgClosed.of_ringEquiv K (X.residueField x)
      (RingEquiv.ofBijective Φ.hom ⟨Φ.hom.injective, hΦ⟩)
  obtain ⟨-, -, -, -, -, e, -, -⟩ := hA
  haveI : Finite ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))) :=
    s4 F'' _ (D.S i)
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) := s5 _ _ e
  haveI : IsAlgClosed ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)).residueField xs) :=
    s6 (IsLocalRing.ResidueField A) (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A)) xs hσ
  have hbij : Function.Bijective (algebraMap ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)
      (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)
      (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))))) :=
    IsClosedImmersion.spec_of_surjective _ hbij.2
  unfold wcEtGeomPt
  rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  infer_instance

theorem wc_quad_cone_vertex_geom_supp_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : K) ≠ 0 → ∀ (n : ℕ), Even n → 4 ≤ n → ∀ (c : Matrix (Fin n) (Fin n) K), IsUnit (c + c.transpose).det → ∀ (Ω : Type u) [Field Ω] (i : Spec (.of Ω) ⟶ Spec (.of (wcQuadModelRing K n 0 c))) [IsClosedImmersion i], (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (i (IsLocalRing.closedPoint Ω))) → ∀ (k : ℕ), 1 ≤ k → ∀ (D : wcEtPullData i (ℓ ^ k)), Finite (wcEtSuppExt D n) ∧ Nat.card (wcEtSuppExt D n) ≤ ℓ ^ k :=
by
  intro K _ _ ℓ _ hℓ n hn h4 c hc Ω _ i _ hvert k hk D
  have hp : ℓ.Prime := Fact.out
  obtain ⟨k', rfl⟩ := Nat.exists_eq_add_of_le' hk
  have hM : 0 < ℓ ^ (k' + 1) := pow_pos hp.pos _
  have hopen : IsOpen {y : Spec (.of (wcQuadModelRing K n 0 c)) |
      ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal} := by
    rw [Set.setOf_exists]
    exact isOpen_iUnion fun p => PrimeSpectrum.isOpen_basicOpen
  let Oc : (Spec (.of (wcQuadModelRing K n 0 c))).Opens := ⟨_, hopen⟩
  have hrange : Set.range Oc.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι]
    ext y
    constructor
    · rintro ⟨p, hp'⟩ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      subst hz
      exact hp' (hvert p)
    · intro hy
      by_contra h
      have h' : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ y.asIdeal := by
        intro p
        by_contra hq
        exact h ⟨p, hq⟩
      have hyv := (wc_lup_quad_cone_vertex K n c).1 y (i (IsLocalRing.closedPoint Ω)) h' hvert
      exact hy ⟨_, hyv.symm⟩
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists Oc.ι (ℓ ^ (k' + 1))
  have h1 : Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing K n 0 c))) ℓ (n - 1 + 1)) :=
    (wc_et_quadric_cone_acyclic K ℓ hp hℓ n c).2 (n - 1 + 1) (by omega)
  have h2 : Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ (k' + 1)) (n - 1 + 1)) :=
    wc_et_coh_zmod_prime_pow_of_prime _ ℓ hp (n - 1 + 1) h1 k'
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ (k' + 1)) (n - 1 + 1)
  haveI := E.subsingleton
  have hinj : Function.Injective (wcEtPull Dj (n - 1 + 1)) := Function.injective_of_subsingleton _
  have hcard : Nat.card (wcEtCoh (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1)) = ℓ ^ (k' + 1) :=
    (wc_quad_cone_punct_top_counts K ℓ hℓ n hn h4 c hc Oc rfl).2.2 (k' + 1) (by omega)
  obtain ⟨E'⟩ := wc_et_zmodext_coh_equiv (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1)
  have hcard' : Nat.card (wcEtZModExt (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1)) = ℓ ^ (k' + 1) :=
    (Nat.card_congr E').trans hcard
  haveI hfin : Finite (wcEtZModExt (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1)) :=
    Nat.finite_of_card_ne_zero (by rw [hcard']; exact hM.ne')
  letI := Fintype.ofFinite (wcEtZModExt (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1))
  have hT : ∃ T : Finset (wcEtZModExt (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1)),
      T.card ≤ ℓ ^ (k' + 1) ∧ ∀ y : wcEtZModExt (Oc : Scheme.{u}) (ℓ ^ (k' + 1)) (n - 1),
        ∃ t ∈ T, ∃ w : wcEtZModExt (Spec (.of (wcQuadModelRing K n 0 c))) (ℓ ^ (k' + 1)) (n - 1),
          y = t + wcEtPull Dj (n - 1) w := by
    refine ⟨Finset.univ, ?_, ?_⟩
    · rw [Finset.card_univ, ← Nat.card_eq_fintype_card, hcard']
    · intro y
      exact ⟨y, Finset.mem_univ y, 0, by rw [map_zero, add_zero]⟩
  have H := wc_et_supp_card_of_restr i Oc.ι hrange (ℓ ^ (k' + 1)) hM D Dj (n - 1) (ℓ ^ (k' + 1))
    hinj hT
  have e : n - 1 + 1 = n := by omega
  rw [e] at H
  exact H

