      (show Mono (Limits.kernel.ι (wcEtSuppUnitMap D)) from inferInstance)
      (show Epi (wcEtSuppUnitMap D) from hepi)

  have hB0 : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
