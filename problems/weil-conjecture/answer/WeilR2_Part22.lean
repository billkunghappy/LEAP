    have himg : ∀ K : Set ↥(Limits.pullback x.left w.left), IsClopen K → K.Nonempty →
        (Limits.pullback.fst x.left w.left) '' K = Set.univ := by
      intro K hK hne
      have hsat : (Limits.pullback.fst x.left w.left) ⁻¹' ((Limits.pullback.fst x.left w.left) '' K) =
          ⋃ φ : {φ : Limits.pullback x.left w.left ⟶ Limits.pullback x.left w.left //
            φ ≫ Limits.pullback.fst x.left w.left = Limits.pullback.fst x.left w.left},
            φ.1 ⁻¹' K := by
        ext z
        simp only [Set.mem_preimage, Set.mem_image, Set.mem_iUnion]
        constructor
        · rintro ⟨k, hk, hkz⟩
          obtain ⟨φ, hφ, hφz⟩ := htr z k hkz.symm
          exact ⟨⟨φ, hφ⟩, by rw [hφz]; exact hk⟩
        · rintro ⟨⟨φ, hφ⟩, hz⟩
          exact ⟨φ z, hz, by rw [← Scheme.Hom.comp_apply, hφ]⟩
      have hsatO : IsOpen ((Limits.pullback.fst x.left w.left) ⁻¹'
          ((Limits.pullback.fst x.left w.left) '' K)) := by
        rw [hsat]
        exact isOpen_iUnion fun φ => hK.isOpen.preimage φ.1.continuous
      have hcompl : ((Limits.pullback.fst x.left w.left) '' K)ᶜ =
          (Limits.pullback.fst x.left w.left) '' ((Limits.pullback.fst x.left w.left) ⁻¹'
            ((Limits.pullback.fst x.left w.left) '' K))ᶜ := by
        ext y
