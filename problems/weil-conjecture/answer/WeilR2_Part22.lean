    have h2 : ψ z = Spec.map (CommRingCat.ofHom lam) (eU (O.ι z)) :=
      (comp_ap O.ι (eU ≫ Spec.map (CommRingCat.ofHom lam)) z).trans (comp_ap _ _ _)
    rw [h2, Spec.map_apply] at h1
