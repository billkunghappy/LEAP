  have hcl : (Spec.map (CommRingCat.ofHom ι)) (IsLocalRing.closedPoint H) =
      IsLocalRing.closedPoint ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x) :=
