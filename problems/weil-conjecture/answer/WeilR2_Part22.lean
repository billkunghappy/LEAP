      (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp] <;> rfl)
      (by simp) (by rw [hδ, ← he]; simp)
  have hT4 := IsPullback.paste_horiz hT3.flip (IsPullback.of_hasPullback (πE ≫ U.ι) (X.fromSpecStalk x))
  rw [Category.assoc] at hT4
