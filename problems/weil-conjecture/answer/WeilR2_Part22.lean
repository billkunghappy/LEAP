    have liftOI : ∀ {X₁ Y₁ : Scheme.{u}} (U₁ : X₁.Opens) (g₂ : Y₁ ⟶ X₁),
        Set.range g₂ ⊆ Set.range U₁.ι → ∃ l : Y₁ ⟶ U₁.toScheme, l ≫ U₁.ι = g₂ :=
      fun U₁ g₂ hs => ⟨_, IsOpenImmersion.lift_fac U₁.ι g₂ hs⟩
    obtain ⟨l, hl⟩ := liftOI (W.hom ⁻¹ᵁ O) g₁.left hsub
