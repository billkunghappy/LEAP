    simp only [Functor.mapHomotopyCategoryFactors_hom_app, hinv]
    rw [reassoc_of% hsh]
    simp only [Functor.map_comp, Category.assoc]
    rw [Functor.commShiftIso_hom_naturality]
    erw [Category.id_comp]
    erw [CategoryTheory.Functor.map_id]
    erw [Category.id_comp]
    rfl



  have s5 : ∀ {C D E : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Category.{u+1} E]
      [Preadditive C] [Preadditive D] [Preadditive E]
      [Limits.HasZeroObject C] [Limits.HasZeroObject D] [Limits.HasZeroObject E]
      (Φw Pw : C ⥤ C) [Φw.Additive] [Pw.Additive] (adj : Φw ⊣ Pw)
