theorem wc_shens_nbhd_offpoint_unique (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hv : V.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (y₁ y₂ : V.left) (h₁ : V.hom y₁ ≠ u0 (IsLocalRing.closedPoint F''))
    (h₂ : V.hom y₂ ≠ u0 (IsLocalRing.closedPoint F'')) : y₁ = y₂ :=
by
  obtain ⟨V₀, j, -, hrange, hsub⟩ := wc_P1_shens_punct_subsingleton F'' u0 hu0 V A e hv
  have hy₁ : y₁ ∈ Set.range j.left := by
    rw [hrange, Set.mem_compl_singleton_iff]
    intro h
    exact h₁ (by rw [h]; exact hv)
  have hy₂ : y₂ ∈ Set.range j.left := by
    rw [hrange, Set.mem_compl_singleton_iff]
    intro h
    exact h₂ (by rw [h]; exact hv)
  obtain ⟨x₁, hx₁⟩ := hy₁
  obtain ⟨x₂, hx₂⟩ := hy₂
  rw [← hx₁, ← hx₂, hsub x₁ x₂]

theorem wc_honest_local_point_transport (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (X : (wcP1Over F'').left.ProEt) (x : X ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (ρ : ℕ)
    (θX : G.over X ≅ (wcContSheaf (wcP1Over F'').left (Fin ρ → ℚ_[ℓ])).over X)
    (hoffX : ∀ z : X.left, X.hom z ≠ u0 (IsLocalRing.closedPoint F''))
    (P : (Fin ρ → ℚ_[ℓ]) → Prop)
    (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (hloc : ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ X) (z : V'.left),
      a ≫ v = b ≫ x ∧ ∀ y : Fin ρ → ℚ_[ℓ], P y ↔ ∃ s : G.obj.obj (Opposite.op V),
        (show C(↥V'.left, Fin ρ → ℚ_[ℓ]) from ((θX.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((G.obj.map a.op).hom s)).down) z = y)
    (T : (wcP1Over F'').left.ProEt) (uT : T ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eT : T.left ≅ Spec (.of L))
    (hT : T.hom (eT.inv (IsLocalRing.closedPoint L)) ≠ u0 (IsLocalRing.closedPoint F'')) :
    ∃ c : T ⟶ X, uT ≫ v = c ≫ x ∧ ∀ y : Fin ρ → ℚ_[ℓ], P y ↔
      ∃ s : G.obj.obj (Opposite.op V),
        (show C(↥T.left, Fin ρ → ℚ_[ℓ]) from ((θX.hom.hom.app (Opposite.op (Over.mk c))).hom
          ((G.obj.map uT.op).hom s)).down) (eT.inv (IsLocalRing.closedPoint L)) = y :=
by
  classical
  obtain ⟨V', a, b, z, hab, hPiff⟩ := hloc
  set pt := eT.inv (IsLocalRing.closedPoint L) with hpt_def

  have ha1 : V'.hom z = V.hom (a.left z) := by
    rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
  have hb1 : V'.hom z = X.hom (b.left z) := by
    rw [← MorphismProperty.Over.w b, Scheme.Hom.comp_apply]
  have hz : V.hom (a.left z) ≠ u0 (IsLocalRing.closedPoint F'') := by
    rw [← ha1, hb1]; exact hoffX (b.left z)
  have hu1 : T.hom pt = V.hom (uT.left pt) := by
    rw [← MorphismProperty.Over.w uT, Scheme.Hom.comp_apply]
  have hpt : V.hom (uT.left pt) ≠ u0 (IsLocalRing.closedPoint F'') := by
    rw [← hu1]; exact hT

  have heq : a.left z = uT.left pt :=
    wc_shens_nbhd_offpoint_unique F'' u0 hu0 V A e hV _ _ hz hpt

  haveI : WeaklyEtale V.hom := V.prop
  haveI : WeaklyEtale (a.left ≫ V.hom) := by rw [MorphismProperty.Over.w a]; exact V'.prop
  haveI ha : WeaklyEtale a.left := WeaklyEtale.of_comp a.left V.hom
  haveI : WeaklyEtale (uT.left ≫ V.hom) := by rw [MorphismProperty.Over.w uT]; exact T.prop
  haveI huT : WeaklyEtale uT.left := WeaklyEtale.of_comp uT.left V.hom

  obtain ⟨ζ, hζ1, hζ2⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := uT.left) z pt heq
  haveI hι : WeaklyEtale ((Limits.pullback a.left uT.left).fromSpecStalk ζ) :=
    wc_lfi_fromSpecStalk_weaklyEtale _ ζ
  haveI hp2 : WeaklyEtale (Limits.pullback.snd a.left uT.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback a.left uT.left) ha
  obtain ⟨s₁, hs₁⟩ : ∃ s : Spec ((Limits.pullback a.left uT.left).presheaf.stalk ζ) ⟶ V'.left,
      s = (Limits.pullback a.left uT.left).fromSpecStalk ζ ≫
        Limits.pullback.fst a.left uT.left := ⟨_, rfl⟩
  obtain ⟨s₂, hs₂⟩ : ∃ s : Spec ((Limits.pullback a.left uT.left).presheaf.stalk ζ) ⟶ T.left,
      s = (Limits.pullback a.left uT.left).fromSpecStalk ζ ≫
        Limits.pullback.snd a.left uT.left := ⟨_, rfl⟩
  have hcomm : s₁ ≫ a.left = s₂ ≫ uT.left := by
    rw [hs₁, hs₂, Category.assoc, Category.assoc, Limits.pullback.condition]
  haveI hs₂W : WeaklyEtale s₂ := by rw [hs₂]; infer_instance
  have hcp₁ : s₁ (IsLocalRing.closedPoint ((Limits.pullback a.left uT.left).presheaf.stalk ζ))
      = z := by
    rw [hs₁]
    exact (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun p => (Limits.pullback.fst a.left uT.left) p)
        Scheme.fromSpecStalk_closedPoint).trans hζ1)
  have hcp₂ : s₂ (IsLocalRing.closedPoint ((Limits.pullback a.left uT.left).presheaf.stalk ζ))
      = pt := by
    rw [hs₂]
    exact (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun p => (Limits.pullback.snd a.left uT.left) p)
        Scheme.fromSpecStalk_closedPoint).trans hζ2)

  have hiso : IsIso s₂ := by
    obtain ⟨g, hg⟩ : ∃ g : Spec ((Limits.pullback a.left uT.left).presheaf.stalk ζ) ⟶
        Spec (.of L), g = s₂ ≫ eT.hom := ⟨_, rfl⟩
    haveI hgW : WeaklyEtale g := by rw [hg]; infer_instance
    obtain ⟨ψ, hψ⟩ : ∃ ψ : CommRingCat.of L ⟶ (Limits.pullback a.left uT.left).presheaf.stalk ζ,
        Spec.map ψ = g := ⟨Spec.preimage g, Spec.map_preimage g⟩
    have hW : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ.hom)) := by
      rw [CommRingCat.ofHom_hom, hψ]; exact hgW
    letI : Algebra L ((Limits.pullback a.left uT.left).presheaf.stalk ζ) := ψ.hom.toAlgebra
    have halg : Algebra.WeaklyEtale L ((Limits.pullback a.left uT.left).presheaf.stalk ζ) :=
      wc_lpkt_specMap_weaklyEtale_ring L _ ψ.hom hW
    have hlh : IsLocalHom (algebraMap L ((Limits.pullback a.left uT.left).presheaf.stalk ζ)) := by
      refine ⟨fun r hr => ?_⟩
      by_cases h0 : r = 0
      · rw [h0, map_zero] at hr
        exact absurd hr not_isUnit_zero
      · exact isUnit_iff_ne_zero.mpr h0
    have hres : IsSepClosed (IsLocalRing.ResidueField L) := by
      have hinj : Function.Injective (IsLocalRing.residue L) := by
        rw [RingHom.injective_iff_ker_eq_bot, IsLocalRing.ker_residue,
          IsLocalRing.maximalIdeal_eq_bot]
      exact wc_henselian_sepClosed_transfer.2 L _
        (RingEquiv.ofBijective _ ⟨hinj, IsLocalRing.residue_surjective⟩) inferInstance
    have hbij := wc_olivier L _ (Field.henselian L) hres hlh halg
    haveI : IsIso ψ := (ConcreteCategory.isIso_iff_bijective ψ).mpr hbij
    haveI hgI : IsIso g := by
      have : IsIso (Spec.map ψ) := inferInstance
      rwa [hψ] at this
    have hs : s₂ = g ≫ eT.inv := by
      rw [hg, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [hs]
    infer_instance

  haveI := hiso
  let κ₀ : T.left ⟶ V'.left := inv s₂ ≫ s₁
  have hκ₀a : κ₀ ≫ a.left = uT.left := by
    show (inv s₂ ≫ s₁) ≫ a.left = uT.left
    rw [Category.assoc, hcomm, IsIso.inv_hom_id_assoc]
  have hκ₀w : κ₀ ≫ V'.hom = T.hom := by
    rw [← MorphismProperty.Over.w a, ← Category.assoc, hκ₀a, MorphismProperty.Over.w uT]
  let κ : T ⟶ V' := MorphismProperty.Over.homMk κ₀ hκ₀w trivial
  have hκa : κ ≫ a = uT := by
    apply MorphismProperty.Over.Hom.ext
    exact hκ₀a
  have hκpt : κ.left pt = z := by
    have h4 : (inv s₂) (s₂ (IsLocalRing.closedPoint
        ((Limits.pullback a.left uT.left).presheaf.stalk ζ))) =
        IsLocalRing.closedPoint ((Limits.pullback a.left uT.left).presheaf.stalk ζ) :=
      (Scheme.Hom.comp_apply s₂ (inv s₂) _).symm.trans
        (congrArg (fun f : Spec ((Limits.pullback a.left uT.left).presheaf.stalk ζ) ⟶
          Spec ((Limits.pullback a.left uT.left).presheaf.stalk ζ) =>
            f (IsLocalRing.closedPoint ((Limits.pullback a.left uT.left).presheaf.stalk ζ)))
          (IsIso.hom_inv_id s₂))
    have h1 : κ.left (s₂ (IsLocalRing.closedPoint
        ((Limits.pullback a.left uT.left).presheaf.stalk ζ))) = z :=
      (Scheme.Hom.comp_apply (inv s₂) s₁ _).trans
        ((congrArg (fun p => s₁ p) h4).trans hcp₁)
    rw [← hcp₂]
    exact h1

  have h3 : ∀ s : G.obj.obj (Opposite.op V),
      (show C(↥T.left, Fin ρ → ℚ_[ℓ]) from ((θX.hom.hom.app (Opposite.op (Over.mk (κ ≫ b)))).hom
          ((G.obj.map uT.op).hom s)).down) pt =
      (show C(↥V'.left, Fin ρ → ℚ_[ℓ]) from ((θX.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((G.obj.map a.op).hom s)).down) z := by
    intro s
    let f : Over.mk (κ ≫ b) ⟶ Over.mk b := Over.homMk κ rfl
    have hnat := congrArg (fun m => m.hom ((G.obj.map a.op).hom s))
      (θX.hom.hom.naturality f.op)
    have h2 := congrArg (fun y : ULift.{u+1} C(↥T.left, Fin ρ → ℚ_[ℓ]) => y.down pt) hnat
    have hmc : (G.obj.map uT.op).hom s = (G.obj.map κ.op).hom ((G.obj.map a.op).hom s) := by
      rw [← hκa, op_comp, Functor.map_comp]
      rfl
    rw [hmc, ← hκpt]
    exact h2

  refine ⟨κ ≫ b, ?_, fun y => ?_⟩
  · rw [Category.assoc, ← hab, ← Category.assoc, hκa]
  · rw [hPiff y]
    constructor
    · rintro ⟨s, hs⟩
      exact ⟨s, (h3 s).trans hs⟩
    · rintro ⟨s, hs⟩
      exact ⟨s, (h3 s).symm.trans hs⟩

theorem wc_honest_qc_bridge (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (X : (wcP1Over F'').left.ProEt) (x : X ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqcX : QuasiCompact x.left) (hconnX : ConnectedSpace X.left)
    (hoffX : ∀ (z : X.left) (i : Fin m), X.hom z ≠ S i (IsLocalRing.closedPoint F''))
    (hcovX : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        S i (IsLocalRing.closedPoint F'')) →
      ∃ z : X.left, x.left z = p)
    (T₁ T₂ : (wcP1Over F'').left.ProEt) (L₁ L₂ : Type u) [Field L₁] [IsSepClosed L₁]
    [Field L₂] [IsSepClosed L₂] (e₁ : T₁.left ≅ Spec (.of L₁)) (e₂ : T₂.left ≅ Spec (.of L₂))
    (c'₁ : T₁ ⟶ X) (c₁ : T₁ ⟶ W) (h₁ : c₁ ≫ w = c'₁ ≫ x) (c'₂ : T₂ ⟶ X) :
    ∃ (V : (wcP1Over F'').left.ProEt) (p : V ⟶ X) (q : V ⟶ W)
      (t₁ : T₁ ⟶ V) (t₂ : T₂ ⟶ V),
      p ≫ x = q ≫ w ∧ t₁ ≫ p = c'₁ ∧ t₁ ≫ q = c₁ ∧ t₂ ≫ p = c'₂ ∧
      ∀ U : Set V.left, IsClopen U →
        (t₁.left (e₁.inv (IsLocalRing.closedPoint L₁)) ∈ U ↔
          t₂.left (e₂.inv (IsLocalRing.closedPoint L₂)) ∈ U) :=
by
  have gen : ∀ (B : Scheme.{u}) (P W : B.ProEt) (w : W ⟶ P) (hqc : QuasiCompact w.left)
      (hgal : ∀ (V : B.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
        a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
      (X : B.ProEt) (x : X ⟶ P) (hconnX : ConnectedSpace X.left)
      (hsurjX : ∀ y : X.left, ∃ zw : W.left, w.left zw = x.left y)
      (T₁ T₂ : B.ProEt) (pt₁ : T₁.left) (pt₂ : T₂.left)
      (c'₁ : T₁ ⟶ X) (c₁ : T₁ ⟶ W) (h₁ : c₁ ≫ w = c'₁ ≫ x) (c'₂ : T₂ ⟶ X)
      (d₀ : T₂ ⟶ W) (hd₀ : d₀ ≫ w = c'₂ ≫ x),
      ∃ (V : B.ProEt) (p : V ⟶ X) (q : V ⟶ W) (t₁ : T₁ ⟶ V) (t₂ : T₂ ⟶ V),
        p ≫ x = q ≫ w ∧ t₁ ≫ p = c'₁ ∧ t₁ ≫ q = c₁ ∧ t₂ ≫ p = c'₂ ∧
        ∀ U : Set V.left, IsClopen U → (t₁.left pt₁ ∈ U ↔ t₂.left pt₂ ∈ U) := by
    intro S P W w hqc hgal X x hconnX hsurjX T₁ T₂ pt₁ pt₂ c'₁ c₁ h₁ c'₂ d₀ hd₀
    classical
    have iP : WeaklyEtale P.hom := P.prop
    have iW : WeaklyEtale W.hom := W.prop
    have iX : WeaklyEtale X.hom := X.prop
    have iwP : WeaklyEtale (w.left ≫ P.hom) := by rw [MorphismProperty.Over.w w]; infer_instance
    have iw : WeaklyEtale w.left := WeaklyEtale.of_comp w.left P.hom
    have iqc : QuasiCompact w.left := hqc

    have hlocconn : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
      intro R _
      rw [connectedSpace_iff_clopen]
      refine ⟨⟨IsLocalRing.closedPoint R⟩, fun s hs => ?_⟩
      by_cases h : s = ∅
      · exact Or.inl h
      · right
        obtain ⟨k, hk⟩ := Set.nonempty_iff_ne_empty.mpr h
        have hc : IsLocalRing.closedPoint R ∈ s :=
          (IsLocalRing.specializes_closedPoint (R := R) k).mem_closed hs.isClosed hk
        exact Set.eq_univ_of_forall fun e =>
          (IsLocalRing.specializes_closedPoint (R := R) e).mem_open hs.isOpen hc

    have hK : Limits.pullback.snd x.left w.left ≫ W.hom =
        Limits.pullback.fst x.left w.left ≫ X.hom := by
      rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w x, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]

    have key2 : ∀ (Q : Scheme.{u}) (q1 q2 : Q ⟶ Limits.pullback x.left w.left)
        (hq : q1 ≫ Limits.pullback.fst x.left w.left = q2 ≫ Limits.pullback.fst x.left w.left)
        (_ : WeaklyEtale (q1 ≫ Limits.pullback.fst x.left w.left ≫ X.hom))
        (_ : ConnectedSpace Q), ∃ γ : W ⟶ W, γ ≫ w = w ∧
          q2 ≫ Limits.pullback.snd x.left w.left = (q1 ≫ Limits.pullback.snd x.left w.left) ≫ γ.left := by
      intro Q q1 q2 hq hQe hQc
      have ha : (q1 ≫ Limits.pullback.snd x.left w.left) ≫ W.hom =
          q1 ≫ Limits.pullback.fst x.left w.left ≫ X.hom := by
        rw [Category.assoc, hK]
      have hb : (q2 ≫ Limits.pullback.snd x.left w.left) ≫ W.hom =
          q1 ≫ Limits.pullback.fst x.left w.left ≫ X.hom := by
        rw [Category.assoc, hK, reassoc_of% hq]
      have hab : (q1 ≫ Limits.pullback.snd x.left w.left) ≫ w.left =
          (q2 ≫ Limits.pullback.snd x.left w.left) ≫ w.left := by
        simp only [Category.assoc]
        rw [← Limits.pullback.condition, reassoc_of% hq]
      obtain ⟨γ, hγ, hba⟩ := hgal
        (Scheme.ProEt.mk (q1 ≫ Limits.pullback.fst x.left w.left ≫ X.hom))
        (MorphismProperty.Over.homMk (q1 ≫ Limits.pullback.snd x.left w.left) ha trivial)
        (MorphismProperty.Over.homMk (q2 ≫ Limits.pullback.snd x.left w.left) hb trivial)
        hQc (MorphismProperty.Over.Hom.ext hab)
      exact ⟨γ, hγ, congrArg (fun t => t.left) hba⟩

    have hγl : ∀ γ : W ⟶ W, γ ≫ w = w → γ.left ≫ w.left = w.left := fun γ hγ =>
      congrArg (fun t => t.left) hγ

    have htr : ∀ z z' : ↥(Limits.pullback x.left w.left),
        Limits.pullback.fst x.left w.left z = Limits.pullback.fst x.left w.left z' →
        ∃ φ : Limits.pullback x.left w.left ⟶ Limits.pullback x.left w.left,
          φ ≫ Limits.pullback.fst x.left w.left = Limits.pullback.fst x.left w.left ∧ φ z = z' := by
      intro z z' hzz
      obtain ⟨ζ, hζ1, hζ2⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst x.left w.left) (g := Limits.pullback.fst x.left w.left) z z' hzz
      have ij := wc_lfi_fromSpecStalk_weaklyEtale (Limits.pullback (Limits.pullback.fst x.left w.left)
        (Limits.pullback.fst x.left w.left)) ζ
      have hP2 : Limits.pullback.fst (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left) ≫ Limits.pullback.fst x.left w.left =
          Limits.pullback.snd (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left) ≫ Limits.pullback.fst x.left w.left :=
        Limits.pullback.condition
      obtain ⟨γ, hγ, hl⟩ := key2 _
        ((Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ ≫
          Limits.pullback.fst (Limits.pullback.fst x.left w.left) (Limits.pullback.fst x.left w.left))
        ((Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ ≫
          Limits.pullback.snd (Limits.pullback.fst x.left w.left) (Limits.pullback.fst x.left w.left))
        (by rw [Category.assoc, Category.assoc, hP2]) inferInstance (hlocconn _)
      refine ⟨Limits.pullback.lift (Limits.pullback.fst x.left w.left)
        (Limits.pullback.snd x.left w.left ≫ γ.left)
        (by rw [Category.assoc, hγl γ hγ, Limits.pullback.condition]), Limits.pullback.lift_fst _ _ _, ?_⟩
      have heq : (Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ ≫
          Limits.pullback.snd (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left) =
          ((Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ ≫
          Limits.pullback.fst (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left)) ≫ Limits.pullback.lift
              (Limits.pullback.fst x.left w.left)
              (Limits.pullback.snd x.left w.left ≫ γ.left)
              (by rw [Category.assoc, hγl γ hγ, Limits.pullback.condition]) := by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst]
          rw [hP2]
        · rw [hl]
          simp only [Category.assoc, Limits.pullback.lift_snd]
      obtain ⟨c, hc⟩ : ∃ c : ↥(Spec ((Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).presheaf.stalk ζ)),
          (Limits.pullback (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ c = ζ :=
        ⟨_, Scheme.fromSpecStalk_closedPoint⟩
      have hpt : ((Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ ≫
          Limits.pullback.snd (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left)) c =
          (((Limits.pullback (Limits.pullback.fst x.left w.left)
          (Limits.pullback.fst x.left w.left)).fromSpecStalk ζ ≫
          Limits.pullback.fst (Limits.pullback.fst x.left w.left)
            (Limits.pullback.fst x.left w.left)) ≫ Limits.pullback.lift
              (Limits.pullback.fst x.left w.left)
              (Limits.pullback.snd x.left w.left ≫ γ.left)
              (by rw [Category.assoc, hγl γ hγ, Limits.pullback.condition])) c := by
        rw [heq]
      have h2 := (Scheme.Hom.comp_apply _ _ c).trans ((congrArg (fun t =>
        Limits.pullback.snd (Limits.pullback.fst x.left w.left) (Limits.pullback.fst x.left w.left) t)
        hc).trans hζ2)
      have h3 := (Scheme.Hom.comp_apply _ (Limits.pullback.lift
              (Limits.pullback.fst x.left w.left)
              (Limits.pullback.snd x.left w.left ≫ γ.left)
              (by rw [Category.assoc, hγl γ hγ, Limits.pullback.condition])) c).trans
        (congrArg (fun t => Limits.pullback.lift
              (Limits.pullback.fst x.left w.left)
              (Limits.pullback.snd x.left w.left ≫ γ.left)
              (by rw [Category.assoc, hγl γ hγ, Limits.pullback.condition]) t)
          ((Scheme.Hom.comp_apply _ _ c).trans ((congrArg (fun t =>
        Limits.pullback.fst (Limits.pullback.fst x.left w.left) (Limits.pullback.fst x.left w.left) t)
        hc).trans hζ1)))
      exact h3.symm.trans (hpt.symm.trans h2)

    have iprX : WeaklyEtale (Limits.pullback.fst x.left w.left) := inferInstance
    have iprXqc : QuasiCompact (Limits.pullback.fst x.left w.left) := inferInstance
    have iV : WeaklyEtale (Limits.pullback.fst x.left w.left ≫ X.hom) := inferInstance

    have hsurj : Function.Surjective (Limits.pullback.fst x.left w.left) := by
      intro y
      obtain ⟨zw, hzw⟩ := hsurjX y
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := x.left) (g := w.left)
        y zw hzw.symm
