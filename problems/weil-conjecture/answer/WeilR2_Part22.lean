  have hπu : algebraMap A (wcQuadModelRing A n π c) π ∈ (eU u).asIdeal := by
    have h1 := hpt_comap u
    rw [hux, hfx] at h1
    have h3 : π ∈ (PrimeSpectrum.comap (algebraMap A (wcQuadModelRing A n π c)) (eU u)).asIdeal := by
