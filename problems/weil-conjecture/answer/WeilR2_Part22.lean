    have hcen' : ∀ (τ : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing S' m)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing S' m))) (z : wcEtZModExt S' m N),
        (Abelian.Ext.mk₀ (τ.app (SheafOfModules.unit (wcEtZModRing S' m)))).comp z (zero_add N) =
          z.comp (Abelian.Ext.mk₀ (τ.app (SheafOfModules.unit (wcEtZModRing S' m))))
            (add_zero N) := by
      intro τ z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z τ
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨mm, hmm⟩ := hext
    subst hmm
    exact hcen' mm y0



  have hlinG : ∀ (e : SheafOfModules.unit (wcEtZModRing S' m) ⟶
      SheafOfModules.unit (wcEtZModRing S' m)) (X : (S'.Etale)ᵒᵖ)
      (x : ↑((wcEtZModRing S' m).obj.obj X)),
      (e.val.app X).hom x =
        @HMul.hMul (↑((wcEtZModRing S' m).obj.obj X)) (↑((wcEtZModRing S' m).obj.obj X))
          (↑((wcEtZModRing S' m).obj.obj X)) instHMul x
          ((e.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X))) := by
    intro e X x
    have e0 := (e.val.app X).hom.map_smul x (1 : ↑((wcEtZModRing S' m).obj.obj X))
    have e2 : (e.val.app X).hom x = (e.val.app X).hom (x * 1) :=
      congrArg (fun z => (e.val.app X).hom z) (mul_one x).symm
    exact e2.trans e0
  have hiso : IsIso ((Dw.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ)) := by
    let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ
    let ψ₁ := (Dw.adj.homEquiv _ _).symm u
    let h : SheafOfModules.unit (wcEtZModRing S' m) ⟶ SheafOfModules.unit (wcEtZModRing S' m) :=
      Dw.μ.inv ≫ ψ₁
    have e1 : Dw.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
    have hfac : u = wcEtSuppUnitMap Dw ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).map h := by
      calc u = Dw.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = Dw.adj.homEquiv _ _ (Dw.μ.hom ≫ h) := by rw [e1]
        _ = Dw.adj.homEquiv _ _ Dw.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcEtSuppUnitMap Dw ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let T0 : S'.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S') (inferInstance : Etale (𝟙 S'))
    let cT : ↑((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange w).obj T0))) :=
      ((wcEtSuppUnitMap Dw).val.app (Opposite.op T0)).hom
        (1 : ↑((wcEtZModRing S' m).obj.obj (Opposite.op T0)))
    let a : ↑((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange w).obj T0))) :=
      (h.val.app (Opposite.op ((wcEtBaseChange w).obj T0))).hom
        (1 : ↑((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange w).obj T0))))
    have hu1 : (u.val.app (Opposite.op T0)).hom (1 : ↑((wcEtZModRing S' m).obj.obj (Opposite.op T0))) =
        (1 : ↑((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange w).obj T0)))) :=
      (Dw.φ.hom.app (Opposite.op T0)).hom.map_one
    have hev : (u.val.app (Opposite.op T0)).hom (1 : ↑((wcEtZModRing S' m).obj.obj (Opposite.op T0))) =
        (h.val.app (Opposite.op ((wcEtBaseChange w).obj T0))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : ↑((wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange w).obj T0))),
        (h.val.app (Opposite.op ((wcEtBaseChange w).obj T0))).hom x = x * a :=
      fun x => hlinG h _ x
    have key : cT * a = 1 := by
      rw [← hlin cT, ← hev, hu1]
    have key' : a * cT = 1 := by
      rw [hcomm, key]

    let κ : ∀ V : S'.Etale, V ⟶ T0 := fun V =>
      MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    have hκ : ∀ {V V' : S'.Etale} (q : V' ⟶ V), q ≫ κ V = κ V' := by
      intro V V' q
      apply MorphismProperty.Over.Hom.ext
      exact MorphismProperty.Over.w q
    let lam : T0 ⟶ (wcEtBaseChange w).obj T0 :=
      MorphismProperty.Over.homMk
        (Limits.pullback.lift (f := 𝟙 S') (g := w) w (𝟙 S')
          ((Category.comp_id w).trans (Category.id_comp w).symm))
        (Limits.pullback.lift_snd _ _ _) trivial
    let π : ∀ V : S'.Etale, V ⟶ (wcEtBaseChange w).obj T0 := fun V => κ V ≫ lam
    have hπ : ∀ {V V' : S'.Etale} (q : V' ⟶ V), q ≫ π V = π V' := by
      intro V V' q
      show q ≫ (κ V ≫ lam) = κ V' ≫ lam
      rw [← Category.assoc, hκ q]

    have hσX : ∀ X : (S'.Etale)ᵒᵖ,
        ((h.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X)) :
          ↑((wcEtZModRing S' m).obj.obj X)) =
        ((wcEtZModRing S' m).obj.map (π X.unop).op).hom a := by
      intro X
      have hs := PresheafOfModules.sections_property
        ((SheafOfModules.unit (wcEtZModRing S' m)).unitHomEquiv h) (π X.unop).op
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe] at hs
      exact hs.symm

    let τ : ∀ X : (S'.Etale)ᵒᵖ, ↑((wcEtZModRing S' m).obj.obj X) := fun X =>
      ((wcEtZModRing S' m).obj.map (π X.unop).op).hom cT
    have hτ : ∀ ⦃X Y : (S'.Etale)ᵒᵖ⦄ (g : X ⟶ Y),
        ((SheafOfModules.unit (wcEtZModRing S' m)).val.map g).hom (τ X) = τ Y := by
      intro X Y g
      show ((wcEtZModRing S' m).obj.map g).hom
          (((wcEtZModRing S' m).obj.map (π X.unop).op).hom cT) =
        ((wcEtZModRing S' m).obj.map (π Y.unop).op).hom cT
      have hg : (π X.unop).op ≫ g = (π Y.unop).op := by
        rw [← hπ g.unop]
        rfl
      rw [← hg, Functor.map_comp]
      rfl
    let h' : SheafOfModules.unit (wcEtZModRing S' m) ⟶ SheafOfModules.unit (wcEtZModRing S' m) :=
      (SheafOfModules.unit (wcEtZModRing S' m)).unitHomEquiv.symm
        (PresheafOfModules.sectionsMk τ hτ)
    have hh'1 : ∀ X : (S'.Etale)ᵒᵖ,
        ((h'.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X)) :
          ↑((wcEtZModRing S' m).obj.obj X)) = τ X := by
      intro X
      rw [← SheafOfModules.unitHomEquiv_apply_coe, Equiv.apply_symm_apply]
      rfl
    have hhh' : h ≫ h' = 𝟙 _ := by
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      show (h'.val.app X).hom ((h.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X))) =
        (1 : ↑((wcEtZModRing S' m).obj.obj X))
      have hA := hlinG h' X ((h.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X)))
      refine hA.trans ?_
      rw [hσX X, hh'1 X]
      show ((wcEtZModRing S' m).obj.map (π X.unop).op).hom a *
        ((wcEtZModRing S' m).obj.map (π X.unop).op).hom cT = 1
      rw [← map_mul, key', map_one]
    have hh'h : h' ≫ h = 𝟙 _ := by
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      show (h.val.app X).hom ((h'.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X))) =
        (1 : ↑((wcEtZModRing S' m).obj.obj X))
      have hA := hlinG h X ((h'.val.app X).hom (1 : ↑((wcEtZModRing S' m).obj.obj X)))
      refine hA.trans ?_
      rw [hσX X, hh'1 X]
      show ((wcEtZModRing S' m).obj.map (π X.unop).op).hom cT *
        ((wcEtZModRing S' m).obj.map (π X.unop).op).hom a = 1
      rw [← map_mul, key, map_one]
    haveI : IsIso h := ⟨⟨h', hhh', hh'h⟩⟩
    show IsIso ψ₁
    rw [← e1]
    exact IsIso.comp_isIso
  let m0 := asIso ((Dw.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ))



  have hunit : @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont
        Df.φ ≫
      P.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont
        Dw.φ) ≫ γ.app (SheafOfModules.unit (wcEtZModRing S' m)) =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro U
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro a
    have h1 := fun x : ((wcEtZModRing S m).obj.obj U) =>
      ConcreteCategory.congr_hom (congrArg (fun ψ => ψ.hom.app U) hφ) x
    exact h1 a



  have hy' : y' = (Abelian.Ext.mk₀ m0.inv).comp ((Dw.Φ.mapExtAddHom _ _ N y).comp
      (Abelian.Ext.mk₀ m0.hom) (add_zero N)) (zero_add N) := by
    rw [← hy, s2 Dw.μ m0 N _ hcen]
    rfl
  obtain ⟨z0, hz0⟩ :=
    CochainComplex.HomComplex.CohomologyClass.mk_surjective (I.extEquivCohomologyClass y)
  have hφy : Hq'.map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm z0) =
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y) := by
    rw [← hz0, CochainComplex.HomComplex.CohomologyClass.homAddEquiv_apply,
      CochainComplex.HomComplex.CohomologyClass.toHom_mk]
  have hφy' : Hq'.map (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map m0.inv ≫ (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).inv.app (SheafOfModules.unit (wcEtZModRing S' m)) ≫ (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm z0) ≫ ((Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso (N : ℤ)).hom.app I.cochainComplex ≫ t⟦(N : ℤ)⟧')) =
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y') := by
    rw [hy']
    exact s3 Dw.Φ I m0 N t ht y _ hφy
  have e1 := s4 P Dg.Φ (Dg.μ.inv ≫ Dg.Φ.map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ))
    I.cochainComplex (N : ℤ) _ _ hφy
  have e2 := s4 P Dg.Φ (Dg.μ.inv ≫ Dg.Φ.map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ))
    I.cochainComplex (N : ℤ) _ _ hφy'
  have e3 := s5 Dw.Φ Pw Dw.adj P γ Dg.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ)
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ)
    Dg.μ.inv hunit m0 rfl I.cochainComplex t (N : ℤ)
    (CochainComplex.HomComplex.Cocycle.equivHomShift.symm z0)
  have hcc : c y' = c y ≫ (Hq.map TΨ)⟦(N : ℤ)⟧' := by
    change _ = _ at e1 e2
    refine e2.trans ?_
    rw [e3, Functor.map_comp, Category.assoc]
    erw [Functor.commShiftIso_hom_naturality]
    rw [← Category.assoc]
    first
      | exact congrArg (· ≫ _) e1.symm
      | (rw [← e1]; rfl)
      | (erw [← e1]; rfl)
  exact s6 _ Ψ (N : ℤ) TΨ (c y) (c y') hcc

theorem wc_et_beta_additive {S S' Z : Scheme.{u}} {f : S' ⟶ S} {g : Z ⟶ S} {m : ℕ}
    (Df : wcEtPullData f m) (Dg : wcEtPullData g m)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S' m))) (N : ℕ) :
    haveI := Df.additive
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing S m)) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Z m)) (ComplexShape.up ℤ) 0).map
          Dg.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing S m)) ≫
        (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Z m))
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' m)) := HasExt.standard _
    let F := P ⋙ Dg.Φ
    let Hq := HomotopyCategory.quotient (SheafOfModules.{u+1} (wcEtZModRing Z m)) (ComplexShape.up ℤ)
    let Hq' := HomotopyCategory.quotient (SheafOfModules.{u+1} (wcEtZModRing S' m)) (ComplexShape.up ℤ)
    let c := fun y : wcEtZModExt S' m N =>
      (show Hq.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing Z m))) ⟶ (Hq.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        Hq.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
              (Dg.μ.inv ≫ Dg.Φ.map
                (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ))) ≫
          Hq.map ((HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).inv.app
              (SheafOfModules.unit (wcEtZModRing S' m))) ≫
          (F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            (CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y)) ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            ((Hq'.commShiftIso ((N : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
          ((F.mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso ((N : ℕ) : ℤ)).hom.app
            (Hq'.obj I.cochainComplex) ≫
          ((F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app I.cochainComplex)⟦((N : ℕ) : ℤ)⟧' ≫
          (Hq.map ((Functor.mapHomologicalComplexCompIso (Iso.refl F) (ComplexShape.up ℤ)).inv.app
              I.cochainComplex))⟦((N : ℕ) : ℤ)⟧')
    let β := fun y : wcEtZModExt S' m N =>
      (show DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing Z m))) ⟶ (DerivedCategory.Q.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        (DerivedCategory.quotientCompQhIso _).inv.app _ ≫ DerivedCategory.Qh.map (c y) ≫
          (DerivedCategory.Qh.commShiftIso ((N : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
          ((DerivedCategory.quotientCompQhIso _).hom.app Ψ)⟦((N : ℕ) : ℤ)⟧')
    ∀ y y' : wcEtZModExt S' m N, β (y + y') = β y + β y' :=
by
  intro P K eK eΨ Ψ F Hq Hq' c β y y'
  have hA : c (y + y') = c y + c y' := by
    simp only [c, InjectiveResolution.extEquivCohomologyClass_add]
    first
    | (rw [AddEquiv.map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add,
        Preadditive.comp_add, Preadditive.comp_add])
    | (erw [AddEquiv.map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add,
        Preadditive.comp_add, Preadditive.comp_add])
    | (erw [map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add,
        Preadditive.comp_add, Preadditive.comp_add])
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Z m))
  show _ ≫ DerivedCategory.Qh.map (c (y + y')) ≫ _ = _ ≫ DerivedCategory.Qh.map (c y) ≫ _ +
    _ ≫ DerivedCategory.Qh.map (c y') ≫ _
  rw [hA, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]

theorem wc_et_tpl_closed_fibre_milnor (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x' : ↥(Limits.pullback D.f a)) (hx' : Limits.pullback.snd D.f a x' = IsLocalRing.closedPoint A)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x'))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x' B Λ' W'' φ' a') :
    Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) 0) = ℓ ^ k ∧
    ∀ q : ℕ, 1 ≤ q → q ≠ n - 1 →
      Subsingleton (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q) :=
by
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  obtain ⟨l⟩ : Nonempty Λ := by
    first
    | exact inferInstance
    | exact IsCofiltered.nonempty
  have ha : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    have h1 := wc_shdata_closed_point_compat _ A Λ W' φ a hA l
    have h2 : (W'.obj l).hom.left ≫ (W'.obj l).right.hom =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) := Over.w (W'.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint A)) (hA.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W'.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure ((wcP1Over F'').left.residueField
            (D.S i (IsLocalRing.closedPoint F'')))))) h2).trans (hγ _ _ _)))))
  have hξne : ξ (IsLocalRing.closedPoint (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ≠
      IsLocalRing.closedPoint A := by
    intro h
    apply hηne
    have h1 : (ξ ≫ a) (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField η))) = η :=
      (congrArg (fun g => g (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField η)))) hξ).trans (hγ _ _ _)
    have h2 := (comp_ap ξ a _).symm.trans h1
    have h3 := congrArg a h
    exact h2.symm.trans (h3.trans ha)
  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ : ℕ) : F'')) := isUnit_iff_ne_zero.mpr hℓK
  have hunitℓ : IsUnit (((ℓ : ℕ) : A)) := by
    have h1 := hunitK.map (Spec.preimage (a ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at h1
  have s4 : ∀ (Z : Scheme.{u}) (m j : ℕ) (e : wcEtZModExt Z m j), m • e = 0 := by
    intro Z m j e
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have h1 : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply (SheafOfModules.toSheaf (wcEtZModRing Z m)).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      exact wc_et_zmod_toSheaf_nsmul_zero Z m _
    have h2 : ∀ c : ℕ, c • e = e.comp (Abelian.Ext.mk₀
        (c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)))) (add_zero j) := by
      intro c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih =>
        rw [succ_nsmul, ih, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
          Abelian.Ext.comp_mk₀_id]
    rw [h2 m, h1, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  by_cases hnode : Limits.pullback.fst D.f a x' = D.xs i (IsLocalRing.closedPoint F'')
  ·
    have hlowL := wc_pencil_odp_shens_milnor_fibre_low F' F'' Y n hn hn2 D ℓ Fact.out hℓ k i A Λ
      W' φ a hA x' hnode B Λ' W'' φ' a' hsh _ ξ hξne
    refine ⟨hlowL.1, ?_⟩
    intro q hq1 hqN
    have hq' : q + 2 ≤ n ∨ n ≤ q := by omega
    rcases hq' with hlow | hhigh
    · exact hlowL.2 q hq1 hlow
    · rcases Nat.eq_zero_or_pos k with hk0 | hkpos
      · have hk1 : ℓ ^ k = 1 := by rw [hk0, pow_zero]
        obtain ⟨e⟩ := wc_et_zmodext_coh_equiv
          (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q
        haveI : Subsingleton (wcEtZModExt
            (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q) := by
          constructor
          intro x y
          have hx : x = 0 := (one_smul ℕ x).symm.trans
            ((congrArg (fun c : ℕ => c • x) hk1.symm).trans (s4 _ _ _ x))
          have hy : y = 0 := (one_smul ℕ y).symm.trans
            ((congrArg (fun c : ℕ => c • y) hk1.symm).trans (s4 _ _ _ y))
          rw [hx, hy]
        exact e.symm.injective.subsingleton
      · obtain ⟨hdom, hdvr, π, c, hπ, hc, x₀, hX, hx₀, B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, hB₀, θ, hθ⟩ :=
          wc_pencil_odp_shens_morse_model F' F'' Y n hn hn2 D i A Λ W' φ a hA x' hnode B Λ' W'' φ' a' hsh
        haveI := hdom
        haveI := hdvr
        exact (wc_quad_model_iso_milnor_fibre_high A ℓ Fact.out hunitℓ n hn hn2 π c hπ hc x₀ hX hx₀
          B₀ Λ₀ W₀ φ₀ a₀ hB₀ _ (Limits.pullback.snd D.f a) B a' θ hθ _ ξ hξne k hkpos).2 q hhigh
  ·
    have hfy : D.f (Limits.pullback.fst D.f a x') = D.S i (IsLocalRing.closedPoint F'') := by
      have e1 := congrArg (fun g => g x') (Limits.pullback.condition (f := D.f) (g := a))
      exact ((comp_ap _ _ _).symm.trans e1).trans ((comp_ap _ _ _).trans ((congrArg a hx').trans ha))
    have hc : ∀ j, Limits.pullback.fst D.f a x' ≠ D.xs j (IsLocalRing.closedPoint F'') := by
      intro j hj
      apply hnode
      have hSj : D.f (D.xs j (IsLocalRing.closedPoint F'')) = D.S j (IsLocalRing.closedPoint F'') :=
        (comp_ap (D.xs j) D.f _).symm.trans (congrArg (fun g => g (IsLocalRing.closedPoint F''))
          (D.hxs j))
      have hj' : D.S j (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
        rw [← hfy, hj, hSj]
      have hji : j = i := D.hSinj hj'
      rw [hj, hji]
    obtain ⟨U, hyU, hsm⟩ := D.smooth_off _ hc
    have hpb : IsPullback (Limits.pullback.fst D.f a ∣_ U)
        ((Limits.pullback.fst D.f a ⁻¹ᵁ U).ι ≫ Limits.pullback.snd D.f a) (U.ι ≫ D.f) a :=
      (isPullback_morphismRestrict (Limits.pullback.fst D.f a) U).paste_vert
        (IsPullback.of_hasPullback D.f a)
    have hsm' : Smooth ((Limits.pullback.fst D.f a ⁻¹ᵁ U).ι ≫ Limits.pullback.snd D.f a) :=
      MorphismProperty.of_isPullback (P := @Smooth) hpb hsm
    have hunit : IsUnit (((ℓ ^ k : ℕ) : A)) := by
      rw [Nat.cast_pow]
      exact hunitℓ.pow k
    have H := wc_smooth_open_shens_milnor_fibre_acyclic A _ (Limits.pullback.snd D.f a) _ hsm'
      (ℓ ^ k) hunit x' hyU hx' B Λ' W'' φ' a' hsh _ ξ
    exact ⟨H.1, fun q hq1 _ => H.2 q hq1⟩

theorem wc_et_pull_isZero_of_range_stalks : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ) (D : wcEtPullData g n) (N : SheafOfModules.{u+1} (wcEtZModRing S n)), IsClosed (Set.range g) → (∀ s' : S', Subsingleton ((wcEtStalk S (g s')).obj ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj N))) → Limits.IsZero (D.Φ.obj N) :=
by
  intro S S' g n D N hcl hstalk
  letI := D.cont

  have h1 : wcSuppIn S (Set.range g)ᶜ ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj N) :=
    wc_et_suppIn_of_closed_stalks S (Set.range g) hcl _ (by
      rintro x ⟨s', rfl⟩
      exact hstalk s')

  let e : wcEtPush g ≅ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S') :=
    Functor.isoWhiskerRight ((wcEtBaseChange g).sheafPushforwardContinuousCompSheafToPresheafIso
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).symm
      (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  have adjL : (wcEtBaseChange g).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') ⊣ wcEtPush g :=
    (Functor.sheafAdjunctionContinuous (wcEtBaseChange g) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).ofNatIsoRight e.symm

  have h2 := wc_et_pull_suppIn g _ adjL _ _ h1
  have hpre : g ⁻¹' (Set.range g)ᶜ = ∅ := by
    ext x
    simp
  rw [hpre] at h2

  have hgen : ∀ (F : Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}),
      wcSuppIn S' ∅ F → Limits.IsZero F := by
    intro F hF
    have hemp : ∀ (U : S'.Etale), (∀ x, U.hom x ∈ (∅ : Set S')) →
        ∀ t : F.obj.obj (Opposite.op U), t = 0 := by
      intro U hU t
      haveI hE : IsEmpty ↥U.left := ⟨fun x => Set.notMem_empty _ (hU x)⟩
      have hBot : (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology S' U :=
        (congrArg (fun J : GrothendieckTopology S'.Etale => (⊥ : Sieve U) ∈ J U)
          (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
            S' MorphismProperty.IsMultiplicative.toIsStableUnderComposition
            _ _ _ _ le_rfl)).mpr
          ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S'
            MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
            U (⊥ : Sieve U)).2 (fun x => isEmptyElim x))
      exact @Subsingleton.elim _ (AddCommGrpCat.subsingleton_of_isZero
        (Sheaf.isTerminalOfBotCover F U hBot).isZero) _ _
    have hsub : ∀ (V : S'.Etale) (s : F.obj.obj (Opposite.op V)), s = 0 := by
      intro V s
      refine Sheaf.isSeparated F V _ (hF V s) s 0 ?_
      intro V'' f hf
      obtain ⟨V', a, b, hb, rfl⟩ := hf
      rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
      rcases hb with h0 | hW
      · rw [h0, map_zero]
      · rw [hemp V' hW (F.obj.map b.op s), map_zero]
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext V s
    exact (hsub _ _).trans (hsub _ _).symm
  have hZ := hgen _ h2

  obtain ⟨α⟩ := wc_et_pull_data_toSheaf_iso D
  have hZ' : Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing S' n)).obj (D.Φ.obj N)) :=
    hZ.of_iso (α.app N)
  rw [Limits.IsZero.iff_id_eq_zero]
  apply (SheafOfModules.toSheaf (wcEtZModRing S' n)).map_injective
  rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
  exact hZ'.eq_of_src _ _

theorem wc_et_tpl_unit_restr_iso (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)) :
    IsIso (Dg.Φ.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ)) :=
by
  classical

  have hfinal : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S), (wcEtBaseChange g).Final := by
    intro S S' g
    let F := wcEtBaseChange g
    let T : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : Etale (𝟙 S))
    have hT : Limits.IsTerminal T := Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial)
      (fun V m => by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m))
    have hFT : Limits.IsTerminal (F.obj T) := Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk
        (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp) : V.left ⟶ Limits.pullback (𝟙 S) g)
        (Limits.pullback.lift_snd _ _ _) trivial)
      (fun V m => by
        apply MorphismProperty.Over.Hom.ext
        have hw : m.left ≫ Limits.pullback.snd (𝟙 S) g = V.hom := MorphismProperty.Over.w m
        show @Eq (V.left ⟶ Limits.pullback (𝟙 S) g) m.left
          (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp))
        apply Limits.pullback.hom_ext
        · have hl1 := Limits.pullback.lift_fst (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
          have hc := Limits.pullback.condition (f := 𝟙 S) (g := g)
          rw [Category.comp_id] at hc
          have h2 : m.left ≫ Limits.pullback.fst (𝟙 S) g = V.hom ≫ g := by
            rw [hc]
            exact (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ g) hw)
          exact h2.trans hl1.symm
        · have hl2 := Limits.pullback.lift_snd (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
          exact hw.trans hl2.symm)
    refine Functor.Final.mk (fun d => ?_)
    have hterm : Limits.IsTerminal (StructuredArrow.mk (hFT.from d) : StructuredArrow d F) :=
      Limits.IsTerminal.ofUniqueHom
        (fun X => StructuredArrow.homMk (hT.from X.right) (hFT.hom_ext _ _))
        (fun X m => StructuredArrow.hom_ext _ _ (hT.hom_ext _ _))
    haveI := hterm.hasTerminal
    exact isConnected_of_hasTerminal _

  have htrans : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {m : ℕ} (E : wcEtPullData g m),
      IsIso ((E.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ)) := by
    intro S S' g m E
    haveI := E.cont
    haveI : (wcEtBaseChange g).Final := hfinal g
    haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ).IsRightAdjoint :=
      ⟨_, ⟨E.adj⟩⟩
    let pPA := SheafOfModules.pullbackPushforwardAdjunction E.φ
    let e := E.adj.leftAdjointUniq pPA
    have h1 : (E.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) =
        e.hom.app _ ≫ (pPA.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) := by
      rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit,
        ← Adjunction.leftAdjointUniq_hom_app_counit E.adj pPA]
      rw [← Category.assoc, NatTrans.naturality, Category.assoc]
    rw [h1, SheafOfModules.pullbackPushforwardAdjunction_homEquiv_symm_unitToPushforwardObjUnit]
    infer_instance

  haveI := Dh.cont
  let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
  let P := @SheafOfModules.pushforward _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
  let ψ := (Dh.adj.homEquiv _ _).symm u
  haveI hψ : IsIso ψ := htrans Dh
  let c := Dh.μ.inv ≫ ψ
  have hfac : u = wcEtSuppUnitMap Dh ≫ P.map c := by
    have e1 : Dh.μ.hom ≫ c = ψ := Iso.hom_inv_id_assoc _ _
    calc u = Dh.adj.homEquiv _ _ ψ := (Equiv.apply_symm_apply _ _).symm
      _ = Dh.adj.homEquiv _ _ (Dh.μ.hom ≫ c) := by rw [e1]
      _ = Dh.adj.homEquiv _ _ Dh.μ.hom ≫ P.map c := Adjunction.homEquiv_naturality_right _ _ _
      _ = wcEtSuppUnitMap Dh ≫ P.map c := by rw [Adjunction.homEquiv_unit]; rfl

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      Ideal.Quotient.mk_surjective
  have hclosed : IsClosed (Set.range
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) :=
    (IsClosedImmersion.isClosedEmbedding _).isClosed_range
  have hpt : ∀ z : ↥(Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)),
      Limits.pullback.snd D.f a (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
        IsLocalRing.closedPoint A := by
    intro z
    have e1 : Limits.pullback.snd D.f a
        (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
        wcQmSp A (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A) z) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [e1, Subsingleton.elim (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A) z)
      (IsLocalRing.closedPoint _)]
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
      (inferInstance : IsLocalHom (IsLocalRing.residue A))
    exact AlgebraicGeometry.Spec_closedPoint

  have hstalk := fun z => wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A
    (Limits.pullback D.f a) (Limits.pullback.snd D.f a) (ℓ ^ k)
    (pow_pos (Fact.out : ℓ.Prime).pos k)
    (AlgebraicClosure ((wcP1Over F'').left.residueField η)) ξ Dh
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z)
    (fun B _ _ _ Λ' _ _ W'' φ' a' hsh =>
      (wc_et_tpl_closed_fibre_milnor F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
        _ (hpt z) B Λ' W'' φ' a' hsh).1)

  have hK := wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg
    (Limits.kernel (wcEtSuppUnitMap Dh)) hclosed (fun z => (hstalk z).1)
  have hC := wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg
    (Limits.cokernel (wcEtSuppUnitMap Dh)) hclosed (fun z => (hstalk z).2)

  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  have hK' : Limits.IsZero (Limits.kernel (Dg.Φ.map (wcEtSuppUnitMap Dh))) :=
    hK.of_iso (Limits.PreservesKernel.iso Dg.Φ (wcEtSuppUnitMap Dh)).symm
  have hC' : Limits.IsZero (Limits.cokernel (Dg.Φ.map (wcEtSuppUnitMap Dh))) :=
    hC.of_iso (Limits.PreservesCokernel.iso Dg.Φ (wcEtSuppUnitMap Dh)).symm
  haveI : Mono (Dg.Φ.map (wcEtSuppUnitMap Dh)) :=
    Preadditive.mono_of_isZero_kernel' _ (Limits.kernelIsKernel _) hK'
  haveI : Epi (Dg.Φ.map (wcEtSuppUnitMap Dh)) :=
    Preadditive.epi_of_isZero_cokernel' _ (Limits.cokernelIsCokernel _) hC'
  have hs : IsIso (Dg.Φ.map (wcEtSuppUnitMap Dh)) := isIso_of_mono_of_epi _
  have hc : IsIso c := IsIso.comp_isIso' inferInstance hψ
  have hPc : IsIso (P.map c) := @Functor.map_isIso _ _ _ _ _ _ P c hc
  have hΦPc : IsIso (Dg.Φ.map (P.map c)) := @Functor.map_isIso _ _ _ _ _ _ Dg.Φ (P.map c) hPc
  have key : IsIso (Dg.Φ.map (wcEtSuppUnitMap Dh) ≫ Dg.Φ.map (P.map c)) :=
    IsIso.comp_isIso' hs hΦPc
  have hmap : Dg.Φ.map u = Dg.Φ.map (wcEtSuppUnitMap Dh) ≫ Dg.Φ.map (P.map c) :=
    (congrArg Dg.Φ.map hfac).trans (Dg.Φ.map_comp _ _)
  show IsIso (Dg.Φ.map u)
  exact cast (congrArg (fun t => IsIso t) hmap).symm key

theorem wc_et_tpl_restr_higher_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (q : ℕ) (hq1 : 1 ≤ q) (hqN : q ≠ n - 1) :
    haveI := Dh.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    Limits.IsZero (Dg.Φ.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :=
by
  intro P
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])

  obtain ⟨l⟩ : Nonempty Λ := by
    first
    | exact inferInstance
    | exact IsCofiltered.nonempty
  have ha : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    have h1 := wc_shdata_closed_point_compat _ A Λ W' φ a hA l
    have h2 : (W'.obj l).hom.left ≫ (W'.obj l).right.hom =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) := Over.w (W'.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint A)) (hA.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W'.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure ((wcP1Over F'').left.residueField
            (D.S i (IsLocalRing.closedPoint F'')))))) h2).trans (hγ _ _ _)))))

  have hξne : ξ (IsLocalRing.closedPoint (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ≠
      IsLocalRing.closedPoint A := by
    intro h
    apply hηne
    have h1 : (ξ ≫ a) (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField η))) = η :=
      (congrArg (fun g => g (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField η)))) hξ).trans (hγ _ _ _)
    have h2 := (comp_ap ξ a _).symm.trans h1
    have h3 := congrArg a h
    exact h2.symm.trans (h3.trans ha)
  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ : ℕ) : F'')) := isUnit_iff_ne_zero.mpr hℓK
  have hunitℓ : IsUnit (((ℓ : ℕ) : A)) := by
    have h1 := hunitK.map (Spec.preimage (a ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at h1

  have s4 : ∀ (Z : Scheme.{u}) (m j : ℕ) (e : wcEtZModExt Z m j), m • e = 0 := by
    intro Z m j e
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have h1 : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply (SheafOfModules.toSheaf (wcEtZModRing Z m)).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      exact wc_et_zmod_toSheaf_nsmul_zero Z m _
    have h2 : ∀ c : ℕ, c • e = e.comp (Abelian.Ext.mk₀
        (c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)))) (add_zero j) := by
      intro c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih =>
        rw [succ_nsmul, ih, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
          Abelian.Ext.comp_mk₀_id]
    rw [h2 m, h1, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hclosed : IsClosed (Set.range (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) :=
    (Scheme.Hom.isClosedEmbedding _).isClosed_range

  have hzA : ∀ z, Limits.pullback.snd D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) = IsLocalRing.closedPoint A := by
    intro z
    have e1 := congrArg (fun g => g z)
      (Limits.pullback.condition (f := Limits.pullback.snd D.f a) (g := wcQmSp A))
    refine ((comp_ap _ _ _).symm.trans e1).trans ?_
    refine (comp_ap _ _ _).trans ?_
    have hu : Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A) z =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
      @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField A)) _ _ _
    rw [hu]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)

  refine wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg _ hclosed ?_
  intro z
  have hz := hzA z
  refine wc_et_module_push_stalk_vanish_of_milnor_deg A (Limits.pullback D.f a)
    (Limits.pullback.snd D.f a) (ℓ ^ k) hm _ ξ Dh I _ q ?_
  intro B _ _ _ Λ' _ _ W'' φ' a' hsh

  by_cases hnode : Limits.pullback.fst D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
      D.xs i (IsLocalRing.closedPoint F'')
  ·
    have hq' : q + 2 ≤ n ∨ n ≤ q := by omega
    rcases hq' with hlow | hhigh
    · exact (wc_pencil_odp_shens_milnor_fibre_low F' F'' Y n hn hn2 D ℓ Fact.out hℓ k i A Λ W' φ a
        hA _ hnode B Λ' W'' φ' a' hsh _ ξ hξne).2 q hq1 hlow
    · rcases Nat.eq_zero_or_pos k with hk0 | hkpos
      · have hk1 : ℓ ^ k = 1 := by rw [hk0, pow_zero]
        obtain ⟨e⟩ := wc_et_zmodext_coh_equiv
          (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q
        haveI : Subsingleton (wcEtZModExt
            (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q) := by
          constructor
          intro x y
          have hx : x = 0 := (one_smul ℕ x).symm.trans
            ((congrArg (fun c : ℕ => c • x) hk1.symm).trans (s4 _ _ _ x))
          have hy : y = 0 := (one_smul ℕ y).symm.trans
            ((congrArg (fun c : ℕ => c • y) hk1.symm).trans (s4 _ _ _ y))
          rw [hx, hy]
        exact e.symm.injective.subsingleton
      · obtain ⟨hdom, hdvr, π, c, hπ, hc, x₀, hX, hx₀, B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, hB₀, θ, hθ⟩ :=
          wc_pencil_odp_shens_morse_model F' F'' Y n hn hn2 D i A Λ W' φ a hA _ hnode B Λ' W'' φ' a' hsh
        haveI := hdom
        haveI := hdvr
        exact (wc_quad_model_iso_milnor_fibre_high A ℓ Fact.out hunitℓ n hn hn2 π c hπ hc x₀ hX hx₀
          B₀ Λ₀ W₀ φ₀ a₀ hB₀ _ (Limits.pullback.snd D.f a) B a' θ hθ _ ξ hξne k hkpos).2 q hhigh
  ·
    have hfy : D.f (Limits.pullback.fst D.f a
        (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z)) =
        D.S i (IsLocalRing.closedPoint F'') := by
      have e1 := congrArg (fun g => g (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z))
        (Limits.pullback.condition (f := D.f) (g := a))
      exact ((comp_ap _ _ _).symm.trans e1).trans ((comp_ap _ _ _).trans ((congrArg a hz).trans ha))
    have hc : ∀ j, Limits.pullback.fst D.f a
        (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) ≠
        D.xs j (IsLocalRing.closedPoint F'') := by
      intro j hj
      apply hnode
      have hSj : D.f (D.xs j (IsLocalRing.closedPoint F'')) = D.S j (IsLocalRing.closedPoint F'') :=
        (comp_ap (D.xs j) D.f _).symm.trans (congrArg (fun g => g (IsLocalRing.closedPoint F''))
          (D.hxs j))
      have hj' : D.S j (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
        rw [← hfy, hj, hSj]
      have hji : j = i := D.hSinj hj'
      rw [hj, hji]
    obtain ⟨U, hyU, hsm⟩ := D.smooth_off _ hc
    have hpb : IsPullback (Limits.pullback.fst D.f a ∣_ U)
        ((Limits.pullback.fst D.f a ⁻¹ᵁ U).ι ≫ Limits.pullback.snd D.f a) (U.ι ≫ D.f) a :=
      (isPullback_morphismRestrict (Limits.pullback.fst D.f a) U).paste_vert
        (IsPullback.of_hasPullback D.f a)
    have hsm' : Smooth ((Limits.pullback.fst D.f a ⁻¹ᵁ U).ι ≫ Limits.pullback.snd D.f a) :=
      MorphismProperty.of_isPullback (P := @Smooth) hpb hsm
    have hunit : IsUnit (((ℓ ^ k : ℕ) : A)) := by
      rw [Nat.cast_pow]
      exact hunitℓ.pow k
    exact (wc_smooth_open_shens_milnor_fibre_acyclic A _ (Limits.pullback.snd D.f a) _ hsm' (ℓ ^ k)
      hunit _ hyU hz B Λ' W'' φ' a' hsh _ ξ).2 q hq1

theorem wc_et_tpl_sfu_geom_pt_closed_immersion (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x) :
    IsClosedImmersion (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) :=
by
  classical
  have isoSurj : ∀ {R S : CommRingCat.{u}} (e : R ≅ S), Function.Surjective e.hom.hom :=
    fun e t => ⟨e.inv.hom t, by rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]⟩

  have s1 : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) [SurjectiveOnStalks φ] (x : X),
      Function.Surjective (φ.residueFieldMap x).hom := by
    intro X Y φ _ x
    have h := Scheme.residue_residueFieldMap φ x
    have h2 : (φ.residueFieldMap x).hom ∘ (Y.residue (φ x)).hom =
        (X.residue x).hom ∘ (φ.stalkMap x).hom := by
      funext t
      have := congrArg (fun k => k.hom t) h
      simpa using this
    have h3 : Function.Surjective ((X.residue x).hom ∘ (φ.stalkMap x).hom) :=
      (Scheme.residue_surjective X x).comp (φ.stalkMap_surjective x)
    rw [← h2] at h3
    exact Function.Surjective.of_comp h3

  have s2 : ∀ {Y V P : Scheme.{u}} {K : Type u} [Field K] (f : Y ⟶ P) (g : V ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w w' : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g w = s (IsLocalRing.closedPoint K) →
      Limits.pullback.fst f g w' = s (IsLocalRing.closedPoint K) →
      Limits.pullback.snd f g w = Limits.pullback.snd f g w' → w = w' := by
    intro Y V P K _ f g s _ w w' hw hw' h
    obtain ⟨q, -, hq2⟩ := Scheme.Pullback.exists_preimage_pullback _ w hw.symm
    obtain ⟨q', -, hq2'⟩ := Scheme.Pullback.exists_preimage_pullback _ w' hw'.symm
    have hE := Limits.pullbackRightPullbackFstIso_hom_snd f g s
    have hj : Function.Injective (Limits.pullback.snd (s ≫ f) g) :=
      (Limits.pullback.snd (s ≫ f) g).isClosedEmbedding.isEmbedding.injective
    have e1 : ∀ r, Limits.pullback.snd (s ≫ f) g ((Limits.pullbackRightPullbackFstIso f g s).hom r)
        = Limits.pullback.snd f g (Limits.pullback.snd s (Limits.pullback.fst f g) r) := by
      intro r
      rw [← Scheme.Hom.comp_apply, hE, Scheme.Hom.comp_apply]
    have h4 : (Limits.pullbackRightPullbackFstIso f g s).hom q =
        (Limits.pullbackRightPullbackFstIso f g s).hom q' := hj (by rw [e1, e1, hq2, hq2', h])
    have hqq : q = q' := by
      have := congrArg (Limits.pullbackRightPullbackFstIso f g s).inv h4
      rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at this
    rw [← hq2, ← hq2', hqq]

  have s3 : ∀ {Y V P : Scheme.{u}} {K : Type u} [Field K] (f : Y ⟶ P) (g : V ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g w = s (IsLocalRing.closedPoint K) →
      Function.Surjective ((Limits.pullback.snd f g).residueFieldMap w).hom := by
    intro Y V P K _ f g s _ w hw
    obtain ⟨q, -, rfl⟩ := Scheme.Pullback.exists_preimage_pullback _ w hw.symm
    have hE : Limits.pullback.snd s (Limits.pullback.fst f g) ≫ Limits.pullback.snd f g =
        (Limits.pullbackRightPullbackFstIso f g s).hom ≫ Limits.pullback.snd (s ≫ f) g :=
      (Limits.pullbackRightPullbackFstIso_hom_snd f g s).symm
    have hc := s1 (Limits.pullback.snd (s ≫ f) g) ((Limits.pullbackRightPullbackFstIso f g s).hom q)
    have hd := s1 (Limits.pullbackRightPullbackFstIso f g s).hom q
    have hcomp : Function.Surjective
        (((Limits.pullbackRightPullbackFstIso f g s).hom ≫
          Limits.pullback.snd (s ≫ f) g).residueFieldMap q).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hd.comp hc
    have h3 := Scheme.Hom.residueFieldMap_congr hE q
    have hba : Function.Surjective
        ((Limits.pullback.snd s (Limits.pullback.fst f g) ≫
          Limits.pullback.snd f g).residueFieldMap q).hom := by
      rw [h3]
      exact hcomp.comp (isoSurj _)
    rw [Scheme.residueFieldMap_comp] at hba
    have hba' : Function.Surjective
        (⇑((Limits.pullback.snd s (Limits.pullback.fst f g)).residueFieldMap q).hom ∘
          ⇑((Limits.pullback.snd f g).residueFieldMap
            ((Limits.pullback.snd s (Limits.pullback.fst f g)) q)).hom) := hba
    intro t
    obtain ⟨r, hr⟩ := hba'
      (((Limits.pullback.snd s (Limits.pullback.fst f g)).residueFieldMap q).hom t)
    exact ⟨r, ((Limits.pullback.snd s (Limits.pullback.fst f g)).residueFieldMap q).hom.injective hr⟩

  have s4 : ∀ (K : Type u) [Field K] [Finite K] (X : Scheme.{u}) (s : Spec (.of K) ⟶ X),
      Finite (X.residueField (s (IsLocalRing.closedPoint K))) := by
    intro K _ _ X s
    have hsurj : Function.Surjective ((stalkClosedPointIso (CommRingCat.of K)).inv ≫
        (Spec (.of K)).residue (IsLocalRing.closedPoint K)).hom := by
      rw [CommRingCat.hom_comp]
      exact (Scheme.residue_surjective _ _).comp
        (isoSurj (stalkClosedPointIso (CommRingCat.of K)).symm)
    haveI : Finite ((Spec (.of K)).residueField (IsLocalRing.closedPoint K)) :=
      Finite.of_surjective _ hsurj
    have key : ∀ (Z : Scheme.{u}) (z : Z), Finite (Z.residueField z) → ∀ (X' : Scheme.{u})
        (s' : Z ⟶ X'), Finite (X'.residueField (s' z)) := by
      intro Z z _ X' s'
      exact Finite.of_injective _ (s'.residueFieldMap z).hom.injective
    exact key (Spec (.of K)) (IsLocalRing.closedPoint K) inferInstance X s

  have s5 : ∀ (k K₀ : Type u) [Field k] [IsSepClosed k] [Field K₀] [Finite K₀]
      (e : k →+* AlgebraicClosure K₀), IsAlgClosed k := by
    intro k K₀ _ _ _ _ e
    obtain ⟨p, hchar⟩ := CharP.exists K₀
    have hp : p.Prime := CharP.char_is_prime K₀ p
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP (AlgebraicClosure K₀) p :=
      (RingHom.charP_iff_charP (algebraMap K₀ (AlgebraicClosure K₀)) p).mp hchar
    haveI : CharP k p := (RingHom.charP_iff_charP e p).mpr inferInstance
    haveI : ExpChar k p := ExpChar.prime hp
    have htor : ∀ b : k, ∃ m : ℕ, b ^ (p ^ (m + 1)) = b := by
      intro b
      have hx : IsIntegral K₀ (e b) := Algebra.IsIntegral.isIntegral (e b)
      haveI : FiniteDimensional K₀ (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) :=
        IntermediateField.adjoin.finiteDimensional hx
      haveI : Finite (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) :=
        Module.finite_of_finite K₀
      letI := Fintype.ofFinite (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)))
      haveI : CharP (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) p :=
        (RingHom.charP_iff_charP
          (algebraMap K₀ (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)))) p).mp hchar
      obtain ⟨N, -, hcard⟩ :=
        FiniteField.card (IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀))) p
      have hy := FiniteField.pow_card
        (⟨e b, IntermediateField.mem_adjoin_simple_self K₀ (e b)⟩ :
          IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)))
      rw [hcard] at hy
      have hx' : (e b) ^ (p ^ (N : ℕ)) = e b := by
        have := congrArg
          (fun z : IntermediateField.adjoin K₀ ({e b} : Set (AlgebraicClosure K₀)) =>
            (z : AlgebraicClosure K₀)) hy
        simpa using this
      have hb : b ^ (p ^ (N : ℕ)) = b := e.injective (by rw [map_pow]; exact hx')
      refine ⟨(N : ℕ) - 1, ?_⟩
      rw [Nat.sub_add_cancel N.pos]
      exact hb
    have hsurj : Function.Surjective (frobenius k p) := by
      intro b
      obtain ⟨m, hm⟩ := htor b
      refine ⟨b ^ (p ^ m), ?_⟩
      rw [frobenius_def, ← pow_mul, ← pow_succ]
      exact hm
    haveI : PerfectRing k p := PerfectRing.ofSurjective k p hsurj
    haveI : PerfectField k := PerfectRing.toPerfectField k p
    exact IsSepClosed.isAlgClosed_of_perfectField k

  have s6 : ∀ (K : Type u) [Field K] [IsAlgClosed K] {X : Scheme.{u}} (σ : X ⟶ Spec (.of K))
      (x : X), Function.Surjective (σ.residueFieldMap x).hom → IsAlgClosed (X.residueField x) := by
    intro K _ _ X σ x h
    have hp : σ x = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    let Φ : CommRingCat.of K ⟶ X.residueField x :=
      (stalkClosedPointIso (CommRingCat.of K)).inv ≫
        (Spec (.of K)).residue (IsLocalRing.closedPoint K) ≫
        (Scheme.residueFieldCongr hp).inv ≫ σ.residueFieldMap x
    have hΦ : Function.Surjective Φ.hom := by
      simp only [Φ, CommRingCat.hom_comp]
      refine h.comp (Function.Surjective.comp (isoSurj (Scheme.residueFieldCongr hp).symm)
        ((Scheme.residue_surjective _ _).comp (isoSurj (stalkClosedPointIso (CommRingCat.of K)).symm)))
    exact IsAlgClosed.of_ringEquiv K (X.residueField x)
      (RingEquiv.ofBijective Φ.hom ⟨Φ.hom.injective, hΦ⟩)

  haveI hS : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  haveI hs : IsClosedImmersion (D.xs i) := isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    (by rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i])
  haveI hsf : IsClosedImmersion (D.xs i ≫ D.f) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.xs i ≫ D.f) (by rw [D.hxs i, D.hS i])
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hiSinj : Function.Injective
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) :=
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)).isClosedEmbedding.isEmbedding.injective
  have hv : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)),
      Limits.pullback.snd D.f a (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
        IsLocalRing.closedPoint A := by
    intro z
    have hc := congrArg (fun φ => φ z)
      (Limits.pullback.condition (f := Limits.pullback.snd D.f a) (g := wcQmSp A))
    simp only [Scheme.Hom.comp_apply] at hc
    rw [hc]
    show Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) _ = _
    rw [Spec.map_apply, CommRingCat.hom_ofHom]
    exact IsLocalRing.PrimeSpectrum.comap_residue _ _

  have conj4 : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)),
      Limits.pullback.fst D.f a (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
        D.xs i (IsLocalRing.closedPoint F'') → z = xs := by
    intro z hz
    have h1 := s2 D.f a (D.xs i) _ x hz hx
      ((hv z).trans (by rw [← hxs]; exact (hv xs).symm))
    exact hiSinj (h1.trans hxs.symm)
  have hclosed : IsClosed ({xs} : Set ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A))) := by
    have hcl : IsClosed (Set.range (D.xs i)) := (D.xs i).isClosedEmbedding.isClosed_range
    have heq : ({xs} : Set ↥(Limits.pullback (C := Scheme.{u})
        (Limits.pullback.snd D.f a) (wcQmSp A))) =
        (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) ≫
          Limits.pullback.fst D.f a) ⁻¹' Set.range (D.xs i) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage, Set.mem_range, Scheme.Hom.comp_apply]
      constructor
      · rintro rfl
        exact ⟨IsLocalRing.closedPoint F'', by rw [hxs, hx]⟩
      · rintro ⟨p, hp⟩
        obtain rfl : p = IsLocalRing.closedPoint F'' := Subsingleton.elim _ _
        exact conj4 z hp.symm
    rw [heq]
    exact hcl.preimage (Scheme.Hom.continuous _)

  have gen : ∀ {T B : Scheme.{u}} (g : T ⟶ Spec (.of A)) (j : B ⟶ T)
      (σ : B ⟶ Spec (.of (IsLocalRing.ResidueField A))), j ≫ g = σ ≫ wcQmSp A → ∀ b : B,
      Function.Surjective (j.residueFieldMap b).hom →
      Function.Surjective (g.residueFieldMap (j b)).hom →
      Function.Surjective (σ.residueFieldMap b).hom := by
    intro T B g j σ hsq b hj hg
    have hcomp : Function.Surjective ((j ≫ g).residueFieldMap b).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hj.comp hg
    rw [Scheme.Hom.residueFieldMap_congr hsq b] at hcomp
    have hcomp' : Function.Surjective ((σ ≫ wcQmSp A).residueFieldMap b).hom := by
      have : Function.Surjective
          (⇑((σ ≫ wcQmSp A).residueFieldMap b).hom ∘ ⇑(Scheme.residueFieldCongr
            (congrArg (fun φ => φ b) hsq)).hom.hom) := hcomp
      exact Function.Surjective.of_comp this
    rw [Scheme.residueFieldMap_comp] at hcomp'
    have : Function.Surjective
        (⇑(σ.residueFieldMap b).hom ∘ ⇑((wcQmSp A).residueFieldMap (σ b)).hom) := hcomp'
    exact Function.Surjective.of_comp this
  have hx₂' : Limits.pullback.fst D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) xs) =
      D.xs i (IsLocalRing.closedPoint F'') := by rw [hxs]; exact hx
  have hg := s3 D.f a (D.xs i) _ hx₂'
  have hσ := gen (Limits.pullback.snd D.f a)
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))
    (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A))
    Limits.pullback.condition xs
    (s1 (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) xs) hg

  obtain ⟨-, -, -, -, -, e, -, -⟩ := hA
  haveI : Finite ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))) :=
    s4 F'' _ (D.S i)
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) := s5 _ _ e

  haveI : IsAlgClosed ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)).residueField xs) :=
    s6 (IsLocalRing.ResidueField A) (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A)) xs hσ

  have hbij : Function.Bijective (algebraMap ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)
      (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)
      (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))))) :=
    IsClosedImmersion.spec_of_surjective _ hbij.2
  haveI : IsClosedImmersion ((Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)).fromSpecResidueField xs) :=
    isClosed_singleton_iff_isClosedImmersion.mp hclosed
  unfold wcEtGeomPt
  infer_instance

theorem wc_et_pull_data_stalk_iso {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ) (D : wcEtPullData g n)
    (N : SheafOfModules.{u+1} (wcEtZModRing S n)) (s' : S') :
    Nonempty ((wcEtStalk S' s').obj ((SheafOfModules.toSheaf (wcEtZModRing S' n)).obj (D.Φ.obj N)) ≅
      (wcEtStalk S (g s')).obj ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj N)) :=
by
  letI := D.cont
  obtain ⟨α⟩ := wc_et_pull_data_toSheaf_iso D
  obtain ⟨adjQ⟩ := wc_qm_inv_push_adj g
  obtain ⟨γ⟩ := wc_qm_inv_stalk g s'
  let e : wcEtPush g ≅ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S') :=
    Functor.isoWhiskerRight ((wcEtBaseChange g).sheafPushforwardContinuousCompSheafToPresheafIso
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).symm
      (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  have adjL : (wcEtBaseChange g).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') ⊣ wcEtPush g :=
    (Functor.sheafAdjunctionContinuous (wcEtBaseChange g) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).ofNatIsoRight e.symm
  have β := adjL.leftAdjointUniq adjQ
  exact ⟨(wcEtStalk S' s').mapIso (α.app N ≪≫ β.app ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj N)) ≪≫
    γ.app ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj N)⟩

theorem wc_et_tpl_rtp_off_node_stalk_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A))) (hz : z ≠ xs)
    (q : ℕ) (hq : 1 ≤ q) :
    haveI := Dh.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    Subsingleton ((wcEtStalk (Limits.pullback D.f a)
        (Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) z)).obj
      ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))).obj
        (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) :=
by
  intro P
  classical
  haveI := Dh.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])

  obtain ⟨l⟩ : Nonempty Λ := by
    first
    | exact inferInstance
    | exact IsCofiltered.nonempty
  have ha : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    have h1 := wc_shdata_closed_point_compat _ A Λ W' φ a hA l
    have h2 : (W'.obj l).hom.left ≫ (W'.obj l).right.hom =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) := Over.w (W'.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint A)) (hA.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W'.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure ((wcP1Over F'').left.residueField
            (D.S i (IsLocalRing.closedPoint F'')))))) h2).trans (hγ _ _ _)))))

  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ : ℕ) : F'')) := isUnit_iff_ne_zero.mpr hℓK
  have hunitℓ : IsUnit (((ℓ : ℕ) : A)) := by
    have h1 := hunitK.map (Spec.preimage (a ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at h1
  have hunit : IsUnit (((ℓ ^ k : ℕ) : A)) := by
    rw [Nat.cast_pow]
    exact hunitℓ.pow k

  have hzA : ∀ z', Limits.pullback.snd D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z') = IsLocalRing.closedPoint A := by
    intro z'
    have e1 := congrArg (fun g => g z')
      (Limits.pullback.condition (f := Limits.pullback.snd D.f a) (g := wcQmSp A))
    refine ((comp_ap _ _ _).symm.trans e1).trans ?_
    refine (comp_ap _ _ _).trans ?_
    have hu : Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A) z' =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
      @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField A)) _ _ _
    rw [hu]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
  have hz' := hzA z

  have s2 : ∀ {Y V P : Scheme.{u}} {K : Type u} [Field K] (f : Y ⟶ P) (g : V ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w w' : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g w = s (IsLocalRing.closedPoint K) →
      Limits.pullback.fst f g w' = s (IsLocalRing.closedPoint K) →
      Limits.pullback.snd f g w = Limits.pullback.snd f g w' → w = w' := by
    intro Y V P K _ f g s _ w w' hw hw' h
    obtain ⟨q, -, hq2⟩ := Scheme.Pullback.exists_preimage_pullback _ w hw.symm
    obtain ⟨q', -, hq2'⟩ := Scheme.Pullback.exists_preimage_pullback _ w' hw'.symm
    have hE := Limits.pullbackRightPullbackFstIso_hom_snd f g s
    have hj : Function.Injective (Limits.pullback.snd (s ≫ f) g) :=
      (Limits.pullback.snd (s ≫ f) g).isClosedEmbedding.isEmbedding.injective
    have e1 : ∀ r, Limits.pullback.snd (s ≫ f) g ((Limits.pullbackRightPullbackFstIso f g s).hom r)
        = Limits.pullback.snd f g (Limits.pullback.snd s (Limits.pullback.fst f g) r) := by
      intro r
      rw [← Scheme.Hom.comp_apply, hE, Scheme.Hom.comp_apply]
    have h4 : (Limits.pullbackRightPullbackFstIso f g s).hom q =
        (Limits.pullbackRightPullbackFstIso f g s).hom q' := hj (by rw [e1, e1, hq2, hq2', h])
    have hqq : q = q' := by
      have := congrArg (Limits.pullbackRightPullbackFstIso f g s).inv h4
      rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at this
    rw [← hq2, ← hq2', hqq]

  haveI hS : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  haveI hsf : IsClosedImmersion (D.xs i ≫ D.f) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.xs i ≫ D.f) (by rw [D.hxs i, D.hS i])
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hiSinj : Function.Injective
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) :=
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)).isClosedEmbedding.isEmbedding.injective

  have hnode : Limits.pullback.fst D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) ≠
      D.xs i (IsLocalRing.closedPoint F'') := by
    intro hn0
    have h1 := s2 D.f a (D.xs i) _ x hn0 hx
      (hz'.trans (by rw [← hxs]; exact (hzA xs).symm))
    exact hz (hiSinj (h1.trans hxs.symm))

  have hfy : D.f (Limits.pullback.fst D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z)) =
      D.S i (IsLocalRing.closedPoint F'') := by
    have e1 := congrArg (fun g => g (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z))
      (Limits.pullback.condition (f := D.f) (g := a))
    exact ((comp_ap _ _ _).symm.trans e1).trans ((comp_ap _ _ _).trans ((congrArg a hz').trans ha))

  have hc : ∀ j, Limits.pullback.fst D.f a
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) ≠
      D.xs j (IsLocalRing.closedPoint F'') := by
    intro j hj
    apply hnode
    have hSj : D.f (D.xs j (IsLocalRing.closedPoint F'')) = D.S j (IsLocalRing.closedPoint F'') :=
      (comp_ap (D.xs j) D.f _).symm.trans (congrArg (fun g => g (IsLocalRing.closedPoint F''))
        (D.hxs j))
    have hj' : D.S j (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
      rw [← hfy, hj, hSj]
    have hji : j = i := D.hSinj hj'
    rw [hj, hji]

  obtain ⟨U, hyU, hsm⟩ := D.smooth_off _ hc
  have hpb : IsPullback (Limits.pullback.fst D.f a ∣_ U)
      ((Limits.pullback.fst D.f a ⁻¹ᵁ U).ι ≫ Limits.pullback.snd D.f a) (U.ι ≫ D.f) a :=
    (isPullback_morphismRestrict (Limits.pullback.fst D.f a) U).paste_vert
      (IsPullback.of_hasPullback D.f a)
  have hsm' : Smooth ((Limits.pullback.fst D.f a ⁻¹ᵁ U).ι ≫ Limits.pullback.snd D.f a) :=
    MorphismProperty.of_isPullback (P := @Smooth) hpb hsm

  refine wc_et_module_push_stalk_vanish_of_milnor_deg A (Limits.pullback D.f a)
    (Limits.pullback.snd D.f a) (ℓ ^ k) hm _ ξ Dh I _ q ?_
  intro B _ _ _ Λ' _ _ W'' φ' a' hsh
  exact (wc_smooth_open_shens_milnor_fibre_acyclic A _ (Limits.pullback.snd D.f a) _ hsm' (ℓ ^ k)
    hunit _ hyU hz' B Λ' W'' φ' a' hsh _ ξ).2 q hq

theorem wc_et_tpl_rtp_node_stalk_zmod (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
