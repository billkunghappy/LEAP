    have hfib : ∀ (ζ₁ : ↥(Limits.pullback x.left w.left)) (y : X.left),
        ∃ ζ : ↥(Limits.pullback x.left w.left), Limits.pullback.fst x.left w.left ζ = y ∧
          ∀ K : Set ↥(Limits.pullback x.left w.left), IsClopen K → ζ₁ ∈ K → ζ ∈ K := by
      intro ζ₁ y
      have hcpt := Scheme.Hom.isCompact_preimage_singleton (Limits.pullback.fst x.left w.left) y
      obtain ⟨ζ, hζs, hζK⟩ := hcpt.inter_iInter_nonempty
        (fun K : {K : Set ↥(Limits.pullback x.left w.left) // IsClopen K ∧ ζ₁ ∈ K} => K.1)
        (fun K => K.2.1.isClosed) (by
          intro u
          have hC : IsClopen (⋂ K ∈ u,
              (K : {K : Set ↥(Limits.pullback x.left w.left) // IsClopen K ∧ ζ₁ ∈ K}).1) :=
            isClopen_biInter_finset fun K _ => K.2.1
          have hζ₁ : ζ₁ ∈ ⋂ K ∈ u,
              (K : {K : Set ↥(Limits.pullback x.left w.left) // IsClopen K ∧ ζ₁ ∈ K}).1 :=
            Set.mem_iInter₂.mpr fun K _ => K.2.2
