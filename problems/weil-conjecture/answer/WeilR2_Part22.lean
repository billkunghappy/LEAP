  have hpt : ((v₀ ≫ ψ) ≫ e) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback
      (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))) =
      e ((v₀ ≫ ψ) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback
      (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)))) := comp_ap _ _ _
  have hVh : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) 2 0
      (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then
