        have := h2 j
        rw [Fin.sum_univ_one] at this
        rw [← mul_assoc, this, zero_mul]
      refine ⟨1 - w, ?_, ?_⟩
      · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
      · rw [mul_sub, mul_one, hxw, sub_zero]
    have s4 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
        Algebra.WeaklyEtale A B → ∀ b : B, ∃ w : TensorProduct A B B,
          Algebra.TensorProduct.lmul' A (S := B) w = 0 ∧
          (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) * w = b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b := by
      intro A B _ _ _ hW b
      have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' A (S := B)) := fun b =>
        ⟨b ⊗ₜ[A] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
      have hflatQ : Module.Flat (TensorProduct A B B)
          (TensorProduct A B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
        let e := RingHom.quotientKerEquivOfSurjective
          (f := (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) hμsurj
        have h1 : ((Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat := hW.flat_lmul'
        have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat :=
          RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
        have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom =
            algebraMap _ (TensorProduct A B B ⧸
              RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
          refine RingHom.ext fun t => ?_
          rw [Ideal.Quotient.algebraMap_eq]
          show e.symm (Algebra.TensorProduct.lmul' A (S := B) t) = Ideal.Quotient.mk _ t
          rw [e.symm_apply_eq]
          rfl
        rw [h3, RingHom.flat_algebraMap_iff] at h2
        exact h2
      obtain ⟨z, hz, hxz⟩ := habsorb _ _ hflatQ
        (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) (by
          rw [RingHom.mem_ker]
          show Algebra.TensorProduct.lmul' A (S := B) (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) = 0
          rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
            Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self])
      exact ⟨z, RingHom.mem_ker.mp hz, hxz⟩
    intro A B K _ _ _ _ hW φ b
    by_contra hno
    let k := Subfield.closure (Set.range (φ.comp (algebraMap A B)))
    have htr : Transcendental k (φ b) := fun halg => hno (s2 A K _ (φ b) halg)
    obtain ⟨Θ, hΘl, hΘr, hΘμ⟩ := s3 A B k K φ
      (fun a => ⟨⟨φ (algebraMap A B a), Subfield.subset_closure ⟨a, rfl⟩⟩, rfl⟩)
    obtain ⟨w, hw0, hw⟩ := s4 A B hW b
    have hδ : (φ b ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] φ b) * (Θ w - 1) = 0 := by
      have h := congrArg Θ hw
      rw [map_mul, map_sub, hΘl, hΘr] at h
      rw [mul_sub, mul_one, h, sub_self]
    have h1 : Θ w - 1 = 0 := s1 k K (φ b) htr _ hδ
    have h2 : Θ w = 1 := sub_eq_zero.mp h1
    have h3 := hΘμ w
    rw [h2, map_one, hw0, map_zero] at h3
    exact one_ne_zero h3
  intro A _ _ K E _ _ _ _ _ _ _ _ _ B _ _ _ _ hwe L' _ β κ hcompat hfrac
  classical

  have hAE : Function.Injective (algebraMap A E) := by
    rw [IsScalarTower.algebraMap_eq A K E]
    exact (algebraMap K E).injective.comp (IsFractionRing.injective A K)
  have hBF : Function.Injective (algebraMap B (FractionRing B)) := IsFractionRing.injective B _

  have hdiv : ∀ b : B, b ≠ 0 → ∃ (b' : B) (a : A), algebraMap A B a ≠ 0 ∧
      b * b' = algebraMap A B a := by
    intro b hb
    obtain ⟨f, hf1, hf2⟩ := hpt A B (FractionRing B) hwe
      (algebraMap B (FractionRing B)) b
    have hmap : f.map ((algebraMap B (FractionRing B)).comp (algebraMap A B)) =
        (f.map (algebraMap A B)).map (algebraMap B (FractionRing B)) := (Polynomial.map_map _ _ f).symm
    have hf1' : f.map (algebraMap A B) ≠ 0 := by
      intro h; apply hf1; rw [hmap, h, Polynomial.map_zero]
    have hf2' : (f.map (algebraMap A B)).eval b = 0 := by
      apply hBF
      rw [map_zero, ← hf2, Polynomial.eval_map, Polynomial.hom_eval₂]
    obtain ⟨q, hq, hndvd⟩ :=
      Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd (f.map (algebraMap A B)) hf1' 0
    generalize (f.map (algebraMap A B)).rootMultiplicity 0 = m at hq
    rw [map_zero, sub_zero] at hq hndvd
    have hq0 : q.coeff 0 ≠ 0 := fun h => hndvd (Polynomial.X_dvd_iff.mpr h)
    have hqb : q.eval b = 0 := by
      have h := hf2'
      rw [hq, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X] at h
      exact (mul_eq_zero.mp h).resolve_left (pow_ne_zero _ hb)
    have hqdecomp : q.coeff 0 = b * (-(q.divX.eval b)) := by
      have h := congrArg (Polynomial.eval b) (Polynomial.divX_mul_X_add q)
      rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C, hqb] at h
      linear_combination h
    have hcoeff : (f.map (algebraMap A B)).coeff m = q.coeff 0 := by
      rw [hq]; simpa using Polynomial.coeff_X_pow_mul q m 0
    refine ⟨-(q.divX.eval b), f.coeff m, ?_, ?_⟩
    · rw [← Polynomial.coeff_map, hcoeff]; exact hq0
    · rw [← Polynomial.coeff_map, hcoeff, hqdecomp]

  have hβ : Function.Injective β := by
    rw [injective_iff_map_eq_zero]
    intro b hb0
    by_contra hb
    obtain ⟨b', a, ha, hbb⟩ := hdiv b hb
    apply ha
    have h1 : κ (algebraMap A E a) = 0 := by
      have h := DFunLike.congr_fun hcompat a
      simp only [RingHom.comp_apply] at h
      rw [h, ← hbb, map_mul, hb0, zero_mul]
    have h2 : algebraMap A E a = 0 := by
      rw [← map_zero κ] at h1; exact κ.injective h1
    have h3 : a = 0 := by
      rw [← map_zero (algebraMap A E)] at h2; exact hAE h2
    rw [h3, map_zero]

  obtain ⟨τ, hτP⟩ : ∃ τ : E →+* FractionRing B, ∀ (x : E) (b₁ b₂ : B), κ x * β b₂ = β b₁ →
      τ x * algebraMap B (FractionRing B) b₂ = algebraMap B (FractionRing B) b₁ := by
    let βh : FractionRing B →+* L' := IsFractionRing.lift hβ
    have hβh : ∀ b, βh (algebraMap B (FractionRing B) b) = β b := IsFractionRing.lift_algebraMap hβ
    have hrange : ∀ x, κ x ∈ βh.range := by
      intro x
      obtain ⟨b₁, b₂, hb2, hx⟩ := hfrac x
      refine ⟨algebraMap B (FractionRing B) b₁ / algebraMap B (FractionRing B) b₂, ?_⟩
      rw [map_div₀, hβh, hβh, ← hx, mul_div_cancel_right₀ _ hb2]
    let e := RingEquiv.ofBijective βh.rangeRestrict
      ⟨fun x y h => βh.injective (congrArg Subtype.val h), βh.rangeRestrict_surjective⟩
    refine ⟨e.symm.toRingHom.comp (κ.codRestrict βh.range hrange), ?_⟩
    have hτ : ∀ x, βh ((e.symm.toRingHom.comp (κ.codRestrict βh.range hrange)) x) = κ x := by
      intro x
      have h := e.apply_symm_apply (κ.codRestrict βh.range hrange x)
      exact congrArg Subtype.val h
    intro x b₁ b₂ h
    apply βh.injective
    rw [map_mul, hτ, hβh, hβh, h]
  have hτA : ∀ a : A, τ (algebraMap A E a) = algebraMap B (FractionRing B) (algebraMap A B a) := by
    intro a
    have h := hτP (algebraMap A E a) (algebraMap A B a) 1
      (by rw [map_one, mul_one]; exact DFunLike.congr_fun hcompat a)
    rwa [map_one, mul_one] at h

  have hcard : Module.finrank K E = Fintype.card (E ≃ₐ[K] E) := by
    rw [← IsGalois.card_aut_eq_finrank K E, Nat.card_eq_fintype_card]
  let e : Module.Basis (E ≃ₐ[K] E) K E :=
    (Module.finBasisOfFinrankEq K E hcard).reindex (Fintype.equivFin _).symm

  have hMat : (∀ y : (E ≃ₐ[K] E) → FractionRing B,
      (∀ g : E ≃ₐ[K] E, ∑ i, τ (g (e i)) * y i = 0) → y = 0) ∧
      (∀ w : (E ≃ₐ[K] E) → FractionRing B, ∃ v : (E ≃ₐ[K] E) → FractionRing B,
        ∀ g : E ≃ₐ[K] E, ∑ i, τ (g (e i)) * v i = w g) := by
    let M : Matrix (E ≃ₐ[K] E) (E ≃ₐ[K] E) (FractionRing B) := Matrix.of fun g i => τ (g (e i))
    let σ : (E ≃ₐ[K] E) → (E →* FractionRing B) := fun g =>
      { toFun := fun x => τ (g x), map_one' := by simp, map_mul' := fun x y => by simp }
    have hσ : Function.Injective σ := by
      intro g h hgh
      ext x
      have := DFunLike.congr_fun hgh x
      exact τ.injective this
    have hli := (linearIndependent_monoidHom E (FractionRing B)).comp σ hσ
    have hvec : Function.Injective fun v => Matrix.vecMul v M := by
      intro c c' hcc
      have hsub : ∀ i, ∑ g, (c g - c' g) * τ (g (e i)) = 0 := by
        intro i
        have := congrFun hcc i
        simp only [Matrix.vecMul, dotProduct, M, Matrix.of_apply] at this
        simp only [sub_mul, Finset.sum_sub_distrib, this, sub_self]
      have hzero := Fintype.linearIndependent_iff.mp hli (fun g => c g - c' g) (by
        funext x
        have hx : ∀ g : E ≃ₐ[K] E, τ (g x) =
            ∑ i, τ (algebraMap K E (e.repr x i)) * τ (g (e i)) := by
          intro g
          conv_lhs => rw [← e.sum_repr x]
          rw [map_sum, map_sum]
          apply Finset.sum_congr rfl
          intro i _
          rw [map_smul, Algebra.smul_def, map_mul]
        have hs : (∑ g, (c g - c' g) * τ (g x)) =
            ∑ i, τ (algebraMap K E (e.repr x i)) * ∑ g, (c g - c' g) * τ (g (e i)) := by
          simp only [hx, Finset.mul_sum]
          rw [Finset.sum_comm]
          apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro g _; ring
        simp only [Finset.sum_apply, Pi.smul_apply, Function.comp_apply, smul_eq_mul,
          Pi.zero_apply]
        show ∑ g, (c g - c' g) * τ (g x) = 0
        rw [hs]
        simp [hsub])
      funext g
      exact sub_eq_zero.mp (hzero g)
    have hU : IsUnit M := Matrix.vecMul_injective_iff_isUnit.mp hvec
    refine ⟨fun y hy => ?_, fun w => ?_⟩
    · apply Matrix.mulVec_injective_iff_isUnit.mpr hU
      rw [Matrix.mulVec_zero]
      funext g
      simp only [Matrix.mulVec, dotProduct, M, Matrix.of_apply, Pi.zero_apply]
      exact hy g
    · obtain ⟨v, hv⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hU w
      refine ⟨v, fun g => ?_⟩
      rw [← hv]
      simp only [Matrix.mulVec, dotProduct, M, Matrix.of_apply]
  obtain ⟨hinjM, hsurjM⟩ := hMat

  have hτA' : ∀ a : A, τ (algebraMap A E a) = algebraMap A (FractionRing B) a := by
    intro a; rw [hτA, ← IsScalarTower.algebraMap_apply]
  let gmap : E →ₐ[A] ((E ≃ₐ[K] E) → FractionRing B) :=
    { toFun := fun x g => τ (g x)
      map_one' := by funext g; simp
      map_mul' := fun x y => by funext g; simp
      map_zero' := by funext g; simp
      map_add' := fun x y => by funext g; simp
      commutes' := fun a => by
        funext g
        simp only [Pi.algebraMap_apply]
        rw [IsScalarTower.algebraMap_apply A K E, AlgEquiv.commutes,
          ← IsScalarTower.algebraMap_apply, hτA'] }
  let Ψ : TensorProduct A B E →ₐ[B] ((E ≃ₐ[K] E) → FractionRing B) :=
    Algebra.TensorProduct.lift (Algebra.ofId B _) gmap (fun _ _ => Commute.all _ _)
  have hΨ : ∀ (b : B) (x : E) (g : E ≃ₐ[K] E),
      Ψ (b ⊗ₜ[A] x) g = algebraMap B (FractionRing B) b * τ (g x) := by
    intro b x g
    simp only [Ψ, Algebra.TensorProduct.lift_tmul, Pi.mul_apply, Algebra.ofId_apply,
      Pi.algebraMap_apply]
    rfl

  have hnf : ∀ z : TensorProduct A B E, ∃ a : A, a ≠ 0 ∧
      ∃ y : (E ≃ₐ[K] E) → B, a • z = ∑ i, y i ⊗ₜ[A] e i := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
    | tmul b x =>
      obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A) Finset.univ
        (e.repr x)
      choose c hc using fun i => hd i (Finset.mem_univ i)
      have hc' : ∀ i, algebraMap A K (c i) = (d : A) • e.repr x i := fun i => hc i
      refine ⟨(d : A), nonZeroDivisors.ne_zero d.2, fun i => c i • b, ?_⟩
      have hx : (d : A) • x = ∑ i, c i • e i := by
        conv_lhs => rw [← e.sum_repr x]
        rw [Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [← smul_assoc, ← hc' i, algebraMap_smul]
      rw [← TensorProduct.tmul_smul, hx, TensorProduct.tmul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [TensorProduct.smul_tmul]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨a₁, ha₁, y₁, hy₁⟩ := h₁
      obtain ⟨a₂, ha₂, y₂, hy₂⟩ := h₂
      refine ⟨a₁ * a₂, mul_ne_zero ha₁ ha₂, fun i => a₂ • y₁ i + a₁ • y₂ i, ?_⟩
      have e1 : (a₁ * a₂) • z₁ = a₂ • (a₁ • z₁) := by rw [mul_comm, mul_smul]
      have e2 : (a₁ * a₂) • z₂ = a₁ • (a₂ • z₂) := by rw [mul_smul]
      rw [smul_add, e1, e2, hy₁, hy₂, Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _
      rw [TensorProduct.add_tmul, TensorProduct.smul_tmul', TensorProduct.smul_tmul']

  have hΨinj : Function.Injective Ψ := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨a, ha, y, hy⟩ := hnf z
    have h1 : Ψ (a • z) = 0 := by
      rw [← algebraMap_smul B a z, map_smul, hz, smul_zero]
    rw [hy] at h1
    have hy0 : y = 0 := by
      have h2 : ∀ g : E ≃ₐ[K] E, ∑ i, τ (g (e i)) * algebraMap B (FractionRing B) (y i) = 0 := by
        intro g
        have h3 := congrFun h1 g
        rw [map_sum, Finset.sum_apply] at h3
        simp only [hΨ, Pi.zero_apply] at h3
        rw [← h3]
        apply Finset.sum_congr rfl
        intro i _
        ring
      have h4 := hinjM (fun i => algebraMap B (FractionRing B) (y i)) h2
      funext i
      exact hBF (by simpa using congrFun h4 i)
    rw [hy0] at hy
    simp only [Pi.zero_apply, TensorProduct.zero_tmul, Finset.sum_const_zero] at hy
    have hu : algebraMap A E a ≠ 0 := (map_ne_zero_iff _ hAE).mpr ha
    have h5 : (1 ⊗ₜ[A] algebraMap A E a : TensorProduct A B E) * z = 0 := by
      rw [← hy, Algebra.smul_def, Algebra.TensorProduct.algebraMap_apply']
    calc z = (1 ⊗ₜ[A] (algebraMap A E a)⁻¹ : TensorProduct A B E) *
          ((1 ⊗ₜ[A] algebraMap A E a) * z) := by
          rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, one_mul, inv_mul_cancel₀ hu,
            ← Algebra.TensorProduct.one_def, one_mul]
      _ = 0 := by rw [h5, mul_zero]

  have hhits : ∀ w : (E ≃ₐ[K] E) → B, ∃ z : TensorProduct A B E,
      Ψ z = fun g => algebraMap B (FractionRing B) (w g) := by
    intro w
    obtain ⟨v, hv⟩ := hsurjM (fun g => algebraMap B (FractionRing B) (w g))
    obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors B) Finset.univ v
    choose c hc using fun i => hd i (Finset.mem_univ i)
    simp only [Algebra.smul_def] at hc
    have hd0 : (d : B) ≠ 0 := nonZeroDivisors.ne_zero d.2
    obtain ⟨d', a, ha, hdd⟩ := hdiv d hd0
    have hτu0 : τ (algebraMap A E a) ≠ 0 := by
      rw [hτA]; exact (map_ne_zero_iff _ hBF).mpr ha
    have hgu : ∀ g : E ≃ₐ[K] E, g (algebraMap A E a) = algebraMap A E a := by
      intro g; rw [IsScalarTower.algebraMap_apply A K E]; exact g.commutes _
    have hdd' : algebraMap B (FractionRing B) d * algebraMap B (FractionRing B) d' =
        τ (algebraMap A E a) := by
      rw [← map_mul, hdd, hτA]
    refine ⟨∑ i, (c i * d') ⊗ₜ[A] ((algebraMap A E a)⁻¹ * e i), ?_⟩
    funext g
    rw [map_sum, Finset.sum_apply]
    simp only [hΨ]
    rw [← hv g]
    apply Finset.sum_congr rfl
    intro i _
    rw [show g ((algebraMap A E a)⁻¹ * e i) = (algebraMap A E a)⁻¹ * g (e i) by
        rw [map_mul, map_inv₀, hgu],
      map_mul τ, map_inv₀ τ, map_mul (algebraMap B (FractionRing B)), hc i]
    calc algebraMap B (FractionRing B) d * v i * algebraMap B (FractionRing B) d' *
          ((τ (algebraMap A E a))⁻¹ * τ (g (e i)))
        = (algebraMap B (FractionRing B) d * algebraMap B (FractionRing B) d') *
          (τ (algebraMap A E a))⁻¹ * (v i * τ (g (e i))) := by ring
      _ = τ (algebraMap A E a) * (τ (algebraMap A E a))⁻¹ * (v i * τ (g (e i))) := by rw [hdd']
      _ = τ (g (e i)) * v i := by rw [mul_inv_cancel₀ hτu0, one_mul, mul_comm]

  let ι : ((E ≃ₐ[K] E) → B) →ₐ[B] ((E ≃ₐ[K] E) → FractionRing B) :=
    AlgHom.compLeft (Algebra.ofId B (FractionRing B)) _
  have hι : Function.Injective ι := by
    intro v w h; funext g; exact hBF (congrFun h g)
  have hclaim : Subalgebra.map Ψ (integralClosure B (TensorProduct A B E)) = ι.range := by
    ext f
    simp only [Subalgebra.mem_map, AlgHom.mem_range, mem_integralClosure_iff]
    constructor
    · rintro ⟨z, hz, rfl⟩
      have hzi : _root_.IsIntegral B (Ψ z) := hz.map Ψ
      have : ∀ g, ∃ y : B, algebraMap B (FractionRing B) y = Ψ z g := fun g =>
        IsIntegrallyClosed.isIntegral_iff.mp (hzi.map (Pi.evalAlgHom B (fun _ => FractionRing B) g))
      choose w hw using this
      exact ⟨w, funext fun g => hw g⟩
    · rintro ⟨w, rfl⟩
      obtain ⟨z, hz⟩ := hhits w
      have hz' : Ψ z = ι w := hz
      refine ⟨z, ?_, hz'⟩
      have : _root_.IsIntegral B (ι w) := (Algebra.IsIntegral.isIntegral w).map ι
      rw [← hz'] at this
      exact (isIntegral_algHom_iff Ψ hΨinj).mp this
  have e1 := (Subalgebra.equivMapOfInjective _ Ψ hΨinj).trans
    ((Subalgebra.equivOfEq _ _ hclaim).trans (AlgEquiv.ofInjective ι hι).symm)
  exact Algebra.Etale.of_equiv e1.symm

theorem wc_tpa_gp_integralClosure_away : ∀ (A C : Type u) [CommRing A] [CommRing C] [IsDomain C] [IsIntegrallyClosed C] [Algebra A C] [Algebra.IsIntegral A C] (t : A), algebraMap A C t ≠ 0 → Nonempty (integralClosure A (Localization ((Submonoid.powers t).map (algebraMap A C))) ≃ₐ[A] C) :=
by
  intro A C _ _ _ _ _ _ t ht
  have hM : (Submonoid.powers t).map (algebraMap A C) ≤ nonZeroDivisors C := by
    intro y hy
    obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hy
    obtain ⟨n, rfl⟩ := ha
    rw [map_pow]
    exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n ht)
  have hinj : Function.Injective
      (algebraMap C (Localization ((Submonoid.powers t).map (algebraMap A C)))) :=
    IsLocalization.injective (Localization ((Submonoid.powers t).map (algebraMap A C))) hM
  have hg : ∀ y : (Submonoid.powers t).map (algebraMap A C),
      IsUnit (algebraMap C (FractionRing C) y) := fun y =>
    IsLocalization.map_units (FractionRing C) (⟨y, hM y.2⟩ : nonZeroDivisors C)
  let φ : Localization ((Submonoid.powers t).map (algebraMap A C)) →+* FractionRing C :=
    IsLocalization.lift hg
  have hφ : ∀ c : C, φ (algebraMap C _ c) = algebraMap C (FractionRing C) c :=
    fun c => IsLocalization.lift_eq hg c
  have hφinj : Function.Injective φ := by
    apply (IsLocalization.lift_injective_iff hg).mpr
    intro x y
    rw [hinj.eq_iff, (IsFractionRing.injective C (FractionRing C)).eq_iff]
  haveI : IsIntegralClosure C A (Localization ((Submonoid.powers t).map (algebraMap A C))) := by
    refine ⟨hinj, fun {x} => ⟨fun hx => ?_, ?_⟩⟩
    · have hxC : IsIntegral C x := hx.tower_top
      have h1 : IsIntegral C (φ x) := by
        refine hxC.map_of_comp_eq (RingHom.id C) φ ?_
        rw [RingHom.comp_id]
        exact (IsLocalization.lift_comp hg).symm
      obtain ⟨c, hc⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral h1
      exact ⟨c, hφinj (by rw [hφ, hc])⟩
    · rintro ⟨y, rfl⟩
      exact (Algebra.IsIntegral.isIntegral (R := A) y).algebraMap
  exact ⟨IsIntegralClosure.equiv A
    (integralClosure A (Localization ((Submonoid.powers t).map (algebraMap A C))))
    (Localization ((Submonoid.powers t).map (algebraMap A C))) C⟩

theorem wc_tpa_galois_purity : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], IsRegularLocalRing A → ∀ (t : A), t ∈ IsLocalRing.maximalIdeal A → t ∉ IsLocalRing.maximalIdeal A ^ 2 → (Ideal.span {t}).IsPrime → ∀ (L : Type u) [Field L] [IsSepClosed L] (ψ : A →+* L), Function.Injective ψ → IsGalois (Subfield.closure (Set.range ψ)) L → ∀ (E : IntermediateField (Subfield.closure (Set.range ψ)) L), FiniteDimensional (Subfield.closure (Set.range ψ)) E → IsGalois (Subfield.closure (Set.range ψ)) E → (∀ (𝔮 : Ideal A) [𝔮.IsPrime], t ∉ 𝔮 → ∃ (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B) (_ : IsSepClosed (IsLocalRing.ResidueField B)) (α : A →+* B) (β : B →+* L), @Algebra.WeaklyEtale A B _ _ α.toAlgebra ∧ (IsLocalRing.maximalIdeal B).comap α = 𝔮 ∧ β.comp α = ψ ∧ ∀ g : L ≃ₐ[Subfield.closure (Set.range ψ)] L, (∀ b : B, g (β b) = β b) → ∀ x ∈ E, g x = x) → (∃ (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B) (_ : IsSepClosed (IsLocalRing.ResidueField B)) (α : A →+* B) (β : B →+* L), @Algebra.WeaklyEtale A B _ _ α.toAlgebra ∧ (IsLocalRing.maximalIdeal B).comap α = Ideal.span {t} ∧ β.comp α = ψ ∧ ∀ g : L ≃ₐ[Subfield.closure (Set.range ψ)] L, (∀ b : B, g (β b) = β b) → ∀ x ∈ E, g x = x) → E = ⊥ :=
by
  intro A _ _ _ _ _ hreg t htm htm2 htp L _ _ ψ hψ hgal E hEf hEg H1 H2
  classical
  haveI := hreg
  haveI := htp
  haveI := hgal
  haveI := hEf
  haveI := hEg
  obtain ⟨_, hufd⟩ := wc_fco_regular_local_ufd A
  haveI : IsIntegrallyClosed A := UniqueFactorizationMonoid.instIsIntegrallyClosed

  have key : ∀ (C : Type u) [CommRing C] [IsDomain C] [IsIntegrallyClosed C] [Algebra A C]
      [Module.Finite A C], Function.Injective (algebraMap A C) →
      wcCg2LocEtale (algebraMap A C) (Submonoid.powers t) →
      wcCg2LocEtale (algebraMap A C) (Ideal.span {t}).primeCompl →
      Function.Surjective (algebraMap A C) := by
    intro C _ _ _ _ _ hACinj hoff hat
    let M : Submonoid C := (Submonoid.powers t).map (algebraMap A C)
    let f : Localization.Away t →+* Localization M :=
      IsLocalization.map (M := Submonoid.powers t) (Localization M) (algebraMap A C)
        (Submonoid.le_comap_map (Submonoid.powers t))
    letI : Algebra (Localization.Away t) (Localization M) := f.toAlgebra
    haveI : Algebra.Etale (Localization.Away t) (Localization M) := hoff
    haveI : IsScalarTower A (Localization.Away t) (Localization M) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq A C (Localization M)]
      exact (IsLocalization.map_comp (Submonoid.le_comap_map _)).symm
    haveI : IsLocalization (Algebra.algebraMapSubmonoid C (Submonoid.powers t))
        (Localization M) := Localization.isLocalization
    haveI : Module.Finite (Localization.Away t) (Localization M) :=
      Module.Finite.of_isLocalization A C (Submonoid.powers t)
    haveI : Algebra.IsIntegral A C := Algebra.IsIntegral.of_finite A C
    have htC : algebraMap A C t ≠ 0 := by
      intro h
      apply htm2
      have h0 : t = 0 := hACinj (by rw [h, map_zero])
      rw [h0]
      exact zero_mem _

    obtain ⟨j⟩ := wc_tpa_gp_integralClosure_away A C t htC

    have hD5 : Algebra.Etale (Localization.AtPrime (Ideal.span {t}))
        (TensorProduct A (Localization.AtPrime (Ideal.span {t}))
          (integralClosure A (Localization M))) :=
      wc_cfp_locEtale_tensor_transport A A (integralClosure A (Localization M)) C
        ((Algebra.TensorProduct.lid A (integralClosure A (Localization M))).trans j)
        (Ideal.span {t}) hat

    obtain ⟨hRet, hRfin⟩ := wc_pas_purity_integralClosure A t t 1 one_pos (pow_one t).symm htm
      htm2 (Localization M) hD5

    haveI := hRet
    haveI := hRfin
    haveI : IsDomain (integralClosure A (Localization M)) :=
      Function.Injective.isDomain (j : integralClosure A (Localization M) →+* C) j.injective
    obtain ⟨σ⟩ := wc_pas_strictHensel_etale_section A (integralClosure A (Localization M))
    haveI : Algebra.IsIntegral A (integralClosure A (Localization M)) :=
      Algebra.IsIntegral.of_finite A _
    have hker : RingHom.ker (σ : integralClosure A (Localization M) →+* A) = ⊥ := by
      apply Ideal.eq_bot_of_under_eq_bot (R := A)
      rw [eq_bot_iff]
      intro a ha
      rw [Ideal.mem_bot]
      have h1 : σ (algebraMap A _ a) = 0 := ha
      rw [AlgHom.commutes] at h1
      exact h1
    have hσinj : Function.Injective σ :=
      (RingHom.injective_iff_ker_eq_bot (σ : integralClosure A (Localization M) →+* A)).mpr hker
    intro c
    refine ⟨σ (j.symm c), ?_⟩
    have h1 : algebraMap A _ (σ (j.symm c)) = j.symm c := by
      apply hσinj
      rw [AlgHom.commutes]
      rfl
    rw [← AlgEquiv.commutes j, h1, AlgEquiv.apply_symm_apply]

  let ψ₀ : A →+* Subfield.closure (Set.range ψ) :=
    ψ.codRestrict (Subfield.closure (Set.range ψ)) (fun a => Subfield.subset_closure ⟨a, rfl⟩)
  have hψ₀ : ∀ a, (ψ₀ a : L) = ψ a := fun a => rfl
  have hψ₀inj : Function.Injective ψ₀ := fun a b h => hψ (by rw [← hψ₀, ← hψ₀, h])
  letI : Algebra A (Subfield.closure (Set.range ψ)) := ψ₀.toAlgebra

  haveI hfrac : IsFractionRing A (Subfield.closure (Set.range ψ)) := by
    refine ⟨fun y => ?_, fun z => ?_, fun {x y} hxy => ?_⟩
    · exact isUnit_iff_ne_zero.mpr ((map_ne_zero_iff ψ₀ hψ₀inj).mpr (nonZeroDivisors.ne_zero y.2))
    · have hz : (z : L) ∈ Subfield.closure (Set.range ψ) := z.2
      rw [Subfield.mem_closure_iff] at hz
      obtain ⟨y, hy, w, hw, hyw⟩ := hz
      rw [← RingHom.coe_range, Subring.closure_eq] at hy hw
      obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hy
      obtain ⟨b, rfl⟩ := RingHom.mem_range.mp hw
      by_cases hb : b = 0
      · refine ⟨(0, 1), ?_⟩
        apply Subtype.ext
        show (z : L) * ψ ((1 : nonZeroDivisors A) : A) = ψ 0
        rw [map_zero, ← hyw, hb, map_zero, div_zero, zero_mul]
      · refine ⟨(a, ⟨b, mem_nonZeroDivisors_of_ne_zero hb⟩), ?_⟩
        apply Subtype.ext
        show (z : L) * ψ b = ψ a
        rw [← hyw, div_mul_cancel₀]
        exact (map_ne_zero_iff ψ hψ).mpr hb
    · exact ⟨1, by rw [hψ₀inj hxy]⟩
  letI : Algebra A E := ((algebraMap (Subfield.closure (Set.range ψ)) E).comp ψ₀).toAlgebra
  haveI : IsScalarTower A (Subfield.closure (Set.range ψ)) E :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.IsSeparable (Subfield.closure (Set.range ψ)) E := IsGalois.to_isSeparable
  haveI hCfin : Module.Finite A (integralClosure A E) :=
    IsIntegralClosure.finite A (Subfield.closure (Set.range ψ)) E (integralClosure A E)
  haveI hCic : IsIntegrallyClosed (integralClosure A E) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (Subfield.closure (Set.range ψ))
  have hAE : ∀ a, ((algebraMap A E a : E) : L) = ψ a := fun a => rfl
  have hAEinj : Function.Injective (algebraMap A E) := by
    intro a b h
    apply hψ
    rw [← hAE, ← hAE, h]
  have hACinj : Function.Injective (algebraMap A (integralClosure A E)) := by
    intro a b h
    apply hAEinj
    exact congrArg (fun c : integralClosure A E => (c : E)) h

  have hloc : ∀ (𝔮 : Ideal A) [𝔮.IsPrime] (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (α : A →+* B) (β : B →+* L),
      @Algebra.WeaklyEtale A B _ _ α.toAlgebra → (IsLocalRing.maximalIdeal B).comap α = 𝔮 →
      β.comp α = ψ →
      (∀ g : L ≃ₐ[Subfield.closure (Set.range ψ)] L, (∀ b : B, g (β b) = β b) → ∀ x ∈ E, g x = x) →
      wcCg2LocEtale (algebraMap A (integralClosure A E)) 𝔮.primeCompl := by
    intro 𝔮 _ B _ _ _ α β hwe hcomap hβα hin
    letI : Algebra A B := α.toAlgebra
    haveI : Algebra.WeaklyEtale A B := hwe
    have hβα' : ∀ a, β (α a) = ψ a := fun a => DFunLike.congr_fun hβα a

    have hG1 : ∀ x ∈ E, ∃ b₁ b₂ : B, β b₂ ≠ 0 ∧ x * β b₂ = β b₁ := by
      intro x hx
      have hle : Subfield.closure (Set.range ψ) ≤ Subfield.closure (Set.range β) := by
        rw [Subfield.closure_le]
        rintro _ ⟨a, rfl⟩
        exact Subfield.subset_closure ⟨α a, hβα' a⟩
      let F : IntermediateField (Subfield.closure (Set.range ψ)) L :=
        Subfield.toIntermediateField (Subfield.closure (Set.range β)) (fun y => hle y.2)
      have hxF : x ∈ F := by
        rw [← InfiniteGalois.fixedField_fixingSubgroup F, IntermediateField.mem_fixedField_iff]
        intro g hg
        rw [IntermediateField.mem_fixingSubgroup_iff] at hg
        exact hin g (fun b => hg (β b) (Subfield.subset_closure ⟨b, rfl⟩)) x hx
      have hx' : x ∈ Subfield.closure (Set.range β) := hxF
      rw [Subfield.mem_closure_iff, ← RingHom.coe_range, Subring.closure_eq] at hx'
      obtain ⟨y, hy, w, hw, hyw⟩ := hx'
      obtain ⟨b₁, rfl⟩ := RingHom.mem_range.mp hy
      obtain ⟨b₂, rfl⟩ := RingHom.mem_range.mp hw
      by_cases hb : β b₂ = 0
      · refine ⟨0, 1, by rw [map_one]; exact one_ne_zero, ?_⟩
        rw [← hyw, hb, div_zero, zero_mul, map_zero]
      · exact ⟨b₁, b₂, hb, by rw [← hyw, div_mul_cancel₀ _ hb]⟩

    have hN1b := wc_tpa_gp_weaklyEtale_strict_indEtale A B inferInstance hwe
    obtain ⟨hBdom, hBic⟩ := wc_tpa_gp_indEtale_local_normal A B (algebraMap A B) hN1b
    haveI := hBdom
    haveI := hBic

    haveI hN2 := wc_tpa_gp_tensor_split_etale A (Subfield.closure (Set.range ψ)) E B hwe L β
      E.val.toRingHom (RingHom.ext fun a => (hβα' a).symm) (fun x => hG1 x.1 x.2)

    obtain ⟨e, -⟩ := wc_pub_integralClosure_indEtale_baseChange A B E hN1b
    haveI : Algebra.Etale B (TensorProduct A B (integralClosure A E)) := Algebra.Etale.of_equiv e.symm
    haveI : Module.Flat A B := Algebra.WeaklyEtale.flat

    exact wc_cg2_etale_descent A (integralClosure A E) B 𝔮 (IsLocalRing.maximalIdeal B) hcomap
      inferInstance

  have hoff : wcCg2LocEtale (algebraMap A (integralClosure A E)) (Submonoid.powers t) := by
    apply wc_cg2_locEtale_away
    intro Q _ hQ
    obtain ⟨B, _, _, _, α, β, h1, h2, h3, h4⟩ := H1 Q hQ
    exact hloc Q B α β h1 h2 h3 h4
  have hat : wcCg2LocEtale (algebraMap A (integralClosure A E)) (Ideal.span {t}).primeCompl := by
    obtain ⟨B, _, _, _, α, β, h1, h2, h3, h4⟩ := H2
    exact hloc _ B α β h1 h2 h3 h4
  have hsurj : Function.Surjective (algebraMap A (integralClosure A E)) :=
    key (integralClosure A E) hACinj hoff hat

  rw [eq_bot_iff]
  intro x hx
  rw [IntermediateField.mem_bot]
  let y : E := ⟨x, hx⟩
  have hyalg : IsAlgebraic A y := by
    rw [IsFractionRing.isAlgebraic_iff A (Subfield.closure (Set.range ψ)) E]
    exact Algebra.IsAlgebraic.isAlgebraic y
  obtain ⟨a, ha0, hai⟩ := hyalg.exists_integral_multiple
  obtain ⟨b, hb⟩ := hsurj ⟨a • y, hai⟩
  have hb' : algebraMap A E b = a • y := congrArg Subtype.val hb
  have hbL : ψ b = ψ a * x := by
    have h2 := congrArg (fun z : E => (z : L)) hb'
    rw [Algebra.smul_def] at h2
    exact h2
  have ha' : ψ a ≠ 0 := (map_ne_zero_iff ψ hψ).mpr ha0
  refine ⟨ψ₀ b / ψ₀ a, ?_⟩
  show ((ψ₀ b / ψ₀ a : Subfield.closure (Set.range ψ)) : L) = x
  rw [Subfield.coe_div, hψ₀, hψ₀, hbL]
  field_simp

theorem wc_tps_tame_purity_algebraic (L : Type u) [Field L] [IsSepClosed L]
    (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (hreg : IsRegularLocalRing A)
    (p Q : ℕ) (hp : p.Prime) (hpA : (p : A) = 0) (hQ : ∃ r : ℕ, 0 < r ∧ Q = p ^ r)
    (ψ : A →+* L) (hψ : Function.Injective ψ)
    (hgal : IsGalois (Subfield.closure (Set.range ψ)) L)
    (f : A) (hfm : f ∈ IsLocalRing.maximalIdeal A) (hfm2 : f ∉ IsLocalRing.maximalIdeal A ^ 2)
    (hdomf : IsDomain (A ⧸ Ideal.span {f})) (hregf : IsRegularLocalRing (A ⧸ Ideal.span {f}))
    (A' : Type u) [CommRing A'] [IsDomain A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] (hdvr : IsDiscreteValuationRing A')
    (α' : A →+* A') (hα' : @Algebra.WeaklyEtale A A' _ _ α'.toAlgebra)
    (hspan : Ideal.span {α' f} = IsLocalRing.maximalIdeal A')
    (hcomap : (IsLocalRing.maximalIdeal A').comap α' = Ideal.span {f})
    (ψ' : A' →+* L) (hψ' : Function.Injective ψ') (hcomp : ψ'.comp α' = ψ)
    (K₂ : IntermediateField (Subfield.closure (Set.range ψ)) L)
    (hK₂f : FiniteDimensional (Subfield.closure (Set.range ψ)) K₂)
    (hK₂g : IsGalois (Subfield.closure (Set.range ψ)) K₂)
    (hin : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (α : A →+* B) (β : B →+* L),
      @Algebra.WeaklyEtale A B _ _ α.toAlgebra → α f ∉ IsLocalRing.maximalIdeal B →
      β.comp α = ψ →
      ∀ g : L ≃ₐ[Subfield.closure (Set.range ψ)] L, (∀ b : B, g (β b) = β b) →
        ∀ x ∈ K₂, g x = x)
    (hwild : ∀ g : L ≃ₐ[Subfield.closure (Set.range ψ)] L, (∀ a : A', g (ψ' a) = ψ' a) →
      (∀ s : Finset L, ∃ k : ℕ, ∀ x ∈ s, (g ^ (Q ^ k)) x = x) → ∀ x ∈ K₂, g x = x)
    (g : L ≃ₐ[Subfield.closure (Set.range ψ)] L) :
    ∃ h : L ≃ₐ[Subfield.closure (Set.range ψ)] L,
      (∀ a : A', h (ψ' a) = ψ' a) ∧ ∀ x ∈ K₂, h x = g x :=
by
  classical

  have hfixgen : ∀ (F : Subfield L) (S : Set L) (σ : L →+* L), (∀ x ∈ F, σ x = x) →
      (∀ x ∈ S, σ x = x) → ∀ x ∈ IntermediateField.adjoin F S, σ x = x := by
    intro F S σ hF hS x hx
    have hx' : x ∈ (IntermediateField.adjoin F S).toSubfield := hx
    rw [IntermediateField.adjoin_toSubfield] at hx'
    have hle : Subfield.closure (Set.range (algebraMap F L) ∪ S) ≤
        σ.eqLocusField (RingHom.id L) := by
      rw [Subfield.closure_le]
      rintro y (⟨c, rfl⟩ | hy)
      · exact RingHom.mem_eqLocusField.mpr (hF _ c.2)
      · exact RingHom.mem_eqLocusField.mpr (hS y hy)
    exact RingHom.mem_eqLocusField.mp (hle hx')

  have hK0K'' : Subfield.closure (Set.range ψ) ≤ Subfield.closure (Set.range ψ') := by
    rw [Subfield.closure_le]
    rintro _ ⟨a, rfl⟩
    exact Subfield.subset_closure ⟨α' a, by rw [← RingHom.comp_apply, hcomp]⟩
  obtain ⟨_, hMf, hMg⟩ := wc_tpa_compositum_galois L _ _ hK0K'' hgal K₂ hK₂f hK₂g
  have hpe : ¬ p ∣ Module.finrank (Subfield.closure (Set.range ψ'))
      (IntermediateField.adjoin (Subfield.closure (Set.range ψ')) (K₂ : Set L)) := by
    refine wc_tpa_wild_prime_to_p L _ _ hK0K'' hgal K₂ hK₂f hK₂g p Q hp hQ ?_
    intro g' hg' hpow
    exact hwild g' (fun a => hg' _ (Subfield.subset_closure ⟨a, rfl⟩)) hpow
  have he0 : 0 < Module.finrank (Subfield.closure (Set.range ψ'))
      (IntermediateField.adjoin (Subfield.closure (Set.range ψ')) (K₂ : Set L)) :=
    Module.finrank_pos
  have hpA' : (p : A') = 0 := by rw [← map_natCast α', hpA, map_zero]

  obtain ⟨t, ht, hadj⟩ := wc_tpa_trait_kummer A' hdvr p hp hpA' (α' f) hspan L ψ' hψ' _ hMf hMg hpe
  obtain ⟨e, he⟩ : ∃ e, Module.finrank (Subfield.closure (Set.range ψ'))
      (IntermediateField.adjoin (Subfield.closure (Set.range ψ')) (K₂ : Set L)) = e := ⟨_, rfl⟩
  rw [he] at ht hpe he0
  have hψf : t ^ e = ψ f := by rw [ht, ← hcomp, RingHom.comp_apply]

  have hunit : ∀ (R : Type u) [CommRing R], (p : R) = 0 → IsUnit (e : R) := by
    intro R _ hpR
    have hcop : Nat.Coprime p e := (Nat.Prime.coprime_iff_not_dvd hp).mpr hpe
    have h1 := Nat.gcd_eq_gcd_ab p e
    rw [hcop.gcd_eq_one] at h1
    have h2 := congrArg (Int.cast : ℤ → R) h1
    push_cast at h2
    rw [hpR, zero_mul, zero_add] at h2
    exact isUnit_iff_exists_inv.mpr ⟨_, h2.symm⟩

  obtain ⟨hN1, hH1, hS1, hR1, hD1, hθm, hθm2, hθp⟩ :=
    wc_tpa_kummer_cover_regular A hreg f hfm hfm2 hdomf hregf e he0
  haveI := hN1
  haveI := hH1
  haveI := hS1
  haveI := hD1
  haveI := hR1
  obtain ⟨_, hufd⟩ := wc_fco_regular_local_ufd (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f))
  haveI := hufd
  haveI : IsIntegrallyClosed (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) :=
    UniqueFactorizationMonoid.instIsIntegrallyClosed
  have hθe : (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f)) ^ e =
      AdjoinRoot.of (Polynomial.X ^ e - Polynomial.C f) f := by
    have := AdjoinRoot.eval₂_root (Polynomial.X ^ e - Polynomial.C f)
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at this
    exact sub_eq_zero.mp this
  have hev : Polynomial.eval₂ ψ t (Polynomial.X ^ e - Polynomial.C f) = 0 := by
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hψf, sub_self]
  obtain ⟨ψ₁, hψ₁of, hψ₁θ, hψ₁mk⟩ : ∃ ψ₁ : AdjoinRoot (Polynomial.X ^ e - Polynomial.C f) →+* L,
      ψ₁.comp (AdjoinRoot.of _) = ψ ∧ ψ₁ (AdjoinRoot.root _) = t ∧
      ∀ P, ψ₁ (AdjoinRoot.mk _ P) = Polynomial.eval₂ ψ t P :=
    ⟨AdjoinRoot.lift ψ t hev, AdjoinRoot.lift_comp_of hev, AdjoinRoot.lift_root hev,
      AdjoinRoot.lift_mk hev⟩
  have hψ₁inj : Function.Injective ψ₁ := by
    haveI : Module.Finite A (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) :=
      (AdjoinRoot.powerBasis' (Polynomial.monic_X_pow_sub_C f he0.ne')).finite
    haveI : Algebra.IsIntegral A (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) :=
      Algebra.IsIntegral.of_finite A _
    rw [RingHom.injective_iff_ker_eq_bot]
    apply Ideal.eq_bot_of_under_eq_bot (R := A)
    show Ideal.comap (algebraMap A _) (RingHom.ker ψ₁) = ⊥
    rw [RingHom.comap_ker, AdjoinRoot.algebraMap_eq, hψ₁of]
    exact (RingHom.injective_iff_ker_eq_bot ψ).mp hψ
  have hK0K1 : Subfield.closure (Set.range ψ) ≤ Subfield.closure (Set.range ψ₁) := by
    rw [Subfield.closure_le]
    rintro _ ⟨a, rfl⟩
    exact Subfield.subset_closure ⟨AdjoinRoot.of _ a, by rw [← RingHom.comp_apply, hψ₁of]⟩
  obtain ⟨hgal1, hK3f, hK3g⟩ := wc_tpa_compositum_galois L _ _ hK0K1 hgal K₂ hK₂f hK₂g

  have hres : ∀ g₁ : L ≃ₐ[Subfield.closure (Set.range ψ₁)] L,
      ∃ g' : L ≃ₐ[Subfield.closure (Set.range ψ)] L, ∀ x, g' x = g₁ x := fun g₁ =>
    ⟨AlgEquiv.ofRingEquiv (f := g₁.toRingEquiv) (fun x => g₁.commutes ⟨(x : L), hK0K1 x.2⟩),
      fun _ => rfl⟩

  have hbot : IntermediateField.adjoin (Subfield.closure (Set.range ψ₁)) (K₂ : Set L) = ⊥ := by
    refine wc_tpa_galois_purity (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) hR1
      (AdjoinRoot.root _) hθm hθm2 hθp L ψ₁ hψ₁inj hgal1 _ hK3f hK3g ?_ ?_
    ·
      intro 𝔮 _ h𝔮
      obtain ⟨B, _, _, _, α, β, hαwe, hαcomap, hβα⟩ := wc_tpa_strict_point _ L ψ₁ hψ₁inj 𝔮
      have hαθ : IsUnit (α (AdjoinRoot.root _)) := by
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hm
        apply h𝔮
        rw [← hαcomap]
        exact hm
      have hwe' := wc_tpa_weaklyEtale_off_root A B f e he0 (hunit A hpA) α hαwe hαθ
      have hαf : (α.comp (AdjoinRoot.of _)) f ∉ IsLocalRing.maximalIdeal B := by
        rw [IsLocalRing.notMem_maximalIdeal, RingHom.comp_apply, ← hθe, map_pow]
        exact hαθ.pow e
      have hβ' : β.comp (α.comp (AdjoinRoot.of _)) = ψ := by
        rw [← RingHom.comp_assoc, hβα, hψ₁of]
      refine ⟨B, inferInstance, inferInstance, inferInstance, α, β, hαwe, hαcomap, hβα, ?_⟩
      intro g₁ hg₁
      obtain ⟨g', hg'⟩ := hres g₁
      have hK₂fix : ∀ x ∈ K₂, g₁ x = x := by
        intro x hx
        rw [← hg']
        exact hin B (α.comp (AdjoinRoot.of _)) β hwe' hαf hβ' g'
          (fun b => by rw [hg']; exact hg₁ b) x hx
      exact hfixgen _ _ (g₁ : L →+* L) (fun x hx => g₁.commutes ⟨x, hx⟩) hK₂fix
    ·
      obtain ⟨B, _, _, _, α, β, ι, hαwe, hαcomap, hβαof, hβθ, hβι⟩ :=
        wc_tpa_trait_root A A' L hdvr α' hα' f hspan hcomap e he0 (hunit A' hpA') ψ' t ht
      have hβα : β.comp α = ψ₁ := by
        apply AdjoinRoot.ringHom_ext
        · rw [hβαof, hψ₁of, hcomp]
        · rw [RingHom.comp_apply, hβθ, hψ₁θ]
      refine ⟨B, inferInstance, inferInstance, inferInstance, α, β, hαwe, hαcomap, hβα, ?_⟩
      intro g₁ hg₁
      have hgK'' : ∀ x ∈ Subfield.closure (Set.range ψ'), (g₁ : L →+* L) x = x := by
        intro x hx
        have hle : Subfield.closure (Set.range ψ') ≤
            (g₁ : L →+* L).eqLocusField (RingHom.id L) := by
          rw [Subfield.closure_le]
          rintro _ ⟨a, rfl⟩
          rw [SetLike.mem_coe, RingHom.mem_eqLocusField, ← hβι, RingHom.comp_apply]
          exact hg₁ (ι a)
        exact RingHom.mem_eqLocusField.mp (hle hx)
      have hgt : (g₁ : L →+* L) t = t := by
        rw [← hβθ]
        exact hg₁ _
      have hgM := hfixgen _ {t} (g₁ : L →+* L) hgK'' (by rintro x rfl; exact hgt)
      have hK₂fix : ∀ x ∈ K₂, g₁ x = x := by
        intro x hx
        apply hgM
        rw [hadj]
        exact IntermediateField.subset_adjoin _ _ hx
      exact hfixgen _ _ (g₁ : L →+* L) (fun x hx => g₁.commutes ⟨x, hx⟩) hK₂fix

  have hK₂le : K₂ ≤ IntermediateField.adjoin (Subfield.closure (Set.range ψ)) {t} := by
    intro x hx
    have h1 : x ∈ IntermediateField.adjoin (Subfield.closure (Set.range ψ₁)) (K₂ : Set L) :=
      IntermediateField.subset_adjoin _ _ hx
    rw [hbot, IntermediateField.mem_bot] at h1
    obtain ⟨c, rfl⟩ := h1
    have hK1le : Subfield.closure (Set.range ψ₁) ≤
        (IntermediateField.adjoin (Subfield.closure (Set.range ψ)) {t}).toSubfield := by
      rw [Subfield.closure_le]
      rintro _ ⟨y, rfl⟩
      refine AdjoinRoot.induction_on _
        (C := fun y => ψ₁ y ∈ IntermediateField.adjoin (Subfield.closure (Set.range ψ)) {t})
        y (fun P => ?_)
      show ψ₁ (AdjoinRoot.mk _ P) ∈ IntermediateField.adjoin (Subfield.closure (Set.range ψ)) {t}
      rw [hψ₁mk]
      refine Polynomial.induction_on P ?_ ?_ ?_
      · intro a
        rw [Polynomial.eval₂_C]
        exact IntermediateField.algebraMap_mem _ (⟨ψ a, Subfield.subset_closure ⟨a, rfl⟩⟩ : Subfield.closure (Set.range ψ))
      · intro P₁ P₂ h₁ h₂
        rw [Polynomial.eval₂_add]
        exact add_mem h₁ h₂
      · intro n a _
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        exact mul_mem (IntermediateField.algebraMap_mem _ (⟨ψ a, Subfield.subset_closure ⟨a, rfl⟩⟩ : Subfield.closure (Set.range ψ)))
          (pow_mem (IntermediateField.mem_adjoin_simple_self _ t) _)
    exact hK1le c.2
  have hf0 : ψ f ∈ Subfield.closure (Set.range ψ) := Subfield.subset_closure ⟨f, rfl⟩
  have haev : Polynomial.aeval t (Polynomial.X ^ e -
      Polynomial.C (⟨ψ f, hf0⟩ : Subfield.closure (Set.range ψ))) = 0 := by
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hψf]
    exact sub_self (ψ f)
  have hint : IsIntegral (Subfield.closure (Set.range ψ)) t :=
    ⟨_, Polynomial.monic_X_pow_sub_C _ he0.ne', by rw [← Polynomial.aeval_def]; exact haev⟩
  have hdeg : Module.finrank (Subfield.closure (Set.range ψ)) K₂ ≤ e := by
    haveI := IntermediateField.adjoin.finiteDimensional hint
    calc Module.finrank _ K₂
        ≤ Module.finrank _ (IntermediateField.adjoin (Subfield.closure (Set.range ψ)) {t}) :=
          IntermediateField.finrank_le_of_le_right hK₂le
      _ = (minpoly _ t).natDegree := IntermediateField.adjoin.finrank hint
      _ ≤ (Polynomial.X ^ e -
            Polynomial.C (⟨ψ f, hf0⟩ : Subfield.closure (Set.range ψ))).natDegree :=
          Polynomial.natDegree_le_of_dvd (minpoly.dvd _ _ haev) (Polynomial.X_pow_sub_C_ne_zero he0 _)
      _ = e := Polynomial.natDegree_X_pow_sub_C

  obtain ⟨h, hhK'', hhK₂⟩ := wc_tpa_restriction_surj L _ _ hK0K'' hgal K₂ hK₂f hK₂g
    (by rw [he]; exact hdeg) g
  exact ⟨h, fun a => hhK'' _ (Subfield.subset_closure ⟨a, rfl⟩), hhK₂⟩

theorem wc_pfam_xi_tame_purity_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (S : Set (Ty ⟶ Ty)) (hS0 : 𝟙 Ty ∈ S)
    (hS1 : ∀ (V' : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eB : V'.left ≅ Spec (.of B))
      (ι' : V' ⟶ Vy) (u' : Ty ⟶ V'), u' ≫ ι' = uy →
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι' ≫ vy).left (eB.inv (IsLocalRing.closedPoint B))) ∉ Δ →
      ∀ m : Ty ⟶ Ty, m ≫ u' = u' → m ∈ S)
    (hS2 : ∀ a b : Ty ⟶ Ty, a ∈ S → b ∈ S → a ≫ b ∈ S)
    (hS3 : ∀ τ : Ty ⟶ Ty, τ ≫ uy = uy →
      (∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vy) (eE : Ty ⟶ E),
        Etale πE.left → eE ≫ πE = uy →
        ∃ m ∈ S, m ≫ uy = uy ∧ m ≫ eE = τ ≫ eE) → τ ∈ S)
    (hS4 : ∀ τw : Ty ⟶ Ty, τw ≫ uξ = uξ →
      (∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vξ) (eE : Ty ⟶ E),
        Etale πE.left → eE ≫ πE = uξ →
        ∃ k : ℕ, (fun g : Ty ⟶ E => τw ≫ g)^[Nat.card F'' ^ k] eE = eE) →
      ∀ ρ ρ' : Ty ⟶ Ty, ρ ≫ uy = uy → ρ' ≫ uy = uy → ρ ≫ ρ' = 𝟙 Ty → ρ' ≫ ρ = 𝟙 Ty →
        ρ ≫ τw ≫ ρ' ∈ S)
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uy = uy) :
    ∃ m ∈ S, ∃ τ' : Ty ⟶ Ty, τ' ≫ uξ = uξ ∧ τ = m ≫ τ' :=
by
  classical
  obtain ⟨hGal, Φ, -, hΦmul, hΦ1, hΦu, hΦsurj, hΦstab, hΦfin⟩ :=
    wc_tps_dictionary Ty Vy L A eL e uy
  have hinv : ∀ ρ : L ≃ₐ[wcTpsBase eL e uy] L, Φ ρ ≫ Φ ρ⁻¹ = 𝟙 Ty := by
    intro ρ; rw [← hΦmul, mul_inv_cancel, hΦ1]
  have hinv' : ∀ ρ : L ≃ₐ[wcTpsBase eL e uy] L, Φ ρ⁻¹ ≫ Φ ρ = 𝟙 Ty := by
    intro ρ; rw [← hΦmul, inv_mul_cancel, hΦ1]
  have hconj : ∀ ρ σ : L ≃ₐ[wcTpsBase eL e uy] L, Φ (ρ * σ * ρ⁻¹) = Φ ρ ≫ Φ σ ≫ Φ ρ⁻¹ := by
    intro ρ σ; rw [hΦmul, hΦmul, Category.assoc]
  have hfixA : ∀ (g : L ≃ₐ[wcTpsBase eL e uy] L) (r : A),
      g (wcTpsRingOf eL e uy r) = wcTpsRingOf eL e uy r := fun g r =>
    g.commutes ⟨_, Subfield.subset_closure ⟨r, rfl⟩⟩

  let N : Submonoid (L ≃ₐ[wcTpsBase eL e uy] L) :=
    { carrier := {σ | ∀ ρ, Φ (ρ * σ * ρ⁻¹) ∈ S}
      one_mem' := by
        intro ρ
        show Φ (ρ * 1 * ρ⁻¹) ∈ S
        rw [mul_one, mul_inv_cancel, hΦ1]; exact hS0
      mul_mem' := by
        intro a b ha hb ρ
        have ha' : Φ (ρ * a * ρ⁻¹) ∈ S := ha ρ
        have hb' : Φ (ρ * b * ρ⁻¹) ∈ S := hb ρ
        show Φ (ρ * (a * b) * ρ⁻¹) ∈ S
        have hab : ρ * (a * b) * ρ⁻¹ = (ρ * a * ρ⁻¹) * (ρ * b * ρ⁻¹) := by group
        rw [hab, hΦmul]; exact hS2 _ _ ha' hb' }
  have hNmem : ∀ σ, σ ∈ N ↔ ∀ ρ, Φ (ρ * σ * ρ⁻¹) ∈ S := fun σ => Iff.rfl
  have hNconj : ∀ ρ σ, σ ∈ N → ρ * σ * ρ⁻¹ ∈ N := by
    intro ρ σ hσ
    rw [hNmem] at hσ ⊢
    intro ρ'
    have : ρ' * (ρ * σ * ρ⁻¹) * ρ'⁻¹ = (ρ' * ρ) * σ * (ρ' * ρ)⁻¹ := by group
    rw [this]; exact hσ _

  obtain ⟨f, hNoeth, hreg, hdom, hfm, hfm2, hdomf, hregf, hfΔ, hchar⟩ :=
    wc_tps_local_algebra F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy vy A e hVy
  obtain ⟨hψinj, hψ'inj, hcomp, hdomA', hdvr, hspan, hcomap, hwe⟩ :=
    wc_tps_generic_trait F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ
      A' e' hιu hΔξ hclξ f hfΔ hfm hfm2 hNoeth hreg hdom hdomf
  haveI := hdom
  haveI := hNoeth
  haveI := hdomA'
  haveI := Fintype.ofFinite F''
  have hpprime : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
  obtain ⟨r, -, hcard⟩ := FiniteField.card F'' (ringChar F'')
  have hQ : ∃ r : ℕ, 0 < r ∧ Nat.card F'' = ringChar F'' ^ r :=
    ⟨r, r.pos, by rw [Nat.card_eq_fintype_card, hcard]⟩

  have hiter : ∀ (g : L ≃ₐ[wcTpsBase eL e uy] L) (E : (wcProjK F'' M').ProEt) (eE : Ty ⟶ E)
      (m : ℕ), (fun g' : Ty ⟶ E => Φ g ≫ g')^[m] eE = Φ (g ^ m) ≫ eE := by
    intro g E eE m
    induction m with
    | zero => simp only [Function.iterate_zero, id_eq, pow_zero, hΦ1, Category.id_comp]
    | succ m ih =>
      rw [Function.iterate_succ_apply', ih, pow_succ', hΦmul, Category.assoc]

  have hsurj : ∀ K₂ : IntermediateField (wcTpsBase eL e uy) L,
      FiniteDimensional (wcTpsBase eL e uy) K₂ → IsGalois (wcTpsBase eL e uy) K₂ →
      (∀ σ ∈ N, ∀ x ∈ K₂, σ x = x) →
      ∀ g : L ≃ₐ[wcTpsBase eL e uy] L, ∃ h' : L ≃ₐ[wcTpsBase eL e uy] L,
        (∀ t ∈ Set.range (wcTpsRingOf eL e' uξ), h' t = t) ∧ ∀ x ∈ K₂, h' x = g x := by
    intro K₂ hK₂f hK₂g hK₂N g
    have hin : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
        [IsSepClosed (IsLocalRing.ResidueField B)] (α : A →+* B) (β : B →+* L),
        @Algebra.WeaklyEtale A B _ _ α.toAlgebra → α f ∉ IsLocalRing.maximalIdeal B →
        β.comp α = wcTpsRingOf eL e uy →
        ∀ g : L ≃ₐ[wcTpsBase eL e uy] L, (∀ b : B, g (β b) = β b) →
          ∀ x ∈ K₂, g x = x := by
      intro B _ _ _ α β hα hαf hβ g' hg'
      obtain ⟨V', eB, ι', u', hu', hoff, hβ'⟩ :=
        wc_tps_strict_local_realize M' Δ hPP Vy Ty uy vy A e L eL f hfΔ B α β hα hαf hβ
      have hgu : Φ g' ≫ u' = u' := by
        rw [hΦstab V' B eB u' g', hβ']; exact hg'
      apply hK₂N g'
      rw [hNmem]
      intro ρ
      have hu'' : (Φ ρ ≫ u') ≫ ι' = uy := by rw [Category.assoc, hu', hΦu]
      refine hS1 V' B eB ι' (Φ ρ ≫ u') hu'' hoff (Φ (ρ * g' * ρ⁻¹)) ?_
      rw [hconj]
      simp only [Category.assoc]
      rw [← Category.assoc (Φ ρ⁻¹) (Φ ρ) u', hinv', Category.id_comp, hgu]
    have hwild : ∀ g : L ≃ₐ[wcTpsBase eL e uy] L,
        (∀ a : A', g (wcTpsRingOf eL e' uξ a) = wcTpsRingOf eL e' uξ a) →
        (∀ s : Finset L, ∃ k : ℕ, ∀ x ∈ s, (g ^ (Nat.card F'' ^ k)) x = x) →
        ∀ x ∈ K₂, g x = x := by
      intro g' hga hpro
      have hgξ : Φ g' ≫ uξ = uξ := (hΦstab Vξ A' e' uξ g').mpr hga
      have hpowfix : ∀ (m : ℕ) (a : A'),
          (g' ^ m) (wcTpsRingOf eL e' uξ a) = wcTpsRingOf eL e' uξ a := by
        intro m a
        induction m with
        | zero => rw [pow_zero, AlgEquiv.one_apply]
        | succ m ih => rw [pow_succ', AlgEquiv.mul_apply, ih, hga]
      apply hK₂N g'
      rw [hNmem]
      intro ρ
      rw [hconj]
      refine hS4 (Φ g') hgξ ?_ (Φ ρ) (Φ ρ⁻¹) (hΦu _) (hΦu _) (hinv ρ) (hinv' ρ)
      intro E πE eE hE hEu
      obtain ⟨s, hs⟩ := hΦfin Vξ A' e' uξ E πE eE hE hEu
      obtain ⟨k, hk⟩ := hpro s
      refine ⟨k, ?_⟩
      rw [hiter g' E eE]
      have := hs (g' ^ (Nat.card F'' ^ k)) 1 (hpowfix _)
        (fun a => by rw [AlgEquiv.one_apply]) (fun x hx => by rw [hk x hx, AlgEquiv.one_apply])
      rw [this, hΦ1, Category.id_comp]
    obtain ⟨h', hh'A, hh'K⟩ := wc_tps_tame_purity_algebraic L A hreg (ringChar F'') (Nat.card F'')
      hpprime hchar hQ (wcTpsRingOf eL e uy) hψinj hGal f hfm hfm2 hdomf hregf A' hdvr
      (wcTpsRingOf e' e ι) hwe hspan hcomap (wcTpsRingOf eL e' uξ) hψ'inj hcomp K₂ hK₂f hK₂g
      hin hwild g
    refine ⟨h', ?_, hh'K⟩
    rintro t ⟨a, rfl⟩
    exact hh'A a

  obtain ⟨g₀, hg₀⟩ := hΦsurj τ hτ
  obtain ⟨hh, hhT, hdense⟩ := wc_tps_galois_factorization
    (Set.range (wcTpsRingOf eL e' uξ)) N hNconj hsurj g₀
  have hτ' : Φ hh ≫ uξ = uξ := (hΦstab Vξ A' e' uξ hh).mpr (fun a => hhT _ ⟨a, rfl⟩)
  have hmS : Φ (g₀ * hh⁻¹) ∈ S := by
    refine hS3 _ (hΦu _) ?_
    intro E πE eE hE hEu
    obtain ⟨s, hs⟩ := hΦfin Vy A e uy E πE eE hE hEu
    obtain ⟨n', hn'N, hn'⟩ := hdense s
    refine ⟨Φ n', ?_, hΦu n', ?_⟩
    · have := (hNmem n').mp hn'N 1
      rwa [one_mul, inv_one, mul_one] at this
    · exact hs n' (g₀ * hh⁻¹) (hfixA n') (hfixA _) hn'
  refine ⟨Φ (g₀ * hh⁻¹), hmS, Φ hh, hτ', ?_⟩
  rw [← hg₀, ← hΦmul, inv_mul_cancel_right]

theorem wc_pfam_ltd_tp_nbhd {X : Scheme.{u}} (V T : X.ProEt) (u : T ⟶ V)
    (A L : Type u) [CommRing A] [Field L] [IsSepClosed L]
    (e : V.left ≅ Spec (.of A)) (eL : T.left ≅ Spec (.of L)) (τ : T ⟶ T) (s : Finset L) :
    ∃ (E : X.ProEt) (πE : E ⟶ V) (eE : T ⟶ E), Etale πE.left ∧ eE ≫ πE = u ∧
      ∀ m : T ⟶ T, m ≫ eE = τ ≫ eE →
        ∀ w ∈ s, wcLtdRing eL eL m.left w = wcLtdRing eL eL τ.left w :=
by
  classical

  haveI hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have c₀ : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L)
        ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    exact wc_hte_sepClosed_henselian_transport.1 L _ c₀ inferInstance

  have hW : @Algebra.WeaklyEtale A L _ _ (wcLtdRing e eL u.left).toAlgebra :=
    wc_mnt_point_map_weaklyEtale X V T u A L e eL

  obtain ⟨C, _, _, hEt, β, c, hβ, hc⟩ :=
    wc_lpkt_indetale_factor A L (wcLtdRing e eL u.left) hW s.card
      (fun i => ((s.equivFin.symm i : s) : L))

  have haEt : Etale (Spec.map (CommRingCat.ofHom (algebraMap A C))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Etale)]
    exact RingHom.etale_algebraMap.mpr hEt
  have hK : Spec.map (CommRingCat.ofHom β) ≫ Spec.map (CommRingCat.ofHom (algebraMap A C)) =
      eL.inv ≫ u.left ≫ e.hom := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hβ]
    show Spec.map (CommRingCat.ofHom (Spec.preimage (eL.inv ≫ u.left ≫ e.hom)).hom) = _
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  haveI : WeaklyEtale V.hom := V.prop
  haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv) := inferInstance
  have hWE : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv ≫ V.hom) := by
    rw [← Category.assoc]; infer_instance
  let E : X.ProEt := MorphismProperty.Over.mk ⊤
    (Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv ≫ V.hom) hWE
  let πE : E ⟶ V := MorphismProperty.Over.homMk
    (Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv) (Category.assoc _ _ _) trivial
  have hwE : (eL.hom ≫ Spec.map (CommRingCat.ofHom β)) ≫ E.hom = T.hom := by
    show (eL.hom ≫ Spec.map (CommRingCat.ofHom β)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv ≫ V.hom = T.hom
    rw [Category.assoc, reassoc_of% hK, Iso.hom_inv_id_assoc, Iso.hom_inv_id_assoc]
    exact MorphismProperty.Over.w u
  let eE : T ⟶ E := MorphismProperty.Over.homMk (eL.hom ≫ Spec.map (CommRingCat.ofHom β)) hwE trivial
  refine ⟨E, πE, eE, ?_, ?_, ?_⟩
  · show Etale (Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv)
    infer_instance
  · apply MorphismProperty.Over.Hom.ext
    show (eL.hom ≫ Spec.map (CommRingCat.ofHom β)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv = u.left
    rw [Category.assoc, reassoc_of% hK, Iso.hom_inv_id_assoc, Iso.hom_inv_id,
      Category.comp_id]
  · intro m hm w hw
    have hl := congrArg (fun f => f.left) hm
    change m.left ≫ eL.hom ≫ Spec.map (CommRingCat.ofHom β) =
      τ.left ≫ eL.hom ≫ Spec.map (CommRingCat.ofHom β) at hl
    have key : ∀ g : T.left ⟶ T.left, (eL.inv ≫ g ≫ eL.hom) ≫ Spec.map (CommRingCat.ofHom β) =
        Spec.map (CommRingCat.ofHom β ≫ Spec.preimage (eL.inv ≫ g ≫ eL.hom)) := by
      intro g
      rw [Spec.map_comp, Spec.map_preimage]
    have h2 : Spec.map (CommRingCat.ofHom β ≫ Spec.preimage (eL.inv ≫ m.left ≫ eL.hom)) =
        Spec.map (CommRingCat.ofHom β ≫ Spec.preimage (eL.inv ≫ τ.left ≫ eL.hom)) := by
      rw [← key, ← key]
      simp only [Category.assoc]
      rw [hl]
    have h3 := Spec.map_injective h2
    have hci : β (c (s.equivFin ⟨w, hw⟩)) = w := by
      rw [hc]; simp
    rw [← hci]
    exact congrArg (fun f => f.hom (c (s.equivFin ⟨w, hw⟩))) h3

theorem wc_pfam_ltd_tp_kummer (B L : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] [Field L] (β : B →+* L)
    (m : ℕ) (hm0 : 0 < m) (hmu : IsUnit (m : B)) :
    (∀ ζ : L, ζ ^ m = 1 → ∃ b : B, β b = ζ) ∧
    (∀ b : B, IsUnit b → ∀ w : L, w ^ m = β b → ∃ c : B, β c = w) ∧
    (∀ σ : L →+* L, (∀ b : B, σ (β b) = β b) → ∀ (a w : L) (N : ℕ),
      w ^ m = a → σ a = a → Nat.Coprime N m → (⇑σ)^[N] w = w → σ w = w) :=
by
  classical

  have hens : ∀ (b : B) (y : IsLocalRing.ResidueField B), y ≠ 0 →
      y ^ m = IsLocalRing.residue B b →
      ∃ c : B, c ^ m = b ∧ IsLocalRing.residue B c = y := by
    intro b y hy0 hy
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective y
    have hmon : (Polynomial.X ^ m - Polynomial.C b).Monic :=
      Polynomial.monic_X_pow_sub_C b hm0.ne'
    have h1 : (Polynomial.X ^ m - Polynomial.C b).eval a₀ ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        map_sub, map_pow, ha₀, hy, sub_self]
    have ha₀u : IsUnit a₀ :=
      (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hy0)
    have h2 : IsUnit ((Polynomial.derivative (Polynomial.X ^ m - Polynomial.C b)).eval a₀) := by
      have : (Polynomial.derivative (Polynomial.X ^ m - Polynomial.C b)).eval a₀
          = (m : B) * a₀ ^ (m - 1) := by
        simp [Polynomial.derivative_X_pow]
      rw [this]
      exact hmu.mul (ha₀u.pow _)
    obtain ⟨c, hc, hca⟩ := HenselianLocalRing.is_henselian _ hmon a₀ h1 h2
    refine ⟨c, ?_, ?_⟩
    · have h : (Polynomial.X ^ m - Polynomial.C b).eval c = 0 := hc
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at h
      exact sub_eq_zero.mp h
    · have h : IsLocalRing.residue B (c - a₀) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hca
      rw [map_sub, sub_eq_zero] at h
      rw [h, ha₀]

  have hmk : ((m : ℕ) : IsLocalRing.ResidueField B) ≠ 0 := by
    have := hmu.map (IsLocalRing.residue B)
    rw [map_natCast] at this
    exact this.ne_zero
  haveI : NeZero ((m : ℕ) : IsLocalRing.ResidueField B) := ⟨hmk⟩
  haveI : NeZero m := ⟨hm0.ne'⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity (IsLocalRing.ResidueField B) m

  obtain ⟨η, hη⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (IsLocalRing.ResidueField B) m
  have hη0 : η ≠ 0 := by
    intro h
    have := hη.pow_eq_one
    rw [h, zero_pow hm0.ne'] at this
    exact zero_ne_one this
  obtain ⟨ε, hεm, hεη⟩ := hens 1 η hη0 (by rw [hη.pow_eq_one, map_one])
  have hξ : IsPrimitiveRoot (β ε) m := by
    refine IsPrimitiveRoot.mk_of_lt (β ε) hm0 (by rw [← map_pow, hεm, map_one]) ?_
    intro l hl hlm
    have hu : IsUnit (ε ^ l - 1) := by
      apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [map_sub, map_pow, map_one, hεη, sub_ne_zero]
      exact hη.pow_ne_one_of_pos_of_lt (by omega) hlm
    have := (hu.map β).ne_zero
    rw [map_sub, map_pow, map_one, sub_ne_zero] at this
    exact this

  have P1 : ∀ ζ : L, ζ ^ m = 1 → ∃ b : B, β b = ζ := by
    intro ζ hζ
    obtain ⟨i, -, hi⟩ := hξ.eq_pow_of_pow_eq_one hζ
    exact ⟨ε ^ i, by rw [map_pow, hi]⟩

  have P2 : ∀ b : B, IsUnit b → ∀ w : L, w ^ m = β b → ∃ c : B, β c = w := by
    intro b hb w hw
    have hrb : IsLocalRing.residue B b ≠ 0 := (IsLocalRing.residue_ne_zero_iff_isUnit b).mpr hb
    obtain ⟨y, hy⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue B b) m
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hm0.ne'] at hy
      exact hrb hy.symm
    obtain ⟨c₀, hc₀, -⟩ := hens b y hy0 hy
    have hβb : β b ≠ 0 := (hb.map β).ne_zero
    have hβc : β c₀ ≠ 0 := by
      intro h
      apply hβb
      rw [← hc₀, map_pow, h, zero_pow hm0.ne']
    obtain ⟨b', hb'⟩ := P1 (w * (β c₀)⁻¹)
      (by rw [mul_pow, inv_pow, ← map_pow, hc₀, hw, mul_inv_cancel₀ hβb])
    exact ⟨b' * c₀, by rw [map_mul, hb', inv_mul_cancel_right₀ hβc]⟩
  refine ⟨P1, P2, ?_⟩

  intro σ hσ a w N hw ha hN hit
  have hrou : ∀ ζ : L, ζ ^ m = 1 → σ ζ = ζ := by
    intro ζ hζ
    obtain ⟨b, rfl⟩ := P1 ζ hζ
    exact hσ b
  by_cases hw0 : w = 0
  · rw [hw0, map_zero]
  have hwm0 : w ^ m ≠ 0 := pow_ne_zero _ hw0
  have hσm : (σ w) ^ m = w ^ m := by rw [← map_pow, hw, ha]
  have hζm : (σ w * w⁻¹) ^ m = 1 := by
    rw [mul_pow, inv_pow, hσm, mul_inv_cancel₀ hwm0]
  have hζσ : σ (σ w * w⁻¹) = σ w * w⁻¹ := hrou _ hζm
  have hσw : σ w = (σ w * w⁻¹) * w := by rw [mul_assoc, inv_mul_cancel₀ hw0, mul_one]
  have hk : ∀ k : ℕ, (⇑σ)^[k] w = (σ w * w⁻¹) ^ k * w := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Function.iterate_succ_apply', ih, map_mul, map_pow, hζσ, pow_succ, mul_assoc]
      congr 1
  have hζN : (σ w * w⁻¹) ^ N = 1 := by
    have := hk N
    rw [hit] at this
    exact mul_right_cancel₀ hw0 (this.symm.trans (one_mul w).symm)
  have h1 : (σ w * w⁻¹) ^ (N.gcd m) = 1 := pow_gcd_eq_one.mpr ⟨hζN, hζm⟩
  rw [Nat.Coprime.gcd_eq_one hN, pow_one] at h1
  rw [hσw, h1, one_mul]

theorem wc_pfam_ltd_tame_purity (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (j : Fin D.m)
    (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    [IsSepClosed (IsLocalRing.ResidueField Ay)] (ey : Vy.left ≅ Spec (.of Ay))
    (Ly : Type u) [Field Ly] [IsSepClosed Ly] (eLy : Ty.left ≅ Spec (.of Ly))
    (hy : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (f : Ay) (hf : ∀ z : Vy.left, Vy.hom z ∈ Δ ↔ f ∈ (ey.hom z).asIdeal)
    {X : Type*} (ρ : (Ty ⟶ Ty) → X → X)
    (hρc : ∀ a b : Ty ⟶ Ty, ρ (a ≫ b) = ρ a ∘ ρ b) (hρi : ρ (𝟙 Ty) = id)
    (hoff : ∀ (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eZ : Z.left ≅ Spec (.of B))
      (ιZ : Z ⟶ Vy) (uZ : Ty ⟶ Z), uZ ≫ ιZ = uy → (∀ z : Z.left, Z.hom z ∉ Δ) →
      ∀ τ : Ty ⟶ Ty, τ ≫ uZ = uZ → ρ τ = id)
    (hwild : ∀ (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eZ : Z.left ≅ Spec (.of B))
      (ιZ : Z ⟶ Vy) (uZ : Ty ⟶ Z), uZ ≫ ιZ = uy →
      f ∈ (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal →
      (∀ q : PrimeSpectrum Ay, f ∈ q.asIdeal →
        (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal ≤ q.asIdeal) →
      ∀ τ : Ty ⟶ Ty, τ ≫ uZ = uZ →
      wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f
        (wcLtdRing eLy eLy τ.left) (RingHom.id Ly) → ρ τ = id)
    (hcl : ∀ τ : Ty ⟶ Ty, τ ≫ uy = uy → (∀ S : Finset Ly, ∃ m : Ty ⟶ Ty, m ≫ uy = uy ∧
      ρ m = id ∧ ∀ w ∈ S, wcLtdRing eLy eLy m.left w = wcLtdRing eLy eLy τ.left w) →
      ρ τ = id) :
    ∀ τ₁ τ₂ : Ty ⟶ Ty, τ₁ ≫ uy = uy → τ₂ ≫ uy = uy →
      wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f
        (wcLtdRing eLy eLy τ₁.left) (wcLtdRing eLy eLy τ₂.left) → ρ τ₁ = ρ τ₂ :=
by
  classical
  intro τ₁ τ₂ h₁ h₂ hag
  have hpprime : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')

  have hcomp : ∀ {X₁ X₂ X₃ : Scheme.{u}} {R₁ R₂ R₃ : Type u} [CommRing R₁] [CommRing R₂]
      [CommRing R₃] (e₁ : X₁ ≅ Spec (.of R₁)) (e₂ : X₂ ≅ Spec (.of R₂)) (e₃ : X₃ ≅ Spec (.of R₃))
      (g : X₂ ⟶ X₁) (k : X₃ ⟶ X₂),
      wcLtdRing e₁ e₃ (k ≫ g) = (wcLtdRing e₂ e₃ k).comp (wcLtdRing e₁ e₂ g) := by
    intro X₁ X₂ X₃ R₁ R₂ R₃ _ _ _ e₁ e₂ e₃ g k
    unfold wcLtdRing
    rw [← CommRingCat.hom_comp]
    congr 1
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  have hσc : ∀ (a b : Ty ⟶ Ty) (w : Ly), wcLtdRing eLy eLy (a ≫ b).left w =
      wcLtdRing eLy eLy a.left (wcLtdRing eLy eLy b.left w) := by
    intro a b w
    have h1 := hcomp eLy eLy eLy b.left a.left
    have h2 : (a ≫ b).left = a.left ≫ b.left := rfl
    rw [h2, h1]
    rfl
  have hσid : ∀ w : Ly, wcLtdRing eLy eLy (𝟙 Ty : Ty ⟶ Ty).left w = w := by
    intro w
    have h0 : (𝟙 Ty : Ty ⟶ Ty).left = 𝟙 Ty.left := by
      first
        | rfl
        | simp
    have h1 : Spec.preimage (eLy.inv ≫ (𝟙 Ty : Ty ⟶ Ty).left ≫ eLy.hom) = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_preimage, Spec.map_id, h0, Category.id_comp, Iso.inv_hom_id]
    show (Spec.preimage (eLy.inv ≫ (𝟙 Ty : Ty ⟶ Ty).left ≫ eLy.hom)).hom w = w
    rw [h1]
    rfl

  have hR1gen : ∀ (V' : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B]
      (eB : V'.left ≅ Spec (.of B)) (u' : Ty ⟶ V') (τ : Ty ⟶ Ty), τ ≫ u' = u' →
      ∀ b : B, wcLtdRing eLy eLy τ.left (wcLtdRing eB eLy u'.left b) =
        wcLtdRing eB eLy u'.left b := by
    intro V' B _ eB u' τ hτ b
    have h1 := hcomp eB eLy eLy u'.left τ.left
    have h2 : τ.left ≫ u'.left = u'.left := congrArg (fun g => g.left) hτ
    rw [h2] at h1
    exact (congrArg (fun φ : B →+* Ly => φ b) h1).symm
  have hψfac : ∀ (V' : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B]
      (eB : V'.left ≅ Spec (.of B)) (ι' : V' ⟶ Vy) (u' : Ty ⟶ V'), u' ≫ ι' = uy →
      wcLtdRing ey eLy uy.left = (wcLtdRing eB eLy u'.left).comp (wcLtdRing ey eB ι'.left) := by
    intro V' B _ eB ι' u' hu
    have h2 : uy.left = u'.left ≫ ι'.left := (congrArg (fun g => g.left) hu).symm
    rw [h2]
    exact hcomp ey eB eLy ι'.left u'.left
  have hinvhom : ∀ {S₁ S₂ : Scheme.{u}} (e : S₁ ≅ S₂) (z : S₁), e.inv (e.hom z) = z := by
    intro S₁ S₂ e z
    have h0 := Scheme.Hom.comp_apply e.hom e.inv z
    rw [Iso.hom_inv_id] at h0
    first
      | exact h0.symm
      | simpa using h0.symm
  have hey : ∀ q : PrimeSpectrum Ay, ey.hom (ey.inv q) = q := fun q => hinvhom ey.symm q
  have hcomapgen : ∀ (V' : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [IsLocalRing B]
      (eB : V'.left ≅ Spec (.of B)) (ι' : V' ⟶ Vy),
      (IsLocalRing.maximalIdeal B).comap (wcLtdRing ey eB ι'.left) =
        (ey.hom (ι'.left (eB.inv (IsLocalRing.closedPoint B)))).asIdeal := by
    intro V' B _ _ eB ι'
    have e1 : (Spec.map (Spec.preimage (eB.inv ≫ ι'.left ≫ ey.hom))
        (IsLocalRing.closedPoint B)).asIdeal =
        (IsLocalRing.maximalIdeal B).comap (wcLtdRing ey eB ι'.left) :=
      Submodule.toSubMulAction_inj.mp rfl
    rw [← e1, Spec.map_preimage]
    first
      | rfl
      | simp only [Scheme.Hom.comp_apply]
  have hVapp : ∀ (V' : (wcProjK F'' M').ProEt) (ι' : V' ⟶ Vy) (x : V'.left),
      Vy.hom (ι'.left x) = V'.hom x := by
    intro V' ι' x
    rw [← MorphismProperty.Over.w ι', Scheme.Hom.comp_apply]

  have hTT : ∀ m : Ty ⟶ Ty, (∀ (w : Ly) (k : ℕ), 0 < k → ¬ ringChar F'' ∣ k →
      w ^ k = wcLtdRing ey eLy uy.left f → wcLtdRing eLy eLy m.left w = w) →
      wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f (wcLtdRing eLy eLy m.left)
        (RingHom.id Ly) :=
    fun m H => H
  have hTT' : ∀ m : Ty ⟶ Ty, wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f
      (wcLtdRing eLy eLy m.left) (RingHom.id Ly) →
      ∀ (w : Ly) (k : ℕ), 0 < k → ¬ ringChar F'' ∣ k →
      w ^ k = wcLtdRing ey eLy uy.left f → wcLtdRing eLy eLy m.left w = w :=
    fun m H => H
  have htrans : ∀ τ : Ty ⟶ Ty, τ ≫ uy = uy → ∀ (w : Ly) (k : ℕ),
      w ^ k = wcLtdRing ey eLy uy.left f →
      (wcLtdRing eLy eLy τ.left w) ^ k = wcLtdRing ey eLy uy.left f := by
    intro τ hτ w k hw
    rw [← map_pow, hw, hR1gen Vy Ay ey uy τ hτ f]

  have hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨vy⟩ := wc_pfam_ltd_wt_geom_lift F'' M' hPP Vy Ay ey
  have hvyapp : ∀ (V' : (wcProjK F'' M').ProEt) (ι' : V' ⟶ Vy) (x : V'.left),
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ((ι' ≫ vy).left x) =
        Vy.hom (ι'.left x) := by
    intro V' ι' x
    have hw : vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Vy.hom :=
      MorphismProperty.Over.w vy
    rw [← hw, Scheme.Hom.comp_apply]
    first
      | rfl
      | simp only [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply]
  have hH' := hH
  obtain ⟨_, _, _, _, hΔc, _⟩ := hH'
  obtain ⟨f₀, hNoeth, hreg, hdom, hf₀m, hf₀m2, hdomq, _, hf₀Δ, hcharA⟩ :=
    wc_tps_local_algebra F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy vy Ay ey hy
  obtain ⟨Vξ, ι, uξ, A', iA1, iA2, iA3, e', hιu, hΔξ, hclξ⟩ :=
    wc_pfam_xi_construct F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy Ty uy vy Ay ey hy Ly eLy
  obtain ⟨_, _, _, _, _, _, hcomap, _⟩ :=
    wc_tps_generic_trait F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy Ty uy vy Ay ey hy Ly eLy
      Vξ ι uξ A' e' hιu hΔξ hclξ f₀ hf₀Δ hf₀m hf₀m2 hNoeth hreg hdom hdomq
  have hξΔ : Vy.hom (ι.left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ := by
    rw [← hvyapp Vξ ι]
    exact hΔξ
  have hξ : f ∈ (ey.hom (ι.left (e'.inv (IsLocalRing.closedPoint A')))).asIdeal := (hf _).1 hξΔ
  have hq'eq : (ey.hom (ι.left (e'.inv (IsLocalRing.closedPoint A')))).asIdeal =
      Ideal.span {f₀} :=
    (hcomapgen Vξ A' e' ι).symm.trans hcomap
  have hξgen : ∀ q : PrimeSpectrum Ay, f ∈ q.asIdeal →
      (ey.hom (ι.left (e'.inv (IsLocalRing.closedPoint A')))).asIdeal ≤ q.asIdeal := by
    intro q hq
    rw [hq'eq, Ideal.span_singleton_le_iff_mem]
    apply (hf₀Δ q).1
    exact (hf (ey.inv q)).2 (by rw [hey]; exact hq)
  have hwξ : ∀ uZ : Ty ⟶ Vξ, uZ ≫ ι = uy → ∀ τ : Ty ⟶ Ty, τ ≫ uZ = uZ →
      wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f (wcLtdRing eLy eLy τ.left)
        (RingHom.id Ly) → ρ τ = id :=
    fun uZ huZ τ hτ htt => hwild Vξ A' e' ι uZ huZ hξ hξgen τ hτ htt

  have hunit : ∀ k : ℕ, ¬ ringChar F'' ∣ k → IsUnit (k : Ay) := by
    intro k hpk
    have hcop : Nat.Coprime (ringChar F'') k := (Nat.Prime.coprime_iff_not_dvd hpprime).2 hpk
    have h0 := Nat.gcd_eq_gcd_ab (ringChar F'') k
    rw [Nat.Coprime.gcd_eq_one hcop] at h0
    have h1 := congrArg (Int.cast : ℤ → Ay) h0
    push_cast at h1
    rw [hcharA, zero_mul, zero_add] at h1
    exact ⟨⟨(k : Ay), _, h1.symm, by rw [mul_comm]; exact h1.symm⟩, rfl⟩
  have hcopQ : ∀ (K k : ℕ), ¬ ringChar F'' ∣ k → Nat.Coprime (Nat.card F'' ^ K) k := by
    intro K k hpk
    haveI := Fintype.ofFinite F''
    obtain ⟨r, _, hr⟩ := FiniteField.card F'' (ringChar F'')
    rw [Nat.card_eq_fintype_card, hr, ← pow_mul]
    exact Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hpprime).2 hpk)

  obtain ⟨S, hS⟩ : ∃ S : Set (Ty ⟶ Ty), ∀ m, m ∈ S ↔ (ρ m = id ∧
      wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f (wcLtdRing eLy eLy m.left)
        (RingHom.id Ly)) :=
    ⟨{m | ρ m = id ∧ wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f
      (wcLtdRing eLy eLy m.left) (RingHom.id Ly)}, fun m => Iff.rfl⟩
  have hS0 : 𝟙 Ty ∈ S := (hS _).2 ⟨hρi, hTT _ (fun w _ _ _ _ => hσid w)⟩
  have hS2 : ∀ a b : Ty ⟶ Ty, a ∈ S → b ∈ S → a ≫ b ∈ S := by
    intro a b ha hb
    obtain ⟨ha1, ha2⟩ := (hS a).1 ha
    obtain ⟨hb1, hb2⟩ := (hS b).1 hb
    refine (hS _).2 ⟨by simp only [hρc, ha1, hb1, Function.comp_id],
      hTT _ (fun w k hk hpk hw => ?_)⟩
    rw [hσc, hTT' b hb2 w k hk hpk hw, hTT' a ha2 w k hk hpk hw]

  have hS1 : ∀ (V' : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eB : V'.left ≅ Spec (.of B))
      (ι' : V' ⟶ Vy) (u' : Ty ⟶ V'), u' ≫ ι' = uy →
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι' ≫ vy).left (eB.inv (IsLocalRing.closedPoint B))) ∉ Δ →
      ∀ m : Ty ⟶ Ty, m ≫ u' = u' → m ∈ S := by
    intro V' B _ _ _ eB ι' u' hu' hoffpt m hm
    rw [hvyapp V' ι'] at hoffpt
    have hall : ∀ z : V'.left, V'.hom z ∉ Δ := by
      intro z hz
      have hsp : V'.hom (eB.inv (eB.hom z)) ⤳ V'.hom (eB.inv (IsLocalRing.closedPoint B)) := by
        have h1 := (IsLocalRing.specializes_closedPoint (eB.hom z)).map
          (Scheme.Hom.continuous eB.inv)
        exact h1.map (Scheme.Hom.continuous V'.hom)
      rw [hinvhom eB z] at hsp
      apply hoffpt
      rw [hVapp V' ι']
      exact hsp.mem_closed hΔc hz
    refine (hS m).2 ⟨hoff V' B eB ι' u' hu' hall m hm, hTT m (fun w k hk hpk hw => ?_)⟩
    have hfac := hψfac V' B eB ι' u' hu'
    have hunitf : IsUnit (wcLtdRing ey eB ι'.left f) := by
      apply IsLocalRing.notMem_maximalIdeal.1
      intro hmem
      have h1 : f ∈ (IsLocalRing.maximalIdeal B).comap (wcLtdRing ey eB ι'.left) := hmem
      rw [hcomapgen V' B eB ι'] at h1
      exact hoffpt ((hf _).2 h1)
    have hkB : IsUnit (k : B) := by
      have := (hunit k hpk).map (wcLtdRing ey eB ι'.left)
      rwa [map_natCast] at this
    obtain ⟨c, hc⟩ := (wc_pfam_ltd_tp_kummer B Ly (wcLtdRing eB eLy u'.left) k hk hkB).2.1
      (wcLtdRing ey eB ι'.left f) hunitf w
      (hw.trans (congrArg (fun φ : Ay →+* Ly => φ f) hfac))
    rw [← hc]
    exact hR1gen V' B eB u' m hm c

  have hS3 : ∀ τ : Ty ⟶ Ty, τ ≫ uy = uy →
      (∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vy) (eE : Ty ⟶ E),
        Etale πE.left → eE ≫ πE = uy →
        ∃ m ∈ S, m ≫ uy = uy ∧ m ≫ eE = τ ≫ eE) → τ ∈ S := by
    intro τ hτ Hyp
    refine (hS τ).2 ⟨?_, hTT τ (fun w k hk hpk hw => ?_)⟩
    · apply hcl τ hτ
      intro S₀
      obtain ⟨E, πE, eE, hEt, heE, hagr⟩ := wc_pfam_ltd_tp_nbhd Vy Ty uy Ay Ly ey eLy τ S₀
      obtain ⟨m, hmS, hmG, hmE⟩ := Hyp E πE eE hEt heE
      exact ⟨m, hmG, ((hS m).1 hmS).1, hagr m hmE⟩
    · obtain ⟨E, πE, eE, hEt, heE, hagr⟩ := wc_pfam_ltd_tp_nbhd Vy Ty uy Ay Ly ey eLy τ {w}
      obtain ⟨m, hmS, hmG, hmE⟩ := Hyp E πE eE hEt heE
      have h1 := hagr m hmE w (Finset.mem_singleton_self w)
      have h2 : wcLtdRing eLy eLy m.left w = w := hTT' m ((hS m).1 hmS).2 w k hk hpk hw
      rw [← h1, h2]

  have hS4 : ∀ τw : Ty ⟶ Ty, τw ≫ uξ = uξ →
      (∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vξ) (eE : Ty ⟶ E),
        Etale πE.left → eE ≫ πE = uξ →
        ∃ k : ℕ, (fun g : Ty ⟶ E => τw ≫ g)^[Nat.card F'' ^ k] eE = eE) →
      ∀ ρ₀ ρ₀' : Ty ⟶ Ty, ρ₀ ≫ uy = uy → ρ₀' ≫ uy = uy → ρ₀ ≫ ρ₀' = 𝟙 Ty → ρ₀' ≫ ρ₀ = 𝟙 Ty →
        ρ₀ ≫ τw ≫ ρ₀' ∈ S := by
    intro τw hτw Wild ρ₀ ρ₀' h₀ h₀' hi1 hi2
    have hτwG : τw ≫ uy = uy := by rw [← hιu, ← Category.assoc, hτw]
    have hW : ∀ (w : Ly) (k : ℕ), 0 < k → ¬ ringChar F'' ∣ k →
        w ^ k = wcLtdRing ey eLy uy.left f → wcLtdRing eLy eLy τw.left w = w := by
      intro w k hk hpk hw
      obtain ⟨E, πE, eE, hEt, heE, hagr⟩ :=
        wc_pfam_ltd_tp_nbhd Vξ Ty uξ A' Ly e' eLy (𝟙 Ty) {w}
      obtain ⟨K, hK⟩ := Wild E πE eE hEt heE
      have hit : ∀ N : ℕ, (fun g : Ty ⟶ E => τw ≫ g)^[N] eE =
          ((fun g : Ty ⟶ Ty => τw ≫ g)^[N] (𝟙 Ty)) ≫ eE := by
        intro N
        induction N with
        | zero => simp
        | succ N ih =>
          rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih]
          exact (Category.assoc _ _ _).symm
      have hσit : ∀ (N : ℕ) (x : Ly),
          wcLtdRing eLy eLy ((fun g : Ty ⟶ Ty => τw ≫ g)^[N] (𝟙 Ty)).left x =
            (⇑(wcLtdRing eLy eLy τw.left))^[N] x := by
        intro N
        induction N with
        | zero => intro x; exact hσid x
        | succ N ih =>
          intro x
          rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← ih x]
          exact hσc τw _ x
      have hXE : ((fun g : Ty ⟶ Ty => τw ≫ g)^[Nat.card F'' ^ K] (𝟙 Ty)) ≫ eE = 𝟙 Ty ≫ eE :=
        (hit _).symm.trans (hK.trans (Category.id_comp eE).symm)
      have h1 := hagr _ hXE w (Finset.mem_singleton_self w)
      have h2 : (⇑(wcLtdRing eLy eLy τw.left))^[Nat.card F'' ^ K] w = w :=
        (hσit _ w).symm.trans (h1.trans (hσid w))
      exact (wc_pfam_ltd_tp_kummer Ay Ly (wcLtdRing ey eLy uy.left) k hk (hunit k hpk)).2.2
        (wcLtdRing eLy eLy τw.left) (hR1gen Vy Ay ey uy τw hτwG) (wcLtdRing ey eLy uy.left f) w
        (Nat.card F'' ^ K) hw (hR1gen Vy Ay ey uy τw hτwG f) (hcopQ K k hpk) h2
    have htt := hTT (ρ₀ ≫ τw ≫ ρ₀') (fun w k hk hpk hw => by
      have hw₁ := htrans ρ₀' h₀' w k hw
      rw [hσc, hσc, hW _ k hk hpk hw₁, ← hσc ρ₀ ρ₀' w, hi1, hσid])
    have hu0 : (ρ₀ ≫ uξ) ≫ ι = uy := by rw [Category.assoc, hιu, h₀]
    have hc : (ρ₀ ≫ τw ≫ ρ₀') ≫ ρ₀ ≫ uξ = ρ₀ ≫ uξ := by
      simp only [Category.assoc]
      rw [reassoc_of% hi2, hτw]
    exact (hS _).2 ⟨hwild Vξ A' e' ι (ρ₀ ≫ uξ) hu0 hξ hξgen _ hc htt, htt⟩

  have htr : ∀ (τ m τ' : Ty ⟶ Ty), m ∈ S → τ' ≫ uξ = uξ → τ = m ≫ τ' →
      ∀ (w : Ly) (k : ℕ), 0 < k → ¬ ringChar F'' ∣ k → w ^ k = wcLtdRing ey eLy uy.left f →
      wcLtdRing eLy eLy τ.left w = wcLtdRing eLy eLy τ'.left w := by
    intro τ m τ' hm hτ' heq w k hk hpk hw
    have hτ'G : τ' ≫ uy = uy := by rw [← hιu, ← Category.assoc, hτ']
    subst heq
    rw [hσc]
    exact hTT' m ((hS m).1 hm).2 _ k hk hpk (htrans τ' hτ'G w k hw)
  have hρtr : ∀ (τ m τ' : Ty ⟶ Ty), m ∈ S → τ = m ≫ τ' → ρ τ = ρ τ' := by
    intro τ m τ' hm heq
    subst heq
    simp only [hρc, ((hS m).1 hm).1, Function.id_comp]
  obtain ⟨m₁, hm₁, τ₁', hτ₁', hτ₁eq⟩ :=
    wc_pfam_xi_tame_purity_surj F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy Ty uy vy Ay ey hy
      Ly eLy Vξ ι uξ A' e' hιu hΔξ hclξ S hS0 hS1 hS2 hS3 hS4 τ₁ h₁
  obtain ⟨m₂, hm₂, τ₂', hτ₂', hτ₂eq⟩ :=
    wc_pfam_xi_tame_purity_surj F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy Ty uy vy Ay ey hy
      Ly eLy Vξ ι uξ A' e' hιu hΔξ hclξ S hS0 hS1 hS2 hS3 hS4 τ₂ h₂

  obtain ⟨_, Φ, _, hΦmul, hΦ1, _, hΦsurj, hΦstab, _⟩ := wc_tps_dictionary Ty Vy Ly Ay eLy ey uy
  have hτ₂'G : τ₂' ≫ uy = uy := by rw [← hιu, ← Category.assoc, hτ₂']
  obtain ⟨g, hg⟩ := hΦsurj τ₂' hτ₂'G
  have hL : τ₂' ≫ Φ g⁻¹ = 𝟙 Ty := by rw [← hg, ← hΦmul, mul_inv_cancel, hΦ1]
  have hR : Φ g⁻¹ ≫ τ₂' = 𝟙 Ty := by rw [← hg, ← hΦmul, inv_mul_cancel, hΦ1]
  have hgfix := (hΦstab Vξ A' e' uξ g).1 (by rw [hg]; exact hτ₂')
  have hι₂H : Φ g⁻¹ ≫ uξ = uξ := by
    apply (hΦstab Vξ A' e' uξ g⁻¹).2
    intro r
    calc g⁻¹ (wcTpsRingOf eLy e' uξ r) = g⁻¹ (g (wcTpsRingOf eLy e' uξ r)) := by
          rw [hgfix r]
      _ = wcTpsRingOf eLy e' uξ r := by
          rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
  have hδH : (Φ g⁻¹ ≫ τ₁') ≫ uξ = uξ := by rw [Category.assoc, hτ₁', hι₂H]
  have hδTT := hTT (Φ g⁻¹ ≫ τ₁') (fun w k hk hpk hw => by
    have e1 := htr τ₁ m₁ τ₁' hm₁ hτ₁' hτ₁eq w k hk hpk hw
    have e2 := htr τ₂ m₂ τ₂' hm₂ hτ₂' hτ₂eq w k hk hpk hw
    have e3 : wcLtdRing eLy eLy τ₁.left w = wcLtdRing eLy eLy τ₂.left w := hag w k hk hpk hw
    rw [hσc, ← e1, e3, e2, ← hσc (Φ g⁻¹) τ₂' w, hR, hσid])
  have hρδ := hwξ uξ hιu _ hδH hδTT
  have hτ₁'eq : τ₁' = τ₂' ≫ (Φ g⁻¹ ≫ τ₁') := by rw [← Category.assoc, hL, Category.id_comp]
  rw [hρtr τ₁ m₁ τ₁' hm₁ hτ₁eq, hρtr τ₂ m₂ τ₂' hm₂ hτ₂eq, hτ₁'eq, hρc, hρδ, Function.comp_id]

theorem wc_pfam_local_tame_decomp (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) (j : Fin D.m)
    (Vy Vx Ty : (wcProjK F'' M').ProEt)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (vx : Vx ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (uyx : Vx ⟶ Vy) (uy' : Ty ⟶ Vx) (hvx : uyx ≫ vy = vx)
    (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    [IsSepClosed (IsLocalRing.ResidueField Ay)] (ey : Vy.left ≅ Spec (.of Ay))
    (Ax : Type u) [CommRing Ax] [HenselianLocalRing Ax]
    [IsSepClosed (IsLocalRing.ResidueField Ax)] (ex : Vx.left ≅ Spec (.of Ax))
    (Ly : Type u) [Field Ly] [IsSepClosed Ly] (eLy : Ty.left ≅ Spec (.of Ly))
    (hy : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (hoffx : ∀ z : Vx.left, Vx.hom z ∉ Δ)
    (t₀ : (wcP1Over F'').left) (ht₀ : closure {t₀} = Set.univ)
    (hx : Vx.hom (ex.inv (IsLocalRing.closedPoint Ax)) = lam t₀) :
    ∀ τ' : Ty ⟶ Ty, τ' ≫ uy' ≫ uyx = uy' ≫ uyx →
      ∃ (α : Vx ⟶ Vx) (τ'' : Ty ⟶ Ty), α ≫ uyx = uyx ∧ τ'' ≫ uy' = uy' ≫ α ∧
        ∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
          ((wcRq h ℓ (n - 1)).obj.map τ''.op).hom s = ((wcRq h ℓ (n - 1)).obj.map τ'.op).hom s :=
by
  classical
  intro τ' hτ'
  obtain ⟨f, hf⟩ := wc_pfam_ltd_f_exists F' F'' Y n D M' Xu h Δ lam p hH j Vy Ay ey hy
  obtain ⟨α, τ'', hαu, hτ''u, hagree⟩ := wc_pfam_ltd_transversal F' F'' Y n D M' Xu h Δ lam p
    hH j Vy Vx Ty uyx uy' Ay ey Ax ex Ly eLy hy t₀ ht₀ hx f hf τ' hτ'
  refine ⟨α, τ'', hαu, hτ''u, ?_⟩
  have hτ''G : τ'' ≫ uy' ≫ uyx = uy' ≫ uyx := by
    rw [← Category.assoc, hτ''u, Category.assoc, hαu]

  have hsub : ∀ x y : Ty.left, x = y := by
    intro x y
    have h1 : eLy.hom x = eLy.hom y :=
      @Subsingleton.elim (PrimeSpectrum Ly) inferInstance (eLy.hom x) (eLy.hom y)
    have hx' : eLy.inv (eLy.hom x) = x := by simp
    have hy' : eLy.inv (eLy.hom y) = y := by simp
    rw [← hx', ← hy', h1]

  have hnat : ∀ {X₁ X₂ : (wcProjK F'' M').ProEt} (g : X₁ ⟶ X₂) (b : X₂ ⟶ Ω.W')
      (b' : X₁ ⟶ Ω.W'), g ≫ b = b' →
      ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op X₂)) (z : X₁.left),
      (show C(↥X₁.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b'))).hom
          (((wcRq h ℓ (n - 1)).obj.map g.op).hom s)).down) z =
      (show C(↥X₂.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom s).down) (g.left z) := by
    intro X₁ X₂ g b b' hgb s z
    subst hgb
    have e := congrArg (fun m => m.hom s)
      (Ω.θ'.hom.hom.naturality (Over.homMk g : Over.mk (g ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun y : ULift.{u+1} C(↥X₁.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) e
  have hcancel : ∀ (T' : Over Ω.W')
      (s : ((wcRq h ℓ (n - 1)).over Ω.W').obj.obj (Opposite.op T')),
      (Ω.θ'.inv.hom.app (Opposite.op T')).hom ((Ω.θ'.hom.hom.app (Opposite.op T')).hom s) = s :=
    fun T' s => congrArg (fun m => (m.hom.app (Opposite.op T')).hom s) Ω.θ'.hom_inv_id
  let ρ : (Ty ⟶ Ty) → (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →
      (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) :=
    fun τ s => ((wcRq h ℓ (n - 1)).obj.map τ.op).hom s
  have hρc : ∀ a b : Ty ⟶ Ty, ρ (a ≫ b) = ρ a ∘ ρ b := by
    intro a b
    funext s
    show ((wcRq h ℓ (n - 1)).obj.map (a ≫ b).op).hom s =
      ((wcRq h ℓ (n - 1)).obj.map a.op).hom (((wcRq h ℓ (n - 1)).obj.map b.op).hom s)
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have hρi : ρ (𝟙 Ty) = id := by
    funext s
    show ((wcRq h ℓ (n - 1)).obj.map (𝟙 Ty).op).hom s = s
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have hoff : ∀ (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eZ : Z.left ≅ Spec (.of B))
      (ιZ : Z ⟶ Vy) (uZ : Ty ⟶ Z), uZ ≫ ιZ = uy' ≫ uyx → (∀ z : Z.left, Z.hom z ∉ Δ) →
      ∀ τ : Ty ⟶ Ty, τ ≫ uZ = uZ → ρ τ = id := by
    intro Z B _ _ _ eZ ιZ uZ _ hZ τ hτ
    obtain ⟨ψ, _⟩ := wc_pfam_strict_local_lift M' h Δ ℓ (n - 1) hPP Ω Z B eZ (ιZ ≫ vy) hZ
    funext s
    have hc : τ ≫ (uZ ≫ ψ) = uZ ≫ ψ := by rw [← Category.assoc, hτ]
    have e1 : (Ω.θ'.hom.hom.app (Opposite.op (Over.mk (uZ ≫ ψ)))).hom
          (((wcRq h ℓ (n - 1)).obj.map τ.op).hom s) =
        (Ω.θ'.hom.hom.app (Opposite.op (Over.mk (uZ ≫ ψ)))).hom s := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      refine (hnat τ (uZ ≫ ψ) (uZ ≫ ψ) hc s z).trans ?_
      rw [hsub (τ.left z) z]
      rfl
    have e2 := congrArg (Ω.θ'.inv.hom.app (Opposite.op (Over.mk (uZ ≫ ψ)))).hom e1
    exact (hcancel (Over.mk (uZ ≫ ψ)) (((wcRq h ℓ (n - 1)).obj.map τ.op).hom s)).symm.trans
      (e2.trans (hcancel (Over.mk (uZ ≫ ψ)) s))

  have hwild : ∀ (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eZ : Z.left ≅ Spec (.of B))
      (ιZ : Z ⟶ Vy) (uZ : Ty ⟶ Z), uZ ≫ ιZ = uy' ≫ uyx →
      f ∈ (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal →
      (∀ q : PrimeSpectrum Ay, f ∈ q.asIdeal →
        (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal ≤ q.asIdeal) →
      ∀ τ : Ty ⟶ Ty, τ ≫ uZ = uZ →
      wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy (uy' ≫ uyx).left) f
        (wcLtdRing eLy eLy τ.left) (RingHom.id Ly) → ρ τ = id := by
    intro Z B _ _ _ eZ ιZ uZ huZ hξ hξgen τ hτ hτw
    funext s
    exact wc_pfam_ltd_wild_trivial F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH j Vy Ty
      (uy' ≫ uyx) Ay ey Ly eLy hy f hf Z B eZ ιZ uZ huZ hξ hξgen τ hτ hτw s

  have hcl : ∀ τ : Ty ⟶ Ty, τ ≫ uy' ≫ uyx = uy' ≫ uyx →
      (∀ S : Finset Ly, ∃ m : Ty ⟶ Ty, m ≫ uy' ≫ uyx = uy' ≫ uyx ∧
        ρ m = id ∧ ∀ w ∈ S, wcLtdRing eLy eLy m.left w = wcLtdRing eLy eLy τ.left w) →
      ρ τ = id := by
    intro τ hτ hS
    funext s
    exact wc_pfam_ltd_kernel_closed F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH Vy Ty (uy' ≫ uyx)
      Ly eLy τ hτ (fun S => by
        obtain ⟨m, hm1, hm2, hm3⟩ := hS S
        exact ⟨m, hm1, fun s => congrFun hm2 s, hm3⟩) s
  have hR := wc_pfam_ltd_tame_purity F' F'' Y n D M' Xu h Δ lam p hH j Vy Ty (uy' ≫ uyx) Ay ey
    Ly eLy hy f hf ρ hρc hρi hoff hwild hcl τ'' τ' hτ''G hτ' hagree
  intro s
  exact congrFun hR s

theorem wc_pfam_line_local_inertia (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (β : wcPfamLineBeta D ℓ h lam) (hβ : wcPfamLineBC π Ω lam β)
    (j : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S j (IsLocalRing.closedPoint F''))
    (T : (wcP1Over F'').left.ProEt) (u : T ⟶ V) (c : T ⟶ π.W)
    (L : Type u) [Field L] [IsSepClosed L] (eL : T.left ≅ Spec (.of L))
    (hc : u ≫ v = c ≫ π.w) :
    ∃ (T₁ : (wcP1Over F'').left.ProEt) (a₁ : T₁ ⟶ π.W) (b₁ : T₁.left ⟶ Ω.W'.left)
      (hb₁ : b₁ ≫ Ω.W'.hom = T₁.hom ≫ lam)
      (M₁ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamLineCmp π Ω lam β T₁ a₁ b₁ hb₁ M₁ ∧
      ∃ (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy) (cy : Ty ⟶ Ω.W'),
        wcPfamPtAt Ω (lam (D.S j (IsLocalRing.closedPoint F''))) uy cy ∧
        ∀ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]), g ∈ wcPLInertFr π u c ↔
          (M₁.toLinearMap ∘ₗ g ∘ₗ M₁.symm.toLinearMap) ∈ wcPfamInertFr Ω uy cy :=
by
  classical
  haveI := π.hconn
  haveI := Ω.hconn'
  have hH0 := hH
  obtain ⟨_, _, _, _, hΔ, _, _, hlam, hlamstr, _, _, hS, _⟩ := hH0

  have hTc : ConnectedSpace T.left := by
    have hsub : ∀ x y : T.left, x = y := by
      intro x y
      have h1 : eL.hom x = eL.hom y :=
        @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
      have hx : eL.inv (eL.hom x) = x := by simp
      have hy : eL.inv (eL.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    haveI : Nonempty T.left := ⟨eL.inv (IsLocalRing.closedPoint L)⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun x _ y _ => hsub x y)⟩
  have hoffT : ∀ (z : T.left) (i : Fin D.m), T.hom z ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro z i hz
    apply π.hoff (c.left z) i
    have e : T.hom z = π.W.hom (c.left z) := by
      rw [← MorphismProperty.Over.w c]
      rfl
    rw [← e]
    exact hz

  have hnat : ∀ {S : Scheme.{u}} {G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      {W : S.ProEt} {k : ℕ} (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
      {X₁ X₂ : S.ProEt} (f : X₁ ⟶ X₂) (b : X₂ ⟶ W) (b' : X₁ ⟶ W), f ≫ b = b' →
      ∀ (s : G.obj.obj (Opposite.op X₂)) (z : X₁.left),
      (show C(↥X₁.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b'))).hom ((G.obj.map f.op).hom s)).down) z =
      (show C(↥X₂.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom s).down) (f.left z) := by
    intro S G W k θ X₁ X₂ f b b' hfb s z
    subst hfb
    have e := congrArg (fun m => m.hom s)
      (θ.hom.hom.naturality (Over.homMk f : Over.mk (f ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun y : ULift.{u+1} C(↥X₁.left, Fin k → ℚ_[ℓ]) => y.down z) e

  have hEx : ∀ σ : π.W ⟶ π.W, ∃ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      wcHonestFrame D ℓ π.W π.r π.θ σ g := by
    intro σ
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
      π.W π.hconn π.r π.θ σ
    exact ⟨A, fun s z => hA π.W (𝟙 π.W) σ (Category.id_comp σ).symm s z⟩

  have hEx' : ∀ σ' : Ω.W' ⟶ Ω.W', ∃ g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
      wcPfamFrame Ω σ' g' := by
    intro σ'
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1))
      Ω.W' Ω.hconn' Ω.r' Ω.θ' σ'
    exact ⟨A, fun s z => hA Ω.W' (𝟙 Ω.W') σ' (Category.id_comp σ').symm s z⟩
  have hcancel1' : ∀ (T' : Over Ω.W')
      (s : ((wcRq h ℓ (n - 1)).over Ω.W').obj.obj (Opposite.op T')),
      (Ω.θ'.inv.hom.app (Opposite.op T')).hom ((Ω.θ'.hom.hom.app (Opposite.op T')).hom s) = s :=
    fun T' s => congrArg (fun m => (m.hom.app (Opposite.op T')).hom s) Ω.θ'.hom_inv_id
  have hcancel2' : ∀ (T' : Over Ω.W')
      (x : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op T')),
      (Ω.θ'.hom.hom.app (Opposite.op T')).hom ((Ω.θ'.inv.hom.app (Opposite.op T')).hom x) = x :=
    fun T' x => congrArg (fun m => (m.hom.app (Opposite.op T')).hom x) Ω.θ'.inv_hom_id
  obtain ⟨z₀⟩ : Nonempty Ω.W'.left := @ConnectedSpace.toNonempty _ _ Ω.hconn'
  have hconst' : ∀ v : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W'),
      ∀ z : Ω.W'.left, (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z = v := by
    intro v
    let x : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom x, fun z => ?_⟩
    have hs := hcancel2' (Over.mk (𝟙 Ω.W')) x
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) hs
  have hFE' : ∀ (σ' : Ω.W' ⟶ Ω.W') (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamFrame Ω σ' g' →
      Function.Injective g' ∧ ∀ (X : (wcProjK F'' M').ProEt) (b : X ⟶ Ω.W')
        (t : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op X)) (z : X.left),
        (show C(↥X.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (b ≫ σ')))).hom t).down) z =
        g' ((show C(↥X.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z) := by
    intro σ' g' hg'
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1))
      Ω.W' Ω.hconn' Ω.r' Ω.θ' σ'
    have hAg : ∀ v, A v = g' v := by
      intro v
      obtain ⟨s, hs⟩ := hconst' v
      have k1 := hA Ω.W' (𝟙 Ω.W') σ' (Category.id_comp σ').symm s z₀
      rw [hg' s z₀, hs z₀] at k1
      exact k1.symm
    refine ⟨?_, fun X b t z => (hA X b (b ≫ σ') rfl t z).trans (hAg _)⟩
    rw [injective_iff_map_eq_zero]
    intro v hv
    obtain ⟨s, hs⟩ := hconst' v
    obtain ⟨s0, hs0⟩ := hconst' 0
    have e : (Ω.θ'.hom.hom.app (Opposite.op (Over.mk σ'))).hom s =
        (Ω.θ'.hom.hom.app (Opposite.op (Over.mk σ'))).hom s0 := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      have h1 := hg' s z
      have h2 := hg' s0 z
      rw [hs z, hv] at h1
      rw [hs0 z, map_zero] at h2
      exact h1.trans h2.symm
    have e2 : s = s0 := by
      have := congrArg (Ω.θ'.inv.hom.app (Opposite.op (Over.mk σ'))).hom e
      exact (hcancel1' (Over.mk σ') s).symm.trans (this.trans (hcancel1' (Over.mk σ') s0))
    have h3 := hs z₀
    rw [e2, hs0 z₀] at h3
    exact h3.symm

  obtain ⟨Vy, Vx, Ty, vy, vx, uyx, uy', Ay, _, _, _, ey, Ax, _, _, _, ex, Ly, _, _, eLy, tx,
      h1, h2, h3, h4, h5, hVxc, h6, h7, h8, t₀, ht₀, h9⟩ :=
    wc_pfam_yj_local_nbhds F'' hP M' hPP lam hlam hlamstr Δ hΔ D.m D.S hS j V v A e hV T u L eL
      hoffT

  obtain ⟨ψ, hψ⟩ := wc_pfam_strict_local_lift M' h Δ ℓ (n - 1) hPP Ω Vx Ax ex vx h5
  have hb₁ : (tx ≫ ψ.left) ≫ Ω.W'.hom = T.hom ≫ lam := by
    rw [Category.assoc, MorphismProperty.Over.w ψ]
    exact h3
  obtain ⟨M₁, hM₁⟩ := hβ.2.2 T c (tx ≫ ψ.left) hb₁ hTc (by
    have e1 : ψ.left ≫ Ω.w'.left = vx.left := congrArg (fun f => f.left) hψ
    have e2 : u.left ≫ v.left = c.left ≫ π.w.left := congrArg (fun f => f.left) hc
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _) e2.symm).trans
      ((Category.assoc _ _ _).trans (h4.symm.trans ((congrArg (fun f => tx ≫ f ≫ _) e1.symm).trans
        (congrArg (tx ≫ ·) (Category.assoc _ _ _)))))))
  have hβcongr : ∀ (b b' : T.left ⟶ Ω.W'.left) (hb : b ≫ Ω.W'.hom = T.hom ≫ lam)
      (hb' : b' ≫ Ω.W'.hom = T.hom ≫ lam) (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')),
      b = b' → β Ω.W' T b hb s = β Ω.W' T b' hb' s := by
    rintro b b' hb hb' s rfl
    rfl

  have hK : ∀ (τ : T ⟶ T) (σ : π.W ⟶ π.W) (σ' : Ω.W' ⟶ Ω.W')
      (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]))
      (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      σ ≫ π.w = π.w → τ ≫ c = c ≫ σ → τ.left ≫ (tx ≫ ψ.left) = (tx ≫ ψ.left) ≫ σ'.left →
      wcHonestFrame D ℓ π.W π.r π.θ σ g → wcPfamFrame Ω σ' g' →
      ∀ x, g' (M₁ x) = M₁ (g x) := by
    intro τ σ σ' g g' hσ hτc hτb hg hg' x
    obtain ⟨hgbij, hgext⟩ := wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π σ hσ g hg
    obtain ⟨s0, hs0⟩ := hconst' (M₁ (g x))
    have hb' : ((tx ≫ ψ.left) ≫ σ'.left) ≫ Ω.W'.hom = T.hom ≫ lam := by
      rw [Category.assoc, MorphismProperty.Over.w σ']
      exact hb₁
    have hb'' : (τ.left ≫ (tx ≫ ψ.left)) ≫ Ω.W'.hom = T.hom ≫ lam := by
      rw [hτb]
      exact hb'
    have eβ : β Ω.W' T (tx ≫ ψ.left) hb₁ (((wcRq h ℓ (n - 1)).obj.map σ'.op).hom s0) =
        ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom (β Ω.W' T (tx ≫ ψ.left) hb₁ s0) := by
      rw [hβ.2.1 Ω.W' Ω.W' σ' T (tx ≫ ψ.left) hb₁ hb' s0,
        hβ.1 Ω.W' T T τ (tx ≫ ψ.left) hb₁ hb'' s0]
      exact hβcongr _ _ _ _ _ hτb.symm
    let pt : T.left := eL.inv (IsLocalRing.closedPoint L)
    have A1 := hM₁.2.2 (((wcRq h ℓ (n - 1)).obj.map σ'.op).hom s0) pt
    rw [eβ] at A1
    have A2 := hg' (((wcRq h ℓ (n - 1)).obj.map σ'.op).hom s0) ((tx ≫ ψ.left) pt)
    have A3 := hnat Ω.θ' σ' (𝟙 Ω.W') σ' (Category.comp_id σ') s0 ((tx ≫ ψ.left) pt)
    have Q := (congrArg g' A1).symm.trans (A2.symm.trans (A3.trans (hs0 _)))
    have P1 := hgext T c (((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom
      (β Ω.W' T (tx ≫ ψ.left) hb₁ s0)) pt
    have P2 := hnat π.θ τ c (c ≫ σ) hτc (β Ω.W' T (tx ≫ ψ.left) hb₁ s0) pt
    have P3 := hM₁.2.2 s0 (τ.left pt)
    have P4 := M₁.injective (P3.symm.trans (hs0 _))
    have hX := hgbij.1 (P1.symm.trans (P2.trans P4))
    exact (congrArg (fun y => g' (M₁ y)) hX).symm.trans Q

  have hQ : ∀ (τa τb : Ty ⟶ Ty) (sa sb : Ω.W' ⟶ Ω.W')
      (ga gb : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      τa ≫ (uy' ≫ ψ) = (uy' ≫ ψ) ≫ sa → τb ≫ (uy' ≫ ψ) = (uy' ≫ ψ) ≫ sb →
      (∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
        ((wcRq h ℓ (n - 1)).obj.map τa.op).hom s = ((wcRq h ℓ (n - 1)).obj.map τb.op).hom s) →
      wcPfamFrame Ω sa ga → wcPfamFrame Ω sb gb → ∀ y, ga y = gb y := by
    intro τa τb sa sb ga gb hτa hτb hR hfa hfb y
    obtain ⟨hinja, hexta⟩ := hFE' sa ga hfa
    obtain ⟨_, hextb⟩ := hFE' sb gb hfb
    obtain ⟨s, hs⟩ := hconst' (ga y)
    let pty : Ty.left := eLy.inv (IsLocalRing.closedPoint Ly)
    have hw := fun z => (hnat Ω.θ' (uy' ≫ ψ) (𝟙 Ω.W') (uy' ≫ ψ) (Category.comp_id _) s z).trans
      (hs _)
    have Ea := hexta Ty (uy' ≫ ψ) (((wcRq h ℓ (n - 1)).obj.map τa.op).hom
      (((wcRq h ℓ (n - 1)).obj.map (uy' ≫ ψ).op).hom s)) pty
    have Na := hnat Ω.θ' τa (uy' ≫ ψ) ((uy' ≫ ψ) ≫ sa) hτa
      (((wcRq h ℓ (n - 1)).obj.map (uy' ≫ ψ).op).hom s) pty
    have hY := hinja (Ea.symm.trans (Na.trans (hw _)))
    have Eb := hextb Ty (uy' ≫ ψ) (((wcRq h ℓ (n - 1)).obj.map τb.op).hom
      (((wcRq h ℓ (n - 1)).obj.map (uy' ≫ ψ).op).hom s)) pty
    have Nb := hnat Ω.θ' τb (uy' ≫ ψ) ((uy' ≫ ψ) ≫ sb) hτb
      (((wcRq h ℓ (n - 1)).obj.map (uy' ≫ ψ).op).hom s) pty
    have hb := Eb.symm.trans (Nb.trans (hw _))
    rw [← hR] at hb
    exact ((congrArg gb hY).symm.trans hb).symm

  have hdeck : ∀ α : Vx ⟶ Vx, α ≫ uyx = uyx →
      ∃ s' : Ω.W' ⟶ Ω.W', s' ≫ Ω.w' = Ω.w' ∧ α ≫ ψ = ψ ≫ s' := by
    intro α hαu
    refine Ω.hgal' Vx ψ (α ≫ ψ) hVxc ?_
    rw [hψ, Category.assoc, hψ, ← h1, ← Category.assoc, hαu]
  have hτb_of : ∀ (τ : T ⟶ T) (α : Vx ⟶ Vx) (s' : Ω.W' ⟶ Ω.W'),
      τ.left ≫ tx = tx ≫ α.left → α ≫ ψ = ψ ≫ s' →
      τ.left ≫ (tx ≫ ψ.left) = (tx ≫ ψ.left) ≫ s'.left := by
    intro τ α s' hτα hαψ
    rw [← Category.assoc, hτα, Category.assoc, Category.assoc]
    exact congrArg (fun f => tx ≫ f.left) hαψ
  have hτc_of : ∀ (τ'' : Ty ⟶ Ty) (α : Vx ⟶ Vx) (s' : Ω.W' ⟶ Ω.W'),
      τ'' ≫ uy' = uy' ≫ α → α ≫ ψ = ψ ≫ s' → τ'' ≫ (uy' ≫ ψ) = (uy' ≫ ψ) ≫ s' := by
    intro τ'' α s' hτ'' hαψ
    calc τ'' ≫ (uy' ≫ ψ) = (τ'' ≫ uy') ≫ ψ := (Category.assoc _ _ _).symm
      _ = (uy' ≫ α) ≫ ψ := by rw [hτ'']
      _ = uy' ≫ (α ≫ ψ) := Category.assoc _ _ _
      _ = uy' ≫ (ψ ≫ s') := by rw [hαψ]
      _ = (uy' ≫ ψ) ≫ s' := (Category.assoc _ _ _).symm
  refine ⟨T, c, tx ≫ ψ.left, hb₁, M₁, hM₁, Vy, Ty, uy' ≫ uyx, uy' ≫ ψ,
    ⟨vy, Ay, inferInstance, inferInstance, inferInstance, ey, Ly, inferInstance, inferInstance,
      eLy, by rw [Category.assoc, h1, Category.assoc, hψ], h2⟩, ?_⟩
  intro g
  constructor
  · rintro ⟨τ, σ, hτu, hσ, hτc, hfr⟩
    obtain ⟨α, hαu, hτα⟩ := h7 τ hτu
    obtain ⟨s', hs', hαψ⟩ := hdeck α hαu
    obtain ⟨τ'', hτ''⟩ := h8 α hαu
    obtain ⟨g'', hg''⟩ := hEx' s'
    have hK1 := hK τ σ s' g g'' hσ hτc (hτb_of τ α s' hτα hαψ) hfr hg''
    refine ⟨τ'', s', ?_, hs', hτc_of τ'' α s' hτ'' hαψ, ?_⟩
    · rw [← Category.assoc, hτ'', Category.assoc, hαu]
    · intro s z
      rw [hg'' s z]
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
      rw [← hK1, LinearEquiv.apply_symm_apply]
  · rintro ⟨τ', s', hτ'u, hs', hτ'c, hfr'⟩
    obtain ⟨α, τ'', hαu, hτ''u, hR⟩ := wc_pfam_local_tame_decomp F' F'' Y n hn hn2 D ℓ hℓ M' Xu h
      Δ lam p hH hPP Ω j Vy Vx Ty vy vx uyx uy' h1 Ay ey Ax ex Ly eLy h2 h5 t₀ ht₀ h9 τ' hτ'u
    obtain ⟨s'', hs'', hαψ⟩ := hdeck α hαu
    obtain ⟨g'', hg''⟩ := hEx' s''
    have hQ1 := hQ τ'' τ' s'' s' g'' _ (hτc_of τ'' α s'' hτ''u hαψ) hτ'c hR hg'' hfr'
    obtain ⟨τ, hτu, hτα⟩ := h6 α hαu
    obtain ⟨σ, hσ, hσeq⟩ := hgal T c (τ ≫ c) hTc (by
      rw [Category.assoc, ← hc, ← Category.assoc, hτu])
    obtain ⟨g0, hg0⟩ := hEx σ
    have hK2 := hK τ σ s'' g0 g'' hσ hσeq (hτb_of τ α s'' hτα hαψ) hg0 hg''
    have hgg : g = g0 := by
      apply LinearMap.ext
      intro x
      apply M₁.injective
      have := (hQ1 (M₁ x)).symm.trans (hK2 x)
      simpa using this
    refine ⟨τ, σ, hτu, hσ, hσeq, ?_⟩
    rw [hgg]
    exact hg0

theorem wc_pfam_line_compare (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) :
    ∃ M : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
      (∀ (σ' : Ω.W' ⟶ Ω.W') (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        σ' ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ' g' →
        ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧
          wcHonestFrame D ℓ π.W π.r π.θ σ (M.symm.toLinearMap ∘ₗ g' ∘ₗ M.toLinearMap)) ∧
      ∀ (j : Fin D.m) (V : (wcP1Over F'').left.ProEt)
        (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S j (IsLocalRing.closedPoint F'') →
        ∀ (T : (wcP1Over F'').left.ProEt) (u : T ⟶ V) (c : T ⟶ π.W)
          (L : Type u) [Field L] [IsSepClosed L] (eL : T.left ≅ Spec (.of L)),
          u ≫ v = c ≫ π.w →
          ∃ (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy) (cy : Ty ⟶ Ω.W'),
            wcPfamPtAt Ω (lam (D.S j (IsLocalRing.closedPoint F''))) uy cy ∧
            ∀ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]), g ∈ wcPLInertFr π u c ↔
              (M.toLinearMap ∘ₗ g ∘ₗ M.symm.toLinearMap) ∈ wcPfamInertFr Ω uy cy :=
by
  obtain ⟨β, T₀, a₀, b₀, hb₀, M₀, hβ, hM₀⟩ :=
    wc_pfam_line_bc F' F'' Y n hn hn2 D ℓ hℓ hP π hgal M' Xu h Δ lam p hH hPP Ω
  refine ⟨M₀, wc_pfam_line_monodromy_surj F' F'' Y n hn hn2 D ℓ hℓ hP π hgal M' Xu h Δ lam p hH
    hPP Ω β hβ T₀ a₀ b₀ hb₀ M₀ hM₀, ?_⟩
  intro j V v A _ _ _ e hV T u c L _ _ eL hc
  obtain ⟨T₁, a₁, b₁, hb₁, M₁, hM₁, Vy, Ty, uy, cy, hpt, hiff⟩ :=
    wc_pfam_line_local_inertia F' F'' Y n hn hn2 D ℓ hℓ hP π hgal M' Xu h Δ lam p hH hPP Ω
      β hβ j V v A e hV T u c L eL hc
  obtain ⟨κ, hκ, hre⟩ :=
    wc_pfam_line_rebase F' F'' Y n hn hn2 D ℓ hℓ hP π hgal M' Xu h Δ lam p hH hPP Ω
      β hβ T₀ a₀ b₀ hb₀ M₀ hM₀ T₁ a₁ b₁ hb₁ M₁ hM₁
  refine ⟨Vy, Ty, uy, cy ≫ κ, ?_, fun g => (hiff g).trans (hre Vy Ty uy cy g)⟩
  obtain ⟨v', A', i1, i2, i3, e', L', i4, i5, eT, h1, h2⟩ := hpt
  exact ⟨v', A', i1, i2, i3, e', L', i4, i5, eT, by rw [h1, Category.assoc, hκ], h2⟩

theorem wc_pfam_xi_offdelta_lift {F'' : Type u} [Field F''] (M' : ℕ) {X : Scheme.{u}}
    (h : X ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ q hPP) (V' : (wcProjK F'' M').ProEt)
    (v' : V' ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (eB : V'.left ≅ Spec (.of B))
    (hoff : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (v'.left (eB.inv (IsLocalRing.closedPoint B))) ∉ Δ) :
    ∃ b : V' ⟶ Ω.W', b ≫ Ω.w' = v' :=
by
  classical
  obtain ⟨z, hz⟩ := Ω.hcov' (v'.left (eB.inv (IsLocalRing.closedPoint B))) hoff
  haveI h1 : WeaklyEtale (Ω.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [MorphismProperty.Over.w Ω.w']; exact Ω.W'.prop
  haveI h2 : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  have hw : WeaklyEtale Ω.w'.left :=
    WeaklyEtale.of_comp Ω.w'.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  have hq : WeaklyEtale (Limits.pullback.fst v'.left Ω.w'.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback v'.left Ω.w'.left).flip hw
  obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := v'.left) (g := Ω.w'.left)
    (eB.inv (IsLocalRing.closedPoint B)) z hz.symm
  haveI : WeaklyEtale (Limits.pullback.fst v'.left Ω.w'.left) := hq
  haveI : WeaklyEtale ((Limits.pullback v'.left Ω.w'.left).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback v'.left Ω.w'.left).fromSpecStalk t ≫
      Limits.pullback.fst v'.left Ω.w'.left ≫ eB.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback v'.left Ω.w'.left).presheaf.stalk t)) =
      IsLocalRing.closedPoint B := by
    have h1 : k (IsLocalRing.closedPoint ((Limits.pullback v'.left Ω.w'.left).presheaf.stalk t)) =
        eB.hom ((Limits.pullback.fst v'.left Ω.w'.left)
          ((Limits.pullback v'.left Ω.w'.left).fromSpecStalk t
          (IsLocalRing.closedPoint ((Limits.pullback v'.left Ω.w'.left).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    have h2 : ∀ y : Spec (CommRingCat.of B), eB.hom (eB.inv y) = y := by
      intro y
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, eB.inv_hom_id]; rfl)
        | exact congrArg (fun f : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of B) => f y)
            eB.inv_hom_id
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    first
      | exact h2 _
      | simp
      | exact congrArg (fun f : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of B) => f _)
          eB.inv_hom_id
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint ((Limits.pullback v'.left Ω.w'.left).presheaf.stalk t)) =
      IsLocalRing.closedPoint B := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint ((Limits.pullback v'.left Ω.w'.left).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint ((Limits.pullback v'.left Ω.w'.left).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance
  have hcq : (Limits.pullback v'.left Ω.w'.left).fromSpecStalk t ≫
      Limits.pullback.fst v'.left Ω.w'.left = k ≫ eB.inv := by
    rw [hkdef]; simp
  obtain ⟨s, hs⟩ : ∃ s : V'.left ⟶ Limits.pullback v'.left Ω.w'.left,
      s ≫ Limits.pullback.fst v'.left Ω.w'.left = 𝟙 _ :=
    ⟨eB.hom ≫ inv k ≫ (Limits.pullback v'.left Ω.w'.left).fromSpecStalk t, by
      rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩
  have hfw : (s ≫ Limits.pullback.snd v'.left Ω.w'.left) ≫ Ω.w'.left = v'.left := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
  have hh : (s ≫ Limits.pullback.snd v'.left Ω.w'.left) ≫ Ω.W'.hom = V'.hom := by
    rw [← MorphismProperty.Over.w Ω.w', ← Category.assoc, hfw, MorphismProperty.Over.w v']
  refine ⟨MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd v'.left Ω.w'.left) hh trivial,
    MorphismProperty.Over.Hom.ext ?_⟩
  show (s ≫ Limits.pullback.snd v'.left Ω.w'.left) ≫ Ω.w'.left = v'.left
  exact hfw

theorem wc_axc_sep_witness (A L : Type u) [CommRing A] [Field L] (φ : A →+* L) (b : L)
    (hb : ∃ f : Polynomial A, f.map φ ≠ 0 ∧ f.eval₂ φ b = 0) :
    ∃ (H : Polynomial A) (c : A) (k : ℕ), H.Monic ∧ φ c ≠ 0 ∧
      H.eval₂ φ (φ c * b ^ (ringExpChar L ^ k)) = 0 ∧
      (Polynomial.derivative H).eval₂ φ (φ c * b ^ (ringExpChar L ^ k)) ≠ 0 :=
by
  classical
  obtain ⟨f, hf, hfb⟩ := hb
  obtain ⟨p, hp⟩ : ∃ p, ringExpChar L = p := ⟨_, rfl⟩
  rw [hp]
  haveI hexp : ExpChar L p := ringExpChar.of_eq hp
  have hp0 : p ≠ 0 := expChar_ne_zero L p

  have descent : ∀ m : ℕ, ∀ (G : Polynomial A) (k : ℕ), G.map φ ≠ 0 →
      (G.map φ).natDegree = m → G.eval₂ φ (b ^ (p ^ k)) = 0 →
      ∃ (G : Polynomial A) (k : ℕ), G.eval₂ φ (b ^ (p ^ k)) = 0 ∧
        (Polynomial.derivative G).eval₂ φ (b ^ (p ^ k)) ≠ 0 := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      intro G k hG hm hroot
      by_cases hd : (Polynomial.derivative G).eval₂ φ (b ^ (p ^ k)) ≠ 0
      · exact ⟨G, k, hroot, hd⟩
      push_neg at hd
      rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map] at hd
      rw [Polynomial.eval₂_eq_eval_map] at hroot
      rcases Nat.eq_zero_or_pos m with hm0 | hm0
      · exfalso
        apply hG
        have hC := Polynomial.eq_C_of_natDegree_eq_zero (hm.trans hm0)
        rw [hC] at hroot ⊢
        rw [Polynomial.eval_C] at hroot
        rw [hroot, map_zero]
      by_cases hder : Polynomial.derivative (G.map φ) = 0
      · by_cases hp1 : p = 1
        · exfalso
          haveI : ExpChar L 1 := hp1 ▸ hexp
          haveI : CharZero L := charZero_of_expChar_one' L
          have := (Polynomial.derivative_eq_zero).mp hder
          omega
        · have hcon : Polynomial.expand L p (Polynomial.contract p (G.map φ)) = G.map φ :=
            Polynomial.expand_contract' p hder
          have hmap : (Polynomial.contract p G).map φ = Polynomial.contract p (G.map φ) :=
            Polynomial.map_contract hp0
          have hG1 : (Polynomial.contract p G).map φ ≠ 0 := by
            rw [hmap]; intro h; apply hG; rw [← hcon, h, map_zero]
          have hdeg : (G.map φ).natDegree =
              ((Polynomial.contract p G).map φ).natDegree * p := by
            rw [hmap, ← Polynomial.natDegree_expand, hcon]
          have hp2 : 2 ≤ p := by omega
          have hpos : 0 < ((Polynomial.contract p G).map φ).natDegree := by
            rcases Nat.eq_zero_or_pos ((Polynomial.contract p G).map φ).natDegree with h | h
            · rw [h, zero_mul] at hdeg; omega
            · exact h
          have hlt : ((Polynomial.contract p G).map φ).natDegree < m := by
            rw [← hm, hdeg]
            nlinarith
          refine ih _ hlt (Polynomial.contract p G) (k + 1) hG1 rfl ?_
          rw [Polynomial.eval₂_eq_eval_map, hmap, pow_succ p k, pow_mul,
            ← Polynomial.expand_eval p, hcon]
          exact hroot
      · have hlt : ((Polynomial.derivative G).map φ).natDegree < m := by
          rw [← Polynomial.derivative_map]
          exact lt_of_lt_of_eq (Polynomial.natDegree_derivative_lt (by omega)) hm
        refine ih _ hlt (Polynomial.derivative G) k
          (by rw [← Polynomial.derivative_map]; exact hder) rfl ?_
        rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map]
        exact hd

  have trunc : ∀ G : Polynomial A, G.map φ ≠ 0 →
      ∃ G' : Polynomial A, G'.map φ = G.map φ ∧ φ G'.leadingCoeff ≠ 0 := by
    intro G hG
    obtain ⟨n, hn⟩ : ∃ n, (G.map φ).natDegree = n := ⟨_, rfl⟩
    let G' : Polynomial A :=
      ∑ i ∈ Finset.range (n + 1), Polynomial.C (G.coeff i) * Polynomial.X ^ i
    have hcoeff : ∀ j, G'.coeff j = if j < n + 1 then G.coeff j else 0 := by
      intro j
      simp only [G', Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_ite_eq]
      simp [Finset.mem_range]
    have hmapeq : G'.map φ = G.map φ := by
      ext j
      rw [Polynomial.coeff_map, Polynomial.coeff_map, hcoeff]
      split_ifs with h
      · rfl
      · rw [map_zero, ← Polynomial.coeff_map]
        exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
    have hcn : φ (G'.coeff n) ≠ 0 := by
      rw [← Polynomial.coeff_map, hmapeq, ← hn, Polynomial.coeff_natDegree]
      exact Polynomial.leadingCoeff_ne_zero.mpr hG
    have hle : G'.natDegree ≤ n := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      rw [hcoeff, if_neg (by omega)]
    have hcn' : G'.coeff n ≠ 0 := fun h => hcn (by rw [h, map_zero])
    have hdeg : G'.natDegree = n := Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hle hcn'
    refine ⟨G', hmapeq, ?_⟩
    rw [Polynomial.leadingCoeff, hdeg]
    exact hcn

  have rescale : ∀ G : Polynomial A, G ≠ 0 →
      Polynomial.C G.leadingCoeff *
          G.integralNormalization.comp (Polynomial.C G.leadingCoeff * Polynomial.X) =
        Polynomial.C (G.leadingCoeff ^ G.natDegree) * G := by
    intro G hG
    ext i
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, Polynomial.comp_C_mul_X_coeff,
      Polynomial.integralNormalization_coeff, Polynomial.degree_eq_natDegree hG]
    simp only [Nat.cast_inj]
    rcases lt_trichotomy i G.natDegree with h | h | h
    · rw [if_neg (by omega)]
      have e : G.leadingCoeff ^ G.natDegree =
          G.leadingCoeff * (G.leadingCoeff ^ (G.natDegree - 1 - i) * G.leadingCoeff ^ i) := by
        rw [← pow_add, ← pow_succ']
        congr 1
        omega
      rw [e]
      ring
    · subst h
      rw [if_pos rfl, Polynomial.coeff_natDegree]
      ring
    · rw [if_neg (by omega), Polynomial.coeff_eq_zero_of_natDegree_lt h]
      ring

  obtain ⟨G, k, hG0, hG1⟩ := descent _ f 0 hf rfl (by rw [pow_zero, pow_one]; exact hfb)
  have hGm : G.map φ ≠ 0 := by
    intro h
    apply hG1
    rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map, h,
      Polynomial.derivative_zero, Polynomial.eval_zero]
  obtain ⟨G', hG'map, hlc⟩ := trunc G hGm
  have hG'0 : G' ≠ 0 := by
    intro h
    apply hlc
    rw [h, Polynomial.leadingCoeff_zero, map_zero]
  have hr : G'.eval₂ φ (b ^ (p ^ k)) = 0 := by
    rw [Polynomial.eval₂_eq_eval_map, hG'map, ← Polynomial.eval₂_eq_eval_map]
    exact hG0
  have hd : (Polynomial.derivative G').eval₂ φ (b ^ (p ^ k)) ≠ 0 := by
    rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map, hG'map,
      Polynomial.derivative_map, ← Polynomial.eval₂_eq_eval_map]
    exact hG1
  refine ⟨G'.integralNormalization, G'.leadingCoeff, k,
    Polynomial.monic_integralNormalization hG'0, hlc, ?_, ?_⟩
  · have E := congrArg (Polynomial.eval₂ φ (b ^ (p ^ k))) (rescale G' hG'0)
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_comp,
      Polynomial.eval₂_X, hr, mul_zero] at E
    exact (mul_eq_zero.mp E).resolve_left hlc
  · intro hz
    have E := congrArg (fun P => Polynomial.eval₂ φ (b ^ (p ^ k)) (Polynomial.derivative P))
      (rescale G' hG'0)
    simp only [Polynomial.derivative_C_mul, Polynomial.derivative_comp,
      Polynomial.eval₂_mul, Polynomial.eval₂_C,
      Polynomial.eval₂_comp, Polynomial.eval₂_X] at E
    rw [hz, mul_zero, mul_zero] at E
    have h2 : φ (G'.leadingCoeff ^ G'.natDegree) *
        (Polynomial.derivative G').eval₂ φ (b ^ (p ^ k)) ≠ 0 :=
      mul_ne_zero (by rw [map_pow]; exact pow_ne_zero _ hlc) hd
    exact h2 E.symm

theorem wc_axc_etale_detect (A L : Type u) [CommRing A] [Field L] (φ : A →+* L) (F : Finset L)
    (hF : ∀ b ∈ F, ∃ (H : Polynomial A) (c : A) (k : ℕ), H.Monic ∧ φ c ≠ 0 ∧
      H.eval₂ φ (φ c * b ^ (ringExpChar L ^ k)) = 0 ∧
      (Polynomial.derivative H).eval₂ φ (φ c * b ^ (ringExpChar L ^ k)) ≠ 0) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Algebra.Etale A C ∧
      ∃ β : C →+* L, β.comp (algebraMap A C) = φ ∧
        ∀ μ ν : L →+* L, μ.comp φ = φ → ν.comp φ = φ → μ.comp β = ν.comp β →
          ∀ y ∈ F, μ y = ν y :=
by
  classical
  have single : ∀ (b : L) (H : Polynomial A) (c : A) (k : ℕ), H.Monic → φ c ≠ 0 →
      H.eval₂ φ (φ c * b ^ (ringExpChar L ^ k)) = 0 →
      (Polynomial.derivative H).eval₂ φ (φ c * b ^ (ringExpChar L ^ k)) ≠ 0 →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Algebra.Etale A C ∧
        ∃ β : C →+* L, β.comp (algebraMap A C) = φ ∧
          ∀ μ ν : L →+* L, μ.comp φ = φ → ν.comp φ = φ → μ.comp β = ν.comp β → μ b = ν b := by
    intro b H c k hH hc h0 h1
    letI : Algebra A L := φ.toAlgebra
    let P : StandardEtalePair A := ⟨H, hH, Polynomial.derivative H, ⟨1, 0, 1, by simp⟩⟩
    have hx : P.HasMap (φ c * b ^ (ringExpChar L ^ k)) := ⟨h0, isUnit_iff_ne_zero.mpr h1⟩
    refine ⟨P.Ring, inferInstance, inferInstance, inferInstance,
      ((P.lift _ hx : P.Ring →ₐ[A] L) : P.Ring →+* L), ?_, ?_⟩
    · rw [AlgHom.comp_algebraMap]; rfl
    · intro μ ν hμ hν hβ
      have e : μ ((P.lift _ hx) P.X) = ν ((P.lift _ hx) P.X) := RingHom.congr_fun hβ P.X
      rw [StandardEtalePair.lift_X] at e
      have hμc : μ (φ c) = φ c := RingHom.congr_fun hμ c
      have hνc : ν (φ c) = φ c := RingHom.congr_fun hν c
      rw [map_mul, map_mul, map_pow, map_pow, hμc, hνc] at e
      have e2 := mul_left_cancel₀ hc e
      haveI := ringExpChar.expChar L
      apply iterateFrobenius_inj L (ringExpChar L) k
      rw [iterateFrobenius_def, iterateFrobenius_def]
      exact e2
  have combine : ∀ (C₁ C₂ : Type u) [CommRing C₁] [CommRing C₂] [Algebra A C₁] [Algebra A C₂]
      [Algebra.Etale A C₁] [Algebra.Etale A C₂] (β₁ : C₁ →+* L) (β₂ : C₂ →+* L),
      β₁.comp (algebraMap A C₁) = φ → β₂.comp (algebraMap A C₂) = φ →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Algebra.Etale A C ∧
        ∃ β : C →+* L, β.comp (algebraMap A C) = φ ∧
          ∀ μ ν : L →+* L, μ.comp β = ν.comp β →
            μ.comp β₁ = ν.comp β₁ ∧ μ.comp β₂ = ν.comp β₂ := by
    intro C₁ C₂ _ _ _ _ _ _ β₁ β₂ h₁ h₂
    letI : Algebra A L := φ.toAlgebra
    let f₁ : C₁ →ₐ[A] L := AlgHom.mk β₁ (fun r => by
      rw [RingHom.algebraMap_toAlgebra]; exact RingHom.congr_fun h₁ r)
    let f₂ : C₂ →ₐ[A] L := AlgHom.mk β₂ (fun r => by
      rw [RingHom.algebraMap_toAlgebra]; exact RingHom.congr_fun h₂ r)
    haveI : Algebra.Etale C₁ (TensorProduct A C₁ C₂) := Algebra.Etale.baseChange A C₂ C₁
    haveI : Algebra.Etale A (TensorProduct A C₁ C₂) :=
      Algebra.Etale.comp A C₁ (TensorProduct A C₁ C₂)
    refine ⟨TensorProduct A C₁ C₂, inferInstance, inferInstance, inferInstance,
      ((Algebra.TensorProduct.productMap f₁ f₂ : TensorProduct A C₁ C₂ →ₐ[A] L) :
        TensorProduct A C₁ C₂ →+* L), ?_, ?_⟩
    · rw [AlgHom.comp_algebraMap]; rfl
    · intro μ ν hβ
      constructor
      · apply RingHom.ext
        intro x
        have e : μ ((Algebra.TensorProduct.productMap f₁ f₂) (x ⊗ₜ[A] (1 : C₂))) =
            ν ((Algebra.TensorProduct.productMap f₁ f₂) (x ⊗ₜ[A] (1 : C₂))) :=
          RingHom.congr_fun hβ (x ⊗ₜ[A] (1 : C₂))
        rw [Algebra.TensorProduct.productMap_left_apply] at e
        exact e
      · apply RingHom.ext
        intro x
        have e : μ ((Algebra.TensorProduct.productMap f₁ f₂) ((1 : C₁) ⊗ₜ[A] x)) =
            ν ((Algebra.TensorProduct.productMap f₁ f₂) ((1 : C₁) ⊗ₜ[A] x)) :=
          RingHom.congr_fun hβ ((1 : C₁) ⊗ₜ[A] x)
        rw [Algebra.TensorProduct.productMap_right_apply] at e
        exact e
  induction F using Finset.induction_on with
  | empty =>
    refine ⟨A, inferInstance, inferInstance, inferInstance, φ, ?_, ?_⟩
    · rw [Algebra.algebraMap_self, RingHom.comp_id]
    · intro μ ν _ _ _ y hy
      exact absurd hy (Finset.notMem_empty y)
  | insert b F' hb ih =>
    have hF' : ∀ y ∈ F', ∃ (H : Polynomial A) (c : A) (k : ℕ), H.Monic ∧ φ c ≠ 0 ∧
        H.eval₂ φ (φ c * y ^ (ringExpChar L ^ k)) = 0 ∧
        (Polynomial.derivative H).eval₂ φ (φ c * y ^ (ringExpChar L ^ k)) ≠ 0 :=
      fun y hy => hF y (Finset.mem_insert_of_mem hy)
    obtain ⟨C₁, i₁, a₁, hC₁, β₁, hβ₁, sep₁⟩ := ih hF'
    obtain ⟨H, c, k, hH, hc, h0, h1⟩ := hF b (Finset.mem_insert_self b F')
    obtain ⟨C₂, i₂, a₂, hC₂, β₂, hβ₂, sep₂⟩ := single b H c k hH hc h0 h1
    obtain ⟨C, iC, aC, hC, β, hβ, sep⟩ := combine C₁ C₂ β₁ β₂ hβ₁ hβ₂
    refine ⟨C, iC, aC, hC, β, hβ, ?_⟩
    intro μ ν hμ hν hμν y hy
    obtain ⟨e₁, e₂⟩ := sep μ ν hμν
    rcases Finset.mem_insert.mp hy with h | h
    · subst h
      exact sep₂ μ ν hμ hν e₂
    · exact sep₁ μ ν hμ hν e₁ y h

theorem wc_axc_etale_nbhd_agree (X : Scheme.{u}) (Vy Ty : X.ProEt) (uy : Ty ⟶ Vy)
    (A : Type u) [CommRing A] (e : Vy.left ≅ Spec (.of A))
    (L : Type u) [Field L] (eL : Ty.left ≅ Spec (.of L))
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uy = uy) (S : Set (Ty ⟶ Ty))
    (hdetect : ∀ F : Finset L, ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
      Algebra.Etale A C ∧
      ∃ β : C →+* L, β.comp (algebraMap A C) = (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom ∧
        ∀ μ ν : L →+* L,
          μ.comp (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom =
            (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom →
          ν.comp (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom =
            (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom →
          μ.comp β = ν.comp β → ∀ y ∈ F, μ y = ν y)
    (happrox : ∀ (E : X.ProEt) (πE : E ⟶ Vy) (eE : Ty ⟶ E),
      Etale πE.left → eE ≫ πE = uy → ∃ m ∈ S, m ≫ uy = uy ∧ m ≫ eE = τ ≫ eE) :
    ∀ F : Finset L, ∃ m ∈ S, m ≫ uy = uy ∧ ∀ y ∈ F,
      (Spec.preimage (eL.inv ≫ m.left ≫ eL.hom)).hom y =
        (Spec.preimage (eL.inv ≫ τ.left ≫ eL.hom)).hom y :=
by
  classical

  have dict : ∀ (B : Type u) [CommRing B] (a : Ty.left ⟶ Ty.left) (γ γ' : B →+* L),
      (Spec.preimage (eL.inv ≫ a ≫ eL.hom)).hom.comp γ = γ' ↔
        a ≫ eL.hom ≫ Spec.map (CommRingCat.ofHom γ) =
          eL.hom ≫ Spec.map (CommRingCat.ofHom γ') := by
    intro B _ a γ γ'
    have step1 : Spec.map (CommRingCat.ofHom
        ((Spec.preimage (eL.inv ≫ a ≫ eL.hom)).hom.comp γ)) =
        (eL.inv ≫ a ≫ eL.hom) ≫ Spec.map (CommRingCat.ofHom γ) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage]
    constructor
    · intro h
      subst h
      rw [step1]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
    · intro h
      have h2 : Spec.map (CommRingCat.ofHom
          ((Spec.preimage (eL.inv ≫ a ≫ eL.hom)).hom.comp γ)) =
          Spec.map (CommRingCat.ofHom γ') := by
        rw [step1]
        simp only [Category.assoc]
        rw [h, Iso.inv_hom_id_assoc]
      have h3 := Spec.map_injective h2
      have h4 := congrArg CommRingCat.Hom.hom h3
      simpa using h4
  intro F
  obtain ⟨C, _, _, hC, β, hβ, hsep⟩ := hdetect F
  have hSφ : Spec.map (CommRingCat.ofHom (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom) =
      eL.inv ≫ uy.left ≫ e.hom := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]

  have hfix : ∀ a : Ty ⟶ Ty, a ≫ uy = uy →
      (Spec.preimage (eL.inv ≫ a.left ≫ eL.hom)).hom.comp
          (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom =
        (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom := by
    intro a ha
    rw [dict]
    have hl : a.left ≫ uy.left = uy.left := by
      exact congrArg (fun f => f.left) ha
    rw [hSφ, Iso.hom_inv_id_assoc, ← Category.assoc, hl]

  have hEt1 : Etale (Spec.map (CommRingCat.ofHom (algebraMap A C))) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr hC)
  let g : Spec (.of C) ⟶ Vy.left := Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e.inv
  have hg : Etale g := inferInstance
  have : WeaklyEtale Vy.hom := Vy.prop
  have hw : WeaklyEtale (g ≫ Vy.hom) := inferInstance
  let E : X.ProEt := MorphismProperty.Over.mk ⊤ (g ≫ Vy.hom) hw
  let πE : E ⟶ Vy := MorphismProperty.Over.homMk g rfl trivial
  let k : Ty.left ⟶ Spec (.of C) := eL.hom ≫ Spec.map (CommRingCat.ofHom β)
  have hkg : k ≫ g = uy.left := by
    simp only [k, g, Category.assoc]
    rw [← Category.assoc (Spec.map (CommRingCat.ofHom β)), ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, hβ, hSφ]
    simp
  have hk : k ≫ E.hom = Ty.hom := by
    show k ≫ g ≫ Vy.hom = Ty.hom
    rw [← Category.assoc, hkg]
    exact MorphismProperty.Over.w uy
  let eE : Ty ⟶ E := MorphismProperty.Over.homMk k hk trivial
  have hEπ : eE ≫ πE = uy := by
    apply MorphismProperty.Over.Hom.ext
    exact hkg
  obtain ⟨m, hmS, hmuy, hmeE⟩ := happrox E πE eE hg hEπ
  refine ⟨m, hmS, hmuy, ?_⟩
  have hmk : m.left ≫ k = τ.left ≫ k := by
    exact congrArg (fun f => f.left) hmeE
  have hstar := (dict C τ.left β
    ((Spec.preimage (eL.inv ≫ τ.left ≫ eL.hom)).hom.comp β)).mp rfl
  have hβeq := (dict C m.left β
    ((Spec.preimage (eL.inv ≫ τ.left ≫ eL.hom)).hom.comp β)).mpr (hmk.trans hstar)
  exact hsep _ _ (hfix m hmuy) (hfix τ hτ) hβeq

theorem wc_axc_pair_closure (X : Scheme.{u}) (Vy Ty : X.ProEt) (uy : Ty ⟶ Vy)
    (A : Type u) [CommRing A] (e : Vy.left ≅ Spec (.of A))
    (L : Type u) [Field L] (eL : Ty.left ≅ Spec (.of L))
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uy = uy) (S : Set (Ty ⟶ Ty))
    (hring : ∀ F : Finset L, ∃ m ∈ S, m ≫ uy = uy ∧ ∀ y ∈ F,
      (Spec.preimage (eL.inv ≫ m.left ≫ eL.hom)).hom y =
        (Spec.preimage (eL.inv ≫ τ.left ≫ eL.hom)).hom y) :
    ∃ (Q : X.ProEt) (p₁ p₂ : Q ⟶ Ty) (bτ : Ty ⟶ Q), bτ ≫ p₁ = 𝟙 Ty ∧ bτ ≫ p₂ = τ ∧
      ∀ (Z : Set Q.left), IsClosed Z →
        (∀ m ∈ S, m ≫ uy = uy → ∀ b : Ty ⟶ Q, b ≫ p₁ = 𝟙 Ty → b ≫ p₂ = m →
          ∀ z, b.left z ∈ Z) →
        ∀ z, bτ.left z ∈ Z :=
by
  classical
  have t2gen : ∀ (R : Type u) [CommRing R] (Z : Set (PrimeSpectrum R)), IsClosed Z →
      ∃ s : Set R, ∀ (ψ : R →+* L) (pt : PrimeSpectrum L),
        PrimeSpectrum.comap ψ pt ∈ Z ↔ ∀ t ∈ s, ψ t = 0 := by
    intro R _ Z hZ
    obtain ⟨s, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus Z).mp hZ
    refine ⟨s, fun ψ pt => ?_⟩
    rw [PrimeSpectrum.mem_zeroLocus, PrimeSpectrum.comap_asIdeal]
    constructor
    · intro h t ht
      have hmem : ψ t ∈ pt.asIdeal := Ideal.mem_comap.mp (h ht)
      by_contra hne
      exact pt.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem pt.asIdeal hmem (Ne.isUnit hne))
    · intro h t ht
      show t ∈ Ideal.comap ψ pt.asIdeal
      rw [Ideal.mem_comap, h t ht]
      exact pt.asIdeal.zero_mem
  letI : Algebra A L := (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom.toAlgebra
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap A L)) = eL.inv ≫ uy.left ≫ e.hom := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom) = _
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]

  have t1 : ∀ t : TensorProduct A L L,
      ∃ F : Finset L, ∀ (ψ ψ' : TensorProduct A L L →+* L) (μ μ' : L → L),
        (∀ a c : L, ψ (a ⊗ₜ[A] c) = a * μ c) → (∀ a c : L, ψ' (a ⊗ₜ[A] c) = a * μ' c) →
        (∀ y ∈ F, μ y = μ' y) → ψ t = ψ' t := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨∅, fun ψ ψ' _ _ _ _ _ => by simp⟩
    | tmul a c =>
      refine ⟨{c}, fun ψ ψ' μ μ' h h' hF => ?_⟩
      rw [h, h', hF c (Finset.mem_singleton_self c)]
    | add x y hx hy =>
      obtain ⟨Fx, hFx⟩ := hx
      obtain ⟨Fy, hFy⟩ := hy
      refine ⟨Fx ∪ Fy, fun ψ ψ' μ μ' h h' hF => ?_⟩
      rw [map_add, map_add, hFx ψ ψ' μ μ' h h' (fun y hy => hF y (Finset.mem_union_left _ hy)),
        hFy ψ ψ' μ μ' h h' (fun y hy => hF y (Finset.mem_union_right _ hy))]

  have t2 := t2gen (TensorProduct A L L)

  have huy : WeaklyEtale uy.left := by
    have h1 : uy.left ≫ Vy.hom = Ty.hom := MorphismProperty.Over.w uy
    have h3 : WeaklyEtale Vy.hom := Vy.prop
    have h2 : WeaklyEtale (uy.left ≫ Vy.hom) := by rw [h1]; exact Ty.prop
    exact WeaklyEtale.of_comp uy.left Vy.hom
  have hWE : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A L))) := by
    rw [hφ]; infer_instance
  have hiL : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L L))) := by
    rw [← pullbackSpecIso_inv_fst A L L]
    have : WeaklyEtale (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A L)))
        (Spec.map (CommRingCat.ofHom (algebraMap A L)))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hWE
    infer_instance

  have hex : ∃ (Q : X.ProEt) (eQ : Q.left ≅ Spec (.of (TensorProduct A L L))) (p₁ p₂ : Q ⟶ Ty),
      eQ.inv ≫ p₁.left = Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L L)) ≫ eL.inv ∧
      eQ.inv ≫ p₂.left = Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : L →ₐ[A] TensorProduct A L L).toRingHom) ≫
          eL.inv := by
    have hTy : WeaklyEtale Ty.hom := Ty.prop
    have hQ : WeaklyEtale ((Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L L)) ≫ eL.inv) ≫
            Ty.hom) := by
      infer_instance
    let Q : X.ProEt := MorphismProperty.Over.mk ⊤ _ hQ
    have h1 : Ty.hom = uy.left ≫ Vy.hom := (MorphismProperty.Over.w uy).symm
    have h2 : eL.inv ≫ uy.left = Spec.map (CommRingCat.ofHom (algebraMap A L)) ≫ e.inv := by
      rw [hφ]; simp
    have h3 : (Algebra.TensorProduct.includeRight : L →ₐ[A] TensorProduct A L L).toRingHom.comp
        (algebraMap A L) = (Algebra.TensorProduct.includeLeftRingHom :
          L →+* TensorProduct A L L).comp (algebraMap A L) := by
      ext r
      simp [Algebra.TensorProduct.tmul_one_eq_one_tmul]
    have hw : (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : L →ₐ[A] TensorProduct A L L).toRingHom) ≫
            eL.inv) ≫ Ty.hom = (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L L)) ≫ eL.inv) ≫
          Ty.hom := by
      rw [h1]
      simp only [Category.assoc]
      rw [reassoc_of% h2, ← Spec.map_comp_assoc, ← Spec.map_comp_assoc,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, h3]
    refine ⟨Q, Iso.refl _, MorphismProperty.Over.homMk (A := Q) (B := Ty)
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L L)) ≫ eL.inv)
          rfl trivial,
      MorphismProperty.Over.homMk (A := Q) (B := Ty) (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : L →ₐ[A] TensorProduct A L L).toRingHom) ≫ eL.inv)
          hw trivial, ?_, ?_⟩
    · exact Category.id_comp _
    · exact Category.id_comp _
  obtain ⟨Q, eQ, p₁, p₂, hp₁, hp₂⟩ := hex

  have t5 : ∀ (μ : L →+* L), μ.comp (algebraMap A L) = algebraMap A L → ∀ (m : Ty ⟶ Ty),
      m.left = eL.hom ≫ Spec.map (CommRingCat.ofHom μ) ≫ eL.inv →
      ∃ (b : Ty ⟶ Q) (ψ : TensorProduct A L L →+* L), b ≫ p₁ = 𝟙 Ty ∧ b ≫ p₂ = m ∧
        (∀ a c : L, ψ (a ⊗ₜ[A] c) = a * μ c) ∧
        ∀ z : Ty.left, eQ.hom (b.left z) = PrimeSpectrum.comap ψ (eL.hom z) := by
    intro μ hμ m hm
    let μ' : L →ₐ[A] L := { μ with commutes' := fun r => RingHom.congr_fun hμ r }
    let ψ : TensorProduct A L L →+* L :=
      (Algebra.TensorProduct.lift (AlgHom.id A L) μ' (fun _ _ => Commute.all _ _)).toRingHom
    have hψ : ∀ a c : L, ψ (a ⊗ₜ[A] c) = a * μ c := fun a c => by
      simp [ψ, μ']
    have hψL : ψ.comp (Algebra.TensorProduct.includeLeftRingHom) = RingHom.id L := by
      ext a; simp [hψ]
    have hψR : ψ.comp (Algebra.TensorProduct.includeRight :
        L →ₐ[A] TensorProduct A L L).toRingHom = μ := by
      ext c; simp [hψ]
    let β : Ty.left ⟶ Q.left := eL.hom ≫ Spec.map (CommRingCat.ofHom ψ) ≫ eQ.inv
    have k1 : β ≫ p₁.left = 𝟙 _ := by
      simp only [β, Category.assoc, hp₁]
      rw [← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, hψL, CommRingCat.ofHom_id,
        Spec.map_id, Category.id_comp, Iso.hom_inv_id]
    have k2 : β ≫ p₂.left = m.left := by
      simp only [β, Category.assoc, hp₂]
      rw [← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, hψR, hm]
    have hb : β ≫ Q.hom = Ty.hom := by
      rw [← MorphismProperty.Over.w p₁, ← Category.assoc, k1, Category.id_comp]
    refine ⟨MorphismProperty.Over.homMk β hb, ψ, ?_, ?_, hψ, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact k1
    · apply MorphismProperty.Over.Hom.ext
      exact k2
    · intro z
      show eQ.hom ((eL.hom ≫ Spec.map (CommRingCat.ofHom ψ) ≫ eQ.inv) z) = _
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply eQ.inv eQ.hom,
        Iso.inv_hom_id]
      rfl

  have t6 : ∀ m : Ty ⟶ Ty, m ≫ uy = uy →
      (Spec.preimage (eL.inv ≫ m.left ≫ eL.hom)).hom.comp
          (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom =
        (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom ∧
      m.left = eL.hom ≫ Spec.map (CommRingCat.ofHom
        (Spec.preimage (eL.inv ≫ m.left ≫ eL.hom)).hom) ≫ eL.inv := by
    intro m hm
    constructor
    · have h1 : m.left ≫ uy.left = uy.left := congrArg (fun f : Ty ⟶ Vy => f.left) hm
      have : CommRingCat.ofHom ((Spec.preimage (eL.inv ≫ m.left ≫ eL.hom)).hom.comp
          (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom) =
            Spec.preimage (eL.inv ≫ uy.left ≫ e.hom) := by
        apply Spec.map_injective
        rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, CommRingCat.ofHom_hom,
          Spec.map_preimage, Spec.map_preimage]
        simp only [Category.assoc, Iso.hom_inv_id_assoc]
        rw [reassoc_of% h1]
      have := congrArg CommRingCat.Hom.hom this
      simpa using this
    · rw [CommRingCat.ofHom_hom, Spec.map_preimage]; simp

  obtain ⟨hμτ, hτl⟩ := t6 τ hτ
  obtain ⟨bτ, ψτ, hb1, hb2, hψτ, hptτ⟩ := t5 _ hμτ τ hτl
  refine ⟨Q, p₁, p₂, bτ, hb1, hb2, ?_⟩
  intro Z hZ hall z
  by_contra hz
  have hcan : ∀ w : Q.left, eQ.inv (eQ.hom w) = w := by
    intro w
    rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
    rfl
  have hZ' : IsClosed (eQ.inv ⁻¹' Z : Set (PrimeSpectrum (TensorProduct A L L))) :=
    hZ.preimage eQ.inv.continuous
  obtain ⟨s, hs⟩ := t2 _ hZ'
  have hnot : ¬ ∀ t ∈ s, ψτ t = 0 := by
    intro hall'
    apply hz
    have h1 := (hs ψτ (eL.hom z)).mpr hall'
    rw [← hptτ z] at h1
    have h2 : eQ.inv (eQ.hom (bτ.left z)) ∈ Z := h1
    rwa [hcan] at h2
  push_neg at hnot
  obtain ⟨t, ht, hψt⟩ := hnot
  obtain ⟨F, hF⟩ := t1 t
  obtain ⟨m, hmS, hmu, hagree⟩ := hring F
  obtain ⟨hμm, hml⟩ := t6 m hmu
  obtain ⟨bm, ψm, hbm1, hbm2, hψm, hptm⟩ := t5 _ hμm m hml
  have heq : ψm t = ψτ t := hF ψm ψτ _ _ hψm hψτ hagree
  have hin : bm.left z ∈ Z := hall m hmS hmu bm hbm1 hbm2 z
  have h3 : eQ.inv (eQ.hom (bm.left z)) ∈ Z := by rw [hcan]; exact hin
  have h4 : eQ.hom (bm.left z) ∈ (eQ.inv ⁻¹' Z : Set (PrimeSpectrum (TensorProduct A L L))) := h3
  rw [hptm z] at h4
  have h5 := (hs ψm (eL.hom z)).mp h4 t ht
  exact hψt (heq ▸ h5)

theorem wc_pfam_xi_action_closed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) (j : Fin D.m)
    (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy) (cy : Ty ⟶ Ω.W')
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (hc : uy ≫ vy = cy ≫ Ω.w')
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uy = uy)
    (happrox : ∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vy) (eE : Ty ⟶ E),
      Etale πE.left → eE ≫ πE = uy →
      ∃ m : Ty ⟶ Ty, (∀ x, ((wcRq h ℓ (n - 1)).obj.map m.op).hom x = x) ∧
        m ≫ uy = uy ∧ m ≫ eE = τ ≫ eE) :
    ∀ x, ((wcRq h ℓ (n - 1)).obj.map τ.op).hom x = x :=
by
  classical

  have hsub : ∀ x y : Ty.left, x = y := by
    intro x y
    have h1 : eL.hom x = eL.hom y :=
      @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
    have hx : eL.inv (eL.hom x) = x := by simp
    have hy : eL.inv (eL.hom y) = y := by simp
    rw [← hx, ← hy, h1]
  have z0 : Ty.left := eL.inv (IsLocalRing.closedPoint L)

  have huy : WeaklyEtale uy.left := by
    have h1 : uy.left ≫ Vy.hom = Ty.hom := MorphismProperty.Over.w uy
    have h3 : WeaklyEtale Vy.hom := Vy.prop
    have h2 : WeaklyEtale (uy.left ≫ Vy.hom) := by rw [h1]; exact Ty.prop
    exact WeaklyEtale.of_comp uy.left Vy.hom
  have hφwe : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom)) := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    infer_instance
  have hWE := wc_lpkt_specMap_weaklyEtale_ring A L _ hφwe
  have alg : ∀ b : L, ∃ f : Polynomial A,
      f.map (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom ≠ 0 ∧
      f.eval₂ (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom b = 0 := by
    intro b
    letI := (Spec.preimage (eL.inv ≫ uy.left ≫ e.hom)).hom.toAlgebra
    obtain ⟨f, hf1, hf2⟩ := wc_weaklyEtale_point_algebraic A L L hWE (RingHom.id L) b
    refine ⟨f, ?_, ?_⟩
    · simpa only [RingHom.id_comp, RingHom.algebraMap_toAlgebra] using hf1
    · simpa only [RingHom.id_comp, RingHom.algebraMap_toAlgebra, RingHom.id_apply] using hf2

  have hdetect := fun F : Finset L => wc_axc_etale_detect A L _ F
    (fun b _ => wc_axc_sep_witness A L _ b (alg b))

  let S : Set (Ty ⟶ Ty) := {m | ∀ x, ((wcRq h ℓ (n - 1)).obj.map m.op).hom x = x}
  have hring := wc_axc_etale_nbhd_agree (wcProjK F'' M') Vy Ty uy A e L eL τ hτ S hdetect
    (fun E πE eE hE hEu => by
      obtain ⟨m, hm1, hm2, hm3⟩ := happrox E πE eE hE hEu
      exact ⟨m, hm1, hm2, hm3⟩)

  obtain ⟨Q, p₁, p₂, bτ, hb1, hb2, hclos⟩ :=
    wc_axc_pair_closure (wcProjK F'' M') Vy Ty uy A e L eL τ hτ S hring

  have hcancel1 : ∀ (T : Over Ω.W')
      (s : ((wcRq h ℓ (n - 1)).over Ω.W').obj.obj (Opposite.op T)),
      (Ω.θ'.inv.hom.app (Opposite.op T)).hom ((Ω.θ'.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) Ω.θ'.hom_inv_id
  have hnat : ∀ (T V : (wcProjK F'' M').ProEt) (k : T ⟶ V) (h' : V ⟶ Ω.W') (h'' : T ⟶ Ω.W')
      (hk : k ≫ h' = h'') (y : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : T.left),
      (show C(↥T.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk h''))).hom
          (((wcRq h ℓ (n - 1)).obj.map k.op).hom y)).down) z =
      (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (k.left z) := by
    intro T V k h' h'' hk y z
    subst hk
    have e1 := Ω.θ'.hom.hom.naturality
      (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op
    have e2 := congrArg (fun φ => φ.hom y) e1
    exact congrArg (fun f => wcContEval (wcProjK F'' M') T f z) e2
  have hevinj : ∀ (c : Ty ⟶ Ω.W') (x x' : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) z0 =
      (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x').down) z0 → x = x' := by
    intro c x x' hxx
    have e1 : (Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x =
        (Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x' := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hsub z z0]
      exact hxx
    have := congrArg (Ω.θ'.inv.hom.app (Opposite.op (Over.mk c))).hom e1
    exact (hcancel1 (Over.mk c) x).symm.trans (this.trans (hcancel1 (Over.mk c) x'))
  have hcompR : ∀ (T₁ T₂ T₃ : (wcProjK F'' M').ProEt) (a : T₁ ⟶ T₂) (b : T₂ ⟶ T₃)
      (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op T₃)),
      ((wcRq h ℓ (n - 1)).obj.map (a ≫ b).op).hom x =
        ((wcRq h ℓ (n - 1)).obj.map a.op).hom (((wcRq h ℓ (n - 1)).obj.map b.op).hom x) := by
    intro T₁ T₂ T₃ a b x
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have hidR : ∀ (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      ((wcRq h ℓ (n - 1)).obj.map (𝟙 Ty).op).hom x = x := by
    intro x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  intro x
  let f₁ : C(↥Q.left, Fin Ω.r' → ℚ_[ℓ]) :=
    (show C(↥Q.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (p₁ ≫ cy)))).hom
        (((wcRq h ℓ (n - 1)).obj.map p₁.op).hom x)).down)
  let f₂ : C(↥Q.left, Fin Ω.r' → ℚ_[ℓ]) :=
    (show C(↥Q.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (p₁ ≫ cy)))).hom
        (((wcRq h ℓ (n - 1)).obj.map p₂.op).hom x)).down)
  let Z : Set Q.left := {w | f₁ w = f₂ w}
  have hZc : IsClosed Z := isClosed_eq f₁.continuous f₂.continuous
  have key : ∀ σ : Ty ⟶ Q, σ ≫ p₁ = 𝟙 Ty →
      (σ.left z0 ∈ Z ↔ ((wcRq h ℓ (n - 1)).obj.map (σ ≫ p₂).op).hom x = x) := by
    intro σ hσ
    have hk : σ ≫ p₁ ≫ cy = cy := by rw [← Category.assoc, hσ, Category.id_comp]
    have k1 := hnat Ty Q σ (p₁ ≫ cy) cy hk (((wcRq h ℓ (n - 1)).obj.map p₁.op).hom x) z0
    have k2 := hnat Ty Q σ (p₁ ≫ cy) cy hk (((wcRq h ℓ (n - 1)).obj.map p₂.op).hom x) z0
    rw [← hcompR, hσ, hidR] at k1
    rw [← hcompR] at k2
    show f₁ (σ.left z0) = f₂ (σ.left z0) ↔ _
    constructor
    · intro hf
      have : (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cy))).hom x).down) z0 =
        (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cy))).hom
            (((wcRq h ℓ (n - 1)).obj.map (σ ≫ p₂).op).hom x)).down) z0 :=
        k1.trans (hf.trans k2.symm)
      exact (hevinj cy _ _ this).symm
    · intro hx
      rw [hx] at k2
      exact k1.symm.trans k2
  have hZall : ∀ m ∈ S, m ≫ uy = uy → ∀ b : Ty ⟶ Q, b ≫ p₁ = 𝟙 Ty → b ≫ p₂ = m →
      ∀ z, b.left z ∈ Z := by
    intro m hm _ b hbp1 hbp2 z
    rw [hsub z z0]
    refine (key b hbp1).2 ?_
    rw [hbp2]
    exact hm x
  have hτZ := hclos Z hZc hZall z0
  have := (key bτ hb1).1 hτZ
  rwa [hb2] at this

theorem wc_pfam_inertia_to_generic (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) (j : Fin D.m)
    (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy) (cy : Ty ⟶ Ω.W')
    (hy : wcPfamPtAt Ω (lam (D.S j (IsLocalRing.closedPoint F''))) uy cy) :
    ∃ (Vξ Tξ : (wcProjK F'' M').ProEt) (uξ : Tξ ⟶ Vξ) (cξ : Tξ ⟶ Ω.W'),
      wcPfamXiPt Ω uξ cξ ∧ wcPfamInertFr Ω uy cy = wcPfamInertFr Ω uξ cξ :=
by
  classical
  obtain ⟨vy, A, _, _, _, e, L, _, _, eL, hc, hVy⟩ := hy
  haveI := Ω.hconn'

  have hsub : ∀ x y : Ty.left, x = y := by
    intro x y
    have h1 : eL.hom x = eL.hom y :=
      @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
    have hx : eL.inv (eL.hom x) = x := by simp
    have hy : eL.inv (eL.hom y) = y := by simp
    rw [← hx, ← hy, h1]
  have z0 : Ty.left := eL.inv (IsLocalRing.closedPoint L)
  have hconnT : ConnectedSpace Ty.left := by
    haveI : Nonempty Ty.left := ⟨z0⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun x _ y _ => hsub x y)⟩

  obtain ⟨Vξ, ι, uξ, A', _, _, _, e', hιu, hΔξ, hclξ⟩ :=
    wc_pfam_xi_construct F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy Ty uy vy A e hVy L eL

  have hcancel1 : ∀ (T : Over Ω.W')
      (s : ((wcRq h ℓ (n - 1)).over Ω.W').obj.obj (Opposite.op T)),
      (Ω.θ'.inv.hom.app (Opposite.op T)).hom ((Ω.θ'.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) Ω.θ'.hom_inv_id
  have hcancel2 : ∀ (T : Over Ω.W')
      (c : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op T)),
      (Ω.θ'.hom.hom.app (Opposite.op T)).hom ((Ω.θ'.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) Ω.θ'.inv_hom_id
  have hnat : ∀ (T V : (wcProjK F'' M').ProEt) (k : T ⟶ V) (h' : V ⟶ Ω.W') (h'' : T ⟶ Ω.W')
      (hk : k ≫ h' = h'') (y : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : T.left),
      (show C(↥T.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk h''))).hom
          (((wcRq h ℓ (n - 1)).obj.map k.op).hom y)).down) z =
      (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (k.left z) := by
    intro T V k h' h'' hk y z
    subst hk
    have e1 := Ω.θ'.hom.hom.naturality
      (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op
    have e2 := congrArg (fun φ => φ.hom y) e1
    exact congrArg (fun f => wcContEval (wcProjK F'' M') T f z) e2

  have hevinj : ∀ (c : Ty ⟶ Ω.W') (x x' : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) z0 =
      (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x').down) z0 → x = x' := by
    intro c x x' hxx
    have e1 : (Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x =
        (Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x' := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hsub z z0]
      exact hxx
    have := congrArg (Ω.θ'.inv.hom.app (Opposite.op (Over.mk c))).hom e1
    exact (hcancel1 (Over.mk c) x).symm.trans (this.trans (hcancel1 (Over.mk c) x'))

  have hconstT : ∀ (c : Ty ⟶ Ω.W') (v : Fin Ω.r' → ℚ_[ℓ]),
      ∃ x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
        (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) z0 = v := by
    intro c v
    let cc : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ty) :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ty) from
        ULift.up (ContinuousMap.const ↥Ty.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk c))).hom cc, ?_⟩
    have hs := hcancel2 (Over.mk c) cc
    exact congrArg (fun y : ULift.{u+1} C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z0) hs

  obtain ⟨w0⟩ : Nonempty Ω.W'.left := @ConnectedSpace.toNonempty _ _ Ω.hconn'
  have hconstW : ∀ v : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W'),
      (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) w0 = v := by
    intro v
    let cc : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom cc, ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 Ω.W')) cc
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down w0) hs

  have hFrA : ∀ (σ : Ω.W' ⟶ Ω.W') (g A₀ : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamFrame Ω σ g →
      (∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ Ω.W'), b = a ≫ σ →
        ∀ (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z =
          A₀ ((show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z)) →
      ∀ v, g v = A₀ v := by
    intro σ g A₀ hfr hA v
    obtain ⟨s, hs⟩ := hconstW v
    have k1 := hfr s w0
    have k2 := hA Ω.W' (𝟙 Ω.W') σ (Category.id_comp σ).symm s w0
    rw [hs] at k1 k2
    exact k1.symm.trans k2

  have hkey : ∀ (τ : Ty ⟶ Ty) (σ : Ω.W' ⟶ Ω.W')
      (A₀ : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])), τ ≫ cy = cy ≫ σ →
      (∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ Ω.W'), b = a ≫ σ →
        ∀ (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z =
          A₀ ((show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z)) →
      ∀ x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
        A₀ ((show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cy))).hom
            (((wcRq h ℓ (n - 1)).obj.map τ.op).hom x)).down) z0) =
        (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cy))).hom x).down) z0 := by
    intro τ σ A₀ hτc hA x
    have k1 := hA Ty cy (τ ≫ cy) hτc (((wcRq h ℓ (n - 1)).obj.map τ.op).hom x) z0
    have k2 := hnat Ty Ty τ cy (τ ≫ cy) rfl x z0
    rw [← k1, k2, hsub (τ.left z0) z0]

  have htransfer : ∀ (τ τ' : Ty ⟶ Ty) (σ σ' : Ω.W' ⟶ Ω.W')
      (g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      τ ≫ cy = cy ≫ σ → τ' ≫ cy = cy ≫ σ' → wcPfamFrame Ω σ g →
      (∀ x, ((wcRq h ℓ (n - 1)).obj.map τ.op).hom x =
        ((wcRq h ℓ (n - 1)).obj.map τ'.op).hom x) →
      wcPfamFrame Ω σ' g := by
    intro τ τ' σ σ' g hτc hτ'c hfr hRR
    obtain ⟨Aσ, hAσ⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
      Ω.hconn' Ω.r' Ω.θ' σ
    obtain ⟨Aσ', hAσ'⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
      Ω.hconn' Ω.r' Ω.θ' σ'
    have hgA := hFrA σ g Aσ hfr hAσ
    have hgsurj : Function.Surjective g := by
      intro w
      obtain ⟨x, hx⟩ := hconstT cy w
      refine ⟨(show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cy))).hom
            (((wcRq h ℓ (n - 1)).obj.map τ.op).hom x)).down) z0, ?_⟩
      rw [hgA, hkey τ σ Aσ hτc hAσ x, hx]
    have hginj : Function.Injective g := LinearMap.injective_iff_surjective.mpr hgsurj
    have hAg : ∀ w, Aσ' w = g w := by
      intro w
      obtain ⟨x, hx⟩ := hconstT cy (g w)
      have k1 := hkey τ' σ' Aσ' hτ'c hAσ' x
      have k2 := hkey τ σ Aσ hτc hAσ x
      rw [← hgA] at k2
      have k3 : (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
          ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cy))).hom
            (((wcRq h ℓ (n - 1)).obj.map τ.op).hom x)).down) z0 = w :=
        hginj (k2.trans hx)
      rw [hRR x] at k3
      rw [← k3, k1, hx, k3]
    intro s z
    rw [hAσ' Ω.W' (𝟙 Ω.W') σ' (Category.id_comp σ').symm s z, hAg]

  let S : Set (Ty ⟶ Ty) := {m | ∀ x, ((wcRq h ℓ (n - 1)).obj.map m.op).hom x = x}
  have hS0 : 𝟙 Ty ∈ S := by
    intro x
    show ((wcRq h ℓ (n - 1)).obj.map (𝟙 Ty).op).hom x = x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hcompR : ∀ (a b : Ty ⟶ Ty) (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      ((wcRq h ℓ (n - 1)).obj.map (a ≫ b).op).hom x =
        ((wcRq h ℓ (n - 1)).obj.map a.op).hom (((wcRq h ℓ (n - 1)).obj.map b.op).hom x) := by
    intro a b x
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have hS2 : ∀ a b : Ty ⟶ Ty, a ∈ S → b ∈ S → a ≫ b ∈ S := by
    intro a b ha hb x
    rw [hcompR, hb x, ha x]
  have hS1 : ∀ (V' : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eB : V'.left ≅ Spec (.of B))
      (ι' : V' ⟶ Vy) (u' : Ty ⟶ V'), u' ≫ ι' = uy →
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι' ≫ vy).left (eB.inv (IsLocalRing.closedPoint B))) ∉ Δ →
      ∀ m : Ty ⟶ Ty, m ≫ u' = u' → m ∈ S := by
    intro V' B _ _ _ eB ι' u' _ hoff m hm x
    obtain ⟨b, -⟩ := wc_pfam_xi_offdelta_lift M' h Δ ℓ (n - 1) hPP Ω V' (ι' ≫ vy) B eB hoff
    have hmc : m ≫ (u' ≫ b) = u' ≫ b := by rw [← Category.assoc, hm]
    apply hevinj (u' ≫ b)
    rw [hnat Ty Ty m (u' ≫ b) (u' ≫ b) hmc x z0, hsub (m.left z0) z0]
  have hS3 : ∀ τ : Ty ⟶ Ty, τ ≫ uy = uy →
      (∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vy) (eE : Ty ⟶ E),
        Etale πE.left → eE ≫ πE = uy →
        ∃ m ∈ S, m ≫ uy = uy ∧ m ≫ eE = τ ≫ eE) → τ ∈ S := by
    intro τ hτ happ
    exact wc_pfam_xi_action_closed F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH hPP Ω j Vy Ty uy cy
      vy A e hVy L eL hc τ hτ (fun E πE eE hE hEu => by
        obtain ⟨m, hmS, hm1, hm2⟩ := happ E πE eE hE hEu
        exact ⟨m, hmS, hm1, hm2⟩)
  have hS4 : ∀ τw : Ty ⟶ Ty, τw ≫ uξ = uξ →
      (∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vξ) (eE : Ty ⟶ E),
        Etale πE.left → eE ≫ πE = uξ →
        ∃ k : ℕ, (fun g : Ty ⟶ E => τw ≫ g)^[Nat.card F'' ^ k] eE = eE) →
      ∀ ρ ρ' : Ty ⟶ Ty, ρ ≫ uy = uy → ρ' ≫ uy = uy → ρ ≫ ρ' = 𝟙 Ty → ρ' ≫ ρ = 𝟙 Ty →
        ρ ≫ τw ≫ ρ' ∈ S := by
    intro τw hτw hw ρ ρ' _ _ hρρ' _ x
    have hT := wc_pfam_xi_wild_trivial F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP j
      Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ τw hτw hw
    show ((wcRq h ℓ (n - 1)).obj.map (ρ ≫ τw ≫ ρ').op).hom x = x
    rw [hcompR, hcompR, hT, ← hcompR, hρρ']
    exact hS0 x
  refine ⟨Vξ, Ty, uξ, cy, ?_, ?_⟩
  · refine ⟨ι ≫ vy, A', inferInstance, inferInstance, inferInstance, e', L, inferInstance,
      inferInstance, eL, ?_, hΔξ, hclξ⟩
    rw [← Category.assoc, hιu, hc]
  · ext g
    constructor
    · rintro ⟨τ, σ, hτu, hσ, hτc, hfr⟩
      obtain ⟨m, hmS, τ', hτ'ξ, hτeq⟩ := wc_pfam_xi_tame_purity_surj F' F'' Y n D M' Xu h Δ lam
        p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ S hS0 hS1 hS2 hS3 hS4
        τ hτu
      have hτ'u : τ' ≫ uy = uy := by rw [← hιu, ← Category.assoc, hτ'ξ]
      have hw : cy ≫ Ω.w' = (τ' ≫ cy) ≫ Ω.w' := by
        rw [Category.assoc, ← hc, ← Category.assoc, hτ'u]
      obtain ⟨σ', hσ', hτ'c⟩ := Ω.hgal' Ty cy (τ' ≫ cy) hconnT hw
      have hRR : ∀ x, ((wcRq h ℓ (n - 1)).obj.map τ.op).hom x =
          ((wcRq h ℓ (n - 1)).obj.map τ'.op).hom x := by
        intro x
        rw [hτeq, hcompR, hmS]
      exact ⟨τ', σ', hτ'ξ, hσ', hτ'c, htransfer τ τ' σ σ' g hτc hτ'c hfr hRR⟩
    · rintro ⟨τ, σ, hτu, hσ, hτc, hfr⟩
      refine ⟨τ, σ, ?_, hσ, hτc, hfr⟩
      rw [← hιu, ← Category.assoc, hτu]

theorem wc_pfam_generic_point_conj {F'' : Type u} [Field F''] (M' : ℕ) {X : Scheme.{u}}
    (h : X ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ q hPP)
    (V₁ T₁ : (wcProjK F'' M').ProEt) (u₁ : T₁ ⟶ V₁) (c₁ : T₁ ⟶ Ω.W')
    (h₁ : wcPfamXiPt Ω u₁ c₁)
    (V₂ T₂ : (wcProjK F'' M').ProEt) (u₂ : T₂ ⟶ V₂) (c₂ : T₂ ⟶ Ω.W')
    (h₂ : wcPfamXiPt Ω u₂ c₂) :
    ∃ (σ : Ω.W' ⟶ Ω.W') (k : (Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      σ ≫ Ω.w' = Ω.w' ∧ wcPfamFrame Ω σ k.toLinearMap ∧
      ∀ g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
        g ∈ wcPfamInertFr Ω u₁ c₁ ↔
          (k.toLinearMap ∘ₗ g ∘ₗ k.symm.toLinearMap) ∈ wcPfamInertFr Ω u₂ c₂ :=
by
  classical
  haveI hWEc : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  obtain ⟨v₁, A₁, _, _, _, e₁, L₁, _, _, eL₁, hc₁, hΔ₁, hcl₁⟩ := h₁
  obtain ⟨v₂, A₂, _, _, _, e₂, L₂, _, _, eL₂, hc₂, hΔ₂, hcl₂⟩ := h₂

  have hx12 : v₁.left (e₁.inv (IsLocalRing.closedPoint A₁)) =
      v₂.left (e₂.inv (IsLocalRing.closedPoint A₂)) :=
    Inseparable.eq (Specializes.antisymm (specializes_iff_mem_closure.mpr (hcl₁ _ hΔ₂))
      (specializes_iff_mem_closure.mpr (hcl₂ _ hΔ₁)))

  have stalk : ∀ (P : Scheme.{u}) (p : P) (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)] (q : P ⟶ Spec (.of R)) [WeaklyEtale q],
      q p = IsLocalRing.closedPoint R → IsIso (P.fromSpecStalk p ≫ q) := by
    intro P p R _ _ _ q _ hp
    haveI : WeaklyEtale (P.fromSpecStalk p) := wc_fromSpecStalk_weaklyEtale P p
    have hφg : Spec.map (Spec.preimage (P.fromSpecStalk p ≫ q)) = P.fromSpecStalk p ≫ q :=
      Spec.map_preimage _
    generalize Spec.preimage (P.fromSpecStalk p ≫ q) = φ at hφg
    have hwe : WeaklyEtale (Spec.map (CommRingCat.ofHom φ.hom)) := by
      rw [CommRingCat.ofHom_hom, hφg]; infer_instance
    letI : Algebra R (P.presheaf.stalk p) := φ.hom.toAlgebra
    have hW : Algebra.WeaklyEtale R (P.presheaf.stalk p) :=
      wc_lpkt_specMap_weaklyEtale_ring R (P.presheaf.stalk p) φ.hom hwe
    have hloc : IsLocalHom (algebraMap R (P.presheaf.stalk p)) := by
      rw [RingHom.algebraMap_toAlgebra, IsLocalRing.isLocalHom_iff_comap_closedPoint]
      have h0 := Scheme.Hom.comp_apply (P.fromSpecStalk p) q
        (IsLocalRing.closedPoint (P.presheaf.stalk p))
      rw [Scheme.fromSpecStalk_closedPoint, hp] at h0
      have h1 := congrArg (fun f : Spec (P.presheaf.stalk p) ⟶ Spec (.of R) =>
        f (IsLocalRing.closedPoint (P.presheaf.stalk p))) hφg
      simp only at h1
      have h2 : (Spec.map φ) (IsLocalRing.closedPoint (P.presheaf.stalk p)) =
          PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint (P.presheaf.stalk p)) := by
        first
          | rfl
          | (rw [Spec.map_base]; rfl)
      exact h2.symm.trans (h1.trans h0)
    have hbij := wc_olivier R (P.presheaf.stalk p) ‹_› ‹_› hloc hW
    rw [RingHom.algebraMap_toAlgebra] at hbij
    haveI : IsIso φ := (ConcreteCategory.isIso_iff_bijective φ).mpr hbij
    rw [← hφg]
    infer_instance

  have hPhom : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  haveI hv₁W : WeaklyEtale v₁.left := by
    haveI : WeaklyEtale V₁.hom := V₁.prop
    haveI : WeaklyEtale (v₁.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
      rw [MorphismProperty.Over.w v₁]; infer_instance
    exact WeaklyEtale.of_comp v₁.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  haveI hv₂W : WeaklyEtale v₂.left := by
    haveI : WeaklyEtale V₂.hom := V₂.prop
    haveI : WeaklyEtale (v₂.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
      rw [MorphismProperty.Over.w v₂]; infer_instance
    exact WeaklyEtale.of_comp v₂.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  have hxy : (e₁.inv ≫ v₁.left) (IsLocalRing.closedPoint A₁) =
      (e₂.inv ≫ v₂.left) (IsLocalRing.closedPoint A₂) :=
    (Scheme.Hom.comp_apply _ _ _).trans (hx12.trans (Scheme.Hom.comp_apply _ _ _).symm)
  obtain ⟨p, hp1, hp2⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := e₁.inv ≫ v₁.left) (g := e₂.inv ≫ v₂.left) _ _ hxy
  haveI hα := stalk _ p A₁ (Limits.pullback.fst (e₁.inv ≫ v₁.left) (e₂.inv ≫ v₂.left)) hp1
  haveI hβ' := stalk _ p A₂ (Limits.pullback.snd (e₁.inv ≫ v₁.left) (e₂.inv ≫ v₂.left)) hp2
  obtain ⟨c', hc'⟩ : ∃ c' : Spec (.of A₁) ≅ Spec (.of A₂),
      c'.hom ≫ (e₂.inv ≫ v₂.left) = e₁.inv ≫ v₁.left := by
    refine ⟨(asIso ((Limits.pullback (e₁.inv ≫ v₁.left) (e₂.inv ≫ v₂.left)).fromSpecStalk p ≫
        Limits.pullback.fst (e₁.inv ≫ v₁.left) (e₂.inv ≫ v₂.left))).symm ≪≫
      asIso ((Limits.pullback (e₁.inv ≫ v₁.left) (e₂.inv ≫ v₂.left)).fromSpecStalk p ≫
        Limits.pullback.snd (e₁.inv ≫ v₁.left) (e₂.inv ≫ v₂.left)), ?_⟩
    simp only [Iso.trans_hom, Iso.symm_hom, asIso_hom, asIso_inv, Category.assoc]
    rw [← Limits.pullback.condition, ← Category.assoc (Scheme.fromSpecStalk _ p),
      IsIso.inv_hom_id_assoc]
  have hcl : (e₁ ≪≫ c' ≪≫ e₂.symm).hom ≫ v₂.left = v₁.left := by
    simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
    rw [hc', Iso.hom_inv_id_assoc]
  have hcl2 : (e₁ ≪≫ c' ≪≫ e₂.symm).hom ≫ V₂.hom = V₁.hom := by
    rw [← MorphismProperty.Over.w v₂, ← Category.assoc, hcl, MorphismProperty.Over.w v₁]
  let β : V₁ ≅ V₂ := MorphismProperty.Over.isoMk (e₁ ≪≫ c' ≪≫ e₂.symm) hcl2
  have hβ : β.hom ≫ v₂ = v₁ := by
    apply MorphismProperty.Over.Hom.ext
    refine (MorphismProperty.Comma.comp_left _ _).trans ?_
    first
      | exact hcl
      | (refine (congrArg (· ≫ v₂.left) (MorphismProperty.Over.isoMk_hom_left _ _)).trans ?_;
         exact hcl)

  haveI := wc_proj_space_smooth F'' M'
  have hk : WeaklyEtale (e₂.inv ≫ V₂.hom) :=
    (MorphismProperty.cancel_left_of_respectsIso @WeaklyEtale e₂.inv V₂.hom).mpr V₂.prop
  haveI : IsDomain A₂ := wc_strictHensel_weaklyEtale_smooth_isDomain F'' (wcProjKStr F'' M') M'
    (CommRingCat.of A₂) (e₂.inv ≫ V₂.hom) hk

  have fieldbot : ∀ (T : (wcProjK F'' M').ProEt) (u : T ⟶ V₂) (L : Type u) [Field L]
      (eL : T.left ≅ Spec (.of L)) (z : T.left), (e₂.hom (u.left z)).asIdeal = ⊥ := by
    intro T u L _ eL z
    have hu : WeaklyEtale u.left := by
      haveI : WeaklyEtale (u.left ≫ V₂.hom) := by rw [MorphismProperty.Over.w u]; exact T.prop
      haveI : WeaklyEtale V₂.hom := V₂.prop
      exact WeaklyEtale.of_comp u.left V₂.hom
    have hg : WeaklyEtale (eL.inv ≫ u.left ≫ e₂.hom) := by
      have h1 : WeaklyEtale (u.left ≫ e₂.hom) :=
        (MorphismProperty.cancel_right_of_respectsIso @WeaklyEtale u.left e₂.hom).mpr hu
      exact (MorphismProperty.cancel_left_of_respectsIso @WeaklyEtale eL.inv _).mpr h1
    obtain ⟨ψ, hψS⟩ : ∃ ψ : CommRingCat.of A₂ ⟶ CommRingCat.of L,
        Spec.map ψ = eL.inv ≫ u.left ≫ e₂.hom :=
      ⟨Spec.preimage _, Spec.map_preimage _⟩
    have hWψ : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ.hom)) := by
      rw [CommRingCat.ofHom_hom, hψS]; exact hg
    have hWa := wc_lpkt_specMap_weaklyEtale_ring A₂ L ψ.hom hWψ
    letI : Algebra A₂ L := ψ.hom.toAlgebra
    haveI := hWa
    haveI : Module.Flat A₂ L := Algebra.WeaklyEtale.flat
    have hinj : Function.Injective ψ.hom := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      by_contra hne
      have hreg : IsSMulRegular L a :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hne)
      have h1 : a • (1 : L) = 0 := by
        rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, ha, zero_mul]
      exact one_ne_zero (hreg.right_eq_zero_of_smul h1)
    have h1 : eL.hom z = IsLocalRing.closedPoint L :=
      @Subsingleton.elim (PrimeSpectrum L) inferInstance _ _
    have hz : z = eL.inv (IsLocalRing.closedPoint L) :=
      (Scheme.hom_inv_apply eL z).symm.trans (congrArg eL.inv h1)
    have hpt : e₂.hom (u.left z) = (Spec.map ψ) (IsLocalRing.closedPoint L) := by
      rw [hψS, hz]
      exact ((Scheme.Hom.comp_apply eL.inv (u.left ≫ e₂.hom) _).trans
        (Scheme.Hom.comp_apply u.left e₂.hom _)).symm
    have h2 : (Spec.map ψ) (IsLocalRing.closedPoint L) =
        PrimeSpectrum.comap ψ.hom (IsLocalRing.closedPoint L) := by
      first
        | rfl
        | (rw [Spec.map_base]; rfl)
    rw [hpt, h2, PrimeSpectrum.comap_asIdeal]
    show Ideal.comap ψ.hom (IsLocalRing.maximalIdeal L) = ⊥
    rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.comap_bot_of_injective _ hinj]

  set a := u₁.left ≫ β.hom.left with ha_def
  set a' := u₂.left with ha'_def
  have htt : a (eL₁.inv (IsLocalRing.closedPoint L₁)) =
      a' (eL₂.inv (IsLocalRing.closedPoint L₂)) := by
    have b1 := fieldbot T₁ (u₁ ≫ β.hom) L₁ eL₁ (eL₁.inv (IsLocalRing.closedPoint L₁))
    have b2 := fieldbot T₂ u₂ L₂ eL₂ (eL₂.inv (IsLocalRing.closedPoint L₂))
    have h3 := congrArg (fun y => e₂.inv y) (PrimeSpectrum.ext (b1.trans b2.symm))
    simp only at h3
    rw [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at h3
    exact h3

  have key4 : ∀ (K : Type u) [Field K] [IsSepClosed K] (O : CommRingCat.{u}) [IsLocalRing O]
      (X : Scheme.{u}) (eK : X ≅ Spec (.of K)) (s : Spec O ⟶ X), WeaklyEtale s → IsIso s := by
    intro K _ _ O _ X eK s hs
    have hg : WeaklyEtale (s ≫ eK.hom) :=
      (MorphismProperty.cancel_right_of_respectsIso @WeaklyEtale s eK.hom).mpr hs
    obtain ⟨ψ, hψS⟩ : ∃ ψ : CommRingCat.of K ⟶ O, Spec.map ψ = s ≫ eK.hom :=
      ⟨Spec.preimage (s ≫ eK.hom), Spec.map_preimage _⟩
    have hWψ : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ.hom)) := by
      rw [CommRingCat.ofHom_hom, hψS]; exact hg
    have hWa := wc_lpkt_specMap_weaklyEtale_ring K O ψ.hom hWψ
    letI : Algebra K O := ψ.hom.toAlgebra
    haveI hloc : IsLocalHom (algebraMap K O) := by
      refine ⟨fun x hx => ?_⟩
      by_cases h0 : x = 0
      · subst h0
        rw [map_zero] at hx
        exact absurd hx not_isUnit_zero
      · exact isUnit_iff_ne_zero.mpr h0
    have hres : IsSepClosed (IsLocalRing.ResidueField K) := by
      have hinj : Function.Injective (IsLocalRing.residue K) := (IsLocalRing.residue K).injective
      exact wc_henselian_sepClosed_transfer.2 K _
        (RingEquiv.ofBijective _ ⟨hinj, IsLocalRing.residue_surjective⟩) inferInstance
    have hbij : Function.Bijective (algebraMap K O) :=
      wc_olivier K O inferInstance hres hloc hWa
    haveI : IsIso ψ := (ConcreteCategory.isIso_iff_bijective ψ).mpr hbij
    haveI : IsIso (s ≫ eK.hom) := by rw [← hψS]; infer_instance
    have hse : s = (s ≫ eK.hom) ≫ eK.inv := by simp
    rw [hse]
    infer_instance
  have hwa : a ≫ V₂.hom = T₁.hom := by
    rw [ha_def, Category.assoc, MorphismProperty.Over.w β.hom, MorphismProperty.Over.w u₁]
  have hwa' : a' ≫ V₂.hom = T₂.hom := MorphismProperty.Over.w u₂
  have hWa : WeaklyEtale a := by
    haveI : WeaklyEtale (a ≫ V₂.hom) := by rw [hwa]; exact T₁.prop
    haveI : WeaklyEtale V₂.hom := V₂.prop
    exact WeaklyEtale.of_comp a V₂.hom
  have hWa' : WeaklyEtale a' := by
    haveI : WeaklyEtale (a' ≫ V₂.hom) := by rw [hwa']; exact T₂.prop
    haveI : WeaklyEtale V₂.hom := V₂.prop
    exact WeaklyEtale.of_comp a' V₂.hom
  obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ htt
  have hfst : WeaklyEtale (Limits.pullback.fst a a') :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback a a').flip hWa'
  have hsnd : WeaklyEtale (Limits.pullback.snd a a') :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback a a') hWa
  have hι := wc_fromSpecStalk_weaklyEtale (Limits.pullback a a') z
  have hs1 : WeaklyEtale ((Limits.pullback a a').fromSpecStalk z ≫ Limits.pullback.fst a a') :=
    MorphismProperty.comp_mem @WeaklyEtale _ _ hι hfst
  have hs2 : WeaklyEtale ((Limits.pullback a a').fromSpecStalk z ≫ Limits.pullback.snd a a') :=
    MorphismProperty.comp_mem @WeaklyEtale _ _ hι hsnd
  have hcomm : ((Limits.pullback a a').fromSpecStalk z ≫ Limits.pullback.fst a a') ≫ a =
      ((Limits.pullback a a').fromSpecStalk z ≫ Limits.pullback.snd a a') ≫ a' := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  have final : ∀ (O : Scheme.{u}) (s1 : O ⟶ T₁.left) (s2 : O ⟶ T₂.left), IsIso s1 → IsIso s2 →
      s1 ≫ a = s2 ≫ a' → ∃ κ : T₁ ≅ T₂, κ.hom ≫ u₂ = u₁ ≫ β.hom := by
    intro O s1 s2 h1 h2 hc
    have hk : (inv s1 ≫ s2) ≫ a' = a := by
      rw [Category.assoc, ← hc, IsIso.inv_hom_id_assoc]
    have hb : ((asIso s1).symm ≪≫ asIso s2).hom ≫ T₂.hom = T₁.hom := by
      show (inv s1 ≫ s2) ≫ T₂.hom = T₁.hom
      rw [← hwa', ← Category.assoc, hk, hwa]
    refine ⟨MorphismProperty.Over.isoMk ((asIso s1).symm ≪≫ asIso s2) hb, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    show (inv s1 ≫ s2) ≫ a' = a
    exact hk
  obtain ⟨κ, hκ⟩ := final _ _ _ (key4 L₁ _ T₁.left eL₁ _ hs1) (key4 L₂ _ T₂.left eL₂ _ hs2) hcomm

  have hT₁ : ConnectedSpace T₁.left := by
    have hsub : ∀ x y : T₁.left, x = y := by
      intro x y
      have h1 : eL₁.hom x = eL₁.hom y :=
        @Subsingleton.elim (PrimeSpectrum L₁) inferInstance (eL₁.hom x) (eL₁.hom y)
      have hx : eL₁.inv (eL₁.hom x) = x := by simp
      have hy : eL₁.inv (eL₁.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    haveI : Nonempty T₁.left := ⟨eL₁.inv (IsLocalRing.closedPoint L₁)⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun x _ y _ => hsub x y)⟩
  have hw : c₁ ≫ Ω.w' = (κ.hom ≫ c₂) ≫ Ω.w' := by
    rw [← hc₁, Category.assoc, ← hc₂, ← Category.assoc, hκ, Category.assoc, hβ]

  haveI := Ω.hconn'
  have hcancel2 : ∀ (T : Over Ω.W')
      (c : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op T)),
      (Ω.θ'.hom.hom.app (Opposite.op T)).hom ((Ω.θ'.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) Ω.θ'.inv_hom_id
  obtain ⟨z₀⟩ : Nonempty Ω.W'.left := @ConnectedSpace.toNonempty _ _ Ω.hconn'
  have hconst : ∀ v : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ q).obj.obj (Opposite.op Ω.W'),
      ∀ z : Ω.W'.left, (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left v))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 Ω.W')) c
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) hs
  have D := fun γ => wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ q) Ω.W' Ω.hconn'
    Ω.r' Ω.θ' γ
  have hEx : ∀ σ : Ω.W' ⟶ Ω.W', ∃ g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
      wcPfamFrame Ω σ g := by
    intro σ
    obtain ⟨A, hA⟩ := D σ
    refine ⟨A, ?_⟩
    intro s z
    exact hA Ω.W' (𝟙 Ω.W') σ (Category.id_comp σ).symm s z
  have hIdU : ∀ k : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
      wcPfamFrame Ω (𝟙 Ω.W') k → ∀ v, k v = v := by
    intro k hk v
    obtain ⟨s, hs⟩ := hconst v
    exact ((hs z₀).symm.trans ((hk s z₀).trans (congrArg k (hs z₀)))).symm
  have hComp : ∀ (a b : Ω.W' ⟶ Ω.W') (ga gb : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamFrame Ω a ga → wcPfamFrame Ω b gb → wcPfamFrame Ω (a ≫ b) (gb ∘ₗ ga) := by
    intro a b ga gb ha hb
    obtain ⟨Ab, hAb⟩ := D b
    have hgb : ∀ v, gb v = Ab v := by
      intro v
      obtain ⟨s', hs'⟩ := hconst v
      exact (congrArg gb (hs' z₀)).symm.trans ((hb s' z₀).symm.trans
        ((hAb Ω.W' (𝟙 Ω.W') b (Category.id_comp b).symm s' z₀).trans (congrArg Ab (hs' z₀))))
    intro s z
    exact (hAb Ω.W' a (a ≫ b) rfl s z).trans ((hgb _).symm.trans (congrArg gb (ha s z)))

  obtain ⟨σ₀, hσ₀, hκc⟩ := Ω.hgal' T₁ c₁ (κ.hom ≫ c₂) hT₁ hw
  obtain ⟨ρ, hρ, h1⟩ := Ω.hgal' Ω.W' σ₀ (𝟙 Ω.W') Ω.hconn' (by rw [hσ₀, Category.id_comp])
  obtain ⟨ρ', _, h2⟩ := Ω.hgal' Ω.W' ρ (𝟙 Ω.W') Ω.hconn' (by rw [hρ, Category.id_comp])
  have hσρ' : σ₀ = ρ' := by
    calc σ₀ = σ₀ ≫ 𝟙 Ω.W' := (Category.comp_id σ₀).symm
      _ = σ₀ ≫ ρ ≫ ρ' := by rw [← h2]
      _ = (σ₀ ≫ ρ) ≫ ρ' := (Category.assoc _ _ _).symm
      _ = ρ' := by rw [← h1, Category.id_comp]
  have hρσ : ρ ≫ σ₀ = 𝟙 Ω.W' := by
    rw [hσρ']
    exact h2.symm
  obtain ⟨k₀, hk₀⟩ := hEx σ₀
  obtain ⟨kρ, hkρ⟩ := hEx ρ
  have f1 := hComp σ₀ ρ k₀ kρ hk₀ hkρ
  have f2 := hComp ρ σ₀ kρ k₀ hkρ hk₀
  rw [← h1] at f1
  rw [hρσ] at f2
  have hk1 : ∀ x, kρ (k₀ x) = x := fun x => hIdU _ f1 x
  have hk2 : ∀ x, k₀ (kρ x) = x := fun x => hIdU _ f2 x
  let k : (Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]) :=
    LinearEquiv.ofLinearMap k₀ kρ (LinearMap.ext fun x => hk2 x) (LinearMap.ext fun x => hk1 x)
  have hkk : k.toLinearMap = k₀ := LinearMap.ext fun x => rfl
  have hks : k.symm.toLinearMap = kρ := LinearMap.ext fun x => rfl
  have k1 : κ.inv ≫ u₁ ≫ β.hom = u₂ := by rw [← hκ, Iso.inv_hom_id_assoc]
  have k2 : κ.inv ≫ c₁ = c₂ ≫ ρ := by
    calc κ.inv ≫ c₁ = κ.inv ≫ (c₁ ≫ σ₀) ≫ ρ := by rw [Category.assoc, ← h1, Category.comp_id]
      _ = c₂ ≫ ρ := by rw [← hκc, Category.assoc, Iso.inv_hom_id_assoc]
  refine ⟨σ₀, k, hσ₀, ?_, ?_⟩
  · rw [hkk]; exact hk₀
  · intro g
    rw [hkk, hks]
    constructor
    · rintro ⟨τ₁, σ₁, hτ₁u, hσ₁, hτ₁c, hfr⟩
      have hτ₂u : (κ.inv ≫ τ₁ ≫ κ.hom) ≫ u₂ = u₂ := by
        simp only [Category.assoc]
        rw [hκ, ← Category.assoc τ₁, hτ₁u, k1]
      have hτ₂c : (κ.inv ≫ τ₁ ≫ κ.hom) ≫ c₂ = c₂ ≫ ρ ≫ σ₁ ≫ σ₀ := by
        simp only [Category.assoc]
        rw [hκc, ← Category.assoc τ₁, hτ₁c, Category.assoc, ← Category.assoc κ.inv, k2,
          Category.assoc]
      have hdeck : (ρ ≫ σ₁ ≫ σ₀) ≫ Ω.w' = Ω.w' := by
        simp only [Category.assoc, hσ₀, hσ₁, hρ]
      have hfrm := hComp ρ (σ₁ ≫ σ₀) kρ (k₀ ∘ₗ g) hkρ (hComp σ₁ σ₀ g k₀ hfr hk₀)
      have heq : (k₀ ∘ₗ g) ∘ₗ kρ = k₀ ∘ₗ g ∘ₗ kρ := LinearMap.comp_assoc _ _ _
      rw [heq] at hfrm
      exact ⟨κ.inv ≫ τ₁ ≫ κ.hom, ρ ≫ σ₁ ≫ σ₀, hτ₂u, hdeck, hτ₂c, hfrm⟩
    · rintro ⟨τ₂, σ₂, hτ₂u, hσ₂, hτ₂c, hfr⟩
      have hτ₁u : (κ.hom ≫ τ₂ ≫ κ.inv) ≫ u₁ = u₁ := by
        rw [← cancel_mono β.hom]
        simp only [Category.assoc]
        rw [k1, hτ₂u, hκ]
      have hτ₁c : (κ.hom ≫ τ₂ ≫ κ.inv) ≫ c₁ = c₁ ≫ σ₀ ≫ σ₂ ≫ ρ := by
        simp only [Category.assoc]
        rw [k2, ← Category.assoc τ₂, hτ₂c, Category.assoc, ← Category.assoc κ.hom, hκc,
          Category.assoc]
      have hdeck : (σ₀ ≫ σ₂ ≫ ρ) ≫ Ω.w' = Ω.w' := by
        simp only [Category.assoc, hρ, hσ₂, hσ₀]
      have hfrm := hComp σ₀ (σ₂ ≫ ρ) k₀ (kρ ∘ₗ (k₀ ∘ₗ g ∘ₗ kρ)) hk₀
        (hComp σ₂ ρ _ kρ hfr hkρ)
      have heq : (kρ ∘ₗ (k₀ ∘ₗ g ∘ₗ kρ)) ∘ₗ k₀ = g := by
        apply LinearMap.ext
        intro x
        simp only [LinearMap.comp_apply, hk1]
      rw [heq] at hfrm
      exact ⟨κ.hom ≫ τ₂ ≫ κ.inv, σ₀ ≫ σ₂ ≫ ρ, hτ₁u, hdeck, hτ₁c, hfrm⟩

theorem wc_pencil_PL_inertia_monodromy_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hF : wcPencilFamily D) (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (i i₀ : Fin D.m)
    (V₁ : (wcP1Over F'').left.ProEt) (v₁ : V₁ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A₁ : Type u) [CommRing A₁] [HenselianLocalRing A₁]
    [IsSepClosed (IsLocalRing.ResidueField A₁)] (e₁ : V₁.left ≅ Spec (.of A₁))
    (hV₁ : V₁.hom (e₁.inv (IsLocalRing.closedPoint A₁)) = D.S i (IsLocalRing.closedPoint F''))
    (T₁ : (wcP1Over F'').left.ProEt) (u₁ : T₁ ⟶ V₁) (c₁ : T₁ ⟶ π.W)
    (L₁ : Type u) [Field L₁] [IsSepClosed L₁] (eL₁ : T₁.left ≅ Spec (.of L₁))
    (hc₁ : u₁ ≫ v₁ = c₁ ≫ π.w)
    (V₂ : (wcP1Over F'').left.ProEt) (v₂ : V₂ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A₂ : Type u) [CommRing A₂] [HenselianLocalRing A₂]
    [IsSepClosed (IsLocalRing.ResidueField A₂)] (e₂ : V₂.left ≅ Spec (.of A₂))
    (hV₂ : V₂.hom (e₂.inv (IsLocalRing.closedPoint A₂)) = D.S i₀ (IsLocalRing.closedPoint F''))
    (T₂ : (wcP1Over F'').left.ProEt) (u₂ : T₂ ⟶ V₂) (c₂ : T₂ ⟶ π.W)
    (L₂ : Type u) [Field L₂] [IsSepClosed L₂] (eL₂ : T₂.left ≅ Spec (.of L₂))
    (hc₂ : u₂ ≫ v₂ = c₂ ≫ π.w) :
    ∃ σ₀ : π.W ⟶ π.W, σ₀ ≫ π.w = π.w ∧
      (∀ (τ₂ : T₂ ⟶ T₂) (σ₂ : π.W ⟶ π.W), τ₂ ≫ u₂ = u₂ → σ₂ ≫ π.w = π.w →
        τ₂ ≫ c₂ = c₂ ≫ σ₂ →
        ∃ (τ₁ : T₁ ⟶ T₁) (σ₁ : π.W ⟶ π.W), τ₁ ≫ u₁ = u₁ ∧ σ₁ ≫ π.w = π.w ∧
          τ₁ ≫ c₁ = c₁ ≫ σ₁ ∧
          ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
            (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
              ((π.θ.hom.hom.app (Opposite.op (Over.mk (σ₁ ≫ σ₀)))).hom s).down) z =
            (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
              ((π.θ.hom.hom.app (Opposite.op (Over.mk (σ₀ ≫ σ₂)))).hom s).down) z) ∧
      (∀ (τ₁ : T₁ ⟶ T₁) (σ₁ : π.W ⟶ π.W), τ₁ ≫ u₁ = u₁ → σ₁ ≫ π.w = π.w →
        τ₁ ≫ c₁ = c₁ ≫ σ₁ →
        ∃ (τ₂ : T₂ ⟶ T₂) (σ₂ : π.W ⟶ π.W), τ₂ ≫ u₂ = u₂ ∧ σ₂ ≫ π.w = π.w ∧
          τ₂ ≫ c₂ = c₂ ≫ σ₂ ∧
          ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
            (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
              ((π.θ.hom.hom.app (Opposite.op (Over.mk (σ₁ ≫ σ₀)))).hom s).down) z =
            (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
              ((π.θ.hom.hom.app (Opposite.op (Over.mk (σ₀ ≫ σ₂)))).hom s).down) z) :=
by
  classical
  haveI := π.hconn

  obtain ⟨M', Xu, d, hsm, h, hprop, hhX, Δ, lam, p, hM, hΔ, hirr, hsmooth, hcl, hlamstr, hL,
    hpb, hlamΔ, hlocq⟩ := hF
  have hH : wcPfamHyp D M' Xu h Δ lam p :=
    ⟨⟨d, hsm⟩, hprop, hhX, hM, hΔ, hirr, hsmooth, hcl, hlamstr, hL, hpb, hlamΔ, hlocq⟩
  obtain ⟨hPP, ⟨Ω⟩⟩ := wc_pfam_cover_exists F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH (n - 1)
  obtain ⟨M, hlift, hpt⟩ := wc_pfam_line_compare F' F'' Y n hn hn2 D ℓ hℓ hP π hgal
    M' Xu h Δ lam p hH hPP Ω
  obtain ⟨Vy1, Ty1, uy1, cy1, hpy1, hI1⟩ := hpt i V₁ v₁ A₁ e₁ hV₁ T₁ u₁ c₁ L₁ eL₁ hc₁
  obtain ⟨Vy2, Ty2, uy2, cy2, hpy2, hI2⟩ := hpt i₀ V₂ v₂ A₂ e₂ hV₂ T₂ u₂ c₂ L₂ eL₂ hc₂
  obtain ⟨Vξ1, Tξ1, uξ1, cξ1, hξ1, hE1⟩ := wc_pfam_inertia_to_generic F' F'' Y n hn hn2 D ℓ hℓ
    M' Xu h Δ lam p hH hPP Ω i Vy1 Ty1 uy1 cy1 hpy1
  obtain ⟨Vξ2, Tξ2, uξ2, cξ2, hξ2, hE2⟩ := wc_pfam_inertia_to_generic F' F'' Y n hn hn2 D ℓ hℓ
    M' Xu h Δ lam p hH hPP Ω i₀ Vy2 Ty2 uy2 cy2 hpy2
  obtain ⟨σ', k, hσ', hk, hconj⟩ := wc_pfam_generic_point_conj M' h Δ ℓ (n - 1) hPP Ω
    Vξ1 Tξ1 uξ1 cξ1 hξ1 Vξ2 Tξ2 uξ2 cξ2 hξ2
  obtain ⟨σ₀, hσ₀, hg₀⟩ := hlift σ' k.toLinearMap hσ' hk
  set e : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]) := M.trans (k.trans M.symm) with he
  have hg0e : ∀ x, (M.symm.toLinearMap ∘ₗ k.toLinearMap ∘ₗ M.toLinearMap) x = e x :=
    fun x => rfl

  have hKey : ∀ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      g ∈ wcPLInertFr π u₁ c₁ ↔
        (e.toLinearMap ∘ₗ g ∘ₗ e.symm.toLinearMap) ∈ wcPLInertFr π u₂ c₂ := by
    intro g
    rw [hI1 g, hE1, hconj, ← hE2, hI2]
    have heq : k.toLinearMap ∘ₗ (M.toLinearMap ∘ₗ g ∘ₗ M.symm.toLinearMap) ∘ₗ
        k.symm.toLinearMap =
        M.toLinearMap ∘ₗ (e.toLinearMap ∘ₗ g ∘ₗ e.symm.toLinearMap) ∘ₗ M.symm.toLinearMap := by
      apply LinearMap.ext
      intro x
      simp [he]
    rw [heq]

  have hcancel1 : ∀ (T : Over π.W)
      (s : ((wcRq D.f ℓ (n - 1)).over π.W).obj.obj (Opposite.op T)),
      (π.θ.inv.hom.app (Opposite.op T)).hom ((π.θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) π.θ.hom_inv_id
  have hEx : ∀ σ : π.W ⟶ π.W, ∃ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      wcHonestFrame D ℓ π.W π.r π.θ σ g := by
    intro σ
    let θσ : (wcRq D.f ℓ (n - 1)).over π.W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W :=
      ⟨{ app := fun T => π.θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => π.θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ π.W), c ≫ σ = u →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t =
          (π.θ.hom.hom.app (Opposite.op (Over.mk u))).hom t := by
      rintro V' c u rfl t
      rfl
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ π.W π.hconn π.r π.r
      (π.θ.inv ≫ θσ)
    have hPt : ∀ (T : Over π.W)
        (c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from
          (((π.θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    refine ⟨A, ?_⟩
    intro s z
    have e1 : ((π.θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s) =
        (θσ.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom
        (hcancel1 (Over.mk (𝟙 π.W)) s)
    have E := e1.trans (hres π.W (𝟙 π.W) σ (Category.id_comp σ) s)
    have h1 := hPt (Over.mk (𝟙 π.W))
      ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥π.W.left, Fin π.r → ℚ_[ℓ]) => y.down z) E
    exact h4.symm.trans h1
  have hComp : ∀ (a b : π.W ⟶ π.W) (ga gb : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      b ≫ π.w = π.w → wcHonestFrame D ℓ π.W π.r π.θ a ga →
      wcHonestFrame D ℓ π.W π.r π.θ b gb →
      wcHonestFrame D ℓ π.W π.r π.θ (a ≫ b) (gb ∘ₗ ga) := by
    intro a b ga gb hb ha hbf
    intro s z
    have e := (wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π b hb gb hbf).2 π.W a s z
    exact e.trans (congrArg gb (ha s z))
  refine ⟨σ₀, hσ₀, ?_, ?_⟩
  · intro τ₂ σ₂ hτ₂u hσ₂ hτ₂c
    obtain ⟨h₂, hh₂⟩ := hEx σ₂
    have hmem₂ : h₂ ∈ wcPLInertFr π u₂ c₂ := ⟨τ₂, σ₂, hτ₂u, hσ₂, hτ₂c, hh₂⟩
    have hrw : e.toLinearMap ∘ₗ (e.symm.toLinearMap ∘ₗ h₂ ∘ₗ e.toLinearMap) ∘ₗ
        e.symm.toLinearMap = h₂ := by
      apply LinearMap.ext
      intro x
      simp
    have hmem₁ : (e.symm.toLinearMap ∘ₗ h₂ ∘ₗ e.toLinearMap) ∈ wcPLInertFr π u₁ c₁ := by
      rw [hKey, hrw]
      exact hmem₂
    obtain ⟨τ₁, σ₁, hτ₁u, hσ₁, hτ₁c, hh₁⟩ := hmem₁
    refine ⟨τ₁, σ₁, hτ₁u, hσ₁, hτ₁c, fun s z => ?_⟩
    have a1 := hComp σ₁ σ₀ _ _ hσ₀ hh₁ hg₀ s z
    have a2 := hComp σ₀ σ₂ _ h₂ hσ₂ hg₀ hh₂ s z
    refine a1.trans (Eq.trans ?_ a2.symm)
    simp only [LinearMap.comp_apply, hg0e]
    simp
  · intro τ₁ σ₁ hτ₁u hσ₁ hτ₁c
    obtain ⟨h₁, hh₁⟩ := hEx σ₁
    have hmem₁ : h₁ ∈ wcPLInertFr π u₁ c₁ := ⟨τ₁, σ₁, hτ₁u, hσ₁, hτ₁c, hh₁⟩
    obtain ⟨τ₂, σ₂, hτ₂u, hσ₂, hτ₂c, hh₂⟩ := (hKey h₁).1 hmem₁
    refine ⟨τ₂, σ₂, hτ₂u, hσ₂, hτ₂c, fun s z => ?_⟩
    have a1 := hComp σ₁ σ₀ h₁ _ hσ₀ hh₁ hg₀ s z
    have a2 := hComp σ₀ σ₂ _ _ hσ₂ hg₀ hh₂ s z
    refine a1.trans (Eq.trans ?_ a2.symm)
    simp only [LinearMap.comp_apply, hg0e]
    simp

theorem wc_pencil_PL_inv_cross_index_exists (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hF : wcPencilFamily D) (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (i i₀ : Fin D.m) :
    ∃ (V₁ : (wcP1Over F'').left.ProEt) (v₁ : V₁ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (A₁ : Type u) (_ : CommRing A₁) (_ : HenselianLocalRing A₁)
      (_ : IsSepClosed (IsLocalRing.ResidueField A₁)) (e₁ : V₁.left ≅ Spec (.of A₁))
      (T₁ : (wcP1Over F'').left.ProEt) (u₁ : T₁ ⟶ V₁) (c₁ : T₁ ⟶ π.W)
      (L₁ : Type u) (_ : Field L₁) (_ : IsSepClosed L₁) (eL₁ : T₁.left ≅ Spec (.of L₁))
      (V₂ : (wcP1Over F'').left.ProEt) (v₂ : V₂ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (A₂ : Type u) (_ : CommRing A₂) (_ : HenselianLocalRing A₂)
      (_ : IsSepClosed (IsLocalRing.ResidueField A₂)) (e₂ : V₂.left ≅ Spec (.of A₂))
      (T₂ : (wcP1Over F'').left.ProEt) (u₂ : T₂ ⟶ V₂) (c₂ : T₂ ⟶ π.W)
      (L₂ : Type u) (_ : Field L₂) (_ : IsSepClosed L₂) (eL₂ : T₂.left ≅ Spec (.of L₂))
      (σ : π.W ⟶ π.W) (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      V₁.hom (e₁.inv (IsLocalRing.closedPoint A₁)) = D.S i (IsLocalRing.closedPoint F'') ∧
      u₁ ≫ v₁ = c₁ ≫ π.w ∧
      V₂.hom (e₂.inv (IsLocalRing.closedPoint A₂)) = D.S i₀ (IsLocalRing.closedPoint F'') ∧
      u₂ ≫ v₂ = c₂ ≫ π.w ∧
      σ ≫ π.w = π.w ∧
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
        g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z)) ∧
      ∀ x : Fin π.r → ℚ_[ℓ], x ∈ wcPLInv π u₁ c₁ ↔ g x ∈ wcPLInv π u₂ c₂ :=
by
  classical
  haveI := π.hconn

  obtain ⟨V₁, v₁, -, A₁, _, _, _, e₁, -, hV₁, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' (D.S i) (D.hS i) hP
  obtain ⟨V₂, v₂, -, A₂, _, _, _, e₂, -, hV₂, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' (D.S i₀) (D.hS i₀) hP
  obtain ⟨T₁, u₁, c₁, L₁, _, _, eL₁, hc₁, -⟩ :=
    wc_pencil_PL_hloc_sep_point F' F'' Y n hn hn2 D ℓ hℓ hP π i V₁ v₁ A₁ e₁ hV₁
  obtain ⟨T₂, u₂, c₂, L₂, _, _, eL₂, hc₂, -⟩ :=
    wc_pencil_PL_hloc_sep_point F' F'' Y n hn hn2 D ℓ hℓ hP π i₀ V₂ v₂ A₂ e₂ hV₂

  obtain ⟨σ₀, hσ₀, hfw, hbw⟩ :=
    wc_pencil_PL_inertia_monodromy_conj F' F'' Y n hn hn2 D ℓ hℓ hP hF π hgal i i₀
      V₁ v₁ A₁ e₁ hV₁ T₁ u₁ c₁ L₁ eL₁ hc₁ V₂ v₂ A₂ e₂ hV₂ T₂ u₂ c₂ L₂ eL₂ hc₂

  have memInv : ∀ {V T : (wcP1Over F'').left.ProEt} (u : T ⟶ V) (c : T ⟶ π.W)
      (x : Fin π.r → ℚ_[ℓ]),
      x ∈ wcPLInv π u c ↔ ∀ (τ : T ⟶ T) (σ : π.W ⟶ π.W)
        (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
        τ ≫ u = u → σ ≫ π.w = π.w → τ ≫ c = c ≫ σ →
        wcHonestFrame D ℓ π.W π.r π.θ σ g → g x = x := by
    intro V T u c x
    exact Iff.rfl
  have hcancel1 : ∀ (T : Over π.W)
      (s : ((wcRq D.f ℓ (n - 1)).over π.W).obj.obj (Opposite.op T)),
      (π.θ.inv.hom.app (Opposite.op T)).hom ((π.θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) π.θ.hom_inv_id
  have hcancel2 : ∀ (T : Over π.W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W).obj.obj
        (Opposite.op T)),
      (π.θ.hom.hom.app (Opposite.op T)).hom ((π.θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) π.θ.inv_hom_id
  have hEx : ∀ σ : π.W ⟶ π.W, ∃ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      wcHonestFrame D ℓ π.W π.r π.θ σ g := by
    intro σ
    let θσ : (wcRq D.f ℓ (n - 1)).over π.W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W :=
      ⟨{ app := fun T => π.θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => π.θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ π.W), c ≫ σ = u →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t =
          (π.θ.hom.hom.app (Opposite.op (Over.mk u))).hom t := by
      rintro V' c u rfl t
      rfl
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ π.W π.hconn π.r π.r
      (π.θ.inv ≫ θσ)
    have hPt : ∀ (T : Over π.W)
        (c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from
          (((π.θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    refine ⟨A, ?_⟩
    intro s z
    have e1 : ((π.θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s) =
        (θσ.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom
        (hcancel1 (Over.mk (𝟙 π.W)) s)
    have E := e1.trans (hres π.W (𝟙 π.W) σ (Category.id_comp σ) s)
    have h1 := hPt (Over.mk (𝟙 π.W))
      ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥π.W.left, Fin π.r → ℚ_[ℓ]) => y.down z) E
    exact h4.symm.trans h1
  obtain ⟨z₀⟩ : Nonempty π.W.left := @ConnectedSpace.toNonempty _ _ π.hconn
  have hconst : ∀ v : Fin π.r → ℚ_[ℓ], ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W),
      ∀ z : π.W.left, (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op π.W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op π.W) from
        ULift.up (ContinuousMap.const ↥π.W.left v))
    refine ⟨(π.θ.inv.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 π.W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥π.W.left, Fin π.r → ℚ_[ℓ]) => y.down z) hs
  have hComp : ∀ (a b : π.W ⟶ π.W) (ga gb : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      b ≫ π.w = π.w → wcHonestFrame D ℓ π.W π.r π.θ a ga →
      wcHonestFrame D ℓ π.W π.r π.θ b gb →
      wcHonestFrame D ℓ π.W π.r π.θ (a ≫ b) (gb ∘ₗ ga) := by
    intro a b ga gb hb ha hbf
    intro s z
    have e := (wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π b hb gb hbf).2 π.W a s z
    exact e.trans (congrArg gb (ha s z))

  obtain ⟨g₀, hg₀⟩ := hEx σ₀
  have hinj : Function.Injective g₀ :=
    (wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π σ₀ hσ₀ g₀ hg₀).1.1

  have key : ∀ (σ₁ σ₂ : π.W ⟶ π.W) (h₁ h₂ : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      σ₂ ≫ π.w = π.w → wcHonestFrame D ℓ π.W π.r π.θ σ₁ h₁ →
      wcHonestFrame D ℓ π.W π.r π.θ σ₂ h₂ →
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (σ₁ ≫ σ₀)))).hom s).down) z =
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (σ₀ ≫ σ₂)))).hom s).down) z) →
      ∀ y, g₀ (h₁ y) = h₂ (g₀ y) := by
    intro σ₁ σ₂ h₁ h₂ hσ₂ hf₁ hf₂ heq y
    obtain ⟨s, hs⟩ := hconst y
    have a1 := (hComp σ₁ σ₀ h₁ g₀ hσ₀ hf₁ hg₀ s z₀).trans (congrArg (g₀ ∘ₗ h₁) (hs z₀))
    have a2 := (hComp σ₀ σ₂ g₀ h₂ hσ₂ hg₀ hf₂ s z₀).trans (congrArg (h₂ ∘ₗ g₀) (hs z₀))
    exact a1.symm.trans ((heq s z₀).trans a2)
  refine ⟨V₁, v₁, A₁, inferInstance, inferInstance, inferInstance, e₁, T₁, u₁, c₁, L₁,
    inferInstance, inferInstance, eL₁, V₂, v₂, A₂, inferInstance, inferInstance, inferInstance,
    e₂, T₂, u₂, c₂, L₂, inferInstance, inferInstance, eL₂, σ₀, g₀, hV₁, hc₁, hV₂, hc₂, hσ₀,
    hg₀, ?_⟩
  intro x
  constructor
  · intro hx
    refine (memInv u₂ c₂ (g₀ x)).2 ?_
    intro τ₂ σ₂ h hτ₂u hσ₂ hτ₂c hfh
    obtain ⟨τ₁, σ₁, hτ₁u, hσ₁, hτ₁c, heq⟩ := hfw τ₂ σ₂ hτ₂u hσ₂ hτ₂c
    obtain ⟨h₁, hh₁⟩ := hEx σ₁
    have e1 : h₁ x = x := (memInv u₁ c₁ x).1 hx τ₁ σ₁ h₁ hτ₁u hσ₁ hτ₁c hh₁
    rw [← key σ₁ σ₂ h₁ h hσ₂ hh₁ hfh heq x, e1]
  · intro hgx
    refine (memInv u₁ c₁ x).2 ?_
    intro τ₁ σ₁ h₁ hτ₁u hσ₁ hτ₁c hh₁
    obtain ⟨τ₂, σ₂, hτ₂u, hσ₂, hτ₂c, heq⟩ := hbw τ₁ σ₁ hτ₁u hσ₁ hτ₁c
    obtain ⟨h₂, hh₂⟩ := hEx σ₂
    have e2 : h₂ (g₀ x) = g₀ x := (memInv u₂ c₂ (g₀ x)).1 hgx τ₂ σ₂ h₂ hτ₂u hσ₂ hτ₂c hh₂
    apply hinj
    rw [key σ₁ σ₂ h₁ h₂ hσ₂ hh₁ hh₂ heq x, e2]

theorem wc_pencil_PL_inertia_inv_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hF : wcPencilFamily D) (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (i i₀ : Fin D.m)
    (V₁ : (wcP1Over F'').left.ProEt) (v₁ : V₁ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A₁ : Type u) [CommRing A₁] [HenselianLocalRing A₁]
    [IsSepClosed (IsLocalRing.ResidueField A₁)] (e₁ : V₁.left ≅ Spec (.of A₁))
    (hV₁ : V₁.hom (e₁.inv (IsLocalRing.closedPoint A₁)) = D.S i (IsLocalRing.closedPoint F''))
    (T₁ : (wcP1Over F'').left.ProEt) (u₁ : T₁ ⟶ V₁) (c₁ : T₁ ⟶ π.W)
    (L₁ : Type u) [Field L₁] [IsSepClosed L₁] (eL₁ : T₁.left ≅ Spec (.of L₁))
    (hc₁ : u₁ ≫ v₁ = c₁ ≫ π.w)
    (V₂ : (wcP1Over F'').left.ProEt) (v₂ : V₂ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A₂ : Type u) [CommRing A₂] [HenselianLocalRing A₂]
    [IsSepClosed (IsLocalRing.ResidueField A₂)] (e₂ : V₂.left ≅ Spec (.of A₂))
    (hV₂ : V₂.hom (e₂.inv (IsLocalRing.closedPoint A₂)) = D.S i₀ (IsLocalRing.closedPoint F''))
    (T₂ : (wcP1Over F'').left.ProEt) (u₂ : T₂ ⟶ V₂) (c₂ : T₂ ⟶ π.W)
    (L₂ : Type u) [Field L₂] [IsSepClosed L₂] (eL₂ : T₂.left ≅ Spec (.of L₂))
    (hc₂ : u₂ ≫ v₂ = c₂ ≫ π.w) :
    ∃ (σ : π.W ⟶ π.W) (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      σ ≫ π.w = π.w ∧
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
        g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z)) ∧
      ∀ x : Fin π.r → ℚ_[ℓ], x ∈ wcPLInv π u₁ c₁ ↔ g x ∈ wcPLInv π u₂ c₂ :=
by
  classical
  haveI := π.hconn

  have hoffT : ∀ (T : (wcP1Over F'').left.ProEt) (c : T ⟶ π.W) (j : Fin D.m) (z : T.left),
      T.hom z ≠ D.S j (IsLocalRing.closedPoint F'') := by
    intro T c j z h
    apply π.hoff (c.left z) j
    have e : T.hom z = π.W.hom (c.left z) := by
      rw [← MorphismProperty.Over.w c]
      rfl
    rw [← e]
    exact h

  have hconnT : ∀ (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L]
      (eL : T.left ≅ Spec (.of L)), ConnectedSpace T.left := by
    intro T L _ eL
    have hsub : ∀ x y : T.left, x = y := by
      intro x y
      have h1 : eL.hom x = eL.hom y :=
        @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
      have hx : eL.inv (eL.hom x) = x := by simp
      have hy : eL.inv (eL.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    haveI : Nonempty T.left := ⟨eL.inv (IsLocalRing.closedPoint L)⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun x _ y _ => hsub x y)⟩

  have memInv : ∀ {V T : (wcP1Over F'').left.ProEt} (u : T ⟶ V) (c : T ⟶ π.W)
      (x : Fin π.r → ℚ_[ℓ]),
      x ∈ wcPLInv π u c ↔ ∀ (τ : T ⟶ T) (σ : π.W ⟶ π.W)
        (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
        τ ≫ u = u → σ ≫ π.w = π.w → τ ≫ c = c ≫ σ →
        wcHonestFrame D ℓ π.W π.r π.θ σ g → g x = x := by
    intro V T u c x
    exact Iff.rfl

  have hcancel1 : ∀ (T : Over π.W)
      (s : ((wcRq D.f ℓ (n - 1)).over π.W).obj.obj (Opposite.op T)),
      (π.θ.inv.hom.app (Opposite.op T)).hom ((π.θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) π.θ.hom_inv_id
  have hcancel2 : ∀ (T : Over π.W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W).obj.obj
        (Opposite.op T)),
      (π.θ.hom.hom.app (Opposite.op T)).hom ((π.θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) π.θ.inv_hom_id

  have hEx : ∀ σ : π.W ⟶ π.W, ∃ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      wcHonestFrame D ℓ π.W π.r π.θ σ g := by
    intro σ
    let θσ : (wcRq D.f ℓ (n - 1)).over π.W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W :=
      ⟨{ app := fun T => π.θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => π.θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ π.W), c ≫ σ = u →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t =
          (π.θ.hom.hom.app (Opposite.op (Over.mk u))).hom t := by
      rintro V' c u rfl t
      rfl
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ π.W π.hconn π.r π.r
      (π.θ.inv ≫ θσ)
    have hPt : ∀ (T : Over π.W)
        (c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from
          (((π.θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    refine ⟨A, ?_⟩
    intro s z
    have e1 : ((π.θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s) =
        (θσ.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom
        (hcancel1 (Over.mk (𝟙 π.W)) s)
    have E := e1.trans (hres π.W (𝟙 π.W) σ (Category.id_comp σ) s)
    have h1 := hPt (Over.mk (𝟙 π.W))
      ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥π.W.left, Fin π.r → ℚ_[ℓ]) => y.down z) E
    exact h4.symm.trans h1

  obtain ⟨z₀⟩ : Nonempty π.W.left := @ConnectedSpace.toNonempty _ _ π.hconn
  have hconst : ∀ v : Fin π.r → ℚ_[ℓ], ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W),
      ∀ z : π.W.left, (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op π.W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op π.W) from
        ULift.up (ContinuousMap.const ↥π.W.left v))
    refine ⟨(π.θ.inv.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 π.W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥π.W.left, Fin π.r → ℚ_[ℓ]) => y.down z) hs
  have hIdU : ∀ k : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      wcHonestFrame D ℓ π.W π.r π.θ (𝟙 π.W) k → ∀ v, k v = v := by
    intro k hk v
    obtain ⟨s, hs⟩ := hconst v
    exact ((hs z₀).symm.trans ((hk s z₀).trans (congrArg k (hs z₀)))).symm

  have hComp : ∀ (a b : π.W ⟶ π.W) (ga gb : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      b ≫ π.w = π.w → wcHonestFrame D ℓ π.W π.r π.θ a ga →
      wcHonestFrame D ℓ π.W π.r π.θ b gb →
      wcHonestFrame D ℓ π.W π.r π.θ (a ≫ b) (gb ∘ₗ ga) := by
    intro a b ga gb hb ha hbf
    intro s z
    have e := (wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π b hb gb hbf).2 π.W a s z
    exact e.trans (congrArg gb (ha s z))

  have hInvFr : ∀ (σ : π.W ⟶ π.W) (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      σ ≫ π.w = π.w → wcHonestFrame D ℓ π.W π.r π.θ σ g →
      ∃ (ρ : π.W ⟶ π.W) (gρ : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
        ρ ≫ π.w = π.w ∧ σ ≫ ρ = 𝟙 π.W ∧ ρ ≫ σ = 𝟙 π.W ∧
        wcHonestFrame D ℓ π.W π.r π.θ ρ gρ ∧ (∀ x, gρ (g x) = x) ∧ (∀ x, g (gρ x) = x) := by
    intro σ g hσ hfr
    obtain ⟨ρ, hρ, h1⟩ := hgal π.W σ (𝟙 π.W) π.hconn (by rw [hσ, Category.id_comp])
    obtain ⟨ρ', _, h2⟩ := hgal π.W ρ (𝟙 π.W) π.hconn (by rw [hρ, Category.id_comp])
    have hσρ' : σ = ρ' := by
      calc σ = σ ≫ 𝟙 π.W := (Category.comp_id σ).symm
        _ = σ ≫ ρ ≫ ρ' := by rw [← h2]
        _ = (σ ≫ ρ) ≫ ρ' := (Category.assoc _ _ _).symm
        _ = ρ' := by rw [← h1, Category.id_comp]
    have hρσ : ρ ≫ σ = 𝟙 π.W := by
      rw [hσρ']
      exact h2.symm
    obtain ⟨gρ, hgρ⟩ := hEx ρ
    have f1 := hComp σ ρ g gρ hρ hfr hgρ
    have f2 := hComp ρ σ gρ g hσ hgρ hfr
    rw [← h1] at f1
    rw [hρσ] at f2
    exact ⟨ρ, gρ, hρ, h1.symm, hρσ, hgρ, fun x => hIdU _ f1 x, fun x => hIdU _ f2 x⟩

  have hG : ∀ (V V' T T' : (wcP1Over F'').left.ProEt) (u : T ⟶ V) (u' : T' ⟶ V')
      (c : T ⟶ π.W) (c' : T' ⟶ π.W) (β : V ≅ V') (κ : T ≅ T') (σ : π.W ⟶ π.W)
      (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      κ.hom ≫ u' = u ≫ β.hom → σ ≫ π.w = π.w → κ.hom ≫ c' = c ≫ σ →
      wcHonestFrame D ℓ π.W π.r π.θ σ g →
      ∀ x, x ∈ wcPLInv π u c ↔ g x ∈ wcPLInv π u' c' := by
    intro V V' T T' u u' c c' β κ σ g hκu hσ hκc hfr x
    obtain ⟨ρ, gρ, hρ, hσρ, hρσ, hfρ, hgg1, hgg2⟩ := hInvFr σ g hσ hfr
    have k1 : κ.inv ≫ u ≫ β.hom = u' := by rw [← hκu, Iso.inv_hom_id_assoc]
    have k2 : κ.inv ≫ c = c' ≫ ρ := by
      calc κ.inv ≫ c = κ.inv ≫ (c ≫ σ) ≫ ρ := by rw [Category.assoc, hσρ, Category.comp_id]
        _ = c' ≫ ρ := by rw [← hκc, Category.assoc, Iso.inv_hom_id_assoc]
    constructor
    · intro hx
      refine (memInv u' c' (g x)).2 ?_
      intro τ' σ' h hτ'u hσ' hτ'c hfh
      have hτu : (κ.hom ≫ τ' ≫ κ.inv) ≫ u = u := by
        rw [← cancel_mono β.hom]
        simp only [Category.assoc]
        rw [k1, hτ'u, hκu]
      have hτc : (κ.hom ≫ τ' ≫ κ.inv) ≫ c = c ≫ σ ≫ σ' ≫ ρ := by
        simp only [Category.assoc]
        rw [k2, ← Category.assoc τ', hτ'c, Category.assoc, ← Category.assoc κ.hom, hκc,
          Category.assoc]
      have hdeck : (σ ≫ σ' ≫ ρ) ≫ π.w = π.w := by
        simp only [Category.assoc, hρ, hσ', hσ]
      have hfrm := hComp σ (σ' ≫ ρ) g (gρ ∘ₗ h) (by simp only [Category.assoc, hρ, hσ']) hfr
        (hComp σ' ρ h gρ hρ hfh hfρ)
      have e := (memInv u c x).1 hx _ _ _ hτu hdeck hτc hfrm
      have e2 := congrArg g e
      rw [LinearMap.comp_apply, LinearMap.comp_apply, hgg2] at e2
      exact e2
    · intro hgx
      refine (memInv u c x).2 ?_
      intro τ σ' h hτu hσ' hτc hfh
      have hτ'u : (κ.inv ≫ τ ≫ κ.hom) ≫ u' = u' := by
        simp only [Category.assoc]
        rw [hκu, ← Category.assoc τ, hτu, k1]
      have hτ'c : (κ.inv ≫ τ ≫ κ.hom) ≫ c' = c' ≫ ρ ≫ σ' ≫ σ := by
        simp only [Category.assoc]
        rw [hκc, ← Category.assoc τ, hτc, Category.assoc, ← Category.assoc κ.inv, k2,
          Category.assoc]
      have hdeck : (ρ ≫ σ' ≫ σ) ≫ π.w = π.w := by
        simp only [Category.assoc, hσ, hσ', hρ]
      have hfrm := hComp ρ (σ' ≫ σ) gρ (g ∘ₗ h) (by simp only [Category.assoc, hσ, hσ']) hfρ
        (hComp σ' σ h g hσ hfh hfr)
      have e := (memInv u' c' (g x)).1 hgx _ _ _ hτ'u hdeck hτ'c hfrm
      rw [LinearMap.comp_apply, LinearMap.comp_apply, hgg1] at e
      have e2 := congrArg gρ e
      rw [hgg1, hgg1] at e2
      exact e2

  obtain ⟨QV1, Qv1, QA1, _, _, _, Qe1, QT1, Qu1, Qc1, QL1, _, _, QeL1,
      QV2, Qv2, QA2, _, _, _, Qe2, QT2, Qu2, Qc2, QL2, _, _, QeL2, σ₀, g₀,
      hQV1, hQc1, hQV2, hQc2, hσ₀, hfr₀, hQ⟩ :=
    wc_pencil_PL_inv_cross_index_exists F' F'' Y n hn hn2 D ℓ hℓ hP hF π hgal i i₀

  obtain ⟨β₁, κ₁, hβ₁, hκ₁⟩ := wc_pencil_PL_sep_point_iso F'' hP (D.S i) (D.hS i)
    V₁ v₁ A₁ e₁ hV₁ T₁ u₁ L₁ eL₁ (hoffT T₁ c₁ i)
    QV1 Qv1 QA1 Qe1 hQV1 QT1 Qu1 QL1 QeL1 (hoffT QT1 Qc1 i)
  have e1 : c₁ ≫ π.w = (κ₁.hom ≫ Qc1) ≫ π.w := by
    rw [Category.assoc, ← hQc1, ← Category.assoc, hκ₁, Category.assoc, hβ₁, hc₁]
  obtain ⟨σ₁, hσ₁, hσ₁eq⟩ := hgal T₁ c₁ (κ₁.hom ≫ Qc1) (hconnT T₁ L₁ eL₁) e1
  obtain ⟨g₁, hg₁⟩ := hEx σ₁
  have hP1 := hG V₁ QV1 T₁ QT1 u₁ Qu1 c₁ Qc1 β₁ κ₁ σ₁ g₁ hκ₁ hσ₁ hσ₁eq hg₁

  obtain ⟨β₂, κ₂, hβ₂, hκ₂⟩ := wc_pencil_PL_sep_point_iso F'' hP (D.S i₀) (D.hS i₀)
    QV2 Qv2 QA2 Qe2 hQV2 QT2 Qu2 QL2 QeL2 (hoffT QT2 Qc2 i₀)
    V₂ v₂ A₂ e₂ hV₂ T₂ u₂ L₂ eL₂ (hoffT T₂ c₂ i₀)
  have e2 : Qc2 ≫ π.w = (κ₂.hom ≫ c₂) ≫ π.w := by
    rw [Category.assoc, ← hc₂, ← Category.assoc, hκ₂, Category.assoc, hβ₂, hQc2]
  obtain ⟨σ₂, hσ₂, hσ₂eq⟩ := hgal QT2 Qc2 (κ₂.hom ≫ c₂) (hconnT QT2 QL2 QeL2) e2
  obtain ⟨g₂, hg₂⟩ := hEx σ₂
  have hP2 := hG QV2 V₂ QT2 T₂ Qu2 u₂ Qc2 c₂ β₂ κ₂ σ₂ g₂ hκ₂ hσ₂ hσ₂eq hg₂

  refine ⟨σ₁ ≫ σ₀ ≫ σ₂, (g₂ ∘ₗ g₀) ∘ₗ g₁, ?_, ?_, ?_⟩
  · simp only [Category.assoc, hσ₂, hσ₀, hσ₁]
  · exact hComp σ₁ (σ₀ ≫ σ₂) g₁ (g₂ ∘ₗ g₀) (by simp only [Category.assoc, hσ₂, hσ₀]) hg₁
      (hComp σ₀ σ₂ g₀ g₂ hσ₂ hfr₀ hg₂)
  · intro x
    rw [LinearMap.comp_apply, LinearMap.comp_apply]
    exact (hP1 x).trans ((hQ (g₁ x)).trans (hP2 (g₀ (g₁ x))))

theorem wc_pencil_PL_local_hyperplane_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hF : wcPencilFamily D) (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (i i₀ : Fin D.m) :
    ∃ (σ : π.W ⟶ π.W) (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      σ ≫ π.w = π.w ∧
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
        g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z)) ∧
      ∀ x : Fin π.r → ℚ_[ℓ], dotProduct (π.δ i) (π.J.mulVec x) = 0 ↔
        dotProduct (π.δ i₀) (π.J.mulVec (g x)) = 0 :=
by
  obtain ⟨V₁, v₁, -, A₁, _, _, _, e₁, -, hV₁, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' (D.S i) (D.hS i) hP
  obtain ⟨V₂, v₂, -, A₂, _, _, _, e₂, -, hV₂, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' (D.S i₀) (D.hS i₀) hP
  obtain ⟨T₁, u₁, c₁, L₁, _, _, eL₁, hc₁, hiff₁⟩ :=
    wc_pencil_PL_hloc_sep_point F' F'' Y n hn hn2 D ℓ hℓ hP π i V₁ v₁ A₁ e₁ hV₁
  obtain ⟨T₂, u₂, c₂, L₂, _, _, eL₂, hc₂, hiff₂⟩ :=
    wc_pencil_PL_hloc_sep_point F' F'' Y n hn hn2 D ℓ hℓ hP π i₀ V₂ v₂ A₂ e₂ hV₂
  have h₁ := wc_pencil_PL_sp_img_eq_inv F' F'' Y n hn hn2 D ℓ hℓ hP π hgal i V₁ v₁ A₁ e₁ hV₁
    T₁ u₁ c₁ L₁ eL₁ hc₁
  have h₂ := wc_pencil_PL_sp_img_eq_inv F' F'' Y n hn hn2 D ℓ hℓ hP π hgal i₀ V₂ v₂ A₂ e₂ hV₂
    T₂ u₂ c₂ L₂ eL₂ hc₂
  obtain ⟨σ, g, hσ, hfr, hconj⟩ :=
    wc_pencil_PL_inertia_inv_conj F' F'' Y n hn hn2 D ℓ hℓ hP hF π hgal i i₀
      V₁ v₁ A₁ e₁ hV₁ T₁ u₁ c₁ L₁ eL₁ hc₁ V₂ v₂ A₂ e₂ hV₂ T₂ u₂ c₂ L₂ eL₂ hc₂
  refine ⟨σ, g, hσ, hfr, fun x => ?_⟩
  rw [hiff₁ x, hiff₂ (g x), h₁, h₂]
  exact hconj x

theorem wc_pencil_conj_of_family (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hF : wcPencilFamily D) (π : wcPencilPL D ℓ hP) :
    ∃ π' : wcPencilPL D ℓ hP, wcPencilConj π' :=
by
  classical
  by_cases hm : D.m = 0
  · refine ⟨π, ?_⟩
    intro i
    exfalso
    have := i.isLt
    omega
  obtain ⟨π₂, hgal⟩ := wc_pencil_PL_galois_refine F' F'' Y n hn hn2 D ℓ hℓ hP π
  let i₀ : Fin D.m := ⟨0, Nat.pos_of_ne_zero hm⟩
  choose σ g hσ hfr hiff using fun i =>
    wc_pencil_PL_local_hyperplane_conj F' F'' Y n hn hn2 D ℓ hℓ hP hF π₂ hgal i i₀
  have hext := fun i =>
    wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π₂ (σ i) (hσ i) (g i) (hfr i)
  have ha : ∀ v : Fin π₂.r → ℚ_[ℓ], dotProduct v (π₂.J.mulVec v) = 0 := by
    intro v
    have h1 : dotProduct v (π₂.J.mulVec v) = - dotProduct v (π₂.J.mulVec v) := by
      calc dotProduct v (π₂.J.mulVec v) = dotProduct (Matrix.vecMul v π₂.J) v :=
            Matrix.dotProduct_mulVec _ _ _
        _ = dotProduct (π₂.J.transpose.mulVec v) v := by rw [Matrix.mulVec_transpose]
        _ = dotProduct ((-π₂.J).mulVec v) v := by rw [π₂.hJalt]
        _ = - dotProduct v (π₂.J.mulVec v) := by
            rw [Matrix.neg_mulVec, neg_dotProduct, dotProduct_comm]
    have h2 : (2 : ℚ_[ℓ]) * dotProduct v (π₂.J.mulVec v) = 0 := by
      linear_combination h1
    exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
  refine ⟨
    { W := π₂.W, w := π₂.w, r := π₂.r, θ := π₂.θ, hθc := π₂.hθc, hqc := π₂.hqc,
      hconn := π₂.hconn, hoff := π₂.hoff, hcov := π₂.hcov, k := 1,
      γ := fun _ => π₂.γ (π₂.τ i₀), hγ := fun _ => π₂.hγ (π₂.τ i₀),
      g := fun _ => π₂.g (π₂.τ i₀), hframe := fun _ => π₂.hframe (π₂.τ i₀),
      J := π₂.J, hJalt := π₂.hJalt, hJunit := π₂.hJunit,
      hgJ := fun _ => π₂.hgJ (π₂.τ i₀),
      δ := fun _ => π₂.δ i₀, ε := fun _ => π₂.ε i₀, hε := fun _ => π₂.hε i₀,
      τ := fun _ => 0, hτ := fun _ x => π₂.hτ i₀ x,
      hspan := ?_, hloc := ?_ }, ?_⟩
  ·
    intro j y hy
    obtain ⟨x, rfl⟩ := LinearMap.mem_range.mp hy
    have hx : ((π₂.g (π₂.τ i₀) - LinearMap.id :
        (Fin π₂.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π₂.r → ℚ_[ℓ]))) x =
        (π₂.ε i₀ * dotProduct (π₂.δ i₀) (π₂.J.mulVec x)) • π₂.δ i₀ := by
      rw [LinearMap.sub_apply, π₂.hτ i₀ x, LinearMap.id_apply, add_sub_cancel_left]
    show ((π₂.g (π₂.τ i₀) - LinearMap.id :
        (Fin π₂.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π₂.r → ℚ_[ℓ]))) x ∈
      Submodule.span ℚ_[ℓ] (Set.range (fun _ : Fin D.m => π₂.δ i₀))
    rw [hx]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i₀, rfl⟩)
  ·
    intro i V v A _ _ _ e hV
    obtain ⟨V', a, b, z, hab, hinj, himg⟩ := π₂.hloc i V v A e hV
    obtain ⟨hbij, hE⟩ := hext i
    refine ⟨V', a, b ≫ σ i, z, ?_, ?_, ?_⟩
    · rw [hab, Category.assoc, hσ i]
    · intro s hs
      apply hinj s
      rw [hE] at hs
      exact hbij.1 (hs.trans (map_zero (g i)).symm)
    · intro x
      show dotProduct (π₂.δ i₀) (π₂.J.mulVec x) = 0 ↔ _
      constructor
      · intro hx
        obtain ⟨y, rfl⟩ := hbij.2 x
        obtain ⟨s, hs⟩ := (himg y).mp ((hiff i y).mpr hx)
        exact ⟨s, by rw [hE, hs]⟩
      · rintro ⟨s, hs⟩
        rw [hE] at hs
        rw [← hs]
        exact (hiff i _).mp ((himg _).mpr ⟨s, rfl⟩)
  ·
    intro i i'
    refine ⟨0, 1, one_ne_zero, ?_⟩
    show π₂.g (π₂.τ i₀) (π₂.δ i₀) = (1 : ℚ_[ℓ]) • π₂.δ i₀
    rw [π₂.hτ i₀, ha, mul_zero, zero_smul, add_zero, one_smul]

theorem wc_proet_sub_over_triv_of_coker : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt), ConnectedSpace W.left →
    ∀ (R : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (M : Subobject R) (a : ℕ),
    Nonempty (R.over W ≅ (wcContSheaf S (Fin a → ℚ_[ℓ])).over W) →
    ((∃ b : ℕ, Nonempty ((Limits.cokernel M.arrow).over W ≅
        (wcContSheaf S (Fin b → ℚ_[ℓ])).over W)) ∨ Limits.IsZero (Limits.cokernel M.arrow)) →
    ∃ k : ℕ, Nonempty ((Subobject.underlying.obj M).over W ≅
      (wcContSheaf S (Fin k → ℚ_[ℓ])).over W) :=
by
  classical
  intro S ℓ _ W hW R M a hR hQ
  obtain ⟨θR⟩ := hR
  let ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W
  rcases hQ with ⟨b, ⟨θQ⟩⟩ | hZ
  ·
    have s3 : ∀ (a b : ℕ) (L : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])),
        ∃ c : ℕ, Nonempty (Limits.kernel
          (wcContSheafMap S L.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional L)) ≅
            wcContSheaf S (Fin c → ℚ_[ℓ])) := by
      intro a b L
      have congrMap : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A]
          [IsTopologicalAddGroup A]
          [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
          (f g : A →+ B) (hf : Continuous f) (hg : Continuous g), f = g →
          wcContSheafMap S f hf = wcContSheafMap S g hg := by
        intro A B _ _ _ _ _ _ f g hf hg hfg
        subst hfg
        rfl
      let N := LinearMap.ker L
      let Rg := LinearMap.range L
      let c := Module.finrank ℚ_[ℓ] N
      let d := Module.finrank ℚ_[ℓ] Rg
      let eN : (Fin c → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] N :=
        LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
      let eR : (Fin d → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] Rg :=
        LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
      let incl : (Fin c → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]) := N.subtype ∘ₗ eN.toLinearMap
      let L' : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin d → ℚ_[ℓ]) :=
        eR.symm.toLinearMap ∘ₗ L.rangeRestrict
      let j : (Fin d → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]) := Rg.subtype ∘ₗ eR.toLinearMap
      have hincl_inj : Function.Injective incl := Subtype.val_injective.comp eN.injective
      have hj_inj : Function.Injective j := Subtype.val_injective.comp eR.injective
      have hL'surj : Function.Surjective L' :=
        eR.symm.surjective.comp L.surjective_rangeRestrict
      have hjL : ∀ v, j (L' v) = L v := by
        intro v
        show ((eR (eR.symm (L.rangeRestrict v)) : Rg) : Fin b → ℚ_[ℓ]) = L v
        rw [LinearEquiv.apply_symm_apply]
        rfl
      have hinclc : Continuous (incl.toAddMonoidHom : _ →+ _) :=
        LinearMap.continuous_of_finiteDimensional incl
      have hL'c : Continuous (L'.toAddMonoidHom : _ →+ _) :=
        LinearMap.continuous_of_finiteDimensional L'
      have hjc : Continuous (j.toAddMonoidHom : _ →+ _) :=
        LinearMap.continuous_of_finiteDimensional j
      have hemb : Topology.IsEmbedding incl :=
        (LinearMap.isClosedEmbedding_of_injective
          (LinearMap.ker_eq_bot.mpr hincl_inj)).isEmbedding
      have hexact : ∀ w, L' w = 0 ↔ ∃ u, incl u = w := by
        intro w
        have h1 : L' w = 0 ↔ L w = 0 := by
          rw [← hjL w]
          constructor
          · intro h; rw [h, map_zero]
          · intro h; exact hj_inj (h.trans (map_zero j).symm)
        rw [h1]
        constructor
        · intro h
          refine ⟨eN.symm ⟨w, LinearMap.mem_ker.mpr h⟩, ?_⟩
          show ((eN (eN.symm ⟨w, LinearMap.mem_ker.mpr h⟩) : N) : Fin a → ℚ_[ℓ]) = w
          rw [LinearEquiv.apply_symm_apply]
        · rintro ⟨u, rfl⟩
          exact LinearMap.mem_ker.mp (eN u).2
      obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective L'
        (LinearMap.range_eq_top.mpr hL'surj)
      have hsec : ∃ s : (Fin d → ℚ_[ℓ]) → (Fin a → ℚ_[ℓ]), Continuous s ∧
          ∀ y, L'.toAddMonoidHom (s y) = y :=
        ⟨σ, LinearMap.continuous_of_finiteDimensional σ, fun y => LinearMap.congr_fun hσ y⟩
      obtain ⟨hzero, hSE⟩ := wc_contSheaf_shortExact S incl.toAddMonoidHom hinclc
        L'.toAddMonoidHom hL'c hemb hexact hsec
      let κ1 : wcContSheaf S (Fin c → ℚ_[ℓ]) ≅
          Limits.kernel (wcContSheafMap S L'.toAddMonoidHom hL'c) :=
        Limits.IsLimit.conePointUniqueUpToIso hSE.fIsKernel (Limits.limit.isLimit _)
      obtain ⟨r, hr⟩ :=
        LinearMap.exists_leftInverse_of_injective j (LinearMap.ker_eq_bot.mpr hj_inj)
      have hrc : Continuous (r.toAddMonoidHom : _ →+ _) :=
        LinearMap.continuous_of_finiteDimensional r
      have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
          [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
          (f : A →+ B) (hf : Continuous f) (U : (S.ProEt)ᵒᵖ)
          (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
          (wcContSheafMap S f hf).hom.app U x =
            (ULift.up (AddMonoidHom.compLeftContinuous
              (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
                (Opposite.unop U))) f hf
              (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙
                Over.forget S).obj (Opposite.unop U)), A))) : _) := by
        intro A B _ _ _ _ _ _ f hf U x
        rfl
      have hjr : wcContSheafMap S j.toAddMonoidHom hjc ≫
          wcContSheafMap S r.toAddMonoidHom hrc = 𝟙 _ := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
          key, key]
        apply ULift.ext
        apply ContinuousMap.ext
        intro z
        exact LinearMap.congr_fun hr _
      haveI : IsSplitMono (wcContSheafMap S j.toAddMonoidHom hjc) :=
        IsSplitMono.mk' ⟨_, hjr⟩
      have hcomp : wcContSheafMap S L.toAddMonoidHom
          (LinearMap.continuous_of_finiteDimensional L) =
          wcContSheafMap S L'.toAddMonoidHom hL'c ≫
            wcContSheafMap S j.toAddMonoidHom hjc := by
        rw [← (wc_contSheafMap_comp_sub S L'.toAddMonoidHom L'.toAddMonoidHom
          hL'c hL'c j.toAddMonoidHom hjc).1]
        apply congrMap
        exact AddMonoidHom.ext fun v => (hjL v).symm
      exact ⟨c, ⟨Limits.kernelIsoOfEq hcomp ≪≫ Limits.kernelCompMono _ _ ≪≫ κ1.symm⟩⟩

    have hK := Abelian.monoIsKernelOfCokernel _ (Limits.cokernelIsCokernel M.arrow)
    let eG : Subobject.underlying.obj M ≅ Limits.kernel (Limits.cokernel.π M.arrow) :=
      Limits.IsLimit.conePointUniqueUpToIso hK (Limits.limit.isLimit _)
    obtain ⟨ψ, hψ⟩ : ∃ ψ : (wcContSheaf S (Fin a → ℚ_[ℓ])).over W ⟶
        (wcContSheaf S (Fin b → ℚ_[ℓ])).over W,
        ψ = θR.inv ≫ ρ.map (Limits.cokernel.π M.arrow) ≫ θQ.hom := ⟨_, rfl⟩
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ W hW a b ψ
    obtain ⟨c, ⟨κ⟩⟩ := s3 a b A
    have w : ρ.map (Limits.cokernel.π M.arrow) ≫ θQ.hom = θR.hom ≫ ψ := by
      rw [hψ, Iso.hom_inv_id_assoc]
    exact ⟨c, ⟨ρ.mapIso eG ≪≫ Limits.PreservesKernel.iso ρ (Limits.cokernel.π M.arrow) ≪≫
      Limits.kernel.mapIso (ρ.map (Limits.cokernel.π M.arrow)) ψ θR θQ w ≪≫
      Limits.kernelIsoOfEq hA ≪≫ (Limits.PreservesKernel.iso ρ _).symm ≪≫ ρ.mapIso κ⟩⟩
  · have hπ0 : Limits.cokernel.π M.arrow = 0 := hZ.eq_of_tgt _ _
    haveI : Epi M.arrow := Abelian.epi_of_cokernel_π_eq_zero M.arrow hπ0
    haveI : IsIso M.arrow := isIso_of_mono_of_epi M.arrow
    exact ⟨a, ⟨ρ.mapIso (asIso M.arrow) ≪≫ θR⟩⟩

theorem wc_pencil_Rq_sub_galois_trivialization (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow)) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
      (θ : (Subobject.underlying.obj M).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W),
      QuasiCompact w.left ∧ ConnectedSpace W.left ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
        a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :=
by
  classical
  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP
  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors
  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht, hgal₀⟩ :=
    wc_fet_galois_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial
  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres q
  have hR := wc_proet_Rq_rat_const_of_int_const D.f ℓ W hW₀cpt hW₀qs q a b e hZ
  have hQW : (∃ r : ℕ, Nonempty ((Limits.cokernel M.arrow).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)) ∨
      Limits.IsZero (Limits.cokernel M.arrow) := by
    rcases hM with hGC | hZ0
    · obtain ⟨r, ⟨θQ⟩⟩ := hGC
      exact Or.inl ⟨r, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
        AddCommGrpCat.{u+1} w).mapIso θQ⟩⟩
    · exact Or.inr hZ0
  obtain ⟨k, ⟨θ⟩⟩ := wc_proet_sub_over_triv_of_coker (wcP1Over F'').left ℓ W hW₀conn
    (wcRq D.f ℓ q) M a hR hQW
  refine ⟨W, w, k, θ, ?_, hW₀conn, ?_, ?_⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · intro V a' b'' hV hab
    have h1 : a'.left ≫ p ≫ Ub.ι = b''.left ≫ p ≫ Ub.ι := by
      have := congrArg (fun f => f.left) hab
      exact this
    have h2' : (a'.left ≫ p) ≫ Ub.ι = (b''.left ≫ p) ≫ Ub.ι := by
      have e1 := Category.assoc a'.left p Ub.ι
      have e2 := Category.assoc b''.left p Ub.ι
      exact e1.trans (h1.trans e2.symm)
    have h2 : a'.left ≫ p = b''.left ≫ p := (cancel_mono Ub.ι).1 h2'
    obtain ⟨γ₀, hγp, hγb⟩ := hgal₀ V.left a'.left b''.left hV h2
    let γ : W ⟶ W := MorphismProperty.Over.homMk γ₀
      (show γ₀ ≫ p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, hγp]) trivial
    refine ⟨γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show γ₀ ≫ p ≫ Ub.ι = p ≫ Ub.ι
      rw [← Category.assoc, hγp]
    · apply MorphismProperty.Over.Hom.ext
      show b''.left = a'.left ≫ γ₀
      exact hγb

theorem wc_honest_local_point_exists (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
