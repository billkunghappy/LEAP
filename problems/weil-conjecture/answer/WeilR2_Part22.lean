    have hspec : SpecializingMap (Limits.pullback.fst x.left w.left) := by
      intro a b hab
      obtain ⟨a'', ha''⟩ := hsurj b
      have hab' : Limits.pullback.fst x.left w.left a ⤳ Limits.pullback.fst x.left w.left a'' := by
        rw [ha'']; exact hab
      obtain ⟨a₀, ha₀, hfa₀⟩ := Flat.generalizingMap (Limits.pullback.fst x.left w.left) hab'
      obtain ⟨φ, hφ, hφa⟩ := htr a₀ a hfa₀
      refine ⟨φ a'', ?_, ?_⟩
      · show a ⤳ φ a''
        rw [← hφa]
