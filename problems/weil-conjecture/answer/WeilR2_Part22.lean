theorem wc_tps_local_algebra (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy : (wcProjK F'' M').ProEt)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F''))) :
    ∃ f : A, IsNoetherianRing A ∧ IsRegularLocalRing A ∧ IsDomain A ∧
      f ∈ IsLocalRing.maximalIdeal A ∧ f ∉ IsLocalRing.maximalIdeal A ^ 2 ∧
      IsDomain (A ⧸ Ideal.span {f}) ∧ IsRegularLocalRing (A ⧸ Ideal.span {f}) ∧
      (∀ q : PrimeSpectrum A, Vy.hom (e.inv q) ∈ Δ ↔ f ∈ q.asIdeal) ∧
      ((ringChar F'' : A) = 0) :=
by
  classical

  have hlamstr : lam ≫ wcProjKStr F'' M' = (wcP1Over F'').hom := hH.2.2.2.2.2.2.2.2.1
  obtain ⟨U, hU, φ, hΔ, hspan⟩ := hH.2.2.2.2.2.2.2.2.2.2.2.2 j

  have s3 : ∀ (R S : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S]
      (lamS : R →+* S), IsLocalHom lamS → ∀ c : R,
      IsLocalRing.maximalIdeal S = Ideal.span {lamS c} → ¬ IsField S →
      c ∈ IsLocalRing.maximalIdeal R ∧ c ∉ IsLocalRing.maximalIdeal R ^ 2 := by
    intro R S _ _ _ _ lamS hloc c hsp hnf
    constructor
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
