    have hmdvd : m ∣ addOrderOf (θ ≫ T.mor₁⟦R⟧') :=
      hdet _ (by rw [← Preadditive.comp_nsmul, addOrderOf_nsmul_eq_zero, Limits.comp_zero])
    have hle1 : addOrderOf (θ ≫ T.mor₁⟦R⟧') ≤ Nat.card (QS ⟶ T.obj₂⟦R⟧) := addOrderOf_le_card
    have hmle : m ≤ addOrderOf (θ ≫ T.mor₁⟦R⟧') := Nat.le_of_dvd hopos hmdvd
    have hord : addOrderOf (θ ≫ T.mor₁⟦R⟧') = Nat.card (QS ⟶ T.obj₂⟦R⟧) := by omega
    have hom : addOrderOf (θ ≫ T.mor₁⟦R⟧') = m := by omega
    have htop : AddSubgroup.zmultiples (θ ≫ T.mor₁⟦R⟧') = ⊤ := by
      apply AddSubgroup.eq_top_of_card_eq
      rw [Nat.card_zmultiples, hord]
    have hvmem : v ∈ AddSubgroup.zmultiples (θ ≫ T.mor₁⟦R⟧') := by
      rw [htop]; exact AddSubgroup.mem_top v
    obtain ⟨z, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hvmem
    have h1 : z.natAbs • (ι ≫ (θ ≫ T.mor₁⟦R⟧')) = 0 := by
      rw [natAbs_nsmul_eq_zero, ← Preadditive.comp_zsmul]
      exact hv
    have h2 : addOrderOf (θ ≫ T.mor₁⟦R⟧') ∣ z.natAbs := by
      rw [hom]; exact hdet _ h1
    exact natAbs_nsmul_eq_zero.mp (addOrderOf_dvd_iff_nsmul_eq_zero.mp h2)
  have key : ∀ {𝒞 : Type _} [Category 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory 𝒞}
      (N : ℕ) (R : ℤ) (_hR : R = (N : ℤ) + (N : ℤ)) (_hN : 1 ≤ N) (m : ℕ) (One Sx : 𝒞)
      (Ψ : CochainComplex 𝒞 ℤ)
      (eΨ : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One ⟶ Ψ) (ιs : One ⟶ Sx),
      Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(N : ℤ)⟧ ≅
        DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)) →
      (Finite (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
          (DerivedCategory.Q.obj Ψ)⟦R⟧) ∧
        Nat.card (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
          (DerivedCategory.Q.obj Ψ)⟦R⟧) ≤ m) →
      (∃ θ : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One))⟦R⟧,
        ∀ j : ℕ, j • (DerivedCategory.Q.map ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ιs) ≫ θ) = 0 →
          m ∣ j) →
      (∀ q : ℤ, 0 < q → ∀ f : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx))⟦q⟧, f = 0) →
      (N = 1 → ∀ g : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) ⟶
          (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(N : ℤ)⟧,
        ∃ b' : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) ⟶
          (DerivedCategory.Q.obj Ψ)⟦(N : ℤ)⟧,
          g = b' ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦(N : ℤ)⟧') →
      ∀ v : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
          (DerivedCategory.Q.obj Ψ)⟦R⟧,
        DerivedCategory.Q.map ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ιs) ≫ v = 0 →
          v = 0 := by
    intro 𝒞 _ _ _hD N R hR hN m One Sx Ψ eΨ ιs hz hcard hpt hvan hnode v hv
    exact abs (DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle eΨ))
      (DerivedCategory.mappingCone_triangle_distinguished eΨ)
      (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx))
      (DerivedCategory.Q.map ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ιs))
      N R hR hN m hz hcard hpt hvan hnode v hv
  have hζ := wc_et_tpl_vanishing_point F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
    x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have hcard := wc_et_tpl_top_supp_card_le F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne
    ξ hξ x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have hpt := wc_et_tpl_odp_point_class_order F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb
    hηne ξ hξ x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have hvan := wc_et_tpl_point_push_ext_vanish F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb
    hηne ξ hξ x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have hnode := fun h2 : n = 2 => wc_et_tpl_node_cone_surj F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a
    hA η hηb hηne ξ hξ x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx h2
  intro P K eK eΨ Ψ hb v hv
  exact key (n - 1) (((2 * (n - 1)) : ℕ) : ℤ) (by omega) (by omega) (ℓ ^ k) _ _ _ _
    (wcEtSuppUnitMap Dx) hζ hcard hpt hvan (fun _ g => hnode (by omega) hb g) v hv

theorem wc_quad_cone_node_vertex_geom_supp_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : K) ≠ 0 → ∀ (c : Matrix (Fin 2) (Fin 2) K), IsUnit (c + c.transpose).det → ∀ (Ω : Type u) [Field Ω] (i : Spec (.of Ω) ⟶ Spec (.of (wcQuadModelRing K 2 0 c))) [IsClosedImmersion i], (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (i (IsLocalRing.closedPoint Ω))) → ∀ (D : wcEtPullData i ℓ), Finite (wcEtSuppExt D 1) ∧ Nat.card (wcEtSuppExt D 1) ≤ ℓ :=
by
  classical
  intro K _ _ ℓ _ hℓ c hc Ω _ i _ hvert D
  have hp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hp.pos

  have hopen : IsOpen {y : Spec (.of (wcQuadModelRing K 2 0 c)) |
      ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∉ y.asIdeal} := by
    rw [Set.setOf_exists]
    exact isOpen_iUnion fun p => PrimeSpectrum.isOpen_basicOpen
  let Oc : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens := ⟨_, hopen⟩

  have hrange : Set.range Oc.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι]
    ext y
    constructor
    · rintro ⟨p, hp'⟩ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      subst hz
      exact hp' (hvert p)
    · intro hy
      by_contra h
      have h' : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∈ y.asIdeal := by
        intro p
        by_contra hq
        exact h ⟨p, hq⟩
      have hyv := (wc_lup_quad_cone_vertex K 2 c).1 y (i (IsLocalRing.closedPoint Ω)) h' hvert
      exact hy ⟨_, hyv.symm⟩

  obtain ⟨-, A, B, hA, hB, hAB, hU, hAn, hBn, hAc, hBc⟩ := wc_quad_cone_dim_two_pieces K c hc Oc rfl
  have hcov : ∀ z : (Oc : Scheme.{u}), Oc.ι z ∈ A ∨ Oc.ι z ∈ B := by
    intro z
    have h : Oc.ι z ∈ Set.range Oc.ι := ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι, ← hU] at h
    exact h
  have hconn : ∀ (P : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) (hPo : IsOpen P),
      P ⊆ (Oc : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) → P.Nonempty → _root_.IsPreconnected P →
      Nat.card (wcEtZModExt ((Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
        (Oc : Scheme.{u}).Opens) : Scheme.{u}) ℓ 0) = ℓ := by
    intro P hPo hPsub hPn hPc
    have hsub : P ⊆ Set.range Oc.ι := by rw [Scheme.Opens.range_ι]; exact hPsub
    have hPc' : _root_.IsPreconnected (Oc.ι ⁻¹' P) :=
      hPc.preimage_of_isOpenMap Oc.ι.isOpenEmbedding.injective Oc.ι.isOpenEmbedding.isOpenMap hsub
    haveI hpre : PreconnectedSpace ((Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
        (Oc : Scheme.{u}).Opens) : Scheme.{u}) := by
      rw [preconnectedSpace_iff_univ,
        ← (Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι.isOpenEmbedding.isInducing.isPreconnected_image,
        Set.image_univ, Scheme.Opens.range_ι]
      exact hPc'
    obtain ⟨a, ha⟩ := hPn
    obtain ⟨a', ha'⟩ := hsub ha
    have ha'r : a' ∈ Set.range (Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι := by
      rw [Scheme.Opens.range_ι]
      show Oc.ι a' ∈ P
      rw [ha']
      exact ha
    obtain ⟨w, -⟩ := ha'r
    haveI hne : Nonempty ((Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
        (Oc : Scheme.{u}).Opens) : Scheme.{u}) := ⟨w⟩
    haveI : ConnectedSpace ((Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
        (Oc : Scheme.{u}).Opens) : Scheme.{u}) :=
      { toPreconnectedSpace := hpre, toNonempty := hne }
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv
      ((Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
        (Oc : Scheme.{u}).Opens) : Scheme.{u}) ℓ 0
    rw [Nat.card_congr E]
    exact wc_et_coh_zero_connected_card _ ℓ hp.ne_zero
  have hdisj : Disjoint (Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens))
      (Oc.ι ⁻¹ᵁ (⟨B, hB⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)) := by
    rw [← TopologicalSpace.Opens.coe_disjoint, Set.disjoint_left]
    intro z hz1 hz2
    exact Set.disjoint_left.mp hAB hz1 hz2
  have hsup : Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) ⊔
      Oc.ι ⁻¹ᵁ (⟨B, hB⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) = ⊤ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top]
    ext z
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    exact hcov z
  obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists
    (Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι ℓ
  obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists
    (Oc.ι ⁻¹ᵁ (⟨B, hB⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι ℓ
  have hbij := wc_et_zmodext_clopen_split (Oc : Scheme.{u}) _ _ hdisj hsup ℓ hℓpos DU DV 0
  have hAcard := hconn A hA (by rw [← hU]; exact Set.subset_union_left) hAn hAc
  have hBcard := hconn B hB (by rw [← hU]; exact Set.subset_union_right) hBn hBc
  have hO : Nat.card (wcEtZModExt (Oc : Scheme.{u}) ℓ 0) = ℓ * ℓ := by
    rw [Nat.card_congr (Equiv.ofBijective _ hbij), Nat.card_prod, hAcard, hBcard]

  obtain ⟨hC0, hCq⟩ := wc_et_quadric_cone_acyclic K ℓ hp hℓ 2 c
  obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ 0
  have hC : Nat.card (wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ 0) = ℓ :=
    (Nat.card_congr E0).trans hC0
  haveI := hCq (0 + 1) (by omega)
  obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ (0 + 1)
  haveI := E1.subsingleton

  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists Oc.ι ℓ
  have hinj1 : Function.Injective (wcEtPull Dj (0 + 1)) := Function.injective_of_subsingleton _
  have hone : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n),
      wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing S' n))) := by
    intro S S' g n D
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S n))))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) =
      Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S' n)))
    rw [Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Category.id_comp, Iso.inv_hom_id]
  have hne1 : (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
      (𝟙 (SheafOfModules.unit (wcEtZModRing (Oc : Scheme.{u}) ℓ))) :
        wcEtZModExt (Oc : Scheme.{u}) ℓ 0) ≠ 0 := by
    intro h0
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Oc : Scheme.{u}) ℓ)) := HasExt.standard _
    have hz : ∀ x : wcEtZModExt (Oc : Scheme.{u}) ℓ 0, x = 0 := by
      intro x
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing (Oc : Scheme.{u}) ℓ))))
            (add_zero 0) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
    have hsub : Subsingleton (wcEtZModExt (Oc : Scheme.{u}) ℓ 0) :=
      ⟨fun x y => (hz x).trans (hz y).symm⟩
    haveI := hsub
    have hle := Finite.card_le_one_iff_subsingleton.mpr hsub
    rw [hO] at hle
    have h2 := hp.two_le
    nlinarith
  haveI hfinC : Finite (wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ 0) :=
    Nat.finite_of_card_ne_zero (by rw [hC]; exact hp.ne_zero)
  have hinj0 : Function.Injective (wcEtPull Dj 0) := by
    have hdvd : Nat.card (wcEtPull Dj 0).ker ∣ ℓ := by
      have h := AddSubgroup.card_addSubgroup_dvd_card (wcEtPull Dj 0).ker
      rwa [hC] at h
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | h1
    · rw [← AddMonoidHom.ker_eq_bot_iff]
      exact AddSubgroup.card_eq_one.mp h1
    · exfalso
      have htop : (wcEtPull Dj 0).ker = ⊤ :=
        (AddSubgroup.card_eq_iff_eq_top (wcEtPull Dj 0).ker).mp (h1.trans hC.symm)
      apply hne1
      rw [← hone Dj]
      have hmem : (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ))) :
            wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ 0) ∈ (wcEtPull Dj 0).ker := by
        rw [htop]; exact AddSubgroup.mem_top _
      exact hmem

  have hT : ∃ T : Finset (wcEtZModExt (Oc : Scheme.{u}) ℓ 0), T.card ≤ ℓ ∧
      ∀ y : wcEtZModExt (Oc : Scheme.{u}) ℓ 0, ∃ t ∈ T,
        ∃ w : wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) ℓ 0, y = t + wcEtPull Dj 0 w := by
    have hN : Nat.card (wcEtPull Dj 0).range = ℓ :=
      (Nat.card_congr (AddMonoidHom.ofInjective hinj0).toEquiv.symm).trans hC
    haveI : Finite (wcEtZModExt (Oc : Scheme.{u}) ℓ 0) :=
      Nat.finite_of_card_ne_zero (by rw [hO]; exact mul_ne_zero hp.ne_zero hp.ne_zero)
    have hQ : Nat.card (wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range) = ℓ := by
      have h := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (wcEtPull Dj 0).range
      rw [hO, hN] at h
      exact (Nat.eq_of_mul_eq_mul_right hℓpos h).symm
    haveI : Finite (wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range) :=
      Finite.of_surjective _ QuotientAddGroup.mk_surjective
    letI := Fintype.ofFinite (wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range)
    refine ⟨(Finset.univ : Finset (wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range)).image
      (fun z => Quotient.out z), ?_, ?_⟩
    · calc _ ≤ (Finset.univ : Finset (wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range)).card :=
            Finset.card_image_le
        _ = ℓ := by rw [Finset.card_univ, ← Nat.card_eq_fintype_card, hQ]
    · intro y
      refine ⟨Quotient.out (y : wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range),
        Finset.mem_image_of_mem _ (Finset.mem_univ _), ?_⟩
      have h1 : ((Quotient.out (y : wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range) :
          wcEtZModExt (Oc : Scheme.{u}) ℓ 0) : wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range) =
          (y : wcEtZModExt (Oc : Scheme.{u}) ℓ 0 ⧸ (wcEtPull Dj 0).range) :=
        QuotientAddGroup.out_eq' _
      rw [QuotientAddGroup.eq] at h1
      obtain ⟨w, hw⟩ := AddMonoidHom.mem_range.mp h1
      exact ⟨w, by rw [hw, add_neg_cancel_left]⟩

  exact wc_et_supp_card_of_restr i Oc.ι hrange ℓ hℓpos D Dj 0 ℓ hinj1 hT

theorem wc_et_tpl_lp_loc_card_ell_node (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (h2 : n = 2)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x) :
    ∀ D₁ : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) ℓ,
      Finite (wcEtSuppExt D₁ (n - 1)) ∧ Nat.card (wcEtSuppExt D₁ (n - 1)) ≤ ℓ :=
by
  classical
  subst h2
  intro D₁
  show Finite (wcEtSuppExt D₁ 1) ∧ Nat.card (wcEtSuppExt D₁ 1) ≤ ℓ

  obtain ⟨hdom, hdvr, hℓA, π, c, hπ, hc, U, jU, eU, hjU, heU, hsq, u, hux, hu⟩ :=
    wc_et_tpl_morse_chart_A_pt F' F'' Y 2 hn hn2 D ℓ hℓ i A Λ W' φ a hA x hx
  obtain ⟨W, hWaff, φW, hφW, ψ, hψ, w₀, h1, h2, h3, h4', h5, h6⟩ :=
    wc_closed_fibre_quad_cone_chart A 2 π c hπ hc (Limits.pullback D.f a) U
      (Limits.pullback.snd D.f a) jU eU hjU heU hsq u hu xs (hxs.trans hux.symm)
  haveI := hWaff
  haveI := hφW
  haveI := hψ

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_halsh_finite_point_residue_algClosed F'' (wcP1Over F'').left (D.S i) A Λ W' φ a hA
  haveI hxbar : IsClosedImmersion (wcEtGeomPt (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)) xs) :=
    wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y 2 D i A Λ W' φ a hA x hx xs hxs
  have hxpt : (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)) xs) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
        (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))) = xs := by
    first
    | exact Scheme.fromSpecResidueField_apply xs _
    | (simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply])
  obtain ⟨v₀, hv₀, hv₀pt⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)).residueField xs)) φW
    (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs)
    w₀ (h1.trans hxpt.symm)
  haveI : IsClosedImmersion v₀ := by
    haveI : IsClosedImmersion (v₀ ≫ φW) := by rw [hv₀]; infer_instance
    exact IsClosedImmersion.of_comp v₀ φW
  have hL4 := wc_et_tpl_sfu_geom_pt_base_closed F' F'' Y 2 D i A Λ W' φ a hA x hx xs hxs
  haveI : IsClosedImmersion (v₀ ≫ ψ) := by
    haveI : IsClosedImmersion ((v₀ ≫ ψ) ≫ wcQuadModelStr (IsLocalRing.ResidueField A) 2 0
        (c.map (IsLocalRing.residue A))) := by
      rw [Category.assoc, ← h5, ← Category.assoc, hv₀]
      exact hL4
    exact IsClosedImmersion.of_comp (v₀ ≫ ψ) (wcQuadModelStr (IsLocalRing.ResidueField A) 2 0
      (c.map (IsLocalRing.residue A)))

  obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₀ ℓ
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (v₀ ≫ ψ) ℓ
  obtain ⟨ε₁⟩ := wc_et_point_supp_ext_etale_excision _ _ W φW _ v₀ hv₀ (by
      intro v hv
      rw [hv₀pt]
      apply h2
      rw [hv, hxpt]) ℓ D₁ Dv 1
  obtain ⟨ε₂⟩ := wc_et_point_supp_ext_etale_excision _ _ W ψ (v₀ ≫ ψ) v₀ rfl (by
      intro w hw
      rw [hv₀pt]
      apply h3
      rw [hw]
      show ψ (v₀ _) = ψ w₀
      rw [hv₀pt]) ℓ D' Dv 1

  have hℓκ : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have h := hℓA.map (IsLocalRing.residue A)
    rw [map_natCast] at h
    exact h.ne_zero
  obtain ⟨hfin, hcard⟩ := wc_quad_cone_node_vertex_geom_supp_card_le
    (IsLocalRing.ResidueField A) ℓ hℓκ (c.map (IsLocalRing.residue A)) h6 _ (v₀ ≫ ψ) (by
      intro p
      show _ ∈ PrimeSpectrum.asIdeal (ψ (v₀ _))
      rw [hv₀pt]
      exact h4' p) D'
  haveI := hfin
  let ε := ε₁.trans ε₂.symm
  exact ⟨Finite.of_equiv _ ε.symm, by rw [Nat.card_congr ε]; exact hcard⟩

theorem wc_et_tpl_lp_loc_card_ell_odp (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (h4 : 4 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x) :
    ∀ D₁ : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) ℓ,
      Finite (wcEtSuppExt D₁ (n - 1)) ∧ Nat.card (wcEtSuppExt D₁ (n - 1)) ≤ ℓ :=
by
  classical
  intro D₁
  have hℓ0 : 0 < ℓ := (Fact.out : ℓ.Prime).pos

  have hrng_gen : ∀ (Z : Scheme.{u}) (z : Z), Set.range (wcEtGeomPt Z z) = {z} := by
    intro Z z
    apply (Set.Nonempty.subset_singleton_iff (Set.range_nonempty_iff_nonempty.mpr
      ⟨IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField z))⟩)).mp
    rintro _ ⟨w, rfl⟩
    have h1 : (Z.fromSpecResidueField z) (Spec.map (CommRingCat.ofHom
        (algebraMap (Z.residueField z) (AlgebraicClosure (Z.residueField z)))) w) ∈
        Set.range (Z.fromSpecResidueField z) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at h1
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact h1
  haveI hcl0 := wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs

  have hv : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)),
      Limits.pullback.snd D.f a (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
        IsLocalRing.closedPoint A := by
    intro z
    have hc := congrArg (fun φ => φ z)
      (Limits.pullback.condition (f := Limits.pullback.snd D.f a) (g := wcQmSp A))
    simp only [Scheme.Hom.comp_apply] at hc
    rw [hc]
    show Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) _ = _
    rw [Spec.map_apply, CommRingCat.hom_ofHom]
    exact IsLocalRing.PrimeSpectrum.comap_residue _ _
  have hxA : Limits.pullback.snd D.f a x = IsLocalRing.closedPoint A := by
    rw [← hxs]; exact hv xs
  have haclosed : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    obtain ⟨ε, -, hε⟩ := hA.2.2.2.2.2
    have h5 : Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom ε)
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F'')))))) =
        IsLocalRing.closedPoint A := by
      rw [Spec.map_apply, CommRingCat.hom_ofHom]
      exact IsLocalRing.PrimeSpectrum.comap_residue _ _
    have h4 : wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) ∈
        Set.range (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))) := ⟨_, rfl⟩
    rw [hrng_gen] at h4
    have e1 : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a)
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) =
        a (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom ε)
          (IsLocalRing.closedPoint (AlgebraicClosure
            ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))))) :=
      (Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)
    have e2 : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a)
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))
          (IsLocalRing.closedPoint (AlgebraicClosure
            ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) := by
      rw [hε]
    calc a (IsLocalRing.closedPoint A)
        = a (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom ε)
          (IsLocalRing.closedPoint (AlgebraicClosure
            ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))))) :=
          (congrArg (fun p => a p) h5).symm
      _ = _ := e1.symm.trans e2
      _ = D.S i (IsLocalRing.closedPoint F'') := Set.mem_singleton_iff.mp h4
  haveI hWa : WeaklyEtale a := wc_shdata_weaklyEtale _ A Λ W' φ a hA
  let V : (wcP1Over F'').left.ProEt := Scheme.ProEt.mk a
  let e : V.left ≅ Spec (.of A) := Iso.refl (Spec (.of A))
  have hei : e.inv (IsLocalRing.closedPoint A) = IsLocalRing.closedPoint A := rfl
  have hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') := by
    rw [hei]; exact haclosed
  let σ : Limits.pullback D.f a ≅ Limits.pullback V.hom D.f := Limits.pullbackSymmetry D.f a
  have hσfst : σ.hom ≫ Limits.pullback.fst V.hom D.f = Limits.pullback.snd D.f a :=
    Limits.pullbackSymmetry_hom_comp_fst D.f a
  have hσsnd : σ.hom ≫ Limits.pullback.snd V.hom D.f = Limits.pullback.fst D.f a :=
    Limits.pullbackSymmetry_hom_comp_snd D.f a
  have eq₁ : Limits.pullback.snd D.f a ≫ 𝟙 _ =
      σ.hom ≫ (Limits.pullback.fst V.hom D.f ≫ e.hom) := by
    rw [Category.comp_id, ← Category.assoc, hσfst]
    exact (Category.comp_id _).symm
  obtain ⟨τ, hτiso, hτfst, hτsnd⟩ : ∃ τ : Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A) ⟶
      Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A),
      IsIso τ ∧
      τ ≫ Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) =
        Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) ≫ σ.hom ∧
      τ ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) =
        Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A) :=
    ⟨Limits.pullback.map (Limits.pullback.snd D.f a) (wcQmSp A)
        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) σ.hom
        (𝟙 _) (𝟙 _) eq₁ ((Category.comp_id _).trans (Category.id_comp _).symm),
      inferInstance, Limits.pullback.lift_fst _ _ _,
      (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)⟩
  haveI := hτiso
  let x' : ((wcProEtPullback D.f).obj V).left := σ.hom x
  have hx₁ : Limits.pullback.fst V.hom D.f x' = e.inv (IsLocalRing.closedPoint A) := by
    have h := Scheme.Hom.comp_apply σ.hom (Limits.pullback.fst V.hom D.f) x
    rw [hσfst] at h
    rw [hei]
    exact h.symm.trans hxA
  have hx₂ : Limits.pullback.snd V.hom D.f x' = D.xs i (IsLocalRing.closedPoint F'') := by
    have h := Scheme.Hom.comp_apply σ.hom (Limits.pullback.snd V.hom D.f) x
    rw [hσsnd] at h
    exact h.symm.trans hx
  have hxs' : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) (τ xs) = x' := by
    have h := Scheme.Hom.comp_apply (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))
      σ.hom xs
    have h2 := Scheme.Hom.comp_apply τ
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs
    rw [hτfst] at h2
    exact h2.symm.trans (h.trans (congrArg (fun t => σ.hom t) hxs))
  have hτinj : ∀ v w : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)),
      τ v = τ w → v = w := by
    intro v w h
    calc v = (asIso τ).inv ((asIso τ).hom v) := (Scheme.hom_inv_apply (asIso τ) v).symm
      _ = (asIso τ).inv ((asIso τ).hom w) := congrArg (fun t => (asIso τ).inv t) h
      _ = w := Scheme.hom_inv_apply (asIso τ) w

  have hgeom := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x' hx₁ hx₂ (τ xs) hxs'
  have hcl := hgeom.1
  haveI := hgeom.2.2.1
  haveI : CompactSpace ↥(Limits.pullback V.hom D.f) :=
    (wc_pencil_nbhd_qcqs F' F'' Y n D V A e).1
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : CompactSpace ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
    QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
  let O : (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens := ⟨{τ xs}ᶜ, hcl.isOpen_compl⟩
  have hO : (O : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))) = {τ xs}ᶜ := rfl

  let xb := wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs
  haveI : IsClosedImmersion (xb ≫ τ) := inferInstance
  have hxbpt : ∀ p, xb p = xs := by
    intro p
    have hp : wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A))
        xs p ∈ Set.range (wcEtGeomPt (Limits.pullback (C := Scheme.{u})
          (Limits.pullback.snd D.f a) (wcQmSp A)) xs) := ⟨p, rfl⟩
    rw [hrng_gen] at hp
    exact hp
  have hrng' : Set.range (xb ≫ τ) = {τ xs} := by
    ext w
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨p, rfl⟩
      exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg (fun t => τ t) (hxbpt p))
    · rintro rfl
      exact ⟨IsLocalRing.closedPoint _,
        (Scheme.Hom.comp_apply _ _ _).trans (congrArg (fun t => τ t) (hxbpt _))⟩
  have hOr : (O : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))) = (Set.range (xb ≫ τ))ᶜ := by
    rw [hrng']
    exact hO
  obtain ⟨Dx'⟩ := wc_et_zmod_pull_data_exists (xb ≫ τ) ℓ

  haveI : Etale τ := inferInstance
  obtain ⟨E₁⟩ := wc_et_point_supp_ext_etale_excision _ _ _ τ (xb ≫ τ) xb rfl
    (fun v hv' => hτinj _ _ (hv'.trans (Scheme.Hom.comp_apply _ _ _))) ℓ Dx' D₁ (n - 1)

  obtain ⟨Ψ, hΨ⟩ := wc_et_proet_free_coker_supp_ext_inj (xb ≫ τ) O hOr ℓ hℓ0 Dx' (n - 1)

  have hexc := wc_pmn_lup_odp_supp_cone_excision F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x' hx₁ hx₂
    (τ xs) hxs' O hO
  have hℓk := hexc.1
  haveI := wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  have hOcex : ∀ (c : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField A)),
      ∃ Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c))).Opens,
        (Oc : Set (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 c)))) =
          {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 c)
            (MvPolynomial.X p) ∉ y.asIdeal} := by
    intro c
    refine ⟨⟨{y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0 c)
            (MvPolynomial.X p) ∉ y.asIdeal}, ?_⟩, rfl⟩
    rw [Set.setOf_exists]
    exact isOpen_iUnion fun p => PrimeSpectrum.isOpen_basicOpen
  let c := hexc.2.choose
  have hc : IsUnit (c + c.transpose).det := hexc.2.choose_spec.1
  have hmod := hexc.2.choose_spec.2
  let Oc := (hOcex c).choose
  have hOc := (hOcex c).choose_spec
  have h5 := wc_quad_cone_vertex_supp_mid_counts (IsLocalRing.ResidueField A) ℓ hℓk n hn hn2
    c hc Oc hOc
  have E₂ := (hmod Oc hOc 1 (n - 1)).some
  have hfin1 := (h5 1 le_rfl).1
  have hcard1 := (h5 1 le_rfl).2
  haveI := hfin1
  have hfinP := Finite.of_equiv _ E₂.symm
  have hcardP := (Nat.card_congr E₂).trans hcard1
  rw [pow_one] at hfinP hcardP

  haveI := hfinP
  haveI hfinD : Finite (wcEtSuppExt Dx' (n - 1)) := Finite.of_injective Ψ hΨ
  refine ⟨Finite.of_equiv _ E₁, ?_⟩
  calc Nat.card (wcEtSuppExt D₁ (n - 1)) = Nat.card (wcEtSuppExt Dx' (n - 1)) :=
        (Nat.card_congr E₁).symm
    _ ≤ _ := Nat.card_le_card_of_injective Ψ hΨ
    _ = ℓ := hcardP

theorem wc_et_supp_open_les_pos : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (O : Y.Opens), (O : Set Y) = (Set.range i)ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D : wcEtPullData i m) (Dj : wcEtPullData O.ι m) (s k : ℕ), 1 + s = k → ∃ δ : wcEtZModExt O.toScheme m s →+ wcEtSuppExt D k, ∀ b, δ b = 0 ↔ ∃ v : wcEtZModExt Y m s, wcEtPull Dj s v = b :=
by
  classical
  intro Y Z i _ O hO m hm D Dj s k h
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing O.toScheme m)) := HasExt.standard _
  letI : Dj.Φ.Additive := Dj.additive
  letI : Limits.PreservesFiniteLimits Dj.Φ := Dj.presLim
  letI : Limits.PreservesFiniteColimits Dj.Φ := Dj.presColim
  haveI hepi : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
  have hrange : Set.range O.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι, hO]

  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D))
      (show Mono (Limits.kernel.ι (wcEtSuppUnitMap D)) from inferInstance)
      (show Epi (wcEtSuppUnitMap D) from hepi)

  have hB0 : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
    have hsq := IsPullback.of_hasPullback i O.ι
    haveI : IsClosedImmersion (Limits.pullback.snd i O.ι) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    have hE : IsEmpty ↥(Limits.pullback i O.ι : Scheme.{u}) := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [hrange]
      exact disjoint_compl_right
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i O.ι) m
    obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change i O.ι (Limits.pullback.snd i O.ι)
      (Limits.pullback.fst i O.ι) hsq D Dj D'
    have hZ' : Limits.IsZero (wcEtSuppObj D') := by
      rw [Limits.IsZero.iff_id_eq_zero]
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd i O.ι) m D' V.unop
        (fun _ ⟨p, _⟩ => hE.false p)
      exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
    have h0 : Dj.μ.inv ≫ Dj.Φ.map (wcEtSuppUnitMap D) = 0 := by
      rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
    haveI : Dj.Φ.IsLeftAdjoint := Dj.adj.isLeftAdjoint
    haveI : Epi (Dj.Φ.map (wcEtSuppUnitMap D)) := Dj.Φ.map_epi _
    exact Limits.IsZero.of_epi_eq_zero _ h0
  have hSΦ := hS.map_of_exact Dj.Φ
  haveI hιiso : IsIso (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
    hSΦ.isIso_f_iff.mpr hB0
  obtain ⟨c, hcdef⟩ : ∃ c, c = Dj.μ.inv ≫ inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
    ⟨_, rfl⟩
  haveI hciso : IsIso c := by rw [hcdef]; infer_instance
  have hc1 : c ≫ Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dj.μ.inv := by
    rw [hcdef, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y m)) :=
    sheafOfModules_enoughInjectives _ _
  have hbij : ∀ k : ℕ, Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y m)) k =>
      (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp
        (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) := by
    intro k
    have hA : Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y m)) k => Abelian.Ext.mapExactFunctor Dj.Φ x) := by
      have h := ext_transfer_of_corep Dj.Φ (Limits.kernel (wcEtSuppUnitMap D))
        (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
        (fun Y' => wc_et_open_restr_ker_corep i O.ι hrange m hm D Dj Y')
        (fun I _ n e => by
          haveI : Injective (Dj.Φ.obj I) :=
            wc_et_open_pull_preserves_injective O.ι m Dj I inferInstance
          exact Abelian.Ext.eq_zero_of_injective e)
        (SheafOfModules.unit (wcEtZModRing Y m)) k
      have e : (fun β : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing Y m)) k =>
          (Abelian.Ext.mk₀ (𝟙 (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))))).comp
            (Abelian.Ext.mapExactFunctor Dj.Φ β) (zero_add k)) =
          fun β => Abelian.Ext.mapExactFunctor Dj.Φ β :=
        funext fun β => Abelian.Ext.mk₀_id_comp _
      rw [e] at h
      exact h
    have hB : Function.Bijective (fun y : Abelian.Ext (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
        (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y m))) k =>
        (Abelian.Ext.mk₀ c).comp (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨fun z => ((Abelian.Ext.mk₀ (inv c)).comp z (zero_add k)).comp
        (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero k), ?_, ?_⟩
      · intro y
        simp only
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      · intro z
        simp only
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    exact hB.comp hA

  let Ψ : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y m)) k →+ wcEtZModExt O.toScheme m k := fun k =>
    ((Abelian.Ext.mk₀ c).precomp (SheafOfModules.unit (wcEtZModRing O.toScheme m))
      (zero_add k)).comp
      (((Abelian.Ext.mk₀ Dj.μ.hom).postcomp (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
        (add_zero k)).comp
        (Dj.Φ.mapExtAddHom (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing Y m)) k))
  have hΨapp : ∀ (k : ℕ) (x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y m)) k),
      Ψ k x = (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp
        (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k) := fun k x => rfl
  have hΨ : ∀ k : ℕ, Function.Bijective (Ψ k) := by
    intro k
    have hb := hbij k
    have hfun : (Ψ k : _ → _) = (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y m)) k => (Abelian.Ext.mk₀ c).comp
          ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
          (zero_add k)) := funext (hΨapp k)
    rw [hfun]
    exact hb
  let Ψe : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y m)) k ≃+ wcEtZModExt O.toScheme m k :=
    fun k => AddEquiv.ofBijective (Ψ k) (hΨ k)
  have hΨe : ∀ k x, Ψe k x = Ψ k x := fun k x => rfl

  have KI : ∀ (k : ℕ) (w : wcEtZModExt Y m k),
      Ψ k ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add k)) =
        wcEtPull Dj k w := by
    intro k w
    have hpull : wcEtPull Dj k w = (Abelian.Ext.mk₀ Dj.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor Dj.Φ w).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
        (zero_add k) := rfl
    rw [hpull, hΨapp, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc, hc1]
  let δ : wcEtZModExt O.toScheme m s →+ wcEtSuppExt D k :=
    (hS.extClass.precomp (SheafOfModules.unit (wcEtZModRing Y m)) h).comp
      (Ψe s).symm.toAddMonoidHom
  have hδ : ∀ b, δ b = hS.extClass.comp ((Ψe s).symm b) h := fun b => rfl
  refine ⟨δ, fun b => ?_⟩
  rw [hδ]
  constructor
  · intro hb
    obtain ⟨v, hv⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ ((Ψe s).symm b) h hb
    refine ⟨v, ?_⟩
    have hv' : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp v (zero_add s) =
        (Ψe s).symm b := hv
    rw [← KI, hv', ← hΨe]
    exact (Ψe s).apply_symm_apply b
  · rintro ⟨v, rfl⟩
    have e : (Ψe s).symm (wcEtPull Dj s v) =
        (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp v (zero_add s) := by
      rw [← KI, ← hΨe]
      exact (Ψe s).symm_apply_apply _
    rw [e]
    have hc : hS.extClass.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D)))
        (add_zero 1) = 0 := hS.extClass_comp
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hc, Abelian.Ext.zero_comp]

theorem wc_et_zmod_unit_class_nsmul_eq_zero : ∀ (T : Scheme.{u}), Nonempty T → ∀ (m : ℕ), 0 < m → ∀ (j : ℕ), j • (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (𝟙 (SheafOfModules.unit (wcEtZModRing T m))) : wcEtZModExt T m 0) = 0 → m ∣ j :=
by
  intro T hT m _ j hj
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T m)) := HasExt.standard _
  have hmk : ∀ i : ℕ, (Abelian.Ext.mk₀ (i • 𝟙 (SheafOfModules.unit (wcEtZModRing T m))) :
      wcEtZModExt T m 0) = i • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing T m))) := by
    intro i
    induction i with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ i ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have h2 : j • 𝟙 (SheafOfModules.unit (wcEtZModRing T m)) = 0 := by
    apply (Abelian.Ext.mk₀_bijective _ _).1
    rw [hmk, Abelian.Ext.mk₀_zero]
    exact hj
  have h3 : j • 𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing T m)).obj
      (SheafOfModules.unit (wcEtZModRing T m))) = 0 := by
    have := congrArg (SheafOfModules.toSheaf.{u+1} (wcEtZModRing T m)).map h2
    rwa [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero] at this
  obtain ⟨ι, -⟩ := wc_r2gs_zmod_unit_const_iso T m
  have h5 : j • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
    have e : ι.inv ≫ (j • 𝟙 _) ≫ ι.hom = j • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology T)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) := by
      rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Iso.inv_hom_id]
    rw [← e, h3, Limits.zero_comp, Limits.comp_zero]
  have h6 := congrArg (fun f => (((sheafToPresheaf (Scheme.smallEtaleTopology T)
    AddCommGrpCat.{u+1}).map f).app (Opposite.op (wcEtTop T))).hom
      (wcConstSec T (ULift.{u+1} (ZMod m)) (wcEtTop T) (ULift.up 1))) h5
  simp only [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
    CategoryTheory.Functor.map_zero, NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero,
    AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
    AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply] at h6
  have h7 : ((toSheafify (Scheme.smallEtaleTopology T) ((Functor.const (T.Etale)ᵒᵖ).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op (wcEtTop T))).hom
      (j • (ULift.up 1 : ULift.{u+1} (ZMod m))) = 0 := by
    rw [map_nsmul]
    exact h6
  rcases (wc_et_const_sheaf_local_form T m).1 (wcEtTop T) _ h7 with h | h
  · have h8 : (j • (ULift.up 1 : ULift.{u+1} (ZMod m))).down = 0 := by rw [h]; rfl
    have h9 : ((j : ℕ) : ZMod m) = 0 := by
      rw [← nsmul_one]
      exact h8
    exact (ZMod.natCast_eq_zero_iff j m).mp h9
  · exact ((@not_isEmpty_of_nonempty T hT) h).elim

theorem wc_quad_cone_dim_two_vertex_supp_strict : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (c : Matrix (Fin 2) (Fin 2) K), IsUnit (c + c.transpose).det → ∀ (Ω : Type u) [Field Ω] (i : Spec (.of Ω) ⟶ Spec (.of (wcQuadModelRing K 2 0 c))) [IsClosedImmersion i], (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (i (IsLocalRing.closedPoint Ω))) → ∀ (k : ℕ), 1 ≤ k → ∀ (D : wcEtPullData i (ℓ ^ k)), ∃ ω : wcEtSuppExt D 1, ℓ ^ (k - 1) • ω ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ c hc Ω _ i _ hvert k hk D
  have hp : ℓ.Prime := Fact.out
  have hmpos : 0 < ℓ ^ k := pow_pos hp.pos k

  have hopen : IsOpen {y : Spec (.of (wcQuadModelRing K 2 0 c)) |
      ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∉ y.asIdeal} := by
    rw [Set.setOf_exists]
    exact isOpen_iUnion fun p => PrimeSpectrum.isOpen_basicOpen
  let Oc : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens := ⟨_, hopen⟩

  have hrange : Set.range Oc.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι]
    ext y
    constructor
    · rintro ⟨p, hp'⟩ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      subst hz
      exact hp' (hvert p)
    · intro hy
      by_contra h
      have h' : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∈ y.asIdeal := by
        intro p
        by_contra hq
        exact h ⟨p, hq⟩
      have hyv := (wc_lup_quad_cone_vertex K 2 c).1 y (i (IsLocalRing.closedPoint Ω)) h' hvert
      exact hy ⟨_, hyv.symm⟩
  have hO : (Oc : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) = (Set.range i)ᶜ := by
    rw [← Scheme.Opens.range_ι]
    exact hrange

  obtain ⟨hpreC, A, B, hA, hB, hAB, hU, hAn, hBn, -, -⟩ := wc_quad_cone_dim_two_pieces K c hc Oc rfl
  have hcov : ∀ z : (Oc : Scheme.{u}), Oc.ι z ∈ A ∨ Oc.ι z ∈ B := by
    intro z
    have h : Oc.ι z ∈ Set.range Oc.ι := ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι, ← hU] at h
    exact h
  have hne : ∀ (P : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) (hPo : IsOpen P),
      P ⊆ (Oc : Set (Spec (.of (wcQuadModelRing K 2 0 c)))) → P.Nonempty →
      Nonempty ((Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
        (Oc : Scheme.{u}).Opens) : Scheme.{u}) := by
    intro P hPo hPsub hPn
    have hsub : P ⊆ Set.range Oc.ι := by rw [Scheme.Opens.range_ι]; exact hPsub
    obtain ⟨a, ha⟩ := hPn
    obtain ⟨a', ha'⟩ := hsub ha
    have ha'r : a' ∈ Set.range (Oc.ι ⁻¹ᵁ (⟨P, hPo⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι := by
      rw [Scheme.Opens.range_ι]
      show Oc.ι a' ∈ P
      rw [ha']
      exact ha
    obtain ⟨w, -⟩ := ha'r
    exact ⟨w⟩
  have hneA := hne A hA (by rw [← hU]; exact Set.subset_union_left) hAn
  have hneB := hne B hB (by rw [← hU]; exact Set.subset_union_right) hBn
  have hdisj : Disjoint (Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens))
      (Oc.ι ⁻¹ᵁ (⟨B, hB⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)) := by
    rw [← TopologicalSpace.Opens.coe_disjoint, Set.disjoint_left]
    intro z hz1 hz2
    exact Set.disjoint_left.mp hAB hz1 hz2
  have hsup : Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) ⊔
      Oc.ι ⁻¹ᵁ (⟨B, hB⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) = ⊤ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top]
    ext z
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    exact hcov z
  haveI hconnC : ConnectedSpace (Spec (.of (wcQuadModelRing K 2 0 c))) :=
    { toPreconnectedSpace := hpreC, toNonempty := ⟨i (IsLocalRing.closedPoint Ω)⟩ }

  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists Oc.ι (ℓ ^ k)
  obtain ⟨δ, hδ⟩ := wc_et_supp_open_les_pos i Oc hO (ℓ ^ k) hmpos D Dj 0 1 (by norm_num)

  have hone : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n),
      wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing S' n))) := by
    intro S S' g n D
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S n))))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) =
      Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S' n)))
    rw [Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Category.id_comp, Iso.inv_hom_id]
  have hmk : ∀ (T : Scheme.{u}) (n j : ℕ),
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (j • 𝟙 (SheafOfModules.unit (wcEtZModRing T n))) : wcEtZModExt T n 0) =
        j • (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing T n))) : wcEtZModExt T n 0) := by
    intro T n j
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T n)) := HasExt.standard _
    induction j with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ j ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hkill : ∀ T : Scheme.{u},
      (ℓ ^ k) • (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing T (ℓ ^ k)))) : wcEtZModExt T (ℓ ^ k) 0) = 0 := by
    intro T
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T (ℓ ^ k))) := HasExt.standard _
    rw [← hmk T (ℓ ^ k) (ℓ ^ k), (wc_et_zmod_unit_pow_exact T ℓ k hp.pos).1, Abelian.Ext.mk₀_zero]

  obtain ⟨DA⟩ := wc_et_zmod_pull_data_exists
    (Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι (ℓ ^ k)
  obtain ⟨DB⟩ := wc_et_zmod_pull_data_exists
    (Oc.ι ⁻¹ᵁ (⟨B, hB⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens)).ι (ℓ ^ k)
  have hbij := wc_et_zmodext_clopen_split (Oc : Scheme.{u}) _ _ hdisj hsup (ℓ ^ k) hmpos DA DB 0
  obtain ⟨b, hb⟩ := hbij.2 ((@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
    (𝟙 (SheafOfModules.unit (wcEtZModRing ((Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
      (Oc : Scheme.{u}).Opens) : Scheme.{u}) (ℓ ^ k)))) : wcEtZModExt ((Oc.ι ⁻¹ᵁ (⟨A, hA⟩ : (Spec (.of (wcQuadModelRing K 2 0 c))).Opens) :
      (Oc : Scheme.{u}).Opens) : Scheme.{u}) (ℓ ^ k) 0), 0)
  have hbA := congrArg Prod.fst hb
  have hbB := congrArg Prod.snd hb
  simp only at hbA hbB
  refine ⟨δ b, fun h0 => ?_⟩

  have h1 : δ (ℓ ^ (k - 1) • b) = 0 := by rw [map_nsmul, h0]
  obtain ⟨v, hv⟩ := (hδ _).1 h1
  have hgenC : ∀ v : wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0, ∃ j : ℕ,
      v = j • (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k)))) :
          wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0) := by
    intro v
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0
    have hcard : Nat.card (wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0) = ℓ ^ k :=
      (Nat.card_congr E).trans (wc_et_coh_zero_connected_card _ (ℓ ^ k) hmpos.ne')
    haveI : Finite (wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0) :=
      Nat.finite_of_card_ne_zero (by rw [hcard]; exact hmpos.ne')
    have hord : addOrderOf (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k)))) :
          wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0) = ℓ ^ k :=
      Nat.dvd_antisymm (addOrderOf_dvd_of_nsmul_eq_zero (hkill _))
        (wc_et_zmod_unit_class_nsmul_eq_zero _ ⟨i (IsLocalRing.closedPoint Ω)⟩ (ℓ ^ k) hmpos _
          (addOrderOf_nsmul_eq_zero _))
    have htop := AddSubgroup.eq_top_of_le_card (AddSubgroup.zmultiples
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k)))) :
          wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0))
      (by rw [Nat.card_zmultiples, hord, hcard])
    have hv : v ∈ AddSubgroup.zmultiples
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k)))) :
          wcEtZModExt (Spec (.of (wcQuadModelRing K 2 0 c))) (ℓ ^ k) 0) := by
      rw [htop]; exact AddSubgroup.mem_top v
    rw [← mem_multiples_iff_mem_zmultiples] at hv
    obtain ⟨j, hj⟩ := (AddSubmonoid.mem_multiples_iff _ _).mp hv
    exact ⟨j, hj.symm⟩
  obtain ⟨j, rfl⟩ := hgenC v
  rw [map_nsmul, hone Dj] at hv
  have hB' := congrArg (wcEtPull DB 0) hv
  rw [map_nsmul, map_nsmul, hone DB, hbB, nsmul_zero] at hB'
  obtain ⟨t, rfl⟩ := wc_et_zmod_unit_class_nsmul_eq_zero _ hneB (ℓ ^ k) hmpos j hB'
  have hA' := congrArg (wcEtPull DA 0) hv
  rw [map_nsmul, map_nsmul, hone DA, hbA, mul_nsmul, hkill, nsmul_zero] at hA'
  have hdvd := wc_et_zmod_unit_class_nsmul_eq_zero _ hneA (ℓ ^ k) hmpos (ℓ ^ (k - 1)) hA'.symm
  have hlt : ℓ ^ (k - 1) < ℓ ^ k := Nat.pow_lt_pow_right hp.one_lt (by omega)
  have hle := Nat.le_of_dvd (pow_pos hp.pos _) hdvd
  omega

theorem wc_et_tpl_lp_loc_strict_node (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (h2 : n = 2)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (k : ℕ) (hk : 1 ≤ k)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k)) :
    ∃ ω : wcEtSuppExt Dx (n - 1), ℓ ^ (k - 1) • ω ≠ 0 :=
by
  classical
  subst h2
  show ∃ ω : wcEtSuppExt Dx 1, ℓ ^ (k - 1) • ω ≠ 0

  obtain ⟨hdom, hdvr, hℓA, π, c, hπ, hc, U, jU, eU, hjU, heU, hsq, u, hux, hu⟩ :=
    wc_et_tpl_morse_chart_A_pt F' F'' Y 2 hn hn2 D ℓ hℓ i A Λ W' φ a hA x hx
  obtain ⟨W, hWaff, φW, hφW, ψ, hψ, w₀, h1, h2, h3, h4', h5, h6⟩ :=
    wc_closed_fibre_quad_cone_chart A 2 π c hπ hc (Limits.pullback D.f a) U
      (Limits.pullback.snd D.f a) jU eU hjU heU hsq u hu xs (hxs.trans hux.symm)
  haveI := hWaff
  haveI := hφW
  haveI := hψ
  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_halsh_finite_point_residue_algClosed F'' (wcP1Over F'').left (D.S i) A Λ W' φ a hA
  haveI hxbar : IsClosedImmersion (wcEtGeomPt (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)) xs) :=
    wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y 2 D i A Λ W' φ a hA x hx xs hxs
  have hxpt : (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)) xs) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
        (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))) = xs := by
    first
    | exact Scheme.fromSpecResidueField_apply xs _
    | (simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply])
  obtain ⟨v₀, hv₀, hv₀pt⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)).residueField xs)) φW
    (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs)
    w₀ (h1.trans hxpt.symm)
  haveI : IsClosedImmersion v₀ := by
    haveI : IsClosedImmersion (v₀ ≫ φW) := by rw [hv₀]; infer_instance
    exact IsClosedImmersion.of_comp v₀ φW
  have hL4 := wc_et_tpl_sfu_geom_pt_base_closed F' F'' Y 2 D i A Λ W' φ a hA x hx xs hxs
  haveI : IsClosedImmersion (v₀ ≫ ψ) := by
    haveI : IsClosedImmersion ((v₀ ≫ ψ) ≫ wcQuadModelStr (IsLocalRing.ResidueField A) 2 0
        (c.map (IsLocalRing.residue A))) := by
      rw [Category.assoc, ← h5, ← Category.assoc, hv₀]
      exact hL4
    exact IsClosedImmersion.of_comp (v₀ ≫ ψ) (wcQuadModelStr (IsLocalRing.ResidueField A) 2 0
      (c.map (IsLocalRing.residue A)))

  have huniq₁ : ∀ v : W, φW v = (wcEtGeomPt (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (IsLocalRing.closedPoint _) →
      v = v₀ (IsLocalRing.closedPoint _) := by
    intro v hv
    rw [hv₀pt]
    apply h2
    rw [hv, hxpt]
  have huniq₂ : ∀ w : W, ψ w = (v₀ ≫ ψ) (IsLocalRing.closedPoint _) →
      w = v₀ (IsLocalRing.closedPoint _) := by
    intro w hw
    rw [hv₀pt]
    apply h3
    rw [hw]
    show ψ (v₀ _) = ψ w₀
    rw [hv₀pt]
  have P₁ := wc_et_point_fibre_isPullback _ _ W φW _ v₀ hv₀ huniq₁
  have P₂ := wc_et_point_fibre_isPullback _ _ W ψ (v₀ ≫ ψ) v₀ rfl huniq₂

  obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₀ (ℓ ^ k)
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (v₀ ≫ ψ) (ℓ ^ k)
  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists φW (ℓ ^ k)
  obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists ψ (ℓ ^ k)
  obtain ⟨γ₁, hγ₁, -⟩ := wc_et_closed_supp_base_change _ φW v₀ (𝟙 _) P₁ Dx E₁ Dv
  obtain ⟨γ₂, hγ₂, -⟩ := wc_et_closed_supp_base_change (v₀ ≫ ψ) ψ v₀ (𝟙 _) P₂ D' E₂ Dv
  have hsurj := wc_et_supp_restr_etale_excision_surjective φW _ v₀ (𝟙 _) P₁ inferInstance
    Dx E₁ Dv γ₁ hγ₁ 1
  have hinj := wc_et_supp_restr_etale_excision_injective ψ (v₀ ≫ ψ) v₀ (𝟙 _) P₂ inferInstance
    D' E₂ Dv γ₂ hγ₂ 1

  obtain ⟨ω₀, hω₀⟩ := wc_quad_cone_dim_two_vertex_supp_strict (IsLocalRing.ResidueField A) ℓ
    (c.map (IsLocalRing.residue A)) h6 _ (v₀ ≫ ψ) (by
      intro p
      show _ ∈ PrimeSpectrum.asIdeal (ψ (v₀ _))
      rw [hv₀pt]
      exact h4' p) k hk D'
  obtain ⟨ω, hω⟩ := hsurj (wcEtSuppRestr D' E₂ Dv γ₂ 1 ω₀)
  refine ⟨ω, fun h0 => hω₀ ?_⟩
  have e1 : wcEtSuppRestr D' E₂ Dv γ₂ 1 (ℓ ^ (k - 1) • ω₀) = 0 := by
    rw [map_nsmul, ← hω, ← map_nsmul (wcEtSuppRestr Dx E₁ Dv γ₁ 1), h0, map_zero]
  exact hinj (e1.trans (map_zero _).symm)

theorem wc_et_supp_open_delta_gen : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (O : Y.Opens), (O : Set Y) = (Set.range i)ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D : wcEtPullData i m) (Dj : wcEtPullData O.ι m) (s q : ℕ), 1 + s = q → ∃ δ : wcEtZModExt O.toScheme m s →+ wcEtSuppExt D q, ∀ b, δ b = 0 → ∃ v : wcEtZModExt Y m s, wcEtPull Dj s v = b :=
by
  intro Y Z i _ O hO m hm D Dj s q h
  obtain ⟨δ, hδ⟩ := wc_et_supp_open_les_pos i O hO m hm D Dj s q h
  exact ⟨δ, fun b hb => (hδ b).1 hb⟩

theorem wc_et_zmodext_coh_ext_addEquiv : ∀ (Y : Scheme.{u}) (m i : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; Nonempty (wcEtZModExt Y m i ≃+ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) i) :=
by
  intro Y n i
  letI hExtS : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  classical
  letI hExtM : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  haveI hEIM : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI hEIS : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Y
  haveI hPC : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _

  obtain ⟨α, hinj, hsurj, hR⟩ := wc_et_zmod_ring_locbij Y n
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n) n α hinj hsurj
  haveI := hfull

  have hT : Limits.IsTerminal ((wcZarToEt Y).obj ⊤) := by
    have huniq : ∀ (V : Y.Etale) (f g : V ⟶ (wcZarToEt Y).obj ⊤), f = g := by
      intro V f g
      haveI : Mono ((wcZarToEt Y).obj ⊤).hom :=
        show Mono (⊤ : Y.Opens).ι from (inferInstance : Mono (⊤ : Y.Opens).ι)
      apply MorphismProperty.Over.Hom.ext
      rw [← cancel_mono ((wcZarToEt Y).obj ⊤).hom, MorphismProperty.Over.w f,
        MorphismProperty.Over.w g]
    exact Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk (V.hom ≫ Y.topIso.inv)
        (by
          change (V.hom ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι = V.hom
          rw [← Scheme.topIso_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]) trivial)
      (fun V m => huniq V m _)
  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    (Scheme.smallEtaleTopology Y) (wcEtZModRing Y n) ((wcZarToEt Y).obj ⊤) hT
  obtain ⟨θ⟩ := wc_et_free_top_iso_const Y
  have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
      Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
        (θ.inv ≫ ε) ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) := by
    intro M
    have hθ : Function.Bijective (fun g : _ ⟶ (SheafOfModules.toSheaf.{u+1}
        (wcEtZModRing Y n)).obj M => θ.inv ≫ g) :=
      ⟨fun g₁ g₂ h => (cancel_epi θ.inv).mp h,
        fun g => ⟨θ.hom ≫ g, Iso.inv_hom_id_assoc θ g⟩⟩
    have e : (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
        (θ.inv ≫ ε) ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) =
        (fun g => θ.inv ≫ g) ∘ (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
          ε ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) :=
      funext fun f => Category.assoc _ _ _
    rw [e]
    exact hθ.comp (hε M)

  have hev : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing Y n)} (f : M ⟶ M')
      (V : (Y.Etale)ᵒᵖ), f.val.app V = (SheafOfModules.forget (wcEtZModRing Y n) ⋙
        PresheafOfModules.evaluation (wcEtZModRing Y n).obj V).map f :=
    fun _ _ => rfl
  have hnsmulApp : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y n)) (V : (Y.Etale)ᵒᵖ),
      (n • 𝟙 M).val.app V = n • 𝟙 (M.val.obj V) := by
    intro M V
    rw [hev, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  have hzeroApp : ∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing Y n)) (V : (Y.Etale)ᵒᵖ),
      (0 : M ⟶ M').val.app V = 0 := by
    intro M M' V
    rw [hev, CategoryTheory.Functor.map_zero]
    rfl
  have hkillM : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n), n • 𝟙 M = 0 := by
    intro M
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    rw [hnsmulApp, hzeroApp]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.zero_apply,
      ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Y n).obj.obj V), hR V, zero_smul]

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Y n)) [Injective I] (k : ℕ)
      (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I) (k + 1)), e = 0 := by
    intro I _ k e
    let ι := Injective.ι ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I)
    let K := Injective.under ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I)
    let ν : K ⟶ K := n • 𝟙 K
    have hιν : ι ≫ ν = 0 := by
      have e1 : ι ≫ ν = (n • 𝟙 _) ≫ ι := by
        show ι ≫ (n • 𝟙 _) = (n • 𝟙 _) ≫ ι
        rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
      rw [e1, ← (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map_id,
        ← Functor.map_nsmul, hkillM I, Functor.map_zero, Limits.zero_comp]
    let ι' : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I ⟶ Limits.kernel ν :=
      Limits.kernel.lift ν ι hιν
    have hι' : ι' ≫ Limits.kernel.ι ν = ι := Limits.kernel.lift_ι _ _ _
    haveI : Mono ι' := mono_of_mono_fac hι'
    have hker : n • 𝟙 (Limits.kernel ν) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι ν), Limits.zero_comp, Preadditive.nsmul_comp,
        Category.id_comp]
      have := Limits.kernel.condition ν
      simp only [ν, Preadditive.comp_nsmul, Category.comp_id] at this
      exact this
    obtain ⟨M, ⟨eM⟩⟩ := hess _ hker
    let g : I ⟶ M := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).preimage (ι' ≫ eM.inv)
    have hg : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map g = ι' ≫ eM.inv :=
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map_preimage _
    haveI hmg : Mono ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map g) := by
      rw [hg]; infer_instance
    haveI : Mono g := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).mono_of_mono_map hmg
    let r : M ⟶ I := Injective.factorThru (𝟙 I) g
    have hr : g ≫ r = 𝟙 I := Injective.comp_factorThru _ _
    have hst : ι' ≫ (eM.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r) =
        𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I) := by
      rw [← Category.assoc, ← hg, ← Functor.map_comp, hr,
        (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map_id]
    have hz : e.comp (Abelian.Ext.mk₀ ι') (add_zero _) = 0 := by
      by_cases hn : n = 0
      · have hν : ν = 0 := (congrArg (fun m : ℕ => m • 𝟙 K) hn).trans (zero_nsmul _)
        let s : K ⟶ Limits.kernel ν := Limits.kernel.lift ν (𝟙 K) (by rw [hν, Limits.comp_zero])
        have hs1 : s ≫ Limits.kernel.ι ν = 𝟙 K := Limits.kernel.lift_ι _ _ _
        have hs2 : Limits.kernel.ι ν ≫ s = 𝟙 _ := by
          rw [← cancel_mono (Limits.kernel.ι ν), Category.assoc, hs1, Category.comp_id,
            Category.id_comp]
        haveI : Injective (Limits.kernel ν) :=
          Injective.of_iso ⟨s, Limits.kernel.ι ν, hs1, hs2⟩ inferInstance
        exact Abelian.Ext.eq_zero_of_injective _
      · have hsub := wc_et_injective_torsion_kernel_acyclic Y K n hn k
        haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            (Limits.kernel ν) (k + 1)) := hsub
        exact Subsingleton.elim _ _
    have he : e = (e.comp (Abelian.Ext.mk₀ ι') (add_zero _)).comp
        (Abelian.Ext.mk₀ (eM.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r))
        (add_zero _) := by
      calc e = e.comp (Abelian.Ext.mk₀ (ι' ≫ (eM.inv ≫
              (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r))) (add_zero _) := by
            rw [hst, Abelian.Ext.comp_mk₀_id]
        _ = e.comp ((Abelian.Ext.mk₀ ι').comp (Abelian.Ext.mk₀ (eM.inv ≫
              (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r)) (add_zero 0))
              (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
        _ = _ := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    rw [he, hz, Abelian.Ext.zero_comp]

  have hΦ := ext_transfer_of_corep (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n))
    (SheafOfModules.unit (wcEtZModRing Y n))
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (θ.inv ≫ ε) hhom hvan
    (SheafOfModules.unit (wcEtZModRing Y n)) i

  haveI := hinj
  haveI := hsurj
  let φ : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⋙
      forget₂ RingCat.{u+1} AddCommGrpCat.{u+1} ⟶
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))).obj :=
    Functor.whiskerRight α (forget₂ RingCat.{u+1} AddCommGrpCat.{u+1})
  haveI hφi : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ := by
    rw [← Presheaf.isLocallyInjective_forget_iff]
    exact (Presheaf.isLocallyInjective_forget_iff _ α).mpr hinj
  haveI hφs : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ := by
    rw [Presheaf.isLocallySurjective_iff_whisker_forget]
    exact (Presheaf.isLocallySurjective_iff_whisker_forget _ α).mp hsurj
  let c : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod n))) ⟶
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))).obj :=
    (Functor.constComp (Y.Etale)ᵒᵖ (RingCat.of (ULift.{u+1} (ZMod n)))
      (forget₂ RingCat.{u+1} AddCommGrpCat.{u+1})).inv ≫ φ
  haveI : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) c :=
    Presheaf.isLocallyInjective_comp _ _ _
  haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) c :=
    Presheaf.isLocallySurjective_comp _ _ _
  haveI hiso : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map c) :=
    (GrothendieckTopology.W_iff _ c).mp (GrothendieckTopology.W_of_isLocallyBijective _ c)
  let ιu : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n)) ≅
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n))) :=
    sheafificationIso _ ≪≫
      (asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map c)).symm
  have hΨ : Function.Bijective (fun y : Abelian.Ext
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))) i =>
      y.comp (Abelian.Ext.mk₀ ιu.hom) (add_zero i)) := by
    refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ ιu.inv) (add_zero i), ?_⟩⟩
    · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ ιu.inv) (add_zero i)) hy
      simp only at hy'
      rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id,
        Abelian.Ext.comp_mk₀_id] at hy'
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  let Φh : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y n))
      (SheafOfModules.unit (wcEtZModRing Y n)) i →+
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))) i :=
    AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ (θ.inv ≫ ε)).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)) β)
        (zero_add i))
      (fun β₁ β₂ => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  let Ψh : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))) i →+
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n)))) i :=
    AddMonoidHom.mk' (fun y => y.comp (Abelian.Ext.mk₀ ιu.hom) (add_zero i))
      (fun y₁ y₂ => Abelian.Ext.add_comp _ _ _ _)
  exact ⟨AddEquiv.ofBijective (Ψh.comp Φh) (hΨ.comp hΦ)⟩

theorem wc_et_coh_bockstein_exact_order : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r s t : ℕ), r + 1 = s → s + 1 = t → Nat.card (wcEtCoh Y ℓ s) = ℓ → Subsingleton (wcEtCoh Y ℓ r) → (∀ j : ℕ, 1 ≤ j → Nat.card (wcEtCoh Y (ℓ ^ j) t) = ℓ ^ j) → ∀ (k : ℕ), 1 ≤ k → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∃ g : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) s, ℓ ^ (k - 1) • g ≠ 0 :=
by
  intro Y ℓ _ r s t hrs hst h1 h2 h3 k hk
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  classical
  have hℓ : ℓ.Prime := Fact.out

  have L3 : ∀ (X Z₁ Zₐ Zₘ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (fA : Zₐ ⟶ Zₘ) (gA : Zₘ ⟶ Z₁) (hA : fA ≫ gA = 0) (fB : Z₁ ⟶ Zₘ) (gB : Zₘ ⟶ Zₐ)
      (hB : fB ≫ gB = 0), (ShortComplex.mk fA gA hA).ShortExact →
      (ShortComplex.mk fB gB hB).ShortExact → ∀ (N : ℕ), gA ≫ fB = N • 𝟙 Zₘ →
      (∀ x : Abelian.Ext X Zₐ t, x.comp (Abelian.Ext.mk₀ fA) (add_zero t) = 0 → x = 0) →
      (∀ z : Abelian.Ext X Zₐ r, z = 0) → (∃ y : Abelian.Ext X Z₁ s, y ≠ 0) →
      ∃ g : Abelian.Ext X Zₘ s, N • g ≠ 0 := by
    intro X Z₁ Zₐ Zₘ fA gA hA fB gB hB hSA hSB N hN hinj hsub hy
    obtain ⟨y, hy⟩ := hy
    have hw : y.comp hSA.extClass hst = 0 := by
      apply hinj
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hSA.extClass_comp, Abelian.Ext.comp_zero]
    obtain ⟨g, hg⟩ := Abelian.Ext.covariant_sequence_exact₃ X hSA y hst hw
    have hscal : ∀ n : ℕ, g.comp (Abelian.Ext.mk₀ (n • 𝟙 Zₘ)) (add_zero s) = n • g := by
      intro n
      induction n with
      | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
      | succ n ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    have hcomp : N • g = y.comp (Abelian.Ext.mk₀ fB) (add_zero s) := by
      rw [← hscal, ← hN, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
      rw [← hg]
    refine ⟨g, fun h0 => hy ?_⟩
    rw [hcomp] at h0
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ X hSB y h0 hrs
    rw [← hz, hsub z, Abelian.Ext.zero_comp]

  have L2 : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
      (α : A →+ B) (β : B →+ D), (∀ b, β b = 0 → ∃ a, α a = b) → Finite A → Finite D →
      Nat.card A * Nat.card D ≤ Nat.card B → Function.Injective α := by
    intro A B D _ _ _ α β hex hA hD hle
    have hK : β.ker ≤ α.range := by
      intro b hb
      obtain ⟨a, ha⟩ := hex b ((AddMonoidHom.mem_ker).mp hb)
      exact AddMonoidHom.mem_range.mpr ⟨a, ha⟩
    have e0 := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker
    have e1 : Nat.card (B ⧸ β.ker) = Nat.card β.range :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivRange β).toEquiv
    have : Finite α.range := Finite.of_surjective _ α.rangeRestrict_surjective
    have : Finite β.range :=
      Finite.of_injective (Subtype.val : β.range → D) Subtype.val_injective
    have h1' : Nat.card β.ker ≤ Nat.card α.range :=
      Nat.card_le_card_of_injective _ (AddSubgroup.inclusion_injective hK)
    have h2' : Nat.card β.range ≤ Nat.card D :=
      Nat.card_le_card_of_injective _ Subtype.val_injective
    have hDpos : 0 < Nat.card D := Nat.card_pos
    have hB : Nat.card B = Nat.card β.range * Nat.card β.ker := by rw [e0, e1]
    have hAle : Nat.card A ≤ Nat.card α.range := by
      have : Nat.card D * Nat.card A ≤ Nat.card D * Nat.card α.range := by
        calc Nat.card D * Nat.card A = Nat.card A * Nat.card D := mul_comm _ _
          _ ≤ Nat.card B := hle
          _ = Nat.card β.range * Nat.card β.ker := hB
          _ ≤ Nat.card D * Nat.card α.range := Nat.mul_le_mul h2' h1'
      exact Nat.le_of_mul_le_mul_left this hDpos
    have hbij := Function.Surjective.bijective_of_nat_card_le α.rangeRestrict_surjective hAle
    intro x y hxy
    apply hbij.1
    exact Subtype.ext hxy

  have L1 : ∀ a : ℕ, ∃ (fA : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ a))) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))))
      (gA : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) (hA : fA ≫ gA = 0)
      (fB : AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))))
      (gB : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ a)))) (hB : fB ≫ gB = 0),
      (ShortComplex.mk fA gA hA).ShortExact ∧ (ShortComplex.mk fB gB hB).ShortExact ∧
      gA ≫ fB = ℓ ^ a • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1))))) := by
    intro a
    have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ.ne_zero
    have hk0 : (zmultiplesHom (ZMod (ℓ ^ (a + 1))) (ℓ : ZMod (ℓ ^ (a + 1)))) ((ℓ ^ a : ℕ) : ℤ)
        = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ← pow_succ,
        ZMod.natCast_self]
    have hk1 : (zmultiplesHom (ZMod (ℓ ^ (a + 1))) ((ℓ ^ a : ℕ) : ZMod (ℓ ^ (a + 1)))) (ℓ : ℤ)
        = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ← pow_succ',
        ZMod.natCast_self]
    let α : ZMod (ℓ ^ a) →+ ZMod (ℓ ^ (a + 1)) :=
      ZMod.lift (ℓ ^ a) ⟨zmultiplesHom (ZMod (ℓ ^ (a + 1))) (ℓ : ZMod (ℓ ^ (a + 1))), hk0⟩
    let φ : ZMod ℓ →+ ZMod (ℓ ^ (a + 1)) :=
      ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (a + 1))) ((ℓ ^ a : ℕ) : ZMod (ℓ ^ (a + 1))), hk1⟩
    have hα : ∀ z : ℤ, α (z : ZMod (ℓ ^ a)) = ((z * ℓ : ℤ) : ZMod (ℓ ^ (a + 1))) := by
      intro z
      show (ZMod.lift (ℓ ^ a) ⟨zmultiplesHom (ZMod (ℓ ^ (a + 1))) (ℓ : ZMod (ℓ ^ (a + 1))), hk0⟩)
        (z : ZMod (ℓ ^ a)) = _
      rw [ZMod.lift_coe]
      change z • (ℓ : ZMod (ℓ ^ (a + 1))) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    have hφ : ∀ z : ℤ, φ (z : ZMod ℓ) = ((z * ((ℓ ^ a : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (a + 1))) := by
      intro z
      show (ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (a + 1))) ((ℓ ^ a : ℕ) : ZMod (ℓ ^ (a + 1))),
        hk1⟩) (z : ZMod ℓ) = _
      rw [ZMod.lift_coe]
      change z • ((ℓ ^ a : ℕ) : ZMod (ℓ ^ (a + 1))) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (ℓ ^ (a + 1)) →+ ZMod ℓ :=
      (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero a)) (ZMod ℓ)).toAddMonoidHom
    let γ : ZMod (ℓ ^ (a + 1)) →+ ZMod (ℓ ^ a) :=
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ a) : ℓ ^ a ∣ ℓ ^ (a + 1))
        (ZMod (ℓ ^ a))).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (ℓ ^ (a + 1))) = (z : ZMod ℓ) := fun z =>
      map_intCast (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero a)) (ZMod ℓ)) z
    have hγ : ∀ z : ℤ, γ (z : ZMod (ℓ ^ (a + 1))) = (z : ZMod (ℓ ^ a)) := fun z =>
      map_intCast (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ a) : ℓ ^ a ∣ ℓ ^ (a + 1))
        (ZMod (ℓ ^ a))) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast at hx ⊢
      rw [pow_succ] at hx
      exact (mul_dvd_mul_iff_right hℓ0).mp hx
    have hφinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hφ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast at hx ⊢
      rw [pow_succ'] at hx
      exact (mul_dvd_mul_iff_right (pow_ne_zero a hℓ0)).mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (ℓ ^ (a + 1))), hβ z⟩
    have hγsurj : Function.Surjective γ := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (ℓ ^ (a + 1))), hγ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, mul_zero]
    have hγφ : ∀ x, γ (φ x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hφ, hγ, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, mul_zero]
    have hkerA : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod (ℓ ^ a)), ?_⟩
      rw [hα]
      congr 1
      ring
    have hkerB : ∀ y, γ y = 0 → ∃ x, φ x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hγ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod ℓ), ?_⟩
      rw [hφ]
      congr 1
      ring
    have hφβ : ∀ x, φ (β x) = ℓ ^ a • x := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hβ, hφ, nsmul_eq_mul]
      push_cast
      ring
    let fA : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ a))) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let gA : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    let fB : AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp φ).comp
        AddEquiv.ulift.toAddMonoidHom)
    let gB : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (a + 1)))) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ a))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp γ).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hA : fA ≫ gA = 0 := by
      ext x
      exact hβα x.down
    have hB : fB ≫ gB = 0 := by
      ext x
      exact hγφ x.down
    refine ⟨fA, gA, hA, fB, gB, hB, ShortComplex.ShortExact.mk' ?_ ?_ ?_,
      ShortComplex.ShortExact.mk' ?_ ?_ ?_, ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hkerA x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro x y hxy
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hxy))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hkerB x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro x y hxy
      exact ULift.ext _ _ (hφinj (congrArg ULift.down hxy))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hγsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
    · ext x
      rw [AddCommGrpCat.hom_nsmul]
      exact hφβ x.down

  have hyM : ∀ m : ℕ, Nat.card (wcEtCoh Y m s) = ℓ →
      ∃ y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) s, y ≠ 0 := by
    intro m hm
    have hc : Nat.card (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) s) = ℓ := hm
    have : Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) s) :=
      Nat.finite_of_card_ne_zero (by rw [hc]; exact hℓ.ne_zero)
