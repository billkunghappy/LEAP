          exact ⟨z, hzy, hz⟩)
      refine ⟨ζ, Set.mem_singleton_iff.mp hζs, fun K hK hζ₁K => ?_⟩
      exact Set.mem_iInter.mp hζK ⟨K, hK, hζ₁K⟩

    have h₁' : c'₁.left ≫ x.left = c₁.left ≫ w.left := (congrArg (fun t => t.left) h₁).symm
    have hd₀' : c'₂.left ≫ x.left = d₀.left ≫ w.left := (congrArg (fun t => t.left) hd₀).symm
    obtain ⟨ℓ₁, hℓ₁f, hℓ₁s⟩ : ∃ ℓ : T₁.left ⟶ Limits.pullback x.left w.left,
        ℓ ≫ Limits.pullback.fst x.left w.left = c'₁.left ∧
        ℓ ≫ Limits.pullback.snd x.left w.left = c₁.left :=
      ⟨_, Limits.pullback.lift_fst _ _ h₁', Limits.pullback.lift_snd _ _ h₁'⟩
    obtain ⟨ℓ₂, hℓ₂f⟩ : ∃ ℓ : T₂.left ⟶ Limits.pullback x.left w.left,
        ℓ ≫ Limits.pullback.fst x.left w.left = c'₂.left :=
      ⟨_, Limits.pullback.lift_fst _ _ hd₀'⟩
    obtain ⟨ζ, hζy, hζK⟩ := hfib (ℓ₁ pt₁) (c'₂.left pt₂)
    obtain ⟨φ, hφ, hφz⟩ := htr (ℓ₂ pt₂) ζ (by rw [← Scheme.Hom.comp_apply, hℓ₂f, hζy])
    let V : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst x.left w.left ≫ X.hom)
    let p : V ⟶ X := MorphismProperty.Over.homMk (Limits.pullback.fst x.left w.left) rfl trivial
    let q : V ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd x.left w.left) hK trivial
    let t₁ : T₁ ⟶ V := MorphismProperty.Over.homMk ℓ₁ (by
      change ℓ₁ ≫ Limits.pullback.fst x.left w.left ≫ X.hom = T₁.hom
      rw [reassoc_of% hℓ₁f, MorphismProperty.Over.w c'₁]) trivial
    let t₂ : T₂ ⟶ V := MorphismProperty.Over.homMk (ℓ₂ ≫ φ) (by
      change (ℓ₂ ≫ φ) ≫ Limits.pullback.fst x.left w.left ≫ X.hom = T₂.hom
      rw [Category.assoc, reassoc_of% hφ, reassoc_of% hℓ₂f, MorphismProperty.Over.w c'₂]) trivial
    refine ⟨V, p, q, t₁, t₂, ?_, ?_, ?_, ?_, ?_⟩
    · exact MorphismProperty.Over.Hom.ext (Limits.pullback.condition :
