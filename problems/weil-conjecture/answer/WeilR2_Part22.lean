      (Spec.map (CommRingCat.ofHom κ) ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (FractionRing (X.presheaf.stalk x)))))
      (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x)) :=
    IsPullback.of_iso hT2 (Iso.refl _) (Iso.refl _)
      (Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x)).isoSpec.symm (Iso.refl _)
