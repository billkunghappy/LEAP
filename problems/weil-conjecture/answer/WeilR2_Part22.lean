    rw [Category.assoc, hef]; exact Limits.biprod.inl_desc _ _)
  have hM₂ : M₂ ≤ M := Subobject.le_of_comm (Limits.biprod.inr ≫ e) (by
    rw [Category.assoc, hef]; exact Limits.biprod.inr_desc _ _)
  have hlub : ∀ M' : Subobject X, M₁ ≤ M' → M₂ ≤ M' → M ≤ M' := by
    intro M' k₁ k₂
    refine Limits.imageSubobject_le f
      (Limits.biprod.desc (Subobject.ofLE M₁ M' k₁) (Subobject.ofLE M₂ M' k₂)) ?_
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc_assoc, Subobject.ofLE_arrow, Limits.biprod.inl_desc]
    · rw [Limits.biprod.inr_desc_assoc, Subobject.ofLE_arrow, Limits.biprod.inr_desc]
  refine ⟨M, hM₁, hM₂, hlub, ?_⟩

  obtain ⟨Ladj, adj, -, -, -⟩ := proet_overPullback_exact_left_adjoint (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP)
  haveI : (wcSupRho K hP).IsRightAdjoint := adj.isRightAdjoint
  haveI : (wcSupRho K hP).PreservesMonomorphisms := inferInstance
  obtain ⟨hadd, hfc⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology (wcP1Over K).left).over (wcGeomPoint K (wcP1Over K) hP))
    (Scheme.ProEt.topology (wcP1Over K).left) (Over.forget (wcGeomPoint K (wcP1Over K) hP))
