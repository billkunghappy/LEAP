  obtain ⟨y, -, hy⟩ := IsClosed.exists_closed_singleton (S := (Set.univ : Set Xt)) isClosed_univ
    ⟨hne.some, Set.mem_univ _⟩
  obtain ⟨z₀, hz₀, -⟩ := wc_glc_closed_point_section K Xt (b ≫ pY) y hy
  have Dz : wcEtPullData z₀ (ℓ ^ k) := (wc_et_zmod_pull_data_exists z₀ (ℓ ^ k)).some
  obtain ⟨ω, hω⟩ := wc_et_point_supp_ext_strict_exists K Xt (b ≫ pY) N ℓ hℓ k hk z₀ hz₀ Dz
  have hg' : ℓ ^ (k - 1) • wcEtSuppClass Dz (2 * N) ω ≠ 0 :=
    wc_et_point_supp_class_strict_injective K Xt (b ≫ pY) N ℓ hℓ k hk z₀ hz₀ Dz ω hω
  have Db : wcEtPullData b (ℓ ^ k) := (wc_et_zmod_pull_data_exists b (ℓ ^ k)).some
  have hm : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
  have hsurj : Function.Surjective (wcEtPull Db (2 * N)) :=
    wc_et_abstract_blowup_pull_surj Y Xt Z b iZ hiso (ℓ ^ k) hm (2 * N) hfib Db
  obtain ⟨g, hgg⟩ := hsurj (wcEtSuppClass Dz (2 * N) ω)
  refine ⟨g, fun h0 => hg' ?_⟩
  rw [← hgg, ← map_nsmul, h0, map_zero]

theorem wc_et_isol_open_top_vanish_of_modification (K : Type u) [Field K] [IsAlgClosed K]
    (Y Xt E : Scheme.{u}) (pY : Y ⟶ Spec (.of K)) [IsProper pY] [ConnectedSpace Y]
    (b : Xt ⟶ Y) (N : ℕ) [IsProper (b ≫ pY)] [SmoothOfRelativeDimension N (b ≫ pY)]
    (iE : E ⟶ Xt) [IsClosedImmersion iE] (O : Y.Opens) (hOne : (O : Set Y) ≠ Set.univ)
    (hiso : IsIso (b ∣_ O)) (hE : Set.range iE = b ⁻¹' (O : Set Y)ᶜ) (hN : 1 ≤ N)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (k : ℕ) (hk : 1 ≤ k) :
    Subsingleton (wcEtCoh (O : Scheme.{u}) (ℓ ^ k) (2 * N)) :=
by
