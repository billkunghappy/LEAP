  obtain ⟨Ub0, hUb0, -, hUb0c, -, -⟩ :=
    wc_P1bar_smooth_locus F'' hP 0 (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
  haveI : CompactSpace (wcGeomPoint F'' (wcP1Over F'') hP).left := by
    have hr : Set.range ⇑Ub0.ι = Set.univ := by
