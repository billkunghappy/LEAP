        ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology j).obj)
      (Opposite.op (W'.obj l))).hom s = 0 :=
by
  intro hs
  classical
  obtain ⟨hinit, haff, hφ, -, hlim, -⟩ := hA
  have hcofη := wc_et_geomstalk_cofiltered B η wc_etale_maps_agree_near_geom_point
  have hlift : ∀ l, (ξ ≫ φ l) ≫ (W'.obj l).right.hom = wcEtGeomPt B η := fun l =>
    (Category.assoc _ _ _).trans ((congrArg (fun k => ξ ≫ k) (hφa l)).trans hξ)
  have hcompat : ∀ {l l' : Λ} (t : l ⟶ l'), (ξ ≫ φ l) ≫ (W'.map t).right.left = ξ ≫ φ l' :=
    fun t => (Category.assoc _ _ _).trans (congrArg (fun k => ξ ≫ k) (hφ t))

  have L1 : ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
