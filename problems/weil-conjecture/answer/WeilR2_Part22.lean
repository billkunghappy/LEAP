    obtain ⟨eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing
      (IsLocalRing.ResidueField A) 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧
        q.val = p.val + 1 then (1 : IsLocalRing.ResidueField A) else 0)))) (ℓ ^ k) q
    exact eq.subsingleton

  obtain ⟨L⟩ := wc_et_supp_open_iso_of_vanish ((v₀ ≫ ψ) ≫ e) Oc hOc (ℓ ^ k) hMpos Dhh 1
    (hsub 1 le_rfl) (hsub 2 (by norm_num))

  obtain ⟨Uo, Vo, hUV, hcov, ⟨eUo⟩, ⟨eVo⟩⟩ :=
    wc_node_hyp_cone_punct_split (IsLocalRing.ResidueField A) Oc (hOc.trans hOcset)
  obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists Uo.ι (ℓ ^ k)
  obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists Vo.ι (ℓ ^ k)
  let Spl := AddEquiv.ofBijective (AddMonoidHom.prod (wcEtPull DU 1) (wcEtPull DV 1))
    (wc_et_zmodext_clopen_split (Oc : Scheme.{u}) Uo Vo hUV hcov (ℓ ^ k) hMpos DU DV 1)
  obtain ⟨DeU⟩ := wc_et_zmod_pull_data_exists eUo.hom (ℓ ^ k)
  obtain ⟨DeV⟩ := wc_et_zmod_pull_data_exists eVo.hom (ℓ ^ k)
  let PU := AddEquiv.ofBijective (wcEtPull DeU 1) (pullIso eUo.hom (ℓ ^ k) DeU 1)
  let PV := AddEquiv.ofBijective (wcEtPull DeV 1) (pullIso eVo.hom (ℓ ^ k) DeV 1)

  have hcardG : Finite (wcEtZModExt (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) :
        MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))) (ℓ ^ k) 1) ∧
      Nat.card (wcEtZModExt (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) :
        MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))) (ℓ ^ k) 1) ≤ ℓ ^ k := by
    have hk1 := (wc_affine_kummer_h1_card_of_pic (IsLocalRing.ResidueField A) ℓ hp hℓκ
      (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) (IsLocalRing.ResidueField A)))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (Localization.Away (MvPolynomial.X (0 : Fin 1) :
          MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))))
      (wc_et_gm_h1_affine_pic _)).2
    obtain ⟨hp1, hp2⟩ := wc_laurent_away_pic_units_card (IsLocalRing.ResidueField A) ℓ hp
    rw [hp1, hp2, one_mul] at hk1
    have hfin : Finite (wcEtCoh (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) :
        MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))) ℓ 1) :=
