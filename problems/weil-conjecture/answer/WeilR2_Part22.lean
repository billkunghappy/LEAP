    obtain ⟨A', f, u, hu⟩ := hS No s
    have hgs : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op No)).hom s =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A')).hom (ψ A'.right u) := by
      rw [P1 No A' f, hu]
    have hfw : A'.hom.left ≫ f.right.left = No.hom.left :=
      congrArg (fun k => k.left) (StructuredArrow.w f)
    have hy : ∀ (σ : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶
          Spec (.of (AlgebraicClosure (B.residueField η)))) (hσ : σ ≫ ξ = ξ),
        ∃ Dσ : wcEtPullData (Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) σ (𝟙 B)
