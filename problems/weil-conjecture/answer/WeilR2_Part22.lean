      have h := wc_field_alg_over_algclosed_acyclic Ω Ω (Algebra.IsAlgebraic.of_finite Ω Ω)
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) p
      first
        | exact ⟨fun a b => (h a).trans (h b).symm⟩
        | (unfold wcEtCoh; exact ⟨fun a b => (h a).trans (h b).symm⟩)
    haveI : Subsingleton (wcEtZModExt (Spec (.of Ω)) m (p + 1)) := e.subsingleton
    exact Subsingleton.elim _ _

  obtain ⟨hFull, hFaith⟩ := wc_et_closed_push_modules_full_faithful xb m Dx
  haveI := hFull
  haveI := hFaith
  let ε : Dx.Φ.obj (wcEtSuppObj Dx) ⟶ SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m) :=
    Dx.adj.counit.app (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m))
  haveI : IsIso ε := by
    haveI hcu : IsIso Dx.adj.counit := by
      first
        | exact Adjunction.counit_isIso_of_R_fully_faithful Dx.adj
        | exact @Adjunction.counit_isIso_of_R_fully_faithful _ _ _ _ _ _ Dx.adj hFull hFaith
        | infer_instance
    first
      | exact NatIso.isIso_app_of_isIso Dx.adj.counit _
      | infer_instance
  let εi : Dx.Φ.obj (wcEtSuppObj Dx) ≅ SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m) :=
    asIso ε

  have hRHS : ∀ (p : ℕ) (y : Abelian.Ext (Dx.Φ.obj (wcEtSuppObj Dx))
      (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m)) (p + 1)), y = 0 := by
    intro p y
    have hy : y = (Abelian.Ext.mk₀ εi.hom).comp
        ((Abelian.Ext.mk₀ εi.inv).comp y (zero_add _)) (zero_add _) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [hy, hpt p ((Abelian.Ext.mk₀ εi.inv).comp y (zero_add _)), Abelian.Ext.comp_zero]

  obtain ⟨n0, rfl⟩ := Int.eq_ofNat_of_zero_le hq.le
  obtain ⟨j, rfl⟩ : ∃ j, n0 = j + 1 := ⟨n0 - 1, by omega⟩
  obtain ⟨e⟩ := hleray (j + 1)
  haveI hsub : Subsingleton (Abelian.Ext (wcEtSuppObj Dx) (wcEtSuppObj Dx) (j + 1)) :=
    ⟨fun a b => e.injective ((hRHS j (e a)).trans (hRHS j (e b)).symm)⟩
  let eS := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing X m)) 0
  let f' : ShiftedHom
      ((DerivedCategory.singleFunctor _ 0).obj (wcEtSuppObj Dx))
      ((DerivedCategory.singleFunctor _ 0).obj (wcEtSuppObj Dx)) ((j + 1 : ℕ) : ℤ) :=
    eS.hom.app _ ≫ f ≫ (shiftFunctor _ ((j + 1 : ℕ) : ℤ)).map (eS.inv.app _)
  have hf' : f' = 0 := by
    haveI : Subsingleton (ShiftedHom
        ((DerivedCategory.singleFunctor _ 0).obj (wcEtSuppObj Dx))
        ((DerivedCategory.singleFunctor _ 0).obj (wcEtSuppObj Dx)) ((j + 1 : ℕ) : ℤ)) :=
      (Abelian.Ext.homEquiv (C := SheafOfModules.{u+1} (wcEtZModRing X m))).symm.subsingleton
    exact Subsingleton.elim _ _
  have hf : f = eS.inv.app _ ≫ f' ≫ (shiftFunctor _ ((j + 1 : ℕ) : ℤ)).map (eS.hom.app _) := by
    simp only [f', Category.assoc, Iso.inv_hom_id_app_assoc, ← Functor.map_comp,
      Iso.inv_hom_id_app]
    exact (Category.comp_id f).symm.trans
      (congrArg (fun t => f ≫ t) (CategoryTheory.Functor.map_id _ _).symm)
  rw [hf, hf', Limits.zero_comp, Limits.comp_zero]

theorem wc_et_tpl_odp_supp_top_card_le (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (hk : 1 ≤ k) (h4 : 4 ≤ n) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    Finite (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶ (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧) ∧
      Nat.card (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶ (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧) ≤ ℓ ^ k :=
by
  classical

  have core : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (p : X ⟶ Spec (.of K))
      [IsProper p] (z : X) (Zp : Scheme.{u}) (iz : Zp ⟶ X) [IsClosedImmersion iz],
      Set.range iz = {z} → ∀ (N : ℕ), 1 ≤ N → ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (Xt E : Scheme.{u}) (b : Xt ⟶ X) (iE : E ⟶ Xt), IsProper b → IsClosedImmersion iE →
      (∀ U : X.Opens, (U : Set X) = {z}ᶜ → IsIso (b ∣_ U)) → Set.range iE = b ⁻¹' {z} →
      SmoothOfRelativeDimension N (b ≫ p) → SmoothOfRelativeDimension (N - 1) (iE ≫ b ≫ p) →
      IrreducibleSpace Xt → IrreducibleSpace E →
      ∀ D₁ : wcEtPullData iz ℓ,
        Finite (wcEtSuppExt D₁ (2 * N)) ∧ Nat.card (wcEtSuppExt D₁ (2 * N)) ≤ ℓ := by
    intro K _ _ X p _ z Zp iz _ hrange N hN hℓK Xt E b iE hb hiE hiso hrE hsmX hsmE hirrX hirrE
    haveI := hb
    haveI := hiE
    haveI := hsmX
    haveI := hsmE
    haveI := hirrX
    haveI := hirrE
    have hz : IsClosed ({z} : Set X) := by
      rw [← hrange]; exact iz.isClosedEmbedding.isClosed_range
    haveI : IsClosedImmersion (X.fromSpecResidueField z) :=
      isClosed_singleton_iff_isClosedImmersion.mp hz
    have hrZ : Set.range (X.fromSpecResidueField z) = {z} := Scheme.range_fromSpecResidueField z
    have hisoZ : ∀ U : X.Opens, (U : Set X) = (Set.range (X.fromSpecResidueField z))ᶜ →
        IsIso (b ∣_ U) := by
      intro U hU
      rw [hrZ] at hU
      exact hiso U hU
    have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
    obtain ⟨s, hs⟩ : ∃ s, s + 1 = 2 * N := ⟨2 * N - 1, by omega⟩
    have hE's : Subsingleton (wcEtCoh (Limits.pullback b (X.fromSpecResidueField z)) ℓ s) := by
      haveI hfstC : IsClosedImmersion (Limits.pullback.fst b (X.fromSpecResidueField z)) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback b (X.fromSpecResidueField z)).flip inferInstance
      have hrng : Set.range (Limits.pullback.fst b (X.fromSpecResidueField z)) = Set.range iE := by
        rw [Scheme.Pullback.range_fst, hrZ, hrE]
      have hdimE' : topologicalKrullDim
          ↥(Limits.pullback (C := Scheme.{u}) b (X.fromSpecResidueField z)) =
          topologicalKrullDim E :=
        IsHomeomorph.topologicalKrullDim_eq _
          ((((Limits.pullback.fst b (X.fromSpecResidueField z)).isClosedEmbedding.isEmbedding.toHomeomorph).trans
            (Homeomorph.setCongr hrng)).trans
            (iE.isClosedEmbedding.isEmbedding.toHomeomorph.symm)).isHomeomorph
      have hdim : topologicalKrullDim
          ↥(Limits.pullback (C := Scheme.{u}) b (X.fromSpecResidueField z)) ≤
          ((N - 1 : ℕ) : WithBot ℕ∞) := by
        rw [hdimE']
        exact wc_smooth_alg_closed_dim_le K E (iE ≫ b ≫ p) (N - 1)
      have hv := wc_et_cd_proper_torsion K _
        (Limits.pullback.snd b (X.fromSpecResidueField z) ≫ X.fromSpecResidueField z ≫ p)
        (N - 1) hdim ℓ hℓK _ (wc_et_const_zmod_nsmul_zero _ ℓ) s (by omega)
      exact ⟨fun a c => (hv a).trans (hv c).symm⟩
    have hpt : Subsingleton (wcEtCoh (Spec (X.residueField z)) ℓ (2 * N)) := by
      have hdim0 : topologicalKrullDim (Spec (X.residueField z)) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
        rw [show topologicalKrullDim (Spec (X.residueField z)) =
            topologicalKrullDim (PrimeSpectrum (X.residueField z)) from rfl,
          PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, ringKrullDim_eq_zero_of_field]
        simp
      have hv := wc_et_cd_proper_torsion K _ (X.fromSpecResidueField z ≫ p) 0 hdim0 ℓ hℓK _
        (wc_et_const_zmod_nsmul_zero _ ℓ) (2 * N) (by omega)
      exact ⟨fun a c => (hv a).trans (hv c).symm⟩
    obtain ⟨hfX, hcX⟩ := wc_et_top_coh_card_le K Xt (b ≫ p) N ℓ hℓK
    obtain ⟨hfin, hcard⟩ := wc_et_abstract_blowup_card_le X Xt _ b (X.fromSpecResidueField z)
      hisoZ ℓ hℓ0 (2 * N) hfX hpt (fun q' hq' => by
        obtain rfl : q' = s := by omega
        exact hE's)
    let O : X.Opens := ⟨{z}ᶜ, hz.isOpen_compl⟩
    have hO : (O : Set X) = {z}ᶜ := rfl
    have hU : ((b ⁻¹ᵁ O : Xt.Opens) : Set Xt) = (Set.range iE)ᶜ := by
      show b ⁻¹' (O : Set X) = _
      rw [hO, hrE, Set.preimage_compl]
    have hD : ∀ Dd : wcEtPullData iE ℓ,
        Finite (wcEtSuppExt Dd (2 * N)) ∧ Nat.card (wcEtSuppExt Dd (2 * N)) ≤ ℓ := fun Dd =>
      wc_et_smooth_pair_supp_top_card_le K (b ≫ p) N (N - 1) 1 (by omega) iE ℓ hℓK Dd
    haveI hφiso : IsIso (b ∣_ O) := hiso O hO
    have hrestr : ∀ Dj : wcEtPullData O.ι ℓ, Function.Surjective (wcEtPull Dj s) := by
      intro Dj y
      obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists (b ⁻¹ᵁ O).ι ℓ
      obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists b ℓ
      obtain ⟨Dφ⟩ := wc_et_zmod_pull_data_exists (b ∣_ O) ℓ
      obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists ((b ⁻¹ᵁ O).ι ≫ b) ℓ
      obtain ⟨Dψ⟩ := wc_et_zmod_pull_data_exists (inv (b ∣_ O)) ℓ
      obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (O : Scheme.{u})) ℓ
      have hφinj : ∀ a, wcEtPull Dφ s a = 0 → a = 0 := by
        intro a ha
        apply wc_et_pull_id_injective Did s a
        rw [wc_et_pull_comp (b ∣_ O) (inv (b ∣_ O)) (𝟙 _) (IsIso.inv_hom_id _) Dφ Dψ Did s a, ha,
          map_zero]
      have h1 := wc_et_smooth_pair_open_restr_surj K (b ≫ p) N iE ℓ hℓK (b ⁻¹ᵁ O) hU hD s hs DU
      have h2 := wc_et_abstract_blowup_pull_surj X Xt _ b (X.fromSpecResidueField z) hisoZ ℓ hℓ0 s
        hE's Db
      obtain ⟨w, hw⟩ := h1 (wcEtPull Dφ s y)
      obtain ⟨v, hv⟩ := h2 w
      refine ⟨v, ?_⟩
      have e1 := wc_et_pull_comp b (b ⁻¹ᵁ O).ι ((b ⁻¹ᵁ O).ι ≫ b) rfl Db DU Dk s v
      have e2 := wc_et_pull_comp O.ι (b ∣_ O) ((b ⁻¹ᵁ O).ι ≫ b) (morphismRestrict_ι b O)
        Dj Dφ Dk s v
      apply sub_eq_zero.mp
      apply hφinj
      rw [map_sub, ← e2, e1, hv, hw, sub_self]

    have hO' : (O : Set X) = (Set.range iz)ᶜ := by rw [hO, hrange]
    intro D₁
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O.ι ℓ
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
    obtain ⟨-, -, L3⟩ := wc_et_supp_open_les iz O hO' ℓ D₁ Dj
    obtain ⟨δ, P1, P2⟩ := L3 s (2 * N) (by omega)
    let ι := (Abelian.Ext.mk₀ (wcEtSuppUnitMap D₁)).precomp
      (SheafOfModules.unit (wcEtZModRing X ℓ)) (zero_add (2 * N))
    have hι : Function.Injective ι := by
      rw [injective_iff_map_eq_zero]
      intro t ht
      have ht' : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D₁)).comp t (zero_add (2 * N)) = 0 := ht
      obtain ⟨c, rfl⟩ := (P1 t).mp ht'
      obtain ⟨v, hv⟩ := hrestr Dj c
      exact (P2 c).mpr ⟨v, hv⟩
    obtain ⟨eY⟩ := wc_et_zmodext_coh_equiv X ℓ (2 * N)
    haveI := hfin
    haveI := hfX
    haveI : Finite (wcEtZModExt X ℓ (2 * N)) := Finite.of_equiv _ eY.symm
    refine ⟨Finite.of_injective ι hι, ?_⟩
    calc Nat.card (wcEtSuppExt D₁ (2 * N)) ≤ Nat.card (wcEtZModExt X ℓ (2 * N)) :=
          Nat.card_le_card_of_injective ι hι
      _ = Nat.card (wcEtCoh X ℓ (2 * N)) := Nat.card_congr eY
      _ ≤ Nat.card (wcEtCoh Xt ℓ (2 * N)) := hcard
      _ ≤ ℓ := hcX

  have hrng_gen : ∀ (Z : Scheme.{u}) (z : Z), Set.range (wcEtGeomPt Z z) = {z} := by
    intro Z z
    apply (Set.Nonempty.subset_singleton_iff (Set.range_nonempty_iff_nonempty.mpr
      ⟨IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField z))⟩)).mp
    rintro _ ⟨w, rfl⟩
    have h1 : (Z.fromSpecResidueField z) (Spec.map (CommRingCat.ofHom
        (algebraMap (Z.residueField z) (AlgebraicClosure (Z.residueField z)))) w) ∈
        Set.range (Z.fromSpecResidueField z) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at h1
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact h1
  haveI hcl := wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs

  have hv : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)),
      Limits.pullback.snd D.f a (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A) z) =
        IsLocalRing.closedPoint A := by
    intro z
    have hc := congrArg (fun φ => φ z)
      (Limits.pullback.condition (f := Limits.pullback.snd D.f a) (g := wcQmSp A))
    simp only [Scheme.Hom.comp_apply] at hc
    rw [hc]
    show Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) _ = _
    rw [Spec.map_apply, CommRingCat.hom_ofHom]
    exact IsLocalRing.PrimeSpectrum.comap_residue _ _
  have hxA : Limits.pullback.snd D.f a x = IsLocalRing.closedPoint A := by
    rw [← hxs]; exact hv xs
  have haclosed : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    obtain ⟨ε, -, hε⟩ := hA.2.2.2.2.2
    have h5 : Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom ε)
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F'')))))) =
        IsLocalRing.closedPoint A := by
      rw [Spec.map_apply, CommRingCat.hom_ofHom]
      exact IsLocalRing.PrimeSpectrum.comap_residue _ _
    have h4 : wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) ∈
        Set.range (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))) := ⟨_, rfl⟩
    rw [hrng_gen] at h4
    have e1 : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a)
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) =
        a (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom ε)
          (IsLocalRing.closedPoint (AlgebraicClosure
            ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))))) :=
      (Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)
    have e2 : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a)
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))
          (IsLocalRing.closedPoint (AlgebraicClosure
            ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) := by
      rw [hε]
    calc a (IsLocalRing.closedPoint A)
        = a (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom ε)
          (IsLocalRing.closedPoint (AlgebraicClosure
            ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))))) :=
          (congrArg (fun p => a p) h5).symm
      _ = _ := e1.symm.trans e2
      _ = D.S i (IsLocalRing.closedPoint F'') := Set.mem_singleton_iff.mp h4
  haveI hWa : WeaklyEtale a := wc_shdata_weaklyEtale _ A Λ W' φ a hA
  let V : (wcP1Over F'').left.ProEt := Scheme.ProEt.mk a
  let e : V.left ≅ Spec (.of A) := Iso.refl (Spec (.of A))
  have he : e.hom = 𝟙 _ := rfl
  have hei : e.inv (IsLocalRing.closedPoint A) = IsLocalRing.closedPoint A := rfl
  have hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') := by
    rw [hei]; exact haclosed
  let σ : Limits.pullback D.f a ≅ Limits.pullback V.hom D.f := Limits.pullbackSymmetry D.f a
  have hσfst : σ.hom ≫ Limits.pullback.fst V.hom D.f = Limits.pullback.snd D.f a :=
    Limits.pullbackSymmetry_hom_comp_fst D.f a
  have hσsnd : σ.hom ≫ Limits.pullback.snd V.hom D.f = Limits.pullback.fst D.f a :=
    Limits.pullbackSymmetry_hom_comp_snd D.f a
  have eq₁ : Limits.pullback.snd D.f a ≫ 𝟙 _ =
      σ.hom ≫ (Limits.pullback.fst V.hom D.f ≫ e.hom) := by
