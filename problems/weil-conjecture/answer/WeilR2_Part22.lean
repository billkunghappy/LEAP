        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) σ.hom
        (𝟙 _) (𝟙 _) eq₁ ((Category.comp_id _).trans (Category.id_comp _).symm),
      inferInstance, Limits.pullback.lift_fst _ _ _,
      (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)⟩
  let x' : ((wcProEtPullback D.f).obj V).left := σ.hom x
  have hx₁ : Limits.pullback.fst V.hom D.f x' = e.inv (IsLocalRing.closedPoint A) := by
