    refine ⟨u, fun y => ?_⟩
    obtain ⟨t, ht⟩ := hmul y
    rw [hrel y t ht, ht, ← hu]
    exact mul_smul_comm _ _ _

  have key : ∀ {𝒞 : Type _} [Category 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory 𝒞}
