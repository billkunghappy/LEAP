          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A')).hom s' →
        ∃ (A'' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : A'' ⟶ A)
