      { toFun := fun z => (u : ZMod (ℓ ^ k)) * z
        invFun := fun z => ((u⁻¹ : (ZMod (ℓ ^ k))ˣ) : ZMod (ℓ ^ k)) * z
        left_inv := fun z => by simp [← mul_assoc]
        right_inv := fun z => by simp [← mul_assoc]
        map_add' := fun z w => mul_add _ _ _ }
    refine ⟨eG.trans (mu.trans eM.symm), fun y => ?_⟩
    have h1 := hu y
    change (u : ZMod (ℓ ^ k)) * eG (κ y) = eM (ρ y) at h1
