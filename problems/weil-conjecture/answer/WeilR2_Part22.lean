    intro b c d L₁ L₂ h
    rw [hLin L₁ L₂ (L₂ ∘ₗ L₁) (fun _ => rfl)]
    exact hLin0 _ h

  obtain ⟨r₁, ⟨θ₁⟩⟩ := h₁
  obtain ⟨r₂, ⟨θ₂⟩⟩ := h₂
  obtain ⟨E⟩ : Nonempty ((Fin (r₁ + r₂) → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]]
      (Fin r₁ → ℚ_[ℓ]) × (Fin r₂ → ℚ_[ℓ])) := ⟨LinearEquiv.ofFinrankEq _ _ (by simp)⟩
  let in₁ : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r₁ + r₂) → ℚ_[ℓ]) :=
    E.symm.toLinearMap ∘ₗ LinearMap.inl ℚ_[ℓ] (Fin r₁ → ℚ_[ℓ]) (Fin r₂ → ℚ_[ℓ])
  let in₂ : (Fin r₂ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r₁ + r₂) → ℚ_[ℓ]) :=
    E.symm.toLinearMap ∘ₗ LinearMap.inr ℚ_[ℓ] (Fin r₁ → ℚ_[ℓ]) (Fin r₂ → ℚ_[ℓ])
