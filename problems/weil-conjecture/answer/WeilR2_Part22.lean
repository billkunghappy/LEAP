        (b : Xt ⟶ Xs) (iE : E ⟶ Xt) [IsProper b] [IsClosedImmersion iE] (hne : Nonempty Xt)
        (hiso : ∀ U : Xs.Opens, (U : Set Xs) = {xs}ᶜ → IsIso (b ∣_ U))
