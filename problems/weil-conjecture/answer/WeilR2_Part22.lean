      intro f x
      have e := (f.val.app (Opposite.op T)).hom.map_smul x
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op T))
      refine Eq.trans ?_ (e.trans ?_)
      · show (f.val.app (Opposite.op T)).hom x = (f.val.app (Opposite.op T)).hom
          (x * (1 : (wcEtZModRing S' m).obj.obj (Opposite.op T)))
        rw [mul_one]
      · rfl
    have hbij := s2 (SheafOfModules.unit (wcEtZModRing S' m))
    obtain ⟨k, hk⟩ := hbij.2 c
    have hk' : ev k = c := hk
    have hkh : k ≫ h = 𝟙 _ := hbij.1 (by
      change @Eq ((wcEtZModRing S' m).obj.obj (Opposite.op T))
        ((h.val.app (Opposite.op T)).hom ((k.val.app (Opposite.op T)).hom
          (1 : (wcEtZModRing S' m).obj.obj (Opposite.op T)))) 1
      exact (congrArg (fun y : (wcEtZModRing S' m).obj.obj (Opposite.op T) =>
        (h.val.app (Opposite.op T)).hom y) hk').trans hc)
    have hhk : h ≫ k = 𝟙 _ := hbij.1 (by
      change @Eq ((wcEtZModRing S' m).obj.obj (Opposite.op T))
        ((k.val.app (Opposite.op T)).hom (ev h)) 1
