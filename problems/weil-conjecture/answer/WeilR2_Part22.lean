          Limits.pullback.snd g (wcEtGeomPt B η) ≫ N.hom.left :=
      fun N => Limits.pullback.lift_fst _ _ _
    have htts : ∀ N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B),
        tt N ≫ Limits.pullback.snd N.right.hom g = Limits.pullback.fst g (wcEtGeomPt B η) :=
      fun N => Limits.pullback.lift_snd _ _ _
    have hπf : ∀ l : Λ, πm l ≫ Limits.pullback.fst (W'.obj l).right.hom g =
        Limits.pullback.snd g a ≫ φ l :=
      fun l => Limits.pullback.lift_fst _ _ _
    have hπs : ∀ l : Λ, πm l ≫ Limits.pullback.snd (W'.obj l).right.hom g =
        Limits.pullback.fst g a :=
      fun l => Limits.pullback.lift_snd _ _ _
    have hxf : ∀ (N' N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))
        (f : N' ⟶ N), Limits.pullback.map N'.right.hom g N.right.hom g f.right.left (𝟙 X) (𝟙 B)
