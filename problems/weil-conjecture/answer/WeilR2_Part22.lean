      (((ψ j).restrictScalars
        (FractionRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x))).comp
          Algebra.TensorProduct.includeRight) (fun _ _ => Commute.all _ _) = ψ j := by
    intro j
    apply Algebra.TensorProduct.ext'
    intro a b
    have hab : (a ⊗ₜ[FractionRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)] b) =
        a • ((1 : FractionRing H) ⊗ₜ[FractionRing
          ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)] b) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [Algebra.TensorProduct.lift_tmul, hab, map_smul, smul_eq_mul]
    rfl
  convert hψ using 1
  funext z j
  exact DFunLike.congr_fun (key j) z

theorem wc_hfe_dvr_fibre_reduced (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (ϖ : O) (hϖ : Irreducible ϖ)
    (L : Type u) [CommRing L] [Algebra O L] [Algebra (FractionRing O) L]
    [IsScalarTower O (FractionRing O) L] [Module.Finite (FractionRing O) L]
    (H : Type u) [CommRing H] [IsDomain H] [IsDiscreteValuationRing H]
    (g : O →+* H) (hg : Function.Injective g) (hgϖ : Irreducible (g ϖ))
    (Fh : Type u) [Field Fh] [Algebra H Fh] [IsFractionRing H Fh] (κ : FractionRing O →+* Fh)
    (hκ : ∀ a : O, κ (algebraMap O (FractionRing O) a) = algebraMap H Fh (g a)) :
    letI : Algebra (FractionRing O) Fh := κ.toAlgebra
    ∀ (n : ℕ) (φ : Fin n → (L →ₐ[FractionRing O] Fh)),
      Function.Bijective (fun z : TensorProduct (FractionRing O) Fh L => fun i =>
        Algebra.TensorProduct.lift (AlgHom.id Fh Fh) (φ i) (fun _ _ => Commute.all _ _) z) →
      ∀ x : L, IsIntegral O x → ∀ N : ℕ,
        (∃ c : L, IsIntegral O c ∧ x ^ N = algebraMap O L ϖ * c) →
        ∃ y : L, IsIntegral O y ∧ x = algebraMap O L ϖ * y :=
by
  classical
  letI : Algebra (FractionRing O) Fh := κ.toAlgebra
  intro n φ hbij x hx N hN
  obtain ⟨c, hc, hxc⟩ := hN
  have hκA : ∀ a : FractionRing O, algebraMap (FractionRing O) Fh a = κ a := fun a => rfl

  have s3 : ∀ y : L, (LinearMap.mulLeft (FractionRing O) y).charpoly.map
      (algebraMap (FractionRing O) Fh) = ∏ i : Fin n, (Polynomial.X - Polynomial.C (φ i y)) := by
    intro y
    let Ψ : TensorProduct (FractionRing O) Fh L →ₗ[Fh] (Fin n → Fh) :=
      LinearMap.pi (fun i => (Algebra.TensorProduct.lift (AlgHom.id Fh Fh) (φ i)
        (fun _ _ => Commute.all _ _)).toLinearMap)
    have hΨ : Function.Bijective Ψ := hbij
    let e := LinearEquiv.ofBijective Ψ hΨ
    let μF := (LinearMap.mulLeft (FractionRing O) y).baseChange Fh
    let D : (Fin n → Fh) →ₗ[Fh] (Fin n → Fh) :=
      Matrix.toLin' (Matrix.diagonal (fun i => φ i y))
    have hint : ∀ z, Ψ (μF z) = D (Ψ z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul f l =>
        funext i
        simp only [μF, D, Ψ, LinearMap.baseChange_tmul, LinearMap.mulLeft_apply,
          LinearMap.pi_apply, AlgHom.toLinearMap_apply, Algebra.TensorProduct.lift_tmul,
          AlgHom.id_apply, map_mul, Matrix.toLin'_apply, Matrix.mulVec_diagonal]
        ring
      | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]
    have hconj : e.conj μF = D := by
      apply LinearMap.ext
      intro v
      rw [LinearEquiv.conj_apply]
      simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply]
      have h1 : e (μF (e.symm v)) = D (e (e.symm v)) := hint (e.symm v)
      rw [h1, LinearEquiv.apply_symm_apply]
    rw [← LinearMap.charpoly_baseChange, ← LinearEquiv.charpoly_conj e, hconj,
      ← LinearMap.charpoly_toMatrix D (Pi.basisFun Fh (Fin n)), LinearMap.toMatrix_eq_toMatrix',
      LinearMap.toMatrix'_toLin', Matrix.charpoly_diagonal]

  have s4 : ∀ y : L, (∀ j : ℕ, (LinearMap.mulLeft (FractionRing O) y).charpoly.coeff j ∈
      Set.range (algebraMap O (FractionRing O))) → IsIntegral O y := by
    intro y h
    have hmon : (LinearMap.mulLeft (FractionRing O) y).charpoly.Monic :=
      LinearMap.charpoly_monic _
    have hl : (LinearMap.mulLeft (FractionRing O) y).charpoly ∈
        Polynomial.lifts (algebraMap O (FractionRing O)) :=
      (Polynomial.lifts_iff_coeff_lifts _).mpr h
    obtain ⟨p, hp, -, hpm⟩ := Polynomial.lifts_and_degree_eq_and_monic hl hmon
    have hCH : Polynomial.aeval (LinearMap.mulLeft (FractionRing O) y)
        (LinearMap.mulLeft (FractionRing O) y).charpoly = 0 :=
      LinearMap.aeval_self_charpoly _
    have hlm : Algebra.lmul (FractionRing O) L y = LinearMap.mulLeft (FractionRing O) y := by
      ext z; simp [Algebra.coe_lmul_eq_mul]
    have h1 : Polynomial.aeval y (LinearMap.mulLeft (FractionRing O) y).charpoly = 0 := by
      have h2 := Polynomial.aeval_algHom_apply (Algebra.lmul (FractionRing O) L) y
        (LinearMap.mulLeft (FractionRing O) y).charpoly
      rw [hlm, hCH] at h2
      have h3 := LinearMap.congr_fun h2 1
      simpa [Algebra.coe_lmul_eq_mul] using h3.symm
    refine ⟨p, hpm, ?_⟩
    rw [← Polynomial.aeval_def, ← Polynomial.aeval_map_algebraMap (FractionRing O), hp]
    exact h1

  have s1 : ∀ (a : FractionRing O) (h : H), κ a = algebraMap H Fh h →
      a ∈ Set.range (algebraMap O (FractionRing O)) := by
    intro a h ha
    rcases ValuationRing.isInteger_or_isInteger O a with ⟨b, hb⟩ | ⟨b, hb⟩
    · exact ⟨b, hb⟩
    · by_cases ha0 : a = 0
      · exact ⟨0, by rw [ha0, map_zero]⟩
      by_cases hbu : IsUnit b
      · refine ⟨↑(hbu.unit⁻¹), ?_⟩
        have h1 : algebraMap O (FractionRing O) b *
            algebraMap O (FractionRing O) ↑(hbu.unit⁻¹) = 1 := by
          rw [← map_mul, IsUnit.mul_val_inv, map_one]
        rw [hb] at h1
        have h2 := congrArg (a * ·) h1
        simp only [← mul_assoc, mul_inv_cancel₀ ha0, one_mul, mul_one] at h2
        exact h2
      · exfalso
        have hmax : b ∈ IsLocalRing.maximalIdeal O := (IsLocalRing.mem_maximalIdeal b).mpr hbu
        rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ] at hmax
        obtain ⟨b', hb'⟩ := Ideal.mem_span_singleton'.mp hmax
        have h1 : κ a * κ a⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel₀ ha0, map_one]
        rw [ha, ← hb, hκ, ← map_mul] at h1
        have h2 : h * g b = 1 := IsFractionRing.injective H Fh (by rw [h1, map_one])
        have h3 : IsUnit (g b) := isUnit_of_mul_isUnit_right (by rw [h2]; exact isUnit_one)
        rw [← hb', map_mul] at h3
        exact hgϖ.not_isUnit (isUnit_of_mul_isUnit_right h3)
  have hcomp : ∀ i a, φ i (algebraMap O L a) = algebraMap H Fh (g a) := by
    intro i a
    rw [IsScalarTower.algebraMap_apply O (FractionRing O) L, AlgHom.commutes, hκA, hκ]

  have s2 : ∀ i (c : L), IsIntegral O c → ∃ h : H, algebraMap H Fh h = φ i c := by
    intro i c hc
    obtain ⟨p, hpm, hp⟩ := hc
    have hring : (algebraMap H Fh).comp g = (φ i : L →+* Fh).comp (algebraMap O L) := by
      ext a
      simp [hcomp]
    have hI : IsIntegral H (φ i c) := by
      refine ⟨p.map g, hpm.map g, ?_⟩
      rw [Polynomial.eval₂_map, hring]
      have := Polynomial.hom_eval₂ p (algebraMap O L) (φ i : L →+* Fh) c
      rw [hp, map_zero] at this
      exact this.symm
    exact IsIntegrallyClosed.isIntegral_iff.mp hI
  choose hxi hhxi using fun i => s2 i x hx
  choose hci hhci using fun i => s2 i c hc
  have hdiv : ∀ i, hxi i ^ N = g ϖ * hci i := fun i =>
    IsFractionRing.injective H Fh (by
      rw [map_pow, hhxi, ← map_pow, hxc, map_mul, hcomp, map_mul, hhci])
  have hprime : Prime (g ϖ) := hgϖ.prime
  choose k hk using fun i => hprime.dvd_of_dvd_pow (Dvd.intro _ (hdiv i).symm)
  have hϖK : algebraMap O (FractionRing O) ϖ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective O (FractionRing O))).mpr hϖ.ne_zero
  have hgϖ0 : algebraMap H Fh (g ϖ) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective H Fh)).mpr hgϖ.ne_zero
  set y0 : L := algebraMap (FractionRing O) L (algebraMap O (FractionRing O) ϖ)⁻¹ * x with hy0
  have hφy : ∀ i, φ i y0 = algebraMap H Fh (k i) := by
    intro i
    rw [hy0, map_mul, AlgHom.commutes, hκA, map_inv₀, hκ, ← hhxi, hk, map_mul, ← mul_assoc,
      inv_mul_cancel₀ hgϖ0, one_mul]
  have hsplit := s3 y0
  have hcoef : ∀ j, κ ((LinearMap.mulLeft (FractionRing O) y0).charpoly.coeff j) =
      algebraMap H Fh ((∏ i : Fin n, (Polynomial.X - Polynomial.C (k i))).coeff j) := by
    intro j
    have h1 := congrArg (fun p => Polynomial.coeff p j) hsplit
    simp only [Polynomial.coeff_map] at h1
    rw [← hκA, h1, ← Polynomial.coeff_map, Polynomial.map_prod]
    simp [hφy]
  have hint : IsIntegral O y0 := s4 y0 (fun j => s1 _ _ (hcoef j))
  refine ⟨y0, hint, ?_⟩
  rw [hy0, IsScalarTower.algebraMap_apply O (FractionRing O) L, ← mul_assoc, ← map_mul,
    mul_inv_cancel₀ hϖK, map_one, one_mul]

theorem wc_hfe_etale_of_reduced_fibre (O C : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [PerfectField (IsLocalRing.ResidueField O)] [CommRing C]
    [Algebra O C] [Module.Finite O C] [Module.IsTorsionFree O C] (ϖ : O) (hϖ : Irreducible ϖ)
    (hred : ∀ x : C, ∀ N : ℕ, x ^ N ∈ Ideal.span {algebraMap O C ϖ} →
      x ∈ Ideal.span {algebraMap O C ϖ}) :
    Algebra.Etale O C :=
by
  classical

  have s3 : ∀ (k A : Type u) [Field k] [PerfectField k] [CommRing A] [Algebra k A]
      [Module.Finite k A] [IsReduced A], Algebra.FormallyUnramified k A := by
    intro k A _ _ _ _ _ _
    haveI : IsArtinianRing A := IsArtinianRing.of_finite k A
    let e : A ≃ₐ[k] ((M : MaximalSpectrum A) → A ⧸ M.asIdeal) :=
      (IsArtinianRing.equivPi A).restrictScalars k
    haveI : ∀ M : MaximalSpectrum A, Algebra.FormallyUnramified k (A ⧸ M.asIdeal) := by
      intro M
      letI : Field (A ⧸ M.asIdeal) := Ideal.Quotient.field M.asIdeal
      haveI : Module.Finite k (A ⧸ M.asIdeal) := Module.Finite.quotient k M.asIdeal
      haveI : Algebra.IsAlgebraic k (A ⧸ M.asIdeal) := Algebra.IsAlgebraic.of_finite k _
      haveI : Algebra.IsSeparable k (A ⧸ M.asIdeal) := inferInstance
      exact Algebra.FormallyUnramified.of_isSeparable k _
    haveI : Algebra.FormallyUnramified k ((M : MaximalSpectrum A) → A ⧸ M.asIdeal) :=
      inferInstance
    exact Algebra.FormallyUnramified.of_equiv e.symm

  have s6 : ∀ (O' C' : Type u) [CommRing O'] [IsLocalRing O'] [CommRing C'] [Algebra O' C']
      [Algebra.IsIntegral O' C'] (t : O'), t ∈ IsLocalRing.maximalIdeal O' →
      algebraMap O' C' t ∈ (⊥ : Ideal C').jacobson := by
    intro O' C' _ _ _ _ _ t ht
    rw [Ideal.jacobson, Ideal.mem_sInf]
    rintro P ⟨-, hP⟩
    have h1 : (P.comap (algebraMap O' C')).IsMaximal := by
      haveI := hP
      have := Ideal.IsMaximal.under O' P
      rwa [Ideal.under_def] at this
    have h2 := IsLocalRing.eq_maximalIdeal h1
    rw [← Ideal.mem_comap, h2]
    exact ht

  have s5 : ∀ (R C' : Type u) [CommRing R] [CommRing C'] [Algebra R C'] [Algebra.FiniteType R C']
      (t : R), algebraMap R C' t ∈ (⊥ : Ideal C').jacobson →
      Algebra.FormallyUnramified R (C' ⧸ Ideal.span {algebraMap R C' t}) →
      Algebra.FormallyUnramified R C' := by
    intro R C' _ _ _ _ t hjac hB
    haveI : Subsingleton (Ω[(C' ⧸ Ideal.span {algebraMap R C' t})⁄R]) :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    have hsurj : Function.Surjective (algebraMap C' (C' ⧸ Ideal.span {algebraMap R C' t})) := by
      rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective
    have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R C'
      (C' ⧸ Ideal.span {algebraMap R C' t}) hsurj
    have hzero : ∀ y, KaehlerDifferential.kerCotangentToTensor R C'
        (C' ⧸ Ideal.span {algebraMap R C' t}) y = 0 := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ y
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
      have hx : (x : C') ∈ Ideal.span {algebraMap R C' t} := by
        have h := x.2
        rw [RingHom.mem_ker] at h
        exact Ideal.Quotient.eq_zero_iff_mem.mp h
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hx
      rw [← ha, Derivation.leibniz, Derivation.map_algebraMap, smul_zero, zero_add,
        ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _),
        TensorProduct.zero_tmul]
    have hall : ∀ y : TensorProduct C' (C' ⧸ Ideal.span {algebraMap R C' t}) Ω[C'⁄R], y = 0 := by
      intro y
      obtain ⟨w, hw⟩ := (hex y).mp (Subsingleton.elim _ _)
      rw [← hw, hzero]
    haveI : Subsingleton (TensorProduct C' (C' ⧸ Ideal.span {algebraMap R C' t}) Ω[C'⁄R]) :=
      ⟨fun y z => by rw [hall y, hall z]⟩
    haveI : Subsingleton
        (Ω[C'⁄R] ⧸ (Ideal.span {algebraMap R C' t}) • (⊤ : Submodule C' Ω[C'⁄R])) :=
      (TensorProduct.quotTensorEquivQuotSMul (Ω[C'⁄R])
        (Ideal.span {algebraMap R C' t})).symm.toEquiv.subsingleton
    have htop : (Ideal.span {algebraMap R C' t}) • (⊤ : Submodule C' Ω[C'⁄R]) = ⊤ :=
      Submodule.Quotient.subsingleton_iff.mp inferInstance
    have hfg : (⊤ : Submodule C' Ω[C'⁄R]).FG := Module.Finite.fg_top
    have hjacI : Ideal.span {algebraMap R C' t} ≤ (⊥ : Ideal C').jacobson :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hjac)
    have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ ⊤ hfg (le_of_eq htop.symm)
      hjacI
    haveI : Subsingleton (Ω[C'⁄R]) := ⟨fun a b => by
      have ha : a ∈ (⊤ : Submodule C' Ω[C'⁄R]) := Submodule.mem_top
      have hb : b ∈ (⊤ : Submodule C' Ω[C'⁄R]) := Submodule.mem_top
      rw [hbot, Submodule.mem_bot] at ha hb
      rw [ha, hb]⟩
    exact (Algebra.formallyUnramified_iff R C').mpr inferInstance

  have hm : IsLocalRing.maximalIdeal O = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hJ : Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O) =
      Ideal.span {algebraMap O C ϖ} := by
    rw [hm, Ideal.map_span, Set.image_singleton]

  haveI : Module.Free O C := Module.free_of_finite_type_torsion_free'
  haveI : Module.Flat O C := Module.Flat.of_free
  haveI : Algebra.FinitePresentation O C :=
    Algebra.FinitePresentation.of_finiteType.mp (Module.Finite.finiteType C)

  haveI hrad : IsReduced (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O)) := by
    rw [← Ideal.isRadical_iff_quotient_reduced]
    intro x hx
    obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hx
    rw [hJ] at hN ⊢
    exact hred x N hN
  letI alg : Algebra (O ⧸ IsLocalRing.maximalIdeal O)
      (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O)) :=
    Ideal.Quotient.algebraQuotientMapQuotient
  haveI tow : IsScalarTower O (O ⧸ IsLocalRing.maximalIdeal O)
      (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O)) :=
    Ideal.Quotient.tower_quotient_map_quotient
  haveI : Module.Finite (O ⧸ IsLocalRing.maximalIdeal O)
      (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O)) :=
    Module.Finite.of_restrictScalars_finite O _ _
  haveI : Algebra.FormallyUnramified O (O ⧸ IsLocalRing.maximalIdeal O) :=
    Algebra.FormallyUnramified.of_surjective (Algebra.ofId O _) Ideal.Quotient.mk_surjective
  have hfuk : Algebra.FormallyUnramified (O ⧸ IsLocalRing.maximalIdeal O)
      (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O)) :=
    @s3 (O ⧸ IsLocalRing.maximalIdeal O)
      (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O))
      (IsLocalRing.ResidueField.field O) ‹PerfectField (IsLocalRing.ResidueField O)› _ alg
      ‹_› hrad
  haveI : Algebra.FormallyUnramified O
      (C ⧸ Ideal.map (algebraMap O C) (IsLocalRing.maximalIdeal O)) :=
    Algebra.FormallyUnramified.comp O (O ⧸ IsLocalRing.maximalIdeal O) _
  have hfu2 : Algebra.FormallyUnramified O (C ⧸ Ideal.span {algebraMap O C ϖ}) :=
    Algebra.FormallyUnramified.of_equiv (Ideal.quotientEquivAlgOfEq O hJ)

  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal O := by
    rw [hm]; exact Ideal.mem_span_singleton_self ϖ
  have hjac := s6 O C ϖ hϖm
  haveI : Algebra.FormallyUnramified O C := s5 O C ϖ hjac hfu2
  exact Algebra.Etale.of_formallyUnramified_of_flat

theorem wc_hmg_fet_extend (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S' : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS' : ∀ i, S' i ≫ (wcP1Over F'').hom = 𝟙 _)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
      ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S' i (IsLocalRing.closedPoint F''))
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme)
    (hfin : IsFinite πE) (het : Etale πE) (hsurj : Surjective πE)
    (hsplit : ∀ (i : Fin m) (V : (wcP1Over F'').left.ProEt)
        (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = S' i (IsLocalRing.closedPoint F'') →
        ∀ y : ↥(Limits.pullback πE (Limits.pullback.snd v.left Ub.ι) : Scheme.{u}),
          ∃ sec : Limits.pullback v.left Ub.ι ⟶ Limits.pullback πE (Limits.pullback.snd v.left Ub.ι),
            sec ≫ Limits.pullback.snd _ _ = 𝟙 _ ∧ y ∈ Set.range ⇑sec) :
    ∃ (Eb : Scheme.{u}) (πEb : Eb ⟶ (wcGeomPoint F'' (wcP1Over F'') hP).left) (j : E ⟶ Eb),
      IsFinite πEb ∧ Etale πEb ∧ Surjective πEb ∧ IsPullback j πE πEb Ub.ι :=
by
  classical

  have alg_glue : ∀ (O D : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
      [PerfectField (IsLocalRing.ResidueField O)] [CommRing D] [Algebra O D]
      [Algebra (FractionRing O) D] [IsScalarTower O (FractionRing O) D]
      [Module.Finite (FractionRing O) D] [Algebra.Etale (FractionRing O) D]
      (H : Type u) [CommRing H] [IsDomain H] [IsDiscreteValuationRing H]
      (g : O →+* H) (_ : Function.Injective g) (_ : ∀ ϖ, Irreducible ϖ → Irreducible (g ϖ))
      (Fh : Type u) [Field Fh] [Algebra H Fh] [IsFractionRing H Fh] (κ : FractionRing O →+* Fh)
      (_ : ∀ a : O, κ (algebraMap O (FractionRing O) a) = algebraMap H Fh (g a))
      (_ : letI : Algebra (FractionRing O) Fh := κ.toAlgebra
        ∃ (n : ℕ) (φ : Fin n → (D →ₐ[FractionRing O] Fh)),
        Function.Bijective (fun z : TensorProduct (FractionRing O) Fh D => fun i =>
          Algebra.TensorProduct.lift (AlgHom.id Fh Fh) (φ i) (fun _ _ => Commute.all _ _) z)),
      Algebra.Etale O (integralClosure O D) := by
    intro O D _ _ _ _ _ _ _ _ _ _ H _ _ _ g hg hgϖ Fh _ _ _ κ hκ hspl
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
    have hfinC : Module.Finite O (integralClosure O D) :=
      wc_fnf_integralClosure_finite_of_etale_field O (FractionRing O) D
    have htf : Module.IsTorsionFree O (integralClosure O D) := by
      refine ⟨fun r hr x y hxy => ?_⟩
      have hr0 : r ≠ 0 := hr.ne_zero
      have hu : IsUnit (algebraMap O D r) := by
        rw [IsScalarTower.algebraMap_apply O (FractionRing O) D]
        exact (IsUnit.mk0 _ ((map_ne_zero_iff _
          (IsFractionRing.injective O (FractionRing O))).mpr hr0)).map _
      apply Subtype.ext
      have h1 : ((r • x : integralClosure O D) : D) = ((r • y : integralClosure O D) : D) :=
