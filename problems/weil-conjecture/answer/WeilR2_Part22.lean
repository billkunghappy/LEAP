      (PrimeSpectrum.mem_basicOpen _ _).mp ((Scheme.Hom.mem_preimage eU).mp hzO)
    obtain ⟨j, hj⟩ := hodd _ (PrimeSpectrum.isPrime (R := wcQuadModelRing A n π c) (eU (O.ι z)))
      hπq hgq
    intro hmem
