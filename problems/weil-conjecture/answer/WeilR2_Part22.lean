          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (W'.obj l))).hom s = 0 := by
    intro F H _ ψ res π p θ h1 h2 hSb hKη hθ hπK hp hcomp
    haveI := hinit
    have P1 : ∀ (c : B) (N N' : StructuredArrow (Over.mk (wcEtGeomPt B c)) (Scheme.Etale.forget B))
        (f : N' ⟶ N) (s : F.obj.obj (Opposite.op N.right)),
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B c))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op N)).hom s =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B c))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op N')).hom
            ((F.obj.map f.right.op).hom s) := by
      intro c N N' f s
