    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))}) :
    ∃ Λ : AddSubgroup ((wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      (∀ a : ℚ_[ℓ], ‖a‖ ≤ 1 → ∀ x ∈ Λ,
        ((wcRqScalar h ℓ (n - 1) a).hom.app (Opposite.op Ty)).hom x ∈ Λ) ∧
      (∀ x, ∃ j : ℕ,
        ((wcRqScalar h ℓ (n - 1) ((ℓ : ℚ_[ℓ]) ^ j)).hom.app (Opposite.op Ty)).hom x ∈ Λ) ∧
      (∀ x, (∀ N : ℕ, ∃ y ∈ Λ,
         x = ((wcRqScalar h ℓ (n - 1) ((ℓ : ℚ_[ℓ]) ^ N)).hom.app (Opposite.op Ty)).hom y) →
         x = 0) ∧
      ∀ N : ℕ, ∃ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vξ) (eE : Ty ⟶ E),
        Etale πE.left ∧ eE ≫ πE = uξ ∧
        ∀ m : Ty ⟶ Ty, m ≫ eE = eE → ∀ x ∈ Λ, ∃ y ∈ Λ,
          ((wcRq h ℓ (n - 1)).obj.map m.op).hom x - x =
            ((wcRqScalar h ℓ (n - 1) ((ℓ : ℚ_[ℓ]) ^ N)).hom.app (Opposite.op Ty)).hom y :=
by
