  have hdim : topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) ≤
      ((1 : ℕ) : WithBot ℕ∞) := hdimEq.trans_le h4

  have hKum := fun (Y₁ : Scheme.{u}) (fY : Y₁ ⟶ Spec (.of (IsLocalRing.ResidueField A))) =>
    wc_et_kummer_ses_gen (IsLocalRing.ResidueField A) Y₁ fY (ℓ ^ k) hMκ
  have hNorm := wc_et_normal_curve_h2_card_gen (IsLocalRing.ResidueField A) (ℓ ^ k) hMκ hKum (by
    intro Y₁ fY _ _ hn' hd U _ hU hfin ord hord
    exact wc_curve_divisor_degree_point_congr_gen (IsLocalRing.ResidueField A) Y₁ fY hn' hd U hU hfin
      (ℓ ^ k) hMκ ord hord)
  have hcard := wc_et_curve_h2_card_reduction_gen (IsLocalRing.ResidueField A) (ℓ ^ k) hM hMκ
    wc_et_henselian_proper_vanishing hNorm _
    (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A)) hdim
  exact ⟨_, hcard⟩

theorem wc_kinj_cohomology_class_derived_hom_equiv {C : Type*} [Category C] [Abelian C]
    [HasDerivedCategory C] (S L : CochainComplex C ℤ) (d : ℤ) (hL : L.IsStrictlyGE d)
    (hinj : ∀ n : ℤ, Injective (L.X n)) (q : ℤ) :
    Nonempty ((DerivedCategory.Q.obj S ⟶
        (shiftFunctor (DerivedCategory C) q).obj (DerivedCategory.Q.obj L)) ≃
      CochainComplex.HomComplex.CohomologyClass S L q) :=
by
  haveI := hL
  haveI : ∀ n : ℤ, Injective (L.X n) := hinj
  haveI hK : L.IsKInjective := CochainComplex.isKInjective_of_injective L d
  haveI : ((shiftFunctor (CochainComplex C ℤ) q).obj L).IsKInjective :=
    (CochainComplex.isKInjective_shift_iff L q).mpr hK
  let E := ((CochainComplex.HomComplex.CohomologyClass.homAddEquiv (K := S) (L := L)
      (n := q)).toEquiv.trans
    (Equiv.ofBijective _ (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient C _).obj S) ((shiftFunctor (CochainComplex C ℤ) q).obj L)))).trans
    (Iso.homCongr ((DerivedCategory.quotientCompQhIso C).app S)
      ((DerivedCategory.quotientCompQhIso C).app _ ≪≫ (DerivedCategory.Q.commShiftIso q).app L))
  exact ⟨E.symm⟩

theorem wc_cohomology_class_single_adj_equiv {𝒜 ℬ : Type*} [Category 𝒜] [Category ℬ]
    [Abelian 𝒜] [Abelian ℬ] (Φ : 𝒜 ⥤ ℬ) (P : ℬ ⥤ 𝒜) (adj : Φ ⊣ P) [Φ.Additive] [P.Additive]
    (X : 𝒜) (Y : ℬ) (μ : Φ.obj X ≅ Y) (L : CochainComplex ℬ ℤ) (q : ℤ) :
    Nonempty (CochainComplex.HomComplex.CohomologyClass ((CochainComplex.singleFunctor 𝒜 0).obj X)
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) q ≃
      CochainComplex.HomComplex.CohomologyClass ((CochainComplex.singleFunctor ℬ 0).obj Y) L q) :=
by
  classical

  let π : ∀ n : ℤ, (Φ.obj X ⟶ L.X n) ≃+ (Y ⟶ L.X n) := fun n =>
    { toFun := fun g => μ.inv ≫ g
      invFun := fun h => μ.hom ≫ h
      left_inv := fun g => by simp
      right_inv := fun h => by simp
      map_add' := fun a b => by simp }
  let τ : ∀ n : ℤ, (X ⟶ ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).X n) ≃+
      (Y ⟶ L.X n) := fun n => (adj.homAddEquiv X (L.X n)).symm.trans (π n)
  have hτ : ∀ n (f : X ⟶ ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).X n),
      τ n f = μ.inv ≫ (adj.homEquiv X (L.X n)).symm f := by
    intro n f
    simp only [τ, π, AddEquiv.trans_apply]
    rfl
  have hnat : ∀ (n m : ℤ) (f : X ⟶ ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).X n),
      τ m (f ≫ ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).d n m) = τ n f ≫ L.d n m := by
    intro n m f
    rw [hτ, hτ]
    change μ.inv ≫ (adj.homEquiv X (L.X m)).symm (f ≫ P.map (L.d n m)) = _
    rw [adj.homEquiv_naturality_right_symm, Category.assoc]
  let ψ : ∀ n : ℤ, CochainComplex.HomComplex.Cochain ((CochainComplex.singleFunctor 𝒜 0).obj X)
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) n ≃+
      CochainComplex.HomComplex.Cochain ((CochainComplex.singleFunctor ℬ 0).obj Y) L n :=
    fun n => (CochainComplex.HomComplex.Cochain.fromSingleEquiv (zero_add n)).trans
      ((τ n).trans (CochainComplex.HomComplex.Cochain.fromSingleEquiv (zero_add n)).symm)
  have hsymm : ∀ (n : ℤ) (g : Y ⟶ L.X n),
      (CochainComplex.HomComplex.Cochain.fromSingleEquiv (K := L) (X := Y) (zero_add n)).symm g =
        CochainComplex.HomComplex.Cochain.fromSingleMk g (zero_add n) := fun n g =>
    (AddEquiv.symm_apply_eq _).mpr
      (CochainComplex.HomComplex.Cochain.fromSingleEquiv_fromSingleMk g _).symm
  have hψmk : ∀ (n : ℤ) (f : X ⟶ ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).X n),
      ψ n (CochainComplex.HomComplex.Cochain.fromSingleMk f (zero_add n)) =
        CochainComplex.HomComplex.Cochain.fromSingleMk (τ n f) (zero_add n) := by
    intro n f
    simp only [ψ, AddEquiv.trans_apply,
      CochainComplex.HomComplex.Cochain.fromSingleEquiv_fromSingleMk, hsymm]
  have hψ : ∀ (n m : ℤ), n + 1 = m → ∀ z,
      CochainComplex.HomComplex.δ n m (ψ n z) = ψ m (CochainComplex.HomComplex.δ n m z) := by
    intro n m _ z
    obtain ⟨f, rfl⟩ := CochainComplex.HomComplex.Cochain.fromSingleMk_surjective z n (zero_add n)
    rw [hψmk, CochainComplex.HomComplex.Cochain.δ_fromSingleMk _ _ m m (zero_add m),
      CochainComplex.HomComplex.Cochain.δ_fromSingleMk _ _ m m (zero_add m), hψmk, hnat]

  have hcoc : ∀ z, z ∈ CochainComplex.HomComplex.cocycle ((CochainComplex.singleFunctor 𝒜 0).obj X)
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) q ↔
      ψ q z ∈ CochainComplex.HomComplex.cocycle ((CochainComplex.singleFunctor ℬ 0).obj Y) L q := by
    intro z
    rw [CochainComplex.HomComplex.Cocycle.mem_iff q (q + 1) rfl,
      CochainComplex.HomComplex.Cocycle.mem_iff q (q + 1) rfl, hψ q (q + 1) rfl,
      AddEquiv.map_eq_zero_iff]
  let e' : CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor 𝒜 0).obj X)
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) q ≃+
      CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor ℬ 0).obj Y) L q :=
    { toFun := fun z => ⟨ψ q z.1, (hcoc z.1).1 z.2⟩
      invFun := fun w => ⟨(ψ q).symm w.1, (hcoc _).2 (by rw [AddEquiv.apply_symm_apply]; exact w.2)⟩
      left_inv := fun z => Subtype.ext (by simp)
      right_inv := fun w => Subtype.ext (by simp)
      map_add' := fun a b => Subtype.ext (map_add (ψ q) a.1 b.1) }
  have he' : ∀ z, ((e' z : CochainComplex.HomComplex.Cocycle _ _ q) :
      CochainComplex.HomComplex.Cochain _ _ q) = ψ q (z : CochainComplex.HomComplex.Cochain _ _ q) :=
    fun z => rfl
  have he's : ∀ w, ((e'.symm w : CochainComplex.HomComplex.Cocycle _ _ q) :
      CochainComplex.HomComplex.Cochain _ _ q) =
        (ψ q).symm (w : CochainComplex.HomComplex.Cochain _ _ q) :=
    fun w => rfl
  have hmap : AddSubgroup.map (e' : _ →+ _)
      (CochainComplex.HomComplex.coboundaries ((CochainComplex.singleFunctor 𝒜 0).obj X)
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) q) =
      CochainComplex.HomComplex.coboundaries ((CochainComplex.singleFunctor ℬ 0).obj Y) L q := by
    ext α'
    rw [AddSubgroup.mem_map]
    constructor
    · rintro ⟨α, hα, rfl⟩
      rw [CochainComplex.HomComplex.mem_coboundaries_iff _ (q - 1) (by omega)] at hα ⊢
      obtain ⟨β, hβ⟩ := hα
      refine ⟨ψ (q - 1) β, ?_⟩
      rw [hψ _ _ (by omega), hβ]
      exact (he' α).symm
    · intro hα'
      rw [CochainComplex.HomComplex.mem_coboundaries_iff _ (q - 1) (by omega)] at hα'
      obtain ⟨β', hβ'⟩ := hα'
      refine ⟨e'.symm α', ?_, by simp⟩
      rw [CochainComplex.HomComplex.mem_coboundaries_iff _ (q - 1) (by omega)]
      refine ⟨(ψ (q - 1)).symm β', ?_⟩
      apply (ψ q).injective
      rw [← hψ _ _ (by omega), AddEquiv.apply_symm_apply, hβ', he's, AddEquiv.apply_symm_apply]
  exact ⟨(QuotientAddGroup.congr _ _ e' hmap).toEquiv⟩

theorem wc_derived_hom_base_change_of_kernel_acyclic {C D : Type*} [Category C] [Category D]
    [Abelian C] [Abelian D] [HasDerivedCategory C] [HasDerivedCategory D]
    (F : C ⥤ D) (R : D ⥤ C) (adj : F ⊣ R) [F.Additive] [R.Additive]
    [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
    [Limits.PreservesFiniteLimits R] [Limits.PreservesFiniteColimits R] [R.Full] [R.Faithful]
    (X : C)
    (hX : ∀ N : C, Limits.IsZero (F.obj N) → ∀ p : ℕ,
      Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) (p : ℤ)).obj ((DerivedCategory.singleFunctor C 0).obj N)))
    (K : CochainComplex C ℤ) (d : ℤ) (hK : K.IsStrictlyGE d) (q : ℤ) :
    Nonempty (((DerivedCategory.singleFunctor D 0).obj (F.obj X) ⟶
        (shiftFunctor (DerivedCategory D) q).obj
          (DerivedCategory.Q.obj ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K))) ≃
      ((DerivedCategory.singleFunctor C 0).obj X ⟶
        (shiftFunctor (DerivedCategory C) q).obj (DerivedCategory.Q.obj K))) :=
by
  classical
  let Fc := F.mapHomologicalComplex (ComplexShape.up ℤ)
  let Rc := R.mapHomologicalComplex (ComplexShape.up ℤ)
  let L : CochainComplex C ℤ := Rc.obj (Fc.obj K)

  let η : K ⟶ L :=
    { f := fun n => adj.unit.app (K.X n)
      comm' := fun i j _ => (adj.unit.naturality (K.d i j)).symm }

  have hFη : ∀ n, IsIso (F.map (η.f n)) := by
    intro n
    have h := adj.left_triangle_components (K.X n)
    have : IsIso (F.map (adj.unit.app (K.X n)) ≫ adj.counit.app (F.obj (K.X n))) := by
      rw [h]; exact IsIso.id _
    exact IsIso.of_isIso_comp_right (F.map (adj.unit.app (K.X n))) (adj.counit.app (F.obj (K.X n)))

  let φ' := Fc.map η
  haveI : IsIso φ' := by
    haveI : ∀ n, IsIso (φ'.f n) := fun n => hFη n
    exact HomologicalComplex.Hom.isIso_of_components φ'
  have hcone' : Limits.IsZero (DerivedCategory.Q.obj (CochainComplex.mappingCone φ')) := by
    have hT' := DerivedCategory.mappingCone_triangle_distinguished φ'
    have hiso : IsIso (DerivedCategory.Q.map φ') := inferInstance
    exact (Pretriangulated.Triangle.isZero₃_iff_isIso₁ _ hT').mpr hiso
  have hkill : ∀ j, Limits.IsZero (F.obj ((CochainComplex.mappingCone η).homology j)) := by
    intro j
    have e1 : Limits.IsZero ((CochainComplex.mappingCone φ').homology j) :=
      Limits.IsZero.of_iso ((DerivedCategory.homologyFunctor D j).map_isZero hcone')
        ((DerivedCategory.homologyFunctorFactors D j).app (CochainComplex.mappingCone φ')).symm
    have e2 : Limits.IsZero ((Fc.obj (CochainComplex.mappingCone η)).homology j) :=
      Limits.IsZero.of_iso e1
        (HomologicalComplex.homologyMapIso (CochainComplex.mappingCone.mapHomologicalComplexIso η F) j)
    exact Limits.IsZero.of_iso e2
      (ShortComplex.mapHomologyIso ((CochainComplex.mappingCone η).sc j) F).symm

  have hL : L.IsStrictlyGE d := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    exact R.map_isZero (F.map_isZero (CochainComplex.isZero_of_isStrictlyGE K d i hi))
  haveI hC : (CochainComplex.mappingCone η).IsStrictlyGE (d - 1) := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    exact (CochainComplex.mappingCone.isZero_X_iff η i).mpr
      ⟨CochainComplex.isZero_of_isStrictlyGE K d (i + 1) (by omega),
        CochainComplex.isZero_of_isStrictlyGE L d i (by omega)⟩
  have hQC : (DerivedCategory.Q.obj (CochainComplex.mappingCone η)).IsGE (d - 1) := by
    rw [DerivedCategory.isGE_Q_obj_iff]
    infer_instance
  have hvan : ∀ q' : ℤ, Subsingleton ((DerivedCategory.singleFunctor C 0).obj X ⟶
      (shiftFunctor (DerivedCategory C) q').obj
        (DerivedCategory.Q.obj (CochainComplex.mappingCone η))) := by
    apply wc_derived_single_hom_vanish_of_isGE X _ (d - 1) hQC
    intro j p
    apply hX
    exact Limits.IsZero.of_iso (hkill j)
      (F.mapIso ((DerivedCategory.homologyFunctorFactors C j).app (CochainComplex.mappingCone η)))

  have hT := DerivedCategory.mappingCone_triangle_distinguished η
  have hbij := wc_pretri_postcomp_bij_of_cone_hom_vanish _ hT
    ((DerivedCategory.singleFunctor C 0).obj X) hvan q
  let B := Equiv.ofBijective _ hbij

  obtain ⟨E⟩ := wc_derived_hom_exact_adjoint_transfer F R adj X (Fc.obj K) q
  exact ⟨E.trans B.symm⟩

theorem wc_et_closed_fibre_kernel_ext_vanish : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f]
    (m : ℕ), 0 < m → ∀ (Dg : wcEtPullData (Limits.pullback.fst f (wcQmSp A)) m)
    (N : SheafOfModules.{u+1} (wcEtZModRing Y m)), Limits.IsZero (Dg.Φ.obj N) →
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Y m))
    ∀ p : ℕ, Subsingleton ((DerivedCategory.singleFunctor _ 0).obj
        (SheafOfModules.unit (wcEtZModRing Y m)) ⟶
      (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Y m))) (p : ℤ)).obj
        ((DerivedCategory.singleFunctor _ 0).obj N)) :=
by
  intro A _ _ _ Y f _ m hm Dg N hZ
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Y m))
  intro p
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion (Limits.pullback.fst f (wcQmSp A)) := inferInstance
  have hstalk : ∀ y : Y, f y = IsLocalRing.closedPoint A →
      Subsingleton ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N)) := by
    intro y hy
    let x₀ : Spec (.of (IsLocalRing.ResidueField A)) :=
      IsLocalRing.closedPoint (IsLocalRing.ResidueField A)
    have hx₀ : (wcQmSp A) x₀ = IsLocalRing.closedPoint A :=
      IsLocalRing.PrimeSpectrum.comap_residue A x₀
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback y x₀ (hy.trans hx₀.symm)
    have h0 : Dg.Φ.map (𝟙 N) = 0 := hZ.eq_of_src _ _
    have h := wc_et_pull_data_map_zero_stalk_zero (Limits.pullback.fst f (wcQmSp A)) m Dg N N
      (𝟙 N) h0 z
    rw [hz, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id] at h
    exact AddCommGrpCat.isZero_iff_subsingleton.mp ((Limits.IsZero.iff_id_eq_zero _).mpr h)
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  haveI hE := wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f m hm N hstalk p
  exact (Abelian.Ext.homEquiv (X := SheafOfModules.unit (wcEtZModRing Y m)) (Y := N)
    (n := p)).symm.subsingleton

theorem wc_et_tpl_ncs_psi_hom_pbc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (q : ℕ) :
    haveI := Dh.additive
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    Nonempty ((DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))) ⟶
        (DerivedCategory.Q.obj Ψ)⟦(q : ℤ)⟧) ≃
      wcEtZModExt (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q) :=
by
  intro P K Ψ

  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hpp : IsProper (Limits.pullback.snd D.f a) := inferInstance

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) :=
    inferInstance
  haveI : IsFinite (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) := inferInstance

  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := Dh.additive
  haveI := Dh.presLim
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  let R := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) _ _ Dg.cont Dg.φ
  haveI : R.Additive := Adjunction.right_adjoint_additive Dg.adj
  haveI : Limits.PreservesFiniteLimits R := by
    haveI := Dg.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI : Limits.PreservesFiniteColimits R :=
    wc_et_finite_push_modules_exact (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))
      (ℓ ^ k) Dg
  obtain ⟨hRFull, hRFaith⟩ := wc_et_closed_push_modules_full_faithful
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k) Dg
  haveI : R.Full := hRFull
  haveI : R.Faithful := hRFaith

  haveI : Dh.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape Dh.Φ
  have hKinj : ∀ n : ℤ, Injective (K.X n) := fun n =>
    Injective.injective_of_adjoint Dh.adj (I.cochainComplex.X n)

  have hKge : CochainComplex.IsStrictlyGE K 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    exact P.map_isZero (CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 i hi)

  letI : HasDerivedCategory (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) :=
    HasDerivedCategory.standard _
  letI : HasDerivedCategory (SheafOfModules.{u+1}
      (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) :=
    HasDerivedCategory.standard _
  letI : HasExt (SheafOfModules.{u+1}
      (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))) :=
    HasExt.standard _
  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hX := wc_et_closed_fibre_kernel_ext_vanish A (Limits.pullback D.f a)
    (Limits.pullback.snd D.f a) (ℓ ^ k) hm Dg
  let E1 := Iso.homCongr
