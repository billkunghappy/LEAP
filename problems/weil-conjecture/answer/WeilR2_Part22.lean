    refine e.trans ?_
    refine hb2.symm.trans ?_
    exact (congrArg (fun t => ((wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.map h.op).hom t)
      hb).symm
  · intro X Y k a b hab V h h' hc
    have hx := hnatS M.arrow k.unop.left a
    have hy := hnatS Cι k.unop.left b
    have e := hab V (h ≫ k.unop.left) h' (by rw [hc, Category.assoc, Over.w k.unop])
    exact (congrArg (fun t => Θ V h' ((G.obj.map h.op).hom t)) hx).trans
      ((congrArg (Θ V h') (hF G h k.unop.left _)).trans
        (e.trans ((hF _ h k.unop.left _).symm.trans
          (congrArg (fun t => ((wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.map h.op).hom t)
            hy).symm)))

theorem wc_proet_connected_nbhd (S : Scheme.{u}) (V : S.ProEt) (z : V.left) :
    ∃ (V₁ : S.ProEt) (k : V₁ ⟶ V) (z₁ : V₁.left), ConnectedSpace V₁.left ∧ k.left z₁ = z :=
by
  classical
  have hι : WeaklyEtale (V.left.fromSpecStalk z) := by
    refine ⟨?_, inferInstance⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
      V.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
    show Flat (Spec.map (V.left.presheaf.germ U z hx) ≫ hU.fromSpec)
    have : Flat (Spec.map (V.left.presheaf.germ U z hx)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI : Algebra Γ(V.left, U) (V.left.presheaf.stalk z) :=
        (V.left.presheaf.germ U z hx).hom.toAlgebra
      haveI := hU.isLocalization_stalk ⟨z, hx⟩
      exact RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
    have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
    exact MorphismProperty.comp_mem @Flat _ _ this hfs
  have hcomp : WeaklyEtale (V.left.fromSpecStalk z ≫ V.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V.prop
  let V₁ : S.ProEt := MorphismProperty.Over.mk ⊤ (V.left.fromSpecStalk z ≫ V.hom) hcomp
  let k : V₁ ⟶ V := MorphismProperty.Over.homMk (V.left.fromSpecStalk z) rfl trivial
  have hconn : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
    intro R _
    have hpre : PreconnectedSpace (PrimeSpectrum R) := by
      rw [preconnectedSpace_iff_clopen]
      intro s hs
      obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
      · right
        have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
        subst he1
        simp
      · left
        have he0 : e = 0 := by
          have h0 : (1 - e) * e = (1 - e) * 0 := by
            rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
          exact h.mul_left_cancel h0
        subst he0
        simp
    have hc : ConnectedSpace (PrimeSpectrum R) :=
      { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R⟩ }
    exact hc
  exact ⟨V₁, k, IsLocalRing.closedPoint _, hconn (V.left.presheaf.stalk z),
    Scheme.fromSpecStalk_closedPoint⟩

theorem wc_geomPoint_hom_twist (K : Type u) [Field K] [Finite K] (X : Over (Spec (.of K)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (V : X.left.ProEt) (hV : ConnectedSpace V.left)
    (a b : V ⟶ wcGeomPoint K X h) :
    ∃ e : wcGeomPoint K X h ≅ wcGeomPoint K X h, b = a ≫ e.hom :=
by
  classical

  have t1 : ∀ {R : Type u} [CommRing R] [Nontrivial R],
      (∀ e : R, e * e = e → e = 0 ∨ e = 1) → ∀ (s : Finset (AlgebraicClosure K))
      (c : AlgebraicClosure K → R),
      (∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsUnit (c i - c j)) → ∀ (b : R),
      ∏ i ∈ s, (b - c i) = 0 → ∃ i ∈ s, b = c i := by
    intro R _ _ hR s c hc b hb
    induction s using Finset.induction_on with
    | empty => simp at hb
    | insert a s' ha ih =>
      rw [Finset.prod_insert ha] at hb
      have hcop : IsCoprime (b - c a) (∏ i ∈ s', (b - c i)) := by
        apply IsCoprime.prod_right
        intro i hi
        have hia : i ≠ a := fun h => ha (h ▸ hi)
        obtain ⟨t, ht⟩ := (hc a (Finset.mem_insert_self a s') i (Finset.mem_insert_of_mem hi)
          (Ne.symm hia)).exists_left_inv
        exact ⟨-t, t, by linear_combination ht⟩
      obtain ⟨u, v, huv⟩ := hcop
      have he : (u * (b - c a)) * (u * (b - c a)) = u * (b - c a) := by
        linear_combination (u * (b - c a)) * huv - u * v * hb
      rcases hR _ he with h0 | h1
      · refine ⟨a, Finset.mem_insert_self a s', ?_⟩
        linear_combination (b - c a) * h0 + v * hb - (b - c a) * huv
      · have hP : ∏ i ∈ s', (b - c i) = 0 := by
          linear_combination u * hb - (∏ i ∈ s', (b - c i)) * h1
        obtain ⟨i, hi, hbi⟩ := ih (fun i hi j hj hij => hc i (Finset.mem_insert_of_mem hi) j
          (Finset.mem_insert_of_mem hj) hij) hP
        exact ⟨i, Finset.mem_insert_of_mem hi, hbi⟩

  have t4 : ∀ (Y : Scheme.{u}) [ConnectedSpace Y],
      Nontrivial Γ(Y, ⊤) ∧ ∀ e : Γ(Y, ⊤), e * e = e → e = 0 ∨ e = 1 := by
    intro Y _
    obtain ⟨x0⟩ := (ConnectedSpace.toNonempty : Nonempty Y)
    refine ⟨@Scheme.component_nontrivial Y ⊤ ⟨⟨x0, trivial⟩⟩, ?_⟩
    have H : ∀ f g : Γ(Y, ⊤), Y.basicOpen f = ⊤ → f * g = 0 → g = 0 := by
      intro f g hf hfg
      apply TopCat.Presheaf.section_ext Y.sheaf ⊤ g 0
      intro x hx
      have hu : IsUnit ((Y.presheaf.germ ⊤ x trivial).hom f) := by
        rw [← Scheme.mem_basicOpen_top, hf]; trivial
      have h2 : (Y.presheaf.germ ⊤ x trivial).hom (f * g) = 0 := by rw [hfg, map_zero]
      rw [map_mul] at h2
      rw [map_zero]
      exact (hu.mul_right_eq_zero).mp h2
    intro e he
    have hD : Y.basicOpen e ⊓ Y.basicOpen (1 - e) = ⊥ := by
      rw [← Scheme.basicOpen_mul]
      have : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he, sub_self]
      rw [this, Scheme.basicOpen_zero]
    have hT : Y.basicOpen e ⊔ Y.basicOpen (1 - e) = ⊤ := by
      apply top_le_iff.mp
      have := Scheme.basicOpen_add_le Y e (1 - e)
      rwa [add_sub_cancel, Scheme.basicOpen_one] at this
    have hcomp : (Y.basicOpen (1 - e) : Set Y) = (Y.basicOpen e : Set Y)ᶜ := by
      ext x
      constructor
      · intro hx hx'
        have h3 : x ∈ Y.basicOpen e ⊓ Y.basicOpen (1 - e) :=
          TopologicalSpace.Opens.mem_inf.mpr ⟨hx', hx⟩
        rw [hD] at h3
        simp at h3
      · intro hx
        have h3 : x ∈ Y.basicOpen e ⊔ Y.basicOpen (1 - e) := by rw [hT]; trivial
        rcases TopologicalSpace.Opens.mem_sup.mp h3 with h4 | h4
        · exact absurd h4 hx
        · exact h4
    have hclopen : IsClopen (Y.basicOpen e : Set Y) :=
      ⟨isOpen_compl_iff.mp (hcomp ▸ (Y.basicOpen (1 - e)).isOpen), (Y.basicOpen e).isOpen⟩
    rcases isClopen_iff.mp hclopen with h5 | h5
    · left
      have h6 : Y.basicOpen (1 - e) = ⊤ := by
        apply SetLike.coe_injective
        rw [hcomp, h5, Set.compl_empty, TopologicalSpace.Opens.coe_top]
      exact H (1 - e) e h6 (by rw [sub_mul, one_mul, he, sub_self])
    · right
      have h6 : Y.basicOpen e = ⊤ := by
        apply SetLike.coe_injective
        rw [h5, TopologicalSpace.Opens.coe_top]
      have := H e (1 - e) h6 (by rw [mul_sub, mul_one, he, sub_self])
      exact (sub_eq_zero.mp this).symm

  have t7 : ∀ (R : Type u) [CommRing R] [Nontrivial R],
      (∀ e : R, e * e = e → e = 0 ∨ e = 1) →
      ∀ (α β : AlgebraicClosure K →+* R),
      α.comp (algebraMap K (AlgebraicClosure K)) = β.comp (algebraMap K (AlgebraicClosure K)) →
      ∃ σ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
        β = α.comp (σ : AlgebraicClosure K →+* AlgebraicClosure K) := by
    intro R _ _ hR α β hαβ
    have hrange : ∀ y : AlgebraicClosure K, ∃ z, β y = α z := by
      intro y
      have hint : IsIntegral K y := Algebra.IsIntegral.isIntegral y
      have hsep : ((minpoly K y).map (algebraMap K (AlgebraicClosure K))).Separable :=
        (PerfectField.separable_of_irreducible (minpoly.irreducible hint)).map
      have hmon : ((minpoly K y).map (algebraMap K (AlgebraicClosure K))).Monic :=
        (minpoly.monic hint).map _
      have hprod : ∏ r ∈ ((minpoly K y).map (algebraMap K (AlgebraicClosure K))).roots.toFinset,
          (Polynomial.X - Polynomial.C r) =
            (minpoly K y).map (algebraMap K (AlgebraicClosure K)) := by
        rw [Finset.prod_eq_multiset_prod, Multiset.toFinset_val,
          (Polynomial.nodup_roots hsep).dedup]
        exact Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmon
          IsAlgClosed.card_roots_eq_natDegree
      have hzero : ∏ r ∈ ((minpoly K y).map (algebraMap K (AlgebraicClosure K))).roots.toFinset,
          (β y - α r) = 0 := by
        have e1 := congrArg (Polynomial.eval₂ α (β y)) hprod
        rw [Polynomial.eval₂_finsetProd] at e1
        simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at e1
        rw [e1, Polynomial.eval₂_map, hαβ, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def,
          minpoly.aeval, map_zero]
      obtain ⟨r, -, hr⟩ := t1 hR _ α (fun i _ j _ hij => by
        rw [← map_sub]; exact (sub_ne_zero.mpr hij).isUnit.map α) (β y) hzero
      exact ⟨r, hr⟩
    choose τ hτ using hrange
    have hinj : Function.Injective α := α.injective
    let τA : AlgebraicClosure K →ₐ[K] AlgebraicClosure K :=
      { toFun := τ
        map_one' := hinj (by rw [← hτ, map_one, map_one])
        map_mul' := fun x y => hinj (by simp only [map_mul, ← hτ])
        map_zero' := hinj (by rw [← hτ, map_zero, map_zero])
        map_add' := fun x y => hinj (by simp only [map_add, ← hτ])
        commutes' := fun k => hinj (by rw [← hτ]; exact (congrArg (fun φ => φ k) hαβ).symm) }
    refine ⟨AlgEquiv.ofBijective τA (Algebra.IsAlgebraic.algHom_bijective τA), ?_⟩
    ext y
    exact hτ y

  have sh1 : ∀ {Y : Scheme.{u}} {R S : CommRingCat.{u}} (f : Y ⟶ Spec R) (φ : S ⟶ R),
      (Scheme.ΓSpecIso S).inv ≫ (f ≫ Spec.map φ).appTop =
        φ ≫ (Scheme.ΓSpecIso R).inv ≫ f.appTop := by
    intro Y R S f φ
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have sh2 : ∀ {Y : Scheme.{u}} {R : CommRingCat.{u}} (f g : Y ⟶ Spec R),
      (Scheme.ΓSpecIso R).inv ≫ f.appTop = (Scheme.ΓSpecIso R).inv ≫ g.appTop → f = g := by
    intro Y R f g hfg
    exact ext_of_isAffine ((cancel_epi _).1 hfg)

  set π := Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) with hπ
  let a' : V.left ⟶ Limits.pullback X.hom π := a.left
  let b' : V.left ⟶ Limits.pullback X.hom π := b.left
  have ha : a' ≫ Limits.pullback.fst X.hom π = V.hom := MorphismProperty.Over.w a
  have hb : b' ≫ Limits.pullback.fst X.hom π = V.hom := MorphismProperty.Over.w b
  set α₀ := a' ≫ Limits.pullback.snd X.hom π with hα₀
  set β₀ := b' ≫ Limits.pullback.snd X.hom π with hβ₀
  have hαβ₀ : α₀ ≫ π = β₀ ≫ π := by
    rw [hα₀, hβ₀, Category.assoc, Category.assoc, ← Limits.pullback.condition,
      ← Category.assoc, ← Category.assoc, ha, hb]
  set αs := (Scheme.ΓSpecIso (.of (AlgebraicClosure K))).inv ≫ α₀.appTop with hαs
  set βs := (Scheme.ΓSpecIso (.of (AlgebraicClosure K))).inv ≫ β₀.appTop with hβs
  have hK : αs.hom.comp (algebraMap K (AlgebraicClosure K)) =
      βs.hom.comp (algebraMap K (AlgebraicClosure K)) := by
    have e1 := sh1 α₀ (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    have e2 := sh1 β₀ (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    rw [← hπ, hαβ₀, e2] at e1
    have e3 := congrArg CommRingCat.Hom.hom e1
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at e3
    exact e3.symm
  obtain ⟨hnt, hidem⟩ := @t4 V.left hV
  obtain ⟨σ, hσ⟩ := t7 Γ(V.left, ⊤) hidem αs.hom βs.hom hK

  have cond : ∀ τ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
      π ≫ 𝟙 _ = Spec.map (CommRingCat.ofHom (τ : AlgebraicClosure K →+* AlgebraicClosure K)) ≫ π := by
    intro τ
    rw [Category.comp_id, hπ, ← Spec.map_comp]
    congr 1
    ext x
    exact (τ.commutes x).symm
  let γ : (AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) →
      (Limits.pullback X.hom π ⟶ Limits.pullback X.hom π) := fun τ =>
    Limits.pullback.map X.hom π X.hom π (𝟙 X.left)
      (Spec.map (CommRingCat.ofHom (τ : AlgebraicClosure K →+* AlgebraicClosure K))) (𝟙 _)
      (by simp) (cond τ)
  have hγ1 : ∀ τ, γ τ ≫ Limits.pullback.fst X.hom π = Limits.pullback.fst X.hom π := by
    intro τ
    exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hγ2 : ∀ τ, γ τ ≫ Limits.pullback.snd X.hom π = Limits.pullback.snd X.hom π ≫
      Spec.map (CommRingCat.ofHom (τ : AlgebraicClosure K →+* AlgebraicClosure K)) := by
    intro τ
    exact Limits.pullback.lift_snd _ _ _
  have hinv : ∀ τ₁ τ₂ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
      (∀ x, τ₁ (τ₂ x) = x) → γ τ₁ ≫ γ τ₂ = 𝟙 _ := by
    intro τ₁ τ₂ h12
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hγ1, hγ1, Category.id_comp]
    · rw [Category.assoc, hγ2, ← Category.assoc, hγ2, Category.assoc, ← Spec.map_comp,
        Category.id_comp]
      have : CommRingCat.ofHom (τ₂ : AlgebraicClosure K →+* AlgebraicClosure K) ≫
          CommRingCat.ofHom (τ₁ : AlgebraicClosure K →+* AlgebraicClosure K) = 𝟙 _ := by
        ext x
        exact h12 x
      rw [this, Spec.map_id, Category.comp_id]
  let ι : (wcGeomPoint K X h).left ≅ (wcGeomPoint K X h).left :=
    { hom := γ σ
      inv := γ σ.symm
      hom_inv_id := hinv σ σ.symm (fun x => σ.apply_symm_apply x)
      inv_hom_id := hinv σ.symm σ (fun x => σ.symm_apply_apply x) }
  refine ⟨MorphismProperty.Over.isoMk ι (hγ1 σ), ?_⟩
  apply MorphismProperty.Over.Hom.ext
  show b' = a' ≫ γ σ
  apply Limits.pullback.hom_ext
  · rw [Category.assoc, hγ1, ha, hb]
  · rw [Category.assoc, hγ2, ← Category.assoc]
    show β₀ = α₀ ≫ _
    apply sh2
    rw [sh1]
    show βs = CommRingCat.ofHom (σ : AlgebraicClosure K →+* AlgebraicClosure K) ≫ αs
    apply CommRingCat.hom_ext
    rw [hσ]
    rfl

theorem wc_proet_deck_value_unique (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B W : S.ProEt) (w : W ⟶ B)
    (hgal : ∀ (V : S.ProEt) (a b : V ⟶ W), ConnectedSpace V.left → a ≫ w = b ≫ w →
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (μ : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ])
    (hinv : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ (V : S.ProEt) (a b : V ⟶ W), b = a ≫ γ →
      ∀ (x : G.obj.obj (Opposite.op V)) (z : V.left),
        μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) =
        μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z))
    (T : S.ProEt) (t : T ⟶ B) (s : G.obj.obj (Opposite.op T))
    (V₁ V₂ : S.ProEt) (h₁ : V₁ ⟶ T) (h₁' : V₁ ⟶ W) (h₂ : V₂ ⟶ T) (h₂' : V₂ ⟶ W)
    (e₁ : h₁' ≫ w = h₁ ≫ t) (e₂ : h₂' ≫ w = h₂ ≫ t) (v₁ : V₁.left) (v₂ : V₂.left)
    (hv : h₁.left v₁ = h₂.left v₂) :
    μ ((show C(↥V₁.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk h₁'))).hom ((G.obj.map h₁.op).hom s)).down) v₁) =
    μ ((show C(↥V₂.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk h₂'))).hom ((G.obj.map h₂.op).hom s)).down) v₂) :=
by
  classical
  haveI hV1 : WeaklyEtale V₁.hom := V₁.prop
  haveI hV2 : WeaklyEtale V₂.hom := V₂.prop
  haveI hTp : WeaklyEtale T.hom := T.prop
  haveI h2T : WeaklyEtale (h₂.left ≫ T.hom) := by
    rw [MorphismProperty.Over.w h₂]; exact hV2
  haveI : WeaklyEtale h₂.left := WeaklyEtale.of_comp h₂.left T.hom
  haveI : WeaklyEtale (Limits.pullback.fst h₁.left h₂.left) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst h₁.left h₂.left ≫ V₁.hom) := inferInstance
  let Q : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst h₁.left h₂.left ≫ V₁.hom)
  let p₁ : Q ⟶ V₁ :=
    MorphismProperty.Over.homMk (Limits.pullback.fst h₁.left h₂.left) rfl trivial
  have hb : Limits.pullback.snd h₁.left h₂.left ≫ V₂.hom =
      Limits.pullback.fst h₁.left h₂.left ≫ V₁.hom := by
    rw [← MorphismProperty.Over.w h₂, ← MorphismProperty.Over.w h₁, ← Category.assoc,
      ← Category.assoc, Limits.pullback.condition]
  let p₂ : Q ⟶ V₂ :=
    MorphismProperty.Over.homMk (Limits.pullback.snd h₁.left h₂.left) hb trivial
  have hsq : p₁ ≫ h₁ = p₂ ≫ h₂ := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition
  obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback v₁ v₂ hv
  have hnbhd : ∀ (V₀ : S.ProEt) (z : V₀.left),
      ∃ (V₁ : S.ProEt) (k : V₁ ⟶ V₀) (z₁ : V₁.left), ConnectedSpace V₁.left ∧ k.left z₁ = z := by
    intro V₀ z
    have hι : WeaklyEtale (V₀.left.fromSpecStalk z) := by
      refine ⟨?_, inferInstance⟩
      obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
        V₀.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
      replace hU : IsAffineOpen U := hU
      rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
      show Flat (Spec.map (V₀.left.presheaf.germ U z hx) ≫ hU.fromSpec)
      have : Flat (Spec.map (V₀.left.presheaf.germ U z hx)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat)]
        letI : Algebra Γ(V₀.left, U) (V₀.left.presheaf.stalk z) :=
          (V₀.left.presheaf.germ U z hx).hom.toAlgebra
        haveI := hU.isLocalization_stalk ⟨z, hx⟩
        exact RingHom.flat_algebraMap_iff.mpr
          (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
      have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
      have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
      exact MorphismProperty.comp_mem @Flat _ _ this hfs
    have hcomp : WeaklyEtale (V₀.left.fromSpecStalk z ≫ V₀.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V₀.prop
    let V₁ : S.ProEt := MorphismProperty.Over.mk ⊤ (V₀.left.fromSpecStalk z ≫ V₀.hom) hcomp
    let k : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (V₀.left.fromSpecStalk z) rfl trivial
    have hconnR : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
      intro R _
      have hpre : PreconnectedSpace (PrimeSpectrum R) := by
        rw [preconnectedSpace_iff_clopen]
        intro s hs
        obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
        · right
          have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
          subst he1
          simp
        · left
          have he0 : e = 0 := by
            have h0 : (1 - e) * e = (1 - e) * 0 := by
              rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
            exact h.mul_left_cancel h0
          subst he0
          simp
      have hc : ConnectedSpace (PrimeSpectrum R) :=
        { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R⟩ }
      exact hc
    exact ⟨V₁, k, IsLocalRing.closedPoint _, hconnR (V₀.left.presheaf.stalk z),
      Scheme.fromSpecStalk_closedPoint⟩
  obtain ⟨V, κ, c, hconn, hc⟩ := hnbhd Q q
  have hj₁c : (κ ≫ p₁).left c = v₁ := by
    change (Limits.pullback.fst h₁.left h₂.left) (κ.left c) = v₁
    rw [hc, hq1]
  have hj₂c : (κ ≫ p₂).left c = v₂ := by
    change (Limits.pullback.snd h₁.left h₂.left) (κ.left c) = v₂
    rw [hc, hq2]
  have hjj : (κ ≫ p₁) ≫ h₁ = (κ ≫ p₂) ≫ h₂ := by
    rw [Category.assoc, Category.assoc, hsq]
  have hab : ((κ ≫ p₁) ≫ h₁') ≫ w = ((κ ≫ p₂) ≫ h₂') ≫ w := by
    have ha : ((κ ≫ p₁) ≫ h₁') ≫ w = ((κ ≫ p₁) ≫ h₁) ≫ t := by
      rw [Category.assoc, e₁, ← Category.assoc]
    have hb' : ((κ ≫ p₂) ≫ h₂') ≫ w = ((κ ≫ p₂) ≫ h₂) ≫ t := by
      rw [Category.assoc, e₂, ← Category.assoc]
    rw [ha, hb', hjj]
  obtain ⟨γ, hγ, hbγ⟩ := hgal V ((κ ≫ p₁) ≫ h₁') ((κ ≫ p₂) ≫ h₂') hconn hab
  have TR : ∀ (V' : S.ProEt) (h' : V' ⟶ W) (j : V ⟶ V') (y : G.obj.obj (Opposite.op V'))
      (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom ((G.obj.map j.op).hom y)).down) z =
      (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (j.left z) := by
    intro V' h' j y z
    have hn := θ.hom.hom.naturality
      (Over.homMk j (by rfl) : (Over.mk (j ≫ h') : Over W) ⟶ Over.mk h').op
    have h1 := congrArg (fun m => m.hom y) hn
    have h2 : (θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom ((G.obj.map j.op).hom y) =
        ((wcContSheaf S (Fin k → ℚ_[ℓ])).obj.map j.op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := h1
    rw [h2]
    rfl
  have L := TR V₁ h₁' (κ ≫ p₁) ((G.obj.map h₁.op).hom s) c
  have R := TR V₂ h₂' (κ ≫ p₂) ((G.obj.map h₂.op).hom s) c
  rw [hj₁c] at L
  rw [hj₂c] at R
  have hx : (G.obj.map (κ ≫ p₁).op).hom ((G.obj.map h₁.op).hom s) =
      (G.obj.map (κ ≫ p₂).op).hom ((G.obj.map h₂.op).hom s) := by
    have h3 := congrArg (fun f => (G.obj.map f.op).hom s) hjj
    simpa only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      using h3
  have H := hinv γ hγ V ((κ ≫ p₁) ≫ h₁') ((κ ≫ p₂) ≫ h₂') hbγ
    ((G.obj.map (κ ≫ p₁).op).hom ((G.obj.map h₁.op).hom s)) c
  refine (congrArg μ L).symm.trans ?_
  refine Eq.trans ?_ (congrArg μ R)
  rw [← hx]
  exact H.symm

theorem wc_proet_deck_chart_continuousOn (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (μ : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ])
    (T : (wcP1Over K).left.ProEt) (t : T ⟶ wcGeomPoint K (wcP1Over K) hP)
    (s : G.obj.obj (Opposite.op T)) :
    (∀ τ : T.left, (∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W) (v : V.left),
        h' ≫ w = h ≫ t ∧ h.left v = τ) ∧
    ∀ f : T.left → ℚ_[ℓ],
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ t →
        ∀ v : V.left, f (h.left v) =
          μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom s)).down) v)) →
      ContinuousOn f {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} :=
by

  have hclosed : ∀ i, IsClosed ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
    intro i
    haveI : IsSeparated (wcP1Over K).hom := by
      first
        | infer_instance
        | (show IsSeparated (_ ≫ _); infer_instance)
    haveI : IsClosedImmersion (S i ≫ (wcP1Over K).hom) := by
      rw [hS i]; infer_instance
    haveI : IsClosedImmersion (S i) := IsClosedImmersion.of_comp (S i) (wcP1Over K).hom
    have hr : IsClosed (Set.range (S i)) := (S i).isClosedEmbedding.isClosed_range
    have hrange : Set.range (S i) = {S i (IsLocalRing.closedPoint K)} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rwa [hrange] at hr

  let U' : (wcP1Over K).left.Opens :=
    ⟨⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ,
      isOpen_iInter_of_finite (fun i => (hclosed i).isOpen_compl)⟩
  let O : T.left.Opens := T.hom ⁻¹ᵁ U'
  have hmemO : ∀ x : T.left, x ∈ O ↔ ∀ i, T.hom x ≠ S i (IsLocalRing.closedPoint K) := by
    intro x
    change T.hom x ∈ ⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ ↔ _
    exact Set.mem_iInter.trans (forall_congr' fun i => Iff.rfl)
  have hYO : {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} = (O : Set T.left) := by
    ext x
    exact (hmemO x).symm
  have hrangeO : ∀ x : T.left, x ∈ O → ∃ y : O.toScheme, O.ι y = x := by
    intro x hx
    have hx' : x ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    exact hx'

  haveI := hqc
  haveI hWp : WeaklyEtale W.hom := W.prop
  haveI hUp : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
    (wcGeomPoint K (wcP1Over K) hP).prop
  haveI hwU : WeaklyEtale (w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
    rw [MorphismProperty.Over.w w]; exact hWp
  haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left (wcGeomPoint K (wcP1Over K) hP).hom
  haveI hTp : WeaklyEtale T.hom := T.prop
  haveI hOw : WeaklyEtale O.ι := by
    first
      | exact etale_le_weaklyEtale _ (inferInstance : Etale O.ι)
      | exact etale_le_weaklyEtale _ _ _ (inferInstance : Etale O.ι)
      | infer_instance
  haveI hfst : WeaklyEtale (Limits.pullback.fst (O.ι ≫ t.left) w.left) := inferInstance
  haveI hfstq : QuasiCompact (Limits.pullback.fst (O.ι ≫ t.left) w.left) := inferInstance
  haveI hfstf : Flat (Limits.pullback.fst (O.ι ≫ t.left) w.left) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι ≫ T.hom) := inferInstance
  let V : (wcP1Over K).left.ProEt :=
    Scheme.ProEt.mk (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι ≫ T.hom)
  let h : V ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι)
    (Category.assoc _ _ _) trivial
  have hb : Limits.pullback.snd (O.ι ≫ t.left) w.left ≫ W.hom =
      Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι ≫ T.hom := by
    rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w t, ← Category.assoc,
      ← Limits.pullback.condition]
    simp only [Category.assoc]
  let h' : V ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd (O.ι ≫ t.left) w.left) hb
    trivial
  have hcomm : h' ≫ w = h ≫ t := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition.symm.trans (Category.assoc _ _ _).symm
  have hpt : ∀ v : V.left, h.left v = O.ι (Limits.pullback.fst (O.ι ≫ t.left) w.left v) := by
    intro v
    show (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι) v = _
    first
      | rfl
      | simp only [Scheme.Hom.comp_apply]
  have hπs : Function.Surjective (Limits.pullback.fst (O.ι ≫ t.left) w.left) := by
    intro x
    have hx : O.ι x ∈ O := (Scheme.Opens.range_ι O).subset ⟨x, rfl⟩
    have e1 : (wcGeomPoint K (wcP1Over K) hP).hom ((O.ι ≫ t.left) x) = T.hom (O.ι x) := by
      have h1 : t.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = T.hom :=
        MorphismProperty.Over.w t
      have h2 := congrArg (fun f => f (O.ι x)) h1
      simpa only [Scheme.Hom.comp_apply] using h2
    have hu : ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom ((O.ι ≫ t.left) x) ≠
        S i (IsLocalRing.closedPoint K) := by
      rw [e1]; exact (hmemO _).mp hx
    obtain ⟨z, hz⟩ := hsurj _ hu
    obtain ⟨v, hv, -⟩ := Scheme.Pullback.exists_preimage_pullback x z hz.symm
    exact ⟨v, hv⟩
  haveI : Surjective (Limits.pullback.fst (O.ι ≫ t.left) w.left) := (surjective_iff _).mpr hπs
  have hπq := Flat.isQuotientMap_of_surjective (Limits.pullback.fst (O.ι ≫ t.left) w.left)
  refine ⟨fun τ hτ => ?_, fun f hf => ?_⟩
  · obtain ⟨y, hy⟩ := hrangeO τ ((hmemO τ).mpr hτ)
    obtain ⟨v, hv⟩ := hπs y
    refine ⟨V, h, h', v, hcomm, ?_⟩
    rw [hpt v, hv, hy]
  · have hg : Continuous (fun v : V.left => μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom s)).down) v)) :=
      (LinearMap.continuous_of_finiteDimensional μ).comp (ContinuousMap.continuous _)
    have hFπ : Continuous ((fun y : O.toScheme => f (O.ι y)) ∘
        (Limits.pullback.fst (O.ι ≫ t.left) w.left)) := by
      have e : ((fun y : O.toScheme => f (O.ι y)) ∘
          (Limits.pullback.fst (O.ι ≫ t.left) w.left)) =
          (fun v : V.left => μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom s)).down) v)) := by
        funext v
        show f (O.ι (Limits.pullback.fst (O.ι ≫ t.left) w.left v)) = _
        rw [← hpt v]
        exact hf V h h' hcomm v
      rw [e]; exact hg
    have hF : Continuous (fun y : O.toScheme => f (O.ι y)) := hπq.continuous_iff.mpr hFπ
    rw [hYO]
    intro x hx
    obtain ⟨y, rfl⟩ := hrangeO x hx
    apply ContinuousAt.continuousWithinAt
    exact (O.ι.isOpenEmbedding.continuousAt_iff (g := f) (x := y)).mp hF.continuousAt

theorem wc_top_ultrametric_extend_of_local_clopen {X : Type u} [TopologicalSpace X] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Y : Set X) (f : X → ℚ_[ℓ]) (hf : ContinuousOn f Y)
    (hgen : ∀ x : X, ∃ y ∈ Y, y ⤳ x)
    (hlcl : ∀ x : X, ∃ O : Set X, IsOpen O ∧ x ∈ O ∧ ∀ U U' : Set X, IsOpen U → IsOpen U' →
      O ∩ Y ⊆ U ∪ U' → O ∩ Y ∩ U ∩ U' = ∅ →
      ∃ C : Set X, IsOpen C ∧ IsOpen (O \ C) ∧ C ⊆ O ∧ C ∩ Y = O ∩ Y ∩ U) :
    ∃ g : C(X, ℚ_[ℓ]), ∀ x : X, ∀ y ∈ Y, y ⤳ x → g x = f y :=
by
  classical
  have key : ∀ (x y : X), y ∈ Y → y ⤳ x → ∀ ε : ℝ, 0 < ε →
      ∃ C : Set X, IsOpen C ∧ x ∈ C ∧ ∀ z ∈ C, z ∈ Y → dist (f z) (f y) < ε := by
    intro x y hy hyx ε hε
    have hBo : IsOpen (Metric.ball (f y) ε) := Metric.isOpen_ball
    have hBc : IsClosed (Metric.ball (f y) ε) := IsUltrametricDist.isClosed_ball (f y) ε
    obtain ⟨U, hU, hUeq⟩ := continuousOn_iff'.mp hf _ hBo
    obtain ⟨U', hU', hU'eq⟩ := continuousOn_iff'.mp hf _ hBc.isOpen_compl
    obtain ⟨O, hO, hxO, hO'⟩ := hlcl x
    have hcov : O ∩ Y ⊆ U ∪ U' := by
      rintro z ⟨_, hzY⟩
      by_cases hz : f z ∈ Metric.ball (f y) ε
      · left
        have h1 : z ∈ f ⁻¹' Metric.ball (f y) ε ∩ Y := ⟨hz, hzY⟩
        rw [hUeq] at h1
        exact h1.1
      · right
        have h1 : z ∈ f ⁻¹' (Metric.ball (f y) ε)ᶜ ∩ Y := ⟨hz, hzY⟩
        rw [hU'eq] at h1
        exact h1.1
    have hdisj : O ∩ Y ∩ U ∩ U' = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      rintro z ⟨⟨⟨_, hzY⟩, hzU⟩, hzU'⟩
      have h1 : z ∈ U ∩ Y := ⟨hzU, hzY⟩
      have h2 : z ∈ U' ∩ Y := ⟨hzU', hzY⟩
      rw [← hUeq] at h1
      rw [← hU'eq] at h2
      exact h2.1 h1.1
    obtain ⟨C, hC, hOC, _, hCY⟩ := hO' U U' hU hU' hcov hdisj
    have hyO : y ∈ O := hyx.mem_open hO hxO
    have hyU : y ∈ U := by
      have h1 : y ∈ f ⁻¹' Metric.ball (f y) ε ∩ Y := ⟨Metric.mem_ball_self hε, hy⟩
      rw [hUeq] at h1
      exact h1.1
    have hyC : y ∈ C := by
      have h1 : y ∈ O ∩ Y ∩ U := ⟨⟨hyO, hy⟩, hyU⟩
      rw [← hCY] at h1
      exact h1.1
    have hxC : x ∈ C := by
      by_contra hxC
      have h1 : y ∈ O \ C := hyx.mem_open hOC ⟨hxO, hxC⟩
      exact h1.2 hyC
    refine ⟨C, hC, hxC, fun z hzC hzY => ?_⟩
    have h1 : z ∈ C ∩ Y := ⟨hzC, hzY⟩
    rw [hCY] at h1
    have h2 : z ∈ U ∩ Y := ⟨h1.2, hzY⟩
    rw [← hUeq] at h2
    exact h2.1
  choose gy hgyY hgyx using hgen
  have hwd : ∀ x : X, ∀ y ∈ Y, y ⤳ x → f y = f (gy x) := by
    intro x y hy hyx
    apply eq_of_forall_dist_le
    intro ε hε
    obtain ⟨C, hC, hxC, hCb⟩ := key x (gy x) (hgyY x) (hgyx x) ε hε
    exact (hCb y (hyx.mem_open hC hxC) hy).le
  have hcont : Continuous (fun x => f (gy x)) := by
    apply continuous_iff_continuousAt.mpr
    intro x
    apply Metric.continuousAt_iff'.mpr
    intro ε hε
    obtain ⟨C, hC, hxC, hCb⟩ := key x (gy x) (hgyY x) (hgyx x) ε hε
    apply Filter.eventually_of_mem (hC.mem_nhds hxC)
    intro x' hx'
    exact hCb (gy x') ((hgyx x').mem_open hC hx') (hgyY x')
  refine ⟨⟨fun x => f (gy x), hcont⟩, fun x y hy hyx => ?_⟩
  exact (hwd x y hy hyx).symm

theorem wc_P1_proet_offS_local_clopen (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (T : (wcP1Over K).left.ProEt) :
    (∀ x : T.left, ∃ y ∈ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)}, y ⤳ x) ∧
    ∀ x : T.left, ∃ O : Set T.left, IsOpen O ∧ x ∈ O ∧ ∀ U U' : Set T.left, IsOpen U → IsOpen U' →
      O ∩ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} ⊆ U ∪ U' →
      O ∩ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} ∩ U ∩ U' = ∅ →
      ∃ C : Set T.left, IsOpen C ∧ IsOpen (O \ C) ∧ C ⊆ O ∧
        C ∩ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} =
          O ∩ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} ∩ U :=
by
  classical

  have hclosed : ∀ i, IsClosed ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
    intro i
    haveI : IsSeparated (wcP1Over K).hom := by
      first
        | infer_instance
        | (show IsSeparated (_ ≫ _); infer_instance)
    haveI : IsClosedImmersion (S i ≫ (wcP1Over K).hom) := by
      rw [hS i]; infer_instance
    haveI : IsClosedImmersion (S i) := IsClosedImmersion.of_comp (S i) (wcP1Over K).hom
    have hr : IsClosed (Set.range (S i)) := (S i).isClosedEmbedding.isClosed_range
    have hrange : Set.range (S i) = {S i (IsLocalRing.closedPoint K)} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rwa [hrange] at hr
  refine ⟨?_, ?_⟩
  ·
    intro x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hprime : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ ⊥ := by
      intro h
      have hX0 := HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
          (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1))))
      have h0 := h hX0
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨⊥, hprime, hirr⟩
    have hcl : ∀ y : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        y ∈ closure ({η} : Set _) := fun y =>
      (ProjectiveSpectrum.le_iff_mem_closure _ η y).mp
        ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η y).mp bot_le)
    let ηP : (wcP1Over K).left := η
    have hspec : ∀ y : (wcP1Over K).left, ηP ⤳ y := fun y =>
      specializes_iff_mem_closure.mpr (hcl y)
    have hX0h : ∀ x ∈ ({MvPolynomial.X (0 : Fin (1 + 1))} : Set (MvPolynomial (Fin (1 + 1)) K)),
        SetLike.IsHomogeneousElem (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) x := by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1)))⟩
    let I0 : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨Ideal.span {MvPolynomial.X (0 : Fin (1 + 1))},
        Ideal.homogeneous_span (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) _ hX0h⟩
    have hI0toIdeal : I0.toIdeal = Ideal.span {MvPolynomial.X (0 : Fin (1 + 1))} := rfl
    have hprime0 : I0.toIdeal.IsPrime := by
      rw [hI0toIdeal]
      exact (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero _)).mpr MvPolynomial.X_prime
    have hirr0 : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ I0 := by
      intro h
      have hX1 := HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
          (MvPolynomial.isHomogeneous_X K (1 : Fin (1 + 1))))
      have h1 := h hX1
      rw [← HomogeneousIdeal.mem_iff, hI0toIdeal, Ideal.mem_span_singleton,
        MvPolynomial.X_dvd_X] at h1
      exact absurd h1 (by decide)
    let p : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨I0, hprime0, hirr0⟩
    have hηp : η ≠ p := by
      intro hEq
      have e := congrArg (fun q : ProjectiveSpectrum
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) => q.asHomogeneousIdeal.toIdeal) hEq
      have hmem : MvPolynomial.X (0 : Fin (1 + 1)) ∈ p.asHomogeneousIdeal.toIdeal := by
        show MvPolynomial.X (0 : Fin (1 + 1)) ∈ I0.toIdeal
        rw [hI0toIdeal]
        exact Ideal.subset_span (Set.mem_singleton _)
      have e' : η.asHomogeneousIdeal.toIdeal = p.asHomogeneousIdeal.toIdeal := e
      rw [← e'] at hmem
      have hb : η.asHomogeneousIdeal.toIdeal = ⊥ := HomogeneousIdeal.toIdeal_bot
      rw [hb, Ideal.mem_bot] at hmem
      exact MvPolynomial.X_ne_zero _ hmem
    let pP : (wcP1Over K).left := p
    have hηpP : ηP ≠ pP := hηp
    have hηS : ∀ i, ηP ≠ S i (IsLocalRing.closedPoint K) := by
      intro i hEq
      have h1 : pP ∈ closure ({ηP} : Set (wcP1Over K).left) :=
        specializes_iff_mem_closure.mp (hspec pP)
      rw [hEq, (hclosed i).closure_eq, Set.mem_singleton_iff] at h1
      exact hηpP (hEq.trans h1.symm)
    haveI hTwe : WeaklyEtale T.hom := T.prop
    haveI hTfl : Flat T.hom := inferInstance
    obtain ⟨t', ht't, hη⟩ := Flat.generalizingMap T.hom (hspec (T.hom x))
    refine ⟨t', ?_, ht't⟩
    intro i
    rw [hη]
    exact hηS i
  ·
    intro x
    obtain ⟨B, _, φ, ψ, j, hφ, hx, hj, hcomm, hW⟩ := wc_proet_P1_affine_chart K T x
    haveI := hφ
    haveI := hj
    have hjinj : Function.Injective ⇑j := (Scheme.Hom.isOpenEmbedding j).injective

    have hfex : ∀ i : Fin m, ∃ f : Polynomial K, f ≠ 0 ∧ ∀ q : PrimeSpectrum (Polynomial K),
        (f ∈ q.asIdeal ↔ j q = S i (IsLocalRing.closedPoint K)) := by
      intro i
      by_cases hr : ∃ q₀ : PrimeSpectrum (Polynomial K), j q₀ = S i (IsLocalRing.closedPoint K)
      · obtain ⟨q₀, hq₀⟩ := hr
        have hcl : IsClosed ({q₀} : Set (PrimeSpectrum (Polynomial K))) := by
          have h2 : ({q₀} : Set (PrimeSpectrum (Polynomial K))) =
              (⇑j) ⁻¹' {S i (IsLocalRing.closedPoint K)} := by
            ext q
            simp only [Set.mem_preimage, Set.mem_singleton_iff]
            constructor
            · rintro rfl; exact hq₀
            · intro h; exact hjinj (h.trans hq₀.symm)
          rw [h2]
          exact IsClosed.preimage (Scheme.Hom.continuous j) (hclosed i)
        have hmax : q₀.asIdeal.IsMaximal :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal q₀).mp hcl
        have hne : q₀.asIdeal ≠ ⊥ :=
          Ring.ne_bot_of_isMaximal_of_not_isField hmax (Polynomial.not_isField K)
        refine ⟨Submodule.IsPrincipal.generator q₀.asIdeal, ?_, ?_⟩
        · intro h0
          exact hne ((Submodule.IsPrincipal.eq_bot_iff_generator_eq_zero _).mpr h0)
        · intro q
          constructor
          · intro hmem
            have hle : q₀.asIdeal ≤ q.asIdeal := by
              rw [← Ideal.span_singleton_generator q₀.asIdeal]
              exact (Ideal.span_singleton_le_iff_mem _).mpr hmem
            have heq : q₀.asIdeal = q.asIdeal := hmax.eq_of_le q.isPrime.ne_top hle
            have hqq : q₀ = q := PrimeSpectrum.ext heq
            rw [← hqq]
            exact hq₀
          · intro hq
            have hqq : q = q₀ := hjinj (hq.trans hq₀.symm)
            rw [hqq]
            exact Submodule.IsPrincipal.generator_mem _
      · refine ⟨1, one_ne_zero, ?_⟩
        intro q
        constructor
        · intro h1
          exact absurd (q.asIdeal.eq_top_of_isUnit_mem h1 isUnit_one) q.isPrime.ne_top
        · intro hq
          exact absurd ⟨q, hq⟩ hr
    choose f hf0 hf using hfex
    obtain ⟨σ, hσdef⟩ : ∃ σ : Polynomial K, σ = ∏ i, f i := ⟨_, rfl⟩
    have hσ0 : σ ≠ 0 := by
      rw [hσdef]
      exact Finset.prod_ne_zero_iff.mpr (fun i _ => hf0 i)
    have hσ : ∀ q : PrimeSpectrum (Polynomial K),
        σ ∈ q.asIdeal ↔ ∃ i, j q = S i (IsLocalRing.closedPoint K) := by
      intro q
      rw [hσdef, Ideal.IsPrime.prod_mem_iff]
      simp only [Finset.mem_univ, true_and, hf]

    letI : Algebra (Polynomial K) B := ψ.toAlgebra
    have hZ : ∀ p : PrimeSpectrum B, (∀ i, T.hom (φ p) ≠ S i (IsLocalRing.closedPoint K)) ↔
        algebraMap (Polynomial K) B σ ∉ p.asIdeal := by
      intro p
      have e1 : T.hom (φ p) = j (PrimeSpectrum.comap ψ p) := by
        calc T.hom (φ p) = (φ ≫ T.hom) p := (Scheme.Hom.comp_apply φ T.hom p).symm
          _ = (Spec.map (CommRingCat.ofHom ψ) ≫ j) p :=
            congrArg (fun g : Spec (.of B) ⟶ (wcP1Over K).left => g p) hcomm
          _ = j (Spec.map (CommRingCat.ofHom ψ) p) := Scheme.Hom.comp_apply _ _ _
          _ = j (PrimeSpectrum.comap ψ p) := rfl
      have e2 : algebraMap (Polynomial K) B σ ∈ p.asIdeal ↔
          σ ∈ (PrimeSpectrum.comap ψ p).asIdeal := by
        show ψ σ ∈ p.asIdeal ↔ _
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      rw [e1, e2, hσ]
      exact not_exists.symm

    have hnorm := wc_weaklyEtale_normal_idem (Polynomial K) B hW
    have hlift := wc_weaklyEtale_away_idem_lift (Polynomial K) B hW hnorm σ hσ0
    set r : B := algebraMap (Polynomial K) B σ with hrdef
    have hιemb := PrimeSpectrum.localization_away_isOpenEmbedding (Localization.Away r) r
    have hιrange := PrimeSpectrum.localization_away_comap_range (Localization.Away r) r
    have hιr : ∀ p' : PrimeSpectrum (Localization.Away r),
        r ∉ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p').asIdeal := by
      intro p'
      have h1 : PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p' ∈
          Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away r))) := ⟨p', rfl⟩
      rw [hιrange] at h1
      exact (PrimeSpectrum.mem_basicOpen _ _).mp h1
    have hinr : ∀ p : PrimeSpectrum B, r ∉ p.asIdeal →
        ∃ p' : PrimeSpectrum (Localization.Away r),
          PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p' = p := by
      intro p hp
      have h1 : p ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away r))) := by
        rw [hιrange]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr hp
      exact h1

    refine ⟨Set.range ⇑φ, (Scheme.Hom.isOpenEmbedding φ).isOpen_range, hx, ?_⟩
    intro U U' hU hU' hcov hdisj
    have hgcont : Continuous (fun p' : PrimeSpectrum (Localization.Away r) =>
        φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p')) :=
      (Scheme.Hom.continuous φ).comp hιemb.continuous
    set E : Set (PrimeSpectrum (Localization.Away r)) :=
      (fun p' : PrimeSpectrum (Localization.Away r) =>
        φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p')) ⁻¹' U with hEdef
    have hEo : IsOpen E := hU.preimage hgcont
    have hEc : IsOpen Eᶜ := by
      have hEq : Eᶜ = (fun p' : PrimeSpectrum (Localization.Away r) =>
          φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p')) ⁻¹' U' := by
        ext p'
        have hp' : φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p') ∈
            Set.range ⇑φ ∩ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} :=
          ⟨⟨_, rfl⟩, (hZ _).mpr (hιr p')⟩
        constructor
        · intro hn
          rcases hcov hp' with h | h
          · exact absurd h hn
          · exact h
        · intro h hu
          have h3 : φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p') ∈
              Set.range ⇑φ ∩ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)} ∩
                U ∩ U' := ⟨⟨hp', hu⟩, h⟩
          rw [hdisj] at h3
          exact h3
      rw [hEq]
      exact hU'.preimage hgcont
    have hEcl : IsClopen E := ⟨isOpen_compl_iff.mp hEc, hEo⟩
    obtain ⟨e, he, hEe⟩ := PrimeSpectrum.isClopen_iff.mp hEcl
    obtain ⟨c, hc, hce⟩ := hlift e he
    have hkey : ∀ p' : PrimeSpectrum (Localization.Away r),
        c ∉ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p').asIdeal ↔
          φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p') ∈ U := by
      intro p'
      have h1 : p' ∈ E ↔
          φ (PrimeSpectrum.comap (algebraMap B (Localization.Away r)) p') ∈ U := Iff.rfl
      rw [hEe, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at h1
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hce]
      exact h1
    have hDc : IsClopen (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum B)) :=
      PrimeSpectrum.isClopen_iff.mpr ⟨c, hc, rfl⟩
    refine ⟨⇑φ '' (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum B)), ?_, ?_,
      Set.image_subset_range _ _, ?_⟩
    · exact (Scheme.Hom.isOpenEmbedding φ).isOpenMap _ (PrimeSpectrum.basicOpen c).isOpen
    · have hO := (Scheme.Hom.isOpenEmbedding φ).isOpenMap _ hDc.1.isOpen_compl
      exact (congrArg IsOpen (Set.image_compl_eq_range_sdiff_image
        (Scheme.Hom.isOpenEmbedding φ).injective
        (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum B)))).mp hO
    · ext t
      constructor
      · rintro ⟨⟨p, hp, rfl⟩, hY⟩
        have hpr : r ∉ p.asIdeal := (hZ p).mp hY
        obtain ⟨p', rfl⟩ := hinr p hpr
        exact ⟨⟨⟨_, rfl⟩, hY⟩, (hkey p').mp hp⟩
      · rintro ⟨⟨⟨p, rfl⟩, hY⟩, hUt⟩
        have hpr : r ∉ p.asIdeal := (hZ p).mp hY
        obtain ⟨p', rfl⟩ := hinr p hpr
        exact ⟨⟨_, (hkey p').mpr hUt, rfl⟩, hY⟩

theorem wc_proet_over_hom_of_continuous_family (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B : S.ProEt)
    (F : ∀ T : Over B, G.obj.obj (Opposite.op T.left) → C(↥T.left.left, ℚ_[ℓ]))
    (hadd : ∀ (T : Over B) (s s' : G.obj.obj (Opposite.op T.left)),
      F T (s + s') = F T s + F T s')
    (hnat : ∀ (T T' : Over B) (c : T' ⟶ T) (s : G.obj.obj (Opposite.op T.left))
      (z : T'.left.left), F T' ((G.obj.map c.left.op).hom s) z = F T s (c.left.left z)) :
    ∃ φ : G.over B ⟶ (wcContSheaf S ℚ_[ℓ]).over B,
      ∀ (T : Over B) (s : G.obj.obj (Opposite.op T.left)) (z : T.left.left),
        (show C(↥T.left.left, ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom s).down) z =
          F T s z :=
by
  refine ⟨ObjectProperty.homMk
    ({ app := fun T => AddCommGrpCat.ofHom
          (AddMonoidHom.mk'
            (fun s : G.obj.obj (Opposite.op T.unop.left) =>
              (ULift.up (F T.unop s) : ULift.{u+1} C(↥T.unop.left.left, ℚ_[ℓ])))
            (fun s s' => congrArg ULift.up (hadd T.unop s s')))
       naturality := fun X Y g => by
         ext s
         apply ULift.ext
         exact ContinuousMap.ext (fun z => hnat X.unop Y.unop g.unop s z) } :
      (G.over B).obj ⟶ ((wcContSheaf S ℚ_[ℓ]).over B).obj), ?_⟩
  intro T s z
  rfl

theorem wc_proet_invariant_functional_descent (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (μ : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ])
    (hinv : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
      μ (wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z) =
      μ (wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) :
    ∃ φ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcContSheaf (wcP1Over K).left (Fin 1 → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP),
      ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V)) (z : V.left),
        wcContEval (wcP1Over K).left V ((φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y) z 0 =
          μ (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) z) :=
by
  classical

  have hinv' : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W),
      b = a ≫ γ → ∀ (x : G.obj.obj (Opposite.op V)) (z : V.left),
        μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) =
        μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) := by
    intro γ hγ V a b hab x z
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over K).left ℓ G W hconn k θ γ
    have hAμ : ∀ u, μ (A u) = μ u := by
      intro u
      haveI := hconn
      obtain ⟨z₀⟩ : Nonempty W.left := inferInstance
      obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk (𝟙 W))),
          ∀ z, (show C(↥W.left, Fin k → ℚ_[ℓ]) from c₀.down) z = u :=
        ⟨ULift.up (ContinuousMap.const _ u), fun z => rfl⟩
      have hθ : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
          ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀) = c₀ := by
        have h1 := congrArg (fun f : ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W ⟶
            (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W) =>
              (f.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀) θ.inv_hom_id
        exact h1
      have e1 := hA W (𝟙 W) γ (Category.id_comp γ).symm
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀) z₀
      have e2 := hinv γ hγ ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀) z₀
      have e3 : (show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
            ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀)).down) z₀ = u :=
        (congrArg (fun c : ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W).obj.obj
            (Opposite.op (Over.mk (𝟙 W))) =>
              (show C(↥W.left, Fin k → ℚ_[ℓ]) from c.down) z₀) hθ).trans (hc₀ z₀)
      calc μ (A u) = μ (A ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
              ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀)).down) z₀)) := by
            rw [e3]
        _ = μ ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom
              ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀)).down) z₀) := by
            rw [e1]
        _ = μ ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
              ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀)).down) z₀) := e2
        _ = μ u := by rw [e3]
    exact (congrArg μ (hA V a b hab x z)).trans (hAμ _)

  obtain ⟨fv, hCP⟩ : ∃ fv : ∀ T : Over (wcGeomPoint K (wcP1Over K) hP),
      G.obj.obj (Opposite.op T.left) → T.left.left → ℚ_[ℓ],
      ∀ (T : Over (wcGeomPoint K (wcP1Over K) hP))
        (s : G.obj.obj (Opposite.op T.left))
        (V : (wcP1Over K).left.ProEt) (h : V ⟶ T.left) (h' : V ⟶ W),
        h' ≫ w = h ≫ T.hom → ∀ v : V.left, fv T s (h.left v) =
          μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              ((G.obj.map h.op).hom s)).down) v) := by
    refine ⟨fun T s τ => if hne : ({r : ℚ_[ℓ] | ∃ (V : (wcP1Over K).left.ProEt)
        (h : V ⟶ T.left) (h' : V ⟶ W) (v : V.left), h' ≫ w = h ≫ T.hom ∧ h.left v = τ ∧
          r = μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              ((G.obj.map h.op).hom s)).down) v)} : Set ℚ_[ℓ]).Nonempty
      then hne.some else 0, ?_⟩
    intro T s V h h' e v
    dsimp only
    split_ifs with hne
    · obtain ⟨V₁, h₁, h₁', v₁, e₁, hv₁, hr⟩ := hne.some_mem
      rw [hr]
      exact wc_proet_deck_value_unique (wcP1Over K).left ℓ G
        (wcGeomPoint K (wcP1Over K) hP) W w hgal k θ μ hinv' T.left T.hom s V₁ V h₁ h₁' h h'
        e₁ e v₁ v hv₁
    · exact (hne ⟨_, V, h, h', v, e, rfl, rfl⟩).elim

  have hext : ∀ (T : Over (wcGeomPoint K (wcP1Over K) hP))
      (s : G.obj.obj (Opposite.op T.left)),
      ∃ g : C(↥T.left.left, ℚ_[ℓ]), ∀ x : T.left.left,
        ∀ y ∈ {τ : T.left.left | ∀ i, T.left.hom τ ≠ S i (IsLocalRing.closedPoint K)},
          y ⤳ x → g x = fv T s y := by
    intro T s
    obtain ⟨_, hcont⟩ := wc_proet_deck_chart_continuousOn K hP m S hS ℓ
      G W w hqc hsurj k θ μ T.left T.hom s
    obtain ⟨hgen, hlcl⟩ := wc_P1_proet_offS_local_clopen K m S hS T.left
    exact wc_top_ultrametric_extend_of_local_clopen ℓ _ (fv T s)
      (hcont (fv T s) (fun V h h' e v => hCP T s V h h' e v)) hgen hlcl
  choose Fm hFm using hext

  have hgood : ∀ (T : Over (wcGeomPoint K (wcP1Over K) hP)) (x : T.left.left),
      ∃ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T.left) (h' : V ⟶ W) (v : V.left),
        h' ≫ w = h ≫ T.hom ∧ (∀ i, T.left.hom (h.left v) ≠ S i (IsLocalRing.closedPoint K)) ∧
        h.left v ⤳ x := by
    intro T x
    obtain ⟨y, hy, hyx⟩ := (wc_P1_proet_offS_local_clopen K m S hS T.left).1 x
    obtain ⟨V, h, h', v, e, hv⟩ := (wc_proet_deck_chart_continuousOn K hP m S hS ℓ
      G W w hqc hsurj k θ μ T.left T.hom 0).1 y hy
    refine ⟨V, h, h', v, e, ?_, ?_⟩
    · rw [hv]; exact hy
    · rw [hv]; exact hyx

  have hval : ∀ (T : Over (wcGeomPoint K (wcP1Over K) hP))
      (s : G.obj.obj (Opposite.op T.left)) (x : T.left.left)
      (V : (wcP1Over K).left.ProEt) (h : V ⟶ T.left) (h' : V ⟶ W) (v : V.left),
      h' ≫ w = h ≫ T.hom → (∀ i, T.left.hom (h.left v) ≠ S i (IsLocalRing.closedPoint K)) →
      h.left v ⤳ x →
      Fm T s x = μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          ((G.obj.map h.op).hom s)).down) v) := by
    intro T s x V h h' v e hY hsp
    rw [hFm T s x (h.left v) hY hsp, hCP T s V h h' e v]

  have hlin : ∀ (V : (wcP1Over K).left.ProEt) (a : V ⟶ W)
      (x y : G.obj.obj (Opposite.op V)) (z : V.left),
      μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom (x + y)).down) z) =
      μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) +
      μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom y).down) z) := by
    intro V a x y z
    have e : (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom (x + y)).down) z =
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z +
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom y).down) z := by
      have hm := map_add ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom) x y
      exact (congrArg (fun c : ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk a)) => (show C(↥V.left, Fin k → ℚ_[ℓ]) from c.down) z) hm).trans rfl
    rw [e, map_add]
  have hadd : ∀ (T : Over (wcGeomPoint K (wcP1Over K) hP))
      (s s' : G.obj.obj (Opposite.op T.left)),
      Fm T (s + s') = Fm T s + Fm T s' := by
    intro T s s'
    ext x
    obtain ⟨V, h, h', v, e, hY, hsp⟩ := hgood T x
    rw [ContinuousMap.add_apply, hval T (s + s') x V h h' v e hY hsp,
      hval T s x V h h' v e hY hsp, hval T s' x V h h' v e hY hsp,
      map_add (G.obj.map h.op).hom s s']
    exact hlin V h' _ _ v
  have hnat : ∀ (T T' : Over (wcGeomPoint K (wcP1Over K) hP)) (c : T' ⟶ T)
      (s : G.obj.obj (Opposite.op T.left)) (z : T'.left.left),
      Fm T' ((G.obj.map c.left.op).hom s) z = Fm T s (c.left.left z) := by
    intro T T' c s z
    obtain ⟨V, h, h', v, e, hY, hsp⟩ := hgood T' z
    have hcomp : (h ≫ c.left).left v = c.left.left (h.left v) := by
      first
        | rfl
        | simp [Scheme.Hom.comp_apply]
    have e' : h' ≫ w = (h ≫ c.left) ≫ T.hom := by
      rw [Category.assoc, Over.w c]
      exact e
    have hTT : T.left.hom (c.left.left (h.left v)) = T'.left.hom (h.left v) := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w c.left]
    have hY' : ∀ i, T.left.hom ((h ≫ c.left).left v) ≠ S i (IsLocalRing.closedPoint K) := by
      intro i
      rw [hcomp, hTT]
      exact hY i
    have hsp' : (h ≫ c.left).left v ⤳ c.left.left z := by
      rw [hcomp]
      exact hsp.map (c.left.left).continuous
    rw [hval T' _ z V h h' v e hY hsp, hval T s (c.left.left z) V (h ≫ c.left) h' v e' hY' hsp',
      op_comp, Functor.map_comp]
    try rfl

  obtain ⟨φ₀, hφ₀⟩ := wc_proet_over_hom_of_continuous_family (wcP1Over K).left ℓ
    G (wcGeomPoint K (wcP1Over K) hP) Fm hadd hnat

  let ι₁ : ℚ_[ℓ] →+ (Fin 1 → ℚ_[ℓ]) :=
    { toFun := fun c _ => c, map_zero' := rfl, map_add' := fun _ _ => rfl }
  have hι₁ : Continuous ι₁ := by
    have h : Continuous (fun (c : ℚ_[ℓ]) (_ : Fin 1) => c) := continuous_pi fun _ => continuous_id
    exact h
  refine ⟨φ₀ ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint K (wcP1Over K) hP)).map (wcContSheafMap (wcP1Over K).left ι₁ hι₁), ?_⟩

  intro V h' y z
  obtain ⟨y₀, hy₀, hy₀z⟩ := (wc_P1_proet_offS_local_clopen K m S hS V).1 z
  have h1 : Fm (Over.mk (h' ≫ w)) y z = fv (Over.mk (h' ≫ w)) y y₀ :=
    hFm (Over.mk (h' ≫ w)) y z y₀ hy₀ hy₀z
  have h2 := hCP (Over.mk (h' ≫ w)) y V (𝟙 V) h' (Category.id_comp _).symm y₀
  have hid1 : (𝟙 V : V ⟶ V).left y₀ = y₀ := by
    first
      | rfl
      | simp
  have hidG : (G.obj.map (𝟙 V).op).hom y = y := by
    rw [op_id, CategoryTheory.Functor.map_id]
    first
      | rfl
      | simp
  have hc : Continuous (fun q : V.left => μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) q)) :=
    (LinearMap.continuous_of_finiteDimensional μ).comp (ContinuousMap.continuous _)
  have h3 := (hy₀z.map hc).eq
  calc _ = Fm (Over.mk (h' ≫ w)) y z := hφ₀ (Over.mk (h' ≫ w)) y z
    _ = fv (Over.mk (h' ≫ w)) y y₀ := h1
    _ = μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) y₀) := by
        refine (congrArg (fv (Over.mk (h' ≫ w)) y) hid1.symm).trans (h2.trans ?_)
        exact congrArg (fun t => μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom t).down) y₀)) hidG
    _ = μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) z) := h3

theorem wc_honest_Rg_twist_stable (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP) :
    ∀ (V : (wcP1Over F'').left.ProEt) (h₁ h₂ : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval (wcP1Over F'').left V
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ wcHonestRg H) →
      ∀ z : V.left, wcContEval (wcP1Over F'').left V
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ wcHonestRg H :=
by
  classical
  intro V h₁ h₂ x hx z

  have hnat : ∀ (T V' : (wcP1Over F'').left.ProEt) (k : T ⟶ V') (h' : V' ⟶ H.W) (h'' : T ⟶ H.W)
      (hk : k ≫ h' = h'') (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (zz : T.left),
      wcContEval (wcP1Over F'').left T
          ((H.θ.hom.hom.app (Opposite.op (Over.mk h''))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom y)) zz =
        wcContEval (wcP1Over F'').left V' ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y)
          (k.left zz) := by
    intro T V' k h' h'' hk y zz
    subst hk
    have e := H.θ.hom.hom.naturality
      (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op
    have e2 := congrArg (fun φ => φ.hom y) e
    exact congrArg (fun f => wcContEval (wcP1Over F'').left T f zz) e2

  by_contra hv
  obtain ⟨μ, hμv, hμR⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hv Module.Projective.of_free
  have hμ0 : ∀ u ∈ wcHonestRg H, μ u = 0 := by
    intro u hu
    have hm : μ u ∈ (wcHonestRg H).map μ := Submodule.mem_map_of_mem hu
    rw [hμR] at hm
    exact (Submodule.mem_bot ℚ_[ℓ]).mp hm
  have hμinv : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ u, μ (H.fr γ u) = μ u := by
    intro γ hγ u
    have h0 := hμ0 _ (Submodule.subset_span ⟨γ, u, hγ, rfl⟩ : H.fr γ u - u ∈ wcHonestRg H)
    rw [map_sub, sub_eq_zero] at h0
    exact h0

  obtain ⟨V₁, k, z₁, hV₁, hkz⟩ := wc_proet_connected_nbhd (wcP1Over F'').left V z
  have hx1 : ∀ z' : V₁.left, wcContEval (wcP1Over F'').left V₁
      ((H.θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h₁)))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom x)) z' ∈ wcHonestRg H := by
    intro z'
    rw [hnat V₁ V k h₁ (k ≫ h₁) rfl x z']
    exact hx _
  have hv1 : wcContEval (wcP1Over F'').left V₁
      ((H.θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h₂)))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom x)) z₁ =
      wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z := by
    rw [hnat V₁ V k h₂ (k ≫ h₂) rfl x z₁, hkz]

  obtain ⟨e, he⟩ := wc_geomPoint_hom_twist F'' (wcP1Over F'') hP V₁ hV₁
    ((k ≫ h₁) ≫ H.w) ((k ≫ h₂) ≫ H.w)

  have hinv : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w →
      ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op H.W)) (zz : H.W.left),
      μ (wcContEval (wcP1Over F'').left H.W
        ((H.θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) zz) =
      μ (wcContEval (wcP1Over F'').left H.W
        ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) zz) := by
    intro γ hγ s zz
    exact (congrArg μ (H.hfr γ hγ s zz)).trans (hμinv γ hγ _)
  obtain ⟨φ, hφ⟩ := wc_proet_invariant_functional_descent F'' hP D.m D.S D.hS ℓ
    (wcRq D.f ℓ (n - 1)) H.W H.w H.hqc H.hconn H.hcov H.hgal H.N H.θ μ hinv

  let Ψ' : ((wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).over H.W).obj ⟶
      ((wcContSheaf (wcP1Over F'').left (Fin 1 → ℚ_[ℓ])).over H.W).obj :=
    H.θ.inv.hom ≫ Functor.whiskerLeft (Over.map (H.w ≫ e.hom)).op φ.hom
  let Ψ : (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).over H.W ⟶
      (wcContSheaf (wcP1Over F'').left (Fin 1 → ℚ_[ℓ])).over H.W := ObjectProperty.homMk Ψ'
  obtain ⟨ν, hν⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ H.W H.hconn H.N 1 Ψ
  have hN : ∀ (T : (wcP1Over F'').left.ProEt) (t' : T ⟶ H.W)
      (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (hg : t' ≫ H.w ≫ e.hom = g) (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T))
      (zz : T.left),
      wcContEval (wcP1Over F'').left T ((φ.hom.app (Opposite.op (Over.mk g))).hom y) zz =
        ν (wcContEval (wcP1Over F'').left T
          ((H.θ.hom.hom.app (Opposite.op (Over.mk t'))).hom y) zz) := by
    intro T t' g hg y zz
    subst hg
    have h2 : (H.θ.inv.hom.app (Opposite.op (Over.mk t'))).hom
        ((H.θ.hom.hom.app (Opposite.op (Over.mk t'))).hom y) = y :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk t'))).hom y) H.θ.hom_inv_id
    have h1 := congrArg (fun ψ => wcContEval (wcP1Over F'').left T
      ((ψ.hom.app (Opposite.op (Over.mk t'))).hom
        ((H.θ.hom.hom.app (Opposite.op (Over.mk t'))).hom y)) zz) hν
    refine (congrArg (fun y' => wcContEval (wcP1Over F'').left T
      ((φ.hom.app (Opposite.op (Over.mk (t' ≫ H.w ≫ e.hom)))).hom y') zz) h2).symm.trans
        (h1.trans ?_)
    rfl

  obtain ⟨z0⟩ := H.hconn.toNonempty
  have hνinv : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ v₀, ν (H.fr γ v₀) = ν v₀ := by
    intro γ hγ v₀
    obtain ⟨cu, hcu⟩ : ∃ cu : (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).obj.obj
        (Opposite.op H.W), ∀ q, wcContEval (wcP1Over F'').left H.W cu q = v₀ :=
      ⟨show ULift.{u+1} C(↥H.W.left, Fin H.N → ℚ_[ℓ]) from ULift.up (ContinuousMap.const _ v₀),
        fun _ => rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op H.W),
        (H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s = cu :=
      ⟨_, congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom cu) H.θ.inv_hom_id⟩
    have hev : wcContEval (wcP1Over F'').left H.W
        ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) z0 = v₀ := by
      rw [hs]; exact hcu z0
    have hfr : wcContEval (wcP1Over F'').left H.W
        ((H.θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z0 =
        H.fr γ (wcContEval (wcP1Over F'').left H.W
          ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) z0) := H.hfr γ hγ s z0
    have e1 := hN H.W γ (H.w ≫ e.hom) (by rw [← Category.assoc, hγ]) s z0
    have e2 := hN H.W (𝟙 H.W) (H.w ≫ e.hom) (Category.id_comp _) s z0
    rw [hev] at hfr e2
    rw [← hfr, ← e1, e2]
  have hνR : ∀ u ∈ wcHonestRg H, ν u = 0 := by
    intro u hu
    have hle : wcHonestRg H ≤ LinearMap.ker ν := by
      unfold wcHonestRg
      rw [Submodule.span_le]
      rintro _ ⟨γ, u', hγ, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, hνinv γ hγ u', sub_self]
    exact hle hu

  have hg : (k ≫ h₁) ≫ H.w ≫ e.hom = (k ≫ h₂) ≫ H.w := by
    rw [he]; simp only [Category.assoc]
  apply hμv
  rw [← hv1, ← hφ V₁ (k ≫ h₂) (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom x) z₁,
    hN V₁ (k ≫ h₁) ((k ≫ h₂) ≫ H.w) hg (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom x) z₁]
  exact congrFun (hνR _ (hx1 z₁)) 0

theorem wc_honest_theta_le_of_coker_GC (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP) (U : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]))
    (hUR : U ≤ wcHonestRg H)
    (M : Subobject (wcRq D.f ℓ (n - 1)))
    (hM : ∀ (T : (wcP1Over F'').left.ProEt) (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
        (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔
      wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W H.N H.θ U T x)
    (M' : Subobject (wcRq D.f ℓ (n - 1)))
    (hM' : wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow)) :
    M ≤ M' :=
by
  classical

  have frame_linear : ∀ (S : Scheme.{u}) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (B W : S.ProEt) (w : W ⟶ B) (hW : ConnectedSpace W.left) (r b : ℕ)
      (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W)
      (φ : G.over B ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over B),
      ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]),
        (∀ (V : S.ProEt) (h' : V ⟶ W) (s : G.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin b → ℚ_[ℓ]) from
            ((φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s).down) z =
          A ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom s).down) z)) ∧
        ∀ (γ : W ⟶ W), γ ≫ w = w → ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
          A ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z) =
          A ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) := by
    intro S G B W w hW r b θ φ
    haveI := hW
    let φW : G.over W ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W :=
      ⟨{ app := fun T => φ.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ w)))
         naturality := fun X Y f => φ.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ w = Y.unop.hom ≫ w
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ w) ⟶ Over.mk (X.unop.hom ≫ w)).op }⟩
    have hcancel1 : ∀ (T : Over W) (s : (G.over W).obj.obj (Opposite.op T)),
        (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
      intro T s
      exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ W hW r b (θ.inv ≫ φW)
    have hPt : ∀ (T : Over W) (c : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from
          (((θ.inv ≫ φW).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    have hkey : ∀ (V : S.ProEt) (h' : V ⟶ W) (s : G.obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin b → ℚ_[ℓ]) from
          ((φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s).down) z =
        A ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom s).down) z) := by
      intro V h' s z
      let T : Over W := Over.mk h'
      have e1 : ((θ.inv ≫ φW).hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) =
          (φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s :=
        congrArg (φW.hom.app (Opposite.op T)).hom (hcancel1 T s)
      have h1 := hPt T ((θ.hom.hom.app (Opposite.op T)).hom s) z
      have h4 := congrArg (fun y : ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) => y.down z) e1
      exact h4.symm.trans h1
    refine ⟨A, hkey, ?_⟩
    intro γ hγ s z
    have k1 := hkey W γ s z
    have k2 := hkey W (𝟙 W) s z
    have e : ∀ u₁ u₂ : W ⟶ B, u₁ = u₂ →
        (show C(↥W.left, Fin b → ℚ_[ℓ]) from
          ((φ.hom.app (Opposite.op (Over.mk u₁))).hom s).down) z =
        (show C(↥W.left, Fin b → ℚ_[ℓ]) from
          ((φ.hom.app (Opposite.op (Over.mk u₂))).hom s).down) z := by
      rintro u₁ u₂ rfl
      rfl
    exact k1.symm.trans ((e _ _ (by rw [hγ, Category.id_comp])).trans k2)

  obtain ⟨b, ⟨ψ⟩⟩ := hM'
  let π := Limits.cokernel.π M'.arrow
  let Φ : (wcRq D.f ℓ (n - 1)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
      (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over (wcGeomPoint F'' (wcP1Over F'') hP) :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
      (wcGeomPoint F'' (wcP1Over F'') hP)).map π ≫ ψ.hom
  obtain ⟨A, hA1, hA2⟩ := frame_linear (wcP1Over F'').left (wcRq D.f ℓ (n - 1))
    (wcGeomPoint F'' (wcP1Over F'') hP) H.W H.w H.hconn H.N b H.θ Φ
  have hψc : ∀ (X : Over (wcGeomPoint F'' (wcP1Over F'') hP))
      (q : ((Limits.cokernel M'.arrow).over (wcGeomPoint F'' (wcP1Over F'') hP)).obj.obj
        (Opposite.op X)),
      (ψ.inv.hom.app (Opposite.op X)).hom ((ψ.hom.hom.app (Opposite.op X)).hom q) = q := by
    intro X q
    exact congrArg (fun m => (m.hom.app (Opposite.op X)).hom q) ψ.hom_inv_id
  have hθc2 : ∀ (T : Over H.W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).over H.W).obj.obj (Opposite.op T)),
      (H.θ.hom.hom.app (Opposite.op T)).hom ((H.θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) H.θ.inv_hom_id

  obtain ⟨z₀⟩ : Nonempty H.W.left := @ConnectedSpace.toNonempty _ _ H.hconn
  have hinv : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ v, A (H.fr γ v) = A v := by
    intro γ hγ v
    let c : (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).obj.obj (Opposite.op H.W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).obj.obj (Opposite.op H.W) from
        ULift.up (ContinuousMap.const ↥H.W.left v))
    let s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op H.W) :=
      (H.θ.inv.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom c
    have hs : (H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s = c :=
      hθc2 (Over.mk (𝟙 H.W)) c
    have hv : (show C(↥H.W.left, Fin H.N → ℚ_[ℓ]) from
        ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s).down) z₀ = v :=
      congrArg (fun y : ULift.{u+1} C(↥H.W.left, Fin H.N → ℚ_[ℓ]) => y.down z₀) hs
    have k := hA2 γ hγ s z₀
    have e1 := (H.hfr γ hγ s z₀).trans (congrArg (H.fr γ) hv)
    exact (congrArg A e1).symm.trans (k.trans (congrArg A hv))
  have hRgA : wcHonestRg H ≤ LinearMap.ker A := by
    unfold wcHonestRg
    rw [Submodule.span_le]
    rintro v ⟨γ, u', hγ, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, hinv γ hγ u', sub_self]
  have hUA : ∀ u' ∈ U, A u' = 0 := fun u' hu => LinearMap.mem_ker.mp (hRgA (hUR hu))

  have hs6 : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ H.W)
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (∀ z : V.left, (show C(↥V.left, Fin H.N → ℚ_[ℓ]) from
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) z ∈ U) →
      (π.hom.app (Opposite.op V)).hom y = 0 := by
    intro V h' y hy
    have hz : (ψ.hom.hom.app (Opposite.op (Over.mk (h' ≫ H.w)))).hom
        ((π.hom.app (Opposite.op V)).hom y) = 0 := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact (hA1 V h' y z).trans (hUA _ (hy z))
    exact (hψc (Over.mk (h' ≫ H.w)) ((π.hom.app (Opposite.op V)).hom y)).symm.trans
      ((congrArg (ψ.inv.hom.app (Opposite.op (Over.mk (h' ≫ H.w)))).hom hz).trans (map_zero _))

  have hs7 : ∀ (T : (wcP1Over F'').left.ProEt) (t : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W H.N H.θ U T y →
      (π.hom.app (Opposite.op T)).hom y = 0 := by
    intro T t y hy
    have hi : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ((Limits.cokernel M'.arrow).obj.map h.op).hom ((π.hom.app (Opposite.op T)).hom y) = 0 := by
      refine wc_proet_detect_through_cover F'' hP D.m D.S H.W H.w H.hqc H.hcov
        (Limits.cokernel M'.arrow) T t ((π.hom.app (Opposite.op T)).hom y) ?_
      intro V h h' _
      have hnat := congrArg (fun f => AddCommGrpCat.Hom.hom f y) (π.hom.naturality h.op)
      exact hnat.symm.trans (hs6 V h' _ (fun z => hy V h h' z))
    have hc : (ψ.hom.hom.app (Opposite.op (Over.mk t))).hom ((π.hom.app (Opposite.op T)).hom y) = 0 := by
      refine wc_P1_contSheaf_off_points_vanish F'' ℓ b D.m D.S D.hS T _ ?_
      intro V h hV
      have hnat := congrArg (fun f => AddCommGrpCat.Hom.hom f ((π.hom.app (Opposite.op T)).hom y))
        (ψ.hom.hom.naturality (Over.homMk h rfl : Over.mk (h ≫ t) ⟶ Over.mk t).op)
      refine hnat.symm.trans ?_
      exact (congrArg (ψ.hom.hom.app (Opposite.op (Over.mk (h ≫ t)))).hom (hi V h hV)).trans
        (map_zero _)
    exact (hψc (Over.mk t) _).symm.trans
      ((congrArg (ψ.inv.hom.app (Opposite.op (Over.mk t))).hom hc).trans (map_zero _))

  have hs4 : ∀ T : (wcP1Over F'').left.ProEt, ∃ (T' : (wcP1Over F'').left.ProEt) (k : T' ⟶ T)
      (_ : T' ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      QuasiCompact k.left ∧ ∀ p : T.left, ∃ z : T'.left, k.left z = p := by
    intro T
    haveI hg : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := hP
    haveI : QuasiCompact (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
    haveI : Surjective (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
    haveI hTp : WeaklyEtale T.hom := T.prop
    haveI : WeaklyEtale (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) := inferInstance
    haveI hkq : QuasiCompact (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) := inferInstance
    haveI : Surjective (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫ T.hom) :=
      inferInstance
    let T' : (wcP1Over F'').left.ProEt := Scheme.ProEt.mk
      (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫ T.hom)
    let k : T' ⟶ T := MorphismProperty.Over.homMk
      (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) rfl trivial
    have ht : Limits.pullback.snd T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
          Limits.pullback.fst (wcP1Over F'').hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫ T.hom :=
      Limits.pullback.condition.symm
    let t : T' ⟶ wcGeomPoint F'' (wcP1Over F'') hP := MorphismProperty.Over.homMk
      (Limits.pullback.snd T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) ht trivial
    refine ⟨T', k, t, hkq, ?_⟩
    intro p
    exact Scheme.Hom.surjective (Limits.pullback.fst T.hom (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) p

  have hs8 : ∀ (T : (wcP1Over F'').left.ProEt) (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W H.N H.θ U T y →
      (π.hom.app (Opposite.op T)).hom y = 0 := by
    intro T y hy
    obtain ⟨T', k, t, hqc, hsurj⟩ := hs4 T
    have hy' : wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W H.N H.θ U T'
        (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom y) := by
      intro V h h' z
      have e : ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom y) =
          ((wcRq D.f ℓ (n - 1)).obj.map (h ≫ k).op).hom y := by
        rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      have := hy V (h ≫ k) h' z
      rw [← e] at this
      exact this
    have h0 := hs7 T' t _ hy'
    have hq : ((Limits.cokernel M'.arrow).obj.map k.op).hom ((π.hom.app (Opposite.op T)).hom y) = 0 := by
      have hnat := congrArg (fun f => AddCommGrpCat.Hom.hom f y) (π.hom.naturality k.op)
      exact hnat.symm.trans h0
    have h1 := wc_proet_section_zero_of_qc_image (wcP1Over F'').left (Limits.cokernel M'.arrow)
      T T' k hqc ((π.hom.app (Opposite.op T)).hom y) hq T (𝟙 T) (by
        intro p
        obtain ⟨z, hz⟩ := hsurj p
        exact ⟨z, hz.trans (by first | rfl | simp)⟩)
    have e : ((Limits.cokernel M'.arrow).obj.map (𝟙 T).op).hom ((π.hom.app (Opposite.op T)).hom y) =
        (π.hom.app (Opposite.op T)).hom y := by
      rw [op_id, CategoryTheory.Functor.map_id]
      rfl
    exact e.symm.trans h1

  have hs9 : M.arrow ≫ π = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    show (π.hom.app T).hom ((M.arrow.hom.app T).hom x) = 0
    exact hs8 T.unop _ ((hM T.unop _).mp ⟨x, rfl⟩)

  have hK := Abelian.monoIsKernelOfCokernel
    (Limits.Cofork.ofπ (Limits.cokernel.π M'.arrow) (by simp)) (Limits.cokernelIsCokernel M'.arrow)
  obtain ⟨l, hl⟩ := Limits.KernelFork.IsLimit.lift' hK M.arrow hs9
  exact Subobject.le_of_comm l (by first | exact hl | simpa using hl)

theorem wc_proet_extend_of_local_extend (S : Scheme.{u}) (O : S.Opens) (B₀ : S.ProEt)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ) (Q : S.ProEt → Prop)
    (hQ : ∀ U : S.ProEt, Sieve.generate (fun (T : S.ProEt) (_ : T ⟶ U) => Q T) ∈
      Scheme.ProEt.topology S U)
    (hinj : ∀ (T : S.ProEt) (_ : T ⟶ B₀) (x : G.obj.obj (Opposite.op T)),
      (G.obj.map (wcOpenRestrIncl S O T).op).hom x = 0 → x = 0)
    (hloc : ∀ (T : S.ProEt), Q T → ∀ y : G.obj.obj (Opposite.op (wcOpenRestr S O T)),
      ∃ x : G.obj.obj (Opposite.op T), (G.obj.map (wcOpenRestrIncl S O T).op).hom x = N • y) :
    ∀ (T : S.ProEt) (_ : T ⟶ B₀) (y : G.obj.obj (Opposite.op (wcOpenRestr S O T))),
      ∃ x : G.obj.obj (Opposite.op T), (G.obj.map (wcOpenRestrIncl S O T).op).hom x = N • y :=
by
  classical

  have resComp : ∀ {V W T : S.ProEt} (h : V ⟶ W) (e : W ⟶ T) (z : G.obj.obj (Opposite.op T)),
      (G.obj.map (h ≫ e).op).hom z = (G.obj.map h.op).hom ((G.obj.map e.op).hom z) := by
    intro V W T h e z
    rw [op_comp, Functor.map_comp]
    rfl

  have L1 : ∀ (T T' : S.ProEt) (f : T' ⟶ T), ∃ f' : wcOpenRestr S O T' ⟶ wcOpenRestr S O T,
      f' ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ f := by
    intro T T' f
    have hcomm : Limits.pullback.fst O.ι T'.hom ≫ O.ι =
        (Limits.pullback.snd O.ι T'.hom ≫ f.left) ≫ T.hom := by
      rw [Limits.pullback.condition, Category.assoc, MorphismProperty.Over.w f]
    refine ⟨MorphismProperty.Over.homMk
      (Limits.pullback.lift (Limits.pullback.fst O.ι T'.hom)
        (Limits.pullback.snd O.ι T'.hom ≫ f.left) hcomm) ?_ trivial, ?_⟩
    · change Limits.pullback.lift _ _ hcomm ≫ (Limits.pullback.snd O.ι T.hom ≫ T.hom) =
          Limits.pullback.snd O.ι T'.hom ≫ T'.hom
      rw [← Category.assoc, Limits.pullback.lift_snd, Category.assoc, MorphismProperty.Over.w f]
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.lift _ _ hcomm ≫ Limits.pullback.snd O.ι T.hom =
          Limits.pullback.snd O.ι T'.hom ≫ f.left
      exact Limits.pullback.lift_snd _ _ _

  have L2 : ∀ {T Z : S.ProEt} (a b : Z ⟶ wcOpenRestr S O T),
      a ≫ wcOpenRestrIncl S O T = b ≫ wcOpenRestrIncl S O T → a = b := by
    intro T Z a b h
    apply MorphismProperty.Over.Hom.ext
    haveI : Mono (Limits.pullback.snd O.ι T.hom) := IsOpenImmersion.mono _
    have h1 : a.left ≫ Limits.pullback.snd O.ι T.hom = b.left ≫ Limits.pullback.snd O.ι T.hom :=
      congrArg (fun φ => φ.left) h
    exact (cancel_mono (Limits.pullback.snd O.ι T.hom)).1 h1
  choose lf hlf using L1

  have hC : ∀ {Z T' T : S.ProEt} (k : Z ⟶ T') (f : T' ⟶ T)
      (γ : wcOpenRestr S O Z ⟶ wcOpenRestr S O T),
      γ ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O Z ≫ k ≫ f → lf T' Z k ≫ lf T T' f = γ := by
    intro Z T' T k f γ h
    apply L2
    rw [Category.assoc, hlf, ← Category.assoc, hlf, Category.assoc, h]
  intro T g₀ y
  have hsh : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) G.obj
        (forget AddCommGrpCat.{u+1})).1 G.cond)
  have hloc' : ∀ (T' : S.ProEt) (f : T' ⟶ T), Q T' → ∃ x : G.obj.obj (Opposite.op T'),
      (G.obj.map (wcOpenRestrIncl S O T').op).hom x = N • (G.obj.map (lf T T' f).op).hom y :=
    fun T' f hf => hloc T' hf _
  choose xf hxf using hloc'

  have key : ∀ (Z T' : S.ProEt) (a : Z ⟶ T') (f : T' ⟶ T) (hf : Q T'),
      (G.obj.map (wcOpenRestrIncl S O Z).op).hom ((G.obj.map a.op).hom (xf T' f hf)) =
        N • (G.obj.map (lf T Z (a ≫ f)).op).hom y := by
    intro Z T' a f hf
    rw [← resComp, ← hlf, resComp, hxf, map_nsmul, ← resComp,
      hC a f (lf T Z (a ≫ f)) (by rw [hlf])]
  let fam : Presieve.FamilyOfElements (G.obj ⋙ forget AddCommGrpCat)
      (fun (T' : S.ProEt) (_ : T' ⟶ T) => Q T') := fun T' f hf => xf T' f hf
  have hcompat : fam.Compatible := by
    intro Y₁ Y₂ Z a₁ a₂ f₁ f₂ h₁ h₂ hcomm
    show (G.obj.map a₁.op).hom (xf Y₁ f₁ h₁) = (G.obj.map a₂.op).hom (xf Y₂ f₂ h₂)
    rw [← sub_eq_zero]
    apply hinj Z (a₁ ≫ f₁ ≫ g₀)
    rw [map_sub, key Z Y₁ a₁ f₁ h₁, key Z Y₂ a₂ f₂ h₂, hcomm, sub_self]
  have hS := hsh.isSheafFor (fun (T' : S.ProEt) (_ : T' ⟶ T) => Q T') (hQ T)
  have hglue : ∀ (T' : S.ProEt) (f : T' ⟶ T) (hf : Q T'),
      (G.obj.map f.op).hom (hS.amalgamate fam hcompat) = xf T' f hf :=
    fun T' f hf => hS.valid_glue hcompat f hf
  refine ⟨hS.amalgamate fam hcompat, ?_⟩
  have hS' := (hsh _ ((Scheme.ProEt.topology S).pullback_stable (wcOpenRestrIncl S O T)
    (hQ T))).isSeparatedFor
  apply hS'.ext
  intro Z γ hγ
  rw [Sieve.pullback_apply, Sieve.generate_apply] at hγ
  obtain ⟨T', k, f, hf, hkf⟩ := hγ
  show (G.obj.map γ.op).hom ((G.obj.map (wcOpenRestrIncl S O T).op).hom
      (hS.amalgamate fam hcompat)) = (G.obj.map γ.op).hom (N • y)
  rw [← resComp, ← hkf, resComp, hglue T' f hf, map_nsmul, ← sub_eq_zero]
  apply hinj Z (γ ≫ wcOpenRestrIncl S O T ≫ g₀)
  have e : lf T Z (k ≫ f) = wcOpenRestrIncl S O Z ≫ γ :=
    L2 _ _ (by rw [hlf, Category.assoc, hkf])
  rw [map_sub, key Z T' k f hf, map_nsmul, ← resComp, e, sub_self]

theorem wc_pencil_Rq_rat_extend_of_int (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q c : ℕ) (O : (wcP1Over F'').left.Opens)
    (T : (wcP1Over F'').left.ProEt) (hT : IsAffine T.left)
    (hInt : ∀ t : (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj
        (Opposite.op (wcOpenRestr (wcP1Over F'').left O T)),
      ∃ x : (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj
          (Opposite.op T),
        ((((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.map
