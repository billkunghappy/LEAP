  have hU : ((b ⁻¹ᵁ O : Xt.Opens) : Set Xt) = (Set.range iE)ᶜ := by
    rw [hE, Set.preimage_compl, compl_compl, Scheme.Hom.coe_preimage]
  have hOU : Nonempty ((O : Scheme.{u}) ≅ ((b ⁻¹ᵁ O : Xt.Opens) : Scheme.{u})) :=
    ⟨(asIso (b ∣_ O)).symm⟩
  have hmeet := wc_isp_resolution_components_meet K pY O hOne N Xt E (b ≫ pY) iE
    (b ⁻¹ᵁ O) hU hOU
  have h1 : Subsingleton (wcEtCoh ((b ⁻¹ᵁ O : Xt.Opens) : Scheme.{u}) ℓ (2 * N)) :=
    wc_et_smooth_proper_open_top_vanish_of_meets K Xt (b ≫ pY) N hN (b ⁻¹ᵁ O) hmeet ℓ
      (Fact.out) hℓ
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  have h2 := wc_et_coh_zmod_prime_pow_of_prime ((b ⁻¹ᵁ O : Xt.Opens) : Scheme.{u}) ℓ Fact.out
    (2 * N) h1 k'
  obtain ⟨e⟩ := wc_et_coh_iso_invariance (b ∣_ O) (ℓ ^ (k' + 1)) (2 * N)
  exact @Equiv.subsingleton _ _ e h2

theorem wc_et_tpl_odp_point_class_order (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
