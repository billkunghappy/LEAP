      {X : C} {B : D} {B' : E} (uP : B ⟶ P.obj X) (uw : X ⟶ Pw.obj X) (ν : B' ⟶ Q.obj B)
      (hunit : uP ≫ P.map uw ≫ γ.app X = uP)
      (m : Φw.obj X ≅ X) (hm : m.hom = (adj.homEquiv _ _).symm uw)
      (L : CochainComplex C ℤ) (t : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).obj L ⟶ L)
      (n : ℤ) (φ : (HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj X ⟶ L⟦n⟧),
      ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ν ≫ Q.map uP) ≫ (HomologicalComplex.singleMapHomologicalComplex (P ⋙ Q) (ComplexShape.up ℤ) 0).inv.app (X) ≫ ((P ⋙ Q).mapHomologicalComplex (ComplexShape.up ℤ)).map (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map m.inv ≫ (HomologicalComplex.singleMapHomologicalComplex Φw (ComplexShape.up ℤ) 0).inv.app (X) ≫ (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫ ((Φw.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫ t⟦n⟧')) ≫ (((P ⋙ Q).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫ ((Functor.mapHomologicalComplexCompIso (Iso.refl (P ⋙ Q)) (ComplexShape.up ℤ)).inv.app L)⟦n⟧') =
      ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ν ≫ Q.map uP) ≫ (HomologicalComplex.singleMapHomologicalComplex (P ⋙ Q) (ComplexShape.up ℤ) 0).inv.app (X) ≫ ((P ⋙ Q).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫ (((P ⋙ Q).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫ ((Functor.mapHomologicalComplexCompIso (Iso.refl (P ⋙ Q)) (ComplexShape.up ℤ)).inv.app L)⟦n⟧') ≫
        ((Q.mapHomologicalComplex (ComplexShape.up ℤ)).map
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app L ≫
              (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Φw ⋙ Pw from adj.unit)
                (ComplexShape.up ℤ)).app L ≫
              (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
                (ComplexShape.up ℤ)).inv.app L ≫
              (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t) ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
              (ComplexShape.up ℤ)).hom.app L ≫
            (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app L))⟦n⟧' := by
    intro C D E _ _ _ _ _ _ _ _ _ Φw Pw _ _ adj P _ γ Q _ X B B' uP uw ν hunit m hm L t n φ
    have hu : uw = adj.unit.app X ≫ Pw.map m.hom := by
      have h := adj.homEquiv_unit X X ((adj.homEquiv X X).symm uw)
      rw [Equiv.apply_symm_apply] at h
      rw [hm]
      exact h
    have ha : uP ≫ P.map (adj.unit.app X) ≫ γ.app (Φw.obj X) = uP ≫ P.map m.inv := by
      have hn := γ.naturality m.hom
      rw [Functor.comp_map] at hn
      have h2 : uP ≫ P.map (adj.unit.app X) ≫ γ.app (Φw.obj X) ≫ P.map m.hom = uP := by
        rw [← hn, ← P.map_comp_assoc, ← hu, hunit]
      calc uP ≫ P.map (adj.unit.app X) ≫ γ.app (Φw.obj X)
          = (uP ≫ P.map (adj.unit.app X) ≫ γ.app (Φw.obj X) ≫ P.map m.hom) ≫ P.map m.inv := by
            rw [Category.assoc, Category.assoc, Category.assoc, ← P.map_comp, Iso.hom_inv_id,
              P.map_id, Category.comp_id]
        _ = uP ≫ P.map m.inv := by rw [h2]
    have hstar : ∀ {Y : C} (x0 : X ⟶ Y) (tp : Φw.obj Y ⟶ Y),
        uP ≫ P.map (m.inv ≫ Φw.map x0 ≫ tp) =
          uP ≫ P.map x0 ≫ P.map (adj.unit.app Y ≫ Pw.map tp) ≫ γ.app Y := by
      intro Y x0 tp
