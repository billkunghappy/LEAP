    rw [resComp, hx W e hW, map_zero, map_zero]

  have s5 : ∀ (U : (wcP1Over F'').left.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
      (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      (∀ s : c.pt.obj.obj (Opposite.op U), ∃ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op U)),
        ((c.ι.app n).hom.app (Opposite.op U)).hom t = s) ∧
