      have e5 : g₁.left z = Wo.ι (g.left z) := by
        rw [hg₁]
        exact comp_ap _ _ _
      rw [e4, e5]
      have h0 : Wo.ι (g.left z) ∈ Set.range Wo.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at h0)
    rw [hd, map_sub, map_nsmul, ← resComp, ← resComp, hg₀, hkey, sub_eq_zero] at hv
