    obtain ⟨hf, hc'⟩ := wc_et_coh_card_le_prime_pow _ ℓ hp 1 hfin hk1.le k hk
    obtain ⟨eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) :
        MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))) (ℓ ^ k) 1
    exact ⟨Finite.of_equiv _ eq.symm, by rw [Nat.card_congr eq]; exact hc'⟩
  obtain ⟨hfinG, hcG⟩ := hcardG
  haveI := hfinG
  obtain ⟨ω, hω⟩ := wc_et_laurent_zmodext_one_strict (IsLocalRing.ResidueField A) ℓ hℓκ k hk
  have hord : addOrderOf ω = ℓ ^ k := by
    have hdvd : addOrderOf ω ∣ ℓ ^ k := addOrderOf_dvd_of_nsmul_eq_zero (s4 _ _ _ ω)
    obtain ⟨t, ht, hto⟩ := (Nat.dvd_prime_pow hp).mp hdvd
    have htk : t = k := by
