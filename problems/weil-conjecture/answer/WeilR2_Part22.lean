    obtain ⟨Dξ⟩ := wc_et_zmod_pull_data_exists ξ' m

    have hξf : ξ' ≫ Limits.pullback.fst g a = Limits.pullback.fst g (wcEtGeomPt B η) :=
      Limits.pullback.lift_fst _ _ _
    have hξs : ξ' ≫ Limits.pullback.snd g a = Limits.pullback.snd g (wcEtGeomPt B η) ≫ ξ :=
      Limits.pullback.lift_snd _ _ _
    have httf : ∀ N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B),
