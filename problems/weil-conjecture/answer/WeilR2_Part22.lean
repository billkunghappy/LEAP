          (homOfLE hm) =
        (ℓ ^ m : ℕ) • 𝟙 (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)) :=
      (Functor.comp_map _ _ _).trans
        ((congrArg (fun z => ((wcProEtPush g).rightDerived q).map z) (htr m hm)).trans k2)
    have hgm' : γ ≫ ((ℓ ^ m : ℕ) • 𝟙 (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ)))
