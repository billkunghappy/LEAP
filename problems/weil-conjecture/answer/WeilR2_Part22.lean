          show Limits.pullback.fst x.left w.left z ∉ (Limits.pullback.fst x.left w.left) '' K
          rw [hz]; exact hy
        · rintro ⟨z, hz, rfl⟩
          exact hz
      have hcl : IsClopen ((Limits.pullback.fst x.left w.left) '' K) := by
        refine ⟨hclosed K hK.isClosed, ?_⟩
