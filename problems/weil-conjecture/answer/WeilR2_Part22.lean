  refine ⟨wcEtOpen (wcP1Over K).left W Wo, wcEtOpenι (wcP1Over K).left W Wo ≫ f,
    (G.obj.map (wcEtOpenι (wcP1Over K).left W Wo).op).hom x, ?_, ?_⟩
  · obtain ⟨v, hv⟩ : w ∈ Set.range Wo.ι := by
      rw [Scheme.Opens.range_ι]
