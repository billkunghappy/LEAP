theorem wc_quad_cone_vertex_supp_card_of_punct : ∀ (K : Type u) [Field K] [IsSepClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : K) ≠ 0 → ∀ (n : ℕ), 1 ≤ n → ∀ (c : Matrix (Fin n) (Fin n) K) (Oc : (Spec (.of (wcQuadModelRing K n 0 c))).Opens), (Oc : Set (Spec (.of (wcQuadModelRing K n 0 c)))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∉ y.asIdeal} → ∀ (M : ℕ), Finite (wcEtCoh (Oc : Scheme.{u}) ℓ (n - 1)) → Nat.card (wcEtCoh (Oc : Scheme.{u}) ℓ (n - 1)) ≤ M → ∀ (Ω : Type u) [Field Ω] (i : Spec (.of Ω) ⟶ Spec (.of (wcQuadModelRing K n 0 c))) [IsClosedImmersion i], (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (i (IsLocalRing.closedPoint Ω))) → ∀ (k : ℕ), 1 ≤ k → ∀ (D : wcEtPullData i (ℓ ^ k)), Finite (wcEtSuppExt D n) ∧ Nat.card (wcEtSuppExt D n) ≤ M ^ k :=
by
  intro K _ _ ℓ _ hℓ n hn c Oc hOc M hfinOc hM Ω _ i _ hvert k hk D
  have hp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hp.pos
  have hrange : Set.range Oc.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι, hOc]
    ext y
    constructor
    · rintro ⟨p, hp'⟩ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      subst hz
      exact hp' (hvert p)
    · intro hy
      by_contra h
      have h' : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K n 0 c) (MvPolynomial.X p) ∈ y.asIdeal := by
        intro p
        by_contra hq
        exact h ⟨p, hq⟩
      have hyv := (wc_lup_quad_cone_vertex K n c).1 y (i (IsLocalRing.closedPoint Ω)) h' hvert
      exact hy ⟨_, hyv.symm⟩
  have hlev : ∀ D₁ : wcEtPullData i ℓ, Finite (wcEtSuppExt D₁ n) ∧
      Nat.card (wcEtSuppExt D₁ n) ≤ M := by
    intro D₁
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists Oc.ι ℓ
    have h1 : Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing K n 0 c))) ℓ (n - 1 + 1)) :=
      (wc_et_quadric_cone_acyclic K ℓ hp hℓ n c).2 (n - 1 + 1) (by omega)
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing K n 0 c))) ℓ (n - 1 + 1)
    haveI := E.subsingleton
    have hinj : Function.Injective (wcEtPull Dj (n - 1 + 1)) := Function.injective_of_subsingleton _
    obtain ⟨E'⟩ := wc_et_zmodext_coh_equiv (Oc : Scheme.{u}) ℓ (n - 1)
    haveI := hfinOc
    haveI hfin : Finite (wcEtZModExt (Oc : Scheme.{u}) ℓ (n - 1)) := Finite.of_equiv _ E'.symm
    have hcard' : Nat.card (wcEtZModExt (Oc : Scheme.{u}) ℓ (n - 1)) ≤ M :=
      (Nat.card_congr E').trans_le hM
    letI := Fintype.ofFinite (wcEtZModExt (Oc : Scheme.{u}) ℓ (n - 1))
    have hT : ∃ T : Finset (wcEtZModExt (Oc : Scheme.{u}) ℓ (n - 1)),
        T.card ≤ M ∧ ∀ y : wcEtZModExt (Oc : Scheme.{u}) ℓ (n - 1),
          ∃ t ∈ T, ∃ w : wcEtZModExt (Spec (.of (wcQuadModelRing K n 0 c))) ℓ (n - 1),
            y = t + wcEtPull Dj (n - 1) w := by
      refine ⟨Finset.univ, ?_, ?_⟩
      · rw [Finset.card_univ, ← Nat.card_eq_fintype_card]; exact hcard'
      · intro y
        exact ⟨y, Finset.mem_univ y, 0, by rw [map_zero, add_zero]⟩
    have H := wc_et_supp_card_of_restr i Oc.ι hrange ℓ hℓpos D₁ Dj (n - 1) M hinj hT
    have e : n - 1 + 1 = n := by omega
    rw [e] at H
    exact H
  exact wc_et_supp_ext_card_pow_of_prime i ℓ k hk n M hlev D

theorem wc_hyp_node_cone_punct_h1_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : K) ≠ 0 → ∀ (Oh : (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 (Matrix.of fun p q : Fin (0 + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens), (Oh : Set (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 (Matrix.of fun p q : Fin (0 + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (0 + 1 + 1) 0 (Matrix.of fun p q : Fin (0 + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} → Finite (wcEtCoh (Oh : Scheme.{u}) ℓ 1) ∧ Nat.card (wcEtCoh (Oh : Scheme.{u}) ℓ 1) ≤ ℓ * ℓ :=
by
  intro K _ _ ℓ _ hℓ Oh hOh
  classical

  have hsubs : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY m q
    have s1 : ∀ U : Y.Etale, IsEmpty U.left := fun U => ⟨fun x => hY.false (U.hom.base x)⟩
    have s2 : ∀ U : Y.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Y U := by
      intro U
      change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Y U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 U).false x).elim
    have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, Limits.IsZero G := by
      intro G
      have h : Limits.IsZero G.obj :=
        Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) G h
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    haveI := hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB
    unfold wcEtCoh
    infer_instance

  let c : Matrix (Fin (0 + 1 + 1)) (Fin (0 + 1 + 1)) K := Matrix.of fun p q : Fin (0 + 1 + 1) =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0
  have hc : c = Matrix.of fun p q : Fin (0 + 1 + 1) =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 := rfl
  let I := wcQuadModelIdeal K (0 + 1 + 1) 0 c

  have hg : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C 0 : MvPolynomial (Fin (0 + 1 + 1)) K) =
      MvPolynomial.X 0 * MvPolynomial.X 1 := by
    simp [hc, Fin.sum_univ_two, Matrix.of_apply]
  have hI_def : I = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} := by
    show Ideal.span {(∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C 0 : MvPolynomial (Fin (0 + 1 + 1)) K)} = _
    rw [hg]
  have h01 : Ideal.Quotient.mk I (MvPolynomial.X 0) * Ideal.Quotient.mk I (MvPolynomial.X 1) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hI_def]
    exact Ideal.subset_span rfl

  have hopen : ∀ p : Fin (0 + 1 + 1), IsOpen {y : PrimeSpectrum (wcQuadModelRing K (0 + 1 + 1) 0 c) |
      Ideal.Quotient.mk I (MvPolynomial.X p) ∉ y.asIdeal} := fun p =>
    (PrimeSpectrum.basicOpen (Ideal.Quotient.mk I (MvPolynomial.X p))).isOpen
  let A : (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 c))).Opens :=
    ⟨{y | Ideal.Quotient.mk I (MvPolynomial.X 0) ∉ y.asIdeal}, hopen 0⟩
  let B : (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 c))).Opens :=
    ⟨{y | Ideal.Quotient.mk I (MvPolynomial.X 1) ∉ y.asIdeal}, hopen 1⟩
  have hsup : A ⊔ B = Oh := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_sup]
    refine Eq.trans ?_ hOh.symm
    ext y
    show (Ideal.Quotient.mk I (MvPolynomial.X 0) ∉ y.asIdeal ∨
      Ideal.Quotient.mk I (MvPolynomial.X 1) ∉ y.asIdeal) ↔
      ∃ p, Ideal.Quotient.mk I (MvPolynomial.X p) ∉ y.asIdeal
    constructor
    · rintro (h | h)
      · exact ⟨0, h⟩
      · exact ⟨1, h⟩
    · rintro ⟨p, hp⟩
      have hp2 : p = 0 ∨ p = 1 := by
        rcases p with ⟨_ | _ | n, hn⟩
        · left; rfl
        · right; rfl
        · exact absurd hn (by omega)
      rcases hp2 with rfl | rfl
      · exact Or.inl hp
      · exact Or.inr hp
  have hempty : IsEmpty ((A ⊓ B : (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 c))).Opens) :
      Scheme.{u}) := by
    refine ⟨fun z => ?_⟩
    have hz : (A ⊓ B).ι.base z ∈ Set.range (A ⊓ B).ι.base := Set.mem_range_self z
    rw [Scheme.Opens.range_ι] at hz
    have hz' := TopologicalSpace.Opens.mem_inf.mp hz
    have h1 : Ideal.Quotient.mk I (MvPolynomial.X 0) ∉ ((A ⊓ B).ι.base z).asIdeal := hz'.1
    have h2 : Ideal.Quotient.mk I (MvPolynomial.X 1) ∉ ((A ⊓ B).ι.base z).asIdeal := hz'.2
    have h0 := ((A ⊓ B).ι.base z).asIdeal.zero_mem
    rw [← h01] at h0
    rcases ((A ⊓ B).ι.base z).isPrime.mem_or_mem h0 with h | h
    · exact h1 h
    · exact h2 h

  haveI h0sub := hsubs _ hempty ℓ 0
  have h0fin : Finite (wcEtCoh ((A ⊓ B : (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 c))).Opens) :
      Scheme.{u}) ℓ 0) := Finite.of_subsingleton
  have h0card : Nat.card (wcEtCoh ((A ⊓ B : (Spec (.of (wcQuadModelRing K (0 + 1 + 1) 0 c))).Opens) :
      Scheme.{u}) ℓ 0) ≤ 1 := Finite.card_le_one_iff_subsingleton.mpr h0sub

  have hWopen : IsOpen (Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (0 + 1)) K →+* K))))ᶜ := by
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin (0 + 1)) K →+* K))) :=
      IsClosedImmersion.spec_of_surjective _
        (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
    exact (Scheme.Hom.isClosedEmbedding _).isClosed_range.isOpen_compl
  let W : (Spec (.of (MvPolynomial (Fin (0 + 1)) K))).Opens := ⟨_, hWopen⟩
  obtain ⟨eA⟩ := wc_hyp_quad_cone_even_open_coh_equiv K ℓ hℓ 0 A (by
    ext y
    constructor
    · intro h
      exact ⟨0, h⟩
    · rintro ⟨k, hk⟩
      obtain rfl : k = 0 := Fin.fin_one_eq_zero k
      exact hk) W rfl 1
  obtain ⟨hWfin, hWcard⟩ := wc_et_punctured_affine_coh_card_le K 1 le_rfl ℓ Fact.out hℓ W rfl
  haveI : Finite (wcEtCoh (W : Scheme.{u}) ℓ 1) := hWfin
  have hAfin : Finite (wcEtCoh (A : Scheme.{u}) ℓ 1) := Finite.of_equiv _ eA.symm
  have hAcard : Nat.card (wcEtCoh (A : Scheme.{u}) ℓ 1) ≤ ℓ := (Nat.card_congr eA).trans_le hWcard

  let σ : MvPolynomial (Fin (0 + 1 + 1)) K ≃ₐ[K] MvPolynomial (Fin (0 + 1 + 1)) K :=
    MvPolynomial.renameEquiv K (Equiv.swap 0 1)
  have hσX0 : σ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
    simp [σ, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
