        (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom q' → q = q' := by
    intro V h' q q' hq
    have e0 : ∀ q₀ : X.obj.obj (Opposite.op V),
        (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom q₀) = q₀ := fun q₀ =>
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom q₀) θ.hom_inv_id
    rw [← e0 q, hq, e0 q']

  have hmono : ∀ (b : ℕ) (B : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r₁ + r₂) → ℚ_[ℓ])),
      Function.Injective (A ∘ₗ B) → Mono ((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ) := by
    intro b B hB
    apply Functor.mono_of_mono_map (sheafToPresheaf _ _)
    have hcomp : ∀ T'', Mono (((sheafToPresheaf _ _).map
        ((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ)).app T'') := by
      intro T''
      obtain ⟨T'⟩ := T''
      rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
      intro s hs
      apply hC b T'.left T'.hom s
      intro V h h' hh
      have e1 := star2 b B T' s V h h' hh
      have hs' : (((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ).hom.app (Opposite.op T')).hom s = 0 :=
        hs
      have hz : ∀ y : X.obj.obj (Opposite.op T'.left), y = 0 →
          (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((X.obj.map h.op).hom y) = 0 := by
        intro y hy
        subst hy
        have hm0 : (X.obj.map h.op).hom (0 : X.obj.obj (Opposite.op T'.left)) = 0 := map_zero _
        rw [hm0]
        first
          | exact (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom.map_zero
          | exact map_zero (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          | simp
      have e0 := hz _ hs'
      have e3 := e1.symm.trans e0
      apply hext
      intro z
      apply hB
      have h1 := congrArg (fun y => wcContEval (wcP1Over K).left V y z) e3
      exact h1.trans ((hev0 V z).trans ((map_zero (A ∘ₗ B)).symm.trans
        (congrArg (A ∘ₗ B) (hev0 V z).symm)))
    haveI := hcomp
    exact NatTrans.mono_of_mono_app _

  have hEq : ∀ (b : ℕ) (B B' : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r₁ + r₂) → ℚ_[ℓ])),
      A ∘ₗ B = A ∘ₗ B' →
      (wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ = (wcSupRho K hP).map (wcSupLin K ℓ B') ≫ Φ := by
    intro b B B' hBB
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T''
    obtain ⟨T'⟩ := T''
    apply AddCommGrpCat.ext
    intro s
    have key : ∀ y y' : X.obj.obj (Opposite.op T'.left),
        (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T'.left) (h' : V ⟶ W), h' ≫ w = h ≫ T'.hom →
          (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((X.obj.map h.op).hom y) =
          (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((X.obj.map h.op).hom y')) →
        y = y' := by
      intro y y' H
      apply sub_eq_zero.mp
      apply hX T'.left T'.hom
      intro V h h' hh
      rw [map_sub, sub_eq_zero]
      exact hθinj V h' _ _ (H V h h' hh)
    exact key ((((wcSupRho K hP).map (wcSupLin K ℓ B) ≫ Φ).hom.app (Opposite.op T')).hom s)
      ((((wcSupRho K hP).map (wcSupLin K ℓ B') ≫ Φ).hom.app (Opposite.op T')).hom s)
      (fun V h h' hh => by
        have e1 := star2 b B T' s V h h' hh
        have e2 := star2 b B' T' s V h h' hh
        rw [hBB] at e1
        exact e1.trans e2.symm)

  obtain ⟨Cs, hCs⟩ := Submodule.exists_isCompl (LinearMap.ker A)
  let c := Module.finrank ℚ_[ℓ] Cs
  let eC' : (Fin c → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] Cs :=
    LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
  let ι : (Fin c → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r₁ + r₂) → ℚ_[ℓ]) := Cs.subtype ∘ₗ eC'.toLinearMap
  let pr : (Fin (r₁ + r₂) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin c → ℚ_[ℓ]) :=
    eC'.symm.toLinearMap ∘ₗ Submodule.linearProjOfIsCompl Cs (LinearMap.ker A) hCs.symm
  have hinj : Function.Injective (A ∘ₗ ι) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have h1 : ((eC' x : Cs) : Fin (r₁ + r₂) → ℚ_[ℓ]) ∈ LinearMap.ker A := LinearMap.mem_ker.mpr hx
    have h3 : ((eC' x : Cs) : Fin (r₁ + r₂) → ℚ_[ℓ]) = 0 :=
      (Submodule.disjoint_def.mp hCs.disjoint) _ h1 (eC' x).2
    have h4 : eC' x = 0 := Subtype.ext h3
    exact eC'.injective (h4.trans eC'.map_zero.symm)
  have hAιπ : A ∘ₗ (ι ∘ₗ pr) = A ∘ₗ LinearMap.id := by
    apply LinearMap.ext
    intro v
    show A (ι (pr v)) = A v
    have hιπ : ι (pr v) =
        (Submodule.linearProjOfIsCompl Cs (LinearMap.ker A) hCs.symm v :
          Fin (r₁ + r₂) → ℚ_[ℓ]) := by
      show ((eC' (eC'.symm _) : Cs) : Fin (r₁ + r₂) → ℚ_[ℓ]) = _
      rw [LinearEquiv.apply_symm_apply]
    have hy : Submodule.linearProjOfIsCompl Cs (LinearMap.ker A) hCs.symm
        ((Submodule.linearProjOfIsCompl Cs (LinearMap.ker A) hCs.symm v : Cs) :
          Fin (r₁ + r₂) → ℚ_[ℓ]) =
        Submodule.linearProjOfIsCompl Cs (LinearMap.ker A) hCs.symm v :=
      Submodule.linearProjOfIsCompl_apply_left hCs.symm _
    have hK0 : v - ι (pr v) ∈ LinearMap.ker
        (Submodule.linearProjOfIsCompl Cs (LinearMap.ker A) hCs.symm) := by
      rw [LinearMap.mem_ker, map_sub, hιπ, hy, sub_self]
    have hK0' : v - ι (pr v) ∈ LinearMap.ker A :=
      (Submodule.linearProjOfIsCompl_ker hCs.symm).le hK0
    have hK1 := LinearMap.mem_ker.mp hK0'
    rw [map_sub, sub_eq_zero] at hK1
    exact hK1.symm

  obtain ⟨α, hαdef⟩ : ∃ α : (wcContSheaf (wcP1Over K).left (Fin c → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP) ⟶
        (Subobject.underlying.obj M).over (wcGeomPoint K (wcP1Over K) hP),
      α = (wcSupRho K hP).map (wcSupLin K ℓ ι) ≫ Φ' := ⟨_, rfl⟩
  have hαΨ : α ≫ (wcSupRho K hP).map M.arrow = (wcSupRho K hP).map (wcSupLin K ℓ ι) ≫ Φ := by
    rw [hαdef, Category.assoc, hΦ]
  haveI hΨmono := hmono c ι hinj
  haveI hαmono : Mono α := mono_of_mono_fac hαΨ
  have hπα : (wcSupRho K hP).map (wcSupLin K ℓ pr) ≫ α = Φ' := by
    rw [← cancel_mono ((wcSupRho K hP).map M.arrow)]
    rw [Category.assoc, hαΨ, ← Category.assoc, ← Functor.map_comp,
      hLin pr ι (ι ∘ₗ pr) (fun _ => rfl), hEq _ (ι ∘ₗ pr) LinearMap.id hAιπ,
      hLinId _ (fun _ => rfl), CategoryTheory.Functor.map_id, Category.id_comp, hΦ]
  haveI hαepi : Epi α := epi_of_epi_fac hπα
  haveI : IsIso α := isIso_of_mono_of_epi α
  exact ⟨c, ⟨(asIso α).symm⟩⟩

theorem wc_pencil_GC_max_exists (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
      wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) ∧
      ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
        wcPencilGC F'' hP ℓ (Subobject.underlying.obj M') → M' ≤ M :=
by
  classical

  obtain ⟨W, w, N, hqc, hWconn, hsurj, ⟨θ⟩⟩ :=
    wc_pencil_Rq_connected_trivialization_all_q F' F'' Y n D ℓ hℓ hP (n - 1)

  have hX : ∀ (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom x = 0) → x = 0 := by
    intro T g x H
    exact wc_pencil_Rq_no_punctual_sections F' F'' Y n hn hn2 D ℓ hℓ hP T g x
      (wc_proet_detect_through_cover F'' hP D.m D.S W w hqc hsurj (wcRq D.f ℓ (n - 1)) T g x H)
  have hC : ∀ (a : ℕ) (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (x : (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        ((wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.map h.op).hom x = 0) → x = 0 := by
    intro a T g x H
    exact wc_P1_contSheaf_off_points_vanish F'' ℓ a D.m D.S D.hS T x
      (wc_proet_detect_through_cover F'' hP D.m D.S W w hqc hsurj _ T g x H)

  have supStable : ∀ (M₁ M₂ S : Subobject (wcRq D.f ℓ (n - 1))), M₁ ≤ S → M₂ ≤ S →
      (∀ M'' : Subobject (wcRq D.f ℓ (n - 1)), M₁ ≤ M'' → M₂ ≤ M'' → S ≤ M'') →
      wcPencilStable D ℓ M₁ → wcPencilStable D ℓ M₂ → wcPencilStable D ℓ S := by
    intro M₁ M₂ S h1S h2S hlub h₁ h₂ c
    obtain ⟨ψ₁, hψ₁⟩ := h₁ c
    obtain ⟨ψ₂, hψ₂⟩ := h₂ c
    have key : ∀ (M : Subobject (wcRq D.f ℓ (n - 1))) (hM : M ≤ S)
        (ψ : Subobject.underlying.obj M ⟶ Subobject.underlying.obj M),
        ψ ≫ M.arrow = M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c →
        M ≤ Subobject.mk (Limits.pullback.snd S.arrow (wcRqScalar D.f ℓ (n - 1) c)) := by
      intro M hM ψ hψ
      refine Subobject.le_mk_of_comm
        (Limits.pullback.lift (ψ ≫ Subobject.ofLE M S hM) M.arrow ?_) ?_
      · rw [Category.assoc, Subobject.ofLE_arrow, hψ]
      · exact Limits.pullback.lift_snd _ _ _
    have hle : S ≤ Subobject.mk (Limits.pullback.snd S.arrow (wcRqScalar D.f ℓ (n - 1) c)) :=
      hlub _ (key M₁ h1S ψ₁ hψ₁) (key M₂ h2S ψ₂ hψ₂)
    refine ⟨Subobject.ofLEMk S
      (Limits.pullback.snd S.arrow (wcRqScalar D.f ℓ (n - 1) c)) hle ≫
        Limits.pullback.fst S.arrow (wcRqScalar D.f ℓ (n - 1) c), ?_⟩
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, Subobject.ofLEMk_comp]

  have hι : Limits.kernel.ι (𝟙 (wcRq D.f ℓ (n - 1))) = 0 := by
    simpa using Limits.kernel.condition (𝟙 (wcRq D.f ℓ (n - 1)))
  have hZk : Limits.IsZero (Limits.kernel (𝟙 (wcRq D.f ℓ (n - 1)))) := by
    haveI : Mono (0 : Limits.kernel (𝟙 (wcRq D.f ℓ (n - 1))) ⟶ wcRq D.f ℓ (n - 1)) := by
      rw [← hι]; infer_instance
    exact Limits.IsZero.of_mono_zero (Limits.kernel (𝟙 (wcRq D.f ℓ (n - 1)))) (wcRq D.f ℓ (n - 1))
  let Z : Subobject (wcRq D.f ℓ (n - 1)) := Subobject.mk (Limits.kernel.ι (𝟙 (wcRq D.f ℓ (n - 1))))
  have hbotZ : Limits.IsZero (Subobject.underlying.obj Z) :=
    hZk.of_iso (Subobject.underlyingIso _)
  have botStable : wcPencilStable D ℓ Z := by
    intro c
    exact ⟨0, hbotZ.eq_of_src _ _⟩
  have botGC : wcPencilGC F'' hP ℓ (Subobject.underlying.obj Z) := by
    refine ⟨0, ⟨Limits.IsZero.iso ?_ ?_⟩⟩
    · apply Limits.IsZero.of_full_of_faithful_of_isZero (sheafToPresheaf _ AddCommGrpCat.{u+1})
      apply Functor.isZero
      intro T
      have h1 : Limits.IsZero ((sheafToPresheaf (Scheme.ProEt.topology (wcP1Over F'').left)
          AddCommGrpCat.{u+1}).obj (Subobject.underlying.obj Z)) :=
        Functor.map_isZero _ hbotZ
      first
        | exact h1.obj _
        | exact h1.obj (Opposite.op T.unop.left)
    · apply Limits.IsZero.of_full_of_faithful_of_isZero (sheafToPresheaf _ AddCommGrpCat.{u+1})
      apply Functor.isZero
      intro T
      refine @AddCommGrpCat.isZero_of_subsingleton _ ⟨fun a b => ?_⟩
      first
        | exact ULift.ext _ _ (ContinuousMap.ext fun t => funext fun i => i.elim0)
        | (apply ULift.ext
           apply ContinuousMap.ext
           intro t
           funext i
           exact i.elim0)
        | (cases a
           cases b
           congr 1
           ext t i
           exact i.elim0)
        | (apply ULift.ext
           apply ContinuousMap.ext
           intro t
           exact Subsingleton.elim _ _)
        | (ext t i
           exact i.elim0)

  let Pk : ℕ → Prop := fun k => ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
    Nonempty ((Subobject.underlying.obj M).over (wcGeomPoint F'' (wcP1Over F'') hP) ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over (wcGeomPoint F'' (wcP1Over F'') hP))
  obtain ⟨r0, hr0⟩ := botGC
  have hr0N : r0 ≤ N :=
    wc_geomConst_rank_bound F'' hP ℓ _ W w hWconn N θ Z r0 hr0
  have hP0 : Pk r0 := ⟨Z, botStable, hr0⟩
  obtain ⟨M₀, hM₀s, hM₀gc⟩ : Pk (Nat.findGreatest Pk N) := Nat.findGreatest_spec hr0N hP0

  refine ⟨M₀, hM₀s, ⟨_, hM₀gc⟩, ?_⟩
  intro M' hM's hM'gc
  obtain ⟨S, h0S, h'S, hlub, s, hs⟩ :=
    wc_geomConst_sup_closed F'' hP ℓ _ W w hWconn N θ hX hC M₀ M' ⟨_, hM₀gc⟩ hM'gc
  have hss : wcPencilStable D ℓ S := supStable M₀ M' S h0S h'S hlub hM₀s hM's
  have hsN : s ≤ N := wc_geomConst_rank_bound F'' hP ℓ _ W w hWconn N θ S s hs
  have hsk : s ≤ Nat.findGreatest Pk N := Nat.le_findGreatest hsN ⟨_, hss, hs⟩
  exact h'S.trans
    (wc_geomConst_subobject_le_of_rank F'' hP ℓ _ M₀ S h0S _ s hsk hM₀gc hs)

theorem wc_pencil_EC_geomConst (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    : wcPencilGC F'' hP ℓ (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) :=
by
  classical

  have transport : ∀ {G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}}, (G ≅ G') → wcPencilGC F'' hP ℓ G → wcPencilGC F'' hP ℓ G' := by
    intro G G' e hG
    obtain ⟨r, ⟨θ⟩⟩ := hG
    exact ⟨r, ⟨(((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
      (wcGeomPoint F'' (wcP1Over F'') hP)).mapIso e).symm ≪≫ θ⟩⟩

  have s1 : ∀ (E C : Subobject (wcRq D.f ℓ (n - 1))),
      Nonempty (Subobject.underlying.obj (E ⊓ C) ≅
        Limits.kernel (C.arrow ≫ Limits.cokernel.π E.arrow)) := by
    intro E C
    obtain ⟨φ, hφ⟩ : ∃ φ, φ = C.arrow ≫ Limits.cokernel.π E.arrow := ⟨_, rfl⟩
    rw [← hφ]
    have hIE : Subobject.ofLE (E ⊓ C) E inf_le_left ≫ E.arrow = (E ⊓ C).arrow :=
      Subobject.ofLE_arrow _
    have hIC : Subobject.ofLE (E ⊓ C) C inf_le_right ≫ C.arrow = (E ⊓ C).arrow :=
      Subobject.ofLE_arrow _
    have h1 : Subobject.ofLE (E ⊓ C) C inf_le_right ≫ φ = 0 := by
      rw [hφ, ← Category.assoc, hIC, ← hIE, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have hEk := Abelian.monoIsKernelOfCokernel _ (Limits.cokernelIsCokernel E.arrow)
    have h2 : (Limits.kernel.ι φ ≫ C.arrow) ≫ Limits.cokernel.π E.arrow = 0 := by
      rw [Category.assoc, ← hφ, Limits.kernel.condition]
    obtain ⟨l, hl⟩ := Limits.KernelFork.IsLimit.lift' hEk _ h2
    have hfE : E.Factors (Limits.kernel.ι φ ≫ C.arrow) := by
      rw [← hl]; exact Subobject.factors_comp_arrow l
    have hfac : (E ⊓ C).Factors (Limits.kernel.ι φ ≫ C.arrow) :=
      (Subobject.inf_factors _).mpr ⟨hfE, Subobject.factors_comp_arrow _⟩
    refine ⟨{ hom := Limits.kernel.lift φ (Subobject.ofLE (E ⊓ C) C inf_le_right) h1
              inv := (E ⊓ C).factorThru _ hfac
              hom_inv_id := ?_
              inv_hom_id := ?_ }⟩
    · rw [← cancel_mono (E ⊓ C).arrow]
      simp only [Category.assoc, Subobject.factorThru_arrow, Limits.kernel.lift_ι_assoc, hIC,
        Category.id_comp]
    · rw [← cancel_mono (Limits.kernel.ι φ), ← cancel_mono C.arrow]
      simp only [Category.assoc, Limits.kernel.lift_ι_assoc, hIC, Subobject.factorThru_arrow,
        Category.id_comp]

  have hC := wc_pencil_GC_max_exists F' F'' Y n hn hn2 D ℓ hℓ hP
  have hCdef : wcPencilC D ℓ hP = Classical.choose hC := dif_pos hC
  have hCgc : wcPencilGC F'' hP ℓ (Subobject.underlying.obj (wcPencilC D ℓ hP)) := by
    rw [hCdef]; exact (Classical.choose_spec hC).2.1

  by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
      wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
      ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
        wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
  · have hE : wcPencilE D ℓ hP = Classical.choose h := dif_pos h
    have hcok : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
      rw [hE]; exact (Classical.choose_spec h).2.1
    have hK := wc_geomConst_kernel F'' hP ℓ _ _
      ((wcPencilC D ℓ hP).arrow ≫ Limits.cokernel.π (wcPencilE D ℓ hP).arrow) hCgc hcok
    obtain ⟨i⟩ := s1 (wcPencilE D ℓ hP) (wcPencilC D ℓ hP)
    exact transport i.symm hK
  · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg h
    rw [hE, top_inf_eq]
    exact hCgc

theorem wc_proet_open_envelope (S : Scheme.{u}) (O : S.Opens)
    (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :
    ∃ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ι : F ⟶ G)
      (e : ∀ T : S.ProEt, G.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op (wcOpenRestr S O T))),
      (∀ (T : S.ProEt) (x : F.obj.obj (Opposite.op T)),
        e T ((ι.hom.app (Opposite.op T)).hom x) = (F.obj.map (wcOpenRestrIncl S O T).op).hom x) ∧
      (∀ (T T' : S.ProEt) (k : T' ⟶ T) (kO : wcOpenRestr S O T' ⟶ wcOpenRestr S O T),
        kO ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ k →
        ∀ g : G.obj.obj (Opposite.op T),
          e T' ((G.obj.map k.op).hom g) = (F.obj.map kO.op).hom (e T g)) :=
by
  classical
  haveI hOet : WeaklyEtale O.ι := etale_le_weaklyEtale _ _ _ inferInstance
  let Ob : S.ProEt := Scheme.ProEt.mk O.ι
  obtain ⟨hc₁, _, _⟩ := wc_lpsc_site S Ob
  have hc₂ := (wc_proet_pullback_continuous_flat O.ι).1
  let Φ : S.ProEt ⥤ S.ProEt := wcProEtPullback O.ι ⋙ wcSliceFunctor S Ob
  haveI hΦ : Φ.IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S) :=
    @Functor.isContinuous_comp _ _ _ _ _ _ _ _ _ _ _ hc₂ hc₁
  let G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
    (Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S)).obj F

  have hΦfst : ∀ {T T' : S.ProEt} (k : T' ⟶ T),
      (Φ.map k).left ≫ Limits.pullback.fst T.hom O.ι = Limits.pullback.fst T'.hom O.ι ≫ k.left := by
    intro T T' k
    exact Limits.pullback.lift_fst _ _ _
  have hΦsnd : ∀ {T T' : S.ProEt} (k : T' ⟶ T),
      (Φ.map k).left ≫ Limits.pullback.snd T.hom O.ι = Limits.pullback.snd T'.hom O.ι := by
    intro T T' k
    exact Limits.pullback.lift_snd _ _ _

  let q : ∀ T : S.ProEt, Φ.obj T ⟶ T := fun T =>
    MorphismProperty.Over.homMk (Limits.pullback.fst T.hom O.ι)
      (Limits.pullback.condition) trivial
  have hq : ∀ {T T' : S.ProEt} (k : T' ⟶ T), Φ.map k ≫ q T = q T' ≫ k := by
    intro T T' k
    apply MorphismProperty.Over.Hom.ext
    exact hΦfst k
  let ι : F ⟶ G := ObjectProperty.homMk
    { app := fun T => F.obj.map (q T.unop).op
      naturality := by
        intro X Y f
        change F.obj.map f ≫ F.obj.map (q Y.unop).op =
          F.obj.map (q X.unop).op ≫ F.obj.map (Φ.map f.unop).op
        have h3 : f ≫ (q Y.unop).op = (q X.unop).op ≫ (Φ.map f.unop).op :=
          Quiver.Hom.unop_inj (hq f.unop).symm
        exact (F.obj.map_comp _ _).symm.trans ((congrArg F.obj.map h3).trans
          (F.obj.map_comp _ _)) }

  let β : ∀ T : S.ProEt, wcOpenRestr S O T ≅ Φ.obj T := fun T =>
    MorphismProperty.Over.isoMk (Limits.pullbackSymmetry O.ι T.hom) (by
      change (Limits.pullbackSymmetry O.ι T.hom).hom ≫ Limits.pullback.snd T.hom O.ι ≫ O.ι =
        Limits.pullback.snd O.ι T.hom ≫ T.hom
      rw [← Category.assoc, Limits.pullbackSymmetry_hom_comp_snd]
      exact Limits.pullback.condition)
  let e : ∀ T : S.ProEt, G.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op (wcOpenRestr S O T)) :=
    fun T => (F.obj.mapIso (β T).op).addCommGroupIsoToAddEquiv
  have hI1 : ∀ T : S.ProEt, (β T).hom ≫ q T = wcOpenRestrIncl S O T := by
    intro T
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullbackSymmetry_hom_comp_fst O.ι T.hom
  have hI2 : ∀ (T T' : S.ProEt) (k : T' ⟶ T) (kO : wcOpenRestr S O T' ⟶ wcOpenRestr S O T),
      kO ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ k →
      (β T').hom ≫ Φ.map k = kO ≫ (β T).hom := by
    intro T T' k kO h
    have hl : kO.left ≫ Limits.pullback.snd O.ι T.hom =
        Limits.pullback.snd O.ι T'.hom ≫ k.left :=
      congrArg (fun f => f.left) h
    have hk : k.left ≫ T.hom = T'.hom := MorphismProperty.Over.w k
    have key : ∀ {X X' : Scheme.{u}} (a : X ⟶ S) (a' : X' ⟶ S) (kl : X' ⟶ X), kl ≫ a = a' →
        ∀ (ψ : Limits.pullback O.ι a' ⟶ Limits.pullback O.ι a),
        ψ ≫ Limits.pullback.snd O.ι a = Limits.pullback.snd O.ι a' ≫ kl →
        ∀ (φ : Limits.pullback a' O.ι ⟶ Limits.pullback a O.ι),
        φ ≫ Limits.pullback.fst a O.ι = Limits.pullback.fst a' O.ι ≫ kl →
        φ ≫ Limits.pullback.snd a O.ι = Limits.pullback.snd a' O.ι →
        (Limits.pullbackSymmetry O.ι a').hom ≫ φ =
          ψ ≫ (Limits.pullbackSymmetry O.ι a).hom := by
      intro X X' a a' kl hk ψ hl φ h1 h2
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [h1, ← Category.assoc, Limits.pullbackSymmetry_hom_comp_fst,
          Limits.pullbackSymmetry_hom_comp_fst]
        exact hl.symm
      · simp only [Category.assoc]
        rw [h2, Limits.pullbackSymmetry_hom_comp_snd, Limits.pullbackSymmetry_hom_comp_snd]
        rw [← cancel_mono O.ι, Category.assoc, Limits.pullback.condition (f := O.ι) (g := a),
          ← Category.assoc, hl, Category.assoc, hk]
        exact Limits.pullback.condition
    apply MorphismProperty.Over.Hom.ext
    exact key T.hom T'.hom k.left hk kO.left hl (Φ.map k).left (hΦfst k) (hΦsnd k)
  refine ⟨G, ι, e, ?_, ?_⟩
  · intro T x
    have h4 : (q T).op ≫ (β T).hom.op = (wcOpenRestrIncl S O T).op :=
      Quiver.Hom.unop_inj (hI1 T)
    exact congrArg (fun φ => φ.hom x) ((F.obj.map_comp _ _).symm.trans (congrArg F.obj.map h4))
  · intro T T' k kO h g
    have h5 : (Φ.map k).op ≫ (β T').hom.op = (β T).hom.op ≫ kO.op :=
      Quiver.Hom.unop_inj (hI2 T T' k kO h)
    exact congrArg (fun φ => φ.hom g) ((F.obj.map_comp _ _).symm.trans
      ((congrArg F.obj.map h5).trans (F.obj.map_comp _ _)))

theorem wc_proet_open_envelope_supp (S : Scheme.{u}) (O : S.Opens)
    (F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ι : F ⟶ G)
    (e : ∀ T : S.ProEt, G.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op (wcOpenRestr S O T)))
    (he : ∀ (T : S.ProEt) (x : F.obj.obj (Opposite.op T)),
      e T ((ι.hom.app (Opposite.op T)).hom x) = (F.obj.map (wcOpenRestrIncl S O T).op).hom x)
    (V : S.ProEt) (hV : ∀ v : V.left, V.hom v ∈ O) :
    ∀ y : Abelian.Ext (wcFreeSheaf S V) (Limits.cokernel ι) 0, y = 0 :=
by
  classical

  have sec : ∀ T : S.ProEt, (∀ t : T.left, T.hom t ∈ O) →
      ∃ s : T ⟶ wcOpenRestr S O T, wcOpenRestrIncl S O T ≫ s = 𝟙 _ := by
    intro T hT
    have hrange : Set.range T.hom.base ⊆ Set.range O.ι.base := by
      rintro _ ⟨t, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hT t
    let lam := IsOpenImmersion.lift O.ι T.hom hrange
    have hlam : lam ≫ O.ι = T.hom := IsOpenImmersion.lift_fac _ _ _
    let σ : T.left ⟶ Limits.pullback O.ι T.hom :=
      Limits.pullback.lift lam (𝟙 T.left) (by rw [hlam, Category.id_comp])
    refine ⟨MorphismProperty.Over.homMk σ (by
        change σ ≫ Limits.pullback.snd O.ι T.hom ≫ T.hom = T.hom
        rw [Limits.pullback.lift_snd_assoc, Category.id_comp]) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.snd O.ι T.hom ≫ σ = 𝟙 _
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
      rw [← cancel_mono O.ι, Category.assoc, hlam, Limits.pullback.condition]
    · rw [Category.assoc, Limits.pullback.lift_snd]
      exact (Category.comp_id _).trans (Category.id_comp _).symm

  have hsurj : ∀ (T : S.ProEt) (k : T ⟶ V) (g : G.obj.obj (Opposite.op T)),
      ∃ x : F.obj.obj (Opposite.op T), (ι.hom.app (Opposite.op T)).hom x = g := by
    intro T k g
    have hT : ∀ t : T.left, T.hom t ∈ O := by
      intro t
      have h1 : T.hom t = V.hom (k.left t) := by
        rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w k]
      rw [h1]
      exact hV _
    obtain ⟨s, hs⟩ := sec T hT
    refine ⟨(F.obj.map s.op).hom (e T g), ?_⟩
    apply (e T).injective
    rw [he]
    have h2 : (F.obj.map (wcOpenRestrIncl S O T).op).hom ((F.obj.map s.op).hom (e T g)) =
        (F.obj.map (wcOpenRestrIncl S O T ≫ s).op).hom (e T g) := by
      rw [op_comp, CategoryTheory.Functor.map_comp]
      rfl
    rw [h2, hs, op_id, CategoryTheory.Functor.map_id]
    rfl

  have hPV : ∀ (T₀ : S.ProEt) (k₀ : T₀ ⟶ V) (p : (Limits.cokernel ι).obj.obj (Opposite.op T₀)),
      p = 0 := by
    intro T₀ k₀ p
    haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S) (Limits.cokernel.π ι).hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (Limits.cokernel.π ι)).mpr
        inferInstance
    have hR := Presheaf.imageSieve_mem (Scheme.ProEt.topology S) (Limits.cokernel.π ι).hom
      (U := Opposite.op T₀) p
    have hF : Presieve.IsSheaf (Scheme.ProEt.topology S)
        ((Limits.cokernel ι).obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp ((Presheaf.isSheaf_iff_isSheaf_forget
        (Scheme.ProEt.topology S) (Limits.cokernel ι).obj (forget AddCommGrpCat.{u+1})).mp
          (Limits.cokernel ι).property)
    apply ((hF _ hR).isSeparatedFor).ext
    intro T f hf
    obtain ⟨t, ht⟩ := hf
    show (Limits.cokernel ι).obj.map f.op p = (Limits.cokernel ι).obj.map f.op 0
    rw [map_zero, ← ht]
    obtain ⟨x, rfl⟩ := hsurj T (f ≫ k₀) t
    have h1 : (Limits.cokernel.π ι).hom.app (Opposite.op T) ((ι.hom.app (Opposite.op T)) x) =
        ((ι ≫ Limits.cokernel.π ι).hom.app (Opposite.op T)) x := rfl
    rw [h1, Limits.cokernel.condition]
    rfl

  have hall : ∀ ψ₁ ψ₂ : (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (Limits.cokernel ι).obj, ψ₁ = ψ₂ := by
    intro ψ₁ ψ₂
    apply NatTrans.ext
    funext T
    refine ConcreteCategory.hom_ext _ _ fun x => ?_
    induction x using FreeAbelianGroup.induction_on with
    | zero => exact (map_zero (ψ₁.app T).hom).trans (map_zero (ψ₂.app T).hom).symm
    | of a => exact (hPV T.unop a.down _).trans (hPV T.unop a.down _).symm
    | neg a ha =>
      exact (map_neg (ψ₁.app T).hom _).trans
        ((congrArg Neg.neg ha).trans (map_neg (ψ₂.app T).hom _).symm)
    | add a b ha hb =>
      exact (map_add (ψ₁.app T).hom a b).trans
        ((congrArg₂ (· + ·) ha hb).trans (map_add (ψ₂.app T).hom a b).symm)
  intro y
  have h1 : Abelian.Ext.homEquiv₀ y = 0 := by
    apply ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
      (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) (Limits.cokernel ι)).injective
    exact hall _ _
  rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, h1, Abelian.Ext.mk₀_zero]

theorem wc_openRestr_base_change_cover (S : Scheme.{u}) (O : S.Opens) (B₀ W : S.ProEt) (w : W ⟶ B₀) (hqc : QuasiCompact w.left) (hsurj : ∀ p : B₀.left, B₀.hom p ∈ O → ∃ z : W.left, w.left z = p) : ∃ wO : wcOpenRestr S O W ⟶ wcOpenRestr S O B₀, wO ≫ wcOpenRestrIncl S O B₀ = wcOpenRestrIncl S O W ≫ w ∧ QuasiCompact wO.left ∧ ∀ p : (wcOpenRestr S O B₀).left, ∃ z : (wcOpenRestr S O W).left, wO.left z = p :=
by
  classical
  have hw : w.left ≫ B₀.hom = W.hom := MorphismProperty.Over.w w
  have hm : Limits.pullback.fst O.ι W.hom ≫ O.ι =
      (Limits.pullback.snd O.ι W.hom ≫ w.left) ≫ B₀.hom := by
    rw [Category.assoc, hw, Limits.pullback.condition]
  let m : Limits.pullback O.ι W.hom ⟶ Limits.pullback O.ι B₀.hom :=
    Limits.pullback.lift (Limits.pullback.fst O.ι W.hom)
      (Limits.pullback.snd O.ι W.hom ≫ w.left) hm
  have m1 : m ≫ Limits.pullback.fst O.ι B₀.hom = Limits.pullback.fst O.ι W.hom :=
    Limits.pullback.lift_fst _ _ _
  have m2 : m ≫ Limits.pullback.snd O.ι B₀.hom = Limits.pullback.snd O.ι W.hom ≫ w.left :=
    Limits.pullback.lift_snd _ _ _
  have hmw : m ≫ (Limits.pullback.snd O.ι B₀.hom ≫ B₀.hom) =
      Limits.pullback.snd O.ι W.hom ≫ W.hom := by
    rw [← Category.assoc, m2, Category.assoc, hw]
  let wO : wcOpenRestr S O W ⟶ wcOpenRestr S O B₀ :=
    MorphismProperty.Over.homMk (A := wcOpenRestr S O W) (B := wcOpenRestr S O B₀) m hmw trivial
  have outer : IsPullback (Limits.pullback.snd O.ι W.hom)
      (m ≫ Limits.pullback.fst O.ι B₀.hom) (w.left ≫ B₀.hom) O.ι := by
    rw [m1, hw]
    exact (IsPullback.of_hasPullback O.ι W.hom).flip
  have hpb : IsPullback (Limits.pullback.snd O.ι W.hom) m w.left
      (Limits.pullback.snd O.ι B₀.hom) :=
    IsPullback.of_bot outer m2.symm (IsPullback.of_hasPullback O.ι B₀.hom).flip
  have hqcm : QuasiCompact m := MorphismProperty.of_isPullback (P := @QuasiCompact) hpb hqc
  refine ⟨wO, ?_, hqcm, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact m2
  · show ∀ p : ↥(Limits.pullback O.ι B₀.hom), ∃ z : ↥(Limits.pullback O.ι W.hom), m z = p
    intro p
    have hcond : O.ι (Limits.pullback.fst O.ι B₀.hom p) =
        B₀.hom (Limits.pullback.snd O.ι B₀.hom p) := by
      have e0 := congrArg (fun f : Limits.pullback O.ι B₀.hom ⟶ S => f p)
        (Limits.pullback.condition (f := O.ι) (g := B₀.hom))
      first
        | exact e0
        | (simp only [Scheme.Hom.comp_apply] at e0; exact e0)
    have hmem : B₀.hom (Limits.pullback.snd O.ι B₀.hom p) ∈ O := by
      have hr : O.ι (Limits.pullback.fst O.ι B₀.hom p) ∈ Set.range O.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι, hcond] at hr
      exact hr
    obtain ⟨z, hz⟩ := hsurj _ hmem
    have hcompat : O.ι (Limits.pullback.fst O.ι B₀.hom p) = W.hom z := by
      rw [hcond, ← hw, Scheme.Hom.comp_apply, hz]
    obtain ⟨z', h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hcompat
    refine ⟨z', ?_⟩
    apply Scheme.Hom.injective (Limits.pullback.snd O.ι B₀.hom)
    show Limits.pullback.snd O.ι B₀.hom (m z') = Limits.pullback.snd O.ι B₀.hom p
    rw [← Scheme.Hom.comp_apply, m2, Scheme.Hom.comp_apply, h2, hz]

theorem wc_proet_open_envelope_frame_over_open (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (O : S.Opens) (F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (e : ∀ T : S.ProEt, G.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op (wcOpenRestr S O T))) (he2 : ∀ (T T' : S.ProEt) (k : T' ⟶ T) (kO : wcOpenRestr S O T' ⟶ wcOpenRestr S O T), kO ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ k → ∀ g : G.obj.obj (Opposite.op T), e T' ((G.obj.map k.op).hom g) = (F.obj.map kO.op).hom (e T g)) (hiso : ∀ T : S.ProEt, (∀ t : T.left, T.hom t ∈ O) → IsIso (wcOpenRestrIncl S O T)) (B₀ W : S.ProEt) (w : W ⟶ B₀) (wO : wcOpenRestr S O W ⟶ wcOpenRestr S O B₀) (hwO : wO ≫ wcOpenRestrIncl S O B₀ = wcOpenRestrIncl S O W ≫ w) (hqcO : QuasiCompact wO.left) (hsurjO : ∀ p : (wcOpenRestr S O B₀).left, ∃ z : (wcOpenRestr S O W).left, wO.left z = p) (k : ℕ) (θ : F.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W) (hdeck : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : F.obj.obj (Opposite.op V)), h₁ ≫ w = h₂ ≫ w → ∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z = wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) : Nonempty (G.over (wcOpenRestr S O B₀) ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over (wcOpenRestr S O B₀)) :=
by
  classical

  have hland : ∀ (T : S.ProEt) (t : (wcOpenRestr S O T).left),
      (wcOpenRestr S O T).hom t ∈ O := by
    intro T t
    have h : T.hom (Limits.pullback.snd O.ι T.hom t) =
        O.ι (Limits.pullback.fst O.ι T.hom t) := by
      have e0 := congrArg (fun f : Limits.pullback O.ι T.hom ⟶ S => f t)
        (Limits.pullback.condition (f := O.ι) (g := T.hom))
      first
        | exact e0.symm
        | (simp only [Scheme.Hom.comp_apply] at e0; exact e0.symm)
    show T.hom (Limits.pullback.snd O.ι T.hom t) ∈ O
    rw [h]
    have hm : O.ι (Limits.pullback.fst O.ι T.hom t) ∈ Set.range O.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at hm
    exact hm
  have hlandV : ∀ (V : S.ProEt) (h : V ⟶ wcOpenRestr S O W) (v : V.left), V.hom v ∈ O := by
    intro V h v
    have hw := MorphismProperty.Over.w h
    have e1 : V.hom v = (wcOpenRestr S O W).hom (h.left v) := by
      rw [← hw]
      first
        | rfl
        | simp only [Scheme.Hom.comp_apply]
    rw [e1]
    exact hland W (h.left v)

  have hisoF : ∀ T : S.ProEt, (∀ t : T.left, T.hom t ∈ O) →
      IsIso (F.obj.map (wcOpenRestrIncl S O T).op) := by
    intro T hT
    haveI := hiso T hT
    infer_instance
  let E : ∀ T : S.ProEt, (∀ t : T.left, T.hom t ∈ O) →
      (F.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op (wcOpenRestr S O T))) :=
    fun T hT => (@asIso _ _ _ _ (F.obj.map (wcOpenRestrIncl S O T).op)
      (hisoF T hT)).addCommGroupIsoToAddEquiv
  let Ψ : ∀ T : S.ProEt, (∀ t : T.left, T.hom t ∈ O) →
      (G.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op T)) :=
    fun T hT => (e T).trans (E T hT).symm
  have hEapp : ∀ (T : S.ProEt) (hT : ∀ t : T.left, T.hom t ∈ O) (y : F.obj.obj (Opposite.op T)),
      E T hT y = (F.obj.map (wcOpenRestrIncl S O T).op).hom y := fun _ _ _ => rfl
  have hchar : ∀ (T : S.ProEt) (hT : ∀ t : T.left, T.hom t ∈ O) (g : G.obj.obj (Opposite.op T)),
      (F.obj.map (wcOpenRestrIncl S O T).op).hom (Ψ T hT g) = e T g := by
    intro T hT g
    rw [← hEapp T hT]
    exact (E T hT).apply_symm_apply (e T g)
  have hinj : ∀ (T : S.ProEt) (hT : ∀ t : T.left, T.hom t ∈ O),
      Function.Injective (F.obj.map (wcOpenRestrIncl S O T).op).hom := by
    intro T hT a b hab
    rw [← hEapp T hT, ← hEapp T hT] at hab
    exact (E T hT).injective hab
  have hnat : ∀ (T T' : S.ProEt) (hT : ∀ t : T.left, T.hom t ∈ O)
      (hT' : ∀ t : T'.left, T'.hom t ∈ O) (c : T' ⟶ T) (g : G.obj.obj (Opposite.op T)),
      Ψ T' hT' ((G.obj.map c.op).hom g) = (F.obj.map c.op).hom (Ψ T hT g) := by
    intro T T' hT hT' c g
    apply hinj T' hT'
    rw [hchar T' hT' ((G.obj.map c.op).hom g)]
    haveI := hiso T hT
    have hsq : (wcOpenRestrIncl S O T' ≫ c ≫ inv (wcOpenRestrIncl S O T)) ≫
        wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ c := by
      simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    rw [he2 T T' c _ hsq g, ← hchar T hT g]
    have h3 := congrArg (fun φ => (F.obj.map φ.op).hom (Ψ T hT g)) hsq
    simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h3 ⊢
    exact h3

  let ν : (G.over (wcOpenRestr S O W)).obj ≅ (F.over (wcOpenRestr S O W)).obj :=
    NatIso.ofComponents
      (fun X => (Ψ X.unop.left (hlandV X.unop.left X.unop.hom)).toAddCommGrpIso)
      (by
        intro X Y κ
        ext g
        change Ψ Y.unop.left (hlandV Y.unop.left Y.unop.hom)
            ((G.obj.map κ.unop.left.op).hom g) =
          (F.obj.map κ.unop.left.op).hom (Ψ X.unop.left (hlandV X.unop.left X.unop.hom) g)
        exact hnat X.unop.left Y.unop.left (hlandV X.unop.left X.unop.hom)
          (hlandV Y.unop.left Y.unop.hom) κ.unop.left g)
  let ψ : G.over (wcOpenRestr S O W) ≅ F.over (wcOpenRestr S O W) :=
    (fullyFaithfulSheafToPresheaf _ _).preimageIso ν

  let θ' : F.over (wcOpenRestr S O W) ≅
      (wcContSheaf S (Fin k → ℚ_[ℓ])).over (wcOpenRestr S O W) :=
    ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1}
      (wcOpenRestrIncl S O W)).mapIso θ

  let θG : G.over (wcOpenRestr S O W) ≅
      (wcContSheaf S (Fin k → ℚ_[ℓ])).over (wcOpenRestr S O W) := ψ ≪≫ θ'

  have hfix : ∀ (V : S.ProEt), ConnectedSpace V.left → ∀ (h₁ h₂ : V ⟶ wcOpenRestr S O W)
      (x : G.obj.obj (Opposite.op V)), h₁ ≫ wO = h₂ ≫ wO →
      (θG.hom.hom.app (Opposite.op (Over.mk h₁))).hom x =
        (θG.hom.hom.app (Opposite.op (Over.mk h₂))).hom x := by
    intro V _ h₁ h₂ x hw
    have hw' : (h₁ ≫ wcOpenRestrIncl S O W) ≫ w = (h₂ ≫ wcOpenRestrIncl S O W) ≫ w := by
      simp only [Category.assoc, ← hwO]
      simp only [← Category.assoc, hw]
    set y := Ψ V (hlandV V h₁) x with hy
    have hd := hdeck V (h₁ ≫ wcOpenRestrIncl S O W) (h₂ ≫ wcOpenRestrIncl S O W) y hw'
    show (θ.hom.hom.app (Opposite.op (Over.mk (h₁ ≫ wcOpenRestrIncl S O W)))).hom y =
      (θ.hom.hom.app (Opposite.op (Over.mk (h₂ ≫ wcOpenRestrIncl S O W)))).hom y
    set A := (θ.hom.hom.app (Opposite.op (Over.mk (h₂ ≫ wcOpenRestrIncl S O W)))).hom y with hA
    set B := (θ.hom.hom.app (Opposite.op (Over.mk (h₁ ≫ wcOpenRestrIncl S O W)))).hom y with hB
    have hd' : ∀ z : V.left, (show ULift.{u+1} C(↥V.left, Fin k → ℚ_[ℓ]) from A).down z =
        (show ULift.{u+1} C(↥V.left, Fin k → ℚ_[ℓ]) from B).down z := hd
    exact (ULift.ext (show ULift.{u+1} C(↥V.left, Fin k → ℚ_[ℓ]) from A) B
      (ContinuousMap.ext hd')).symm

  exact wc_proet_frame_fixed_descent S ℓ (wcOpenRestr S O B₀) (wcOpenRestr S O W) wO hqcO
    hsurjO G k θG hfix

theorem wc_proet_frame_extend_from_open (S : Scheme.{u}) (O : S.Opens) (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B₀ : S.ProEt) (Φ : A.over (wcOpenRestr S O B₀) ≅ B.over (wcOpenRestr S O B₀)) (hA : ∀ T : S.ProEt, Function.Bijective (A.obj.map (wcOpenRestrIncl S O T).op)) (hB : ∀ T : S.ProEt, Function.Bijective (B.obj.map (wcOpenRestrIncl S O T).op)) : Nonempty (A.over B₀ ≅ B.over B₀) :=
by
  classical

  have hmono : ∀ T : S.ProEt, Mono (wcOpenRestrIncl S O T) := by
    intro T
    constructor
    intro Z a b h
    apply MorphismProperty.Over.Hom.ext
    have h' : a.left ≫ Limits.pullback.snd O.ι T.hom = b.left ≫ Limits.pullback.snd O.ι T.hom :=
      congrArg (fun f => f.left) h
    exact (cancel_mono (Limits.pullback.snd O.ι T.hom)).mp h'

  have hlift : ∀ (T T' : S.ProEt) (c : T' ⟶ T), ∃ cO : wcOpenRestr S O T' ⟶ wcOpenRestr S O T,
      cO ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ c := by
    intro T T' c
    have hm : Limits.pullback.fst O.ι T'.hom ≫ O.ι =
        (Limits.pullback.snd O.ι T'.hom ≫ c.left) ≫ T.hom := by
      rw [Category.assoc, MorphismProperty.Over.w c, Limits.pullback.condition]
    let m := Limits.pullback.lift (Limits.pullback.fst O.ι T'.hom)
      (Limits.pullback.snd O.ι T'.hom ≫ c.left) hm
    have hms : m ≫ Limits.pullback.snd O.ι T.hom = Limits.pullback.snd O.ι T'.hom ≫ c.left :=
      Limits.pullback.lift_snd _ _ _
    refine ⟨MorphismProperty.Over.homMk m ?_ trivial, ?_⟩
    · show m ≫ (Limits.pullback.snd O.ι T.hom ≫ T.hom) = Limits.pullback.snd O.ι T'.hom ≫ T'.hom
      rw [← Category.assoc, hms, Category.assoc, MorphismProperty.Over.w c]
    · apply MorphismProperty.Over.Hom.ext
      exact hms

  choose gO hgO using fun (X : (Over B₀)ᵒᵖ) => hlift B₀ X.unop.left X.unop.hom
  let XO : (Over B₀)ᵒᵖ → (Over (wcOpenRestr S O B₀))ᵒᵖ := fun X => Opposite.op (Over.mk (gO X))
  let ΦX : ∀ X : (Over B₀)ᵒᵖ, A.obj.obj (Opposite.op (wcOpenRestr S O X.unop.left)) ≃+
      B.obj.obj (Opposite.op (wcOpenRestr S O X.unop.left)) := fun X =>
    (((sheafToPresheaf _ _).mapIso Φ).app (XO X)).addCommGroupIsoToAddEquiv
  have hΦX : ∀ X y, ΦX X y = (Φ.hom.hom.app (XO X)).hom y := fun X y => rfl
  let eA : ∀ T : S.ProEt, A.obj.obj (Opposite.op T) ≃+
      A.obj.obj (Opposite.op (wcOpenRestr S O T)) := fun T =>
    AddEquiv.ofBijective (A.obj.map (wcOpenRestrIncl S O T).op).hom (hA T)
  let eB : ∀ T : S.ProEt, B.obj.obj (Opposite.op T) ≃+
      B.obj.obj (Opposite.op (wcOpenRestr S O T)) := fun T =>
    AddEquiv.ofBijective (B.obj.map (wcOpenRestrIncl S O T).op).hom (hB T)
  have heA : ∀ T x, eA T x = (A.obj.map (wcOpenRestrIncl S O T).op).hom x := fun T x => rfl
  have heB : ∀ T x, eB T x = (B.obj.map (wcOpenRestrIncl S O T).op).hom x := fun T x => rfl
  let E : ∀ X : (Over B₀)ᵒᵖ, A.obj.obj (Opposite.op X.unop.left) ≃+
      B.obj.obj (Opposite.op X.unop.left) := fun X =>
    (eA X.unop.left).trans ((ΦX X).trans (eB X.unop.left).symm)
  have hE : ∀ X a, eB X.unop.left (E X a) = ΦX X (eA X.unop.left a) := by
    intro X a
    show eB X.unop.left ((eB X.unop.left).symm (ΦX X (eA X.unop.left a))) = _
    rw [AddEquiv.apply_symm_apply]

  have hnat : ∀ (X Y : (Over B₀)ᵒᵖ) (k : X ⟶ Y) (a : A.obj.obj (Opposite.op X.unop.left)),
      E Y ((A.obj.map k.unop.left.op).hom a) = (B.obj.map k.unop.left.op).hom (E X a) := by
    intro X Y k a
    obtain ⟨cO, hc⟩ := hlift X.unop.left Y.unop.left k.unop.left
    have hcg : cO ≫ gO X = gO Y := by
      rw [← cancel_mono (wcOpenRestrIncl S O B₀)]
      rw [Category.assoc, hgO X, ← Category.assoc, hc, Category.assoc, Over.w k.unop, hgO Y]
    have hfA : ∀ x, (A.obj.map (wcOpenRestrIncl S O Y.unop.left).op).hom
        ((A.obj.map k.unop.left.op).hom x) =
        (A.obj.map cO.op).hom ((A.obj.map (wcOpenRestrIncl S O X.unop.left).op).hom x) := by
      intro x
      have := congrArg (fun f => (A.obj.map f.op).hom x) hc
      simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
        at this
      exact this.symm
    have hfB : ∀ x, (B.obj.map (wcOpenRestrIncl S O Y.unop.left).op).hom
        ((B.obj.map k.unop.left.op).hom x) =
        (B.obj.map cO.op).hom ((B.obj.map (wcOpenRestrIncl S O X.unop.left).op).hom x) := by
      intro x
      have := congrArg (fun f => (B.obj.map f.op).hom x) hc
      simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
        at this
      exact this.symm
    let κ : XO X ⟶ XO Y := (Over.homMk cO hcg : Over.mk (gO Y) ⟶ Over.mk (gO X)).op
    have hΦnat : ∀ y, (Φ.hom.hom.app (XO Y)).hom ((A.obj.map cO.op).hom y) =
        (B.obj.map cO.op).hom ((Φ.hom.hom.app (XO X)).hom y) := by
      intro y
      have := congrArg (fun f => f.hom y) (Φ.hom.hom.naturality κ)
      simp only [AddCommGrpCat.hom_comp] at this
      exact this
    apply (eB Y.unop.left).injective
    rw [hE, heB, hfB, ← heB, hE, hΦX, hΦX, heA, heA, hfA]
    exact hΦnat _
  let eP : (A.over B₀).obj ≅ (B.over B₀).obj :=
    NatIso.ofComponents (fun X => (E X).toAddCommGrpIso) (by
      intro X Y k
      ext a
      exact hnat X Y k a)
  exact ⟨(fullyFaithfulSheafToPresheaf _ _).preimageIso eP⟩

theorem wc_proet_open_envelope_GC (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (O : (wcP1Over K).left.Opens)
    (hO : ∀ p : (wcP1Over K).left, p ∈ O ↔ ∀ i : Fin m, p ≠ S i (IsLocalRing.closedPoint K))
    (F G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (e : ∀ T : (wcP1Over K).left.ProEt,
      G.obj.obj (Opposite.op T) ≃+ F.obj.obj (Opposite.op (wcOpenRestr (wcP1Over K).left O T)))
    (he2 : ∀ (T T' : (wcP1Over K).left.ProEt) (k : T' ⟶ T)
      (kO : wcOpenRestr (wcP1Over K).left O T' ⟶ wcOpenRestr (wcP1Over K).left O T),
      kO ≫ wcOpenRestrIncl (wcP1Over K).left O T = wcOpenRestrIncl (wcP1Over K).left O T' ≫ k →
      ∀ g : G.obj.obj (Opposite.op T),
        e T' ((G.obj.map k.op).hom g) = (F.obj.map kO.op).hom (e T g))
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : F.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hdeck : ∀ (V : (wcP1Over K).left.ProEt) (h₁ h₂ : V ⟶ W) (x : F.obj.obj (Opposite.op V)),
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) :
    wcPencilGC K hP ℓ G :=
by
  classical

  have hiso : ∀ T : (wcP1Over K).left.ProEt, (∀ t : T.left, T.hom t ∈ O) →
      IsIso (wcOpenRestrIncl (wcP1Over K).left O T) := by
    intro T hT
    have hr : Set.range T.hom ⊆ Set.range O.ι := by
      rintro _ ⟨t, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hT t
    let l := IsOpenImmersion.lift O.ι T.hom hr
    have hl : l ≫ O.ι = T.hom := IsOpenImmersion.lift_fac _ _ _
    let σ : T.left ⟶ Limits.pullback O.ι T.hom :=
      Limits.pullback.lift l (𝟙 _) (by rw [hl, Category.id_comp])
    have h1 : σ ≫ Limits.pullback.snd O.ι T.hom = 𝟙 _ := Limits.pullback.lift_snd _ _ _
    have h2 : Limits.pullback.snd O.ι T.hom ≫ σ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp,
          ← cancel_mono O.ι, Category.assoc, hl, Limits.pullback.condition]
      · rw [Category.assoc, h1]
        exact (Category.comp_id _).trans (Category.id_comp _).symm
    refine ⟨⟨MorphismProperty.Over.homMk σ ?_ trivial, ?_, ?_⟩⟩
    · show σ ≫ (Limits.pullback.snd O.ι T.hom ≫ T.hom) = T.hom
      rw [← Category.assoc, h1, Category.id_comp]
    · apply MorphismProperty.Over.Hom.ext
      exact h2
    · apply MorphismProperty.Over.Hom.ext
      exact h1

  have hGbij : ∀ T : (wcP1Over K).left.ProEt,
      Function.Bijective (G.obj.map (wcOpenRestrIncl (wcP1Over K).left O T).op) := by
    intro T
    have hTO : ∀ t : (wcOpenRestr (wcP1Over K).left O T).left,
        (wcOpenRestr (wcP1Over K).left O T).hom t ∈ O := by
      intro t
      have h : T.hom (Limits.pullback.snd O.ι T.hom t) =
          O.ι (Limits.pullback.fst O.ι T.hom t) := by
        have e0 := congrArg (fun f : Limits.pullback O.ι T.hom ⟶ (wcP1Over K).left => f t)
          (Limits.pullback.condition (f := O.ι) (g := T.hom))
        first
          | exact e0.symm
          | (simp only [Scheme.Hom.comp_apply] at e0; exact e0.symm)
      show T.hom (Limits.pullback.snd O.ι T.hom t) ∈ O
      rw [h]
      have hm : O.ι (Limits.pullback.fst O.ι T.hom t) ∈ Set.range O.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at hm
      exact hm
    haveI := hiso (wcOpenRestr (wcP1Over K).left O T) hTO
    have key : ∀ g : G.obj.obj (Opposite.op T),
        (G.obj.map (wcOpenRestrIncl (wcP1Over K).left O T).op).hom g =
          (e (wcOpenRestr (wcP1Over K).left O T)).symm
            ((F.obj.map (wcOpenRestrIncl (wcP1Over K).left O
              (wcOpenRestr (wcP1Over K).left O T)).op).hom (e T g)) := by
      intro g
      rw [← he2 T (wcOpenRestr (wcP1Over K).left O T) (wcOpenRestrIncl (wcP1Over K).left O T)
        (wcOpenRestrIncl (wcP1Over K).left O (wcOpenRestr (wcP1Over K).left O T)) rfl g,
        AddEquiv.symm_apply_apply]
    have hF : Function.Bijective (F.obj.map (wcOpenRestrIncl (wcP1Over K).left O
        (wcOpenRestr (wcP1Over K).left O T)).op) :=
      ConcreteCategory.bijective_of_isIso _
    convert (e (wcOpenRestr (wcP1Over K).left O T)).symm.bijective.comp
      (hF.comp (e T).bijective) using 1
    funext g
    exact key g

  obtain ⟨wO, hwO, hqcO, hsurjO⟩ := wc_openRestr_base_change_cover (wcP1Over K).left O
    (wcGeomPoint K (wcP1Over K) hP) W w hqc (fun p hp => hsurj p ((hO _).1 hp))

  obtain ⟨Φ⟩ := wc_proet_open_envelope_frame_over_open (wcP1Over K).left ℓ O F G e he2 hiso
    (wcGeomPoint K (wcP1Over K) hP) W w wO hwO hqcO hsurjO k θ hdeck

  obtain ⟨Ψ⟩ := wc_proet_frame_extend_from_open (wcP1Over K).left O G
    (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])) (wcGeomPoint K (wcP1Over K) hP) Φ hGbij
    (wc_P1_contSheaf_openRestr_bij K ℓ k m S hS O hO)
  exact ⟨k, ⟨Ψ⟩⟩

theorem wc_proet_quot_restr_injective (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (O : (wcP1Over K).left.Opens)
    (hO : ∀ p : (wcP1Over K).left, p ∈ O ↔ ∀ i : Fin m, p ≠ S i (IsLocalRing.closedPoint K))
    (R : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hR : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : R.obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        (R.obj.map h.op).hom x = 0) → x = 0)
    (A B : Subobject R) (hBA : B ≤ A)
    (hB : wcPencilGC K hP ℓ (Subobject.underlying.obj B)) :
    ∀ (T : (wcP1Over K).left.ProEt)
      (x : (Limits.cokernel (Subobject.ofLE B A hBA)).obj.obj (Opposite.op T)),
      ((Limits.cokernel (Subobject.ofLE B A hBA)).obj.map
        (wcOpenRestrIncl (wcP1Over K).left O T).op).hom x = 0 → x = 0 :=
by
  classical

  have hres : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {T₁ T₂ T₃ : (wcP1Over K).left.ProEt} (h : T₁ ⟶ T₂) (k : T₂ ⟶ T₃)
      (z : F.obj.obj (Opposite.op T₃)),
      (F.obj.map (h ≫ k).op).hom z = (F.obj.map h.op).hom ((F.obj.map k.op).hom z) := by
    intro F T₁ T₂ T₃ h k z
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  have hnat : ∀ {G H : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (φ : G ⟶ H) {T T' : (wcP1Over K).left.ProEt} (k : T' ⟶ T) (z : G.obj.obj (Opposite.op T)),
      (H.obj.map k.op).hom ((φ.hom.app (Opposite.op T)).hom z) =
        (φ.hom.app (Opposite.op T')).hom ((G.obj.map k.op).hom z) := by
    intro G H φ T T' k z
    have h1 := congrArg (fun q => q.hom z) (φ.hom.naturality k.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
    exact h1.symm

  have monoInj : ∀ {G H : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : G ⟶ H), Mono f → ∀ (T : (wcP1Over K).left.ProEt) (b : G.obj.obj (Opposite.op T)),
      (f.hom.app (Opposite.op T)).hom b = 0 → b = 0 := by
    intro G H f hf T b hb
    haveI := hf
    have h1 : Mono ((sheafToPresheaf _ _).map f) := Functor.map_mono _ f
    have h2 : Mono (((sheafToPresheaf _ _).map f).app (Opposite.op T)) :=
      (NatTrans.mono_iff_mono_app _).mp h1 (Opposite.op T)
    have h3 := (AddCommGrpCat.mono_iff_injective _).mp h2
    exact h3 (hb.trans (map_zero _).symm)
  have monoExact : ∀ {G H : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : G ⟶ H), Mono f → ∀ (T : (wcP1Over K).left.ProEt) (a : H.obj.obj (Opposite.op T)),
      ((Limits.cokernel.π f).hom.app (Opposite.op T)).hom a = 0 →
      ∃ b, (f.hom.app (Opposite.op T)).hom b = a := by
    intro G H f hf T a ha
    haveI := hf
    have hS' := (ShortComplex.exact_cokernel f).map_of_mono_of_preservesKernel
      (sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op T)) (inferInstanceAs (Mono f))
      inferInstance
    exact (ShortComplex.ab_exact_iff _).mp hS' a ha
  have cokComp : ∀ {G H : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : G ⟶ H) (T : (wcP1Over K).left.ProEt) (b : G.obj.obj (Opposite.op T)),
      ((Limits.cokernel.π f).hom.app (Opposite.op T)).hom ((f.hom.app (Opposite.op T)).hom b) = 0 := by
    intro G H f T b
    have h1 : (sheafToPresheaf _ _).map f ≫ (sheafToPresheaf _ _).map (Limits.cokernel.π f) = 0 := by
      rw [← Functor.map_comp, Limits.cokernel.condition, Functor.map_zero]
    have h2 := congrArg (fun q => (q.app (Opposite.op T)).hom b) h1
    simpa using h2

  have hinO : ∀ (T : (wcP1Over K).left.ProEt) (p : (wcOpenRestr (wcP1Over K).left O T).left),
      (wcOpenRestr (wcP1Over K).left O T).hom p ∈ O := by
    intro T p
    have e : (wcOpenRestr (wcP1Over K).left O T).hom = Limits.pullback.fst O.ι T.hom ≫ O.ι :=
      Limits.pullback.condition.symm
    have h2 : (wcOpenRestr (wcP1Over K).left O T).hom p = O.ι (Limits.pullback.fst O.ι T.hom p) := by
      rw [e]
      first
        | exact Scheme.Hom.comp_apply _ _ _
        | rfl
        | exact (Scheme.Hom.comp_apply (Limits.pullback.fst O.ι T.hom) O.ι p)
    rw [h2]
    have hm : O.ι (Limits.pullback.fst O.ι T.hom p) ∈ Set.range O.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at hm
    exact hm
  have fac : ∀ (T V : (wcP1Over K).left.ProEt) (h : V ⟶ T), (∀ v : V.left, V.hom v ∈ O) →
      ∃ hO' : V ⟶ wcOpenRestr (wcP1Over K).left O T,
        hO' ≫ wcOpenRestrIncl (wcP1Over K).left O T = h := by
    intro T V h hV
    have hr : Set.range V.hom ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨v, rfl⟩
      exact hV v
    have hw : IsOpenImmersion.lift O.ι V.hom hr ≫ O.ι = h.left ≫ T.hom := by
      rw [IsOpenImmersion.lift_fac, MorphismProperty.Over.w h]
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hw) ?_ trivial, ?_⟩
    · show Limits.pullback.lift _ _ hw ≫ Limits.pullback.snd O.ι T.hom ≫ T.hom = V.hom
      rw [Limits.pullback.lift_snd_assoc, MorphismProperty.Over.w h]
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_snd _ _ _
  have uniq : ∀ (T V : (wcP1Over K).left.ProEt) (p q : V ⟶ wcOpenRestr (wcP1Over K).left O T),
      p ≫ wcOpenRestrIncl (wcP1Over K).left O T = q ≫ wcOpenRestrIncl (wcP1Over K).left O T →
      p = q := by
    intro T V p q hpq
    apply MorphismProperty.Over.Hom.ext
    have h1 : (p.left : V.left ⟶ Limits.pullback O.ι T.hom) ≫ Limits.pullback.snd O.ι T.hom =
        (q.left : V.left ⟶ Limits.pullback O.ι T.hom) ≫ Limits.pullback.snd O.ι T.hom :=
      congrArg (fun r => r.left) hpq
    haveI : Mono (Limits.pullback.snd O.ι T.hom) := inferInstance
    exact (cancel_mono (Limits.pullback.snd O.ι T.hom)).mp h1
  have mapO : ∀ (T T' : (wcP1Over K).left.ProEt) (k : T' ⟶ T),
      ∃ kO : wcOpenRestr (wcP1Over K).left O T' ⟶ wcOpenRestr (wcP1Over K).left O T,
        kO ≫ wcOpenRestrIncl (wcP1Over K).left O T = wcOpenRestrIncl (wcP1Over K).left O T' ≫ k :=
    fun T T' k => fac T _ (wcOpenRestrIncl (wcP1Over K).left O T' ≫ k) (hinO T')

  have extΛ : ∀ (r : ℕ) (V : (wcP1Over K).left.ProEt)
      (y : (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.obj
        (Opposite.op (wcOpenRestr (wcP1Over K).left O V))),
      ∃ f, ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map
        (wcOpenRestrIncl (wcP1Over K).left O V).op).hom f = y := by
    intro r V y
    have hfac : ∀ (V' : (wcP1Over K).left.ProEt) (h : V' ⟶ V),
        (∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        ∃ hO' : V' ⟶ wcOpenRestr (wcP1Over K).left O V,
          hO' ≫ wcOpenRestrIncl (wcP1Over K).left O V = h :=
      fun V' h hV' => fac V V' h (fun v => (hO _).2 (hV' v))
    choose g hg using hfac
    have hcompat : ∀ (V₁ V₂ : (wcP1Over K).left.ProEt) (k : V₂ ⟶ V₁) (h : V₁ ⟶ V)
        (hV₁ : ∀ (v : V₁.left) (i : Fin m), V₁.hom v ≠ S i (IsLocalRing.closedPoint K))
        (hV₂ : ∀ (v : V₂.left) (i : Fin m), V₂.hom v ≠ S i (IsLocalRing.closedPoint K)),
        ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map k.op).hom
          (((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map (g V₁ h hV₁).op).hom y) =
          ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map (g V₂ (k ≫ h) hV₂).op).hom y := by
      intro V₁ V₂ k h hV₁ hV₂
      have e : k ≫ g V₁ h hV₁ = g V₂ (k ≫ h) hV₂ :=
        uniq V _ _ _ (by rw [Category.assoc, hg, hg])
      rw [← e, hres (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])) k (g V₁ h hV₁) y]
    obtain ⟨f, hf⟩ := wc_P1_contSheaf_extend_family K ℓ r m S hS V
      (fun V' h hV' => ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map
        (g V' h hV').op).hom y) hcompat
    have hTO : ∀ (v : (wcOpenRestr (wcP1Over K).left O V).left) (i : Fin m),
        (wcOpenRestr (wcP1Over K).left O V).hom v ≠ S i (IsLocalRing.closedPoint K) :=
      fun v => (hO _).1 (hinO V v)
    have hid : g _ (wcOpenRestrIncl (wcP1Over K).left O V) hTO = 𝟙 _ :=
      uniq V _ _ _ (by rw [hg, Category.id_comp])
    refine ⟨f, (hf _ (wcOpenRestrIncl (wcP1Over K).left O V) hTO).trans ?_⟩
    beta_reduce
    rw [hid, op_id, CategoryTheory.Functor.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]

  have gcs : ∀ (V : (wcP1Over K).left.ProEt) (gV : V ⟶ wcGeomPoint K (wcP1Over K) hP)
      (y : (Subobject.underlying.obj B).obj.obj
        (Opposite.op (wcOpenRestr (wcP1Over K).left O V))),
      ∃ x, ((Subobject.underlying.obj B).obj.map
        (wcOpenRestrIncl (wcP1Over K).left O V).op).hom x = y := by
    intro V gV y
    obtain ⟨r, ⟨φ⟩⟩ := hB
    let U₁ : Over (wcGeomPoint K (wcP1Over K) hP) := Over.mk gV
    let U₀ : Over (wcGeomPoint K (wcP1Over K) hP) :=
      Over.mk (wcOpenRestrIncl (wcP1Over K).left O V ≫ gV)
    let j : U₀ ⟶ U₁ := Over.homMk (wcOpenRestrIncl (wcP1Over K).left O V) rfl
    obtain ⟨f, hf⟩ := extΛ r V ((φ.hom.hom.app (Opposite.op U₀)).hom y)
    refine ⟨(φ.inv.hom.app (Opposite.op U₁)).hom f, ?_⟩
    have h1 : ((Subobject.underlying.obj B).obj.map
        (wcOpenRestrIncl (wcP1Over K).left O V).op).hom ((φ.inv.hom.app (Opposite.op U₁)).hom f) =
        (φ.inv.hom.app (Opposite.op U₀)).hom (((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map
          (wcOpenRestrIncl (wcP1Over K).left O V).op).hom f) := by
      have := congrArg (fun q => q.hom f) (φ.inv.hom.naturality j.op)
      exact this.symm
    have h2 : (φ.inv.hom.app (Opposite.op U₀)).hom ((φ.hom.hom.app (Opposite.op U₀)).hom y) = y := by
      have := congrArg (fun q => q.hom y)
        (((sheafToPresheaf _ _).mapIso φ).hom_inv_id_app (Opposite.op U₀))
      exact this
    rw [h1, hf, h2]

  have cover : ∀ (T : (wcP1Over K).left.ProEt), ∃ (T' : (wcP1Over K).left.ProEt) (a : T' ⟶ T)
      (_ : T' ⟶ wcGeomPoint K (wcP1Over K) hP),
      ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (x : G.obj.obj (Opposite.op T)), (G.obj.map a.op).hom x = 0 → x = 0 := by
    intro T
    haveI hTp : WeaklyEtale T.hom := T.prop
    haveI hPp : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom := hP
    haveI hPq : QuasiCompact (wcGeomPoint K (wcP1Over K) hP).hom := by
      show QuasiCompact (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      infer_instance
    haveI hPs : Surjective (wcGeomPoint K (wcP1Over K) hP).hom := by
      show Surjective (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      infer_instance
    haveI hfst : WeaklyEtale (Limits.pullback.fst T.hom (wcGeomPoint K (wcP1Over K) hP).hom) :=
      inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst T.hom (wcGeomPoint K (wcP1Over K) hP).hom) :=
      inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst T.hom (wcGeomPoint K (wcP1Over K) hP).hom ≫ T.hom) :=
      inferInstance
    let T' : (wcP1Over K).left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst T.hom (wcGeomPoint K (wcP1Over K) hP).hom ≫ T.hom)
    let a : T' ⟶ T := MorphismProperty.Over.homMk
      (Limits.pullback.fst T.hom (wcGeomPoint K (wcP1Over K) hP).hom) rfl trivial
    let g : T' ⟶ wcGeomPoint K (wcP1Over K) hP := MorphismProperty.Over.homMk
      (Limits.pullback.snd T.hom (wcGeomPoint K (wcP1Over K) hP).hom)
      Limits.pullback.condition.symm trivial
    refine ⟨T', a, g, ?_⟩
    intro G x hx
    have hsurj : ∀ z : T.left, ∃ (_ : PUnit.{u+2}) (y : T'.left), a.left y = z := by
      intro z
      obtain ⟨w, hw⟩ := hPs.surj (T.hom z)
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z w hw.symm
      exact ⟨PUnit.unit, τ, hτ⟩
    haveI hae : WeaklyEtale a.left := hfst
    haveI haq : QuasiCompact a.left := hfstq
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => T'.left) (fun _ => a.left)
        hsurj (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hRc : Presieve.ofArrows (fun _ : PUnit.{u+2} => T'.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings T.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget (wcP1Over K).left ⋙
      Over.forget (wcP1Over K).left) (Y := fun _ : PUnit.{u+2} => T') (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => T') (fun _ => a) ∈
        (Scheme.ProEt.precoverage (wcP1Over K).left).coverings T :=
      Precoverage.mem_comap_iff.mpr (e ▸ hRc)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => T') (fun _ => a)) ∈
        (Scheme.ProEt.topology (wcP1Over K).left) T :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine Sheaf.isSeparated G T _ hRJ x 0 ?_
    rintro Y f ⟨Y', h, k, hk, rfl⟩
    rcases hk with ⟨i⟩
    change (G.obj.map (h ≫ a).op).hom x = (G.obj.map (h ≫ a).op).hom 0
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hx, map_zero,
      map_zero]

  have core : ∀ (V : (wcP1Over K).left.ProEt) (gV : V ⟶ wcGeomPoint K (wcP1Over K) hP)
      (t : (Subobject.underlying.obj A).obj.obj (Opposite.op V)),
      ((Limits.cokernel.π (Subobject.ofLE B A hBA)).hom.app
        (Opposite.op (wcOpenRestr (wcP1Over K).left O V))).hom
        (((Subobject.underlying.obj A).obj.map (wcOpenRestrIncl (wcP1Over K).left O V).op).hom t) = 0 →
      ((Limits.cokernel.π (Subobject.ofLE B A hBA)).hom.app (Opposite.op V)).hom t = 0 := by
    intro V gV t ht
    obtain ⟨b, hb⟩ := monoExact (Subobject.ofLE B A hBA) inferInstance _ _ ht
    obtain ⟨b', hb'⟩ := gcs V gV b
    have hc0 : ((A.arrow).hom.app (Opposite.op V)).hom
        (t - ((Subobject.ofLE B A hBA).hom.app (Opposite.op V)).hom b') = 0 := by
      apply hR V gV
      intro V'' h hV''
      obtain ⟨hO'', hh⟩ := fac V V'' h (fun v => (hO _).2 (hV'' v))
      rw [← hh, hres R hO'' (wcOpenRestrIncl (wcP1Over K).left O V), hnat A.arrow, map_sub,
        hnat (Subobject.ofLE B A hBA), hb', hb, sub_self, map_zero, map_zero]
    have h1 : t - ((Subobject.ofLE B A hBA).hom.app (Opposite.op V)).hom b' = 0 :=
      monoInj A.arrow inferInstance _ _ hc0
    rw [sub_eq_zero.mp h1]
    exact cokComp _ _ _

  intro T x hx
  obtain ⟨T', a, g, hdet⟩ := cover T
  refine hdet _ x ?_
  obtain ⟨aO, haO⟩ := mapO T T' a
  have hx' : ((Limits.cokernel (Subobject.ofLE B A hBA)).obj.map
      (wcOpenRestrIncl (wcP1Over K).left O T').op).hom
      (((Limits.cokernel (Subobject.ofLE B A hBA)).obj.map a.op).hom x) = 0 := by
    rw [← hres (Limits.cokernel (Subobject.ofLE B A hBA)) (wcOpenRestrIncl (wcP1Over K).left O T') a,
      ← haO, hres (Limits.cokernel (Subobject.ofLE B A hBA)) aO (wcOpenRestrIncl (wcP1Over K).left O T),
      hx, map_zero]
  haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology (wcP1Over K).left)
      (Limits.cokernel.π (Subobject.ofLE B A hBA)).hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mpr inferInstance
  have hI := Presheaf.imageSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
    (Limits.cokernel.π (Subobject.ofLE B A hBA)).hom (U := Opposite.op T')
    (((Limits.cokernel (Subobject.ofLE B A hBA)).obj.map a.op).hom x)
  refine Sheaf.isSeparated _ T' _ hI _ 0 ?_
  intro Y f hf
  obtain ⟨t, ht⟩ := hf
  have ht2 : ((Limits.cokernel.π (Subobject.ofLE B A hBA)).hom.app (Opposite.op Y)).hom t =
      ((Limits.cokernel (Subobject.ofLE B A hBA)).obj.map f.op).hom
        (((Limits.cokernel (Subobject.ofLE B A hBA)).obj.map a.op).hom x) := ht
  obtain ⟨fO, hfO⟩ := mapO T' Y f
  have hcore := core Y (f ≫ g) t (by
    rw [← hnat (Limits.cokernel.π (Subobject.ofLE B A hBA)), ht2,
      ← hres (Limits.cokernel (Subobject.ofLE B A hBA)) (wcOpenRestrIncl (wcP1Over K).left O Y) f,
      ← hfO, hres (Limits.cokernel (Subobject.ofLE B A hBA)) fO (wcOpenRestrIncl (wcP1Over K).left O T'),
      hx', map_zero])
  rw [ht2] at hcore
  rw [map_zero]
  exact hcore

theorem wc_proet_theta_subsheaf (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])) :
    ∃ M : Subobject G,
      (∀ (T : S.ProEt) (x : G.obj.obj (Opposite.op T)),
        (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
          (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔ wcThetaCond S ℓ G W N θ U T x) ∧
      ∀ (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : H ⟶ G),
        (∀ (T : S.ProEt) (x : H.obj.obj (Opposite.op T)),
          wcThetaCond S ℓ G W N θ U T ((φ.hom.app (Opposite.op T)).hom x)) →
        ∃ ψ : H ⟶ Subobject.underlying.obj M, ψ ≫ M.arrow = φ :=
by
  classical


  have hcov : ∀ (T : S.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology S T →
      ∀ τ : T.left, ∃ (W' : S.ProEt) (f : W' ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left := by
    intro T R hR τ
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows g →
        ∃ (W' : S.ProEt) (f : W' ⟶ T) (e : Z ⟶ W'.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W', φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W', φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget S) (Scheme.ProEt.topology S)
          (Scheme.proetaleTopology.over S)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition
        (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W' f e hf he using fun j => fact (𝒰.f j) (hmem j)
    obtain ⟨Ua, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hτ' : τ ∈ (Ua : Set T.left) := hτU
    rw [← hUeq] at hτ'
    obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
    refine ⟨W' (c i), f (c i), hf _, e (c i) z, ?_⟩
    rw [← hzτ, he (c i), Scheme.Hom.comp_apply]

  have hres : ∀ (T T' : S.ProEt) (k : T' ⟶ T) (x : G.obj.obj (Opposite.op T)),
      wcThetaCond S ℓ G W N θ U T x →
        wcThetaCond S ℓ G W N θ U T' ((G.obj.map k.op).hom x) := by
    intro T T' k x hx V h h' z
    have e : (G.obj.map h.op).hom ((G.obj.map k.op).hom x) = (G.obj.map (h ≫ k).op).hom x := by
      rw [op_comp, G.obj.map_comp]
      rfl
    show wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
      ((G.obj.map h.op).hom ((G.obj.map k.op).hom x))) z ∈ U
    rw [e]
    exact hx V (h ≫ k) h' z

  have hloc : ∀ (T : S.ProEt) (x : G.obj.obj (Opposite.op T)) (R : Sieve T),
      R ∈ Scheme.ProEt.topology S T →
      (∀ (Y : S.ProEt) (f : Y ⟶ T), R.arrows f →
        wcThetaCond S ℓ G W N θ U Y ((G.obj.map f.op).hom x)) →
      wcThetaCond S ℓ G W N θ U T x := by
    intro T x R hR hx V h h' z
    obtain ⟨V', f', hf', w, hw⟩ :=
      hcov V (R.pullback h) (GrothendieckTopology.pullback_stable _ h hR) z
    have h1 : wcContEval S V' ((θ.hom.hom.app (Opposite.op (Over.mk (f' ≫ h')))).hom
        ((G.obj.map (𝟙 V').op).hom ((G.obj.map (f' ≫ h).op).hom x))) w ∈ U :=
      hx V' (f' ≫ h) hf' V' (𝟙 V') (f' ≫ h') w
    have e1 : (G.obj.map (𝟙 V').op).hom ((G.obj.map (f' ≫ h).op).hom x) =
        (G.obj.map f'.op).hom ((G.obj.map h.op).hom x) := by
      rw [op_id, G.obj.map_id, op_comp, G.obj.map_comp]
      rfl
    have hnat : (θ.hom.hom.app (Opposite.op (Over.mk (f' ≫ h')))).hom
          ((G.obj.map f'.op).hom ((G.obj.map h.op).hom x)) =
        (((wcContSheaf S (Fin N → ℚ_[ℓ])).over W).obj.map
          (Over.homMk f' : Over.mk (f' ≫ h') ⟶ Over.mk h').op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)) := by
      have := θ.hom.hom.naturality (Over.homMk f' : Over.mk (f' ≫ h') ⟶ Over.mk h').op
      exact congrArg (fun φ => φ.hom ((G.obj.map h.op).hom x)) this
    rw [e1, hnat] at h1
    rw [← hw]
    exact h1

  let Q : ∀ T : S.ProEt, AddSubgroup (G.obj.obj (Opposite.op T)) := fun T =>
    { carrier := {x | wcThetaCond S ℓ G W N θ U T x}
      zero_mem' := by
        intro V h h' z
        have e1 : (G.obj.map h.op).hom 0 = 0 := map_zero _
        have e : (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom 0) = 0 :=
          (congrArg (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom e1).trans (map_zero _)
        show wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          ((G.obj.map h.op).hom 0)) z ∈ U
        rw [e]
        exact U.zero_mem
      add_mem' := by
        intro a b ha hb V h h' z
        have e1 : (G.obj.map h.op).hom (a + b) =
            (G.obj.map h.op).hom a + (G.obj.map h.op).hom b := map_add _ _ _
        have e2 : (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              ((G.obj.map h.op).hom a + (G.obj.map h.op).hom b) =
            (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom a) +
              (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom b) :=
          map_add _ _ _
        show wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          ((G.obj.map h.op).hom (a + b))) z ∈ U
        rw [e1, e2]
        exact U.add_mem (ha V h h' z) (hb V h h' z)
      neg_mem' := by
        intro a ha V h h' z
        have e1 : (G.obj.map h.op).hom (-a) = -(G.obj.map h.op).hom a := map_neg _ _
        have e2 : (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom (-(G.obj.map h.op).hom a) =
            -(θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom a) :=
          map_neg _ _
        show wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          ((G.obj.map h.op).hom (-a))) z ∈ U
        rw [e1, e2]
        exact U.neg_mem (ha V h h' z) }

  let P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun T => AddCommGrpCat.of (Q T.unop)
      map := fun {T T'} g => AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
        ((G.obj.map g).hom.comp (Q T.unop).subtype) (Q T'.unop)
          (fun x => hres T.unop T'.unop g.unop x.1 x.2))
      map_id := fun T => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change G.obj.map (𝟙 T) x.1 = x.1
        rw [G.obj.map_id]
        rfl
      map_comp := fun {T T' T''} f g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change G.obj.map (f ≫ g) x.1 = G.obj.map g (G.obj.map f x.1)
        rw [G.obj.map_comp]
        rfl }
  let α : P ⟶ G.obj :=
    { app := fun T => AddCommGrpCat.ofHom (Q T.unop).subtype
      naturality := fun _ _ _ => rfl }

  have hGt : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget AddCommGrpCat.{u+1})).mp G.property)
  have hPt : Presieve.IsSheaf (Scheme.ProEt.topology S) (P ⋙ forget AddCommGrpCat.{u+1}) := by
    intro T R hR x hx
    let y : Presieve.FamilyOfElements (G.obj ⋙ forget AddCommGrpCat.{u+1}) (R : Presieve T) :=
      fun Y f hf => (x f hf).1
    have hy : y.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      exact congrArg Subtype.val (hx g₁ g₂ h₁ h₂ comm)
    obtain ⟨t, ht, htu⟩ := hGt R hR y hy
    have htQ : t ∈ Q T := hloc T t R hR (fun Y f hf => by
      have e : (G.obj.map f.op).hom t = (x f hf).1 := ht f hf
      rw [e]
      exact (x f hf).2)
    refine ⟨⟨t, htQ⟩, ?_, ?_⟩
    · intro Y f hf
      apply Subtype.ext
      exact ht f hf
    · intro t' ht'
      apply Subtype.ext
      apply htu
      intro Y f hf
      exact congrArg Subtype.val (ht' f hf)
  have hP : Presheaf.IsSheaf (Scheme.ProEt.topology S) P :=
    (Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget AddCommGrpCat.{u+1})).mpr
      ((isSheaf_iff_isSheaf_of_type _ _).mpr hPt)
  let Ps : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} := ⟨P, hP⟩
  let ι : Ps ⟶ G := ObjectProperty.homMk α
  haveI : ∀ T, Mono (α.app T) := fun T =>
    (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
  haveI hαmono : Mono α := NatTrans.mono_of_mono_app α
  haveI : Mono ι :=
    Functor.mono_of_mono_map (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      hαmono

  refine ⟨Subobject.mk ι, fun T x => ⟨?_, ?_⟩, ?_⟩
  · rintro ⟨x', rfl⟩
    have key := congrArg
      (fun (f : Subobject.underlying.obj (Subobject.mk ι) ⟶ G) => (f.hom.app (Opposite.op T)).hom x')
      (Subobject.underlyingIso_hom_comp_eq_mk ι)
    have hmem := (((Subobject.underlyingIso ι).hom.hom.app (Opposite.op T)).hom x').2
    have e : ((Subobject.mk ι).arrow.hom.app (Opposite.op T)).hom x' =
        (((Subobject.underlyingIso ι).hom.hom.app (Opposite.op T)).hom x').1 := key.symm
    rw [e]
    exact hmem
  · intro hx
    refine ⟨((Subobject.underlyingIso ι).inv.hom.app (Opposite.op T)).hom
      (show ↥(Q T) from ⟨x, hx⟩), ?_⟩
    have key := congrArg
      (fun (f : Ps ⟶ G) => (f.hom.app (Opposite.op T)).hom (show ↥(Q T) from ⟨x, hx⟩))
      (Subobject.underlyingIso_arrow ι)
    exact key
  · intro H φ hφ
    let ψ₀ : H.obj ⟶ P :=
      { app := fun T => AddCommGrpCat.ofHom
          (AddMonoidHom.codRestrict (φ.hom.app T).hom (Q T.unop) (fun s => hφ T.unop s))
        naturality := fun T T' g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro s
          apply Subtype.ext
          exact NatTrans.naturality_apply φ.hom g s }
    refine ⟨ObjectProperty.homMk ψ₀ ≫ (Subobject.underlyingIso ι).inv, ?_⟩
    rw [Category.assoc, Subobject.underlyingIso_arrow]
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro s
    rfl

theorem wc_kss_values_in_U (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hU' : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (T : S.ProEt) (g : T ⟶ B₀) (x : G.obj.obj (Opposite.op T))
    (f : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op T))
    (hf : ∀ z : T.left, wcContEval S T f z ∈ U)
    (hrel : ∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
      (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map h.op).hom f) :
    ∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W) (z : V.left),
      (∃ p : W.left, w.left p = g.left (h.left z)) →
      wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)) z ∈ U :=
by
  classical
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      {A B C : S.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : S.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+ (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hN : ∀ (V V' : S.ProEt) (k : V' ⟶ V) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V)),
      Θ V' (k ≫ h') ((G.obj.map k.op).hom y) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map k.op).hom (Θ V h' y) := by
    intro V V' k h' y
    rw [hΘ, hΘ]
    exact congrArg (fun φ => φ.hom y)
      (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)

  have bc : ∀ (B W' : S.ProEt) (w' : W' ⟶ B) (V : S.ProEt) (g' : V ⟶ B),
      ∃ (V₁ : S.ProEt) (a : V₁ ⟶ V) (b : V₁ ⟶ W'), a ≫ g' = b ≫ w' ∧
        ∀ z : V.left, (∃ p : W'.left, w'.left p = g'.left z) → ∃ y : V₁.left, a.left y = z := by
    intro B W' w' V g'
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w'.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w']; exact hWp
    haveI : WeaklyEtale w'.left := WeaklyEtale.of_comp w'.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g'.left w'.left ≫ V.hom) := inferInstance
    let V₁ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g'.left w'.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst g'.left w'.left) rfl trivial
    have hb : Limits.pullback.snd g'.left w'.left ≫ W'.hom =
        Limits.pullback.fst g'.left w'.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w', ← MorphismProperty.Over.w g', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : V₁ ⟶ W' :=
      MorphismProperty.Over.homMk (Limits.pullback.snd g'.left w'.left) hb trivial
    refine ⟨V₁, a, b, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · rintro z ⟨p, hp⟩
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩
  intro V h h' z hz
  obtain ⟨p, hp⟩ := hz
  obtain ⟨V₁, p₁, p₂, hsq, hlift⟩ := bc B₀ W w V (h ≫ g)
  have hp' : w.left p = (h ≫ g).left z := by
    rw [hp]
    first | rfl | simp [Scheme.Hom.comp_apply]
  obtain ⟨z₁, hz₁⟩ := hlift z ⟨p, hp'⟩
  have hcompat : p₂ ≫ w = (p₁ ≫ h) ≫ g := by
    rw [← hsq, Category.assoc]
  have hR := hrel V₁ (p₁ ≫ h) p₂ hcompat
  have hU1 : ∀ z' : V₁.left, wcContEval S V₁ ((θ.hom.hom.app (Opposite.op (Over.mk p₂))).hom
      ((G.obj.map (p₁ ≫ h).op).hom x)) z' ∈ U := by
    intro z'
    rw [hR]
    exact hf _
  have hU2 := hU' V₁ p₂ (p₁ ≫ h') _ hU1 z₁
  rw [← hF G p₁ h x, ← hΘ V₁ (p₁ ≫ h'), hN, hΘ] at hU2
  rw [← hz₁]
  exact hU2

theorem wc_kss_geomConst_of_extension (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (N : ℕ)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hU : ∀ (V₀ : (wcP1Over K).left.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
      (x : G.obj.obj (Opposite.op V₀)),
      (∀ z : V₀.left, wcContEval (wcP1Over K).left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V₀.left, wcContEval (wcP1Over K).left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (hfix : ∀ (V₀ : (wcP1Over K).left.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
      (x : G.obj.obj (Opposite.op V₀)),
      (∀ z : V₀.left, wcContEval (wcP1Over K).left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V₀.left,
        wcContEval (wcP1Over K).left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval (wcP1Over K).left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z)
    (M : Subobject G)
    (hM : ∀ (T : (wcP1Over K).left.ProEt) (x : G.obj.obj (Opposite.op T)),
      (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
        (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔
        wcThetaCond (wcP1Over K).left ℓ G W N θ U T x)
    (huniq : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        (G.obj.map h.op).hom x = 0) → x = 0)
    (hext : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (xs : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        G.obj.obj (Opposite.op V)),
      (∀ (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h : V ⟶ T)
        (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K))
        (hV' : ∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)),
        (G.obj.map k.op).hom (xs V h hV) = xs V' (k ≫ h) hV') →
      ∃ x : G.obj.obj (Opposite.op T),
        ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T)
          (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)),
          (G.obj.map h.op).hom x = xs V h hV) :
    wcPencilGC K hP ℓ (Subobject.underlying.obj M) :=
by
  classical
  obtain ⟨hU', hfix'⟩ := wc_kss_frame_change (wcP1Over K).left ℓ (wcGeomPoint K (wcP1Over K) hP)
    W w G N θ U hU hfix
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {A B C : (wcP1Over K).left.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hFid : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {A : (wcP1Over K).left.ProEt} (y : F.obj.obj (Opposite.op A)),
      (F.obj.map (𝟙 A).op).hom y = y := by
    intro F A y
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hCext : ∀ (a : ℕ) (V : (wcP1Over K).left.ProEt)
      (f g : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval (wcP1Over K).left V f z = wcContEval (wcP1Over K).left V g z) → f = g := by
    intro a V f g h
    have : (show ULift.{u+1} C(↥V.left, Fin a → ℚ_[ℓ]) from f) =
        (show ULift.{u+1} C(↥V.left, Fin a → ℚ_[ℓ]) from g) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  have hEv : ∀ (a : ℕ) (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V)
      (f : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V)) (z : V'.left),
      wcContEval (wcP1Over K).left V'
        (((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map k.op).hom f) z =
        wcContEval (wcP1Over K).left V f (k.left z) := fun _ _ _ _ _ _ => rfl
  have hEv0 : ∀ (a : ℕ) (V : (wcP1Over K).left.ProEt) (z : V.left),
      wcContEval (wcP1Over K).left V
        (0 : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V)) z = 0 :=
    fun _ _ _ => rfl
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : (wcP1Over K).left.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+
        (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hN : ∀ (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h' : V ⟶ W)
      (y : G.obj.obj (Opposite.op V)),
      Θ V' (k ≫ h') ((G.obj.map k.op).hom y) =
        ((wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.map k.op).hom (Θ V h' y) := by
    intro V V' k h' y
    rw [hΘ, hΘ]
    exact congrArg (fun φ => φ.hom y)
      (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
  have hI : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (a b : G.obj.obj (Opposite.op V)),
      Θ V h' a = Θ V h' b → a = b := by
    intro V h' a b hab
    rw [hΘ, hΘ] at hab
    have ha : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom a) = a :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom a) θ.hom_inv_id
    have hb : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom b) = b :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom b) θ.hom_inv_id
    rw [← ha, ← hb, hab]
  have hL0 : ∀ (V : (wcP1Over K).left.ProEt) (q : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ z : V.left, ∃ p : W.left, w.left p = q.left z := by
    intro V q hV z
    have e1 : (wcGeomPoint K (wcP1Over K) hP).hom (q.left z) = V.hom z := by
      have h1 : q.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = V.hom := MorphismProperty.Over.w q
      have h2 := congrArg (fun f => f z) h1
      simpa only [Scheme.Hom.comp_apply] using h2
