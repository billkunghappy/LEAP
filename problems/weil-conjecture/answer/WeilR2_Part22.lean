    rw [hto, htk]
  have hle : addOrderOf ω ≤ Nat.card (wcEtZModExt (Spec (.of (Localization.Away
      (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))) (ℓ ^ k) 1) :=
    addOrderOf_le_card
  have hcardeq : addOrderOf ω = Nat.card (wcEtZModExt (Spec (.of (Localization.Away
      (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) (IsLocalRing.ResidueField A))))) (ℓ ^ k) 1) := by
    omega
  let Z := (ZMod.ringEquivCongr (hord.symm.trans hcardeq)).toAddEquiv.trans
    (zmodAddCyclicAddEquiv (isAddCyclic_of_addOrderOf_eq_card ω hcardeq))

  exact ⟨Eχ.trans (L.symm.trans (Spl.trans (AddEquiv.prodCongr (PU.symm.trans Z.symm)
    (PV.symm.trans Z.symm))))⟩

theorem wc_et_tpl_lp_top_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k)) :
    haveI := Dh.additive
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          Dg.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) ≫
        (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    Nonempty (ZMod (ℓ ^ k) ≃+ (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
      (DerivedCategory.Q.obj Ψ)⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧)) :=
by

  have abs : ∀ {𝒞 : Type _} [Category 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory 𝒞}
      (T : Pretriangulated.Triangle (DerivedCategory 𝒞))
      (hT : T ∈ Pretriangulated.distinguishedTriangles)
      (QS : DerivedCategory 𝒞) (ι : T.obj₁ ⟶ QS) (N : ℕ) (R : ℤ) (hR : R = (N : ℤ) + (N : ℤ))
      (hN : 1 ≤ N) (m : ℕ) (hm : 0 < m)
      (hz : Nonempty (T.obj₃⟦(N : ℤ)⟧ ≅ QS))
      (hcard : Finite (QS ⟶ T.obj₂⟦R⟧) ∧ Nat.card (QS ⟶ T.obj₂⟦R⟧) ≤ m)
      (hbig : 2 ≤ N → ∃ θ : QS ⟶ T.obj₁⟦R⟧, ∀ j : ℕ, j • (ι ≫ θ) = 0 → m ∣ j)
      (hvan : 2 ≤ N → ∀ q : ℤ, 0 < q → ∀ f : T.obj₁ ⟶ QS⟦q⟧, f = 0)
      (hend : Finite (QS ⟶ QS) ∧ Nat.card (QS ⟶ QS) ≤ m)
      (hker : N = 1 → m ≠ 1 → ∃ R₀ : ℤ, R₀ = R ∧ ∃ θ : QS ⟶ T.obj₁⟦R₀⟧,
        θ ≫ T.mor₁⟦R₀⟧' = 0 ∧ ∀ j : ℕ, j • θ = 0 → m ∣ j)
      (hsq : N = 1 → m ≠ 1 → Nonempty ((QS ⟶ T.obj₁⟦R⟧) ≃+ ZMod m × ZMod m))
      (hZ : ∀ x : ZMod m × ZMod m, (∀ j : ℕ, j • x = 0 → m ∣ j) →
        ∃ y : ZMod m × ZMod m, ∀ j : ℕ, j • y ∈ AddSubgroup.zmultiples x → m ∣ j),
      Nonempty (ZMod m ≃+ (QS ⟶ T.obj₂⟦R⟧)) := by
    intro 𝒞 _ _ _hD T hT QS ι N R hR hN m hm hz hcard hbig hvan hend hker hsq hZ
    obtain ⟨σ⟩ := hz
    obtain ⟨hfin, hcle⟩ := hcard
    have P0 : ∀ v₀ : QS ⟶ T.obj₂⟦R⟧, (∀ j : ℕ, j • v₀ = 0 → m ∣ j) →
        Nonempty (ZMod m ≃+ (QS ⟶ T.obj₂⟦R⟧)) := by
      intro v₀ hv₀
      have hopos : 0 < addOrderOf v₀ := addOrderOf_pos v₀
      have hmdvd : m ∣ addOrderOf v₀ := hv₀ _ (addOrderOf_nsmul_eq_zero v₀)
      have hle1 : addOrderOf v₀ ≤ Nat.card (QS ⟶ T.obj₂⟦R⟧) := addOrderOf_le_card
      have hmle : m ≤ addOrderOf v₀ := Nat.le_of_dvd hopos hmdvd
      have hord : addOrderOf v₀ = Nat.card (QS ⟶ T.obj₂⟦R⟧) := by omega
      have hcm : m = Nat.card (QS ⟶ T.obj₂⟦R⟧) := by omega
      exact ⟨(ZMod.ringEquivCongr hcm).toAddEquiv.trans
        (zmodAddCyclicAddEquiv (isAddCyclic_of_addOrderOf_eq_card v₀ hord))⟩
    by_cases hm1 : m = 1
    · exact P0 0 (fun j _ => hm1 ▸ one_dvd j)
    have hcancel : ∀ (X : DerivedCategory 𝒞) (k : ℤ) (hk : k + 1 = R) (a : X ⟶ T.obj₁⟦R⟧),
        a ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 R hk).hom.app T.obj₁ = 0 → a = 0 := by
      intro X k hk a ha
      have : a = (a ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 R hk).hom.app T.obj₁) ≫
          (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 R hk).inv.app T.obj₁ := by
        rw [Category.assoc, Iso.hom_inv_id_app, Category.comp_id]
      rw [this, ha, Limits.zero_comp]
    have hgen : ∀ (X : DerivedCategory 𝒞) (k : ℤ) (hk : k + 1 = R) (a : X ⟶ T.obj₁⟦R⟧),
        a ≫ T.mor₁⟦R⟧' = 0 →
        ∃ g : X ⟶ T.obj₃⟦k⟧,
          a ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 R hk).hom.app T.obj₁ =
            g ≫ (k.negOnePow • (T.mor₃⟦k⟧' ≫
              (shiftFunctorComm (DerivedCategory 𝒞) 1 k).hom.app T.obj₁)) := by
      intro X k hk a ha
      have hT' := Pretriangulated.Triangle.shift_distinguished T hT k
      exact Pretriangulated.Triangle.coyoneda_exact₁ _ hT' _ (by
        change (a ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 R hk).hom.app T.obj₁) ≫
          (shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map (k.negOnePow • T.mor₁⟦k⟧') = 0
        have hn := (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 R hk).hom.naturality T.mor₁
        rw [Functor.comp_map] at hn
