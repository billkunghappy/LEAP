  have hE : ∀ (z : T₂.left) (j : Fin m), T₂.hom z ≠ S j (IsLocalRing.closedPoint F'') := by
    intro z j
    rw [← MorphismProperty.Over.w c'₂, Scheme.Hom.comp_apply]
    exact hoffX _ j
  obtain ⟨d₀, hd₀⟩ := wc_pencil_PL_lift_to_cover F'' hP m S W w hcov T₂ L₂ e₂ hE (c'₂ ≫ x)
  exact gen _ _ W w hqc hgal X x hconnX hsurjX T₁ T₂ (e₁.inv (IsLocalRing.closedPoint L₁))
    (e₂.inv (IsLocalRing.closedPoint L₂)) c'₁ c₁ h₁ c'₂ d₀ hd₀

theorem wc_pencil_honest_fix_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP) (hπ : wcPencilConj π)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (H : Fin D.m → Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]))
    (hH : ∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
      (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : V.left ≅ Spec (.of A)),
      V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
      ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ W) (z : V'.left),
        a ≫ v = b ≫ w ∧
        (∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
          (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = 0 → s = 0) ∧
        ∀ x : Fin r → ℚ_[ℓ], x ∈ H i ↔
          ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
            (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
              (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = x)
    (i i' : Fin D.m) :
    ∃ (σ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      σ ≫ w = w ∧ wcHonestFrame D ℓ W r θ σ g ∧ ∀ x, x ∈ H i ↔ g x ∈ H i' :=
by
  classical

  have rigid : ∀ (X₁ X₂ V : (wcP1Over F'').left.ProEt) (hV : ConnectedSpace V.left) (r₁ r₂ : ℕ)
      (θ₁ : (wcRq D.f ℓ (n - 1)).over X₁ ≅
        (wcContSheaf (wcP1Over F'').left (Fin r₁ → ℚ_[ℓ])).over X₁)
      (θ₂ : (wcRq D.f ℓ (n - 1)).over X₂ ≅
        (wcContSheaf (wcP1Over F'').left (Fin r₂ → ℚ_[ℓ])).over X₂)
      (p : V ⟶ X₁) (q : V ⟶ X₂),
      ∃ B : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]), Function.Injective B ∧
        ∀ (V'' : (wcP1Over F'').left.ProEt) (h : V'' ⟶ V)
          (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'')) (z : V''.left),
          (show C(↥V''.left, Fin r₂ → ℚ_[ℓ]) from
            ((θ₂.hom.hom.app (Opposite.op (Over.mk (h ≫ q)))).hom t).down) z =
          B ((show C(↥V''.left, Fin r₁ → ℚ_[ℓ]) from
            ((θ₁.hom.hom.app (Opposite.op (Over.mk (h ≫ p)))).hom t).down) z) := by
    intro X₁ X₂ V hV r₁ r₂ θ₁ θ₂ p q
    let θp : (wcRq D.f ℓ (n - 1)).over V ⟶
        (wcContSheaf (wcP1Over F'').left (Fin r₁ → ℚ_[ℓ])).over V :=
      ⟨{ app := fun T => θ₁.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ p)))
         naturality := fun X Y f => θ₁.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ p = Y.unop.hom ≫ p
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ p) ⟶ Over.mk (X.unop.hom ≫ p)).op }⟩
    let θpi : (wcContSheaf (wcP1Over F'').left (Fin r₁ → ℚ_[ℓ])).over V ⟶
        (wcRq D.f ℓ (n - 1)).over V :=
      ⟨{ app := fun T => θ₁.inv.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ p)))
         naturality := fun X Y f => θ₁.inv.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ p = Y.unop.hom ≫ p
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ p) ⟶ Over.mk (X.unop.hom ≫ p)).op }⟩
    let θq : (wcRq D.f ℓ (n - 1)).over V ⟶
        (wcContSheaf (wcP1Over F'').left (Fin r₂ → ℚ_[ℓ])).over V :=
      ⟨{ app := fun T => θ₂.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ q)))
         naturality := fun X Y f => θ₂.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ q = Y.unop.hom ≫ q
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ q) ⟶ Over.mk (X.unop.hom ≫ q)).op }⟩
    let θqi : (wcContSheaf (wcP1Over F'').left (Fin r₂ → ℚ_[ℓ])).over V ⟶
        (wcRq D.f ℓ (n - 1)).over V :=
      ⟨{ app := fun T => θ₂.inv.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ q)))
         naturality := fun X Y f => θ₂.inv.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ q = Y.unop.hom ≫ q
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ q) ⟶ Over.mk (X.unop.hom ≫ q)).op }⟩
    have c1 : ∀ (T : Over V) (s : ((wcRq D.f ℓ (n - 1)).over V).obj.obj (Opposite.op T)),
        (θpi.hom.app (Opposite.op T)).hom ((θp.hom.app (Opposite.op T)).hom s) = s := fun T s =>
      congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (T.hom ≫ p)))).hom s) θ₁.hom_inv_id
    have c2 : ∀ (T : Over V) (s : ((wcRq D.f ℓ (n - 1)).over V).obj.obj (Opposite.op T)),
        (θqi.hom.app (Opposite.op T)).hom ((θq.hom.app (Opposite.op T)).hom s) = s := fun T s =>
      congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (T.hom ≫ q)))).hom s) θ₂.hom_inv_id
    have c3 : ∀ (T : Over V)
        (c : ((wcContSheaf (wcP1Over F'').left (Fin r₁ → ℚ_[ℓ])).over V).obj.obj (Opposite.op T)),
        (θp.hom.app (Opposite.op T)).hom ((θpi.hom.app (Opposite.op T)).hom c) = c := fun T c =>
      congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (T.hom ≫ p)))).hom c) θ₁.inv_hom_id
    obtain ⟨B, hB⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ V hV r₁ r₂ (θpi ≫ θq)
    obtain ⟨B', hB'⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ V hV r₂ r₁ (θqi ≫ θp)
    have hPt : ∀ (T : Over V)
        (c : (wcContSheaf (wcP1Over F'').left (Fin r₁ → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin r₂ → ℚ_[ℓ]) from
          (((θpi ≫ θq).hom.app (Opposite.op T)).hom c).down) t =
          B ((show C(↥T.left.left, Fin r₁ → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hB]
      rfl
    have hPt' : ∀ (T : Over V)
        (c : (wcContSheaf (wcP1Over F'').left (Fin r₂ → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin r₁ → ℚ_[ℓ]) from
          (((θqi ≫ θp).hom.app (Opposite.op T)).hom c).down) t =
          B' ((show C(↥T.left.left, Fin r₂ → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hB']
      rfl
    obtain ⟨z₀⟩ : Nonempty V.left := @ConnectedSpace.toNonempty _ _ hV
    have hBB : ∀ y, B' (B y) = y := by
      intro y
      let c : (wcContSheaf (wcP1Over F'').left (Fin r₁ → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
        ULift.up (ContinuousMap.const ↥V.left y)
      have e1 := hPt (Over.mk (𝟙 V)) c z₀
      have e2 := hPt' (Over.mk (𝟙 V))
        (((θpi ≫ θq).hom.app (Opposite.op (Over.mk (𝟙 V)))).hom c) z₀
      have e3 : ((θqi ≫ θp).hom.app (Opposite.op (Over.mk (𝟙 V)))).hom
          (((θpi ≫ θq).hom.app (Opposite.op (Over.mk (𝟙 V)))).hom c) = c :=
        (congrArg (θp.hom.app (Opposite.op (Over.mk (𝟙 V)))).hom
          (c2 (Over.mk (𝟙 V)) ((θpi.hom.app (Opposite.op (Over.mk (𝟙 V)))).hom c))).trans
