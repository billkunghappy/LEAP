            (CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y)) ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            ((Hq'.commShiftIso ((N : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
          ((F.mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso ((N : ℕ) : ℤ)).hom.app
            (Hq'.obj I.cochainComplex) ≫
          ((F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app I.cochainComplex)⟦((N : ℕ) : ℤ)⟧' ≫
          (Hq.map ((Functor.mapHomologicalComplexCompIso (Iso.refl F) (ComplexShape.up ℤ)).inv.app
              I.cochainComplex))⟦((N : ℕ) : ℤ)⟧')
    let β := fun y : wcEtZModExt S' m N =>
      (show DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing Z m))) ⟶ (DerivedCategory.Q.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        (DerivedCategory.quotientCompQhIso _).inv.app _ ≫ DerivedCategory.Qh.map (c y) ≫
          (DerivedCategory.Qh.commShiftIso ((N : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
          ((DerivedCategory.quotientCompQhIso _).hom.app Ψ)⟦((N : ℕ) : ℤ)⟧')
    ∀ y y' : wcEtZModExt S' m N, wcEtPull Dw N y = y' →
      β y' = β y ≫ (DerivedCategory.Q.map TΨ)⟦((N : ℕ) : ℤ)⟧' :=
by
  intro α hφ t ht P K eK eΨ Ψ Pw γ Tflat T TΨ F Hq Hq' c β y y' hy
  haveI := Df.cont
  haveI := Dw.cont
  haveI := Df.additive
  haveI := Dw.additive
  haveI := Dg.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  haveI hPadd : P.Additive := Adjunction.right_adjoint_additive Df.adj
  haveI hPwadd : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Z m))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' m)) := HasExt.standard _



  have s6 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞],
      letI := HasDerivedCategory.standard 𝒞
      ∀ (A Ψ0 : CochainComplex 𝒞 ℤ) (n : ℤ) (f0 : Ψ0 ⟶ Ψ0)
        (c₁ c₂ : (HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj A ⟶
          ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj Ψ0)⟦n⟧),
        c₂ = c₁ ≫ ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).map f0)⟦n⟧' →
        (DerivedCategory.quotientCompQhIso 𝒞).inv.app A ≫ DerivedCategory.Qh.map c₂ ≫
            (DerivedCategory.Qh.commShiftIso n).hom.app
              ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj Ψ0) ≫
            ((DerivedCategory.quotientCompQhIso 𝒞).hom.app Ψ0)⟦n⟧' =
          ((DerivedCategory.quotientCompQhIso 𝒞).inv.app A ≫ DerivedCategory.Qh.map c₁ ≫
            (DerivedCategory.Qh.commShiftIso n).hom.app
              ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj Ψ0) ≫
            ((DerivedCategory.quotientCompQhIso 𝒞).hom.app Ψ0)⟦n⟧') ≫
            (DerivedCategory.Q.map f0)⟦n⟧' := by
    intro 𝒞 _ _
    letI := HasDerivedCategory.standard 𝒞
    intro A Ψ0 n f0 c₁ c₂ h
    subst h
    have hn := (DerivedCategory.quotientCompQhIso 𝒞).hom.naturality f0
    simp only [Functor.comp_map] at hn
    simp only [Functor.map_comp, Category.assoc]
    rw [Functor.commShiftIso_hom_naturality_assoc, ← Functor.map_comp, hn, Functor.map_comp]



  have s4 : ∀ {V V' W : Type (u+2)} [Category.{u+1} V] [Category.{u+1} V'] [Category.{u+1} W]
      [Preadditive V] [Preadditive V'] [Preadditive W]
      [Limits.HasZeroObject V] [Limits.HasZeroObject V'] [Limits.HasZeroObject W]
      (F1 : V ⥤ V') (F2 : V' ⥤ W) [F1.Additive] [F2.Additive]
      {A : W} {X : V} (v : A ⟶ (F1 ⋙ F2).obj X) (L : CochainComplex V ℤ) (n : ℤ)
