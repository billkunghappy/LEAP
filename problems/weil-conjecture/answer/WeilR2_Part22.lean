    let ev : (SheafOfModules.unit (wcEtZModRing S' m) ⟶ SheafOfModules.unit (wcEtZModRing S' m)) →
        (wcEtZModRing S' m).obj.obj (Opposite.op T) := fun f =>
      (f.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S' m).obj.obj (Opposite.op T))
    have hlin : ∀ (f : SheafOfModules.unit (wcEtZModRing S' m) ⟶ SheafOfModules.unit (wcEtZModRing S' m))
        (x : (wcEtZModRing S' m).obj.obj (Opposite.op T)),
        @Eq ((wcEtZModRing S' m).obj.obj (Opposite.op T)) ((f.val.app (Opposite.op T)).hom x)
