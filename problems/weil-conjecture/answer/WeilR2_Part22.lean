  have k21 : ∀ {Z} (g : (wcSupRho K hP).obj (wcContSheaf (wcP1Over K).left (Fin r₁ → ℚ_[ℓ])) ⟶ Z),
      (wcSupRho K hP).map (wcSupLin K ℓ in₂) ≫ (wcSupRho K hP).map (wcSupLin K ℓ pr₁) ≫ g = 0 := by
