      rintro _ ⟨z, rfl⟩
      have hz : (W.hom ⁻¹ᵁ O).ι (g₀.left z) ∉ closure ({p : W.left | W.hom p ∈ O} \ Gset) :=
        hZ z
      have hU : (W.hom ⁻¹ᵁ O).ι (g₀.left z) ∈ {p : W.left | W.hom p ∈ O} := by
        have h0 : (W.hom ⁻¹ᵁ O).ι (g₀.left z) ∈ Set.range (W.hom ⁻¹ᵁ O).ι := ⟨_, rfl⟩
        rw [Scheme.Opens.range_ι] at h0
        exact h0
      have hG : (W.hom ⁻¹ᵁ O).ι (g₀.left z) ∈ Gset := by
        by_contra hn
