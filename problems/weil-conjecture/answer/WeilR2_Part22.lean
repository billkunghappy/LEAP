          ∀ j : ℕ, j • (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
            (wcEtSuppUnitMap Dx)) ≫ θ) = 0 → ℓ ^ k ∣ j  := by
      intro Xs xs Dx N θ₀ hθ
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Xs (ℓ ^ k)))
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Xs (ℓ ^ k))) := HasExt.standard _
      let ι := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing Xs (ℓ ^ k))) 0
