theorem wc_npr_punct_affine_etale_order (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓK : ((ℓ : ℕ) : K) ≠ 0) (k : ℕ) (hk : 1 ≤ k) (μ q : ℕ) (hμ : 1 ≤ μ)
    (hq : q + 1 = 2 * μ) :
    ∃ (U₀ : (Spec (.of (MvPolynomial (Fin μ) K))).Opens)
      (_ : (U₀ : Set ↥(Spec (.of (MvPolynomial (Fin μ) K)))) = (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin μ) K →+* K))))ᶜ)
      (ω : wcEtZModExt U₀.toScheme (ℓ ^ k) q),
      ∀ (S : Scheme.{u}) (φ : S ⟶ Spec (.of (MvPolynomial (Fin μ) K))), Etale φ →
        ∀ s : S, φ s ∈ Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin μ) K →+* K))) →
        ∀ (φo : (φ ⁻¹ᵁ U₀).toScheme ⟶ U₀.toScheme), φo ≫ U₀.ι = (φ ⁻¹ᵁ U₀).ι ≫ φ →
        ∀ (Dφ : wcEtPullData φo (ℓ ^ k)) (j : ℕ), j • wcEtPull Dφ q ω = 0 → ℓ ^ k ∣ j :=
by
  classical

  have c1 : ∀ {W ZW YO : Scheme.{u}} (iW : ZW ⟶ W) [IsClosedImmersion iW] (gO : YO ⟶ W) [IsOpenImmersion gO], Set.range gO = (Set.range iW)ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D : wcEtPullData iW m) (Dg : wcEtPullData gO m), ∃ c : SheafOfModules.unit (wcEtZModRing YO m) ⟶ Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)), c ≫ Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dg.μ.inv ∧ ∀ k : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W m)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO m)) := HasExt.standard _; letI : Dg.Φ.Additive := Dg.additive; letI : Limits.PreservesFiniteLimits Dg.Φ := Dg.presLim; letI : Limits.PreservesFiniteColimits Dg.Φ := Dg.presColim; Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D)) (SheafOfModules.unit (wcEtZModRing W m)) k => (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k)) := by
    intro W ZW YO iW _ gO _ hrange m hm0 D Dg
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W m)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO m)) := HasExt.standard _
    letI : Dg.Φ.Additive := Dg.additive
    letI : Limits.PreservesFiniteLimits Dg.Φ := Dg.presLim
    letI : Limits.PreservesFiniteColimits Dg.Φ := Dg.presColim
    haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iW D
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
        (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ
    have hB0 : Limits.IsZero (Dg.Φ.obj (wcEtSuppObj D)) := by
      have hsq := IsPullback.of_hasPullback iW gO
      haveI : IsClosedImmersion (Limits.pullback.snd iW gO) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
      have hE : IsEmpty ↥(Limits.pullback iW gO : Scheme.{u}) := by
        apply Scheme.isEmpty_of_commSq hsq.toCommSq
        rw [hrange]
        exact disjoint_compl_right
      obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd iW gO) m
      obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change iW gO (Limits.pullback.snd iW gO)
        (Limits.pullback.fst iW gO) hsq D Dg D'
      have hZ' : Limits.IsZero (wcEtSuppObj D') := by
