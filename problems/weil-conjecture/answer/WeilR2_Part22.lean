    rw [← hinv v, ← hinv w, hvw]
  obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₀ (ℓ ^ k)
  obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists (v₀ ≫ ψ) (ℓ ^ k)
  obtain ⟨Dhh⟩ := wc_et_zmod_pull_data_exists ((v₀ ≫ ψ) ≫ e) (ℓ ^ k)
  obtain ⟨X1⟩ := exc _ _ W φW _ v₀ hv₀ (by
      intro v hv
      rw [hv₀pt]
      apply h2'
      rw [hv, hxpt]) (ℓ ^ k) Dx Dv 2
  obtain ⟨X2⟩ := exc _ _ W ψ (v₀ ≫ ψ) v₀ rfl (by
      intro w hw
      rw [hv₀pt]
      apply h3
      rw [hw]
      show ψ (v₀ _) = ψ w₀
      rw [hv₀pt]) (ℓ ^ k) Dc Dv 2
  obtain ⟨X3⟩ := exc _ _ _ e ((v₀ ≫ ψ) ≫ e) (v₀ ≫ ψ) rfl (by
      intro v hv
      apply einj
      exact hv.trans (comp_ap _ _ _)) (ℓ ^ k) Dhh Dc 2
  let Eχ := X1.trans (X2.symm.trans X3.symm)

  have hVc : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) 2 0
      (c.map (IsLocalRing.residue A))) (MvPolynomial.X p) ∈
      ((v₀ ≫ ψ) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
        (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)))).asIdeal := by
    intro p
    show _ ∈ PrimeSpectrum.asIdeal (ψ (v₀ _))
    rw [hv₀pt]
