      have hcc : ((Dh.μ.inv ≫ ψ) ≫ f) ≫ I.cocomplex.d (n - 1) (n - 1 + 1) = 0 := by
        rw [Category.assoc, hf, Limits.comp_zero]
      have hnorm : Dh.adj.homEquiv _ _ (Dh.μ.hom ≫ (Dh.μ.inv ≫ ψ) ≫ f) = k₀ := by
        rw [← Category.assoc, ← Category.assoc, Iso.hom_inv_id, Category.id_comp,
          Adjunction.homEquiv_naturality_right, hψ]
        try rfl
      have hf' : Dh.adj.homEquiv _ _ (Dh.μ.hom ≫ (Dh.μ.inv ≫ ψ) ≫ f) ≫
          Kn.d (n - 1) (n - 1 + 1) = 0 := by
        rw [hnorm]; exact hk₀
      have hpull : wcEtPull DrQ (n - 1) (I.extMk ((Dh.μ.inv ≫ ψ) ≫ f) (n - 1 + 1) rfl hcc) = 0 := by
        have e1 : I.extMk ((Dh.μ.inv ≫ ψ) ≫ f) (n - 1 + 1) rfl hcc =
            (Abelian.Ext.mk₀ (Dh.μ.inv ≫ ψ)).comp (I.extMk f (n - 1 + 1) rfl hf) (zero_add _) :=
          (I.mk₀_comp_extMk f (n - 1 + 1) rfl hf (Dh.μ.inv ≫ ψ)).symm
        have e2 : wcEtZModCup _ (ℓ ^ k) 0 (n - 1) (n - 1) (zero_add _)
            (Abelian.Ext.mk₀ (Dh.μ.inv ≫ ψ)) (I.extMk f (n - 1 + 1) rfl hf) =
            (Abelian.Ext.mk₀ (Dh.μ.inv ≫ ψ)).comp (I.extMk f (n - 1 + 1) rfl hf) (zero_add _) :=
          Abelian.Ext.bilinearComp_apply_apply _ _ _ _ _ _ _ _ _
        rw [e1, ← e2, wc_et_pull_cup, hy, map_zero]
      have hedge := wc_et_edge_germ_vanish_of_milnor_restr A (Limits.pullback D.f a)
        (Limits.pullback.snd D.f a) (ℓ ^ k) hm _ ξ Dh I x B Λ' W'' φ' a' hsh rQ hrQ1 hrQ2 DrQ
        (n - 1) ((Dh.μ.inv ≫ ψ) ≫ f) hcc hf' hpull
      have key : ∀ (k₁ : SheafOfModules.unit (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k)) ⟶
          Kn.X (n - 1)) (h₁ : k₁ ≫ Kn.d (n - 1) (n - 1 + 1) = 0), k₁ = k₀ →
          Kn.liftCycles k₁ (n - 1 + 1) (by simp) h₁ = Kn.liftCycles k₀ (n - 1 + 1) (by simp) hk₀ := by
        rintro k₁ h₁ rfl; rfl
      rw [← key _ hf' hnorm]
      exact hedge
    · have hsub := wc_et_tpl_rtp_off_node_stalk_vanish F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA
        η hηb hηne ξ hξ x hx Dh I xs hxs z hz (n - 1) (by omega)
      exact (@AddCommGrpCat.isZero_of_subsingleton _ hsub).eq_of_tgt _ _

  have hcl : IsClosed (Set.range (Limits.pullback.fst (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A))) := by
    haveI : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    exact (Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)).isClosedEmbedding.isClosed_range
  have hΦe : Dg.Φ.map (Kn.liftCycles k₀ (n - 1 + 1) (by simp) hk₀ ≫ Kn.homologyπ (n - 1)) = 0 := by
    have himg : Limits.IsZero (Dg.Φ.obj (Limits.image
        (Kn.liftCycles k₀ (n - 1 + 1) (by simp) hk₀ ≫ Kn.homologyπ (n - 1)))) := by
      apply wc_et_pull_isZero_of_range_stalks _ _ Dg _ hcl
      intro s'
      haveI := (wc_et_stalk_exact (Limits.pullback D.f a)
        (Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) s')).1
      haveI := (wc_et_stalk_exact (Limits.pullback D.f a)
        (Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) s')).2
      haveI := sheafOfModules_toSheaf_preservesFiniteColimits _
        (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))
      let Gs := SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k)) ⋙
        wcEtStalk (Limits.pullback D.f a)
          (Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) s')
      have h0 : Gs.map (Limits.factorThruImage
          (Kn.liftCycles k₀ (n - 1 + 1) (by simp) hk₀ ≫ Kn.homologyπ (n - 1))) ≫
          Gs.map (Limits.image.ι
          (Kn.liftCycles k₀ (n - 1 + 1) (by simp) hk₀ ≫ Kn.homologyπ (n - 1))) = 0 := by
        rw [← Gs.map_comp, Limits.image.fac]
        exact hst s'
      have h1 := Limits.zero_of_epi_comp _ h0
      exact AddCommGrpCat.subsingleton_of_isZero (Limits.IsZero.of_mono_eq_zero _ h1)
    rw [← Limits.image.fac (Kn.liftCycles k₀ (n - 1 + 1) (by simp) hk₀ ≫ Kn.homologyπ (n - 1)),
      Dg.Φ.map_comp, himg.eq_of_tgt (Dg.Φ.map (Limits.factorThruImage _)) 0, Limits.zero_comp]

  obtain ⟨A', π, hπ, x₁, hx₁⟩ := L2 Dg.Φ Kn (n - 2) (n - 1) (by omega) k₀ hk₀ hΦe
  haveI := hπ

  have h₁ : ((n - 2 : ℕ) : ℤ) = (((n - 1 : ℕ)) : ℤ) - 1 := by omega
  have hH : HomologicalComplex.homologyMap g 0 = 0 := by
    refine L7 Ψ (((n - 1 : ℕ)) : ℤ) g A' (π ≫ Dg.μ.hom)
      (x₁ ≫ Dg.Φ.map (P.map (I.cochainComplexXIso ((((n - 1 : ℕ)) : ℤ) - 1) (n - 2) h₁).inv)) ?_
    have hx₁' : π ≫ Dg.Φ.map uu ≫ Dg.Φ.map (P.map f) =
        x₁ ≫ Dg.Φ.map (P.map (I.cocomplex.d (n - 2) (n - 1))) := by
      rw [← Functor.map_comp]; exact hx₁
    have hd : Ψ.d ((((n - 1 : ℕ)) : ℤ) - 1) (((n - 1 : ℕ)) : ℤ) =
        Dg.Φ.map (P.map (I.cochainComplex.d ((((n - 1 : ℕ)) : ℤ) - 1) (((n - 1 : ℕ)) : ℤ))) := rfl
    rw [Category.assoc, hg0, hd,
      InjectiveResolution.cochainComplex_d I _ _ (n - 2) (n - 1) h₁ rfl]
    simp only [Functor.map_comp, Category.assoc, Iso.hom_inv_id_assoc]
    rw [reassoc_of% hx₁', ← Functor.map_comp_assoc Dg.Φ (P.map _), ← P.map_comp, Iso.inv_hom_id,
      CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id, Category.id_comp]

  have L8 : ∀ {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasDerivedCategory.{u+2} C]
      {K L : CochainComplex C ℤ} (g : K ⟶ L), HomologicalComplex.homologyMap g 0 = 0 →
      (DerivedCategory.homologyFunctor C 0).map (DerivedCategory.Q.map g) = 0 := by
    intro C _ _ _ K L g hg
    have h := DerivedCategory.homologyFunctorFactors_hom_naturality g 0
    have h2 : (DerivedCategory.homologyFunctor C 0).map (DerivedCategory.Q.map g) ≫
        (DerivedCategory.homologyFunctorFactors C 0).hom.app L = 0 :=
      h.trans (by rw [hg]; exact Limits.comp_zero)
    exact (cancel_mono ((DerivedCategory.homologyFunctorFactors C 0).hom.app L)).mp
      (h2.trans Limits.zero_comp.symm)
  have hQg := L8 g hH
  have hβ0 : (DerivedCategory.homologyFunctor _ 0).map (β (I.extMk f (n - 1 + 1) rfl hf)) = 0 :=
    (congrArg (fun q => (DerivedCategory.homologyFunctor _ 0).map q) hβ).trans
      (((DerivedCategory.homologyFunctor _ 0).map_comp _ _).trans
        ((congrArg (· ≫ _) hQg).trans Limits.zero_comp))
  refine L1 _ (wcEtSuppObj Dx) _ ζ _ ?_
  exact ((DerivedCategory.homologyFunctor _ 0).map_comp _ _).trans
    ((congrArg (· ≫ _) hβ0).trans (Limits.zero_comp))

theorem wc_et_cone_cocycle_refine {𝒞₁ 𝒞₂ 𝒞₃ : Type (u+2)} [Category.{u+1} 𝒞₁]
    [Category.{u+1} 𝒞₂] [Category.{u+1} 𝒞₃] [Abelian 𝒞₁] [Abelian 𝒞₂] [Abelian 𝒞₃]
    [HasExt 𝒞₁] [HasDerivedCategory 𝒞₃] (F₁ : 𝒞₁ ⥤ 𝒞₂) (F₂ : 𝒞₂ ⥤ 𝒞₃)
    [F₁.Additive] [F₂.Additive] (Y : 𝒞₁) (I : InjectiveResolution Y) (One : 𝒞₃)
    (a : One ⟶ F₂.obj (F₁.obj Y))
    (eΨ : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj One ⟶
      (F₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((F₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex))
    (N p : ℕ) (hp : p + 1 = N) (f : Y ⟶ I.cocomplex.X N)
    (hf : f ≫ I.cocomplex.d N (N + 1) = 0) :
    let F := F₁ ⋙ F₂
    let Ψ := (F₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((F₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
    let Hq := HomotopyCategory.quotient 𝒞₃ (ComplexShape.up ℤ)
    let Hq' := HomotopyCategory.quotient 𝒞₁ (ComplexShape.up ℤ)
    let c := fun y : Abelian.Ext Y Y N =>
      (show Hq.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj One) ⟶
          (Hq.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        Hq.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map a) ≫
          Hq.map ((HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).inv.app
              Y) ≫
          (F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            (CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y)) ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            ((Hq'.commShiftIso ((N : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
          ((F.mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso ((N : ℕ) : ℤ)).hom.app
            (Hq'.obj I.cochainComplex) ≫
          ((F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app
            I.cochainComplex)⟦((N : ℕ) : ℤ)⟧' ≫
          (Hq.map ((Functor.mapHomologicalComplexCompIso (Iso.refl F) (ComplexShape.up ℤ)).inv.app
              I.cochainComplex))⟦((N : ℕ) : ℤ)⟧')
    let β := fun y : Abelian.Ext Y Y N =>
      (show DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj One) ⟶
          (DerivedCategory.Q.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        (DerivedCategory.quotientCompQhIso _).inv.app _ ≫ DerivedCategory.Qh.map (c y) ≫
          (DerivedCategory.Qh.commShiftIso ((N : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
          ((DerivedCategory.quotientCompQhIso _).hom.app Ψ)⟦((N : ℕ) : ℤ)⟧')
    β (I.extMk f (N + 1) rfl hf) ≫
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦((N : ℕ) : ℤ)⟧' = 0 →
      ∃ (A' : 𝒞₃) (π : A' ⟶ One) (_ : Epi π) (x₁ : A' ⟶ F₂.obj (F₁.obj (I.cocomplex.X p))),
        x₁ ≫ F₂.map (F₁.map (I.cocomplex.d p N)) = π ≫ a ≫ F₂.map (F₁.map f) :=
by
  intro F Ψ Hq Hq' c β hzero

  have s1 : ∀ {V V' W : Type (u+2)} [Category.{u+1} V] [Category.{u+1} V'] [Category.{u+1} W]
      [Preadditive V] [Preadditive V'] [Preadditive W]
      [Limits.HasZeroObject V] [Limits.HasZeroObject V'] [Limits.HasZeroObject W]
      (F1 : V ⥤ V') (F2 : V' ⥤ W) [F1.Additive] [F2.Additive]
      {A : W} {X : V} (v : A ⟶ (F1 ⋙ F2).obj X) (L : CochainComplex V ℤ) (n : ℤ)
      (φ : (HomologicalComplex.single V (ComplexShape.up ℤ) 0).obj X ⟶ L⟦n⟧)
      (x : (HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj
          ((HomologicalComplex.single V (ComplexShape.up ℤ) 0).obj X) ⟶
        (HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj
          ((shiftFunctor (HomologicalComplex V (ComplexShape.up ℤ)) n).obj L)),
      (HomotopyCategory.quotient V (ComplexShape.up ℤ)).map φ = x →
      (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.single W (ComplexShape.up ℤ) 0).map v) ≫
        (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.singleMapHomologicalComplex (F1 ⋙ F2) (ComplexShape.up ℤ) 0).inv.app
            X) ≫
        ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
        ((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).map x ≫
        ((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).map
          (((HomotopyCategory.quotient V (ComplexShape.up ℤ)).commShiftIso n).hom.app L) ≫
        (((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso n).hom.app
          ((HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj L) ≫
        (((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app L)⟦n⟧' ≫
        ((HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((Functor.mapHomologicalComplexCompIso (Iso.refl (F1 ⋙ F2)) (ComplexShape.up ℤ)).inv.app
            L))⟦n⟧' =
      (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map v ≫ (HomologicalComplex.singleMapHomologicalComplex (F1 ⋙ F2) (ComplexShape.up ℤ) 0).inv.app (X) ≫ ((F1 ⋙ F2).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫ (((F1 ⋙ F2).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫ ((Functor.mapHomologicalComplexCompIso (Iso.refl (F1 ⋙ F2)) (ComplexShape.up ℤ)).inv.app L)⟦n⟧')) ≫
        ((HomotopyCategory.quotient W (ComplexShape.up ℤ)).commShiftIso n).hom.app _ := by
    intro V V' W _ _ _ _ _ _ _ _ _ F1 F2 _ _ A X v L n φ x hx
    subst hx
    have hinv : ∀ K, ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app K =
        𝟙 _ := by
      intro K
      have := ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom_inv_id_app K
      rwa [Functor.mapHomotopyCategoryFactors_hom_app, Category.id_comp] at this
    have hsh := NatTrans.shift_app_comm
      ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom n L
    simp only [Functor.mapHomotopyCategoryFactors_hom_app, CategoryTheory.Functor.map_id,
      Functor.commShiftIso_comp_hom_app] at hsh
    simp only [Functor.mapHomotopyCategoryFactors_hom_app, hinv]
    rw [reassoc_of% hsh]
    simp only [Functor.map_comp, Category.assoc]
    rw [Functor.commShiftIso_hom_naturality]
    erw [Category.id_comp]
    erw [CategoryTheory.Functor.map_id]
    erw [Category.id_comp]
    rfl

  have s2 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (A Ψ₀ : CochainComplex 𝒞 ℤ) (n : ℤ) (g : A ⟶ Ψ₀⟦n⟧),
      (DerivedCategory.quotientCompQhIso 𝒞).inv.app A ≫
        DerivedCategory.Qh.map ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).map g ≫
          ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).commShiftIso n).hom.app Ψ₀) ≫
        (DerivedCategory.Qh.commShiftIso n).hom.app
          ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj Ψ₀) ≫
        ((DerivedCategory.quotientCompQhIso 𝒞).hom.app Ψ₀)⟦n⟧' =
      DerivedCategory.Q.map g ≫ (DerivedCategory.Q.commShiftIso n).hom.app Ψ₀ := by
    intro 𝒞 _ _ _ A Ψ₀ n g
    have h3 := NatTrans.shift_app_comm (DerivedCategory.quotientCompQhIso 𝒞).hom n Ψ₀
    rw [Functor.commShiftIso_comp_hom_app] at h3
    simp only [Category.assoc] at h3
    have h4 := (DerivedCategory.quotientCompQhIso 𝒞).inv.naturality g
    simp only [Functor.comp_map] at h4
    rw [Functor.map_comp, Category.assoc, h3, ← reassoc_of% h4, Iso.inv_hom_id_app_assoc]

  have s3 : ∃ φ : (HomologicalComplex.single 𝒞₁ (ComplexShape.up ℤ) 0).obj Y ⟶
        I.cochainComplex⟦((N : ℕ) : ℤ)⟧,
      (HomotopyCategory.quotient 𝒞₁ (ComplexShape.up ℤ)).map φ =
        CochainComplex.HomComplex.CohomologyClass.homAddEquiv
          (I.extEquivCohomologyClass (I.extMk f (N + 1) rfl hf)) ∧
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Y).inv ≫ φ.f 0 ≫
        (I.cochainComplex.shiftFunctorObjXIso ((N : ℕ) : ℤ) 0 ((N : ℕ) : ℤ)
          (zero_add _).symm).hom =
        f ≫ (I.cochainComplexXIso ((N : ℕ) : ℤ) N rfl).inv := by
    rw [InjectiveResolution.extEquivCohomologyClass_extMk,
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv_apply,
      CochainComplex.HomComplex.CohomologyClass.toHom_mk]
    refine ⟨_, rfl, ?_⟩
    rw [CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply,
      CochainComplex.HomComplex.Cocycle.homOf_f,
      CochainComplex.HomComplex.Cocycle.rightShift_coe,
      CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 _ ((N : ℕ) : ℤ) (by simp),
      CochainComplex.HomComplex.Cocycle.fromSingleMk_coe,
      CochainComplex.HomComplex.Cochain.fromSingleMk_v]
    simp

  have s4 : ∀ (L : CochainComplex 𝒞₁ ℤ) (n : ℤ)
      (φ : (HomologicalComplex.single 𝒞₁ (ComplexShape.up ℤ) 0).obj Y ⟶ L⟦n⟧),
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 One).inv ≫
        ((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).map a ≫
          (HomologicalComplex.singleMapHomologicalComplex (F₁ ⋙ F₂) (ComplexShape.up ℤ) 0).inv.app
            Y ≫
          ((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
          (((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫
          ((Functor.mapHomologicalComplexCompIso (Iso.refl (F₁ ⋙ F₂)) (ComplexShape.up ℤ)).inv.app
            L)⟦n⟧').f 0 =
      a ≫ F₂.map (F₁.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Y).inv ≫
        φ.f 0)) := by
    intro L n φ
    simp only [HomologicalComplex.comp_f, HomologicalComplex.single_map_f_self,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
      Functor.mapHomologicalComplex_map_f, Functor.mapHomologicalComplex_commShiftIso_hom_app_f,
      CochainComplex.shiftFunctor_map_f', Functor.mapHomologicalComplexCompIso_inv_app_f,
      Iso.refl_inv, NatTrans.id_app, Category.assoc, Iso.inv_hom_id_assoc, Functor.comp_map,
      Functor.map_comp]
    repeat erw [Category.comp_id]
    try erw [Iso.inv_hom_id_assoc]

  have s5 : ∀ (A : 𝒞₃) (L : CochainComplex 𝒞₃ ℤ)
      (ψ : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj A ⟶ L),
      DerivedCategory.Q.map ψ = 0 →
      ∃ (A' : 𝒞₃) (π : A' ⟶ A) (_ : Epi π) (x₀ : A' ⟶ L.X (-1)),
        π ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 A).inv ≫ ψ.f 0 =
          x₀ ≫ L.d (-1) 0 := by
    intro A L ψ h
    have ha : HomologicalComplex.homologyMap ψ 0 = 0 := by
      have e := DerivedCategory.homologyFunctorFactors_hom_naturality ψ 0
      rw [h, Functor.map_zero, Limits.zero_comp] at e
      exact (cancel_epi ((DerivedCategory.homologyFunctorFactors 𝒞₃ 0).app _).hom).mp
        (e.symm.trans Limits.comp_zero.symm)
    have hb : HomologicalComplex.cyclesMap ψ 0 ≫ L.homologyπ 0 = 0 := by
      rw [← HomologicalComplex.homologyπ_naturality, ha, Limits.comp_zero]
    have hk₀ : ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 A).inv ≫ ψ.f 0) ≫
        L.d 0 1 = 0 := by
      rw [Category.assoc, ψ.comm 0 1]
      have h01 : ((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj A).d 0 1 = 0 :=
        (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 A 1
          (by norm_num)).eq_of_tgt _ _
      rw [h01, Limits.zero_comp, Limits.comp_zero]
    have hn1 : (ComplexShape.up ℤ).next 0 = 1 := by simp
    have hp1 : (ComplexShape.up ℤ).prev 0 = -1 := by simp
    have hd : (HomologicalComplex.singleObjCyclesSelfIso (ComplexShape.up ℤ) 0 A).inv ≫
        HomologicalComplex.cyclesMap ψ 0 =
        L.liftCycles ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 A).inv ≫ ψ.f 0)
          1 hn1 hk₀ := by
      rw [← cancel_mono (L.iCycles 0), Category.assoc, HomologicalComplex.cyclesMap_i,
        HomologicalComplex.liftCycles_i, ← Category.assoc,
        HomologicalComplex.singleObjCyclesSelfIso_inv_iCycles]
    apply (HomologicalComplex.liftCycles_comp_homologyπ_eq_zero_iff_up_to_refinements L (-1) 0 1
      hp1 hn1 _ hk₀).mp
    rw [← hd, Category.assoc, hb, Limits.comp_zero]

  have s6 : ∀ (K Ψ' : CochainComplex 𝒞₃ ℤ) (e : K ⟶ Ψ') (M : ℤ) (_ : M ≠ 0)
      (_ : ∀ i : ℤ, i ≠ 0 → Limits.IsZero (K.X i)) {A' : 𝒞₃}
      (h₀ : A' ⟶ (Ψ'⟦M⟧).X 0)
      (x₀ : A' ⟶ ((CochainComplex.mappingCone e)⟦M⟧).X (-1))
      (_ : h₀ ≫ ((CochainComplex.mappingCone.inr e)⟦M⟧').f 0 =
          x₀ ≫ ((CochainComplex.mappingCone e)⟦M⟧).d (-1) 0),
      ∃ k : A' ⟶ Ψ'.X (M - 1),
        k ≫ Ψ'.d (M - 1) M = h₀ ≫ (Ψ'.shiftFunctorObjXIso M 0 M (zero_add M).symm).hom := by
    intro K Ψ' e M hM hK A' h₀ x₀ h1
    rw [CochainComplex.shiftFunctor_map_f', CochainComplex.shiftFunctor_obj_d'] at h1
    have h2 := congrArg (fun z => z ≫ (CochainComplex.mappingCone.snd e).v (0 + M) (0 + M)
      (add_zero _)) h1
    simp only [Category.assoc, CochainComplex.mappingCone.inr_f_snd_v,
      Linear.comp_units_smul, Linear.units_smul_comp] at h2
    erw [Category.comp_id] at h2
    rw [CochainComplex.mappingCone.d_snd_v e (-1 + M) (0 + M) (by omega)] at h2
    have hz : e.f (0 + M) = 0 := (hK (0 + M) (by omega)).eq_of_src _ _
    rw [hz, Limits.comp_zero, zero_add ((CochainComplex.mappingCone.snd e).v (-1 + M) (-1 + M)
      (add_zero _) ≫ Ψ'.d (-1 + M) (0 + M))] at h2
    refine ⟨M.negOnePow • (x₀ ≫ (CochainComplex.mappingCone.snd e).v (-1 + M) (-1 + M)
      (add_zero _) ≫ (Ψ'.XIsoOfEq (show -1 + M = M - 1 by omega)).hom), ?_⟩
    rw [Linear.units_smul_comp]
    simp only [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d]
    rw [h2, CochainComplex.shiftFunctorObjXIso.eq_1]
    simp only [Linear.units_smul_comp, Category.assoc,
      HomologicalComplex.d_comp_XIsoOfEq_hom]

  obtain ⟨φ, hφq, hφ0⟩ := s3
  let g : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj One ⟶ Ψ⟦((N : ℕ) : ℤ)⟧ :=
    (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).map a ≫
      (HomologicalComplex.singleMapHomologicalComplex (F₁ ⋙ F₂) (ComplexShape.up ℤ) 0).inv.app Y ≫
      ((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
      (((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso
        ((N : ℕ) : ℤ)).hom.app I.cochainComplex ≫
      ((Functor.mapHomologicalComplexCompIso (Iso.refl (F₁ ⋙ F₂)) (ComplexShape.up ℤ)).inv.app
        I.cochainComplex)⟦((N : ℕ) : ℤ)⟧'
  have hc : c (I.extMk f (N + 1) rfl hf) =
      Hq.map g ≫ (Hq.commShiftIso ((N : ℕ) : ℤ)).hom.app Ψ :=
    s1 F₁ F₂ a I.cochainComplex ((N : ℕ) : ℤ) φ _ hφq
  have hβ : β (I.extMk f (N + 1) rfl hf) =
      DerivedCategory.Q.map g ≫ (DerivedCategory.Q.commShiftIso ((N : ℕ) : ℤ)).hom.app Ψ := by
    refine Eq.trans ?_ (s2 _ Ψ ((N : ℕ) : ℤ) g)
    exact congrArg (fun z => (DerivedCategory.quotientCompQhIso 𝒞₃).inv.app _ ≫
      DerivedCategory.Qh.map z ≫
      (DerivedCategory.Qh.commShiftIso ((N : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
      ((DerivedCategory.quotientCompQhIso 𝒞₃).hom.app Ψ)⟦((N : ℕ) : ℤ)⟧') hc
  rw [hβ, Category.assoc, ← Functor.commShiftIso_hom_naturality, ← Category.assoc,
    Preadditive.IsIso.comp_right_eq_zero, ← Functor.map_comp] at hzero
  obtain ⟨A', π, hπ, x₀, hx₀⟩ := s5 One _ _ hzero
  rw [HomologicalComplex.comp_f] at hx₀
  have hN : ((N : ℕ) : ℤ) ≠ 0 := by omega
  obtain ⟨k, hk⟩ := s6 _ Ψ eΨ ((N : ℕ) : ℤ) hN
    (fun i hi => HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 One i hi)
    (π ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 One).inv ≫ g.f 0) x₀
    (by simpa only [Category.assoc] using hx₀)
  simp only [Category.assoc] at hk
  have hsh : (CochainComplex.shiftFunctorObjXIso Ψ ((N : ℕ) : ℤ) 0 ((N : ℕ) : ℤ)
        (zero_add _).symm).hom =
      F₂.map (F₁.map (CochainComplex.shiftFunctorObjXIso I.cochainComplex ((N : ℕ) : ℤ) 0
        ((N : ℕ) : ℤ) (zero_add _).symm).hom) := by
    simp only [CochainComplex.shiftFunctorObjXIso, HomologicalComplex.XIsoOfEq, eqToIso.hom,
      eqToHom_map]
  rw [hsh, reassoc_of% (s4 I.cochainComplex ((N : ℕ) : ℤ) φ), ← F₂.map_comp, ← F₁.map_comp,
    Category.assoc, hφ0] at hk
  have hd : Ψ.d (((N : ℕ) : ℤ) - 1) ((N : ℕ) : ℤ) =
      F₂.map (F₁.map ((I.cochainComplexXIso (((N : ℕ) : ℤ) - 1) p (by omega)).hom ≫
        I.cocomplex.d p N ≫ (I.cochainComplexXIso ((N : ℕ) : ℤ) N rfl).inv)) := by
    rw [← InjectiveResolution.cochainComplex_d]
    rfl
  rw [hd] at hk
  refine ⟨A', π, hπ,
    k ≫ F₂.map (F₁.map (I.cochainComplexXIso (((N : ℕ) : ℤ) - 1) p (by omega)).hom), ?_⟩
  rw [← cancel_mono (F₂.map (F₁.map (I.cochainComplexXIso ((N : ℕ) : ℤ) N rfl).inv))]
  simp only [Category.assoc, ← Functor.map_comp]
  exact hk

theorem wc_et_pull_data_map_zero_stalk_zero : ∀ {Z S : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (m : ℕ) (E : wcEtPullData i m) (M N : SheafOfModules.{u+1} (wcEtZModRing S m)) (σ : M ⟶ N),
    E.Φ.map σ = 0 → ∀ z : Z,
    (wcEtStalk S (i z)).map ((SheafOfModules.toSheaf (wcEtZModRing S m)).map σ) = 0 :=
by
  intro Z S i _ m E M N σ hσ z
  letI := E.cont
  obtain ⟨α⟩ := wc_et_pull_data_toSheaf_iso E
  have hL : ((wcEtBaseChange i).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology Z)).map ((SheafOfModules.toSheaf (wcEtZModRing S m)).map σ) = 0 := by
    have h := NatIso.naturality_2 α.symm σ
    simp only [Iso.symm_hom, Iso.symm_inv, Functor.comp_map] at h
    rw [← h, hσ, Functor.map_zero, Limits.zero_comp, Limits.comp_zero]
  let e : wcEtPush i ≅ (wcEtBaseChange i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology Z) :=
    Functor.isoWhiskerRight ((wcEtBaseChange i).sheafPushforwardContinuousCompSheafToPresheafIso
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology Z)).symm
      (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  have adjL : (wcEtBaseChange i).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology Z) ⊣ wcEtPush i :=
    (Functor.sheafAdjunctionContinuous (wcEtBaseChange i) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology Z)).ofNatIsoRight e.symm
  obtain ⟨adjQ⟩ := wc_qm_inv_push_adj i
  have hQ : (wcQmInv i).map ((SheafOfModules.toSheaf (wcEtZModRing S m)).map σ) = 0 := by
    have h := NatIso.naturality_2 (Adjunction.leftAdjointUniq adjL adjQ).symm
      ((SheafOfModules.toSheaf (wcEtZModRing S m)).map σ)
    simp only [Iso.symm_hom, Iso.symm_inv] at h
    rw [← h, hL, Limits.zero_comp, Limits.comp_zero]
  obtain ⟨θ⟩ := wc_qm_inv_stalk i z
  have h := NatIso.naturality_2 θ.symm ((SheafOfModules.toSheaf (wcEtZModRing S m)).map σ)
  change θ.inv.app _ ≫ (wcEtStalk Z z).map ((wcQmInv i).map
      ((SheafOfModules.toSheaf (wcEtZModRing S m)).map σ)) ≫ θ.hom.app _ = _ at h
  rw [← h, hQ]
  have h0 : (wcEtStalk Z z).map (0 : (wcQmInv i).obj ((SheafOfModules.toSheaf (wcEtZModRing S m)).obj M) ⟶
      (wcQmInv i).obj ((SheafOfModules.toSheaf (wcEtZModRing S m)).obj N)) = 0 := by
    exact Functor.map_zero _ _ _
  rw [h0, Limits.zero_comp, Limits.comp_zero]

theorem wc_et_mod_stalk_zero_level_coboundary : ∀ (Y : Scheme.{u}) (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1})
    (Kc : CochainComplex (SheafOfModules.{u+1} R) ℕ) (N p : ℕ) (hp : p + 1 = N)
    (k : SheafOfModules.unit R ⟶ Kc.X N) (hk : k ≫ Kc.d N (N + 1) = 0) (x : Y)
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)), W'.Initial →
    (wcEtStalk Y x).map ((SheafOfModules.toSheaf R).map
      (Kc.liftCycles k (N + 1) (by simp) hk ≫ Kc.homologyπ N)) = 0 →
    ∃ (l : Λ) (e : (Kc.X p).val.obj (Opposite.op (W'.obj l).right)),
      ((Kc.d p N).val.app (Opposite.op (W'.obj l).right)).hom e =
        (k.val.app (Opposite.op (W'.obj l).right)).hom (1 : R.obj.obj (Opposite.op (W'.obj l).right)) :=
by
  intro Y R Kc N p hp k hk x Λ _ _ W' hinit hst
  subst hp
  haveI hcof := wc_et_geom_pt_nbhd_cofiltered Y x
  obtain ⟨_, heq, hnat⟩ := wc_et_stalk_germ_facts Y x hcof
    ((SheafOfModules.toSheaf R).obj (Kc.homology (p + 1)))
  set σ := Kc.liftCycles k (p + 1 + 1) (by simp) hk ≫ Kc.homologyπ (p + 1) with hσ

  obtain ⟨A₀⟩ : Nonempty (StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) :=
    IsCofiltered.nonempty
  have h1 := hnat ((SheafOfModules.toSheaf R).obj (SheafOfModules.unit R))
    ((SheafOfModules.toSheaf R).map σ) A₀ (1 : R.obj.obj (Opposite.op A₀.right))
  rw [hst, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at h1
  obtain ⟨A, f, f', hff⟩ := heq A₀ A₀ _ 0 (h1.symm.trans (map_zero _).symm)
  rw [map_zero] at hff
  have hσ0 : (σ.val.app (Opposite.op A.right)).hom (1 : R.obj.obj (Opposite.op A.right)) = 0 := by
    have e := PresheafOfModules.naturality_apply σ.val f.right.op
      (1 : R.obj.obj (Opposite.op A₀.right))
    have h2 : ConcreteCategory.hom ((SheafOfModules.unit R).val.map f.right.op)
        (1 : R.obj.obj (Opposite.op A₀.right)) = (1 : R.obj.obj (Opposite.op A.right)) :=
      PresheafOfModules.unit_map_one _ _
    exact (congrArg (fun s : R.obj.obj (Opposite.op A.right) =>
      (σ.val.app (Opposite.op A.right)).hom s) h2.symm).trans (e.trans hff)

  obtain ⟨T, h, t, e₀, ht, he₀⟩ := wc_et_mod_homology_local_boundary Y R Kc (p + 1) k hk A.right
    (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField x)))) hσ0

  have hw : h.left ≫ A.right.hom = T.hom := MorphismProperty.Over.w h
  haveI : Etale h.left := MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale)
    h.left A.right.hom A.right.prop (by rw [hw]; exact T.prop)
  obtain ⟨t', ht'1, -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (Y.residueField x))
    h.left A.hom.left t ht
  have ht'3 : t' ≫ T.hom = wcEtGeomPt Y x := by
    rw [← hw, ← Category.assoc, ht'1]
    exact Over.w A.hom
  let A₃ : StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y) :=
    StructuredArrow.mk (Y := T) (Over.homMk t' ht'3 : Over.mk (wcEtGeomPt Y x) ⟶
      (Scheme.Etale.forget Y).obj T)
  haveI := hinit
  obtain ⟨c⟩ : Nonempty (CostructuredArrow W' A₃) := (Functor.Initial.out A₃).is_nonempty
  let g : (W'.obj c.left).right ⟶ T := c.hom.right

  have key : ∀ (q : ℕ), q = p → ∀ (e₀ : (Kc.X q).val.obj (Opposite.op T)),
      ((Kc.d q (p + 1)).val.app (Opposite.op T)).hom e₀ =
        (k.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)) →
      ∃ (l : Λ) (e : (Kc.X p).val.obj (Opposite.op (W'.obj l).right)),
        ((Kc.d p (p + 1)).val.app (Opposite.op (W'.obj l).right)).hom e =
          (k.val.app (Opposite.op (W'.obj l).right)).hom
            (1 : R.obj.obj (Opposite.op (W'.obj l).right)) := by
    intro q hq
    subst hq
    intro e₀ he₀
    refine ⟨c.left, ((Kc.X q).val.map g.op).hom e₀, ?_⟩
    have n1 := PresheafOfModules.naturality_apply (Kc.d q (q + 1)).val g.op e₀
    have n2 := PresheafOfModules.naturality_apply k.val g.op (1 : R.obj.obj (Opposite.op T))
    have n3 : ConcreteCategory.hom ((SheafOfModules.unit R).val.map g.op)
        (1 : R.obj.obj (Opposite.op T)) =
          (1 : R.obj.obj (Opposite.op (W'.obj c.left).right)) :=
      PresheafOfModules.unit_map_one _ _
    refine (n1.trans (congrArg (fun s => ((Kc.X (q + 1)).val.map g.op).hom s) he₀)).trans ?_
    refine n2.symm.trans ?_
    exact congrArg (fun s : R.obj.obj (Opposite.op (W'.obj c.left).right) =>
      (k.val.app (Opposite.op (W'.obj c.left).right)).hom s) n3
  exact key _ (CochainComplex.prev_nat_succ p) e₀ he₀

theorem wc_et_push_level_coboundary_pull_zero : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (m : ℕ) (D : wcEtPullData g m)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S' m))) (N p : ℕ) (hp : p + 1 = N)
    (f : SheafOfModules.unit (wcEtZModRing S' m) ⟶ I.cocomplex.X N)
    (hf : f ≫ I.cocomplex.d N (N + 1) = 0) (V : S.Etale),
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' m)) := HasExt.standard _
    (∃ e : ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).X p).val.obj (Opposite.op V),
        (((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).d p N).val.app (Opposite.op V)).hom e =
        (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ) ≫
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).map f).val.app
            (Opposite.op V)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op V))) →
    ∃ E : wcEtPullData ((wcEtBaseChange g).obj V).hom m, wcEtPull E N (I.extMk f (N + 1) rfl hf) = 0 :=
by
  intro S S' g m D I N p hp f hf V hex
  subst hp
  obtain ⟨e, he⟩ := hex
  obtain ⟨cl, -, h2, -, h4⟩ := wc_et_inj_res_cycle_class_coeff m I p
  obtain ⟨Du, hDu⟩ := h4 ((wcEtBaseChange g).obj V) ((wcEtBaseChange g).obj V).hom rfl
  have hcyc : ((I.cocomplex.d (p + 1) (p + 2)).val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
      ((f.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)))) = 0 := by
    have h0 : ((f ≫ I.cocomplex.d (p + 1) (p + 1 + 1)).val.app
        (Opposite.op ((wcEtBaseChange g).obj V))).hom
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))) = 0 := by
      rw [hf]
      rfl
    exact h0
  have he' : ((I.cocomplex.d p (p + 1)).val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom e =
      (f.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))) := by
    refine he.trans ?_
    first
      | (show (f.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
            ((D.φ.hom.app (Opposite.op V)).hom 1) = _
         rw [map_one] <;> rfl)
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.comp_apply,
            SheafOfModules.pushforward_map_val, PresheafOfModules.pushforward_map_app_apply,
            SheafOfModules.unitToPushforwardObjUnit_val_app_apply, map_one])
      | (erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply, map_one]; rfl)
  have hcl := (h2 _ _ hcyc).mpr ⟨e, he'⟩
  exact ⟨Du, (hDu f hf).trans hcl⟩

theorem wc_et_tpl_cone_zero_restr_zero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (rQ : Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ ⟶ Limits.pullback (Limits.pullback.snd D.f a) ξ)
    (hrQ1 : rQ ≫ Limits.pullback.fst (Limits.pullback.snd D.f a) ξ = Limits.pullback.fst (a' ≫ Limits.pullback.snd D.f a) ξ ≫ a')
    (hrQ2 : rQ ≫ Limits.pullback.snd (Limits.pullback.snd D.f a) ξ = Limits.pullback.snd (a' ≫ Limits.pullback.snd D.f a) ξ)
    (DrQ : wcEtPullData rQ (ℓ ^ k)) (hk : 1 ≤ k) :
