        ∃ θ₀ : wcEtSuppExt Dx (2 * N), ∀ j : ℕ, j • wcEtSuppClass Dx (2 * N) θ₀ = 0 → ℓ ^ k ∣ j  := by
      intro K _ _ Xs Xt E σ _ _ xs b iE _ _ hne hiso hrange N hN _ _ _ hℓK Dx
