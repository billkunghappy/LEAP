  obtain ⟨Oc, hOc⟩ : ∃ Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) 2 0
      (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then
