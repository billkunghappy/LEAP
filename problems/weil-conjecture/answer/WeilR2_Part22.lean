  have s1 : ∀ {H : Type _} [AddCommGroup H] (κ ρ : H →+ ZMod (ℓ ^ k)),
      (∀ y, κ y = 0 ↔ ρ y = 0) → ∃ u : (ZMod (ℓ ^ k))ˣ, ∀ y, (u : ZMod (ℓ ^ k)) * κ y = ρ y := by
    intro H _ κ ρ hker
    classical
    have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero k hp.ne_zero
    obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator (α := κ.range)
    obtain ⟨y0, hy0⟩ := AddMonoidHom.mem_range.mp g.2
    have hmul : ∀ y, ∃ t : ℕ, κ y = t • κ y0 := by
      intro y
      obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg ⟨κ y, y, rfl⟩)
      have hj' : j • (g : ZMod (ℓ ^ k)) = κ y := congrArg Subtype.val hj
      refine ⟨(j : ZMod (ℓ ^ k)).val, ?_⟩
      rw [← hj', hy0, nsmul_eq_mul, zsmul_eq_mul, ZMod.natCast_zmod_val]
    have hab : ∀ j : ℕ, j • κ y0 = 0 ↔ j • ρ y0 = 0 := by
      intro j
      rw [← map_nsmul, ← map_nsmul]
      exact hker _
    have hrel : ∀ y, ∀ t : ℕ, κ y = t • κ y0 → ρ y = t • ρ y0 := by
      intro y t h
      have h1 : κ (y - t • y0) = 0 := by rw [map_sub, map_nsmul, h, sub_self]
      have h2 := (hker _).mp h1
      rw [map_sub, map_nsmul, sub_eq_zero] at h2
      exact h2
    obtain ⟨u, hu⟩ : ∃ u : (ZMod (ℓ ^ k))ˣ, (u : ZMod (ℓ ^ k)) * κ y0 = ρ y0 := by
      generalize κ y0 = a at hab
      generalize ρ y0 = b at hab
      by_cases ha0 : a = 0
      · refine ⟨1, ?_⟩
        have hb0 : b = 0 := by
          have := (hab 1).mp (by rw [one_nsmul]; exact ha0)
          rwa [one_nsmul] at this
        rw [ha0, hb0, mul_zero]
      · have hb0 : b ≠ 0 := by
          intro hb0
          apply ha0
          have := (hab 1).mpr (by rw [one_nsmul]; exact hb0)
          rwa [one_nsmul] at this
        have hord : addOrderOf a = addOrderOf b := by
          apply Nat.dvd_antisymm
          · exact addOrderOf_dvd_iff_nsmul_eq_zero.mpr ((hab _).mpr (addOrderOf_nsmul_eq_zero b))
          · exact addOrderOf_dvd_iff_nsmul_eq_zero.mpr ((hab _).mp (addOrderOf_nsmul_eq_zero a))
        have hav : a = ((a.val : ℕ) : ZMod (ℓ ^ k)) := (ZMod.natCast_zmod_val a).symm
        have hbv : b = ((b.val : ℕ) : ZMod (ℓ ^ k)) := (ZMod.natCast_zmod_val b).symm
        have hoa := ZMod.addOrderOf_coe a.val hm0
        have hob := ZMod.addOrderOf_coe b.val hm0
        rw [← hav] at hoa
        rw [← hbv] at hob
        have hgeq : (ℓ ^ k).gcd a.val = (ℓ ^ k).gcd b.val := by
          have e1 := Nat.div_div_self (Nat.gcd_dvd_left (ℓ ^ k) a.val) hm0
          have e2 := Nat.div_div_self (Nat.gcd_dvd_left (ℓ ^ k) b.val) hm0
          rw [← e1, ← e2, ← hoa, ← hob, hord]
        have hcop : ∀ v : ℕ, v ≠ 0 → v < ℓ ^ k → Nat.Coprime (v / (ℓ ^ k).gcd v) (ℓ ^ k) := by
          intro v hv0 hvm
          have hgpos : 0 < (ℓ ^ k).gcd v := Nat.gcd_pos_of_pos_left v (Nat.pos_of_ne_zero hm0)
          have h1 := Nat.coprime_div_gcd_div_gcd hgpos
          have hne1 : ℓ ^ k / (ℓ ^ k).gcd v ≠ 1 := by
            intro h
            have hgm : (ℓ ^ k).gcd v = ℓ ^ k := by
              have := Nat.div_mul_cancel (Nat.gcd_dvd_left (ℓ ^ k) v)
              rw [h, one_mul] at this
              exact this
            have hdv : ℓ ^ k ∣ v := hgm ▸ Nat.gcd_dvd_right (ℓ ^ k) v
            have := Nat.le_of_dvd (Nat.pos_of_ne_zero hv0) hdv
            omega
          obtain ⟨i, _, hieq⟩ :=
            (Nat.dvd_prime_pow hp).mp (Nat.div_dvd_of_dvd (Nat.gcd_dvd_left (ℓ ^ k) v))
          have hi0 : i ≠ 0 := by
            rintro rfl
            rw [pow_zero] at hieq
            exact hne1 hieq
          have hℓd : ℓ ∣ ℓ ^ k / (ℓ ^ k).gcd v := hieq ▸ dvd_pow_self ℓ hi0
          have h2 : Nat.Coprime ℓ (v / (ℓ ^ k).gcd v) := Nat.Coprime.coprime_dvd_left hℓd h1
          exact (Nat.Coprime.pow_left k h2).symm
        have ha1 := hcop a.val (fun h => ha0 ((ZMod.val_eq_zero a).mp h)) (ZMod.val_lt a)
        have hb1 := hcop b.val (fun h => hb0 ((ZMod.val_eq_zero b).mp h)) (ZMod.val_lt b)
        rw [← hgeq] at hb1
        have haeq : a = (((ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) *
            ((a.val / (ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) := by
          conv_lhs => rw [hav]
          rw [← Nat.cast_mul, Nat.mul_div_cancel' (Nat.gcd_dvd_right _ _)]
        have hbeq : b = (((ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) *
            ((b.val / (ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) := by
          conv_lhs => rw [hbv]
          rw [← Nat.cast_mul, hgeq, Nat.mul_div_cancel' (Nat.gcd_dvd_right _ _)]
        obtain ⟨ua, hua⟩ : ∃ ua : (ZMod (ℓ ^ k))ˣ,
            (ua : ZMod (ℓ ^ k)) = ((a.val / (ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) :=
          ⟨_, ZMod.coe_unitOfCoprime _ ha1⟩
        obtain ⟨ub, hub⟩ : ∃ ub : (ZMod (ℓ ^ k))ˣ,
            (ub : ZMod (ℓ ^ k)) = ((b.val / (ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) :=
          ⟨_, ZMod.coe_unitOfCoprime _ hb1⟩
        rw [← hua] at haeq
        rw [← hub] at hbeq
        generalize (((ℓ ^ k).gcd a.val : ℕ) : ZMod (ℓ ^ k)) = G at haeq hbeq
        refine ⟨ub * ua⁻¹, ?_⟩
        rw [haeq, hbeq, Units.val_mul]
        calc (ub : ZMod (ℓ ^ k)) * ↑ua⁻¹ * (G * ↑ua)
