      hz (k + 1), hg k, hz k, sub_self]
  have hkerι : Limits.IsLimit (Limits.KernelFork.ofι ι hw) := hexι.fIsKernel
  obtain ⟨wl, hwl⟩ := Limits.KernelFork.IsLimit.lift' hkerι z hzσ
  have hwl' : wl ≫ ι = z := by
    rw [Limits.KernelFork.ι_ofι] at hwl
    exact hwl
  refine ⟨e _ wl, fun k => ?_⟩
  rw [← hproj (n - 1) k]
  have h1 := he _ _ (ι ≫ pr k) wl
  rw [← Category.assoc, hwl', hz k] at h1
  simp only [g, Equiv.apply_symm_apply] at h1
  exact h1.symm

theorem wc_pencil_Rq_torsion_noPunct (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') :
    ∀ (k : ℕ) (T : (wcP1Over F'').left.ProEt)
      (x : (((wcProEtPush D.f).rightDerived (n - 1)).obj
        (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ((((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.map h.op).hom x = 0) → x = 0 :=
by
  classical
  have nat : ∀ {G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (φ : G ⟶ G') {V T : (wcP1Over F'').left.ProEt} (h : V ⟶ T) (z : G.obj.obj (Opposite.op T)),
      (G'.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom z) =
        (φ.hom.app (Opposite.op V)).hom ((G.obj.map h.op).hom z) := by
    intro G G' φ V T h z
    have e := congrArg (fun f => f.hom z) (φ.hom.naturality h.op)
    exact e.symm
  have inj : ∀ {G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (θ : G ≅ G') {T : (wcP1Over F'').left.ProEt} (z : G.obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom z = 0 → z = 0 := by
    intro G G' θ T z hz
    have e := congrArg (fun f => (f.hom.app (Opposite.op T)).hom z) θ.hom_inv_id
    have e' : (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom z) = z := e
    rw [hz, map_zero] at e'
    exact e'.symm
  obtain ⟨hZc, hgen⟩ := wc_P1_sections_closed_generize F'' D.m D.S D.hS
  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI := wc_et_enough_injectives D.Yt.left
  intro k T z hz
  let I := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))
  obtain ⟨θ⟩ := wc_proet_rightDerived_push_epsInv F'' D.Yt.left (wcP1Over F'').left
    (wcP1Over F'').hom D.f (ℓ ^ k) I (n - 1)
  apply inj θ
  refine wc_epsInv_no_punct_of_cospec (wcP1Over F'').left
    ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n - 1))
    {p | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} hZc ?_ hgen T _ ?_
  · intro V h v v' hv hsp hv' h0
    obtain ⟨i, hi⟩ := hv
    exact wc_pencil_et_Rq_cospec_injective F' F'' Y n hn hn2 D ℓ hℓ k I V h v v' i hi hsp
      (fun j hj => hv' ⟨j, hj⟩) h0
  · intro V h hV
    rw [nat θ.hom h z, hz V h (fun v i hvi => hV v ⟨i, hvi⟩), map_zero]

theorem wc_epsInv_extend_of_etale_extend (B : Scheme.{u}) [QuasiSeparatedSpace B]
    (O : B.Opens) (hO : IsCompact (O : Set B))
    (H : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (N : ℕ)
    (hext : ∀ (V : B.Etale), IsAffine V.left →
      ∀ h : H.obj.obj (Opposite.op (wcEtOpen B V (V.hom ⁻¹ᵁ O))),
      ∃ x : H.obj.obj (Opposite.op V),
        (H.obj.map (wcEtOpenι B V (V.hom ⁻¹ᵁ O)).op).hom x = N • h) :
    ∀ (A : B.Opens), IsAffineOpen A → ∀ (T : B.ProEt), wcAffIndEt B A T →
    ∀ y : ((wcEpsInv B).obj H).obj.obj (Opposite.op (wcOpenRestr B O T)),
      ∃ x : ((wcEpsInv B).obj H).obj.obj (Opposite.op T),
        (((wcEpsInv B).obj H).obj.map (wcOpenRestrIncl B O T).op).hom x = N • y :=
by
  classical
  intro A hA T hT y

  have qcqs : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) [CompactSpace X] [QuasiSeparatedSpace X]
      [QuasiSeparatedSpace Y] (O : Y.Opens), IsCompact (O : Set Y) →
      ∀ (j : Z ⟶ X) [IsOpenImmersion j], Set.range j = f ⁻¹' (O : Set Y) →
      CompactSpace Z ∧ QuasiSeparatedSpace Z := by
    intro X Y Z f _ _ _ O hO j _ hj
    haveI : QuasiCompact f := quasiCompact_of_compactSpace f
    have hc : IsCompact (f ⁻¹' (O : Set Y)) :=
      QuasiCompact.isCompact_preimage (f := f) _ O.isOpen hO
    have hemb := j.isOpenEmbedding
    exact ⟨isCompact_univ_iff.mp (hemb.isInducing.isCompact_iff.mpr
      (by rw [Set.image_univ, hj]; exact hc)), hemb.quasiSeparatedSpace⟩

  have affres : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : f ⁻¹ᵁ U ≤ V), IsAffine X → IsAffine Y →
      IsAffineHom (f.resLE U V e) := by
    intro X Y f U V e e' hX hY
    haveI : IsAffineHom f := isAffineHom_of_isAffine f
    have h1 : X.homOfLE e ≫ f.resLE U (f ⁻¹ᵁ U) le_rfl = f.resLE U V e :=
      Scheme.Hom.map_resLE f le_rfl e
    have h2 : f.resLE U (f ⁻¹ᵁ U) le_rfl = f ∣_ U := Scheme.Hom.resLE_eq_morphismRestrict f
    haveI : IsAffineHom (f ∣_ U) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (isPullback_morphismRestrict f U).flip ‹_›
    haveI : IsIso (X.homOfLE e) :=
      ⟨⟨X.homOfLE e', by rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_rfl],
        by rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_rfl]⟩⟩
    rw [← h1, h2]
    infer_instance
  have qcqsW : ∀ {X : Scheme.{u}} (p : X ⟶ B), IsAffine X →
      CompactSpace (p ⁻¹ᵁ O : Scheme.{u}) ∧ QuasiSeparatedSpace (p ⁻¹ᵁ O : Scheme.{u}) := by
    intro X p hX
    exact qcqs p O hO (p ⁻¹ᵁ O).ι (by rw [Scheme.Opens.range_ι]; rfl)
  have qcqsT : ∀ {X : Scheme.{u}} (p : X ⟶ B), IsAffine X →
      CompactSpace (Limits.pullback (C := Scheme.{u}) O.ι p) ∧
        QuasiSeparatedSpace (Limits.pullback (C := Scheme.{u}) O.ι p) := by
    intro X p hX
    exact qcqs p O hO (Limits.pullback.snd O.ι p)
      (by rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι])

  have gA : ∀ {X Tl : Scheme.{u}} (p : X ⟶ B) (pT : Tl ⟶ B) (φ : Tl ⟶ X), φ ≫ p = pT →
      ∃ a : Limits.pullback O.ι pT ⟶ (p ⁻¹ᵁ O : Scheme.{u}),
        a ≫ (p ⁻¹ᵁ O).ι = Limits.pullback.snd O.ι pT ≫ φ ∧
        a ≫ ((p ⁻¹ᵁ O).ι ≫ p) = Limits.pullback.snd O.ι pT ≫ pT := by
    intro X Tl p pT φ hφ
    have hr : Set.range (Limits.pullback.snd O.ι pT ≫ φ) ⊆ Set.range (p ⁻¹ᵁ O).ι := by
      rintro _ ⟨π, rfl⟩
      rw [Scheme.Opens.range_ι]
      have h0 : O.ι (Limits.pullback.fst O.ι pT π) ∈ Set.range O.ι := Set.mem_range_self _
      rw [Scheme.Opens.range_ι] at h0
      have e : (Limits.pullback.snd O.ι pT ≫ φ) ≫ p = Limits.pullback.fst O.ι pT ≫ O.ι := by
        rw [Category.assoc, hφ, Limits.pullback.condition]
      have h1 : ((Limits.pullback.snd O.ι pT ≫ φ) ≫ p) π ∈ O := by
        rw [e]; exact h0
      exact h1
    refine ⟨IsOpenImmersion.lift _ _ hr, IsOpenImmersion.lift_fac _ _ _, ?_⟩
    rw [← Category.assoc, IsOpenImmersion.lift_fac, Category.assoc, hφ]

  have gK3 : ∀ {Z X X' : Scheme.{u}} (W : X.Opens) (W' : X'.Opens) (f : X ⟶ X')
      (e : W ≤ f ⁻¹ᵁ W') (a : Z ⟶ (W : Scheme.{u})) (a' : Z ⟶ (W' : Scheme.{u})) (s : Z ⟶ X)
      (s' : Z ⟶ X'), a ≫ W.ι = s → a' ≫ W'.ι = s' → s ≫ f = s' → a ≫ f.resLE W' W e = a' := by
    intro Z X X' W W' f e a a' s s' h1 h2 h3
    rw [← cancel_mono W'.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, h1, h2, h3]

  have gw : ∀ {X X' : Scheme.{u}} (p : X ⟶ B) (p' : X' ⟶ B) (f : X ⟶ X'), f ≫ p' = p →
      ∀ (W : X.Opens) (W' : X'.Opens) (e : W ≤ f ⁻¹ᵁ W'),
      f.resLE W' W e ≫ (W'.ι ≫ p') = W.ι ≫ p := by
    intro X X' p p' f hf W W' e
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hf]
  have gid : ∀ {X : Scheme.{u}} (W : X.Opens) (f : X ⟶ X), f = 𝟙 X → ∀ (e : W ≤ f ⁻¹ᵁ W),
      f.resLE W W e = 𝟙 _ := by
    intro X W f hf e
    rw [← cancel_mono W.ι, Scheme.Hom.resLE_comp_ι, hf, Category.comp_id, Category.id_comp]
  have gcomp : ∀ {X X' X'' : Scheme.{u}} (W : X.Opens) (W' : X'.Opens) (W'' : X''.Opens)
      (f : X ⟶ X') (g : X' ⟶ X'') (h : X ⟶ X''), f ≫ g = h →
      ∀ (e1 : W ≤ f ⁻¹ᵁ W') (e2 : W' ≤ g ⁻¹ᵁ W'') (e3 : W ≤ h ⁻¹ᵁ W''),
      h.resLE W'' W e3 = f.resLE W' W e1 ≫ g.resLE W'' W' e2 := by
    intro X X' X'' W W' W'' f g h hh e1 e2 e3
    rw [← cancel_mono W''.ι, Scheme.Hom.resLE_comp_ι, Category.assoc, Scheme.Hom.resLE_comp_ι,
      ← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hh]

  have s3g : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (X : Λ → Scheme.{u})
      (fX : ∀ {l l' : Λ}, (l ⟶ l') → (X l ⟶ X l')) (p : ∀ l, X l ⟶ B)
      (Tl : Scheme.{u}) (pT : Tl ⟶ B) (φ : ∀ l, Tl ⟶ X l) (hφp : ∀ l, φ l ≫ p l = pT)
      (limU : ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ X l),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ fX t = z l') → ∃! h : Z ⟶ Tl, ∀ l, h ≫ φ l = z l)
      (α : ∀ l, Limits.pullback O.ι pT ⟶ (p l ⁻¹ᵁ O : Scheme.{u}))
      (hα : ∀ l, α l ≫ (p l ⁻¹ᵁ O).ι = Limits.pullback.snd O.ι pT ≫ φ l)
      (ρ : ∀ {l l' : Λ}, (l ⟶ l') → ((p l ⁻¹ᵁ O : Scheme.{u}) ⟶ (p l' ⁻¹ᵁ O : Scheme.{u})))
      (hρ : ∀ {l l' : Λ} (t : l ⟶ l'), ρ t ≫ (p l' ⁻¹ᵁ O).ι = (p l ⁻¹ᵁ O).ι ≫ fX t),
      ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (p l ⁻¹ᵁ O : Scheme.{u})),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ρ t = z l') →
        ∃! h : Z ⟶ Limits.pullback O.ι pT, ∀ l, h ≫ α l = z l := by
    intro Λ _ _ X fX p Tl pT φ hφp limU α hα ρ hρ Z z hz
    have hy : ∀ {l l' : Λ} (t : l ⟶ l'),
        (z l ≫ (p l ⁻¹ᵁ O).ι) ≫ fX t = z l' ≫ (p l' ⁻¹ᵁ O).ι := by
      intro l l' t
      rw [Category.assoc, ← hρ t, ← Category.assoc, hz t]
    obtain ⟨h₀, hh₀, hu₀⟩ := limU Z (fun l => z l ≫ (p l ⁻¹ᵁ O).ι) hy
    have hh₀' : ∀ l, h₀ ≫ φ l = z l ≫ (p l ⁻¹ᵁ O).ι := hh₀
    obtain ⟨l₀⟩ : Nonempty Λ := IsCofiltered.nonempty
    have hrng : Set.range (h₀ ≫ pT) ⊆ Set.range O.ι := by
      rintro _ ⟨ζ, rfl⟩
      rw [Scheme.Opens.range_ι]
      have e0 : h₀ ≫ pT = z l₀ ≫ (p l₀ ⁻¹ᵁ O).ι ≫ p l₀ := by
        rw [← hφp l₀, ← Category.assoc, hh₀' l₀, Category.assoc]
      have h0 : (p l₀ ⁻¹ᵁ O).ι (z l₀ ζ) ∈ Set.range (p l₀ ⁻¹ᵁ O).ι := Set.mem_range_self _
      rw [Scheme.Opens.range_ι] at h0
      rw [e0]
      exact h0
    let h₁ := IsOpenImmersion.lift O.ι (h₀ ≫ pT) hrng
    have hh₁ : h₁ ≫ O.ι = h₀ ≫ pT := IsOpenImmersion.lift_fac _ _ _
    refine ⟨Limits.pullback.lift h₁ h₀ hh₁, fun l => ?_, fun h' hh' => ?_⟩
    · rw [← cancel_mono (p l ⁻¹ᵁ O).ι, Category.assoc, hα l, ← Category.assoc,
        Limits.pullback.lift_snd, hh₀' l]
    · rw [← cancel_mono (Limits.pullback.snd O.ι pT), Limits.pullback.lift_snd]
      refine hu₀ _ (fun l => ?_)
      show (h' ≫ Limits.pullback.snd O.ι pT) ≫ φ l = z l ≫ (p l ⁻¹ᵁ O).ι
      rw [Category.assoc, ← hα l, ← Category.assoc, hh' l]

  obtain ⟨P⟩ := wc_etPres_of_affIndEt B A hA T 0 Fin.elim0 (fun i => i.elim0) hT
    (fun i => i.elim0)
  letI := P.cat
  haveI := P.cofil
  haveI : IsAffine T.left := hT.1
  have hpre : ∀ {l l' : P.Λ} (t : l ⟶ l') (x : (P.U'.obj l).left),
      (P.U'.obj l').hom ((P.U'.map t).left x) = (P.U'.obj l).hom x := by
    intro l l' t x
    exact congrArg (fun g : (P.U'.obj l).left ⟶ B => g x) (MorphismProperty.Over.w (P.U'.map t))
  have hle : ∀ {l l' : P.Λ} (t : l ⟶ l'), (P.U'.obj l).hom ⁻¹ᵁ O ≤
      (P.U'.map t).left ⁻¹ᵁ ((P.U'.obj l').hom ⁻¹ᵁ O) := by
    intro l l' t x hx
    show (P.U'.obj l').hom ((P.U'.map t).left x) ∈ O
    rw [hpre]
    exact hx
  have hge : ∀ {l l' : P.Λ} (t : l ⟶ l'),
      (P.U'.map t).left ⁻¹ᵁ ((P.U'.obj l').hom ⁻¹ᵁ O) ≤ (P.U'.obj l).hom ⁻¹ᵁ O := by
    intro l l' t x hx
    show (P.U'.obj l).hom x ∈ O
    rw [← hpre t x]
    exact hx

  let Dc : P.Λ ⥤ B.Etale :=
    { obj := fun l => wcEtOpen B (P.U'.obj l) ((P.U'.obj l).hom ⁻¹ᵁ O)
      map := @fun l l' t => MorphismProperty.Over.homMk
        ((P.U'.map t).left.resLE ((P.U'.obj l').hom ⁻¹ᵁ O) ((P.U'.obj l).hom ⁻¹ᵁ O) (hle t))
        (gw (P.U'.obj l).hom (P.U'.obj l').hom (P.U'.map t).left
          (MorphismProperty.Over.w (P.U'.map t)) _ _ (hle t)) trivial
      map_id := fun l => MorphismProperty.Over.Hom.ext
        (gid ((P.U'.obj l).hom ⁻¹ᵁ O) (P.U'.map (𝟙 l)).left
          (congrArg (fun g => g.left) (P.U'.map_id l)) (hle (𝟙 l)))
      map_comp := @fun l l' l'' t t' => MorphismProperty.Over.Hom.ext
        (gcomp ((P.U'.obj l).hom ⁻¹ᵁ O) ((P.U'.obj l').hom ⁻¹ᵁ O) ((P.U'.obj l'').hom ⁻¹ᵁ O)
          (P.U'.map t).left (P.U'.map t').left (P.U'.map (t ≫ t')).left
          (congrArg (fun g => g.left) (P.U'.map_comp t t')).symm (hle t) (hle t') (hle (t ≫ t'))) }

  choose a ha1 ha2 using fun l => gA (P.U'.obj l).hom T.hom (P.φ l).left
    (MorphismProperty.Over.w (P.φ l))
  let ac : ∀ l, wcOpenRestr B O T ⟶ (wcEtToProEt B).obj (Dc.obj l) := fun l =>
    MorphismProperty.Over.homMk (a l) (ha2 l) trivial
  have K2 : ∀ l, ac l ≫ (wcEtToProEt B).map
      (wcEtOpenι B (P.U'.obj l) ((P.U'.obj l).hom ⁻¹ᵁ O)) = wcOpenRestrIncl B O T ≫ P.φ l :=
    fun l => MorphismProperty.Over.Hom.ext (ha1 l)
  have K3 : ∀ {l l' : P.Λ} (t : l ⟶ l'), ac l ≫ (wcEtToProEt B).map (Dc.map t) = ac l' := by
    intro l l' t
    have hφt : (P.φ l).left ≫ (P.U'.map t).left = (P.φ l').left :=
      congrArg (fun g => g.left) (P.hφ t)
    exact MorphismProperty.Over.Hom.ext
      (gK3 ((P.U'.obj l).hom ⁻¹ᵁ O) ((P.U'.obj l').hom ⁻¹ᵁ O) (P.U'.map t).left (hle t)
        (a l) (a l') _ _ (ha1 l) (ha1 l')
        ((Category.assoc (Limits.pullback.snd O.ι T.hom) (P.φ l).left (P.U'.map t).left).trans
          (congrArg (Limits.pullback.snd O.ι T.hom ≫ ·) hφt)))

  have hDq : ∀ l, CompactSpace (Dc.obj l).left ∧ QuasiSeparatedSpace (Dc.obj l).left :=
    fun l => qcqsW (P.U'.obj l).hom (P.affU l)
  have hTq : CompactSpace (wcOpenRestr B O T).left ∧
      QuasiSeparatedSpace (wcOpenRestr B O T).left := qcqsT T.hom hT.1
  have hAff : ∀ {l l' : P.Λ} (t : l ⟶ l'), IsAffineHom (Dc.map t).left :=
    fun t => affres _ _ _ (hle t) (hge t) (P.affU _) (P.affU _)

  have hlim : ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (Dc.obj l).left),
      (∀ {l l' : P.Λ} (t : l ⟶ l'), z l ≫ (Dc.map t).left = z l') →
      ∃! h : Z ⟶ (wcOpenRestr B O T).left, ∀ l, h ≫ (ac l).left = z l :=
    s3g P.Λ (fun l => (P.U'.obj l).left) (fun t => (P.U'.map t).left)
      (fun l => (P.U'.obj l).hom) T.left T.hom (fun l => (P.φ l).left)
      (fun l => MorphismProperty.Over.w (P.φ l)) P.limU a ha1
      (fun t => (Dc.map t).left) (fun t => Scheme.Hom.resLE_comp_ι _ (hle t))


  have unat : ∀ {V V' : B.Etale} (f : V' ⟶ V) (s : H.obj.obj (Opposite.op V)),
      (((wcEpsInv B).obj H).obj.map ((wcEtToProEt B).map f).op).hom
        (((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).app
          (Opposite.op ((wcEtToProEt B).obj V))).hom
          ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op V)).hom s)) =
      ((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).app
          (Opposite.op ((wcEtToProEt B).obj V'))).hom
          ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op V')).hom
            ((H.obj.map f.op).hom s)) := by
    intro V V' f s
    have e1 : (((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op V')).hom
          ((H.obj.map f.op).hom s) =
        (((wcEtToProEt B).op.lan.obj H.obj).map ((wcEtToProEt B).map f).op).hom
          ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op V)).hom s) :=
      congrArg (fun φ => φ.hom s) (((wcEtToProEt B).op.lanUnit.app H.obj).naturality f.op)
    have e2 := congrArg (fun φ => φ.hom
        ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op V)).hom s))
      ((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).naturality
        ((wcEtToProEt B).map f).op)
    rw [e1]
    exact e2.symm

  obtain ⟨l, h, hy⟩ := wc_epsInv_limit_surj B H (wcOpenRestr B O T) P.Λ Dc ac K3
    (fun l => (hDq l).1) (fun l => (hDq l).2) hAff hTq.1 hTq.2 hlim y
  obtain ⟨x₀, hx₀⟩ := hext (P.U'.obj l) (P.affU l) h
  have hcomp : ∀ {X Y Z : B.ProEt} (g : X ⟶ Y) (g' : Y ⟶ Z)
      (z : ((wcEpsInv B).obj H).obj.obj (Opposite.op Z)),
      (((wcEpsInv B).obj H).obj.map (g ≫ g').op).hom z =
        (((wcEpsInv B).obj H).obj.map g.op).hom ((((wcEpsInv B).obj H).obj.map g'.op).hom z) := by
    intro X Y Z g g' z
    rw [op_comp, Functor.map_comp]
    rfl
  refine ⟨(((wcEpsInv B).obj H).obj.map (P.φ l).op).hom
    (((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).app
      (Opposite.op ((wcEtToProEt B).obj (P.U'.obj l)))).hom
      ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op (P.U'.obj l))).hom x₀)), ?_⟩
  have e2 := congrArg (fun g => (((wcEpsInv B).obj H).obj.map g.op).hom
      (((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).app
        (Opposite.op ((wcEtToProEt B).obj (P.U'.obj l)))).hom
        ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op (P.U'.obj l))).hom x₀))) (K2 l)
  have e5 := congrArg (fun z => (((wcEpsInv B).obj H).obj.map (ac l).op).hom z)
    (unat (wcEtOpenι B (P.U'.obj l) ((P.U'.obj l).hom ⁻¹ᵁ O)) x₀)
  have e6 : ((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).app
          (Opposite.op ((wcEtToProEt B).obj (Dc.obj l)))).hom
          ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op (Dc.obj l))).hom
            ((H.obj.map (wcEtOpenι B (P.U'.obj l) ((P.U'.obj l).hom ⁻¹ᵁ O)).op).hom x₀)) =
      N • ((toSheafify (Scheme.ProEt.topology B) ((wcEtToProEt B).op.lan.obj H.obj)).app
          (Opposite.op ((wcEtToProEt B).obj (Dc.obj l)))).hom
          ((((wcEtToProEt B).op.lanUnit.app H.obj).app (Opposite.op (Dc.obj l))).hom h) := by
    rw [hx₀, map_nsmul, map_nsmul]
  exact (hcomp (wcOpenRestrIncl B O T) (P.φ l) _).symm.trans (e2.symm.trans
    ((hcomp (ac l) ((wcEtToProEt B).map (wcEtOpenι B (P.U'.obj l) ((P.U'.obj l).hom ⁻¹ᵁ O))) _).trans
    (e5.trans ((congrArg (fun z => (((wcEpsInv B).obj H).obj.map (ac l).op).hom z) e6).trans
    ((map_nsmul (((wcEpsInv B).obj H).obj.map (ac l).op).hom N _).trans
    (congrArg (fun z => N • z) hy))))))

theorem wc_P1_et_good_of_generic_agree (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (O : (wcP1Over K).left.Opens)
    (hO : ∀ p : (wcP1Over K).left, p ∈ O ↔ ∀ i : Fin m, p ≠ S i (IsLocalRing.closedPoint K))
    (G : Sheaf (Scheme.smallEtaleTopology (wcP1Over K).left) AddCommGrpCat.{u+1}) (N : ℕ)
    (V : (wcP1Over K).left.Etale)
    (h : G.obj.obj (Opposite.op (wcEtOpen (wcP1Over K).left V (V.hom ⁻¹ᵁ O))))
    (W : (wcP1Over K).left.Etale) (f : W ⟶ V) (x : G.obj.obj (Opposite.op W))
    (w : W.left) (i : Fin m) (hw : W.hom w = S i (IsLocalRing.closedPoint K))
    (hgen : ∀ w₀ : W.left, w₀ ⤳ w → W.hom w₀ ≠ W.hom w →
      ∃ (W₂ : (wcP1Over K).left.Etale) (c₂ : W₂ ⟶ W), w₀ ∈ Set.range c₂.left ∧
        ∀ (Z : (wcP1Over K).left.Etale) (g : Z ⟶ W₂)
          (g' : Z ⟶ wcEtOpen (wcP1Over K).left V (V.hom ⁻¹ᵁ O)),
          g ≫ c₂ ≫ f = g' ≫ wcEtOpenι (wcP1Over K).left V (V.hom ⁻¹ᵁ O) →
          (G.obj.map g.op).hom ((G.obj.map c₂.op).hom x) = N • (G.obj.map g'.op).hom h) :
    ∃ (W₁ : (wcP1Over K).left.Etale) (f₁ : W₁ ⟶ V) (x₁ : G.obj.obj (Opposite.op W₁)),
      f.left w ∈ Set.range f₁.left ∧
      ∀ (Z : (wcP1Over K).left.Etale) (g : Z ⟶ W₁)
        (g' : Z ⟶ wcEtOpen (wcP1Over K).left V (V.hom ⁻¹ᵁ O)),
        g ≫ f₁ = g' ≫ wcEtOpenι (wcP1Over K).left V (V.hom ⁻¹ᵁ O) →
        (G.obj.map g.op).hom x₁ = N • (G.obj.map g'.op).hom h :=
by
  classical

  have comp_ap : ∀ {X₁ Y₁ Z₁ : Scheme.{u}} (f₀ : X₁ ⟶ Y₁) (g₀ : Y₁ ⟶ Z₁) (x₀ : X₁),
      (f₀ ≫ g₀) x₀ = g₀ (f₀ x₀) := by
    intro X₁ Y₁ Z₁ f₀ g₀ x₀
    first
    | rfl
    | simp
  have resComp : ∀ {A₁ A₂ A₃ : (wcP1Over K).left.Etale} (a : A₁ ⟶ A₂) (b : A₂ ⟶ A₃)
      (z : G.obj.obj (Opposite.op A₃)),
      (G.obj.map (a ≫ b).op).hom z = (G.obj.map a.op).hom ((G.obj.map b.op).hom z) := by
    intro A₁ A₂ A₃ a b z
    rw [op_comp, Functor.map_comp]
    rfl
  have hEtHom : ∀ {A B : (wcP1Over K).left.Etale} (c : A ⟶ B), Etale c.left := by
    intro A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom

  have L2 : ∀ {T Z : (wcP1Over K).left.Etale}
      (a b : Z ⟶ wcEtOpen (wcP1Over K).left T (T.hom ⁻¹ᵁ O)),
      a ≫ wcEtOpenι (wcP1Over K).left T (T.hom ⁻¹ᵁ O) =
        b ≫ wcEtOpenι (wcP1Over K).left T (T.hom ⁻¹ᵁ O) → a = b := by
    intro T Z a b hab
    apply MorphismProperty.Over.Hom.ext
    haveI : Mono (T.hom ⁻¹ᵁ O).ι := IsOpenImmersion.mono _
    have h1 : a.left ≫ (T.hom ⁻¹ᵁ O).ι = b.left ≫ (T.hom ⁻¹ᵁ O).ι :=
      congrArg (fun φ => φ.left) hab
    exact (cancel_mono (T.hom ⁻¹ᵁ O).ι).1 h1

  have L1 : ∀ (T Z : (wcP1Over K).left.Etale) (a : Z ⟶ T),
      ∃ a' : wcEtOpen (wcP1Over K).left Z (Z.hom ⁻¹ᵁ O) ⟶
          wcEtOpen (wcP1Over K).left T (T.hom ⁻¹ᵁ O),
        a' ≫ wcEtOpenι (wcP1Over K).left T (T.hom ⁻¹ᵁ O) =
          wcEtOpenι (wcP1Over K).left Z (Z.hom ⁻¹ᵁ O) ≫ a := by
    intro T Z a
    have hw : a.left ≫ T.hom = Z.hom := MorphismProperty.Over.w a
    have hle : Z.hom ⁻¹ᵁ O ≤ a.left ⁻¹ᵁ (T.hom ⁻¹ᵁ O) := by
      intro z hz
      have e : T.hom (a.left z) = Z.hom z := by
        rw [← hw]
        exact (comp_ap _ _ _).symm
      show T.hom (a.left z) ∈ O
      rw [e]
      exact hz
    refine ⟨MorphismProperty.Over.homMk (a.left.resLE (T.hom ⁻¹ᵁ O) (Z.hom ⁻¹ᵁ O) hle) ?_
      trivial, ?_⟩
    · change a.left.resLE _ _ hle ≫ ((T.hom ⁻¹ᵁ O).ι ≫ T.hom) = (Z.hom ⁻¹ᵁ O).ι ≫ Z.hom
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hw]
    · apply MorphismProperty.Over.Hom.ext
      change a.left.resLE _ _ hle ≫ (T.hom ⁻¹ᵁ O).ι = (Z.hom ⁻¹ᵁ O).ι ≫ a.left
      exact Scheme.Hom.resLE_comp_ι _ _


  have s1 : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (V : Y.Etale) (g : G.obj.obj (Opposite.op V)) (V₁ : Y.Etale) (c : V₁ ⟶ V),
      Set.range c.left ⊆ {v : V.left | ∃ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V), v ∈ Set.range c₂.left ∧
        G.obj.map c₂.op g = 0} → G.obj.map c.op g = 0 := by
    intro Y G V g
    have hEtHom : ∀ {A B : Y.Etale} (c : A ⟶ B), Etale c.left := by
      intro A B c
      have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
      have h1 : Etale B.hom := B.prop
      have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
      exact Etale.of_comp c.left B.hom
    intro V₁ c hsub
    let S : Sieve V₁ :=
      { arrows := fun D d => G.obj.map d.op (G.obj.map c.op g) = 0
        downward_closed := by
          intro D D' d hd e
          change G.obj.map (e ≫ d).op (G.obj.map c.op g) = 0
          rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
          rw [hd, map_zero] }
    have hS : S ∈ Scheme.smallEtaleTopology Y V₁ := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V₁
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro p
      obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨p, rfl⟩
      haveI : Etale c₂.left := hEtHom c₂
      haveI : Etale V₁.hom := V₁.prop
      let fst := Limits.pullback.fst c.left c₂.left
      let snd := Limits.pullback.snd c.left c₂.left
      haveI hfst : Etale fst := inferInstance
      let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
      have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
      let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
      have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback p q₀ hq₀.symm
      have hπ₁ : S.arrows π₁ := by
        change G.obj.map π₁.op (G.obj.map c.op g) = 0
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
          Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
      exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
    have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj G).2
    exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
      change G.obj.map d.op (G.obj.map c.op g) = G.obj.map d.op 0
      rw [map_zero]
      exact hd)


  have s2 : ∀ {X : Type u} [TopologicalSpace X] [QuasiSober X],
      (∀ x : X, ∃ A : Set X, IsOpen A ∧ x ∈ A ∧ TopologicalSpace.NoetherianSpace A) →
      ∀ (U G : Set X), IsOpen U → IsOpen G → ∀ w : X, w ∈ closure (U \ G) →
      ∃ z : X, z ⤳ w ∧ z ∈ U ∧ z ∉ G := by
    intro X _ _ hloc U G hU hG w hw
    obtain ⟨A, hAo, hwA, hAn⟩ := hloc w
    haveI := hAn
    obtain ⟨C', hC'⟩ : ∃ C' : Set A, C' = Subtype.val ⁻¹' (U \ G) := ⟨_, rfl⟩
    have h1 : (⟨w, hwA⟩ : A) ∈ closure C' := by
      rw [hC', closure_subtype, Subtype.image_preimage_coe]
      exact hAo.inter_closure ⟨hwA, hw⟩
    obtain ⟨S, hSf, hScl, hSirr, hSeq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
        (isClosed_closure (s := C'))
    have h2 : C' = ⋃ t ∈ S, (t ∩ C') := by
      ext c
      constructor
      · intro hc
        have hc' : c ∈ ⋃₀ S := by
          rw [← hSeq]
          exact subset_closure hc
        obtain ⟨t, ht, hct⟩ := hc'
        exact Set.mem_biUnion ht ⟨hct, hc⟩
      · intro hc
        obtain ⟨t, _, hct⟩ := Set.mem_iUnion₂.mp hc
        exact hct.2
    have h3 : closure C' = ⋃ t ∈ S, closure (t ∩ C') :=
      (congrArg closure h2).trans (hSf.closure_biUnion _)
    rw [h3] at h1
    obtain ⟨t, htS, hwt⟩ := Set.mem_iUnion₂.mp h1
    have hne : (t ∩ C').Nonempty := by
      by_contra hne
      rw [Set.not_nonempty_iff_eq_empty] at hne
      rw [hne, closure_empty] at hwt
      exact hwt
    have hwt' : (⟨w, hwA⟩ : A) ∈ t :=
      ((hScl t htS).closure_subset_iff.mpr Set.inter_subset_left) hwt
    have hT : IsIrreducible (Subtype.val '' t) :=
      (hSirr t htS).image _ continuous_subtype_val.continuousOn
    have hgp := hT.isGenericPoint_genericPoint_closure
    have hF : closure C' ⊆ Subtype.val ⁻¹' Gᶜ := by
      apply (IsClosed.preimage continuous_subtype_val hG.isClosed_compl).closure_subset_iff.mpr
      intro c hc
      rw [hC'] at hc
      exact hc.2
    have htF : Subtype.val '' t ⊆ Gᶜ := by
      rintro _ ⟨a, ha, rfl⟩
      have ha' : a ∈ closure C' := by
        rw [hSeq]
        exact ⟨t, htS, ha⟩
      exact hF ha'
    have hcl : closure (Subtype.val '' t) ⊆ Gᶜ := hG.isClosed_compl.closure_subset_iff.mpr htF
    refine ⟨hT.genericPoint, ?_, ?_, ?_⟩
    · exact hgp.specializes (subset_closure ⟨_, hwt', rfl⟩)
    · obtain ⟨c, hct, hcC⟩ := hne
      rw [hC'] at hcC
      exact (hgp.mem_open_set_iff hU).mpr ⟨c.1, subset_closure ⟨c, hct, rfl⟩, hcC.1⟩
    · exact hcl hgp.mem

  haveI hPp : IsProper (wcProjKStr K 1) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) K _
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (A := MvPolynomial (Fin (1+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0 =>
          (x : MvPolynomial (Fin (1+1)) K)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) K).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) K).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) K).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))))
    infer_instance
  haveI hPn : IsLocallyNoetherian (wcP1Over K).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (wcProjKStr K 1) inferInstance inferInstance
  haveI hWet : Etale W.hom := W.prop
  haveI hWn : IsLocallyNoetherian W.left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ W.hom inferInstance hPn
  have hloc : ∀ p : W.left, ∃ A : Set W.left, IsOpen A ∧ p ∈ A ∧
      TopologicalSpace.NoetherianSpace A := by
    intro p
    obtain ⟨A, hA, hpA, -⟩ := exists_isAffineOpen_mem_and_subset (x := p) (U := ⊤) (by simp)
    haveI := IsLocallyNoetherian.component_noetherian (X := W.left) ⟨A, hA⟩
    exact ⟨A, A.isOpen, hpA, noetherianSpace_of_isAffineOpen A hA⟩
  have hwO : W.hom w ∉ O := by
    intro hm
    exact ((hO _).1 hm) i hw

  obtain ⟨fo, hfo⟩ := L1 V W f
  obtain ⟨d, hd⟩ : ∃ d : G.obj.obj (Opposite.op (wcEtOpen (wcP1Over K).left W (W.hom ⁻¹ᵁ O))),
      d = (G.obj.map (wcEtOpenι (wcP1Over K).left W (W.hom ⁻¹ᵁ O)).op).hom x -
        N • (G.obj.map fo.op).hom h := ⟨_, rfl⟩

  let Gset : Set W.left := {p | ∃ (V₁ : (wcP1Over K).left.Etale)
    (c : V₁ ⟶ wcEtOpen (wcP1Over K).left W (W.hom ⁻¹ᵁ O)) (v₁ : V₁.left),
    (W.hom ⁻¹ᵁ O).ι (c.left v₁) = p ∧ (G.obj.map c.op).hom d = 0}
  have hGopen : IsOpen Gset := by
    rw [isOpen_iff_forall_mem_open]
    rintro p ⟨V₁, c, v₁, hp, hc⟩
    haveI := hEtHom c
    refine ⟨Set.range (fun v => (W.hom ⁻¹ᵁ O).ι (c.left v)), ?_, ?_, ⟨v₁, hp⟩⟩
    · rintro _ ⟨v, rfl⟩
      exact ⟨V₁, c, v, rfl, hc⟩
    · exact (((W.hom ⁻¹ᵁ O).ι.isOpenEmbedding.isOpenMap).comp c.left.isOpenMap).isOpen_range

  have hgen' : ∀ z : W.left, z ⤳ w → W.hom z ∈ O → z ∈ Gset := by
    intro z hzw hzO
    have hne : W.hom z ≠ W.hom w := fun he => hwO (he ▸ hzO)
    obtain ⟨W₂, c₂, ⟨w₂, hw₂⟩, hgood⟩ := hgen z hzw hne
    have hw₂O : W₂.hom w₂ ∈ O := by
      have e : W.hom (c₂.left w₂) = W₂.hom w₂ := by
        rw [← MorphismProperty.Over.w c₂]
        exact (comp_ap _ _ _).symm
      rw [← e, hw₂]
      exact hzO
    obtain ⟨v₁, hv₁⟩ : w₂ ∈ Set.range (W₂.hom ⁻¹ᵁ O).ι := by
      rw [Scheme.Opens.range_ι]
      exact hw₂O
    obtain ⟨c, hc⟩ := L1 W W₂ c₂
    have hcl : c.left ≫ (W.hom ⁻¹ᵁ O).ι = (W₂.hom ⁻¹ᵁ O).ι ≫ c₂.left :=
      congrArg (fun q => q.left) hc
    refine ⟨_, c, v₁, ?_, ?_⟩
    · calc (W.hom ⁻¹ᵁ O).ι (c.left v₁) = (c.left ≫ (W.hom ⁻¹ᵁ O).ι) v₁ := (comp_ap _ _ _).symm
        _ = ((W₂.hom ⁻¹ᵁ O).ι ≫ c₂.left) v₁ := by rw [hcl]; rfl
        _ = c₂.left ((W₂.hom ⁻¹ᵁ O).ι v₁) := comp_ap _ _ _
        _ = z := by rw [hv₁, hw₂]
    · have hyp : wcEtOpenι (wcP1Over K).left W₂ (W₂.hom ⁻¹ᵁ O) ≫ c₂ ≫ f =
          (c ≫ fo) ≫ wcEtOpenι (wcP1Over K).left V (V.hom ⁻¹ᵁ O) := by
        rw [Category.assoc, hfo, ← Category.assoc c, hc, Category.assoc]
      have e1 : (G.obj.map (wcEtOpenι (wcP1Over K).left W₂ (W₂.hom ⁻¹ᵁ O) ≫ c₂).op).hom x =
          N • (G.obj.map (c ≫ fo).op).hom h := by
        rw [resComp]
        exact hgood _ _ _ hyp
      rw [hd, map_sub, map_nsmul, ← resComp, ← resComp, hc, e1, sub_self]

  have hwcl : w ∉ closure ({p : W.left | W.hom p ∈ O} \ Gset) := by
    intro hmem
    obtain ⟨z, hzw, hzU, hzG⟩ := s2 hloc _ _ (by exact (W.hom ⁻¹ᵁ O).isOpen) hGopen w hmem
    exact hzG (hgen' z hzw hzU)

  let Wo : W.left.Opens :=
    ⟨(closure ({p : W.left | W.hom p ∈ O} \ Gset))ᶜ, isClosed_closure.isOpen_compl⟩

  have hvan : ∀ (Z : (wcP1Over K).left.Etale)
      (g₀ : Z ⟶ wcEtOpen (wcP1Over K).left W (W.hom ⁻¹ᵁ O)),
