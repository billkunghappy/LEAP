      exact k1.symm
    have hNred : ((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
          (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.app (Opposite.op Ty)).hom
          (((((wcProEtPush h).rightDerived (n - 1)).obj (wcIntSheaf Xu.left ℓ)).obj.map
            m.op).hom y₀) =
        ((((wcProEtPush h).rightDerived (n - 1)).obj
            (wcContSheaf Xu.left (ZMod (ℓ ^ N)))).obj.map m.op).hom
          (((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
            (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.app
              (Opposite.op Ty)).hom y₀) := by
      have k1 := congrArg (fun f => f.hom y₀)
        ((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
          (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.naturality m.op)
      exact k1
    have e1 : ((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
          (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.app (Opposite.op Ty)).hom
          ((((((wcProEtPush h).rightDerived (n - 1)).obj (wcIntSheaf Xu.left ℓ)).obj.map
            m.op).hom y₀) - y₀) =
        ((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
          (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.app (Opposite.op Ty)).hom
          (((((wcProEtPush h).rightDerived (n - 1)).obj (wcIntSheaf Xu.left ℓ)).obj.map
            m.op).hom y₀) -
        ((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
          (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.app (Opposite.op Ty)).hom
          y₀ := map_sub _ _ _
    have hy' : ((((wcProEtPush h).rightDerived (n - 1)).map (wcContSheafMap Xu.left
          (PadicInt.toZModPow (p := ℓ) N).toAddMonoidHom (hcN N))).hom.app (Opposite.op Ty)).hom
          ((((((wcProEtPush h).rightDerived (n - 1)).obj (wcIntSheaf Xu.left ℓ)).obj.map
            m.op).hom y₀) - y₀) = 0 := by
      rw [e1, hNred, hF, sub_self]
    obtain ⟨w₀, hw₀⟩ := wc_xwtlc_int_red_exact h ℓ (n - 1) N (hcN N) Ty hproj _ hy'
    refine ⟨((((wcProEtPush h).rightDerived (n - 1)).map (wcIntToLadic Xu.left ℓ)).hom.app
      (Opposite.op Ty)).hom w₀, ⟨w₀, rfl⟩, ?_⟩
    rw [hNι]
    refine (map_sub ((((wcProEtPush h).rightDerived (n - 1)).map
      (wcIntToLadic Xu.left ℓ)).hom.app (Opposite.op Ty)).hom _ _).symm.trans ?_
    refine (congrArg ((((wcProEtPush h).rightDerived (n - 1)).map
      (wcIntToLadic Xu.left ℓ)).hom.app (Opposite.op Ty)).hom hw₀).trans ?_
    refine (map_nsmul ((((wcProEtPush h).rightDerived (n - 1)).map
      (wcIntToLadic Xu.left ℓ)).hom.app (Opposite.op Ty)).hom (ℓ ^ N) w₀).trans ?_
    exact (hSc N _).symm

theorem wc_pfam_xi_wild_trivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uξ = uξ)
    (hwild : ∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Vξ) (eE : Ty ⟶ E),
      Etale πE.left → eE ≫ πE = uξ →
      ∃ k : ℕ, (fun g : Ty ⟶ E => τ ≫ g)^[Nat.card F'' ^ k] eE = eE) :
    ∀ x, ((wcRq h ℓ (n - 1)).obj.map τ.op).hom x = x :=
by
  classical
  obtain ⟨L1, L2, L3, L4⟩ := wc_pfam_xwt_scalar_laws h ℓ (n - 1)
  obtain ⟨B, hBs, hBalt, hBnd, hBinv⟩ := wc_pfam_xwt_cup_form F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ
    lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ
  obtain ⟨Λ, hΛs, hΛspan, hΛsep, hcontN⟩ := wc_pfam_xwt_lattice_continuity F' F'' Y n hn hn2 D
    ℓ hℓ M' Xu h Δ lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ
  have hcompR : ∀ (a b : Ty ⟶ Ty) (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      ((wcRq h ℓ (n - 1)).obj.map (a ≫ b).op).hom x =
        ((wcRq h ℓ (n - 1)).obj.map a.op).hom (((wcRq h ℓ (n - 1)).obj.map b.op).hom x) := by
    intro a b x
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have hidR : ∀ x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
      ((wcRq h ℓ (n - 1)).obj.map (𝟙 Ty).op).hom x = x := by
    intro x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hcompξ : ∀ x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Vξ),
      ((wcRq h ℓ (n - 1)).obj.map τ.op).hom (((wcRq h ℓ (n - 1)).obj.map uξ.op).hom x) =
        ((wcRq h ℓ (n - 1)).obj.map uξ.op).hom x := by
    intro x
    have hx : ((wcRq h ℓ (n - 1)).obj.map (τ ≫ uξ).op).hom x =
        ((wcRq h ℓ (n - 1)).obj.map τ.op).hom (((wcRq h ℓ (n - 1)).obj.map uξ.op).hom x) := by
      rw [op_comp, CategoryTheory.Functor.map_comp]
      rfl
    rw [hτ] at hx
    exact hx.symm
  have hI1 : ∀ (E : (wcProjK F'' M').ProEt) (eE : Ty ⟶ E) (k : ℕ),
      (fun f : Ty ⟶ Ty => τ ≫ f)^[k] (𝟙 Ty) ≫ eE = (fun g : Ty ⟶ E => τ ≫ g)^[k] eE := by
    intro E eE k
    induction k with
    | zero => simp
    | succ k ih =>
      simp only [Function.iterate_succ_apply']
      rw [Category.assoc, ih]
  have hI2 : ∀ (k : ℕ) (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
      ((wcRq h ℓ (n - 1)).obj.map ((fun f : Ty ⟶ Ty => τ ≫ f)^[k] (𝟙 Ty)).op).hom x =
        (⇑((wcRq h ℓ (n - 1)).obj.map τ.op).hom)^[k] x := by
    intro k
    induction k with
    | zero =>
      intro x
      simp only [Function.iterate_zero, id_eq]
      exact hidR x
    | succ k ih =>
      intro x
      simp only [Function.iterate_succ_apply']
      rw [hcompR, ih]
  intro x
  refine wc_pfam_xwt_unipotent_algebra ℓ (Nat.card F'') hℓ
    (fun c => ((wcRqScalar h ℓ (n - 1) c).hom.app (Opposite.op Ty)).hom)
    (L1 Ty) (L2 Ty) (L3 Ty) ((wcRq h ℓ (n - 1)).obj.map τ.op).hom
    (fun a y => L4 Ty Ty τ a y)
    ((wcRq h ℓ (n - 1)).obj.map uξ.op).hom.range ?_ ?_ ?_ B hBs hBalt hBnd (hBinv τ hτ)
    Λ hΛs hΛspan hΛsep ?_ x
  · rintro a _ ⟨v, rfl⟩
    exact ⟨((wcRqScalar h ℓ (n - 1) a).hom.app (Opposite.op Vξ)).hom v, L4 Vξ Ty uξ a v⟩
  · rintro _ ⟨v, rfl⟩
    exact hcompξ v
  · intro t₁ t₂
    obtain ⟨c₁, c₂, hc, hmem⟩ := wc_pfam_xwt_specialization F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ
      lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ t₁ t₂
    obtain ⟨v, hv⟩ := hmem
    exact ⟨c₁, c₂, hc, v, hv⟩
  · intro N
    obtain ⟨E, πE, eE, hEt, hEu, htriv⟩ := hcontN N
    obtain ⟨k, hk⟩ := hwild E πE eE hEt hEu
    refine ⟨k, fun y hy => ?_⟩
    obtain ⟨z, hz, hzeq⟩ := htriv ((fun f : Ty ⟶ Ty => τ ≫ f)^[Nat.card F'' ^ k] (𝟙 Ty))
      (by rw [hI1, hk]) y hy
    refine ⟨z, hz, ?_⟩
    rw [← hI2]
    exact hzeq

theorem wc_pfam_ltd_wild_trivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (j : Fin D.m)
    (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    [IsSepClosed (IsLocalRing.ResidueField Ay)] (ey : Vy.left ≅ Spec (.of Ay))
    (Ly : Type u) [Field Ly] [IsSepClosed Ly] (eLy : Ty.left ≅ Spec (.of Ly))
    (hy : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (f : Ay) (hf : ∀ z : Vy.left, Vy.hom z ∈ Δ ↔ f ∈ (ey.hom z).asIdeal)
    (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eZ : Z.left ≅ Spec (.of B))
    (ιZ : Z ⟶ Vy) (uZ : Ty ⟶ Z) (huZ : uZ ≫ ιZ = uy)
    (hξ : f ∈ (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal)
    (hξgen : ∀ q : PrimeSpectrum Ay, f ∈ q.asIdeal →
      (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal ≤ q.asIdeal)
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uZ = uZ)
    (hτw : wcLtdTameAgree (ringChar F'') (wcLtdRing ey eLy uy.left) f
      (wcLtdRing eLy eLy τ.left) (RingHom.id Ly)) :
    ∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
      ((wcRq h ℓ (n - 1)).obj.map τ.op).hom s = s :=
by
  classical
  intro s

  have hpprime : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
  have hpQ : ringChar F'' ∣ Nat.card F'' := by
    haveI := Fintype.ofFinite F''
    rw [Nat.card_eq_fintype_card]
    exact ringChar.dvd (FiniteField.cast_card_eq_zero F'')

  have hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨vy⟩ := wc_pfam_ltd_wt_geom_lift F'' M' hPP Vy Ay ey

  have hH' := hH
  obtain ⟨_, _, _, _, hΔc, hirr, _, _, _, _, _, hlamΔ, _⟩ := hH'
  have hyΔ : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) ∈ Δ := by
    rw [hy]; exact (hlamΔ _).2 ⟨j, rfl⟩

  obtain ⟨f₀, hNoeth, _, hdom, _, hf₀m2, hdomq, _, hf₀Δ, hcharA⟩ :=
    wc_tps_local_algebra F' F'' Y n D M' Xu h Δ lam p hH hPP j Vy vy Ay ey hy
  haveI := hNoeth
  haveI := hdom
  have hf₀ne : f₀ ≠ 0 := by
    rintro rfl
    exact hf₀m2 (Ideal.zero_mem _)
  have hpr : (Ideal.span {f₀}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).1 hdomq
  have hey : ∀ q : PrimeSpectrum Ay, ey.hom (ey.inv q) = q := fun q => by
    have e := Scheme.Hom.comp_apply ey.inv ey.hom q
    rw [Iso.inv_hom_id] at e
    first
      | exact e.symm
      | simpa using e.symm
      | exact e.symm.trans rfl
  have hfne : f ≠ 0 := by
    intro hf0
    obtain ⟨qb, hqb⟩ : ∃ q : PrimeSpectrum Ay, q.asIdeal = ⊥ := ⟨⟨⊥, Ideal.isPrime_bot⟩, rfl⟩
    have h1 : Vy.hom (ey.inv qb) ∈ Δ := by
      rw [hf, hey, hf0]; exact Ideal.zero_mem _
    have h2 := (hf₀Δ qb).1 h1
    rw [hqb] at h2
    exact hf₀ne (Ideal.mem_bot.1 h2)
  have hξΔ : Vy.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B))) ∈ Δ := (hf _).2 hξ
  have hq_eq : (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal =
      Ideal.span {f₀} := by
    apply le_antisymm
    · obtain ⟨q₀, hq₀⟩ : ∃ q : PrimeSpectrum Ay, q.asIdeal = Ideal.span {f₀} := ⟨⟨_, hpr⟩, rfl⟩
      have h1 : Vy.hom (ey.inv q₀) ∈ Δ :=
        (hf₀Δ q₀).2 (by rw [hq₀]; exact Ideal.mem_span_singleton_self f₀)
      have h2 : f ∈ q₀.asIdeal := by
        have := (hf _).1 h1
        rwa [hey] at this
      rw [← hq₀]
      exact hξgen q₀ h2
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact (hf₀Δ (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B))))).1 (by simpa using hξΔ)

  have hαwe := wc_mnt_point_map_weaklyEtale (wcProjK F'' M') Vy Z ιZ Ay B ey eZ
  have hcomapq : (IsLocalRing.maximalIdeal B).comap (wcLtdRing ey eZ ιZ.left) =
      (ey.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B)))).asIdeal := by
    have e1 : (Spec.map (Spec.preimage (eZ.inv ≫ ιZ.left ≫ ey.hom))
        (IsLocalRing.closedPoint B)).asIdeal =
        (IsLocalRing.maximalIdeal B).comap (wcLtdRing ey eZ ιZ.left) :=
      Submodule.toSubMulAction_inj.mp rfl
    rw [← e1, Spec.map_preimage]
    first
      | rfl
      | simp only [Scheme.Hom.comp_apply]
  obtain ⟨hBdom, hBdvr, hαinj⟩ := wc_pfam_ltd_wt_xi_dvr Ay B (wcLtdRing ey eZ ιZ.left) hαwe
    f₀ hf₀ne hpr (hcomapq.trans hq_eq)
  haveI := hBdom
  haveI := hBdvr

  have hβwe := wc_mnt_point_map_weaklyEtale (wcProjK F'' M') Z Ty uZ B Ly eZ eLy
  obtain ⟨hβinj, hsep⟩ := wc_pfam_ltd_wt_point_alg B Ly (wcLtdRing eZ eLy uZ.left) hβwe

  have hl : uy.left = uZ.left ≫ ιZ.left := (congrArg (fun g => g.left) huZ).symm
  have hτl : τ.left ≫ uZ.left = uZ.left := congrArg (fun g => g.left) hτ
  have hR1 : wcLtdRing ey eLy uy.left =
      (wcLtdRing eZ eLy uZ.left).comp (wcLtdRing ey eZ ιZ.left) := by
    unfold wcLtdRing
    rw [← CommRingCat.hom_comp]
    congr 1
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage, hl]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  have hR2 : (wcLtdRing eLy eLy τ.left).comp (wcLtdRing eZ eLy uZ.left) =
      wcLtdRing eZ eLy uZ.left := by
    unfold wcLtdRing
    rw [← CommRingCat.hom_comp]
    congr 1
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, reassoc_of% hτl]
  have hσB : ∀ b, wcLtdRing eLy eLy τ.left (wcLtdRing eZ eLy uZ.left b) =
      wcLtdRing eZ eLy uZ.left b :=
    fun b => congrArg (fun φ : B →+* Ly => φ b) hR2
  have hpL : ((ringChar F'' : ℕ) : Ly) = 0 := by
    rw [← map_natCast (wcLtdRing ey eLy uy.left) (ringChar F''), hcharA, map_zero]
  have hfB0 : wcLtdRing ey eZ ιZ.left f ≠ 0 :=
    fun h0 => hfne (hαinj (h0.trans (map_zero _).symm))
  have hfBm : wcLtdRing ey eZ ιZ.left f ∈ IsLocalRing.maximalIdeal B := by
    have : f ∈ (IsLocalRing.maximalIdeal B).comap (wcLtdRing ey eZ ιZ.left) := by
      rw [hcomapq]; exact hξ
    exact this
  have htameF : ∀ (w : Ly) (m : ℕ), 0 < m → ¬ ringChar F'' ∣ m →
      w ^ m = wcLtdRing eZ eLy uZ.left (wcLtdRing ey eZ ιZ.left f) →
      wcLtdRing eLy eLy τ.left w = w := by
    intro w m hm hpm hw
    have := hτw w m hm hpm (by rw [hR1]; exact hw)
    simpa using this

  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible B
  have htameπ := wc_pfam_ltd_wt_unif_roots B Ly (ringChar F'') hpprime hpL _ hβinj _ hσB _
    hfB0 hfBm htameF π hπ
  have hord := wc_pfam_ltd_wt_tame_order B Ly (ringChar F'') hpprime hpL _ hβinj hsep π hπ _
    hσB htameπ
  have H : ∀ S : Finset Ly, ∃ k : ℕ, ∀ x ∈ S,
      (⇑(wcLtdRing eLy eLy τ.left))^[Nat.card F'' ^ k] x = x := by
    intro S
    obtain ⟨b, hb⟩ := hord S
    obtain ⟨c, hc⟩ := pow_dvd_pow_of_dvd hpQ b
    refine ⟨b, fun x hx => ?_⟩
    rw [hc]
    have hper : Function.IsPeriodicPt (⇑(wcLtdRing eLy eLy τ.left)) (ringChar F'' ^ b) x :=
      hb x hx
    exact hper.mul_const c

  have hwild : ∀ (E : (wcProjK F'' M').ProEt) (πE : E ⟶ Z) (eE : Ty ⟶ E),
      Etale πE.left → eE ≫ πE = uZ →
      ∃ k : ℕ, (fun g : Ty ⟶ E => τ ≫ g)^[Nat.card F'' ^ k] eE = eE :=
    fun E πE eE hEt heE => wc_pfam_ltd_wt_point_transfer (wcProjK F'' M') Z Ty E B eZ Ly eLy
      uZ τ hτ πE eE hEt heE (Nat.card F'') H

  have hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ιZ ≫ vy).left (eZ.inv (IsLocalRing.closedPoint B))) ∈ Δ := by
    have hw : vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Vy.hom :=
      MorphismProperty.Over.w vy
    have e1 : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ιZ ≫ vy).left (eZ.inv (IsLocalRing.closedPoint B))) =
        Vy.hom (ιZ.left (eZ.inv (IsLocalRing.closedPoint B))) := by
      rw [← hw, Scheme.Hom.comp_apply]
      first
        | rfl
        | simp only [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply]
    rw [e1]
    exact hξΔ

  have hclξ := wc_pfam_ltd_wt_xi_generic F'' M' Δ hΔc (hirr (AlgebraicClosure F'')) hPP Vy vy
    Ay ey hyΔ f hf Z B eZ ιZ hξgen

  exact wc_pfam_xi_wild_trivial F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP j Vy Ty uy vy
    Ay ey hy Ly eLy Z ιZ uZ B eZ huZ hΔξ hclξ τ hτ hwild s

theorem wc_pfam_ltd_kernel_closed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (Ly : Type u) [Field Ly] [IsSepClosed Ly] (eLy : Ty.left ≅ Spec (.of Ly))
    (τ : Ty ⟶ Ty) (hτ : τ ≫ uy = uy)
    (hcl : ∀ S : Finset Ly, ∃ m : Ty ⟶ Ty, m ≫ uy = uy ∧
      (∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
        ((wcRq h ℓ (n - 1)).obj.map m.op).hom s = s) ∧
      ∀ w ∈ S, wcLtdRing eLy eLy m.left w = wcLtdRing eLy eLy τ.left w) :
    ∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
      ((wcRq h ℓ (n - 1)).obj.map τ.op).hom s = s :=
by
  classical

  obtain ⟨hPP, ⟨Ω⟩⟩ := wc_pfam_cover_exists F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH (n - 1)
  haveI := wc_proj_space_irreducible F'' M'
  obtain ⟨-, -, -, -, hΔc, -, -, -, -, -, -, hlamΔ, -⟩ := hH

  have core : ∀ (R : CommRingCat.{u}) (φ : R ⟶ CommRingCat.of Ly)
      (O : Set ↥(Limits.pullback (Spec.map φ) (Spec.map φ))) (_ : IsOpen O)
      (σ : Spec (.of Ly) ⟶ Spec (.of Ly)) (hσ : 𝟙 _ ≫ Spec.map φ = σ ≫ Spec.map φ)
      (_ : (Limits.pullback.lift (𝟙 _) σ hσ) (IsLocalRing.closedPoint Ly) ∈ O),
      ∃ S : Finset Ly, ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly))
        (hσ' : 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ),
        (∀ w ∈ S, (Spec.preimage σ').hom w = (Spec.preimage σ).hom w) →
        (Limits.pullback.lift (𝟙 _) σ' hσ') (IsLocalRing.closedPoint Ly) ∈ O := by
    intro R φ O hO σ hσ hz
    letI : Algebra R Ly := φ.hom.toAlgebra
    let ι : Limits.pullback (Spec.map φ) (Spec.map φ) ≅ Spec (.of (TensorProduct R Ly Ly)) :=
      pullbackSpecIso R Ly Ly
    have hlin : ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)), 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ →
        ∀ r : R, (Spec.preimage σ').hom (φ.hom r) = φ.hom r := by
      intro σ' h r
      have h1 : Spec.map φ = Spec.map (φ ≫ Spec.preimage σ') := by
        rw [Spec.map_comp, Spec.map_preimage, ← h, Category.id_comp]
      have h2 := Spec.map_injective h1
      exact (congrArg (fun f : R ⟶ CommRingCat.of Ly => f.hom r) h2).symm
    let sA : ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)), 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ →
        Ly →ₐ[R] Ly := fun σ' h =>
      { (Spec.preimage σ').hom with commutes' := fun r => hlin σ' h r }
    let χ : ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)), 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ →
        TensorProduct R Ly Ly →ₐ[R] Ly := fun σ' h =>
      Algebra.TensorProduct.productMap (AlgHom.id R Ly) (sA σ' h)
    have hpt : ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)) (h : 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ),
        Limits.pullback.lift (𝟙 _) σ' h ≫ ι.hom =
          Spec.map (CommRingCat.ofHom (χ σ' h).toRingHom) := by
      intro σ' h
      rw [← Iso.eq_comp_inv]
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc]
        erw [pullbackSpecIso_inv_fst]
        rw [← Spec.map_comp]
        rw [← Spec.map_id]
        congr 1
        ext x
        simp [χ]
      · rw [Limits.pullback.lift_snd, Category.assoc]
        erw [pullbackSpecIso_inv_snd]
        rw [← Spec.map_comp]
        conv_lhs => rw [← Spec.map_preimage σ']
        congr 1
        ext x
        simp [χ, sA]
    have hmemD : ∀ (t : TensorProduct R Ly Ly) (σ' : Spec (.of Ly) ⟶ Spec (.of Ly))
        (h : 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ),
        (show PrimeSpectrum (TensorProduct R Ly Ly) from
          ι.hom (Limits.pullback.lift (𝟙 _) σ' h (IsLocalRing.closedPoint Ly))) ∈
          PrimeSpectrum.basicOpen t ↔ χ σ' h t ≠ 0 := by
      intro t σ' h
      have e : ∀ x : ↥(Spec (.of Ly)), ι.hom (Limits.pullback.lift (𝟙 _) σ' h x) =
          Spec.map (CommRingCat.ofHom (χ σ' h).toRingHom) x := fun x => by
        rw [← Scheme.Hom.comp_apply, hpt]
      have e2 : ∀ x : ↥(Spec (.of Ly)),
          (show PrimeSpectrum (TensorProduct R Ly Ly) from
            Spec.map (CommRingCat.ofHom (χ σ' h).toRingHom) x).asIdeal =
          Ideal.comap (χ σ' h).toRingHom (show PrimeSpectrum Ly from x).asIdeal := fun x => rfl
      have key : ∀ y : PrimeSpectrum (TensorProduct R Ly Ly),
          y.asIdeal = Ideal.comap (χ σ' h).toRingHom (IsLocalRing.maximalIdeal Ly) →
          (y ∈ PrimeSpectrum.basicOpen t ↔ χ σ' h t ≠ 0) := by
        intro y hy
        rw [PrimeSpectrum.mem_basicOpen, hy, Ideal.mem_comap]
        change ¬ ((χ σ' h) t ∈ IsLocalRing.maximalIdeal Ly) ↔ _
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_ne_zero, not_not]
      apply key
      have e3 := congrArg (fun y : PrimeSpectrum (TensorProduct R Ly Ly) => y.asIdeal)
        (e (IsLocalRing.closedPoint Ly))
      exact e3.trans (e2 _)
    have hagree : ∀ t : TensorProduct R Ly Ly, ∃ S : Finset Ly,
        ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)) (h : 𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ),
        (∀ w ∈ S, (Spec.preimage σ').hom w = (Spec.preimage σ).hom w) →
        χ σ' h t = χ σ hσ t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => exact ⟨∅, fun σ' h _ => by rw [map_zero, map_zero]⟩
      | tmul x y =>
        refine ⟨{y}, fun σ' h hS => ?_⟩
        rw [Algebra.TensorProduct.productMap_apply_tmul,
          Algebra.TensorProduct.productMap_apply_tmul]
        show (AlgHom.id R Ly) x * (Spec.preimage σ').hom y =
          (AlgHom.id R Ly) x * (Spec.preimage σ).hom y
        rw [hS y (Finset.mem_singleton_self y)]
      | add x y hx hy =>
        obtain ⟨Sx, hSx⟩ := hx
        obtain ⟨Sy, hSy⟩ := hy
        refine ⟨Sx ∪ Sy, fun σ' h hS => ?_⟩
        rw [map_add, map_add,
          hSx σ' h (fun w hw => hS w (Finset.mem_union_left _ hw)),
          hSy σ' h (fun w hw => hS w (Finset.mem_union_right _ hw))]
    have hO'' : IsOpen (ι.inv ⁻¹' O) := ι.inv.continuous.isOpen_preimage O hO
    have hinv : ∀ x, ι.inv (ι.hom x) = x := fun x => by simp
    have hxO : ι.hom (Limits.pullback.lift (𝟙 _) σ hσ (IsLocalRing.closedPoint Ly)) ∈
        ι.inv ⁻¹' O := by
      show ι.inv (ι.hom _) ∈ O
      rw [hinv]; exact hz
    obtain ⟨_, ⟨t, rfl⟩, hxt, htO⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hxO hO''
    have ht0 : χ σ hσ t ≠ 0 := (hmemD t σ hσ).mp hxt
    obtain ⟨S, hS⟩ := hagree t
    refine ⟨S, fun σ' h hS' => ?_⟩
    have h1 := (hmemD t σ' h).mpr (by rw [hS σ' h hS']; exact ht0)
    have h2 : ι.inv (ι.hom _) ∈ O := htO h1
    rw [hinv] at h2
    exact h2

  have nbhd : ∀ (a : Spec (.of Ly) ⟶ wcProjK F'' M')
      (σ : Spec (.of Ly) ⟶ Spec (.of Ly)) (hσ : 𝟙 _ ≫ a = σ ≫ a)
      (O : Set ↥(Limits.pullback a a)) (_ : IsOpen O)
      (_ : (Limits.pullback.lift (𝟙 _) σ hσ) (IsLocalRing.closedPoint Ly) ∈ O),
      ∃ S : Finset Ly, ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)) (hσ' : 𝟙 _ ≫ a = σ' ≫ a),
        (∀ w ∈ S, (Spec.preimage σ').hom w = (Spec.preimage σ).hom w) →
        (Limits.pullback.lift (𝟙 _) σ' hσ') (IsLocalRing.closedPoint Ly) ∈ O := by
    intro a σ hσ O hO hz
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := a (IsLocalRing.closedPoint Ly)) (U := ⊤) trivial
    haveI := hU.isOpenImmersion_fromSpec
    have hrange : Set.range a ⊆ Set.range hU.fromSpec := by
      rw [hU.range_fromSpec]
      rintro _ ⟨y, rfl⟩
      have hy : y = IsLocalRing.closedPoint Ly :=
        @Subsingleton.elim (PrimeSpectrum Ly) inferInstance _ _
      rw [hy]
      exact hxU
    let a₀ := IsOpenImmersion.lift hU.fromSpec a hrange
    have ha₀ : a₀ ≫ hU.fromSpec = a := IsOpenImmersion.lift_fac _ _ _
    let φ := Spec.preimage a₀
    have hφ : Spec.map φ = a₀ := Spec.map_preimage a₀
    have hcancel : ∀ σ' : Spec (.of Ly) ⟶ Spec (.of Ly), 𝟙 _ ≫ a = σ' ≫ a →
        𝟙 _ ≫ Spec.map φ = σ' ≫ Spec.map φ := by
      intro σ' h
      rw [hφ]
      apply (cancel_mono hU.fromSpec).mp
      rw [Category.assoc, Category.assoc, ha₀]
      exact h
    have heq : Spec.map φ ≫ hU.fromSpec = 𝟙 _ ≫ a := by rw [hφ, ha₀, Category.id_comp]
    let μ : Limits.pullback (Spec.map φ) (Spec.map φ) ⟶ Limits.pullback a a :=
      Limits.pullback.map _ _ _ _ (𝟙 _) (𝟙 _) hU.fromSpec heq heq
    have hlift : ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)) (h : 𝟙 _ ≫ a = σ' ≫ a),
        Limits.pullback.lift (𝟙 _) σ' (hcancel σ' h) ≫ μ =
          Limits.pullback.lift (𝟙 _) σ' h := by
      intro σ' h
      apply Limits.pullback.hom_ext <;>
        simp only [μ, Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
          Limits.pullback.lift_snd_assoc, Category.comp_id, Category.id_comp]
    have hpt : ∀ (σ' : Spec (.of Ly) ⟶ Spec (.of Ly)) (h : 𝟙 _ ≫ a = σ' ≫ a)
        (x : ↥(Spec (.of Ly))),
        μ (Limits.pullback.lift (𝟙 _) σ' (hcancel σ' h) x) =
          Limits.pullback.lift (𝟙 _) σ' h x := by
      intro σ' h x
      rw [← Scheme.Hom.comp_apply, hlift]
    obtain ⟨S, hS⟩ := core _ φ (μ ⁻¹' O) (hO.preimage μ.continuous) σ (hcancel σ hσ)
      (by
        show μ _ ∈ O
        have := hpt σ hσ (IsLocalRing.closedPoint Ly)
        rw [this]; exact hz)
    refine ⟨S, fun σ' h hag => ?_⟩
    have h1 : μ _ ∈ O := hS σ' (hcancel σ' h) hag
    have := hpt σ' h (IsLocalRing.closedPoint Ly)
    rw [this] at h1
    exact h1

  have gen : ∀ (c : Spec (.of Ly) ⟶ wcProjK F'' M'), WeaklyEtale c →
      ∀ y : wcProjK F'' M', c (IsLocalRing.closedPoint Ly) ⤳ y := by
    intro c hc y
    haveI : Flat c := hc.flat
    have hgen : GeneralizingMap c := Flat.generalizingMap c
    have h1 : genericPoint (wcProjK F'' M') ⤳ c (IsLocalRing.closedPoint Ly) :=
      (genericPoint_spec (wcProjK F'' M')).specializes (Set.mem_univ _)
    obtain ⟨a', -, ha'⟩ := hgen h1
    have ha : a' = IsLocalRing.closedPoint Ly :=
      @Subsingleton.elim (PrimeSpectrum Ly) inferInstance _ _
    rw [ha] at ha'
    rw [ha']
    exact (genericPoint_spec (wcProjK F'' M')).specializes (Set.mem_univ _)

  haveI hres : IsSepClosed (IsLocalRing.ResidueField Ly) := by
    let e : Ly ≃+* IsLocalRing.ResidueField Ly :=
      RingEquiv.ofBijective (IsLocalRing.residue Ly)
        ⟨(IsLocalRing.residue Ly).injective, IsLocalRing.residue_surjective⟩
    apply IsSepClosed.of_exists_root
    intro q _ hirr hsep
    have hq : (q.map (e.symm : IsLocalRing.ResidueField Ly →+* Ly)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hq (hsep.map)
    refine ⟨e x, ?_⟩
    have h2 : Polynomial.eval (e x) ((q.map (e.symm : IsLocalRing.ResidueField Ly →+* Ly)).map
        (e : Ly →+* IsLocalRing.ResidueField Ly)) = 0 := by
      rw [Polynomial.eval_map]
      have := Polynomial.hom_eval₂ (q.map (e.symm : IsLocalRing.ResidueField Ly →+* Ly))
        (RingHom.id Ly) (e : Ly →+* IsLocalRing.ResidueField Ly) x
      rw [RingHom.comp_id] at this
      have hx0 : Polynomial.eval₂ (RingHom.id Ly) x
          (q.map (e.symm : IsLocalRing.ResidueField Ly →+* Ly)) = 0 := hx
      rw [hx0, map_zero] at this
      exact this.symm
    simpa [Polynomial.map_map] using h2

  have hsub : ∀ x y : Ty.left, x = y := by
    intro x y
    have h1 : eLy.hom x = eLy.hom y :=
      @Subsingleton.elim (PrimeSpectrum Ly) inferInstance (eLy.hom x) (eLy.hom y)
    have hx' : eLy.inv (eLy.hom x) = x := by simp
    have hy' : eLy.inv (eLy.hom y) = y := by simp
    rw [← hx', ← hy', h1]
  have hspt : ∀ x y : ↥(Spec (.of Ly)), x = y := fun x y =>
    @Subsingleton.elim (PrimeSpectrum Ly) inferInstance x y
  haveI hTyp : WeaklyEtale Ty.hom := Ty.prop
  obtain ⟨a, ha⟩ : ∃ a : Spec (.of Ly) ⟶ wcProjK F'' M', a = eLy.inv ≫ Ty.hom := ⟨_, rfl⟩
  haveI hae : WeaklyEtale a := by rw [ha]; infer_instance

  have hoff : ∀ z : Ty.left, Ty.hom z ∉ Δ := by
    intro z hz
    have hy₀ : lam (D.u0 (IsLocalRing.closedPoint F'')) ∉ Δ := by
      intro hy
      obtain ⟨i, hi⟩ := (hlamΔ _).mp hy
      exact D.hu0S i hi
    have e1 : z = eLy.inv (IsLocalRing.closedPoint Ly) := hsub _ _
    have e2 : a (IsLocalRing.closedPoint Ly) = Ty.hom (eLy.inv (IsLocalRing.closedPoint Ly)) := by
      rw [ha]; exact Scheme.Hom.comp_apply _ _ _
    have hmem : a (IsLocalRing.closedPoint Ly) ∈ Δ := by rw [e2, ← e1]; exact hz
    exact hy₀ ((gen a hae _).mem_closed hΔc hmem)

  obtain ⟨κ, hκ⟩ : ∃ κ : Spec (.of Ly) ⟶ Spec (.of F''),
      κ = eLy.inv ≫ Ty.hom ≫ wcProjKStr F'' M' := ⟨_, rfl⟩
  letI : Algebra F'' Ly := (Spec.preimage κ).hom.toAlgebra
  let ιs : AlgebraicClosure F'' →ₐ[F''] Ly := IsSepClosed.lift
  have hβ : Spec.map (CommRingCat.ofHom (ιs : AlgebraicClosure F'' →+* Ly)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) = κ := by
    have e1 : CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')) ≫
        CommRingCat.ofHom (ιs : AlgebraicClosure F'' →+* Ly) = Spec.preimage κ := by
      ext r
      exact ιs.commutes r
    rw [← Spec.map_comp, e1, Spec.map_preimage]
  have hcond : Ty.hom ≫ (Over.mk (wcProjKStr F'' M')).hom =
      (eLy.hom ≫ Spec.map (CommRingCat.ofHom (ιs : AlgebraicClosure F'' →+* Ly))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [Category.assoc, hβ, hκ, Iso.hom_inv_id_assoc]
    rfl
  let xg : Ty ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP :=
    MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hcond)
      (Limits.pullback.lift_fst _ _ hcond) trivial

  obtain ⟨ψ, -⟩ := wc_pfam_strict_local_lift M' h Δ ℓ (n - 1) hPP Ω Ty Ly eLy xg hoff

  haveI : WeaklyEtale (Limits.pullback.fst a a) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst a a ≫ a) := inferInstance
  let Z : (wcProjK F'' M').ProEt := Scheme.ProEt.mk (Limits.pullback.fst a a ≫ a)
  have hp₁ : (Limits.pullback.fst a a ≫ eLy.inv) ≫ Ty.hom = Limits.pullback.fst a a ≫ a := by
    rw [Category.assoc, ha]
  have hp₂ : (Limits.pullback.snd a a ≫ eLy.inv) ≫ Ty.hom = Limits.pullback.fst a a ≫ a := by
    rw [Category.assoc, ← ha]
    exact Limits.pullback.condition.symm
  let p₁ : Z ⟶ Ty := MorphismProperty.Over.homMk (Limits.pullback.fst a a ≫ eLy.inv) hp₁ trivial
  let p₂ : Z ⟶ Ty := MorphismProperty.Over.homMk (Limits.pullback.snd a a ≫ eLy.inv) hp₂ trivial
  have hnat : ∀ {X₁ X₂ : (wcProjK F'' M').ProEt} (g : X₁ ⟶ X₂) (b : X₂ ⟶ Ω.W')
      (b' : X₁ ⟶ Ω.W'), g ≫ b = b' →
      ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op X₂)) (z : X₁.left),
      (show C(↥X₁.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b'))).hom
          (((wcRq h ℓ (n - 1)).obj.map g.op).hom s)).down) z =
      (show C(↥X₂.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom s).down) (g.left z) := by
    intro X₁ X₂ g b b' hgb s z
    subst hgb
    have e := congrArg (fun m => m.hom s)
      (Ω.θ'.hom.hom.naturality (Over.homMk g : Over.mk (g ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun y : ULift.{u+1} C(↥X₁.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) e
  have hcancel : ∀ (T' : Over Ω.W')
      (s : ((wcRq h ℓ (n - 1)).over Ω.W').obj.obj (Opposite.op T')),
      (Ω.θ'.inv.hom.app (Opposite.op T')).hom ((Ω.θ'.hom.hom.app (Opposite.op T')).hom s) = s :=
    fun T' s => congrArg (fun m => (m.hom.app (Opposite.op T')).hom s) Ω.θ'.hom_inv_id
  have hcomp : ∀ {X₁ X₂ X₃ : (wcProjK F'' M').ProEt} (g : X₁ ⟶ X₂) (g' : X₂ ⟶ X₃)
      (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op X₃)),
      ((wcRq h ℓ (n - 1)).obj.map (g ≫ g').op).hom s =
        ((wcRq h ℓ (n - 1)).obj.map g.op).hom (((wcRq h ℓ (n - 1)).obj.map g'.op).hom s) := by
    intro X₁ X₂ X₃ g g' s
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have hid : ∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
      ((wcRq h ℓ (n - 1)).obj.map (𝟙 Ty).op).hom s = s := by
    intro s
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  obtain ⟨f₁, hf₁⟩ : ∃ f : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →
      C(↥(Limits.pullback a a), Fin Ω.r' → ℚ_[ℓ]),
      ∀ s, f s = (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (p₁ ≫ ψ)))).hom
          (((wcRq h ℓ (n - 1)).obj.map p₁.op).hom s)).down) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨f₂, hf₂⟩ : ∃ f : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →
      C(↥(Limits.pullback a a), Fin Ω.r' → ℚ_[ℓ]),
      ∀ s, f s = (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (p₁ ≫ ψ)))).hom
          (((wcRq h ℓ (n - 1)).obj.map p₂.op).hom s)).down) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) → (Fin Ω.r' → ℚ_[ℓ]),
      ∀ t, Φ t = (show C(↥Ty.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk ψ))).hom t).down)
          (eLy.inv (IsLocalRing.closedPoint Ly)) :=
    ⟨_, fun _ => rfl⟩
  have hΦinj : ∀ t t', Φ t = Φ t' → t = t' := by
    intro t t' htt
    rw [hΦ, hΦ] at htt
    have e1 : (Ω.θ'.hom.hom.app (Opposite.op (Over.mk ψ))).hom t =
        (Ω.θ'.hom.hom.app (Opposite.op (Over.mk ψ))).hom t' := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hsub z (eLy.inv (IsLocalRing.closedPoint Ly))]
      exact htt
    have e2 := congrArg (Ω.θ'.inv.hom.app (Opposite.op (Over.mk ψ))).hom e1
    exact (hcancel (Over.mk ψ) t).symm.trans (e2.trans (hcancel (Over.mk ψ) t'))
  obtain ⟨C, hCdef⟩ : ∃ C : Set ↥(Limits.pullback a a),
      C = ⋂ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty), {z | f₁ s z = f₂ s z} :=
    ⟨_, rfl⟩
  have hCc : IsClosed C := by
    rw [hCdef]
    exact isClosed_iInter (fun s => isClosed_eq (f₁ s).continuous (f₂ s).continuous)
  have hC : ∀ (m : Ty ⟶ Ty) (hm : 𝟙 _ ≫ a = (eLy.inv ≫ m.left ≫ eLy.hom) ≫ a),
      ((∀ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
          ((wcRq h ℓ (n - 1)).obj.map m.op).hom s = s) ↔
        (Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm)
          (IsLocalRing.closedPoint Ly) ∈ C) := by
    intro m hm
    have hkw : (eLy.hom ≫ Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm) ≫
        (Limits.pullback.fst a a ≫ a) = Ty.hom := by
      rw [Category.assoc, Limits.pullback.lift_fst_assoc, Category.id_comp, ha,
        Iso.hom_inv_id_assoc]
    let k : Ty ⟶ Z := MorphismProperty.Over.homMk
      (eLy.hom ≫ Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm) hkw trivial
    have hk₁ : k ≫ p₁ = 𝟙 Ty := by
      apply MorphismProperty.Over.Hom.ext
      show (eLy.hom ≫ Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm) ≫
        (Limits.pullback.fst a a ≫ eLy.inv) = 𝟙 _
      rw [Category.assoc, Limits.pullback.lift_fst_assoc, Category.id_comp, Iso.hom_inv_id]
    have hk₂ : k ≫ p₂ = m := by
      apply MorphismProperty.Over.Hom.ext
      show (eLy.hom ≫ Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm) ≫
        (Limits.pullback.snd a a ≫ eLy.inv) = m.left
      rw [Category.assoc, Limits.pullback.lift_snd_assoc]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id, Iso.hom_inv_id_assoc]
    have hkc : k ≫ (p₁ ≫ ψ) = ψ := by rw [← Category.assoc, hk₁, Category.id_comp]
    have hzm : (Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm)
        (IsLocalRing.closedPoint Ly) = k.left (eLy.inv (IsLocalRing.closedPoint Ly)) := by
      have e1 := Scheme.Hom.comp_apply eLy.hom
        (Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm)
        (eLy.inv (IsLocalRing.closedPoint Ly))
      have e2 := congrArg (Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm)
        (hspt (eLy.hom (eLy.inv (IsLocalRing.closedPoint Ly))) (IsLocalRing.closedPoint Ly))
      exact (e1.trans e2).symm
    have r1 : ∀ s₀ : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
        ((wcRq h ℓ (n - 1)).obj.map k.op).hom (((wcRq h ℓ (n - 1)).obj.map p₁.op).hom s₀) =
          s₀ := fun s₀ => (hcomp k p₁ s₀).symm.trans (by rw [hk₁, hid])
    have r2 : ∀ s₀ : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty),
        ((wcRq h ℓ (n - 1)).obj.map k.op).hom (((wcRq h ℓ (n - 1)).obj.map p₂.op).hom s₀) =
          ((wcRq h ℓ (n - 1)).obj.map m.op).hom s₀ :=
      fun s₀ => (hcomp k p₂ s₀).symm.trans (by rw [hk₂])
    have key1 : ∀ s₀, f₁ s₀ ((Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm)
        (IsLocalRing.closedPoint Ly)) = Φ s₀ := by
      intro s₀
      have e := hnat k (p₁ ≫ ψ) ψ hkc (((wcRq h ℓ (n - 1)).obj.map p₁.op).hom s₀)
        (eLy.inv (IsLocalRing.closedPoint Ly))
      rw [r1] at e
      rw [hzm, hf₁, hΦ]
      exact e.symm
    have key2 : ∀ s₀, f₂ s₀ ((Limits.pullback.lift (𝟙 _) (eLy.inv ≫ m.left ≫ eLy.hom) hm)
        (IsLocalRing.closedPoint Ly)) = Φ (((wcRq h ℓ (n - 1)).obj.map m.op).hom s₀) := by
      intro s₀
      have e := hnat k (p₁ ≫ ψ) ψ hkc (((wcRq h ℓ (n - 1)).obj.map p₂.op).hom s₀)
        (eLy.inv (IsLocalRing.closedPoint Ly))
      rw [r2] at e
      rw [hzm, hf₂, hΦ]
      exact e.symm
    rw [hCdef]
    constructor
    · intro hm'
      refine Set.mem_iInter.mpr (fun s => ?_)
      show f₁ s _ = f₂ s _
      rw [key1, key2, hm' s]
    · intro hz s
      have hzs : f₁ s _ = f₂ s _ := Set.mem_iInter.mp hz s
      rw [key1, key2] at hzs
      exact (hΦinj _ _ hzs).symm

  have hσ : ∀ m : Ty ⟶ Ty, 𝟙 _ ≫ a = (eLy.inv ≫ m.left ≫ eLy.hom) ≫ a := by
    intro m
    rw [ha, Category.id_comp]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [MorphismProperty.Over.w m]

  have hzτ : (Limits.pullback.lift (𝟙 _) (eLy.inv ≫ τ.left ≫ eLy.hom) (hσ τ))
      (IsLocalRing.closedPoint Ly) ∈ C := by
    by_contra hnot
    obtain ⟨S, hS⟩ := nbhd a (eLy.inv ≫ τ.left ≫ eLy.hom) (hσ τ) Cᶜ hCc.isOpen_compl hnot
    obtain ⟨m, -, hmR, hmS⟩ := hcl S
    have h1 := hS (eLy.inv ≫ m.left ≫ eLy.hom) (hσ m) (fun w hw => hmS w hw)
    exact h1 ((hC m (hσ m)).mp hmR)

  exact (hC τ (hσ τ)).mpr hzτ

theorem wc_pfam_xi_construct (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L)) :
    ∃ (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ) (A' : Type u)
      (_ : CommRing A') (_ : HenselianLocalRing A') (_ : IsSepClosed (IsLocalRing.ResidueField A'))
      (e' : Vξ.left ≅ Spec (.of A')),
      uξ ≫ ι = uy ∧
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ ∧
      ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
        y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))} :=
by
  classical
  obtain ⟨-, -, -, -, hΔc, hirr, -, -, -, -, -, hlamΔ, -⟩ := hH
  have hVyΔ : Vy.hom (e.inv (IsLocalRing.closedPoint A)) ∈ Δ := by
    rw [hVy]; exact (hlamΔ _).mpr ⟨j, rfl⟩

  have facto : ∀ (V : ValuationSubring L) (n : ℕ) (f : Polynomial V), f.Monic → f.natDegree = n →
      ∃ s : Multiset (Polynomial V), s.prod = f ∧
        ∀ g ∈ s, g.Monic ∧ (g.natDegree = 1 ∨ (Polynomial.derivative g = 0 ∧ 1 ≤ g.natDegree)) := by
    intro V n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro f hf hdeg
    by_cases h0 : n = 0
    · refine ⟨0, ?_, by simp⟩
      rw [Multiset.prod_zero]
      exact (Polynomial.eq_one_of_monic_natDegree_zero hf (hdeg.trans h0)).symm
    · have hinj : Function.Injective (algebraMap V L) := IsFractionRing.injective V L
      have hdegL : (f.map (algebraMap V L)).natDegree = n := by
        rw [Polynomial.natDegree_map_eq_of_injective hinj]; exact hdeg
      have hnu : ¬ IsUnit (f.map (algebraMap V L)) := by
        intro hu
        have := Polynomial.natDegree_eq_zero_of_isUnit hu
        omega
      obtain ⟨h, hhm, hhirr, hhd⟩ := Polynomial.exists_monic_irreducible_factor _ hnu
      obtain ⟨g, hg⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd L hf hhd
      rw [hhm.leadingCoeff, Polynomial.C_1, mul_one] at hg
      have hgm : g.Monic := Polynomial.monic_of_injective hinj (by rw [hg]; exact hhm)
      have hdvd : g ∣ f := by
        rw [← Polynomial.modByMonic_eq_zero_iff_dvd hgm]
        apply Polynomial.map_injective _ hinj
        rw [Polynomial.map_modByMonic _ hgm, hg, Polynomial.map_zero]
        exact (Polynomial.modByMonic_eq_zero_iff_dvd hhm).mpr hhd
      obtain ⟨q, hq⟩ := hdvd
      have hqm : q.Monic := hgm.of_mul_monic_left (by rw [← hq]; exact hf)
      have hgdeg : g.natDegree = h.natDegree := by
        rw [← hg, Polynomial.natDegree_map_eq_of_injective hinj]
      have hhpos : 0 < h.natDegree :=
        Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hhirr)
      have hsum : f.natDegree = g.natDegree + q.natDegree := by rw [hq, hgm.natDegree_mul hqm]
      obtain ⟨s, hs, hsg⟩ := ih q.natDegree (by omega) q hqm rfl
      refine ⟨g ::ₘ s, by rw [Multiset.prod_cons, hs, hq], ?_⟩
      intro g' hg'
      rcases Multiset.mem_cons.mp hg' with heq | hmem
      · rw [heq]
        refine ⟨hgm, ?_⟩
        by_cases hsep : h.Separable
        · left
          rw [hgdeg]
          exact Polynomial.natDegree_eq_of_degree_eq_some
            (IsSepClosed.degree_eq_one_of_irreducible L hhirr hsep)
        · right
          refine ⟨?_, by omega⟩
          have hd : Polynomial.derivative h = 0 := by
            by_contra hne
            exact hsep ((Polynomial.separable_iff_derivative_ne_zero hhirr).mpr hne)
          apply Polynomial.map_injective _ hinj
          rw [← Polynomial.derivative_map, hg, hd, Polynomial.map_zero]
      · exact hsg g' hmem

  have hens : ∀ V : ValuationSubring L, HenselianLocalRing V := by
    intro V
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ ha₀ hu
    obtain ⟨s, hs, hsg⟩ := facto V f.natDegree f hf rfl
    have hprod : (s.map (fun g => Polynomial.eval a₀ g)).prod ∈ IsLocalRing.maximalIdeal V := by
      rw [← Polynomial.eval_multiset_prod, hs]; exact ha₀
    obtain ⟨c, hc, hcm⟩ :=
      (Ideal.IsPrime.multiset_prod_mem_iff_exists_mem inferInstance _).mp hprod
    obtain ⟨g, hgs, rfl⟩ := Multiset.mem_map.mp hc
    obtain ⟨t, rfl⟩ := Multiset.exists_cons_of_mem hgs
    rw [Multiset.prod_cons] at hs
    obtain ⟨hgm, hgd⟩ := hsg g (Multiset.mem_cons_self g t)
    rcases hgd with h1 | ⟨h2, -⟩
    · have hgX := hgm.eq_X_add_C h1
      refine ⟨-(g.coeff 0), ?_, ?_⟩
      · have : Polynomial.eval (-(g.coeff 0)) g = 0 := by
          rw [hgX]; simp
        rw [Polynomial.IsRoot, ← hs, Polynomial.eval_mul, this, zero_mul]
      · have : Polynomial.eval a₀ g = a₀ + g.coeff 0 := by
          rw [hgX]; simp
        rw [this] at hcm
        have : -(g.coeff 0) - a₀ = -(a₀ + g.coeff 0) := by ring
        rw [this]
        exact (IsLocalRing.maximalIdeal V).neg_mem_iff.mpr hcm
    · exfalso
      have hder : Polynomial.eval a₀ (Polynomial.derivative f) =
          Polynomial.eval a₀ g * Polynomial.eval a₀ (Polynomial.derivative t.prod) := by
        rw [← hs, Polynomial.derivative_mul, h2]; simp
      rw [hder] at hu
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) (Ideal.mul_mem_right _ _ hcm)

  have rsep : ∀ V : ValuationSubring L, IsSepClosed (IsLocalRing.ResidueField V) := by
    intro V
    refine IsSepClosed.of_exists_root _ ?_
    intro p hpm hirr' hsep
    obtain ⟨P, hPmap, hPdeg, hPm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective _ IsLocalRing.residue_surjective p)) hpm
    obtain ⟨s, hs, hsg⟩ := facto V P.natDegree P hPm rfl
    have hpos : 0 < p.natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hirr')
    have hs0 : s ≠ 0 := by
      rintro rfl
      have : P.natDegree = 0 := by rw [← hs, Multiset.prod_zero, Polynomial.natDegree_one]
      omega
    obtain ⟨g, hg⟩ := Multiset.exists_mem_of_ne_zero hs0
    obtain ⟨t, rfl⟩ := Multiset.exists_cons_of_mem hg
    obtain ⟨hgm, hgd⟩ := hsg g (Multiset.mem_cons_self g t)
    rw [Multiset.prod_cons] at hs
    have htm : t.prod.Monic := hgm.of_mul_monic_left (by rw [hs]; exact hPm)
    have hp : p = g.map (IsLocalRing.residue V) * t.prod.map (IsLocalRing.residue V) := by
      rw [← hPmap, ← hs, Polynomial.map_mul]
    have hgpos : 0 < g.natDegree := by rcases hgd with h | h <;> omega
    have hgnu : ¬ IsUnit (g.map (IsLocalRing.residue V)) := by
      intro hu
      have := Polynomial.natDegree_eq_zero_of_isUnit hu
      rw [hgm.natDegree_map] at this
      omega
    have htu : IsUnit (t.prod.map (IsLocalRing.residue V)) :=
      (hirr'.isUnit_or_isUnit hp).resolve_left hgnu
    have ht1 : t.prod.map (IsLocalRing.residue V) = 1 := ((htm.map _).isUnit_iff).mp htu
    rw [ht1, mul_one] at hp
    rcases hgd with h1 | ⟨h2, -⟩
    · refine ⟨-(IsLocalRing.residue V (g.coeff 0)), ?_⟩
      have hgX := hgm.eq_X_add_C h1
      rw [hp, hgX]; simp
    · exfalso
      have : Polynomial.derivative p = 0 := by
        rw [hp, Polynomial.derivative_map, h2, Polynomial.map_zero]
      exact ((Polynomial.separable_iff_derivative_ne_zero hirr').mp hsep) this

  have s1 : ∀ (φ : A →+* L), Function.Injective φ → ∀ (𝔭 : Ideal A) [𝔭.IsPrime],
      ∃ (V : ValuationSubring L) (hV : ∀ a, φ a ∈ V),
        Ideal.comap (φ.codRestrict V hV) (IsLocalRing.maximalIdeal V) = 𝔭 := by
    intro φ hφ 𝔭 _
    have hu : ∀ y : 𝔭.primeCompl, IsUnit (φ y) := by
      intro y
      apply IsUnit.mk0
      intro h0
      apply y.2
      have : (y : A) = 0 := hφ (by rw [h0, map_zero])
      rw [this]; exact 𝔭.zero_mem
    let ψ : Localization.AtPrime 𝔭 →+* L := IsLocalization.lift hu
    obtain ⟨V, hV', hloc⟩ := IsLocalRing.exists_factor_valuationRing ψ
    have hV : ∀ a, φ a ∈ V := fun a => by
      have := hV' (algebraMap A _ a)
      rwa [IsLocalization.lift_eq] at this
    refine ⟨V, hV, ?_⟩
    ext a
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
    have e0 : φ.codRestrict V hV a = ψ.codRestrict V.toSubring hV' (algebraMap A _ a) := by
      apply Subtype.ext
      simp [ψ, IsLocalization.lift_eq]
    rw [e0]
    refine (map_mem_nonunits_iff (ψ.codRestrict V.toSubring hV') (algebraMap A _ a)).trans ?_
    rw [← IsLocalRing.mem_maximalIdeal]
    exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔭 a

  set Δb : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    ⇑(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ with hΔb
  have hΔbcl : IsClosed Δb :=
    hΔc.preimage (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom.continuous
  have isoApp : ∀ {X Y : Scheme.{u}} (i : X ≅ Y) (y : Y), i.hom (i.inv y) = y := by
    intro X Y i y
    rw [← Scheme.Hom.comp_apply, i.inv_hom_id]
    first | rfl | simp
  have isoApp' : ∀ {X Y : Scheme.{u}} (i : X ≅ Y) (x : X), i.inv (i.hom x) = x := by
    intro X Y i x
    rw [← Scheme.Hom.comp_apply, i.hom_inv_id]
    first | rfl | simp
  have hΔbirr : IsIrreducible Δb := by
    have hpb := wc_ldnm_di_projmap_pb F'' (AlgebraicClosure F'') M'
    obtain ⟨i, hfst⟩ : ∃ i : wcProjK (AlgebraicClosure F'') M' ≅
        Limits.pullback (wcProjKStr F'' M')
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))),
        i.hom ≫ Limits.pullback.fst (wcProjKStr F'' M')
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
          wcLdpProjMap F'' (AlgebraicClosure F'') M' :=
      ⟨hpb.isoPullback, hpb.isoPullback_hom_fst⟩
    have hj : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y =
        wcLdpProjMap F'' (AlgebraicClosure F'') M' (i.inv y) := by
      intro y
      have h1 : (i.hom ≫ Limits.pullback.fst (wcProjKStr F'' M')
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (i.inv y) =
          wcLdpProjMap F'' (AlgebraicClosure F'') M' (i.inv y) := by rw [hfst]
      rw [Scheme.Hom.comp_apply, isoApp i y] at h1
      exact h1
    have heq : Δb = i.hom '' (⇑(wcLdpProjMap F'' (AlgebraicClosure F'') M') ⁻¹' Δ) := by
      ext y
      constructor
      · intro hy
        refine ⟨i.inv y, ?_, isoApp i y⟩
        show (wcLdpProjMap F'' (AlgebraicClosure F'') M') (i.inv y) ∈ Δ
        rw [← hj]
        exact hy
      · rintro ⟨w, hw, rfl⟩
        have h2 := hj (i.hom w)
        rw [isoApp' i w] at h2
        have h3 : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (i.hom w) ∈ Δ := by
          rw [h2]; exact hw
        exact h3
    rw [heq]
    exact (hirr (AlgebraicClosure F'')).image _ i.hom.continuous.continuousOn

  set x₀ : Vy.left := e.inv (IsLocalRing.closedPoint A) with hx₀
  have hy0 : vy.left x₀ ∈ Δb := by
    show (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (vy.left x₀) ∈ Δ
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w vy]
    exact hVyΔ

  haveI : WeaklyEtale (vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [MorphismProperty.Over.w vy]; exact Vy.prop
  haveI : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  haveI : WeaklyEtale vy.left :=
    WeaklyEtale.of_comp vy.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom

  have hη : IsGenericPoint hΔbirr.genericPoint Δb := by
    have := hΔbirr.isGenericPoint_genericPoint_closure
    rwa [hΔbcl.closure_eq] at this
  obtain ⟨z, -, hzη⟩ := Flat.generalizingMap vy.left (hη.specializes hy0)
  have hzΔ : vy.left z ∈ Δb := by rw [hzη]; exact hη.mem
  have hzcl : ∀ y ∈ Δb, y ∈ closure {vy.left z} := by
    intro y hy
    rw [hzη, ← specializes_iff_mem_closure]
    exact hη.specializes hy

  haveI : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  have hx0 : e.hom x₀ = IsLocalRing.closedPoint A := isoApp e _
  let ε : (Vy.left.presheaf.stalk x₀) ≃+* A :=
    ((asIso (e.hom.stalkMap x₀)).symm ≪≫
      (Spec (.of A)).presheaf.stalkCongr (Inseparable.of_eq hx0) ≪≫
      stalkClosedPointIso (.of A)).commRingCatIsoToRingEquiv
  haveI hstH : HenselianLocalRing (Vy.left.presheaf.stalk x₀) :=
    wc_hte_sepClosed_henselian_transport.2 _ _ ε.symm inferInstance
  have hstS : IsSepClosed (Vy.left.residueField x₀) :=
    wc_hte_sepClosed_henselian_transport.1 _ _ (IsLocalRing.ResidueField.mapEquiv ε.symm)
      inferInstance
  haveI hstD : IsDomain (Vy.left.presheaf.stalk x₀) :=
    wc_weaklyEtale_smooth_stalk_isDomain F'' (wcProjKStr F'' M') M' Vy x₀ ⟨hstH, hstS⟩
  haveI : IsDomain A := MulEquiv.isDomain _ ε.symm.toMulEquiv

  haveI : WeaklyEtale (uy.left ≫ Vy.hom) := by
    rw [MorphismProperty.Over.w uy]; exact Ty.prop
  haveI : WeaklyEtale Vy.hom := Vy.prop
  haveI : WeaklyEtale uy.left := WeaklyEtale.of_comp uy.left Vy.hom
  set c : Spec (.of L) ⟶ Spec (.of A) := eL.inv ≫ uy.left ≫ e.hom with hcdef
  have hcW : WeaklyEtale c := by rw [hcdef]; infer_instance
  let φ : A →+* L := (Spec.preimage c).hom
  have hφc : Spec.map (CommRingCat.ofHom φ) = c := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage c).hom) = c
    rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage c
  have hφinj : Function.Injective φ := by
    have hWE := wc_lpkt_specMap_weaklyEtale_ring A L φ (by rw [hφc]; exact hcW)
    letI := φ.toAlgebra
    haveI : Algebra.WeaklyEtale A L := hWE
    haveI : Module.Flat A L := Algebra.WeaklyEtale.flat
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have hreg : IsSMulRegular L a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hne)
    have h1 : a • (1 : L) = a • (0 : L) := by
      rw [Algebra.smul_def, smul_zero, mul_one]
      exact ha
    exact one_ne_zero (hreg h1)

  let P0 : PrimeSpectrum A := e.hom z
  obtain ⟨V, hV, hcomV⟩ := s1 φ hφinj P0.asIdeal
  haveI := hens V
  haveI := rsep V
  letI : Algebra A V := (φ.codRestrict V hV).toAlgebra
  obtain ⟨R, _, σ, ρ, _, hρσ, hRh, hRs, hρl, hσi⟩ := wc_strict_hull A V (rsep V)
  let ψ : R →+* L := V.subtype.comp ρ
  have hψσ : ψ.comp σ = φ := by
    show (V.subtype.comp ρ).comp σ = φ
    rw [RingHom.comp_assoc, hρσ]
    ext a; rfl
  have hii : Ideal.comap σ (IsLocalRing.maximalIdeal R) = P0.asIdeal := by
    have h1 := (IsLocalRing.isLocalHom_iff_comap_closedPoint ρ).mp hρl
    have hm : Ideal.comap ρ (IsLocalRing.maximalIdeal V) = IsLocalRing.maximalIdeal R :=
      congrArg PrimeSpectrum.asIdeal h1
    rw [← hm, Ideal.comap_comap, hρσ]
    exact hcomV
  have hSσ : WeaklyEtale (Spec.map (CommRingCat.ofHom σ)) := by
    letI := σ.toAlgebra
    exact wc_lfi_specMap_weaklyEtale A R (wc_indEtale_weaklyEtale σ hσi)

  have hWξ : WeaklyEtale (Spec.map (CommRingCat.ofHom σ) ≫ e.inv ≫ Vy.hom) := by
    infer_instance
  let Vξ : (wcProjK F'' M').ProEt :=
    MorphismProperty.Over.mk ⊤ (Spec.map (CommRingCat.ofHom σ) ≫ e.inv ≫ Vy.hom) hWξ
  let ι : Vξ ⟶ Vy := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom σ) ≫ e.inv)
    (Category.assoc _ _ _) trivial
  have hstar : (eL.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
      Spec.map (CommRingCat.ofHom σ) ≫ e.inv = uy.left := by
    have h1 : Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom σ) = c := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψσ, hφc]
    rw [Category.assoc, ← Category.assoc (Spec.map (CommRingCat.ofHom ψ)), h1, hcdef]
    simp
  have hw : (eL.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Vξ.hom = Ty.hom := by
    show (eL.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
      (Spec.map (CommRingCat.ofHom σ) ≫ e.inv ≫ Vy.hom) = Ty.hom
    have : (eL.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
        (Spec.map (CommRingCat.ofHom σ) ≫ e.inv ≫ Vy.hom) = uy.left ≫ Vy.hom := by
      rw [← hstar]; simp only [Category.assoc]
    rw [this]
    exact MorphismProperty.Over.w uy
  let uξ : Ty ⟶ Vξ := MorphismProperty.Over.homMk (eL.hom ≫ Spec.map (CommRingCat.ofHom ψ)) hw
    trivial
  have hpt : (ι ≫ vy).left ((Iso.refl (Spec (.of R))).inv (IsLocalRing.closedPoint R)) =
      vy.left z := by
    show vy.left (e.inv ((Spec.map (CommRingCat.ofHom σ)) (IsLocalRing.closedPoint R))) = vy.left z
    have h1 : (Spec.map (CommRingCat.ofHom σ)) (IsLocalRing.closedPoint R) = e.hom z := by
      have h2 : (Spec.map (CommRingCat.ofHom σ)) (IsLocalRing.closedPoint R) =
          PrimeSpectrum.comap σ (IsLocalRing.closedPoint R) := rfl
      rw [h2]
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      exact hii
    rw [h1, isoApp' e z]
  refine ⟨Vξ, ι, uξ, R, inferInstance, hRh, hRs, Iso.refl _, ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    show (eL.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Spec.map (CommRingCat.ofHom σ) ≫ e.inv =
      uy.left
    exact hstar
  · have key : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι ≫ vy).left ((Iso.refl (Spec (.of R))).inv (IsLocalRing.closedPoint R))) ∈ Δ := by
      rw [hpt]; exact hzΔ
    exact key
  · intro y hy
    have key : y ∈ closure {(ι ≫ vy).left ((Iso.refl (Spec (.of R))).inv
        (IsLocalRing.closedPoint R))} := by
      rw [hpt]; exact hzcl y hy
    exact key

theorem wc_tps_generic_trait (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (f : A) (hfΔ : ∀ q : PrimeSpectrum A, Vy.hom (e.inv q) ∈ Δ ↔ f ∈ q.asIdeal)
    (hfm : f ∈ IsLocalRing.maximalIdeal A) (hfm2 : f ∉ IsLocalRing.maximalIdeal A ^ 2)
    (hNoeth : IsNoetherianRing A) (hreg : IsRegularLocalRing A) (hdom : IsDomain A)
    (hdomf : IsDomain (A ⧸ Ideal.span {f})) :
    Function.Injective (wcTpsRingOf eL e uy) ∧ Function.Injective (wcTpsRingOf eL e' uξ) ∧
      (wcTpsRingOf eL e' uξ).comp (wcTpsRingOf e' e ι) = wcTpsRingOf eL e uy ∧
      ∃ _ : IsDomain A', IsDiscreteValuationRing A' ∧
        Ideal.span {wcTpsRingOf e' e ι f} = IsLocalRing.maximalIdeal A' ∧
        (IsLocalRing.maximalIdeal A').comap (wcTpsRingOf e' e ι) = Ideal.span {f} ∧
        @Algebra.WeaklyEtale A A' _ _ (wcTpsRingOf e' e ι).toAlgebra :=
by
  classical
  haveI := hdom
  haveI := hNoeth

  have hWA : @Algebra.WeaklyEtale A L _ _ (wcTpsRingOf eL e uy).toAlgebra :=
    wc_mnt_point_map_weaklyEtale _ Vy Ty uy A L e eL
  have hWA' : @Algebra.WeaklyEtale A' L _ _ (wcTpsRingOf eL e' uξ).toAlgebra :=
    wc_mnt_point_map_weaklyEtale _ Vξ Ty uξ A' L e' eL
  have hWα : @Algebra.WeaklyEtale A A' _ _ (wcTpsRingOf e' e ι).toAlgebra :=
    wc_mnt_point_map_weaklyEtale _ Vy Vξ ι A A' e e'

  have injOf : ∀ (R : Type u) [CommRing R] [IsDomain R] (φ : R →+* L),
      @Algebra.WeaklyEtale R L _ _ φ.toAlgebra → Function.Injective φ := by
    intro R _ _ φ hφ
    letI : Algebra R L := φ.toAlgebra
    haveI : Module.Flat R L := hφ.flat
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have h1 : IsSMulRegular R a := fun x x' hxx =>
      mul_left_cancel₀ hne (by simpa only [smul_eq_mul] using hxx)
    have h2 : IsSMulRegular L (algebraMap R L a) := h1.of_flat
    have h3 : (1 : L) = 0 := h2 (show φ a * 1 = φ a * 0 by rw [ha, zero_mul, zero_mul])
    exact one_ne_zero h3

  have hcomp : (wcTpsRingOf eL e' uξ).comp (wcTpsRingOf e' e ι) = wcTpsRingOf eL e uy := by
    unfold wcTpsRingOf
    rw [← CommRingCat.hom_comp]
    refine congrArg CommRingCat.Hom.hom ?_
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage, ← hιu]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rfl

  have hf0 : f ≠ 0 := by
    rintro rfl
    exact hfm2 (Submodule.zero_mem _)
  have hpr : (Ideal.span {f}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdomf

  have hcomap : (IsLocalRing.maximalIdeal A').comap (wcTpsRingOf e' e ι) = Ideal.span {f} := by
    obtain ⟨x, hx⟩ : ∃ x, ι.left (e'.inv (IsLocalRing.closedPoint A')) = x := ⟨_, rfl⟩
    have hSpec : Spec.map (CommRingCat.ofHom (wcTpsRingOf e' e ι)) = e'.inv ≫ ι.left ≫ e.hom := by
      unfold wcTpsRingOf
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    have hqcomap : (e.hom x).asIdeal =
        (IsLocalRing.maximalIdeal A').comap (wcTpsRingOf e' e ι) := by
      let pt : ↥(Spec (CommRingCat.of A')) := IsLocalRing.closedPoint A'
      have h1 : e.hom x = (e'.inv ≫ ι.left ≫ e.hom) pt := by
        rw [← hx, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      have h2 : (Spec.map (CommRingCat.ofHom (wcTpsRingOf e' e ι))) pt =
          PrimeSpectrum.comap (wcTpsRingOf e' e ι) (IsLocalRing.closedPoint A') := by
        rw [Spec.map_apply, CommRingCat.hom_ofHom]
      rw [h1, ← hSpec, h2, PrimeSpectrum.comap_asIdeal]
      rfl
    have hw : vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Vy.hom :=
      MorphismProperty.Over.w vy
    have hwpt : ∀ z, (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (vy.left z) =
        Vy.hom z := fun z => by
      rw [← hw, Scheme.Hom.comp_apply]
    have hxe : e.inv (e.hom x) = x := Scheme.hom_inv_apply e x
    have hξ : (ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A')) = vy.left x := by
      show vy.left (ι.left (e'.inv (IsLocalRing.closedPoint A'))) = vy.left x
      rw [hx]
    have hfq : f ∈ (e.hom x).asIdeal := by
      apply (hfΔ (e.hom x)).mp
      rw [hxe, ← hwpt, ← hξ]
      exact hΔξ
    let p1 : PrimeSpectrum A := ⟨Ideal.span {f}, hpr⟩
    have hp1q : p1 ≤ e.hom x := by
      show Ideal.span {f} ≤ (e.hom x).asIdeal
      exact (Ideal.span_singleton_le_iff_mem _).mpr hfq
    have hsp : p1 ⤳ e.hom x := (PrimeSpectrum.le_iff_specializes p1 (e.hom x)).mp hp1q
    have hsp1 : e.inv p1 ⤳ x := by
      have := hsp.map e.inv.continuous
      rwa [hxe] at this
    have hsp2 : vy.left (e.inv p1) ⤳ vy.left x := hsp1.map vy.left.continuous
    have hy1Δ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (vy.left (e.inv p1)) ∈ Δ := by
      rw [hwpt]
      exact (hfΔ p1).mpr (Ideal.mem_span_singleton_self f)
    have hcl := hclξ _ hy1Δ
    rw [hξ] at hcl
    have hsp3 : vy.left x ⤳ vy.left (e.inv p1) := specializes_iff_mem_closure.mpr hcl
    have heq : vy.left (e.inv p1) = vy.left x :=
      (inseparable_iff_specializes_and.mpr ⟨hsp2, hsp3⟩).eq
    have hWvy : WeaklyEtale vy.left := by
      have hV : WeaklyEtale Vy.hom := Vy.prop
      have hGp : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
      have hc : WeaklyEtale (vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
        rw [hw]; exact hV
      exact WeaklyEtale.of_comp vy.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
    have hpx : e.inv p1 = x := wc_yjl_weaklyEtale_fibre_specializes vy.left hWvy _ _ hsp1 heq
    have hp1eq : p1 = e.hom x := by
      rw [← hpx]
      exact (Scheme.inv_hom_apply e p1).symm
    rw [← hqcomap, ← hp1eq]

  obtain ⟨hD, hdvr, -⟩ := wc_pfam_ltd_wt_xi_dvr A A' (wcTpsRingOf e' e ι) hWα f hf0 hpr hcomap

  have hspan : Ideal.span {wcTpsRingOf e' e ι f} = IsLocalRing.maximalIdeal A' := by
    set α' := wcTpsRingOf e' e ι with hα'
    letI : Algebra A A' := α'.toAlgebra
    apply le_antisymm
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      have h1 : f ∈ (IsLocalRing.maximalIdeal A').comap α' := by
        rw [hcomap]; exact Ideal.mem_span_singleton_self f
      exact h1
    · intro b hb
      obtain ⟨E, _, _, hE, β, ε, hβ, hε⟩ := wc_lpkt_indetale_factor A A' α' hWα 1 (fun _ => b)
      set P := (IsLocalRing.maximalIdeal A').comap β with hPdef
      have hP : P.comap (algebraMap A E) = Ideal.span {f} := by
        rw [hPdef, Ideal.comap_comap, hβ, hcomap]
      haveI : P.LiesOver (Ideal.span {f}) := ⟨by rw [Ideal.under_def, hP]⟩
      letI : Algebra (Localization.AtPrime (Ideal.span {f})) (Localization.AtPrime P) :=
        (Localization.localRingHom (Ideal.span {f}) P (algebraMap A E) hP.symm).toAlgebra
      haveI : IsScalarTower A (Localization.AtPrime (Ideal.span {f})) (Localization.AtPrime P) :=
        IsScalarTower.of_algebraMap_eq (fun x => by
          show _ = Localization.localRingHom (Ideal.span {f}) P (algebraMap A E) hP.symm
            (algebraMap A (Localization.AtPrime (Ideal.span {f})) x)
          rw [Localization.localRingHom_to_map,
            IsScalarTower.algebraMap_apply A E (Localization.AtPrime P)])
      have hmax : Ideal.map (algebraMap A (Localization.AtPrime P)) (Ideal.span {f}) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
        ((Algebra.isUnramifiedAt_iff_map_eq A (Ideal.span {f}) P).mp inferInstance).2
      have hunit : ∀ y : P.primeCompl, IsUnit (β y) := fun y =>
        IsLocalRing.notMem_maximalIdeal.mp y.2
      let β' : Localization.AtPrime P →+* A' := IsLocalization.lift hunit
      have hβ'1 : β'.comp (algebraMap E (Localization.AtPrime P)) = β :=
        IsLocalization.lift_comp hunit
      have hβ'e : ∀ x, β' (algebraMap E (Localization.AtPrime P) x) = β x := fun x => by
        rw [← RingHom.comp_apply, hβ'1]
      have hP0 : ε 0 ∈ P := by
        show β (ε 0) ∈ IsLocalRing.maximalIdeal A'
        rw [hε 0]; exact hb
      have hm := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P
        (ε 0)).mpr hP0
      rw [← hmax, Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton'] at hm
      obtain ⟨z, hz⟩ := hm
      have hg : β' (algebraMap A (Localization.AtPrime P) f) = α' f := by
        rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime P), hβ'e,
          ← RingHom.comp_apply, hβ]
      rw [Ideal.mem_span_singleton']
      refine ⟨β' z, ?_⟩
      rw [← hg, ← map_mul, hz, hβ'e, hε 0]
  refine ⟨injOf A _ hWA, ?_, hcomp, hD, hdvr, hspan, hcomap, hWα⟩
  haveI := hD
  exact injOf A' _ hWA'

theorem wc_tps_dictionary {X : Scheme.{u}} (T V : X.ProEt) (L R : Type u) [Field L] [IsSepClosed L]
    [CommRing R] (eL : T.left ≅ Spec (.of L)) (eV : V.left ≅ Spec (.of R)) (u : T ⟶ V) :
    IsGalois (wcTpsBase eL eV u) L ∧
    ∃ Φ : (L ≃ₐ[wcTpsBase eL eV u] L) → (T ⟶ T),
      (∀ g : L ≃ₐ[wcTpsBase eL eV u] L,
        (Φ g).left = eL.hom ≫ Spec.map (CommRingCat.ofHom (g.toRingEquiv : L →+* L)) ≫ eL.inv) ∧
      (∀ g₁ g₂ : L ≃ₐ[wcTpsBase eL eV u] L, Φ (g₁ * g₂) = Φ g₁ ≫ Φ g₂) ∧
      Φ 1 = 𝟙 T ∧
      (∀ g : L ≃ₐ[wcTpsBase eL eV u] L, Φ g ≫ u = u) ∧
      (∀ τ : T ⟶ T, τ ≫ u = u → ∃ g : L ≃ₐ[wcTpsBase eL eV u] L, Φ g = τ) ∧
      (∀ (V' : X.ProEt) (R' : Type u) [CommRing R'] (eV' : V'.left ≅ Spec (.of R'))
        (u' : T ⟶ V') (g : L ≃ₐ[wcTpsBase eL eV u] L),
        Φ g ≫ u' = u' ↔ ∀ r : R', g (wcTpsRingOf eL eV' u' r) = wcTpsRingOf eL eV' u' r) ∧
      (∀ (V' : X.ProEt) (R' : Type u) [CommRing R'] (eV' : V'.left ≅ Spec (.of R'))
        (u' : T ⟶ V') (E : X.ProEt) (πE : E ⟶ V') (eE : T ⟶ E), Etale πE.left → eE ≫ πE = u' →
        ∃ s : Finset L, ∀ g₁ g₂ : L ≃ₐ[wcTpsBase eL eV u] L,
          (∀ r : R', g₁ (wcTpsRingOf eL eV' u' r) = wcTpsRingOf eL eV' u' r) →
          (∀ r : R', g₂ (wcTpsRingOf eL eV' u' r) = wcTpsRingOf eL eV' u' r) →
          (∀ x ∈ s, g₁ x = g₂ x) → Φ g₁ ≫ eE = Φ g₂ ≫ eE) :=
by
  classical

  have hSP : ∀ {W : X.ProEt} {R' : Type u} [CommRing R'] (eW : W.left ≅ Spec (.of R'))
      (w : T ⟶ W),
      Spec.map (CommRingCat.ofHom (wcTpsRingOf eL eW w)) = eL.inv ≫ w.left ≫ eW.hom := by
    intro W R' _ eW w
    unfold wcTpsRingOf
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]

  have hCO : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C),
      Spec.map (CommRingCat.ofHom (g.comp f)) =
        Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) := by
    intro A B C _ _ _ f g
    rw [CommRingCat.ofHom_comp, Spec.map_comp]

  have hs2 : ∀ {W : X.ProEt} {R' : Type u} [CommRing R'] (eW : W.left ≅ Spec (.of R'))
      (w : T ⟶ W) (σ : L →+* L),
      (eL.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eL.inv) ≫ w.left = w.left ↔
        σ.comp (wcTpsRingOf eL eW w) = wcTpsRingOf eL eW w := by
    intro W R' _ eW w σ
    have hw : w.left = eL.hom ≫ Spec.map (CommRingCat.ofHom (wcTpsRingOf eL eW w)) ≫ eW.inv := by
      rw [hSP]
      simp only [Category.assoc, Iso.hom_inv_id_assoc, Iso.hom_inv_id, Category.comp_id]
    have key : (eL.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eL.inv) ≫ w.left =
        eL.hom ≫ Spec.map (CommRingCat.ofHom (σ.comp (wcTpsRingOf eL eW w))) ≫ eW.inv := by
      conv_lhs => rw [hw]
      rw [hCO]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [key]
    constructor
    · intro h
      conv_rhs at h => rw [hw]
      rw [cancel_epi, cancel_mono] at h
      exact congrArg CommRingCat.Hom.hom (Spec.map_injective h)
    · intro h
      rw [h, ← hw]

  have hGal : IsGalois (wcTpsBase eL eV u) L := by
    haveI h1 : WeaklyEtale (u.left ≫ V.hom) := by
      rw [MorphismProperty.Over.w u]; exact T.prop
    haveI h2 : WeaklyEtale V.hom := V.prop
    have hu : WeaklyEtale u.left := WeaklyEtale.of_comp u.left V.hom
    have hψet : WeaklyEtale (Spec.map (CommRingCat.ofHom (wcTpsRingOf eL eV u))) := by
      rw [hSP eV u]
      exact MorphismProperty.RespectsIso.precomp (@WeaklyEtale) eL.inv _
        (MorphismProperty.RespectsIso.postcomp (@WeaklyEtale) eV.hom _ hu)
    let B : Subring L := (wcTpsRingOf eL eV u).range
    let π : R →+* B := (wcTpsRingOf eL eV u).rangeRestrict
    let ι : B →+* L := B.subtype
    have hfac : wcTpsRingOf eL eV u = ι.comp π := by ext r; rfl
    have hmono : Mono (Spec.map (CommRingCat.ofHom π)) := by
      haveI := IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π)
        (RingHom.rangeRestrict_surjective _)
      infer_instance
    have hpb : IsPullback (𝟙 _) (Spec.map (CommRingCat.ofHom ι))
        (Spec.map (CommRingCat.ofHom (wcTpsRingOf eL eV u))) (Spec.map (CommRingCat.ofHom π)) := by
      have h := IsPullback.paste_vert (IsPullback.id_horiz (Spec.map (CommRingCat.ofHom ι)))
        ((mono_iff_isPullback (Spec.map (CommRingCat.ofHom π))).mp hmono)
      rw [Category.comp_id] at h
      rw [hfac, hCO]
      exact h
    have hιet : WeaklyEtale (Spec.map (CommRingCat.ofHom ι)) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hψet
    have hWE := wc_lpkt_specMap_weaklyEtale_ring B L ι hιet
    obtain ⟨-, hsep⟩ := wc_pfam_ltd_wt_point_alg B L ι hWE
    have hBK : ∀ b : B, ι b ∈ wcTpsBase eL eV u := by
      intro b
      obtain ⟨r, hr⟩ := RingHom.mem_range.mp b.2
      show (b : L) ∈ _
      rw [← hr]
      exact Subfield.subset_closure ⟨r, rfl⟩
    let ι' : B →+* wcTpsBase eL eV u := ι.codRestrict _ hBK
    have hι' : (algebraMap (wcTpsBase eL eV u) L).comp ι' = ι := by ext b; rfl
    haveI hsepK : Algebra.IsSeparable (wcTpsBase eL eV u) L := by
      rw [Algebra.isSeparable_def]
      intro x
      obtain ⟨P, hPs, hPx⟩ := hsep x
      have hQs : (P.map ι').Separable := by
        rw [← Polynomial.separable_map (algebraMap (wcTpsBase eL eV u) L), Polynomial.map_map, hι']
        exact hPs
      have hQx : Polynomial.aeval x (P.map ι') = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, hι']
        exact hPx
      exact hQs.of_dvd (minpoly.dvd _ x hQx)
    haveI : IsSepClosure (wcTpsBase eL eV u) L := ⟨inferInstance, inferInstance⟩
    exact IsSepClosure.isGalois

  have hs3 : ∀ {W : X.ProEt} {R' : Type u} [CommRing R'] (eW : W.left ≅ Spec (.of R'))
      (w : T ⟶ W) (E : X.ProEt) (πE : E ⟶ W) (eE : T ⟶ E), Etale πE.left → eE ≫ πE = w →
      ∃ s : Finset L, ∀ σ₁ σ₂ : L →+* L,
        σ₁.comp (wcTpsRingOf eL eW w) = wcTpsRingOf eL eW w →
        σ₂.comp (wcTpsRingOf eL eW w) = wcTpsRingOf eL eW w →
        (∀ x ∈ s, σ₁ x = σ₂ x) →
        (eL.hom ≫ Spec.map (CommRingCat.ofHom σ₁) ≫ eL.inv) ≫ eE.left =
          (eL.hom ≫ Spec.map (CommRingCat.ofHom σ₂) ≫ eL.inv) ≫ eE.left := by
    intro W R' _ eW w E πE eE hE hEw
    have hpt : ∀ t : T.left, t = eL.inv (IsLocalRing.closedPoint L) := by
      intro t
      have h1 : eL.inv (eL.hom t) = t := by
        rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
        first | rfl | simp
      have h2 : eL.hom t = IsLocalRing.closedPoint L :=
        Subsingleton.elim (α := PrimeSpectrum L) _ _
      calc t = eL.inv (eL.hom t) := h1.symm
        _ = eL.inv (IsLocalRing.closedPoint L) := by rw [h2]
    obtain ⟨C, j, hj, hxj, -⟩ := Scheme.exists_affine_mem_range_and_range_subset
      (x := eE.left (eL.inv (IsLocalRing.closedPoint L))) (U := ⊤) (by simp)
    haveI := hj
    have hrange : Set.range eE.left ⊆ Set.range j := by
      rintro _ ⟨t, rfl⟩
      rw [hpt t]
      exact hxj
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : T.left ⟶ Spec C, ℓ ≫ j = eE.left :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    obtain ⟨χ, hχ⟩ : ∃ χ : C →+* L, Spec.map (CommRingCat.ofHom χ) = eL.inv ≫ ℓ :=
      ⟨(Spec.preimage (eL.inv ≫ ℓ)).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    obtain ⟨c, hc⟩ : ∃ c : R' →+* C, Spec.map (CommRingCat.ofHom c) = j ≫ πE.left ≫ eW.hom :=
      ⟨(Spec.preimage (j ≫ πE.left ≫ eW.hom)).hom, by
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    have hl : eE.left ≫ πE.left = w.left := by rw [← hEw]; rfl
    have hcomp : χ.comp c = wcTpsRingOf eL eW w := by
      have h : Spec.map (CommRingCat.ofHom (χ.comp c)) =
          Spec.map (CommRingCat.ofHom (wcTpsRingOf eL eW w)) := by
        rw [hCO, hχ, hc, hSP eW w, ← hl, ← hℓ]
        simp only [Category.assoc]
      exact congrArg CommRingCat.Hom.hom (Spec.map_injective h)
    haveI := hE
    have hlft : LocallyOfFiniteType (j ≫ πE.left ≫ eW.hom) := inferInstance
    rw [← hc] at hlft
    have hft : RingHom.FiniteType c :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType) (Q := @RingHom.FiniteType)).mp hlft
    letI : Algebra R' C := c.toAlgebra
    have hFT : Algebra.FiniteType R' C := hft
    obtain ⟨t, ht⟩ := hFT.out
    letI : Algebra R' L := (wcTpsRingOf eL eW w).toAlgebra
    have hφ : ∀ σ : L →+* L, σ.comp (wcTpsRingOf eL eW w) = wcTpsRingOf eL eW w →
        ∃ φ : C →ₐ[R'] L, ∀ y, φ y = σ (χ y) := by
      intro σ hσ
      refine ⟨{ toRingHom := σ.comp χ, commutes' := fun r => ?_ }, fun y => rfl⟩
      show σ (χ (c r)) = wcTpsRingOf eL eW w r
      have hr : χ (c r) = wcTpsRingOf eL eW w r := by rw [← hcomp]; rfl
      rw [hr]
      exact RingHom.congr_fun hσ r
    have key : ∀ σ : L →+* L, (eL.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eL.inv) ≫ eE.left =
        eL.hom ≫ Spec.map (CommRingCat.ofHom (σ.comp χ)) ≫ j := by
      intro σ
      have hℓ' : ℓ = eL.hom ≫ Spec.map (CommRingCat.ofHom χ) := by
        rw [hχ, Iso.hom_inv_id_assoc]
      rw [← hℓ, hCO, hℓ']
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    refine ⟨t.image χ, fun σ₁ σ₂ h₁ h₂ hag => ?_⟩
    obtain ⟨φ₁, hφ₁⟩ := hφ σ₁ h₁
    obtain ⟨φ₂, hφ₂⟩ := hφ σ₂ h₂
    have heq : φ₁ = φ₂ := AlgHom.ext_of_adjoin_eq_top ht (fun y hy => by
      rw [hφ₁, hφ₂]
      exact hag _ (Finset.mem_image_of_mem χ hy))
    have hσχ : σ₁.comp χ = σ₂.comp χ := by
      ext y
      simp only [RingHom.comp_apply]
      rw [← hφ₁, ← hφ₂, heq]
    rw [key, key, hσχ]

  haveI := hGal
  refine ⟨hGal, ?_⟩
  have hgψ : ∀ g : L ≃ₐ[wcTpsBase eL eV u] L,
      (g.toRingEquiv : L →+* L).comp (wcTpsRingOf eL eV u) = wcTpsRingOf eL eV u := by
    intro g
    ext r
    exact g.commutes ⟨_, Subfield.subset_closure ⟨r, rfl⟩⟩
  have hw : ∀ g : L ≃ₐ[wcTpsBase eL eV u] L,
      (eL.hom ≫ Spec.map (CommRingCat.ofHom (g.toRingEquiv : L →+* L)) ≫ eL.inv) ≫ T.hom =
        T.hom := by
    intro g
    have h := (hs2 eV u (g.toRingEquiv : L →+* L)).mpr (hgψ g)
    rw [← MorphismProperty.Over.w u, ← Category.assoc, h]
  refine ⟨fun g => MorphismProperty.Over.homMk
    (eL.hom ≫ Spec.map (CommRingCat.ofHom (g.toRingEquiv : L →+* L)) ≫ eL.inv) (hw g) trivial,
    fun g => rfl, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro g₁ g₂
    apply MorphismProperty.Over.Hom.ext
    show eL.hom ≫ Spec.map (CommRingCat.ofHom ((g₁ * g₂).toRingEquiv : L →+* L)) ≫ eL.inv =
      (eL.hom ≫ Spec.map (CommRingCat.ofHom (g₁.toRingEquiv : L →+* L)) ≫ eL.inv) ≫
        (eL.hom ≫ Spec.map (CommRingCat.ofHom (g₂.toRingEquiv : L →+* L)) ≫ eL.inv)
    have hm : ((g₁ * g₂).toRingEquiv : L →+* L) =
        (g₁.toRingEquiv : L →+* L).comp (g₂.toRingEquiv : L →+* L) := by
      ext x; simp
    rw [hm, hCO]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
  ·
    apply MorphismProperty.Over.Hom.ext
    show eL.hom ≫ Spec.map (CommRingCat.ofHom
      ((1 : L ≃ₐ[wcTpsBase eL eV u] L).toRingEquiv : L →+* L)) ≫ eL.inv = 𝟙 T.left
    have h1 : ((1 : L ≃ₐ[wcTpsBase eL eV u] L).toRingEquiv : L →+* L) = RingHom.id L := by
      ext x; rfl
    rw [h1, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp, Iso.hom_inv_id]
  ·
    intro g
    apply MorphismProperty.Over.Hom.ext
    exact (hs2 eV u _).mpr (hgψ g)
  ·
    intro τ hτ
    obtain ⟨σ, hσ⟩ : ∃ σ : L →+* L,
        Spec.map (CommRingCat.ofHom σ) = eL.inv ≫ τ.left ≫ eL.hom :=
      ⟨(Spec.preimage (eL.inv ≫ τ.left ≫ eL.hom)).hom, by
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    have hτl : τ.left = eL.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eL.inv := by
      rw [hσ]
      simp only [Category.assoc, Iso.hom_inv_id_assoc, Iso.hom_inv_id, Category.comp_id]
    have hσψ : σ.comp (wcTpsRingOf eL eV u) = wcTpsRingOf eL eV u := by
      rw [← hs2 eV u σ, ← hτl]
      exact congrArg (fun f => f.left) hτ
    have hfixK : ∀ k : wcTpsBase eL eV u, σ k = k := by
      intro k
      have hle : wcTpsBase eL eV u ≤ σ.eqLocusField (RingHom.id L) := by
        apply Subfield.closure_le.mpr
        rintro _ ⟨r, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_eqLocusField]
        exact RingHom.congr_fun hσψ r
      exact RingHom.mem_eqLocusField.mp (hle k.2)
    let σK : L →ₐ[wcTpsBase eL eV u] L :=
      { toRingHom := σ, commutes' := fun k => hfixK k }
    haveI : Algebra.IsSeparable (wcTpsBase eL eV u) L := inferInstance
    haveI : Algebra.IsAlgebraic (wcTpsBase eL eV u) L := Algebra.IsSeparable.isAlgebraic _ _
    have hbij : Function.Bijective σK := Algebra.IsAlgebraic.algHom_bijective σK
    refine ⟨AlgEquiv.ofBijective σK hbij, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    show eL.hom ≫ Spec.map (CommRingCat.ofHom
      ((AlgEquiv.ofBijective σK hbij).toRingEquiv : L →+* L)) ≫ eL.inv = τ.left
    have hσ' : ((AlgEquiv.ofBijective σK hbij).toRingEquiv : L →+* L) = σ := by
      ext x; rfl
    rw [hσ', hτl]
  ·
    intro V' R' _ eV' u' g
    constructor
    · intro h
      have h' : (eL.hom ≫ Spec.map (CommRingCat.ofHom (g.toRingEquiv : L →+* L)) ≫ eL.inv) ≫
          u'.left = u'.left := congrArg (fun f => f.left) h
      have h'' := (hs2 eV' u' _).mp h'
      intro r
      exact RingHom.congr_fun h'' r
    · intro h
      apply MorphismProperty.Over.Hom.ext
      exact (hs2 eV' u' _).mpr (RingHom.ext fun r => h r)
  ·
    intro V' R' _ eV' u' E πE eE hE hEu
    obtain ⟨s, hs⟩ := hs3 eV' u' E πE eE hE hEu
    refine ⟨s, fun g₁ g₂ h₁ h₂ hag => ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact hs (g₁.toRingEquiv : L →+* L) (g₂.toRingEquiv : L →+* L)
      (RingHom.ext fun r => h₁ r) (RingHom.ext fun r => h₂ r) hag

theorem wc_tps_strict_local_realize {F'' : Type u} [Field F''] (M' : ℕ)
    (Δ : Set (wcProjK F'' M'))
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] (e : Vy.left ≅ Spec (.of A))
    (L : Type u) [Field L] (eL : Ty.left ≅ Spec (.of L))
    (f : A) (hfΔ : ∀ q : PrimeSpectrum A, Vy.hom (e.inv q) ∈ Δ ↔ f ∈ q.asIdeal)
    (B : Type u) [CommRing B] [HenselianLocalRing B] (α : A →+* B) (β : B →+* L)
    (hα : @Algebra.WeaklyEtale A B _ _ α.toAlgebra) (hαf : α f ∉ IsLocalRing.maximalIdeal B)
    (hβ : β.comp α = wcTpsRingOf eL e uy) :
    ∃ (V' : (wcProjK F'' M').ProEt) (eB : V'.left ≅ Spec (.of B)) (ι' : V' ⟶ Vy)
      (u' : Ty ⟶ V'), u' ≫ ι' = uy ∧
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι' ≫ vy).left (eB.inv (IsLocalRing.closedPoint B))) ∉ Δ ∧
      wcTpsRingOf eL eB u' = β :=
by
  classical

  have hSpecWE : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S],
      Algebra.WeaklyEtale R S → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    intro R S _ _ _ hwe
    haveI := hwe
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := S))
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R S)
      infer_instance
    exact WeaklyEtale.mk hf hd
  set Sα : Spec (.of B) ⟶ Spec (.of A) := Spec.map (CommRingCat.ofHom α) with hSα
  set Sβ : Spec (.of L) ⟶ Spec (.of B) := Spec.map (CommRingCat.ofHom β) with hSβ

  haveI hWα : WeaklyEtale Sα := by
    letI : Algebra A B := α.toAlgebra
    exact hSpecWE A B hα
  haveI hWV : WeaklyEtale Vy.hom := Vy.prop
  have hW : WeaklyEtale (Sα ≫ e.inv ≫ Vy.hom) := inferInstance

  have hK : Sβ ≫ Sα = eL.inv ≫ uy.left ≫ e.hom := by
    rw [hSα, hSβ, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hβ]
    unfold wcTpsRingOf
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hK'' : (eL.hom ≫ Sβ) ≫ (Sα ≫ e.inv) = uy.left := by
    calc (eL.hom ≫ Sβ) ≫ (Sα ≫ e.inv) = (eL.hom ≫ (Sβ ≫ Sα)) ≫ e.inv := by
          simp only [Category.assoc]
      _ = uy.left := by rw [hK]; simp

  let V' : (wcProjK F'' M').ProEt := MorphismProperty.Over.mk ⊤ (Sα ≫ e.inv ≫ Vy.hom) hW
  let eB : V'.left ≅ Spec (.of B) := Iso.refl _
  let ι' : V' ⟶ Vy := MorphismProperty.Over.homMk (Sα ≫ e.inv)
    (Category.assoc Sα e.inv Vy.hom) trivial
  have hu : (eL.hom ≫ Sβ) ≫ V'.hom = Ty.hom := by
    show (eL.hom ≫ Sβ) ≫ (Sα ≫ e.inv ≫ Vy.hom) = Ty.hom
    calc (eL.hom ≫ Sβ) ≫ (Sα ≫ e.inv ≫ Vy.hom)
        = ((eL.hom ≫ Sβ) ≫ (Sα ≫ e.inv)) ≫ Vy.hom := by simp only [Category.assoc]
      _ = Ty.hom := by rw [hK'']; exact MorphismProperty.Over.w uy
  let u' : Ty ⟶ V' := MorphismProperty.Over.homMk (eL.hom ≫ Sβ) hu trivial
  refine ⟨V', eB, ι', u', ?_, ?_, ?_⟩
  ·
    apply MorphismProperty.Over.Hom.ext
    exact hK''
  ·
    have hpt : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
        ((ι' ≫ vy).left (eB.inv (IsLocalRing.closedPoint B))) =
        Vy.hom (e.inv (PrimeSpectrum.comap α (IsLocalRing.closedPoint B))) := by
      have h5 : ∀ x : Vy.left,
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (vy.left x) = Vy.hom x :=
        fun x => congrArg (fun g : Vy.left ⟶ wcProjK F'' M' => g x) (MorphismProperty.Over.w vy)
      have h6 : Sα (show Spec (.of B) from IsLocalRing.closedPoint B) =
          (PrimeSpectrum.comap α (IsLocalRing.closedPoint B) : PrimeSpectrum A) := rfl
      show (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
          (vy.left (e.inv (Sα (show Spec (.of B) from IsLocalRing.closedPoint B)))) = _
      exact (h5 _).trans (congrArg (fun x => Vy.hom (e.inv x)) h6)
    rw [hpt]
    intro hΔ
    apply hαf
    have := (hfΔ _).1 hΔ
    rw [PrimeSpectrum.comap_asIdeal] at this
    exact Ideal.mem_comap.mp this
  ·
    unfold wcTpsRingOf
    have h3 : eL.inv ≫ u'.left ≫ eB.hom = Sβ := by
      show eL.inv ≫ (eL.hom ≫ Sβ) ≫ 𝟙 _ = Sβ
      simp
    rw [h3, hSβ, Spec.preimage_map, CommRingCat.hom_ofHom]

theorem wc_tps_galois_factorization {K L : Type u} [Field K] [Field L] [Algebra K L]
    [IsGalois K L] (T : Set L) (N : Submonoid (L ≃ₐ[K] L))
    (hN : ∀ ρ σ : L ≃ₐ[K] L, σ ∈ N → ρ * σ * ρ⁻¹ ∈ N)
    (hsurj : ∀ K₂ : IntermediateField K L, FiniteDimensional K K₂ → IsGalois K K₂ →
      (∀ σ ∈ N, ∀ x ∈ K₂, σ x = x) →
      ∀ g : L ≃ₐ[K] L, ∃ h : L ≃ₐ[K] L, (∀ t ∈ T, h t = t) ∧ ∀ x ∈ K₂, h x = g x)
    (σ : L ≃ₐ[K] L) :
    ∃ h : L ≃ₐ[K] L, (∀ t ∈ T, h t = t) ∧
      ∀ s : Finset L, ∃ n ∈ N, ∀ x ∈ s, n x = (σ * h⁻¹) x :=
by
  classical

  have s5open : ∀ (s : Finset L) (Y : Set (L ≃ₐ[K] L)),
      (∀ g g' : L ≃ₐ[K] L, g ∈ Y → (∀ x ∈ s, g' x = g x) → g' ∈ Y) → IsOpen Y := by
    intro s Y hY
    haveI : FiniteDimensional K (IntermediateField.adjoin K (s : Set L)) :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => IsGalois.integral K x)
    have hVo : IsOpen ((IntermediateField.adjoin K (s : Set L)).fixingSubgroup :
        Set (L ≃ₐ[K] L)) := IntermediateField.fixingSubgroup_isOpen _
    rw [isOpen_iff_forall_mem_open]
    intro g hg
    refine ⟨(fun g' => g⁻¹ * g') ⁻¹'
        ((IntermediateField.adjoin K (s : Set L)).fixingSubgroup : Set (L ≃ₐ[K] L)), ?_,
      hVo.preimage (continuous_const.mul continuous_id), ?_⟩
    · intro g' hg'
      apply hY g g' hg
      intro x hx
      have h1 := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hg' x
        (IntermediateField.subset_adjoin K _ (by exact_mod_cast hx))
      rw [AlgEquiv.mul_apply] at h1
      calc g' x = g (g⁻¹ (g' x)) := by rw [AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply]
        _ = g x := by rw [h1]
    · show g⁻¹ * g ∈ (IntermediateField.adjoin K (s : Set L)).fixingSubgroup
      rw [inv_mul_cancel]
      exact Subgroup.one_mem _

  have s5 : ∀ (s : Finset L) (X : Set (L ≃ₐ[K] L)),
      (∀ g g' : L ≃ₐ[K] L, g ∈ X → (∀ x ∈ s, g' x = g x) → g' ∈ X) → IsClosed X := by
    intro s X hX
    rw [← isOpen_compl_iff]
    apply s5open s
    intro g g' hg hgg'
    simp only [Set.mem_compl_iff] at hg ⊢
    intro hg'
    exact hg (hX g' g hg' (fun x hx => (hgg' x hx).symm))

  have s6 : ∀ s : Finset L, ∃ h : L ≃ₐ[K] L, (∀ t ∈ T, h t = t) ∧
      ∃ n ∈ N, ∀ x ∈ s, n x = (σ * h⁻¹) x := by
    intro s
    haveI hF : FiniteDimensional K (IntermediateField.adjoin K (s : Set L)) :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => IsGalois.integral K x)
    set E := IntermediateField.normalClosure K (IntermediateField.adjoin K (s : Set L)) L
      with hE
    haveI hEfd : FiniteDimensional K E := normalClosure.is_finiteDimensional K _ L
    haveI hEgal : IsGalois K E := IsGalois.normalClosure K _ L
    have hsE : ∀ x ∈ s, x ∈ E := fun x hx =>
      IntermediateField.le_normalClosure _
        (IntermediateField.subset_adjoin K _ (by exact_mod_cast hx))
    set U := E.fixingSubgroup with hU
    have hUnormal : U.Normal := (InfiniteGalois.normal_iff_isGalois E).mpr hEgal
    have hUopen : IsOpen (U : Set (L ≃ₐ[K] L)) := IntermediateField.fixingSubgroup_isOpen E

    have hpow : ∀ g : L ≃ₐ[K] L, ∃ k : ℕ, 0 < k ∧ g ^ k ∈ U := by
      intro g
      refine ⟨orderOf (AlgEquiv.restrictNormalHom E g), orderOf_pos _, ?_⟩
      rw [hU, IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have h1 := AlgEquiv.restrictNormalHom_apply E
        (g ^ orderOf (AlgEquiv.restrictNormalHom E g)) ⟨x, hx⟩
      rw [map_pow, pow_orderOf_eq_one, AlgEquiv.one_apply] at h1
      exact h1.symm

    let M : Subgroup (L ≃ₐ[K] L) :=
      { carrier := {m | ∃ n ∈ N, ∃ u ∈ U, m = n * u}
        one_mem' := ⟨1, N.one_mem, 1, U.one_mem, (mul_one 1).symm⟩
        mul_mem' := by
          rintro _ _ ⟨n, hn, u, hu, rfl⟩ ⟨n', hn', u', hu', rfl⟩
          refine ⟨n * n', N.mul_mem hn hn', n'⁻¹ * u * n' * u', U.mul_mem ?_ hu', by group⟩
          have := hUnormal.conj_mem u hu n'⁻¹
          rwa [inv_inv] at this
        inv_mem' := by
          rintro _ ⟨n, hn, u, hu, rfl⟩
          obtain ⟨k, hk, hkU⟩ := hpow n
          obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
          have hc := hUnormal.conj_mem _ (U.inv_mem hu) (n ^ j)⁻¹
          rw [inv_inv] at hc
          refine ⟨n ^ j, N.pow_mem hn _, (n ^ j)⁻¹ * u⁻¹ * n ^ j * (n ^ (j + 1))⁻¹,
            U.mul_mem hc (U.inv_mem hkU), ?_⟩
          rw [pow_succ]
          group }
    have hMmem : ∀ m, m ∈ M ↔ ∃ n ∈ N, ∃ u ∈ U, m = n * u := fun m => Iff.rfl
    have hMnormal : M.Normal := ⟨by
      intro m hm g
      obtain ⟨n, hn, u, hu, rfl⟩ := (hMmem m).mp hm
      exact (hMmem _).mpr ⟨g * n * g⁻¹, hN g n hn, g * u * g⁻¹, hUnormal.conj_mem u hu g,
        by group⟩⟩
    have hNM : ∀ n ∈ N, n ∈ M := fun n hn =>
      (hMmem n).mpr ⟨n, hn, 1, U.one_mem, (mul_one n).symm⟩
    have hUM : U ≤ M := fun u hu => (hMmem u).mpr ⟨1, N.one_mem, u, hu, (one_mul u).symm⟩

    have hMopen : IsOpen (M : Set (L ≃ₐ[K] L)) := Subgroup.isOpen_mono hUM hUopen
    have hMclosed : IsClosed (M : Set (L ≃ₐ[K] L)) := Subgroup.isClosed_of_isOpen M hMopen
    have heq : (IntermediateField.fixedField M).fixingSubgroup = M :=
      InfiniteGalois.fixingSubgroup_fixedField ⟨M, hMclosed⟩
    have hK2fd : FiniteDimensional K (IntermediateField.fixedField M) := by
      rw [← InfiniteGalois.isOpen_iff_finite, heq]; exact hMopen
    have hK2gal : IsGalois K (IntermediateField.fixedField M) := by
      rw [← InfiniteGalois.normal_iff_isGalois, heq]; exact hMnormal
    have hfix : ∀ n ∈ N, ∀ x ∈ IntermediateField.fixedField M, n x = x := fun n hn x hx =>
      (IntermediateField.mem_fixedField_iff M x).mp hx n (hNM n hn)
    obtain ⟨h, hT, hK⟩ := hsurj _ hK2fd hK2gal hfix σ
    have h1 : σ⁻¹ * h ∈ M := by
      rw [← heq, IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      rw [AlgEquiv.mul_apply, hK x hx, AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply]
    have h2 : σ * h⁻¹ ∈ M := by
      have := hMnormal.conj_mem _ (M.inv_mem h1) h
      have e : h * (σ⁻¹ * h)⁻¹ * h⁻¹ = σ * h⁻¹ := by group
      rwa [e] at this
    obtain ⟨n, hn, u, hu, hnu⟩ := (hMmem _).mp h2
    refine ⟨h, hT, n, hn, fun x hx => ?_⟩
    rw [hnu, AlgEquiv.mul_apply, (IntermediateField.mem_fixingSubgroup_iff E u).mp hu x (hsE x hx)]

  have s7 : ∀ s : Finset L, IsClosed {h : L ≃ₐ[K] L | (∀ t ∈ T, h t = t) ∧
      ∃ n ∈ N, ∀ x ∈ s, n x = (σ * h⁻¹) x} := by
    intro s
    have hA : IsClosed {h : L ≃ₐ[K] L | ∀ t ∈ T, h t = t} := by
      have : {h : L ≃ₐ[K] L | ∀ t ∈ T, h t = t} = ⋂ t ∈ T, {h : L ≃ₐ[K] L | h t = t} := by
        ext h; simp
      rw [this]
      exact isClosed_biInter (fun t _ => s5 {t} _ (fun g g' hg hgg' =>
        (hgg' t (Finset.mem_singleton_self t)).trans hg))
    have hD : IsClosed {g : L ≃ₐ[K] L | ∃ n ∈ N, ∀ x ∈ s, n x = g x} :=
      s5 s _ (fun g g' hg hgg' => by
        obtain ⟨n, hn, hng⟩ := hg
        exact ⟨n, hn, fun x hx => (hng x hx).trans (hgg' x hx).symm⟩)
    have hcont : Continuous (fun h : L ≃ₐ[K] L => σ * h⁻¹) :=
      continuous_const.mul continuous_inv
    exact hA.inter (hD.preimage hcont)

  obtain ⟨h, hh⟩ := IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed
    (fun s : Finset L => {h : L ≃ₐ[K] L | (∀ t ∈ T, h t = t) ∧
      ∃ n ∈ N, ∀ x ∈ s, n x = (σ * h⁻¹) x})
    (by
      intro s s'
      refine ⟨s ∪ s', ?_, ?_⟩
      · rintro h ⟨hT, n, hn, hx⟩
        exact ⟨hT, n, hn, fun x hxs => hx x (Finset.mem_union_left _ hxs)⟩
      · rintro h ⟨hT, n, hn, hx⟩
        exact ⟨hT, n, hn, fun x hxs => hx x (Finset.mem_union_right _ hxs)⟩)
    (fun s => s6 s) (fun s => (s7 s).isCompact) s7
  rw [Set.mem_iInter] at hh
  exact ⟨h, (hh ∅).1, fun s => (hh s).2⟩

theorem wc_tpa_compositum_galois : ∀ (L : Type u) [Field L] (K₀ K₁ : Subfield L), K₀ ≤ K₁ → IsGalois K₀ L → ∀ (K₂ : IntermediateField K₀ L), FiniteDimensional K₀ K₂ → IsGalois K₀ K₂ → IsGalois K₁ L ∧ FiniteDimensional K₁ (IntermediateField.adjoin K₁ (K₂ : Set L)) ∧ IsGalois K₁ (IntermediateField.adjoin K₁ (K₂ : Set L)) :=
by
  intro L _ K₀ K₁ h hgal K₂ hK₂f hK₂g
  classical
  letI : Algebra K₀ K₁ := (Subfield.inclusion h).toAlgebra
  haveI : IsScalarTower K₀ K₁ L := IsScalarTower.of_algebraMap_eq (fun x => rfl)
  have ha : IsGalois K₁ L := IsGalois.tower_top_of_isGalois K₀ K₁ L
  obtain ⟨p, hp, hspl⟩ := IsGalois.is_separable_splitting_field K₀ K₂
  obtain ⟨hK2split, hK2eq⟩ := IntermediateField.isSplittingField_iff.mp hspl
  have hsplitL : (p.map (algebraMap K₀ L)).Splits := by
    rw [IsScalarTower.algebraMap_eq K₀ K₂ L, ← Polynomial.map_map]
    exact hK2split.map _
  set q : Polynomial K₁ := p.map (algebraMap K₀ K₁) with hqdef
  have hq_map : q.map (algebraMap K₁ L) = p.map (algebraMap K₀ L) := by
    rw [hqdef, Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
  have hroot : q.rootSet L = p.rootSet L := by
    rw [Polynomial.rootSet_def, Polynomial.rootSet_def, Polynomial.aroots_def,
      Polynomial.aroots_def, hq_map]
  have hq_sep : q.Separable := hp.map
  have hq_split : (q.map (algebraMap K₁ L)).Splits := hq_map ▸ hsplitL
  haveI := IntermediateField.adjoin_rootSet_isSplittingField hq_split
  have hK2set : (K₂ : Set L) = (IntermediateField.adjoin K₀ (p.rootSet L) : Set L) :=
    congrArg (fun F : IntermediateField K₀ L => (F : Set L)) hK2eq
  have heq : IntermediateField.adjoin K₁ (K₂ : Set L) =
      IntermediateField.adjoin K₁ (q.rootSet L) := by
    rw [hroot, hK2set]
    apply le_antisymm
    · rw [IntermediateField.adjoin_le_iff]
      have hle : IntermediateField.adjoin K₀ (p.rootSet L) ≤
          (IntermediateField.adjoin K₁ (p.rootSet L)).restrictScalars K₀ := by
        rw [IntermediateField.adjoin_le_iff]
        exact IntermediateField.subset_adjoin K₁ (p.rootSet L)
      exact hle
    · exact IntermediateField.adjoin.mono K₁ _ _ (IntermediateField.subset_adjoin K₀ _)
  rw [heq]
  exact ⟨ha, Polynomial.IsSplittingField.finiteDimensional _ q,
    IsGalois.of_separable_splitting_field hq_sep⟩

theorem wc_tpa_wild_prime_to_p : ∀ (L : Type u) [Field L] (K₀ K'' : Subfield L), K₀ ≤ K'' → IsGalois K₀ L → ∀ (K₂ : IntermediateField K₀ L), FiniteDimensional K₀ K₂ → IsGalois K₀ K₂ → ∀ (p Q : ℕ), p.Prime → (∃ r, 0 < r ∧ Q = p ^ r) → (∀ g : L ≃ₐ[K₀] L, (∀ x ∈ K'', g x = x) → (∀ s : Finset L, ∃ k : ℕ, ∀ x ∈ s, (g ^ (Q ^ k)) x = x) → ∀ x ∈ K₂, g x = x) → ¬ p ∣ Module.finrank K'' (IntermediateField.adjoin K'' (K₂ : Set L)) :=
by
  classical
  intro L _ K₀ K'' hle hgal K₂ hK₂f hK₂g p Q hp hQ hH hdiv
  obtain ⟨r, hr, rfl⟩ := hQ
  obtain ⟨hgal'', hMf, hMg⟩ := wc_tpa_compositum_galois L K₀ K'' hle hgal K₂ hK₂f hK₂g
  haveI : Fact p.Prime := ⟨hp⟩

  have hcard : Nat.card (IntermediateField.adjoin K'' (K₂ : Set L) ≃ₐ[K'']
      IntermediateField.adjoin K'' (K₂ : Set L)) =
      Module.finrank K'' (IntermediateField.adjoin K'' (K₂ : Set L)) :=
    IsGalois.card_aut_eq_finrank K'' _
  obtain ⟨γ, hγ⟩ := exists_prime_orderOf_dvd_card'
    (G := IntermediateField.adjoin K'' (K₂ : Set L) ≃ₐ[K''] IntermediateField.adjoin K'' (K₂ : Set L))
    p (by rw [hcard]; exact hdiv)
  obtain ⟨g₁, hg₁⟩ := AlgEquiv.restrictNormalHom_surjective (F := K'')
    (K₁ := IntermediateField.adjoin K'' (K₂ : Set L)) L γ
  have hres : ∀ (τ : L ≃ₐ[K''] L) (y : IntermediateField.adjoin K'' (K₂ : Set L)),
      ((AlgEquiv.restrictNormalHom (IntermediateField.adjoin K'' (K₂ : Set L)) τ) y : L) = τ y :=
    fun τ y => AlgEquiv.restrictNormalHom_apply _ τ y
  have hper : ∀ y ∈ IntermediateField.adjoin K'' (K₂ : Set L), (g₁ ^ p) y = y := by
    intro y hy
    have h1 := hres (g₁ ^ p) ⟨y, hy⟩
    have h2 : AlgEquiv.restrictNormalHom (IntermediateField.adjoin K'' (K₂ : Set L)) (g₁ ^ p)
        = 1 := by
      rw [map_pow, hg₁, ← hγ]
      exact pow_orderOf_eq_one γ
    rw [h2, AlgEquiv.one_apply] at h1
    exact h1.symm
  have hγ1 : γ ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hγ
    exact hp.one_lt.ne hγ
  obtain ⟨z, hz⟩ : ∃ z : IntermediateField.adjoin K'' (K₂ : Set L), γ z ≠ z := by
    by_contra hcon
    push_neg at hcon
    exact hγ1 (AlgEquiv.ext fun x => by rw [hcon x, AlgEquiv.one_apply])
  have hy₀ : g₁ (z : L) ≠ z := by
    rw [← hres g₁ z, hg₁]
    intro h
    exact hz (Subtype.ext h)

  let σ : L ≃ₐ[K₀] L :=
    AlgEquiv.ofRingEquiv (f := g₁.toRingEquiv) (fun c => g₁.commutes ⟨(c : L), hle c.2⟩)
  obtain ⟨f, hf⟩ : ∃ f : L → L, f = ⇑σ := ⟨_, rfl⟩
  have hfg : f = ⇑g₁ := hf.trans rfl
  have hfσ : ∀ n x, f^[n] x = (σ ^ n) x := by
    intro n x
    rw [hf, AlgEquiv.coe_pow]
  have hinj : Function.Injective f := by rw [hf]; exact σ.injective

  have hperiodic : ∀ x : L, ∃ n, 0 < n ∧ f^[n] x = x := by
    intro x
    have hP : minpoly K₀ x ≠ 0 :=
      minpoly.ne_zero (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
    have hfin := Polynomial.rootSet_finite (minpoly K₀ x) L
    haveI := hfin.to_subtype
    have hmem : ∀ n : ℕ, f^[n] x ∈ (minpoly K₀ x).rootSet L := by
      intro n
      rw [Polynomial.mem_rootSet]
      refine ⟨hP, ?_⟩
      rw [hfσ, Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
    obtain ⟨i, j, hij, hfij⟩ := Finite.exists_ne_map_eq_of_infinite
      (fun n : ℕ => (⟨f^[n] x, hmem n⟩ : (minpoly K₀ x).rootSet L))
    have hfij' : f^[i] x = f^[j] x := congrArg Subtype.val hfij
    rcases lt_or_gt_of_ne hij with h | h
    · refine ⟨j - i, by omega, ?_⟩
      apply hinj.iterate i
      rw [← Function.iterate_add_apply, show i + (j - i) = j by omega]
      exact hfij'.symm
    · refine ⟨i - j, by omega, ?_⟩
      apply hinj.iterate j
      rw [← Function.iterate_add_apply, show j + (i - j) = i by omega]
      exact hfij'

  obtain ⟨e, hea, heb, hec⟩ : ∃ e : ℕ → ℕ, (∀ n N : ℕ, 0 < N → n ∣ N → e N ≡ e n [MOD n]) ∧
      (∀ N k : ℕ, 0 < N → N ≤ k → N ∣ p ^ k * e N) ∧ e p ≡ 1 [MOD p] := by
    have co : ∀ N : ℕ, N ≠ 0 →
        (p ^ N.factorization p).Coprime (N / p ^ N.factorization p) :=
      fun N hN => Nat.Coprime.pow_left _ (Nat.coprime_ordCompl hp hN)
    let e : ℕ → ℕ := fun N => if h : N = 0 then 0 else (Nat.chineseRemainder (co N h) 1 0 : ℕ)
    have he : ∀ N, N ≠ 0 → e N ≡ 1 [MOD p ^ N.factorization p] ∧
        e N ≡ 0 [MOD N / p ^ N.factorization p] := by
      intro N hN
      simp only [e, dif_neg hN]
      exact (Nat.chineseRemainder (co N hN) 1 0).2
    refine ⟨e, ?_, ?_, ?_⟩
    · intro n N hN hnN
      have hN0 : N ≠ 0 := by omega
      have hn0 : n ≠ 0 := by
        rintro rfl
        rw [zero_dvd_iff] at hnN
        exact hN0 hnN
      have h1 := he N hN0
      have h2 := he n hn0
      have hP := Nat.ordProj_dvd_ordProj_of_dvd hN0 hnN p
      have hB := Nat.ordCompl_dvd_ordCompl_of_dvd hnN p
      have k1 : e N ≡ e n [MOD p ^ n.factorization p] := (h1.1.of_dvd hP).trans h2.1.symm
      have k2 : e N ≡ e n [MOD n / p ^ n.factorization p] := (h1.2.of_dvd hB).trans h2.2.symm
      have := (Nat.modEq_and_modEq_iff_modEq_mul (co n hn0)).1 ⟨k1, k2⟩
      rwa [Nat.ordProj_mul_ordCompl_eq_self] at this
    · intro N k hN hNk
      have hN0 : N ≠ 0 := by omega
      have h1 := he N hN0
      have hB : N / p ^ N.factorization p ∣ e N := (Nat.modEq_zero_iff_dvd).1 h1.2
      have hv : N.factorization p ≤ k := by
        have a1 : N.factorization p < p ^ N.factorization p := Nat.lt_pow_self hp.one_lt
        have a2 : p ^ N.factorization p ≤ N := Nat.le_of_dvd hN (Nat.ordProj_dvd N p)
        omega
      have hP : p ^ N.factorization p ∣ p ^ k := Nat.pow_dvd_pow p hv
      have := mul_dvd_mul hP hB
      rwa [Nat.ordProj_mul_ordCompl_eq_self] at this
    · have h1 := (he p hp.ne_zero).1
      rwa [hp.factorization_self, pow_one] at h1

  have hmp_pos : ∀ x, 0 < Function.minimalPeriod f x := by
    intro x
    obtain ⟨n, hn, hx⟩ := hperiodic x
    exact Function.IsPeriodicPt.minimalPeriod_pos (f := f) (n := n) (x := x) hn hx
  have hK : ∀ x N, 0 < N → f^[N] x = x →
      f^[e (Function.minimalPeriod f x)] x = f^[e N] x := by
    intro x N hN hx
    have hd : Function.minimalPeriod f x ∣ N :=
      Function.IsPeriodicPt.minimalPeriod_dvd (f := f) (n := N) (x := x) hx
    have hmod : e N % Function.minimalPeriod f x =
        e (Function.minimalPeriod f x) % Function.minimalPeriod f x := hea _ N hN hd
    rw [← Function.iterate_mod_minimalPeriod_eq (n := e N), hmod,
      Function.iterate_mod_minimalPeriod_eq]
  have hcommon : ∀ x y,
      f^[Function.minimalPeriod f x * Function.minimalPeriod f y] x = x ∧
      f^[Function.minimalPeriod f x * Function.minimalPeriod f y] y = y := by
    intro x y
    refine ⟨(Function.isPeriodicPt_minimalPeriod f x).mul_const _, ?_⟩
    rw [mul_comm]
    exact (Function.isPeriodicPt_minimalPeriod f y).mul_const _
  let T : L → L := fun x => f^[e (Function.minimalPeriod f x)] x
  have hT : ∀ x N, 0 < N → f^[N] x = x → T x = (σ ^ e N) x := by
    intro x N hN hx
    show f^[e (Function.minimalPeriod f x)] x = _
    rw [hK x N hN hx, hfσ]
  have hTfix : ∀ x, σ x = x → T x = x := by
    intro x hx
    rw [hT x 1 one_pos (by rw [hfσ, pow_one]; exact hx), AlgEquiv.coe_pow]
    exact Function.iterate_fixed hx _
  have hTadd : ∀ x y, T (x + y) = T x + T y := by
    intro x y
    obtain ⟨hx, hy⟩ := hcommon x y
    have hN : 0 < Function.minimalPeriod f x * Function.minimalPeriod f y :=
      Nat.mul_pos (hmp_pos x) (hmp_pos y)
    have hxy : f^[Function.minimalPeriod f x * Function.minimalPeriod f y] (x + y) = x + y := by
      rw [hfσ, map_add, ← hfσ, ← hfσ, hx, hy]
    rw [hT x _ hN hx, hT y _ hN hy, hT _ _ hN hxy, map_add]
  have hTmul : ∀ x y, T (x * y) = T x * T y := by
    intro x y
    obtain ⟨hx, hy⟩ := hcommon x y
    have hN : 0 < Function.minimalPeriod f x * Function.minimalPeriod f y :=
      Nat.mul_pos (hmp_pos x) (hmp_pos y)
    have hxy : f^[Function.minimalPeriod f x * Function.minimalPeriod f y] (x * y) = x * y := by
      rw [hfσ, map_mul, ← hfσ, ← hfσ, hx, hy]
    rw [hT x _ hN hx, hT y _ hN hy, hT _ _ hN hxy, map_mul]
  let τ₀ : L →ₐ[K₀] L :=
    { toFun := T
      map_one' := hTfix 1 (map_one σ)
      map_mul' := hTmul
      map_zero' := hTfix 0 (map_zero σ)
      map_add' := hTadd
      commutes' := fun c => hTfix _ (σ.commutes c) }
  let τ : L ≃ₐ[K₀] L := AlgEquiv.ofBijective τ₀ (Algebra.IsAlgebraic.algHom_bijective τ₀)
  have hτ : ∀ x, τ x = T x := fun _ => rfl
  have hJ : ∀ x N, 0 < N → f^[N] x = x → ∀ j, (τ ^ j) x = f^[j * e N] x := by
    intro x N hN hx j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, hτ]
      have hz : f^[N] (f^[j * e N] x) = f^[j * e N] x := by
        rw [← Function.iterate_add_apply, add_comm, Function.iterate_add_apply, hx]
      rw [hT _ N hN hz, ← hfσ, ← Function.iterate_add_apply,
        show e N + j * e N = (j + 1) * e N by ring]

  have hτK'' : ∀ x ∈ K'', τ x = x := fun x hx => hTfix x (g₁.commutes ⟨x, hx⟩)
  have hpro : ∀ s : Finset L, ∃ k : ℕ, ∀ x ∈ s, (τ ^ ((p ^ r) ^ k)) x = x := by
    intro s
    obtain ⟨N, hNdef⟩ : ∃ N, N = ∏ x ∈ s, Function.minimalPeriod f x := ⟨_, rfl⟩
    refine ⟨N, ?_⟩
    intro x hx
    have hN : 0 < N := by
      rw [hNdef]
      exact Finset.prod_pos (fun y _ => hmp_pos y)
    have hxN : f^[N] x = x := by
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem (fun y => Function.minimalPeriod f y) hx
      rw [hNdef, hc]
      exact (Function.isPeriodicPt_minimalPeriod f x).mul_const c
    obtain ⟨c, hc⟩ := heb N (r * N) hN (Nat.le_mul_of_pos_left N hr)
    rw [← pow_mul, hJ x N hN hxN, hc]
    exact (show Function.IsPeriodicPt f N x from hxN).mul_const c
  have hτK₂ := hH τ hτK'' hpro

  have h3 : ∀ y, f^[p] y = y → T y = σ y := by
    intro y hy
    have hd : Function.minimalPeriod f y ∣ p :=
      Function.IsPeriodicPt.minimalPeriod_dvd (f := f) (n := p) (x := y) hy
    have hmod : e p % Function.minimalPeriod f y = 1 % Function.minimalPeriod f y :=
      hec.of_dvd hd
    show f^[e (Function.minimalPeriod f y)] y = σ y
    rw [hK y p hp.pos hy, ← Function.iterate_mod_minimalPeriod_eq (n := e p), hmod,
      Function.iterate_mod_minimalPeriod_eq, Function.iterate_one, hf]
  have hg₁K₂ : ∀ y ∈ K₂, g₁ y = y := by
    intro y hy
    have hyM : y ∈ IntermediateField.adjoin K'' (K₂ : Set L) :=
      IntermediateField.subset_adjoin K'' (K₂ : Set L) hy
    have hfp : f^[p] y = y := by
      rw [hfg, ← AlgEquiv.coe_pow]
      exact hper y hyM
    have h4 : σ y = y := (h3 y hfp).symm.trans (hτK₂ y hy)
    exact h4
  have hfixM : ∀ x ∈ IntermediateField.adjoin K'' (K₂ : Set L), g₁ x = x := by
    intro x hx
    have hx' : x ∈ (IntermediateField.adjoin K'' (K₂ : Set L)).toSubfield := hx
    rw [IntermediateField.adjoin_toSubfield] at hx'
    have hle' : Subfield.closure (Set.range (algebraMap K'' L) ∪ (K₂ : Set L)) ≤
        (g₁ : L →+* L).eqLocusField (RingHom.id L) := by
      rw [Subfield.closure_le]
      rintro y (⟨c, rfl⟩ | hy)
      · exact RingHom.mem_eqLocusField.mpr (g₁.commutes c)
      · exact RingHom.mem_eqLocusField.mpr (hg₁K₂ y hy)
    exact RingHom.mem_eqLocusField.mp (hle' hx')
  exact hy₀ (hfixM z z.2)

theorem wc_tpa_trait_kummer : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')], IsDiscreteValuationRing A' → ∀ (p : ℕ), p.Prime → (p : A') = 0 → ∀ (ϖ : A'), Ideal.span {ϖ} = IsLocalRing.maximalIdeal A' → ∀ (L : Type u) [Field L] (ψ' : A' →+* L), Function.Injective ψ' → ∀ (M : IntermediateField (Subfield.closure (Set.range ψ')) L), FiniteDimensional (Subfield.closure (Set.range ψ')) M → IsGalois (Subfield.closure (Set.range ψ')) M → ¬ p ∣ Module.finrank (Subfield.closure (Set.range ψ')) M → ∃ t : L, t ^ Module.finrank (Subfield.closure (Set.range ψ')) M = ψ' ϖ ∧ IntermediateField.adjoin (Subfield.closure (Set.range ψ')) {t} = M :=
by
  classical

  have s3 : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (n : ℕ), 0 < n → IsUnit (n : B) → ∀ (w : B), IsUnit w → ∃ v : B, v ^ n = w := by
    intro B _ _ _ n hn hnu w hw
    set r := IsLocalRing.residue B
    have hrw : r w ≠ 0 := (hw.map r).ne_zero
    have hrn : (n : IsLocalRing.ResidueField B) ≠ 0 := by
      have := (hnu.map r).ne_zero
      simpa using this
    have hsep : (Polynomial.X ^ n - Polynomial.C (r w)).Separable :=
      Polynomial.separable_X_pow_sub_C (r w) hrn hrw
    have hdeg : (Polynomial.X ^ n - Polynomial.C (r w)).degree ≠ 0 := by
      rw [Polynomial.degree_X_pow_sub_C hn]; exact_mod_cast hn.ne'
    obtain ⟨a, ha⟩ := IsSepClosed.exists_root _ hdeg hsep
    have ha' : a ^ n = r w := by
      simpa [sub_eq_zero] using ha
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [zero_pow hn.ne'] at ha'
      exact hrw ha'.symm
    obtain ⟨a₀, rfl⟩ := IsLocalRing.residue_surjective a
    have hmon : (Polynomial.X ^ n - Polynomial.C w).Monic := Polynomial.monic_X_pow_sub_C w hn.ne'
    have h1 : (Polynomial.X ^ n - Polynomial.C w).eval a₀ ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp [r] at ha' ⊢
      rw [ha', sub_self]
    have h2 : IsUnit ((Polynomial.X ^ n - Polynomial.C w).derivative.eval a₀) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X, map_mul, map_pow,
        map_natCast, Polynomial.eval_natCast]
      exact mul_ne_zero hrn (pow_ne_zero _ ha0)
    obtain ⟨v, hv, -⟩ := HenselianLocalRing.is_henselian _ hmon a₀ h1 h2
    refine ⟨v, ?_⟩
    simpa [sub_eq_zero] using hv

  have s1 : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] (L : Type u) [Field L] (ψ' : A' →+* L), Function.Injective ψ' → @IsFractionRing A' _ (Subfield.closure (Set.range ψ')) _ (ψ'.codRestrict (Subfield.closure (Set.range ψ')) (fun a => Subfield.subset_closure ⟨a, rfl⟩)).toAlgebra := by
    intro A' _ _ L _ ψ' hψ'
    letI : Algebra A' (Subfield.closure (Set.range ψ')) :=
      (ψ'.codRestrict (Subfield.closure (Set.range ψ')) (fun a => Subfield.subset_closure ⟨a, rfl⟩)).toAlgebra
    have hinj : Function.Injective (algebraMap A' (Subfield.closure (Set.range ψ'))) := by
      intro a b h
      apply hψ'
      have := congrArg (fun z : Subfield.closure (Set.range ψ') => (z : L)) h
      simpa [RingHom.algebraMap_toAlgebra] using this
    have : FaithfulSMul A' (Subfield.closure (Set.range ψ')) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    apply IsFractionRing.of_field
    intro z
    have hrange : (IsFractionRing.lift hψ' : FractionRing A' →+* L).fieldRange =
        Subfield.closure (Set.range ψ') := by
      rw [IsFractionRing.lift_fieldRange, RingHom.coe_range]
    have hz : (z : L) ∈ (IsFractionRing.lift hψ' : FractionRing A' →+* L).fieldRange := by
      rw [hrange]; exact z.2
    obtain ⟨q, hq⟩ := hz
    obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := A') q
    refine ⟨x, y, ?_⟩
    apply Subtype.ext
    rw [← hq, map_div₀, IsFractionRing.lift_algebraMap, IsFractionRing.lift_algebraMap]
    simp [RingHom.algebraMap_toAlgebra]

  have s2 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K], IsDiscreteValuationRing R → ∀ (ϖ : R), Ideal.span {ϖ} = IsLocalRing.maximalIdeal R → ∀ (n : ℕ), 0 < n → Irreducible (Polynomial.X ^ n - Polynomial.C (algebraMap R K ϖ)) := by
    intro R _ _ _ K _ _ _ hdvr ϖ hϖ n hn
    have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := by rw [← hϖ]; exact Ideal.mem_span_singleton_self ϖ
    have hϖ0 : ϖ ≠ 0 := by
      rintro rfl
      apply IsDiscreteValuationRing.not_a_field R
      rw [← hϖ, Ideal.span_singleton_eq_bot]
    have hEis : (Polynomial.X ^ n - Polynomial.C ϖ : Polynomial R).IsEisensteinAt
        (IsLocalRing.maximalIdeal R) := by
      refine ⟨?_, ?_, ?_⟩
      · rw [(Polynomial.monic_X_pow_sub_C ϖ hn.ne').leadingCoeff]
        exact fun h => (IsLocalRing.maximalIdeal.isMaximal R).ne_top
          (Ideal.eq_top_of_isUnit_mem _ h isUnit_one)
      · intro i hi
        rw [Polynomial.natDegree_X_pow_sub_C] at hi
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C]
        by_cases h0 : i = 0
        · subst h0
          rw [if_neg (by omega), zero_sub]
          exact neg_mem hϖm
        · simp [h0, hi.ne]
      · rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C]
        rw [if_neg (by omega), if_pos rfl, zero_sub]
        rw [← hϖ, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        rintro ⟨c, hc⟩
        have h1 : ϖ * (1 + ϖ * c) = 0 := by linear_combination (-1 : R) * hc
        rcases mul_eq_zero.mp h1 with h | h
        · exact hϖ0 h
        · have hu : IsUnit ϖ := isUnit_iff_exists_inv.mpr ⟨-c, by linear_combination (-1 : R) * h⟩
          exact (IsLocalRing.mem_maximalIdeal ϖ).mp hϖm hu
    have hirr : Irreducible (Polynomial.X ^ n - Polynomial.C ϖ : Polynomial R) :=
      hEis.irreducible (IsLocalRing.maximalIdeal.isMaximal R).isPrime
        (Polynomial.monic_X_pow_sub_C ϖ hn.ne').isPrimitive
        (by rw [Polynomial.natDegree_X_pow_sub_C]; exact hn)
    have := (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map
      (K := K) (Polynomial.monic_X_pow_sub_C ϖ hn.ne')).mp hirr
    simpa using this

  have s5 : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')], IsDiscreteValuationRing A' → ((∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) → HenselianLocalRing R → HenselianLocalRing S) ∧ (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L)) → (∀ (B : Type u) [CommRing B] [Algebra A' B], Module.Finite A' B → ∃ (n : ℕ) (e : Fin n → B), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))), IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧ IsLocalHom ((algebraMap B (Localization.Away (e i))).comp (algebraMap A' B))) → ∀ (K E : Type u) [Field K] [Field E] [Algebra A' K] [IsFractionRing A' K] [Algebra K E] [Algebra A' E] [IsScalarTower A' K E] [FiniteDimensional K E] [Algebra.IsSeparable K E], Module.Finite A' (integralClosure A' E) ∧ ∃ (_ : HenselianLocalRing (integralClosure A' E)), IsSepClosed (IsLocalRing.ResidueField (integralClosure A' E)) ∧ IsDiscreteValuationRing (integralClosure A' E) ∧ IsLocalHom (algebraMap A' (integralClosure A' E)) := by
    intro A' _ _ _ _ hdvr htrans hdec K E _ _ _ _ _ _ _ _ _
    haveI := hdvr
    have hfin : Module.Finite A' (integralClosure A' E) :=
      IsIntegralClosure.finite A' K E (integralClosure A' E)
    have hinj : Function.Injective (algebraMap A' (integralClosure A' E)) := by
      have h1 : Function.Injective (algebraMap A' E) := by
        rw [IsScalarTower.algebraMap_eq A' K E]
        exact (algebraMap K E).injective.comp (IsFractionRing.injective A' K)
      rw [IsScalarTower.algebraMap_eq A' (integralClosure A' E) E] at h1
      rw [RingHom.coe_comp] at h1
      exact Function.Injective.of_comp h1
    obtain ⟨m, e, hidem, -, hsum, hloc⟩ := hdec _ hfin
    have hne : ∑ i, e i ≠ 0 := by rw [hsum]; exact one_ne_zero
    obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    have hi1 : e i = 1 := (IsIdempotentElem.iff_eq_zero_or_one.mp (hidem i)).resolve_left hi
    have hunit : IsUnit (e i) := by rw [hi1]; exact isUnit_one
    obtain ⟨hH, hS, -⟩ := hloc i
    let σ : Localization.Away (e i) ≃+* integralClosure A' E :=
      (IsLocalization.atUnit (integralClosure A' E) (Localization.Away (e i)) (e i) hunit).symm.toRingEquiv
    haveI hHB : HenselianLocalRing (integralClosure A' E) := htrans.1 _ _ σ hH
    have hSB : IsSepClosed (IsLocalRing.ResidueField (integralClosure A' E)) :=
      htrans.2 _ _ (IsLocalRing.ResidueField.mapEquiv σ) hS
    haveI : FaithfulSMul A' (integralClosure A' E) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    haveI : Algebra.IsIntegral A' (integralClosure A' E) := Algebra.IsIntegral.of_finite _ _
    have hlh : IsLocalHom (algebraMap A' (integralClosure A' E)) := Algebra.IsIntegral.isLocalHom _ _
    have hDD : IsDedekindDomain (integralClosure A' E) :=
      IsIntegralClosure.isDedekindDomain A' K E (integralClosure A' E)
    haveI := hDD
    haveI : IsNoetherianRing (integralClosure A' E) :=
      IsIntegralClosure.isNoetherianRing A' K E (integralClosure A' E)
    have hnf : ¬ IsField (integralClosure A' E) := by
      intro hf
      have hA := isField_of_isIntegral_of_isField hinj hf
      exact IsDiscreteValuationRing.not_a_field A' ((IsLocalRing.isField_iff_maximalIdeal_eq).mp hA)
    have hdvrB : IsDiscreteValuationRing (integralClosure A' E) :=
      ((IsDiscreteValuationRing.TFAE (integralClosure A' E) hnf).out 1 3).mpr hDD
    exact ⟨hfin, hHB, hSB, hdvrB, hlh⟩

  have s6 : ∀ (A' K E B : Type u) [CommRing A'] [IsDomain A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] [Field K] [Field E] [CommRing B] [IsDomain B] [IsLocalRing B] [Algebra A' K] [IsFractionRing A' K] [Algebra K E] [Algebra A' E] [IsScalarTower A' K E] [Algebra A' B] [Algebra B E] [IsScalarTower A' B E] [IsFractionRing B E] [Module.Finite A' B], IsDiscreteValuationRing A' → IsDiscreteValuationRing B → IsLocalHom (algebraMap A' B) → ∀ (p : ℕ), p.Prime → (p : A') = 0 → ¬ p ∣ Module.finrank K E → ∀ (ϖ : A'), Ideal.span {ϖ} = IsLocalRing.maximalIdeal A' → ∃ (y u : B), IsUnit u ∧ algebraMap A' B ϖ = u * y ^ Module.finrank K E := by
    intro A' K E B _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hdvrA hdvrB hlh p hp hpA hpn ϖ hϖ
    haveI := hdvrA
    haveI := hdvrB
    have h𝔪 : IsLocalRing.maximalIdeal A' ≠ ⊥ := IsDiscreteValuationRing.not_a_field A'
    have hef := Ideal.ramificationIdx_mul_inertiaDeg_of_isLocalRing B K E
      (p := IsLocalRing.maximalIdeal A') h𝔪
    have hcomap : (IsLocalRing.maximalIdeal B).comap (algebraMap A' B) =
        IsLocalRing.maximalIdeal A' :=
      ((IsLocalRing.local_hom_TFAE (algebraMap A' B)).out 1 5).mp hlh
    haveI hlies : (IsLocalRing.maximalIdeal B).LiesOver (IsLocalRing.maximalIdeal A') :=
      ⟨hcomap.symm⟩
    rw [Ideal.inertiaDeg'_algebraMap] at hef
    set n := Module.finrank K E with hn
    have hn0 : n ≠ 0 := by
      rintro h0; exact hpn (h0 ▸ dvd_zero p)
    haveI : (IsLocalRing.maximalIdeal A').IsMaximal := IsLocalRing.maximalIdeal.isMaximal A'
    haveI : (IsLocalRing.maximalIdeal B).IsMaximal := IsLocalRing.maximalIdeal.isMaximal B
    letI : Field (A' ⧸ IsLocalRing.maximalIdeal A') := Ideal.Quotient.field _
    letI : Field (B ⧸ IsLocalRing.maximalIdeal B) := Ideal.Quotient.field _
    haveI : IsSepClosed (A' ⧸ IsLocalRing.maximalIdeal A') :=
      inferInstanceAs (IsSepClosed (IsLocalRing.ResidueField A'))
    haveI : Algebra.IsIntegral A' B := Algebra.IsIntegral.of_finite _ _
    haveI : Algebra.IsIntegral (A' ⧸ IsLocalRing.maximalIdeal A')
        (B ⧸ IsLocalRing.maximalIdeal B) :=
      Ideal.Quotient.algebra_isIntegral_of_liesOver _ _
    haveI : IsPurelyInseparable (A' ⧸ IsLocalRing.maximalIdeal A')
        (B ⧸ IsLocalRing.maximalIdeal B) :=
      Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
    haveI : CharP (A' ⧸ IsLocalRing.maximalIdeal A') p :=
      (CharP.charP_iff_prime_eq_zero hp).mpr (by
        rw [← map_natCast (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A')), hpA, map_zero])
    haveI : ExpChar (A' ⧸ IsLocalRing.maximalIdeal A') p := ExpChar.prime hp
    have hfpos : 0 < Module.finrank (A' ⧸ IsLocalRing.maximalIdeal A')
        (B ⧸ IsLocalRing.maximalIdeal B) := by
      rcases Nat.eq_zero_or_pos (Module.finrank (A' ⧸ IsLocalRing.maximalIdeal A')
          (B ⧸ IsLocalRing.maximalIdeal B)) with h | h
      · rw [h, mul_zero] at hef; exact absurd hef.symm hn0
      · exact h
    haveI : FiniteDimensional (A' ⧸ IsLocalRing.maximalIdeal A')
        (B ⧸ IsLocalRing.maximalIdeal B) :=
      Module.finite_of_finrank_pos hfpos
    obtain ⟨k, hk⟩ := IsPurelyInseparable.finrank_eq_pow (A' ⧸ IsLocalRing.maximalIdeal A')
      (B ⧸ IsLocalRing.maximalIdeal B) p
    have hk0 : k = 0 := by
      by_contra hk0
      apply hpn
      have h1 : p ∣ p ^ k := dvd_pow_self p hk0
      rw [← hk] at h1
      exact h1.trans (Dvd.intro_left _ hef)
    rw [hk, hk0, pow_zero, mul_one] at hef
    obtain ⟨y, hy⟩ := IsDiscreteValuationRing.exists_irreducible B
    have hyM : IsLocalRing.maximalIdeal B = Ideal.span {y} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer y).mp hy
    have hinj : Function.Injective (algebraMap A' B) := by
      have h1 : Function.Injective (algebraMap A' E) := by
        rw [IsScalarTower.algebraMap_eq A' K E]
        exact (algebraMap K E).injective.comp (IsFractionRing.injective A' K)
      rw [IsScalarTower.algebraMap_eq A' B E, RingHom.coe_comp] at h1
      exact Function.Injective.of_comp h1
    have hϖ0 : ϖ ≠ 0 := by
      rintro rfl
      apply h𝔪
      rw [← hϖ, Ideal.span_singleton_eq_bot]
    have hx0 : algebraMap A' B ϖ ≠ 0 := by
      intro h; apply hϖ0; apply hinj; rw [h, map_zero]
    obtain ⟨k', w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hy
    have hmap : Ideal.map (algebraMap A' B) (IsLocalRing.maximalIdeal A') =
        Ideal.span {y ^ k'} := by
      rw [← hϖ, Ideal.map_span, Set.image_singleton, hw,
        Ideal.span_singleton_mul_left_unit w.isUnit]
    have hy0 : y ≠ 0 := hy.ne_zero
    have hyu : ¬ IsUnit y := hy.not_isUnit
    have hram : (IsLocalRing.maximalIdeal A').ramificationIdx' (IsLocalRing.maximalIdeal B) = k' := by
      apply Ideal.ramificationIdx'_spec
      · rw [hmap, hyM, Ideal.span_singleton_pow]
      · rw [hmap, hyM, Ideal.span_singleton_pow, Ideal.span_singleton_le_span_singleton]
        intro h
        have := (pow_dvd_pow_iff hy0 hyu).mp h
        omega
    rw [hram] at hef
    refine ⟨y, w, w.isUnit, ?_⟩
    rw [hw, hef]

  intro A' _ _ _ _ hdvr p hp hpA ϖ hϖ L _ ψ' hψ' M hMf hMg hpn
  haveI := hMf
  letI algK : Algebra A' (Subfield.closure (Set.range ψ')) :=
    (ψ'.codRestrict (Subfield.closure (Set.range ψ'))
      (fun a => Subfield.subset_closure ⟨a, rfl⟩)).toAlgebra
  haveI hfrac : IsFractionRing A' (Subfield.closure (Set.range ψ')) := s1 A' L ψ' hψ'
  letI algM : Algebra A' M :=
    ((algebraMap (Subfield.closure (Set.range ψ')) M).comp
      (algebraMap A' (Subfield.closure (Set.range ψ')))).toAlgebra
  haveI : IsScalarTower A' (Subfield.closure (Set.range ψ')) M :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.IsSeparable (Subfield.closure (Set.range ψ')) M := IsGalois.to_isSeparable
  obtain ⟨hfinB, hHB, hSB, hdvrB, hlhB⟩ := s5 A' hdvr wc_henselian_sepClosed_transfer
    (fun B _ _ hB => wc_strictHensel_finite_idem_decomp A' B hB)
    (Subfield.closure (Set.range ψ')) M
  haveI := hHB
  haveI := hfinB
  haveI : IsFractionRing (integralClosure A' M) M :=
    integralClosure.isFractionRing_of_finite_extension (Subfield.closure (Set.range ψ')) M
  obtain ⟨y, u, hu, hyu⟩ := s6 A' (Subfield.closure (Set.range ψ')) M (integralClosure A' M)
    hdvr hdvrB hlhB p hp hpA hpn ϖ hϖ
  set n := Module.finrank (Subfield.closure (Set.range ψ')) M with hn
  have hnpos : 0 < n := Module.finrank_pos
  have hunitn : IsUnit (n : integralClosure A' M) := by
    have hcop : Nat.Coprime p n := (Nat.Prime.coprime_iff_not_dvd hp).mpr hpn
    have h1 := Nat.gcd_eq_gcd_ab p n
    rw [hcop.gcd_eq_one] at h1
    have h2 := congrArg (Int.cast : ℤ → integralClosure A' M) h1
    push_cast at h2
    have hpB : (p : integralClosure A' M) = 0 := by
      rw [← map_natCast (algebraMap A' (integralClosure A' M)), hpA, map_zero]
    rw [hpB, zero_mul, zero_add] at h2
    exact isUnit_iff_exists_inv.mpr ⟨_, h2.symm⟩
  obtain ⟨v, hv⟩ := s3 (integralClosure A' M) n hnpos hunitn u hu
  have htB : (v * y) ^ n = algebraMap A' (integralClosure A' M) ϖ := by
    rw [mul_pow, hv, hyu]
  have ht : ((algebraMap (integralClosure A' M) M (v * y) : M) : L) ^ n = ψ' ϖ := by
    have e1 : ((algebraMap (integralClosure A' M) M (v * y) : M) : L) ^ n =
        ((algebraMap (integralClosure A' M) M ((v * y) ^ n) : M) : L) := by
      rw [map_pow]; rfl
    rw [e1, htB, ← IsScalarTower.algebraMap_apply]
    rfl
  refine ⟨((algebraMap (integralClosure A' M) M (v * y) : M) : L), ht, ?_⟩
  have htM : ((algebraMap (integralClosure A' M) M (v * y) : M) : L) ∈ M :=
    (algebraMap (integralClosure A' M) M (v * y)).2
  have hle : IntermediateField.adjoin (Subfield.closure (Set.range ψ'))
      {((algebraMap (integralClosure A' M) M (v * y) : M) : L)} ≤ M :=
    IntermediateField.adjoin_simple_le_iff.mpr htM
  have hirr := s2 A' (Subfield.closure (Set.range ψ')) hdvr ϖ hϖ n hnpos
  have haev : Polynomial.aeval ((algebraMap (integralClosure A' M) M (v * y) : M) : L)
      (Polynomial.X ^ n - Polynomial.C (algebraMap A' (Subfield.closure (Set.range ψ')) ϖ)) = 0 := by
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, ht]
    exact sub_self _
  have hmon : (Polynomial.X ^ n - Polynomial.C
      (algebraMap A' (Subfield.closure (Set.range ψ')) ϖ)).Monic :=
    Polynomial.monic_X_pow_sub_C _ hnpos.ne'
  have hmin := minpoly.eq_of_irreducible_of_monic hirr haev hmon
  have hint : IsIntegral (Subfield.closure (Set.range ψ'))
      ((algebraMap (integralClosure A' M) M (v * y) : M) : L) :=
    ⟨_, hmon, by rw [← Polynomial.aeval_def]; exact haev⟩
  have hfr : Module.finrank (Subfield.closure (Set.range ψ'))
      (IntermediateField.adjoin (Subfield.closure (Set.range ψ'))
        {((algebraMap (integralClosure A' M) M (v * y) : M) : L)}) = n := by
    rw [IntermediateField.adjoin.finrank hint, ← hmin, Polynomial.natDegree_X_pow_sub_C]
  exact IntermediateField.eq_of_le_of_finrank_eq hle (by rw [hfr])

theorem wc_tpa_strict_point : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsNoetherianRing R] (L : Type u) [Field L] [IsSepClosed L] (ψ₁ : R →+* L), Function.Injective ψ₁ → ∀ (𝔮 : Ideal R) [𝔮.IsPrime], ∃ (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B) (_ : IsSepClosed (IsLocalRing.ResidueField B)) (α : R →+* B) (β : B →+* L), @Algebra.WeaklyEtale R B _ _ α.toAlgebra ∧ (IsLocalRing.maximalIdeal B).comap α = 𝔮 ∧ β.comp α = ψ₁ :=
by
  intro R _ _ _ _ L _ _ ψ₁ hinj 𝔮 _

  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
      (∀ f : Polynomial A, f.Monic → 0 < f.natDegree → ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧
        f = g * h ∧ 0 < g.natDegree ∧
        (Polynomial.derivative g = 0 ∨ ∃ c : A, g = Polynomial.X + Polynomial.C c)) →
      HenselianLocalRing A := by
    intro A _ _ hfac
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ hfa hfa'
    have usub : ∀ u x : A, IsUnit u → x ∈ IsLocalRing.maximalIdeal A → IsUnit (u - x) := by
      intro u x hu hx
      by_contra hc
      have h1 : u - x ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr hc
      have h2 : u ∈ IsLocalRing.maximalIdeal A := by
        have := Ideal.add_mem _ h1 hx
        simpa using this
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 hu
    have key : ∀ n : ℕ, ∀ f : Polynomial A, f.natDegree = n → f.Monic →
        Polynomial.eval a₀ f ∈ IsLocalRing.maximalIdeal A →
        IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) →
        ∃ a, f.IsRoot a ∧ a - a₀ ∈ IsLocalRing.maximalIdeal A := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro f hfn hf hfa hfa'
        rcases Nat.eq_zero_or_pos n with h0 | hpos
        · exfalso
          have h1 : f = 1 := Polynomial.eq_one_of_monic_natDegree_zero hf (hfn.trans h0)
          rw [h1, Polynomial.eval_one] at hfa
          exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr hfa)
        · obtain ⟨g, h, hg, hh, hfgh, hgpos, hgd⟩ := hfac f hf (hfn ▸ hpos)
          have hev : Polynomial.eval a₀ f = Polynomial.eval a₀ g * Polynomial.eval a₀ h := by
            rw [hfgh, Polynomial.eval_mul]
          have hder : Polynomial.eval a₀ (Polynomial.derivative f) =
              Polynomial.eval a₀ (Polynomial.derivative g) * Polynomial.eval a₀ h +
              Polynomial.eval a₀ g * Polynomial.eval a₀ (Polynomial.derivative h) := by
            rw [hfgh, Polynomial.derivative_mul, Polynomial.eval_add, Polynomial.eval_mul,
              Polynomial.eval_mul]
          by_cases hga : Polynomial.eval a₀ g ∈ IsLocalRing.maximalIdeal A
          · have hu : IsUnit (Polynomial.eval a₀ (Polynomial.derivative g) * Polynomial.eval a₀ h) := by
              have := usub _ _ hfa'
                (Ideal.mul_mem_right (Polynomial.eval a₀ (Polynomial.derivative h)) _ hga)
              rwa [hder, add_sub_cancel_right] at this
            have hgd0 : Polynomial.derivative g ≠ 0 := by
              intro h0
              rw [h0, Polynomial.eval_zero, zero_mul] at hu
              exact not_isUnit_zero hu
            rcases hgd with h0 | ⟨c, hc⟩
            · exact absurd h0 hgd0
            · refine ⟨-c, ?_, ?_⟩
              · rw [hfgh]
                apply Polynomial.root_mul_right_of_isRoot
                rw [hc, Polynomial.IsRoot.def, Polynomial.eval_add, Polynomial.eval_X,
                  Polynomial.eval_C, neg_add_cancel]
              · have : -c - a₀ = -(Polynomial.eval a₀ g) := by
                  rw [hc, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C]; ring
                rw [this]
                exact (Ideal.neg_mem_iff _).mpr hga
          · have hha : Polynomial.eval a₀ h ∈ IsLocalRing.maximalIdeal A := by
              rw [hev] at hfa
              rcases (IsLocalRing.maximalIdeal.isMaximal A).isPrime.mem_or_mem hfa with h1 | h1
              · exact absurd h1 hga
              · exact h1
            have hu : IsUnit (Polynomial.eval a₀ g * Polynomial.eval a₀ (Polynomial.derivative h)) := by
              have := usub _ _ hfa'
                (Ideal.mul_mem_left _ (Polynomial.eval a₀ (Polynomial.derivative g)) hha)
              rwa [hder, add_sub_cancel_left] at this
            have hh' : IsUnit (Polynomial.eval a₀ (Polynomial.derivative h)) :=
              isUnit_of_mul_isUnit_right hu
            have hdeg : h.natDegree < n := by
              have := Polynomial.Monic.natDegree_mul hg hh
              rw [← hfgh, hfn] at this
              omega
            obtain ⟨a, ha, ham⟩ := ih _ hdeg h rfl hh hha hh'
            refine ⟨a, ?_, ham⟩
            rw [hfgh]
            exact Polynomial.root_mul_left_of_isRoot g ha
    exact key _ f rfl hf hfa hfa'

  have s4 : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
      (∀ f : Polynomial A, f.Monic → 0 < f.natDegree → ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧
        f = g * h ∧ 0 < g.natDegree ∧
        (Polynomial.derivative g = 0 ∨ ∃ c : A, g = Polynomial.X + Polynomial.C c)) →
      IsSepClosed (IsLocalRing.ResidueField A) := by
    intro A _ _ hfac
    apply IsSepClosed.of_exists_root
    intro p hp hirr hsep
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue A) :=
      (Polynomial.mem_lifts p).mpr (Polynomial.map_surjective _ IsLocalRing.residue_surjective p)
    obtain ⟨P, hPmap, hPdeg, hPmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hp
    obtain ⟨g, h, hg, hh, hPgh, hgpos, hgd⟩ := hfac P hPmon (hPdeg ▸ hirr.natDegree_pos)
    have hp' : p = g.map (IsLocalRing.residue A) * h.map (IsLocalRing.residue A) := by
      rw [← hPmap, hPgh, Polynomial.map_mul]
    have hgsep : (g.map (IsLocalRing.residue A)).Separable := hsep.of_dvd ⟨_, hp'⟩
    have hgdeg : (g.map (IsLocalRing.residue A)).natDegree = g.natDegree :=
      hg.natDegree_map (IsLocalRing.residue A)
    rcases hgd with h0 | ⟨c, hc⟩
    · exfalso
      have h1 : Polynomial.derivative (g.map (IsLocalRing.residue A)) = 0 := by
        rw [Polynomial.derivative_map, h0, Polynomial.map_zero]
      rw [Polynomial.separable_def, h1, isCoprime_zero_right] at hgsep
      have := Polynomial.natDegree_eq_zero_of_isUnit hgsep
      omega
    · refine ⟨-(IsLocalRing.residue A c), ?_⟩
      rw [hp', Polynomial.eval_mul, hc, Polynomial.map_add, Polynomial.map_X, Polynomial.map_C,
        Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C, neg_add_cancel, zero_mul]

  have s2 : ∀ (V : ValuationSubring L),
      (∀ f : Polynomial V, f.Monic → 0 < f.natDegree → ∃ g h : Polynomial V, g.Monic ∧ h.Monic ∧
        f = g * h ∧ 0 < g.natDegree ∧
        (Polynomial.derivative g = 0 ∨ ∃ c : V, g = Polynomial.X + Polynomial.C c)) := by
    intro V f hf hfpos
    have hι : Function.Injective (algebraMap V L) := IsFractionRing.injective V L
    have hFm : (f.map (algebraMap V L)).Monic := hf.map _
    have hFdeg : (f.map (algebraMap V L)).natDegree = f.natDegree := hf.natDegree_map _
    have hFu : ¬ IsUnit (f.map (algebraMap V L)) := by
      intro hu
      have := Polynomial.natDegree_eq_zero_of_isUnit hu
      omega
    obtain ⟨q, hqm, hqirr, r, hFqr⟩ := Polynomial.exists_monic_irreducible_factor _ hFu
    have hrm : r.Monic := hqm.of_mul_monic_left (hFqr ▸ hFm)
    obtain ⟨g, hg⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd L hf
      (show q ∣ f.map (algebraMap V L) from ⟨r, hFqr⟩)
    obtain ⟨h, hh⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd L hf
      (show r ∣ f.map (algebraMap V L) from ⟨q, by rw [hFqr, mul_comm]⟩)
    rw [hqm.leadingCoeff, Polynomial.C_1, mul_one] at hg
    rw [hrm.leadingCoeff, Polynomial.C_1, mul_one] at hh
    have monic_of : ∀ (g : Polynomial V) (q : Polynomial L), g.map (algebraMap V L) = q →
        q.Monic → g.Monic := by
      intro g q hgq hq
      apply hι
      rw [← Polynomial.leadingCoeff_map_of_injective hι, hgq, hq.leadingCoeff, map_one]
    have hgm := monic_of g q hg hqm
    have hhm := monic_of h r hh hrm
    have hgdeg : g.natDegree = q.natDegree := by
      rw [← hg, Polynomial.natDegree_map_eq_of_injective hι]
    refine ⟨g, h, hgm, hhm, ?_, ?_, ?_⟩
    · apply Polynomial.map_injective _ hι
      rw [Polynomial.map_mul, hg, hh]
      exact hFqr
    · rw [hgdeg]; exact hqirr.natDegree_pos
    · by_cases hqs : q.Separable
      · right
        have h1 : q.degree = 1 := IsSepClosed.degree_eq_one_of_irreducible L hqirr hqs
        have h2 : g.natDegree = 1 := by
          rw [hgdeg]; exact Polynomial.natDegree_eq_of_degree_eq_some h1
        exact ⟨g.coeff 0, hgm.eq_X_add_C h2⟩
      · left
        have h1 : Polynomial.derivative q = 0 := by
          by_contra hne
          exact hqs ((Polynomial.separable_iff_derivative_ne_zero hqirr).mpr hne)
        apply Polynomial.map_injective _ hι
        rw [← Polynomial.derivative_map, hg, h1, Polynomial.map_zero]

  have hunit : ∀ y : 𝔮.primeCompl, IsUnit (ψ₁ y) := by
    intro y
    apply isUnit_iff_ne_zero.mpr
    intro h0
    apply y.2
    have : (y : R) = 0 := hinj (by rw [h0, map_zero])
    rw [this]
    exact 𝔮.zero_mem
  obtain ⟨V, hS, hloc⟩ := IsLocalRing.exists_factor_valuationRing
    (IsLocalization.lift (S := Localization.AtPrime 𝔮) hunit)
  have hS' : ∀ x, (IsLocalization.lift (S := Localization.AtPrime 𝔮) hunit) x ∈ V := hS
  have hV : ∀ r : R, ψ₁ r ∈ V := by
    intro r
    have := hS' (algebraMap R (Localization.AtPrime 𝔮) r)
    rwa [IsLocalization.lift_eq] at this
  set gV : Localization.AtPrime 𝔮 →+* V :=
    (IsLocalization.lift (S := Localization.AtPrime 𝔮) hunit).codRestrict V hS' with hgV
  haveI hlocV : IsLocalHom gV := ⟨fun a ha => IsLocalHom.map_nonunit
    (f := (IsLocalization.lift (S := Localization.AtPrime 𝔮) hunit).codRestrict V.toSubring hS) a ha⟩
  have hcomV : (IsLocalRing.maximalIdeal V).comap gV =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
    ((IsLocalRing.local_hom_TFAE gV).out 1 5).mp hlocV
  have hfac : ψ₁.codRestrict V hV = gV.comp (algebraMap R (Localization.AtPrime 𝔮)) := by
    ext r
    simp only [hgV, RingHom.comp_apply, RingHom.codRestrict_apply, IsLocalization.lift_eq]
  have hcomap : (IsLocalRing.maximalIdeal V).comap (ψ₁.codRestrict V hV) = 𝔮 := by
    rw [hfac, ← Ideal.comap_comap, hcomV]
    have := Localization.AtPrime.under_maximalIdeal (I := 𝔮)
    rwa [Ideal.under_def] at this

  letI : Algebra R V := (ψ₁.codRestrict V hV).toAlgebra
  haveI : HenselianLocalRing V := s3 V (s2 V)
  have hsep : IsSepClosed (IsLocalRing.ResidueField V) := s4 V (s2 V)
  obtain ⟨R', _, σ, ρ, _, hρσ, hhen, hsepR', hloc', hind⟩ := wc_strict_hull R V hsep
  refine ⟨R', inferInstance, hhen, hsepR', σ, (algebraMap V L).comp ρ,
    wc_indEtale_weaklyEtale σ hind, ?_, ?_⟩
  · have h1 := ((IsLocalRing.local_hom_TFAE ρ).out 1 5).mp hloc'
    rw [← h1, Ideal.comap_comap, hρσ, RingHom.algebraMap_toAlgebra]
    exact hcomap
  · rw [RingHom.comp_assoc, hρσ]
    ext r
    rfl

theorem wc_tpa_kummer_cover_regular : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], IsRegularLocalRing A → ∀ (f : A), f ∈ IsLocalRing.maximalIdeal A → f ∉ IsLocalRing.maximalIdeal A ^ 2 → IsDomain (A ⧸ Ideal.span {f}) → IsRegularLocalRing (A ⧸ Ideal.span {f}) → ∀ (e : ℕ), 0 < e → IsNoetherianRing (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) ∧ ∃ (_ : HenselianLocalRing (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f))), IsSepClosed (IsLocalRing.ResidueField (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f))) ∧ IsRegularLocalRing (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) ∧ IsDomain (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) ∧ AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f) ∈ IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) ∧ AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f) ∉ IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) ^ 2 ∧ (Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f)}).IsPrime :=
by
  intro H _ _ _ _ _ hregH φ hφm hφm2 hdomf hregf N hN
  classical
  have hNne : N ≠ 0 := hN.ne'
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact hφm2 (Ideal.zero_mem _)
  generalize hf : Polynomial.X ^ N - Polynomial.C φ = f
  have hmon : f.Monic := by rw [← hf]; exact Polynomial.monic_X_pow_sub_C φ hNne
  haveI hfin : Module.Finite H (AdjoinRoot f) := hmon.finite_adjoinRoot
  haveI : Module.Free H (AdjoinRoot f) := Module.Free.of_basis (AdjoinRoot.powerBasis' hmon).basis
  haveI hnoeth : IsNoetherianRing (AdjoinRoot f) := IsNoetherianRing.of_finite H (AdjoinRoot f)

  have hθN : AdjoinRoot.root f ^ N = AdjoinRoot.of f φ := by
    have h0 : AdjoinRoot.mk f (Polynomial.X ^ N - Polynomial.C φ) = 0 := by
      rw [hf]; exact AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    exact h0

  have hdec : ∀ g : Polynomial H, AdjoinRoot.mk f g =
      AdjoinRoot.root f * AdjoinRoot.mk f g.divX + AdjoinRoot.of f (g.coeff 0) := by
    intro g
    conv_lhs => rw [← Polynomial.X_mul_divX_add g]
    rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
  have hdec' : ∀ r : AdjoinRoot f, ∃ y c, r = AdjoinRoot.root f * y + AdjoinRoot.of f c := by
    intro r
    obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective r
    exact ⟨_, _, hdec g⟩

  have hres0 : IsLocalRing.residue H φ = 0 := (IsLocalRing.residue_eq_zero_iff φ).mpr hφm
  obtain ⟨ρ, hρof, hρθ⟩ : ∃ ρ : AdjoinRoot f →+* IsLocalRing.ResidueField H,
      (∀ a, ρ (AdjoinRoot.of f a) = IsLocalRing.residue H a) ∧ ρ (AdjoinRoot.root f) = 0 := by
    have h : Polynomial.eval₂ (IsLocalRing.residue H) 0 f = 0 := by
      rw [← hf]; simp [hres0, zero_pow hNne]
    exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
  have hρsurj : Function.Surjective ρ := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨_, hρof a⟩
  have hM0 : (RingHom.ker ρ).IsMaximal := RingHom.ker_isMaximal_of_surjective ρ hρsurj
  have hρker : ∀ y c, AdjoinRoot.root f * y + AdjoinRoot.of f c ∈ RingHom.ker ρ ↔
      c ∈ IsLocalRing.maximalIdeal H := by
    intro y c
    rw [RingHom.mem_ker, map_add, map_mul, hρθ, zero_mul, zero_add, hρof,
      IsLocalRing.residue_eq_zero_iff]

  haveI : Algebra.IsIntegral H (AdjoinRoot f) := Algebra.IsIntegral.of_finite H _
  have hint : (algebraMap H (AdjoinRoot f)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  have hmaxQ : ∀ Q : Ideal (AdjoinRoot f), Q.IsMaximal → RingHom.ker ρ ≤ Q := by
    intro Q hQ
    have hcQ : Q.comap (algebraMap H (AdjoinRoot f)) = IsLocalRing.maximalIdeal H :=
      IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint Q)
    have hofQ : ∀ c ∈ IsLocalRing.maximalIdeal H, AdjoinRoot.of f c ∈ Q := by
      intro c hc
      rw [← hcQ, Ideal.mem_comap, AdjoinRoot.algebraMap_eq] at hc
      exact hc
    have hθQ : AdjoinRoot.root f ∈ Q :=
      hQ.isPrime.mem_of_pow_mem N (by rw [hθN]; exact hofQ φ hφm)
    intro r hr
    obtain ⟨y, c, rfl⟩ := hdec' r
    exact Q.add_mem (Q.mul_mem_right _ hθQ) (hofQ c ((hρker y c).mp hr))
  haveI hloc : IsLocalRing (AdjoinRoot f) :=
    IsLocalRing.of_unique_max_ideal
      ⟨RingHom.ker ρ, hM0, fun Q hQ => (hM0.eq_of_le hQ.ne_top (hmaxQ Q hQ)).symm⟩
  have hMker : RingHom.ker ρ = IsLocalRing.maximalIdeal (AdjoinRoot f) :=
    IsLocalRing.eq_maximalIdeal hM0
  have hMform : ∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∃ y c,
      c ∈ IsLocalRing.maximalIdeal H ∧ r = AdjoinRoot.root f * y + AdjoinRoot.of f c := by
    intro r hr
    obtain ⟨y, c, rfl⟩ := hdec' r
    rw [← hMker] at hr
    exact ⟨y, c, (hρker y c).mp hr, rfl⟩
  have hθM : AdjoinRoot.root f ∈ IsLocalRing.maximalIdeal (AdjoinRoot f) := by
    rw [← hMker, RingHom.mem_ker]; exact hρθ

  have hM2 : ∀ (T : Type u) [CommRing T] (F : AdjoinRoot f →+* T),
      (∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∀ s ∈ IsLocalRing.maximalIdeal (AdjoinRoot f),
        F r * F s = 0) →
      F (AdjoinRoot.root f) ≠ 0 → AdjoinRoot.root f ∉ IsLocalRing.maximalIdeal (AdjoinRoot f) ^ 2 := by
    intro T _ F hprod hFθ hθ2
    apply hFθ
    have hle : IsLocalRing.maximalIdeal (AdjoinRoot f) ^ 2 ≤ RingHom.ker F := by
      rw [pow_two, Ideal.mul_le]
      intro r hr s hs
      rw [RingHom.mem_ker, map_mul]
      exact hprod r hr s hs
    exact hle hθ2
  have hθM2 : AdjoinRoot.root f ∉ IsLocalRing.maximalIdeal (AdjoinRoot f) ^ 2 := by
    rcases Nat.lt_or_ge 1 N with h2 | h1
    · have hε : (DualNumber.eps : DualNumber (IsLocalRing.ResidueField H)) ^ N = 0 := by
        have hN2 : N = (N - 2) + 2 := by omega
        rw [hN2, pow_add, pow_two, DualNumber.eps_mul_eps, mul_zero]
      obtain ⟨F, hFof, hFθ⟩ : ∃ F : AdjoinRoot f →+* DualNumber (IsLocalRing.ResidueField H),
          (∀ a, F (AdjoinRoot.of f a) = algebraMap _ _ (IsLocalRing.residue H a)) ∧
            F (AdjoinRoot.root f) = DualNumber.eps := by
        have h : Polynomial.eval₂ ((algebraMap (IsLocalRing.ResidueField H)
            (DualNumber (IsLocalRing.ResidueField H))).comp (IsLocalRing.residue H))
            DualNumber.eps f = 0 := by
          rw [← hf]; simp [hε, hres0]
        exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
      have hFM : ∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∃ t, F r = DualNumber.eps * t := by
        intro r hr
        obtain ⟨y, c, hc, rfl⟩ := hMform r hr
        refine ⟨F y, ?_⟩
        rw [map_add, map_mul, hFθ, hFof, (IsLocalRing.residue_eq_zero_iff c).mpr hc, map_zero,
          add_zero]
      refine hM2 _ F ?_ ?_
      · intro r hr s hs
        obtain ⟨t, ht⟩ := hFM r hr
        obtain ⟨t', ht'⟩ := hFM s hs
        rw [ht, ht', mul_mul_mul_comm, DualNumber.eps_mul_eps, zero_mul]
      · rw [hFθ]
        intro h0
        have := congrArg TrivSqZeroExt.snd h0
        rw [DualNumber.snd_eps, TrivSqZeroExt.snd_zero] at this
        exact one_ne_zero this
    · have hN1 : N = 1 := by omega
      subst hN1
      obtain ⟨F, hFof, hFθ⟩ : ∃ F : AdjoinRoot f →+* (H ⧸ IsLocalRing.maximalIdeal H ^ 2),
          (∀ a, F (AdjoinRoot.of f a) = Ideal.Quotient.mk _ a) ∧
            F (AdjoinRoot.root f) = Ideal.Quotient.mk _ φ := by
        have h : Polynomial.eval₂ (Ideal.Quotient.mk (IsLocalRing.maximalIdeal H ^ 2))
            (Ideal.Quotient.mk _ φ) f = 0 := by
          rw [← hf]; simp
        exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
      have hFM : ∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∃ a ∈ IsLocalRing.maximalIdeal H,
          F r = Ideal.Quotient.mk _ a := by
        intro r hr
        obtain ⟨y, c, hc, rfl⟩ := hMform r hr
        obtain ⟨y', hy'⟩ := Ideal.Quotient.mk_surjective (F y)
        refine ⟨φ * y' + c, (IsLocalRing.maximalIdeal H).add_mem
          ((IsLocalRing.maximalIdeal H).mul_mem_right _ hφm) hc, ?_⟩
        rw [map_add, map_mul, hFθ, hFof, ← hy', map_add, map_mul]
      refine hM2 _ F ?_ ?_
      · intro r hr s hs
        obtain ⟨a, ha, h1⟩ := hFM r hr
        obtain ⟨b, hb, h2⟩ := hFM s hs
        rw [h1, h2, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
        exact Ideal.mul_mem_mul ha hb
      · rw [hFθ]
        intro h0
        exact hφm2 (Ideal.Quotient.eq_zero_iff_mem.mp h0)

  obtain ⟨n, ei, hidem, -, hsum, hloc_e⟩ :=
    wc_strictHensel_finite_idem_decomp H (AdjoinRoot f) hfin
  have h01 : ∀ i, ei i = 0 ∨ ei i = 1 := by
    intro i
    have h := (hidem i).eq
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (ei i) with hu | hu
    · right
      exact hu.mul_left_cancel (h.trans (mul_one _).symm)
    · left
      exact hu.mul_left_cancel (by rw [sub_mul, one_mul, h, sub_self, mul_zero])
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ) (f := ei)
    (by rw [hsum]; exact one_ne_zero)
  have hu : IsUnit (ei i) := by
    rcases h01 i with h | h
    · exact absurd h hi
    · rw [h]; exact isUnit_one
  obtain ⟨hhens_i, hsep_i, -⟩ := hloc_e i
  let E : AdjoinRoot f ≃+* Localization.Away (ei i) :=
    (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away (ei i)) (ei i) hu).toRingEquiv
  have hhens : HenselianLocalRing (AdjoinRoot f) :=
    wc_henselian_sepClosed_transfer.1 _ _ E.symm hhens_i
  have hsep : IsSepClosed (IsLocalRing.ResidueField (AdjoinRoot f)) :=
    wc_henselian_sepClosed_transfer.2 _ _ (IsLocalRing.ResidueField.mapEquiv E.symm) hsep_i

  obtain ⟨π, hπof, hπθ⟩ : ∃ π : AdjoinRoot f →+* (H ⧸ Ideal.span {φ}),
      (∀ a, π (AdjoinRoot.of f a) = Ideal.Quotient.mk _ a) ∧ π (AdjoinRoot.root f) = 0 := by
    have hφJ : Ideal.Quotient.mk (Ideal.span {φ}) φ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self φ)
    have h : Polynomial.eval₂ (Ideal.Quotient.mk (Ideal.span {φ})) 0 f = 0 := by
      rw [← hf]; simp [hφJ, zero_pow hNne]
    exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
  have hπsurj : Function.Surjective π := by
    intro z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨_, hπof a⟩
  have hker : Ideal.span {AdjoinRoot.root f} = RingHom.ker π := by
    apply le_antisymm
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]; exact hπθ
    · intro r hr
      obtain ⟨y, c, rfl⟩ := hdec' r
      rw [RingHom.mem_ker, map_add, map_mul, hπθ, zero_mul, zero_add, hπof,
        Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hr
      obtain ⟨d, rfl⟩ := hr
      rw [Ideal.mem_span_singleton']
      refine ⟨y + AdjoinRoot.of f d * AdjoinRoot.root f ^ (N - 1), ?_⟩
      rw [map_mul, ← hθN, ← pow_sub_one_mul hNne]
      ring
  let φe : (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) ≃+* (H ⧸ Ideal.span {φ}) :=
    (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hπsurj)

  haveI := hregf
  haveI : IsLocalRing (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) := φe.symm.isLocalRing
  have hmapmax : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (g : A ≃+* B), Ideal.map g.toRingHom (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B := by
    intro A B _ _ _ _ g
    apply IsLocalRing.eq_maximalIdeal
    exact Ideal.map_isMaximal_of_equiv g
  have hregR : IsRegularLocalRing (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) := by
    have hle1 := Ideal.spanFinrank_map_le_of_fg φe.symm.toRingHom
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal (H ⧸ Ideal.span {φ})))
    have hle2 := Ideal.spanFinrank_map_le_of_fg φe.toRingHom
      (IsNoetherian.noetherian
        (IsLocalRing.maximalIdeal (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f})))
    rw [hmapmax _ _ φe.symm] at hle1
    rw [hmapmax _ _ φe] at hle2
    refine IsRegularLocalRing.mk ?_
    rw [le_antisymm hle1 hle2, ringKrullDim_eq_of_ringEquiv φe]
    exact IsRegularLocalRing.spanFinrank_maximalIdeal
  have hdimR : ringKrullDim (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) =
      ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (H ⧸ Ideal.span {φ})) : ℕ) : WithBot ℕ∞) :=
    (ringKrullDim_eq_of_ringEquiv φe).trans IsRegularLocalRing.spanFinrank_maximalIdeal.symm

  have hnzd : AdjoinRoot.root f ∈ nonZeroDivisors (AdjoinRoot f) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have hx' : x * AdjoinRoot.root f = 0 := by
      first
        | exact hx
        | (rw [mul_comm]; exact hx)
    have h0 : φ • x = 0 := by
      calc φ • x = AdjoinRoot.root f ^ (N - 1) * (x * AdjoinRoot.root f) := by
            rw [Algebra.smul_def, AdjoinRoot.algebraMap_eq, ← hθN, ← pow_sub_one_mul hNne]
            ring
        _ = 0 := by rw [hx', mul_zero]
    exact (smul_eq_zero.mp h0).resolve_left hφ0

  obtain ⟨hreg, -⟩ := wc_odp_regular_lift_nzd (AdjoinRoot f) (AdjoinRoot.root f) _ hθM hnzd
    hregR hdimR
  have hdom : IsDomain (AdjoinRoot f) := (@wc_fco_regular_local_ufd (AdjoinRoot f) _ hreg).1
  haveI := hdomf
  haveI : IsDomain (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) :=
    MulEquiv.isDomain (H ⧸ Ideal.span {φ}) φe.toMulEquiv
  have hprime : (Ideal.span {AdjoinRoot.root f}).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
  exact ⟨hnoeth, hhens, hsep, hreg, hdom, hθM, hθM2, hprime⟩

theorem wc_tpa_trait_root : ∀ (A A' L : Type u) [CommRing A] [CommRing A'] [IsDomain A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] [Field L], IsDiscreteValuationRing A' → ∀ (α' : A →+* A'), @Algebra.WeaklyEtale A A' _ _ α'.toAlgebra → ∀ (f : A), Ideal.span {α' f} = IsLocalRing.maximalIdeal A' → (IsLocalRing.maximalIdeal A').comap α' = Ideal.span {f} → ∀ (e : ℕ), 0 < e → IsUnit (e : A') → ∀ (ψ' : A' →+* L) (t : L), t ^ e = ψ' (α' f) → ∃ (B : Type u) (_ : CommRing B) (_ : HenselianLocalRing B) (_ : IsSepClosed (IsLocalRing.ResidueField B)) (α : AdjoinRoot (Polynomial.X ^ e - Polynomial.C f) →+* B) (β : B →+* L) (ι : A' →+* B), @Algebra.WeaklyEtale (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f)) B _ _ α.toAlgebra ∧ (IsLocalRing.maximalIdeal B).comap α = Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f)} ∧ (β.comp α).comp (AdjoinRoot.of _) = ψ'.comp α' ∧ β (α (AdjoinRoot.root _)) = t ∧ β.comp ι = ψ' :=
by
  intro A A' L _ _ _ _ _ _ _ α' hα' f hspan hcomap e he _ ψ' t ht

  have c1 : ∀ (R S S' : Type u) [CommRing R] [CommRing S] [CommRing S'] [Algebra R S] [Algebra R S'],
      Algebra.WeaklyEtale R S → (S ≃ₐ[R] S') → Algebra.WeaklyEtale R S' := by
    intro R S S' _ _ _ _ _ h e
    haveI := h.flat
    refine @Algebra.WeaklyEtale.mk R S' _ _ _ (Module.Flat.of_linearEquiv e.symm.toLinearEquiv) ?_
    have hl := Algebra.WeaklyEtale.flat_lmul' R S
    let E : TensorProduct R S' S' ≃ₐ[R] TensorProduct R S S := Algebra.TensorProduct.congr e.symm e.symm
    have key : (Algebra.TensorProduct.lmul' R (S := S')) =
        (e.toAlgHom.comp (Algebra.TensorProduct.lmul' R (S := S))).comp E.toAlgHom := by
      apply Algebra.TensorProduct.ext'
      intro a b
      simp [E, Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.lmul'_apply_tmul]
    rw [key]
    exact RingHom.Flat.comp (RingHom.Flat.of_bijective (f := E.toAlgHom.toRingHom) E.bijective)
      (RingHom.Flat.comp hl (RingHom.Flat.of_bijective (f := e.toAlgHom.toRingHom) e.bijective))

  have c2 : ∀ (p : Polynomial A) (q : Polynomial A'), p.map α' = q →
      ∃ α : AdjoinRoot p →+* AdjoinRoot q,
        (∀ a, α (AdjoinRoot.of p a) = AdjoinRoot.of q (α' a)) ∧
        α (AdjoinRoot.root p) = AdjoinRoot.root q ∧
        @Algebra.WeaklyEtale (AdjoinRoot p) (AdjoinRoot q) _ _ α.toAlgebra := by
    intro p q hpq
    letI : Algebra A A' := α'.toAlgebra
    haveI := hα'
    let α := AdjoinRoot.map α' p q (hpq ▸ dvd_refl _)
    have hαof : ∀ a, α (AdjoinRoot.of p a) = AdjoinRoot.of q (α' a) := fun a =>
      AdjoinRoot.map_of _ _ _ _ a
    have hαroot : α (AdjoinRoot.root p) = AdjoinRoot.root q := AdjoinRoot.map_root _ _ _ _
    refine ⟨α, hαof, hαroot, ?_⟩
    letI : Algebra (AdjoinRoot p) (AdjoinRoot q) := α.toAlgebra
    have halg : ∀ a : A, algebraMap A (AdjoinRoot q) a = AdjoinRoot.of q (α' a) := fun a => rfl
    haveI : IsScalarTower A (AdjoinRoot p) (AdjoinRoot q) :=
      IsScalarTower.of_algebraMap_eq (fun a => by rw [halg]; exact (hαof a).symm)
    let g : A' →ₐ[A] AdjoinRoot q :=
      { AdjoinRoot.of q with commutes' := fun a => (halg a).symm }
    let Φ : TensorProduct A (AdjoinRoot p) A' →ₐ[AdjoinRoot p] AdjoinRoot q :=
      Algebra.TensorProduct.lift (Algebra.ofId (AdjoinRoot p) (AdjoinRoot q)) g
        (fun _ _ => Commute.all _ _)
    have hΦ : ∀ x y, Φ (x ⊗ₜ y) = α x * AdjoinRoot.of q y := fun x y =>
      Algebra.TensorProduct.lift_tmul _ _ _ x y
    have hcompat : ∀ a : A,
        (1 : AdjoinRoot p) ⊗ₜ[A] (α' a) = (AdjoinRoot.of p a) ⊗ₜ[A] (1 : A') := by
      intro a
      change (1 : AdjoinRoot p) ⊗ₜ[A] (algebraMap A A' a) =
        (algebraMap A (AdjoinRoot p) a) ⊗ₜ[A] (1 : A')
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    have hcompat' : (Algebra.TensorProduct.includeRight.toRingHom :
        A' →+* TensorProduct A (AdjoinRoot p) A').comp α' =
        (Algebra.TensorProduct.includeLeftRingHom).comp (AdjoinRoot.of p) := by
      refine RingHom.ext fun a => ?_
      exact hcompat a
    have hev : Polynomial.eval₂ (Algebra.TensorProduct.includeRight.toRingHom :
        A' →+* TensorProduct A (AdjoinRoot p) A') (AdjoinRoot.root p ⊗ₜ 1) q = 0 := by
      rw [← hpq, Polynomial.eval₂_map, hcompat']
      have := Polynomial.hom_eval₂ p (AdjoinRoot.of p)
        (Algebra.TensorProduct.includeLeftRingHom :
          AdjoinRoot p →+* TensorProduct A (AdjoinRoot p) A')
        (AdjoinRoot.root p)
      rw [AdjoinRoot.eval₂_root, map_zero] at this
      exact this.symm
    obtain ⟨Ψ, hΨof, hΨroot⟩ : ∃ Ψ : AdjoinRoot q →+* TensorProduct A (AdjoinRoot p) A',
        (∀ y, Ψ (AdjoinRoot.of q y) = 1 ⊗ₜ y) ∧ Ψ (AdjoinRoot.root q) = AdjoinRoot.root p ⊗ₜ 1 :=
      ⟨AdjoinRoot.lift _ _ hev, fun y => AdjoinRoot.lift_of hev, AdjoinRoot.lift_root hev⟩
    have hΨα : ∀ x, Ψ (α x) = x ⊗ₜ 1 := by
      have : Ψ.comp α = Algebra.TensorProduct.includeLeftRingHom := by
        apply AdjoinRoot.ringHom_ext
        · refine RingHom.ext fun a => ?_
          simp only [RingHom.comp_apply, hαof, hΨof]
          exact hcompat a
        · simp only [RingHom.comp_apply, hαroot, hΨroot]
          rfl
      intro x
      exact RingHom.congr_fun this x
    have h1 : (Φ : TensorProduct A (AdjoinRoot p) A' →+* AdjoinRoot q).comp Ψ = RingHom.id _ := by
      apply AdjoinRoot.ringHom_ext
      · refine RingHom.ext fun y => ?_
        simp only [RingHom.comp_apply, RingHom.coe_coe, hΨof, hΦ, map_one, one_mul,
          RingHom.id_apply]
      · simp only [RingHom.comp_apply, RingHom.coe_coe, hΨroot, hΦ, hαroot, map_one, mul_one,
          RingHom.id_apply]
    have h2 : Ψ.comp (Φ : TensorProduct A (AdjoinRoot p) A' →+* AdjoinRoot q) = RingHom.id _ := by
      apply Algebra.TensorProduct.ringHom_ext
      · refine RingHom.ext fun x => ?_
        simp only [RingHom.comp_apply, RingHom.coe_coe,
          Algebra.TensorProduct.includeLeftRingHom_apply, hΦ, map_one, mul_one, RingHom.id_apply]
        exact hΨα x
      · refine RingHom.ext fun y => ?_
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply, hΦ, map_one, one_mul, hΨof, RingHom.id_apply]
    let Θ : TensorProduct A (AdjoinRoot p) A' ≃ₐ[AdjoinRoot p] AdjoinRoot q :=
      AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom (Φ : _ →+* _) Ψ h1 h2)
        (fun x => by rw [← Φ.commutes x]; rfl)
    have hW : Algebra.WeaklyEtale (AdjoinRoot p) (TensorProduct A (AdjoinRoot p) A') :=
      Algebra.WeaklyEtale.instTensorProduct
    exact c1 (AdjoinRoot p) (TensorProduct A (AdjoinRoot p) A') (AdjoinRoot q) hW Θ

  have c3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (w : R),
      Ideal.span {w} = IsLocalRing.maximalIdeal R →
      ∃ (_ : IsLocalRing (AdjoinRoot (Polynomial.X ^ e - Polynomial.C w))),
        IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ e - Polynomial.C w)) =
          Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C w)} := by
    intro R _ _ w hw
    have hθe : AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C w) ^ e = AdjoinRoot.of _ w := by
      have := AdjoinRoot.eval₂_root (Polynomial.X ^ e - Polynomial.C w)
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at this
      exact sub_eq_zero.mp this
    have hθe' : AdjoinRoot.of (Polynomial.X ^ e - Polynomial.C w) w =
        AdjoinRoot.root _ ^ (e - 1) * AdjoinRoot.root _ := by
      rw [← pow_succ, Nat.sub_add_cancel he, hθe]
    have hwm : w ∈ IsLocalRing.maximalIdeal R := hw ▸ Ideal.mem_span_singleton_self w
    have h0 : Polynomial.eval₂ (IsLocalRing.residue R) 0
        (Polynomial.X ^ e - Polynomial.C w) = 0 := by
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, zero_pow he.ne',
        (IsLocalRing.residue_eq_zero_iff w).mpr hwm, sub_zero]
    obtain ⟨φ, hφof, hφroot⟩ : ∃ φ : AdjoinRoot (Polynomial.X ^ e - Polynomial.C w) →+*
        IsLocalRing.ResidueField R,
        (∀ r, φ (AdjoinRoot.of _ r) = IsLocalRing.residue R r) ∧ φ (AdjoinRoot.root _) = 0 :=
      ⟨AdjoinRoot.lift _ _ h0, fun r => AdjoinRoot.lift_of h0, AdjoinRoot.lift_root h0⟩
    have hφsurj : Function.Surjective φ := by
      intro y
      obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective y
      exact ⟨AdjoinRoot.of _ r, hφof r⟩
    have hdecomp : ∀ x : AdjoinRoot (Polynomial.X ^ e - Polynomial.C w),
        ∃ y c, x = y * AdjoinRoot.root _ + AdjoinRoot.of _ c := by
      intro x
      obtain ⟨Q, rfl⟩ := AdjoinRoot.mk_surjective x
      refine ⟨AdjoinRoot.mk _ Q.divX, Q.coeff 0, ?_⟩
      conv_lhs => rw [← Polynomial.divX_mul_X_add Q]
      rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
    have hker : RingHom.ker φ =
        Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C w)} := by
      apply le_antisymm
      · intro x hx
        obtain ⟨y, c, rfl⟩ := hdecomp x
        rw [RingHom.mem_ker, map_add, map_mul, hφroot, mul_zero, zero_add, hφof] at hx
        have hc : c ∈ Ideal.span {w} := hw ▸ (IsLocalRing.residue_eq_zero_iff c).mp hx
        obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp hc
        rw [Ideal.mem_span_singleton']
        refine ⟨y + AdjoinRoot.of _ d * AdjoinRoot.root _ ^ (e - 1), ?_⟩
        rw [map_mul, hθe']
        ring
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hφroot
    have hmax : (Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C w)}).IsMaximal :=
      hker ▸ RingHom.ker_isMaximal_of_surjective φ hφsurj
    haveI : Module.Finite R (AdjoinRoot (Polynomial.X ^ e - Polynomial.C w)) :=
      (AdjoinRoot.powerBasis' (Polynomial.monic_X_pow_sub_C w he.ne')).finite
    haveI : Algebra.IsIntegral R (AdjoinRoot (Polynomial.X ^ e - Polynomial.C w)) :=
      Algebra.IsIntegral.of_finite R _
    have huniq : ∀ M : Ideal (AdjoinRoot (Polynomial.X ^ e - Polynomial.C w)), M.IsMaximal →
        M = Ideal.span {AdjoinRoot.root _} := by
      intro M hM
      haveI := hM
      have hum : Ideal.under R M = IsLocalRing.maximalIdeal R :=
        IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under R M)
      have hwM : AdjoinRoot.of (Polynomial.X ^ e - Polynomial.C w) w ∈ M := by
        have : w ∈ Ideal.under R M := hum ▸ hwm
        exact this
      rw [← hθe] at hwM
      have hθM := hM.isPrime.mem_of_pow_mem e hwM
      exact (hmax.eq_of_le hM.ne_top ((Ideal.span_singleton_le_iff_mem _).mpr hθM)).symm
    haveI hloc : IsLocalRing (AdjoinRoot (Polynomial.X ^ e - Polynomial.C w)) :=
      IsLocalRing.of_unique_max_ideal ⟨_, hmax, fun M hM => huniq M hM⟩
    exact ⟨hloc, (IsLocalRing.eq_maximalIdeal hmax).symm⟩

  have c4 : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)]
      (S : Type u) [CommRing S] [IsLocalRing S] [Algebra R S], Module.Finite R S →
      HenselianLocalRing S ∧ IsSepClosed (IsLocalRing.ResidueField S) := by
    intro R _ _ _ S _ _ _ hfin
    obtain ⟨n, ε, hid, -, hsum, hloc⟩ := wc_strictHensel_finite_idem_decomp R S hfin
    have h01 : ∀ i, ε i = 0 ∨ ε i = 1 := by
      intro i
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (ε i) with hu | hu
      · right
        exact hu.mul_left_cancel (by rw [(hid i).eq, mul_one])
      · left
        have h : ε i * (1 - ε i) = 0 := by rw [mul_sub, mul_one, (hid i).eq, sub_self]
        exact hu.mul_left_eq_zero.mp h
    have hne : ∑ i, ε i ≠ 0 := by rw [hsum]; exact one_ne_zero
    obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    have hi1 : ε i = 1 := (h01 i).resolve_left hi
    have hu : IsUnit (ε i) := hi1 ▸ isUnit_one
    obtain ⟨hH, hsep, -⟩ := hloc i
    let Θ := IsLocalization.atUnit S (Localization.Away (ε i)) (ε i) hu
    haveI := hH
    refine ⟨wc_henselian_sepClosed_transfer.1 _ _ Θ.symm.toRingEquiv hH, ?_⟩
    exact wc_henselian_sepClosed_transfer.2 _ _
      (IsLocalRing.ResidueField.mapEquiv Θ.symm.toRingEquiv) hsep

  have c5 : (Ideal.span {α' f}).comap α' = Ideal.span {f} →
      ∀ (α : AdjoinRoot (Polynomial.X ^ e - Polynomial.C f) →+*
        AdjoinRoot (Polynomial.X ^ e - Polynomial.C (α' f))),
      (∀ a, α (AdjoinRoot.of _ a) = AdjoinRoot.of _ (α' a)) →
      α (AdjoinRoot.root _) = AdjoinRoot.root _ →
      (Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C (α' f))}).comap α =
        Ideal.span {AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f)} := by
    intro hc α hof hroot
    have hθe : AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f) ^ e = AdjoinRoot.of _ f := by
      have := AdjoinRoot.eval₂_root (Polynomial.X ^ e - Polynomial.C f)
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at this
      exact sub_eq_zero.mp this
    have hθe' : AdjoinRoot.of (Polynomial.X ^ e - Polynomial.C f) f =
        AdjoinRoot.root _ ^ (e - 1) * AdjoinRoot.root _ := by
      rw [← pow_succ, Nat.sub_add_cancel he, hθe]
    have h0 : Polynomial.eval₂ (Ideal.Quotient.mk (Ideal.span {α' f})) 0
        (Polynomial.X ^ e - Polynomial.C (α' f)) = 0 := by
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, zero_pow he.ne',
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), sub_zero]
    obtain ⟨φ, hφof, hφroot⟩ : ∃ φ : AdjoinRoot (Polynomial.X ^ e - Polynomial.C (α' f)) →+*
        A' ⧸ Ideal.span {α' f},
        (∀ r, φ (AdjoinRoot.of _ r) = Ideal.Quotient.mk _ r) ∧ φ (AdjoinRoot.root _) = 0 :=
      ⟨AdjoinRoot.lift _ _ h0, fun r => AdjoinRoot.lift_of h0, AdjoinRoot.lift_root h0⟩
    apply le_antisymm
    · intro x hx
      rw [Ideal.mem_comap] at hx
      obtain ⟨Q, rfl⟩ := AdjoinRoot.mk_surjective x
      have hQ : AdjoinRoot.mk (Polynomial.X ^ e - Polynomial.C f) Q =
          AdjoinRoot.mk _ Q.divX * AdjoinRoot.root _ + AdjoinRoot.of _ (Q.coeff 0) := by
        conv_lhs => rw [← Polynomial.divX_mul_X_add Q]
        rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      rw [hQ] at hx ⊢
      rw [map_add, map_mul, hroot, hof] at hx
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hx
      have hφ := congrArg φ hz
      simp only [map_mul, map_add, hφroot, mul_zero, zero_add, hφof] at hφ
      have hmem : α' (Q.coeff 0) ∈ Ideal.span {α' f} :=
        Ideal.Quotient.eq_zero_iff_mem.mp hφ.symm
      have hmem' : Q.coeff 0 ∈ Ideal.span {f} := hc ▸ (Ideal.mem_comap.mpr hmem)
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hmem'
      rw [Ideal.mem_span_singleton']
      refine ⟨AdjoinRoot.mk _ Q.divX + AdjoinRoot.of _ d * AdjoinRoot.root _ ^ (e - 1), ?_⟩
      rw [← hd, map_mul, hθe']
      ring
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, hroot]
      exact Ideal.mem_span_singleton_self _

  have hpq : (Polynomial.X ^ e - Polynomial.C f).map α' =
      Polynomial.X ^ e - Polynomial.C (α' f) := by
    simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  obtain ⟨α, hαof, hαroot, hαwe⟩ := c2 _ _ hpq
  have hspan' : (Ideal.span {α' f}).comap α' = Ideal.span {f} := by rw [hspan]; exact hcomap
  obtain ⟨hloc, hmax⟩ := c3 A' (α' f) hspan
  haveI := hloc
  have hfin : Module.Finite A' (AdjoinRoot (Polynomial.X ^ e - Polynomial.C (α' f))) :=
    (AdjoinRoot.powerBasis' (Polynomial.monic_X_pow_sub_C (α' f) he.ne')).finite
  obtain ⟨hH, hsep⟩ := c4 A' _ hfin
  have hev : Polynomial.eval₂ ψ' t (Polynomial.X ^ e - Polynomial.C (α' f)) = 0 := by
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, ht, sub_self]
  refine ⟨AdjoinRoot (Polynomial.X ^ e - Polynomial.C (α' f)), inferInstance, hH, hsep, α,
    AdjoinRoot.lift ψ' t hev, AdjoinRoot.of _, hαwe, ?_, ?_, ?_, ?_⟩
  · rw [hmax]
    exact c5 hspan' α hαof hαroot
  · refine RingHom.ext fun a => ?_
    simp only [RingHom.comp_apply, hαof, AdjoinRoot.lift_of]
  · rw [hαroot, AdjoinRoot.lift_root]
  · exact AdjoinRoot.lift_comp_of hev

theorem wc_tpa_weaklyEtale_off_root : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A) (e : ℕ), 0 < e → IsUnit (e : A) → ∀ (α : AdjoinRoot (Polynomial.X ^ e - Polynomial.C f) →+* B), @Algebra.WeaklyEtale _ B _ _ α.toAlgebra → IsUnit (α (AdjoinRoot.root _)) → @Algebra.WeaklyEtale A B _ _ (α.comp (AdjoinRoot.of _)).toAlgebra :=
by
  intro A B _ _ f e he hu α hwe hθ

  have s1 : Algebra.Etale A
      (Localization.Away (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f))) := by
    obtain ⟨u, hu'⟩ : ∃ u : A, (e : A) * u = 1 := ⟨_, hu.mul_val_inv⟩
    have hcond : Polynomial.derivative (Polynomial.X ^ e - Polynomial.C f) *
        (Polynomial.C u * Polynomial.X) + (Polynomial.X ^ e - Polynomial.C f) * 0 =
        (Polynomial.X : Polynomial A) ^ e := by
      obtain ⟨k, rfl⟩ : ∃ k, e = k + 1 := ⟨e - 1, by omega⟩
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, mul_zero, add_zero]
      have hC : Polynomial.C ((↑(k + 1) : A) * u) = 1 := by rw [hu', Polynomial.C_1]
      calc Polynomial.C ((↑(k + 1) : A)) * Polynomial.X ^ (k + 1 - 1) *
            (Polynomial.C u * Polynomial.X)
          = Polynomial.C ((↑(k + 1) : A) * u) * Polynomial.X ^ (k + 1) := by
            rw [Polynomial.C_mul, Nat.add_sub_cancel, pow_succ]; ring
        _ = Polynomial.X ^ (k + 1) := by rw [hC, one_mul]
    let P : StandardEtalePair A :=
      { f := Polynomial.X ^ e - Polynomial.C f
        monic_f := Polynomial.monic_X_pow_sub_C f he.ne'
        g := Polynomial.X
        cond := ⟨Polynomial.C u * Polynomial.X, 0, e, hcond⟩ }
    exact Algebra.Etale.of_equiv P.equivAwayAdjoinRoot

  have s2 : ∀ (R : Type u) [CommRing R] (s : R) (α : R →+* B) (hs : IsUnit (α s)),
      @Algebra.WeaklyEtale R B _ _ α.toAlgebra →
      @Algebra.WeaklyEtale (Localization.Away s) B _ _
        (Localization.awayLift α s hs).toAlgebra := by
    intro R _ s α hs h
    letI := α.toAlgebra
    letI := (Localization.awayLift α s hs).toAlgebra
    haveI : IsScalarTower R (Localization.Away s) B :=
      IsScalarTower.of_algebraMap_eq' (IsLocalization.Away.lift_comp s hs).symm
    have hflat : Module.Flat (Localization.Away s) B :=
      (Module.flat_iff_of_isLocalization (Localization.Away s) (Submonoid.powers s) B).mpr h.flat
    haveI : TensorProduct.CompatibleSMul R (Localization.Away s) B B :=
      IsLocalization.tensorProduct_compatibleSMul (Submonoid.powers s) _ B B
    let E := Algebra.TensorProduct.equivOfCompatibleSMul R (Localization.Away s)
      (Localization.Away s) B B
    have hfac : (Algebra.TensorProduct.lmul' (Localization.Away s) :
          TensorProduct (Localization.Away s) B B →ₐ[Localization.Away s] B).toRingHom =
        (Algebra.TensorProduct.lmul' R : TensorProduct R B B →ₐ[R] B).toRingHom.comp
          (E : TensorProduct (Localization.Away s) B B →+* TensorProduct R B B) := by
      refine RingHom.ext fun x => ?_
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_comp, RingHom.coe_coe,
          Function.comp_apply, Algebra.TensorProduct.lmul'_apply_tmul]
        show _ = Algebra.TensorProduct.lmul' R
          (Algebra.TensorProduct.mapOfCompatibleSMul R (Localization.Away s)
            (Localization.Away s) B B (TensorProduct.tmul (Localization.Away s) a b))
        rw [Algebra.TensorProduct.mapOfCompatibleSMul_tmul,
          Algebra.TensorProduct.lmul'_apply_tmul]
      | add x y hx hy => simp only [map_add] at *; rw [hx, hy]
    refine (Algebra.weaklyEtale_iff (Localization.Away s) B).mpr ⟨hflat, ?_⟩
    show RingHom.Flat (Algebra.TensorProduct.lmul' (Localization.Away s) :
      TensorProduct (Localization.Away s) B B →ₐ[Localization.Away s] B).toRingHom
    rw [hfac]
    exact RingHom.Flat.comp (RingHom.Flat.of_bijective E.bijective) h.flat_lmul'

  haveI := s1
  have h2 := s2 _ _ α hθ hwe
  letI := (Localization.awayLift α _ hθ).toAlgebra
  letI := (α.comp (AdjoinRoot.of (Polynomial.X ^ e - Polynomial.C f))).toAlgebra
  haveI : IsScalarTower A
      (Localization.Away (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f))) B := by
    apply IsScalarTower.of_algebraMap_eq'
    show α.comp (AdjoinRoot.of _) = (Localization.awayLift α _ hθ).comp
      (algebraMap A (Localization.Away (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f))))
    rw [IsScalarTower.algebraMap_eq A (AdjoinRoot (Polynomial.X ^ e - Polynomial.C f))
      (Localization.Away (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f))),
      ← RingHom.comp_assoc, Localization.awayLift, IsLocalization.Away.lift_comp,
      AdjoinRoot.algebraMap_eq]
  exact Algebra.WeaklyEtale.trans A
    (Localization.Away (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C f))) B

theorem wc_tpa_restriction_surj : ∀ (L : Type u) [Field L] (K₀ K'' : Subfield L), K₀ ≤ K'' → IsGalois K₀ L → ∀ (K₂ : IntermediateField K₀ L), FiniteDimensional K₀ K₂ → IsGalois K₀ K₂ → Module.finrank K₀ K₂ ≤ Module.finrank K'' (IntermediateField.adjoin K'' (K₂ : Set L)) → ∀ g : L ≃ₐ[K₀] L, ∃ h : L ≃ₐ[K₀] L, (∀ x ∈ K'', h x = x) ∧ ∀ x ∈ K₂, h x = g x :=
by
  classical
  have compositum : ∀ (L : Type u) [Field L] (K₀ K₁ : Subfield L), K₀ ≤ K₁ → IsGalois K₀ L →
      ∀ (K₂ : IntermediateField K₀ L), FiniteDimensional K₀ K₂ → IsGalois K₀ K₂ →
      IsGalois K₁ L ∧ FiniteDimensional K₁ (IntermediateField.adjoin K₁ (K₂ : Set L)) ∧
        IsGalois K₁ (IntermediateField.adjoin K₁ (K₂ : Set L)) := by
    intro L _ K₀ K₁ h hgal K₂ hK₂f hK₂g
    letI : Algebra K₀ K₁ := (Subfield.inclusion h).toAlgebra
    haveI : IsScalarTower K₀ K₁ L := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    have ha : IsGalois K₁ L := IsGalois.tower_top_of_isGalois K₀ K₁ L
    obtain ⟨p, hp, hspl⟩ := IsGalois.is_separable_splitting_field K₀ K₂
    obtain ⟨hK2split, hK2eq⟩ := IntermediateField.isSplittingField_iff.mp hspl
    have hsplitL : (p.map (algebraMap K₀ L)).Splits := by
      rw [IsScalarTower.algebraMap_eq K₀ K₂ L, ← Polynomial.map_map]
      exact hK2split.map _
    set q : Polynomial K₁ := p.map (algebraMap K₀ K₁) with hqdef
    have hq_map : q.map (algebraMap K₁ L) = p.map (algebraMap K₀ L) := by
      rw [hqdef, Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    have hroot : q.rootSet L = p.rootSet L := by
      rw [Polynomial.rootSet_def, Polynomial.rootSet_def, Polynomial.aroots_def,
        Polynomial.aroots_def, hq_map]
    have hq_sep : q.Separable := hp.map
    have hq_split : (q.map (algebraMap K₁ L)).Splits := hq_map ▸ hsplitL
    haveI := IntermediateField.adjoin_rootSet_isSplittingField hq_split
    have hK2set : (K₂ : Set L) = (IntermediateField.adjoin K₀ (p.rootSet L) : Set L) :=
      congrArg (fun F : IntermediateField K₀ L => (F : Set L)) hK2eq
    have heq : IntermediateField.adjoin K₁ (K₂ : Set L) =
        IntermediateField.adjoin K₁ (q.rootSet L) := by
      rw [hroot, hK2set]
      apply le_antisymm
      · rw [IntermediateField.adjoin_le_iff]
        have hle : IntermediateField.adjoin K₀ (p.rootSet L) ≤
            (IntermediateField.adjoin K₁ (p.rootSet L)).restrictScalars K₀ := by
          rw [IntermediateField.adjoin_le_iff]
          exact IntermediateField.subset_adjoin K₁ (p.rootSet L)
        exact hle
      · exact IntermediateField.adjoin.mono K₁ _ _ (IntermediateField.subset_adjoin K₀ _)
    rw [heq]
    exact ⟨ha, Polynomial.IsSplittingField.finiteDimensional _ q,
      IsGalois.of_separable_splitting_field hq_sep⟩
  intro L _ K₀ K'' hle hgal K₂ hK₂f hK₂g hdeg g
  obtain ⟨hLg, hMf, hMg⟩ := compositum L K₀ K'' hle hgal K₂ hK₂f hK₂g
  haveI := hK₂f
  haveI := hK₂g
  haveI := hLg
  haveI := hMf
  haveI := hMg
  let res : (L ≃ₐ[K''] L) → (L ≃ₐ[K₀] L) := fun σ =>
    AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) (fun x => σ.commutes ⟨(x : L), hle x.2⟩)
  have hres : ∀ σ y, res σ y = σ y := fun _ _ => rfl
  let ρ : (L ≃ₐ[K''] L) → (IntermediateField.adjoin K'' (K₂ : Set L) ≃ₐ[K'']
      IntermediateField.adjoin K'' (K₂ : Set L)) :=
    fun σ => AlgEquiv.restrictNormalHom (IntermediateField.adjoin K'' (K₂ : Set L)) σ
  let r : (L ≃ₐ[K''] L) → (K₂ ≃ₐ[K₀] K₂) := fun σ => AlgEquiv.restrictNormalHom K₂ (res σ)
  have hρs : Function.Surjective ρ := AlgEquiv.restrictNormalHom_surjective L
  have hrE : ∀ σ (x : K₂), ((r σ x : K₂) : L) = σ x := fun σ x =>
    AlgEquiv.restrictNormalHom_apply _ _ _
  have hgE : ∀ (x : K₂), ((AlgEquiv.restrictNormalHom K₂ g x : K₂) : L) = g x := fun x =>
    AlgEquiv.restrictNormalHom_apply _ _ _
  have hρE : ∀ σ (y : IntermediateField.adjoin K'' (K₂ : Set L)),
      ((ρ σ y : IntermediateField.adjoin K'' (K₂ : Set L)) : L) = σ y := fun σ y =>
    AlgEquiv.restrictNormalHom_apply _ _ _
  have hfix : ∀ (σ : L ≃ₐ[K''] L) (c : L), c ∈ K'' → σ c = c := fun σ c hc => σ.commutes ⟨c, hc⟩
  have hfac : ∀ σ τ, r σ = r τ → ρ σ = ρ τ := by
    intro σ τ h
    have h1 : ∀ x ∈ K₂, σ x = τ x := by
      intro x hx
      have := congrArg (fun φ => ((φ ⟨x, hx⟩ : K₂) : L)) h
      simpa only [hrE] using this
    have h3 : ∀ y ∈ IntermediateField.adjoin K'' (K₂ : Set L), σ y = τ y := by
      intro y hy
      have hy' : y ∈ (IntermediateField.adjoin K'' (K₂ : Set L)).toSubfield := hy
      rw [IntermediateField.adjoin_toSubfield] at hy'
      have hle' : Subfield.closure (Set.range (algebraMap K'' L) ∪ (K₂ : Set L)) ≤
          (σ : L →+* L).eqLocusField (τ : L →+* L) := by
        rw [Subfield.closure_le]
        rintro z (⟨c, rfl⟩ | hz)
        · exact RingHom.mem_eqLocusField.mpr
            (show σ (algebraMap K'' L c) = τ (algebraMap K'' L c) by
              rw [σ.commutes c, τ.commutes c])
        · exact RingHom.mem_eqLocusField.mpr (show σ z = τ z from h1 z hz)
      exact RingHom.mem_eqLocusField.mp (hle' hy')
    apply AlgEquiv.ext
    intro y
    apply Subtype.ext
    rw [hρE, hρE]
    exact h3 y.1 y.2
  have hcard : Nat.card (K₂ ≃ₐ[K₀] K₂) ≤
      Nat.card (IntermediateField.adjoin K'' (K₂ : Set L) ≃ₐ[K'']
        IntermediateField.adjoin K'' (K₂ : Set L)) := by
    rw [IsGalois.card_aut_eq_finrank, IsGalois.card_aut_eq_finrank]
    exact hdeg
  have hrs : Function.Surjective r := by
    let s := Function.surjInv hρs
    have hs : ∀ b, ρ (s b) = b := Function.surjInv_eq hρs
    have hinj : Function.Injective (fun b => r (s b)) := by
      intro b c hbc
      have := hfac _ _ hbc
      rwa [hs, hs] at this
    have hbij := hinj.bijective_of_nat_card_le hcard
    intro a
    obtain ⟨b, hb⟩ := hbij.2 a
    exact ⟨s b, hb⟩
  obtain ⟨σ, hσ⟩ := hrs (AlgEquiv.restrictNormalHom K₂ g)
  refine ⟨res σ, fun x hx => hfix σ x hx, fun x hx => ?_⟩
  have := congrArg (fun φ => ((φ ⟨x, hx⟩ : K₂) : L)) hσ
  simp only [hrE, hgE] at this
  rw [hres]
  exact this

theorem wc_tpa_gp_weaklyEtale_strict_indEtale : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [HenselianLocalRing B], IsSepClosed (IsLocalRing.ResidueField B) → Algebra.WeaklyEtale A B → wcIndEtale (algebraMap A B) :=
by
  have htr : ∀ {A' R' B' : Type u} [CommRing A'] [CommRing R'] [CommRing B'] (σ : A' →+* R')
      (e : R' ≃+* B') (φ : A' →+* B'), e.toRingHom.comp σ = φ → wcIndEtale σ → wcIndEtale φ := by
    intro A' R' B' _ _ _ σ e φ hφ hind
    unfold wcIndEtale at hind ⊢
    letI : Algebra A' R' := σ.toAlgebra
    letI : Algebra A' B' := φ.toAlgebra
    intro P _ _ _ h
    have hK : ∀ a : A', e.symm (φ a) = σ a := by
      intro a
      rw [← hφ]
      exact e.symm_apply_apply (σ a)
    let h' : P →ₐ[A'] R' :=
      { toRingHom := e.symm.toRingHom.comp h.toRingHom
        commutes' := fun a => by
          change e.symm (h (algebraMap A' P a)) = σ a
          rw [h.commutes a]
          exact hK a }
    obtain ⟨E, _, _, hE, α', β', hβα⟩ := hind P h'
    let β : E →ₐ[A'] B' :=
      { toRingHom := e.toRingHom.comp β'.toRingHom
        commutes' := fun a => by
          change e (β' (algebraMap A' E a)) = φ a
          rw [β'.commutes a, ← hφ]
          rfl }
    refine ⟨E, inferInstance, inferInstance, hE, α', β, ?_⟩
    apply AlgHom.ext
    intro x
    have hx := DFunLike.congr_fun hβα x
    rw [AlgHom.comp_apply] at hx
    change e (β' (α' x)) = h x
    rw [hx]
    change e (e.symm (h x)) = h x
    exact e.apply_symm_apply _
  intro A B _ _ _ _ hsep hwe
  obtain ⟨R, _, σ, ρ, instR, hcomp, hHR, hsepR, hloc, hind⟩ := wc_strict_hull A B hsep
  have hweσ := wc_indEtale_weaklyEtale σ hind
  letI : Algebra A R := σ.toAlgebra
  letI : Algebra R B := ρ.toAlgebra
  haveI : IsScalarTower A R B := IsScalarTower.of_algebraMap_eq' hcomp.symm
  have hweRB : Algebra.WeaklyEtale R B := wc_weaklyEtale_cancel A R B hweσ hwe
  have hbij : Function.Bijective ρ := wc_olivier R B hHR hsepR hloc hweRB
  refine htr σ (RingEquiv.ofBijective ρ hbij) (algebraMap A B) ?_ hind
  rw [← hcomp]
  rfl

theorem wc_tpa_gp_indEtale_local_normal : ∀ (A R : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing R] [IsLocalRing R] (σ : A →+* R), wcIndEtale σ → IsDomain R ∧ IsIntegrallyClosed R :=
by
  intro A R _ _ _ _ _ σ hσ

  have hZ : ∀ (n : ℕ) (S : Type u) [CommRing S] (ψ : MvPolynomial (Fin n) ℤ →+* S)
      (F : MvPolynomial (Fin n) ℤ),
      ψ F = MvPolynomial.eval₂ (Int.castRingHom S) (fun i => ψ (MvPolynomial.X i)) F := by
    intro n S _ ψ F
    have hψ : ψ = MvPolynomial.eval₂Hom (Int.castRingHom S) (fun i => ψ (MvPolynomial.X i)) :=
      MvPolynomial.ringHom_ext (fun r => by simp) (fun i => by simp)
    conv_lhs => rw [hψ]
    rfl

  have happrox : ∀ (n : ℕ) (F : MvPolynomial (Fin n) ℤ) (x : Fin n → R),
      MvPolynomial.eval₂ (Int.castRingHom R) x F = 0 →
      ∃ (T : Type u) (_ : CommRing T) (_ : IsDomain T) (_ : IsIntegrallyClosed T) (γ : T →+* R)
        (y : Fin n → T), (∀ i, γ (y i) = x i) ∧ MvPolynomial.eval₂ (Int.castRingHom T) y F = 0 := by
    intro n F x hF
    letI : Algebra A R := σ.toAlgebra
    obtain ⟨FA, hFA⟩ : ∃ FA : MvPolynomial (Fin n) A,
        FA = MvPolynomial.map (Int.castRingHom A) F := ⟨_, rfl⟩
    obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin n) A), I = Ideal.span {FA} := ⟨_, rfl⟩
    haveI : Algebra.FinitePresentation A (MvPolynomial (Fin n) A ⧸ I) := by
      subst hI
      exact Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton FA)
    have hFAx : MvPolynomial.aeval x FA = 0 := by
      have h1 := hZ n R (((MvPolynomial.aeval x : MvPolynomial (Fin n) A →ₐ[A] R) :
        MvPolynomial (Fin n) A →+* R).comp (MvPolynomial.map (Int.castRingHom A))) F
      simp only [RingHom.comp_apply, MvPolynomial.map_X, RingHom.coe_coe,
        MvPolynomial.aeval_X] at h1
      rw [hFA]
      exact h1.trans hF
    have hIker : ∀ a ∈ I, MvPolynomial.aeval x a = 0 := by
      intro a ha
      rw [hI, Ideal.mem_span_singleton'] at ha
      obtain ⟨c, rfl⟩ := ha
      rw [map_mul, hFAx, mul_zero]
    obtain ⟨h, hhdef⟩ : ∃ h : (MvPolynomial (Fin n) A ⧸ I) →ₐ[A] R,
        h = Ideal.Quotient.liftₐ I (MvPolynomial.aeval x) hIker := ⟨_, rfl⟩
    obtain ⟨E, _, _, hEt, α, β, hαβ⟩ := hσ (MvPolynomial (Fin n) A ⧸ I) h
    haveI : Algebra.Etale A E := hEt
    obtain ⟨Q, hQdef⟩ : ∃ Q : Ideal E,
        Q = Ideal.comap (β : E →+* R) (IsLocalRing.maximalIdeal R) := ⟨_, rfl⟩
    haveI hQ : Q.IsPrime := by rw [hQdef]; exact Ideal.IsPrime.comap _
    obtain ⟨hTd, hTn⟩ := wc_pks_etale_localization_normal A E Q
    have hunit : ∀ s : Q.primeCompl, IsUnit ((β : E →+* R) s) := by
      intro s
      have hs : (s : E) ∉ Q := s.2
      have hs' : (β : E →+* R) s ∉ IsLocalRing.maximalIdeal R := by
        intro hm
        have hm' : (s : E) ∈ Ideal.comap (β : E →+* R) (IsLocalRing.maximalIdeal R) := hm
        rw [← hQdef] at hm'
