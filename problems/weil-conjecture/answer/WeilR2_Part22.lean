      (ψ : ∀ V : B.Etale, H V →+ F.obj.obj (Opposite.op V))
      (res : ∀ {V V' : B.Etale}, (V' ⟶ V) → (H V →+ H V'))
      (π : ∀ l : Λ, H (W'.obj l).right →+ wcEtZModExt (Limits.pullback g a) m j)
      (p : wcEtZModExt (Limits.pullback g a) m j →+
        wcEtZModExt (Limits.pullback g (wcEtGeomPt B η)) m j)
      (θ : ∀ N : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B),
        H N.right →+ wcEtZModExt (Limits.pullback g (wcEtGeomPt B η)) m j),
