  refine ⟨((((wcProEtPush h).rightDerived (n - 1)).map (wcIntToLadic Xu.left ℓ)).hom.app
      (Opposite.op Ty)).hom.range, ?_, ?_, ?_, ?_⟩
  ·
    intro a ha x hx
