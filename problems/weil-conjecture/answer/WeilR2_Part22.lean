        θ (StructuredArrow.mk (Over.homMk (ξ ≫ φ l) (hlift l) :
          Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)) x =
        p (π l x)) →
      ∀ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)),
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
          (Scheme.Etale.forget B)).op ⋙ F.obj)
          (Opposite.op (StructuredArrow.mk (Over.homMk (ξ ≫ φ l) (hlift l) :
            Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s = 0 →
