        ψ N.right x = 0 → ∃ (N' : StructuredArrow (Over.mk (wcEtGeomPt B η))
          (Scheme.Etale.forget B)) (f : N' ⟶ N), res f.right x = 0) →
      (∀ (N N' : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (f : N' ⟶ N)
