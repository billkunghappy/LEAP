    have hℓA : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
      let g : Spec (.of A) ⟶ Spec (.of F'') := a ≫ (wcP1Over F'').hom
      let ψ : F'' →+* IsLocalRing.ResidueField A :=
        (IsLocalRing.residue A).comp (Spec.preimage g).hom
      intro h0
      have h1 : ((ℓ : ℕ) : F'') = 0 := by
        apply ψ.injective
        rw [map_natCast, map_zero]
        exact h0
      have h2 : ringChar F'' ∣ ℓ := ringChar.dvd h1
      have h3 : ringChar F'' = ℓ :=
        ((Nat.dvd_prime (Fact.out : ℓ.Prime)).mp h2).resolve_left CharP.ringChar_ne_one
      haveI : Fintype F'' := Fintype.ofFinite F''
      have h4 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd (FiniteField.cast_card_eq_zero F'')
      apply hℓ
      rw [Nat.card_eq_fintype_card, ← h3]
