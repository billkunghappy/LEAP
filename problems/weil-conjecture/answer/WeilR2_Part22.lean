    rw [h1, AddEquiv.symm_apply_apply]
  have key2 : ∀ {𝒞 : Type _} [Category 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory 𝒞}
      {H M : Type _} [AddCommGroup H] [AddCommGroup M]
