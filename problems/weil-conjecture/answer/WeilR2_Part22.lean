  refine ⟨T₀, t₀, K, hKf, hKac, hℓK, ψ, ?_, ?_, ?_⟩
  ·
    exact (comp_ap O.ι jU t₀).trans ((congrArg jU ht₀).trans hux)
  ·
    intro w
    have e1 : Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) ≫
