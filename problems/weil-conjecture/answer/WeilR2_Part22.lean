theorem wc_npr_et_bc_open_restr_isIso {S S' : Scheme.{u}} (g : S' ⟶ S) (T : S.Etale)
    (O : T.left.Opens)
    (hO : ∀ w : ↥(Limits.pullback T.hom g), Limits.pullback.fst T.hom g w ∈ O) :
    IsIso ((wcEtBaseChange g).map (wcEtOpenι S T O)) :=
by
  have bcL : ∀ {T T' : S.Etale} (hT : T' ⟶ T),
      ((wcEtBaseChange g).map hT).left ≫ Limits.pullback.fst T.hom g =
        Limits.pullback.fst T'.hom g ≫ hT.left := by
    intro T T' hT
    unfold wcEtBaseChange
    erw [MorphismProperty.Over.pullback_map_left]
    exact Limits.pullback.lift_fst _ _ _
  have bcS : ∀ {T T' : S.Etale} (hT : T' ⟶ T),
      ((wcEtBaseChange g).map hT).left ≫ Limits.pullback.snd T.hom g =
        Limits.pullback.snd T'.hom g := by
    intro T T' hT
    unfold wcEtBaseChange
    erw [MorphismProperty.Over.pullback_map_left]
    exact Limits.pullback.lift_snd _ _ _
  let L : Limits.pullback (wcEtOpen S T O).hom g ⟶ Limits.pullback T.hom g :=
    ((wcEtBaseChange g).map (wcEtOpenι S T O)).left
  have L1 : L ≫ Limits.pullback.fst T.hom g =
      Limits.pullback.fst (wcEtOpen S T O).hom g ≫ O.ι := bcL (wcEtOpenι S T O)
  have L2 : L ≫ Limits.pullback.snd T.hom g = Limits.pullback.snd (wcEtOpen S T O).hom g :=
    bcS (wcEtOpenι S T O)
  have hrange : Set.range (Limits.pullback.fst T.hom g) ⊆ Set.range O.ι := by
    rintro _ ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hO w
  let a : Limits.pullback T.hom g ⟶ O.toScheme :=
    IsOpenImmersion.lift O.ι (Limits.pullback.fst T.hom g) hrange
  have ha : a ≫ O.ι = Limits.pullback.fst T.hom g := IsOpenImmersion.lift_fac _ _ _
  have hM : a ≫ (wcEtOpen S T O).hom = Limits.pullback.snd T.hom g ≫ g := by
    show a ≫ O.ι ≫ T.hom = _
    rw [← Category.assoc, ha, Limits.pullback.condition]
  let M : Limits.pullback T.hom g ⟶ Limits.pullback (wcEtOpen S T O).hom g :=
    Limits.pullback.lift a (Limits.pullback.snd T.hom g) hM
  have hMf : M ≫ Limits.pullback.fst (wcEtOpen S T O).hom g = a := Limits.pullback.lift_fst _ _ _
  have hMs : M ≫ Limits.pullback.snd (wcEtOpen S T O).hom g = Limits.pullback.snd T.hom g :=
    Limits.pullback.lift_snd _ _ _
  have h5 : M ≫ L = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, L1, Category.id_comp]
      exact ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ O.ι) hMf)).trans ha
    · rw [Category.assoc, L2, hMs, Category.id_comp]
  have hLa : L ≫ a = Limits.pullback.fst (wcEtOpen S T O).hom g := by
    apply (cancel_mono O.ι).mp
    exact (Category.assoc _ _ _).trans ((congrArg (L ≫ ·) ha).trans L1)
  have h6 : L ≫ M = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hMf, Category.id_comp]
      exact hLa
    · rw [Category.assoc, hMs, L2, Category.id_comp]
  have hw : M ≫ ((wcEtBaseChange g).obj (wcEtOpen S T O)).hom =
      ((wcEtBaseChange g).obj T).hom := hMs
  let ψ : (wcEtBaseChange g).obj T ⟶ (wcEtBaseChange g).obj (wcEtOpen S T O) :=
    MorphismProperty.Over.homMk M hw trivial
  refine ⟨⟨ψ, ?_, ?_⟩⟩
  · apply MorphismProperty.Over.Hom.ext
    first
    | exact h6
    | (erw [MorphismProperty.Comma.comp_left, MorphismProperty.Comma.id_left]; exact h6)
  · apply MorphismProperty.Over.Hom.ext
    first
    | exact h5
    | (erw [MorphismProperty.Comma.comp_left, MorphismProperty.Comma.id_left]; exact h5)

theorem wc_et_tpl_morse_chart_A_pt (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'')) :
    ∃ (_ : IsDomain A), IsDiscreteValuationRing A ∧ IsUnit ((ℓ : ℕ) : A) ∧
      ∃ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} ∧
        IsUnit (c + c.transpose).det ∧
        ∃ (U : Scheme.{u}) (jU : U ⟶ Limits.pullback D.f a)
          (eU : U ⟶ Spec (.of (wcQuadModelRing A n π c))),
          Etale jU ∧ Etale eU ∧ jU ≫ Limits.pullback.snd D.f a = eU ≫ wcQuadModelStr A n π c ∧
          ∃ u : U, jU u = x ∧ ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (eU u) :=
by
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) :=
    fun _ _ _ => rfl

  have hγ : ∀ (c : (wcP1Over F'').left)
      (x : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField c)))),
      wcEtGeomPt (wcP1Over F'').left c x = c := by
    intro c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  have hwN : ∀ (c : (wcP1Over F'').left)
      (N : StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left c))
        (Scheme.Etale.forget (wcP1Over F'').left)),
      N.hom.left ≫ N.right.hom = wcEtGeomPt (wcP1Over F'').left c := fun c N => Over.w N.hom
  obtain ⟨l₁⟩ : Nonempty Λ := IsCofiltered.nonempty
  have hφa : ∀ l, φ l ≫ (W'.obj l).right.hom = a := hA.2.2.2.1
  have hcl := wc_shdata_closed_point_compat _ A Λ W' φ a hA l₁
  have ha_cl : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    calc a (IsLocalRing.closedPoint A)
        = (φ l₁ ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint A) := by rw [hφa l₁]
      _ = (W'.obj l₁).right.hom (φ l₁ (IsLocalRing.closedPoint A)) := comp_ap _ _ _
      _ = (W'.obj l₁).right.hom ((W'.obj l₁).hom.left (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F'')))))) := by rw [hcl]
      _ = ((W'.obj l₁).hom.left ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F''))))) := (comp_ap _ _ _).symm
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [hwN _ (W'.obj l₁)]; exact hγ _ _

  obtain ⟨j, β, hj, hjK, hjb⟩ := wc_morse_p1_rational_chart F'' (D.S i) (D.hS i)
  haveI := hj
  have hb : D.S i (IsLocalRing.closedPoint F'') =
      j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint F'')) := by
    exact (congrArg (fun g => g (IsLocalRing.closedPoint F'')) hjb).symm

  have hrange : Set.range a ⊆ Set.range j := by
    rintro _ ⟨p, rfl⟩
    have h1 : a p ⤳ a (IsLocalRing.closedPoint A) :=
      (IsLocalRing.specializes_closedPoint p).map a.continuous
    rw [ha_cl, hb] at h1
    exact h1.mem_open (IsOpenImmersion.isOpen_range j) ⟨_, rfl⟩
  obtain ⟨aV, haV⟩ : ∃ aV : Spec (.of A) ⟶ Spec (.of (Polynomial F'')), aV ≫ j = a :=
    ⟨_, IsOpenImmersion.lift_fac j a hrange⟩

  obtain ⟨hdom, hdvr, hmax⟩ := wc_morse_shens_chart_dvr F'' j β hj _ hb A Λ W' φ a hA aV haV
  obtain ⟨ρ, rfl⟩ : ∃ ρ : Polynomial F'' →+* A, Spec.map (CommRingCat.ofHom ρ) = aV :=
    ⟨_, Spec.map_preimage aV⟩
  rw [Spec.preimage_map, CommRingCat.hom_ofHom] at hmax

  obtain ⟨U, u, φU, c, σ, hu, hφU, hc, hcomm, hσ, hT⟩ :=
    wc_morse_odp_etale_chart F' F'' Y n hn2 D i j β hj hjK hjb
  haveI : Etale u := hu
  haveI : Etale φU := hφU

  have hM := wc_morse_quad_model_isPullback F'' A n β c ρ
  have Lbc : ∀ {U Y P S M T V : Scheme.{u}} (u : U ⟶ Y) (f : Y ⟶ P) (a : S ⟶ P) (φ : U ⟶ T)
      (m1 : M ⟶ T) (m2 : M ⟶ S) (q : T ⟶ V) (aV : S ⟶ V) (j : V ⟶ P), u ≫ f = φ ≫ q ≫ j →
      aV ≫ j = a → IsPullback m1 m2 q aV →
      ∀ ψ : Limits.pullback u (Limits.pullback.fst f a) ⟶ M,
      ψ ≫ m1 = Limits.pullback.fst u (Limits.pullback.fst f a) ≫ φ →
      ψ ≫ m2 = Limits.pullback.snd u (Limits.pullback.fst f a) ≫ Limits.pullback.snd f a →
      IsPullback (Limits.pullback.fst u (Limits.pullback.fst f a)) ψ φ m1 := by
    intro U Y P S M T V u f a φ m1 m2 q aV j hc haV hM ψ h1 h2
    have hw : ∀ s : Limits.PullbackCone φ m1, (s.fst ≫ u) ≫ f = (s.snd ≫ m2) ≫ a := by
      intro s
      calc (s.fst ≫ u) ≫ f = s.fst ≫ φ ≫ q ≫ j := by rw [Category.assoc, hc]
        _ = (s.fst ≫ φ) ≫ q ≫ j := by rw [Category.assoc]
        _ = (s.snd ≫ m1) ≫ q ≫ j := by rw [s.condition]
        _ = s.snd ≫ (m1 ≫ q) ≫ j := by simp only [Category.assoc]
        _ = s.snd ≫ (m2 ≫ aV) ≫ j := by rw [hM.w]
        _ = (s.snd ≫ m2) ≫ aV ≫ j := by simp only [Category.assoc]
        _ = (s.snd ≫ m2) ≫ a := by rw [haV]
    refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk h1.symm
      (fun s => Limits.pullback.lift s.fst
        (Limits.pullback.lift (s.fst ≫ u) (s.snd ≫ m2) (hw s))
        (Limits.pullback.lift_fst _ _ _).symm) ?_ ?_ ?_)
    · intro s
      exact Limits.pullback.lift_fst _ _ _
    · intro s
      try dsimp only
      apply hM.hom_ext
      · rw [Category.assoc, h1, ← Category.assoc, Limits.pullback.lift_fst, s.condition]
      · rw [Category.assoc, h2, ← Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd]
    · intro s m' hm1 hm2
      try dsimp only
      apply Limits.pullback.hom_ext
      · rw [hm1, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd]
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, ← Limits.pullback.condition,
            ← Category.assoc, hm1]
        · rw [Limits.pullback.lift_snd, Category.assoc, ← h2, ← Category.assoc, hm2]
  have hw' : (Limits.pullback.fst u (Limits.pullback.fst D.f a) ≫ φU) ≫
      Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β +
        ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) =
      (Limits.pullback.snd u (Limits.pullback.fst D.f a) ≫ Limits.pullback.snd D.f a) ≫
        Spec.map (CommRingCat.ofHom ρ) := by
    rw [← cancel_mono j]
    simp only [Category.assoc]
    rw [haV, ← hcomm, Limits.pullback.condition_assoc, Limits.pullback.condition]
  obtain ⟨ψ, hψ1, hψ2⟩ : ∃ ψ : Limits.pullback u (Limits.pullback.fst D.f a) ⟶
      Spec (.of (wcQuadModelRing A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C)))),
      ψ ≫ Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n
          (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp
          (MvPolynomial.map (ρ.comp Polynomial.C)))) =
        Limits.pullback.fst u (Limits.pullback.fst D.f a) ≫ φU ∧
      ψ ≫ wcQuadModelStr A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)) =
        Limits.pullback.snd u (Limits.pullback.fst D.f a) ≫ Limits.pullback.snd D.f a :=
    ⟨hM.lift _ _ hw', hM.lift_fst _ _ _, hM.lift_snd _ _ _⟩
  have hP := Lbc u D.f a φU _ _ _ _ j hcomm haV hM ψ hψ1 hψ2
  have hψet : Etale ψ := MorphismProperty.of_isPullback (P := @Etale) hP hφU
  have hjU : Etale (Limits.pullback.snd u (Limits.pullback.fst D.f a)) :=
    MorphismProperty.of_isPullback (P := @Etale)
      (IsPullback.of_hasPullback u (Limits.pullback.fst D.f a)) hu

  have hux : u (σ (IsLocalRing.closedPoint F'')) = Limits.pullback.fst D.f a x := by
    rw [hx]
    exact congrArg (fun g => g (IsLocalRing.closedPoint F'')) hσ
  obtain ⟨x', hx'1, hx'2⟩ :=
    Scheme.Pullback.exists_preimage_pullback (σ (IsLocalRing.closedPoint F'')) x hux
  have hm1x : (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n
      (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp
      (MvPolynomial.map (ρ.comp Polynomial.C))))) (ψ x') =
      φU (σ (IsLocalRing.closedPoint F'')) := by
    rw [← hx'1]
    exact congrArg (fun g => g x') hψ1
  have hTp : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
      (c.map (ρ.comp Polynomial.C))) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (ψ x') := by
    intro p
    have h1 := hT p
    rw [← hm1x] at h1
    have h2 : Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C))) (MvPolynomial.map (ρ.comp Polynomial.C)
          (MvPolynomial.X p)) ∈ PrimeSpectrum.asIdeal (ψ x') := h1
    rwa [MvPolynomial.map_X] at h2

  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hq : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F''
    have hcop : Nat.Coprime ℓ (Nat.card F'') :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : ℓ.Prime)).mpr hℓ
    have hbez := Nat.gcd_eq_gcd_ab ℓ (Nat.card F'')
    rw [hcop.gcd_eq_one] at hbez
    have h3 := congrArg (fun z : ℤ => (z : F'')) hbez
    push_cast at h3
    rw [h0, hq] at h3
    simp at h3
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have h1 : IsUnit ((ρ.comp Polynomial.C) ((ℓ : ℕ) : F'')) :=
      (isUnit_iff_ne_zero.mpr hℓF).map _
    rwa [map_natCast] at h1

  have hc' : IsUnit ((c.map (ρ.comp Polynomial.C)) +
      (c.map (ρ.comp Polynomial.C)).transpose).det := by
    have h1 : (c.map (ρ.comp Polynomial.C)) + (c.map (ρ.comp Polynomial.C)).transpose =
        (ρ.comp Polynomial.C).mapMatrix (c + c.transpose) := by
      ext p q
      simp
    rw [h1, ← RingHom.map_det]
    exact (isUnit_iff_ne_zero.mpr hc).map _
  exact ⟨hdom, hdvr, hℓA, ρ (Polynomial.X - Polynomial.C β), c.map (ρ.comp Polynomial.C), hmax,
    hc', Limits.pullback u (Limits.pullback.fst D.f a),
    Limits.pullback.snd u (Limits.pullback.fst D.f a), ψ, hjU, hψet, hψ2.symm, x', hx'2, hTp⟩

theorem wc_halsh_finite_point_residue_algClosed : ∀ (K₀ : Type u) [Field K₀] [Finite K₀] (P : Scheme.{u}) (s : Spec (.of K₀) ⟶ P) (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P (s (IsLocalRing.closedPoint K₀)))) (Scheme.Etale.forget P)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ P), wcHalShData (s (IsLocalRing.closedPoint K₀)) A Λ W' φ a → IsAlgClosed (IsLocalRing.ResidueField A) :=
by
  classical
  intro K₀ _ _ P s A _ _ _ Λ _ _ W' φ a hA
  obtain ⟨_, _, _, _, _, e, _, _⟩ := hA
  set F := P.residueField (s (IsLocalRing.closedPoint K₀)) with hF
  have hFfin : Finite F := by
    let f := Scheme.descResidueField (Scheme.stalkClosedPointTo s)
    exact Finite.of_injective f.hom f.hom.injective
  set p := ringChar F with hp
  haveI : Fact p.Prime := ⟨CharP.char_is_prime F p⟩
  haveI : CharP (AlgebraicClosure F) p := inferInstance
  haveI : CharP (IsLocalRing.ResidueField A) p := RingHom.charP e e.injective p
  have hper : ∀ z : AlgebraicClosure F, ∃ m : ℕ, 1 ≤ m ∧ z ^ (p ^ m) = z := by
    intro z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let L := IntermediateField.adjoin F {z}
    haveI : FiniteDimensional F L := IntermediateField.adjoin.finiteDimensional hz
    haveI : Finite L := Module.finite_of_finite F
    letI : Fintype L := Fintype.ofFinite L
    haveI : CharP L p := RingHom.charP L.val.toRingHom Subtype.val_injective p
    obtain ⟨n, -, hn⟩ := FiniteField.card L p
    refine ⟨n, n.pos, ?_⟩
    have h := FiniteField.pow_card (⟨z, IntermediateField.mem_adjoin_simple_self F z⟩ : L)
    rw [hn] at h
    exact congrArg Subtype.val h
  have hperκ : ∀ x : IsLocalRing.ResidueField A, ∃ m : ℕ, 1 ≤ m ∧ x ^ (p ^ m) = x := by
    intro x
    obtain ⟨m, hm, h⟩ := hper (e x)
    exact ⟨m, hm, e.injective (by rw [map_pow, h])⟩
  haveI : ExpChar (IsLocalRing.ResidueField A) p := ExpChar.prime Fact.out
  have hsurj : Function.Surjective (frobenius (IsLocalRing.ResidueField A) p) := by
    intro x
    obtain ⟨m, hm, h⟩ := hperκ x
    refine ⟨x ^ (p ^ (m - 1)), ?_⟩
    rw [frobenius_def, ← pow_mul, ← pow_succ, Nat.sub_add_cancel hm, h]
  haveI : PerfectRing (IsLocalRing.ResidueField A) p :=
    PerfectRing.ofSurjective (IsLocalRing.ResidueField A) p hsurj
  haveI : PerfectField (IsLocalRing.ResidueField A) :=
    PerfectRing.toPerfectField (IsLocalRing.ResidueField A) p
  exact IsSepClosed.isAlgClosed_of_perfectField (IsLocalRing.ResidueField A)

theorem wc_snkc_coeff_field : ∀ (K₀ : Type u) [Field K₀] [Finite K₀] (P : Scheme.{u})
    (s : Spec (.of K₀) ⟶ P) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P (s (IsLocalRing.closedPoint K₀))))
      (Scheme.Etale.forget P))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ P),
    wcHalShData (s (IsLocalRing.closedPoint K₀)) A Λ W' φ a →
    ∀ (g : Spec (.of A) ⟶ Spec (.of K₀)) (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ Nat.card K₀ →
    ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (ι : K →+* A),
      Function.Bijective ((IsLocalRing.residue A).comp ι) ∧ ((ℓ : ℕ) : K) ≠ 0 :=
by
  classical
  have wc_shens_equal_char_alg_closed_subfield : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], (∀ r : ℕ, r.Prime → (r : IsLocalRing.ResidueField A) = 0 → (r : A) = 0) → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K), Nonempty (K →+* A) := by
    intro A _ _ _ hEC

    have s1 : ∃ (P : Type) (_ : Field P) (_ : PerfectField P), Nonempty (P →+* A) := by
      rcases CharP.char_is_prime_or_zero (IsLocalRing.ResidueField A)
          (ringChar (IsLocalRing.ResidueField A)) with hp | h0
      · haveI : Fact (ringChar (IsLocalRing.ResidueField A)).Prime := ⟨hp⟩
        have hpA : ((ringChar (IsLocalRing.ResidueField A) : ℕ) : A) = 0 :=
          hEC _ hp (ringChar.Nat.cast_ringChar)
        haveI : CharP A (ringChar (IsLocalRing.ResidueField A)) := ⟨fun x => by
          constructor
          · intro hx
            apply ringChar.dvd
            have := congrArg (IsLocalRing.residue A) hx
            rwa [map_natCast, map_zero] at this
          · rintro ⟨t, rfl⟩
            rw [Nat.cast_mul, hpA, zero_mul]⟩
        exact ⟨ZMod (ringChar (IsLocalRing.ResidueField A)), inferInstance, inferInstance,
          ⟨ZMod.castHom (dvd_refl _) A⟩⟩
      · haveI : CharP (IsLocalRing.ResidueField A) 0 := by
          rw [← h0]; exact ringChar.charP _
        haveI : CharZero (IsLocalRing.ResidueField A) := CharP.charP_to_charZero _
        have hu : ∀ y : nonZeroDivisors ℤ, IsUnit ((Int.castRingHom A) (y : ℤ)) := by
          intro y
          have hy0 : (y : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero y
          have hres : IsLocalRing.residue A ((Int.castRingHom A) (y : ℤ)) ≠ 0 := by
            rw [eq_intCast, map_intCast]
            exact_mod_cast hy0
          by_contra hnu
          apply hres
          exact (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
        exact ⟨ℚ, inferInstance, inferInstance,
          ⟨IsLocalization.lift (M := nonZeroDivisors ℤ) (S := ℚ) hu⟩⟩
    obtain ⟨P, _, _, ⟨ι⟩⟩ := s1
    letI : Algebra P A := ι.toAlgebra

    let Good : Subring A → Prop := fun S => (∀ c : P, algebraMap P A c ∈ S) ∧
      (∀ x ∈ S, x ≠ 0 → ∃ y ∈ S, x * y = 1) ∧ (∀ x ∈ S, IsIntegral P x)
    have hS0 : Good (algebraMap P A).range := by
      refine ⟨fun c => ⟨c, rfl⟩, ?_, ?_⟩
      · rintro x ⟨c, rfl⟩ hx
        have hc : c ≠ 0 := by rintro rfl; exact hx (map_zero _)
        exact ⟨algebraMap P A c⁻¹, ⟨c⁻¹, rfl⟩, by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩
      · rintro x ⟨c, rfl⟩
        exact isIntegral_algebraMap
    obtain ⟨L, -, hLmax⟩ := zorn_le_nonempty₀ {S : Subring A | Good S} (by
      intro c hc hchain y hy
      have hne : c.Nonempty := ⟨y, hy⟩
      have hdir : DirectedOn (· ≤ ·) c := hchain.directedOn
      refine ⟨sSup c, ⟨fun p => le_sSup hy ((hc hy).1 p), ?_, ?_⟩, fun z hz => le_sSup hz⟩
      · intro x hx hx0
        obtain ⟨S, hS, hxS⟩ := (Subring.mem_sSup_of_directedOn hne hdir).mp hx
        obtain ⟨w, hw, hxw⟩ := (hc hS).2.1 x hxS hx0
        exact ⟨w, le_sSup hS hw, hxw⟩
      · intro x hx
        obtain ⟨S, hS, hxS⟩ := (Subring.mem_sSup_of_directedOn hne hdir).mp hx
        exact (hc hS).2.2 x hxS) _ hS0
    have hLgood : Good L := hLmax.prop
    have hLmax' : ∀ L' : Subring A, Good L' → L ≤ L' → L' ≤ L :=
      fun L' h1 h2 => hLmax.le_of_ge h1 h2
    obtain ⟨hL1, hL2, hL3⟩ := hLgood

    have hfield : IsField L := by
      refine ⟨exists_pair_ne L, mul_comm, ?_⟩
      intro b hb
      have hb' : (b : A) ≠ 0 := fun h => hb (Subtype.ext h)
      obtain ⟨y, hy, hby⟩ := hL2 b b.2 hb'
      exact ⟨⟨y, hy⟩, Subtype.ext hby⟩
    letI : Field L := hfield.toField

    have hcrux : ∀ g : Polynomial L, g.Monic → Irreducible g → ∀ a : A,
        Polynomial.eval₂ L.subtype a g = 0 → a ∈ L := by
      intro g hgm hgi a ha
      haveI : Fact (Irreducible g) := ⟨hgi⟩
      let φ : AdjoinRoot g →+* A := AdjoinRoot.lift L.subtype a ha
      let R := integralClosure P A
      have hLR : ∀ x ∈ L, x ∈ R := fun x hx => (mem_integralClosure_iff _ _).mpr (hL3 x hx)
      let ψ : L →+* R := L.subtype.codRestrict R (fun x => hLR x x.2)
      have hψ : (algebraMap R A).comp ψ = L.subtype := by ext x; rfl
      have haR : a ∈ R := by
        rw [mem_integralClosure_iff]
        have hint : IsIntegral R a :=
          ⟨g.map ψ, hgm.map ψ, by rw [Polynomial.eval₂_map, hψ]; exact ha⟩
        exact isIntegral_trans a hint
      let aR : R := ⟨a, haR⟩
      have hφR : ∀ z, φ z ∈ R := by
        intro z
        obtain ⟨h, rfl⟩ := AdjoinRoot.mk_surjective z
        have e : φ (AdjoinRoot.mk g h) = algebraMap R A (Polynomial.eval₂ ψ aR h) := by
          rw [Polynomial.hom_eval₂, hψ]
          show AdjoinRoot.lift L.subtype a ha (AdjoinRoot.mk g h) = _
          rw [AdjoinRoot.lift_mk]
          rfl
        rw [e]
        exact (Polynomial.eval₂ ψ aR h).2
      have hgood' : Good φ.range := by
        refine ⟨fun c => ⟨AdjoinRoot.of g ⟨_, hL1 c⟩, AdjoinRoot.lift_of ha⟩, ?_, ?_⟩
        · rintro x ⟨z, rfl⟩ hx
          have hz : z ≠ 0 := by rintro rfl; exact hx (map_zero φ)
          exact ⟨φ z⁻¹, ⟨z⁻¹, rfl⟩, by rw [← map_mul, mul_inv_cancel₀ hz, map_one]⟩
        · rintro x ⟨z, rfl⟩
          exact (mem_integralClosure_iff _ _).mp (hφR z)
      have hLL' : L ≤ φ.range := fun x hx => ⟨AdjoinRoot.of g ⟨x, hx⟩, AdjoinRoot.lift_of ha⟩
      exact hLmax' _ hgood' hLL' ⟨AdjoinRoot.root g, AdjoinRoot.lift_root ha⟩

    have hsep : ∀ g : Polynomial L, Irreducible g → g.Separable := by
      letI : Algebra P L := ((algebraMap P A).codRestrict L hL1).toAlgebra
      have halg : Algebra.IsAlgebraic P L := by
        refine ⟨fun x => ?_⟩
        let f : L →ₐ[P] A := { L.subtype with commutes' := fun c => rfl }
        have hx : IsIntegral P (f x) := hL3 x x.2
        exact ((isIntegral_algHom_iff f Subtype.val_injective).mp hx).isAlgebraic
      haveI : PerfectField L := Algebra.IsAlgebraic.perfectField (K := P)
      intro g hg
      exact PerfectField.separable_of_irreducible hg

    haveI : IsAlgClosed L := by
      apply IsAlgClosed.of_exists_root
      intro g hgm hgi
      have hgsep := hsep g hgi
      set G : Polynomial A := g.map L.subtype with hG
      have hGm : G.Monic := hgm.map _
      have hGdeg : G.natDegree = g.natDegree := hgm.natDegree_map _
      have hgpos : 0 < g.natDegree := hgi.natDegree_pos
      set Gb := G.map (IsLocalRing.residue A) with hGb
      have hGbsep : Gb.Separable := by
        rw [hGb, hG, Polynomial.map_map]; exact hgsep.map
      have hGbm : Gb.Monic := hGm.map _
      have hGbdeg : Gb.natDegree = g.natDegree := by rw [hGb, hGm.natDegree_map, hGdeg]
      have hGbdeg' : Gb.degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hGbm.ne_zero, hGbdeg]; exact_mod_cast hgpos.ne'
      obtain ⟨ab, hab⟩ := IsSepClosed.exists_root Gb hGbdeg' hGbsep
      obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ab
      have hresev : ∀ (H : Polynomial A) (x : A), IsLocalRing.residue A (H.eval x) =
          (H.map (IsLocalRing.residue A)).eval (IsLocalRing.residue A x) := by
        intro H x
        rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
      have h1 : G.eval a₀ ∈ IsLocalRing.maximalIdeal A := by
        rw [← IsLocalRing.residue_eq_zero_iff]
        have e1 : IsLocalRing.residue A (G.eval a₀) = Gb.eval ab := by
          rw [hresev, ha₀, hGb]
        rw [e1]; exact hab
      have h2 : IsUnit ((Polynomial.derivative G).eval a₀) := by
        have e2 : IsLocalRing.residue A ((Polynomial.derivative G).eval a₀) =
            (Polynomial.derivative Gb).eval ab := by
          rw [hresev, ha₀, hGb]
          first
            | exact congrArg (Polynomial.eval ab) (Polynomial.derivative_map G _).symm
            | exact congrArg (Polynomial.eval ab) (Polynomial.derivative_map _ _).symm
            | (rw [Polynomial.derivative_map G])
        have hne : (Polynomial.derivative Gb).eval ab ≠ 0 := by
          have := hGbsep.eval₂_derivative_ne_zero (RingHom.id _)
            (by rw [Polynomial.eval₂_id]; exact hab)
          rwa [Polynomial.eval₂_id] at this
        by_contra hnu
        apply hne
        rw [← e2]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
      obtain ⟨a, haroot, -⟩ := HenselianLocalRing.is_henselian G hGm a₀ h1 h2
      have ha : Polynomial.eval₂ L.subtype a g = 0 := by
        rw [← Polynomial.eval_map]; exact haroot
      have haL := hcrux g hgm hgi a ha
      refine ⟨⟨a, haL⟩, ?_⟩
      apply Subtype.val_injective
      show L.subtype (g.eval ⟨a, haL⟩) = L.subtype 0
      rw [map_zero, ← Polynomial.eval₂_at_apply]
      exact ha
    exact ⟨L, inferInstance, inferInstance, ⟨L.subtype⟩⟩
  intro K₀ _ _ P s A _ _ _ Λ _ _ W' φ a hA g ℓ hℓp hℓ
  obtain ⟨_, _, _, _, _, e, _, _⟩ := hA
  set F := P.residueField (s (IsLocalRing.closedPoint K₀)) with hF
  have hFfin : Finite F := by
    let f := Scheme.descResidueField (Scheme.stalkClosedPointTo s)
    exact Finite.of_injective f.hom f.hom.injective

  let jA : K₀ →+* A := (Spec.preimage g).hom
  let ι₀ : K₀ →+* IsLocalRing.ResidueField A := (IsLocalRing.residue A).comp jA

  have hp : (ringChar K₀).Prime := CharP.char_is_prime K₀ (ringChar K₀)
  have hcharF : ∀ r : ℕ, ((r : ℕ) : IsLocalRing.ResidueField A) = 0 → ringChar K₀ ∣ r := by
    intro r hr
    have h0 : ((r : ℕ) : K₀) = 0 := by
      apply ι₀.injective
      rw [map_natCast, map_zero]
      exact hr
    exact (ringChar.spec K₀ r).mp h0
  have hchar : ∀ r : ℕ, r.Prime → (r : IsLocalRing.ResidueField A) = 0 → (r : A) = 0 := by
    intro r _ hr0
    have h3 : ((r : ℕ) : K₀) = 0 := (ringChar.spec K₀ r).mpr (hcharF r hr0)
    have h4 : ((r : ℕ) : A) = jA ((r : ℕ) : K₀) := (map_natCast jA r).symm
    rw [h4, h3, map_zero]
  obtain ⟨K, iK, hK, ⟨ι⟩⟩ := wc_shens_equal_char_alg_closed_subfield A hchar

  have hperκ : ∀ x : IsLocalRing.ResidueField A, ∃ N : ℕ, 1 < N ∧ x ^ N = x := by
    intro x
    set z := e x with hz_def
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    haveI : FiniteDimensional F (IntermediateField.adjoin F {z}) :=
      IntermediateField.adjoin.finiteDimensional hz
    haveI : Finite (IntermediateField.adjoin F {z}) := Module.finite_of_finite F
    letI := Fintype.ofFinite (IntermediateField.adjoin F {z})
    have hN : 1 < Fintype.card (IntermediateField.adjoin F {z}) := Fintype.one_lt_card
    have hzN : z ^ Fintype.card (IntermediateField.adjoin F {z}) = z := by
      have h1 := FiniteField.pow_card
        (⟨z, IntermediateField.mem_adjoin_simple_self F z⟩ : IntermediateField.adjoin F {z})
      exact congrArg Subtype.val h1
    refine ⟨Fintype.card (IntermediateField.adjoin F {z}), hN, ?_⟩
    exact e.injective (by rw [map_pow, ← hz_def, hzN])

  have hint : ((IsLocalRing.residue A).comp ι).IsIntegral := by
    intro x
    obtain ⟨N, hN, hxN⟩ := hperκ x
    refine ⟨Polynomial.X ^ N - Polynomial.X, ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      rw [Polynomial.degree_X]
      exact_mod_cast hN
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, hxN, sub_self]
  have hbij : Function.Bijective ((IsLocalRing.residue A).comp ι) :=
    IsAlgClosed.ringHom_bijective_of_isIntegral _ hint
  have hℓK : ((ℓ : ℕ) : K) ≠ 0 := by
    intro h
    have h1 : ((ℓ : ℕ) : IsLocalRing.ResidueField A) = 0 := by
      rw [← map_natCast ((IsLocalRing.residue A).comp ι) ℓ, h, map_zero]
    have h2 := hcharF ℓ h1
    have h3 : ringChar K₀ = ℓ :=
      (Nat.Prime.eq_one_or_self_of_dvd hℓp _ h2).resolve_left hp.ne_one
    have h4 : ringChar K₀ ∣ Nat.card K₀ := by
      apply (ringChar.spec K₀ _).mp
      letI := Fintype.ofFinite K₀
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero K₀
    exact hℓ (h3 ▸ h4)
  exact ⟨K, iK, hK, ι, hbij, hℓK⟩

theorem wc_snkc_hyp_relation (A : Type u) [CommRing A] (π : A) (m n : ℕ) (hnm : n = 2 * m)
    (c P : Matrix (Fin n) (Fin n) A) (hP : IsUnit P.det) (D' : MvPolynomial (Fin n) A)
    (hD0 : MvPolynomial.constantCoeff D' = 0)
    (hid : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D') :
    (∀ q : Ideal (wcQuadModelRing A n π c), q.IsPrime →
      (∀ a, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a) ∈ q) →
      wcSnkcG π c P D' ∉ q) ∧
    (∀ q : Ideal (wcQuadModelRing A n π c), q.IsPrime →
      algebraMap A (wcQuadModelRing A n π c) π ∉ q → wcSnkcG π c P D' ∉ q →
      ∃ j : Fin m, wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n) ∉ q) :=
by
  classical

  have hmkC : ∀ r : A, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C r) =
      algebraMap A (wcQuadModelRing A n π c) r := by
    intro r
    rw [← MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.mk_algebraMap _ _ _

  have hback : ∀ p : Fin n, ∑ a, algebraMap A (wcQuadModelRing A n π c) (P p a) * wcSnkcS π c P a =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) := by
    intro p
    have hPinv : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
    simp only [wcSnkcS, Finset.mul_sum]
    rw [Finset.sum_comm]
    calc ∑ b, ∑ a, algebraMap A (wcQuadModelRing A n π c) (P p a) *
          (algebraMap A (wcQuadModelRing A n π c) (P⁻¹ a b) *
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b))
        = ∑ b, algebraMap A (wcQuadModelRing A n π c) ((P * P⁻¹) p b) *
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b) := by
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [map_mul]
          ring
      _ = Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) := by
          rw [hPinv, Finset.sum_eq_single p
            (fun b _ hb => by rw [Matrix.one_apply_ne (Ne.symm hb), map_zero, zero_mul])
            (fun h => absurd (Finset.mem_univ p) h), Matrix.one_apply_eq, map_one, one_mul]

  have hrel : ∑ p, ∑ q, algebraMap A (wcQuadModelRing A n π c) (c p q) *
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) *
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X q) =
      algebraMap A (wcQuadModelRing A n π c) π := by
    have h0 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    simp only [map_sub, map_sum, map_mul, hmkC, sub_eq_zero] at h0
    exact h0

  have hident : algebraMap A (wcQuadModelRing A n π c) π * wcSnkcG π c P D' =
      ∑ j : Fin m, wcSnkcS π c P (⟨2 * j.val, by omega⟩ : Fin n) *
        wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n) := by
    have h1 := congrArg (MvPolynomial.eval₂Hom (algebraMap A (wcQuadModelRing A n π c))
      (wcSnkcS π c P)) hid
    simp only [map_sum, map_mul, map_add, MvPolynomial.eval₂Hom_C,
      MvPolynomial.eval₂Hom_X'] at h1
    simp only [hback] at h1
    rw [hrel] at h1
    rw [wcSnkcG]
    linear_combination h1

  have hmem : ∀ q : Ideal (wcQuadModelRing A n π c),
      (∀ a, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a) ∈ q) →
      MvPolynomial.eval₂Hom (algebraMap A (wcQuadModelRing A n π c)) (wcSnkcS π c P) D' ∈ q := by
    intro q hq
    have hs : ∀ a, wcSnkcS π c P a ∈ q := fun a =>
      Ideal.sum_mem q (fun b _ => Ideal.mul_mem_left q _ (hq b))
    have key : ∀ f : MvPolynomial (Fin n) A,
        MvPolynomial.eval₂Hom (algebraMap A (wcQuadModelRing A n π c)) (wcSnkcS π c P) f -
          algebraMap A (wcQuadModelRing A n π c) (MvPolynomial.constantCoeff f) ∈ q := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C a =>
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.constantCoeff_C, sub_self]
        exact q.zero_mem
      | add f g hf hg =>
        rw [map_add, map_add, map_add]
        have := q.add_mem hf hg
        convert this using 1
        ring
      | mul_X f i _ =>
        rw [map_mul, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.constantCoeff_X, mul_zero,
          map_zero, sub_zero]
        exact q.mul_mem_left _ (hs i)
    have := key D'
    rw [hD0, map_zero, sub_zero] at this
    exact this
  refine ⟨?_, ?_⟩
  · intro q hq hall hg
    have h2 := hmem q hall
    apply hq.ne_top
    rw [Ideal.eq_top_iff_one]
    have h3 : (1 : wcQuadModelRing A n π c) = wcSnkcG π c P D' +
        MvPolynomial.eval₂Hom (algebraMap A (wcQuadModelRing A n π c)) (wcSnkcS π c P) D' := by
      rw [wcSnkcG]; ring
    rw [h3]
    exact q.add_mem hg h2
  · intro q hq hπ hg
    by_contra h
    push_neg at h
    have hsum : ∑ j : Fin m, wcSnkcS π c P (⟨2 * j.val, by omega⟩ : Fin n) *
        wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n) ∈ q :=
      Ideal.sum_mem q (fun j _ => q.mul_mem_left _ (h j))
    rw [← hident] at hsum
    rcases hq.mem_or_mem hsum with h' | h'
    · exact hπ h'
    · exact hg h'

theorem wc_snkc_special_slice_map (A : Type u) [CommRing A] [IsLocalRing A] (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (m n : ℕ) (hnm : n = 2 * m)
    (c P : Matrix (Fin n) (Fin n) A) (hP : IsUnit P.det) (D' : MvPolynomial (Fin n) A)
    (hD0 : MvPolynomial.constantCoeff D' = 0)
    (hid : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin m, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D') :
    ∃ Φ : wcQuadModelRing A n π c →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField A),
      Φ.comp (algebraMap A (wcQuadModelRing A n π c)) =
        MvPolynomial.C.comp (IsLocalRing.residue A) ∧
      (∀ j : Fin m, Φ (wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n)) = MvPolynomial.X j) ∧
      ∀ q : Spec (.of (wcQuadModelRing A n π c)),
        (∀ a, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a) ∈ q.asIdeal) →
        algebraMap A (wcQuadModelRing A n π c) π ∈ q.asIdeal →
        Spec.map (CommRingCat.ofHom Φ) (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) (IsLocalRing.ResidueField A) →+* _))
          (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) = q :=
by
  classical
  let ρ : A →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField A) :=
    MvPolynomial.C.comp (IsLocalRing.residue A)
  have hπm : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]; exact Ideal.mem_span_singleton_self π
  have hρπ : ρ π = 0 := by simp [ρ, hπm]
  let Z : Fin n → MvPolynomial (Fin m) (IsLocalRing.ResidueField A) := fun b =>
    ∑ j : Fin m, if b = (⟨2 * j.val + 1, by omega⟩ : Fin n) then MvPolynomial.X j else 0
  have hZeven : ∀ j : Fin m, Z (⟨2 * j.val, by omega⟩ : Fin n) = 0 := by
    intro j
    apply Finset.sum_eq_zero
    intro j' _
    rw [if_neg]
    intro h
    rw [Fin.ext_iff] at h
    simp only at h
    omega
  have hZodd : ∀ j : Fin m, Z (⟨2 * j.val + 1, by omega⟩ : Fin n) = MvPolynomial.X j := by
    intro j
    simp only [Z]
    rw [Finset.sum_eq_single j]
    · simp
    · intro j' _ hj'
      rw [if_neg]
      intro h
      apply hj'
      rw [Fin.ext_iff] at h ⊢
      simp only at h
      omega
    · intro h; exact absurd (Finset.mem_univ j) h
  have hZcc : ∀ b, MvPolynomial.constantCoeff (Z b) = 0 := by
    intro b
    simp only [Z, map_sum]
    apply Finset.sum_eq_zero
    intro j _
    split_ifs <;> simp
  let g : Fin n → MvPolynomial (Fin m) (IsLocalRing.ResidueField A) :=
    fun p => ∑ a, ρ (P p a) * Z a
  let Ψ₀ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField A) :=
    MvPolynomial.eval₂Hom ρ g
  have hvan : ∑ p, ∑ q, ρ (c p q) * g p * g q = 0 := by
    have h := congrArg (MvPolynomial.eval₂Hom ρ Z) hid
    simp only [map_sum, map_mul, map_add, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
      hZeven, zero_mul, Finset.sum_const_zero, hρπ, zero_add] at h
    exact h
  have hker : ∀ a ∈ wcQuadModelIdeal A n π c, Ψ₀ a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have hG : Ψ₀ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q
        - MvPolynomial.C π) = 0 := by
      simp only [Ψ₀, map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval₂Hom_X', hvan, hρπ, sub_zero]
    rw [hG, mul_zero]
  let Φ : wcQuadModelRing A n π c →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField A) :=
    Ideal.Quotient.lift (wcQuadModelIdeal A n π c) Ψ₀ hker
  have hΦmk : ∀ f, Φ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) f) = Ψ₀ f :=
    fun f => Ideal.Quotient.lift_mk _ _ _
  have halg : ∀ x, algebraMap A (wcQuadModelRing A n π c) x =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C x) := fun x => rfl
  have hG1 : Φ.comp (algebraMap A (wcQuadModelRing A n π c)) =
      MvPolynomial.C.comp (IsLocalRing.residue A) := by
    refine RingHom.ext fun x => ?_
    rw [RingHom.comp_apply, halg, hΦmk]
    simp [Ψ₀, ρ]
  have hinv : ∀ a₀ : Fin n, ∑ b, ρ (P⁻¹ a₀ b) * g b = Z a₀ := by
    intro a₀
    have h1 : ∀ d, ∑ b, P⁻¹ a₀ b * P b d = (1 : Matrix (Fin n) (Fin n) A) a₀ d := by
      intro d
      rw [← Matrix.mul_apply, Matrix.nonsing_inv_mul P hP]
    calc ∑ b, ρ (P⁻¹ a₀ b) * g b = ∑ b, ∑ d, ρ (P⁻¹ a₀ b) * (ρ (P b d) * Z d) := by
          simp only [g, Finset.mul_sum]
      _ = ∑ d, ρ (∑ b, P⁻¹ a₀ b * P b d) * Z d := by
          rw [Finset.sum_comm]
          simp only [map_sum, map_mul, Finset.sum_mul, mul_assoc]
      _ = ∑ d, ρ ((1 : Matrix (Fin n) (Fin n) A) a₀ d) * Z d := by simp only [h1]
      _ = Z a₀ := by
          simp [Matrix.one_apply, apply_ite ρ]
  have hG2 : ∀ j : Fin m,
      Φ (wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n)) = MvPolynomial.X j := by
    intro j
    rw [← hZodd j, ← hinv]
    simp only [wcSnkcS, map_sum, map_mul, halg, hΦmk, Ψ₀, MvPolynomial.eval₂Hom_C,
      MvPolynomial.eval₂Hom_X']
  have hεmk : ∀ f, MvPolynomial.constantCoeff (Φ (Ideal.Quotient.mk _ f)) =
      IsLocalRing.residue A (MvPolynomial.constantCoeff f) := by
    intro f
    rw [hΦmk]
    have : (MvPolynomial.constantCoeff.comp Ψ₀) =
        (IsLocalRing.residue A).comp MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro x; simp [Ψ₀, ρ]
      · intro a; simp [Ψ₀, g, ρ, hZcc]
    exact RingHom.congr_fun this f
  refine ⟨Φ, hG1, hG2, ?_⟩
  intro q hqX hqπ
  let ε : wcQuadModelRing A n π c →+* IsLocalRing.ResidueField A :=
    MvPolynomial.constantCoeff.comp Φ
  have hsurj : Function.Surjective ε := by
    intro t
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective t
    refine ⟨Ideal.Quotient.mk _ (MvPolynomial.C x), ?_⟩
    show MvPolynomial.constantCoeff (Φ _) = _
    rw [hεmk, MvPolynomial.constantCoeff_C]
  have hmax : (RingHom.ker ε).IsMaximal := RingHom.ker_isMaximal_of_surjective ε hsurj
  have hle : RingHom.ker ε ≤ q.asIdeal := by
    intro y hy
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [RingHom.mem_ker] at hy
    have hy' : IsLocalRing.residue A (MvPolynomial.constantCoeff f) = 0 := by
      rw [← hεmk]; exact hy
    rw [IsLocalRing.residue_eq_zero_iff, hπ] at hy'
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hy'
    have hcong : (Ideal.Quotient.mk q.asIdeal).comp
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) =
        (Ideal.Quotient.mk q.asIdeal).comp
          ((algebraMap A (wcQuadModelRing A n π c)).comp MvPolynomial.constantCoeff) := by
      apply MvPolynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_C, halg]
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hqX a)
    have h1 := RingHom.congr_fun hcong f
    simp only [RingHom.comp_apply] at h1
    rw [Ideal.Quotient.eq] at h1
    have h2 : algebraMap A (wcQuadModelRing A n π c) (MvPolynomial.constantCoeff f) ∈
        q.asIdeal := by
      rw [← ht, map_mul]; exact Ideal.mul_mem_left _ _ hqπ
    have h3 := Ideal.add_mem _ h1 h2
    simpa using h3
  have heq : RingHom.ker ε = q.asIdeal := hmax.eq_of_le q.isPrime.ne_top hle
  apply PrimeSpectrum.ext
  rw [← heq]
  ext y
  change MvPolynomial.constantCoeff (Φ y) ∈
      IsLocalRing.maximalIdeal (IsLocalRing.ResidueField A) ↔ ε y = 0
  rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]
  rfl

theorem wc_snkc_slice_etale_point (A : Type u) [CommRing A] [IsLocalRing A] (M : Type u)
    [CommRing M] [Algebra A M] (m : ℕ) (K : Type u) [Field K] (ι : K →+* A)
    (hι : Function.Bijective ((IsLocalRing.residue A).comp ι))
    (Φ : M →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField A))
    (hΦ : Φ.comp (algebraMap A M) = MvPolynomial.C.comp (IsLocalRing.residue A))
    (lam : MvPolynomial (Fin m) K →+* M) (hlC : lam.comp MvPolynomial.C = (algebraMap A M).comp ι)
    (hlX : ∀ j, Φ (lam (MvPolynomial.X j)) = MvPolynomial.X j)
    {X T : Scheme.{u}} (fX : X ⟶ Spec (.of A)) (jT : T ⟶ X) (e : T ⟶ Spec (.of M)) [Etale e]
    (hcomm : jT ≫ fX = e ≫ Spec.map (CommRingCat.ofHom (algebraMap A M))) (t₀ : T)
    (ht₀ : e t₀ = Spec.map (CommRingCat.ofHom Φ) (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin m) (IsLocalRing.ResidueField A) →+* _))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) :
    ∃ (S₀ : Scheme.{u}) (σ : S₀ ⟶ Limits.pullback jT (Limits.pullback.fst fX (wcQmSp A))) (s₀ : S₀),
      Etale (σ ≫ Limits.pullback.fst jT (Limits.pullback.fst fX (wcQmSp A)) ≫ e ≫
        Spec.map (CommRingCat.ofHom lam)) ∧
      Limits.pullback.fst jT (Limits.pullback.fst fX (wcQmSp A)) (σ s₀) = t₀ ∧
      (σ ≫ Limits.pullback.fst jT (Limits.pullback.fst fX (wcQmSp A)) ≫ e ≫
        Spec.map (CommRingCat.ofHom lam)) s₀ ∈ Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K))) :=
by
  classical
  let ΦS : Spec (.of (MvPolynomial (Fin m) (IsLocalRing.ResidueField A))) ⟶ Spec (.of M) :=
    Spec.map (CommRingCat.ofHom Φ)
  let cκ : Spec (.of (MvPolynomial (Fin m) (IsLocalRing.ResidueField A))) ⟶
      Spec (.of (IsLocalRing.ResidueField A)) :=
    Spec.map (CommRingCat.ofHom MvPolynomial.C)
  have C0 : Limits.pullback.fst e ΦS ≫ e = Limits.pullback.snd e ΦS ≫ ΦS :=
    Limits.pullback.condition
  have R2 : ΦS ≫ Spec.map (CommRingCat.ofHom (algebraMap A M)) = cκ ≫ wcQmSp A := by
    show Spec.map (CommRingCat.ofHom Φ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A M)) =
      Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hΦ]
  have w : (Limits.pullback.fst e ΦS ≫ jT) ≫ fX =
      (Limits.pullback.snd e ΦS ≫ cκ) ≫ wcQmSp A := by
    rw [Category.assoc, hcomm, ← Category.assoc, C0, Category.assoc, R2, Category.assoc]
  let τ : Limits.pullback e ΦS ⟶ Limits.pullback fX (wcQmSp A) := Limits.pullback.lift _ _ w
  have T1 : τ ≫ Limits.pullback.fst fX (wcQmSp A) = Limits.pullback.fst e ΦS ≫ jT :=
    Limits.pullback.lift_fst _ _ _
  let σ : Limits.pullback e ΦS ⟶ Limits.pullback jT (Limits.pullback.fst fX (wcQmSp A)) :=
    Limits.pullback.lift (Limits.pullback.fst e ΦS) τ T1.symm
  have S1 : σ ≫ Limits.pullback.fst jT (Limits.pullback.fst fX (wcQmSp A)) =
      Limits.pullback.fst e ΦS := Limits.pullback.lift_fst _ _ _
  have hθ : Φ.comp lam = MvPolynomial.map ((IsLocalRing.residue A).comp ι) := by
    apply MvPolynomial.ringHom_ext
    · intro k
      rw [RingHom.comp_apply, MvPolynomial.map_C,
        show lam (MvPolynomial.C k) = algebraMap A M (ι k) from RingHom.congr_fun hlC k]
      exact RingHom.congr_fun hΦ (ι k)
    · intro j
      rw [RingHom.comp_apply, MvPolynomial.map_X]
      exact hlX j
  have hbij : Function.Bijective (Φ.comp lam) := by
    rw [hθ]
    exact ⟨MvPolynomial.map_injective _ hι.1, MvPolynomial.map_surjective _ hι.2⟩
  haveI : IsIso (CommRingCat.ofHom (Φ.comp lam)) := by
    have h : CommRingCat.ofHom (Φ.comp lam) =
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.hom := rfl
    rw [h]; infer_instance
  have R3 : ΦS ≫ Spec.map (CommRingCat.ofHom lam) =
      Spec.map (CommRingCat.ofHom (Φ.comp lam)) := by
    show Spec.map (CommRingCat.ofHom Φ) ≫ Spec.map (CommRingCat.ofHom lam) = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hcompeq : σ ≫ Limits.pullback.fst jT (Limits.pullback.fst fX (wcQmSp A)) ≫ e ≫
      Spec.map (CommRingCat.ofHom lam) =
      Limits.pullback.snd e ΦS ≫ Spec.map (CommRingCat.ofHom (Φ.comp lam)) := by
    rw [← Category.assoc, S1, ← Category.assoc, C0, Category.assoc, R3]
  obtain ⟨s₀, hs₁, hs₂⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := e) (g := ΦS) t₀ _ ht₀
  refine ⟨Limits.pullback e ΦS, σ, s₀, ?_, ?_, ?_⟩
  · rw [hcompeq]; infer_instance
  · rw [← Scheme.Hom.comp_apply, S1]; exact hs₁
  · rw [hcompeq, Scheme.Hom.comp_apply, hs₂]
    have hcc : (MvPolynomial.constantCoeff :
        MvPolynomial (Fin m) (IsLocalRing.ResidueField A) →+* _).comp (Φ.comp lam) =
        ((IsLocalRing.residue A).comp ι).comp MvPolynomial.constantCoeff := by
      rw [hθ]; exact MvPolynomial.constantCoeff_comp_map _
    have h1 : Spec.map (CommRingCat.ofHom ((IsLocalRing.residue A).comp ι)) ≫
        Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K)) =
        Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
          MvPolynomial (Fin m) (IsLocalRing.ResidueField A) →+* _)) ≫
        Spec.map (CommRingCat.ofHom (Φ.comp lam)) := by
      rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        hcc]
    let pt : ↥(Spec (.of (IsLocalRing.ResidueField A))) :=
      IsLocalRing.closedPoint (IsLocalRing.ResidueField A)
    have h2 := congrArg (fun f : Spec (.of (IsLocalRing.ResidueField A)) ⟶
      Spec (.of (MvPolynomial (Fin m) K)) => f pt) h1
    simp only [Scheme.Hom.comp_apply] at h2
    exact ⟨_, h2.trans rfl⟩

theorem wc_snkc_odp_etale_chart (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ (T₀ : (Limits.pullback D.f a).Etale) (t₀ : T₀.left) (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
      (_ : ((ℓ : ℕ) : K) ≠ 0) (ψ : T₀.left ⟶ Spec (.of (MvPolynomial (Fin (n / 2)) K))),
      T₀.hom t₀ = x ∧
      (∀ w : ↥(Limits.pullback T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)),
         ψ (Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) w) ∉ Set.range (Spec.map (CommRingCat.ofHom
           (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K)))) ∧
      ∃ (S₀ : Scheme.{u}) (σ : S₀ ⟶ Limits.pullback T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))
        (s₀ : S₀), Etale (σ ≫ Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ≫ ψ) ∧
        Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (σ s₀) = t₀ ∧
        (σ ≫ Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ≫ ψ) s₀ ∈ Set.range (Spec.map (CommRingCat.ofHom
           (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))) :=
by
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) :=
    fun f g x => Scheme.Hom.comp_apply f g x
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  obtain ⟨l⟩ : Nonempty Λ := by
    first
    | exact inferInstance
    | exact IsCofiltered.nonempty
  have ha : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    have h1 := wc_shdata_closed_point_compat _ A Λ W' φ a hA l
    have h2 : (W'.obj l).hom.left ≫ (W'.obj l).right.hom =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) := Over.w (W'.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint A)) (hA.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W'.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure ((wcP1Over F'').left.residueField
            (D.S i (IsLocalRing.closedPoint F'')))))) h2).trans (hγ _ _ _)))))

  obtain ⟨hdom, hdvr, hℓA, π, c, hπ, hc, U, jU, eU, hjU, heU, hsq, u, hux, hut⟩ :=
    wc_et_tpl_morse_chart_A_pt F' F'' Y n hn hn2 D ℓ hℓ i A Λ W' φ a hA x hx

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_halsh_finite_point_residue_algClosed F'' (wcP1Over F'').left (D.S i) A Λ W' φ a hA

  obtain ⟨m, hm_def⟩ : ∃ m, m = n / 2 := ⟨_, rfl⟩
  rw [← hm_def]
  have hnm : n = 2 * m := by rw [hm_def]; exact (Nat.two_mul_div_two_of_even hn).symm
  have hm1 : 1 ≤ m := by omega
  obtain ⟨P, D', hP, hD0, hid⟩ := wc_pmn_hc_hyperbolic_change A π hπ m n hnm hm1 c hc

  obtain ⟨K, hKf, hKac, ι, hι, hℓK⟩ := wc_snkc_coeff_field F'' (wcP1Over F'').left (D.S i) A Λ W'
    φ a hA (a ≫ (wcP1Over F'').hom) ℓ Fact.out hℓ

  obtain ⟨hg, hodd⟩ := wc_snkc_hyp_relation A π m n hnm c P hP D' hD0 hid
  obtain ⟨Φ, hΦ, hΦs, hΦpt⟩ := wc_snkc_special_slice_map A π hπ m n hnm c P hP D' hD0 hid
  let lam : MvPolynomial (Fin m) K →+* wcQuadModelRing A n π c :=
    MvPolynomial.eval₂Hom ((algebraMap A (wcQuadModelRing A n π c)).comp ι)
      (fun j => wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n))
  have hlC : lam.comp MvPolynomial.C = (algebraMap A (wcQuadModelRing A n π c)).comp ι :=
    MvPolynomial.eval₂Hom_comp_C _ _
  have hlXj : ∀ j : Fin m, lam (MvPolynomial.X j) =
      wcSnkcS π c P (⟨2 * j.val + 1, by omega⟩ : Fin n) :=
    fun j => MvPolynomial.eval₂Hom_X' _ _ j
  have hlX : ∀ j : Fin m, Φ (lam (MvPolynomial.X j)) = MvPolynomial.X j := by
    intro j
    rw [hlXj]
    exact hΦs j

  let O : U.Opens := eU ⁻¹ᵁ (PrimeSpectrum.basicOpen (wcSnkcG π c P D') :
    (Spec (.of (wcQuadModelRing A n π c))).Opens)
  have hu : u ∈ O :=
    (Scheme.Hom.mem_preimage eU).mpr ((PrimeSpectrum.mem_basicOpen _ _).mpr
      (hg _ (PrimeSpectrum.isPrime (R := wcQuadModelRing A n π c) (eU u)) hut))
  obtain ⟨t₀, ht₀⟩ : u ∈ Set.range O.ι := by
    rw [Scheme.Opens.range_ι]
    exact hu
  haveI := hjU
  haveI := heU
  haveI hOe : Etale (O.ι ≫ eU) := inferInstance
  let T₀ : (Limits.pullback D.f a).Etale :=
    MorphismProperty.Over.mk ⊤ (O.ι ≫ jU) (by infer_instance)
  have hT₀ : T₀.hom = O.ι ≫ jU := rfl
  let ψ : T₀.left ⟶ Spec (.of (MvPolynomial (Fin m) K)) :=
    O.ι ≫ eU ≫ Spec.map (CommRingCat.ofHom lam)

  have hπmax : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]
    exact Ideal.mem_span_singleton_self π
  have hfx : Limits.pullback.snd D.f a x = IsLocalRing.closedPoint A := by
    apply wc_shdata_fibre_closed_point _ A Λ W' φ a hA
    calc a (Limits.pullback.snd D.f a x) = (Limits.pullback.snd D.f a ≫ a) x := (comp_ap _ _ _).symm
      _ = (Limits.pullback.fst D.f a ≫ D.f) x := by rw [Limits.pullback.condition]
      _ = D.f (D.xs i (IsLocalRing.closedPoint F'')) := by rw [comp_ap, hx]
