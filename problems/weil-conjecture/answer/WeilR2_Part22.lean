  have c2 : ∀ {P S0 U0 : Scheme.{u}} (z : S0 ⟶ P) [IsClosedImmersion z] (j : U0 ⟶ P) [IsOpenImmersion j], Set.range j = (Set.range z)ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D : wcEtPullData z m) (M : ℕ) (θ : wcEtSuppExt D (M + 1)), wcEtSuppClass D (M + 1) θ = 0 → ∃ β : wcEtZModExt U0 m M, ∀ (P' : Scheme.{u}) (f : P' ⟶ P) (U' : Scheme.{u}) (j' : U' ⟶ P') (w : U' ⟶ U0), IsPullback w j' j f → ∀ (S' : Scheme.{u}) (z' : S' ⟶ P') (g : S' ⟶ S0), IsPullback g z' z f → ∀ (D' : wcEtPullData z' m) (Ef : wcEtPullData f m) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → ∀ (Dw : wcEtPullData w m) (n : ℕ), n • wcEtPull Dw M β = 0 → n • wcEtSuppRestr D Ef D' γ (M + 1) θ = 0 := by
    intro P S0 U0 z _ j _ hr m hm0 D M θ hcls
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing P m)) := HasExt.standard _
