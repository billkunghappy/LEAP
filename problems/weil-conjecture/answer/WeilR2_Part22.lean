      have e3 : (V.hom ⁻¹ᵁ O).ι (g'.left z) ∈ V.hom ⁻¹ᵁ O := by
        have h0 : (V.hom ⁻¹ᵁ O).ι (g'.left z) ∈ Set.range (V.hom ⁻¹ᵁ O).ι := ⟨_, rfl⟩
