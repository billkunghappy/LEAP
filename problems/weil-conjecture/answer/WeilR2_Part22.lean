      refine ⟨@AlgHom.toRingHom L M M _ _ _ iLM (((algebraMap L M).comp σL).toAlgebra) F,
        fun y => ?_⟩
      have h := @AlgHom.commutes L M M _ _ _ iLM (((algebraMap L M).comp σL).toAlgebra) F y
      exact h
    let ι : FractionRing A →+* Ω := IsFractionRing.lift hφ
    letI : Algebra (FractionRing A) Ω := ι.toAlgebra
    have hι : ∀ a, ι (algebraMap A (FractionRing A) a) = φ a := IsFractionRing.lift_algebraMap hφ
    haveI : IsSepClosed Ω := IsSepClosed.of_isAlgClosed Ω
    haveI : IsSepClosed (separableClosure (FractionRing A) Ω) :=
      (separableClosure.isSepClosure (FractionRing A) Ω).sep_closed
    haveI : Algebra.IsSeparable (FractionRing A) (separableClosure (FractionRing A) Ω) :=
      separableClosure.isSeparable (FractionRing A) Ω
    letI : Algebra A (separableClosure (FractionRing A) Ω) :=
      ((algebraMap (FractionRing A) (separableClosure (FractionRing A) Ω)).comp
        (algebraMap A (FractionRing A))).toAlgebra
    haveI : IsScalarTower A (FractionRing A) (separableClosure (FractionRing A) Ω) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have K1 : ∀ a, algebraMap (separableClosure (FractionRing A) Ω) Ω
        (algebraMap A (separableClosure (FractionRing A) Ω) a) = φ a := fun a => hι a
    have K1' : (algebraMap (separableClosure (FractionRing A) Ω) Ω).comp
        (algebraMap A (separableClosure (FractionRing A) Ω)) = φ := RingHom.ext K1
    obtain ⟨σL, hσL, htL⟩ := wc_mnt_sepclosed_kummer_aut A ℓ hℓA ϖ hϖm hϖ0 hdvr
      (separableClosure (FractionRing A) Ω)
    haveI hAlgL : Algebra.IsAlgebraic (separableClosure (FractionRing A) Ω) Ω := by
      constructor
      intro z
      obtain ⟨f, hf0, hfz⟩ := halg z
      refine ⟨f.map (algebraMap A (separableClosure (FractionRing A) Ω)), ?_, ?_⟩
      · intro h
        apply hf0
        rw [← K1', ← Polynomial.map_map, h, Polynomial.map_zero]
      · rw [Polynomial.aeval_def, Polynomial.eval₂_map, K1']
        exact hfz
    obtain ⟨τ, hτ⟩ := ext (separableClosure (FractionRing A) Ω) Ω σL
    refine ⟨τ, ?_, ?_⟩
    · ext a
      rw [RingHom.comp_apply, ← K1 a, hτ, ← RingHom.comp_apply σL, hσL]
    · intro k hk z hz
      have hn : (((ℓ ^ k : ℕ)) : FractionRing A) ≠ 0 := by
        have h1 : (((ℓ ^ k : ℕ)) : FractionRing A) =
            algebraMap A (FractionRing A) (((ℓ : ℕ) : A) ^ k) := by
          rw [map_pow, map_natCast, Nat.cast_pow]
        rw [h1]
        exact ((hℓA.pow k).map (algebraMap A (FractionRing A))).ne_zero
      have ha0 : algebraMap A (FractionRing A) ϖ ≠ 0 := by
        intro h
        apply hϖ0
        apply IsFractionRing.injective A (FractionRing A)
        rw [h, map_zero]
      have hsep := Polynomial.separable_X_pow_sub_C (algebraMap A (FractionRing A) ϖ) hn ha0
      have haev : Polynomial.aeval z (Polynomial.X ^ (ℓ ^ k) -
          Polynomial.C (algebraMap A (FractionRing A) ϖ)) = 0 := by
        rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        show z ^ (ℓ ^ k) - ι (algebraMap A (FractionRing A) ϖ) = 0
        rw [hι, hz, sub_self]
      have hzL : z ∈ separableClosure (FractionRing A) Ω :=
        mem_separableClosure_iff.mpr (hsep.of_dvd (minpoly.dvd _ z haev))
      let zL : separableClosure (FractionRing A) Ω := ⟨z, hzL⟩
      have hzL1 : algebraMap (separableClosure (FractionRing A) Ω) Ω zL = z := by
        first
        | exact IntermediateField.algebraMap_apply _ zL
        | rfl
        | simp [zL]
      have hzLp : zL ^ (ℓ ^ k) = algebraMap A (separableClosure (FractionRing A) Ω) ϖ := by
        apply (algebraMap (separableClosure (FractionRing A) Ω) Ω).injective
        rw [map_pow, hzL1, K1, hz]
      have hp := (htL k hk zL hzLp).map_of_injective
        (algebraMap (separableClosure (FractionRing A) Ω) Ω).injective
      rw [map_mul, map_inv₀, ← hτ, hzL1] at hp
      exact hp

  have s3 : ∀ {Y : Scheme.{u}} (y : Y) (R : Type u) [CommRing R] (h : Spec (.of R) ⟶ Y)
      (ξ : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Spec (.of R)),
      ξ ≫ h = wcEtGeomPt Y y →
      ∀ z : AlgebraicClosure (Y.residueField y), ∃ f : Polynomial R,
        f.map (Spec.preimage ξ).hom ≠ 0 ∧ f.eval₂ (Spec.preimage ξ).hom z = 0 := by
    intro Y y R _ h ξ hξ z
    let x := ξ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))
    let β : (Spec (.of R)).residueField x ⟶ CommRingCat.of (AlgebraicClosure (Y.residueField y)) :=
      Scheme.descResidueField (Scheme.stalkClosedPointTo ξ)
    have hβ : Spec.map β ≫ (Spec (.of R)).fromSpecResidueField x = ξ :=
      Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ _ ξ
    have key : Spec.map (h.residueFieldMap x ≫ β) ≫ Y.fromSpecResidueField (h x) =
        wcEtGeomPt Y y := by
      rw [Spec.map_comp, Category.assoc, Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Category.assoc, hβ, hξ]
    have hpair : (⟨h x, h.residueFieldMap x ≫ β⟩ :
        (p : Y) × (Y.residueField p ⟶ CommRingCat.of (AlgebraicClosure (Y.residueField y)))) =
        ⟨y, CommRingCat.ofHom (algebraMap (Y.residueField y)
          (AlgebraicClosure (Y.residueField y)))⟩ := by
      apply (Scheme.SpecToEquivOfField (AlgebraicClosure (Y.residueField y)) Y).symm.injective
      rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply]
      exact key
    obtain ⟨e, he⟩ := Scheme.SpecToEquivOfField_eq_iff.mp hpair
    let ρ : Y.residueField y →+* (Spec (.of R)).residueField x :=
      ((Scheme.residueFieldCongr e).inv ≫ h.residueFieldMap x).hom
    have h2 : (Scheme.residueFieldCongr e).inv ≫ h.residueFieldMap x ≫ β =
        CommRingCat.ofHom (algebraMap (Y.residueField y)
          (AlgebraicClosure (Y.residueField y))) := by
      have he' : h.residueFieldMap x ≫ β = (Scheme.residueFieldCongr e).hom ≫
          CommRingCat.ofHom (algebraMap (Y.residueField y)
            (AlgebraicClosure (Y.residueField y))) := he
      rw [he']
      exact Iso.inv_hom_id_assoc _ _
    have hρ : β.hom.comp ρ =
        algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y)) := by
      have h3 := congrArg CommRingCat.Hom.hom h2
      rw [CommRingCat.hom_ofHom] at h3
      rw [← h3]
      rfl
    obtain ⟨g, hg0, hgz⟩ := (AlgebraicClosure.isAlgebraic (Y.residueField y)).isAlgebraic z
    set g₁ := g.map ρ with hg₁
    have hg₁0 : g₁ ≠ 0 := by
      rw [hg₁, Ne, Polynomial.map_eq_zero_iff ρ.injective]; exact hg0
    have hg₁z : Polynomial.eval₂ β.hom z g₁ = 0 := by
      rw [hg₁, Polynomial.eval₂_map, hρ, ← Polynomial.aeval_def]; exact hgz
    obtain ⟨g₂, hg₂⟩ :=
      Polynomial.map_surjective _ (Scheme.residue_surjective (Spec (.of R)) x) g₁
    let xU : (⊤ : (Spec (.of R)).Opens) := ⟨x, trivial⟩
    letI : Algebra Γ(Spec (.of R), ⊤) ((Spec (.of R)).presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk (Spec (.of R)).presheaf xU
    haveI hloc := (isAffineOpen_top (Spec (.of R))).isLocalization_stalk xU
    obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec
      ((isAffineOpen_top (Spec (.of R))).primeIdealOf xU).asIdeal.primeCompl g₂
    set fΓ := IsLocalization.integerNormalization
      ((isAffineOpen_top (Spec (.of R))).primeIdealOf xU).asIdeal.primeCompl g₂ with hfΓ
    have hunit : IsUnit (algebraMap Γ(Spec (.of R), ⊤) ((Spec (.of R)).presheaf.stalk x) b) :=
      IsLocalization.map_units ((Spec (.of R)).presheaf.stalk x)
        (⟨b, hbM⟩ : ((isAffineOpen_top (Spec (.of R))).primeIdealOf xU).asIdeal.primeCompl)
    let φ' : Γ(Spec (.of R), ⊤) →+* AlgebraicClosure (Y.residueField y) :=
      β.hom.comp (((Spec (.of R)).residue x).hom.comp
        (algebraMap Γ(Spec (.of R), ⊤) ((Spec (.of R)).presheaf.stalk x)))
    have hξ' : ξ = Spec.map ((((Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.germ ⊤ x trivial) ≫ (Spec (.of R)).residue x) ≫ β) := by
      conv_lhs => rw [← hβ]
      rw [Scheme.fromSpecResidueField.eq_1, Spec.fromSpecStalk_eq, ← Spec.map_comp,
        ← Spec.map_comp]
    have hpre := congrArg Spec.preimage hξ'
    rw [Spec.preimage_map] at hpre
    have hφr : ∀ r : R, (Spec.preimage ξ).hom r = φ' ((Scheme.ΓSpecIso (.of R)).inv.hom r) := by
      intro r
      rw [hpre]
      rfl
    let fR : Polynomial R := fΓ.map (Scheme.ΓSpecIso (.of R)).hom.hom
    have hcomp : (Spec.preimage ξ).hom.comp (Scheme.ΓSpecIso (.of R)).hom.hom = φ' := by
      ext t
      rw [RingHom.comp_apply, hφr]
      congr 1
      first
      | exact Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of R)) t
      | simp
    set cfac := β.hom (((Spec (.of R)).residue x).hom
      (algebraMap Γ(Spec (.of R), ⊤) ((Spec (.of R)).presheaf.stalk x) b)) with hcfac
    have hc0 : cfac ≠ 0 := ((hunit.map ((Spec (.of R)).residue x).hom).map β.hom).ne_zero
    have hfR : fR.map (Spec.preimage ξ).hom = Polynomial.C cfac * g₁.map β.hom := by
      show (fΓ.map (Scheme.ΓSpecIso (.of R)).hom.hom).map (Spec.preimage ξ).hom = _
      rw [Polynomial.map_map, hcomp]
      show fΓ.map (β.hom.comp (((Spec (.of R)).residue x).hom.comp
        (algebraMap Γ(Spec (.of R), ⊤) ((Spec (.of R)).presheaf.stalk x)))) = _
      rw [← Polynomial.map_map, ← Polynomial.map_map, hb, Algebra.smul_def,
        Polynomial.algebraMap_apply, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
        Polynomial.map_C, ← hg₂]
    refine ⟨fR, ?_, ?_⟩
    · rw [hfR]
      exact mul_ne_zero (Polynomial.C_ne_zero.mpr hc0)
        (by rw [Ne, Polynomial.map_eq_zero_iff β.hom.injective]; exact hg₁0)
    · rw [← Polynomial.eval_map, hfR, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_map,
        hg₁z, mul_zero]
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) :=
    fun f g x => Scheme.Hom.comp_apply f g x
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])

  obtain ⟨l⟩ : Nonempty Λ := IsCofiltered.nonempty
  have ha : a (IsLocalRing.closedPoint A) = s (IsLocalRing.closedPoint K) := by
    have h1 := wc_shdata_closed_point_compat _ A Λ W' φ a hA l
    have h2 : (W'.obj l).hom.left ≫ (W'.obj l).right.hom =
        wcEtGeomPt (wcP1Over K).left (s (IsLocalRing.closedPoint K)) := Over.w (W'.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint A)) (hA.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W'.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure ((wcP1Over K).left.residueField
            (s (IsLocalRing.closedPoint K)))))) h2).trans (hγ _ _ _)))))

  have hξne : ξ (IsLocalRing.closedPoint (AlgebraicClosure ((wcP1Over K).left.residueField η))) ≠
      IsLocalRing.closedPoint A := by
    intro h
    apply hηne
    have h1 : (ξ ≫ a) (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over K).left.residueField η))) = η :=
      (congrArg (fun g => g (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over K).left.residueField η)))) hξ).trans (hγ _ _ _)
    have h2 := (comp_ap ξ a _).symm.trans h1
    have h3 := congrArg a h
    exact h2.symm.trans (h3.trans ha)

  haveI : WeaklyEtale a := wc_shdata_weaklyEtale _ A Λ W' φ a hA
  let V₀ : (wcP1Over K).left.ProEt := Scheme.ProEt.mk a
  let e : V₀.left ≅ Spec (.of A) := Iso.refl _
  have hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = s (IsLocalRing.closedPoint K) := by
    first
    | exact ha
    | (simp only [V₀, e, Iso.refl_inv]; exact ha)
    | (simpa [V₀, e] using ha)
  obtain ⟨c, ψ, j, hj, hfac, hW, hcl⟩ := wc_skc_chart_factor K s hs V₀ A e hv
  have hmem : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h1 := (hcl (e.inv (IsLocalRing.closedPoint A))).mp (by rw [hv]; exact subset_closure rfl)
    have h2 : e.hom (e.inv (IsLocalRing.closedPoint A)) = IsLocalRing.closedPoint A := by
      first
      | rfl
      | (have h := Scheme.Hom.comp_apply e.inv e.hom (IsLocalRing.closedPoint A)
         rw [Iso.inv_hom_id] at h
         exact h.symm)
      | simp
    rw [h2] at h1
    exact h1
  obtain ⟨hdom, hϖ0, hdvr⟩ := wc_skc_dvr K A c ψ hW hmem

  have hℓF : ((ℓ : ℕ) : K) ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite K
    have hq : ((Nat.card K : ℕ) : K) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero K
    have hcop : Nat.Coprime ℓ (Nat.card K) :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out)).mpr hℓ
    have hg := Nat.gcd_eq_gcd_ab ℓ (Nat.card K)
    rw [Nat.Coprime.gcd_eq_one hcop] at hg
    have h3 := congrArg (Int.cast : ℤ → K) hg
    push_cast at h3
    rw [h0, hq] at h3
    simp at h3
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have h1 : ψ (Polynomial.C ((ℓ : ℕ) : K)) = ((ℓ : ℕ) : A) := by simp
    rw [← h1]
    exact ((isUnit_iff_ne_zero.mpr hℓF).map Polynomial.C).map ψ
  generalize ψ (Polynomial.X - Polynomial.C c) = ϖ at hmem hϖ0 hdvr
  haveI := hdom
  have hspan : IsLocalRing.maximalIdeal A = Ideal.span {ϖ} := by
    apply le_antisymm
    · intro x hx
      by_cases hx0 : x = 0
      · rw [hx0]; exact Ideal.zero_mem _
      obtain ⟨u, k, rfl⟩ := hdvr x hx0
      cases k with
      | zero =>
        exfalso
        rw [pow_zero, mul_one] at hx
        exact (IsLocalRing.mem_maximalIdeal _).mp hx u.isUnit
      | succ k =>
        rw [Ideal.mem_span_singleton']
        exact ⟨u * ϖ ^ k, by rw [pow_succ]; ring⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hmem

  obtain ⟨φ0, hφ0⟩ : ∃ φ0 : A →+* AlgebraicClosure ((wcP1Over K).left.residueField η),
      φ0 = (Spec.preimage ξ).hom := ⟨_, rfl⟩
  have hfm : ξ = Spec.map (CommRingCat.ofHom φ0) := by
    rw [hφ0, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hfφ : ∀ x, ξ x = PrimeSpectrum.comap φ0 x := by
    intro x
    rw [hfm]
    rfl
  have hinj : Function.Injective φ0 := by
    have hϖ' : φ0 ϖ ≠ 0 := by
      intro hz
      have hker : RingHom.ker φ0 = IsLocalRing.maximalIdeal A := by
        apply le_antisymm
        · exact IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top φ0)
        · rw [hspan, Ideal.span_le, Set.singleton_subset_iff]
          exact (RingHom.mem_ker).mpr hz
      apply hξne
      refine (hfφ _).trans ?_
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      show Ideal.comap φ0 (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal A
      rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot, hker]
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    obtain ⟨u, n, rfl⟩ := hdvr x hx0
    rw [map_mul, map_pow] at hx
    have hu : φ0 u ≠ 0 := (u.isUnit.map φ0).ne_zero
    exact mul_ne_zero hu (pow_ne_zero n hϖ') hx

  have halg : ∀ z : AlgebraicClosure ((wcP1Over K).left.residueField η), ∃ f : Polynomial A,
      f.map φ0 ≠ 0 ∧ f.eval₂ φ0 z = 0 := by
    rw [hφ0]
    exact s3 η A a ξ hξ

  obtain ⟨τ, hτφ, htame⟩ := s4 A ℓ hℓA ϖ hmem hϖ0 hdvr
    (AlgebraicClosure ((wcP1Over K).left.residueField η)) φ0 hinj halg

  refine ⟨ϖ, hspan, Spec.map (CommRingCat.ofHom τ), ?_, ?_⟩
  · calc Spec.map (CommRingCat.ofHom τ) ≫ ξ
        = Spec.map (CommRingCat.ofHom τ) ≫ Spec.map (CommRingCat.ofHom φ0) := by rw [← hfm]
      _ = Spec.map (CommRingCat.ofHom φ0) := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hτφ]
      _ = ξ := hfm.symm
  · rw [Spec.preimage_map, CommRingCat.hom_ofHom, ← hφ0]
    exact htame

theorem wc_shdata_fibre_closed_point : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ p : Spec (.of B), a p = y → p = IsLocalRing.closedPoint B :=
by
  intro Y y B _ _ Λ _ _ W' φ a hA p hp
  have comp_ap : ∀ {X₁ Y₁ Z₁ : Scheme.{u}} (f₁ : X₁ ⟶ Y₁) (g₁ : Y₁ ⟶ Z₁) (x₁ : X₁),
      (f₁ ≫ g₁) x₁ = g₁ (f₁ x₁) := by
    intro X₁ Y₁ Z₁ f₁ g₁ x₁
    first
    | rfl
    | simp
  have hγ : ∀ (C : Scheme.{u}) (c : C) (t : Spec (.of (AlgebraicClosure (C.residueField c)))),
      wcEtGeomPt C c t = c := by
    intro C c t
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])

  have vnr : IsAffine (Limits.pullback (Y.fromSpecResidueField y) a) ∧
      ∀ g : Γ(Limits.pullback (Y.fromSpecResidueField y) a, ⊤),
        ∃ s : Γ(Limits.pullback (Y.fromSpecResidueField y) a, ⊤), g * g * s = g := by
    obtain ⟨-, haff, hcomp, hφa, hlim, -⟩ := hA
    haveI hiaff : IsAffineHom (Y.fromSpecResidueField y) := by
      constructor
      intro U _
      have hsub : ∀ p q : PrimeSpectrum (Y.residueField y), p = q := by
        intro p q
        apply PrimeSpectrum.ext
        rw [Ideal.eq_bot_of_prime p.asIdeal, Ideal.eq_bot_of_prime q.asIdeal]
      by_cases h : ∃ p, p ∈ (Y.fromSpecResidueField y) ⁻¹ᵁ U
      · obtain ⟨p, hp⟩ := h
        have htop : (Y.fromSpecResidueField y) ⁻¹ᵁ U = ⊤ := by
          ext q
          exact ⟨fun _ => trivial, fun _ => (hsub p q) ▸ hp⟩
        rw [htop]
        exact isAffineOpen_top _
      · have hbot : (Y.fromSpecResidueField y) ⁻¹ᵁ U = ⊥ := by
          ext q
          exact ⟨fun hq => (h ⟨q, hq⟩).elim, fun hq => by simp at hq⟩
        rw [hbot]
        exact isAffineOpen_bot _
    have hXaff : IsAffine (Limits.pullback (Y.fromSpecResidueField y) a) := inferInstance
    refine ⟨hXaff, ?_⟩
    have s1 : ∀ (G : Λ ⥤ Scheme.{u}) (X : Scheme.{u}) [IsAffine X] (ψ : ∀ l, X ⟶ G.obj l),
        (∀ l, IsAffine (G.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l') →
        (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
          (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ ψ l = zz l) →
        ∀ f : Γ(X, ⊤), ∃ (l : Λ) (g : Γ(G.obj l, ⊤)), (ψ l).appTop g = f := by
      intro G X _ ψ hGa hψ hlim f
      let F : Λᵒᵖ ⥤ CommRingCat.{u} := G.op ⋙ Scheme.Γ
      have hnat : ∀ (i j : Λᵒᵖ) (f : i ⟶ j), F.map f ≫ (ψ j.unop).appTop = (ψ i.unop).appTop := by
        intro i j f
        rw [← hψ f.unop, Scheme.Hom.comp_appTop]
        rfl
      let c : Limits.Cocone F :=
        { pt := Γ(X, ⊤)
          ι := { app := fun l => (ψ l.unop).appTop
                 naturality := fun i j f => by
                   erw [Category.comp_id]
                   exact hnat i j f } }
      let κ : Limits.colimit F ⟶ Γ(X, ⊤) := Limits.colimit.desc F c
      let ι' : ∀ l : Λ, Γ(G.obj l, ⊤) ⟶ Limits.colimit F := fun l =>
        Limits.colimit.ι F (Opposite.op l)
      have hκ : ∀ l : Λ, ι' l ≫ κ = (ψ l).appTop := fun l => Limits.colimit.ι_desc c (Opposite.op l)
      have hιw : ∀ {l l' : Λ} (t : l ⟶ l'), (G.map t).appTop ≫ ι' l = ι' l' := fun t =>
        Limits.colimit.w F t.op
      let ψ' : ∀ l, Spec (Limits.colimit F) ⟶ G.obj l := fun l =>
        Spec.map (ι' l) ≫ (G.obj l).isoSpec.inv
      have hψ' : ∀ {l l' : Λ} (t : l ⟶ l'), ψ' l ≫ G.map t = ψ' l' := by
        intro l l' t
        simp only [ψ']
        rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
          hιw t]
      obtain ⟨z₀, hz₀, -⟩ := hlim _ ψ' hψ'
      obtain ⟨w, -, hwu⟩ := hlim X ψ hψ
      let ρ : X ⟶ Spec (Limits.colimit F) := X.isoSpec.hom ≫ Spec.map κ
      have hρ : ρ ≫ z₀ = 𝟙 X := by
        have e1 : ρ ≫ z₀ = w := hwu _ (fun l => by
          rw [Category.assoc, hz₀]
          simp only [ρ, ψ', Category.assoc]
          rw [← Category.assoc (Spec.map κ), ← Spec.map_comp, hκ l,
            Scheme.isoSpec_inv_naturality, Iso.hom_inv_id_assoc])
        have e2 : 𝟙 X = w := hwu _ (fun l => Category.id_comp _)
        rw [e1, e2]
      have h2 : Spec.map κ ≫ (z₀ ≫ X.isoSpec.hom) = 𝟙 _ := by
        have : Spec.map κ ≫ z₀ = X.isoSpec.inv := by
          rw [← Iso.hom_comp_eq_id, ← Category.assoc]
          exact hρ
        rw [← Category.assoc, this, Iso.inv_hom_id]
      let ζ : Γ(X, ⊤) ⟶ Limits.colimit F := Spec.preimage (z₀ ≫ X.isoSpec.hom)
      have hζκ : ζ ≫ κ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, h2, Spec.map_id]
      obtain ⟨j, g, hg⟩ := Limits.Concrete.colimit_exists_rep F (ζ f)
      refine ⟨j.unop, g, ?_⟩
      have e3 : κ (ζ f) = f := by
        show (ζ ≫ κ) f = f
        rw [hζκ]
        rfl
      have e4 : (ψ j.unop).appTop g = κ (ι' j.unop g) := by
        rw [← hκ j.unop]
        rfl
      rw [e4, ← e3, ← hg]
      rfl
    have s3 : ∀ (Ω : Type u) [Field Ω] (E : Scheme.{u}) [IsAffine E] (s : E ⟶ Spec (.of Ω)),
        Etale s → ∀ g : Γ(E, ⊤), ∃ t : Γ(E, ⊤), g * g * t = g := by
      intro Ω _ E _ s hs g
      have h1 : (s.appTop).hom.Etale := (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp hs
      have h2 : ((Scheme.ΓSpecIso (.of Ω)).inv).hom.Etale :=
        RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
      have h3 : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.Etale := by
        rw [CommRingCat.hom_comp]
        exact RingHom.Etale.stableUnderComposition _ _ h2 h1
      letI := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.toAlgebra
      have hE : Algebra.Etale Ω Γ(E, ⊤) := RingHom.Etale.toAlgebra h3
      obtain ⟨I, _, Ai, _, _, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod Ω Γ(E, ⊤)).mp hE
      refine ⟨e.symm (fun i => (e g i)⁻¹), ?_⟩
      apply e.injective
      rw [map_mul, map_mul, AlgEquiv.apply_symm_apply]
      funext i
      simp only [Pi.mul_apply]
      exact mul_self_mul_inv _
    have hw : ∀ {l l' : Λ} (t : l ⟶ l'),
        (W'.map t).right.left ≫ (W'.obj l').right.hom = (W'.obj l).right.hom := by
      intro l l' t
      have := (W'.map t).right.w
      simpa using this
    let h : ∀ l, (W'.obj l).right.left ⟶ Y := fun l => (W'.obj l).right.hom
    let mp : ∀ {l l' : Λ} (t : l ⟶ l'), Limits.pullback (Y.fromSpecResidueField y) (h l) ⟶
        Limits.pullback (Y.fromSpecResidueField y) (h l') :=
      fun t =>
      Limits.pullback.lift (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _ ≫ (W'.map t).right.left)
        (by rw [Category.assoc, hw t]; exact Limits.pullback.condition)
    have mp_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
        mp t ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ :=
      fun t => Limits.pullback.lift_fst _ _ _
    have mp_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
        mp t ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ (W'.map t).right.left := fun t =>
      Limits.pullback.lift_snd _ _ _
    let G : Λ ⥤ Scheme.{u} :=
      { obj := fun l => Limits.pullback (Y.fromSpecResidueField y) (h l)
        map := fun t => mp t
        map_id := fun l => by
          apply Limits.pullback.hom_ext
          · rw [mp_fst, Category.id_comp]
          · rw [mp_snd, Category.id_comp, W'.map_id]
            rfl
        map_comp := fun {l₁ l₂ l₃} t₁ t₂ => by
          apply Limits.pullback.hom_ext
          · rw [mp_fst, Category.assoc, mp_fst, mp_fst]
          · rw [mp_snd, Category.assoc, mp_snd, ← Category.assoc, mp_snd, Category.assoc,
              W'.map_comp]
            rfl }
    have Gmap_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
        G.map t ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l') =
          Limits.pullback.fst (Y.fromSpecResidueField y) (h l) := mp_fst
    have Gmap_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
        G.map t ≫ Limits.pullback.snd (Y.fromSpecResidueField y) (h l') =
          Limits.pullback.snd (Y.fromSpecResidueField y) (h l) ≫ (W'.map t).right.left := mp_snd
    let ψ : ∀ l, Limits.pullback (Y.fromSpecResidueField y) a ⟶ G.obj l := fun l =>
      Limits.pullback.lift (Limits.pullback.fst (Y.fromSpecResidueField y) a)
        (Limits.pullback.snd (Y.fromSpecResidueField y) a ≫ φ l)
        (by rw [Category.assoc]; erw [hφa l]; exact Limits.pullback.condition)
    have ψ_fst : ∀ l, ψ l ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l) =
        Limits.pullback.fst (Y.fromSpecResidueField y) a :=
      fun l => Limits.pullback.lift_fst _ _ _
    have ψ_snd : ∀ l, ψ l ≫ Limits.pullback.snd (Y.fromSpecResidueField y) (h l) =
        Limits.pullback.snd (Y.fromSpecResidueField y) a ≫ φ l := fun l =>
      Limits.pullback.lift_snd _ _ _
    let sG : ∀ l, G.obj l ⟶ Spec (Y.residueField y) := fun l =>
      Limits.pullback.fst (Y.fromSpecResidueField y) (h l)
    have hGaff : ∀ l, IsAffine (G.obj l) := by
      intro l
      haveI := haff l
      show IsAffine (Limits.pullback (Y.fromSpecResidueField y) (h l))
      infer_instance
    have hGet : ∀ l, Etale (sG l) := by
      intro l
      haveI : Etale (h l) := (W'.obj l).right.prop
      show Etale (Limits.pullback.fst (Y.fromSpecResidueField y) (h l))
      infer_instance
    have hψc : ∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l' := by
      intro l l' t
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Gmap_fst, ψ_fst, ψ_fst]
      · rw [Category.assoc, Gmap_snd, ← Category.assoc, ψ_snd, Category.assoc, hcomp, ψ_snd]
    have hψlim : ∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') →
          ∃! z₀ : T ⟶ Limits.pullback (Y.fromSpecResidueField y) a, ∀ l, z₀ ≫ ψ l = zz l := by
      intro T zz hzz
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hfst1 : ∀ {l l' : Λ} (t : l ⟶ l'),
          zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l) =
            zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l') := by
        intro l l' t
        rw [← hzz t, Category.assoc, Gmap_fst]
      have hfst : ∀ l l' : Λ,
          zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l) =
            zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l') := by
        intro l l'
        rw [← hfst1 (IsCofiltered.minToLeft l l'), hfst1 (IsCofiltered.minToRight l l')]
      let v : T ⟶ Spec (Y.residueField y) :=
        zz l₀ ≫ Limits.pullback.fst (Y.fromSpecResidueField y) (h l₀)
      have hzz' : ∀ {l l' : Λ} (t : l ⟶ l'),
          (zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField y) (h l)) ≫ (W'.map t).right.left =
            zz l' ≫ Limits.pullback.snd (Y.fromSpecResidueField y) (h l') := by
        intro l l' t
        rw [← hzz t, Category.assoc, Category.assoc, Gmap_snd]
      obtain ⟨w, hw1, hw2⟩ :=
        hlim T (fun l => zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField y) (h l)) hzz'
      have hwa : v ≫ Y.fromSpecResidueField y = w ≫ a := by
        rw [← hφa l₀, ← Category.assoc, hw1 l₀]
        simp only [v, Category.assoc]
        exact congrArg (zz l₀ ≫ ·) Limits.pullback.condition
      refine ⟨Limits.pullback.lift v w hwa, fun l => ?_, fun z₁ hz₁ => ?_⟩
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, ψ_fst, Limits.pullback.lift_fst]
          exact hfst l₀ l
        · rw [Category.assoc, ψ_snd, ← Category.assoc, Limits.pullback.lift_snd]
          exact hw1 l
      · apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← ψ_fst l₀, ← Category.assoc, hz₁ l₀]
        · rw [Limits.pullback.lift_snd]
          apply hw2
          intro l
          rw [Category.assoc, ← ψ_snd, ← Category.assoc, hz₁ l]
    intro g
    obtain ⟨l, g₀, hg⟩ := s1 G (Limits.pullback (Y.fromSpecResidueField y) a) ψ hGaff hψc hψlim g
    haveI := hGaff l
    obtain ⟨t₀, ht₀⟩ := s3 (Y.residueField y) (G.obj l) (sG l) (hGet l) g₀
    refine ⟨(ψ l).appTop t₀, ?_⟩
    rw [← hg, ← map_mul, ← map_mul, ht₀]

  have s1 : ∀ (V : Scheme.{u}) [IsAffine V], (∀ g : Γ(V, ⊤), ∃ s : Γ(V, ⊤), g * g * s = g) →
      ∀ v w : V, v ⤳ w → v = w := by
    intro V _ hV v w hvw
    have h1 : V.isoSpec.hom v ⤳ V.isoSpec.hom w := hvw.map V.isoSpec.hom.continuous
    have h2 : (V.isoSpec.hom v).asIdeal ≤ (V.isoSpec.hom w).asIdeal :=
      (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((PrimeSpectrum.le_iff_specializes _ _).mpr h1)
    have h3 : (V.isoSpec.hom w).asIdeal ≤ (V.isoSpec.hom v).asIdeal := by
      intro g hg
      obtain ⟨s, hs⟩ := hV g
      have h0 : g * (g * s - 1) ∈ (V.isoSpec.hom v).asIdeal := by
        have : g * (g * s - 1) = 0 := by rw [mul_sub, ← mul_assoc, hs, mul_one, sub_self]
        rw [this]; exact Ideal.zero_mem _
      rcases (V.isoSpec.hom v).isPrime.mem_or_mem h0 with h | h
      · exact h
      · exfalso
        have h4 : g * s - 1 ∈ (V.isoSpec.hom w).asIdeal := h2 h
        have h5 : g * s ∈ (V.isoSpec.hom w).asIdeal := Ideal.mul_mem_right _ _ hg
        have h6 : (1 : Γ(V, ⊤)) ∈ (V.isoSpec.hom w).asIdeal := by
          have := Ideal.sub_mem _ h5 h4
          rwa [sub_sub_cancel] at this
        exact (V.isoSpec.hom w).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h6)
    have h7 : V.isoSpec.hom v = V.isoSpec.hom w := PrimeSpectrum.ext (le_antisymm h2 h3)
    exact (Scheme.Hom.isEmbedding V.isoSpec.hom).injective h7

  have ha_cl : a (IsLocalRing.closedPoint B) = y := by
    obtain ⟨e, -, he⟩ := hA.2.2.2.2.2
    have h2 : Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) (Spec.map (CommRingCat.ofHom e)
        (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
        = IsLocalRing.closedPoint B :=
      IsLocalRing.PrimeSpectrum.comap_residue B _
    calc a (IsLocalRing.closedPoint B)
        = a (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) (Spec.map (CommRingCat.ofHom e)
            (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))) :=
          congrArg a h2.symm
      _ = (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a)
            (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) :=
          ((comp_ap _ _ _).trans (comp_ap _ _ _)).symm
      _ = wcEtGeomPt Y y (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) :=
          congrArg (fun g : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
            g (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) he
      _ = y := hγ _ _ _
  obtain ⟨haffV, hvnrV⟩ := vnr
  haveI := haffV
  have hrig := s1 _ hvnrV
  obtain ⟨v, -, hv⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := Y.fromSpecResidueField y) (g := a)
    (IsLocalRing.closedPoint (Y.residueField y)) p
    ((Scheme.fromSpecResidueField_apply _ _).trans hp.symm)
  obtain ⟨w, -, hw⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := Y.fromSpecResidueField y) (g := a)
    (IsLocalRing.closedPoint (Y.residueField y))
    (IsLocalRing.closedPoint B)
    ((Scheme.fromSpecResidueField_apply _ _).trans ha_cl.symm)
  have hsp : Limits.pullback.snd (Y.fromSpecResidueField y) a v ⤳
      Limits.pullback.snd (Y.fromSpecResidueField y) a w := by
    have h0 := IsLocalRing.specializes_closedPoint p
    exact hv.symm ▸ hw.symm ▸ h0
  have hvw : v ⤳ w := (Scheme.Hom.isEmbedding (Limits.pullback.snd
    (Y.fromSpecResidueField y) a)).isInducing.specializes_iff.mp hsp
  exact hv.symm.trans ((congrArg _ (hrig v w hvw)).trans hw)

theorem wc_et_pull_cup {S S' : Scheme.{u}} {g : S' ⟶ S} {m : ℕ} (D : wcEtPullData g m) (i j k : ℕ)
    (hk : i + j = k) (x : wcEtZModExt S m i) (y : wcEtZModExt S m j) :
    wcEtPull D k (wcEtZModCup S m i j k hk x y) =
      wcEtZModCup S' m i j k hk (wcEtPull D i x) (wcEtPull D j y) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' m)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  have key : ∀ (x : wcEtZModExt S m i) (y : wcEtZModExt S m j),
      (Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
            (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i))
          (zero_add i)).comp
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j))
          (zero_add j)) hk := by
    intro x y
    rw [Abelian.Ext.mapExactFunctor_comp]
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add i) hk (show 0 + i + j = k by omega),
      Abelian.Ext.comp_assoc_of_second_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  exact key x y

theorem wc_et_zmod_ring_hom_ext (Y : Scheme.{u}) (m : ℕ)
    (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R) : φ = ψ :=
by
  have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
    intro T _ f g
    have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
        g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
      Subsingleton.elim _ _
    ext x
    exact RingHom.congr_fun h x.down
  apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _ R).injective
  apply NatTrans.ext
  funext U
  apply RingCat.hom_ext
  exact key _ _ _

theorem wc_et_supp_unit_line {X : Scheme.{u}} (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X) (m : ℕ)
    (Dx : wcEtPullData xb m) :
    ∃ e : ZMod m ≃+ (SheafOfModules.unit (wcEtZModRing X m) ⟶ wcEtSuppObj Dx),
      e 1 = wcEtSuppUnitMap Dx :=
by
  classical
  let J := Scheme.smallEtaleTopology (Spec (.of Ω))
  let T : (Spec (.of Ω)).Etale := Scheme.Etale.mk (𝟙 (Spec (.of Ω)))
  let R := wcEtZModRing (Spec (.of Ω)) m
  let U := SheafOfModules.unit R
  let UX := SheafOfModules.unit (wcEtZModRing X m)

  have hT : Limits.IsTerminal T := by
    refine Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom
        (by first
          | exact Category.comp_id V.hom
          | (show V.hom ≫ 𝟙 _ = V.hom; exact Category.comp_id _)
          | (erw [Category.comp_id])) trivial) ?_
    intro V g
    apply MorphismProperty.Over.Hom.ext
    have hw := MorphismProperty.Over.w g
    first
      | exact (Category.comp_id g.left).symm.trans hw
      | (show g.left = V.hom; rw [← hw]; exact (Category.comp_id g.left).symm)
      | (show g.left = V.hom; erw [Category.comp_id] at hw; exact hw)

  have hev : ∀ (M : SheafOfModules.{u+1} R), Function.Bijective
      (fun g : U ⟶ M => (g.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T))) := by
    intro M
    have huniq : ∀ (Z : ((Spec (.of Ω)).Etale)ᵒᵖ) (a b : Opposite.op T ⟶ Z), a = b := fun Z a b =>
      Quiver.Hom.unop_inj (hT.hom_ext _ _)
    let evT : M.sections → M.val.obj (Opposite.op T) := fun s => s.1 (Opposite.op T)
    have hfac : (fun g : U ⟶ M =>
        (g.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T))) =
        evT ∘ M.unitHomEquiv := by
      funext g
      first
        | exact (SheafOfModules.unitHomEquiv_apply_coe M g (Opposite.op T)).symm
        | exact (SheafOfModules.unitHomEquiv_apply_coe g (Opposite.op T)).symm
        | simp [evT, SheafOfModules.unitHomEquiv_apply_coe]
    rw [hfac]
    refine Function.Bijective.comp ⟨?_, ?_⟩ M.unitHomEquiv.bijective
    · intro s t hst
      apply PresheafOfModules.sections_ext
      intro Z
      have hs := PresheafOfModules.sections_property s (hT.from Z.unop).op
      have ht := PresheafOfModules.sections_property t (hT.from Z.unop).op
      rw [← hs, ← ht]
      exact congrArg _ hst
    · intro x
      refine ⟨PresheafOfModules.sectionsMk
        (fun Z => (M.val.map (hT.from Z.unop).op).hom x) ?_, ?_⟩
      · intro Z Z' f
        have e : (hT.from Z'.unop).op = (hT.from Z.unop).op ≫ f :=
          huniq Z' (hT.from Z'.unop).op ((hT.from Z.unop).op ≫ f)
        first
          | (rw [e, PresheafOfModules.map_comp]; rfl)
          | (simp only [e, PresheafOfModules.map_comp]; rfl)
          | (rw [e]; simp [PresheafOfModules.map_comp])
          | (rw [e]; simp)
      · have e : (hT.from (Opposite.unop (Opposite.op T))).op = 𝟙 (Opposite.op T) :=
          huniq _ _ _
        show (PresheafOfModules.sectionsMk _ _).1 (Opposite.op T) = x
        first
          | (simp only [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
          | (rw [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
          | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom x = x
             rw [e, PresheafOfModules.map_id]; rfl)
          | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom x = x
             rw [e]; simp)

  let P : ((Spec (.of Ω)).Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
    (Functor.const ((Spec (.of Ω)).Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod m)))
  let α : P ⟶ R.obj := toSheafify J P
  haveI hαinj : Presheaf.IsLocallyInjective J α := Presheaf.isLocallyInjective_toSheafify' J P
  haveI hαsurj : Presheaf.IsLocallySurjective J α := Presheaf.isLocallySurjective_toSheafify' J P

  have F1 : ∀ S : Sieve T, S ∈ J T →
      ∃ (V : (Spec (.of Ω)).Etale) (f : V ⟶ T), S.arrows f ∧ Nonempty V.left := by
    intro S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale _ _ at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have h := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    obtain ⟨V, f, y, hf, _, _⟩ := h (IsLocalRing.closedPoint Ω)
    exact ⟨V, f, hf, ⟨y⟩⟩

  have F2 : ∀ (V : (Spec (.of Ω)).Etale) (f : V ⟶ T), Nonempty V.left →
      Sieve.generate (Presieve.singleton f) ∈ J T := by
    intro V f hne
    obtain ⟨v⟩ := hne
    change _ ∈ Scheme.smallGrothendieckTopology @Etale _ _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    have hw : f.left ≫ T.hom = V.hom := MorphismProperty.Over.w f
    have hEt : Etale f.left := by
      have h1 : Etale T.hom := T.prop
      have h2 : Etale (f.left ≫ T.hom) := by rw [hw]; exact V.prop
      exact Etale.of_comp f.left T.hom
    exact ⟨V, f, v, ⟨V, 𝟙 V, f, Presieve.singleton_self f, Category.id_comp f⟩, hEt,
      Subsingleton.elim (α := PrimeSpectrum Ω) _ _⟩
  have hsep := Sheaf.isSeparated R
  have injR : ∀ (V : (Spec (.of Ω)).Etale) (f : V ⟶ T), Nonempty V.left →
      Function.Injective (ConcreteCategory.hom (R.obj.map f.op)) := by
    intro V f hne x y hxy
    apply hsep _ _ (F2 V f hne) x y
    intro W g hg
    obtain ⟨W', h, f', hf', rfl⟩ := hg
    cases hf'
    simp only [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, hxy]
  have hαT : Function.Bijective (ConcreteCategory.hom (α.app (Opposite.op T))) := by
    constructor
    · intro a b hab
      have hmem := Presheaf.equalizerSieve_mem J α a b hab
      obtain ⟨V, f, hf, -⟩ := F1 _ hmem
      exact hf
    · intro s
      have hmem := Presheaf.imageSieve_mem J α s
      obtain ⟨V, f, hf, hne⟩ := F1 _ hmem
      obtain ⟨t, ht⟩ := hf
      refine ⟨t, ?_⟩
      apply injR V f hne
      rw [← ht]
      exact (NatTrans.naturality_apply α f.op t).symm

  let E₀ : ZMod m ≃+ R.obj.obj (Opposite.op T) :=
    (AddEquiv.ulift (α := ZMod m)).symm.trans
      (AddEquiv.ofBijective (ConcreteCategory.hom (α.app (Opposite.op T))) hαT)
  have hE₀ : E₀ 1 = 1 := by
    show ConcreteCategory.hom (α.app (Opposite.op T)) (ULift.up 1) = 1
    exact map_one _
  let evH : (U ⟶ U) →+ R.obj.obj (Opposite.op T) :=
    AddMonoidHom.mk' (fun g => (g.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)))
      (fun g g' => by
        first
          | rfl
          | simp [SheafOfModules.add_val, PresheafOfModules.add_app])
  let Eev : (U ⟶ U) ≃+ R.obj.obj (Opposite.op T) := AddEquiv.ofBijective evH (hev U)
  have hEev : Eev.symm 1 = 𝟙 U := by
    rw [AddEquiv.symm_apply_eq]
    rfl
  haveI := Dx.additive
  let Eμ : (U ⟶ U) ≃+ (Dx.Φ.obj UX ⟶ U) :=
    { toFun := fun f => Dx.μ.hom ≫ f
      invFun := fun g => Dx.μ.inv ≫ g
      left_inv := fun f => by simp
      right_inv := fun g => by simp
      map_add' := fun f f' => by simp }
  let EA := Dx.adj.homAddEquiv UX U
  let E₁ : (U ⟶ U) ≃+ (UX ⟶ wcEtSuppObj Dx) := Eμ.trans EA
  have hE₁ : E₁ (𝟙 U) = wcEtSuppUnitMap Dx := by
    show Dx.adj.homEquiv UX U (Dx.μ.hom ≫ 𝟙 U) = _
    rw [Category.comp_id, Adjunction.homEquiv_unit]
    rfl
  refine ⟨E₀.trans (Eev.symm.trans E₁), ?_⟩
  rw [AddEquiv.trans_apply, AddEquiv.trans_apply, hE₀, hEev, hE₁]

theorem wc_et_resolution_lift {S' : Scheme.{u}} {w : S' ⟶ S'} {m : ℕ} (Dw : wcEtPullData w m) :
    ∃ (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S' m)))
      (t : haveI := Dw.additive
        (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex),
      haveI := Dw.additive
      (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dw.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ)) ≫
        I.ι' :=
by
  classical
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim

  have hEI : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}), EnoughInjectives (SheafOfModules.{u+1} R) := by
    intro C _ J _ _ R
    have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
      let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
        (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
      have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
          uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
            φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
        intro X M N φ h
        rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
        rfl
      have hsep : (ObjectProperty.ofObj G).IsSeparating := by
        intro M N f g hfg
        apply PresheafOfModules.hom_ext
        intro Y
        obtain ⟨X⟩ := Y
        ext m
        let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
          (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
        have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
        have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
          ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
        rw [key, key] at h2
        have h3 : uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
          e.apply_symm_apply m
        rw [h3] at h2
        exact h2
      exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
    have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
      ⟨fun K _ _ =>
        haveI := HasExactColimitsOfShape.domain_of_functor K
          (PresheafOfModules.toPresheaf.{u+1} R.obj)
        (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
    have hs : HasSeparator (SheafOfModules.{u+1} R) :=
      HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
    exact @IsGrothendieckAbelian.enoughInjectives _ _ _
      (IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance h5 hs)
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing S' m)) :=
    hEI (Scheme.smallEtaleTopology S') (wcEtZModRing S' m)
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing S' m))

  have lift : ∀ {A X L : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ}
      [L.IsKInjective] (g : A ⟶ X) [QuasiIso g] (f : A ⟶ L),
      ∃ t : X ⟶ L, Nonempty (Homotopy (g ≫ t) f) := by
    intro A X L _ g _ f
    let e := DerivedCategory.quotientCompQhIso (SheafOfModules.{u+1} (wcEtZModRing S' m))
    haveI : IsIso (DerivedCategory.Q.map g) :=
      (DerivedCategory.isIso_Q_map_iff_quasiIso _ g).2 inferInstance
    obtain ⟨τ, hτ⟩ := (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).obj X) L).2
      (e.hom.app X ≫ (inv (DerivedCategory.Q.map g) ≫ DerivedCategory.Q.map f) ≫ e.inv.app L)
    obtain ⟨t₀, ht₀⟩ := (HomotopyCategory.quotient _ (ComplexShape.up ℤ)).map_surjective τ
    have h1 : DerivedCategory.Q.map t₀ = inv (DerivedCategory.Q.map g) ≫ DerivedCategory.Q.map f := by
      rw [← NatIso.naturality_2 e.symm t₀, Functor.comp_map, ht₀, hτ]
      simp
      first
      | exact NatIso.naturality_2 e.symm f
      | (rw [← Functor.comp_map]; exact NatIso.naturality_2 e.symm f)
      | exact (e.inv.naturality_assoc f (e.hom.app L)).trans (by simp)
    have h2 : DerivedCategory.Q.map (g ≫ t₀) = DerivedCategory.Q.map f := by
      rw [Functor.map_comp, h1, IsIso.hom_inv_id_assoc]
    have h3 : DerivedCategory.Qh.map ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).map (g ≫ t₀)) =
        DerivedCategory.Qh.map ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).map f) := by
      rw [← Functor.comp_map, ← Functor.comp_map, ← NatIso.naturality_2 e, ← NatIso.naturality_2 e, h2]
    exact ⟨t₀, ⟨HomotopyCategory.homotopyOfEq _ _ ((CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).obj A) L).1 h3)⟩⟩

  have rigid : ∀ {A L : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ}
      (_hA : ∀ i : ℤ, i ≠ 0 → Limits.IsZero (A.X i)) [L.IsStrictlyGE 0] {φ ψ : A ⟶ L}
      (_h : Homotopy φ ψ), φ = ψ := by
    intro A L hA _ φ ψ h
    apply HomologicalComplex.hom_ext
    intro i
    by_cases hi : i = 0
    · subst hi
      rw [h.comm 0, dNext_eq h.hom (show (ComplexShape.up ℤ).Rel 0 1 by simp),
        prevD_eq h.hom (show (ComplexShape.up ℤ).Rel (-1) 0 by simp),
        (hA 1 one_ne_zero).eq_of_tgt (A.d 0 1) 0,
        (CochainComplex.isZero_of_isStrictlyGE L 0 (-1)).eq_of_tgt (h.hom 0 (-1)) 0]
      simp
    · exact (hA i hi).eq_of_src _ _
  let I := InjectiveResolution.of (SheafOfModules.unit (wcEtZModRing S' m))
  have hq : QuasiIso ((Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι') := by
    haveI : Dw.Φ.PreservesHomology := Functor.preservesHomologyOfExact Dw.Φ
    exact HomologicalComplex.quasiIso_map_of_preservesHomology I.ι' Dw.Φ
  have hA : ∀ i : ℤ, i ≠ 0 → Limits.IsZero (((Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((CochainComplex.singleFunctor _ 0).obj (SheafOfModules.unit (wcEtZModRing S' m)))).X i) := by
    intro i hi
    exact Dw.Φ.map_isZero (HomologicalComplex.isZero_single_obj_X _ 0 _ i hi)
  obtain ⟨t, ⟨h⟩⟩ := lift (L := I.cochainComplex)
    ((Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι')
    ((HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dw.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ)) ≫
        I.ι')
  exact ⟨I, t, rigid hA h⟩

theorem wc_et_ePsi_T {S S' Z : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {g : Z ⟶ S} {m : ℕ}
    (hcomp : w ≫ f = f) (Df : wcEtPullData f m) (Dw : wcEtPullData w m) (Dg : wcEtPullData g m)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S' m))) :
    haveI := Df.cont
    haveI := Dw.cont
    haveI : (wcEtBaseChange f ⋙ wcEtBaseChange w).IsContinuous (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
    let α : wcEtBaseChange f ⟶ wcEtBaseChange f ⋙ wcEtBaseChange w :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) w f f hcomp.symm).hom
    haveI := Df.additive
    haveI := Dw.additive
    haveI := Dg.additive
    ∀ (hφ : (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dw.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).app (wcEtZModRing S' m) = Df.φ)
      (t : (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex),
      (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dw.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing S m)) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Z m)) (ComplexShape.up ℤ) 0).map
          Dg.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing S m)) ≫
        (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dw.Φ ⋙ Pw from Dw.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dw.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    let TΨ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
    eΨ ≫ TΨ = eΨ :=
by
  haveI := Df.cont
  haveI := Dw.cont
  haveI := Df.additive
  haveI := Dw.additive
  haveI := Dg.additive
  intro α hφ t ht P K eK eΨ Ψ Pw γ Tflat T TΨ
  haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
  haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj

  have hU : @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ ≫
      P.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ) ≫
      γ.app (SheafOfModules.unit (wcEtZModRing S' m)) =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    ext
    simp only [γ, P, SheafOfModules.comp_val, PresheafOfModules.comp_app, NatTrans.comp_app,
      ConcreteCategory.comp_apply, ModuleCat.comp_apply,
      SheafOfModules.pushforward_map_val, PresheafOfModules.pushforward_map_app_apply,
      SheafOfModules.unitToPushforwardObjUnit_val_app_apply,
      SheafOfModules.pushforwardComp_hom_app_val_app,
      SheafOfModules.pushforwardNatTrans_app_val_app,
      SheafOfModules.pushforwardCongr_hom_app_val_app]
    exact congrArg (fun χ => (χ.hom.app X).hom (1 : (wcEtZModRing S m).obj.obj X)) hφ

  have h0 : ∀ uw : SheafOfModules.unit (wcEtZModRing S' m) ⟶ Pw.obj (SheafOfModules.unit (wcEtZModRing S' m)),
      (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map ((Dw.adj.homEquiv _ _).symm uw) ≫
        I.ι' →
      Dw.Φ.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
          (SheafOfModules.unit (wcEtZModRing S' m))).inv ≫ I.ι'.f 0) ≫ t.f 0 =
        (Dw.adj.homEquiv _ _).symm uw ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
          (SheafOfModules.unit (wcEtZModRing S' m))).inv ≫ I.ι'.f 0 := by
    intro uw ht'
    have h := congrArg (fun χ => Dw.Φ.map (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
      (SheafOfModules.unit (wcEtZModRing S' m))).inv ≫ χ.f 0) ht'
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
      HomologicalComplex.singleMapHomologicalComplex_hom_app_self,
      HomologicalComplex.single_map_f_self, Category.assoc, Iso.inv_hom_id_assoc] at h
    rw [CategoryTheory.Functor.map_comp, Category.assoc, h, ← CategoryTheory.Functor.map_comp_assoc,
      Iso.inv_hom_id, CategoryTheory.Functor.map_id, Category.id_comp]

  have hinner : ∀ {One : SheafOfModules (wcEtZModRing S m)}
      (u : One ⟶ P.obj (SheafOfModules.unit (wcEtZModRing S' m)))
      (uw : SheafOfModules.unit (wcEtZModRing S' m) ⟶ Pw.obj (SheafOfModules.unit (wcEtZModRing S' m))),
      u ≫ P.map uw ≫ γ.app (SheafOfModules.unit (wcEtZModRing S' m)) = u →
      ∀ {I0 : SheafOfModules (wcEtZModRing S' m)} (j : SheafOfModules.unit (wcEtZModRing S' m) ⟶ I0)
        (t0 : Dw.Φ.obj I0 ⟶ I0),
      Dw.Φ.map j ≫ t0 = (Dw.adj.homEquiv _ _).symm uw ≫ j →
      u ≫ P.map j ≫ P.map (Dw.adj.unit.app I0) ≫ P.map (Pw.map t0) ≫ γ.app I0 = u ≫ P.map j := by
    intro One u uw hU' I0 j t0 hj
    have e1 : j ≫ Dw.adj.unit.app I0 ≫ Pw.map t0 = uw ≫ Pw.map j := by
      rw [← Category.assoc, ← Dw.adj.unit_naturality, Category.assoc, ← Pw.map_comp, hj, Pw.map_comp,
        ← Category.assoc, ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
    have e2 : P.map j ≫ P.map (Dw.adj.unit.app I0) ≫ P.map (Pw.map t0) =
        P.map uw ≫ (Pw ⋙ P).map j := by
      rw [← P.map_comp, ← P.map_comp, e1, P.map_comp, Functor.comp_map]
    calc u ≫ P.map j ≫ P.map (Dw.adj.unit.app I0) ≫ P.map (Pw.map t0) ≫ γ.app I0
        = u ≫ (P.map j ≫ P.map (Dw.adj.unit.app I0) ≫ P.map (Pw.map t0)) ≫ γ.app I0 := by
          simp only [Category.assoc]
      _ = u ≫ (P.map uw ≫ (Pw ⋙ P).map j) ≫ γ.app I0 := by rw [e2]
      _ = u ≫ P.map uw ≫ γ.app _ ≫ P.map j := by rw [Category.assoc, γ.naturality]
      _ = u ≫ P.map j := by rw [reassoc_of% hU']
  have hmain := hinner _ _ hU _ (t.f 0) (h0 _ ht)
  simp only [CategoryTheory.Functor.map_comp, Category.assoc] at hmain

  have hK : eK ≫ T = eK := by
    apply HomologicalComplex.from_single_hom_ext
    simp only [eK, T, Tflat, HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
      HomologicalComplex.single_map_f_self, HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
      Functor.mapHomologicalComplexIdIso_inv_app_f, NatTrans.mapHomologicalComplex_app_f,
      Functor.mapHomologicalComplexCompIso_hom_app_f, Functor.mapHomologicalComplexCompIso_inv_app_f,
      Iso.refl_hom, Iso.refl_inv, NatTrans.id_app, Category.assoc, Category.id_comp,
      Functor.id_obj, Functor.comp_obj, Functor.mapHomologicalComplex_obj_X,
      CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_id, Iso.inv_hom_id_assoc]
    erw [Iso.inv_hom_id_assoc]
    rw [hmain]
    first
    | rfl
    | (erw [Iso.inv_hom_id_assoc])
    | (simp only [P, Iso.inv_hom_id_assoc])

  first
  | (simp only [eΨ, TΨ, Category.assoc]; rw [← CategoryTheory.Functor.map_comp, hK])
  | (simp only [eΨ, TΨ, Category.assoc, ← CategoryTheory.Functor.map_comp, hK])

theorem wc_et_beta_equivariant {S S' Z : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {g : Z ⟶ S} {m : ℕ}
    (hcomp : w ≫ f = f) (Df : wcEtPullData f m) (Dw : wcEtPullData w m) (Dg : wcEtPullData g m)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S' m))) (N : ℕ) :
    haveI := Df.cont
    haveI := Dw.cont
    haveI : (wcEtBaseChange f ⋙ wcEtBaseChange w).IsContinuous (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
    let α : wcEtBaseChange f ⟶ wcEtBaseChange f ⋙ wcEtBaseChange w :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) w f f hcomp.symm).hom
    haveI := Df.additive
    haveI := Dw.additive
    haveI := Dg.additive
    ∀ (hφ : (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dw.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).app (wcEtZModRing S' m) = Df.φ)
      (t : (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex),
      (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dw.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing S m)) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing S' m)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Z m)) (ComplexShape.up ℤ) 0).map
          Dg.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing S m)) ≫
        (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dw.Φ ⋙ Pw from Dw.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dw.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    let TΨ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing Z m))
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' m)) := HasExt.standard _
    let F := P ⋙ Dg.Φ
    let Hq := HomotopyCategory.quotient (SheafOfModules.{u+1} (wcEtZModRing Z m)) (ComplexShape.up ℤ)
    let Hq' := HomotopyCategory.quotient (SheafOfModules.{u+1} (wcEtZModRing S' m)) (ComplexShape.up ℤ)
    let c := fun y : wcEtZModExt S' m N =>
      (show Hq.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing Z m))) ⟶ (Hq.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        Hq.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
              (Dg.μ.inv ≫ Dg.Φ.map
                (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ))) ≫
          Hq.map ((HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).inv.app
              (SheafOfModules.unit (wcEtZModRing S' m))) ≫
          (F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
