        ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A' ⟶ A)
          (x : H A'.right), (F.obj.map f.right.op).hom s = ψ A'.right x) →
