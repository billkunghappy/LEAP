      (((v₀ ≫ ψ) ≫ e) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback
        (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs)))).asIdeal := by
