    HasExt.standard _


  have alg : ∀ {G : Type (u+2)} [AddCommGroup G] (j : ℕ), (∀ w : G, (ℓ ^ j) • w = 0) →
      (1 ≤ j → Finite G ∧ Nat.card G ≤ ℓ ^ j ∧ ∃ w : G, ℓ ^ (j - 1) • w ≠ 0) →
