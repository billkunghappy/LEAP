  · obtain ⟨hac, hprop, hconn, Xt, E, b, iE, hbp, hiE, hne, hiso, hrange, hsmX, hsmE⟩ :=
      wc_et_tpl_opc_fibre_blowup F' F'' Y n hn2 D i A Λ W' φ a hA x hx xs hxs
