  have hLin0' : ∀ {b c d : ℕ} (L₁ : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin c → ℚ_[ℓ]))
      (L₂ : (Fin c → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin d → ℚ_[ℓ])),
