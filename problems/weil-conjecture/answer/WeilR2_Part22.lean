theorem wc_hss_sections_give_kernels : ∀ (F A : Type u) [Field F] [CommRing A] [Algebra F A] (T Q : Scheme.{u}) (q : Q ⟶ T) (e₁ : T ≅ Spec (.of F)) (eQ : Q ≅ Spec (.of A)), eQ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F A)) = q ≫ e₁.hom → (∀ y : Q, ∃ sec : T ⟶ Q, sec ≫ q = 𝟙 T ∧ y ∈ Set.range ⇑sec) → ∀ P : Ideal A, P.IsPrime → ∃ ψ : A →ₐ[F] F, RingHom.ker ψ = P :=
by
  intro F A _ _ _ T Q q e₁ eQ hcomm hsec P hP
  let p : Spec (CommRingCat.of A) := ⟨P, hP⟩
  obtain ⟨sec, hsq, t, ht⟩ := hsec (eQ.inv p)
  let s : Spec (CommRingCat.of F) ⟶ Spec (CommRingCat.of A) := e₁.inv ≫ sec ≫ eQ.hom
  let φ : CommRingCat.of A ⟶ CommRingCat.of F := Spec.preimage s
  have hφ : Spec.map φ = s := Spec.map_preimage s
  have hs : s ≫ Spec.map (CommRingCat.ofHom (algebraMap F A)) = 𝟙 _ := by
    simp only [s, Category.assoc, hcomm]
    rw [reassoc_of% hsq]
    simp
  have hret : CommRingCat.ofHom (algebraMap F A) ≫ φ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hφ, hs, Spec.map_id]
  have hret' : ∀ r : F, φ.hom (algebraMap F A r) = r := by
    intro r
    have := congrArg (fun g => g.hom r) hret
    simpa using this
  let ψ : A →ₐ[F] F := { φ.hom with commutes' := fun r => by simpa using hret' r }
  refine ⟨ψ, ?_⟩
  have hz : (Spec.map φ) (e₁.hom t) = p := by
    rw [hφ]
    show eQ.hom (sec (e₁.inv (e₁.hom t))) = p
    rw [Scheme.hom_inv_apply, ht, Scheme.inv_hom_apply]
  let z : PrimeSpectrum F := e₁.hom t
  have hP' : P = Ideal.comap φ.hom z.asIdeal := by
    have := congrArg PrimeSpectrum.asIdeal hz
    rw [Spec.map_apply] at this
    exact this.symm
  have hbot : z.asIdeal = ⊥ := @Ideal.eq_bot_of_prime _ _ z.asIdeal z.isPrime
  rw [hP', hbot, ← RingHom.ker_eq_comap_bot]
  rfl

