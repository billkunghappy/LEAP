    rw [hlXj] at h3
    exact hj h3
  ·
    have hsq' : O.ι ≫ jU ≫ Limits.pullback.snd D.f a = O.ι ≫ eU ≫ wcQuadModelStr A n π c := by
      rw [hsq]
