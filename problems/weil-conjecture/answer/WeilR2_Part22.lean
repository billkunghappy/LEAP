      Spec.map (CommRingCat.ofHom (algebraMap H (FractionRing H))) := by
    rw [Iso.inv_comp_eq]; exact he₁.symm
  have heq : (e₁.inv ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) ≫ U.ι =
      Spec.map (CommRingCat.ofHom κ) ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (FractionRing (X.presheaf.stalk x)))) ≫ X.fromSpecStalk x := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hfst, ← Category.assoc,
      ← Spec.map_comp, ← CommRingCat.ofHom_comp, hring, CommRingCat.ofHom_comp, Spec.map_comp,
      Category.assoc]
  have h1 := IsPullback.of_hasPullback πE
    (Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι)
  have h2 : IsPullback
      (Limits.pullback.fst πE (Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι))
      (Limits.pullback.snd πE (Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) ≫ e₁.hom)
      πE (e₁.inv ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) :=
    IsPullback.of_iso h1 (Iso.refl _) (Iso.refl _) e₁ (Iso.refl _) (by simp) (by simp) (by simp)
      (by simp)
  have h3 : IsPullback
      (Limits.pullback.fst πE (Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι))
      (Limits.pullback.snd πE (Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) ≫ e₁.hom)
      (πE ≫ U.ι) ((e₁.inv ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) ≫ U.ι) :=
