    exact ⟨x₁, by rw [hδ]; exact hx₁⟩
  exact ⟨Ψe.symm.trans (AddEquiv.ofBijective δ ⟨hinj, hsurj⟩)⟩

theorem wc_node_cone_hyp_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (c : Matrix (Fin 2) (Fin 2) K), IsUnit (c + c.transpose).det → ∃ e : Spec (.of (wcQuadModelRing K 2 0 c)) ⟶ Spec (.of (wcQuadModelRing K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))), IsIso e ∧ ∀ y : Spec (.of (wcQuadModelRing K 2 0 c)), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) ∈ y.asIdeal) ↔ (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∈ (e y).asIdeal) :=
by
  classical
  intro K _ _ c hc

  set h : Matrix (Fin 2) (Fin 2) K := Matrix.of fun p q : Fin 2 =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 with hh

  have hdet : (c + c.transpose).det = 4 * c 0 0 * c 1 1 - (c 0 1 + c 1 0) ^ 2 := by
    rw [Matrix.det_fin_two]
    simp only [Matrix.add_apply, Matrix.transpose_apply]
    ring
  have hdet0 : (c + c.transpose).det ≠ 0 := hc.ne_zero
  obtain ⟨r, hr⟩ : ∃ r : K, c 0 0 * r ^ 2 + (c 0 1 + c 1 0) * r + c 1 1 = 0 := by
    by_cases ha : c 0 0 = 0
    · have hs : c 0 1 + c 1 0 ≠ 0 := by
        intro hs
        apply hdet0
        rw [hdet, ha, hs]
        ring
      refine ⟨-(c 1 1) / (c 0 1 + c 1 0), ?_⟩
      rw [ha]
      field_simp
      ring
    · obtain ⟨r, hr⟩ := IsAlgClosed.exists_root
        (Polynomial.C (c 0 0) * Polynomial.X ^ 2 + Polynomial.C (c 0 1 + c 1 0) * Polynomial.X +
          Polynomial.C (c 1 1))
        (by rw [Polynomial.degree_quadratic ha]; norm_num)
      refine ⟨r, ?_⟩
      simpa [Polynomial.IsRoot] using hr
  have hD : c 0 1 + c 1 0 + 2 * c 0 0 * r ≠ 0 := by
    intro hD
    apply hdet0
    rw [hdet]
    have : (c 0 1 + c 1 0 + 2 * c 0 0 * r) ^ 2 =
        -(4 * c 0 0 * c 1 1 - (c 0 1 + c 1 0) ^ 2) +
          4 * c 0 0 * (c 0 0 * r ^ 2 + (c 0 1 + c 1 0) * r + c 1 1) := by ring
    rw [hD, hr] at this
    linear_combination this
  set Di : K := (c 0 1 + c 1 0 + 2 * c 0 0 * r)⁻¹ with hDidef
  have hDi : Di * (c 0 1 + c 1 0 + 2 * c 0 0 * r) = 1 := inv_mul_cancel₀ hD
  have hDi0 : Di ≠ 0 := inv_ne_zero hD
  have hNF : ∃ P : Matrix (Fin 2) (Fin 2) K, IsUnit P.det ∧
      (∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C ((P.transpose * c * P) p q) *
        MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin 2) K) =
      ∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C (h p q) *
        MvPolynomial.X p * MvPolynomial.X q := by
    refine ⟨!![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di], ?_, ?_⟩
    · rw [isUnit_iff_ne_zero, Matrix.det_fin_two_of]
      have e : Di * (c 0 1 + c 1 0 + c 0 0 * r) * Di - Di * r * -(Di * c 0 0) = Di := by
        linear_combination Di * hDi
      rw [e]
      exact hDi0
    · have hexp : ∀ M : Matrix (Fin 2) (Fin 2) K,
          (∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C (M p q) *
            MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin 2) K) =
          MvPolynomial.C (M 0 0) * MvPolynomial.X 0 * MvPolynomial.X 0 +
          MvPolynomial.C (M 0 1 + M 1 0) * MvPolynomial.X 0 * MvPolynomial.X 1 +
          MvPolynomial.C (M 1 1) * MvPolynomial.X 1 * MvPolynomial.X 1 := by
        intro M
        simp only [Fin.sum_univ_two, map_add]
        ring
      rw [hexp, hexp]
      have h00 : h 0 0 = 0 := by simp [hh]
      have h01 : h 0 1 + h 1 0 = 1 := by simp [hh]
      have h11 : h 1 1 = 0 := by simp [hh]
      rw [h00, h01, h11]
      have m00 : ((!![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]).transpose * c *
          !![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]) 0 0 = 0 := by
        simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.transpose_apply, Matrix.of_apply,
          Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
          Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const]
        linear_combination (Di ^ 2 * c 0 0 ^ 2) * hr
      have m11 : ((!![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]).transpose * c *
          !![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]) 1 1 = 0 := by
        simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.transpose_apply, Matrix.of_apply,
          Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
          Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const]
        linear_combination (Di ^ 2) * hr
      have m01 : ((!![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]).transpose * c *
          !![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]) 0 1 +
          ((!![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]).transpose * c *
          !![Di * (c 0 1 + c 1 0 + c 0 0 * r), Di * r; -(Di * c 0 0), Di]) 1 0 = 1 := by
        simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.transpose_apply, Matrix.of_apply,
          Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
          Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const]
        linear_combination (-2 * c 0 0 * Di ^ 2) * hr +
          (Di * (c 0 1 + c 1 0 + 2 * c 0 0 * r) + 1) * hDi
      rw [m00, m11, m01]

  obtain ⟨P, hP, hQ⟩ := hNF
  let Xv : Fin 2 → MvPolynomial (Fin 2) K := fun i => MvPolynomial.X i
  let lin : Matrix (Fin 2) (Fin 2) K → Fin 2 → MvPolynomial (Fin 2) K :=
    fun M => Matrix.mulVec (M.map MvPolynomial.C) Xv
  have hlin : ∀ M i, lin M i = ∑ q, MvPolynomial.C (M i q) * MvPolynomial.X q := by
    intro M i
    simp only [lin, Xv, Matrix.mulVec, dotProduct, Matrix.map_apply]
  let φ : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K := MvPolynomial.aeval (lin P)
  let φ' : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K := MvPolynomial.aeval (lin P⁻¹)
  have hcomp : ∀ (M N : Matrix (Fin 2) (Fin 2) K), M * N = 1 → ∀ i,
      MvPolynomial.aeval (lin N) (lin M i) = Xv i := by
    intro M N hMN i
    have e1 : MvPolynomial.aeval (lin N) (lin M i) =
        Matrix.mulVec (M.map MvPolynomial.C) (lin N) i := by
      rw [hlin]
      simp [Matrix.mulVec, dotProduct, map_sum, map_mul]
    rw [e1]
    show Matrix.mulVec (M.map MvPolynomial.C) (Matrix.mulVec (N.map MvPolynomial.C) Xv) i = Xv i
    rw [Matrix.mulVec_mulVec, ← Matrix.map_mul, hMN, Matrix.map_one _ (map_zero _) (map_one _),
      Matrix.one_mulVec]
  have hb : φ.comp φ' = AlgHom.id K (MvPolynomial (Fin 2) K) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, AlgHom.id_apply, φ, φ', MvPolynomial.aeval_X]
    exact hcomp P⁻¹ P (Matrix.nonsing_inv_mul P hP) i
  have hc' : φ'.comp φ = AlgHom.id K (MvPolynomial (Fin 2) K) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, AlgHom.id_apply, φ, φ', MvPolynomial.aeval_X]
    exact hcomp P P⁻¹ (Matrix.mul_nonsing_inv P hP) i
  let Φ : MvPolynomial (Fin 2) K ≃ₐ[K] MvPolynomial (Fin 2) K := AlgEquiv.ofAlgHom φ φ' hb hc'
  have hform : ∀ (M : Matrix (Fin 2) (Fin 2) K) (w : Fin 2 → MvPolynomial (Fin 2) K),
      ∑ p, ∑ q, MvPolynomial.C (M p q) * w p * w q =
        dotProduct w (Matrix.mulVec (M.map MvPolynomial.C) w) := by
    intro M w
    simp only [dotProduct, Matrix.mulVec, Matrix.map_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by ring
  have hφQ : φ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
      ∑ p, ∑ q, MvPolynomial.C (h p q) * MvPolynomial.X p * MvPolynomial.X q := by
    rw [← hQ]
    have e1 : φ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        ∑ p, ∑ q, MvPolynomial.C (c p q) * lin P p * lin P q := by
      simp [φ, map_sum, map_mul]
    rw [e1, hform, hform (P.transpose * c * P) (fun i => MvPolynomial.X i)]
    show dotProduct (Matrix.mulVec (P.map MvPolynomial.C) Xv)
        (Matrix.mulVec (c.map MvPolynomial.C) (Matrix.mulVec (P.map MvPolynomial.C) Xv)) =
      dotProduct Xv (Matrix.mulVec ((P.transpose * c * P).map MvPolynomial.C) Xv)
    rw [dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, dotProduct_comm,
      Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.map_mul, Matrix.map_mul,
      Matrix.transpose_map, Matrix.mul_assoc]
  have hIJ : wcQuadModelIdeal K 2 0 h =
      Ideal.map (Φ.toRingEquiv : MvPolynomial (Fin 2) K →+* MvPolynomial (Fin 2) K)
        (wcQuadModelIdeal K 2 0 c) := by
    simp only [wcQuadModelIdeal, Ideal.map_span, Set.image_singleton]
    congr 1
    rw [Set.singleton_eq_singleton_iff]
    show _ = φ _
    rw [map_sub, hφQ]
    simp
  let ψ : wcQuadModelRing K 2 0 c ≃+* wcQuadModelRing K 2 0 h :=
    Ideal.quotientEquiv _ _ Φ.toRingEquiv hIJ
  have hψ : ∀ x : MvPolynomial (Fin 2) K, ψ (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) x) =
      Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 h) (φ x) := fun x =>
    Ideal.quotientEquiv_mk _ _ _ _ x
  have hψ' : ∀ x : MvPolynomial (Fin 2) K,
      ψ.symm (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 h) x) =
      Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (φ' x) := by
    intro x
    apply ψ.injective
    rw [RingEquiv.apply_symm_apply, hψ]
    congr 1
    rw [← AlgHom.comp_apply, hb, AlgHom.id_apply]
  let e : Spec (.of (wcQuadModelRing K 2 0 c)) ⟶ Spec (.of (wcQuadModelRing K 2 0 h)) :=
    Spec.map ψ.symm.toCommRingCatIso.hom
  have hpt : ∀ (y : Spec (.of (wcQuadModelRing K 2 0 c))) (x : wcQuadModelRing K 2 0 h),
      x ∈ (e y).asIdeal ↔ ψ.symm x ∈ y.asIdeal := by
    intro y x
    rfl
  refine ⟨e, inferInstance, fun y => ?_⟩
  simp only [hpt]
  constructor
  · intro H p
    rw [hψ']
    simp only [φ', MvPolynomial.aeval_X, hlin, map_sum, map_mul]
    exact Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ (H r)
  · intro H p
    have e0 : Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 c) (MvPolynomial.X p) =
        ψ.symm (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 h) (φ (MvPolynomial.X p))) := by
      rw [← hψ, RingEquiv.symm_apply_apply]
    rw [e0]
    simp only [φ, MvPolynomial.aeval_X, hlin, map_sum, map_mul]
    exact Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ (H r)

theorem wc_node_hyp_cone_punct_split : ∀ (K : Type u) [Field K] (Oc : (Spec (.of (wcQuadModelRing K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens), (Oc : Set (Spec (.of (wcQuadModelRing K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) = {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} → ∃ (U V : (Oc : Scheme.{u}).Opens), Disjoint U V ∧ U ⊔ V = ⊤ ∧ Nonempty ((U : Scheme.{u}) ≅ Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K)))) ∧ Nonempty ((V : Scheme.{u}) ≅ Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K)))) :=
by
  intro K _ Oc hOc
  classical
  have ringPart : ∀ (I : Ideal (MvPolynomial (Fin 2) K)),
      I = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} → ∀ (i : Fin 2)
      (a : MvPolynomial (Fin 2) K ⧸ I), a = Ideal.Quotient.mk I (MvPolynomial.X i) →
      ∀ (x0 : MvPolynomial (Fin 1) K), x0 = MvPolynomial.X 0 →
      Nonempty (Localization.Away a ≃+* Localization.Away x0) := by
    intro I hI i a ha x0 hx0
    have hT : IsUnit (algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0) x0) :=
      IsLocalization.Away.algebraMap_isUnit _
    have hιa : IsUnit (algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a) a) :=
      IsLocalization.Away.algebraMap_isUnit a
    have hab : Ideal.Quotient.mk I (MvPolynomial.X 0) * Ideal.Quotient.mk I (MvPolynomial.X 1)
        = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hI]
      exact Ideal.subset_span rfl
    have hj : ∀ j, j ≠ i → algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a)
        (Ideal.Quotient.mk I (MvPolynomial.X j)) = 0 := by
      intro j hji
      have hz : a * Ideal.Quotient.mk I (MvPolynomial.X j) = 0 := by
        rw [ha]
        fin_cases i <;> fin_cases j
        · exact absurd rfl hji
        · exact hab
        · rw [mul_comm]; exact hab
        · exact absurd rfl hji
      have h0 : algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a) a *
          algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a)
            (Ideal.Quotient.mk I (MvPolynomial.X j)) = 0 := by
        rw [← map_mul, hz, map_zero]
      exact (hιa.mul_right_eq_zero).mp h0
    let κ : K →+* Localization.Away x0 :=
      (algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0)).comp MvPolynomial.C
    have hκ : ∀ r, κ r = algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0)
        (MvPolynomial.C r) := fun r => rfl
    let φ : MvPolynomial (Fin 2) K →+* Localization.Away x0 :=
      MvPolynomial.eval₂Hom κ (fun j => if j = i then
        algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0) x0 else 0)
    have hφX : ∀ j, φ (MvPolynomial.X j) = if j = i then
        algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0) x0 else 0 := fun j =>
      MvPolynomial.eval₂Hom_X' _ _ _
    have hφC : ∀ r, φ (MvPolynomial.C r) = κ r := fun r => MvPolynomial.eval₂Hom_C _ _ _
    have hφ : ∀ g ∈ I, φ g = 0 := by
      intro g hg
      rw [hI, Ideal.mem_span_singleton'] at hg
      obtain ⟨c, rfl⟩ := hg
      rw [map_mul, map_mul, hφX, hφX]
      fin_cases i <;> simp
    let F₀ : (MvPolynomial (Fin 2) K ⧸ I) →+* Localization.Away x0 := Ideal.Quotient.lift I φ hφ
    have hF₀ : ∀ g, F₀ (Ideal.Quotient.mk I g) = φ g := fun g => Ideal.Quotient.lift_mk _ _ _
    have hF₀a : F₀ a = algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0) x0 := by
      rw [ha, hF₀, hφX, if_pos rfl]
    let F : Localization.Away a →+* Localization.Away x0 :=
      IsLocalization.Away.lift a (g := F₀) (by rw [hF₀a]; exact hT)
    let G₀ : MvPolynomial (Fin 1) K →+* Localization.Away a :=
      MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a)).comp
        ((Ideal.Quotient.mk I).comp MvPolynomial.C))
        (fun _ => algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a) a)
    have hG₀X : ∀ n, G₀ (MvPolynomial.X n) =
        algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a) a := fun n =>
      MvPolynomial.eval₂Hom_X' _ _ _
    have hG₀x0 : G₀ x0 = algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a) a := by
      rw [hx0, hG₀X]
    have hG₀C : ∀ r, G₀ (MvPolynomial.C r) =
        algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a)
          (Ideal.Quotient.mk I (MvPolynomial.C r)) :=
      fun r => MvPolynomial.eval₂Hom_C _ _ _
    let G : Localization.Away x0 →+* Localization.Away a :=
      IsLocalization.Away.lift x0 (g := G₀) (by rw [hG₀x0]; exact hιa)
    have hFι : ∀ r, F (algebraMap (MvPolynomial (Fin 2) K ⧸ I) (Localization.Away a) r) = F₀ r :=
      fun r => IsLocalization.Away.lift_eq a _ r
    have hGι : ∀ p, G (algebraMap (MvPolynomial (Fin 1) K) (Localization.Away x0) p) = G₀ p :=
      fun p => IsLocalization.Away.lift_eq x0 _ p
    have h1 : F.comp G = RingHom.id (Localization.Away x0) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x0)
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hGι, hG₀C, hFι, hF₀, hφC, hκ]
      · intro n
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hGι, hG₀X, hFι, hF₀a, hx0, Subsingleton.elim n 0]
    have h2 : G.comp F = RingHom.id (Localization.Away a) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hFι, hF₀, hφC, hκ, hGι, hG₀C]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hFι, hF₀, hφX]
        by_cases hji : j = i
        · rw [if_pos hji, hGι, hG₀x0, hji, ← ha]
        · rw [if_neg hji, map_zero, hj j hji]
    exact ⟨RingEquiv.ofRingHom F G h1 h2⟩
  have schemePart : ∀ (A : Type u) [CommRing A] (f : A) (O : (Spec (.of A)).Opens),
      (∀ x : Spec (.of A), f ∉ x.asIdeal → x ∈ O) →
      Nonempty (((O.ι ⁻¹ᵁ PrimeSpectrum.basicOpen f : (O : Scheme.{u}).Opens) : Scheme.{u}) ≅
        Spec (.of (Localization.Away f))) := by
    intro A _ f O hO
    let D : (Spec (.of A)).Opens := PrimeSpectrum.basicOpen f
    let U : (O : Scheme.{u}).Opens := O.ι ⁻¹ᵁ D
    have hmemD : ∀ x : Spec (.of A), x ∈ D ↔ f ∉ x.asIdeal := fun x => Iff.rfl
    have hmemU : ∀ y : (O : Scheme.{u}), y ∈ U ↔ O.ι y ∈ D := fun y => Iff.rfl
    have hrange : Set.range ⇑(U.ι ≫ O.ι) = Set.range ⇑D.ι := by
      rw [Scheme.Opens.range_ι]
      ext x
      constructor
      · rintro ⟨u, rfl⟩
        have hu : U.ι u ∈ Set.range U.ι := ⟨u, rfl⟩
        rw [Scheme.Opens.range_ι, SetLike.mem_coe, hmemU] at hu
        rw [Scheme.Hom.comp_apply]
        exact hu
      · intro hx
        have hx' : f ∉ x.asIdeal := (hmemD x).1 hx
        have hxO : x ∈ Set.range O.ι := by
          rw [Scheme.Opens.range_ι]; exact hO x hx'
        obtain ⟨y, rfl⟩ := hxO
        have hyU : y ∈ Set.range U.ι := by
          rw [Scheme.Opens.range_ι, SetLike.mem_coe, hmemU]; exact hx
        obtain ⟨u, rfl⟩ := hyU
        exact ⟨u, Scheme.Hom.comp_apply _ _ _⟩
    have e : (U : Scheme.{u}) ≅ (D : Scheme.{u}) := IsOpenImmersion.isoOfRangeEq (U.ι ≫ O.ι) D.ι hrange
    exact ⟨e ≪≫ basicOpenIsoSpecAway (R := CommRingCat.of A) f⟩
  have hI : wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} := by
    simp [wcQuadModelIdeal, Fin.sum_univ_two]
  have hab : Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X 0) * Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X 1) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hI]
    exact Ideal.subset_span rfl
  have hmem : ∀ x, x ∈ Oc ↔ ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ x.asIdeal := by
    intro x
    rw [← SetLike.mem_coe, hOc]
    rfl
  have hiso : ∀ i : Fin 2, Nonempty (((Oc.ι ⁻¹ᵁ PrimeSpectrum.basicOpen (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X i)) : (Oc : Scheme.{u}).Opens) : Scheme.{u}) ≅ Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K)))) := by
    intro i
    obtain ⟨eU⟩ := schemePart _ (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X i)) Oc
      (fun x hx => (hmem x).2 ⟨i, hx⟩)
    obtain ⟨e⟩ := ringPart _ hI i _ rfl _ rfl
    exact ⟨eU ≪≫ (Scheme.Spec.mapIso e.toCommRingCatIso.op).symm⟩
  refine ⟨Oc.ι ⁻¹ᵁ PrimeSpectrum.basicOpen (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X 0)),
    Oc.ι ⁻¹ᵁ PrimeSpectrum.basicOpen (Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X 1)), ?_, ?_,
    hiso 0, hiso 1⟩
  · rw [disjoint_iff, eq_bot_iff]
    intro y hy
    rw [TopologicalSpace.Opens.mem_inf] at hy
    obtain ⟨h0, h1⟩ := hy
    exfalso
    have hz : Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X 0) * Ideal.Quotient.mk (wcQuadModelIdeal K 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X 1) ∈
        (Oc.ι y).asIdeal := by
      rw [hab]; exact Ideal.zero_mem _
    rcases (Oc.ι y).isPrime.mem_or_mem hz with h | h
    · exact h0 h
    · exact h1 h
  · rw [eq_top_iff]
    intro y _
    have hy : Oc.ι y ∈ Oc := by
      have h : Oc.ι y ∈ Set.range Oc.ι := Set.mem_range_self y
      rw [Scheme.Opens.range_ι] at h
      exact h
    obtain ⟨p, hp⟩ := (hmem _).1 hy
    rw [TopologicalSpace.Opens.mem_sup]
    fin_cases p
    · left; exact hp
    · right; exact hp

theorem wc_et_laurent_zmodext_one_strict : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∃ ω : wcEtZModExt (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K)))) (ℓ ^ k) 1, ℓ ^ (k - 1) • ω ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ k hk
  have hp : ℓ.Prime := Fact.out

  have s4 : ∀ (M j : ℕ), 1 ≤ M →
      ∀ v : Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K),
      v ^ M = (algebraMap (MvPolynomial (Fin 1) K)
        (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))
        (MvPolynomial.X 0)) ^ j → M ∣ j := by
    intro M j hM v hv
    have hx0 : (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ≠ 0 := MvPolynomial.X_ne_zero 0
    obtain ⟨N, p, hpN⟩ :=
      IsLocalization.Away.surj (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K) v
    have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 1) K)
        (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))) :=
      IsLocalization.injective
        (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))
        (powers_le_nonZeroDivisors_of_noZeroDivisors hx0)
    have h1 : p ^ M = (MvPolynomial.X 0) ^ (j + N * M) := by
      apply hinj
      rw [map_pow, map_pow, ← hpN, mul_pow, hv, pow_add, ← pow_mul, mul_comm N M]
    have hp0 : p ≠ 0 := by
      rintro rfl
      rw [zero_pow (by omega)] at h1
      exact pow_ne_zero _ hx0 h1.symm
    have hdeg : ∀ m : ℕ, (p ^ m).totalDegree = m * p.totalDegree := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        rw [pow_succ, MvPolynomial.totalDegree_mul_of_isDomain (pow_ne_zero _ hp0) hp0, ih]
        ring
    have h2 := congrArg MvPolynomial.totalDegree h1
    rw [hdeg, MvPolynomial.totalDegree_X_pow] at h2
    have h3 : M ∣ j + N * M := ⟨p.totalDegree, by rw [← h2, mul_comm]⟩
    exact (Nat.dvd_add_left (dvd_mul_left M N)).mp h3

  have chase : ∀ (U : Type u) [CommGroup U] {C : Type (u+2)} [Category.{u+1} C] [Abelian C]
      [HasExt.{u+2} C] (P L G : C) (M j : ℕ) (ι : L ⟶ G) (h : ι ≫ (M • 𝟙 G) = 0),
      (ShortComplex.mk ι (M • 𝟙 G) h).ShortExact →
      (Abelian.Ext P G 0 ≃+ Additive U) → ∀ t : U, (∀ w : U, w ^ M ≠ t ^ j) →
      ∃ κ : Abelian.Ext P L 1, j • κ ≠ 0 := by
    intro U _ C _ _ _ P L G M j ι h hS eU t ht
    have hmk : ∀ (T : C) (m : ℕ),
        (Abelian.Ext.mk₀ (m • 𝟙 T) : Abelian.Ext T T 0) = m • Abelian.Ext.mk₀ (𝟙 T) := by
      intro T m
      induction m with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have hns : ∀ {X T : C} {k' : ℕ} (α : Abelian.Ext X T k') (m : ℕ),
        α.comp (Abelian.Ext.mk₀ (m • 𝟙 T)) (add_zero k') = m • α := by
      intro X T k' α m
      have hlin := map_nsmul (Abelian.Ext.bilinearComp X T T k' 0 k' (add_zero k') α) m
        (Abelian.Ext.mk₀ (𝟙 T))
      simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
      rw [Abelian.Ext.comp_mk₀_id] at hlin
      rw [hmk, hlin]
    let δ : Abelian.Ext P G 0 →+ Abelian.Ext P L 1 :=
      AddMonoidHom.mk' (fun y => y.comp hS.extClass (zero_add 1))
        (fun a b => Abelian.Ext.add_comp a b _ _)
    have hδ : ∀ y, δ y = y.comp hS.extClass (zero_add 1) := fun _ => rfl
    refine ⟨δ (eU.symm (Additive.ofMul t)), ?_⟩
    intro hj
    rw [← map_nsmul, hδ] at hj
    obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS _ (zero_add 1) hj
    have hw' : M • w = j • eU.symm (Additive.ofMul t) := by rw [← hns w M]; exact hw
    apply ht (Additive.toMul (eU w))
    have := congrArg (fun z => Additive.toMul (eU z)) hw'
    simp only [map_nsmul, toMul_nsmul, AddEquiv.apply_symm_apply, toMul_ofMul] at this
    exact this

  have hMK : ((ℓ ^ k : ℕ) : K) ≠ 0 := by rw [Nat.cast_pow]; exact pow_ne_zero k hℓ
  obtain ⟨ι, h, hS⟩ := wc_et_kummer_ses_gen K
    (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))))
    (Spec.map (CommRingCat.ofHom (algebraMap K
      (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))))) (ℓ ^ k) hMK
  obtain ⟨eU0⟩ := wc_et_gm_h0_units
    (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))))
  obtain ⟨B⟩ := wc_et_zmodext_coh_ext_addEquiv
    (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K)))) (ℓ ^ k) 1
  let t : (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))ˣ :=
    (IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K)).unit
  have ht : ∀ w : (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) K))ˣ,
      w ^ (ℓ ^ k) ≠ t ^ (ℓ ^ (k - 1)) := by
    intro w hw
    have hv := congrArg Units.val hw
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, IsUnit.unit_spec] at hv
    have hd := s4 (ℓ ^ k) (ℓ ^ (k - 1)) (Nat.one_le_pow _ _ hp.pos) (w : _) hv
    have := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hd
    omega
  obtain ⟨κ, hκ⟩ := @chase _ _ _ _ _ (HasExt.standard _) _ _ _ (ℓ ^ k) (ℓ ^ (k - 1)) ι h hS
    (eU0.trans (MulEquiv.toAdditive (Units.mapEquiv
      (Scheme.ΓSpecIso (CommRingCat.of (Localization.Away (MvPolynomial.X (0 : Fin 1) :
        MvPolynomial (Fin 1) K)))).commRingCatIsoToRingEquiv.toMulEquiv))) t ht
  refine ⟨B.symm κ, ?_⟩
  intro h0
  apply hκ
  have := congrArg B h0
  rwa [map_nsmul, AddEquiv.apply_symm_apply, map_zero] at this

theorem wc_et_tpl_lp_node_supp_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (hk : 1 ≤ k) (h2 : n = 2) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    Nonempty ((DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧) ≃+
      ZMod (ℓ ^ k) × ZMod (ℓ ^ k)) :=
by
  classical
  subst h2
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (C := Scheme.{u})
    (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) := HasExt.standard _
  have hdeg : (((2 * (2 - 1)) : ℕ) : ℤ) = ((2 : ℕ) : ℤ) := by norm_num
  rw [hdeg]

  suffices H : Nonempty (wcEtSuppExt Dx 2 ≃+ ZMod (ℓ ^ k) × ZMod (ℓ ^ k)) by
    obtain ⟨E⟩ := H
    let ι := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing
      (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) 0
    let eD : wcEtSuppExt Dx 2 ≃+
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
            (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A))
              (ℓ ^ k)))))⟦((2 : ℕ) : ℤ)⟧) :=
      Abelian.Ext.homAddEquiv.trans
        (AddEquiv.mk' (Iso.homCongr (ι.app _) ((shiftFunctor _ ((2 : ℕ) : ℤ)).mapIso (ι.app _)))
          (fun f g => by
            simp only [Iso.homCongr_apply, Preadditive.add_comp, Preadditive.comp_add]))
    exact ⟨eD.symm.trans E⟩
  have hp : ℓ.Prime := Fact.out
  have hMpos : 0 < ℓ ^ k := pow_pos hp.pos k
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp

  have exc : ∀ (K : Type u) [Field K] (X V : Scheme.{u}) (φ₀ : V ⟶ X) [Etale φ₀]
      (x₀ : Spec (.of K) ⟶ X) (v₁ : Spec (.of K) ⟶ V) [IsClosedImmersion x₀] [IsClosedImmersion v₁],
      v₁ ≫ φ₀ = x₀ → (∀ v : V, φ₀ v = x₀ (IsLocalRing.closedPoint K) → v = v₁ (IsLocalRing.closedPoint K)) →
      ∀ (m : ℕ) (Dx₀ : wcEtPullData x₀ m) (Dv₀ : wcEtPullData v₁ m) (q : ℕ),
      Nonempty (wcEtSuppExt Dx₀ q ≃+ wcEtSuppExt Dv₀ q) := by
    intro K _ X V φ₀ _ x₀ v₁ _ _ hcomp huniq m Dx₀ Dv₀ q
    have hpb := wc_et_point_fibre_isPullback K X V φ₀ x₀ v₁ hcomp huniq
    obtain ⟨Eφ⟩ := wc_et_zmod_pull_data_exists φ₀ m
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change x₀ φ₀ v₁ (𝟙 _) hpb Dx₀ Eφ Dv₀
    exact ⟨AddEquiv.ofBijective _
      ⟨wc_et_supp_restr_etale_excision_injective φ₀ x₀ v₁ (𝟙 _) hpb inferInstance Dx₀ Eφ Dv₀ γ hγ q,
        wc_et_supp_restr_etale_excision_surjective φ₀ x₀ v₁ (𝟙 _) hpb inferInstance Dx₀ Eφ Dv₀ γ hγ q⟩⟩

  have pullIso : ∀ {S S' : Scheme.{u}} (e₀ : S' ⟶ S) [IsIso e₀] (m : ℕ) (D₀ : wcEtPullData e₀ m)
      (j : ℕ), Function.Bijective (wcEtPull D₀ j) := by
    intro S S' e₀ _ m D₀ j
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (inv e₀) m
    obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists (𝟙 S) m
    obtain ⟨D1'⟩ := wc_et_zmod_pull_data_exists (𝟙 S') m
    have hid : ∀ {T : Scheme.{u}} (E : wcEtPullData (𝟙 T) m) (t : wcEtZModExt T m j),
        wcEtPull E j t = t := by
      intro T E t
      have h1 := wc_et_pull_comp (𝟙 T) (𝟙 T) (𝟙 T) (Category.id_comp _) E E E j t
      have h2 := wc_et_pull_id_injective E j (wcEtPull E j t - t)
      rw [map_sub, ← h1, sub_self] at h2
      exact sub_eq_zero.mp (h2 rfl)
    have hl : ∀ t, wcEtPull D' j (wcEtPull D₀ j t) = t := fun t => by
      rw [← wc_et_pull_comp e₀ (inv e₀) (𝟙 S) (IsIso.inv_hom_id e₀) D₀ D' D1 j t, hid]
    have hr : ∀ s, wcEtPull D₀ j (wcEtPull D' j s) = s := fun s => by
      rw [← wc_et_pull_comp (inv e₀) e₀ (𝟙 S') (IsIso.hom_inv_id e₀) D' D₀ D1' j s, hid]
    exact Function.bijective_iff_has_inverse.mpr ⟨wcEtPull D' j, hl, hr⟩

  have s4 : ∀ (Z : Scheme.{u}) (m j : ℕ) (e : wcEtZModExt Z m j), m • e = 0 := by
    intro Z m j e
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have h1 : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply (SheafOfModules.toSheaf (wcEtZModRing Z m)).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      exact wc_et_zmod_toSheaf_nsmul_zero Z m _
    have h2 : ∀ c : ℕ, c • e = e.comp (Abelian.Ext.mk₀
        (c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)))) (add_zero j) := by
      intro c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih =>
        rw [succ_nsmul, ih, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
          Abelian.Ext.comp_mk₀_id]
    rw [h2 m, h1, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨hdom, hdvr, hℓA, π, c, hπ, hc, U, jU, eU, hjU, heU, hsq, u, hux, hu⟩ :=
    wc_et_tpl_morse_chart_A_pt F' F'' Y 2 hn hn2 D ℓ hℓ i A Λ W' φ a hA x hx
  obtain ⟨W, hWaff, φW, hφW, ψ, hψ, w₀, h1, h2', h3, h4', h5, h6⟩ :=
    wc_closed_fibre_quad_cone_chart A 2 π c hπ hc (Limits.pullback D.f a) U
      (Limits.pullback.snd D.f a) jU eU hjU heU hsq u hu xs (hxs.trans hux.symm)
  haveI := hWaff
  haveI := hφW
  haveI := hψ
  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_halsh_finite_point_residue_algClosed F'' (wcP1Over F'').left (D.S i) A Λ W' φ a hA
  haveI hxbar : IsClosedImmersion (wcEtGeomPt (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)) xs) :=
    wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y 2 D i A Λ W' φ a hA x hx xs hxs
  have hxpt : (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)) xs) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback (C := Scheme.{u})
        (Limits.pullback.snd D.f a) (wcQmSp A)).residueField xs))) = xs := by
    first
    | exact Scheme.fromSpecResidueField_apply xs _
    | (simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply])
  obtain ⟨v₀, hv₀, hv₀pt⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a)
      (wcQmSp A)).residueField xs)) φW
    (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs)
    w₀ (h1.trans hxpt.symm)
  haveI : IsClosedImmersion v₀ := by
    haveI : IsClosedImmersion (v₀ ≫ φW) := by rw [hv₀]; infer_instance
    exact IsClosedImmersion.of_comp v₀ φW
  have hL4 := wc_et_tpl_sfu_geom_pt_base_closed F' F'' Y 2 D i A Λ W' φ a hA x hx xs hxs
  haveI : IsClosedImmersion (v₀ ≫ ψ) := by
    haveI : IsClosedImmersion ((v₀ ≫ ψ) ≫ wcQuadModelStr (IsLocalRing.ResidueField A) 2 0
        (c.map (IsLocalRing.residue A))) := by
      rw [Category.assoc, ← h5, ← Category.assoc, hv₀]
      exact hL4
    exact IsClosedImmersion.of_comp (v₀ ≫ ψ) (wcQuadModelStr (IsLocalRing.ResidueField A) 2 0
      (c.map (IsLocalRing.residue A)))
  have hℓκ : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have h := hℓA.map (IsLocalRing.residue A)
    rw [map_natCast] at h
    exact h.ne_zero

  obtain ⟨e, he, hVe⟩ := wc_node_cone_hyp_iso (IsLocalRing.ResidueField A)
    (c.map (IsLocalRing.residue A)) h6
  haveI := he
  haveI : Etale e := by infer_instance
  haveI : IsClosedImmersion ((v₀ ≫ ψ) ≫ e) := by infer_instance
  have einj : ∀ v w, e v = e w → v = w := by
    intro v w hvw
    have hinv : ∀ z, (inv e) (e z) = z := fun z => by
      rw [← comp_ap, IsIso.hom_inv_id]
      first
      | rfl
