        (shiftFunctor (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          ((d : ℕ) : ℤ)).obj I.cochainComplex)
      (y : wcEtZModExt S' m d),
      (I.extEquivCohomologyClass (X := SheafOfModules.unit (wcEtZModRing S' m))).symm
          (CochainComplex.HomComplex.CohomologyClass.mk
            (CochainComplex.HomComplex.Cocycle.equivHomShift (I.ι' ≫ yh))) = y →
      DerivedCategory.Q.map eΨ ≫ Mf d yh = βd d y := by
    intro d yh y hy
    have hφy : Hq'.map (I.ι' ≫ yh) =
        CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y) := by
      rw [← hy, Equiv.apply_symm_apply, CochainComplex.HomComplex.CohomologyClass.homAddEquiv_apply,
        CochainComplex.HomComplex.CohomologyClass.toHom_mk, AddEquiv.symm_apply_apply]
    have e4 := s4 P Dg.Φ (Dg.μ.inv ≫ Dg.Φ.map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ))
      I.cochainComplex ((d : ℕ) : ℤ) (I.ι' ≫ yh) _ hφy
    have e1 := s1 P Dg.Φ
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ)
      Dg.μ.inv I.cochainComplex I.ι' ((d : ℕ) : ℤ) yh
    have e6 := s6 _ Ψ ((d : ℕ) : ℤ) _ (cd d y) e4
    have hβ : βd d y = _ := e6
    have hL := DerivedCategory.Q.map_comp eΨ
      ((Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map yh ≫
          (P.mapCochainComplexShiftIso ((d : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
        (Dg.Φ.mapCochainComplexShiftIso ((d : ℕ) : ℤ)).hom.app K)
    have h3 := congrArg (fun g => DerivedCategory.Q.map g ≫
      (DerivedCategory.Q.commShiftIso ((d : ℕ) : ℤ)).hom.app Ψ) e1
    have hL2 := congrArg (fun g => g ≫
      (DerivedCategory.Q.commShiftIso ((d : ℕ) : ℤ)).hom.app Ψ) hL
    exact ((hL2.trans (Category.assoc _ _ _)).symm.trans h3).trans hβ.symm



  have hD : ∀ (a b c : ℕ) (h' : (b : ℤ) + (a : ℤ) = (c : ℤ))
      (δh : I.cochainComplex ⟶
        (shiftFunctor (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          ((a : ℕ) : ℤ)).obj I.cochainComplex)
      (zh : I.cochainComplex ⟶
        (shiftFunctor (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          ((b : ℕ) : ℤ)).obj I.cochainComplex),
      Mf c (δh ≫ (shiftFunctor (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          (a : ℤ)).map zh ≫
          (shiftFunctorAdd' (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
            (b : ℤ) (a : ℤ) (c : ℤ) h').inv.app I.cochainComplex) =
        Mf a δh ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Z m)))
            (a : ℤ)).map (Mf b zh) ≫
          (shiftFunctorAdd' (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Z m)))
            (b : ℤ) (a : ℤ) (c : ℤ) h').inv.app (DerivedCategory.Q.obj Ψ) := by
    intro a b c h' δh zh
    have e1 := s3 P Dg.Φ I.cochainComplex ((c : ℕ) : ℤ)
      (δh ≫ (shiftFunctor (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          (a : ℤ)).map zh ≫
          (shiftFunctorAdd' (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
            (b : ℤ) (a : ℤ) (c : ℤ) h').inv.app I.cochainComplex)
    have e2 := s3 P Dg.Φ I.cochainComplex ((a : ℕ) : ℤ) δh
    have e3 := s3 P Dg.Φ I.cochainComplex ((b : ℕ) : ℤ) zh
    have e : ShiftedHom.map (C := CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          (M := ℤ) (X := I.cochainComplex) (Y := I.cochainComplex) (a := ((c : ℕ) : ℤ))
          (δh ≫ (shiftFunctor (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
            (a : ℤ)).map zh ≫
            (shiftFunctorAdd' (CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
              (b : ℤ) (a : ℤ) (c : ℤ) h').inv.app I.cochainComplex)
          ((P.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
            Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)) ⋙ DerivedCategory.Q) =
        ShiftedHom.map (C := CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
          (M := ℤ) (X := I.cochainComplex) (Y := I.cochainComplex) (a := ((a : ℕ) : ℤ)) δh
          ((P.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
            Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)) ⋙ DerivedCategory.Q) ≫
        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Z m))) (a : ℤ)).map
          (ShiftedHom.map (C := CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
            (M := ℤ) (X := I.cochainComplex) (Y := I.cochainComplex) (a := ((b : ℕ) : ℤ)) zh
            ((P.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
              Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)) ⋙ DerivedCategory.Q)) ≫
        (shiftFunctorAdd' (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Z m)))
            (b : ℤ) (a : ℤ) (c : ℤ) h').inv.app (DerivedCategory.Q.obj Ψ) :=
      ShiftedHom.map_comp (C := CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S' m)) ℤ)
        δh zh h' _
    rw [← e1, ← e2, ← e3] at e
    exact e



  have hadd : ∀ y y' : wcEtZModExt S' m r, βd r (y + y') = βd r y + βd r y' := by
    intro y y'
    have hA : cd r (y + y') = cd r y + cd r y' := by
      simp only [cd, InjectiveResolution.extEquivCohomologyClass_add]
      first
      | (rw [AddEquiv.map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add,
          Preadditive.comp_add, Preadditive.comp_add])
      | (erw [AddEquiv.map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add,
          Preadditive.comp_add, Preadditive.comp_add])
      | (erw [map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add,
          Preadditive.comp_add, Preadditive.comp_add])
    show _ ≫ DerivedCategory.Qh.map (cd r (y + y')) ≫ _ = _ ≫ DerivedCategory.Qh.map (cd r y) ≫ _ +
      _ ≫ DerivedCategory.Qh.map (cd r y') ≫ _
    rw [hA, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]
  refine ⟨AddMonoidHom.mk' (βd r) hadd, ?_⟩
  intro z
  obtain ⟨zh, hz⟩ := c1 _ I N z
  refine ⟨Mf N zh, hB N zh z hz, ?_⟩
  intro δ
  obtain ⟨δh, hδ⟩ := c1 _ I N δ
  have h' : ((N : ℕ) : ℤ) + ((N : ℕ) : ℤ) = ((r : ℕ) : ℤ) := by omega
  have hcl := hC I N N r hr h' δh zh
  rw [hδ, hz] at hcl
  have e1 := hB r _ _ hcl
  have e2 := hD N N r h' δh zh
  have e3 := hB N δh δ hδ
  have hcup : wcEtZModCup S' m N N r hr δ z = δ.comp z hr :=
    Abelian.Ext.bilinearComp_apply_apply _ _ _ _ _ _ _ _ _
  have final : βd r (wcEtZModCup S' m N N r hr δ z) =
      βd N δ ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Z m)))
          ((N : ℕ) : ℤ)).map (Mf N zh) ≫
        (shiftFunctorAdd' (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing Z m)))
          ((N : ℕ) : ℤ) ((N : ℕ) : ℤ) ((r : ℕ) : ℤ) h').inv.app (DerivedCategory.Q.obj Ψ) := by
    rw [hcup, ← e1, e2, ← Category.assoc (DerivedCategory.Q.map eΨ), e3]
  exact final

theorem wc_npr_derived_transport_explicit {C₁ : Type (u+2)} [Category.{u+1} C₁] [Abelian C₁]
    [HasDerivedCategory.{u+2} C₁] {C₂ : Type (u+2)} [Category.{u+1} C₂] [Abelian C₂]
    [HasDerivedCategory.{u+2} C₂] [HasExt.{u+2} C₁] [HasExt.{u+2} C₂]
    (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
    (One₁ : C₁) (One₂ : C₂) (μ : F.obj One₁ ≅ One₂) (K : CochainComplex C₁ ℤ)
    (eK : (HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One₁ ⟶ K)
    {X X' : C₁} (ι : X' ⟶ X) (N : ℕ) (y : Abelian.Ext X' One₁ N)
    (ht : DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj X) ⟶
      (DerivedCategory.Q.obj K)⟦(N : ℤ)⟧)
    (H1 : DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map ι) ≫ ht =
      ((DerivedCategory.singleFunctorIsoCompQ C₁ 0).inv.app X' ≫ y.hom ≫
        ((DerivedCategory.singleFunctorIsoCompQ C₁ 0).hom.app One₁)⟦(N : ℤ)⟧') ≫
        (DerivedCategory.Q.map eK)⟦(N : ℤ)⟧') :
    ∃ h : DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₂ 0).obj (F.obj X)) ⟶
        (DerivedCategory.Q.obj ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K))⟦(N : ℤ)⟧,
      DerivedCategory.Q.map ((CochainComplex.singleFunctor C₂ 0).map (F.map ι)) ≫ h =
        ((DerivedCategory.singleFunctorIsoCompQ C₂ 0).inv.app (F.obj X') ≫
          ((Abelian.Ext.mapExactFunctor F y).comp (Abelian.Ext.mk₀ μ.hom) (add_zero N)).hom ≫
          ((DerivedCategory.singleFunctorIsoCompQ C₂ 0).hom.app One₂)⟦(N : ℤ)⟧') ≫
        (DerivedCategory.Q.map ((HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).map μ.inv ≫
          (HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).inv.app One₁ ≫
          (F.mapHomologicalComplex (ComplexShape.up ℤ)).map eK))⟦(N : ℤ)⟧' :=
by
  let G := F.mapDerivedCategory
  let φ := F.mapDerivedCategoryFactors
  let ι₁ := DerivedCategory.singleFunctorIsoCompQ C₁ 0
  let sm := HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0
  let cs := G.commShiftIso (N : ℤ)
  let w := G.map y.hom ≫ cs.hom.app ((DerivedCategory.singleFunctor C₁ 0).obj One₁)
  let a₂ := DerivedCategory.Q.map (sm.inv.app X') ≫
    φ.inv.app ((CochainComplex.singleFunctor C₁ 0).obj X') ≫ G.map (ι₁.inv.app X')
  let b₂ := G.map (ι₁.hom.app One₁) ≫
    φ.hom.app ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One₁) ≫
    DerivedCategory.Q.map (sm.hom.app One₁ ≫
      (HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).map μ.hom)
  have hid : (DerivedCategory.singleFunctorIsoCompQ C₂ 0).inv.app (F.obj X') ≫
      ((Abelian.Ext.mapExactFunctor F y).comp (Abelian.Ext.mk₀ μ.hom) (add_zero N)).hom ≫
      ((DerivedCategory.singleFunctorIsoCompQ C₂ 0).hom.app One₂)⟦(N : ℤ)⟧' =
      a₂ ≫ w ≫ b₂⟦(N : ℤ)⟧' := by
    rw [Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, ShiftedHom.comp_mk₀,
      Abelian.Ext.mapExactFunctor_hom, Functor.mapDerivedCategorySingleFunctor_inv_app,
      Functor.mapDerivedCategorySingleFunctor_hom_app]
    simp only [ShiftedHom.map, a₂, w, b₂, ι₁, cs, G, φ, sm,
      DerivedCategory.singleFunctorIsoCompQ_hom_app,
      DerivedCategory.singleFunctorIsoCompQ_inv_app, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_comp, Category.assoc, Category.id_comp, Category.comp_id]
    refine (Category.id_comp _).trans ?_
    rfl
  refine ⟨DerivedCategory.Q.map (sm.inv.app X) ≫ φ.inv.app _ ≫ G.map ht ≫
    cs.hom.app _ ≫ (φ.hom.app K)⟦(N : ℤ)⟧', ?_⟩
  rw [hid]
  have e1 : (CochainComplex.singleFunctor C₂ 0).map (F.map ι) ≫ sm.inv.app X =
      sm.inv.app X' ≫ (F.mapHomologicalComplex _).map
        ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).map ι) :=
    sm.inv.naturality ι
  have e2 : DerivedCategory.Q.map ((F.mapHomologicalComplex _).map
        ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).map ι)) ≫
        φ.inv.app ((CochainComplex.singleFunctor C₁ 0).obj X) =
      φ.inv.app ((CochainComplex.singleFunctor C₁ 0).obj X') ≫
        G.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map ι)) :=
    φ.inv.naturality _
  have e3 : G.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map ι)) ≫
        G.map ht ≫ cs.hom.app (DerivedCategory.Q.obj K) =
      G.map (ι₁.inv.app X') ≫ w ≫
        (G.map (ι₁.hom.app One₁) ≫ G.map (DerivedCategory.Q.map eK))⟦(N : ℤ)⟧' := by
    rw [← Category.assoc, ← G.map_comp, H1]
    simp only [G.map_comp, Category.assoc, Functor.map_comp]
    rw [Functor.commShiftIso_hom_naturality, ← Category.assoc (G.map _) (cs.hom.app _),
      Functor.commShiftIso_hom_naturality]
    simp only [w, cs, Category.assoc]
    rfl
  have e5 : G.map (DerivedCategory.Q.map eK) ≫ φ.hom.app K =
      φ.hom.app ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One₁) ≫
        DerivedCategory.Q.map ((F.mapHomologicalComplex _).map eK) :=
    φ.hom.naturality eK
  have e6a : (sm.hom.app One₁ ≫
        (HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).map μ.hom) ≫
      ((HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).map μ.inv ≫ sm.inv.app One₁ ≫
        (F.mapHomologicalComplex (ComplexShape.up ℤ)).map eK) =
      (F.mapHomologicalComplex (ComplexShape.up ℤ)).map eK := by
    rw [Category.assoc,
      ← Category.assoc ((HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).map μ.hom),
      ← Functor.map_comp, Iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.id_comp,
      Iso.hom_inv_id_app_assoc]
  have e6 : b₂ ≫ DerivedCategory.Q.map
        ((HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).map μ.inv ≫
        sm.inv.app One₁ ≫ (F.mapHomologicalComplex (ComplexShape.up ℤ)).map eK) =
      G.map (ι₁.hom.app One₁) ≫
        φ.hom.app ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One₁) ≫
        DerivedCategory.Q.map ((F.mapHomologicalComplex _).map eK) := by
    simp only [b₂, Category.assoc]
    rw [← Functor.map_comp DerivedCategory.Q, e6a]
  calc DerivedCategory.Q.map ((CochainComplex.singleFunctor C₂ 0).map (F.map ι)) ≫
        DerivedCategory.Q.map (sm.inv.app X) ≫ φ.inv.app _ ≫ G.map ht ≫
        cs.hom.app _ ≫ (φ.hom.app K)⟦(N : ℤ)⟧'
      = DerivedCategory.Q.map (sm.inv.app X') ≫
        φ.inv.app ((CochainComplex.singleFunctor C₁ 0).obj X') ≫
        (G.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map ι)) ≫
        G.map ht ≫ cs.hom.app (DerivedCategory.Q.obj K)) ≫ (φ.hom.app K)⟦(N : ℤ)⟧' := by
        rw [← Category.assoc, ← Functor.map_comp, e1, Functor.map_comp, Category.assoc,
          ← Category.assoc (DerivedCategory.Q.map _) (φ.inv.app _), e2]
        simp only [Category.assoc]
    _ = a₂ ≫ w ≫ (G.map (ι₁.hom.app One₁) ≫
        φ.hom.app ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One₁) ≫
        DerivedCategory.Q.map ((F.mapHomologicalComplex _).map eK))⟦(N : ℤ)⟧' := by
        rw [e3, ← e5]
        simp only [a₂, Category.assoc, Functor.map_comp]
    _ = _ := by
        rw [← e6]
        simp only [Category.assoc, Functor.map_comp]
        rfl

theorem wc_npr_et_pull_unit_transpose_isIso : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (m : ℕ) (Dg : wcEtPullData g m), IsIso ((Dg.adj.homEquiv (SheafOfModules.unit (wcEtZModRing S m)) (SheafOfModules.unit (wcEtZModRing S' m))).symm (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ)) :=
by
  intro S S' g m Dg
  haveI := Dg.cont

  have s4 : ∀ (T : S'.Etale), Limits.IsTerminal T →
      ∀ (h : SheafOfModules.unit (wcEtZModRing S' m) ⟶ SheafOfModules.unit (wcEtZModRing S' m))
        (c : (wcEtZModRing S' m).obj.obj (Opposite.op T)),
        @Eq ((wcEtZModRing S' m).obj.obj (Opposite.op T)) ((h.val.app (Opposite.op T)).hom c) 1 →
        IsIso h := by
    intro T hT h c hc

    have s2 : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)), Function.Bijective
        (fun f : SheafOfModules.unit (wcEtZModRing S' m) ⟶ M =>
        (f.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S' m).obj.obj (Opposite.op T))) := by
      intro M
      have huniq : ∀ (X : (S'.Etale)ᵒᵖ) (a b : Opposite.op T ⟶ X), a = b := fun X a b =>
        Quiver.Hom.unop_inj (hT.hom_ext _ _)
      let evT : M.sections → M.val.obj (Opposite.op T) := fun s => s.1 (Opposite.op T)
      have hfac : (fun f : SheafOfModules.unit (wcEtZModRing S' m) ⟶ M =>
          (f.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S' m).obj.obj (Opposite.op T))) =
          evT ∘ M.unitHomEquiv := by
        funext f
        first
          | exact (SheafOfModules.unitHomEquiv_apply_coe M f (Opposite.op T)).symm
          | exact (SheafOfModules.unitHomEquiv_apply_coe f (Opposite.op T)).symm
          | simp [evT, SheafOfModules.unitHomEquiv_apply_coe]
      rw [hfac]
      refine Function.Bijective.comp ⟨?_, ?_⟩ M.unitHomEquiv.bijective
      · intro s t hst
        apply PresheafOfModules.sections_ext
        intro X
        have hs := PresheafOfModules.sections_property s (hT.from X.unop).op
        have ht := PresheafOfModules.sections_property t (hT.from X.unop).op
        rw [← hs, ← ht]
        exact congrArg _ hst
      · intro x
        refine ⟨PresheafOfModules.sectionsMk
          (fun X => (M.val.map (hT.from X.unop).op).hom x) ?_, ?_⟩
        · intro X X' f
          have e : (hT.from X'.unop).op = (hT.from X.unop).op ≫ f :=
            huniq X' (hT.from X'.unop).op ((hT.from X.unop).op ≫ f)
          first
            | (rw [e, PresheafOfModules.map_comp]; rfl)
            | (simp only [e, PresheafOfModules.map_comp]; rfl)
            | (rw [e]; simp [PresheafOfModules.map_comp])
            | (rw [e]; simp)
        · have e : (hT.from (Opposite.unop (Opposite.op T))).op = 𝟙 (Opposite.op T) :=
            huniq _ _ _
          show (PresheafOfModules.sectionsMk _ _).1 (Opposite.op T) = x
          first
            | (simp only [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
            | (rw [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
            | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom x = x
               rw [e, PresheafOfModules.map_id]; rfl)
            | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom x = x
               rw [e]; simp)

    have hcomm : ∀ (V : (S'.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing S' m).obj.obj V)),
        a * b = b * a := by
      intro V a b
      obtain ⟨α, hsurj⟩ : ∃ α : (Functor.const (S'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod m))) ⟶
          (wcEtZModRing S' m).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S') α :=
        ⟨toSheafify (Scheme.smallEtaleTopology S')
            ((Functor.const (S'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod m)))),
          Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S') _⟩
      haveI := hsurj
      have hsep := Sheaf.isSeparated (wcEtZModRing S' m)
      induction V using Opposite.rec with
      | op V =>
      refine hsep V _ (GrothendieckTopology.intersection_covering _
        (Presheaf.imageSieve_mem _ α a) (Presheaf.imageSieve_mem _ α b)) (a * b) (b * a) ?_
      intro W h hh
      have hh' : (Presheaf.imageSieve α a).arrows h ∧ (Presheaf.imageSieve α b).arrows h := hh
      obtain ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩ := hh'
      have hc : t₁ * t₂ = t₂ * t₁ := @mul_comm (ULift.{u+1} (ZMod m)) _ t₁ t₂
      rw [map_mul, map_mul, ← ht₁, ← ht₂, ← map_mul, ← map_mul]
