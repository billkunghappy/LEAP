      Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))
  have hT2 := IsPullback.of_isLimit (Limits.PullbackCone.isLimitOfCompMono _ _
    (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
      (FractionRing (X.presheaf.stalk x))))) hT1.cone hT1.isLimit)
  have hδ : Spec.map (CommRingCat.ofHom (algebraMap (FractionRing (X.presheaf.stalk x))
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))) ≫
