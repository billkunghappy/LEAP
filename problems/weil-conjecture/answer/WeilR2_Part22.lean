      have h1 : ι.inv.app X ≫ (j • ((Abelian.Ext.mk₀ u0).comp θ₀ (zero_add (2 * N))).hom) ≫
          (ι.hom.app X)⟦(((2 * N) : ℕ) : ℤ)⟧' = 0 := by
        rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, hc]
        simp only [Category.assoc]
        rw [← reassoc_of% hnat]
        exact h0
      have h2 : j • ((Abelian.Ext.mk₀ u0).comp θ₀ (zero_add (2 * N))).hom = 0 := by
        have e : j • ((Abelian.Ext.mk₀ u0).comp θ₀ (zero_add (2 * N))).hom =
