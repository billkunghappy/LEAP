        e F' (g ≫ φ) = (φ.hom.app (Opposite.op U)).hom (e F g) := hN
    obtain ⟨hL, hK⟩ := proet_free_hom_seq_colimit _ U G c hc
    refine ⟨fun s => ?_, fun n t ht => ?_⟩
    · obtain ⟨n, g', hg'⟩ := hL ((e c.pt).symm s)
      refine ⟨n, e (G.obj n) g', ?_⟩
      rw [← hN', ← hg']
      exact Equiv.apply_symm_apply _ _
    · obtain ⟨g', ht'⟩ : ∃ g', e (G.obj n) g' = t := ⟨_, Equiv.apply_symm_apply _ _⟩
      have h0 : g' ≫ c.ι.app n = 0 := by
        apply (e _).injective
        rw [hN', ht', ht, hZ]
      obtain ⟨m, hnm, hz⟩ := hK n g' h0
      refine ⟨m, hnm, ?_⟩
      rw [← ht', ← hN', hz, hZ]

  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hPirr : IrreducibleSpace (wcP1Over F'').left := wc_proj_space_irreducible F'' 1
  haveI hPqs : QuasiSeparatedSpace (wcP1Over F'').left :=
    quasiSeparatedSpace_of_quasiSeparated (wcP1Over F'').hom
  have hclosed : ∀ i : Fin D.m, IsClosed ({D.S i (IsLocalRing.closedPoint F'')} :
      Set (wcP1Over F'').left) := by
    intro i
    haveI : IsClosedImmersion (D.S i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    have h1 := (D.S i).isClosedEmbedding.isClosed_range
    convert h1 using 1
    ext p
    constructor
    · rintro rfl
      exact ⟨_, rfl⟩
    · rintro ⟨a, rfl⟩
      rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
      rfl
  have hOopen : IsOpen {p : (wcP1Over F'').left |
      ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'')} := by
    have e : {p : (wcP1Over F'').left | ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'')} =
        ⋂ i, ({D.S i (IsLocalRing.closedPoint F'')}ᶜ : Set (wcP1Over F'').left) := by
      ext p
      simp
    rw [e]
    exact isOpen_iInter_of_finite (fun i => (hclosed i).isOpen_compl)
  obtain ⟨O, hOmem⟩ : ∃ O : (wcP1Over F'').left.Opens,
      ∀ p, p ∈ O ↔ ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'') :=
    ⟨⟨_, hOopen⟩, fun p => Iff.rfl⟩
  have hOc : IsCompact (O : Set (wcP1Over F'').left) :=
    (wc_curve_points_closed_opens_compact F'' (wcP1Over F'').left (wcP1Over F'').hom
      (wc_proj_space_dim F'' 1)).2 O

  have s7a : ∀ (W : (wcP1Over F'').left.ProEt) (v : (wcOpenRestr (wcP1Over F'').left O W).left),
      (wcOpenRestr (wcP1Over F'').left O W).hom v ∈ O := by
    intro W v
    have h1 : O.ι (Limits.pullback.fst O.ι W.hom v) ∈ O := by
      have h0 : O.ι (Limits.pullback.fst O.ι W.hom v) ∈ Set.range O.ι := Set.mem_range_self _
      rw [Scheme.Opens.range_ι] at h0
      exact h0
    have h2 : (Limits.pullback.snd O.ι W.hom ≫ W.hom) v ∈ O := by
      rw [← Limits.pullback.condition]; exact h1
    exact h2
  have s7b : ∀ (W V : (wcP1Over F'').left.ProEt) (h : V ⟶ W), (∀ v : V.left, V.hom v ∈ O) →
      ∃ h' : V ⟶ wcOpenRestr (wcP1Over F'').left O W,
        h' ≫ wcOpenRestrIncl (wcP1Over F'').left O W = h := by
    intro W V h hV
    have hsub : Set.range V.hom ⊆ Set.range O.ι := by
      rintro _ ⟨v, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hV v
    have ha : IsOpenImmersion.lift O.ι V.hom hsub ≫ O.ι = V.hom := IsOpenImmersion.lift_fac _ _ _
    have hcomm : IsOpenImmersion.lift O.ι V.hom hsub ≫ O.ι = h.left ≫ W.hom := by
      rw [ha, MorphismProperty.Over.w h]
    refine ⟨MorphismProperty.Over.homMk
      (Limits.pullback.lift (IsOpenImmersion.lift O.ι V.hom hsub) h.left hcomm) ?_ trivial, ?_⟩
    · change Limits.pullback.lift (IsOpenImmersion.lift O.ι V.hom hsub) h.left hcomm ≫
          (Limits.pullback.snd O.ι W.hom ≫ W.hom) = V.hom
      rw [← Category.assoc, Limits.pullback.lift_snd, MorphismProperty.Over.w h]
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.lift (IsOpenImmersion.lift O.ι V.hom hsub) h.left hcomm ≫
          Limits.pullback.snd O.ι W.hom = h.left
      exact Limits.pullback.lift_snd _ _ _

  have s8 : ∀ (W : (wcP1Over F'').left.ProEt) [CompactSpace W.left] [QuasiSeparatedSpace W.left],
      CompactSpace (wcOpenRestr (wcP1Over F'').left O W).left ∧
        QuasiSeparatedSpace (wcOpenRestr (wcP1Over F'').left O W).left := by
    intro W hWc hWq
    haveI : QuasiSeparatedSpace ((𝟭 Scheme.{u}).obj W.left) := hWq
    haveI : CompactSpace ((𝟭 Scheme.{u}).obj W.left) := hWc
    haveI hWqc : QuasiCompact W.hom :=
      quasiCompact_of_compactSpace (X := W.left) (Y := (wcP1Over F'').left) W.hom
    have hemb := (Limits.pullback.snd O.ι W.hom).isOpenEmbedding
    have hc : IsCompact (W.hom ⁻¹' (O : Set (wcP1Over F'').left)) :=
      QuasiCompact.isCompact_preimage (f := W.hom) _ O.isOpen hOc
    have hc' : IsCompact (Set.range (Limits.pullback.snd O.ι W.hom)) := by
      rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
      exact hc
    have hcs : CompactSpace (Limits.pullback (C := Scheme.{u}) O.ι W.hom) :=
      isCompact_univ_iff.mp (hemb.isInducing.isCompact_iff.mpr (by rw [Set.image_univ]; exact hc'))
    have hqs : QuasiSeparatedSpace (Limits.pullback (C := Scheme.{u}) O.ι W.hom) :=
      hemb.quasiSeparatedSpace
    exact ⟨hcs, hqs⟩

  have key : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      (∀ (m : ℕ) (T' : (wcP1Over F'').left.ProEt) (t : (G.obj m).obj.obj (Opposite.op T')),
        (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T'), (∀ v : V.left, V.hom v ∈ O) →
          ((G.obj m).obj.map h.op).hom t = 0) → t = 0) →
      ∀ (W : (wcP1Over F'').left.ProEt), IsAffine W.left → ∀ z : c.pt.obj.obj (Opposite.op W),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ W), (∀ v : V.left, V.hom v ∈ O) →
        (c.pt.obj.map h.op).hom z = 0) → z = 0 := by
    intro G c hc hNP W hW z hz
    haveI : IsAffine W.left := hW
    obtain ⟨hcpt, hqs⟩ := s8 W
    have hzo : (c.pt.obj.map (wcOpenRestrIncl (wcP1Over F'').left O W).op).hom z = 0 :=
      hz _ _ (s7a W)
    obtain ⟨n, t, ht⟩ := (s5 W G c hc).1 z
    have h2 : ((c.ι.app n).hom.app (Opposite.op (wcOpenRestr (wcP1Over F'').left O W))).hom
        (((G.obj n).obj.map (wcOpenRestrIncl (wcP1Over F'').left O W).op).hom t) = 0 := by
      rw [← nat, ht]
      exact hzo
    obtain ⟨m, hnm, hm⟩ := @s5 (wcOpenRestr (wcP1Over F'').left O W) hcpt hqs G c hc |>.2 n _ h2
    have ht' : ((G.map (homOfLE hnm)).hom.app (Opposite.op W)).hom t = 0 := by
      apply hNP m W
      intro V h hV
      obtain ⟨h', rfl⟩ := s7b W V h hV
      rw [resComp, nat, hm, map_zero]
    calc z = ((c.ι.app n).hom.app (Opposite.op W)).hom t := ht.symm
      _ = ((G.map (homOfLE hnm) ≫ c.ι.app m).hom.app (Opposite.op W)).hom t := by rw [c.w]
      _ = ((c.ι.app m).hom.app (Opposite.op W)).hom
            (((G.map (homOfLE hnm)).hom.app (Opposite.op W)).hom t) := rfl
      _ = 0 := by rw [ht', map_zero]

  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hexX : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology D.Yt.left)
      _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  haveI hexB : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _
      (Scheme.ProEt.topology (wcP1Over F'').left) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  haveI hRfin : Limits.PreservesFiniteLimits (wcProEtPush D.f) := inferInstance
  obtain ⟨κ, ⟨hκ⟩, -⟩ := wc_ladic_tower_colimit D.Yt.left ℓ
  obtain ⟨h1⟩ := wc_rightDerived_preserves_seq_colimit (wcProEtPush D.f)
    (fun G c hc => wc_proet_push_preserves_seq_colimit D.f G c hc)
    (fun I hI c hc k => wc_proet_push_colim_injective_acyclic D.f I hI c hc k) _ _ hκ q

  apply hsep (wcRq D.f ℓ q) T x
  intro W e hW
  refine key _ _ h1
    (fun m T' t ht => hInt T' t (fun V h hV => ht V h (fun v => (hOmem _).mpr (hV v)))) W hW _ ?_
  intro V h hV
  exact (resComp (wcRq D.f ℓ q) h e x).symm.trans
    (hx V (h ≫ e) (fun v => (hOmem _).mp (hV v)))

theorem wc_pencil_Rq_no_punctual_sections (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom x = 0) → x = 0 :=
by
  classical
  intro T g x hx

  have nat : ∀ {G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (φ : G ⟶ G') {V T : (wcP1Over F'').left.ProEt} (h : V ⟶ T) (z : G.obj.obj (Opposite.op T)),
      (G'.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom z) =
        (φ.hom.app (Opposite.op V)).hom ((G.obj.map h.op).hom z) := by
    intro G G' φ V T h z
    have e := congrArg (fun f => f.hom z) (φ.hom.naturality h.op)
    exact e.symm

  have inj : ∀ {G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (θ : G ≅ G') {T : (wcP1Over F'').left.ProEt} (z : G.obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom z = 0 → z = 0 := by
    intro G G' θ T z hz
    have e := congrArg (fun f => (f.hom.app (Opposite.op T)).hom z) θ.hom_inv_id
    have e' : (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom z) = z := e
    rw [hz, map_zero] at e'
    exact e'.symm

  obtain ⟨hZc, hgen⟩ := wc_P1_sections_closed_generize F'' D.m D.S D.hS

  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI := wc_et_enough_injectives D.Yt.left

  have hTor : ∀ (k : ℕ) (T : (wcP1Over F'').left.ProEt)
      (z : (((wcProEtPush D.f).rightDerived (n - 1)).obj
        (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ((((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.map h.op).hom z = 0) → z = 0 := by
    intro k T z hz
    let I := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))
    obtain ⟨θ⟩ := wc_proet_rightDerived_push_epsInv F'' D.Yt.left (wcP1Over F'').left
      (wcP1Over F'').hom D.f (ℓ ^ k) I (n - 1)
    apply inj θ
    refine wc_epsInv_no_punct_of_cospec (wcP1Over F'').left
      ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n - 1))
      {p | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} hZc ?_ hgen T _ ?_
    · intro V h v v' hv hsp hv' h0
      obtain ⟨i, hi⟩ := hv
      exact wc_pencil_et_Rq_cospec_injective F' F'' Y n hn hn2 D ℓ hℓ k I V h v v' i hi hsp
        (fun j hj => hv' ⟨j, hj⟩) h0
    · intro V h hV
      rw [nat θ.hom h z, hz V h (fun v i hvi => hV v ⟨i, hvi⟩), map_zero]

  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := by
    intro k
    have h1 := (continuous_apply k).comp (wc_padic_tower_facts ℓ).1
    exact h1
  have hInt : ∀ (T : (wcP1Over F'').left.ProEt)
      (y : (((wcProEtPush D.f).rightDerived (n - 1)).obj (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj
        (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ((((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.map h.op).hom y = 0) →
      y = 0 := by
    intro T y hy
    apply wc_pencil_Rq_int_detect_torsion F' F'' Y n hn2 D ℓ hℓ hP hc T y
    intro k
    apply hTor k T
    intro V h hV
    rw [nat (((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) h y, hy V h hV, map_zero]

  exact wc_pencil_Rq_rat_noPunct_of_int F' F'' Y n hn2 D ℓ hℓ hP (n - 1) hInt T x hx

theorem wc_geomConst_kernel (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G H : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (φ : G ⟶ H) (hG : wcPencilGC K hP ℓ G) (hH : wcPencilGC K hP ℓ H) :
    wcPencilGC K hP ℓ (Limits.kernel φ) :=
by
  classical

  have hconn : ConnectedSpace (wcGeomPoint K (wcP1Over K) hP).left := by
    obtain ⟨e, he, -⟩ := wcpa_proj_base_change K (AlgebraicClosure K) 1
    haveI := he
    haveI := wc_proj_space_irreducible (AlgebraicClosure K) 1
    haveI : ConnectedSpace ↥(wcProjK (AlgebraicClosure K) 1) := IrreducibleSpace.connectedSpace _
    let h := Scheme.Hom.homeomorph (inv e)
    exact h.surjective.connectedSpace h.continuous

  have s3 : ∀ (a b : ℕ) (L : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])),
      ∃ c : ℕ, Nonempty (Limits.kernel
        (wcContSheafMap (wcP1Over K).left L.toAddMonoidHom
          (LinearMap.continuous_of_finiteDimensional L)) ≅
          wcContSheaf (wcP1Over K).left (Fin c → ℚ_[ℓ])) := by
    intro a b L
    have congrMap : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (f g : A →+ B) (hf : Continuous f) (hg : Continuous g), f = g →
        wcContSheafMap (wcP1Over K).left f hf = wcContSheafMap (wcP1Over K).left g hg := by
      intro A B _ _ _ _ _ _ f g hf hg hfg
      subst hfg
      rfl
    let N := LinearMap.ker L
    let R := LinearMap.range L
    let c := Module.finrank ℚ_[ℓ] N
    let d := Module.finrank ℚ_[ℓ] R
    let eN : (Fin c → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] N :=
      LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
    let eR : (Fin d → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] R :=
      LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
    let incl : (Fin c → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]) := N.subtype ∘ₗ eN.toLinearMap
    let L' : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin d → ℚ_[ℓ]) := eR.symm.toLinearMap ∘ₗ L.rangeRestrict
    let j : (Fin d → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]) := R.subtype ∘ₗ eR.toLinearMap
    have hincl_inj : Function.Injective incl := Subtype.val_injective.comp eN.injective
    have hj_inj : Function.Injective j := Subtype.val_injective.comp eR.injective
    have hL'surj : Function.Surjective L' := eR.symm.surjective.comp L.surjective_rangeRestrict
    have hjL : ∀ v, j (L' v) = L v := by
      intro v
      show ((eR (eR.symm (L.rangeRestrict v)) : R) : Fin b → ℚ_[ℓ]) = L v
      rw [LinearEquiv.apply_symm_apply]
      rfl
    have hinclc : Continuous (incl.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional incl
    have hL'c : Continuous (L'.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional L'
    have hjc : Continuous (j.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional j

    have hemb : Topology.IsEmbedding incl :=
      (LinearMap.isClosedEmbedding_of_injective (LinearMap.ker_eq_bot.mpr hincl_inj)).isEmbedding
    have hexact : ∀ w, L' w = 0 ↔ ∃ u, incl u = w := by
      intro w
      have h1 : L' w = 0 ↔ L w = 0 := by
        rw [← hjL w]
        constructor
        · intro h; rw [h, map_zero]
        · intro h; exact hj_inj (h.trans (map_zero j).symm)
      rw [h1]
      constructor
      · intro h
        refine ⟨eN.symm ⟨w, LinearMap.mem_ker.mpr h⟩, ?_⟩
        show ((eN (eN.symm ⟨w, LinearMap.mem_ker.mpr h⟩) : N) : Fin a → ℚ_[ℓ]) = w
        rw [LinearEquiv.apply_symm_apply]
      · rintro ⟨u, rfl⟩
        exact LinearMap.mem_ker.mp (eN u).2
    obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective L'
      (LinearMap.range_eq_top.mpr hL'surj)
    have hsec : ∃ s : (Fin d → ℚ_[ℓ]) → (Fin a → ℚ_[ℓ]), Continuous s ∧
        ∀ y, L'.toAddMonoidHom (s y) = y :=
      ⟨σ, LinearMap.continuous_of_finiteDimensional σ, fun y => LinearMap.congr_fun hσ y⟩
    obtain ⟨hzero, hSE⟩ := wc_contSheaf_shortExact (wcP1Over K).left incl.toAddMonoidHom hinclc
      L'.toAddMonoidHom hL'c hemb hexact hsec
    let κ1 : wcContSheaf (wcP1Over K).left (Fin c → ℚ_[ℓ]) ≅
        Limits.kernel (wcContSheafMap (wcP1Over K).left L'.toAddMonoidHom hL'c) :=
      Limits.IsLimit.conePointUniqueUpToIso hSE.fIsKernel (Limits.limit.isLimit _)

    obtain ⟨r, hr⟩ := LinearMap.exists_leftInverse_of_injective j (LinearMap.ker_eq_bot.mpr hj_inj)
    have hrc : Continuous (r.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional r
    have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (f : A →+ B) (hf : Continuous f) (U : ((wcP1Over K).left.ProEt)ᵒᵖ)
        (x : ((wcContSheaf (wcP1Over K).left A).obj.obj U : Type (u+1))),
        (wcContSheafMap (wcP1Over K).left f hf).hom.app U x =
          (ULift.up (AddMonoidHom.compLeftContinuous
            (↥((Scheme.ProEt.forget (wcP1Over K).left ⋙ Over.forget (wcP1Over K).left).obj
              (Opposite.unop U))) f hf
            (ULift.down x : C(↥((Scheme.ProEt.forget (wcP1Over K).left ⋙
              Over.forget (wcP1Over K).left).obj (Opposite.unop U)), A))) : _) := by
      intro A B _ _ _ _ _ _ f hf U x
      rfl
    have hjr : wcContSheafMap (wcP1Over K).left j.toAddMonoidHom hjc ≫
        wcContSheafMap (wcP1Over K).left r.toAddMonoidHom hrc = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
        key, key]
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact LinearMap.congr_fun hr _
    haveI : IsSplitMono (wcContSheafMap (wcP1Over K).left j.toAddMonoidHom hjc) :=
      IsSplitMono.mk' ⟨_, hjr⟩
    have hcomp : wcContSheafMap (wcP1Over K).left L.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional L) =
        wcContSheafMap (wcP1Over K).left L'.toAddMonoidHom hL'c ≫
          wcContSheafMap (wcP1Over K).left j.toAddMonoidHom hjc := by
      rw [← (wc_contSheafMap_comp_sub (wcP1Over K).left L'.toAddMonoidHom L'.toAddMonoidHom
        hL'c hL'c j.toAddMonoidHom hjc).1]
      apply congrMap
      exact AddMonoidHom.ext fun v => (hjL v).symm
    exact ⟨c, ⟨Limits.kernelIsoOfEq hcomp ≪≫ Limits.kernelCompMono _ _ ≪≫ κ1.symm⟩⟩

  obtain ⟨a, ⟨θG⟩⟩ := hG
  obtain ⟨b, ⟨θH⟩⟩ := hH
  let ρ := (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint K (wcP1Over K) hP)
  obtain ⟨ψ, hψ⟩ : ∃ ψ : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP) ⟶
      (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP),
      ψ = θG.inv ≫ ρ.map φ ≫ θH.hom := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over K).left ℓ
    (wcGeomPoint K (wcP1Over K) hP) hconn a b ψ
  obtain ⟨c, ⟨κ⟩⟩ := s3 a b A
  have w : ρ.map φ ≫ θH.hom = θG.hom ≫ ψ := by
    rw [hψ, Iso.hom_inv_id_assoc]
  exact ⟨c, ⟨Limits.PreservesKernel.iso ρ φ ≪≫ Limits.kernel.mapIso (ρ.map φ) ψ θG θH w ≪≫
    Limits.kernelIsoOfEq hA ≪≫ (Limits.PreservesKernel.iso ρ _).symm ≪≫ ρ.mapIso κ⟩⟩

theorem wc_geomConst_rank_bound (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hW : ConnectedSpace W.left) (N : ℕ)
    (θ : X.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W) :
    ∀ (M : Subobject X) (r : ℕ),
      Nonempty ((Subobject.underlying.obj M).over (wcGeomPoint K (wcP1Over K) hP) ≅
        (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP)) →
      r ≤ N :=
by
  classical
  intro M r hM
  obtain ⟨θM⟩ := hM
  let ρ := (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W
  let θMW : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W :=
    ((Scheme.ProEt.topology (wcP1Over K).left).overMapPullback AddCommGrpCat.{u+1} w).mapIso θM
  haveI hmono : Mono (ρ.map M.arrow) := Functor.map_mono ρ M.arrow
  obtain ⟨φ, hφdef⟩ : ∃ φ : (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W ⟶
      (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W,
      φ = θMW.inv ≫ ρ.map M.arrow ≫ θ.hom := ⟨_, rfl⟩
  have hφ : Mono φ := by rw [hφdef]; infer_instance
  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over K).left ℓ W hW r N φ
  have hAc : Continuous (A.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional A
  have hAm : Mono (ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom hAc)) := by
    rw [← hA]; exact hφ
  apply le_of_fin_injective ℚ_[ℓ] A
  rw [injective_iff_map_eq_zero]
  intro v hv
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f : A →+ B) (hf : Continuous f) (U : ((wcP1Over K).left.ProEt)ᵒᵖ)
      (x : ((wcContSheaf (wcP1Over K).left A).obj.obj U : Type (u+1))),
      (wcContSheafMap (wcP1Over K).left f hf).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget (wcP1Over K).left ⋙ Over.forget (wcP1Over K).left).obj
            (Opposite.unop U))) f hf
          (ULift.down x : C(↥((Scheme.ProEt.forget (wcP1Over K).left ⋙
            Over.forget (wcP1Over K).left).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ f hf U x
    rfl
  let L : (Fin 1 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) := (LinearMap.proj 0).smulRight v
  let Z : (Fin 1 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) := 0
  have hLc : Continuous (L.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional L
  have hZc : Continuous (Z.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional Z
  have hcomp : wcContSheafMap (wcP1Over K).left L.toAddMonoidHom hLc ≫
        wcContSheafMap (wcP1Over K).left A.toAddMonoidHom hAc =
      wcContSheafMap (wcP1Over K).left Z.toAddMonoidHom hZc ≫
        wcContSheafMap (wcP1Over K).left A.toAddMonoidHom hAc := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    simp only [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
      CategoryTheory.comp_apply, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    show A ((ULift.down x : C(_, Fin 1 → ℚ_[ℓ])) z 0 • v) = A 0
    rw [map_smul, hv, smul_zero, map_zero]
  have hρ : ρ.map (wcContSheafMap (wcP1Over K).left L.toAddMonoidHom hLc) =
      ρ.map (wcContSheafMap (wcP1Over K).left Z.toAddMonoidHom hZc) := by
    rw [← cancel_mono (ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom hAc)),
      ← ρ.map_comp, ← ρ.map_comp, hcomp]
  obtain ⟨w0⟩ := hW.toNonempty
  let e : ((wcContSheaf (wcP1Over K).left (Fin 1 → ℚ_[ℓ])).obj.obj (Opposite.op W) : Type (u+1)) :=
    ULift.up (ContinuousMap.const _ (fun _ => (1 : ℚ_[ℓ])))
  have h1 : (wcContSheafMap (wcP1Over K).left L.toAddMonoidHom hLc).hom.app (Opposite.op W) e =
      (wcContSheafMap (wcP1Over K).left Z.toAddMonoidHom hZc).hom.app (Opposite.op W) e :=
    congrArg (fun f => (f.hom.app (Opposite.op (Over.mk (𝟙 W)))) e) hρ
  rw [key, key] at h1
  have h2 := DFunLike.congr_fun (congrArg ULift.down h1) w0
  have h3 : L (fun _ => 1) = Z (fun _ => 1) := h2
  have h4 : L (fun _ => 1) = v := by
    show (1 : ℚ_[ℓ]) • v = v
    exact one_smul _ _
  rw [← h4, h3]
  rfl

theorem wc_geomConst_subobject_le_of_rank (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (M M' : Subobject X) (hle : M ≤ M') (r r' : ℕ) (hr : r' ≤ r)
    (hM : Nonempty ((Subobject.underlying.obj M).over (wcGeomPoint K (wcP1Over K) hP) ≅
      (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP)))
    (hM' : Nonempty ((Subobject.underlying.obj M').over (wcGeomPoint K (wcP1Over K) hP) ≅
      (wcContSheaf (wcP1Over K).left (Fin r' → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP))) :
    M' ≤ M :=
by
  classical
  obtain ⟨θ⟩ := hM
  obtain ⟨θ'⟩ := hM'
  let ρ := (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint K (wcP1Over K) hP)

  obtain ⟨f, hf⟩ : ∃ f : Subobject.underlying.obj M ⟶ Subobject.underlying.obj M',
      f = Subobject.ofLE M M' hle := ⟨_, rfl⟩
  have hfa : f ≫ M'.arrow = M.arrow := by rw [hf]; exact Subobject.ofLE_arrow hle
  have hfmono : Mono f := by
    rw [hf]
    first
      | infer_instance
      | exact mono_of_mono_fac (Subobject.ofLE_arrow hle)

  have hconn : ConnectedSpace (wcGeomPoint K (wcP1Over K) hP).left := by
    obtain ⟨e, he, -⟩ := wcpa_proj_base_change K (AlgebraicClosure K) 1
    haveI := he
    haveI := wc_proj_space_irreducible (AlgebraicClosure K) 1
    haveI : ConnectedSpace ↥(wcProjK (AlgebraicClosure K) 1) := IrreducibleSpace.connectedSpace _
    let h := Scheme.Hom.homeomorph (inv e)
    exact h.surjective.connectedSpace h.continuous

  obtain ⟨φ, hφ⟩ : ∃ φ : (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP) ⟶
      (wcContSheaf (wcP1Over K).left (Fin r' → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP),
      φ = θ.inv ≫ ρ.map f ≫ θ'.hom := ⟨_, rfl⟩
  have hφmono : Mono φ := by
    rw [hφ]
    haveI : Mono (ρ.map f) := Functor.map_mono ρ f
    infer_instance

  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over K).left ℓ
    (wcGeomPoint K (wcP1Over K) hP) hconn r r' φ
  have hAmono : Mono (ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
      (LinearMap.continuous_of_finiteDimensional A))) := by
    have h := hφmono
    rw [hA] at h
    exact h

  let one : Over (wcGeomPoint K (wcP1Over K) hP) := Over.mk (𝟙 _)
  have hcinj : Function.Injective ((ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
      (LinearMap.continuous_of_finiteDimensional A))).hom.app (Opposite.op one)) := by
    have h2 : Mono (ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional A))).hom := by
      first
        | exact (sheafToPresheaf _ AddCommGrpCat.{u+1}).map_mono _
        | exact (Sheaf.Hom.mono_iff_presheaf_mono _ _ _).mp hAmono
        | infer_instance
    have h3 : Mono ((ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional A))).hom.app (Opposite.op one)) := by
      first
        | infer_instance
        | exact (NatTrans.mono_iff_mono_app _).mp h2 _
    exact (AddCommGrpCat.mono_iff_injective _).mp h3
  have hinjA : Function.Injective A := by
    rw [injective_iff_map_eq_zero]
    intro v hv
    obtain ⟨z₀⟩ := hconn.toNonempty
    let s : ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP)).obj.obj (Opposite.op one) :=
      ULift.up (ContinuousMap.const (wcGeomPoint K (wcP1Over K) hP).left v)
    have h1 : ((ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional A))).hom.app (Opposite.op one)) s =
        ((ρ.map (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional A))).hom.app (Opposite.op one)) 0 := by
      rw [map_zero]
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      first
        | exact hv
        | (show A v = 0; exact hv)
    have hs := hcinj h1
    exact congrArg (fun x : ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP)).obj.obj (Opposite.op one) =>
      (show ULift.{u+1} C((wcGeomPoint K (wcP1Over K) hP).left, Fin r → ℚ_[ℓ]) from x).down z₀) hs

  have hle' : r ≤ r' := by
    have h := LinearMap.finrank_le_finrank_of_injective hinjA
    simpa [Module.finrank_fin_fun] using h
  have hrr : r' = r := by omega
  subst hrr
  have hsurjA : Function.Surjective A := LinearMap.injective_iff_surjective.mp hinjA

  let e := LinearEquiv.ofBijective A ⟨hinjA, hsurjA⟩
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f : A →+ B) (hf : Continuous f) (U : ((wcP1Over K).left.ProEt)ᵒᵖ)
      (x : ((wcContSheaf (wcP1Over K).left A).obj.obj U : Type (u+1))),
      (wcContSheafMap (wcP1Over K).left f hf).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget (wcP1Over K).left ⋙ Over.forget (wcP1Over K).left).obj
            (Opposite.unop U))) f hf
          (ULift.down x : C(↥((Scheme.ProEt.forget (wcP1Over K).left ⋙
            Over.forget (wcP1Over K).left).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ f hf U x
    rfl
  have hAc : Continuous (A.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional A
  have hBc : Continuous (e.symm.toLinearMap.toAddMonoidHom : _ →+ _) :=
    LinearMap.continuous_of_finiteDimensional e.symm.toLinearMap
  have hAB : wcContSheafMap (wcP1Over K).left A.toAddMonoidHom hAc ≫
      wcContSheafMap (wcP1Over K).left e.symm.toLinearMap.toAddMonoidHom hBc = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    first
      | (rw [key, key]
         apply ULift.ext
         apply ContinuousMap.ext
         intro z
         exact e.symm_apply_apply _)
      | (refine ULift.ext _ _ (ContinuousMap.ext fun z => ?_)
         exact e.symm_apply_apply _)
  have hBA : wcContSheafMap (wcP1Over K).left e.symm.toLinearMap.toAddMonoidHom hBc ≫
      wcContSheafMap (wcP1Over K).left A.toAddMonoidHom hAc = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    first
      | (rw [key, key]
         apply ULift.ext
         apply ContinuousMap.ext
         intro z
         exact e.apply_symm_apply _)
      | (refine ULift.ext _ _ (ContinuousMap.ext fun z => ?_)
         exact e.apply_symm_apply _)
  haveI : IsIso (wcContSheafMap (wcP1Over K).left A.toAddMonoidHom
      (LinearMap.continuous_of_finiteDimensional A)) := ⟨⟨_, hAB, hBA⟩⟩
  haveI hφiso : IsIso φ := by rw [hA]; infer_instance

  haveI hρf : IsIso (ρ.map f) := by
    have h : ρ.map f = θ.hom ≫ φ ≫ θ'.inv := by
      rw [hφ]; simp
    rw [h]; infer_instance

  have hσaff : IsAffineHom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    inferInstance
  have hσsurj : Surjective (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    constructor
    intro x
    refine ⟨IsLocalRing.closedPoint (AlgebraicClosure K), ?_⟩
    first
      | exact Subsingleton.elim _ _
      | exact Subsingleton.elim (α := PrimeSpectrum K) _ _
  have hŪaff : IsAffineHom (wcGeomPoint K (wcP1Over K) hP).hom := by
    show IsAffineHom (Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    first
      | exact MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback _ _).flip hσaff
      | infer_instance
  have hŪsurj : Surjective (wcGeomPoint K (wcP1Over K) hP).hom := by
    show Surjective (Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    first
      | exact MorphismProperty.of_isPullback (P := @Surjective)
          (IsPullback.of_hasPullback _ _).flip hσsurj
      | infer_instance
  have hŪw : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom := (wcGeomPoint K (wcP1Over K) hP).prop
  have hfepi : Epi f := by
    apply wc_proet_epi_of_affine_lift (wcP1Over K).left f
    intro U hU y
    haveI : WeaklyEtale U.hom := U.prop
    haveI : IsAffine U.left := hU
    haveI : IsAffineHom (wcGeomPoint K (wcP1Over K) hP).hom := hŪaff
    haveI hp1w : WeaklyEtale (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hŪw
    haveI hp1a : IsAffineHom (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom) := by
      first
        | exact MorphismProperty.of_isPullback (P := @IsAffineHom)
            (IsPullback.of_hasPullback _ _).flip hŪaff
        | infer_instance
    have hp1s : Surjective (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom) := by
      first
        | exact MorphismProperty.of_isPullback (P := @Surjective)
            (IsPullback.of_hasPullback _ _).flip hŪsurj
        | (haveI := hŪsurj; infer_instance)
    let V : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom ≫ U.hom) inferInstance
    let g : V ⟶ U := MorphismProperty.Over.homMk
      (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom) rfl trivial
    let q : V ⟶ wcGeomPoint K (wcP1Over K) hP := MorphismProperty.Over.homMk
      (Limits.pullback.snd U.hom (wcGeomPoint K (wcP1Over K) hP).hom)
      Limits.pullback.condition.symm trivial
    let W : Over (wcGeomPoint K (wcP1Over K) hP) := Over.mk q
    have hc : IsIso ((ρ.map f).hom.app (Opposite.op W)) := by
      have h1 : IsIso (ρ.map f).hom := by
        first
          | infer_instance
          | exact Functor.map_isIso (sheafToPresheaf _ AddCommGrpCat.{u+1}) (ρ.map f)
      infer_instance
    refine ⟨V, g, inv ((ρ.map f).hom.app (Opposite.op W))
      ((Subobject.underlying.obj M').obj.map g.op y), ?_, hp1s, ?_⟩
    · first
        | exact @isAffine_of_isAffineHom _ _
            (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom) hp1a hU
        | exact @isAffine_of_isAffineHom _ _
            (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom) hU hp1a
        | exact @isAffine_of_isAffineHom _ _ _ hp1a hU
        | exact @isAffine_of_isAffineHom _ _ _ hU hp1a
        | (show IsAffine (Limits.pullback U.hom (wcGeomPoint K (wcP1Over K) hP).hom)
           haveI := hp1a
           exact isAffine_of_isAffineHom
             (Limits.pullback.fst U.hom (wcGeomPoint K (wcP1Over K) hP).hom))
    · exact IsIso.inv_hom_id_apply ((ρ.map f).hom.app (Opposite.op W)) _

  haveI : IsIso f := isIso_of_mono_of_epi f
  exact Subobject.le_of_comm (inv f) (by rw [← hfa, IsIso.inv_hom_id_assoc])

theorem wc_geomConst_sup_closed (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hW : ConnectedSpace W.left) (N : ℕ)
    (θ : X.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W)
    (hX : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : X.obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        (X.obj.map h.op).hom x = 0) → x = 0)
    (hC : ∀ (a : ℕ) (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom x = 0) → x = 0)
    (M₁ M₂ : Subobject X)
