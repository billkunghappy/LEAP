    · exact MorphismProperty.Over.Hom.ext hℓ₁s
    · exact MorphismProperty.Over.Hom.ext (show (ℓ₂ ≫ φ) ≫ Limits.pullback.fst x.left w.left =
        c'₂.left by rw [Category.assoc, hφ, hℓ₂f])
    · intro U hU
      change ℓ₁ pt₁ ∈ U ↔ (ℓ₂ ≫ φ) pt₂ ∈ U
      rw [Scheme.Hom.comp_apply, hφz]
      constructor
      · exact hζK U hU
      · intro hζU
        by_contra hn
        exact (hζK Uᶜ hU.compl hn) hζU

  have hsurjX : ∀ y : X.left, ∃ zw : W.left, w.left zw = x.left y := by
    intro y
    have hz : ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom (x.left y) ≠
