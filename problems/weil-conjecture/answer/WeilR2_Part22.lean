      rw [hts]
      exact htx

theorem wc_hmg_transition_frames : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ) (θ : (wcRq D.f ℓ (n - 1)).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W), ConnectedSpace W.left → (∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left → a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) → ∃ G : ↥(Limits.pullback w.left w.left) → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])), (∀ z, ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcHonestFrame D ℓ W r θ γ (G z)) ∧ (∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W) (hl : a.left ≫ w.left = b.left ≫ w.left) (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left), (show C(↥V.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z = G (Limits.pullback.lift a.left b.left hl z) ((show C(↥V.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z)) ∧ (∀ j : Fin r, Continuous (fun z => G z (Pi.single j 1))) ∧ (∀ (Z : Scheme.{u}) (a b d : Z ⟶ W.left) (hab : a ≫ w.left = b ≫ w.left) (hbd : b ≫ w.left = d ≫ w.left) (had : a ≫ w.left = d ≫ w.left) (z : Z), G (Limits.pullback.lift a d had z) = G (Limits.pullback.lift b d hbd z) ∘ₗ G (Limits.pullback.lift a b hab z)) ∧ (∀ (δ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) (hδ : δ.left ≫ w.left = 𝟙 W.left ≫ w.left), δ ≫ w = w → wcHonestFrame D ℓ W r θ δ g → ∀ z, G (Limits.pullback.lift δ.left (𝟙 W.left) hδ z) ∘ₗ g = LinearMap.id) :=
by
  classical
  intro F' F'' _ _ _ _ Y n D ℓ _ hP W w r θ hW hgal

  haveI hBp : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    (wcGeomPoint F'' (wcP1Over F'') hP).prop
  haveI hWp : WeaklyEtale W.hom := W.prop
  haveI hwB : WeaklyEtale (w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
    rw [MorphismProperty.Over.w w]; exact hWp
  haveI hwl : WeaklyEtale w.left :=
    WeaklyEtale.of_comp w.left (wcGeomPoint F'' (wcP1Over F'') hP).hom

  have TR : ∀ (V V' : (wcP1Over F'').left.ProEt) (h' : V' ⟶ W) (j : V ⟶ V')
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V.left),
      (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map j.op).hom y)).down) z =
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (j.left z) := by
    intro V V' h' j y z
    have hn := θ.hom.hom.naturality
      (Over.homMk j (by rfl) : (Over.mk (j ≫ h') : Over W) ⟶ Over.mk h').op
    have h1 := congrArg (fun m => m.hom y) hn
    have h2 : (θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map j.op).hom y) =
        ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.map j.op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := h1
    rw [h2]
    rfl

  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
  have hK : ∀ (V : (wcP1Over F'').left.ProEt) (a : V ⟶ W) (v₀ : Fin r → ℚ_[ℓ]),
      ∃ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V), ∀ x : V.left,
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) x = v₀ := by
    intro V a v₀
    let c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) from
        ULift.up (ContinuousMap.const ↥V.left v₀))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom c, fun x => ?_⟩
    have hs := hcancel2 (Over.mk a) c
    exact congrArg (fun y : ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) => y.down x) hs

  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W hW r θ γ

  have hnbhd : ∀ (V₀ : (wcP1Over F'').left.ProEt) (z : V₀.left),
      ∃ (V₁ : (wcP1Over F'').left.ProEt) (k : V₁ ⟶ V₀) (z₁ : V₁.left),
        ConnectedSpace V₁.left ∧ k.left z₁ = z := by
    intro V₀ z
    have hι : WeaklyEtale (V₀.left.fromSpecStalk z) := by
      refine ⟨?_, inferInstance⟩
      obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
        V₀.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
      replace hU : IsAffineOpen U := hU
      rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
      show Flat (Spec.map (V₀.left.presheaf.germ U z hx) ≫ hU.fromSpec)
      have : Flat (Spec.map (V₀.left.presheaf.germ U z hx)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat)]
        letI : Algebra Γ(V₀.left, U) (V₀.left.presheaf.stalk z) :=
          (V₀.left.presheaf.germ U z hx).hom.toAlgebra
        haveI := hU.isLocalization_stalk ⟨z, hx⟩
        exact RingHom.flat_algebraMap_iff.mpr
          (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
      have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
      have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
      exact MorphismProperty.comp_mem @Flat _ _ this hfs
    have hcomp : WeaklyEtale (V₀.left.fromSpecStalk z ≫ V₀.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V₀.prop
    let V₁ : (wcP1Over F'').left.ProEt :=
      MorphismProperty.Over.mk ⊤ (V₀.left.fromSpecStalk z ≫ V₀.hom) hcomp
    let k : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (V₀.left.fromSpecStalk z) rfl trivial
    have hconnR : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
      intro R _
      have hpre : PreconnectedSpace (PrimeSpectrum R) := by
        rw [preconnectedSpace_iff_clopen]
        intro s hs
        obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
        · right
          have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
          subst he1
          simp
        · left
          have he0 : e = 0 := by
            have h0 : (1 - e) * e = (1 - e) * 0 := by
              rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
            exact h.mul_left_cancel h0
          subst he0
          simp
      have hc : ConnectedSpace (PrimeSpectrum R) :=
        { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R⟩ }
      exact hc
    exact ⟨V₁, k, IsLocalRing.closedPoint _, hconnR (V₀.left.presheaf.stalk z),
      Scheme.fromSpecStalk_closedPoint⟩

  haveI : WeaklyEtale (Limits.pullback.fst w.left w.left) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
  let Zo : (wcP1Over F'').left.ProEt :=
    Scheme.ProEt.mk (Limits.pullback.fst w.left w.left ≫ W.hom)
  let P₁ : Zo ⟶ W :=
    MorphismProperty.Over.homMk (Limits.pullback.fst w.left w.left) rfl trivial
  have h₂ : Limits.pullback.snd w.left w.left ≫ W.hom =
      Limits.pullback.fst w.left w.left ≫ W.hom := by
    rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Category.assoc,
      Limits.pullback.condition]
  let P₂ : Zo ⟶ W :=
    MorphismProperty.Over.homMk (Limits.pullback.snd w.left w.left) h₂ trivial
  have hPw : P₁ ≫ w = P₂ ≫ w := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition (f := w.left) (g := w.left)

  choose V₁ κ z₁ hc hκ using fun z : ↥(Limits.pullback w.left w.left) => hnbhd Zo z
  have hab0 : ∀ z, (κ z ≫ P₁) ≫ w = (κ z ≫ P₂) ≫ w := fun z => by
    rw [Category.assoc, Category.assoc, hPw]
  choose γ hγw hγ using fun z => hgal (V₁ z) (κ z ≫ P₁) (κ z ≫ P₂) (hc z) (hab0 z)

  have hb : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W)
      (hl : a.left ≫ w.left = b.left ≫ w.left)
      (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z =
      A (γ (Limits.pullback.lift a.left b.left hl z))
        ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z) := by
    intro V a b hl t v
    generalize hz₀ : Limits.pullback.lift a.left b.left hl v = z₀
    have hKw : Limits.pullback.lift a.left b.left hl ≫
        (Limits.pullback.fst w.left w.left ≫ W.hom) = V.hom := by
      rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w a]
    let K : V ⟶ Zo :=
      MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hl) hKw trivial
    have hK1 : K ≫ P₁ = a := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_fst a.left b.left hl
    have hK2 : K ≫ P₂ = b := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_snd a.left b.left hl
    haveI : WeaklyEtale (V₁ z₀).hom := (V₁ z₀).prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hZp : WeaklyEtale Zo.hom := Zo.prop
    haveI : WeaklyEtale (K.left ≫ Zo.hom) := by
      rw [MorphismProperty.Over.w K]; exact hVp
    haveI : WeaklyEtale K.left := WeaklyEtale.of_comp K.left Zo.hom
    haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left K.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom) :=
      inferInstance
    let Q : (wcP1Over F'').left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom)
    let p₁ : Q ⟶ V₁ z₀ :=
      MorphismProperty.Over.homMk (Limits.pullback.fst (κ z₀).left K.left) rfl trivial
    have hq2 : Limits.pullback.snd (κ z₀).left K.left ≫ V.hom =
        Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom := by
      rw [← MorphismProperty.Over.w K, ← MorphismProperty.Over.w (κ z₀), ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let p₂ : Q ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.snd (κ z₀).left K.left) hq2 trivial
    have hsq : p₁ ≫ κ z₀ = p₂ ≫ K := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition (f := (κ z₀).left) (g := K.left)
    obtain ⟨q, -, hqv⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := (κ z₀).left) (g := K.left) (z₁ z₀) v ((hκ z₀).trans hz₀.symm)
    have key : p₂ ≫ b = (p₂ ≫ a) ≫ γ z₀ := by
      calc p₂ ≫ b = p₂ ≫ K ≫ P₂ := by rw [hK2]
        _ = (p₂ ≫ K) ≫ P₂ := (Category.assoc _ _ _).symm
        _ = (p₁ ≫ κ z₀) ≫ P₂ := by rw [hsq]
        _ = p₁ ≫ (κ z₀ ≫ P₂) := Category.assoc _ _ _
        _ = p₁ ≫ ((κ z₀ ≫ P₁) ≫ γ z₀) := by rw [hγ z₀]
        _ = ((p₁ ≫ κ z₀) ≫ P₁) ≫ γ z₀ := by simp only [Category.assoc]
        _ = ((p₂ ≫ K) ≫ P₁) ≫ γ z₀ := by rw [hsq]
        _ = (p₂ ≫ a) ≫ γ z₀ := by rw [Category.assoc p₂, hK1]
    have hF := hA (γ z₀) Q (p₂ ≫ a) (p₂ ≫ b) key
      (((wcRq D.f ℓ (n - 1)).obj.map p₂.op).hom t) q
    have L := TR Q V b p₂ t q
    have R := TR Q V a p₂ t q
    have hp : p₂.left q = v := hqv
    rw [hp] at L R
    exact L.symm.trans (hF.trans (congrArg (A (γ z₀)) R))
  refine ⟨fun z => A (γ z), ?_, hb, ?_, ?_, ?_⟩
  ·
    intro z
    exact ⟨γ z, hγw z, fun s x => hA (γ z) W (𝟙 W) (γ z) (Category.id_comp _).symm s x⟩
  ·
    intro j
    have hl : P₁.left ≫ w.left = P₂.left ≫ w.left :=
      Limits.pullback.condition (f := w.left) (g := w.left)
    have hid : ∀ z : ↥(Limits.pullback w.left w.left),
        Limits.pullback.lift P₁.left P₂.left hl z = z := by
      intro z
      have e : Limits.pullback.lift P₁.left P₂.left hl = 𝟙 _ :=
        Limits.pullback.lift_fst_snd w.left w.left
      rw [e]
      rfl
    obtain ⟨t, ht⟩ := hK Zo P₁ (Pi.single j 1)
    have hcont := (show C(↥Zo.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom t).down).continuous
    refine hcont.congr ?_
    intro z
    have h1 := hb Zo P₁ P₂ hl t z
    rw [ht z, hid z] at h1
    exact h1
  ·
    intro Z a b d hab hbd had z
    obtain ⟨f₂, hf₂⟩ : ∃ f : Limits.pullback w.left w.left ⟶
        (wcGeomPoint F'' (wcP1Over F'') hP).left,
        f = Limits.pullback.snd w.left w.left ≫ w.left := ⟨_, rfl⟩
    haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left ≫
      Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
    let Q3 : (wcP1Over F'').left.ProEt := Scheme.ProEt.mk (Limits.pullback.fst f₂ w.left ≫
      Limits.pullback.fst w.left w.left ≫ W.hom)
    have eab : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) ≫ w.left =
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left := by
      rw [Category.assoc, Category.assoc, Limits.pullback.condition (f := w.left) (g := w.left)]
    have ebd : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left =
        Limits.pullback.snd f₂ w.left ≫ w.left := by
      rw [Category.assoc, ← hf₂]
      exact Limits.pullback.condition (f := f₂) (g := w.left)
    have ead := eab.trans ebd
    have hqb : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ W.hom =
        Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left ≫ W.hom := by
      rw [← MorphismProperty.Over.w w,
        ← Category.assoc (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left),
        ← eab]
      simp only [Category.assoc]
    have hqd : Limits.pullback.snd f₂ w.left ≫ W.hom =
        Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left ≫ W.hom := by
      rw [← MorphismProperty.Over.w w, ← Category.assoc (Limits.pullback.snd f₂ w.left),
        ← ebd, ← eab]
      simp only [Category.assoc]
    let Qa : Q3 ⟶ W := MorphismProperty.Over.homMk
      (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
      (Category.assoc _ _ _) trivial
    let Qb : Q3 ⟶ W := MorphismProperty.Over.homMk
      (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) hqb trivial
    let Qd : Q3 ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd f₂ w.left) hqd trivial
    have hQ : ∀ y : ↥(Limits.pullback f₂ w.left),
        A (γ (Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.snd f₂ w.left) ead y)) =
        A (γ (Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
          (Limits.pullback.snd f₂ w.left) ebd y)) ∘ₗ
        A (γ (Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab y)) := by
      intro y
      apply LinearMap.ext
      intro v₀
      obtain ⟨t, ht⟩ := hK Q3 Qa v₀
      have e1 := hb Q3 Qa Qb eab t y
      have e2 := hb Q3 Qb Qd ebd t y
      have e3 := hb Q3 Qa Qd ead t y
      rw [ht y] at e1 e3
      rw [e1] at e2
      rw [LinearMap.comp_apply]
      exact e3.symm.trans e2
    have hm : Limits.pullback.lift a b hab ≫ f₂ = d ≫ w.left := by
      rw [hf₂, Limits.pullback.lift_snd_assoc]
      exact hbd
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Z ⟶ Limits.pullback f₂ w.left,
        m ≫ Limits.pullback.fst f₂ w.left = Limits.pullback.lift a b hab ∧
        m ≫ Limits.pullback.snd f₂ w.left = d :=
      ⟨Limits.pullback.lift _ _ hm, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have ma : m ≫ (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) = a := by
      rw [← Category.assoc, hm1, Limits.pullback.lift_fst]
    have mb : m ≫ (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) = b := by
      rw [← Category.assoc, hm1, Limits.pullback.lift_snd]
    have e_ab : Limits.pullback.lift a b hab = m ≫ Limits.pullback.lift
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, ma]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, mb]
    have e_bd : Limits.pullback.lift b d hbd = m ≫ Limits.pullback.lift
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
        (Limits.pullback.snd f₂ w.left) ebd := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, mb]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hm2]
    have e_ad : Limits.pullback.lift a d had = m ≫ Limits.pullback.lift
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
        (Limits.pullback.snd f₂ w.left) ead := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, ma]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hm2]
    have k1 : Limits.pullback.lift a d had z = Limits.pullback.lift
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
        (Limits.pullback.snd f₂ w.left) ead (m z) := by
      rw [e_ad]; exact Scheme.Hom.comp_apply _ _ _
    have k2 : Limits.pullback.lift b d hbd z = Limits.pullback.lift
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
        (Limits.pullback.snd f₂ w.left) ebd (m z) := by
      rw [e_bd]; exact Scheme.Hom.comp_apply _ _ _
    have k3 : Limits.pullback.lift a b hab z = Limits.pullback.lift
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab (m z) := by
      rw [e_ab]; exact Scheme.Hom.comp_apply _ _ _
    show A (γ (Limits.pullback.lift a d had z)) =
      A (γ (Limits.pullback.lift b d hbd z)) ∘ₗ A (γ (Limits.pullback.lift a b hab z))
    rw [k1, k2, k3]
    exact hQ (m z)
  ·
    intro δ g hδ _ hg z
    apply LinearMap.ext
    intro v₀
    obtain ⟨s, hs⟩ := hK W (𝟙 W) v₀
    have h1 := hb W δ (𝟙 W) hδ s z
    have h2 := hg s z
    rw [hs z] at h1 h2
    rw [h2] at h1
    rw [LinearMap.comp_apply, LinearMap.id_apply]
    exact h1.symm

theorem wc_hmg_punct_galois_split : ∀ (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S' : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)), (∀ i, S' i ≫ (wcP1Over F'').hom = 𝟙 _) → ∀ (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens), (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔ ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S' i (IsLocalRing.closedPoint F'')) → ∀ (i : Fin m) (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)), V.hom (e.inv (IsLocalRing.closedPoint A)) = S' i (IsLocalRing.closedPoint F'') → ∀ (Yc : Scheme.{u}) (qY : Yc ⟶ Limits.pullback v.left Ub.ι), IsFinite qY → Etale qY → (∀ (T : (wcP1Over F'').left.ProEt) (uT : T ⟶ V) (L : Type u) [Field L] [IsSepClosed L] (eT : T.left ≅ Spec (.of L)) (t : T.left ⟶ Limits.pullback v.left Ub.ι), t ≫ Limits.pullback.fst v.left Ub.ι = uT.left → ∀ (sY : T.left ⟶ Yc), sY ≫ qY = t → ∀ τ : T ⟶ T, τ ≫ uT = uT → τ.left ≫ sY = sY) → ∀ y : Yc, ∃ sec : Limits.pullback v.left Ub.ι ⟶ Yc, sec ≫ qY = 𝟙 _ ∧ y ∈ Set.range ⇑sec :=
by
  intro F'' _ _ hP m S' hS' Ub hUb i V v A _ _ _ e hV Yc qY hfin het hgeo y

  have s4 : ∀ (K B : Type u) [Field K] [CommRing B] [Algebra K B], Module.Finite K B →
      Algebra.Etale K B →
      (∀ (φ : B →ₐ[K] SeparableClosure K) (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K),
        σ.toAlgHom.comp φ = φ) →
      ∀ P : Ideal B, P.IsPrime → ∃ r : B →ₐ[K] K, RingHom.ker r = P := by
    intro K B _ _ _ hfinB hetB hfix P hP
    haveI : IsArtinianRing B := IsArtinianRing.of_finite K B
    haveI : P.IsMaximal := IsArtinianRing.isMaximal_of_isPrime P
    letI : Field (B ⧸ P) := Ideal.Quotient.field P
    haveI : Algebra.IsSeparable K (B ⧸ P) := Algebra.FormallyUnramified.isSeparable K (B ⧸ P)
    let ψ : (B ⧸ P) →ₐ[K] SeparableClosure K := IsSepClosed.lift
    let φ : B →ₐ[K] SeparableClosure K := ψ.comp (Ideal.Quotient.mkₐ K P)
    have hd : ∀ b, φ b ∈ (⊥ : Subalgebra K (SeparableClosure K)) := by
      intro b
      have h1 : φ b ∈ IntermediateField.fixedField
          (IntermediateField.fixingSubgroup (⊥ : IntermediateField K (SeparableClosure K))) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro σ _
        exact congrArg (fun f => f b) (hfix φ σ)
      rw [InfiniteGalois.fixedField_fixingSubgroup, IntermediateField.mem_bot] at h1
      exact Algebra.mem_bot.mpr h1
    let r : B →ₐ[K] K :=
      (Algebra.botEquiv K (SeparableClosure K)).toAlgHom.comp (φ.codRestrict ⊥ hd)
    refine ⟨r, ?_⟩
    ext b
    rw [RingHom.mem_ker]
    have e1 : r b = 0 ↔ φ.codRestrict ⊥ hd b = 0 :=
      map_eq_zero_iff (Algebra.botEquiv K (SeparableClosure K)) (Algebra.botEquiv K _).injective
    have e2 : φ.codRestrict ⊥ hd b = 0 ↔ φ b = 0 := by
      rw [← Subtype.coe_inj]; rfl
    have e3 : φ b = 0 ↔ Ideal.Quotient.mk P b = 0 :=
      map_eq_zero_iff ψ ψ.toRingHom.injective
    rw [e1, e2, e3, Ideal.Quotient.eq_zero_iff_mem]

  have s2 : ∀ (X : Scheme.{u}), IsIntegral X → (∀ x y : X, x = y) →
      ∃ (K : Type u) (_ : Field K), Nonempty (X ≅ Spec (.of K)) := by
    intro X hX hsub
    obtain ⟨x⟩ := (inferInstance : Nonempty X)
    haveI : IsAffine X := by
      obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens X)) (show x ∈ (⊤ : X.Opens) from trivial)
      have hUtop : U = ⊤ := by
        ext z
        constructor
        · intro _; trivial
        · intro _; rw [hsub z x]; exact hxU
      have h2 : IsAffineOpen (⊤ : X.Opens) := hUtop ▸ hU
      haveI : IsAffine (⊤ : X.Opens).toScheme := h2
      exact IsAffine.of_isIso X.topIso.inv
    haveI : Nonempty (⊤ : X.Opens) := ⟨⟨x, trivial⟩⟩
    haveI : IsDomain Γ(X, ⊤) := inferInstance
    have hfield : IsField Γ(X, ⊤) := by
      rw [Ring.isField_iff_maximal_bot]
      obtain ⟨M, hM, -⟩ := Ideal.exists_le_maximal (⊥ : Ideal Γ(X, ⊤)) bot_ne_top
      let p0 : Spec Γ(X, ⊤) := ⟨⊥, Ideal.isPrime_bot⟩
      let p1 : Spec Γ(X, ⊤) := ⟨M, hM.isPrime⟩
      have h := hsub (X.isoSpec.inv p0) (X.isoSpec.inv p1)
      have h' : p0 = p1 := by
        have := congrArg X.isoSpec.hom h
        simpa using this
      have : (⊥ : Ideal Γ(X, ⊤)) = M := congrArg PrimeSpectrum.asIdeal h'
      rw [this]; exact hM
    letI : Field Γ(X, ⊤) := hfield.toField
    exact ⟨Γ(X, ⊤), inferInstance, ⟨X.isoSpec⟩⟩

  have s3 : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of K)), IsFinite q →
      Etale q → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra K B) (eY : Y ≅ Spec (.of B)),
        Module.Finite K B ∧ Algebra.Etale K B ∧
          eY.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K B)) = q := by
    intro K _ Y q hf he
    haveI : IsAffine Y := isAffine_of_isAffineHom q
    let φ : CommRingCat.of K ⟶ Γ(Y, ⊤) := (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop
    letI : Algebra K Γ(Y, ⊤) := φ.hom.toAlgebra
    have hsq : Y.isoSpec.hom ≫ Spec.map φ = q := by
      simp only [φ, Spec.map_comp]
      rw [← Category.assoc, Scheme.isoSpec_hom_naturality q, Category.assoc,
        Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
    have hsq' : Spec.map φ = Y.isoSpec.inv ≫ q := by
      rw [← hsq, Iso.inv_hom_id_assoc]
    have hfin' : IsFinite (Spec.map φ) := by rw [hsq']; infer_instance
    have het' : Etale (Spec.map φ) := by rw [hsq']; infer_instance
    refine ⟨Γ(Y, ⊤), inferInstance, inferInstance, Y.isoSpec, ?_, ?_, ?_⟩
    · exact ((IsFinite.SpecMap_iff φ).mp hfin')
    · exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp het'
    · exact hsq

  have s5 : ∀ (S : Scheme.{u}) (V : S.ProEt) (P0 : Scheme.{u}) (fst0 : P0 ⟶ V.left)
      [IsOpenImmersion fst0]
      (K : Type u) [Field K] (eK : P0 ≅ Spec (.of K)) (Yc : Scheme.{u}) (qY : Yc ⟶ P0)
      (B : Type u) [CommRing B] [Algebra K B] (eY : Yc ≅ Spec (.of B)),
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) →
      eY.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K B)) = qY ≫ eK.hom →
      (∀ (T : S.ProEt) (uT : T ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
        (eT : T.left ≅ Spec (.of L))
        (t : T.left ⟶ P0), t ≫ fst0 = uT.left → ∀ (sY : T.left ⟶ Yc), sY ≫ qY = t →
        ∀ τ : T ⟶ T, τ ≫ uT = uT → τ.left ≫ sY = sY) →
      ∀ (φ : B →ₐ[K] SeparableClosure K) (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K),
        σ.toAlgHom.comp φ = φ := by
    intro S V P0 fst0 _ K _ eK Yc qY B _ _ eY hW hcomp hgeo φ σ
    let ι : Spec (.of (SeparableClosure K)) ⟶ Spec (.of K) :=
      Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))
    let g : Spec (.of (SeparableClosure K)) ⟶ V.left := ι ≫ eK.inv ≫ fst0
    have hT : WeaklyEtale (g ≫ V.hom) := by
      have e : g ≫ V.hom = ι ≫ (eK.inv ≫ fst0 ≫ V.hom) := by
        simp only [g, Category.assoc]
      rw [e]
      exact @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hW
        (@MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _
          (etale_le_weaklyEtale _ _ _ inferInstance)
          (@MorphismProperty.comp_mem _ _ @WeaklyEtale
            MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _
            (etale_le_weaklyEtale _ _ _ inferInstance) V.prop))
    let T : S.ProEt := MorphismProperty.Over.mk ⊤ (g ≫ V.hom) hT
    let uT : T ⟶ V := MorphismProperty.Over.homMk g rfl trivial
    have hring : CommRingCat.ofHom (algebraMap K (SeparableClosure K)) ≫
        CommRingCat.ofHom (σ : SeparableClosure K →+* SeparableClosure K) =
        CommRingCat.ofHom (algebraMap K (SeparableClosure K)) := by
      ext x
      simp
    have hσι : Spec.map (CommRingCat.ofHom (σ : SeparableClosure K →+* SeparableClosure K)) ≫ ι
        = ι := by
      simp only [ι, ← Spec.map_comp, hring]
    have hσg : Spec.map (CommRingCat.ofHom (σ : SeparableClosure K →+* SeparableClosure K)) ≫ g
        = g := by
      simp only [g, ← Category.assoc, hσι]
    let τ : T ⟶ T := MorphismProperty.Over.homMk
      (Spec.map (CommRingCat.ofHom (σ : SeparableClosure K →+* SeparableClosure K)))
      (by
        show Spec.map _ ≫ (g ≫ V.hom) = g ≫ V.hom
        rw [← Category.assoc, hσg]) trivial
    have hτ : τ ≫ uT = uT := by
      apply MorphismProperty.Over.Hom.ext
      exact hσg
    let sY0 : Spec (.of (SeparableClosure K)) ⟶ Yc :=
      Spec.map (CommRingCat.ofHom (φ : B →+* SeparableClosure K)) ≫ eY.inv
    have h1 : eY.inv ≫ qY = Spec.map (CommRingCat.ofHom (algebraMap K B)) ≫ eK.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, hcomp, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hringφ : CommRingCat.ofHom (algebraMap K B) ≫
        CommRingCat.ofHom (φ : B →+* SeparableClosure K) =
        CommRingCat.ofHom (algebraMap K (SeparableClosure K)) := by
      ext x
      simp
    have hsY : sY0 ≫ qY = ι ≫ eK.inv := by
      simp only [sY0, Category.assoc, h1]
      rw [← Category.assoc, ← Spec.map_comp, hringφ]
    have key := hgeo T uT (SeparableClosure K) (Iso.refl _) (ι ≫ eK.inv) rfl sY0 hsY τ hτ
    change Spec.map (CommRingCat.ofHom (σ : SeparableClosure K →+* SeparableClosure K)) ≫
        Spec.map (CommRingCat.ofHom (φ : B →+* SeparableClosure K)) ≫ eY.inv =
      Spec.map (CommRingCat.ofHom (φ : B →+* SeparableClosure K)) ≫ eY.inv at key
    rw [← Category.assoc, Iso.cancel_iso_inv_right, ← Spec.map_comp] at key
    have h2 := Spec.map_inj.mp key
    apply AlgHom.ext
    intro b
    have h3 := congrArg (fun f => f.hom b) h2
    simpa using h3

  have hoff : ∀ x : ↥(Limits.pullback v.left Ub.ι),
      Limits.pullback.fst v.left Ub.ι x ≠ e.inv (IsLocalRing.closedPoint A) := by
    intro x hx
    have h2 : v.left (Limits.pullback.fst v.left Ub.ι x) =
        Ub.ι (Limits.pullback.snd v.left Ub.ι x) := by
      rw [← Scheme.Hom.comp_apply (Limits.pullback.fst v.left Ub.ι) v.left,
        ← Scheme.Hom.comp_apply (Limits.pullback.snd v.left Ub.ι) Ub.ι,
        Limits.pullback.condition]
    have h5 : V.hom (Limits.pullback.fst v.left Ub.ι x) =
        (wcGeomPoint F'' (wcP1Over F'') hP).hom
          (v.left (Limits.pullback.fst v.left Ub.ι x)) := by
      rw [← Scheme.Hom.comp_apply v.left (wcGeomPoint F'' (wcP1Over F'') hP).hom,
        MorphismProperty.Over.w v]
    have hy : Ub.ι (Limits.pullback.snd v.left Ub.ι x) ∈ Ub :=
      (Limits.pullback.snd v.left Ub.ι x).2
    have h6 := (hUb _).mp hy i
    rw [← h2, ← h5, hx, hV] at h6
    exact h6 rfl
  obtain ⟨V₀, j, hj, hrange, hsub⟩ := wc_P1_shens_punct_subsingleton F'' (S' i) (hS' i) V A e hV
  have hsubP : ∀ x x' : ↥(Limits.pullback v.left Ub.ι), x = x' := by
    intro x x'
    have hx : Limits.pullback.fst v.left Ub.ι x ∈ Set.range j.left := by
      rw [hrange]; exact hoff x
    have hx' : Limits.pullback.fst v.left Ub.ι x' ∈ Set.range j.left := by
      rw [hrange]; exact hoff x'
    obtain ⟨a, ha⟩ := hx
    obtain ⟨a', ha'⟩ := hx'
    have hfx : Limits.pullback.fst v.left Ub.ι x = Limits.pullback.fst v.left Ub.ι x' := by
      rw [← ha, ← ha', hsub a a']
    exact (Limits.pullback.fst v.left Ub.ι).isOpenEmbedding.injective hfx
  obtain ⟨c, ψ, j', -, -, hWE, hcl⟩ := wc_skc_chart_factor F'' (S' i) (hS' i) V A e hV
  have hmem := (hcl (e.inv (IsLocalRing.closedPoint A))).mp (by rw [hV]; exact subset_closure rfl)
  have hm : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h' := congrArg PrimeSpectrum.asIdeal (Scheme.inv_hom_apply e (IsLocalRing.closedPoint A))
    rw [h'] at hmem
    exact hmem
  obtain ⟨hdom, -, -⟩ := wc_skc_dvr F'' A c ψ hWE hm
  haveI : IsDomain A := hdom
  haveI : Nonempty V.left := ⟨Limits.pullback.fst v.left Ub.ι (qY y)⟩
  haveI : IsIntegral V.left := isIntegral_of_isOpenImmersion e.hom
  haveI : Nonempty ↥(Limits.pullback v.left Ub.ι) := ⟨qY y⟩
  haveI hint : IsIntegral (Limits.pullback v.left Ub.ι) :=
    isIntegral_of_isOpenImmersion (Limits.pullback.fst v.left Ub.ι)

  obtain ⟨K, _, ⟨eK⟩⟩ := s2 _ hint hsubP
  haveI := hfin
  haveI := het
  obtain ⟨B, _, _, eY, hBfin, hBet, hcomp⟩ := s3 K Yc (qY ≫ eK.hom) inferInstance inferInstance
  have hfix := s5 (wcP1Over F'').left V (Limits.pullback v.left Ub.ι)
    (Limits.pullback.fst v.left Ub.ι) K eK Yc qY B eY (wc_fpe_sepClosure_weaklyEtale K) hcomp hgeo
  obtain ⟨r, hr⟩ := s4 K B hBfin hBet hfix (eY.hom y).asIdeal (eY.hom y).isPrime
  let sec := eK.hom ≫ Spec.map (CommRingCat.ofHom (r : B →+* K)) ≫ eY.inv
  refine ⟨sec, ?_, ?_⟩
  · have h1 : eY.inv ≫ qY = Spec.map (CommRingCat.ofHom (algebraMap K B)) ≫ eK.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, hcomp, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hring : CommRingCat.ofHom (algebraMap K B) ≫ CommRingCat.ofHom (r : B →+* K) = 𝟙 _ := by
      ext x; simp
    simp only [sec, Category.assoc, h1]
    rw [← Category.assoc (Spec.map _), ← Spec.map_comp, hring, Spec.map_id, Category.id_comp,
      Iso.hom_inv_id]
  · refine ⟨eK.inv (IsLocalRing.closedPoint K), ?_⟩
    have hpt : Spec.map (CommRingCat.ofHom (r : B →+* K)) (IsLocalRing.closedPoint K) =
        eY.hom y := by
      apply PrimeSpectrum.ext
      show Ideal.comap (r : B →+* K) (IsLocalRing.maximalIdeal K) = (eY.hom y).asIdeal
      rw [IsLocalRing.maximalIdeal_eq_bot, ← hr]
      ext b
      rw [Ideal.mem_comap, Ideal.mem_bot, RingHom.mem_ker]
      rfl
    simp only [sec]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    have e1 := Scheme.inv_hom_apply eK (IsLocalRing.closedPoint K)
    exact (congrArg (fun z => eY.inv (Spec.map (CommRingCat.ofHom (r : B →+* K)) z)) e1).trans
      ((congrArg (fun z => eY.inv z) hpt).trans (Scheme.hom_inv_apply eY y))

theorem wc_hmg_torsion_cover (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
      ∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F''))
    (U₂ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) (q : ℕ)
    (π : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q → ℚ_[ℓ]))
    (hπs : ∀ y, ∃ x ∈ U₂, π x = y)
    (hst : ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      γ ≫ w = w → wcHonestFrame D ℓ W r θ γ g →
      ∀ x ∈ U₂, g x ∈ U₂ ∧ ((∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j‖ ≤ 1))
    (hin : ∀ (i : Fin D.m) (σ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      wcHonestIsInertia D hP W w i σ → wcHonestFrame D ℓ W r θ σ g →
      ∀ x ∈ U₂, π (g x) = π x)
    (k : ℕ) :
    ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      (∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
        (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
        ∀ y : ↥(Limits.pullback πE (Limits.pullback.snd v.left Ub.ι) : Scheme.{u}),
          ∃ sec : Limits.pullback v.left Ub.ι ⟶ Limits.pullback πE (Limits.pullback.snd v.left Ub.ι),
            sec ≫ Limits.pullback.snd _ _ = 𝟙 _ ∧ y ∈ Set.range ⇑sec) ∧
      (∀ sec : Ub.toScheme ⟶ E, sec ≫ πE = 𝟙 _ →
        ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
          γ ≫ w = w → wcHonestFrame D ℓ W r θ γ g →
          ∀ x ∈ U₂, (∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j - π x j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) :=
by
  classical
  haveI := hconn
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty

  have hfrex : ∀ γ : W ⟶ W, ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      wcHonestFrame D ℓ W r θ γ A := by
    intro γ
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W
      hconn r θ γ
    exact ⟨A, fun s z => hA W (𝟙 W) γ (Category.id_comp γ).symm s z⟩
  obtain ⟨G, hGa, -, hGc, hGd, hGe⟩ := wc_hmg_transition_frames F' F'' Y n D ℓ hP W w r θ hconn hgal
  have hdeckl : ∀ δ : W ⟶ W, δ ≫ w = w → δ.left ≫ w.left = 𝟙 W.left ≫ w.left := by
    intro δ hδ
    rw [Category.id_comp]
    exact congrArg (fun f => f.left) hδ
  let GG : Set ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) :=
    {g | ∃ δ : W ⟶ W, δ ≫ w = w ∧ wcHonestFrame D ℓ W r θ δ g}
  have hGst : ∀ g ∈ GG, ∀ x ∈ U₂, g x ∈ U₂ ∧ ((∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j‖ ≤ 1) := by
    rintro g ⟨δ, hδ, hg⟩ x hx
    exact hst δ g hδ hg x hx
  have hGinv : ∀ g ∈ GG, ∃ g' ∈ GG, ∀ x ∈ U₂, g' (g x) = x := by
    rintro g ⟨δ, hδ, hg⟩
    refine ⟨G (Limits.pullback.lift δ.left (𝟙 W.left) (hdeckl δ hδ) z₀), hGa _, fun x _ => ?_⟩
    have h2 := LinearMap.congr_fun (hGe δ g (hdeckl δ hδ) hδ hg z₀) x
    rw [LinearMap.comp_apply, LinearMap.id_apply] at h2
    exact h2
  obtain ⟨ρ, hρ1, hρ2, hρ3, hρ4, hρ5⟩ :=
    wc_hmg_lattice_reduction ℓ r q k U₂ π hπs GG hGst hGinv

  have hrange : Set.range ⇑w.left ⊆ Set.range ⇑Ub.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    show w.left z ∈ Ub
    rw [hUb]
    intro i
    have h1 : (wcGeomPoint F'' (wcP1Over F'') hP).hom (w.left z) = W.hom z := by
      rw [← Scheme.Hom.comp_apply w.left (wcGeomPoint F'' (wcP1Over F'') hP).hom,
        MorphismProperty.Over.w w]
    rw [h1]
    exact hoff z i
  obtain ⟨p, hp⟩ : ∃ p : W.left ⟶ Ub.toScheme, p ≫ Ub.ι = w.left :=
    ⟨_, IsOpenImmersion.lift_fac Ub.ι w.left hrange⟩
  haveI hwe : WeaklyEtale w.left := by
    haveI : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
      (wcGeomPoint F'' (wcP1Over F'') hP).prop
    haveI : WeaklyEtale (w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
      rw [MorphismProperty.Over.w w]; exact W.prop
    exact WeaklyEtale.of_comp w.left (wcGeomPoint F'' (wcP1Over F'') hP).hom
  haveI hpe : WeaklyEtale p := by
    haveI : WeaklyEtale (p ≫ Ub.ι) := by rw [hp]; exact hwe
    exact WeaklyEtale.of_comp p Ub.ι
  have hpflat : Flat p := inferInstance
  have hpqc : QuasiCompact p := by
    haveI : QuasiCompact (p ≫ Ub.ι) := by rw [hp]; exact hqc
    exact QuasiCompact.of_comp p Ub.ι
  have hιinj : Function.Injective Ub.ι := Ub.ι.isOpenEmbedding.injective
  have hpsurj : Surjective p := by
    refine ⟨fun x => ?_⟩
    have hx : Ub.ι x ∈ Ub := x.2
    obtain ⟨z, hz⟩ := hcov (Ub.ι x) ((hUb _).mp hx)
    refine ⟨z, hιinj ?_⟩
    rw [← Scheme.Hom.comp_apply p Ub.ι, hp, hz]
  obtain ⟨Ub0, hUb0, -, hUbc, hUbq, -⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  have hUbeq : Ub = Ub0 := SetLike.ext (fun x => (hUb x).trans (hUb0 x).symm)
  have hUbc' : CompactSpace Ub.toScheme := by rw [hUbeq]; exact hUbc
  have hUbq' : QuasiSeparatedSpace Ub.toScheme := by rw [hUbeq]; exact hUbq
  have hdeckp : ∀ δ : W ⟶ W, δ ≫ w = w → δ.left ≫ p = p := by
    intro δ hδ
    rw [← cancel_mono Ub.ι, Category.assoc, hp]
    exact congrArg (fun f => f.left) hδ
  have hdeckp' : ∀ δ : W ⟶ W, δ ≫ w = w → δ.left ≫ p = 𝟙 W.left ≫ p := by
    intro δ hδ
    rw [Category.id_comp]
    exact hdeckp δ hδ

  have hpw : Limits.pullback.fst p p ≫ w.left = Limits.pullback.snd p p ≫ w.left := by
    rw [← hp]
    exact Limits.pullback.condition_assoc _
  obtain ⟨μ, hμ1, hμ2⟩ : ∃ μ : Limits.pullback p p ⟶ Limits.pullback w.left w.left,
      μ ≫ Limits.pullback.fst w.left w.left = Limits.pullback.fst p p ∧
      μ ≫ Limits.pullback.snd w.left w.left = Limits.pullback.snd p p :=
    ⟨Limits.pullback.lift _ _ hpw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨c, hc⟩ : ∃ c : ↥(Limits.pullback p p) → Multiplicative (AddAut (Fin q → ZMod (ℓ ^ k))),
      ∀ y, c y = (ρ (G (μ y)))⁻¹ := ⟨fun y => (ρ (G (μ y)))⁻¹, fun _ => rfl⟩
  have hw' : ∀ (Z : Scheme.{u}) (a b : Z ⟶ W.left), a ≫ p = b ≫ p → a ≫ w.left = b ≫ w.left := by
    intro Z a b hab
    rw [← hp, ← Category.assoc, hab, Category.assoc]
  have htr : ∀ (Z : Scheme.{u}) (a b : Z ⟶ W.left) (hab : a ≫ p = b ≫ p)
      (hab' : a ≫ w.left = b ≫ w.left) (z : Z),
      c (Limits.pullback.lift a b hab z) = (ρ (G (Limits.pullback.lift a b hab' z)))⁻¹ := by
    intro Z a b hab hab' z
    have e : Limits.pullback.lift a b hab ≫ μ = Limits.pullback.lift a b hab' := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hμ1, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
      · rw [Category.assoc, hμ2, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    rw [hc, ← Scheme.Hom.comp_apply (Limits.pullback.lift a b hab) μ, e]
  have hρG : IsLocallyConstant (fun z => ρ (G z)) := by
    rw [IsLocallyConstant.iff_exists_open]
    intro z₁
    obtain ⟨ε, hε, hεc⟩ := hρ5 (G z₁) (hGa z₁)
    refine ⟨⋂ j : Fin r, {z | ‖G z (Pi.single j 1) - G z₁ (Pi.single j 1)‖ < ε}, ?_, ?_, ?_⟩
    · exact isOpen_iInter_of_finite
        (fun j => isOpen_lt ((hGc j).sub continuous_const).norm continuous_const)
    · refine Set.mem_iInter.mpr (fun j => ?_)
      show ‖G z₁ (Pi.single j 1) - G z₁ (Pi.single j 1)‖ < ε
      rw [sub_self, norm_zero]
      exact hε
    · intro z hz
      have hz' : ∀ j : Fin r, ‖G z (Pi.single j 1) - G z₁ (Pi.single j 1)‖ < ε :=
        fun j => Set.mem_iInter.mp hz j
      exact hεc (G z) (hGa z) hz'
  have hcl : IsLocallyConstant c := by
    rw [show c = fun y => (ρ (G (μ y)))⁻¹ from funext hc]
    exact (hρG.comp_continuous μ.continuous).comp (fun x => x⁻¹)
  have hcoc : ∀ (Z : Scheme.{u}) (a b d : Z ⟶ W.left) (hab : a ≫ p = b ≫ p)
      (hbd : b ≫ p = d ≫ p) (had : a ≫ p = d ≫ p) (z : Z),
      c (Limits.pullback.lift a d had z) =
        c (Limits.pullback.lift a b hab z) * c (Limits.pullback.lift b d hbd z) := by
    intro Z a b d hab hbd had z
    rw [htr Z a d had (hw' Z a d had) z, htr Z a b hab (hw' Z a b hab) z,
      htr Z b d hbd (hw' Z b d hbd) z,
      hGd Z a b d (hw' Z a b hab) (hw' Z b d hbd) (hw' Z a d had) z,
      hρ2 (G (Limits.pullback.lift a b (hw' Z a b hab) z)) (hGa _)
        (G (Limits.pullback.lift b d (hw' Z b d hbd) z)) (hGa _), mul_inv_rev]

  have hs9 : ∀ (δ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) (hδ : δ ≫ w = w),
      wcHonestFrame D ℓ W r θ δ g → ∀ z : W.left,
      c (Limits.pullback.lift δ.left (𝟙 W.left) (hdeckp' δ hδ) z) = ρ g := by
    intro δ g hδ hg z
    rw [htr W.left δ.left (𝟙 W.left) (hdeckp' δ hδ) (hdeckl δ hδ) z]
    have h1 := hρ2 g ⟨δ, hδ, hg⟩ _
      (hGa (Limits.pullback.lift δ.left (𝟙 W.left) (hdeckl δ hδ) z))
    rw [hGe δ g (hdeckl δ hδ) hδ hg z, hρ1] at h1
    exact inv_eq_of_mul_eq_one_right h1.symm
  obtain ⟨E, πE, s, hEfin, hEet, hEsurj, hsp, hMR, hLOC⟩ :=
    wc_fpqc_gtor_descent Ub.toScheme W.left p hUbc' hUbq' hpflat hpqc hpsurj
      (Multiplicative (AddAut (Fin q → ZMod (ℓ ^ k)))) c hcl hcoc
  refine ⟨E, πE, hEfin, hEet, hEsurj, ?_, ?_⟩
  ·
    haveI := hEfin
    haveI := hEet
    intro i V v A _ _ _ e hV y
    refine wc_hmg_punct_galois_split F'' hP D.m D.S D.hS Ub hUb i V v A e hV
      (Limits.pullback πE (Limits.pullback.snd v.left Ub.ι))
      (Limits.pullback.snd πE (Limits.pullback.snd v.left Ub.ι)) inferInstance inferInstance ?_ y
    intro T uT L _ _ eT t ht sY hsY τ hτ
    have hToff : ∀ (z : T.left) (j : Fin D.m), T.hom z ≠ D.S j (IsLocalRing.closedPoint F'') := by
      intro z j
      have h2 : v.left (Limits.pullback.fst v.left Ub.ι (t z)) =
          Ub.ι (Limits.pullback.snd v.left Ub.ι (t z)) := by
        rw [← Scheme.Hom.comp_apply (Limits.pullback.fst v.left Ub.ι) v.left,
          ← Scheme.Hom.comp_apply (Limits.pullback.snd v.left Ub.ι) Ub.ι,
          Limits.pullback.condition]
      have h3 : T.hom z = V.hom (uT.left z) := by
        rw [← Scheme.Hom.comp_apply uT.left V.hom, MorphismProperty.Over.w uT]
      have h4 : uT.left z = Limits.pullback.fst v.left Ub.ι (t z) := by
        rw [← ht, Scheme.Hom.comp_apply]
      have h5 : V.hom (Limits.pullback.fst v.left Ub.ι (t z)) =
          (wcGeomPoint F'' (wcP1Over F'') hP).hom
            (v.left (Limits.pullback.fst v.left Ub.ι (t z))) := by
        rw [← Scheme.Hom.comp_apply v.left (wcGeomPoint F'' (wcP1Over F'') hP).hom,
          MorphismProperty.Over.w v]
      have hy : Ub.ι (Limits.pullback.snd v.left Ub.ι (t z)) ∈ Ub :=
        (Limits.pullback.snd v.left Ub.ι (t z)).2
      rw [h3, h4, h5, h2]
      exact (hUb _).mp hy j
    obtain ⟨cT, hcT⟩ := wc_pencil_PL_lift_to_cover F'' hP D.m D.S W w hcov T L eT hToff (uT ≫ v)
    haveI hTc : ConnectedSpace T.left :=
      Function.Surjective.connectedSpace (Scheme.homeoOfIso eT).symm.surjective
        (Scheme.homeoOfIso eT).symm.continuous
    have hcTp : cT.left ≫ p =
        (sY ≫ Limits.pullback.fst πE (Limits.pullback.snd v.left Ub.ι)) ≫ πE := by
      rw [← cancel_mono Ub.ι]
      simp only [Category.assoc]
      rw [hp, Limits.pullback.condition_assoc,
        ← Limits.pullback.condition (f := v.left) (g := Ub.ι), reassoc_of% hsY, reassoc_of% ht]
      exact congrArg (fun f => f.left) hcT
    obtain ⟨γ, hγ⟩ := hLOC T.left hTc cT.left
      (sY ≫ Limits.pullback.fst πE (Limits.pullback.snd v.left Ub.ι)) hcTp
    have hτc : (τ ≫ cT) ≫ w = cT ≫ w := by
      rw [Category.assoc, hcT, ← Category.assoc, hτ]
    obtain ⟨σ, hσw, hσ⟩ := hgal T cT (τ ≫ cT) hTc hτc.symm
    have hinert : wcHonestIsInertia D hP W w i σ := by
      delta wcHonestIsInertia
      exact ⟨hσw, V, v, A, inferInstance, inferInstance, inferInstance, e, hV, L, inferInstance,
        inferInstance, T, eT, uT, cT, τ, hcT.symm, hτ, hσ⟩
    obtain ⟨gσ, hgσ⟩ := hfrex σ
    have hρσ : ρ gσ = 1 := hρ4 gσ ⟨σ, hσw, hgσ⟩ (hin i σ gσ hinert hgσ)
    have hσs : σ.left ≫ s γ = 𝟙 W.left ≫ s γ := by
      apply (hMR W.left σ.left (𝟙 W.left) (hdeckp' σ hσw) γ γ).mpr
      intro z
      rw [hs9 σ gσ hσw hgσ z, hρσ, mul_one]
    have htt : τ.left ≫ t = t := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, ht]
        exact congrArg (fun f => f.left) hτ
      · rw [← cancel_mono Ub.ι]
        simp only [Category.assoc]
        rw [← Limits.pullback.condition (f := v.left) (g := Ub.ι), reassoc_of% ht,
          ← Category.assoc]
        exact congrArg (fun f => f.left ≫ v.left) hτ
    have e1 : τ.left ≫ cT.left = cT.left ≫ σ.left := congrArg (fun f => f.left) hσ
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hγ, ← Category.assoc, e1, Category.assoc, hσs, Category.id_comp]
    · rw [Category.assoc, hsY, htt]
  ·
    intro sec hsec δ g hδ hg x hx hxi
    obtain ⟨γ₀, hγ₀⟩ := hLOC W.left hconn (𝟙 W.left) (p ≫ sec)
      (by rw [Category.assoc, hsec, Category.comp_id, Category.id_comp])
    have hγ₀' : s γ₀ = p ≫ sec := by rw [hγ₀, Category.id_comp]
    have h1 : δ.left ≫ s γ₀ = 𝟙 W.left ≫ s γ₀ := by
      rw [hγ₀', ← Category.assoc, hdeckp δ hδ, Category.id_comp]
    have h2 := (hMR W.left δ.left (𝟙 W.left) (hdeckp' δ hδ) γ₀ γ₀).mp h1 z₀
    rw [hs9 δ g hδ hg z₀] at h2
    have h3 : ρ g = 1 := mul_left_cancel (h2.symm.trans (mul_one γ₀).symm)
    exact (hρ3 g ⟨δ, hδ, hg⟩).mp h3 x hx hxi

theorem wc_hfe_fromNormalization_finite (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S' : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS' : ∀ i, S' i ≫ (wcP1Over F'').hom = 𝟙 _)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
      ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S' i (IsLocalRing.closedPoint F''))
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) (hfin : IsFinite πE) (het : Etale πE)
    [QuasiCompact (πE ≫ Ub.ι)] [QuasiSeparated (πE ≫ Ub.ι)] :
    IsFinite (πE ≫ Ub.ι).fromNormalization :=
by
  classical
  haveI := hfin
  haveI := het
  apply wc_fnf_fromNormalization_finite_of_local (πE ≫ Ub.ι)
  intro y

  obtain ⟨e, he, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') 1
  let e' : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F'')) := e
  haveI : IsIso e' := he
  have hY : (⨆ j : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        (MvPolynomial.X j)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩
  have hx : e' y ∈ (⨆ j : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        (MvPolynomial.X j)) := by
    rw [hY]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨χ, -⟩ := wc_projK_one_affine_chart (AlgebraicClosure F'') a
  set U : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens := e' ⁻¹ᵁ (Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        (MvPolynomial.X a)) with hUdef
  have hyU : y ∈ U := ha
  let φ : U.toScheme ≅ Spec (.of (Polynomial (AlgebraicClosure F''))) :=
    Scheme.Hom.preimageIso e' _ ≪≫ χ

  have hU : IsAffineOpen U := by
    haveI : IsAffine U.toScheme := IsAffine.of_isIso φ.hom
    exact this
  let eR : Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U) ≃+* Polynomial (AlgebraicClosure F'') :=
    (U.topIso.symm ≪≫ (Scheme.Γ.mapIso φ.op).symm ≪≫
      Scheme.ΓSpecIso (.of (Polynomial (AlgebraicClosure F'')))).commRingCatIsoToRingEquiv
  haveI : IsDomain Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U) :=
    MulEquiv.isDomain _ eR.toMulEquiv
  haveI : IsPrincipalIdealRing Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U) :=
    IsPrincipalIdealRing.of_surjective eR.symm eR.symm.surjective

  have hclosed : IsClosed ((hU.fromSpec ⁻¹ᵁ Ub :
      Set (Spec Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))))ᶜ :=
    (hU.fromSpec ⁻¹ᵁ Ub).isOpen.isClosed_compl
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal
    (R := Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))
    ((hU.fromSpec ⁻¹ᵁ Ub : Set (Spec Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))))ᶜ).mp
    hclosed
  set g := Submodule.IsPrincipal.generator I with hgdef
  have hT : hU.fromSpec ⁻¹ᵁ Ub = PrimeSpectrum.basicOpen g := by
    apply TopologicalSpace.Opens.ext
    have h1 : (PrimeSpectrum.basicOpen g :
        Set (PrimeSpectrum Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))) =
        (PrimeSpectrum.zeroLocus {g})ᶜ := PrimeSpectrum.basicOpen_eq_zeroLocus_compl g
    have h2 : PrimeSpectrum.zeroLocus
        ({g} : Set Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)) =
        PrimeSpectrum.zeroLocus (I : Set Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)) := by
      rw [← PrimeSpectrum.zeroLocus_span, hgdef, Ideal.span_singleton_generator]
    have key : ((hU.fromSpec ⁻¹ᵁ Ub : Set (Spec Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))) :
        Set (PrimeSpectrum Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))) =
        (PrimeSpectrum.basicOpen g :
          Set (PrimeSpectrum Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U))) := by
      rw [h1, h2]
      exact (compl_compl _).symm.trans (congrArg (fun s => sᶜ) hI)
    exact key
  have hUUb : U ⊓ Ub = (wcGeomPoint F'' (wcP1Over F'') hP).left.basicOpen g := by
    have h1 := hU.fromSpec_image_basicOpen g
    rw [← hT, Scheme.Hom.image_preimage_eq_opensRange_inf, hU.opensRange_fromSpec] at h1
    exact h1

  set V' : Ub.toScheme.Opens := Ub.ι ⁻¹ᵁ U with hV'def
  have hV : Ub.ι ''ᵁ V' = (wcGeomPoint F'' (wcP1Over F'') hP).left.basicOpen g := by
    rw [hV'def, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      inf_comm, hUUb]
  have hle : Ub.ι ''ᵁ V' ≤ U := by
    rw [hV]; exact Scheme.basicOpen_le _ _
  have hV'aff : IsAffineOpen V' :=
    (Ub.ι.isAffineOpen_iff_of_isOpenImmersion).mp (hV ▸ hU.basicOpen g)
  have hpre : IsAffineOpen (πE ⁻¹ᵁ V') := hV'aff.preimage πE
  letI algRT : Algebra Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)
      Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, Ub.ι ''ᵁ V') :=
    ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.map (homOfLE hle).op).hom.toAlgebra
  haveI hloc : IsLocalization.Away g Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, Ub.ι ''ᵁ V') :=
    hU.isLocalization_of_eq_basicOpen g (homOfLE hle) hV
  letI algTB : Algebra Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, Ub.ι ''ᵁ V')
      Γ(E, (πE ≫ Ub.ι) ⁻¹ᵁ U) := (πE.app V').hom.toAlgebra
  letI algRB : Algebra Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)
      Γ(E, (πE ≫ Ub.ι) ⁻¹ᵁ U) := ((πE ≫ Ub.ι).app U).hom.toAlgebra
  haveI : IsScalarTower Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)
      Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, Ub.ι ''ᵁ V') Γ(E, (πE ≫ Ub.ι) ⁻¹ᵁ U) := by
    apply IsScalarTower.of_algebraMap_eq'
    show ((πE ≫ Ub.ι).app U).hom = (πE.app V').hom.comp
      ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.map (homOfLE hle).op).hom
    rw [Scheme.Hom.comp_app, Scheme.Opens.ι_app]
    rfl
  have hEt0 := HasRingHomProperty.appLE (P := @Etale) πE het ⟨V', hV'aff⟩ ⟨πE ⁻¹ᵁ V', hpre⟩ le_rfl
  rw [← Scheme.Hom.app_eq_appLE] at hEt0
  haveI : Algebra.Etale Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, Ub.ι ''ᵁ V')
      Γ(E, (πE ≫ Ub.ι) ⁻¹ᵁ U) := hEt0
  refine ⟨U, hU, hyU, ?_⟩
  exact wc_fnf_integralClosure_finite_of_etale_localization
    Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)
    Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, Ub.ι ''ᵁ V') (Submonoid.powers g)
    Γ(E, (πE ≫ Ub.ι) ⁻¹ᵁ U)
    (fun A _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field
      Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)
      (FractionRing Γ((wcGeomPoint F'' (wcP1Over F'') hP).left, U)) A)

theorem wc_hfe_stalk_data (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S' : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS' : ∀ i, S' i ≫ (wcP1Over F'').hom = 𝟙 _)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
      ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S' i (IsLocalRing.closedPoint F''))
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) (hfin : IsFinite πE) (het : Etale πE)
    (x : (wcGeomPoint F'' (wcP1Over F'') hP).left) (hx : x ∉ Ub) :
    letI : Algebra ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)
        Γ(Limits.pullback (πE ≫ Ub.ι) ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk x), ⊤) :=
      ((Scheme.ΓSpecIso ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)).inv ≫
        (Limits.pullback.snd (πE ≫ Ub.ι)
          ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk x)).appTop).hom.toAlgebra
    ∃ (_ : IsDomain ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)),
      IsDiscreteValuationRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x) ∧
      PerfectField (IsLocalRing.ResidueField
        ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)) ∧
      ∃ (_ : Algebra (FractionRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ Ub.ι)
            ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk x), ⊤)),
        IsScalarTower ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)
          (FractionRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ Ub.ι)
            ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk x), ⊤) ∧
        Module.Finite (FractionRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ Ub.ι)
            ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk x), ⊤) ∧
        Algebra.Etale (FractionRing ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ Ub.ι)
            ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk x), ⊤) :=
by
  classical

  have s2 : ∀ (X : Scheme.{u}) (U : X.Opens) (R : Type u) [CommRing R] [IsDomain R]
      [IsPrincipalIdealRing R], ¬ IsField R → ∀ (φ : U.toScheme ≅ Spec (.of R)) (x : X), x ∈ U →
      IsClosed ({x} : Set X) → ∃ (_ : IsDomain (X.presheaf.stalk x)),
        IsDiscreteValuationRing (X.presheaf.stalk x) := by
    intro X U R _ _ _ hR φ x hx hcl
    have hU : IsAffineOpen U := by
      haveI : IsAffine U.toScheme := IsAffine.of_isIso φ.hom
      exact this
    let eA : Γ(X, U) ≅ CommRingCat.of R :=
      U.topIso.symm ≪≫ (Scheme.Γ.mapIso φ.op).symm ≪≫ Scheme.ΓSpecIso (.of R)
    let e' : Γ(X, U) ≃+* R := eA.commRingCatIsoToRingEquiv
    haveI : IsDomain Γ(X, U) := MulEquiv.isDomain R e'.toMulEquiv
    haveI : IsPrincipalIdealRing Γ(X, U) :=
      IsPrincipalIdealRing.of_surjective e'.symm e'.symm.surjective
    have hA : ¬ IsField Γ(X, U) := fun h => hR (MulEquiv.isField h e'.symm.toMulEquiv)
    haveI : IsDedekindDomain Γ(X, U) := IsPrincipalIdealRing.isDedekindDomain _
    have hmax := hU.primeIdealOf_isMaximal_of_isClosed ⟨x, hx⟩ hcl
    have hP0 : (hU.primeIdealOf ⟨x, hx⟩).asIdeal ≠ ⊥ := by
      intro h
      rw [h] at hmax
      exact hA (Ring.isField_iff_maximal_bot.mpr hmax)
    letI : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (U := U) ⟨x, hx⟩
    haveI := hU.isLocalization_stalk ⟨x, hx⟩
    haveI hdom : IsDomain (X.presheaf.stalk x) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors
        (M := (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl) _
        (Ideal.primeCompl_le_nonZeroDivisors _)
    exact ⟨hdom, IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain Γ(X, U) hP0
      (X.presheaf.stalk x)⟩

  have s5 : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] (ϖ : O),
      Irreducible ϖ → IsLocalization.Away ϖ (FractionRing O) := by
    intro O _ _ _ ϖ hϖ
    haveI h1 : IsLocalization (nonZeroDivisors O) (Localization.Away ϖ) := by
      apply IsLocalization.of_le_of_exists_dvd (Submonoid.powers ϖ) (nonZeroDivisors O)
      · rintro _ ⟨k, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hϖ.ne_zero)
      · intro n hn
        obtain ⟨k, v, hk⟩ :=
          IsDiscreteValuationRing.eq_unit_mul_pow_irreducible (nonZeroDivisors.ne_zero hn) hϖ
        refine ⟨ϖ ^ k, ⟨k, rfl⟩, ?_⟩
        rw [hk]
        exact Units.mul_left_dvd.mpr dvd_rfl
    exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers ϖ)
      (IsLocalization.algEquiv (nonZeroDivisors O) (Localization.Away ϖ) (FractionRing O))

  have s7 : ∀ (R : CommRingCat.{u}) (S : Type u) [CommRing S] [Algebra R S] (Z : Scheme.{u})
      (s : Z ⟶ Spec R) (f : Z ⟶ Spec (.of S)) [IsFinite f] [Etale f],
      f ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = s →
      letI : Algebra R Γ(Z, ⊤) := ((Scheme.ΓSpecIso R).inv ≫ s.appTop).hom.toAlgebra
      ∃ (_ : Algebra S Γ(Z, ⊤)), IsScalarTower R S Γ(Z, ⊤) ∧ Module.Finite S Γ(Z, ⊤) ∧
        Algebra.Etale S Γ(Z, ⊤) := by
    intro R S _ _ Z s f _ _ hfs
    subst hfs
    letI : Algebra R Γ(Z, ⊤) :=
      ((Scheme.ΓSpecIso R).inv ≫
        (f ≫ Spec.map (CommRingCat.ofHom (algebraMap R S))).appTop).hom.toAlgebra
    haveI : IsAffine Z := isAffine_of_isAffineHom f
    let ψ : CommRingCat.of S ⟶ Γ(Z, ⊤) := (Scheme.ΓSpecIso (.of S)).inv ≫ f.appTop
    letI alg : Algebra S Γ(Z, ⊤) := ψ.hom.toAlgebra
    have hbij : Function.Bijective ((Scheme.ΓSpecIso (.of S)).inv).hom :=
      (Scheme.ΓSpecIso (.of S)).symm.commRingCatIsoToRingEquiv.bijective
    refine ⟨alg, ?_, ?_, ?_⟩
    · apply IsScalarTower.of_algebraMap_eq'
      show ((Scheme.ΓSpecIso R).inv ≫
          (f ≫ Spec.map (CommRingCat.ofHom (algebraMap R S))).appTop).hom =
        ψ.hom.comp (algebraMap R S)
      have hnat : (Scheme.ΓSpecIso R).inv ≫
          (Spec.map (CommRingCat.ofHom (algebraMap R S))).appTop =
          CommRingCat.ofHom (algebraMap R S) ≫ (Scheme.ΓSpecIso (.of S)).inv :=
        (Scheme.ΓSpecIso_inv_naturality _).symm
      rw [Scheme.Hom.comp_appTop, ← Category.assoc, hnat, Category.assoc]
      rfl
    · have h1 : (f.appTop).hom.Finite := ((isFinite_iff f).mp ‹_›).2 ⊤ (isAffineOpen_top _)
      have h2 : ((Scheme.ΓSpecIso (.of S)).inv).hom.Finite :=
        RingHom.Finite.of_surjective _ hbij.2
      have h3 : ψ.hom.Finite := by
        show ((Scheme.ΓSpecIso (.of S)).inv ≫ f.appTop).hom.Finite
        rw [CommRingCat.hom_comp]
        exact h1.comp h2
      exact h3
    · have h1 : RingHom.Etale (f.appTop).hom := HasRingHomProperty.appTop @Etale f ‹_›
      have h2 : RingHom.Etale ((Scheme.ΓSpecIso (.of S)).inv).hom :=
        RingHom.Etale.of_bijective hbij
      have h3 : ψ.hom.Etale := by
        show ((Scheme.ΓSpecIso (.of S)).inv ≫ f.appTop).hom.Etale
        rw [CommRingCat.hom_comp]
        exact RingHom.Etale.stableUnderComposition _ _ h2 h1
      exact h3

  have core : ∀ (X : Scheme.{u}) (W : X.Opens) (E : Scheme.{u}) (πE : E ⟶ W.toScheme)
      [IsFinite πE] [Etale πE] (x : X) [IsDomain (X.presheaf.stalk x)]
      [IsDiscreteValuationRing (X.presheaf.stalk x)], x ∉ W →
      (∀ y : X, y ⤳ x → y ≠ x → y ∈ W) →
      letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (πE ≫ W.ι) (X.fromSpecStalk x), ⊤) :=
        ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
          (Limits.pullback.snd (πE ≫ W.ι) (X.fromSpecStalk x)).appTop).hom.toAlgebra
      ∃ (_ : Algebra (FractionRing (X.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ W.ι) (X.fromSpecStalk x), ⊤)),
        IsScalarTower (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ W.ι) (X.fromSpecStalk x), ⊤) ∧
        Module.Finite (FractionRing (X.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ W.ι) (X.fromSpecStalk x), ⊤) ∧
        Algebra.Etale (FractionRing (X.presheaf.stalk x))
          Γ(Limits.pullback (πE ≫ W.ι) (X.fromSpecStalk x), ⊤) := by
    intro X W E πE _ _ x _ _ hxW hgen
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (X.presheaf.stalk x)
    haveI hAway : IsLocalization.Away ϖ (FractionRing (X.presheaf.stalk x)) := s5 _ ϖ hϖ
    have hmax : IsLocalRing.maximalIdeal (X.presheaf.stalk x) = Ideal.span {ϖ} :=
      hϖ.maximalIdeal_eq
    have hpre : ∀ q : Spec (X.presheaf.stalk x), X.fromSpecStalk x q ∈ W ↔ ϖ ∉ q.asIdeal := by
      intro q
      constructor
      · intro hq hϖq
        have hle : IsLocalRing.maximalIdeal (X.presheaf.stalk x) ≤ q.asIdeal := by
          rw [hmax, Ideal.span_le]
          simpa using hϖq
        have hq' : q = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
          PrimeSpectrum.ext (le_antisymm (IsLocalRing.le_maximalIdeal q.isPrime.ne_top) hle)
        rw [hq', Scheme.fromSpecStalk_closedPoint] at hq
        exact hxW hq
      · intro hϖq
        have hne : q ≠ IsLocalRing.closedPoint (X.presheaf.stalk x) := by
          rintro rfl
          apply hϖq
          show ϖ ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)
          rw [hmax]
          exact Ideal.subset_span rfl
        apply hgen
        · have := (IsLocalRing.specializes_closedPoint q).map (X.fromSpecStalk x).continuous
          rwa [Scheme.fromSpecStalk_closedPoint] at this
        · intro h
          apply hne
          apply (X.fromSpecStalk x).isEmbedding.injective
          rw [h, Scheme.fromSpecStalk_closedPoint]
    haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x))))) :=
      IsOpenImmersion.of_isLocalization ϖ
    have hrange : Set.range (Limits.pullback.snd W.ι (X.fromSpecStalk x)) =
        Set.range (Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x))))) := by
      ext q
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
      have h2 : q ∈ Set.range (Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x))))) ↔
          q ∈ (PrimeSpectrum.basicOpen ϖ : Set (PrimeSpectrum (X.presheaf.stalk x))) := by
        rw [← PrimeSpectrum.localization_away_comap_range (FractionRing (X.presheaf.stalk x)) ϖ]
        exact Iff.rfl
      rw [h2]
      exact hpre q
    obtain ⟨e, he⟩ : ∃ e : Limits.pullback W.ι (X.fromSpecStalk x) ≅
        Spec (.of (FractionRing (X.presheaf.stalk x))),
        e.hom ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x)))) =
          Limits.pullback.snd W.ι (X.fromSpecStalk x) :=
      ⟨IsOpenImmersion.isoOfRangeEq _ _ hrange, IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _⟩
    have hqq : ((Limits.pullbackRightPullbackFstIso W.ι (X.fromSpecStalk x) πE).inv ≫
        Limits.pullback.snd πE (Limits.pullback.fst W.ι (X.fromSpecStalk x))) ≫
        Limits.pullback.snd W.ι (X.fromSpecStalk x) =
        Limits.pullback.snd (πE ≫ W.ι) (X.fromSpecStalk x) := by
      rw [Category.assoc]
      exact Limits.pullbackRightPullbackFstIso_inv_snd_snd _ _ _
    have hf : (((Limits.pullbackRightPullbackFstIso W.ι (X.fromSpecStalk x) πE).inv ≫
        Limits.pullback.snd πE (Limits.pullback.fst W.ι (X.fromSpecStalk x))) ≫ e.hom) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x)))) =
        Limits.pullback.snd (πE ≫ W.ι) (X.fromSpecStalk x) := by
      rw [Category.assoc, he, hqq]
    exact s7 (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x)) _ _ _ hf

  have charts : ∀ x : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      ∃ U : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens, x ∈ U ∧
        Nonempty (U.toScheme ≅ Spec (.of (Polynomial (AlgebraicClosure F'')))) := by
    intro x
    obtain ⟨e0, he0, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') 1
    let e : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
        @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
          MvPolynomial.gradedAlgebra := e0
    haveI : IsIso e := he0
    have hY : (⨆ j : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : e x ∈ (⨆ j : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨c, -⟩ := wc_projK_one_affine_chart (AlgebraicClosure F'') j
    refine ⟨e ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra (MvPolynomial.X j)), (Scheme.Hom.mem_preimage e).mpr hj,
      ⟨Scheme.Hom.preimageIso e _ ≪≫ c⟩⟩

  haveI hpr : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  have hlft : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (P : Scheme.{u})
      (p : P ⟶ Spec (.of K)) [IsProper p],
      LocallyOfFiniteType (Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap K L)))) := by
    intro K L _ _ _ P p _
    infer_instance
  haveI hLFT := hlft F'' (AlgebraicClosure F'') _ (wcP1Over F'').hom
  have s3 : ∀ y : (wcGeomPoint F'' (wcP1Over F'') hP).left, y ∉ Ub →
      IsClosed ({y} : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) ∧
      IsAlgClosed (IsLocalRing.ResidueField
        ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk y)) := by
    intro y hy
    have hex : ∃ i, (wcGeomPoint F'' (wcP1Over F'') hP).hom y =
        S' i (IsLocalRing.closedPoint F'') := by
      by_contra h
      push_neg at h
      exact hy ((hUb y).mpr h)
    obtain ⟨i, hi⟩ := hex
    haveI : IsClosedImmersion (S' i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (S' i) (hS' i)
    have hrange : Set.range (S' i) = {S' i (IsLocalRing.closedPoint F'')} := by
      ext z
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        rfl
      · intro hz
        rw [Set.mem_singleton_iff] at hz
        exact ⟨_, hz.symm⟩
    have hcl : IsClosed ({S' i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
      rw [← hrange]
      exact (S' i).isClosedEmbedding.isClosed_range
    obtain ⟨xb, -, hxb, -⟩ := wc_pmod_geom_point_local_data F'' (wcP1Over F'') hpr (S' i) (hS' i)
      ⟨{S' i (IsLocalRing.closedPoint F'')}ᶜ, hcl.isOpen_compl⟩ rfl hP
    have hyx : y = xb := by
      have hmem : y ∈ (wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹'
          {S' i (IsLocalRing.closedPoint F'')} := hi
      rw [hxb] at hmem
      exact hmem
    have hyset : ({y} : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) =
        (wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹' {S' i (IsLocalRing.closedPoint F'')} := by
      rw [hxb, hyx]
    have hycl : IsClosed ({y} : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) := by
      rw [hyset]
      exact hcl.preimage (wcGeomPoint F'' (wcP1Over F'') hP).hom.continuous
    refine ⟨hycl, ?_⟩
    exact @wc_lfi_closed_point_residue_algClosed (AlgebraicClosure F'') _ _
      (wcGeomPoint F'' (wcP1Over F'') hP).left
      (Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hLFT y hycl

  obtain ⟨hxc, hxac⟩ := s3 x hx
  obtain ⟨U, hxU, ⟨φ⟩⟩ := charts x
  obtain ⟨hdom, hdvr⟩ := s2 _ U _ (Polynomial.not_isField _) φ x hxU hxc
  haveI := hdom
  haveI := hdvr
  haveI := hxac
  haveI := hfin
  haveI := het
  have hgen : ∀ y : (wcGeomPoint F'' (wcP1Over F'') hP).left, y ⤳ x → y ≠ x → y ∈ Ub := by
    intro y hyx hne
    by_contra hyU
    have hcly := (s3 y hyU).1
    have hmem : x ∈ closure ({y} : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) :=
      specializes_iff_mem_closure.mp hyx
    rw [hcly.closure_eq, Set.mem_singleton_iff] at hmem
    exact hne hmem.symm
  obtain ⟨alg, htow, hfinD, hetD⟩ := core _ Ub E πE x hx hgen
  exact ⟨hdom, hdvr, IsAlgClosed.perfectField _, alg, htow, hfinD, hetD⟩

theorem wc_hss_henselization_is_dvr : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] (H : Type u) [CommRing H] [IsLocalRing H] [IsNoetherianRing H] (ι : O →+* H) [IsLocalHom ι], (∀ x : H, ∃ y : O, x - ι y ∈ IsLocalRing.maximalIdeal H) → Ideal.map ι (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal H → @Algebra.WeaklyEtale O H _ _ ι.toAlgebra → ∃ (_ : IsDomain H), IsDiscreteValuationRing H ∧ Function.Injective ι ∧ (∀ ϖ : O, Irreducible ϖ → Irreducible (ι ϖ)) ∧ Nonempty (IsLocalRing.ResidueField O ≃+* IsLocalRing.ResidueField H) :=
by
  intro O _ _ _ H _ _ _ ι _ hres hmax hWE
  letI : Algebra O H := ι.toAlgebra
  haveI : Module.Flat O H := hWE.flat
  have hsmul : ∀ (a : O) (h : H), a • h = ι a * h := fun a h => by
    rw [Algebra.smul_def]; rfl

  have s1 : ∀ a : O, a ≠ 0 → ∀ h : H, ι a * h = 0 → h = 0 := by
    intro a ha h hh
    have hreg : IsSMulRegular H a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha)
    apply hreg
    show a • h = a • (0 : H)
    rw [hsmul, hh, smul_zero]

  have s2 : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    exact one_ne_zero (s1 a hne 1 (by rw [ha, zero_mul]))

  have s3 : ∀ ϖ : O, Irreducible ϖ →
      IsLocalRing.maximalIdeal H = Ideal.span {ι ϖ} ∧ ι ϖ ≠ 0 := by
    intro ϖ hϖ
    refine ⟨?_, ?_⟩
    · rw [← hmax, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
    · intro h0
      exact hϖ.ne_zero (s2 (by rw [h0, map_zero]))
  obtain ⟨ϖ₀, hϖ₀⟩ := IsDiscreteValuationRing.exists_irreducible O
  obtain ⟨hm0, hπ0⟩ := s3 ϖ₀ hϖ₀
  set π := ι ϖ₀ with hπdef
  have hreg : ∀ h : H, π * h = 0 → h = 0 := s1 ϖ₀ hϖ₀.ne_zero
  have hregn : ∀ n : ℕ, ∀ h : H, π ^ n * h = 0 → h = 0 := by
    intro n
    induction n with
    | zero => intro h hh; simpa using hh
    | succ n ih =>
      intro h hh
      apply hreg
      apply ih
      rw [← mul_assoc, ← pow_succ]
      exact hh
  have hpow : ∀ n : ℕ, IsLocalRing.maximalIdeal H ^ n = Ideal.span {π ^ n} := by
    intro n; rw [hm0, Ideal.span_singleton_pow]

  have hfact : ∀ a : H, a ≠ 0 → ∃ (k : ℕ) (u : H), IsUnit u ∧ a = π ^ k * u := by
    intro a ha
    have hkrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal H)
      (IsLocalRing.maximalIdeal.isMaximal H).ne_top
    have hex : ∃ n, a ∉ Ideal.span {π ^ n} := by
      by_contra hcon
      push_neg at hcon
      apply ha
      have hmem : a ∈ ⨅ i, IsLocalRing.maximalIdeal H ^ i := by
        rw [Ideal.mem_iInf]; intro i; rw [hpow]; exact hcon i
      rw [hkrull] at hmem
      exact (Submodule.mem_bot H).mp hmem
    classical
    obtain ⟨N, hN, hmin⟩ : ∃ N, a ∉ Ideal.span {π ^ N} ∧ ∀ m < N, a ∈ Ideal.span {π ^ m} :=
      ⟨Nat.find hex, Nat.find_spec hex, fun m hm => by simpa using Nat.find_min hex hm⟩
    have hN0 : N ≠ 0 := by
      intro h0
      apply hN
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨k, rfl⟩ : ∃ k, N = k + 1 := ⟨N - 1, by omega⟩
    have hk : a ∈ Ideal.span {π ^ k} := hmin k (by omega)
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hk
    refine ⟨k, u, ?_, by rw [← hu, mul_comm]⟩
    by_contra hnu
    have hum : u ∈ IsLocalRing.maximalIdeal H := (IsLocalRing.mem_maximalIdeal u).mpr hnu
    rw [hm0] at hum
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hum
    apply hN
    rw [Ideal.mem_span_singleton']
    refine ⟨w, ?_⟩
    rw [← hu, ← hw, pow_succ]
    ring

  haveI hnzd : NoZeroDivisors H := by
    constructor
    intro a b hab
    by_contra hne
    push_neg at hne
    obtain ⟨k, u, hu, hau⟩ := hfact a hne.1
    obtain ⟨l, v, hv, hbv⟩ := hfact b hne.2
    have h1 : π ^ (k + l) * (u * v) = 0 := by rw [← hab, hau, hbv]; ring
    exact (hu.mul hv).ne_zero (hregn _ _ h1)
  haveI hdom : IsDomain H := NoZeroDivisors.to_isDomain H
  have hirr : ∀ x : H, x ≠ 0 → IsLocalRing.maximalIdeal H = Ideal.span {x} → Irreducible x :=
    fun x hx h => IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal x hx h

  have hdvr : IsDiscreteValuationRing H := by
    apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    refine ⟨π, hirr π hπ0 hm0, ?_⟩
    intro x hx
    obtain ⟨k, u, hu, hxu⟩ := hfact x hx
    exact ⟨k, hu.unit, by rw [hxu, IsUnit.unit_spec]⟩
  refine ⟨hdom, hdvr, s2, fun ϖ hϖ => hirr _ (s3 ϖ hϖ).2 (s3 ϖ hϖ).1, ?_⟩

  let f := IsLocalRing.ResidueField.map ι
  have hinj : Function.Injective f := f.injective
  have hsurj : Function.Surjective f := by
    intro z
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective z
    obtain ⟨y, hy⟩ := hres x
    refine ⟨IsLocalRing.residue O y, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff, ← neg_sub]
    exact (IsLocalRing.maximalIdeal H).neg_mem hy
  exact ⟨RingEquiv.ofBijective f ⟨hinj, hsurj⟩⟩

theorem wc_hss_split_of_rational_primes : ∀ (F A : Type u) [Field F] [CommRing A] [Algebra F A] [Module.Finite F A] [Algebra.Etale F A], (∀ P : Ideal A, P.IsPrime → ∃ ψ : A →ₐ[F] F, RingHom.ker ψ = P) → ∃ (n : ℕ) (ψ : Fin n → (A →ₐ[F] F)), Function.Bijective (fun z : A => fun i => ψ i z) :=
by
  classical
  intro F A _ _ _ _ _ hP
  haveI : IsArtinianRing A := IsArtinianRing.of_finite F A
  haveI : IsReduced A := Algebra.FormallyUnramified.isReduced_of_field F A
  set e₀ := IsArtinianRing.equivPi A with he₀
  set σ : Fin (Nat.card (MaximalSpectrum A)) ≃ MaximalSpectrum A :=
    (Finite.equivFin (MaximalSpectrum A)).symm with hσ
  choose χ hχ using fun m : MaximalSpectrum A => hP m.asIdeal m.isMaximal.isPrime
  have hK : ∀ (m : MaximalSpectrum A) (a : A), χ m a = 0 ↔ a ∈ m.asIdeal := by
    intro m a
    rw [← hχ m, RingHom.mem_ker]
  have hS : ∀ (m : MaximalSpectrum A) (c : F), χ m (algebraMap F A c) = c := by
    intro m c
    rw [AlgHom.commutes]
    rfl
  refine ⟨Nat.card (MaximalSpectrum A), fun i => χ (σ i), ?_, ?_⟩
  · intro z w h
    apply e₀.injective
    funext m
    rw [IsArtinianRing.equivPi_apply, IsArtinianRing.equivPi_apply, Ideal.Quotient.eq]
    rw [← hK, map_sub, sub_eq_zero]
    have := congrFun h (σ.symm m)
    simp only [Equiv.apply_symm_apply] at this
    exact this
  · intro v
    let t : (I : MaximalSpectrum A) → A ⧸ I.asIdeal :=
      fun m => Ideal.Quotient.mk m.asIdeal (algebraMap F A (v (σ.symm m)))
    refine ⟨e₀.symm t, ?_⟩
    funext i
    have h1 : e₀ (e₀.symm t) (σ i) = t (σ i) := by rw [AlgEquiv.apply_symm_apply]
    rw [IsArtinianRing.equivPi_apply] at h1
    simp only [t, Equiv.symm_apply_apply] at h1
    rw [Ideal.Quotient.eq, ← hK, map_sub, sub_eq_zero, hS] at h1
    exact h1

theorem wc_hss_missing_point_data : ∀ (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S' : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (hS' : ∀ i, S' i ≫ (wcP1Over F'').hom = 𝟙 _) (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens) (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔ ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S' i (IsLocalRing.closedPoint F'')) (x : (wcGeomPoint F'' (wcP1Over F'') hP).left), x ∉ Ub → IsSepClosed (IsLocalRing.ResidueField ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk x)) ∧ (∃ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom x = S' i (IsLocalRing.closedPoint F'')) ∧ ∀ y : (wcGeomPoint F'' (wcP1Over F'') hP).left, y ⤳ x → y ≠ x → y ∈ Ub :=
by
  intro F'' _ _ hP m S' hS' Ub hUb x hx
  have hcl : ∀ j : Fin m,
      IsClosed ({S' j (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
    intro j
    haveI : IsClosedImmersion (S' j) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (S' j) (hS' j)
    have hr : Set.range (S' j) = {S' j (IsLocalRing.closedPoint F'')} := by
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        rw [Subsingleton.elim w (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← hr]
    exact (S' j).isClosedEmbedding.isClosed_range
  have key : ∀ j : Fin m, ∃ xb : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹' {S' j (IsLocalRing.closedPoint F'')} = {xb} ∧
      IsSepClosed (IsLocalRing.ResidueField
        ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk xb)) := by
    intro j
    obtain ⟨xb, -, hfib, -, -, hsep, -⟩ := wc_pmod_geom_point_local_data F'' (wcP1Over F'')
      (wc_proj_space_isProper F'' 1) (S' j) (hS' j) ⟨_, (hcl j).isOpen_compl⟩ rfl hP
    exact ⟨xb, hfib, hsep⟩
  have hB : ∃ i : Fin m,
      (wcGeomPoint F'' (wcP1Over F'') hP).hom x = S' i (IsLocalRing.closedPoint F'') := by
    by_contra h
    push_neg at h
    exact hx ((hUb x).mpr h)
  obtain ⟨i, hi⟩ := hB
  refine ⟨?_, ⟨i, hi⟩, ?_⟩
  · obtain ⟨xb, hfib, hsep⟩ := key i
    have hx' : x ∈ (wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹'
        {S' i (IsLocalRing.closedPoint F'')} := hi
    rw [hfib, Set.mem_singleton_iff] at hx'
    subst hx'
    exact hsep
  · intro y hyx hne
    rw [hUb y]
    intro j hj
    obtain ⟨xb, hfib, -⟩ := key j
    have hclf : IsClosed ((wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹'
        {S' j (IsLocalRing.closedPoint F'')}) :=
      (hcl j).preimage (wcGeomPoint F'' (wcP1Over F'') hP).hom.continuous
    have hy : y ∈ (wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹'
        {S' j (IsLocalRing.closedPoint F'')} := hj
    have hxm := hyx.mem_closed hclf hy
    rw [hfib, Set.mem_singleton_iff] at hy hxm
    exact hne (hy.trans hxm.symm)

theorem wc_hss_punctured_spec_iso : ∀ (X : Scheme.{u}) (x : X) (U : X.Opens), x ∉ U → (∀ y : X, y ⤳ x → y ≠ x → y ∈ U) → ∀ [IsDomain (X.presheaf.stalk x)] [IsDiscreteValuationRing (X.presheaf.stalk x)] (H : Type u) [CommRing H] [IsDomain H] [IsDiscreteValuationRing H] (g : X.presheaf.stalk x →+* H), Function.Injective g → (∀ ϖ, Irreducible ϖ → Irreducible (g ϖ)) → ∃ e : Limits.pullback (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι ≅ Spec (.of (FractionRing H)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap H (FractionRing H))) = Limits.pullback.fst _ _ :=
by
  intro X x U hxU hgen _ _ H _ _ _ g hinj hirr

  have hloc : IsLocalHom g := by
    constructor
    intro c hc
    by_contra hcu
    by_cases hc0 : c = 0
    · subst hc0
      rw [map_zero] at hc
      exact not_isUnit_zero hc
    · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (X.presheaf.stalk x)
      obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc0 hϖ
      rcases Nat.eq_zero_or_pos n with hn | hn
      · apply hcu
        rw [hu, hn, pow_zero, mul_one]
        exact u.isUnit
      · rw [hu, map_mul, map_pow] at hc
        have h1 : IsUnit ((g ϖ) ^ n) := isUnit_of_mul_isUnit_right hc
        have h2 : IsUnit (g ϖ) := (isUnit_pow_iff hn.ne').mp h1
        exact (hirr ϖ hϖ).not_isUnit h2

  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible H
  have hinjH := IsFractionRing.injective H (FractionRing H)
  have hπ0 : algebraMap H (FractionRing H) π ≠ 0 := by
    intro h
    exact hπ.ne_zero (hinjH (h.trans (map_zero _).symm))
  have hAway : IsLocalization.Away π (FractionRing H) := by
    refine IsLocalization.Away.mk π (Ne.isUnit hπ0) ?_ ?_
    · intro s
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := H) s
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hπ
      refine ⟨n, a * ↑u⁻¹, ?_⟩
      have huv : algebraMap H (FractionRing H) (↑u : H) * algebraMap H (FractionRing H) (↑u⁻¹ : H) = 1 := by
        rw [← map_mul, Units.mul_inv, map_one]
      have hU0 : algebraMap H (FractionRing H) (↑u : H) ≠ 0 := left_ne_zero_of_mul_eq_one huv
      have hV : algebraMap H (FractionRing H) (↑u⁻¹ : H) = (algebraMap H (FractionRing H) (↑u : H))⁻¹ :=
        eq_inv_of_mul_eq_one_right huv
      rw [hu, map_mul, map_mul, map_pow, hV]
      field_simp
    · intro a b h
      exact ⟨0, by rw [hinjH h]⟩
  have hOI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap H (FractionRing H)))) :=
    IsOpenImmersion.of_isLocalization π
  have hasI : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
      (q : Spec (CommRingCat.of S)),
      ((Spec.map (CommRingCat.ofHom f)) q).asIdeal = Ideal.comap f q.asIdeal := by
    intro R S _ _ f q
    rw [Spec.map_apply]
    rfl
  have hext : ∀ {R : CommRingCat.{u}} (p q : Spec R), p.asIdeal = q.asIdeal → p = q :=
    fun p q h => PrimeSpectrum.ext h

  have hR2 : Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap H (FractionRing H)))) =
      {p : ↥(Spec (CommRingCat.of H)) | p.asIdeal = ⊥} := by
    ext p
    simp only [Set.mem_range, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨q, rfl⟩
      refine (hasI _ q).trans ?_
      have hq : q.asIdeal = ⊥ := @Ideal.eq_bot_of_prime _ _ q.asIdeal q.isPrime
      rw [hq]
      exact Ideal.comap_bot_of_injective _ hinjH
    · intro hp
      refine ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (FractionRing H)), ?_⟩
      apply hext
      refine (hasI _ _).trans ?_
      rw [hp]
      exact Ideal.comap_bot_of_injective _ hinjH

  have hR4 : ⇑(Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) ⁻¹' (U : Set X) =
      {p : ↥(Spec (CommRingCat.of H)) | p.asIdeal = ⊥} := by
    ext p
    simp only [Set.mem_preimage, Set.mem_ofPred_eq, Scheme.Hom.comp_apply]
    by_cases hp : p.asIdeal = ⊥
    · simp only [hp, iff_true]
      have hq₀b : ((Spec.map (CommRingCat.ofHom g)) p).asIdeal = ⊥ :=
        (hasI g p).trans (by rw [hp]; exact Ideal.comap_bot_of_injective _ hinj)
      apply hgen
      · have hmem : X.fromSpecStalk x ((Spec.map (CommRingCat.ofHom g)) p) ∈
            Set.range (X.fromSpecStalk x) := ⟨_, rfl⟩
        rw [Scheme.range_fromSpecStalk] at hmem
        exact hmem
      · intro hyx
        have hq := (Scheme.Hom.isEmbedding (X.fromSpecStalk x)).injective
          (hyx.trans (Scheme.fromSpecStalk_closedPoint (x := x)).symm)
        have h2 : ((Spec.map (CommRingCat.ofHom g)) p).asIdeal =
            IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
          congrArg (fun q : PrimeSpectrum (X.presheaf.stalk x) => q.asIdeal) hq
        exact IsDiscreteValuationRing.not_a_field (X.presheaf.stalk x) (h2.symm.trans hq₀b)
    · simp only [hp, iff_false]
      have hmax : p.asIdeal.IsMaximal := Ideal.IsPrime.isMaximal p.isPrime hp
      have hpm : p.asIdeal = IsLocalRing.maximalIdeal H := IsLocalRing.eq_maximalIdeal hmax
      have h1 : Spec.map (CommRingCat.ofHom g) p = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
        hext _ _ ((hasI g p).trans (by
          rw [hpm]
          exact congrArg PrimeSpectrum.asIdeal (IsLocalRing.comap_closedPoint g)))
      rw [h1, Scheme.fromSpecStalk_closedPoint]
      exact hxU

  have hR : Set.range ⇑(Limits.pullback.fst (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) =
      Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap H (FractionRing H)))) := by
    rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι, hR4, hR2]
  exact ⟨IsOpenImmersion.isoOfRangeEq _ _ hR, IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hR⟩

theorem wc_hss_fibre_tensor_iso : ∀ (X : Scheme.{u}) (x : X) (U : X.Opens) (E : Scheme.{u}) (πE : E ⟶ U.toScheme), IsAffine (Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x)) → ∀ [IsDomain (X.presheaf.stalk x)] [IsDiscreteValuationRing (X.presheaf.stalk x)] (H : Type u) [CommRing H] [IsDomain H] (g : X.presheaf.stalk x →+* H) (κ : FractionRing (X.presheaf.stalk x) →+* FractionRing H), (∀ a, κ (algebraMap (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x)) a) = algebraMap H (FractionRing H) (g a)) → ∀ (e₁ : Limits.pullback (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι ≅ Spec (.of (FractionRing H))), e₁.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap H (FractionRing H))) = Limits.pullback.fst _ _ → letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) := ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫ (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x)).appTop).hom.toAlgebra; letI : Algebra (FractionRing (X.presheaf.stalk x)) (FractionRing H) := κ.toAlgebra; ∀ (_ : Algebra (FractionRing (X.presheaf.stalk x)) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤)), IsScalarTower (X.presheaf.stalk x) (FractionRing (X.presheaf.stalk x)) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) → ∃ eQ : Limits.pullback πE (Limits.pullback.snd (Spec.map (CommRingCat.ofHom g) ≫ X.fromSpecStalk x) U.ι) ≅ Spec (.of (TensorProduct (FractionRing (X.presheaf.stalk x)) (FractionRing H) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))), eQ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (FractionRing H) (TensorProduct (FractionRing (X.presheaf.stalk x)) (FractionRing H) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤)))) = Limits.pullback.snd _ _ ≫ e₁.hom :=
by
  intro X x U E πE hZ _ _ H _ _ g κ hκ e₁ he₁ algK htow
  letI algO : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
      (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x)).appTop).hom.toAlgebra
  letI algKF : Algebra (FractionRing (X.presheaf.stalk x)) (FractionRing H) := κ.toAlgebra
  haveI := hZ

  have hring : (algebraMap H (FractionRing H)).comp g =
