  have hsub : ∀ q, 1 ≤ q → Subsingleton (wcEtZModExt (Spec (.of (wcQuadModelRing
      (IsLocalRing.ResidueField A) 2 0 (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧
        q.val = p.val + 1 then (1 : IsLocalRing.ResidueField A) else 0)))) (ℓ ^ k) q) := by
    intro q hq
