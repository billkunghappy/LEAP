    let γ : Localization.AtPrime Q →+* R := IsLocalization.lift hunit
    have hγ : ∀ e, γ (algebraMap E (Localization.AtPrime Q) e) = β e :=
      fun e => IsLocalization.lift_eq hunit e
    let φ : MvPolynomial (Fin n) A →+* Localization.AtPrime Q :=
      (algebraMap E (Localization.AtPrime Q)).comp
        (((α : (MvPolynomial (Fin n) A ⧸ I) →+* E)).comp (Ideal.Quotient.mk I))
    refine ⟨Localization.AtPrime Q, inferInstance, hTd, hTn, γ,
      fun i => φ (MvPolynomial.X i), ?_, ?_⟩
    · intro i
      show γ (algebraMap E _ (α (Ideal.Quotient.mk I (MvPolynomial.X i)))) = x i
      rw [hγ]
      have h2 : β (α (Ideal.Quotient.mk I (MvPolynomial.X i))) =
          h (Ideal.Quotient.mk I (MvPolynomial.X i)) := by
        rw [← hαβ]; rfl
