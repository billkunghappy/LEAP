    LinearMap.fst ℚ_[ℓ] (Fin r₁ → ℚ_[ℓ]) (Fin r₂ → ℚ_[ℓ]) ∘ₗ E.toLinearMap
  let pr₂ : (Fin (r₁ + r₂) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]) :=
    LinearMap.snd ℚ_[ℓ] (Fin r₁ → ℚ_[ℓ]) (Fin r₂ → ℚ_[ℓ]) ∘ₗ E.toLinearMap
  have e11 : ∀ v, pr₁ (in₁ v) = v := fun v => by
    show (E (E.symm (v, 0))).1 = v
    rw [E.apply_symm_apply]
  have e12 : ∀ v, pr₂ (in₁ v) = 0 := fun v => by
    show (E (E.symm (v, 0))).2 = 0
    rw [E.apply_symm_apply]
  have e21 : ∀ v, pr₁ (in₂ v) = 0 := fun v => by
    show (E (E.symm (0, v))).1 = 0
    rw [E.apply_symm_apply]
  have e22 : ∀ v, pr₂ (in₂ v) = v := fun v => by
    show (E (E.symm (0, v))).2 = v
    rw [E.apply_symm_apply]
  have etot : ∀ x, (in₁ ∘ₗ pr₁) x + (in₂ ∘ₗ pr₂) x = (LinearMap.id : (Fin (r₁ + r₂) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]]
      (Fin (r₁ + r₂) → ℚ_[ℓ])) x := fun x => by
    show E.symm ((E x).1, 0) + E.symm (0, (E x).2) = x
    rw [← map_add, Prod.mk_add_mk, add_zero, zero_add, Prod.mk.eta, E.symm_apply_apply]
  have htot : wcSupLin K ℓ pr₁ ≫ wcSupLin K ℓ in₁ + wcSupLin K ℓ pr₂ ≫ wcSupLin K ℓ in₂ = 𝟙 _ := by
    rw [hLin pr₁ in₁ (in₁ ∘ₗ pr₁) (fun _ => rfl), hLin pr₂ in₂ (in₂ ∘ₗ pr₂) (fun _ => rfl),
      hLinAdd _ _ _ etot, hLinId _ (fun _ => rfl)]
  have k11 : ∀ {Z} (g : (wcSupRho K hP).obj (wcContSheaf (wcP1Over K).left (Fin r₁ → ℚ_[ℓ])) ⟶ Z),
