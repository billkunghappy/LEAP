  letI : Limits.PreservesFiniteLimits Dj.Φ := Dj.presLim
  letI : Limits.PreservesFiniteColimits Dj.Φ := Dj.presColim
  haveI hepi : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
