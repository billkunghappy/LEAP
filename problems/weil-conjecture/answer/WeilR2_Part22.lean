theorem wc_pfam_ltd_f_exists (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (j : Fin D.m)
    (Vy : (wcProjK F'' M').ProEt) (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    (ey : Vy.left ≅ Spec (.of Ay))
    (hy : Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) = lam (D.S j (IsLocalRing.closedPoint F''))) :
    ∃ f : Ay, ∀ z : Vy.left, Vy.hom z ∈ Δ ↔ f ∈ (ey.hom z).asIdeal :=
by
  classical
  obtain ⟨U, hU, φ, hΔ, -⟩ := hH.2.2.2.2.2.2.2.2.2.2.2.2 j
  have hall : ∀ z : Vy.left, Vy.hom z ∈ U := by
    intro z
    have h1 : ey.hom z ⤳ IsLocalRing.closedPoint Ay := IsLocalRing.specializes_closedPoint _
    have h2 := h1.map ey.inv.continuous
    rw [Scheme.hom_inv_apply] at h2
    have h3 := h2.map Vy.hom.continuous
    rw [hy] at h3
    exact h3.mem_open U.isOpen hU
  have hle : (⊤ : Vy.left.Opens) ≤ Vy.hom ⁻¹ᵁ U := fun z _ => hall z
  set ψ := (Vy.hom.appLE U ⊤ hle).hom φ with hψ
  set g := ey.inv.appTop.hom ψ with hg
  refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ay)).hom g, fun z => ?_⟩
  have e4 : Vy.left.basicOpen ψ = ⊤ ⊓ Vy.hom ⁻¹ᵁ (wcProjK F'' M').basicOpen φ :=
    Scheme.basicOpen_appLE _ _ _ _ _
  have e5 : ey.inv ⁻¹ᵁ Vy.left.basicOpen ψ = (Spec (CommRingCat.of Ay)).basicOpen g :=
    Scheme.preimage_basicOpen_top _ _
  have e6 := basicOpen_eq_of_affine' g
  have m1 : z ∈ Vy.left.basicOpen ψ ↔ Vy.hom z ∈ (wcProjK F'' M').basicOpen φ := by
    rw [e4, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage]
    exact ⟨fun h => h.2, fun h => ⟨trivial, h⟩⟩
  have m2 : ey.hom z ∈ (Spec (CommRingCat.of Ay)).basicOpen g ↔ z ∈ Vy.left.basicOpen ψ := by
    rw [← e5, Scheme.Hom.mem_preimage, Scheme.hom_inv_apply]
  have m2' : ey.hom z ∈ (Spec (CommRingCat.of Ay)).basicOpen g ↔
      (Scheme.ΓSpecIso (CommRingCat.of Ay)).hom g ∉ (ey.hom z).asIdeal := by
    rw [e6]
    exact PrimeSpectrum.mem_basicOpen _ _
  have m3 : Vy.hom z ∈ Δ ↔ Vy.hom z ∉ (wcProjK F'' M').basicOpen φ := by
    rw [hΔ _ (hall z), Scheme.mem_basicOpen _ _ _ (hall z), IsLocalRing.mem_maximalIdeal,
      mem_nonunits_iff]
  rw [m3, ← m1, ← m2, m2', not_not]

theorem wc_pfam_ltd_wt_geom_lift (F'' : Type u) [Field F''] [Finite F''] (M' : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Vy : (wcProjK F'' M').ProEt) (Ay : Type u) [CommRing Ay] [HenselianLocalRing Ay]
    [IsSepClosed (IsLocalRing.ResidueField Ay)] (ey : Vy.left ≅ Spec (.of Ay)) :
    Nonempty (Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) :=
by
  classical

  haveI hsub : Subsingleton ↥(Spec (CommRingCat.of F'')) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum F''))
  have hπ : (Over.mk (wcProjKStr F'' M')).hom (Vy.hom (ey.inv (IsLocalRing.closedPoint Ay))) =
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) := Subsingleton.elim _ _
  obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hπ
  have hp : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p =
      Vy.hom (ey.inv (IsLocalRing.closedPoint Ay)) :=
    hp1

  obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := Vy.hom)
    (g := (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)
    (ey.inv (IsLocalRing.closedPoint Ay)) p hp.symm
  have hq : WeaklyEtale (Limits.pullback.fst Vy.hom
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback Vy.hom (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).flip
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop

  haveI : WeaklyEtale (Limits.pullback.fst Vy.hom
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := hq
  haveI : WeaklyEtale ((Limits.pullback Vy.hom
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k =
      (Limits.pullback Vy.hom (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).fromSpecStalk t ≫
      Limits.pullback.fst Vy.hom (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ≫ ey.hom :=
    ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have hk_pt : k (IsLocalRing.closedPoint
      ((Limits.pullback Vy.hom
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint Ay := by
    have h1 : k (IsLocalRing.closedPoint
        ((Limits.pullback Vy.hom
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).presheaf.stalk t)) =
        ey.hom ((Limits.pullback.fst Vy.hom (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)
          ((Limits.pullback Vy.hom
            (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).fromSpecStalk t
          (IsLocalRing.closedPoint
            ((Limits.pullback Vy.hom
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    have h2 : ∀ y : Spec (CommRingCat.of Ay), ey.hom (ey.inv y) = y := by
      intro y
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, ey.inv_hom_id]; rfl)
        | exact congrArg (fun f : Spec (CommRingCat.of Ay) ⟶ Spec (CommRingCat.of Ay) => f y)
            ey.inv_hom_id
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    first
      | exact h2 _
      | simp
      | exact congrArg (fun f : Spec (CommRingCat.of Ay) ⟶ Spec (CommRingCat.of Ay) => f _)
          ey.inv_hom_id
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint
        ((Limits.pullback Vy.hom
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint Ay := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint
          ((Limits.pullback Vy.hom
            (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint
            ((Limits.pullback Vy.hom
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance

  have hcq : (Limits.pullback Vy.hom
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).fromSpecStalk t ≫
      Limits.pullback.fst Vy.hom (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      k ≫ ey.inv := by
    rw [hkdef]; simp
  obtain ⟨s, hs⟩ : ∃ s : Vy.left ⟶ Limits.pullback Vy.hom
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom,
      s ≫ Limits.pullback.fst Vy.hom (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
        𝟙 _ :=
    ⟨ey.hom ≫ inv k ≫ (Limits.pullback Vy.hom
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom).fromSpecStalk t, by
      rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩
  have hh : (s ≫ Limits.pullback.snd Vy.hom
