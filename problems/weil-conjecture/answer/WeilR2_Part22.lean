      (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x)).appTop) = _
    rw [Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc,
      Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  have hT3 : IsPullback
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        FractionRing H →+* TensorProduct (FractionRing (X.presheaf.stalk x)) (FractionRing H)
          Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))))
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
          Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) →+*
          TensorProduct (FractionRing (X.presheaf.stalk x)) (FractionRing H)
          Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))) ≫
