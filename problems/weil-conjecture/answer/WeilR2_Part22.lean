        ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology j).obj)
      (Opposite.op (StructuredArrow.mk (Over.homMk (ξ ≫ φ l)
        ((Category.assoc _ _ _).trans ((congrArg (fun k => ξ ≫ k) (hφa l)).trans hξ)) :
