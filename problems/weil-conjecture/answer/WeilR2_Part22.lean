theorem wc_xwtlc_sep_algebra (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {V M : Type*} [AddCommGroup V]
    [AddCommGroup M] (s : ℚ_[ℓ] → V →+ V) (hs1 : ∀ x, s 1 x = x)
    (hsm : ∀ a b x, s (a * b) x = s a (s b x)) (hsa : ∀ a b x, s (a + b) x = s a x + s b x)
    (ι : M →+ V) (hker : ∀ y, ι y = 0 → ∃ r : ℕ, ℓ ^ r • y = 0) (a b : ℕ) (e : Fin b → ℕ)
    (E : M ≃+ ((Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))) :
    ∀ x : V, (∀ N : ℕ, ∃ y ∈ ι.range, x = s ((ℓ : ℚ_[ℓ]) ^ N) y) → x = 0 :=
by
  intro x hx
  have hnat : ∀ (n : ℕ) (v : V), s (n : ℚ_[ℓ]) v = n • v := by
    intro n v
    induction n with
    | zero =>
      have h := hsa 0 0 v
      rw [add_zero] at h
      rw [Nat.cast_zero, zero_smul]
      exact left_eq_add.mp h
    | succ n ih =>
      rw [Nat.cast_succ, hsa, ih, hs1, succ_nsmul]
  have hpow : ∀ (N : ℕ) (v : V), s ((ℓ : ℚ_[ℓ]) ^ N) v = (ℓ ^ N) • v := by
    intro N v
    rw [← Nat.cast_pow, hnat]
  choose y hy hxy using hx
  choose z hz using fun N => AddMonoidHom.mem_range.mp (hy N)
  have hm : ∀ N, ι (ℓ ^ N • z N) = x := by
    intro N
    rw [map_nsmul, hz N, ← hpow, ← hxy N]
  set T := ∑ j, e j with hT
  have htors : (E (ℓ ^ T • z T)).2 = 0 := by
    funext j
    rw [map_nsmul, Prod.smul_snd, Pi.smul_apply, nsmul_eq_mul]
    have hle : e j ≤ T := Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    have hc : ((ℓ ^ T : ℕ) : ZMod (ℓ ^ e j)) = 0 := by
      rw [ZMod.natCast_eq_zero_iff]
      exact pow_dvd_pow ℓ hle
    rw [hc, zero_mul]
    rfl
  have hfree : ∀ N (i : Fin a),
      (E (ℓ ^ T • z T)).1 i = (ℓ : ℤ_[ℓ]) ^ N * (E (z N)).1 i := by
    intro N i
    obtain ⟨r, hr⟩ := hker (ℓ ^ N • z N - ℓ ^ T • z T) (by rw [map_sub, hm, hm, sub_self])
    have h1 := congrArg (fun p => (E p).1 i) hr
    simp only [map_nsmul, map_sub, map_zero, Prod.smul_fst, Prod.fst_sub, Prod.fst_zero,
      Pi.smul_apply, Pi.sub_apply, Pi.zero_apply] at h1
    simp only [nsmul_eq_mul, Nat.cast_pow] at h1
    have hne : ((ℓ : ℤ_[ℓ])) ^ r ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero)
    have h2 := (mul_eq_zero.mp h1).resolve_left hne
    simp only [map_nsmul, Prod.smul_fst, Pi.smul_apply]
    simp only [nsmul_eq_mul, Nat.cast_pow]
    linear_combination -h2
  have hzero : ∀ i, (E (ℓ ^ T • z T)).1 i = 0 := by
    intro i
    by_contra hne
    have hmem : (E (ℓ ^ T • z T)).1 i ∈
        Ideal.span {(ℓ : ℤ_[ℓ]) ^ (((E (ℓ ^ T • z T)).1 i).valuation + 1)} := by
      rw [Ideal.mem_span_singleton]
      exact ⟨_, hfree _ i⟩
    rw [PadicInt.mem_span_pow_iff_le_valuation _ hne] at hmem
    omega
  have hE0 : E (ℓ ^ T • z T) = E 0 := by
    rw [map_zero]
    exact Prod.ext (funext hzero) htors
  have h0 := E.injective hE0
  rw [← hm T, h0, map_zero]

theorem wc_xwtlc_point_sections (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (T : S.ProEt)
    (hT : Subsingleton ↥T.left) (t0 : T.left)
    (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
    (θ : G.over T ≅ (wcContSheaf S A).over T) :
    Nonempty (G.obj.obj (Opposite.op T) ≃+ A) :=
by
  let T' : Over T := Over.mk (𝟙 T)
  let e1 : G.obj.obj (Opposite.op T) ≃+ ((wcContSheaf S A).over T).obj.obj (Opposite.op T') :=
    { toFun := fun x => (θ.hom.hom.app (Opposite.op T')).hom x
      invFun := fun y => (θ.inv.hom.app (Opposite.op T')).hom y
      left_inv := fun x => congrArg (fun ψ => (ψ.hom.app (Opposite.op T')).hom x) θ.hom_inv_id
      right_inv := fun y => congrArg (fun ψ => (ψ.hom.app (Opposite.op T')).hom y) θ.inv_hom_id
      map_add' := fun x y => map_add _ x y }
  let ev : ((wcContSheaf S A).over T).obj.obj (Opposite.op T') ≃+ A :=
    { toFun := fun f => (show C(_, A) from f.down) t0
      invFun := fun a => ULift.up (ContinuousMap.const _ a)
      left_inv := fun f => by
        apply ULift.ext
        exact ContinuousMap.ext (fun t => by
          show (show C(_, A) from f.down) t0 = (show C(_, A) from f.down) t
          rw [@Subsingleton.elim _ hT t0 t])
      right_inv := fun a => rfl
      map_add' := fun f g => rfl }
  exact ⟨e1.trans ev⟩

theorem wc_pfam_xwt_lattice_continuity (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
