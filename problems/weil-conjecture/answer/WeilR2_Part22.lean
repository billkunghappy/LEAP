    (hInt : ∀ (T : (wcP1Over F'').left.ProEt)
      (y : (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj
        (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ((((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.map h.op).hom y = 0) →
      y = 0) :
    ∀ (T : (wcP1Over F'').left.ProEt) (x : (wcRq D.f ℓ q).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
