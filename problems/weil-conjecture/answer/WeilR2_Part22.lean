      (eT : T.left ≅ Spec (.of L)),
      T.hom (eT.inv (IsLocalRing.closedPoint L)) ≠ u0 (IsLocalRing.closedPoint F'') :=
by
  obtain ⟨E, a₀, L, hL, hLs, eE, hE⟩ :=
    wc_pencil_PL_generic_geom_point F'' 1 (fun _ => u0) (fun _ => hu0) V A e
