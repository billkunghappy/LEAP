    obtain ⟨n, φ, hφ⟩ := hspl
    refine wc_hfe_etale_of_reduced_fibre O (integralClosure O D) ϖ hϖ ?_
    intro x N hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hx
    have key := wc_hfe_dvr_fibre_reduced O ϖ hϖ D H g hg (hgϖ ϖ hϖ) Fh κ hκ n φ hφ
