    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      haveI : Subsingleton G := ⟨fun x y => by
        have hx := hG x
