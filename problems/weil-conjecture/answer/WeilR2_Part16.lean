  · intro k hk
    have hm : ℓ ^ k ≠ 0 := pow_ne_zero k hℓ0
    obtain ⟨Q⟩ := hEq (ℓ ^ k) hm (n - 1)
    refine ⟨Nat.finite_of_card_ne_zero (by rw [Nat.card_congr Q, hcnt k hk]; exact hm), ?_⟩
    rw [Nat.card_congr Q, hcnt k hk]

theorem wc_ppu_closed_fibre_bc_terminal {X : Scheme.{u}} (x : X)
    [IsSepClosed (X.residueField x)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') [WeaklyEtale a']
    (T : (Spec (X.residueField x)).ProEt) :
    Nonempty (T ⟶ (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk a')) ∧
      ∀ f g : T ⟶ (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk a'), f = g :=
by
  classical
  obtain ⟨hinit, -, hcompat, hφa, huniv, -⟩ := hsh
  have hk₀pt : ∀ s, X.fromSpecResidueField x s = x := fun s => Scheme.fromSpecResidueField_apply x s
  have hgeom : ∀ z, wcEtGeomPt X x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _

  have hsurj : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (w : E),
      IsSepClosed (S.residueField (e w)) → Function.Surjective (e.residueFieldMap w).hom := by
    intro E S e _ w hsep
    letI : Algebra (S.presheaf.stalk (e w)) (E.presheaf.stalk w) := (e.stalkMap w).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (S.presheaf.stalk (e w)) (E.presheaf.stalk w)) :=
      (inferInstance : IsLocalHom (e.stalkMap w).hom)
    haveI : Algebra.FormallyUnramified (S.presheaf.stalk (e w)) (E.presheaf.stalk w) :=
      FormallyUnramified.stalkMap e w
    haveI : Algebra.EssFiniteType (S.presheaf.stalk (e w)) (E.presheaf.stalk w) :=
      LocallyOfFiniteType.stalkMap e w
    haveI : Algebra.IsSeparable (IsLocalRing.ResidueField (S.presheaf.stalk (e w)))
        (IsLocalRing.ResidueField (E.presheaf.stalk w)) :=
      Algebra.instIsSeparableResidueFieldOfFormallyUnramified
    haveI : IsSepClosed (IsLocalRing.ResidueField (S.presheaf.stalk (e w))) := hsep
    have hs : Function.Surjective (algebraMap (IsLocalRing.ResidueField (S.presheaf.stalk (e w)))
        (IsLocalRing.ResidueField (E.presheaf.stalk w))) := IsSepClosed.algebraMap_surjective _ _
    exact hs

  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
      ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ pp hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have hrig : ∀ (K : Type u) [Field K] {E S : Scheme.{u}} (e : E ⟶ S) [Etale e]
      (f g : Spec (.of K) ⟶ E) (v : E) (y : S), f ≫ e = g ≫ e →
      f (IsLocalRing.closedPoint K) = v → g (IsLocalRing.closedPoint K) = v →
      e v = y → IsSepClosed (S.residueField y) → f = g := by
    intro K _ E S e _ f g v y hfg hf hg hy hsep
    subst hy
    obtain ⟨⟨w, α⟩, rfl⟩ : ∃ xf, f = (Scheme.SpecToEquivOfField K E).symm xf :=
      ⟨_, (Equiv.symm_apply_apply _ _).symm⟩
    obtain ⟨⟨w', β⟩, rfl⟩ : ∃ xf, g = (Scheme.SpecToEquivOfField K E).symm xf :=
      ⟨_, (Equiv.symm_apply_apply _ _).symm⟩
    simp only [Scheme.SpecToEquivOfField_symm_apply] at hf hg hfg ⊢
    have hw : w = v :=
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)).symm.trans hf
    have hw' : w' = v :=
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)).symm.trans hg
    subst hw
    subst hw'
    have h1 : Spec.map (e.residueFieldMap w' ≫ α) ≫ S.fromSpecResidueField (e w') =
        Spec.map (e.residueFieldMap w' ≫ β) ≫ S.fromSpecResidueField (e w') := by
      simpa only [Spec.map_comp, Category.assoc,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField] using hfg
    have h2 : e.residueFieldMap w' ≫ α = e.residueFieldMap w' ≫ β :=
      Spec.map_injective ((cancel_mono _).mp h1)
    have h3 : α = β := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro t
      obtain ⟨s, rfl⟩ := hsurj e w' hsep t
      exact congrArg (fun φ => φ.hom s) h2
    rw [h3]

  have hrigP : ∀ {P E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (f g : P ⟶ E) (y : S),
      f ≫ e = g ≫ e → (∀ p, f p = g p) → (∀ p, e (f p) = y) →
      IsSepClosed (S.residueField y) → f = g := by
    intro P E S e _ f g y hfg hpt hy hsep
    apply Scheme.hom_ext_of_forall
    intro p
    have hπ : P.fromSpecResidueField p ≫ f = P.fromSpecResidueField p ≫ g :=
      hrig (P.residueField p) e _ _ (f p) y (by rw [Category.assoc, Category.assoc, hfg])
        ((Scheme.Hom.comp_apply _ _ _).trans (congrArg f (Scheme.fromSpecResidueField_apply p _)))
        ((Scheme.Hom.comp_apply _ _ _).trans
          ((congrArg g (Scheme.fromSpecResidueField_apply p _)).trans (hpt p).symm))
        (hy p) hsep
    obtain ⟨U, hU, hUeq⟩ := s0 e f g hfg (P.residueField p) (P.fromSpecResidueField p) hπ
    exact ⟨U, Eq.mp (congrArg (fun q => q ∈ U) (Scheme.fromSpecResidueField_apply p _)) hU, hUeq⟩

  have hsec : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (w : E) (y : S), e w = y →
      IsSepClosed (S.residueField y) → ∃ s : Spec (S.residueField y) ⟶ E,
        s ≫ e = S.fromSpecResidueField y ∧ ∀ t, s t = w := by
    intro E S e _ w y hw hsep
    subst hw
    haveI : IsIso (e.residueFieldMap w) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact ⟨RingHom.injective _, hsurj e w hsep⟩
    refine ⟨Spec.map (inv (e.residueFieldMap w)) ≫ E.fromSpecResidueField w, ?_, fun t => ?_⟩
    · rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Category.assoc, ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id, Category.id_comp]
    · exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)

  have hisoGen : ∀ {V S : Scheme.{u}} (f : V ⟶ S) [Etale f] (v : V),
      ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, f w = f v → w = v := by
    intro V S f _ v
    haveI hlqf : LocallyQuasiFinite f := by
      rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
      intro U W e
      have h := HasRingHomProperty.appLE @Etale f ‹Etale f› U W e
      letI := (f.appLE U W e).hom.toAlgebra
      haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
      exact RingHom.quasiFinite_algebraMap.mpr inferInstance
    haveI hd : DiscreteTopology ↑(f ⁻¹' {f v}) := (f.fiberHomeo (f v)).discreteTopology
    have hv : f v ∈ ({f v} : Set S) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(f ⁻¹' {f v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro w hwU hw
      have hw' : w ∈ f ⁻¹' {f v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
      have : (⟨w, hw'⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := hwU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this

  have hw : ∀ l, (W''.obj l).right.hom ((W''.obj l).hom.left
      (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) = x := fun l =>
    (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))
        (Over.w (W''.obj l).hom)).trans (hgeom _))
  have hφx : ∀ l b, a' b = x → (W''.obj l).right.hom (φ' l b) = x := fun l b hb =>
    (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun f => f b) (hφa l)).trans hb)

  have hcollapse : ∀ (l : Λ') (b : Spec (.of B)), a' b = x →
      φ' l b = (W''.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) := by
    intro l b hb
    haveI hEt : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    obtain ⟨O, hwO, hiso⟩ := hisoGen (W''.obj l).right.hom
      ((W''.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))
    have hr : Set.range (W''.obj l).hom.left ⊆ Set.range O.ι := by
      rintro _ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)) :=
        Subsingleton.elim (α := PrimeSpectrum (AlgebraicClosure (X.residueField x))) _ _
      subst hz
      exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mpr hwO
    let lam := IsOpenImmersion.lift O.ι (W''.obj l).hom.left hr
    have hlam : lam ≫ O.ι = (W''.obj l).hom.left := IsOpenImmersion.lift_fac _ _ _
    let R : X.Etale := Scheme.Etale.mk (O.ι ≫ (W''.obj l).right.hom)
    have hlamR : lam ≫ ((Scheme.Etale.forget X).obj R).hom =
        (Over.mk (wcEtGeomPt X x)).hom := by
      show lam ≫ O.ι ≫ (W''.obj l).right.hom = wcEtGeomPt X x
      rw [← Category.assoc, hlam]
      exact Over.w (W''.obj l).hom
    let d : StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X) :=
      StructuredArrow.mk (Y := R) (Over.homMk lam hlamR)
    let iR : R ⟶ (W''.obj l).right := MorphismProperty.Over.homMk O.ι rfl trivial
    let i : d ⟶ W''.obj l := StructuredArrow.homMk iR (by
      apply Over.OverMorphism.ext
      exact hlam)
    obtain ⟨hI1, hI2⟩ := (Functor.initial_iff_of_isCofiltered W'').mp hinit
    obtain ⟨l₁, ⟨g₁⟩⟩ := hI1 d
    obtain ⟨l₃, t', ht'⟩ := hI2 (W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁ ≫ i)
      (W''.map (IsCofiltered.minToRight l₁ l))
    have hg : (W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁) ≫ i =
        W''.map (t' ≫ IsCofiltered.minToRight l₁ l) := by
      rw [Functor.map_comp, Category.assoc, Category.assoc]
      exact ht'
    have hg' : (W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι =
        (W''.map (t' ≫ IsCofiltered.minToRight l₁ l)).right.left :=
      congrArg (fun k => k.right.left) hg
    have e1 : φ' l = φ' l₃ ≫
        (W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι := by
      rw [hg', hcompat]
    have hmem : φ' l b ∈ O := by
      have h4 : φ' l b = O.ι
          ((W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left
            (φ' l₃ b)) :=
        (congrArg (fun f => f b) e1).trans
          ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _))
      rw [h4]
      exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp (Set.mem_range_self _)
    exact hiso _ hmem ((hφx l b hb).trans (hw l).symm)

  have hzex : ∀ l, ∃ s : Spec (X.residueField x) ⟶ (W''.obj l).right.left,
      s ≫ (W''.obj l).right.hom = X.fromSpecResidueField x ∧
      ∀ t, s t = (W''.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) := by
    intro l
    haveI : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    exact hsec (W''.obj l).right.hom _ x (hw l)
      (show IsSepClosed (X.residueField x) from inferInstance)
  choose z hze hzpt using hzex
  have hzc : ∀ {l l' : Λ'} (t : l ⟶ l'), z l ≫ (W''.map t).right.left = z l' := by
    intro l l' t
    haveI : Etale (W''.obj l').right.hom := (W''.obj l').right.prop
    have hm : (W''.obj l).hom.left ≫ (W''.map t).right.left = (W''.obj l').hom.left :=
      congrArg (fun f => f.left) (StructuredArrow.w (W''.map t))
    have hm' : (W''.map t).right.left ((W''.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) =
        (W''.obj l').hom.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) hm)
    exact hrig (X.residueField x) (W''.obj l').right.hom (z l ≫ (W''.map t).right.left) (z l')
      ((W''.obj l').hom.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) x
      ((Category.assoc _ _ _).trans
        ((congrArg (fun k => z l ≫ k) (MorphismProperty.Over.w (W''.map t).right)).trans
          ((hze l).trans (hze l').symm)))
      ((Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg (W''.map t).right.left (hzpt l _)).trans hm'))
      (hzpt l' _) (hw l') (show IsSepClosed (X.residueField x) from inferInstance)

  obtain ⟨δ, hδ, -⟩ := huniv (Spec (X.residueField x)) z hzc
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ')
  have hδa : δ ≫ a' = X.fromSpecResidueField x :=
    (congrArg (fun k => δ ≫ k) (hφa l₀)).symm.trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (fun k => k ≫ (W''.obj l₀).right.hom)
        (hδ l₀)).trans (hze l₀)))
  have hcond : Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ a' =
      Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ X.fromSpecResidueField x :=
    Limits.pullback.condition
  have hP1 : ∀ p, a' (Limits.pullback.fst a' (X.fromSpecResidueField x) p) = x := fun p =>
    (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun f => f p) hcond).trans
      ((Scheme.Hom.comp_apply _ _ _).trans (hk₀pt _)))
  have hkey : ∀ l, Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ φ' l =
      Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ z l := by
    intro l
    haveI : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    have hfg : (Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ φ' l) ≫
        (W''.obj l).right.hom =
        (Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ z l) ≫ (W''.obj l).right.hom :=
      (Category.assoc _ _ _).trans ((congrArg (fun k => _ ≫ k) (hφa l)).trans
        (hcond.trans ((congrArg (fun k => _ ≫ k) (hze l)).symm.trans
          (Category.assoc _ _ _).symm)))
    exact hrigP (W''.obj l).right.hom _ _ x hfg
      (fun p => (Scheme.Hom.comp_apply _ _ _).trans ((hcollapse l _ (hP1 p)).trans
        ((hzpt l _).symm.trans (Scheme.Hom.comp_apply _ _ _).symm)))
      (fun p => (congrArg (W''.obj l).right.hom (Scheme.Hom.comp_apply _ _ _)).trans
        (hφx l _ (hP1 p)))
      (show IsSepClosed (X.residueField x) from inferInstance)
  have hfst : Limits.pullback.fst a' (X.fromSpecResidueField x) =
      Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ δ := by
    obtain ⟨z₀, -, huniq⟩ := huniv _
      (fun l => Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ φ' l)
      (fun t => by rw [Category.assoc, hcompat])
    exact (huniq _ (fun l => rfl)).trans
      (huniq _ (fun l => by rw [Category.assoc, hδ, hkey])).symm
  let σ : Spec (X.residueField x) ⟶ Limits.pullback a' (X.fromSpecResidueField x) :=
    Limits.pullback.lift δ (𝟙 _) (by rw [hδa, Category.id_comp])
  have hσs : σ ≫ Limits.pullback.snd a' (X.fromSpecResidueField x) = 𝟙 _ :=
    Limits.pullback.lift_snd _ _ _
  have hσf : σ ≫ Limits.pullback.fst a' (X.fromSpecResidueField x) = δ :=
    Limits.pullback.lift_fst _ _ _
  have hsσ : Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ σ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hσf, Category.id_comp, hfst]
    · rw [Category.assoc, hσs, Category.comp_id, Category.id_comp]
  have hT : (T.hom ≫ σ) ≫ Limits.pullback.snd a' (X.fromSpecResidueField x) = T.hom :=
    (Category.assoc _ _ _).trans ((congrArg (fun k => T.hom ≫ k) hσs).trans (Category.comp_id _))
  have hext : ∀ k : T.left ⟶ Limits.pullback a' (X.fromSpecResidueField x),
      k ≫ Limits.pullback.snd a' (X.fromSpecResidueField x) = T.hom → k = T.hom ≫ σ := by
    intro k hk
    exact (Category.comp_id k).symm.trans ((congrArg (fun m => k ≫ m) hsσ.symm).trans
      ((Category.assoc _ _ _).symm.trans (congrArg (fun m => m ≫ σ) hk)))
  refine ⟨⟨MorphismProperty.Over.homMk (T.hom ≫ σ) hT trivial⟩, fun f g => ?_⟩
  apply MorphismProperty.Over.Hom.ext
  exact (hext f.left (MorphismProperty.Over.w f)).trans (hext g.left (MorphismProperty.Over.w g)).symm

theorem wc_ppu_lc_closed_fibre_contfun_bij {X : Scheme.{u}} (x : X)
    [IsSepClosed (X.residueField x)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
    [TotallyDisconnectedSpace S] :
    Function.Bijective (fun r : C(↥(Spec (.of (LocallyConstant S B))), ULift.{u+1} ℚ_[ℓ]) =>
      r.comp (TopCat.Hom.hom (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
          (X.fromSpecResidueField x)).base)) :=
by
  classical

  have s1 : ∀ {T P : Type u} {Q : Type (u+1)} [TopologicalSpace T] [TopologicalSpace P]
      [TopologicalSpace Q] [T1Space Q] (f : C(P, T)), Topology.IsInducing f →
      ∀ (τ : T → T), Continuous τ → (∀ t, t ⤳ τ t) → (∀ t, τ t ∈ Set.range f) →
      Function.Bijective (fun r : C(T, Q) => r.comp f) := by
    intro T P Q _ _ _ _ f hf τ hτc hτs hτr
    have key : ∀ (r : C(T, Q)) (t : T), r t = r (τ t) :=
      fun r t => ((hτs t).map r.continuous).eq
    have hτr' : ∀ t, ∃ p, f p = τ t := hτr
    choose ρ hρ using hτr'
    have hρc : Continuous ρ := by
      rw [hf.continuous_iff]
      have e : (⇑f ∘ ρ) = τ := funext hρ
      rw [e]
      exact hτc
    refine ⟨fun r r' h => ?_, fun q => ⟨q.comp ⟨ρ, hρc⟩, ?_⟩⟩
    · ext t
      have h1 := ContinuousMap.congr_fun h (ρ t)
      simp only [ContinuousMap.comp_apply, hρ] at h1
      rw [key r t, key r' t]
      exact h1
    · ext p
      simp only [ContinuousMap.comp_apply, ContinuousMap.coe_mk]
      have h2 : f p ⤳ f (ρ (f p)) := by rw [hρ]; exact hτs (f p)
      exact ((hf.specializes_iff.mp h2).map q.continuous).eq.symm

  have ha : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
    have hgeom : ∀ z, wcEtGeomPt X x z = x := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply x _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
        IsLocalRing.closedPoint B :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
    have h1 := congrArg
      (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'

  have I1 : LocallyConstant.charFn B (isClopen_univ (X := S)) = 1 := by
    ext y
    simp [LocallyConstant.coe_charFn]
  have I2 : LocallyConstant.charFn B (isClopen_empty (X := S)) = 0 := by
    ext y
    simp [LocallyConstant.coe_charFn]
  have I3 : ∀ (U V : Set S) (hU : IsClopen U) (hV : IsClopen V),
      LocallyConstant.charFn B (hU.inter hV) =
        LocallyConstant.charFn B hU * LocallyConstant.charFn B hV := by
    intro U V hU hV
    ext y
    simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_mul, Pi.mul_apply,
      Set.indicator_apply, Pi.one_apply, Set.mem_inter_iff]
    split_ifs <;> simp_all
  have I5 : ∀ (U : Set S) (hU : IsClopen U),
      LocallyConstant.charFn B hU + LocallyConstant.charFn B hU.compl = 1 := by
    intro U hU
    ext y
    simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_add, LocallyConstant.coe_one,
      Pi.add_apply, Pi.one_apply, Set.indicator_apply, Set.mem_compl_iff]
    split_ifs <;> simp_all
  have key : ∀ q : PrimeSpectrum (LocallyConstant S B), ∃ s0 : S,
      ∀ (U : Set S) (hU : IsClopen U),
        s0 ∈ U ↔ LocallyConstant.charFn B hU ∉ q.asIdeal := by
    intro q
    have hP := q.isPrime
    have h1 : (1 : LocallyConstant S B) ∉ q.asIdeal :=
      (Ideal.ne_top_iff_one _).mp hP.ne_top
    let 𝒰 : Set (Set S) :=
      {U | ∃ hU : IsClopen U, LocallyConstant.charFn B hU ∉ q.asIdeal}
    have hne : (⋂₀ 𝒰).Nonempty := by
      have : Nonempty 𝒰 := ⟨⟨Set.univ, isClopen_univ, by rw [I1]; exact h1⟩⟩
      apply IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed
      · intro U hU V hV
        obtain ⟨hU', hu⟩ := hU
        obtain ⟨hV', hv⟩ := hV
        refine ⟨U ∩ V, ⟨hU'.inter hV', ?_⟩, Set.inter_subset_left, Set.inter_subset_right⟩
        rw [I3 U V hU' hV']
        intro hm
        rcases hP.mem_or_mem hm with h | h
        · exact hu h
        · exact hv h
      · rintro U ⟨hU', hu⟩
        rw [Set.nonempty_iff_ne_empty]
        rintro rfl
        apply hu
        have e : LocallyConstant.charFn B hU' = 0 := I2
        rw [e]
        exact Ideal.zero_mem _
      · rintro U ⟨hU', -⟩
        exact hU'.isClosed.isCompact
      · rintro U ⟨hU', -⟩
        exact hU'.isClosed
    obtain ⟨s0, hs0⟩ := hne
    rw [Set.mem_sInter] at hs0
    refine ⟨s0, fun U hU => ⟨fun hsU hm => ?_, fun hn => hs0 U ⟨hU, hn⟩⟩⟩
    have hc : LocallyConstant.charFn B hU.compl ∉ q.asIdeal := by
      intro hc
      apply h1
      rw [← I5 U hU]
      exact Ideal.add_mem _ hm hc
    exact hs0 Uᶜ ⟨hU.compl, hc⟩ hsU
  choose πf hπ using key
  have hπc : Continuous πf := by
    rw [isTopologicalBasis_isClopen.continuous_iff]
    intro s hs
    have e : πf ⁻¹' s =
        (PrimeSpectrum.basicOpen (LocallyConstant.charFn B hs) : Set _) := by
      ext q
      rw [Set.mem_preimage, hπ q s hs, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    rw [e]
    exact PrimeSpectrum.isOpen_basicOpen

  let σf : S → PrimeSpectrum (LocallyConstant S B) := fun s =>
    PrimeSpectrum.comap (LocallyConstant.evalRingHom s) (IsLocalRing.closedPoint B)
  have hσmem : ∀ (s : S) (g : LocallyConstant S B),
      g ∈ (σf s).asIdeal ↔ g s ∈ IsLocalRing.maximalIdeal B := fun s g => Iff.rfl
  have hσc : Continuous σf := by
    rw [PrimeSpectrum.isTopologicalBasis_basic_opens.continuous_iff]
    rintro _ ⟨g, rfl⟩
    have e : σf ⁻¹' (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum (LocallyConstant S B))) =
        ⇑g ⁻¹' (IsLocalRing.maximalIdeal B : Set B)ᶜ := by
      ext s
      change (g ∉ (σf s).asIdeal) ↔ (g s ∉ IsLocalRing.maximalIdeal B)
      exact not_congr (hσmem s g)
    rw [e]
    exact g.isLocallyConstant _
  have hσcl : ∀ s, PrimeSpectrum.comap
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B) (σf s) =
        IsLocalRing.closedPoint B := by
    intro s
    apply PrimeSpectrum.ext
    ext b
    exact Iff.rfl

  have hle : ∀ (t : PrimeSpectrum (LocallyConstant S B)) (g : LocallyConstant S B),
      g ∈ t.asIdeal → g (πf t) ∈ IsLocalRing.maximalIdeal B := by
    intro t g hg
    by_contra hns
    have hu : IsUnit (g (πf t)) := IsLocalRing.notMem_maximalIdeal.mp hns
    have hU : IsClopen {s' | g s' = g (πf t)} := g.isLocallyConstant.isClopen_fiber _
    have hχ : LocallyConstant.charFn B hU ∉ t.asIdeal := (hπ t _ hU).mp rfl
    apply hχ
    have heq : LocallyConstant.charFn B hU =
        (LocallyConstant.charFn B hU * LocallyConstant.const S (↑hu.unit⁻¹ : B)) * g := by
      ext s'
      simp only [LocallyConstant.coe_mul, LocallyConstant.coe_charFn, LocallyConstant.coe_const,
        Pi.mul_apply, Function.const_apply, Set.indicator_apply, Set.mem_setOf_eq,
        Pi.one_apply]
      split_ifs with h
      · rw [h, one_mul, hu.val_inv_mul]
      · rw [zero_mul, zero_mul]
    rw [heq]
    exact Ideal.mul_mem_left _ _ hg

  have hτs : ∀ t : PrimeSpectrum (LocallyConstant S B), t ⤳ σf (πf t) := by
    intro t
    refine (PrimeSpectrum.le_iff_specializes t (σf (πf t))).mp ?_
    show t.asIdeal ≤ (σf (πf t)).asIdeal
    intro g hg
    exact (hσmem (πf t) g).mpr (hle t g hg)
  have hτr : ∀ t : PrimeSpectrum (LocallyConstant S B),
      (σf (πf t) : ↥(Spec (.of (LocallyConstant S B)))) ∈ Set.range ⇑(Limits.pullback.fst
        (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
        (X.fromSpecResidueField x)) := by
    intro t
    rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
    have hc : (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
          (σf (πf t) : ↥(Spec (.of (LocallyConstant S B)))) =
          IsLocalRing.closedPoint B := hσcl (πf t)
    exact (Scheme.Hom.comp_apply _ a' _).trans ((congrArg a' hc).trans ha)
  have hf := (Scheme.Hom.isEmbedding (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
        (X.fromSpecResidueField x))).isInducing
  exact s1 _ hf (fun t => σf (πf t)) (hσc.comp hπc) hτs hτr

theorem wc_proet_point_pull_unit_of_shens_sections {X : Scheme.{u}} (x : X)
    [IsSepClosed (X.residueField x)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') [WeaklyEtale a']
    (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (m : M.val.obj (Opposite.op (Scheme.ProEt.mk a')))
    (hm : ∀ (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
        [TotallyDisconnectedSpace S] [ExtremallyDisconnected S]
        [WeaklyEtale (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')],
      Function.Bijective (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk
          (Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))) =>
        r • (M.val.map (@Quiver.Hom.op X.ProEt _ _ _ (MorphismProperty.Over.homMk
          (A := Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
              (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))
          (B := Scheme.ProEt.mk a')
          (Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
          rfl trivial))).hom m))
    (Dk : wcHMPullData (X.fromSpecResidueField x) ℓ) (hDk : wcHMPullCanonical Dk) :
    Nonempty (Dk.Φ.obj M ≅ SheafOfModules.unit (wcRingSheaf (Spec (X.residueField x)) ℓ)) :=
by
  classical
  have hterm : ∀ T : (Spec (X.residueField x)).ProEt,
      Nonempty (T ⟶ (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk a')) ∧
      ∀ f g : T ⟶ (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk a'), f = g :=
    fun T => wc_ppu_closed_fibre_bc_terminal x B Λ' W'' φ' a' hsh T
  let P := (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk a')
  let N := Dk.Φ.obj M
  let u := Dk.adj.unit.app M
  let s0 : N.val.obj (Opposite.op P) := (u.val.app (Opposite.op (Scheme.ProEt.mk a'))).hom m
  let g : ∀ T : (Spec (X.residueField x)).ProEt, T ⟶ P := fun T => Classical.choice (hterm T).1
  have hg : ∀ {T : (Spec (X.residueField x)).ProEt} (f : T ⟶ P), f = g T :=
    fun f => (hterm _).2 _ _
  let σ : N.sections := PresheafOfModules.sectionsMk
    (fun T => (N.val.map (g T.unop).op).hom s0)
    (by
      intro T T' f
      have hf : (g T.unop).op ≫ f = (g T'.unop).op :=
        Quiver.Hom.unop_inj (by exact (hg (f.unop ≫ g T.unop)))
      rw [← hf]
      exact (PresheafOfModules.map_comp_apply N.val (g T.unop).op f s0).symm)
  let ψ : SheafOfModules.unit (wcRingSheaf (Spec (X.residueField x)) ℓ) ⟶ N := N.unitHomEquiv.symm σ
  have hψ : ∀ (T : (Spec (X.residueField x)).ProEt)
      (r : (wcRingSheaf (Spec (X.residueField x)) ℓ).obj.obj (Opposite.op T)),
      (ψ.val.app (Opposite.op T)).hom r =
        r • (N.val.map (g T).op).hom s0 := fun T r => rfl
  have hbijW : ∀ (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
      [TotallyDisconnectedSpace S] [ExtremallyDisconnected S]
      [WeaklyEtale (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')],
      Function.Bijective (ψ.val.app (Opposite.op ((wcProEtBC (X.fromSpecResidueField x)).obj
        (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))))).hom := by
    intro S _ _ _ _ _ _
    let V := Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
    let ρ : V ⟶ Scheme.ProEt.mk a' := MorphismProperty.Over.homMk
      (A := Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))
      (B := Scheme.ProEt.mk a')
      (Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
      rfl trivial
    let W := (wcProEtBC (X.fromSpecResidueField x)).obj V
    let φV : (wcRingSheaf X ℓ).obj.obj (Opposite.op V) →
        (wcRingSheaf (Spec (X.residueField x)) ℓ).obj.obj (Opposite.op W) :=
      fun r => (Dk.φ.hom.app (Opposite.op V)).hom r
    let H := fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op V) => r • (M.val.map ρ.op).hom m
    have hφ : Function.Bijective φV := by
      have h4 := wc_ppu_lc_closed_fibre_contfun_bij x ℓ B Λ' W'' φ' a' hsh S
      have e : φV = fun r : C(↥(Spec (.of (LocallyConstant S B))), ULift.{u+1} ℚ_[ℓ]) =>
          r.comp (TopCat.Hom.hom (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
            (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
              (X.fromSpecResidueField x)).base) :=
        funext fun r => hDk V r
      rw [e]
      exact h4
    have hu := wc_ppu_unit_bij_lc_thickening x ℓ B Λ' W'' φ' a' hsh Dk hDk M S
    have hcomp : Function.Bijective ((fun r' => (ψ.val.app (Opposite.op W)).hom r') ∘ φV) := by
      have heq : ((fun r' => (ψ.val.app (Opposite.op W)).hom r') ∘ φV) =
          (u.val.app (Opposite.op V)).hom ∘ H := by
        funext r
        have e3 : g W = (wcProEtBC (X.fromSpecResidueField x)).map ρ := (hg _).symm
        have e2 := PresheafOfModules.naturality_apply u.val ρ.op m
        have e1 := (u.val.app (Opposite.op V)).hom.map_smul r ((M.val.map ρ.op).hom m)
        refine Eq.trans ?_ e1.symm
        refine Eq.trans (hψ W (φV r)) ?_
        rw [e3]
        exact congrArg (fun y => φV r • y) e2.symm
      rw [heq]
      exact hu.comp (hm S)
    exact (Function.Bijective.of_comp_iff _ hφ).mp hcomp
  have hiso : IsIso ((SheafOfModules.toSheaf _).map ψ) := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine (Scheme.ProEt.topology _).superset_covering ?_
      (wc_ppu_closed_fibre_lc_cover x B Λ' W'' φ' a' hsh U)
    rw [Sieve.generate_le_iff]
    rintro T f ⟨S, _, _, _, _, _, _, rfl⟩
    apply Sieve.le_generate
    exact hbijW S
  haveI : IsIso ψ := isIso_of_reflects_iso ψ (SheafOfModules.toSheaf _)
  exact ⟨(asIso ψ).symm⟩

theorem wc_proet_push_homology_sections_ext {X Y : Scheme.{u}} (g : X ⟶ Y) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X ℓ))) (q : ℕ)
    (Pf : X.ProEt → SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (Pm : ∀ (W W' : X.ProEt), (W' ⟶ W) → (Pf W' ⟶ Pf W))
    (ev : ∀ (W : X.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ)),
      (Pf W ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnat : ∀ (W : X.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (ψ : M ⟶ N) (f : Pf W ⟶ M),
      ev W N (f ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M f))
    (hpre : ∀ (W W' : X.ProEt) (b : W' ⟶ W) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (f : Pf W ⟶ M),
      ev W' M (Pm W W' b ≫ f) = (M.val.map b.op).hom (ev W M f))
    (hadd : ∀ (W : X.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (f f' : Pf W ⟶ M),
      ev W M (f + f') = ev W M f + ev W M f')
    (hepi : ∀ (W : Y.ProEt), Projective (wcFreeSheaf Y W) →
      ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : M ⟶ N), Epi f →
        Function.Surjective (f.val.app (Opposite.op W)).hom)
    (hexact : ∀ (W : Y.ProEt), Projective (wcFreeSheaf Y W) →
      ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf Y ℓ))), S.Exact →
        ∀ x : S.X₂.val.obj (Opposite.op W), (S.g.val.app (Opposite.op W)).hom x = 0 →
          ∃ y : S.X₁.val.obj (Opposite.op W), (S.f.val.app (Opposite.op W)).hom y = x) :
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
    ∃ Λ : ∀ (W : Y.ProEt), Projective (wcFreeSheaf Y W) →
        ((((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
          (Opposite.op W) ≃+
          Abelian.Ext (Pf ((wcProEtBC g).obj W)) (SheafOfModules.unit (wcRingSheaf X ℓ)) q),
      (∀ (W : Y.ProEt) (hW : Projective (wcFreeSheaf Y W))
          (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op W))
          (h : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
            (Opposite.op W)),
        Λ W hW (r • h) =
          (Abelian.Ext.mk₀ ((ev ((wcProEtBC g).obj W) (Pf ((wcProEtBC g).obj W))).symm
            ((show (wcRingSheaf X ℓ).obj.obj (Opposite.op ((wcProEtBC g).obj W)) from
                (Dg.φ.hom.app (Opposite.op W)).hom r) •
              ev ((wcProEtBC g).obj W) (Pf ((wcProEtBC g).obj W)) (𝟙 _)))).comp
            (Λ W hW h) (zero_add q)) ∧
      (∀ (W W' : Y.ProEt) (hW : Projective (wcFreeSheaf Y W))
          (hW' : Projective (wcFreeSheaf Y W')) (b : W' ⟶ W)
          (h : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
            (Opposite.op W)),
        Λ W' hW' (((((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology
            q).val.map b.op).hom h) =
          (Abelian.Ext.mk₀ (Pm ((wcProEtBC g).obj W) ((wcProEtBC g).obj W')
            ((wcProEtBC g).map b))).comp (Λ W hW h) (zero_add q)) :=
by
  intro P
  haveI := Dg.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
  set K := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hK

  have s1 : ∀ (W : Y.ProEt), Projective (wcFreeSheaf Y W) →
      ∀ (A : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
        (τ : ∀ n, (K.X n).val.obj (Opposite.op W) →+ (A ⟶ I.cocomplex.X n)),
        (∀ n, Function.Bijective (τ n)) →
        (∀ (n : ℕ) (s : (K.X n).val.obj (Opposite.op W)),
          τ (n + 1) (((K.d n (n + 1)).val.app (Opposite.op W)).hom s) =
            τ n s ≫ I.cocomplex.d n (n + 1)) →
        ∃ κ : (K.homology q).val.obj (Opposite.op W) ≃+
            Abelian.Ext A (SheafOfModules.unit (wcRingSheaf X ℓ)) q,
          ∀ (z : (K.cycles q).val.obj (Opposite.op W))
            (hf : τ q (((K.iCycles q).val.app (Opposite.op W)).hom z) ≫
              I.cocomplex.d q (q + 1) = 0),
            κ (((K.homologyπ q).val.app (Opposite.op W)).hom z) =
              I.extMk (τ q (((K.iCycles q).val.app (Opposite.op W)).hom z)) (q + 1) rfl hf := by
    intro W hW A τ hτ hcomm
    have hπs : Function.Surjective ((K.homologyπ q).val.app (Opposite.op W)).hom :=
      hepi W hW (K.homologyπ q) inferInstance
    have hi : Function.Injective ((K.iCycles q).val.app (Opposite.op W)).hom := by
      have hm : Mono ((SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _
          (Opposite.op W)).map (K.iCycles q)) := Functor.map_mono _ _
      exact (ModuleCat.mono_iff_injective _).1 hm
    have hlift : ∀ s : (K.X q).val.obj (Opposite.op W),
        ((K.d q (q + 1)).val.app (Opposite.op W)).hom s = 0 →
        ∃ x, ((K.iCycles q).val.app (Opposite.op W)).hom x = s := by
      have hS : (ShortComplex.mk (K.iCycles q) (K.d q (q + 1)) (by simp)).Exact :=
        ShortComplex.exact_of_f_is_kernel _ (K.cyclesIsKernel q (q + 1) (by simp))
      intro s hs
      exact hexact W hW _ hS s hs
    have hcrit : ∀ p, (ComplexShape.up ℕ).prev q = p → ∀ x,
        ((K.homologyπ q).val.app (Opposite.op W)).hom x = 0 ↔
          ∃ b : (K.X p).val.obj (Opposite.op W), ((K.d p q).val.app (Opposite.op W)).hom b =
            ((K.iCycles q).val.app (Opposite.op W)).hom x := by
      intro p hp x
      have hS : (ShortComplex.mk (K.toCycles p q) (K.homologyπ q) (by simp)).Exact :=
        ShortComplex.exact_of_g_is_cokernel _ (K.homologyIsCokernel p q hp)
      have hti : ∀ b : (K.X p).val.obj (Opposite.op W),
          ((K.iCycles q).val.app (Opposite.op W)).hom
            (((K.toCycles p q).val.app (Opposite.op W)).hom b)
            = ((K.d p q).val.app (Opposite.op W)).hom b := by
        intro b
