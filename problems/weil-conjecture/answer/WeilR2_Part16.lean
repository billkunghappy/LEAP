    (wcZModSheaf Y ℓ) z (Subsingleton.elim _ _) (n₀ := 2 * N) (by omega)
  rw [← hx₁, h1 x₁, Abelian.Ext.comp_zero]

theorem wc_isol_pt_local_zmod_card_ge (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y] (N : ℕ)
    (hdim : topologicalKrullDim Y = (N : WithBot ℕ∞))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (O : Y.Opens)
