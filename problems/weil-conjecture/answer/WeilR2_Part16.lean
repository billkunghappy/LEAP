    refine ⟨T.2 K _ e.symm (Field.henselian K), ?_⟩
    have hfield : IsField ((Spec (.of (LocallyConstant S K))).presheaf.stalk z) :=
      MulEquiv.isField (Field.toIsField K) e.toMulEquiv
    have hbot : IsLocalRing.maximalIdeal ((Spec (.of (LocallyConstant S K))).presheaf.stalk z) = ⊥ :=
      IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield
    let ρ : (Spec (.of (LocallyConstant S K))).presheaf.stalk z →+*
        (Spec (.of (LocallyConstant S K))).residueField z := IsLocalRing.residue _
    have hρinj : Function.Injective ρ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hxm : x ∈ IsLocalRing.maximalIdeal _ := (IsLocalRing.residue_eq_zero_iff x).mp hx
