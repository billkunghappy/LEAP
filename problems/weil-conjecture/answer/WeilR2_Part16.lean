theorem wc_proet_push_homology_sections_hm {X Y : Scheme.{u}} (g : X ⟶ Y) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X ℓ))) (q : ℕ) :
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    ∃ Ψ : ∀ (W : Y.ProEt), Projective (wcFreeSheaf Y W) →
        ((((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
          (Opposite.op W) ≃+ wcHM (Limits.pullback W.hom g) ℓ q),
      (∀ (W : Y.ProEt) (hW : Projective (wcFreeSheaf Y W))
          (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op W))
          (h : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
            (Opposite.op W)),
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback W.hom g) ℓ)) :=
          HasExt.standard _
        Ψ W hW (r • h) =
          (Abelian.Ext.mk₀ (wcHMFun (Limits.pullback W.hom g) ℓ
            ((show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from r).comp
              (Limits.pullback.fst W.hom g).base.hom))).comp
            (Ψ W hW h) (zero_add q)) ∧
      (∀ (W W' : Y.ProEt) (hW : Projective (wcFreeSheaf Y W))
          (hW' : Projective (wcFreeSheaf Y W')) (b : W' ⟶ W)
          (p : Limits.pullback W'.hom g ⟶ Limits.pullback W.hom g)
          (hp1 : p ≫ Limits.pullback.fst W.hom g = Limits.pullback.fst W'.hom g ≫ b.left)
          (hp2 : p ≫ Limits.pullback.snd W.hom g = Limits.pullback.snd W'.hom g)
          (Db : wcHMPullData p ℓ), wcHMPullCanonical Db →
        ∀ h : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
            (Opposite.op W),
          Ψ W' hW' (((((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology
            q).val.map b.op).hom h) = wcHMPull Db q (Ψ W hW h)) :=
by
  intro P
  haveI := Dg.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _

  choose Pf ev hnat hadd using fun W : X.ProEt =>
    sheafOfModules_free_yoneda (Scheme.ProEt.topology X) (wcRingSheaf X ℓ) W
  let Pm : ∀ (W W' : X.ProEt), (W' ⟶ W) → (Pf W' ⟶ Pf W) := fun W W' b =>
    (ev W' (Pf W)).symm (((Pf W).val.map b.op).hom (ev W (Pf W) (𝟙 _)))
  have hpre : ∀ (W W' : X.ProEt) (b : W' ⟶ W) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (f : Pf W ⟶ M), ev W' M (Pm W W' b ≫ f) = (M.val.map b.op).hom (ev W M f) := by
    intro W W' b M f
    rw [hnat W' (Pf W) M f (Pm W W' b)]
    have e1 : ev W' (Pf W) (Pm W W' b) = ((Pf W).val.map b.op).hom (ev W (Pf W) (𝟙 _)) :=
      Equiv.apply_symm_apply _ _
    rw [e1]
    have e2 : ev W M f = (f.val.app (Opposite.op W)).hom (ev W (Pf W) (𝟙 _)) := by
      rw [← hnat W (Pf W) M f (𝟙 _), Category.id_comp]
    rw [e2]
    exact PresheafOfModules.naturality_apply f.val b.op _

  have hs2 : ∀ (W : Y.ProEt), Projective (wcFreeSheaf Y W) →
      (∀ {M N : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : M ⟶ N), Epi f →
        Function.Surjective (f.val.app (Opposite.op W)).hom) ∧
      (∀ (S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf Y ℓ))), S.Exact →
        ∀ x : S.X₂.val.obj (Opposite.op W), (S.g.val.app (Opposite.op W)).hom x = 0 →
          ∃ y : S.X₁.val.obj (Opposite.op W), (S.f.val.app (Opposite.op W)).hom y = x) := by
    intro W hW
    haveI := hW
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology Y)
      (wcRingSheaf Y ℓ)
    haveI : Limits.PreservesColimitsOfShape Limits.WalkingSpan
        (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)) :=
      Limits.PreservesFiniteColimits.preservesFiniteColimits _
    haveI := preservesEpimorphisms_of_preservesColimitsOfShape
      (SheafOfModules.toSheaf (wcRingSheaf Y ℓ))
    obtain ⟨e, hnat_e, he0⟩ := proet_free_sheaf_hom_equiv Y W
    refine ⟨fun {M N} f hf => ?_, fun S hS x hx => ?_⟩
    · haveI := hf
      haveI : Epi ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map f) := Functor.map_epi _ _
      intro x
      let φ := (e ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj N)).symm x
      let ψ := Projective.factorThru φ ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map f)
      refine ⟨e ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj M) ψ, ?_⟩
      have h1 := hnat_e _ _ ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map f) ψ
      rw [Projective.factorThru_comp] at h1
      exact ((Equiv.apply_symm_apply _ x).symm.trans h1).symm
    · have hST := hS.map (SheafOfModules.toSheaf (wcRingSheaf Y ℓ))
      let φ := (e ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj S.X₂)).symm x
      have hφ : φ ≫ (S.map (SheafOfModules.toSheaf (wcRingSheaf Y ℓ))).g = 0 := by
        apply (e ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj S.X₃)).injective
        rw [he0]
        refine (hnat_e _ _ ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map S.g) φ).trans ?_
        exact (congrArg (ConcreteCategory.hom
          (((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map S.g).hom.app (Opposite.op W)))
          (Equiv.apply_symm_apply (e ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj S.X₂)) x)).trans hx
      refine ⟨e ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj S.X₁)
        (hST.liftFromProjective φ hφ), ?_⟩
      have h1 := hnat_e _ _ ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map S.f)
        (hST.liftFromProjective φ hφ)
      have h2 : hST.liftFromProjective φ hφ ≫
          (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map S.f = φ :=
        hST.liftFromProjective_comp φ hφ
      rw [h2] at h1
      exact ((Equiv.apply_symm_apply _ x).symm.trans h1).symm

  obtain ⟨Θ, hΘlin, hΘnat⟩ := wc_proet_corep_ext_hm_linear_natural X ℓ Pf Pm ev hnat hpre
  obtain ⟨Λ, hΛlin, hΛnat⟩ := wc_proet_push_homology_sections_ext g ℓ Dg I q Pf Pm ev hnat hpre
    hadd (fun W hW => (hs2 W hW).1) (fun W hW => (hs2 W hW).2)
  refine ⟨fun W hW => (Λ W hW).trans (Θ q ((wcProEtBC g).obj W)), ?_, ?_⟩
  ·
    intro W hW r h
    refine (congrArg (Θ q ((wcProEtBC g).obj W)) (hΛlin W hW r h)).trans ?_
    refine (hΘlin q ((wcProEtBC g).obj W) _ (Λ W hW h)).trans ?_
    have e1 : ((Dg.φ.hom.app (Opposite.op W)).hom r :
        C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])) =
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from r).comp (Limits.pullback.fst W.hom g).base.hom :=
      hDg W r
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback W.hom g) ℓ)) :=
      HasExt.standard _
    exact congrArg (fun t => (Abelian.Ext.mk₀ (wcHMFun (Limits.pullback W.hom g) ℓ t)).comp
      (Θ q ((wcProEtBC g).obj W) (Λ W hW h)) (zero_add q)) e1
  ·
    intro W W' hW hW' b p hp1 hp2 Db hDb h
    have hpb : p = ((wcProEtBC g).map b).left := by
      apply Limits.pullback.hom_ext
      · rw [hp1]
        first
          | exact (Limits.pullback.lift_fst _ _ _).symm
          | simp [wcProEtBC, MorphismProperty.Over.pullback_map_left]
      · rw [hp2]
        first
          | exact (Limits.pullback.lift_snd _ _ _).symm
          | simp [wcProEtBC, MorphismProperty.Over.pullback_map_left]
    subst hpb
    exact (congrArg (Θ q ((wcProEtBC g).obj W')) (hΛnat W W' hW hW' b h)).trans
      (hΘnat q _ _ ((wcProEtBC g).map b) Db hDb _)

theorem wc_pmn_shs_lc_wcontr (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S]
    [ExtremallyDisconnected S] :
    IsAffine (Spec (.of (LocallyConstant S B))) ∧
      IsClosed {z : Spec (.of (LocallyConstant S B)) | IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))} ∧
      (∀ z : Spec (.of (LocallyConstant S B)), ∃! w : Spec (.of (LocallyConstant S B)),
        IsClosed ({w} : Set (Spec (.of (LocallyConstant S B)))) ∧ z ⤳ w) ∧
      ExtremallyDisconnected {z : Spec (.of (LocallyConstant S B)) | IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))} ∧
      (∀ z : Spec (.of (LocallyConstant S B)), IsClosed ({z} : Set (Spec (.of (LocallyConstant S B)))) →
        HenselianLocalRing ((Spec (.of (LocallyConstant S B))).presheaf.stalk z) ∧
        IsSepClosed ((Spec (.of (LocallyConstant S B))).residueField z)) :=
by
  classical
  haveI := wc_ppu_lc_henselian B S
  have hK8 := And.intro wc_henselian_sepClosed_transfer.{u}.2 wc_henselian_sepClosed_transfer.{u}.1

  let Φ : LocallyConstant S B →+* LocallyConstant S (IsLocalRing.ResidueField B) :=
    LocallyConstant.mapRingHom (IsLocalRing.residue B)
  have hsurj : Function.Surjective Φ := by
    intro g
    refine ⟨g.map (Function.surjInv (IsLocalRing.residue_surjective (R := B))), ?_⟩
    ext s
    show IsLocalRing.residue B (Function.surjInv (IsLocalRing.residue_surjective (R := B)) (g s)) = g s
    exact Function.surjInv_eq _ _
  have hker : Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B)
      (IsLocalRing.maximalIdeal B) = RingHom.ker Φ := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker]
      ext s
      show IsLocalRing.residue B m = 0
      exact (IsLocalRing.residue_eq_zero_iff m).mpr hm
    · intro f hf
      rw [RingHom.mem_ker] at hf
      have hval : ∀ s, f s ∈ IsLocalRing.maximalIdeal B := by
        intro s
        have := congrArg (fun g : LocallyConstant S (IsLocalRing.ResidueField B) => g s) hf
        exact (IsLocalRing.residue_eq_zero_iff (f s)).mp this
      set T := (LocallyConstant.range_finite f).toFinset with hT
      have hid : f = ∑ b ∈ T, LocallyConstant.constRingHom b *
          LocallyConstant.charFn B (IsLocallyConstant.isClopen_fiber f.isLocallyConstant b) := by
        ext s
        have hsum : ∀ (t : Finset B) (g : B → LocallyConstant S B),
            (∑ b ∈ t, g b) s = ∑ b ∈ t, g b s := by
          intro t g
          induction t using Finset.induction_on with
          | empty => simp
          | insert a t ha ih =>
            rw [Finset.sum_insert ha, Finset.sum_insert ha, ← ih]
            rfl
        rw [hsum, Finset.sum_eq_single (f s)]
        · simp [LocallyConstant.coe_charFn, Set.indicator_apply]
        · intro b _ hb
          have hb' : f s ≠ b := fun h => hb h.symm
          simp [LocallyConstant.coe_charFn, Set.indicator_apply, hb']
        · intro h
          exact absurd (by rw [hT, Set.Finite.mem_toFinset]; exact Set.mem_range_self s) h
      rw [hid]
      apply Ideal.sum_mem
      intro b hb
      apply Ideal.mul_mem_right
      apply Ideal.mem_map_of_mem
      rw [hT, Set.Finite.mem_toFinset] at hb
      obtain ⟨s, rfl⟩ := hb
      exact hval s
  let σ := (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  exact wc_hte_wcontr_of_henselian_quotient _ _ hK8
    (wc_hte_wcontr_of_iso _ _ (Scheme.Spec.mapIso σ.toCommRingCatIso.op) hK8
      (wc_ppu_lc_field_wcontr (IsLocalRing.ResidueField B) S))

theorem wc_pmn_shs_lc_stalk_iso (B : Type u) [CommRing B] [IsLocalRing B]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S]
    (z : Spec (.of (LocallyConstant S B))) (hz : IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))) :
    IsIso ((Spec (.of (LocallyConstant S B))).fromSpecStalk z ≫
      Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B))) :=
by
  classical
  have hmax : z.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal z).mp hz

  have s1 : ∃ s : S, ∀ f : LocallyConstant S B,
      f ∈ z.asIdeal ↔ f s ∈ IsLocalRing.maximalIdeal B := by
    have ha : ∃ s : S, ∀ f ∈ z.asIdeal, f s ∈ IsLocalRing.maximalIdeal B := by
      by_contra hcon
      push_neg at hcon
      choose f hfq hfs using hcon
      have hu : ∀ s, IsUnit (f s s) := fun s => IsLocalRing.notMem_maximalIdeal.mp (hfs s)
      let e : S → LocallyConstant S B := fun s =>
        LocallyConstant.const S (Ring.inverse (f s s)) * f s
      have heq : ∀ s, e s ∈ z.asIdeal := fun s => z.asIdeal.mul_mem_left _ (hfq s)
      let U : S → Set S := fun s => {t | f s t = f s s}
      have hUo : ∀ s, IsOpen (U s) := fun s =>
        (IsLocallyConstant.isClopen_fiber (f s).isLocallyConstant (f s s)).isOpen
      have he1 : ∀ s, ∀ t ∈ U s, e s t = 1 := by
        intro s t ht
        have ht' : f s t = f s s := ht
        show Ring.inverse (f s s) * f s t = 1
        rw [ht']
        exact Ring.inverse_mul_cancel _ (hu s)
      obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover U hUo
        (fun t _ => Set.mem_iUnion.2 ⟨t, show f t t = f t t from rfl⟩)
      have hP : ∏ s ∈ T, (1 - e s) = 0 := by
        ext t
        obtain ⟨s₀, hs₀T, hts₀⟩ : ∃ s₀ ∈ T, t ∈ U s₀ := by
          have := hT (Set.mem_univ t)
          simpa using this
        change LocallyConstant.evalRingHom t (∏ s ∈ T, (1 - e s)) =
          LocallyConstant.evalRingHom t 0
        rw [map_prod, map_zero]
        apply Finset.prod_eq_zero hs₀T
        rw [map_sub, map_one]
        show 1 - e s₀ t = 0
        rw [he1 s₀ t hts₀, sub_self]
      have hPq : ∏ s ∈ T, (1 - e s) ∈ z.asIdeal := hP ▸ z.asIdeal.zero_mem
      haveI := hmax.isPrime
      obtain ⟨s, _, hs⟩ := Ideal.IsPrime.prod_mem_iff.mp hPq
      have h1 : (1 : LocallyConstant S B) ∈ z.asIdeal := by
        have := z.asIdeal.add_mem hs (heq s)
        simpa using this
      exact hmax.ne_top ((Ideal.eq_top_iff_one z.asIdeal).mpr h1)
    obtain ⟨s, hs⟩ := ha
    let M := Ideal.comap (LocallyConstant.evalRingHom s) (IsLocalRing.maximalIdeal B)
    have hMne : M ≠ ⊤ := by
      intro h
      have h1 : (1 : LocallyConstant S B) ∈ M := h ▸ Submodule.mem_top
      have h2 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by simpa [M] using h1
      exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    have hle : z.asIdeal ≤ M := fun f hf => by simpa [M] using hs f hf
    have hqM := hmax.eq_of_le hMne hle
    refine ⟨s, fun f => ?_⟩
    rw [hqM]
    simp [M]
  obtain ⟨s, hs⟩ := s1
  letI : Algebra (LocallyConstant S B)
      ((Spec.structureSheaf (LocallyConstant S B)).presheaf.stalk z) :=
    StructureSheaf.stalkAlgebra _ z
  haveI hloc := StructureSheaf.IsLocalization.to_stalk (LocallyConstant S B) z
  haveI := z.isPrime

  have hbij : Function.Bijective ((algebraMap (LocallyConstant S B)
      ((Spec.structureSheaf (LocallyConstant S B)).presheaf.stalk z)).comp
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) := by
    have g0 : ∀ c : LocallyConstant S B, c ∈ z.asIdeal.primeCompl ↔ IsUnit (c s) := by
      intro c
      rw [Ideal.mem_primeCompl_iff, hs, IsLocalRing.notMem_maximalIdeal]
    have g1 : ∀ f g : LocallyConstant S B, f s = g s →
        algebraMap (LocallyConstant S B)
          ((Spec.structureSheaf (LocallyConstant S B)).presheaf.stalk z) f =
        algebraMap (LocallyConstant S B)
          ((Spec.structureSheaf (LocallyConstant S B)).presheaf.stalk z) g := by
      intro f g hfg
      have hU : IsClopen ({t | f t = f s} ∩ {t | g t = g s}) :=
        (IsLocallyConstant.isClopen_fiber f.isLocallyConstant (f s)).inter
          (IsLocallyConstant.isClopen_fiber g.isLocallyConstant (g s))
      have hsU : s ∈ ({t | f t = f s} ∩ {t | g t = g s}) := ⟨rfl, rfl⟩
      have hχs : LocallyConstant.charFn B hU s = 1 := by
        rw [LocallyConstant.coe_charFn, Set.indicator_of_mem hsU]
        rfl
      have hχ : LocallyConstant.charFn B hU ∈ z.asIdeal.primeCompl :=
        (g0 _).mpr (by rw [hχs]; exact isUnit_one)
      rw [IsLocalization.eq_iff_exists z.asIdeal.primeCompl]
      refine ⟨⟨_, hχ⟩, ?_⟩
      ext t
      simp only [LocallyConstant.mul_apply]
      by_cases ht : t ∈ ({t | f t = f s} ∩ {t | g t = g s})
      · have h1 : f t = f s := ht.1
        have h2 : g t = g s := ht.2
        rw [show f t = g t from h1.trans (hfg.trans h2.symm)]
      · rw [LocallyConstant.coe_charFn, Set.indicator_of_notMem ht, zero_mul, zero_mul]
    constructor
    · rw [injective_iff_map_eq_zero]
      intro b hb
      obtain ⟨⟨c, hc⟩, hcb⟩ :=
        (IsLocalization.map_eq_zero_iff z.asIdeal.primeCompl _
          (LocallyConstant.constRingHom b)).mp hb
      have h0 : c s * b = 0 := by
        have := congrArg (fun F : LocallyConstant S B => F s) hcb
        simpa using this
      exact ((g0 c).mp hc).mul_right_eq_zero.mp h0
    · intro a
      obtain ⟨⟨f, c⟩, rfl⟩ := IsLocalization.mk'_surjective z.asIdeal.primeCompl a
      have hcu := (g0 c.1).mp c.2
      refine ⟨f s * Ring.inverse (c.1 s), ?_⟩
      rw [RingHom.comp_apply, eq_comm, IsLocalization.mk'_eq_iff_eq_mul, ← map_mul]
      apply g1
      have : ((LocallyConstant.constRingHom (f s * Ring.inverse (c.1 s)) * c.1 :
          LocallyConstant S B)) s = f s * Ring.inverse (c.1 s) * c.1 s := rfl
      rw [this, mul_assoc, Ring.inverse_mul_cancel _ hcu, mul_one]

  have key : IsIso (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B) ≫
        StructureSheaf.toStalk (LocallyConstant S B) z)) := by
    rw [isIso_SpecMap_iff, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hbij
  rw [Spec.map_comp] at key
  rw [Spec.fromSpecStalk_eq']
  exact key

theorem wc_pmn_shs_fib_qcqs (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] (e : V.left ≅ Spec (.of A))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [CommRing L] (eE : E.left ≅ Spec (.of L))
    (B : Type u) [CommRing B] (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left) :
    CompactSpace ↥(Limits.pullback (C := Scheme.{u}) a' ((wcProEtPullback D.f).map a₀).left) ∧
    QuasiSeparatedSpace ↥(Limits.pullback (C := Scheme.{u}) a' ((wcProEtPullback D.f).map a₀).left) ∧
    QuasiCompact (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) ∧
    QuasiSeparated (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) :=
by
  have hX : ∀ (V₀ : (wcP1Over F'').left.ProEt) (A₀ : Type u) [CommRing A₀]
      (_e₀ : V₀.left ≅ Spec (.of A₀)),
      CompactSpace ((wcProEtPullback D.f).obj V₀).left ∧
        QuasiSeparatedSpace ((wcProEtPullback D.f).obj V₀).left := by
    intro V₀ A₀ _ e₀
    haveI := D.proper
    haveI hpsep : IsSeparated (wcP1Over F'').hom := by
      show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
      infer_instance
    haveI : QuasiCompact (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI : QuasiSeparated (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI : QuasiCompact D.f := QuasiCompact.of_comp D.f (wcP1Over F'').hom
    haveI : QuasiSeparated D.f := QuasiSeparated.of_comp D.f (wcP1Over F'').hom
    haveI hV1 : CompactSpace V₀.left := QuasiCompact.compactSpace_of_compactSpace e₀.hom
    haveI hV2 : QuasiSeparatedSpace V₀.left := quasiSeparatedSpace_of_quasiSeparated e₀.hom
    have hfst1 : QuasiCompact (Limits.pullback.fst V₀.hom D.f) := by
      first
      | exact MorphismProperty.pullback_fst (P := @QuasiCompact) _ _ (inferInstanceAs (QuasiCompact D.f))
      | infer_instance
    have hfst2 : QuasiSeparated (Limits.pullback.fst V₀.hom D.f) := by
      first
      | exact MorphismProperty.pullback_fst (P := @QuasiSeparated) _ _
          (inferInstanceAs (QuasiSeparated D.f))
      | infer_instance
    have key : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), QuasiCompact g → QuasiSeparated g →
        CompactSpace Y → QuasiSeparatedSpace Y → CompactSpace X ∧ QuasiSeparatedSpace X :=
      fun g _ _ _ _ => ⟨QuasiCompact.compactSpace_of_compactSpace g,
        quasiSeparatedSpace_of_quasiSeparated g⟩
    obtain ⟨h1, h2⟩ := key (Limits.pullback.fst V₀.hom D.f) hfst1 hfst2 hV1 hV2
    exact ⟨h1, h2⟩
  obtain ⟨hVc, hVs⟩ := hX V A e
  obtain ⟨hEc, hEs⟩ := hX E L eE
  haveI : QuasiCompact ((wcProEtPullback D.f).map a₀).left :=
    @quasiCompact_of_compactSpace _ _ _ hEc hVs
  haveI : QuasiSeparated ((wcProEtPullback D.f).map a₀).left :=
    @QuasiSeparated.of_quasiSeparatedSpace _ _ _ hEs
  exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst a' _),
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst a' _), inferInstance, inferInstance⟩

theorem wc_pmn_shs_fib_zmod_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') (i : Fin D.m) (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)) (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L] (eE : E.left ≅ Spec (.of L)) (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) (x : ((wcProEtPullback D.f).obj V).left) (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A)) (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F'')) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x)) (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left)) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left) (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ k) j) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  have htors : ∀ (Z : Scheme.{u}) (m q : ℕ) (y : wcEtZModExt Z m q), m • y = 0 := by
    intro Z m q y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have hsm : ∀ (c : ℕ) X (s : (SheafOfModules.unit (wcEtZModRing Z m)).val.obj X),
        ((c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m))).val.app X).hom s = c • s := by
      intro c X s
      induction c with
      | zero =>
        rw [zero_smul, zero_smul]
        have h00 : ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s =
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s +
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s := by
          conv_lhs => rw [← add_zero (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
            SheafOfModules.unit (wcEtZModRing Z m))]
          rw [SheafOfModules.add_val, PresheafOfModules.add_app]
          rfl
        exact add_left_cancel (h00.symm.trans (add_zero _).symm)
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app]
        rw [ModuleCat.hom_add, LinearMap.add_apply, ih]
        rfl
    obtain ⟨-, -, -, hm⟩ := wc_et_zmod_ring_locbij Z m
    have hmU : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      rw [hsm m X s, show (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
          SheafOfModules.unit (wcEtZModRing Z m)) =
          0 • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) from (zero_smul _ _).symm, hsm 0 X s,
        zero_smul, ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Z m).obj.obj X), hm X, zero_smul]
    have hcomp : ∀ c : ℕ, y.comp (Abelian.Ext.mk₀ (c • 𝟙 (SheafOfModules.unit
        (wcEtZModRing Z m)))) (add_zero q) = c • y := by
      intro c
      induction c with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id]
    rw [← hcomp m, hmU, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have s2 : ∀ {P Yt Vl El Sb Sb0 Ac' T Lsp : Scheme.{u}} (XV XE : Scheme.{u}) (f : Yt ⟶ P)
      (v : Vl ⟶ P) (eh : El ⟶ P) (e' : El ⟶ Vl), e' ≫ v = eh →
      ∀ (pv : XV ⟶ Vl) (qv : XV ⟶ Yt), IsPullback pv qv v f →
      ∀ (pe : XE ⟶ El) (qe : XE ⟶ Yt), IsPullback pe qe eh f →
      ∀ (ã : XE ⟶ XV), ã ≫ pv = pe ≫ e' → ã ≫ qv = qe →
      ∀ (a' : Sb ⟶ XV) (γ : Vl ≅ Ac') (θ : Sb ≅ Sb0) (c : Sb0 ⟶ Ac'),
      θ.hom ≫ c = a' ≫ pv ≫ γ.hom →
      ∀ (τ : T ⟶ El) (ε : El ≅ Lsp) (σ : T ⟶ Lsp), τ ≫ ε.hom = σ →
      ∃ g : Limits.pullback c (τ ≫ e' ≫ γ.hom) ⟶ Limits.pullback a' ã,
        IsPullback g (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom))
          (Limits.pullback.snd a' ã ≫ pe ≫ ε.hom) σ := by
    intro P Yt Vl El Sb Sb0 Ac' T Lsp XV XE f v eh e' he pv qv hVp pe qe hEp ã hã1 hã2 a' γ θ c
      hc τ ε σ hσ
    have right : IsPullback qv pv f v := hVp.flip
    have big : IsPullback (ã ≫ qv) pe f (e' ≫ v) := by rw [hã2, he]; exact hEp.flip
    have Qa : IsPullback ã pe pv e' := IsPullback.of_right big hã1 right
    have QF : IsPullback (Limits.pullback.fst a' ã) (Limits.pullback.snd a' ã ≫ pe) (a' ≫ pv) e' :=
      (IsPullback.of_hasPullback a' ã).paste_vert Qa
    have BIG : IsPullback (Limits.pullback.fst c (τ ≫ e' ≫ γ.hom) ≫ θ.inv)
        (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom)) (a' ≫ pv) (τ ≫ e') := by
      refine IsPullback.of_iso (IsPullback.of_hasPullback c (τ ≫ e' ≫ γ.hom)) (Iso.refl _) θ.symm
        (Iso.refl _) γ.symm ?_ ?_ ?_ ?_
      · simp
      · simp
      · simp only [Iso.symm_hom]
        rw [Iso.eq_inv_comp, ← Category.assoc, hc]
        simp
      · simp
    have w' : (Limits.pullback.fst c (τ ≫ e' ≫ γ.hom) ≫ θ.inv) ≫ (a' ≫ pv) =
        (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom) ≫ τ) ≫ e' := by
      rw [Category.assoc (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom))]
      exact BIG.toCommSq.w
    refine ⟨QF.lift _ _ w', ?_⟩
    have hg1 := QF.lift_fst _ _ w'
    have hg2 := QF.lift_snd _ _ w'
    have big2 : IsPullback (QF.lift _ _ w' ≫ Limits.pullback.fst a' ã)
        (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom)) (a' ≫ pv) (τ ≫ e') := by
      rw [hg1]; exact BIG
    have S1 := IsPullback.of_right big2 hg2 QF
    have Q4 : IsPullback τ (𝟙 T) ε.hom σ :=
      IsPullback.of_vert_isIso ⟨by rw [Category.id_comp]; exact hσ⟩
    have h := S1.paste_vert Q4
    rwa [Category.comp_id, Category.assoc] at h

  obtain ⟨hcV, hqV, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V A e
  obtain ⟨hcE, hqE, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D E L eE
  haveI := hcV
  haveI := hqV
  haveI := hcE
  haveI := hqE
  haveI : QuasiCompact a' := (quasiCompact_iff_compactSpace a').mpr inferInstance
  haveI : QuasiSeparated a' := QuasiSeparated.of_quasiSeparatedSpace a'
  haveI hcF : CompactSpace
      ↥(Limits.pullback a' ((wcProEtPullback D.f).map a₀).left : Scheme.{u}) := inferInstance
  haveI hqF : QuasiSeparatedSpace
      ↥(Limits.pullback a' ((wcProEtPullback D.f).map a₀).left : Scheme.{u}) :=
    quasiSeparatedSpace_of_quasiSeparated
      (Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left)

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨Ac, _, _, _, Λ, _, _, W', φ, ac, eA, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (D.S i (IsLocalRing.closedPoint F''))
  have hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) Ac Λ W' φ ac := by
    unfold wcHalShData
    exact ⟨hI, haff, hcomp, hφa, hlim, eA, hint, heq⟩
  have hres : ∀ w : Spec (.of (IsLocalRing.ResidueField Ac)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue Ac)) w = IsLocalRing.closedPoint Ac := by
    intro w
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue Ac))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField Ac)) w _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue Ac)).mp inferInstance)
  have hacl : ac (IsLocalRing.closedPoint Ac) = D.S i (IsLocalRing.closedPoint F'') := by
    have key : ∀ x₀ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField
        (D.S i (IsLocalRing.closedPoint F''))))),
        ac (IsLocalRing.closedPoint Ac) = D.S i (IsLocalRing.closedPoint F'') := by
      intro x₀
      have h1 : (Spec.map (CommRingCat.ofHom eA) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue Ac)) ≫ ac) x₀ =
          (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))) x₀ := by
        rw [heq]
      simp only [Scheme.Hom.comp_apply, wcEtGeomPt, hres] at h1
      exact h1.trans (Scheme.fromSpecResidueField_apply _ _)
    exact key (IsLocalRing.closedPoint _)
