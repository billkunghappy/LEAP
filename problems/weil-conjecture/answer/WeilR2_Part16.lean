      ⟨Function.surjInv hπs, Function.surjInv_eq hπs⟩
    have hKe : ∀ a b, ((K.homologyπ q).val.app (Opposite.op W)).hom a =
        ((K.homologyπ q).val.app (Opposite.op W)).hom b → c a = c b := by
      intro a b hab
      have h1 : ((K.homologyπ q).val.app (Opposite.op W)).hom (a - b) = 0 := by
