by
  intro Zsl Zm Ψ x
  haveI hc : (wcSliceToOver (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)).IsContinuous
      (Scheme.ProEt.topology (wcGeomPoint F'' (wcP1Over F'') hP).left)
      ((Scheme.ProEt.topology (wcP1Over F'').left).over (wcGeomPoint F'' (wcP1Over F'') hP)) :=
    (wc_slice_over_sites_cont (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)).1
  haveI hε : (wcEtToProEt (wcGeomPoint F'' (wcP1Over F'') hP).left).IsContinuous
      (Scheme.smallEtaleTopology (wcGeomPoint F'' (wcP1Over F'') hP).left)
      (Scheme.ProEt.topology (wcGeomPoint F'' (wcP1Over F'') hP).left) :=
    (wc_etToProEt_flat_cont (wcGeomPoint F'' (wcP1Over F'') hP).left).2

  obtain ⟨htors, G₀, ι, hι, hG₀⟩ := wc_qcfin_kernel_embed_classical F'' ℓ hℓ hP m S hS L r hL k
    Ub hUb ℰ e πE hπE hfin het hsurjE hEconn θE Ψ
  haveI := hι

  have hU := wc_qcfin_kernel_counit_iso_on_E F'' ℓ hℓ hP m S hS L r hL k
    Ub hUb ℰ e πE hπE hfin het hsurjE hEconn θE Ψ

  obtain ⟨G, hGt, ⟨φ⟩⟩ := wc_epsInv_classical_of_local (wcGeomPoint F'' (wcP1Over F'') hP).left _ G₀
