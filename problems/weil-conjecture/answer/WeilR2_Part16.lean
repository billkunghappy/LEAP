theorem wc_pmn_tsl_point_self_ext_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∀ k : ℤ, 0 < k →
      ∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)))⟦k⟧,
      f = 0 :=
by

  have final : ∀ {X : Scheme.{u}} (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ)),
      (∀ (j : ℕ) (y : @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) _ _ (HasExt.standard _)
        M M (j + 1)), y = 0) →
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      ∀ k : ℤ, 0 < k →
      ∀ f : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj M) ⟶
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj M))⟦k⟧,
      f = 0 := by
    intro X M hS
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
    intro k hk f
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hk.le
    obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
    haveI hsub : Subsingleton (Abelian.Ext M M (j + 1)) :=
      ⟨fun a b => (hS j a).trans (hS j b).symm⟩
    let eS := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) 0
    let f' : ShiftedHom
        ((DerivedCategory.singleFunctor _ 0).obj M)
        ((DerivedCategory.singleFunctor _ 0).obj M) ((j + 1 : ℕ) : ℤ) :=
      eS.hom.app _ ≫ f ≫ (shiftFunctor _ ((j + 1 : ℕ) : ℤ)).map (eS.inv.app _)
    have hf' : f' = 0 := by
      haveI : Subsingleton (ShiftedHom
          ((DerivedCategory.singleFunctor _ 0).obj M)
          ((DerivedCategory.singleFunctor _ 0).obj M) ((j + 1 : ℕ) : ℤ)) :=
        (Abelian.Ext.homEquiv (C := SheafOfModules.{u+1} (wcRingSheaf X ℓ))).symm.subsingleton
      exact Subsingleton.elim _ _
    have hf : f = eS.inv.app _ ≫ f' ≫ (shiftFunctor _ ((j + 1 : ℕ) : ℤ)).map (eS.hom.app _) := by
      simp only [f', Category.assoc, Iso.inv_hom_id_app_assoc, ← Functor.map_comp,
        Iso.inv_hom_id_app]
      exact (Category.comp_id f).symm.trans
        (congrArg (fun t => f ≫ t) (CategoryTheory.Functor.map_id _ _).symm)
    rw [hf, hf', Limits.zero_comp, Limits.comp_zero]

  have core : ∀ {Xc : Scheme.{u}} (Ω : Type u) [Field Ω] [IsSepClosed Ω]
      (xb : Spec (.of Ω) ⟶ Xc) (Dc : wcHMPullData xb ℓ)
      (P : SheafOfModules.{u+1} (wcRingSheaf Xc ℓ))
      (ε : Dc.Φ.obj P ≅ SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ)) (j : ℕ)
      (y : @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf Xc ℓ)) _ _ (HasExt.standard _)
        P (wcSuppObj Dc) (j + 1)), y = 0 := by
    classical
    intro Xc Ω _ _ xb Dc P ε j
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Xc ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec (.of Ω)) ℓ)) := HasExt.standard _

    have s1 : ∀ (B : Type u) [CommRing B] [Algebra Ω B], Algebra.WeaklyEtale Ω B →
        (∀ f : B, ∃ s : B, f * f * s = f) ∧
        ∀ (R : Type u) [CommRing R] [IsLocalRing R] [Algebra B R] (M : Submonoid B),
          IsLocalization M R → IsSepClosed (IsLocalRing.ResidueField R) := by
      intro B _ _ hB
      have hΩsc : IsSepClosed (IsLocalRing.ResidueField Ω) :=
        wc_henselian_sepClosed_transfer.2 Ω _ (RingEquiv.ofBijective (IsLocalRing.residue Ω)
          ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩) inferInstance
      have key : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [Algebra B R] (M : Submonoid B),
