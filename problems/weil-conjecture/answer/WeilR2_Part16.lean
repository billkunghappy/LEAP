  haveI hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  have hdim : topologicalKrullDim (wcGeomPoint F'' (wcP1Over F'') hP).left ≤
      ((1 : ℕ) : WithBot ℕ∞) := le_of_eq (wc_P1bar_facts F'' hP).2
  haveI hf : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  obtain ⟨f, hfdef⟩ : ∃ f : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      Spec (.of (AlgebraicClosure F'')), f = Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := ⟨_, rfl⟩
  haveI hf' : IsProper f := by rw [hfdef]; exact hf
  have key := wc_et_cd_proper_torsion (AlgebraicClosure F'') (wcGeomPoint F'' (wcP1Over F'') hP).left
    f 1 hdim (ℓ ^ r) hne G (hGt _ htors) 3 (by norm_num)
  obtain ⟨T2⟩ := wc_proet_etale_comparison_epsInv (AlgebraicClosure F'')
    (wcGeomPoint F'' (wcP1Over F'') hP).left f G 3
  have hE3 : ∀ a : Abelian.Ext (wcFreeSheaf (wcGeomPoint F'' (wcP1Over F'') hP).left
      (Scheme.ProEt.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP).left)))
      ((wcEpsInv (wcGeomPoint F'' (wcP1Over F'') hP).left).obj G) 3, a = 0 := by
    intro a
    exact T2.injective ((key _).trans (key _).symm)
  have hK3 : ∀ a : Abelian.Ext (wcFreeSheaf (wcGeomPoint F'' (wcP1Over F'') hP).left
      (Scheme.ProEt.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP).left)))
      (((wcSliceToOver (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcGeomPoint F'' (wcP1Over F'') hP).left)
          ((Scheme.ProEt.topology (wcP1Over F'').left).over (wcGeomPoint F'' (wcP1Over F'') hP))).obj
          (Limits.kernel Ψ)) 3, a = 0 := by
    intro a
    have h1 : a = (a.comp (Abelian.Ext.mk₀ φ.hom) (add_zero 3)).comp
        (Abelian.Ext.mk₀ φ.inv) (add_zero 3) := by
