theorem wc_pmn_vp_milnor_fibre_conn (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (Vt : ((wcProEtPullback D.f).obj V).left.ProEt) (w : Vt.left)
    (hw : IsClosed ({w} : Set Vt.left))
    (hhen : HenselianLocalRing (Vt.left.presheaf.stalk w))
    (hsep : IsSepClosed (Vt.left.residueField w))
    (hz : Vt.hom w ∈ Set.range
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) :
    ConnectedSpace ↥(Limits.pullback (Vt.left.fromSpecStalk w ≫ Vt.hom)
      ((wcProEtPullback D.f).map a₀).left) :=
by
  classical

  haveI hloc : IsLocalRing (Vt.left.presheaf.stalk w) := hhen.toIsLocalRing
  haveI : HenselianLocalRing (Vt.left.presheaf.stalk w) := hhen
  haveI hsepR : IsSepClosed (IsLocalRing.ResidueField (Vt.left.presheaf.stalk w)) := hsep
  have hc0 : (Vt.left.fromSpecStalk w ≫ Vt.hom)
      (IsLocalRing.closedPoint (Vt.left.presheaf.stalk w)) = Vt.hom w := by
    have h := Scheme.Hom.comp_apply (Vt.left.fromSpecStalk w) Vt.hom
      (IsLocalRing.closedPoint (Vt.left.presheaf.stalk w))
    exact h.trans (congrArg Vt.hom Scheme.fromSpecStalk_closedPoint)
  have hWc : WeaklyEtale (Vt.left.fromSpecStalk w ≫ Vt.hom) := by
    haveI := wc_fromSpecStalk_weaklyEtale Vt.left w
    haveI : WeaklyEtale Vt.hom := Vt.prop
    infer_instance

  have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (p : Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p = IsLocalRing.closedPoint R := by
    intro R _ _ p
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue R))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField R)) p _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue R)).mp inferInstance)
  have hinv : ∀ p, e.inv (e.hom p) = p := by
    intro p
    rw [← Scheme.Hom.comp_apply, e.hom_inv_id]
    rfl
  obtain ⟨xs, hxs⟩ := hz
  have hz₁ : Limits.pullback.fst V.hom D.f (Vt.hom w) = e.inv (IsLocalRing.closedPoint A) := by
    have h1 := Scheme.Hom.comp_apply
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (Limits.pullback.fst V.hom D.f ≫ e.hom) xs
    have h2 := Scheme.Hom.comp_apply
      (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (wcQmSp A) xs
    have h3 := Scheme.Hom.comp_apply (Limits.pullback.fst V.hom D.f) e.hom (Vt.hom w)
    have hcond := Limits.pullback.condition (f := Limits.pullback.fst V.hom D.f ≫ e.hom)
      (g := wcQmSp A)
    rw [hcond, h2, hxs, h3] at h1
    have h4 : wcQmSp A (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs)
        = IsLocalRing.closedPoint A := hresG A _
    rw [h4] at h1
    rw [h1, hinv]

  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (Vt.hom w)
  have hsh : wcHalShData (Vt.hom w) B Λ' W'' φ' a' :=
    ⟨hI, haff, hcomp, hφa, hlim, eB, hint, heq⟩

  obtain ⟨ε, -, hε⟩ := @wc_pltr_wet_residue_geom_point _ (Vt.hom w)
    ((Vt.left.presheaf.stalk w)) _ hloc (Vt.left.fromSpecStalk w ≫ Vt.hom) hWc hc0
  have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue (Vt.left.presheaf.stalk w))))
      (IsLocalRing.closedPoint (AlgebraicClosure
        ((((wcProEtPullback D.f).obj V).left).residueField (Vt.hom w)))) =
      IsLocalRing.closedPoint (Vt.left.presheaf.stalk w) :=
    (Scheme.Hom.comp_apply _ _ _).trans (@hresG _ _ hloc _)
  have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue (Vt.left.presheaf.stalk w)))) ≫
      (Vt.left.fromSpecStalk w ≫ Vt.hom) =
      wcEtGeomPt ((wcProEtPullback D.f).obj V).left (Vt.hom w) :=
    (Category.assoc _ _ _).trans hε
  obtain ⟨δ, hδ, -⟩ := @wc_shdata_lift_geom_point _ (Vt.hom w) B _ _ Λ' _ _ W'' φ' a' hsh
    (Vt.left.presheaf.stalk w) _ hhen hsepR (Vt.left.fromSpecStalk w ≫ Vt.hom) _ hq1 hq2

  haveI hδiso : IsIso δ := @wc_pltr_shens_lift_iso _ (Vt.hom w) B _ _ _ Λ' _ _ W'' φ' a' hsh
    (Vt.left.presheaf.stalk w) _ hloc (Vt.left.fromSpecStalk w ≫ Vt.hom) hWc hc0 δ hδ

  have hconn : ConnectedSpace ↥(Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) := by
    by_cases hnode : Limits.pullback.snd V.hom D.f (Vt.hom w) = D.xs i (IsLocalRing.closedPoint F'')
    · exact wc_pmn_vp_mfc_node F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE (Vt.hom w) hz₁
        hnode B Λ' W'' φ' a' hsh
    · exact wc_pmn_vp_mfc_smooth F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE (Vt.hom w) hz₁
        hnode B Λ' W'' φ' a' hsh

  have eq₁ : (Vt.left.fromSpecStalk w ≫ Vt.hom) ≫ 𝟙 _ = δ ≫ a' := by
    rw [Category.comp_id, hδ]
  have eq₂ : ((wcProEtPullback D.f).map a₀).left ≫ 𝟙 _ =
      𝟙 _ ≫ ((wcProEtPullback D.f).map a₀).left := by
    rw [Category.comp_id, Category.id_comp]
  haveI hΦ := Limits.pullback.map_isIso (Vt.left.fromSpecStalk w ≫ Vt.hom)
    ((wcProEtPullback D.f).map a₀).left a' ((wcProEtPullback D.f).map a₀).left δ (𝟙 _) (𝟙 _)
    eq₁ eq₂
  exact @Function.Surjective.connectedSpace _ _ _ hconn _ _
    (Scheme.homeoOfIso (asIso (Limits.pullback.map (Vt.left.fromSpecStalk w ≫ Vt.hom)
      ((wcProEtPullback D.f).map a₀).left a' ((wcProEtPullback D.f).map a₀).left δ (𝟙 _) (𝟙 _)
      eq₁ eq₂)).symm).surjective
    (Scheme.homeoOfIso (asIso (Limits.pullback.map (Vt.left.fromSpecStalk w ≫ Vt.hom)
      ((wcProEtPullback D.f).map a₀).left a' ((wcProEtPullback D.f).map a₀).left δ (𝟙 _) (𝟙 _)
      eq₁ eq₂)).symm).continuous

theorem wc_pmn_vp_unit_restr_iso (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di) :
    IsIso (Di.Φ.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ)) :=
by
  classical
  haveI := Dp.cont
  haveI := Di.cont
  haveI : IsClosedImmersion
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) (IsPullback.of_hasPullback _ _).flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  have hqcV := wc_pencil_nbhd_qcqs F' F'' Y n D V A e
  have hqcE := wc_pencil_nbhd_qcqs F' F'' Y n D E L eE
  haveI : CompactSpace ((wcProEtPullback D.f).obj E).left := hqcE.1
  haveI : QuasiSeparatedSpace ((wcProEtPullback D.f).obj V).left := hqcV.2.1
  haveI hqa : QuasiCompact ((wcProEtPullback D.f).map a₀).left := quasiCompact_of_compactSpace _
  let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
    (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
  let α := (SheafOfModules.toSheaf _).map (Di.Φ.map u)
  haveI hα : IsIso α := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_pmn_vp_thick_cover
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ Di hDi U)
    intro T f hf
    obtain ⟨Vt, κ, hW, hcl, hunit⟩ := hf
    haveI : IsAffine Vt.left := hW.1
    let pr := Limits.pullback.fst Vt.hom ((wcProEtPullback D.f).map a₀).left
    have hu : Function.Bijective ((u.val.app (Opposite.op Vt)).hom) := by
      have hfun : ⇑((u.val.app (Opposite.op Vt)).hom) =
          fun s : C(↥Vt.left, ULift.{u+1} ℚ_[ℓ]) => s.comp pr.base.hom := by
        funext s
        exact (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dp.φ s).trans (hDp Vt s)
      rw [hfun]
      haveI : QuasiCompact pr :=
        MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _).flip hqa
      haveI : CompactSpace ↥((𝟭 Scheme).obj Vt.left) := (inferInstance : CompactSpace Vt.left)
      haveI : CompactSpace ↥(Limits.pullback Vt.hom ((wcProEtPullback D.f).map a₀).left) :=
        QuasiCompact.compactSpace_of_compactSpace pr
      have hfib : ∀ w : ↥Vt.left, IsClosed ({w} : Set ↥Vt.left) →
          _root_.IsPreconnected (pr.base.hom ⁻¹' {y | y ⤳ w}) ∧
          (pr.base.hom ⁻¹' {y | y ⤳ w}).Nonempty := by
        intro w hw
        have hhs := hW.2.2.2.2 w hw
        have hconn := wc_pmn_vp_milnor_fibre_conn F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L
          eE hE Vt w hw hhs.1 hhs.2 (hcl w hw)
        let φiso := Limits.pullbackRightPullbackFstIso Vt.hom
          ((wcProEtPullback D.f).map a₀).left (Vt.left.fromSpecStalk w)
        have hconn2 : ConnectedSpace ↥(Limits.pullback (Vt.left.fromSpecStalk w) pr) :=
          @Function.Surjective.connectedSpace _ _ _ hconn _ _
            (Scheme.homeoOfIso φiso.symm).surjective (Scheme.homeoOfIso φiso.symm).continuous
        have hset : pr.base.hom ⁻¹' {y | y ⤳ w} =
            Set.range (Limits.pullback.snd (Vt.left.fromSpecStalk w) pr) := by
          rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecStalk]
          rfl
        rw [hset]
        have hc := @isConnected_range _ _ _ _ hconn2 _
          (Limits.pullback.snd (Vt.left.fromSpecStalk w) pr).base.hom.continuous
        exact ⟨hc.isPreconnected, hc.nonempty⟩
      exact wc_pmn_vp_wlocal_comp_bij hW.2.1 hW.2.2.1
        (fun z hz O hO hzO => wc_wlocal_clopen_nbhd_in_open Vt.left hW.2.1 hW.2.2.1 z hz O hO hzO)
        pr.base.hom hfib ℓ
    have h2b : Function.Bijective
        ⇑((u ≫ Di.adj.unit.app _).val.app (Opposite.op Vt)).hom := (hunit _).comp hu
    have hb : Function.Bijective
        ⇑(((SheafOfModules.pushforward Di.φ).map (Di.Φ.map u)).val.app (Opposite.op Vt)).hom := by
      refine (Function.Bijective.of_comp_iff _
        (hunit (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)))).mp ?_
      have key := Di.adj.unit_naturality u
      first
        | (rw [key]; exact h2b)
        | (erw [key]; exact h2b)
        | exact (congrArg (fun h : (SheafOfModules.unit
              (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ) ⟶
              (SheafOfModules.pushforward Di.φ).obj (Di.Φ.obj ((SheafOfModules.pushforward Dp.φ).obj
                (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ))))) =>
            Function.Bijective ⇑(h.val.app (Opposite.op Vt)).hom) key).mpr h2b
    have hn := α.hom.naturality κ.hom.op
    have iA := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (Di.Φ.obj (SheafOfModules.unit _))).obj.map κ.hom.op)
    have iB := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (Di.Φ.obj
        ((SheafOfModules.pushforward Dp.φ).obj
            (SheafOfModules.unit _)))).obj.map κ.hom.op)
    have h4 : Function.Bijective (⇑(ConcreteCategory.hom
        (((SheafOfModules.toSheaf _).obj (Di.Φ.obj
          ((SheafOfModules.pushforward Dp.φ).obj
              (SheafOfModules.unit _)))).obj.map κ.hom.op)) ∘
        ⇑(ConcreteCategory.hom (α.hom.app (Opposite.op T)))) := by
      show Function.Bijective ⇑(ConcreteCategory.hom (α.hom.app (Opposite.op T) ≫
        ((SheafOfModules.toSheaf _).obj (Di.Φ.obj
          ((SheafOfModules.pushforward Dp.φ).obj
              (SheafOfModules.unit _)))).obj.map κ.hom.op))
      rw [← hn]
      exact hb.comp iA
    exact (Function.Bijective.of_comp_iff' iB _).mp h4
  exact isIso_of_reflects_iso _ (SheafOfModules.toSheaf _)

theorem wc_pmn_vp_node_point_geom (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x) :
    IsClosed ({xs} : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) ∧
    IsSepClosed ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs) ∧
    IsLocallyNoetherian (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
    ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)),
      Limits.pullback.snd V.hom D.f
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z) =
        D.xs i (IsLocalRing.closedPoint F'') → z = xs :=
by
  classical
  have isoSurj : ∀ {R S : CommRingCat.{u}} (e : R ≅ S), Function.Surjective e.hom.hom :=
    fun e t => ⟨e.inv.hom t, by rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]⟩

  have s1 : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) [SurjectiveOnStalks φ] (x : X),
      Function.Surjective (φ.residueFieldMap x).hom := by
    intro X Y φ _ x
    have h := Scheme.residue_residueFieldMap φ x
    have h2 : (φ.residueFieldMap x).hom ∘ (Y.residue (φ x)).hom =
        (X.residue x).hom ∘ (φ.stalkMap x).hom := by
      funext t
      have := congrArg (fun k => k.hom t) h
      simpa using this
    have h3 : Function.Surjective ((X.residue x).hom ∘ (φ.stalkMap x).hom) :=
      (Scheme.residue_surjective X x).comp (φ.stalkMap_surjective x)
    rw [← h2] at h3
    exact Function.Surjective.of_comp h3

  have s2 : ∀ {V Y P : Scheme.{u}} {K : Type u} [Field K] (g : V ⟶ P) (f : Y ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w w' : ↥(Limits.pullback g f)),
      Limits.pullback.snd g f w = s (IsLocalRing.closedPoint K) →
      Limits.pullback.snd g f w' = s (IsLocalRing.closedPoint K) →
      Limits.pullback.fst g f w = Limits.pullback.fst g f w' → w = w' := by
    intro V Y P K _ g f s _ w w' hw hw' h
    obtain ⟨q, hq1, -⟩ := Scheme.Pullback.exists_preimage_pullback w _ hw
    obtain ⟨q', hq1', -⟩ := Scheme.Pullback.exists_preimage_pullback w' _ hw'
    have hE := Limits.pullbackLeftPullbackSndIso_hom_fst g f s
    have hj : Function.Injective (Limits.pullback.fst g (s ≫ f)) :=
      (Limits.pullback.fst g (s ≫ f)).isClosedEmbedding.isEmbedding.injective
    have e1 : ∀ r, Limits.pullback.fst g (s ≫ f) ((Limits.pullbackLeftPullbackSndIso g f s).hom r)
        = Limits.pullback.fst g f (Limits.pullback.fst (Limits.pullback.snd g f) s r) := by
      intro r
      rw [← Scheme.Hom.comp_apply, hE, Scheme.Hom.comp_apply]
    have h4 : (Limits.pullbackLeftPullbackSndIso g f s).hom q =
        (Limits.pullbackLeftPullbackSndIso g f s).hom q' := hj (by rw [e1, e1, hq1, hq1', h])
    have hqq : q = q' := by
      have := congrArg (Limits.pullbackLeftPullbackSndIso g f s).inv h4
      rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at this
    rw [← hq1, ← hq1', hqq]

  have s3 : ∀ {V Y P : Scheme.{u}} {K : Type u} [Field K] (g : V ⟶ P) (f : Y ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w : ↥(Limits.pullback g f)),
      Limits.pullback.snd g f w = s (IsLocalRing.closedPoint K) →
      Function.Surjective ((Limits.pullback.fst g f).residueFieldMap w).hom := by
    intro V Y P K _ g f s _ w hw
    obtain ⟨q, rfl, -⟩ := Scheme.Pullback.exists_preimage_pullback w _ hw
    have hE : Limits.pullback.fst (Limits.pullback.snd g f) s ≫ Limits.pullback.fst g f =
        (Limits.pullbackLeftPullbackSndIso g f s).hom ≫ Limits.pullback.fst g (s ≫ f) :=
      (Limits.pullbackLeftPullbackSndIso_hom_fst g f s).symm
    have hc := s1 (Limits.pullback.fst g (s ≫ f)) ((Limits.pullbackLeftPullbackSndIso g f s).hom q)
    have hd := s1 (Limits.pullbackLeftPullbackSndIso g f s).hom q
    have hcomp : Function.Surjective
        (((Limits.pullbackLeftPullbackSndIso g f s).hom ≫ Limits.pullback.fst g (s ≫ f)).residueFieldMap q).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hd.comp hc
    have h3 := Scheme.Hom.residueFieldMap_congr hE q
    have hba : Function.Surjective
        ((Limits.pullback.fst (Limits.pullback.snd g f) s ≫ Limits.pullback.fst g f).residueFieldMap q).hom := by
      rw [h3]
      exact hcomp.comp (isoSurj _)
    rw [Scheme.residueFieldMap_comp] at hba
    have hba' : Function.Surjective
        (⇑((Limits.pullback.fst (Limits.pullback.snd g f) s).residueFieldMap q).hom ∘
          ⇑((Limits.pullback.fst g f).residueFieldMap
            ((Limits.pullback.fst (Limits.pullback.snd g f) s) q)).hom) := hba
    intro t
    obtain ⟨r, hr⟩ := hba' (((Limits.pullback.fst (Limits.pullback.snd g f) s).residueFieldMap q).hom t)
    exact ⟨r, ((Limits.pullback.fst (Limits.pullback.snd g f) s).residueFieldMap q).hom.injective hr⟩

  have s4 : ∀ (K : Type u) [Field K] [IsSepClosed K] {X : Scheme.{u}} (σ : X ⟶ Spec (.of K))
      (x : X), Function.Surjective (σ.residueFieldMap x).hom → IsSepClosed (X.residueField x) := by
    intro K _ _ X σ x h
    have hp : σ x = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    let Φ : CommRingCat.of K ⟶ X.residueField x :=
      (stalkClosedPointIso (CommRingCat.of K)).inv ≫
        (Spec (.of K)).residue (IsLocalRing.closedPoint K) ≫
        (Scheme.residueFieldCongr hp).inv ≫ σ.residueFieldMap x
    have hΦ : Function.Surjective Φ.hom := by
      simp only [Φ, CommRingCat.hom_comp]
      refine h.comp (Function.Surjective.comp (isoSurj (Scheme.residueFieldCongr hp).symm)
        ((Scheme.residue_surjective _ _).comp (isoSurj (stalkClosedPointIso (CommRingCat.of K)).symm)))
    letI : Algebra K (X.residueField x) := Φ.hom.toAlgebra
    haveI : Algebra.IsAlgebraic K (X.residueField x) := by
      constructor
      intro y
      obtain ⟨k, rfl⟩ := hΦ y
      exact isAlgebraic_algebraMap (R := K) k
    exact Algebra.IsAlgebraic.isSepClosed (F := K)

  haveI hs : IsClosedImmersion (D.xs i) := isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    (by rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i])
  haveI hsf : IsClosedImmersion (D.xs i ≫ D.f) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.xs i ≫ D.f) (by rw [D.hxs i, D.hS i])

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hiSinj : Function.Injective
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
    (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).isClosedEmbedding.isEmbedding.injective
  have hv : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)),
      Limits.pullback.fst V.hom D.f
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z) =
        e.inv (IsLocalRing.closedPoint A) := by
    intro z
    have hc := congrArg (fun φ => φ z)
      (Limits.pullback.condition (f := Limits.pullback.fst V.hom D.f ≫ e.hom) (g := wcQmSp A))
    simp only [Scheme.Hom.comp_apply] at hc
    have hq : wcQmSp A (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z)
        = IsLocalRing.closedPoint A := by
      show Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) _ = _
      rw [Spec.map_apply, CommRingCat.hom_ofHom]
      exact IsLocalRing.PrimeSpectrum.comap_residue _ _
    rw [hq] at hc
    rw [← hc, Scheme.hom_inv_apply]

  have conj4 : ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)),
      Limits.pullback.snd V.hom D.f
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z) =
        D.xs i (IsLocalRing.closedPoint F'') → z = xs := by
    intro z hz
    have h1 := s2 V.hom D.f (D.xs i) _ x hz hx₂ ((hv z).trans hx₁.symm)
    exact hiSinj (h1.trans hxs.symm)

  have conj1 : IsClosed ({xs} : Set ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) := by
    have hcl : IsClosed (Set.range (D.xs i)) := (D.xs i).isClosedEmbedding.isClosed_range
    have heq : ({xs} : Set ↥(Limits.pullback (C := Scheme.{u})
        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) =
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
          Limits.pullback.snd V.hom D.f) ⁻¹' Set.range (D.xs i) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage, Set.mem_range, Scheme.Hom.comp_apply]
      constructor
      · rintro rfl
        exact ⟨IsLocalRing.closedPoint F'', by rw [hxs, hx₂]⟩
      · rintro ⟨p, hp⟩
        obtain rfl : p = IsLocalRing.closedPoint F'' := Subsingleton.elim _ _
        exact conj4 z hp.symm
    rw [heq]
    exact hcl.preimage (Scheme.Hom.continuous _)

  have conj3 : IsLocallyNoetherian
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) := by
    haveI := D.proper
    haveI : LocallyOfFiniteType (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI := locallyOfFiniteType_of_comp D.f (wcP1Over F'').hom
    exact LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))

  have gen : ∀ {T B : Scheme.{u}} (g : T ⟶ Spec (.of A)) (j : B ⟶ T)
      (σ : B ⟶ Spec (.of (IsLocalRing.ResidueField A))), j ≫ g = σ ≫ wcQmSp A → ∀ b : B,
      Function.Surjective (j.residueFieldMap b).hom →
      Function.Surjective (g.residueFieldMap (j b)).hom →
      Function.Surjective (σ.residueFieldMap b).hom := by
    intro T B g j σ hsq b hj hg
    have hcomp : Function.Surjective ((j ≫ g).residueFieldMap b).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hj.comp hg
    rw [Scheme.Hom.residueFieldMap_congr hsq b] at hcomp
    have hcomp' : Function.Surjective ((σ ≫ wcQmSp A).residueFieldMap b).hom := by
      have : Function.Surjective
          (⇑((σ ≫ wcQmSp A).residueFieldMap b).hom ∘ ⇑(Scheme.residueFieldCongr
            (congrArg (fun φ => φ b) hsq)).hom.hom) := hcomp
      exact Function.Surjective.of_comp this
    rw [Scheme.residueFieldMap_comp] at hcomp'
    have : Function.Surjective
        (⇑(σ.residueFieldMap b).hom ∘ ⇑((wcQmSp A).residueFieldMap (σ b)).hom) := hcomp'
    exact Function.Surjective.of_comp this
  have conj2 : IsSepClosed
      ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs) := by
    have hx₂' : Limits.pullback.snd V.hom D.f
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs) =
        D.xs i (IsLocalRing.closedPoint F'') := by rw [hxs]; exact hx₂
    have a1 := s3 V.hom D.f (D.xs i) _ hx₂'
    have a3 := s1 e.hom (Limits.pullback.fst V.hom D.f
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs))
    have hg : Function.Surjective ((Limits.pullback.fst V.hom D.f ≫ e.hom).residueFieldMap
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs)).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact a1.comp a3
    exact s4 (IsLocalRing.ResidueField A)
      (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs
      (gen (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        Limits.pullback.condition xs
        (s1 (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) hg)
  exact ⟨conj1, conj2, conj3, conj4⟩

theorem wc_proet_free_projective_wcontractible (S : Scheme.{u}) (V : S.ProEt)
    (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))) :
    Projective (wcFreeSheaf S V) :=
by
  classical
  obtain ⟨eF, heF, -⟩ := proet_free_sheaf_hom_equiv S V
  refine ⟨fun {E X} f π _ => ?_⟩
  obtain ⟨V', g, x, hV'a, hsurj, hx⟩ :=
    wc_proet_epi_affine_lift S π inferInstance V hV.1 (eF X f)
  haveI : WeaklyEtale V.hom := V.prop
  haveI : WeaklyEtale (g.left ≫ V.hom) := by
    rw [MorphismProperty.Over.w g]; exact V'.prop
  haveI hWE : WeaklyEtale g.left := WeaklyEtale.of_comp g.left V.hom
  obtain ⟨σ, hσ⟩ := wc_wlocal_strictHensel_retraction V.left hV.1 hV.2.1 hV.2.2.1
    hV.2.2.2.1 hV.2.2.2.2 V'.left g.left hV'a hWE hsurj
  have hcomm : σ ≫ V'.hom = V.hom := by
    rw [← MorphismProperty.Over.w g, ← Category.assoc, hσ, Category.id_comp]
  let s : V ⟶ V' := MorphismProperty.Over.homMk σ hcomm trivial
  have hs : s ≫ g = 𝟙 V := by
    apply MorphismProperty.Over.Hom.ext
    exact hσ
  have h2 : X.obj.map g.op ≫ X.obj.map s.op = 𝟙 _ := by
    rw [← X.obj.map_comp, ← op_comp, hs, op_id, X.obj.map_id]
  have hz : π.hom.app (Opposite.op V) (E.obj.map s.op x) = eF X f := by
    have h1 := NatTrans.naturality_apply π.hom s.op x
    rw [h1, hx]
    first
      | rw [← CategoryTheory.comp_apply, h2, CategoryTheory.id_apply]
      | rw [← ConcreteCategory.comp_apply, h2, ConcreteCategory.id_apply]
      | simp [← CategoryTheory.comp_apply, h2]
  refine ⟨(eF E).symm (E.obj.map s.op x), ?_⟩
  apply (eF X).injective
  rw [heF, Equiv.apply_symm_apply]
  exact hz

theorem wc_proet_pull_isZero_of_local_death {X Z : Scheme.{u}} (k : Z ⟶ X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dk : wcHMPullData k ℓ)
    (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (h : ∀ (W : X.ProEt) (s : N.val.obj (Opposite.op W)),
      ∃ Rs : Sieve ((wcProEtBC k).obj W), Rs ∈ Scheme.ProEt.topology Z ((wcProEtBC k).obj W) ∧
        ∀ (U : Z.ProEt) (e : U ⟶ (wcProEtBC k).obj W), Rs.arrows e →
          ∃ (V₂ : X.ProEt) (c : V₂ ⟶ W) (a : U ⟶ (wcProEtBC k).obj V₂),
            a ≫ (wcProEtBC k).map c = e ∧ (N.val.map c.op).hom s = 0) :
    Limits.IsZero (Dk.Φ.obj N) :=
by
  haveI := Dk.cont
  haveI := Dk.additive
  have key : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
      (f : N ⟶ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC k) _ _
        Dk.cont Dk.φ).obj M), f = 0 := by
    intro M f
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    rintro ⟨W⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro s
    obtain ⟨Rs, hRs, hfac⟩ := h W s
    obtain ⟨t, htdef⟩ : ∃ t : M.val.obj (Opposite.op ((wcProEtBC k).obj W)),
        t = (f.val.app (Opposite.op W)).hom s := ⟨_, rfl⟩
    have ht0 : t = 0 := by
      refine M.isSheaf.isSeparated _ Rs hRs t 0 ?_
      intro U e he
      obtain ⟨V₂, c, a, hae, hc⟩ := hfac U e he
      change (M.val.map e.op).hom t = (M.val.map e.op).hom 0
      rw [map_zero, ← hae, op_comp]
      have hnat := PresheafOfModules.naturality_apply f.val c.op s
      have h2 : (M.val.map ((wcProEtBC k).map c).op).hom t =
          (f.val.app (Opposite.op V₂)).hom ((N.val.map c.op).hom s) := by
        rw [htdef]; exact hnat.symm
      have hu : (M.val.map ((wcProEtBC k).map c).op).hom t = 0 := by
        rw [h2]
        first
          | exact (congrArg (f.val.app (Opposite.op V₂)).hom hc).trans (map_zero _)
          | (rw [hc]; exact map_zero _)
          | (erw [hc]; exact map_zero _)
      have hcomp : (M.val.map (((wcProEtBC k).map c).op ≫ a.op)).hom t =
          (M.val.map a.op).hom ((M.val.map ((wcProEtBC k).map c).op).hom t) := by
        first
          | exact PresheafOfModules.map_comp_apply _ _ _ _
          | exact PresheafOfModules.map_comp_apply _ _ _
          | exact PresheafOfModules.map_comp_apply _ _
          | (erw [PresheafOfModules.map_comp_apply])
          | (rw [PresheafOfModules.map_comp]; rfl)
      rw [hcomp]
      first
        | (rw [hu]; exact map_zero (M.val.map a.op).hom)
        | exact (congrArg (M.val.map a.op).hom hu).trans (map_zero _)
        | (rw [hu]; exact LinearMap.map_zero _)
        | (rw [hu]; rfl)
    have ht : (f.val.app (Opposite.op W)).hom s = 0 := htdef.symm.trans ht0
    rw [ht]
    rfl
  have hη := key _ (Dk.adj.unit.app N)
  rw [Limits.IsZero.iff_id_eq_zero, ← Dk.adj.left_triangle_components N, hη, Functor.map_zero,
    Limits.zero_comp]

theorem wc_proet_closed_open_thickening_sieve {X Z' : Scheme.{u}} (i : Z' ⟶ X)
    [IsClosedImmersion i] (O : Z'.Opens) (U₀ : O.toScheme.ProEt) :
    Sieve.generate (fun (T : O.toScheme.ProEt) (_ : T ⟶ U₀) =>
      ∃ (Vt : X.ProEt) (_ : (wcProEtBC (O.ι ≫ i)).obj Vt ≅ T),
        (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
         (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
         ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
         (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
           HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) ∧
        (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
           x ∈ Set.range (Limits.pullback.fst Vt.hom (O.ι ≫ i))) ∧
        ∀ V : X.ProEt, Function.Surjective (fun c : Vt ⟶ V => (wcProEtBC (O.ι ≫ i)).map c))
      ∈ Scheme.ProEt.topology O.toScheme U₀ :=
by
  classical

  have hce := i.isClosedEmbedding
  let C : Set X := i '' ((O : Set Z')ᶜ)
  have hC : IsClosed C := hce.isClosedMap _ O.isOpen.isClosed_compl
  let U'' : X.Opens := ⟨Cᶜ, hC.isOpen_compl⟩
  have hOmem : ∀ z : O.toScheme, O.ι z ∈ (O : Set Z') := by
    intro z
    have hm : O.ι z ∈ Set.range O.ι := ⟨z, rfl⟩
    rwa [Scheme.Opens.range_ι] at hm
  have hrange : Set.range (O.ι ≫ i) ⊆ Set.range U''.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    show (O.ι ≫ i) z ∉ C
    rintro ⟨w, hw, hwz⟩
    apply hw
    have hwe : w = O.ι z := hce.isEmbedding.injective (by rw [hwz, Scheme.Hom.comp_apply])
    rw [hwe]
    exact hOmem z
  let j : O.toScheme ⟶ U''.toScheme := IsOpenImmersion.lift U''.ι (O.ι ≫ i) hrange
  have hfac : j ≫ U''.ι = O.ι ≫ i := IsOpenImmersion.lift_fac _ _ _
  haveI : IsPreimmersion (j ≫ U''.ι) := by rw [hfac]; infer_instance
  haveI : IsPreimmersion j := IsPreimmersion.of_comp j U''.ι
  have hjrange : Set.range j = U''.ι ⁻¹' Set.range i := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      refine ⟨O.ι z, ?_⟩
      show i (O.ι z) = U''.ι (j z)
      rw [← Scheme.Hom.comp_apply j U''.ι, hfac, Scheme.Hom.comp_apply]
    · rintro ⟨w, hw⟩
      by_cases hwO : w ∈ (O : Set Z')
      · have hwr : w ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hwO
        obtain ⟨z, rfl⟩ := hwr
        refine ⟨z, ?_⟩
        apply U''.ι.isOpenEmbedding.isEmbedding.injective
        rw [← Scheme.Hom.comp_apply j U''.ι, hfac, Scheme.Hom.comp_apply]
        exact hw
      · exfalso
        have hy : U''.ι y ∈ (U'' : Set X) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
        exact hy ⟨w, hwO, hw⟩
  haveI hj : IsClosedImmersion j := IsClosedImmersion.of_isPreimmersion j (by
    rw [hjrange]; exact hce.isClosed_range.preimage U''.ι.continuous)

  have h1 := wc_proet_wcontr_affine_open_cover j U₀
  refine GrothendieckTopology.superset_covering _ ?_ h1
  rw [Sieve.generate_le_iff]
  rintro T f ⟨⟨Oa, hOa, hTO⟩, hT⟩
  apply Sieve.le_generate

  obtain ⟨A, _, I, hH, Vt', e, c, κ, hsq, hVt', -⟩ :=
    wc_proet_henselian_thickening_exists j T Oa hOa hTO hT
  haveI := hH

  have hW : WeaklyEtale (Vt'.hom ≫ U''.ι) := by
    haveI : WeaklyEtale Vt'.hom := Vt'.prop
    haveI : WeaklyEtale U''.ι := by apply etale_le_weaklyEtale; infer_instance
    infer_instance
  let Vt : X.ProEt := MorphismProperty.Over.mk ⊤ (Vt'.hom ≫ U''.ι) hW
  have hP₀ : IsPullback (Limits.pullback.fst Vt'.hom j) (Limits.pullback.snd Vt'.hom j)
      (Vt'.hom ≫ U''.ι) (j ≫ U''.ι) :=
    IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono Vt'.hom j U''.ι)
  rw [hfac] at hP₀
  let ψ := hP₀.isoPullback
  have hψfst : ψ.hom ≫ Limits.pullback.fst Vt.hom (O.ι ≫ i) = Limits.pullback.fst Vt'.hom j :=
    hP₀.isoPullback_hom_fst
  have hψsnd : ψ.inv ≫ Limits.pullback.snd Vt'.hom j = Limits.pullback.snd Vt.hom (O.ι ≫ i) :=
    hP₀.isoPullback_inv_snd
  let φ : (wcProEtBC (O.ι ≫ i)).obj Vt ≅ (wcProEtBaseChange j).obj Vt' :=
    MorphismProperty.Over.isoMk ψ.symm (by
      show ψ.inv ≫ Limits.pullback.snd Vt'.hom j = Limits.pullback.snd Vt.hom (O.ι ≫ i)
      exact hψsnd)
  have hsq' : IsPullback (Limits.pullback.fst Vt.hom (O.ι ≫ i)) (ψ.inv ≫ c) e.hom
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
    refine IsPullback.of_iso hsq ψ (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · exact (Category.comp_id _).trans hψfst.symm
    · exact (Category.comp_id _).trans (Iso.hom_inv_id_assoc _ _).symm
    · exact (Category.comp_id _).trans (Category.id_comp _).symm
    · exact (Category.comp_id _).trans (Category.id_comp _).symm

  have hlift : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [WeaklyEtale f] (a : Spec (.of A) ⟶ S)
      (b : Spec (.of (A ⧸ I)) ⟶ X),
      b ≫ f = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a →
      ∃! σ : Spec (.of A) ⟶ X,
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ = b ∧ σ ≫ f = a := by
    intro X S f _ a b hab
    exact wc_weaklyEtale_henselian_lift f A I a b hab
  have hbij := fun V : X.ProEt =>
    wc_proet_thickening_bc_hom_bijective (O.ι ≫ i) A I Vt e (ψ.inv ≫ c) hsq' hlift V

  have hclosed : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
      x ∈ Set.range (Limits.pullback.fst Vt.hom (O.ι ≫ i)) := by
    intro x hx
    let p : PrimeSpectrum A := e.hom x
    have h1 : IsClosed ({e.hom x} : Set (Spec (.of A))) := by
      have hgen : ∀ {P Q : Scheme.{u}} (e' : P ≅ Q) (x' : P), IsClosed ({x'} : Set P) →
          IsClosed ({e'.hom x'} : Set Q) := by
        intro P Q e' x' hx'
        have := (Scheme.homeoOfIso e').isClosedMap _ hx'
        rwa [Set.image_singleton, Scheme.homeoOfIso_apply] at this
      exact hgen e x hx
    have h2 : p.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mp h1
    have h3 : I ≤ p.asIdeal := by
      refine le_trans HenselianRing.jac ?_
      rw [Ideal.jacobson]
      exact sInf_le ⟨bot_le, h2⟩
    haveI := h2.isPrime
    have hq : (Ideal.map (Ideal.Quotient.mk I) p.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact h3)
    let y : PrimeSpectrum (A ⧸ I) := ⟨_, hq⟩
    have h5 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) y = e.hom x := by
      show PrimeSpectrum.comap (Ideal.Quotient.mk I) y = p
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
