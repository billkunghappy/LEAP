            Scheme.proetaleTopology V.left := by
      intro T V R
      letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
      have hT : Scheme.ProEt.topology T =
          (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
        MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
          (P := @WeaklyEtale) Scheme.proetalePrecoverage
          Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
      rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
        Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
      rfl
    let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
    let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents εapp (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
    have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
        Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology V.left.left := by
      intro V R
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
        ← Sieve.functorPushforward_comp]
    have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
      constructor
      intro W T hT
      rw [hmem U.left W]
      rw [hmemD] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨V', t, a, ht, rfl⟩
      refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
      show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
      have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp t.left.left).symm
      exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
    have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
      constructor
      intro V T hT
      rw [hmemD]
      rw [hmem U.left] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨W', t, a, ht, rfl⟩
      refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
      · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
        have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
          apply MorphismProperty.Over.Hom.ext
          exact Category.comp_id t.left
        exact (congrArg (fun g => T.arrows g) hgt).mpr ht
      · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
    let eqv : U.left.ProEt ≌ Over U :=
      Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
    haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := hFc
    haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := hGc
    haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    exact (inferInstance : eqv.inverse.IsContinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left))

  let eC : wcSliceToOver S U ⋙ wcOverToSlice S U ≅ 𝟭 (U.left.ProEt) :=
    NatIso.ofComponents
      (fun W => MorphismProperty.Over.isoMk (Iso.refl W.left) (Category.id_comp _))
      (fun {W W'} g => by
        apply MorphismProperty.Over.Hom.ext
        show g.left ≫ 𝟙 _ = 𝟙 _ ≫ g.left
        rw [Category.comp_id, Category.id_comp])
  let iV : ∀ V : Over U, (wcSliceFunctor S U).obj ((wcOverToSlice S U).obj V) ≅ V.left :=
    fun V => MorphismProperty.Over.isoMk (Iso.refl V.left.left)
      ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm)
  let eD : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
    NatIso.ofComponents
      (fun V => Over.isoMk (iV V) (by
        apply MorphismProperty.Over.Hom.ext
        show 𝟙 _ ≫ V.hom.left = V.hom.left
        exact Category.id_comp _))
      (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        show g.left.left ≫ 𝟙 _ = 𝟙 _ ≫ g.left.left
        rw [Category.comp_id, Category.id_comp])
  let jT : (wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left)) ≅ U :=
    MorphismProperty.Over.isoMk (Iso.refl U.left) (Category.id_comp _)
  let eT : (wcSliceToOver S U).obj (Scheme.ProEt.mk (𝟙 U.left)) ≅ Over.mk (𝟙 U) :=
    Over.isoMk jT (by
      apply MorphismProperty.Over.Hom.ext
      show 𝟙 U.left ≫ 𝟙 U.left = 𝟙 U.left
      exact Category.id_comp _)

  haveI hc1 : (wcSliceToOver S U ⋙ wcOverToSlice S U).IsContinuous
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology U.left) :=
    Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology S).over U) _
  haveI hc2 : (wcOverToSlice S U ⋙ wcSliceToOver S U).IsContinuous
      ((Scheme.ProEt.topology S).over U) ((Scheme.ProEt.topology S).over U) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology U.left) _
  let P := (wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)
  let Q := (wcOverToSlice S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology U.left)
  let α : Q ⋙ P ≅ 𝟭 _ :=
    Functor.sheafPushforwardContinuousComp (wcSliceToOver S U) (wcOverToSlice S U)
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) ≪≫
      Functor.sheafPushforwardContinuousIso eC AddCommGrpCat.{u+1} _ _ ≪≫
      Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _
  let β : P ⋙ Q ≅ 𝟭 _ :=
    Functor.sheafPushforwardContinuousComp (wcOverToSlice S U) (wcSliceToOver S U)
        AddCommGrpCat.{u+1} ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) ≪≫
      Functor.sheafPushforwardContinuousIso eD AddCommGrpCat.{u+1} _ _ ≪≫
      Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _
  let E := CategoryTheory.Equivalence.mk Q P α.symm β
  let adj : Q ⊣ P := E.toAdjunction
  let adj' : P ⊣ Q := E.symm.toAdjunction
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Q := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Q :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Q
  haveI : Limits.PreservesColimitsOfSize.{0, 0} P := adj'.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits P :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits P
  haveI : Limits.PreservesLimitsOfSize.{0, 0} P := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits P :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits P
  haveI : Limits.PreservesLimitsOfSize.{0, 0} Q := adj'.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits Q :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits Q
  haveI : P.IsRightAdjoint := adj.isRightAdjoint
  haveI : P.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint P
  haveI : P.Additive := Functor.additive_of_preserves_binary_products P
  haveI : Q.Additive := adj.left_adjoint_additive

  have rep : ∀ {E : Type (u+1)} [Category.{u} E] (J'' : GrothendieckTopology E)
      [HasWeakSheafify J'' AddCommGrpCat.{u+1}] (Y : E),
      (sheafToPresheaf J'' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        ((presheafToSheaf J'' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro E _ J'' _ Y
    exact
      { homEquiv := fun {G} =>
          ((sheafificationAdjunction J'' AddCommGrpCat.{u+1}).homEquiv _ G).trans
            (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
        homEquiv_comp := fun {G G'} f g => by
          simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
          rfl }
  have r1 := rep (Scheme.ProEt.topology U.left) (Scheme.ProEt.mk (𝟙 U.left))
  have r2 := rep ((Scheme.ProEt.topology S).over U)
    ((wcSliceToOver S U).obj (Scheme.ProEt.mk (𝟙 U.left)))
  let r3 : (sheafToPresheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} ⋙
        (evaluation (Over U)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op ((wcSliceToOver S U).obj (Scheme.ProEt.mk (𝟙 U.left)))) ⋙
        forget AddCommGrpCat.{u+1}).CorepresentableBy
        (Q.obj ((presheafToSheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Scheme.ProEt.mk (𝟙 U.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free))) :=
    { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
      homEquiv_comp := fun {G G'} f g => by
        show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
        rw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]
        rfl }
  let θ := r3.uniqueUpToIso r2
  let φ : (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
        (yoneda.obj ((wcSliceToOver S U).obj (Scheme.ProEt.mk (𝟙 U.left))) ⋙
          uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
      (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
    (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerRight (yoneda.mapIso eT) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  let ι : (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
      Q.obj (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) := φ.symm ≪≫ θ.symm
  let E₀ : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S).over U)
        AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) M n ≃
      Abelian.Ext (Q.obj (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))) M n :=
    { toFun := fun x => (Abelian.Ext.mk₀ ι.inv).comp x (zero_add n)
      invFun := fun y => (Abelian.Ext.mk₀ ι.hom).comp y (zero_add n)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }
  exact ⟨E₀.trans (adj.extEquiv (X := wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
    (Y := M) (n := n)).toEquiv⟩

theorem wc_epsInv_classical_of_local (Y : Scheme.{u})
    [(wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)]
    (U : Y.Etale) (G₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (hG₀ : ∀ (V : Y.Etale) (x : V.left), V.hom x ∉ Set.range U.hom →
      ∀ g : G₀.obj.obj (Opposite.op V), ∃ (W : Y.Etale) (w : W ⟶ V),
        x ∈ Set.range w.left ∧ (G₀.obj.map w.op).hom g = 0)
    (K : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (ι : K ⟶ (wcEpsInv Y).obj G₀)
    [Mono ι]
    (hU : IsIso (((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1}
      ((wcEtToProEt Y).obj U)).map
        ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).counit.app K))) :
    ∃ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      (∀ n : ℕ, n • 𝟙 K = 0 → n • 𝟙 G = 0) ∧ Nonempty (K ≅ (wcEpsInv Y).obj G) :=
by
  classical
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  let Rf := (wcEtToProEt Y).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)

  haveI : Rf.IsRightAdjoint := adj.isRightAdjoint
  haveI : Limits.PreservesLimits Rf := adj.rightAdjoint_preservesLimits
  haveI : Rf.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rf
  haveI : Rf.Additive := Functor.additive_of_preserves_binary_products Rf
  have htors : ∀ n : ℕ, n • 𝟙 K = 0 → n • 𝟙 (Rf.obj K) = 0 := by
    intro n hn
    rw [← Rf.map_id, ← Functor.map_nsmul, hn, Rf.map_zero]

  have hεG₀ : IsIso (adj.counit.app ((wcEpsInv Y).obj G₀)) := by
    haveI : IsIso (adj.unit.app G₀) := wc_epsInv_unit_iso Y G₀
    have h := adj.left_triangle_components G₀
    haveI : IsIso ((Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).map
        (adj.unit.app G₀)) := Functor.map_isIso _ _
    haveI : IsIso ((Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).map
        (adj.unit.app G₀) ≫ adj.counit.app _) := by
      rw [h]; exact IsIso.id _
    exact IsIso.of_isIso_comp_left ((Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).map
        (adj.unit.app G₀)) (adj.counit.app _)
  have hmono : Mono (adj.counit.app K) := by
    have hnat := adj.counit_naturality ι
    haveI : Mono (Rf.map ι) := Functor.map_mono Rf ι
    have h1 : Mono ((wcEpsInv Y).map (Rf.map ι)) := (wc_epsInv_preserves_mono_epi Y (Rf.map ι)).1 inferInstance
    haveI : Mono (adj.counit.app K ≫ ι) := by
      rw [← hnat]
      exact @mono_comp _ _ _ _ _ _ h1 _ (@IsIso.mono_of_iso _ _ _ _ _ hεG₀)
    exact mono_of_mono (adj.counit.app K) ι

  have hs3 : ∀ (T : Y.ProEt) {X Z : Scheme.{u}} (g : T.left ⟶ Z) (h : X ⟶ Z) [Etale h]
      (w : T.left), g w ∈ Set.range h →
      ∃ (A : Y.ProEt) (e : A ⟶ T) (k : A.left ⟶ X), IsAffine A.left ∧ IsOpenMap e.left ∧
        w ∈ Set.range e.left ∧ e.left ≫ g = k ≫ h := by
    intro T X Z g h _ w hw
    obtain ⟨x, hx⟩ := hw
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := g) (g := h) w x hx.symm
    obtain ⟨O, hO, hzO, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
    haveI : WeaklyEtale T.hom := T.prop
    refine ⟨Scheme.ProEt.mk (O.ι ≫ Limits.pullback.fst g h ≫ T.hom),
      MorphismProperty.Over.homMk (O.ι ≫ Limits.pullback.fst g h) (Category.assoc _ _ _) trivial,
      O.ι ≫ Limits.pullback.snd g h, hO, Scheme.Hom.isOpenMap (O.ι ≫ Limits.pullback.fst g h),
      ?_, ?_⟩
    · have hz' : z ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hzO
      obtain ⟨z', hz'⟩ := hz'
      refine ⟨z', ?_⟩
      show (O.ι ≫ Limits.pullback.fst g h) z' = w
      rw [Scheme.Hom.comp_apply, hz', hz1]
    · show (O.ι ≫ Limits.pullback.fst g h) ≫ g = (O.ι ≫ Limits.pullback.snd g h) ≫ h
      simp only [Category.assoc, Limits.pullback.condition]

  have hrep : ∀ (F : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}) (T : Y.ProEt)
      (x : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op T)),
      ∃ (V₁ : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V₁) (t : F.obj (Opposite.op V₁)),
        x = ((wcEtToProEt Y).op.lan.obj F).map a.op
          (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V₁) t) := by
    intro F T x
    haveI : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
        (Scheme.ProEt.forget Y)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
    haveI : RepresentablyFlat (wcEtToProEt Y) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow T (wcEtToProEt Y)) := RepresentablyFlat.cofiltered T
    haveI hI : IsFiltered (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtToProEt Y) T)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((wcEtToProEt Y).op.leftKanExtension F)
      ((wcEtToProEt Y).op.leftKanExtensionUnit F)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
      (wcEtToProEt Y).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op T)
    obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hc x
    refine ⟨j.left.unop, j.hom.unop, y, ?_⟩
    rw [← hy]
    rfl

  have fin_covers : ∀ (U : Y.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → Y.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology Y U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
