    fun x =>
    (Scheme.Hom.comp_apply _ _ x).symm.trans
      ((congrArg (fun f : Limits.pullback (wcPencilSOpen D).ι
          (wcGeomPoint F'' (wcP1Over F'') hP).hom ⟶ (wcP1Over F'').left => f x)
        Limits.pullback.condition).trans (Scheme.Hom.comp_apply _ _ x))
  have keyW : ∀ x : ↥(Limits.pullback (wcPencilSOpen D).ι W.hom),
      (Limits.pullback.snd (wcPencilSOpen D).ι W.hom ≫ W.hom) x =
        (wcPencilSOpen D).ι (Limits.pullback.fst (wcPencilSOpen D).ι W.hom x) := fun x =>
    (congrArg (fun f : Limits.pullback (wcPencilSOpen D).ι W.hom ⟶ (wcP1Over F'').left => f x)
        Limits.pullback.condition).symm.trans (Scheme.Hom.comp_apply _ _ x)

  have hsurj' : ∀ p : (wcPencilGeomOffS D hP).left, ∃ z : W'.left, w'.left z = p := by
