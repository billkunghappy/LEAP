  obtain ⟨hprop, hconn, -, O', hO', -, hsm'⟩ :=
    wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs
  haveI := hprop
  haveI := hconn
  have hOO : O' = O := TopologicalSpace.Opens.ext (hO'.trans hO.symm)
  haveI : SmoothOfRelativeDimension (n - 1)
      (O.ι ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
    hOO ▸ hsm'
  obtain ⟨Yb, E, fY, hfY, hsmY, iE, hiE, U, hU, ⟨φ⟩⟩ :=
    wc_pmn_odp_fibre_resolution F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs O hO
  haveI := hfY
  haveI := hsmY
  haveI := hiE
  have hOne : (O : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))) ≠ Set.univ := by
    intro h
    have hx : xs ∈ (O : Set ↥(Limits.pullback (C := Scheme.{u})
        (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) := h ▸ Set.mem_univ xs
    rw [hO] at hx
    exact hx rfl
  have hmeet := wc_isp_resolution_components_meet (IsLocalRing.ResidueField A)
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) O hOne (n - 1)
    Yb E fY iE U hU ⟨φ⟩
  have hU0 : Subsingleton (wcEtCoh (U : Scheme.{u}) ℓ (2 * (n - 1))) :=
    wc_et_smooth_proper_open_top_vanish_of_meets (IsLocalRing.ResidueField A) Yb fY (n - 1)
      (by omega) U hmeet ℓ Fact.out hℓk
  obtain ⟨ψ⟩ := wc_et_coh_iso_invariance φ.hom ℓ (2 * (n - 1))
  have hO1 : Subsingleton (wcEtCoh (O : Scheme.{u}) ℓ (2 * (n - 1))) := ψ.symm.subsingleton
  intro m
  cases m with
