    [CompactSpace ↥(Limits.pullback (C := Scheme.{u}) a' ã)] [QuasiSeparatedSpace ↥(Limits.pullback (C := Scheme.{u}) a' ã)]
    (hqc : QuasiCompact (Limits.pullback.fst a' ã)) (hqs : QuasiSeparated (Limits.pullback.fst a' ã))
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt (Limits.pullback a' ã) (ℓ ^ k) j))
    (q : ℕ) (y : wcHM (Limits.pullback a' ã) ℓ q)
    (hy : Function.Bijective (fun c : ℚ_[ℓ] => wcHMScalar (Limits.pullback a' ã) ℓ q c y))
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S]
    [WeaklyEtale (Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))]
    (hW : IsAffine (Spec (.of (LocallyConstant S B))) ∧
      IsClosed {z : Spec (.of (LocallyConstant S B)) | IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))} ∧
      (∀ z : Spec (.of (LocallyConstant S B)), ∃! w : Spec (.of (LocallyConstant S B)),
        IsClosed ({w} : Set (Spec (.of (LocallyConstant S B)))) ∧ z ⤳ w) ∧
      ExtremallyDisconnected {z : Spec (.of (LocallyConstant S B)) | IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))} ∧
      (∀ z : Spec (.of (LocallyConstant S B)), IsClosed ({z} : Set (Spec (.of (LocallyConstant S B)))) →
        HenselianLocalRing ((Spec (.of (LocallyConstant S B))).presheaf.stalk z) ∧
        IsSepClosed ((Spec (.of (LocallyConstant S B))).residueField z)))
    (hstalk : ∀ z : Spec (.of (LocallyConstant S B)), IsClosed ({z} : Set (Spec (.of (LocallyConstant S B)))) →
      IsIso ((Spec (.of (LocallyConstant S B))).fromSpecStalk z ≫
        Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B))))
    (pS : Limits.pullback (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') ã ⟶ Limits.pullback a' ã)
    (hp1 : pS ≫ Limits.pullback.fst a' ã = Limits.pullback.fst (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') ã ≫
      Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
    (hp2 : pS ≫ Limits.pullback.snd a' ã = Limits.pullback.snd (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') ã)
