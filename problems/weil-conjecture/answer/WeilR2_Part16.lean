      Subsingleton (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) ℓ q) := by
    clear_value ψ
    clear E E0 C1
    obtain ⟨e, rfl⟩ : ∃ e, n = 2 * (e + 1) := by
      obtain ⟨r, hr⟩ := hn
      exact ⟨r - 1, by omega⟩
    obtain ⟨O, hO⟩ : ∃ O : (Spec (.of (MvPolynomial (Fin (e + 1)) Ω))).Opens,
        O = ⨆ t : Fin (e + 1), PrimeSpectrum.basicOpen
          (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) Ω) :=
      ⟨_, rfl⟩
    have hOmem : ∀ y : Spec (.of (MvPolynomial (Fin (e + 1)) Ω)), y ∈ O ↔
        ∃ t : Fin (e + 1), (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) Ω) ∉ y.asIdeal := by
      intro y
