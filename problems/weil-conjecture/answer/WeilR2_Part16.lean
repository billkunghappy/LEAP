by
  set_option synthInstance.maxHeartbeats 400000 in

  have hint : ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of (AlgebraicClosure F''))) [Smooth g]
      [ConnectedSpace Y], AlgebraicGeometry.IsIntegral Y := by
    intro Y g _ _
    haveI := wc_smooth_algclosed_connected_irreducible (AlgebraicClosure F'') Y g
    haveI : ∀ y : Y, _root_.IsReduced (Y.presheaf.stalk y) := fun y => by
      haveI := (wc_fntame_smooth_stalk_normal (AlgebraicClosure F'') Y g y).1
      infer_instance
    haveI := isReduced_of_isReduced_stalk Y
    exact isIntegral_of_irreducibleSpace_of_isReduced Y

  have key : ∀ (P : Scheme.{u}) (sS : P ⟶ Spec (.of (AlgebraicClosure F''))) [Smooth sS]
      [IrreducibleSpace P] (U : P.Opens) (E : Scheme.{u}) (πE : E ⟶ U.toScheme) [IsFinite πE]
      [Etale πE] [ConnectedSpace E],
      ∃ _ : QuasiCompact (πE ≫ U.ι), IsFinite (πE ≫ U.ι).fromNormalization ∧
        Surjective (πE ≫ U.ι).fromNormalization ∧ IrreducibleSpace (πE ≫ U.ι).normalization := by
    intro P sS _ _ U E πE _ _ _
    haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian sS
    haveI hPc : ConnectedSpace P := IrreducibleSpace.connectedSpace P
    haveI hPi : AlgebraicGeometry.IsIntegral P := hint P sS
    haveI : Smooth (πE ≫ U.ι ≫ sS) := inferInstance
    haveI hEi : AlgebraicGeometry.IsIntegral E := hint E (πE ≫ U.ι ≫ sS)
    haveI hqc : QuasiCompact (πE ≫ U.ι) := inferInstance
    haveI : QuasiSeparated (πE ≫ U.ι) := inferInstance
    haveI : Smooth πE := by
      set_option synthInstance.maxHeartbeats 400000 in infer_instance
    haveI : Flat πE := by
      set_option synthInstance.maxHeartbeats 400000 in infer_instance
    haveI : LocallyOfFinitePresentation πE := by
      set_option synthInstance.maxHeartbeats 400000 in infer_instance
    haveI : UniversallyOpen πE := UniversallyOpen.of_flat πE
    haveI : Etale U.ι := by
      set_option synthInstance.maxHeartbeats 400000 in infer_instance
    haveI : UniversallyOpen U.ι := by
      set_option synthInstance.maxHeartbeats 400000 in infer_instance
    haveI : UniversallyOpen (πE ≫ U.ι) := by
      first
        | infer_instance
        | exact MorphismProperty.comp_mem @UniversallyOpen _ _ ‹UniversallyOpen πE›
            ‹UniversallyOpen U.ι›
    have hopen : IsOpen (Set.range ⇑(πE ≫ U.ι)) := (Scheme.Hom.isOpenMap _).isOpen_range
    have hdense : Dense (Set.range ⇑(πE ≫ U.ι)) := hopen.dense (Set.range_nonempty _)

    have hgen : (πE ≫ U.ι) (genericPoint E) ⤳ genericPoint P := by
      obtain ⟨x, hx⟩ := ((genericPoint_spec P).mem_open_set_iff hopen).mpr
        (by rw [Set.univ_inter]; exact Set.range_nonempty _)
      rw [← hx]
      exact ((genericPoint_spec E).specializes (Set.mem_univ x)).map (Scheme.Hom.continuous _)

    obtain ⟨e₀⟩ := (inferInstance : Nonempty E)
    have hx : U.ι (πE e₀) ∈ U := by
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι U]; exact ⟨_, rfl⟩
    obtain ⟨U₀, hU₀, hxU₀, hsub⟩ := exists_isAffineOpen_mem_and_subset hx
    have hle : U₀ ≤ U := fun y hy => hsub hy
    have hne : U₀ ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mpr ⟨_, hxU₀⟩
    have hfin0 : IsFinite ((πE ≫ U.ι) ∣_ U₀) := by
      haveI hiso : IsIso (U.ι ∣_ U₀) := by
        rw [isIso_iff_isOpenImmersion_and_surjective]
        refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
        have hy : U₀.ι y ∈ U₀ := by
          rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι U₀]; exact ⟨y, rfl⟩
        have hy' : U₀.ι y ∈ U := hle hy
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι U] at hy'
        obtain ⟨z, hz⟩ := hy'
        have hz' : z ∈ U.ι ⁻¹ᵁ U₀ := by
          show U.ι z ∈ U₀
          rw [hz]; exact hy
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι (U.ι ⁻¹ᵁ U₀)] at hz'
        obtain ⟨w, hw⟩ := hz'
        refine ⟨w, ?_⟩
        apply (Scheme.Hom.isOpenEmbedding U₀.ι).injective
        rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply, hw, hz]
      rw [morphismRestrict_comp]
      haveI : IsFinite (πE ∣_ U.ι ⁻¹ᵁ U₀) := inferInstance
      haveI : IsFinite (U.ι ∣_ U₀) := inferInstance
      first
        | infer_instance
        | exact MorphismProperty.comp_mem @IsFinite _ _ ‹IsFinite (πE ∣_ U.ι ⁻¹ᵁ U₀)›
            ‹IsFinite (U.ι ∣_ U₀)›
    have hfd := wc_sf_function_field_finite P E (πE ≫ U.ι) hgen U₀ hU₀ hne hfin0
    have hfin : IsFinite (πE ≫ U.ι).fromNormalization :=
      wc_sf_fromNormalization_finite (AlgebraicClosure F'') P E sS (πE ≫ U.ι) hgen
        (by
          intro k _ _ A _ _ _ _ K _ _ _ L _ _ _ _ _ B _ _ ι hι
          exact wc_sf_integralClosure_finite_of_embedding k A K L B ι hι
            noether_integralClosure_finite) hfd
    have hsurj : Surjective (πE ≫ U.ι).fromNormalization := by
      have hcl : IsClosed (Set.range ⇑(πE ≫ U.ι).fromNormalization) :=
        (Scheme.Hom.isClosedMap _).isClosed_range
      have hsub : Set.range ⇑(πE ≫ U.ι) ⊆ Set.range ⇑(πE ≫ U.ι).fromNormalization := by
        rintro _ ⟨x, rfl⟩
        refine ⟨(πE ≫ U.ι).toNormalization x, ?_⟩
        rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
      have hall := hcl.closure_subset_iff.mpr hsub
      rw [hdense.closure_eq] at hall
      exact ⟨fun y => hall (Set.mem_univ y)⟩
    have hirrN : IrreducibleSpace (πE ≫ U.ι).normalization := by
      have h1 := ((IrreducibleSpace.isIrreducible_univ E).image _
        (Scheme.Hom.continuous (πE ≫ U.ι).toNormalization).continuousOn).closure
      rw [Set.image_univ, (Scheme.Hom.denseRange (πE ≫ U.ι).toNormalization).closure_range] at h1
      exact (irreducibleSpace_def _).mpr h1
    exact ⟨hqc, hfin, hsurj, hirrN⟩

  haveI : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  haveI hsm0 : Smooth (Over.mk (wcProjKStr F'' M')).hom :=
    SmoothOfRelativeDimension.smooth M' (wcProjKStr F'' M')
  have hsm : Smooth (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  have hirr : IrreducibleSpace (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left := by
    obtain ⟨e, he, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') M'
    haveI := he
    exact @Function.Surjective.irreducibleSpace _ _ _ _ _ (Scheme.Hom.continuous (inv e))
      (Scheme.Hom.homeomorph (inv e)).surjective (wc_proj_space_irreducible (AlgebraicClosure F'') M')
  exact @key (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left
    (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hsm hirr Ub E πE
    inferInstance inferInstance hEc

theorem wc_hfe_normalization_restrict : ∀ (Y E : Scheme.{u}) (U : Y.Opens) (πE : E ⟶ U.toScheme)
    [QuasiCompact (πE ≫ U.ι)] [QuasiSeparated (πE ≫ U.ι)], IsFinite πE →
    IsPullback (πE ≫ U.ι).toNormalization πE (πE ≫ U.ι).fromNormalization U.ι :=
by

  have sf : ∀ (X Y : Scheme.{u}) (ε : X ⟶ Y) [QuasiCompact ε] [QuasiSeparated ε] (OY : Y.Opens),
      IsAffineOpen OY → IsFinite (ε ∣_ OY) →
      IsIso (ε.toNormalization ∣_ (ε.fromNormalization ⁻¹ᵁ OY)) := by
    intro X Y ε _ _ OY hOY hεfin
    haveI := hεfin
    haveI : IsAffine (OY : Scheme.{u}) := hOY
    have hsurj : ∀ {A B : Scheme.{u}} (g : A ⟶ B), IsIso g → Function.Surjective g := by
      intro A B g hg b
      exact ⟨(asIso g).inv b, Scheme.inv_hom_apply (asIso g) b⟩
    have hrange : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C), Function.Surjective f →
        Set.range (f ≫ g) = Set.range g := by
      intro A B C f g hf
      ext x
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨f a, (Scheme.Hom.comp_apply f g a).symm⟩
      · rintro ⟨b, rfl⟩
        obtain ⟨a, rfl⟩ := hf b
        exact ⟨a, Scheme.Hom.comp_apply f g a⟩
    have s3 : ∀ (X' Z' : Scheme.{u}) (N : X' ⟶ Z') (W : Z'.Opens) (U : X'.Opens), N ⁻¹ᵁ W = U →
        IsOpenImmersion (U.ι ≫ N) → Set.range (U.ι ≫ N) = (W : Set Z') → IsIso (N ∣_ W) := by
      intro X' Z' N W U e hOI hR
      subst e
      rw [← morphismRestrict_ι] at hOI hR
      haveI := hOI
      haveI : IsOpenImmersion (N ∣_ W) := IsOpenImmersion.of_comp (N ∣_ W) W.ι
      have hs : Function.Surjective (N ∣_ W) := by
        intro w
        have hw : W.ι w ∈ Set.range (N ∣_ W ≫ W.ι) := by
          rw [hR, ← Scheme.Opens.range_ι]
          exact ⟨w, rfl⟩
        obtain ⟨x, hx⟩ := hw
        refine ⟨x, W.ι.isOpenEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply]
        exact hx
      exact (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, ⟨hs⟩⟩
    haveI hAffX : IsAffine (ε ⁻¹ᵁ OY : Scheme.{u}) := isAffine_of_isAffineHom (ε ∣_ OY)
    have hAff : IsAffineOpen (ε ⁻¹ᵁ OY) := hAffX
    have hfin : (ε.app OY).hom.Finite := by
      have h : IsAffineOpen (OY.ι ⁻¹ᵁ OY) := by
        rw [Scheme.Opens.ι_preimage_self]; exact isAffineOpen_top _
      have h1 : ((ε ∣_ OY).app (OY.ι ⁻¹ᵁ OY)).hom.Finite := IsFinite.finite_app _ _ h
      haveI := Scheme.Hom.isIso_app OY.ι OY (Scheme.Opens.opensRange_ι OY).ge
      have h2 : (OY.ι.app OY).hom.Finite :=
        RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (OY.ι.app OY)).2
      have h3 := RingHom.Finite.comp h1 h2
      have h4 : ((ε ∣_ OY ≫ OY.ι).app OY).hom.Finite := by
        rw [Scheme.Hom.comp_app]; exact h3
      rw [morphismRestrict_ι, Scheme.Hom.comp_app] at h4
      haveI he := Scheme.Hom.isIso_app (ε ⁻¹ᵁ OY).ι (ε ⁻¹ᵁ OY)
        (Scheme.Opens.opensRange_ι (ε ⁻¹ᵁ OY)).ge
      have h5 : (inv ((ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY))).hom.Finite :=
        RingHom.Finite.of_surjective _
          (ConcreteCategory.bijective_of_isIso (inv ((ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY)))).2
      have e : ε.app OY = (ε.app OY ≫ (ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY)) ≫
          inv ((ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY)) := by
        rw [Category.assoc, IsIso.hom_inv_id, Category.comp_id]
      rw [e, CommRingCat.hom_comp]
      exact RingHom.Finite.comp h5 h4
    letI : Algebra Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := (ε.app OY).hom.toAlgebra
    haveI hModA : Module.Finite Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := hfin
    have hint : Algebra.IsIntegral Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) :=
      algebraMap_isIntegral_iff.mp hfin.to_isIntegral
    have htopI : integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) = ⊤ :=
      integralClosure_eq_top_iff.mpr hint
    have hbij : Function.Bijective (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val := by
      refine ⟨Subtype.val_injective, fun a => ⟨⟨a, ?_⟩, rfl⟩⟩
      rw [htopI]; trivial
    haveI hσ : IsIso (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    have key : (ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization = (ε ⁻¹ᵁ OY).toSpecΓ ≫
        Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩ :=
      Scheme.Hom.ι_toNormalization ε ⟨OY, hOY⟩
    haveI hT : IsIso (ε ⁻¹ᵁ OY).toSpecΓ := by
      rw [← hAff.isoSpec_hom]; infer_instance
    have hc : IsOpenImmersion (ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
      ε.normalizationOpenCover.map_prop _
    have hS : IsIso (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := by
      first
      | infer_instance
      | exact Functor.map_isIso Scheme.Spec _
    have hS' : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := IsOpenImmersion.of_isIso _
    have hT' : IsOpenImmersion (ε ⁻¹ᵁ OY).toSpecΓ := IsOpenImmersion.of_isIso _
    have h2 : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
      MorphismProperty.comp_mem @IsOpenImmersion _ _ hS' hc
    have h3 : IsOpenImmersion ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
      MorphismProperty.comp_mem @IsOpenImmersion _ _ hT' h2
    have hOI : IsOpenImmersion ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) := by
      rw [key]; exact h3
    have hrng : Set.range ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) =
        ε.fromNormalization ⁻¹' (OY : Set Y) := by
      have e2 := hrange (ε ⁻¹ᵁ OY).toSpecΓ (Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hT)
      have e3 := hrange (Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom))
        (ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hS)
      have e4 : Set.range (ε.normalizationOpenCover.f ⟨OY, hOY⟩) =
          ε.fromNormalization ⁻¹' (OY : Set Y) := by
        have h := congrArg (fun U : ε.normalization.Opens => (U : Set ε.normalization))
          (Scheme.Hom.fromNormalization_preimage ε ⟨OY, hOY⟩)
        exact h.symm
      have e5 : Set.range ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) =
          Set.range ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
            (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
            ε.normalizationOpenCover.f ⟨OY, hOY⟩) := by
        rw [key]
      exact e5.trans (e2.trans (e3.trans e4))
    have hpre : ε.toNormalization ⁻¹ᵁ (ε.fromNormalization ⁻¹ᵁ OY) = ε ⁻¹ᵁ OY := by
      rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
    exact s3 X ε.normalization ε.toNormalization (ε.fromNormalization ⁻¹ᵁ OY) (ε ⁻¹ᵁ OY)
      hpre hOI hrng

  have hR0 : ∀ (Z : Scheme.{u}) (A B : Z.Opens), A ≤ B → IsIso (B.ι ∣_ A) := by
    intro Z A B hAB
    have h : B.ι ∣_ A = (Scheme.Opens.isoOfLE hAB).hom := by
      rw [← cancel_mono A.ι, morphismRestrict_ι, Scheme.Opens.isoOfLE_hom_ι]
    rw [h]; infer_instance
  intro Y E U πE _ _ hfin
  haveI := hfin

  have hR := (isPullback_morphismRestrict (πE ≫ U.ι).fromNormalization U).flip
  have hw : (πE ≫ U.ι).toNormalization ≫ (πE ≫ U.ι).fromNormalization = πE ≫ U.ι :=
    Scheme.Hom.toNormalization_fromNormalization _
  let j' := hR.lift (πE ≫ U.ι).toNormalization πE hw
  have hj1 : j' ≫ ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ U).ι = (πE ≫ U.ι).toNormalization :=
    hR.lift_fst _ _ _
  have hj2 : j' ≫ ((πE ≫ U.ι).fromNormalization ∣_ U) = πE := hR.lift_snd _ _ _

  have hfinOY : ∀ OY : Y.Opens, OY ≤ U → IsFinite ((πE ≫ U.ι) ∣_ OY) := by
    intro OY hle
    rw [morphismRestrict_comp]
    have hI : IsIso (U.ι ∣_ OY) := hR0 Y OY U hle
    have h1 : IsFinite (πE ∣_ U.ι ⁻¹ᵁ OY) := inferInstance
    have h2 : IsFinite (U.ι ∣_ OY) := inferInstance
    exact MorphismProperty.comp_mem @IsFinite _ _ h1 h2

  have hiso : IsIso j' := by
    refine (MorphismProperty.isomorphisms.iff _).mp
      (IsZariskiLocalAtTarget.of_iSup_eq_top
        (fun i : {OY : Y.Opens // IsAffineOpen OY ∧ OY ≤ U} =>
          ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ U).ι ⁻¹ᵁ ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ i.1))
        ?_ ?_)
    · rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx := (Scheme.Hom.mem_preimage _).mp x.2
      obtain ⟨OY, hOY, hxO, hsub⟩ := exists_isAffineOpen_mem_and_subset hx
      refine ⟨⟨OY, hOY, hsub⟩, ?_⟩
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
      first
      | exact hxO
      | simpa using hxO
    · rintro ⟨OY, hOY, hle⟩
      refine (MorphismProperty.isomorphisms.iff _).mpr ?_
      show IsIso (j' ∣_ (((πE ≫ U.ι).fromNormalization ⁻¹ᵁ U).ι ⁻¹ᵁ
        ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ OY)))
      have h1 := sf E Y (πE ≫ U.ι) OY hOY (hfinOY OY hle)
      have h2 : IsIso ((j' ≫ ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ U).ι) ∣_
          ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ OY)) := by
        rw [hj1]; exact h1
      rw [morphismRestrict_comp] at h2
      have hI : IsIso (((πE ≫ U.ι).fromNormalization ⁻¹ᵁ U).ι ∣_
          ((πE ≫ U.ι).fromNormalization ⁻¹ᵁ OY)) :=
        hR0 _ _ _ (Scheme.Hom.preimage_mono (πE ≫ U.ι).fromNormalization hle)
      exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ hI h2

  have hsq : IsPullback j' πE ((πE ≫ U.ι).fromNormalization ∣_ U) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [hj2, Category.comp_id]⟩
  have hfinal := hsq.paste_horiz hR
  rw [hj1, Category.id_comp] at hfinal
  exact hfinal

theorem wc_qcfin_fet_compactification (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          S i (IsLocalRing.closedPoint F''))
    (X : (wcP1Over F'').left.ProEt) (x : X ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (πX : X.left ⟶ Ub.toScheme) (hπX : πX ≫ Ub.ι = x.left)
    (hfinX : IsFinite πX) (hetX : Etale πX) (hsurjX : Surjective πX)
    (hconnX : ConnectedSpace X.left) :
    ∃ (Xb : Scheme.{u}) (b : Xb ⟶ (wcGeomPoint F'' (wcP1Over F'') hP).left) (jX : X.left ⟶ Xb)
      (Z : Scheme.{u}) (iZ : Z ⟶ Xb),
      IsFinite b ∧ IsOpenImmersion jX ∧ jX ≫ b = x.left ∧ IrreducibleSpace Xb ∧
      (∀ z : Xb, IsDomain (Xb.presheaf.stalk z) ∧ IsIntegrallyClosed (Xb.presheaf.stalk z)) ∧
      topologicalKrullDim Xb = ((1 : ℕ) : WithBot ℕ∞) ∧ IsClosedImmersion iZ ∧
      Set.range iZ = (Set.range jX)ᶜ ∧ topologicalKrullDim Z < ((1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have hs2 : ∀ {X Y : Scheme.{u}} (ε : X ⟶ Y) [IsAffineHom ε] [AlgebraicGeometry.IsIntegral X],
      (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → ∀ z : ε.normalization,
      IsDomain (ε.normalization.presheaf.stalk z) ∧
        IsIntegrallyClosed (ε.normalization.presheaf.stalk z) := by
    intro X Y ε _ _ hX z
    refine ⟨inferInstance, ?_⟩
    obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset (x := ε.fromNormalization z)
