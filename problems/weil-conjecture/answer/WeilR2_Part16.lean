          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))))
      obtain ⟨f, hf⟩ := h2.2 y
      refine ⟨f, h1.1 ?_⟩
      exact (hclaim f).trans
        ((congrArg (fun x => Y.obj.map (wcLpscBetaTop S V).op x) hf).trans hy)

  haveI hcs : (wcProEtBC (Limits.pullback.fst U.hom ι)).IsContinuous
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology (Limits.pullback U.hom ι)) := D.cont
  haveI hflat : RepresentablyFlat (wcProEtBC (Limits.pullback.fst U.hom ι)) :=
    (wc_proet_pullback_continuous_flat (Limits.pullback.fst U.hom ι)).2
  let adjS := (wcProEtBC (Limits.pullback.fst U.hom ι)).sheafAdjunctionContinuous
    AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology (Limits.pullback U.hom ι))
  haveI : Limits.PreservesColimitsOfSize.{0, 0}
      ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology (Limits.pullback U.hom ι))) :=
    adjS.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits
      ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology (Limits.pullback U.hom ι))) :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits _
  haveI : ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology (Limits.pullback U.hom ι))).Additive :=
    (by
      haveI : Limits.PreservesLimitsOfSize.{0, 0}
          ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology (Limits.pullback U.hom ι))) :=
        adjS.rightAdjoint_preservesLimits
      haveI : ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
            (Scheme.ProEt.topology (Limits.pullback U.hom ι))).PreservesZeroMorphisms :=
        Functor.preservesZeroMorphisms_of_isRightAdjoint _
      haveI : ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
            (Scheme.ProEt.topology (Limits.pullback U.hom ι))).Additive :=
        Functor.additive_of_preserves_binary_products _
      exact adjS.left_adjoint_additive)
  haveI : Limits.PreservesFiniteLimits
      ((wcProEtBC (Limits.pullback.fst U.hom ι)).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology (Limits.pullback U.hom ι))) :=
    wc_sheafPullback_preservesFiniteLimits_of_flat _ _ (wcProEtBC (Limits.pullback.fst U.hom ι))

  haveI : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf (Limits.pullback U.hom ι) n)) :=
    ‹Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf ((wcProEtPullback ι).obj U).left n))›
  obtain ⟨φ, hφiso, hmod⟩ := wc_zmct_module_bc (S := U.left) (S' := Limits.pullback U.hom ι)
    (f := Limits.pullback.fst U.hom ι) D hD hn ε hε1 κ hκ ε' hε1' κ' hκ'
  haveI := hφiso

  obtain ⟨χ, hχC⟩ := wc_zmct_slice_push_bc ι n U lamU hlamU lamU' hlamU'

  obtain ⟨τ, hτ⟩ := wc_zmct_abelian_bc ι n L adj θ hθ U lamU lamU' φ (hΦgen Y' U)
    (hΦgen X' ((wcProEtPullback ι).obj U)) χ hχC j e
  refine ⟨τ, hτ.trans ?_⟩
  rw [he]
  exact (hmod j y).symm

theorem wc_proet_free_zmod_ext_mod_model (n j : ℕ) (hn : 0 < n) :
    ∃ Φ : ∀ (S : Scheme.{u}) (U : S.ProEt),
        wcZModProEtExt U.left n j →+ Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod n)) j,
      (∀ (S : Scheme.{u}) (U : S.ProEt), Function.Bijective (Φ S U)) ∧
      (∀ (S : Scheme.{u}) {U V : S.ProEt} (a : V ⟶ U) (D : wcZModPullData a.left n),
        wcZModPullCanonical D → ∀ (y : wcZModProEtExt U.left n j),
        (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Φ S U y) (zero_add j) =
          Φ S V (wcZModPull D j y)) ∧
      (∀ {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
        (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
        [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
        (adj : L ⊣ wcProEtPush ι)
        (θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V))
        (hθ : ∀ {V V' : Y'.ProEt} (a : V ⟶ V'),
          L.map (wcFreeSheafMap Y' a) ≫ (θ V').hom =
            (θ V).hom ≫ wcFreeSheafMap X' ((wcProEtPullback ι).map a))
        (U : Y'.ProEt) (D : wcZModPullData (Limits.pullback.fst U.hom ι) n),
        wcZModPullCanonical D → ∀ (y : wcZModProEtExt U.left n j),
        wcZModPull D j y = 0 → wcProEtRes ι L adj θ (ZMod n) U j (Φ Y' U y) = 0) :=
by
  classical
  haveI hc : ∀ (S : Scheme.{u}) (U : S.ProEt), (wcSliceFunctor S U).IsContinuous
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S) := fun S U => (wc_lpsc_site S U).fst
  haveI ha : ∀ (S : Scheme.{u}) (U : S.ProEt), (wcLpscG S U).Additive :=
    fun S U => (wc_lpsc_site S U).snd.snd.1
  haveI hl : ∀ (S : Scheme.{u}) (U : S.ProEt), Limits.PreservesFiniteLimits (wcLpscG S U) :=
    fun S U => (wc_lpsc_site S U).snd.snd.2.1
  haveI hcl : ∀ (S : Scheme.{u}) (U : S.ProEt), Limits.PreservesFiniteColimits (wcLpscG S U) :=
    fun S U => (wc_lpsc_site S U).snd.snd.2.2
  haveI hTS : ∀ T : Scheme.{u},
      Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)) :=
    fun T => sheafOfModules_toSheaf_preservesFiniteColimits _ _
  obtain ⟨hstr, hlamex⟩ := wc_zmod_model_structure_maps n hn
  choose ε κ hε hε1 hκ using hstr
  choose lam hlam using hlamex
  have hct : ∀ T : Scheme.{u}, Function.Bijective (wcZmCt T n j (ε T) (κ T)) :=
    fun T => wc_zmod_ct_bij T n hn j (ε T) (hε T) (κ T)
  have hrho : ∀ (S : Scheme.{u}) (U : S.ProEt), Function.Bijective (wcZmRho S U n j (lam S U)) :=
    fun S U => wc_zmod_rho_bij S U n j (lam S U)
  obtain ⟨Φ, hΦb, hstar⟩ : ∃ Φ : ∀ (S : Scheme.{u}) (U : S.ProEt),
      wcZModProEtExt U.left n j →+ Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod n)) j,
      (∀ (S : Scheme.{u}) (U : S.ProEt), Function.Bijective (Φ S U)) ∧
      ∀ (S : Scheme.{u}) (U : S.ProEt) (y : wcZModProEtExt U.left n j),
        wcZmRho S U n j (lam S U) (Φ S U y) = wcZmCt U.left n j (ε U.left) (κ U.left) y :=
    ⟨fun S U => (AddEquiv.ofBijective _ (hrho S U)).symm.toAddMonoidHom.comp
        (wcZmCt U.left n j (ε U.left) (κ U.left)),
      fun S U => (AddEquiv.ofBijective _ (hrho S U)).symm.bijective.comp (hct U.left),
      fun S U y => (AddEquiv.ofBijective _ (hrho S U)).apply_symm_apply _⟩
  refine ⟨Φ, hΦb, ?_, ?_⟩
  · intro S U V a D hD y
    haveI : WeaklyEtale a.left := by
      have h : a.left ≫ U.hom = V.hom := MorphismProperty.Over.w a
      haveI : WeaklyEtale (a.left ≫ U.hom) := h ▸ V.prop
      exact WeaklyEtale.of_comp a.left U.hom
    apply (hrho S V).1
    refine (wc_zmod_rho_trans S n a (lam S U) (hlam S U) (lam S V) (hlam S V)
      (lam U.left (Scheme.ProEt.mk a.left)) (hlam _ _) j _).trans ?_
    refine Eq.trans ?_ (hstar S V (wcZModPull D j y)).symm
    rw [hstar S U y]
    exact wc_zmod_ct_slice_nat U.left n hn (Scheme.ProEt.mk a.left) (ε U.left) (hε1 U.left)
      (κ U.left) (hκ U.left) (ε V.left) (hε1 V.left) (κ V.left) (hκ V.left)
      (lam U.left (Scheme.ProEt.mk a.left)) (hlam _ _) D hD j y
  · intro Y' X' ι L _ _ _ adj θ hθ U D hD y h0
    obtain ⟨τ, hτ⟩ := wc_zmod_ct_res_base_change ι n hn L adj θ hθ U (ε U.left) (hε1 _) (κ _)
      (hκ _) (ε _) (hε1 _) (κ _) (hκ _) (lam Y' U) (hlam _ _) (lam X' ((wcProEtPullback ι).obj U))
      (hlam _ _) D hD j (Φ Y' U y) y (hstar Y' U y)
    have hτ0 := hτ.trans ((congrArg (wcZmCt ((wcProEtPullback ι).obj U).left n j
      (ε ((wcProEtPullback ι).obj U).left) (κ ((wcProEtPullback ι).obj U).left)) h0).trans
      (map_zero _))
    have h1 : (Abelian.Ext.mk₀ τ.hom).comp (wcProEtRes ι L adj θ (ZMod n) U j (Φ Y' U y))
        (zero_add j) = 0 :=
      (hrho X' ((wcProEtPullback ι).obj U)).1 (hτ0.trans (map_zero _).symm)
    calc wcProEtRes ι L adj θ (ZMod n) U j (Φ Y' U y)
        = (Abelian.Ext.mk₀ τ.inv).comp ((Abelian.Ext.mk₀ τ.hom).comp
            (wcProEtRes ι L adj θ (ZMod n) U j (Φ Y' U y)) (zero_add j)) (zero_add j) := by
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = 0 := by rw [h1, Abelian.Ext.comp_zero]

theorem wc_proet_int_lim_surj (S : Scheme.{u}) (U : S.ProEt) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom)) :
    ∀ (i : ℕ) (y : ∀ k : ℕ, Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod (ℓ ^ k))) i),
      (∀ k : ℕ, (y (k + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ k)
        continuous_of_discreteTopology)) (add_zero i) = y k) →
      ∃ x : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) i, ∀ k : ℕ,
        x.comp (Abelian.Ext.mk₀ (wcContSheafMap S
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero i) = y k :=
by
  intro N g H1
  classical
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl
  have hc2 : ∀ {A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (x : Abelian.Ext A B p) (f : B ⟶ C) (h : C ⟶ D),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ h) (add_zero p) =
        x.comp (Abelian.Ext.mk₀ (f ≫ h)) (add_zero p) := by
    intro A B C D p x f h
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have hsubmk : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (α : Abelian.Ext A B p) (β₁ β₂ : Abelian.Ext B C 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A B C p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  obtain ⟨hci, hemb, hcs, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact S (wcTowerIncl ℓ) hci
    (wcTowerShift ℓ) hcs hemb hker hsec
  haveI := wc_proet_products_exact S
  have hY := (wc_contSheaf_pi_isLimit S (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun M => wc_ext_prod_bijective (wcFreeSheaf S U)
    (wcContSheaf S ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf S (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY M
  have hTn : ∀ n, wcContSheafMap S (wcTowerShift ℓ) hcs ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub S (wcTowerShift ℓ) (wcTowerShift ℓ) hcs
      hcs (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
  have hredk : ∀ k, wcContSheafMap S (wcTowerIncl ℓ) hci ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k) =
      wcContSheafMap S (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k) := by
    intro k
    rw [← (wc_contSheafMap_comp_sub S (wcTowerIncl ℓ) (wcTowerIncl ℓ) hci hci
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k)).1]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
  obtain ⟨G, hG⟩ := (hprod N).2 g
  have hGs : G.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcs)) (add_zero N) = 0 := by
    apply (hprod N).1
    intro n
    rw [hc2, hTn n, hsubmk, hcompsub, ← hc2, hG, hG, H1, sub_self]
  obtain ⟨x, hx⟩ : ∃ x : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S ℤ_[ℓ]) N,
      x.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerIncl ℓ) hci)) (add_zero N) = G :=
    Abelian.Ext.covariant_sequence_exact₂ (wcFreeSheaf S U) hS2 G hGs
  have key : ∀ k, x.comp (Abelian.Ext.mk₀ (wcContSheafMap S
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero N) = g k := by
    intro k
    rw [← hredk k, ← hc2, hx, hG]
  exact ⟨x, key⟩

theorem wc_pmn_vp_milnor_top_ne_zero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ y : wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1), y ≠ 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓ0 : ℓ ≠ 0 := hℓp.ne_zero



  have passage : ∀ (S : Scheme.{u}) (_ : CompactSpace S) (_ : QuasiSeparatedSpace S) (N : ℕ),
      Finite (wcZModProEtExt S ℓ N) → Nat.card (wcZModProEtExt S ℓ N) ≤ ℓ →
      Subsingleton (wcZModProEtExt S ℓ (N + 1)) →
      (∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt S (ℓ ^ k) N) ∧
        ℓ ^ k ≤ Nat.card (wcZModProEtExt S (ℓ ^ k) N)) →
      ∃ y : wcHM S ℓ N, y ≠ 0 := by
    intro S hcS hqS N hfin1 hcard1 htop hge
    let U : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    have Em : ∀ m : ℕ, 0 < m → ∀ j : ℕ,
        Nonempty (wcZModProEtExt S m j ≃+ Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S m) j) := by
      intro m hm j
      obtain ⟨Φ, hΦb, -, -⟩ := wc_proet_free_zmod_ext_mod_model.{u} m j hm
      exact ⟨AddEquiv.ofBijective (Φ S U) (hΦb S U)⟩
    have hℓpos : 0 < ℓ := hℓp.pos
    obtain ⟨E1⟩ := Em ℓ hℓpos N
    obtain ⟨E2⟩ := Em ℓ hℓpos (N + 1)
    have h1 : Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) :=
      Finite.of_equiv _ E1.toEquiv
    have h2 : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) ≤ ℓ := by
      rw [← Nat.card_congr E1.toEquiv]
      exact hcard1
    have h3 : ∀ z : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) (N + 1), z = 0 := by
      intro z
      rw [← E2.apply_symm_apply z, Subsingleton.elim (E2.symm z) 0, map_zero]
    have h4 : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) →
        ℓ ^ k ≤ Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) := by
      intro k hk _
      obtain ⟨Ek⟩ := Em (ℓ ^ k) (pow_pos hℓpos k) N
      rw [← Nat.card_congr Ek.toEquiv]
      exact (hge k hk).2
    obtain ⟨hcnt, hsN, -⟩ := wc_local_tower_counts S ℓ (wcFreeSheaf S U) N h1 h2 h3 h4
    have hkill : ∀ (m : ℕ) (t : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N),
        ℓ ^ m • t = 0 := by
      intro m t
      have hc' : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N) = ℓ ^ m :=
        (hcnt m).2
