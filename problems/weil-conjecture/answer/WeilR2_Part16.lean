  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  haveI hcO : CompactSpace (Scheme.ProEt.mk O.ι).left :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (O : Set Y))
  have hsepO : IsSeparated (Limits.terminal.from (O : Scheme.{u})) := by
    have e : Limits.terminal.from (O : Scheme.{u}) =
        O.ι ≫ pY ≫ Limits.terminal.from (Spec (.of K)) := Limits.terminal.hom_ext _ _
    haveI : IsSeparated pY := inferInstance
    haveI : IsSeparated O.ι := IsSeparated.isSeparated_of_mono O.ι
    haveI : IsSeparated (Limits.terminal.from (Spec (.of K))) :=
      Scheme.IsSeparated.isSeparated_terminal_from
    rw [e]
    infer_instance
  haveI hsO : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk O.ι).left) := hsepO

  set ι : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial with hιdef
  have hmono : Mono (wcFreeSheafMap Y ι) :=
    wc_free_sheaf_map_mono Y _ _ ι (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap Y ι)
      (Limits.cokernel.π (wcFreeSheafMap Y ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  haveI hsubEt : Subsingleton (wcEtCoh Y ℓ (2 * N + 1)) := by
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hv := wc_et_cd_proper_torsion K Y pY N hdim ℓ
      hℓ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
      (wc_et_const_zmod_nsmul_zero Y ℓ) (2 * N + 1) (by omega)
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (2 * N + 1))
    exact ⟨fun a b => (hv a).trans (hv b).symm⟩
  obtain ⟨E3⟩ := wc_proet_etale_comparison_zmod K Y pY ℓ (2 * N + 1)
  haveI hsub1 : Subsingleton (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y ℓ) (2 * N + 1)) := E3.subsingleton

  have h1 : ∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι))
      (wcZModSheaf Y (ℓ ^ 1)) (2 * N), x = 0 :=
    wc_proet_free_zmod_ext_vanish_of_et_qcsep Y (Scheme.ProEt.mk O.ι) (ℓ ^ 1) (2 * N) (hOv 1)
