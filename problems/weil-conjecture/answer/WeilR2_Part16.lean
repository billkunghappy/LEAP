        intro P hP h1
        by_contra h2
        obtain ⟨n1, hn1, hle1⟩ := Ideal.exists_le_maximal _ h1
        obtain ⟨n2, hn2, hle2⟩ := Ideal.exists_le_maximal _ h2
        obtain ⟨m1, hm1U, hm1⟩ := hclosed U hU.isClosed n1 hn1 (le_trans le_sup_right hle1)
        obtain ⟨m2, hm2U, hm2⟩ := hclosed Uᶜ hU.compl.isClosed n2 hn2 (le_trans le_sup_right hle2)
