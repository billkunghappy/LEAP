    exact wc_pencil_R2_offS_frame_fixed F' F'' Y n hn hn2 D ℓ hℓ hP W w r hqc hW hsurj θ
      V hV (havoid V h₁) (h₁ ≫ ι) (h₂ ≫ ι) x hh'

  obtain ⟨e⟩ := wc_proet_frame_fixed_descent (wcP1Over F'').left ℓ (wcPencilGeomOffS D hP) W' w'
    hqc' hsurj' (wcRq D.f ℓ (2 * (n - 1))) r θ' hfix'
