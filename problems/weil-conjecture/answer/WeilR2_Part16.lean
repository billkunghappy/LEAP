      rfl
    let σ : ↑((wcRingSheaf W.left ℓ).val.obj (Opposite.op T)) :=
      (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from s).comp (TopCat.Hom.hom T.hom.base)
    have hσ : ((wcHMFun W.left ℓ (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from s)).val.app
        (Opposite.op T)).hom (1 : ↑((wcRingSheaf W.left ℓ).val.obj (Opposite.op T))) = σ := by
      have h1 := SheafOfModules.unitHomEquiv_apply_coe (SheafOfModules.unit (wcRingSheaf W.left ℓ))
        (wcHMFun W.left ℓ (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from s)) (Opposite.op T)
      rw [hσr, hσr'] at h1
      exact h1.symm
    have hR : ((ε W).val.app (Opposite.op T)).hom σ =
