    show (Φ.leftKanExtensionUnit G).app (Opposite.op Vt) ≫
      (Φ.leftKanExtension G).map (𝟙 _) = _
    rw [CategoryTheory.Functor.map_id]
    exact Category.comp_id _
  rw [key] at hiso
  exact ConcreteCategory.bijective_of_isIso ((Φ.leftKanExtensionUnit G).app (Opposite.op Vt))

