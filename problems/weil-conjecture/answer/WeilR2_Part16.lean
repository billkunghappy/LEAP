        intro hdisj
        obtain ⟨P, hP, hJP, hPS⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
        have hPZ : (⟨P, hP⟩ : PrimeSpectrum A) ∈ {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} := by
          have hx : (⟨P, hP⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
              (PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Set A) := by
            rw [PrimeSpectrum.mem_zeroLocus]
            exact fun t ht => hJP ht
          rwa [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, ha.closure_eq] at hx
        have hPmax : P.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hPZ
        have hPle : P ≤ m'.1.asIdeal := by
          intro t ht
          by_contra htm
          have htS : t ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
            (le_sup_left : m'.1.asIdeal.primeCompl ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a) htm
          exact Set.disjoint_left.mp hPS ht htS
        have hPeq : P = m'.1.asIdeal := hPmax.eq_of_le m'.1.isPrime.ne_top hPle
        have haS : a ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
          (le_sup_right : Submonoid.powers a ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a)
            (Submonoid.mem_powers a)
        have haP : a ∈ (P : Set A) := by rw [SetLike.mem_coe, hPeq]; exact ham'
        exact Set.disjoint_left.mp hPS haP haS
      rw [Set.not_disjoint_iff] at hnd
      obtain ⟨t, htJ, htS⟩ := hnd
      obtain ⟨s, hs, w, hw, hsw⟩ := Submonoid.mem_sup.mp (SetLike.mem_coe.mp htS)
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hw
      refine ⟨{m | s ∉ m.1.asIdeal}, ?_, hopen s, hs⟩
      intro m hm ham
      have htm : t ∈ m.1.asIdeal :=
        (PrimeSpectrum.mem_vanishingIdeal _ _).mp (SetLike.mem_coe.mp htJ) m.1 m.2
      rw [← hsw] at htm
      rcases m.1.isPrime.mem_or_mem htm with h | h
      · exact hm h
      · exact ham (m.1.isPrime.mem_of_pow_mem k h)

    have s2 : ∀ (a e : A), e * e = e → (∀ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) → e ∉ y.asIdeal → a ∉ y.asIdeal) → ∀ x : PrimeSpectrum A, e ∉ x.asIdeal → a ∉ x.asIdeal := by
      intro a e he hcl x hx hax
      obtain ⟨y, ⟨hy, hxy⟩, -⟩ := hb x
      have hle : x.asIdeal ≤ y.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal x y).mpr ((PrimeSpectrum.le_iff_specializes x y).mpr hxy)
      have h0 : e * (1 - e) ∈ x.asIdeal := by
        have h00 : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he, sub_self]
        rw [h00]; exact x.asIdeal.zero_mem
      have h1 : 1 - e ∈ y.asIdeal := hle ((x.isPrime.mem_or_mem h0).resolve_left hx)
      have hey : e ∉ y.asIdeal := by
        intro hey
        apply y.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have h11 : (1 : A) = e + (1 - e) := by ring
        rw [h11]; exact y.asIdeal.add_mem hey h1
      exact hcl y hy hey (hle hax)

    obtain ⟨e, he, heC⟩ := s3 _ (s1 s)
    let z : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
      ⟨⟨m, hm.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hm⟩
    have hem : e ∉ m := (heC z).mp hs
    have hD := s2 s e he (fun y hy hey => (heC ⟨y, hy⟩).mpr hey)
    have hle : PrimeSpectrum.basicOpen e ≤ PrimeSpectrum.basicOpen s := fun x hx => hD x hx
    rw [PrimeSpectrum.basicOpen_le_basicOpen_iff] at hle
    obtain ⟨n, hn⟩ := hle
    have hei : IsIdempotentElem e := he
    have he' : e ∈ Ideal.span {s} := by
      rw [← hei.pow_succ_eq n, pow_succ]; exact Ideal.mul_mem_right _ _ hn
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp he'
    exact ⟨e, t, hei, hem, by rw [← ht, mul_comm]⟩
  have tC4 : ∀ (R : Type u) [CommRing R] (I : Ideal R)
    (hF0 : ∀ (m : Ideal R) [m.IsMaximal], I ≤ m ∧ (m.map (Ideal.Quotient.mk I)).IsMaximal ∧
      (m.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = m)
    (hidem : ∀ ē : R ⧸ I, IsIdempotentElem ē → ∃ e : R, IsIdempotentElem e ∧ Ideal.Quotient.mk I e = ē)
    (hIMq : ∀ (m : Ideal (R ⧸ I)) [m.IsMaximal] (s : R ⧸ I), s ∉ m → ∃ e t : R ⧸ I, IsIdempotentElem e ∧ e ∉ m ∧ e = s * t),
      ∀ x : PrimeSpectrum R, ∃! y : PrimeSpectrum R, IsClosed ({y} : Set (PrimeSpectrum R)) ∧ x ⤳ y := by
    intro R _ I hF0 hidem hIMq
    intro x
    have key : ∀ y₁ y₂ : PrimeSpectrum R, IsClosed ({y₁} : Set (PrimeSpectrum R)) → x ⤳ y₁ →
        IsClosed ({y₂} : Set (PrimeSpectrum R)) → x ⤳ y₂ → y₁ = y₂ := by
      intro y₁ y₂ h1 s1 h2 s2
      rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal] at h1 h2
      have s1' : x.asIdeal ≤ y₁.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((PrimeSpectrum.le_iff_specializes _ _).mpr s1)
      have s2' : x.asIdeal ≤ y₂.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((PrimeSpectrum.le_iff_specializes _ _).mpr s2)
      by_contra hne
      have hne' : ¬ (y₂.asIdeal ≤ y₁.asIdeal) := fun hle =>
        hne (PrimeSpectrum.ext (h2.eq_of_le h1.ne_top hle).symm)
      obtain ⟨a, ha2, ha1⟩ := SetLike.not_le_iff_exists.mp hne'
      obtain ⟨-, hm1, hc1⟩ := @hF0 y₁.asIdeal h1
      obtain ⟨-, -, hc2⟩ := @hF0 y₂.asIdeal h2
      have hqa : Ideal.Quotient.mk I a ∉ y₁.asIdeal.map (Ideal.Quotient.mk I) := by
        intro h; apply ha1; rw [← hc1]; exact h
      obtain ⟨eb, tb, hē, hēm, hēeq⟩ := @hIMq _ hm1 _ hqa
      obtain ⟨e, he, rfl⟩ := hidem eb hē
      have he1 : e ∉ y₁.asIdeal := fun h => hēm (Ideal.mem_map_of_mem _ h)
      have he2 : e ∈ y₂.asIdeal := by
        rw [← hc2, Ideal.mem_comap, hēeq]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ha2)
      have h0 : e * (1 - e) ∈ x.asIdeal := by
        rw [mul_sub, mul_one, he.eq, sub_self]; exact x.asIdeal.zero_mem
      rcases x.isPrime.mem_or_mem h0 with h | h
      · exact he1 (s1' h)
      · apply h2.ne_top
        rw [Ideal.eq_top_iff_one]
        have e1 : (1 : R) = e + (1 - e) := by ring
        rw [e1]; exact y₂.asIdeal.add_mem he2 (s2' h)
    obtain ⟨M, hM, hpM⟩ := Ideal.exists_le_maximal x.asIdeal x.isPrime.ne_top
    have hy0 : IsClosed ({(⟨M, hM.isPrime⟩ : PrimeSpectrum R)} : Set (PrimeSpectrum R)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 hM
    have hs0 : x ⤳ (⟨M, hM.isPrime⟩ : PrimeSpectrum R) :=
      (PrimeSpectrum.le_iff_specializes _ _).mp ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp hpM)
    exact ⟨_, ⟨hy0, hs0⟩, fun y hy => key _ _ hy.1 hy.2 hy0 hs0⟩
  have hF0 : ∀ (m : Ideal R) [m.IsMaximal], I ≤ m ∧ (m.map (Ideal.Quotient.mk I)).IsMaximal ∧
      (m.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = m := fun m _ => tF0 R I m
  have hidem := tC1 R I
  have hIMq : ∀ (m : Ideal (R ⧸ I)) [m.IsMaximal] (s : R ⧸ I), s ∉ m →
      ∃ e t : R ⧸ I, IsIdempotentElem e ∧ e ∉ m ∧ e = s * t :=
    fun m _ s hs => tC5 (R ⧸ I) hQ.2.1 hQ.2.2.1 m s hs
  have hpt : ∀ y : Spec (.of R), IsClosed ({y} : Set (Spec (.of R))) ↔ ∃ x : Spec (.of (R ⧸ I)),
      IsClosed ({x} : Set (Spec (.of (R ⧸ I)))) ∧ PrimeSpectrum.comap (Ideal.Quotient.mk I) x = y :=
    tC3 R I hF0
  obtain ⟨hc, he⟩ := tC2 (Spec (.of (R ⧸ I))) (Spec (.of R))
    (PrimeSpectrum.comap (Ideal.Quotient.mk I))
    (PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ _ Ideal.Quotient.mk_surjective) hpt hQ.2.1 hQ.2.2.2.1
  have hu : ∀ x : Spec (.of R), ∃! y : Spec (.of R), IsClosed ({y} : Set (Spec (.of R))) ∧ x ⤳ y :=
    tC4 R I hF0 hidem hIMq
  have hD : ∀ (m : Ideal R) [m.IsMaximal],
      HenselianRing (Localization.AtPrime m) (I.map (algebraMap R (Localization.AtPrime m))) :=
    fun m _ => tC7 R I (tC6 R I) m (fun s hs => tC5 R hc hu m s hs)
  refine ⟨inferInstance, hc, hu, he, ?_⟩
  intro x hx
  have hmax : x.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hx
  obtain ⟨-, hm', hcm⟩ := @hF0 x.asIdeal hmax
  let x' : Spec (.of (R ⧸ I)) := ⟨x.asIdeal.map (Ideal.Quotient.mk I), hm'.isPrime⟩
  have hx' : IsClosed ({x'} : Set (Spec (.of (R ⧸ I)))) :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hm'
  obtain ⟨hHq, hSq⟩ := hQ.2.2.2.2 x' hx'
  let eR := (Spec.stalkIso (.of R) x).commRingCatIsoToRingEquiv
  let eQ := (Spec.stalkIso (.of (R ⧸ I)) x').commRingCatIsoToRingEquiv
  have hLq : HenselianLocalRing (Localization.AtPrime x'.asIdeal) := hK8.2 _ _ eQ hHq
  haveI := hD x.asIdeal
  obtain ⟨π, hπ, hker⟩ := tC9 R I x.asIdeal x'.asIdeal hcm
  have hLR : HenselianLocalRing (Localization.AtPrime x.asIdeal) := tC8 _ _ _ π hπ hker hLq
  refine ⟨hK8.2 _ _ eR.symm hLR, ?_⟩
  obtain ⟨φ⟩ := tC10 _ _ π hπ
  exact hK8.1 _ _ ((IsLocalRing.ResidueField.mapEquiv eR).trans
    (φ.trans (IsLocalRing.ResidueField.mapEquiv eQ.symm))).symm hSq

theorem wc_hte_thickening_square {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (T : Z.ProEt)
    (A₀ : Type u) [CommRing A₀] (I₀ : Ideal A₀) (B : Type u) [CommRing B] [Algebra (A₀ ⧸ I₀) B]
    (j : Spec (.of A₀) ⟶ Y) (k : Spec (.of (A₀ ⧸ I₀)) ⟶ Z) (eT : T.left ≅ Spec (.of B))
    (hj : IsOpenImmersion j) (hpb : IsPullback k (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀))) i j)
    (hT : eT.inv ≫ T.hom = Spec.map (CommRingCat.ofHom (algebraMap (A₀ ⧸ I₀) B)) ≫ k)
    (A : Type u) [CommRing A] [Algebra A₀ A] (hA : Algebra.WeaklyEtale A₀ A)
    (θ : (A ⧸ I₀.map (algebraMap A₀ A)) ≃+* B)
    (hθ : θ.toRingHom.comp (Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A) Ideal.le_comap_map) =
      algebraMap (A₀ ⧸ I₀) B) :
    ∃ (Vt : Y.ProEt) (e : Vt.left ≅ Spec (.of A))
      (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I₀.map (algebraMap A₀ A))))
      (_ : (wcProEtBaseChange i).obj Vt ≅ T),
      IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I₀.map (algebraMap A₀ A))))) :=
by
  classical
  haveI := hj

  have S : IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I₀.map (algebraMap A₀ A)))))
      (Spec.map (CommRingCat.ofHom
        (Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A) Ideal.le_comap_map)))
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ A)))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀))) := by
    apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
    have hcomm : ∀ r : A₀, Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A)
        Ideal.le_comap_map (Ideal.Quotient.mk I₀ r) =
        Ideal.Quotient.mk (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A r) := fun r =>
      Ideal.quotientMap_mk
    have w : CommRingCat.ofHom (algebraMap A₀ A) ≫
        CommRingCat.ofHom (Ideal.Quotient.mk (I₀.map (algebraMap A₀ A))) =
        CommRingCat.ofHom (Ideal.Quotient.mk I₀) ≫
        CommRingCat.ofHom (Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A)
          Ideal.le_comap_map) := by
      ext r
      exact (hcomm r).symm
    have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A₀ A))
        (CommRingCat.ofHom (Ideal.Quotient.mk I₀))) (r : A₀),
        s.inl.hom (algebraMap A₀ A r) = s.inr.hom (Ideal.Quotient.mk I₀ r) := by
      intro s r
      have := congrArg (fun φ => φ.hom r) s.condition
      simpa using this
    have H : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A₀ A))
        (CommRingCat.ofHom (Ideal.Quotient.mk I₀))),
        I₀.map (algebraMap A₀ A) ≤ RingHom.ker s.inl.hom := by
      intro s
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, key s x, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
        map_zero]
    refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk w
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (fun a ha => H s ha)))
      ?_ ?_ ?_)
    · intro s
      ext x
      exact Ideal.Quotient.lift_mk (I₀.map (algebraMap A₀ A)) s.inl.hom (fun a ha => H s ha)
    · intro s
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, hcomm, Ideal.Quotient.lift_mk]
      exact key s x
    · intro s m h1 _
      ext x
      have := congrArg (fun φ => φ.hom x) h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply] at this
      simp only [CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
      exact this

  haveI hg : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A₀ A))) := by
    haveI := hA
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap A₀ A))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := A₀) (S := A))
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap A₀ A)))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := A) A₀).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' A₀ A)
      infer_instance
    exact WeaklyEtale.mk hf hd

  have P₂ := (S.flip.paste_horiz hpb).flip

  have hs5 : θ.symm.toRingHom.comp (algebraMap (A₀ ⧸ I₀) B) =
      Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A) Ideal.le_comap_map := by
    rw [← hθ]
    ext x
    simp

  let σ : Spec (.of (A ⧸ I₀.map (algebraMap A₀ A))) ≅ Spec (.of B) :=
    (Scheme.Spec.mapIso θ.toCommRingCatIso.op).symm
  have hσ : σ.hom = Spec.map (CommRingCat.ofHom θ.symm.toRingHom) := rfl
  have hσa : σ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (A₀ ⧸ I₀) B)) =
      Spec.map (CommRingCat.ofHom
        (Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A) Ideal.le_comap_map)) := by
    rw [hσ, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hs5]
  have hw : (P₂.isoPullback.symm ≪≫ σ ≪≫ eT.symm).hom ≫ T.hom =
      Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap A₀ A)) ≫ j) i := by
    simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc, hT]
    rw [reassoc_of% hσa]
    exact P₂.isoPullback_inv_snd
  refine ⟨Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom (algebraMap A₀ A)) ≫ j), Iso.refl _,
    P₂.isoPullback.inv,
    MorphismProperty.Over.isoMk (A := (wcProEtBaseChange i).obj
      (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom (algebraMap A₀ A)) ≫ j))) (B := T)
      (P₂.isoPullback.symm ≪≫ σ ≪≫ eT.symm) hw, ?_⟩
  refine @IsPullback.of_vert_isIso _ _ _ _ _ _ _ _ _ _ ?_ ?_ ?_
  · exact Iso.isIso_inv _
  · exact Iso.isIso_hom _
  constructor
  exact (Category.comp_id _).trans P₂.isoPullback_inv_fst.symm

theorem wc_proet_henselian_thickening_exists {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (T : Z.ProEt) (O : Y.Opens) (hO : IsAffineOpen O) (hTO : ∀ t : T.left, i (T.hom t) ∈ O)
    (hT : IsAffine T.left ∧ IsClosed {x : T.left | IsClosed ({x} : Set T.left)} ∧
       (∀ x : T.left, ∃! y : T.left, IsClosed ({y} : Set T.left) ∧ x ⤳ y) ∧
       ExtremallyDisconnected {x : T.left | IsClosed ({x} : Set T.left)} ∧
       (∀ x : T.left, IsClosed ({x} : Set T.left) →
         HenselianLocalRing (T.left.presheaf.stalk x) ∧ IsSepClosed (T.left.residueField x))) :
    ∃ (A : Type u) (_ : CommRing A) (I : Ideal A) (_ : HenselianRing A I) (Vt : Y.ProEt)
      (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I)))
      (_ : (wcProEtBaseChange i).obj Vt ≅ T),
      IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
       (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
       ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
       (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
         HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) ∧
      (IsAffine ((wcProEtBaseChange i).obj Vt).left ∧
       IsClosed {x : ((wcProEtBaseChange i).obj Vt).left |
         IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧
       (∀ x : ((wcProEtBaseChange i).obj Vt).left, ∃! y : ((wcProEtBaseChange i).obj Vt).left,
         IsClosed ({y} : Set ((wcProEtBaseChange i).obj Vt).left) ∧ x ⤳ y) ∧
       ExtremallyDisconnected {x : ((wcProEtBaseChange i).obj Vt).left |
         IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧
       (∀ x : ((wcProEtBaseChange i).obj Vt).left,
         IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left) →
         HenselianLocalRing (((wcProEtBaseChange i).obj Vt).left.presheaf.stalk x) ∧
         IsSepClosed (((wcProEtBaseChange i).obj Vt).left.residueField x))) :=
by
  classical
  obtain ⟨A₀, iA₀, I₀, B, iB, iAB, j, k, eT, hj, hpb, hTk, hWE⟩ :=
    wc_hte_affine_setup i T O hO hTO hT.1
  have hK8 := wc_hte_sepClosed_henselian_transport.{u}
  have hB := wc_hte_wcontr_of_iso T.left (Spec (.of B)) eT hK8 hT
  have hind := wc_hte_indEtale_of_wcontr (A₀ ⧸ I₀) B hWE hB.2.1 hB.2.2.1 hB.2.2.2.1 hB.2.2.2.2
  obtain ⟨A, iA, iAA, θ, hWEA, hHens, hθ⟩ := wc_hte_henselization A₀ I₀ B hind
  obtain ⟨Vt, e, c, κ, hsq⟩ :=
    wc_hte_thickening_square i T A₀ I₀ B j k eT hj hpb hTk A hWEA θ hθ
  have hQ := wc_hte_wcontr_of_iso (Spec (.of B)) (Spec (.of (A ⧸ I₀.map (algebraMap A₀ A))))
    (Scheme.Spec.mapIso θ.toCommRingCatIso.op) hK8 hB
  haveI := hHens
  have hA := wc_hte_wcontr_of_henselian_quotient A (I₀.map (algebraMap A₀ A)) hK8 hQ
  have hV := wc_hte_wcontr_of_iso (Spec (.of A)) Vt.left e.symm hK8 hA
  have hiV := wc_hte_wcontr_of_iso T.left ((wcProEtBaseChange i).obj Vt).left
    ((Scheme.ProEt.forget Z ⋙ Over.forget Z).mapIso κ).symm hK8 hT
  exact ⟨A, iA, I₀.map (algebraMap A₀ A), hHens, Vt, e, c, κ, hsq, hV, hiV⟩

theorem wc_proet_toSheafify_bijective_wcontr (S : Scheme.{u}) (F : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (P : S.ProEt)
    (hP : IsAffine P.left ∧ IsClosed {x : P.left | IsClosed ({x} : Set P.left)} ∧
       (∀ x : P.left, ∃! y : P.left, IsClosed ({y} : Set P.left) ∧ x ⤳ y) ∧
       ExtremallyDisconnected {x : P.left | IsClosed ({x} : Set P.left)} ∧
       (∀ x : P.left, IsClosed ({x} : Set P.left) →
         HenselianLocalRing (P.left.presheaf.stalk x) ∧ IsSepClosed (P.left.residueField x)))
    (hadd : ∀ (m : ℕ) (Q : Fin m → S.ProEt) (ι : ∀ k, Q k ⟶ P),
      (∀ k, IsOpenImmersion (ι k).left) → (∀ x : P.left, ∃! k, x ∈ Set.range (ι k).left) →
      Function.Bijective (fun s : F.obj (Opposite.op P) => fun k => (F.map (ι k).op).hom s)) :
    Function.Bijective ((toSheafify (Scheme.ProEt.topology S) F).app (Opposite.op P)).hom :=
by
  classical

  have s1 : ∀ (m : ℕ) (Q : Fin m → S.ProEt) (ι : ∀ k, Q k ⟶ P),
      (∀ k, IsOpenImmersion (ι k).left) → (∀ x : P.left, ∃! k, x ∈ Set.range (ι k).left) →
      Sieve.generate (Presieve.ofArrows Q ι) ∈ Scheme.ProEt.topology S P := by
    intro m Q ι hι hpart
    haveI : IsAffine P.left := hP.1
    have hs : ∀ x : P.left, ∃ j y, (ι j).left y = x := by
      intro x
      obtain ⟨j, ⟨y, hy⟩, _⟩ := hpart x
      exact ⟨j, y, hy⟩
    have hopen : ∀ j, IsOpen (Set.range (ι j).left) := fun j =>
      (@Scheme.Hom.isOpenEmbedding _ _ (ι j).left (hι j)).isOpen_range
    have hclosed : ∀ k, IsClosed (Set.range (ι k).left) := by
      intro k
      rw [← isOpen_compl_iff]
      have hc : (Set.range (ι k).left)ᶜ = ⋃ j ∈ {j | j ≠ k}, Set.range (ι j).left := by
        ext x
        simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_setOf_eq]
        constructor
        · intro hx
          obtain ⟨j, hj, _⟩ := hpart x
          refine ⟨j, ?_, hj⟩
          rintro rfl
          exact hx hj
        · rintro ⟨j, hjk, hj⟩ hk
          obtain ⟨j', _, huniq⟩ := hpart x
          exact hjk ((huniq j hj).trans (huniq k hk).symm)
      rw [hc]
      exact isOpen_biUnion (fun j _ => hopen j)
    have hq : ∀ k, QuasiCompact (ι k).left := by
      intro k
      haveI : CompactSpace (Q k).left :=
        (Topology.IsClosedEmbedding.mk
          (@Scheme.Hom.isOpenEmbedding _ _ (ι k).left (hι k)).isEmbedding
          (hclosed k)).compactSpace
      exact quasiCompact_of_compactSpace _
    have hw : ∀ k, WeaklyEtale (ι k).left := fun k => by
      have h1 : WeaklyEtale ((ι k).left ≫ P.hom) := by
        rw [MorphismProperty.Over.w (ι k)]
        exact (Q k).prop
      haveI := P.prop
      exact @WeaklyEtale.of_comp _ _ _ (ι k).left P.hom h1 P.prop
    have H : Presieve.ofArrows (fun i => (Q i).left) (fun i => (ι i).left) ∈
        Scheme.proetalePrecoverage.coverings P.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin m) (fun i => (Q i).left) (fun i => (ι i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin m)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have K : ∀ R : Sieve P, R ∈ Scheme.ProEt.topology S P →
      ∃ (m : ℕ) (Q : Fin m → S.ProEt) (ι : ∀ k, Q k ⟶ P),
        (∀ k, IsOpenImmersion (ι k).left) ∧ (∀ x : P.left, ∃! k, x ∈ Set.range (ι k).left) ∧
        ∀ k, R.arrows (ι k) := by
    intro R hR
    obtain ⟨n, W, h, hRh, hWa, hWs⟩ :=
      wc_proet_affine_sieve_finite_jointly_surjective S P hP.1 R hR
    obtain ⟨m, Q, ι, hι, hpart, hfac⟩ := wc_ret_disjoint_open_refine P hP.1
      (fun E p hE hp hs => wc_wlocal_strictHensel_retraction P.left hP.1 hP.2.1 hP.2.2.1
        hP.2.2.2.1 hP.2.2.2.2 E p hE hp hs)
      n W h hWa hWs
    refine ⟨m, Q, ι, hι, hpart, fun j => ?_⟩
    obtain ⟨k, h', e⟩ := hfac j
    rw [← e]
    exact R.downward_closed (hRh k) h'
  haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.ProEt.topology S) F
  haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology S) F
  constructor
  · intro x x' hxx'
    have hmem := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology S)
      (toSheafify (Scheme.ProEt.topology S) F) x x' hxx'
    obtain ⟨m, Q, ι, hι, hpart, hR⟩ := K _ hmem
    apply (hadd m Q ι hι hpart).1
    funext k
    exact hR k
  · intro y
    have hmem := Presheaf.imageSieve_mem (Scheme.ProEt.topology S)
      (toSheafify (Scheme.ProEt.topology S) F) y
    obtain ⟨m, Q, ι, hι, hpart, hR⟩ := K _ hmem
    have hR' : ∀ k, ∃ t : F.obj (Opposite.op (Q k)),
        ((toSheafify (Scheme.ProEt.topology S) F).app (Opposite.op (Q k))).hom t =
          ((sheafify (Scheme.ProEt.topology S) F).map (ι k).op).hom y := fun k => hR k
    choose t ht using hR'
    obtain ⟨x, hx⟩ := (hadd m Q ι hι hpart).2 t
    refine ⟨x, ?_⟩
    have hk : ∀ k, ((sheafify (Scheme.ProEt.topology S) F).map (ι k).op).hom
        (((toSheafify (Scheme.ProEt.topology S) F).app (Opposite.op P)).hom x) =
          ((sheafify (Scheme.ProEt.topology S) F).map (ι k).op).hom y := by
      intro k
      have hnat := NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology S) F) (ι k).op x
      have hxk : (F.map (ι k).op).hom x = t k := congrFun hx k
      calc ((sheafify (Scheme.ProEt.topology S) F).map (ι k).op).hom
            (((toSheafify (Scheme.ProEt.topology S) F).app (Opposite.op P)).hom x)
          = ((toSheafify (Scheme.ProEt.topology S) F).app (Opposite.op (Q k))).hom
              ((F.map (ι k).op).hom x) := hnat.symm
        _ = ((sheafify (Scheme.ProEt.topology S) F).map (ι k).op).hom y := by
          rw [hxk]; exact ht k
    have hsep := Sheaf.isSeparated
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj F)
    refine hsep P _ (s1 m Q ι hι hpart) _ _ ?_
    rintro Y f ⟨Y', g, f', hf', rfl⟩
    rcases hf' with ⟨k⟩
    have e : ∀ z : (sheafify (Scheme.ProEt.topology S) F).obj (Opposite.op P),
        ((sheafify (Scheme.ProEt.topology S) F).map (g ≫ ι k).op).hom z =
          ((sheafify (Scheme.ProEt.topology S) F).map g.op).hom
            (((sheafify (Scheme.ProEt.topology S) F).map (ι k).op).hom z) := by
      intro z
      rw [op_comp, Functor.map_comp]
      rfl
    exact (e _).trans ((congrArg _ (hk k)).trans (e _).symm)

theorem wc_proet_thickening_clopen_lift {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I] (Vt : Y.ProEt)
    (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I)))
    (hsq : IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))
    (m : ℕ) (Q : Fin m → Z.ProEt) (ι : ∀ k, Q k ⟶ (wcProEtBaseChange i).obj Vt)
    (hι : ∀ k, IsOpenImmersion (ι k).left)
    (hpart : ∀ x : ((wcProEtBaseChange i).obj Vt).left, ∃! k, x ∈ Set.range (ι k).left) :
    ∃ (Vk : Fin m → Y.ProEt) (ιt : ∀ k, Vk k ⟶ Vt)
      (κ : ∀ k, (wcProEtBaseChange i).obj (Vk k) ≅ Q k),
      (∀ k, IsOpenImmersion (ιt k).left) ∧ (∀ x : Vt.left, ∃! k, x ∈ Set.range (ιt k).left) ∧
      (∀ k, (κ k).hom ≫ ι k = (wcProEtBaseChange i).map (ιt k)) ∧
      ∀ k, ∃ (Ak : Type u) (_ : CommRing Ak) (Ik : Ideal Ak) (_ : HenselianRing Ak Ik)
        (ek : (Vk k).left ≅ Spec (.of Ak)) (ck : Limits.pullback (Vk k).hom i ⟶ Spec (.of (Ak ⧸ Ik))),
        IsPullback (Limits.pullback.fst (Vk k).hom i) ck ek.hom
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Ik))) :=
by
  classical

  have s1 : ∀ (B : Type u) [CommRing B] (φ : A →+* B),
      IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map φ))))
        (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map φ) φ Ideal.le_comap_map)))
        (Spec.map (CommRingCat.ofHom φ)) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
    intro B _ φ
    apply isPullback_SpecMap_of_isPushout
    have hle : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I)), ∀ a ∈ I.map φ, s.inl.hom a = 0 := by
      intro s a ha
      have hle : I.map φ ≤ RingHom.ker s.inl.hom := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        have := congrArg (fun f => f.hom x) s.condition
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
        rw [Ideal.mem_comap, RingHom.mem_ker, this, Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
      exact (RingHom.mem_ker).1 (hle ha)
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ ?_) ?_
    · ext x; simp [Ideal.quotientMap_mk]
    · refine Limits.PushoutCocone.IsColimit.mk _
        (fun s => CommRingCat.ofHom (Ideal.Quotient.lift (I.map φ) s.inl.hom (hle s))) ?_ ?_ ?_
      · intro s; ext x
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
          Ideal.Quotient.lift_mk]
      · intro s
        ext x
        have := congrArg (fun f => f.hom x) s.condition
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
          Ideal.quotientMap_mk, Ideal.Quotient.lift_mk]
        exact this
      · intro s m h1 h2
        ext x
        have := congrArg (fun f => f.hom x) h1
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this ⊢
        simp only [Ideal.Quotient.lift_mk, this]

  have s4 : ∀ (ε : A), IsIdempotentElem ε →
      HenselianRing (Localization.Away ε) (I.map (algebraMap A (Localization.Away ε))) := by
    open Polynomial in (
    intro ε hε
    set B := Localization.Away ε
    set φ := algebraMap A B with hφdef
    have hεε : ε * ε = ε := hε
    have h1 : φ ε = 1 := by
      have hu : IsUnit (φ ε) := IsLocalization.Away.algebraMap_isUnit ε
      apply hu.mul_left_cancel
      rw [← map_mul, hεε, mul_one]
    have hpow : ∀ t ∈ Submonoid.powers ε, φ t = 1 := by
      rintro t ⟨n, rfl⟩
      rw [map_pow, h1, one_pow]
    have hsurj : Function.Surjective φ := by
      intro z
      obtain ⟨⟨a, t⟩, ht⟩ := IsLocalization.surj (Submonoid.powers ε) z
      refine ⟨a, ?_⟩
      simp only at ht
      rw [hpow t t.2, mul_one] at ht
      exact ht.symm
    have hker : ∀ x, φ x = 0 → ε * x = 0 := by
      intro x hx
      obtain ⟨⟨t, n, rfl⟩, ht⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers ε) B x).1 hx
      simp only at ht
      rw [← hε.pow_succ_eq n, pow_succ', mul_assoc, ht, mul_zero]
    have hJ : ∀ {y : B}, y ∈ I.map φ ↔ ∃ x ∈ I, φ x = y := fun {y} =>
      Ideal.mem_map_iff_of_surjective φ hsurj
    have hεJ : ∀ y : A, φ y ∈ I.map φ → ε * y ∈ I := by
      intro y hy
      obtain ⟨x, hx, hxy⟩ := hJ.1 hy
      have : ε * (y - x) = 0 := hker _ (by rw [map_sub, hxy, sub_self])
      have e : ε * y = ε * x := by linear_combination this
      rw [e]; exact I.mul_mem_left _ hx
    have jacB : I.map φ ≤ (⊥ : Ideal B).jacobson := by
      intro y hy
      obtain ⟨x, hx, rfl⟩ := hJ.1 hy
      rw [Ideal.mem_jacobson_bot]
      intro z
      obtain ⟨w, rfl⟩ := hsurj z
      have := Ideal.mem_jacobson_bot.1 (HenselianRing.jac hx) w
      have h2 := this.map φ
      simpa only [map_add, map_mul, map_one] using h2
    refine ⟨jacB, ?_⟩
    intro f hf b₀ hb₀ hunit
    by_cases hn : f.natDegree = 0
    · have hf1 : f = 1 := eq_one_of_monic_natDegree_zero hf hn
      rw [hf1, eval_one] at hb₀
      have hu := Ideal.mem_jacobson_bot.1 (jacB hb₀) (-1)
      rw [one_mul, neg_add_cancel] at hu
      have : Subsingleton B := subsingleton_of_zero_eq_one (isUnit_zero_iff.1 hu)
      exact ⟨b₀, Subsingleton.elim _ _, by rw [sub_self]; exact Ideal.zero_mem _⟩
    set n := f.natDegree with hndef
    obtain ⟨F, hFf, hFn, hFm⟩ := lifts_and_natDegree_eq_and_monic
      ((mem_lifts f).2 (map_surjective φ hsurj f)) hf
    obtain ⟨a₀, rfl⟩ := hsurj b₀
    set K : Polynomial A := (X - C (a₀ + 1)) ^ (n - 1) with hK
    set H : Polynomial A := (X - C a₀) * K with hH
    set s : A := (-1) ^ (n - 1) with hs
    have hss : s * s = 1 := by
      rw [hs, ← mul_pow, neg_one_mul, neg_neg, one_pow]
    have hKm : K.Monic := (monic_X_sub_C _).pow _
    have hHm : H.Monic := (monic_X_sub_C _).mul hKm
    have hHn : H.natDegree ≤ n := by
      rw [hH, (monic_X_sub_C _).natDegree_mul hKm, hK, (monic_X_sub_C _).natDegree_pow]
      have h1 := natDegree_X_sub_C_le (R := A) a₀
      have h2 := natDegree_X_sub_C_le (R := A) (a₀ + 1)
      have h3 : (n - 1) * (X - C (a₀ + 1)).natDegree ≤ (n - 1) * 1 := Nat.mul_le_mul_left _ h2
      omega
    have hKa : K.eval a₀ = s := by
      rw [hK, eval_pow, eval_sub, eval_X, eval_C, hs]; congr 1; ring
    have hHa : H.eval a₀ = 0 := by
      rw [hH, eval_mul, eval_sub, eval_X, eval_C, sub_self, zero_mul]
    have hH'a : (derivative H).eval a₀ = s := by
      rw [hH, derivative_mul, derivative_sub, derivative_X, derivative_C, sub_zero, one_mul,
        eval_add, eval_mul, eval_sub, eval_X, eval_C, sub_self, zero_mul, add_zero, hKa]
    set G : Polynomial A := C ε * F + C (1 - ε) * H with hG
    have hGm : G.Monic := by
      rcases subsingleton_or_nontrivial A with hA | hA
      · exact monic_of_subsingleton _
      have hHn' : H.natDegree = n := by
        rw [hH, (monic_X_sub_C _).natDegree_mul hKm, natDegree_X_sub_C, hK,
          (monic_X_sub_C _).natDegree_pow, natDegree_X_sub_C]
        omega
      apply monic_of_natDegree_le_of_coeff_eq_one n
      · rw [hG]
        refine (natDegree_add_le _ _).trans (max_le ?_ ?_)
        · exact (natDegree_C_mul_le _ _).trans hFn.le
        · exact (natDegree_C_mul_le _ _).trans hHn
      · rw [hG, coeff_add, coeff_C_mul, coeff_C_mul]
        have e1 : F.coeff n = 1 := by
          have := hFm.coeff_natDegree; rwa [hFn] at this
        have e2 : H.coeff n = 1 := by
          have := hHm.coeff_natDegree; rwa [hHn'] at this
        rw [e1, e2]; ring
    have hGf : G.map φ = f := by
      rw [hG, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, map_C, map_C, hFf,
        map_sub, map_one, h1, sub_self, C_0, zero_mul, add_zero, C_1, one_mul]
    have hGa : G.eval a₀ ∈ I := by
      rw [hG, eval_add, eval_mul, eval_mul, eval_C, eval_C, hHa, mul_zero, add_zero]
      apply hεJ
      rw [← eval_map_apply, hFf]
      exact hb₀
    have hG'a : IsUnit (Ideal.Quotient.mk I ((derivative G).eval a₀)) := by
      obtain ⟨v, hv⟩ := hunit.exists_right_inv
      obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective v
      obtain ⟨w, rfl⟩ := hsurj v
      have hfd : (derivative f).eval (φ a₀) = φ ((derivative F).eval a₀) := by
        rw [← hFf, derivative_map, eval_map_apply]
      rw [hfd, ← map_mul, ← map_one (Ideal.Quotient.mk (I.map φ)),
        Ideal.Quotient.mk_eq_mk_iff_sub_mem, ← map_mul, ← map_one φ, ← map_sub] at hv
      have hx' := hεJ _ hv
      have hdG : (derivative G).eval a₀ = ε * (derivative F).eval a₀ + (1 - ε) * s := by
        rw [hG, derivative_add, derivative_C_mul, derivative_C_mul, eval_add, eval_mul, eval_mul,
          eval_C, eval_C, hH'a]
      refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk I (ε * w + (1 - ε) * s)) ?_
      rw [← map_mul, ← map_one (Ideal.Quotient.mk I), Ideal.Quotient.mk_eq_mk_iff_sub_mem, hdG]
      have e : (ε * eval a₀ (derivative F) + (1 - ε) * s) * (ε * w + (1 - ε) * s) - 1 =
          ε * (eval a₀ (derivative F) * w - 1) +
            (eval a₀ (derivative F) * w - eval a₀ (derivative F) * s - s * w + s * s) *
              (ε * ε - ε) + (1 - ε) * (s * s - 1) := by ring
      rw [e, hεε, hss, sub_self, sub_self, mul_zero, mul_zero, add_zero, add_zero]
      exact hx'
    obtain ⟨a, ha, haa⟩ := HenselianRing.is_henselian G hGm a₀ hGa hG'a
    refine ⟨φ a, ?_, ?_⟩
    · show eval (φ a) f = 0
      rw [← hGf, eval_map_apply]
      have : eval a G = 0 := ha
      rw [this, map_zero]
    · rw [← map_sub]; exact Ideal.mem_map_of_mem _ haa)

  have range_iso_comp : ∀ {X X' W : Scheme.{u}} (φ : X ⟶ X') [IsIso φ] (f : X' ⟶ W) (z : W),
      z ∈ Set.range (φ ≫ f) ↔ z ∈ Set.range f := by
    intro X X' W φ _ f z
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨φ y, (Scheme.Hom.comp_apply φ f y).symm⟩
    · rintro ⟨y, rfl⟩
      refine ⟨inv φ y, ?_⟩
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (inv φ) φ, IsIso.inv_hom_id]
      rfl

  have s6 : ∀ {W V : Y.ProEt} (a : W ⟶ V), IsOpenImmersion a.left →
      IsOpenImmersion ((wcProEtBaseChange i).map a).left ∧
        ∀ x : ((wcProEtBaseChange i).obj V).left,
          x ∈ Set.range ((wcProEtBaseChange i).map a).left ↔
            Limits.pullback.fst V.hom i x ∈ Set.range a.left := by
    intro W V a ha
    have hw : (Limits.pullback.fst W.hom i ≫ a.left) ≫ V.hom =
        Limits.pullback.snd W.hom i ≫ i := by
      rw [Category.assoc, MorphismProperty.Over.w a]; exact Limits.pullback.condition
    let b : Limits.pullback W.hom i ⟶ Limits.pullback V.hom i :=
      Limits.pullback.lift (Limits.pullback.fst W.hom i ≫ a.left) (Limits.pullback.snd W.hom i) hw
    have hb : ((wcProEtBaseChange i).map a).left = b := rfl
    have sq : IsPullback b (Limits.pullback.fst W.hom i) (Limits.pullback.fst V.hom i) a.left := by
      have big : IsPullback (b ≫ Limits.pullback.snd V.hom i) (Limits.pullback.fst W.hom i) i
          (a.left ≫ V.hom) := by
        rw [Limits.pullback.lift_snd, MorphismProperty.Over.w a]
        exact (IsPullback.of_hasPullback W.hom i).flip
      exact IsPullback.of_right big (Limits.pullback.lift_fst _ _ _)
        (IsPullback.of_hasPullback V.hom i).flip
    have hrange : ∀ x : ↥(Limits.pullback V.hom i),
        x ∈ Set.range b ↔ Limits.pullback.fst V.hom i x ∈ Set.range a.left := by
      intro x
      have e1 : b = sq.isoPullback.hom ≫ Limits.pullback.fst (Limits.pullback.fst V.hom i) a.left :=
        (IsPullback.isoPullback_hom_fst sq).symm
      rw [e1, range_iso_comp, Scheme.Pullback.range_fst]
      rfl
    rw [hb]
    exact ⟨MorphismProperty.of_isPullback (P := @IsOpenImmersion) sq.flip ha, fun x => hrange x⟩

  have s7 : ∀ {X₁ X₂ P : Z.ProEt} (f : X₁ ⟶ P) (g : X₂ ⟶ P),
      IsOpenImmersion f.left → IsOpenImmersion g.left →
      Set.range f.left = Set.range g.left → ∃ κ : X₁ ≅ X₂, κ.hom ≫ g = f := by
    intro X₁ X₂ P f g hf hg h
    let ψ := IsOpenImmersion.isoOfRangeEq f.left g.left h
    have hψ : ψ.hom ≫ g.left = f.left := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
    have w : ψ.hom ≫ X₂.hom = X₁.hom := by
      rw [← MorphismProperty.Over.w g, ← Category.assoc, hψ, MorphismProperty.Over.w f]
    refine ⟨MorphismProperty.Over.isoMk ψ w, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact hψ

  have s8 : ∀ (B : Type u) [CommRing B] (φ : A →+* B) (u : Spec (.of B) ⟶ Vt.left),
      u ≫ e.hom = Spec.map (CommRingCat.ofHom φ) → ∀ (J : Ideal B)
      (σ : Spec (.of (B ⧸ J)) ⟶ Spec (.of (A ⧸ I))),
      IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) σ
        (Spec.map (CommRingCat.ofHom φ)) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) →
      ∃ ck : Limits.pullback (u ≫ Vt.hom) i ⟶ Spec (.of (B ⧸ J)),
        IsPullback (Limits.pullback.fst (u ≫ Vt.hom) i) ck (𝟙 (Spec (.of B)))
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
    intro B _ φ u hu J σ hring
    have hw : (Limits.pullback.fst (u ≫ Vt.hom) i ≫ u) ≫ Vt.hom =
        Limits.pullback.snd (u ≫ Vt.hom) i ≫ i := by
      rw [Category.assoc]; exact Limits.pullback.condition
    let g : Limits.pullback (u ≫ Vt.hom) i ⟶ Limits.pullback Vt.hom i :=
      Limits.pullback.lift (Limits.pullback.fst (u ≫ Vt.hom) i ≫ u)
        (Limits.pullback.snd (u ≫ Vt.hom) i) hw
    have top : IsPullback g (Limits.pullback.fst (u ≫ Vt.hom) i) (Limits.pullback.fst Vt.hom i) u := by
      have big : IsPullback (g ≫ Limits.pullback.snd Vt.hom i) (Limits.pullback.fst (u ≫ Vt.hom) i)
          i (u ≫ Vt.hom) := by
        rw [Limits.pullback.lift_snd]
        exact (IsPullback.of_hasPullback (u ≫ Vt.hom) i).flip
      exact IsPullback.of_right big (Limits.pullback.lift_fst _ _ _)
        (IsPullback.of_hasPullback Vt.hom i).flip
    have big2 := top.flip.paste_vert hsq
    rw [hu] at big2
    let ψ := IsPullback.isoIsPullback _ _ big2 hring
    have hψ : ψ.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) =
        Limits.pullback.fst (u ≫ Vt.hom) i := IsPullback.isoIsPullback_hom_fst _ _ _ _
    refine ⟨ψ.hom, ?_⟩
    refine IsPullback.of_vert_isIso ⟨?_⟩
    rw [Category.comp_id, hψ]

  have hc : IsIso c := hsq.isIso_snd_of_isIso

  have s5 : ∃ eb : Fin m → A ⧸ I, (∀ k, IsIdempotentElem (eb k)) ∧
      (∀ k (x : ((wcProEtBaseChange i).obj Vt).left),
        x ∈ Set.range (ι k).left ↔ c x ∈ PrimeSpectrum.basicOpen (eb k)) ∧
      ∀ s : PrimeSpectrum (A ⧸ I), ∃! k, s ∈ PrimeSpectrum.basicOpen (eb k) := by
    let U : Fin m → Set ((wcProEtBaseChange i).obj Vt).left := fun k => Set.range (ι k).left
    have hU : ∀ k, IsOpen (U k) := fun k => (ι k).left.isOpenEmbedding.isOpen_range
    let h : ((wcProEtBaseChange i).obj Vt).left ≃ₜ PrimeSpectrum (A ⧸ I) := c.homeomorph
    have hclopen : ∀ k, IsClopen (U k) := by
      intro k
      refine ⟨?_, hU k⟩
      have : (U k)ᶜ = ⋃ l ∈ {l | l ≠ k}, U l := by
        ext x
        simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
        constructor
        · intro hx
          obtain ⟨l, hl, _⟩ := hpart x
          exact ⟨l, fun hlk => hx (hlk ▸ hl), hl⟩
        · rintro ⟨l, hlk, hl⟩ hx
          obtain ⟨j, _, hj⟩ := hpart x
          exact hlk ((hj l hl).trans (hj k hx).symm)
      rw [← isOpen_compl_iff, this]
      exact isOpen_biUnion (fun l _ => hU l)
    have hS : ∀ k, ∃ e : A ⧸ I, IsIdempotentElem e ∧
        h.symm ⁻¹' U k = (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum (A ⧸ I))) := by
      intro k
      exact PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen
        ((hclopen k).preimage h.symm.continuous)
    choose eb heb hebS using hS
    have hmem : ∀ k (x : ((wcProEtBaseChange i).obj Vt).left),
        x ∈ U k ↔ c x ∈ PrimeSpectrum.basicOpen (eb k) := by
      intro k x
      have e1 : (c x ∈ PrimeSpectrum.basicOpen (eb k)) = (h x ∈ h.symm ⁻¹' U k) := by
        rw [hebS k]; rfl
      rw [e1, Set.mem_preimage, Homeomorph.symm_apply_apply]
    refine ⟨eb, heb, hmem, fun s => ?_⟩
    have key : c (h.symm s) = s := Homeomorph.apply_symm_apply h s
    obtain ⟨k, hk, hu⟩ := hpart (h.symm s)
    refine ⟨k, ?_, fun l hl => hu l ((hmem l _).2 ?_)⟩
    · have := (hmem k _).1 hk
      rw [key] at this
      exact this
    · rw [key]
      exact hl
  obtain ⟨eb, heb, hmem, hpartR⟩ := s5

  have s3 : ∃ ε : Fin m → A, (∀ k, IsIdempotentElem (ε k)) ∧
      (∀ k, Ideal.Quotient.mk I (ε k) = eb k) ∧
      ∀ p : PrimeSpectrum A, ∃! k, p ∈ PrimeSpectrum.basicOpen (ε k) := by
    have hlift : ∀ k, ∃ e : A, IsIdempotentElem e ∧ Ideal.Quotient.mk I e = eb k := by
      intro k
      obtain ⟨a₀, ha₀⟩ := Ideal.Quotient.mk_surjective (eb k)
      have he : eb k * eb k = eb k := heb k
      have hmon : (Polynomial.X ^ 2 - Polynomial.X : Polynomial A).Monic :=
        Polynomial.monic_X_pow_sub (lt_of_le_of_lt Polynomial.degree_X_le
          (by exact_mod_cast (by norm_num : (1:ℕ) < 2)))
      have h1 : Polynomial.eval a₀ (Polynomial.X ^ 2 - Polynomial.X : Polynomial A) ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, map_sub,
          map_pow, ha₀]
        rw [sq, he, sub_self]
      have h2 : IsUnit (Ideal.Quotient.mk I (Polynomial.eval a₀
          (Polynomial.derivative (Polynomial.X ^ 2 - Polynomial.X : Polynomial A)))) := by
        have hd : Polynomial.eval a₀
            (Polynomial.derivative (Polynomial.X ^ 2 - Polynomial.X : Polynomial A)) =
            2 * a₀ - 1 := by
          simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow,
            Polynomial.derivative_X, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
            Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one]
          norm_num
        have he' : Ideal.Quotient.mk I a₀ * Ideal.Quotient.mk I a₀ = Ideal.Quotient.mk I a₀ := by
          rw [ha₀]; exact he
        rw [hd]
        refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk I (2 * a₀ - 1)) ?_
        simp only [map_mul, map_sub, map_ofNat, map_one]
        linear_combination (4 : A ⧸ I) * he'
      obtain ⟨a, ha, ha'⟩ := HenselianRing.is_henselian _ hmon a₀ h1 h2
      refine ⟨a, ?_, ?_⟩
      · have : Polynomial.eval a (Polynomial.X ^ 2 - Polynomial.X : Polynomial A) = 0 := ha
        simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X] at this
        show a * a = a
        linear_combination this
      · rw [← ha₀]
        exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem a a₀).2 ha'
    choose ε hε hεb using hlift
    refine ⟨ε, hε, hεb, fun p => ?_⟩
    obtain ⟨M, hM, hpM⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    have := hM.isPrime
    have hIM : I ≤ M := by
      intro x hx
      have hj := HenselianRing.jac hx
      rw [Ideal.jacobson, Ideal.mem_sInf] at hj
      exact hj ⟨bot_le, hM⟩
    have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ M := by rw [Ideal.mk_ker]; exact hIM
    let q : PrimeSpectrum (A ⧸ I) :=
      ⟨M.map (Ideal.Quotient.mk I), Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker⟩
    have key : ∀ k, p ∈ PrimeSpectrum.basicOpen (ε k) ↔ q ∈ PrimeSpectrum.basicOpen (eb k) := by
      intro k
      rw [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.mem_basicOpen, not_iff_not]
      show ε k ∈ p.asIdeal ↔ eb k ∈ M.map (Ideal.Quotient.mk I)
      rw [← hεb k, Ideal.mem_quotient_iff_mem hIM]
      constructor
      · exact fun h => hpM h
      · intro hM'
        by_contra hp
        have h0 : ε k * (1 - ε k) ∈ p.asIdeal := by
          have : ε k * (1 - ε k) = 0 := by
            have := hε k
            unfold IsIdempotentElem at this
            rw [mul_sub, mul_one, this, sub_self]
          rw [this]; exact p.asIdeal.zero_mem
        have h1 : 1 - ε k ∈ M := hpM ((p.isPrime.mem_or_mem h0).resolve_left hp)
        have : (1 : A) ∈ M := by
          have := M.add_mem hM' h1
          rwa [add_sub_cancel] at this
        exact hM.ne_top ((Ideal.eq_top_iff_one M).2 this)
    obtain ⟨k, hk, hu⟩ := hpartR q
    exact ⟨k, (key k).2 hk, fun l hl => hu l ((key l).1 hl)⟩
  obtain ⟨ε, hε, hεb, hpartA⟩ := s3

  have hrange : ∀ k (x : Vt.left),
      x ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (ε k)))) ≫ e.inv) ↔
        e.hom x ∈ PrimeSpectrum.basicOpen (ε k) := by
    intro k x
    have h2 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (ε k))))) =
        (PrimeSpectrum.basicOpen (ε k) : Set (PrimeSpectrum A)) :=
      PrimeSpectrum.localization_away_comap_range _ _
    have h3 : ∀ y : Spec (.of A), y ∈ PrimeSpectrum.basicOpen (ε k) ↔
        y ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (ε k))))) := by
      intro y; rw [h2]; rfl
    rw [h3]
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨y, ?_⟩
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply e.inv e.hom, Iso.inv_hom_id]
      rfl
    · rintro ⟨y, hy⟩
      refine ⟨y, ?_⟩
      rw [Scheme.Hom.comp_apply, hy, ← Scheme.Hom.comp_apply e.hom e.inv, Iso.hom_inv_id]
      rfl
  have hcov : ∀ x : Vt.left, ∃! k,
      x ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (ε k)))) ≫ e.inv) := by
    intro x
    obtain ⟨k, hk, hu⟩ := hpartA (e.hom x)
    exact ⟨k, (hrange k x).2 hk, fun l hl => hu l ((hrange l x).1 hl)⟩
  have hopen : ∀ k, IsOpenImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (ε k)))) ≫ e.inv) :=
    fun k => inferInstance

  have := Vt.prop
  let u : ∀ k, Spec (.of (Localization.Away (ε k))) ⟶ Vt.left := fun k =>
    Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (ε k)))) ≫ e.inv
  have hWE : ∀ k, WeaklyEtale (u k ≫ Vt.hom) := fun k => by
    have := hopen k
    infer_instance
  let Vk : Fin m → Y.ProEt := fun k => @Scheme.ProEt.mk _ _ (u k ≫ Vt.hom) (hWE k)
  let ιt : ∀ k, Vk k ⟶ Vt := fun k => MorphismProperty.Over.homMk (u k) rfl trivial
  have hιt : ∀ k, IsOpenImmersion (ιt k).left := fun k => hopen k

  have hκ : ∀ k, ∃ κ : (wcProEtBaseChange i).obj (Vk k) ≅ Q k,
      κ.hom ≫ ι k = (wcProEtBaseChange i).map (ιt k) := by
    intro k
    obtain ⟨hbo, hbr⟩ := s6 (ιt k) (hιt k)
    refine s7 _ _ hbo (hι k) ?_
    ext x
    rw [hbr x]
    show Limits.pullback.fst Vt.hom i x ∈ Set.range (u k) ↔ _
    rw [hrange k]
    have e1 : ∀ y : ↥(Limits.pullback Vt.hom i), e.hom (Limits.pullback.fst Vt.hom i y) =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) (c y) := by
      intro y
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hsq.w]
    rw [e1 x, hmem k x]
    rw [← hεb k]
    exact Iff.rfl
  choose κ hκ' using hκ
  refine ⟨Vk, ιt, κ, hιt, hcov, hκ', fun k => ?_⟩

  let Ak := Localization.Away (ε k)
  let φk : A →+* Ak := algebraMap A Ak
  have hH : HenselianRing Ak (I.map φk) := s4 (ε k) (hε k)
  have hu : u k ≫ e.hom = Spec.map (CommRingCat.ofHom φk) := by
    simp only [u, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  obtain ⟨ck, hck⟩ := s8 Ak φk (u k) hu (I.map φk)
    (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map φk) φk Ideal.le_comap_map)))
    (s1 Ak φk)
  exact ⟨Ak, inferInstance, I.map φk, hH, Iso.refl _, ck, hck⟩

theorem wc_proet_lan_clopen_additive {Y Z : Scheme.{u}} (i : Z ⟶ Y) (Vt : Y.ProEt)
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (m : ℕ) (Q : Fin m → Z.ProEt) (ι : ∀ k, Q k ⟶ (wcProEtBaseChange i).obj Vt)
    (Vk : Fin m → Y.ProEt) (ιt : ∀ k, Vk k ⟶ Vt) (κ : ∀ k, (wcProEtBaseChange i).obj (Vk k) ≅ Q k)
    (hιt : ∀ k, IsOpenImmersion (ιt k).left) (hpart : ∀ x : Vt.left, ∃! k, x ∈ Set.range (ιt k).left)
    (hκ : ∀ k, (κ k).hom ≫ ι k = (wcProEtBaseChange i).map (ιt k))
    (hη0 : Function.Bijective (((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op Vt)).hom)
    (hηk : ∀ k, Function.Bijective
      (((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op (Vk k))).hom) :
    Function.Bijective (fun s : ((wcProEtBaseChange i).op.lan.obj G.obj).obj
        (Opposite.op ((wcProEtBaseChange i).obj Vt)) =>
      fun k => (((wcProEtBaseChange i).op.lan.obj G.obj).map (ι k).op).hom s) :=
by

  have s2a : ∀ {Z : Scheme.{u}} (U : Z.ProEt) (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ U),
      (∀ k, IsOpenImmersion (ι k).left) → (∀ x : U.left, ∃ k, x ∈ Set.range ⇑(ι k).left) →
      Presieve.ofArrows P ι ∈ (Scheme.ProEt.precoverage Z).coverings U := by
    intro Z U n P ι hopen hsurj
    show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Z ⋙ Over.forget Z)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    let 𝒰 : Scheme.Cover (Scheme.precoverage @IsOpenImmersion) U.left :=
      Scheme.Cover.mkOfCovers (Fin n) (fun k => (P k).left) (fun k => (ι k).left)
        (fun x => by
          obtain ⟨k, y, hy⟩ := hsurj x
          exact ⟨k, y, hy⟩) (fun k => hopen k)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      QuasiCompactCover.of_isOpenMap (fun k => by
        have := hopen k
        exact (ι k).left.isOpenEmbedding.isOpenMap)
    have h1 : 𝒰.presieve₀ ∈ Scheme.qcPrecoverage.coverings U.left :=
      Scheme.presieve₀_mem_qcPrecoverage_iff.mpr hqc
    change Presieve.ofArrows (fun k => (P k).left) (fun k => (ι k).left) ∈
      Scheme.proetalePrecoverage.coverings U.left
    exact ⟨h1, (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr ⟨hsurj, fun k => by
      have := hopen k
      infer_instance⟩⟩

  have s2b : ∀ {Z : Scheme.{u}} (F : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (U : Z.ProEt) (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ U),
      Presieve.ofArrows P ι ∈ (Scheme.ProEt.precoverage Z).coverings U →
      (∀ k, IsOpenImmersion (ι k).left) →
      (∀ (j k : Fin n) (x : U.left), x ∈ Set.range ⇑(ι j).left → x ∈ Set.range ⇑(ι k).left →
        j = k) →
      Function.Bijective (fun t : F.obj.obj (Opposite.op U) =>
        fun k => (F.obj.map (ι k).op).hom t) := by
    intro Z F U n P ι hcov hopen hdisj
    have hF : Presieve.IsSheaf (Scheme.ProEt.topology Z) (F.obj ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp (GrothendieckTopology.HasSheafCompose.isSheaf _ F.2)
    have hSF : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat) (Presieve.ofArrows P ι) :=
      Presieve.IsSheaf.isSheafFor_of_mem_precoverage (J := Scheme.ProEt.precoverage Z) hF hcov
    rw [Presieve.isSheafFor_arrows_iff] at hSF
    have hcompat : ∀ x : ∀ k, (F.obj ⋙ forget AddCommGrpCat).obj (Opposite.op (P k)),
        Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat) ι x := by
      intro x j k W a b hab
      by_cases hjk : j = k
      · subst hjk
        have := hopen j
        have hm : Mono ((Scheme.ProEt.forget Z ⋙ Over.forget Z).map (ι j)) :=
          IsOpenImmersion.mono (ι j).left
        have : Mono (ι j) := Functor.mono_of_mono_map (Scheme.ProEt.forget Z ⋙ Over.forget Z) hm
        rw [(cancel_mono (ι j)).mp hab]
      · have : IsEmpty W.left := ⟨fun w => hjk (hdisj j k ((ι j).left (a.left w))
          ⟨a.left w, rfl⟩ ⟨b.left w, by
            have e : a.left ≫ (ι j).left = b.left ≫ (ι k).left := congrArg (fun h => h.left) hab
            have hw := congrArg (fun g : W.left ⟶ U.left => g w) e
            simp only [Scheme.Hom.comp_apply] at hw
            exact hw.symm⟩)⟩
        have ht := Sheaf.isTerminalOfBotCover F W (Scheme.ProEt.bot_mem_topology W)
        have hsub : ∀ y : ToType (F.obj.obj (Opposite.op W)), y = 0 := by
          intro y
          have h0 : 𝟙 (F.obj.obj (Opposite.op W)) = 0 := ht.hom_ext _ _
          have := congrArg (fun g => g.hom y) h0
          simpa using this
        exact (hsub _).trans (hsub _).symm
    constructor
    · intro t t' htt
      obtain ⟨u, hu, huniq⟩ := hSF (fun k => (F.obj.map (ι k).op).hom t) (hcompat _)
      have h1 := huniq t (fun k => rfl)
      have h2 := huniq t' (fun k => (congrFun htt k).symm)
      exact h1.trans h2.symm
    · intro x
      obtain ⟨u, hu, -⟩ := hSF x (hcompat x)
      exact ⟨u, funext hu⟩

  have hρ := s2b G Vt m Vk ιt (s2a Vt m Vk ιt hιt (fun x => (hpart x).exists)) hιt
    (fun j k x hj hk => (hpart x).unique hj hk)

  have hsq : ∀ (t : G.obj.obj (Opposite.op Vt)) (k : Fin m),
      (((wcProEtBaseChange i).op.lan.obj G.obj).map (κ k).hom.op).hom
        ((((wcProEtBaseChange i).op.lan.obj G.obj).map (ι k).op).hom
          ((((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op Vt)).hom t)) =
      (((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op (Vk k))).hom
        ((G.obj.map (ιt k).op).hom t) := by
    intro t k
    have h2 : ((wcProEtBaseChange i).op.lan.obj G.obj).map (ι k).op ≫
        ((wcProEtBaseChange i).op.lan.obj G.obj).map (κ k).hom.op =
        ((wcProEtBaseChange i).op.lan.obj G.obj).map ((wcProEtBaseChange i).map (ιt k)).op := by
      rw [← Functor.map_comp, ← op_comp, hκ k]
    have h3 := ((wcProEtBaseChange i).op.lanUnit.app G.obj).naturality (ιt k).op
    have h4 : ((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op Vt) ≫
        ((wcProEtBaseChange i).op.lan.obj G.obj).map (ι k).op ≫
        ((wcProEtBaseChange i).op.lan.obj G.obj).map (κ k).hom.op =
        G.obj.map (ιt k).op ≫
          ((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op (Vk k)) := by
      rw [h2]
      exact h3.symm
    exact congrArg (fun f => f.hom t) h4

  have hβ : ∀ k, Function.Bijective
      (((wcProEtBaseChange i).op.lan.obj G.obj).map (κ k).hom.op).hom := fun k =>
    ConcreteCategory.bijective_of_isIso
      (((wcProEtBaseChange i).op.lan.obj G.obj).mapIso (κ k).op).hom

  refine (Function.Bijective.of_comp_iff _ hη0).mp ?_
