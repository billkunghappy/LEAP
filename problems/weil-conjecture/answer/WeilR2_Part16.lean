    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') ã) ℓ)) := HasExt.standard _
    Function.Bijective (fun r : C(↥(Spec (.of (LocallyConstant S B))), ULift.{u+1} ℚ_[ℓ]) =>
      (Abelian.Ext.mk₀ (wcHMFun _ ℓ (r.comp (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
