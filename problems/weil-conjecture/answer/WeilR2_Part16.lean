theorem wc_pencil_R2_deck_trivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (γ : W ⟶ W) (hγ : γ ≫ w = w) :
    ∀ τ : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      ((wcRq D.f ℓ (2 * (n - 1))).obj.map γ.op).hom τ = τ :=
by
  classical
  obtain ⟨r, ⟨κ⟩⟩ := wc_pencil_R2_geomConst_offS F' F'' Y n hn hn2 D ℓ hℓ hP

  have hcl := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hrange : Set.range W.hom ⊆ Set.range (wcPencilSOpen D).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    show W.hom z ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ
    intro hmem
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hmem
    have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
        {p : (wcP1Over F'').left | ∃ j : Fin D.m, p = D.S j (IsLocalRing.closedPoint F'')} :=
      closure_minimal (fun p hp => ⟨i, hp⟩) hcl
    obtain ⟨j, hj⟩ := hsub hi
    exact hoff z j hj

  let a := IsOpenImmersion.lift (wcPencilSOpen D).ι W.hom hrange
  have ha : a ≫ (wcPencilSOpen D).ι = W.hom := IsOpenImmersion.lift_fac _ _ _
  have hwp : w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom = W.hom :=
    MorphismProperty.Over.w w
  have hsq : a ≫ (wcPencilSOpen D).ι = w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    ha.trans hwp.symm
  let w'L : W.left ⟶ Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    Limits.pullback.lift a w.left hsq
  have hw'L : w'L ≫ (Limits.pullback.snd (wcPencilSOpen D).ι
      (wcGeomPoint F'' (wcP1Over F'') hP).hom ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) =
      W.hom := by
    rw [← Category.assoc, Limits.pullback.lift_snd, hwp]
  let w' : W ⟶ wcPencilGeomOffS D hP := MorphismProperty.Over.homMk w'L hw'L trivial
  have hγW : γ.left ≫ W.hom = W.hom := MorphismProperty.Over.w γ
  have hγw : γ.left ≫ w.left = w.left := by
    have h1 : (γ ≫ w).left = w.left := congrArg (fun m => m.left) hγ
    exact h1
  have hγa : γ.left ≫ a = a := by
    rw [← cancel_mono (wcPencilSOpen D).ι, Category.assoc, ha, hγW]
  have hγ' : γ ≫ w' = w' := by
    apply MorphismProperty.Over.Hom.ext
    show γ.left ≫ w'L = w'L
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, hγa]
    · rw [Category.assoc, Limits.pullback.lift_snd, hγw]

  haveI := hconn
  intro τ
  have hcancel : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      (κ.inv.hom.app (Opposite.op (Over.mk w'))).hom
        ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom t) = t := by
    intro t
    exact congrArg (fun m => (m.hom.app (Opposite.op (Over.mk w'))).hom t) κ.hom_inv_id
  have hN := κ.hom.hom.naturality (Over.homMk γ hγ' : Over.mk w' ⟶ Over.mk w').op
  have hfix : (κ.hom.hom.app (Opposite.op (Over.mk w'))).hom
      (((wcRq D.f ℓ (2 * (n - 1))).obj.map γ.op).hom τ) =
      (κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ := by
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    have h1 : (show C(↥W.left, Fin r → ℚ_[ℓ]) from ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom
        (((wcRq D.f ℓ (2 * (n - 1))).obj.map γ.op).hom τ)).down) z =
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down) (γ.left z) :=
      congrArg (fun m => (show C(↥W.left, Fin r → ℚ_[ℓ]) from (m.hom τ).down) z) hN
    have h2 : (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down) (γ.left z) =
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down) z :=
      (isPreconnected_range (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down).continuous).subsingleton
        ⟨γ.left z, rfl⟩ ⟨z, rfl⟩
    exact h1.trans h2
  exact (hcancel _).symm.trans
    ((congrArg (κ.inv.hom.app (Opposite.op (Over.mk w'))).hom hfix).trans (hcancel τ))

theorem wc_mnt_inertia_top_trivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (τ : E ⟶ E) (hτ : τ ≫ a₀ = a₀)
    (Dτ : wcHMPullData ((wcProEtPullback D.f).map τ).left ℓ) (hDτ : wcHMPullCanonical Dτ) :
    ∀ z : wcHM ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)),
      wcHMPull Dτ (2 * (n - 1)) z = z :=
by
  classical
  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨v⟩ := wc_P1_strict_local_geomPoint_map F'' hP V A e
  have hγ : τ ≫ (a₀ ≫ v) = a₀ ≫ v := by rw [← Category.assoc, hτ]
  obtain ⟨pt, hpt⟩ : ∃ p : E.left, p = eE.inv (IsLocalRing.closedPoint L) := ⟨_, rfl⟩
  have hsub : ∀ z : E.left, z = pt := by
    intro z
    have h1 : eE.hom z = eE.hom pt := Subsingleton.elim _ _
    have h2 := congrArg (fun x => eE.inv x) h1
    simp only [Scheme.hom_inv_apply] at h2
    exact h2
  have hconn : ConnectedSpace E.left := by
    haveI : Subsingleton E.left := ⟨fun a b => (hsub a).trans (hsub b).symm⟩
    haveI hpre : PreconnectedSpace E.left :=
      ⟨Set.subsingleton_of_subsingleton.isPreconnected⟩
    exact { toPreconnectedSpace := hpre, toNonempty := ⟨pt⟩ }
  have hdeck := wc_pencil_R2_deck_trivial F' F'' Y n hn hn2 D ℓ hℓ hP E (a₀ ≫ v) hconn hE τ hγ
  haveI hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let φ : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    set q : Polynomial L := p.map (φ.symm : IsLocalRing.ResidueField L →+* L) with hq
    have hqs : q.Separable := hsep.map
    have hdeg : q.degree ≠ 0 := by
      rw [hq, Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root q hdeg hqs
    refine ⟨φ y, ?_⟩
    have hp : p = q.map (φ : L →+* IsLocalRing.ResidueField L) := by
      rw [hq, Polynomial.map_map]
      have : ((φ : L →+* IsLocalRing.ResidueField L).comp
          (φ.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
        ext z; simp
      rw [this, Polynomial.map_id]
    rw [hp, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (φ : L →+* IsLocalRing.ResidueField L) y).trans
      (by rw [hy.eq_zero, map_zero])
  have hEp := wc_proet_free_projective_strict_local (wcP1Over F'').left E L eE
  obtain ⟨Φ, -, hnat⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ
  intro z
  obtain ⟨t, rfl⟩ := (Φ (2 * (n - 1)) E hEp).surjective z
  have h1 := hnat (2 * (n - 1)) E E hEp hEp τ Dτ hDτ t
  rw [hdeck t] at h1
  exact h1.symm

theorem wc_pmn_resolution_lift {S' : Scheme.{u}} {w : S' ⟶ S'} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Dw : wcHMPullData w ℓ) :
