theorem wc_zmod_ct_slice_nat (T : Scheme.{u}) (n : ℕ) (hn : 0 < n) (V : T.ProEt)
    [(wcSliceFunctor T V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology T)]
    [(wcLpscG T V).Additive] [Limits.PreservesFiniteLimits (wcLpscG T V)]
    [Limits.PreservesFiniteColimits (wcLpscG T V)]
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n))]
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf V.left n))]
