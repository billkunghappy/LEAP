theorem wc_fgtor_rep_of_sheets : wcFpqcFamDescHyp.{u} → wcFpqcLcDescHyp.{u} → ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] [Finite Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → ∀ (O : U.Opens) (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u})) (σ : ∀ m, Γ → (W m ⟶ E)), IsFinite π → Etale π → (∀ m, Flat (w m ≫ v (k m))) → (∀ m, QuasiCompact (w m ≫ v (k m))) → (∀ m γ, σ m γ ≫ π ≫ O.ι = w m ≫ v (k m)) → (∀ x : U, x ∈ O → ∃ m y, (w m ≫ v (k m)) y = x) → (∀ y : E, ∃ m γ x, σ m γ x = y) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (a ≫ σ m γ = b ≫ σ m' γ' ↔ ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z))) → ∃ Λ : ∀ l, ↥(Limits.pullback (π ≫ O.ι) (v l)) → Γ, wcGRep v g O (π ≫ O.ι) Λ :=
by

  have LAM : wcFpqcLcDescHyp.{u} → ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] [Finite Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (p : E ⟶ U) (σ : ∀ m, Γ → (W m ⟶ E)), (∀ m γ, Flat (σ m γ)) → (∀ m γ, QuasiCompact (σ m γ)) → (∀ m γ, σ m γ ≫ p = w m ≫ v (k m)) → (∀ y : E, ∃ m γ x, σ m γ x = y) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), a ≫ σ m γ = b ≫ σ m' γ' → ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) → ∃ Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ, (∀ l, IsLocallyConstant (Λ l)) ∧ ∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l)) (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z), Λ l (q z) = γ * g (k m) l (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z) := by
    intro hL U Γ _ _ ι V v g hgloc hG n W k w E p σ hσfl hσqc hσ hσcov hMI
    classical
    have wd : ∀ (l : ι) (m₁ m₂ : Fin n) (γ₁ γ₂ : Γ) (Z₁ Z₂ : Scheme.{u}) (a₁ : Z₁ ⟶ W m₁)
        (a₂ : Z₂ ⟶ W m₂) (q₁ : Z₁ ⟶ Limits.pullback p (v l)) (q₂ : Z₂ ⟶ Limits.pullback p (v l)),
        a₁ ≫ σ m₁ γ₁ = q₁ ≫ Limits.pullback.fst p (v l) →
        a₂ ≫ σ m₂ γ₂ = q₂ ≫ Limits.pullback.fst p (v l) →
        ∀ (hq₁ : (a₁ ≫ w m₁) ≫ v (k m₁) = (q₁ ≫ Limits.pullback.snd p (v l)) ≫ v l)
          (hq₂ : (a₂ ≫ w m₂) ≫ v (k m₂) = (q₂ ≫ Limits.pullback.snd p (v l)) ≫ v l)
          (z₁ : Z₁) (z₂ : Z₂), q₁ z₁ = q₂ z₂ →
          γ₁ * g (k m₁) l (Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁ z₁)
            = γ₂ * g (k m₂) l
              (Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂ z₂) := by
      intro l m₁ m₂ γ₁ γ₂ Z₁ Z₂ a₁ a₂ q₁ q₂ h₁ h₂ hq₁ hq₂ z₁ z₂ hz
      obtain ⟨ζ, hζ1, hζ2⟩ := Scheme.Pullback.exists_preimage_pullback (f := q₁) (g := q₂) z₁ z₂ hz
      have hζ1' : Limits.pullback.fst q₁ q₂ ζ = z₁ := hζ1
      have hζ2' : Limits.pullback.snd q₁ q₂ ζ = z₂ := hζ2
      have hC : Limits.pullback.fst q₁ q₂ ≫ q₁ = Limits.pullback.snd q₁ q₂ ≫ q₂ :=
        Limits.pullback.condition
      have eqS : (Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ σ m₁ γ₁ =
          (Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ σ m₂ γ₂ := by
        rw [Category.assoc, Category.assoc, h₁, h₂, ← Category.assoc, hC, Category.assoc]
      have hbc : ((Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ w m₂) ≫ v (k m₂) =
          (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) ≫ v l := by
        have := hq₂
        simp only [Category.assoc] at this ⊢
        rw [this]
      have hac : ((Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ w m₁) ≫ v (k m₁) =
          (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) ≫ v l := by
        have := hq₁
        simp only [Category.assoc] at this ⊢
        rw [this]
        exact Limits.pullback.condition_assoc _
      have hab := hac.trans hbc.symm
      have hMIz := hMI m₁ m₂ γ₁ γ₂ _ (Limits.pullback.fst q₁ q₂ ≫ a₁)
        (Limits.pullback.snd q₁ q₂ ≫ a₂) hab eqS ζ
      have hcoc := hG (k m₁) (k m₂) l _ ((Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ w m₁)
        ((Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ w m₂)
        (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) hab hbc hac ζ
      have E1 : Limits.pullback.lift ((Limits.pullback.fst q₁ q₂ ≫ a₁) ≫ w m₁)
          (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) hac =
          Limits.pullback.fst q₁ q₂ ≫
            Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁ := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc (Limits.pullback.fst q₁ q₂)
            (Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁),
            Limits.pullback.lift_fst, Category.assoc]
        · rw [Limits.pullback.lift_snd, Category.assoc (Limits.pullback.fst q₁ q₂)
            (Limits.pullback.lift (a₁ ≫ w m₁) (q₁ ≫ Limits.pullback.snd p (v l)) hq₁),
            Limits.pullback.lift_snd]
          exact (Limits.pullback.condition_assoc _).symm
      have E2 : Limits.pullback.lift ((Limits.pullback.snd q₁ q₂ ≫ a₂) ≫ w m₂)
          (Limits.pullback.snd q₁ q₂ ≫ q₂ ≫ Limits.pullback.snd p (v l)) hbc =
          Limits.pullback.snd q₁ q₂ ≫
            Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂ := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc (Limits.pullback.snd q₁ q₂)
            (Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂),
            Limits.pullback.lift_fst, Category.assoc]
        · rw [Limits.pullback.lift_snd, Category.assoc (Limits.pullback.snd q₁ q₂)
            (Limits.pullback.lift (a₂ ≫ w m₂) (q₂ ≫ Limits.pullback.snd p (v l)) hq₂),
            Limits.pullback.lift_snd]
      rw [E1, E2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hζ1', hζ2'] at hcoc
      rw [hMIz, hcoc, mul_assoc]
    have hx : ∀ (l : ι) (x : ↥(Limits.pullback p (v l))), ∃ (m : Fin n) (γ : Γ)
        (r : ↥(Limits.pullback (σ m γ) (Limits.pullback.fst p (v l)))),
        Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l)) r = x := by
      intro l x
      obtain ⟨m, γ, x₀, h0⟩ := hσcov (Limits.pullback.fst p (v l) x)
      obtain ⟨r, -, hr⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := σ m γ) (g := Limits.pullback.fst p (v l)) x₀ x h0
      exact ⟨m, γ, r, hr⟩
    choose M Gm R hR using hx
    have hqQ : ∀ (m : Fin n) (γ : Γ) (l : ι),
        (Limits.pullback.fst (σ m γ) (Limits.pullback.fst p (v l)) ≫ w m) ≫ v (k m) =
        (Limits.pullback.snd (σ m γ) (Limits.pullback.fst p (v l)) ≫ Limits.pullback.snd p (v l))
          ≫ v l := by
      intro m γ l
      simp only [Category.assoc]
      rw [← hσ m γ, Limits.pullback.condition_assoc, Limits.pullback.condition]
    let Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ := fun l x =>
      Gm l x * g (k (M l x)) l (Limits.pullback.lift _ _ (hqQ (M l x) (Gm l x) l) (R l x))
    have hEval : ∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m)
        (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l))
        (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z),
        Λ l (q z) = γ * g (k m) l
          (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z) := by
      intro l m γ Z a q h hq z
      exact wd l (M l (q z)) m (Gm l (q z)) γ _ Z
        (Limits.pullback.fst (σ (M l (q z)) (Gm l (q z))) (Limits.pullback.fst p (v l))) a
        (Limits.pullback.snd (σ (M l (q z)) (Gm l (q z))) (Limits.pullback.fst p (v l))) q
        Limits.pullback.condition h (hqQ _ _ l) hq (R l (q z)) z (hR l (q z))

    have hLC : ∀ l, IsLocallyConstant (Λ l) := by
      intro l
      refine hL (Limits.pullback p (v l)) (Fin n × Γ)
        (fun i => Limits.pullback (σ i.1 i.2) (Limits.pullback.fst p (v l)))
        (fun i => Limits.pullback.snd (σ i.1 i.2) (Limits.pullback.fst p (v l)))
        (fun i => by haveI := hσfl i.1 i.2; infer_instance)
        (fun i => by haveI := hσqc i.1 i.2; infer_instance)
        ?_ Γ (Λ l) ?_
      · intro x
        obtain ⟨m, γ, x₀, h0⟩ := hσcov (Limits.pullback.fst p (v l) x)
        obtain ⟨r, -, hr⟩ := Scheme.Pullback.exists_preimage_pullback
          (f := σ m γ) (g := Limits.pullback.fst p (v l)) x₀ x h0
        exact ⟨(m, γ), r, hr⟩
      · intro i
        have hgl : IsLocallyConstant (g (k i.1) l ∘
            (Limits.pullback.lift _ _ (hqQ i.1 i.2 l) : _ ⟶ Limits.pullback (v (k i.1)) (v l))) :=
          (hgloc (k i.1) l).comp_continuous (Limits.pullback.lift _ _ (hqQ i.1 i.2 l)).continuous
        have e : (fun r => Λ l (Limits.pullback.snd (σ i.1 i.2) (Limits.pullback.fst p (v l)) r)) =
            (fun x => i.2 * x) ∘ (g (k i.1) l ∘
              (Limits.pullback.lift _ _ (hqQ i.1 i.2 l) : _ ⟶ Limits.pullback (v (k i.1)) (v l))) := by
          funext r
          exact hEval l i.1 i.2 _ _ _ Limits.pullback.condition (hqQ i.1 i.2 l) r
        show IsLocallyConstant
          (fun r => Λ l (Limits.pullback.snd (σ i.1 i.2) (Limits.pullback.fst p (v l)) r))
        rw [e]
        exact hgl.comp _
    exact ⟨Λ, hLC, hEval⟩

  have UNIQ : wcFpqcFamDescHyp.{u} → ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] [Finite Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), wcGCocycle v g → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (p : E ⟶ U) (σ : ∀ m, Γ → (W m ⟶ E)), (∀ m γ, Flat (σ m γ)) → (∀ m γ, QuasiCompact (σ m γ)) → (∀ m γ, σ m γ ≫ p = w m ≫ v (k m)) → (∀ y : E, ∃ m γ x, σ m γ x = y) → (∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) → a ≫ σ m γ = b ≫ σ m' γ') → ∀ (Λ : ∀ l, ↥(Limits.pullback p (v l)) → Γ), (∀ (l : ι) (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (q : Z ⟶ Limits.pullback p (v l)) (h : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v l)) (hq : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v l)) ≫ v l) (z : Z), Λ l (q z) = γ * g (k m) l (Limits.pullback.lift (a ≫ w m) (q ≫ Limits.pullback.snd p (v l)) hq z)) → ∀ (T : Scheme.{u}) (t : T ⟶ U) (lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ) (φ₁ φ₂ : T ⟶ E) (h₁ : φ₁ ≫ p = t) (h₂ : φ₂ ≫ p = t), (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ₁ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h₁]) (by simp) x)) → (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ₂ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h₂]) (by simp) x)) → φ₁ = φ₂ := by
    intro hD U Γ _ _ ι V v g hG n W k w E p σ hσfl hσqc hσ hσcov MIb Λ hEval T t lam φ₁ φ₂ h₁ h₂
      rep₁ rep₂
    have ext : ∀ (Z : Scheme.{u}) (α β : Z ⟶ E),
        (∀ m γ, Limits.pullback.fst α (σ m γ) ≫ β = Limits.pullback.fst α (σ m γ) ≫ α) →
        α = β := by
      intro Z α β H
      have hf : ∀ i : Fin n × Γ, Flat (Limits.pullback.fst α (σ i.1 i.2)) := fun i => by
        haveI := hσfl i.1 i.2; infer_instance
      have hfq : ∀ i : Fin n × Γ, QuasiCompact (Limits.pullback.fst α (σ i.1 i.2)) := fun i => by
        haveI := hσqc i.1 i.2; infer_instance
      have hcov : ∀ x : Z, ∃ i : Fin n × Γ, x ∈ Set.range (Limits.pullback.fst α (σ i.1 i.2)) := by
        intro x
        obtain ⟨m, γ, x₀, hx₀⟩ := hσcov (α x)
        obtain ⟨ζ, hζ, -⟩ :=
          Scheme.Pullback.exists_preimage_pullback (f := α) (g := σ m γ) x x₀ hx₀.symm
        exact ⟨(m, γ), ζ, hζ⟩
      obtain ⟨φ0, -, hu⟩ := hD Z E (Fin n × Γ) (fun i => Limits.pullback α (σ i.1 i.2))
        (fun i => Limits.pullback.fst α (σ i.1 i.2)) hf hfq hcov
        (fun i => Limits.pullback.fst α (σ i.1 i.2) ≫ α)
        (fun i j Z' a b hab => by
          have hab' : a ≫ Limits.pullback.fst α (σ i.1 i.2) =
              b ≫ Limits.pullback.fst α (σ j.1 j.2) := hab
          show a ≫ (Limits.pullback.fst α (σ i.1 i.2) ≫ α) =
            b ≫ (Limits.pullback.fst α (σ j.1 j.2) ≫ α)
          rw [← Category.assoc, hab', Category.assoc])
      have e1 : α = φ0 := hu α (fun i => rfl)
      have e2 : β = φ0 := hu β (fun i => H i.1 i.2)
      rw [e1, e2]
    have hcongr : ∀ {A B C D : Scheme.{u}} {f1 : B ⟶ D} {f2 : C ⟶ D} (x x' : A ⟶ B)
        (y y' : A ⟶ C) (hx : x = x') (hy : y = y') (h1 : x ≫ f1 = y ≫ f2)
        (h2 : x' ≫ f1 = y' ≫ f2), Limits.pullback.lift x y h1 = Limits.pullback.lift x' y' h2 := by
      intro A B C D f1 f2 x x' y y' hx hy h1 h2
      subst hx
      subst hy
      rfl
    have diag : ∀ (j : ι) (Z : Scheme.{u}) (b : Z ⟶ V j) (hb : b ≫ v j = b ≫ v j) (z : Z),
        g j j (Limits.pullback.lift b b hb z) = 1 := by
      intro j Z b hb z
      have h := hG j j j Z b b b hb hb hb z
      exact mul_left_cancel (h.symm.trans (mul_one _).symm)
    have s1 : ∀ (φ : T ⟶ E) (h : φ ≫ p = t),
        (∀ (l : ι) (x : ↥(Limits.pullback t (v l))), lam l x = Λ l (Limits.pullback.map t (v l) p (v l) φ (𝟙 _) (𝟙 _) (by rw [Category.comp_id, h]) (by simp) x)) →
        ∀ (m : Fin n) (γ : Γ) (Z : Scheme.{u}) (c : Z ⟶ T) (a : Z ⟶ W m)
          (hc : c ≫ t = (a ≫ w m) ≫ v (k m)), c ≫ φ = a ≫ σ m γ →
          ∀ z : Z, lam (k m) (Limits.pullback.lift c (a ≫ w m) hc z) = γ := by
      intro φ h rep m γ Z c a hc hca z
      obtain ⟨q, hqdef⟩ : ∃ q, q = Limits.pullback.lift c (a ≫ w m) hc ≫
          Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, h]) (by simp) := ⟨_, rfl⟩
      have hq1 : q ≫ Limits.pullback.fst p (v (k m)) = c ≫ φ := by
        have m1 : Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, h]) (by simp) ≫ Limits.pullback.fst p (v (k m)) =
            Limits.pullback.fst t (v (k m)) ≫ φ := Limits.pullback.lift_fst _ _ _
        subst hqdef
        first
        | (rw [Category.assoc, m1, ← Category.assoc, Limits.pullback.lift_fst])
        | (rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst])
        | (rw [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst])
        | (erw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst])
        | simp
      have hq2 : q ≫ Limits.pullback.snd p (v (k m)) = a ≫ w m := by
        have m2 : Limits.pullback.map t (v (k m)) p (v (k m)) φ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, h]) (by simp) ≫ Limits.pullback.snd p (v (k m)) =
            Limits.pullback.snd t (v (k m)) ≫ 𝟙 _ := Limits.pullback.lift_snd _ _ _
        subst hqdef
        first
        | (rw [Category.assoc, m2, Category.comp_id, Limits.pullback.lift_snd])
        | (rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
            Limits.pullback.lift_snd, Category.comp_id])
        | (rw [Category.assoc, Limits.pullback.map, Limits.pullback.lift_snd, ← Category.assoc,
            Limits.pullback.lift_snd, Category.comp_id])
        | (erw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
            Limits.pullback.lift_snd, Category.comp_id])
        | simp
      have hA : a ≫ σ m γ = q ≫ Limits.pullback.fst p (v (k m)) := by rw [hq1, hca]
      have hB : (a ≫ w m) ≫ v (k m) = (q ≫ Limits.pullback.snd p (v (k m))) ≫ v (k m) := by
        rw [hq2]
      have E1 := hEval (k m) m γ Z a q hA hB z
      rw [hcongr (a ≫ w m) (a ≫ w m) _ _ rfl hq2 hB rfl, diag, mul_one] at E1
      rw [hqdef, Scheme.Hom.comp_apply] at E1
      rw [rep (k m)]
      exact E1
    have s2 : ∀ (φ : T ⟶ E) (h : φ ≫ p = t),
