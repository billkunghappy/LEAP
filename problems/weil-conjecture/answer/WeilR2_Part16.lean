by
  intro α hφ t ht P Pw K γ Tflat T TΨ Ψ F Hq Hq' c β y y' hy
  haveI := Df.cont
  haveI := Dw.cont
  haveI := Df.additive
  haveI := Dw.additive
  haveI := Dg.additive
