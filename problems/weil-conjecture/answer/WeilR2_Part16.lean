    Nonempty (Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) M n ≃
      Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (((wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)).obj M) n) :=
by
