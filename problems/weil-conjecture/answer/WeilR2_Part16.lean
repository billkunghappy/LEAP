    rw [hmOt, Ideal.map_span, ← Set.range_comp, hρ₀]
    rfl

  have hA : ∀ (W : Yb.affineOpens) (hyW : y ∈ W.1),
      Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W) =
        Ideal.span (Set.range (ρ₀ ∘ t)) := by
    intro W hyW
    rw [hL5 P Yb I r y ⟨U₀, hU₀⟩ hyU₀ W hyW, hL4, hB0]

  obtain ⟨W₁, hyW₁, α, hα, hW₁⟩ := hL10 P Yb I r hbl.1 y
  have hN0 : Ideal.span (Set.range (ρ₀ ∘ t)) = Ideal.span {α} := (hA W₁ hyW₁).symm.trans hW₁
  obtain ⟨s, hsS, hsnzd, hsspan⟩ :=
    hL3 (Yb.presheaf.stalk y) (Set.range (ρ₀ ∘ t)) α hα hN0
  obtain ⟨j, rfl⟩ := hsS
  simp only [Function.comp_apply] at hsnzd hsspan
  have hspanj : Ideal.span {ρ₀ (t j)} = Ideal.span (Set.range (ρ₀ ∘ t)) := hsspan.trans hN0.symm
  have hstar : ∀ (W : Yb.affineOpens) (hyW : y ∈ W.1),
      Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W) =
        Ideal.span {ρ₀ (t j)} := fun W hyW => (hA W hyW).trans hspanj.symm
  have hdiv : ∀ b, ρ₀ (t b) ∈ Ideal.span {ρ₀ (t j)} := by
    intro b
    rw [hspanj]
    exact Ideal.subset_span ⟨b, rfl⟩
  have hρh : ρ₀ h = 0 := by rw [hρ₀, RingHom.comp_apply, hπh, map_zero]
  have hρm : ∀ b, ρ₀ (t b) ∈ IsLocalRing.maximalIdeal (Yb.presheaf.stalk y) := by
    intro b
    rw [hρ₀, RingHom.comp_apply]
    apply map_nonunit
    apply map_nonunit π
    rw [hmax]
    exact Ideal.subset_span ⟨b, rfl⟩

  have hq' : h - ∑ a, ∑ c, M a c * t a * t c ∈ Ideal.span (Set.range t) ^ 3 := by
    rw [← hmax]; exact hq
  obtain ⟨g, hG1, hG2⟩ := hL1 R n t h M j hq'
  obtain ⟨hBh, hBdiv, hBuniv⟩ := hL2 R n t h j g hG1
  obtain ⟨ψ, hψ, -⟩ := hBuniv (Yb.presheaf.stalk y) ρ₀ hρh hsnzd hdiv

  have hL7 := hL7r K P Yb fP r y hy
  obtain ⟨β, hβ⟩ : ∃ β : Ideal (wcOdpB t j g),
      β = Ideal.comap ψ (IsLocalRing.maximalIdeal (Yb.presheaf.stalk y)) := ⟨_, rfl⟩
  have hχs : Function.Surjective ((IsLocalRing.residue (Yb.presheaf.stalk y)).comp ψ) := by
    intro z
    obtain ⟨w, hw⟩ := hL7 z
    obtain ⟨o, rfl⟩ := IsLocalRing.residue_surjective (R := P.presheaf.stalk (r y)) w
    obtain ⟨x, rfl⟩ := hπs o
    refine ⟨algebraMap R (wcOdpB t j g) x, ?_⟩
    have e1 := congrArg (fun f => f.hom (π x)) (Scheme.residue_residueFieldMap r y)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1
    rw [RingHom.comp_apply, ← RingHom.comp_apply ψ, hψ, hρ₀, RingHom.comp_apply, ← hw]
    exact e1.symm
  have hβmax : β.IsMaximal := by
    have : β = RingHom.ker ((IsLocalRing.residue (Yb.presheaf.stalk y)).comp ψ) := by
      rw [hβ, ← RingHom.comap_ker, IsLocalRing.ker_residue]
    rw [this]
    exact RingHom.ker_isMaximal_of_surjective _ hχs
  have hτβ : algebraMap R (wcOdpB t j g) (t j) ∈ β := by
    rw [hβ, Ideal.mem_comap, ← RingHom.comp_apply, hψ]
    exact hρm j

  haveI : β.IsPrime := hβmax.isPrime
  let C := Localization.AtPrime β
  have hmemβ : ∀ s : wcOdpB t j g, s ∈ β ↔ ψ s ∈ IsLocalRing.maximalIdeal (Yb.presheaf.stalk y) := by
    intro s; rw [hβ, Ideal.mem_comap]
  have hunit : ∀ s : β.primeCompl, IsUnit (ψ s) := by
    intro s
    by_contra hn
    exact s.2 ((hmemβ s).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hn))
  obtain ⟨ψβ, hψβ⟩ : ∃ ψβ : C →+* Yb.presheaf.stalk y,
      ψβ = IsLocalization.lift (M := β.primeCompl) (S := C) hunit := ⟨_, rfl⟩
  have hψβc : ψβ.comp (algebraMap (wcOdpB t j g) C) = ψ := by
    rw [hψβ]; exact IsLocalization.lift_comp hunit
  have hψβloc : IsLocalHom ψβ := by
    refine ⟨fun x hx => ?_⟩
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective β.primeCompl x
    have e1 := IsLocalization.mk'_spec C b s
    have e2 : ψβ (IsLocalization.mk' C b s) * ψ s = ψ b := by
      rw [← hψβc, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, e1]
    have hb : IsUnit (ψ b) := by rw [← e2]; exact hx.mul (hunit s)
    have hbβ : b ∈ β.primeCompl := fun hbm =>
      (IsLocalRing.mem_maximalIdeal _).mp ((hmemβ b).mp hbm) hb
    have hu : IsUnit (algebraMap (wcOdpB t j g) C b) := IsLocalization.map_units C ⟨b, hbβ⟩
    rw [← e1] at hu
    exact isUnit_of_mul_isUnit_left hu

  obtain ⟨ρC, hρC⟩ : ∃ ρC : R →+* C, ρC = (algebraMap (wcOdpB t j g) C).comp
      (algebraMap R (wcOdpB t j g)) := ⟨_, rfl⟩
  have hρCh : ρC h = 0 := by rw [hρC, RingHom.comp_apply, hBh, map_zero]
  have hτnzd : algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) ∈
      nonZeroDivisors C := (wc_odp_chart_nzd R n t M j g hdim hmax hdet hG2).2 β C
  have hdivC : ∀ b, ρC (t b) ∈ Ideal.span {ρC (t j)} := by
    intro b
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hBdiv b)
    refine Ideal.mem_span_singleton'.mpr ⟨algebraMap (wcOdpB t j g) C c, ?_⟩
    rw [hρC, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hc]
  have hker : ∀ a ∈ Ideal.span {h}, ρC a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hρCh, mul_zero]
  obtain ⟨κ, hκ⟩ : ∃ κ : P.presheaf.stalk (r y) →+* C,
      κ = (Ideal.Quotient.lift (Ideal.span {h}) ρC hker).comp σ.toRingHom := ⟨_, rfl⟩
  have hκπ : ∀ x, κ (π x) = ρC x := by
    intro x
    rw [hκ, hπ, RingHom.comp_apply, RingHom.comp_apply]
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.apply_symm_apply,
      Ideal.Quotient.lift_mk]
  have hτdef : ρC (t j) = algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) := by
    rw [hρC]; rfl
  have hκm : Ideal.map κ (IsLocalRing.maximalIdeal (P.presheaf.stalk (r y))) =
      Ideal.span {algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j))} := by
    rw [hmOt, Ideal.map_span, ← Set.range_comp]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨b, rfl⟩
      show κ (π (t b)) ∈ _
      rw [hκπ]
      have := hdivC b
      rw [hτdef] at this
      exact this
    · rw [Ideal.span_singleton_le_iff_mem]
      apply Ideal.subset_span
      refine ⟨j, ?_⟩
      show κ (π (t j)) = _
      rw [hκπ, hτdef]
  haveI : IsLocalRing C := IsLocalization.AtPrime.isLocalRing C β
  haveI hLc : IsLocalRing (CommRingCat.of C) := inferInstanceAs (IsLocalRing C)
  obtain ⟨κc, hκc⟩ : ∃ κc : P.presheaf.stalk (r y) ⟶ CommRingCat.of C,
      κc.hom = κ := ⟨CommRingCat.ofHom (R := P.presheaf.stalk (r y)) (S := C) κ, rfl⟩
  have hIP1 : wcCsdInvPull I (Spec.map κc ≫ P.fromSpecStalk (r y)) := by
    refine hL8 P I (r y) ⟨U₀, hU₀⟩ hyU₀ (CommRingCat.of C)
      κc _ hτnzd ?_
    rw [hκc, hL4, hκm]
  obtain ⟨γ, hγ, -⟩ := hbl.2 _ _ hIP1

  have hIP2 : wcCsdInvPull I (Spec.map (r.stalkMap y) ≫ P.fromSpecStalk (r y)) := by
    refine hL8 P I (r y) ⟨U₀, hU₀⟩ hyU₀ (Yb.presheaf.stalk y)
      (r.stalkMap y) (ρ₀ (t j)) hsnzd ?_
    rw [hL4, hB0, hspanj]
  rw [Scheme.SpecMap_stalkMap_fromSpecStalk] at hIP2
  obtain ⟨μ, hμ⟩ : ∃ μ : CommRingCat.of C ⟶ Yb.presheaf.stalk y, μ.hom = ψβ :=
    ⟨CommRingCat.ofHom (R := C) (S := Yb.presheaf.stalk y) ψβ, rfl⟩
  have hκμ : κc ≫ μ = r.stalkMap y := by
    ext x
    obtain ⟨a, rfl⟩ := hπs x
    rw [CommRingCat.comp_apply]
    show μ.hom (κc.hom (π a)) = (r.stalkMap y).hom (π a)
    rw [hμ, hκc, hκπ, hρC, RingHom.comp_apply, ← RingHom.comp_apply ψβ, hψβc,
      ← RingHom.comp_apply ψ, hψ, hρ₀, RingHom.comp_apply]
  have hcomp : (Spec.map μ ≫ γ) ≫ r = Yb.fromSpecStalk y ≫ r := by
    rw [Category.assoc, hγ, ← Category.assoc, ← Spec.map_comp, hκμ,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
  have hstar2 : Spec.map μ ≫ γ = Yb.fromSpecStalk y := (hbl.2 _ _ hIP2).unique hcomp rfl

  have hμloc : IsLocalHom μ.hom := by rw [hμ]; exact hψβloc
  obtain ⟨θ, hθμ, hθr⟩ := hL9 P Yb r y (CommRingCat.of C) γ μ
    κc hμloc hstar2 hγ

  obtain ⟨-, -, hCuniq⟩ := hL2 R n t h j g hG1
  have hθψ : θ.hom.comp ψ = algebraMap (wcOdpB t j g) C := by
    refine (hCuniq C ρC hρCh (by rw [hρC]; exact hτnzd) hdivC).unique ?_ ?_
    · ext x
      have e1 := congrArg (fun f => f.hom (π x)) hθr
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1
      rw [hκc] at e1
      rw [RingHom.comp_apply, RingHom.comp_apply,
        ← RingHom.comp_apply ψ (algebraMap R (wcOdpB t j g)), hψ, hρ₀,
        RingHom.comp_apply, e1, hκπ]
    · exact hρC.symm
  have hθψβ : θ.hom.comp ψβ = RingHom.id C := by
    apply IsLocalization.ringHom_ext β.primeCompl
    rw [RingHom.comp_assoc, hψβc, hθψ, RingHom.id_comp]
  have hψβθ : ψβ.comp θ.hom = RingHom.id (Yb.presheaf.stalk y) := by
    have := congrArg CommRingCat.Hom.hom hθμ
    rw [CommRingCat.hom_comp, CommRingCat.hom_id, hμ] at this
    exact this

  refine ⟨j, g, β, hβmax, hG1, hG2, hτβ, C, inferInstance, inferInstance, inferInstance,
    RingEquiv.ofRingHom θ.hom ψβ hθψβ hψβθ, ?_⟩
  intro W hyW
  rw [hstar W hyW, Ideal.map_span, Set.image_singleton, RingEquiv.coe_ringHom_ofRingHom,
    ← hψ, RingHom.comp_apply, ← RingHom.comp_apply θ.hom ψ, hθψ]

theorem wc_odp_subscheme_stalk : ∀ (Y : Scheme.{u}) (J : Y.IdealSheafData) (z : J.subscheme)
    (W : Y.affineOpens) (hW : J.subschemeι z ∈ W.1),
    Nonempty (J.subscheme.presheaf.stalk z ≃+*
      Y.presheaf.stalk (J.subschemeι z) ⧸
        Ideal.map (Y.presheaf.germ W.1 (J.subschemeι z) hW).hom (J.ideal W)) :=
by
  intro Y J z W hW
  set ι := J.subschemeι with hι
  have hV : IsAffineOpen (ι ⁻¹ᵁ W.1) := W.2.preimage ι
  have hfs : Function.Surjective (ι.app W.1).hom :=
    (isClosedImmersion_iff_isAffineHom.mp inferInstance).2 W.1 W.2
  have hker : RingHom.ker (ι.app W.1).hom = J.ideal W := J.ker_subschemeι_app W
  set ψ := (ι.stalkMap z).hom with hψdef
  have hsurj : Function.Surjective ψ := ι.stalkMap_surjective z
  have hψloc : IsLocalHom ψ := inferInstanceAs (IsLocalHom (ι.stalkMap z).hom)

  have hkerψ : RingHom.ker ψ =
      Ideal.map (Y.presheaf.germ W.1 (ι z) hW).hom (J.ideal W) := by
    have hcompat : ∀ a, ψ ((Y.presheaf.germ W.1 (ι z) hW).hom a) =
        (J.subscheme.presheaf.germ (ι ⁻¹ᵁ W.1) z hW).hom ((ι.app W.1).hom a) :=
      fun a => ι.germ_stalkMap_apply W.1 z hW a
    letI : Algebra Γ(Y, W.1) (Y.presheaf.stalk (ι z)) :=
      (Y.presheaf.germ W.1 (ι z) hW).hom.toAlgebra
    letI : Algebra Γ(J.subscheme, ι ⁻¹ᵁ W.1) (J.subscheme.presheaf.stalk z) :=
      (J.subscheme.presheaf.germ (ι ⁻¹ᵁ W.1) z hW).hom.toAlgebra
    have hLA : IsLocalization.AtPrime (Y.presheaf.stalk (ι z))
        (W.2.primeIdealOf ⟨ι z, hW⟩).asIdeal := W.2.isLocalization_stalk ⟨ι z, hW⟩
    have hLB : IsLocalization.AtPrime (J.subscheme.presheaf.stalk z)
        (hV.primeIdealOf ⟨z, hW⟩).asIdeal := hV.isLocalization_stalk ⟨z, hW⟩
    apply le_antisymm
    · intro s hs
      rw [RingHom.mem_ker] at hs
      obtain ⟨⟨a, m⟩, hm⟩ := IsLocalization.surj
        (W.2.primeIdealOf ⟨ι z, hW⟩).asIdeal.primeCompl s
      change s * (Y.presheaf.germ W.1 (ι z) hW).hom (m : Γ(Y, W.1)) =
        (Y.presheaf.germ W.1 (ι z) hW).hom a at hm
      have h1 : (J.subscheme.presheaf.germ (ι ⁻¹ᵁ W.1) z hW).hom ((ι.app W.1).hom a) = 0 := by
        rw [← hcompat, ← hm, map_mul, hs, zero_mul]
      obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff
        (hV.primeIdealOf ⟨z, hW⟩).asIdeal.primeCompl (J.subscheme.presheaf.stalk z)
        ((ι.app W.1).hom a)).mp h1
      obtain ⟨m', hm'⟩ := hfs (t : Γ(J.subscheme, ι ⁻¹ᵁ W.1))
      have h2 : (Y.presheaf.germ W.1 (ι z) hW).hom m' * (Y.presheaf.germ W.1 (ι z) hW).hom a ∈
          Ideal.map (Y.presheaf.germ W.1 (ι z) hW).hom (J.ideal W) := by
        rw [← map_mul]
        apply Ideal.mem_map_of_mem
        rw [← hker, RingHom.mem_ker, map_mul, hm', ht]
      have hu : IsUnit ((Y.presheaf.germ W.1 (ι z) hW).hom m') := by
        apply isUnit_of_map_unit ψ
        rw [hcompat, hm']
        exact IsLocalization.map_units (J.subscheme.presheaf.stalk z) t
      have h3 := (Ideal.unit_mul_mem_iff_mem _ hu).mp h2
      have hmu : IsUnit ((Y.presheaf.germ W.1 (ι z) hW).hom (m : Γ(Y, W.1))) :=
        IsLocalization.map_units (Y.presheaf.stalk (ι z)) m
      rw [← hm] at h3
      exact (Ideal.mul_unit_mem_iff_mem _ hmu).mp h3
    · rw [Ideal.map_le_iff_le_comap, ← hker]
      intro a ha
      rw [RingHom.mem_ker] at ha
      rw [Ideal.mem_comap, RingHom.mem_ker, hcompat, ha, map_zero]
  exact ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hkerψ)⟩

theorem wc_odp_low_dim_point_open : ∀ (K : Type u) [Field K] [IsAlgClosed K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [IsProper fP] (n : ℕ) (xb : P),
    IsClosed ({xb} : Set P) → n ≤ 1 →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin n → R) (h : R)
      (M : Matrix (Fin n) (Fin n) R), ringKrullDim R = n →
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
      IsUnit (M + M.transpose).det → Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) →
      IsOpen ({xb} : Set P) :=
by
  intro K _ _ P fP _ n xb hxb hn R _ _ _ t h M _ hmax hq hdet hσ

  have s1 : ∀ p : Ideal R, p.IsPrime → h ∈ p → p = IsLocalRing.maximalIdeal R := by
    intro p hp hhp
    apply le_antisymm (IsLocalRing.le_maximalIdeal_of_isPrime p)
    rw [hmax, Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    rcases Nat.lt_or_ge n 1 with h0 | h1
    · exact absurd a.isLt (by omega)
    · obtain rfl : n = 1 := by omega
      have ha : a = 0 := Subsingleton.elim _ _
      subst ha
      have hτm : t 0 ∈ IsLocalRing.maximalIdeal R := by
        rw [hmax]; exact Ideal.subset_span ⟨0, rfl⟩
      have hsum : ∑ a, ∑ c, M a c * t a * t c = M 0 0 * t 0 * t 0 := by
        simp
      have hrange : Set.range t = {t 0} := by
        ext x
        constructor
        · rintro ⟨i, rfl⟩
          rw [Subsingleton.elim i 0]
          rfl
        · intro hx
          rw [Set.mem_singleton_iff] at hx
          exact ⟨0, hx.symm⟩
      rw [hsum, hmax, hrange, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hq
      obtain ⟨b, hb⟩ := hq
      have hfac : h = t 0 * (t 0 * (M 0 0 + b * t 0)) := by
        linear_combination (-1 : R) * hb
      have hdet' : (M + M.transpose).det = M 0 0 * 2 := by
        rw [Matrix.det_fin_one, Matrix.add_apply, Matrix.transpose_apply]; ring
      have hμ : IsUnit (M 0 0) := isUnit_of_mul_isUnit_left (hdet' ▸ hdet)
      rw [hfac] at hhp
      rcases hp.mem_or_mem hhp with h1 | h2
      · exact h1
      · rcases hp.mem_or_mem h2 with h3 | h4
        · exact h3
        · exfalso
          have h5 : M 0 0 + b * t 0 ∈ IsLocalRing.maximalIdeal R :=
            IsLocalRing.le_maximalIdeal_of_isPrime p h4
          have h6 : b * t 0 ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_left _ b hτm
          have h7 : M 0 0 ∈ IsLocalRing.maximalIdeal R := by
            have := Ideal.sub_mem _ h5 h6
            simpa using this
          exact (IsLocalRing.notMem_maximalIdeal.mpr hμ) h7

  obtain ⟨σ⟩ := hσ
  let φ : R →+* P.presheaf.stalk xb :=
    σ.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {h}))
  have hφs : Function.Surjective φ := σ.symm.surjective.comp Ideal.Quotient.mk_surjective
  have hφh : φ h = 0 := by
    show σ.symm (Ideal.Quotient.mk _ h) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self h), map_zero]
  have s2 : ∀ q : Ideal (P.presheaf.stalk xb), q.IsPrime →
      q = IsLocalRing.maximalIdeal (P.presheaf.stalk xb) := by
    intro q hq'
    have hpq : q.comap φ = IsLocalRing.maximalIdeal R := by
      apply s1 _ inferInstance
      rw [Ideal.mem_comap, hφh]
      exact q.zero_mem
    apply le_antisymm (IsLocalRing.le_maximalIdeal_of_isPrime q)
    intro x hx
    obtain ⟨r, rfl⟩ := hφs x
    have hr : r ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact ((IsLocalRing.mem_maximalIdeal _).mp hx) (hu.map φ)
    rw [← hpq] at hr
    exact hr

  haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian fP
  haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace fP
  haveI : AlgebraicGeometry.IsNoetherian P := AlgebraicGeometry.IsNoetherian.mk

  have hZirr : IsIrreducible (irreducibleComponent xb) := isIrreducible_irreducibleComponent
  have hZcl : IsClosed (irreducibleComponent xb) := isClosed_irreducibleComponent
  have hxZ : xb ∈ irreducibleComponent xb := mem_irreducibleComponent
  have hgen := hZirr.closure_genericPoint hZcl
  have hsp : hZirr.genericPoint ⤳ xb := by
    rw [specializes_iff_mem_closure, hgen]; exact hxZ
  have hmem : hZirr.genericPoint ∈ Set.range (P.fromSpecStalk xb) := by
    rw [Scheme.range_fromSpecStalk]; exact hsp
  obtain ⟨z, hz⟩ := hmem
  have hz' : z = IsLocalRing.closedPoint (P.presheaf.stalk xb) :=
    PrimeSpectrum.ext (s2 z.asIdeal z.isPrime)
  rw [hz', Scheme.fromSpecStalk_closedPoint] at hz
  have hZx : irreducibleComponent xb = {xb} := by
    rw [← hgen, ← hz, hxb.closure_eq]
  obtain ⟨o, ho, hne, hoZ⟩ :=
    TopologicalSpace.NoetherianSpace.exists_isOpen_nonempty_subset_irreducibleComponent _
      (irreducibleComponent_mem_irreducibleComponents xb)
  rw [hZx] at hoZ
  rw [← hne.subset_singleton_iff.mp hoZ]
  exact ho

theorem wc_odp_isolated_resolution : ∀ (K : Type u) [Field K] [IsAlgClosed K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [IsProper fP] (n : ℕ) (xb : P) (O : P.Opens),
    IsClosed ({xb} : Set P) → (O : Set P) = {xb}ᶜ → SmoothOfRelativeDimension (n - 1) (O.ι ≫ fP) →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin n → R) (h : R)
      (M : Matrix (Fin n) (Fin n) R), ringKrullDim R = n →
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
      IsUnit (M + M.transpose).det → Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) →
    ∃ (Yb E : Scheme.{u}) (fY : Yb ⟶ Spec (.of K)) (_ : IsProper fY)
      (_ : SmoothOfRelativeDimension (n - 1) fY) (iE : E ⟶ Yb) (_ : IsClosedImmersion iE)
      (_ : SmoothOfRelativeDimension (n - 1 - 1) (iE ≫ fY)) (U : Yb.Opens),
      (U : Set Yb) = (Set.range iE)ᶜ ∧ Nonempty ((O : Scheme.{u}) ≅ (U : Scheme.{u})) :=
by
  intro K _ _ P fP _ n xb O hxb hO hsm R _ _ _ t h M hdim hmax hq hdet hσ
  by_cases hn : n ≤ 1
  ·
    have hopen : IsOpen ({xb} : Set P) :=
      wc_odp_low_dim_point_open K P fP n xb hxb hn R t h M hdim hmax hq hdet hσ
    have hOc : IsClosed (O : Set P) := by
      rw [hO]; exact hopen.isClosed_compl
    haveI : IsClosedImmersion O.ι :=
      IsClosedImmersion.of_isPreimmersion O.ι (by rw [Scheme.Opens.range_ι]; exact hOc)
    haveI hE : IsClosedImmersion (⊥ : (O : Scheme.{u}).Opens).ι :=
      IsClosedImmersion.of_isPreimmersion _ (by
        rw [Scheme.Opens.range_ι, TopologicalSpace.Opens.coe_bot]; exact isClosed_empty)
    have hsmE : SmoothOfRelativeDimension (n - 1 - 1)
        ((⊥ : (O : Scheme.{u}).Opens).ι ≫ O.ι ≫ fP) := by
      apply wc_odp_smooth_of_closed_regular K _ _ (n - 1 - 1)
      intro z _
      exfalso
      obtain ⟨x, hx⟩ := z
      first
        | exact (TopologicalSpace.Opens.notMem_bot x) hx
        | simp at hx
        | exact hx
    refine ⟨(O : Scheme.{u}), ((⊥ : (O : Scheme.{u}).Opens) : Scheme.{u}), O.ι ≫ fP,
      inferInstance, hsm, (⊥ : (O : Scheme.{u}).Opens).ι, hE, hsmE, ⊤, ?_,
      ⟨(Scheme.topIso (O : Scheme.{u})).symm⟩⟩
    simp [Scheme.Opens.range_ι]
  ·
    have hn2 : 2 ≤ n := by omega
    set I : P.IdealSheafData :=
      Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P) with hI
    have hIsupp : (I.support : Set P) = {xb} :=
      Scheme.IdealSheafData.coe_support_vanishingIdeal _
    obtain ⟨Yb, r, hbl, hrp⟩ := wc_odp_blowup_proper K P fP I
    haveI := hrp
    have hrange : Set.range (I.comap r).subschemeι = r ⁻¹' {xb} := by
      ext y
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap]
      change r y ∈ (I.support : Set P) ↔ _
      rw [hIsupp]
      rfl
    have hU : ((r ⁻¹ᵁ O : Yb.Opens) : Set Yb) = (Set.range (I.comap r).subschemeι)ᶜ := by
      rw [hrange]
      ext y
      change r y ∈ (O : Set P) ↔ _
      rw [hO]
      simp
    have hdisj : (I.support : Set P) ∩ (O : Set P) = ∅ := by
      rw [hIsupp, hO]; exact Set.inter_compl_self _
    haveI hiso : IsIso (r ∣_ O) := wc_csd_blowup_iso_off_center P Yb I r O hbl hdisj

    have hchart : ∀ y : Yb, IsClosed ({y} : Set Yb) → r y = xb →
        IsRegularLocalRing (Yb.presheaf.stalk y) ∧
        ringKrullDim (Yb.presheaf.stalk y) = ((n - 1 : ℕ) : WithBot ℕ∞) ∧
        ∀ (W : Yb.affineOpens) (hyW : y ∈ W.1),
          IsRegularLocalRing (Yb.presheaf.stalk y ⧸
            Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W)) ∧
          ringKrullDim (Yb.presheaf.stalk y ⧸
            Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W)) =
            ((n - 1 - 1 : ℕ) : WithBot ℕ∞) := by
      intro y hy hry
      haveI := wc_odp_residue_algClosed K P fP xb hxb R h hσ
      obtain ⟨j, g, β, hβ, hG1, hG2, hτ, C, _, _, hloc, e, he⟩ :=
        wc_odp_blowup_stalk_chart K P fP n xb hxb R t h M hn2 hdim hmax hq hdet hσ I hI
          Yb r hbl y hy hry
      haveI : IsLocalRing C := IsLocalization.AtPrime.isLocalRing C β
      haveI : IsNoetherianRing C := IsLocalization.isNoetherianRing β.primeCompl C inferInstance
      have hnzd := (wc_odp_chart_nzd R n t M j g hdim hmax hdet hG2).2 β C
      obtain ⟨hfreg, hfdim⟩ :=
        wc_odp_chart_fibre_regular R n t M j g hn2 hdim hmax hdet hG2 β hτ C
      have hmem : algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) ∈
            IsLocalRing.maximalIdeal C :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff C β _).mpr hτ
      obtain ⟨hreg, hdimC⟩ :=
        wc_odp_regular_lift_nzd C _ (n - 1 - 1) hmem hnzd hfreg hfdim
      have hn' : n - 1 - 1 + 1 = n - 1 := by omega
      rw [hn'] at hdimC
      haveI := hreg
      refine ⟨IsRegularLocalRing.of_ringEquiv e.symm, (ringKrullDim_eq_of_ringEquiv e).trans hdimC,
        ?_⟩
      intro W hyW
      let e2 := Ideal.quotientEquiv
        (Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W))
        (Ideal.span {algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j))}) e
        (by first | exact (he W hyW).symm | (rw [← he W hyW]; rfl))
      haveI := hfreg
      exact ⟨IsRegularLocalRing.of_ringEquiv e2.symm,
        (ringKrullDim_eq_of_ringEquiv e2).trans hfdim⟩

    have hsmY : SmoothOfRelativeDimension (n - 1) (r ≫ fP) := by
      apply wc_odp_smooth_of_closed_regular K Yb (r ≫ fP) (n - 1)
      intro y hy
      by_cases hry : r y = xb
      · right
        exact ⟨(hchart y hy hry).1, (hchart y hy hry).2.1⟩
      · left
        refine ⟨r ⁻¹ᵁ O, (O : Scheme.{u}), O.ι ≫ fP, asIso (r ∣_ O), ?_, hsm, ?_⟩
        · change r y ∈ (O : Set P)
          rw [hO]; exact hry
        · rw [asIso_hom, ← Category.assoc, morphismRestrict_ι, Category.assoc]

    have hsmE : SmoothOfRelativeDimension (n - 1 - 1) ((I.comap r).subschemeι ≫ r ≫ fP) := by
      apply wc_odp_smooth_of_closed_regular K _ _ (n - 1 - 1)
      intro z hz
      right
      have hyc : IsClosed ({(I.comap r).subschemeι z} : Set Yb) := by
        have := (I.comap r).subschemeι.isClosedEmbedding.isClosedMap _ hz
        rwa [Set.image_singleton] at this
      have hry : r ((I.comap r).subschemeι z) = xb := by
        have hmem : (I.comap r).subschemeι z ∈ Set.range (I.comap r).subschemeι := ⟨z, rfl⟩
        rw [hrange] at hmem
        exact hmem
      obtain ⟨W, hW, hzW, -⟩ :=
        exists_isAffineOpen_mem_and_subset (U := ⊤) (x := (I.comap r).subschemeι z) trivial
      obtain ⟨-, -, hquot⟩ := hchart _ hyc hry
      obtain ⟨hqr, hqd⟩ := hquot ⟨W, hW⟩ hzW
      obtain ⟨φ⟩ := wc_odp_subscheme_stalk Yb (I.comap r) z ⟨W, hW⟩ hzW
      haveI := hqr
      exact ⟨IsRegularLocalRing.of_ringEquiv φ.symm, (ringKrullDim_eq_of_ringEquiv φ).trans hqd⟩
    exact ⟨Yb, (I.comap r).subscheme, r ≫ fP, inferInstance, hsmY, (I.comap r).subschemeι,
      inferInstance, hsmE, r ⁻¹ᵁ O, hU, ⟨(asIso (r ∣_ O)).symm⟩⟩

theorem wc_pmn_odp_fibre_resolution (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [IsAlgClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    [IsProper (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))]
    (O : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens)
    (hO : (O : Set _) = {xs}ᶜ)
    [SmoothOfRelativeDimension (n - 1)
      (O.ι ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))] :
    ∃ (Yb E : Scheme.{u}) (fY : Yb ⟶ Spec (.of (IsLocalRing.ResidueField A))) (_ : IsProper fY)
      (_ : SmoothOfRelativeDimension (n - 1) fY) (iE : E ⟶ Yb) (_ : IsClosedImmersion iE)
      (U : Yb.Opens), (U : Set Yb) = (Set.range iE)ᶜ ∧ Nonempty ((O : Scheme.{u}) ≅ (U : Scheme.{u})) :=
by
  classical
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance
  haveI hSi : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  haveI hYp := D.proper
  haveI hYs := D.smooth

  have hρpt : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A := by
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
      | exact (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
      | (erw [Spec.map_apply]; exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
  have ht₀ : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      D.S i (IsLocalRing.closedPoint F'') :=
    (congrArg (fun p => V.hom (e.inv p)) hρpt).trans hV

  obtain ⟨σ, hσdef⟩ : ∃ σ : F'' →+* IsLocalRing.ResidueField A,
      σ = (Spec.preimage ((wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom)).hom := ⟨_, rfl⟩
  have e1 : Spec.map (CommRingCat.ofHom σ) = (wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom := by
    rw [hσdef]; exact Spec.map_preimage _
  have hA1 : (wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom =
      (Spec.map (CommRingCat.ofHom σ) ≫ D.S i) ≫ (wcP1Over F'').hom := by
    rw [Category.assoc (Spec.map (CommRingCat.ofHom σ)), D.hS i, Category.comp_id, e1]
  have hA2 : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      (Spec.map (CommRingCat.ofHom σ) ≫ D.S i)
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) :=
    ht₀.trans (congrArg (D.S i) (Subsingleton.elim (α := (Spec (.of F'') : Scheme.{u}))
      (IsLocalRing.closedPoint F'') _))
  have hsurj0 : Function.Surjective
      (Scheme.Hom.residueFieldMap (wcP1Over F'').hom (D.S i (IsLocalRing.closedPoint F''))).hom := by
    have hc := Scheme.residueFieldMap_comp (D.S i) (wcP1Over F'').hom (IsLocalRing.closedPoint F'')
    have hcc := Scheme.Hom.residueFieldMap_congr (D.hS i) (IsLocalRing.closedPoint F'')
    have hid := Scheme.residueFieldMap_id (X := Spec (.of F'')) (IsLocalRing.closedPoint F'')
    first
      | (rw [hid, Category.comp_id] at hcc)
      | (erw [hid, Category.comp_id] at hcc)
      | (simp only [Scheme.residueFieldMap_id, Category.comp_id] at hcc)
    have hnt : ∀ (X : Scheme.{u}) (x : X), Nontrivial (X.residueField x) := by
      intro X x
      first
        | infer_instance
        | exact inferInstanceAs (Nontrivial (IsLocalRing.ResidueField (X.presheaf.stalk x)))
        | exact (inferInstance : Field (X.residueField x)).toNontrivial
        | exact (inferInstanceAs (Field (IsLocalRing.ResidueField (X.presheaf.stalk x)))).toNontrivial
    haveI : Nontrivial ((Spec (.of F'')).residueField (IsLocalRing.closedPoint F'')) :=
      hnt _ _
    have hinj : Function.Injective
        (Scheme.Hom.residueFieldMap (D.S i) (IsLocalRing.closedPoint F'')).hom :=
      RingHom.injective _
    have gen : ∀ {K1 K2 K3 : CommRingCat.{u}} (a : K1 ⟶ K2) (b : K2 ⟶ K3) (c : K1 ≅ K3),
        c.hom = a ≫ b → Function.Injective b.hom → Function.Surjective a.hom := by
      intro K1 K2 K3 a b c hcab hb y
      refine ⟨c.inv.hom (b.hom y), hb ?_⟩
      have h1 : (c.inv ≫ c.hom).hom (b.hom y) = b.hom y := by rw [c.inv_hom_id]; rfl
      rw [hcab] at h1
      exact h1
    exact gen _ _ _ (hcc.symm.trans hc) hinj
  have cancel : ∀ {X X' Z : Scheme.{u}} (r : X ⟶ X') (s : X' ⟶ X) (f g : X ⟶ Z),
      r ≫ s = 𝟙 _ → s ≫ f = s ≫ g → f = g := by
    intro X X' Z r s f g h hsf
    calc f = (r ≫ s) ≫ f := by rw [h, Category.id_comp]
      _ = r ≫ (s ≫ f) := Category.assoc _ _ _
      _ = r ≫ (s ≫ g) := by rw [hsf]
      _ = (r ≫ s) ≫ g := (Category.assoc _ _ _).symm
      _ = g := by rw [h, Category.id_comp]
  have hfac : wcQmSp A ≫ e.inv ≫ V.hom = Spec.map (CommRingCat.ofHom σ) ≫ D.S i := by
    have hd := wc_spec_residue_maps_eq_of_surj (wcP1Over F'').hom (wcQmSp A ≫ e.inv ≫ V.hom)
      (Spec.map (CommRingCat.ofHom σ) ≫ D.S i) hA1 _ hA2 (by rw [ht₀]; exact hsurj0)
    have hr := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField
      (IsLocalRing.ResidueField A) (Spec (.of (IsLocalRing.ResidueField A))) (𝟙 _)
    exact cancel _ _ _ _ hr hd

  have Sq1 := IsPullback.of_hasPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
  have B : IsPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (Limits.pullback.snd V.hom D.f)
      (e.inv ≫ V.hom) D.f :=
    IsPullback.of_iso (IsPullback.of_hasPullback V.hom D.f) (Iso.refl _) e (Iso.refl _)
      (Iso.refl _) (by simp) (by simp) (by simp) (by simp)
  have Big := Sq1.paste_horiz B.flip
  rw [hfac] at Big
  obtain ⟨π₁, hπ₁⟩ : ∃ π : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
        D.Yt.left,
      π = Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Limits.pullback.snd V.hom D.f := ⟨_, rfl⟩
  rw [← hπ₁] at Big
  have Sq3 := IsPullback.of_hasPullback D.f (D.S i)
  obtain ⟨r, hR, hr1⟩ : ∃ r : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
        Limits.pullback D.f (D.S i),
      IsPullback r (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
        (Limits.pullback.snd D.f (D.S i)) (Spec.map (CommRingCat.ofHom σ)) ∧
      r ≫ Limits.pullback.fst D.f (D.S i) = π₁ :=
    ⟨_, IsPullback.of_right' Big Sq3, IsPullback.lift_fst _ _ _ _⟩
  have hw : π₁ ≫ D.Yt.hom =
      Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Spec.map (CommRingCat.ofHom σ) := by
    have h1 := Big.w
    rw [← D.hf, ← Category.assoc, h1, Category.assoc, Category.assoc, D.hS i, Category.comp_id]
  obtain ⟨j, hj1, hj2⟩ : ∃ j : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
        Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ)),
      j ≫ Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) = π₁ ∧
      j ≫ Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) =
        Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hιY : Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom = Limits.pullback.snd D.f (D.S i) := by
    rw [← D.hf, ← Category.assoc, Limits.pullback.condition, Category.assoc, D.hS i,
      Category.comp_id]
  have hBot := IsPullback.of_hasPullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))
  have hOut : IsPullback r (j ≫ Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)))
      (Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom) (Spec.map (CommRingCat.ofHom σ)) := by
    rw [hj2, hιY]; exact hR
  have hB : IsPullback r j (Limits.pullback.fst D.f (D.S i))
      (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
    IsPullback.of_bot hOut (hr1.trans hj1.symm) hBot
  have hC := hB.flip.paste_vert Sq3
  haveI hjCI : IsClosedImmersion j :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hC.flip hSi
  have hpY : Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) (j xs) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    have e2 : (j ≫ Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) xs = π₁ xs := by
      rw [hj1]
    rw [Scheme.Hom.comp_apply] at e2
    rw [e2, hπ₁, Scheme.Hom.comp_apply, hxs]
    exact hx₂
  have hcl := (wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs).1
  have hyc := j.isClosedEmbedding.isClosedMap _ hcl
  rw [Set.image_singleton] at hyc

  have key : ∀ y' : D.Yt.left, y' = D.xs i (IsLocalRing.closedPoint F'') →
      ∃ (t : Fin n → D.Yt.left.presheaf.stalk y')
        (τ' : (wcP1Over F'').left.presheaf.stalk (D.f y'))
        (M : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk y')),
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') = Ideal.span (Set.range t) ∧
        IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.f y')) = Ideal.span {τ'} ∧
        (D.f.stalkMap y').hom τ' - ∑ a, ∑ c, M a c * t a * t c ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') ^ 3 ∧
        IsUnit (M + M.transpose).det := by
    rintro _ rfl
    exact D.odp i
  obtain ⟨t, τ', M, hmt, hmτ, hcub, hdet⟩ := key _ hpY
  have hker := wc_cpfo_stalk_ker_closed_pt_base_change j
    (r ≫ Limits.pullback.snd D.f (D.S i))
    (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) D.f (D.S i) hC xs τ' hmτ
  haveI hqYs : SmoothOfRelativeDimension n (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hBot D.smooth
  haveI : LocallyOfFiniteType (Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hBot inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ)))
  have hdim := wc_lfi_smooth_stalk_dim (IsLocalRing.ResidueField A) _ (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom σ))) n (j xs) hyc
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hmapm := wc_lfi_rational_fibre_maxIdeal F'' (IsLocalRing.ResidueField A) σ D.Yt.left _
    D.Yt.hom (Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)))
