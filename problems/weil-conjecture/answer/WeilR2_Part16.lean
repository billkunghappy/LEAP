by
  classical

  have hOmega : ∀ {C₁ C₂ D₁ D₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂]
      [Category.{u+1} D₁] [Category.{u+1} D₂]
      {L : C₁ ⥤ C₂} {R : C₂ ⥤ C₁} (adj : L ⊣ R) (G : C₁ ⥤ D₁) (G' : C₂ ⥤ D₂)
      {F : D₁ ⥤ D₂} {H : D₂ ⥤ D₁} (adjS : F ⊣ H) (χ : R ⋙ G ⟶ G' ⋙ H),
      ∃ ω : G ⋙ F ⟶ L ⋙ G', ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q),
        ω.app M ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.app Q) := by
    intro C₁ C₂ D₁ D₂ _ _ _ _ L R adj G G' F H adjS χ
    have key : ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q),
        (adjS.homEquiv (G.obj M) (G'.obj (L.obj M))).symm
            (G.map (adj.unit.app M) ≫ χ.app (L.obj M)) ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.app Q) := by
      intro M Q y
      rw [← Adjunction.homEquiv_naturality_right_symm, Category.assoc]
      have hn := χ.naturality y
      simp only [Functor.comp_map] at hn
      rw [← hn, ← Category.assoc, ← G.map_comp, ← Adjunction.homEquiv_unit]
    refine ⟨{ app := fun M => (adjS.homEquiv (G.obj M) (G'.obj (L.obj M))).symm
                (G.map (adj.unit.app M) ≫ χ.app (L.obj M))
              naturality := ?_ }, key⟩
    intro M M' f
    simp only [Functor.comp_map]
    rw [key]
    refine (adjS.homEquiv_naturality_left_symm (G.map f) _).symm.trans (congrArg _ ?_)
    rw [← Category.assoc, ← G.map_comp, Adjunction.homEquiv_unit, Adjunction.unit_naturality]

  have hCoeff : ∀ {C₁ C₂ D₁ D₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂]
      [Category.{u+1} D₁] [Category.{u+1} D₂]
      {L : C₁ ⥤ C₂} {R : C₂ ⥤ C₁} (adj : L ⊣ R) (G : C₁ ⥤ D₁) (G' : C₂ ⥤ D₂)
      {F : D₁ ⥤ D₂} {H : D₂ ⥤ D₁} (adjS : F ⊣ H) (χ : R ⋙ G ⟶ G' ⋙ H)
      (ω : G ⋙ F ⟶ L ⋙ G')
      (_hω : ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q), ω.app M ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.app Q))
      {Y : C₁} {Y₂ : C₂} {Z : D₁} {Z' : D₂}
      (c : Y ⟶ R.obj Y₂) (lam : G.obj Y ⟶ Z) (lam' : G'.obj Y₂ ⟶ Z') (cp : Z ⟶ H.obj Z')
