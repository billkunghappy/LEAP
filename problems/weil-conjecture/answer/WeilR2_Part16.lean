    exact b6.comp ((Equiv.bijective _).comp (b4.comp ((hg (R.obj Q)).comp
      ((Equiv.bijective _).comp b1))))

  have hIso : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] (G' : C ⥤ D)
      {A : C} {T : D}
      (g' : T ⟶ G'.obj A) (_hg' : ∀ Q : C, Function.Bijective (fun x : A ⟶ Q => g' ≫ G'.map x))
      (M₀ : T ⟶ G'.obj A) (_hM : ∀ Q : C, Function.Bijective (fun x : A ⟶ Q => M₀ ≫ G'.map x)),
      ∃ τ : A ≅ A, g' ≫ G'.map τ.hom = M₀ := by
