          rw [e1]
          exact N.sub_mem hmem hf
      obtain ⟨u, hu⟩ := hunit
      have h1 : ((1 - i) + (1 - j)) * (↑u⁻¹ : A) = 1 := by rw [← hu, Units.mul_inv]
      refine ⟨(1 - i) * (↑u⁻¹ : A), ?_, ?_⟩
