      rw [hc, ← hfα]
      apply hcong
      rw [hz', hs0]
    obtain ⟨sec, hsec⟩ : ∃ sec : (K.homology q).val.obj (Opposite.op W) →
        (K.cycles q).val.obj (Opposite.op W),
