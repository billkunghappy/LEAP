    (κ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj
      (SheafOfModules.unit (wcZModRingSheaf T n)) ≅ wcContSheaf T (ZMod n))
    (hκ : wcZmKappaNorm T n κ)
    (ε' : wcFreeSheaf V.left (Scheme.ProEt.mk (𝟙 V.left)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf V.left n)).obj
        (SheafOfModules.unit (wcZModRingSheaf V.left n)))
    (hε1' : wcZmEpsNorm V.left n ε')
    (κ' : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf V.left n)).obj
      (SheafOfModules.unit (wcZModRingSheaf V.left n)) ≅ wcContSheaf V.left (ZMod n))
    (hκ' : wcZmKappaNorm V.left n κ')
    (lam : (wcLpscG T V).obj (wcContSheaf T (ZMod n)) ≅ wcContSheaf V.left (ZMod n))
