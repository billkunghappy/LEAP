  have zmod_iso_bij : ∀ {S1 S2 : Scheme.{u}} (g : S2 ⟶ S1) [IsIso g] (N : ℕ)
      (Dq : wcZModPullData g N), wcZModPullCanonical Dq →
      ∀ j : ℕ, Function.Bijective (wcZModPull Dq j) := by
    intro S1 S2 g _ N Dq hDq j
    obtain ⟨Di, hDi⟩ := wc_zmod_pull_data_exists (inv g) N
    obtain ⟨D1, hD1⟩ := wc_zmod_pull_data_exists (𝟙 S1) N
    obtain ⟨D2, hD2⟩ := wc_zmod_pull_data_exists (𝟙 S2) N
    constructor
    · intro a b hab
      have ha := wc_zmod_pull_comp g (inv g) (𝟙 S1) (IsIso.inv_hom_id g) Dq hDq Di hDi D1 hD1 j a
      have hb := wc_zmod_pull_comp g (inv g) (𝟙 S1) (IsIso.inv_hom_id g) Dq hDq Di hDi D1 hD1 j b
      rw [wc_zmod_pull_id _ rfl D1 hD1] at ha hb
      calc a = _ := ha
        _ = _ := by rw [hab]
        _ = b := hb.symm
    · intro y
      refine ⟨wcZModPull Di j y, ?_⟩
      have hy := wc_zmod_pull_comp (inv g) g (𝟙 S2) (IsIso.hom_inv_id g) Di hDi Dq hDq D2 hD2 j y
      rw [wc_zmod_pull_id _ rfl D2 hD2] at hy
      exact hy.symm

  have hm_iso : ∀ {S1 S2 : Scheme.{u}} (ψ : S2 ≅ S1),
      (∀ y : wcHM S1 ℓ q, y = 0) → ∀ y : wcHM S2 ℓ q, y = 0 := by
    intro S1 S2 ψ h y
    obtain ⟨Dψ, hDψ⟩ := wc_hm_pull_data_exists ψ.hom ℓ
    obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists ψ.inv ℓ
    obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (𝟙 S2) ℓ
    have h1 := wc_hm_pull_comp ψ.inv ψ.hom (𝟙 S2) ψ.hom_inv_id Di hDi Dψ hDψ D1 hD1 q y
    rw [wc_hm_pull_id _ rfl D1 hD1, h (wcHMPull Di q y), map_zero] at h1
    exact h1

  have hfin := wc_pmn_milnor_fib_zmod_finite F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    x hx₁ hx₂ B Λ' W'' φ' a' hsh
  have hzeroS : ∀ (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
      [TotallyDisconnectedSpace S] [ExtremallyDisconnected S]
      [WeaklyEtale (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')]
      (s : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
        (Opposite.op (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')))), s = 0 := by
    intro S _ _ _ _ _ _ s
    haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B))) :=
      WeaklyEtale.of_comp _ a'
    have hwc := wc_lc_shens_wcontr B S
    let W : (Spec (.of B)).ProEt := Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
    have hbij : ∀ (N : ℕ) (z : W.left), IsClosed ({z} : Set W.left) →
        ∀ {Pq : Scheme.{u}} (qq : Pq ⟶ Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)
        (t : Pq ⟶ Spec (W.left.presheaf.stalk z)),
        IsPullback qq t (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)
          (W.left.fromSpecStalk z ≫ W.hom ≫ 𝟙 (Spec (.of B))) →
        ∀ (Dq : wcZModPullData qq N), wcZModPullCanonical Dq →
          ∀ j : ℕ, Function.Bijective (wcZModPull Dq j) := by
      intro N z hz Pq qq t hpb Dq hDq j
      have h0 : IsIso (W.left.fromSpecStalk z ≫ W.hom) := wc_lc_closed_stalk_iso B S z hz
      haveI : IsIso (W.left.fromSpecStalk z ≫ W.hom ≫ 𝟙 (Spec (.of B))) := by
        first
          | (convert h0 using 2; exact Category.comp_id _)
          | (simp only [Category.comp_id]; exact h0)
          | exact ⟨⟨inv (W.left.fromSpecStalk z ≫ W.hom), by simp, by simp⟩⟩
      haveI : IsIso qq := hpb.isIso_fst_of_isIso
      exact zmod_iso_bij qq N Dq hDq j
    haveI hTa : IsAffine ((wcProEtBC
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)).obj W).left :=
      (inferInstance : IsAffine (Limits.pullback (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)))
    haveI : CompactSpace W.left :=
      (inferInstance : CompactSpace (Spec (.of (LocallyConstant S B))))
    haveI : CompactSpace ↥((𝟭 Scheme.{u}).obj W.left) :=
      (inferInstance : CompactSpace (Spec (.of (LocallyConstant S B))))
    haveI hTa' : IsAffine (Limits.pullback W.hom
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)) := hTa
    haveI : CompactSpace ↥(Limits.pullback (C := Scheme.{u}) W.hom
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)) := inferInstance
    haveI : QuasiSeparatedSpace ↥(Limits.pullback (C := Scheme.{u}) W.hom
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)) := inferInstance
    obtain ⟨D₀, hD₀⟩ := wc_hm_pull_data_exists (((wcProEtBC
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)).obj W).hom ≫
        𝟙 (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)) ℓ
    choose Dz hDz using fun k : ℕ => wc_zmod_pull_data_exists (((wcProEtBC
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)).obj W).hom ≫
        𝟙 (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)) (ℓ ^ k)
    have he : Function.Bijective (fun c : Fin 0 → ℚ_[ℓ] =>
        ∑ a, wcHMScalar (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ q (c a)
          ((fun b : Fin 0 => b.elim0 :
            Fin 0 → wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ q) a)) := by
      refine ⟨fun c c' _ => Subsingleton.elim c c', fun y => ⟨fun b => b.elim0, ?_⟩⟩
      rw [hF y]
      simp
    have hkun := wc_hm_ladic_kunneth_passage ℓ
      (Limits.pullback.fst W.hom (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) :
        ((wcProEtBC (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)).obj W).left ⟶
          W.left)
      (((wcProEtBC (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)).obj W).hom ≫
        𝟙 (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left))
      D₀ hD₀ Dz hDz hfin
      (fun k j _ => wc_wcontr_torsion_kunneth_of_base_bij
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)
        (𝟙 (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)) (𝟙 (Spec (.of B)))
        IsPullback.of_id_fst inferInstance inferInstance (ℓ ^ k) W hwc (hbij (ℓ ^ k)) j
        (Dz k) (hDz k))
      q 0 (fun b : Fin 0 => b.elim0) he
    have hT : ∀ y : wcHM ((wcProEtBC
        (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)).obj W).left ℓ q, y = 0 := by
      intro y
      obtain ⟨c, hc⟩ := hkun.2 y
      rw [← hc]
      first
        | rfl
        | (simp only [Fin.sum_univ_zero]; done)
        | (simp only [Fin.sum_univ_zero]; rfl)
        | (simp; rfl)
    have hvan : ∀ y : wcHM ((wcProEtBC ((wcProEtPullback D.f).map a₀).left).obj
        (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))).left ℓ q, y = 0 :=
      hm_iso (Limits.pullbackRightPullbackFstIso a' ((wcProEtPullback D.f).map a₀).left
        (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))).symm hT
    have hP := wc_proet_free_projective_wcontractible _ (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')) hwc
    exact wc_proet_push_homology_section_local_death ((wcProEtPullback D.f).map a₀).left ℓ Dp I q
      _ hP hvan s

  obtain ⟨Dk₀, hDk₀⟩ :=
    wc_hm_pull_data_exists (((wcProEtPullback D.f).obj V).left.fromSpecResidueField x) ℓ
  have hZ₀ := wc_proet_point_pull_isZero_of_shens_sections x ℓ B Λ' W'' φ' a' hsh _ hzeroS
    Dk₀ hDk₀

  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists (Spec.map f) ℓ
  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso _ (Spec.map f) k hkf.symm Dk₀ hDk₀ Dπ hDπ Dk hDk
  haveI := Dπ.additive
  exact Limits.IsZero.of_iso (Dπ.Φ.map_isZero hZ₀) (c.app _)

theorem wc_pmn_vp_restr_higher_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
    (q : ℕ) (hq1 : 1 ≤ q) (hqN : q ≠ n - 1) :
    haveI := Dp.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    Limits.IsZero (Di.Φ.obj
      (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :=
by
  intro P
  haveI := Dp.additive

  have hpt0 : V.hom (e.inv (IsLocalRing.closedPoint A)) =
      D.f (D.xs i (IsLocalRing.closedPoint F'')) := by
    rw [hV, ← D.hxs i]
    rfl
  obtain ⟨x, hx₁, hx₂⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hpt0
  have hinv : ∀ p, e.hom (e.inv p) = p := fun p => by
    rw [← Scheme.Hom.comp_apply, e.inv_hom_id]
    rfl
  have hpt : (Limits.pullback.fst V.hom D.f ≫ e.hom) x =
      (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    change e.hom ((Limits.pullback.fst V.hom D.f) x) = _
    refine (congrArg e.hom hx₁).trans ((hinv _).trans ?_)
    exact (IsLocalRing.comap_closedPoint (IsLocalRing.residue A)).symm
  obtain ⟨xs, hxs, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hpt

  obtain ⟨hcl, hsep, hnoeth, huniq⟩ :=
    wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  haveI := hsep
  haveI := hnoeth

  let ι := (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).fromSpecResidueField xs
  haveI : IsClosedImmersion ι := IsClosedImmersion.of_isPreimmersion ι
    (by rw [Scheme.range_fromSpecResidueField]; exact hcl)
  let O : (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens :=
    ⟨({xs} : Set _)ᶜ, hcl.isOpen_compl⟩
  have hO' : (O : Set _) = (Set.range ι)ᶜ := by
    rw [Scheme.range_fromSpecResidueField]; rfl
  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists ι ℓ
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists O.ι ℓ

  have hK0 := wc_pmn_vp_restr_off_node_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    Dp hDp Di hDi I O (fun z hz h => hz (Set.mem_singleton_iff.mpr (huniq z h))) Dj hDj q hq1

  obtain ⟨M, ⟨σ⟩⟩ :=
    wc_proet_closed_push_essImage_of_open_pull_isZero ι ℓ O hO' Dι hDι Dj hDj _ hK0

  obtain ⟨hFu, hFa⟩ := wc_proet_closed_push_modules_full_faithful ι ℓ Dι hDι
  haveI := hFu
  haveI := hFa
  haveI : IsIso Dι.adj.counit := Adjunction.counit_isIso_of_R_fully_faithful Dι.adj
  let ε := asIso (Dι.adj.counit.app M)

  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (B := ((wcProEtPullback D.f).obj V).left) x
  have hsh : wcHalShData x B Λ' W'' φ' a' := ⟨h1, h2, h3, h4, h5, eB, h6, h7⟩
  have hF := wc_pmn_vp_milnor_fib_hm_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    x hx₁ hx₂ B Λ' W'' φ' a' hsh q hq1 hqN

  let iS := Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
  let k := ι ≫ iS
  have hk : k (IsLocalRing.closedPoint _) = x := by
    change iS (ι (IsLocalRing.closedPoint _)) = x
    exact (congrArg iS (Scheme.fromSpecResidueField_apply xs _)).trans hxs
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists k ℓ
  have hZ := wc_pmn_vp_node_stalk_vanish_of_fib F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    x hx₁ hx₂ B Λ' W'' φ' a' hsh Dp hDp I
    ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs)
    k hk Dk hDk q hF

  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso iS ι k rfl Di hDi Dι hDι Dk hDk

  have hM : Limits.IsZero M :=
    Limits.IsZero.of_iso hZ (ε.symm ≪≫ Dι.Φ.mapIso σ ≪≫ (c.app _).symm)
  haveI := Dι.additive
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC ι) _ _ Dι.cont Dι.φ).Additive :=
    Adjunction.right_adjoint_additive Dι.adj
  exact Limits.IsZero.of_iso
    ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC ι) _ _ Dι.cont Dι.φ).map_isZero hM)
    σ.symm

theorem wc_zmod_model_structure_maps (n : ℕ) (hn : 0 < n) :
    (∀ T : Scheme.{u},
      ∃ (ε : wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) ⟶
          (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj
            (SheafOfModules.unit (wcZModRingSheaf T n)))
        (κ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj
          (SheafOfModules.unit (wcZModRingSheaf T n)) ≅ wcContSheaf T (ZMod n)),
        (∀ M : SheafOfModules.{u+1} (wcZModRingSheaf T n),
          Function.Bijective (fun f : SheafOfModules.unit (wcZModRingSheaf T n) ⟶ M =>
            ε ≫ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).map f)) ∧
        wcZmEpsNorm T n ε ∧ wcZmKappaNorm T n κ) ∧
    (∀ (S : Scheme.{u}) (U : S.ProEt)
        [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)],
      ∃ lam : (wcLpscG S U).obj (wcContSheaf S (ZMod n)) ≅ wcContSheaf U.left (ZMod n),
        wcZmLamNorm S U n lam) :=
by
  classical
  have corep : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (T : C) (hT : Limits.IsTerminal T),
      ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        (∀ M : SheafOfModules.{u+1} R, Function.Bijective
          (fun f : SheafOfModules.unit R ⟶ M => ε ≫ (SheafOfModules.toSheaf.{u+1} R).map f)) ∧
        (ε.hom.app (Opposite.op T)).hom
          (((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))) =
          (1 : R.obj.obj (Opposite.op T)) := by
    intro C _ J _ _ R T hT
    set P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free with hP
    let e : ∀ X : Cᵒᵖ, P.obj X := fun X => FreeAbelianGroup.of (ULift.up (hT.from X.unop))
    have hgen : ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)), x = ULift.up (hT.from X.unop) :=
      fun X x => ULift.ext _ _ (hT.hom_ext _ _)
    have hPmap : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), P.map f (e X) = e Y := by
      intro X Y f
      exact (FreeAbelianGroup.map_of_apply _).trans (congrArg FreeAbelianGroup.of (hgen Y _))
    have huniq : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (φ ψ : P ⟶ G),
        (∀ X : Cᵒᵖ, φ.app X (e X) = ψ.app X (e X)) → φ = ψ := by
      intro G φ ψ h
      apply NatTrans.ext
      funext X
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      rw [hgen X x]
      exact h X
    let G0 : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      (PresheafOfModules.toPresheaf R.obj).obj (PresheafOfModules.unit R.obj)
    let η : P ⟶ G0 :=
      { app := fun X => AddCommGrpCat.ofHom
          (FreeAbelianGroup.lift (β := G0.obj X) (fun _ => show G0.obj X from (1 : R.obj.obj X)))
        naturality := by
          intro X Y f
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro x
          show FreeAbelianGroup.lift _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of x)) =
            (G0.map f).hom (FreeAbelianGroup.lift _ (FreeAbelianGroup.of x))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          exact ((PresheafOfModules.presheaf_map_apply_coe (PresheafOfModules.unit R.obj) f _).trans
            (PresheafOfModules.unit_map_one R.obj f)).symm }
    have hη : ∀ X : Cᵒᵖ, η.app X (e X) = (1 : R.obj.obj X) := by
      intro X
      exact FreeAbelianGroup.lift_apply_of _ _
    let adj := sheafificationAdjunction J AddCommGrpCat.{u+1}
    obtain ⟨ε, hε⟩ : ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj P ⟶
        (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        adj.homEquiv _ _ ε = η := ⟨(adj.homEquiv _ _).symm η, Equiv.apply_symm_apply _ _⟩
    have hstar : toSheafify J P ≫ ε.hom = η := by
      refine Eq.trans ?_ hε
      rw [Adjunction.homEquiv_unit]
      exact congrArg (fun φ => φ ≫ ε.hom)
        (sheafificationAdjunction_unit_app J P).symm
    refine ⟨ε, fun M => ?_, ?_⟩
    swap
    · have h1 := congrArg (fun φ : P ⟶ G0 => (φ.app (Opposite.op T)).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 T)) : P.obj (Opposite.op T))) hstar
      exact h1.trans (FreeAbelianGroup.lift_apply_of _ _)
    have key : ∀ f : SheafOfModules.unit R ⟶ M,
        adj.homEquiv P _ (ε ≫ (SheafOfModules.toSheaf R).map f) =
          η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val := by
      intro f
      rw [Adjunction.homEquiv_naturality_right, hε]
      rfl
    have hev : ∀ (f : SheafOfModules.unit R ⟶ M) (X : Cᵒᵖ),
        (η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val).app X (e X) =
          (M.unitHomEquiv f).val X := by
      intro f X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show ((PresheafOfModules.toPresheaf R.obj).map f.val).app X (η.app X (e X)) = _
      rw [hη X]
      rfl
    constructor
    · intro f f' hff
      have h1 := congrArg (adj.homEquiv P _) hff
      simp only [key] at h1
      have h2 : M.unitHomEquiv f = M.unitHomEquiv f' := by
        apply Subtype.ext
        funext X
        exact (hev f X).symm.trans
          ((congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.app X) (e X)) h1).trans (hev f' X))
      exact M.unitHomEquiv.injective h2
    · intro θ
      let ψ := adj.homEquiv P _ θ
      let s : ∀ X : Cᵒᵖ, M.val.obj X := fun X => ψ.app X (e X)
      have hs : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), M.val.map f (s X) = s Y := by
        intro X Y f
        have h := congrArg (fun g => AddCommGrpCat.Hom.hom g (e X)) (ψ.naturality f)
        exact (PresheafOfModules.presheaf_map_apply_coe M.val f (s X)).symm.trans
          (h.symm.trans (congrArg (fun z => AddCommGrpCat.Hom.hom (ψ.app Y) z) (hPmap f)))
      refine ⟨M.unitHomEquiv.symm (PresheafOfModules.sectionsMk s hs), ?_⟩
      apply (adj.homEquiv P _).injective
      show adj.homEquiv P _ (ε ≫ _) = ψ
      rw [key]
      apply huniq
      intro X
      refine (hev _ X).trans ?_
      rw [Equiv.apply_symm_apply, PresheafOfModules.sectionsMk_coe]
      rfl
  refine ⟨fun T => ?_, fun S U _ => ?_⟩
  · have hT : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 T)) :=
      Limits.IsTerminal.ofUniqueHom (fun V => wcZmToTop T V)
        (fun V g => MorphismProperty.Over.Hom.ext
          ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)))
    obtain ⟨ε, hbij, hnorm⟩ := corep (Scheme.ProEt.topology T) (wcZModRingSheaf T n)
      (Scheme.ProEt.mk (𝟙 T)) hT
    let GZ := (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj
      (SheafOfModules.unit (wcZModRingSheaf T n))
    let jZ := wcContSheaf T (ZMod n)
    let eZ : ∀ V : (T.ProEt)ᵒᵖ, GZ.obj.obj V ≅ jZ.obj.obj V := fun V =>
      { hom := AddCommGrpCat.ofHom
          { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
                (r : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod n)))) :
                ULift.{u+1} C(↥(Opposite.unop V).left, ZMod n))
            map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
            map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
        inv := AddCommGrpCat.ofHom
          { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
                (w.down : C(↥(Opposite.unop V).left, ZMod n)) :
                C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod n)))
            map_zero' := ContinuousMap.ext fun _ => rfl
            map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
        hom_inv_id := by
          apply AddCommGrpCat.ext
          intro r
          rfl
        inv_hom_id := by
          apply AddCommGrpCat.ext
          intro w
          rfl }
    let NZ : GZ.obj ≅ jZ.obj := NatIso.ofComponents eZ (fun {V W} f => by
      apply AddCommGrpCat.ext
      intro r
      rfl)
    let κ : GZ ≅ jZ := ObjectProperty.isoMk _ NZ
    refine ⟨ε, κ, hbij, ?_, ?_⟩
    · exact hnorm
    · intro W f x
      rfl
  · let e : ∀ W : (U.left.ProEt)ᵒᵖ, ((wcLpscG S U).obj (wcContSheaf S (ZMod n))).obj.obj W ≅
        (wcContSheaf U.left (ZMod n)).obj.obj W := fun W => Iso.refl _
    let N : ((wcLpscG S U).obj (wcContSheaf S (ZMod n))).obj ≅ (wcContSheaf U.left (ZMod n)).obj :=
      NatIso.ofComponents e (fun {V W} f => by
        apply AddCommGrpCat.ext
        intro r
        rfl)
    refine ⟨ObjectProperty.isoMk _ N, ?_⟩
    intro W f x
    rfl

theorem wc_zmod_ct_bij (T : Scheme.{u}) (n : ℕ) (hn : 0 < n) (j : ℕ)
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n))]
    (ε : wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj (SheafOfModules.unit (wcZModRingSheaf T n)))
    (hε : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf T n),
      Function.Bijective (fun f : SheafOfModules.unit (wcZModRingSheaf T n) ⟶ M =>
        ε ≫ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).map f))
    (κ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj
      (SheafOfModules.unit (wcZModRingSheaf T n)) ≅ wcContSheaf T (ZMod n)) :
    Function.Bijective (wcZmCt T n j ε κ) :=
by
  classical
  letI instEp : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
  obtain ⟨αp, hαp1, hαp2, hαp3⟩ := wc_proet_zmod_ring_locbij T n hn
  obtain ⟨hFp, hEp⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.ProEt.topology T)
    (wcZModRingSheaf T n) n αp hαp1 hαp2
  haveI := hFp
  haveI : EssentiallySmall.{u+1} T.ProEt := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI hEIp : EnoughInjectives (Sheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  haveI hEImp : EnoughInjectives (SheafOfModules.{u+1} (wcZModRingSheaf T n)) :=
    sheafOfModules_enoughInjectives _ _
  let ψp := (wc_free_terminal_const T).some
  have hvanA : ∀ (Jm : SheafOfModules.{u+1} (wcZModRingSheaf T n)) [Injective Jm] (m : ℕ)
      (x : Abelian.Ext (wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)))
        ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj Jm) (m + 1)), x = 0 := by
    intro Jm _ m x
    have h0 : (Abelian.Ext.mk₀ ψp.inv).comp x (zero_add (m + 1)) = 0 :=
      sheafOfModules_torsion_injective_acyclic (Scheme.ProEt.topology T) (wcZModRingSheaf T n) n hn
        hαp3 hEp Jm m _
    calc x = (Abelian.Ext.mk₀ (𝟙 _)).comp x (zero_add (m + 1)) := (Abelian.Ext.mk₀_id_comp x).symm
      _ = ((Abelian.Ext.mk₀ ψp.hom).comp (Abelian.Ext.mk₀ ψp.inv) (add_zero 0)).comp x
            (zero_add (m + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ ψp.hom).comp ((Abelian.Ext.mk₀ ψp.inv).comp x (zero_add (m + 1)))
            (zero_add (m + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (m + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
  have hA := ext_transfer_of_corep (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n))
    (SheafOfModules.unit (wcZModRingSheaf T n)) (wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T))) ε hε hvanA
  have hpost : Function.Bijective (fun y : Abelian.Ext (wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)))
      ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T n)).obj
        (SheafOfModules.unit (wcZModRingSheaf T n))) j =>
      y.comp (Abelian.Ext.mk₀ κ.hom) (add_zero j)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => z.comp (Abelian.Ext.mk₀ κ.inv) (add_zero j), fun y => ?_, fun z => ?_⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  exact hpost.comp (hA _ j)

theorem wc_zmod_rho_bij (S : Scheme.{u}) (U : S.ProEt) (n j : ℕ)
    [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
    [(wcLpscG S U).Additive] [Limits.PreservesFiniteLimits (wcLpscG S U)]
    [Limits.PreservesFiniteColimits (wcLpscG S U)]
    (lam : (wcLpscG S U).obj (wcContSheaf S (ZMod n)) ≅ wcContSheaf U.left (ZMod n)) :
    Function.Bijective (wcZmRho S U n j lam) :=
by
  classical
  have hev : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (W : C) (Q : Sheaf J' AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) := by
    intro C _ J' _ W Q
    let e := ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ Q).trans
      (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
    have h : (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) = ⇑e := by
      funext φ
      simp only [e, Equiv.trans_apply]
      rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    rw [h]
    exact e.bijective
  have hkey : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : Sheaf J' AddCommGrpCat.{u+1}) (γ : P ⟶ Q.obj) (Uo : Cᵒᵖ) (s : P.obj Uo),
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ).hom.app Uo
        ((toSheafify J' P).app Uo s) = γ.app Uo s := by
    intro C _ J' _ P Q γ Uo s
    have h := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_unit P Q
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ)
    rw [Equiv.apply_symm_apply, sheafificationAdjunction_unit_app] at h
    exact (congrArg (fun φ : P ⟶ Q.obj => φ.app Uo s) h).symm
  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))
  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
