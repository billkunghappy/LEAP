    obtain ⟨z, hz⟩ := hsurj _ hoff
    have hzW : (wcPencilSOpen D).ι
        (Limits.pullback.fst (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom p) =
        W.hom z :=
      e1.trans ((congrArg (fun y => (wcGeomPoint F'' (wcP1Over F'') hP).hom y) hz.symm).trans
        ((Scheme.Hom.comp_apply w.left _ z).symm.trans
          (congrArg (fun f : W.left ⟶ (wcP1Over F'').left => f z) (MorphismProperty.Over.w w))))
    obtain ⟨z', _, hz'2⟩ := Scheme.Pullback.exists_preimage_pullback
