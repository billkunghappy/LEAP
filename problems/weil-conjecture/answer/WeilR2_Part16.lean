  have hext : ∀ (k : ℕ) (V : (wcP1Over F'').left.ProEt)
      (f g : (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval (wcP1Over F'').left V f z = wcContEval (wcP1Over F'').left V g z) →
      f = g := by
    intro k V f g hfg
    apply ULift.ext
    apply ContinuousMap.ext
    exact hfg

  let τ : (wcRq D.f ℓ (2 * (n - 1))).over W ⟶
      (wcContSheaf (wcP1Over F'').left (Fin 1 → ℚ_[ℓ])).over W :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1} w).map tr

  obtain ⟨a, ha⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ W hW r 1 (θ.inv ≫ τ)
  have hτ : θ.hom ≫ (θ.inv ≫ τ) = τ := θ.hom_inv_id_assoc τ
  rw [ha] at hτ

  have key : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ W)
      (y : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V)) (z : V.left),
      wcContEval (wcP1Over F'').left V ((tr.hom.app (Opposite.op (Over.mk (h ≫ w)))).hom y) z =
        a (wcContEval (wcP1Over F'').left V ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom y) z) := by
    intro V h y z
    have h1 := congrArg (fun φ : (wcRq D.f ℓ (2 * (n - 1))).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin 1 → ℚ_[ℓ])).over W =>
      wcContEval (wcP1Over F'').left V ((φ.hom.app (Opposite.op (Over.mk h))).hom y) z) hτ
    exact h1.symm

  have ha_inj : Function.Injective a := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv0
    let cv : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V₀) :=
      (ULift.up (ContinuousMap.const V₀.left v) : ULift C(V₀.left, Fin r → ℚ_[ℓ]))
    have hcv : ∀ z, wcContEval (wcP1Over F'').left V₀ cv z = v := fun _ => rfl
    let y := (θ.inv.hom.app (Opposite.op (Over.mk ι))).hom cv
    have hy : (θ.hom.hom.app (Opposite.op (Over.mk ι))).hom y = cv := by
      have h2 := congrArg (fun φ : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W ⟶
          (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W =>
        (φ.hom.app (Opposite.op (Over.mk ι))).hom cv) θ.inv_hom_id
      exact h2
    have htr0 : (tr.hom.app (Opposite.op (Over.mk (ι ≫ w)))).hom y = 0 := by
      apply hext 1 V₀
      intro z
      rw [key V₀ ι y z, hy, hcv z, hv0]
      rfl
    have hy0 : y = 0 := hinj (htr0.trans (map_zero _).symm)
    have hcv0 : cv = 0 := by
      rw [← hy, hy0]
      first
        | exact map_zero _
        | rfl
        | simp
    have h3 := congrArg (fun f => wcContEval (wcP1Over F'').left V₀ f z₀) hcv0
    simp only [hcv] at h3
    exact h3

  intro V _ _ h₁ h₂ x hh
  have e1 : (tr.hom.app (Opposite.op (Over.mk (h₁ ≫ w)))).hom x =
      (tr.hom.app (Opposite.op (Over.mk (h₂ ≫ w)))).hom x := by rw [hh]
  apply hext r V
  intro z
  apply ha_inj
  rw [← key V h₁ x z, ← key V h₂ x z, e1]

