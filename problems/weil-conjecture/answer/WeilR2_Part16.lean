    simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h2
    rw [h2, hs, map_zero]

  have s8 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (U : Z.Etale) (s : G.obj.obj (Opposite.op U)), IsOpen {p : U.left | ∃ (T : Z.Etale)
        (h : T ⟶ U) (t : T.left), h.left t = p ∧ (G.obj.map h.op).hom s = 0} := by
    intro Z G U s
    rw [isOpen_iff_forall_mem_open]
    rintro p ⟨T, h, t, ht, hs⟩
    haveI := hEtArr Z T U h
    refine ⟨Set.range h.left, ?_, (Scheme.Hom.isOpenMap h.left).isOpen_range, ⟨t, ht⟩⟩
    rintro _ ⟨t'', rfl⟩
    exact ⟨T, h, t'', rfl, hs⟩

  have s6 : ∀ (S : Set Y) (V : Y.Etale) (Ω : Set ((wcEtBaseChange b).obj V).left), IsOpen Ω →
      (∀ p, p ∉ Ω → b (((wcEtBaseChange b).obj V).hom p) ∈ S) → ∀ v : V.left, V.hom v ∉ S →
      ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left), g.left w = v ∧
        ∀ p : ((wcEtBaseChange b).obj W).left, ((wcEtBaseChange b).map g).left p ∈ Ω := by
    intro S V Ω hΩ hcompl v hv
    haveI : IsProper (Limits.pullback.fst V.hom b) := inferInstance
    let D : Set V.left := (Limits.pullback.fst V.hom b) '' Ωᶜ
    have hD : IsClosed D :=
      Scheme.Hom.isClosedMap (Limits.pullback.fst V.hom b) _ hΩ.isClosed_compl
    have hvD : v ∉ D := by
      rintro ⟨p, hp, hpv⟩
      apply hv
      have h1 := hcompl p hp
      have hc := congrArg (fun φ => φ p) (Limits.pullback.condition (f := V.hom) (g := b))
      simp only [Scheme.Hom.comp_apply] at hc
      rw [← hpv, hc]
      exact h1
    let O : V.left.Opens := ⟨Dᶜ, hD.isOpen_compl⟩
    haveI : Etale V.hom := V.prop
    let W : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) inferInstance
    let g : W ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    refine ⟨W, g, (⟨v, hvD⟩ : (O : Scheme.{u})), Scheme.Opens.ι_apply O _, ?_⟩
    intro p
    by_contra hp
    have h2 : ((wcEtBaseChange b).map g).left ≫ Limits.pullback.fst V.hom b =
        Limits.pullback.fst W.hom b ≫ g.left := Limits.pullback.lift_fst _ _ _
    have h3 := congrArg (fun φ => φ p) h2
    have h3' : Limits.pullback.fst V.hom b (((wcEtBaseChange b).map g).left p) =
        g.left (Limits.pullback.fst W.hom b p) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans (h3.trans (Scheme.Hom.comp_apply _ _ _))
    have h4 : g.left (Limits.pullback.fst W.hom b p) ∈ O :=
      (congrArg (· ∈ O) (Scheme.Opens.ι_apply O (Limits.pullback.fst W.hom b p))).mpr
        (Limits.pullback.fst W.hom b p).2
    have h5 : Limits.pullback.fst V.hom b (((wcEtBaseChange b).map g).left p) ∈ O :=
      (congrArg (· ∈ O) h3').mpr h4
    exact (h5 : _ ∉ D) ⟨_, hp, rfl⟩

  have L4 : ∀ (Z : Scheme.{u}) (Wset : Set Z)
      (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), wcSuppIn Z Wset G →
      ∀ (U : Z.Etale) (s : G.obj.obj (Opposite.op U)) (p : U.left), U.hom p ∉ Wset →
      ∃ (T : Z.Etale) (h : T ⟶ U) (t : T.left), h.left t = p ∧ (G.obj.map h.op).hom s = 0 := by
    intro Z Wset G hsupp U s p hp
    have hmem := hsupp U s
    obtain ⟨V₁, c, hc, y, hy⟩ := hcovR Z U _ hmem p
    rw [Sieve.generate_apply] at hc
    obtain ⟨V', k, g₀, hg₀, hkc⟩ := hc
    rcases hg₀ with h0 | hall
    · refine ⟨V₁, c, y, hy, ?_⟩
      have h0' : (G.obj.map g₀.op).hom s = 0 := h0
      rw [← hkc, op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
        h0', map_zero]
    · exfalso
      apply hp
      have e1 : U.hom p = V₁.hom y := by
        rw [← hy, ← MorphismProperty.Over.w c, Scheme.Hom.comp_apply]
      have e2 : V₁.hom y = V'.hom (k.left y) := by
        rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
      rw [e1, e2]
      exact hall _

  haveI hi' : IsClosedImmersion (Limits.pullback.fst b iZ) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback b iZ).flip inferInstance
  let G := (SheafOfModules.toSheaf (wcEtZModRing X' m)).obj (Limits.kernel (wcEtSuppUnitMap DE))
  let s : G.obj.obj (Opposite.op ((wcEtBaseChange b).obj V)) := t

  have Q2 : ∀ {Y ZY : Scheme.{u}} (iY : ZY ⟶ Y) (n : ℕ) (DY : wcEtPullData iY n),
      wcSuppIn Y (Set.range iY)ᶜ ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj
        (Limits.kernel (wcEtSuppUnitMap DY))) := by
    intro Y ZY iY n DY
    have locbij : ∀ (S : Scheme.{u}) (n : ℕ),
        ∃ α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj,
          Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) α ∧
          Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α := by
      intro S n
      let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
        (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
      exact ⟨toSheafify (Scheme.smallEtaleTopology S) P,
        Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) P,
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S) P⟩
    have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
        R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
        ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
      intro S V R h x
      haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
      have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
      obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
      exact ⟨Y, f, y, h1, h3⟩
    have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
        ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
          wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
            = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
      intro S T j n E
      refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
      dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
      rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
        ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
    have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
        (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
        (c : ULift.{u+1} (ZMod n)),
        (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
      intro S n V α c
      have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
        apply ULift.ext
        rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
      conv_lhs => rw [hc]
      exact map_intCast (α.app (Opposite.op V)).hom _
    have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
        (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
      intro S n V k hk
      by_cases hV : IsEmpty V.left
      · exact Or.inr hV
      · left
        obtain ⟨x⟩ := not_isEmpty_iff.mp hV
        obtain ⟨α, hinj, hsurj⟩ := locbij S n
        have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
            (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
          rw [map_intCast, map_zero]; exact hk
        have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
        obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
        have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
        have h3 := congrArg ULift.down h2
        rw [ULift.down_intCast] at h3
        exact h3
    unfold wcSuppIn
    intro V s
    let k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)) :=
      ((Limits.kernel.ι (wcEtSuppUnitMap DY)).val.app (Opposite.op V)).hom s
    have hρk : ((wcEtSuppUnitMap DY).val.app (Opposite.op V)).hom k = 0 := by
      have h := congrArg (fun h => (h.val.app (Opposite.op V)).hom s)
        (Limits.kernel.condition (wcEtSuppUnitMap DY))
      exact h
    have hφk : (DY.φ.hom.app (Opposite.op V)).hom k = 0 := by
      obtain ⟨e', he'⟩ := twist DY
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom k) he'
      change (e'.val.app (Opposite.op ((wcEtBaseChange iY).obj V))).hom
        (((wcEtSuppUnitMap DY).val.app (Opposite.op V)).hom k) =
        (DY.φ.hom.app (Opposite.op V)).hom k at h2
      rw [hρk] at h2
      exact h2.symm.trans (LinearMap.map_zero _)
    obtain ⟨α, -, hsurj⟩ := locbij Y n
    refine GrothendieckTopology.superset_covering _ ?_
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α k)
    intro V' g hg
    apply Sieve.le_generate
    obtain ⟨c, hc⟩ := hg
    have hk' : ((wcEtZModRing Y n).obj.map g.op).hom k =
        ((c.down.cast : ℤ) : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V'))) :=
      hc.symm.trans (intcast_eq Y n V' α c)
    have hnat := congrArg (fun h => h.hom k) (DY.φ.hom.naturality g.op)
    simp only [RingCat.hom_comp, RingHom.comp_apply] at hnat
    rw [hφk, map_zero, hk', map_intCast] at hnat
    rcases intzero ZY n ((wcEtBaseChange iY).obj V') _ hnat with hk0 | hE
    · left
      rw [ZMod.intCast_zmod_cast] at hk0
      have hc0 : c = 0 := ULift.ext _ _ hk0
      have hk0' : ((wcEtZModRing Y n).obj.map g.op).hom k = 0 := by
        rw [← hc, hc0, map_zero]
      let G := SheafOfModules.toSheaf (wcEtZModRing Y n) ⋙
        sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op V')
      haveI : Limits.PreservesFiniteLimits G := inferInstance
      haveI : G.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape G
      have hm : Mono (G.map (Limits.kernel.ι (wcEtSuppUnitMap DY))) := inferInstance
      have hinjι := (AddCommGrpCat.mono_iff_injective _).mp hm
      have hn2 := PresheafOfModules.naturality_apply (Limits.kernel.ι (wcEtSuppUnitMap DY)).val g.op s
      apply hinjι
      refine hn2.trans ?_
      refine hk0'.trans ?_
      exact (map_zero _).symm
    · right
      intro x hx
      obtain ⟨z, hz⟩ := hx
      have hE' : IsEmpty ↥(Limits.pullback V'.hom iY) := hE
      obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V'.hom) (g := iY) x z hz.symm
      exact hE'.false w
  have hsupp := Q2 (Limits.pullback.fst b iZ) m DE
  let Ω : Set ((wcEtBaseChange b).obj V).left := {p | ∃ (T : X'.Etale)
    (h : T ⟶ (wcEtBaseChange b).obj V) (t' : T.left), h.left t' = p ∧
      (G.obj.map h.op).hom s = 0}
  have hΩ : IsOpen Ω := s8 X' G _ s
  have hcompl : ∀ p, p ∉ Ω → b (((wcEtBaseChange b).obj V).hom p) ∈ (Set.range iZ)ᶜ := by
    intro p hp hb
    apply hp
    refine L4 X' _ G hsupp _ s p ?_
    rw [Set.notMem_compl_iff, Scheme.Pullback.range_fst]
    exact hb
  have hvS : V.hom v ∉ (Set.range iZ)ᶜ := Set.notMem_compl_iff.mpr hv
  obtain ⟨W, g, w, hw, hWΩ⟩ := s6 (Set.range iZ)ᶜ V Ω hΩ hcompl v hvS
  have hz : (G.obj.map ((wcEtBaseChange b).map g).op).hom s = 0 := by
    apply s2 X' G
    intro p
    exact s3 X' G ((wcEtBaseChange b).map g) s p (hWΩ p)
  exact ⟨W, g, w, hw, hz⟩

theorem wc_et_blowup_kernel_push_epi : ∀ {Y X' Z : Scheme.{u}} (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ (m : ℕ) (D : wcEtPullData b m) (DZ : wcEtPullData iZ m) (DE : wcEtPullData (Limits.pullback.fst b iZ) m) (κ : Limits.kernel (wcEtSuppUnitMap DZ) ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj (Limits.kernel (wcEtSuppUnitMap DE))), κ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map (Limits.kernel.ι (wcEtSuppUnitMap DE)) = Limits.kernel.ι (wcEtSuppUnitMap DZ) ≫ wcEtSuppUnitMap D → Epi κ :=
by
  intro Y X' Z b _ iZ _ hiso m D DZ DE κ hκ


  have hπ : ∀ {W : Scheme.{u}} (h : W ⟶ Y), Set.range h ⊆ (Set.range iZ)ᶜ →
      IsIso (Limits.pullback.fst h b) := by
    intro W h hr
    have hO : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
    let O : Y.Opens := ⟨(Set.range iZ)ᶜ, hO⟩
    haveI : IsIso (b ∣_ O) := hiso O rfl
    have hr' : Set.range h ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      exact hr
    obtain ⟨h', hfac⟩ : ∃ h' : W ⟶ (O : Scheme.{u}), h' ≫ O.ι = h :=
      ⟨_, IsOpenImmersion.lift_fac O.ι h hr'⟩
    have A := (IsPullback.of_hasPullback h' (b ∣_ O)).flip
    have B := (isPullback_morphismRestrict b O).flip
    have Q₀ := (A.paste_horiz B).flip
    rw [hfac] at Q₀
    haveI : IsIso (Limits.pullback.fst h' (b ∣_ O)) :=
      IsPullback.isIso_fst_of_isIso (IsPullback.of_hasPullback h' (b ∣_ O))
    rw [← Q₀.isoPullback_inv_fst]
    infer_instance

  have hcov : ∀ (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
    intro V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hEpi : Epi ((SheafOfModules.toSheaf (wcEtZModRing Y m)).map κ) := by
    haveI : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf (wcEtZModRing Y m)).map κ) := by
      apply Presheaf.IsLocallySurjective.mk
      intro V t
      apply hcov
      intro v
      by_cases hv : V.hom v ∈ Set.range iZ
      · obtain ⟨W, g, w, hw, h0⟩ := wc_et_blowup_push_ker_centre_vanish b iZ m D DE V t v hv
        refine ⟨W, g, ?_, w, hw⟩
        rw [Presheaf.imageSieve_apply]
        exact ⟨0, (map_zero _).trans h0.symm⟩
      · obtain ⟨V₁, c, v₁, t₁, hc, heq⟩ :=
          wc_et_blowup_kernel_push_offcentre_lift b iZ hπ m D DZ DE κ hκ V t v hv
        refine ⟨V₁, c, ?_, v₁, hc⟩
        rw [Presheaf.imageSieve_apply]
        exact ⟨t₁, heq⟩
    exact Sheaf.epi_of_isLocallySurjective _
  exact Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing Y m)) hEpi

theorem wc_et_module_push_acyclic_of_ab_obj : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (n : ℕ), n ≠ 0 → ∀ (D : wcEtPullData r n) (N : SheafOfModules.{u+1} (wcEtZModRing Q n)), (∀ (J : InjectiveResolution ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj N)) (k : ℕ), 1 ≤ k → Limits.IsZero ((((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology k)) → letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; ∃ I : InjectiveResolution N, ∀ k : ℕ, 1 ≤ k → Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology k) :=
by
  classical
  intro T Q r n hn0 D N hJ
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Q
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives T
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q n)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T n)
  haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q n)) :=
    ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q n)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
    (wcEtZModRing T n)
  have hn : 0 < n := Nat.pos_of_ne_zero hn0

  have s1 : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      [Injective E], Epi (n • 𝟙 E) := by
    intro X E _
    have hP : Injective ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) :=
      Injective.injective_of_adjoint
        (sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) E
    have hdiv : ∀ (U : X.Etale)
        (s : ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E).obj
          (Opposite.op U)), ∃ t, n • t = s := by
      intro U s
      let P := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E
      let G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let φ : G ⟶ P :=
        { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
          naturality := by
            intro V W h
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro f
            show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                ((G.map h).hom (FreeAbelianGroup.of f)) =
              (P.map h).hom ((FreeAbelianGroup.lift
                (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
            have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
            rw [hG]
            erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
            show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
            rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
            rfl }
      have tf : ∀ (Y : Type (u+1)) (a b : FreeAbelianGroup Y), n • a = n • b → a = b := by
        intro Y a b hab
        apply (FreeAbelianGroup.equivFinsupp Y).injective
        ext x
        have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp Y z x) hab
        simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
        exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
      have hmono : Mono (n • 𝟙 G) := by
        have : ∀ V, Mono ((n • 𝟙 G).app V) := by
          intro V
          rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
          intro a b hab
          simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
            AddMonoidHom.id_apply] at hab
          exact tf _ a b hab
        exact NatTrans.mono_of_mono_app _
      let g := Injective.factorThru φ (n • 𝟙 G)
      have hg : (n • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (n • 𝟙 G)
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
      have h1 := congrArg (fun α : G ⟶ P =>
        (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
      have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
        show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
          (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
        rw [FreeAbelianGroup.lift_apply_of]
        simp
      rw [← h2, ← h1]
      simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
      rfl
    have hmap : (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (n • 𝟙 E) =
        n • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply Functor.epi_of_epi_map (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    rw [hmap]
    have : ∀ V, Epi ((n • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj E)).app V) := by
      intro V
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
      intro s
      obtain ⟨t, ht⟩ := hdiv V.unop s
      exact ⟨t, by simpa using ht⟩
    exact NatTrans.epi_of_epi_app _

  have hker : ∀ (E : Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) [Injective E],
      Epi ((wcEtPush r).map (n • 𝟙 E)) → ∀ q : ℕ,
      Limits.IsZero (((wcEtPush r).rightDerived (q + 1)).obj (Limits.kernel (n • 𝟙 E))) := by
    intro E _ hRe q
    let S := ShortComplex.mk (Limits.kernel.ι (n • 𝟙 E)) (n • 𝟙 E) (Limits.kernel.condition _)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) (s1 Q E)
      exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (n • 𝟙 E))
    obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
    obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
    have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
      (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
    have hδ : δ = 0 := by
      cases q with
      | zero =>
        have hRe' : Epi ((wcEtPush r).map S.g) := hRe
        have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
          rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
          infer_instance
        exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
      | succ m =>
        exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
    exact hex.isZero_X₂ hδ hf

  obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q n
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q n) n α₀ hinj₀ hsurj₀
  haveI := hfull
  have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q n)) [Injective I] (k : ℕ),
      Limits.IsZero (((wcEtPush r).rightDerived (k + 1)).obj
        ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj I)) := by
    intro I _ k
    let Φ := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Q n)
    have hI0 : n • 𝟙 (Φ.obj I) = 0 := by
      apply (sheafToPresheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      ext X m
      have key : ∀ m' : (I.val.obj X : Type _), n • m' = 0 := fun m' => by
        rw [← Nat.cast_smul_eq_nsmul ((wcEtZModRing Q n).obj.obj X) n m', hR X, zero_smul]
      simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
        AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
      exact key m
    let E := Injective.under (Φ.obj I)
    let ι := Injective.ι (Φ.obj I)
    have hιn : ι ≫ (n • 𝟙 E) = 0 := by
      have h1 : n • ι = (n • 𝟙 (Φ.obj I)) ≫ ι := by
        rw [Preadditive.nsmul_comp, Category.id_comp]
      rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
    let j := Limits.kernel.lift (n • 𝟙 E) ι hιn
    have hj : j ≫ Limits.kernel.ι (n • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
    have : Mono j := mono_of_mono_fac hj
    have hK0 : n • 𝟙 (Limits.kernel (n • 𝟙 E)) = 0 := by
      apply (cancel_mono (Limits.kernel.ι (n • 𝟙 E))).1
      have h1 : Limits.kernel.ι (n • 𝟙 E) ≫ (n • 𝟙 E) = n • Limits.kernel.ι (n • 𝟙 E) := by
        rw [Preadditive.comp_nsmul, Category.comp_id]
      rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
    obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
    let g := Φ.preimage (j ≫ β.inv)
    have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
    have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
    let rr := Injective.factorThru (𝟙 I) g
    have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
    let ρ := β.inv ≫ Φ.map rr
    have hjρ : j ≫ ρ = 𝟙 _ := by
      calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
        _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
        _ = 𝟙 _ := by rw [hr, Φ.map_id]

    have hEinj : Injective ((wcEtPush r).obj E) := by
      obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
      haveI := hL
      exact adj.map_injective E inferInstance
    haveI := hEinj
    have hepi : Epi ((wcEtPush r).map (n • 𝟙 E)) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      exact s1 T _
    have hK := hker E hepi k
    rw [Limits.IsZero.iff_id_eq_zero]
    calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
          (CategoryTheory.Functor.map_id _ _).symm
      _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
            ((wcEtPush r).rightDerived (k + 1)).map ρ := by
          rw [← hjρ, CategoryTheory.Functor.map_comp]
      _ = 0 := by
          rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]

  obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r n D
  have hiso := wc_rightDerived_exact_conj_iso
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) (wcEtPush r)
    (SheafOfModules.toSheaf (wcEtZModRing Q n)) (SheafOfModules.toSheaf (wcEtZModRing T n))
    ⟨βc⟩ hacyc
  refine ⟨InjectiveResolution.of N, fun k hk1 => ?_⟩
  obtain ⟨Θ⟩ := hiso N k
  have h1 : Limits.IsZero (((wcEtPush r).rightDerived k).obj
      ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj N)) :=
    (hJ (InjectiveResolution.of ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj N)) k hk1).of_iso
      ((InjectiveResolution.of ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj N)).isoRightDerivedObj
        (wcEtPush r) k)
  have h3 := h1.of_iso Θ.symm
  have reflZero : ∀ {Y : SheafOfModules.{u+1} (wcEtZModRing T n)},
      Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing T n)).obj Y) → Limits.IsZero Y := by
    intro Y hY
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (SheafOfModules.toSheaf (wcEtZModRing T n)).map_injective
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
    exact hY.eq_of_src _ _
  have h4 := reflZero h3
  exact h4.of_iso ((InjectiveResolution.of N).isoRightDerivedObj
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) k).symm

theorem wc_et_push_extZero_acyclic : ∀ (Y X' : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (S : Set Y), IsOpen S → (∀ U : Y.Opens, (U : Set Y) = S → IsIso (b ∣_ U)) → ∀ m : ℕ, m ≠ 0 → ∀ (F : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}), Nonempty (F ≅ wcEtExtZero X' (b ⁻¹' S) m) → ∀ (J : InjectiveResolution F) (k : ℕ), 1 ≤ k → Limits.IsZero ((((wcEtPush b).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology k) :=
by
  intro Y X' b _ S hS hiso m hm F hF J k hk
  haveI := wc_et_enough_injectives X'
  obtain ⟨e⟩ := hF
  let G := wcEtExtZero X' (b ⁻¹' S) m
  let I : InjectiveResolution G := InjectiveResolution.of G
  have hacyc : ∀ n : ℕ, 1 ≤ n → Limits.IsZero
      ((((wcEtPush b).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) := by
    intro n hn
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    apply wc_et_push_homology_zero_of_locKill b I.cocomplex n'
    intro V c hc v _
    by_cases hv : V.hom v ∈ S
    · exact wc_et_locKill_iso_locus Y X' b S hS hiso I.cocomplex n'
        (wc_et_sheaf_exact_local I.cocomplex n'
          ((HomologicalComplex.exactAt_iff_isZero_homology I.cocomplex (n' + 1)).mp
            (I.cocomplex_exactAt_succ n'))) V c hc v hv
    · exact wc_et_locKill_proper_complement Y X' b S hS m hm wc_et_henselian_proper_vanishing
        I n' V c hc v hv
  have h1 : Limits.IsZero (((wcEtPush b).rightDerived k).obj G) :=
    (hacyc k hk).of_iso (I.isoRightDerivedObj (wcEtPush b) k)
  have h2 : Limits.IsZero (((wcEtPush b).rightDerived k).obj F) :=
    h1.of_iso (((wcEtPush b).rightDerived k).mapIso e)
  exact h2.of_iso (J.isoRightDerivedObj (wcEtPush b) k).symm

theorem wc_et_abstract_blowup_pull_surj : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b]
    (iZ : Z ⟶ Y) [IsClosedImmersion iZ],
    (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) →
    ∀ m : ℕ, m ≠ 0 → ∀ q : ℕ, Subsingleton (wcEtCoh (Limits.pullback b iZ) m q) →
    ∀ D : wcEtPullData b m, Function.Surjective (wcEtPull D q) :=
by
  classical
  intro Y X' Z b _ iZ _ hiso m hm q hE D
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X' m)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI hi' : IsClosedImmersion (Limits.pullback.fst b iZ) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback b iZ).flip inferInstance
  obtain ⟨DZ⟩ := wc_et_zmod_pull_data_exists iZ m
  obtain ⟨DE⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst b iZ) m
  intro x'

  have hsub : Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing X' m))
      (wcEtSuppObj DE) q) := by
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (Limits.pullback b iZ) m q
    haveI : Subsingleton (wcEtZModExt (Limits.pullback b iZ) m q) := e.injective.subsingleton
    obtain ⟨T, M, hT, -⟩ := wc_et_supp_unit_ext_transfer (Limits.pullback.fst b iZ) m DE
    exact (hT q).2.subsingleton

  haveI hρ'epi : Epi (wcEtSuppUnitMap DE) := wc_et_supp_unit_epi (Limits.pullback.fst b iZ) DE
  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap DE)) (wcEtSuppUnitMap DE)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hρ'epi
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂
    (SheafOfModules.unit (wcEtZModRing X' m)) hS' x' (@Subsingleton.elim _ hsub _ _)
  have hx₁' : x₁.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap DE))) (add_zero q) = x' :=
    hx₁

  obtain ⟨eK'⟩ := wc_et_supp_unit_ker_extZero_iso (Limits.pullback.fst b iZ) m DE
  have hrange : (Set.range (Limits.pullback.fst b iZ))ᶜ = b ⁻¹' (Set.range iZ)ᶜ := by
    rw [Scheme.Pullback.range_fst, Set.preimage_compl]
  rw [hrange] at eK'
  have hS : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
  have hJ := wc_et_push_extZero_acyclic Y X' b (Set.range iZ)ᶜ hS hiso m hm _ ⟨eK'⟩
  obtain ⟨I, hI⟩ := wc_et_module_push_acyclic_of_ab_obj b m hm D
    (Limits.kernel (wcEtSuppUnitMap DE)) hJ

  have hbij := wc_ext_counit_transfer_bijective_of_acyclic D.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ) D.adj
    (SheafOfModules.unit (wcEtZModRing Y m)) (Limits.kernel (wcEtSuppUnitMap DE)) I hI q
  obtain ⟨α, hα⟩ := hbij.2 ((Abelian.Ext.mk₀ D.μ.hom).comp
    (x₁ : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X' m))
      (Limits.kernel (wcEtSuppUnitMap DE)) q) (zero_add q))
  have hα' : (Abelian.Ext.mapExactFunctor D.Φ α).comp
      (Abelian.Ext.mk₀ (D.adj.counit.app (Limits.kernel (wcEtSuppUnitMap DE)))) (add_zero q) =
      (Abelian.Ext.mk₀ D.μ.hom).comp
        (x₁ : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X' m))
          (Limits.kernel (wcEtSuppUnitMap DE)) q) (zero_add q) := hα

  obtain ⟨κ, hκ⟩ := wc_et_blowup_kernel_push_lift b iZ m D DZ DE
  haveI : Mono (κ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
      (Limits.kernel.ι (wcEtSuppUnitMap DE))) := by
    rw [hκ]
    exact wc_et_blowup_kernel_unit_mono b iZ hiso m D DZ
  haveI : Mono κ := mono_of_mono κ
    ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
      (Limits.kernel.ι (wcEtSuppUnitMap DE)))
  haveI : Epi κ := wc_et_blowup_kernel_push_epi b iZ hiso m D DZ DE κ hκ
  haveI : IsIso κ := isIso_of_mono_of_epi κ
  let θ : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj
      (Limits.kernel (wcEtSuppUnitMap DE)) ⟶ SheafOfModules.unit (wcEtZModRing Y m) :=
    inv κ ≫ Limits.kernel.ι (wcEtSuppUnitMap DZ)
  have hθ : θ ≫ wcEtSuppUnitMap D =
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
        (Limits.kernel.ι (wcEtSuppUnitMap DE)) := by
    show (inv κ ≫ Limits.kernel.ι (wcEtSuppUnitMap DZ)) ≫ wcEtSuppUnitMap D = _
    rw [Category.assoc, ← hκ]
    exact IsIso.inv_hom_id_assoc κ _
  have hθ' : θ ≫ D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m)) ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map D.μ.hom =
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
        (Limits.kernel.ι (wcEtSuppUnitMap DE)) := hθ

  have hkey : D.Φ.map θ ≫ D.μ.hom =
      D.adj.counit.app (Limits.kernel (wcEtSuppUnitMap DE)) ≫
        Limits.kernel.ι (wcEtSuppUnitMap DE) := by
    calc D.Φ.map θ ≫ D.μ.hom
        = D.Φ.map θ ≫ (D.Φ.map (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m))) ≫
            D.adj.counit.app (D.Φ.obj (SheafOfModules.unit (wcEtZModRing Y m)))) ≫ D.μ.hom := by
          rw [D.adj.left_triangle_components, Category.id_comp]
      _ = D.Φ.map θ ≫ D.Φ.map (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m))) ≫
            D.Φ.map ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont
              D.φ).map D.μ.hom) ≫
            D.adj.counit.app (SheafOfModules.unit (wcEtZModRing X' m)) := by
          simp only [Category.assoc]
          exact congrArg (fun t => D.Φ.map θ ≫
            D.Φ.map (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m))) ≫ t)
            (D.adj.counit_naturality D.μ.hom).symm
      _ = D.Φ.map (θ ≫ D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m)) ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
              D.μ.hom) ≫
            D.adj.counit.app (SheafOfModules.unit (wcEtZModRing X' m)) := by
          simp only [Functor.map_comp, Category.assoc]
      _ = D.Φ.map ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
            (Limits.kernel.ι (wcEtSuppUnitMap DE))) ≫
            D.adj.counit.app (SheafOfModules.unit (wcEtZModRing X' m)) := by
          rw [hθ']
      _ = D.adj.counit.app (Limits.kernel (wcEtSuppUnitMap DE)) ≫
            Limits.kernel.ι (wcEtSuppUnitMap DE) := D.adj.counit_naturality _

  refine ⟨α.comp (Abelian.Ext.mk₀ θ) (add_zero q), ?_⟩
  have hpull : ∀ y : wcEtZModExt Y m q, wcEtPull D q y =
      (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q) := fun y => rfl
  rw [hpull, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hkey,
    ← Abelian.Ext.mk₀_comp_mk₀,
    ← Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ α), hα',
    Abelian.Ext.comp_assoc_of_third_deg_zero, hx₁', Abelian.Ext.mk₀_comp_mk₀_assoc,
    Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]

theorem wc_pmn_tsl_odp_local_zmod_card_le (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (h4 : 4 ≤ n)
    (O : (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens)
    (hO : (O : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))) = {xs}ᶜ) :
    Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap
      (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Limits.pullback (C := Scheme.{u})
          (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))))))
      (wcZModSheaf (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A)) ℓ) (2 * (n - 1))) ∧
    Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap
      (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Limits.pullback (C := Scheme.{u})
          (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))))))
      (wcZModSheaf (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A)) ℓ) (2 * (n - 1))) ≤ ℓ :=
by
  classical
  have core : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (p : X ⟶ Spec (.of K))
      [IsProper p] [IsLocallyNoetherian X] (z : X), IsClosed ({z} : Set X) →
      ∀ (O : X.Opens), (O : Set X) = {z}ᶜ → ∀ (N : ℕ), 1 ≤ N → ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (Xt E : Scheme.{u}) (b : Xt ⟶ X) (iE : E ⟶ Xt), IsProper b → IsClosedImmersion iE →
      (∀ U : X.Opens, (U : Set X) = {z}ᶜ → IsIso (b ∣_ U)) → Set.range iE = b ⁻¹' {z} →
      SmoothOfRelativeDimension N (b ≫ p) → SmoothOfRelativeDimension (N - 1) (iE ≫ b ≫ p) →
      IrreducibleSpace Xt → IrreducibleSpace E →
      Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X)))) (wcZModSheaf X ℓ) (2 * N)) ∧
      Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X)))) (wcZModSheaf X ℓ) (2 * N)) ≤ ℓ := by
    intro K _ _ X p _ _ z hz O hO N hN hℓK Xt E b iE hb hiE hiso hrE hsmX hsmE hirrX hirrE
    haveI := hb
    haveI := hiE
    haveI := hsmX
    haveI := hsmE
    haveI := hirrX
    haveI := hirrE
    haveI : IsClosedImmersion (X.fromSpecResidueField z) :=
      isClosed_singleton_iff_isClosedImmersion.mp hz
    have hrZ : Set.range (X.fromSpecResidueField z) = {z} := Scheme.range_fromSpecResidueField z
    have hisoZ : ∀ U : X.Opens, (U : Set X) = (Set.range (X.fromSpecResidueField z))ᶜ →
        IsIso (b ∣_ U) := by
      intro U hU
      rw [hrZ] at hU
      exact hiso U hU
    have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
    obtain ⟨s, hs⟩ : ∃ s, s + 1 = 2 * N := ⟨2 * N - 1, by omega⟩

    have hE's : Subsingleton (wcEtCoh (Limits.pullback b (X.fromSpecResidueField z)) ℓ s) := by
      haveI hfstC : IsClosedImmersion (Limits.pullback.fst b (X.fromSpecResidueField z)) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback b (X.fromSpecResidueField z)).flip inferInstance
      have hrng : Set.range (Limits.pullback.fst b (X.fromSpecResidueField z)) = Set.range iE := by
        rw [Scheme.Pullback.range_fst, hrZ, hrE]
      have hdimE' : topologicalKrullDim
          ↥(Limits.pullback (C := Scheme.{u}) b (X.fromSpecResidueField z)) =
          topologicalKrullDim E :=
        IsHomeomorph.topologicalKrullDim_eq _
          ((((Limits.pullback.fst b (X.fromSpecResidueField z)).isClosedEmbedding.isEmbedding.toHomeomorph).trans
            (Homeomorph.setCongr hrng)).trans
            (iE.isClosedEmbedding.isEmbedding.toHomeomorph.symm)).isHomeomorph
      have hdim : topologicalKrullDim
          ↥(Limits.pullback (C := Scheme.{u}) b (X.fromSpecResidueField z)) ≤
          ((N - 1 : ℕ) : WithBot ℕ∞) := by
        rw [hdimE']
        exact wc_smooth_alg_closed_dim_le K E (iE ≫ b ≫ p) (N - 1)
      have hv := wc_et_cd_proper_torsion K _
        (Limits.pullback.snd b (X.fromSpecResidueField z) ≫ X.fromSpecResidueField z ≫ p)
        (N - 1) hdim ℓ hℓK _ (wc_et_const_zmod_nsmul_zero _ ℓ) s (by omega)
      exact ⟨fun a c => (hv a).trans (hv c).symm⟩

    have hpt : Subsingleton (wcEtCoh (Spec (X.residueField z)) ℓ (2 * N)) := by
      have hdim0 : topologicalKrullDim (Spec (X.residueField z)) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
        rw [show topologicalKrullDim (Spec (X.residueField z)) =
            topologicalKrullDim (PrimeSpectrum (X.residueField z)) from rfl,
          PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, ringKrullDim_eq_zero_of_field]
        simp
      have hv := wc_et_cd_proper_torsion K _ (X.fromSpecResidueField z ≫ p) 0 hdim0 ℓ hℓK _
        (wc_et_const_zmod_nsmul_zero _ ℓ) (2 * N) (by omega)
      exact ⟨fun a c => (hv a).trans (hv c).symm⟩

    obtain ⟨hfX, hcX⟩ := wc_et_top_coh_card_le K Xt (b ≫ p) N ℓ hℓK
    obtain ⟨hfin, hcard⟩ := wc_et_abstract_blowup_card_le X Xt _ b (X.fromSpecResidueField z)
      hisoZ ℓ hℓ0 (2 * N) hfX hpt (fun q' hq' => by
        obtain rfl : q' = s := by omega
        exact hE's)

    have hU : ((b ⁻¹ᵁ O : Xt.Opens) : Set Xt) = (Set.range iE)ᶜ := by
      show b ⁻¹' (O : Set X) = _
      rw [hO, hrE, Set.preimage_compl]
    have hD : ∀ Dd : wcEtPullData iE ℓ,
        Finite (wcEtSuppExt Dd (2 * N)) ∧ Nat.card (wcEtSuppExt Dd (2 * N)) ≤ ℓ := fun Dd =>
      wc_et_smooth_pair_supp_top_card_le K (b ≫ p) N (N - 1) 1 (by omega) iE ℓ hℓK Dd
    haveI hφiso : IsIso (b ∣_ O) := hiso O hO
    have hrestr : ∀ Dj : wcEtPullData O.ι ℓ, Function.Surjective (wcEtPull Dj s) := by
      intro Dj y
      obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists (b ⁻¹ᵁ O).ι ℓ
      obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists b ℓ
      obtain ⟨Dφ⟩ := wc_et_zmod_pull_data_exists (b ∣_ O) ℓ
      obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists ((b ⁻¹ᵁ O).ι ≫ b) ℓ
      obtain ⟨Dψ⟩ := wc_et_zmod_pull_data_exists (inv (b ∣_ O)) ℓ
      obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (O : Scheme.{u})) ℓ
      have hφinj : ∀ a, wcEtPull Dφ s a = 0 → a = 0 := by
        intro a ha
