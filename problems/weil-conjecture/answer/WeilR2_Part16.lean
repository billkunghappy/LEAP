    letI addP : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dc.cont Dc.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dc.adj Dc.additive
    haveI := Dc.cont
    have s5 : ∀ (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ)))
        (q : ℕ), 1 ≤ q →
        Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dc.cont
          Dc.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) := by
      intro I q hq
      obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
      refine (fun key => ?_) (pushforward_homology_local_basis (wcProEtBC xb)
        (wcRingSheaf Xc ℓ) (wcRingSheaf (Spec (.of Ω)) ℓ) Dc.φ I.cocomplex (j + 1) 0
