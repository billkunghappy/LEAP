by
  generalize Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) = cS at *

  have zbij : ∀ {S₁ S₂ : Scheme.{u}} (f : S₂ ⟶ S₁) [IsIso f] (n : ℕ) (D : wcZModPullData f n),
