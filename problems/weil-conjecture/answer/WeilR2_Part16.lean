    (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal (P := @Flat) (Q := @Etale)).2
      (fun X Y f hf => MorphismProperty.diagonal_iff.2 (by have : Etale f := hf; infer_instance))
  have hσfl : ∀ m γ, Flat (σ m γ) := fun m γ =>
    MorphismProperty.of_postcomp (W := @Flat) (W' := @Etale) (σ m γ) (π ≫ O.ι)
      (inferInstance : Etale (π ≫ O.ι)) (show Flat (σ m γ ≫ π ≫ O.ι) by rw [hσ m γ]; exact hfl m)
  have hσqc : ∀ m γ, QuasiCompact (σ m γ) := by
    intro m γ
    haveI : QuasiCompact (σ m γ ≫ π ≫ O.ι) := by rw [hσ m γ]; exact hqc m
    exact QuasiCompact.of_comp (σ m γ) (π ≫ O.ι)
  have MIf : ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m')
      (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), a ≫ σ m γ = b ≫ σ m' γ' →
      ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z) :=
    fun m m' γ γ' Z a b hab => (hmeet m m' γ γ' Z a b hab).mp
  have MIb : ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m')
      (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')),
      (∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) →
      a ≫ σ m γ = b ≫ σ m' γ' :=
    fun m m' γ γ' Z a b hab => (hmeet m m' γ γ' Z a b hab).mpr
  have hR1 : Set.range (π ≫ O.ι) ⊆ (O : Set U) := by
    rintro _ ⟨e, rfl⟩
    have h1 : O.ι (π e) ∈ Set.range O.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at h1
    rw [Scheme.Hom.comp_apply]
    exact h1
  obtain ⟨Λ, hΛloc, hEval⟩ := LAM hL U Γ ι V v g hgloc hG n W k w E (π ≫ O.ι) σ
    hσfl hσqc hσ hσcov MIf
  have hnat : ∀ {A A' B C D : Scheme.{u}} {f1 : B ⟶ D} {f2 : C ⟶ D} (c : A' ⟶ A) (x : A ⟶ B)
      (y : A ⟶ C) (h1 : x ≫ f1 = y ≫ f2) (h2 : (c ≫ x) ≫ f1 = (c ≫ y) ≫ f2) (z' : A'),
      Limits.pullback.lift (c ≫ x) (c ≫ y) h2 z' = Limits.pullback.lift x y h1 (c z') := by
    intro A A' B C D f1 f2 c x y h1 h2 z'
    have e : Limits.pullback.lift (c ≫ x) (c ≫ y) h2 = c ≫ Limits.pullback.lift x y h1 := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd]
    rw [e, Scheme.Hom.comp_apply]
  have hcongr : ∀ {A B C D : Scheme.{u}} {f1 : B ⟶ D} {f2 : C ⟶ D} (x x' : A ⟶ B)
      (y y' : A ⟶ C) (hx : x = x') (hy : y = y') (h1 : x ≫ f1 = y ≫ f2)
      (h2 : x' ≫ f1 = y' ≫ f2), Limits.pullback.lift x y h1 = Limits.pullback.lift x' y' h2 := by
    intro A B C D f1 f2 x x' y y' hx hy h1 h2
    subst hx
    subst hy
    rfl

  have hfam : wcGFam v g (π ≫ O.ι) Λ := by
    refine ⟨hΛloc, ?_⟩
    intro l l' Z a b b' h h' h'' z
    obtain ⟨m, γ, x₀, hx₀⟩ := hσcov (a z)
    obtain ⟨ζ, hζ1, -⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := a) (g := σ m γ) z x₀ hx₀.symm
    have hζ1' : Limits.pullback.fst a (σ m γ) ζ = z := hζ1
    have hcond : Limits.pullback.fst a (σ m γ) ≫ a =
        Limits.pullback.snd a (σ m γ) ≫ σ m γ := Limits.pullback.condition
    have key : ∀ (l₀ : ι) (b₀ : Z ⟶ V l₀) (h₀ : a ≫ π ≫ O.ι = b₀ ≫ v l₀)
        (hab₀ : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
          (Limits.pullback.fst a (σ m γ) ≫ b₀) ≫ v l₀),
        Λ l₀ (Limits.pullback.lift a b₀ h₀ z) =
          γ * g (k m) l₀ (Limits.pullback.lift (Limits.pullback.snd a (σ m γ) ≫ w m)
            (Limits.pullback.fst a (σ m γ) ≫ b₀) hab₀ ζ) := by
      intro l₀ b₀ h₀ hab₀
      have hA : Limits.pullback.snd a (σ m γ) ≫ σ m γ =
          (Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) ≫
            Limits.pullback.fst (π ≫ O.ι) (v l₀) := by
        rw [Category.assoc, Limits.pullback.lift_fst, hcond]
      have hs : (Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) ≫
          Limits.pullback.snd (π ≫ O.ι) (v l₀) = Limits.pullback.fst a (σ m γ) ≫ b₀ := by
        rw [Category.assoc, Limits.pullback.lift_snd]
      have hq : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
          ((Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) ≫
            Limits.pullback.snd (π ≫ O.ι) (v l₀)) ≫ v l₀ := by
        rw [hs]; exact hab₀
      have E1 := hEval l₀ m γ _ (Limits.pullback.snd a (σ m γ))
        (Limits.pullback.fst a (σ m γ) ≫ Limits.pullback.lift a b₀ h₀) hA hq ζ
      rw [Scheme.Hom.comp_apply, hζ1'] at E1
      rw [E1, hcongr (Limits.pullback.snd a (σ m γ) ≫ w m)
        (Limits.pullback.snd a (σ m γ) ≫ w m) _ _ rfl hs hq hab₀]
    have hab₁ : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
        (Limits.pullback.fst a (σ m γ) ≫ b) ≫ v l := by
      simp only [Category.assoc]
      rw [← hσ m γ, ← Limits.pullback.condition_assoc, h]
    have hab₂ : (Limits.pullback.snd a (σ m γ) ≫ w m) ≫ v (k m) =
        (Limits.pullback.fst a (σ m γ) ≫ b') ≫ v l' := by
      simp only [Category.assoc]
      rw [← hσ m γ, ← Limits.pullback.condition_assoc, h']
    have hbb : (Limits.pullback.fst a (σ m γ) ≫ b) ≫ v l =
        (Limits.pullback.fst a (σ m γ) ≫ b') ≫ v l' := by
      rw [Category.assoc, Category.assoc, h'']
    rw [key l b h hab₁, key l' b' h' hab₂,
      hG (k m) l l' _ (Limits.pullback.snd a (σ m γ) ≫ w m)
        (Limits.pullback.fst a (σ m γ) ≫ b) (Limits.pullback.fst a (σ m γ) ≫ b') hab₁ hbb hab₂ ζ,
      hnat (Limits.pullback.fst a (σ m γ)) b b' h'' hbb ζ, hζ1', mul_assoc]
  refine ⟨Λ, hR1, hfam, ?_⟩

  intro T t ht lam hlam
  have hcovT : ∀ τ : T, ∃ m y, (w m ≫ v (k m)) y = t τ := fun τ => hWcov (t τ) (ht ⟨τ, rfl⟩)
  obtain ⟨φ, h, hrep⟩ := EXIST hD U Γ ι V v g n W k w E (π ≫ O.ι) σ hfl hqc hσ
    MIb Λ hEval T t hcovT lam hlam
  refine ⟨φ, ⟨h, hrep⟩, ?_⟩
  rintro φ' ⟨h', hrep'⟩
  exact UNIQ hD U Γ ι V v g hG n W k w E (π ≫ O.ι) σ hσfl hσqc hσ hσcov MIb Λ
    hEval T t lam φ' φ h' h hrep' hrep

theorem wc_fgtor_sheets_iff_of_rep : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ x : U, ∃ j, x ∈ Set.range (v j)) → ∀ (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → ∀ (E : Scheme.{u}) (πE : E ⟶ U) (Λ : ∀ l, ↥(Limits.pullback πE (v l)) → Γ), wcGRep v g ⊤ πE Λ → Surjective πE ∧ ∃ s : ∀ j, Γ → (V j ⟶ E), (∀ j γ, s j γ ≫ πE = v j) ∧ (∀ (i j : ι) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ V i) (b : Z ⟶ V j) (hab : a ≫ v i = b ≫ v j), a ≫ s i γ = b ≫ s j γ' ↔ ∀ z : Z, γ' = γ * g i j (Limits.pullback.lift a b hab z)) ∧ (∀ (j : ι) (Z : Scheme.{u}), ConnectedSpace Z → ∀ (a : Z ⟶ V j) (e : Z ⟶ E), a ≫ v j = e ≫ πE → ∃ γ, e = a ≫ s j γ) :=
by
  intro U Γ _ ι V v hcov g hgloc hG E πE Λ hrep
  classical

  have hdiag : ∀ (j : ι) (Z : Scheme.{u}) (b : Z ⟶ V j) (h : b ≫ v j = b ≫ v j) (z : Z),
      g j j (Limits.pullback.lift b b h z) = 1 := by
    intro j Z b h z
    have h0 := hG j j j Z b b b h h h z
    have h2 : g j j (Limits.pullback.lift b b h z) * g j j (Limits.pullback.lift b b h z) =
        g j j (Limits.pullback.lift b b h z) * 1 := by
      rw [mul_one]; exact h0.symm
    exact mul_left_cancel h2

  have hex : ∀ (j : ι) (γ : Γ), ∃ s : V j ⟶ E, ∃ h : s ≫ πE = v j,
      ∀ (l : ι) (w : ↥(Limits.pullback (v j) (v l))),
        γ * g j l w = Λ l (Limits.pullback.map (v j) (v l) πE (v l) s (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, h]) (by simp) w) := by
    intro j γ
    have hfam : wcGFam v g (v j) (fun l w => γ * g j l w) := by
      refine ⟨fun l => (hgloc j l).comp (fun x => γ * x), ?_⟩
      intro l l' Z a b b' h h' h'' z
      show γ * g j l' (Limits.pullback.lift a b' h' z) =
        γ * g j l (Limits.pullback.lift a b h z) * g l l' (Limits.pullback.lift b b' h'' z)
      rw [hG j l l' Z a b b' h h'' h' z, mul_assoc]
    exact (hrep.2.2 (V j) (v j) (by simp) _ hfam).exists
  choose s hs hsrep using hex

  have hpf : ∀ (i : ι) (γ : Γ) (T : Scheme.{u}) (t : T ⟶ U) (a : T ⟶ V i) (ha : a ≫ v i = t),
      wcGFam v g t (fun l w => γ * g i l (Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) w)) := by
    intro i γ T t a ha
    refine ⟨fun l => ((hgloc i l).comp_continuous
      (Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp)).continuous).comp (fun x => γ * x), ?_⟩
    intro l l' Z a' b b' h h' h'' z
    have hc : (a' ≫ a) ≫ v i = b ≫ v l := by rw [Category.assoc, ha]; exact h
    have hc' : (a' ≫ a) ≫ v i = b' ≫ v l' := by rw [Category.assoc, ha]; exact h'
    have e1 : Limits.pullback.lift a' b h ≫ Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) = Limits.pullback.lift (a' ≫ a) b hc := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
          Limits.pullback.lift_snd_assoc, Category.comp_id]
    have e2 : Limits.pullback.lift a' b' h' ≫ Limits.pullback.map t (v l') (v i) (v l') a (𝟙 _)
        (𝟙 _) (by rw [Category.comp_id, ha]) (by simp) = Limits.pullback.lift (a' ≫ a) b' hc' := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
          Limits.pullback.lift_snd_assoc, Category.comp_id]
    have e1' : Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) (Limits.pullback.lift a' b h z) =
        Limits.pullback.lift (a' ≫ a) b hc z := by
      rw [← e1, Scheme.Hom.comp_apply]
    have e2' : Limits.pullback.map t (v l') (v i) (v l') a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) (Limits.pullback.lift a' b' h' z) =
        Limits.pullback.lift (a' ≫ a) b' hc' z := by
      rw [← e2, Scheme.Hom.comp_apply]
    show γ * g i l' (Limits.pullback.map t (v l') (v i) (v l') a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) (Limits.pullback.lift a' b' h' z)) =
      γ * g i l (Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) (Limits.pullback.lift a' b h z)) *
        g l l' (Limits.pullback.lift b b' h'' z)
    rw [e1', e2', hG i l l' Z (a' ≫ a) b b' hc h'' hc' z, mul_assoc]

  have htr : ∀ (i : ι) (γ : Γ) (T : Scheme.{u}) (t : T ⟶ U) (a : T ⟶ V i) (ha : a ≫ v i = t)
      (hφ : (a ≫ s i γ) ≫ πE = t) (l : ι) (w : ↥(Limits.pullback t (v l))),
      γ * g i l (Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) w) =
      Λ l (Limits.pullback.map t (v l) πE (v l) (a ≫ s i γ) (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hφ]) (by simp) w) := by
    intro i γ T t a ha hφ l w
    have e : Limits.pullback.map t (v l) πE (v l) (a ≫ s i γ) (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hφ]) (by simp) =
        Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, ha]) (by simp) ≫
        Limits.pullback.map (v i) (v l) πE (v l) (s i γ) (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, hs i γ]) (by simp) := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Limits.pullback.lift_fst_assoc,
          Limits.pullback.lift_snd_assoc, Category.comp_id]
    rw [e, Scheme.Hom.comp_apply]
    exact hsrep i γ l _

  have hsw : ∀ (i j : ι) (γ γ' : Γ) (T : Scheme.{u}) (t : T ⟶ U) (a : T ⟶ V i) (b : T ⟶ V j)
      (ha : a ≫ v i = t) (hb : b ≫ v j = t) (hab : a ≫ v i = b ≫ v j),
      (∀ z : T, γ' = γ * g i j (Limits.pullback.lift a b hab z)) →
      ∀ (l : ι) (w : ↥(Limits.pullback t (v l))),
      γ * g i l (Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) w) =
      γ' * g j l (Limits.pullback.map t (v l) (v j) (v l) b (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hb]) (by simp) w) := by
    intro i j γ γ' T t a b ha hb hab hrule l w
    have hQ : Limits.pullback.fst t (v l) ≫ t = Limits.pullback.snd t (v l) ≫ v l :=
      Limits.pullback.condition
    have h1 : (Limits.pullback.fst t (v l) ≫ a) ≫ v i = (Limits.pullback.fst t (v l) ≫ b) ≫ v j := by
      simp only [Category.assoc]; rw [hab]
    have h2 : (Limits.pullback.fst t (v l) ≫ b) ≫ v j = Limits.pullback.snd t (v l) ≫ v l := by
      rw [Category.assoc, hb]; exact hQ
    have h3 : (Limits.pullback.fst t (v l) ≫ a) ≫ v i = Limits.pullback.snd t (v l) ≫ v l := by
      rw [Category.assoc, ha]; exact hQ
    have hc := hG i j l _ (Limits.pullback.fst t (v l) ≫ a) (Limits.pullback.fst t (v l) ≫ b)
      (Limits.pullback.snd t (v l)) h1 h2 h3 w
    have i1 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ a) (Limits.pullback.snd t (v l)) h3 =
        Limits.pullback.map t (v l) (v i) (v l) a (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, ha]) (by simp) := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Category.comp_id]
    have i2 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ b) (Limits.pullback.snd t (v l)) h2 =
        Limits.pullback.map t (v l) (v j) (v l) b (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, hb]) (by simp) := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Category.comp_id]
    have i3 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ a)
        (Limits.pullback.fst t (v l) ≫ b) h1 =
        Limits.pullback.fst t (v l) ≫ Limits.pullback.lift a b hab := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd]
    rw [i1, i2, i3, Scheme.Hom.comp_apply] at hc
    rw [hc, ← mul_assoc, ← hrule]

  have hcr : ∀ (j : ι) (γ₀ : Γ) (T : Scheme.{u}) (t : T ⟶ U) (a : T ⟶ V j) (e : T ⟶ E)
      (ha : a ≫ v j = t) (he : e ≫ πE = t) (hea : e ≫ πE = a ≫ v j),
      (∀ z : T, Λ j (Limits.pullback.lift e a hea z) = γ₀) →
      ∀ (l : ι) (w : ↥(Limits.pullback t (v l))),
      γ₀ * g j l (Limits.pullback.map t (v l) (v j) (v l) a (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, ha]) (by simp) w) =
      Λ l (Limits.pullback.map t (v l) πE (v l) e (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, he]) (by simp) w) := by
    intro j γ₀ T t a e ha he hea hconst l w
    have hQ : Limits.pullback.fst t (v l) ≫ t = Limits.pullback.snd t (v l) ≫ v l :=
      Limits.pullback.condition
    have h : (Limits.pullback.fst t (v l) ≫ e) ≫ πE = (Limits.pullback.fst t (v l) ≫ a) ≫ v j := by
      simp only [Category.assoc]; rw [hea]
    have h' : (Limits.pullback.fst t (v l) ≫ e) ≫ πE = Limits.pullback.snd t (v l) ≫ v l := by
      rw [Category.assoc, he]; exact hQ
    have h'' : (Limits.pullback.fst t (v l) ≫ a) ≫ v j = Limits.pullback.snd t (v l) ≫ v l := by
      rw [Category.assoc, ha]; exact hQ
    have hc := hrep.2.1.2 j l _ (Limits.pullback.fst t (v l) ≫ e)
      (Limits.pullback.fst t (v l) ≫ a) (Limits.pullback.snd t (v l)) h h' h'' w
    have i1 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ e) (Limits.pullback.snd t (v l)) h' =
        Limits.pullback.map t (v l) πE (v l) e (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, he]) (by simp) := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Category.comp_id]
    have i2 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ a) (Limits.pullback.snd t (v l)) h'' =
        Limits.pullback.map t (v l) (v j) (v l) a (𝟙 _) (𝟙 _)
          (by rw [Category.comp_id, ha]) (by simp) := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Category.comp_id]
    have i3 : Limits.pullback.lift (Limits.pullback.fst t (v l) ≫ e)
        (Limits.pullback.fst t (v l) ≫ a) h =
        Limits.pullback.fst t (v l) ≫ Limits.pullback.lift e a hea := by
      apply Limits.pullback.hom_ext <;>
        simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd]
    rw [i1, i2, i3, Scheme.Hom.comp_apply, hconst] at hc
    exact hc.symm
  refine ⟨⟨fun u => ?_⟩, s, hs, ?_, ?_⟩
  ·
    obtain ⟨j, x, hx⟩ := hcov u
    refine ⟨s j 1 x, ?_⟩
    have e := congrArg (fun k => k x) (hs j 1)
    simp only [Scheme.Hom.comp_apply] at e
    exact e.trans hx
  ·
    intro i j γ γ' Z a b hab
    constructor
    · intro heq z
      have e : Limits.pullback.lift a b hab ≫ Limits.pullback.map (v i) (v j) πE (v j) (s i γ)
          (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hs i γ]) (by simp) =
          Limits.pullback.lift b b rfl ≫ Limits.pullback.map (v j) (v j) πE (v j) (s j γ')
          (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hs j γ']) (by simp) := by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst,
            Limits.pullback.lift_fst_assoc]
          exact heq
        · simp only [Category.assoc, Limits.pullback.map, Limits.pullback.lift_snd,
            Limits.pullback.lift_snd_assoc]
      have ez := congrArg (fun k => k z) e
      simp only [Scheme.Hom.comp_apply] at ez
      have e1 := hsrep i γ j (Limits.pullback.lift a b hab z)
      have e2 := hsrep j γ' j (Limits.pullback.lift b b rfl z)
      rw [hdiag, mul_one] at e2
      exact e2.trans ((congrArg (Λ j) ez).symm.trans e1.symm)
    · intro hrule
      have h1 : (a ≫ s i γ) ≫ πE = a ≫ v i := by rw [Category.assoc, hs]
      have h2 : (b ≫ s j γ') ≫ πE = a ≫ v i := by rw [Category.assoc, hs, hab]
      exact (hrep.2.2 Z (a ≫ v i) (by simp) _ (hpf i γ Z (a ≫ v i) a rfl)).unique
        ⟨h1, fun l w => htr i γ Z (a ≫ v i) a rfl h1 l w⟩
        ⟨h2, fun l w => (hsw i j γ γ' Z (a ≫ v i) a b rfl hab.symm hab hrule l w).trans
          (htr j γ' Z (a ≫ v i) b hab.symm h2 l w)⟩
  ·
    intro j Z hZ a e he
    haveI := hZ
    obtain ⟨z₀⟩ := (ConnectedSpace.toNonempty : Nonempty Z)
    have hconst : ∀ z : Z, Λ j (Limits.pullback.lift e a he.symm z) =
        Λ j (Limits.pullback.lift e a he.symm z₀) := fun z =>
      ((hrep.2.1.1 j).comp_continuous
        (Limits.pullback.lift e a he.symm).continuous).apply_eq_of_preconnectedSpace z z₀
    have h2 : (a ≫ s j (Λ j (Limits.pullback.lift e a he.symm z₀))) ≫ πE = a ≫ v j := by
      rw [Category.assoc, hs]
    refine ⟨Λ j (Limits.pullback.lift e a he.symm z₀),
      (hrep.2.2 Z (a ≫ v j) (by simp) _ (hpf j _ Z (a ≫ v j) a rfl)).unique
        ⟨he.symm, fun l w => hcr j _ Z (a ≫ v j) a e rfl he.symm he.symm hconst l w⟩
        ⟨h2, fun l w => htr j _ Z (a ≫ v j) a rfl h2 l w⟩⟩

theorem wc_fpqc_gtor_descent : ∀ (U X : Scheme.{u}) (p : X ⟶ U), CompactSpace U → QuasiSeparatedSpace U → Flat p → QuasiCompact p → Surjective p → ∀ (Γ : Type) [Group Γ] [Finite Γ] (c : ↥(Limits.pullback p p) → Γ), IsLocallyConstant c → (∀ (Z : Scheme.{u}) (a b d : Z ⟶ X) (hab : a ≫ p = b ≫ p) (hbd : b ≫ p = d ≫ p) (had : a ≫ p = d ≫ p) (z : Z), c (Limits.pullback.lift a d had z) = c (Limits.pullback.lift a b hab z) * c (Limits.pullback.lift b d hbd z)) → ∃ (E : Scheme.{u}) (πE : E ⟶ U) (s : Γ → (X ⟶ E)), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧ (∀ γ, s γ ≫ πE = p) ∧ (∀ (Z : Scheme.{u}) (a b : Z ⟶ X) (hab : a ≫ p = b ≫ p) (γ γ' : Γ), a ≫ s γ = b ≫ s γ' ↔ ∀ z : Z, γ' = γ * c (Limits.pullback.lift a b hab z)) ∧ (∀ (Z : Scheme.{u}), ConnectedSpace Z → ∀ (a : Z ⟶ X) (e : Z ⟶ E), a ≫ p = e ≫ πE → ∃ γ, e = a ≫ s γ) :=
by
  intro U X p _hcpt hqs hflat hqc hsurj Γ _ _ c hc hcoc
  classical

  have hD : wcFpqcFamDescHyp.{u} := by
    intro T Y I _ Xs f hf hqcf hcov s hs
    have hsh : Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj Y) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hcov' : Sieve.generate (Presieve.ofArrows Xs f) ∈ Scheme.fpqcTopology T := by
      apply Precoverage.generate_mem_toGrothendieck
      refine ⟨?_, ?_⟩
      · have hqcc : QuasiCompactCover (PreZeroHypercover.mk I Xs f) := by
          rw [quasiCompactCover_iff]
          intro V' hV'
          refine IsCompactOpenCovered.of_finite (κ := I) id (fun i => f i ⁻¹ᵁ V') ?_ ?_
          · intro i
            haveI := hqcf i
            exact (f i).isCompact_preimage hV'.isCompact
          · apply Set.Subset.antisymm
            · intro y hy
              obtain ⟨i, x, hx, rfl⟩ := Set.mem_iUnion.mp hy
              exact hx
            · intro y hy
              obtain ⟨i, x, rfl⟩ := hcov y
              exact Set.mem_iUnion.mpr ⟨i, x, hy, rfl⟩
        exact (Scheme.presieve₀_mem_qcPrecoverage_iff (E := PreZeroHypercover.mk I Xs f)).mpr hqcc
      · exact (Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).2 ⟨hcov, hf⟩
    exact (Presieve.isSheafFor_arrows_iff (yoneda.obj Y) f).mp (hsh.isSheafFor _ hcov') s
      (fun i j Z a b hab => hs i j Z a b hab)

  have hL : wcFpqcLcDescHyp.{u} := by
    intro T I _ Xs₀ f₀ hf₀ hqcf₀ hcov₀ A h hloc₀

    have key : ∀ (J : Type u) [Finite J] (Xs : J → Scheme.{u}) (f : ∀ j, Xs j ⟶ T),
        (∀ j, Flat (f j)) → (∀ j, QuasiCompact (f j)) → (∀ x : T, ∃ j, x ∈ Set.range (f j)) →
        (∀ j, IsLocallyConstant (fun x : ↥(Xs j) => h (f j x))) → IsLocallyConstant h := by
      intro J _ Xs f hf hqcf hcov hloc
      haveI : ∀ i, Flat (f i) := hf
      have hFi : ∀ i x, (Limits.Sigma.desc f) (Limits.Sigma.ι Xs i x) = f i x := by
        intro i x
        rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
      haveI hFflat : Flat (Limits.Sigma.desc f) := Flat.instDescScheme
      haveI hFsurj : Surjective (Limits.Sigma.desc f) :=
        Surjective.sigmaDesc_of_union_range_eq_univ
          (Set.eq_univ_of_forall (fun x => Set.mem_iUnion.mpr (hcov x)))
      haveI hFqc : QuasiCompact (Limits.Sigma.desc f) := by
        constructor
        intro K hKo hK
        have e : (Limits.Sigma.desc f) ⁻¹' K =
            ⋃ i, (Limits.Sigma.ι Xs i) '' ((f i) ⁻¹' K) := by
          apply Set.Subset.antisymm
          · intro y hy
            obtain ⟨⟨i, x⟩, rfl⟩ := (sigmaMk Xs).surjective y
            rw [sigmaMk_mk] at hy ⊢
            refine Set.mem_iUnion.mpr ⟨i, x, ?_, rfl⟩
            have h1 := hFi i x
            rw [Set.mem_preimage, h1] at hy
            exact hy
          · intro y hy
            obtain ⟨i, x, hx, rfl⟩ := Set.mem_iUnion.mp hy
            rw [Set.mem_preimage, hFi]
            exact hx
        rw [e]
        exact isCompact_iUnion (fun i =>
          (haveI := hqcf i; QuasiCompact.isCompact_preimage (f := f i) K hKo hK).image
            (Limits.Sigma.ι Xs i).continuous)
      have hQ := Flat.isQuotientMap_of_surjective (Limits.Sigma.desc f)
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro α
      rw [← hQ.isCoinducing.isOpen_preimage, ← (sigmaMk Xs).isOpen_preimage, isOpen_sigma_iff]
      intro i
      have e : Sigma.mk i ⁻¹' ((sigmaMk Xs) ⁻¹' ((Limits.Sigma.desc f) ⁻¹' (h ⁻¹' {α}))) =
          {x | h (f i x) = α} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq, sigmaMk_mk, hFi]
      rw [e]
      exact (hloc i).isOpen_fiber α
    exact key (ULift.{u} I) (fun j => Xs₀ j.down) (fun j => f₀ j.down) (fun j => hf₀ j.down)
      (fun j => hqcf₀ j.down)
      (fun x => by obtain ⟨i, hi⟩ := hcov₀ x; exact ⟨ULift.up i, hi⟩)
      (fun j => hloc₀ j.down)

  have hR : wcGTorDescHyp.{u} := wc_gtor_ring_descent
  have hG : wcGCocycle (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) :=
    fun _ _ _ Z a b d hab hbd had z => hcoc Z a b d hab hbd had z

  have hlocal : ∀ x : U, ∃ O : U.Opens, x ∈ O ∧ ∃ (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u}))
      (Λ : ∀ l : Unit, ↥(Limits.pullback (π ≫ O.ι) ((fun _ : Unit => p) l)) → Γ),
      IsFinite π ∧ Etale π ∧
        wcGRep (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) O (π ≫ O.ι) Λ := by
    intro x
    obtain ⟨O, hO, hxO, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := U) (x := x) (U := ⊤) trivial
    obtain ⟨n, W, k, w, E, π, σ, hfin, het, hWaff, hwopen, hσ, hOcov, hσcov, hmeet⟩ :=
      wc_fgtor_affine_sheeted U Γ Unit (fun _ => X) (fun _ => p) (fun _ => hflat) (fun _ => hqc)
        (fun _ _ => c) (fun _ _ => hc) hG hR O hO (fun y _ => ⟨(), hsurj.surj y⟩)
    have hfl : ∀ m, Flat (w m ≫ (fun _ : Unit => p) (k m)) := by
      intro m
      haveI := hwopen m
      show Flat (w m ≫ p)
      infer_instance
    have hqc' : ∀ m, QuasiCompact (w m ≫ (fun _ : Unit => p) (k m)) := by
      intro m
      haveI := hWaff m
      exact quasiCompact_of_compactSpace _
    obtain ⟨Λ, hΛ⟩ := wc_fgtor_rep_of_sheets hD hL U Γ Unit (fun _ => X) (fun _ => p)
      (fun _ _ => c) (fun _ _ => hc) hG O n W k w E π σ hfin het hfl hqc' hσ hOcov hσcov hmeet
    exact ⟨O, hxO, E, π, Λ, hfin, het, hΛ⟩

  obtain ⟨E, πE, Λ, hfin, het, hrep⟩ :=
    wc_gtor_rep_zariski_glue U Γ Unit (fun _ => X) (fun _ => p) (fun _ _ => c) hlocal

  obtain ⟨hsurjE, s, hs, hMR, hLOC⟩ :=
    wc_fgtor_sheets_iff_of_rep U Γ Unit (fun _ => X) (fun _ => p)
      (fun y => ⟨(), hsurj.surj y⟩) (fun _ _ => c) (fun _ _ => hc) hG E πE Λ hrep
  exact ⟨E, πE, s (), hfin, het, hsurjE, fun γ => hs () γ,
    fun Z a b hab γ γ' => hMR () () γ γ' Z a b hab, fun Z hZ a e he => hLOC () Z hZ a e he⟩

theorem wc_fet_connected_piece : ∀ (U X E : Scheme.{u}) (p : X ⟶ U) (πE : E ⟶ U) (Γ : Type) [Group Γ]
    (s : Γ → (X ⟶ E)),
    AlgebraicGeometry.IsNoetherian U → IsFinite πE → Etale πE → Surjective p → ConnectedSpace X →
    (∀ γ, s γ ≫ πE = p) →
    (∀ (Z : Scheme.{u}), ConnectedSpace Z → ∀ (a : Z ⟶ X) (e : Z ⟶ E), a ≫ p = e ≫ πE →
      ∃ γ, e = a ≫ s γ) →
    ∃ E0 : E.Opens, ConnectedSpace E0.toScheme ∧ IsFinite (E0.ι ≫ πE) ∧ Etale (E0.ι ≫ πE) ∧
      Surjective (E0.ι ≫ πE) ∧ Set.range (s 1) ⊆ (E0 : Set E) ∧
      ∀ y ∈ (E0 : Set E), ∃ (γ : Γ) (x : X), Set.range (s γ) ⊆ (E0 : Set E) ∧ s γ x = y :=
by
  intro U X E p πE Γ _ s hN hfin het hp hX hs hlift
  haveI := hN
  haveI := hfin
  haveI := het
  haveI := hp
  haveI := hX

  haveI : IsLocallyNoetherian E := LocallyOfFiniteType.isLocallyNoetherian πE
  haveI : CompactSpace E := QuasiCompact.compactSpace_of_compactSpace πE
  haveI : AlgebraicGeometry.IsNoetherian E := AlgebraicGeometry.IsNoetherian.mk
  obtain ⟨x₀⟩ := (inferInstance : Nonempty X)
  set C : Set E := connectedComponent (s 1 x₀) with hCdef

  have hCo : IsOpen C := by
    have hcl : IsClosed (⋃₀ {Z ∈ irreducibleComponents E | Z ⊆ Cᶜ}) := by
      apply Set.Finite.isClosed_sUnion
      · exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset
          (fun Z hZ => hZ.1)
      · intro Z hZ
        exact isClosed_of_mem_irreducibleComponents Z hZ.1
    have heq : Cᶜ = ⋃₀ {Z ∈ irreducibleComponents E | Z ⊆ Cᶜ} := by
      apply Set.Subset.antisymm
      · intro y hy
        refine ⟨irreducibleComponent y, ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩,
          mem_irreducibleComponent⟩
        have h1 : irreducibleComponent y ⊆ connectedComponent y :=
          (isIrreducible_irreducibleComponent.isConnected.isPreconnected).subset_connectedComponent
            mem_irreducibleComponent
        intro z hz hzC
        apply hy
        have h2 : z ∈ connectedComponent y := h1 hz
        rw [hCdef, connectedComponent_eq hzC, ← connectedComponent_eq h2]
        exact mem_connectedComponent
      · intro y hy
        obtain ⟨Z, ⟨_, hZ⟩, hyZ⟩ := hy
        exact hZ hyZ
    rw [← isClosed_compl_iff, heq]
    exact hcl
  have hCc : IsClosed C := isClosed_connectedComponent
  let E0 : E.Opens := ⟨C, hCo⟩
  have hE0 : (E0 : Set E) = C := rfl

  have habs : ∀ (γ : Γ) (y : E), y ∈ Set.range (s γ) → y ∈ C → Set.range (s γ) ⊆ C := by
    intro γ y hyr hyC
    have hpre : _root_.IsPreconnected (Set.range (s γ)) :=
      isPreconnected_range (Scheme.Hom.continuous (s γ))
    have h1 := hpre.subset_connectedComponent hyr
    rw [hCdef, connectedComponent_eq hyC]
    exact h1
  have hG5 : Set.range (s 1) ⊆ C := habs 1 (s 1 x₀) ⟨x₀, rfl⟩ mem_connectedComponent
  refine ⟨E0, ?_, ?_, ?_, ?_, hG5, ?_⟩
  · exact isConnected_iff_connectedSpace.mp isConnected_connectedComponent
  · haveI : IsClosedImmersion E0.ι :=
      IsClosedImmersion.of_isPreimmersion E0.ι (by rw [Scheme.Opens.range_ι]; exact hCc)
    infer_instance
  · infer_instance
  · constructor
    intro u
    obtain ⟨x, hx⟩ := hp.surj u
    have hmem : s 1 x ∈ E0 := hG5 ⟨x, rfl⟩
    have hr : s 1 x ∈ Set.range E0.ι := by rw [Scheme.Opens.range_ι]; exact hmem
    obtain ⟨pt, hpt⟩ := hr
    refine ⟨pt, ?_⟩
    rw [Scheme.Hom.comp_apply, hpt, ← Scheme.Hom.comp_apply, hs 1, hx]
  · intro y hy
    obtain ⟨x₁, hx₁⟩ := hp.surj (πE y)
    obtain ⟨ω, hω1, hω2⟩ := Scheme.Pullback.exists_preimage_pullback (f := p) (g := πE) x₁ y hx₁
    let P := Limits.pullback p πE
    let ι₀ := P.fromSpecResidueField ω
    let a := ι₀ ≫ Limits.pullback.fst p πE
    let e := ι₀ ≫ Limits.pullback.snd p πE
    have hae : a ≫ p = e ≫ πE := by
      simp only [a, e, Category.assoc, Limits.pullback.condition]
    obtain ⟨γ, hγ⟩ := hlift _ inferInstance a e hae
    obtain ⟨ζ⟩ := (inferInstance : Nonempty (Spec (P.residueField ω)))
    have key : s γ (a ζ) = y := by
      have h1 : e ζ = y := by
        simp only [e, Scheme.Hom.comp_apply, ι₀, Scheme.fromSpecResidueField_apply]
        exact hω2
      rw [← h1, hγ]
      exact (Scheme.Hom.comp_apply a (s γ) ζ).symm
    refine ⟨γ, a ζ, habs γ y ⟨a ζ, key⟩ hy, key⟩

theorem wc_proet_frame_glue_twisted : ∀ (S : Scheme.{u}) (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (M : Type) [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M] [IsTopologicalAddGroup M]
    (V X : S.ProEt) (θV : H.over V ≅ (wcContSheaf S M).over V) (K : Type) (f : K → (V ⟶ X))
    (g : K → Multiplicative (AddAut M)),
    Sieve.generate (Presieve.ofArrows (fun _ : K => V) f) ∈ Scheme.ProEt.topology S X →
    (∀ (k l : K) (Z : S.ProEt) (a b : Z ⟶ V), a ≫ f k = b ≫ f l →
      ∀ (x : H.obj.obj (Opposite.op Z)) (z : Z.left),
        Multiplicative.toAdd (g k)
            ((show C(↥Z.left, M) from ((θV.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) =
          Multiplicative.toAdd (g l)
            ((show C(↥Z.left, M) from ((θV.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z)) →
    ∃ θX : H.over X ≅ (wcContSheaf S M).over X, ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ V)
      (x : H.obj.obj (Opposite.op Z)) (z : Z.left),
      (show C(↥Z.left, M) from ((θX.hom.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x).down) z =
        Multiplicative.toAdd (g k)
          ((show C(↥Z.left, M) from ((θV.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) :=
by
  intro S H M _ _ _ _ V X θV K f g hcov hcomp

  have tw : ∀ σ : M ≃+ M, ∃ θ : wcContSheaf S M ≅ wcContSheaf S M, ∀ (T : S.ProEt)
      (x : (wcContSheaf S M).obj.obj (Opposite.op T)) (z : T.left),
      (show C(↥T.left, M) from ((θ.hom.hom.app (Opposite.op T)).hom x).down) z =
        σ ((show C(↥T.left, M) from x.down) z) := by
    intro σ
    let h : wcContSheaf S M ⟶ wcContSheaf S M :=
      wcContSheafMap S σ.toAddMonoidHom continuous_of_discreteTopology
    let k : wcContSheaf S M ⟶ wcContSheaf S M :=
      wcContSheafMap S σ.symm.toAddMonoidHom continuous_of_discreteTopology
    have hk : h ≫ k = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext T
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact σ.symm_apply_apply ((show C(↥(Opposite.unop T).left, M) from x.down) z)
    have kh : k ≫ h = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext T
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact σ.apply_symm_apply ((show C(↥(Opposite.unop T).left, M) from x.down) z)
    exact ⟨⟨h, k, hk, kh⟩, fun T x z => rfl⟩
  choose θσ hθσ using fun k : K => tw (Multiplicative.toAdd (g k))

  let φ : ∀ k : K, H.over V ≅ (wcContSheaf S M).over V := fun k =>
    θV ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).mapIso (θσ k)
  have hR : ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ V) (x : H.obj.obj (Opposite.op Z)),
      ((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom x =
        ((θσ k).hom.hom.app (Opposite.op Z)).hom
          ((θV.hom.hom.app (Opposite.op (Over.mk a))).hom x) := fun k Z a x => rfl

  have hφ : ∀ (k l : K) (Z : S.ProEt) (a : Z ⟶ V) (b : Z ⟶ V), a ≫ f k = b ≫ f l →
      ∀ x : H.obj.obj (Opposite.op Z),
        ((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom x =
          ((φ l).hom.hom.app (Opposite.op (Over.mk b))).hom x := by
    intro k l Z a b hab x
    rw [hR k Z a x, hR l Z b x]
    have key : (show ULift.{u+1} C(Z.left, M) from ((θσ k).hom.hom.app (Opposite.op Z)).hom
          ((θV.hom.hom.app (Opposite.op (Over.mk a))).hom x)) =
        (show ULift.{u+1} C(Z.left, M) from ((θσ l).hom.hom.app (Opposite.op Z)).hom
          ((θV.hom.hom.app (Opposite.op (Over.mk b))).hom x)) := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact (hθσ k Z _ z).trans ((hcomp k l Z a b hab x z).trans (hθσ l Z _ z).symm)
    exact key

  have hP : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Presieve.IsSheafFor (presheafHom A.obj B.obj)
        (Presieve.ofArrows (fun _ : K => V) f) := fun A B =>
    ((isSheaf_iff_isSheaf_of_type _ _).mp
      (Presheaf.IsSheaf.hom A.obj B.obj B.property)).isSheafFor _ hcov
  have glue : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (ψ : ∀ _ : K, A.over V ⟶ B.over V),
      (∀ (k l : K) (Z : S.ProEt) (a : Z ⟶ V) (b : Z ⟶ V), a ≫ f k = b ≫ f l →
        ∀ x : A.obj.obj (Opposite.op Z),
          ((ψ k).hom.app (Opposite.op (Over.mk a))).hom x =
            ((ψ l).hom.app (Opposite.op (Over.mk b))).hom x) →
      ∃ α : A.over X ⟶ B.over X, ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ V)
        (x : A.obj.obj (Opposite.op Z)),
        (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x =
          ((ψ k).hom.app (Opposite.op (Over.mk a))).hom x := by
    intro A B ψ hψ
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff _ f).mp (hP A B)
      (fun k => (ψ k).hom) (by
        intro i j W gi gj h
        apply NatTrans.ext
        funext T
        obtain ⟨T⟩ := T
        change ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map gi.op)) (ψ i).hom).app
            (Opposite.op (Over.mk T.hom)) =
          ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map gj.op)) (ψ j).hom).app
            (Opposite.op (Over.mk T.hom))
        refine (presheafHom_map_app T.hom gi _ rfl (ψ i).hom).trans
          (Eq.trans ?_ (presheafHom_map_app T.hom gj _ rfl (ψ j).hom).symm)
        ext s
        exact hψ i j T.left (T.hom ≫ gi) (T.hom ≫ gj)
          (by rw [Category.assoc, Category.assoc, h]) s)
    refine ⟨ObjectProperty.homMk t, fun k Z a x => ?_⟩
    have e1 := (presheafHom_map_app a (f k) _ rfl t).symm.trans
      (congrArg (fun m : (presheafHom A.obj B.obj).obj (Opposite.op V) =>
        m.app (Opposite.op (Over.mk a))) (ht k))
    exact congrArg (fun m => AddCommGrpCat.Hom.hom m x) e1
  have uniq : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (α β : A.over X ⟶ B.over X),
      (∀ (k : K) (Z : S.ProEt) (a : Z ⟶ V) (x : A.obj.obj (Opposite.op Z)),
        (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x =
          (β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x) →
      α = β := by
    intro A B α β h
    apply Sheaf.hom_ext
    refine (hP A B).isSeparatedFor.ext (t₁ := α.hom) (t₂ := β.hom) ?_
    rintro _ _ ⟨k⟩
    apply NatTrans.ext
    funext T
    obtain ⟨T⟩ := T
    change ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map (f k).op)) α.hom).app
        (Opposite.op (Over.mk T.hom)) =
      ((ConcreteCategory.hom ((presheafHom A.obj B.obj).map (f k).op)) β.hom).app
        (Opposite.op (Over.mk T.hom))
    refine (presheafHom_map_app T.hom (f k) _ rfl α.hom).trans
      (Eq.trans ?_ (presheafHom_map_app T.hom (f k) _ rfl β.hom).symm)
    ext s
    exact h k T.left T.hom s
  have hinv1 : ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ V) (x : H.obj.obj (Opposite.op Z)),
      ((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom
        (((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom x) = x := fun k Z a x =>
    congrArg (fun m : H.over V ⟶ H.over V =>
      (m.hom.app (Opposite.op (Over.mk a))).hom x) (φ k).hom_inv_id
  have hinv2 : ∀ (k : K) (Z : S.ProEt) (a : Z ⟶ V)
      (x : (wcContSheaf S M).obj.obj (Opposite.op Z)),
      ((φ k).hom.hom.app (Opposite.op (Over.mk a))).hom
        (((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom x) = x := fun k Z a x =>
    congrArg (fun m : (wcContSheaf S M).over V ⟶ (wcContSheaf S M).over V =>
      (m.hom.app (Opposite.op (Over.mk a))).hom x) (φ k).inv_hom_id
  have hφinv : ∀ (k l : K) (Z : S.ProEt) (a : Z ⟶ V) (b : Z ⟶ V), a ≫ f k = b ≫ f l →
      ∀ x : (wcContSheaf S M).obj.obj (Opposite.op Z),
        ((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom x =
          ((φ l).inv.hom.app (Opposite.op (Over.mk b))).hom x := by
    intro k l Z a b hab x
    have h1 := (hφ k l Z a b hab (((φ l).inv.hom.app (Opposite.op (Over.mk b))).hom x)).trans
      (hinv2 l Z b x)
    exact (congrArg (fun z => ((φ k).inv.hom.app (Opposite.op (Over.mk a))).hom z) h1).symm.trans
      (hinv1 k Z a _)
  obtain ⟨α, hα⟩ := glue H (wcContSheaf S M) (fun k => (φ k).hom) hφ
  obtain ⟨β, hβ⟩ := glue (wcContSheaf S M) H (fun k => (φ k).inv) hφinv
  let θX : H.over X ≅ (wcContSheaf S M).over X :=
    { hom := α, inv := β
      hom_inv_id := by
        apply uniq H H
        intro k Z a x
        change (β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom
            ((α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x) = x
        exact (congrArg (fun z => (β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom z)
          (hα k Z a x)).trans ((hβ k Z a _).trans (hinv1 k Z a x))
      inv_hom_id := by
        apply uniq (wcContSheaf S M) (wcContSheaf S M)
        intro k Z a x
        change (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom
            ((β.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x) = x
        exact (congrArg (fun z => (α.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom z)
          (hβ k Z a x)).trans ((hα k Z a _).trans (hinv2 k Z a x)) }

  refine ⟨θX, fun k Z a x z => ?_⟩
  have e1 : (θX.hom.hom.app (Opposite.op (Over.mk (a ≫ f k)))).hom x =
      ((θσ k).hom.hom.app (Opposite.op Z)).hom
        ((θV.hom.hom.app (Opposite.op (Over.mk a))).hom x) :=
    (hα k Z a x).trans (hR k Z a x)
  have e2 := congrArg (fun y : ULift.{u+1} C(Z.left, M) => y.down z) e1
  exact e2.trans (hθσ k Z _ z)

theorem wc_qcfin_frame_fet_descent (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ)
    (θr : L.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W) :
    ∃ (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens),
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          S i (IsLocalRing.closedPoint F'')) ∧
      ∃ (ℰ : (wcP1Over F'').left.ProEt) (e : ℰ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
        (πE : ℰ.left ⟶ Ub.toScheme),
        πE ≫ Ub.ι = e.left ∧
        IsFinite πE ∧ Etale πE ∧ Surjective πE ∧ ConnectedSpace ℰ.left ∧
        ∃ (θE : L.over ℰ ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over ℰ)
          (V : (wcP1Over F'').left.ProEt) (ι : V ⟶ W) (c : V ⟶ ℰ),
          ConnectedSpace V.left ∧
          c ≫ e = ι ≫ w ∧
          (∀ (V' : (wcP1Over F'').left.ProEt) (v : V' ⟶ V) (x : L.obj.obj (Opposite.op V'))
              (z : V'.left),
            (show C(↥V'.left, (Fin k → ZMod (ℓ ^ r))) from
              ((θE.hom.hom.app (Opposite.op (Over.mk (v ≫ c)))).hom x).down) z =
            (show C(↥V'.left, (Fin k → ZMod (ℓ ^ r))) from
              ((θr.hom.hom.app (Opposite.op (Over.mk (v ≫ ι)))).hom x).down) z) ∧
          ∀ γ : W ⟶ W, γ ≫ w = w → ∃ γ' : V ⟶ V, γ' ≫ ι = ι ≫ γ :=
by
  classical
  haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero r (Fact.out : ℓ.Prime).ne_zero⟩

  obtain ⟨Ub, hUb, hUbN, V, ι, pV, hpV, hVc, hpVs, hpVw, hpVq, hlift⟩ :=
    wc_qcfin_offS_restrict F'' hP m S hS W w hqc hconn hsurj

  let θV : L.over V ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over V :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1} ι).mapIso θr
  have hpq : pV ≫ (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) = V.hom := by
    rw [← Category.assoc, hpV, Category.assoc, MorphismProperty.Over.w w,
      MorphismProperty.Over.w ι]

  obtain ⟨c₀, hlc, hcoc, htrans⟩ := wc_qcfin_frame_base_cocycle (wcP1Over F'').left L
    (Fin k → ZMod (ℓ ^ r)) V θV Ub.toScheme pV
    (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hpq hpVw

  haveI := hUbN
  haveI := hpVw
  obtain ⟨E, πE₀, s, hfin, het, -, hs, hmeet, hclift⟩ := wc_fpqc_gtor_descent Ub.toScheme V.left pV
    inferInstance inferInstance inferInstance hpVq hpVs
    (Multiplicative (AddAut (Fin k → ZMod (ℓ ^ r)))) c₀ hlc hcoc

  obtain ⟨E0, hE0c, hfin', het', hsurj', hs1, hcov⟩ := wc_fet_connected_piece Ub.toScheme V.left E
    pV πE₀ _ s hUbN hfin het hpVs hVc hs hclift
  haveI := hfin

  let πE : E0.toScheme ⟶ Ub.toScheme := E0.ι ≫ πE₀
  have hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
    haveI : Etale πE := het'
    haveI : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
      (wcGeomPoint F'' (wcP1Over F'') hP).prop
    infer_instance
  let ℰ : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE
  let e : ℰ ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (πE ≫ Ub.ι) (Category.assoc _ _ _) trivial

  let K := {γ : Multiplicative (AddAut (Fin k → ZMod (ℓ ^ r))) // Set.range (s γ) ⊆ (E0 : Set E)}
  have hsub : ∀ κ : K, Set.range (s κ.1) ⊆ Set.range E0.ι := fun κ => by
    rw [Scheme.Opens.range_ι]; exact κ.2
  let s' : K → (V.left ⟶ E0.toScheme) := fun κ => IsOpenImmersion.lift E0.ι (s κ.1) (hsub κ)
  have hs' : ∀ κ, s' κ ≫ E0.ι = s κ.1 := fun κ => IsOpenImmersion.lift_fac _ _ _
  have htri : ∀ κ, s' κ ≫ ℰ.hom = V.hom := by
    intro κ
    show s' κ ≫ ((E0.ι ≫ πE₀) ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) = V.hom
    simp only [Category.assoc]
    rw [← Category.assoc (s' κ) E0.ι, hs', ← Category.assoc (s κ.1) πE₀, hs, hpq]
  let f : K → (V ⟶ ℰ) := fun κ => MorphismProperty.Over.homMk (s' κ) (htri κ) trivial
  haveI : Finite K := Subtype.finite
  let κ₀ : K := ⟨1, hs1⟩

  have hqcs : ∀ κ : K, QuasiCompact (f κ).left := by
    intro κ
    have h1 : QuasiCompact (s κ.1) := by
      haveI : QuasiCompact (s κ.1 ≫ πE₀) := by rw [hs]; exact hpVq
      exact QuasiCompact.of_comp (s κ.1) πE₀
    haveI : QuasiCompact (s' κ ≫ E0.ι) := by rw [hs']; exact h1
    exact QuasiCompact.of_comp (s' κ) E0.ι

  have hjs : ∀ y : ℰ.left, ∃ κ, y ∈ Set.range (f κ).left := by
    intro y
    obtain ⟨γ, x, hγ, hx⟩ := hcov (E0.ι y) (by rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩)
    refine ⟨⟨γ, hγ⟩, x, ?_⟩
    apply E0.ι.isOpenEmbedding.injective
    show E0.ι (s' ⟨γ, hγ⟩ x) = E0.ι y
    rw [← Scheme.Hom.comp_apply, hs', hx]

  have hcovS : Sieve.generate (Presieve.ofArrows (fun _ : K => V) f) ∈
      Scheme.ProEt.topology (wcP1Over F'').left ℰ := by
    have hs5 : ∀ x : ℰ.left, ∃ j y, (f j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hjs x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (f i).left := fun i => by
      have h1 : WeaklyEtale ((f i).left ≫ ℰ.hom) := by
        rw [MorphismProperty.Over.w (f i)]; exact V.prop
      exact @WeaklyEtale.of_comp _ _ _ (f i).left ℰ.hom h1 ℰ.prop
    let 𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) K (fun _ => V.left) (fun i => (f i).left) hs5
      (fun _ => trivial)
    haveI : Finite 𝒰.I₀ := (inferInstance : Finite K)
    haveI : ∀ i, QuasiCompact (𝒰.f i) := fun i => hqcs i
    have H : Presieve.ofArrows (fun _ : K => V.left) (fun i => (f i).left) ∈
        Scheme.proetalePrecoverage.coverings ℰ.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_finite (𝒰 := 𝒰)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs5 x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  obtain ⟨θE, hθE⟩ := wc_proet_frame_glue_twisted (wcP1Over F'').left L (Fin k → ZMod (ℓ ^ r))
    V ℰ θV K f Subtype.val hcovS (by
      intro κ κ' Z a b hab x z
      have h1 : a.left ≫ s' κ = b.left ≫ s' κ' := congrArg (fun t => t.left) hab
      have h2 : a.left ≫ s κ.1 = b.left ≫ s κ'.1 := by
        rw [← hs' κ, ← hs' κ', ← Category.assoc, h1, Category.assoc]
      have h3 : a.left ≫ pV = b.left ≫ pV := by
        calc a.left ≫ pV = (a.left ≫ s κ.1) ≫ πE₀ := by rw [Category.assoc, hs]
          _ = (b.left ≫ s κ'.1) ≫ πE₀ := by rw [h2]
          _ = b.left ≫ pV := by rw [Category.assoc, hs]
      have h4 := (hmeet Z.left a.left b.left h3 κ.1 κ'.1).mp h2 z
      rw [htrans Z a b h3 x z, h4]
      rfl)
  refine ⟨Ub, hUb, ℰ, e, πE, rfl, hfin', het', hsurj', hE0c, θE, V, ι, f κ₀, hVc, ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    show s' κ₀ ≫ (E0.ι ≫ πE₀) ≫ Ub.ι = ι.left ≫ w.left
    calc s' κ₀ ≫ (E0.ι ≫ πE₀) ≫ Ub.ι = ((s' κ₀ ≫ E0.ι) ≫ πE₀) ≫ Ub.ι := by
          simp only [Category.assoc]
      _ = ι.left ≫ w.left := by rw [hs', hs, hpV]
  · intro V' v x z
    exact (hθE κ₀ V' v x z).trans rfl
  · intro γ hγ
    have hγl : γ.left ≫ w.left = w.left := congrArg (fun t => t.left) hγ
    obtain ⟨γ', hγ'⟩ := hlift V (ι ≫ γ) (by
      intro z
      have e1 : w.left (γ.left (ι.left z)) = w.left (ι.left z) := by
        rw [← Scheme.Hom.comp_apply γ.left w.left, hγl]
      have e2 : w.left (ι.left z) = Ub.ι (pV z) := by
        rw [← Scheme.Hom.comp_apply ι.left w.left, ← hpV, Scheme.Hom.comp_apply]
      have e3 : Ub.ι (pV z) ∈ (Ub : Set _) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
      show w.left (γ.left (ι.left z)) ∈ Ub
      rw [e1, e2]
      exact e3)
    exact ⟨γ', hγ'⟩

theorem wc_proet_ext1_finite_of_cover : ∀ (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U), Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S U → ∀ (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), Finite (L.obj.obj (Opposite.op (Limits.pullback p p))) → Finite (Abelian.Ext (wcFreeSheaf S Ω) L 1) → Finite (Abelian.Ext (wcFreeSheaf S U) L 1) :=
by
  classical
  intro S U Ω p hcov L hLN hΩ
  haveI := hLN
  haveI := hΩ

  have hY : ∀ (S : Scheme.{u}), ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    intro S
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]
  obtain ⟨η, hηu, hη⟩ := hY S

  have Y2 : ∀ (T : S.ProEt) {F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (h : wcFreeSheaf S T ⟶ F) (φ : F ⟶ G),
      ((h ≫ φ).hom.app (Opposite.op T)).hom (η T) =
        (φ.hom.app (Opposite.op T)).hom ((h.hom.app (Opposite.op T)).hom (η T)) :=
    fun _ _ _ _ _ => rfl

  have Y3 : ∀ (T T' : S.ProEt) (c : T' ⟶ T) {F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (h : wcFreeSheaf S T ⟶ F),
      ((wcFreeSheafMap S c ≫ h).hom.app (Opposite.op T')).hom (η T') =
        (F.obj.map c.op).hom ((h.hom.app (Opposite.op T)).hom (η T)) := by
    intro T T' c F h
    show (h.hom.app (Opposite.op T')).hom
      (((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T')) = _
    rw [hη T T' c]
    exact NatTrans.naturality_apply h.hom c.op (η T)

  have Y4 : ∀ (T : S.ProEt) {F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (g₁ g₂ : wcFreeSheaf S T ⟶ F),
      ((g₁ + g₂).hom.app (Opposite.op T)).hom (η T) =
        (g₁.hom.app (Opposite.op T)).hom (η T) + (g₂.hom.app (Opposite.op T)).hom (η T) := by
    intro T F g₁ g₂
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add]
    rfl

  obtain ⟨I, Q, ι, π, w, hS, hIinj⟩ : ∃ (I Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (ι : L ⟶ I) (π : I ⟶ Q) (w : ι ≫ π = 0), (ShortComplex.mk ι π w).ShortExact ∧ Injective I :=
    ⟨_, _, Injective.ι L, Limits.cokernel.π _, Limits.cokernel.condition _,
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance,
      Injective.injective_under L⟩
  haveI := hIinj

  have hexact : ∀ (W : S.ProEt) (y : I.obj.obj (Opposite.op W)),
      (π.hom.app (Opposite.op W)).hom y = 0 → ∃ x, (ι.hom.app (Opposite.op W)).hom x = y := by
    intro W y hy
    haveI := hS.mono_f
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op W)) hS.mono_f inferInstance
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
    exact ⟨x, hx⟩

  have hcomp : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) {X Y Z : S.ProEt}
      (f : X ⟶ Y) (g : Y ⟶ Z) (s : F.obj.obj (Opposite.op Z)),
      (F.obj.map (f ≫ g).op).hom s = (F.obj.map f.op).hom ((F.obj.map g.op).hom s) := by
    intro F X Y Z f g s
    rw [op_comp, Functor.map_comp]
    rfl
  have hglue : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      (∀ t : F.obj.obj (Opposite.op Ω),
        (F.obj.map (Limits.pullback.fst p p).op).hom t = (F.obj.map (Limits.pullback.snd p p).op).hom t →
        ∃ a : F.obj.obj (Opposite.op U), (F.obj.map p.op).hom a = t) ∧
      (∀ a a' : F.obj.obj (Opposite.op U), (F.obj.map p.op).hom a = (F.obj.map p.op).hom a' → a = a') := by
    intro F
    have hSF := ((isSheaf_iff_isSheaf_of_type (Scheme.ProEt.topology S) (F.obj ⋙ forget AddCommGrpCat)).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) F.obj
          (forget AddCommGrpCat)).1 F.property)).isSheafFor (Presieve.singleton p) hcov
    rw [Presieve.isSheafFor_singleton] at hSF
    constructor
    · intro t ht
      obtain ⟨a, ha, -⟩ := hSF t (fun {Z} p₁ p₂ h => by
        show (F.obj.map p₁.op).hom t = (F.obj.map p₂.op).hom t
        calc (F.obj.map p₁.op).hom t
            = (F.obj.map (Limits.pullback.lift p₁ p₂ h ≫ Limits.pullback.fst p p).op).hom t := by
              rw [Limits.pullback.lift_fst]
          _ = (F.obj.map (Limits.pullback.lift p₁ p₂ h).op).hom
                ((F.obj.map (Limits.pullback.fst p p).op).hom t) := hcomp F _ _ t
          _ = (F.obj.map (Limits.pullback.lift p₁ p₂ h).op).hom
                ((F.obj.map (Limits.pullback.snd p p).op).hom t) := by rw [ht]
          _ = (F.obj.map (Limits.pullback.lift p₁ p₂ h ≫ Limits.pullback.snd p p).op).hom t :=
                (hcomp F _ _ t).symm
          _ = (F.obj.map p₂.op).hom t := by rw [Limits.pullback.lift_snd])
      exact ⟨a, ha⟩
    · intro a a' h
      have hx := hSF ((F.obj.map p.op).hom a) (fun {Z} p₁ p₂ hp => by
        show (F.obj.map p₁.op).hom ((F.obj.map p.op).hom a) =
          (F.obj.map p₂.op).hom ((F.obj.map p.op).hom a)
        rw [← hcomp, ← hcomp, hp])
      exact hx.unique rfl h.symm

  have hπnat : ∀ {X Y : S.ProEt} (f : X ⟶ Y) (s : I.obj.obj (Opposite.op Y)),
      (π.hom.app (Opposite.op X)).hom ((I.obj.map f.op).hom s) =
        (Q.obj.map f.op).hom ((π.hom.app (Opposite.op Y)).hom s) :=
    fun f s => NatTrans.naturality_apply π.hom f.op s

  choose gq hgq using fun (T : S.ProEt) (q : Q.obj.obj (Opposite.op T)) => (hηu T Q q).exists
  have huq : ∀ (T : S.ProEt) (q : Q.obj.obj (Opposite.op T)) (h : wcFreeSheaf S T ⟶ Q),
      (h.hom.app (Opposite.op T)).hom (η T) = q → h = gq T q :=
    fun T q h hh => (hηu T Q q).unique hh (hgq T q)
  obtain ⟨δ, hδ⟩ : ∃ δ : ∀ T : S.ProEt, Q.obj.obj (Opposite.op T) → Abelian.Ext (wcFreeSheaf S T) L 1,
      ∀ T q, δ T q = (Abelian.Ext.mk₀ (gq T q)).comp hS.extClass (zero_add 1) :=
    ⟨_, fun _ _ => rfl⟩
  have hπε : (Abelian.Ext.mk₀ π).comp hS.extClass (zero_add 1) = 0 := hS.comp_extClass
  have hδadd : ∀ (T : S.ProEt) (q₁ q₂ : Q.obj.obj (Opposite.op T)),
      δ T (q₁ + q₂) = δ T q₁ + δ T q₂ := by
    intro T q₁ q₂
    have h : gq T (q₁ + q₂) = gq T q₁ + gq T q₂ :=
      (huq _ _ _ (by rw [Y4, hgq, hgq])).symm
    rw [hδ, hδ, hδ, h, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
  have hδsurj : ∀ x : Abelian.Ext (wcFreeSheaf S U) L 1, ∃ q, δ U q = x := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ ι) (add_zero 1) = 0 :=
      Abelian.Ext.eq_zero_of_injective (n := 0) _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf S U) hS x h0 (n₀ := 0) rfl
    refine ⟨((Abelian.Ext.addEquiv₀ x₃).hom.app (Opposite.op U)).hom (η U), ?_⟩
    have h : gq U (((Abelian.Ext.addEquiv₀ x₃).hom.app (Opposite.op U)).hom (η U)) =
        Abelian.Ext.addEquiv₀ x₃ := (huq _ _ _ rfl).symm
    rw [hδ, h, Abelian.Ext.mk₀_addEquiv₀_apply]
    exact hx₃
  have hδker1 : ∀ (T : S.ProEt) (s : I.obj.obj (Opposite.op T)),
      δ T ((π.hom.app (Opposite.op T)).hom s) = 0 := by
    intro T s
    obtain ⟨h, hh, -⟩ := hηu T I s
    have e1 : gq T ((π.hom.app (Opposite.op T)).hom s) = h ≫ π :=
      (huq _ _ _ (by rw [Y2, hh])).symm
    rw [hδ, e1, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega), hπε, Abelian.Ext.comp_zero]
  have hδker2 : ∀ (T : S.ProEt) (q : Q.obj.obj (Opposite.op T)),
      δ T q = 0 → ∃ s, (π.hom.app (Opposite.op T)).hom s = q := by
    intro T q h0
    rw [hδ] at h0
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ (wcFreeSheaf S T) hS
      (Abelian.Ext.mk₀ (gq T q)) (zero_add 1) h0
    obtain ⟨h, hh⟩ : ∃ h, Abelian.Ext.mk₀ h = x₂ := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply x₂⟩
    have e1 : Abelian.Ext.mk₀ (h ≫ π) = Abelian.Ext.mk₀ (gq T q) := by
      rw [← Abelian.Ext.mk₀_comp_mk₀, hh]
      exact hx₂
    have e2 : h ≫ π = gq T q := (Abelian.Ext.mk₀_bijective _ _).1 e1
    refine ⟨(h.hom.app (Opposite.op T)).hom (η T), ?_⟩
    rw [← Y2, e2, hgq]
  have hδnat : ∀ q : Q.obj.obj (Opposite.op U),
      δ Ω ((Q.obj.map p.op).hom q) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S p)).comp (δ U q) (zero_add 1) := by
    intro q
    have h : gq Ω ((Q.obj.map p.op).hom q) = wcFreeSheafMap S p ≫ gq U q :=
      (huq _ _ _ (by rw [Y3, hgq])).symm
    rw [hδ, hδ, h, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)]

  let ρ : Abelian.Ext (wcFreeSheaf S U) L 1 →+ Abelian.Ext (wcFreeSheaf S Ω) L 1 :=
    AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ (wcFreeSheafMap S p)).comp x (zero_add 1))
      (fun a b => Abelian.Ext.comp_add _ _ _ _)
  have hρ : ∀ x, ρ x = (Abelian.Ext.mk₀ (wcFreeSheafMap S p)).comp x (zero_add 1) := fun _ => rfl
  have hlift : ∀ q : Q.obj.obj (Opposite.op U), ρ (δ U q) = 0 →
      ∃ t : I.obj.obj (Opposite.op Ω), (π.hom.app (Opposite.op Ω)).hom t = (Q.obj.map p.op).hom q := by
    intro q h
    apply hδker2
    rw [hδnat, ← hρ]
    exact h
  have hc : ∀ (q : Q.obj.obj (Opposite.op U)) (t : I.obj.obj (Opposite.op Ω)),
      (π.hom.app (Opposite.op Ω)).hom t = (Q.obj.map p.op).hom q →
      ∃ c : L.obj.obj (Opposite.op (Limits.pullback p p)),
        (ι.hom.app (Opposite.op (Limits.pullback p p))).hom c =
          (I.obj.map (Limits.pullback.fst p p).op).hom t - (I.obj.map (Limits.pullback.snd p p).op).hom t := by
    intro q t ht
    apply hexact
    rw [map_sub, hπnat, hπnat, ht, ← hcomp, ← hcomp, Limits.pullback.condition, sub_self]
  have key : ∀ (q₁ q₂ : Q.obj.obj (Opposite.op U)) (t₁ t₂ : I.obj.obj (Opposite.op Ω)),
      (π.hom.app (Opposite.op Ω)).hom t₁ = (Q.obj.map p.op).hom q₁ →
      (π.hom.app (Opposite.op Ω)).hom t₂ = (Q.obj.map p.op).hom q₂ →
      (I.obj.map (Limits.pullback.fst p p).op).hom t₁ - (I.obj.map (Limits.pullback.snd p p).op).hom t₁ =
        (I.obj.map (Limits.pullback.fst p p).op).hom t₂ - (I.obj.map (Limits.pullback.snd p p).op).hom t₂ →
      δ U q₁ = δ U q₂ := by
    intro q₁ q₂ t₁ t₂ h₁ h₂ h₁₂
    have hpr : (I.obj.map (Limits.pullback.fst p p).op).hom (t₁ - t₂) =
        (I.obj.map (Limits.pullback.snd p p).op).hom (t₁ - t₂) := by
      rw [map_sub, map_sub]
      rw [sub_eq_sub_iff_sub_eq_sub] at h₁₂
      exact h₁₂
    obtain ⟨a, ha⟩ := (hglue I).1 _ hpr
    have hq : (π.hom.app (Opposite.op U)).hom a = q₁ - q₂ := by
      apply (hglue Q).2
      rw [← hπnat, ha, map_sub, h₁, h₂, map_sub]
    have h0 := hδker1 U a
    rw [hq] at h0
    have h3 := hδadd U (q₁ - q₂) q₂
    rw [sub_add_cancel, h0, zero_add] at h3
    exact h3

  have hker : Finite ρ.ker := by
    choose qx hqx using hδsurj
    have hl : ∀ k : ρ.ker, ∃ t : I.obj.obj (Opposite.op Ω),
        (π.hom.app (Opposite.op Ω)).hom t = (Q.obj.map p.op).hom (qx k.1) :=
      fun k => hlift _ (by rw [hqx]; exact AddMonoidHom.mem_ker.mp k.2)
    choose tx htx using hl
    choose cx hcx using fun k => hc _ _ (htx k)
    refine Finite.of_injective cx ?_
    intro k₁ k₂ h
    apply Subtype.ext
    exact (hqx k₁.1).symm.trans ((key _ _ _ _ (htx k₁) (htx k₂)
      (by rw [← hcx k₁, ← hcx k₂, h])).trans (hqx k₂.1))
  have hquot : Finite (Abelian.Ext (wcFreeSheaf S U) L 1 ⧸ ρ.ker) :=
    Finite.of_equiv _ (QuotientAddGroup.quotientKerEquivRange ρ).symm.toEquiv
  exact Finite.of_equiv _ (AddSubgroup.addGroupEquivQuotientProdAddSubgroup (s := ρ.ker)).symm

theorem wc_proet_pullback_self_noetherian : ∀ (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U), IsFinite p.left → AlgebraicGeometry.IsNoetherian Ω.left → TopologicalSpace.NoetherianSpace ↥(Limits.pullback p p).left :=
by
  intro S U Ω p hfin hN
  haveI := hfin
  haveI := hN
  have h : ↥(Limits.pullback p p).left ≃ₜ ↥(Limits.pullback p.left p.left) :=
    Scheme.homeoOfIso (Limits.PreservesPullback.iso (Scheme.ProEt.forget S ⋙ Over.forget S) p p)
  haveI : IsLocallyNoetherian (Limits.pullback p.left p.left) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.fst p.left p.left)
  haveI : CompactSpace ↥(Limits.pullback p.left p.left) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst p.left p.left)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback p.left p.left) :=
    AlgebraicGeometry.IsNoetherian.mk
  exact (TopologicalSpace.noetherianSpace_iff_of_homeomorph h).mpr inferInstance

theorem wc_P1bar_open_finite_noetherian_sep (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens) (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) (hfin : IsFinite πE) : AlgebraicGeometry.IsNoetherian E ∧ IsSeparated (Limits.terminal.from E) :=
by
  haveI := hfin
  have hprop : ∀ (K : Type u) [Field K] (n : ℕ), IsProper (wcProjKStr K n) := by
    intro K _ n
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) K _
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
        (MvPolynomial (Fin (n+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
        (A := MvPolynomial (Fin (n+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
        (MvPolynomial (Fin (n+1)) K) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0 =>
          (x : MvPolynomial (Fin (n+1)) K)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (n+1)) K).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (n+1)) K).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (n+1)) K).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0))))
    infer_instance
  haveI : IsProper (wcP1Over F'').hom := hprop F'' 1
  let s : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶ Spec (.of (AlgebraicClosure F'')) :=
    Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
  haveI : IsProper s := by
    show IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    infer_instance
  haveI : IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    LocallyOfFiniteType.isLocallyNoetherian s
  haveI : CompactSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    QuasiCompact.compactSpace_of_compactSpace s
  haveI : AlgebraicGeometry.IsNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI hNS : TopologicalSpace.NoetherianSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    inferInstance
  haveI : CompactSpace Ub.toScheme := by
    have h : IsCompact (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) :=
      TopologicalSpace.NoetherianSpace.isCompact _
    exact isCompact_iff_compactSpace.mp h
  haveI : IsLocallyNoetherian Ub.toScheme := inferInstance
  haveI : IsLocallyNoetherian E := LocallyOfFiniteType.isLocallyNoetherian πE
  haveI : CompactSpace E := QuasiCompact.compactSpace_of_compactSpace πE
  refine ⟨AlgebraicGeometry.IsNoetherian.mk, ?_⟩
  rw [Limits.terminal.hom_ext (Limits.terminal.from E)
    (πE ≫ Ub.ι ≫ s ≫ Limits.terminal.from (Spec (.of (AlgebraicClosure F''))))]
  infer_instance

theorem wc_hfe_P1bar_basic (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S' : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS' : ∀ i, S' i ≫ (wcP1Over F'').hom = 𝟙 _)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
      ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S' i (IsLocalRing.closedPoint F'')) :
    IsAffineHom Ub.ι ∧ IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left ∧
      IrreducibleSpace (wcGeomPoint F'' (wcP1Over F'') hP).left ∧
      (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left).Nonempty :=
by
  classical

  have pid_aff : ∀ (X : Scheme.{u}) (U W : X.Opens) (R : Type u) [CommRing R]
      [IsPrincipalIdealRing R] (_ : U.toScheme ≅ Spec (.of R)), IsAffineOpen (U ⊓ W) := by
    intro X U W R _ _ φ
    set V' : U.toScheme.Opens := U.ι ⁻¹ᵁ W with hV'
    set T : (Spec (.of R)).Opens := φ.inv ⁻¹ᵁ V' with hT
    have hTc : IsClosed ((T : Set (Spec (.of R)))ᶜ) := T.isOpen.isClosed_compl
    obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal (R := R) _).mp hTc
    set g := Submodule.IsPrincipal.generator I with hgdef
    have hTb : T = PrimeSpectrum.basicOpen g := by
      apply TopologicalSpace.Opens.ext
      ext p
      have h1 : p ∈ ((T : Set (Spec (.of R))))ᶜ ↔ p ∈ PrimeSpectrum.zeroLocus (I : Set R) :=
        Iff.of_eq (congrArg (fun S => p ∈ S) hI)
      have h2 : p ∈ PrimeSpectrum.zeroLocus (I : Set R) ↔
          p ∈ PrimeSpectrum.zeroLocus ({g} : Set R) := by
        rw [← PrimeSpectrum.zeroLocus_span ({g} : Set R), hgdef, Ideal.span_singleton_generator]
      have h3 : p ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum R)) ↔
          p ∉ PrimeSpectrum.zeroLocus ({g} : Set R) := by
        rw [PrimeSpectrum.basicOpen_eq_zeroLocus_compl]
        exact Iff.rfl
      constructor
      · intro hp
        exact h3.mpr (fun hz => (h1.mpr (h2.mpr hz)) hp)
      · intro hp
        by_contra hn
        exact h3.mp hp (h2.mp (h1.mp hn))
    have hTa : IsAffineOpen T := by
      rw [hTb]; exact IsAffineOpen.Spec_basicOpen (R := CommRingCat.of R) _
    have hV'a : IsAffineOpen V' := by
      have := hTa.preimage_of_isIso φ.hom
      rwa [hT, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage] at this
    have := hV'a.image_of_isOpenImmersion U.ι
    rwa [hV', Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at this

  have charts : ∀ x : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      ∃ U : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens, x ∈ U ∧
        Nonempty (U.toScheme ≅ Spec (.of (Polynomial (AlgebraicClosure F'')))) := by
    intro x
    obtain ⟨e0, he0, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') 1
    let e : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
        @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
          MvPolynomial.gradedAlgebra := e0
    haveI : IsIso e := he0
    have hY : (⨆ j : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : e x ∈ (⨆ j : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨c, -⟩ := wc_projK_one_affine_chart (AlgebraicClosure F'') j
    refine ⟨e ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra (MvPolynomial.X j)), (Scheme.Hom.mem_preimage e).mpr hj,
      ⟨Scheme.Hom.preimageIso e _ ≪≫ c⟩⟩

  have hA : IsAffineHom Ub.ι := by
    apply isAffineHom_of_forall_exists_isAffineOpen
    intro x
    obtain ⟨U, hxU, ⟨φ⟩⟩ := charts x
    refine ⟨U, hxU, ?_, ?_⟩
    · have := pid_aff _ U ⊤ _ φ
      rwa [inf_top_eq] at this
    · rw [← Scheme.Hom.isAffineOpen_iff_of_isOpenImmersion Ub.ι,
        Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι, inf_comm]
      exact pid_aff _ U Ub _ φ

  have hB : IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left := by
    have s2 : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (P : Scheme.{u})
        (p : P ⟶ Spec (.of K)) [IsProper p],
        IsLocallyNoetherian (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap K L)))) := by
      intro K L _ _ _ P p _
      exact LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd p _)
    haveI hpr : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
    exact s2 F'' (AlgebraicClosure F'') _ (wcP1Over F'').hom

  have hC : IrreducibleSpace (wcGeomPoint F'' (wcP1Over F'') hP).left := by
    obtain ⟨hInt, -⟩ := wc_P1bar_facts F'' hP
    haveI := hInt
    exact irreducibleSpace_of_isIntegral _

  have hD : (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left).Nonempty := by
    obtain ⟨Ub', hUb', hconn, -, -, -⟩ := wc_P1bar_smooth_locus F'' hP m S' hS'
    have hEq : Ub' = Ub :=
      TopologicalSpace.Opens.ext (Set.ext fun p => (hUb' p).trans (hUb p).symm)
    subst hEq
    haveI := hconn
    obtain ⟨y⟩ : Nonempty Ub'.toScheme := ConnectedSpace.toNonempty
    exact ⟨y.1, y.2⟩
  exact ⟨hA, hB, hC, hD⟩

theorem wc_P1bar_fet_open_etcoh_h1_finite (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens) (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔ ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S i (IsLocalRing.closedPoint F'')) (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) (hfin : IsFinite πE) (het : Etale πE) (hsurj : Surjective πE) (hconn : ConnectedSpace E) : Finite (wcEtCoh E ℓ 1) :=
by
  classical
  haveI := hfin
  haveI := het
  have hℓp : ℓ.Prime := Fact.out

  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro h0
    have h0' : ((ℓ : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]
      exact h0
    haveI := ringChar.charP F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ := (CharP.cast_eq_zero_iff F'' (ringChar F'') ℓ).mp h0'
    rcases hℓp.eq_one_or_self_of_dvd _ h1 with h | h
    · exact hp.one_lt.ne' h
    · letI := Fintype.ofFinite F''
      have h2 : ringChar F'' ∣ Fintype.card F'' :=
        (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp (FiniteField.cast_card_eq_zero F'')
      apply hℓ
      rw [Nat.card_eq_fintype_card, ← h]
      exact h2

  haveI : SmoothOfRelativeDimension 1 (wcP1Over F'').hom := wc_p1_smooth_reldim_one F''
  haveI : Smooth (wcP1Over F'').hom := SmoothOfRelativeDimension.smooth 1 _
  have hsnd : Smooth (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  have hgsm : Smooth (πE ≫ Ub.ι ≫ Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
    have h1 : Smooth πE := inferInstance
    have h2 : Smooth Ub.ι := inferInstance
    exact MorphismProperty.comp_mem @Smooth _ _ h1 (MorphismProperty.comp_mem @Smooth _ _ h2 hsnd)
  haveI : IrreducibleSpace E :=
    @wc_smooth_algclosed_connected_irreducible (AlgebraicClosure F'') _ _ E _ hgsm hconn

  have key : ∀ (X : Scheme.{u}) [IsAffine X]
      (h : X ⟶ Spec (.of (Polynomial (AlgebraicClosure F'')))), Etale h →
      Finite (wcEtCoh X ℓ 1) := by
    intro X _ h hh
    haveI := hh
    let h' : Spec Γ(X, ⊤) ⟶ Spec (.of (Polynomial (AlgebraicClosure F''))) := X.isoSpec.inv ≫ h
    have hφ : Spec.map (Spec.preimage h') = h' := Spec.map_preimage h'
    have hφet : RingHom.Etale (Spec.preimage h').hom := by
      have : Etale (Spec.map (Spec.preimage h')) := by
        rw [hφ]
        infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
    letI : Algebra (Polynomial (AlgebraicClosure F'')) Γ(X, ⊤) := (Spec.preimage h').hom.toAlgebra
    letI : Algebra (AlgebraicClosure F'') Γ(X, ⊤) :=
      ((Spec.preimage h').hom.comp Polynomial.C).toAlgebra
    haveI : IsScalarTower (AlgebraicClosure F'') (Polynomial (AlgebraicClosure F'')) Γ(X, ⊤) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.Etale (Polynomial (AlgebraicClosure F'')) Γ(X, ⊤) := hφet
    obtain ⟨Y, fY, j, -, hprop, hsm, -, hj, -, hcof, -, -⟩ :=
      wc_etale_A1_curve_compactification_pair (AlgebraicClosure F'') (AlgebraicClosure F'')
        Γ(X, ⊤)
    haveI := hprop
    haveI := hsm
    haveI := hj
    haveI h1 : Finite (wcEtCoh (Spec (.of Γ(X, ⊤))) ℓ 1) :=
      (wc_curve_open_gysin_h1_card (AlgebraicClosure F'') ℓ hℓp hℓK Y fY _ j hcof).1
    obtain ⟨eqv⟩ := wc_et_coh_iso_invariance X.isoSpec.hom ℓ 1
    exact Finite.of_equiv (wcEtCoh (Spec (.of Γ(X, ⊤))) ℓ 1) eqv

  obtain ⟨e0, he0, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') 1
  obtain ⟨e, he⟩ : ∃ e : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      wcProjK (AlgebraicClosure F'') 1, IsIso e := ⟨e0, he0⟩
  haveI := he
  haveI := (wc_hfe_P1bar_basic F'' hP m S hS Ub hUb).1
  let f := πE ≫ Ub.ι ≫ e
  haveI : IsAffineHom (Ub.ι ≫ e) := inferInstance
  haveI : Etale (Ub.ι ≫ e) := inferInstance
  haveI hfaff : IsAffineHom f := by
    dsimp only [f]
    infer_instance
  haveI hfet : Etale f := by
    dsimp only [f]
    infer_instance
  choose κ _ using wc_projK_one_affine_chart (AlgebraicClosure F'')
  let C : Fin (1 + 1) → (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1))
      (AlgebraicClosure F'')) MvPolynomial.gradedAlgebra).Opens := fun a =>
    @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1))
      (AlgebraicClosure F'')) MvPolynomial.gradedAlgebra (MvPolynomial.X a)
  have hCaff : ∀ a, IsAffineOpen (C a) := fun a => IsAffine.of_isIso (κ a).hom
  have hAaff : ∀ a, IsAffineOpen (f ⁻¹ᵁ C a) := fun a => (hCaff a).preimage f
  have hfinC : ∀ a, Finite (wcEtCoh (f ⁻¹ᵁ C a).toScheme ℓ 1) := by
    intro a
    haveI : IsAffine (f ⁻¹ᵁ C a).toScheme := hAaff a
    exact key _ ((f ∣_ C a) ≫ (κ a).hom) inferInstance
  have hcov : (⨆ a : Fin (1 + 1), C a) = ⊤ := wc_pp_basicOpen_cover (AlgebraicClosure F'') 1
  have hAB : f ⁻¹ᵁ C 0 ⊔ f ⁻¹ᵁ C 1 = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ f ⁻¹ᵁ (⨆ a : Fin (1 + 1), C a) := by
      rw [hcov, Scheme.Hom.preimage_top]
      trivial
    rw [Scheme.Hom.preimage_iSup, TopologicalSpace.Opens.mem_iSup] at hx
    obtain ⟨a, ha⟩ := hx
    fin_cases a
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl ha)
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr ha)

  have hW : Finite (wcEtCoh ((f ⁻¹ᵁ C 0 ⊓ f ⁻¹ᵁ C 1 : E.Opens) : Scheme.{u}) ℓ 0) := by
    by_cases hne : ((f ⁻¹ᵁ C 0 ⊓ f ⁻¹ᵁ C 1 : E.Opens) : Set E).Nonempty
    · have hirr : IsIrreducible ((f ⁻¹ᵁ C 0 ⊓ f ⁻¹ᵁ C 1 : E.Opens) : Set E) :=
        ⟨hne, (IrreducibleSpace.isIrreducible_univ E).isPreirreducible.open_subset
          (f ⁻¹ᵁ C 0 ⊓ f ⁻¹ᵁ C 1).isOpen (Set.subset_univ _)⟩
      haveI : IrreducibleSpace (f ⁻¹ᵁ C 0 ⊓ f ⁻¹ᵁ C 1 : E.Opens).toScheme :=
        Subtype.irreducibleSpace hirr
      exact (wc_et_coh_zero_irreducible_card_le _ ℓ hℓp.ne_zero).1
    · have : IsEmpty ((f ⁻¹ᵁ C 0 ⊓ f ⁻¹ᵁ C 1 : E.Opens) : Set E) :=
        Set.isEmpty_coe_sort.mpr (Set.not_nonempty_iff_eq_empty.mp hne)
      exact wc_et_coh_empty_finite _ this ℓ 0
  haveI hMV : Finite (wcEtCoh ((⊤ : E.Opens) : Scheme.{u}) ℓ 1) :=
    (wc_et_zariski_mv_card_le E ⊤ (f ⁻¹ᵁ C 0) (f ⁻¹ᵁ C 1) hAB ℓ 0 hW (hfinC 0) (hfinC 1)).1
  obtain ⟨eqv⟩ := wc_et_coh_iso_invariance E.topIso.hom ℓ 1
  exact Finite.of_equiv _ eqv.symm

theorem wc_proet_ext1_finite_zmod_pi : ∀ (Y : Scheme.{u}) (X : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)], Finite (Abelian.Ext X (wcContSheaf Y (ZMod ℓ)) 1) → ∀ (r k : ℕ), Finite (Abelian.Ext X (wcContSheaf Y (Fin k → ZMod (ℓ ^ r))) 1) :=
by
  classical
  intro Y X ℓ _ h
  have hℓ0 : 0 < ℓ := (Fact.out : ℓ.Prime).pos

  have gen : ∀ (S : ShortComplex (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})),
      S.ShortExact → Finite (Abelian.Ext X S.X₁ 1) → Finite (Abelian.Ext X S.X₃ 1) →
      Finite (Abelian.Ext X S.X₂ 1) := by
    intro S hS h1 h3
    let ψ := (Abelian.Ext.mk₀ S.g).postcomp X (add_zero 1)
    let φ := (Abelian.Ext.mk₀ S.f).postcomp X (add_zero 1)
    have hex : ∀ y, ψ y = 0 → ∃ a, φ a = y := fun y hy =>
      Abelian.Ext.covariant_sequence_exact₂ X hS y hy
    let s : ψ.range → Abelian.Ext X S.X₂ 1 := fun ρ =>
      Classical.choose (AddMonoidHom.mem_range.mp ρ.2)
    have hs : ∀ ρ, ψ (s ρ) = ρ := fun ρ => Classical.choose_spec (AddMonoidHom.mem_range.mp ρ.2)
    haveI : Finite ψ.range := Subtype.finite
    refine Finite.of_surjective (fun p : Abelian.Ext X S.X₁ 1 × ψ.range => φ p.1 + s p.2) ?_
    intro y
    obtain ⟨a, ha⟩ := hex (y - s ⟨ψ y, y, rfl⟩) (by rw [map_sub, hs]; exact sub_self _)
    exact ⟨(a, ⟨ψ y, y, rfl⟩), by simp only [ha, sub_add_cancel]⟩

  have s1 : ∀ (A B C : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
      [IsTopologicalAddGroup A] [Finite A] [AddCommGroup B] [TopologicalSpace B] [DiscreteTopology B]
      [IsTopologicalAddGroup B] [AddCommGroup C] [TopologicalSpace C] [DiscreteTopology C]
      [IsTopologicalAddGroup C] (φ : A →+ B) (ψ : B →+ C), Function.Injective φ →
      (∀ b : B, ψ b = 0 ↔ ∃ a : A, φ a = b) → Function.Surjective ψ →
      Finite (Abelian.Ext X (wcContSheaf Y A) 1) → Finite (Abelian.Ext X (wcContSheaf Y C) 1) →
      Finite (Abelian.Ext X (wcContSheaf Y B) 1) := by
    intro A B C _ _ _ _ _ _ _ _ _ _ _ _ _ φ ψ hinj hex hsurj hA hC
    have hφc : Continuous φ := continuous_of_discreteTopology
    have hψc : Continuous ψ := continuous_of_discreteTopology
    have hemb : Topology.IsEmbedding φ := (hφc.isClosedEmbedding hinj).isEmbedding
    obtain ⟨hzero, hSE⟩ := wc_contSheaf_shortExact Y φ hφc ψ hψc hemb hex
      ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
    exact gen _ hSE hA hC

  have s2 : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [Subsingleton A], Subsingleton (Abelian.Ext X (wcContSheaf Y A) 1) := by
    intro A _ _ _ _
    have hid : 𝟙 (wcContSheaf Y A) = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext T
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      apply Subsingleton.elim
    constructor
    intro a b
    have key : ∀ x : Abelian.Ext X (wcContSheaf Y A) 1, x = 0 := by
      intro x
      rw [← Abelian.Ext.comp_mk₀_id x, hid, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    rw [key a, key b]

  have s3 : ∀ r : ℕ, ∃ (φ : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1))) (ψ : ZMod (ℓ ^ (r + 1)) →+ ZMod ℓ),
      Function.Injective φ ∧ (∀ b, ψ b = 0 ↔ ∃ a, φ a = b) ∧ Function.Surjective ψ := by
    intro r
    haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero _ hℓ0.ne'⟩
    haveI : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero _ hℓ0.ne'⟩
    let f : ℤ →+ ZMod (ℓ ^ (r + 1)) :=
      (Int.castAddHom (ZMod (ℓ ^ (r + 1)))).comp (AddMonoidHom.mulLeft (ℓ : ℤ))
    have hfv : ∀ x : ℤ, f x = (((ℓ : ℤ) * x : ℤ) : ZMod (ℓ ^ (r + 1))) := fun x => rfl
    have hf : f ((ℓ ^ r : ℕ) : ℤ) = 0 := by
      rw [hfv]
      have h1 : ((ℓ : ℤ) * ((ℓ ^ r : ℕ) : ℤ)) = ((ℓ ^ (r + 1) : ℕ) : ℤ) := by push_cast; ring
      rw [h1, Int.cast_natCast, ZMod.natCast_self]
    let φ : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1)) := ZMod.lift (ℓ ^ r) ⟨f, hf⟩
    have hF : ∀ n : ℕ, φ (n : ZMod (ℓ ^ r)) = ((ℓ * n : ℕ) : ZMod (ℓ ^ (r + 1))) := by
      intro n
      have h2 := ZMod.lift_coe (ℓ ^ r) ⟨f, hf⟩ (n : ℤ)
      rw [Int.cast_natCast] at h2
      rw [h2]
      show f (n : ℤ) = _
      rw [hfv]
      push_cast
      ring
    have hdvd : ℓ ∣ ℓ ^ (r + 1) := dvd_pow_self ℓ (Nat.succ_ne_zero r)
    let ψ : ZMod (ℓ ^ (r + 1)) →+ ZMod ℓ := (ZMod.castHom hdvd (ZMod ℓ)).toAddMonoidHom
    have hG : ∀ n : ℕ, ψ (n : ZMod (ℓ ^ (r + 1))) = (n : ZMod ℓ) := by
      intro n
      show (ZMod.castHom hdvd (ZMod ℓ)) (n : ZMod (ℓ ^ (r + 1))) = _
      exact map_natCast _ n
    have hN' : ℓ ^ (r + 1) = ℓ * ℓ ^ r := pow_succ' ℓ r
    refine ⟨φ, ψ, ?_, ?_, ZMod.castHom_surjective hdvd⟩
    · rw [injective_iff_map_eq_zero]
      intro a ha
      rw [← ZMod.natCast_zmod_val a, hF, ZMod.natCast_eq_zero_iff, hN'] at ha
      have h3 : ℓ ^ r ∣ a.val := Nat.dvd_of_mul_dvd_mul_left hℓ0 ha
      have h4 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt h3 (ZMod.val_lt a)
      rw [← ZMod.natCast_zmod_val a, h4, Nat.cast_zero]
    · intro b
      constructor
      · intro hb
        rw [← ZMod.natCast_zmod_val b, hG, ZMod.natCast_eq_zero_iff] at hb
        obtain ⟨q, hq⟩ := hb
        have hlt : b.val < ℓ ^ (r + 1) := ZMod.val_lt b
        rw [hq, hN'] at hlt
        refine ⟨(q : ZMod (ℓ ^ r)), ?_⟩
        rw [hF, ← hq, ZMod.natCast_zmod_val]
      · rintro ⟨a, rfl⟩
        rw [← ZMod.natCast_zmod_val a, hF, hG, ZMod.natCast_eq_zero_iff]
        exact Dvd.intro _ rfl

  have s4 : ∀ (M : Type) [AddCommGroup M] (k : ℕ), ∃ (φ : M →+ (Fin (k + 1) → M))
      (ψ : (Fin (k + 1) → M) →+ (Fin k → M)),
      Function.Injective φ ∧ (∀ b, ψ b = 0 ↔ ∃ a, φ a = b) ∧ Function.Surjective ψ := by
    intro M _ k
    let φ : M →+ (Fin (k + 1) → M) := AddMonoidHom.single (fun _ : Fin (k + 1) => M) 0
    let ψ : (Fin (k + 1) → M) →+ (Fin k → M) :=
      AddMonoidHom.pi (fun i : Fin k => Pi.evalAddMonoidHom (fun _ : Fin (k + 1) => M) i.succ)
    have hφ : ∀ a, φ a = Pi.single 0 a := fun a => rfl
    have hψ : ∀ b i, ψ b i = b i.succ := fun b i => rfl
    refine ⟨φ, ψ, ?_, ?_, ?_⟩
    · intro a b hab
      rw [hφ, hφ] at hab
      exact Pi.single_injective 0 hab
    · intro b
      constructor
      · intro hb
        refine ⟨b 0, ?_⟩
        rw [hφ]
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp
        · rw [Pi.single_eq_of_ne (Fin.succ_ne_zero j)]
          have := congrFun hb j
          rw [hψ] at this
          exact this.symm
      · rintro ⟨a, rfl⟩
        funext j
        rw [hψ, hφ, Pi.single_eq_of_ne (Fin.succ_ne_zero j)]
        rfl
    · intro c
      refine ⟨Fin.cons 0 c, ?_⟩
      funext j
      rw [hψ, Fin.cons_succ]

  have R : ∀ r : ℕ, Finite (Abelian.Ext X (wcContSheaf Y (ZMod (ℓ ^ r))) 1) := by
    intro r
    induction r with
    | zero =>
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
      haveI := s2 (ZMod (ℓ ^ 0))
      exact Finite.of_subsingleton
    | succ r ih =>
      haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero _ hℓ0.ne'⟩
      obtain ⟨φ, ψ, hi, he, hs⟩ := s3 r
      exact s1 _ _ _ φ ψ hi he hs ih h
  intro r k
  haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero _ hℓ0.ne'⟩
  induction k with
  | zero =>
    haveI : Subsingleton (Fin 0 → ZMod (ℓ ^ r)) := inferInstance
    haveI := s2 (Fin 0 → ZMod (ℓ ^ r))
    exact Finite.of_subsingleton
  | succ k ih =>
    obtain ⟨φ, ψ, hi, he, hs⟩ := s4 (ZMod (ℓ ^ r)) k
    exact s1 _ _ _ φ ψ hi he hs (R r) ih

