        (ShortComplex.mk ι red w).ShortExact := by
    intro C _ _ Z a b n habn hb
    have key : (a • 𝟙 Z) ≫ (b • 𝟙 Z) = n • 𝟙 Z := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, ← mul_nsmul', habn]
    have cond : ∀ k : ℕ, (k • 𝟙 Z) ≫ Limits.cokernel.π (k • 𝟙 Z) = 0 :=
      fun k => Limits.cokernel.condition _
    let ι : Limits.cokernel (a • 𝟙 Z) ⟶ Limits.cokernel (n • 𝟙 Z) :=
      Limits.cokernel.desc (a • 𝟙 Z) ((b • 𝟙 Z) ≫ Limits.cokernel.π (n • 𝟙 Z))
        (by rw [← Category.assoc, key, cond])
    let red : Limits.cokernel (n • 𝟙 Z) ⟶ Limits.cokernel (b • 𝟙 Z) :=
      Limits.cokernel.desc (n • 𝟙 Z) (Limits.cokernel.π (b • 𝟙 Z))
        (by rw [← key, Category.assoc, cond, Limits.comp_zero])
    have hι : Limits.cokernel.π (a • 𝟙 Z) ≫ ι = b • Limits.cokernel.π (n • 𝟙 Z) := by
      simp only [ι, Limits.cokernel.π_desc, Preadditive.nsmul_comp, Category.id_comp]
    have hred : Limits.cokernel.π (n • 𝟙 Z) ≫ red = Limits.cokernel.π (b • 𝟙 Z) := by
      simp only [red, Limits.cokernel.π_desc]
    have w : ι ≫ red = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (a • 𝟙 Z)), ← Category.assoc, hι, Limits.comp_zero,
        Preadditive.nsmul_comp, hred]
      have := cond b
      rw [Preadditive.nsmul_comp, Category.id_comp] at this
      exact this
    refine ⟨ι, red, w, hι, hred, ?_⟩
    haveI : Epi red := epi_of_epi_fac hred
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro T g hg
      obtain ⟨T₁, p₁, hp₁, z, hz⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (a • 𝟙 Z)) g
      have h1 : (z ≫ (b • 𝟙 Z)) ≫ Limits.cokernel.π (n • 𝟙 Z) = 0 := by
        have : z ≫ Limits.cokernel.π (a • 𝟙 Z) ≫ ι = p₁ ≫ g ≫ ι := by
          rw [← Category.assoc, ← hz, Category.assoc]
        rw [hg, Limits.comp_zero] at this
        rw [Category.assoc, ← this]
        simp only [ι, Limits.cokernel.π_desc]
      obtain ⟨T₂, p₂, hp₂, w', hw'⟩ :=
        (ShortComplex.exact_cokernel (n • 𝟙 Z)).exact_up_to_refinements (z ≫ (b • 𝟙 Z)) h1
      have h2 : p₂ ≫ z = w' ≫ (a • 𝟙 Z) := by
        rw [← cancel_mono (b • 𝟙 Z), Category.assoc, Category.assoc, key]
        exact hw'
      have h3 : (p₂ ≫ p₁) ≫ g = 0 := by
        rw [Category.assoc, hz, ← Category.assoc, h2, Category.assoc, cond, Limits.comp_zero]
      haveI := hp₁
      haveI := hp₂
      rw [← cancel_epi (p₂ ≫ p₁), h3, Limits.comp_zero]
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro T x₂ hx₂
    obtain ⟨T₁, p₁, hp₁, z, hz⟩ :=
      surjective_up_to_refinements_of_epi (Limits.cokernel.π (n • 𝟙 Z)) x₂
    have h1 : z ≫ Limits.cokernel.π (b • 𝟙 Z) = 0 := by
      have : z ≫ Limits.cokernel.π (n • 𝟙 Z) ≫ red = p₁ ≫ x₂ ≫ red := by
        rw [← Category.assoc, ← hz, Category.assoc]
      dsimp at hx₂
      rw [hx₂, Limits.comp_zero, hred] at this
      exact this
    obtain ⟨T₂, p₂, hp₂, w', hw'⟩ :=
      (ShortComplex.exact_cokernel (b • 𝟙 Z)).exact_up_to_refinements z h1
    haveI := hp₁
    haveI := hp₂
    refine ⟨T₂, p₂ ≫ p₁, inferInstance, w' ≫ Limits.cokernel.π (a • 𝟙 Z), ?_⟩
    dsimp
    rw [Category.assoc, hz, ← Category.assoc, hw', Category.assoc, Category.assoc, hι,
      Preadditive.nsmul_comp, Category.id_comp]

  have core : ∀ {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasExt C]
      (Z Y' : C) (eQ : Limits.cokernel (ℓ • 𝟙 Z) ≅ Y'),
      (∀ k : ℕ, 0 < k → Mono (k • 𝟙 Z)) →
      (Finite (Abelian.Ext Z Y' 2) ∧ Nat.card (Abelian.Ext Z Y' 2) ≤ ℓ ∧
        ∀ x : Abelian.Ext Z Y' 3, x = 0) →
      ∀ r : ℕ, ∃ η : Abelian.Ext Z (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 Z)) 2,
        ∀ y : Abelian.Ext Z (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 Z)) 2, ∃ n : ℤ, y = n • η := by
    intro C _ _ _ Z Y' eQ hmono h7 r
    obtain ⟨hfin7, hcard7, hvan7⟩ := h7
    have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
    have T1 : ∀ {X Y Y₁ : C} {m : ℕ} (y : Abelian.Ext X Y m) (f : Y ⟶ Y₁) (k : ℕ),
        y.comp (Abelian.Ext.mk₀ (k • f)) (add_zero m) =
          k • y.comp (Abelian.Ext.mk₀ f) (add_zero m) := by
      intro X Y Y₁ m y f k
      induction k with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih]
    have T2 : ∀ (W : C) (k : ℕ), k • 𝟙 (Limits.cokernel (k • 𝟙 W)) = 0 := by
      intro W k
      rw [← cancel_epi (Limits.cokernel.π (k • 𝟙 W)), Preadditive.comp_nsmul, Category.comp_id,
        Limits.comp_zero]
      have h0 := Limits.cokernel.condition (k • 𝟙 W)
      rw [Preadditive.nsmul_comp, Category.id_comp] at h0
      exact h0
    have T3 : ∀ {X Y : C} {m : ℕ} (k : ℕ), k • 𝟙 Y = 0 → ∀ y : Abelian.Ext X Y m, k • y = 0 := by
      intro X Y m k hk y
      calc k • y = k • y.comp (Abelian.Ext.mk₀ (𝟙 Y)) (add_zero m) := by
            rw [Abelian.Ext.comp_mk₀_id]
        _ = y.comp (Abelian.Ext.mk₀ (k • 𝟙 Y)) (add_zero m) := (T1 y (𝟙 Y) k).symm
        _ = 0 := by rw [hk, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have transfer : ∀ m : ℕ, Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) m ≃ Abelian.Ext Z Y' m :=
      fun m =>
        { toFun := fun x => x.comp (Abelian.Ext.mk₀ eQ.hom) (add_zero m)
          invFun := fun x => x.comp (Abelian.Ext.mk₀ eQ.inv) (add_zero m)
          left_inv := fun x => by
            dsimp only
            rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, eQ.hom_inv_id,
              Abelian.Ext.comp_mk₀_id]
          right_inv := fun x => by
            dsimp only
            rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, eQ.inv_hom_id,
              Abelian.Ext.comp_mk₀_id] }
    haveI : Finite (Abelian.Ext Z Y' 2) := hfin7
    haveI hGfin : Finite (Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) 2) :=
      Finite.of_equiv _ (transfer 2).symm
    have hGcard : Nat.card (Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) 2) ≤ ℓ := by
      rw [Nat.card_congr (transfer 2)]; exact hcard7
    have hvan : ∀ x : Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) 3, x = 0 := by
      intro x
      apply (transfer 3).injective
      rw [hvan7 ((transfer 3) x), hvan7 ((transfer 3) 0)]
    have hGl : ∀ g : Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) 2, ℓ • g = 0 :=
      T3 ℓ (T2 Z ℓ)
    cases r with
    | zero =>
      refine ⟨0, fun y => ⟨0, ?_⟩⟩
      rw [zero_smul]
      have h1 : (1 : ℕ) • 𝟙 (Limits.cokernel ((ℓ ^ 0 : ℕ) • 𝟙 Z)) = 0 := by
        haveI : Epi ((ℓ ^ 0 : ℕ) • 𝟙 Z) := by
          rw [pow_zero, one_smul]; infer_instance
        exact (Limits.isZero_cokernel_of_epi _).eq_of_src _ _
      have := T3 1 h1 y
      rwa [one_smul] at this
    | succ s =>
      have hHN : ∀ h : Abelian.Ext Z (Limits.cokernel ((ℓ ^ (s + 1) : ℕ) • 𝟙 Z)) 2,
          ℓ ^ (s + 1) • h = 0 := T3 (ℓ ^ (s + 1)) (T2 Z (ℓ ^ (s + 1)))
      obtain ⟨ι, red, w, hι, hred, hS1⟩ := s5 Z (ℓ ^ s) ℓ (ℓ ^ (s + 1))
        (pow_succ ℓ s).symm (hmono ℓ hℓpos)
      obtain ⟨ι', red', w', hι', hred', hS2⟩ := s5 Z ℓ (ℓ ^ s) (ℓ ^ (s + 1))
        (pow_succ' ℓ s).symm (hmono (ℓ ^ s) (pow_pos hℓpos s))
      have hcomp : red' ≫ ι = ℓ • 𝟙 _ := by
        rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ (s + 1) : ℕ) • 𝟙 Z)), ← Category.assoc, hred',
          hι, Preadditive.comp_nsmul, Category.comp_id]
      let ρ : Abelian.Ext Z (Limits.cokernel ((ℓ ^ (s + 1) : ℕ) • 𝟙 Z)) 2 →+
          Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) 2 :=
        (Abelian.Ext.mk₀ red).postcomp Z (add_zero 2)
      have hker : ∀ y, ρ y = 0 → ∃ y', y = ℓ • y' := by
        intro y hy
        obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₂ Z hS1 y hy
        have hx2 : x.comp (Abelian.Ext.mk₀ ι) (add_zero 2) = y := hx
        have h3 : x.comp hS2.extClass (show 2 + 1 = 3 from rfl) = 0 := hvan _
        obtain ⟨x', hx'⟩ :=
          Abelian.Ext.covariant_sequence_exact₃ Z hS2 x (show 2 + 1 = 3 from rfl) h3
        have hx'2 : x'.comp (Abelian.Ext.mk₀ red') (add_zero 2) = x := hx'
        refine ⟨x', ?_⟩
        rw [← hx2, ← hx'2, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          hcomp, T1, Abelian.Ext.comp_mk₀_id]
      have ha : ∃ η, ∀ w, ∃ k : ℤ, ρ w = k • ρ η := by
        by_cases h0 : ∀ w, ρ w = 0
        · exact ⟨0, fun w => ⟨0, by rw [h0 w, zero_smul]⟩⟩
        · push_neg at h0
          obtain ⟨η, hη⟩ := h0
          refine ⟨η, fun w => ?_⟩
          have hord : addOrderOf (ρ η) = ℓ := addOrderOf_eq_prime (hGl _) hη
          have hcard : Nat.card (AddSubgroup.zmultiples (ρ η)) =
              Nat.card (Abelian.Ext Z (Limits.cokernel (ℓ • 𝟙 Z)) 2) := by
            apply le_antisymm
            · exact Nat.card_le_card_of_injective _ Subtype.coe_injective
            · rw [Nat.card_zmultiples, hord]; exact hGcard
          have htop := AddSubgroup.eq_top_of_card_eq _ hcard
          have hmem : ρ w ∈ AddSubgroup.zmultiples (ρ η) := by
            rw [htop]; exact AddSubgroup.mem_top _
          obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
          exact ⟨k, hk.symm⟩
      obtain ⟨η, hη⟩ := ha
      have hb : ∀ j : ℕ, ∀ y, ∃ (n : ℤ)
          (w : Abelian.Ext Z (Limits.cokernel ((ℓ ^ (s + 1) : ℕ) • 𝟙 Z)) 2),
          y = n • η + ℓ ^ j • w := by
        intro j
        induction j with
        | zero => intro y; exact ⟨0, y, by rw [zero_smul, zero_add, pow_zero, one_smul]⟩
        | succ j ih =>
          intro y
          obtain ⟨n, w, hw⟩ := ih y
          obtain ⟨k, hk⟩ := hη w
          obtain ⟨w', hw'⟩ := hker (w - k • η) (by rw [map_sub, map_zsmul, hk, sub_self])
          have hw2 : w = k • η + ℓ • w' := sub_eq_iff_eq_add'.mp hw'
          refine ⟨n + ((ℓ ^ j : ℕ) : ℤ) * k, w', ?_⟩
          have e1 : ℓ ^ (j + 1) • w' = ℓ ^ j • ℓ • w' := by
            rw [pow_succ ℓ j, mul_smul]
          rw [hw, hw2, smul_add, add_smul, mul_smul, natCast_zsmul, e1, add_assoc]
      refine ⟨η, fun y => ?_⟩
      obtain ⟨n, w, hw⟩ := hb (s + 1) y
      exact ⟨n, by rw [hw, hHN w, add_zero]⟩

  have gen_free_terminal : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] (T : C), Limits.IsTerminal T →
      Nonempty ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
        (constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) := by
    intro C _ J _ T hT
    have hU : ∀ V : C, Unique (V ⟶ T) := fun V =>
      { default := hT.from V
        uniq := fun f => hT.hom_ext _ _ }
    let e : ∀ V : Cᵒᵖ, FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ T)) ≃+ ULift.{u+1} ℤ :=
      fun V => by
        letI := hU V.unop
        exact (FreeAbelianGroup.uniqueEquiv _).trans AddEquiv.ulift.symm
    have he : ∀ (V : Cᵒᵖ) (t : ULift.{u+1} (V.unop ⟶ T)),
        e V (FreeAbelianGroup.of t) = ULift.up 1 := by
      intro V t
      simp [e, FreeAbelianGroup.uniqueEquiv, AddEquiv.ulift] <;> rfl
    let η : (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
        (Functor.const Cᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) :=
      NatIso.ofComponents (fun V => (e V).toAddCommGrpIso) (by
        intro V W f
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro t
        change e W (FreeAbelianGroup.map
            (fun x : ULift.{u+1} (V.unop ⟶ T) =>
              (ULift.up (f.unop ≫ x.down) : ULift.{u+1} (W.unop ⟶ T)))
            (FreeAbelianGroup.of t)) = e V (FreeAbelianGroup.of t)
        exact (congrArg (e W) (FreeAbelianGroup.map_of_apply _)).trans
          ((he W _).trans (he V t).symm))
    exact ⟨(presheafToSheaf J AddCommGrpCat.{u+1}).mapIso η⟩
  have gen_zmod_coker : ∀ m : ℕ,
      Nonempty (Limits.cokernel (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≅
        AddCommGrpCat.of (ULift.{u+1} (ZMod m))) := by
    intro m
    let π0 : ULift.{u+1} ℤ →+ ULift.{u+1} (ZMod m) :=
      (AddEquiv.ulift.symm : ZMod m ≃+ ULift.{u+1} (ZMod m)).toAddMonoidHom.comp
        ((Int.castAddHom (ZMod m)).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
    have hπ0 : ∀ x : ULift.{u+1} ℤ, π0 x = ULift.up ((x.down : ℤ) : ZMod m) := fun x => rfl
    have hsurj : Function.Surjective π0 := by
      intro y
      obtain ⟨z, hz⟩ := ZMod.intCast_surjective y.down
      exact ⟨ULift.up z, by rw [hπ0]; exact congrArg ULift.up hz⟩
    have heq : (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ AddCommGrpCat.ofHom π0 = 0 := by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rw [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
        AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply, AddCommGrpCat.hom_nsmul,
        AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply, hπ0]
      apply ULift.ext
      show (((m • x).down : ℤ) : ZMod m) = 0
      have : (m • x).down = (m : ℤ) * x.down := by
        rw [show (m • x).down = m • x.down from rfl, nsmul_eq_mul]
      rw [this, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, zero_mul]
    have hgm : ∀ {Z' : AddCommGrpCat.{u+1}} (g' : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ Z'),
        (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g' = 0 →
        (g'.hom.comp (AddEquiv.ulift.symm : ℤ ≃+ ULift.{u+1} ℤ).toAddMonoidHom) (m : ℤ) = 0 := by
      intro Z' g' eq'
      have h := congrArg (fun φ => φ.hom (ULift.up (1 : ℤ))) eq'
      simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply,
        AddMonoidHom.comp_apply, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply,
        AddCommGrpCat.hom_id, AddMonoidHom.id_apply] at h
      rw [AddMonoidHom.comp_apply]
      refine Eq.trans ?_ h
      congr 1
      apply ULift.ext
      show (m : ℤ) = (m • (ULift.up (1 : ℤ) : ULift.{u+1} ℤ)).down
      rw [show (m • (ULift.up (1 : ℤ) : ULift.{u+1} ℤ)).down = m • (1 : ℤ) from rfl, nsmul_eq_mul,
        mul_one]
    let desc : {Z' : AddCommGrpCat.{u+1}} → (g' : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ Z') →
        (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g' = 0 →
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)) ⟶ Z') := fun {Z'} g' eq' =>
      AddCommGrpCat.ofHom ((ZMod.lift m ⟨g'.hom.comp
        (AddEquiv.ulift.symm : ℤ ≃+ ULift.{u+1} ℤ).toAddMonoidHom, hgm g' eq'⟩).comp
        (AddEquiv.ulift : ULift.{u+1} (ZMod m) ≃+ ZMod m).toAddMonoidHom)
    have hfac : ∀ {Z' : AddCommGrpCat.{u+1}} (g' : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ Z')
        (eq' : (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g' = 0),
        AddCommGrpCat.ofHom π0 ≫ desc g' eq' = g' := by
      intro Z' g' eq'
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rw [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
        AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply, hπ0]
      have : (AddEquiv.ulift : ULift.{u+1} (ZMod m) ≃+ ZMod m).toAddMonoidHom
          (ULift.up ((x.down : ℤ) : ZMod m)) = ((x.down : ℤ) : ZMod m) := rfl
      rw [this, ZMod.lift_coe]
      rfl
    have hc : Limits.IsColimit (Limits.CokernelCofork.ofπ (AddCommGrpCat.ofHom π0) heq) :=
      Limits.CokernelCofork.IsColimit.ofπ _ heq (fun g' eq' => desc g' eq')
        (fun g' eq' => hfac g' eq')
        (by
          intro Z' g' eq' m' hm'
          ext y
          obtain ⟨x, rfl⟩ := hsurj y
          have h1 := congrArg (fun φ => φ.hom x) hm'
          have h2 := congrArg (fun φ => φ.hom x) (hfac g' eq')
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
            AddCommGrpCat.hom_ofHom] at h1 h2
          rw [h1, h2])
    exact ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.colimit.isColimit _) hc⟩
  have gen_coker_const : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] (T : C), Limits.IsTerminal T → ∀ m : ℕ,
      Nonempty (Limits.cokernel (m • 𝟙 ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≅
        (constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) := by
    intro C _ J _ T hT m
    obtain ⟨e⟩ := gen_free_terminal J T hT
    obtain ⟨eA⟩ := gen_zmod_coker m
    let cst := constantSheaf J AddCommGrpCat.{u+1}
    haveI : Limits.PreservesColimitsOfSize.{0, 0} cst :=
      (constantSheafAdj J AddCommGrpCat.{u+1} hT).leftAdjoint_preservesColimits
    have h1 : (m • 𝟙 _) ≫ e.hom =
        e.hom ≫ (m • 𝟙 (cst.obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
