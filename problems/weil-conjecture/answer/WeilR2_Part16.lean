        intro R _ _ _ M hM
        letI : Algebra Ω R := ((algebraMap B R).comp (algebraMap Ω B)).toAlgebra
        haveI : IsScalarTower Ω B R := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        haveI := hM
