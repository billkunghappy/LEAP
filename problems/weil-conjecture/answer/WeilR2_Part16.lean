    HasExt.standard _

  haveI hτ : (wcOverToSlice S U).IsContinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) := by
    have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
