theorem wc_et_blowup_kernel_push_offcentre_lift : ∀ {Y X' Z : Scheme.{u}} (b : X' ⟶ Y) (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ {W : Scheme.{u}} (h : W ⟶ Y), Set.range h ⊆ (Set.range iZ)ᶜ → IsIso (Limits.pullback.fst h b)) → ∀ (m : ℕ) (D : wcEtPullData b m) (DZ : wcEtPullData iZ m) (DE : wcEtPullData (Limits.pullback.fst b iZ) m) (κ : Limits.kernel (wcEtSuppUnitMap DZ) ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj (Limits.kernel (wcEtSuppUnitMap DE))), κ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map (Limits.kernel.ι (wcEtSuppUnitMap DE)) = Limits.kernel.ι (wcEtSuppUnitMap DZ) ≫ wcEtSuppUnitMap D → ∀ (V : Y.Etale) (t : ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj (Limits.kernel (wcEtSuppUnitMap DE)))).obj.obj (Opposite.op V)) (v : V.left), V.hom v ∉ Set.range iZ → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (v₁ : V₁.left) (t₁ : ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj (Limits.kernel (wcEtSuppUnitMap DZ))).obj.obj (Opposite.op V₁)), c.left v₁ = v ∧ (((SheafOfModules.toSheaf (wcEtZModRing Y m)).map κ).hom.app (Opposite.op V₁)).hom t₁ = (((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj (Limits.kernel (wcEtSuppUnitMap DE)))).obj.map c.op).hom t :=
