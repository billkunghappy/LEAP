  obtain ⟨ι, hι⟩ := wc_etale_geom_point_residue_iso κ x (κ x) rfl
  obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, b₀, e₀', h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (κ x)
  have hB₀ : wcHalShData (κ x) B₀ Λ₀ W₀ φ₀ b₀ := ⟨h1, h2, h3, h4, h5, e₀', h6, h7⟩
  obtain ⟨θ, hθ⟩ := wc_shdata_etale_iso κ x (κ x) ι hι B Λ' W'' φ' a' hsh B₀ Λ₀ W₀ φ₀ b₀ hB₀
  have hcθ : θ.hom ≫ (b₀ ≫ Limits.pullback.snd D.f ac) =
      a' ≫ Limits.pullback.fst V.hom D.f ≫ γ.hom := by
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ Limits.pullback.snd D.f ac) hθ).trans
        ((Category.assoc _ _ _).trans (congrArg (a' ≫ ·) hκ2)))

  obtain ⟨τ, hτdef⟩ : ∃ τ : Spec (.of (AlgebraicClosure L)) ⟶ E.left,
      τ = Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫ eE.inv :=
    ⟨_, rfl⟩
  have hσ : τ ≫ eE.hom = Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) := by
    rw [hτdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hξ : (τ ≫ a₀.left ≫ γ.hom) (IsLocalRing.closedPoint (AlgebraicClosure L)) ≠
      IsLocalRing.closedPoint Ac := by
    intro h
    have e1 : ac ((τ ≫ a₀.left ≫ γ.hom) (IsLocalRing.closedPoint (AlgebraicClosure L))) =
        E.hom (τ (IsLocalRing.closedPoint (AlgebraicClosure L))) := by
      calc ac ((τ ≫ a₀.left ≫ γ.hom) (IsLocalRing.closedPoint (AlgebraicClosure L)))
          = (γ.hom ≫ ac) ((τ ≫ a₀.left) (IsLocalRing.closedPoint (AlgebraicClosure L))) :=
            (congrArg ac ((Scheme.Hom.comp_apply τ (a₀.left ≫ γ.hom) _).trans
              ((Scheme.Hom.comp_apply a₀.left γ.hom (τ _)).trans
                (congrArg γ.hom (Scheme.Hom.comp_apply τ a₀.left _)).symm))).trans
              (Scheme.Hom.comp_apply γ.hom ac _).symm
        _ = V.hom ((τ ≫ a₀.left) (IsLocalRing.closedPoint (AlgebraicClosure L))) := by
            rw [hγV]
        _ = (a₀.left ≫ V.hom) (τ (IsLocalRing.closedPoint (AlgebraicClosure L))) :=
            (congrArg V.hom (Scheme.Hom.comp_apply τ a₀.left _)).trans
              (Scheme.Hom.comp_apply a₀.left V.hom _).symm
        _ = E.hom (τ (IsLocalRing.closedPoint (AlgebraicClosure L))) := by
            rw [MorphismProperty.Over.w a₀]
    rw [h, hacl] at e1
    exact hE _ i e1.symm

  obtain ⟨g, hsq⟩ := s2 ((wcProEtPullback D.f).obj V).left ((wcProEtPullback D.f).obj E).left
    D.f V.hom E.hom a₀.left (MorphismProperty.Over.w a₀)
    (Limits.pullback.fst V.hom D.f) (Limits.pullback.snd V.hom D.f)
    (IsPullback.of_hasPullback V.hom D.f)
    (Limits.pullback.fst E.hom D.f) (Limits.pullback.snd E.hom D.f)
    (IsPullback.of_hasPullback E.hom D.f)
    ((wcProEtPullback D.f).map a₀).left hã1 hã2 a' γ θ (b₀ ≫ Limits.pullback.snd D.f ac) hcθ
    τ eE _ hσ

  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      (hℓp.eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc0 : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc0
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ : ℕ) : F'')) := isUnit_iff_ne_zero.mpr hℓK
  have hunitℓ : IsUnit (((ℓ : ℕ) : Ac)) := by
    have h1 := hunitK.map (Spec.preimage (ac ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at h1

  have hEt : ∀ k : ℕ, Subsingleton (wcEtCoh
      (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ (k + 1)) (j + 1)) := by
    intro k
    have hm : ℓ ^ (k + 1) ≠ 0 := pow_ne_zero _ hℓp.ne_zero
    have hFet : Subsingleton (wcEtCoh (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
        (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ (k + 1)) (j + 1)) := by
      rcases (show j + 1 + 2 ≤ n ∨ n ≤ j + 1 by omega) with hlow | hhigh
      · exact (wc_pencil_odp_shens_milnor_fibre_low F' F'' Y n hn hn2 D ℓ hℓp hℓ (k + 1) i Ac Λ
          W' φ ac hA (κ x) hx₀ B₀ Λ₀ W₀ φ₀ b₀ hB₀ (AlgebraicClosure L)
          (τ ≫ a₀.left ≫ γ.hom) hξ).2 (j + 1) (by omega) hlow
      · obtain ⟨hdom, hdvr, π, cM, hπ, hcM, x₁, hX, hx₁', B₁, _, _, _, Λ₁, _, _, W₁, φ₁, b₁,
          hB₁, θ₁, hθ₁⟩ := wc_pencil_odp_shens_morse_model F' F'' Y n hn hn2 D i Ac Λ W' φ ac hA
          (κ x) hx₀ B₀ Λ₀ W₀ φ₀ b₀ hB₀
        haveI := hdom
        haveI := hdvr
        exact (wc_quad_model_iso_milnor_fibre_high Ac ℓ hℓp hunitℓ n hn hn2 π cM hπ hcM x₁ hX
          hx₁' B₁ Λ₁ W₁ φ₁ b₁ hB₁ (Limits.pullback D.f ac) (Limits.pullback.snd D.f ac) B₀ b₀
          θ₁ hθ₁ (AlgebraicClosure L) (τ ≫ a₀.left ≫ γ.hom) hξ (k + 1) (by omega)).2
          (j + 1) hhigh
    obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
      (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ (k + 1)) (j + 1)
    haveI := hFet
    haveI : Subsingleton (wcEtZModExt (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
      (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ (k + 1)) (j + 1)) := E1.subsingleton
    obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists g (ℓ ^ (k + 1))
    have hb := wc_r2gs_integral_field_ext_pull_bij L (AlgebraicClosure L)
      (algebraMap L (AlgebraicClosure L)) (fun z => Algebra.IsIntegral.isIntegral z) _ _ _ g _
      hsq (ℓ ^ (k + 1)) hm Dg (j + 1)
    haveI : Subsingleton (wcEtZModExt (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)
        (ℓ ^ (k + 1)) (j + 1)) := ⟨fun a b => hb.1 (Subsingleton.elim _ _)⟩
    obtain ⟨E2⟩ := wc_et_zmodext_coh_equiv
      (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ (k + 1)) (j + 1)
    exact E2.symm.subsingleton

  have h3 : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf
      (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)
      (Scheme.ProEt.mk (𝟙 (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left))))
      (wcZModSheaf (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ (k + 1)))
      (j + 1), y = 0 := fun k =>
    wc_proet_zmod_ext_vanish_of_et _ (ℓ ^ (k + 1)) j (hEt k)
  have h2 := wc_proet_int_ext_vanish_of_zmod_deg _ ℓ
    (Scheme.ProEt.mk (𝟙 (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left))) j h3
  exact wc_hm_vanish_of_int_ext_vanish _ ℓ j h2

theorem wc_zmod_pull_id {S : Scheme.{u}} {n : ℕ} (k : S ⟶ S) (hk : k = 𝟙 S)
    (D : wcZModPullData k n) (hD : wcZModPullCanonical D) (j : ℕ) (x : wcZModProEtExt S n j) :
    wcZModPull D j x = x :=
by
  classical
  subst hk

  let eV : ∀ V : S.ProEt, Limits.pullback V.hom (𝟙 S) ≅ V.left := fun V =>
    { hom := Limits.pullback.fst V.hom (𝟙 S)
      inv := Limits.pullback.lift (𝟙 V.left) V.hom (by rw [Category.id_comp, Category.comp_id])
      hom_inv_id := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp,
            ← Category.comp_id (Limits.pullback.snd V.hom (𝟙 S)), ← Limits.pullback.condition]
      inv_hom_id := Limits.pullback.lift_fst _ _ _ }
  let β : ∀ V : S.ProEt, (wcProEtBC (𝟙 S)).obj V ≅ (𝟭 S.ProEt).obj V := fun V =>
    MorphismProperty.Over.isoMk (eV V)
      (by
        show Limits.pullback.fst V.hom (𝟙 S) ≫ V.hom = Limits.pullback.snd V.hom (𝟙 S)
        rw [Limits.pullback.condition, Category.comp_id])
  have hnat : ∀ {V W : S.ProEt} (g : V ⟶ W),
      (wcProEtBC (𝟙 S)).map g ≫ (β W).hom = (β V).hom ≫ (𝟭 S.ProEt).map g := by
    intro V W g
    apply MorphismProperty.Over.Hom.ext
    show ((wcProEtBC (𝟙 S)).map g).left ≫ Limits.pullback.fst W.hom (𝟙 S) =
      Limits.pullback.fst V.hom (𝟙 S) ≫ g.left
    exact Limits.pullback.lift_fst _ _ _
  let α : 𝟭 S.ProEt ≅ wcProEtBC (𝟙 S) := (NatIso.ofComponents β hnat).symm
  have hα : ∀ (V : S.ProEt) (z : ↥V.left),
      (Limits.pullback.fst V.hom (𝟙 S)) ((α.hom.app V).left z) = z := by
    intro V z
    have h1 : (α.hom.app V).left ≫ Limits.pullback.fst V.hom (𝟙 S) = 𝟙 V.left := by
      show (eV V).inv ≫ (eV V).hom = 𝟙 V.left
      exact (eV V).inv_hom_id
    calc (Limits.pullback.fst V.hom (𝟙 S)) ((α.hom.app V).left z)
        = ((α.hom.app V).left ≫ Limits.pullback.fst V.hom (𝟙 S)) z :=
          (Scheme.Hom.comp_apply _ _ z).symm
      _ = (𝟙 V.left : V.left ⟶ V.left) z := by rw [h1]
      _ = z := rfl

  haveI := D.cont
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S)).app (wcZModRingSheaf S n)
  have hcompat : D.φ ≫ τ = (𝟙 (wcZModRingSheaf S n) : wcZModRingSheaf S n ⟶
      ((𝟭 S.ProEt).sheafPushforwardContinuous RingCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S)).obj (wcZModRingSheaf S n)) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun g : C(↥(Limits.pullback V.hom (𝟙 S)), ULift.{u+1} (ZMod n)) =>
      g ((α.hom.app V).left.base z)) (hD V s)).trans ?_
    let s' : C(↥V.left, ULift.{u+1} (ZMod n)) := s
    exact congrArg (fun p => s' p) (hα V z)
  let ι := SheafOfModules.pushforwardNatIso D.φ α ≪≫ SheafOfModules.pushforwardCongr hcompat ≪≫
    SheafOfModules.pushforwardId (wcZModRingSheaf S n)
  let θ : D.Φ ≅ 𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S n)) :=
    Adjunction.leftAdjointUniq (D.adj.ofNatIsoRight ι) Adjunction.id

  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf S n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf S n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf S n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have key : ∀ (y : wcZModProEtExt S n j)
      (E E' : SheafOfModules.unit (wcZModRingSheaf S n) ⟶ SheafOfModules.unit (wcZModRingSheaf S n)),
      E ≫ E' = 𝟙 _ →
      (Abelian.Ext.mk₀ E).comp y (zero_add j) = y.comp (Abelian.Ext.mk₀ E) (add_zero j) →
      (Abelian.Ext.mk₀ E).comp (y.comp (Abelian.Ext.mk₀ E') (add_zero j)) (zero_add j) = y := by
    intro y E E' hEE hc
    rw [← h4, hc, h3, hEE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j) = x
  have nat : (Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))) (add_zero j) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))).comp x
        (zero_add j) := by
    rw [Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom, Abelian.Ext.id_mapExactFunctor]
  have step1 : (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))).comp x
        (zero_add j)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcZModRingSheaf S n)) ≫ D.μ.hom))
        (add_zero j) := by
    rw [← nat, h3, Iso.hom_inv_id_app_assoc]
  rw [step1, h4, h2]
  have he2 : (D.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n))) ≫
      (θ.inv.app (SheafOfModules.unit (wcZModRingSheaf S n)) ≫ D.μ.hom) = 𝟙 _ := by
    simp only [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have hcentral : ∀ (e : SheafOfModules.unit (wcZModRingSheaf S n) ⟶
      SheafOfModules.unit (wcZModRingSheaf S n)) (y : wcZModProEtExt S n j),
      (Abelian.Ext.mk₀ e).comp y (zero_add j) = y.comp (Abelian.Ext.mk₀ e) (add_zero j) := by
    intro e y
    have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcZModRingSheaf S n).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} (ZMod n)) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S n)),
        m.app (SheafOfModules.unit (wcZModRingSheaf S n)) = e := by
      let R := wcZModRingSheaf S n
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨m, hm⟩ := hext
    subst hm
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  exact key x _ _ he2 (hcentral _ x)

theorem wc_pmn_vp_node_residue_sepClosed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F'')) :
    IsSepClosed (((wcProEtPullback D.f).obj V).left.residueField x) :=
by
  classical
  have isoSurj : ∀ {R S : CommRingCat.{u}} (e : R ≅ S), Function.Surjective e.hom.hom :=
    fun e t => ⟨e.inv.hom t, by rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]⟩
  have s1 : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) [SurjectiveOnStalks φ] (x : X),
      Function.Surjective (φ.residueFieldMap x).hom := by
    intro X Y φ _ x
    have h := Scheme.residue_residueFieldMap φ x
    have h2 : (φ.residueFieldMap x).hom ∘ (Y.residue (φ x)).hom =
        (X.residue x).hom ∘ (φ.stalkMap x).hom := by
      funext t
      have := congrArg (fun k => k.hom t) h
      simpa using this
    have h3 : Function.Surjective ((X.residue x).hom ∘ (φ.stalkMap x).hom) :=
      (Scheme.residue_surjective X x).comp (φ.stalkMap_surjective x)
    rw [← h2] at h3
    exact Function.Surjective.of_comp h3
  have s3 : ∀ {V Y P : Scheme.{u}} {K : Type u} [Field K] (g : V ⟶ P) (f : Y ⟶ P)
      (s : Spec (.of K) ⟶ Y) [IsClosedImmersion (s ≫ f)] (w : ↥(Limits.pullback g f)),
      Limits.pullback.snd g f w = s (IsLocalRing.closedPoint K) →
      Function.Surjective ((Limits.pullback.fst g f).residueFieldMap w).hom := by
    intro V Y P K _ g f s _ w hw
    obtain ⟨q, rfl, -⟩ := Scheme.Pullback.exists_preimage_pullback w _ hw
    have hE : Limits.pullback.fst (Limits.pullback.snd g f) s ≫ Limits.pullback.fst g f =
        (Limits.pullbackLeftPullbackSndIso g f s).hom ≫ Limits.pullback.fst g (s ≫ f) :=
      (Limits.pullbackLeftPullbackSndIso_hom_fst g f s).symm
    have hc := s1 (Limits.pullback.fst g (s ≫ f)) ((Limits.pullbackLeftPullbackSndIso g f s).hom q)
    have hd := s1 (Limits.pullbackLeftPullbackSndIso g f s).hom q
    have hcomp : Function.Surjective
        (((Limits.pullbackLeftPullbackSndIso g f s).hom ≫ Limits.pullback.fst g (s ≫ f)).residueFieldMap q).hom := by
      rw [Scheme.residueFieldMap_comp]
      exact hd.comp hc
    have h3 := Scheme.Hom.residueFieldMap_congr hE q
    have hba : Function.Surjective
        ((Limits.pullback.fst (Limits.pullback.snd g f) s ≫ Limits.pullback.fst g f).residueFieldMap q).hom := by
      rw [h3]
      exact hcomp.comp (isoSurj _)
    rw [Scheme.residueFieldMap_comp] at hba
    have hba' : Function.Surjective
        (⇑((Limits.pullback.fst (Limits.pullback.snd g f) s).residueFieldMap q).hom ∘
          ⇑((Limits.pullback.fst g f).residueFieldMap
            ((Limits.pullback.fst (Limits.pullback.snd g f) s) q)).hom) := hba
    intro t
    obtain ⟨r, hr⟩ := hba' (((Limits.pullback.fst (Limits.pullback.snd g f) s).residueFieldMap q).hom t)
    exact ⟨r, ((Limits.pullback.fst (Limits.pullback.snd g f) s).residueFieldMap q).hom.injective hr⟩
  have s4 : ∀ (K : Type u) [Field K] [IsSepClosed K] {X : Scheme.{u}} (σ : X ⟶ Spec (.of K))
      (x : X), Function.Surjective (σ.residueFieldMap x).hom → IsSepClosed (X.residueField x) := by
    intro K _ _ X σ x h
    have hp : σ x = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    let Φ : CommRingCat.of K ⟶ X.residueField x :=
      (stalkClosedPointIso (CommRingCat.of K)).inv ≫
        (Spec (.of K)).residue (IsLocalRing.closedPoint K) ≫
        (Scheme.residueFieldCongr hp).inv ≫ σ.residueFieldMap x
    have hΦ : Function.Surjective Φ.hom := by
      simp only [Φ, CommRingCat.hom_comp]
      refine h.comp (Function.Surjective.comp (isoSurj (Scheme.residueFieldCongr hp).symm)
        ((Scheme.residue_surjective _ _).comp (isoSurj (stalkClosedPointIso (CommRingCat.of K)).symm)))
    letI : Algebra K (X.residueField x) := Φ.hom.toAlgebra
    haveI : Algebra.IsAlgebraic K (X.residueField x) := by
      constructor
      intro y
      obtain ⟨k, rfl⟩ := hΦ y
      exact isAlgebraic_algebraMap (R := K) k
    exact Algebra.IsAlgebraic.isSepClosed (F := K)
  haveI hsf : IsClosedImmersion (D.xs i ≫ D.f) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.xs i ≫ D.f) (by rw [D.hxs i, D.hS i])
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hq : ∀ y : ↥(Spec (.of (IsLocalRing.ResidueField A))),
      wcQmSp A y = IsLocalRing.closedPoint A := by
    intro y
    show Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) _ = _
    rw [Spec.map_apply, CommRingCat.hom_ofHom]
    exact IsLocalRing.PrimeSpectrum.comap_residue _ _
  have key : ∀ xx : ↥(Limits.pullback V.hom D.f),
      Limits.pullback.fst V.hom D.f xx = e.inv (IsLocalRing.closedPoint A) →
      Limits.pullback.snd V.hom D.f xx = D.xs i (IsLocalRing.closedPoint F'') →
      IsSepClosed ((Limits.pullback V.hom D.f).residueField xx) := by
    intro xx h1 h2
    have hg : (Limits.pullback.fst V.hom D.f ≫ e.hom) xx = IsLocalRing.closedPoint A := by
      rw [Scheme.Hom.comp_apply, h1]
      have hinv : ∀ {X Y : Scheme.{u}} (f : X ≅ Y) (y : Y), f.hom (f.inv y) = y := by
        intro X Y f y
        rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
        first | rfl | simp
      exact hinv e _
    obtain ⟨xs, rfl, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst V.hom D.f ≫ e.hom) (g := wcQmSp A) xx
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :
        ↥(Spec (.of (IsLocalRing.ResidueField A)))) (hg.trans (hq _).symm)
    have a1 := s3 V.hom D.f (D.xs i)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs) h2
    have a2 := s1 (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs
    have a3 := s1 e.hom (Limits.pullback.fst V.hom D.f
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs))
    have hsep : IsSepClosed
        ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs) := by
      have hsq : (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
            Limits.pullback.fst V.hom D.f) ≫ e.hom =
          Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫ wcQmSp A := by
        rw [Category.assoc]; exact Limits.pullback.condition
      have hcomp : Function.Surjective
          (((Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
            Limits.pullback.fst V.hom D.f) ≫ e.hom).residueFieldMap xs).hom := by
        rw [Scheme.residueFieldMap_comp, Scheme.residueFieldMap_comp]
        exact (a2.comp a1).comp a3
      rw [Scheme.Hom.residueFieldMap_congr hsq xs] at hcomp
      have hcomp' : Function.Surjective
          ((Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
            wcQmSp A).residueFieldMap xs).hom := by
        have : Function.Surjective
            (⇑((Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
              wcQmSp A).residueFieldMap xs).hom ∘ ⇑(Scheme.residueFieldCongr
              (congrArg (fun φ => φ xs) hsq)).hom.hom) := hcomp
        exact Function.Surjective.of_comp this
      rw [Scheme.residueFieldMap_comp] at hcomp'
      have hσs : Function.Surjective ((Limits.pullback.snd
          (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueFieldMap xs).hom := by
        have : Function.Surjective
            (⇑((Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom)
              (wcQmSp A)).residueFieldMap xs).hom ∘
              ⇑((wcQmSp A).residueFieldMap ((Limits.pullback.snd
                (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs)).hom) := hcomp'
        exact Function.Surjective.of_comp this
      exact s4 (IsLocalRing.ResidueField A) _ xs hσs
    haveI := hsep
    let ψ := (RingEquiv.ofBijective
      ((Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueFieldMap xs).hom
      ⟨((Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A)).residueFieldMap xs).hom.injective, a2⟩).symm
    letI : Algebra
        ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs)
        ((Limits.pullback V.hom D.f).residueField
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs)) :=
      ψ.toRingHom.toAlgebra
    haveI : Algebra.IsAlgebraic
        ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs)
        ((Limits.pullback V.hom D.f).residueField
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs)) := by
      constructor
      intro y
      have hy : y = algebraMap _ _ (ψ.symm y) := (ψ.apply_symm_apply y).symm
      rw [hy]
      exact isAlgebraic_algebraMap _
    exact Algebra.IsAlgebraic.isSepClosed
      (F := (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs)
  exact key x hx₁ hx₂

theorem wc_ppu_closed_fibre_square {X : Scheme.{u}} (x : X) [IsSepClosed (X.residueField x)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ (c : Limits.pullback a' (X.fromSpecResidueField x) ⟶
          Spec (.of (B ⧸ IsLocalRing.maximalIdeal B)))
      (g : X.residueField x →+* B ⧸ IsLocalRing.maximalIdeal B),
      IsPullback (Limits.pullback.fst a' (X.fromSpecResidueField x)) c (𝟙 (Spec (.of B)))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)))) ∧
      Function.Bijective g ∧
      c ≫ Spec.map (CommRingCat.ofHom g) = Limits.pullback.snd a' (X.fromSpecResidueField x) :=
by
  classical
  obtain ⟨hinit, -, hcompat, hφa, huniv, ⟨eR, -, he⟩⟩ := hsh
  have hk₀pt : ∀ s, X.fromSpecResidueField x s = x := fun s => Scheme.fromSpecResidueField_apply x s
  have hgeom : ∀ z, wcEtGeomPt X x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _

  have hsurj : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (w : E),
      IsSepClosed (S.residueField (e w)) → Function.Surjective (e.residueFieldMap w).hom := by
    intro E S e _ w hsep
    letI : Algebra (S.presheaf.stalk (e w)) (E.presheaf.stalk w) := (e.stalkMap w).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (S.presheaf.stalk (e w)) (E.presheaf.stalk w)) :=
      (inferInstance : IsLocalHom (e.stalkMap w).hom)
    haveI : Algebra.FormallyUnramified (S.presheaf.stalk (e w)) (E.presheaf.stalk w) :=
      FormallyUnramified.stalkMap e w
    haveI : Algebra.EssFiniteType (S.presheaf.stalk (e w)) (E.presheaf.stalk w) :=
      LocallyOfFiniteType.stalkMap e w
    haveI : Algebra.IsSeparable (IsLocalRing.ResidueField (S.presheaf.stalk (e w)))
        (IsLocalRing.ResidueField (E.presheaf.stalk w)) :=
      Algebra.instIsSeparableResidueFieldOfFormallyUnramified
    haveI : IsSepClosed (IsLocalRing.ResidueField (S.presheaf.stalk (e w))) := hsep
    have hs : Function.Surjective (algebraMap (IsLocalRing.ResidueField (S.presheaf.stalk (e w)))
        (IsLocalRing.ResidueField (E.presheaf.stalk w))) := IsSepClosed.algebraMap_surjective _ _
    exact hs

  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
      ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ pp hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have hrig : ∀ (K : Type u) [Field K] {E S : Scheme.{u}} (e : E ⟶ S) [Etale e]
      (f g : Spec (.of K) ⟶ E) (v : E) (y : S), f ≫ e = g ≫ e →
      f (IsLocalRing.closedPoint K) = v → g (IsLocalRing.closedPoint K) = v →
      e v = y → IsSepClosed (S.residueField y) → f = g := by
    intro K _ E S e _ f g v y hfg hf hg hy hsep
    subst hy
    obtain ⟨⟨w, α⟩, rfl⟩ : ∃ xf, f = (Scheme.SpecToEquivOfField K E).symm xf :=
      ⟨_, (Equiv.symm_apply_apply _ _).symm⟩
    obtain ⟨⟨w', β⟩, rfl⟩ : ∃ xf, g = (Scheme.SpecToEquivOfField K E).symm xf :=
      ⟨_, (Equiv.symm_apply_apply _ _).symm⟩
    simp only [Scheme.SpecToEquivOfField_symm_apply] at hf hg hfg ⊢
    have hw : w = v :=
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)).symm.trans hf
    have hw' : w' = v :=
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)).symm.trans hg
    subst hw
    subst hw'
    have h1 : Spec.map (e.residueFieldMap w' ≫ α) ≫ S.fromSpecResidueField (e w') =
        Spec.map (e.residueFieldMap w' ≫ β) ≫ S.fromSpecResidueField (e w') := by
      simpa only [Spec.map_comp, Category.assoc,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField] using hfg
    have h2 : e.residueFieldMap w' ≫ α = e.residueFieldMap w' ≫ β :=
      Spec.map_injective ((cancel_mono _).mp h1)
    have h3 : α = β := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro t
      obtain ⟨s, rfl⟩ := hsurj e w' hsep t
      exact congrArg (fun φ => φ.hom s) h2
    rw [h3]

  have hrigP : ∀ {P E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (f g : P ⟶ E) (y : S),
      f ≫ e = g ≫ e → (∀ p, f p = g p) → (∀ p, e (f p) = y) →
      IsSepClosed (S.residueField y) → f = g := by
    intro P E S e _ f g y hfg hpt hy hsep
    apply Scheme.hom_ext_of_forall
    intro p
    have hπ : P.fromSpecResidueField p ≫ f = P.fromSpecResidueField p ≫ g :=
      hrig (P.residueField p) e _ _ (f p) y (by rw [Category.assoc, Category.assoc, hfg])
        ((Scheme.Hom.comp_apply _ _ _).trans (congrArg f (Scheme.fromSpecResidueField_apply p _)))
        ((Scheme.Hom.comp_apply _ _ _).trans
          ((congrArg g (Scheme.fromSpecResidueField_apply p _)).trans (hpt p).symm))
        (hy p) hsep
    obtain ⟨U, hU, hUeq⟩ := s0 e f g hfg (P.residueField p) (P.fromSpecResidueField p) hπ
    exact ⟨U, Eq.mp (congrArg (fun q => q ∈ U) (Scheme.fromSpecResidueField_apply p _)) hU, hUeq⟩

  have hsec : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (w : E) (y : S), e w = y →
      IsSepClosed (S.residueField y) → ∃ s : Spec (S.residueField y) ⟶ E,
        s ≫ e = S.fromSpecResidueField y ∧ ∀ t, s t = w := by
    intro E S e _ w y hw hsep
    subst hw
    haveI : IsIso (e.residueFieldMap w) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact ⟨RingHom.injective _, hsurj e w hsep⟩
    refine ⟨Spec.map (inv (e.residueFieldMap w)) ≫ E.fromSpecResidueField w, ?_, fun t => ?_⟩
    · rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Category.assoc, ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id, Category.id_comp]
    · exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)

  have hisoGen : ∀ {V S : Scheme.{u}} (f : V ⟶ S) [Etale f] (v : V),
      ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, f w = f v → w = v := by
    intro V S f _ v
    haveI hlqf : LocallyQuasiFinite f := by
      rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
      intro U W e
      have h := HasRingHomProperty.appLE @Etale f ‹Etale f› U W e
      letI := (f.appLE U W e).hom.toAlgebra
      haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
      exact RingHom.quasiFinite_algebraMap.mpr inferInstance
    haveI hd : DiscreteTopology ↑(f ⁻¹' {f v}) := (f.fiberHomeo (f v)).discreteTopology
    have hv : f v ∈ ({f v} : Set S) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(f ⁻¹' {f v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro w hwU hw
      have hw' : w ∈ f ⁻¹' {f v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
      have : (⟨w, hw'⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := hwU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this

  have hw : ∀ l, (W''.obj l).right.hom ((W''.obj l).hom.left
      (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) = x := fun l =>
    (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))
        (Over.w (W''.obj l).hom)).trans (hgeom _))
  have hφx : ∀ l b, a' b = x → (W''.obj l).right.hom (φ' l b) = x := fun l b hb =>
    (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun f => f b) (hφa l)).trans hb)

  have hcollapse : ∀ (l : Λ') (b : Spec (.of B)), a' b = x →
      φ' l b = (W''.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) := by
    intro l b hb
    haveI hEt : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    obtain ⟨O, hwO, hiso⟩ := hisoGen (W''.obj l).right.hom
      ((W''.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))
    have hr : Set.range (W''.obj l).hom.left ⊆ Set.range O.ι := by
      rintro _ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)) :=
        Subsingleton.elim (α := PrimeSpectrum (AlgebraicClosure (X.residueField x))) _ _
      subst hz
      exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mpr hwO
    let lam := IsOpenImmersion.lift O.ι (W''.obj l).hom.left hr
    have hlam : lam ≫ O.ι = (W''.obj l).hom.left := IsOpenImmersion.lift_fac _ _ _
    let R : X.Etale := Scheme.Etale.mk (O.ι ≫ (W''.obj l).right.hom)
    have hlamR : lam ≫ ((Scheme.Etale.forget X).obj R).hom =
        (Over.mk (wcEtGeomPt X x)).hom := by
      show lam ≫ O.ι ≫ (W''.obj l).right.hom = wcEtGeomPt X x
      rw [← Category.assoc, hlam]
      exact Over.w (W''.obj l).hom
    let d : StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X) :=
      StructuredArrow.mk (Y := R) (Over.homMk lam hlamR)
    let iR : R ⟶ (W''.obj l).right := MorphismProperty.Over.homMk O.ι rfl trivial
    let i : d ⟶ W''.obj l := StructuredArrow.homMk iR (by
      apply Over.OverMorphism.ext
      exact hlam)
    obtain ⟨hI1, hI2⟩ := (Functor.initial_iff_of_isCofiltered W'').mp hinit
    obtain ⟨l₁, ⟨g₁⟩⟩ := hI1 d
    obtain ⟨l₃, t', ht'⟩ := hI2 (W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁ ≫ i)
      (W''.map (IsCofiltered.minToRight l₁ l))
    have hg : (W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁) ≫ i =
        W''.map (t' ≫ IsCofiltered.minToRight l₁ l) := by
      rw [Functor.map_comp, Category.assoc, Category.assoc]
      exact ht'
    have hg' : (W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι =
        (W''.map (t' ≫ IsCofiltered.minToRight l₁ l)).right.left :=
      congrArg (fun k => k.right.left) hg
    have e1 : φ' l = φ' l₃ ≫
        (W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι := by
      rw [hg', hcompat]
    have hmem : φ' l b ∈ O := by
      have h4 : φ' l b = O.ι
          ((W''.map t' ≫ W''.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left
            (φ' l₃ b)) :=
        (congrArg (fun f => f b) e1).trans
          ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _))
      rw [h4]
      exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp (Set.mem_range_self _)
    exact hiso _ hmem ((hφx l b hb).trans (hw l).symm)

  have hzex : ∀ l, ∃ s : Spec (X.residueField x) ⟶ (W''.obj l).right.left,
      s ≫ (W''.obj l).right.hom = X.fromSpecResidueField x ∧
      ∀ t, s t = (W''.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) := by
    intro l
    haveI : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    exact hsec (W''.obj l).right.hom _ x (hw l)
      (show IsSepClosed (X.residueField x) from inferInstance)
  choose z hze hzpt using hzex
  have hzc : ∀ {l l' : Λ'} (t : l ⟶ l'), z l ≫ (W''.map t).right.left = z l' := by
    intro l l' t
    haveI : Etale (W''.obj l').right.hom := (W''.obj l').right.prop
    have hm : (W''.obj l).hom.left ≫ (W''.map t).right.left = (W''.obj l').hom.left :=
      congrArg (fun f => f.left) (StructuredArrow.w (W''.map t))
    have hm' : (W''.map t).right.left ((W''.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) =
        (W''.obj l').hom.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) hm)
    exact hrig (X.residueField x) (W''.obj l').right.hom (z l ≫ (W''.map t).right.left) (z l')
      ((W''.obj l').hom.left (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) x
      ((Category.assoc _ _ _).trans
        ((congrArg (fun k => z l ≫ k) (MorphismProperty.Over.w (W''.map t).right)).trans
          ((hze l).trans (hze l').symm)))
      ((Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg (W''.map t).right.left (hzpt l _)).trans hm'))
      (hzpt l' _) (hw l') (show IsSepClosed (X.residueField x) from inferInstance)

  obtain ⟨δ, hδ, -⟩ := huniv (Spec (X.residueField x)) z hzc
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ')
  have hδa : δ ≫ a' = X.fromSpecResidueField x :=
    (congrArg (fun k => δ ≫ k) (hφa l₀)).symm.trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (fun k => k ≫ (W''.obj l₀).right.hom)
        (hδ l₀)).trans (hze l₀)))
  have hcond : Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ a' =
      Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ X.fromSpecResidueField x :=
    Limits.pullback.condition
  have hP1 : ∀ p, a' (Limits.pullback.fst a' (X.fromSpecResidueField x) p) = x := fun p =>
    (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun f => f p) hcond).trans
      ((Scheme.Hom.comp_apply _ _ _).trans (hk₀pt _)))
  have hkey : ∀ l, Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ φ' l =
      Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ z l := by
    intro l
    haveI : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    have hfg : (Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ φ' l) ≫
        (W''.obj l).right.hom =
        (Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ z l) ≫ (W''.obj l).right.hom :=
      (Category.assoc _ _ _).trans ((congrArg (fun k => _ ≫ k) (hφa l)).trans
        (hcond.trans ((congrArg (fun k => _ ≫ k) (hze l)).symm.trans
          (Category.assoc _ _ _).symm)))
    exact hrigP (W''.obj l).right.hom _ _ x hfg
      (fun p => (Scheme.Hom.comp_apply _ _ _).trans ((hcollapse l _ (hP1 p)).trans
        ((hzpt l _).symm.trans (Scheme.Hom.comp_apply _ _ _).symm)))
      (fun p => (congrArg (W''.obj l).right.hom (Scheme.Hom.comp_apply _ _ _)).trans
        (hφx l _ (hP1 p)))
      (show IsSepClosed (X.residueField x) from inferInstance)
  have hfst : Limits.pullback.fst a' (X.fromSpecResidueField x) =
      Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ δ := by
    obtain ⟨z₀, -, huniq⟩ := huniv _
      (fun l => Limits.pullback.fst a' (X.fromSpecResidueField x) ≫ φ' l)
      (fun t => by rw [Category.assoc, hcompat])
    exact (huniq _ (fun l => rfl)).trans
      (huniq _ (fun l => by rw [Category.assoc, hδ, hkey])).symm
  let σ : Spec (X.residueField x) ⟶ Limits.pullback a' (X.fromSpecResidueField x) :=
    Limits.pullback.lift δ (𝟙 _) (by rw [hδa, Category.id_comp])
  have hσs : σ ≫ Limits.pullback.snd a' (X.fromSpecResidueField x) = 𝟙 _ :=
    Limits.pullback.lift_snd _ _ _
  have hσf : σ ≫ Limits.pullback.fst a' (X.fromSpecResidueField x) = δ :=
    Limits.pullback.lift_fst _ _ _
  have hsσ : Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ σ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hσf, Category.id_comp, hfst]
    · rw [Category.assoc, hσs, Category.comp_id, Category.id_comp]

  have hgen : ∀ {S : CommRingCat.{u}} (φ : CommRingCat.of B ⟶ S) (p : Spec S),
      (∀ a ∈ IsLocalRing.maximalIdeal B, φ.hom a = 0) →
      Spec.map φ p = IsLocalRing.closedPoint B := by
    intro S φ p hφ
    apply PrimeSpectrum.ext
    apply le_antisymm
    · exact IsLocalRing.le_maximalIdeal (PrimeSpectrum.isPrime _).ne_top
    · intro a ha
      show φ.hom a ∈ p.asIdeal
      rw [hφ a ha]
      exact p.asIdeal.zero_mem

  have hcp : a' (IsLocalRing.closedPoint B) = x := by
    have h1 : (Spec.map (CommRingCat.ofHom eR) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a')
          (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) = x :=
      (congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) he).trans
        (hgeom _)
    have h2 : a' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        (Spec.map (CommRingCat.ofHom eR)
          (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))) = x :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans ((Scheme.Hom.comp_apply _ _ _).symm.trans h1)
    have hres : ∀ a ∈ IsLocalRing.maximalIdeal B,
        (CommRingCat.ofHom (IsLocalRing.residue B)).hom a = 0 :=
      fun a ha => (IsLocalRing.residue_eq_zero_iff a).mpr ha
    exact (congrArg a' (hgen (CommRingCat.ofHom (IsLocalRing.residue B)) _ hres)).symm.trans h2

  have hδq : ∀ q, δ q = IsLocalRing.closedPoint B := by
    intro q
    obtain ⟨zp, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := a')
      (g := X.fromSpecResidueField x) (IsLocalRing.closedPoint B)
      (IsLocalRing.closedPoint (X.residueField x)) (hcp.trans (hk₀pt _).symm)
    have hq : q = Limits.pullback.snd a' (X.fromSpecResidueField x) zp := Subsingleton.elim _ _
    rw [hq]
    exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun f => f zp) hfst.symm).trans hz1)

  let d : CommRingCat.of B ⟶ X.residueField x := Spec.preimage δ
  have hdδ : Spec.map d = δ := Spec.map_preimage δ
  have hker : RingHom.ker d.hom = IsLocalRing.maximalIdeal B := by
    have h3 : ((Spec.map d) (IsLocalRing.closedPoint (X.residueField x))).asIdeal =
        (IsLocalRing.closedPoint B).asIdeal := by
      rw [hdδ]
      exact congrArg PrimeSpectrum.asIdeal (hδq _)
    rw [RingHom.ker_eq_comap_bot, ← IsLocalRing.maximalIdeal_eq_bot (R := X.residueField x)]
    exact h3
  let D : CommRingCat.of (B ⧸ IsLocalRing.maximalIdeal B) ⟶ X.residueField x :=
    CommRingCat.ofHom (Ideal.Quotient.lift (IsLocalRing.maximalIdeal B) d.hom
      (fun a ha => by rw [← hker] at ha; exact RingHom.mem_ker.mp ha))
  have hdbinj : Function.Injective D.hom := (Ideal.injective_lift_iff _).mpr hker
  have hcomp1 : CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)) ≫ D = d := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    exact Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal B) d.hom
      (fun a ha => by rw [← hker] at ha; exact RingHom.mem_ker.mp ha)
  have hδ' : Spec.map D ≫
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B))) = δ := by
    rw [← Spec.map_comp, hcomp1, hdδ]

  have hfac : ∀ (y : X) (f : Spec (.of (B ⧸ IsLocalRing.maximalIdeal B)) ⟶ X),
      (∀ q, f q = y) → ∃ ρ : X.residueField y →+* B ⧸ IsLocalRing.maximalIdeal B,
        Spec.map (CommRingCat.ofHom ρ) ≫ X.fromSpecResidueField y = f := by
    intro y f hf
    letI : Field (B ⧸ IsLocalRing.maximalIdeal B) := Ideal.Quotient.field _
    have key : ∀ y' : X, f (IsLocalRing.closedPoint (B ⧸ IsLocalRing.maximalIdeal B)) = y' →
        ∃ ρ : X.residueField y' →+* B ⧸ IsLocalRing.maximalIdeal B,
          Spec.map (CommRingCat.ofHom ρ) ≫ X.fromSpecResidueField y' = f := by
      intro y' hy
      subst hy
      exact ⟨(Scheme.descResidueField (Scheme.stalkClosedPointTo f)).hom,
        Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ X f⟩
    exact key y (hf _)
  have hf₀ : ∀ q, (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)))
      ≫ a') q = x := by
    intro q
    have hmk : ∀ a ∈ IsLocalRing.maximalIdeal B,
        (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B))).hom a = 0 :=
      fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr ha
    exact (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg a' (hgen (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)))
        q hmk)).trans hcp)
  obtain ⟨ρ, hρ⟩ := hfac x _ hf₀
  have hid0 : Spec.map (CommRingCat.ofHom ρ ≫ D) ≫ X.fromSpecResidueField x =
      𝟙 _ ≫ X.fromSpecResidueField x := by
    rw [Spec.map_comp, Category.assoc, hρ, ← Category.assoc, hδ', hδa, Category.id_comp]
  have hid1 : Spec.map (CommRingCat.ofHom ρ ≫ D) = Spec.map (𝟙 _) := by
    rw [Spec.map_id]
    exact (cancel_mono _).mp hid0
  have hid : CommRingCat.ofHom ρ ≫ D = 𝟙 _ := Spec.map_injective hid1
  have hleft : ∀ t, D.hom (ρ t) = t := fun t => congrArg (fun φ => φ.hom t) hid
  have hdbbij : Function.Bijective D.hom := ⟨hdbinj, fun t => ⟨ρ t, hleft t⟩⟩
  have hρbij : Function.Bijective ρ := by
    refine ⟨fun t t' h => ?_, fun y => ⟨D.hom y, hdbinj (hleft (D.hom y))⟩⟩
    rw [← hleft t, ← hleft t', h]
  haveI : IsIso (Limits.pullback.snd a' (X.fromSpecResidueField x)) := ⟨⟨σ, hsσ, hσs⟩⟩
  haveI : IsIso D := by
    rw [ConcreteCategory.isIso_iff_bijective]
    exact hdbbij
  haveI : IsIso (Spec.map D) := inferInstance
  haveI : IsIso (Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ Spec.map D) :=
    inferInstance
  refine ⟨Limits.pullback.snd a' (X.fromSpecResidueField x) ≫ Spec.map D,
    ρ, ?_, hρbij, ?_⟩
  · refine IsPullback.of_vert_isIso ⟨?_⟩
    rw [Category.comp_id, Category.assoc, hδ', hfst]
  · rw [Category.assoc, ← Spec.map_comp, hid, Spec.map_id]
    exact Category.comp_id _

theorem wc_ppu_lc_henselian (B : Type u) [CommRing B] [HenselianLocalRing B]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S] :
    HenselianRing (LocallyConstant S B)
      (Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B)
        (IsLocalRing.maximalIdeal B)) :=
by
  classical
  set 𝔪 := IsLocalRing.maximalIdeal B with h𝔪
  set I := Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B) 𝔪 with hI
  have hconst : ∀ (b : B) (s : S),
      (LocallyConstant.constRingHom b : LocallyConstant S B) s = b := fun _ _ => rfl

  have s1f : ∀ f : LocallyConstant S B, f ∈ I → ∀ s, f s ∈ 𝔪 := by
    intro f hf s
    have hle : I ≤ Ideal.comap (LocallyConstant.evalRingHom s) 𝔪 := by
      rw [hI, Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, Ideal.mem_comap, LocallyConstant.evalRingHom_apply, hconst]
      exact hb
    have h := hle hf
    rw [Ideal.mem_comap, LocallyConstant.evalRingHom_apply] at h
    exact h

  have s1b : ∀ f : LocallyConstant S B, (∀ s, f s ∈ 𝔪) → f ∈ I := by
    intro f hf
    have hsum : f = ∑ b ∈ (LocallyConstant.range_finite f).toFinset,
        (LocallyConstant.constRingHom b : LocallyConstant S B) *
          LocallyConstant.map (fun x : B => if x = b then (1 : B) else 0) f := by
      ext s
      have hmem : f s ∈ (LocallyConstant.range_finite f).toFinset :=
        (Set.Finite.mem_toFinset _).mpr (Set.mem_range_self s)
      rw [← LocallyConstant.evalRingHom_apply s (∑ b ∈ _, _), map_sum]
      simp only [map_mul, LocallyConstant.evalRingHom_apply, LocallyConstant.map_apply,
        Function.comp_apply, hconst, mul_ite, mul_one, mul_zero]
      rw [Finset.sum_ite_eq, if_pos hmem]
    rw [hsum]
    apply Ideal.sum_mem
    intro b hb
    apply Ideal.mul_mem_right
    obtain ⟨s', rfl⟩ := (Set.Finite.mem_toFinset _).mp hb
    exact Ideal.mem_map_of_mem _ (hf s')

  have s2 : ∀ g : LocallyConstant S B, (∀ s, IsUnit (g s)) → IsUnit g := by
    intro g hg
    have h : g * LocallyConstant.map Ring.inverse g = 1 := by
      ext s
      simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.map_apply,
        Function.comp_apply, LocallyConstant.coe_one, Pi.one_apply]
      exact Ring.mul_inverse_cancel _ (hg s)
    exact ⟨⟨g, LocallyConstant.map Ring.inverse g, h, by rw [mul_comm]; exact h⟩, rfl⟩

  have s3 : ∀ p : Polynomial (LocallyConstant S B),
      IsLocallyConstant (fun s : S => p.map (LocallyConstant.evalRingHom s)) := by
    intro p
    refine Polynomial.induction_on p ?_ ?_ ?_
    · intro a
      simp only [Polynomial.map_C, LocallyConstant.evalRingHom_apply]
      exact a.isLocallyConstant.comp Polynomial.C
    · intro p q hp hq
      simp only [Polynomial.map_add]
      exact IsLocallyConstant.comp₂ hp hq (· + ·)
    · intro n a _
      simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C, Polynomial.map_X,
        LocallyConstant.evalRingHom_apply]
      exact a.isLocallyConstant.comp (fun b => Polynomial.C b * Polynomial.X ^ (n + 1))

  have hu : ∀ m ∈ 𝔪, IsUnit (1 + m) := by
    intro m hm
    by_contra h
    have h1 : 1 + m ∈ 𝔪 := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)
    have h2 : (1 : B) ∈ 𝔪 := by
      have h3 := 𝔪.sub_mem h1 hm
      rwa [add_sub_cancel_right] at h3
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
  refine ⟨?_, ?_⟩
  ·
    intro f hf
    rw [Ideal.mem_jacobson_bot]
    intro y
    apply s2
    intro s
    have e : (f * y + 1) s = 1 + f s * y s := by
      simp only [LocallyConstant.coe_add, LocallyConstant.coe_mul, LocallyConstant.coe_one,
        Pi.add_apply, Pi.mul_apply, Pi.one_apply]
      ring
    rw [e]
    exact hu _ (Ideal.mul_mem_right _ _ (s1f f hf s))
  ·
    intro p hp a₀ h1 h2
    have hev : ∀ (s : S) (x : LocallyConstant S B) (q : Polynomial (LocallyConstant S B)),
        (q.map (LocallyConstant.evalRingHom s)).eval (x s) = (q.eval x) s := by
      intro s x q
      rw [Polynomial.eval_map, ← LocallyConstant.evalRingHom_apply s x, Polynomial.eval₂_hom,
        LocallyConstant.evalRingHom_apply]
    have hd : ∀ s, IsUnit ((p.derivative.eval a₀) s) := by
      obtain ⟨w, hw⟩ := h2.exists_right_inv
      obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective w
      rw [← map_mul, ← map_one (Ideal.Quotient.mk I), Ideal.Quotient.eq] at hw
      intro s
      have hm := s1f _ hw s
      have e : (p.derivative.eval a₀ * v - 1) s = (p.derivative.eval a₀) s * v s - 1 := by
        simp only [LocallyConstant.coe_sub, LocallyConstant.coe_mul, LocallyConstant.coe_one,
          Pi.sub_apply, Pi.mul_apply, Pi.one_apply]
      rw [e] at hm
      have hu' := hu _ hm
      have e2 : (1 : B) + ((p.derivative.eval a₀) s * v s - 1) = (p.derivative.eval a₀) s * v s := by
        ring
      rw [e2] at hu'
      exact isUnit_of_mul_isUnit_left hu'
    have H : ∀ s, ∃ r, (p.map (LocallyConstant.evalRingHom s)).IsRoot r ∧ r - a₀ s ∈ 𝔪 := by
      intro s
      refine HenselianLocalRing.is_henselian (p.map (LocallyConstant.evalRingHom s))
        (hp.map _) (a₀ s) ?_ ?_
      · rw [hev]; exact s1f _ h1 s
      · rw [Polynomial.derivative_map, hev]; exact hd s
    let c : Polynomial B → B → B := fun q b =>
      if h : ∃ r, q.IsRoot r ∧ r - b ∈ 𝔪 then Classical.choose h else b
    have hc : ∀ q b, (∃ r, q.IsRoot r ∧ r - b ∈ 𝔪) → q.IsRoot (c q b) ∧ c q b - b ∈ 𝔪 := by
      intro q b h
      have e : c q b = Classical.choose h := dif_pos h
      rw [e]
      exact Classical.choose_spec h
    have hlc : IsLocallyConstant
        (fun s => c (p.map (LocallyConstant.evalRingHom s)) (a₀ s)) :=
      ((s3 p).prodMk a₀.isLocallyConstant).comp (fun z => c z.1 z.2)
    let a : LocallyConstant S B :=
      ⟨fun s => c (p.map (LocallyConstant.evalRingHom s)) (a₀ s), hlc⟩
    have ha : ∀ s, a s = c (p.map (LocallyConstant.evalRingHom s)) (a₀ s) := fun s => rfl
    refine ⟨a, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def]
      ext s
      rw [← hev s a p, ha, LocallyConstant.coe_zero, Pi.zero_apply]
      exact (hc _ _ (H s)).1
    · apply s1b
      intro s
      rw [LocallyConstant.coe_sub, Pi.sub_apply, ha]
      exact (hc _ _ (H s)).2

theorem wc_ppu_lc_thickening_square {X : Scheme.{u}} (x : X)
    (B : Type u) [CommRing B] [IsLocalRing B] (a' : Spec (.of B) ⟶ X) [WeaklyEtale a']
    (c : Limits.pullback a' (X.fromSpecResidueField x) ⟶
          Spec (.of (B ⧸ IsLocalRing.maximalIdeal B)))
    (g : X.residueField x →+* B ⧸ IsLocalRing.maximalIdeal B)
    (hsq : IsPullback (Limits.pullback.fst a' (X.fromSpecResidueField x)) c (𝟙 (Spec (.of B)))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B)))))
    (hg : Function.Bijective g)
    (hcg : c ≫ Spec.map (CommRingCat.ofHom g) = Limits.pullback.snd a' (X.fromSpecResidueField x))
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S] :
    ∃ (_ : WeaklyEtale (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))
      (cS : Limits.pullback (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') (X.fromSpecResidueField x) ⟶
        Spec (.of (LocallyConstant S B ⧸ Ideal.map
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B) (IsLocalRing.maximalIdeal B))))
      (θ : Limits.pullback (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') (X.fromSpecResidueField x) ≅
        Spec (.of (LocallyConstant S (X.residueField x)))),
      IsPullback (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') (X.fromSpecResidueField x))
        cS (𝟙 _) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.map
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B) (IsLocalRing.maximalIdeal B))))) ∧
      θ.hom ≫ Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom :
          X.residueField x →+* LocallyConstant S (X.residueField x))) =
        Limits.pullback.snd _ (X.fromSpecResidueField x) :=
by
  classical



  have hInd : ∀ (P : Type u) [CommRing P] [Algebra B P] [Algebra.FinitePresentation B P]
      (h : P →ₐ[B] LocallyConstant S B), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra B E),
        Algebra.Etale B E ∧ ∃ (α : P →ₐ[B] E) (β : E →ₐ[B] LocallyConstant S B), β.comp α = h := by
    intro P _ _ _ h
    obtain ⟨t, ht⟩ := (Algebra.FiniteType.of_finitePresentation (R := B) (A := P)).out
    let Fl : LocallyConstant S (t → B) := LocallyConstant.unflip (fun j : t => h j)
    let ι : Type u := Set.range Fl
    haveI : Finite ι := (LocallyConstant.range_finite Fl).to_subtype
    let G : S → ι := fun s => ⟨Fl s, Set.mem_range_self s⟩
    have hG : IsLocallyConstant G :=
      IsLocallyConstant.desc G Subtype.val Fl.isLocallyConstant Subtype.val_injective
    let Gl : LocallyConstant S ι := ⟨G, hG⟩
    let β : (ι → B) →ₐ[B] LocallyConstant S B :=
      { toFun := fun v => Gl.map v
        map_one' := by ext; rfl
        map_mul' := fun v w => by ext; rfl
        map_zero' := by ext; rfl
        map_add' := fun v w => by ext; rfl
        commutes' := fun b => by ext; rfl }
    have hσ : ∀ i : ι, ∃ s, Fl s = i.1 := fun i => i.2
    choose σ hσ' using hσ
    let ev : S → (LocallyConstant S B →ₐ[B] B) := fun s =>
      { LocallyConstant.evalRingHom s with commutes' := fun b => rfl }
    let α : P →ₐ[B] (ι → B) := AlgHom.pi (fun i => (ev (σ i)).comp h)
    refine ⟨ι → B, inferInstance, inferInstance, inferInstance, α, β, ?_⟩
    apply AlgHom.ext
    intro p
    apply LocallyConstant.ext
    intro s
    show h p (σ (G s)) = h p s
    have hs' : Fl (σ (G s)) = Fl s := hσ' (G s)
    have heq : (ev (σ (G s))).comp h = (ev s).comp h := by
      apply AlgHom.ext_of_adjoin_eq_top ht
      intro j hj
      show h j (σ (G s)) = h j s
      exact congrFun hs' ⟨j, hj⟩
    exact congrArg (fun φ => φ p) heq



  have hIW : ∀ {R T : Type u} [CommRing R] [CommRing T] [Algebra R T],
      (∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
        (h : P →ₐ[R] T), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
          ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] T), β.comp α = h) → Algebra.WeaklyEtale R T := by
    intro R T _ _ _ hφ'
    have hL : ∀ (ι : Type) [Fintype ι] (ρ : MvPolynomial ι R) (a : ι → T),
        MvPolynomial.aeval a ρ = 0 →
        ∃ (E₀ : Type u) (_ : CommRing E₀) (_ : Algebra R E₀), Algebra.Etale R E₀ ∧
          ∃ (β₀ : E₀ →ₐ[R] T) (a₀ : ι → E₀), (∀ i, β₀ (a₀ i) = a i) ∧
            MvPolynomial.aeval a₀ ρ = 0 := by
      intro ι _ ρ a ha
      let I : Ideal (MvPolynomial ι R) := Ideal.span {ρ}
      haveI : Algebra.FinitePresentation R (MvPolynomial ι R ⧸ I) :=
        Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton ρ)
      have hI : ∀ p ∈ I, MvPolynomial.aeval a p = 0 := by
        intro p hp
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
        rw [map_mul, ha, mul_zero]
      let h : (MvPolynomial ι R ⧸ I) →ₐ[R] T := Ideal.Quotient.liftₐ I (MvPolynomial.aeval a) hI
      obtain ⟨E₀, _, _, hE, α, β₀, hαβ⟩ := hφ' _ h
      have hcomp : α.comp (Ideal.Quotient.mkₐ R I) =
          MvPolynomial.aeval (fun i => α (Ideal.Quotient.mkₐ R I (MvPolynomial.X i))) := by
        apply MvPolynomial.algHom_ext
        intro i
        simp
      refine ⟨E₀, inferInstance, inferInstance, hE, β₀,
        fun i => α (Ideal.Quotient.mkₐ R I (MvPolynomial.X i)), fun i => ?_, ?_⟩
      · have := congrArg (fun g : (MvPolynomial ι R ⧸ I) →ₐ[R] T =>
          g (Ideal.Quotient.mkₐ R I (MvPolynomial.X i))) hαβ
        simp only [AlgHom.comp_apply] at this
        rw [this]
        show Ideal.Quotient.lift I _ hI (Ideal.Quotient.mk I _) = a i
        rw [Ideal.Quotient.lift_mk]
        simp
      · rw [← hcomp, AlgHom.comp_apply]
        have : Ideal.Quotient.mkₐ R I ρ = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [this, map_zero]
    have hflat : Module.Flat R T := by
      apply Module.Flat.of_forall_isTrivialRelation
      intro l f x hx
      obtain ⟨E₀, _, _, hE, β₀, a₀, hβ, hρ⟩ := hL (Fin l)
        (∑ i, MvPolynomial.C (f i) * MvPolynomial.X i) x (by
          simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
          rw [← hx]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Algebra.smul_def])
      have h0 : ∑ i, f i • a₀ i = 0 := by
        simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X] at hρ
        rw [← hρ]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def]
      obtain ⟨k, A, y, hA, hA'⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (R := R) (M := E₀) (f := f) (x := a₀) h0
      refine ⟨k, A, fun j => β₀ (y j), fun i => ?_, hA'⟩
      rw [← hβ i, hA i, map_sum]
      simp only [map_smul]
    have hrep : ∀ w : TensorProduct R T T, ∃ (m : ℕ) (a b : Fin m → T),
        w = ∑ t, a t ⊗ₜ[R] b t := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      | tmul x y => exact ⟨1, fun _ => x, fun _ => y, by simp⟩
      | add w₁ w₂ h₁ h₂ =>
        obtain ⟨m₁, a₁, b₁, e₁⟩ := h₁
        obtain ⟨m₂, a₂, b₂, e₂⟩ := h₂
        refine ⟨m₁ + m₂, Fin.append a₁ a₂, Fin.append b₁ b₂, ?_⟩
        rw [Fin.sum_univ_add, e₁, e₂]
        simp [Fin.append_left, Fin.append_right]
    have hdiag : (Algebra.TensorProduct.lmul' R : TensorProduct R T T →ₐ[R] T).Flat := by
      letI : Algebra (TensorProduct R T T) T :=
        (Algebra.TensorProduct.lmul' R : TensorProduct R T T →ₐ[R] T).toRingHom.toAlgebra
      show Module.Flat (TensorProduct R T T) T
      apply Module.Flat.of_forall_isTrivialRelation
      intro l f x hx
      have hx' : ∑ i, Algebra.TensorProduct.lmul' R (f i) * x i = 0 := by
        rw [← hx]
        rfl
      choose m a b hab using fun i => hrep (f i)
      let ρ : MvPolynomial (Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i)))) R :=
        ∑ i, (∑ t : Fin (m i), MvPolynomial.X (Sum.inr (Sum.inl ⟨i, t⟩)) *
          MvPolynomial.X (Sum.inr (Sum.inr ⟨i, t⟩))) * MvPolynomial.X (Sum.inl i)
      have hev : ∀ (B : Type u) [CommRing B] [Algebra R B]
          (v : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → B),
          MvPolynomial.aeval v ρ = ∑ i, (∑ t : Fin (m i), v (Sum.inr (Sum.inl ⟨i, t⟩)) *
            v (Sum.inr (Sum.inr ⟨i, t⟩))) * v (Sum.inl i) := by
        intro B _ _ v
        simp only [ρ, map_sum, map_mul, MvPolynomial.aeval_X]
      let pt : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → T :=
        Sum.elim x (Sum.elim (fun p => a p.1 p.2) (fun p => b p.1 p.2))
      obtain ⟨E₀, _, _, hE, β₀, a₀, hβ, hρ⟩ := hL _ ρ pt (by
        rw [hev, ← hx']
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hab i, map_sum]
        simp [pt, Algebra.TensorProduct.lmul'_apply_tmul])
      let w₀ : Fin l → TensorProduct R E₀ E₀ := fun i =>
        ∑ t : Fin (m i), a₀ (Sum.inr (Sum.inl ⟨i, t⟩)) ⊗ₜ[R] a₀ (Sum.inr (Sum.inr ⟨i, t⟩))
      let x₀ : Fin l → E₀ := fun i => a₀ (Sum.inl i)
      haveI hWE : Algebra.WeaklyEtale R E₀ := inferInstance
      letI : Algebra (TensorProduct R E₀ E₀) E₀ :=
        (Algebra.TensorProduct.lmul' R : TensorProduct R E₀ E₀ →ₐ[R] E₀).toRingHom.toAlgebra
      haveI hE₀flat : Module.Flat (TensorProduct R E₀ E₀) E₀ := hWE.flat_lmul'
      have h0 : ∑ i, w₀ i • x₀ i = 0 := by
        rw [hev] at hρ
        rw [← hρ]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        show Algebra.TensorProduct.lmul' R (w₀ i) * x₀ i = _
        simp [w₀, x₀, map_sum, Algebra.TensorProduct.lmul'_apply_tmul]
      obtain ⟨k, A, z, hA, hA'⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (R := TensorProduct R E₀ E₀) (M := E₀) (f := w₀) (x := x₀) h0
      have hK : ∀ u : TensorProduct R E₀ E₀,
          Algebra.TensorProduct.lmul' R (Algebra.TensorProduct.map β₀ β₀ u) =
            β₀ (Algebra.TensorProduct.lmul' R u) := by
        intro u
        induction u using TensorProduct.induction_on with
        | zero => simp
        | tmul p q => simp [Algebra.TensorProduct.lmul'_apply_tmul]
        | add p q hp hq => simp only [map_add, hp, hq]
      have hw : ∀ i, Algebra.TensorProduct.map β₀ β₀ (w₀ i) = f i := by
        intro i
        rw [hab i]
        simp only [w₀, map_sum, Algebra.TensorProduct.map_tmul, hβ, pt, Sum.elim_inl,
          Sum.elim_inr]
      refine ⟨k, fun i j => Algebra.TensorProduct.map β₀ β₀ (A i j), fun j => β₀ (z j),
        fun i => ?_, fun j => ?_⟩
      · have := congrArg β₀ (hA i)
        rw [show β₀ (x₀ i) = x i from hβ (Sum.inl i)] at this
        rw [this, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        show β₀ (Algebra.TensorProduct.lmul' R (A i j) * z j) =
          Algebra.TensorProduct.lmul' R (Algebra.TensorProduct.map β₀ β₀ (A i j)) * β₀ (z j)
        rw [map_mul, hK]
      · have := congrArg (Algebra.TensorProduct.map β₀ β₀) (hA' j)
        rw [map_sum, map_zero] at this
        rw [← this]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, hw]
    exact Algebra.WeaklyEtale.mk hflat hdiag



  have hlfi : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T], Algebra.WeaklyEtale R T →
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R T))) := by
    intro R T _ _ _ hwe
    haveI := hwe
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R T))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := T))
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R T)))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := T) R).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R T)
      infer_instance
    exact WeaklyEtale.mk hf hd
  have hWc : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B))) :=
    hlfi B (LocallyConstant S B) (hIW hInd)
  have hW : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') := by
    haveI := hWc
    infer_instance



  have hconst : ∀ (b : B) (s : S),
      (LocallyConstant.constRingHom b : LocallyConstant S B) s = b := fun _ _ => rfl
  have hmem : ∀ (J : Ideal B) (f : LocallyConstant S B),
      f ∈ Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B) J ↔
        ∀ s, f s ∈ J := by
    intro J f
    constructor
    · intro hf s
      have hle : Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B) J ≤
          Ideal.comap (LocallyConstant.evalRingHom s) J := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, Ideal.mem_comap, LocallyConstant.evalRingHom_apply, hconst]
        exact hb
      have h := hle hf
      rw [Ideal.mem_comap, LocallyConstant.evalRingHom_apply] at h
      exact h
    · intro hf
      have hsum : f = ∑ b ∈ (LocallyConstant.range_finite f).toFinset,
          (LocallyConstant.constRingHom b : LocallyConstant S B) *
            LocallyConstant.map (fun x : B => if x = b then (1 : B) else 0) f := by
        ext s
        have hmem' : f s ∈ (LocallyConstant.range_finite f).toFinset :=
          (Set.Finite.mem_toFinset _).mpr (Set.mem_range_self s)
        rw [← LocallyConstant.evalRingHom_apply s (∑ b ∈ _, _), map_sum]
        simp only [map_mul, LocallyConstant.evalRingHom_apply, LocallyConstant.map_apply,
          Function.comp_apply, hconst, mul_ite, mul_one, mul_zero]
        rw [Finset.sum_ite_eq, if_pos hmem']
      rw [hsum]
      apply Ideal.sum_mem
      intro b hb
      apply Ideal.mul_mem_right
      obtain ⟨s', rfl⟩ := (Set.Finite.mem_toFinset _).mp hb
      exact Ideal.mem_map_of_mem _ (hf s')



  have hquot : ∀ (J : Ideal B) (K : Type u) [CommRing K] (g : K →+* B ⧸ J),
      Function.Bijective g →
      ∃ Φ : (LocallyConstant S B ⧸
          Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B) J) ≃+*
            LocallyConstant S K,
        ∀ y : K, Φ (Ideal.quotientMap
            (Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B) J)
            (LocallyConstant.constRingHom : B →+* LocallyConstant S B) Ideal.le_comap_map (g y)) =
          LocallyConstant.const S y := by
    intro J K _ g hg
    let gi : B ⧸ J ≃+* K := (RingEquiv.ofBijective g hg).symm
    let ρ : LocallyConstant S B →+* LocallyConstant S K :=
      (LocallyConstant.mapRingHom (gi : B ⧸ J →+* K)).comp
        (LocallyConstant.mapRingHom (Ideal.Quotient.mk J))
    have hρ : ∀ f s, ρ f s = gi (Ideal.Quotient.mk J (f s)) := fun _ _ => rfl
    have hgi : ∀ y, gi (g y) = y := fun y => (RingEquiv.ofBijective g hg).symm_apply_apply y
    have hmk : Function.Surjective (Ideal.Quotient.mk J) := Ideal.Quotient.mk_surjective
    have hsurj : Function.Surjective ρ := by
      intro k
      refine ⟨k.map (fun y => Function.surjInv hmk (g y)), ?_⟩
      ext s
      rw [hρ]
      show gi (Ideal.Quotient.mk J (Function.surjInv hmk (g (k s)))) = k s
      rw [Function.surjInv_eq hmk, hgi]
    have hker : Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B) J =
        RingHom.ker ρ := by
      ext f
      rw [hmem J f, RingHom.mem_ker]
      constructor
      · intro hf
        ext s
        change gi (Ideal.Quotient.mk J (f s)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hf s), map_zero]
      · intro hf s
        have h1 := LocallyConstant.ext_iff.mp hf s
        change gi (Ideal.Quotient.mk J (f s)) = 0 at h1
        have h0 : Ideal.Quotient.mk J (f s) = 0 := (map_eq_zero_iff gi gi.injective).mp h1
        exact Ideal.Quotient.eq_zero_iff_mem.mp h0
    refine ⟨(Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj),
      fun y => ?_⟩
    obtain ⟨b, hb⟩ := hmk (g y)
    rw [← hb, Ideal.quotientMap_mk, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
    ext s
    rw [hρ]
    show gi (Ideal.Quotient.mk J b) = y
    rw [hb, hgi]



  have htinv : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (I : Ideal R),
      IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R')))))
        (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R')
          Ideal.le_comap_map)))
        (Spec.map (CommRingCat.ofHom (algebraMap R R')))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
    intro R R' _ _ _ I
    apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
    have hcomm : ∀ r : R, Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R')
        Ideal.le_comap_map (Ideal.Quotient.mk I r) =
        Ideal.Quotient.mk (I.map (algebraMap R R')) (algebraMap R R' r) := fun r =>
      Ideal.quotientMap_mk
    have w : CommRingCat.ofHom (algebraMap R R') ≫
        CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R'))) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
        CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R')
          Ideal.le_comap_map) := by
      ext r
      exact (hcomm r).symm
    have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R R'))
        (CommRingCat.ofHom (Ideal.Quotient.mk I))) (r : R),
        s.inl.hom (algebraMap R R' r) = s.inr.hom (Ideal.Quotient.mk I r) := by
      intro s r
      have := congrArg (fun φ => φ.hom r) s.condition
      simpa using this
    have H : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R R'))
        (CommRingCat.ofHom (Ideal.Quotient.mk I))),
        I.map (algebraMap R R') ≤ RingHom.ker s.inl.hom := by
      intro s
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, key s x, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
        map_zero]
    refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk w
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (fun a ha => H s ha)))
      ?_ ?_ ?_)
    · intro s
      ext x
      exact Ideal.Quotient.lift_mk (I.map (algebraMap R R')) s.inl.hom (fun a ha => H s ha)
    · intro s
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, hcomm, Ideal.Quotient.lift_mk]
      exact key s x
    · intro s m h1 _
      ext x
      have := congrArg (fun φ => φ.hom x) h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply] at this
      simp only [CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
      exact this

  have hid := IsPullback.id_vert
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B))))
  have he1 := hsq.isoIsPullback_hom_fst _ _ hid
  have he2 : (hsq.isoIsPullback _ _ hid).hom = c := by
    have := hsq.isoIsPullback_hom_snd _ _ hid
    rwa [Category.comp_id] at this
  have hR : IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B))))
      (Spec.map (CommRingCat.ofHom g)) a' (X.fromSpecResidueField x) :=
    IsPullback.of_iso (IsPullback.of_hasPullback a' (X.fromSpecResidueField x))
      (hsq.isoIsPullback _ _ hid) (Iso.refl _) (Iso.refl _) (Iso.refl _)
      (by rw [Iso.refl_hom, Category.comp_id, he1])
      (by rw [Iso.refl_hom, Category.comp_id, he2, hcg])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
  have hT : IsPullback
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.map
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B) (IsLocalRing.maximalIdeal B)))))
      (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (Ideal.map
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B) (IsLocalRing.maximalIdeal B))
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B) Ideal.le_comap_map)) ≫
        Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x) :=
    (htinv B (LocallyConstant S B) (IsLocalRing.maximalIdeal B)).paste_vert hR
  have hE1 := (IsPullback.of_hasPullback (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x)).isoIsPullback_hom_fst _ _ hT
  have hE2 := (IsPullback.of_hasPullback (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x)).isoIsPullback_hom_snd _ _ hT



  obtain ⟨Φ, hΦ⟩ := hquot (IsLocalRing.maximalIdeal B) (X.residueField x) g hg
  have hring : CommRingCat.ofHom (LocallyConstant.constRingHom :
        X.residueField x →+* LocallyConstant S (X.residueField x)) ≫
      CommRingCat.ofHom (Φ.symm : LocallyConstant S (X.residueField x) →+* _) =
      CommRingCat.ofHom g ≫ CommRingCat.ofHom (Ideal.quotientMap (Ideal.map
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B) (IsLocalRing.maximalIdeal B))
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B) Ideal.le_comap_map) := by
    ext y
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
      Function.comp_apply]
    exact (congrArg Φ.symm (hΦ y)).symm.trans (Φ.symm_apply_apply _)
  have hspec := congrArg Spec.map hring
  rw [Spec.map_comp, Spec.map_comp] at hspec
  refine ⟨hW, _, (IsPullback.of_hasPullback _ _).isoIsPullback _ _ hT ≪≫
    Scheme.Spec.mapIso Φ.symm.toCommRingCatIso.op,
    IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, hE1]⟩, ?_⟩
  exact (congrArg (fun m => ((IsPullback.of_hasPullback _ _).isoIsPullback _ _ hT).hom ≫ m)
    hspec).trans hE2

theorem wc_ppu_lc_field_wcontr (K : Type u) [Field K] [IsSepClosed K]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S]
    [ExtremallyDisconnected S] :
    IsAffine (Spec (.of (LocallyConstant S K))) ∧
    IsClosed {z : Spec (.of (LocallyConstant S K)) | IsClosed ({z} : Set (Spec (.of (LocallyConstant S K))))} ∧
    (∀ z : Spec (.of (LocallyConstant S K)), ∃! y : Spec (.of (LocallyConstant S K)),
       IsClosed ({y} : Set (Spec (.of (LocallyConstant S K)))) ∧ z ⤳ y) ∧
    ExtremallyDisconnected {z : Spec (.of (LocallyConstant S K)) | IsClosed ({z} : Set (Spec (.of (LocallyConstant S K))))} ∧
    (∀ z : Spec (.of (LocallyConstant S K)), IsClosed ({z} : Set (Spec (.of (LocallyConstant S K)))) →
       HenselianLocalRing ((Spec (.of (LocallyConstant S K))).presheaf.stalk z) ∧
       IsSepClosed ((Spec (.of (LocallyConstant S K))).residueField z)) :=
by
  classical

  have hmax : ∀ s : S,
      (RingHom.ker (LocallyConstant.evalRingHom s : LocallyConstant S K →+* K)).IsMaximal :=
    fun s => RingHom.ker_isMaximal_of_surjective _ (fun c => ⟨LocallyConstant.const S c, rfl⟩)

  have L1 : ∀ z : PrimeSpectrum (LocallyConstant S K), ∃ s : S,
      z.asIdeal = RingHom.ker (LocallyConstant.evalRingHom s : LocallyConstant S K →+* K) := by
    intro z
    by_contra h
    push_neg at h
    have hg : ∀ s : S, ∃ g : LocallyConstant S K, g s = 0 ∧ g ∉ z.asIdeal := by
      intro s
      by_contra hc
      push_neg at hc
      apply h s
      symm
      apply (hmax s).eq_of_le z.isPrime.ne_top
      intro g hg
      exact hc g ((RingHom.mem_ker (f := (LocallyConstant.evalRingHom s :
        LocallyConstant S K →+* K))).mp hg)
    choose g hg0 hgz using hg
    obtain ⟨F, hF⟩ := isCompact_univ.elim_finite_subcover (fun s => {t | g s t = 0})
      (fun s => (g s).isLocallyConstant.isOpen_fiber 0)
      (fun t _ => Set.mem_iUnion.mpr ⟨t, hg0 t⟩)
    have hprod : ∏ s ∈ F, g s = 0 := by
      ext t
      have ht := hF (Set.mem_univ t)
      simp only [Set.mem_iUnion] at ht
      obtain ⟨s, hs, hst⟩ := ht
      have e : (∏ s ∈ F, g s) t = ∏ s ∈ F, g s t :=
        map_prod (LocallyConstant.evalRingHom t : LocallyConstant S K →+* K) g F
      rw [e]
      exact Finset.prod_eq_zero hs hst
    have hmem : ∏ s ∈ F, g s ∈ z.asIdeal := hprod ▸ z.asIdeal.zero_mem
    obtain ⟨s, _, hs⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
    exact hgz s hs

  have hcl : ∀ z : Spec (.of (LocallyConstant S K)),
      IsClosed ({z} : Set (Spec (.of (LocallyConstant S K)))) := by
    intro z
    obtain ⟨s, hs⟩ := L1 z
