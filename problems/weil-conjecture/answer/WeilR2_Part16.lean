          exact (congrArg (fun φ => φ c') (hcc g (wcProjKStr K (d + 1)) z)).symm }
    have hker' : RingHom.ker ψ = Ideal.span {hh} := by
      rw [← hkerg']; ext r; rw [RingHom.mem_ker, RingHom.mem_ker]; rfl
    let δS : (wcProjK K (d + 1)).presheaf.stalk (g z) →+
        IsLocalRing.ResidueField (Z.presheaf.stalk z) :=
      (IsLocalRing.ResidueField.map (g.stalkMap z).hom).toAddMonoidHom.comp δ₀
    have hδSL : ∀ a b, δS (a * b) =
        IsLocalRing.residue _ (ψ a) * δS b + IsLocalRing.residue _ (ψ b) * δS a :=
      htrans (g.stalkMap z).hom (RingHom.id _) δ₀ hδ₀L
    have hδSK : ∀ c' : K, δS (algebraMap K _ c') = 0 := fun c' =>
      (congrArg (IsLocalRing.ResidueField.map (g.stalkMap z).hom) (hδ₀K c')).trans (map_zero _)
    have hδSh : δS hh ≠ 0 := by
      have e2 := (congrArg (IsLocalRing.ResidueField.map (g.stalkMap z).hom) hδh).trans (map_one _)
      exact e2.symm ▸ one_ne_zero
    obtain ⟨hSfs, hSfree, hSfin, hSrk⟩ :=
      wc_ldp_il_hypersurface_criterion K _ _ ψ hsurj hh hker' δS hδSL hδSK hδSh
    have hrk : Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄K] = d := by
      omega
    exact wc_ldp_il_spread_abs K (g ≫ wcProjKStr K (d + 1)) d z hSfs hSfree hSfin hrk
  refine ⟨Over.mk (g ≫ wcProjKStr K (d + 1)), hprop, hsm, g, hg, rfl, ?_,
    fun p hp => (hrange p).mpr hp⟩
  intro x c hx
  have hk := (hstalk x c hx).2
  have hker0 : ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (g x) hx).hom
      (wcLdpSec K (d + 1) (wcLdpQuad K (d + 1) a) c) ∈ RingHom.ker (g.stalkMap x).hom := by
    rw [hk]; exact Ideal.subset_span rfl
  have hmem : (g.stalkMap x).hom (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (g x) hx).hom
      (wcLdpSec K (d + 1) (wcLdpQuad K (d + 1) a) c)) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk x) := by
    rw [RingHom.mem_ker.mp hker0]; exact Ideal.zero_mem _
  have e0 : wcLdpGerm K (d + 1) g (wcLdpQuad K (d + 1) a) c x hx =
      (g.stalkMap x).hom (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (g x) hx).hom
        (wcLdpSec K (d + 1) (wcLdpQuad K (d + 1) a) c)) :=
    (Scheme.Hom.germ_stalkMap_apply g (wcSgD K (d + 1) c) x hx _).symm
  have key : wcLdpGerm K (d + 1) g (wcLdpQuad K (d + 1) a) c x hx ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk x) := by
    rw [e0]; exact hmem
  exact key

theorem wc_beq_point_generators : ∀ (X : Scheme.{u}), IsLocallyNoetherian X → ∀ (p₀ : X)
    (Z : TopologicalSpace.Closeds X), (Z : Set X) = {p₀} →
    ∀ (k : ℕ) (gh : Fin k → X.presheaf.stalk p₀),
    Ideal.span (Set.range gh) = IsLocalRing.maximalIdeal (X.presheaf.stalk p₀) →
    ∃ (U : X.affineOpens) (hp : p₀ ∈ U.1) (g : Fin k → Γ(X, U.1)),
      (∀ b, (X.presheaf.germ U.1 p₀ hp).hom (g b) = gh b) ∧
      (Scheme.IdealSheafData.vanishingIdeal Z).ideal U = Ideal.span (Set.range g) :=
by
  classical
  intro X hX p₀ Z hZ k gh hgh

  have core : ∀ (A S : Type u) [CommRing A] [IsNoetherianRing A] [CommRing S] [Algebra A S]
      (𝔭 : Ideal A) [𝔭.IsPrime] [IsLocalization.AtPrime S 𝔭] [IsLocalRing S] (gh : Fin k → S),
      Ideal.span (Set.range gh) = IsLocalRing.maximalIdeal S →
      ∃ (f c : A) (a : Fin k → A), f ∉ 𝔭 ∧ c ∣ f ∧
        (∀ b, algebraMap A S (a b) = algebraMap A S c * gh b) ∧
        ∀ (B : Type u) [CommRing B] (ρ : A →+* B) (g : Fin k → B), IsUnit (ρ f) →
          (∀ b, g b * ρ c = ρ (a b)) → Ideal.map ρ 𝔭 = Ideal.span (Set.range g) := by
    intro A S _ _ _ _ 𝔭 _ _ _ gh hgh
    obtain ⟨c₀, hc₀⟩ := IsLocalization.exist_integer_multiples_of_finite 𝔭.primeCompl gh
    have hc₀' : ∀ b, ∃ y : A, algebraMap A S y = (c₀ : A) • gh b :=
      fun b => RingHom.mem_rangeS.mp (hc₀ b)
    choose a ha using hc₀'
    have ha' : ∀ b, algebraMap A S (a b) = algebraMap A S (c₀ : A) * gh b := by
      intro b; rw [ha b, Algebra.smul_def]
    have ha_mem : ∀ b, a b ∈ 𝔭 := by
      intro b
      rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff S 𝔭, ha', ← hgh]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, rfl⟩)
    have hcunit : IsUnit (algebraMap A S (c₀ : A)) := IsLocalization.map_units S c₀
    have hmapJ : Ideal.map (algebraMap A S) 𝔭 ≤
        Ideal.map (algebraMap A S) (Ideal.span (Set.range a)) := by
      rw [IsLocalization.AtPrime.map_eq_maximalIdeal, ← hgh, Ideal.span_le]
      rintro _ ⟨b, rfl⟩
      have e : gh b = ↑hcunit.unit⁻¹ * algebraMap A S (a b) := by
        rw [ha', ← mul_assoc, IsUnit.val_inv_mul, one_mul]
      rw [e]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨b, rfl⟩))
    obtain ⟨r, q, hq⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian 𝔭)
    have hs : ∀ i, ∃ s : 𝔭.primeCompl, (s : A) * q i ∈ Ideal.span (Set.range a) := by
      intro i
      have hqi : q i ∈ 𝔭 := hq ▸ Submodule.subset_span ⟨i, rfl⟩
      have h1 := hmapJ (Ideal.mem_map_of_mem _ hqi)
      obtain ⟨⟨x₁, x₂⟩, hx⟩ := (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl S).mp h1
      rw [← map_mul] at hx
      obtain ⟨e, he⟩ := (IsLocalization.eq_iff_exists 𝔭.primeCompl S).mp hx
      refine ⟨e * x₂, ?_⟩
      have e2 : ((e * x₂ : 𝔭.primeCompl) : A) * q i = (e : A) * (x₁ : A) := by
        rw [Submonoid.coe_mul, ← he]; ring
      rw [e2]
      exact Ideal.mul_mem_left _ _ x₁.2
    choose s hs using hs
    have hs0 : (∏ i, (s i : A)) ∈ 𝔭.primeCompl :=
      Submonoid.prod_mem _ (fun i _ => (s i).2)
    have hsJ : ∀ y ∈ 𝔭, (∏ i, (s i : A)) * y ∈ Ideal.span (Set.range a) := by
      intro y hy
      rw [← hq] at hy
      obtain ⟨w, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hy
      rw [Finset.mul_sum]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      obtain ⟨t, ht⟩ := Finset.dvd_prod_of_mem (fun i => (s i : A)) (Finset.mem_univ i)
      rw [smul_eq_mul, show (∏ i, (s i : A)) * (w i * q i) = (w i * t) * ((s i : A) * q i) by
        rw [ht]; ring]
      exact Ideal.mul_mem_left _ _ (hs i)
    refine ⟨(c₀ : A) * ∏ i, (s i : A), c₀, a, ?_, dvd_mul_right _ _, ha', ?_⟩
    · exact (𝔭.primeCompl.mul_mem c₀.2 hs0 : _)
    · intro B _ ρ g hf hg
      have hρc : IsUnit (ρ c₀) := isUnit_of_dvd_unit (map_dvd ρ (dvd_mul_right _ _)) hf
      have hρs : IsUnit (ρ (∏ i, (s i : A))) :=
        isUnit_of_dvd_unit (map_dvd ρ (dvd_mul_left _ _)) hf
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro y hy
        rw [Ideal.mem_comap]
        have hJ' : Ideal.map ρ (Ideal.span (Set.range a)) ≤ Ideal.span (Set.range g) := by
          rw [Ideal.map_span, Ideal.span_le]
          rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
          rw [← hg b]
          exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨b, rfl⟩)
        have h1 := hJ' (Ideal.mem_map_of_mem ρ (hsJ y hy))
        rw [map_mul] at h1
        have e : ρ y = ↑hρs.unit⁻¹ * (ρ (∏ i, (s i : A)) * ρ y) := by
          rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
        rw [e]
        exact Ideal.mul_mem_left _ _ h1
      · rw [Ideal.span_le]
        rintro _ ⟨b, rfl⟩
        have e : g b = ρ (a b) * ↑hρc.unit⁻¹ := by
          rw [← hg b, mul_assoc, IsUnit.mul_val_inv, mul_one]
        rw [e]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (ha_mem b))

  haveI := hX
  obtain ⟨W, hW, hpW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := p₀) trivial
  let V : X.affineOpens := ⟨W, hW⟩
  have hp : p₀ ∈ V.1 := hpW
  haveI : IsNoetherianRing Γ(X, V.1) := IsLocallyNoetherian.component_noetherian V
  letI : Algebra Γ(X, V.1) (X.presheaf.stalk p₀) := (X.presheaf.germ V.1 p₀ hp).hom.toAlgebra
  haveI : IsLocalization.AtPrime (X.presheaf.stalk p₀) (V.2.primeIdealOf ⟨p₀, hp⟩).asIdeal :=
    V.2.isLocalization_stalk ⟨p₀, hp⟩
  obtain ⟨f, c, a, hf𝔭, hcf, ha, hfin⟩ :=
    core Γ(X, V.1) (X.presheaf.stalk p₀) (V.2.primeIdealOf ⟨p₀, hp⟩).asIdeal gh hgh
  have hfunit : IsUnit ((X.presheaf.germ V.1 p₀ hp).hom f) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk p₀) _ f).mpr hf𝔭
  have hcunit : IsUnit ((X.presheaf.germ V.1 p₀ hp).hom c) :=
    isUnit_of_dvd_unit (map_dvd _ hcf) hfunit
  have hpU : p₀ ∈ X.basicOpen f := (Scheme.mem_basicOpen X f p₀ hp).mpr hfunit
  have hresf : IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) :=
    X.toRingedSpace.isUnit_res_basicOpen f
  have hresc : IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom c) :=
    isUnit_of_dvd_unit (map_dvd _ hcf) hresf
  let g : Fin k → Γ(X, X.basicOpen f) := fun b =>
    (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (a b) * ↑hresc.unit⁻¹
  have hg : ∀ b, g b * (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom c =
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (a b) := by
    intro b
    simp only [g]
    rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
  have hvan : (Scheme.IdealSheafData.vanishingIdeal Z).ideal V =
      (V.2.primeIdealOf ⟨p₀, hp⟩).asIdeal := by
    rw [Scheme.IdealSheafData.vanishingIdeal_ideal, hZ]
    have e : hW.fromSpec ⁻¹' {p₀} = {hW.primeIdealOf ⟨p₀, hp⟩} := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hy
        apply hW.fromSpec.isOpenEmbedding.injective
        exact hy.trans (hW.fromSpec_primeIdealOf ⟨p₀, hp⟩).symm
      · rintro rfl
        exact hW.fromSpec_primeIdealOf ⟨p₀, hp⟩
    exact (congrArg PrimeSpectrum.vanishingIdeal e).trans
      (PrimeSpectrum.vanishingIdeal_singleton _)
  refine ⟨X.affineBasicOpen f, hpU, g, ?_, ?_⟩
  · intro b
    show (X.presheaf.germ (X.basicOpen f) p₀ hpU).hom (g b) = gh b
    have h1 := congrArg (X.presheaf.germ (X.basicOpen f) p₀ hpU).hom (hg b)
    rw [map_mul] at h1
    erw [TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply] at h1
    have h2 : (X.presheaf.germ V.1 p₀ hp).hom (a b) =
        (X.presheaf.germ V.1 p₀ hp).hom c * gh b := ha b
    rw [h2, mul_comm] at h1
    exact hcunit.mul_left_cancel h1
  · rw [← (Scheme.IdealSheafData.vanishingIdeal Z).map_ideal_basicOpen V f, hvan]
    exact hfin _ _ g hresf hg

theorem wc_beq_affine_blowup_model : ∀ (K : Type u) [Field K] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of K)), IsSeparated fX → ∀ (I : X.IdealSheafData) (U : X.affineOpens)
