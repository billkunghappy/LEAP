      wcCsdIsBlowup (I.comap U.1.ι) (ι ≫ Limits.pullback.fst (U.1.ι ≫ fX) (wcProjKStr K m)) ∧
      (I.comap U.1.ι).ideal ⟨⊤, @isAffineOpen_top U.1.toScheme U.2⟩ =
        Ideal.span (Set.range (wcBeqGU U g)) ∧
      wcBeqChartRel K (U.1.ι ≫ fX) m ι (wcBeqGU U g) :=
by
  intro K _ X fX hsep I U m g hI Yb r hr
  haveI : IsSeparated fX := hsep

  have s5 : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (I : X.IdealSheafData) (n m : ℕ) (U : Fin (n + 1) → X.Opens) (hU : ∀ J, IsAffineOpen (U J)) (g : ∀ J, Fin (m + 1) → Γ(X, U J)) (w : ∀ J L, Γ(X, U J ⊓ U L)), (⨆ J, U J) = ⊤ → (∀ J, I.ideal ⟨U J, hU J⟩ = Ideal.span (Set.range (g J))) → (∀ J L, IsUnit (w J L)) → (∀ J L l, X.presheaf.map (homOfLE (inf_le_right : U J ⊓ U L ≤ U L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : U J ⊓ U L ≤ U J)).op (g J l)) → ∀ (P : Scheme.{u}) (ι : P ⟶ Limits.pullback fX (wcProjKStr K m)), IsClosedImmersion ι → (∀ J k, (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J k) ∈ nonZeroDivisors Γ(P, (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k)) → (∀ J k l, (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J l) = (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_right (wcSgE K m k l) * (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J k)) → (∀ J k (y : Γ(Limits.pullback fX (wcProjKStr K m), Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k)), ι.app (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) y = 0 → ∀ (R : Type u) [CommRing R] (π : Γ(Limits.pullback fX (wcProjKStr K m), Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) →+* R) (c : R) (ρ : Fin (m + 1) → R), (∀ l, π ((Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J l)) = c * ρ l) → (∀ l, π ((Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) inf_le_right (wcSgE K m k l)) * ρ k = ρ l) → c ∈ nonZeroDivisors R → IsUnit (ρ k) → π y = 0) → wcCsdIsBlowup I (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) := by
    intro X fX I n m U hU g w hcov hI hw htr P ι hι P1 P2 P3
    haveI := hι
    have hres : ∀ (Y : Scheme.{u}) (A B C : Y.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
        (x : Γ(Y, A)), Y.presheaf.map (homOfLE h2).op (Y.presheaf.map (homOfLE h1).op x) =
          Y.presheaf.map (homOfLE h3).op x := by
      intro Y A B C h1 h2 h3 x
      rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hAmap : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (O1 O2 : A.Opens) (h12 : O2 ≤ O1)
        (e1 : O1 ≤ f ⁻¹ᵁ V) (e2 : O2 ≤ f ⁻¹ᵁ V) (x : Γ(B, V)),
        A.presheaf.map (homOfLE h12).op (f.appLE V O1 e1 x) = f.appLE V O2 e2 x := by
      intro A B f V O1 O2 h12 e1 e2 x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
    have hmapA : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V V' : B.Opens) (O : A.Opens) (hVV : V ≤ V')
        (e : O ≤ f ⁻¹ᵁ V) (e' : O ≤ f ⁻¹ᵁ V') (x : Γ(B, V')),
        f.appLE V O e (B.presheaf.map (homOfLE hVV).op x) = f.appLE V' O e' x := by
      intro A B f V V' O hVV e e' x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have hcompA : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (k : B ⟶ C) (V : C.Opens) (V' : B.Opens)
        (O : A.Opens) (e1 : V' ≤ k ⁻¹ᵁ V) (e2 : O ≤ f ⁻¹ᵁ V') (e3 : O ≤ (f ≫ k) ⁻¹ᵁ V)
        (x : Γ(C, V)), f.appLE V' O e2 (k.appLE V V' e1 x) = (f ≫ k).appLE V O e3 x := by
      intro A B C f k V V' O e1 e2 e3 x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_comp_appLE]
    have hsub : ∀ {A B : Scheme.{u}} (f f' : A ⟶ B), f = f' → ∀ (V : B.Opens) (O : A.Opens)
        (e : O ≤ f ⁻¹ᵁ V) (e' : O ≤ f' ⁻¹ᵁ V) (x : Γ(B, V)), f.appLE V O e x = f'.appLE V O e' x := by
      intro A B f f' hff
      subst hff
      intro V O e e' x
      rfl
    have hcovD : (⨆ k, wcSgD K m k) = ⊤ := wc_pp_basicOpen_cover K m
    have haffD : ∀ k, IsAffineOpen (wcSgD K m k) := by
      intro k
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
        MvPolynomial.gradedAlgebra
      exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos
    have hpt : ∀ x : X, ∃ J, x ∈ U J := by
      intro x
      have hx : x ∈ (⨆ J, U J) := by rw [hcov]; trivial
      exact TopologicalSpace.Opens.mem_iSup.mp hx
    have hptD : ∀ y : wcProjK K m, ∃ k, y ∈ wcSgD K m k := by
      intro y
