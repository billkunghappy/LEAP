        closure_minimal (Set.singleton_subset_iff.mpr ⟨i, rfl⟩) hSig
      obtain ⟨j, hj⟩ := hsub hmem
      exact h j hj

  obtain ⟨W, w, r, θ, hθc, hqc, hconn, hcov, hgal⟩ :=
    wc_pencil_Rq_galois_scalar_cover F' F'' Y n D ℓ hℓ hP (2 * (n - 1))

  obtain ⟨V₀, g₀, φ₀, A₀, _, _, _, e₀, ε₀, hv₀, -, hε₀, hεφ₀⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  have hp₀ : (wcGeomPoint F'' (wcP1Over F'') hP).hom (g₀.left (e₀.inv (IsLocalRing.closedPoint A₀))) =
      D.u0 (IsLocalRing.closedPoint F'') := by
    rw [← hv₀]
    exact (Scheme.Hom.comp_apply g₀.left _ _).symm.trans
      (congrArg (fun f : V₀.left ⟶ (wcP1Over F'').left => f (e₀.inv (IsLocalRing.closedPoint A₀)))
        (MorphismProperty.Over.w g₀))
  obtain ⟨z₁, hz₁⟩ := hcov (g₀.left (e₀.inv (IsLocalRing.closedPoint A₀)))
    (fun i h => D.hu0S i (hp₀.symm.trans h))
  obtain ⟨ι₀, -⟩ := wc_P1bar_strict_local_lift F'' hP W w V₀ g₀ A₀ e₀ ⟨z₁, hz₁⟩
  obtain ⟨L, hLinj, hLc⟩ :=
    wc_pencil_R2_u0_strict_line F' F'' Y n hn2 D ℓ hℓ V₀ φ₀ A₀ e₀ ε₀ hv₀ hε₀ hεφ₀
  obtain ⟨cst, hcst_add, hcst_smul, hcst_eval⟩ : ∃ cst : (Fin r → ℚ_[ℓ]) →
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V₀),
      (∀ v v', cst (v + v') = cst v + cst v') ∧
      (∀ (c : ℚ_[ℓ]) v, cst (c • v) =
        ((wcConstScalar (wcP1Over F'').left ℓ r c).hom.app (Opposite.op V₀)).hom (cst v)) ∧
      (∀ v z, wcContEval (wcP1Over F'').left V₀ (cst v) z = v) :=
    ⟨fun v => (ULift.up (ContinuousMap.const V₀.left v) : ULift C(V₀.left, Fin r → ℚ_[ℓ])),
      fun v v' => hext r V₀ _ _ (fun _ => rfl),
      fun c v => hext r V₀ _ _ (fun _ => rfl),
      fun _ _ => rfl⟩
