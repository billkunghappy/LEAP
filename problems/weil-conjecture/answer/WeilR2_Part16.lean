  haveI := Dw.presColim
  haveI hPadd : P.Additive := Adjunction.right_adjoint_additive Df.adj
  haveI hPwadd : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _



  have s6 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞],
      letI := HasDerivedCategory.standard 𝒞
      ∀ (A Ψ0 : CochainComplex 𝒞 ℤ) (n : ℤ) (f0 : Ψ0 ⟶ Ψ0)
