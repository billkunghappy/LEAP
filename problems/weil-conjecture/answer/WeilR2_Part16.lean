      exact TopologicalSpace.Opens.mem_iSup (x := y) (s := fun t : Fin (e + 1) =>
        PrimeSpectrum.basicOpen (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) Ω))
    have hOset : (O : Set (Spec (.of (MvPolynomial (Fin (e + 1)) Ω)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) Ω →+* Ω))))ᶜ := by
      ext y
      rw [Set.mem_compl_iff, wc_affine_origin_range_iff, SetLike.mem_coe, hOmem, not_forall]
    have hE : (O : Set (Spec (.of (MvPolynomial (Fin (e + 1)) Ω)))) =
        {y | ∃ t : Fin (e + 1), t.val < e + 1 ∧
          (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) Ω) ∉ y.asIdeal} := by
      ext y
      rw [SetLike.mem_coe, hOmem, Set.mem_setOf_eq]
      exact ⟨fun ⟨t, ht⟩ => ⟨t, t.isLt, ht⟩, fun ⟨t, _, ht⟩ => ⟨t, ht⟩⟩
    intro q hq
    obtain ⟨Φ⟩ := wc_hyperbolic_affine_quadric_punct_coh_equiv Ω ℓ hℓ hℓΩ e O hOset q
    have hsub := wc_et_affine_partial_punct_vanishing Ω ℓ hℓ hℓΩ (e + 1) (e + 1) le_rfl O hE q hq
    obtain ⟨K⟩ := Kq q
    haveI := hsub
    exact (K.trans Φ).subsingleton

  intro q hq
  have h2' := wc_et_coh_zmod_prime_pow_of_prime _ ℓ hℓ q (hvan q hq) (k - 1)
  rw [Nat.sub_add_cancel hk] at h2'
  obtain ⟨Eq⟩ := E (ℓ ^ k) q
  haveI := h2'
  exact Eq.symm.subsingleton

theorem wc_pmn_vp_milnor_fib_hm_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (q : ℕ) (hq1 : 1 ≤ q) (hqN : q ≠ n - 1) :
    ∀ y : wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ q, y = 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩

  have s2 : ∀ {P Yt Vl El Sb Sb0 Ac' T Lsp : Scheme.{u}} (XV XE : Scheme.{u}) (f : Yt ⟶ P)
      (v : Vl ⟶ P) (eh : El ⟶ P) (e' : El ⟶ Vl), e' ≫ v = eh →
      ∀ (pv : XV ⟶ Vl) (qv : XV ⟶ Yt), IsPullback pv qv v f →
      ∀ (pe : XE ⟶ El) (qe : XE ⟶ Yt), IsPullback pe qe eh f →
      ∀ (ã : XE ⟶ XV), ã ≫ pv = pe ≫ e' → ã ≫ qv = qe →
      ∀ (a' : Sb ⟶ XV) (γ : Vl ≅ Ac') (θ : Sb ≅ Sb0) (c : Sb0 ⟶ Ac'),
      θ.hom ≫ c = a' ≫ pv ≫ γ.hom →
      ∀ (τ : T ⟶ El) (ε : El ≅ Lsp) (σ : T ⟶ Lsp), τ ≫ ε.hom = σ →
      ∃ g : Limits.pullback c (τ ≫ e' ≫ γ.hom) ⟶ Limits.pullback a' ã,
        IsPullback g (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom))
          (Limits.pullback.snd a' ã ≫ pe ≫ ε.hom) σ := by
    intro P Yt Vl El Sb Sb0 Ac' T Lsp XV XE f v eh e' he pv qv hVp pe qe hEp ã hã1 hã2 a' γ θ c
      hc τ ε σ hσ
    have right : IsPullback qv pv f v := hVp.flip
    have big : IsPullback (ã ≫ qv) pe f (e' ≫ v) := by rw [hã2, he]; exact hEp.flip
    have Qa : IsPullback ã pe pv e' := IsPullback.of_right big hã1 right
    have QF : IsPullback (Limits.pullback.fst a' ã) (Limits.pullback.snd a' ã ≫ pe) (a' ≫ pv) e' :=
      (IsPullback.of_hasPullback a' ã).paste_vert Qa
    have BIG : IsPullback (Limits.pullback.fst c (τ ≫ e' ≫ γ.hom) ≫ θ.inv)
        (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom)) (a' ≫ pv) (τ ≫ e') := by
      refine IsPullback.of_iso (IsPullback.of_hasPullback c (τ ≫ e' ≫ γ.hom)) (Iso.refl _) θ.symm
        (Iso.refl _) γ.symm ?_ ?_ ?_ ?_
      · simp
      · simp
      · simp only [Iso.symm_hom]
        rw [Iso.eq_inv_comp, ← Category.assoc, hc]
        simp
      · simp
    have w' : (Limits.pullback.fst c (τ ≫ e' ≫ γ.hom) ≫ θ.inv) ≫ (a' ≫ pv) =
        (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom) ≫ τ) ≫ e' := by
      rw [Category.assoc (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom))]
      exact BIG.toCommSq.w
    refine ⟨QF.lift _ _ w', ?_⟩
    have hg1 := QF.lift_fst _ _ w'
    have hg2 := QF.lift_snd _ _ w'
    have big2 : IsPullback (QF.lift _ _ w' ≫ Limits.pullback.fst a' ã)
        (Limits.pullback.snd c (τ ≫ e' ≫ γ.hom)) (a' ≫ pv) (τ ≫ e') := by
      rw [hg1]; exact BIG
    have S1 := IsPullback.of_right big2 hg2 QF
    have Q4 : IsPullback τ (𝟙 T) ε.hom σ :=
      IsPullback.of_vert_isIso ⟨by rw [Category.id_comp]; exact hσ⟩
    have h := S1.paste_vert Q4
    rwa [Category.comp_id, Category.assoc] at h

  have hã1 : (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
        Limits.pullback.fst V.hom D.f = Limits.pullback.fst E.hom D.f ≫ a₀.left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have hã2 : (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
        Limits.pullback.snd V.hom D.f = Limits.pullback.snd E.hom D.f := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | exact MorphismProperty.Over.w ((wcProEtPullback D.f).map a₀)

  haveI : IsAffine V.left := IsAffine.of_isIso e.hom
  haveI : IsAffine E.left := IsAffine.of_isIso eE.hom
  have Qa : IsPullback (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f)
      (Limits.pullback.fst E.hom D.f) (Limits.pullback.fst V.hom D.f) a₀.left := by
    have right : IsPullback (Limits.pullback.snd V.hom D.f) (Limits.pullback.fst V.hom D.f)
        D.f V.hom := (IsPullback.of_hasPullback V.hom D.f).flip
    have big : IsPullback ((((wcProEtPullback D.f).map a₀).left :
        Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫ Limits.pullback.snd V.hom D.f)
        (Limits.pullback.fst E.hom D.f) D.f (a₀.left ≫ V.hom) := by
      rw [hã2, MorphismProperty.Over.w a₀]; exact (IsPullback.of_hasPullback E.hom D.f).flip
    exact IsPullback.of_right big hã1 right
  haveI : IsAffineHom a₀.left := isAffineHom_of_isAffine a₀.left
  haveI hãA : IsAffineHom (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) Qa.flip ‹_›
  haveI : IsAffineHom (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback a' ((wcProEtPullback D.f).map a₀).left).flip hãA
  haveI hFa : IsAffine (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) :=
    isAffine_of_isAffineHom (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left)

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨Ac, _, _, _, Λ, _, _, W', φ, ac, eA, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (D.S i (IsLocalRing.closedPoint F''))
  have hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) Ac Λ W' φ ac := by
    unfold wcHalShData
    exact ⟨hI, haff, hcomp, hφa, hlim, eA, hint, heq⟩
  have hres : ∀ w : Spec (.of (IsLocalRing.ResidueField Ac)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue Ac)) w = IsLocalRing.closedPoint Ac := by
    intro w
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue Ac))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField Ac)) w _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue Ac)).mp inferInstance)
  have hacl : ac (IsLocalRing.closedPoint Ac) = D.S i (IsLocalRing.closedPoint F'') := by
    have key : ∀ x₀ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField
        (D.S i (IsLocalRing.closedPoint F''))))),
        ac (IsLocalRing.closedPoint Ac) = D.S i (IsLocalRing.closedPoint F'') := by
      intro x₀
      have h1 : (Spec.map (CommRingCat.ofHom eA) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue Ac)) ≫ ac) x₀ =
          (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))) x₀ := by
        rw [heq]
      simp only [Scheme.Hom.comp_apply, wcEtGeomPt, hres] at h1
      exact h1.trans (Scheme.fromSpecResidueField_apply _ _)
    exact key (IsLocalRing.closedPoint _)
  have hWa : WeaklyEtale ac := wc_shdata_weaklyEtale _ Ac Λ W' φ ac hA
  let VA : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ ac hWa
  obtain ⟨vA⟩ := wc_P1_strict_local_geomPoint_map F'' hP VA Ac (Iso.refl _)
  obtain ⟨v₀⟩ := wc_P1_strict_local_geomPoint_map F'' hP V A e
  obtain ⟨c, -⟩ := wc_pencil_PL_shens_nbhd_rigid F'' hP (D.S i) (D.hS i) VA vA Ac (Iso.refl _)
    hacl V v₀ A e hV
  have hγ1 : c.inv.left ≫ c.hom.left = 𝟙 V.left :=
    (MorphismProperty.Comma.comp_left c.inv c.hom).symm.trans
      ((congrArg (fun (f : V ⟶ V) => f.left) c.inv_hom_id).trans rfl)
  have hγ2 : c.hom.left ≫ c.inv.left = 𝟙 VA.left :=
    (MorphismProperty.Comma.comp_left c.hom c.inv).symm.trans
      ((congrArg (fun (f : VA ⟶ VA) => f.left) c.hom_inv_id).trans rfl)
  have hγ : c.hom.left ≫ V.hom = ac := MorphismProperty.Over.w c.hom
  have hinvA : c.inv.left ≫ ac = V.hom := by
    rw [← hγ, ← Category.assoc, hγ1, Category.id_comp]
  obtain ⟨γ, hγh⟩ : ∃ γ : V.left ≅ Spec (.of Ac), γ.hom = c.inv.left :=
    ⟨⟨c.inv.left, c.hom.left, hγ1, hγ2⟩, rfl⟩
  have hγV : γ.hom ≫ ac = V.hom := by rw [hγh]; exact hinvA

  have hisoG : ∀ {X₁ Pb T₁ T₂ : Scheme.{u}} (ff : X₁ ⟶ Pb) (uu : T₁ ⟶ Pb) (aa : T₂ ⟶ Pb)
