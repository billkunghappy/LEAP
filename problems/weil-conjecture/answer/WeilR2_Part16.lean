    have hd0 : ∀ z : (K.cycles q).val.obj (Opposite.op W),
        ((K.d q (q + 1)).val.app (Opposite.op W)).hom
          (((K.iCycles q).val.app (Opposite.op W)).hom z) = 0 := by
      intro z
      have h : ((K.iCycles q ≫ K.d q (q + 1)).val.app (Opposite.op W)).hom z = 0 := by
        rw [K.iCycles_d]; rfl
      exact h
    have hz : ∀ z : (K.cycles q).val.obj (Opposite.op W),
        τ q (((K.iCycles q).val.app (Opposite.op W)).hom z) ≫ I.cocomplex.d q (q + 1) = 0 := by
      intro z
      rw [← hcomm, hd0, map_zero]
    have hcong : ∀ (f f' : A ⟶ I.cocomplex.X q) (_ : f = f')
        (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hf' : f' ≫ I.cocomplex.d q (q + 1) = 0),
        I.extMk f (q + 1) rfl hf = I.extMk f' (q + 1) rfl hf' := by
      intro f f' h _ _
      subst h
      rfl
    have hker : ∀ z : (K.cycles q).val.obj (Opposite.op W),
        ((K.homologyπ q).val.app (Opposite.op W)).hom z = 0 ↔
          I.extMk (τ q (((K.iCycles q).val.app (Opposite.op W)).hom z)) (q + 1) rfl (hz z) = 0 := by
      intro z
      cases q with
      | zero =>
        have hd00 : K.d 0 0 = 0 := K.shape 0 0 (by simp)
        have hπ0 : ((K.homologyπ 0).val.app (Opposite.op W)).hom z = 0 ↔ z = 0 := by
          rw [hcrit 0 (by simp) z, hd00]
          constructor
          · rintro ⟨b, hb⟩
            apply hi
            rw [map_zero, ← hb]
            rfl
          · intro h
            refine ⟨0, ?_⟩
            rw [h, map_zero, map_zero]
        rw [hπ0]
        constructor
        · intro h
          subst h
          rw [hcong (τ 0 (((K.iCycles 0).val.app (Opposite.op W)).hom 0)) 0
            (by rw [map_zero, map_zero]) _ (by simp)]
          exact I.extMk_zero _ _
        · intro h0
          have hf0 : τ 0 (((K.iCycles 0).val.app (Opposite.op W)).hom z) = 0 := by
            simp only [← I.extEquivCohomologyClass.apply_eq_iff_eq,
              InjectiveResolution.extEquivCohomologyClass_extMk,
              InjectiveResolution.extEquivCohomologyClass_zero,
              CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff] at h0
            rw [CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
              (by simp)] at h0
            obtain ⟨g', hg⟩ := h0
