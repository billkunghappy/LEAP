      rfl
    intro X hX q
    have hls : Presheaf.IsLocallySurjective J π.hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
    refine (Limits.cokernel Ψ).isSeparated X _ (Presheaf.imageSieve_mem J π.hom q) _ 0 ?_
    rintro Y f ⟨t, ht⟩
    rw [map_zero, ← ht]
    exact hA Y (h𝒰 f hX) t

  have hs4 : ∀ (M N : Sheaf ((Scheme.ProEt.topology S).over Pb) AddCommGrpCat.{u+1}) (Ψ : M ⟶ N)
      (X : Over Pb) (t : N.obj.obj (Opposite.op X)) (n : ℕ) (W : Fin n → S.ProEt)
      (g : ∀ j, W j ⟶ X.left),
      Sieve.generate (Presieve.ofArrows W g) ∈ Scheme.ProEt.topology S X.left →
      (∀ j, ∃ μ : M.obj.obj (Opposite.op (Over.mk (g j ≫ X.hom))),
        (Ψ.hom.app (Opposite.op (Over.mk (g j ≫ X.hom)))).hom μ =
          (N.obj.map (Over.homMk (g j) : Over.mk (g j ≫ X.hom) ⟶ X).op).hom t) →
      Presheaf.imageSieve Ψ.hom t ∈ ((Scheme.ProEt.topology S).over Pb) X := by
    intro M N Ψ X t n W g hcov hlift
    rw [GrothendieckTopology.mem_over_iff]
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    rw [Sieve.overEquiv_iff]
    exact hlift j

  have hopen : ∀ (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro Q n W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have hs6 : ∀ (V : S.ProEt) (v : V ⟶ Pb),
      (∀ y : V.left, v.left y ∈ Ub) →
      ∃ (W0 : S.ProEt) (q1 : W0 ⟶ V) (q2 : W0 ⟶ ℰ),
        q1 ≫ v = q2 ≫ e ∧ IsOpenMap ⇑q1.left ∧ Function.Surjective ⇑q1.left := by
    intro V v hv
    haveI : Etale e.left := hπE ▸ inferInstance
    let W0 : S.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst v.left e.left ≫ V.hom)
      (by haveI : WeaklyEtale V.hom := V.prop; infer_instance)
    let q1 : W0 ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst v.left e.left) rfl trivial
    have hq2 : Limits.pullback.snd v.left e.left ≫ ℰ.hom = W0.hom := by
      show _ = Limits.pullback.fst v.left e.left ≫ V.hom
      rw [← MorphismProperty.Over.w e, ← MorphismProperty.Over.w v, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let q2 : W0 ⟶ ℰ := MorphismProperty.Over.homMk (Limits.pullback.snd v.left e.left) hq2 trivial
    refine ⟨W0, q1, q2, ?_, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst v.left e.left ≫ v.left = Limits.pullback.snd v.left e.left ≫ e.left
      exact Limits.pullback.condition
    · exact (Limits.pullback.fst v.left e.left).isOpenMap
    · intro y
      have hy : v.left y ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hv y
      obtain ⟨p, hp⟩ := hy
      obtain ⟨z, hz⟩ := hsurjE.surj p
      have hez : v.left y = e.left z := by
        rw [← hp, ← hz, ← hπE, Scheme.Hom.comp_apply]
      obtain ⟨w, hw, _⟩ := Scheme.Pullback.exists_preimage_pullback y z hez
      exact ⟨w, hw⟩

  have hs7 : ∀ (Q : S.ProEt) (τ : C(↥Q.left, Fin k → ZMod (ℓ ^ r))),
      ∃ (n : ℕ) (W : Fin n → S.ProEt) (ι : ∀ j, W j ⟶ Q) (b : Fin n → (Fin k → ZMod (ℓ ^ r))),
        (∀ j, IsOpenMap ⇑(ι j).left) ∧ (∀ x : ↥Q.left, ∃ j, x ∈ Set.range ⇑(ι j).left) ∧
        ∀ j (t : ↥(W j).left), τ ((ι j).left t) = b j := by
    intro Q τ
    classical
    let eB := Finite.equivFin (Fin k → ZMod (ℓ ^ r))
    let O : Fin (Nat.card (Fin k → ZMod (ℓ ^ r))) → Q.left.Opens := fun j =>
      ⟨τ ⁻¹' {eB.symm j}, τ.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
    let W : Fin (Nat.card (Fin k → ZMod (ℓ ^ r))) → S.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ ((O j).ι ≫ Q.hom)
        (by haveI : WeaklyEtale Q.hom := Q.prop; infer_instance)
    let ι : ∀ j, W j ⟶ Q := fun j => MorphismProperty.Over.homMk (O j).ι rfl trivial
    refine ⟨Nat.card (Fin k → ZMod (ℓ ^ r)), W, ι, fun j => eB.symm j, fun j => ?_, fun x => ?_,
      fun j t => ?_⟩
    · exact (O j).ι.isOpenEmbedding.isOpenMap
    · refine ⟨eB (τ x), ⟨x, ?_⟩, ?_⟩
      · show τ x ∈ ({eB.symm (eB (τ x))} : Set _)
        simp
      · exact Scheme.Opens.ι_apply _ _
    · show τ ((O j).ι t) = eB.symm j
      exact (congrArg τ (Scheme.Opens.ι_apply (O j) t)).trans t.2

  have hominv : ∀ (T : (Over ℰ)ᵒᵖ) (y : (L.over ℰ).obj.obj T),
      (θE.inv.hom.app T).hom ((θE.hom.hom.app T).hom y) = y := by
    intro T y
    exact congrArg (fun φ => (φ.hom.app T).hom y) θE.hom_inv_id
  have invhom : ∀ (T : (Over ℰ)ᵒᵖ)
      (y : ((wcContSheaf S (Fin k → ZMod (ℓ ^ r))).over ℰ).obj.obj T),
      (θE.hom.hom.app T).hom ((θE.inv.hom.app T).hom y) = y := by
    intro T y
    exact congrArg (fun φ => (φ.hom.app T).hom y) θE.inv_hom_id
  have ha : ∀ (Z Z' : S.ProEt) (c : Z ⟶ ℰ) (c' : Z' ⟶ ℰ) (f : Z' ⟶ Z), f ≫ c = c' →
      ∀ (x : L.obj.obj (Opposite.op Z)) (t : Z'.left),
        (show C(↥Z'.left, Fin k → ZMod (ℓ ^ r)) from
          ((θE.hom.hom.app (Opposite.op (Over.mk c'))).hom ((L.obj.map f.op).hom x)).down) t =
        (show C(↥Z.left, Fin k → ZMod (ℓ ^ r)) from
          ((θE.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) (f.left t) := by
    intro Z Z' c c' f hf x t
    subst hf
    have h := NatTrans.naturality_apply θE.hom.hom
      (Over.homMk f rfl : Over.mk (f ≫ c) ⟶ Over.mk c).op x
    exact congrArg (fun y => (show C(↥Z'.left, Fin k → ZMod (ℓ ^ r)) from y.down) t) h
  have hb : ∀ (Z : S.ProEt) (c : Z ⟶ ℰ) (x y : L.obj.obj (Opposite.op Z)),
      (∀ t : Z.left,
        (show C(↥Z.left, Fin k → ZMod (ℓ ^ r)) from
          ((θE.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) t =
        (show C(↥Z.left, Fin k → ZMod (ℓ ^ r)) from
          ((θE.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) t) → x = y := by
    intro Z c x y hxy
    have h : (θE.hom.hom.app (Opposite.op (Over.mk c))).hom x =
        (θE.hom.hom.app (Opposite.op (Over.mk c))).hom y :=
      ULift.ext _ _ (ContinuousMap.ext hxy)
    exact (hominv (Opposite.op (Over.mk c)) x).symm.trans
      ((congrArg (fun z => (θE.inv.hom.app (Opposite.op (Over.mk c))).hom z) h).trans
        (hominv (Opposite.op (Over.mk c)) y))
  let cst : (Fin k → ZMod (ℓ ^ r)) →
      ((wcContSheaf S (Fin k → ZMod (ℓ ^ r))).over ℰ).obj.obj (Opposite.op (Over.mk (𝟙 ℰ))) :=
    fun a => ULift.up (ContinuousMap.const ↥ℰ.left a)
  let s : (Fin k → ZMod (ℓ ^ r)) → L.obj.obj (Opposite.op ℰ) := fun a =>
    (θE.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst a)
  have hc : ∀ (a : Fin k → ZMod (ℓ ^ r)) (Z : S.ProEt) (c : Z ⟶ ℰ) (t : Z.left),
      (show C(↥Z.left, Fin k → ZMod (ℓ ^ r)) from ((θE.hom.hom.app (Opposite.op (Over.mk c))).hom
        ((L.obj.map c.op).hom (s a))).down) t = a := by
    intro a Z c t
    refine (ha ℰ Z (𝟙 ℰ) c c (Category.comp_id c) _ t).trans ?_
    have h := invhom (Opposite.op (Over.mk (𝟙 ℰ))) (cst a)
    exact (congrArg (fun y : ((wcContSheaf S (Fin k → ZMod (ℓ ^ r))).over ℰ).obj.obj
        (Opposite.op (Over.mk (𝟙 ℰ))) =>
      (show C(↥ℰ.left, Fin k → ZMod (ℓ ^ r)) from y.down) (c.left t)) h).trans rfl
  have hs_add : ∀ a b, s (a + b) = s a + s b := by
    intro a b
    have hcst : cst (a + b) = cst a + cst b := rfl
    show (θE.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst (a + b)) =
      (θE.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst a) +
        (θE.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst b)
    rw [hcst, map_add]

  have hadd : ∀ {X : (Over Pb)ᵒᵖ} {G H : Sheaf ((Scheme.ProEt.topology S).over Pb) AddCommGrpCat.{u+1}}
      (f g : G ⟶ H) (x : G.obj.obj X),
      ((f + g).hom.app X).hom x = (f.hom.app X).hom x + (g.hom.app X).hom x := by
    intro X G H f g x
    have : (f + g).hom = f.hom + g.hom :=
      (sheafToPresheaf ((Scheme.ProEt.topology S).over Pb) AddCommGrpCat.{u+1}).map_add
    rw [this, NatTrans.app_add, AddCommGrpCat.hom_add, AddMonoidHom.add_apply]
  let jL := ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} Pb).obj L
  let G₀ : (Fin k → ZMod (ℓ ^ r)) → (Zsl.obj (Over.mk e) ⟶ jL) := fun a =>
    (hS (Over.mk e) jL (s a)).choose
  have hG₀ : ∀ a, ((G₀ a).hom.app (Opposite.op (Over.mk e))).hom (ν (Over.mk e)) = s a :=
    fun a => (hS (Over.mk e) jL (s a)).choose_spec
  have hG₀add : ∀ a b, G₀ (a + b) = G₀ a + G₀ b := by
    intro a b
    apply hI
    rw [hadd, hG₀, hG₀, hG₀]
    exact hs_add a b
  let G : (Fin k → ZMod (ℓ ^ r)) →+ (Zsl.obj (Over.mk e) ⟶ jL) := AddMonoidHom.mk' G₀ hG₀add
  have hGν : ∀ a, ((G a).hom.app (Opposite.op (Over.mk e))).hom (ν (Over.mk e)) = s a := hG₀
  have hnA : ∀ a : Fin k → ZMod (ℓ ^ r), (ℓ ^ r : ℕ) • a = 0 := by
    intro a
    funext i
    rw [Pi.smul_apply, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rfl
  have hT : ∀ a, ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) ≫ G a = 0 := by
    intro a
    rw [Preadditive.nsmul_comp, Category.id_comp, ← map_nsmul G, hnA a, map_zero]
  let ψ₀ : (Fin k → ZMod (ℓ ^ r)) → (Zm (Over.mk e) ⟶ jL) := fun a =>
    Limits.cokernel.desc ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) (G a) (hT a)
  have hK0 : ∀ a, Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) ≫ ψ₀ a = G a :=
    fun a => Limits.cokernel.π_desc _ _ _
  have hψadd : ∀ a b, ψ₀ (a + b) = ψ₀ a + ψ₀ b := by
    intro a b
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))))).mp
    rw [Preadditive.comp_add, hK0, hK0, hK0, map_add]
  let ψ : (Fin k → ZMod (ℓ ^ r)) →+ (Zm (Over.mk e) ⟶ jL) := AddMonoidHom.mk' ψ₀ hψadd
  have hK : ∀ a, Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) ≫ ψ a = G a := hK0
  have hπZm : ∀ (X Y : Over Pb) (f : X ⟶ Y),
      Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj X)) ≫ ZmMap X Y f =
        Zsl.map f ≫ Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj Y)) :=
    fun X Y f => Limits.cokernel.π_desc _ _ _
  have hR : ∀ (Y : Over Pb) (r' : Y ⟶ Over.mk e) (a : Fin k → ZMod (ℓ ^ r)),
      ((Zsl.map r' ≫ G a).hom.app (Opposite.op Y)).hom (ν Y) =
        (L.obj.map r'.left.op).hom (s a) := by
    intro Y r' a
    change ((G a).hom.app (Opposite.op Y)).hom (((Zsl.map r').hom.app (Opposite.op Y)).hom (ν Y)) = _
    rw [hN r', NatTrans.naturality_apply (G a).hom r'.op, hGν]
    rfl
  refine ⟨ψ, ?_, ?_⟩

  · intro Z z p₁ p₂ h₁ h₂ h hrel a'
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk z))))).mp
    simp only [← Category.assoc, hπZm]
    simp only [Category.assoc, hK]
    apply hI
    rw [hR, hR]
    change (L.obj.map p₁.op).hom (s a') = (L.obj.map p₂.op).hom (s (h a'))
    apply hb Z p₂
    intro t
    rw [hrel, hc, hc]

  · intro V' hV' q
    let D := fun _ : Fin k => Zm (Over.mk e)
    let Ψ := ∑ i : Fin k, Limits.biproduct.π D i ≫ ψ (Pi.single i 1)
    have hΨ : Ψ = Limits.biproduct.desc (fun i => ψ (Pi.single i 1)) := Limits.biproduct.desc_eq.symm
    have hsum : ∀ bb : Fin k → ZMod (ℓ ^ r),
        ∑ i, (bb i).val • (Pi.single i (1 : ZMod (ℓ ^ r)) : Fin k → ZMod (ℓ ^ r)) = bb := by
      intro bb
      conv_rhs => rw [← Finset.univ_sum_single bb]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Pi.single_smul, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
    have hcoord : ∀ bb : Fin k → ZMod (ℓ ^ r),
        (∑ i, (bb i).val • Limits.biproduct.ι D i) ≫ Ψ = ψ bb := by
      intro bb
      rw [hΨ, Preadditive.sum_comp]
      simp only [Preadditive.nsmul_comp, Limits.biproduct.ι_desc]
      conv_rhs => rw [← hsum bb]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_nsmul]
    refine hs3 _ _ Ψ (fun X => ∀ v : X.left.left, X.hom.left v ∈ Ub) ?_ ?_ V' hV' q
    · intro X Y f hY v
      have hw : X.hom.left = f.left.left ≫ Y.hom.left := by
        rw [← Over.w f]; rfl
      rw [hw, Scheme.Hom.comp_apply]
      exact hY _
    · intro X hX t
      obtain ⟨W0, q1, q2, hq, hq1o, hq1s⟩ := hs6 X.left X.hom hX
      let τ : C(↥W0.left, Fin k → ZMod (ℓ ^ r)) :=
        (show C(↥W0.left, Fin k → ZMod (ℓ ^ r)) from
          ((θE.hom.hom.app (Opposite.op (Over.mk q2))).hom ((L.obj.map q1.op).hom t)).down)
      obtain ⟨n, W, ι, b, hιo, hιs, hιc⟩ := hs7 W0 τ
      let g : ∀ j, W j ⟶ X.left := fun j => ι j ≫ q1
      let c : ∀ j, W j ⟶ ℰ := fun j => ι j ≫ q2
      have hgc : ∀ j, c j ≫ e = g j ≫ X.hom := by
        intro j
        simp only [c, g, Category.assoc, hq]
      have e1 : ∀ j, ⇑(g j).left = ⇑q1.left ∘ ⇑(ι j).left := by
        intro j
        funext x
        exact Scheme.Hom.comp_apply _ _ x
      refine hs4 _ _ Ψ X t n W g ?_ ?_
      · refine hopen X.left n W g (fun j => ?_) (fun x => ?_)
        · rw [e1 j]
          exact hq1o.comp (hιo j)
        · obtain ⟨w, hw⟩ := hq1s x
          obtain ⟨j, t', ht'⟩ := hιs w
          refine ⟨j, t', ?_⟩
          rw [e1 j, Function.comp_apply, ht', hw]
      · intro j
        let Yj : Over Pb := Over.mk (g j ≫ X.hom)
        let rj : Yj ⟶ Over.mk e := Over.homMk (c j) (hgc j)
        let φ : Zm (Over.mk e) ⟶ ⨁ D := ∑ i, (b j i).val • Limits.biproduct.ι D i
        refine ⟨((Zsl.map rj ≫ Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) ≫ φ).hom.app
          (Opposite.op Yj)).hom (ν Yj), ?_⟩
        have e2 : (Ψ.hom.app (Opposite.op Yj)).hom
            (((Zsl.map rj ≫ Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) ≫ φ).hom.app
              (Opposite.op Yj)).hom (ν Yj)) =
            ((Zsl.map rj ≫ G (b j)).hom.app (Opposite.op Yj)).hom (ν Yj) := by
          have h3 : Zsl.map rj ≫ Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk e))) ≫ φ ≫ Ψ =
              Zsl.map rj ≫ G (b j) := by
            rw [hcoord, hK]
          rw [← h3]
          rfl
        rw [e2, hR]
        change (L.obj.map (c j).op).hom (s (b j)) = (L.obj.map (g j).op).hom t
        apply hb (W j) (c j)
        intro t0
        rw [hc]
        have h4 : (L.obj.map (g j).op).hom t =
            (L.obj.map (ι j).op).hom ((L.obj.map q1.op).hom t) := by
          show (L.obj.map (q1.op ≫ (ι j).op)).hom t = _
          rw [Functor.map_comp]
          rfl
        rw [h4, ha W0 (W j) q2 (c j) (ι j) rfl]
        exact (hιc j t0).symm

theorem wc_qcfin_transition_component (F'' : Type u) [Field F''] [Finite F'']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (r : ℕ) (hL : (ℓ ^ r : ℕ) • 𝟙 L = 0) (k : ℕ)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          S i (IsLocalRing.closedPoint F''))
    (ℰ : (wcP1Over F'').left.ProEt) (e : ℰ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (πE : ℰ.left ⟶ Ub.toScheme) (hπE : πE ≫ Ub.ι = e.left)
    (hfin : IsFinite πE) (het : Etale πE) (hsurjE : Surjective πE)
    (hEconn : ConnectedSpace ℰ.left)
    (θE : L.over ℰ ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over ℰ) :
    ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ ℰ)
      (h : (Fin k → ZMod (ℓ ^ r)) →+ (Fin k → ZMod (ℓ ^ r))),
      ConnectedSpace V.left → a ≫ e = b ≫ e →
      (∀ (x : L.obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, (Fin k → ZMod (ℓ ^ r))) from
          ((θE.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z =
        h ((show C(↥V.left, (Fin k → ZMod (ℓ ^ r))) from
          ((θE.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z)) →
