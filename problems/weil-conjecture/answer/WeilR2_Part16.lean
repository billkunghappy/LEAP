  have e1 : ⇑((adj.unit.app M).val.app (Opposite.op V)).hom =
      ⇑((((SheafOfModules.pushforward.{u+1} φ).map
        ((adjS.leftAdjointUniq adj).hom.app M)).val).app (Opposite.op V)).hom ∘
        ⇑((adjS.unit.app M).val.app (Opposite.op V)).hom := by
    funext x
    exact (congrArg (fun k => (k.val.app (Opposite.op V)).hom x) huniq).symm
  rw [e1]
  exact hc4.comp hS

theorem wc_proet_module_unit_bij_thickening {Y Z : Scheme.{u}} (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I] (Vt : Y.ProEt)
    (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I)))
    (hsq : IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))
    (hW : IsAffine ((wcProEtBaseChange i).obj Vt).left ∧
      IsClosed {z : ((wcProEtBaseChange i).obj Vt).left | IsClosed ({z} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧
      (∀ z : ((wcProEtBaseChange i).obj Vt).left, ∃! y : ((wcProEtBaseChange i).obj Vt).left,
        IsClosed ({y} : Set ((wcProEtBaseChange i).obj Vt).left) ∧ z ⤳ y) ∧
      ExtremallyDisconnected {z : ((wcProEtBaseChange i).obj Vt).left | IsClosed ({z} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧
      (∀ z : ((wcProEtBaseChange i).obj Vt).left, IsClosed ({z} : Set ((wcProEtBaseChange i).obj Vt).left) →
        HenselianLocalRing (((wcProEtBaseChange i).obj Vt).left.presheaf.stalk z) ∧
        IsSepClosed (((wcProEtBaseChange i).obj Vt).left.residueField z)))
    (M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :
    Function.Bijective ((D.adj.unit.app M).val.app (Opposite.op Vt)).hom :=
by
  have hlift : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [WeaklyEtale f] (a : Spec (.of A) ⟶ S)
      (b : Spec (.of (A ⧸ I)) ⟶ X),
      b ≫ f = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a →
      ∃! σ : Spec (.of A) ⟶ X,
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ = b ∧ σ ≫ f = a :=
    fun f _ a b hab => wc_weaklyEtale_henselian_lift f A I a b hab
  have hinit := wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq hlift
  let G := (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj M
  have hη0 := wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj
  have hadd : ∀ (m : ℕ) (Q : Fin m → Z.ProEt) (ι : ∀ k, Q k ⟶ (wcProEtBaseChange i).obj Vt),
      (∀ k, IsOpenImmersion (ι k).left) →
      (∀ x : ((wcProEtBaseChange i).obj Vt).left, ∃! k, x ∈ Set.range (ι k).left) →
      Function.Bijective (fun s : ((wcProEtBaseChange i).op.lan.obj G.obj).obj
          (Opposite.op ((wcProEtBaseChange i).obj Vt)) =>
        fun k => (((wcProEtBaseChange i).op.lan.obj G.obj).map (ι k).op).hom s) := by
    intro m Q ι hι hpart
    obtain ⟨Vk, ιt, κ, hιt, hpart', hκ, hk⟩ :=
      wc_proet_thickening_clopen_lift i A I Vt e c hsq m Q ι hι hpart
    have hηk : ∀ k, Function.Bijective
        (((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op (Vk k))).hom := by
      intro k
      obtain ⟨Ak, _, Ik, hIk, ek, ck, hsqk⟩ := hk k
      haveI := hIk
      exact wc_proet_lan_unit_bijective_of_init i (Vk k)
        (wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk
          (fun f _ a b hab => wc_weaklyEtale_henselian_lift f Ak Ik a b hab)) G.obj
    exact wc_proet_lan_clopen_additive i Vt G m Q ι Vk ιt κ hιt hpart' hκ hη0 hηk
  have hτ := wc_proet_toSheafify_bijective_wcontr Z ((wcProEtBaseChange i).op.lan.obj G.obj)
    ((wcProEtBaseChange i).obj Vt) hW hadd
  exact wc_proet_module_unit_bij_of_lan i ℓ D hD Vt M (hτ.comp hη0)

theorem wc_ppu_unit_bij_lc_thickening {X : Scheme.{u}} (x : X)
    [IsSepClosed (X.residueField x)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') [WeaklyEtale a']
    (Dk : wcHMPullData (X.fromSpecResidueField x) ℓ) (hDk : wcHMPullCanonical Dk)
    (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
    [TotallyDisconnectedSpace S] [ExtremallyDisconnected S]
    [WeaklyEtale (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')] :
    Function.Bijective ((Dk.adj.unit.app M).val.app (Opposite.op (Scheme.ProEt.mk
      (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')))).hom :=
by
  obtain ⟨c, g, hsq, hg, hcg⟩ := wc_ppu_closed_fibre_square x B Λ' W'' φ' a' hsh
  obtain ⟨_, cS', θ, hsqS, -⟩ := wc_ppu_lc_thickening_square x B a' c g hsq hg hcg S
  haveI := wc_ppu_lc_henselian B S
  have hW := wc_hte_wcontr_of_iso _ _ θ.symm wc_hte_sepClosed_henselian_transport
    (wc_ppu_lc_field_wcontr (X.residueField x) S)
  exact wc_proet_module_unit_bij_thickening (X.fromSpecResidueField x) ℓ Dk hDk
    (LocallyConstant S B) _ (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')) (Iso.refl _) cS' hsqS hW M

theorem wc_ppu_lc_constRingHom_weaklyEtale (B : Type u) [CommRing B]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] :
    WeaklyEtale (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B))) :=
by
  classical
  have hind : wcIndEtale (LocallyConstant.constRingHom : B →+* LocallyConstant S B) := by
    unfold wcIndEtale
    rw [show (LocallyConstant.constRingHom : B →+* LocallyConstant S B).toAlgebra =
      (inferInstance : Algebra B (LocallyConstant S B)) from
        Algebra.algebra_ext _ _ (fun _ => rfl)]
    intro P _ _ _ h
    obtain ⟨t, ht⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra B P).FG)
    let u : LocallyConstant S (t → B) := LocallyConstant.unflip (fun i : t => h i.1)
    have hfin : (Set.range ⇑u).Finite := LocallyConstant.range_finite u
    haveI : Finite (Set.range ⇑u) := hfin.to_subtype
    let τ : S → Set.range ⇑u := Set.rangeFactorization ⇑u
    have hτ : IsLocallyConstant τ :=
      IsLocallyConstant.desc τ Subtype.val u.isLocallyConstant Subtype.val_injective
    let sel : Set.range ⇑u → S := fun c => Classical.choose c.2
    have hsel : ∀ c, u (sel c) = c.1 := fun c => Classical.choose_spec c.2
    have key : ∀ (s : S) (x : P), x ∈ (t : Set P) → h x (sel (τ s)) = h x s := by
      intro s x hx
      have h1 : u (sel (τ s)) = u s := hsel (τ s)
      exact congrFun h1 ⟨x, hx⟩
    let α : P →ₐ[B] (Set.range ⇑u → B) :=
      AlgHom.pi (fun c : Set.range ⇑u => (LocallyConstant.evalₐ B (sel c)).comp h)
    let β : (Set.range ⇑u → B) →ₐ[B] LocallyConstant S B :=
      { toFun := fun g => ⟨g ∘ τ, hτ.comp g⟩
        map_one' := LocallyConstant.ext fun _ => rfl
        map_mul' := fun _ _ => LocallyConstant.ext fun _ => rfl
        map_zero' := LocallyConstant.ext fun _ => rfl
        map_add' := fun _ _ => LocallyConstant.ext fun _ => rfl
        commutes' := fun _ => LocallyConstant.ext fun _ => rfl }
    refine ⟨Set.range ⇑u → B, inferInstance, inferInstance, inferInstance, α, β, ?_⟩
    apply AlgHom.ext_of_adjoin_eq_top ht
    intro x hx
    apply LocallyConstant.ext
    intro s
    exact key s x hx
  have hwe := wc_indEtale_weaklyEtale _ hind
  letI := (LocallyConstant.constRingHom : B →+* LocallyConstant S B).toAlgebra
  exact wc_lfi_specMap_weaklyEtale B (LocallyConstant S B) hwe

theorem wc_ppu_lc_spec_map_of_continuous (K : Type u) [Field K] (T : Scheme.{u})
    (str : T ⟶ Spec (.of K)) (S : Type u) [TopologicalSpace S] [CompactSpace S]
    (π : C(↥T, S)) :
    ∃ g : T ⟶ Spec (.of (LocallyConstant S K)),
      g ≫ Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : K →+* LocallyConstant S K)) = str ∧
      ∀ (t : ↥T) (f : LocallyConstant S K), f ∈ (g t).asIdeal ↔ f (π t) = 0 :=
by
  classical
  set φ : K →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ str.appTop).hom with hφ
  have ext : ∀ a b : Γ(T, ⊤),
      (∀ t : T, T.presheaf.germ ⊤ t trivial a = T.presheaf.germ ⊤ t trivial b) → a = b :=
    fun a b h => TopCat.Presheaf.section_ext T.sheaf ⊤ a b (fun t _ => h t)

  have glue : ∀ f : LocallyConstant S K, ∃ s : Γ(T, ⊤), ∀ t : T,
      T.presheaf.germ ⊤ t trivial s = T.presheaf.germ ⊤ t trivial (φ (f (π t))) := by
    intro f
    let U : K → T.Opens := fun c =>
      ⟨π ⁻¹' {x | f x = c}, (f.isLocallyConstant.isOpen_fiber c).preimage π.continuous⟩
    have hU : ∀ c (x : T), x ∈ U c ↔ f (π x) = c := fun c x => Iff.rfl
    have hcov : (⊤ : T.Opens) ≤ iSup U := by
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨f (π x), (hU _ x).mpr rfl⟩
    let sf : ∀ c, Γ(T, U c) := fun c => T.presheaf.map (homOfLE le_top).op (φ c)
    have hcompat : TopCat.Presheaf.IsCompatible T.sheaf.obj U sf := by
      intro i j
      apply TopCat.Presheaf.section_ext T.sheaf (U i ⊓ U j)
      intro x hx
      have hi : f (π x) = i := hx.1
      have hj : f (π x) = j := hx.2
      subst hi hj
      simp only [sf]
      repeat erw [TopCat.Presheaf.germ_res_apply]
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' T.sheaf U ⊤ (fun c => homOfLE le_top)
      hcov sf hcompat
    refine ⟨s, fun t => ?_⟩
    have h := congrArg (T.presheaf.germ (U (f (π t))) t ((hU _ t).mpr rfl)) (hs (f (π t)))
    simp only [sf] at h
    repeat erw [TopCat.Presheaf.germ_res_apply] at h
    exact h

  choose σ hσ using glue
  let Φ : LocallyConstant S K →+* Γ(T, ⊤) :=
    { toFun := σ
      map_one' := ext _ _ fun t => by
        rw [hσ, LocallyConstant.one_apply, map_one, map_one]
      map_mul' := fun a b => ext _ _ fun t => by
        rw [map_mul, hσ, hσ, hσ, LocallyConstant.mul_apply, map_mul, map_mul]
      map_zero' := ext _ _ fun t => by
        rw [hσ, LocallyConstant.zero_apply, map_zero, map_zero]
      map_add' := fun a b => ext _ _ fun t => by
        rw [map_add, hσ, hσ, hσ, LocallyConstant.add_apply, map_add, map_add] }
  have hΦ : ∀ f, Φ f = σ f := fun f => rfl
  have hΦc : Φ.comp LocallyConstant.constRingHom = φ := by
    apply RingHom.ext
    intro c
    apply ext
    intro t
    rw [RingHom.comp_apply, hΦ, hσ]
    rfl
  refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom Φ), ?_, ?_⟩
  ·
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hΦc, hφ,
      CommRingCat.ofHom_hom, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
      Category.comp_id]
  · intro t f

    have h2 : ∀ s : Γ(T, ⊤), s ∈ (T.toSpecΓ t).asIdeal ↔
        ¬ IsUnit (T.presheaf.germ ⊤ t trivial s) := by
      intro s
      have hb := Scheme.mem_basicOpen_top T s t
      rw [← Scheme.toSpecΓ_preimage_basicOpen] at hb
      have h' : t ∈ T.toSpecΓ ⁻¹ᵁ PrimeSpectrum.basicOpen s ↔ s ∉ (T.toSpecΓ t).asIdeal :=
        Iff.rfl
      rw [← hb, h', not_not]
    have h1 : f ∈ ((T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom Φ)) t).asIdeal ↔
        Φ f ∈ (T.toSpecΓ t).asIdeal := Iff.rfl
    rw [h1, h2, hΦ, hσ]
    constructor
    · intro hn
      by_contra hc
      exact hn (((isUnit_iff_ne_zero.mpr hc).map φ).map _)
    · intro hc
      rw [hc, map_zero, map_zero]
      exact not_isUnit_zero

theorem wc_ppu_sepClosed_proet_affine_lc_surj (K : Type u) [Field K] [IsSepClosed K]
    (W : (Spec (.of K)).ProEt) [IsAffine W.left] :
    ∃ (S : Type u) (_ : TopologicalSpace S) (_ : CompactSpace S) (_ : T2Space S)
      (_ : TotallyDisconnectedSpace S) (_ : ExtremallyDisconnected S)
      (g : Spec (.of (LocallyConstant S K)) ⟶ W.left),
      g ≫ W.hom = Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : K →+* LocallyConstant S K)) ∧
      Function.Surjective g :=
by



  have wc_lpkt_specMap_weaklyEtale_ring : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)

  have wc_weaklyEtale_field_vnr : ∀ (K R : Type u) [Field K] [CommRing R] [Algebra K R]
      (_ : Algebra.WeaklyEtale K R)
      (_ : ∀ (M : Type u) [AddCommGroup M] [Module K M] [Module R M] [IsScalarTower K R M],
        Module.Flat K M → Module.Flat R M),
      ∀ x : R, ∃ t : R, x * x * t = x := by
    intro K R _ _ _ h htransfer
    intro x
    classical
    haveI hflat : Module.Flat R (R ⧸ Ideal.span {x}) := htransfer (R ⧸ Ideal.span {x}) inferInstance
    have hsmul : ∀ (b r : R), b • (Ideal.Quotient.mk (Ideal.span {x}) r) =
        Ideal.Quotient.mk (Ideal.span {x}) (b * r) := by
      intro b r
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
    have hsum : ∑ i : Fin 1, (fun _ => x) i •
        (fun _ => (Ideal.Quotient.mk (Ideal.span {x}) 1 : R ⧸ Ideal.span {x})) i = 0 := by
      rw [Fin.sum_univ_one]
      show x • (Ideal.Quotient.mk (Ideal.span {x}) 1) = 0
      rw [hsmul, mul_one]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
    obtain ⟨k, a, y, hx, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hsum
    choose r hr using fun j => Ideal.Quotient.mk_surjective (I := Ideal.span {x}) (y j)
    have hx0 : (Ideal.Quotient.mk (Ideal.span {x}) 1 : R ⧸ Ideal.span {x}) =
        ∑ j, a 0 j • y j := hx 0
    have h1 : Ideal.Quotient.mk (Ideal.span {x}) 1 =
        Ideal.Quotient.mk (Ideal.span {x}) (∑ j, a 0 j * r j) := by
      rw [hx0, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← hr j, hsmul]
    rw [Ideal.Quotient.eq, Ideal.mem_span_singleton'] at h1
    obtain ⟨c, hc⟩ := h1
    have hxs : x * ∑ j, a 0 j * r j = 0 := by
      rw [Finset.mul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h2 : ∑ i : Fin 1, (fun _ => x) i * a i j = 0 := hrel j
      rw [Fin.sum_univ_one] at h2
      have h3 : x * a 0 j = 0 := h2
      rw [← mul_assoc, h3, zero_mul]
    exact ⟨c, by linear_combination x * hc - hxs⟩

  have wc_weaklyEtale_flat_transfer : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      (_ : Algebra.WeaklyEtale A B) (M : Type u) [AddCommGroup M] [Module A M] [Module B M]
      [IsScalarTower A B M] (_ : Module.Flat A M), Module.Flat B M := by
    intro A B _ _ _ hB M _ _ _ _ hM
    haveI := hB
    haveI := hM
    have flat_prod : ∀ (R P Q : Type u) [CommRing R] [AddCommGroup P] [AddCommGroup Q]
        [Module R P] [Module R Q], Module.Flat R P → Module.Flat R Q → Module.Flat R (P × Q) := by
      intro R P Q _ _ _ _ _ hP hQ
      rw [Module.Flat.iff_rTensor_preserves_injective_linearMap]
      intro N N' _ _ _ _ f hf
      have h1 := Module.Flat.rTensor_preserves_injective_linearMap (M := P) f hf
      have h2 := Module.Flat.rTensor_preserves_injective_linearMap (M := Q) f hf
      have key : (TensorProduct.prodRight R R N' P Q).toLinearMap ∘ₗ LinearMap.rTensor (P × Q) f =
          ((LinearMap.rTensor P f).prodMap (LinearMap.rTensor Q f)) ∘ₗ
            (TensorProduct.prodRight R R N P Q).toLinearMap := by
        apply TensorProduct.ext'
        intro n pq
        simp [TensorProduct.prodRight_tmul]
      have hinj : Function.Injective ((TensorProduct.prodRight R R N' P Q).toLinearMap ∘ₗ
          LinearMap.rTensor (P × Q) f) := by
        rw [key]
        exact (Function.Injective.prodMap h1 h2).comp (TensorProduct.prodRight R R N P Q).injective
      exact Function.Injective.of_comp hinj
    have alg_transfer : ∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra B C]
        [IsScalarTower A B C], Module.Flat A C → Module.Flat B C := by
      intro C _ _ _ _ hC
      haveI := hC
      have h1 : (Algebra.TensorProduct.mapOfCompatibleSMul B A B B C :
          TensorProduct A B C →+* TensorProduct B B C).Flat :=
        RingHom.Flat.mapOfCompatibleSMul (R := A) (S := B) B C (Algebra.WeaklyEtale.flat_lmul' A B)
      have h2 : ((Algebra.TensorProduct.lid B C : TensorProduct B B C ≃ₐ[B] C) :
          TensorProduct B B C →+* C).Flat :=
        RingHom.Flat.of_bijective (Algebra.TensorProduct.lid B C).bijective
      let φ : TensorProduct A B C →ₐ[B] C :=
        (Algebra.TensorProduct.lid B C).toAlgHom.comp
          (Algebra.TensorProduct.mapOfCompatibleSMul B A B B C)
      have hφ : (φ : TensorProduct A B C →+* C).Flat := RingHom.Flat.comp h1 h2
      have h3 : (algebraMap B (TensorProduct A B C)).Flat :=
        RingHom.flat_algebraMap_iff.mpr (Module.Flat.baseChange A B C)
      have h4 : ((φ : TensorProduct A B C →+* C).comp (algebraMap B (TensorProduct A B C))).Flat :=
        RingHom.Flat.comp h3 hφ
      rw [AlgHom.comp_algebraMap φ] at h4
      exact RingHom.flat_algebraMap_iff.mp h4
    letI : Module Bᵐᵒᵖ M := Module.compHom M ((RingHom.id B).fromOpposite mul_comm)
    haveI : IsCentralScalar B M := ⟨fun _ _ => rfl⟩
    have hBA : Module.Flat A B := Algebra.WeaklyEtale.flat
    have hprod : Module.Flat A (B × M) := flat_prod A B M hBA hM
    have hCA : Module.Flat A (TrivSqZeroExt B M) := hprod
    have hCB : Module.Flat B (TrivSqZeroExt B M) := alg_transfer (TrivSqZeroExt B M) hCA
    exact @Module.Flat.of_retract B (TrivSqZeroExt B M) M _ _ _ _ _ hCB (TrivSqZeroExt.inrHom B M)
      (TrivSqZeroExt.sndHom B M) (LinearMap.ext fun m => TrivSqZeroExt.snd_inr B m)

  have wc_localization_weaklyEtale : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L]
      (M : Submonoid A) [IsLocalization M L], Algebra.WeaklyEtale A L := by
    intro A L _ _ _ M _
    haveI hc : TensorProduct.CompatibleSMul A L L L :=
      IsLocalization.tensorProduct_compatibleSMul M L L L
    have key : ∀ z : TensorProduct A L L,
        z = (Algebra.TensorProduct.lmul' A (S := L) z) ⊗ₜ[A] (1 : L) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, TensorProduct.zero_tmul]
      | tmul a b =>
        rw [Algebra.TensorProduct.lmul'_apply_tmul]
        have h := TensorProduct.smul_tmul (R := A) b a (1 : L)
        rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
        exact h.symm
      | add x y hx hy =>
        rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
    have hbij : Function.Bijective (Algebra.TensorProduct.lmul' A (S := L)) := by
      refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[A] (1 : L), ?_⟩⟩
      · rw [key z₁, key z₂, h]
      · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
    exact Algebra.WeaklyEtale.mk (IsLocalization.flat L M)
      (RingHom.Flat.of_bijective (f := (Algebra.TensorProduct.lmul' A (S := L)).toRingHom) hbij)

  have wc_weaklyEtale_point_algebraic : ∀ (A B K : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Field K], Algebra.WeaklyEtale A B → ∀ (φ : B →+* K) (b : B), ∃ f : Polynomial A,
      f.map (φ.comp (algebraMap A B)) ≠ 0 ∧ f.eval₂ (φ.comp (algebraMap A B)) (φ b) = 0 := by
    classical
    have s1 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] (x : K), Transcendental k x →
        ∀ z : TensorProduct k K K, (x ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] x) * z = 0 → z = 0 := by
      intro k K _ _ _ x hx z hz
      letI : Algebra (Polynomial k) K := (Polynomial.aeval x).toRingHom.toAlgebra
      have hPK : ∀ p : Polynomial k, algebraMap (Polynomial k) K p = Polynomial.aeval x p :=
        fun p => rfl
      haveI : IsScalarTower k (Polynomial k) K := IsScalarTower.of_algebraMap_eq (fun c => by
        rw [hPK]; exact ((Polynomial.aeval x).commutes c).symm)
      have hinjx : Function.Injective (Polynomial.aeval (R := k) x) :=
        (transcendental_iff_injective).mp hx
      haveI hflat : Module.Flat (Polynomial k) K := by
        rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
        intro y hy
        obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff y).mp hy
        rw [Submodule.mem_bot]
        rw [Submonoid.smul_def, Algebra.smul_def, hPK] at ha
        have ha0 : Polynomial.aeval x (a : Polynomial k) ≠ 0 := by
          intro h
          apply nonZeroDivisors.coe_ne_zero a
          apply hinjx
          rw [h, map_zero]
        exact (mul_eq_zero.mp ha).resolve_left ha0
      let e := Algebra.TensorProduct.cancelBaseChange k (Polynomial k) (Polynomial k) K K
      let u : TensorProduct k (Polynomial k) K :=
        (Polynomial.X : Polynomial k) ⊗ₜ[k] (1 : K) - (1 : Polynomial k) ⊗ₜ[k] x
      have heu : e ((1 : K) ⊗ₜ[Polynomial k] u) = x ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] x := by
        simp only [u, TensorProduct.tmul_sub, map_sub, e,
          Algebra.TensorProduct.cancelBaseChange_tmul]
        rw [Algebra.smul_def, Algebra.smul_def, hPK, hPK, Polynomial.aeval_X, map_one, mul_one,
          mul_one]
      let Ψ : Polynomial K ≃+* TensorProduct k (Polynomial k) K :=
        (polyEquivTensor' k K).toRingEquiv.trans
          (Algebra.TensorProduct.comm k K (Polynomial k)).toRingEquiv
      have hΨ : Ψ (Polynomial.X - Polynomial.C x) = u := by
        simp only [Ψ, RingEquiv.trans_apply, AlgEquiv.coe_ringEquiv]
        have h1 : (polyEquivTensor' k K) (Polynomial.X - Polynomial.C x) =
            (1 : K) ⊗ₜ[k] (Polynomial.X : Polynomial k) - x ⊗ₜ[k] (1 : Polynomial k) := by
          show polyEquivTensor k K _ = _
          rw [polyEquivTensor_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
          rfl
        rw [h1, map_sub, Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.comm_tmul]
      have hmu : Function.Injective (LinearMap.mulLeft (Polynomial k) u) := by
        rw [injective_iff_map_eq_zero]
        intro v hv
        rw [LinearMap.mulLeft_apply] at hv
        have h2 : Ψ.symm u * Ψ.symm v = 0 := by rw [← map_mul, hv, map_zero]
        have h3 : Ψ.symm u ≠ 0 := by
          rw [← hΨ, RingEquiv.symm_apply_apply]; exact Polynomial.X_sub_C_ne_zero x
        have h4 : Ψ.symm v = 0 := (mul_eq_zero.mp h2).resolve_left h3
        rw [← Ψ.apply_symm_apply v, h4, map_zero]
      have hlt := Module.Flat.lTensor_preserves_injective_linearMap (M := K) _ hmu
      have hkey : LinearMap.lTensor K (LinearMap.mulLeft (Polynomial k) u) =
          LinearMap.mulLeft (Polynomial k) ((1 : K) ⊗ₜ[Polynomial k] u) :=
        TensorProduct.ext' (fun a v => by
          rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, LinearMap.mulLeft_apply,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul])
      have h5 : ((1 : K) ⊗ₜ[Polynomial k] u) * e.symm z = 0 := by
        apply e.injective
        rw [map_mul, heu, AlgEquiv.apply_symm_apply, hz, map_zero]
      have h6 : e.symm z = 0 := hlt (by rw [hkey, LinearMap.mulLeft_apply, h5, map_zero])
      rw [← e.apply_symm_apply z, h6, map_zero]
    have s2 : ∀ (A K : Type u) [CommRing A] [Field K] (ψ : A →+* K) (x : K),
        IsAlgebraic (Subfield.closure (Set.range ψ)) x →
        ∃ f : Polynomial A, f.map ψ ≠ 0 ∧ f.eval₂ ψ x = 0 := by
      intro A K _ _ ψ x h
      set k := Subfield.closure (Set.range ψ) with hk
      have hfrac : ∀ c : k, ∃ a d : A, ψ d ≠ 0 ∧ algebraMap k K c * ψ d = ψ a := by
        intro c
        obtain ⟨y, hy, z, hz, hyz⟩ := Subfield.mem_closure_iff.mp c.2
        have hR : ∀ w ∈ Subring.closure (Set.range ψ), ∃ a, ψ a = w := by
          intro w hw
          rw [← RingHom.coe_range, Subring.closure_eq] at hw
          exact RingHom.mem_range.mp hw
        obtain ⟨a, rfl⟩ := hR y hy
        obtain ⟨d, rfl⟩ := hR z hz
        show ∃ a' d', ψ d' ≠ 0 ∧ (c : K) * ψ d' = ψ a'
        by_cases hd : ψ d = 0
        · refine ⟨0, 1, by rw [map_one]; exact one_ne_zero, ?_⟩
          rw [← hyz, hd, div_zero, zero_mul, map_zero]
        · refine ⟨a, d, hd, ?_⟩
          rw [← hyz, div_mul_cancel₀ _ hd]
      have hclear : ∀ g : Polynomial k, ∃ (D : A) (f : Polynomial A), ψ D ≠ 0 ∧
          f.map ψ = Polynomial.C (ψ D) * g.map (algebraMap k K) := by
        intro g
        induction g using Polynomial.induction_on' with
        | add p q hp hq =>
          obtain ⟨D₁, f₁, hD₁, hf₁⟩ := hp
          obtain ⟨D₂, f₂, hD₂, hf₂⟩ := hq
          refine ⟨D₁ * D₂, Polynomial.C D₂ * f₁ + Polynomial.C D₁ * f₂, ?_, ?_⟩
          · rw [map_mul]; exact mul_ne_zero hD₁ hD₂
          · rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
              Polynomial.map_C, hf₁, hf₂, Polynomial.map_add, map_mul, Polynomial.C_mul]
            ring
        | monomial n c =>
          obtain ⟨a, d, hd, hc⟩ := hfrac c
          refine ⟨d, Polynomial.monomial n a, hd, ?_⟩
          rw [Polynomial.map_monomial, Polynomial.map_monomial, Polynomial.C_mul_monomial, ← hc,
            mul_comm]
      obtain ⟨g, hg, hg0⟩ := h
      obtain ⟨D, f, hD, hf⟩ := hclear g
      refine ⟨f, ?_, ?_⟩
      · rw [hf]
        exact mul_ne_zero (Polynomial.C_ne_zero.mpr hD)
          ((Polynomial.map_ne_zero_iff (algebraMap k K).injective).mpr hg)
      · rw [Polynomial.eval₂_eq_eval_map, hf, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_map, ← Polynomial.aeval_def, hg0, mul_zero]
    have s3 : ∀ (A B k K : Type u) [CommRing A] [CommRing B] [Algebra A B] [Field k] [Field K]
        [Algebra k K] (φ : B →+* K),
        (∀ a : A, φ (algebraMap A B a) ∈ Set.range (algebraMap k K)) →
        ∃ Θ : TensorProduct A B B →+* TensorProduct k K K,
          (∀ b : B, Θ (b ⊗ₜ[A] (1 : B)) = φ b ⊗ₜ[k] (1 : K)) ∧
          (∀ b : B, Θ ((1 : B) ⊗ₜ[A] b) = (1 : K) ⊗ₜ[k] φ b) ∧
          ∀ t : TensorProduct A B B, Algebra.TensorProduct.lmul' k (S := K) (Θ t) =
            φ (Algebra.TensorProduct.lmul' A (S := B) t) := by
      intro A B k K _ _ _ _ _ _ φ hk
      letI : Algebra A (TensorProduct k K K) :=
        (Algebra.TensorProduct.includeLeftRingHom.comp (φ.comp (algebraMap A B))).toAlgebra
      let f₁ : B →ₐ[A] TensorProduct k K K :=
        { Algebra.TensorProduct.includeLeftRingHom.comp φ with commutes' := fun a => rfl }
      let f₂ : B →ₐ[A] TensorProduct k K K :=
        { (Algebra.TensorProduct.includeRight : K →ₐ[k] TensorProduct k K K).toRingHom.comp φ with
          commutes' := fun a => by
            obtain ⟨c, hc⟩ := hk a
            show (1 : K) ⊗ₜ[k] φ (algebraMap A B a) = φ (algebraMap A B a) ⊗ₜ[k] (1 : K)
            rw [← hc, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul] }
      have hf₁ : ∀ b, f₁ b = φ b ⊗ₜ[k] (1 : K) := fun b => rfl
      have hf₂ : ∀ b, f₂ b = (1 : K) ⊗ₜ[k] φ b := fun b => rfl
      have hΘ : ∀ b₁ b₂ : B, Algebra.TensorProduct.productMap f₁ f₂ (b₁ ⊗ₜ[A] b₂) =
          φ b₁ ⊗ₜ[k] φ b₂ := by
        intro b₁ b₂
        rw [Algebra.TensorProduct.productMap_apply_tmul, hf₁, hf₂,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      refine ⟨(Algebra.TensorProduct.productMap f₁ f₂).toRingHom, fun b => ?_, fun b => ?_, ?_⟩
      · show Algebra.TensorProduct.productMap f₁ f₂ (b ⊗ₜ[A] (1 : B)) = _
        rw [hΘ, map_one]
      · show Algebra.TensorProduct.productMap f₁ f₂ ((1 : B) ⊗ₜ[A] b) = _
        rw [hΘ, map_one]
      · intro t
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul b₁ b₂ =>
          show Algebra.TensorProduct.lmul' k (S := K)
            (Algebra.TensorProduct.productMap f₁ f₂ (b₁ ⊗ₜ[A] b₂)) = _
          rw [hΘ, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
            map_mul]
        | add s t hs ht => simp only [map_add, hs, ht]
    have habsorb : ∀ (R : Type u) [CommRing R] (I : Ideal R), Module.Flat R (R ⧸ I) →
        ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
      intro R _ I hflat x hx
      have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : R ⧸ I)) i = 0 := by
        rw [Fin.sum_univ_one]
        show x • (1 : R ⧸ I) = 0
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hx
      obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
      choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
      set w : R := ∑ j, a 0 j * b j with hw
      have h10 : (1 : R ⧸ I) = ∑ j, a 0 j • y j := h1 0
      have hmk : Ideal.Quotient.mk I w = 1 := by
        rw [hw, map_sum, h10]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
      have hxw : x * w = 0 := by
        rw [hw, Finset.mul_sum]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        have := h2 j
        rw [Fin.sum_univ_one] at this
        rw [← mul_assoc, this, zero_mul]
      refine ⟨1 - w, ?_, ?_⟩
      · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
      · rw [mul_sub, mul_one, hxw, sub_zero]
    have s4 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
        Algebra.WeaklyEtale A B → ∀ b : B, ∃ w : TensorProduct A B B,
          Algebra.TensorProduct.lmul' A (S := B) w = 0 ∧
          (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) * w = b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b := by
      intro A B _ _ _ hW b
      have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' A (S := B)) := fun b =>
        ⟨b ⊗ₜ[A] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
      have hflatQ : Module.Flat (TensorProduct A B B)
          (TensorProduct A B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
        let e := RingHom.quotientKerEquivOfSurjective
          (f := (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) hμsurj
        have h1 : ((Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat := hW.flat_lmul'
        have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat :=
          RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
        have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom =
            algebraMap _ (TensorProduct A B B ⧸
              RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
          refine RingHom.ext fun t => ?_
          rw [Ideal.Quotient.algebraMap_eq]
          show e.symm (Algebra.TensorProduct.lmul' A (S := B) t) = Ideal.Quotient.mk _ t
          rw [e.symm_apply_eq]
          rfl
        rw [h3, RingHom.flat_algebraMap_iff] at h2
        exact h2
      obtain ⟨z, hz, hxz⟩ := habsorb _ _ hflatQ
        (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) (by
          rw [RingHom.mem_ker]
          show Algebra.TensorProduct.lmul' A (S := B) (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) = 0
          rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
            Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self])
      exact ⟨z, RingHom.mem_ker.mp hz, hxz⟩
    intro A B K _ _ _ _ hW φ b
    by_contra hno
    let k := Subfield.closure (Set.range (φ.comp (algebraMap A B)))
    have htr : Transcendental k (φ b) := fun halg => hno (s2 A K _ (φ b) halg)
    obtain ⟨Θ, hΘl, hΘr, hΘμ⟩ := s3 A B k K φ
      (fun a => ⟨⟨φ (algebraMap A B a), Subfield.subset_closure ⟨a, rfl⟩⟩, rfl⟩)
    obtain ⟨w, hw0, hw⟩ := s4 A B hW b
    have hδ : (φ b ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] φ b) * (Θ w - 1) = 0 := by
      have h := congrArg Θ hw
      rw [map_mul, map_sub, hΘl, hΘr] at h
      rw [mul_sub, mul_one, h, sub_self]
    have h1 : Θ w - 1 = 0 := s1 k K (φ b) htr _ hδ
    have h2 : Θ w = 1 := sub_eq_zero.mp h1
    have h3 := hΘμ w
    rw [h2, map_one, hw0, map_zero] at h3
    exact one_ne_zero h3

  have wc_mnt_weaklyEtale_field_isSeparable : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L],
      Algebra.WeaklyEtale K L → Algebra.IsAlgebraic K L → Algebra.IsSeparable K L := by
    open TensorProduct in
    · intro K L _ _ _ hWE hAlg
      classical
      have s1 : ∀ α : L, ∃ a : L ⊗[K] L, (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) * a = 0 ∧
          Algebra.TensorProduct.lmul' K a ≠ 0 := by
        intro α
        letI : Algebra (L ⊗[K] L) L :=
          (Algebra.TensorProduct.lmul' K : L ⊗[K] L →ₐ[K] L).toRingHom.toAlgebra
        have hfl : Module.Flat (L ⊗[K] L) L := hWE.flat_lmul'
        have hsmul : ∀ (c : L ⊗[K] L) (x : L), c • x = Algebra.TensorProduct.lmul' K c * x := by
          intro c x; rfl
        have hμδ : Algebra.TensorProduct.lmul' K (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) = 0 := by
          rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
            Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self]
        have hsum : ∑ i : Fin 1, (fun _ => (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α)) i •
            (fun _ => (1:L)) i = 0 := by
          rw [Fin.sum_univ_one]
          exact (hsmul _ _).trans (by rw [hμδ, zero_mul])
        obtain ⟨k, A, y, hx, hA⟩ := @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
          (L ⊗[K] L) L _ _ _ hfl (Fin 1) _ _ _ hsum
        have h1 : (1 : L) = ∑ j, A 0 j • y j := hx 0
        have hne : ∑ j, A 0 j • y j ≠ 0 := by rw [← h1]; exact one_ne_zero
        obtain ⟨j, _, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
        refine ⟨A 0 j, ?_, ?_⟩
        · have h2 := hA j
          rw [Fin.sum_univ_one] at h2
          exact h2
        · intro h0
          apply hj
          rw [hsmul, h0, zero_mul]
      have s2 : ∀ (α : L) (a : L ⊗[K] L), (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) * a = 0 →
          Algebra.TensorProduct.lmul' K a ≠ 0 →
          ∃ s : L ⊗[K] IntermediateField.adjoin K {α},
            (α ⊗ₜ[K] (1 : IntermediateField.adjoin K {α}) -
              (1 : L) ⊗ₜ[K] IntermediateField.AdjoinSimple.gen K α) * s = 0 ∧
            Algebra.TensorProduct.productMap (AlgHom.id K L)
              (IsScalarTower.toAlgHom K (IntermediateField.adjoin K {α}) L) s ≠ 0 := by
        intro α a ha hμ
        set M := IntermediateField.adjoin K {α}
        set gen := IntermediateField.AdjoinSimple.gen K α
        set μ' := Algebra.TensorProduct.productMap (AlgHom.id K L) (IsScalarTower.toAlgHom K M L)
        let b := Module.Basis.ofVectorSpace M L
        let Φ : _ → L ⊗[K] L →ₗ[K] L ⊗[K] M :=
          fun j => LinearMap.lTensor L ((b.coord j).restrictScalars K)
        have hΦtmul : ∀ j x y, Φ j (x ⊗ₜ y) = x ⊗ₜ (b.coord j y) := fun _ _ _ => rfl
        have hgen : algebraMap M L gen = α := IntermediateField.AdjoinSimple.algebraMap_gen K α
        have hA : ∀ j (a : L ⊗[K] L), Φ j ((α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) * a) =
            (α ⊗ₜ[K] (1 : M) - (1 : L) ⊗ₜ[K] gen) * Φ j a := by
          intro j a
          induction a using TensorProduct.induction_on with
          | zero => simp
          | tmul x y =>
            rw [sub_mul, sub_mul, Algebra.TensorProduct.tmul_mul_tmul,
              Algebra.TensorProduct.tmul_mul_tmul, map_sub, hΦtmul, hΦtmul, hΦtmul,
              Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul]
            simp only [one_mul]
            have : α * y = gen • y := by rw [Algebra.smul_def, hgen]
            rw [this, LinearMap.map_smul, smul_eq_mul]
          | add x y hx hy => rw [mul_add, map_add, hx, hy, map_add, mul_add]
        have hC : ∀ a : L ⊗[K] L, ∃ T : Finset _, ∀ T' ⊇ T,
            Algebra.TensorProduct.lmul' K a = ∑ j ∈ T', μ' (Φ j a) * b j := by
          intro a
          induction a using TensorProduct.induction_on with
          | zero => exact ⟨∅, fun T' _ => by simp⟩
          | tmul x y =>
            refine ⟨(b.repr y).support, fun T' hT' => ?_⟩
            rw [Algebra.TensorProduct.lmul'_apply_tmul]
            have hy : y = ∑ j ∈ T', (b.repr y j) • b j := by
              conv_lhs => rw [← b.linearCombination_repr y]
              rw [Finsupp.linearCombination_apply, Finsupp.sum_of_support_subset _ hT']
              intro i _; exact zero_smul _ _
            conv_lhs => rw [hy]
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [hΦtmul, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply,
              IsScalarTower.coe_toAlgHom', Module.Basis.coord_apply, Algebra.smul_def]
            ring
          | add x y hx hy =>
            obtain ⟨T1, h1⟩ := hx
            obtain ⟨T2, h2⟩ := hy
            refine ⟨T1 ∪ T2, fun T' hT' => ?_⟩
            rw [map_add, h1 T' (subset_trans Finset.subset_union_left hT'),
              h2 T' (subset_trans Finset.subset_union_right hT'), ← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_add, map_add, add_mul]
        obtain ⟨T, hT⟩ := hC a
        have := hT T le_rfl
        rw [this] at hμ
        obtain ⟨j, _, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hμ
        refine ⟨Φ j a, ?_, ?_⟩
        · rw [← hA, ha, map_zero]
        · intro h0; apply hj; rw [h0, zero_mul]
      have s34 : ∀ (α : L), IsIntegral K α → Polynomial.derivative (minpoly K α) = 0 →
          ∀ (s : L ⊗[K] IntermediateField.adjoin K {α}),
          (α ⊗ₜ[K] (1 : IntermediateField.adjoin K {α}) -
              (1 : L) ⊗ₜ[K] IntermediateField.AdjoinSimple.gen K α) * s = 0 →
          Algebra.TensorProduct.productMap (AlgHom.id K L)
              (IsScalarTower.toAlgHom K (IntermediateField.adjoin K {α}) L) s = 0 := by
        intro α hint hd
        set M := IntermediateField.adjoin K {α}
        set gen := IntermediateField.AdjoinSimple.gen K α
        set μ' := Algebra.TensorProduct.productMap (AlgHom.id K L) (IsScalarTower.toAlgHom K M L)
        set θ : L ⊗[K] M := (1 : L) ⊗ₜ[K] gen with hθ
        intro s hs
        let pb := IntermediateField.adjoin.powerBasis hint
        have hpbgen : pb.gen = gen := IntermediateField.adjoin.powerBasis_gen hint
        let B := Algebra.TensorProduct.basis L pb.basis
        have hB : ∀ i : Fin pb.dim, B i = θ ^ (i : ℕ) := by
          intro i
          rw [Algebra.TensorProduct.basis_apply, PowerBasis.coe_basis, hθ,
            Algebra.TensorProduct.tmul_pow, one_pow, hpbgen]
        let pb' : PowerBasis L (L ⊗[K] M) :=
          { gen := θ, dim := pb.dim, basis := B, basis_eq_pow := hB }
        have hgen' : pb'.gen = θ := rfl
        have hdim : pb.dim = (minpoly K α).natDegree :=
          IntermediateField.adjoin.powerBasis_dim hint
        have hpos : 0 < pb.dim := by rw [hdim]; exact minpoly.natDegree_pos hint
        haveI : Nontrivial (L ⊗[K] M) := nontrivial_of_ne (B ⟨0, hpos⟩) 0 (B.ne_zero _)
        set FL := (minpoly K α).map (algebraMap K L) with hFL
        have hFLmon : FL.Monic := (minpoly.monic hint).map _
        have hFLdeg : FL.natDegree = pb.dim := by
          rw [hdim, hFL, (minpoly.monic hint).natDegree_map]
        have hθF : Polynomial.aeval θ FL = 0 := by
          rw [hFL, Polynomial.aeval_map_algebraMap, hθ]
          have : (1 : L) ⊗ₜ[K] gen = Algebra.TensorProduct.includeRight gen := rfl
          rw [this, Polynomial.aeval_algHom_apply, ← IntermediateField.minpoly_gen K α,
            minpoly.aeval, map_zero]
        have hmin : minpoly L θ = FL := by
          have hdvd : minpoly L θ ∣ FL := minpoly.dvd L θ hθF
          have hint' : IsIntegral L θ := pb'.isIntegral_gen
          refine (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint')
            hFLmon hdvd ?_).symm
          rw [hFLdeg, ← hgen', PowerBasis.natDegree_minpoly]
        have hev : ∀ P : Polynomial L, μ' (Polynomial.aeval θ P) = P.eval α := by
          intro P
          have : (μ'.toRingHom.comp (Polynomial.aeval θ).toRingHom) =
              Polynomial.evalRingHom α := by
            apply Polynomial.ringHom_ext
            · intro x
              simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
                RingHom.coe_coe, Polynomial.aeval_C, Polynomial.coe_evalRingHom,
                Polynomial.eval_C]
              rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
                RingHom.id_apply]
              rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one,
                AlgHom.id_apply]
            · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
                RingHom.coe_coe, Polynomial.aeval_X, Polynomial.coe_evalRingHom,
                Polynomial.eval_X]
              rw [hθ, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul,
                IsScalarTower.coe_toAlgHom']
              exact IntermediateField.AdjoinSimple.algebraMap_gen K α
          exact congrArg (fun f => f P) this
        obtain ⟨P, hP⟩ := pb'.exists_eq_aeval' s
        rw [hgen'] at hP
        rw [hP] at hs ⊢
        rw [hev]
        have hδ' : α ⊗ₜ[K] (1 : M) - (1 : L) ⊗ₜ[K] gen =
            Polynomial.aeval θ (Polynomial.C α - Polynomial.X) := by
          rw [map_sub, Polynomial.aeval_C, Polynomial.aeval_X,
            Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
        rw [hδ', ← map_mul] at hs
        have hdvd : FL ∣ (Polynomial.X - Polynomial.C α) * P := by
          rw [← hmin]
          have := minpoly.dvd L θ hs
          have e : (Polynomial.X - Polynomial.C α) * P =
              -((Polynomial.C α - Polynomial.X) * P) := by ring
          rw [e]
          exact (dvd_neg).mpr this
        have hFα : FL.eval α = 0 := by
          rw [hFL, Polynomial.eval_map_algebraMap, minpoly.aeval]
        have hFd : Polynomial.derivative FL = 0 := by
          rw [hFL, Polynomial.derivative_map, hd, Polynomial.map_zero]
        set G := FL /ₘ (Polynomial.X - Polynomial.C α)
        have hG : (Polynomial.X - Polynomial.C α) * G = FL :=
          Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hFα
        have hGα : G.eval α = 0 := by
          have := congrArg Polynomial.derivative hG
          rw [hFd, Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X,
            Polynomial.derivative_C, sub_zero, one_mul] at this
          have h2 := congrArg (Polynomial.eval α) this
          simpa using h2
        rw [← hG] at hdvd
        obtain ⟨H, hH⟩ := (mul_dvd_mul_iff_left (Polynomial.X_sub_C_ne_zero α)).mp hdvd
        rw [hH, Polynomial.eval_mul, hGα, zero_mul]
      rw [Algebra.isSeparable_def]
      intro α
      have hint : IsIntegral K α := (Algebra.IsAlgebraic.isAlgebraic α).isIntegral
      show (minpoly K α).Separable
      rw [Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hint)]
      intro hd
      obtain ⟨a, ha, hμ⟩ := s1 α
      obtain ⟨s, hs, hμs⟩ := s2 α a ha hμ
      exact hμs (s34 α hint hd s hs)
  classical

  have s3 : ∀ (H R : Type u) [CommRing R]
      (ε : H → (R →+* K)) (_ : ∀ r : R, (Set.range fun h => ε h r).Finite),
      ∃ (S : Type u) (_ : TopologicalSpace S) (_ : CompactSpace S) (_ : T2Space S)
        (_ : TotallyDisconnectedSpace S) (_ : ExtremallyDisconnected S)
        (Θ : R →+* LocallyConstant S K) (ι : H → S),
        (∀ (r : R) (h : H), Θ r (ι h) = ε h r) ∧
        ∀ f₁ f₂ : LocallyConstant S K, (∀ h : H, f₁ (ι h) = f₂ (ι h)) → f₁ = f₂ := by
    intro H R _ ε hfin
    letI : TopologicalSpace H := ⊥
    haveI : DiscreteTopology H := ⟨rfl⟩
    haveI hED : ExtremallyDisconnected (StoneCech H) :=
      CompactT2.Projective.extremallyDisconnected StoneCech.projective
    have huniq : ∀ f₁ f₂ : LocallyConstant (StoneCech H) K,
        (∀ h : H, f₁ (stoneCechUnit h) = f₂ (stoneCechUnit h)) → f₁ = f₂ := by
      intro f₁ f₂ hf
      letI : TopologicalSpace K := ⊥
      haveI : DiscreteTopology K := ⟨rfl⟩
      ext x
      have := denseRange_stoneCechUnit.equalizer f₁.continuous f₂.continuous (funext hf)
      exact congrFun this x
    have hθ : ∀ r : R, ∃ f : LocallyConstant (StoneCech H) K,
        ∀ h, f (stoneCechUnit h) = ε h r := by
      intro r
      letI : TopologicalSpace (Set.range fun h => ε h r) := ⊥
      haveI : DiscreteTopology (Set.range fun h => ε h r) := ⟨rfl⟩
      haveI : Finite (Set.range fun h => ε h r) := (hfin r).to_subtype
      let g : H → (Set.range fun h => ε h r) := fun h => ⟨ε h r, h, rfl⟩
      have hg : Continuous g := continuous_of_discreteTopology
      refine ⟨⟨Subtype.val ∘ stoneCechExtend hg, ?_⟩, ?_⟩
      · exact ((IsLocallyConstant.iff_continuous _).mpr (continuous_stoneCechExtend hg)).comp _
      · intro h
        show (stoneCechExtend hg (stoneCechUnit h)).val = _
        have := congrFun (stoneCechExtend_extends hg) h
        rw [Function.comp_apply] at this
        rw [this]
    choose θ hθ using hθ
    let Θ : R →+* LocallyConstant (StoneCech H) K :=
      { toFun := θ
        map_one' := huniq _ _ (fun h => by simp [hθ])
        map_mul' := fun a b => huniq _ _ (fun h => by simp [hθ])
        map_zero' := huniq _ _ (fun h => by simp [hθ])
        map_add' := fun a b => huniq _ _ (fun h => by simp [hθ]) }
    exact ⟨StoneCech H, inferInstance, inferInstance, inferInstance, inferInstance, hED, Θ,
      stoneCechUnit, fun r h => hθ r h, huniq⟩

  have s2 : ∀ (R : Type u) [CommRing R] (ψ : K →+* R)
      (_ : ∀ x : R, ∃ t : R, x * x * t = x)
      (ε : PrimeSpectrum R → (R →+* K)) (_ : ∀ p, (ε p).comp ψ = RingHom.id K)
      (_ : ∀ p (r : R), r ∈ p.asIdeal ↔ ε p r = 0) (r : R),
      (Set.range fun p => ε p r).Finite := by
    intro R _ ψ hvnr ε hε1 hε2 r
    have hopen : ∀ a : R, IsOpen {p : PrimeSpectrum R | a ∈ p.asIdeal} := by
      intro a
      obtain ⟨t, ht⟩ := hvnr a
      have : {p : PrimeSpectrum R | a ∈ p.asIdeal} = PrimeSpectrum.basicOpen (1 - a * t) := by
        ext p
        rw [Set.mem_setOf_eq, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        constructor
        · intro ha h1
          apply p.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have e : (1 : R) = (1 - a * t) + a * t := by ring
          rw [e]
          exact p.asIdeal.add_mem h1 (p.asIdeal.mul_mem_right t ha)
        · intro h1
          have h0 : a * (1 - a * t) ∈ p.asIdeal := by
            have e : a * (1 - a * t) = 0 := by linear_combination -ht
            rw [e]; exact p.asIdeal.zero_mem
          exact (p.isPrime.mem_or_mem h0).resolve_right h1
      rw [this]; exact PrimeSpectrum.isOpen_basicOpen
    have hU : ∀ c : K, {p : PrimeSpectrum R | ε p r = c} = {p | r - ψ c ∈ p.asIdeal} := by
      intro c; ext p
      simp only [Set.mem_setOf_eq]
      rw [hε2, map_sub]
      have e : ε p (ψ c) = c := by
        have := RingHom.congr_fun (hε1 p) c
        simpa using this
      rw [e, sub_eq_zero]
    obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover
      (fun c : K => {p : PrimeSpectrum R | ε p r = c})
      (fun c => by rw [hU]; exact hopen _) (fun p _ => Set.mem_iUnion.mpr ⟨ε p r, rfl⟩)
    refine (T.finite_toSet).subset ?_
    rintro _ ⟨p, rfl⟩
    obtain ⟨c, hc⟩ := Set.mem_iUnion.mp (hT (Set.mem_univ p))
    obtain ⟨hcT, hpc⟩ := Set.mem_iUnion.mp hc
    have hpc' : ε p r = c := hpc
    show ε p r ∈ (T : Set K)
    rw [hpc']; exact hcT

  have s1 : ∀ (R : Type u) [CommRing R]
      (ψ : K →+* R) (_ : @Algebra.WeaklyEtale K R _ _ ψ.toAlgebra) (p : PrimeSpectrum R),
      ∃ ε : R →+* K, ε.comp ψ = RingHom.id K ∧ ∀ r : R, r ∈ p.asIdeal ↔ ε r = 0 := by
    intro R _ ψ hψ p
    letI : Algebra K R := ψ.toAlgebra
    have hvnr := wc_weaklyEtale_field_vnr K R hψ
      (fun M _ _ _ _ hM => wc_weaklyEtale_flat_transfer K R hψ M hM)
    have hPm : p.asIdeal.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨fun h => p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h), ?_⟩
      intro J x hPJ hxP hxJ
      obtain ⟨t, ht⟩ := hvnr x
      have h0 : x * (1 - x * t) ∈ p.asIdeal := by
        have e : x * (1 - x * t) = 0 := by linear_combination -ht
        rw [e]; exact p.asIdeal.zero_mem
      have h1 : 1 - x * t ∈ J := hPJ ((p.isPrime.mem_or_mem h0).resolve_left hxP)
      have e : (1 : R) = (1 - x * t) + x * t := by ring
      rw [e]; exact J.add_mem h1 (J.mul_mem_right t hxJ)
    have hsurj : Function.Surjective (algebraMap R p.asIdeal.ResidueField) := by
      have e : (algebraMap R p.asIdeal.ResidueField) =
          (algebraMap (R ⧸ p.asIdeal) p.asIdeal.ResidueField).comp (Ideal.Quotient.mk p.asIdeal) := by
        ext x; exact IsScalarTower.algebraMap_apply R (R ⧸ p.asIdeal) p.asIdeal.ResidueField x
      rw [e]
      exact (Ideal.bijective_algebraMap_quotient_residueField p.asIdeal).2.comp
        Ideal.Quotient.mk_surjective
    haveI hloc : IsLocalization p.asIdeal.primeCompl p.asIdeal.ResidueField := by
      rw [isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨y, hy⟩
        apply IsUnit.mk0
        intro h
        exact hy (Ideal.algebraMap_residueField_eq_zero.mp h)
      · intro z
        obtain ⟨x, hx⟩ := hsurj z
        exact ⟨⟨x, 1⟩, by simp [hx]⟩
      · intro x y hxy
        have ha : x - y ∈ p.asIdeal :=
          Ideal.algebraMap_residueField_eq_zero.mp (by rw [map_sub, hxy, sub_self])
        obtain ⟨t, ht⟩ := hvnr (x - y)
        refine ⟨⟨1 - (x - y) * t, ?_⟩, ?_⟩
        · intro hc
          apply p.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have e : (1 : R) = (1 - (x - y) * t) + (x - y) * t := by ring
          rw [e]; exact p.asIdeal.add_mem hc (p.asIdeal.mul_mem_right t ha)
        · show (1 - (x - y) * t) * x = (1 - (x - y) * t) * y
          linear_combination (-1 : R) * ht
    haveI : Algebra.WeaklyEtale R p.asIdeal.ResidueField :=
      wc_localization_weaklyEtale R p.asIdeal.ResidueField p.asIdeal.primeCompl
    haveI : Algebra.WeaklyEtale K R := hψ
    have hWE : Algebra.WeaklyEtale K p.asIdeal.ResidueField :=
      Algebra.WeaklyEtale.trans K R p.asIdeal.ResidueField
    have halg : Algebra.IsAlgebraic K p.asIdeal.ResidueField := by
      refine Algebra.IsAlgebraic.mk fun b => ?_
      obtain ⟨f, hf0, hf⟩ := wc_weaklyEtale_point_algebraic K p.asIdeal.ResidueField
        p.asIdeal.ResidueField hWE (RingHom.id _) b
      rw [RingHom.id_comp] at hf0 hf
      refine ⟨f, fun h => hf0 (by rw [h, Polynomial.map_zero]), ?_⟩
      rw [Polynomial.aeval_def]; exact hf
    haveI := halg
    haveI : Algebra.IsSeparable K p.asIdeal.ResidueField :=
      wc_mnt_weaklyEtale_field_isSeparable K p.asIdeal.ResidueField hWE halg
    have hbij : Function.Bijective (algebraMap K p.asIdeal.ResidueField) :=
      ⟨(algebraMap K p.asIdeal.ResidueField).injective,
        IsSepClosed.algebraMap_surjective K p.asIdeal.ResidueField⟩
    let e := RingEquiv.ofBijective (algebraMap K p.asIdeal.ResidueField) hbij
    refine ⟨e.symm.toRingHom.comp (algebraMap R p.asIdeal.ResidueField), ?_, ?_⟩
    · ext c
      simp only [RingHom.comp_apply, RingHom.id_apply]
      have h1 : algebraMap R p.asIdeal.ResidueField (ψ c) = algebraMap K p.asIdeal.ResidueField c :=
        (IsScalarTower.algebraMap_apply K R p.asIdeal.ResidueField c).symm
      rw [h1]
      exact e.symm_apply_apply c
    · intro r
      rw [RingHom.comp_apply, ← Ideal.algebraMap_residueField_eq_zero (I := p.asIdeal)]
      constructor
      · intro h; rw [h, map_zero]
      · intro h
        have h2 := congrArg e h
        simpa using h2

  obtain ⟨ψ, hψdef⟩ : ∃ ψ : K →+* Γ(W.left, ⊤),
      ψ = ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ W.hom.appTop).hom := ⟨_, rfl⟩
  have hA1 : W.left.isoSpec.inv ≫ W.hom = Spec.map (CommRingCat.ofHom ψ) := by
    have h := Scheme.isoSpec_inv_naturality (X := W.left) (Y := Spec (.of K)) W.hom
    rw [Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h
    rw [hψdef, CommRingCat.ofHom_hom]
    exact h.symm
  have hWE : @Algebra.WeaklyEtale K Γ(W.left, ⊤) _ _ ψ.toAlgebra := by
    have h1 : WeaklyEtale (W.left.isoSpec.inv ≫ W.hom) := by
      haveI : WeaklyEtale W.hom := W.prop
      infer_instance
    rw [hA1] at h1
    exact wc_lpkt_specMap_weaklyEtale_ring K Γ(W.left, ⊤) ψ h1

  letI : Algebra K Γ(W.left, ⊤) := ψ.toAlgebra
  have hvnr := wc_weaklyEtale_field_vnr K Γ(W.left, ⊤) hWE
    (fun M _ _ _ _ hM => wc_weaklyEtale_flat_transfer K _ hWE M hM)
  choose ε hε1 hε2 using fun p : PrimeSpectrum Γ(W.left, ⊤) => s1 Γ(W.left, ⊤) ψ hWE p
  have hfin := fun r => s2 Γ(W.left, ⊤) ψ hvnr ε hε1 hε2 r
  obtain ⟨S, τ, hc, ht2, htd, hed, Θ, ι, hΘ, huniq⟩ := s3 (PrimeSpectrum Γ(W.left, ⊤)) _ ε hfin
  have hΘψ : Θ.comp ψ = (LocallyConstant.constRingHom : K →+* LocallyConstant S K) := by
    ext c : 1
    apply huniq
    intro h
    have h1 := RingHom.congr_fun (hε1 h) c
    simp only [RingHom.comp_apply, RingHom.id_apply] at h1
    rw [RingHom.comp_apply, hΘ, h1]
    rfl
  refine ⟨S, τ, hc, ht2, htd, hed, Spec.map (CommRingCat.ofHom Θ) ≫ W.left.isoSpec.inv, ?_, ?_⟩
  · rw [Category.assoc, hA1, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hΘψ]
  · intro w
    obtain ⟨p, hp⟩ : ∃ p : PrimeSpectrum Γ(W.left, ⊤), p = W.left.isoSpec.hom w := ⟨_, rfl⟩
    let q : PrimeSpectrum (LocallyConstant S K) :=
      ⟨RingHom.ker (LocallyConstant.evalRingHom (ι p)), RingHom.ker_isPrime _⟩
    refine ⟨q, ?_⟩
    have hq : PrimeSpectrum.comap Θ q = p := by
      apply PrimeSpectrum.ext
      ext r
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      show Θ r ∈ RingHom.ker _ ↔ _
      rw [RingHom.mem_ker, LocallyConstant.evalRingHom_apply, hΘ, ← hε2]
    have h2 : (Spec.map (CommRingCat.ofHom Θ)) q = W.left.isoSpec.hom w := hq.trans hp
    have key : W.left.isoSpec.inv (W.left.isoSpec.hom w) = w := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    calc (Spec.map (CommRingCat.ofHom Θ) ≫ W.left.isoSpec.inv) q
        = W.left.isoSpec.inv (Spec.map (CommRingCat.ofHom Θ) q) := Scheme.Hom.comp_apply _ _ _
      _ = W.left.isoSpec.inv (W.left.isoSpec.hom w) := by rw [h2]
      _ = w := key

theorem wc_ppu_closed_fibre_lc_cover {X : Scheme.{u}} (x : X)
    [IsSepClosed (X.residueField x)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') [WeaklyEtale a']
    (U : (Spec (X.residueField x)).ProEt) :
    Sieve.generate (fun (T : (Spec (X.residueField x)).ProEt) (_ : T ⟶ U) =>
      ∃ (S : Type u) (_ : TopologicalSpace S) (_ : CompactSpace S) (_ : T2Space S)
        (_ : TotallyDisconnectedSpace S) (_ : ExtremallyDisconnected S)
        (_ : WeaklyEtale (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')),
        T = (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk
          (Spec.map (CommRingCat.ofHom
            (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')))
      ∈ Scheme.ProEt.topology (Spec (X.residueField x)) U :=
by
  classical

  have ha : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
    have hgeom : ∀ z, wcEtGeomPt X x z = x := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply x _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
        IsLocalRing.closedPoint B :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
    have h1 := congrArg
      (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'

  haveI hsub : Subsingleton ↥(Spec (X.residueField x)) := by
    have : Unique ↥(Spec (.of ↑(X.residueField x))) := inferInstance
    exact this.instSubsingleton
  have hk₀ : IsAffineHom (X.fromSpecResidueField x) := by
    rw [isAffineHom_iff]
    intro V _
    rcases ((X.fromSpecResidueField x ⁻¹ᵁ V : TopologicalSpace.Opens _) :
        Set ↥(Spec (X.residueField x))).eq_empty_or_nonempty with h | h
    · have e : X.fromSpecResidueField x ⁻¹ᵁ V = ⊥ :=
        TopologicalSpace.Opens.ext (by rw [h, TopologicalSpace.Opens.coe_bot])
      rw [e]
      exact isAffineOpen_bot _
    · have e : X.fromSpecResidueField x ⁻¹ᵁ V = ⊤ :=
        TopologicalSpace.Opens.ext (by rw [h.eq_univ, TopologicalSpace.Opens.coe_top])
      rw [e]
      exact isAffineOpen_top _

  refine wc_proet_sieve_of_affine_finite_covers _ U _ ?_
  intro W v hW
  haveI := hW

  obtain ⟨S, _, _, _, _, _, hW', hh₁, hh₂⟩ :=
    wc_ppu_sepClosed_proet_affine_lc_surj (X.residueField x) W

  haveI hcS : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B))) :=
    wc_ppu_lc_constRingHom_weaklyEtale B S
  haveI hcSa : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a') := inferInstance

  haveI hfst : IsAffineHom (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x)) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
        (X.fromSpecResidueField x)).flip hk₀
  haveI hPaff : IsAffine (Limits.pullback (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x)) :=
    isAffine_of_isAffineHom (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x))

  have keyR : ∀ (R : Type u) [CommRing R] (q : PrimeSpectrum (LocallyConstant S R)), ∃ s0 : S,
      ∀ (V : Set S) (hV : IsClopen V),
        s0 ∈ V ↔ LocallyConstant.charFn R hV ∉ q.asIdeal := by
    intro R _ q
    have I1 : LocallyConstant.charFn R (isClopen_univ (X := S)) = 1 := by
      ext y
      simp [LocallyConstant.coe_charFn]
    have I2 : LocallyConstant.charFn R (isClopen_empty (X := S)) = 0 := by
      ext y
      simp [LocallyConstant.coe_charFn]
    have I3 : ∀ (V V' : Set S) (hV : IsClopen V) (hV' : IsClopen V'),
        LocallyConstant.charFn R (hV.inter hV') =
          LocallyConstant.charFn R hV * LocallyConstant.charFn R hV' := by
      intro V V' hV hV'
      ext y
      simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_mul, Pi.mul_apply,
        Set.indicator_apply, Pi.one_apply, Set.mem_inter_iff]
      split_ifs <;> simp_all
    have I5 : ∀ (V : Set S) (hV : IsClopen V),
        LocallyConstant.charFn R hV + LocallyConstant.charFn R hV.compl = 1 := by
      intro V hV
      ext y
      simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_add, LocallyConstant.coe_one,
        Pi.add_apply, Pi.one_apply, Set.indicator_apply, Set.mem_compl_iff]
      split_ifs <;> simp_all
    have hP := q.isPrime
    have h1 : (1 : LocallyConstant S R) ∉ q.asIdeal :=
      (Ideal.ne_top_iff_one _).mp hP.ne_top
    let 𝒰 : Set (Set S) :=
      {V | ∃ hV : IsClopen V, LocallyConstant.charFn R hV ∉ q.asIdeal}
    have hne : (⋂₀ 𝒰).Nonempty := by
      have : Nonempty 𝒰 := ⟨⟨Set.univ, isClopen_univ, by rw [I1]; exact h1⟩⟩
      apply IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed
      · intro V hV V' hV'
        obtain ⟨hV1, hu⟩ := hV
        obtain ⟨hV2, hv⟩ := hV'
        refine ⟨V ∩ V', ⟨hV1.inter hV2, ?_⟩, Set.inter_subset_left, Set.inter_subset_right⟩
        rw [I3 V V' hV1 hV2]
        intro hm
        rcases hP.mem_or_mem hm with h | h
        · exact hu h
        · exact hv h
      · rintro V ⟨hV1, hu⟩
        rw [Set.nonempty_iff_ne_empty]
        rintro rfl
        apply hu
        have e : LocallyConstant.charFn R hV1 = 0 := I2
        rw [e]
        exact Ideal.zero_mem _
      · rintro V ⟨hV1, -⟩
        exact hV1.isClosed.isCompact
      · rintro V ⟨hV1, -⟩
        exact hV1.isClosed
    obtain ⟨s0, hs0⟩ := hne
    rw [Set.mem_sInter] at hs0
    refine ⟨s0, fun V hV => ⟨fun hsV hm => ?_, fun hn => hs0 V ⟨hV, hn⟩⟩⟩
    have hc : LocallyConstant.charFn R hV.compl ∉ q.asIdeal := by
      intro hc
      apply h1
      rw [← I5 V hV]
      exact Ideal.add_mem _ hm hc
    exact hs0 Vᶜ ⟨hV.compl, hc⟩ hsV
  choose πf hπ using keyR B
  have hπc : Continuous πf := by
    rw [isTopologicalBasis_isClopen.continuous_iff]
    intro s hs
    have e : πf ⁻¹' s =
        (PrimeSpectrum.basicOpen (LocallyConstant.charFn B hs) : Set _) := by
      ext q
      rw [Set.mem_preimage, hπ q s hs, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    rw [e]
    exact PrimeSpectrum.isOpen_basicOpen

  have c7 : ∀ q : PrimeSpectrum (LocallyConstant S (X.residueField x)), ∃ s : S,
      ∀ f : LocallyConstant S (X.residueField x), f ∈ q.asIdeal ↔ f s = 0 := by
    intro q
    obtain ⟨s0, hs0⟩ := keyR (X.residueField x) q
    refine ⟨s0, fun f => ⟨fun hf => ?_, fun hf => ?_⟩⟩
    · by_contra hne
      have hU : IsClopen {s' | f s' = f s0} := f.isLocallyConstant.isClopen_fiber _
      have hχ : LocallyConstant.charFn (X.residueField x) hU ∉ q.asIdeal := (hs0 _ hU).mp rfl
      apply hχ
      have heq : LocallyConstant.charFn (X.residueField x) hU =
          (LocallyConstant.charFn (X.residueField x) hU *
            LocallyConstant.const S (f s0)⁻¹) * f := by
        ext s'
        simp only [LocallyConstant.coe_mul, LocallyConstant.coe_charFn, LocallyConstant.coe_const,
          Pi.mul_apply, Function.const_apply, Set.indicator_apply, Set.mem_setOf_eq,
          Pi.one_apply]
        split_ifs with h
        · rw [h, one_mul, inv_mul_cancel₀ hne]
        · rw [zero_mul, zero_mul]
      rw [heq]
      exact Ideal.mul_mem_left _ _ hf
    · have hU : IsClopen {s' | f s' = 0} := f.isLocallyConstant.isClopen_fiber _
      have hχ : LocallyConstant.charFn (X.residueField x) hU ∉ q.asIdeal := (hs0 _ hU).mp hf
      have h0 : f * LocallyConstant.charFn (X.residueField x) hU = 0 := by
        ext s'
        simp only [LocallyConstant.coe_mul, LocallyConstant.coe_charFn, LocallyConstant.coe_zero,
          Pi.mul_apply, Pi.zero_apply, Set.indicator_apply, Set.mem_setOf_eq, Pi.one_apply]
        split_ifs with h
        · rw [h, zero_mul]
        · rw [mul_zero]
      have hm : f * LocallyConstant.charFn (X.residueField x) hU ∈ q.asIdeal := by
        rw [h0]
        exact Ideal.zero_mem _
      exact (q.isPrime.mem_or_mem hm).resolve_right hχ

  let πS : C(↥(Limits.pullback (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x)), S) :=
    ⟨fun t => πf (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x) t),
      hπc.comp (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
        (X.fromSpecResidueField x)).continuous⟩

  have hπS : ∀ s : S, ∃ t, πS t = s := by
    intro s
    let σ : PrimeSpectrum (LocallyConstant S B) :=
      PrimeSpectrum.comap (LocallyConstant.evalRingHom s) (IsLocalRing.closedPoint B)
    have hσcl : PrimeSpectrum.comap
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B) σ =
          IsLocalRing.closedPoint B := by
      apply PrimeSpectrum.ext
      ext b
      exact Iff.rfl
    have hc : (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)))
          (σ : ↥(Spec (.of (LocallyConstant S B)))) =
          IsLocalRing.closedPoint B := hσcl
    have hx1 : (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
          (σ : ↥(Spec (.of (LocallyConstant S B)))) =
        X.fromSpecResidueField x (IsLocalRing.closedPoint (X.residueField x)) :=
      (Scheme.Hom.comp_apply _ a' _).trans ((congrArg a' hc).trans
        (ha.trans (Scheme.fromSpecResidueField_apply x _).symm))
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (g := X.fromSpecResidueField x)
      (σ : ↥(Spec (.of (LocallyConstant S B)))) (IsLocalRing.closedPoint (X.residueField x)) hx1
    refine ⟨z, ?_⟩
    show πf (Limits.pullback.fst (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x) z) = s
    rw [hz1]
    by_contra hne
    obtain ⟨V, hV, hσV, hsV⟩ := exists_isClopen_of_totally_separated hne
    have hsV' : s ∉ V := hsV
    have h1 := (hπ σ V hV).mp hσV
    apply h1
    show (LocallyConstant.charFn B hV) s ∈ IsLocalRing.maximalIdeal B
    have h0 : (LocallyConstant.charFn B hV) s = 0 := by
      simp [LocallyConstant.coe_charFn, Set.indicator_apply, hsV']
    rw [h0]
    exact Ideal.zero_mem _

  obtain ⟨gS, hg₁, hg₂⟩ := wc_ppu_lc_spec_map_of_continuous (X.residueField x)
    (Limits.pullback (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x))
    (Limits.pullback.snd (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x)) S πS

  have hgS : Function.Surjective gS := by
    intro q
    obtain ⟨s, hs⟩ := c7 q
    obtain ⟨t, ht⟩ := hπS s
    refine ⟨t, PrimeSpectrum.ext (Ideal.ext fun f => ?_)⟩
    rw [hg₂ t f, ht, hs f]

  have heL : (gS ≫ hW') ≫ W.hom = Limits.pullback.snd (Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')
      (X.fromSpecResidueField x) := by
    rw [Category.assoc, hh₁, hg₁]
  let e : (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk
      (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')) ⟶ W :=
    MorphismProperty.Over.homMk (gS ≫ hW') heL trivial

  refine ⟨1, fun _ => (wcProEtBC (X.fromSpecResidueField x)).obj (Scheme.ProEt.mk
      (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')),
    fun _ => e, fun _ => hPaff, fun y => ⟨0, ?_⟩, fun _ => ?_⟩
  · obtain ⟨z, hz⟩ := hh₂ y
    obtain ⟨t, ht⟩ := hgS z
    refine ⟨t, ?_⟩
    show (gS ≫ hW') t = y
    rw [Scheme.Hom.comp_apply, ht, hz]
  · apply Sieve.le_generate
    exact ⟨S, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, rfl⟩

theorem wc_proet_point_pull_isZero_of_shens_sections {X : Scheme.{u}} (x : X)
    [IsSepClosed (X.residueField x)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') [WeaklyEtale a']
    (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (hM : ∀ (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
        [TotallyDisconnectedSpace S] [ExtremallyDisconnected S]
        [WeaklyEtale (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')]
        (s : M.val.obj (Opposite.op (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')))), s = 0)
    (Dk : wcHMPullData (X.fromSpecResidueField x) ℓ) (hDk : wcHMPullCanonical Dk) :
    Limits.IsZero (Dk.Φ.obj M) :=
by
  classical
  let N := Dk.Φ.obj M

  have hW : ∀ (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
      [TotallyDisconnectedSpace S] [ExtremallyDisconnected S]
      [WeaklyEtale (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a')]
      (t : N.val.obj (Opposite.op ((wcProEtBC (X.fromSpecResidueField x)).obj
        (Scheme.ProEt.mk (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : B →+* LocallyConstant S B)) ≫ a'))))), t = 0 := by
    intro S _ _ _ _ _ _ t
    have hu := wc_ppu_unit_bij_lc_thickening x ℓ B Λ' W'' φ' a' hsh Dk hDk M S
    obtain ⟨s, hs⟩ := hu.2 t
    rw [← hs, hM S s]
    exact map_zero _

  have hall : ∀ (U : (Spec (X.residueField x)).ProEt) (n : N.val.obj (Opposite.op U)),
      n = 0 := by
    intro U n
    let T0 : Sieve U :=
      { arrows := fun _ f => (N.val.map f.op).hom n = 0
        downward_closed := by
          intro Y Z f hf g
          have hf' : (N.val.map f.op).hom n = 0 := hf
          show (N.val.map (g ≫ f).op).hom n = 0
          rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hf',
            map_zero] }
    have hT0 : T0 ∈ Scheme.ProEt.topology (Spec (X.residueField x)) U := by
      refine GrothendieckTopology.superset_covering _ ?_
        (wc_ppu_closed_fibre_lc_cover x B Λ' W'' φ' a' hsh U)
      rw [Sieve.generate_le_iff]
      rintro T f ⟨S, _, _, _, _, _, _, rfl⟩
      exact hW S _
    refine N.isSheaf.isSeparated U T0 hT0 n (0 : N.val.obj (Opposite.op U)) ?_
    intro Y f hf
    have hf' : (N.val.map f.op).hom n = 0 := hf
    change (N.val.map f.op).hom n = (N.val.map f.op).hom 0
    rw [map_zero]
    exact hf'

  rw [Limits.IsZero.iff_id_eq_zero]
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro V
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro n
  have h1 := hall V.unop (((𝟙 N : N ⟶ N).val.app V).hom n)
  have h2 := hall V.unop (((0 : N ⟶ N).val.app V).hom n)
  exact h1.trans h2.symm

theorem wc_lc_shens_wcontr (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S]
    [ExtremallyDisconnected S] :
    IsAffine (Spec (.of (LocallyConstant S B))) ∧
    IsClosed {z : Spec (.of (LocallyConstant S B)) |
      IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))} ∧
    (∀ z : Spec (.of (LocallyConstant S B)), ∃! y : Spec (.of (LocallyConstant S B)),
      IsClosed ({y} : Set (Spec (.of (LocallyConstant S B)))) ∧ z ⤳ y) ∧
    ExtremallyDisconnected {z : Spec (.of (LocallyConstant S B)) |
      IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))} ∧
    (∀ z : Spec (.of (LocallyConstant S B)), IsClosed ({z} : Set (Spec (.of (LocallyConstant S B)))) →
      HenselianLocalRing ((Spec (.of (LocallyConstant S B))).presheaf.stalk z) ∧
      IsSepClosed ((Spec (.of (LocallyConstant S B))).residueField z)) :=
by
  classical
  set I : Ideal (LocallyConstant S B) :=
    Ideal.map (LocallyConstant.constRingHom : B →+* LocallyConstant S B)
      (IsLocalRing.maximalIdeal B) with hIdef
  set ρ : LocallyConstant S B →+* LocallyConstant S (IsLocalRing.ResidueField B) :=
    LocallyConstant.mapRingHom (IsLocalRing.residue B) with hρdef
  have hker : RingHom.ker ρ = I := by
    apply le_antisymm
    · intro f hf
      have hpt : ∀ s : S, f s ∈ IsLocalRing.maximalIdeal B := by
        intro s
        rw [RingHom.mem_ker] at hf
        have h1 := congrArg (fun g : LocallyConstant S (IsLocalRing.ResidueField B) => g s) hf
        simp only [hρdef, LocallyConstant.mapRingHom_apply_apply, LocallyConstant.coe_zero,
          Pi.zero_apply] at h1
        rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
        exact h1
      set Tf := (LocallyConstant.range_finite f).toFinset with hTf
      have hdecomp : f = ∑ b ∈ Tf, LocallyConstant.constRingHom b *
          LocallyConstant.map (fun y => if y = b then (1 : B) else 0) f := by
        ext s
        have hev : ∀ (T : Finset B) (g : B → LocallyConstant S B),
            (∑ b ∈ T, g b) s = ∑ b ∈ T, g b s := by
          intro T g
          induction T using Finset.induction_on with
          | empty => simp
          | insert a T' haT ih =>
            rw [Finset.sum_insert haT, Finset.sum_insert haT, LocallyConstant.coe_add,
              Pi.add_apply, ih]
        rw [hev]
        simp only [LocallyConstant.coe_mul,
          LocallyConstant.constRingHom_apply, LocallyConstant.coe_const, Pi.mul_apply,
          LocallyConstant.map_apply, Function.comp_apply, Function.const_apply]
        have hmem : f s ∈ Tf := by
          rw [hTf, Set.Finite.mem_toFinset]; exact Set.mem_range_self s
        rw [Finset.sum_eq_single_of_mem (f s) hmem]
        · simp
        · intro b _ hb
          rw [if_neg (Ne.symm hb), mul_zero]
      rw [hdecomp]
      apply Ideal.sum_mem
      intro b hb
      apply Ideal.mul_mem_right
      apply Ideal.mem_map_of_mem
      rw [hTf, Set.Finite.mem_toFinset] at hb
      obtain ⟨s, rfl⟩ := hb
      exact hpt s
    · rw [hIdef, Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker]
      ext s
      simp only [hρdef, LocallyConstant.mapRingHom_apply_apply,
        LocallyConstant.constRingHom_apply, LocallyConstant.coe_const, Function.const_apply,
        LocallyConstant.coe_zero, Pi.zero_apply]
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
      exact hr
  have hsurj : Function.Surjective ρ := by
    intro g
    refine ⟨LocallyConstant.map (Function.surjInv IsLocalRing.residue_surjective) g, ?_⟩
    ext s
    simp only [hρdef, LocallyConstant.mapRingHom_apply_apply, LocallyConstant.map_apply,
      Function.comp_apply]
    exact Function.surjInv_eq IsLocalRing.residue_surjective (g s)
  let ψ : (LocallyConstant S B ⧸ I) ≃+* LocallyConstant S (IsLocalRing.ResidueField B) :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  have hK8 := wc_hte_sepClosed_henselian_transport
  have hX := wc_ppu_lc_field_wcontr (IsLocalRing.ResidueField B) S
  let eSpec : Spec (.of (LocallyConstant S (IsLocalRing.ResidueField B))) ≅
      Spec (.of (LocallyConstant S B ⧸ I)) :=
    Scheme.Spec.mapIso ψ.toCommRingCatIso.op
  have hQ := wc_hte_wcontr_of_iso _ _ eSpec hK8 hX
  haveI : HenselianRing (LocallyConstant S B) I := wc_ppu_lc_henselian B S
  exact wc_hte_wcontr_of_henselian_quotient (LocallyConstant S B) I hK8 hQ

theorem wc_lc_closed_stalk_iso (B : Type u) [CommRing B] [IsLocalRing B]
    (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S] [TotallyDisconnectedSpace S]
    (z : Spec (.of (LocallyConstant S B)))
    (hz : IsClosed ({z} : Set (Spec (.of (LocallyConstant S B))))) :
    IsIso ((Spec (.of (LocallyConstant S B))).fromSpecStalk z ≫
      Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom : B →+* LocallyConstant S B))) :=
by
  classical

  have s1 : ∀ (m : Ideal (LocallyConstant S B)), m.IsMaximal → ∃ s : S,
      ∀ f : LocallyConstant S B, f ∈ m ↔ f s ∈ IsLocalRing.maximalIdeal B := by
    intro m hm
    let Z : LocallyConstant S B → Set S :=
      fun f => f ⁻¹' (IsLocalRing.maximalIdeal B : Set B)
    have hZc : ∀ f : LocallyConstant S B, IsClopen (Z f) := by
      intro f
      refine ⟨?_, f.isLocallyConstant _⟩
      rw [← isOpen_compl_iff]
      show IsOpen ((f : S → B) ⁻¹' (IsLocalRing.maximalIdeal B : Set B))ᶜ
      rw [← Set.preimage_compl]
      exact f.isLocallyConstant _
    have hZne : ∀ f ∈ m, (Z f).Nonempty := by
      intro f hf
      by_contra h
      rw [Set.not_nonempty_iff_eq_empty] at h
      have hu : ∀ t, IsUnit (f t) := by
        intro t
        refine IsLocalRing.notMem_maximalIdeal.mp (fun hmem => ?_)
        have ht : t ∈ Z f := hmem
        rw [h] at ht
        exact ht
      have hfg : f * LocallyConstant.map Ring.inverse f = 1 := by
        ext t
        simp only [LocallyConstant.coe_mul, LocallyConstant.map_apply, Pi.mul_apply,
          Function.comp_apply, LocallyConstant.coe_one, Pi.one_apply]
        exact Ring.mul_inverse_cancel _ (hu t)
      have hfu : IsUnit f := ⟨⟨f, _, hfg, by rw [mul_comm]; exact hfg⟩, rfl⟩
      exact hm.ne_top (Ideal.eq_top_of_isUnit_mem _ hf hfu)
    have hdir : Directed (fun x1 x2 => x1 ⊇ x2) (fun i : m => Z i.1) := by
      intro f g
      let hsum : LocallyConstant S B := f.1 + LocallyConstant.charFn B (hZc f.1) * g.1
      have hh : hsum ∈ m := m.add_mem f.2 (m.mul_mem_left _ g.2)
      refine ⟨⟨hsum, hh⟩, ?_, ?_⟩
      · intro t ht
        change hsum t ∈ IsLocalRing.maximalIdeal B at ht
        change f.1 t ∈ IsLocalRing.maximalIdeal B
        by_contra hft
        have hft' : t ∉ Z f.1 := hft
        simp only [hsum, LocallyConstant.coe_add, LocallyConstant.coe_mul, Pi.add_apply,
          Pi.mul_apply, LocallyConstant.coe_charFn, Set.indicator_of_notMem hft', zero_mul,
          add_zero] at ht
        exact hft ht
      · intro t ht
        change hsum t ∈ IsLocalRing.maximalIdeal B at ht
        change g.1 t ∈ IsLocalRing.maximalIdeal B
        by_cases hft : t ∈ Z f.1
        · have e : hsum t = f.1 t + g.1 t := by
            simp only [hsum, LocallyConstant.coe_add, LocallyConstant.coe_mul, Pi.add_apply,
              Pi.mul_apply, LocallyConstant.coe_charFn, Set.indicator_of_mem hft, Pi.one_apply,
              one_mul]
          have e2 : g.1 t = hsum t - f.1 t := by rw [e]; ring
          rw [e2]
          exact Ideal.sub_mem _ ht hft
        · exfalso
          simp only [hsum, LocallyConstant.coe_add, LocallyConstant.coe_mul, Pi.add_apply,
            Pi.mul_apply, LocallyConstant.coe_charFn, Set.indicator_of_notMem hft, zero_mul,
            add_zero] at ht
          exact hft ht
    haveI : Nonempty m := ⟨⟨0, m.zero_mem⟩⟩
    obtain ⟨s, hs⟩ := IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed
      (fun i : m => Z i.1) hdir (fun i => hZne i.1 i.2)
      (fun i => (hZc i.1).isClosed.isCompact) (fun i => (hZc i.1).isClosed)
    rw [Set.mem_iInter] at hs
    refine ⟨s, fun f => ⟨fun hf => hs ⟨f, hf⟩, fun hfs => ?_⟩⟩
    by_contra hf
    obtain ⟨y, i, hi, hyi⟩ := hm.exists_inv hf
    have e := congrArg (fun g : LocallyConstant S B => g s) hyi
    simp only [LocallyConstant.coe_add, LocallyConstant.coe_mul, Pi.add_apply, Pi.mul_apply,
      LocallyConstant.coe_one, Pi.one_apply] at e
    have h1 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
      rw [← e]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hfs) (hs ⟨i, hi⟩)
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have s2 : ∀ (s : S) (m : Ideal (LocallyConstant S B)) [m.IsPrime],
      (∀ f : LocallyConstant S B, f ∈ m ↔ f s ∈ IsLocalRing.maximalIdeal B) →
      ∀ (A : Type u) [CommRing A] [Algebra (LocallyConstant S B) A]
        [IsLocalization.AtPrime A m],
      Function.Bijective
        (fun b : B => algebraMap (LocallyConstant S B) A (LocallyConstant.const S b)) := by
    intro s m _ hm A _ _ _
    have star : ∀ u : LocallyConstant S B, u ∈ m.primeCompl ↔ IsUnit (u s) := by
      intro u
      rw [Ideal.mem_primeCompl_iff, hm]
      exact IsLocalRing.notMem_maximalIdeal
    let ψ : B →+* A := (algebraMap (LocallyConstant S B) A).comp LocallyConstant.constRingHom
    have hψ : ∀ b, ψ b = algebraMap (LocallyConstant S B) A (LocallyConstant.const S b) :=
      fun b => rfl
    have key : ∀ f : LocallyConstant S B,
        algebraMap (LocallyConstant S B) A f = ψ (f s) := by
      intro f
      rw [hψ]
      have hU := IsLocallyConstant.isClopen_fiber f.isLocallyConstant (f s)
      let e := LocallyConstant.charFn B hU
      have hes : e s = 1 := by
        simp only [e, LocallyConstant.coe_charFn]
        exact Set.indicator_of_mem (show s ∈ {x | f x = f s} from rfl) _
      have he : e ∈ m.primeCompl := by
        rw [star, hes]
        exact isUnit_one
      rw [IsLocalization.eq_iff_exists m.primeCompl]
      refine ⟨⟨e, he⟩, ?_⟩
      show e * f = e * LocallyConstant.const S (f s)
      ext t
      simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.coe_const,
        Function.const_apply, e, LocallyConstant.coe_charFn]
      simp only [Set.indicator_apply, LocallyConstant.toFun_eq_coe]
      split_ifs with ht
      · rw [ht]
      · simp
    constructor
    · intro b b' hbb
      obtain ⟨⟨c, hc⟩, hcb⟩ := (IsLocalization.eq_iff_exists m.primeCompl A).mp hbb
      have e := congrArg (fun g : LocallyConstant S B => g s) hcb
      simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.coe_const,
        Function.const_apply] at e
      exact ((star c).mp hc).mul_left_cancel e
    · intro a
      obtain ⟨⟨x, ⟨y, hy⟩⟩, hxy⟩ := IsLocalization.surj m.primeCompl a
      have hxy' : a * algebraMap (LocallyConstant S B) A y =
          algebraMap (LocallyConstant S B) A x := hxy
      have hys := (star y).mp hy
      refine ⟨x s * ↑(hys.unit⁻¹), ?_⟩
      have hunit : IsUnit (algebraMap (LocallyConstant S B) A y) :=
        IsLocalization.map_units A (⟨y, hy⟩ : m.primeCompl)
      apply hunit.mul_right_cancel
      show ψ (x s * ↑(hys.unit⁻¹)) * algebraMap (LocallyConstant S B) A y =
        a * algebraMap (LocallyConstant S B) A y
      rw [hxy', key x, key y, ← map_mul, mul_assoc, IsUnit.val_inv_mul, mul_one]

  have hmax : z.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal z).mp hz
  obtain ⟨s, hs⟩ := s1 z.asIdeal hmax
  have s3 : (Spec (.of (LocallyConstant S B))).fromSpecStalk z =
      Spec.map ((Scheme.ΓSpecIso (.of (LocallyConstant S B))).inv ≫
        (Spec (.of (LocallyConstant S B))).presheaf.germ ⊤ z trivial) := by
    rw [Spec.map_comp, ← Scheme.isoSpec_Spec_inv, ← Scheme.fromSpecStalk_toSpecΓ_assoc,
      Scheme.toSpecΓ_isoSpec_inv, Category.comp_id]
  rw [s3, ← Spec.map_comp, isIso_SpecMap_iff]
  let z' : PrimeSpectrum (LocallyConstant S B) := z
  letI := StructureSheaf.stalkAlgebra (LocallyConstant S B) z'
  haveI := StructureSheaf.IsLocalization.to_stalk (LocallyConstant S B) z'
  haveI : z'.asIdeal.IsPrime := z'.isPrime
  obtain ⟨hi, hsurj⟩ := s2 s z'.asIdeal hs
    ((Spec.structureSheaf (LocallyConstant S B)).presheaf.stalk z')
  have hfun : ∀ b : B, (CommRingCat.Hom.hom (CommRingCat.ofHom
      (LocallyConstant.constRingHom : B →+* LocallyConstant S B) ≫
        (Scheme.ΓSpecIso (.of (LocallyConstant S B))).inv ≫
        (Spec (.of (LocallyConstant S B))).presheaf.germ ⊤ z trivial)) b =
      algebraMap (LocallyConstant S B)
        ((Spec.structureSheaf (LocallyConstant S B)).presheaf.stalk z')
        (LocallyConstant.const S b) := by
    intro b
    rw [StructureSheaf.stalkAlgebra_map, Scheme.ΓSpecIso_inv]
    rfl
  refine ⟨fun a b h => hi ((hfun a).symm.trans (h.trans (hfun b))), fun y => ?_⟩
  obtain ⟨b, hb⟩ := hsurj y
  exact ⟨b, (hfun b).trans hb⟩

theorem wc_pencil_odp_shens_milnor_fibre_top_card : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), Even n → 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ Nat.card F'' → ∀ (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left), wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x)) (Scheme.Etale.forget (Limits.pullback D.f a))) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a), wcHalShData x B Λ' W'' φ' a' → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) ℓ (n - 1)) = ℓ ∧ Subsingleton (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) ℓ (n - 1 + 1)) ∧ ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1)) = ℓ ^ k :=
by
  intro F' F'' _ _ _ _ Y n hn hn2 D ℓ hℓ hℓF i A _ _ _ Λ _ _ W' φ a hA x hx B _ _ _ Λ' _ _ W''
    φ' a' hB Ω _ _ ξ hξ
  classical
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero



  have htors : ∀ (Z : Scheme.{u}) (m q : ℕ) (y : wcEtZModExt Z m q), m • y = 0 := by
    intro Z m q y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have hsm : ∀ (c : ℕ) X (s : (SheafOfModules.unit (wcEtZModRing Z m)).val.obj X),
        ((c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m))).val.app X).hom s = c • s := by
      intro c X s
      induction c with
      | zero =>
        rw [zero_smul, zero_smul]
        have h00 : ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s =
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s +
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s := by
          conv_lhs => rw [← add_zero (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
            SheafOfModules.unit (wcEtZModRing Z m))]
          rw [SheafOfModules.add_val, PresheafOfModules.add_app]
          rfl
        exact add_left_cancel (h00.symm.trans (add_zero _).symm)
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app]
        rw [ModuleCat.hom_add, LinearMap.add_apply, ih]
        rfl
    obtain ⟨-, -, -, hm⟩ := wc_et_zmod_ring_locbij Z m
    have hmU : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      rw [hsm m X s, show (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
          SheafOfModules.unit (wcEtZModRing Z m)) =
          0 • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) from (zero_smul _ _).symm, hsm 0 X s,
        zero_smul, ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Z m).obj.obj X), hm X, zero_smul]
    have hcomp : ∀ c : ℕ, y.comp (Abelian.Ext.mk₀ (c • 𝟙 (SheafOfModules.unit
        (wcEtZModRing Z m)))) (add_zero q) = c • y := by
      intro c
      induction c with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id]
    rw [← hcomp m, hmU, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]



  have S6 : ∀ (Z : Scheme.{u}) (q : ℕ), Finite (wcEtCoh Z ℓ q) → Nat.card (wcEtCoh Z ℓ q) ≤ ℓ →
      (∃ ω : wcEtZModExt Z ℓ q, ω ≠ 0) → Nat.card (wcEtCoh Z ℓ q) = ℓ := by
    intro Z q hfin hcard hex
    obtain ⟨ω, hω⟩ := hex
    obtain ⟨EO⟩ := wc_et_zmodext_coh_equiv Z ℓ q
    haveI := hfin
    haveI : Finite (wcEtZModExt Z ℓ q) := Finite.of_equiv _ EO.symm
    have hG : Nat.card (wcEtZModExt Z ℓ q) ≤ ℓ := (Nat.card_congr EO).trans_le hcard
    have hord : addOrderOf ω = ℓ := addOrderOf_eq_prime (htors Z ℓ q ω) hω
    have hlow : ℓ ≤ Nat.card (wcEtZModExt Z ℓ q) := by
      have h1 : Nat.card (AddSubgroup.zmultiples ω) = ℓ := by rw [Nat.card_zmultiples, hord]
      have h2 := Nat.card_le_card_of_injective
        (Subtype.val : AddSubgroup.zmultiples ω → wcEtZModExt Z ℓ q) Subtype.val_injective
      exact (le_of_eq h1.symm).trans h2
    rw [← Nat.card_congr EO]
    exact le_antisymm hG hlow



  have S1 : ∀ (Z : Scheme.{u}) (N : ℕ), Nat.card (wcEtCoh Z ℓ N) = ℓ →
      Subsingleton (wcEtCoh Z ℓ (N + 1)) →
      ((N = 1 ∧ ∀ j : ℕ, Nat.card (wcEtCoh Z (ℓ ^ j) 0) = ℓ ^ j) ∨
        (2 ≤ N ∧ ∀ j : ℕ, 1 ≤ j → Subsingleton (wcEtCoh Z (ℓ ^ j) (N - 1)))) →
      ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Z (ℓ ^ k) N) = ℓ ^ k := by
    intro Z N h1 h2 hbr k hk
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hN1 : N - 1 + 1 = N := by rcases hbr with ⟨h, _⟩ | ⟨h, _⟩ <;> omega
    have hcard : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
        (α : A →+ B) (β : B →+ D), Function.Injective α → (∀ b, β b = 0 ↔ ∃ a, α a = b) →
        Nat.card B = Nat.card A * Nat.card β.range := by
      intro A B D _ _ _ α β hα hex
      have hker : β.ker = α.range := by
        ext b
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        exact hex b
      have e1 : Nat.card (B ⧸ β.ker) = Nat.card β.range :=
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange β).toEquiv
      have e2 : Nat.card β.ker = Nat.card A := by
        rw [hker]
        exact (Nat.card_congr (AddMonoidHom.ofInjective hα).toEquiv).symm
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker, e1, e2, mul_comm]

    have hsurj0 : ∀ (P : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})),
        S.ShortExact →
        Nat.card (Abelian.Ext P S.X₁ 0) ≠ 0 → Nat.card (Abelian.Ext P S.X₃ 0) ≠ 0 →
        Nat.card (Abelian.Ext P S.X₂ 0) =
          Nat.card (Abelian.Ext P S.X₁ 0) * Nat.card (Abelian.Ext P S.X₃ 0) →
        ∀ (d : ℕ), d = 0 → ∀ x₃ : Abelian.Ext P S.X₃ d,
          ∃ x₂ : Abelian.Ext P S.X₂ d, x₂.comp (Abelian.Ext.mk₀ S.g) (add_zero d) = x₃ := by
      intro P S hS hc1 hc3 hc2 d hd
      subst hd
      let α : Abelian.Ext P S.X₁ 0 →+ Abelian.Ext P S.X₂ 0 :=
        (Abelian.Ext.mk₀ S.f).postcomp P (add_zero 0)
      let β : Abelian.Ext P S.X₂ 0 →+ Abelian.Ext P S.X₃ 0 :=
        (Abelian.Ext.mk₀ S.g).postcomp P (add_zero 0)
      have hα : ∀ (x : Abelian.Ext P S.X₁ 0),
          α x = x.comp (Abelian.Ext.mk₀ S.f) (add_zero 0) := by
        intro x
        simp only [α, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
          Abelian.Ext.bilinearComp_apply_apply]
      have hβ : ∀ (x : Abelian.Ext P S.X₂ 0),
          β x = x.comp (Abelian.Ext.mk₀ S.g) (add_zero 0) := by
        intro x
        simp only [β, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
          Abelian.Ext.bilinearComp_apply_apply]
      have hex : ∀ b, β b = 0 ↔ ∃ a, α a = b := by
        intro b
        rw [hβ]
        constructor
        · intro hb
          obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS b hb
          exact ⟨a, by rw [hα]; exact ha⟩
        · rintro ⟨a, rfl⟩
          rw [hα, Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ S.f) (Abelian.Ext.mk₀ S.g) (add_zero 0)
            (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero,
            Abelian.Ext.comp_zero]
      have hinj0 : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective P S.X₁).2 x
        rw [hα, Abelian.Ext.mk₀_comp_mk₀] at hx
        have hf : h ≫ S.f = 0 :=
          (Abelian.Ext.mk₀_bijective P S.X₂).1 (by rw [hx, Abelian.Ext.mk₀_zero])
        have := hS.mono_f
        have h0 : h = 0 := by
          rw [← cancel_mono S.f, Limits.zero_comp]
          exact hf
        rw [h0, Abelian.Ext.mk₀_zero]
      have hs : Function.Surjective β := by
        have h := hcard α β hinj0 hex
        rw [hc2] at h
        have hr : Nat.card β.range = Nat.card (Abelian.Ext P S.X₃ 0) :=
          (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hc1) h).symm
        have : Finite (Abelian.Ext P S.X₃ 0) := Nat.finite_of_card_ne_zero hc3
        exact AddMonoidHom.range_eq_top.mp (AddSubgroup.eq_top_of_card_eq _ hr)
      intro x₃
      obtain ⟨x₂, hx₂⟩ := hs x₃
      exact ⟨x₂, by rw [← hβ]; exact hx₂⟩

    have habsN : ∀ (P : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})),
        S.ShortExact → Subsingleton (Abelian.Ext P S.X₁ (N + 1)) →
        (∀ z : Abelian.Ext P S.X₁ N, z.comp (Abelian.Ext.mk₀ S.f) (add_zero N) = 0 → z = 0) →
        Nat.card (Abelian.Ext P S.X₂ N) =
          Nat.card (Abelian.Ext P S.X₁ N) * Nat.card (Abelian.Ext P S.X₃ N) := by
      intro P S hS hsub hinj
      let α : Abelian.Ext P S.X₁ N →+ Abelian.Ext P S.X₂ N :=
        (Abelian.Ext.mk₀ S.f).postcomp P (add_zero N)
      let β : Abelian.Ext P S.X₂ N →+ Abelian.Ext P S.X₃ N :=
        (Abelian.Ext.mk₀ S.g).postcomp P (add_zero N)
      have hα : ∀ (x : Abelian.Ext P S.X₁ N),
          α x = x.comp (Abelian.Ext.mk₀ S.f) (add_zero N) := by
        intro x
        simp only [α, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
          Abelian.Ext.bilinearComp_apply_apply]
      have hβ : ∀ (x : Abelian.Ext P S.X₂ N),
          β x = x.comp (Abelian.Ext.mk₀ S.g) (add_zero N) := by
        intro x
        simp only [β, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
          Abelian.Ext.bilinearComp_apply_apply]
      have hex : ∀ b, β b = 0 ↔ ∃ a, α a = b := by
        intro b
        rw [hβ]
        constructor
        · intro hb
          obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS b hb
          exact ⟨a, by rw [hα]; exact ha⟩
        · rintro ⟨a, rfl⟩
          rw [hα, Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ S.f) (Abelian.Ext.mk₀ S.g) (add_zero N)
            (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero,
            Abelian.Ext.comp_zero]
      have hinjN : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        rw [hα] at hz
        exact hinj z hz
      have hsurjN : Function.Surjective β := by
        intro x₃
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x₃ (rfl : N + 1 = N + 1)
