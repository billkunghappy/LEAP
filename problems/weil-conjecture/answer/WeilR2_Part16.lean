  refine ⟨Z, p₁, p₂, πZ, h21, hπZ, hπZfin, hπZet, hπZsurj, hZconn, ?_⟩
  intro x t
  have e2 := hβpt Z (𝟙 Z) x t
  refine (hcg Z p₂ (𝟙 Z ≫ p₂) (Category.id_comp p₂).symm x t).trans (e2.trans ?_)
  rw [hgh]
  exact congrArg h (hcg Z (𝟙 Z ≫ p₁) p₁ (Category.id_comp p₁) x t)

theorem wc_qcfin_slice_supp_vanish (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          S i (IsLocalRing.closedPoint F''))
    (K : Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1})
    (hK : ∀ (V' : Over (wcGeomPoint F'' (wcP1Over F'') hP)), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      ∀ s : K.obj.obj (Opposite.op V'), s = 0)
    (j : ℕ) (hj : 1 ≤ j) :
    letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ x : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
        (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))) ⋙ uliftFunctor.{u+1, u} ⋙
          AddCommGrpCat.free)) K j,
      x = 0 :=
by
  classical

  have htrans : ∀ (S0 : Scheme.{u}) (U : S0.ProEt)
      (K : Sheaf ((Scheme.ProEt.topology S0).over U) AddCommGrpCat.{u+1}) (n : ℕ),
      ∃ K' : Sheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1},
        (∀ W : U.left.ProEt, (∀ s : K.obj.obj (Opposite.op ((wcSliceToOver S0 U).obj W)), s = 0) →
          ∀ s : K'.obj.obj (Opposite.op W), s = 0) ∧
        ((∀ y : Abelian.Ext (wcFreeSheaf U.left ((wcOverToSlice S0 U).obj (Over.mk (𝟙 U)))) K' n,
            y = 0) →
          letI : HasExt (Sheaf ((Scheme.ProEt.topology S0).over U) AddCommGrpCat.{u+1}) :=
            HasExt.standard _
          ∀ x : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S0).over U)
              AddCommGrpCat.{u+1}).obj
            (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) K n,
            x = 0) := by
    intro S0 U K n
    have hcont := wc_slice_over_sites_cont S0 U
    let εapp : ∀ V : Over U, (wcOverToSlice S0 U ⋙ wcSliceToOver S0 U).obj V ≅ V := fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
    let ε : wcOverToSlice S0 U ⋙ wcSliceToOver S0 U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents εapp (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
    let eqv : U.left.ProEt ≌ Over U :=
      Equivalence.mk' (wcSliceToOver S0 U) (wcOverToSlice S0 U) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
    haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S0).over U) := hcont.2.2.1
    haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S0).over U)
        (Scheme.ProEt.topology U.left) := hcont.2.2.2
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S0).over U) eqv
    let E := eqv.sheafCongr (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S0).over U)
      AddCommGrpCat.{u+1}
    refine ⟨E.inverse.obj K, fun W h s => h s, fun hb => ?_⟩
    letI : HasExt (Sheaf ((Scheme.ProEt.topology S0).over U) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    intro x
    let adj := E.toAdjunction
    haveI : E.functor.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : E.inverse.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint _
    haveI : E.functor.Additive := Functor.additive_of_preserves_binary_products _
    haveI : E.inverse.Additive := Functor.additive_of_preserves_binary_products _
    have rep : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : C),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      intro C _ J' _ Y
      exact
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    let U₀ : U.left.ProEt := (wcOverToSlice S0 U).obj (Over.mk (𝟙 U))
    have r1 := rep (Scheme.ProEt.topology U.left) U₀
    have r2 := rep ((Scheme.ProEt.topology S0).over U) (eqv.functor.obj U₀)
    let r3 : (sheafToPresheaf ((Scheme.ProEt.topology S0).over U) AddCommGrpCat.{u+1} ⋙
        (evaluation (Over U)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op (eqv.functor.obj U₀)) ⋙
        forget AddCommGrpCat.{u+1}).CorepresentableBy (E.functor.obj (wcFreeSheaf U.left U₀)) :=
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          first
            | (erw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]; rfl)
            | (simp only [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]; rfl)
            | (rw [Adjunction.homEquiv_naturality_right adj, r1.homEquiv_comp]; rfl)
            | (rw [show adj.homEquiv _ G' (g ≫ f) = adj.homEquiv _ G g ≫ E.inverse.map f from
                  Adjunction.homEquiv_naturality_right adj g f, r1.homEquiv_comp]; rfl) }
    let θ : E.functor.obj (wcFreeSheaf U.left U₀) ≅
        (presheafToSheaf ((Scheme.ProEt.topology S0).over U) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
      r3.uniqueUpToIso r2 ≪≫ (presheafToSheaf ((Scheme.ProEt.topology S0).over U)
        AddCommGrpCat.{u+1}).mapIso
        (Functor.isoWhiskerRight (yoneda.mapIso (ε.app (Over.mk (𝟙 U))))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    have hx1 : (Abelian.Ext.mk₀ θ.hom).comp x (zero_add n) = 0 := by
      apply (adj.extEquiv (X := wcFreeSheaf U.left U₀) (Y := K) (n := n)).injective
      rw [map_zero]
      exact hb _
    calc x = (Abelian.Ext.mk₀ (θ.inv ≫ θ.hom)).comp x (zero_add n) := by
          rw [Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = (Abelian.Ext.mk₀ θ.inv).comp ((Abelian.Ext.mk₀ θ.hom).comp x (zero_add n))
            (zero_add n) := (Abelian.Ext.mk₀_comp_mk₀_assoc _ _ _).symm
      _ = 0 := by rw [hx1, Abelian.Ext.comp_zero]

  have hgen : ∀ (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] [IsLocallyNoetherian Y]
      (K' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (z : Fin m → Y),
      (∀ i, IsClosed ({z i} : Set Y)) →
      (∀ V : Y.ProEt, (∀ (v : V.left) (i : Fin m), V.hom v ≠ z i) →
        ∀ (n : ℕ) (y : Abelian.Ext (wcFreeSheaf Y V) K' n), y = 0) →
      (∀ i0 : Fin m, ∃ (V₀ : Y.ProEt) (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A)
        (_ : IsSepClosed (IsLocalRing.ResidueField A)) (e : V₀.left ≅ Spec (.of A)),
        V₀.hom (e.inv (IsLocalRing.closedPoint A)) = z i0 ∧
        IsIso (Limits.pullback.snd V₀.hom (Y.fromSpecResidueField (z i0)))) →
      ∀ y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) K' j, y = 0 := by
    intro Y _ hqsY hlnY K' z hzc hvan hstrict
    let U₀ : Y.ProEt := Scheme.ProEt.mk (𝟙 Y)
    have hU₀hom : U₀.hom = 𝟙 Y := rfl
    haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
    have hU₀ : ∀ p : Y, U₀.hom p = p := fun p => rfl
    let O : Fin m → Y.Opens := fun i => ⟨{z i}ᶜ, (hzc i).isOpen_compl⟩
    have hrange : ∀ (O' : Y.Opens) (T : Y.ProEt),
        Set.range (wcOpenRestrIncl Y O' T).left = T.hom ⁻¹' (O' : Set Y) := by
      intro O' T
      show Set.range (Limits.pullback.snd O'.ι T.hom) = _
      rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    have hT'O : ∀ (O' : Y.Opens) (T : Y.ProEt) (t' : (wcOpenRestr Y O' T).left),
        (wcOpenRestr Y O' T).hom t' ∈ (O' : Set Y) := by
      intro O' T t'
      have key : ∀ p : ↥(Limits.pullback O'.ι T.hom),
          (Limits.pullback.snd O'.ι T.hom ≫ T.hom) p ∈ (O' : Set Y) := by
        intro p
        rw [← Limits.pullback.condition, Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι O']
        exact Set.mem_range_self _
      exact key t'

    have hexc : ∀ (O' : Y.Opens) (x0 : Y), (O' : Set Y) = {x0}ᶜ → ∀ T : Y.ProEt,
        IsIso (Limits.pullback.snd T.hom (Y.fromSpecResidueField x0)) → CompactSpace T.left →
        ∃ κ : Limits.cokernel (wcFreeSheafMap Y (wcOpenRestrIncl Y O' T)) ⟶
          Limits.cokernel (wcFreeSheafMap Y (wcOpenRestrIncl Y O' U₀)), IsIso κ := by
      intro O' x0 hO' T hfib hTc
      have hcond : Limits.pullback.fst O'.ι T.hom ≫ O'.ι =
          (Limits.pullback.snd O'.ι T.hom ≫ T.hom) ≫ U₀.hom := by
        rw [Limits.pullback.condition]
        exact (Category.comp_id _).symm
      have hover : Limits.pullback.lift (Limits.pullback.fst O'.ι T.hom)
          (Limits.pullback.snd O'.ι T.hom ≫ T.hom) hcond ≫ (wcOpenRestr Y O' U₀).hom =
          (wcOpenRestr Y O' T).hom := by
        show _ ≫ (Limits.pullback.snd O'.ι U₀.hom ≫ U₀.hom) =
          Limits.pullback.snd O'.ι T.hom ≫ T.hom
        exact (Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ U₀.hom) (Limits.pullback.lift_snd _ _ hcond)).trans
            (Category.comp_id _))
      let gV : wcOpenRestr Y O' T ⟶ wcOpenRestr Y O' U₀ :=
        MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hcond) hover trivial
      have hTg : T.hom ≫ U₀.hom = T.hom := Category.comp_id _
      let g : T ⟶ U₀ := MorphismProperty.Over.homMk T.hom hTg trivial
      have hgV : gV ≫ wcOpenRestrIncl Y O' U₀ = wcOpenRestrIncl Y O' T ≫ g := by
        apply MorphismProperty.Over.Hom.ext
        show Limits.pullback.lift _ _ hcond ≫ Limits.pullback.snd O'.ι U₀.hom =
          Limits.pullback.snd O'.ι T.hom ≫ T.hom
        exact Limits.pullback.lift_snd _ _ _
      have hι : IsOpenImmersion (wcOpenRestrIncl Y O' U₀).left := by
        show IsOpenImmersion (Limits.pullback.snd O'.ι U₀.hom)
        infer_instance
      have hj' : IsOpenImmersion (wcOpenRestrIncl Y O' T).left := by
        show IsOpenImmersion (Limits.pullback.snd O'.ι T.hom)
        infer_instance
      have hr : Set.range (wcOpenRestrIncl Y O' U₀).left = {x0}ᶜ := by
        rw [hrange]
        ext p
        show U₀.hom p ∈ (O' : Set Y) ↔ _
        rw [hO']
        exact Iff.rfl
      have hrj : Set.range (wcOpenRestrIncl Y O' T).left = g.left ⁻¹' {x0}ᶜ := by
        rw [hrange, hO']
        rfl
      obtain ⟨κ, hκ, -⟩ := wc_lfi_point_excision Y U₀ (wcOpenRestr Y O' U₀) T (wcOpenRestr Y O' T)
        (wcOpenRestrIncl Y O' U₀) hι x0 hr g (wcOpenRestrIncl Y O' T) hj' hrj gV hgV hfib hTc
        hqsY hlnY
      exact ⟨κ, hκ⟩

    have hcoker0 : ∀ (i0 : Fin m) (y : Abelian.Ext (Limits.cokernel
        (wcFreeSheafMap Y (wcOpenRestrIncl Y (O i0) U₀))) K' j), y = 0 := by
      intro i0 y
      obtain ⟨V₀, A, iA₁, iA₂, iA₃, e, hv', hfib0⟩ := hstrict i0
      haveI hproj : Projective (wcFreeSheaf Y V₀) := wc_proet_free_projective_strict_local Y V₀ A e
      obtain ⟨κ, hκ⟩ := hexc (O i0) (z i0) rfl V₀ hfib0 ((Scheme.homeoOfIso e.symm).compactSpace)
      haveI := hκ
      have hVT : ∀ (t : (wcOpenRestr Y (O i0) V₀).left) (i : Fin m),
          (wcOpenRestr Y (O i0) V₀).hom t ≠ z i := by
        intro t i h
        set p := Limits.pullback.snd (O i0).ι V₀.hom t with hp
        have h1 : (wcOpenRestr Y (O i0) V₀).hom t = V₀.hom p := by
          first
            | exact Scheme.Hom.comp_apply (Limits.pullback.snd (O i0).ι V₀.hom) V₀.hom t
            | rfl
        have h2 : V₀.hom p ∈ (O i0 : Set Y) := by rw [← h1]; exact hT'O (O i0) V₀ t
        have h3 : p ⤳ e.inv (IsLocalRing.closedPoint A) := by
          have := (IsLocalRing.specializes_closedPoint (e.hom p)).map e.inv.continuous
          rwa [Scheme.hom_inv_apply] at this
        have h4 : V₀.hom p ⤳ z i0 := by rw [← hv']; exact h3.map V₀.hom.continuous
        have h5 : z i0 ∈ closure {z i} := by
          rw [← h, h1]; exact specializes_iff_mem_closure.mp h4
        rw [(hzc i).closure_eq, Set.mem_singleton_iff] at h5
        have h6 : V₀.hom p = z i0 := by rw [← h1, h, ← h5]
        exact (Set.mem_compl_iff _ _).mp (show V₀.hom p ∈ ({z i0} : Set Y)ᶜ from h2)
          (Set.mem_singleton_iff.mpr h6)
      have hExtVT := hvan _ hVT
      have hmonoL : Mono (wcOpenRestrIncl Y (O i0) V₀).left := by
        change Mono (Limits.pullback.snd (O i0).ι V₀.hom)
        exact IsOpenImmersion.mono _
      have hmono := wc_free_sheaf_map_mono Y _ _ (wcOpenRestrIncl Y (O i0) V₀) hmonoL
      have hSE := ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel
        (wcFreeSheafMap Y (wcOpenRestrIncl Y (O i0) V₀))) hmono inferInstance
      obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      have hC0 : ∀ y' : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
          (wcOpenRestrIncl Y (O i0) V₀))) K' (j' + 1), y' = 0 := by
        intro y'
        have hz0 := Abelian.Ext.eq_zero_of_projective
          ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y
            (wcOpenRestrIncl Y (O i0) V₀)))).comp y' (zero_add (j' + 1)))
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hSE K' y' hz0
          (n₀ := j') (by omega)
        rw [← hx₁, hExtVT j' x₁, Abelian.Ext.comp_zero]
      calc y = (Abelian.Ext.mk₀ (𝟙 _)).comp y (zero_add (j' + 1)) :=
            (Abelian.Ext.mk₀_id_comp y).symm
        _ = (Abelian.Ext.mk₀ (inv κ ≫ κ)).comp y (zero_add (j' + 1)) := by
            rw [IsIso.inv_hom_id]
        _ = (Abelian.Ext.mk₀ (inv κ)).comp ((Abelian.Ext.mk₀ κ).comp y (zero_add (j' + 1)))
              (zero_add (j' + 1)) := (Abelian.Ext.mk₀_comp_mk₀_assoc _ _ _).symm
        _ = 0 := by
            rw [hC0 ((Abelian.Ext.mk₀ κ).comp y (zero_add (j' + 1))), Abelian.Ext.comp_zero]

    have hnotO : ∀ i, z i ∉ (O i : Set Y) := fun i h =>
      (Set.mem_compl_iff _ _).mp (show z i ∈ ({z i} : Set Y)ᶜ from h) (Set.mem_singleton _)
    let H : Y.ProEt → Finset (Fin m) := fun T =>
      Finset.univ.filter (fun i => ∃ t : T.left, T.hom t = z i)
    have hmemH : ∀ (T : Y.ProEt) (i : Fin m), i ∈ H T ↔ ∃ t : T.left, T.hom t = z i := by
      intro T i
      simp only [H, Finset.mem_filter, Finset.mem_univ, true_and]
    have hcardlt : ∀ (T : Y.ProEt) (i0 : Fin m) (t0 : T.left), T.hom t0 = z i0 →
        (H (wcOpenRestr Y (O i0) T)).card < (H T).card := by
      intro T i0 t0 ht0
      have hsub : H (wcOpenRestr Y (O i0) T) ⊆ H T := by
        intro i hi
        rw [hmemH] at hi ⊢
        obtain ⟨t', ht'⟩ := hi
        refine ⟨(wcOpenRestrIncl Y (O i0) T).left t', ?_⟩
        rw [← ht', ← MorphismProperty.Over.w (wcOpenRestrIncl Y (O i0) T), Scheme.Hom.comp_apply]
      have hi0 : i0 ∈ H T := (hmemH T i0).mpr ⟨t0, ht0⟩
      have hi0' : i0 ∉ H (wcOpenRestr Y (O i0) T) := by
        intro hi
        rw [hmemH] at hi
        obtain ⟨t', ht'⟩ := hi
        have h1 := hT'O (O i0) T t'
        rw [ht'] at h1
        exact hnotO i0 h1
      exact Finset.card_lt_card ((Finset.ssubset_iff_of_subset hsub).mpr ⟨i0, hi0, hi0'⟩)
    have hoi : ∀ (T : Y.ProEt), IsOpenImmersion T.hom → ∀ O' : Y.Opens,
        IsOpenImmersion (wcOpenRestr Y O' T).hom := by
      intro T hT O'
      haveI := hT
      show IsOpenImmersion (Limits.pullback.snd O'.ι T.hom ≫ T.hom)
      infer_instance
    have hstep : ∀ (T : Y.ProEt), IsOpenImmersion T.hom → ∀ (i0 : Fin m) (t0 : T.left),
        T.hom t0 = z i0 →
        (∀ y : Abelian.Ext (wcFreeSheaf Y (wcOpenRestr Y (O i0) T)) K' j, y = 0) →
        ∀ y : Abelian.Ext (wcFreeSheaf Y T) K' j, y = 0 := by
      intro T hT i0 t0 ht0 IH'
      have hfibT : IsIso (Limits.pullback.snd T.hom (Y.fromSpecResidueField (z i0))) := by
        haveI := hT
        have H' : Set.range (Y.fromSpecResidueField (z i0)) ⊆ Set.range T.hom :=
          (Scheme.range_fromSpecResidueField (X := Y) (z i0)).le.trans
            (Set.singleton_subset_iff.mpr ⟨t0, ht0⟩)
        have hl := IsOpenImmersion.lift_fac T.hom _ H'
        let σ := Limits.pullback.lift (IsOpenImmersion.lift T.hom _ H') (𝟙 _)
          (by rw [hl, Category.id_comp])
        have hσ : σ ≫ Limits.pullback.snd T.hom (Y.fromSpecResidueField (z i0)) = 𝟙 _ :=
          Limits.pullback.lift_snd _ _ _
        refine IsIso.mk ⟨σ, ?_, hσ⟩
        rw [← cancel_mono (Limits.pullback.snd T.hom (Y.fromSpecResidueField (z i0))),
          Category.assoc, hσ, Category.comp_id, Category.id_comp]
      have hTcT : CompactSpace T.left := by
        haveI := hT
        have hc : IsCompact (Set.range T.hom) :=
          @TopologicalSpace.NoetherianSpace.isCompact Y _ inferInstance _
        have hind := (Scheme.Hom.isOpenEmbedding T.hom).isInducing
        rw [← Set.image_univ, ← hind.isCompact_iff] at hc
        exact isCompact_univ_iff.mp hc
      have hcok : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
          (wcOpenRestrIncl Y (O i0) T))) K' j, y = 0 := by
        intro y
        obtain ⟨κ, hκ⟩ := hexc (O i0) (z i0) rfl T hfibT hTcT
        haveI := hκ
        have h0 := hcoker0 i0 ((Abelian.Ext.mk₀ (inv κ)).comp y (zero_add j))
        calc y = (Abelian.Ext.mk₀ (𝟙 _)).comp y (zero_add j) := (Abelian.Ext.mk₀_id_comp y).symm
