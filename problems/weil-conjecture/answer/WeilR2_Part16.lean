  have L2 : Nonempty (S ≃ₜ PrimeSpectrum (LocallyConstant S K)) := by
    let ε : S → PrimeSpectrum (LocallyConstant S K) := fun s =>
      ⟨RingHom.ker (LocallyConstant.evalRingHom s : LocallyConstant S K →+* K),
