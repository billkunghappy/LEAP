    exact (wc_et_coh_const_prime_devissage (O : Scheme.{u}) 1 one_ne_zero
      (fun p hp hdvd => absurd hdvd hp.not_dvd_one)).2 (2 * (n - 1)) (by omega)
  | succ m' =>
