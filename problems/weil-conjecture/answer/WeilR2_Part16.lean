theorem wc_proet_isIso_of_sections_bijective {S : Scheme.{u}}
    {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (α : A ⟶ B)
    (hα : ∀ U : S.ProEt, Sieve.generate (fun (T : S.ProEt) (_ : T ⟶ U) =>
      Function.Bijective (α.hom.app (Opposite.op T)).hom) ∈ Scheme.ProEt.topology S U) :
    IsIso α :=
by
  have hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology S) α.hom := by
    apply Presheaf.IsLocallyInjective.mk
    intro X x y hxy
    refine (Scheme.ProEt.topology S).superset_covering ?_ (hα X.unop)
    rw [Sieve.generate_le_iff]
    intro T g hg
    rw [Presheaf.equalizerSieve_apply]
    have e : ∀ z : A.obj.obj X, (α.hom.app (Opposite.op T)).hom ((A.obj.map g.op).hom z) =
        (B.obj.map g.op).hom ((α.hom.app X).hom z) := fun z =>
      congrArg (fun m => m.hom z) (α.hom.naturality g.op)
    apply hg.injective
    exact (e x).trans ((congrArg (B.obj.map g.op).hom hxy).trans (e y).symm)
  have hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S) α.hom := by
    apply Presheaf.IsLocallySurjective.mk
    intro U s
    refine (Scheme.ProEt.topology S).superset_covering ?_ (hα U)
    rw [Sieve.generate_le_iff]
    intro T g hg
    rw [Presheaf.imageSieve_apply]
    obtain ⟨t, ht⟩ := hg.2 ((B.obj.map g.op).hom s)
    exact ⟨t, ht⟩
  exact (Sheaf.isLocallyBijective_iff_isIso α).mp ⟨hinj, hsurj⟩

theorem wc_proet_sieve_of_affine_finite_covers (S : Scheme.{u}) (U : S.ProEt) (R : Sieve U)
    (hR : ∀ (W : S.ProEt) (v : W ⟶ U), IsAffine W.left →
      ∃ (m : ℕ) (W' : Fin m → S.ProEt) (e : ∀ j, W' j ⟶ W),
        (∀ j, IsAffine (W' j).left) ∧ (∀ y : W.left, ∃ j, y ∈ Set.range (e j).left) ∧
        ∀ j, R.arrows (e j ≫ v)) :
    R ∈ Scheme.ProEt.topology S U :=
by
  classical
  have fin_covers : ∀ (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have affine_local : ∀ (U : S.ProEt) (T : Sieve U),
      (∀ (V : S.ProEt) (f : V ⟶ U), IsAffine V.left → T.pullback f ∈ Scheme.ProEt.topology S V) →
      T ∈ Scheme.ProEt.topology S U := by
    intro U T hT
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
    intro Y f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
  apply affine_local U R
  intro W v hW
  obtain ⟨m, W', e, haff, hsurj, hR'⟩ := hR W v hW
  haveI : IsAffine W.left := hW
  refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W m W' e haff hsurj)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨j⟩
  exact hR' j

theorem wc_proet_wcontr_affine_open_cover {Y Z : Scheme.{u}} (i : Z ⟶ Y) (U : Z.ProEt) :
    Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
      (∃ O : Y.Opens, IsAffineOpen O ∧ ∀ t : T.left, i (T.hom t) ∈ O) ∧
      (IsAffine T.left ∧ IsClosed {x : T.left | IsClosed ({x} : Set T.left)} ∧
       (∀ x : T.left, ∃! y : T.left, IsClosed ({y} : Set T.left) ∧ x ⤳ y) ∧
       ExtremallyDisconnected {x : T.left | IsClosed ({x} : Set T.left)} ∧
       (∀ x : T.left, IsClosed ({x} : Set T.left) →
         HenselianLocalRing (T.left.presheaf.stalk x) ∧ IsSepClosed (T.left.residueField x))))
      ∈ Scheme.ProEt.topology Z U :=
by
  classical
  apply wc_proet_sieve_of_affine_finite_covers Z U
  intro W v hW
  haveI : IsAffine W.left := hW
  haveI : WeaklyEtale W.hom := W.prop

  have hch : ∀ x : W.left, ∃ O : Y.Opens, IsAffineOpen O ∧ ∃ N : W.left.Opens, IsAffineOpen N ∧
      x ∈ N ∧ N ≤ (W.hom ≫ i) ⁻¹ᵁ O := by
    intro x
    obtain ⟨O, hO, hyO, -⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y)
        (show (W.hom ≫ i) x ∈ (⊤ : Y.Opens) from trivial)
    obtain ⟨N, hN, hxN, hNO⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens W.left)
        (show x ∈ (W.hom ≫ i) ⁻¹ᵁ O from (Scheme.Hom.mem_preimage _).mpr hyO)
    exact ⟨O, hO, N, hN, hxN, hNO⟩
  choose O hO N hN hxN hNO using hch
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (N x : Set W.left))
    (fun x => IsOpen.mem_nhds (N x).isOpen (hxN x))
  let xs : Fin t.card → W.left := fun k => (t.equivFin.symm k).1
  have hxs : ∀ x : W.left, ∃ k, x ∈ N (xs k) := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (N y : Set W.left) := by rw [ht]; trivial
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
    simp only [xs, Equiv.symm_apply_apply]
    exact hxy

  have step : ∀ k : Fin t.card, ∃ (Δ : Scheme.{u}) (δ : Δ ⟶ (N (xs k) : Scheme.{u})),
      IsAffine Δ ∧ WeaklyEtale δ ∧ Surjective δ ∧ IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
      (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
      (∀ x : Δ, IsClosed ({x} : Set Δ) →
        HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)) := by
    intro k
    haveI : IsAffine (N (xs k) : Scheme.{u}) := hN (xs k)
    exact wc_exists_wcontractible_cover _ inferInstance
  choose Δ δ hΔa hδw hδs h1 h2 h3 h4 using step
  haveI : ∀ k, WeaklyEtale (δ k) := hδw
  let W' : Fin t.card → Z.ProEt := fun k =>
    Scheme.ProEt.mk (δ k ≫ (N (xs k)).ι ≫ W.hom)
  let e : ∀ k, W' k ⟶ W := fun k =>
    MorphismProperty.Over.homMk (A := W' k) (B := W) (δ k ≫ (N (xs k)).ι)
      (Category.assoc _ _ _) trivial
  refine ⟨t.card, W', e, fun k => hΔa k, ?_, ?_⟩
  · intro y
    obtain ⟨k, hk⟩ := hxs y
    obtain ⟨s, hs⟩ := (hδs k).surj ⟨y, hk⟩
    refine ⟨k, s, ?_⟩
    show (δ k ≫ (N (xs k)).ι) s = y
    rw [Scheme.Hom.comp_apply, hs, Scheme.Opens.ι_apply]
  · intro k
    refine Sieve.le_generate _ _ (e k ≫ v) ⟨⟨O (xs k), hO (xs k), ?_⟩,
      ⟨hΔa k, h1 k, h2 k, h3 k, h4 k⟩⟩
    show ∀ s : Δ k, i ((δ k ≫ (N (xs k)).ι ≫ W.hom) s) ∈ O (xs k)
    intro s
    have hz : (N (xs k)).ι (δ k s) ∈ N (xs k) := by
      have hr : (N (xs k)).ι (δ k s) ∈ Set.range (N (xs k)).ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    have hmem := (Scheme.Hom.mem_preimage _).mp (hNO (xs k) hz)
    exact hmem

theorem wc_hte_affine_setup {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (T : Z.ProEt)
    (O : Y.Opens) (hO : IsAffineOpen O) (hTO : ∀ t : T.left, i (T.hom t) ∈ O) (hTa : IsAffine T.left) :
    ∃ (A₀ : Type u) (_ : CommRing A₀) (I₀ : Ideal A₀) (B : Type u) (_ : CommRing B) (_ : Algebra (A₀ ⧸ I₀) B)
      (j : Spec (.of A₀) ⟶ Y) (k : Spec (.of (A₀ ⧸ I₀)) ⟶ Z) (eT : T.left ≅ Spec (.of B)),
      IsOpenImmersion j ∧ IsPullback k (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀))) i j ∧
      eT.inv ≫ T.hom = Spec.map (CommRingCat.ofHom (algebraMap (A₀ ⧸ I₀) B)) ≫ k ∧
      Algebra.WeaklyEtale (A₀ ⧸ I₀) B :=
by
  classical

  have conv : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
  haveI := hTa
  haveI hjo : IsOpenImmersion hO.fromSpec := hO.isOpenImmersion_fromSpec
  obtain ⟨I₀, e, hsnd⟩ :=
    (IsClosedImmersion.Spec_iff (f := Limits.pullback.snd i hO.fromSpec)).mp inferInstance
  let k : Spec (.of (Γ(Y, O) ⧸ I₀)) ⟶ Z := e.inv ≫ Limits.pullback.fst i hO.fromSpec
  have hcomm : k ≫ i = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀)) ≫ hO.fromSpec := by
    simp only [k, Category.assoc, Limits.pullback.condition]
    rw [hsnd, Category.assoc, Iso.inv_hom_id_assoc]
  have hpb : IsPullback k (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀))) i hO.fromSpec :=
    IsPullback.of_iso_pullback ⟨hcomm⟩ e.symm rfl
      (by rw [Iso.symm_hom, hsnd, Iso.inv_hom_id_assoc])
  haveI : IsOpenImmersion k := inferInstance
  have hrange : Set.range ⇑(T.hom ≫ i) ⊆ Set.range ⇑hO.fromSpec := by
    rintro _ ⟨t, rfl⟩
    rw [hO.range_fromSpec, Scheme.Hom.comp_apply]
    exact hTO t
  let t₁ := IsOpenImmersion.lift hO.fromSpec (T.hom ≫ i) hrange
  have hw : T.hom ≫ i = t₁ ≫ hO.fromSpec := (IsOpenImmersion.lift_fac _ _ _).symm
  let τ : T.left ⟶ Spec (.of (Γ(Y, O) ⧸ I₀)) := Limits.pullback.lift T.hom t₁ hw ≫ e.hom
  have hτ : τ ≫ k = T.hom := by
    simp only [τ, k, Category.assoc, Iso.hom_inv_id_assoc, Limits.pullback.lift_fst]
  let ψ := Spec.preimage (T.left.isoSpec.inv ≫ τ)
  have hψ : Spec.map ψ = T.left.isoSpec.inv ≫ τ := Spec.map_preimage _
  letI alg : Algebra (Γ(Y, O) ⧸ I₀) Γ(T.left, ⊤) := ψ.hom.toAlgebra
  have hofh : CommRingCat.ofHom (algebraMap (Γ(Y, O) ⧸ I₀) Γ(T.left, ⊤)) = ψ :=
    CommRingCat.ofHom_hom ψ
  have h3 : T.left.isoSpec.inv ≫ T.hom =
      Spec.map (CommRingCat.ofHom (algebraMap (Γ(Y, O) ⧸ I₀) Γ(T.left, ⊤))) ≫ k := by
    rw [hofh, hψ, Category.assoc, hτ]
  have hWc : WeaklyEtale (Spec.map ψ ≫ k) := by
    rw [hψ, Category.assoc, hτ]
    infer_instance
  have hWψ : WeaklyEtale (Spec.map ψ) := WeaklyEtale.of_comp (Spec.map ψ) k
  have hWψ' : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ.hom)) := by
    rw [CommRingCat.ofHom_hom]
    exact hWψ
  exact ⟨Γ(Y, O), inferInstance, I₀, Γ(T.left, ⊤), inferInstance, alg, hO.fromSpec, k,
    T.left.isoSpec, hjo, hpb, h3, conv _ _ ψ.hom hWψ'⟩

theorem wc_hte_sepClosed_henselian_transport : (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) ∧
    (∀ (R' S' : Type u) [CommRing R'] [CommRing S'], (R' ≃+* S') → HenselianLocalRing R' → HenselianLocalRing S') :=
by
  have key : ∀ {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B) (p : Polynomial B),
      (p.map (e.symm : B →+* A)).map (e : A →+* B) = p := by
    intro A B _ _ e p
    rw [Polynomial.map_map, RingEquiv.comp_symm, Polynomial.map_id]
  refine ⟨?_, ?_⟩
  · intro K L _ _ e hK
    refine IsSepClosed.mk (fun p hp => ?_)
    have hq : (p.map (e.symm : L →+* K)).Separable := hp.map
    have h := IsSepClosed.splits_domain (f := (e : K →+* L)) _ hq
    rwa [key] at h
  · intro R' S' _ _ e hR
    have := hR
    have : IsLocalRing S' := e.isLocalRing
    have hmem : ∀ {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (φ : A ≃+* B) (x : A),
        φ x ∈ IsLocalRing.maximalIdeal B ↔ x ∈ IsLocalRing.maximalIdeal A := by
      intro A B _ _ _ _ φ x
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff, MulEquiv.isUnit_map φ]
    refine HenselianLocalRing.mk (fun f hf a₀ h1 h2 => ?_)
    have e1 : Polynomial.eval (e.symm a₀) (f.map (e.symm : S' →+* R')) = e.symm (Polynomial.eval a₀ f) :=
      Polynomial.eval_map_apply (e.symm : S' →+* R') a₀
    have e2 : Polynomial.eval (e.symm a₀) (Polynomial.derivative (f.map (e.symm : S' →+* R'))) =
        e.symm (Polynomial.eval a₀ (Polynomial.derivative f)) := by
      rw [Polynomial.derivative_map]
      exact Polynomial.eval_map_apply (e.symm : S' →+* R') a₀
    obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian (f.map (e.symm : S' →+* R'))
      (hf.map _) (e.symm a₀) (by rw [e1]; exact (hmem e.symm _).2 h1)
      (by rw [e2]; exact (MulEquiv.isUnit_map e.symm).2 h2)
    refine ⟨e b, ?_, ?_⟩
    · have e3 : Polynomial.eval (e b) ((f.map (e.symm : S' →+* R')).map (e : R' →+* S')) =
          e (Polynomial.eval b (f.map (e.symm : S' →+* R'))) :=
        Polynomial.eval_map_apply (e : R' →+* S') b
      rw [key] at e3
      rw [Polynomial.IsRoot.def, e3]
      rw [Polynomial.IsRoot.def] at hb
      rw [hb, map_zero]
    · have e4 : e b - a₀ = e (b - e.symm a₀) := by
        rw [map_sub, RingEquiv.apply_symm_apply]
      rw [e4]
      exact (hmem e _).2 hbb

theorem wc_hte_wcontr_of_iso (X Y : Scheme.{u}) (f : X ≅ Y)
    (hK8 : (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) ∧
      (∀ (R' S' : Type u) [CommRing R'] [CommRing S'], (R' ≃+* S') → HenselianLocalRing R' → HenselianLocalRing S'))
    (hX : IsAffine X ∧ IsClosed {x : X | IsClosed ({x} : Set X)} ∧ (∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : X | IsClosed ({x} : Set X)} ∧
      (∀ x : X, IsClosed ({x} : Set X) → HenselianLocalRing (X.presheaf.stalk x) ∧ IsSepClosed (X.residueField x))) :
    IsAffine Y ∧ IsClosed {x : Y | IsClosed ({x} : Set Y)} ∧ (∀ x : Y, ∃! y : Y, IsClosed ({y} : Set Y) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : Y | IsClosed ({x} : Set Y)} ∧
      (∀ x : Y, IsClosed ({x} : Set Y) → HenselianLocalRing (Y.presheaf.stalk x) ∧ IsSepClosed (Y.residueField x)) :=
by
  obtain ⟨hA, hc, hu, he, hs⟩ := hX
  set h : X ≃ₜ Y := Scheme.homeoOfIso f with hh
  have K : ∀ x : X, IsClosed ({h x} : Set Y) ↔ IsClosed ({x} : Set X) := by
    intro x
    rw [← Set.image_singleton]
    exact h.isClosed_image
  have K' : ∀ y : Y, IsClosed ({y} : Set Y) ↔ IsClosed ({h.symm y} : Set X) := by
    intro y
    rw [← K, h.apply_symm_apply]
  have hinv : ∀ y : Y, h.symm y = f.inv y := by
    intro y
    apply h.injective
    rw [h.apply_symm_apply, hh, Scheme.homeoOfIso_apply, ← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have := hA
    exact IsAffine.of_isIso f.inv
  · have : {x : Y | IsClosed ({x} : Set Y)} = h.symm ⁻¹' {x : X | IsClosed ({x} : Set X)} := by
      ext y
      exact K' y
    rw [this]
    exact hc.preimage h.symm.continuous
  · intro y
    obtain ⟨x', ⟨hx'c, hx'⟩, hx'u⟩ := hu (h.symm y)
    refine ⟨h x', ⟨(K x').mpr hx'c, ?_⟩, ?_⟩
    · have := hx'.map h.continuous
      rwa [h.apply_symm_apply] at this
    · rintro z ⟨hzc, hz⟩
      have e1 : h.symm z = x' := hx'u _ ⟨(K' z).mp hzc, hz.map h.symm.continuous⟩
      rw [← e1, h.apply_symm_apply]
  · let g : {x : X | IsClosed ({x} : Set X)} ≃ₜ {x : Y | IsClosed ({x} : Set Y)} :=
      h.subtype (fun x => (K x).symm)
    refine ⟨fun U hU => ?_⟩
    rw [← g.isOpen_preimage, g.preimage_closure]
    exact he.open_closure _ (hU.preimage g.continuous)
  · intro y hy
    have hx : IsClosed ({f.inv y} : Set X) := by
      rw [← hinv]; exact (K' y).mp hy
    obtain ⟨h1, h2⟩ := hs _ hx
    exact ⟨hK8.2 _ _ (asIso (f.inv.stalkMap y)).commRingCatIsoToRingEquiv h1,
      hK8.1 _ _ (asIso (f.inv.residueFieldMap y)).commRingCatIsoToRingEquiv h2⟩

theorem wc_hte_indEtale_of_wcontr (S₀ B : Type u) [CommRing S₀] [CommRing B] [Algebra S₀ B] (hWE : Algebra.WeaklyEtale S₀ B)
    (hc : IsClosed {x : Spec (.of B) | IsClosed ({x} : Set (Spec (.of B)))})
    (hu : ∀ x : Spec (.of B), ∃! y : Spec (.of B), IsClosed ({y} : Set (Spec (.of B))) ∧ x ⤳ y)
    (he : ExtremallyDisconnected {x : Spec (.of B) | IsClosed ({x} : Set (Spec (.of B)))})
    (hs : ∀ x : Spec (.of B), IsClosed ({x} : Set (Spec (.of B))) →
      HenselianLocalRing ((Spec (.of B)).presheaf.stalk x) ∧ IsSepClosed ((Spec (.of B)).residueField x)) :
    wcIndEtale (algebraMap S₀ B) :=
by
  classical
  obtain ⟨T, iT, iBT, hFF, hWET, hind⟩ := wc_bs_weaklyEtale_indEtale_locally S₀ B hWE
  have hWp := wc_lfi_specMap_weaklyEtale B T hWET
  have hsurj : Surjective (Spec.map (CommRingCat.ofHom (algebraMap B T))) := by
    rw [surjective_iff]
    exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
  obtain ⟨σ, hσ⟩ := wc_wlocal_strictHensel_retraction (Spec (.of B)) inferInstance hc hu he hs
    (Spec (.of T)) _ inferInstance hWp hsurj
  have hr0 : CommRingCat.ofHom (algebraMap B T) ≫ Spec.preimage σ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, hσ, Spec.map_id]
  have hR : ∀ b : B, (Spec.preimage σ).hom (algebraMap B T b) = b := fun b => by
    have := congrArg (fun f => f.hom b) hr0
    simpa using this
  unfold wcIndEtale at hind ⊢
  intro P _ _ _ h
  letI A₂ : Algebra S₀ T := ((algebraMap B T).comp (algebraMap S₀ B)).toAlgebra
  letI A₁ : Algebra S₀ B := (algebraMap S₀ B).toAlgebra
  let h' : P →ₐ[S₀] T :=
    { toRingHom := (algebraMap B T).comp h.toRingHom
      commutes' := fun s => congrArg (algebraMap B T) (h.commutes s) }
  obtain ⟨E, iE, iSE, hEt, α, β, hβα⟩ := hind P h'
  let β' : E →ₐ[S₀] B :=
    { toRingHom := (Spec.preimage σ).hom.comp β.toRingHom
      commutes' := fun s =>
        (congrArg (Spec.preimage σ).hom (β.commutes s)).trans (hR _) }
  refine ⟨E, iE, iSE, hEt, α, β', ?_⟩
  apply AlgHom.ext
  intro x
  exact (congrArg (Spec.preimage σ).hom (AlgHom.congr_fun hβα x)).trans (hR (h x))

theorem wc_hte_wcontr_of_henselian_quotient (R : Type u) [CommRing R] (I : Ideal R) [HenselianRing R I]
    (hK8 : (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) ∧
      (∀ (R' S' : Type u) [CommRing R'] [CommRing S'], (R' ≃+* S') → HenselianLocalRing R' → HenselianLocalRing S'))
    (hQ : IsAffine (Spec (.of (R ⧸ I))) ∧ IsClosed {x : Spec (.of (R ⧸ I)) | IsClosed ({x} : Set (Spec (.of (R ⧸ I))))} ∧
      (∀ x : Spec (.of (R ⧸ I)), ∃! y : Spec (.of (R ⧸ I)), IsClosed ({y} : Set (Spec (.of (R ⧸ I)))) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : Spec (.of (R ⧸ I)) | IsClosed ({x} : Set (Spec (.of (R ⧸ I))))} ∧
      (∀ x : Spec (.of (R ⧸ I)), IsClosed ({x} : Set (Spec (.of (R ⧸ I)))) →
        HenselianLocalRing ((Spec (.of (R ⧸ I))).presheaf.stalk x) ∧ IsSepClosed ((Spec (.of (R ⧸ I))).residueField x))) :
    IsAffine (Spec (.of R)) ∧ IsClosed {x : Spec (.of R) | IsClosed ({x} : Set (Spec (.of R)))} ∧
      (∀ x : Spec (.of R), ∃! y : Spec (.of R), IsClosed ({y} : Set (Spec (.of R))) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : Spec (.of R) | IsClosed ({x} : Set (Spec (.of R)))} ∧
      (∀ x : Spec (.of R), IsClosed ({x} : Set (Spec (.of R))) →
        HenselianLocalRing ((Spec (.of R)).presheaf.stalk x) ∧ IsSepClosed ((Spec (.of R)).residueField x)) :=
by
  classical
  have tC10 : ∀ (L L' : Type u) [CommRing L] [CommRing L'] [IsLocalRing L] [IsLocalRing L'] (π : L →+* L')
    (hπ : Function.Surjective π),
      Nonempty (IsLocalRing.ResidueField L ≃+* IsLocalRing.ResidueField L') := by
    intro L L' _ _ _ _ π hπ
    haveI : IsLocalHom π := IsLocalHom.of_surjective π hπ
    haveI : Nontrivial (IsLocalRing.ResidueField L') :=
      (IsLocalRing.ResidueField.field L').toNontrivial
    refine ⟨RingEquiv.ofBijective (IsLocalRing.ResidueField.map π)
      ⟨(IsLocalRing.ResidueField.map π).injective, ?_⟩⟩
    intro y
    obtain ⟨y', rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨r, rfl⟩ := hπ y'
    exact ⟨IsLocalRing.residue L r, IsLocalRing.ResidueField.map_residue π r⟩
  have tF0 : ∀ (R : Type u) [CommRing R] (I : Ideal R) [HenselianRing R I] (m : Ideal R) [hm : m.IsMaximal],
      I ≤ m ∧ (m.map (Ideal.Quotient.mk I)).IsMaximal ∧ (m.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = m := by
    intro R _ I _ m hm
    have hIm : I ≤ m := le_trans HenselianRing.jac (sInf_le ⟨bot_le, hm⟩)
    have hc : (m.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = m := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact sup_eq_left.mpr hIm
    refine ⟨hIm, ?_, hc⟩
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective hm with h | h
    · exfalso; apply hm.ne_top; rw [← hc, h, Ideal.comap_top]
    · exact h
  have tC1 : ∀ (R : Type u) [CommRing R] (I : Ideal R) [HenselianRing R I] (ē : R ⧸ I) (hē : IsIdempotentElem ē),
      ∃ e : R, IsIdempotentElem e ∧ Ideal.Quotient.mk I e = ē := by
    intro R _ I _ ē hē
    obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective ē
    have hf : (Polynomial.X ^ 2 - Polynomial.X : Polynomial R).Monic :=
      Polynomial.monic_X_pow_sub (lt_of_le_of_lt Polynomial.degree_X_le (by norm_num))
    have h1 : (Polynomial.X ^ 2 - Polynomial.X : Polynomial R).eval a₀ ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, map_sub, map_pow]
      rw [sq, hē.eq, sub_self]
    have hd : (Polynomial.derivative (Polynomial.X ^ 2 - Polynomial.X : Polynomial R)).eval a₀ = 2 * a₀ - 1 := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_X,
        Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_one]
      norm_num
    have h2 : IsUnit (Ideal.Quotient.mk I ((Polynomial.derivative (Polynomial.X ^ 2 - Polynomial.X : Polynomial R)).eval a₀)) := by
      rw [hd]
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk I (2 * a₀ - 1), ?_⟩
      rw [← map_mul]
      have e1 : (2 * a₀ - 1) * (2 * a₀ - 1) = 4 * (a₀ * a₀ - a₀) + 1 := by ring
      have e2 : Ideal.Quotient.mk I (a₀ * a₀ - a₀) = 0 := by
        rw [map_sub, map_mul, hē.eq, sub_self]
      rw [e1, map_add, map_mul, e2, mul_zero, zero_add, map_one]
    obtain ⟨e, he, hea⟩ := HenselianRing.is_henselian _ hf a₀ h1 h2
    refine ⟨e, ?_, Ideal.Quotient.eq.mpr hea⟩
    have h3 : (Polynomial.X ^ 2 - Polynomial.X : Polynomial R).eval e = 0 := he
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X] at h3
    show e * e = e
    rw [← sq]; exact sub_eq_zero.mp h3
  have tC2 : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y] (c : X → Y) (hc : Topology.IsClosedEmbedding c)
    (hpt : ∀ y : Y, IsClosed ({y} : Set Y) ↔ ∃ x : X, IsClosed ({x} : Set X) ∧ c x = y)
    (hCX : IsClosed {x : X | IsClosed ({x} : Set X)}) (hED : ExtremallyDisconnected {x : X | IsClosed ({x} : Set X)}),
      IsClosed {y : Y | IsClosed ({y} : Set Y)} ∧ ExtremallyDisconnected {y : Y | IsClosed ({y} : Set Y)} := by
    intro X Y _ _ c hc hpt hCX hED
    have hset : {y : Y | IsClosed ({y} : Set Y)} = c '' {x : X | IsClosed ({x} : Set X)} := by
      ext y; rw [Set.mem_setOf_eq, hpt y]; rfl
    refine ⟨by rw [hset]; exact hc.isClosedMap _ hCX, ?_⟩
    let g : {x : X | IsClosed ({x} : Set X)} → {y : Y | IsClosed ({y} : Set Y)} :=
      Set.codRestrict (c ∘ Subtype.val) _ (fun x => (hpt _).2 ⟨x.1, x.2, rfl⟩)
    have hemb : Topology.IsEmbedding g :=
      (hc.isEmbedding.comp Topology.IsEmbedding.subtypeVal).codRestrict _ _
    have hsurj : Function.Surjective g := by
      rintro ⟨y, hy⟩
      obtain ⟨x, hx, rfl⟩ := (hpt y).1 hy
      exact ⟨⟨x, hx⟩, rfl⟩
    let h := hemb.toHomeomorphOfSurjective hsurj
    refine ⟨fun U hU => ?_⟩
    have h1 : IsOpen (closure (h ⁻¹' U)) := hED.open_closure _ (hU.preimage h.continuous)
    rw [← Homeomorph.preimage_closure] at h1
    exact h.isOpen_preimage.mp h1
  have tC3 : ∀ (R : Type u) [CommRing R] (I : Ideal R)
    (hF0 : ∀ (m : Ideal R) [m.IsMaximal], I ≤ m ∧ (m.map (Ideal.Quotient.mk I)).IsMaximal ∧
      (m.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = m) (y : PrimeSpectrum R),
      IsClosed ({y} : Set (PrimeSpectrum R)) ↔ ∃ x : PrimeSpectrum (R ⧸ I),
      IsClosed ({x} : Set (PrimeSpectrum (R ⧸ I))) ∧ PrimeSpectrum.comap (Ideal.Quotient.mk I) x = y := by
    intro R _ I hF0 y
    rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
    constructor
    · intro hm
      obtain ⟨-, hmax, hc⟩ := @hF0 y.asIdeal hm
      refine ⟨⟨_, hmax.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 hmax, ?_⟩
      ext1; exact hc
    · rintro ⟨x, hx, rfl⟩
      rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal] at hx
      exact @Ideal.comap_isMaximal_of_surjective _ _ _ _ _ _ _ _ Ideal.Quotient.mk_surjective _ hx
  have tC6 : ∀ (R : Type u) [CommRing R] (I : Ideal R) [HenselianRing R I] (e : R) (he : IsIdempotentElem e)
    (F : Polynomial R) (hF : F.Monic) (hd : 1 ≤ F.natDegree) (A₀ c : R)
    (h1 : e * F.eval A₀ ∈ I) (h2 : e * ((Polynomial.derivative F).eval A₀ * c - 1) ∈ I),
      ∃ a : R, e * F.eval a = 0 ∧ a - A₀ ∈ I := by
    intro R _ I _ e he F hF hd A₀ c h1 h2
    rcases subsingleton_or_nontrivial R with hR | hR
    · exact ⟨A₀, Subsingleton.elim _ _, by rw [Subsingleton.elim (A₀ - A₀) 0]; exact I.zero_mem⟩
    have hee : e * e = e := he.eq
    set d := F.natDegree with hdd
    set G : Polynomial R := (Polynomial.X - Polynomial.C A₀) * (Polynomial.X - Polynomial.C (A₀ - 1)) ^ (d - 1) with hGdef
    have hG1 : (Polynomial.X - Polynomial.C (A₀ - 1) : Polynomial R).Monic := Polynomial.monic_X_sub_C _
    have hGm : G.Monic := (Polynomial.monic_X_sub_C A₀).mul (hG1.pow _)
    have hGd : G.natDegree = d := by
      rw [hGdef, (Polynomial.monic_X_sub_C A₀).natDegree_mul (hG1.pow _), hG1.natDegree_pow,
        Polynomial.natDegree_X_sub_C, Polynomial.natDegree_X_sub_C]
      omega
    set H : Polynomial R := Polynomial.C e * F + Polynomial.C (1 - e) * G with hHdef
    have hHd : H.natDegree ≤ d :=
      (Polynomial.natDegree_add_le _ _).trans
        (max_le (Polynomial.natDegree_C_mul_le _ _) ((Polynomial.natDegree_C_mul_le _ _).trans hGd.le))
    have hcoeff : H.coeff d = 1 := by
      have hFc : F.coeff d = 1 := hF
      have hGc : G.coeff d = 1 := by rw [← hGd]; exact hGm
      rw [hHdef, Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, hFc, hGc]
      ring
    have hHm : H.Monic := Polynomial.monic_of_natDegree_le_of_coeff_eq_one d hHd hcoeff
    have hGA : G.eval A₀ = 0 := by
      rw [hGdef, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul]
    have hHA : H.eval A₀ = e * F.eval A₀ := by
      rw [hHdef, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_C, hGA, mul_zero, add_zero]
    have hdGA : (Polynomial.derivative G).eval A₀ = 1 := by
      rw [hGdef, Polynomial.derivative_mul, Polynomial.derivative_X_sub_C, one_mul, Polynomial.eval_add,
        Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul,
        add_zero, Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
        sub_sub_cancel, one_pow]
    have hdHA : (Polynomial.derivative H).eval A₀ = e * (Polynomial.derivative F).eval A₀ + (1 - e) := by
      rw [hHdef, Polynomial.derivative_add, Polynomial.derivative_C_mul, Polynomial.derivative_C_mul,
        Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_C,
        hdGA, mul_one]
    have hunit : IsUnit (Ideal.Quotient.mk I ((Polynomial.derivative H).eval A₀)) := by
