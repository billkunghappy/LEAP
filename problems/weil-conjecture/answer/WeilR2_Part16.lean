      refine ⟨?_, ?_⟩
      · intro f
        have hle : Ideal.span {f} ≤ Ideal.span {f * f} := by
          apply Ideal.le_of_localization_maximal
          intro P hP
          haveI := hP.isPrime
          have hb := key (Localization.AtPrime P) P.primeCompl inferInstance
          obtain ⟨c, hc⟩ := hb.2 (algebraMap B (Localization.AtPrime P) f)
