        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * N)) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * N)) :=
by
  intro k hk hfin
  classical
  set ι : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial with hιdef
  have hmono : Mono (wcFreeSheafMap Y ι) :=
    wc_free_sheaf_map_mono Y _ _ ι (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap Y ι)
      (Limits.cokernel.π (wcFreeSheafMap Y ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  have hOc0 : CompactSpace (O : Scheme.{u}) :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (O : Set Y))
  have hOs0 : IsSeparated (Limits.terminal.from (O : Scheme.{u})) := by
    rw [Limits.terminal.hom_ext (Limits.terminal.from (O : Scheme.{u}))
      (O.ι ≫ pY ≫ Limits.terminal.from (Spec (.of K)))]
    infer_instance
  haveI hOc : CompactSpace (Scheme.ProEt.mk O.ι).left := hOc0
  haveI hOs : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk O.ι).left) := hOs0
  have hvan : ∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (wcZModSheaf Y (ℓ ^ k))
      (2 * N), x = 0 :=
    wc_proet_free_zmod_ext_vanish_of_et_qcsep Y (Scheme.ProEt.mk O.ι) (ℓ ^ k) (2 * N) (hOv k)
  let r : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ι)) (wcZModSheaf Y (ℓ ^ k)) (2 * N) →
      Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y (ℓ ^ k)) (2 * N) :=
    fun t => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ι))).comp t
      (zero_add (2 * N))
  have hr : Function.Surjective r := by
    intro h
    obtain ⟨t, ht⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
