        rw [Fin.sum_univ_zero, zero_add, ← hnat, ← hfPdef, hκ, Fin.sum_univ_zero, zero_add]
      · intro W c y _
        refine (Scheme.ProEt.topology Xc).superset_covering ?_ ((Scheme.ProEt.topology Xc).top_mem W)
        intro W' g _
        exact ⟨W', 𝟙 _, g, fun a => a.elim0, Category.id_comp g⟩

    obtain ⟨Dw, -⟩ := wc_hm_pull_data_exists (𝟙 (Spec (.of Ω))) ℓ
    obtain ⟨I, -, -⟩ := wc_pmn_resolution_lift Dw

    have extZero : ∀ {Z Y : SheafOfModules.{u+1} (wcRingSheaf Xc ℓ)} (p : ℕ), Limits.IsZero Y →
        ∀ x : Abelian.Ext Z Y p, x = 0 := by
      intro Z Y p hY x
      rw [← Abelian.Ext.comp_mk₀_id x, (Limits.IsZero.iff_id_eq_zero Y).1 hY,
        Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

    haveI := Dc.presLim
    have hleray := wc_ext_leray_equiv_of_higher_ext_vanish Dc.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dc.cont Dc.φ) Dc.adj
      P (SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ)) I
      (fun q hq p => ⟨fun a b => (extZero p (s5 I q hq) a).trans (extZero p (s5 I q hq) b).symm⟩)

    have hRHS : ∀ (y : Abelian.Ext (Dc.Φ.obj P)
        (SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ)) (j + 1)), y = 0 := by
      intro y
      have hy : y = (Abelian.Ext.mk₀ ε.hom).comp
          ((Abelian.Ext.mk₀ ε.inv).comp y (zero_add _)) (zero_add _) := by
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      rw [hy, s3 (Spec (.of Ω)) (𝟙 _) inferInstance j
        ((Abelian.Ext.mk₀ ε.inv).comp y (zero_add _)), Abelian.Ext.comp_zero]
    obtain ⟨eL⟩ := hleray (j + 1)
    intro y
    exact eL.injective ((hRHS (eL y)).trans (hRHS (eL 0)).symm)

  have glue : ∀ {X : Scheme.{u}} (xs : X), IsClosed ({xs} : Set X) →
      IsSepClosed (X.residueField xs) → IsLocallyNoetherian X →
      ∀ (Dx : wcHMPullData (wcEtGeomPt X xs) ℓ), wcHMPullCanonical Dx → ∀ (j : ℕ)
      (y : @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) _ _ (HasExt.standard _)
        (wcSuppObj Dx) (wcSuppObj Dx) (j + 1)), y = 0 := by
    intro X xs hcl hsc hnoeth Dx hDx j
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
    haveI := hsc
    haveI := hnoeth
    haveI : IsClosedImmersion (X.fromSpecResidueField xs) :=
      IsClosedImmersion.of_isPreimmersion _ (by rw [Scheme.range_fromSpecResidueField]; exact hcl)
    obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists (X.fromSpecResidueField xs) ℓ
    obtain ⟨σ⟩ := wc_supp_obj_sepClosed_geomPt_iso xs Dι hDι Dx hDx
    obtain ⟨hF, hFa⟩ := wc_proet_closed_push_modules_full_faithful _ ℓ Dι hDι
    haveI := hF
    haveI := hFa
    haveI : IsIso Dι.adj.counit := Dι.adj.counit_isIso_of_R_fully_faithful
    have ε : Dι.Φ.obj (wcSuppObj Dx) ≅ SheafOfModules.unit _ :=
      Dι.Φ.mapIso σ.symm ≪≫ (asIso Dι.adj.counit).app _
    intro y
    have h0 := core (X.residueField xs) (X.fromSpecResidueField xs) Dι (wcSuppObj Dx) ε j
      (y.comp (Abelian.Ext.mk₀ σ.inv) (add_zero _))
    have hy : y = (y.comp (Abelian.Ext.mk₀ σ.inv) (add_zero _)).comp
        (Abelian.Ext.mk₀ σ.hom) (add_zero _) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    rw [hy, h0, Abelian.Ext.zero_comp]
  have hgeom := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  exact final (wcSuppObj Dx) (glue xs hgeom.1 hgeom.2.1 hgeom.2.2.1 Dx hDx)

theorem wc_pmn_tsl_supp_end_field (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) :
    ∀ c : wcSuppObj Dx ⟶ wcSuppObj Dx, c ≠ 0 → IsIso c :=
by
  classical

  have s1 : ∀ {X : Scheme.{u}} (x : ↥X), IsSepClosed (X.residueField x) →
      ∀ (Y : Scheme.{u}) (f : Y ⟶ X), Function.Injective (Limits.pullback.fst f (wcEtGeomPt X x)) := by
    intro X x hsep Y f
    haveI := hsep
    haveI : IsPurelyInseparable ↑(X.residueField x) (AlgebraicClosure ↑(X.residueField x)) :=
      inferInstance
    have hι : UniversallyInjective (Spec.map (CommRingCat.ofHom (algebraMap ↑(X.residueField x)
        (AlgebraicClosure ↑(X.residueField x))))) := by
      rw [UniversallyInjective.iff_diagonal, diagonal_SpecMap]
      have hss : Subsingleton (PrimeSpectrum (TensorProduct ↑(X.residueField x)
          (AlgebraicClosure ↑(X.residueField x)) (AlgebraicClosure ↑(X.residueField x)))) :=
        (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable ↑(X.residueField x)
          (AlgebraicClosure ↑(X.residueField x))
          (AlgebraicClosure ↑(X.residueField x))).injective.subsingleton
      haveI : Surjective (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' ↑(X.residueField x)
            (S := AlgebraicClosure ↑(X.residueField x))).toRingHom)) :=
        ⟨fun z => ⟨IsLocalRing.closedPoint _, @Subsingleton.elim (PrimeSpectrum _) hss _ _⟩⟩
      infer_instance
    have hxb : UniversallyInjective (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
        (AlgebraicClosure (X.residueField x)))) ≫ X.fromSpecResidueField x) :=
      MorphismProperty.comp_mem @UniversallyInjective _ _ hι inferInstance
    have hfst := MorphismProperty.of_isPullback (P := @UniversallyInjective)
      (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
        (AlgebraicClosure (X.residueField x)))) ≫ X.fromSpecResidueField x)).flip hxb
    exact Scheme.Hom.injective _

  have s2 : ∀ {X : Scheme.{u}} (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X) (W : X.ProEt)
      (w : ↥W.left) (q : ↥(Spec (.of Ω))), W.hom w = xb q →
      Function.Injective (Limits.pullback.fst (W.left.fromSpecStalk w ≫ W.hom) xb) →
      ∀ a b : ↥(Limits.pullback (W.left.fromSpecStalk w ≫ W.hom) xb), a = b := by
    intro X Ω _ xb W w q hw hinj
    haveI : WeaklyEtale W.hom := W.prop
    haveI := wc_lfi_fromSpecStalk_weaklyEtale W.left w
    have hg : WeaklyEtale (W.left.fromSpecStalk w ≫ W.hom) := inferInstance
    have key : ∀ a : ↥(Limits.pullback (W.left.fromSpecStalk w ≫ W.hom) xb),
        Limits.pullback.fst (W.left.fromSpecStalk w ≫ W.hom) xb a =
          IsLocalRing.closedPoint ↑(W.left.presheaf.stalk w) := by
      intro a
      apply wc_yjl_weaklyEtale_fibre_specializes _ hg _ _ (IsLocalRing.specializes_closedPoint _)
      have h0 := congrArg (fun k => k a)
        (Limits.pullback.condition (f := W.left.fromSpecStalk w ≫ W.hom) (g := xb))
      have hc : (W.left.fromSpecStalk w ≫ W.hom)
          (IsLocalRing.closedPoint ↑(W.left.presheaf.stalk w)) = W.hom w :=
        (Scheme.Hom.comp_apply (W.left.fromSpecStalk w) W.hom _).trans
          (congrArg (fun z => W.hom z) Scheme.fromSpecStalk_closedPoint)
      exact (Scheme.Hom.comp_apply (Limits.pullback.fst (W.left.fromSpecStalk w ≫ W.hom) xb)
          (W.left.fromSpecStalk w ≫ W.hom) a).symm.trans (h0.trans
        ((Scheme.Hom.comp_apply (Limits.pullback.snd (W.left.fromSpecStalk w ≫ W.hom) xb) xb a).trans
          ((congrArg (fun z => xb z)
            (Subsingleton.elim (Limits.pullback.snd (W.left.fromSpecStalk w ≫ W.hom) xb a) q)).trans
            (hw.symm.trans hc.symm))))
    intro a b
    exact hinj ((key a).trans (key b).symm)

  have gen : ∀ {X : Scheme.{u}} (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X)
      (Dx : wcHMPullData xb ℓ), wcHMPullCanonical Dx →
      (∀ (Y : Scheme.{u}) (f : Y ⟶ X), Function.Injective (Limits.pullback.fst f xb)) →
      (∀ (W : X.ProEt) (w : ↥W.left) (q : ↥(Spec (.of Ω))), W.hom w = xb q →
        ∀ a b : ↥(Limits.pullback (W.left.fromSpecStalk w ≫ W.hom) xb), a = b) →
      ∀ c : wcSuppObj Dx ⟶ wcSuppObj Dx, c ≠ 0 → IsIso c := by
    intro X Ω _ xb Dx hDx hinj hloc c hc
    haveI := Dx.cont
    haveI := Dx.additive
    let P := @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dx.cont Dx.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dx.adj
    have hrep : ∃ t : ℚ_[ℓ], c = P.map (wcHMConst (Spec (.of Ω)) ℓ t) := by
      let T : X.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 X) (inferInstance : WeaklyEtale (𝟙 X))
      have hsub : ∀ x y : ↥(Limits.pullback (𝟙 X) xb), x = y := by
        have e : ∀ z : ↥(Limits.pullback (𝟙 X) xb),
            (Limits.pullback.snd (𝟙 X) xb ≫ inv (Limits.pullback.snd (𝟙 X) xb)).base z = z := by
          intro z
          rw [IsIso.hom_inv_id]
          rfl
        intro x y
        rw [← e x, ← e y]
        show (inv (Limits.pullback.snd (𝟙 X) xb)).base ((Limits.pullback.snd (𝟙 X) xb).base x) =
          (inv (Limits.pullback.snd (𝟙 X) xb)).base ((Limits.pullback.snd (𝟙 X) xb).base y)
        rw [Subsingleton.elim ((Limits.pullback.snd (𝟙 X) xb).base x)
          ((Limits.pullback.snd (𝟙 X) xb).base y)]
      let q0 : ↥(Limits.pullback (𝟙 X) xb) :=
        (inv (Limits.pullback.snd (𝟙 X) xb)).base (IsLocalRing.closedPoint Ω)
      let cs : ∀ W : X.ProEt, C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ]) →
          C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ]) :=
        fun W σ => (c.val.app (Opposite.op W)).hom σ
      let res : ∀ W₁ W₂ : X.ProEt, (W₁ ⟶ W₂) → C(↥(Limits.pullback W₂.hom xb), ULift.{u+1} ℚ_[ℓ]) →
          C(↥(Limits.pullback W₁.hom xb), ULift.{u+1} ℚ_[ℓ]) :=
        fun W₁ W₂ g σ => ((wcSuppObj Dx).val.map g.op).hom σ
      have hres : ∀ (W₁ W₂ : X.ProEt) (g : W₁ ⟶ W₂)
          (σ : C(↥(Limits.pullback W₂.hom xb), ULift.{u+1} ℚ_[ℓ]))
          (z : ↥(Limits.pullback W₁.hom xb)),
          res W₁ W₂ g σ z = σ (((wcProEtBC xb).map g).left z) := fun _ _ _ _ _ => rfl
      have hnat : ∀ (W₁ W₂ : X.ProEt) (g : W₁ ⟶ W₂)
          (σ : C(↥(Limits.pullback W₂.hom xb), ULift.{u+1} ℚ_[ℓ])),
          cs W₁ (res W₁ W₂ g σ) = res W₁ W₂ g (cs W₂ σ) :=
        fun W₁ W₂ g σ => PresheafOfModules.naturality_apply c.val g.op σ
      obtain ⟨t, ht⟩ : ∃ t : ℚ_[ℓ],
          t = (cs T (1 : C(↥(Limits.pullback T.hom xb), ULift.{u+1} ℚ_[ℓ])) q0).down := ⟨_, rfl⟩

      have hB : ∀ (W : X.ProEt), (∀ a b : ↥(Limits.pullback W.hom xb), a = b) →
          ∀ (σ : C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ]))
            (p : ↥(Limits.pullback W.hom xb)),
          (cs W σ p).down = t * (σ p).down := by
        intro W hW σ p
        let τ : W ⟶ T := MorphismProperty.Over.homMk (B := T) W.hom (Category.comp_id _) trivial
        have hc1 : ∀ p' : ↥(Limits.pullback W.hom xb),
            (cs W (1 : C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ])) p').down = t := by
          intro p'
          have e0 : res W T τ (1 : C(↥(Limits.pullback T.hom xb), ULift.{u+1} ℚ_[ℓ])) = 1 :=
            ContinuousMap.ext fun _ => rfl
          have e1 := hnat W T τ (1 : C(↥(Limits.pullback T.hom xb), ULift.{u+1} ℚ_[ℓ]))
          rw [e0] at e1
          rw [e1, hres, hsub (((wcProEtBC xb).map τ).left p') q0]
          exact ht.symm
        let r : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := ContinuousMap.const _ (ULift.up (σ p).down)
        let φr : C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ]) :=
          (Dx.φ.hom.app (Opposite.op W)).hom r
        have hφr : φr = r.comp (Limits.pullback.fst W.hom xb).base.hom := hDx W r
        have hσ : σ = φr * 1 := by
          rw [hφr, mul_one]
          refine ContinuousMap.ext fun p'' => ?_
          rw [hW p'' p]
          rfl
        have hs : cs W (φr * 1) = φr * cs W 1 :=
          (c.val.app (Opposite.op W)).hom.map_smul r
            (1 : C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ]))
        have hcσ : cs W σ = φr * cs W 1 := (congrArg (cs W) hσ).trans hs
        rw [hcσ]
        show (φr p).down * (cs W 1 p).down = t * (σ p).down
        rw [hc1 p, hφr]
        show (σ p).down * t = t * (σ p).down
        exact mul_comm _ _

      have hC : ∀ (W : X.ProEt) (σ : C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ]))
          (p : ↥(Limits.pullback W.hom xb)), (cs W σ p).down = t * (σ p).down := by
        intro W σ p
        haveI : WeaklyEtale W.hom := W.prop
        let w : ↥W.left := Limits.pullback.fst W.hom xb p
        haveI := wc_lfi_fromSpecStalk_weaklyEtale W.left w
        let W' : X.ProEt := MorphismProperty.Over.mk ⊤ (W.left.fromSpecStalk w ≫ W.hom)
          (inferInstance : WeaklyEtale (W.left.fromSpecStalk w ≫ W.hom))
        let g : W' ⟶ W :=
          MorphismProperty.Over.homMk (A := W') (B := W) (W.left.fromSpecStalk w) rfl trivial
        have hw : W.hom w = xb (Limits.pullback.snd W.hom xb p) := by
          have h1 : (Limits.pullback.fst W.hom xb ≫ W.hom) p =
              (Limits.pullback.snd W.hom xb ≫ xb) p := by
            rw [Limits.pullback.condition]
          rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
          exact h1
        have hcw : W'.hom (IsLocalRing.closedPoint ↑(W.left.presheaf.stalk w)) =
            xb (Limits.pullback.snd W.hom xb p) :=
          (Scheme.Hom.comp_apply (W.left.fromSpecStalk w) W.hom _).trans
            ((congrArg (fun z => W.hom z) Scheme.fromSpecStalk_closedPoint).trans hw)
        obtain ⟨p', hp'1, -⟩ :=
          Scheme.Pullback.exists_preimage_pullback (f := W'.hom) (g := xb) _ _ hcw
        have e2 : ((wcProEtBC xb).map g).left ≫ Limits.pullback.fst W.hom xb =
            Limits.pullback.fst W'.hom xb ≫ g.left := Limits.pullback.lift_fst _ _ _
        have hp : ((wcProEtBC xb).map g).left p' = p := by
          apply hinj W.left W.hom
          have e3 := congrArg (fun k => k p') e2
          exact ((Scheme.Hom.comp_apply _ _ _).symm.trans e3).trans
            ((Scheme.Hom.comp_apply _ _ _).trans
              ((congrArg (fun z => g.left z) hp'1).trans
                (Scheme.fromSpecStalk_closedPoint (X := W.left) (x := w))))
        have hW' : ∀ a b : ↥(Limits.pullback W'.hom xb), a = b := fun a b => hloc W w _ hw a b
        have key := hB W' hW' (res W' W g σ) p'
        rw [hnat, hres, hres, hp] at key
        exact key

      have hD : ∀ (W : X.ProEt) (σ : C(↥(Limits.pullback W.hom xb), ULift.{u+1} ℚ_[ℓ])),
          cs W σ = σ * ContinuousMap.const _ (ULift.up t) := by
        intro W σ
        refine ContinuousMap.ext fun p => ULift.ext _ _ ?_
        rw [hC W σ p]
        show t * (σ p).down = (σ p).down * t
        exact mul_comm _ _
      refine ⟨t, ?_⟩
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro σ
      exact hD W.unop σ
    obtain ⟨t, rfl⟩ := hrep
    obtain ⟨h1, hmul, hadd⟩ := wc_hm_const_ring (Spec (.of Ω)) ℓ
    have hK0 : wcHMConst (Spec (.of Ω)) ℓ 0 = 0 := by
      have h := hadd 0 0
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
    have ht : t ≠ 0 := by
      rintro rfl
      apply hc
      rw [hK0]
      exact P.map_zero _ _
    refine IsIso.mk ⟨P.map (wcHMConst (Spec (.of Ω)) ℓ t⁻¹), ?_, ?_⟩
    · exact (P.map_comp _ _).symm.trans ((congrArg P.map ((hmul _ _).symm.trans
        ((congrArg (wcHMConst (Spec (.of Ω)) ℓ) (mul_inv_cancel₀ ht)).trans h1))).trans
        (P.map_id _))
    · exact (P.map_comp _ _).symm.trans ((congrArg P.map ((hmul _ _).symm.trans
        ((congrArg (wcHMConst (Spec (.of Ω)) ℓ) (inv_mul_cancel₀ ht)).trans h1))).trans
        (P.map_id _))
  obtain ⟨-, hsep, -, -⟩ := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  exact gen _ _ Dx hDx (s1 xs hsep)
    (fun W w q hw => s2 _ _ W w q hw (s1 xs hsep _ _))

theorem wc_pmn_odp_residue_algClosed (F'' : Type u) [Field F''] [Finite F'']
    (s : Spec (.of F'') ⟶ (wcP1Over F'').left) (hs : s ≫ (wcP1Over F'').hom = 𝟙 _)
    (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = s (IsLocalRing.closedPoint F'')) :
    IsAlgClosed (IsLocalRing.ResidueField A) :=
by
  classical
  obtain ⟨c, ψ, j, hj, hchart, hsec, -, hwe⟩ := wc_stpf_chart F'' s hs V A e hV

  have hpt : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint A) =
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) (IsLocalRing.closedPoint F'') := by
    haveI := hj
    apply j.isOpenEmbedding.isEmbedding.injective
    have h1 := congrArg (fun φ : Spec (.of A) ⟶ (wcP1Over F'').left =>
      φ (IsLocalRing.closedPoint A)) hchart
    have h2 := congrArg (fun φ : Spec (.of F'') ⟶ (wcP1Over F'').left =>
      φ (IsLocalRing.closedPoint F'')) hsec
    calc j ((Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint A))
        = (Spec.map (CommRingCat.ofHom ψ) ≫ j) (IsLocalRing.closedPoint A) :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = (e.inv ≫ V.hom) (IsLocalRing.closedPoint A) := h1.symm
      _ = V.hom (e.inv (IsLocalRing.closedPoint A)) := Scheme.Hom.comp_apply _ _ _
      _ = s (IsLocalRing.closedPoint F'') := hV
      _ = (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) ≫ j)
            (IsLocalRing.closedPoint F'') := h2.symm
      _ = j ((Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)))
            (IsLocalRing.closedPoint F'')) := Scheme.Hom.comp_apply _ _ _
  have hmem : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h3 := congrArg PrimeSpectrum.asIdeal hpt
    have hQ : Polynomial.X - Polynomial.C c ∈
        Ideal.comap (Polynomial.evalRingHom c) (IsLocalRing.maximalIdeal F'') := by
      rw [Ideal.mem_comap, Polynomial.coe_evalRingHom, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C, sub_self]
      exact Ideal.zero_mem _
    have hP : Polynomial.X - Polynomial.C c ∈
        Ideal.comap ψ (IsLocalRing.maximalIdeal A) := by
      have h4 : Ideal.comap ψ (IsLocalRing.maximalIdeal A) =
          Ideal.comap (Polynomial.evalRingHom c) (IsLocalRing.maximalIdeal F'') := h3
      rw [h4]
      exact hQ
    exact hP
  have hstar : IsLocalRing.residue A (ψ Polynomial.X) =
      IsLocalRing.residue A (ψ (Polynomial.C c)) := by
    rw [← sub_eq_zero, ← map_sub, ← map_sub]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr hmem

  let ι : F'' →+* IsLocalRing.ResidueField A := (IsLocalRing.residue A).comp (ψ.comp Polynomial.C)
  have hfac : (IsLocalRing.residue A).comp ψ = ι.comp (Polynomial.evalRingHom c) := by
    apply Polynomial.ringHom_ext
    · intro a
      simp [ι]
    · simp [ι, hstar]

  letI : Algebra F'' (IsLocalRing.ResidueField A) := ι.toAlgebra
  haveI halg : Algebra.IsAlgebraic F'' (IsLocalRing.ResidueField A) := by
    constructor
    intro x
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective x
    letI : Algebra (Polynomial F'') A := ψ.toAlgebra
    obtain ⟨f, hf1, hf2⟩ := wc_weaklyEtale_point_algebraic (Polynomial F'') A
      (IsLocalRing.ResidueField A) hwe (IsLocalRing.residue A) b
    have hal : algebraMap (Polynomial F'') A = ψ := rfl
    rw [hal, hfac] at hf1 hf2
    refine ⟨f.map (Polynomial.evalRingHom c), ?_, ?_⟩
    · intro h0
      apply hf1
      rw [← Polynomial.map_map, h0, Polynomial.map_zero]
    · rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact hf2

  haveI : PerfectField (IsLocalRing.ResidueField A) := Algebra.IsAlgebraic.perfectField F''
  exact IsSepClosed.isAlgClosed_of_perfectField _

theorem wc_pmn_odp_fibre_basic (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [IsAlgClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x) :
    IsProper (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
    ConnectedSpace ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
    (∃ y₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
        Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A),
      y₀ ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) = 𝟙 _ ∧
      y₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) = xs) ∧
    ∃ O : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens,
      (O : Set _) = {xs}ᶜ ∧ Nonempty O ∧
      SmoothOfRelativeDimension (n - 1)
        (O.ι ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
by
  classical
  haveI hsubF : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance

  have s2 : ∃ y : D.Yt.left, y ≠ D.xs i (IsLocalRing.closedPoint F'') ∧
      D.f y = D.S i (IsLocalRing.closedPoint F'') := by
    haveI hxsCI : IsClosedImmersion (D.xs i) := by
      apply isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
      rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
    have hrange : Set.range ⇑(D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hy
        rw [Set.mem_singleton_iff] at hy
        exact ⟨_, hy.symm⟩
    have hxcl : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
      rw [← hrange]
      first
        | exact (D.xs i).isClosedEmbedding.isClosed_range
        | exact (IsClosedImmersion.isClosedEmbedding (D.xs i)).isClosed_range
    haveI := D.smooth
    haveI := D.proper
    have hdim := wc_lfi_smooth_stalk_dim F'' D.Yt.left D.Yt.hom n _ hxcl
    haveI : IsLocallyNoetherian D.Yt.left := LocallyOfFiniteType.isLocallyNoetherian D.Yt.hom
    obtain ⟨-, τ, -, -, hτ, -, -⟩ := D.odp i
    have hτm : τ ∈ IsLocalRing.maximalIdeal
        ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) := by
      rw [hτ]; exact Ideal.mem_span_singleton_self τ
    have hh : (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) := by
      first
        | exact map_nonunit _ _ hτm
        | (rw [IsLocalRing.mem_maximalIdeal] at hτm ⊢; exact (map_mem_nonunits_iff _ _).mpr hτm)
    obtain ⟨𝔭, h𝔭, -⟩ := Ideal.exists_minimalPrimes_le ((Ideal.span_singleton_le_iff_mem _).2 hh)
    haveI h𝔭prime : 𝔭.IsPrime := by
      first
        | exact h𝔭.1.1
        | exact Ideal.IsMinimalPrime.isPrime h𝔭
    have hIp : Ideal.span {(D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ} ≤ 𝔭 := by
      first
        | exact h𝔭.1.2
        | exact Ideal.le_minimalPrimes h𝔭
    have hne : 𝔭 ≠ IsLocalRing.maximalIdeal
        (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) := by
      intro heq
      have hht := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes
        (Ideal.span {(D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ}) 𝔭 h𝔭
      rw [heq] at hht
      have h1 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim
        (R := D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
      rw [hdim] at h1
      have h2 : (IsLocalRing.maximalIdeal
          (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))).height = (n : ℕ∞) := by
        exact_mod_cast h1
      rw [h2] at hht
      have h3 : n ≤ 1 := by exact_mod_cast hht
      omega
    refine ⟨D.Yt.left.fromSpecStalk (D.xs i (IsLocalRing.closedPoint F''))
      (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _), ?_, ?_⟩
    · intro hyx
      apply hne
      have h1 : D.Yt.left.fromSpecStalk (D.xs i (IsLocalRing.closedPoint F''))
            (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _) =
          D.Yt.left.fromSpecStalk (D.xs i (IsLocalRing.closedPoint F''))
            (IsLocalRing.closedPoint
              (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))) := by
        rw [Scheme.fromSpecStalk_closedPoint]; exact hyx
      have h2 := (D.Yt.left.fromSpecStalk (D.xs i (IsLocalRing.closedPoint F''))).isEmbedding.injective h1
      exact congrArg PrimeSpectrum.asIdeal h2
    · have hc := Scheme.SpecMap_stalkMap_fromSpecStalk D.f (x := D.xs i (IsLocalRing.closedPoint F''))
      have e1 : (Spec.map (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))) ≫
          (wcP1Over F'').left.fromSpecStalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
            (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _) =
          (D.Yt.left.fromSpecStalk (D.xs i (IsLocalRing.closedPoint F'')) ≫ D.f)
            (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _) := by rw [hc]
      have e2 : D.f (D.Yt.left.fromSpecStalk (D.xs i (IsLocalRing.closedPoint F''))
            (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _)) =
          (wcP1Over F'').left.fromSpecStalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))
            ((Spec.map (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))))
              (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _)) :=
        (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.symm.trans (Scheme.Hom.comp_apply _ _ _))
      have hQ : (Spec.map (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))))
            (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _) =
          IsLocalRing.closedPoint
            ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) := by
        apply PrimeSpectrum.ext
        change Ideal.comap (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom 𝔭 =
          IsLocalRing.maximalIdeal
            ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
        have hle : IsLocalRing.maximalIdeal
            ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) ≤
            Ideal.comap (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom 𝔭 := by
          rw [hτ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
          exact hIp (Ideal.mem_span_singleton_self _)
        exact ((IsLocalRing.maximalIdeal.isMaximal _).eq_of_le
          (Ideal.IsPrime.ne_top inferInstance) hle).symm
      have e3 : (wcP1Over F'').left.fromSpecStalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))
            ((Spec.map (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))))
              (⟨𝔭, h𝔭prime⟩ : PrimeSpectrum _)) =
          D.f (D.xs i (IsLocalRing.closedPoint F'')) := by
        rw [hQ]
        exact Scheme.fromSpecStalk_closedPoint
      have e4 : D.f (D.xs i (IsLocalRing.closedPoint F'')) = D.S i (IsLocalRing.closedPoint F'') :=
        (Scheme.Hom.comp_apply (D.xs i) D.f (IsLocalRing.closedPoint F'')).symm.trans
          (by rw [D.hxs i])
      exact e2.trans (e3.trans e4)

  have s3 : ∀ (K : Type u) [Field K] (t : Spec (.of K) ⟶ (wcP1Over F'').left)
      (_ht : t (IsLocalRing.closedPoint K) = D.S i (IsLocalRing.closedPoint F''))
      {X : Scheme.{u}} (φ : X ⟶ D.Yt.left) (p : X ⟶ Spec (.of K))
      (_hsq : IsPullback φ p D.f t) (O : X.Opens)
      (_hO : ∀ z ∈ O, φ z ≠ D.xs i (IsLocalRing.closedPoint F'')),
      SmoothOfRelativeDimension (n - 1) (O.ι ≫ p) := by
    intro K _ t ht X φ p hsq O hO
    haveI hsubK : Subsingleton (Spec (.of K)) := by
      show Subsingleton (PrimeSpectrum K); infer_instance
    haveI hZLn : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) := by
      first
        | infer_instance
        | exact HasRingHomProperty.instIsZariskiLocalAtSource (P := @SmoothOfRelativeDimension n)
    haveI hZLn1 : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) := by
      first
        | infer_instance
        | exact HasRingHomProperty.instIsZariskiLocalAtSource
            (P := @SmoothOfRelativeDimension (n - 1))
    haveI hP1 := wc_p1_smooth_reldim_one F''
    have c : ∀ (V' : D.Yt.left.Opens), Smooth (V'.ι ≫ D.f) →
        SmoothOfRelativeDimension (n - 1) ((φ ⁻¹ᵁ V').ι ≫ p) := by
      intro V' hV'
      haveI := hV'
      haveI h1 : SmoothOfRelativeDimension n ((V'.ι ≫ D.f) ≫ (wcP1Over F'').hom) := by
        rw [Category.assoc, D.hf]
        exact IsZariskiLocalAtSource.comp (P := @SmoothOfRelativeDimension n) D.smooth V'.ι
      have h2 := wc_smooth_reldim_of_comp_reldim (V'.ι ≫ D.f) (wcP1Over F'').hom n 1
      have hsq' := IsPullback.paste_vert (isPullback_morphismRestrict φ V') hsq
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq' h2
    have havoid : ∀ (z : (O : Scheme.{u})) (k : Fin D.m),
        φ (O.ι z) ≠ D.xs k (IsLocalRing.closedPoint F'') := by
      intro z k hk
      have hz : O.ι z ∈ O := by
        have : O.ι z ∈ Set.range O.ι := ⟨z, rfl⟩
        rw [Scheme.Opens.range_ι] at this
        exact this
      generalize O.ι z = w at hk hz
      have h1 : D.f (φ w) = t (p w) := by
        rw [← Scheme.Hom.comp_apply φ D.f w, hsq.toCommSq.w, Scheme.Hom.comp_apply]
      have h2 : D.f (D.xs k (IsLocalRing.closedPoint F'')) = D.S k (IsLocalRing.closedPoint F'') :=
        (Scheme.Hom.comp_apply (D.xs k) D.f _).symm.trans (by rw [D.hxs k])
      have h3 : D.S k (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
        rw [← h2, ← hk, h1, Subsingleton.elim (p w) (IsLocalRing.closedPoint K), ht]
      have hki : k = i := D.hSinj h3
      rw [hki] at hk
      exact hO w hz hk
    choose Vc hyV hV using fun z => D.smooth_off _ (havoid z)
    have hcov : ⨆ z, O.ι ⁻¹ᵁ (φ ⁻¹ᵁ Vc z) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨z, hyV z⟩
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @SmoothOfRelativeDimension (n - 1)) _
      hcov (fun z => ?_)
    rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    exact IsZariskiLocalAtSource.comp (c _ (hV z)) _

  have hq : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A :=
    IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
  have ht : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      D.S i (IsLocalRing.closedPoint F'') :=
    (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun z => V.hom (e.inv z)) hq).trans hV))
  have hW : IsPullback (Limits.pullback.snd V.hom D.f) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      D.f (e.inv ≫ V.hom) := by
    refine IsPullback.of_iso (IsPullback.of_hasPullback V.hom D.f).flip (Iso.refl _) (Iso.refl _)
      e (Iso.refl _) ?_ ?_ ?_ ?_ <;> simp
  have hsq : IsPullback
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Limits.pullback.snd V.hom D.f)
      (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      D.f (wcQmSp A ≫ e.inv ≫ V.hom) :=
    (IsPullback.of_hasPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).paste_horiz hW

  haveI hP1sep : IsSeparated (wcP1Over F'').hom := by
    haveI := wc_proj_space_isProper F'' 1
    show IsSeparated (wcProjKStr F'' 1)
    infer_instance
  haveI hfc : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfprop : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  have hprop : IsProper (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) :=
    MorphismProperty.of_isPullback (P := @IsProper) hsq hfprop

  haveI := D.fconn (IsLocalRing.ResidueField A) (wcQmSp A ≫ e.inv ≫ V.hom)
  have hconn : ConnectedSpace ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) := by
    refine Function.Surjective.connectedSpace (f := ⇑hsq.isoPullback.inv) ?_
      (Scheme.Hom.continuous _)
    intro w
    refine ⟨hsq.isoPullback.hom w, ?_⟩
    rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
    rfl

  obtain ⟨hcl, -, -, huniq⟩ := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  haveI := hprop
  obtain ⟨y₀, hy₀, hy₀xs⟩ := wc_glc_closed_point_section (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs hcl
  have hφxs : (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
      Limits.pullback.snd V.hom D.f) xs = D.xs i (IsLocalRing.closedPoint F'') := by
    rw [Scheme.Hom.comp_apply, hxs, hx₂]
  refine ⟨hprop, hconn, ⟨y₀, hy₀, hy₀xs⟩, ⟨{xs}ᶜ, hcl.isOpen_compl⟩, rfl, ?_, ?_⟩
  ·
    obtain ⟨y, hyne, hfy⟩ := s2
    obtain ⟨z', hz'1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := D.f) (g := wcQmSp A ≫ e.inv ≫ V.hom) y
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) (hfy.trans ht.symm)
    have hφz : (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
        Limits.pullback.snd V.hom D.f) (hsq.isoPullback.inv z') = y := by
      rw [← Scheme.Hom.comp_apply hsq.isoPullback.inv, hsq.isoPullback_inv_fst]
      exact hz'1
    refine ⟨⟨hsq.isoPullback.inv z', fun hzx => ?_⟩⟩
    apply hyne
    rw [← hφz, show hsq.isoPullback.inv z' = xs from hzx, hφxs]
  ·
    apply s3 (IsLocalRing.ResidueField A) (wcQmSp A ≫ e.inv ≫ V.hom) ht _ _ hsq
    intro z hz hzx
    have hz' : z ∉ ({xs} : Set _) := hz
    exact hz' (huniq z ((Scheme.Hom.comp_apply _ _ _).symm.trans hzx))

theorem wc_cpfo_stalk_ker_closed_pt_base_change {W X Z Y : Scheme.{u}} {K : Type u} [Field K]
    (a : W ⟶ X) (b : W ⟶ Spec (.of K)) (g : X ⟶ Z) (h : Z ⟶ Y) (s : Spec (.of K) ⟶ Y)
    [IsClosedImmersion s] (hsq : IsPullback a b (g ≫ h) s) (w : W)
    (c : Y.presheaf.stalk (h (g (a w))))
    (hc : IsLocalRing.maximalIdeal (Y.presheaf.stalk (h (g (a w)))) = Ideal.span {c}) :
    RingHom.ker (a.stalkMap w).hom =
      Ideal.span {(g.stalkMap (a w)).hom ((h.stalkMap (g (a w))).hom c)} :=
by
  classical

  have s1 : ∀ (p : Spec (.of K)) (x : (Spec (.of K)).presheaf.stalk p),
      x ∈ IsLocalRing.maximalIdeal _ → x = 0 := by
    intro p x hx
    have hxn : ¬ IsUnit x := (IsLocalRing.mem_maximalIdeal x).mp hx
    obtain rfl : p = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    let e := (AlgebraicGeometry.stalkClosedPointIso (CommRingCat.of K)).commRingCatIsoToRingEquiv
    by_contra hne
    have hne' : e x ≠ 0 := by
      intro h0; apply hne; exact e.injective (h0.trans (map_zero e).symm)
    apply hxn
    have hu : IsUnit (e x) := hne'.isUnit
    have := hu.map e.symm
    simpa using this
  have hcm : c ∈ IsLocalRing.maximalIdeal _ := hc ▸ Ideal.mem_span_singleton_self c
  have hw := hsq.w

  have key4 : ∀ (f : W ⟶ Y) (_ : f = b ≫ s) (c' : Y.presheaf.stalk (f w)),
      c' ∈ IsLocalRing.maximalIdeal _ → (f.stalkMap w).hom c' = 0 := by
    rintro f rfl c' hc'
    have h0 := s1 (b w) ((s.stalkMap (b w)).hom c') (map_nonunit _ _ hc')
    have e2 : ((b ≫ s).stalkMap w).hom c' = (b.stalkMap w).hom ((s.stalkMap (b w)).hom c') := by
      first
        | (rw [Scheme.Hom.stalkMap_comp]; rfl)
        | simp [Scheme.Hom.stalkMap_comp]
    rw [e2, h0, map_zero]
  have s4 : (a.stalkMap w).hom ((g.stalkMap (a w)).hom ((h.stalkMap (g (a w))).hom c)) = 0 := by
    have e1 : (a.stalkMap w).hom ((g.stalkMap (a w)).hom ((h.stalkMap (g (a w))).hom c)) =
        ((a ≫ g ≫ h).stalkMap w).hom c := by
      rw [Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp]
      rfl
    rw [e1]
    exact key4 _ hw c hcm
  have hφm : (g.stalkMap (a w)).hom ((h.stalkMap (g (a w))).hom c) ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk (a w)) := by
    apply map_nonunit
    apply map_nonunit
    exact hcm
  apply le_antisymm
  swap
  · rw [Ideal.span_le, Set.singleton_subset_iff]; exact s4
  generalize hφc : (g.stalkMap (a w)).hom ((h.stalkMap (g (a w))).hom c) = φc at hφm s4 ⊢
  have hJ : Ideal.span {φc} ≠ (⊤ : Ideal (X.presheaf.stalk (a w))) := by
    intro htop
    have hle : Ideal.span {φc} ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk (a w)) := by
      rw [Ideal.span_le, Set.singleton_subset_iff]; exact hφm
    rw [htop, top_le_iff] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top hle
  haveI : Nontrivial (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}) :=
    Ideal.Quotient.nontrivial_iff.mpr hJ
  haveI : IsLocalRing (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  obtain ⟨π, hπ⟩ : ∃ π : X.presheaf.stalk (a w) ⟶
      CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}),
      π = CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {φc})) := ⟨_, rfl⟩
  have hπs : Function.Surjective π.hom := by
    rw [hπ]; exact Ideal.Quotient.mk_surjective
  haveI hπloc : IsLocalHom π.hom := IsLocalHom.of_surjective _ hπs
  have hπker : ∀ r, π.hom r = 0 → r ∈ Ideal.span {φc} := by
    intro r hr
    rw [hπ, CommRingCat.hom_ofHom] at hr
    exact Ideal.Quotient.eq_zero_iff_mem.mp hr
  have hπφ : π.hom φc = 0 := by
    rw [hπ, CommRingCat.hom_ofHom]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  let t : Spec (CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc})) ⟶ X :=
    Spec.map π ≫ X.fromSpecStalk (a w)
  let θ : Y.presheaf.stalk (h (g (a w))) ⟶
      CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}) :=
    h.stalkMap (g (a w)) ≫ g.stalkMap (a w) ≫ π
  have hθt : Spec.map θ ≫ Y.fromSpecStalk (h (g (a w))) = t ≫ g ≫ h := by
    simp only [θ, t, Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk,
      Scheme.SpecMap_stalkMap_fromSpecStalk_assoc]
  have hθ : ∀ m ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (h (g (a w)))), θ.hom m = 0 := by
    intro m hm
    rw [hc, Ideal.mem_span_singleton'] at hm
    obtain ⟨r, rfl⟩ := hm
    rw [map_mul]
    have : θ.hom c = 0 := by
      simp only [θ, CommRingCat.hom_comp, RingHom.comp_apply]
      rw [hφc]
      exact hπφ
    rw [this, mul_zero]

  have s2 : ∀ (y : Y) (_ : s (IsLocalRing.closedPoint K) = y)
      (θ : Y.presheaf.stalk y ⟶ CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc})),
      (∀ m ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y), θ.hom m = 0) →
      ∃ v : Spec (.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc})) ⟶ Spec (.of K),
        Spec.map θ ≫ Y.fromSpecStalk y = v ≫ s := by
    rintro y rfl θ hθ
    have hσdef : Scheme.stalkClosedPointTo s =
        s.stalkMap _ ≫ (stalkClosedPointIso (CommRingCat.of K)).hom := rfl
    have hσs : Function.Surjective (Scheme.stalkClosedPointTo s).hom := by
      rw [hσdef, CommRingCat.hom_comp]
      exact Function.Surjective.comp
        (g := (stalkClosedPointIso (CommRingCat.of K)).hom.hom)
        (fun x => ⟨(stalkClosedPointIso (CommRingCat.of K)).inv.hom x, by simp⟩)
        (Scheme.Hom.stalkMap_surjective s _)
    have hker : ∀ x, (Scheme.stalkClosedPointTo s).hom x = 0 → θ.hom x = 0 := by
      intro x hx
      apply hθ
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := hu.map (Scheme.stalkClosedPointTo s).hom
      rw [hx] at this
      exact not_isUnit_zero this
    let ψ := RingHom.liftOfSurjective (Scheme.stalkClosedPointTo s).hom hσs
      ⟨θ.hom, fun x hx => RingHom.mem_ker.mpr (hker x (RingHom.mem_ker.mp hx))⟩
    have hψ : ψ.comp (Scheme.stalkClosedPointTo s).hom = θ.hom :=
      RingHom.liftOfSurjective_comp _ _ _
    refine ⟨Spec.map (CommRingCat.ofHom ψ), ?_⟩
    have e := Scheme.Spec_stalkClosedPointTo_fromSpecStalk s
    have hθσ : θ = Scheme.stalkClosedPointTo s ≫ CommRingCat.ofHom ψ := by
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, hψ]
    rw [hθσ, Spec.map_comp, Category.assoc, e]
  have hy : s (IsLocalRing.closedPoint K) = h (g (a w)) := by
    have e : (b ≫ s) w = (a ≫ g ≫ h) w := by rw [hw]
    rw [Subsingleton.elim (IsLocalRing.closedPoint K) (b w)]
    exact e
  obtain ⟨v, hv⟩ := s2 _ hy θ hθ
  let ℓ := hsq.lift t v (by rw [← hθt, hv])
  have hℓ : ℓ ≫ a = t := hsq.lift_fst _ _ _
  haveI : IsClosedImmersion a :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip inferInstance
  have ha : Function.Injective a := a.isClosedEmbedding.isEmbedding.injective

  let q : Spec (CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc})) :=
    IsLocalRing.closedPoint _
  haveI hG : IsLocalHom (a.stalkMap (ℓ q) ≫ Scheme.stalkClosedPointTo ℓ).hom := by
    rw [CommRingCat.hom_comp]; infer_instance
  have hsymm : (SpecToEquivOfLocalRing X
      (CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}))).symm
        ⟨a (ℓ q), ⟨a.stalkMap (ℓ q) ≫ Scheme.stalkClosedPointTo ℓ, hG⟩⟩ =
      (SpecToEquivOfLocalRing X
      (CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}))).symm
        ⟨a w, ⟨π, hπloc⟩⟩ := by
    rw [SpecToEquivOfLocalRing_symm_apply, SpecToEquivOfLocalRing_symm_apply]
    show Spec.map (a.stalkMap (ℓ q) ≫ Scheme.stalkClosedPointTo ℓ) ≫ X.fromSpecStalk (a (ℓ q)) = t
    rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk,
      ← Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hℓ]
  have hξ := (SpecToEquivOfLocalRing X
      (CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}))).symm.injective hsymm
  have hℓq : ℓ q = w := ha (congrArg Sigma.fst hξ)
  intro r hr
  rw [RingHom.mem_ker] at hr
  apply hπker
  have claim : ∀ (w' : W) (_ : w' = w)
      (G : W.presheaf.stalk w' ⟶ CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}))
      (hG' : IsLocalHom (a.stalkMap w' ≫ G).hom),
      (⟨a w', ⟨a.stalkMap w' ≫ G, hG'⟩⟩ : (x : X) × { f : X.presheaf.stalk x ⟶
        CommRingCat.of (X.presheaf.stalk (a w) ⧸ Ideal.span {φc}) // IsLocalHom f.hom }) =
        ⟨a w, ⟨π, hπloc⟩⟩ → π.hom r = 0 := by
    rintro w' rfl G hG' heq
    rw [Sigma.mk.inj_iff] at heq
    have h2 : a.stalkMap w' ≫ G = π := congrArg Subtype.val (eq_of_heq heq.2)
    rw [← h2, CommRingCat.hom_comp, RingHom.comp_apply, hr, map_zero]
  exact claim (ℓ q) hℓq _ hG hξ

theorem wc_rl_param_quasi_regular (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (n : ℕ) (t : Fin n → R) (ht : IsLocalRing.maximalIdeal R = Ideal.span (Set.range t))
    (hdim : ringKrullDim R = n) :
    ∀ (e : ℕ) (F : MvPolynomial (Fin n) R), F.IsHomogeneous e →
      MvPolynomial.eval t F ∈ IsLocalRing.maximalIdeal R ^ (e + 1) →
      ∀ α, F.coeff α ∈ IsLocalRing.maximalIdeal R :=
by
  classical
  have hf : ∀ i, t i ∈ IsLocalRing.maximalIdeal R := fun i => ht ▸ Ideal.subset_span ⟨i, rfl⟩

  have hheight : (IsLocalRing.maximalIdeal R).height = (n : ℕ∞) := by
    have h1 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := R)
    rw [hdim] at h1
    exact_mod_cast h1
  have hge : n ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal R) := by
    have h2 := Ideal.height_le_spanFinrank (IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    rw [hheight] at h2
    exact_mod_cast h2
  have hle : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤ n := by
    rw [ht]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range t)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le (Set.toFinite _)).trans ?_
    rw [Set.ncard_univ, Nat.card_fin]

  haveI hreg : IsRegularLocalRing R :=
    IsRegularLocalRing.mk (by rw [hdim]; exact_mod_cast le_antisymm hle hge)

  have hnot : ∀ (U : Set (Fin n)) (j : Fin n), j ∉ U → t j ∉ Ideal.span (t '' U) := by
    intro U j hj h
    have hUW : U ⊆ ({j} : Set (Fin n))ᶜ := fun i hi =>
      Set.mem_compl_singleton_iff.mpr (fun h' => hj (h' ▸ hi))
    have hjJ : t j ∈ Ideal.span (t '' ({j} : Set (Fin n))ᶜ) :=
      Ideal.span_mono (Set.image_mono hUW) h
    have hmJ : IsLocalRing.maximalIdeal R = Ideal.span (t '' ({j} : Set (Fin n))ᶜ) := by
      apply le_antisymm
      · rw [ht, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        by_cases hij : i = j
        · rw [hij]; exact hjJ
        · exact Ideal.subset_span ⟨i, hij, rfl⟩
      · rw [ht]; exact Ideal.span_mono (Set.image_subset_range t _)
    have hcnt : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤ n - 1 := by
      rw [hmJ]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
      refine (Set.ncard_image_le (Set.toFinite _)).trans ?_
      rw [Set.ncard_compl ({j} : Set (Fin n)) (Set.toFinite _) (Set.toFinite _), Nat.card_fin,
        Set.ncard_singleton]
    have := j.pos
    omega

  have hdom : ∀ U : Set (Fin n), IsDomain (R ⧸ Ideal.span (t '' U)) := by
    intro U
    let eU := Finite.equivFin U
    let g : Fin (Nat.card U) → Fin n := fun i => (eU.symm i : Fin n)
    have hg : Function.Injective g := Subtype.val_injective.comp eU.symm.injective
    let x : Fin (Nat.card U) → IsLocalRing.maximalIdeal R := fun i => ⟨t (g i), hf (g i)⟩
    have hrange : Set.range (fun i => (x i : R)) = t '' U := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨g i, (eU.symm i).2, rfl⟩
      · rintro ⟨u, hu, rfl⟩
        refine ⟨eU ⟨u, hu⟩, ?_⟩
        show t ((eU.symm (eU ⟨u, hu⟩) : U) : Fin n) = t u
        rw [Equiv.symm_apply_apply]
    have L := wc_lpkt_cotangent_indep R n t ht.symm hdim hf
    have hli : LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) := L.comp g hg
    have hq := (wcpa_rs_quotient_regular R (Nat.card U) x hli).1
    have hd := wcpa_regular_isDomain _ wcpa_rs_quotient_regular hq
    rw [hrange] at hd
    exact hd

  have H : ∀ (U : Set (Fin n)) (j : Fin n), j ∉ U → ∀ s : R,
      t j * s ∈ Ideal.span (t '' U) → s ∈ Ideal.span (t '' U) := by
    intro U j hj s hs
    haveI := hdom U
    have h0 : Ideal.Quotient.mk (Ideal.span (t '' U)) (t j) *
        Ideal.Quotient.mk (Ideal.span (t '' U)) s = 0 := by
      rw [← map_mul]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hs
    rcases mul_eq_zero.mp h0 with h1 | h1
    · exact absurd (Ideal.Quotient.eq_zero_iff_mem.mp h1) (hnot U j hj)
    · exact Ideal.Quotient.eq_zero_iff_mem.mp h1
  intro e F hF hev α
  have key := wc_pfe_quasi_regular wc_pfe_hom_poly_repr R n t H e F hF
    (by rw [← ht]; exact hev)
  rw [ht]; exact key α

theorem wc_mvpoly_homogeneousComponent_mul_homog {σ : Type*} {K : Type*} [CommSemiring K]
    (φ g : MvPolynomial σ K) (m : ℕ) (hφ : φ.IsHomogeneous m) :
    (∀ j : ℕ, MvPolynomial.homogeneousComponent (m + j) (φ * g) =
        φ * MvPolynomial.homogeneousComponent j g) ∧
    (∀ i : ℕ, i < m → MvPolynomial.homogeneousComponent i (φ * g) = 0) :=
by
  have s2 : ∀ n : ℕ, MvPolynomial.homogeneousComponent n (φ * g) =
      ∑ k ∈ Finset.range (g.totalDegree + 1),
        (if n = m + k then φ * MvPolynomial.homogeneousComponent k g else 0) := by
    intro n
    have hg := MvPolynomial.sum_homogeneousComponent g
    calc MvPolynomial.homogeneousComponent n (φ * g)
        = MvPolynomial.homogeneousComponent n (φ * ∑ k ∈ Finset.range (g.totalDegree + 1),
            MvPolynomial.homogeneousComponent k g) := by rw [hg]
      _ = _ := by
        rw [Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule (m + k) _).mpr
            (hφ.mul (MvPolynomial.homogeneousComponent_isHomogeneous k g)))]
  refine ⟨fun j => ?_, fun i hi => ?_⟩
  · rw [s2, Finset.sum_eq_single j]
    · simp
    · intro k _ hkj
      rw [if_neg (by omega)]
    · intro hj
      rw [Finset.mem_range] at hj
      rw [if_pos rfl, MvPolynomial.homogeneousComponent_eq_zero j g (by omega), mul_zero]
  · rw [s2]
    exact Finset.sum_eq_zero (fun k _ => if_neg (by omega))

theorem wc_odp_hypersurface_quotient_isDomain (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (d : ℕ) (hd : 1 ≤ d) (t : Fin (d + 1 + 1) → R) (h : R)
    (M : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) R)
    (ht : IsLocalRing.maximalIdeal R = Ideal.span (Set.range t))
    (hcub : h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3)
    (hdet : IsUnit (M + M.transpose).det)
    (hQR : ∀ (e : ℕ) (F : MvPolynomial (Fin (d + 1 + 1)) R), F.IsHomogeneous e →
      MvPolynomial.eval t F ∈ IsLocalRing.maximalIdeal R ^ (e + 1) →
      ∀ α, F.coeff α ∈ IsLocalRing.maximalIdeal R)
    (hHC : ∀ (φ g : MvPolynomial (Fin (d + 1 + 1)) (IsLocalRing.ResidueField R)) (m : ℕ),
      φ.IsHomogeneous m →
      (∀ j : ℕ, MvPolynomial.homogeneousComponent (m + j) (φ * g) =
          φ * MvPolynomial.homogeneousComponent j g) ∧
      (∀ i : ℕ, i < m → MvPolynomial.homogeneousComponent i (φ * g) = 0)) :
    IsDomain (R ⧸ Ideal.span {h}) :=
by
  classical

  have hquad : ∀ (K : Type u) [Field K] (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K),
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 →
      Prime (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
        MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) :
          MvPolynomial (Fin (d + 1 + 1)) K) := by
    intro K _ a ha
    set G : MvPolynomial (Fin (d + 1 + 1)) K := ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
        MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) with hGdef
    have hG : G = ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
        MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) := rfl
    have hGh : G.IsHomogeneous 2 :=
      MvPolynomial.IsHomogeneous.sum _ _ _ fun p _ =>
        MvPolynomial.IsHomogeneous.sum _ _ _ fun q _ =>
          MvPolynomial.IsHomogeneous.C_mul
            ((MvPolynomial.isHomogeneous_X K p).mul (MvPolynomial.isHomogeneous_X K q)) _
    have s1 : ∀ l m : Fin (d + 1 + 1) → K,
        (Matrix.of fun i j : Fin (d + 1 + 1) => l i * m j + m i * l j).det = 0 := by
      intro l m
      let φ := (Matrix.of ![l, m]).mulVecLin
      have hlt : Module.finrank K (Fin 2 → K) < Module.finrank K (Fin (d + 1 + 1) → K) := by
        simp only [Module.finrank_fin_fun]; omega
      have hker := LinearMap.ker_ne_bot_of_finrank_lt (f := φ) hlt
      obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).mp hker
      rw [LinearMap.mem_ker] at hv
      have hA : l ⬝ᵥ v = 0 := by
        have := congrFun hv 0
        simpa [φ, Matrix.mulVec] using this
      have hB : m ⬝ᵥ v = 0 := by
        have := congrFun hv 1
        simpa [φ, Matrix.mulVec] using this
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨v, hv0, ?_⟩
      ext i
      have : (Matrix.of fun i j : Fin (d + 1 + 1) => l i * m j + m i * l j).mulVec v i =
          l i * (m ⬝ᵥ v) + m i * (l ⬝ᵥ v) := by
        simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, add_mul, Finset.sum_add_distrib,
          Finset.mul_sum, mul_assoc]
      rw [this, hA, hB]
      simp
    have s2 : ∀ i j : Fin (d + 1 + 1), MvPolynomial.pderiv i (MvPolynomial.pderiv j G) =
        MvPolynomial.C (a i j + a j i) := by
      intro i j
      have hm : ∀ p q : Fin (d + 1 + 1), MvPolynomial.pderiv j
          (MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) :
            MvPolynomial (Fin (d + 1 + 1)) K) =
          (if p = j then MvPolynomial.C (a p q) * MvPolynomial.X q else 0) +
            (if q = j then MvPolynomial.C (a p q) * MvPolynomial.X p else 0) := by
        intro p q
        rw [MvPolynomial.pderiv_C_mul, Derivation.leibniz, MvPolynomial.pderiv_X,
          MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
        by_cases hp : p = j <;> by_cases hq : q = j <;> simp [hp, hq] <;> ring
      have h1 : MvPolynomial.pderiv j G
          = ∑ q, MvPolynomial.C (a j q) * MvPolynomial.X q +
            ∑ p, MvPolynomial.C (a p j) * MvPolynomial.X p := by
        rw [hG]
        simp only [map_sum, hm, Finset.sum_add_distrib]
        congr 1
        · rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun q _ => ?_)
          rw [Finset.sum_ite_eq' Finset.univ j
            (fun p => MvPolynomial.C (a p q) * MvPolynomial.X q)]
          simp
        · refine Finset.sum_congr rfl (fun p _ => ?_)
          rw [Finset.sum_ite_eq' Finset.univ j
            (fun q => MvPolynomial.C (a p q) * MvPolynomial.X p)]
          simp
      have hlin : ∀ b : Fin (d + 1 + 1) → K, MvPolynomial.pderiv i
          (∑ q, MvPolynomial.C (b q) * MvPolynomial.X q : MvPolynomial (Fin (d + 1 + 1)) K) =
            MvPolynomial.C (b i) := by
        intro b
        simp only [map_sum, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, Pi.single_apply,
          mul_ite, mul_one, mul_zero]
        rw [Finset.sum_ite_eq' Finset.univ i (fun q => MvPolynomial.C (b q))]
        simp
      rw [h1, map_add, hlin (fun q => a j q), hlin (fun p => a p j), map_add]
      exact add_comm _ _
    have s3 : ∀ f : MvPolynomial (Fin (d + 1 + 1)) K, f.totalDegree ≤ 1 → ∀ j,
        MvPolynomial.pderiv j f = MvPolynomial.C (f.coeff (Finsupp.single j 1)) := by
      intro f hf j
      ext m
      rw [MvPolynomial.coeff_pderiv, MvPolynomial.coeff_C]
      split_ifs with hm
      · subst hm; simp
      · rw [MvPolynomial.coeff_eq_zero_of_totalDegree_lt, zero_mul]
        have h1 : Finsupp.degree m ≠ 0 := fun h => hm ((Finsupp.degree_eq_zero_iff m).mp h).symm
        have h2 : Finsupp.degree (m + Finsupp.single j 1) = Finsupp.degree m + 1 := by
          rw [map_add, Finsupp.degree_single]
        rw [← Finsupp.degree_apply, h2]
        omega
    have s4 : ∀ f g : MvPolynomial (Fin (d + 1 + 1)) K, ¬ IsUnit f → ¬ IsUnit g →
        f * g ≠ 0 → (f * g).totalDegree ≤ 2 → f.totalDegree ≤ 1 ∧ g.totalDegree ≤ 1 := by
      intro f g hfu hgu h0 h2
      have hf0 : f ≠ 0 := by rintro rfl; simp at h0
      have hg0 : g ≠ 0 := by rintro rfl; simp at h0
      rw [MvPolynomial.totalDegree_mul_of_isDomain hf0 hg0] at h2
      have key : ∀ h : MvPolynomial (Fin (d + 1 + 1)) K, h ≠ 0 → ¬ IsUnit h →
          h.totalDegree ≠ 0 := by
        intro h hh0 hhu hdeg
        apply hhu
        rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at hdeg
        have hc : h.coeff 0 ≠ 0 := by
          intro hc; rw [hc, MvPolynomial.C_0] at hdeg; exact hh0 hdeg
        rw [hdeg]
        exact (isUnit_iff_ne_zero.mpr hc).map MvPolynomial.C
      have := key f hf0 hfu
      have := key g hg0 hgu
      omega
    have K1 : (∀ i j : Fin (d + 1 + 1), MvPolynomial.pderiv i (MvPolynomial.pderiv j G) = 0) →
        False := by
      intro h
      apply ha
      have hS : Matrix.of a + (Matrix.of a).transpose = 0 := by
        ext i j
        have e := h i j
        rw [s2, MvPolynomial.C_eq_zero] at e
        simpa [Matrix.add_apply] using e
      rw [hS]
      exact Matrix.det_zero
    have hG0 : G ≠ 0 := by
      intro h0
      exact K1 (fun i j => by rw [h0, map_zero, map_zero])
    have hGu : ¬ IsUnit G := by
      intro hu
      obtain ⟨r, -, hr⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
      exact K1 (fun i j => by rw [hr, MvPolynomial.pderiv_C, map_zero])
    rw [← UniqueFactorizationMonoid.irreducible_iff_prime]
    refine irreducible_iff.mpr ⟨hGu, fun f g hfg => ?_⟩
    by_contra hcon
    rw [not_or] at hcon
    obtain ⟨hfu, hgu⟩ := hcon
    have h0 : f * g ≠ 0 := hfg ▸ hG0
    have h2 : (f * g).totalDegree ≤ 2 := by rw [← hfg, hGh.totalDegree hG0]
    obtain ⟨hf1, hg1⟩ := s4 f g hfu hgu h0 h2
    set lam : Fin (d + 1 + 1) → K := fun k => f.coeff (Finsupp.single k 1) with hlam
    set mu : Fin (d + 1 + 1) → K := fun k => g.coeff (Finsupp.single k 1) with hmu
    have hfd : ∀ k, MvPolynomial.pderiv k f = MvPolynomial.C (lam k) := fun k => s3 f hf1 k
    have hgd : ∀ k, MvPolynomial.pderiv k g = MvPolynomial.C (mu k) := fun k => s3 g hg1 k
    have hij : ∀ i j : Fin (d + 1 + 1), a i j + a j i = lam i * mu j + mu i * lam j := by
      intro i j
      have e := s2 i j
      rw [hfg] at e
      simp only [Derivation.leibniz, map_add, hfd, hgd, MvPolynomial.pderiv_C, smul_eq_mul,
        mul_zero, zero_add] at e
      have e' : MvPolynomial.C (lam i * mu j + mu i * lam j) =
          (MvPolynomial.C (a i j + a j i) : MvPolynomial (Fin (d + 1 + 1)) K) := by
        simp only [map_add, map_mul]; rw [← e]; ring
      exact (MvPolynomial.C_injective (Fin (d + 1 + 1)) K e').symm
    have hS : Matrix.of a + (Matrix.of a).transpose =
        Matrix.of fun i j : Fin (d + 1 + 1) => lam i * mu j + mu i * lam j := by
      ext i j
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply]
      exact hij i j
    rw [hS] at ha
    exact ha (s1 lam mu)

  have hrep : ∀ (I : Ideal R) (n : ℕ) (z : R), z ∈ I * Ideal.span (Set.range t) ^ n ↔
      ∃ G : MvPolynomial (Fin (d + 1 + 1)) R, G.IsHomogeneous n ∧ (∀ α, G.coeff α ∈ I) ∧
        MvPolynomial.eval t G = z := by
    intro I n z
    constructor
    · intro hz
      induction n generalizing z with
      | zero =>
        rw [pow_zero, mul_one] at hz
        refine ⟨MvPolynomial.C z, MvPolynomial.isHomogeneous_C _ _, fun α => ?_,
          MvPolynomial.eval_C _⟩
        rw [MvPolynomial.coeff_C]
        split_ifs
        · exact hz
        · exact I.zero_mem
      | succ n ih =>
        rw [pow_succ, ← mul_assoc] at hz
        refine Submodule.mul_induction_on
          (C := fun w => ∃ G : MvPolynomial (Fin (d + 1 + 1)) R, G.IsHomogeneous (n + 1) ∧
            (∀ α, G.coeff α ∈ I) ∧ MvPolynomial.eval t G = w) hz ?_ ?_
        · intro u hu v hv
          obtain ⟨Gu, hGu, hcu, heu⟩ := ih u hu
          obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hv
          refine ⟨∑ i, MvPolynomial.C (c i) * (MvPolynomial.X i * Gu), ?_, ?_, ?_⟩
          · apply MvPolynomial.IsHomogeneous.sum
            intro i _
            have h1 : (MvPolynomial.X i * Gu).IsHomogeneous (1 + n) :=
              (MvPolynomial.isHomogeneous_X R i).mul hGu
            rw [show 1 + n = n + 1 from Nat.add_comm 1 n] at h1
            exact h1.C_mul _
          · intro α
            rw [MvPolynomial.coeff_sum]
            apply Ideal.sum_mem
            intro i _
            rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_mul']
            apply Ideal.mul_mem_left
            split_ifs
            · exact hcu _
            · exact I.zero_mem
          · rw [map_sum]
            simp only [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, heu]
            rw [← hc, Finset.mul_sum]
            exact Finset.sum_congr rfl fun i _ => by ring
        · rintro a b ⟨Ga, hGa, hca, hea⟩ ⟨Gb, hGb, hcb, heb⟩
          refine ⟨Ga + Gb, hGa.add hGb, fun α => ?_, by rw [map_add, hea, heb]⟩
          rw [MvPolynomial.coeff_add]
          exact I.add_mem (hca α) (hcb α)
    · rintro ⟨G, hG, hc, rfl⟩
      rw [MvPolynomial.eval_eq']
      apply Ideal.sum_mem
      intro α hα
      apply Ideal.mul_mem_mul (hc α)
      have hdeg : ∑ i, α i = n := by
        have h1 : Finsupp.degree α = n := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hα) (hG.coeff_eq_zero hne)
        rwa [Finsupp.degree_eq_sum] at h1
      rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
      apply Ideal.prod_mem_prod
      intro i _
      exact Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _

  have hmem : ∀ (e : ℕ) (G : MvPolynomial (Fin (d + 1 + 1)) R), G.IsHomogeneous e →
      MvPolynomial.eval t G ∈ IsLocalRing.maximalIdeal R ^ e := by
    intro e G hG
    have := (hrep ⊤ e _).mpr ⟨G, hG, fun _ => Submodule.mem_top, rfl⟩
    rwa [Ideal.top_mul, ← ht] at this
  have hrepr : ∀ (e : ℕ) (z : R), z ∈ IsLocalRing.maximalIdeal R ^ e →
      ∃ G : MvPolynomial (Fin (d + 1 + 1)) R, G.IsHomogeneous e ∧ MvPolynomial.eval t G = z := by
    intro e z hz
    rw [← Ideal.top_mul (IsLocalRing.maximalIdeal R ^ e), ht] at hz
    obtain ⟨G, hG, -, hGe⟩ := (hrep ⊤ e z).mp hz
    exact ⟨G, hG, hGe⟩
  have hdetect : ∀ (e : ℕ) (G : MvPolynomial (Fin (d + 1 + 1)) R), G.IsHomogeneous e →
      (MvPolynomial.map (IsLocalRing.residue R) G = 0 ↔
        MvPolynomial.eval t G ∈ IsLocalRing.maximalIdeal R ^ (e + 1)) := by
    intro e G hG
    constructor
    · intro h0
      have hc : ∀ α, G.coeff α ∈ IsLocalRing.maximalIdeal R := by
        intro α
        have := congrArg (fun p : MvPolynomial (Fin (d + 1 + 1)) (IsLocalRing.ResidueField R) =>
          p.coeff α) h0
        simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at this
        exact (IsLocalRing.residue_eq_zero_iff _).mp this
      have := (hrep (IsLocalRing.maximalIdeal R) e _).mpr ⟨G, hG, hc, rfl⟩
      rwa [← ht, ← pow_succ'] at this
    · intro hin
      have hc := hQR e G hG hin
      ext α
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_zero]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr (hc α)

  have hQh : (∑ a, ∑ c, MvPolynomial.C (M a c) * (MvPolynomial.X a * MvPolynomial.X c) :
      MvPolynomial (Fin (d + 1 + 1)) R).IsHomogeneous 2 :=
    MvPolynomial.IsHomogeneous.sum _ _ _ fun p _ =>
      MvPolynomial.IsHomogeneous.sum _ _ _ fun q _ =>
        MvPolynomial.IsHomogeneous.C_mul
          ((MvPolynomial.isHomogeneous_X R p).mul (MvPolynomial.isHomogeneous_X R q)) _
  have hQe : MvPolynomial.eval t (∑ a, ∑ c, MvPolynomial.C (M a c) *
      (MvPolynomial.X a * MvPolynomial.X c) : MvPolynomial (Fin (d + 1 + 1)) R) =
      ∑ a, ∑ c, M a c * t a * t c := by
    simp only [map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, mul_assoc]
  have hh2 : h ∈ IsLocalRing.maximalIdeal R ^ 2 := by
    have h32 : IsLocalRing.maximalIdeal R ^ 3 ≤ IsLocalRing.maximalIdeal R ^ 2 :=
      Ideal.pow_le_pow_right (by norm_num)
    have := Ideal.add_mem _ (h32 hcub) (hmem 2 _ hQh)
    rwa [hQe, sub_add_cancel] at this
  obtain ⟨Gh, hGh, hGhe⟩ := hrepr 2 h hh2
  have hmapGh : MvPolynomial.map (IsLocalRing.residue R) Gh =
      MvPolynomial.map (IsLocalRing.residue R) (∑ a, ∑ c, MvPolynomial.C (M a c) *
        (MvPolynomial.X a * MvPolynomial.X c) : MvPolynomial (Fin (d + 1 + 1)) R) := by
    have h0 := (hdetect 2 _ (hGh.sub hQh)).mpr (by rw [map_sub, hGhe, hQe]; exact hcub)
    rwa [map_sub, sub_eq_zero] at h0
  have hmapQ : MvPolynomial.map (IsLocalRing.residue R) (∑ a, ∑ c, MvPolynomial.C (M a c) *
        (MvPolynomial.X a * MvPolynomial.X c) : MvPolynomial (Fin (d + 1 + 1)) R) =
      ∑ p, ∑ q, MvPolynomial.C ((fun p q => IsLocalRing.residue R (M p q)) p q) *
        (MvPolynomial.X p * MvPolynomial.X q) := by
    simp only [map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
  have hnd : (Matrix.of (fun p q => IsLocalRing.residue R (M p q)) +
      (Matrix.of (fun p q => IsLocalRing.residue R (M p q))).transpose).det ≠ 0 := by
    have e : Matrix.of (fun p q => IsLocalRing.residue R (M p q)) +
        (Matrix.of (fun p q => IsLocalRing.residue R (M p q))).transpose =
        (M + M.transpose).map (IsLocalRing.residue R) := by
      ext p q; simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [e, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (hdet.map (IsLocalRing.residue R)).ne_zero
  have hprime : Prime (MvPolynomial.map (IsLocalRing.residue R) Gh) := by
    rw [hmapGh, hmapQ]
    exact hquad _ (fun p q => IsLocalRing.residue R (M p q)) hnd
  have hqh : (MvPolynomial.map (IsLocalRing.residue R) Gh).IsHomogeneous 2 :=
    hGh.map (IsLocalRing.residue R)

  have hred : ∀ x : R, x ∉ Ideal.span {h} → ∃ (y : R) (e : ℕ)
      (G : MvPolynomial (Fin (d + 1 + 1)) R), G.IsHomogeneous e ∧
      MvPolynomial.eval t G = x - h * y ∧ MvPolynomial.map (IsLocalRing.residue R) G ≠ 0 ∧
      ¬ (MvPolynomial.map (IsLocalRing.residue R) Gh ∣
        MvPolynomial.map (IsLocalRing.residue R) G) := by
    intro x hx
    have hKr := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := R ⧸ Ideal.span {h})
      (IsLocalRing.maximalIdeal R) (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hx0 : (Ideal.Quotient.mk (Ideal.span {h}) x) ≠ 0 := by
      rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
    have hn0 : ∃ n, (Ideal.Quotient.mk (Ideal.span {h}) x) ∉
        IsLocalRing.maximalIdeal R ^ n • (⊤ : Submodule R (R ⧸ Ideal.span {h})) := by
      by_contra hcon
      push_neg at hcon
      apply hx0
      have : Ideal.Quotient.mk (Ideal.span {h}) x ∈
          ⨅ i, IsLocalRing.maximalIdeal R ^ i • (⊤ : Submodule R (R ⧸ Ideal.span {h})) :=
        (Submodule.mem_iInf _).mpr hcon
      rw [hKr] at this
      exact (Submodule.mem_bot R).mp this
    obtain ⟨n₀, hn₀⟩ := hn0
    have hPex : ∃ n, ∀ y : R, x - h * y ∉ IsLocalRing.maximalIdeal R ^ n := by
      refine ⟨n₀, fun y hy => hn₀ ?_⟩
      have e1 : Ideal.Quotient.mk (Ideal.span {h}) x =
          (x - h * y) • (Ideal.Quotient.mk (Ideal.span {h}) 1) := by
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul, mul_one,
          Ideal.Quotient.eq, sub_sub_cancel]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self h)
      rw [e1]
      exact Submodule.smul_mem_smul hy Submodule.mem_top
    have hn₁ : ∀ y, x - h * y ∉ IsLocalRing.maximalIdeal R ^ (Nat.find hPex) :=
      Nat.find_spec hPex
    have hn₁0 : Nat.find hPex ≠ 0 := by
      intro h0
      apply hn₁ 0
      rw [h0, pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    obtain ⟨e, he⟩ := Nat.exists_eq_succ_of_ne_zero hn₁0
    have hmin := Nat.find_min hPex (show e < Nat.find hPex by omega)
    push_neg at hmin
    obtain ⟨y, hy⟩ := hmin
    rw [he] at hn₁
    obtain ⟨G, hG, hGe⟩ := hrepr e _ hy
    have hG0 : MvPolynomial.map (IsLocalRing.residue R) G ≠ 0 := by
      intro h0
      have := (hdetect e G hG).mp h0
      rw [hGe] at this
      exact hn₁ y this
    refine ⟨y, e, G, hG, hGe, hG0, ?_⟩
    rintro ⟨g, hg⟩
    have hGm : (MvPolynomial.map (IsLocalRing.residue R) G).IsHomogeneous e :=
      hG.map (IsLocalRing.residue R)
    have hce : MvPolynomial.homogeneousComponent e (MvPolynomial.map (IsLocalRing.residue R) G) =
        MvPolynomial.map (IsLocalRing.residue R) G := by
      rw [MvPolynomial.homogeneousComponent_of_mem
        ((MvPolynomial.mem_homogeneousSubmodule e _).mpr hGm), if_pos rfl]
    rcases lt_or_ge e 2 with hlt | hge
    · apply hG0
      rw [← hce, hg]
      exact (hHC _ g 2 hqh).2 e hlt
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hge
      have hsh : MvPolynomial.map (IsLocalRing.residue R) G =
          MvPolynomial.map (IsLocalRing.residue R) Gh * MvPolynomial.homogeneousComponent j g := by
        rw [← hce, hg]; exact (hHC _ g 2 hqh).1 j
      obtain ⟨G₀, hG₀⟩ := MvPolynomial.map_surjective (IsLocalRing.residue R)
        IsLocalRing.residue_surjective (MvPolynomial.homogeneousComponent j g)
      have hG'h : (MvPolynomial.homogeneousComponent j G₀).IsHomogeneous j :=
        MvPolynomial.homogeneousComponent_isHomogeneous j G₀
      have hmapG' : MvPolynomial.map (IsLocalRing.residue R)
          (MvPolynomial.homogeneousComponent j G₀) = MvPolynomial.homogeneousComponent j g := by
        have e2 : MvPolynomial.map (IsLocalRing.residue R)
            (MvPolynomial.homogeneousComponent j G₀) = MvPolynomial.homogeneousComponent j
              (MvPolynomial.map (IsLocalRing.residue R) G₀) := by
          ext α
          simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
          split_ifs <;> simp
        rw [e2, hG₀, MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule j _).mpr
            (MvPolynomial.homogeneousComponent_isHomogeneous j g)), if_pos rfl]
      have hH : (G - Gh * MvPolynomial.homogeneousComponent j G₀).IsHomogeneous (2 + j) :=
        hG.sub (hGh.mul hG'h)
      have hHm : MvPolynomial.map (IsLocalRing.residue R)
          (G - Gh * MvPolynomial.homogeneousComponent j G₀) = 0 := by
        rw [map_sub, map_mul, hmapG', hsh, sub_self]
      have hin := (hdetect _ _ hH).mp hHm
      apply hn₁ (y + MvPolynomial.eval t (MvPolynomial.homogeneousComponent j G₀))
      have : MvPolynomial.eval t (G - Gh * MvPolynomial.homogeneousComponent j G₀) =
          x - h * (y + MvPolynomial.eval t (MvPolynomial.homogeneousComponent j G₀)) := by
        rw [map_sub, map_mul, hGe, hGhe]; ring
      rwa [← this]

  have hord : ∀ c : R, c ≠ 0 → ∃ e, c ∈ IsLocalRing.maximalIdeal R ^ e ∧
      c ∉ IsLocalRing.maximalIdeal R ^ (e + 1) := by
    intro c hc
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hex : ∃ n, c ∉ IsLocalRing.maximalIdeal R ^ n := by
      by_contra hcon
      push_neg at hcon
      apply hc
      have : c ∈ ⨅ i, IsLocalRing.maximalIdeal R ^ i := (Submodule.mem_iInf _).mpr hcon
      rw [hK] at this
      exact (Submodule.mem_bot R).mp this
    have hn0 : Nat.find hex ≠ 0 := by
      intro h0
      have := Nat.find_spec hex
      rw [h0, pow_zero, Ideal.one_eq_top] at this
      exact this Submodule.mem_top
    obtain ⟨e, he⟩ := Nat.exists_eq_succ_of_ne_zero hn0
    refine ⟨e, ?_, ?_⟩
    · have := Nat.find_min hex (show e < Nat.find hex by omega)
      push_neg at this
      exact this
    · have := Nat.find_spec hex
      rwa [he] at this

  have hq0 : MvPolynomial.map (IsLocalRing.residue R) Gh ≠ 0 := hprime.ne_zero
  have hle : Ideal.span {h} ≤ IsLocalRing.maximalIdeal R := by
    rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.pow_le_self two_ne_zero hh2
  have hP : (Ideal.span {h}).IsPrime := by
    rw [Ideal.isPrime_iff]
    refine ⟨fun htop => ?_, ?_⟩
    · rw [htop] at hle
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp hle)
    intro a b hab
    by_contra hcon
    push_neg at hcon
    obtain ⟨ha, hb⟩ := hcon
    obtain ⟨y₁, e₁, G₁, hG₁, hG₁e, hG₁0, hG₁d⟩ := hred a ha
    obtain ⟨y₂, e₂, G₂, hG₂, hG₂e, hG₂0, hG₂d⟩ := hred b hb
    have hab' : (a - h * y₁) * (b - h * y₂) ∈ Ideal.span {h} := by
      have e : (a - h * y₁) * (b - h * y₂) = a * b - h * (y₁ * b + y₂ * a - h * y₁ * y₂) := by
        ring
      rw [e]
      exact Ideal.sub_mem _ hab (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self h))
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hab'
    have hD1h : (G₁ * G₂).IsHomogeneous (e₁ + e₂) := hG₁.mul hG₂
    have hD1e : MvPolynomial.eval t (G₁ * G₂) = (a - h * y₁) * (b - h * y₂) := by
      rw [map_mul, hG₁e, hG₂e]
    have hD1m : MvPolynomial.map (IsLocalRing.residue R) (G₁ * G₂) ≠ 0 := by
      rw [map_mul]; exact mul_ne_zero hG₁0 hG₂0
    have hw1 : (a - h * y₁) * (b - h * y₂) ∉ IsLocalRing.maximalIdeal R ^ (e₁ + e₂ + 1) := by
      intro hin
      rw [← hD1e] at hin
      exact hD1m ((hdetect _ _ hD1h).mpr hin)
    have hw0 : (a - h * y₁) * (b - h * y₂) ≠ 0 := by
      intro h0
      rw [h0] at hw1
      exact hw1 (Submodule.zero_mem _)
    have hc0 : c ≠ 0 := by
      rintro rfl
      apply hw0
      rw [← hc, zero_mul]
    obtain ⟨e₃, hc3, hc3'⟩ := hord c hc0
    obtain ⟨G₃, hG₃, hG₃e⟩ := hrepr e₃ c hc3
    have hG₃0 : MvPolynomial.map (IsLocalRing.residue R) G₃ ≠ 0 := by
      intro h0
      have := (hdetect _ _ hG₃).mp h0
      rw [hG₃e] at this
      exact hc3' this
    have hD2h : (Gh * G₃).IsHomogeneous (2 + e₃) := hGh.mul hG₃
    have hD2e : MvPolynomial.eval t (Gh * G₃) = (a - h * y₁) * (b - h * y₂) := by
      rw [map_mul, hGhe, hG₃e, mul_comm, hc]
    have hD2m : MvPolynomial.map (IsLocalRing.residue R) (Gh * G₃) ≠ 0 := by
      rw [map_mul]; exact mul_ne_zero hq0 hG₃0
    have hw2 : (a - h * y₁) * (b - h * y₂) ∉ IsLocalRing.maximalIdeal R ^ (2 + e₃ + 1) := by
      intro hin
      rw [← hD2e] at hin
      exact hD2m ((hdetect _ _ hD2h).mpr hin)
    have hwm1 : (a - h * y₁) * (b - h * y₂) ∈ IsLocalRing.maximalIdeal R ^ (e₁ + e₂) := by
      rw [← hD1e]; exact hmem _ _ hD1h
    have hwm2 : (a - h * y₁) * (b - h * y₂) ∈ IsLocalRing.maximalIdeal R ^ (2 + e₃) := by
      rw [← hD2e]; exact hmem _ _ hD2h
    have hDeq : e₁ + e₂ = 2 + e₃ := by
      rcases lt_trichotomy (e₁ + e₂) (2 + e₃) with hlt | heq | hgt
      · exact absurd (Ideal.pow_le_pow_right (by omega) hwm2) hw1
      · exact heq
      · exact absurd (Ideal.pow_le_pow_right (by omega) hwm1) hw2
    have hD2h' : (Gh * G₃).IsHomogeneous (e₁ + e₂) := by rw [hDeq]; exact hD2h
    have hH : (G₁ * G₂ - Gh * G₃).IsHomogeneous (e₁ + e₂) := hD1h.sub hD2h'
    have hHm := (hdetect _ _ hH).mpr (by
      rw [map_sub, hD1e, hD2e, sub_self]; exact Submodule.zero_mem _)
    rw [map_sub, sub_eq_zero, map_mul, map_mul] at hHm
    rcases hprime.dvd_or_dvd (Dvd.intro _ hHm.symm) with hd1 | hd2
    · exact hG₁d hd1
    · exact hG₂d hd2
  exact (Ideal.Quotient.isDomain_iff_prime _).mpr hP

theorem wc_pmn_tsl_odp_fibre_irred (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (h4 : 4 ≤ n) :
    IsAlgClosed (IsLocalRing.ResidueField A) ∧ ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 ∧
    IsProper (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
    IrreducibleSpace ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
    topologicalKrullDim ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) =
      ((n - 1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have hac : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  haveI := hac
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance
  haveI hSi : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  haveI hYp := D.proper
  haveI hYs := D.smooth

  obtain ⟨σ, hσdef⟩ : ∃ σ : F'' →+* IsLocalRing.ResidueField A,
      σ = (Spec.preimage ((wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom)).hom := ⟨_, rfl⟩

  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    haveI := Fintype.ofFinite F''
    have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
      intro h0
      haveI hcp : CharP F'' (ringChar F'') := ringChar.charP F''
      have hpp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
      have h1 : ringChar F'' ∣ ℓ := (CharP.cast_eq_zero_iff F'' (ringChar F'') ℓ).mp h0
      have h2 : ringChar F'' = ℓ :=
        (Nat.prime_dvd_prime_iff_eq hpp (Fact.out : ℓ.Prime)).mp h1
      have h3 : ringChar F'' ∣ Fintype.card F'' :=
        (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp (FiniteField.cast_card_eq_zero F'')
      apply hℓ
      rw [Nat.card_eq_fintype_card, ← h2]
      exact h3
    intro h0
    apply hℓF
    apply σ.injective
    rw [map_natCast, map_zero]
    exact h0

  obtain ⟨hprop, hconn, -, O, hO, hOne, hOsm⟩ :=
    wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs
  obtain ⟨hcl, -, hln, -⟩ := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs

  have hdomR : ∀ (m : ℕ), 4 ≤ m → ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      (t : Fin m → R) (h : R) (M : Matrix (Fin m) (Fin m) R), ringKrullDim R = m →
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
      IsUnit (M + M.transpose).det → IsDomain (R ⧸ Ideal.span {h}) := by
    intro m hm R _ _ _ t h M hdim hmax hcub hdet
    obtain ⟨d, rfl⟩ : ∃ d, m = d + 1 + 1 := ⟨m - 2, by omega⟩
    exact wc_odp_hypersurface_quotient_isDomain R d (by omega) t h M hmax hcub hdet
      (wc_rl_param_quasi_regular R (d + 1 + 1) t hmax hdim)
      (fun φ g m' hφ => wc_mvpoly_homogeneousComponent_mul_homog φ g m' hφ)

  have hdomxs : IsDomain ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A)).presheaf.stalk xs) := by
    have hρpt : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
        IsLocalRing.closedPoint A := by
      first
        | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
        | exact (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
        | (erw [Spec.map_apply]; exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
    have ht₀ : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
        D.S i (IsLocalRing.closedPoint F'') :=
      (congrArg (fun p => V.hom (e.inv p)) hρpt).trans hV
    have e1 : Spec.map (CommRingCat.ofHom σ) = (wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom := by
      rw [hσdef]; exact Spec.map_preimage _
    have hA1 : (wcQmSp A ≫ e.inv ≫ V.hom) ≫ (wcP1Over F'').hom =
        (Spec.map (CommRingCat.ofHom σ) ≫ D.S i) ≫ (wcP1Over F'').hom := by
      rw [Category.assoc (Spec.map (CommRingCat.ofHom σ)), D.hS i, Category.comp_id, e1]
    have hA2 : (wcQmSp A ≫ e.inv ≫ V.hom) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
        (Spec.map (CommRingCat.ofHom σ) ≫ D.S i)
          (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) :=
      ht₀.trans (congrArg (D.S i) (Subsingleton.elim (α := (Spec (.of F'') : Scheme.{u}))
        (IsLocalRing.closedPoint F'') _))
    have hsurj0 : Function.Surjective
        (Scheme.Hom.residueFieldMap (wcP1Over F'').hom (D.S i (IsLocalRing.closedPoint F''))).hom := by
      have hc := Scheme.residueFieldMap_comp (D.S i) (wcP1Over F'').hom (IsLocalRing.closedPoint F'')
      have hcc := Scheme.Hom.residueFieldMap_congr (D.hS i) (IsLocalRing.closedPoint F'')
      have hid := Scheme.residueFieldMap_id (X := Spec (.of F'')) (IsLocalRing.closedPoint F'')
      first
        | (rw [hid, Category.comp_id] at hcc)
        | (erw [hid, Category.comp_id] at hcc)
        | (simp only [Scheme.residueFieldMap_id, Category.comp_id] at hcc)
      have hnt : ∀ (X : Scheme.{u}) (x : X), Nontrivial (X.residueField x) := by
        intro X x
        first
          | infer_instance
          | exact inferInstanceAs (Nontrivial (IsLocalRing.ResidueField (X.presheaf.stalk x)))
          | exact (inferInstance : Field (X.residueField x)).toNontrivial
          | exact (inferInstanceAs (Field (IsLocalRing.ResidueField (X.presheaf.stalk x)))).toNontrivial
      haveI : Nontrivial ((Spec (.of F'')).residueField (IsLocalRing.closedPoint F'')) :=
        hnt _ _
      have hinj : Function.Injective
          (Scheme.Hom.residueFieldMap (D.S i) (IsLocalRing.closedPoint F'')).hom :=
        RingHom.injective _
      have gen : ∀ {K1 K2 K3 : CommRingCat.{u}} (a : K1 ⟶ K2) (b : K2 ⟶ K3) (c : K1 ≅ K3),
          c.hom = a ≫ b → Function.Injective b.hom → Function.Surjective a.hom := by
        intro K1 K2 K3 a b c hcab hb y
        refine ⟨c.inv.hom (b.hom y), hb ?_⟩
        have h1 : (c.inv ≫ c.hom).hom (b.hom y) = b.hom y := by rw [c.inv_hom_id]; rfl
        rw [hcab] at h1
        exact h1
      exact gen _ _ _ (hcc.symm.trans hc) hinj
    have cancel : ∀ {X X' Z : Scheme.{u}} (r : X ⟶ X') (s : X' ⟶ X) (f g : X ⟶ Z),
        r ≫ s = 𝟙 _ → s ≫ f = s ≫ g → f = g := by
      intro X X' Z r s f g h hsf
      calc f = (r ≫ s) ≫ f := by rw [h, Category.id_comp]
        _ = r ≫ (s ≫ f) := Category.assoc _ _ _
        _ = r ≫ (s ≫ g) := by rw [hsf]
        _ = (r ≫ s) ≫ g := (Category.assoc _ _ _).symm
        _ = g := by rw [h, Category.id_comp]
    have hfac : wcQmSp A ≫ e.inv ≫ V.hom = Spec.map (CommRingCat.ofHom σ) ≫ D.S i := by
      have hd := wc_spec_residue_maps_eq_of_surj (wcP1Over F'').hom (wcQmSp A ≫ e.inv ≫ V.hom)
        (Spec.map (CommRingCat.ofHom σ) ≫ D.S i) hA1 _ hA2 (by rw [ht₀]; exact hsurj0)
      have hr := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField
        (IsLocalRing.ResidueField A) (Spec (.of (IsLocalRing.ResidueField A))) (𝟙 _)
      exact cancel _ _ _ _ hr hd
    have Sq1 := IsPullback.of_hasPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
    have B : IsPullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (Limits.pullback.snd V.hom D.f)
        (e.inv ≫ V.hom) D.f :=
      IsPullback.of_iso (IsPullback.of_hasPullback V.hom D.f) (Iso.refl _) e (Iso.refl _)
        (Iso.refl _) (by simp) (by simp) (by simp) (by simp)
    have Big := Sq1.paste_horiz B.flip
    rw [hfac] at Big
    obtain ⟨π₁, hπ₁⟩ : ∃ π : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
          D.Yt.left,
        π = Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
          Limits.pullback.snd V.hom D.f := ⟨_, rfl⟩
    rw [← hπ₁] at Big
    have Sq3 := IsPullback.of_hasPullback D.f (D.S i)
    obtain ⟨r, hR, hr1⟩ : ∃ r : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
          Limits.pullback D.f (D.S i),
        IsPullback r (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
          (Limits.pullback.snd D.f (D.S i)) (Spec.map (CommRingCat.ofHom σ)) ∧
        r ≫ Limits.pullback.fst D.f (D.S i) = π₁ :=
      ⟨_, IsPullback.of_right' Big Sq3, IsPullback.lift_fst _ _ _ _⟩
    have hw : π₁ ≫ D.Yt.hom =
        Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ≫
          Spec.map (CommRingCat.ofHom σ) := by
      have h1 := Big.w
      rw [← D.hf, ← Category.assoc, h1, Category.assoc, Category.assoc, D.hS i, Category.comp_id]
    obtain ⟨j, hj1, hj2⟩ : ∃ j : Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) ⟶
          Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ)),
        j ≫ Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) = π₁ ∧
        j ≫ Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) =
          Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) :=
      ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hιY : Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom = Limits.pullback.snd D.f (D.S i) := by
      rw [← D.hf, ← Category.assoc, Limits.pullback.condition, Category.assoc, D.hS i,
        Category.comp_id]
    have hBot := IsPullback.of_hasPullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))
    have hOut : IsPullback r (j ≫ Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)))
        (Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom) (Spec.map (CommRingCat.ofHom σ)) := by
      rw [hj2, hιY]; exact hR
    have hB : IsPullback r j (Limits.pullback.fst D.f (D.S i))
        (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
      IsPullback.of_bot hOut (hr1.trans hj1.symm) hBot
    have hC := hB.flip.paste_vert Sq3
    haveI hjCI : IsClosedImmersion j :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hC.flip hSi
    have hpY : Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ)) (j xs) =
        D.xs i (IsLocalRing.closedPoint F'') := by
      have e2 : (j ≫ Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) xs = π₁ xs := by
        rw [hj1]
      rw [Scheme.Hom.comp_apply] at e2
      rw [e2, hπ₁, Scheme.Hom.comp_apply, hxs]
      exact hx₂
    have hyc := j.isClosedEmbedding.isClosedMap _ hcl
    rw [Set.image_singleton] at hyc
    have key : ∀ y' : D.Yt.left, y' = D.xs i (IsLocalRing.closedPoint F'') →
        ∃ (t : Fin n → D.Yt.left.presheaf.stalk y')
          (τ' : (wcP1Over F'').left.presheaf.stalk (D.f y'))
          (M : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk y')),
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') = Ideal.span (Set.range t) ∧
          IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.f y')) = Ideal.span {τ'} ∧
          (D.f.stalkMap y').hom τ' - ∑ a, ∑ c, M a c * t a * t c ∈
            IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') ^ 3 ∧
          IsUnit (M + M.transpose).det := by
      rintro _ rfl
      exact D.odp i
    obtain ⟨t, τ', M, hmt, hmτ, hcub, hdet⟩ := key _ hpY
    have hker := wc_cpfo_stalk_ker_closed_pt_base_change j
      (r ≫ Limits.pullback.snd D.f (D.S i))
      (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) D.f (D.S i) hC xs τ' hmτ
    haveI hqYs : SmoothOfRelativeDimension n (Limits.pullback.snd D.Yt.hom
        (Spec.map (CommRingCat.ofHom σ))) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hBot D.smooth
    haveI : LocallyOfFiniteType (Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hBot inferInstance
    haveI : IsLocallyNoetherian (Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd D.Yt.hom
        (Spec.map (CommRingCat.ofHom σ)))
    have hdim := wc_lfi_smooth_stalk_dim (IsLocalRing.ResidueField A) _ (Limits.pullback.snd D.Yt.hom
        (Spec.map (CommRingCat.ofHom σ))) n (j xs) hyc
    have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
      rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
    have hmapm := wc_lfi_rational_fibre_maxIdeal F'' (IsLocalRing.ResidueField A) σ D.Yt.left _
      D.Yt.hom (Limits.pullback.snd D.Yt.hom (Spec.map (CommRingCat.ofHom σ)))
      (Limits.pullback.fst D.Yt.hom (Spec.map (CommRingCat.ofHom σ))) hBot (D.xs i) hxsY
      (j xs) ⟨IsLocalRing.closedPoint F'', hpY.symm⟩
    obtain ⟨ρ, hρ⟩ : ∃ ρ, ρ = ((Limits.pullback.fst D.Yt.hom
        (Spec.map (CommRingCat.ofHom σ))).stalkMap (j xs)).hom := ⟨_, rfl⟩
    rw [← hρ] at hmapm hker
    have hsurj : Function.Surjective (j.stalkMap xs).hom := by
      first
        | exact j.stalkMap_surjective xs
        | exact Scheme.Hom.stalkMap_surjective j xs
        | exact SurjectiveOnStalks.stalkMap_surjective j xs
    have hmax : IsLocalRing.maximalIdeal ((Limits.pullback D.Yt.hom
        (Spec.map (CommRingCat.ofHom σ))).presheaf.stalk (j xs)) =
          Ideal.span (Set.range (fun a => ρ (t a))) := by
      rw [← hmapm, hmt, Ideal.map_span, ← Set.range_comp]
      try rfl
    have hcub' : ρ ((D.f.stalkMap _).hom τ') - ∑ a, ∑ c, (M.map ρ) a c * ρ (t a) * ρ (t c) ∈
        IsLocalRing.maximalIdeal ((Limits.pullback D.Yt.hom
          (Spec.map (CommRingCat.ofHom σ))).presheaf.stalk (j xs)) ^ 3 := by
      have e2 : ρ ((D.f.stalkMap _).hom τ') - ∑ a, ∑ c, (M.map ρ) a c * ρ (t a) * ρ (t c) =
          ρ ((D.f.stalkMap _).hom τ' - ∑ a, ∑ c, M a c * t a * t c) := by
        simp only [map_sub, map_sum, map_mul, Matrix.map_apply]
      rw [e2, ← hmapm, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem ρ hcub
    have hdet' : IsUnit (M.map ρ + (M.map ρ).transpose).det := by
      have e3 : M.map ρ + (M.map ρ).transpose = (M + M.transpose).map ρ := by
        ext a c
        simp [Matrix.map_apply, Matrix.transpose_apply]
      rw [e3, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact hdet.map ρ
    haveI := hdomR n h4
      ((Limits.pullback D.Yt.hom (Spec.map (CommRingCat.ofHom σ))).presheaf.stalk (j xs))
      (fun a => ρ (t a)) (ρ ((D.f.stalkMap _).hom τ')) (M.map ρ) (by exact_mod_cast hdim) hmax
      hcub' hdet'
    exact MulEquiv.isDomain _
      ((RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hker)).toMulEquiv

  haveI := hln
  haveI := hconn
  haveI := hOsm
  have hirr : IrreducibleSpace ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) := by
    apply wcpa_irreducible_of_connected_domain_stalks
    intro w
    by_cases hw : w = xs
    · rw [hw]; exact hdomxs
    · have hwO : w ∈ (O : Set _) := by rw [hO]; exact hw
      haveI := wcpa_smooth_stalk_isDomain (IsLocalRing.ResidueField A) (O : Scheme.{u})
        (O.ι ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (n - 1)
        ⟨w, hwO⟩
      exact MulEquiv.isDomain _
        (Scheme.Opens.stalkIso O ⟨w, hwO⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv

  have dimgen : ∀ (X : Scheme.{u}) (p : X ⟶ Spec (.of (IsLocalRing.ResidueField A))) [IsProper p]
      [IrreducibleSpace X] (U : X.Opens), Nonempty U →
      SmoothOfRelativeDimension (n - 1) (U.ι ≫ p) →
      topologicalKrullDim X = ((n - 1 : ℕ) : WithBot ℕ∞) := by
    intro X p _ _ U hUne hUsm
    haveI := hUsm
    obtain ⟨⟨w₀, hw₀⟩⟩ := hUne
    have hdense : Dense (U : Set X) := U.isOpen.dense ⟨w₀, hw₀⟩
    have hle1 := wc_dim_le_dim_dense_open_part (IsLocalRing.ResidueField A) X p Set.univ
      (U : Set X) isClosed_univ U.isOpen (by simp [hdense.closure_eq])
    have hrg : Set.range ⇑U.ι = Set.univ ∩ (U : Set X) := by
      rw [Scheme.Opens.range_ι, Set.univ_inter]
    have hdimU : topologicalKrullDim (U : Scheme.{u}) =
        topologicalKrullDim ↥(Set.univ ∩ (U : Set X)) :=
      IsHomeomorph.topologicalKrullDim_eq _
        ((U.ι.isOpenEmbedding.isEmbedding.toHomeomorph).trans (Homeomorph.setCongr hrg)).isHomeomorph
    have hX : topologicalKrullDim X = topologicalKrullDim ↥(Set.univ : Set X) :=
      (IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ X).isHomeomorph).symm
    have hleU := wc_smooth_alg_closed_dim_le (IsLocalRing.ResidueField A) (U : Scheme.{u})
      (U.ι ≫ p) (n - 1)
    haveI : IrreducibleSpace (U : Scheme.{u}) := by
      rw [irreducibleSpace_def]
      have := (IrreducibleSpace.isIrreducible_univ X).preimage U.ι.isOpenEmbedding
        ⟨w₀, trivial, by rw [Scheme.Opens.range_ι]; exact hw₀⟩
      simpa using this
    have hgeU := wc_smooth_irreducible_dim_ge (IsLocalRing.ResidueField A) (U : Scheme.{u})
      (U.ι ≫ p) (n - 1)
    apply le_antisymm
    · calc topologicalKrullDim X = topologicalKrullDim ↥(Set.univ : Set X) := hX
        _ ≤ topologicalKrullDim ↥(Set.univ ∩ (U : Set X)) := hle1
        _ = topologicalKrullDim (U : Scheme.{u}) := hdimU.symm
        _ ≤ _ := hleU
    · calc ((n - 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim (U : Scheme.{u}) := hgeU
        _ = topologicalKrullDim ↥(Set.range ⇑U.ι) :=
          IsHomeomorph.topologicalKrullDim_eq _
            (U.ι.isOpenEmbedding.isEmbedding.toHomeomorph).isHomeomorph
        _ ≤ topologicalKrullDim X := topologicalKrullDim_subspace_le _ _
  haveI := hprop
  haveI := hirr
  exact ⟨hac, hℓk, hprop, hirr, dimgen _ _ O hOne hOsm⟩

theorem wc_isp_resolution_components_meet (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [ConnectedSpace Y]
    (O : Y.Opens) (hOne : (O : Set Y) ≠ Set.univ) (N : ℕ)
    (Yb E : Scheme.{u}) (fY : Yb ⟶ Spec (.of K)) [IsProper fY] [SmoothOfRelativeDimension N fY]
    (iE : E ⟶ Yb) [IsClosedImmersion iE] (U : Yb.Opens) (hU : (U : Set Yb) = (Set.range iE)ᶜ)
    (hOU : Nonempty ((O : Scheme.{u}) ≅ (U : Scheme.{u}))) :
    ∀ C : Set Yb, IsClopen C → C.Nonempty → ¬ C ⊆ (U : Set Yb) :=
by
  classical

  have crux : ∀ (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (s₁ s₂ : Z ⟶ Spec (.of K))
      [IsProper s₁] [LocallyOfFiniteType s₂], IsProper s₂ := by
    intro Z _ s₁ s₂ _ _
    have hF : IsField Γ(Z, ⊤) := isField_of_universallyClosed K s₁
    let ι : CommRingCat.of K ⟶ Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv
    have hι : Function.Bijective ι.hom := ConcreteCategory.bijective_of_isIso ι
    let a₁ : K →+* Γ(Z, ⊤) := s₁.appTop.hom.comp ι.hom
    let a₂ : K →+* Γ(Z, ⊤) := s₂.appTop.hom.comp ι.hom

    have h1 : Function.Bijective a₁ := by
      apply IsAlgClosed.ringHom_bijective_of_isIntegral
      apply RingHom.Finite.to_isIntegral
      exact RingHom.Finite.comp (finite_appTop_of_universallyClosed K s₁)
        (RingHom.Finite.of_surjective _ hι.2)

    have h2 : Function.Bijective a₂ := by
      obtain ⟨z⟩ : Nonempty Z := inferInstance
      obtain ⟨V, hV, hzV, -⟩ := exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      haveI : Nonempty V := ⟨⟨z, hzV⟩⟩
      haveI := Scheme.component_nontrivial Z V
      obtain ⟨M, hM⟩ := Ideal.exists_maximal Γ(Z, V)
      letI : Field (Γ(Z, V) ⧸ M) := Ideal.Quotient.field M
      let π : Γ(Z, V) →+* Γ(Z, V) ⧸ M := Ideal.Quotient.mk M
      have eV : V ≤ s₂ ⁻¹ᵁ ⊤ := fun _ _ => trivial
      have hfin : (s₂.appLE ⊤ V eV).hom.FiniteType :=
        LocallyOfFiniteType.finiteType_appLE s₂ (isAffineOpen_top _) hV eV
      let κ : K →+* Γ(Z, V) ⧸ M := π.comp ((s₂.appLE ⊤ V eV).hom.comp ι.hom)
      have hκ : κ.FiniteType :=
        RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective π Ideal.Quotient.mk_surjective)
          (RingHom.FiniteType.comp hfin (RingHom.FiniteType.of_surjective _ hι.2))
      have hκfin : κ.Finite := by
        letI := κ.toAlgebra
        haveI : Algebra.FiniteType K (Γ(Z, V) ⧸ M) := hκ
        exact finite_of_finite_type_of_isJacobsonRing K (Γ(Z, V) ⧸ M)
      have hκi : κ.IsIntegral := RingHom.Finite.to_isIntegral hκfin
      let ρ : Γ(Z, ⊤) ⟶ Γ(Z, V) := Z.presheaf.map (homOfLE le_top).op
      have hρ : s₂.appTop ≫ ρ = s₂.appLE ⊤ V eV := by
        first | rfl | (simp only [Scheme.Hom.appTop, Scheme.Hom.appLE]; rfl)
      let j : Γ(Z, ⊤) →+* Γ(Z, V) ⧸ M := π.comp ρ.hom
      have hj : Function.Injective j := by
        rw [injective_iff_map_eq_zero]
        intro t ht
        by_contra hne
        obtain ⟨b, hb⟩ := hF.mul_inv_cancel hne
        have : j t * j b = 1 := by rw [← map_mul, hb, map_one]
        rw [ht, zero_mul] at this
        exact zero_ne_one this
      have hκj : κ = j.comp a₂ := by
        have : (s₂.appLE ⊤ V eV).hom = ρ.hom.comp s₂.appTop.hom := by
          rw [← hρ]; rfl
        simp only [κ, j, a₂, this]
        rfl
      apply IsAlgClosed.ringHom_bijective_of_isIntegral
      intro t
      obtain ⟨p, hpm, hp⟩ := hκi (j t)
      refine ⟨p, hpm, ?_⟩
      apply hj
      rw [map_zero, Polynomial.hom_eval₂, ← hκj]
      exact hp

    let e₁ : K ≃+* Γ(Z, ⊤) := RingEquiv.ofBijective a₁ h1
    let e₂ : K ≃+* Γ(Z, ⊤) := RingEquiv.ofBijective a₂ h2
    let τ : K ≃+* K := e₂.trans e₁.symm
    let f : CommRingCat.of K ⟶ CommRingCat.of K := τ.toCommRingCatIso.hom
    have key : ι ≫ (Spec.map f).appTop = f ≫ ι := by
      rw [← cancel_mono (Scheme.ΓSpecIso (.of K)).hom]
      simp only [ι, Category.assoc, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc,
        Iso.inv_hom_id, Category.comp_id]
    have hσ : s₁ ≫ Spec.map f = s₂ := by
      apply ext_of_isAffine
      rw [Scheme.Hom.comp_appTop, ← cancel_epi ι, ← Category.assoc, key, Category.assoc]
      ext t
      show e₁ (e₁.symm (e₂ t)) = e₂ t
      exact e₁.apply_symm_apply (e₂ t)
    rw [← hσ]
    infer_instance
  intro C hC hCne hCU
  obtain ⟨φ⟩ := hOU

  haveI : IsLocallyNoetherian Yb := LocallyOfFiniteType.isLocallyNoetherian fY
  haveI : CompactSpace Yb := compactSpace_of_universallyClosed fY
  haveI : AlgebraicGeometry.IsNoetherian Yb := AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace Yb := IsNoetherian.noetherianSpace

  obtain ⟨C₀, hC₀, hC₀ne, hC₀C, hC₀conn⟩ : ∃ C₀ : Set Yb, IsClopen C₀ ∧ C₀.Nonempty ∧ C₀ ⊆ C ∧
      _root_.IsPreconnected C₀ := by
    let 𝒮 : Set (TopologicalSpace.Opens Yb) :=
      {W | IsClosed (W : Set Yb) ∧ Cᶜ ⊆ (W : Set Yb) ∧ (W : Set Yb) ≠ Set.univ}
    have hS : 𝒮.Nonempty := by
      refine ⟨⟨Cᶜ, hC.isClosed.isOpen_compl⟩, hC.isOpen.isClosed_compl, subset_rfl, ?_⟩
      intro h
      obtain ⟨x, hx⟩ := hCne
      have : x ∈ (Cᶜ : Set Yb) := by
        have h' : (Cᶜ : Set Yb) = Set.univ := h
        rw [h']; exact Set.mem_univ x
      exact this hx
    obtain ⟨W, ⟨hWcl, hWC, hWne⟩, hWmax⟩ :=
      (wellFounded_gt (α := TopologicalSpace.Opens Yb)).has_min 𝒮 hS
    refine ⟨(W : Set Yb)ᶜ, ⟨W.isOpen.isClosed_compl, hWcl.isOpen_compl⟩,
      Set.nonempty_compl.mpr hWne, Set.compl_subset_comm.mp hWC, ?_⟩
    rw [isPreconnected_iff_subset_of_disjoint]
    intro A B hA hB hAB hdisj
    by_contra hcon
    rw [not_or] at hcon
    obtain ⟨b, hbW, hbA⟩ := Set.not_subset.mp hcon.1
    obtain ⟨a, haW, haB⟩ := Set.not_subset.mp hcon.2
    have hmemA : ∀ x ∈ (W : Set Yb)ᶜ, x ∈ A ↔ x ∉ B := by
      intro x hx
      constructor
      · intro hxA hxB
        have : x ∈ (W : Set Yb)ᶜ ∩ (A ∩ B) := ⟨hx, hxA, hxB⟩
        rw [hdisj] at this
        exact this
      · intro hxB
        rcases hAB hx with h | h
        · exact h
        · exact absurd h hxB
    have hA'eq : (W : Set Yb)ᶜ ∩ A = (W : Set Yb)ᶜ ∩ Bᶜ := by
      ext x
      constructor
      · rintro ⟨hx, hxA⟩; exact ⟨hx, (hmemA x hx).mp hxA⟩
      · rintro ⟨hx, hxB⟩; exact ⟨hx, (hmemA x hx).mpr hxB⟩
    have hA'open : IsOpen ((W : Set Yb)ᶜ ∩ A) := hWcl.isOpen_compl.inter hA
    have hA'closed : IsClosed ((W : Set Yb)ᶜ ∩ A) := by
      rw [hA'eq]; exact W.isOpen.isClosed_compl.inter hB.isClosed_compl
    let W' : TopologicalSpace.Opens Yb := ⟨(W : Set Yb) ∪ ((W : Set Yb)ᶜ ∩ A), W.isOpen.union hA'open⟩
    have hW'S : W' ∈ 𝒮 := by
      refine ⟨hWcl.union hA'closed, hWC.trans Set.subset_union_left, ?_⟩
      intro h
      have hb : b ∈ (W' : Set Yb) := by
        have h' : ((W : Set Yb) ∪ ((W : Set Yb)ᶜ ∩ A)) = Set.univ := h
        show b ∈ (W : Set Yb) ∪ ((W : Set Yb)ᶜ ∩ A)
        rw [h']; exact Set.mem_univ b
      rcases hb with hb | hb
      · exact hbW hb
      · exact hbA hb.2
    apply hWmax W' hW'S
    rw [SetLike.lt_iff_le_and_exists]
    refine ⟨fun x hx => Or.inl hx, a, ?_, haW⟩
    show a ∈ (W : Set Yb) ∪ ((W : Set Yb)ᶜ ∩ A)
    exact Or.inr ⟨haW, (hmemA a haW).mpr haB⟩

  let C₀' : Yb.Opens := ⟨C₀, hC₀.isOpen⟩
  let X : (U : Scheme.{u}).Opens := U.ι ⁻¹ᵁ C₀'
  let h : (X : Scheme.{u}) ⟶ Yb := X.ι ≫ U.ι
  haveI : IsOpenImmersion h := by dsimp only [h]; infer_instance
  have hrange : Set.range h = C₀ := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      have hx : X.ι x ∈ Set.range X.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι] at hx
      exact hx
    · intro hy
      have hyU : y ∈ Set.range U.ι := by
        rw [Scheme.Opens.range_ι]; exact hCU (hC₀C hy)
      obtain ⟨w, rfl⟩ := hyU
      have hwX : w ∈ Set.range X.ι := by
        rw [Scheme.Opens.range_ι]; exact hy
      obtain ⟨x, rfl⟩ := hwX
      exact ⟨x, rfl⟩

  haveI : IsClosedImmersion h :=
    IsClosedImmersion.of_isPreimmersion h (by rw [hrange]; exact hC₀.isClosed)
  haveI : IsProper (h ≫ fY) := inferInstance
  haveI : ∀ y : Yb, IsDomain (Yb.presheaf.stalk y) := wcpa_smooth_stalk_isDomain K Yb fY N
  haveI : AlgebraicGeometry.IsReduced Yb := isReduced_of_isReduced_stalk Yb
  haveI : AlgebraicGeometry.IsReduced (X : Scheme.{u}) := isReduced_of_isOpenImmersion h
  haveI hXne : Nonempty (X : Scheme.{u}) := by
    obtain ⟨y, hy⟩ := hC₀ne
    rw [← hrange] at hy
    obtain ⟨x, -⟩ := hy
    exact ⟨x⟩
  have hpre : _root_.IsPreconnected (Set.univ : Set (X : Scheme.{u})) := by
    apply (h.isOpenEmbedding.isInducing.isPreconnected_image (s := Set.univ)).mp
    rw [Set.image_univ, hrange]
    exact hC₀conn
  haveI : ConnectedSpace (X : Scheme.{u}) := connectedSpace_iff_univ.mpr ⟨Set.univ_nonempty, hpre⟩
  haveI : Smooth fY := SmoothOfRelativeDimension.smooth N fY
  haveI : Smooth (h ≫ fY) := inferInstance
  haveI : IrreducibleSpace (X : Scheme.{u}) :=
    wc_smooth_algclosed_connected_irreducible K X (h ≫ fY)
  haveI : AlgebraicGeometry.IsIntegral (X : Scheme.{u}) :=
    isIntegral_of_irreducibleSpace_of_isReduced X

  let g : (X : Scheme.{u}) ⟶ Y := X.ι ≫ φ.inv ≫ O.ι
  haveI : IsOpenImmersion g := by dsimp only [g]; infer_instance
  haveI : LocallyOfFiniteType (g ≫ pY) := inferInstance
  haveI : IsProper (g ≫ pY) := crux X (h ≫ fY) (g ≫ pY)
  haveI : IsProper g := IsProper.of_comp g pY

  have hcl : IsClosed (Set.range g) := g.isClosedMap.isClosed_range
  have hop : IsOpen (Set.range g) := g.isOpenEmbedding.isOpen_range
  have hne : (Set.range g).Nonempty := Set.range_nonempty g
  rcases isClopen_iff.mp ⟨hcl, hop⟩ with h0 | h0
  · exact hne.ne_empty h0
  ·
    apply hOne
    apply Set.eq_univ_of_univ_subset
    rw [← h0]
    rintro _ ⟨x, rfl⟩
    have hx : O.ι (φ.inv (X.ι x)) ∈ Set.range O.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hx

theorem wc_proper_smooth_clopen_split : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f], Nonempty Y → ¬ IrreducibleSpace Y → ∃ U V : Y.Opens, Disjoint U V ∧ U ⊔ V = ⊤ ∧ IsProper (U.ι ≫ f) ∧ SmoothOfRelativeDimension N (U.ι ≫ f) ∧ IsProper (V.ι ≫ f) ∧ SmoothOfRelativeDimension N (V.ι ≫ f) ∧ (irreducibleComponents (U : Scheme.{u})).ncard < (irreducibleComponents Y).ncard ∧ (irreducibleComponents (V : Scheme.{u})).ncard < (irreducibleComponents Y).ncard :=
by
  intro K _ _ Y f _ N _ hne hirr

  have count : ∀ {X Z : Type u} [TopologicalSpace X] [TopologicalSpace Z] (j : X → Z),
      Topology.IsOpenEmbedding j → IsClosed (Set.range j) → (Set.range j)ᶜ.Nonempty →
      (irreducibleComponents Z).Finite →
      (irreducibleComponents X).ncard < (irreducibleComponents Z).ncard := by
    intro X Z _ _ j hj hcl hzc hfin
    obtain ⟨z, hz⟩ := hzc
    have hR : IsClopen (Set.range j) := ⟨hcl, hj.isOpen_range⟩
    have hmap : ∀ C ∈ irreducibleComponents X, j '' C ∈ irreducibleComponents Z := by
      intro C hC
      have hC' : Maximal IsIrreducible C := hC
      have hCi : IsIrreducible C := hC'.prop
      have hJi : IsIrreducible (j '' C) := hCi.image j hj.continuous.continuousOn
      show Maximal IsIrreducible (j '' C)
      refine And.intro hJi ?_
      intro T hT hsub
      obtain ⟨c, hc⟩ := hCi.nonempty
      have hTR : T ⊆ Set.range j :=
        hT.isConnected.isPreconnected.subset_isClopen hR ⟨j c, hsub ⟨c, hc, rfl⟩, ⟨c, rfl⟩⟩
      have hCT : C ⊆ j ⁻¹' T := fun x hx => hsub ⟨x, hx, rfl⟩
      have hpre : IsIrreducible (j ⁻¹' T) := ⟨⟨c, hCT hc⟩, hT.isPreirreducible.preimage hj⟩
      have h1 : j ⁻¹' T ⊆ C := hC'.le_of_ge hpre hCT
      calc T = j '' (j ⁻¹' T) := (Set.image_preimage_eq_of_subset hTR).symm
        _ ⊆ j '' C := Set.image_mono h1
    have hsub : (Set.image j) '' (irreducibleComponents X) ⊆ irreducibleComponents Z := by
      rintro _ ⟨C, hC, rfl⟩
      exact hmap C hC
    have hnot : irreducibleComponent z ∉ (Set.image j) '' (irreducibleComponents X) := by
      rintro ⟨C, _, hC⟩
      have hzC : z ∈ j '' C := by
        rw [hC]
        exact mem_irreducibleComponent
      obtain ⟨x, _, hx⟩ := hzC
      exact hz ⟨x, hx⟩
    have hss : (Set.image j) '' (irreducibleComponents X) ⊂ irreducibleComponents Z := by
      refine Set.ssubset_iff_subset_ne.mpr ⟨hsub, fun h => hnot ?_⟩
      rw [h]
      exact irreducibleComponent_mem_irreducibleComponents z
    have hinj : Function.Injective (Set.image j) :=
      Set.image_injective.mpr hj.isEmbedding.injective
    rw [← Set.ncard_image_of_injective _ hinj]
    exact Set.ncard_lt_ncard hss hfin

  haveI : Smooth f := SmoothOfRelativeDimension.smooth N f
  have hnc : ¬ ConnectedSpace Y := fun hc => by
    haveI := hc
    exact hirr (wc_smooth_algclosed_connected_irreducible K Y f)
  rw [connectedSpace_iff_clopen] at hnc
  push_neg at hnc
  obtain ⟨s, hs, hs0, hsu⟩ := hnc hne
  have hsne : s.Nonempty := hs0
  have hscne : sᶜ.Nonempty := Set.nonempty_compl.mpr hsu
  let U : Y.Opens := ⟨s, hs.isOpen⟩
  let V : Y.Opens := ⟨sᶜ, hs.isClosed.isOpen_compl⟩

  have restr : ∀ W : Y.Opens, IsClosed (W : Set Y) →
      IsProper (W.ι ≫ f) ∧ SmoothOfRelativeDimension N (W.ι ≫ f) := by
    intro W hW
    haveI : IsClosedImmersion W.ι :=
      IsClosedImmersion.of_isPreimmersion W.ι (by rw [Scheme.Opens.range_ι]; exact hW)
    refine ⟨inferInstance, ?_⟩
    have h := smoothOfRelativeDimension_comp 0 N W.ι f
    rwa [Nat.zero_add] at h

  have hfin : (irreducibleComponents Y).Finite := by
    haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
    haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
    exact finite_irreducibleComponents_of_isNoetherian
  obtain ⟨hUp, hUs⟩ := restr U hs.isClosed
  obtain ⟨hVp, hVs⟩ := restr V hs.isOpen.isClosed_compl
  refine ⟨U, V, ?_, ?_, hUp, hUs, hVp, hVs, ?_, ?_⟩
  · rw [disjoint_iff, ← SetLike.coe_set_eq, TopologicalSpace.Opens.coe_inf,
      TopologicalSpace.Opens.coe_bot]
    exact Set.inter_compl_self s
  · rw [← SetLike.coe_set_eq, TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top]
    exact Set.union_compl_self s
  · apply count U.ι U.ι.isOpenEmbedding
    · rw [Scheme.Opens.range_ι]; exact hs.isClosed
    · rw [Scheme.Opens.range_ι]; exact hscne
    · exact hfin
  · apply count V.ι V.ι.isOpenEmbedding
    · rw [Scheme.Opens.range_ι]; exact hs.isOpen.isClosed_compl
    · rw [Scheme.Opens.range_ι]
      change (sᶜᶜ).Nonempty
      rw [compl_compl]
      exact hsne
    · exact hfin

theorem wc_et_smooth_proper_open_top_vanish_of_meets : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Yb : Scheme.{u}) (f : Yb ⟶ Spec (.of Ω)) [IsProper f] (d : ℕ)
    [SmoothOfRelativeDimension d f], 1 ≤ d → ∀ (W : Yb.Opens),
    (∀ C : Set Yb, IsClopen C → C.Nonempty → ¬ C ⊆ (W : Set Yb)) →
    ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ (2 * d)) :=
by
  intro Ω _ _ Yb f _ d _ hd W hW ℓ hℓp hℓ

  have hempty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY m q
    have hZ := wc_et_sheaf_isZero_of_isEmpty Y hY
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hx : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q, x = 0 := by
      intro x
      have := Abelian.Ext.comp_mk₀_id x
      rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
      exact this.symm
    exact ⟨fun a b => by
      have ha := hx a
      have hb := hx b
      exact ha.trans hb.symm⟩

  have hmeet : ∀ (Y : Scheme.{u}) (P Q V : Y.Opens), Disjoint P Q → P ⊔ Q = ⊤ →
      (∀ C : Set Y, IsClopen C → C.Nonempty → ¬ C ⊆ (V : Set Y)) →
      ∀ C : Set (P : Scheme.{u}), IsClopen C → C.Nonempty →
        ¬ C ⊆ ((P.ι ⁻¹ᵁ V : (P : Scheme.{u}).Opens) : Set (P : Scheme.{u})) := by
    intro Y P Q V hPQ hcov hV C hC hCne hCV
    have h1 : (P : Set Y) ∩ Q = ∅ := by
      have := congrArg (fun U : Y.Opens => (U : Set Y)) (disjoint_iff.mp hPQ)
      simpa using this
    have h2 : (P : Set Y) ∪ Q = Set.univ := by
      have := congrArg (fun U : Y.Opens => (U : Set Y)) hcov
      simpa using this
    have hPc : (P : Set Y) = (Q : Set Y)ᶜ := by
      ext x
      constructor
      · intro hx hxQ
        have : x ∈ (P : Set Y) ∩ Q := ⟨hx, hxQ⟩
        rw [h1] at this
        exact this
      · intro hx
        have : x ∈ (P : Set Y) ∪ Q := by rw [h2]; trivial
        rcases this with h | h
        · exact h
        · exact absurd h hx
    have hPclosed : IsClosed (P : Set Y) := by rw [hPc]; exact Q.isOpen.isClosed_compl
    have hoe := P.ι.isOpenEmbedding
    have hce : Topology.IsClosedEmbedding P.ι :=
      ⟨hoe.toIsEmbedding, by rw [Scheme.Opens.range_ι]; exact hPclosed⟩
    apply hV (P.ι '' C) ⟨hce.isClosedMap _ hC.isClosed, hoe.isOpenMap _ hC.isOpen⟩ (hCne.image _)
    rintro _ ⟨c, hc, rfl⟩
    exact hCV hc

  have hrange : ∀ (Y : Scheme.{u}) (P V : Y.Opens),
      Set.range ⇑((P.ι ⁻¹ᵁ V).ι ≫ P.ι) = Set.range ⇑(V ⊓ P).ι := by
    intro Y P V
    ext x
    simp only [Set.mem_range, Scheme.Hom.comp_apply]
    constructor
    · rintro ⟨z, rfl⟩
      have hz : (P.ι ⁻¹ᵁ V).ι z ∈ ((P.ι ⁻¹ᵁ V : (P : Scheme.{u}).Opens) : Set _) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨z, rfl⟩
      have hP : P.ι ((P.ι ⁻¹ᵁ V).ι z) ∈ (P : Set Y) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
      have hmem : P.ι ((P.ι ⁻¹ᵁ V).ι z) ∈ ((V ⊓ P : Y.Opens) : Set Y) := ⟨hz, hP⟩
      rw [← Scheme.Opens.range_ι] at hmem
      exact hmem
    · rintro ⟨z, rfl⟩
      have hz : (V ⊓ P).ι z ∈ ((V ⊓ P : Y.Opens) : Set Y) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨z, rfl⟩
      obtain ⟨hV, hP⟩ := hz
      rw [← Scheme.Opens.range_ι] at hP
      obtain ⟨p, hp⟩ := hP
      have : p ∈ ((P.ι ⁻¹ᵁ V : (P : Scheme.{u}).Opens) : Set _) := by
        show P.ι p ∈ (V : Set Y)
        rw [hp]; exact hV
      rw [← Scheme.Opens.range_ι] at this
      obtain ⟨w, hw⟩ := this
      exact ⟨w, by rw [hw, hp]⟩

  have htrans : ∀ (Y : Scheme.{u}) (P V : Y.Opens) (n : ℕ),
      Subsingleton (wcEtCoh ((P.ι ⁻¹ᵁ V : (P : Scheme.{u}).Opens) : Scheme.{u}) ℓ n) →
      Subsingleton (wcEtCoh ((V ⊓ P : Y.Opens) : Scheme.{u}) ℓ n) := by
    intro Y P V n hs
    obtain ⟨e⟩ := wc_et_coh_iso_invariance
      (IsOpenImmersion.isoOfRangeEq ((P.ι ⁻¹ᵁ V).ι ≫ P.ι) (V ⊓ P).ι (hrange Y P V)).hom ℓ n
    exact e.subsingleton

  have hdisj : ∀ (Y : Scheme.{u}) (P Q V : Y.Opens), Disjoint P Q →
      IsEmpty ↥((V ⊓ P ⊓ (V ⊓ Q) : Y.Opens) : Scheme.{u}) := by
    intro Y P Q V hPQ
    constructor
    intro x
    have hx : ((V ⊓ P ⊓ (V ⊓ Q) : Y.Opens).ι x) ∈ ((V ⊓ P ⊓ (V ⊓ Q) : Y.Opens) : Set Y) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
    have h1 : ((V ⊓ P ⊓ (V ⊓ Q) : Y.Opens) : Set Y) ⊆ ((P ⊓ Q : Y.Opens) : Set Y) := by
      intro y hy
      simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff] at hy ⊢
      exact ⟨hy.1.2, hy.2.2⟩
    rw [disjoint_iff.mp hPQ] at h1
    simpa using h1 hx

  suffices H : ∀ (k : ℕ) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of Ω)) [IsProper g]
      [SmoothOfRelativeDimension d g], (irreducibleComponents Y).ncard = k →
      ∀ V : Y.Opens, (∀ C : Set Y, IsClopen C → C.Nonempty → ¬ C ⊆ (V : Set Y)) →
      Subsingleton (wcEtCoh (V : Scheme.{u}) ℓ (2 * d)) from
    H _ Yb f rfl W hW
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  intro Y g _ _ hk V hV
  rcases isEmpty_or_nonempty Y with hY | hY
  · haveI : IsEmpty ↥(V : Scheme.{u}) := Function.isEmpty ⇑V.ι
    exact hempty _ this ℓ (2 * d)
  by_cases hirr : IrreducibleSpace Y
  · have hne : Set.range ⇑V.ι ≠ Set.univ := by
      rw [Scheme.Opens.range_ι]
      intro h
      exact hV Set.univ isClopen_univ Set.univ_nonempty (fun x _ => by rw [h]; trivial)
    exact wc_et_open_top_vanishing Ω Y g d (V : Scheme.{u}) V.ι hne ℓ hℓp hℓ
  obtain ⟨P, Q, hPQ, hcov, hPp, hPs, hQp, hQs, hPk, hQk⟩ :=
    wc_proper_smooth_clopen_split Ω Y g d hY hirr
  haveI := hPp
  haveI := hPs
  haveI := hQp
  haveI := hQs
  have IP := ih _ (by rw [← hk]; exact hPk) (P : Scheme.{u}) (P.ι ≫ g) rfl (P.ι ⁻¹ᵁ V)
    (hmeet Y P Q V hPQ hcov hV)
  have IQ := ih _ (by rw [← hk]; exact hQk) (Q : Scheme.{u}) (Q.ι ≫ g) rfl (Q.ι ⁻¹ᵁ V)
    (hmeet Y Q P V hPQ.symm (by rw [sup_comm]; exact hcov) hV)
  have hA := htrans Y P V (2 * d) IP
  have hB := htrans Y Q V (2 * d) IQ
  obtain ⟨q, hq⟩ : ∃ q, 2 * d = q + 1 := ⟨2 * d - 1, by omega⟩
  rw [hq] at hA hB ⊢
  haveI := hdisj Y P Q V hPQ
  have h0 := hempty ((V ⊓ P ⊓ (V ⊓ Q) : Y.Opens) : Scheme.{u}) this ℓ q
  have hAB : V ⊓ P ⊔ V ⊓ Q = V := by rw [← inf_sup_left, hcov, inf_top_eq]
  obtain ⟨hfin, hcard⟩ := wc_et_zariski_mv_card_le Y V (V ⊓ P) (V ⊓ Q) hAB ℓ q
    inferInstance inferInstance inferInstance
  have c0 : Nat.card (wcEtCoh ((V ⊓ P ⊓ (V ⊓ Q) : Y.Opens) : Scheme.{u}) ℓ q) ≤ 1 :=
    Finite.card_le_one_iff_subsingleton.mpr h0
  have cA : Nat.card (wcEtCoh ((V ⊓ P : Y.Opens) : Scheme.{u}) ℓ (q + 1)) ≤ 1 :=
    Finite.card_le_one_iff_subsingleton.mpr hA
  have cB : Nat.card (wcEtCoh ((V ⊓ Q : Y.Opens) : Scheme.{u}) ℓ (q + 1)) ≤ 1 :=
    Finite.card_le_one_iff_subsingleton.mpr hB
  have hle : Nat.card (wcEtCoh (V : Scheme.{u}) ℓ (q + 1)) ≤ 1 :=
    hcard.trans (by
      calc _ ≤ 1 * (1 * 1) := Nat.mul_le_mul c0 (Nat.mul_le_mul cA cB)
        _ = 1 := by norm_num)
  exact Finite.card_le_one_iff_subsingleton.mp hle

theorem wc_odp_blowup_proper : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K))
    [IsProper fX] (I : X.IdealSheafData),
    ∃ (X' : Scheme.{u}) (r : X' ⟶ X), wcCsdIsBlowup I r ∧ IsProper r :=
by
  intro K _ X fX _ I

  have hom_inv_apply : ∀ {A B : CommRingCat.{u}} (φ : A ≅ B) (x : A),
      φ.inv.hom (φ.hom.hom x) = x := by
    intro A B φ x
    exact congrArg (fun f : A ⟶ A => f.hom x) φ.hom_inv_id
  have inv_hom_apply : ∀ {A B : CommRingCat.{u}} (φ : A ≅ B) (x : B),
      φ.hom.hom (φ.inv.hom x) = x := by
    intro A B φ x
    exact congrArg (fun f : B ⟶ B => f.hom x) φ.inv_hom_id
  have isoIdeal : ∀ {A B : CommRingCat.{u}} (φ : A ≅ B) (J : Ideal A),
      Ideal.map φ.hom.hom J = Ideal.comap φ.inv.hom J := by
    intro A B φ J
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      show φ.inv.hom (φ.hom.hom x) ∈ J
      rw [hom_inv_apply]
      exact hx
    · intro x hx
      rw [← inv_hom_apply φ x]
      exact Ideal.mem_map_of_mem _ hx

  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk

  have s2 : ∀ (T : Scheme.{u}) (g : T ⟶ X) (O : X.Opens), wcCsdInvPull I g → ∀ t : T, g t ∈ O →
      ∃ (U : X.affineOpens) (V : T.affineOpens) (hVU : V.1 ≤ g ⁻¹ᵁ U.1) (a : Γ(X, U.1)),
        U.1 ≤ O ∧ t ∈ V.1 ∧ a ∈ I.ideal U ∧
        (g.appLE U.1 V.1 hVU).hom a ∈ nonZeroDivisors Γ(T, V.1) ∧
        Ideal.map (g.appLE U.1 V.1 hVU).hom (I.ideal U) =
          Ideal.span {(g.appLE U.1 V.1 hVU).hom a} := by
    intro T g O H t hO
    obtain ⟨W₀, V₀, e₀, a, ht, haI, hnzd, hspan⟩ := H t
    obtain ⟨f, hfO, hxf⟩ := W₀.2.exists_basicOpen_le (V := O) ⟨g t, hO⟩ (e₀ ht)
    have hD : T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f) = V₀.1 ⊓ g ⁻¹ᵁ X.basicOpen f :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have e : (T.affineBasicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)).1 ≤
        g ⁻¹ᵁ (X.affineBasicOpen f).1 := by
      show T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f) ≤ g ⁻¹ᵁ X.basicOpen f
      rw [hD]; exact inf_le_right
    have htV : t ∈ (T.affineBasicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)).1 := by
      show t ∈ T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)
      rw [hD]; exact ⟨ht, hxf⟩
    have e' : T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f) ≤ g ⁻¹ᵁ X.basicOpen f := e
    have hsq : X.presheaf.map (homOfLE (X.basicOpen_le f)).op ≫
        g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e' =
        g.appLE W₀.1 V₀.1 e₀ ≫
          T.presheaf.map (homOfLE (T.basicOpen_le ((g.appLE W₀.1 V₀.1 e₀).hom f))).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    have hval : (g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
        ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a) =
        (T.presheaf.map (homOfLE (T.basicOpen_le ((g.appLE W₀.1 V₀.1 e₀).hom f))).op).hom
          ((g.appLE W₀.1 V₀.1 e₀).hom a) := by
      change (X.presheaf.map (homOfLE (X.basicOpen_le f)).op ≫
        g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom a =
        (g.appLE W₀.1 V₀.1 e₀ ≫
          T.presheaf.map (homOfLE (T.basicOpen_le ((g.appLE W₀.1 V₀.1 e₀).hom f))).op).hom a
      rw [hsq]
    have h1 : Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (I.ideal W₀) =
        I.ideal (X.affineBasicOpen f) := I.map_ideal_basicOpen W₀ f
    refine ⟨X.affineBasicOpen f, T.affineBasicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f), e,
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a, hfO, htV, ?_, ?_, ?_⟩
    · rw [← h1]; exact Ideal.mem_map_of_mem _ haI
    · show (g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
          ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a) ∈
          nonZeroDivisors Γ(T, T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f))
      rw [hval]
      have hloc := V₀.2.isLocalization_basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)
      exact IsLocalization.map_nonZeroDivisors_le
        (Submonoid.powers ((g.appLE W₀.1 V₀.1 e₀).hom f))
        Γ(T, T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) (Submonoid.mem_map_of_mem _ hnzd)
    · show Ideal.map
          (g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
          (I.ideal (X.affineBasicOpen f)) = Ideal.span
          {(g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
            ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a)}
      rw [hval]
      calc Ideal.map
            (g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
            (I.ideal (X.affineBasicOpen f))
          = Ideal.map
            (g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
            (Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (I.ideal W₀)) := by
              rw [h1] <;> rfl
        _ = Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op ≫
              g.appLE (X.basicOpen f) (T.basicOpen ((g.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
              (I.ideal W₀) := by
            rw [Ideal.map_map] <;> rfl
        _ = Ideal.map (g.appLE W₀.1 V₀.1 e₀ ≫
              T.presheaf.map (homOfLE (T.basicOpen_le ((g.appLE W₀.1 V₀.1 e₀).hom f))).op).hom
              (I.ideal W₀) := by
            rw [hsq]
        _ = Ideal.map
              (T.presheaf.map (homOfLE (T.basicOpen_le ((g.appLE W₀.1 V₀.1 e₀).hom f))).op).hom
              (Ideal.map (g.appLE W₀.1 V₀.1 e₀).hom (I.ideal W₀)) := by
            rw [CommRingCat.hom_comp, Ideal.map_map]
        _ = _ := by rw [hspan, Ideal.map_span, Set.image_singleton] <;> rfl

  have hiff : ∀ (U : X.Opens) (T : Scheme.{u}) (h : T ⟶ U.toScheme),
      wcCsdInvPull (I.comap U.ι) h ↔ wcCsdInvPull I (h ≫ U.ι) := by
    intro U T h
    constructor
    · intro H t
      obtain ⟨U0, V, e, a0, ht, ha0, hnzd, hspan⟩ := H t
      have hW : IsAffineOpen (U.ι ''ᵁ U0.1) := U0.2.image_of_isOpenImmersion U.ι
      have e' : V.1 ≤ (h ≫ U.ι) ⁻¹ᵁ (U.ι ''ᵁ U0.1) := by
        have h1 : U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1) = U0.1 := U.ι.preimage_image_eq U0.1
        show V.1 ≤ h ⁻¹ᵁ (U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1))
        rw [h1]; exact e
      have hF : (h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e' =
          (U.ι.appIso U0.1).hom ≫ h.appLE U0.1 V.1 e := by
        rw [Scheme.Hom.appIso_hom', Scheme.Hom.appLE_comp_appLE]
      have hcomp : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom =
          (h.appLE U0.1 V.1 e).hom.comp (U.ι.appIso U0.1).hom.hom := by
        rw [hF, CommRingCat.hom_comp]
      have hG : (I.comap U.ι).ideal U0 =
          Ideal.comap (U.ι.appIso U0.1).inv.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW⟩) :=
        I.ideal_comap_of_isOpenImmersion U.ι U0
      have hstar : Ideal.map (U.ι.appIso U0.1).hom.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW⟩) =
          (I.comap U.ι).ideal U0 := by
        rw [hG]; exact isoIdeal _ _
      have hval : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom ((U.ι.appIso U0.1).inv.hom a0) =
          (h.appLE U0.1 V.1 e).hom a0 := by
        rw [hcomp, RingHom.comp_apply, inv_hom_apply]
      refine ⟨⟨U.ι ''ᵁ U0.1, hW⟩, V, e', (U.ι.appIso U0.1).inv.hom a0, ht, ?_, ?_, ?_⟩
      · rw [hG] at ha0; exact ha0
      · show ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom ((U.ι.appIso U0.1).inv.hom a0) ∈
          nonZeroDivisors Γ(T, V.1)
        rw [hval]; exact hnzd
      · show Ideal.map ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom
            (I.ideal ⟨U.ι ''ᵁ U0.1, hW⟩) =
          Ideal.span {((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom ((U.ι.appIso U0.1).inv.hom a0)}
        rw [hval, ← hspan, hcomp, ← Ideal.map_map, hstar]
    · intro H t
      have hmem : (h ≫ U.ι) t ∈ U.ι.opensRange := by
        rw [Scheme.Hom.comp_apply, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact Set.mem_range_self (h t)
      obtain ⟨⟨W1, hW1⟩, V, e, b, hWO, ht, hb, hnzd, hgen⟩ :=
        s2 T (h ≫ U.ι) U.ι.opensRange H t hmem
      have hWO' : W1 ≤ U.ι.opensRange := hWO
      obtain ⟨U0, rfl⟩ : ∃ U0 : U.toScheme.affineOpens, W1 = U.ι ''ᵁ U0.1 :=
        ⟨⟨U.ι ⁻¹ᵁ W1, IsAffineOpen.preimage_of_isOpenImmersion hW1 U.ι hWO'⟩, by
          show W1 = U.ι ''ᵁ (U.ι ⁻¹ᵁ W1)
          rw [Scheme.Hom.image_preimage_eq_opensRange_inf, inf_eq_right.mpr hWO']⟩
      have e1 : V.1 ≤ (h ≫ U.ι) ⁻¹ᵁ (U.ι ''ᵁ U0.1) := e
      have hb' : b ∈ I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩ := hb
      have hnzd' : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom b ∈ nonZeroDivisors Γ(T, V.1) :=
        hnzd
      have hgen' : Ideal.map ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom
          (I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩) =
          Ideal.span {((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom b} := hgen
      have e'' : V.1 ≤ h ⁻¹ᵁ U0.1 := by
        have h1 : U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1) = U0.1 := U.ι.preimage_image_eq U0.1
        have e2 : V.1 ≤ h ⁻¹ᵁ (U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1)) := e1
        rw [h1] at e2; exact e2
      have hF : (h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1 =
          (U.ι.appIso U0.1).hom ≫ h.appLE U0.1 V.1 e'' := by
        rw [Scheme.Hom.appIso_hom', Scheme.Hom.appLE_comp_appLE]
      have hcomp : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom =
          (h.appLE U0.1 V.1 e'').hom.comp (U.ι.appIso U0.1).hom.hom := by
        rw [hF, CommRingCat.hom_comp]
      have hG : (I.comap U.ι).ideal U0 =
          Ideal.comap (U.ι.appIso U0.1).inv.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩) :=
        I.ideal_comap_of_isOpenImmersion U.ι U0
      have hstar : Ideal.map (U.ι.appIso U0.1).hom.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩) =
          (I.comap U.ι).ideal U0 := by
        rw [hG]; exact isoIdeal _ _
      have hval : (h.appLE U0.1 V.1 e'').hom ((U.ι.appIso U0.1).hom.hom b) =
          ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom b := by
        rw [hcomp, RingHom.comp_apply]
      refine ⟨U0, V, e'', (U.ι.appIso U0.1).hom.hom b, ht, ?_, ?_, ?_⟩
      · rw [hG, Ideal.mem_comap, hom_inv_apply]
        exact hb'
      · rw [hval]; exact hnzd'
      · rw [hval, ← hgen', ← hstar, Ideal.map_map, ← hcomp]

  obtain ⟨X', r, hbl, -⟩ := wc_csd_blowup_exists_noeth X I

  have hloc : ∀ U : X.affineOpens, IsProper (r ∣_ U.1) := by
    intro U
    haveI : IsAffine U.1.toScheme := U.2
    have hT : IsAffineOpen (⊤ : U.1.toScheme.Opens) := isAffineOpen_top _
    have hV : IsAffineOpen (U.1.ι ''ᵁ (⊤ : U.1.toScheme.Opens)) :=
      hT.image_of_isOpenImmersion U.1.ι
    haveI := IsLocallyNoetherian.component_noetherian (X := X) ⟨_, hV⟩
    have hfg : (I.ideal ⟨_, hV⟩).FG := _root_.IsNoetherian.noetherian _
    obtain ⟨k, b, hb⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hG := I.ideal_comap_of_isOpenImmersion U.1.ι ⟨⊤, hT⟩
    have hset : (U.1.ι.appIso ⊤).hom.hom '' Set.range b =
        Set.range (fun i => (U.1.ι.appIso ⊤).hom.hom (b i)) := (Set.range_comp _ _).symm
    have hgen : (I.comap U.1.ι).ideal ⟨⊤, hT⟩ = Ideal.span (Set.range
        (Fin.cons (0 : Γ(U.1.toScheme, ⊤)) (fun i => (U.1.ι.appIso ⊤).hom.hom (b i)) :
          Fin (k + 1) → Γ(U.1.toScheme, ⊤))) := by
      rw [hG, ← isoIdeal, ← hb]
      change Ideal.map _ (Ideal.span (Set.range b)) = _
      rw [Ideal.map_span, hset, Fin.range_cons]
      first
        | exact Submodule.span_insert_zero.symm
        | exact (Ideal.span_insert_zero).symm
        | simp
    obtain ⟨P, rU, ι, hι, hfac, hblU⟩ := wc_csd_blowup_model K U.1.toScheme (U.1.ι ≫ fX)
      (I.comap U.1.ι) 0 k (fun _ => ⊤) (fun _ => hT)
      (fun _ => (Fin.cons (0 : Γ(U.1.toScheme, ⊤)) (fun i => (U.1.ι.appIso ⊤).hom.hom (b i)) :
          Fin (k + 1) → Γ(U.1.toScheme, ⊤)))
      (fun _ _ => 1) iSup_const (fun _ => hgen) (fun _ _ => isUnit_one)
      (fun _ _ _ => (one_mul _).symm)
    haveI := wc_proj_space_isProper K k
    haveI := hι
    haveI hrU : IsProper rU := by rw [← hfac]; infer_instance
    obtain ⟨κ', hκ', hcomm, hrange⟩ := wc_csd_blowup_open_restrict X U.1.toScheme X' P U.1.ι
      (I.comap U.1.ι) I r rU (hiff U.1) hbl hblU
    haveI := hκ'
    have hR : Set.range κ' = Set.range (r ⁻¹ᵁ U.1).ι := by
      ext x
      rw [hrange, Scheme.Opens.range_ι, Scheme.Opens.range_ι]
      all_goals exact Iff.rfl
    have he := IsOpenImmersion.isoOfRangeEq_hom_fac κ' (r ⁻¹ᵁ U.1).ι hR
    have claim : (IsOpenImmersion.isoOfRangeEq κ' (r ⁻¹ᵁ U.1).ι hR).hom ≫ (r ∣_ U.1) = rU := by
      rw [← cancel_mono U.1.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, he]
      exact hcomm
    have hres : r ∣_ U.1 = (IsOpenImmersion.isoOfRangeEq κ' (r ⁻¹ᵁ U.1).ι hR).inv ≫ rU := by
      rw [← claim, Iso.inv_hom_id_assoc]
    rw [hres]
    infer_instance
  exact ⟨X', r, hbl, IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsProper)
    (fun U : X.affineOpens => U.1) (iSup_affineOpens_eq_top X) hloc⟩

theorem wc_odp_smooth_of_closed_regular : ∀ (F : Type u) [Field F] [PerfectField F] (Z : Scheme.{u})
    (sZ : Z ⟶ Spec (.of F)) [LocallyOfFiniteType sZ] (d : ℕ),
    (∀ z : Z, IsClosed ({z} : Set Z) →
      (∃ (W : Z.Opens) (V : Scheme.{u}) (φ : V ⟶ Spec (.of F)) (ψ : (W : Scheme.{u}) ≅ V),
        z ∈ W ∧ SmoothOfRelativeDimension d φ ∧ ψ.hom ≫ φ = W.ι ≫ sZ) ∨
      (IsRegularLocalRing (Z.presheaf.stalk z) ∧
        ringKrullDim (Z.presheaf.stalk z) = (d : WithBot ℕ∞))) →
    SmoothOfRelativeDimension d sZ :=
by
  intro F _ _ Z sZ _ d H
  classical

  have s4 : ∀ (k S : Type u) [Field k] [CommRing S] [IsLocalRing S] [IsNoetherianRing S]
      [Algebra k S], Module.Free S Ω[S⁄k] → Subsingleton Ω[IsLocalRing.ResidueField S⁄k] →
      Module.finrank S Ω[S⁄k] ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal S) := by
    intro k S _ _ _ _ _ hfree hsub
    haveI := hfree
    have hsurj : Function.Surjective (algebraMap S (IsLocalRing.ResidueField S)) :=
      IsLocalRing.residue_surjective
    have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k S
      (IsLocalRing.ResidueField S) hsurj
    have hc : Function.Surjective
        (KaehlerDifferential.kerCotangentToTensor k S (IsLocalRing.ResidueField S)) := by
      intro y
      have h0 : KaehlerDifferential.mapBaseChange k S (IsLocalRing.ResidueField S) y = 0 :=
        Subsingleton.elim _ _
      exact (hex y).mp h0
    have hK : RingHom.ker (algebraMap S (IsLocalRing.ResidueField S)) =
        IsLocalRing.maximalIdeal S := IsLocalRing.ker_residue
    have hle : IsLocalRing.maximalIdeal S ≤ Ideal.comap (AlgHom.id S S)
        (RingHom.ker (algebraMap S (IsLocalRing.ResidueField S))) := by
      intro x hx
      rw [Ideal.mem_comap, AlgHom.id_apply, hK]
      exact hx
    let ι := Ideal.mapCotangent (IsLocalRing.maximalIdeal S)
      (RingHom.ker (algebraMap S (IsLocalRing.ResidueField S))) (AlgHom.id S S) hle
    have hι : Function.Surjective ι := by
      intro w
      obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective _ w
      have hx' : x ∈ IsLocalRing.maximalIdeal S := by rw [← hK]; exact hx
      refine ⟨(IsLocalRing.maximalIdeal S).toCotangent ⟨x, hx'⟩, ?_⟩
      rw [Ideal.mapCotangent_toCotangent]
      rfl
    let f : IsLocalRing.CotangentSpace S →ₗ[S]
        TensorProduct S (IsLocalRing.ResidueField S) Ω[S⁄k] :=
      (KaehlerDifferential.kerCotangentToTensor k S (IsLocalRing.ResidueField S)).comp ι
    have hf : Function.Surjective f := hc.comp hι
    let fκ := LinearMap.extendScalarsOfSurjective hsurj f
    have hfκ : Function.Surjective fκ := by
      intro y
      obtain ⟨x, hx⟩ := hf y
      exact ⟨x, by simpa [fκ, LinearMap.extendScalarsOfSurjective_apply] using hx⟩
    have h8 : Module.finrank (IsLocalRing.ResidueField S)
        (TensorProduct S (IsLocalRing.ResidueField S) Ω[S⁄k]) ≤
        Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) := by
      have h1 := LinearMap.finrank_range_le fκ
      rw [LinearMap.range_eq_top.mpr hfκ, finrank_top] at h1
      exact h1
    have h9 : Module.finrank (IsLocalRing.ResidueField S)
        (TensorProduct S (IsLocalRing.ResidueField S) Ω[S⁄k]) = Module.finrank S Ω[S⁄k] :=
      Module.finrank_baseChange
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace S, ← h9]
    exact h8

  have s3 : ∀ (k A S : Type u) [Field k] [PerfectField k] [CommRing A] [CommRing S]
      [IsLocalRing S] [Algebra k A] [Algebra.FiniteType k A] [Algebra A S] [Algebra k S]
      [IsScalarTower k A S] (m : Ideal A) [m.IsMaximal] [IsLocalization.AtPrime S m],
      Subsingleton Ω[IsLocalRing.ResidueField S⁄k] ∧
        Algebra.FormallySmooth k (IsLocalRing.ResidueField S) := by
    intro k A S _ _ _ _ _ _ _ _ _ _ m _ _
    let e₀ := IsLocalization.AtPrime.equivQuotMaximalIdeal m S
    have he : ∀ c : k, e₀ (algebraMap k (A ⧸ m) c) =
        algebraMap k (IsLocalRing.ResidueField S) c := by
      intro c
      rw [IsScalarTower.algebraMap_apply k A (A ⧸ m), Ideal.Quotient.algebraMap_eq,
        IsLocalization.AtPrime.equivQuotMaximalIdeal_apply_mk,
        IsScalarTower.algebraMap_apply k S (IsLocalRing.ResidueField S),
        IsScalarTower.algebraMap_apply k A S]
      rfl
    let e : (A ⧸ m) ≃ₐ[k] IsLocalRing.ResidueField S := AlgEquiv.ofRingEquiv (f := e₀) he
    letI : Field (A ⧸ m) := Ideal.Quotient.field m
    haveI : Algebra.FiniteType k (A ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m) (Ideal.Quotient.mkₐ_surjective k m)
    haveI : Module.Finite k (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ m)
    haveI : Module.Finite k (IsLocalRing.ResidueField S) := Module.Finite.equiv e.toLinearEquiv
    haveI : Algebra.IsSeparable k (IsLocalRing.ResidueField S) := inferInstance
    haveI := Algebra.FormallyUnramified.of_isSeparable k (IsLocalRing.ResidueField S)
    haveI := Algebra.FormallyEtale.of_isSeparable k (IsLocalRing.ResidueField S)
    exact ⟨inferInstance, inferInstance⟩

  have H9 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (m : Ideal A)
      [m.IsMaximal], ∃ (N : ℕ) (n : Ideal (MvPolynomial (Fin N) F)) (_ : n.IsMaximal)
      (ψ : Localization.AtPrime n →ₐ[F] Localization.AtPrime m), Function.Surjective ψ := by
    intro A _ _ hA m _
    obtain ⟨N, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hA
    set πr : MvPolynomial (Fin N) F →+* A := π.toRingHom with hπr
    have hπr' : Function.Surjective πr := hπ
    haveI hn : (Ideal.comap πr m).IsMaximal := Ideal.comap_isMaximal_of_surjective πr hπr'
    have hto : ∀ x, Localization.localRingHom (Ideal.comap πr m) m πr rfl
        (algebraMap _ (Localization.AtPrime (Ideal.comap πr m)) x) =
        algebraMap A (Localization.AtPrime m) (πr x) :=
      fun x => Localization.localRingHom_to_map (Ideal.comap πr m) m πr rfl x
    have hmk : ∀ (x : MvPolynomial (Fin N) F) (y : (Ideal.comap πr m).primeCompl),
        Localization.localRingHom (Ideal.comap πr m) m πr rfl
          (IsLocalization.mk' (Localization.AtPrime (Ideal.comap πr m)) x y) =
        IsLocalization.mk' (Localization.AtPrime m) (πr x) ⟨πr y, y.2⟩ :=
      fun x y => Localization.localRingHom_mk' (Ideal.comap πr m) m πr rfl x y
    let ψ : Localization.AtPrime (Ideal.comap πr m) →ₐ[F] Localization.AtPrime m :=
      { Localization.localRingHom (Ideal.comap πr m) m πr rfl with
        commutes' := fun r => by
          show Localization.localRingHom (Ideal.comap πr m) m πr rfl (algebraMap F _ r) = _
          rw [IsScalarTower.algebraMap_apply F (MvPolynomial (Fin N) F)
              (Localization.AtPrime (Ideal.comap πr m)), hto]
          have : πr (algebraMap F _ r) = algebraMap F A r := π.commutes r
          rw [this]
          exact (IsScalarTower.algebraMap_apply F A _ r).symm }
    refine ⟨N, Ideal.comap πr m, hn, ψ, ?_⟩
    intro y
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl y
    obtain ⟨a', ha'⟩ := hπr' a
    obtain ⟨s', hs'⟩ := hπr' (s : A)
    have hs'n : s' ∈ (Ideal.comap πr m).primeCompl := by
      show s' ∉ Ideal.comap πr m
      rw [Ideal.mem_comap, hs']
      exact s.2
    refine ⟨IsLocalization.mk' _ a' ⟨s', hs'n⟩, ?_⟩
    show Localization.localRingHom (Ideal.comap πr m) m πr rfl _ =
      IsLocalization.mk' (Localization.AtPrime m) a s
    rw [hmk, ha']
    congr 1
    ext
    exact hs'

  have hD : ∀ (T : Type u) [CommRing T], IsRegularLocalRing T → IsDomain T :=
    fun T _ hT => wcpa_regular_isDomain T wcpa_rs_quotient_regular hT
  have H10 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (m : Ideal A)
      [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m) →
      Algebra.FormallySmooth F (Localization.AtPrime m) := by
    intro A _ _ _ m _ hregm
    obtain ⟨N, n, hn, ψ, hψ⟩ := H9 A m
    haveI := hn
    obtain ⟨h1, h2, h3, h4, h5⟩ := wcpa_affine_local_smooth_data F N n
    have hRreg : IsRegularLocalRing (Localization.AtPrime n) := by
      have hdim : ringKrullDim (Localization.AtPrime n) = (n.height : WithBot ℕ∞) :=
        IsLocalization.AtPrime.ringKrullDim_eq_height n _
      have hN := wcpa_mvpoly_maximal_height F N n hn
      have he := wcpa_embdim_le_rank_omega F (Localization.AtPrime n) h1 h2 h3 h5
      rw [h4] at he
      have hle := ringKrullDim_le_spanFinrank_maximalIdeal (Localization.AtPrime n)
      refine IsRegularLocalRing.mk (le_antisymm ?_ hle)
      calc ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime n)) : ℕ)
            : WithBot ℕ∞) ≤ (((N : ℕ∞)) : WithBot ℕ∞) := by exact_mod_cast he
        _ ≤ (n.height : WithBot ℕ∞) := by exact_mod_cast hN
        _ = ringKrullDim (Localization.AtPrime n) := hdim.symm
    have hq : IsRegularLocalRing (Localization.AtPrime n ⧸ RingHom.ker ψ) :=
      IsRegularLocalRing.of_ringEquiv (Ideal.quotientKerAlgEquivOfSurjective hψ).toRingEquiv.symm
    have hcon := wcpa_regular_quotient_conormal (Localization.AtPrime n) hD
      wcpa_rs_quotient_regular (RingHom.ker ψ) hq
    exact wcpa_conormal_formallySmooth F (Localization.AtPrime n) (Localization.AtPrime m) ψ hψ
      h1 h2 h3 h5 hcon

  have s2 : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra F A] [Algebra.FiniteType F A]
      [Algebra A S] [Algebra F S] [IsScalarTower F A S] (m : Ideal A) [m.IsMaximal]
      [IsLocalization.AtPrime S m], IsRegularLocalRing S → Algebra.FormallySmooth F S := by
    intro A S _ _ _ _ _ _ _ m _ _ hreg
    let e : Localization.AtPrime m ≃ₐ[A] S :=
      IsLocalization.algEquiv m.primeCompl (Localization.AtPrime m) S
    haveI := hreg
    have hregm : IsRegularLocalRing (Localization.AtPrime m) :=
      IsRegularLocalRing.of_ringEquiv e.symm.toRingEquiv
    haveI := H10 A m hregm
    exact Algebra.FormallySmooth.of_equiv (e.restrictScalars F)

  have hnbhd : ∀ z : Z, IsClosed ({z} : Set Z) →
      ∃ U : Z.Opens, z ∈ U ∧ SmoothOfRelativeDimension d (U.ι ≫ sZ) := by
    intro z hz
    rcases H z hz with ⟨W, V, φ, ψ, hzW, hφ, hc⟩ | ⟨hreg, hdim⟩
    ·
      refine ⟨W, hzW, ?_⟩
      rw [← hc]
      haveI := hφ
      have h0 := smoothOfRelativeDimension_comp 0 d ψ.hom φ
      simpa using h0
    ·
      obtain ⟨V, hV, hzV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
      have e₀ : V ≤ sZ ⁻¹ᵁ ⊤ := fun _ _ => trivial
      letI algA : Algebra F Γ(Z, V) :=
        ((sZ.appLE ⊤ V e₀).hom.comp (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom).toAlgebra
      letI algS : Algebra Γ(Z, V) (Z.presheaf.stalk z) :=
        TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hzV⟩
      letI algF : Algebra F (Z.presheaf.stalk z) := (wcLdpConst F sZ z).toAlgebra
      haveI hloc : IsLocalization.AtPrime (Z.presheaf.stalk z)
          (hV.primeIdealOf ⟨z, hzV⟩).asIdeal := hV.isLocalization_stalk ⟨z, hzV⟩

      haveI hft : Algebra.FiniteType F Γ(Z, V) := by
        have hφ : (sZ.appLE ⊤ V e₀).hom.FiniteType :=
          HasRingHomProperty.appLE @LocallyOfFiniteType sZ inferInstance
            ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ e₀
        have hsurjΓ : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom :=
          ((Scheme.ΓSpecIso (CommRingCat.of F)).symm.commRingCatIsoToRingEquiv).surjective
        have h : ((sZ.appLE ⊤ V e₀).hom.comp
            (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom).FiniteType :=
          hφ.comp (RingHom.FiniteType.of_surjective _ hsurjΓ)
        exact h

      haveI hmax : (hV.primeIdealOf ⟨z, hzV⟩).asIdeal.IsMaximal := by
        apply (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp
        haveI := hV.isOpenImmersion_fromSpec
        have hinj : Function.Injective hV.fromSpec := hV.fromSpec.isOpenEmbedding.injective
        have hpre : (hV.fromSpec ⁻¹' {z} : Set _) = {hV.primeIdealOf ⟨z, hzV⟩} := by
          ext p
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          constructor
          · intro hp
            apply hinj
            rw [hp, hV.fromSpec_primeIdealOf]
          · intro hp
            rw [hp, hV.fromSpec_primeIdealOf]
        have hc : IsClosed (hV.fromSpec ⁻¹' {z}) := hz.preimage hV.fromSpec.continuous
        first
          | (convert hc using 1; exact hpre.symm)
          | exact (hpre ▸ hc)
          | (rw [hpre] at hc; exact hc)

      have key : sZ.appTop ≫ Z.presheaf.germ ⊤ z trivial =
          sZ.appLE ⊤ V e₀ ≫ Z.presheaf.germ V z hzV := by
        rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
        rfl
      haveI hst : IsScalarTower F Γ(Z, V) (Z.presheaf.stalk z) := by
        apply IsScalarTower.of_algebraMap_eq'
        ext c
        exact congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom c)) key

      haveI := hreg
      have hfs : Algebra.FormallySmooth F (Z.presheaf.stalk z) :=
        s2 Γ(Z, V) (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hzV⟩).asIdeal hreg
      haveI := hfs
      haveI : Algebra.EssFiniteType F Γ(Z, V) := Algebra.EssFiniteType.of_finiteType F Γ(Z, V)
      haveI : Algebra.EssFiniteType Γ(Z, V) (Z.presheaf.stalk z) :=
        Algebra.EssFiniteType.of_isLocalization (Z.presheaf.stalk z)
          (hV.primeIdealOf ⟨z, hzV⟩).asIdeal.primeCompl
      haveI : Algebra.EssFiniteType F (Z.presheaf.stalk z) :=
        Algebra.EssFiniteType.comp F Γ(Z, V) (Z.presheaf.stalk z)
      haveI hfin : Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄F] :=
        KaehlerDifferential.finite F _
      haveI hfree : Module.Free (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄F] :=
        Module.free_of_flat_of_isLocalRing
      obtain ⟨hsub, hκ⟩ := s3 F Γ(Z, V) (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hzV⟩).asIdeal
      have hge := wcpa_embdim_le_rank_omega F (Z.presheaf.stalk z) hfs hfree hfin hκ
      have hle := s4 F (Z.presheaf.stalk z) hfree hsub
      have hemb : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) : ℕ) :
          WithBot ℕ∞) = ((d : ℕ) : WithBot ℕ∞) := by
        rw [IsRegularLocalRing.spanFinrank_maximalIdeal, hdim]
      have hemb' : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) = d := by
        exact_mod_cast hemb
      have hrk : Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄F] = d := by omega
      exact wc_ldp_il_spread_abs F sZ d z hfs hfree hfin hrk

  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension d) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace sZ
  choose U hzU hsm using hnbhd
  apply IsZariskiLocalAtSource.of_iSup_eq_top
    (fun i : {z : Z // IsClosed ({z} : Set Z)} => U i.1 i.2)
  · apply top_unique
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    have hC : IsClosed (closure ({x} : Set Z)) := isClosed_closure
    have h1 := JacobsonSpace.closure_inter_closedPoints hC
    have hne : (closure (closure ({x} : Set Z) ∩ closedPoints Z)).Nonempty := by
      rw [h1]
      exact ⟨x, subset_closure (Set.mem_singleton x)⟩
    obtain ⟨y, hyC, hycl⟩ := hne.of_closure
    have hy : IsClosed ({y} : Set Z) := mem_closedPoints_iff.mp hycl
    have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hyC
    exact ⟨⟨y, hy⟩, hxy.mem_open (U y hy).isOpen (hzU y hy)⟩
  · intro i
    exact hsm i.1 i.2

theorem wc_odp_residue_algClosed : ∀ (K : Type u) [Field K] [IsAlgClosed K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [LocallyOfFiniteType fP] (xb : P), IsClosed ({xb} : Set P) →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] (h : R),
    Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) →
    IsAlgClosed (IsLocalRing.ResidueField R) :=
by
  intro K _ _ P fP _ xb hxb R _ _ h hσ
  obtain ⟨σ⟩ := hσ
  haveI : JacobsonSpace (Spec (.of K)) :=
    (PrimeSpectrum.isJacobsonRing_iff_jacobsonSpace (R := K)).mp inferInstance
  haveI : JacobsonSpace P := LocallyOfFiniteType.jacobsonSpace fP
  haveI : LocallyOfFiniteType (P.fromSpecResidueField xb) :=
    isClosed_singleton_iff_locallyOfFiniteType.mp hxb
  have hg : LocallyOfFiniteType (Spec.map (Spec.preimage (P.fromSpecResidueField xb ≫ fP))) := by
    rw [Spec.map_preimage]; infer_instance
  have hft : (Spec.preimage (P.fromSpecResidueField xb ≫ fP)).hom.FiniteType :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hg
  letI : Algebra K (P.residueField xb) := (Spec.preimage (P.fromSpecResidueField xb ≫ fP)).hom.toAlgebra
  haveI : Algebra.FiniteType K (P.residueField xb) := hft
  haveI : Module.Finite K (P.residueField xb) := finite_of_finite_type_of_isJacobsonRing K _
  have hbij : Function.Bijective (algebraMap K (P.residueField xb)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  haveI hL : IsAlgClosed (P.residueField xb) :=
    IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective (algebraMap K _) hbij)
  let ψ : R →+* P.presheaf.stalk xb := σ.symm.toRingHom.comp (Ideal.Quotient.mk _)
  have hψ : Function.Surjective ψ := σ.symm.surjective.comp Ideal.Quotient.mk_surjective
  haveI : IsLocalHom ψ := hψ.isLocalHom ψ
  have hsurj : Function.Surjective (IsLocalRing.ResidueField.map ψ) := by
    intro y
    obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨r, rfl⟩ := hψ s
    exact ⟨IsLocalRing.residue R r, IsLocalRing.ResidueField.map_residue ψ r⟩
  haveI : IsAlgClosed (IsLocalRing.ResidueField (P.presheaf.stalk xb)) := hL
  exact IsAlgClosed.of_ringEquiv _ _
    (RingEquiv.ofBijective (IsLocalRing.ResidueField.map ψ)
      ⟨(IsLocalRing.ResidueField.map ψ).injective, hsurj⟩).symm

theorem wc_odp_chart_nzd : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (n : ℕ)
    (t : Fin n → R) (M : Matrix (Fin n) (Fin n) R) (j : Fin n) (g : MvPolynomial (Fin n) R),
    ringKrullDim R = n → IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    IsUnit (M + M.transpose).det →
    g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
      wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} →
    algebraMap R (wcOdpB t j g) (t j) ∈ nonZeroDivisors (wcOdpB t j g) ∧
    ∀ (β : Ideal (wcOdpB t j g)) [β.IsPrime] (C : Type u) [CommRing C] [Algebra (wcOdpB t j g) C]
      [IsLocalization.AtPrime C β],
      algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) ∈ nonZeroDivisors C :=
by
  intro R _ _ _ n t M j g hdim hmax hdet hG2

  have swap : ∀ (S : Type u) [CommRing S] (I : Ideal S) (a u : S),
      (∀ x : S, a * x ∈ I → x ∈ I) →
      (∀ y : S, u * y ∈ I ⊔ Ideal.span {a} → y ∈ I ⊔ Ideal.span {a}) →
      ∀ x : S, a * x ∈ I ⊔ Ideal.span {u} → x ∈ I ⊔ Ideal.span {u} := by
    intro S _ I a u H1 H2 x hx
    obtain ⟨i, hi, v, hv, hiv⟩ := Submodule.mem_sup.1 hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hv
    have hc : u * c ∈ I ⊔ Ideal.span {a} := by
      have e : u * c = a * x - i := by rw [← hiv]; ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.mem_sup_right (Ideal.mem_span_singleton'.2 ⟨x, mul_comm x a⟩))
        (Ideal.mem_sup_left hi)
    obtain ⟨i', hi', w, hw, hiw⟩ := Submodule.mem_sup.1 (H2 c hc)
    obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.1 hw
    have h3 : a * (x - u * z) ∈ I := by
      have e : a * (x - u * z) = i + u * i' := by
        have e1 : a * x = i + c * u := hiv.symm
        rw [← hiw] at e1
        linear_combination e1
      rw [e]
      exact I.add_mem hi (I.mul_mem_left u hi')
    have h4 := H1 _ h3
    exact Submodule.mem_sup.2 ⟨_, h4, z * u, Ideal.mem_span_singleton'.2 ⟨z, rfl⟩, by ring⟩

  have hF : ∀ T : Finset (Fin n), (Ideal.span (t '' ↑T)).IsPrime ∧
      ∀ b ∉ T, t b ∉ Ideal.span (t '' ↑T) := by
    classical
    have hsf_le : (IsLocalRing.maximalIdeal R).spanFinrank ≤ n := by
      rw [hmax]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range t)).trans ?_
      rw [← Set.image_univ, ← Finset.coe_univ, ← Finset.coe_image, Set.ncard_coe_finset]
      exact Finset.card_image_le.trans (by simp)
    have hle : ringKrullDim R ≤ ((IsLocalRing.maximalIdeal R).spanFinrank : WithBot ℕ∞) :=
      ringKrullDim_le_spanFinrank_maximalIdeal R
    have hsf : (IsLocalRing.maximalIdeal R).spanFinrank = n := by
      rw [hdim] at hle
      have h2 : n ≤ (IsLocalRing.maximalIdeal R).spanFinrank := by exact_mod_cast hle
      omega
    haveI hreg : IsRegularLocalRing R := { spanFinrank_maximalIdeal := by rw [hsf, hdim] }
    have ht : ∀ i, t i ∈ IsLocalRing.maximalIdeal R := fun i => hmax ▸ Ideal.subset_span ⟨i, rfl⟩
    obtain ⟨xm, hxm⟩ : ∃ xm : Fin n → IsLocalRing.maximalIdeal R, xm = fun i => ⟨t i, ht i⟩ :=
      ⟨_, rfl⟩
    have hspanR : Submodule.span R (Set.range xm) = ⊤ := by
      apply Submodule.map_injective_of_injective (Submodule.injective_subtype _)
      rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
      have e : (⇑(IsLocalRing.maximalIdeal R).subtype ∘ xm) = t := by
        funext i; rw [hxm]; rfl
      rw [e, hmax]
      try rfl
    have hfr : Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) = n :=
      (IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R).symm.trans hsf
    have hli : LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (xm i)) := by
      apply linearIndependent_of_top_le_span_of_card_eq_finrank
      · have h1 := (IsLocalRing.CotangentSpace.span_image_eq_top_iff (s := Set.range xm)).2 hspanR
        rw [← Set.range_comp] at h1
        exact h1.ge
      · rw [Fintype.card_fin, hfr]
    have key : ∀ T : Finset (Fin n), IsRegularLocalRing (R ⧸ Ideal.span (t '' ↑T)) ∧
        ringKrullDim (R ⧸ Ideal.span (t '' ↑T)) + (T.card : WithBot ℕ∞) = ringKrullDim R := by
      intro T
      set e : Fin T.card ≃ T := T.equivFin.symm with he
      obtain ⟨x, hx⟩ : ∃ x : Fin T.card → IsLocalRing.maximalIdeal R, x = fun i => xm (e i) :=
        ⟨_, rfl⟩
      have hlix : LinearIndependent (IsLocalRing.ResidueField R)
          (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) := by
        rw [hx]
        exact hli.comp (fun i => ((e i : T) : Fin n)) (Subtype.val_injective.comp e.injective)
      have hrange : Set.range (fun i => (x i : R)) = t '' ↑T := by
        ext y
        constructor
        · rintro ⟨i, rfl⟩
          refine ⟨(e i : Fin n), (e i).2, ?_⟩
          rw [hx, hxm]
        · rintro ⟨c, hc, rfl⟩
          refine ⟨e.symm ⟨c, hc⟩, ?_⟩
          rw [hx, hxm]
          simp
      have h := wcpa_rs_quotient_regular R T.card x hlix
      rw [hrange] at h
      exact h
    intro T
    refine ⟨?_, ?_⟩
    · haveI := (key T).1
      have hd : IsDomain (R ⧸ Ideal.span (t '' ↑T)) :=
        wcpa_regular_isDomain _ wcpa_rs_quotient_regular (key T).1
      exact (Ideal.Quotient.isDomain_iff_prime _).1 hd
    · intro b hb hmem
      have heq : Ideal.span (t '' ↑(insert b T)) = Ideal.span (t '' ↑T) := by
        rw [Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert]
        exact sup_eq_right.2 ((Ideal.span_singleton_le_iff_mem _).2 hmem)
      have h1 := (key T).2
      have h2 := (key (insert b T)).2
      rw [heq, Finset.card_insert_of_notMem hb, hdim] at h2
      rw [hdim] at h1
      push_cast at h2
      rw [← add_assoc, h1] at h2
      have h3 : ((n + 1 : ℕ) : WithBot ℕ∞) = (n : WithBot ℕ∞) := by push_cast; exact h2
      have h4 : n + 1 = n := by exact_mod_cast h3
      omega

  have kern : ∀ (T : Finset (Fin n)) (x : MvPolynomial (Fin n) R),
      x ∈ Ideal.span (insert (MvPolynomial.X j - 1) ((fun b => MvPolynomial.C (t j) *
        MvPolynomial.X b - MvPolynomial.C (t b)) '' ↑T)) ⊔ Ideal.span {MvPolynomial.C (t j)} ↔
      MvPolynomial.eval₂Hom (MvPolynomial.C.comp (Ideal.Quotient.mk
        (Ideal.span (insert (t j) (t '' ↑T))))) (fun b => if b = j then
        (1 : MvPolynomial (Fin n) (R ⧸ Ideal.span (insert (t j) (t '' ↑T)))) else
        MvPolynomial.X b) x = 0 := by
    intro T x
    obtain ⟨𝔞, h𝔞⟩ : ∃ 𝔞 : Ideal R, 𝔞 = Ideal.span (insert (t j) (t '' ↑T)) := ⟨_, rfl⟩
    rw [← h𝔞]
    obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (R ⧸ 𝔞),
        φ = MvPolynomial.eval₂Hom (MvPolynomial.C.comp (Ideal.Quotient.mk 𝔞))
          (fun b => if b = j then (1 : MvPolynomial (Fin n) (R ⧸ 𝔞)) else MvPolynomial.X b) :=
      ⟨_, rfl⟩
    rw [← hφ]
    obtain ⟨K, hK⟩ : ∃ K : Ideal (MvPolynomial (Fin n) R), K = Ideal.span
        (insert (MvPolynomial.X j - 1)
        ((fun b => MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)) '' ↑T)) ⊔
        Ideal.span {MvPolynomial.C (t j)} := ⟨_, rfl⟩
    rw [← hK]
    have htj : Ideal.Quotient.mk 𝔞 (t j) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, h𝔞]
      exact Ideal.subset_span (Set.mem_insert _ _)
    have htb : ∀ b ∈ T, Ideal.Quotient.mk 𝔞 (t b) = 0 := by
      intro b hb
      rw [Ideal.Quotient.eq_zero_iff_mem, h𝔞]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_image_of_mem t hb))
    have hu : MvPolynomial.X j - 1 ∈ K := by
      rw [hK]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hCtj : MvPolynomial.C (t j) ∈ K := by
      rw [hK]; exact Ideal.mem_sup_right (Ideal.subset_span rfl)
    have hfK : ∀ b ∈ T, MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈ K := by
      intro b hb
      rw [hK]
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, hb, rfl⟩))
    constructor
    · intro hx
      have hle : K ≤ RingHom.ker φ := by
        rw [hK]
        apply sup_le
        · rw [Ideal.span_le]
          intro p hp
          rcases hp with rfl | ⟨b, hb, rfl⟩
          · simp [hφ]
          · by_cases hbj : b = j
            · simp [hφ, htj, htb b hb, hbj]
            · simp [hφ, htj, htb b hb, hbj]
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          simp [hφ, htj]
      exact hle hx
    · intro hx
      obtain ⟨π, hπ⟩ : ∃ π : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n) R,
          π = MvPolynomial.aeval (fun b => if b = j then 1 else MvPolynomial.X b) := ⟨_, rfl⟩
      have hfac : ∀ p, φ p = MvPolynomial.map (Ideal.Quotient.mk 𝔞) (π p) := by
        have e : φ = (MvPolynomial.map (Ideal.Quotient.mk 𝔞)).comp
            (π : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) R) := by
          apply MvPolynomial.ringHom_ext
          · intro r
            simp [hφ, hπ]
          · intro b
            by_cases hb : b = j
            · simp [hφ, hπ, hb]
            · simp [hφ, hπ, hb]
        intro p
        rw [e]
        rfl
      have hdiff : ∀ p, p - π p ∈ Ideal.span {MvPolynomial.X j - 1} := by
        intro p
        induction p using MvPolynomial.induction_on
        next r =>
          rw [hπ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, sub_self]
          exact Ideal.zero_mem _
        next p q hp hq =>
          rw [map_add, add_sub_add_comm]
          exact Ideal.add_mem _ hp hq
        next p b hp =>
          rw [map_mul]
          have e : p * MvPolynomial.X b - π p * π (MvPolynomial.X b) =
              (p - π p) * MvPolynomial.X b + π p * (MvPolynomial.X b - π (MvPolynomial.X b)) := by
            ring
          rw [e]
          refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
          by_cases hb : b = j
          · rw [hπ, MvPolynomial.aeval_X, if_pos hb, hb]
            exact Ideal.mem_span_singleton_self _
          · rw [hπ, MvPolynomial.aeval_X, if_neg hb, sub_self]
            exact Ideal.zero_mem _
      have hπx : π x ∈ K := by
        have h1 : π x ∈ RingHom.ker
            (MvPolynomial.map (Ideal.Quotient.mk 𝔞) : MvPolynomial (Fin n) R →+* _) := by
          rw [RingHom.mem_ker, ← hfac]
          exact hx
        rw [MvPolynomial.ker_map, Ideal.mk_ker, h𝔞, Ideal.map_span] at h1
        refine (Ideal.span_le.mpr ?_) h1
        rintro p ⟨r, hr, rfl⟩
        rcases hr with rfl | ⟨b, hb, rfl⟩
        · exact hCtj
        · have e : MvPolynomial.C (t b) = MvPolynomial.C (t j) * MvPolynomial.X b -
              (MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)) := by ring
          show MvPolynomial.C (t b) ∈ K
          rw [e]
          exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ hCtj) (hfK b hb)
      have hd : x - π x ∈ K :=
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu)) (hdiff x)
      have := Ideal.add_mem _ hd hπx
      simpa using this

  have quad : ∀ (k : Type u) [CommRing k] [Nontrivial k] (m : Matrix (Fin n) (Fin n) k),
      IsUnit (m + m.transpose).det →
      (∑ a, ∑ c, MvPolynomial.C (m a c) *
        (if a = j then (1 : MvPolynomial (Fin n) k) else MvPolynomial.X a) *
        (if c = j then (1 : MvPolynomial (Fin n) k) else MvPolynomial.X c)) ≠ 0 := by
    intro k _ _ m hdetm hP
    obtain ⟨Y, hYdef⟩ : ∃ Y : Fin n → MvPolynomial (Fin n) k,
        Y = fun b => if b = j then (1 : MvPolynomial (Fin n) k) else MvPolynomial.X b := ⟨_, rfl⟩
    have hP' : ∑ x, ∑ y, MvPolynomial.C (m x y) * (Y x * Y y) = 0 := by
      rw [← hP, hYdef]
      refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun c _ => ?_))
      rw [mul_assoc]
    have hY0 : ∀ b, MvPolynomial.constantCoeff (Y b) = if b = j then (1 : k) else 0 := by
      intro b
      by_cases hb : b = j <;> simp [hYdef, hb]
    have hYd : ∀ a, a ≠ j → ∀ b, MvPolynomial.pderiv a (Y b) =
        MvPolynomial.C (if b = a then (1 : k) else 0) := by
      intro a ha b
      by_cases hb : b = j
      · have hba : ¬ b = a := fun h => ha (h ▸ hb)
        have hja : ¬ j = a := fun h => ha h.symm
        simp [hYdef, hb, hja]
      · by_cases hba : b = a
        · subst hba
          simp [hYdef, hb, MvPolynomial.pderiv_X]
        · simp [hYdef, hb, hba, MvPolynomial.pderiv_X, Pi.single_apply]
    have hd : ∀ a, a ≠ j → ∀ x y, MvPolynomial.pderiv a (MvPolynomial.C (m x y) * (Y x * Y y)) =
        MvPolynomial.C (m x y) * (MvPolynomial.C (if y = a then (1 : k) else 0) * Y x +
          MvPolynomial.C (if x = a then (1 : k) else 0) * Y y) := by
      intro a ha x y
      rw [MvPolynomial.pderiv_C_mul, Derivation.leibniz, hYd a ha, hYd a ha, smul_eq_mul,
        smul_eq_mul]
      ring
    have hc0 : ∀ x y, MvPolynomial.constantCoeff (MvPolynomial.C (m x y) * (Y x * Y y)) =
        m x y * ((if x = j then (1 : k) else 0) * (if y = j then (1 : k) else 0)) := by
      intro x y
      simp only [map_mul, MvPolynomial.constantCoeff_C, hY0]
    have hc1 : ∀ a, a ≠ j → ∀ x y, MvPolynomial.constantCoeff
        (MvPolynomial.pderiv a (MvPolynomial.C (m x y) * (Y x * Y y))) =
        m x y * ((if y = a then (1 : k) else 0) * (if x = j then (1 : k) else 0) +
          (if x = a then (1 : k) else 0) * (if y = j then (1 : k) else 0)) := by
      intro a ha x y
      rw [hd a ha x y]
      simp only [map_mul, map_add, MvPolynomial.constantCoeff_C, hY0]
    have hc2 : ∀ a c, a ≠ j → c ≠ j → ∀ x y, MvPolynomial.constantCoeff
        (MvPolynomial.pderiv c (MvPolynomial.pderiv a (MvPolynomial.C (m x y) * (Y x * Y y)))) =
        m x y * ((if y = a then (1 : k) else 0) * (if x = c then (1 : k) else 0) +
          (if x = a then (1 : k) else 0) * (if y = c then (1 : k) else 0)) := by
      intro a c ha hc x y
      rw [hd a ha x y]
      simp only [MvPolynomial.pderiv_C_mul, map_add, hYd c hc, map_mul,
        MvPolynomial.constantCoeff_C]
    have hjj : m j j = 0 := by
      have := congrArg MvPolynomial.constantCoeff hP'
      simp only [map_sum, hc0, map_zero] at this
      simpa [mul_ite, ite_mul, Finset.sum_ite_eq', Finset.sum_ite_eq] using this
    have haj : ∀ a, a ≠ j → m a j + m j a = 0 := by
      intro a ha
      have := congrArg (fun p => MvPolynomial.constantCoeff (MvPolynomial.pderiv a p)) hP'
      simp only [map_sum, hc1 a ha, map_zero] at this
      simp [mul_add, Finset.sum_add_distrib, mul_ite, ite_mul, Finset.sum_ite_eq',
        Finset.sum_ite_eq] at this
      linear_combination this
    have hac : ∀ a c, a ≠ j → c ≠ j → m a c + m c a = 0 := by
      intro a c ha hc
      have := congrArg (fun p => MvPolynomial.constantCoeff
        (MvPolynomial.pderiv c (MvPolynomial.pderiv a p))) hP'
      simp only [map_sum, hc2 a c ha hc, map_zero] at this
      simp [mul_add, Finset.sum_add_distrib, mul_ite, ite_mul, Finset.sum_ite_eq',
        Finset.sum_ite_eq] at this
      linear_combination this
    have hzero : ∀ a c, (m + m.transpose) a c = 0 := by
      intro a c
      rw [Matrix.add_apply, Matrix.transpose_apply]
      by_cases ha : a = j
      · by_cases hc : c = j
        · rw [ha, hc, hjj, add_zero]
        · rw [ha, add_comm]; exact haj c hc
      · by_cases hc : c = j
        · rw [hc]; exact haj a ha
        · exact hac a c ha hc
    have h0 : m + m.transpose = 0 := by
      ext a c; rw [hzero a c]; rfl
    haveI : Nonempty (Fin n) := ⟨j⟩
    rw [h0, Matrix.det_zero] at hdetm
    exact not_isUnit_zero hdetm

  have hs5 : ∀ x : MvPolynomial (Fin n) R, MvPolynomial.C (t j) * x ∈ wcOdpJ0 t j →
      x ∈ wcOdpJ0 t j := by
    obtain ⟨Iof, hIof⟩ : ∃ Iof : Finset (Fin n) → Ideal (MvPolynomial (Fin n) R), ∀ T, Iof T =
        Ideal.span (insert (MvPolynomial.X j - 1)
          ((fun b => MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)) '' ↑T)) :=
      ⟨_, fun _ => rfl⟩
    have hdom : ∀ (T : Finset (Fin n)) (p y : MvPolynomial (Fin n) R),
        MvPolynomial.map (Ideal.Quotient.mk (Ideal.span (t '' ↑T))) p ≠ 0 →
        p * y ∈ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) (Ideal.span (t '' ↑T)) →
        y ∈ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) (Ideal.span (t '' ↑T)) := by
      intro T p y hp hpy
      haveI := (hF T).1
      have hk := MvPolynomial.ker_map (σ := Fin n) (Ideal.Quotient.mk (Ideal.span (t '' ↑T)))
      rw [Ideal.mk_ker] at hk
      rw [← hk, RingHom.mem_ker] at hpy ⊢
      rw [map_mul] at hpy
      exact (mul_eq_zero.mp hpy).resolve_left hp
    have hbase : ∀ x, MvPolynomial.C (t j) * x ∈ Iof ∅ → x ∈ Iof ∅ := by
      have hI0 : Iof ∅ = ⊥ ⊔ Ideal.span {MvPolynomial.X j - 1} := by
        rw [hIof]; simp
      rw [hI0]
      apply swap _ ⊥ (MvPolynomial.C (t j)) (MvPolynomial.X j - 1)
      · intro x hx
        have h0 : Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)
            (Ideal.span (t '' ↑(∅ : Finset (Fin n)))) = ⊥ := by simp
        rw [← h0] at hx ⊢
        refine hdom ∅ _ x ?_ hx
        rw [MvPolynomial.map_C]
        intro hc
        rw [MvPolynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem] at hc
        exact (hF ∅).2 j (by simp) hc
      · intro y hy
        have h1 : Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)
            (Ideal.span (t '' ↑({j} : Finset (Fin n)))) =
            ⊥ ⊔ Ideal.span {MvPolynomial.C (t j)} := by
          rw [bot_sup_eq, Finset.coe_singleton, Set.image_singleton, Ideal.map_span,
            Set.image_singleton]
        rw [← h1] at hy ⊢
        refine hdom {j} _ y ?_ hy
        haveI := (hF {j}).1
        haveI : Nontrivial (R ⧸ Ideal.span (t '' ↑({j} : Finset (Fin n)))) := inferInstance
        rw [map_sub, MvPolynomial.map_X, map_one]
        intro h
        have := congrArg (MvPolynomial.eval
          (0 : Fin n → R ⧸ Ideal.span (t '' ↑({j} : Finset (Fin n))))) h
        simp at this
    have hstep : ∀ (b : Fin n) (T : Finset (Fin n)), b ∉ T →
        (∀ x, MvPolynomial.C (t j) * x ∈ Iof T → x ∈ Iof T) →
        ∀ x, MvPolynomial.C (t j) * x ∈ Iof (insert b T) → x ∈ Iof (insert b T) := by
      intro b T hbT ih
      by_cases hbj : b = j
      · have e : Iof (insert b T) = Iof T := by
          rw [hIof, hIof, Finset.coe_insert, Set.image_insert_eq, Set.insert_comm,
            Ideal.span_insert]
          apply sup_eq_right.mpr
          rw [Ideal.span_singleton_le_iff_mem]
          show MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈ _
          rw [hbj, show MvPolynomial.C (t j) * MvPolynomial.X j - MvPolynomial.C (t j) =
            MvPolynomial.C (t j) * (MvPolynomial.X j - 1) by ring]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
        rw [e]
        exact ih
      · have e : Iof (insert b T) = Iof T ⊔
            Ideal.span {MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)} := by
          rw [hIof, hIof, Finset.coe_insert, Set.image_insert_eq, Set.insert_comm,
            Ideal.span_insert, sup_comm]
        rw [e]
        apply swap _ (Iof T) (MvPolynomial.C (t j)) _ ih
        intro y hy
        rw [hIof] at hy ⊢
        rw [kern T] at hy ⊢
        rw [map_mul] at hy
        have hsub : Ideal.span (insert (t j) (t '' ↑T)) = Ideal.span (t '' ↑(insert j T)) := by
          rw [Finset.coe_insert, Set.image_insert_eq]
        haveI hP : (Ideal.span (insert (t j) (t '' ↑T))).IsPrime := by
          rw [hsub]; exact (hF _).1
        have hnot : t b ∉ Ideal.span (insert (t j) (t '' ↑T)) := by
          rw [hsub]
          apply (hF _).2 b
          simp [hbj, hbT]
        have htj : Ideal.Quotient.mk (Ideal.span (insert (t j) (t '' ↑T))) (t j) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
        have hfb : MvPolynomial.eval₂Hom (MvPolynomial.C.comp (Ideal.Quotient.mk
            (Ideal.span (insert (t j) (t '' ↑T))))) (fun b => if b = j then
            (1 : MvPolynomial (Fin n) (R ⧸ Ideal.span (insert (t j) (t '' ↑T)))) else
            MvPolynomial.X b)
            (MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)) ≠ 0 := by
          intro h
          simp only [map_sub, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
            RingHom.comp_apply, if_neg hbj, htj, map_zero, zero_mul, zero_sub, neg_eq_zero,
            MvPolynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem] at h
          exact hnot h
        exact (mul_eq_zero.mp hy).resolve_left hfb
    have hall : ∀ T : Finset (Fin n), ∀ x, MvPolynomial.C (t j) * x ∈ Iof T → x ∈ Iof T := by
      intro T
      induction T using Finset.induction_on with
      | empty => exact hbase
      | insert b T hbT ih => exact hstep b T hbT ih
    have hU : Iof Finset.univ = wcOdpJ0 t j := by
      rw [hIof, Finset.coe_univ, Set.image_univ]
      rfl
    rw [← hU]
    exact hall Finset.univ

  have hJ : Ideal.span (insert (MvPolynomial.X j - 1)
      ((fun b => MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)) ''
        ↑(Finset.univ : Finset (Fin n)))) = wcOdpJ0 t j := by
    rw [Finset.coe_univ, Set.image_univ]
    rfl
  obtain ⟨𝔞, h𝔞⟩ : ∃ 𝔞 : Ideal R,
      𝔞 = Ideal.span (insert (t j) (t '' ↑(Finset.univ : Finset (Fin n)))) := ⟨_, rfl⟩
  have hp : 𝔞.IsPrime := by
    have e : insert (t j) (t '' ↑(Finset.univ : Finset (Fin n))) =
        t '' ↑(Finset.univ : Finset (Fin n)) :=
      Set.insert_eq_of_mem (Set.mem_image_of_mem t (Finset.mem_coe.2 (Finset.mem_univ j)))
    rw [h𝔞, e]
    exact (hF Finset.univ).1
  haveI := hp
  obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (R ⧸ 𝔞),
      φ = MvPolynomial.eval₂Hom (MvPolynomial.C.comp (Ideal.Quotient.mk 𝔞))
        (fun b => if b = j then (1 : MvPolynomial (Fin n) (R ⧸ 𝔞)) else MvPolynomial.X b) :=
    ⟨_, rfl⟩
  have hker : ∀ x, x ∈ wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} ↔ φ x = 0 := by
    intro x
    rw [← hJ, hφ]
    subst h𝔞
    exact kern Finset.univ x
  have hq : φ (∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c) =
      ∑ a, ∑ c, MvPolynomial.C ((M.map (Ideal.Quotient.mk 𝔞)) a c) *
        (if a = j then (1 : MvPolynomial (Fin n) (R ⧸ 𝔞)) else MvPolynomial.X a) *
        (if c = j then (1 : MvPolynomial (Fin n) (R ⧸ 𝔞)) else MvPolynomial.X c) := by
    rw [hφ]
    simp only [map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
      RingHom.comp_apply, Matrix.map_apply]
  have hdet' : IsUnit ((M.map (Ideal.Quotient.mk 𝔞)) +
      (M.map (Ideal.Quotient.mk 𝔞)).transpose).det := by
    have e : (M.map (Ideal.Quotient.mk 𝔞)) + (M.map (Ideal.Quotient.mk 𝔞)).transpose =
        (Ideal.Quotient.mk 𝔞).mapMatrix (M + M.transpose) := by
      ext a c
      simp [Matrix.map_apply]
    rw [e, ← RingHom.map_det]
    exact hdet.map _
  have hφg : φ g ≠ 0 := by
    have h1 : φ (g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c)
        = 0 := (hker _).1 hG2
    rw [map_sub, sub_eq_zero, hq] at h1
    rw [h1]
    exact quad (R ⧸ 𝔞) (M.map (Ideal.Quotient.mk 𝔞)) hdet'
  have hs6 : ∀ y, g * y ∈ wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} →
      y ∈ wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} := by
    intro y hy
    rw [hker] at hy ⊢
    rw [map_mul] at hy
    exact (mul_eq_zero.mp hy).resolve_left hφg

  have hstar := swap (MvPolynomial (Fin n) R) (wcOdpJ0 t j) (MvPolynomial.C (t j)) g hs5 hs6
  have hτ : algebraMap R (wcOdpB t j g) (t j) =
      Ideal.Quotient.mk (wcOdpJ0 t j ⊔ Ideal.span {g}) (MvPolynomial.C (t j)) := rfl
  have hL : ∀ z : wcOdpB t j g, algebraMap R (wcOdpB t j g) (t j) * z = 0 → z = 0 := by
    intro z hz
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [hτ, ← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hz
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hstar x hz
  have hR : ∀ z : wcOdpB t j g, z * algebraMap R (wcOdpB t j g) (t j) = 0 → z = 0 := by
    intro z hz
    rw [mul_comm] at hz
    exact hL z hz
  have h1 : algebraMap R (wcOdpB t j g) (t j) ∈ nonZeroDivisors (wcOdpB t j g) :=
    mem_nonZeroDivisors_iff.2 ⟨hL, hR⟩

  refine ⟨h1, ?_⟩
  intro β _ C _ _ _
  exact IsLocalization.map_nonZeroDivisors_le β.primeCompl C (Submonoid.mem_map_of_mem _ h1)

theorem wc_odp_chart_fibre_regular : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [IsAlgClosed (IsLocalRing.ResidueField R)] (n : ℕ) (t : Fin n → R)
    (M : Matrix (Fin n) (Fin n) R) (j : Fin n) (g : MvPolynomial (Fin n) R),
    2 ≤ n → ringKrullDim R = n → IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    IsUnit (M + M.transpose).det →
    g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
      wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} →
    ∀ (β : Ideal (wcOdpB t j g)) [β.IsMaximal], algebraMap R (wcOdpB t j g) (t j) ∈ β →
    ∀ (C : Type u) [CommRing C] [Algebra (wcOdpB t j g) C] [IsLocalization.AtPrime C β],
    IsRegularLocalRing (C ⧸ Ideal.span {algebraMap (wcOdpB t j g) C
      (algebraMap R (wcOdpB t j g) (t j))}) ∧
    ringKrullDim (C ⧸ Ideal.span {algebraMap (wcOdpB t j g) C
      (algebraMap R (wcOdpB t j g) (t j))}) =
      ((n - 1 - 1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have s1 : ∀ (B D : Type u) [CommRing B] [CommRing D] (f : B →+* D), Function.Surjective f →
      ∀ (β : Ideal B) [β.IsPrime] (p : Ideal D) [p.IsPrime], Ideal.comap f p = β →
      ∀ (C : Type u) [CommRing C] [Algebra B C] [IsLocalization.AtPrime C β]
        (E : Type u) [CommRing E] [Algebra D E] [IsLocalization.AtPrime E p],
      Nonempty (C ⧸ Ideal.map (algebraMap B C) (RingHom.ker f) ≃+* E) := by
    intro B D _ _ f hf β _ p _ hp C _ _ _ E _ _ _
    set I := Ideal.map (algebraMap B C) (RingHom.ker f) with hI
    have hmem : ∀ b : B, b ∈ β.primeCompl ↔ f b ∈ p.primeCompl := by
      intro b
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, ← hp, Ideal.mem_comap]
    let g₁ : B →+* E := (algebraMap D E).comp f
    have hg₁ : ∀ y : β.primeCompl, IsUnit (g₁ y) := fun y =>
      IsLocalization.map_units E (⟨f y, (hmem y).1 y.2⟩ : p.primeCompl)
    let l₁ : C →+* E := IsLocalization.lift (M := β.primeCompl) hg₁
    have hl₁ : ∀ b, l₁ (algebraMap B C b) = algebraMap D E (f b) := fun b =>
      IsLocalization.lift_eq hg₁ b
    have hIl : ∀ x ∈ I, l₁ x = 0 := by
      intro x hx
      have hle : I ≤ RingHom.ker l₁ := by
        rw [hI, Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker, hl₁, RingHom.mem_ker.mp hb, map_zero]
      exact hle hx
    let Φ : C ⧸ I →+* E := Ideal.Quotient.lift I l₁ hIl
    have hΦ : ∀ x, Φ (Ideal.Quotient.mk I x) = l₁ x := fun x => Ideal.Quotient.lift_mk I l₁ hIl
    let e₀ : D ≃+* B ⧸ RingHom.ker f := (RingHom.quotientKerEquivOfSurjective hf).symm
    let q : B ⧸ RingHom.ker f →+* C ⧸ I :=
      Ideal.quotientMap I (algebraMap B C) Ideal.le_comap_map
    let h₀ : D →+* C ⧸ I := q.comp e₀.toRingHom
    have hh₀ : ∀ b, h₀ (f b) = Ideal.Quotient.mk I (algebraMap B C b) := by
      intro b
      have he : e₀ (f b) = Ideal.Quotient.mk _ b := by
        apply (RingHom.quotientKerEquivOfSurjective hf).injective
        rw [RingHom.quotientKerEquivOfSurjective_apply_mk]
        exact RingEquiv.apply_symm_apply _ _
      show q (e₀ (f b)) = _
      rw [he]
      exact Ideal.quotientMap_mk
    have hh₀u : ∀ y : p.primeCompl, IsUnit (h₀ y) := by
      rintro ⟨y, hy⟩
      obtain ⟨b, rfl⟩ := hf y
      show IsUnit (h₀ (f b))
      rw [hh₀]
      exact (IsLocalization.map_units C (⟨b, (hmem b).2 hy⟩ : β.primeCompl)).map _
    let Ψ : E →+* C ⧸ I := IsLocalization.lift (M := p.primeCompl) hh₀u
    have hΨ : ∀ d, Ψ (algebraMap D E d) = h₀ d := fun d => IsLocalization.lift_eq hh₀u d
    refine ⟨RingEquiv.ofRingHom Φ Ψ ?_ ?_⟩
    · apply IsLocalization.ringHom_ext p.primeCompl
      refine RingHom.ext fun d => ?_
      obtain ⟨b, rfl⟩ := hf d
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΨ, hh₀, hΦ, hl₁]
    · apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext β.primeCompl
      refine RingHom.ext fun b => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦ, hl₁, hΨ, hh₀]

  have s2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (n : ℕ) (t : Fin n → R)
      (M : Matrix (Fin n) (Fin n) R) (j : Fin n) (g : MvPolynomial (Fin n) R),
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} →
      ∃ f : wcOdpB t j g →+* (MvPolynomial (Fin n) (IsLocalRing.ResidueField R) ⧸
        Ideal.span {MvPolynomial.X j - 1, ∑ a, ∑ c,
          MvPolynomial.C (IsLocalRing.residue R (M a c)) * MvPolynomial.X a * MvPolynomial.X c}),
        Function.Surjective f ∧
          RingHom.ker f = Ideal.span {algebraMap R (wcOdpB t j g) (t j)} := by
    intro R _ _ n t M j g hmax hG2
    set q : MvPolynomial (Fin n) R :=
      ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c with hqdef
    set Qb : MvPolynomial (Fin n) (IsLocalRing.ResidueField R) :=
      ∑ a, ∑ c, MvPolynomial.C (IsLocalRing.residue R (M a c)) * MvPolynomial.X a *
        MvPolynomial.X c with hQbdef
    set Kb : Ideal (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) :=
      Ideal.span {MvPolynomial.X j - 1, Qb} with hKb
    set φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (IsLocalRing.ResidueField R) :=
      MvPolynomial.map (IsLocalRing.residue R) with hφ
    set θ := (Ideal.Quotient.mk Kb).comp φ with hθ
    set J := wcOdpJ0 t j ⊔ Ideal.span {g} with hJ
    have hφs : Function.Surjective φ :=
      MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
    have hθs : Function.Surjective θ := Ideal.Quotient.mk_surjective.comp hφs
    have hφX : φ (MvPolynomial.X j - 1) = MvPolynomial.X j - 1 := by
      rw [map_sub, map_one, hφ, MvPolynomial.map_X]
    have hφq : φ q = Qb := by
      simp only [hqdef, hQbdef, hφ, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
    set P := Ideal.span {MvPolynomial.X j - 1, q} ⊔
      Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R) with hP
    have hkerθ : RingHom.ker θ = P := by
      rw [hθ, ← RingHom.comap_ker, Ideal.mk_ker]
      have hK : Kb = Ideal.map φ (Ideal.span {MvPolynomial.X j - 1, q}) := by
        rw [Ideal.map_span, Set.image_pair, hφX, hφq]
      rw [hK, Ideal.comap_map_of_surjective φ hφs, ← RingHom.ker_eq_comap_bot, hφ,
        MvPolynomial.ker_map, IsLocalRing.ker_residue]
    have hJ0P : wcOdpJ0 t j ≤ P := by
      rw [wcOdpJ0, Ideal.span_le]
      have hCt : ∀ b, MvPolynomial.C (t b) ∈ P := fun b =>
        Ideal.mem_sup_right (Ideal.mem_map_of_mem _
          (by rw [hmax]; exact Ideal.subset_span ⟨b, rfl⟩))
      rintro x (rfl | ⟨b, rfl⟩)
      · exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · exact P.sub_mem (P.mul_mem_right _ (hCt j)) (hCt b)
    have hCtjP : MvPolynomial.C (t j) ∈ P :=
      Ideal.mem_sup_right (Ideal.mem_map_of_mem _
        (by rw [hmax]; exact Ideal.subset_span ⟨j, rfl⟩))
    have hqP : q ∈ P := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hG2P : g - q ∈ P := by
      have : wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} ≤ P :=
        sup_le hJ0P (by rw [Ideal.span_singleton_le_iff_mem]; exact hCtjP)
      exact this hG2
    have hPeq : P = J ⊔ Ideal.span {MvPolynomial.C (t j)} := by
      apply le_antisymm
      · apply sup_le
        · rw [Ideal.span_le]
          rintro x (rfl | rfl)
          · exact Ideal.mem_sup_left (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          · have h1 : g ∈ J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
              Ideal.mem_sup_left (Ideal.mem_sup_right (Ideal.mem_span_singleton_self g))
            have h2 : g - q ∈ J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
              (sup_le_sup_right (le_sup_left : wcOdpJ0 t j ≤ J) _) hG2
            have := Ideal.sub_mem _ h1 h2
            rwa [sub_sub_cancel] at this
        · rw [hmax, Ideal.map_span, Ideal.span_le]
          rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
          have h1 : MvPolynomial.C (t j) * MvPolynomial.X b ∈
              J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
            Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
          have h2 : MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈
              J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
            Ideal.mem_sup_left (Ideal.mem_sup_left
              (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)))
          have := Ideal.sub_mem _ h1 h2
          rwa [sub_sub_cancel] at this
      · apply sup_le (sup_le hJ0P ?_) (by rw [Ideal.span_singleton_le_iff_mem]; exact hCtjP)
        rw [Ideal.span_singleton_le_iff_mem]
        have := P.add_mem hqP hG2P
        rwa [add_sub_cancel] at this
    have hJθ : ∀ a ∈ J, θ a = 0 := by
      intro a ha
      rw [← RingHom.mem_ker, hkerθ, hPeq]
      exact Ideal.mem_sup_left ha
    refine ⟨Ideal.Quotient.lift J θ hJθ,
      Ideal.Quotient.lift_surjective_of_surjective J hJθ hθs, ?_⟩
    have hk : RingHom.ker (Ideal.Quotient.lift J θ hJθ) =
        Ideal.map (Ideal.Quotient.mk J) (RingHom.ker θ) :=
      Ideal.ker_quotient_lift θ (fun a ha => hJθ a ha)
    rw [hk, hkerθ, hPeq, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
      Ideal.map_span, Set.image_singleton]
    rfl

  have s3 : ∀ (k : Type u) [Field k] (n : ℕ) (N : Matrix (Fin n) (Fin n) k) (j : Fin n)
      (v : Fin n → k), (N + N.transpose).det ≠ 0 → v j = 1 → ∑ a, ∑ b, N a b * v a * v b = 0 →
      ∃ c, c ≠ j ∧ ∑ b, (N c b + N b c) * v b ≠ 0 := by
    intro k _ n N j v hdet hvj hq
    by_contra hcon
    push_neg at hcon
    have euler : ∑ c, v c * ∑ b, (N c b + N b c) * v b = 0 := by
      have e : ∑ c, v c * ∑ b, (N c b + N b c) * v b =
          (∑ a, ∑ b, N a b * v a * v b) + ∑ a, ∑ b, N a b * v a * v b := by
        simp only [Finset.mul_sum, add_mul, mul_add, Finset.sum_add_distrib]
        congr 1
        · exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
        · exact Finset.sum_comm.trans
            (Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring)
      rw [e, hq, add_zero]
    have hj : ∑ b, (N j b + N b j) * v b = 0 := by
      rw [Finset.sum_eq_single j (fun c _ hc => by rw [hcon c hc, mul_zero]) (by simp), hvj,
        one_mul] at euler
      exact euler
    have hw : ∀ c, ∑ b, (N c b + N b c) * v b = 0 := by
      intro c
      by_cases hc : c = j
      · rw [hc]; exact hj
      · exact hcon c hc
    apply hdet
    apply Matrix.exists_mulVec_eq_zero_iff.mp
    refine ⟨v, fun h => by have := congrFun h j; rw [hvj] at this; simp at this, ?_⟩
    ext c
    simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.transpose_apply,
      Pi.zero_apply]
    exact hw c

  have s4 : ∀ (k : Type u) [Field k] [IsAlgClosed k] (n : ℕ)
      (𝔐 : Ideal (MvPolynomial (Fin n) k)), 𝔐.IsMaximal →
      ∃ v : Fin n → k,
        𝔐 = Ideal.span (Set.range fun i => MvPolynomial.X i - MvPolynomial.C (v i)) ∧
        ∀ p : MvPolynomial (Fin n) k, p ∈ 𝔐 ↔ MvPolynomial.eval v p = 0 := by
    intro k _ _ n 𝔐 h𝔐
    obtain ⟨v, hv⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔐
    have hmem : ∀ p, p ∈ 𝔐 ↔ MvPolynomial.eval v p = 0 := by
      intro p
      rw [hv, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      exact Iff.rfl
    refine ⟨v, ?_, hmem⟩
    set S := Ideal.span (Set.range fun i => MvPolynomial.X i - MvPolynomial.C (v i)) with hS
    have taylor : ∀ p : MvPolynomial (Fin n) k,
        p - MvPolynomial.C (MvPolynomial.eval v p) ∈ S := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq =>
        have := S.add_mem hp hq
        convert this using 1
        simp only [map_add]; ring
      | mul_X p i hp =>
        have h1 : MvPolynomial.X i - MvPolynomial.C (v i) ∈ S := Ideal.subset_span ⟨i, rfl⟩
        have := S.add_mem (S.mul_mem_right (MvPolynomial.X i) hp)
          (S.mul_mem_left (MvPolynomial.C (MvPolynomial.eval v p)) h1)
        convert this using 1
        simp only [map_mul, MvPolynomial.eval_X]; ring
    apply le_antisymm
    · intro p hp
      have := taylor p
      rwa [(hmem p).mp hp, map_zero, sub_zero] at this
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, hmem]
      simp

  have s5 : ∀ (k : Type u) [CommRing k] (n : ℕ) (N : Matrix (Fin n) (Fin n) k) (v : Fin n → k),
      ∑ a, ∑ b, N a b * v a * v b = 0 → ∃ u : Fin n → MvPolynomial (Fin n) k,
        ∑ a, ∑ b, MvPolynomial.C (N a b) * MvPolynomial.X a * MvPolynomial.X b =
          ∑ c, (MvPolynomial.X c - MvPolynomial.C (v c)) * u c ∧
        ∀ c, MvPolynomial.eval v (u c) = ∑ b, (N c b + N b c) * v b := by
    intro k _ n N v hq
    refine ⟨fun c => ∑ b, MvPolynomial.C (N c b) * MvPolynomial.X b +
      MvPolynomial.C (∑ a, N a c * v a), ?_, ?_⟩
    · beta_reduce
      have e1 : ∑ a, ∑ b, MvPolynomial.C (N a b) * MvPolynomial.X a * MvPolynomial.X b =
          ∑ c, MvPolynomial.X c *
            ∑ b, MvPolynomial.C (N c b) * (MvPolynomial.X b : MvPolynomial (Fin n) k) := by
        simp only [Finset.mul_sum]
        exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
      have e2 : ∑ c, MvPolynomial.X c * MvPolynomial.C (∑ a, N a c * v a) =
          ∑ c, MvPolynomial.C (v c) *
            ∑ b, MvPolynomial.C (N c b) * (MvPolynomial.X b : MvPolynomial (Fin n) k) := by
        simp only [map_sum, map_mul, Finset.mul_sum]
        exact Finset.sum_comm.trans
          (Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring)
      have e4 : ∑ c, MvPolynomial.C (v c) * MvPolynomial.C (∑ a, N a c * v a) =
          (0 : MvPolynomial (Fin n) k) := by
        have h0 : ∑ c, v c * ∑ a, N a c * v a = ∑ a, ∑ b, N a b * v a * v b := by
          simp only [Finset.mul_sum]
          exact Finset.sum_comm.trans
            (Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring)
        have hq' : MvPolynomial.C (∑ c, v c * ∑ a, N a c * v a) =
            (0 : MvPolynomial (Fin n) k) := by
          rw [h0, hq, map_zero]
        simp only [map_sum, map_mul, Finset.mul_sum] at hq' ⊢
        exact hq'
      have e3 : ∀ c, (MvPolynomial.X c - MvPolynomial.C (v c)) *
          (∑ b, MvPolynomial.C (N c b) * MvPolynomial.X b + MvPolynomial.C (∑ a, N a c * v a)) =
          MvPolynomial.X c *
              (∑ b, MvPolynomial.C (N c b) * (MvPolynomial.X b : MvPolynomial (Fin n) k)) +
            (MvPolynomial.X c * MvPolynomial.C (∑ a, N a c * v a) -
              MvPolynomial.C (v c) * ∑ b, MvPolynomial.C (N c b) * MvPolynomial.X b) -
            MvPolynomial.C (v c) * MvPolynomial.C (∑ a, N a c * v a) := fun c => by ring
      rw [Finset.sum_congr rfl fun c _ => e3 c, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        Finset.sum_sub_distrib, e2, sub_self, add_zero, e4, sub_zero, e1]
    · intro c
      beta_reduce
      simp only [map_add, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, add_mul,
        Finset.sum_add_distrib]

  have s6 : ∀ (L : Type u) [CommRing L] [IsLocalRing L] [IsNoetherianRing L] (A Z : Set L)
      (r s : ℕ), A.Finite → Z.Finite → A.ncard ≤ r → Z.ncard ≤ s →
      IsLocalRing.maximalIdeal L = Ideal.span (A ∪ Z) →
      ((r + s : ℕ) : WithBot ℕ∞) ≤ ringKrullDim L →
      IsRegularLocalRing (L ⧸ Ideal.span A) ∧
        ringKrullDim (L ⧸ Ideal.span A) = (s : WithBot ℕ∞) := by
    intro L _ _ _ A Z r s hA hZ hAr hZs hm hdim
    set I := Ideal.span A with hI
    have hIm : I ≤ IsLocalRing.maximalIdeal L := by
      rw [hm]; exact Ideal.span_mono Set.subset_union_left
    have hItop : I ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal L).ne_top (top_le_iff.mp (h ▸ hIm))
    haveI : Nontrivial (L ⧸ I) :=
      ⟨⟨0, 1, fun h => hItop (Ideal.Quotient.zero_eq_one_iff.mp h)⟩⟩
    haveI : IsLocalRing (L ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have hjac : I ≤ Ring.jacobson L := by
      rw [← Ideal.jacobson_bot, IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]; exact hIm
    have h1 := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I hjac
    have hsf : Submodule.spanFinrank I ≤ r :=
      (Submodule.spanFinrank_span_le_ncard_of_finite hA).trans hAr
    have hlow : (s : WithBot ℕ∞) ≤ ringKrullDim (L ⧸ I) := by
      have h2 : ((r + s : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (L ⧸ I) + (r : WithBot ℕ∞) := by
        refine hdim.trans (h1.trans ?_)
        gcongr
      have hnb : ringKrullDim (L ⧸ I) ≠ ⊥ :=
        ne_bot_of_le_ne_bot (by simp) (ringKrullDim_nonneg_of_nontrivial (R := L ⧸ I))
      obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp hnb
      rw [← he] at h2 ⊢
      induction e using ENat.recTopCoe with
      | top => exact le_top
      | coe m =>
        have h3 : ((r + s : ℕ) : WithBot ℕ∞) ≤ ((m + r : ℕ) : WithBot ℕ∞) := by
          push_cast; exact h2
        have h4 : r + s ≤ m + r := by exact_mod_cast h3
        have h5 : s ≤ m := by omega
        exact_mod_cast h5
    have hmaxq : IsLocalRing.maximalIdeal (L ⧸ I) =
        Ideal.span (Ideal.Quotient.mk I '' Z) := by
      have hk : RingHom.ker (Ideal.Quotient.mk I) ≤ IsLocalRing.maximalIdeal L := by
        rw [Ideal.mk_ker]; exact hIm
      have hM := Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective hk
      rw [← IsLocalRing.eq_maximalIdeal hM, hm, Ideal.map_span, Set.image_union,
        Ideal.span_union]
      have : Ideal.span (Ideal.Quotient.mk I '' A) = ⊥ := by
        rw [Ideal.span_eq_bot]
        rintro _ ⟨a, ha, rfl⟩
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ha)
      rw [this, bot_sup_eq]
    have hsf2 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (L ⧸ I)) ≤ s := by
      rw [hmaxq]
      exact (Submodule.spanFinrank_span_le_ncard_of_finite (hZ.image _)).trans
        ((Set.ncard_image_le hZ).trans hZs)
    have hup := ringKrullDim_le_spanFinrank_maximalIdeal (L ⧸ I)
    have hup2 : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (L ⧸ I)) : ℕ) :
        WithBot ℕ∞) ≤ s := by
      exact_mod_cast hsf2
    have hd : ringKrullDim (L ⧸ I) = (s : WithBot ℕ∞) := le_antisymm (hup.trans hup2) hlow
    refine ⟨IsRegularLocalRing.mk ?_, hd⟩
    exact le_antisymm (hup2.trans hlow) hup

  have s7 : ∀ (k : Type u) [Field k] (N : ℕ) (𝔫 : Ideal (MvPolynomial (Fin N) k)),
      𝔫.IsMaximal → (N : ℕ∞) ≤ 𝔫.height := by
    intro k _ N
    induction N with
    | zero => intro n _; simp
    | succ N ih =>
      intro n hn
      let e : MvPolynomial (Fin (N + 1)) k ≃+* Polynomial (MvPolynomial (Fin N) k) :=
        (MvPolynomial.finSuccEquiv k N).toRingEquiv
      let P : Ideal (Polynomial (MvPolynomial (Fin N) k)) := Ideal.map e n
      haveI hP : P.IsMaximal := Ideal.map_isMaximal_of_equiv e
      have hnP : n.height = P.height := by
        have h1 : Ideal.comap e P = n := Ideal.comap_map_of_bijective e e.bijective
        rw [← RingEquiv.height_comap e P, h1]
      let p : Ideal (MvPolynomial (Fin N) k) := Ideal.comap Polynomial.C P
      haveI hp : p.IsMaximal := Polynomial.isMaximal_comap_C_of_isJacobsonRing P
      haveI : P.LiesOver p := by
        constructor
        rw [Ideal.under_def, Polynomial.algebraMap_eq]
      have hPp : P.height = p.height + 1 := Polynomial.height_eq_height_add_one p P
      rw [hnP, hPp]
      have := ih p hp
      push_cast
      exact add_le_add this le_rfl

  have s8 : ∀ (k : Type u) [Field k] (n : ℕ) (𝔐 : Ideal (MvPolynomial (Fin n) k)) [𝔐.IsPrime]
      (L : Type u) [CommRing L] [Algebra (MvPolynomial (Fin n) k) L]
      [IsLocalization.AtPrime L 𝔐] (v : Fin n → k) (Q : MvPolynomial (Fin n) k)
      (u : Fin n → MvPolynomial (Fin n) k) (j c' : Fin n), c' ≠ j → v j = 1 →
      𝔐 = Ideal.span (Set.range fun i => MvPolynomial.X i - MvPolynomial.C (v i)) →
      u c' ∉ 𝔐 → Q = ∑ c, (MvPolynomial.X c - MvPolynomial.C (v c)) * u c →
      Ideal.map (algebraMap (MvPolynomial (Fin n) k) L) 𝔐 =
        Ideal.span ({algebraMap (MvPolynomial (Fin n) k) L (MvPolynomial.X j - 1),
          algebraMap (MvPolynomial (Fin n) k) L Q} ∪
          (fun c => algebraMap (MvPolynomial (Fin n) k) L
            (MvPolynomial.X c - MvPolynomial.C (v c))) '' {c | c ≠ j ∧ c ≠ c'}) := by
    intro k _ n 𝔐 _ L _ _ _ v Q u j c' hcj hvj h𝔐 hu hQ
    set α := algebraMap (MvPolynomial (Fin n) k) L with hα
    set T : Set L := {α (MvPolynomial.X j - 1), α Q} ∪
      (fun c => α (MvPolynomial.X c - MvPolynomial.C (v c))) '' {c | c ≠ j ∧ c ≠ c'} with hT
    have hyj : (MvPolynomial.X j - 1 : MvPolynomial (Fin n) k) =
        MvPolynomial.X j - MvPolynomial.C (v j) := by rw [hvj, map_one]
    have hgen : ∀ i, (MvPolynomial.X i - MvPolynomial.C (v i) : MvPolynomial (Fin n) k) ∈ 𝔐 := by
      intro i; rw [h𝔐]; exact Ideal.subset_span ⟨i, rfl⟩
    have hunit : IsUnit (α (u c')) := IsLocalization.map_units L (⟨u c', hu⟩ : 𝔐.primeCompl)
    have hne : ∀ c, c ≠ c' → α (MvPolynomial.X c - MvPolynomial.C (v c)) ∈ Ideal.span T := by
      intro c hc
      by_cases hcj' : c = j
      · subst hcj'
        rw [← hyj]
        exact Ideal.subset_span (Or.inl (Or.inl rfl))
      · exact Ideal.subset_span (Or.inr ⟨c, ⟨hcj', hc⟩, rfl⟩)
    have hy : ∀ c, α (MvPolynomial.X c - MvPolynomial.C (v c)) ∈ Ideal.span T := by
      intro c
      by_cases hc : c = c'
      · subst hc
        have hQmem : α Q ∈ Ideal.span T := Ideal.subset_span (Or.inl (Or.inr rfl))
        rw [hQ, map_sum, ← Finset.add_sum_erase _ _ (Finset.mem_univ c)] at hQmem
        have hrest : ∑ x ∈ Finset.univ.erase c,
            α ((MvPolynomial.X x - MvPolynomial.C (v x)) * u x) ∈ Ideal.span T :=
          Ideal.sum_mem _ fun x hx => by
            rw [map_mul]; exact Ideal.mul_mem_right _ _ (hne x (Finset.ne_of_mem_erase hx))
        have h2 := (Ideal.add_mem_iff_left _ hrest).mp hQmem
        rw [map_mul, mul_comm] at h2
        exact (Ideal.unit_mul_mem_iff_mem _ hunit).mp h2
      · exact hne c hc
    apply le_antisymm
    · rw [h𝔐, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      exact hy i
    · rw [Ideal.span_le]
      rintro x ((rfl | rfl) | ⟨c, _, rfl⟩)
      · rw [hyj]; exact Ideal.mem_map_of_mem _ (hgen j)
      · apply Ideal.mem_map_of_mem
        rw [hQ]
        exact Ideal.sum_mem _ fun c _ => Ideal.mul_mem_right _ _ (hgen c)
      · exact Ideal.mem_map_of_mem _ (hgen c)

  intro R _ _ _ _ n t M j g hn _ hmax hdet hG2 β _ hτ C _ _ _
  set Q : MvPolynomial (Fin n) (IsLocalRing.ResidueField R) :=
    ∑ a, ∑ c, MvPolynomial.C (IsLocalRing.residue R (M a c)) *
        MvPolynomial.X a * MvPolynomial.X c with hQ
  set Kb : Ideal (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) :=
    Ideal.span {MvPolynomial.X j - 1, Q} with hKb
  set τ := algebraMap R (wcOdpB t j g) (t j) with hτdef
  obtain ⟨f, hfs, hfk⟩ := s2 R n t M j g hmax hG2
  have hkerβ : RingHom.ker f ≤ β := by
    rw [hfk, Ideal.span_singleton_le_iff_mem]; exact hτ
  haveI hβbmax : (Ideal.map f β).IsMaximal :=
    Ideal.IsMaximal.map_of_surjective_of_ker_le hfs hkerβ
  set βb := Ideal.map f β with hβb
  have hcomap : Ideal.comap f βb = β := by
    rw [hβb, Ideal.comap_map_of_surjective f hfs, ← RingHom.ker_eq_comap_bot,
      sup_eq_left.mpr hkerβ]
  obtain ⟨e₁⟩ := s1 (wcOdpB t j g) _ f hfs β βb hcomap C (Localization.AtPrime βb)
  have heq1 : Ideal.map (algebraMap (wcOdpB t j g) C) (RingHom.ker f) =
      Ideal.span {algebraMap (wcOdpB t j g) C τ} := by
    rw [hfk, Ideal.map_span, Set.image_singleton]
  let e₁' := (Ideal.quotEquivOfEq heq1.symm).trans e₁
  haveI h𝔐max : (Ideal.comap (Ideal.Quotient.mk Kb) βb).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
  set 𝔐 := Ideal.comap (Ideal.Quotient.mk Kb) βb with h𝔐
  obtain ⟨e₂⟩ := s1 (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) _
    (Ideal.Quotient.mk Kb) Ideal.Quotient.mk_surjective
    𝔐 βb rfl (Localization.AtPrime 𝔐) (Localization.AtPrime βb)
  set L := Localization.AtPrime 𝔐 with hL
  set α := algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) L with hα
  set A : Set L := {α (MvPolynomial.X j - 1), α Q} with hA
  have heq2 : Ideal.map α (RingHom.ker (Ideal.Quotient.mk Kb)) = Ideal.span A := by
    rw [Ideal.mk_ker]
    exact (Ideal.map_span α _).trans (by rw [Set.image_pair])
  let e₂' := (Ideal.quotEquivOfEq heq2.symm).trans e₂
  have hK𝔐 : Kb ≤ 𝔐 := fun x hx => by
    rw [h𝔐, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]; exact βb.zero_mem
  obtain ⟨v, h𝔐v, hmem⟩ := s4 (IsLocalRing.ResidueField R) n 𝔐 h𝔐max
  have hvj : v j = 1 := by
    have h1 := (hmem _).mp (hK𝔐 (Ideal.subset_span (Set.mem_insert _ _)))
    simp only [map_sub, MvPolynomial.eval_X, map_one] at h1
    exact sub_eq_zero.mp h1
  set N : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField R) := M.map (IsLocalRing.residue R)
    with hN
  have hqv : ∑ a, ∑ b, N a b * v a * v b = 0 := by
    have h1 := (hmem _).mp (hK𝔐 (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    simp only [hQ, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X] at h1
    exact h1
  have hdetN : (N + N.transpose).det ≠ 0 := by
    have h1 : (N + N.transpose) = (M + M.transpose).map (IsLocalRing.residue R) := by
      ext a b
      simp only [hN, Matrix.add_apply, Matrix.transpose_apply, Matrix.map_apply, map_add]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (hdet.map (IsLocalRing.residue R)).ne_zero
  obtain ⟨c', hc'j, hw⟩ := s3 (IsLocalRing.ResidueField R) n N j v hdetN hvj hqv
  obtain ⟨u, hQu, hueval⟩ := s5 (IsLocalRing.ResidueField R) n N v hqv
  have hu𝔐 : u c' ∉ 𝔐 := fun h => hw (by rw [← hueval]; exact (hmem _).mp h)
  have hgens := s8 (IsLocalRing.ResidueField R) n 𝔐 L v Q u j c' hc'j hvj h𝔐v hu𝔐 hQu
  rw [IsLocalization.AtPrime.map_eq_maximalIdeal 𝔐 L] at hgens
  haveI : IsNoetherianRing L := IsLocalization.isNoetherianRing 𝔐.primeCompl L inferInstance
  have hht := s7 (IsLocalRing.ResidueField R) n 𝔐 h𝔐max
  set Z : Set L := (fun c => α (MvPolynomial.X c - MvPolynomial.C (v c))) ''
    {c | c ≠ j ∧ c ≠ c'} with hZ
  have hAfin : A.Finite := (Set.finite_singleton _).insert _
  have hZfin : Z.Finite := (Set.toFinite _).image _
  have hAcard : A.ncard ≤ 2 :=
    (Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton])
  have hZcard : Z.ncard ≤ n - 2 := by
    refine (Set.ncard_image_le (Set.toFinite _)).trans (le_of_eq ?_)
    have hS : {c : Fin n | c ≠ j ∧ c ≠ c'} = ↑(({j, c'} : Finset (Fin n))ᶜ) := by
      ext c; simp <;> tauto
    rw [hS, Set.ncard_coe_finset, Finset.card_compl, Fintype.card_fin,
      Finset.card_pair hc'j.symm]
  have hdimL : ((2 + (n - 2) : ℕ) : WithBot ℕ∞) ≤ ringKrullDim L := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔐 L, show 2 + (n - 2) = n by omega]
    exact_mod_cast hht
  obtain ⟨hreg, hd⟩ := s6 L A Z 2 (n - 2) hAfin hZfin hAcard hZcard hgens hdimL
  let e := e₁'.trans e₂'.symm
  haveI := hreg
  refine ⟨?_, ?_⟩
  · first
      | exact IsRegularLocalRing.of_ringEquiv (R := L ⧸ Ideal.span A) e.symm
      | exact @IsRegularLocalRing.of_ringEquiv (L ⧸ Ideal.span A) _ hreg _ _ e.symm
  · have hde : ringKrullDim (C ⧸ Ideal.span {algebraMap (wcOdpB t j g) C τ}) =
        ringKrullDim (L ⧸ Ideal.span A) := by
      first
        | exact ringKrullDim_eq_of_ringEquiv (S := L ⧸ Ideal.span A) e
        | exact @ringKrullDim_eq_of_ringEquiv _ (L ⧸ Ideal.span A) _ _ e
    rw [hde, hd, show n - 1 - 1 = n - 2 by omega]

theorem wc_odp_regular_lift_nzd : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
    (x : C) (d : ℕ), x ∈ IsLocalRing.maximalIdeal C → x ∈ nonZeroDivisors C →
    IsRegularLocalRing (C ⧸ Ideal.span {x}) → ringKrullDim (C ⧸ Ideal.span {x}) = (d : WithBot ℕ∞) →
    IsRegularLocalRing C ∧ ringKrullDim C = ((d + 1 : ℕ) : WithBot ℕ∞) :=
by
  intro C _ _ _ x d hx hnzd hreg hdim
  classical
  haveI := hreg
  have hπs : Function.Surjective (Ideal.Quotient.mk (Ideal.span {x})) :=
    Ideal.Quotient.mk_surjective

  have hdimC : ringKrullDim C = ((d + 1 : ℕ) : WithBot ℕ∞) := by
    have h := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      hnzd hx
    rw [← h, hdim, Nat.cast_add, Nat.cast_one]

  have hsq : Submodule.spanFinrank (IsLocalRing.maximalIdeal (C ⧸ Ideal.span {x})) = d := by
    have h := (IsRegularLocalRing.spanFinrank_maximalIdeal (R := C ⧸ Ideal.span {x}))
    rw [hdim] at h
    first
      | exact_mod_cast h
      | exact ENat.coe_injective (WithBot.coe_injective h)
      | exact Nat.cast_injective h
  have hfg : Submodule.FG (IsLocalRing.maximalIdeal (C ⧸ Ideal.span {x})) :=
    IsNoetherian.noetherian _
  obtain ⟨s, hsenc, hsspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
  rw [hsq] at hsenc
  have hsfin : s.Finite := Set.finite_of_encard_eq_coe hsenc
  have hsn : s.ncard = d := by
    have := hsfin.cast_ncard_eq
    rw [hsenc] at this
    exact_mod_cast this
  obtain ⟨σ, hσ⟩ : ∃ σ : (C ⧸ Ideal.span {x}) → C,
      ∀ c, Ideal.Quotient.mk (Ideal.span {x}) (σ c) = c :=
    ⟨Function.surjInv hπs, Function.surjInv_eq hπs⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Set C, T = insert x (σ '' s) := ⟨_, rfl⟩
  have hTfin : T.Finite := by
    rw [hTdef]
    exact (hsfin.image σ).insert x
  have hTcard : T.ncard ≤ d + 1 := by
    rw [hTdef]
    refine (Set.ncard_insert_le x _).trans ?_
    have := Set.ncard_image_le (f := σ) hsfin
    omega
  have hmap : Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal C) =
      IsLocalRing.maximalIdeal (C ⧸ Ideal.span {x}) :=
    IsLocalRing.map_maximalIdeal_of_surjective _ hπs
  have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {x})) = Ideal.span {x} := Ideal.mk_ker
  have hxm : Ideal.span {x} ≤ IsLocalRing.maximalIdeal C :=
    (Ideal.span_singleton_le_iff_mem _).mpr hx
  have himg : (Ideal.Quotient.mk (Ideal.span {x})) '' (σ '' s) = s := by
    rw [Set.image_image]
    simp only [hσ, Set.image_id']
  have hT : Ideal.span T = IsLocalRing.maximalIdeal C := by
    apply le_antisymm
    · rw [hTdef, Ideal.span_le]
      intro y hy
      rcases hy with rfl | ⟨c, hc, rfl⟩
      · exact hx
      · have h1 : (Ideal.Quotient.mk (Ideal.span {x})) (σ c) ∈
            Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal C) := by
          rw [hσ, hmap, ← hsspan]
          exact Submodule.subset_span hc
        have h2 : σ c ∈ Ideal.comap (Ideal.Quotient.mk (Ideal.span {x}))
            (Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal C)) := h1
        rw [Ideal.comap_map_of_surjective' _ hπs, hker, sup_eq_left.mpr hxm] at h2
        exact h2
    · intro y hy
      have h1 : (Ideal.Quotient.mk (Ideal.span {x})) y ∈
          Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (Ideal.span (σ '' s)) := by
        rw [Ideal.map_span, himg]
        have : (Ideal.Quotient.mk (Ideal.span {x})) y ∈
            Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (IsLocalRing.maximalIdeal C) :=
          Ideal.mem_map_of_mem _ hy
        rw [hmap, ← hsspan] at this
        exact this
      have h2 : y ∈ Ideal.comap (Ideal.Quotient.mk (Ideal.span {x}))
          (Ideal.map (Ideal.Quotient.mk (Ideal.span {x})) (Ideal.span (σ '' s))) := h1
      rw [Ideal.comap_map_of_surjective' _ hπs, hker] at h2
      rw [hTdef, Set.insert_eq, Set.union_comm, Ideal.span_union]
      exact h2
  have hle : Submodule.spanFinrank (IsLocalRing.maximalIdeal C) ≤ d + 1 := by
    rw [← hT]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite hTfin).trans hTcard
  refine ⟨IsRegularLocalRing.mk (le_antisymm ?_ (ringKrullDim_le_spanFinrank_maximalIdeal _)),
    hdimC⟩
  rw [hdimC]
  exact_mod_cast hle

theorem wc_odp_blowup_stalk_chart : ∀ (K : Type u) [Field K] [IsAlgClosed K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [IsProper fP] (n : ℕ) (xb : P) (hxb : IsClosed ({xb} : Set P))
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin n → R) (h : R)
    (M : Matrix (Fin n) (Fin n) R), 2 ≤ n → ringKrullDim R = n →
    IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
    IsUnit (M + M.transpose).det → Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) →
    ∀ (I : P.IdealSheafData),
    I = Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P) →
    ∀ (Yb : Scheme.{u}) (r : Yb ⟶ P) [IsProper r], wcCsdIsBlowup I r →
    ∀ y : Yb, IsClosed ({y} : Set Yb) → r y = xb →
    ∃ (j : Fin n) (g : MvPolynomial (Fin n) R) (β : Ideal (wcOdpB t j g)) (_ : β.IsMaximal),
      MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g ∈ wcOdpJ0 t j ∧
      g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} ∧
      algebraMap R (wcOdpB t j g) (t j) ∈ β ∧
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (wcOdpB t j g) C)
        (_ : IsLocalization.AtPrime C β) (e : Yb.presheaf.stalk y ≃+* C),
        ∀ (W : Yb.affineOpens) (hyW : y ∈ W.1),
          Ideal.map (e : Yb.presheaf.stalk y →+* C)
            (Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W)) =
          Ideal.span {algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j))} :=
by
  have hComap : ∀ (X Y : Scheme.{u}) (J : Y.IdealSheafData) (π : X ⟶ Y) (U : Y.affineOpens) (W : X.affineOpens) (e : W.1 ≤ π ⁻¹ᵁ U.1), (J.comap π).ideal W = Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) := by
    intro X Y J π U W e
    rw [Scheme.IdealSheafData.comap, Scheme.Hom.ker_apply]
    apply le_antisymm
    · have hW : IsAffineOpen W.1 := W.2
      have hU : IsAffineOpen U.1 := U.2
      set IB := Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) with hIB
      have H : J.ideal U ≤ Ideal.comap (π.appLE U.1 W.1 e).hom IB := Ideal.le_comap_map
      let ψ : (Γ(Y, U.1) ⧸ J.ideal U) →+* (Γ(X, W.1) ⧸ IB) :=
        Ideal.quotientMap IB (π.appLE U.1 W.1 e).hom H
      let t : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X :=
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec
      let g : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ J.subscheme :=
        Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U
      have hw : t ≫ π = g ≫ J.subschemeι := by
        show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ≫ π =
          (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι
        have hc := J.subschemeCover_map_subschemeι U
        rw [J.glueDataObjι_ι U] at hc
        have hg : (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι =
            Spec.map (CommRingCat.ofHom ψ) ≫
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J.ideal U))) ≫ hU.fromSpec) :=
          (Category.assoc _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ) ≫ ·) hc)
        rw [hg, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec π hU hW e]
        rw [← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        congr 2
      let l := Limits.pullback.lift t g hw
      have hl : l ≫ Limits.pullback.fst π J.subschemeι = t := Limits.pullback.lift_fst _ _ _
      intro b hb
      rw [RingHom.mem_ker] at hb
      have e0 : ⊤ ≤ t ⁻¹ᵁ W.1 := by
        intro p _
        show hW.fromSpec ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) p) ∈ (W.1 : Set X)
        rw [← hW.range_fromSpec]
        exact ⟨_, rfl⟩
      have h1 : ∀ (e : ⊤ ≤ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ⁻¹ᵁ W.1),
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec).appLE W.1 ⊤ e =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1),
            hW.fromSpec.appLE W.1 ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, W.1)).inv := by
          intro e₁
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
          have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, W.1)).Opens) ⟶ Opposite.op ⊤),
              (Spec Γ(X, W.1)).presheaf.map f = 𝟙 _ := by
            intro f
            rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
              CategoryTheory.Functor.map_id]
          rw [hid, Category.comp_id]
        intro e
        have e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1 :=
          hW.fromSpec_preimage_self.ge
        have e₂ : (⊤ : (Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB))).Opens) ≤
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) ⁻¹ᵁ ⊤ := le_top
        rw [← Scheme.Hom.appLE_comp_appLE _ hW.fromSpec W.1 ⊤ ⊤ e₁ e₂, hb e₁]
        have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appLE ⊤ ⊤ e₂ =
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appTop :=
          Scheme.Hom.appLE_eq_app _
        rw [happ, ← Scheme.ΓSpecIso_inv_naturality]
      have key : ∀ (s : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X) (hs : s = t)
          (e1 : ⊤ ≤ s ⁻¹ᵁ W.1), s.appLE W.1 ⊤ e1 =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        rintro s rfl e1
        exact h1 e1
      have e2 : ⊤ ≤ (l ≫ Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 := by
        rw [hl]; exact e0
      have h2 := key _ hl e2
      rw [Scheme.Hom.comp_appLE] at h2
      have h3 := congrArg (fun f => f.hom b) h2
      simp only [CommRingCat.comp_apply, hb, map_zero] at h3
      have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, W.1) ⧸ IB))).hom.hom h3
      simp only [map_zero, Iso.inv_hom_id_apply] at h4
      exact (Ideal.Quotient.eq_zero_iff_mem).mp h4.symm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have hP := Limits.pullback.condition (f := π) (g := J.subschemeι)
      have key : ∀ (s : Limits.pullback π J.subschemeι ⟶ Y)
          (hs : Limits.pullback.fst π J.subschemeι ≫ π = s)
          (e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤ s ⁻¹ᵁ U.1),
          ((Limits.pullback.fst π J.subschemeι).app W.1).hom ((π.appLE U.1 W.1 e).hom a) =
            (s.appLE U.1 _ e1).hom a := by
        rintro s rfl e1
        rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
      have e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤
          (Limits.pullback.snd π J.subschemeι ≫ J.subschemeι) ⁻¹ᵁ U.1 := by
        rw [← hP]; intro x hx; exact e hx
      rw [key _ hP e1, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      have h0 : (J.subschemeι.app U.1).hom a = 0 := by
        rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact ha
      rw [h0, map_zero]
  have hL3 :∀ (A : Type u) [CommRing A] [IsLocalRing A] (S : Set A) (α : A),
      α ∈ nonZeroDivisors A → Ideal.span S = Ideal.span {α} →
      ∃ s ∈ S, s ∈ nonZeroDivisors A ∧ Ideal.span {s} = Ideal.span {α} := by
    intro A _ _ S α hα hS
    by_contra hcon
    push_neg at hcon
    have hle : Ideal.span S ≤ IsLocalRing.maximalIdeal A * Ideal.span {α} := by
      rw [Ideal.span_le]
      intro s hs
      have hs' : s ∈ Ideal.span {α} := by rw [← hS]; exact Ideal.subset_span hs
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hs'
      rw [SetLike.mem_coe, Ideal.mem_mul_span_singleton]
      refine ⟨d, ?_, hd⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hdu
      apply hcon s hs
      · rw [← hd]
        exact Submonoid.mul_mem _ (hdu.mem_nonZeroDivisors) hα
      · rw [← hd]
        exact Ideal.span_singleton_mul_left_unit hdu α
    have hαS : α ∈ Ideal.span S := by rw [hS]; exact Ideal.mem_span_singleton_self α
    obtain ⟨m, hm, hmα⟩ := Ideal.mem_mul_span_singleton.mp (hle hαS)
    have h1 : (1 - m) * α = 0 := by rw [sub_mul, one_mul, hmα, sub_self]
    have h2 : 1 - m = 0 := (mem_nonZeroDivisors_iff_right.mp hα) _ h1
    have h3 : m = 1 := (sub_eq_zero.mp h2).symm
    exact (IsLocalRing.mem_maximalIdeal _).mp hm (h3 ▸ isUnit_one)
  have hL2 :∀ (R : Type u) [CommRing R] (n : ℕ) (t : Fin n → R) (h : R)
      (j : Fin n) (g : MvPolynomial (Fin n) R),
      MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g ∈ wcOdpJ0 t j →
      algebraMap R (wcOdpB t j g) h = 0 ∧
      (∀ b, algebraMap R (wcOdpB t j g) (t b) ∈ Ideal.span {algebraMap R (wcOdpB t j g) (t j)}) ∧
      ∀ (D : Type u) [CommRing D] (ρ : R →+* D), ρ h = 0 → ρ (t j) ∈ nonZeroDivisors D →
        (∀ b, ρ (t b) ∈ Ideal.span {ρ (t j)}) →
        ∃! ψ : wcOdpB t j g →+* D, ψ.comp (algebraMap R (wcOdpB t j g)) = ρ := by
    intro R _ n t h j g hG
    have hJle : wcOdpJ0 t j ≤ wcOdpJ0 t j ⊔ Ideal.span {g} := le_sup_left
    have hgmem : g ∈ wcOdpJ0 t j ⊔ Ideal.span {g} :=
      (le_sup_right : Ideal.span {g} ≤ wcOdpJ0 t j ⊔ Ideal.span {g}) (Ideal.mem_span_singleton_self g)
    have hXj : MvPolynomial.X j - 1 ∈ wcOdpJ0 t j := by
      unfold wcOdpJ0; exact Ideal.subset_span (Set.mem_insert _ _)
    have hf : ∀ b, MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈ wcOdpJ0 t j := by
      intro b; unfold wcOdpJ0; exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)
    obtain ⟨mk, hmkdef⟩ : ∃ mk : MvPolynomial (Fin n) R →+* wcOdpB t j g,
        mk = Ideal.Quotient.mk (wcOdpJ0 t j ⊔ Ideal.span {g}) := ⟨_, rfl⟩
    have hal : ∀ x : R, algebraMap R (wcOdpB t j g) x = mk (MvPolynomial.C x) := by
      intro x; rw [hmkdef]; rfl
    have hmk0 : ∀ x ∈ wcOdpJ0 t j, mk x = 0 := fun x hx => by
      rw [hmkdef]; exact Ideal.Quotient.eq_zero_iff_mem.mpr (hJle hx)
    have hmkg : mk g = 0 := by rw [hmkdef]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hgmem
    have hh : algebraMap R (wcOdpB t j g) h = 0 := by
      rw [hal]
      have e : MvPolynomial.C h = (MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g) +
          MvPolynomial.C (t j) ^ 2 * g := by ring
      rw [e, map_add, map_mul, hmk0 _ hG, hmkg, mul_zero, add_zero]
    have hdivB : ∀ b, algebraMap R (wcOdpB t j g) (t b) =
        algebraMap R (wcOdpB t j g) (t j) * mk (MvPolynomial.X b) := by
      intro b
      rw [hal, hal, ← map_mul]
      symm
      rw [← sub_eq_zero, ← map_sub]
      exact hmk0 _ (hf b)
    refine ⟨hh, fun b => Ideal.mem_span_singleton'.mpr ⟨mk (MvPolynomial.X b), by
      rw [hdivB b, mul_comm]⟩, ?_⟩
    intro D _ ρ hρh hρnzd hρdiv
    choose c hc using fun b => Ideal.mem_span_singleton'.mp (hρdiv b)
    obtain ⟨E, hEdef⟩ : ∃ E : MvPolynomial (Fin n) R →+* D, E = MvPolynomial.eval₂Hom ρ c :=
      ⟨_, rfl⟩
    have hEC : ∀ x, E (MvPolynomial.C x) = ρ x := fun x => by rw [hEdef]; exact MvPolynomial.eval₂Hom_C ρ c x
    have hEX : ∀ b, E (MvPolynomial.X b) = c b := fun b => by rw [hEdef]; exact MvPolynomial.eval₂Hom_X' ρ c b
    have hcj : c j = 1 := by
      have h1 : (c j - 1) * ρ (t j) = 0 := by rw [sub_mul, hc j, one_mul, sub_self]
      exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hρnzd) _ h1)
    have hJE : wcOdpJ0 t j ≤ RingHom.ker E := by
      unfold wcOdpJ0
      rw [Ideal.span_le, Set.insert_subset_iff]
      refine ⟨?_, ?_⟩
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, hEX, map_one, hcj, sub_self]
      · rintro _ ⟨b, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, hEC, hEX, hEC, mul_comm, hc b,
          sub_self]
    have hEg : E g = 0 := by
      have h1 : E (MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g) = 0 := hJE hG
      rw [map_sub, map_mul, map_pow, hEC, hEC, hρh, zero_sub, neg_eq_zero] at h1
      have h2 : (E g * ρ (t j)) * ρ (t j) = 0 := by linear_combination h1
      exact (mem_nonZeroDivisors_iff_right.mp hρnzd) _
        ((mem_nonZeroDivisors_iff_right.mp hρnzd) _ h2)
    have hker : wcOdpJ0 t j ⊔ Ideal.span {g} ≤ RingHom.ker E := by
      refine sup_le hJE ?_
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      exact hEg
    refine ⟨Ideal.Quotient.lift _ E (fun a ha => RingHom.mem_ker.mp (hker ha)), ?_, ?_⟩
    · ext x
      rw [RingHom.comp_apply, hal, hmkdef, Ideal.Quotient.lift_mk, hEC]
    · intro ψ' hψ'
      have e0 : ∀ x : R, ρ x = ψ' (algebraMap R (wcOdpB t j g) x) := fun x => by
        rw [← hψ', RingHom.comp_apply]
      rw [hmkdef] at hal hdivB
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk, hEC, e0, hal]
      · intro b
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk, hEX]
        have h1 : (ψ' (Ideal.Quotient.mk _ (MvPolynomial.X b)) - c b) * ρ (t j) = 0 := by
          rw [sub_mul, hc b, e0 (t b), e0 (t j), hdivB b, map_mul]
          ring
        exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hρnzd) _ h1)
  have hL1 :∀ (R : Type u) [CommRing R] (n : ℕ) (t : Fin n → R) (h : R)
      (M : Matrix (Fin n) (Fin n) R) (j : Fin n),
      h - ∑ a, ∑ c, M a c * t a * t c ∈ Ideal.span (Set.range t) ^ 3 →
      ∃ g : MvPolynomial (Fin n) R, MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g ∈ wcOdpJ0 t j ∧
        g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
          wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} := by
    intro R _ n t h M j hq
    have hf : ∀ b, MvPolynomial.C (t b) - MvPolynomial.C (t j) * MvPolynomial.X b ∈ wcOdpJ0 t j := by
      intro b
      have h1 : MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈ wcOdpJ0 t j := by
        unfold wcOdpJ0; exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)
      have h2 := (wcOdpJ0 t j).neg_mem h1
      rwa [neg_sub] at h2
    have hQmul : ∀ a b : ℕ, (wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ a}) *
        (wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ b}) ≤
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ (a + b)} := by
      intro a b
      rw [Ideal.mul_le]
      intro x hx y hy
      obtain ⟨j1, hj1, p, hp, rfl⟩ := Submodule.mem_sup.mp hx
      obtain ⟨j2, hj2, q, hq', rfl⟩ := Submodule.mem_sup.mp hy
      obtain ⟨p', rfl⟩ := Ideal.mem_span_singleton'.mp hp
      obtain ⟨q'', rfl⟩ := Ideal.mem_span_singleton'.mp hq'
