    (D : wcZModPullData V.hom n) (hD : wcZModPullCanonical D) (j : ℕ) (y : wcZModProEtExt T n j) :
    wcZmRho T V n j lam
        ((Abelian.Ext.mk₀ (wcFreeSheafMap T (wcZmToTop T V))).comp (wcZmCt T n j ε κ y) (zero_add j)) =
      wcZmCt V.left n j ε' κ' (wcZModPull D j y) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf V.left n)) := HasExt.standard _

  have h2m : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf V.left n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3m : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf V.left n)} {a : ℕ}
