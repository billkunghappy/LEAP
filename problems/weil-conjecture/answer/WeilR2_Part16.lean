    intro A _ ha hb m hm s hs
    classical

    have s3 : ∀ U : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, IsClopen U → ∃ e : A, e * e = e ∧ ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, (m ∈ U ↔ e ∉ m.1.asIdeal) := by
      intro U hU
      have hclosed : ∀ V : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
