      (x : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V)), h₁ ≫ w' = h₂ ≫ w' →
      (θ'.hom.hom.app (Opposite.op (Over.mk h₁))).hom x =
