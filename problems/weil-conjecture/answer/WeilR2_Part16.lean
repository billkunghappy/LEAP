    rfl

  have hsymm_add : ∀ (V : X.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (a a' : M.val.obj (Opposite.op V)),
      (ev V M).symm (a + a') = (ev V M).symm a + (ev V M).symm a' := by
    intro V M a a'
    apply (ev V M).injective
    rw [hadd, Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hsm : ∀ (V : X.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (s : (wcRingSheaf X ℓ).obj.obj (Opposite.op V)) (x : M.val.obj (Opposite.op V)),
