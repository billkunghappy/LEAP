    haveI : IsPurelyInseparable K (AlgebraicClosure K) :=
      (isSepClosed_iff_isPurelyInseparable_algebraicClosure K (AlgebraicClosure K)).mp inferInstance
    have hinj := (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable K (AlgebraicClosure K)
      (AlgebraicClosure K)).injective
    haveI : Subsingleton ↥(Spec (.of (TensorProduct K (AlgebraicClosure K) (AlgebraicClosure K)))) :=
      hinj.subsingleton
    haveI hsub : Subsingleton ↥(Limits.pullback
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      (Scheme.homeoOfIso (pullbackSpecIso K (AlgebraicClosure K) (AlgebraicClosure K))).injective.subsingleton
    rw [UniversallyInjective.iff_diagonal]
    constructor
    intro y
    exact ⟨Classical.arbitrary _, hsub.elim _ _⟩

  have s2 : ∀ {A B C : Scheme.{u}} (f : A ⟶ C) (g : B ⟶ C)
      [UniversallyClosed g] [UniversallyInjective g] [Surjective g],
      IsHomeomorph ⇑(Limits.pullback.fst f g) := by
    intro A B C f g _ _ _
    rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
    refine ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _, ?_, Scheme.Hom.surjective _⟩
    exact UniversallyInjective.universally_injective (f := g) _ _ _ (IsPullback.of_hasPullback f g)

  have s3 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (D : wcHMPullData f ℓ), wcHMPullCanonical D →
      (∀ V : S.ProEt, IsHomeomorph ⇑(Limits.pullback.fst V.hom f)) →
      IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) := by
    intro S S' f D hD hf
    refine @Functor.FullyFaithful.isIso_of_isIso_map _ _ _ _ _
      (SheafOfModules.fullyFaithfulForget _) _ _ _ ?_
    refine @isIso_of_reflects_iso _ _ _ _ _ _ _ (PresheafOfModules.toPresheaf _) ?_ _
    refine @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ (fun V => ?_)
    refine (ConcreteCategory.isIso_iff_bijective _).mpr ?_
    let H := IsHomeomorph.homeomorph _ (hf V.unop)
    have key : ∀ s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]),
        (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map ((SheafOfModules.forget _).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ))).app V)) s =
          s.comp (Limits.pullback.fst V.unop.hom f).base.hom :=
      fun s => (@SheafOfModules.unitToPushforwardObjUnit_val_app_apply _ _ _ _ _ _ _ _ _ D.cont D.φ
        _ s).trans (hD V.unop s)
    have hb : Function.Bijective (fun s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) =>
        s.comp (Limits.pullback.fst V.unop.hom f).base.hom) := by
      refine ⟨fun a b hab => ?_, fun t => ⟨t.comp ⟨H.symm, H.symm.continuous⟩, ?_⟩⟩
      · refine ContinuousMap.ext (fun v => ?_)
        have h1 : (Limits.pullback.fst V.unop.hom f).base.hom (H.symm v) = v := H.apply_symm_apply v
        have h2 := DFunLike.congr_fun hab (H.symm v)
        change a ((Limits.pullback.fst V.unop.hom f).base.hom (H.symm v)) =
          b ((Limits.pullback.fst V.unop.hom f).base.hom (H.symm v)) at h2
        rwa [h1] at h2
      · refine ContinuousMap.ext (fun w => ?_)
        change t (H.symm ((Limits.pullback.fst V.unop.hom f).base.hom w)) = t w
        rw [show (Limits.pullback.fst V.unop.hom f).base.hom w = H w from rfl, H.symm_apply_apply]
    have he : (fun s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) =>
        s.comp (Limits.pullback.fst V.unop.hom f).base.hom) =
        (fun s : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) =>
          (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map ((SheafOfModules.forget _).map
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ))).app V)) s) :=
      funext (fun s => (key s).symm)
    rw [he] at hb
    exact hb

  let π : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶ Spec (X.residueField x) :=
    Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x) (AlgebraicClosure (X.residueField x))))
  haveI : IsIntegralHom π :=
    (IsIntegralHom.SpecMap_iff (φ := CommRingCat.ofHom (algebraMap (X.residueField x)
      (AlgebraicClosure (X.residueField x))))).mpr (algebraMap_isIntegral_iff.mpr inferInstance)
  haveI : UniversallyInjective π := s1 (X.residueField x)
  haveI : Surjective π := ⟨fun y => ⟨Classical.arbitrary _, Subsingleton.elim _ _⟩⟩
  have hπ : ∀ V : (Spec (X.residueField x)).ProEt, IsHomeomorph ⇑(Limits.pullback.fst V.hom π) :=
    fun V => s2 V.hom π
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists π ℓ
  haveI hu := s3 π Dπ hDπ hπ

  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso (X.fromSpecResidueField x) π (wcEtGeomPt X x) rfl
    Dι hDι Dπ hDπ Dx hDx

  let adj' := (Dι.adj.comp Dπ.adj).ofNatIsoLeft c.symm
  let r := Dx.adj.rightAdjointUniq adj'
  exact ⟨(@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC (X.fromSpecResidueField x)) _ _
      Dι.cont Dι.φ).mapIso
      (asIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC π) _ _ Dπ.cont Dπ.φ)) ≪≫
    (r.app _).symm⟩

theorem wc_pmn_vp_restr_top_point (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) :
    haveI := Dp.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    Nonempty (Di.Φ.obj
      (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n - 1)) ≅
        wcSuppObj Dx) :=
by
  intro P
  haveI := Dp.additive

  obtain ⟨hcl, hsep, hnoeth, huniq⟩ :=
    wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  haveI := hsep
  haveI := hnoeth

  let ι := (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).fromSpecResidueField xs
  haveI : IsClosedImmersion ι := IsClosedImmersion.of_isPreimmersion ι
    (by rw [Scheme.range_fromSpecResidueField]; exact hcl)
  let O : (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens :=
    ⟨({xs} : Set _)ᶜ, hcl.isOpen_compl⟩
  have hO' : (O : Set _) = (Set.range ι)ᶜ := by
    rw [Scheme.range_fromSpecResidueField]; rfl
  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists ι ℓ
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists O.ι ℓ

  have hK0 := wc_pmn_vp_restr_off_node_vanish F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    Dp hDp Di hDi I O (fun z hz h => hz (Set.mem_singleton_iff.mpr (huniq z h))) Dj hDj (n - 1)
    (by omega)

  obtain ⟨M, ⟨σ⟩⟩ :=
    wc_proet_closed_push_essImage_of_open_pull_isZero ι ℓ O hO' Dι hDι Dj hDj _ hK0

  obtain ⟨hF, hFa⟩ := wc_proet_closed_push_modules_full_faithful ι ℓ Dι hDι
  haveI := hF
  haveI := hFa
  haveI : IsIso Dι.adj.counit := Adjunction.counit_isIso_of_R_fully_faithful Dι.adj
  let ε := asIso (Dι.adj.counit.app M)

  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (B := ((wcProEtPullback D.f).obj V).left) x
  have hsh : wcHalShData x B Λ' W'' φ' a' := ⟨h1, h2, h3, h4, h5, eB, h6, h7⟩
  obtain ⟨κ, hκi, hκc⟩ := wc_mnt_fib_rank_le_one F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    x hx₁ hx₂ B Λ' W'' φ' a' hsh
  obtain ⟨y₀, hy₀⟩ := wc_pmn_vp_milnor_top_ne_zero F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L
    eE hE x hx₁ hx₂ B Λ' W'' φ' a' hsh
  have hk0 : κ y₀ ≠ 0 := fun h => hy₀ (hκi (h.trans (map_zero κ).symm))
  have hκs : Function.Surjective κ := fun t =>
    ⟨wcHMScalar _ ℓ (n - 1) (t / κ y₀) y₀, by rw [hκc, div_mul_cancel₀ t hk0]⟩

  let iS := Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)
  let k := ι ≫ iS
  have hk : k (IsLocalRing.closedPoint _) = x := by
    change iS (ι (IsLocalRing.closedPoint _)) = x
    exact (congrArg iS (Scheme.fromSpecResidueField_apply xs _)).trans hxs
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists k ℓ
  obtain ⟨τ⟩ := wc_pmn_vp_node_stalk_line F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    x hx₁ hx₂ B Λ' W'' φ' a' hsh κ hκi hκs hκc Dp hDp I
    ((Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).residueField xs)
    k hk Dk hDk

  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso iS ι k rfl Di hDi Dι hDι Dk hDk

  obtain ⟨ρ⟩ := wc_supp_obj_sepClosed_geomPt_iso xs Dι hDι Dx hDx
  exact ⟨σ.symm ≪≫
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC ι) _ _ Dι.cont Dι.φ).mapIso
      (ε.symm ≪≫ Dι.Φ.mapIso σ ≪≫ (c.app _).symm ≪≫ τ) ≪≫ ρ⟩

theorem wc_pmn_vanishing_point (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) :
    haveI := Dp.additive
    haveI := Di.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let eK := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map Di.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)) ≫
        (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    Limits.IsZero (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ)) ∨
      Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦((n - 1 : ℕ) : ℤ)⟧ ≅
        DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx))) :=
by

  have cone_single : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (N : ℕ) (_hN : 1 ≤ N) (O S : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (e : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O ⟶ Ψ)
      (_h0 : IsIso (HomologicalComplex.homologyMap e 0))
      (_hq : ∀ q : ℤ, q ≠ 0 → q ≠ (N : ℤ) → Limits.IsZero (Ψ.homology q))
      (_hS : Nonempty (Ψ.homology (N : ℤ) ≅ S)),
      Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone e))⟦(N : ℤ)⟧ ≅
        DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj S)) := by
    intro 𝒞 _ _ _ N hN O S Ψ e h0 hq hS
    obtain ⟨σS⟩ := hS
    let T := DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle e)
    have hT : T ∈ Pretriangulated.distinguishedTriangles :=
      DerivedCategory.mappingCone_triangle_distinguished e
    have hA : ∀ q : ℤ, q ≠ 0 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₁) := by
      intro q hq0
      exact Limits.IsZero.of_iso
        (HomologicalComplex.isZero_single_obj_homology _ _ _ _ hq0)
        ((DerivedCategory.homologyFunctorFactors 𝒞 q).app _)
    have hΨ : ∀ q : ℤ, q ≠ 0 → q ≠ (N : ℤ) →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₂) := by
      intro q hq0 hqN
      exact Limits.IsZero.of_iso (hq q hq0 hqN)
        ((DerivedCategory.homologyFunctorFactors 𝒞 q).app _)
    have hm0 : IsIso ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁) := by
      have hnat := (DerivedCategory.homologyFunctorFactors 𝒞 0).hom.naturality e
      have h0' : IsIso ((HomologicalComplex.homologyFunctor 𝒞 (ComplexShape.up ℤ) 0).map e) := h0
      have h2 : IsIso ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor 𝒞 0).map e ≫
          (DerivedCategory.homologyFunctorFactors 𝒞 0).hom.app Ψ) := by
        rw [hnat]; infer_instance
      have h3 : IsIso ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor 𝒞 0).map e) :=
        IsIso.of_isIso_comp_right _ ((DerivedCategory.homologyFunctorFactors 𝒞 0).hom.app Ψ)
      exact h3
    have hX : ∀ q : ℤ, q ≠ (N : ℤ) →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₃) := by
      intro q hqN
      have E3 := DerivedCategory.HomologySequence.exact₃ T hT q (q + 1) rfl
      by_cases hq0 : q = 0
      · subst hq0
        have E2 := DerivedCategory.HomologySequence.exact₂ T hT 0
        apply E3.isZero_of_both_zeros
        · exact E2.epi_f_iff.mp
            (inferInstance : Epi ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁))
        · exact (hA 1 (by norm_num)).eq_of_tgt _ _
      by_cases hqm : q = -1
      · subst hqm
        have E1 := DerivedCategory.HomologySequence.exact₁ T hT (-1) 0 (by norm_num)
        apply E3.isZero_of_both_zeros
        · exact (hΨ (-1) (by norm_num) (by omega)).eq_of_src _ _
        · exact E1.mono_g_iff.mp
            (inferInstance : Mono ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁))
      · apply E3.isZero_of_both_zeros
        · exact (hΨ q hq0 hqN).eq_of_src _ _
        · exact (hA (q + 1) (by omega)).eq_of_tgt _ _
    have hXN : IsIso ((DerivedCategory.homologyFunctor 𝒞 N).map T.mor₂) := by
      have E3 := DerivedCategory.HomologySequence.exact₃ T hT N (N + 1) rfl
      have E2 := DerivedCategory.HomologySequence.exact₂ T hT N
      have : Epi ((DerivedCategory.homologyFunctor 𝒞 N).map T.mor₂) :=
        E3.epi_f ((hA (N + 1) (by omega)).eq_of_tgt _ _)
      have : Mono ((DerivedCategory.homologyFunctor 𝒞 N).map T.mor₂) :=
        E2.mono_g ((hA N (by omega)).eq_of_src _ _)
      exact isIso_of_mono_of_epi _
    have hGE : T.obj₃.IsGE N := by
      rw [DerivedCategory.isGE_iff]
      intro q hq
      exact hX q (by omega)
    have hLE : T.obj₃.IsLE N := by
      rw [DerivedCategory.isLE_iff]
      intro q hq
      exact hX q (by omega)
    obtain ⟨Yo, ⟨σ⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE T.obj₃ N
    have eY : Yo ≅ S :=
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒞 N).app Yo).symm ≪≫
        (DerivedCategory.homologyFunctor 𝒞 N).mapIso σ.symm ≪≫
        (asIso ((DerivedCategory.homologyFunctor 𝒞 N).map T.mor₂)).symm ≪≫
        (DerivedCategory.homologyFunctorFactors 𝒞 N).app Ψ ≪≫ σS
    exact ⟨(shiftFunctor _ (N : ℤ)).mapIso σ ≪≫
      ((DerivedCategory.singleFunctors 𝒞).shiftIso N 0 N (by simp)).app Yo ≪≫
      (DerivedCategory.singleFunctor 𝒞 0).mapIso eY ≪≫
      (DerivedCategory.singleFunctorIsoCompQ 𝒞 0).app S⟩

  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
