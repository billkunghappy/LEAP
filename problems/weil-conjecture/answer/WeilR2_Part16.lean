            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
