    let TΨ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    let F := P ⋙ Dg.Φ
    let Hq := HomotopyCategory.quotient (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (ComplexShape.up ℤ)
    let Hq' := HomotopyCategory.quotient (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (ComplexShape.up ℤ)
    let c := fun y : wcHM S' ℓ N =>
      (show Hq.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
