      change Limits.pullback.fst h.left k.left ≫ T.hom = Limits.pullback.snd h.left k.left ≫ U'.hom
      rw [← MorphismProperty.Over.w h, ← MorphismProperty.Over.w k, ← Category.assoc,
        Limits.pullback.condition, Category.assoc]) trivial
    obtain ⟨t', _, ht'⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := h.left) (g := k.left) t p' ht
