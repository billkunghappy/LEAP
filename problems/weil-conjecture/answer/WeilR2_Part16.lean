    have s3 : ∀ (T : Scheme.{u}) [IsAffine T] (g : T ⟶ Spec (.of Ω)), WeaklyEtale g →
        ∀ (j : ℕ) (x : wcHM T ℓ (j + 1)), x = 0 := by
