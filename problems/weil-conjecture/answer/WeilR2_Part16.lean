by
  classical

  have hext : ∀ (k : ℕ) (V : (wcP1Over F'').left.ProEt)
      (f g : (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval (wcP1Over F'').left V f z = wcContEval (wcP1Over F'').left V g z) →
      f = g := by
    intro k V f g hfg
    apply ULift.ext
    apply ContinuousMap.ext
    exact hfg

  have hSig := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hO : ∀ p : (wcP1Over F'').left, p ∈ wcPencilSOpen D ↔
      ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro p
    show p ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
