    refine ⟨z', ?_⟩
    apply (Scheme.Hom.isOpenEmbedding
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom)).injective
    exact (Scheme.Hom.comp_apply wl _ z').symm.trans
      ((congrArg (fun f : Limits.pullback (wcPencilSOpen D).ι W.hom ⟶
          (wcGeomPoint F'' (wcP1Over F'') hP).left => f z') hwl2).trans
        ((Scheme.Hom.comp_apply _ _ z').trans ((congrArg (fun y => w.left y) hz'2).trans hz)))

  have havoid : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ W') (v : V.left) (i : Fin D.m),
      V.hom v ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro V h v i hv
    have e0 : V.hom v = (Limits.pullback.snd (wcPencilSOpen D).ι W.hom ≫ W.hom) (h.left v) :=
      (congrArg (fun f : V.left ⟶ (wcP1Over F'').left => f v)
        (MorphismProperty.Over.w h)).symm.trans (Scheme.Hom.comp_apply _ _ _)
    exact hSO i (((e0.trans (keyW _)).symm.trans hv) ▸ hrange _)

  let θ' : (wcRq D.f ℓ (2 * (n - 1))).over W' ≅
