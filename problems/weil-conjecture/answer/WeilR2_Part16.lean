    rw [hfun]
    exact hpost.comp h1
  refine ⟨fun q W => AddEquiv.ofBijective (Θ₀ q W) (hΘbij q W), ?_, ?_⟩
  · intro q W s β
    rw [AddEquiv.ofBijective_apply, AddEquiv.ofBijective_apply, hΘ₀, hΘ₀]
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (ε W))
      (Abelian.Ext.mk₀ ((wcSliceRes S ℓ W).map ((ev W (P W)).symm (s • ev W (P W) (𝟙 _)))))]
    rw [Abelian.Ext.mk₀_comp_mk₀, hL W s, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]
  · intro q W W' b Db hDb β
    rw [AddEquiv.ofBijective_apply, AddEquiv.ofBijective_apply, hΘ₀, hΘ₀]
    haveI : WeaklyEtale (b.left ≫ W.hom) := (MorphismProperty.Over.w b) ▸ W'.prop
    haveI : WeaklyEtale b.left := WeaklyEtale.of_comp b.left W.hom
    obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso W.left ℓ (Scheme.ProEt.mk b.left) Db hDb
    haveI := Db.additive
