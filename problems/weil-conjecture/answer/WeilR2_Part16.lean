      rw [← hnat V (Pf V) M ((ev V M).symm x) (𝟙 _), Category.id_comp]
    refine Eq.symm ?_
    calc (((ev V M).symm x).val.app (Opposite.op V)).hom
          (ev V (Pf V) ((ev V (Pf V)).symm (s • ev V (Pf V) (𝟙 _))))
        = (((ev V M).symm x).val.app (Opposite.op V)).hom (s • ev V (Pf V) (𝟙 _)) :=
          congrArg _ e1
      _ = s • (((ev V M).symm x).val.app (Opposite.op V)).hom (ev V (Pf V) (𝟙 _)) :=
          map_smul _ _ _
      _ = s • x := by rw [← e2, Equiv.apply_symm_apply]
  have hrs : ∀ (V V' : X.ProEt) (b : V' ⟶ V) (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
