    have e : ev ((wcProEtBC g).obj W) (I.cocomplex.X n) (τ W n s) = s :=
      Equiv.apply_symm_apply _ _
    rw [hnat, e]
    exact Equiv.apply_symm_apply _ _
  choose Λ hΛ using fun (W : Y.ProEt) (hW : Projective (wcFreeSheaf Y W)) =>
    s1 W hW (Pf ((wcProEtBC g).obj W)) (τ W) (fun n => (ev _ _).symm.bijective) (hcomm W)
  have hzc : ∀ (W : Y.ProEt) (z : (K.cycles q).val.obj (Opposite.op W)),
      τ W q (((K.iCycles q).val.app (Opposite.op W)).hom z) ≫ I.cocomplex.d q (q + 1) = 0 := by
    intro W z
    rw [← hcomm]
    have h0 : ((K.d q (q + 1)).val.app (Opposite.op W)).hom
        (((K.iCycles q).val.app (Opposite.op W)).hom z) = 0 := by
      rw [show ((K.d q (q + 1)).val.app (Opposite.op W)).hom
          (((K.iCycles q).val.app (Opposite.op W)).hom z) =
          ((K.iCycles q ≫ K.d q (q + 1)).val.app (Opposite.op W)).hom z from rfl,
        K.iCycles_d]
      rfl
    rw [h0, map_zero]
  have hcong : ∀ (A : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (f f' : A ⟶ I.cocomplex.X q)
      (_ : f = f') (hf : f ≫ I.cocomplex.d q (q + 1) = 0)
      (hf' : f' ≫ I.cocomplex.d q (q + 1) = 0),
