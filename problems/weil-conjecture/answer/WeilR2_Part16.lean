      (SheafOfModules.unit (wcRingSheaf S ℓ)) q
    have hpost : Function.Bijective (fun x : Abelian.Ext
        (SheafOfModules.unit (wcRingSheaf W.left ℓ))
        ((wcSliceRes S ℓ W).obj (SheafOfModules.unit (wcRingSheaf S ℓ))) q =>
          x.comp (Abelian.Ext.mk₀ (inv (wcSliceUnit S ℓ W))) (add_zero q)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun z => z.comp (Abelian.Ext.mk₀ (wcSliceUnit S ℓ W)) (add_zero q), fun x => ?_,
          fun z => ?_⟩
      · show (x.comp (Abelian.Ext.mk₀ (inv (wcSliceUnit S ℓ W))) (add_zero q)).comp
          (Abelian.Ext.mk₀ (wcSliceUnit S ℓ W)) (add_zero q) = x
        rw [h3, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      · show (z.comp (Abelian.Ext.mk₀ (wcSliceUnit S ℓ W)) (add_zero q)).comp
          (Abelian.Ext.mk₀ (inv (wcSliceUnit S ℓ W))) (add_zero q) = z
        rw [h3, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    have hfun : (Θ₀ q W : Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q →
        wcHM W.left ℓ q) =
        (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf W.left ℓ))
          ((wcSliceRes S ℓ W).obj (SheafOfModules.unit (wcRingSheaf S ℓ))) q =>
            x.comp (Abelian.Ext.mk₀ (inv (wcSliceUnit S ℓ W))) (add_zero q)) ∘
        (fun β : Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q =>
          (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W) β)
            (zero_add q)) := by
