        rw [wc_et_pull_comp (b ∣_ O) (inv (b ∣_ O)) (𝟙 _) (IsIso.inv_hom_id _) Dφ Dψ Did s a, ha,
          map_zero]
      have h1 := wc_et_smooth_pair_open_restr_surj K (b ≫ p) N iE ℓ hℓK (b ⁻¹ᵁ O) hU hD s hs DU
      have h2 := wc_et_abstract_blowup_pull_surj X Xt _ b (X.fromSpecResidueField z) hisoZ ℓ hℓ0 s
        hE's Db
      obtain ⟨w, hw⟩ := h1 (wcEtPull Dφ s y)
      obtain ⟨v, hv⟩ := h2 w
      refine ⟨v, ?_⟩
      have e1 := wc_et_pull_comp b (b ⁻¹ᵁ O).ι ((b ⁻¹ᵁ O).ι ≫ b) rfl Db DU Dk s v
      have e2 := wc_et_pull_comp O.ι (b ∣_ O) ((b ⁻¹ᵁ O).ι ≫ b) (morphismRestrict_ι b O)
        Dj Dφ Dk s v
      apply sub_eq_zero.mp
      apply hφinj
      rw [map_sub, ← e2, e1, hv, hw, sub_self]

    let ιO : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 X) :=
      MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
    haveI hXc : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
    haveI hXqs : QuasiSeparatedSpace X := IsLocallyNoetherian.quasiSeparatedSpace
    haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
    haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
    haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace
    have hmono : Mono (wcFreeSheafMap X ιO) :=
      wc_free_sheaf_map_mono X _ _ ιO (IsOpenImmersion.mono O.ι)
    have hS₀ : (ShortComplex.mk (wcFreeSheafMap X ιO) (Limits.cokernel.π (wcFreeSheafMap X ιO))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O.ι ℓ
    obtain ⟨FY, FO, hc⟩ := wc_proet_open_restr_et_model X O ℓ s Dj
    let π := (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X ιO))).precomp
      (wcZModSheaf X ℓ) (zero_add (2 * N))
    have hπ : Function.Injective π := by
      rw [injective_iff_map_eq_zero]
      intro t ht
      have ht' : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X ιO))).comp t
          (zero_add (2 * N)) = 0 := ht
      obtain ⟨a, ha⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ _ t ht'
        (show 1 + s = 2 * N by omega)
      obtain ⟨y, rfl⟩ := FO.surjective a
      obtain ⟨v, rfl⟩ := hrestr Dj y
      rw [← ha, ← hc v, ← Abelian.Ext.comp_assoc_of_second_deg_zero]
      have hcz : hS₀.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap X ιO)) (add_zero 1) = 0 :=
        hS₀.extClass_comp
      rw [hcz, Abelian.Ext.zero_comp]
    obtain ⟨eY⟩ := wc_proet_etale_comparison_zmod K X p ℓ (2 * N)
    haveI := hfin
    haveI := hfX
    haveI : Finite (Abelian.Ext (wcFreeSheaf X (Scheme.ProEt.mk (𝟙 X))) (wcZModSheaf X ℓ) (2 * N)) :=
      Finite.of_equiv _ eY.symm
    refine ⟨Finite.of_injective π hπ, ?_⟩
    calc Nat.card _ ≤ Nat.card (Abelian.Ext (wcFreeSheaf X (Scheme.ProEt.mk (𝟙 X)))
          (wcZModSheaf X ℓ) (2 * N)) := Nat.card_le_card_of_injective π hπ
      _ = Nat.card (wcEtCoh X ℓ (2 * N)) := Nat.card_congr eY
      _ ≤ Nat.card (wcEtCoh Xt ℓ (2 * N)) := hcard
      _ ≤ ℓ := hcX
  have hgeom := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  haveI hac : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  have hbasic := wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs
  haveI := hbasic.1
  haveI := hgeom.2.2.1
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have hu := (wc_pmn_vp_off_node_smooth F' F'' Y n D ℓ hℓ i V A e hV ⊥
      (fun z hz => by simp at hz)).1
    have hu' := hu.map (IsLocalRing.residue A)
    rw [map_natCast] at hu'
    exact hu'.ne_zero
  obtain ⟨Xt, E, b, iE, hb, hiE, hiso, hrE, hsmX, hsmE, hirrX, hirrE⟩ :=
    wc_pmn_tsl_odp_fibre_blowup F' F'' Y n hn hn2 D ℓ hℓ i V A e hV x hx₁ hx₂ xs hxs h4
  exact core (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs hgeom.1 O hO
    (n - 1) (by omega) hℓk Xt E b iE hb hiE hiso hrE hsmX hsmE hirrX hirrE

theorem wc_pmn_tsl_local_coh_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (Dx : wcHMPullData (wcEtGeomPt
      (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs) ℓ)
    (hDx : wcHMPullCanonical Dx) (h4 : 4 ≤ n) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    ∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (wcSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj (SheafOfModules.unit
          (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))))⟦
          ((n - 1 : ℕ) : ℤ) + ((n - 1 : ℕ) : ℤ)⟧, a ≠ 0 →
      ∃ c : wcSuppObj Dx ⟶ wcSuppObj Dx,
        w = DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a :=
by
  classical

  have toDer : ∀ (X : Scheme.{u}) (S : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (m : ℕ) (k : ℤ),
      (m : ℤ) = k →
      letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (∀ a w : Abelian.Ext S (SheafOfModules.unit (wcRingSheaf X ℓ)) m, a ≠ 0 →
        ∃ c : S ⟶ S, w = (Abelian.Ext.mk₀ c).comp a (zero_add m)) →
      ∀ a w : DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
            (SheafOfModules.unit (wcRingSheaf X ℓ))))⟦k⟧, a ≠ 0 →
        ∃ c : S ⟶ S, w = DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ a := by
    intro X S m k hk
    letI := HasExt.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    subst hk
    intro H a w ha
    let ι := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) 0
    let Φ : Abelian.Ext S (SheafOfModules.unit (wcRingSheaf X ℓ)) m →
        (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj S) ⟶
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ 0).obj
            (SheafOfModules.unit (wcRingSheaf X ℓ))))⟦(m : ℤ)⟧) :=
      fun z => ι.inv.app S ≫ z.hom ≫ (ι.hom.app (SheafOfModules.unit (wcRingSheaf X ℓ)))⟦(m : ℤ)⟧'
    have hsurj : ∀ f, ∃ z, Φ z = f := by
      intro f
      refine ⟨Abelian.Ext.homEquiv.symm (ι.hom.app S ≫ f ≫
        (ι.inv.app (SheafOfModules.unit (wcRingSheaf X ℓ)))⟦(m : ℤ)⟧'), ?_⟩
      show ι.inv.app S ≫ Abelian.Ext.homEquiv (Abelian.Ext.homEquiv.symm _) ≫ _ = f
      rw [Equiv.apply_symm_apply]
      simp only [Category.assoc, Iso.inv_hom_id_app_assoc, ← Functor.map_comp,
        Iso.inv_hom_id_app]
      exact (congrArg (fun t => f ≫ t) (CategoryTheory.Functor.map_id _ _)).trans
        (Category.comp_id f)
    have hkey : ∀ z, ι.hom.app S ≫ Φ z ≫
        (ι.inv.app (SheafOfModules.unit (wcRingSheaf X ℓ)))⟦(m : ℤ)⟧' = z.hom := by
      intro z
      simp only [Φ, Category.assoc, Iso.hom_inv_id_app_assoc, ← Functor.map_comp,
        Iso.hom_inv_id_app]
      exact (congrArg (fun t => z.hom ≫ t) (CategoryTheory.Functor.map_id _ _)).trans
        (Category.comp_id z.hom)
    have hinj : ∀ z₁ z₂, Φ z₁ = Φ z₂ → z₁ = z₂ := by
      intro z₁ z₂ h
      have h' : z₁.hom = z₂.hom := by rw [← hkey z₁, ← hkey z₂, h]
      exact Abelian.Ext.homEquiv.injective h'
    have hΦ0 : Φ 0 = 0 := by
      simp only [Φ, Abelian.Ext.zero_hom, Limits.zero_comp, Limits.comp_zero]
    have hnat : ∀ (c : S ⟶ S) z, Φ ((Abelian.Ext.mk₀ c).comp z (zero_add m)) =
        DerivedCategory.Q.map ((CochainComplex.singleFunctor _ 0).map c) ≫ Φ z := by
      intro c z
      have e1 : ((Abelian.Ext.mk₀ c).comp z (zero_add m)).hom =
          (DerivedCategory.singleFunctor _ 0).map c ≫ z.hom := by
        rw [Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, ShiftedHom.mk₀_comp]
      have e2 := ι.inv.naturality c
      simp only [Φ, e1, Category.assoc]
      rw [← reassoc_of% e2]
    obtain ⟨a', rfl⟩ := hsurj a
    obtain ⟨w', rfl⟩ := hsurj w
    have ha' : a' ≠ 0 := by
      rintro rfl
      exact ha hΦ0
    obtain ⟨c, hc⟩ := H a' w' ha'
    exact ⟨c, by rw [hc, hnat]⟩

  have lineι : ∀ {Ys Zs : Scheme.{u}} (ι : Zs ⟶ Ys) [IsClosedImmersion ι] [IsLocallyNoetherian Ys]
      [CompactSpace Ys] (O : Ys.Opens) (hO : (O : Set Ys) = (Set.range ι)ᶜ) (Nd : ℕ)
      (hfin1 : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Ys
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Ys)))) (wcZModSheaf Ys ℓ) Nd))
      (hcard1 : Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Ys
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Ys)))) (wcZModSheaf Ys ℓ) Nd) ≤ ℓ)
      (hvan : ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Ys
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Ys)))) (wcZModSheaf Ys ℓ) (Nd + 1), z = 0)
      (hge : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Ys
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Ys)))) (wcZModSheaf Ys (ℓ ^ k)) Nd) →
        ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Ys
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Ys)))) (wcZModSheaf Ys (ℓ ^ k)) Nd))
      (Dι : wcHMPullData ι ℓ) (hDι : wcHMPullCanonical Dι),
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Ys ℓ)) := HasExt.standard _
      ∀ v w : wcSuppExt Dι Nd, v ≠ 0 →
        ∃ c : wcSuppObj Dι ⟶ wcSuppObj Dι, w = (Abelian.Ext.mk₀ c).comp v (zero_add Nd) := by
    intro Ys Zs ι _ _ _ O hO Nd hfin1 hcard1 hvan hge Dι hDι
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Ys ℓ)) := HasExt.standard _
    intro v w hv
    have key : ∀ (c : ℚ_[ℓ]) (U : (Ys.ProEt)ᵒᵖ)
        (x : ((wcLadicSheaf Ys ℓ).obj.obj U : Type (u+1))),
        (wcLadicScalar Ys ℓ c).hom.app U x =
          (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget Ys ⋙
            Over.forget Ys).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
      intro c U x
      rfl
    have hscmul : ∀ a b : ℚ_[ℓ], wcLadicScalar Ys ℓ a ≫ wcLadicScalar Ys ℓ b =
        wcLadicScalar Ys ℓ (b * a) := by
      intro a b
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
        key, key, key]
      exact congrArg ULift.up (mul_smul b a _).symm
    have hsc0 : wcLadicScalar Ys ℓ 0 = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [key]
      apply ULift.ext
      apply ContinuousMap.ext
      intro p
      exact zero_smul ℚ_[ℓ] _
    have htf : ∀ (V : (Ys.ProEt)ᵒᵖ) (k : ℕ)
        (r : ↑((wcRingSheaf Ys ℓ).obj.obj V)), k ≠ 0 → k • r = 0 → r = 0 := by
      intro V k r hk hr
      have hc : ((k : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
      have key2 : ∀ {T : Type u} [TopologicalSpace T] (a : C(T, ULift.{u+1} ℚ_[ℓ])),
          k • a = 0 → a = 0 := by
        intro T _ a h
        refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
        have h1 : k • (a t).down = 0 :=
          congrArg (fun g : C(T, ULift.{u+1} ℚ_[ℓ]) => (g t).down) h
        rw [nsmul_eq_mul] at h1
        exact (mul_eq_zero.mp h1).resolve_left hc
      exact key2 (T := ↥((Scheme.ProEt.forget Ys ⋙ Over.forget Ys).obj
        (Opposite.unop V))) r hr
    obtain ⟨L, adj, hA, hL, hC⟩ := sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
      (Scheme.ProEt.topology Ys) (wcRingSheaf Ys ℓ) htf
    haveI := hA
    haveI := hL
    haveI := hC
    obtain ⟨ε, hσρ, hex⟩ := wc_closed_supp_kernel_free ι ℓ Dι hDι L adj O hO
    haveI := wc_supp_unit_epi_of_noetherian ι ℓ Dι hDι
    have hc := hex.gIsCokernel
    let e := (Limits.cokernelIsCokernel _).coconePointUniqueUpToIso hc
    let Ψ := fun v' : wcSuppExt Dι Nd => (Abelian.Ext.mk₀ e.hom).comp v' (zero_add Nd)
    have hΨinj : Function.Injective Ψ := by
      intro v₁ v₂ h
      have k : ∀ v' : wcSuppExt Dι Nd,
          (Abelian.Ext.mk₀ e.inv).comp (Ψ v') (zero_add _) = v' := by
        intro v'
        show (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp v' (zero_add _))
          (zero_add _) = v'
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add Nd) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      rw [← k v₁, ← k v₂, h]
