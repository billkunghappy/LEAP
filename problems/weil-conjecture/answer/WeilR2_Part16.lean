        (θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x =
          (θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x :=
by
  classical

  obtain ⟨tr, htr⟩ := wc_pencil_R2_geom_trace F' F'' Y n hn2 D ℓ hℓ hP

  obtain ⟨V₀, A, _, _, _, e, ε, ι, hv, -⟩ :=
