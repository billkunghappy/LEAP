        y.comp (Abelian.Ext.mk₀ (ZmMap _ _ (Over.homMk (p₁ ≫ e) (Category.comp_id _) :
          Over.mk (p₁ ≫ e) ⟶ Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))))) (add_zero 2)) :=
      wc_qcfin_fet_trace_h2_bijective F'' ℓ hℓ hP m S hS r Ub hUb Z (p₁ ≫ e) πZ hπZ
        hfZ heZ hsZ hcZ
    obtain ⟨cZ, hcZ'⟩ := hbZ.2 η
    have hcZ'' : cZ.comp (Abelian.Ext.mk₀ (ZmMap _ _ (Over.homMk (p₁ ≫ e) (Category.comp_id _) :
          Over.mk (p₁ ≫ e) ⟶ Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))))) (add_zero 2) = η :=
      hcZ'
    have hpi : ∀ (p : Z ⟶ ℰ) (hp : p ≫ e = p₁ ≫ e),
        cZ.comp (Abelian.Ext.mk₀ (ZmMap _ _
            (Over.homMk p hp : Over.mk (p₁ ≫ e) ⟶ Over.mk e))) (add_zero 2) = c := by
      intro p hp
      apply hbij.1
      dsimp only
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hfun, hc']
      have hm : (Over.homMk p hp : Over.mk (p₁ ≫ e) ⟶ Over.mk e) ≫
          (Over.homMk e (Category.comp_id e) :
            Over.mk e ⟶ Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))) =
          (Over.homMk (p₁ ≫ e) (Category.comp_id _) :
            Over.mk (p₁ ≫ e) ⟶ Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))) := by
        apply Over.OverMorphism.ext
        simp [hp]
      rw [hm, hcZ'']
    have key := hψtr Z (p₁ ≫ e) p₁ p₂ rfl h21 h hrelZ a'
    show Φ.symm (G (h a')) = Φ.symm (G a')
    congr 1
    rw [hG, hG]
    calc c.comp (Abelian.Ext.mk₀ (ψ (h a'))) (add_zero 2)
        = (cZ.comp (Abelian.Ext.mk₀ (ZmMap _ _
            (Over.homMk p₂ h21 : Over.mk (p₁ ≫ e) ⟶ Over.mk e))) (add_zero 2)).comp
            (Abelian.Ext.mk₀ (ψ (h a'))) (add_zero 2) := by rw [hpi p₂ h21]
      _ = cZ.comp (Abelian.Ext.mk₀ (ZmMap _ _
            (Over.homMk p₂ h21 : Over.mk (p₁ ≫ e) ⟶ Over.mk e) ≫ ψ (h a'))) (add_zero 2) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
      _ = cZ.comp (Abelian.Ext.mk₀ (ZmMap _ _
            (Over.homMk p₁ rfl : Over.mk (p₁ ≫ e) ⟶ Over.mk e) ≫ ψ a')) (add_zero 2) := by
          rw [key]
      _ = (cZ.comp (Abelian.Ext.mk₀ (ZmMap _ _
            (Over.homMk p₁ rfl : Over.mk (p₁ ≫ e) ⟶ Over.mk e))) (add_zero 2)).comp
            (Abelian.Ext.mk₀ (ψ a')) (add_zero 2) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
      _ = c.comp (Abelian.Ext.mk₀ (ψ a')) (add_zero 2) := by rw [hpi p₁ rfl]

theorem wc_qclift_finite_coinv_surj (F'' : Type u) [Field F''] [Finite F'']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (hu0S : ∀ i, u0 (IsLocalRing.closedPoint F'') ≠ S i (IsLocalRing.closedPoint F''))
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (r : ℕ) (hL : (ℓ ^ r : ℕ) • 𝟙 L = 0)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ)
    (θr : L.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W) :
    ∃ Γ : (Fin k → ZMod (ℓ ^ r)) →+ wcCohG F'' (wcP1Over F'') hP L 2,
      Function.Surjective Γ ∧
      ∀ (γ : W ⟶ W) (g : (Fin k → ZMod (ℓ ^ r)) →+ (Fin k → ZMod (ℓ ^ r))), γ ≫ w = w →
        (∀ (s : L.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g ((show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ a, Γ (g a) = Γ a :=
by
  obtain ⟨Ub, hUb, ℰ, e, πE, hπE, hfin, het, hsE, hEc, θE, V, ι, c, hVc, hce, hcomp, hlift⟩ :=
    wc_qcfin_frame_fet_descent F'' hP m S hS L ℓ r W w hqc hconn hsurj k θr
  obtain ⟨Γ, hΓs, hΓinv⟩ := wc_qcfin_fet_coinv_surj F'' ℓ hℓ hP m S hS L r hL k Ub hUb ℰ e πE
    hπE hfin het hsE hEc θE
  refine ⟨Γ, hΓs, ?_⟩
  intro γ g hγ hfr a'
  obtain ⟨γ', hγ'⟩ := hlift γ hγ

  have hext : ∀ (V₁ : (wcP1Over F'').left.ProEt) (v : V₁ ⟶ W) (x : L.obj.obj (Opposite.op V₁))
      (z : V₁.left),
      (show C(↥V₁.left, Fin k → ZMod (ℓ ^ r)) from
        ((θr.hom.hom.app (Opposite.op (Over.mk (v ≫ γ)))).hom x).down) z =
      g ((show C(↥V₁.left, Fin k → ZMod (ℓ ^ r)) from
        ((θr.hom.hom.app (Opposite.op (Over.mk v))).hom x).down) z) := by
    have invhom : ∀ (T : (Over W)ᵒᵖ)
        (y : ((wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W).obj.obj T),
        (θr.hom.hom.app T).hom ((θr.inv.hom.app T).hom y) = y := by
      intro T y
      exact congrArg (fun φ => (φ.hom.app T).hom y) θr.inv_hom_id
    have hominv : ∀ (T : (Over W)ᵒᵖ) (y : (L.over W).obj.obj T),
        (θr.inv.hom.app T).hom ((θr.hom.hom.app T).hom y) = y := by
      intro T y
      exact congrArg (fun φ => (φ.hom.app T).hom y) θr.hom_inv_id
    let β : (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W :=
      ObjectProperty.homMk (θr.inv.hom ≫ (Over.map γ).op.whiskerLeft θr.hom.hom)
    obtain ⟨g', _, hg'⟩ := wc_contSheaf_over_hom_pointwise (wcP1Over F'').left
      (Fin k → ZMod (ℓ ^ r)) (Fin k → ZMod (ℓ ^ r)) W β
    have hβ : ∀ (V₁ : (wcP1Over F'').left.ProEt) (v : V₁ ⟶ W) (x : L.obj.obj (Opposite.op V₁)),
        (β.hom.app (Opposite.op (Over.mk v))).hom
            ((θr.hom.hom.app (Opposite.op (Over.mk v))).hom x) =
          (θr.hom.hom.app (Opposite.op (Over.mk (v ≫ γ)))).hom x := by
      intro V₁ v x
      show (θr.hom.hom.app (Opposite.op ((Over.map γ).obj (Over.mk v)))).hom
        ((θr.inv.hom.app (Opposite.op (Over.mk v))).hom
          ((θr.hom.hom.app (Opposite.op (Over.mk v))).hom x)) = _
      exact congrArg (fun y => (θr.hom.hom.app
        (Opposite.op ((Over.map γ).obj (Over.mk v)))).hom y) (hominv (Opposite.op (Over.mk v)) x)
    have hβpt : ∀ (V₁ : (wcP1Over F'').left.ProEt) (v : V₁ ⟶ W)
        (x : L.obj.obj (Opposite.op V₁)) (z : V₁.left),
        (show C(↥V₁.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (v ≫ γ)))).hom x).down) z =
        g' (v.left z) ((show C(↥V₁.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk v))).hom x).down) z) := by
      intro V₁ v x z
      rw [← hβ V₁ v x]
      exact hg' (Over.mk v) _ z
    have hgg : ∀ z : W.left, g' z = g := by
      intro z
      refine AddMonoidHom.ext fun a => ?_
      let cA : ((wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W).obj.obj
          (Opposite.op (Over.mk (𝟙 W))) := ULift.up (ContinuousMap.const ↥W.left a)
      let s : L.obj.obj (Opposite.op W) := (θr.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom cA
      have hs : (θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s = cA := invhom _ cA
      have ha : (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = a := by
        rw [hs]
        rfl
      have h3 : (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W ≫ γ)))).hom s).down) z =
          (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z := by
        rw [Category.id_comp]
      calc g' z a = g' ((𝟙 W : W ⟶ W).left z) ((show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) := by
            rw [ha]
            rfl
        _ = _ := (hβpt W (𝟙 W) s z).symm
        _ = _ := h3
        _ = _ := hfr s z
        _ = g a := by rw [ha]
    intro V₁ v x z
    rw [hβpt V₁ v x z, hgg]
  refine hΓinv V c (γ' ≫ c) g hVc ?_ ?_ a'
  · calc c ≫ e = ι ≫ w := hce
      _ = ι ≫ γ ≫ w := by rw [hγ]
      _ = (γ' ≫ ι) ≫ w := by rw [hγ', Category.assoc]
      _ = (γ' ≫ c) ≫ e := by rw [Category.assoc, Category.assoc, hce]
  · intro x z
    have e1 := hcomp V γ' x z
    have e2 : ∀ (c' : V ⟶ ℰ) (ι' : V ⟶ W), c' = 𝟙 V ≫ c → ι' = 𝟙 V ≫ ι →
        (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
          ((θE.hom.hom.app (Opposite.op (Over.mk c'))).hom x).down) z =
        (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk ι'))).hom x).down) z := by
      intro c' ι' hc' hι'
      subst hc' hι'
      exact hcomp V (𝟙 V) x z
    have e3 := e2 c ι (Category.id_comp c).symm (Category.id_comp ι).symm
    have e4 : (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (γ' ≫ ι)))).hom x).down) z =
        (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (ι ≫ γ)))).hom x).down) z := by
      rw [hγ']
    refine e1.trans (e4.trans ((hext V ι x z).trans ?_))
    rw [e3]

theorem wc_qclift_finite_level_H2_killed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
    (θ : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W) (x : (Subobject.underlying.obj M).obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject (Subobject.underlying.obj M))
    (hJ : ∀ (V : (wcP1Over F'').left.ProEt) (s : (Subobject.underlying.obj M).obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over F'').left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom (((Subobject.underlying.obj M).obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (c : ℕ) (hc : ∀ u : Fin k → ℚ_[ℓ], (∀ i, ‖u i‖ ≤ 1) →
      ((ℓ : ℚ_[ℓ]) ^ c) • u ∈ AddSubgroup.closure
        {v | ∃ h ∈ {h : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]) | ∃ γ : W ⟶ W, γ ≫ w = w ∧
            ∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
              (show C(↥W.left, Fin k → ℚ_[ℓ]) from
                ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
              h ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
                ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)},
          ∃ u' : Fin k → ℚ_[ℓ], (∀ i, ‖u' i‖ ≤ 1) ∧ v = P (h (P.symm u')) - u'}) :
    ∀ (r : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
        (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) 2),
      (ℓ ^ c : ℕ) • x = 0 :=
by
  intro r x
  haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero r (Fact.out : ℓ.Prime).ne_zero⟩
  have hne : Nonempty W.left := @ConnectedSpace.toNonempty _ _ hconn
  obtain ⟨θr, hθr⟩ := wc_qclift_level_frame F'' hP ℓ (Subobject.underlying.obj M) W hne k θ P
    hint J hJ r
  have hL : (ℓ ^ r : ℕ) • 𝟙 (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) = 0 := by
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))),
      Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero]
    have h0 := Limits.cokernel.condition ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))
    rwa [Preadditive.nsmul_comp, Category.id_comp] at h0
  obtain ⟨Γ, hΓs, hΓinv⟩ := wc_qclift_finite_coinv_surj F'' ℓ hℓ hP D.m D.S D.hS D.u0 D.hu0
    D.hu0S _ r hL W w hqc hconn hsurj k θr
  obtain ⟨a, rfl⟩ := hΓs x
  obtain ⟨u'', hu''⟩ : ∃ u'' : Fin k → ℤ_[ℓ], ∀ i, PadicInt.toZModPow r (u'' i) = a i :=
    ⟨fun i => ((a i).val : ℤ_[ℓ]), fun i => by rw [map_natCast, ZMod.natCast_zmod_val]⟩
  have hu : ∀ i, ‖((u'' i : ℚ_[ℓ]))‖ ≤ 1 := fun i => PadicInt.norm_le_one (u'' i)
  have key := hc (fun i => (u'' i : ℚ_[ℓ])) hu
  obtain ⟨vz, hvz, hΓvz⟩ : ∃ vz : Fin k → ℤ_[ℓ],
      (∀ i, (vz i : ℚ_[ℓ]) = (((ℓ : ℚ_[ℓ]) ^ c) • fun i => (u'' i : ℚ_[ℓ])) i) ∧
      Γ (fun i => PadicInt.toZModPow r (vz i)) = 0 := by
    refine AddSubgroup.closure_induction (p := fun v _ => ∃ vz : Fin k → ℤ_[ℓ],
      (∀ i, (vz i : ℚ_[ℓ]) = v i) ∧ Γ (fun i => PadicInt.toZModPow r (vz i)) = 0)
      ?_ ?_ ?_ ?_ key
    · intro v hv
      obtain ⟨h, ⟨γ, hγ, hfr⟩, u', hu', rfl⟩ := hv
      obtain ⟨hintg, g, hgfr, hgρ⟩ := hθr γ h hfr
      let u'z : Fin k → ℤ_[ℓ] := fun i => ⟨u' i, hu' i⟩
      let wz : Fin k → ℤ_[ℓ] := fun i => ⟨P (h (P.symm u')) i, hintg u' hu' i⟩
      refine ⟨wz - u'z, fun i => ?_, ?_⟩
      · show ((wz i - u'z i : ℤ_[ℓ]) : ℚ_[ℓ]) = P (h (P.symm u')) i - u' i
        rw [PadicInt.coe_sub]
      · have e1 : (fun i => PadicInt.toZModPow r ((wz - u'z) i)) =
            (fun i => PadicInt.toZModPow r (wz i)) - (fun i => PadicInt.toZModPow r (u'z i)) := by
          funext i
          simp only [Pi.sub_apply, map_sub]
        rw [e1, ← hgρ u'z wz (fun i => rfl), map_sub, hΓinv γ g hγ hgfr, sub_self]
    · refine ⟨0, fun i => ?_, ?_⟩
      · show ((0 : ℤ_[ℓ]) : ℚ_[ℓ]) = 0
        exact PadicInt.coe_zero
      · have e0 : (fun i => PadicInt.toZModPow r ((0 : Fin k → ℤ_[ℓ]) i)) = 0 := by
          funext i
          simp
        rw [e0, map_zero]
    · intro x y _ _ hx hy
      obtain ⟨vx, hvx, hΓx⟩ := hx
      obtain ⟨vy, hvy, hΓy⟩ := hy
      refine ⟨vx + vy, fun i => ?_, ?_⟩
      · show ((vx i + vy i : ℤ_[ℓ]) : ℚ_[ℓ]) = x i + y i
        rw [PadicInt.coe_add, hvx i, hvy i]
      · have e2 : (fun i => PadicInt.toZModPow r ((vx + vy) i)) =
            (fun i => PadicInt.toZModPow r (vx i)) + (fun i => PadicInt.toZModPow r (vy i)) := by
          funext i
          simp only [Pi.add_apply, map_add]
        rw [e2, map_add, hΓx, hΓy, add_zero]
    · intro x _ hx
      obtain ⟨vx, hvx, hΓx⟩ := hx
      refine ⟨-vx, fun i => ?_, ?_⟩
      · show ((-(vx i) : ℤ_[ℓ]) : ℚ_[ℓ]) = -(x i)
        rw [PadicInt.coe_neg, hvx i]
      · have e3 : (fun i => PadicInt.toZModPow r ((-vx) i)) =
            -(fun i => PadicInt.toZModPow r (vx i)) := by
          funext i
          simp only [Pi.neg_apply, map_neg]
        rw [e3, map_neg, hΓx, neg_zero]
  have hvz' : ∀ i, vz i = (ℓ : ℤ_[ℓ]) ^ c * u'' i := by
    intro i
    apply PadicInt.ext
    rw [hvz i, PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    rfl
  have hρvz : (fun i => PadicInt.toZModPow r (vz i)) = (ℓ ^ c : ℕ) • a := by
    funext i
    rw [hvz' i, map_mul, map_pow, map_natCast, hu'' i, Pi.smul_apply, nsmul_eq_mul, Nat.cast_pow]
  rw [← map_nsmul, ← hρvz]
  exact hΓvz

theorem wc_qclift_H2_ell_torsionfree (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow)) :
    ∀ (N : ℕ) (y : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2),
      (ℓ ^ N : ℕ) • y = 0 → y = 0 :=
by
  classical
  intro N y hy
  have hm : (ℓ ^ N : ℕ) ≠ 0 := pow_ne_zero N (Fact.out : ℓ.Prime).ne_zero

  have T_nsmul_app : ∀ (S : Scheme.{u}) {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (h : X ⟶ Y) (k : ℕ) (U : (S.ProEt)ᵒᵖ) (x : X.obj.obj U),
      (k • h).hom.app U x = k • h.hom.app U x := by
    intro S X Y h k U x
    induction k with
    | zero => simp
    | succ k ih => rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]

  have T_ladic_iso : ∀ (S : Scheme.{u}) (k : ℕ), k ≠ 0 → IsIso (k • 𝟙 (wcLadicSheaf S ℓ)) := by
    intro S k hk
    have hc : ((k : ℚ_[ℓ])) ≠ 0 := Nat.cast_ne_zero.mpr hk
    have key : k • wcLadicScalar S ℓ ((k : ℚ_[ℓ]))⁻¹ = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [T_nsmul_app]
      apply ULift.ext
      change k • (((k : ℚ_[ℓ]))⁻¹ • (show C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), ℚ_[ℓ]) from ULift.down x)) =
        (show C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ]) from
          ULift.down x)
      rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ], smul_smul, mul_inv_cancel₀ hc, one_smul]
    refine ⟨⟨wcLadicScalar S ℓ ((k : ℚ_[ℓ]))⁻¹, ?_, ?_⟩⟩
    · rw [Preadditive.nsmul_comp, Category.id_comp, key]
    · rw [Preadditive.comp_nsmul, Category.comp_id, key]

  have T_cont_iso : ∀ (S : Scheme.{u}) (r k : ℕ), k ≠ 0 →
      IsIso (k • 𝟙 (wcContSheaf S (Fin r → ℚ_[ℓ]))) := by
    intro S r k hk
    have hc : ((k : ℚ_[ℓ])) ≠ 0 := Nat.cast_ne_zero.mpr hk
    have key : k • wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) ((k : ℚ_[ℓ]))⁻¹)
        (continuous_const_smul _) = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [T_nsmul_app]
      apply ULift.ext
      change k • (AddMonoidHom.compLeftContinuous _
          (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) ((k : ℚ_[ℓ]))⁻¹)
          (continuous_const_smul _) (show C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), Fin r → ℚ_[ℓ]) from ULift.down x)) =
        (show C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), Fin r → ℚ_[ℓ]) from
          ULift.down x)
      ext z i
      simp only [ContinuousMap.coe_nsmul, Pi.smul_apply]
      change (k : ℚ_[ℓ]) • ((k : ℚ_[ℓ])⁻¹ • (_ : ℚ_[ℓ])) = _
      rw [smul_smul, mul_inv_cancel₀ hc, one_smul]
    refine ⟨⟨wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) ((k : ℚ_[ℓ]))⁻¹)
        (continuous_const_smul _), ?_, ?_⟩⟩
    · rw [Preadditive.nsmul_comp, Category.id_comp, key]
    · rw [Preadditive.comp_nsmul, Category.comp_id, key]

  haveI hIR : (injectiveResolutions
      (Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1})).Additive := by
    constructor
    intro X Y f g
    have h := HomotopyCategory.eq_of_homotopy _ _
      (InjectiveResolution.descHomotopy (f + g)
        (InjectiveResolution.desc (f + g) (injectiveResolution Y) (injectiveResolution X))
        (InjectiveResolution.desc f (injectiveResolution Y) (injectiveResolution X) +
          InjectiveResolution.desc g (injectiveResolution Y) (injectiveResolution X))
        (InjectiveResolution.desc_commutes _ _ _)
        (by rw [Preadditive.comp_add, InjectiveResolution.desc_commutes,
          InjectiveResolution.desc_commutes, Functor.map_add, Preadditive.add_comp]))
    rw [Functor.map_add] at h
    exact h
  haveI hRD : ((wcProEtPush D.f).rightDerived q).Additive := by
    unfold Functor.rightDerived Functor.rightDerivedToHomotopyCategory
    infer_instance

  have hR : IsIso ((ℓ ^ N : ℕ) • 𝟙 (wcRq D.f ℓ q)) := by
    haveI := T_ladic_iso D.Yt.left (ℓ ^ N) hm
    have h := Functor.map_isIso ((wcProEtPush D.f).rightDerived q)
      ((ℓ ^ N : ℕ) • 𝟙 (wcLadicSheaf D.Yt.left ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id] at h
    exact h

  have T_mk0_nsmul : ∀ {X Y : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : X ⟶ Y) (k : ℕ), Abelian.Ext.mk₀ (k • f) = k • Abelian.Ext.mk₀ f := by
    intro X Y f k
    induction k with
    | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have T_comp_nsmul : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} {a b c : ℕ} (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c) (k : ℕ), α.comp (k • β) h = k • α.comp β h := by
    intro X Y Z a b c α β h k
    induction k with
    | zero => rw [zero_smul, zero_smul]; exact Abelian.Ext.comp_zero _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have T_nsmul_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} {a b c : ℕ} (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c) (k : ℕ), (k • α).comp β h = k • α.comp β h := by
    intro X Y Z a b c α β h k
    induction k with
    | zero => rw [zero_smul, zero_smul]; exact Abelian.Ext.zero_comp _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have T_smul_eq : ∀ {X F : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {i : ℕ} (z : Abelian.Ext X F i) (k : ℕ),
      z.comp (Abelian.Ext.mk₀ (k • 𝟙 F)) (add_zero i) = k • z := by
    intro X F i z k
    rw [T_mk0_nsmul, T_comp_nsmul, Abelian.Ext.comp_mk₀_id]

  have T_inj : ∀ {X F : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {i : ℕ} (k : ℕ), IsIso (k • 𝟙 F) → ∀ z : Abelian.Ext X F i, k • z = 0 → z = 0 := by
    intro X F i k hI z hz
    have e : z = (z.comp (Abelian.Ext.mk₀ (k • 𝟙 F)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (inv (k • 𝟙 F))) (add_zero i) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [e, T_smul_eq, hz]
    exact Abelian.Ext.zero_comp _ _ _ _ _
  have T_surj : ∀ {X F : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {i : ℕ} (k : ℕ), IsIso (k • 𝟙 F) → ∀ z : Abelian.Ext X F i, ∃ w, k • w = z := by
    intro X F i k hI z
    refine ⟨z.comp (Abelian.Ext.mk₀ (inv (k • 𝟙 F))) (add_zero i), ?_⟩
    rw [← T_smul_eq, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  have h1C : ∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
      (Limits.cokernel M.arrow) 1, (ℓ ^ N : ℕ) • z = 0 → z = 0 := by
    intro z hz
    rcases hM with hGC | hZ
    · obtain ⟨r, ⟨φ⟩⟩ := hGC
      obtain ⟨Θ, -⟩ := wc_ext_free_over_transport (wcP1Over F'').left
        (wcGeomPoint F'' (wcP1Over F'') hP) (wcGeomPoint F'' (wcP1Over F'') hP)
        (𝟙 _) _ _ φ 1
      have h1 : Θ z = 0 := by
        apply T_inj (ℓ ^ N) (T_cont_iso _ r _ hm)
        rw [← map_nsmul, hz, map_zero]
      exact Θ.injective (h1.trans (map_zero Θ).symm)
    · have hid : 𝟙 (Limits.cokernel M.arrow) = 0 := hZ.eq_of_src _ _
      have e1 := Abelian.Ext.comp_mk₀_id z
      rw [hid, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at e1
      exact e1.symm

  have hS : (ShortComplex.mk M.arrow (Limits.cokernel.π M.arrow)
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel M.arrow) inferInstance inferInstance
  have h1 : y.comp (Abelian.Ext.mk₀ M.arrow) (add_zero 2) = 0 := by
    apply T_inj (ℓ ^ N) hR
    rw [← T_nsmul_comp, hy]
    exact Abelian.Ext.zero_comp _ _ _ _ _
  obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y h1 (show 1 + 1 = 2 from rfl)
  have h3 : ((ℓ ^ N : ℕ) • x₃).comp hS.extClass (show 1 + 1 = 2 from rfl) = 0 := by
    rw [T_nsmul_comp, hx₃, hy]
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS ((ℓ ^ N : ℕ) • x₃) _ h3
  obtain ⟨x₂', rfl⟩ := T_surj (ℓ ^ N) hR x₂
  have h4 : x₃ = x₂'.comp (Abelian.Ext.mk₀ (Limits.cokernel.π M.arrow)) (add_zero 1) := by
    symm
    rw [← sub_eq_zero]
    apply h1C
    rw [smul_sub, ← T_nsmul_comp]
    exact sub_eq_zero.mpr hx₂
  rw [← hx₃, h4, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h5 := hS.comp_extClass
  simp only at h5
  rw [h5]
  exact Abelian.Ext.comp_zero _ _ _ _ _

theorem wc_pencil_Rq_sub_H2_gysin_coinv_qc_lift (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (hpunct : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctGeom F'' D.u0 hP))
      (Subobject.underlying.obj M) 2, x = 0)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
    (θ : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (V₀ : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (ι : V₀ ⟶ W) :
    ∃ Γ : (Fin k → ℚ_[ℓ]) →+ wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2,
      Function.Surjective Γ ∧
      ∀ (γ : W ⟶ W) (g : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])), γ ≫ w = w →
        (∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ v, Γ (g v) = Γ v :=
by
  classical

  have hΓ₀ : ∃ Γ₀ : (Fin k → ℚ_[ℓ]) →+ wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2,
      Function.Surjective Γ₀ := by
    haveI hZ0 : ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        V₀).PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint _
    haveI hA0 : ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        V₀).Additive := Functor.additive_of_preserves_binary_products _
    have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (φ : A →+ B) (hφ : Continuous φ) (U : ((wcP1Over F'').left.ProEt)ᵒᵖ)
        (x : ((wcContSheaf (wcP1Over F'').left A).obj.obj U : Type (u+1))),
        (wcContSheafMap (wcP1Over F'').left φ hφ).hom.app U x =
          (ULift.up (AddMonoidHom.compLeftContinuous
            (↥((Scheme.ProEt.forget (wcP1Over F'').left ⋙ Over.forget (wcP1Over F'').left).obj
              (Opposite.unop U))) φ hφ
            (ULift.down x : C(↥((Scheme.ProEt.forget (wcP1Over F'').left ⋙
              Over.forget (wcP1Over F'').left).obj (Opposite.unop U)), A))) : _) := by
      intro A B _ _ _ _ _ _ φ hφ U x
      rfl
    have haddG : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (φ ψ χ : A →+ B) (hφ : Continuous φ) (hψ : Continuous ψ) (hχ : Continuous χ),
        (∀ a, χ a = φ a + ψ a) →
        wcContSheafMap (wcP1Over F'').left χ hχ =
          wcContSheafMap (wcP1Over F'').left φ hφ + wcContSheafMap (wcP1Over F'').left ψ hψ := by
      intro A B _ _ _ _ _ _ φ ψ χ hφ hψ hχ hsum
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
      apply ULift.ext
      apply ContinuousMap.ext
      intro a
      exact hsum _
    have hadd : ∀ v v' : Fin k → ℚ_[ℓ],
        wcContSheafMap (wcP1Over F'').left
            (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) (v + v')).toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional _) =
          wcContSheafMap (wcP1Over F'').left
            (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) v).toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional _) +
          wcContSheafMap (wcP1Over F'').left
            (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) v').toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional _) := by
      intro v v'
      exact haddG _ _ _ _ _ _ (fun a => smul_add a v v')
    obtain ⟨θι, hθιh, hθιi⟩ : ∃ θι : (Subobject.underlying.obj M).over V₀ ≅
        (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over V₀,
        θι.hom = wcOverRestrict (wcP1Over F'').left ι θ.hom ∧
        θι.inv = wcOverRestrict (wcP1Over F'').left ι θ.inv :=
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1} ι).mapIso θ,
        rfl, rfl⟩
    refine ⟨AddMonoidHom.mk' (fun v => wcPunctGys F'' D.u0 hP V₀ (ι ≫ w)
        (Subobject.underlying.obj M)
        (wcPunctFrameCls F'' D.u0 V₀ ℓ (Subobject.underlying.obj M)
          (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
            (wcContSheafMap (wcP1Over F'').left
              (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) v).toAddMonoidHom
              (LinearMap.continuous_of_finiteDimensional _)) ≫ θι.inv))) ?_, ?_⟩
    · intro v v'
      beta_reduce
      rw [hadd, Functor.map_add, Preadditive.add_comp, map_add, map_add]
    · intro y
      obtain ⟨x, hx⟩ := wc_punct_gys_surj F'' D.u0 D.hu0 hP (Subobject.underlying.obj M) hpunct V₀
        (ι ≫ w) A e ε hv hε y
      have hpk := wc_punct_frame_pkg_exists F'' D.u0 D.hu0 ℓ hℓ V₀ A e ε hv hε
      have hFrEq : ∀ G₀ : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1},
          wcPunctFrameCls F'' D.u0 V₀ ℓ G₀ = Classical.choose hpk G₀ := by
        intro G₀
        unfold wcPunctFrameCls
        rw [dif_pos hpk]
      obtain ⟨v, hv'⟩ := (Classical.choose_spec hpk).2 (Subobject.underlying.obj M) k θι x
      refine ⟨v, ?_⟩
      simp only [AddMonoidHom.mk'_apply]
      rw [hFrEq, hv', hx]
  obtain ⟨Γ₀, hΓ₀s⟩ := hΓ₀

  set T : Set ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) :=
    {h | ∃ γ : W ⟶ W, γ ≫ w = w ∧
      ∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        h ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)} with hTdef
  set N : Submodule ℚ_[ℓ] (Fin k → ℚ_[ℓ]) :=
    Submodule.span ℚ_[ℓ] (⋃ h ∈ T, Set.range ⇑((h - LinearMap.id :
      (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])))) with hNdef
  have hdeckN : ∀ (γ : W ⟶ W) (g : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])), γ ≫ w = w →
      (∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        g ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
      ∀ v, g v - v ∈ N := by
    intro γ g hγ hFR v
    apply Submodule.subset_span
    refine Set.mem_iUnion₂.mpr ⟨g, ⟨γ, hγ, hFR⟩, v, ?_⟩
    rw [LinearMap.sub_apply, LinearMap.id_apply]
  by_cases hN : N = ⊤
  ·
    have nsmul_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
        AddCommGrpCat.{u+1}} {a b c : ℕ} (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
        (h : a + b = c) (m : ℕ), (m • α).comp β h = m • α.comp β h := by
      intro X Y Z a b c α β h m
      induction m with
      | zero => rw [zero_smul, zero_smul]; exact Abelian.Ext.zero_comp _ _ _ _ _
      | succ m ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
    obtain ⟨P, hint⟩ := wc_qclift_transition_lattice F'' hP D.m D.S ℓ
      (Subobject.underlying.obj M) W w hqc hconn hsurj k θ
    obtain ⟨J, hJ⟩ := wc_qclift_integral_subsheaf (wcP1Over F'').left
      (Subobject.underlying.obj M) W k ℓ θ P

    have hc : ∃ c : ℕ, ∀ u : Fin k → ℚ_[ℓ], (∀ i, ‖u i‖ ≤ 1) →
      ((ℓ : ℚ_[ℓ]) ^ c) • u ∈ AddSubgroup.closure
        {v | ∃ h ∈ {h : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]) | ∃ γ : W ⟶ W, γ ≫ w = w ∧
            ∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
              (show C(↥W.left, Fin k → ℚ_[ℓ]) from
                ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
              h ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
                ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)},
          ∃ u' : Fin k → ℚ_[ℓ], (∀ i, ‖u' i‖ ≤ 1) ∧ v = P (h (P.symm u')) - u'} := by
      have hspan := hN
      set A := AddSubgroup.closure
        {v | ∃ h ∈ T, ∃ u' : Fin k → ℚ_[ℓ], (∀ i, ‖u' i‖ ≤ 1) ∧ v = P (h (P.symm u')) - u'}
        with hA
      have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
      have hℓpos : (0 : ℝ) < ℓ := by linarith
      have hnl : ‖(ℓ : ℚ_[ℓ])‖ = (ℓ : ℝ)⁻¹ := Padic.norm_p
      have hB : ∀ a : ℚ_[ℓ], ‖a‖ ≤ 1 → ∀ v ∈ A, a • v ∈ A := by
        intro a ha v hv
        induction hv using AddSubgroup.closure_induction with
        | mem x hx =>
          obtain ⟨h, hh, u', hu', rfl⟩ := hx
          apply AddSubgroup.subset_closure
          refine ⟨h, hh, a • u', fun i => ?_, ?_⟩
          · rw [Pi.smul_apply, smul_eq_mul, norm_mul]
            exact mul_le_one₀ ha (norm_nonneg _) (hu' i)
          · rw [smul_sub, LinearEquiv.map_smul, LinearMap.map_smul, LinearEquiv.map_smul]
        | zero => rw [smul_zero]; exact A.zero_mem
        | add x y _ _ hx hy => rw [smul_add]; exact A.add_mem hx hy
        | neg x _ hx => rw [smul_neg]; exact A.neg_mem hx
      have hpowle : ∀ m : ℕ, ‖(ℓ : ℚ_[ℓ]) ^ m‖ ≤ 1 := by
        intro m
        rw [norm_pow, hnl]
        exact pow_le_one₀ (inv_nonneg.mpr hℓpos.le) (inv_le_one_of_one_le₀ hℓ1.le)
      have hCs : ∀ a : ℚ_[ℓ], ∃ m : ℕ, ‖(ℓ : ℚ_[ℓ]) ^ m * a‖ ≤ 1 := by
        intro a
        obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt ‖a‖ hℓ1
        refine ⟨m, ?_⟩
        rw [norm_mul, norm_pow, hnl, inv_pow, inv_mul_le_iff₀ (pow_pos hℓpos m), mul_one]
        exact hm.le
      have hCv : ∀ v : Fin k → ℚ_[ℓ], ∃ m : ℕ, ∀ i, ‖((ℓ : ℚ_[ℓ]) ^ m • v) i‖ ≤ 1 := by
        intro v
        obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt ‖v‖ hℓ1
        refine ⟨m, fun i => ?_⟩
        rw [Pi.smul_apply, smul_eq_mul, norm_mul, norm_pow, hnl, inv_pow,
          inv_mul_le_iff₀ (pow_pos hℓpos m), mul_one]
        exact (norm_le_pi_norm v i).trans hm.le
      have hD : ∀ x ∈ N, ∃ m : ℕ, ((ℓ : ℚ_[ℓ]) ^ m) • P x ∈ A := by
        intro x hx
        induction hx using Submodule.span_induction with
        | mem x hx =>
          simp only [Set.mem_iUnion, Set.mem_range] at hx
          obtain ⟨h, hh, y, rfl⟩ := hx
          obtain ⟨m, hm⟩ := hCv (P y)
          refine ⟨m, AddSubgroup.subset_closure ⟨h, hh, _, hm, ?_⟩⟩
          rw [LinearMap.sub_apply, LinearMap.id_apply, map_sub, smul_sub, LinearEquiv.map_smul,
            LinearEquiv.symm_apply_apply, LinearMap.map_smul, LinearEquiv.map_smul]
        | zero => exact ⟨0, by rw [map_zero, smul_zero]; exact A.zero_mem⟩
        | add x y _ _ hx hy =>
          obtain ⟨m₁, h₁⟩ := hx
          obtain ⟨m₂, h₂⟩ := hy
          refine ⟨m₁ + m₂, ?_⟩
          have e : ((ℓ : ℚ_[ℓ]) ^ (m₁ + m₂)) • P (x + y) =
              ((ℓ : ℚ_[ℓ]) ^ m₂) • (((ℓ : ℚ_[ℓ]) ^ m₁) • P x) +
                ((ℓ : ℚ_[ℓ]) ^ m₁) • (((ℓ : ℚ_[ℓ]) ^ m₂) • P y) := by
            rw [map_add, smul_add, smul_smul, smul_smul, ← pow_add, ← pow_add, add_comm m₂ m₁]
          rw [e]
          exact A.add_mem (hB _ (hpowle _) _ h₁) (hB _ (hpowle _) _ h₂)
        | smul a x _ hx =>
          obtain ⟨m, hm⟩ := hx
          obtain ⟨m', hm'⟩ := hCs a
          refine ⟨m + m', ?_⟩
          have e : ((ℓ : ℚ_[ℓ]) ^ (m + m')) • P (a • x) =
              ((ℓ : ℚ_[ℓ]) ^ m' * a) • (((ℓ : ℚ_[ℓ]) ^ m) • P x) := by
            rw [LinearEquiv.map_smul, smul_smul, smul_smul, pow_add]
            ring_nf
          rw [e]
          exact hB _ hm' _ hm
      have hm : ∀ i : Fin k, ∃ m : ℕ,
          ((ℓ : ℚ_[ℓ]) ^ m) • (Pi.single i 1 : Fin k → ℚ_[ℓ]) ∈ A := by
        intro i
        obtain ⟨m, hm⟩ := hD (P.symm (Pi.single i 1)) (hspan ▸ Submodule.mem_top)
        rw [LinearEquiv.apply_symm_apply] at hm
        exact ⟨m, hm⟩
      choose m hm using hm
      refine ⟨∑ i, m i, fun u hu => ?_⟩
      have hu' : u = ∑ i, u i • (Pi.single i 1 : Fin k → ℚ_[ℓ]) := by
        ext j
        simp [Finset.sum_apply, Pi.single_apply]
      show ((ℓ : ℚ_[ℓ]) ^ (∑ i, m i)) • u ∈ A
      rw [hu', Finset.smul_sum]
      refine A.sum_mem fun i _ => ?_
      have hle : m i ≤ ∑ j, m j :=
        Finset.single_le_sum (fun j _ => Nat.zero_le (m j)) (Finset.mem_univ i)
      have e : ((ℓ : ℚ_[ℓ]) ^ (∑ j, m j)) • (u i • (Pi.single i 1 : Fin k → ℚ_[ℓ])) =
          (u i * (ℓ : ℚ_[ℓ]) ^ (∑ j, m j - m i)) •
            (((ℓ : ℚ_[ℓ]) ^ m i) • (Pi.single i 1 : Fin k → ℚ_[ℓ])) := by
        rw [smul_smul, smul_smul, mul_assoc, ← pow_add, Nat.sub_add_cancel hle, mul_comm]
      rw [e]
      refine hB _ ?_ _ (hm i)
      rw [norm_mul]
      exact mul_le_one₀ (hu i) (norm_nonneg _) (hpowle _)
    obtain ⟨c, hc⟩ := hc
    have hzero : ∀ y : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2, y = 0 := by
      intro y
      obtain ⟨N₁, y₀, hy₀⟩ := wc_qclift_ext_rationalize F' F'' Y n hn2 D ℓ hℓ hP q M hM W w k θ
        hqc hconn hsurj P hint J hJ y
      have hz : (ℓ ^ c : ℕ) • y₀ = 0 := by
        apply wc_qclift_H2_tower_limit F' F'' Y n hn2 D ℓ hℓ hP q M hM W w k θ hqc hconn hsurj
          P hint J hJ
        intro r
        rw [nsmul_comp]
        exact wc_qclift_finite_level_H2_killed F' F'' Y n hn2 D ℓ hℓ hP q M hM W w k θ hqc hconn
          hsurj P hint J hJ c hc r _
      apply wc_qclift_H2_ell_torsionfree F' F'' Y n hn2 D ℓ hℓ hP q M hM (c + N₁) y
      rw [pow_add, mul_smul, hy₀, ← nsmul_comp, hz]
      exact Abelian.Ext.zero_comp _ _ _ _ _
    refine ⟨0, fun y => ⟨0, by rw [hzero y]; rfl⟩, fun _ _ _ _ _ => rfl⟩
  ·
    obtain ⟨f, hfs, hfN⟩ : ∃ f : (Fin k → ℚ_[ℓ]) →+ (Fin k → ℚ_[ℓ]),
        Function.Surjective f ∧ ∀ x ∈ N, f x = 0 := by
      obtain ⟨x, hx⟩ : ∃ x, x ∉ N := by
        by_contra h
        push_neg at h
        exact hN (eq_top_iff.mpr fun y _ => h y)
      have hk : 1 ≤ k := by
        rcases Nat.eq_zero_or_pos k with h | h
        · subst h
          exact absurd ((Subsingleton.elim x 0) ▸ N.zero_mem) hx
        · exact h
      have hc : Cardinal.continuum ≤ Cardinal.mk ℚ_[ℓ] :=
        continuum_le_cardinal_of_nontriviallyNormedField ℚ_[ℓ]
      have hinf : Cardinal.aleph0 ≤ Cardinal.mk ℚ_[ℓ] := Cardinal.aleph0_le_continuum.trans hc
      have hV : Cardinal.mk (Fin k → ℚ_[ℓ]) = Cardinal.mk ℚ_[ℓ] := by
        rw [← Cardinal.power_def, Cardinal.mk_fin, Cardinal.power_natCast,
          Cardinal.power_nat_eq hinf hk]
      have hQle : Cardinal.mk ((Fin k → ℚ_[ℓ]) ⧸ N) ≤ Cardinal.mk (Fin k → ℚ_[ℓ]) :=
        Cardinal.mk_le_of_surjective (Submodule.Quotient.mk_surjective N)
      have hQge : Cardinal.mk ℚ_[ℓ] ≤ Cardinal.mk ((Fin k → ℚ_[ℓ]) ⧸ N) := by
        refine Cardinal.mk_le_of_injective
          (f := fun a : ℚ_[ℓ] => (Submodule.Quotient.mk (a • x) : (Fin k → ℚ_[ℓ]) ⧸ N)) ?_
        intro a b hab
        by_contra hne
        apply hx
        have h1 : (a - b) • x ∈ N := by
          rw [sub_smul]
          exact (Submodule.Quotient.eq N).mp hab
        have h2 := N.smul_mem (a - b)⁻¹ h1
        rwa [smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hne), one_smul] at h2
      have hQ : Cardinal.mk ((Fin k → ℚ_[ℓ]) ⧸ N) = Cardinal.mk (Fin k → ℚ_[ℓ]) :=
        le_antisymm hQle (hV ▸ hQge)
      have hlt : Cardinal.mk ℚ < Cardinal.mk ℚ_[ℓ] := by
        rw [Cardinal.mkRat]
        exact Cardinal.aleph0_lt_continuum.trans_le hc
      have hrQ : Module.rank ℚ ((Fin k → ℚ_[ℓ]) ⧸ N) = Cardinal.mk ((Fin k → ℚ_[ℓ]) ⧸ N) := by
        apply Module.Free.rank_eq_mk_of_infinite_lt
        simp only [Cardinal.lift_id]
        exact hlt.trans_le hQge
      have hrV : Module.rank ℚ (Fin k → ℚ_[ℓ]) = Cardinal.mk (Fin k → ℚ_[ℓ]) := by
        apply Module.Free.rank_eq_mk_of_infinite_lt
        simp only [Cardinal.lift_id]
        rw [hV]
        exact hlt
      obtain ⟨e⟩ := Module.nonempty_linearEquiv_iff_rank_eq.mpr (hrQ.trans (hQ.trans hrV.symm))
      refine ⟨e.toLinearMap.toAddMonoidHom.comp (N.mkQ).toAddMonoidHom, ?_, ?_⟩
      · intro y
        obtain ⟨z, rfl⟩ := e.surjective y
        obtain ⟨t, rfl⟩ := Submodule.Quotient.mk_surjective N z
        exact ⟨t, rfl⟩
      · intro y hy
        show e (N.mkQ y) = 0
        rw [Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).mpr hy, map_zero]
    refine ⟨Γ₀.comp f, hΓ₀s.comp hfs, ?_⟩
    intro γ g hγ hFR v
    have h0 : f (g v - v) = 0 := hfN _ (hdeckN γ g hγ hFR v)
    rw [map_sub, sub_eq_zero] at h0
    simp only [AddMonoidHom.comp_apply, h0]

theorem wc_pencil_Rq_sub_H2_coinvariant_bound (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
    (θ : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p) :
    ∃ Γ : (Fin k → ℚ_[ℓ]) →+ wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2,
      Function.Surjective Γ ∧
      ∀ (γ : W ⟶ W) (g : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])), γ ≫ w = w →
        (∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ v, Γ (g v) = Γ v :=
by
  classical

  have hpunct : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctGeom F'' D.u0 hP))
      (Subobject.underlying.obj M) 2, x = 0 := by
    intro x
    have hS₀ : (ShortComplex.mk M.arrow (Limits.cokernel.π M.arrow)
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel M.arrow) inferInstance inferInstance
    have h0 : x.comp (Abelian.Ext.mk₀ M.arrow) (add_zero 2) = 0 :=
      wc_pencil_punct_ext2_vanish F' F'' Y n hn2 D ℓ hℓ hP q _
    obtain ⟨x₃, hx₃⟩ : ∃ x₃ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcPunctGeom F'' D.u0 hP)) (Limits.cokernel M.arrow) 1,
        x₃.comp hS₀.extClass (show 1 + 1 = 2 from rfl) = x :=
      Abelian.Ext.covariant_sequence_exact₁ _ hS₀ x h0 (show 1 + 1 = 2 from rfl)
    have hx₃0 : x₃ = 0 := by
      rcases hM with hGC | hZ
      · obtain ⟨r, ⟨φ⟩⟩ := hGC
        obtain ⟨Θ, -⟩ := wc_ext_free_over_transport (wcP1Over F'').left
          (wcGeomPoint F'' (wcP1Over F'') hP) (wcPunctGeom F'' D.u0 hP)
          (wcPunctIncl F'' D.u0 hP) _ _ φ 1
        obtain ⟨Pr, -⟩ := wc_ext_contSheaf_pi_split (wcP1Over F'').left
          (wcPunctGeom F'' D.u0 hP) ℓ r 1
        have h1 : Pr (Θ x₃) = 0 := by
          funext j
          exact wc_punct_ladic_ext1_vanish F'' D.u0 D.hu0 hP ℓ hℓ _
        have h2 : Θ x₃ = 0 := Pr.injective (h1.trans (map_zero Pr).symm)
        exact Θ.injective (h2.trans (map_zero Θ).symm)
      · have hid : 𝟙 (Limits.cokernel M.arrow) = 0 := hZ.eq_of_src _ _
        have e1 := Abelian.Ext.comp_mk₀_id x₃
        rw [hid, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at e1
        exact e1.symm
    rw [← hx₃, hx₃0, Abelian.Ext.zero_comp]

  obtain ⟨V₀, A, iA, iH, iS, e, ε, ι, hv, hε⟩ :=
    wc_P1bar_strict_lift_to_cover F'' hP D.m D.S D.u0 D.hu0 D.hu0S W w hsurj

  exact wc_pencil_Rq_sub_H2_gysin_coinv_qc_lift F' F'' Y n hn2 D ℓ hℓ hP q M hM hpunct W w k θ
    hqc hconn hsurj V₀ A e ε hv hε ι

theorem wc_pencil_R2_geom_trace (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ tr : (wcRq D.f ℓ (2 * (n - 1))).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left (Fin 1 → ℚ_[ℓ])).over (wcGeomPoint F'' (wcP1Over F'') hP),
      ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
