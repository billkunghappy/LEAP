  have hiff : ∀ (U : X.Opens) (T : Scheme.{u}) (h : T ⟶ U.toScheme),
      wcCsdInvPull (I.comap U.ι) h ↔ wcCsdInvPull I (h ≫ U.ι) := by
    intro U T h
    constructor
    · intro H t
      obtain ⟨U0, V, e, a0, ht, ha0, hnzd, hspan⟩ := H t
      have hW : IsAffineOpen (U.ι ''ᵁ U0.1) := U0.2.image_of_isOpenImmersion U.ι
      have e' : V.1 ≤ (h ≫ U.ι) ⁻¹ᵁ (U.ι ''ᵁ U0.1) := by
        have h1 : U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1) = U0.1 := U.ι.preimage_image_eq U0.1
        show V.1 ≤ h ⁻¹ᵁ (U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1))
        rw [h1]; exact e
      have hF : (h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e' =
          (U.ι.appIso U0.1).hom ≫ h.appLE U0.1 V.1 e := by
        rw [Scheme.Hom.appIso_hom', Scheme.Hom.appLE_comp_appLE]
      have hcomp : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom =
          (h.appLE U0.1 V.1 e).hom.comp (U.ι.appIso U0.1).hom.hom := by
        rw [hF, CommRingCat.hom_comp]
      have hG : (I.comap U.ι).ideal U0 =
          Ideal.comap (U.ι.appIso U0.1).inv.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW⟩) :=
        I.ideal_comap_of_isOpenImmersion U.ι U0
      have hstar : Ideal.map (U.ι.appIso U0.1).hom.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW⟩) =
          (I.comap U.ι).ideal U0 := by
        rw [hG]; exact isoIdeal _ _
      have hval : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom ((U.ι.appIso U0.1).inv.hom a0) =
          (h.appLE U0.1 V.1 e).hom a0 := by
        rw [hcomp, RingHom.comp_apply, inv_hom_apply]
      refine ⟨⟨U.ι ''ᵁ U0.1, hW⟩, V, e', (U.ι.appIso U0.1).inv.hom a0, ht, ?_, ?_, ?_⟩
      · rw [hG] at ha0; exact ha0
      · show ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom ((U.ι.appIso U0.1).inv.hom a0) ∈
          nonZeroDivisors Γ(T, V.1)
        rw [hval]; exact hnzd
      · show Ideal.map ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom
            (I.ideal ⟨U.ι ''ᵁ U0.1, hW⟩) =
          Ideal.span {((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e').hom ((U.ι.appIso U0.1).inv.hom a0)}
        rw [hval, ← hspan, hcomp, ← Ideal.map_map, hstar]
    · intro H t
      have hmem : (h ≫ U.ι) t ∈ U.ι.opensRange := by
        rw [Scheme.Hom.comp_apply, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact Set.mem_range_self (h t)
      obtain ⟨⟨W1, hW1⟩, V, e, b, hWO, ht, hb, hnzd, hgen⟩ :=
        s2 T (h ≫ U.ι) U.ι.opensRange H t hmem
      have hWO' : W1 ≤ U.ι.opensRange := hWO
      obtain ⟨U0, rfl⟩ : ∃ U0 : U.toScheme.affineOpens, W1 = U.ι ''ᵁ U0.1 :=
        ⟨⟨U.ι ⁻¹ᵁ W1, IsAffineOpen.preimage_of_isOpenImmersion hW1 U.ι hWO'⟩, by
          show W1 = U.ι ''ᵁ (U.ι ⁻¹ᵁ W1)
          rw [Scheme.Hom.image_preimage_eq_opensRange_inf, inf_eq_right.mpr hWO']⟩
      have e1 : V.1 ≤ (h ≫ U.ι) ⁻¹ᵁ (U.ι ''ᵁ U0.1) := e
      have hb' : b ∈ I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩ := hb
      have hnzd' : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom b ∈ nonZeroDivisors Γ(T, V.1) :=
        hnzd
      have hgen' : Ideal.map ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom
          (I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩) =
          Ideal.span {((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom b} := hgen
      have e'' : V.1 ≤ h ⁻¹ᵁ U0.1 := by
        have h1 : U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1) = U0.1 := U.ι.preimage_image_eq U0.1
        have e2 : V.1 ≤ h ⁻¹ᵁ (U.ι ⁻¹ᵁ (U.ι ''ᵁ U0.1)) := e1
        rw [h1] at e2; exact e2
      have hF : (h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1 =
          (U.ι.appIso U0.1).hom ≫ h.appLE U0.1 V.1 e'' := by
        rw [Scheme.Hom.appIso_hom', Scheme.Hom.appLE_comp_appLE]
      have hcomp : ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom =
          (h.appLE U0.1 V.1 e'').hom.comp (U.ι.appIso U0.1).hom.hom := by
        rw [hF, CommRingCat.hom_comp]
      have hG : (I.comap U.ι).ideal U0 =
          Ideal.comap (U.ι.appIso U0.1).inv.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩) :=
        I.ideal_comap_of_isOpenImmersion U.ι U0
      have hstar : Ideal.map (U.ι.appIso U0.1).hom.hom (I.ideal ⟨U.ι ''ᵁ U0.1, hW1⟩) =
          (I.comap U.ι).ideal U0 := by
        rw [hG]; exact isoIdeal _ _
      have hval : (h.appLE U0.1 V.1 e'').hom ((U.ι.appIso U0.1).hom.hom b) =
          ((h ≫ U.ι).appLE (U.ι ''ᵁ U0.1) V.1 e1).hom b := by
        rw [hcomp, RingHom.comp_apply]
      refine ⟨U0, V, e'', (U.ι.appIso U0.1).hom.hom b, ht, ?_, ?_, ?_⟩
      · rw [hG, Ideal.mem_comap, hom_inv_apply]
        exact hb'
      · rw [hval]; exact hnzd'
      · rw [hval, ← hgen', ← hstar, Ideal.map_map, ← hcomp]

  haveI : IsAffine U.1.toScheme := U.2
  have hT : IsAffineOpen (⊤ : U.1.toScheme.Opens) := isAffineOpen_top _

  have e0 : (⊤ : U.1.toScheme.Opens) ≤ U.1.ι ⁻¹ᵁ U.1 := (Scheme.Opens.ι_preimage_self U.1).ge
  have hgen : (I.comap U.1.ι).ideal ⟨⊤, hT⟩ = Ideal.span (Set.range (wcBeqGU U g)) := by
    rw [wc_csd_comap_ideal_affine U.1.toScheme X I U.1.ι U ⟨⊤, hT⟩ e0, hI, Ideal.map_span,
      ← Set.range_comp]
    rfl

  obtain ⟨P, ι, hι, P1, P2, P3⟩ := wc_csd_blowup_model_charts K U.1.toScheme (U.1.ι ≫ fX)
    (I.comap U.1.ι) 0 m (fun _ => ⊤) (fun _ => hT) (fun _ => wcBeqGU U g) (fun _ _ => 1)
    iSup_const (fun _ => hgen) (fun _ _ => isUnit_one) (fun _ _ _ => (one_mul _).symm)

  have hbl := s5 U.1.toScheme (U.1.ι ≫ fX) (I.comap U.1.ι) 0 m (fun _ => ⊤) (fun _ => hT)
    (fun _ => wcBeqGU U g) (fun _ _ => 1) iSup_const (fun _ => hgen) (fun _ _ => isUnit_one)
    (fun _ _ _ => (one_mul _).symm) P ι hι P1 P2 P3

  obtain ⟨κ', hκ', hcomm, hrange⟩ := wc_csd_blowup_open_restrict X U.1.toScheme Yb P U.1.ι
    (I.comap U.1.ι) I r (ι ≫ Limits.pullback.fst (U.1.ι ≫ fX) (wcProjKStr K m)) (hiff U.1) hr hbl
  refine ⟨P, ι, κ', hι, hκ', ?_, ?_, hbl, hgen, ⟨fun k => P1 0 k, fun k l => P2 0 k l⟩⟩
  · rw [hcomm, Category.assoc]
  · intro y
    rw [hrange, Scheme.Opens.range_ι]
    all_goals exact Iff.rfl

theorem wc_beq_chart_strict_transform : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (m : ℕ) (t : Fin (m + 1) → R) (h : R) (M : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (k : Fin (m + 1)), IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) → h - ∑ p, ∑ c, M p c * t p * t c ∈ IsLocalRing.maximalIdeal R ^ 3 → ∃ gs : MvPolynomial (Fin (m + 1)) R, MvPolynomial.C h - MvPolynomial.C (t k) ^ 2 * gs ∈ wcOdpJ0 t k ∧ gs - ∑ p, ∑ c, MvPolynomial.C (M p c) * MvPolynomial.X p * MvPolynomial.X c ∈ wcOdpJ0 t k ⊔ Ideal.span {MvPolynomial.C (t k)} :=
by
  intro R _ _ m t h M k ht hA
  classical
  let v : Fin (m + 1) × Fin (m + 1) × Fin (m + 1) → R := fun x => t x.1 * t x.2.1 * t x.2.2
  have hcube : Ideal.span (Set.range t) ^ 3 ≤ Ideal.span (Set.range v) := by
    rw [pow_three', Ideal.span_mul_span, Ideal.span_mul_span]
    apply Ideal.span_mono
    intro z hz
    obtain ⟨y, hy, c, hc, rfl⟩ := Set.mem_mul.mp hz
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hy
    obtain ⟨p, rfl⟩ := ha
    obtain ⟨q, rfl⟩ := hb
    obtain ⟨r, rfl⟩ := hc
    exact ⟨(p, q, r), rfl⟩
  rw [ht] at hA
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp (hcube hA)
  have hc' : (∑ x, c x * (t x.1 * t x.2.1 * t x.2.2)) = h - ∑ p, ∑ q, M p q * t p * t q := hc
  have hh : h = ∑ p, ∑ q, M p q * t p * t q + ∑ x, c x * (t x.1 * t x.2.1 * t x.2.2) := by
    rw [hc']; ring
  refine ⟨∑ p, ∑ q, MvPolynomial.C (M p q) * MvPolynomial.X p * MvPolynomial.X q +
    MvPolynomial.C (t k) * ∑ x : Fin (m + 1) × Fin (m + 1) × Fin (m + 1),
      MvPolynomial.C (c x) * MvPolynomial.X x.1 * MvPolynomial.X x.2.1 * MvPolynomial.X x.2.2,
    ?_, ?_⟩
  · rw [hh, ← Ideal.Quotient.eq_zero_iff_mem]
    simp only [map_sub, map_add, map_mul, map_pow, map_sum]
    generalize hu : (Ideal.Quotient.mk (wcOdpJ0 t k)) (MvPolynomial.C (t k)) = u
    have hgen : ∀ b, (Ideal.Quotient.mk (wcOdpJ0 t k)) (MvPolynomial.C (t b)) =
        u * (Ideal.Quotient.mk (wcOdpJ0 t k)) (MvPolynomial.X b) := by
      intro b
      rw [← hu, ← map_mul, eq_comm, Ideal.Quotient.eq]
      unfold wcOdpJ0
      exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)
    simp only [hgen]
    rw [sub_eq_zero, mul_add]
    congr 1
    · simp only [Finset.mul_sum]
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      ring
    · simp only [Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      ring
  · rw [add_sub_cancel_left]
    exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))

theorem wc_beq_chart_fibre_prime : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (m : ℕ) (t : Fin (m + 1) → R) (M : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (χ : K →+* R) (a : Fin (m + 1) → Fin (m + 1) → K) (k : Fin (m + 1)) (gs : MvPolynomial (Fin (m + 1)) R), IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) → gs - ∑ p, ∑ c, MvPolynomial.C (M p c) * MvPolynomial.X p * MvPolynomial.X c ∈ wcOdpJ0 t k ⊔ Ideal.span {MvPolynomial.C (t k)} → (∀ p c, M p c - χ (a p c) ∈ IsLocalRing.maximalIdeal R) → (∀ y : R, ∃ c : K, y - χ c ∈ IsLocalRing.maximalIdeal R) → ∀ 𝔔 : Ideal (MvPolynomial (Fin (m + 1)) K), 𝔔.IsPrime → MvPolynomial.X k - 1 ∈ 𝔔 → (∑ p, ∑ q, MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q)) ∈ 𝔔 → ∃ β : Ideal (wcOdpB t k gs), β.IsPrime ∧ algebraMap R (wcOdpB t k gs) (t k) ∈ β ∧ Ideal.comap ((Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs})).comp (MvPolynomial.map χ)) β = 𝔔 :=
by
  intro K _ R _ _ m t M χ a k gs ht hG2 hMa hres 𝔔 h𝔔 hXk hG
  classical

  let res : R →+* IsLocalRing.ResidueField R := IsLocalRing.residue R
  have hinj : Function.Injective (res.comp χ) := (res.comp χ).injective
  have hsurj : Function.Surjective (res.comp χ) := by
    intro z
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
    obtain ⟨c, hc⟩ := hres y
    refine ⟨c, ?_⟩
    rw [RingHom.comp_apply, eq_comm, ← sub_eq_zero, ← map_sub]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr hc
  let e : K ≃+* IsLocalRing.ResidueField R := RingEquiv.ofBijective (res.comp χ) ⟨hinj, hsurj⟩
  let ω : R →+* K := (e.symm : IsLocalRing.ResidueField R →+* K).comp res
  have hωχ : ∀ c, ω (χ c) = c := by
    intro c
    show e.symm (res (χ c)) = c
    have h1 : res (χ c) = e c := rfl
    rw [h1, RingEquiv.symm_apply_apply]
  have hω𝔪 : ∀ r ∈ IsLocalRing.maximalIdeal R, ω r = 0 := by
    intro r hr
    show e.symm (res r) = 0
    have h1 : res r = 0 := (IsLocalRing.residue_eq_zero_iff r).mpr hr
    rw [h1, map_zero]
  have hωt : ∀ b, ω (t b) = 0 := fun b =>
    hω𝔪 _ (by rw [ht]; exact Ideal.subset_span ⟨b, rfl⟩)
  have hωM : ∀ p c, ω (M p c) = a p c := by
    intro p c
    have h := hω𝔪 _ (hMa p c)
    rw [map_sub, hωχ, sub_eq_zero] at h
    exact h

  let Λ : MvPolynomial (Fin (m + 1)) R →+* MvPolynomial (Fin (m + 1)) K ⧸ 𝔔 :=
    (Ideal.Quotient.mk 𝔔).comp (MvPolynomial.map ω)
  have hΛ : ∀ x, Λ x = Ideal.Quotient.mk 𝔔 (MvPolynomial.map ω x) := fun x => rfl
  have hΛCt : Λ (MvPolynomial.C (t k)) = 0 := by
    rw [hΛ, MvPolynomial.map_C, hωt, MvPolynomial.C_0, map_zero]
  have hJ0 : wcOdpJ0 t k ≤ RingHom.ker Λ := by
    unfold wcOdpJ0
    rw [Ideal.span_le]
    intro g hg
    rcases Set.mem_insert_iff.mp hg with h | ⟨b, rfl⟩
    · rw [h, SetLike.mem_coe, RingHom.mem_ker, hΛ, map_sub, MvPolynomial.map_X, map_one]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hXk
    · rw [SetLike.mem_coe, RingHom.mem_ker, hΛ]
      simp only [map_sub, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, hωt,
        MvPolynomial.C_0, zero_mul, sub_zero, map_zero]
  have hCt : Ideal.span {MvPolynomial.C (t k)} ≤ RingHom.ker Λ := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    exact hΛCt
  have hdiff := sup_le hJ0 hCt hG2
  rw [RingHom.mem_ker, map_sub] at hdiff
  have hS : Λ (∑ p, ∑ c, MvPolynomial.C (M p c) * MvPolynomial.X p * MvPolynomial.X c) = 0 := by
    rw [hΛ, Ideal.Quotient.eq_zero_iff_mem]
    convert hG using 1
    simp only [map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, hωM, mul_assoc]
  have hgs : Λ gs = 0 := by
    rw [hS, sub_zero] at hdiff
    exact hdiff
  have hle : wcOdpJ0 t k ⊔ Ideal.span {gs} ≤ RingHom.ker Λ :=
    sup_le hJ0 (by rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]; exact hgs)
  have hkill : ∀ x ∈ wcOdpJ0 t k ⊔ Ideal.span {gs}, Λ x = 0 := fun x hx =>
    RingHom.mem_ker.mp (hle hx)

  let ΛB : wcOdpB t k gs →+* MvPolynomial (Fin (m + 1)) K ⧸ 𝔔 :=
    Ideal.Quotient.lift (wcOdpJ0 t k ⊔ Ideal.span {gs}) Λ hkill
  haveI := h𝔔
  refine ⟨RingHom.ker ΛB, RingHom.ker_isPrime ΛB, ?_, ?_⟩
  · rw [RingHom.mem_ker]
    show ΛB (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.C (t k))) = 0
    rw [Ideal.Quotient.lift_mk]
    exact hΛCt
  · ext f
    rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.lift_mk, hΛ,
      MvPolynomial.map_map]
    have hid : ω.comp χ = RingHom.id K := RingHom.ext hωχ
    rw [hid, MvPolynomial.map_id, Ideal.Quotient.eq_zero_iff_mem]

theorem wc_beq_open_stalk_transport : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (U : X.Opens) (p₀ : X) (hp : p₀ ∈ U), (∀ s : Γ(X, U), (U.stalkIso ⟨p₀, hp⟩).hom.hom ((U.toScheme.presheaf.germ ⊤ ⟨p₀, hp⟩ trivial).hom ((U.ι.appLE U ⊤ (Scheme.Opens.ι_preimage_self U).ge).hom s)) = (X.presheaf.germ U p₀ hp).hom s) ∧ ∀ c : K, (U.stalkIso ⟨p₀, hp⟩).hom.hom (wcLdpConst K (U.ι ≫ fX) ⟨p₀, hp⟩ c) = wcLdpConst K fX p₀ c :=
by
  intro K _ X fX U p₀ hp
  have hiso : ∀ (t : Γ(U.toScheme, ⊤)),
      (U.stalkIso ⟨p₀, hp⟩).hom.hom ((U.toScheme.presheaf.germ ⊤ ⟨p₀, hp⟩ trivial).hom t) =
        (X.presheaf.germ (U.ι ''ᵁ ⊤) p₀ (by simpa using hp)).hom t := by
    intro t
    have h1 := Scheme.Opens.germ_stalkIso_hom (U := U) (V := (⊤ : U.toScheme.Opens))
      (x := ⟨p₀, hp⟩) (hx := trivial)
    have h2 := congrArg (fun f => CommRingCat.Hom.hom f t) h1
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    convert h2 using 2
  refine ⟨fun s => ?_, fun c => ?_⟩
  · rw [hiso, Scheme.Opens.ι_appLE]
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  · simp only [wcLdpConst, RingHom.comp_apply]
    rw [hiso, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, Scheme.Opens.ι_appTop]
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _

theorem wc_beq_chart_prime_point_eq : ∀ (Y : Scheme.{u}) (W : Y.Opens), IsAffineOpen W → ∀ (w v : Y) (hw : w ∈ W) (hv : v ∈ W) (S : Type u) [CommRing S] (ev : S →+* Γ(Y, W)), Function.Surjective ev → ∀ (C : Type u) [CommRing C] [IsLocalRing C] (θ : Y.presheaf.stalk w →+* C) [IsLocalHom θ] (B : Type u) [CommRing B] (β : Ideal B) [β.IsPrime] [Algebra B C] [IsLocalization.AtPrime C β] (Θ : S →+* B), (θ.comp (Y.presheaf.germ W w hw).hom).comp ev = (algebraMap B C).comp Θ → Ideal.comap Θ β = Ideal.comap ((Y.presheaf.germ W v hv).hom.comp ev) (IsLocalRing.maximalIdeal (Y.presheaf.stalk v)) → w = v :=
by
  intro Y W hW w v hw hv S _ ev hsurj C _ _ θ _ B _ β _ _ _ Θ hcomp hβ
  have E1 : Ideal.comap θ (IsLocalRing.maximalIdeal C) =
      IsLocalRing.maximalIdeal (Y.presheaf.stalk w) := by
    ext x
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
      map_mem_nonunits_iff]
  have E2 : Ideal.comap (algebraMap B C) (IsLocalRing.maximalIdeal C) = β := by
    have h := IsLocalization.AtPrime.under_maximalIdeal C β
    rw [Ideal.under_def] at h
    convert h
  have E3 : Ideal.comap ((Y.presheaf.germ W w hw).hom.comp ev)
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk w)) = Ideal.comap Θ β := by
    rw [← E1, ← E2, Ideal.comap_comap, Ideal.comap_comap, ← hcomp]
    rfl
  have E4 : Ideal.comap (Y.presheaf.germ W w hw).hom
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk w)) =
      Ideal.comap (Y.presheaf.germ W v hv).hom
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk v)) := by
    apply Ideal.comap_injective_of_surjective ev hsurj
    rw [Ideal.comap_comap, Ideal.comap_comap, E3, hβ]
  have hP : ∀ (x : W), (hW.primeIdealOf x).asIdeal =
      Ideal.comap (Y.presheaf.germ W x.1 x.2).hom
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk x.1)) := by
    intro x
    letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf x
    haveI := hW.isLocalization_stalk x
    have h := IsLocalization.AtPrime.under_maximalIdeal (Y.presheaf.stalk x.1)
      (hW.primeIdealOf x).asIdeal
    rw [Ideal.under_def] at h
    exact h.symm
  have E5 : hW.primeIdealOf ⟨w, hw⟩ = hW.primeIdealOf ⟨v, hv⟩ :=
    PrimeSpectrum.ext ((hP ⟨w, hw⟩).trans (E4.trans (hP ⟨v, hv⟩).symm))
  have h1 := hW.fromSpec_primeIdealOf ⟨w, hw⟩
  have h2 := hW.fromSpec_primeIdealOf ⟨v, hv⟩
  rw [E5, h2] at h1
  exact h1.symm

theorem wc_beq_chart_eval_facts : ∀ (K : Type u) [Field K] (m : ℕ) (k : Fin (m + 1)), Function.Surjective (wcBeqEv K m k) ∧ wcBeqEv K m k (MvPolynomial.X k) = 1 ∧ (∀ l, wcBeqEv K m k (MvPolynomial.X l) = wcSgE K m k l) ∧ (∀ (v : wcProjK K m) (hv : v ∈ wcSgD K m k) (c : K), ((wcProjK K m).presheaf.germ (wcSgD K m k) v hv).hom (wcBeqEv K m k (MvPolynomial.C c)) = wcLdpConst K (wcProjKStr K m) v c) ∧ ∀ (a : Fin (m + 1) → Fin (m + 1) → K) (v : wcProjK K m) (hv : v ∈ wcSgD K m k), ((wcProjK K m).presheaf.germ (wcSgD K m k) v hv).hom (wcBeqEv K m k (∑ p, ∑ q, MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q))) = ((wcProjK K m).presheaf.germ (wcSgD K m k) v hv).hom (wcLdpSec K m (wcLdpQuad K m a) k) :=
by
  intro K _ m k
  have hXk : (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K k)
  let τ := (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
    (MvPolynomial.X k)).hom
  let f₀ : K →+* HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (MvPolynomial.X k) :=
    (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (Submonoid.powers (MvPolynomial.X k))).comp
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0))
  let g₀ : Fin (m + 1) → HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k) := fun l =>
    HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) hXk 1
      (MvPolynomial.X l) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K l))

  have h1 : (wcSgD K m k).ι =
      Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k)
          hXk one_pos := by
    rw [← Proj.basicOpenIsoSpec_hom _ _ hXk one_pos,
      ← Proj.basicOpenIsoSpec_inv_ι _ _ hXk one_pos, Iso.hom_inv_id_assoc]
  have h2 : (wcSgD K m k).ι ≫ wcProjKStr K m =
      Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k) ≫
        Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X k)))) := by
    rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ hXk one_pos]
    simp only [wcProjKStr, Category.assoc]
  have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        (MvPolynomial.X k)).appTop =
      (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k)))).hom ≫
        Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k) ≫
        (wcSgD K m k).topIso.inv :=
    Proj.basicOpenToSpec_app_top _ _
  have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
        (wcSgD K m k).ι.appTop =
      CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (Submonoid.powers (MvPolynomial.X k))) ≫
        Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k) ≫
        (wcSgD K m k).topIso.inv := by
    rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, h4]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
  have h3' : (wcSgD K m k).ι.appTop ≫ (wcSgD K m k).topIso.hom =
      (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m k ≤ ⊤)).op := by
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
    first
      | (erw [← Functor.map_comp]; rfl)
      | (simp only [← Functor.map_comp]; rfl)
      | exact ((wcProjK K m).presheaf.map_comp _ _).symm
  have hconst : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
        (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m k ≤ ⊤)).op =
      CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (Submonoid.powers (MvPolynomial.X k))) ≫
        Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (MvPolynomial.X k) := by
    rw [← h3', reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
  have hC : ∀ c : K, wcBeqEv K m k (MvPolynomial.C c) = τ (f₀ c) := by
    intro c
    have e := congrArg (fun φ => φ.hom c) hconst
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    unfold wcBeqEv
    rw [MvPolynomial.eval₂Hom_C]
    exact e

  have hgerm : ∀ (v : wcProjK K m) (hv : v ∈ wcSgD K m k) (c : K),
      ((wcProjK K m).presheaf.germ (wcSgD K m k) v hv).hom (wcBeqEv K m k (MvPolynomial.C c)) =
        wcLdpConst K (wcProjKStr K m) v c := by
    intro v hv c
    have hg := congrArg (fun φ => φ.hom ((wcProjKStr K m).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
      (TopCat.Presheaf.germ_res (wcProjK K m).presheaf (homOfLE (le_top : wcSgD K m k ≤ ⊤)) v hv)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hg
    unfold wcBeqEv
    rw [MvPolynomial.eval₂Hom_C]
    exact hg

  have hX : ∀ l, wcBeqEv K m k (MvPolynomial.X l) = wcSgE K m k l := by
    intro l
    exact MvPolynomial.eval₂Hom_X' _ _ l

  have hfac : wcBeqEv K m k = τ.comp (MvPolynomial.eval₂Hom f₀ g₀) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [hC c]
      show τ (f₀ c) = τ (MvPolynomial.eval₂Hom f₀ g₀ (MvPolynomial.C c))
      rw [MvPolynomial.eval₂Hom_C]
    · intro l
      rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      exact MvPolynomial.eval₂Hom_X' _ _ l

  have hτsurj : Function.Surjective τ := by
    intro s
    refine ⟨(Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (MvPolynomial.X k) hXk one_pos).inv.hom s, ?_⟩
    show (Proj.awayToSection _ _).hom _ = s
    rw [← Proj.basicOpenIsoAway_hom _ _ hXk one_pos]
    exact CategoryTheory.Iso.inv_hom_id_apply _ s

  have hscale : ∀ (w : Localization (Submonoid.powers
        (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K)))
      (a : MvPolynomial (Fin (m + 1)) K) (n : ℕ), a.IsHomogeneous n →
      MvPolynomial.eval₂ ((algebraMap (MvPolynomial (Fin (m + 1)) K) (Localization (Submonoid.powers
          (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K)))).comp MvPolynomial.C)
        (fun l => algebraMap (MvPolynomial (Fin (m + 1)) K) (Localization (Submonoid.powers
          (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K))) (MvPolynomial.X l) * w) a =
      algebraMap (MvPolynomial (Fin (m + 1)) K) (Localization (Submonoid.powers
          (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K))) a * w ^ n := by
    intro w a n ha
    conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff a]
    conv_rhs => rw [← MvPolynomial.support_sum_monomial_coeff a]
    rw [MvPolynomial.eval₂_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : Finsupp.degree d = n := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd) (ha.coeff_eq_zero hne)
    have hw : ∏ i ∈ d.support, w ^ d i = w ^ n := by
      rw [Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_apply, hdeg]
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.monomial_eq, map_mul, map_finsuppProd]
    simp only [Finsupp.prod, RingHom.comp_apply, map_pow, mul_pow, Finset.prod_mul_distrib, hw]
    ring

  have hdeh : ∀ (n : ℕ) (a : MvPolynomial (Fin (m + 1)) K)
      (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K (n • 1)),
      MvPolynomial.eval₂Hom f₀ g₀ a =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          hXk n a ha := by
    intro n a ha
    have ha' : a.IsHomogeneous n := by
      have := (MvPolynomial.mem_homogeneousSubmodule (n • 1) a).mp ha
      simpa [smul_eq_mul, mul_one] using this
    have hf0 : (algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k))
          (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K)))).comp f₀ =
        (algebraMap (MvPolynomial (Fin (m + 1)) K) (Localization (Submonoid.powers
          (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K)))).comp MvPolynomial.C := by
      apply RingHom.ext
      intro c
      have hc : (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (Submonoid.powers (MvPolynomial.X k))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := rfl
      simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      rw [← Localization.mk_one_eq_algebraMap]
      exact hc
    have hg0 : ∀ l, (algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X k))
          (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K)))) (g₀ l) =
        algebraMap (MvPolynomial (Fin (m + 1)) K) (Localization (Submonoid.powers
          (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K))) (MvPolynomial.X l) *
          Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ := by
      intro l
      rw [HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by first
        | (simp; done)
        | (simp [mul_comm]; done)
        | (simp only [SubmonoidClass.coe_pow, Submonoid.coe_mul, OneMemClass.coe_one, pow_one]; ring)⟩
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
      MvPolynomial.coe_eval₂Hom, MvPolynomial.hom_eval₂, hf0]
    simp only [hg0]
    rw [hscale _ a n ha', Localization.mk_pow, ← Localization.mk_one_eq_algebraMap,
      Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by first
      | (simp; done)
      | (simp [mul_comm]; done)
      | (simp only [SubmonoidClass.coe_pow, Submonoid.coe_mul, OneMemClass.coe_one, one_pow]; ring)⟩
  refine ⟨?_, ?_, hX, hgerm, ?_⟩
  ·
    intro s
    obtain ⟨x, rfl⟩ := hτsurj s
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) hXk x
    exact ⟨a, by rw [hfac, RingHom.comp_apply, hdeh n a ha]⟩
  ·
    rw [hX k]
    unfold wcSgE
    rw [← map_one (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (MvPolynomial.X k)).hom]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, ← Localization.mk_one,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp⟩
  ·
    intro a v hv
    have hd := hdeh 2 (∑ p, ∑ q, MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q))
      (wcLdpQuad K m a).2
    have hsec : wcBeqEv K m k (∑ p, ∑ q, MvPolynomial.C (a p q) *
        (MvPolynomial.X p * MvPolynomial.X q)) = wcLdpSec K m (wcLdpQuad K m a) k := by
      rw [hfac, RingHom.comp_apply, hd]
      rfl
    rw [hsec]

theorem wc_beq_blowup_stalk_point : ∀ (K : Type u) [Field K] (X' : Scheme.{u}) [IsAffine X'] (fX' : X' ⟶ Spec (.of K)) (I' : X'.IdealSheafData) (m : ℕ) (g : Fin (m + 1) → Γ(X', ⊤)), I'.ideal ⟨⊤, isAffineOpen_top X'⟩ = Ideal.span (Set.range g) → ∀ (P : Scheme.{u}) (ι : P ⟶ Limits.pullback fX' (wcProjKStr K m)), wcCsdIsBlowup I' (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) → wcBeqChartRel K fX' m ι g → ∀ (p' : X') (C : Type u) [CommRing C] [IsLocalRing C] (ρ : X'.presheaf.stalk p' →+* C) [IsLocalHom ρ] (τ : C) (x : Fin (m + 1) → C) (k : Fin (m + 1)), τ ∈ nonZeroDivisors C → x k = 1 → (∀ b, ρ ((X'.presheaf.germ ⊤ p' trivial).hom (g b)) = τ * x b) → ∃ (y : P) (hk : (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) y ∈ wcSgD K m k) (θ : (wcProjK K m).presheaf.stalk ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) y) →+* C), IsLocalHom θ ∧ (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) y = p' ∧ (∀ l, θ (((wcProjK K m).presheaf.germ (wcSgD K m k) _ hk).hom (wcSgE K m k l)) = x l) ∧ ∀ c : K, θ (wcLdpConst K (wcProjKStr K m) ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) y) c) = ρ (wcLdpConst K fX' p' c) :=
by
  classical
  intro K _ X' _ fX' I' m g hI P ι hbl hrel p' C _ _ ρ _ τ x k hτ hxk hρg

  have L1 : ∀ {Pa Y : Scheme.{u}} (f : Pa ⟶ Y) (W : Y.Opens) (V : Pa.Opens) (e : V ≤ f ⁻¹ᵁ W)
      (y : Pa) (hy : y ∈ V) (hW : f y ∈ W) (s : Γ(Y, W)),
      (Pa.presheaf.germ V y hy).hom ((f.appLE W V e).hom s) =
        (f.stalkMap y).hom ((Y.presheaf.germ W (f y) hW).hom s) := by
    intro Pa Y f W V e y hy hW s
    rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.appLE, CommRingCat.comp_apply,
      TopCat.Presheaf.germ_res_apply]

  have L2' : ∀ {Y : Scheme.{u}} (γ : Spec (.of C) ⟶ Y) (s : Γ(Y, ⊤)),
      (Scheme.stalkClosedPointTo γ).hom
          ((Y.presheaf.germ ⊤ (γ (IsLocalRing.closedPoint C)) trivial).hom s) =
        (Scheme.ΓSpecIso (.of C)).hom.hom (γ.appTop.hom s) := by
    intro Y γ s
    have h := Scheme.germ_stalkClosedPointTo γ ⊤ trivial
    have h2 := congrArg (fun φ => φ.hom s) h
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    rw [h2]
    simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom, eqToIso.hom, CommRingCat.hom_comp,
      RingHom.comp_apply]
    congr 1

  have L2 : ∀ {Pa Y : Scheme.{u}} (γ : Spec (.of C) ⟶ Pa) (f : Pa ⟶ Y) (s : Γ(Y, ⊤)),
      (Scheme.stalkClosedPointTo γ).hom ((f.stalkMap (γ (IsLocalRing.closedPoint C))).hom
          ((Y.presheaf.germ ⊤ (f (γ (IsLocalRing.closedPoint C))) trivial).hom s)) =
        (Scheme.ΓSpecIso (.of C)).hom.hom ((γ ≫ f).appTop.hom s) := by
    intro Pa Y γ f s
    have h := congrArg (fun φ => φ.hom ((Y.presheaf.germ ⊤ (f (γ (IsLocalRing.closedPoint C)))
      trivial).hom s)) (Scheme.stalkClosedPointTo_comp γ f)
    refine Eq.trans ?_ (h.symm.trans (L2' (γ ≫ f) s))
    rfl

  haveI : IsLocalHom (CommRingCat.ofHom ρ).hom := ‹IsLocalHom ρ›
  have hT0 : (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') (IsLocalRing.closedPoint C) = p' := by
    show (X'.fromSpecStalk p') ((Spec.map (CommRingCat.ofHom ρ)) (IsLocalRing.closedPoint C)) = p'
    rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
  have hT1 : ∀ s : Γ(X', ⊤), (Scheme.ΓSpecIso (.of C)).hom.hom
      ((Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p').appTop.hom s) =
        ρ ((X'.presheaf.germ ⊤ p' trivial).hom s) := by
    intro s
    rw [← L2' (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') s]
    have h := Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk (CommRingCat.ofHom ρ) ⊤ trivial
    have h2 := congrArg (fun φ => φ.hom s) h
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2

  let E : Γ(Spec (.of C), ⊤) ≃+* C := (Scheme.ΓSpecIso (.of C)).commRingCatIsoToRingEquiv
  have hS : ∀ b, E ((Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p').appTop.hom (g b)) =
      τ * x b := fun b => (hT1 (g b)).trans (hρg b)
  have hInv : wcCsdInvPull I' (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') := by
    intro t
    have hVU : (⊤ : (Spec (.of C)).Opens) ≤
        (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') ⁻¹ᵁ (⊤ : X'.Opens) :=
      fun z _ => trivial
    have hA : Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') ⊤ ⊤ hVU =
        (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p').appTop := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    have hk' : E ((Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p').appTop.hom (g k)) = τ := by
      rw [hS k, hxk, mul_one]
    refine ⟨⟨⊤, isAffineOpen_top X'⟩, ⟨⊤, isAffineOpen_top (Spec (.of C))⟩, hVU, g k, trivial,
      ?_, ?_, ?_⟩
    · rw [hI]
      exact Ideal.subset_span ⟨k, rfl⟩
    · show (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') ⊤ ⊤ hVU).hom
        (g k) ∈ nonZeroDivisors Γ(Spec (.of C), ⊤)
      rw [hA, mem_nonZeroDivisors_iff]
      constructor
      · intro z hz
        apply E.injective
        have h1 := congrArg E hz
        rw [map_mul, hk', map_zero] at h1
        rw [map_zero]
        exact (mul_left_mem_nonZeroDivisors_eq_zero_iff hτ).mp h1
      · intro z hz
        apply E.injective
        have h1 := congrArg E hz
        rw [map_mul, hk', map_zero, mul_comm] at h1
        rw [map_zero]
        exact (mul_left_mem_nonZeroDivisors_eq_zero_iff hτ).mp h1
    · show Ideal.map (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') ⊤ ⊤
          hVU).hom (I'.ideal ⟨⊤, isAffineOpen_top X'⟩) =
        Ideal.span {(Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') ⊤ ⊤
          hVU).hom (g k)}
      rw [hA, hI, Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_span_singleton']
        refine ⟨E.symm (x b), ?_⟩
        apply E.injective
        rw [map_mul, RingEquiv.apply_symm_apply, hk', hS b]
        ring
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.subset_span ⟨g k, ⟨k, rfl⟩, rfl⟩

  obtain ⟨γ, hγ, -⟩ := hbl.2 (Spec (.of C)) (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') hInv
  have hFy : (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) (γ (IsLocalRing.closedPoint C)) = p' :=
    (congrArg (fun φ : Spec (.of C) ⟶ X' => φ (IsLocalRing.closedPoint C)) hγ).trans hT0
  have hS' : ∀ b, (Scheme.ΓSpecIso (.of C)).hom.hom
      ((γ ≫ ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)).appTop.hom (g b)) = τ * x b := by
    intro b
    rw [hγ]
    exact (hT1 (g b)).trans (hρg b)
  have hθloc : IsLocalHom ((Scheme.stalkClosedPointTo γ).hom.comp
      ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom) := inferInstance

  have hchart : ∀ (J : Fin (m + 1))
      (hJ : (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (γ (IsLocalRing.closedPoint C)) ∈
        wcSgD K m J) (l : Fin (m + 1)),
      (Scheme.stalkClosedPointTo γ).hom (((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom (((wcProjK K m).presheaf.germ (wcSgD K m J) _ hJ).hom
          (wcSgE K m J l))) * (τ * x J) = τ * x l := by
    intro J hJ l
    have hyQ : γ (IsLocalRing.closedPoint C) ∈ wcBeqChart K fX' m ι J :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨trivial, hJ⟩
    have hr : (Scheme.Hom.appLE (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) ⊤
        (wcBeqChart K fX' m ι J) inf_le_left).hom (g l) =
        (Scheme.Hom.appLE (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (wcSgD K m J)
          (wcBeqChart K fX' m ι J) inf_le_right).hom (wcSgE K m J l) *
        (Scheme.Hom.appLE (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) ⊤
          (wcBeqChart K fX' m ι J) inf_le_left).hom (g J) := hrel.2 J l
    have h1 := congrArg (fun s => (Scheme.stalkClosedPointTo γ).hom
      ((P.presheaf.germ (wcBeqChart K fX' m ι J) (γ (IsLocalRing.closedPoint C)) hyQ).hom s)) hr
    simp only [map_mul] at h1
    rw [L1 (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) ⊤ _ _ _ hyQ trivial (g l),
      L1 (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) ⊤ _ _ _ hyQ trivial (g J),
      L1 (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (wcSgD K m J) _ _ _ hyQ hJ (wcSgE K m J l),
      L2 γ (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) (g l),
      L2 γ (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)) (g J), hS' l, hS' J] at h1
    exact h1.symm

  have hcov : (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩

  have hbo : ∀ J L : Fin (m + 1),
      (wcProjK K m).basicOpen (wcSgE K m J L) = wcSgD K m J ⊓ wcSgD K m L := by
    have L1' : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
        (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
        Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      intro σ A _ _ _ 𝒜 _ f g hf hg
      have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
          HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
        apply HomogeneousLocalization.val_injective
        simp [HomogeneousLocalization.Away.val_mk]
      have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
        have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
        rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
        rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
      have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
          (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
        have hsp := basicOpen_eq_of_affine
          (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
        have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
            (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
              (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
          congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
        rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
        congr 2
        rw [Proj.basicOpenIsoSpec_hom]
        change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
        rw [Proj.basicOpenToSpec_app_top]
        exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
          (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
          (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
      rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ a : Fin (m + 1), (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 := fun a =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ a)
    intro J L
    exact (L1' _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm

  obtain ⟨J, hJ⟩ : ∃ J, (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m))
      (γ (IsLocalRing.closedPoint C)) ∈ wcSgD K m J := by
    have hv0 : (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (γ (IsLocalRing.closedPoint C)) ∈
        (⊤ : (wcProjK K m).Opens) := trivial
    rw [← hcov] at hv0
    exact TopologicalSpace.Opens.mem_iSup.mp hv0
  have hcJ := hchart J hJ k
  rw [hxk, mul_one] at hcJ
  have he : (Scheme.stalkClosedPointTo γ).hom (((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom (((wcProjK K m).presheaf.germ (wcSgD K m J) _ hJ).hom
          (wcSgE K m J k))) * x J = 1 := by
    have h1 : τ * ((Scheme.stalkClosedPointTo γ).hom
        (((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom (((wcProjK K m).presheaf.germ (wcSgD K m J) _ hJ).hom
          (wcSgE K m J k))) * x J - 1) = 0 := by
      linear_combination hcJ
    exact sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff hτ).mp h1)
  have hunit : IsUnit (((wcProjK K m).presheaf.germ (wcSgD K m J) _ hJ).hom (wcSgE K m J k)) :=
    isUnit_of_map_unit ((Scheme.stalkClosedPointTo γ).hom.comp
      ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom) _ (isUnit_iff_exists_inv.mpr ⟨_, he⟩)
  have hbasic := (Scheme.mem_basicOpen (wcProjK K m) (wcSgE K m J k) _ hJ).mpr hunit
  rw [hbo J k] at hbasic
  have hk : (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (γ (IsLocalRing.closedPoint C)) ∈
      wcSgD K m k := (TopologicalSpace.Opens.mem_inf.mp hbasic).2
  have hθE : ∀ l, ((Scheme.stalkClosedPointTo γ).hom.comp
      ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom) (((wcProjK K m).presheaf.germ (wcSgD K m k) _ hk).hom
          (wcSgE K m k l)) = x l := by
    intro l
    have hc := hchart k hk l
    rw [hxk, mul_one] at hc
    rw [RingHom.comp_apply]
    have h1 : τ * ((Scheme.stalkClosedPointTo γ).hom
        (((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom (((wcProjK K m).presheaf.germ (wcSgD K m k) _ hk).hom
          (wcSgE K m k l))) - x l) = 0 := by
      linear_combination hc
    exact sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff hτ).mp h1)

  have hmor : (γ ≫ ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) ≫ wcProjKStr K m =
      (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') ≫ fX' := by
    rw [← hγ]
    simp only [Category.assoc, Limits.pullback.condition]
  have hconst : ∀ c : K, ((Scheme.stalkClosedPointTo γ).hom.comp
      ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom) (wcLdpConst K (wcProjKStr K m)
          ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (γ (IsLocalRing.closedPoint C))) c) =
      ρ (wcLdpConst K fX' p' c) := by
    intro c
    show (Scheme.stalkClosedPointTo γ).hom (((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).stalkMap
        (γ (IsLocalRing.closedPoint C))).hom (((wcProjK K m).presheaf.germ ⊤
          ((ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (γ (IsLocalRing.closedPoint C)))
            trivial).hom ((wcProjKStr K m).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))) =
      ρ ((X'.presheaf.germ ⊤ p' trivial).hom (fX'.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
    rw [L2 γ (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)), ← hT1]
    congr 1
    have h1 := congrArg (fun φ : Spec (.of C) ⟶ Spec (.of K) =>
      φ.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) hmor
    simp only at h1
    rw [Scheme.Hom.comp_appTop (γ ≫ ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)) (wcProjKStr K m),
      Scheme.Hom.comp_appTop (Spec.map (CommRingCat.ofHom ρ) ≫ X'.fromSpecStalk p') fX',
      CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply] at h1
    exact h1
  exact ⟨γ (IsLocalRing.closedPoint C), hk, _, hθloc, hFy, hθE, hconst⟩

theorem wc_beq_quadric_in_fibre : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K))
    (I : X.IdealSheafData) (U : X.affineOpens) (p₀ : X) (hp : p₀ ∈ U.1) (m : ℕ)
    (g : Fin (m + 1) → Γ(X, U.1))
    (P : Scheme.{u}) (ι : P ⟶ Limits.pullback (U.1.ι ≫ fX) (wcProjKStr K m)),
    IsClosedImmersion ι →
    (I.comap U.1.ι).ideal ⟨⊤, @isAffineOpen_top U.1.toScheme U.2⟩ =
      Ideal.span (Set.range (wcBeqGU U g)) →
    wcCsdIsBlowup (I.comap U.1.ι) (ι ≫ Limits.pullback.fst (U.1.ι ≫ fX) (wcProjKStr K m)) →
    wcBeqChartRel K (U.1.ι ≫ fX) m ι (wcBeqGU U g) →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin (m + 1) → R) (h : R)
      (M : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (χ : K →+* R) (φ : R →+* X.presheaf.stalk p₀)
      (a : Fin (m + 1) → Fin (m + 1) → K),
    ringKrullDim R = ((m + 1 : ℕ) : WithBot ℕ∞) →
    IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    h - ∑ p, ∑ c, M p c * t p * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
    IsUnit (M + M.transpose).det →
    Function.Surjective φ → RingHom.ker φ = Ideal.span {h} →
    Ideal.map φ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal (X.presheaf.stalk p₀) →
    φ.comp χ = wcLdpConst K fX p₀ →
    (∀ y : R, ∃ c : K, y - χ c ∈ IsLocalRing.maximalIdeal R) →
    (∀ p c, M p c - χ (a p c) ∈ IsLocalRing.maximalIdeal R) →
    (∀ b, (X.presheaf.germ U.1 p₀ hp).hom (g b) = φ (t b)) →
    ∀ v : wcProjK K m, (∀ (c : Fin (m + 1)) (hc : v ∈ wcSgD K m c),
      ((wcProjK K m).presheaf.germ (wcSgD K m c) v hc).hom (wcLdpSec K m (wcLdpQuad K m a) c) ∈
        IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk v)) →
    ∃ y : P, U.1.ι ((ι ≫ Limits.pullback.fst (U.1.ι ≫ fX) (wcProjKStr K m)) y) = p₀ ∧
      (ι ≫ Limits.pullback.snd (U.1.ι ≫ fX) (wcProjKStr K m)) y = v :=
by
  classical
  intro K _ X fX I U p₀ hp m g P ι hι hIdeal hbl hrel R _ _ _ t h M χ φ a hdim ht hA hdet hφsurj
    hφker hφmax hconst hres hMa hg v hv
  haveI : IsAffine U.1.toScheme := U.2

  obtain ⟨k, hvk⟩ : ∃ k, v ∈ wcSgD K m k := by
    have hcov := wc_pp_basicOpen_cover K m
    have hv0 : v ∈ (⊤ : (wcProjK K m).Opens) := trivial
    rw [← hcov] at hv0
    obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hv0
    exact ⟨k, hk⟩

  obtain ⟨hsurj, hXk, hXl, hC, hquad⟩ := wc_beq_chart_eval_facts K m k
  let 𝔔 : Ideal (MvPolynomial (Fin (m + 1)) K) :=
    Ideal.comap (((wcProjK K m).presheaf.germ (wcSgD K m k) v hvk).hom.comp (wcBeqEv K m k))
      (IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk v))
  have h𝔔prime : 𝔔.IsPrime := Ideal.IsPrime.comap _
  have hXk1 : MvPolynomial.X k - 1 ∈ 𝔔 := by
    show ((wcProjK K m).presheaf.germ (wcSgD K m k) v hvk).hom
      (wcBeqEv K m k (MvPolynomial.X k - 1)) ∈
        IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk v)
    rw [map_sub, hXk, map_one, sub_self, map_zero]
    exact zero_mem _
  have hG : (∑ p, ∑ q, MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q)) ∈ 𝔔 := by
    show ((wcProjK K m).presheaf.germ (wcSgD K m k) v hvk).hom
      (wcBeqEv K m k (∑ p, ∑ q, MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q))) ∈
        IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk v)
    rw [hquad a v hvk]
    exact hv k hvk

  obtain ⟨gs, hG1, hG2⟩ := wc_beq_chart_strict_transform R m t h M k ht hA
  obtain ⟨β, hβprime, htkβ, hβ⟩ :=
    wc_beq_chart_fibre_prime K R m t M χ a k gs ht hG2 hMa hres 𝔔 h𝔔prime hXk1 hG
  haveI := hβprime
  let Θ : MvPolynomial (Fin (m + 1)) K →+* wcOdpB t k gs :=
    (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs})).comp (MvPolynomial.map χ)
  let ψ : R →+* Localization.AtPrime β :=
    (algebraMap (wcOdpB t k gs) (Localization.AtPrime β)).comp (algebraMap R (wcOdpB t k gs))
  let τ : Localization.AtPrime β := ψ (t k)
  let x : Fin (m + 1) → Localization.AtPrime β := fun l =>
    algebraMap (wcOdpB t k gs) (Localization.AtPrime β)
      (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.X l))

  have hτ : τ ∈ nonZeroDivisors (Localization.AtPrime β) :=
    (wc_odp_chart_nzd R (m + 1) t M k gs hdim ht hdet hG2).2 β (Localization.AtPrime β)
  have hamap : ∀ r : R, algebraMap R (wcOdpB t k gs) r =
      Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.C r) := by
    intro r
    first
      | rfl
      | rw [Ideal.Quotient.algebraMap_eq, RingHom.comp_apply, MvPolynomial.algebraMap_eq]
  have hJsub : wcOdpJ0 t k ≤ wcOdpJ0 t k ⊔ Ideal.span {gs} := le_sup_left
  have hgsmem : gs ∈ wcOdpJ0 t k ⊔ Ideal.span {gs} :=
    Ideal.mem_sup_right (Ideal.mem_span_singleton_self gs)
  have hgen : ∀ b, MvPolynomial.C (t k) * MvPolynomial.X b - MvPolynomial.C (t b) ∈
      wcOdpJ0 t k := by
    intro b
    unfold wcOdpJ0
    exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)
  have hXk1J : MvPolynomial.X k - 1 ∈ wcOdpJ0 t k := by
    unfold wcOdpJ0
    exact Ideal.subset_span (Set.mem_insert _ _)
  have hBh : algebraMap R (wcOdpB t k gs) h = 0 := by
    rw [hamap, Ideal.Quotient.eq_zero_iff_mem]
    have e : MvPolynomial.C h = (MvPolynomial.C h - MvPolynomial.C (t k) ^ 2 * gs) +
        MvPolynomial.C (t k) ^ 2 * gs := by ring
    rw [e]
    exact Ideal.add_mem _ (hJsub hG1) (Ideal.mul_mem_left _ _ hgsmem)
  have hψh : ψ h = 0 := by
    show algebraMap (wcOdpB t k gs) (Localization.AtPrime β) (algebraMap R (wcOdpB t k gs) h) = 0
    rw [hBh, map_zero]
  have hBt : ∀ b, algebraMap R (wcOdpB t k gs) (t b) = algebraMap R (wcOdpB t k gs) (t k) *
      Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.X b) := by
    intro b
    rw [hamap, hamap, ← map_mul, Ideal.Quotient.eq, ← Ideal.neg_mem_iff]
    convert hJsub (hgen b) using 1
    ring
  have hBXk : Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.X k) = 1 := by
    rw [← map_one (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs})), Ideal.Quotient.eq]
    exact hJsub hXk1J
  have hψt : ∀ b, ψ (t b) = τ * x b := by
    intro b
    show algebraMap (wcOdpB t k gs) (Localization.AtPrime β) (algebraMap R (wcOdpB t k gs) (t b)) =
      algebraMap (wcOdpB t k gs) (Localization.AtPrime β) (algebraMap R (wcOdpB t k gs) (t k)) *
        algebraMap (wcOdpB t k gs) (Localization.AtPrime β)
          (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.X b))
    rw [hBt b, map_mul]
  have hxk : x k = 1 := by
    show algebraMap (wcOdpB t k gs) (Localization.AtPrime β)
      (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.X k)) = 1
    rw [hBXk, map_one]
  have hτmax : τ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime β) := by
    show algebraMap (wcOdpB t k gs) (Localization.AtPrime β) (algebraMap R (wcOdpB t k gs) (t k)) ∈ _
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime β) β _).mpr htkβ

  have hkerle : RingHom.ker φ ≤ RingHom.ker ψ := by
    rw [hφker, Ideal.span_le, Set.singleton_subset_iff]
    exact RingHom.mem_ker.mpr hψh
  let ρ : X.presheaf.stalk p₀ →+* Localization.AtPrime β :=
    RingHom.liftOfSurjective φ hφsurj ⟨ψ, hkerle⟩
  have hρφ : ρ.comp φ = ψ := RingHom.liftOfSurjective_comp φ hφsurj ⟨ψ, hkerle⟩
  have hρloc : IsLocalHom ρ := by
    refine ⟨fun s hs => ?_⟩
    obtain ⟨r, rfl⟩ := hφsurj s
    by_contra hns
    have hr : r ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => hns (hu.map φ)
    rw [ht] at hr
    have hspan : Ideal.span (Set.range t) ≤
        Ideal.comap ψ (IsLocalRing.maximalIdeal (Localization.AtPrime β)) := by
      rw [Ideal.span_le]
      rintro _ ⟨b, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, hψt b]
      exact Ideal.mul_mem_right _ _ hτmax
    have hψr : ψ r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime β) := hspan hr
    have hu : IsUnit (ψ r) := by
      rw [← hρφ]
      exact hs
    exact (IsLocalRing.mem_maximalIdeal _).mp hψr hu
  haveI := hρloc

  let p' : U.1.toScheme := ⟨p₀, hp⟩
  let ρ' : U.1.toScheme.presheaf.stalk p' →+* Localization.AtPrime β :=
    ρ.comp (U.1.stalkIso p').hom.hom
  haveI : IsLocalHom ρ' := inferInstance
  obtain ⟨hTa, hTb⟩ := wc_beq_open_stalk_transport K X fX U.1 p₀ hp
  have hρ'g : ∀ b, ρ' ((U.1.toScheme.presheaf.germ ⊤ p' trivial).hom (wcBeqGU U g b)) =
      τ * x b := by
    intro b
    have e1 : (U.1.stalkIso p').hom.hom
        ((U.1.toScheme.presheaf.germ ⊤ p' trivial).hom (wcBeqGU U g b)) =
        (X.presheaf.germ U.1 p₀ hp).hom (g b) := hTa (g b)
    show ρ ((U.1.stalkIso p').hom.hom
        ((U.1.toScheme.presheaf.germ ⊤ p' trivial).hom (wcBeqGU U g b))) = τ * x b
    rw [e1, hg b, ← RingHom.comp_apply ρ φ, hρφ]
    exact hψt b

  obtain ⟨y, hk, θ, hθloc, hFy, hθE, hθc⟩ :=
    wc_beq_blowup_stalk_point K U.1.toScheme (U.1.ι ≫ fX) (I.comap U.1.ι) m (wcBeqGU U g)
      hIdeal P ι hbl hrel p' (Localization.AtPrime β) ρ' τ x k hτ hxk hρ'g
  haveI := hθloc

  refine ⟨y, ?_, ?_⟩
  · rw [hFy]
    rfl
  · have hW : IsAffineOpen (wcSgD K m k) :=
      Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k))
        one_pos
    refine wc_beq_chart_prime_point_eq (wcProjK K m) (wcSgD K m k) hW _ v hk hvk
      (MvPolynomial (Fin (m + 1)) K) (wcBeqEv K m k) hsurj (Localization.AtPrime β) θ
      (wcOdpB t k gs) β Θ ?_ hβ
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply]
      rw [hC _ hk c, hθc]
      show ρ ((U.1.stalkIso p').hom.hom (wcLdpConst K (U.1.ι ≫ fX) p' c)) = _
      rw [hTb c, ← hconst, RingHom.comp_apply, ← RingHom.comp_apply ρ φ, hρφ]
      show algebraMap (wcOdpB t k gs) (Localization.AtPrime β) (algebraMap R (wcOdpB t k gs) (χ c)) =
        algebraMap (wcOdpB t k gs) (Localization.AtPrime β)
          (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.map χ (MvPolynomial.C c)))
      rw [MvPolynomial.map_C, hamap]
    · intro l
      simp only [RingHom.comp_apply]
      rw [hXl l, hθE l]
      show algebraMap (wcOdpB t k gs) (Localization.AtPrime β)
          (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.X l)) =
        algebraMap (wcOdpB t k gs) (Localization.AtPrime β)
          (Ideal.Quotient.mk (wcOdpJ0 t k ⊔ Ideal.span {gs}) (MvPolynomial.map χ (MvPolynomial.X l)))
      rw [MvPolynomial.map_X]

theorem wc_beq_fibre_in_quadric : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K))
    (U : X.affineOpens) (p₀ : X) (hp : p₀ ∈ U.1) (m : ℕ) (g : Fin (m + 1) → Γ(X, U.1))
    (P : Scheme.{u}) (ι : P ⟶ Limits.pullback (U.1.ι ≫ fX) (wcProjKStr K m)),
    IsClosedImmersion ι → wcBeqChartRel K (U.1.ι ≫ fX) m ι (wcBeqGU U g) →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] (t : Fin (m + 1) → R) (h : R)
      (M : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (χ : K →+* R) (φ : R →+* X.presheaf.stalk p₀)
      (a : Fin (m + 1) → Fin (m + 1) → K),
    IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    h - ∑ p, ∑ c, M p c * t p * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
    φ h = 0 →
    Ideal.map φ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal (X.presheaf.stalk p₀) →
    φ.comp χ = wcLdpConst K fX p₀ →
    (∀ p c, M p c - χ (a p c) ∈ IsLocalRing.maximalIdeal R) →
    (∀ b, (X.presheaf.germ U.1 p₀ hp).hom (g b) = φ (t b)) →
    ∀ y : P, U.1.ι ((ι ≫ Limits.pullback.fst (U.1.ι ≫ fX) (wcProjKStr K m)) y) = p₀ →
    ∀ (c : Fin (m + 1))
      (hc : (ι ≫ Limits.pullback.snd (U.1.ι ≫ fX) (wcProjKStr K m)) y ∈ wcSgD K m c),
      ((wcProjK K m).presheaf.germ (wcSgD K m c) _ hc).hom (wcLdpSec K m (wcLdpQuad K m a) c) ∈
        IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk
          ((ι ≫ Limits.pullback.snd (U.1.ι ≫ fX) (wcProjKStr K m)) y)) :=
by
  classical
  intro K _ X fX U p₀ hp m g P ι hι hrel R _ _ t h M χ φ a H1 H2 H3 H4 H5 H6 H7 y hy c hc
  haveI := hι
  haveI : IsAffine U.1.toScheme := U.2
  set F := ι ≫ Limits.pullback.fst (U.1.ι ≫ fX) (wcProjKStr K m) with hF
  set Ψ := ι ≫ Limits.pullback.snd (U.1.ι ≫ fX) (wcProjKStr K m) with hΨ
  subst hy
  set Q := wcBeqChart K (U.1.ι ≫ fX) m ι c with hQdef

  have s2 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (W : A.Opens) (e : W ≤ f ⁻¹ᵁ V)
      (x : A) (hx : x ∈ W) (s : Γ(B, V)),
      (A.presheaf.germ W x hx).hom ((f.appLE V W e).hom s) =
        (f.stalkMap x).hom ((B.presheaf.germ V (f x) (show f x ∈ V from e hx)).hom s) := by
    intro A B f V W e x hx s
    have h1 := Scheme.Hom.germ_stalkMap_apply f V x (show f x ∈ V from e hx) s
    have h2 := TopCat.Presheaf.germ_res_apply A.presheaf (homOfLE e) x hx ((f.app V).hom s)
    exact h2.trans h1.symm

  have s3 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (sB : B ⟶ Spec (.of K)) (x : A),
      (f.stalkMap x).hom.comp (wcLdpConst K sB (f x)) = wcLdpConst K (f ≫ sB) x := by
    intro A B f sB x
    ext r
    simp only [wcLdpConst, RingHom.comp_apply, CommRingCat.hom_comp, Scheme.Hom.comp_appTop]
    exact Scheme.Hom.germ_stalkMap_apply f ⊤ x trivial _

  have s1 : ∀ (S : Type u) [CommRing S] (ρ : R →+* S) (γ : S) (e : Fin (m + 1) → S),
      ρ h = 0 → γ ∈ nonZeroDivisors S → (∀ l, ρ (t l) = e l * γ) →
      ∑ p, ∑ c, ρ (M p c) * e p * e c ∈ Ideal.span {γ} := by
    intro S _ ρ γ e hh hγ ht
    have hx : h - ∑ p, ∑ c, M p c * t p * t c ∈ (Ideal.span (Set.range t)) ^ 3 := by
      rw [← H1]; exact H2
    have hmap : ρ (h - ∑ p, ∑ c, M p c * t p * t c) ∈ Ideal.span {γ ^ 3} := by
      have h1 := Ideal.mem_map_of_mem ρ hx
      rw [Ideal.map_pow, Ideal.map_span] at h1
      have h2 : Ideal.span (⇑ρ '' Set.range t) ≤ Ideal.span {γ} := by
        rw [Ideal.span_le]
        rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
        rw [ht l]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self γ)
      have h3 := Ideal.pow_right_mono h2 3 h1
      rwa [Ideal.span_singleton_pow] at h3
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hmap
    have hcalc : ρ (h - ∑ p, ∑ c, M p c * t p * t c) =
        -(γ ^ 2 * ∑ p, ∑ c, ρ (M p c) * e p * e c) := by
      simp only [map_sub, map_sum, map_mul, hh, ht, zero_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun c _ => by ring))
    have hγ2 : γ ^ 2 ∈ nonZeroDivisors S := Submonoid.pow_mem _ hγ 2
    have key : γ ^ 2 * (∑ p, ∑ c, ρ (M p c) * e p * e c + w * γ) = 0 := by
      have h4 : w * γ ^ 3 = -(γ ^ 2 * ∑ p, ∑ c, ρ (M p c) * e p * e c) := hw.trans hcalc
      linear_combination h4
    have h5 := (mem_nonZeroDivisors_iff.mp hγ2).1 _ key
    rw [Ideal.mem_span_singleton']
    exact ⟨-w, by linear_combination (-1 : S) * h5⟩

  have hD : IsAffineOpen (wcSgD K m c) := by
    unfold wcSgD
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X c)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) one_pos
  have hQ : IsAffineOpen Q :=
    (wc_closed_in_product_chart_gen (Spec (.of K)) U.1.toScheme (wcProjK K m) P (U.1.ι ≫ fX)
      (wcProjKStr K m) ι ⊤ (wcSgD K m c) (isAffineOpen_top _) hD).1
  have hyQ : y ∈ Q := ⟨trivial, hc⟩
  set γ : P.presheaf.stalk y :=
    (P.presheaf.germ Q y hyQ).hom ((F.appLE ⊤ Q inf_le_left).hom (wcBeqGU U g c)) with hγdef
  have hγ : γ ∈ nonZeroDivisors (P.presheaf.stalk y) := by
    letI : Algebra Γ(P, Q) (P.presheaf.stalk ((⟨y, hyQ⟩ : Q) : P)) :=
      TopCat.Presheaf.algebra_section_stalk P.presheaf ⟨y, hyQ⟩
    haveI hloc := hQ.isLocalization_stalk ⟨y, hyQ⟩
    exact IsLocalization.map_nonZeroDivisors_le (hQ.primeIdealOf ⟨y, hyQ⟩).asIdeal.primeCompl
      (P.presheaf.stalk ((⟨y, hyQ⟩ : Q) : P)) (Submonoid.mem_map_of_mem (algebraMap _ _) (hrel.1 c))

  have hstep : ∀ l, (F.stalkMap y).hom ((U.1.ι.stalkMap (F y)).hom
      ((X.presheaf.germ U.1 (U.1.ι (F y)) hp).hom (g l))) =
      (Ψ.stalkMap y).hom (((wcProjK K m).presheaf.germ (wcSgD K m c) (Ψ y) hc).hom
        (wcSgE K m c l)) * γ := by
    intro l
    have e1 := s2 U.1.ι U.1 ⊤ (Scheme.Opens.ι_preimage_self U.1).ge (F y) trivial (g l)
    have e2 := s2 F ⊤ Q inf_le_left y hyQ (wcBeqGU U g l)
    have e3 := s2 Ψ (wcSgD K m c) Q inf_le_right y hyQ (wcSgE K m c l)
    have e4 : (P.presheaf.germ Q y hyQ).hom ((F.appLE ⊤ Q inf_le_left).hom (wcBeqGU U g l)) =
        (P.presheaf.germ Q y hyQ).hom ((Ψ.appLE (wcSgD K m c) Q inf_le_right).hom
          (wcSgE K m c l)) * γ := by
      rw [hγdef, ← map_mul]
      exact congrArg (P.presheaf.germ Q y hyQ).hom (hrel.2 c l)
    rw [← e1]
    exact e2.symm.trans (e4.trans (by rw [e3]))
  let e : Fin (m + 1) → P.presheaf.stalk y := fun l =>
    (Ψ.stalkMap y).hom (((wcProjK K m).presheaf.germ (wcSgD K m c) (Ψ y) hc).hom (wcSgE K m c l))
  let ρ' : R →+* P.presheaf.stalk y :=
    ((F.stalkMap y).hom.comp (U.1.ι.stalkMap (F y)).hom).comp φ
  have hρt : ∀ l, ρ' (t l) = e l * γ := by
    intro l
    show (F.stalkMap y).hom ((U.1.ι.stalkMap (F y)).hom (φ (t l))) = _
    rw [← H7 l]
    exact hstep l
  have hρh : ρ' h = 0 := by
    show (F.stalkMap y).hom ((U.1.ι.stalkMap (F y)).hom (φ h)) = 0
    rw [H3, map_zero, map_zero]
  have hA := s1 (P.presheaf.stalk y) ρ' γ e hρh hγ hρt
  have hρm : ∀ r ∈ IsLocalRing.maximalIdeal R,
      ρ' r ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk y) := by
    intro r hr
    have h1 : φ r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (U.1.ι (F y))) := by
      rw [← H4]; exact Ideal.mem_map_of_mem φ hr
    exact map_nonunit (F.stalkMap y).hom _ (map_nonunit (U.1.ι.stalkMap (F y)).hom _ h1)

  have hεc : e c = 1 := by
    show (Ψ.stalkMap y).hom (((wcProjK K m).presheaf.germ (wcSgD K m c) (Ψ y) hc).hom
      (wcSgE K m c c)) = 1
    rw [(wc_ldp_lnf_sec_quad K m c a).1, map_one, map_one]
  have htc : t c ∈ IsLocalRing.maximalIdeal R := by
    rw [H1]; exact Ideal.subset_span ⟨c, rfl⟩
  have hγm : γ ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk y) := by
    have h1 := hρm _ htc
    rw [hρt c, hεc, one_mul] at h1
    exact h1
  have hAm : ∑ p, ∑ q, ρ' (M p q) * e p * e q ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk y) :=
    (Ideal.span_singleton_le_iff_mem _).mpr hγm hA

  have hmor : F ≫ (U.1.ι ≫ fX) = Ψ ≫ wcProjKStr K m := by
    rw [hF, hΨ, Category.assoc, Category.assoc, Limits.pullback.condition]
  have hconst : ∀ r : K, (F.stalkMap y).hom ((U.1.ι.stalkMap (F y)).hom
      (wcLdpConst K fX (U.1.ι (F y)) r)) =
      (Ψ.stalkMap y).hom (wcLdpConst K (wcProjKStr K m) (Ψ y) r) := by
    intro r
    have e1 := RingHom.congr_fun (s3 U.1.ι fX (F y)) r
    have e2 := RingHom.congr_fun (s3 F (U.1.ι ≫ fX) y) r
    have e3 := RingHom.congr_fun (s3 Ψ (wcProjKStr K m) y) r
    rw [RingHom.comp_apply] at e1 e2 e3
    rw [e1, e2, e3, hmor]
  have hres : ∀ p q, ρ' (M p q) - (Ψ.stalkMap y).hom (wcLdpConst K (wcProjKStr K m) (Ψ y) (a p q)) ∈
      IsLocalRing.maximalIdeal (P.presheaf.stalk y) := by
    intro p q
    have h1 := hρm _ (H6 p q)
    rw [map_sub] at h1
    have h5 : φ (χ (a p q)) = wcLdpConst K fX (U.1.ι (F y)) (a p q) :=
      RingHom.congr_fun H5 (a p q)
    have h2 : ρ' (χ (a p q)) =
        (Ψ.stalkMap y).hom (wcLdpConst K (wcProjKStr K m) (Ψ y) (a p q)) := by
      show (F.stalkMap y).hom ((U.1.ι.stalkMap (F y)).hom (φ (χ (a p q)))) = _
      rw [h5, hconst]
    rwa [h2] at h1
  have hB : ∑ p, ∑ q, (Ψ.stalkMap y).hom (wcLdpConst K (wcProjKStr K m) (Ψ y) (a p q)) * e p * e q ∈
      IsLocalRing.maximalIdeal (P.presheaf.stalk y) := by
    have hdiff : ∑ p, ∑ q, ρ' (M p q) * e p * e q -
        ∑ p, ∑ q, (Ψ.stalkMap y).hom (wcLdpConst K (wcProjKStr K m) (Ψ y) (a p q)) * e p * e q ∈
        IsLocalRing.maximalIdeal (P.presheaf.stalk y) := by
      rw [← Finset.sum_sub_distrib]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [← Finset.sum_sub_distrib]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [← sub_mul, ← sub_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (hres p q))
    have h1 := Ideal.sub_mem _ hAm hdiff
    rwa [sub_sub_cancel] at h1
  have hsec : (Ψ.stalkMap y).hom (((wcProjK K m).presheaf.germ (wcSgD K m c) (Ψ y) hc).hom
      (wcLdpSec K m (wcLdpQuad K m a) c)) =
      ∑ p, ∑ q, (Ψ.stalkMap y).hom (wcLdpConst K (wcProjKStr K m) (Ψ y) (a p q)) * e p * e q := by
    rw [(wc_ldp_lnf_sec_quad K m c a).2]
    simp only [map_sum, map_mul]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    rw [wc_ldp_il_proj_const K m c (Ψ y) hc (a p q)]
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  have hu2 := hu.map (Ψ.stalkMap y).hom
  rw [hsec] at hu2
  exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hB)) hu2

theorem wc_beq_exceptional_embed : ∀ (K : Type u) [Field K] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of K)) (s : Spec (.of K) ⟶ X), s ≫ fX = 𝟙 _ →
    ∀ (U : X.Opens), s (IsLocalRing.closedPoint K) ∈ U →
    ∀ (m : ℕ) (P : Scheme.{u}) (ι : P ⟶ Limits.pullback (U.ι ≫ fX) (wcProjKStr K m))
      (Yb : Scheme.{u}) (r : Yb ⟶ X) (κ' : P ⟶ Yb),
    IsClosedImmersion ι → IsOpenImmersion κ' →
    κ' ≫ r = ι ≫ Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) ≫ U.ι →
    (∀ y : Yb, y ∈ Set.range κ' ↔ r y ∈ U) →
    ∀ (E : Scheme.{u}) (ιE : E ⟶ Yb), IsClosedImmersion ιE → IsReduced E →
    Set.range ιE = r ⁻¹' {s (IsLocalRing.closedPoint K)} →
    ∀ (E₀ : Scheme.{u}) (jE : E₀ ⟶ wcProjK K m), IsClosedImmersion jE → IsReduced E₀ →
    (∀ v, v ∈ Set.range jE ↔ ∃ y : P,
      U.ι ((ι ≫ Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m)) y) =
        s (IsLocalRing.closedPoint K) ∧
      (ι ≫ Limits.pullback.snd (U.ι ≫ fX) (wcProjKStr K m)) y = v) →
    ∃ iE : E₀ ⟶ Yb, IsClosedImmersion iE ∧ iE ≫ r ≫ fX = jE ≫ wcProjKStr K m ∧
      Set.range iE = Set.range ιE :=
by
  intro K _ X fX s hs U hpU m P ι Yb r κ' hι hκ' hcomm hrκ E ιE hιE hEred hE E₀ jE hjE
    hE₀red hset
  classical


  have factor : ∀ (W₁ X₁ Y₁ : Scheme.{u}) (g : W₁ ⟶ Y₁) (z : X₁ ⟶ Y₁) [IsClosedImmersion z]
      [IsReduced W₁], Set.range g ⊆ Set.range z → ∃ g' : W₁ ⟶ X₁, g' ≫ z = g := by
    intro W₁ X₁ Y₁ g z _ _ hrange
    have H : z.ker ≤ g.ker := by
      show z.ker ≤ Scheme.IdealSheafData.ofIdeals
        (fun U : Y₁.affineOpens => RingHom.ker (g.app U).hom)
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      have hz : (z.app U).hom s = 0 :=
        Scheme.IdealSheafData.ideal_ofIdeals_le
          (I := fun U : Y₁.affineOpens => RingHom.ker (z.app U).hom) U hs
      have hX : z ⁻¹ᵁ Y₁.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen]
        erw [hz]
        exact Scheme.basicOpen_zero _ _
      have hW : W₁.basicOpen ((g.app U).hom s) = ⊥ := by
        rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
        intro w hw
        obtain ⟨x, hx⟩ := hrange ⟨w, rfl⟩
        have hx' : x ∈ z ⁻¹ᵁ Y₁.basicOpen s := by
          show z x ∈ Y₁.basicOpen s
          rw [hx]; exact hw
        rw [hX] at hx'
        exact hx'.elim
      exact eq_zero_of_basicOpen_eq_bot _ hW
    exact ⟨IsClosedImmersion.lift z g H, IsClosedImmersion.lift_fac z g H⟩
  have hr : ∀ y : P, r (κ' y) =
      U.ι (Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) (ι y)) := by
    intro y
    have h1 : (κ' ≫ r) y =
        (ι ≫ Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) ≫ U.ι) y := by rw [hcomm]
    simpa only [Scheme.Hom.comp_apply] using h1

  have hsub : Set.range ιE ⊆ Set.range κ' := by
    intro x hx
    rw [hrκ]
    rw [hE] at hx
    have hx' : r x = s (IsLocalRing.closedPoint K) := hx
    rw [hx']; exact hpU
  obtain ⟨lam, hlam⟩ : ∃ lam : E ⟶ P, lam ≫ κ' = ιE :=
    ⟨IsOpenImmersion.lift κ' ιE hsub, IsOpenImmersion.lift_fac κ' ιE hsub⟩
  haveI : IsClosedImmersion (lam ≫ κ') := by rw [hlam]; infer_instance
  haveI : IsClosedImmersion lam := IsClosedImmersion.of_comp lam κ'
  have a1 : ∀ e : E, κ' (lam e) = ιE e := by
    intro e
    rw [← hlam, Scheme.Hom.comp_apply]

  have hsU : Set.range s ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
    exact hpU
  obtain ⟨sp, hsp⟩ : ∃ sp : Spec (.of K) ⟶ U.toScheme, sp ≫ U.ι = s :=
    ⟨IsOpenImmersion.lift U.ι s hsU, IsOpenImmersion.lift_fac U.ι s hsU⟩
  have hspg : sp ≫ (U.ι ≫ fX) = 𝟙 _ := by rw [← Category.assoc, hsp, hs]
  haveI : IsClosedImmersion sp := isClosedImmersion_of_comp_eq_id (U.ι ≫ fX) sp hspg
  have a3 : U.ι (sp (IsLocalRing.closedPoint K)) = s (IsLocalRing.closedPoint K) := by
    have := Scheme.Hom.comp_apply sp U.ι (IsLocalRing.closedPoint K)
    rw [hsp] at this
    exact this.symm
  obtain ⟨σ, hσs, hσf⟩ : ∃ σ : wcProjK K m ⟶ Limits.pullback (U.ι ≫ fX) (wcProjKStr K m),
      σ ≫ Limits.pullback.snd (U.ι ≫ fX) (wcProjKStr K m) = 𝟙 _ ∧
      σ ≫ Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) = wcProjKStr K m ≫ sp :=
    ⟨Limits.pullback.lift (wcProjKStr K m ≫ sp) (𝟙 _)
      (by rw [Category.assoc, hspg, Category.comp_id, Category.id_comp]),
      Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩
  have hPB : IsPullback σ (wcProjKStr K m)
      (Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m)) sp := by
    have outer : IsPullback (σ ≫ Limits.pullback.snd (U.ι ≫ fX) (wcProjKStr K m))
        (wcProjKStr K m) (wcProjKStr K m) (sp ≫ (U.ι ≫ fX)) := by
      rw [hσs, hspg]; exact IsPullback.id_horiz _
    exact IsPullback.of_right outer hσf (IsPullback.of_hasPullback _ _).flip
  haveI : IsClosedImmersion σ :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hPB.flip ‹IsClosedImmersion sp›
  have hσr : ∀ w, w ∈ Set.range σ ↔
      Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) w = sp (IsLocalRing.closedPoint K) := by
    intro w
    constructor
    · rintro ⟨v, rfl⟩
      rw [← Scheme.Hom.comp_apply, hσf, Scheme.Hom.comp_apply]
      congr 1
      exact Subsingleton.elim _ _
    · intro hw
      have hmem : w ∈ Set.range
          (Limits.pullback.snd sp (Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m))) := by
        rw [Scheme.Pullback.range_snd]; exact ⟨_, hw.symm⟩
      obtain ⟨q, rfl⟩ := hmem
      obtain ⟨v, hv⟩ := hPB.flip.isoPullback.hom.surjective q
      refine ⟨v, ?_⟩
      rw [← hv, ← Scheme.Hom.comp_apply, IsPullback.isoPullback_hom_snd]

  have hψ0 : ∀ e : E, Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) (ι (lam e)) =
      sp (IsLocalRing.closedPoint K) := by
    intro e
    apply U.ι.isOpenEmbedding.injective
    have a2 : r (ιE e) = s (IsLocalRing.closedPoint K) := by
      have : ιE e ∈ Set.range ιE := ⟨e, rfl⟩
      rw [hE] at this; exact this
    rw [← hr, a1, a2, a3]
  have hrng0 : Set.range (lam ≫ ι) ⊆ Set.range σ := by
    rintro _ ⟨e, rfl⟩
    rw [hσr, Scheme.Hom.comp_apply]; exact hψ0 e

  obtain ⟨ψ, hψ⟩ := factor E _ _ (lam ≫ ι) σ hrng0
  have hψeq : ψ = lam ≫ ι ≫ Limits.pullback.snd (U.ι ≫ fX) (wcProjKStr K m) := by
    rw [← Category.assoc, ← hψ, Category.assoc, hσs, Category.comp_id]
  haveI : IsClosedImmersion (ψ ≫ σ) := by rw [hψ]; infer_instance
  haveI : IsClosedImmersion ψ := IsClosedImmersion.of_comp ψ σ

  have hψr : Set.range ψ = Set.range jE := by
    ext v
    rw [hset v]
    constructor
    · rintro ⟨e, rfl⟩
      refine ⟨lam e, ?_, ?_⟩
      · rw [Scheme.Hom.comp_apply, hψ0 e, a3]
      · rw [hψeq]; simp only [Scheme.Hom.comp_apply]
    · rintro ⟨y, hy, rfl⟩
      have hκy : κ' y ∈ Set.range ιE := by
        rw [hE]
        show r (κ' y) = _
        rw [hr, ← hy, Scheme.Hom.comp_apply]
      obtain ⟨e, he⟩ := hκy
      have hey : lam e = y := κ'.isOpenEmbedding.injective (by rw [a1]; exact he)
      exact ⟨e, by rw [hψeq, ← hey]; simp only [Scheme.Hom.comp_apply]⟩

  obtain ⟨f, hf⟩ := factor E₀ E _ jE ψ hψr.symm.subset
  obtain ⟨f', hf'⟩ := factor E E₀ _ ψ jE hψr.subset
  have h1 : f ≫ f' = 𝟙 _ := by
    rw [← cancel_mono jE, Category.assoc, hf', hf, Category.id_comp]
  have h2 : f' ≫ f = 𝟙 _ := by
    rw [← cancel_mono ψ, Category.assoc, hf, hf', Category.id_comp]
  haveI : IsIso f := ⟨f', h1, h2⟩

  refine ⟨f ≫ ιE, inferInstance, ?_, ?_⟩
  · rw [← hlam]
    calc (f ≫ lam ≫ κ') ≫ r ≫ fX = f ≫ lam ≫ (κ' ≫ r) ≫ fX := by
          simp only [Category.assoc]
      _ = f ≫ lam ≫ ι ≫ Limits.pullback.fst (U.ι ≫ fX) (wcProjKStr K m) ≫ (U.ι ≫ fX) := by
          rw [hcomm]; simp only [Category.assoc]
      _ = f ≫ lam ≫ ι ≫ Limits.pullback.snd (U.ι ≫ fX) (wcProjKStr K m) ≫ wcProjKStr K m := by
          rw [Limits.pullback.condition]
      _ = jE ≫ wcProjKStr K m := by
          rw [← hf, hψeq]; simp only [Category.assoc]
  · ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨f y, by rw [Scheme.Hom.comp_apply]⟩
    · rintro ⟨e, rfl⟩
      obtain ⟨y, rfl⟩ := f.surjective e
      exact ⟨y, by rw [Scheme.Hom.comp_apply]⟩

theorem wc_odp_blowup_exceptional_connected : ∀ (K : Type u) [Field K] [IsAlgClosed K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [IsProper fP] (xb : P) (hxb : IsClosed ({xb} : Set P)) (n : ℕ), 3 ≤ n →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin n → R) (h : R)
      (M : Matrix (Fin n) (Fin n) R) (χ : K →+* R) (φ : R →+* P.presheaf.stalk xb)
      (a : Fin n → Fin n → K),
    ringKrullDim R = n →
    IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    h - ∑ p, ∑ c, M p c * t p * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
    IsUnit (M + M.transpose).det →
    Function.Surjective φ → RingHom.ker φ = Ideal.span {h} →
    Ideal.map φ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal (P.presheaf.stalk xb) →
    φ.comp χ = wcLdpConst K fP xb →
    (∀ y : R, ∃ c : K, y - χ c ∈ IsLocalRing.maximalIdeal R) →
    (∀ p c, M p c - χ (a p c) ∈ IsLocalRing.maximalIdeal R) →
    (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 →
    ∀ (Yb : Scheme.{u}) (r : Yb ⟶ P) [IsProper r],
      wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)) r →
      IsReduced ((Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap r).subscheme →
      ConnectedSpace ((Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap r).subscheme :=
by
  classical
  intro K _ _ P fP _ xb hxb n hn3 R _ _ _ t h M χ φ a hdim hmax hcub hdet hsurj hker hmapm hφχ hres
    haM ha Yb r _ hbl hred
  obtain ⟨d, rfl⟩ : ∃ d, n = d + 1 + 1 := ⟨n - 2, by omega⟩
  obtain ⟨E₀, hpr, hsm, jE, hjE, hjEY, hEG, hEall⟩ := wc_smooth_quadric_hypersurface K d a ha

  have hgermE : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hc : jE x ∈ wcSgD K (d + 1) c),
      ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (jE x) hc).hom
          (wcLdpSec K (d + 1) (wcLdpQuad K (d + 1) a) c) ∈
        IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk (jE x)) := by
    intro x c hc
    have h4 := hEG x c hc
    have h5 : (jE.stalkMap x).hom
        (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (jE x) hc).hom
          (wcLdpSec K (d + 1) (wcLdpQuad K (d + 1) a) c)) ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x) := by
      rw [Scheme.Hom.germ_stalkMap_apply]
      exact h4
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h5 ⊢
    exact fun hu => h5 (hu.map _)

  haveI := wc_proj_space_irreducible K (d + 1)
  haveI := wc_proj_space_smooth K (d + 1)
  have hQ := wc_ldp_quadric_section_connected K (d + 1) (d + 1) (by omega) (wcProjK K (d + 1))
    (wcProjKStr K (d + 1)) (𝟙 _) inferInstance (Category.id_comp _) (wcLdpQuad K (d + 1) a)
  have hset1 : Set.range jE =
      {w : wcProjK K (d + 1) | wcLdpZero K (d + 1) (𝟙 _) (wcLdpQuad K (d + 1) a) w} := by
    ext v
    constructor
    · rintro ⟨x, rfl⟩
      exact fun c hc => hgermE x c hc
    · intro hv
      exact hEall v (fun c hc => hv c hc)
  rw [← hset1] at hQ
  haveI : ConnectedSpace ↥(Set.range jE) := isConnected_iff_connectedSpace.mp hQ
  haveI := hjE
  haveI hE₀c : ConnectedSpace E₀.left :=
    (jE.isClosedEmbedding.isEmbedding.toHomeomorph).symm.surjective.connectedSpace
      (jE.isClosedEmbedding.isEmbedding.toHomeomorph).symm.continuous

  haveI := hsm
  haveI : ∀ x : E₀.left, _root_.IsReduced (E₀.left.presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain K E₀.left E₀.hom d x
    infer_instance
  have hE₀red : AlgebraicGeometry.IsReduced E₀.left := isReduced_of_isReduced_stalk E₀.left

  haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian fP
  obtain ⟨⟨s, hs, hspt⟩, -⟩ := wc_ldp_cf_rational_point K fP xb hxb
  have hspan : Ideal.span (Set.range (fun b => φ (t b))) =
      IsLocalRing.maximalIdeal (P.presheaf.stalk xb) := by
    rw [← hmapm, hmax, Ideal.map_span, ← Set.range_comp]
    rfl
  obtain ⟨U, hp, g, hg, hIU⟩ := wc_beq_point_generators P inferInstance xb
    (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P) rfl (d + 1 + 1) (fun b => φ (t b)) hspan
  obtain ⟨P', ι, κ', hι, hκ', hcomm, hrange, hbl', hIdeal, hrel⟩ :=
    wc_beq_affine_blowup_model K P fP inferInstance
      (Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)) U (d + 1) g
      hIU Yb r hbl
  have hφh : φ h = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self h
  have hset : ∀ v : wcProjK K (d + 1), v ∈ Set.range jE ↔ ∃ y : P',
      U.1.ι ((ι ≫ Limits.pullback.fst (U.1.ι ≫ fP) (wcProjKStr K (d + 1))) y) = xb ∧
      (ι ≫ Limits.pullback.snd (U.1.ι ≫ fP) (wcProjKStr K (d + 1))) y = v := by
    intro v
    constructor
    · rintro ⟨x, rfl⟩
      exact wc_beq_quadric_in_fibre K P fP
        (Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)) U xb hp
        (d + 1) g P' ι hι hIdeal hbl' hrel R t h M χ φ a hdim hmax hcub hdet hsurj hker hmapm hφχ
        hres haM hg (jE x) (hgermE x)
    · rintro ⟨y, hy, rfl⟩
      apply hEall
      intro c hc
      exact wc_beq_fibre_in_quadric K P fP U xb hp (d + 1) g P' ι hι hrel R t h M χ φ a hmax hcub
        hφh hmapm hφχ haM hg y hy c hc
  have hrangeE : Set.range ((Scheme.IdealSheafData.vanishingIdeal
      (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap r).subschemeι = r ⁻¹' {xb} := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap]
    show r ⁻¹' ((Scheme.IdealSheafData.vanishingIdeal
      (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).support : Set P) = _
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hp' : s (IsLocalRing.closedPoint K) ∈ U.1 := by rw [hspt]; exact hp
  have hrangeE' : Set.range ((Scheme.IdealSheafData.vanishingIdeal
      (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap r).subschemeι =
      r ⁻¹' {s (IsLocalRing.closedPoint K)} := by rw [hspt]; exact hrangeE
  have hset' : ∀ v : wcProjK K (d + 1), v ∈ Set.range jE ↔ ∃ y : P',
      U.1.ι ((ι ≫ Limits.pullback.fst (U.1.ι ≫ fP) (wcProjKStr K (d + 1))) y) =
        s (IsLocalRing.closedPoint K) ∧
      (ι ≫ Limits.pullback.snd (U.1.ι ≫ fP) (wcProjKStr K (d + 1))) y = v := by
    intro v; rw [hspt]; exact hset v
  obtain ⟨iE, hiE, -, hrng⟩ := wc_beq_exceptional_embed K P fP s hs U.1 hp' (d + 1) P' ι Yb r κ'
    hι hκ' hcomm hrange _ ((Scheme.IdealSheafData.vanishingIdeal
      (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap r).subschemeι inferInstance hred hrangeE'
    E₀.left jE hjE hE₀red hset'

  have hc1 : _root_.IsConnected (Set.range iE) := isConnected_range iE.continuous
  rw [hrng] at hc1
  haveI := isConnected_iff_connectedSpace.mp hc1
  exact ((Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap
      r).subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph.symm.surjective.connectedSpace
    ((Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P)).comap
      r).subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph.symm.continuous

theorem wc_pmn_tsl_odp_fibre_blowup (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
    (hxs : Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) xs = x)
    (h4 : 4 ≤ n) :
    ∃ (Xt E : Scheme.{u})
      (b : Xt ⟶ Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (iE : E ⟶ Xt),
      IsProper b ∧ IsClosedImmersion iE ∧
      (∀ U : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens,
        (U : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)))
          = {xs}ᶜ → IsIso (b ∣_ U)) ∧
      Set.range iE = b ⁻¹' {xs} ∧
      SmoothOfRelativeDimension (n - 1)
        (b ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
      SmoothOfRelativeDimension (n - 1 - 1)
        (iE ≫ b ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ∧
      IrreducibleSpace Xt ∧ IrreducibleSpace E :=
by
  classical
  have hgeom := wc_pmn_vp_node_point_geom F' F'' Y n D i V A e x hx₁ hx₂ xs hxs
  have hcl := hgeom.1
  haveI hac : IsAlgClosed (IsLocalRing.ResidueField A) :=
    wc_pmn_odp_residue_algClosed F'' (D.S i) (D.hS i) V A e hV
  have hbasic := wc_pmn_odp_fibre_basic F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs
  haveI hprop := hbasic.1
  haveI hXconn := hbasic.2.1
  obtain ⟨O, hO, -, hsmO⟩ := hbasic.2.2.2

  obtain ⟨R, _, _, _, t, h, M, χ, φ, hdim, hmax, hcub, hdet, hsurj, hker, hmapm, hφχ, hres⟩ :=
    wc_pmn_tsl_odp_fibre_stalk_datum F' F'' Y n hn2 D i V A e hV x hx₁ hx₂ xs hxs

  obtain ⟨a, haM⟩ : ∃ a : Fin n → Fin n → IsLocalRing.ResidueField A,
      ∀ p c, M p c - χ (a p c) ∈ IsLocalRing.maximalIdeal R := by
    choose a ha using fun p c => hres (M p c)
    exact ⟨a, ha⟩
  have hadet : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 := by
    intro h0
    have hent : ∀ p c, IsLocalRing.residue R (M p c) = IsLocalRing.residue R (χ (a p c)) := by
      intro p c
      have h1 := (IsLocalRing.residue_eq_zero_iff _).mpr (haM p c)
      rw [map_sub, sub_eq_zero] at h1
      exact h1
    have hmat : (M + M.transpose).map (IsLocalRing.residue R) =
        (Matrix.of a + (Matrix.of a).transpose).map ((IsLocalRing.residue R).comp χ) := by
      ext p c
      simp only [Matrix.map_apply, Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply,
        map_add, RingHom.comp_apply, hent]
    have h1 : IsLocalRing.residue R (M + M.transpose).det =
        ((IsLocalRing.residue R).comp χ) (Matrix.of a + (Matrix.of a).transpose).det := by
      rw [RingHom.map_det, RingHom.map_det, RingHom.mapMatrix_apply, RingHom.mapMatrix_apply, hmat]
    rw [h0, map_zero] at h1
    exact (hdet.map (IsLocalRing.residue R)).ne_zero h1

  set I := Scheme.IdealSheafData.vanishingIdeal
    (⟨{xs}, hcl⟩ : TopologicalSpace.Closeds ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) with hI
  obtain ⟨Xt, r, hbl, hrp⟩ := wc_odp_blowup_proper (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) I
  haveI := hrp

  obtain ⟨hsmX, hsmE⟩ := wc_odp_point_blowup_smooth_pair (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) n xs hcl O hO hsmO hn2
    R t h M hdim hmax hcub hdet
    ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hker)⟩ Xt r hbl
  haveI := hsmX
  haveI := hsmE

  haveI hstred : ∀ z : (I.comap r).subscheme,
      _root_.IsReduced ((I.comap r).subscheme.presheaf.stalk z) := by
    intro z
    haveI := wcpa_smooth_stalk_isDomain (IsLocalRing.ResidueField A) _
      ((I.comap r).subschemeι ≫ r ≫
        Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) (n - 1 - 1) z
    infer_instance
  have hred : IsReduced (I.comap r).subscheme := isReduced_of_isReduced_stalk _

  haveI hEconn : ConnectedSpace (I.comap r).subscheme :=
    wc_odp_blowup_exceptional_connected (IsLocalRing.ResidueField A) _
      (Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) xs hcl n (by omega)
      R t h M χ φ a hdim hmax hcub hdet hsurj hker hmapm hφχ hres haM hadet Xt r hbl hred

  have hIsupp : (I.support : Set ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) = {xs} :=
    Scheme.IdealSheafData.coe_support_vanishingIdeal _
  have hrange : Set.range (I.comap r).subschemeι = r ⁻¹' {xs} := by
    ext y
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap]
    change r y ∈ (I.support : Set _) ↔ _
    rw [hIsupp]
    rfl
  have hiso : ∀ U : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens,
      (U : Set ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (wcQmSp A))) = {xs}ᶜ → IsIso (r ∣_ U) := by
    intro U hU
    exact wc_csd_blowup_iso_off_center _ Xt I r U hbl
      (by rw [hIsupp, hU]; exact Set.inter_compl_self _)

  have hXtconn : ConnectedSpace Xt := by
    let O' : (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens :=
      ⟨{xs}ᶜ, hcl.isOpen_compl⟩
    haveI hisoO : IsIso (r ∣_ O') := hiso O' rfl
    have hval : ∀ w : (r ⁻¹ᵁ O' : Xt.Opens), Subtype.val ((r ∣_ O').homeomorph w) = r w.1 := by
      intro w
      exact (congrArg Subtype.val (Scheme.Hom.homeomorph_apply (r ∣_ O') w)).trans
        (morphismRestrict_base_coe r O' w)
    have hfib : ∀ y, _root_.IsConnected (r ⁻¹' {y}) := by
      intro y
      by_cases hy : y = xs
      · rw [hy, ← hrange]
        exact isConnected_range (I.comap r).subschemeι.continuous
      · obtain ⟨w, hw⟩ := (r ∣_ O').homeomorph.surjective ⟨y, hy⟩
        have hw' : r w.1 = y := (hval w).symm.trans (congrArg Subtype.val hw)
        have hpre : r ⁻¹' {y} = {w.1} := by
          ext z
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          constructor
          · intro hz
            have hzO : z ∈ (r ⁻¹ᵁ O' : Xt.Opens) := by
              change r z ∈ ({xs}ᶜ : Set _)
              rw [hz]
              exact hy
            have key : (r ∣_ O').homeomorph ⟨z, hzO⟩ = (r ∣_ O').homeomorph w := by
              apply Subtype.ext
              exact (hval ⟨z, hzO⟩).trans ((hz.trans hw'.symm).trans (hval w).symm)
            exact congrArg Subtype.val ((r ∣_ O').homeomorph.injective key)
          · rintro rfl
            exact hw'
        rw [hpre]
        exact isConnected_singleton
    have hsurjr : Function.Surjective r := fun y => by
      obtain ⟨z, hz⟩ := (hfib y).nonempty
      exact ⟨z, hz⟩
    have hq : Topology.IsQuotientMap r :=
      IsClosedMap.isQuotientMap r.isClosedMap r.continuous hsurjr
    rw [connectedSpace_iff_univ]
    have h3 := hq.isCoinducing.isConnected_preimage_of_isClosed hfib isClosed_univ isConnected_univ
    simpa using h3
  haveI := hXtconn

  haveI := SmoothOfRelativeDimension.smooth (n - 1)
    (r ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
  haveI := SmoothOfRelativeDimension.smooth (n - 1 - 1)
    ((I.comap r).subschemeι ≫ r ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))
  have hirrX := wc_smooth_algclosed_connected_irreducible (IsLocalRing.ResidueField A) Xt
    (r ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
  have hirrE := wc_smooth_algclosed_connected_irreducible (IsLocalRing.ResidueField A) _
    ((I.comap r).subschemeι ≫ r ≫ Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (wcQmSp A))
  exact ⟨Xt, (I.comap r).subscheme, r, (I.comap r).subschemeι, hrp, inferInstance, hiso, hrange,
    hsmX, hsmE, hirrX, hirrE⟩

theorem wc_et_supp_unit_ext_transfer : ∀ {Y Z : Scheme.{u}} (ι : Z ⟶ Y) [IsClosedImmersion ι] (m : ℕ) (D : wcEtPullData ι m), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _; ∃ (T : ∀ p : ℕ, wcEtZModExt Z m p →+ Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppObj D) p) (M : ∀ r : ℕ, wcEtZModExt Z m r → Abelian.Ext (wcEtSuppObj D) (wcEtSuppObj D) r), (∀ p : ℕ, Function.Bijective (T p)) ∧ ∀ (p r s : ℕ) (h : p + r = s) (c : wcEtZModExt Z m p) (w : wcEtZModExt Z m r), (T p c).comp (M r w) h = T s (wcEtZModCup Z m p r s h c w) :=
by
  intro Y Z ι _ m D
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  let P : SheafOfModules.{u+1} (wcEtZModRing Z m) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y m) :=
    @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange ι) _ _ D.cont D.φ
  haveI : P.Additive := D.adj.right_adjoint_additive
  haveI : Limits.PreservesFiniteLimits P := by
    letI := D.adj.rightAdjoint_preservesLimits
    exact (inferInstance : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange ι) _ _ D.cont D.φ))
  haveI : IsFinite ι := inferInstance
  haveI : Limits.PreservesFiniteColimits P := wc_et_finite_push_modules_exact ι m D
  haveI : D.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape D.Φ
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Z m)) :=
    sheafOfModules_enoughInjectives _ _
  have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Z m), Function.Bijective
      (fun f : SheafOfModules.unit (wcEtZModRing Z m) ⟶ M => wcEtSuppUnitMap D ≫ P.map f) := by
    intro M
    have e : (fun f : SheafOfModules.unit (wcEtZModRing Z m) ⟶ M => wcEtSuppUnitMap D ≫ P.map f) =
        (D.adj.homEquiv _ M) ∘ (fun f => D.μ.hom ≫ f) := by
      funext f
      rw [Function.comp_apply, Adjunction.homEquiv_unit, Functor.map_comp]
      exact Category.assoc _ _ _
    rw [e]
    refine (Equiv.bijective _).comp ?_
    rw [Function.bijective_iff_has_inverse]
    exact ⟨fun g => D.μ.inv ≫ g, fun f => by simp, fun g => by simp⟩
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Z m)) [Injective I] (n : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (P.obj I) (n + 1)), e = 0 := by
    intro I _ n e
    haveI : Injective (P.obj I) := Injective.injective_of_adjoint D.adj I
    exact Abelian.Ext.eq_zero_of_injective e
  have key := ext_transfer_of_corep P (SheafOfModules.unit (wcEtZModRing Z m))
    (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppUnitMap D) hhom hvan
    (SheafOfModules.unit (wcEtZModRing Z m))
  refine ⟨fun p => AddMonoidHom.mk'
      (fun c : wcEtZModExt Z m p => (Abelian.Ext.mk₀ (@id (SheafOfModules.unit (wcEtZModRing Y m) ⟶
          P.obj (SheafOfModules.unit (wcEtZModRing Z m))) (wcEtSuppUnitMap D))).comp
        (Abelian.Ext.mapExactFunctor P c) (zero_add p))
      (fun a b => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]
        try rfl),
    fun r (w : wcEtZModExt Z m r) => Abelian.Ext.mapExactFunctor P w,
    fun p => key p, ?_⟩
  intro p r s h c w
  have hc : (Abelian.Ext.mapExactFunctor P c).comp (Abelian.Ext.mapExactFunctor P w) h =
      Abelian.Ext.mapExactFunctor P ((c : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z m))
        (SheafOfModules.unit (wcEtZModRing Z m)) p).comp w h) := by
    rw [Abelian.Ext.mapExactFunctor_comp]
  exact (Abelian.Ext.comp_assoc _ _ _ (zero_add p) h (by omega)).trans
    (congrArg (fun z => (Abelian.Ext.mk₀ (@id (SheafOfModules.unit (wcEtZModRing Y m) ⟶
      P.obj (SheafOfModules.unit (wcEtZModRing Z m))) (wcEtSuppUnitMap D))).comp z
        (zero_add s)) hc)

theorem wc_et_blowup_kernel_push_lift : ∀ {Y X' Z : Scheme.{u}} (b : X' ⟶ Y) (iZ : Z ⟶ Y) [IsClosedImmersion iZ] (m : ℕ) (D : wcEtPullData b m) (DZ : wcEtPullData iZ m) (DE : wcEtPullData (Limits.pullback.fst b iZ) m), ∃ κ : Limits.kernel (wcEtSuppUnitMap DZ) ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj (Limits.kernel (wcEtSuppUnitMap DE)), κ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map (Limits.kernel.ι (wcEtSuppUnitMap DE)) = Limits.kernel.ι (wcEtSuppUnitMap DZ) ≫ wcEtSuppUnitMap D :=
by
  classical
  intro Y X' Z b iZ _ m D DZ DE
  haveI := D.additive
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI hPlim : Limits.PreservesLimitsOfSize.{0, 0}
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ) :=
    D.adj.rightAdjoint_preservesLimits

  have key : ∀ (V : Scheme.{u}) (h : V ⟶ Y), IsEmpty ↥(Limits.pullback (C := Scheme.{u}) h iZ) →
      ∀ x : ↥(Limits.pullback (C := Scheme.{u}) h b),
        Limits.pullback.snd h b x ∉ Set.range (Limits.pullback.fst b iZ) := by
    intro V h hE x hx
    obtain ⟨e, he⟩ := hx
    have h1 : h (Limits.pullback.fst h b x) = b (Limits.pullback.snd h b x) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    have h2 : b (Limits.pullback.fst b iZ e) = iZ (Limits.pullback.snd b iZ e) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    obtain ⟨p, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := h) (g := iZ) _ _
      (h1.trans ((congrArg b he.symm).trans h2))
    exact hE.false p
  have hpt : ∀ U : Y.Etale, IsEmpty ((wcEtBaseChange iZ).obj U).left →
      ∀ w : ((wcEtBaseChange b).obj U).left,
        ((wcEtBaseChange b).obj U).hom w ∉ Set.range (Limits.pullback.fst b iZ) := by
    intro U hU w
    exact key U.left U.hom hU w
  obtain ⟨u', hu'⟩ : ∃ u' : SheafOfModules.unit (wcEtZModRing Y m) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing X' m)), u' = wcEtSuppUnitMap D :=
    ⟨wcEtSuppUnitMap D, rfl⟩
  have hvan : Limits.kernel.ι (wcEtSuppUnitMap DZ) ≫ (u' ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
        (wcEtSuppUnitMap DE)) = 0 := by
    apply wc_et_supp_unit_ker_kill_of_vanish iZ DZ
    intro U hU
    haveI hsub := wc_et_closed_supp_obj_vanish (Limits.pullback.fst b iZ) m DE
      ((wcEtBaseChange b).obj U) (hpt U hU)
    exact @Subsingleton.elim _ hsub _ _
  have hw0 : (Limits.kernel.ι (wcEtSuppUnitMap DZ) ≫ u') ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ).map
        (wcEtSuppUnitMap DE) = 0 := by
    rw [Category.assoc]
    exact hvan
  refine ⟨Limits.kernel.lift _ _ hw0 ≫ (Limits.PreservesKernel.iso
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont D.φ)
    (wcEtSuppUnitMap DE)).inv, ?_⟩
  rw [Category.assoc, Limits.PreservesKernel.iso_inv_ι, Limits.kernel.lift_ι]
  subst hu'
  rfl

theorem wc_et_blowup_kernel_unit_mono : ∀ {Y X' Z : Scheme.{u}} (b : X' ⟶ Y) (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ (m : ℕ) (D : wcEtPullData b m) (DZ : wcEtPullData iZ m), Mono (Limits.kernel.ι (wcEtSuppUnitMap DZ) ≫ wcEtSuppUnitMap D) :=
by
  intro Y X' Z b iZ _ hiso m D DZ
  classical

  have hcover : ∀ y : Y, y ∈ Set.range iZ ∨ y ∈ Set.range b := by
    intro y
    by_cases hy : y ∈ Set.range iZ
    · exact Or.inl hy
    · right
      let U : Y.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      haveI : IsIso (b ∣_ U) := hiso U rfl
      obtain ⟨x'', hx''⟩ := (Scheme.Hom.homeomorph (b ∣_ U)).surjective (⟨y, hy⟩ : U)
      refine ⟨(b ⁻¹ᵁ U).ι x'', ?_⟩
      have h1 := congrArg (fun φ => φ x'') (morphismRestrict_ι b U)
      simp only [Scheme.Hom.comp_apply] at h1
      rw [← h1, ← Scheme.Hom.homeomorph_apply (b ∣_ U) x'', hx'']
      rfl
  have locbij : ∀ (S : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α := by
    intro S n
    let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    exact ⟨toSheafify (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S) P⟩
  have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
      ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
    intro S V R h x
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
    exact ⟨Y, f, y, h1, h3⟩
  have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology S V := by
    intro S V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _
  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨x⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj⟩ := locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3
  have hsepY : Presheaf.IsSeparated (Scheme.smallEtaleTopology Y) (wcEtZModRing Y m).obj :=
    Sheaf.isSeparated (wcEtZModRing Y m)
  have hemptyY : ∀ (Q : Y.Etale), IsEmpty Q.left →
      ∀ a c : ↑((wcEtZModRing Y m).obj.obj (Opposite.op Q)), a = c := by
    intro Q hQ a c
    exact hsepY Q ⊥ (hcov Y Q ⊥ (fun v => isEmptyElim v)) a c (fun _ _ h => False.elim h)

  have core : ∀ (V : Y.Etale) (k : ↑((wcEtZModRing Y m).obj.obj (Opposite.op V))),
      ((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom k = 0 →
      ((wcEtSuppUnitMap DZ).val.app (Opposite.op V)).hom k = 0 → k = 0 := by
    intro V k hu hρ
    have hφD : (D.φ.hom.app (Opposite.op V)).hom k = 0 := by
      obtain ⟨e', he'⟩ := twist D
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom k) he'
      change (e'.val.app (Opposite.op ((wcEtBaseChange b).obj V))).hom
        (((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom k) =
        (D.φ.hom.app (Opposite.op V)).hom k at h2
      rw [hu] at h2
      exact h2.symm.trans (LinearMap.map_zero _)
    have hφZ : (DZ.φ.hom.app (Opposite.op V)).hom k = 0 := by
      obtain ⟨e', he'⟩ := twist DZ
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom k) he'
      change (e'.val.app (Opposite.op ((wcEtBaseChange iZ).obj V))).hom
        (((wcEtSuppUnitMap DZ).val.app (Opposite.op V)).hom k) =
        (DZ.φ.hom.app (Opposite.op V)).hom k at h2
      rw [hρ] at h2
      exact h2.symm.trans (LinearMap.map_zero _)
    obtain ⟨α, -, hαs⟩ := locbij Y m
    refine hsepY V _ (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α k) k 0
      (fun V' g hg => ?_)
    have h0 : ((wcEtZModRing Y m).obj.map g.op).hom
        (0 : ↑((wcEtZModRing Y m).obj.obj (Opposite.op V))) = 0 := map_zero _
    refine Eq.trans ?_ h0.symm
    obtain ⟨c, hc⟩ := hg
    have hk' : ((wcEtZModRing Y m).obj.map g.op).hom k =
        ((c.down.cast : ℤ) : ↑((wcEtZModRing Y m).obj.obj (Opposite.op V'))) :=
      hc.symm.trans (intcast_eq Y m V' α c)
    have hnatD := congrArg (fun h => h.hom k) (D.φ.hom.naturality g.op)
    simp only [RingCat.hom_comp, RingHom.comp_apply] at hnatD
    rw [hφD, map_zero, hk', map_intCast] at hnatD
    have hnatZ := congrArg (fun h => h.hom k) (DZ.φ.hom.naturality g.op)
    simp only [RingCat.hom_comp, RingHom.comp_apply] at hnatZ
    rw [hφZ, map_zero, hk', map_intCast] at hnatZ
