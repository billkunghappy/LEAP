  have tC5 : ∀ (A : Type u) [CommRing A]
    (ha : IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))})
    (hb : ∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y)
    (m : Ideal A) [hm : m.IsMaximal] (s : A) (hs : s ∉ m),
