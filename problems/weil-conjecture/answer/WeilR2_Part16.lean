          apply (hτ (k + 1)).1
          rw [hcomm, hg]
    let c : (K.cycles q).val.obj (Opposite.op W) →+
        Abelian.Ext A (SheafOfModules.unit (wcRingSheaf X ℓ)) q :=
      AddMonoidHom.mk' (fun z => I.extMk (τ q (((K.iCycles q).val.app (Opposite.op W)).hom z))
          (q + 1) rfl (hz z))
        (by
          intro a b
