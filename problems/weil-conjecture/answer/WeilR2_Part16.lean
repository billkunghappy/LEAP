      (hεval W')
    exact @ext_slice_restriction_chase _ _ _ (hE S) _ _ _ (hE W.left) _ _ _ (hE W'.left)
      (wcSliceRes S ℓ W)
      (wcSliceRes W.left ℓ (Scheme.ProEt.mk b.left)) (wcSliceRes S ℓ W') Db.Φ
      (wc_slice_res_exact S ℓ W).1 (wc_slice_res_exact S ℓ W).2.1 (wc_slice_res_exact S ℓ W).2.2
      (wc_slice_res_exact W.left ℓ (Scheme.ProEt.mk b.left)).1
      (wc_slice_res_exact W.left ℓ (Scheme.ProEt.mk b.left)).2.1
