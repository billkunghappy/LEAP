    have hc : ∀ z, c z = I.extMk (τ q (((K.iCycles q).val.app (Opposite.op W)).hom z))
        (q + 1) rfl (hz z) := fun z => rfl
    have hker' : ∀ z, ((K.homologyπ q).val.app (Opposite.op W)).hom z = 0 ↔ c z = 0 := by
      intro z; rw [hc]; exact hker z
    have hcs : Function.Surjective c := by
