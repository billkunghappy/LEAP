  have hom_inv_apply : ∀ {A B : CommRingCat.{u}} (φ : A ≅ B) (x : A),
      φ.inv.hom (φ.hom.hom x) = x := by
    intro A B φ x
    exact congrArg (fun f : A ⟶ A => f.hom x) φ.hom_inv_id
  have inv_hom_apply : ∀ {A B : CommRingCat.{u}} (φ : A ≅ B) (x : B),
      φ.hom.hom (φ.inv.hom x) = x := by
    intro A B φ x
    exact congrArg (fun f : B ⟶ B => f.hom x) φ.inv_hom_id
  have isoIdeal : ∀ {A B : CommRingCat.{u}} (φ : A ≅ B) (J : Ideal A),
      Ideal.map φ.hom.hom J = Ideal.comap φ.inv.hom J := by
    intro A B φ J
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      show φ.inv.hom (φ.hom.hom x) ∈ J
      rw [hom_inv_apply]
      exact hx
    · intro x hx
      rw [← inv_hom_apply φ x]
      exact Ideal.mem_map_of_mem _ hx

  have s2 : ∀ (T : Scheme.{u}) (g : T ⟶ X) (O : X.Opens), wcCsdInvPull I g → ∀ t : T, g t ∈ O →
      ∃ (U : X.affineOpens) (V : T.affineOpens) (hVU : V.1 ≤ g ⁻¹ᵁ U.1) (a : Γ(X, U.1)),
        U.1 ≤ O ∧ t ∈ V.1 ∧ a ∈ I.ideal U ∧
