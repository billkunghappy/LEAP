theorem wc_slice_zm_terminal_iso (S : Scheme.{u}) (U : S.ProEt) (N : ℕ) (hN : 0 < N) :
    Nonempty (Limits.cokernel (N • 𝟙 ((presheafToSheaf ((Scheme.ProEt.topology S).over U)
          AddCommGrpCat.{u+1}).obj (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free))) ≅
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
        (wcContSheaf S (Fin 1 → ZMod N))) ∧
    N • 𝟙 (wcContSheaf S (Fin 1 → ZMod N)) = 0 :=
by
  classical
  haveI : NeZero N := NeZero.of_pos hN

  have hns : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      {F G : Sheaf J AddCommGrpCat.{u+1}} (n : ℕ) (f : F ⟶ G) (X : Cᵒᵖ) (x : F.obj.obj X),
      ((n • f).hom.app X).hom x = n • (f.hom.app X).hom x := by
    intro C _ J F G n f X x
    have h1 : (n • f).hom = n • f.hom := (sheafToPresheaf J AddCommGrpCat.{u+1}).map_nsmul
    rw [h1, NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply]

  let T : Over U := Over.mk (𝟙 U)
  let P₀ : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let Z := (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj P₀
  let L := wcContSheaf S (Fin 1 → ZMod N)
  let L' := ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj L

  have hLtors : ∀ (X : S.ProEt) (y : L.obj.obj (Opposite.op X)), N • y = 0 := by
    intro X y
    let evL : ∀ t : ↥X.left, L.obj.obj (Opposite.op X) →+ (Fin 1 → ZMod N) := fun t =>
      { toFun := fun y => (show C(↥X.left, Fin 1 → ZMod N) from y.down) t
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    refine ULift.ext _ _ (ContinuousMap.ext fun t => ?_)
    show evL t (N • y) = evL t 0
    rw [map_nsmul, map_zero]
    funext i
    rw [Pi.smul_apply, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rfl
  have hL : N • 𝟙 L = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro y
    have h0L : (0 : L ⟶ L).hom = 0 :=
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero L L
    rw [hns, h0L, NatTrans.app_zero]
    exact hLtors X.unop _

  let ev : ∀ (W : Over U) (t : ↥W.left.left), L'.obj.obj (Opposite.op W) →+ (Fin 1 → ZMod N) :=
    fun W t =>
    { toFun := fun y => (show C(↥W.left.left, Fin 1 → ZMod N) from y.down) t
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hext : ∀ (W : Over U) (y y' : L'.obj.obj (Opposite.op W)),
      (∀ t, ev W t y = ev W t y') → y = y' :=
    fun W y y' h => ULift.ext _ _ (ContinuousMap.ext h)
  let c1 : ∀ W : Over U, L'.obj.obj (Opposite.op W) := fun W =>
    ULift.up (ContinuousMap.const ↥W.left.left (fun _ => (1 : ZMod N)))

  let ν : Z.obj.obj (Opposite.op T) :=
    (toSheafify ((Scheme.ProEt.topology S).over U) P₀).app (Opposite.op T)
      (FreeAbelianGroup.of (ULift.up (𝟙 T)))
  have hbij : ∀ (G : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : Z ⟶ G => (g.hom.app (Opposite.op T)).hom ν) := by
    intro G
    let e2 : (P₀ ⟶ G.obj) ≃ G.obj.obj (Opposite.op T) :=
      ((Adjunction.whiskerRight (Over U)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1}))
    let e' := ((sheafificationAdjunction ((Scheme.ProEt.topology S).over U)
      AddCommGrpCat.{u+1}).homEquiv P₀ G).trans e2
    convert e'.bijective using 1
    funext g
    simp only [e', e2, Equiv.trans_apply, Adjunction.homEquiv_unit]
    rfl
  have hI : ∀ (G : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) (g g' : Z ⟶ G),
      (g.hom.app (Opposite.op T)).hom ν = (g'.hom.app (Opposite.op T)).hom ν → g = g' :=
    fun G g g' hg => (hbij G).1 hg
  obtain ⟨φ, hφ'⟩ := (hbij L').2 (c1 T)
  have hφ : (φ.hom.app (Opposite.op T)).hom ν = c1 T := hφ'

  let tW : ∀ W : Over U, W ⟶ T := fun W => Over.homMk W.hom (Category.comp_id _)
  let gen : ∀ W : Over U, Z.obj.obj (Opposite.op W) := fun W =>
    ((toSheafify ((Scheme.ProEt.topology S).over U) P₀).app (Opposite.op W)).hom
      (FreeAbelianGroup.of (ULift.up (tW W)))
  have e0 : ∀ W : Over U, (P₀.map (tW W).op).hom (FreeAbelianGroup.of (ULift.up (𝟙 T))) =
      FreeAbelianGroup.of (ULift.up (tW W)) := by
    intro W
    have hb : (ULift.up (tW W) : ULift.{u+1} (W ⟶ T)) =
        ULift.up ((tW W).op.unop ≫ 𝟙 T) := by
      apply ULift.ext
      exact Over.mkIdTerminal.hom_ext _ _
    first
      | (refine (AddCommGrpCat.free_map_coe (FreeAbelianGroup.of (ULift.up (𝟙 T)))).trans ?_
         refine (FreeAbelianGroup.map_of _ _).trans ?_
         rw [hb]
         rfl)
      | (simp [P₀, AddCommGrpCat.free]
         erw [FreeAbelianGroup.map_of_apply]
         all_goals first
           | done
           | (congr 1; apply ULift.ext; exact Over.mkIdTerminal.hom_ext _ _)
           | (apply ULift.ext; exact Over.mkIdTerminal.hom_ext _ _)
           | exact Over.mkIdTerminal.hom_ext _ _)
  have hgen_eq : ∀ W : Over U, (Z.obj.map (tW W).op).hom ν = gen W := by
    intro W
    have h2 := NatTrans.naturality_apply (toSheafify ((Scheme.ProEt.topology S).over U) P₀)
      (tW W).op (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    refine h2.symm.trans ?_
    exact congrArg (((toSheafify ((Scheme.ProEt.topology S).over U) P₀).app
      (Opposite.op W)).hom) (e0 W)
  have hsing : ∀ (W : Over U) (b : ULift.{u+1} (W ⟶ T))
      (p : FreeAbelianGroup (ULift.{u+1} (W ⟶ T))), ∃ k : ℤ, p = k • FreeAbelianGroup.of b := by
    intro W b p
    refine FreeAbelianGroup.induction_on p ?_ ?_ ?_ ?_
    · exact ⟨0, by rw [zero_zsmul]⟩
    · intro x
      refine ⟨1, ?_⟩
      rw [one_zsmul]
      have hxb : x = b := by
        apply ULift.ext
        exact Over.mkIdTerminal.hom_ext _ _
      rw [hxb]
    · rintro x ⟨k, hk⟩
      exact ⟨-k, by rw [hk, neg_zsmul]⟩
    · rintro x y ⟨k, hk⟩ ⟨l, hl⟩
      exact ⟨k + l, by rw [hk, hl, add_zsmul]⟩
  have hgenW : ∀ (W : Over U) (p : P₀.obj (Opposite.op W)), ∃ k : ℤ,
      ((toSheafify ((Scheme.ProEt.topology S).over U) P₀).app (Opposite.op W)).hom p =
        k • gen W := by
    intro W p
    obtain ⟨k, hk⟩ := hsing W (ULift.up (tW W)) p
    exact ⟨k, by rw [hk]; exact map_zsmul _ k _⟩
  have hφgen : ∀ (W : Over U) (t : ↥W.left.left),
      ev W t ((φ.hom.app (Opposite.op W)).hom (gen W)) = fun _ => 1 := by
    intro W t
    have h : (φ.hom.app (Opposite.op W)).hom (gen W) = (L'.obj.map (tW W).op).hom (c1 T) := by
      rw [← hgen_eq W, ← hφ]
      exact NatTrans.naturality_apply φ.hom (tW W).op ν
    rw [h]
    rfl
  have hφk : ∀ (W : Over U) (k : ℤ) (t : ↥W.left.left),
      ev W t ((φ.hom.app (Opposite.op W)).hom (k • gen W)) = fun _ => (k : ZMod N) := by
    intro W k t
    rw [map_zsmul, map_zsmul, hφgen]
    funext i
    show k • (1 : ZMod N) = (k : ZMod N)
    rw [zsmul_eq_mul, mul_one]

  have h0ZL : (0 : Z ⟶ L').hom = 0 :=
    (sheafToPresheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).map_zero Z L'
  have hdesc : (N • 𝟙 Z) ≫ φ = 0 := by
    apply hI
    rw [Preadditive.nsmul_comp, Category.id_comp, hns, hφ, h0ZL, NatTrans.app_zero]
    show N • c1 T = 0
    apply hext
    intro t
    rw [map_nsmul, map_zero]
    funext i
    show N • (1 : ZMod N) = 0
    rw [nsmul_eq_mul, mul_one, ZMod.natCast_self]
  let Q := Limits.cokernel (N • 𝟙 Z)
  let π : Z ⟶ Q := Limits.cokernel.π (N • 𝟙 Z)
  let φbar : Q ⟶ L' := Limits.cokernel.desc (N • 𝟙 Z) φ hdesc
  have hfac : π ≫ φbar = φ := Limits.cokernel.π_desc _ _ _
  have h0ZQ : (0 : Z ⟶ Q).hom = 0 :=
    (sheafToPresheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).map_zero Z Q

  have hopen : ∀ (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro Q n W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have hempty : ∀ (W : Over U), IsEmpty ↥W.left.left →
      (⊥ : Sieve W) ∈ ((Scheme.ProEt.topology S).over U) W := by
    intro W hW
    rw [GrothendieckTopology.mem_over_iff]
    have hc := hopen W.left 0 (fun k => Fin.elim0 k) (fun k => Fin.elim0 k) (fun k => Fin.elim0 k)
      (fun x => isEmptyElim x)
    refine GrothendieckTopology.superset_covering _ ?_ hc
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    exact Fin.elim0 j
  have hQempty : ∀ (W : Over U), IsEmpty ↥W.left.left → ∀ x : Q.obj.obj (Opposite.op W), x = 0 := by
    intro W hW x
    exact Q.isSeparated W ⊥ (hempty W hW) x 0 (fun Y f hf => ((Sieve.bot_apply f).mp hf).elim)
  have hs4 : ∀ (X : Over U) (t : L'.obj.obj (Opposite.op X)) (n : ℕ) (W : Fin n → S.ProEt)
      (g : ∀ j, W j ⟶ X.left),
      Sieve.generate (Presieve.ofArrows W g) ∈ Scheme.ProEt.topology S X.left →
      (∀ j, ∃ μ : Z.obj.obj (Opposite.op (Over.mk (g j ≫ X.hom))),
        (φ.hom.app (Opposite.op (Over.mk (g j ≫ X.hom)))).hom μ =
          (L'.obj.map (Over.homMk (g j) : Over.mk (g j ≫ X.hom) ⟶ X).op).hom t) →
      Presheaf.imageSieve φ.hom t ∈ ((Scheme.ProEt.topology S).over U) X := by
    intro X t n W g hcov hlift
    rw [GrothendieckTopology.mem_over_iff]
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    rw [Sieve.overEquiv_iff]
    exact hlift j
  have hs7 : ∀ (Q0 : S.ProEt) (τ : C(↥Q0.left, Fin 1 → ZMod N)),
      ∃ (n : ℕ) (W : Fin n → S.ProEt) (ι : ∀ j, W j ⟶ Q0) (b : Fin n → (Fin 1 → ZMod N)),
        (∀ j, IsOpenMap ⇑(ι j).left) ∧ (∀ x : ↥Q0.left, ∃ j, x ∈ Set.range ⇑(ι j).left) ∧
        ∀ j (t : ↥(W j).left), τ ((ι j).left t) = b j := by
    intro Q0 τ
    let eB := Finite.equivFin (Fin 1 → ZMod N)
    let O : Fin (Nat.card (Fin 1 → ZMod N)) → Q0.left.Opens := fun j =>
      ⟨τ ⁻¹' {eB.symm j}, τ.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
    let W : Fin (Nat.card (Fin 1 → ZMod N)) → S.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ ((O j).ι ≫ Q0.hom)
        (by haveI : WeaklyEtale Q0.hom := Q0.prop; infer_instance)
    let ι : ∀ j, W j ⟶ Q0 := fun j => MorphismProperty.Over.homMk (O j).ι rfl trivial
    refine ⟨Nat.card (Fin 1 → ZMod N), W, ι, fun j => eB.symm j, fun j => ?_, fun x => ?_,
      fun j t => ?_⟩
    · exact (O j).ι.isOpenEmbedding.isOpenMap
    · refine ⟨eB (τ x), ⟨x, ?_⟩, ?_⟩
      · show τ x ∈ ({eB.symm (eB (τ x))} : Set _)
        simp
      · exact Scheme.Opens.ι_apply _ _
    · show τ ((O j).ι t) = eB.symm j
      exact (congrArg τ (Scheme.Opens.ι_apply (O j) t)).trans t.2

  have hls : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) φ.hom := by
    refine Presheaf.IsLocallySurjective.mk (fun {V} y => ?_)
    let τ : C(↥V.left.left, Fin 1 → ZMod N) := (show C(↥V.left.left, Fin 1 → ZMod N) from y.down)
    obtain ⟨n, W, ι, b, hιo, hιs, hιc⟩ := hs7 V.left τ
    refine hs4 V y n W ι (hopen V.left n W ι hιo hιs) (fun j => ?_)
    refine ⟨((((b j) 0).val : ℕ) : ℤ) • gen (Over.mk (ι j ≫ V.hom)), ?_⟩
    apply hext
    intro t
    rw [hφk]
    show _ = τ ((ι j).left t)
    rw [hιc j t]
    funext i
    show (((((b j) 0).val : ℕ) : ℤ) : ZMod N) = b j i
    rw [Fin.fin_one_eq_zero i, Int.cast_natCast, ZMod.natCast_zmod_val]
  haveI hepi : Epi φ := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mp hls
  haveI hepibar : Epi φbar := epi_of_epi_fac hfac

  have hM1 : ∀ (V : Over U) (z : Z.obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op V)).hom z = 0 → (π.hom.app (Opposite.op V)).hom z = 0 := by
    intro V z hz
    haveI : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U)
        (toSheafify ((Scheme.ProEt.topology S).over U) P₀) :=
      Presheaf.isLocallySurjective_toSheafify' _ P₀
    refine Q.isSeparated V _ (Presheaf.imageSieve_mem _
      (toSheafify ((Scheme.ProEt.topology S).over U) P₀) z) _ 0 ?_
    rintro W g ⟨p, hp⟩
    have hp' : ((toSheafify ((Scheme.ProEt.topology S).over U) P₀).app (Opposite.op W)).hom p =
        (Z.obj.map g.op).hom z := hp
    obtain ⟨k, hk⟩ := hgenW W p
    have hzW : (Z.obj.map g.op).hom z = k • gen W := hp'.symm.trans hk
    have hφ0 : (φ.hom.app (Opposite.op W)).hom (k • gen W) = 0 := by
      rw [← hzW]
      have h3 := NatTrans.naturality_apply φ.hom g.op z
      rw [h3, hz, map_zero]
    have hπ0 : (π.hom.app (Opposite.op W)).hom (k • gen W) = 0 := by
      by_cases hW : Nonempty ↥W.left.left
      · obtain ⟨w⟩ := hW
        have h1 := congrArg (fun y => ev W w y 0) hφ0
        simp only [hφk, map_zero, Pi.zero_apply] at h1
        obtain ⟨j, hj⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd k N).mp h1
        have hkN : k • gen W = ((N • 𝟙 Z).hom.app (Opposite.op W)).hom (j • gen W) := by
          rw [hns]
          show k • gen W = N • (j • gen W)
          rw [hj, mul_comm, mul_zsmul', natCast_zsmul]
        rw [hkN]
        have hc := congrArg (fun f => (f.hom.app (Opposite.op W)).hom (j • gen W))
          (Limits.cokernel.condition (N • 𝟙 Z))
        refine hc.trans ?_
        show ((0 : Z ⟶ Q).hom.app (Opposite.op W)).hom (j • gen W) = 0
        rw [h0ZQ, NatTrans.app_zero]
        rfl
      · haveI : IsEmpty ↥W.left.left := not_nonempty_iff.mp hW
        exact hQempty W this _
    rw [map_zero, ← NatTrans.naturality_apply π.hom g.op z, hzW]
    exact hπ0
  have hM2 : ∀ (V : Over U) (q : Q.obj.obj (Opposite.op V)),
      (φbar.hom.app (Opposite.op V)).hom q = 0 → q = 0 := by
    intro V q hq
    haveI hlsπ : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) π.hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
    refine Q.isSeparated V _ (Presheaf.imageSieve_mem _ π.hom q) _ 0 ?_
    rintro W g ⟨z, hzq⟩
    rw [map_zero, ← hzq]
    apply hM1 W z
    have h1 : (φ.hom.app (Opposite.op W)).hom z =
        (φbar.hom.app (Opposite.op W)).hom ((π.hom.app (Opposite.op W)).hom z) :=
      (congrArg (fun f => (f.hom.app (Opposite.op W)).hom z) hfac).symm
    rw [h1, hzq, NatTrans.naturality_apply φbar.hom g.op q, hq, map_zero]
  haveI hmonoApp : ∀ X : (Over U)ᵒᵖ, Mono (φbar.hom.app X) := fun X =>
    ConcreteCategory.mono_of_injective _
      ((injective_iff_map_eq_zero _).mpr (fun q hq => hM2 X.unop q hq))
  haveI : Mono φbar.hom := NatTrans.mono_of_mono_app _
  haveI : Mono φbar := Sheaf.Hom.mono_of_presheaf_mono _ _ φbar
  haveI : IsIso φbar := isIso_of_mono_of_epi φbar
  exact ⟨⟨asIso φbar⟩, hL⟩

theorem wc_slice_trace_coker_offU (S : Scheme.{u}) (U : S.ProEt) (Ub : U.left.Opens)
    (X : S.ProEt) (x : X ⟶ U) (πX : X.left ⟶ Ub.toScheme) (hπX : πX ≫ Ub.ι = x.left)
    (hetX : Etale πX) (hsurjX : Surjective πX) (N : ℕ) :
    let Zsl : Over U ⥤ Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} :=
      yoneda ⋙ (Functor.whiskeringRight (Over U)ᵒᵖ (Type u) AddCommGrpCat.{u+1}).obj
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
        presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}
    let Zm : Over U → Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} :=
      fun X => Limits.cokernel (N • 𝟙 (Zsl.obj X))
    let ZmMap : ∀ X Y : Over U, (X ⟶ Y) → (Zm X ⟶ Zm Y) :=
      fun X Y f => Limits.cokernel.desc (N • 𝟙 (Zsl.obj X))
        (Zsl.map f ≫ Limits.cokernel.π (N • 𝟙 (Zsl.obj Y))) (by
          have h0 := Limits.cokernel.condition (N • 𝟙 (Zsl.obj Y))
          rw [Preadditive.nsmul_comp, Category.id_comp] at h0
          rw [Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, h0,
            Limits.comp_zero])
    ∀ (V' : Over U), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      ∀ s : (Limits.cokernel (ZmMap _ _ (Over.homMk x (Category.comp_id x) :
          Over.mk x ⟶ Over.mk (𝟙 U)))).obj.obj (Opposite.op V'), s = 0 :=
by
  intro Zsl Zm ZmMap V' hV' s
  classical
  let J := (Scheme.ProEt.topology S).over U
  let O1 : Over U := Over.mk (𝟙 U)
  let OX : Over U := Over.mk x
  let ε : OX ⟶ O1 := Over.homMk x (Category.comp_id x)
  let τ := ZmMap _ _ ε
  let Q := Limits.cokernel τ
  let P1 := yoneda.obj O1 ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let PX := yoneda.obj OX ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free

  let ρ : Zsl.obj O1 ⟶ Q := Limits.cokernel.π (N • 𝟙 (Zsl.obj O1)) ≫ Limits.cokernel.π τ
  have hρε : Zsl.map ε ≫ ρ = 0 := by
    have h1 : Zsl.map ε ≫ Limits.cokernel.π (N • 𝟙 (Zsl.obj O1)) =
        Limits.cokernel.π (N • 𝟙 (Zsl.obj OX)) ≫ τ := (Limits.cokernel.π_desc _ _ _).symm
    show Zsl.map ε ≫ (Limits.cokernel.π (N • 𝟙 (Zsl.obj O1)) ≫ Limits.cokernel.π τ) = 0
    rw [← Category.assoc, h1, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  haveI : Epi ρ := epi_comp _ _

  let κ : P1 ⟶ Q.obj := toSheafify J P1 ≫ ρ.hom
  haveI hρls : Presheaf.IsLocallySurjective J ρ.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} ρ).mpr inferInstance
  haveI hκls : Presheaf.IsLocallySurjective J κ :=
    Presheaf.isLocallySurjective_comp J (toSheafify J P1) ρ.hom

  let η : PX ⟶ P1 := Functor.whiskerRight (yoneda.map ε) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
  have hηκ : η ≫ κ = 0 := by
    have h1 : η ≫ toSheafify J P1 = toSheafify J PX ≫ sheafifyMap J η := toSheafify_naturality J η
    have h2 : sheafifyMap J η = (Zsl.map ε).hom := rfl
    have h0 : (0 : Zsl.obj OX ⟶ Q).hom = 0 :=
      (sheafToPresheaf J AddCommGrpCat.{u+1}).map_zero _ _
    calc η ≫ κ = (η ≫ toSheafify J P1) ≫ ρ.hom := (Category.assoc _ _ _).symm
      _ = toSheafify J PX ≫ ((Zsl.map ε).hom ≫ ρ.hom) := by rw [h1, h2, Category.assoc]
      _ = toSheafify J PX ≫ (Zsl.map ε ≫ ρ).hom := rfl
      _ = 0 := by rw [hρε, h0, Limits.comp_zero]
  have hηκ' : ∀ (Y' : Over U) (w : PX.obj (Opposite.op Y')),
      (κ.app (Opposite.op Y')).hom ((η.app (Opposite.op Y')).hom w) = 0 := by
    intro Y' w
    change ((η ≫ κ).app (Opposite.op Y')).hom w = 0
    rw [hηκ, NatTrans.app_zero]
    rfl

  have hopen : ∀ (T : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ T),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥T.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S T := by
    intro T n W h hO hJ
    have hs : ∀ x : T.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ T.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left T.hom h1 T.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings T.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  let R : ∀ Y : Over U, Sieve Y := fun Y =>
    { arrows := fun Y'' _ => Nonempty (Y'' ⟶ OX)
      downward_closed := fun {_ _ _} ha g => ⟨g ≫ ha.some⟩ }
  have hRcov : ∀ Y : Over U, (∀ v : Y.left.left, Y.hom.left v ∈ Ub) →
      R Y ∈ ((Scheme.ProEt.topology S).over U) Y := by
    intro Y hY
    haveI : Etale x.left := hπX ▸ inferInstance
    let W0 : S.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst Y.hom.left x.left ≫ Y.left.hom)
      (by haveI : WeaklyEtale Y.left.hom := Y.left.prop; infer_instance)
    let q1 : W0 ⟶ Y.left :=
      MorphismProperty.Over.homMk (Limits.pullback.fst Y.hom.left x.left) rfl trivial
    have hq2 : Limits.pullback.snd Y.hom.left x.left ≫ X.hom = W0.hom := by
      show _ = Limits.pullback.fst Y.hom.left x.left ≫ Y.left.hom
      rw [← MorphismProperty.Over.w x, ← MorphismProperty.Over.w Y.hom, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let q2 : W0 ⟶ X := MorphismProperty.Over.homMk (Limits.pullback.snd Y.hom.left x.left) hq2 trivial
    have hq : q1 ≫ Y.hom = q2 ≫ x := by
      apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst Y.hom.left x.left ≫ Y.hom.left =
        Limits.pullback.snd Y.hom.left x.left ≫ x.left
      exact Limits.pullback.condition
    have hq1o : IsOpenMap ⇑q1.left := (Limits.pullback.fst Y.hom.left x.left).isOpenMap
    have hq1s : Function.Surjective ⇑q1.left := by
      intro y
      have hy : Y.hom.left y ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hY y
      obtain ⟨p, hp⟩ := hy
      obtain ⟨z, hz⟩ := hsurjX.surj p
      have hez : Y.hom.left y = x.left z := by
        rw [← hp, ← hz, ← hπX, Scheme.Hom.comp_apply]
      obtain ⟨w, hw, _⟩ := Scheme.Pullback.exists_preimage_pullback y z hez
      exact ⟨w, hw⟩
    have hG := hopen Y.left 1 (fun _ => W0) (fun _ => q1) (fun _ => hq1o)
      (fun y => ⟨0, hq1s y⟩)
    rw [GrothendieckTopology.mem_over_iff]
    refine GrothendieckTopology.superset_covering _ ?_ hG
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    rw [Sieve.overEquiv_iff]
    show Nonempty (_ ⟶ OX)
    exact ⟨Over.homMk q2 hq.symm⟩

  have k1 : ∀ (Z : Over U) (f : Z ⟶ O1), f.left = Z.hom := fun Z f => by
    have := Over.w f
    simpa [O1] using this
  have hgen : ∀ (Y : Over U), (∀ v : Y.left.left, Y.hom.left v ∈ Ub) →
      ∀ g : Y ⟶ O1, (κ.app (Opposite.op Y)).hom
        (FreeAbelianGroup.of (ULift.up g) : FreeAbelianGroup (ULift.{u+1} (Y ⟶ O1))) = 0 := by
    intro Y hY g
    let p0 : P1.obj (Opposite.op Y) :=
      (FreeAbelianGroup.of (ULift.up g) : FreeAbelianGroup (ULift.{u+1} (Y ⟶ O1)))
    show (κ.app (Opposite.op Y)).hom p0 = 0
    refine Q.isSeparated Y (R Y) (hRcov Y hY) _ 0 ?_
    rintro Y'' h ⟨a⟩
    rw [map_zero]
    refine (NatTrans.naturality_apply κ h.op p0).symm.trans ?_
    have hha : h ≫ g = a ≫ ε := by
      apply Over.OverMorphism.ext
      exact (k1 _ _).trans (k1 _ _).symm
    let pa : PX.obj (Opposite.op Y'') :=
      (FreeAbelianGroup.of (ULift.up a) : FreeAbelianGroup (ULift.{u+1} (Y'' ⟶ OX)))
    have l1 : (P1.map h.op).hom p0 =
        (FreeAbelianGroup.of (ULift.up (h ≫ g)) : FreeAbelianGroup (ULift.{u+1} (Y'' ⟶ O1))) := by
      first
        | (show (FreeAbelianGroup.map _) (FreeAbelianGroup.of _) = _
           rw [FreeAbelianGroup.map_of_apply]; rfl)
        | (simp [P1, p0, AddCommGrpCat.free]; done)
        | (simp [P1, p0, AddCommGrpCat.free]; erw [FreeAbelianGroup.map_of_apply]; rfl)
    have l2 : (η.app (Opposite.op Y'')).hom pa =
        (FreeAbelianGroup.of (ULift.up (a ≫ ε)) : FreeAbelianGroup (ULift.{u+1} (Y'' ⟶ O1))) := by
      first
        | (show (FreeAbelianGroup.map _) (FreeAbelianGroup.of _) = _
           rw [FreeAbelianGroup.map_of_apply]; rfl)
        | (simp [η, pa, AddCommGrpCat.free]; done)
        | (simp [η, pa, AddCommGrpCat.free]; erw [FreeAbelianGroup.map_of_apply]; rfl)
    have l3 : (P1.map h.op).hom p0 = (η.app (Opposite.op Y'')).hom pa := by
      rw [l1, l2, hha]
    calc _ = (κ.app (Opposite.op Y'')).hom ((η.app (Opposite.op Y'')).hom pa) :=
          congrArg (κ.app (Opposite.op Y'')).hom l3
      _ = 0 := hηκ' Y'' pa
  have hall : ∀ (Y : Over U), (∀ v : Y.left.left, Y.hom.left v ∈ Ub) →
      ∀ p : P1.obj (Opposite.op Y), (κ.app (Opposite.op Y)).hom p = 0 := by
    intro Y hY
    change ∀ p : FreeAbelianGroup (ULift.{u+1} (Y ⟶ O1)), (κ.app (Opposite.op Y)).hom p = 0
    intro p
    induction p using FreeAbelianGroup.induction_on
    · exact map_zero _
    · rename_i g
      exact hgen Y hY g.down
    · rename_i g ih
      exact ((κ.app (Opposite.op Y)).hom.map_neg _).trans ((congrArg Neg.neg ih).trans neg_zero)
    · rename_i p q hp hq
      exact ((κ.app (Opposite.op Y)).hom.map_add p q).trans
        ((congrArg₂ (· + ·) hp hq).trans (add_zero 0))

  have h𝒰 : ∀ {Y Y' : Over U} (f : Y' ⟶ Y), (∀ v : Y.left.left, Y.hom.left v ∈ Ub) →
      ∀ v : Y'.left.left, Y'.hom.left v ∈ Ub := by
    intro Y Y' f hY v
    have hw : Y'.hom.left = f.left.left ≫ Y.hom.left := by
      rw [← Over.w f]; rfl
    rw [hw, Scheme.Hom.comp_apply]
    exact hY _
  refine Q.isSeparated V' _ (Presheaf.imageSieve_mem J κ s) _ 0 ?_
  rintro Y f ⟨p, hp⟩
  rw [map_zero, ← hp]
  exact hall Y (h𝒰 f hV') p

theorem wc_qcfin_slice_h2_const_card (F'' : Type u) [Field F''] [Finite F'']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (r : ℕ) :
    letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
    let Zsl : Over (wcGeomPoint F'' (wcP1Over F'') hP) ⥤ Sheaf ((Scheme.ProEt.topology
        (wcP1Over F'').left).over (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1} :=
      yoneda ⋙ (Functor.whiskeringRight (Over (wcGeomPoint F'' (wcP1Over F'') hP))ᵒᵖ (Type u)
        AddCommGrpCat.{u+1}).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
        presheafToSheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
          (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}
    Nat.card (Abelian.Ext (Zsl.obj (Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))))
        (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))))))
        2) = ℓ ^ r :=
by
  intro Zsl
  classical
  letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
  let Z0 := Zsl.obj (Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP)))
  have hN : 0 < ℓ ^ r := pow_pos (Fact.out : Nat.Prime ℓ).pos r

  have hMF : ((ℓ ^ r : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    have hℓ' : ((ℓ : ℕ) : F'') ≠ 0 := by
      intro h0
      obtain ⟨p, hpc⟩ := CharP.exists F''
      have hp : p.Prime := CharP.char_is_prime F'' p
      have hdvd : p ∣ ℓ := (CharP.cast_eq_zero_iff F'' p ℓ).mp h0
      have hpl : p = ℓ :=
        ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd p hdvd).resolve_left hp.one_lt.ne'
      haveI : Fintype F'' := Fintype.ofFinite F''
      obtain ⟨n, hn, hcard⟩ := FiniteField.card F'' p
      apply hℓ
      rw [Nat.card_eq_fintype_card, hcard, ← hpl]
      exact dvd_pow_self p n.pos.ne'
    have h1 : ((ℓ : ℕ) : AlgebraicClosure F'') ≠ 0 := by
      rw [← map_natCast (algebraMap F'' (AlgebraicClosure F''))]
      exact (map_ne_zero _).mpr hℓ'
    rw [Nat.cast_pow]
    exact pow_ne_zero _ h1

  have htr : ∀ {A A' : Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}} (e : A ≅ A'),
      Nonempty (Abelian.Ext Z0 A 2 ≃ Abelian.Ext Z0 A' 2) := by
    intro A A' e
    exact ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero 2)
             invFun := fun z => z.comp (Abelian.Ext.mk₀ e.inv) (add_zero 2)
             left_inv := fun y => by
               dsimp only
               rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                 e.hom_inv_id, Abelian.Ext.comp_mk₀_id]
             right_inv := fun z => by
               dsimp only
               rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                 e.inv_hom_id, Abelian.Ext.comp_mk₀_id] }⟩

  obtain ⟨⟨ζ⟩, -⟩ := wc_slice_zm_terminal_iso (wcP1Over F'').left
    (wcGeomPoint F'' (wcP1Over F'') hP) (ℓ ^ r) hN
  obtain ⟨θ, -⟩ := wc_contSheaf_iso_of_addEquiv (wcP1Over F'').left (Fin 1 → ZMod (ℓ ^ r))
    (ZMod (ℓ ^ r)) (AddEquiv.funUnique (Fin 1) (ZMod (ℓ ^ r)))
  obtain ⟨e1⟩ : Nonempty (Abelian.Ext Z0 (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 Z0)) 2 ≃
      Abelian.Ext Z0 (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F'' (wcP1Over F'') hP)).obj (wcZModSheaf (wcP1Over F'').left (ℓ ^ r))) 2) :=
    htr (ζ ≪≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F'' (wcP1Over F'') hP)).mapIso θ)

  obtain ⟨Φ⟩ := wc_proet_free_slice_ext_equiv (wcP1Over F'').left
    (wcGeomPoint F'' (wcP1Over F'') hP) (wcZModSheaf (wcP1Over F'').left (ℓ ^ r)) 2
  obtain ⟨e3⟩ := wc_ext_free_slice_zmod (wcP1Over F'').left
    (wcGeomPoint F'' (wcP1Over F'') hP) (ℓ ^ r) 2
  haveI : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hsnd : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  let fb : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶ Spec (.of (AlgebraicClosure F'')) :=
    Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
  haveI hfbP : IsProper fb := hsnd
  obtain ⟨e4⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure F'')
    (wcGeomPoint F'' (wcP1Over F'') hP).left fb (ℓ ^ r) 2

  haveI : IsIntegral (wcGeomPoint F'' (wcP1Over F'') hP).left := (wc_P1bar_facts F'' hP).1
  haveI : SmoothOfRelativeDimension 1 (wcProjKStr F'' 1) := wc_proj_space_smooth F'' 1
  haveI hsm : Smooth (wcProjKStr F'' 1) := by
    first
      | exact SmoothOfRelativeDimension.smooth 1 (wcProjKStr F'' 1)
      | infer_instance
  haveI : Smooth (wcP1Over F'').hom := hsm
  haveI hsnds : Smooth (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  haveI hfbS : Smooth fb := hsnds
  have hcard : Nat.card (wcEtCoh (wcGeomPoint F'' (wcP1Over F'') hP).left (ℓ ^ r) 2) = ℓ ^ r :=
    wc_et_normal_curve_h2_card_gen (AlgebraicClosure F'') (ℓ ^ r) hMF
      (fun Y fY => wc_et_kummer_ses_gen (AlgebraicClosure F'') Y fY (ℓ ^ r) hMF)
      (fun Y fY _ _ hn hd U _ hU hfin ord hord =>
        wc_curve_divisor_degree_point_congr_gen (AlgebraicClosure F'') Y fY hn hd U hU hfin
          (ℓ ^ r) hMF ord hord)
      (wcGeomPoint F'' (wcP1Over F'') hP).left fb
      inferInstance
      (fun x => wc_fntame_smooth_stalk_normal (AlgebraicClosure F'')
        (wcGeomPoint F'' (wcP1Over F'') hP).left fb x)
      (wc_P1bar_facts F'' hP).2
  exact (Nat.card_congr (e1.trans (Φ.toEquiv.symm.trans (e3.trans e4)))).trans hcard

theorem wc_qcfin_slice_fet_ext_classical (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (ℓ r : ℕ) (X : (wcP1Over F'').left.ProEt) (x : X ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hxet : Etale x.left) (n : ℕ) :
    letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
    let Zsl : Over (wcGeomPoint F'' (wcP1Over F'') hP) ⥤ Sheaf ((Scheme.ProEt.topology
        (wcP1Over F'').left).over (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1} :=
      yoneda ⋙ (Functor.whiskeringRight (Over (wcGeomPoint F'' (wcP1Over F'') hP))ᵒᵖ (Type u)
        AddCommGrpCat.{u+1}).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
        presheafToSheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
          (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}
    Nonempty (Abelian.Ext (Zsl.obj (Over.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP))))
        (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk x)))) n ≃
      wcEtExt (wcGeomPoint F'' (wcP1Over F'') hP).left
        (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (wcFtcFS (wcGeomPoint F'' (wcP1Over F'') hP).left
          (@Scheme.Etale.mk _ _ x.left hxet)))) n) :=
by
  intro Zsl
  classical
  letI instSl : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over
      (wcGeomPoint F'' (wcP1Over F'') hP)) AddCommGrpCat.{u+1}) := HasExt.standard _

  have cokL : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Abelian C] [Abelian D]
      (L : C ⥤ D) [L.Additive] [Limits.PreservesFiniteColimits L] (A : C) (B : D)
      (θ : L.obj A ≅ B) (N : ℕ),
      Nonempty (L.obj (Limits.cokernel (N • 𝟙 A)) ≅ Limits.cokernel (N • 𝟙 B)) := by
    intro C D _ _ _ _ L _ _ A B θ N
    refine ⟨Limits.PreservesCokernel.iso L (N • 𝟙 A) ≪≫
      Limits.cokernelIsoOfEq (show L.map (N • 𝟙 A) = N • 𝟙 (L.obj A) by
        rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]) ≪≫
      Limits.cokernel.mapIso _ _ θ θ ?_⟩
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]

  have s4 : ∀ (S : Scheme.{u}) (U : S.ProEt)
      [(wcSliceToOver S U).IsContinuous (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)]
      (X : S.ProEt) (x : X ⟶ U) (N : ℕ),
      Nonempty (((wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)).obj
          (Limits.cokernel (N • 𝟙 ((presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
            (yoneda.obj (Over.mk x) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))) ≅
        Limits.cokernel (N • 𝟙 (wcFreeSheaf U.left ((wcOverToSlice S U).obj (Over.mk x))))) := by
    intro S U _ X x N
    haveI hτ : (wcOverToSlice S U).IsContinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := (wc_slice_over_sites_cont S U).2.1
    let eC : wcSliceToOver S U ⋙ wcOverToSlice S U ≅ 𝟭 (U.left.ProEt) :=
      NatIso.ofComponents
        (fun W => MorphismProperty.Over.isoMk (Iso.refl W.left) (Category.id_comp _))
        (fun {W W'} g => by
          apply MorphismProperty.Over.Hom.ext
          show g.left ≫ 𝟙 _ = 𝟙 _ ≫ g.left
          rw [Category.comp_id, Category.id_comp])
    let iV : ∀ V : Over U, (wcSliceFunctor S U).obj ((wcOverToSlice S U).obj V) ≅ V.left :=
      fun V => MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm)
    let eD : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents
        (fun V => Over.isoMk (iV V) (by
          apply MorphismProperty.Over.Hom.ext
          show 𝟙 _ ≫ V.hom.left = V.hom.left
          exact Category.id_comp _))
        (fun {V V'} g => by
          apply Over.OverMorphism.ext
          apply MorphismProperty.Over.Hom.ext
          show g.left.left ≫ 𝟙 _ = 𝟙 _ ≫ g.left.left
          rw [Category.comp_id, Category.id_comp])
    haveI hc1 : (wcSliceToOver S U ⋙ wcOverToSlice S U).IsContinuous
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology U.left) :=
