        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC w) _ _ D.cont D.φ).map h := by
      have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
        _ = D.adj.homEquiv _ _ D.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC w) _ _ D.cont D.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcSuppUnitMap D ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC w) _ _ D.cont D.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let T0 : S'.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S') (inferInstance : WeaklyEtale (𝟙 S'))
    let cT : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T0)).hom (1 : C(↥S', ULift.{u+1} ℚ_[ℓ]))
    let a : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom
        (1 : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ]))
    have hu1 : (u.val.app (Opposite.op T0)).hom (1 : C(↥S', ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ])) :=
      (D.φ.hom.app (Opposite.op T0)).hom.map_one
    have hev : (u.val.app (Opposite.op T0)).hom (1 : C(↥S', ULift.{u+1} ℚ_[ℓ])) =
        (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ]),
        (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom.map_smul x
        (1 : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ]))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC w).obj T0))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cT * a = 1 := by
      rw [← hlin cT, ← hev, hu1]
    refine ⟨a.comp (Limits.pullback.lift w (𝟙 S')
      ((Category.comp_id w).trans (Category.id_comp w).symm)).base.hom, ?_⟩
    show cT.comp (Limits.pullback.lift w (𝟙 S')
        ((Category.comp_id w).trans (Category.id_comp w).symm)).base.hom *
      a.comp (Limits.pullback.lift w (𝟙 S')
        ((Category.comp_id w).trans (Category.id_comp w).symm)).base.hom = 1
    rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]
  have hfactor : ∀ (D : wcHMPullData w ℓ), wcHMPullCanonical D →
      wcSuppUnitMap D = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _
        D.cont D.φ ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC w) _ _ D.cont D.φ).map
        (wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap D))) := by
    intro D _
    classical
    letI := D.cont
    have hlam1 : Limits.pullback.lift w (𝟙 S')
        ((Category.comp_id w).trans (Category.id_comp w).symm) ≫
        Limits.pullback.fst (𝟙 S') w = w := Limits.pullback.lift_fst _ _ _
    have hlam2 : Limits.pullback.lift w (𝟙 S')
        ((Category.comp_id w).trans (Category.id_comp w).symm) ≫
        Limits.pullback.snd (𝟙 S') w = 𝟙 S' := Limits.pullback.lift_snd _ _ _
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    obtain ⟨V⟩ := X
    let T0 : S'.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S') (inferInstance : WeaklyEtale (𝟙 S'))
    let e : V ⟶ T0 := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    let β0 : Limits.pullback V.hom w ⟶ Limits.pullback (𝟙 S') w := ((wcProEtBC w).map e).left
    have hβw : β0 ≫ Limits.pullback.snd (𝟙 S') w = Limits.pullback.snd V.hom w :=
      MorphismProperty.Over.w ((wcProEtBC w).map e)
    have hβ : β0 = Limits.pullback.snd V.hom w ≫
        Limits.pullback.lift w (𝟙 S') ((Category.comp_id w).trans (Category.id_comp w).symm) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
          Category.comp_id]
      · rw [Category.assoc, hlam2, Category.comp_id, hβw]
    let m1 : C(↥(Limits.pullback V.hom w), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    let mT : C(↥(Limits.pullback (𝟙 S') w), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T0)).hom (1 : C(↥S', ULift.{u+1} ℚ_[ℓ]))
    have e1 : m1 = mT.comp β0.base.hom :=
      PresheafOfModules.naturality_apply (wcSuppUnitMap D).val e.op
        (1 : C(↥S', ULift.{u+1} ℚ_[ℓ]))
    have e3 : mT.comp (Limits.pullback.snd V.hom w ≫
        Limits.pullback.lift w (𝟙 S')
          ((Category.comp_id w).trans (Category.id_comp w).symm)).base.hom =
        (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom w).base.hom :=
      ContinuousMap.ext fun _ => rfl
    have hL : m1 = (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom w).base.hom := by
      rw [e1, hβ, e3]
    let h := wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap D))
    let r1 : C(↥(Limits.pullback V.hom w), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC w).obj V))).hom
        (1 : C(↥(Limits.pullback V.hom w), ULift.{u+1} ℚ_[ℓ]))
    have hR : r1 = (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom w).base.hom := by
      have e4 : r1 = (SheafOfModules.unitHomEquiv _ h).1 (Opposite.op ((wcProEtBC w).obj V)) :=
        (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm
      rw [e4]
      simp only [h]
      unfold wcHMFun
      rw [Equiv.apply_symm_apply]
      rfl
    show m1 = (h.val.app (Opposite.op ((wcProEtBC w).obj V))).hom
      ((D.φ.hom.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])))
    have key := congrArg (fun x => (h.val.app (Opposite.op ((wcProEtBC w).obj V))).hom x)
      ((D.φ.hom.app (Opposite.op V)).hom.map_one)
    exact hL.trans (hR.symm.trans key.symm)



  have hiso : IsIso ((Dw.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ)) := by
    obtain ⟨c', hc'⟩ := hisUnit Dw
    have hfac := hfactor Dw hDw
    have hh1 : wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap Dw)) ≫ wcHMFun S' ℓ c' = 𝟙 _ := by
      rw [← hfun.2, hc', hfun.1]
    have hμ : Dw.μ.hom = (Dw.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ) ≫
        wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap Dw)) := by
      apply (Dw.adj.homEquiv _ _).injective
      rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
      exact hfac
    have hμ0 : (Dw.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ) =
        Dw.μ.hom ≫ wcHMFun S' ℓ c' := by
      rw [hμ, Category.assoc, hh1, Category.comp_id]
    refine ⟨⟨wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap Dw)) ≫ Dw.μ.inv, ?_, ?_⟩⟩
    · rw [← Category.assoc, ← hμ, Iso.hom_inv_id]
    · rw [hμ0]
      simp only [Category.assoc, Iso.inv_hom_id_assoc, hh1]
  let m0 := asIso ((Dw.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ))



  have hunit : @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont
        Df.φ ≫
      P.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont
        Dw.φ) ≫ γ.app (SheafOfModules.unit (wcRingSheaf S' ℓ)) =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro U
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro a
    have h1 := fun x : ((wcRingSheaf S ℓ).obj.obj U) =>
      ConcreteCategory.congr_hom (congrArg (fun ψ => ψ.hom.app U) hφ) x
    exact h1 a



  have hy' : y' = (Abelian.Ext.mk₀ m0.inv).comp ((Dw.Φ.mapExtAddHom _ _ N y).comp
      (Abelian.Ext.mk₀ m0.hom) (add_zero N)) (zero_add N) := by
    rw [← hy, s2 Dw.μ m0 N _ hcen]
    rfl
  obtain ⟨z0, hz0⟩ :=
    CochainComplex.HomComplex.CohomologyClass.mk_surjective (I.extEquivCohomologyClass y)
  have hφy : Hq'.map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm z0) =
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y) := by
    rw [← hz0, CochainComplex.HomComplex.CohomologyClass.homAddEquiv_apply,
      CochainComplex.HomComplex.CohomologyClass.toHom_mk]
  have hφy' : Hq'.map (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map m0.inv ≫ (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).inv.app (SheafOfModules.unit (wcRingSheaf S' ℓ)) ≫ (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map (CochainComplex.HomComplex.Cocycle.equivHomShift.symm z0) ≫ ((Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso (N : ℤ)).hom.app I.cochainComplex ≫ t⟦(N : ℤ)⟧')) =
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y') := by
    rw [hy']
    exact s3 Dw.Φ I m0 N t ht y _ hφy
  have e1 := s4 P Dg.Φ (Dg.μ.inv ≫ Dg.Φ.map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ))
    I.cochainComplex (N : ℤ) _ _ hφy
  have e2 := s4 P Dg.Φ (Dg.μ.inv ≫ Dg.Φ.map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ))
    I.cochainComplex (N : ℤ) _ _ hφy'
  have e3 := s5 Dw.Φ Pw Dw.adj P γ Dg.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ)
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ)
    Dg.μ.inv hunit m0 rfl I.cochainComplex t (N : ℤ)
    (CochainComplex.HomComplex.Cocycle.equivHomShift.symm z0)
  have hcc : c y' = c y ≫ (Hq.map TΨ)⟦(N : ℤ)⟧' := by
    change _ = _ at e1 e2
    refine e2.trans ?_
    rw [e3, Functor.map_comp, Category.assoc]
    erw [Functor.commShiftIso_hom_naturality]
    rw [← Category.assoc]
    first
      | exact congrArg (· ≫ _) e1.symm
      | (rw [← e1]; rfl)
      | (erw [← e1]; rfl)
  exact s6 _ Ψ (N : ℤ) TΨ (c y) (c y') hcc

theorem wc_pmn_supp_unit_line {X : Scheme.{u}} (Ω : Type u) [Field Ω]
    (xb : Spec (.of Ω) ⟶ X) {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Dx : wcHMPullData xb ℓ) (hDx : wcHMPullCanonical Dx) :
    ∀ h₀ : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx, h₀ ≠ 0 →
      ∃ u : SheafOfModules.unit (wcRingSheaf X ℓ) ≅ SheafOfModules.unit (wcRingSheaf X ℓ),
        h₀ = u.hom ≫ wcSuppUnitMap Dx :=
by
  classical
  intro h₀ hh₀
  haveI := Dx.cont
  let T : X.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 X) (inferInstance : WeaklyEtale (𝟙 X))

  have hsub : ∀ x y : ↥(Limits.pullback (𝟙 X) xb), x = y := by
    have e : ∀ z : ↥(Limits.pullback (𝟙 X) xb),
        (Limits.pullback.snd (𝟙 X) xb ≫ inv (Limits.pullback.snd (𝟙 X) xb)).base z = z := by
      intro z
      rw [IsIso.hom_inv_id]
      rfl
    intro x y
    rw [← e x, ← e y]
    show (inv (Limits.pullback.snd (𝟙 X) xb)).base ((Limits.pullback.snd (𝟙 X) xb).base x) =
      (inv (Limits.pullback.snd (𝟙 X) xb)).base ((Limits.pullback.snd (𝟙 X) xb).base y)
    rw [Subsingleton.elim ((Limits.pullback.snd (𝟙 X) xb).base x)
      ((Limits.pullback.snd (𝟙 X) xb).base y)]
  let q0 : ↥(Limits.pullback (𝟙 X) xb) :=
    (inv (Limits.pullback.snd (𝟙 X) xb)).base (IsLocalRing.closedPoint Ω)

  let sec : (SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx) → (V : X.ProEt) →
      C(↥(Limits.pullback V.hom xb), ULift.{u+1} ℚ_[ℓ]) :=
    fun h V => (SheafOfModules.unitHomEquiv _ h).1 (Opposite.op V)

  have hfac : ∀ (h : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx) (V : X.ProEt)
      (p : ↥(Limits.pullback V.hom xb)), sec h V p = sec h T q0 := by
    intro h V p
    let τ : V ⟶ T := MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial
    have h1 : (sec h T).comp ((wcProEtBC xb).map τ).left.base.hom = sec h V :=
      PresheafOfModules.sections_property (SheafOfModules.unitHomEquiv _ h) τ.op
    rw [← h1]
    exact congrArg (sec h T) (hsub _ _)

  have hscal : ∀ (h : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx) (c : ℚ_[ℓ])
      (V : X.ProEt) (p : ↥(Limits.pullback V.hom xb)),
      (sec (wcHMConst X ℓ c ≫ h) V p).down = c * (sec h V p).down := by
    intro h c V p
    have hval : (SheafOfModules.unitHomEquiv _ (wcHMConst X ℓ c)).1 (Opposite.op V) =
        (ContinuousMap.const _ (ULift.up c) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := by
      unfold wcHMConst
      rw [Equiv.apply_symm_apply]
      rfl
    let r : (wcRingSheaf X ℓ).obj.obj (Opposite.op V) :=
      (ContinuousMap.const _ (ULift.up c) : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 : (SheafOfModules.unitHomEquiv _ (wcHMConst X ℓ c ≫ h)).1 (Opposite.op V) =
        (h.val.app (Opposite.op V)).hom
          ((SheafOfModules.unitHomEquiv _ (wcHMConst X ℓ c)).1 (Opposite.op V)) := by
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have hs := (h.val.app (Opposite.op V)).hom.map_smul r
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have eLin : (h.val.app (Opposite.op V)).hom
        (ContinuousMap.const _ (ULift.up c) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
        r • (h.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) :=
      (congrArg (fun x => (h.val.app (Opposite.op V)).hom x) (mul_one r).symm).trans hs
    have e3 : (SheafOfModules.unitHomEquiv _ h).1 (Opposite.op V) =
        (h.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := by
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have e4 : (SheafOfModules.unitHomEquiv _ (wcHMConst X ℓ c ≫ h)).1 (Opposite.op V) =
        r • (h.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := by
      rw [e1, hval, eLin]
    let φr : C(↥(Limits.pullback V.hom xb), ULift.{u+1} ℚ_[ℓ]) :=
      (Dx.φ.hom.app (Opposite.op V)).hom r
    have e5 : sec h V = (h.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := e3
    have key : sec (wcHMConst X ℓ c ≫ h) V = φr * sec h V := by
      refine Eq.trans ?_ (congrArg
        (fun m : C(↥(Limits.pullback V.hom xb), ULift.{u+1} ℚ_[ℓ]) => φr * m) e5.symm)
      exact e4
    have hφr : φr = (ContinuousMap.const _ (ULift.up c) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])).comp
        (Limits.pullback.fst V.hom xb).base.hom := hDx V r
    rw [key, hφr]
    rfl

  have hext2 : ∀ f g : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx,
      (∀ (V : X.ProEt) (p : ↥(Limits.pullback V.hom xb)),
        (sec f V p).down = (sec g V p).down) → f = g := by
    intro f g H
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    show sec f V.unop = sec g V.unop
    exact ContinuousMap.ext fun p => ULift.ext _ _ (H V.unop p)

  let ι := wcSuppUnitMap Dx
  have hb' : (sec ι T q0).down ≠ 0 := by
    let v : C(↥(Limits.pullback (𝟙 X) xb), ULift.{u+1} ℚ_[ℓ]) :=
      (SheafOfModules.unitHomEquiv _ ι).1 (Opposite.op T)
    let ones : (wcSuppObj Dx).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj Dx).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom xb), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dx.cont Dx.φ).obj
          (SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj Dx)).symm ones
    let c : SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf (Spec (.of Ω)) ℓ) :=
      Dx.μ.inv ≫ (Dx.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap Dx = Dx.adj.homEquiv _ _ Dx.μ.hom :=
      (Dx.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap Dx ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dx.cont Dx.φ).map c = ρ₁ := by
      rw [h2]
      refine (Dx.adj.homEquiv_naturality_right Dx.μ.hom c).symm.trans ?_
      have e3 : Dx.μ.hom ≫ c = (Dx.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W : (Spec (.of Ω)).ProEt := (wcProEtBC xb).obj T
    let hh : C(↥(Limits.pullback (𝟙 X) xb), ULift.{u+1} ℚ_[ℓ]) :=
      (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 X) xb), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj Dx) ρ₁).1 (Opposite.op T) =
        (1 : C(↥(Limits.pullback (𝟙 X) xb), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj Dx)
        ((SheafOfModules.unitHomEquiv (wcSuppObj Dx)).symm ones)).1 (Opposite.op T) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj Dx) (wcSuppUnitMap Dx ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC xb) _ _ Dx.cont Dx.φ).map c)).1
          (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
    have eLin : (c.val.app (Opposite.op W)).hom v = v * hh := by
      have hs := (c.val.app (Opposite.op W)).hom.map_smul
        (v : (wcRingSheaf (Spec (.of Ω)) ℓ).obj.obj (Opposite.op W))
        (1 : C(↥(Limits.pullback (𝟙 X) xb), ULift.{u+1} ℚ_[ℓ]))
      exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
    have hvh : v * hh = 1 :=
      eLin.symm.trans (eL.symm.trans ((congrArg
        (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj Dx) f).1 (Opposite.op T)) hc).trans eR))
    intro hb0
    have hpt := congrArg (fun f : C(↥(Limits.pullback (𝟙 X) xb), ULift.{u+1} ℚ_[ℓ]) =>
      (f q0).down) hvh
    change (v q0).down * (hh q0).down = 1 at hpt
    change (v q0).down = 0 at hb0
    rw [hb0, zero_mul] at hpt
    exact zero_ne_one hpt

  obtain ⟨b, hbdef⟩ : ∃ b : ℚ_[ℓ], b = (sec ι T q0).down := ⟨_, rfl⟩
  obtain ⟨a, hadef⟩ : ∃ a : ℚ_[ℓ], a = (sec h₀ T q0).down := ⟨_, rfl⟩
  have hb : b ≠ 0 := hbdef ▸ hb'
  have hval_all : ∀ (h : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx) (V : X.ProEt)
      (p : ↥(Limits.pullback V.hom xb)), (sec h V p).down = (sec h T q0).down :=
    fun h V p => congrArg ULift.down (hfac h V p)
  have ha : a ≠ 0 := by
    intro ha0
    apply hh₀
    apply hext2
    intro V p
    rw [hval_all h₀ V p, ← hadef, ha0]
    have hz : (0 : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx) =
        wcHMConst X ℓ 0 ≫ (0 : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj Dx) :=
      Limits.comp_zero.symm
    rw [hz, hscal, zero_mul]
  have hclaim : h₀ = wcHMConst X ℓ (a * b⁻¹) ≫ ι := by
    apply hext2
    intro V p
    rw [hscal, hval_all h₀ V p, hval_all ι V p, ← hadef, ← hbdef]
    exact (inv_mul_cancel_right₀ hb a).symm

  have hextU : ∀ f g : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf X ℓ),
      (∀ Y, (SheafOfModules.unitHomEquiv _ f).1 Y = (SheafOfModules.unitHomEquiv _ g).1 Y) →
        f = g := by
    intro f g h
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext Y
    exact h Y
  have hidU : ∀ Y, (SheafOfModules.unitHomEquiv _
      (𝟙 (SheafOfModules.unit (wcRingSheaf X ℓ)))).1 Y =
      (ContinuousMap.const _ (ULift.up 1) :
        C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro Y
    simp only [SheafOfModules.unitHomEquiv_apply_coe]
    rfl
  have hcompU : ∀ (x y : ℚ_[ℓ]) Y,
      (SheafOfModules.unitHomEquiv _ (wcHMConst X ℓ x ≫ wcHMConst X ℓ y)).1 Y =
      ((1 * ContinuousMap.const _ (ULift.up x)) * ContinuousMap.const _ (ULift.up y) :
        C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro x y Y
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    rfl
  have hinvU : ∀ x y : ℚ_[ℓ], x * y = 1 → wcHMConst X ℓ x ≫ wcHMConst X ℓ y = 𝟙 _ := by
    intro x y hxy
    apply hextU
    intro Y
    rw [hcompU, hidU]
    apply ContinuousMap.ext
    intro p
    apply ULift.ext
    show 1 * x * y = 1
    rw [one_mul, hxy]
  have hc : a * b⁻¹ ≠ 0 := mul_ne_zero ha (inv_ne_zero hb)
  exact ⟨Iso.mk (wcHMConst X ℓ (a * b⁻¹)) (wcHMConst X ℓ (a * b⁻¹)⁻¹)
    (hinvU _ _ (mul_inv_cancel₀ hc)) (hinvU _ _ (inv_mul_cancel₀ hc)), hclaim⟩

theorem wc_pmn_cone_cocycle_lift {𝒞₁ 𝒞₂ 𝒞₃ : Type (u+2)} [Category.{u+1} 𝒞₁]
    [Category.{u+1} 𝒞₂] [Category.{u+1} 𝒞₃] [Abelian 𝒞₁] [Abelian 𝒞₂] [Abelian 𝒞₃]
    [HasExt 𝒞₁] [HasDerivedCategory 𝒞₃] (F₁ : 𝒞₁ ⥤ 𝒞₂) (F₂ : 𝒞₂ ⥤ 𝒞₃)
    [F₁.Additive] [F₂.Additive] (Y : 𝒞₁) (I : InjectiveResolution Y) (One : 𝒞₃)
    (a : One ⟶ F₂.obj (F₁.obj Y))
    (eΨ : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj One ⟶
      (F₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((F₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex))
    (N p : ℕ) (hp : p + 1 = N) (f : Y ⟶ I.cocomplex.X N)
    (hf : f ≫ I.cocomplex.d N (N + 1) = 0) (Ps : 𝒞₃) [Projective Ps] (ε : Ps ⟶ One) :
    let F := F₁ ⋙ F₂
    let Ψ := (F₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((F₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
    let Hq := HomotopyCategory.quotient 𝒞₃ (ComplexShape.up ℤ)
    let Hq' := HomotopyCategory.quotient 𝒞₁ (ComplexShape.up ℤ)
    let c := fun y : Abelian.Ext Y Y N =>
      (show Hq.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj One) ⟶
          (Hq.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        Hq.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map a) ≫
          Hq.map ((HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).inv.app
              Y) ≫
          (F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            (CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y)) ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            ((Hq'.commShiftIso ((N : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
          ((F.mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso ((N : ℕ) : ℤ)).hom.app
            (Hq'.obj I.cochainComplex) ≫
          ((F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app
            I.cochainComplex)⟦((N : ℕ) : ℤ)⟧' ≫
          (Hq.map ((Functor.mapHomologicalComplexCompIso (Iso.refl F) (ComplexShape.up ℤ)).inv.app
              I.cochainComplex))⟦((N : ℕ) : ℤ)⟧')
    let β := fun y : Abelian.Ext Y Y N =>
      (show DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj One) ⟶
          (DerivedCategory.Q.obj Ψ)⟦((N : ℕ) : ℤ)⟧ from
        (DerivedCategory.quotientCompQhIso _).inv.app _ ≫ DerivedCategory.Qh.map (c y) ≫
          (DerivedCategory.Qh.commShiftIso ((N : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
          ((DerivedCategory.quotientCompQhIso _).hom.app Ψ)⟦((N : ℕ) : ℤ)⟧')
    β (I.extMk f (N + 1) rfl hf) ≫
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦((N : ℕ) : ℤ)⟧' = 0 →
      ∃ h : Ps ⟶ F₂.obj (F₁.obj (I.cocomplex.X p)),
        h ≫ F₂.map (F₁.map (I.cocomplex.d p N)) = ε ≫ a ≫ F₂.map (F₁.map f) :=
by
  intro F Ψ Hq Hq' c β hzero




  have s1 : ∀ {V V' W : Type (u+2)} [Category.{u+1} V] [Category.{u+1} V'] [Category.{u+1} W]
      [Preadditive V] [Preadditive V'] [Preadditive W]
      [Limits.HasZeroObject V] [Limits.HasZeroObject V'] [Limits.HasZeroObject W]
      (F1 : V ⥤ V') (F2 : V' ⥤ W) [F1.Additive] [F2.Additive]
      {A : W} {X : V} (v : A ⟶ (F1 ⋙ F2).obj X) (L : CochainComplex V ℤ) (n : ℤ)
      (φ : (HomologicalComplex.single V (ComplexShape.up ℤ) 0).obj X ⟶ L⟦n⟧)
      (x : (HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj
          ((HomologicalComplex.single V (ComplexShape.up ℤ) 0).obj X) ⟶
        (HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj
          ((shiftFunctor (HomologicalComplex V (ComplexShape.up ℤ)) n).obj L)),
      (HomotopyCategory.quotient V (ComplexShape.up ℤ)).map φ = x →
      (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.single W (ComplexShape.up ℤ) 0).map v) ≫
        (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((HomologicalComplex.singleMapHomologicalComplex (F1 ⋙ F2) (ComplexShape.up ℤ) 0).inv.app
            X) ≫
        ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
        ((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).map x ≫
        ((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).map
          (((HomotopyCategory.quotient V (ComplexShape.up ℤ)).commShiftIso n).hom.app L) ≫
        (((F1 ⋙ F2).mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso n).hom.app
          ((HomotopyCategory.quotient V (ComplexShape.up ℤ)).obj L) ≫
        (((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app L)⟦n⟧' ≫
        ((HomotopyCategory.quotient W (ComplexShape.up ℤ)).map
          ((Functor.mapHomologicalComplexCompIso (Iso.refl (F1 ⋙ F2)) (ComplexShape.up ℤ)).inv.app
            L))⟦n⟧' =
      (HomotopyCategory.quotient W (ComplexShape.up ℤ)).map (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map v ≫ (HomologicalComplex.singleMapHomologicalComplex (F1 ⋙ F2) (ComplexShape.up ℤ) 0).inv.app (X) ≫ ((F1 ⋙ F2).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫ (((F1 ⋙ F2).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫ ((Functor.mapHomologicalComplexCompIso (Iso.refl (F1 ⋙ F2)) (ComplexShape.up ℤ)).inv.app L)⟦n⟧')) ≫
        ((HomotopyCategory.quotient W (ComplexShape.up ℤ)).commShiftIso n).hom.app _ := by
    intro V V' W _ _ _ _ _ _ _ _ _ F1 F2 _ _ A X v L n φ x hx
    subst hx
    have hinv : ∀ K, ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app K =
        𝟙 _ := by
      intro K
      have := ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom_inv_id_app K
      rwa [Functor.mapHomotopyCategoryFactors_hom_app, Category.id_comp] at this
    have hsh := NatTrans.shift_app_comm
      ((F1 ⋙ F2).mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom n L
    simp only [Functor.mapHomotopyCategoryFactors_hom_app, CategoryTheory.Functor.map_id,
      Functor.commShiftIso_comp_hom_app] at hsh
    simp only [Functor.mapHomotopyCategoryFactors_hom_app, hinv]
    rw [reassoc_of% hsh]
    simp only [Functor.map_comp, Category.assoc]
    rw [Functor.commShiftIso_hom_naturality]
    erw [Category.id_comp]
    erw [CategoryTheory.Functor.map_id]
    erw [Category.id_comp]
    rfl



  have s2 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (A Ψ₀ : CochainComplex 𝒞 ℤ) (n : ℤ) (g : A ⟶ Ψ₀⟦n⟧),
      (DerivedCategory.quotientCompQhIso 𝒞).inv.app A ≫
        DerivedCategory.Qh.map ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).map g ≫
          ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).commShiftIso n).hom.app Ψ₀) ≫
        (DerivedCategory.Qh.commShiftIso n).hom.app
          ((HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)).obj Ψ₀) ≫
        ((DerivedCategory.quotientCompQhIso 𝒞).hom.app Ψ₀)⟦n⟧' =
      DerivedCategory.Q.map g ≫ (DerivedCategory.Q.commShiftIso n).hom.app Ψ₀ := by
    intro 𝒞 _ _ _ A Ψ₀ n g
    have h3 := NatTrans.shift_app_comm (DerivedCategory.quotientCompQhIso 𝒞).hom n Ψ₀
    rw [Functor.commShiftIso_comp_hom_app] at h3
    simp only [Category.assoc] at h3
    have h4 := (DerivedCategory.quotientCompQhIso 𝒞).inv.naturality g
    simp only [Functor.comp_map] at h4
    rw [Functor.map_comp, Category.assoc, h3, ← reassoc_of% h4, Iso.inv_hom_id_app_assoc]



  have s3 : ∃ φ : (HomologicalComplex.single 𝒞₁ (ComplexShape.up ℤ) 0).obj Y ⟶
        I.cochainComplex⟦((N : ℕ) : ℤ)⟧,
      (HomotopyCategory.quotient 𝒞₁ (ComplexShape.up ℤ)).map φ =
        CochainComplex.HomComplex.CohomologyClass.homAddEquiv
          (I.extEquivCohomologyClass (I.extMk f (N + 1) rfl hf)) ∧
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Y).inv ≫ φ.f 0 ≫
        (I.cochainComplex.shiftFunctorObjXIso ((N : ℕ) : ℤ) 0 ((N : ℕ) : ℤ)
          (zero_add _).symm).hom =
        f ≫ (I.cochainComplexXIso ((N : ℕ) : ℤ) N rfl).inv := by
    rw [InjectiveResolution.extEquivCohomologyClass_extMk,
      CochainComplex.HomComplex.CohomologyClass.homAddEquiv_apply,
      CochainComplex.HomComplex.CohomologyClass.toHom_mk]
    refine ⟨_, rfl, ?_⟩
    rw [CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply,
      CochainComplex.HomComplex.Cocycle.homOf_f,
      CochainComplex.HomComplex.Cocycle.rightShift_coe,
      CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 _ ((N : ℕ) : ℤ) (by simp),
      CochainComplex.HomComplex.Cocycle.fromSingleMk_coe,
      CochainComplex.HomComplex.Cochain.fromSingleMk_v]
    simp



  have s4 : ∀ (L : CochainComplex 𝒞₁ ℤ) (n : ℤ)
      (φ : (HomologicalComplex.single 𝒞₁ (ComplexShape.up ℤ) 0).obj Y ⟶ L⟦n⟧),
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 One).inv ≫
        ((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).map a ≫
          (HomologicalComplex.singleMapHomologicalComplex (F₁ ⋙ F₂) (ComplexShape.up ℤ) 0).inv.app
            Y ≫
          ((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
          (((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app L ≫
          ((Functor.mapHomologicalComplexCompIso (Iso.refl (F₁ ⋙ F₂)) (ComplexShape.up ℤ)).inv.app
            L)⟦n⟧').f 0 =
      a ≫ F₂.map (F₁.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Y).inv ≫
        φ.f 0)) := by
    intro L n φ
    simp only [HomologicalComplex.comp_f, HomologicalComplex.single_map_f_self,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
      Functor.mapHomologicalComplex_map_f, Functor.mapHomologicalComplex_commShiftIso_hom_app_f,
      CochainComplex.shiftFunctor_map_f', Functor.mapHomologicalComplexCompIso_inv_app_f,
      Iso.refl_inv, NatTrans.id_app, Category.assoc, Iso.inv_hom_id_assoc, Functor.comp_map,
      Functor.map_comp]
    repeat erw [Category.comp_id]
    try erw [Iso.inv_hom_id_assoc]



  have s5 : ∀ (A : 𝒞₃) [Projective A] (L : CochainComplex 𝒞₃ ℤ)
      (ψ : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj A ⟶ L),
      DerivedCategory.Q.map ψ = 0 → Nonempty (Homotopy ψ 0) := by
    intro A _ L ψ h
    have hproj : ∀ n,
        Projective (((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj A).X n) := by
      intro n
      by_cases hn : n = 0
      · subst hn
        exact Projective.of_iso (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 A).symm
          inferInstance
      · exact Projective.of_iso
          (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 A n hn).isoZero.symm
          Projective.zero_projective
    have hKP : CochainComplex.IsKProjective
        ((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj A) :=
      CochainComplex.isKProjective_of_projective _ 0
    rw [← HomotopyCategory.quotient_map_eq_zero_iff]
    apply (CochainComplex.IsKProjective.Qh_map_bijective _
      ((HomotopyCategory.quotient 𝒞₃ (ComplexShape.up ℤ)).obj L)).1
    rw [Functor.map_zero]
    have hn := (DerivedCategory.quotientCompQhIso 𝒞₃).hom.naturality ψ
    simp only [Functor.comp_map, h, Limits.comp_zero] at hn
    exact (Preadditive.IsIso.comp_right_eq_zero _ _).mp hn



  have s6 : ∀ (K Ψ' : CochainComplex 𝒞₃ ℤ) (e : K ⟶ Ψ') (M : ℤ) (_ : M ≠ 0)
      (_ : ∀ i : ℤ, i ≠ 0 → Limits.IsZero (K.X i)) (A : 𝒞₃)
      (ψ : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj A ⟶ Ψ'⟦M⟧)
      (_ : Homotopy (ψ ≫ (CochainComplex.mappingCone.inr e)⟦M⟧') 0),
      ∃ k : A ⟶ Ψ'.X (M - 1), k ≫ Ψ'.d (M - 1) M =
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 A).inv ≫ ψ.f 0 ≫
          (Ψ'.shiftFunctorObjXIso M 0 M (zero_add M).symm).hom := by
    intro K Ψ' e M hM hK A ψ H
    have h1 := H.comm 0
    have hd : dNext 0 H.hom = 0 := by
      rw [dNext_eq H.hom (show (ComplexShape.up ℤ).Rel 0 1 by simp)]
      simp
    have hp' : prevD 0 H.hom = H.hom 0 (-1) ≫
        ((CochainComplex.mappingCone e)⟦M⟧).d (-1) 0 :=
      prevD_eq H.hom (show (ComplexShape.up ℤ).Rel (-1) 0 by simp)
    rw [hd, hp', zero_add, HomologicalComplex.zero_f, add_zero, HomologicalComplex.comp_f,
      CochainComplex.shiftFunctor_map_f', CochainComplex.shiftFunctor_obj_d'] at h1
    have h2 := congrArg (fun z => z ≫ (CochainComplex.mappingCone.snd e).v (0 + M) (0 + M)
      (add_zero _)) h1
    simp only [Category.assoc, CochainComplex.mappingCone.inr_f_snd_v,
      Linear.comp_units_smul, Linear.units_smul_comp] at h2
    erw [Category.comp_id] at h2
    rw [CochainComplex.mappingCone.d_snd_v e (-1 + M) (0 + M) (by omega)] at h2
    have hz : e.f (0 + M) = 0 := (hK (0 + M) (by omega)).eq_of_src _ _
    rw [hz, Limits.comp_zero, zero_add ((CochainComplex.mappingCone.snd e).v (-1 + M) (-1 + M)
      (add_zero _) ≫ Ψ'.d (-1 + M) (0 + M))] at h2
    refine ⟨M.negOnePow • ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 A).inv ≫
      H.hom 0 (-1) ≫ (CochainComplex.mappingCone.snd e).v (-1 + M) (-1 + M) (add_zero _) ≫
      (Ψ'.XIsoOfEq (show -1 + M = M - 1 by omega)).hom), ?_⟩
    rw [Linear.units_smul_comp]
    simp only [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d]
    rw [h2, CochainComplex.shiftFunctorObjXIso.eq_1]
    simp only [Linear.units_smul_comp, Linear.comp_units_smul, Category.assoc,
      HomologicalComplex.d_comp_XIsoOfEq_hom]



  obtain ⟨φ, hφq, hφ0⟩ := s3
  let g : (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).obj One ⟶ Ψ⟦((N : ℕ) : ℤ)⟧ :=
    (HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).map a ≫
      (HomologicalComplex.singleMapHomologicalComplex (F₁ ⋙ F₂) (ComplexShape.up ℤ) 0).inv.app Y ≫
      ((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
      (((F₁ ⋙ F₂).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso
        ((N : ℕ) : ℤ)).hom.app I.cochainComplex ≫
      ((Functor.mapHomologicalComplexCompIso (Iso.refl (F₁ ⋙ F₂)) (ComplexShape.up ℤ)).inv.app
        I.cochainComplex)⟦((N : ℕ) : ℤ)⟧'
  have hc : c (I.extMk f (N + 1) rfl hf) =
      Hq.map g ≫ (Hq.commShiftIso ((N : ℕ) : ℤ)).hom.app Ψ :=
    s1 F₁ F₂ a I.cochainComplex ((N : ℕ) : ℤ) φ _ hφq
  have hβ : β (I.extMk f (N + 1) rfl hf) =
      DerivedCategory.Q.map g ≫ (DerivedCategory.Q.commShiftIso ((N : ℕ) : ℤ)).hom.app Ψ := by
    refine Eq.trans ?_ (s2 _ Ψ ((N : ℕ) : ℤ) g)
    exact congrArg (fun z => (DerivedCategory.quotientCompQhIso 𝒞₃).inv.app _ ≫
      DerivedCategory.Qh.map z ≫
      (DerivedCategory.Qh.commShiftIso ((N : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
      ((DerivedCategory.quotientCompQhIso 𝒞₃).hom.app Ψ)⟦((N : ℕ) : ℤ)⟧') hc
  rw [hβ, Category.assoc, ← Functor.commShiftIso_hom_naturality, ← Category.assoc,
    Preadditive.IsIso.comp_right_eq_zero, ← Functor.map_comp] at hzero
  have hQ : DerivedCategory.Q.map
      ((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).map ε ≫ g ≫
        (CochainComplex.mappingCone.inr eΨ)⟦((N : ℕ) : ℤ)⟧') = 0 := by
    rw [Functor.map_comp, hzero, Limits.comp_zero]
  obtain ⟨H⟩ := s5 Ps _ _ hQ
  have H' : Homotopy (((HomologicalComplex.single 𝒞₃ (ComplexShape.up ℤ) 0).map ε ≫ g) ≫
      (CochainComplex.mappingCone.inr eΨ)⟦((N : ℕ) : ℤ)⟧') 0 :=
    (Homotopy.ofEq (Category.assoc _ _ _)).trans H
  have hN : ((N : ℕ) : ℤ) ≠ 0 := by omega
  obtain ⟨k, hk⟩ := s6 _ Ψ eΨ ((N : ℕ) : ℤ) hN
    (fun i hi => HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 One i hi) Ps _ H'
  rw [HomologicalComplex.comp_f, HomologicalComplex.single_map_f_self] at hk
  simp only [Category.assoc, Iso.inv_hom_id_assoc] at hk
  have hsh : (CochainComplex.shiftFunctorObjXIso Ψ ((N : ℕ) : ℤ) 0 ((N : ℕ) : ℤ)
        (zero_add _).symm).hom =
      F₂.map (F₁.map (CochainComplex.shiftFunctorObjXIso I.cochainComplex ((N : ℕ) : ℤ) 0
        ((N : ℕ) : ℤ) (zero_add _).symm).hom) := by
    simp only [CochainComplex.shiftFunctorObjXIso, HomologicalComplex.XIsoOfEq, eqToIso.hom,
      eqToHom_map]
  rw [hsh, reassoc_of% (s4 I.cochainComplex ((N : ℕ) : ℤ) φ), ← F₂.map_comp, ← F₁.map_comp,
    Category.assoc, hφ0] at hk
  have hd : Ψ.d (((N : ℕ) : ℤ) - 1) ((N : ℕ) : ℤ) =
      F₂.map (F₁.map ((I.cochainComplexXIso (((N : ℕ) : ℤ) - 1) p (by omega)).hom ≫
        I.cocomplex.d p N ≫ (I.cochainComplexXIso ((N : ℕ) : ℤ) N rfl).inv)) := by
    rw [← InjectiveResolution.cochainComplex_d]
    rfl
  rw [hd] at hk
  refine ⟨k ≫ F₂.map (F₁.map (I.cochainComplexXIso (((N : ℕ) : ℤ) - 1) p (by omega)).hom), ?_⟩
  rw [← cancel_mono (F₂.map (F₁.map (I.cochainComplexXIso ((N : ℕ) : ℤ) N rfl).inv))]
  simp only [Category.assoc, ← Functor.map_comp]
  exact hk

theorem wc_whl_unique {X S : Scheme.{u}} (f : X ⟶ S) [Flat (Limits.pullback.diagonal f)]
    (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (σ₁ σ₂ : Spec (.of A) ⟶ X)
    (h₁ : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ₁ =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ₂)
    (h₂ : σ₁ ≫ f = σ₂ ≫ f) : σ₁ = σ₂ :=
by
  classical
  set q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) with hq
  set d := Limits.pullback.lift σ₁ σ₂ h₂ with hd
  set j := Limits.pullback.snd (Limits.pullback.diagonal f) d with hj
  set p := Limits.pullback.fst (Limits.pullback.diagonal f) d with hp

  have hcl : (q ≫ σ₁) ≫ Limits.pullback.diagonal f = q ≫ d := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id,
        Category.assoc, hd, Limits.pullback.lift_fst]
    · rw [Category.assoc, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
        Category.assoc, hd, Limits.pullback.lift_snd, h₁]
  have hw : Limits.pullback.lift (q ≫ σ₁) q hcl ≫ j = q := Limits.pullback.lift_snd _ _ _
  have hV : Set.range q ⊆ Set.range j := by
    rintro x ⟨y, rfl⟩
    exact ⟨Limits.pullback.lift (q ≫ σ₁) q hcl y, by rw [← Scheme.Hom.comp_apply, hw]⟩

  have hgen : StableUnderGeneralization (Set.range j) :=
    (Flat.generalizingMap j).stableUnderGeneralization_range
  have hI : I ≤ (⊥ : Ideal A).jacobson := HenselianRing.jac

  have hsurj : Function.Surjective j := by
    intro x
    let P : PrimeSpectrum A := x
    have hne : P.asIdeal ⊔ I ≠ ⊤ := by
      intro htop
      have h1 : (1 : A) ∈ P.asIdeal ⊔ I := htop ▸ Submodule.mem_top
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
      have hu := (Ideal.mem_jacobson_bot.mp (hI hz)) (-1)
      have hzy : z * -1 + 1 = y := by linear_combination (-1 : A) * hyz
      rw [hzy] at hu
      exact P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hy hu)
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
    have hPM : P.asIdeal ≤ M := le_trans le_sup_left hle
    have hIM : I ≤ M := le_trans le_sup_right hle
    have hMbar : (Ideal.map (Ideal.Quotient.mk I) M).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hIM)
    let ybar : PrimeSpectrum (A ⧸ I) := ⟨Ideal.map (Ideal.Quotient.mk I) M, hMbar⟩
    let m : PrimeSpectrum A := ⟨M, hM.isPrime⟩
    have hqm : q ybar = m := by
      apply PrimeSpectrum.ext
      show Ideal.comap (Ideal.Quotient.mk I) (Ideal.map (Ideal.Quotient.mk I) M) = M
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr hIM]
    have hmr : m ∈ Set.range j := hV ⟨ybar, hqm⟩
    have hspec : P ⤳ m := (PrimeSpectrum.le_iff_specializes P m).mp hPM
    exact hgen hspec hmr

  have : Surjective j := ⟨hsurj⟩
  have : IsClosedImmersion j := IsClosedImmersion.of_isPreimmersion j
    (by rw [Set.range_eq_univ.mpr hsurj]; exact isClosed_univ)
  have : IsIso j := Flat.isIso_of_surjective_of_mono j
  have e1 : j ≫ d ≫ Limits.pullback.fst f f = p := by
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc,
      Limits.pullback.diagonal_fst, Category.comp_id]
  have e2 : j ≫ d ≫ Limits.pullback.snd f f = p := by
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc,
      Limits.pullback.diagonal_snd, Category.comp_id]
  have e3 : d ≫ Limits.pullback.fst f f = d ≫ Limits.pullback.snd f f :=
    (cancel_epi j).mp (e1.trans e2.symm)
  rw [hd, Limits.pullback.lift_fst, Limits.pullback.lift_snd] at e3
  exact e3

theorem wc_whl_affine_reduction (A : Type u) [CommRing A] (I : Ideal A)
    (R : Type u) [CommRing R] [Algebra A R] [Algebra.WeaklyEtale A R]
    (σb : R →ₐ[A] A ⧸ I) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Algebra.WeaklyEtale A C ∧
      ∃ (lam : R →ₐ[A] C) (ε : (C ⧸ Ideal.map (algebraMap A C) I) ≃ₐ[A] A ⧸ I),
        ∀ r : R, ε (Ideal.Quotient.mk (Ideal.map (algebraMap A C) I) (lam r)) = σb r :=
by
  classical

  have hdiag : ∀ x : TensorProduct A R R, Algebra.TensorProduct.lmul' A x = 0 →
      ∃ s : TensorProduct A R R, Algebra.TensorProduct.lmul' A s = 1 ∧ x * s = 0 := by
    intro x hx
    have hflat := Algebra.WeaklyEtale.flat_lmul' A R
    letI : Algebra (TensorProduct A R R) R :=
      (Algebra.TensorProduct.lmul' A (S := R)).toRingHom.toAlgebra
    haveI : Module.Flat (TensorProduct A R R) R := hflat
    have hsm : ∀ (t : TensorProduct A R R) (v : R), t • v = Algebra.TensorProduct.lmul' A t * v := by
      intro t v
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      rfl
    let f : Fin 1 → TensorProduct A R R := fun _ => x
    let v : Fin 1 → R := fun _ => 1
    have hsum : ∑ i, f i • v i = 0 := by
      rw [Fin.sum_univ_one]
      show x • (1 : R) = 0
      rw [hsm, hx, zero_mul]
    have htr : Module.IsTrivialRelation f v :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hsum
    unfold Module.IsTrivialRelation at htr
    obtain ⟨k, a, y, hv, hf⟩ := htr
    refine ⟨∑ j, a 0 j * (y j ⊗ₜ[A] (1 : R)), ?_, ?_⟩
    · have h1 : (1 : R) = ∑ j, a 0 j • y j := hv 0
      rw [map_sum]
      simp only [map_mul, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
      rw [h1]
      exact Finset.sum_congr rfl (fun j _ => (hsm _ _).symm)
    · rw [Finset.mul_sum]
      apply Finset.sum_eq_zero
      intro j _
      have h2 : ∑ i, f i * a i j = 0 := hf j
      rw [Fin.sum_univ_one] at h2
      rw [← mul_assoc]
      rw [show x * a 0 j = 0 from h2, zero_mul]

  have habs : ∀ r : R, σb r = 0 → ∃ w : R, σb w = 1 ∧ r * w ∈ Ideal.map (algebraMap A R) I := by
    intro r hr
    have hσIR : ∀ a ∈ Ideal.map (algebraMap A R) I, σb a = 0 := by
      intro a ha
      have hle : Ideal.map (algebraMap A R) I ≤ RingHom.ker σb := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hb
      exact (RingHom.mem_ker).mp (hle ha)
    let IR := Ideal.map (algebraMap A R) I
    let ι : A ⧸ I →ₐ[A] R ⧸ IR :=
      Ideal.quotientMapₐ IR (Algebra.ofId A R) (fun a ha => Ideal.mem_map_of_mem _ ha)
    let σt : R ⧸ IR →ₐ[A] A ⧸ I := Ideal.Quotient.liftₐ IR σb hσIR
    have hσtq : ∀ a : R, σt (Ideal.Quotient.mk IR a) = σb a := fun a => rfl
    have hι : ∀ a : A, ι (Ideal.Quotient.mk I a) = Ideal.Quotient.mk IR (algebraMap A R a) :=
      fun a => rfl
    have hσtι : ∀ z : A ⧸ I, σt (ι z) = z := by
      intro z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [hι, hσtq, AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    let Φ : TensorProduct A R R →ₐ[A] R ⧸ IR :=
      Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ A IR) (ι.comp σb)
        (fun _ _ => Commute.all _ _)
    have hkey : ∀ t, σt (Φ t) = σb (Algebra.TensorProduct.lmul' A t) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        rw [Algebra.TensorProduct.lift_tmul, map_mul, Ideal.Quotient.mkₐ_eq_mk, hσtq,
          AlgHom.comp_apply, hσtι, Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
    have hx : Algebra.TensorProduct.lmul' A (r ⊗ₜ[A] (1 : R) - (1 : R) ⊗ₜ[A] r) = 0 := by
      rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
        mul_one, one_mul, sub_self]
    obtain ⟨s, hs1, hs0⟩ := hdiag _ hx
    have hΦx : Φ (r ⊗ₜ[A] (1 : R) - (1 : R) ⊗ₜ[A] r) = Ideal.Quotient.mk IR r := by
      rw [map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
        AlgHom.comp_apply, AlgHom.comp_apply, hr, map_one, map_zero, map_one, mul_one, mul_zero,
        sub_zero, Ideal.Quotient.mkₐ_eq_mk]
    obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (Φ s)
    refine ⟨w, ?_, ?_⟩
    · rw [← hσtq, hw, hkey, hs1, map_one]
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hw, ← hΦx, ← map_mul, hs0, map_zero]

  obtain ⟨M, hMmem⟩ : ∃ M : Submonoid R, ∀ y, y ∈ M ↔ σb y = 1 :=
    ⟨(⊥ : Submonoid (A ⧸ I)).comap σb, fun y => by simp⟩

  have hloc : Algebra.WeaklyEtale R (Localization M) := by
    have hc : TensorProduct.CompatibleSMul R (Localization M) (Localization M) (Localization M) :=
      IsLocalization.tensorProduct_compatibleSMul M (Localization M) (Localization M)
        (Localization M)
    have key : ∀ z : TensorProduct R (Localization M) (Localization M),
        z = (Algebra.TensorProduct.lmul' R (S := Localization M) z) ⊗ₜ[R]
          (1 : Localization M) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, TensorProduct.zero_tmul]
      | tmul a b =>
        rw [Algebra.TensorProduct.lmul'_apply_tmul]
        have h := TensorProduct.smul_tmul (R := R) b a (1 : Localization M)
        rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
        exact h.symm
      | add x y hx hy =>
        rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
    have hbij : Function.Bijective (Algebra.TensorProduct.lmul' R (S := Localization M)) := by
      refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[R] (1 : Localization M), ?_⟩⟩
      · rw [key z₁, key z₂, h]
      · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
    exact Algebra.WeaklyEtale.mk (IsLocalization.flat (Localization M) M)
      (RingHom.Flat.of_bijective
        (f := (Algebra.TensorProduct.lmul' R (S := Localization M)).toRingHom) hbij)
  have hWE : Algebra.WeaklyEtale A (Localization M) := Algebra.WeaklyEtale.trans A R (Localization M)
  have hu : ∀ y : M, IsUnit (σb y) := fun y => by rw [(hMmem y).1 y.2]; exact isUnit_one
  let σC : Localization M →ₐ[A] A ⧸ I :=
    IsLocalization.liftAlgHom (M := M) (S := Localization M) (f := σb) hu
  have hσC : ∀ r : R, σC (algebraMap R (Localization M) r) = σb r := by
    intro r
    simp [σC, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
  let IC := Ideal.map (algebraMap A (Localization M)) I
  have hσCIC : ∀ a ∈ IC, σC a = 0 := by
    intro a ha
    have hle : IC ≤ RingHom.ker σC := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hb
    exact (RingHom.mem_ker).mp (hle ha)
  let ε₀ : (Localization M ⧸ IC) →ₐ[A] A ⧸ I := Ideal.Quotient.liftₐ IC σC hσCIC
  have hε₀ : ∀ c : Localization M, ε₀ (Ideal.Quotient.mk IC c) = σC c := fun c => rfl
  have hsurj : Function.Surjective ε₀ := by
    intro z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine ⟨Ideal.Quotient.mk IC (algebraMap A (Localization M) a), ?_⟩
    rw [hε₀, AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hinj : Function.Injective ε₀ := by
    rw [injective_iff_map_eq_zero]
    intro ξ hξ
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective ξ
    rw [hε₀] at hξ
    obtain ⟨⟨x, y⟩, rfl⟩ := IsLocalization.mk'_surjective M c
    have hspec := IsLocalization.mk'_spec (Localization M) x y
    have hx0 : σb x = 0 := by
      rw [← hσC, ← hspec, map_mul, hξ, zero_mul]
    obtain ⟨w, hw1, hxw⟩ := habs x hx0
    have hyw : (y : R) * w ∈ M := (hMmem _).2 (by rw [map_mul, (hMmem _).1 y.2, hw1, one_mul])
    obtain ⟨u, hu'⟩ := IsLocalization.map_units (Localization M) (⟨(y : R) * w, hyw⟩ : M)
    have hmap : Ideal.map (algebraMap R (Localization M)) (Ideal.map (algebraMap A R) I) = IC := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    have hmem : algebraMap R (Localization M) (x * w) ∈ IC := by
      rw [← hmap]
      exact Ideal.mem_map_of_mem _ hxw
    have heq : IsLocalization.mk' (Localization M) x y * algebraMap R (Localization M) ((y : R) * w)
        = algebraMap R (Localization M) (x * w) := by
      rw [map_mul, ← mul_assoc, hspec, map_mul]
    rw [Ideal.Quotient.eq_zero_iff_mem]
    have hdecomp : IsLocalization.mk' (Localization M) x y =
        (IsLocalization.mk' (Localization M) x y * algebraMap R (Localization M) ((y : R) * w))
          * ((u⁻¹ : (Localization M)ˣ) : Localization M) := by
      rw [show algebraMap R (Localization M) ((y : R) * w) = (u : Localization M) from hu'.symm,
        mul_assoc, Units.mul_inv, mul_one]
    show IsLocalization.mk' (Localization M) x y ∈ IC
    rw [hdecomp, heq]
    exact Ideal.mul_mem_right _ _ hmem
  let ε := AlgEquiv.ofBijective ε₀ ⟨hinj, hsurj⟩
  refine ⟨Localization M, inferInstance, inferInstance, hWE,
    IsScalarTower.toAlgHom A R (Localization M), ε, fun r => ?_⟩
  show σC (algebraMap R (Localization M) r) = σb r
  exact hσC r

theorem wc_hte_henselization (A₀ : Type u) [CommRing A₀] (I₀ : Ideal A₀) (B : Type u) [CommRing B]
    [Algebra (A₀ ⧸ I₀) B] (hB : wcIndEtale (algebraMap (A₀ ⧸ I₀) B)) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra A₀ A) (θ : (A ⧸ I₀.map (algebraMap A₀ A)) ≃+* B),
      Algebra.WeaklyEtale A₀ A ∧ HenselianRing A (I₀.map (algebraMap A₀ A)) ∧
      θ.toRingHom.comp (Ideal.quotientMap (I₀.map (algebraMap A₀ A)) (algebraMap A₀ A) Ideal.le_comap_map) =
        algebraMap (A₀ ⧸ I₀) B :=
by
  classical

  have construction : ∀ (S B : Type u) [CommRing S] [CommRing B] [Algebra S B],
      ∃ (R : Type u) (_ : CommRing R) (σ : S →+* R) (ρ : R →+* B), ρ.comp σ = algebraMap S B ∧
        (∀ r : R, IsUnit (ρ r) → IsUnit r) ∧ wcIndEtale σ ∧
        (letI := σ.toAlgebra; ∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E →
          ∀ ψ : E →ₐ[S] B, ∃ κ : E →ₐ[S] R, ρ.comp (κ : E →+* R) = (ψ : E →+* B)) := by
    intro S B _ _ _
    let I : Type u := Σ n : ℕ, {d : (Fin n → MvPolynomial (Fin n) S) × (Fin n → B) //
      (∃ g : MvPolynomial (Fin n) S, g * (Matrix.of fun a b => MvPolynomial.pderiv a (d.1 b)).det - 1
        ∈ Ideal.span (Set.range d.1)) ∧ ∀ j, MvPolynomial.aeval d.2 (d.1 j) = 0}
    let nI : I → ℕ := fun i => i.1
    let fI : ∀ i, Fin (nI i) → MvPolynomial (Fin (nI i)) S := fun i => i.2.1.1
    let V := Σ i : I, Fin (nI i)
    let J : Ideal (MvPolynomial V S) := Ideal.span (Set.range (fun p : V =>
      MvPolynomial.rename (fun k : Fin (nI p.1) => (⟨p.1, k⟩ : V)) (fI p.1 p.2)))
    let A := MvPolynomial V S ⧸ J
    have hSA : wcIndEtale (algebraMap S A) :=
      wc_sh_family_indEtale S I nI fI (fun i => i.2.2.1)
    let φ₀ : MvPolynomial V S →ₐ[S] B := MvPolynomial.aeval (fun v : V => v.1.2.1.2 v.2)
    have hJ : ∀ a ∈ J, φ₀ a = 0 := by
      intro a ha
      have hle : J ≤ RingHom.ker φ₀ := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨p, rfl⟩
        change φ₀ _ = 0
        simp only [φ₀, MvPolynomial.aeval_rename]
        exact p.1.2.2.2 p.2
      exact hle ha
    let φ : A →ₐ[S] B := Ideal.Quotient.liftₐ J φ₀ hJ
    have hφmk : ∀ p, φ (Ideal.Quotient.mk J p) = φ₀ p := fun p => rfl
    let M : Submonoid A := Submonoid.comap (φ : A →+* B) (IsUnit.submonoid B)
    obtain ⟨R, _, _, _⟩ : ∃ (R : Type u) (_ : CommRing R) (_ : Algebra A R), IsLocalization M R :=
      ⟨Localization M, inferInstance, inferInstance, inferInstance⟩
    have hAR : wcIndEtale (algebraMap A R) := wc_sh_localization_indEtale A R M
    have hMu : ∀ y : M, IsUnit ((φ : A →+* B) y) := fun y => y.2
    let ρ : R →+* B := IsLocalization.lift hMu
    have hρA : ∀ a : A, ρ (algebraMap A R a) = φ a := fun a => IsLocalization.lift_eq hMu a
    let σ : S →+* R := (algebraMap A R).comp (algebraMap S A)
    refine ⟨R, inferInstance, σ, ρ, ?_, ?_, wc_indEtale_comp _ _ hSA hAR, ?_⟩
    · ext s
      change ρ (algebraMap A R (algebraMap S A s)) = algebraMap S B s
      rw [hρA, φ.commutes]
    · intro r hr
      obtain ⟨⟨a, m⟩, rfl⟩ := IsLocalization.mk'_surjective M r
      have hspec := IsLocalization.mk'_spec R a m
      have h1 : ρ (IsLocalization.mk' R a m) * φ m = φ a := by
        rw [← hρA, ← hρA, ← map_mul, hspec]
      have hau : IsUnit (φ a) := h1 ▸ hr.mul (hMu m)
      have haM : a ∈ M := hau
      have hu : IsUnit (algebraMap A R a) := IsLocalization.map_units R (⟨a, haM⟩ : M)
      rw [← hspec] at hu
      exact (IsUnit.mul_iff.mp hu).1
    · letI := σ.toAlgebra
      intro E _ _ hE ψ
      obtain ⟨n, f, val, hsurj, hker, hJC⟩ := wc_sh_standard_presentation_fin S E hE
      let b : Fin n → B := fun k => ψ (val k)
      have hψval : ∀ p : MvPolynomial (Fin n) S,
          ψ (MvPolynomial.aeval val p) = MvPolynomial.aeval b p := by
        intro p
        have := congrArg (fun F : MvPolynomial (Fin n) S →ₐ[S] B => F p)
          (MvPolynomial.comp_aeval (R := S) val ψ)
        simpa using this
      have hroots : ∀ j, MvPolynomial.aeval b (f j) = 0 := by
        intro j
        rw [← hψval]
        have : f j ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
          rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
        rw [RingHom.mem_ker] at this
        rw [this, map_zero]
      let i : I := ⟨n, ⟨(f, b), hJC, hroots⟩⟩
      let ιAR : A →ₐ[S] R := { algebraMap A R with commutes' := fun s => rfl }
      let g₀ : MvPolynomial (Fin n) S →ₐ[S] R :=
        ιAR.comp ((Ideal.Quotient.mkₐ S J).comp
          (MvPolynomial.rename (fun k : Fin n => (⟨i, k⟩ : V))))
      have hg₀ : ∀ a ∈ RingHom.ker (MvPolynomial.aeval (R := S) val), g₀ a = 0 := by
        intro a ha
        rw [hker] at ha
        have hle : Ideal.span (Set.range f) ≤ RingHom.ker g₀ := by
          refine Ideal.span_le.mpr ?_
          rintro _ ⟨j, rfl⟩
          change ιAR (Ideal.Quotient.mkₐ S J (MvPolynomial.rename _ (f j))) = 0
          rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem.mpr, map_zero]
          exact Ideal.subset_span ⟨⟨i, j⟩, rfl⟩
        exact hle ha
      let eqv := Ideal.quotientKerAlgEquivOfSurjective hsurj
      let κ : E →ₐ[S] R := (Ideal.Quotient.liftₐ _ g₀ hg₀).comp eqv.symm.toAlgHom
      have hκ : ∀ p : MvPolynomial (Fin n) S, κ (MvPolynomial.aeval val p) = g₀ p := by
        intro p
        have he : eqv.symm (MvPolynomial.aeval val p) = Ideal.Quotient.mk _ p := by
          rw [AlgEquiv.symm_apply_eq]
          simp [eqv]
        change (Ideal.Quotient.liftₐ _ g₀ hg₀) (eqv.symm (MvPolynomial.aeval val p)) = g₀ p
        rw [he]
        rfl
      have hρS : ∀ s : S, ρ (algebraMap S R s) = algebraMap S B s := by
        intro s
        change ρ (algebraMap A R (algebraMap S A s)) = algebraMap S B s
        rw [hρA, φ.commutes]
      let ρS : R →ₐ[S] B := AlgHom.mk ρ hρS
      have hcomp : ρS.comp g₀ = ψ.comp (MvPolynomial.aeval val) := by
        apply MvPolynomial.algHom_ext
        intro k
        change ρ (algebraMap A R (Ideal.Quotient.mk J (MvPolynomial.rename _ (MvPolynomial.X k)))) =
          ψ (MvPolynomial.aeval val (MvPolynomial.X k))
        rw [hρA, hφmk, MvPolynomial.rename_X, MvPolynomial.aeval_X]
        simp [MvPolynomial.aeval_X, i, b]
      refine ⟨κ, ?_⟩
      ext x
      obtain ⟨p, rfl⟩ := hsurj x
      change ρ (κ (MvPolynomial.aeval val p)) = ψ (MvPolynomial.aeval val p)
      rw [hκ]
      exact congrArg (fun F : MvPolynomial (Fin n) S →ₐ[S] B => F p) hcomp

  have s2 : ∀ (S R B E : Type u) [CommRing S] [CommRing R] [CommRing B] [CommRing E] [Algebra S R]
      [Algebra S E], Algebra.Etale S E → ∀ (ρ : R →+* B), (∀ r : R, IsUnit (ρ r) → IsUnit r) →
      ∀ (u v : E →ₐ[S] R), ρ.comp (u : E →+* R) = ρ.comp (v : E →+* R) → u = v := by
    intro S R B E _ _ _ _ _ _ hE ρ hρ u v huv
    obtain ⟨t, ht1, ht2⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := S) (S := E)).mp inferInstance
    have hw : ∀ a, (v a - u a) * Algebra.TensorProduct.productMap u v t = 0 := by
      intro a
      have h := congrArg (Algebra.TensorProduct.productMap u v) (ht1 a)
      rw [map_mul, map_sub, Algebra.TensorProduct.productMap_apply_tmul,
        Algebra.TensorProduct.productMap_apply_tmul, map_one, map_one, one_mul, mul_one,
        map_zero] at h
      exact h
    have key : ∀ z : TensorProduct S E E, ρ (Algebra.TensorProduct.productMap u v z) =
        ρ (u (Algebra.TensorProduct.lmul' S z)) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x y =>
        rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          map_mul, map_mul, map_mul]
        have h := RingHom.congr_fun huv y
        simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe] at h
        rw [h]
      | add x y hx hy => simp only [map_add, hx, hy]
    have hρw : ρ (Algebra.TensorProduct.productMap u v t) = 1 := by
      rw [key, ht2, map_one, map_one]
    have hwu : IsUnit (Algebra.TensorProduct.productMap u v t) :=
      hρ _ (by rw [hρw]; exact isUnit_one)
    ext a
    exact (sub_eq_zero.mp (hwu.mul_left_eq_zero.mp (hw a))).symm

  have s3 : ∀ (S R B : Type u) [CommRing S] [CommRing R] [CommRing B] [Algebra S B] (σ : S →+* R)
      (ρ : R →+* B), ρ.comp σ = algebraMap S B →
      (letI := σ.toAlgebra; (∀ (n : ℕ) (r : Fin n → R), ∃ (E : Type u) (_ : CommRing E)
        (_ : Algebra S E), Algebra.Etale S E ∧ ∃ (κ : E →ₐ[S] R) (e : Fin n → E), ∀ i, κ (e i) = r i) ∧
        (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ (κ₁ κ₂ : E →ₐ[S] R),
          ρ.comp (κ₁ : E →+* R) = ρ.comp (κ₂ : E →+* R) → κ₁ = κ₂) ∧
        (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ ψ : E →ₐ[S] B,
          ∃ κ : E →ₐ[S] R, ρ.comp (κ : E →+* R) = (ψ : E →+* B))) →
      ∀ f : Polynomial R, f.Monic → ∀ b : B, (f.map ρ).eval b = 0 →
        IsUnit ((Polynomial.derivative (f.map ρ)).eval b) → ∃ x : R, f.eval x = 0 ∧ ρ x = b := by
    intro S R B _ _ _ _ σ ρ hρσ
    letI := σ.toAlgebra
    rintro ⟨H1, H2, H3⟩ f hf b hb hdb
    obtain ⟨E, _, _, hEt, κ, e, hκe⟩ := H1 f.natDegree (fun i => f.coeff i)
    let F : Polynomial E := Polynomial.X ^ f.natDegree +
      ∑ i : Fin f.natDegree, Polynomial.C (e i) * Polynomial.X ^ (i : ℕ)
    have hFm : F.Monic := Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt e)
    have hFκ : F.map (κ : E →+* R) = f := by
      conv_rhs => rw [hf.as_sum]
      simp only [F, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
        Polynomial.map_mul, Polynomial.map_C]
      congr 1
      rw [← Fin.sum_univ_eq_sum_range (fun i => Polynomial.C (f.coeff i) * Polynomial.X ^ i)
        f.natDegree]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [RingHom.coe_coe, hκe i]
    let P : StandardEtalePair E :=
      ⟨F, hFm, Polynomial.derivative F, ⟨1, 0, 1, by ring⟩⟩
    letI algSP : Algebra S P.Ring := ((algebraMap E P.Ring).comp (algebraMap S E)).toAlgebra
    haveI : IsScalarTower S E P.Ring := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.Etale S P.Ring := Algebra.Etale.comp S E P.Ring
    letI algEB : Algebra E B := (ρ.comp (κ : E →+* R)).toAlgebra
    have hmapB : ∀ q : Polynomial E,
        Polynomial.aeval b q = ((q.map (κ : E →+* R)).map ρ).eval b := by
      intro q
      rw [Polynomial.map_map, Polynomial.aeval_def, Polynomial.eval_map]
      rfl
    have hHas : P.HasMap b := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval b F = 0
        rw [hmapB, hFκ]; exact hb
      · change IsUnit (Polynomial.aeval b (Polynomial.derivative F))
        rw [hmapB, ← Polynomial.derivative_map, ← Polynomial.derivative_map, hFκ]; exact hdb
    let ψ₀ : P.Ring →ₐ[E] B := P.lift b hHas
    have hψ₀E : ∀ x : E, ψ₀ (algebraMap E P.Ring x) = ρ (κ x) := fun x => ψ₀.commutes x
    let ψ : P.Ring →ₐ[S] B :=
      { (ψ₀ : P.Ring →+* B) with
        commutes' := fun s => by
          change ψ₀ (algebraMap E P.Ring (algebraMap S E s)) = algebraMap S B s
          rw [hψ₀E, κ.commutes, ← hρσ]
          rfl }
    obtain ⟨κ'', hκ''⟩ := H3 P.Ring inferInstance ψ
    let j : E →ₐ[S] P.Ring := IsScalarTower.toAlgHom S E P.Ring
    have hj : κ''.comp j = κ := by
      apply H2 E hEt
      ext x
      have h := RingHom.congr_fun hκ'' (algebraMap E P.Ring x)
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe] at h ⊢
      change ρ (κ'' (algebraMap E P.Ring x)) = ρ (κ x)
      rw [h]
      exact hψ₀E x
    refine ⟨κ'' P.X, ?_, ?_⟩
    · have h0 : Polynomial.aeval P.X P.f = 0 := StandardEtalePair.hasMap_X.1
      rw [← hFκ, ← hj, Polynomial.eval_map]
      have := Polynomial.hom_eval₂ F (algebraMap E P.Ring) (κ'' : P.Ring →+* R) P.X
      rw [← Polynomial.aeval_def] at this
      change (κ'' : P.Ring →+* R) (Polynomial.aeval P.X F) = _ at this
      rw [show (Polynomial.aeval P.X F) = 0 from h0, map_zero] at this
      rw [this]
      rfl
    · have h := RingHom.congr_fun hκ'' P.X
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe] at h
      rw [h]
      exact P.lift_X b hHas

  have s4 : ∀ (E : Type u) [CommRing E] [Algebra A₀ E],
      Algebra.Etale A₀ E → Algebra.Etale (A₀ ⧸ I₀) (E ⧸ I₀.map (algebraMap A₀ E)) := by
    intro E _ _ hE
    haveI := hE
    let Θ : (E ⧸ I₀.map (algebraMap A₀ E)) ≃+* TensorProduct A₀ (A₀ ⧸ I₀) E :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot E I₀).toRingEquiv.trans
        (Algebra.TensorProduct.comm A₀ E (A₀ ⧸ I₀)).toRingEquiv
    have hΘ : ∀ x : A₀ ⧸ I₀, Θ (algebraMap (A₀ ⧸ I₀) (E ⧸ I₀.map (algebraMap A₀ E)) x) =
        algebraMap (A₀ ⧸ I₀) (TensorProduct A₀ (A₀ ⧸ I₀) E) x := by
      intro x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
      change Algebra.TensorProduct.comm A₀ E (A₀ ⧸ I₀)
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot E I₀
          (Ideal.Quotient.mk _ (algebraMap A₀ E a))) = _
      rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk, Algebra.TensorProduct.comm_tmul,
        ← Algebra.TensorProduct.tmul_one_eq_one_tmul]
      rfl
    let Θa : (E ⧸ I₀.map (algebraMap A₀ E)) ≃ₐ[A₀ ⧸ I₀] TensorProduct A₀ (A₀ ⧸ I₀) E :=
      AlgEquiv.ofRingEquiv (f := Θ) hΘ
    exact Algebra.Etale.of_equiv Θa.symm

  have s5 : ∀ (E D' : Type u) [CommRing E] [CommRing D'] [Algebra A₀ E]
      [Algebra (A₀ ⧸ I₀) D'], Algebra.Etale A₀ E →
      Algebra.Etale (A₀ ⧸ I₀) (E ⧸ I₀.map (algebraMap A₀ E)) →
      Algebra.Etale (A₀ ⧸ I₀) D' → ∀ (α : E →+* D'),
      (∀ a : A₀, α (algebraMap A₀ E a) = algebraMap (A₀ ⧸ I₀) D' (Ideal.Quotient.mk I₀ a)) →
      ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A₀ D) (ι : E →ₐ[A₀] D) (π : D →+* D'),
        Algebra.Etale A₀ D ∧ Function.Surjective π ∧ RingHom.ker π = I₀.map (algebraMap A₀ D) ∧
        π.comp (ι : E →+* D) = α := by
    intro E D' _ _ _ _ hE hEq hD' α hα
    haveI := hE
    haveI := hEq
    haveI := hD'
    have hαJ : I₀.map (algebraMap A₀ E) ≤ RingHom.ker α := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, hα, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
    let αb : (E ⧸ I₀.map (algebraMap A₀ E)) →+* D' :=
      Ideal.Quotient.lift (I₀.map (algebraMap A₀ E)) α (fun y hy => hαJ hy)
    letI iED : Algebra E D' := α.toAlgebra
    letI iEbD : Algebra (E ⧸ I₀.map (algebraMap A₀ E)) D' := αb.toAlgebra
    haveI : IsScalarTower E (E ⧸ I₀.map (algebraMap A₀ E)) D' :=
      IsScalarTower.of_algebraMap_eq (fun y => rfl)
    haveI : IsScalarTower (A₀ ⧸ I₀) (E ⧸ I₀.map (algebraMap A₀ E)) D' :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
        exact (hα a).symm)
    haveI : Algebra.FormallyEtale (E ⧸ I₀.map (algebraMap A₀ E)) D' :=
      Algebra.FormallyEtale.of_restrictScalars (R := A₀ ⧸ I₀)
    haveI : Algebra.FinitePresentation (E ⧸ I₀.map (algebraMap A₀ E)) D' :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation (A₀ ⧸ I₀) _ D'
    haveI : Algebra.Etale (E ⧸ I₀.map (algebraMap A₀ E)) D' := { }
    obtain ⟨D, _, _, hDE, ⟨ε⟩⟩ :=
      wc_etale_lift_quotient_global E (I₀.map (algebraMap A₀ E)) D'
    letI iAD : Algebra A₀ D := ((algebraMap E D).comp (algebraMap A₀ E)).toAlgebra
    haveI : IsScalarTower A₀ E D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.Etale A₀ D := Algebra.Etale.comp A₀ E D
    let π : D →+* D' := ε.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk _)
    refine ⟨D, inferInstance, iAD, IsScalarTower.toAlgHom A₀ E D, π, inferInstance, ?_, ?_, ?_⟩
    · intro x
      obtain ⟨y, hy⟩ := ε.surjective x
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨z, hy⟩
    · have : RingHom.ker π = (I₀.map (algebraMap A₀ E)).map (algebraMap E D) := by
        rw [RingHom.ker_comp_of_injective _ ε.toRingEquiv.injective, Ideal.mk_ker]
      rw [this, Ideal.map_map]
      rfl
    · ext y
      change ε (Ideal.Quotient.mk _ (algebraMap E D y)) = α y
      rw [Ideal.Quotient.mk_algebraMap, AlgEquiv.commutes]
      rfl

  have s6 : ∀ (R B : Type u) [CommRing R] [CommRing B] (φ : A₀ ⧸ I₀ →+* B), wcIndEtale φ →
      ∀ (σ : A₀ →+* R) (ρ : R →+* B), ρ.comp σ = φ.comp (Ideal.Quotient.mk I₀) →
      (letI := σ.toAlgebra; letI : Algebra A₀ B := (φ.comp (Ideal.Quotient.mk I₀)).toAlgebra;
        ∀ (E : Type u) [CommRing E] [Algebra A₀ E], Algebra.Etale A₀ E → ∀ ψ : E →ₐ[A₀] B,
          ∃ κ : E →ₐ[A₀] R, ρ.comp (κ : E →+* R) = (ψ : E →+* B)) →
      Function.Surjective ρ := by
    intro R B _ _ φ hB σ ρ hρσ hlift b
    letI iAR : Algebra A₀ R := σ.toAlgebra
    letI iAB : Algebra A₀ B := (φ.comp (Ideal.Quotient.mk I₀)).toAlgebra
    letI iQB : Algebra (A₀ ⧸ I₀) B := φ.toAlgebra
    obtain ⟨Eb, _, _, hEb, αb, βb, hαβ⟩ := hB (Polynomial (A₀ ⧸ I₀)) (Polynomial.aeval b)
    haveI := hEb
    have hb1 : βb (αb Polynomial.X) = b := by
      have := AlgHom.congr_fun hαβ Polynomial.X
      rw [AlgHom.comp_apply, Polynomial.aeval_X] at this
      exact this
    letI iAEb : Algebra A₀ Eb :=
      ((algebraMap (A₀ ⧸ I₀) Eb).comp (Ideal.Quotient.mk I₀)).toAlgebra
    haveI : IsScalarTower A₀ (A₀ ⧸ I₀) Eb := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨E, _, _, hE, ⟨ε⟩⟩ := wc_etale_lift_quotient_global A₀ I₀ Eb
    let ψ0 : E →+* B := (βb : Eb →+* B).comp
      (ε.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk (I₀.map (algebraMap A₀ E))))
    have hψ0 : ∀ a : A₀, ψ0 (algebraMap A₀ E a) = algebraMap A₀ B a := by
      intro a
      change βb (ε (Ideal.Quotient.mk _ (algebraMap A₀ E a))) = φ (Ideal.Quotient.mk I₀ a)
      rw [Ideal.Quotient.mk_algebraMap, AlgEquiv.commutes]
      change βb (algebraMap (A₀ ⧸ I₀) Eb (Ideal.Quotient.mk I₀ a)) = _
      rw [AlgHom.commutes]
      rfl
    let ψ : E →ₐ[A₀] B := { ψ0 with commutes' := hψ0 }
    obtain ⟨κ, hκ⟩ := hlift E hE ψ
    obtain ⟨y, hy⟩ := ε.surjective (αb Polynomial.X)
    obtain ⟨e, rfl⟩ := Ideal.Quotient.mk_surjective y
    refine ⟨κ e, ?_⟩
    have h1 := RingHom.congr_fun hκ e
    rw [show ρ (κ e) = ψ e from h1]
    change βb (ε (Ideal.Quotient.mk _ e)) = b
    rw [hy, hb1]

  have s7 : ∀ (R B : Type u) [CommRing R] [CommRing B] (φ : A₀ ⧸ I₀ →+* B), wcIndEtale φ →
      ∀ (σ : A₀ →+* R) (ρ : R →+* B), ρ.comp σ = φ.comp (Ideal.Quotient.mk I₀) → wcIndEtale σ →
      (letI := σ.toAlgebra; letI : Algebra A₀ B := (φ.comp (Ideal.Quotient.mk I₀)).toAlgebra;
        ∀ (E : Type u) [CommRing E] [Algebra A₀ E], Algebra.Etale A₀ E → ∀ ψ : E →ₐ[A₀] B,
          ∃ κ : E →ₐ[A₀] R, ρ.comp (κ : E →+* R) = (ψ : E →+* B)) →
      (letI := σ.toAlgebra; ∀ (E : Type u) [CommRing E] [Algebra A₀ E], Algebra.Etale A₀ E →
        ∀ (κ₁ κ₂ : E →ₐ[A₀] R), ρ.comp (κ₁ : E →+* R) = ρ.comp (κ₂ : E →+* R) → κ₁ = κ₂) →
      RingHom.ker ρ = I₀.map σ := by
    intro R B _ _ φ hB σ ρ hρσ hind hlift hU
    letI iAR : Algebra A₀ R := σ.toAlgebra
    letI iAB : Algebra A₀ B := (φ.comp (Ideal.Quotient.mk I₀)).toAlgebra
    letI iQB : Algebra (A₀ ⧸ I₀) B := φ.toAlgebra
    have hρσa : ∀ a : A₀, ρ (σ a) = φ (Ideal.Quotient.mk I₀ a) := fun a =>
      RingHom.congr_fun hρσ a
    have hsup : I₀.map σ ≤ RingHom.ker ρ := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, hρσa, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
    refine le_antisymm ?_ hsup
    intro r hr
    rw [RingHom.mem_ker] at hr

    obtain ⟨E, _, _, hE, α₁, κ, hακ⟩ := hind (Polynomial A₀) (Polynomial.aeval r)
    haveI := hE
    have hκe : κ (α₁ Polynomial.X) = r := by
      have := AlgHom.congr_fun hακ Polynomial.X
      rw [AlgHom.comp_apply, Polynomial.aeval_X] at this
      exact this

    haveI hEq : Algebra.Etale (A₀ ⧸ I₀) (E ⧸ I₀.map (algebraMap A₀ E)) := s4 E hE

    have hκJ : I₀.map (algebraMap A₀ E) ≤ RingHom.ker (ρ.comp (κ : E →+* R)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, RingHom.coe_coe, AlgHom.commutes]
      exact RingHom.mem_ker.mp (hsup (Ideal.mem_map_of_mem σ ha))
    let ψb0 : (E ⧸ I₀.map (algebraMap A₀ E)) →+* B :=
      Ideal.Quotient.lift _ (ρ.comp (κ : E →+* R)) (fun y hy => RingHom.mem_ker.mp (hκJ hy))
    have hψb0 : ∀ x : A₀ ⧸ I₀,
        ψb0 (algebraMap (A₀ ⧸ I₀) (E ⧸ I₀.map (algebraMap A₀ E)) x) = algebraMap (A₀ ⧸ I₀) B x := by
      intro x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
      change ρ (κ (algebraMap A₀ E a)) = φ (Ideal.Quotient.mk I₀ a)
      rw [AlgHom.commutes]
      exact hρσa a
    let ψb : (E ⧸ I₀.map (algebraMap A₀ E)) →ₐ[A₀ ⧸ I₀] B := { ψb0 with commutes' := hψb0 }
    let eb : E ⧸ I₀.map (algebraMap A₀ E) := Ideal.Quotient.mk _ (α₁ Polynomial.X)
    have hψbe : ψb eb = 0 := by
      change ρ (κ (α₁ Polynomial.X)) = 0
      rw [hκe]; exact hr

    haveI : Algebra.FinitePresentation (A₀ ⧸ I₀)
        ((E ⧸ I₀.map (algebraMap A₀ E)) ⧸ Ideal.span {eb}) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton eb)
    have hψbspan : ∀ z ∈ Ideal.span {eb}, ψb z = 0 := by
      intro z hz
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      rw [map_mul, hψbe, mul_zero]
    let ψ' : ((E ⧸ I₀.map (algebraMap A₀ E)) ⧸ Ideal.span {eb}) →ₐ[A₀ ⧸ I₀] B :=
      Ideal.Quotient.liftₐ (Ideal.span {eb}) ψb hψbspan
    obtain ⟨D', _, _, hD', α', β, hαβ'⟩ := hB _ ψ'
    haveI := hD'
    let α'' : (E ⧸ I₀.map (algebraMap A₀ E)) →ₐ[A₀ ⧸ I₀] D' :=
      α'.comp (Ideal.Quotient.mkₐ (A₀ ⧸ I₀) (Ideal.span {eb}))
    have hα''e : α'' eb = 0 := by
      change α' (Ideal.Quotient.mkₐ (A₀ ⧸ I₀) (Ideal.span {eb}) eb) = 0
      rw [Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self eb), map_zero]
    have hβα'' : ∀ z, β (α'' z) = ψb z := by
      intro z
      change β (α' (Ideal.Quotient.mkₐ (A₀ ⧸ I₀) (Ideal.span {eb}) z)) = ψb z
      have := AlgHom.congr_fun hαβ' (Ideal.Quotient.mkₐ (A₀ ⧸ I₀) (Ideal.span {eb}) z)
      rw [AlgHom.comp_apply] at this
      rw [this]
      rfl

    let α : E →+* D' := α''.toRingHom.comp (Ideal.Quotient.mk (I₀.map (algebraMap A₀ E)))
    have hα : ∀ a : A₀, α (algebraMap A₀ E a) =
        algebraMap (A₀ ⧸ I₀) D' (Ideal.Quotient.mk I₀ a) := by
      intro a
      change α'' (Ideal.Quotient.mk _ (algebraMap A₀ E a)) = _
      rw [← Ideal.Quotient.algebraMap_quotient_map_quotient, AlgHom.commutes]
    obtain ⟨D, _, _, ι, π, hD, hπs, hπk, hπι⟩ := s5 E D' hE hEq hD' α hα
    haveI := hD

    have hπι' : ∀ y : E, π (ι y) = α y := fun y => RingHom.congr_fun hπι y
    have hπA : ∀ a : A₀, π (algebraMap A₀ D a) =
        algebraMap (A₀ ⧸ I₀) D' (Ideal.Quotient.mk I₀ a) := by
      intro a
      rw [← ι.commutes a, hπι', hα]
    let ψD0 : D →+* B := (β : D' →+* B).comp π
    have hψD0 : ∀ a : A₀, ψD0 (algebraMap A₀ D a) = algebraMap A₀ B a := by
      intro a
      change β (π (algebraMap A₀ D a)) = φ (Ideal.Quotient.mk I₀ a)
      rw [hπA, AlgHom.commutes]
      rfl
    let ψD : D →ₐ[A₀] B := { ψD0 with commutes' := hψD0 }

    obtain ⟨κD, hκD⟩ := hlift D hD ψD

    have hcomp : κD.comp ι = κ := by
      apply hU E hE
      ext y
      have h1 := RingHom.congr_fun hκD (ι y)
      change ρ (κD (ι y)) = ρ (κ y)
      rw [show ρ (κD (ι y)) = ψD (ι y) from h1]
      change β (π (ι y)) = ρ (κ y)
      rw [hπι']
      change β (α'' (Ideal.Quotient.mk _ y)) = ρ (κ y)
      rw [hβα'']
      rfl

    have hιe : ι (α₁ Polynomial.X) ∈ I₀.map (algebraMap A₀ D) := by
      rw [← hπk, RingHom.mem_ker, hπι']
      exact hα''e

    have hmem : κD (ι (α₁ Polynomial.X)) ∈ I₀.map σ := by
      have := Ideal.mem_map_of_mem (κD : D →+* R) hιe
      rw [Ideal.map_map] at this
      have hc : (κD : D →+* R).comp (algebraMap A₀ D) = σ := by
        ext a
        exact κD.commutes a
      rwa [hc] at this
    rw [← hκe, ← hcomp, AlgHom.comp_apply]
    exact hmem

  have s8 : ∀ (R B : Type u) [CommRing R] [CommRing B] (ρ : R →+* B) (J : Ideal R),
      (∀ r : R, IsUnit (ρ r) → IsUnit r) → RingHom.ker ρ = J →
      (∀ f : Polynomial R, f.Monic → ∀ b : B, (f.map ρ).eval b = 0 →
        IsUnit ((Polynomial.derivative (f.map ρ)).eval b) → ∃ x : R, f.eval x = 0 ∧ ρ x = b) →
      HenselianRing R J := by
    intro R B _ _ ρ J hrefl hker hroot
    subst hker
    refine HenselianRing.mk ?_ ?_
    · intro j hj
      rw [Ideal.mem_jacobson_bot]
      intro y
      apply hrefl
      rw [map_add, map_mul, RingHom.mem_ker.mp hj, zero_mul, zero_add, map_one]
      exact isUnit_one
    · intro f hf a₀ h₀ hu
      have h1 : (f.map ρ).eval (ρ a₀) = 0 := by
        rw [Polynomial.eval_map_apply]; exact RingHom.mem_ker.mp h₀
      have h2 : IsUnit ((Polynomial.derivative (f.map ρ)).eval (ρ a₀)) := by
        rw [Polynomial.derivative_map, Polynomial.eval_map_apply]
        have := hu.map (RingHom.kerLift ρ)
        rwa [RingHom.kerLift_mk] at this
      obtain ⟨x, hx, hxb⟩ := hroot f hf (ρ a₀) h1 h2
      refine ⟨x, hx, ?_⟩
      rw [RingHom.mem_ker, map_sub, hxb, sub_self]

  letI instB : Algebra A₀ B := ((algebraMap (A₀ ⧸ I₀) B).comp (Ideal.Quotient.mk I₀)).toAlgebra
  obtain ⟨R, _, σ, ρ, hρσ, hrefl, hind, hlift⟩ := construction A₀ B
  letI iAR : Algebra A₀ R := σ.toAlgebra
  have hWE : Algebra.WeaklyEtale A₀ R := wc_indEtale_weaklyEtale σ hind
  have H1 : ∀ (n : ℕ) (r : Fin n → R), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A₀ E),
      Algebra.Etale A₀ E ∧ ∃ (κ : E →ₐ[A₀] R) (e : Fin n → E), ∀ i, κ (e i) = r i := by
    intro n r
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hind (MvPolynomial (Fin n) A₀) (MvPolynomial.aeval r)
    refine ⟨E, inferInstance, inferInstance, hE, β, fun i => α (MvPolynomial.X i), fun i => ?_⟩
    have := congrArg (fun F : MvPolynomial (Fin n) A₀ →ₐ[A₀] R => F (MvPolynomial.X i)) hαβ
    simpa using this
  have H2 : ∀ (E : Type u) [CommRing E] [Algebra A₀ E], Algebra.Etale A₀ E →
      ∀ (κ₁ κ₂ : E →ₐ[A₀] R), ρ.comp (κ₁ : E →+* R) = ρ.comp (κ₂ : E →+* R) → κ₁ = κ₂ :=
    fun E _ _ hE κ₁ κ₂ h => s2 A₀ R B E hE ρ hrefl κ₁ κ₂ h
  have hroot := s3 A₀ R B σ ρ hρσ ⟨H1, H2, hlift⟩
  have hsurj : Function.Surjective ρ := s6 R B (algebraMap (A₀ ⧸ I₀) B) hB σ ρ hρσ hlift
  have hker : RingHom.ker ρ = I₀.map σ :=
    s7 R B (algebraMap (A₀ ⧸ I₀) B) hB σ ρ hρσ hind hlift H2
  let θ : (R ⧸ I₀.map (algebraMap A₀ R)) ≃+* B :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  refine ⟨R, inferInstance, iAR, θ, hWE, s8 R B ρ (I₀.map (algebraMap A₀ R)) hrefl hker hroot, ?_⟩
  apply Ideal.Quotient.ringHom_ext
  ext a
  change ρ (σ a) = algebraMap (A₀ ⧸ I₀) B (Ideal.Quotient.mk I₀ a)
  exact RingHom.congr_fun hρσ a

theorem wc_hp_rank_one_idempotent_lift (A : Type u) [CommRing A] (I : Ideal A)
    [HenselianRing A I] (B : Type u) [CommRing B] [Algebra A B] [Module.Finite A B] (b : B)
    (hb : b * b - b ∈ I.map (algebraMap A B))
    (hrk : ∀ x : B, ∃ a : A, b * x - algebraMap A B a * b ∈ I.map (algebraMap A B)) :
    ∃ e : B, IsIdempotentElem e ∧ e - b ∈ I.map (algebraMap A B) :=
by
  classical
  have hI : I ≤ (⊥ : Ideal A).jacobson := HenselianRing.jac

  have s1 : ∃ (k : ℕ) (w : Fin (k + 2) → B), Submodule.span A (Set.range w) = ⊤ ∧ w 0 = b ∧
      ∀ j : Fin (k + 1), b * w j.succ ∈ I.map (algebraMap A B) := by
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
    let n'' : Fin (n + 1) → B := Fin.cons 1 s
    let w : Fin (n + 2) → B := Fin.cons b (fun j => n'' j - b * n'' j)
    refine ⟨n, w, ?_, rfl, ?_⟩
    · have hle : (⊤ : Submodule A B) ≤ Submodule.span A (Set.range w) ⊔ I • ⊤ := by
        rw [← hs, Submodule.span_le, hs]
        rintro _ ⟨i, rfl⟩
        obtain ⟨a, ha⟩ := hrk (s i)
        have e : s i = w i.succ.succ + a • w 0 + (b * s i - algebraMap A B a * b) := by
          simp only [w, n'', Fin.cons_succ, Fin.cons_zero, Algebra.smul_def]
          ring
        rw [SetLike.mem_coe, e]
        refine add_mem (add_mem ?_ ?_) ?_
        · exact Submodule.mem_sup_left (Submodule.subset_span ⟨_, rfl⟩)
        · exact Submodule.mem_sup_left (Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩))
        · apply Submodule.mem_sup_right
          rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
          exact ha
      exact eq_top_iff.mpr (Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hI hle)
    · intro j
      have e : b * w j.succ = -((b * b - b) * n'' j) := by
        simp only [w, Fin.cons_succ]
        ring
      rw [e]
      exact neg_mem (Ideal.mul_mem_right _ _ hb)
  obtain ⟨k, w, hspan, hw0e, hws⟩ := s1
  have hw0 : b * w 0 - w 0 ∈ I.map (algebraMap A B) := by rw [hw0e]; exact hb

  have s2 : ∃ χ : Polynomial A, χ.Monic ∧ Polynomial.aeval b χ = 0 ∧
      χ.map (Ideal.Quotient.mk I) = (Polynomial.X - 1) * Polynomial.X ^ (k + 1) := by
    let d : Fin (k + 2) → A := Fin.cons 1 (fun _ => 0)
    have hr : ∀ j, b * w j - d j • w j ∈ I • Submodule.span A (Set.range w) := by
      intro j
      rw [hspan, Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
      refine Fin.cases ?_ (fun j => ?_) j
      · simpa [d] using hw0
      · simpa [d] using hws j
    have hC : ∀ j, ∃ c : Fin (k + 2) → A, (∀ i, c i ∈ I) ∧
        ∑ i, c i • w i = b * w j - d j • w j := by
      intro j
      obtain ⟨c, hcI, hc⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum I w _).mp (hr j)
      refine ⟨c, hcI, ?_⟩
      rw [← hc, Finsupp.sum_fintype c (fun i a => a • w i) (fun i => zero_smul _ _)]
    choose C hCI hCsum using hC
    let M : Matrix (Fin (k + 2)) (Fin (k + 2)) A :=
      Matrix.diagonal d + Matrix.of (fun i j => C j i)
    have hRep : Matrix.Represents w M (Algebra.lmul A B b) := by
      rw [Matrix.represents_iff']
      intro j
      calc ∑ i, M i j • w i = ∑ i, (Matrix.diagonal d i j • w i + C j i • w i) := by
            simp only [M, Matrix.add_apply, Matrix.of_apply, add_smul]
        _ = d j • w j + (b * w j - d j • w j) := by
            rw [Finset.sum_add_distrib, hCsum]; simp [Matrix.diagonal_apply]
        _ = Algebra.lmul A B b (w j) := by rw [add_sub_cancel]; simp
    refine ⟨M.charpoly, Matrix.charpoly_monic M, ?_, ?_⟩
    · have hmem : M ∈ Matrix.isRepresentation A w := ⟨_, hRep⟩
      let M' : Matrix.isRepresentation A w := ⟨M, hmem⟩
      have hφ : Matrix.isRepresentation.toEnd A w hspan M' = Algebra.lmul A B b :=
        Matrix.Represents.eq hspan (Matrix.isRepresentation.toEnd_represents A w hspan M') hRep
      have h0 : Polynomial.aeval M' M.charpoly = 0 := by
        apply Subtype.ext
        rw [Polynomial.aeval_subalgebra_coe]
        exact Matrix.aeval_self_charpoly M
      have h1 : Polynomial.aeval (Algebra.lmul A B b) M.charpoly = 0 := by
        rw [← hφ, Polynomial.aeval_algHom_apply, h0, map_zero]
      have h2 : Algebra.lmul A B (Polynomial.aeval b M.charpoly) = 0 := by
        rw [← Polynomial.aeval_algHom_apply]; exact h1
      have h3 := LinearMap.congr_fun h2 1
      simpa using h3
    · have hMap : M.map (Ideal.Quotient.mk I) =
          Matrix.diagonal (fun i => Ideal.Quotient.mk I (d i)) := by
        ext i j
        simp only [M, Matrix.map_apply, Matrix.add_apply, Matrix.of_apply, map_add,
          Ideal.Quotient.eq_zero_iff_mem.mpr (hCI j i), add_zero, Matrix.diagonal_apply]
        split_ifs <;> simp
      rw [← Matrix.charpoly_map, hMap, Matrix.charpoly_diagonal, Fin.prod_univ_succ]
      simp [d, Finset.prod_const]
  obtain ⟨χ, hχ, hχb, hred⟩ := s2

  have s3 : ∃ (α : A) (g : Polynomial A), α - 1 ∈ I ∧
      χ = (Polynomial.X - Polynomial.C α) * g ∧
      g.map (Ideal.Quotient.mk I) = Polynomial.X ^ (k + 1) := by
    have h1 : χ.eval 1 ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Polynomial.eval_one_map, hred]
      simp
    have h2 : IsUnit (Ideal.Quotient.mk I ((Polynomial.derivative χ).eval 1)) := by
      rw [← Polynomial.eval_one_map, ← Polynomial.derivative_map, hred]
      simp [Polynomial.derivative_mul]
    obtain ⟨α, hα, hα1⟩ := HenselianRing.is_henselian χ hχ 1 h1 h2
    have hfac : (Polynomial.X - Polynomial.C α) * (χ /ₘ (Polynomial.X - Polynomial.C α)) = χ :=
      Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hα
    refine ⟨α, χ /ₘ (Polynomial.X - Polynomial.C α), hα1, hfac.symm, ?_⟩
    have hmk : Ideal.Quotient.mk I α = 1 := by
      rw [← map_one (Ideal.Quotient.mk I)]; exact Ideal.Quotient.eq.mpr hα1
    have e := congrArg (Polynomial.map (Ideal.Quotient.mk I)) hfac
    rw [Polynomial.map_mul, hred, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hmk,
      Polynomial.C_1] at e
    have hm : (Polynomial.X - 1 : Polynomial (A ⧸ I)).Monic := by
      simpa using Polynomial.monic_X_sub_C (1 : A ⧸ I)
    exact hm.isRegular.left e
  obtain ⟨α, g, hα, hfac, hg⟩ := s3
  have hroot : Polynomial.aeval b ((Polynomial.X - Polynomial.C α) * g) = 0 := by
    rw [← hfac]; exact hχb

  set J := I.map (algebraMap A B) with hJ
  have hmk : Ideal.Quotient.mk I α = 1 := by
    rw [← map_one (Ideal.Quotient.mk I)]; exact Ideal.Quotient.eq.mpr hα
  set u := g.eval α with hu
  have hu1 : u - 1 ∈ I := by
    rw [← Ideal.Quotient.eq, map_one]
    have : Ideal.Quotient.mk I u =
        (g.map (Ideal.Quotient.mk I)).eval (Ideal.Quotient.mk I α) := by
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
    rw [this, hg, hmk]; simp
  have hunit : IsUnit u := Ideal.isUnit_of_sub_one_mem_jacobson_bot u (hI hu1)
  obtain ⟨v, hv⟩ : ∃ v, u * v = 1 := hunit.exists_right_inv
  obtain ⟨r, hr⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := α) (p := g)
  set G := Polynomial.aeval b g with hG
  have hGG : G * G = algebraMap A B u * G := by
    have h1 : G - algebraMap A B u =
        Polynomial.aeval b (Polynomial.X - Polynomial.C α) * Polynomial.aeval b r := by
      rw [← map_mul, ← hr, map_sub, Polynomial.aeval_C]
    have h2 : Polynomial.aeval b (Polynomial.X - Polynomial.C α) * G = 0 := by
      rw [hG, ← map_mul]; exact hroot
    have h3 : G * G - algebraMap A B u * G = 0 := by
      calc G * G - algebraMap A B u * G = G * (G - algebraMap A B u) := by ring
        _ = (Polynomial.aeval b (Polynomial.X - Polynomial.C α) * G) *
              Polynomial.aeval b r := by rw [h1]; ring
        _ = 0 := by rw [h2, zero_mul]
    exact sub_eq_zero.mp h3
  have huv : algebraMap A B u * algebraMap A B v = 1 := by rw [← map_mul, hv, map_one]
  refine ⟨algebraMap A B v * G, ?_, ?_⟩
  · show algebraMap A B v * G * (algebraMap A B v * G) = algebraMap A B v * G
    calc algebraMap A B v * G * (algebraMap A B v * G)
        = algebraMap A B v * algebraMap A B v * (G * G) := by ring
      _ = algebraMap A B v * algebraMap A B v * (algebraMap A B u * G) := by rw [hGG]
      _ = (algebraMap A B u * algebraMap A B v) * (algebraMap A B v * G) := by ring
      _ = algebraMap A B v * G := by rw [huv, one_mul]
  · have hA : ∀ a ∈ I, algebraMap A B a ∈ J := fun a ha => Ideal.mem_map_of_mem _ ha
    have hv1 : v - 1 ∈ I := by
      have : v - 1 = -v * (u - 1) := by linear_combination hv
      rw [this]; exact I.mul_mem_left _ hu1
    have hπv : Ideal.Quotient.mk J (algebraMap A B v) = 1 := by
      rw [← map_one (Ideal.Quotient.mk J)]
      apply Ideal.Quotient.eq.mpr
      rw [← map_one (algebraMap A B), ← map_sub]
      exact hA _ hv1
    have hψ : ∀ a ∈ I, algebraMap A (B ⧸ J) a = 0 := fun a ha => by
      rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]; exact hA a ha
    let ψ := Ideal.Quotient.lift I (algebraMap A (B ⧸ J)) hψ
    have hψc : ψ.comp (Ideal.Quotient.mk I) = algebraMap A (B ⧸ J) :=
      RingHom.ext fun a => by rw [RingHom.comp_apply]; exact Ideal.Quotient.lift_mk _ _ _
    have hπG : Ideal.Quotient.mk J G = Ideal.Quotient.mk J b ^ (k + 1) := by
      have : Ideal.Quotient.mk J G = Polynomial.aeval (Ideal.Quotient.mk J b) g := by
        rw [show Ideal.Quotient.mk J b = Ideal.Quotient.mkₐ A J b from rfl,
          Polynomial.aeval_algHom_apply]
        rfl
      rw [this, Polynomial.aeval_def, ← hψc, ← Polynomial.eval₂_map, hg, Polynomial.eval₂_X_pow]
    have hpb : IsIdempotentElem (Ideal.Quotient.mk J b) := by
      show Ideal.Quotient.mk J b * Ideal.Quotient.mk J b = Ideal.Quotient.mk J b
      rw [← map_mul]; exact Ideal.Quotient.eq.mpr hb
    rw [← Ideal.Quotient.eq, map_mul, hπv, hπG, one_mul, hpb.pow_succ_eq k]

theorem wc_hp_finite_away_section_lift (A : Type u) [CommRing A] (I : Ideal A)
    (hI : I ≤ (⊥ : Ideal A).jacobson)
    (hR1 : ∀ (B : Type u) [CommRing B] [Algebra A B] [Module.Finite A B] (b : B),
      b * b - b ∈ I.map (algebraMap A B) →
      (∀ x : B, ∃ a : A, b * x - algebraMap A B a * b ∈ I.map (algebraMap A B)) →
      ∃ e : B, IsIdempotentElem e ∧ e - b ∈ I.map (algebraMap A B))
    (R : Type u) [CommRing R] [Algebra A R] [Module.Finite A R] (J : R)
    [Algebra.Etale A (Localization.Away J)] (σ₀ : Localization.Away J →ₐ[A] A ⧸ I) :
    ∃ σ : Localization.Away J →ₐ[A] A, (Ideal.Quotient.mkₐ A I).comp σ = σ₀ :=
by
  classical


  have s1 : ∀ (U : Type u) [CommRing U] [Algebra A U] [Algebra.FormallyUnramified A U]
      (σ₀ : U →ₐ[A] A ⧸ I),
      RingHom.ker σ₀ ≤ RingHom.ker σ₀ ^ 2 ⊔ I.map (algebraMap A U) := by
    intro U _ _ _ σ₀
    set K := RingHom.ker σ₀ with hKdef
    set L := K ^ 2 ⊔ I.map (algebraMap A U) with hLdef
    have hIL : ∀ a ∈ I, (Algebra.ofId A (U ⧸ L)) a = 0 := by
      intro a ha
      rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply A U (U ⧸ L),
        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha)
    let j : A ⧸ I →ₐ[A] U ⧸ L := Ideal.Quotient.liftₐ I (Algebra.ofId A (U ⧸ L)) hIL
    have hnil : IsNilpotent (K.map (Ideal.Quotient.mk L)) := by
      refine ⟨2, ?_⟩
      rw [← Ideal.map_pow, Ideal.zero_eq_bot, eq_bot_iff, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_left hx
    have heq : Ideal.Quotient.mkₐ A L = j.comp σ₀ := by
      apply Algebra.FormallyUnramified.ext (K.map (Ideal.Quotient.mk L)) hnil
      intro x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (I := I) (σ₀ x)
      have h1 : (j.comp σ₀) x = algebraMap A (U ⧸ L) a := by
        rw [AlgHom.comp_apply, ← ha, ← Ideal.Quotient.algebraMap_eq, AlgHom.commutes]
      rw [h1, Ideal.Quotient.eq, Ideal.Quotient.mkₐ_eq_mk,
        IsScalarTower.algebraMap_apply A U (U ⧸ L), Ideal.Quotient.algebraMap_eq, ← map_sub]
      apply Ideal.mem_map_of_mem
      show σ₀ (x - algebraMap A U a) = 0
      rw [map_sub, AlgHom.commutes, ← ha, Ideal.Quotient.algebraMap_eq, sub_self]
    intro u hu
    have h2 := congrArg (fun g => g u) heq
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h2
    have hu0 : σ₀ u = 0 := hu
    rw [hu0, map_zero, Ideal.Quotient.eq_zero_iff_mem] at h2
    exact h2

  have s2 : RingHom.ker σ₀ ≤ RingHom.ker σ₀ ^ 2 ⊔ I.map (algebraMap A (Localization.Away J)) →
      RingHom.ker (σ₀.comp (IsScalarTower.toAlgHom A R (Localization.Away J))) ≤
        RingHom.ker (σ₀.comp (IsScalarTower.toAlgHom A R (Localization.Away J))) ^ 2 ⊔
          I.map (algebraMap A R) := by
    intro hK
    set τ := σ₀.comp (IsScalarTower.toAlgHom A R (Localization.Away J)) with hτ
    set φ := algebraMap R (Localization.Away J) with hφ
    have hτφ : ∀ r, τ r = σ₀ (φ r) := fun r => rfl
    set 𝔞 := RingHom.ker τ with h𝔞
    have hcomap : Ideal.comap φ (RingHom.ker σ₀) = 𝔞 := by
      ext r
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker, hτφ]
    have hKmap : RingHom.ker σ₀ = Ideal.map φ 𝔞 := by
      rw [← hcomap]
      exact (IsLocalization.map_under (Submonoid.powers J) (Localization.Away J) _).symm
    have hIU : I.map (algebraMap A (Localization.Away J)) =
        Ideal.map φ (I.map (algebraMap A R)) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    have hmap : RingHom.ker σ₀ ^ 2 ⊔ I.map (algebraMap A (Localization.Away J)) =
        Ideal.map φ (𝔞 ^ 2 ⊔ I.map (algebraMap A R)) := by
      rw [Ideal.map_sup, Ideal.map_pow, ← hKmap, hIU]
    have hunit : ∀ t ∈ Submonoid.powers J, IsUnit (τ t) := by
      intro t ht
      rw [hτφ]
      exact (IsLocalization.map_units (Localization.Away J) (⟨t, ht⟩ : Submonoid.powers J)).map σ₀
    intro x hx
    have hφx : φ x ∈ Ideal.map φ (𝔞 ^ 2 ⊔ I.map (algebraMap A R)) := by
      rw [← hmap]
      apply hK
      show σ₀ (φ x) = 0
      exact hx
    obtain ⟨⟨⟨c, hc⟩, ⟨s, hs⟩⟩, hcs⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers J) (Localization.Away J)).mp hφx
    simp only at hcs
    have h0 : φ (x * s - c) = 0 := by rw [map_sub, map_mul, hcs, sub_self]
    obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers J) _ _).mp h0
    simp only at hm0
    set t := m * s with ht
    have htmem : t ∈ Submonoid.powers J := Submonoid.mul_mem _ hm hs
    have htx : t * x ∈ 𝔞 ^ 2 ⊔ I.map (algebraMap A R) := by
      have : t * x = m * c := by
        rw [ht]; linear_combination hm0
      rw [this]
      exact Ideal.mul_mem_left _ _ hc
    obtain ⟨v, hv⟩ := (hunit t htmem).exists_left_inv
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (I := I) v
    set w := algebraMap A R a with hw
    have hy : w * t - 1 ∈ 𝔞 := by
      rw [RingHom.mem_ker, map_sub, map_mul, map_one, hw, AlgHom.commutes,
        Ideal.Quotient.algebraMap_eq, ha, hv, sub_self]
    have hyx : (w * t - 1) * x ∈ 𝔞 ^ 2 := by
      rw [sq]; exact Ideal.mul_mem_mul hy hx
    have hx' : x = w * (t * x) - (w * t - 1) * x := by ring
    rw [hx']
    exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ htx) (Ideal.mem_sup_left hyx)


  have s3 : ∀ (τ : R →ₐ[A] A ⧸ I),
      RingHom.ker τ ≤ RingHom.ker τ ^ 2 ⊔ I.map (algebraMap A R) →
      ∃ b : R, b * b - b ∈ I.map (algebraMap A R) ∧ τ b = 1 ∧
        ∀ x : R, ∃ a : A, b * x - algebraMap A R a * b ∈ I.map (algebraMap A R) := by
    intro τ h
    set IR := I.map (algebraMap A R) with hIR
    set 𝔞 := RingHom.ker τ with h𝔞
    set q := Ideal.Quotient.mk IR with hq
    have hτalg : ∀ a, τ (algebraMap A R a) = Ideal.Quotient.mk I a := fun a => by
      rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    have hlift : ∀ x : R, ∃ a : A, x - algebraMap A R a ∈ 𝔞 := by
      intro x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (I := I) (τ x)
      exact ⟨a, by rw [RingHom.mem_ker, map_sub, hτalg, ha, sub_self]⟩
    have hidem : IsIdempotentElem (𝔞.map q) := by
      show 𝔞.map q * 𝔞.map q = 𝔞.map q
      apply le_antisymm Ideal.mul_le_left
      calc 𝔞.map q ≤ (𝔞 ^ 2 ⊔ IR).map q := Ideal.map_mono h
        _ = 𝔞.map q * 𝔞.map q := by
          rw [Ideal.map_sup, hq, Ideal.map_quotient_self, sup_bot_eq, Ideal.map_pow, sq]
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := R)
    choose a ha using fun i => hlift (s i)
    set g : Fin n → R := fun i => s i - algebraMap A R (a i) with hg
    have hfg : (𝔞.map q).FG := by
      have heq : 𝔞.map q = Ideal.span (Set.range (fun i => q (g i))) := by
        apply le_antisymm
        · rw [Ideal.map_le_iff_le_comap]
          intro x hx
          have hxs : x ∈ Submodule.span A (Set.range s) := by rw [hs]; exact Submodule.mem_top
          obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hxs
          have hz : algebraMap A R (∑ i, c i * a i) = x - ∑ i, algebraMap A R (c i) * g i := by
            rw [← hc]
            simp only [hg, mul_sub, Finset.sum_sub_distrib, map_sum, map_mul, Algebra.smul_def]
            ring
          have hτz : τ (algebraMap A R (∑ i, c i * a i)) = 0 := by
            rw [hz, map_sub, map_sum]
            have : ∀ i, τ (algebraMap A R (c i) * g i) = 0 := fun i => by
              rw [map_mul]
              have := ha i
              rw [RingHom.mem_ker] at this
              rw [this, mul_zero]
            simp only [this, Finset.sum_const_zero, sub_zero]
            exact hx
          rw [hτalg, Ideal.Quotient.eq_zero_iff_mem] at hτz
          have hzIR : algebraMap A R (∑ i, c i * a i) ∈ IR := Ideal.mem_map_of_mem _ hτz
          have hxeq : x = ∑ i, algebraMap A R (c i) * g i + algebraMap A R (∑ i, c i * a i) := by
            rw [hz]; ring
          rw [Ideal.mem_comap, hxeq, map_add, map_sum,
            (Ideal.Quotient.eq_zero_iff_mem).mpr hzIR, add_zero]
          refine Ideal.sum_mem _ (fun i _ => ?_)
          rw [map_mul]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
        · rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          exact Ideal.mem_map_of_mem _ (ha i)
      rw [heq]
      exact Submodule.fg_span (Set.finite_range _)
    obtain ⟨ε, hε, hεspan⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hidem
    have hεmem : ε ∈ 𝔞.map q := by rw [hεspan]; exact Submodule.mem_span_singleton_self ε
    obtain ⟨z, hz, hzε⟩ :=
      (Ideal.mem_map_iff_of_surjective q Ideal.Quotient.mk_surjective).mp hεmem
    refine ⟨1 - z, ?_, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem]
      have : (1 - z) * (1 - z) - (1 - z) = z * z - z := by ring
      rw [this, map_sub, map_mul]
      change q z * q z - q z = 0
      rw [hzε, hε.eq, sub_self]
    · rw [map_sub, map_one, (RingHom.mem_ker).mp hz, sub_zero]
    · intro x
      obtain ⟨a', ha'⟩ := hlift x
      refine ⟨a', ?_⟩
      have hd : q (x - algebraMap A R a') ∈ 𝔞.map q := Ideal.mem_map_of_mem _ ha'
      rw [hεspan, Submodule.mem_span_singleton] at hd
      obtain ⟨c, hc⟩ := hd
      rw [smul_eq_mul] at hc
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have : (1 - z) * x - algebraMap A R a' * (1 - z) =
          (1 - z) * (x - algebraMap A R a') := by ring
      rw [this, map_mul, map_sub, map_one]
      change (1 - q z) * q (x - algebraMap A R a') = 0
      rw [hzε]
      have hε' : ε * ε = ε := hε.eq
      linear_combination (ε - 1) * hc - c * hε'

  have s4 : ∀ (e : R), IsIdempotentElem e →
      IsUnit (Ideal.Quotient.mkₐ A (Ideal.span {1 - e}) J) →
      Algebra.Etale A (R ⧸ Ideal.span {1 - e}) := by
    intro e he hJ
    let lam : Localization.Away J →ₐ[A] R ⧸ Ideal.span {1 - e} :=
      IsLocalization.Away.liftAlgHom J (f := Ideal.Quotient.mkₐ A (Ideal.span {1 - e})) hJ
    have hlam : ∀ r, lam (algebraMap R (Localization.Away J) r) =
        Ideal.Quotient.mk (Ideal.span {1 - e}) r := fun r => by
      show IsLocalization.Away.liftAlgHom J (f := Ideal.Quotient.mkₐ A (Ideal.span {1 - e})) hJ
        (algebraMap R (Localization.Away J) r) = _
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    letI : Algebra (Localization.Away J) (R ⧸ Ideal.span {1 - e}) := lam.toRingHom.toAlgebra
    have : IsScalarTower A (Localization.Away J) (R ⧸ Ideal.span {1 - e}) :=
      IsScalarTower.of_algebraMap_eq (fun a => (lam.commutes a).symm)
    have hsurj : Function.Surjective
        (algebraMap (Localization.Away J) (R ⧸ Ideal.span {1 - e})) := by
      intro y
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨algebraMap R _ r, hlam r⟩
    have hker : RingHom.ker (algebraMap (Localization.Away J) (R ⧸ Ideal.span {1 - e})) =
        Ideal.span {1 - algebraMap R (Localization.Away J) e} := by
      apply le_antisymm
      · intro u hu
        have hu' : lam u = 0 := hu
        obtain ⟨⟨x, ⟨s, hs⟩⟩, hxs⟩ := IsLocalization.surj (Submonoid.powers J) u
        simp only at hxs
        have h1 : Ideal.Quotient.mk (Ideal.span {1 - e}) x = 0 := by
          rw [← hlam, ← hxs, map_mul, hu', zero_mul]
        rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h1
        obtain ⟨c, hc⟩ := h1
        obtain ⟨v, hv⟩ := (IsLocalization.map_units (Localization.Away J)
          (⟨s, hs⟩ : Submonoid.powers J)).exists_right_inv
        simp only at hv
        rw [Ideal.mem_span_singleton']
        refine ⟨algebraMap R _ c * v, ?_⟩
        calc algebraMap R _ c * v * (1 - algebraMap R (Localization.Away J) e)
            = algebraMap R (Localization.Away J) (c * (1 - e)) * v := by
              rw [map_mul, map_sub, map_one]; ring
          _ = algebraMap R _ x * v := by rw [hc]
          _ = u := by rw [← hxs, mul_assoc, hv, mul_one]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show lam (1 - algebraMap R (Localization.Away J) e) = 0
        rw [← map_one (algebraMap R (Localization.Away J)), ← map_sub, hlam,
          Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton_self _
    have : IsLocalization.Away (algebraMap R (Localization.Away J) e)
        (R ⧸ Ideal.span {1 - e}) :=
      IsLocalization.away_of_isIdempotentElem (he.map _) hker hsurj
    have : Algebra.Etale (Localization.Away J) (R ⧸ Ideal.span {1 - e}) :=
      Algebra.Etale.of_isLocalizationAway (algebraMap R (Localization.Away J) e)
    exact Algebra.Etale.comp A (Localization.Away J) (R ⧸ Ideal.span {1 - e})

  have s5 : ∀ (B : Type u) [CommRing B] [Algebra A B] [Algebra.Etale A B],
      Function.Surjective (algebraMap A B) → RingHom.ker (algebraMap A B) ≤ I →
      Function.Injective (algebraMap A B) := by
    intro B _ _ _ hsurj hker
    have hidem := (Algebra.FormallyEtale.iff_of_surjective hsurj).mp inferInstance
    have hfg : (RingHom.ker (algebraMap A B)).FG := by
      have := Algebra.FinitePresentation.self A
      exact Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId A B) hsurj
    obtain ⟨f, hf, hspan⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hidem
    have hfmem : f ∈ RingHom.ker (algebraMap A B) := by
      rw [hspan]; exact Submodule.mem_span_singleton_self f
    have hfj : f ∈ (⊥ : Ideal A).jacobson := hI (hker hfmem)
    have hu : IsUnit (1 - f) := by
      apply Ideal.isUnit_of_sub_one_mem_jacobson_bot
      have : (1 - f) - 1 = -f := by ring
      rw [this]; exact (⊥ : Ideal A).jacobson.neg_mem hfj
    have hf0 : f = 0 := by
      have : (1 - f) * f = 0 := by rw [sub_mul, one_mul, hf.eq, sub_self]
      exact hu.mul_right_eq_zero.mp this
    rw [RingHom.injective_iff_ker_eq_bot, hspan, hf0]
    simp

  have s6 : ∀ (B : Type u) [CommRing B] [Algebra A B] [Module.Finite A B],
      (∀ x : B, ∃ a : A, x - algebraMap A B a ∈ I.map (algebraMap A B)) →
      Function.Surjective (algebraMap A B) := by
    intro B _ _ _ h
    have key : (⊤ : Submodule A B) ≤ LinearMap.range (Algebra.linearMap A B) := by
      apply Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hI
      intro x _
      obtain ⟨a, ha⟩ := h x
      have hx : x = algebraMap A B a + (x - algebraMap A B a) := by ring
      rw [hx]
      apply Submodule.add_mem_sup (LinearMap.mem_range.mpr ⟨a, rfl⟩)
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
      exact ha
    intro x
    obtain ⟨a, ha⟩ := key Submodule.mem_top
    exact ⟨a, ha⟩

  let τ : R →ₐ[A] A ⧸ I := σ₀.comp (IsScalarTower.toAlgHom A R (Localization.Away J))
  have hτφ : ∀ r, τ r = σ₀ (algebraMap R (Localization.Away J) r) := fun r => rfl
  have hK := s1 (Localization.Away J) σ₀
  have h𝔞 := s2 hK
  obtain ⟨b, hb, hτb, hrk⟩ := s3 τ h𝔞
  obtain ⟨e, he, heb⟩ := hR1 R b hb hrk
  have hτIR : ∀ x ∈ I.map (algebraMap A R), τ x = 0 := by
    have : I.map (algebraMap A R) ≤ RingHom.ker τ := by
      rw [Ideal.map_le_iff_le_comap]
      intro i hi
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hi
    exact fun x hx => this hx
  have hτe : τ e = 1 := by
    have : e = b + (e - b) := by ring
    rw [this, map_add, hτb, hτIR _ heb, add_zero]
  have hrke : ∀ x : R, ∃ a : A, e * x - algebraMap A R a * e ∈ I.map (algebraMap A R) := by
    intro x
    obtain ⟨a, ha⟩ := hrk x
    refine ⟨a, ?_⟩
    have : e * x - algebraMap A R a * e = (b * x - algebraMap A R a * b) +
        ((e - b) * x - algebraMap A R a * (e - b)) := by ring
    rw [this]
    exact Ideal.add_mem _ ha (Ideal.sub_mem _ (Ideal.mul_mem_right _ _ heb)
      (Ideal.mul_mem_left _ _ heb))
  let q := Ideal.Quotient.mkₐ A (Ideal.span {(1 : R) - e})
  have hq : ∀ x, q x = Ideal.Quotient.mk (Ideal.span {(1 : R) - e}) x := fun x => rfl
  have hqe : q e = 1 := by
    rw [hq, ← map_one (Ideal.Quotient.mk (Ideal.span {(1 : R) - e})), Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton'.mpr ⟨-1, by ring⟩
  have hτS : ∀ x ∈ Ideal.span {(1 : R) - e}, τ x = 0 := by
    intro x hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, map_sub, map_one, hτe, sub_self, mul_zero]
  let τ₁ : (R ⧸ Ideal.span {(1 : R) - e}) →ₐ[A] A ⧸ I :=
    Ideal.Quotient.liftₐ (Ideal.span {(1 : R) - e}) τ hτS
  have hτ₁ : ∀ x, τ₁ (q x) = τ x := fun x => rfl
  have hτ₁alg : ∀ a, τ₁ (algebraMap A (R ⧸ Ideal.span {(1 : R) - e}) a) =
      Ideal.Quotient.mk I a := fun a => by
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hmapI : ∀ x ∈ I.map (algebraMap A R),
      q x ∈ I.map (algebraMap A (R ⧸ Ideal.span {(1 : R) - e})) := by
    intro x hx
    have := Ideal.mem_map_of_mem (q : R →+* R ⧸ Ideal.span {(1 : R) - e}) hx
    rwa [Ideal.map_map, AlgHom.comp_algebraMap] at this
  have hsurj : Function.Surjective (algebraMap A (R ⧸ Ideal.span {(1 : R) - e})) := by
    apply s6
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, ha⟩ := hrke x
    refine ⟨a, ?_⟩
    have h1 := hmapI _ ha
    rwa [map_sub, map_mul, map_mul, hqe, one_mul, mul_one, AlgHom.commutes] at h1
  have hJ : IsUnit (Ideal.Quotient.mkₐ A (Ideal.span {(1 : R) - e}) J) := by
    obtain ⟨a₀, ha₀⟩ := hsurj (q J)
    have hτJ : IsUnit (τ J) := by
      rw [hτφ]
      exact (IsLocalization.Away.algebraMap_isUnit J).map σ₀
    have hmka : IsUnit (Ideal.Quotient.mk I a₀) := by
      rw [← hτ₁alg, ha₀, hτ₁]; exact hτJ
    obtain ⟨v, hv⟩ := hmka.exists_left_inv
    obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective (I := I) v
    have hmem : a₁ * a₀ - 1 ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hv, map_one, sub_self]
    have hu : IsUnit (a₁ * a₀) := Ideal.isUnit_of_sub_one_mem_jacobson_bot _ (hI hmem)
    have hu0 : IsUnit a₀ := isUnit_of_mul_isUnit_right hu
    show IsUnit (q J)
    rw [← ha₀]
    exact hu0.map _
  have hEt : Algebra.Etale A (R ⧸ Ideal.span {(1 : R) - e}) := s4 e he hJ
  have hinj : Function.Injective (algebraMap A (R ⧸ Ideal.span {(1 : R) - e})) := by
    apply s5 _ hsurj
    intro a ha
    rw [RingHom.mem_ker] at ha
    have := hτ₁alg a
    rw [ha, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.mp this.symm
  let ι : A ≃ₐ[A] (R ⧸ Ideal.span {(1 : R) - e}) :=
    AlgEquiv.ofBijective (Algebra.ofId A (R ⧸ Ideal.span {(1 : R) - e})) ⟨hinj, hsurj⟩
  let lam : Localization.Away J →ₐ[A] R ⧸ Ideal.span {(1 : R) - e} :=
    IsLocalization.Away.liftAlgHom J (f := q) hJ
  have hlam : ∀ r, lam (algebraMap R (Localization.Away J) r) = q r := fun r => by
    show IsLocalization.Away.liftAlgHom J (f := q) hJ
      (algebraMap R (Localization.Away J) r) = _
    rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
    rfl
  refine ⟨(ι.symm : (R ⧸ Ideal.span {(1 : R) - e}) →ₐ[A] A).comp lam,
    IsLocalization.algHom_ext (Submonoid.powers J) (AlgHom.ext fun x => ?_)⟩
  show Ideal.Quotient.mk I (ι.symm (lam (algebraMap R (Localization.Away J) x))) =
    σ₀ (algebraMap R (Localization.Away J) x)
  rw [hlam]
  have hιa : algebraMap A (R ⧸ Ideal.span {(1 : R) - e}) (ι.symm (q x)) = q x :=
    ι.apply_symm_apply (q x)
  rw [← hτ₁alg, hιa, hτ₁, hτφ]

theorem wc_hp_lift_coprime_factorization_of_section (A : Type u) [CommRing A] (I : Ideal A)
    (hsec : ∀ (R : Type u) [CommRing R] [Algebra A R] [Module.Finite A R] (J : R)
      [Algebra.Etale A (Localization.Away J)] (σ₀ : Localization.Away J →ₐ[A] A ⧸ I),
      ∃ σ : Localization.Away J →ₐ[A] A, (Ideal.Quotient.mkₐ A I).comp σ = σ₀)
    (P : Polynomial A) (hP : P.Monic) (g₀ h₀ : Polynomial (A ⧸ I)) (hg₀ : g₀.Monic)
    (hh₀ : h₀.Monic) (hfac : P.map (Ideal.Quotient.mk I) = g₀ * h₀) (hcop : IsCoprime g₀ h₀) :
    ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ P = g * h ∧
      g.map (Ideal.Quotient.mk I) = g₀ ∧ h.map (Ideal.Quotient.mk I) = h₀ :=
by
  rcases subsingleton_or_nontrivial (A ⧸ I) with hs | hnt
  · exact ⟨1, P, Polynomial.monic_one, hP, (one_mul P).symm, Subsingleton.elim _ _,
      Subsingleton.elim _ _⟩
  have hn : P.natDegree = g₀.natDegree + h₀.natDegree := by
    rw [← hg₀.natDegree_mul hh₀, ← hfac, hP.natDegree_map]
  let p : Polynomial.MonicDegreeEq A P.natDegree := Polynomial.MonicDegreeEq.mk P hP rfl
  let G₀ : Polynomial.MonicDegreeEq (A ⧸ I) g₀.natDegree :=
    Polynomial.MonicDegreeEq.mk g₀ hg₀ rfl
  let H₀ : Polynomial.MonicDegreeEq (A ⧸ I) h₀.natDegree :=
    Polynomial.MonicDegreeEq.mk h₀ hh₀ rfl
  have hq : (G₀ : Polynomial (A ⧸ I)) * (H₀ : Polynomial (A ⧸ I)) =
      Polynomial.map (algebraMap A (A ⧸ I)) (p : Polynomial A) ∧
      IsCoprime (G₀ : Polynomial (A ⧸ I)) (H₀ : Polynomial (A ⧸ I)) := by
    refine ⟨?_, hcop⟩
    rw [Ideal.Quotient.algebraMap_eq]
    exact hfac.symm
  let σ₀ := (Polynomial.UniversalCoprimeFactorizationRing.homEquiv (A ⧸ I) g₀.natDegree
    h₀.natDegree hn p).symm ⟨(G₀, H₀), hq⟩
  obtain ⟨σ, hσ⟩ := hsec (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
    (Polynomial.UniversalFactorizationRing.presentation g₀.natDegree h₀.natDegree hn p).jacobian σ₀
  set q := Polynomial.UniversalCoprimeFactorizationRing.homEquiv A g₀.natDegree h₀.natDegree hn p σ
    with hqdef
  have hmk : ((Ideal.Quotient.mkₐ A I : A →ₐ[A] A ⧸ I) : A →+* A ⧸ I) = Ideal.Quotient.mk I :=
    RingHom.ext fun _ => rfl
  have h1 := Polynomial.UniversalCoprimeFactorizationRing.homEquiv_comp_fst
    A g₀.natDegree h₀.natDegree hn p (T := A ⧸ I) σ (Ideal.Quotient.mkₐ A I)
  have h2 := Polynomial.UniversalCoprimeFactorizationRing.homEquiv_comp_snd
    A g₀.natDegree h₀.natDegree hn p (T := A ⧸ I) σ (Ideal.Quotient.mkₐ A I)
  rw [hσ, Equiv.apply_symm_apply] at h1 h2
  refine ⟨(q.1.1 : Polynomial A), (q.1.2 : Polynomial A), q.1.1.monic, q.1.2.monic, ?_, ?_, ?_⟩
  · have hpP : Polynomial.map (algebraMap A A) (p : Polynomial A) = P := by
      rw [Algebra.algebraMap_self, Polynomial.map_id]
      rfl
    exact (q.2.1.trans hpP).symm
  · have e := congrArg (fun x : Polynomial.MonicDegreeEq (A ⧸ I) g₀.natDegree =>
      (x : Polynomial (A ⧸ I))) h1
    simp only [Polynomial.MonicDegreeEq.map_coe] at e
    rw [hmk] at e
    exact e.symm
  · have e := congrArg (fun x : Polynomial.MonicDegreeEq (A ⧸ I) h₀.natDegree =>
      (x : Polynomial (A ⧸ I))) h2
    simp only [Polynomial.MonicDegreeEq.map_coe] at e
    rw [hmk] at e
    exact e.symm

theorem wc_hp_finite_domain_idempotent_of_factor (A D : Type u) [CommRing A] [CommRing D]
    [IsDomain D] [Algebra A D] [Module.Finite A D] (I : Ideal A)
    (hfl : ∀ (P : Polynomial A) (g₀ h₀ : Polynomial (A ⧸ I)), P.Monic → g₀.Monic → h₀.Monic →
      P.map (Ideal.Quotient.mk I) = g₀ * h₀ → IsCoprime g₀ h₀ →
      ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ P = g * h ∧
        g.map (Ideal.Quotient.mk I) = g₀ ∧ h.map (Ideal.Quotient.mk I) = h₀)
    (e : D ⧸ I.map (algebraMap A D)) (he : IsIdempotentElem e) : e = 0 ∨ e = 1 :=
by
  classical
  obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective e
  set J := I.map (algebraMap A D) with hJ
  have hc : d * d - d ∈ J := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, he.eq, sub_self]

  obtain ⟨q, N, hqm, hqmap, hq0⟩ : ∃ (q : Polynomial A) (N : ℕ), q.Monic ∧
      q.map (Ideal.Quotient.mk I) = Polynomial.X ^ N ∧ Polynomial.aeval (d * d - d) q = 0 := by
    let f : Module.End A D := Algebra.lmul A D (d * d - d)
    have hrange : LinearMap.range f ≤ I • (⊤ : Submodule A D) := by
      rintro y ⟨x, rfl⟩
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
      show (d * d - d) * x ∈ _
      exact Ideal.mul_mem_right _ _ hc
    obtain ⟨p, hpm, -, hpcoeff, hpf⟩ :=
      LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero A f I hrange
    refine ⟨p, p.natDegree, hpm, ?_, ?_⟩
    · ext k
      rw [Polynomial.coeff_map, Polynomial.coeff_X_pow]
      rcases lt_trichotomy k p.natDegree with hk | hk | hk
      · rw [if_neg hk.ne, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.pow_le_self (by omega) (hpcoeff k)
      · subst hk
        rw [if_pos rfl, hpm.coeff_natDegree, map_one]
      · rw [if_neg hk.ne', Polynomial.coeff_eq_zero_of_natDegree_lt hk, map_zero]
    · have h1 := Polynomial.aeval_algHom_apply (Algebra.lmul A D) (d * d - d) p
      have h2 : (Polynomial.aeval f p) 1 =
          (Algebra.lmul A D (Polynomial.aeval (d * d - d) p)) 1 := by
        rw [← h1]
      rw [hpf] at h2
      simpa using h2.symm
  have hA : Nontrivial A := RingHom.domain_nontrivial (algebraMap A D)
  set r : Polynomial A := Polynomial.X * (Polynomial.X - Polynomial.C 1) with hr
  have hrm : r.Monic := Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1)
  have hrdeg : r.natDegree ≠ 0 := by
    rw [hr, Polynomial.monic_X.natDegree_mul (Polynomial.monic_X_sub_C 1),
      Polynomial.natDegree_X, Polynomial.natDegree_X_sub_C]
    norm_num
  set P := q.comp r with hP
  have hPm : P.Monic := hqm.comp hrm hrdeg
  have hPd : Polynomial.aeval d P = 0 := by
    rw [hP, Polynomial.aeval_comp]
    have : Polynomial.aeval d r = d * d - d := by
      simp only [hr, map_mul, map_sub, Polynomial.aeval_X, map_one]
      ring
    rw [this, hq0]
  have hPmap : P.map (Ideal.Quotient.mk I) =
      Polynomial.X ^ N * (Polynomial.X - Polynomial.C 1) ^ N := by
    rw [hP, Polynomial.map_comp, hqmap, Polynomial.X_pow_comp, hr, ← mul_pow]
    simp
  have hcop : IsCoprime (Polynomial.X ^ N : Polynomial (A ⧸ I))
      ((Polynomial.X - Polynomial.C 1) ^ N) := by
    apply IsCoprime.pow
    exact ⟨1, -1, by rw [Polynomial.C_1]; ring⟩
  obtain ⟨g, h, -, -, hPgh, hgmap, hhmap⟩ := hfl P _ _ hPm (Polynomial.monic_X_pow N)
    ((Polynomial.monic_X_sub_C 1).pow N) hPmap hcop
  have hroot : Polynomial.aeval d g = 0 ∨ Polynomial.aeval d h = 0 := by
    rw [hPgh, map_mul] at hPd
    exact mul_eq_zero.mp hPd

  set φ : A ⧸ I →+* D ⧸ J := Ideal.quotientMap J (algebraMap A D) Ideal.le_comap_map with hφ
  have hred : ∀ G : Polynomial A, Ideal.Quotient.mk J (Polynomial.aeval d G) =
      Polynomial.eval₂ φ (Ideal.Quotient.mk J d) (G.map (Ideal.Quotient.mk I)) := by
    intro G
    rw [Polynomial.eval₂_map, hφ, Ideal.quotientMap_comp_mk, Polynomial.aeval_def,
      Polynomial.hom_eval₂]
  rcases hroot with hg0 | hh0
  · left
    have h1 := hred g
    rw [hg0, map_zero, hgmap, Polynomial.eval₂_X_pow] at h1
    exact he.eq_zero_of_isNilpotent ⟨N, h1.symm⟩
  · right
    have h1 := hred h
    rw [hh0, map_zero, hhmap, Polynomial.eval₂_pow, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C, map_one] at h1
    have hn : IsNilpotent (1 - Ideal.Quotient.mk J d) := by
      rw [← neg_sub]
      exact (show IsNilpotent (Ideal.Quotient.mk J d - 1) from ⟨N, h1.symm⟩).neg
    have h2 := he.one_sub.eq_zero_of_isNilpotent hn
    exact (sub_eq_zero.mp h2).symm

theorem wc_whls_henselian_trivial_fibre_iso : ∀ (A T : Type u) [CommRing A] [CommRing T] [Algebra A T] (I : Ideal A), HenselianRing A I → Algebra.WeaklyEtale A T → HenselianRing T (I.map (algebraMap A T)) → Function.Bijective (Ideal.quotientMap (I.map (algebraMap A T)) (algebraMap A T) Ideal.le_comap_map) → Function.Bijective (algebraMap A T) :=
by
  intro A T _ _ _ I hA hWE hT hq
  haveI := hA
  haveI := hWE

  have wc_whls_integralClosure_field_isIntegrallyClosed : ∀ (A F : Type u) [CommRing A] [Field F]
      [Algebra A F], IsIntegrallyClosed ↥(integralClosure A F) := by
    intro A F _ _ _
    exact IsIntegrallyClosed.of_isIntegrallyClosedIn _ F

  have wc_whls_faithfullyFlat_of_closed_fibre : ∀ (A T : Type u) [CommRing A] [CommRing T] [Algebra A T] (I : Ideal A), I ≤ (⊥ : Ideal A).jacobson → Module.Flat A T → Function.Bijective (Ideal.quotientMap (I.map (algebraMap A T)) (algebraMap A T) Ideal.le_comap_map) → Module.FaithfullyFlat A T := by
    intro A T _ _ _ I hI hfl hq
    refine Module.FaithfullyFlat.mk ?_
    intro m hm htop
    have h1 : (1 : T) ∈ m.map (algebraMap A T) := by
      have h0 : (1 : T) ∈ m • (⊤ : Submodule A T) := by rw [htop]; exact Submodule.mem_top
      rw [Ideal.smul_top_eq_map] at h0
      exact h0
    have key : ∀ x ∈ m.map (algebraMap A T), ∃ a ∈ m,
        Ideal.Quotient.mk (I.map (algebraMap A T)) x =
          Ideal.Quotient.mk (I.map (algebraMap A T)) (algebraMap A T a) := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨a, ha, rfl⟩
        exact ⟨a, ha, rfl⟩
      · exact ⟨0, m.zero_mem, by simp⟩
      · rintro x y _ _ ⟨a, ha, hx⟩ ⟨b, hb, hy⟩
        exact ⟨a + b, m.add_mem ha hb, by simp [hx, hy]⟩
      · rintro t x _ ⟨a, ha, hx⟩
        obtain ⟨c, hc⟩ := hq.2 (Ideal.Quotient.mk _ t)
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
        rw [Ideal.quotientMap_mk] at hc
        refine ⟨c * a, m.mul_mem_left c ha, ?_⟩
        rw [smul_eq_mul, map_mul, map_mul, map_mul, hx, ← hc]
    obtain ⟨a, ha, h⟩ := key 1 h1
    have h2 : Ideal.Quotient.mk I 1 = Ideal.Quotient.mk I a := by
      apply hq.1
      rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk, map_one]
      rw [map_one] at h
      exact h
    rw [Ideal.Quotient.eq] at h2
    have hIm : I ≤ m := fun x hx => Ideal.mem_sInf.mp (hI hx) ⟨bot_le, hm⟩
    have h3 : 1 - a ∈ m := hIm h2
    have h4 : (1 : A) ∈ m := by
      have := m.add_mem h3 ha
      simpa using this
    exact hm.ne_top ((Ideal.eq_top_iff_one m).mpr h4)

  have wc_whls_ringHom_factor_fractionRing : ∀ (B F K C : Type u) [CommRing B] [IsDomain B] [Field F] [Algebra B F] [Field K] [Algebra B K] [IsFractionRing B K] [CommRing C] (hinj : Function.Injective (algebraMap B F)) (Ψ : C →+* F), (∀ c : C, ∃ s b : B, s ≠ 0 ∧ algebraMap B F s * Ψ c = algebraMap B F b) → ∃ Ψ' : C →+* K, (IsFractionRing.lift hinj).comp Ψ' = Ψ := by
    intro B F K C _ _ _ _ _ _ _ _ hinj Ψ h
    set ι : K →+* F := IsFractionRing.lift hinj with hι
    have hrange : ∀ c, Ψ c ∈ ι.range := by
      intro c
      obtain ⟨s, b, hs, hsb⟩ := h c
      have hs' : algebraMap B F s ≠ 0 := by
        intro h0; apply hs; apply hinj; rw [h0, map_zero]
      refine ⟨algebraMap B K b / algebraMap B K s, ?_⟩
      rw [map_div₀, hι, IsFractionRing.lift_algebraMap, IsFractionRing.lift_algebraMap, ← hsb]
      field_simp
    let e : K ≃+* ι.range := RingEquiv.ofBijective ι.rangeRestrict
      ⟨fun x y hxy => ι.injective (congrArg Subtype.val hxy), ι.rangeRestrict_surjective⟩
    refine ⟨(e.symm.toRingHom).comp (Ψ.codRestrict ι.range hrange), ?_⟩
    ext c
    have h1 := congrArg Subtype.val (e.apply_symm_apply ⟨Ψ c, hrange c⟩)
    exact h1

  have s7core : ∀ (A F : Type u) [CommRing A] [Field F] [Algebra A F] (z : F) (n : ℕ) (p : Polynomial A),
      p.natDegree ≤ n → p.map (algebraMap A F) ≠ 0 → (p.map (algebraMap A F)).eval z = 0 →
      ∃ a : A, algebraMap A F a ≠ 0 ∧ IsIntegral A (algebraMap A F a * z) := by
    intro A F _ _ _ z n
    induction n with
    | zero =>
      intro p hp hne hev
      refine ⟨p.leadingCoeff, ?_, ?_⟩
      · intro h0
        apply hne
        rw [Polynomial.eq_C_of_natDegree_le_zero hp, Polynomial.map_C]
        rw [Polynomial.leadingCoeff, Nat.le_zero.mp hp] at h0
        rw [h0, map_zero]
      · have h := isIntegral_leadingCoeff_smul p z (by rw [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]; exact hev)
        rwa [Algebra.smul_def] at h
    | succ n ih =>
      intro p hp hne hev
      by_cases hl : algebraMap A F p.leadingCoeff = 0
      · have hmap : p.eraseLead.map (algebraMap A F) = p.map (algebraMap A F) := by
          conv_rhs => rw [← Polynomial.eraseLead_add_monomial_natDegree_leadingCoeff p]
          rw [Polynomial.map_add, Polynomial.map_monomial, hl, Polynomial.monomial_zero_right, add_zero]
        have hdeg : p.eraseLead.natDegree ≤ n := by
          rcases Polynomial.eraseLead_natDegree_lt_or_eraseLead_eq_zero p with h | h
          · omega
          · rw [h, Polynomial.natDegree_zero]; omega
        exact ih p.eraseLead hdeg (by rw [hmap]; exact hne) (by rw [hmap]; exact hev)
      · refine ⟨p.leadingCoeff, hl, ?_⟩
        have h := isIntegral_leadingCoeff_smul p z (by rw [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]; exact hev)
        rwa [Algebra.smul_def] at h
  have wc_whls_point_integral_multiple : ∀ (A T F : Type u) [CommRing A] [CommRing T] [Field F] [Algebra A T] [Algebra A F], Algebra.WeaklyEtale A T → ∀ (φ : T →ₐ[A] F) (t : T), ∃ a : A, algebraMap A F a ≠ 0 ∧ IsIntegral A (algebraMap A F a * φ t) := by
    intro A T F _ _ _ _ _ hWE φ t
    obtain ⟨f, hf0, hf⟩ := wc_weaklyEtale_point_algebraic A T F hWE φ.toRingHom t
    have hc : φ.toRingHom.comp (algebraMap A T) = algebraMap A F := φ.comp_algebraMap
    rw [hc] at hf0 hf
    exact s7core A F (φ t) f.natDegree f le_rfl hf0 (by rw [← Polynomial.eval₂_eq_eval_map]; exact hf)

  have wc_whls_integral_domain_idem_of_finite : ∀ (A : Type u) [CommRing A] (I : Ideal A), (∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D] [Module.Finite A D] (e : D ⧸ I.map (algebraMap A D)), IsIdempotentElem e → e = 0 ∨ e = 1) → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra A B] [Algebra.IsIntegral A B] (e : B ⧸ I.map (algebraMap A B)), IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro A _ I hfin B _ _ _ _ e he
    classical
    have key : ∀ x ∈ I.map (algebraMap A B), ∃ s : Finset B, ∀ D : Subalgebra A B, (↑s : Set B) ⊆ D →
        ∃ hx : x ∈ D, (⟨x, hx⟩ : D) ∈ I.map (algebraMap A D) := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨a, ha, rfl⟩
        refine ⟨∅, fun D _ => ⟨D.algebraMap_mem a, ?_⟩⟩
        exact Ideal.mem_map_of_mem (algebraMap A D) ha
      · exact ⟨∅, fun D _ => ⟨D.zero_mem, (I.map (algebraMap A D)).zero_mem⟩⟩
      · rintro x y _ _ ⟨s, hs⟩ ⟨s', hs'⟩
        refine ⟨s ∪ s', fun D hD => ?_⟩
        obtain ⟨hx, hx'⟩ := hs D (fun z hz => hD (by simp [hz]))
        obtain ⟨hy, hy'⟩ := hs' D (fun z hz => hD (by simp [hz]))
        exact ⟨D.add_mem hx hy, (I.map (algebraMap A D)).add_mem hx' hy'⟩
      · rintro b x _ ⟨s, hs⟩
        refine ⟨insert b s, fun D hD => ?_⟩
        obtain ⟨hx, hx'⟩ := hs D (fun z hz => hD (by simp [hz]))
        have hb : b ∈ D := hD (by simp)
        exact ⟨D.mul_mem hb hx, (I.map (algebraMap A D)).mul_mem_left (⟨b, hb⟩ : D) hx'⟩
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective e
    have hy : y * y - y ∈ I.map (algebraMap A B) := by
      rw [← Ideal.Quotient.eq, map_mul]; exact he
    obtain ⟨s, hs⟩ := key _ hy
    set D : Subalgebra A B := Algebra.adjoin A (insert y (↑s : Set B)) with hDdef
    have hfinD : Module.Finite A D := by
      apply Algebra.finite_adjoin_of_finite_of_isIntegral
      · exact (s.finite_toSet.insert y)
      · intro x _; exact Algebra.IsIntegral.isIntegral x
    have hyD : y ∈ D := Algebra.subset_adjoin (Set.mem_insert y _)
    obtain ⟨_, hmem⟩ := hs D (fun z hz => Algebra.subset_adjoin (Set.mem_insert_of_mem y hz))
    have hidem : IsIdempotentElem (Ideal.Quotient.mk (I.map (algebraMap A D)) ⟨y, hyD⟩) := by
      rw [IsIdempotentElem, ← map_mul, Ideal.Quotient.eq]
      exact hmem
    have hval : (I.map (algebraMap A D)).map D.val.toRingHom ≤ I.map (algebraMap A B) := by
      rw [Ideal.map_map]
      have : D.val.toRingHom.comp (algebraMap A D) = algebraMap A B := by
        ext a; rfl
      rw [this]
    rcases hfin D _ hidem with h | h
    · left
      rw [Ideal.Quotient.eq_zero_iff_mem] at h ⊢
      exact hval (Ideal.mem_map_of_mem D.val.toRingHom h)
    · right
      rw [← map_one (Ideal.Quotient.mk (I.map (algebraMap A D))), Ideal.Quotient.eq] at h
      rw [← map_one (Ideal.Quotient.mk (I.map (algebraMap A B))), Ideal.Quotient.eq]
      exact hval (Ideal.mem_map_of_mem D.val.toRingHom h)

  have wc_whls_fraction_tensor_idem_trivial : ∀ (B C K : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [CommRing C] [Algebra B C] [Field K] [Algebra B K] [IsFractionRing B K], Algebra.WeaklyEtale B C → (∀ c : C, IsIdempotentElem c → c = 0 ∨ c = 1) → ∀ ε : TensorProduct B K C, IsIdempotentElem ε → ε = 0 ∨ ε = 1 := by
    intro B C K _ _ _ _ _ _ _ _ hWE hC ε hε
    haveI : Module.Flat B C := Algebra.WeaklyEtale.flat
    let j : C →ₐ[B] TensorProduct B K C := Algebra.TensorProduct.includeRight
    have hj : Function.Injective j :=
      Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective B K)
    have hjs : ∀ (s : B) (c : C), j (s • c) = algebraMap B (TensorProduct B K C) s * j c := by
      intro s c
      rw [map_smul, Algebra.smul_def]
    have hnf : ∀ x : TensorProduct B K C, ∃ s : B, s ≠ 0 ∧ ∃ c : C,
        algebraMap B (TensorProduct B K C) s * x = j c := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul k c =>
        obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := B) k
        have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
        refine ⟨y, hy0, x • c, ?_⟩
        have hyK : algebraMap B K y ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective B K)).mpr hy0
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        have : algebraMap B K y * k = algebraMap B K x := by
          rw [← hxy]; field_simp
        rw [this]
        show TensorProduct.tmul B (algebraMap B K x) c = TensorProduct.tmul B (1 : K) (x • c)
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
      | add x y hx hy =>
        obtain ⟨s, hs, c, hc⟩ := hx
        obtain ⟨s', hs', c', hc'⟩ := hy
        refine ⟨s * s', mul_ne_zero hs hs', s' • c + s • c', ?_⟩
        rw [map_add, hjs, hjs, ← hc, ← hc', map_mul]
        ring
    obtain ⟨s, hs, c, hc⟩ := hnf ε
    have hsu : IsUnit (algebraMap B (TensorProduct B K C) s) := by
      rw [IsScalarTower.algebraMap_apply B K (TensorProduct B K C)]
      exact (IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective B K)).mpr hs)).map _
    have hcc : c * c = s • c := by
      apply hj
      rw [map_mul, ← hc, hjs, ← hc]
      have h2 : ε * ε = ε := hε
      calc algebraMap B (TensorProduct B K C) s * ε * (algebraMap B (TensorProduct B K C) s * ε)
          = algebraMap B (TensorProduct B K C) s * (algebraMap B (TensorProduct B K C) s * (ε * ε)) := by ring
        _ = _ := by rw [h2]
    obtain ⟨c', hc'⟩ := wc_weaklyEtale_normal_idem B C hWE c s hs hcc
    have hεc : ε = j c' := by
      rw [hc', hjs] at hc
      exact (hsu.mul_right_inj).mp hc
    have hc'i : IsIdempotentElem c' := by
      apply hj
      rw [map_mul, ← hεc]
      exact hε
    rcases hC c' hc'i with h | h
    · left; rw [hεc, h, map_zero]
    · right; rw [hεc, h, map_one]

  have wc_whls_tensor_integral_idem_trivial : ∀ (A T B : Type u) [CommRing A] [CommRing T] [CommRing B] [Algebra A T] [Algebra A B] [Algebra.IsIntegral A B] (I : Ideal A), (∀ e : B ⧸ I.map (algebraMap A B), IsIdempotentElem e → e = 0 ∨ e = 1) → I.map (algebraMap A T) ≤ (⊥ : Ideal T).jacobson → Function.Bijective (Ideal.quotientMap (I.map (algebraMap A T)) (algebraMap A T) Ideal.le_comap_map) → ∀ c : TensorProduct A B T, IsIdempotentElem c → c = 0 ∨ c = 1 := by
    intro A T B _ _ _ _ _ _ I hB hjac hq
    have main : ∀ c : TensorProduct A T B, IsIdempotentElem c → c = 0 ∨ c = 1 := by
      intro c hc
      set IT : Ideal T := I.map (algebraMap A T) with hIT
      set IB : Ideal B := I.map (algebraMap A B) with hIB
      set N : Ideal (TensorProduct A T B) := IT.map (algebraMap T (TensorProduct A T B)) with hN
      have hNjac : N ≤ (⊥ : Ideal (TensorProduct A T B)).jacobson := by
        intro x hx
        refine Ideal.mem_sInf.mpr ?_
        rintro M ⟨-, hM⟩
        have hint : (algebraMap T (TensorProduct A T B)).IsIntegral :=
          fun x => Algebra.IsIntegral.isIntegral x
        haveI := hM
        have hMc : (M.comap (algebraMap T (TensorProduct A T B))).IsMaximal :=
          Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint M
        have hle : IT ≤ M.comap (algebraMap T (TensorProduct A T B)) :=
          fun y hy => Ideal.mem_sInf.mp (hjac hy) ⟨bot_le, hMc⟩
        exact (Ideal.map_le_iff_le_comap.mpr hle) hx
      have hjz : ∀ x : TensorProduct A T B, x ∈ N → IsIdempotentElem x → x = 0 := by
        intro x hx hxi
        have hu := Ideal.mem_jacobson_bot.mp (hNjac hx) (-1)
        have h0 : x * (x * -1 + 1) = 0 := by
          have : x * x = x := hxi
          linear_combination (-1 : TensorProduct A T B) * this
        exact (hu.mul_left_eq_zero).mp h0
      let θe : (A ⧸ I) ≃+* (T ⧸ IT) := RingEquiv.ofBijective _ hq
      have hθ : ∀ a : A, θe (Ideal.Quotient.mk I a) = Ideal.Quotient.mk IT (algebraMap A T a) := by
        intro a; rfl
      let π : T →ₐ[A] A ⧸ I :=
        { toRingHom := θe.symm.toRingHom.comp (Ideal.Quotient.mk IT)
          commutes' := fun a => by
            show θe.symm (Ideal.Quotient.mk IT (algebraMap A T a)) = Ideal.Quotient.mk I a
            rw [← hθ, RingEquiv.symm_apply_apply] }
      have hπIT : ∀ t ∈ IT, π t = 0 := by
        intro t ht
        show θe.symm (Ideal.Quotient.mk IT t) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr ht, map_zero]
      let q : A ⧸ I →ₐ[A] B ⧸ IB :=
        Ideal.quotientMapₐ IB (Algebra.ofId A B) Ideal.le_comap_map
      let ρ : TensorProduct A T B →ₐ[A] B ⧸ IB :=
        Algebra.TensorProduct.lift (q.comp π) (Ideal.Quotient.mkₐ A IB) (fun _ _ => Commute.all _ _)
      have hρN : ∀ x ∈ N, ρ x = 0 := by
        intro x hx
        have hle : IT ≤ (RingHom.ker ρ.toRingHom).comap (algebraMap T (TensorProduct A T B)) := by
          intro t ht
          rw [Ideal.mem_comap, RingHom.mem_ker]
          show ρ (TensorProduct.tmul A t (1 : B)) = 0
          simp only [ρ, Algebra.TensorProduct.lift_tmul, AlgHom.comp_apply, hπIT t ht, map_zero,
            zero_mul]
        exact (Ideal.map_le_iff_le_comap.mpr hle) hx
      have hρ1 : ∀ β : B, ρ (TensorProduct.tmul A (1 : T) β) = Ideal.Quotient.mk IB β := by
        intro β
        simp only [ρ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have hNB : ∀ β ∈ IB, TensorProduct.tmul A (1 : T) β ∈ N := by
        intro β hβ
        have hle : IB ≤ N.comap (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A T B).toRingHom := by
          rw [hIB, Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, Ideal.mem_comap]
          have e : (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A T B).toRingHom
              (algebraMap A B a) = algebraMap T (TensorProduct A T B) (algebraMap A T a) := by
            rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]
            exact IsScalarTower.algebraMap_apply A T (TensorProduct A T B) a
          rw [e]
          exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha)
        exact hle hβ
      have hred : ∀ x : TensorProduct A T B, ∃ β : B, x - TensorProduct.tmul A (1 : T) β ∈ N := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => exact ⟨0, by simp⟩
        | tmul t b =>
          obtain ⟨a, ha⟩ := hq.2 (Ideal.Quotient.mk IT t)
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
          rw [Ideal.quotientMap_mk, Ideal.Quotient.eq] at ha
          refine ⟨a • b, ?_⟩
          have e1 : TensorProduct.tmul A (1 : T) (a • b) = TensorProduct.tmul A (algebraMap A T a) b := by
            rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
          have e2 : TensorProduct.tmul A t b - TensorProduct.tmul A (1 : T) (a • b) =
              algebraMap T (TensorProduct A T B) (t - algebraMap A T a) * (TensorProduct.tmul A (1 : T) b) := by
            rw [e1, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
              Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, TensorProduct.sub_tmul]
          rw [e2]
          exact N.mul_mem_right _ (Ideal.mem_map_of_mem _ (by
            have := IT.neg_mem ha
            simpa using this))
        | add x y hx hy =>
          obtain ⟨β, hβ⟩ := hx
          obtain ⟨β', hβ'⟩ := hy
          refine ⟨β + β', ?_⟩
          have : x + y - TensorProduct.tmul A (1 : T) (β + β') =
              (x - TensorProduct.tmul A (1 : T) β) + (y - TensorProduct.tmul A (1 : T) β') := by
            rw [TensorProduct.tmul_add]; ring
          rw [this]
          exact N.add_mem hβ hβ'
      obtain ⟨β, hβ⟩ := hred c
      have hρc : ρ c = Ideal.Quotient.mk IB β := by
        have h := hρN _ hβ
        rw [map_sub, hρ1, sub_eq_zero] at h
        exact h
      have hβi : IsIdempotentElem (Ideal.Quotient.mk IB β) := by
        rw [← hρc]; exact hc.map ρ
      rcases hB _ hβi with h | h
      · left
        have hβIB : β ∈ IB := Ideal.Quotient.eq_zero_iff_mem.mp h
        apply hjz c _ hc
        have := N.add_mem hβ (hNB β hβIB)
        simpa using this
      · right
        have h1 : 1 - β ∈ IB := by
          rw [← map_one (Ideal.Quotient.mk IB), Ideal.Quotient.eq] at h
          have := IB.neg_mem h
          simpa using this
        have h2 : 1 - c ∈ N := by
          have := N.sub_mem (hNB _ h1) hβ
          have e : TensorProduct.tmul A (1 : T) (1 - β) - (c - TensorProduct.tmul A (1 : T) β) = 1 - c := by
            rw [TensorProduct.tmul_sub, Algebra.TensorProduct.one_def]; ring
          rw [e] at this
          exact this
        have := hjz (1 - c) h2 hc.one_sub
        exact (sub_eq_zero.mp this).symm
    intro c hc
    let σ := Algebra.TensorProduct.comm A B T
    rcases main (σ c) (hc.map σ) with h | h
    · left; simpa using congrArg σ.symm h
    · right; simpa using congrArg σ.symm h

  have wc_whls_bijective_of_unique_field_points : ∀ (A T : Type u) [CommRing A] [CommRing T] [Algebra A T], Module.FaithfullyFlat A T → Algebra.WeaklyEtale A T → (∀ (F : Type u) [Field F] [Algebra A F] (φ₁ φ₂ : T →ₐ[A] F), φ₁ = φ₂) → Function.Bijective (algebraMap A T) := by
    intro A T _ _ _ hff hWE huniq
    let μ : TensorProduct A T T →ₐ[A] T := Algebra.TensorProduct.lmul' A
    have hμ1 : ∀ t : T, μ (TensorProduct.tmul A t 1) = t := fun t => by simp [μ]
    have hμs : Function.Surjective μ := fun t => ⟨TensorProduct.tmul A t 1, hμ1 t⟩
    have hfl : (Algebra.TensorProduct.lmul' A : TensorProduct A T T →ₐ[A] T).Flat :=
      Algebra.WeaklyEtale.flat_lmul' A T
    letI : Module (TensorProduct A T T) T := μ.toRingHom.toModule
    have hflT : Module.Flat (TensorProduct A T T) T := hfl
    let e := RingHom.quotientKerEquivOfSurjective (f := μ.toRingHom) hμs
    let eL : (TensorProduct A T T ⧸ RingHom.ker μ.toRingHom) ≃ₗ[TensorProduct A T T] T :=
      { toFun := e
        invFun := e.symm
        map_add' := map_add e
        map_smul' := fun r x => by
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
          show e (Ideal.Quotient.mk _ (r * x)) = μ r * e (Ideal.Quotient.mk _ x)
          rw [map_mul, map_mul]
          rfl
        left_inv := e.symm_apply_apply
        right_inv := e.apply_symm_apply }
    have hflQ : Module.Flat (TensorProduct A T T) (TensorProduct A T T ⧸ RingHom.ker μ.toRingHom) :=
      Module.Flat.of_linearEquiv eL
    have hpure := wc_flat_quot_absorb _ _ hflQ
    have hK : RingHom.ker μ.toRingHom = ⊥ := by
      by_contra hne
      obtain ⟨x, hxK, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      obtain ⟨z, hzK, hxz⟩ := hpure x hxK
      set J : Ideal (TensorProduct A T T) := (Ideal.span {x}).annihilator with hJ
      have h1z : 1 - z ∈ J := by
        rw [hJ, Submodule.mem_annihilator_span_singleton, smul_eq_mul, sub_mul, one_mul, mul_comm, hxz, sub_self]
      have hJt : J ≠ ⊤ := by
        intro h
        apply hx0
        have h1 : (1 : TensorProduct A T T) ∈ J := h ▸ Submodule.mem_top
        rw [hJ, Submodule.mem_annihilator_span_singleton, one_smul] at h1
        exact h1
      obtain ⟨P, hP, hJP⟩ := Ideal.exists_le_maximal J hJt
      have hzP : z ∉ P := by
        intro hz
        apply hP.ne_top
        rw [Ideal.eq_top_iff_one]
        have := P.add_mem (hJP h1z) hz
        simpa using this
      letI : Algebra A P.ResidueField :=
        ((algebraMap (TensorProduct A T T) P.ResidueField).comp
          (algebraMap A (TensorProduct A T T))).toAlgebra
      let φ₁ : T →ₐ[A] P.ResidueField :=
        { toRingHom := (algebraMap (TensorProduct A T T) P.ResidueField).comp
            (Algebra.TensorProduct.includeLeft (R := A) (S := A) (A := T) (B := T)).toRingHom
          commutes' := fun a => by
            show algebraMap (TensorProduct A T T) P.ResidueField
              (Algebra.TensorProduct.includeLeft (R := A) (S := A) (A := T) (B := T) (algebraMap A T a)) = _
            rw [AlgHom.commutes]; rfl }
      let φ₂ : T →ₐ[A] P.ResidueField :=
        { toRingHom := (algebraMap (TensorProduct A T T) P.ResidueField).comp
            (Algebra.TensorProduct.includeRight (R := A) (A := T) (B := T)).toRingHom
          commutes' := fun a => by
            show algebraMap (TensorProduct A T T) P.ResidueField
              (Algebra.TensorProduct.includeRight (R := A) (A := T) (B := T) (algebraMap A T a)) = _
            rw [AlgHom.commutes]; rfl }
      have heq := huniq P.ResidueField φ₁ φ₂
      have hKP : RingHom.ker μ.toRingHom ≤ P := by
        have hspan : RingHom.ker μ.toRingHom =
            Ideal.span (Set.range fun s : T => TensorProduct.tmul A (1 : T) s - TensorProduct.tmul A s 1) :=
          (KaehlerDifferential.span_range_eq_ideal A T).symm
        rw [hspan, Ideal.span_le]
        rintro _ ⟨s, rfl⟩
        have h := congrArg (fun f : T →ₐ[A] P.ResidueField => f s) heq
        simp only [φ₁, φ₂, AlgHom.coe_mk, RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, Algebra.TensorProduct.includeLeft_apply,
          Algebra.TensorProduct.includeRight_apply] at h
        have h2 : algebraMap (TensorProduct A T T) P.ResidueField
            (TensorProduct.tmul A (1 : T) s - TensorProduct.tmul A s 1) = 0 := by
          rw [map_sub, h, sub_self]
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField] at h2
        exact h2
      exact hzP (hKP hzK)
    have hμinj : Function.Injective μ := by
      have := (RingHom.injective_iff_ker_eq_bot μ.toRingHom).mpr hK
      exact this
    have hbij : Function.Bijective (algebraMap T (TensorProduct A T T)) := by
      constructor
      · intro a b hab
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply] at hab
        simpa [Algebra.algebraMap_self, hμ1] using congrArg μ hab
      · intro d
        refine ⟨μ d, hμinj ?_⟩
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, hμ1]
    exact Module.FaithfullyFlat.bijective_of_tensorProduct hbij

  have hfin : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D] [Module.Finite A D]
      (e : D ⧸ I.map (algebraMap A D)), IsIdempotentElem e → e = 0 ∨ e = 1 :=
    fun D _ _ _ _ e he => wc_hp_finite_domain_idempotent_of_factor A D I
      (fun P g₀ h₀ hP hg₀ hh₀ hfc hcop =>
        wc_hp_lift_coprime_factorization_of_section A I
          (fun R _ _ _ J _ σ₀ => wc_hp_finite_away_section_lift A I HenselianRing.jac
            (fun B' _ _ _ b hb hrk => wc_hp_rank_one_idempotent_lift A I B' b hb hrk) R J σ₀)
          P hP g₀ h₀ hg₀ hh₀ hfc hcop) e he

  have hff : Module.FaithfullyFlat A T :=
    wc_whls_faithfullyFlat_of_closed_fibre A T I HenselianRing.jac inferInstance hq

  refine wc_whls_bijective_of_unique_field_points A T hff hWE ?_
  intro F _ _ φ₁ φ₂
  have hinj : Function.Injective (algebraMap ↥(integralClosure A F) F) := Subtype.val_injective
  have hι : Function.Injective
      (IsFractionRing.lift hinj : FractionRing ↥(integralClosure A F) →+* F) :=
    (IsFractionRing.lift hinj : FractionRing ↥(integralClosure A F) →+* F).injective

  have hfact : ∀ φ : T →ₐ[A] F, ∃ ψ : T →ₐ[A] FractionRing ↥(integralClosure A F),
      ∀ t, (IsFractionRing.lift hinj : FractionRing ↥(integralClosure A F) →+* F) (ψ t) = φ t := by
    intro φ
    obtain ⟨Ψ', hΨ'⟩ := wc_whls_ringHom_factor_fractionRing ↥(integralClosure A F) F
      (FractionRing ↥(integralClosure A F)) T hinj φ.toRingHom (by
        intro t
        obtain ⟨a, ha0, hai⟩ := wc_whls_point_integral_multiple A T F hWE φ t
        refine ⟨algebraMap A ↥(integralClosure A F) a,
          ⟨algebraMap A F a * φ t, hai⟩, ?_, ?_⟩
        · intro h
          apply ha0
          have h2 := congrArg (algebraMap ↥(integralClosure A F) F) h
          rw [map_zero, ← IsScalarTower.algebraMap_apply] at h2
          exact h2
        · rw [← IsScalarTower.algebraMap_apply]
          rfl)
    have hcomp : ∀ t, (IsFractionRing.lift hinj : FractionRing ↥(integralClosure A F) →+* F)
        (Ψ' t) = φ t := fun t => congrArg (fun f : T →+* F => f t) hΨ'
    refine ⟨{ toRingHom := Ψ', commutes' := ?_ }, ?_⟩
    · intro a
      apply hι
      show (IsFractionRing.lift hinj : FractionRing ↥(integralClosure A F) →+* F)
          (Ψ' (algebraMap A T a)) = (IsFractionRing.lift hinj : FractionRing ↥(integralClosure A F) →+* F)
          (algebraMap A (FractionRing ↥(integralClosure A F)) a)
      rw [hcomp, AlgHom.commutes,
        IsScalarTower.algebraMap_apply A ↥(integralClosure A F) (FractionRing ↥(integralClosure A F)),
        IsFractionRing.lift_algebraMap]
      exact IsScalarTower.algebraMap_apply A ↥(integralClosure A F) F a
    · exact hcomp
  obtain ⟨ψ₁, hψ₁⟩ := hfact φ₁
  obtain ⟨ψ₂, hψ₂⟩ := hfact φ₂

  have hBI : ∀ e : ↥(integralClosure A F) ⧸ I.map (algebraMap A ↥(integralClosure A F)),
      IsIdempotentElem e → e = 0 ∨ e = 1 :=
    wc_whls_integral_domain_idem_of_finite A I hfin ↥(integralClosure A F)

  have hC : ∀ c : TensorProduct A ↥(integralClosure A F) T, IsIdempotentElem c → c = 0 ∨ c = 1 :=
    wc_whls_tensor_integral_idem_trivial A T ↥(integralClosure A F) I hBI hT.jac hq

  haveI : IsIntegrallyClosed ↥(integralClosure A F) :=
    wc_whls_integralClosure_field_isIntegrallyClosed A F

  have hL := wc_whls_fraction_tensor_idem_trivial ↥(integralClosure A F)
    (TensorProduct A ↥(integralClosure A F) T) (FractionRing ↥(integralClosure A F))
    inferInstance hC

  have hΘ := wc_weaklyEtale_field_connected_unique (FractionRing ↥(integralClosure A F))
    (TensorProduct ↥(integralClosure A F) (FractionRing ↥(integralClosure A F))
      (TensorProduct A ↥(integralClosure A F) T)) inferInstance
      (fun e he => hL e (by rw [IsIdempotentElem]; exact he))
    (Algebra.TensorProduct.lift (AlgHom.id _ _)
      (Algebra.TensorProduct.lift (Algebra.ofId ↥(integralClosure A F)
        (FractionRing ↥(integralClosure A F))) ψ₁ (fun _ _ => Commute.all _ _))
      (fun _ _ => Commute.all _ _))
    (Algebra.TensorProduct.lift (AlgHom.id _ _)
      (Algebra.TensorProduct.lift (Algebra.ofId ↥(integralClosure A F)
        (FractionRing ↥(integralClosure A F))) ψ₂ (fun _ _ => Commute.all _ _))
      (fun _ _ => Commute.all _ _))
  have hψ : ∀ t, ψ₁ t = ψ₂ t := by
    intro t
    have h := congrArg (fun f => f (TensorProduct.tmul ↥(integralClosure A F)
      (1 : FractionRing ↥(integralClosure A F))
      (TensorProduct.tmul A (1 : ↥(integralClosure A F)) t))) hΘ
    simpa [Algebra.TensorProduct.lift_tmul] using h
  apply AlgHom.ext
  intro t
  rw [← hψ₁, ← hψ₂, hψ t]

theorem wc_whl_section_of_trivial_mod_I (A : Type u) [CommRing A] (I : Ideal A)
    [HenselianRing A I] (C : Type u) [CommRing C] [Algebra A C] [Algebra.WeaklyEtale A C]
    (ε : (C ⧸ Ideal.map (algebraMap A C) I) ≃ₐ[A] A ⧸ I) :
    Nonempty (C →ₐ[A] A) :=
by
  classical
  set J : Ideal C := Ideal.map (algebraMap A C) I with hJ
  have hB : @wcIndEtale (C ⧸ J) (C ⧸ J) _ _ (algebraMap (C ⧸ J) (C ⧸ J)) := by
    intro P _ _ _ h
    exact ⟨C ⧸ J, inferInstance, inferInstance, inferInstance, h, AlgHom.id _ _,
      AlgHom.id_comp h⟩
  obtain ⟨T, _, _, θ, hWE, hHen, hθ⟩ :=
    @wc_hte_henselization C _ J (C ⧸ J) _ (Algebra.id _) hB
  letI : Algebra A T := ((algebraMap C T).comp (algebraMap A C)).toAlgebra
  haveI : IsScalarTower A C T := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.WeaklyEtale A T := Algebra.WeaklyEtale.trans A C T
  have hIT : I.map (algebraMap A T) = J.map (algebraMap C T) := by
    rw [hJ, Ideal.map_map]; rfl
  have hHen' : HenselianRing T (I.map (algebraMap A T)) := by
    rw [hIT]; exact hHen

  have hθc : ∀ c : C, θ (Ideal.Quotient.mk (J.map (algebraMap C T)) (algebraMap C T c)) =
      Ideal.Quotient.mk J c := by
    intro c
    have := congrArg (fun f => f (Ideal.Quotient.mk J c)) hθ
    simpa [Ideal.quotientMap_mk] using this
  have hεa : ∀ a : A, ε (Ideal.Quotient.mk J (algebraMap A C a)) = Ideal.Quotient.mk I a := by
    intro a
    rw [Ideal.Quotient.mk_algebraMap, ε.commutes, Ideal.Quotient.algebraMap_eq]
  have hAT : ∀ a : A, algebraMap A T a = algebraMap C T (algebraMap A C a) := fun _ => rfl
  have hq : Function.Bijective
      (Ideal.quotientMap (I.map (algebraMap A T)) (algebraMap A T) Ideal.le_comap_map) := by
    constructor
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem, hIT, hAT] at hx
      have h1 : Ideal.Quotient.mk (J.map (algebraMap C T)) (algebraMap C T (algebraMap A C a)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hx
      have h2 : Ideal.Quotient.mk J (algebraMap A C a) = 0 := by
        rw [← hθc, h1, map_zero]
      rw [← hεa, h2, map_zero]
    · intro y
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        (ε (θ (Ideal.Quotient.mk (J.map (algebraMap C T)) t)))
      refine ⟨Ideal.Quotient.mk I a, ?_⟩
      rw [Ideal.quotientMap_mk, Ideal.Quotient.eq, hIT, hAT]
      have h3 : θ (Ideal.Quotient.mk (J.map (algebraMap C T)) (algebraMap C T (algebraMap A C a))) =
          θ (Ideal.Quotient.mk (J.map (algebraMap C T)) t) := by
        apply ε.injective
        rw [hθc, hεa, ha]
      have h4 := θ.injective h3
      exact Ideal.Quotient.eq.mp h4
  have hbij := wc_whls_henselian_trivial_fibre_iso A T I inferInstance inferInstance hHen' hq
  let e : A ≃ₐ[A] T := AlgEquiv.ofBijective (Algebra.ofId A T) hbij
  exact ⟨e.symm.toAlgHom.comp (IsScalarTower.toAlgHom A C T)⟩

theorem wc_whlz_local_lifts (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [WeaklyEtale f]
    (b : Spec (.of (A ⧸ I)) ⟶ X)
    (hb : b ≫ f = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    (H_aff : ∀ (A' : Type u) [CommRing A'] (I' : Ideal A') [HenselianRing A' I']
      (R' : Type u) [CommRing R'] [Algebra A' R'] [Algebra.WeaklyEtale A' R']
      (σb : R' →ₐ[A'] A' ⧸ I'), ∃ σ : R' →ₐ[A'] A', (Ideal.Quotient.mkₐ A' I').comp σ = σb) :
    ∃ (n : ℕ) (a : Fin n → A) (H : Fin n → Type u) (_ : ∀ k, CommRing (H k))
      (_ : ∀ k, Algebra A (H k)) (C : Fin n → Fin n → Type u) (_ : ∀ k l, CommRing (C k l))
      (_ : ∀ k l, Algebra A (C k l)) (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l)
      (θH : ∀ k, (H k ⧸ I.map (algebraMap A (H k))) ≃+*
        Localization.Away (Ideal.Quotient.mk I (a k)))
      (θC : ∀ k l, (C k l ⧸ I.map (algebraMap A (C k l))) ≃+*
        Localization.Away (Ideal.Quotient.mk I (a k * a l)))
      (g : ∀ k, Spec (.of (H k)) ⟶ X),
      Ideal.span (Set.range (fun k => Ideal.Quotient.mk I (a k))) = ⊤ ∧
      (∀ k, Algebra.WeaklyEtale A (H k)) ∧
      (∀ k, HenselianRing (H k) (I.map (algebraMap A (H k)))) ∧
      (∀ k, (θH k).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (H k)))
          (algebraMap A (H k)) Ideal.le_comap_map) =
        algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k)))) ∧
      (∀ k l, Algebra.WeaklyEtale A (C k l)) ∧
      (∀ k l, HenselianRing (C k l) (I.map (algebraMap A (C k l)))) ∧
      (∀ k l, (θC k l).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (C k l)))
          (algebraMap A (C k l)) Ideal.le_comap_map) =
        algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k * a l)))) ∧
      (∀ k, g k ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A (H k)))) ∧
      (∀ k, Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A (H k))))) ≫ g k =
        Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap A (H k)))
          (algebraMap A (H k)) Ideal.le_comap_map)) ≫ b) ∧
      (∀ k l, Spec.map (CommRingCat.ofHom (φ k l).toRingHom) ≫ g k =
        Spec.map (CommRingCat.ofHom (ψ k l).toRingHom) ≫ g l) :=
by
  classical

  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩
  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      have := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu

  have bc : ∀ (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra R S] [Algebra R B],
      Algebra.WeaklyEtale R S → Algebra.WeaklyEtale B (TensorProduct R B S) := by
    intro R S B _ _ _ _ _ hS
    have hpb := (isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct R B S)).flip
    have h1 : WeaklyEtale (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := B) (B := S)))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb (toSch R S hS)
    have e : (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := B) (B := S)) =
        algebraMap B (TensorProduct R B S) := by
      ext x
      simp [Algebra.TensorProduct.algebraMap_apply]
    rw [e] at h1
    exact toRing _ _ h1

  have away_tr : ∀ (B : Type u) [CommRing B] (s t w : B), w = s * t →
      (∃ τ : Localization.Away s →+* Localization.Away w,
        τ.comp (algebraMap B (Localization.Away s)) = algebraMap B (Localization.Away w)) ∧
      (∃ τ : Localization.Away t →+* Localization.Away w,
        τ.comp (algebraMap B (Localization.Away t)) = algebraMap B (Localization.Away w)) := by
    intro B _ s t w hw
    subst hw
    have hu : IsUnit (algebraMap B (Localization.Away (s * t)) (s * t)) :=
      IsLocalization.Away.algebraMap_isUnit (s * t)
    rw [map_mul] at hu
    have hs : IsUnit (algebraMap B (Localization.Away (s * t)) s) := isUnit_of_mul_isUnit_left hu
    have ht : IsUnit (algebraMap B (Localization.Away (s * t)) t) := isUnit_of_mul_isUnit_right hu
    refine ⟨⟨IsLocalization.Away.lift (S := Localization.Away s) s hs, ?_⟩,
      ⟨IsLocalization.Away.lift (S := Localization.Away t) t ht, ?_⟩⟩
    · ext x
      exact IsLocalization.Away.lift_eq (S := Localization.Away s) s hs x
    · ext x
      exact IsLocalization.Away.lift_eq (S := Localization.Away t) t ht x

  have lift_hens : ∀ (H : Type u) [CommRing H] [Algebra A H]
      (C : Type u) [CommRing C] [Algebra A C] [HenselianRing C (I.map (algebraMap A C))],
      Algebra.WeaklyEtale C (TensorProduct A C H) →
      ∀ (ρ : H →+* C ⧸ I.map (algebraMap A C)),
      ρ.comp (algebraMap A H) = algebraMap A (C ⧸ I.map (algebraMap A C)) →
      ∃ φ : H →ₐ[A] C, (Ideal.Quotient.mk (I.map (algebraMap A C))).comp φ.toRingHom = ρ := by
    intro H _ _ C _ _ _ hbc ρ hρ
    let ρa : H →ₐ[A] C ⧸ I.map (algebraMap A C) :=
      { ρ with commutes' := fun r => RingHom.congr_fun hρ r }
    let σb : TensorProduct A C H →ₐ[C] C ⧸ I.map (algebraMap A C) :=
      Algebra.TensorProduct.lift (Algebra.ofId C (C ⧸ I.map (algebraMap A C))) ρa
        (fun _ _ => Commute.all _ _)
    obtain ⟨σ, hσ⟩ := H_aff C (I.map (algebraMap A C)) (TensorProduct A C H) σb
    refine ⟨(σ.restrictScalars A).comp Algebra.TensorProduct.includeRight, ?_⟩
    ext h
    have := congrArg (fun m => m ((1 : C) ⊗ₜ[A] h)) hσ
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.comp_apply,
      AlgHom.restrictScalars_apply, Algebra.TensorProduct.includeRight_apply]
    rw [this]
    simp [σb, ρa]

  have cover : ∃ (n : ℕ) (a : Fin n → A) (W : Fin n → X.Opens),
      Ideal.span (Set.range (fun k => Ideal.Quotient.mk I (a k))) = ⊤ ∧
      (∀ k, IsAffineOpen (W k)) ∧
      ∀ (k : Fin n) (p : PrimeSpectrum (A ⧸ I)), Ideal.Quotient.mk I (a k) ∉ p.asIdeal →
        b p ∈ W k := by
    have hz : ∀ z : PrimeSpectrum (A ⧸ I), ∃ (W : X.Opens) (r : A), IsAffineOpen W ∧
        z ∈ PrimeSpectrum.basicOpen (Ideal.Quotient.mk I r) ∧
        ∀ p : PrimeSpectrum (A ⧸ I), p ∈ PrimeSpectrum.basicOpen (Ideal.Quotient.mk I r) →
          b p ∈ W := by
      intro z
      obtain ⟨W, hW, hzW, -⟩ := exists_isAffineOpen_mem_and_subset (x := b z) (U := ⊤) trivial
      have hopen : IsOpen ((b : Spec (.of (A ⧸ I)) → X) ⁻¹' (W : Set X)) :=
        W.isOpen.preimage b.continuous
      obtain ⟨_, ⟨rb, rfl⟩, hzr, hsub⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
          (a := z) (u := (b : Spec (.of (A ⧸ I)) → X) ⁻¹' (W : Set X)) hzW hopen
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective rb
      exact ⟨W, r, hW, hzr, fun p hp => hsub hp⟩
    choose W r hW hzr hsub using hz
    set S : Set (A ⧸ I) := Set.range (fun z => Ideal.Quotient.mk I (r z)) with hS
    have hspan : Ideal.span S = ⊤ := by
      by_contra hne
      obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
      let z₀ : PrimeSpectrum (A ⧸ I) := ⟨m, hm.isPrime⟩
      have h1 : Ideal.Quotient.mk I (r z₀) ∈ m := hle (Ideal.subset_span ⟨z₀, rfl⟩)
      have h2 := hzr z₀
      rw [PrimeSpectrum.mem_basicOpen] at h2
      exact h2 h1
    obtain ⟨s', hs'S, hs'⟩ := (Ideal.span_eq_top_iff_finite S).mp hspan
    have hpick : ∀ x : s', ∃ z, Ideal.Quotient.mk I (r z) = x.1 := fun x => hs'S x.2
    choose zf hzf using hpick
    let e := s'.equivFin
    refine ⟨s'.card, fun k => r (zf (e.symm k)), fun k => W (zf (e.symm k)), ?_,
      fun k => hW _, ?_⟩
    · rw [← hs']
      congr 1
      ext x
      simp only [Set.mem_range, Finset.mem_coe]
      constructor
      · rintro ⟨k, rfl⟩
        rw [hzf]
        exact (e.symm k).2
      · intro hx
        refine ⟨e ⟨x, hx⟩, ?_⟩
        simp [hzf]
    · intro k p hp
      exact hsub _ p hp

  have chart : ∀ (W : X.Opens), IsAffineOpen W →
      ∃ (R : Type u) (_ : CommRing R) (_ : Algebra A R) (j : Spec (.of R) ⟶ X),
        IsOpenImmersion j ∧ Set.range j = (W : Set X) ∧
        j ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A R)) ∧ Algebra.WeaklyEtale A R := by
    intro W hW
    haveI := hW.isOpenImmersion_fromSpec
    let φ₀ : CommRingCat.of A ⟶ Γ(X, W) := Spec.preimage (hW.fromSpec ≫ f)
    letI : Algebra A Γ(X, W) := φ₀.hom.toAlgebra
    have hjf : hW.fromSpec ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A Γ(X, W))) := by
      rw [← Spec.map_preimage (hW.fromSpec ≫ f)]
      rfl
    refine ⟨Γ(X, W), inferInstance, inferInstance, hW.fromSpec, inferInstance,
      hW.range_fromSpec, hjf, ?_⟩
    apply toRing
    rw [← hjf]
    infer_instance

  have restrict : ∀ (s : A) (R : Type u) [CommRing R] [Algebra A R] (j : Spec (.of R) ⟶ X)
      [IsOpenImmersion j],
      j ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A R)) →
      (∀ p : PrimeSpectrum (A ⧸ I), Ideal.Quotient.mk I s ∉ p.asIdeal → b p ∈ Set.range j) →
      ∃ β : R →+* Localization.Away (Ideal.Quotient.mk I s),
        Spec.map (CommRingCat.ofHom β) ≫ j =
          Spec.map (CommRingCat.ofHom (algebraMap (A ⧸ I)
            (Localization.Away (Ideal.Quotient.mk I s)))) ≫ b ∧
        β.comp (algebraMap A R) =
          (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s))).comp
            (Ideal.Quotient.mk I) := by
    intro s R _ _ j _ hjf hbj
    set L := Localization.Away (Ideal.Quotient.mk I s)
    set ι := Spec.map (CommRingCat.ofHom (algebraMap (A ⧸ I) L)) ≫ b with hι
    have hrange : Set.range ι ⊆ Set.range j := by
      rintro _ ⟨x, rfl⟩
      rw [hι, Scheme.Hom.comp_apply]
      apply hbj
      have hx : PrimeSpectrum.comap (algebraMap (A ⧸ I) L) (show PrimeSpectrum L from x) ∈
          (PrimeSpectrum.basicOpen (Ideal.Quotient.mk I s) : Set (PrimeSpectrum (A ⧸ I))) := by
        rw [← PrimeSpectrum.localization_away_comap_range L]
        exact ⟨x, rfl⟩
      exact hx
    have hκj : IsOpenImmersion.lift j ι hrange ≫ j = ι := IsOpenImmersion.lift_fac j ι hrange
    refine ⟨(Spec.preimage (IsOpenImmersion.lift j ι hrange)).hom, ?_, ?_⟩
    · rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      exact hκj
    · apply_fun (fun g => Spec.map (CommRingCat.ofHom g)) using
        (fun g₁ g₂ h => by
          have := Spec.map_injective h
          exact congrArg CommRingCat.Hom.hom this)
      simp only
      rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
        ← hjf, ← hb, CommRingCat.ofHom_hom, Spec.map_preimage, ← Category.assoc, hκj, hι,
        Category.assoc]

  have local_section : ∀ (L : Type u) [CommRing L] [Algebra (A ⧸ I) L]
      (H : Type u) [CommRing H] [Algebra A H]
      (θ : (H ⧸ I.map (algebraMap A H)) ≃+* L),
      θ.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) L →
      ∀ (R : Type u) [CommRing R] [Algebra A R] (j : Spec (.of R) ⟶ X),
      j ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A R)) →
      ∀ (β : R →+* L),
      Spec.map (CommRingCat.ofHom β) ≫ j =
        Spec.map (CommRingCat.ofHom (algebraMap (A ⧸ I) L)) ≫ b →
      β.comp (algebraMap A R) = (algebraMap (A ⧸ I) L).comp (Ideal.Quotient.mk I) →
      (∀ ρ : R →+* H ⧸ I.map (algebraMap A H),
        ρ.comp (algebraMap A R) = algebraMap A (H ⧸ I.map (algebraMap A H)) →
        ∃ γ : R →ₐ[A] H, (Ideal.Quotient.mk (I.map (algebraMap A H))).comp γ.toRingHom = ρ) →
      ∃ g : Spec (.of H) ⟶ X,
        g ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A H)) ∧
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A H)))) ≫ g =
          Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
            Ideal.le_comap_map)) ≫ b := by
    intro L _ _ H _ _ θ hθ R _ _ j hjf β hβ hβA hlift
    set qm := Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H) Ideal.le_comap_map
    have hθ' : θ.symm.toRingHom.comp (algebraMap (A ⧸ I) L) = qm := by
      rw [← hθ]; ext x; simp
    have hρ : (θ.symm.toRingHom.comp β).comp (algebraMap A R) =
        algebraMap A (H ⧸ I.map (algebraMap A H)) := by
      rw [RingHom.comp_assoc, hβA, ← RingHom.comp_assoc, hθ']
      ext x
      simp [qm, Ideal.quotientMap_mk, Ideal.Quotient.mk_algebraMap]
    obtain ⟨γ, hγ⟩ := hlift _ hρ
    refine ⟨Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ j, ?_, ?_⟩
    · rw [Category.assoc, hjf, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact γ.comp_algebraMap
    · rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hγ, CommRingCat.ofHom_comp,
        Spec.map_comp, Category.assoc, hβ, ← Category.assoc, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, hθ']

  have transition_lift : ∀ (L₁ L₃ : Type u) [CommRing L₁] [CommRing L₃] [Algebra (A ⧸ I) L₁]
      [Algebra (A ⧸ I) L₃] (H C : Type u) [CommRing H] [CommRing C] [Algebra A H] [Algebra A C]
      (θ₁ : (H ⧸ I.map (algebraMap A H)) ≃+* L₁) (θ₃ : (C ⧸ I.map (algebraMap A C)) ≃+* L₃),
      θ₁.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) L₁ →
      θ₃.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A C)) (algebraMap A C)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) L₃ →
      ∀ (τ : L₁ →+* L₃), τ.comp (algebraMap (A ⧸ I) L₁) = algebraMap (A ⧸ I) L₃ →
      (∀ ρ : H →+* C ⧸ I.map (algebraMap A C),
        ρ.comp (algebraMap A H) = algebraMap A (C ⧸ I.map (algebraMap A C)) →
        ∃ φ : H →ₐ[A] C, (Ideal.Quotient.mk (I.map (algebraMap A C))).comp φ.toRingHom = ρ) →
      ∃ φ : H →ₐ[A] C, (Ideal.Quotient.mk (I.map (algebraMap A C))).comp φ.toRingHom =
        θ₃.symm.toRingHom.comp (τ.comp (θ₁.toRingHom.comp
          (Ideal.Quotient.mk (I.map (algebraMap A H))))) := by
    intro L₁ L₃ _ _ _ _ H C _ _ _ _ θ₁ θ₃ hθ₁ hθ₃ τ hτ hlift
    apply hlift
    ext x
    have e1 := RingHom.congr_fun hθ₁ (Ideal.Quotient.mk I x)
    have e3 := RingHom.congr_fun hθ₃ (Ideal.Quotient.mk I x)
    have eτ := RingHom.congr_fun hτ (Ideal.Quotient.mk I x)
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
      RingHom.coe_coe] at e1 e3 eτ ⊢
    simp only [Ideal.quotientMap_mk] at e1
    rw [e1, eτ, ← e3]
    simp only [RingEquiv.symm_apply_apply, Ideal.quotientMap_mk, Ideal.Quotient.mk_algebraMap]

  haveI : Flat (Limits.pullback.diagonal f) := WeaklyEtale.flat_diagonal
  have key : ∀ (C : Type u) [CommRing C] [Algebra A C] (L₃ : Type u) [CommRing L₃]
      [Algebra (A ⧸ I) L₃] (θ₃ : (C ⧸ I.map (algebraMap A C)) ≃+* L₃)
      (H : Type u) [CommRing H] [Algebra A H] (L : Type u) [CommRing L] [Algebra (A ⧸ I) L]
      (θ : (H ⧸ I.map (algebraMap A H)) ≃+* L),
      θ.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) L →
      ∀ (τ : L →+* L₃), τ.comp (algebraMap (A ⧸ I) L) = algebraMap (A ⧸ I) L₃ →
      ∀ (g : Spec (.of H) ⟶ X),
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A H)))) ≫ g =
        Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
          Ideal.le_comap_map)) ≫ b →
      ∀ (φ : H →ₐ[A] C),
      (Ideal.Quotient.mk (I.map (algebraMap A C))).comp φ.toRingHom =
        θ₃.symm.toRingHom.comp (τ.comp (θ.toRingHom.comp
          (Ideal.Quotient.mk (I.map (algebraMap A H))))) →
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A C)))) ≫
        Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ g =
        Spec.map (CommRingCat.ofHom (θ₃.symm.toRingHom.comp (algebraMap (A ⧸ I) L₃))) ≫ b := by
    intro C _ _ L₃ _ _ θ₃ H _ _ L _ _ θ hθ τ hτ g hb' φ hφ
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hφ]
    have e : θ₃.symm.toRingHom.comp (τ.comp (θ.toRingHom.comp
          (Ideal.Quotient.mk (I.map (algebraMap A H))))) =
        (θ₃.symm.toRingHom.comp (τ.comp θ.toRingHom)).comp
          (Ideal.Quotient.mk (I.map (algebraMap A H))) := rfl
    rw [e, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, hb', ← Category.assoc,
      ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 3
    rw [← hτ, ← hθ]
    rfl
  have key2 : ∀ (C : Type u) [CommRing C] [Algebra A C] (H : Type u) [CommRing H] [Algebra A H]
      (g : Spec (.of H) ⟶ X), g ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A H)) →
      ∀ (φ : H →ₐ[A] C),
      (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ g) ≫ f =
        Spec.map (CommRingCat.ofHom (algebraMap A C)) := by
    intro C _ _ H _ _ g hg φ
    rw [Category.assoc, hg, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact φ.comp_algebraMap

  obtain ⟨n, a, W, hspan, hWaff, hbW⟩ := cover
  choose R iR aR j hjo hjr hjf hRwe using fun k => chart (W k) (hWaff k)
  have hβex : ∀ k, ∃ β : R k →+* Localization.Away (Ideal.Quotient.mk I (a k)),
      Spec.map (CommRingCat.ofHom β) ≫ j k =
        Spec.map (CommRingCat.ofHom (algebraMap (A ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (a k))))) ≫ b ∧
      β.comp (algebraMap A (R k)) =
        (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k)))).comp
          (Ideal.Quotient.mk I) := by
    intro k
    haveI := hjo k
    refine restrict (a k) (R k) (j k) (hjf k) ?_
    intro p hp
    rw [hjr k]
    exact hbW k p hp
  choose β hβ hβA using hβex
  choose H iH aH θH hHwe hHhen hHθ using fun k =>
    wc_hte_henselization A I (Localization.Away (Ideal.Quotient.mk I (a k)))
      (wc_sh_localization_indEtale (A ⧸ I) _ (Submonoid.powers (Ideal.Quotient.mk I (a k))))
  choose C iC aC θC hCwe hChen hCθ using fun (k l : Fin n) =>
    wc_hte_henselization A I (Localization.Away (Ideal.Quotient.mk I (a k * a l)))
      (wc_sh_localization_indEtale (A ⧸ I) _
        (Submonoid.powers (Ideal.Quotient.mk I (a k * a l))))
  have hT := fun (k l : Fin n) => away_tr (A ⧸ I) (Ideal.Quotient.mk I (a k))
    (Ideal.Quotient.mk I (a l)) (Ideal.Quotient.mk I (a k * a l)) (map_mul _ _ _)
  choose τ₁ hτ₁ using fun k l => (hT k l).1
  choose τ₂ hτ₂ using fun k l => (hT k l).2
  have hliftHC : ∀ (k' k l : Fin n) (ρ : H k' →+* C k l ⧸ I.map (algebraMap A (C k l))),
      ρ.comp (algebraMap A (H k')) = algebraMap A (C k l ⧸ I.map (algebraMap A (C k l))) →
      ∃ φ : H k' →ₐ[A] C k l,
        (Ideal.Quotient.mk (I.map (algebraMap A (C k l)))).comp φ.toRingHom = ρ := by
    intro k' k l ρ hρ
    haveI := hChen k l
    exact lift_hens (H k') (C k l) (bc A (H k') (C k l) (hHwe k')) ρ hρ
  have hliftRH : ∀ (k : Fin n) (ρ : R k →+* H k ⧸ I.map (algebraMap A (H k))),
      ρ.comp (algebraMap A (R k)) = algebraMap A (H k ⧸ I.map (algebraMap A (H k))) →
      ∃ γ : R k →ₐ[A] H k,
        (Ideal.Quotient.mk (I.map (algebraMap A (H k)))).comp γ.toRingHom = ρ := by
    intro k ρ hρ
    haveI := hHhen k
    exact lift_hens (R k) (H k) (bc A (R k) (H k) (hRwe k)) ρ hρ
  choose φ hφ using fun (k l : Fin n) =>
    transition_lift _ _ (H k) (C k l) (θH k) (θC k l) (hHθ k) (hCθ k l) (τ₁ k l) (hτ₁ k l)
      (hliftHC k k l)
  choose ψ hψ using fun (k l : Fin n) =>
    transition_lift _ _ (H l) (C k l) (θH l) (θC k l) (hHθ l) (hCθ k l) (τ₂ k l) (hτ₂ k l)
      (hliftHC l k l)
  choose g hL1 hL2 using fun k =>
    local_section _ (H k) (θH k) (hHθ k) (R k) (j k) (hjf k) (β k) (hβ k) (hβA k) (hliftRH k)
  have hL3 : ∀ k l, Spec.map (CommRingCat.ofHom (φ k l).toRingHom) ≫ g k =
      Spec.map (CommRingCat.ofHom (ψ k l).toRingHom) ≫ g l := by
    intro k l
    haveI := hChen k l
    apply wc_whl_unique f (C k l) (I.map (algebraMap A (C k l)))
    · rw [key (C k l) _ (θC k l) (H k) _ (θH k) (hHθ k) (τ₁ k l) (hτ₁ k l) (g k) (hL2 k)
          (φ k l) (hφ k l),
        key (C k l) _ (θC k l) (H l) _ (θH l) (hHθ l) (τ₂ k l) (hτ₂ k l) (g l) (hL2 l)
          (ψ k l) (hψ k l)]
    · rw [key2 (C k l) (H k) (g k) (hL1 k) (φ k l), key2 (C k l) (H l) (g l) (hL1 l) (ψ k l)]
  exact ⟨n, a, H, iH, aH, C, iC, aC, φ, ψ, θH, θC, g, hspan, hHwe, hHhen, hHθ, hCwe, hChen, hCθ,
    hL1, hL2, hL3⟩

theorem wc_whlz_jointly_surjective (A : Type u) [CommRing A] (I : Ideal A)
    (hI : I ≤ (⊥ : Ideal A).jacobson) (n : ℕ) (a : Fin n → A)
    (hspan : Ideal.span (Set.range (fun k => Ideal.Quotient.mk I (a k))) = ⊤)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (hflat : ∀ k, Module.Flat A (H k))
    (θH : ∀ k, (H k ⧸ I.map (algebraMap A (H k))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k)))
    (hHθ : ∀ k, (θH k).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (H k)))
        (algebraMap A (H k)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k)))) :
    ∀ p : PrimeSpectrum A, ∃ k, ∃ P : PrimeSpectrum (H k),
      PrimeSpectrum.comap (algebraMap A (H k)) P = p :=
by
  classical
  intro p
  obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
  have hIm : I ≤ m := by
    refine hI.trans ?_
    show sInf _ ≤ m
    exact sInf_le ⟨bot_le, hm⟩
  set qb : Ideal (A ⧸ I) := Ideal.map (Ideal.Quotient.mk I) m with hqb
  have hqbP : qb.IsPrime := by
    haveI := hm.isPrime
    exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hIm)
  have hqbc : Ideal.comap (Ideal.Quotient.mk I) qb = m := by
    rw [hqb, Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hIm
  have hex : ∃ k, Ideal.Quotient.mk I (a k) ∉ qb := by
    by_contra hcon
    push_neg at hcon
    apply hqbP.ne_top
    rw [eq_top_iff, ← hspan, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    exact hcon k
  obtain ⟨k, hk⟩ := hex
  have hdisj : Disjoint (↑(Submonoid.powers (Ideal.Quotient.mk I (a k))) : Set (A ⧸ I))
      ↑qb :=
    (Ideal.disjoint_powers_iff_notMem _ hqbP.isRadical).mpr hk
  haveI hQb : (Ideal.map (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k))))
      qb).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers _) _ qb hqbP hdisj
  have hunder := IsLocalization.under_map_of_isPrime_disjoint
    (Submonoid.powers (Ideal.Quotient.mk I (a k)))
    (Localization.Away (Ideal.Quotient.mk I (a k))) hqbP hdisj
  set Qb := Ideal.map (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k)))) qb
    with hQbdef
  set Q : Ideal (H k) := Ideal.comap (Ideal.Quotient.mk (I.map (algebraMap A (H k))))
    (Ideal.comap (θH k).toRingHom Qb) with hQdef
  haveI hQ : Q.IsPrime := Ideal.comap_isPrime _ _
  have hQm : Ideal.comap (algebraMap A (H k)) Q = m := by
    rw [hQdef, Ideal.comap_comap, ← Ideal.quotientMap_comp_mk Ideal.le_comap_map,
      ← Ideal.comap_comap, Ideal.comap_comap _ (θH k).toRingHom, hHθ k]
    rw [← hqbc]
    congr 1
  haveI := hflat k
  haveI := hm.isPrime
  haveI := p.isPrime
  haveI : Q.LiesOver m := ⟨by rw [Ideal.under_def, hQm]⟩
  obtain ⟨P, -, hP, hPp⟩ := Ideal.exists_ideal_le_liesOver_of_le (p := p.asIdeal) (q := m) Q hpm
  refine ⟨k, ⟨P, hP⟩, PrimeSpectrum.ext ?_⟩
  rw [PrimeSpectrum.comap_asIdeal]
  exact (hPp.over.trans (Ideal.under_def A P)).symm

theorem wc_rd_tensor_mod_bijective (A : Type u) [CommRing A] (I : Ideal A) (a b : A)
    (H H' C : Type u) [CommRing H] [CommRing H'] [CommRing C] [Algebra A H] [Algebra A H'] [Algebra A C]
    (θ : (H ⧸ I.map (algebraMap A H)) ≃+* Localization.Away (Ideal.Quotient.mk I a))
    (hθ : θ.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I a)))
    (θ' : (H' ⧸ I.map (algebraMap A H')) ≃+* Localization.Away (Ideal.Quotient.mk I b))
    (hθ' : θ'.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H')) (algebraMap A H')
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I b)))
    (θC : (C ⧸ I.map (algebraMap A C)) ≃+* Localization.Away (Ideal.Quotient.mk I (a * b)))
    (hθC : θC.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A C)) (algebraMap A C)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a * b))))
    (φ : H →ₐ[A] C) (ψ : H' →ₐ[A] C)
    (hle : I.map (algebraMap A (TensorProduct A H H')) ≤ (I.map (algebraMap A C)).comap
      (Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _)).toRingHom) :
    Function.Bijective (Ideal.quotientMap (I.map (algebraMap A C))
      (Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _)).toRingHom hle) :=
by
  classical

  have F0 : ∀ (X : Type u) [CommRing X] [Algebra A X] (c : A)
      (θX : (X ⧸ I.map (algebraMap A X)) ≃+* Localization.Away (Ideal.Quotient.mk I c)),
      θX.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A X)) (algebraMap A X)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I c)) →
      ∀ x : A, θX (Ideal.Quotient.mk (I.map (algebraMap A X)) (algebraMap A X x)) =
        algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I c)) (Ideal.Quotient.mk I x) := by
    intro X _ _ c θX hθX x
    have h := RingHom.congr_fun hθX (Ideal.Quotient.mk I x)
    rw [RingHom.comp_apply, Ideal.quotientMap_mk] at h
    exact h
  have F1 : ∀ (X : Type u) [CommRing X] [Algebra A X] (c : A)
      (θX : (X ⧸ I.map (algebraMap A X)) ≃+* Localization.Away (Ideal.Quotient.mk I c)),
      θX.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A X)) (algebraMap A X)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I c)) →
      ∀ x : A, θX.symm (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I c))
        (Ideal.Quotient.mk I x)) = Ideal.Quotient.mk (I.map (algebraMap A X)) (algebraMap A X x) := by
    intro X _ _ c θX hθX x
    rw [← F0 X c θX hθX x]
    exact θX.symm_apply_apply _

  have s1 : ∀ (X : Type u) [CommRing X] [Algebra A X] (c : A)
      (θX : (X ⧸ I.map (algebraMap A X)) ≃+* Localization.Away (Ideal.Quotient.mk I c)),
      θX.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A X)) (algebraMap A X)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I c)) →
      ∀ (R : Type u) [CommRing R] (f g : (X ⧸ I.map (algebraMap A X)) →+* R),
      (∀ x : A, f (Ideal.Quotient.mk (I.map (algebraMap A X)) (algebraMap A X x)) =
        g (Ideal.Quotient.mk (I.map (algebraMap A X)) (algebraMap A X x))) → f = g := by
    intro X _ _ c θX hθX R _ f g hfg
    have hjk : f.comp θX.symm.toRingHom = g.comp θX.symm.toRingHom := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk I c))
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
      rw [F1 X c θX hθX x]
      exact hfg x
    ext y
    have := RingHom.congr_fun hjk (θX y)
    simpa using this

  have s2 : ∀ (X : Type u) [CommRing X] [Algebra A X] (c : A)
      (θX : (X ⧸ I.map (algebraMap A X)) ≃+* Localization.Away (Ideal.Quotient.mk I c)),
      θX.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A X)) (algebraMap A X)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I c)) →
      IsUnit (Ideal.Quotient.mk (I.map (algebraMap A X)) (algebraMap A X c)) := by
    intro X _ _ c θX hθX
    rw [← F1 X c θX hθX c]
    exact (IsLocalization.Away.algebraMap_isUnit (Ideal.Quotient.mk I c)).map θX.symm

  have hmaple : ∀ (X Y : Type u) [CommRing X] [CommRing Y] [Algebra A X] [Algebra A Y]
      (e : X →ₐ[A] Y), I.map (algebraMap A X) ≤ (I.map (algebraMap A Y)).comap e.toRingHom := by
    intro X Y _ _ _ _ e
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_map]
    have h : e.toRingHom.comp (algebraMap A X) = algebraMap A Y := e.comp_algebraMap
    rw [h]
  have hι : ∀ (X Y : Type u) [CommRing X] [CommRing Y] [Algebra A X] [Algebra A Y]
      (e : X →ₐ[A] Y) (x : A),
      Ideal.quotientMap (I.map (algebraMap A Y)) e.toRingHom (hmaple X Y e)
        (Ideal.Quotient.mk (I.map (algebraMap A X)) (algebraMap A X x)) =
      Ideal.Quotient.mk (I.map (algebraMap A Y)) (algebraMap A Y x) := by
    intro X Y _ _ _ _ e x
    rw [Ideal.quotientMap_mk]
    exact congrArg _ (e.commutes x)

  have s3 : ∀ (R : Type u) [CommRing R]
      (f g : (TensorProduct A H H' ⧸ I.map (algebraMap A (TensorProduct A H H'))) →+* R),
      (∀ x : A, f (Ideal.Quotient.mk (I.map (algebraMap A (TensorProduct A H H')))
          (algebraMap A (TensorProduct A H H') x)) =
        g (Ideal.Quotient.mk (I.map (algebraMap A (TensorProduct A H H')))
          (algebraMap A (TensorProduct A H H') x))) → f = g := by
    intro R _ f g hfg
    apply Ideal.Quotient.ringHom_ext
    apply Algebra.TensorProduct.ringHom_ext
    · have h := hι H (TensorProduct A H H')
        (Algebra.TensorProduct.includeLeft : H →ₐ[A] TensorProduct A H H')
      have e := s1 H a θ hθ R
        (f.comp (Ideal.quotientMap _ _ (hmaple H _
          (Algebra.TensorProduct.includeLeft : H →ₐ[A] TensorProduct A H H'))))
        (g.comp (Ideal.quotientMap _ _ (hmaple H _
          (Algebra.TensorProduct.includeLeft : H →ₐ[A] TensorProduct A H H'))))
        (fun x => (congrArg f (h x)).trans ((hfg x).trans (congrArg g (h x)).symm))
      ext y
      have := RingHom.congr_fun e (Ideal.Quotient.mk _ y)
      simpa [Ideal.quotientMap_mk] using this
    · have h := hι H' (TensorProduct A H H')
        (Algebra.TensorProduct.includeRight : H' →ₐ[A] TensorProduct A H H')
      have e := s1 H' b θ' hθ' R
        (f.comp (Ideal.quotientMap _ _ (hmaple H' _
          (Algebra.TensorProduct.includeRight : H' →ₐ[A] TensorProduct A H H'))))
        (g.comp (Ideal.quotientMap _ _ (hmaple H' _
          (Algebra.TensorProduct.includeRight : H' →ₐ[A] TensorProduct A H H'))))
        (fun x => (congrArg f (h x)).trans ((hfg x).trans (congrArg g (h x)).symm))
      ext y
      have := RingHom.congr_fun e (Ideal.Quotient.mk _ y)
      simpa [Ideal.quotientMap_mk] using this

  have hgT : ∀ x : A, Ideal.quotientMap (I.map (algebraMap A (TensorProduct A H H')))
      (algebraMap A (TensorProduct A H H')) Ideal.le_comap_map (Ideal.Quotient.mk I x) =
      Ideal.Quotient.mk (I.map (algebraMap A (TensorProduct A H H')))
        (algebraMap A (TensorProduct A H H') x) := fun x => Ideal.quotientMap_mk
  have hu : IsUnit (Ideal.quotientMap (I.map (algebraMap A (TensorProduct A H H')))
      (algebraMap A (TensorProduct A H H')) Ideal.le_comap_map (Ideal.Quotient.mk I (a * b))) := by
    rw [hgT, map_mul, map_mul]
    apply IsUnit.mul
    · rw [← hι H (TensorProduct A H H')
        (Algebra.TensorProduct.includeLeft : H →ₐ[A] TensorProduct A H H') a]
      exact (s2 H a θ hθ).map _
    · rw [← hι H' (TensorProduct A H H')
        (Algebra.TensorProduct.includeRight : H' →ₐ[A] TensorProduct A H H') b]
      exact (s2 H' b θ' hθ').map _
  let κ : (C ⧸ I.map (algebraMap A C)) →+*
      (TensorProduct A H H' ⧸ I.map (algebraMap A (TensorProduct A H H'))) :=
    (IsLocalization.Away.lift (Ideal.Quotient.mk I (a * b)) hu).comp θC.toRingHom
  have hκ : ∀ x : A, κ (Ideal.Quotient.mk (I.map (algebraMap A C)) (algebraMap A C x)) =
      Ideal.Quotient.mk (I.map (algebraMap A (TensorProduct A H H')))
        (algebraMap A (TensorProduct A H H') x) := by
    intro x
    show IsLocalization.Away.lift (Ideal.Quotient.mk I (a * b)) hu
      (θC (Ideal.Quotient.mk (I.map (algebraMap A C)) (algebraMap A C x))) = _
    rw [F0 C (a * b) θC hθC x, IsLocalization.Away.lift_eq, hgT]
  have hℓ := hι _ _ (Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _))
  have h1 : (Ideal.quotientMap (I.map (algebraMap A C))
      (Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _)).toRingHom hle).comp κ =
      RingHom.id _ :=
    s1 C (a * b) θC hθC _ _ _ (fun x => by
      rw [RingHom.comp_apply, hκ x, RingHom.id_apply]
      exact hℓ x)
  have h2 : κ.comp (Ideal.quotientMap (I.map (algebraMap A C))
      (Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _)).toRingHom hle) =
      RingHom.id _ :=
    s3 _ _ _ (fun x => by
      rw [RingHom.comp_apply, RingHom.id_apply]
      rw [show Ideal.quotientMap (I.map (algebraMap A C))
        (Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _)).toRingHom hle
          (Ideal.Quotient.mk (I.map (algebraMap A (TensorProduct A H H')))
            (algebraMap A (TensorProduct A H H') x)) =
          Ideal.Quotient.mk (I.map (algebraMap A C)) (algebraMap A C x) from hℓ x]
      exact hκ x)
  exact Function.bijective_iff_has_inverse.mpr
    ⟨κ, fun y => RingHom.congr_fun h2 y, fun y => RingHom.congr_fun h1 y⟩

theorem wc_rd_etale_approx (A : Type u) [CommRing A] (I : Ideal A) (n : ℕ)
    (T : Fin n → Type u) [∀ k, CommRing (T k)] [∀ k, Algebra A (T k)]
    (hind : ∀ k, wcIndEtale (algebraMap A (T k))) (x : ∀ k, T k)
    (hrel : ∀ k l, ∃ s : TensorProduct A (T k) (T l),
      s * (TensorProduct.tmul A (x k) 1 - TensorProduct.tmul A 1 (x l)) = 0 ∧
      1 - s ∈ I.map (algebraMap A (TensorProduct A (T k) (T l)))) :
    ∃ (E : Fin n → Type u) (_ : ∀ k, CommRing (E k)) (_ : ∀ k, Algebra A (E k)),
      (∀ k, Algebra.Etale A (E k)) ∧ ∃ (β : ∀ k, E k →ₐ[A] T k) (e : ∀ k, E k),
        (∀ k, β k (e k) = x k) ∧ ∀ k l, ∃ s : TensorProduct A (E k) (E l),
          s * (TensorProduct.tmul A (e k) 1 - TensorProduct.tmul A 1 (e l)) = 0 ∧
          1 - s ∈ I.map (algebraMap A (TensorProduct A (E k) (E l))) :=
by
  classical

  have hfin : ∀ {R S F : Type u} [CommRing R] [CommRing S] [FunLike F R S] [RingHomClass F R S]
      (f : F) (K : Ideal R) (y : S), y ∈ K.map f →
      ∃ N : Finset R, (N : Set R) ⊆ K ∧ y ∈ (Ideal.span (N : Set R)).map f := by
    intro R S F _ _ _ _ f K y hy
    obtain ⟨G, hG, hyG⟩ := Submodule.mem_span_finite_of_mem_span hy
    obtain ⟨N, hN, rfl⟩ := Finset.subset_set_image_iff.mp hG
    refine ⟨N, hN, ?_⟩
    rw [Ideal.map_span]
    rw [Finset.coe_image] at hyG
    exact hyG

  have hlift : ∀ (T T' : Type u) [CommRing T] [CommRing T'] [Algebra A T] [Algebra A T']
      (x : T) (x' : T') (s : TensorProduct A T T'),
      s * (TensorProduct.tmul A x 1 - TensorProduct.tmul A 1 x') = 0 →
      1 - s ∈ I.map (algebraMap A (TensorProduct A T T')) →
      ∃ (st : TensorProduct A (MvPolynomial T A) (MvPolynomial T' A))
        (L : Finset (MvPolynomial T A)) (R : Finset (MvPolynomial T' A)),
        (∀ κ ∈ L, MvPolynomial.aeval (fun t : T => t) κ = 0) ∧
        (∀ κ ∈ R, MvPolynomial.aeval (fun t : T' => t) κ = 0) ∧
        1 - st ∈ I.map (algebraMap A (TensorProduct A (MvPolynomial T A) (MvPolynomial T' A))) ∧
        st * (TensorProduct.tmul A (MvPolynomial.X x) 1 -
            TensorProduct.tmul A 1 (MvPolynomial.X x')) ∈
          Ideal.map (Algebra.TensorProduct.includeLeft :
              MvPolynomial T A →ₐ[A] TensorProduct A (MvPolynomial T A) (MvPolynomial T' A))
            (Ideal.span (L : Set (MvPolynomial T A))) ⊔
          Ideal.map (Algebra.TensorProduct.includeRight :
              MvPolynomial T' A →ₐ[A] TensorProduct A (MvPolynomial T A) (MvPolynomial T' A))
            (Ideal.span (R : Set (MvPolynomial T' A))) := by
    intro T T' _ _ _ _ x x' s hs h1
    let π : MvPolynomial T A →ₐ[A] T := MvPolynomial.aeval (fun t : T => t)
    let π' : MvPolynomial T' A →ₐ[A] T' := MvPolynomial.aeval (fun t : T' => t)
    have hπ : Function.Surjective π := fun t => ⟨MvPolynomial.X t, MvPolynomial.aeval_X _ _⟩
    have hπ' : Function.Surjective π' := fun t => ⟨MvPolynomial.X t, MvPolynomial.aeval_X _ _⟩
    let PP := Algebra.TensorProduct.map π π'
    have hPP : Function.Surjective PP := Algebra.TensorProduct.map_surjective π π' hπ hπ'
    have hIm : I.map (algebraMap A (TensorProduct A T T')) =
        (I.map (algebraMap A (TensorProduct A (MvPolynomial T A) (MvPolynomial T' A)))).map
          (PP : TensorProduct A (MvPolynomial T A) (MvPolynomial T' A) →+* TensorProduct A T T') := by
      rw [Ideal.map_map]
      congr 1
      exact (PP.comp_algebraMap).symm
    rw [hIm] at h1
    obtain ⟨z, hz, hzs⟩ := (Ideal.mem_map_iff_of_surjective
      (PP : TensorProduct A (MvPolynomial T A) (MvPolynomial T' A) →+* TensorProduct A T T')
      hPP).mp h1
    have hzs' : PP z = 1 - s := hzs
    have hD : PP (TensorProduct.tmul A (MvPolynomial.X x) 1 -
        TensorProduct.tmul A 1 (MvPolynomial.X x')) =
        TensorProduct.tmul A x 1 - TensorProduct.tmul A 1 x' := by
      simp [PP, π, π']
    have hker : (1 - z) * (TensorProduct.tmul A (MvPolynomial.X x) 1 -
        TensorProduct.tmul A 1 (MvPolynomial.X x')) ∈ RingHom.ker PP := by
      rw [RingHom.mem_ker, map_mul, map_sub, map_one, hzs', sub_sub_cancel, hD, hs]
    rw [Algebra.TensorProduct.map_ker _ _ hπ hπ'] at hker
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hker
    obtain ⟨L, hL, haL⟩ := hfin _ (RingHom.ker π) a ha
    obtain ⟨R, hR, hbR⟩ := hfin _ (RingHom.ker π') b hb
    refine ⟨1 - z, L, R, fun κ hκ => RingHom.mem_ker.mp (hL hκ),
      fun κ hκ => RingHom.mem_ker.mp (hR hκ), by rwa [sub_sub_cancel], ?_⟩
    rw [← hab]
    exact Submodule.add_mem_sup haL hbR

  have hs3 : ∀ (T : Type u) [CommRing T] [Algebra A T], wcIndEtale (algebraMap A T) →
      ∀ (S : Finset T) (N : Finset (MvPolynomial T A)),
      (∀ κ ∈ N, MvPolynomial.aeval (fun t : T => t) κ = 0) →
      ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E), Algebra.Etale A E ∧
        ∃ (β : E →ₐ[A] T) (γ : MvPolynomial T A →ₐ[A] E),
          (∀ κ ∈ N, γ κ = 0) ∧ ∀ t ∈ S, β (γ (MvPolynomial.X t)) = t := by
    intro T _ _ hind S N hN
    have hind' : ∀ (P : Type u) [CommRing P] [Algebra A P] [Algebra.FinitePresentation A P]
        (h : P →ₐ[A] T), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E), Algebra.Etale A E ∧
          ∃ (α : P →ₐ[A] E) (β : E →ₐ[A] T), β.comp α = h := by
      have e : (algebraMap A T).toAlgebra = ‹Algebra A T› :=
        Algebra.algebra_ext _ _ (fun _ => rfl)
      unfold wcIndEtale at hind
      rw [e] at hind
      exact hind
    let V : Finset T := S ∪ N.biUnion (fun κ => κ.vars)
    let r : MvPolynomial T A →ₐ[A] MvPolynomial V A :=
      MvPolynomial.aeval (fun t : T => if h : t ∈ V then MvPolynomial.X ⟨t, h⟩ else 0)
    let ev : MvPolynomial V A →ₐ[A] T := MvPolynomial.aeval (fun v : V => (v : T))
    have hrX : ∀ t (h : t ∈ V), r (MvPolynomial.X t) = MvPolynomial.X ⟨t, h⟩ := by
      intro t h
      simp [r, h]
    have hb1 : ∀ κ : MvPolynomial T A, κ.vars ⊆ V →
        ev (r κ) = MvPolynomial.aeval (fun t : T => t) κ := by
      intro κ hκ
      have := MvPolynomial.hom_congr_vars (f₁ := (ev.comp r).toRingHom)
        (f₂ := (MvPolynomial.aeval (R := A) (fun t : T => t)).toRingHom) (p₁ := κ) (p₂ := κ)
        ?_ ?_ rfl
      · exact this
      · ext a
        simp
      · intro i hi _
        have hiV : i ∈ V := hκ hi
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.comp_apply]
        rw [hrX i hiV]
        simp [ev]
    let J : Ideal (MvPolynomial V A) :=
      Ideal.span ((N.image r : Finset (MvPolynomial V A)) : Set (MvPolynomial V A))
    have hJ : ∀ a ∈ J, ev a = 0 := by
      have hle : J ≤ RingHom.ker ev := by
        apply Ideal.span_le.mpr
        intro q hq
        rw [Finset.coe_image] at hq
        obtain ⟨κ, hκ, rfl⟩ := hq
        rw [SetLike.mem_coe, RingHom.mem_ker, hb1 κ ?_, hN κ hκ]
        intro i hi
        exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨κ, hκ, hi⟩)
      intro a ha
      exact hle ha
    have : Algebra.FinitePresentation A (MvPolynomial V A ⧸ J) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span (N.image r).finite_toSet)
    let h : (MvPolynomial V A ⧸ J) →ₐ[A] T := Ideal.Quotient.liftₐ J ev hJ
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hind' _ h
    refine ⟨E, inferInstance, inferInstance, hE, β, α.comp ((Ideal.Quotient.mkₐ A J).comp r),
      ?_, ?_⟩
    · intro κ hκ
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem r hκ))), map_zero]
    · intro t ht
      have htV : t ∈ V := Finset.mem_union_left _ ht
      have := congrArg (fun f => f (Ideal.Quotient.mk J (r (MvPolynomial.X t)))) hαβ
      simp only [AlgHom.comp_apply] at this
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      rw [this]
      show ev (r (MvPolynomial.X t)) = t
      rw [hrX t htV]
      simp [ev]

  choose s0 hs0 hs01 using hrel
  choose st L R hL hR h1 h2 using fun k l =>
    hlift (T k) (T l) (x k) (x l) (s0 k l) (hs0 k l) (hs01 k l)
  let N : ∀ k, Finset (MvPolynomial (T k) A) := fun k =>
    (Finset.univ.biUnion fun l => L k l) ∪ (Finset.univ.biUnion fun l => R l k)
  have hN : ∀ k, ∀ κ ∈ N k, MvPolynomial.aeval (fun t : T k => t) κ = 0 := by
    intro k κ hκ
    rcases Finset.mem_union.mp hκ with h | h
    · obtain ⟨l, _, hl⟩ := Finset.mem_biUnion.mp h
      exact hL k l κ hl
    · obtain ⟨l, _, hl⟩ := Finset.mem_biUnion.mp h
      exact hR l k κ hl
  choose E iCR iAlg hEt β γ hγ hβγ using fun k => hs3 (T k) (hind k) {x k} (N k) (hN k)
  refine ⟨E, iCR, iAlg, hEt, β, fun k => γ k (MvPolynomial.X (x k)),
    fun k => hβγ k (x k) (Finset.mem_singleton_self _), ?_⟩
  intro k l
  let Γ := Algebra.TensorProduct.map (γ k) (γ l)
  refine ⟨Γ (st k l), ?_, ?_⟩
  · have hker : Ideal.map (Algebra.TensorProduct.includeLeft :
          MvPolynomial (T k) A →ₐ[A] TensorProduct A (MvPolynomial (T k) A) (MvPolynomial (T l) A))
          (Ideal.span (L k l : Set (MvPolynomial (T k) A))) ⊔
        Ideal.map (Algebra.TensorProduct.includeRight :
          MvPolynomial (T l) A →ₐ[A] TensorProduct A (MvPolynomial (T k) A) (MvPolynomial (T l) A))
          (Ideal.span (R k l : Set (MvPolynomial (T l) A))) ≤ RingHom.ker Γ := by
      apply sup_le
      · rw [Ideal.map_le_iff_le_comap]
        apply Ideal.span_le.mpr
        intro κ hκ
        have hκN : κ ∈ N k :=
          Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨l, Finset.mem_univ _, hκ⟩)
        simp only [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker,
          Algebra.TensorProduct.includeLeft_apply]
        simp [Γ, hγ k κ hκN]
      · rw [Ideal.map_le_iff_le_comap]
        apply Ideal.span_le.mpr
        intro κ hκ
        have hκN : κ ∈ N l :=
          Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨k, Finset.mem_univ _, hκ⟩)
        simp only [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker,
          Algebra.TensorProduct.includeRight_apply]
        simp [Γ, hγ l κ hκN]
    have hΓD : Γ (TensorProduct.tmul A (MvPolynomial.X (x k)) 1 -
        TensorProduct.tmul A 1 (MvPolynomial.X (x l))) =
        TensorProduct.tmul A (γ k (MvPolynomial.X (x k))) 1 -
          TensorProduct.tmul A 1 (γ l (MvPolynomial.X (x l))) := by
      simp [Γ]
    have := hker (h2 k l)
    rw [RingHom.mem_ker, map_mul, hΓD] at this
    exact this
  · have := Ideal.mem_map_of_mem (Γ : TensorProduct A (MvPolynomial (T k) A) (MvPolynomial (T l) A)
      →+* TensorProduct A (E k) (E l)) (h1 k l)
    rw [Ideal.map_map] at this
    have e : (Γ : TensorProduct A (MvPolynomial (T k) A) (MvPolynomial (T l) A)
        →+* TensorProduct A (E k) (E l)).comp
        (algebraMap A (TensorProduct A (MvPolynomial (T k) A) (MvPolynomial (T l) A))) =
        algebraMap A (TensorProduct A (E k) (E l)) := Γ.comp_algebraMap
    rw [e] at this
    have e2 : (Γ : TensorProduct A (MvPolynomial (T k) A) (MvPolynomial (T l) A)
        →+* TensorProduct A (E k) (E l)) (1 - st k l) = 1 - Γ (st k l) := by
      rw [map_sub, map_one]; rfl
    rw [e2] at this
    exact this

theorem wc_hp_trace_connected_of_domain_idem (A : Type u) [CommRing A] (I : Ideal A)
    (hI : I ≤ (⊥ : Ideal A).jacobson)
    (hidem : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D] [Module.Finite A D]
      (e : D ⧸ I.map (algebraMap A D)), IsIdempotentElem e → e = 0 ∨ e = 1)
    (Y : Scheme.{u}) (p : Y ⟶ Spec (.of A)) [IsFinite p] (y : Y) :
    IsConnected (closure {y} ∩
      p ⁻¹' Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) :=
by
  classical

  have s2 : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D] [Module.Finite A D],
      ConnectedSpace (PrimeSpectrum (D ⧸ I.map (algebraMap A D))) := by
    intro D _ _ _ _
    have hne : I.map (algebraMap A D) ≠ ⊤ := by
      intro htop
      have h1 : (⊤ : Submodule A D) ≤ I • ⊤ := by
        rw [Ideal.smul_top_eq_map, htop, Submodule.restrictScalars_top]
      have h2 := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot I ⊤ Module.Finite.fg_top h1 hI
      have h3 : (1 : D) ∈ (⊤ : Submodule A D) := Submodule.mem_top
      rw [h2, Submodule.mem_bot] at h3
      exact one_ne_zero h3
    have : Nontrivial (D ⧸ I.map (algebraMap A D)) := Ideal.Quotient.nontrivial_iff.mpr hne
    rw [connectedSpace_iff_clopen]
    refine ⟨inferInstance, fun s hs => ?_⟩
    obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff_zeroLocus.mp hs
    rcases hidem D e he with rfl | rfl
    · right; exact PrimeSpectrum.zeroLocus_singleton_zero
    · left; exact PrimeSpectrum.zeroLocus_singleton_one

  have s3 : ∀ (B : Type u) [CommRing B] [Algebra A B] (x : PrimeSpectrum B),
      closure {x} ∩ PrimeSpectrum.comap (algebraMap A B) ⁻¹'
          Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) =
        Set.range (PrimeSpectrum.comap
          ((Ideal.Quotient.mk (I.map (algebraMap A (B ⧸ x.asIdeal)))).comp
            (Ideal.Quotient.mk x.asIdeal))) := by
    intro B _ _ x
    have hψ : Function.Surjective ((Ideal.Quotient.mk (I.map (algebraMap A (B ⧸ x.asIdeal)))).comp
        (Ideal.Quotient.mk x.asIdeal)) := by
      rw [RingHom.coe_comp]
      exact Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
    have e1 : algebraMap A (B ⧸ x.asIdeal) =
        (Ideal.Quotient.mk x.asIdeal).comp (algebraMap A B) := rfl
    have hker : RingHom.ker ((Ideal.Quotient.mk (I.map (algebraMap A (B ⧸ x.asIdeal)))).comp
        (Ideal.Quotient.mk x.asIdeal)) = I.map (algebraMap A B) ⊔ x.asIdeal := by
      rw [← RingHom.comap_ker, Ideal.mk_ker, e1, ← Ideal.map_map,
        Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    rw [range_comap_of_surjective _ _ hψ, hker,
      range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    ext z
    simp only [Set.mem_inter_iff, PrimeSpectrum.closure_singleton, Set.mem_preimage,
      PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, PrimeSpectrum.comap_asIdeal,
      sup_le_iff, ← Ideal.map_le_iff_le_comap]
    tauto

  haveI : IsAffine Y := isAffine_of_isAffineHom p
  let φ : CommRingCat.of A ⟶ Γ(Y, ⊤) := Spec.preimage (Y.isoSpec.inv ≫ p)
  have hφ : Spec.map φ = Y.isoSpec.inv ≫ p := Spec.map_preimage _
  letI : Algebra A Γ(Y, ⊤) := φ.hom.toAlgebra
  have hfinφ : φ.hom.Finite := by
    rw [← IsFinite.SpecMap_iff, hφ]; infer_instance
  haveI hfin : Module.Finite A Γ(Y, ⊤) := hfinφ
  let h : Y ≃ₜ PrimeSpectrum Γ(Y, ⊤) := Scheme.homeoOfIso Y.isoSpec
  have hp : ∀ z : Y, p z = PrimeSpectrum.comap (algebraMap A Γ(Y, ⊤)) (h z) := by
    intro z
    have e2 : p z = (Y.isoSpec.inv ≫ p) (Y.isoSpec.hom z) := by
      rw [Scheme.Hom.comp_apply, Scheme.hom_inv_apply]
    rw [e2, ← hφ]
    rfl
  have hZ : ∀ w : Spec (.of A), w ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
      ↔ (w : PrimeSpectrum A) ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
    intro w
    rfl

  have hS : closure {y} ∩ p ⁻¹' Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) =
      h ⁻¹' (closure {h y} ∩ PrimeSpectrum.comap (algebraMap A Γ(Y, ⊤)) ⁻¹'
          Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I))) := by
    ext z
    simp only [Set.mem_inter_iff, Set.mem_preimage]
    rw [← specializes_iff_mem_closure, ← specializes_iff_mem_closure,
      h.isInducing.specializes_iff, hZ, hp z]
    exact Iff.rfl
  rw [hS, h.isConnected_preimage, s3]
  haveI := s2 (Γ(Y, ⊤) ⧸ (h y).asIdeal)
  exact isConnected_range (PrimeSpectrum.continuous_comap _)

theorem wc_hp_finite_trace_connected (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (Y : Scheme.{u}) (p : Y ⟶ Spec (.of A)) [IsFinite p] (y : Y) :
    IsConnected (closure {y} ∩
      p ⁻¹' Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) :=
by
  have hJ : I ≤ (⊥ : Ideal A).jacobson := HenselianRing.jac
  have hR1 : ∀ (B : Type u) [CommRing B] [Algebra A B] [Module.Finite A B] (b : B),
      b * b - b ∈ I.map (algebraMap A B) →
      (∀ x : B, ∃ a : A, b * x - algebraMap A B a * b ∈ I.map (algebraMap A B)) →
      ∃ e : B, IsIdempotentElem e ∧ e - b ∈ I.map (algebraMap A B) := by
    intro B _ _ _ b hb hrk
    exact wc_hp_rank_one_idempotent_lift A I B b hb hrk
  have hsec : ∀ (R : Type u) [CommRing R] [Algebra A R] [Module.Finite A R] (J : R)
      [Algebra.Etale A (Localization.Away J)] (σ₀ : Localization.Away J →ₐ[A] A ⧸ I),
      ∃ σ : Localization.Away J →ₐ[A] A, (Ideal.Quotient.mkₐ A I).comp σ = σ₀ := by
    intro R _ _ _ J _ σ₀
    exact wc_hp_finite_away_section_lift A I hJ hR1 R J σ₀
  have hfl : ∀ (P : Polynomial A) (g₀ h₀ : Polynomial (A ⧸ I)), P.Monic → g₀.Monic →
      h₀.Monic → P.map (Ideal.Quotient.mk I) = g₀ * h₀ → IsCoprime g₀ h₀ →
      ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ P = g * h ∧
        g.map (Ideal.Quotient.mk I) = g₀ ∧ h.map (Ideal.Quotient.mk I) = h₀ := by
    intro P g₀ h₀ hP hg hh hfac hcop
    exact wc_hp_lift_coprime_factorization_of_section A I hsec P hP g₀ h₀ hg hh hfac hcop
  have hidem : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D] [Module.Finite A D]
      (e : D ⧸ I.map (algebraMap A D)), IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro D _ _ _ _ e he
    exact wc_hp_finite_domain_idempotent_of_factor A D I hfl e he
  exact wc_hp_trace_connected_of_domain_idem A I hJ hidem Y p y

theorem wc_rd_supp_of_ann (A : Type u) [CommRing A] (I : Ideal A)
    (hO : Presheaf.IsSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
      ((Scheme.Etale.forget (Spec (.of A)) ⋙ Over.forget (Spec (.of A))).op ⋙ Scheme.Γ ⋙
        forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}))
    (E E' : Type u) [CommRing E] [CommRing E'] [Algebra A E] [Algebra A E']
    (x : E) (x' : E') (s : TensorProduct A E E')
    (hs : s * (TensorProduct.tmul A x 1 - TensorProduct.tmul A 1 x') = 0)
    (h1 : 1 - s ∈ I.map (algebraMap A (TensorProduct A E E')))
    (V : (Spec (.of A)).Etale) (α : V.left ⟶ Spec (.of E)) (β : V.left ⟶ Spec (.of E'))
    (hα : α ≫ Spec.map (CommRingCat.ofHom (algebraMap A E)) = V.hom)
    (hβ : β ≫ Spec.map (CommRingCat.ofHom (algebraMap A E')) = V.hom) :
    wcSuppSec (Spec (.of A)) (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))ᶜ
      (⟨_, hO⟩ : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) V
      (ULift.up ((Scheme.Hom.appTop α).hom ((Scheme.ΓSpecIso (.of E)).inv.hom x) -
        (Scheme.Hom.appTop β).hom ((Scheme.ΓSpecIso (.of E')).inv.hom x'))) :=
by
  classical

  have hL2 : ∀ (T : Scheme.{u}) (σ t : Γ(T, ⊤)), σ * t = 0 →
      (Scheme.Hom.appTop (T.basicOpen σ).ι).hom t = 0 := by
    intro T σ t h
    refine TopCat.Presheaf.section_ext ((T.basicOpen σ : Scheme).sheaf) ⊤ _ 0 (fun y hy => ?_)
    change ((T.basicOpen σ : Scheme).presheaf.germ ⊤ y hy).hom
      ((Scheme.Hom.appTop (T.basicOpen σ).ι).hom t) =
      ((T.basicOpen σ : Scheme).presheaf.germ ⊤ y hy).hom 0
    rw [map_zero]
    have e1 := Scheme.Hom.germ_stalkMap_apply (T.basicOpen σ).ι ⊤ y trivial t
    have hyU : (T.basicOpen σ).ι y ∈ T.basicOpen σ :=
      (Scheme.Opens.range_ι (T.basicOpen σ)).le ⟨y, rfl⟩
    have e2 : (T.presheaf.germ ⊤ ((T.basicOpen σ).ι y) trivial).hom t = 0 :=
      germ_eq_zero_of_pow_mul_eq_zero (X := T) (U := ⊤) (f := t) (s := σ)
        ⟨(T.basicOpen σ).ι y, show _ ∈ (⊤ : T.Opens) from trivial⟩
        hyU (n := 1) (by rw [pow_one]; exact h)
    rw [e2, map_zero] at e1
    exact e1.symm

  have hL1 : ∀ (T : Scheme.{u}) (h : T ⟶ Spec (.of A)) (z : Γ(T, ⊤)),
      z ∈ I.map ((Scheme.Hom.appTop h).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) →
      ∀ (v : T), v ∈ T.basicOpen z →
      h v ∈ (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))ᶜ := by
    intro T h z hz v hv
    rintro ⟨q, hq⟩
    have hI : ∀ a ∈ I, a ∈ (h v).asIdeal := by
      intro a ha
      rw [← hq, Spec.map_apply]
      show Ideal.Quotient.mk I a ∈ q.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact zero_mem _
    let J : Ideal Γ(T, ⊤) := Ideal.comap (T.presheaf.germ ⊤ v trivial).hom
      (IsLocalRing.maximalIdeal (T.presheaf.stalk v))
    have hJ : ∀ w, w ∈ J ↔ v ∉ T.basicOpen w := by
      intro w
      rw [Scheme.mem_basicOpen_top]
      show (T.presheaf.germ ⊤ v trivial).hom w ∈ IsLocalRing.maximalIdeal _ ↔ _
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    have hle : I.map ((Scheme.Hom.appTop h).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) ≤ J := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      show _ ∈ J
      rw [hJ]
      intro hva
      have h3 : v ∈ h ⁻¹ᵁ (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
        rw [Scheme.Hom.preimage_basicOpen_top]
        exact hva
      have h4 : h v ∈ (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv.hom a) := h3
      rw [basicOpen_eq_of_affine] at h4
      exact h4 (hI a ha)
    exact (hJ _).mp (hle hz) hv

  have hL4 : ∀ (V : (Spec (.of A)).Etale) (t : Γ(V.left, ⊤)) (U₁ U₂ : V.left.Opens),
      (∀ v : V.left, v ∈ U₁ ∨ v ∈ U₂) → (Scheme.Hom.appTop U₁.ι).hom t = 0 →
      (∀ v : V.left, v ∈ U₂ →
        V.hom v ∈ (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))ᶜ) →
      wcSuppSec (Spec (.of A)) (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))ᶜ
        (⟨_, hO⟩ : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) V
        (ULift.up t) := by
    intro V t U₁ U₂ hcov hvan hW
    haveI : Etale V.hom := V.prop
    unfold wcSuppSec
    change _ ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of A)) V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
      (Spec (.of A)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale (Spec (.of A))
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    rcases hcov v with hv | hv
    · refine ⟨Scheme.Etale.mk (U₁.ι ≫ V.hom),
        MorphismProperty.Over.homMk U₁.ι rfl trivial, ⟨v, hv⟩,
        ⟨_, 𝟙 _, MorphismProperty.Over.homMk U₁.ι rfl trivial, Or.inl ?_, Category.id_comp _⟩,
        (inferInstance : Etale U₁.ι), Scheme.Opens.ι_apply _ ⟨v, hv⟩⟩
      show ULift.up ((Scheme.Hom.appTop U₁.ι).hom t) = 0
      rw [hvan]
      rfl
    · refine ⟨Scheme.Etale.mk (U₂.ι ≫ V.hom),
        MorphismProperty.Over.homMk U₂.ι rfl trivial, ⟨v, hv⟩,
        ⟨_, 𝟙 _, MorphismProperty.Over.homMk U₂.ι rfl trivial, Or.inr ?_, Category.id_comp _⟩,
        (inferInstance : Etale U₂.ι), Scheme.Opens.ι_apply _ ⟨v, hv⟩⟩
      intro z
      show V.hom (U₂.ι z) ∈ _
      exact hW _ ((Scheme.Opens.range_ι U₂).le ⟨z, rfl⟩)
  haveI : Etale V.hom := V.prop

  let g : A →+* Γ(V.left, ⊤) :=
    (Scheme.Hom.appTop V.hom).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
  letI : Algebra A Γ(V.left, ⊤) := g.toAlgebra
  have key : ∀ (B : Type u) [CommRing B] [Algebra A B] (γ : V.left ⟶ Spec (.of B))
      (_ : γ ≫ Spec.map (CommRingCat.ofHom (algebraMap A B)) = V.hom) (a : A),
      (Scheme.Hom.appTop γ).hom ((Scheme.ΓSpecIso (.of B)).inv.hom (algebraMap A B a)) = g a := by
    intro B _ _ γ hγ a
    have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ a)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap A B)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    rw [h2]
    show (Scheme.Hom.appTop γ).hom ((Scheme.Hom.appTop (Spec.map
      (CommRingCat.ofHom (algebraMap A B)))).hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
      (Scheme.Hom.appTop V.hom).hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)
    rw [← hγ, Scheme.Hom.comp_appTop]
    rfl
  let fα : E →ₐ[A] Γ(V.left, ⊤) :=
    { toRingHom := (Scheme.Hom.appTop α).hom.comp (Scheme.ΓSpecIso (.of E)).inv.hom
      commutes' := fun a => key E α hα a }
  let fβ : E' →ₐ[A] Γ(V.left, ⊤) :=
    { toRingHom := (Scheme.Hom.appTop β).hom.comp (Scheme.ΓSpecIso (.of E')).inv.hom
      commutes' := fun a => key E' β hβ a }
  let μ := Algebra.TensorProduct.lift fα fβ (fun _ _ => Commute.all _ _)
  have ht : (Scheme.Hom.appTop α).hom ((Scheme.ΓSpecIso (.of E)).inv.hom x) -
      (Scheme.Hom.appTop β).hom ((Scheme.ΓSpecIso (.of E')).inv.hom x') =
      μ (TensorProduct.tmul A x 1 - TensorProduct.tmul A 1 x') := by
    rw [map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul, map_one,
      map_one, mul_one, one_mul]
    rfl
  have hσt : μ s * ((Scheme.Hom.appTop α).hom ((Scheme.ΓSpecIso (.of E)).inv.hom x) -
      (Scheme.Hom.appTop β).hom ((Scheme.ΓSpecIso (.of E')).inv.hom x')) = 0 := by
    rw [ht, ← map_mul, hs, map_zero]
  have hσ1 : 1 - μ s ∈ I.map g := by
    have h3 := Ideal.mem_map_of_mem μ.toRingHom h1
    have e : μ.toRingHom.comp (algebraMap A (TensorProduct A E E')) =
        algebraMap A Γ(V.left, ⊤) := μ.comp_algebraMap
    rw [Ideal.map_map, e, map_sub, map_one] at h3
    exact h3

  have hcov : ∀ v : V.left, v ∈ V.left.basicOpen (μ s) ∨ v ∈ V.left.basicOpen (1 - μ s) := by
    intro v
    rw [Scheme.mem_basicOpen_top, Scheme.mem_basicOpen_top, map_sub, map_one]
    exact IsLocalRing.isUnit_or_isUnit_one_sub_self _

  have hvan := hL2 V.left (μ s) _ hσt

  exact hL4 V _ _ _ hcov hvan (fun v hv => hL1 V.left V.hom (1 - μ s) hσ1 v hv)

theorem wc_rd_ann_of_supp (A : Type u) [CommRing A] (I : Ideal A)
    (hO : Presheaf.IsSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
      ((Scheme.Etale.forget (Spec (.of A)) ⋙ Over.forget (Spec (.of A))).op ⋙ Scheme.Γ ⋙
        forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}))
    (E : Type u) [CommRing E] [Algebra A E] (hE : Algebra.Etale A E) (w : E)
    (hw : wcSuppSec (Spec (.of A)) (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))ᶜ
      (⟨_, hO⟩ : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})
      (@Scheme.Etale.mk _ _ (Spec.map (CommRingCat.ofHom (algebraMap A E)))
        ((HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr hE)))
      (ULift.up ((Scheme.ΓSpecIso (.of E)).inv.hom w))) :
    ∃ s : E, s * w = 0 ∧ 1 - s ∈ I.map (algebraMap A E) :=
by
  classical

  suffices key : ∀ M : Ideal E, M.IsMaximal → I.map (algebraMap A E) ≤ M →
      ∃ t, t ∉ M ∧ t * w = 0 by
    by_cases htop : LinearMap.ker (LinearMap.mulRight E w) ⊔ I.map (algebraMap A E) = ⊤
    · have h1 : (1 : E) ∈ LinearMap.ker (LinearMap.mulRight E w) ⊔ I.map (algebraMap A E) := by
        rw [htop]; exact Submodule.mem_top
      obtain ⟨s, hs, j, hj, hsj⟩ := Submodule.mem_sup.mp h1
      refine ⟨s, ?_, ?_⟩
      · simpa [LinearMap.mem_ker] using hs
      · have : 1 - s = j := by rw [← hsj]; ring
        rw [this]; exact hj
    · obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ htop
      obtain ⟨t, ht, htr⟩ := key M hM (le_trans le_sup_right hle)
      exact absurd (hle (Submodule.mem_sup_left (by simpa [LinearMap.mem_ker] using htr))) ht
  intro M hM hJM
  let P : PrimeSpectrum E := ⟨M, hM.isPrime⟩

  have hIp : I ≤ M.comap (algebraMap A E) := Ideal.map_le_iff_le_comap.mp hJM
  haveI hpp : (M.comap (algebraMap A E)).IsPrime := Ideal.comap_isPrime _ _
  let q : Spec (.of (A ⧸ I)) := ⟨(M.comap (algebraMap A E)).map (Ideal.Quotient.mk I),
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIp)⟩
  have hq : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) q =
      (⟨M.comap (algebraMap A E), hpp⟩ : PrimeSpectrum A) := by
    apply PrimeSpectrum.ext
    show Ideal.comap (Ideal.Quotient.mk I) ((M.comap (algebraMap A E)).map (Ideal.Quotient.mk I)) = _
    exact Ideal.comap_map_mk hIp

  have hR := hw
  unfold wcSuppSec at hR
  change _ ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of A)) _ at hR
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
    (Spec (.of A)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
  obtain ⟨Y₀, g, y, hg, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale
    (Spec (.of A)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR P
  obtain ⟨Y', k, g', hg', hcomp⟩ := hg
  have hy' : g'.left (k.left y) = P := by
    rw [← hy, ← hcomp]
    rfl
  rcases hg' with h0 | hW
  swap
  · exfalso
    have h1 := hW (k.left y)
    have h2 : Y'.hom (k.left y) = Spec.map (CommRingCat.ofHom (algebraMap A E)) P := by
      rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hy']
      rfl
    rw [h2] at h1
    apply h1
    exact ⟨q, hq.trans rfl⟩

  have hz : (Scheme.Hom.appTop g'.left).hom ((Scheme.ΓSpecIso (.of E)).inv.hom w) = 0 := by
    have := congrArg ULift.down h0
    exact this
  have hEtHom : ∀ {P Q : (Spec (.of A)).Etale} (c : P ⟶ Q), Etale c.left := by
    intro P Q c
    have hw : c.left ≫ Q.hom = P.hom := MorphismProperty.Over.w c
    have h1 : Etale Q.hom := Q.prop
    have h2 : Etale (c.left ≫ Q.hom) := by rw [hw]; exact P.prop
    exact Etale.of_comp c.left Q.hom
  have hg'E : Etale g'.left := hEtHom g'
  haveI : Flat g'.left := inferInstance

  have key2 : ∀ pt : Spec (.of E), g'.left (k.left y) = pt →
      ((Spec (.of E)).presheaf.germ ⊤ pt trivial).hom ((Scheme.ΓSpecIso (.of E)).inv.hom w) = 0 := by
    rintro pt rfl
    have injT : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [Flat f] (x : X),
        Function.Injective (Scheme.Hom.stalkMap f x).hom := by
      intro X Y f _ x
      letI := (Scheme.Hom.stalkMap f x).hom.toAlgebra
      haveI : Module.Flat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := Flat.stalkMap f x
      haveI : IsLocalHom (algebraMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
        inferInstanceAs (IsLocalHom (Scheme.Hom.stalkMap f x).hom)
      haveI : Module.FaithfullyFlat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      exact FaithfulSMul.algebraMap_injective (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)
    have germT : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [Flat f] (s : Γ(Y, ⊤)),
        (Scheme.Hom.appTop f).hom s = 0 → ∀ x : X, (Y.presheaf.germ ⊤ (f x) trivial).hom s = 0 := by
      intro X Y f _ s hs x
      apply injT f x
      have e1 := Scheme.Hom.germ_stalkMap_apply f ⊤ x (show f x ∈ (⊤ : Y.Opens) from trivial) s
      have e2 : (X.presheaf.germ (f ⁻¹ᵁ ⊤) x (show f x ∈ (⊤ : Y.Opens) from trivial)).hom
          ((Scheme.Hom.app f ⊤).hom s) = 0 := by
        have h' : (Scheme.Hom.app f ⊤).hom s = 0 := hs
        rw [h', map_zero]
      exact (e1.trans e2).trans (map_zero _).symm
    exact germT g'.left _ hz (k.left y)
  have hg0 := key2 P hy'
  have hloc : algebraMap E ((Spec.structureSheaf E).presheaf.stalk P) w = 0 := hg0
  haveI hIL := StructureSheaf.IsLocalization.to_stalk E P
  obtain ⟨⟨m, hm⟩, hmw⟩ := (IsLocalization.map_eq_zero_iff P.asIdeal.primeCompl
    ((Spec.structureSheaf E).presheaf.stalk P) w).mp hloc
  exact ⟨m, hm, hmw⟩

theorem wc_rd_etale_gabber_glue (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (n : ℕ) (E : Fin n → Type u) [∀ k, CommRing (E k)] [∀ k, Algebra A (E k)]
    (hE : ∀ k, Algebra.Etale A (E k)) (e : ∀ k, E k)
    (hcov : ∀ p : PrimeSpectrum A, ∃ k, ∃ P : PrimeSpectrum (E k),
      PrimeSpectrum.comap (algebraMap A (E k)) P = p)
    (hcomp : ∀ k l, ∃ s : TensorProduct A (E k) (E l),
      s * (TensorProduct.tmul A (e k) 1 - TensorProduct.tmul A 1 (e l)) = 0 ∧
      1 - s ∈ I.map (algebraMap A (TensorProduct A (E k) (E l)))) :
    ∃ y : A, ∀ k, ∃ s : E k, s * (algebraMap A (E k) y - e k) = 0 ∧
      1 - s ∈ I.map (algebraMap A (E k)) :=
by
  classical

  have hO : Presheaf.IsSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
      ((Scheme.Etale.forget (Spec (.of A)) ⋙ Over.forget (Spec (.of A))).op ⋙ Scheme.Γ ⋙
        forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) := by
    have s2a : Scheme.etaleTopology.{u} ≤ Scheme.fpqcTopology.{u} := by
      apply Precoverage.toGrothendieck_mono
      apply le_inf
      · apply Scheme.precoverage_le_qcPrecoverage_of_isOpenMap
        intro X Y f hf
        have := hf
        exact f.isOpenMap
      · apply Scheme.precoverage_mono
        intro X Y f hf
        have := hf
        infer_instance
    have s2b : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) := by
      let A1 : Scheme.{u} := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ)))
      let e : yoneda.obj A1 ≅ Scheme.Γ ⋙ forget CommRingCat.{u} :=
        NatIso.ofComponents (fun T => Equiv.toIso
          ((AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := T.unop)).trans
            (Equiv.funUnique PUnit.{u+1} _))) (by
          intro T T' g
          ext h
          exact AffineSpace.toSpecMvPolyIntEquiv_comp PUnit.{u+1} g.unop h PUnit.unit)
      exact Presieve.isSheaf_iso Scheme.fpqcTopology e
        (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (yoneda.obj A1))
    have s3 : ∀ (F : Scheme.{u}ᵒᵖ ⥤ Type u), Presieve.IsSheaf Scheme.etaleTopology F →
        Presieve.IsSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
          ((Scheme.Etale.forget (Spec (.of A)) ⋙ Over.forget (Spec (.of A))).op ⋙ F) := by
      intro F hF U S hS x hx
      have hSurj : ∀ y : U.left, ∃ (Y : (Spec (.of A)).Etale) (g : Y ⟶ U) (w : Y.left),
          S.arrows g ∧ g.left w = y := by
        change S ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of A)) U at hS
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
          (Spec (.of A)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
          le_rfl] at hS
        intro y
        obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale
          (Spec (.of A)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U
          S).mp hS y
        exact ⟨Y, g, w, hg, hw⟩
      let ι := Σ (Y : (Spec (.of A)).Etale), {f : Y ⟶ U // S.arrows f}
      have hR : Presieve.ofArrows (fun i : ι => i.1.left) (fun i => i.2.1.left) ∈
          (Scheme.precoverage @Etale).coverings U.left := by
        refine (Scheme.ofArrows_mem_precoverage_iff @Etale).mpr ⟨fun y => ?_, fun i => inferInstance⟩
        obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
        exact ⟨⟨Y, g, hg⟩, w, hw⟩
      have hgen : Sieve.generate (Presieve.ofArrows (fun i : ι => i.1.left) (fun i => i.2.1.left)) ∈
          Scheme.etaleTopology U.left := Precoverage.generate_mem_toGrothendieck hR
      have hsf := (Presieve.isSheafFor_arrows_iff F (fun i : ι => i.2.1.left)).mp
        ((Presieve.isSheafFor_iff_generate _).mpr (hF _ hgen))
      let z : ∀ i : ι, F.obj (Opposite.op i.1.left) := fun i => x i.2.1 i.2.2
      have hz : Presieve.Arrows.Compatible F (fun i : ι => i.2.1.left) z := by
        rintro ⟨Y₁, f₁, h₁⟩ ⟨Y₂, f₂, h₂⟩ Z gi gj e
        haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom) := by
          haveI : Etale Y₁.hom := Y₁.prop
          infer_instance
        let P : (Spec (.of A)).Etale :=
          MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom) hEt
        have hw : Limits.pullback.snd f₁.left f₂.left ≫ Y₂.hom =
            Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom := by
          rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let p₁ : P ⟶ Y₁ :=
          MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
        let p₂ : P ⟶ Y₂ :=
          MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
        have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
          apply MorphismProperty.Over.Hom.ext
          change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
            Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
          exact Limits.pullback.condition
        have hc : F.map (Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩) =
            F.map (Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩) :=
          hx p₁ p₂ h₁ h₂ hcomm
        let l := Limits.pullback.lift gi gj e
        change F.map gi.op (z ⟨Y₁, f₁, h₁⟩) = F.map gj.op (z ⟨Y₂, f₂, h₂⟩)
        calc F.map gi.op (z ⟨Y₁, f₁, h₁⟩)
            = F.map (l ≫ Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩) := by
              rw [Limits.pullback.lift_fst]
          _ = F.map l.op (F.map (Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩)) := by
              rw [op_comp, FunctorToTypes.map_comp_apply]
          _ = F.map l.op (F.map (Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩)) := by
              rw [hc]
          _ = F.map (l ≫ Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩) := by
              rw [op_comp, FunctorToTypes.map_comp_apply]
          _ = F.map gj.op (z ⟨Y₂, f₂, h₂⟩) := by
              rw [Limits.pullback.lift_snd]
      obtain ⟨t, ht, huniq⟩ := hsf z hz
      exact ⟨t, fun Y f hf => ht ⟨Y, f, hf⟩, fun y hy => huniq y (fun i => hy i.2.1 i.2.2)⟩
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology (Spec (.of A))) _
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    exact Presieve.isSheaf_comp_uliftFunctor _
      (s3 (Scheme.Γ ⋙ forget CommRingCat.{u}) (Presieve.isSheaf_of_le _ s2a s2b))
  let O : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} := ⟨_, hO⟩

  have hJ : I ≤ (⊥ : Ideal A).jacobson := HenselianRing.jac
  haveI hqci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hZc : IsClosed (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) :=
    (Scheme.Hom.isClosedEmbedding (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).isClosed_range
  have hspec : ∀ x : Spec (.of A),
      ∃ z ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))), x ⤳ z := by
    intro x
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal x.asIdeal x.isPrime.ne_top
    have hIM : I ≤ M := hJ.trans (sInf_le ⟨bot_le, hM⟩)
    let z : Spec (.of (A ⧸ I)) := ⟨M.map (Ideal.Quotient.mk I),
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIM)⟩
    refine ⟨Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) z, ⟨z, rfl⟩, ?_⟩
    have hz : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) z =
        (⟨M, hM.isPrime⟩ : PrimeSpectrum A) := by
      apply PrimeSpectrum.ext
      show Ideal.comap (Ideal.Quotient.mk I) (M.map (Ideal.Quotient.mk I)) = M
      exact Ideal.comap_map_mk hIM
    rw [hz]
    exact (PrimeSpectrum.le_iff_specializes x ⟨M, hM.isPrime⟩).mp hle
  set Z : Set (Spec (.of A)) := Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    with hZdef
  have hWo : IsOpen Zᶜ := hZc.isOpen_compl
  have hsec : ∀ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)), IsClosedMap h →
      ∀ (S : Set Y), (∀ y ∈ S, h y ∉ Z) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (b : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))),
        wcSuppSec Y S F (Scheme.Etale.mk (𝟙 Y)) b → b = 0 := by
    intro Y h hh S hS F b hb
    have hEtHom : ∀ {P Q : Y.Etale} (c : P ⟶ Q), Etale c.left := by
      intro P Q c
      have hw : c.left ≫ Q.hom = P.hom := MorphismProperty.Over.w c
      have h1 : Etale Q.hom := Q.prop
      have h2 : Etale (c.left ≫ Q.hom) := by rw [hw]; exact P.prop
      exact Etale.of_comp c.left Q.hom
    let T : Y.Etale := Scheme.Etale.mk (𝟙 Y)
    let E : Set T.left := {v | ∃ (V₁ : Y.Etale) (c : V₁ ⟶ T), v ∈ Set.range c.left ∧
      F.obj.map c.op b = 0}
    have hEopen : IsOpen E := by
      rw [isOpen_iff_forall_mem_open]
      rintro v ⟨V₁, c, hv, hc⟩
      haveI := hEtHom c
      exact ⟨Set.range c.left, fun w hw => ⟨V₁, c, hw, hc⟩, c.left.isOpenMap.isOpen_range, hv⟩
    have hvan : ∀ (V₁ : Y.Etale) (c : V₁ ⟶ T), Set.range c.left ⊆ E →
        F.obj.map c.op b = 0 := by
      intro V₁ c hsub
      let S' : Sieve V₁ :=
        { arrows := fun D d => F.obj.map d.op (F.obj.map c.op b) = 0
          downward_closed := by
            intro D D' d hd e
            change F.obj.map (e ≫ d).op (F.obj.map c.op b) = 0
            rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
            rw [hd, map_zero] }
      have hS' : S' ∈ Scheme.smallEtaleTopology Y V₁ := by
        change S' ∈ Scheme.smallGrothendieckTopology @Etale Y V₁
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro q
        obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨q, rfl⟩
        haveI : Etale c₂.left := hEtHom c₂
        haveI : Etale V₁.hom := V₁.prop
        let fst := Limits.pullback.fst c.left c₂.left
        let snd := Limits.pullback.snd c.left c₂.left
        haveI hfst : Etale fst := inferInstance
        let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
        have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
          rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
        let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
        have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
          apply MorphismProperty.Over.Hom.ext
          exact Limits.pullback.condition
        obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback q q₀ hq₀.symm
        have hπ₁ : S'.arrows π₁ := by
          change F.obj.map π₁.op (F.obj.map c.op b) = 0
          rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
            Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
        exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
      have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj F).2
      exact (hsh S' hS').isSeparatedFor.ext (fun D d hd => by
        change F.obj.map d.op (F.obj.map c.op b) = F.obj.map d.op 0
        rw [map_zero]
        exact hd)
    have hfib : ∀ z : Y, h z ∈ Z → z ∈ E := by
      intro z hz
      have hR := hb
      unfold wcSuppSec at hR
      change _ ∈ Scheme.smallGrothendieckTopology @Etale Y T at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨Y₀, g, y, hg, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
      obtain ⟨Y', k, g', hg', hcomp⟩ := hg
      have hy' : g'.left (k.left y) = z := by
        rw [← hy, ← hcomp]
        rfl
      rcases hg' with h0 | hW
      · exact ⟨Y', g', ⟨k.left y, hy'⟩, h0⟩
      · exfalso
        have h1 := hS _ (hW (k.left y))
        have h2 : Y'.hom (k.left y) = z := by
          rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hy']
          rfl
        rw [h2] at h1
        exact h1 hz
    have hEuniv : ∀ v, v ∈ E := by
      intro x
      by_contra hx
      have hZ' : IsClosed Eᶜ := hEopen.isClosed_compl
      have hfZ := hh _ hZ'
      obtain ⟨z', hz'Z, hspz⟩ := hspec (h x)
      have hmem : z' ∈ h '' Eᶜ := hspz.mem_closed hfZ ⟨x, hx, rfl⟩
      obtain ⟨z, hzE, hz⟩ := hmem
      exact hzE (hfib z (by rw [hz]; exact hz'Z))
    have h0 := hvan T (𝟙 T) (fun v _ => hEuniv v)
    rw [op_id, F.obj.map_id] at h0
    exact h0
  have hEG : wcEtGlueMod (Spec (.of A)) Zᶜ O := by
    refine wc_et_gluing_of_zariski_finite A (Spec (.of A)) (𝟙 _) Zᶜ hWo ?_ ?_ O
    · intro Y q _ G'
      exact wc_zariski_spectral_trace_gluing A Y q (q ⁻¹' Z) (hZc.preimage q.continuous)
        (wc_hp_finite_trace_connected A I Y q) G'
    · intro Y q _ G' b hb
      exact hsec Y q (Scheme.Hom.isClosedMap q) (q ⁻¹' Zᶜ) (fun y hy => hy) G' b hb

  have hEt : ∀ k, Etale (Spec.map (CommRingCat.ofHom (algebraMap A (E k)))) := fun k =>
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr (hE k))
  let V : Fin n → (Spec (.of A)).Etale := fun k =>
    @Scheme.Etale.mk _ _ (Spec.map (CommRingCat.ofHom (algebraMap A (E k)))) (hEt k)
  let ι : ∀ k, V k ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))) := fun k =>
    MorphismProperty.Over.homMk (V k).hom (Category.comp_id _) trivial
  let R : Sieve (Scheme.Etale.mk (𝟙 (Spec (.of A)))) :=
    { arrows := fun W g => ∃ k, ∃ c : W ⟶ V k, c ≫ ι k = g
      downward_closed := by
        rintro W W' g ⟨k, c, hc⟩ d
        exact ⟨k, d ≫ c, by rw [Category.assoc, hc]⟩ }
  have hRk : ∀ k, R.arrows (ι k) := fun k => ⟨k, 𝟙 _, Category.id_comp _⟩
  have hRcov : R ∈ Scheme.smallEtaleTopology (Spec (.of A)) (Scheme.Etale.mk (𝟙 (Spec (.of A)))) := by
    change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of A)) _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
      (Spec (.of A)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale (Spec (.of A))
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨k, P, hP⟩ := hcov x
    exact ⟨V k, ι k, P, hRk k, hEt k, hP⟩

  let ê : ∀ k, O.obj.obj (Opposite.op (V k)) := fun k =>
    ULift.up ((Scheme.ΓSpecIso (.of (E k))).inv.hom (e k))
  let sec : ∀ (W : (Spec (.of A)).Etale) (g : W ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A)))),
      R.arrows g → O.obj.obj (Opposite.op W) :=
    fun W g h => O.obj.map h.choose_spec.choose.op (ê h.choose)
  have hmapê : ∀ (W W' : (Spec (.of A)).Etale) (k : Fin n) (c : W ⟶ V k) (a : W' ⟶ W),
      O.obj.map a.op (O.obj.map c.op (ê k)) =
        ULift.up ((Scheme.Hom.appTop (a ≫ c).left).hom
          ((Scheme.ΓSpecIso (.of (E k))).inv.hom (e k))) := by
    intro W W' k c a
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
    rfl
  have hsupp : ∀ (W : (Spec (.of A)).Etale) (k l : Fin n) (α : W ⟶ V k) (β : W ⟶ V l),
      wcSuppSec (Spec (.of A)) Zᶜ O W
        (ULift.up ((Scheme.Hom.appTop α.left).hom ((Scheme.ΓSpecIso (.of (E k))).inv.hom (e k)) -
          (Scheme.Hom.appTop β.left).hom ((Scheme.ΓSpecIso (.of (E l))).inv.hom (e l)))) := by
    intro W k l α β
    obtain ⟨s, hs, h1⟩ := hcomp k l
    exact wc_rd_supp_of_ann A I hO (E k) (E l) (e k) (e l) s hs h1 W α.left β.left
      (MorphismProperty.Over.w α) (MorphismProperty.Over.w β)
  have hcompat : ∀ (V₁ V₂ V' : (Spec (.of A)).Etale)
      (g₁ : V₁ ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))))
      (g₂ : V₂ ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))))
      (h₁ : R.arrows g₁) (h₂ : R.arrows g₂) (a : V' ⟶ V₁) (c : V' ⟶ V₂), a ≫ g₁ = c ≫ g₂ →
      wcSuppSec (Spec (.of A)) Zᶜ O V'
        (O.obj.map a.op (sec V₁ g₁ h₁) - O.obj.map c.op (sec V₂ g₂ h₂)) := by
    intro V₁ V₂ V' g₁ g₂ h₁ h₂ a c _
    show wcSuppSec (Spec (.of A)) Zᶜ O V'
      (O.obj.map a.op (O.obj.map h₁.choose_spec.choose.op (ê h₁.choose)) -
        O.obj.map c.op (O.obj.map h₂.choose_spec.choose.op (ê h₂.choose)))
    rw [hmapê, hmapê]
    exact hsupp V' _ _ _ _

  obtain ⟨s₀, hs₀⟩ := hEG R hRcov sec hcompat
  obtain ⟨y, hy⟩ : ∃ y : A, y = (Scheme.ΓSpecIso (.of A)).hom.hom (ULift.down s₀) := ⟨_, rfl⟩
  refine ⟨y, fun k => ?_⟩
  have hk := hRk k
  have X1 := hs₀ (V k) (ι k) hk
  have X2 := hsupp (V k) hk.choose k hk.choose_spec.choose (𝟙 _)
  have X3 := ((wc_suppSec_calculus (Spec (.of A)) Zᶜ O (V k)).1 _ _ X1 X2).1
  have hnat : (Scheme.Hom.appTop (Spec.map (CommRingCat.ofHom (algebraMap A (E k))))).hom
      ((Scheme.ΓSpecIso (.of A)).inv.hom y) =
      (Scheme.ΓSpecIso (.of (E k))).inv.hom (algebraMap A (E k) y) := by
    have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ y)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap A (E k))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    exact h2.symm
  have hs0 : s₀ = ULift.up ((Scheme.ΓSpecIso (.of A)).inv.hom y) := by
    rw [hy]
    exact (congrArg ULift.up (Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of A)) (ULift.down s₀))).symm
  have e1 : O.obj.map (ι k).op s₀ =
      ULift.up ((Scheme.ΓSpecIso (.of (E k))).inv.hom (algebraMap A (E k) y)) := by
    rw [hs0, ← hnat]
    rfl
  have e2 : sec (V k) (ι k) hk = ULift.up ((Scheme.Hom.appTop hk.choose_spec.choose.left).hom
      ((Scheme.ΓSpecIso (.of (E hk.choose))).inv.hom (e hk.choose))) := rfl
  have e3 : Scheme.Hom.appTop (𝟙 (V k) : V k ⟶ V k).left = 𝟙 _ := Scheme.Hom.id_appTop
  have X4 : wcSuppSec (Spec (.of A)) Zᶜ O (V k)
      (ULift.up ((Scheme.ΓSpecIso (.of (E k))).inv.hom (algebraMap A (E k) y - e k))) := by
    refine (congrArg (wcSuppSec (Spec (.of A)) Zᶜ O (V k)) ?_).mpr X3
    rw [e1, e2]
    apply ULift.ext
    have alg : ∀ (G : Type u) [AddCommGroup G] (a p b : G), a - b = a - p + (p - b) :=
      fun _ _ a p b => (sub_add_sub_cancel a p b).symm
    have hsub := map_sub (Scheme.ΓSpecIso (.of (E k))).inv.hom (algebraMap A (E k) y) (e k)
    rw [e3]
    refine hsub.trans ?_
    exact alg _ ((Scheme.ΓSpecIso (.of (E k))).inv.hom (algebraMap A (E k) y))
      ((Scheme.Hom.appTop hk.choose_spec.choose.left).hom
          ((Scheme.ΓSpecIso (.of (E hk.choose))).inv.hom (e hk.choose)))
      ((Scheme.ΓSpecIso (.of (E k))).inv.hom (e k))
  exact wc_rd_ann_of_supp A I hO (E k) (hE k) (algebraMap A (E k) y - e k) X4

theorem wc_whlz_ring_descent (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (n : ℕ) (a : Fin n → A)
    (hspan : Ideal.span (Set.range (fun k => Ideal.Quotient.mk I (a k))) = ⊤)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (hHwe : ∀ k, Algebra.WeaklyEtale A (H k))
    (hHhen : ∀ k, HenselianRing (H k) (I.map (algebraMap A (H k))))
    (θH : ∀ k, (H k ⧸ I.map (algebraMap A (H k))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k)))
    (hHθ : ∀ k, (θH k).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (H k)))
        (algebraMap A (H k)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k))))
    (C : Fin n → Fin n → Type u) [∀ k l, CommRing (C k l)] [∀ k l, Algebra A (C k l)]
    (hCwe : ∀ k l, Algebra.WeaklyEtale A (C k l))
    (hChen : ∀ k l, HenselianRing (C k l) (I.map (algebraMap A (C k l))))
    (θC : ∀ k l, (C k l ⧸ I.map (algebraMap A (C k l))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k * a l)))
    (hCθ : ∀ k l, (θC k l).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (C k l)))
        (algebraMap A (C k l)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k * a l))))
    (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l) :
    ∀ x : ∀ k, H k, (∀ k l, φ k l (x k) = ψ k l (x l)) →
      ∃! y : A, ∀ k, algebraMap A (H k) y = x k :=
by
  classical
  intro x hx

  have helperT : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
      (P : Ideal S) [P.IsPrime] (r : R) (t : S), t ∉ P → t * algebraMap R S r = 0 →
      ∃ t' : R, t' ∉ P.comap (algebraMap R S) ∧ t' * r = 0 := by
    intro R S _ _ _ _ P _ r t ht htr
    haveI : (P.comap (algebraMap R S)).IsPrime := Ideal.comap_isPrime _ P
    have hf : (Localization.localRingHom (P.comap (algebraMap R S)) P (algebraMap R S) rfl).Flat :=
      RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) P _ rfl
    letI := (Localization.localRingHom (P.comap (algebraMap R S)) P (algebraMap R S) rfl).toAlgebra
    haveI : Module.Flat (Localization.AtPrime (P.comap (algebraMap R S)))
        (Localization.AtPrime P) := hf
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (P.comap (algebraMap R S)))
        (Localization.AtPrime P)) :=
      Localization.isLocalHom_localRingHom _ P (algebraMap R S) rfl
    haveI : Module.FaithfullyFlat (Localization.AtPrime (P.comap (algebraMap R S)))
        (Localization.AtPrime P) := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinj : Function.Injective (algebraMap (Localization.AtPrime (P.comap (algebraMap R S)))
        (Localization.AtPrime P)) := FaithfulSMul.algebraMap_injective _ _
    have h0 : algebraMap R (Localization.AtPrime (P.comap (algebraMap R S))) r = 0 := by
      apply hinj
      rw [map_zero]
      show Localization.localRingHom (P.comap (algebraMap R S)) P (algebraMap R S) rfl
        (algebraMap R _ r) = 0
      rw [Localization.localRingHom_to_map]
      exact (IsLocalization.map_eq_zero_iff P.primeCompl _ _).mpr ⟨⟨t, ht⟩, htr⟩
    obtain ⟨⟨m, hm⟩, hmr⟩ :=
      (IsLocalization.map_eq_zero_iff (P.comap (algebraMap R S)).primeCompl _ _).mp h0
    exact ⟨m, hm, hmr⟩

  have annT : ∀ (R : Type u) [CommRing R] (J : Ideal R) (r : R),
      (∀ M : Ideal R, M.IsMaximal → J ≤ M → ∃ t, t ∉ M ∧ t * r = 0) →
      ∃ s, s * r = 0 ∧ 1 - s ∈ J := by
    intro R _ J r h
    by_cases htop : LinearMap.ker (LinearMap.mulRight R r) ⊔ J = ⊤
    · have h1 : (1 : R) ∈ LinearMap.ker (LinearMap.mulRight R r) ⊔ J := by
        rw [htop]; exact Submodule.mem_top
      obtain ⟨s, hs, j, hj, hsj⟩ := Submodule.mem_sup.mp h1
      refine ⟨s, ?_, ?_⟩
      · simpa [LinearMap.mem_ker] using hs
      · have : 1 - s = j := by rw [← hsj]; ring
        rw [this]; exact hj
    · obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ htop
      obtain ⟨t, ht, htr⟩ := h M hM (le_trans le_sup_right hle)
      exact absurd (hle (Submodule.mem_sup_left (by simpa [LinearMap.mem_ker] using htr))) ht

  have s1T : ∀ (D C' : Type u) [CommRing D] [CommRing C'] (μ : D →+* C'), μ.Flat →
      ∀ (J : Ideal D) (K : Ideal C') (hle : J ≤ K.comap μ),
      Function.Bijective (Ideal.quotientMap K μ hle) → ∀ d : D, μ d = 0 →
      (∀ M : Ideal D, M.IsMaximal → J ≤ M → ∃ t, t ∉ M ∧ t * d = 0) := by
    intro D C' _ _ μ hμ J K hle hbij d hd
    letI := μ.toAlgebra
    haveI : Module.Flat D C' := hμ
    intro M hM hJM
    let e := RingEquiv.ofBijective (Ideal.quotientMap K μ hle) hbij
    haveI h1 : (M.map (Ideal.Quotient.mk J)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hJM)
    haveI h2 : ((M.map (Ideal.Quotient.mk J)).comap e.symm.toRingHom).IsPrime :=
      Ideal.comap_isPrime _ _
    let P : Ideal C' := ((M.map (Ideal.Quotient.mk J)).comap e.symm.toRingHom).comap
      (Ideal.Quotient.mk K)
    haveI : P.IsPrime := Ideal.comap_isPrime _ _
    have hPM : P.comap (algebraMap D C') = M := by
      ext x
      show e.symm (Ideal.Quotient.mk K (μ x)) ∈ M.map (Ideal.Quotient.mk J) ↔ x ∈ M
      have : Ideal.Quotient.mk K (μ x) = e (Ideal.Quotient.mk J x) := by
        rw [RingEquiv.ofBijective_apply, Ideal.quotientMap_mk]
      rw [this, RingEquiv.symm_apply_apply]
      exact Ideal.mem_quotient_iff_mem hJM
    have h1P : (1 : C') ∉ P := (Ideal.ne_top_iff_one P).mp (Ideal.IsPrime.ne_top inferInstance)
    obtain ⟨t', ht', ht'd⟩ := helperT D C' P d 1 h1P (by rw [one_mul]; exact hd)
    exact ⟨t', by rwa [hPM] at ht', ht'd⟩

  have descend : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
      [Module.FaithfullyFlat R S] (J : Ideal R), J ≤ (⊥ : Ideal R).jacobson →
      ∀ (w : R) (s : S), s * algebraMap R S w = 0 → 1 - s ∈ J.map (algebraMap R S) → w = 0 := by
    intro R S _ _ _ _ J hJ w s hs h1
    obtain ⟨s', hs', h1'⟩ := annT R J w (fun M hM hJM => by
      obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := S)
        ⟨M, hM.isPrime⟩
      have hQM : Q.asIdeal.comap (algebraMap R S) = M := by
        have := congrArg PrimeSpectrum.asIdeal hQ
        rwa [PrimeSpectrum.comap_asIdeal] at this
      have hJQ : J.map (algebraMap R S) ≤ Q.asIdeal := by
        rw [Ideal.map_le_iff_le_comap, hQM]; exact hJM
      have hsQ : s ∉ Q.asIdeal := fun h => Q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (by
        have := Q.asIdeal.add_mem h (hJQ h1)
        simpa using this))
      obtain ⟨t, ht, htw⟩ := helperT R S Q.asIdeal w s hsQ hs
      exact ⟨t, by rwa [hQM] at ht, htw⟩)
    have hj : 1 - s' ∈ (⊥ : Ideal R).jacobson := hJ h1'
    have hu : IsUnit s' := by
      have := (Ideal.mem_jacobson_bot.mp hj) (-1)
      have e : (1 - s') * -1 + 1 = s' := by ring
      rwa [e] at this
    exact (hu.mul_right_eq_zero).mp hs'
  have hflat : ∀ k, Module.Flat A (H k) := fun k => (hHwe k).flat
  have hsurj := wc_whlz_jointly_surjective A I (HenselianRing.jac (I := I)) n a hspan H hflat
    θH hHθ

  have huniq0 : ∀ y : A, (∀ k, algebraMap A (H k) y = 0) → y = 0 := by
    intro y hy
    obtain ⟨s, hs, h1⟩ := annT A ⊥ y (fun M hM _ => by
      obtain ⟨k, P, hP⟩ := hsurj ⟨M, hM.isPrime⟩
      haveI := hflat k
      have hP1 : (1 : H k) ∉ P.asIdeal := fun h =>
        P.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
      obtain ⟨t, ht, hty⟩ := helperT A (H k) P.asIdeal y 1 hP1 (by rw [one_mul]; exact hy k)
      refine ⟨t, ?_, hty⟩
      have hPM : P.asIdeal.comap (algebraMap A (H k)) = M := by
        have := congrArg PrimeSpectrum.asIdeal hP
        rwa [PrimeSpectrum.comap_asIdeal] at this
      rwa [hPM] at ht)
    rw [Ideal.mem_bot, sub_eq_zero] at h1
    rw [← h1, one_mul] at hs
    exact hs

  have hrelH : ∀ k l, ∃ s : TensorProduct A (H k) (H l),
      s * (TensorProduct.tmul A (x k) 1 - TensorProduct.tmul A 1 (x l)) = 0 ∧
      1 - s ∈ I.map (algebraMap A (TensorProduct A (H k) (H l))) := by
    intro k l
    haveI := hHwe k
    haveI := hHwe l
    haveI := hCwe k l
    have hle : I.map (algebraMap A (TensorProduct A (H k) (H l))) ≤
        (I.map (algebraMap A (C k l))).comap
        (Algebra.TensorProduct.lift (φ k l) (ψ k l) (fun _ _ => Commute.all _ _)).toRingHom := by
      rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]
      have e : (Algebra.TensorProduct.lift (φ k l) (ψ k l)
          (fun _ _ => Commute.all _ _)).toRingHom.comp
            (algebraMap A (TensorProduct A (H k) (H l))) =
          algebraMap A (C k l) :=
        (Algebra.TensorProduct.lift (φ k l) (ψ k l) (fun _ _ => Commute.all _ _)).comp_algebraMap
      rw [e]
      exact Ideal.le_comap_map
    have hbij := wc_rd_tensor_mod_bijective A I (a k) (a l) (H k) (H l) (C k l) (θH k) (hHθ k)
      (θH l) (hHθ l) (θC k l) (hCθ k l) (φ k l) (ψ k l) hle
    have hWE : Algebra.WeaklyEtale A (TensorProduct A (H k) (H l)) :=
      Algebra.WeaklyEtale.trans A (H k) (TensorProduct A (H k) (H l))
    have hflatμ : (Algebra.TensorProduct.lift (φ k l) (ψ k l)
        (fun _ _ => Commute.all _ _)).toRingHom.Flat := by
      letI := (Algebra.TensorProduct.lift (φ k l) (ψ k l)
        (fun _ _ => Commute.all _ _)).toRingHom.toAlgebra
      haveI : IsScalarTower A (TensorProduct A (H k) (H l)) (C k l) :=
        IsScalarTower.of_algebraMap_eq
        (fun r => ((Algebra.TensorProduct.lift (φ k l) (ψ k l)
          (fun _ _ => Commute.all _ _)).commutes r).symm)
      exact (wc_weaklyEtale_cancel A (TensorProduct A (H k) (H l)) (C k l) hWE (hCwe k l)).flat
    have hd : (Algebra.TensorProduct.lift (φ k l) (ψ k l)
        (fun _ _ => Commute.all _ _)).toRingHom
          (TensorProduct.tmul A (x k) 1 - TensorProduct.tmul A 1 (x l)) = 0 := by
      show (Algebra.TensorProduct.lift (φ k l) (ψ k l)
        (fun _ _ => Commute.all _ _))
          (TensorProduct.tmul A (x k) 1 - TensorProduct.tmul A 1 (x l)) = 0
      rw [map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul, map_one,
        map_one, mul_one, one_mul, hx k l, sub_self]
    exact annT _ _ _ (s1T _ _ _ hflatμ _ _ hle hbij _ hd)

  choose T hTr hTa hTff hTwe hTind using
    fun k => wc_bs_weaklyEtale_indEtale_locally A (H k) (hHwe k)
  letI hTA : ∀ k, Algebra A (T k) := fun k =>
    ((algebraMap (H k) (T k)).comp (algebraMap A (H k))).toAlgebra
  haveI hTst : ∀ k, IsScalarTower A (H k) (T k) := fun k =>
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hTind' : ∀ k, wcIndEtale (algebraMap A (T k)) := fun k => hTind k
  have hrelT : ∀ k l, ∃ s : TensorProduct A (T k) (T l),
      s * (TensorProduct.tmul A (algebraMap (H k) (T k) (x k)) 1 -
        TensorProduct.tmul A 1 (algebraMap (H l) (T l) (x l))) = 0 ∧
      1 - s ∈ I.map (algebraMap A (TensorProduct A (T k) (T l))) := by
    intro k l
    obtain ⟨s, hs, h1⟩ := hrelH k l
    refine ⟨Algebra.TensorProduct.map (IsScalarTower.toAlgHom A (H k) (T k))
      (IsScalarTower.toAlgHom A (H l) (T l)) s, ?_, ?_⟩
    · have := congrArg (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A (H k) (T k))
        (IsScalarTower.toAlgHom A (H l) (T l))) hs
      simp only [map_mul, map_sub, Algebra.TensorProduct.map_tmul, map_one, map_zero,
        IsScalarTower.coe_toAlgHom'] at this
      exact this
    · have := Ideal.mem_map_of_mem (Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom A (H k) (T k)) (IsScalarTower.toAlgHom A (H l) (T l))).toRingHom h1
      have e : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A (H k) (T k))
          (IsScalarTower.toAlgHom A (H l) (T l))).toRingHom.comp
            (algebraMap A (TensorProduct A (H k) (H l))) =
            algebraMap A (TensorProduct A (T k) (T l)) :=
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A (H k) (T k))
          (IsScalarTower.toAlgHom A (H l) (T l))).comp_algebraMap
      rw [Ideal.map_map, e, map_sub, map_one] at this
      exact this

  obtain ⟨E, hEr, hEa, hEet, β, e, hβe, hErel⟩ :=
    wc_rd_etale_approx A I n T hTind' (fun k => algebraMap (H k) (T k) (x k)) hrelT
  have hcov : ∀ p : PrimeSpectrum A, ∃ k, ∃ P : PrimeSpectrum (E k),
      PrimeSpectrum.comap (algebraMap A (E k)) P = p := by
    intro p
    obtain ⟨k, P, hP⟩ := hsurj p
    haveI := hTff k
    obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := H k) (B := T k) P
    refine ⟨k, PrimeSpectrum.comap (β k).toRingHom Q, ?_⟩
    rw [← hP, ← hQ]
    apply PrimeSpectrum.ext
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap]
    have e1 : (β k).toRingHom.comp (algebraMap A (E k)) = algebraMap A (T k) :=
      (β k).comp_algebraMap
    rw [e1]
    rfl

  obtain ⟨y, hy⟩ := wc_rd_etale_gabber_glue A I n E hEet e hcov hErel

  have hyk : ∀ k, algebraMap A (H k) y = x k := by
    intro k
    obtain ⟨s, hs, h1⟩ := hy k
    haveI := hTff k
    have hw := descend (H k) (T k) (I.map (algebraMap A (H k))) (hHhen k).jac
      (algebraMap A (H k) y - x k) (β k s) ?_ ?_
    · exact sub_eq_zero.mp hw
    · have := congrArg (β k) hs
      rw [map_mul, map_sub, map_zero, AlgHom.commutes, hβe k] at this
      rw [map_sub]
      exact this
    · have := Ideal.mem_map_of_mem (β k).toRingHom h1
      have e1 : (β k).toRingHom.comp (algebraMap A (E k)) = algebraMap A (T k) :=
        (β k).comp_algebraMap
      rw [Ideal.map_map, e1, map_sub, map_one] at this
      rw [Ideal.map_map]
      exact this
  exact ⟨y, hyk, fun y' hy' => sub_eq_zero.mp (huniq0 _ (fun k => by
    rw [map_sub, hy' k, hyk k, sub_self]))⟩

theorem wc_henselian_quotient (R : Type u) [CommRing R] (I : Ideal R) [HenselianRing R I]
    (J : Ideal R) : HenselianRing (R ⧸ J) (I.map (Ideal.Quotient.mk J)) :=
by
  classical
  have hI : I ≤ (⊥ : Ideal R).jacobson := HenselianRing.jac

  have core : ∀ (f : Polynomial R), f.Monic → ∀ (a₀ u : R),
      f.eval a₀ ∈ I ⊔ J → (Polynomial.derivative f).eval a₀ * u - 1 ∈ I ⊔ J →
      ∃ a : R, f.eval a ∈ J ∧ a - a₀ ∈ I := by
    intro f hf a₀ u h0 h1
    rcases subsingleton_or_nontrivial R with hR | hR
    · refine ⟨a₀, ?_, ?_⟩
      · rw [Subsingleton.elim (f.eval a₀) 0]; exact J.zero_mem
      · rw [sub_self]; exact I.zero_mem
    set h : Polynomial R := (Polynomial.X - Polynomial.C a₀) ^ 2 + Polynomial.C u with hh
    have hXa : ((Polynomial.X - Polynomial.C a₀) ^ 2).Monic := (Polynomial.monic_X_sub_C a₀).pow 2
    have hXadeg : ((Polynomial.X - Polynomial.C a₀) ^ 2).natDegree = 2 := by
      rw [(Polynomial.monic_X_sub_C a₀).natDegree_pow, Polynomial.natDegree_X_sub_C]
    have hhmon : h.Monic := by
      apply hXa.add_of_left
      refine lt_of_le_of_lt Polynomial.degree_C_le ?_
      rw [Polynomial.degree_eq_natDegree hXa.ne_zero, hXadeg]
      norm_num
    have hhdeg : h.natDegree = 2 := by
      rw [hh, Polynomial.natDegree_add_C, hXadeg]
    set P : Polynomial R := f * h with hP
    have hPmon : P.Monic := hf.mul hhmon
    have hPdeg : 2 ≤ P.natDegree := by
      rw [hP, hf.natDegree_mul hhmon, hhdeg]; omega
    have hha0 : h.eval a₀ = u := by
      simp only [hh, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C, sub_self]
      ring
    have hh'a0 : (Polynomial.derivative h).eval a₀ = 0 := by
      simp only [hh, Polynomial.derivative_add, Polynomial.derivative_pow, Polynomial.derivative_C,
        Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.eval_add,
        Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C, Polynomial.eval_one, Polynomial.eval_zero, sub_self]
      ring
    have hPa : P.eval a₀ = f.eval a₀ * u := by
      rw [hP, Polynomial.eval_mul, hha0]
    have hP'a : (Polynomial.derivative P).eval a₀ = (Polynomial.derivative f).eval a₀ * u := by
      rw [hP, Polynomial.derivative_mul, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_mul, hha0, hh'a0, mul_zero, add_zero]
    have hPa' : P.eval a₀ ∈ I ⊔ J := by rw [hPa]; exact Ideal.mul_mem_right u _ h0
    have hP'a' : (Polynomial.derivative P).eval a₀ - 1 ∈ I ⊔ J := by rw [hP'a]; exact h1
    obtain ⟨i₀, hi₀, j₀, hj₀, hij₀⟩ := Submodule.mem_sup.mp hPa'
    obtain ⟨i₁, hi₁, j₁, hj₁, hij₁⟩ := Submodule.mem_sup.mp hP'a'
    set L : Polynomial R :=
      Polynomial.C j₁ * (Polynomial.X - Polynomial.C a₀) + Polynomial.C j₀ with hL
    have hLdeg : L.degree < P.degree := by
      have hL1 : L.natDegree ≤ 1 := by
        rw [hL]; compute_degree
      rw [Polynomial.degree_eq_natDegree hPmon.ne_zero]
      refine lt_of_le_of_lt (Polynomial.degree_le_of_natDegree_le hL1) ?_
      exact_mod_cast (by omega : 1 < P.natDegree)
    set g : Polynomial R := P - L with hg
    have hgmon : g.Monic := hPmon.sub_of_left hLdeg
    have hga : g.eval a₀ = i₀ := by
      simp only [hg, hL, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_C, Polynomial.eval_X]
      linear_combination -hij₀
    have hg'a : (Polynomial.derivative g).eval a₀ = 1 + i₁ := by
      simp only [hg, hL, Polynomial.derivative_sub, Polynomial.derivative_add,
        Polynomial.derivative_mul, Polynomial.derivative_C, Polynomial.derivative_X,
        Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_X, Polynomial.eval_zero, Polynomial.eval_one]
      linear_combination -hij₁
    have hunit : IsUnit (Ideal.Quotient.mk I ((Polynomial.derivative g).eval a₀)) := by
      rw [hg'a, map_add, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hi₁, add_zero]
      exact isUnit_one
    obtain ⟨a, ha, hai⟩ :=
      HenselianRing.is_henselian g hgmon a₀ (by rw [hga]; exact hi₀) hunit
    have hfa : f.eval a * h.eval a ∈ J := by
      have e : g.eval a = 0 := ha
      have e2 : f.eval a * h.eval a = j₁ * (a - a₀) + j₀ := by
        simp only [hg, hL, hP, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
          Polynomial.eval_C, Polynomial.eval_X] at e
        linear_combination e
      rw [e2]
      exact J.add_mem (J.mul_mem_right _ hj₁) hj₀
    obtain ⟨i₂, hi₂, j₂, hj₂, hij₂⟩ := Submodule.mem_sup.mp h1
    have hha : h.eval a = (a - a₀) ^ 2 + u := by
      simp only [hh, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C]
    have hi'' : i₂ + (a - a₀) ^ 2 * (Polynomial.derivative f).eval a₀ ∈ I :=
      I.add_mem hi₂ (I.mul_mem_right _ (by rw [pow_two]; exact I.mul_mem_left _ hai))
    have key : f.eval a * (1 + (i₂ + (a - a₀) ^ 2 * (Polynomial.derivative f).eval a₀)) ∈ J := by
      have e : f.eval a * (1 + (i₂ + (a - a₀) ^ 2 * (Polynomial.derivative f).eval a₀)) =
          f.eval a * h.eval a * (Polynomial.derivative f).eval a₀ - f.eval a * j₂ := by
        rw [hha]
        linear_combination (f.eval a) * hij₂
      rw [e]
      exact J.sub_mem (J.mul_mem_right _ hfa) (J.mul_mem_left _ hj₂)
    have hu := (Ideal.mem_jacobson_bot.mp (hI hi'')) 1
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    refine ⟨a, ?_, hai⟩
    have e : f.eval a =
        f.eval a * (1 + (i₂ + (a - a₀) ^ 2 * (Polynomial.derivative f).eval a₀)) * v := by
      linear_combination -(f.eval a) * hv
    rw [e]
    exact J.mul_mem_right _ key

  have hjac : I.map (Ideal.Quotient.mk J) ≤ (⊥ : Ideal (R ⧸ J)).jacobson := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hx
    rw [Ideal.mem_jacobson_bot]
    intro z
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
    have := ((Ideal.mem_jacobson_bot.mp (hI hy)) z).map (Ideal.Quotient.mk J)
    simpa only [map_add, map_mul, map_one] using this

  have star : ∀ r : R, Ideal.Quotient.mk J r ∈ I.map (Ideal.Quotient.mk J) → r ∈ I ⊔ J := by
    intro r hr
    obtain ⟨x, hx, hxr⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hr
    have hrx : r - x ∈ J := Ideal.Quotient.eq.mp hxr.symm
    have e : r = x + (r - x) := by ring
    rw [e]
    exact Submodule.add_mem_sup hx hrx
  refine { jac := hjac, is_henselian := ?_ }
  intro F hF b₀ hF0 hF1
  rcases subsingleton_or_nontrivial (R ⧸ J) with hS | hS
  · refine ⟨b₀, ?_, ?_⟩
    · show F.eval b₀ = 0
      exact Subsingleton.elim _ _
    · rw [sub_self]; exact Ideal.zero_mem _
  have hlift : F ∈ Polynomial.lifts (Ideal.Quotient.mk J) :=
    (Polynomial.mem_lifts F).mpr (Polynomial.map_surjective _ Ideal.Quotient.mk_surjective F)
  obtain ⟨f, hfmap, -, hfmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hF
  obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective b₀
  subst hfmap
  have h0 : f.eval a₀ ∈ I ⊔ J := by
    apply star
    rw [← Polynomial.eval_map_apply]
    exact hF0
  rw [Polynomial.derivative_map, Polynomial.eval_map_apply] at hF1
  obtain ⟨w, hw⟩ := hF1.exists_right_inv
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w
  obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective w
  have h1 : (Polynomial.derivative f).eval a₀ * u - 1 ∈ I ⊔ J := by
    apply star
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [map_sub, map_mul, map_one]
    rw [hw, sub_self]
  obtain ⟨a, hfa, hai⟩ := core f hfmon a₀ u h0 h1
  refine ⟨Ideal.Quotient.mk J a, ?_, ?_⟩
  · show (f.map (Ideal.Quotient.mk J)).eval (Ideal.Quotient.mk J a) = 0
    rw [Polynomial.eval_map_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hfa
  · rw [← map_sub]
    exact Ideal.mem_map_of_mem _ hai

theorem wc_weaklyEtale_flat_transfer (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hB : Algebra.WeaklyEtale A B) (M : Type u) [AddCommGroup M] [Module A M] [Module B M]
    [IsScalarTower A B M] (hM : Module.Flat A M) : Module.Flat B M :=
by
  haveI := hB
  haveI := hM

  have flat_prod : ∀ (R P Q : Type u) [CommRing R] [AddCommGroup P] [AddCommGroup Q]
      [Module R P] [Module R Q], Module.Flat R P → Module.Flat R Q → Module.Flat R (P × Q) := by
    intro R P Q _ _ _ _ _ hP hQ
    rw [Module.Flat.iff_rTensor_preserves_injective_linearMap]
    intro N N' _ _ _ _ f hf
    have h1 := Module.Flat.rTensor_preserves_injective_linearMap (M := P) f hf
    have h2 := Module.Flat.rTensor_preserves_injective_linearMap (M := Q) f hf
    have key : (TensorProduct.prodRight R R N' P Q).toLinearMap ∘ₗ LinearMap.rTensor (P × Q) f =
        ((LinearMap.rTensor P f).prodMap (LinearMap.rTensor Q f)) ∘ₗ
          (TensorProduct.prodRight R R N P Q).toLinearMap := by
      apply TensorProduct.ext'
      intro n pq
      simp [TensorProduct.prodRight_tmul]
    have hinj : Function.Injective ((TensorProduct.prodRight R R N' P Q).toLinearMap ∘ₗ
        LinearMap.rTensor (P × Q) f) := by
      rw [key]
      exact (Function.Injective.prodMap h1 h2).comp (TensorProduct.prodRight R R N P Q).injective
    exact Function.Injective.of_comp hinj

  have alg_transfer : ∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra B C]
      [IsScalarTower A B C], Module.Flat A C → Module.Flat B C := by
    intro C _ _ _ _ hC
    haveI := hC
    have h1 : (Algebra.TensorProduct.mapOfCompatibleSMul B A B B C :
        TensorProduct A B C →+* TensorProduct B B C).Flat :=
      RingHom.Flat.mapOfCompatibleSMul (R := A) (S := B) B C (Algebra.WeaklyEtale.flat_lmul' A B)
    have h2 : ((Algebra.TensorProduct.lid B C : TensorProduct B B C ≃ₐ[B] C) :
        TensorProduct B B C →+* C).Flat :=
      RingHom.Flat.of_bijective (Algebra.TensorProduct.lid B C).bijective
    let φ : TensorProduct A B C →ₐ[B] C :=
      (Algebra.TensorProduct.lid B C).toAlgHom.comp
        (Algebra.TensorProduct.mapOfCompatibleSMul B A B B C)
    have hφ : (φ : TensorProduct A B C →+* C).Flat := RingHom.Flat.comp h1 h2
    have h3 : (algebraMap B (TensorProduct A B C)).Flat :=
      RingHom.flat_algebraMap_iff.mpr (Module.Flat.baseChange A B C)
    have h4 : ((φ : TensorProduct A B C →+* C).comp (algebraMap B (TensorProduct A B C))).Flat :=
      RingHom.Flat.comp h3 hφ
    rw [AlgHom.comp_algebraMap φ] at h4
    exact RingHom.flat_algebraMap_iff.mp h4

  letI : Module Bᵐᵒᵖ M := Module.compHom M ((RingHom.id B).fromOpposite mul_comm)
  haveI : IsCentralScalar B M := ⟨fun _ _ => rfl⟩
  have hBA : Module.Flat A B := Algebra.WeaklyEtale.flat
  have hprod : Module.Flat A (B × M) := flat_prod A B M hBA hM
  have hCA : Module.Flat A (TrivSqZeroExt B M) := hprod
  have hCB : Module.Flat B (TrivSqZeroExt B M) := alg_transfer (TrivSqZeroExt B M) hCA
  exact @Module.Flat.of_retract B (TrivSqZeroExt B M) M _ _ _ _ _ hCB (TrivSqZeroExt.inrHom B M)
    (TrivSqZeroExt.sndHom B M) (LinearMap.ext fun m => TrivSqZeroExt.snd_inr B m)

theorem wc_weaklyEtale_field_vnr (K R : Type u) [Field K] [CommRing R] [Algebra K R]
    (h : Algebra.WeaklyEtale K R)
    (htransfer : ∀ (M : Type u) [AddCommGroup M] [Module K M] [Module R M] [IsScalarTower K R M],
      Module.Flat K M → Module.Flat R M) :
    ∀ x : R, ∃ t : R, x * x * t = x :=
by
  intro x
  classical
  haveI hflat : Module.Flat R (R ⧸ Ideal.span {x}) := htransfer (R ⧸ Ideal.span {x}) inferInstance
  have hsmul : ∀ (b r : R), b • (Ideal.Quotient.mk (Ideal.span {x}) r) =
      Ideal.Quotient.mk (Ideal.span {x}) (b * r) := by
    intro b r
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
  have hsum : ∑ i : Fin 1, (fun _ => x) i •
      (fun _ => (Ideal.Quotient.mk (Ideal.span {x}) 1 : R ⧸ Ideal.span {x})) i = 0 := by
    rw [Fin.sum_univ_one]
    show x • (Ideal.Quotient.mk (Ideal.span {x}) 1) = 0
    rw [hsmul, mul_one]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
  obtain ⟨k, a, y, hx, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hsum
  choose r hr using fun j => Ideal.Quotient.mk_surjective (I := Ideal.span {x}) (y j)
  have hx0 : (Ideal.Quotient.mk (Ideal.span {x}) 1 : R ⧸ Ideal.span {x}) =
      ∑ j, a 0 j • y j := hx 0
  have h1 : Ideal.Quotient.mk (Ideal.span {x}) 1 =
      Ideal.Quotient.mk (Ideal.span {x}) (∑ j, a 0 j * r j) := by
    rw [hx0, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hr j, hsmul]
  rw [Ideal.Quotient.eq, Ideal.mem_span_singleton'] at h1
  obtain ⟨c, hc⟩ := h1
  have hxs : x * ∑ j, a 0 j * r j = 0 := by
    rw [Finset.mul_sum]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have h2 : ∑ i : Fin 1, (fun _ => x) i * a i j = 0 := hrel j
    rw [Fin.sum_univ_one] at h2
    have h3 : x * a 0 j = 0 := h2
    rw [← mul_assoc, h3, zero_mul]
  exact ⟨c, by linear_combination x * hc - hxs⟩

theorem wc_top_preconnected_subsingleton {X : Type u} [TopologicalSpace X] (Y T : Set X)
    (hTY : T ⊆ Y) (hTc : IsCompact T) (hTp : _root_.IsPreconnected T)
    (hloc : ∀ x ∈ T, ∃ V : Set X, IsOpen V ∧ x ∈ V ∧ T2Space ↥(V ∩ Y) ∧
      ∀ y ∈ V ∩ Y, ∀ U : Set X, IsOpen U → y ∈ U →
        ∃ D : Set X, IsOpen D ∧ y ∈ D ∧ D ⊆ U ∩ V ∧ IsCompact (D ∩ Y)) :
    T.Subsingleton :=
by
  classical

  have s1 : ∀ (V D : Set X), T2Space ↥(V ∩ Y) → D ⊆ V → IsCompact (D ∩ Y) →
      ∀ p ∈ V, p ∈ Y → p ∈ closure (D ∩ Y) → p ∈ D := by
    intro V D hT2 hDV hDc p hpV hpY hpcl
    haveI := hT2
    let K : Set ↥(V ∩ Y) := Subtype.val ⁻¹' D
    have hKimg : Subtype.val '' K = D ∩ Y := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        exact ⟨hw, w.2.2⟩
      · rintro ⟨hzD, hzY⟩
        exact ⟨⟨z, hDV hzD, hzY⟩, hzD, rfl⟩
    have hKc : IsCompact K := by
      rw [Subtype.isCompact_iff, hKimg]; exact hDc
    have hKcl : IsClosed K := hKc.isClosed
    have hp' : (⟨p, hpV, hpY⟩ : ↥(V ∩ Y)) ∈ closure K := by
      rw [mem_closure_iff]
      intro o ho hpo
      obtain ⟨O, hO, hOo⟩ := isOpen_induced_iff.mp ho
      subst hOo
      obtain ⟨z, hzO, hzD, hzY⟩ := mem_closure_iff.mp hpcl O hO hpo
      exact ⟨⟨z, hDV hzD, hzY⟩, hzO, hzD⟩
    rw [hKcl.closure_eq] at hp'
    exact hp'

  have s2 : ∀ D : Set X, IsOpen D → (T ∩ D).Nonempty →
      (∀ s ∈ T, s ∈ closure (D ∩ T) → s ∈ D) → T ⊆ D := by
    intro D hD hne hcl x hxT
    by_contra hxD
    have hv : IsOpen (closure (D ∩ T))ᶜ := isClosed_closure.isOpen_compl
    have hcover : T ⊆ D ∪ (closure (D ∩ T))ᶜ := by
      intro s hs
      by_cases h : s ∈ closure (D ∩ T)
      · exact Or.inl (hcl s hs h)
      · exact Or.inr h
    obtain ⟨y, hyT, hyD, hyv⟩ :=
      hTp D _ hD hv hcover hne ⟨x, hxT, fun h => hxD (hcl x hxT h)⟩
    exact hyv (subset_closure ⟨hyD, hyT⟩)

  have s4 : ∀ V : Set X, T ⊆ V → T2Space ↥(V ∩ Y) →
      (∀ y ∈ V ∩ Y, ∀ U : Set X, IsOpen U → y ∈ U →
        ∃ D : Set X, IsOpen D ∧ y ∈ D ∧ D ⊆ U ∩ V ∧ IsCompact (D ∩ Y)) → T.Subsingleton := by
    intro V hTV hT2 hB b hb c hc
    haveI := hT2
    by_contra hbc
    have hne : (⟨b, hTV hb, hTY hb⟩ : ↥(V ∩ Y)) ≠ ⟨c, hTV hc, hTY hc⟩ := by
      intro h; exact hbc (congrArg Subtype.val h)
    obtain ⟨u, w, hu, hw, hbu, hcw, huw⟩ := t2_separation hne
    obtain ⟨U, hU, hUu⟩ := isOpen_induced_iff.mp hu
    subst hUu
    have hcU : c ∉ U := by
      intro hcU
      exact Set.disjoint_left.mp huw
        (show (⟨c, hTV hc, hTY hc⟩ : ↥(V ∩ Y)) ∈ Subtype.val ⁻¹' U from hcU) hcw
    obtain ⟨D', hD'o, hbD', hD'UV, hD'c⟩ := hB b ⟨hTV hb, hTY hb⟩ U hU hbu
    have hsub : T ⊆ D' := s2 D' hD'o ⟨b, hb, hbD'⟩ (fun s hs hscl =>
      s1 V D' hT2 (fun z hz => (hD'UV hz).2) hD'c s (hTV hs) (hTY hs)
        (closure_mono (Set.inter_subset_inter_right _ hTY) hscl))
    exact hcU (hD'UV (hsub hc)).1

  intro b hb c hc
  choose Vf hVo hxV hT2 hB using hloc
  have hcov : T ⊆ ⋃ i : ↥T, Vf i.1 i.2 := fun x hx =>
    Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hxV x hx⟩
  obtain ⟨t, ht⟩ := hTc.elim_finite_subcover (fun i : ↥T => Vf i.1 i.2)
    (fun i => hVo i.1 i.2) hcov
  have hmem : ∀ x ∈ T, ∃ i ∈ t, x ∈ Vf i.1 i.2 := by
    intro x hx
    have := ht hx
    simp only [Set.mem_iUnion] at this
    obtain ⟨i, hi, h⟩ := this
    exact ⟨i, hi, h⟩
  let I : X → Finset ↥T := fun x => t.filter (fun i => x ∈ Vf i.1 i.2)
  obtain ⟨a, haT, hamax⟩ : ∃ a ∈ T, ∀ x ∈ T, (I x).card ≤ (I a).card := by
    have hfin : (I '' T).Finite := (t.powerset.finite_toSet).subset (by
      rintro _ ⟨x, _, rfl⟩
      exact Finset.mem_coe.mpr (Finset.mem_powerset.mpr (Finset.filter_subset _ _)))
    obtain ⟨J, ⟨a, haT, rfl⟩, hJ⟩ :=
      Set.exists_max_image (I '' T) Finset.card hfin ⟨I b, b, hb, rfl⟩
    exact ⟨a, haT, fun x hx => hJ (I x) ⟨x, hx, rfl⟩⟩
  have hmaxeq : ∀ x ∈ T, I a ⊆ I x → I x = I a := fun x hx hsub =>
    (Finset.eq_of_subset_of_card_le hsub (hamax x hx)).symm
  obtain ⟨i₀, _, hai₀⟩ := hmem a haT
  let W : Set X := ⋂ i ∈ I a, Vf i.1 i.2
  have hWo : IsOpen W := isOpen_biInter_finset (fun i _ => hVo i.1 i.2)
  have hW : ∀ z ∈ W, ∀ i ∈ I a, z ∈ Vf i.1 i.2 := by
    intro z hz i hi
    simp only [W, Set.mem_iInter] at hz
    exact hz i hi
  have haW : a ∈ W := by
    simp only [W, Set.mem_iInter]
    intro i hi
    exact (Finset.mem_filter.mp hi).2
  obtain ⟨D, hDo, haD, hDWV, hDc⟩ := hB i₀.1 i₀.2 a ⟨hai₀, hTY haT⟩ W hWo haW
  have hrel : ∀ s ∈ T, s ∈ closure (D ∩ T) → s ∈ D := by
    intro s hs hscl
    obtain ⟨j, hjt, hsj⟩ := hmem s hs
    obtain ⟨x, hxj, hxD, hxT⟩ := mem_closure_iff.mp hscl _ (hVo j.1 j.2) hsj
    have hxW : x ∈ W := (hDWV hxD).1
    have hsubI : I a ⊆ I x := by
      intro i hi
      exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hi).1, hW x hxW i hi⟩
    have hjx : j ∈ I x := Finset.mem_filter.mpr ⟨hjt, hxj⟩
    rw [hmaxeq x hxT hsubI] at hjx
    have hDj : D ⊆ Vf j.1 j.2 := fun z hz => hW z (hDWV hz).1 j hjx
    exact s1 _ D (hT2 j.1 j.2) hDj hDc s hsj (hTY hs)
      (closure_mono (Set.inter_subset_inter_right _ hTY) hscl)
  have hTD : T ⊆ D := s2 D hDo ⟨a, haT, haD⟩ hrel
  have hTV : T ⊆ Vf i₀.1 i₀.2 := fun z hz => (hDWV (hTD hz)).2
  exact s4 _ hTV (hT2 i₀.1 i₀.2) (hB i₀.1 i₀.2) hb hc

theorem wc_weaklyEtale_fibre_local_charts {X : Scheme.{u}} (A : Type u) [CommRing A]
    (f : X ⟶ Spec (.of A)) [WeaklyEtale f] (p : PrimeSpectrum A)
    (hvnr : ∀ (R : Type u) [CommRing R] [Algebra A R], Algebra.WeaklyEtale A R →
      ∀ x : p.asIdeal.Fiber R, ∃ t : p.asIdeal.Fiber R, x * x * t = x)
    (x : X) (hx : f x = p) :
    ∃ V : Set X, IsOpen V ∧ x ∈ V ∧ T2Space ↥(V ∩ (⇑f) ⁻¹' {p}) ∧
      ∀ y ∈ V ∩ (⇑f) ⁻¹' {p}, ∀ U : Set X, IsOpen U → y ∈ U →
        ∃ D : Set X, IsOpen D ∧ y ∈ D ∧ D ⊆ U ∩ V ∧ IsCompact (D ∩ (⇑f) ⁻¹' {p}) :=
by
  classical

  have s2 : ∀ (B : Type u) [CommRing B], (∀ z : B, ∃ t : B, z * z * t = z) →
      T2Space (PrimeSpectrum B) := by
    intro B _ hv
    have sep : ∀ P Q : PrimeSpectrum B, ∀ z : B, z ∈ P.asIdeal → z ∉ Q.asIdeal →
        ∃ u v : Set (PrimeSpectrum B), IsOpen u ∧ IsOpen v ∧ P ∈ u ∧ Q ∈ v ∧ Disjoint u v := by
      intro P Q z hzP hzQ
      obtain ⟨t, ht⟩ := hv z
      refine ⟨(PrimeSpectrum.basicOpen (1 - z * t) : Set (PrimeSpectrum B)),
        (PrimeSpectrum.basicOpen (z * t) : Set (PrimeSpectrum B)),
        PrimeSpectrum.isOpen_basicOpen, PrimeSpectrum.isOpen_basicOpen, ?_, ?_, ?_⟩
      · simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        intro h1
        have h2 : z * t ∈ P.asIdeal := P.asIdeal.mul_mem_right t hzP
        have h3 : (1 - z * t) + z * t ∈ P.asIdeal := P.asIdeal.add_mem h1 h2
        rw [sub_add_cancel] at h3
        exact P.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h3)
      · simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        intro h1
        apply hzQ
        have h2 : z * (z * t) ∈ Q.asIdeal := Q.asIdeal.mul_mem_left z h1
        rwa [← mul_assoc, ht] at h2
      · rw [Set.disjoint_left]
        intro q hq1 hq2
        simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hq1 hq2
        have h0 : (1 - z * t) * (z * t) = 0 := by linear_combination (-t) * ht
        have h4 : (1 - z * t) * (z * t) ∈ q.asIdeal := by rw [h0]; exact q.asIdeal.zero_mem
        rcases q.isPrime.mem_or_mem h4 with h | h
        · exact hq1 h
        · exact hq2 h
    refine ⟨fun P Q hPQ => ?_⟩
    by_cases hle : P.asIdeal ≤ Q.asIdeal
    · have hnle : ¬ Q.asIdeal ≤ P.asIdeal := fun h =>
        hPQ (PrimeSpectrum.ext (le_antisymm hle h))
      obtain ⟨z, hzQ, hzP⟩ := SetLike.not_le_iff_exists.mp hnle
      obtain ⟨u, v, hu, hv', hQu, hPv, huv⟩ := sep Q P z hzQ hzP
      exact ⟨v, u, hv', hu, hPv, hQu, huv.symm⟩
    · obtain ⟨z, hzP, hzQ⟩ := SetLike.not_le_iff_exists.mp hle
      exact sep P Q z hzP hzQ

  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) (by simp)
  set ι := hW.fromSpec with hι
  set ρ : A →+* Γ(X, W) := (Spec.preimage (ι ≫ f)).hom with hρ
  have hspec : Spec.map (CommRingCat.ofHom ρ) = ι ≫ f := by
    rw [hρ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hWE' : WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)) := by
    rw [hspec]; infer_instance
  set e : PrimeSpectrum Γ(X, W) → X := fun P => ι P with he_def
  have he : Topology.IsOpenEmbedding e := ι.isOpenEmbedding
  have hxe : x ∈ Set.range e := by
    have : x ∈ Set.range ι := by rw [hW.range_fromSpec]; exact hxW
    exact this
  have hfe : ∀ P : PrimeSpectrum Γ(X, W), f (e P) = PrimeSpectrum.comap ρ P := by
    intro P
    have h1 := Scheme.Hom.comp_apply ι f P
    have h2 := Spec.map_apply (CommRingCat.ofHom ρ) P
    rw [hspec] at h2
    exact h1.symm.trans h2
  letI : Algebra A Γ(X, W) := ρ.toAlgebra

  have hAlg : Algebra.WeaklyEtale A Γ(X, W) := by
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A Γ(X, W)))) := hWE'
    have hf : Module.Flat A Γ(X, W) := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := Γ(X, W)) A).toRingHom)) := by
      have e0 : Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' (S := Γ(X, W)) A).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := Γ(X, W)) A).toRingHom) ≫
            (pullbackSpecIso A Γ(X, W) Γ(X, W)).inv) ≫ (pullbackSpecIso A Γ(X, W) Γ(X, W)).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e0]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
  have hT2F : T2Space (PrimeSpectrum (p.asIdeal.Fiber Γ(X, W))) := s2 _ (hvnr Γ(X, W) hAlg)
  set Hm := PrimeSpectrum.preimageHomeomorphFiber A Γ(X, W) p with hHm

  have hmemF : ∀ s : PrimeSpectrum Γ(X, W),
      s ∈ PrimeSpectrum.comap (algebraMap A Γ(X, W)) ⁻¹' {p} ↔ f (e s) = p := by
    intro s
    rw [hfe]
    rfl

  have s3 : ∀ r : Γ(X, W), IsCompact (PrimeSpectrum.comap (algebraMap A Γ(X, W)) ⁻¹' {p} ∩
      (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum Γ(X, W)))) := by
    intro r
    have key : ∀ Q : PrimeSpectrum (p.asIdeal.Fiber Γ(X, W)),
        r ∈ ((Hm.symm Q).1.asIdeal) ↔ Algebra.TensorProduct.includeRight r ∈ Q.asIdeal := by
      intro Q
      rw [← SetLike.mem_coe, hHm,
        PrimeSpectrum.coe_preimageHomeomorphFiber_symm_apply_coe_asIdeal]
      rfl
    have hK : IsCompact ((fun Q => (Hm.symm Q).1) ''
        (PrimeSpectrum.basicOpen (Algebra.TensorProduct.includeRight r :
          p.asIdeal.Fiber Γ(X, W)) : Set (PrimeSpectrum (p.asIdeal.Fiber Γ(X, W))))) :=
      (PrimeSpectrum.isCompact_basicOpen _).image
        (continuous_subtype_val.comp Hm.symm.continuous)
    convert hK using 1
    ext z
    constructor
    · rintro ⟨hzF, hzr⟩
      refine ⟨Hm ⟨z, hzF⟩, ?_, ?_⟩
      · simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hzr ⊢
        rw [← key, Homeomorph.symm_apply_apply]
        exact hzr
      · simp only [Homeomorph.symm_apply_apply]
    · rintro ⟨Q, hQ, rfl⟩
      refine ⟨(Hm.symm Q).2, ?_⟩
      simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hQ ⊢
      rw [key]
      exact hQ
  refine ⟨Set.range e, he.isOpen_range, hxe, ?_, ?_⟩
  ·
    let g0 : ↥(Set.range e ∩ (⇑f) ⁻¹' {p}) → PrimeSpectrum Γ(X, W) :=
      fun y => Classical.choose y.2.1
    have hg0 : ∀ y, e (g0 y) = y.1 := fun y => Classical.choose_spec y.2.1
    have hg0F : ∀ y, g0 y ∈ PrimeSpectrum.comap (algebraMap A Γ(X, W)) ⁻¹' {p} := by
      intro y
      rw [hmemF, hg0]
      exact y.2.2
    have hg0c : Continuous g0 := by
      rw [he.toIsEmbedding.toIsInducing.continuous_iff]
      have h1 : e ∘ g0 = Subtype.val := funext hg0
      rw [h1]
      exact continuous_subtype_val
    let g1 : ↥(Set.range e ∩ (⇑f) ⁻¹' {p}) → PrimeSpectrum (p.asIdeal.Fiber Γ(X, W)) :=
      fun y => Hm ⟨g0 y, hg0F y⟩
    have hg1c : Continuous g1 := Hm.continuous.comp (hg0c.subtype_mk _)
    have hg1i : Function.Injective g1 := by
      intro y1 y2 h12
      have h3 : g0 y1 = g0 y2 := congrArg Subtype.val (Hm.injective h12)
      apply Subtype.ext
      rw [← hg0 y1, ← hg0 y2, h3]
    exact T2Space.of_injective_continuous hg1i hg1c
  ·
    rintro y ⟨⟨s, rfl⟩, hy⟩ U hU hsU
    have hO : IsOpen (e ⁻¹' U) := hU.preimage he.continuous
    obtain ⟨v, ⟨r, rfl⟩, hsv, hvO⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
        (show s ∈ e ⁻¹' U from hsU) hO
    refine ⟨e '' (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum Γ(X, W))),
      he.isOpenMap _ PrimeSpectrum.isOpen_basicOpen, ⟨s, hsv, rfl⟩, ?_, ?_⟩
    · rintro _ ⟨a, ha, rfl⟩
      exact ⟨hvO ha, a, rfl⟩
    · have hset : e '' (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum Γ(X, W))) ∩ (⇑f) ⁻¹' {p} =
          e '' (PrimeSpectrum.comap (algebraMap A Γ(X, W)) ⁻¹' {p} ∩
            (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum Γ(X, W)))) := by
        ext z
        constructor
        · rintro ⟨⟨a, ha, rfl⟩, hz⟩
          exact ⟨a, ⟨(hmemF a).mpr hz, ha⟩, rfl⟩
        · rintro ⟨a, ⟨haF, ha⟩, rfl⟩
          exact ⟨⟨a, ha, rfl⟩, (hmemF a).mp haF⟩
      rw [hset]
      exact (s3 r).image he.continuous

theorem wc_whlzfc_image_preconnected (A : Type u) [CommRing A] (n : ℕ)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (C : Fin n → Fin n → Type u) [∀ k l, CommRing (C k l)] [∀ k l, Algebra A (C k l)]
    (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l)
    {X : Scheme.{u}} (g : ∀ k, Spec (.of (H k)) ⟶ X)
    (hg : ∀ k l, Spec.map (CommRingCat.ofHom (φ k l).toRingHom) ≫ g k =
      Spec.map (CommRingCat.ofHom (ψ k l).toRingHom) ≫ g l)
    (p : PrimeSpectrum A)
    (hidem : ∀ e : ∀ k, p.asIdeal.Fiber (H k), (∀ k, IsIdempotentElem (e k)) →
      (∀ k l, Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l) (e k) =
        Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l) (e l)) →
      (∀ k, e k = 0) ∨ (∀ k, e k = 1)) :
    _root_.IsPreconnected (⋃ k, (fun P : PrimeSpectrum (H k) => g k P) ''
      (PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' {p})) :=
by
  classical

  have L1a : ∀ (R : Type u) [CommRing R] [Algebra A R] (q : PrimeSpectrum (p.asIdeal.Fiber R)),
      PrimeSpectrum.comap (algebraMap A R)
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeRight : R →ₐ[A] p.asIdeal.Fiber R).toRingHom q) = p := by
    intro R _ _ q
    have h := ((PrimeSpectrum.preimageEquivFiber A R p).symm q).2
    rw [PrimeSpectrum.preimageEquivFiber_symm_apply_coe] at h
    exact h

  have L1b : ∀ (R : Type u) [CommRing R] [Algebra A R] (P : PrimeSpectrum R),
      PrimeSpectrum.comap (algebraMap A R) P = p → ∃ q : PrimeSpectrum (p.asIdeal.Fiber R),
        PrimeSpectrum.comap
          (Algebra.TensorProduct.includeRight : R →ₐ[A] p.asIdeal.Fiber R).toRingHom q = P := by
    intro R _ _ P hP
    refine ⟨PrimeSpectrum.preimageEquivFiber A R p ⟨P, hP⟩, ?_⟩
    rw [← PrimeSpectrum.preimageEquivFiber_symm_apply_coe, Equiv.symm_apply_apply]

  have L2 : ∀ (R : Type u) [CommRing R] (γ : PrimeSpectrum R → X), Continuous γ →
      ∀ (U V : Set X), IsOpen U → IsOpen V → (∀ q, γ q ∈ U ∪ V) → (∀ q, γ q ∈ U → γ q ∉ V) →
      ∃ e : R, IsIdempotentElem e ∧ ∀ q : PrimeSpectrum R, e ∉ q.asIdeal ↔ γ q ∈ U := by
    intro R _ γ hγ U V hU hV hcov hdisj
    have hS : IsClopen (γ ⁻¹' U) := by
      refine ⟨?_, hU.preimage hγ⟩
      have hc : γ ⁻¹' U = (γ ⁻¹' V)ᶜ := by
        ext q
        simp only [Set.mem_preimage, Set.mem_compl_iff]
        constructor
        · exact hdisj q
        · intro h
          rcases hcov q with h' | h'
          · exact h'
          · exact absurd h' h
      rw [hc]
      exact (hV.preimage hγ).isClosed_compl
    obtain ⟨e, ⟨he, hSe⟩, -⟩ := PrimeSpectrum.existsUnique_idempotent_basicOpen_eq_of_isClopen hS
    refine ⟨e, he, fun q => ?_⟩
    rw [← PrimeSpectrum.mem_basicOpen]
    change q ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum R)) ↔ _
    rw [← hSe]
    rfl

  have L3 : ∀ k l (r : PrimeSpectrum (p.asIdeal.Fiber (C k l))),
      g k (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : H k →ₐ[A] p.asIdeal.Fiber (H k)).toRingHom
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l)).toRingHom r)) =
      g l (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : H l →ₐ[A] p.asIdeal.Fiber (H l)).toRingHom
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l)).toRingHom r)) := by
    intro k l r
    set c := PrimeSpectrum.comap
      (Algebra.TensorProduct.includeRight : C k l →ₐ[A] p.asIdeal.Fiber (C k l)).toRingHom r with hc
    have e1 : PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : H k →ₐ[A] p.asIdeal.Fiber (H k)).toRingHom
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l)).toRingHom r) =
        PrimeSpectrum.comap (φ k l).toRingHom c := by
      rw [hc, ← PrimeSpectrum.comap_comp_apply, ← PrimeSpectrum.comap_comp_apply]
      congr 1
    have e2 : PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : H l →ₐ[A] p.asIdeal.Fiber (H l)).toRingHom
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l)).toRingHom r) =
        PrimeSpectrum.comap (ψ k l).toRingHom c := by
      rw [hc, ← PrimeSpectrum.comap_comp_apply, ← PrimeSpectrum.comap_comp_apply]
      congr 1
    rw [e1, e2]
    have h := congrArg (fun m : Spec (.of (C k l)) ⟶ X => m c) (hg k l)
    simp only at h
    exact h

  rw [isPreconnected_iff_subset_of_disjoint]
  intro U V hU hV hTUV hT0
  let γ : ∀ k, PrimeSpectrum (p.asIdeal.Fiber (H k)) → X := fun k q =>
    g k (PrimeSpectrum.comap
      (Algebra.TensorProduct.includeRight : H k →ₐ[A] p.asIdeal.Fiber (H k)).toRingHom q)
  have hγc : ∀ k, Continuous (γ k) := fun k =>
    (g k).continuous.comp (PrimeSpectrum.continuous_comap _)
  have hγT : ∀ k q, γ k q ∈ ⋃ k, (fun P : PrimeSpectrum (H k) => g k P) ''
      (PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' {p}) := fun k q =>
    Set.mem_iUnion.2 ⟨k, _, L1a (H k) q, rfl⟩
  have hcov : ∀ k q, γ k q ∈ U ∪ V := fun k q => hTUV (hγT k q)
  have hdisj : ∀ k q, γ k q ∈ U → γ k q ∉ V := by
    intro k q hu hv
    have hmem : γ k q ∈ (⋃ k, (fun P : PrimeSpectrum (H k) => g k P) ''
      (PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' {p})) ∩ (U ∩ V) := ⟨hγT k q, hu, hv⟩
    rw [hT0] at hmem
    exact hmem
  choose e he hspec using fun k => L2 _ (γ k) (hγc k) U V hU hV (hcov k) (hdisj k)
  have hcompat : ∀ k l,
      Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l) (e k) =
        Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l) (e l) := by
    intro k l
    apply PrimeSpectrum.basicOpen_injOn_isIdempotentElem ((he k).map _) ((he l).map _)
    apply TopologicalSpace.Opens.ext
    ext r
    change r ∈ PrimeSpectrum.basicOpen _ ↔ r ∈ PrimeSpectrum.basicOpen _
    rw [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.mem_basicOpen]
    have h1 := hspec k (PrimeSpectrum.comap
      (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l)).toRingHom r)
    have h2 := hspec l (PrimeSpectrum.comap
      (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l)).toRingHom r)
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at h1 h2
    change (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l)).toRingHom
        (e k) ∉ r.asIdeal ↔
      (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l)).toRingHom
        (e l) ∉ r.asIdeal
    rw [h1, h2]
    have h3 : γ k (PrimeSpectrum.comap
        (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l)).toRingHom r) =
      γ l (PrimeSpectrum.comap
        (Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l)).toRingHom r) :=
      L3 k l r
    rw [h3]
  rcases hidem e he hcompat with h0 | h1
  · right
    intro x hx
    rw [Set.mem_iUnion] at hx
    obtain ⟨k, P, hP, rfl⟩ := hx
    obtain ⟨q, rfl⟩ := L1b (H k) P hP
    have hnot : γ k q ∉ U := fun hu =>
      ((hspec k q).2 hu) (by rw [h0 k]; exact Ideal.zero_mem _)
    rcases hcov k q with h | h
    · exact absurd h hnot
    · exact h
  · left
    intro x hx
    rw [Set.mem_iUnion] at hx
    obtain ⟨k, P, hP, rfl⟩ := hx
    obtain ⟨q, rfl⟩ := L1b (H k) P hP
    exact (hspec k q).1 (by
      rw [h1 k]
      exact fun h => q.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h))

theorem wc_fibre_tensor_localization (A H : Type u) [CommRing A] [CommRing H] [Algebra A H]
    (p : Ideal A) [p.IsPrime] :
    (∀ x : p.Fiber H, ∃ (h : H) (s : A), s ∉ p ∧
        algebraMap A (p.Fiber H) s * x = (1 : p.ResidueField) ⊗ₜ[A] h) ∧
    (∀ h : H, (1 : p.ResidueField) ⊗ₜ[A] h = (0 : p.Fiber H) →
        ∃ s : A, s ∉ p ∧ algebraMap A H s * h ∈ p.map (algebraMap A H)) ∧
    (∀ s : A, s ∉ p → IsUnit (algebraMap A (p.Fiber H) s)) ∧
    (∀ h ∈ p.map (algebraMap A H), (1 : p.ResidueField) ⊗ₜ[A] h = (0 : p.Fiber H)) :=
by
  classical
  have hres : ∀ a : A, algebraMap A (p.Fiber H) a =
      algebraMap p.ResidueField (p.Fiber H) (algebraMap A p.ResidueField a) :=
    fun a => IsScalarTower.algebraMap_apply A p.ResidueField (p.Fiber H) a
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro x
    obtain ⟨r, hr, h, hrx⟩ := Ideal.Fiber.exists_smul_eq_one_tmul p x
    exact ⟨h, r, hr, (Algebra.smul_def r x).symm.trans hrx⟩
  · intro h hh
    set pH := p.map (algebraMap A H) with hpH
    let Q := H ⧸ pH
    let M : Submonoid Q := Algebra.algebraMapSubmonoid Q p.primeCompl
    let L := Localization M
    have hQ : ∀ a : A, algebraMap A Q a = Ideal.Quotient.mk pH (algebraMap A H a) :=
      fun a => rfl
    let g : H →ₐ[A] L := (IsScalarTower.toAlgHom A Q L).comp (Ideal.Quotient.mkₐ A pH)
    have h₁ : p ≤ RingHom.ker (Algebra.ofId A L) := by
      intro a ha
      rw [RingHom.mem_ker, Algebra.ofId_apply, IsScalarTower.algebraMap_apply A Q L, hQ,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha), map_zero]
    have h₂ : p.primeCompl ≤ Submonoid.comap (Algebra.ofId A L) (IsUnit.submonoid L) := by
      intro s hs
      show IsUnit (Algebra.ofId A L s)
      rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply A Q L]
      exact IsLocalization.map_units L
        (⟨algebraMap A Q s, Algebra.mem_algebraMapSubmonoid_of_mem (⟨s, hs⟩ : p.primeCompl)⟩ : M)
    let f : p.ResidueField →ₐ[A] L := Ideal.ResidueField.liftₐ p (Algebra.ofId A L) h₁ h₂
    let Φ : p.Fiber H →ₐ[A] L :=
      Algebra.TensorProduct.lift f g (fun _ _ => Commute.all _ _)
    have hΦ : Φ ((1 : p.ResidueField) ⊗ₜ[A] h) = algebraMap Q L (Ideal.Quotient.mk pH h) := by
      simp only [Φ, Algebra.TensorProduct.lift_tmul, map_one, one_mul, g, AlgHom.comp_apply,
        IsScalarTower.toAlgHom_apply]
      rfl
    have h0 : algebraMap Q L (Ideal.Quotient.mk pH h) = 0 := by
      rw [← hΦ]
      have : ((1 : p.ResidueField) ⊗ₜ[A] h : p.Fiber H) = 0 := hh
      rw [this, map_zero]
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M L _).mp h0
    obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp m.2
    refine ⟨s, hs, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, ← hQ, hsm]
    exact hm
  · intro s hs
    rw [hres]
    refine IsUnit.map (algebraMap p.ResidueField (p.Fiber H)) ?_
    exact isUnit_iff_ne_zero.mpr (fun h0 => hs (Ideal.algebraMap_residueField_eq_zero.mp h0))
  · intro h hh
    let incR : H →ₐ[A] p.Fiber H := Algebra.TensorProduct.includeRight
    have hle : p.map (algebraMap A H) ≤ RingHom.ker (incR : H →+* p.Fiber H) := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show incR (algebraMap A H a) = 0
      rw [AlgHom.commutes, hres, Ideal.algebraMap_residueField_eq_zero.mpr ha, map_zero]
    have := hle hh
    rw [RingHom.mem_ker] at this
    exact this

theorem wc_whlzfc_idempotent_constancy (A : Type u) [CommRing A] (n : ℕ)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (C : Fin n → Fin n → Type u) [∀ k l, CommRing (C k l)] [∀ k l, Algebra A (C k l)]
    (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l)
    (p : PrimeSpectrum A)
    (hloc : ∀ (R : Type u) [CommRing R] [Algebra A R],
      (∀ x : p.asIdeal.Fiber R, ∃ (h : R) (s : A), s ∉ p.asIdeal ∧
          algebraMap A (p.asIdeal.Fiber R) s * x = (1 : p.asIdeal.ResidueField) ⊗ₜ[A] h) ∧
      (∀ h : R, (1 : p.asIdeal.ResidueField) ⊗ₜ[A] h = (0 : p.asIdeal.Fiber R) →
          ∃ s : A, s ∉ p.asIdeal ∧ algebraMap A R s * h ∈ p.asIdeal.map (algebraMap A R)) ∧
      (∀ s : A, s ∉ p.asIdeal → IsUnit (algebraMap A (p.asIdeal.Fiber R) s)) ∧
      (∀ h ∈ p.asIdeal.map (algebraMap A R),
          (1 : p.asIdeal.ResidueField) ⊗ₜ[A] h = (0 : p.asIdeal.Fiber R)))
    (hdescp : ∀ h : ∀ k, H k,
      (∀ k l, φ k l (h k) - ψ k l (h l) ∈ p.asIdeal.map (algebraMap A (C k l))) →
      ∃ y : A, ∀ k, algebraMap A (H k) y - h k ∈ p.asIdeal.map (algebraMap A (H k))) :
    ∀ e : ∀ k, p.asIdeal.Fiber (H k), (∀ k, IsIdempotentElem (e k)) →
      (∀ k l, Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l) (e k) =
        Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l) (e l)) →
      (∀ k, e k = 0) ∨ (∀ k, e k = 1) :=
by
  classical
  intro e he hcompat

  have star : ∀ (R : Type u) [CommRing R] [Algebra A R] (c : A),
      algebraMap A (p.asIdeal.Fiber R) c =
        (1 : p.asIdeal.ResidueField) ⊗ₜ[A] algebraMap A R c :=
    fun R _ _ c => Algebra.TensorProduct.algebraMap_apply' c
  have star2 : ∀ (R : Type u) [CommRing R] [Algebra A R] (c : A) (h : R),
      algebraMap A (p.asIdeal.Fiber R) c * ((1 : p.asIdeal.ResidueField) ⊗ₜ[A] h) =
        (1 : p.asIdeal.ResidueField) ⊗ₜ[A] (algebraMap A R c * h) := by
    intro R _ _ c h
    rw [star R c, Algebra.TensorProduct.tmul_mul_tmul, one_mul]

  choose h₀ s₀ hs₀ he₀ using fun k => (hloc (H k)).1 (e k)

  obtain ⟨s, hs_def⟩ : ∃ s : A, s = ∏ k, s₀ k := ⟨_, rfl⟩
  have hs : s ∉ p.asIdeal := by
    rw [hs_def, Ideal.IsPrime.prod_mem_iff]
    rintro ⟨k, _, hk⟩
    exact hs₀ k hk
  have hdvd : ∀ k, ∃ c : A, s = s₀ k * c := fun k => by
    rw [hs_def]; exact Finset.dvd_prod_of_mem s₀ (Finset.mem_univ k)
  choose c hc using hdvd
  have E1' : ∀ k, ∃ h : H k, algebraMap A (p.asIdeal.Fiber (H k)) s * e k =
      (1 : p.asIdeal.ResidueField) ⊗ₜ[A] h := by
    intro k
    refine ⟨algebraMap A (H k) (c k) * h₀ k, ?_⟩
    rw [hc k, map_mul, mul_comm (algebraMap A (p.asIdeal.Fiber (H k)) (s₀ k)), mul_assoc,
      he₀ k, star2]
  choose h' E1 using E1'

  have E3 : ∀ k l, (1 : p.asIdeal.ResidueField) ⊗ₜ[A] (φ k l (h' k) - ψ k l (h' l)) =
      (0 : p.asIdeal.Fiber (C k l)) := by
    intro k l
    have a1 : Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (φ k l)
        ((1 : p.asIdeal.ResidueField) ⊗ₜ[A] h' k) =
        (1 : p.asIdeal.ResidueField) ⊗ₜ[A] φ k l (h' k) := by
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    have a2 : Algebra.TensorProduct.map (AlgHom.id A p.asIdeal.ResidueField) (ψ k l)
        ((1 : p.asIdeal.ResidueField) ⊗ₜ[A] h' l) =
        (1 : p.asIdeal.ResidueField) ⊗ₜ[A] ψ k l (h' l) := by
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    rw [TensorProduct.tmul_sub, ← a1, ← a2, ← E1 k, ← E1 l, map_mul, map_mul,
      AlgHom.commutes, AlgHom.commutes, hcompat k l, sub_self]
  choose t₀ ht₀ ht₀' using fun k l => (hloc (C k l)).2.1 _ (E3 k l)

  obtain ⟨t, ht_def⟩ : ∃ t : A, t = ∏ q : Fin n × Fin n, t₀ q.1 q.2 := ⟨_, rfl⟩
  have ht : t ∉ p.asIdeal := by
    rw [ht_def, Ideal.IsPrime.prod_mem_iff]
    rintro ⟨q, _, hq⟩
    exact ht₀ q.1 q.2 hq
  have hdvd' : ∀ k l, ∃ c' : A, t = t₀ k l * c' := fun k l => by
    rw [ht_def]
    exact Finset.dvd_prod_of_mem (fun q : Fin n × Fin n => t₀ q.1 q.2) (Finset.mem_univ (k, l))
  choose c' hc' using hdvd'
  have hdes : ∀ k l, φ k l (algebraMap A (H k) t * h' k) - ψ k l (algebraMap A (H l) t * h' l) ∈
      p.asIdeal.map (algebraMap A (C k l)) := by
    intro k l
    rw [map_mul, map_mul, AlgHom.commutes, AlgHom.commutes, ← mul_sub, hc' k l, map_mul,
      mul_comm (algebraMap A (C k l) (t₀ k l)), mul_assoc]
    exact Ideal.mul_mem_left _ _ (ht₀' k l)

  obtain ⟨y, hy⟩ : ∃ y : A, ∀ k, algebraMap A (H k) y - algebraMap A (H k) t * h' k ∈
      p.asIdeal.map (algebraMap A (H k)) := hdescp _ hdes
  have E2 : ∀ k, algebraMap A (p.asIdeal.Fiber (H k)) y =
      algebraMap A (p.asIdeal.Fiber (H k)) (t * s) * e k := by
    intro k
    have h1 := (hloc (H k)).2.2.2 _ (hy k)
    rw [TensorProduct.tmul_sub, sub_eq_zero] at h1
    rw [star (H k) y, h1, map_mul, mul_assoc, E1 k, star2]
  have hts : t * s ∉ p.asIdeal := fun h => (p.isPrime.mem_or_mem h).elim ht hs

  by_cases hyp : y ∈ p.asIdeal
  · left
    intro k
    have hz : algebraMap A (p.asIdeal.Fiber (H k)) y = 0 := by
      rw [star (H k) y]
      exact (hloc (H k)).2.2.2 _ (Ideal.mem_map_of_mem _ hyp)
    have hu := (hloc (H k)).2.2.1 (t * s) hts
    rw [E2 k] at hz
    exact hu.mul_right_eq_zero.mp hz
  · right
    intro k
    have hu := (hloc (H k)).2.2.1 y hyp
    rw [E2 k] at hu
    have hek : IsUnit (e k) := isUnit_of_mul_isUnit_right hu
    exact (IsIdempotentElem.iff_eq_one_of_isUnit hek).mp (he k)

theorem wc_whlzfc_thickening_mod_prime (A : Type u) [CommRing A] (I p : Ideal A) (s : A)
    (t : A ⧸ p) (ht : Ideal.Quotient.mk p s = t)
    (H : Type u) [CommRing H] [Algebra A H] (hHwe : Algebra.WeaklyEtale A H)
    (hHhen : HenselianRing H (I.map (algebraMap A H)))
    (θ : (H ⧸ I.map (algebraMap A H)) ≃+* Localization.Away (Ideal.Quotient.mk I s))
    (hθ : θ.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H)) (algebraMap A H)
        Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s)))
    (hhens : ∀ (R : Type u) [CommRing R] (I' : Ideal R) [HenselianRing R I'] (J : Ideal R),
      HenselianRing (R ⧸ J) (I'.map (Ideal.Quotient.mk J))) :
    Algebra.WeaklyEtale (A ⧸ p) (H ⧸ p.map (algebraMap A H)) ∧
    HenselianRing (H ⧸ p.map (algebraMap A H))
      ((I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H)))) ∧
    ∃ θ' : ((H ⧸ p.map (algebraMap A H)) ⧸
        (I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H)))) ≃+*
        Localization.Away (Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) t),
      θ'.toRingHom.comp (Ideal.quotientMap
          ((I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H))))
          (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H))) Ideal.le_comap_map) =
        algebraMap ((A ⧸ p) ⧸ I.map (Ideal.Quotient.mk p))
          (Localization.Away (Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) t)) :=
by
  classical

  have hcompA : (Ideal.Quotient.mk (p.map (algebraMap A H))).comp (algebraMap A H) =
      (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H))).comp (Ideal.Quotient.mk p) :=
    RingHom.ext fun a => (Ideal.Quotient.algebraMap_quotient_map_quotient a).symm
  have hJ : (I.map (algebraMap A H)).map (Ideal.Quotient.mk (p.map (algebraMap A H))) =
      (I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H))) := by
    rw [Ideal.map_map, Ideal.map_map, hcompA]

  have transport : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S]
      [Algebra R T] (e : S ≃ₐ[R] T), Algebra.WeaklyEtale R S → Algebra.WeaklyEtale R T := by
    intro R S T _ _ _ _ _ e hS
    haveI : Module.Flat R S := hS.flat
    refine Algebra.WeaklyEtale.mk (Module.Flat.of_linearEquiv e.symm.toLinearEquiv) ?_
    let E : TensorProduct R T T ≃ₐ[R] TensorProduct R S S :=
      Algebra.TensorProduct.congr e.symm e.symm
    have key : (Algebra.TensorProduct.lmul' R : TensorProduct R T T →ₐ[R] T) =
        (e : S →ₐ[R] T).comp ((Algebra.TensorProduct.lmul' R : TensorProduct R S S →ₐ[R] S).comp
          (E : TensorProduct R T T →ₐ[R] TensorProduct R S S)) := by
      apply Algebra.TensorProduct.ext'
      intro a b
      simp [E]
    have hE : RingHom.Flat ((E : TensorProduct R T T →ₐ[R] TensorProduct R S S) :
        TensorProduct R T T →+* TensorProduct R S S) := RingHom.Flat.of_bijective E.bijective
    have he : RingHom.Flat ((e : S →ₐ[R] T) : S →+* T) := RingHom.Flat.of_bijective e.bijective
    have hm : RingHom.Flat ((Algebra.TensorProduct.lmul' R : TensorProduct R S S →ₐ[R] S) :
        TensorProduct R S S →+* S) := hS.flat_lmul'
    rw [key]
    exact RingHom.Flat.comp (RingHom.Flat.comp hE hm) he

  have hWE : Algebra.WeaklyEtale (A ⧸ p) (H ⧸ p.map (algebraMap A H)) := by
    haveI := hHwe
    let e₀ : (H ⧸ p.map (algebraMap A H)) ≃ₐ[A] TensorProduct A (A ⧸ p) H :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot H p).restrictScalars A).trans
        (Algebra.TensorProduct.comm A H (A ⧸ p))
    let e : (H ⧸ p.map (algebraMap A H)) ≃ₐ[A ⧸ p] TensorProduct A (A ⧸ p) H :=
      AlgEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective e₀
    exact transport _ _ _ e.symm
      (@Algebra.WeaklyEtale.instTensorProduct A H _ _ _ (A ⧸ p) _ _ hHwe)

  have hHens : HenselianRing (H ⧸ p.map (algebraMap A H))
      ((I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H)))) := by
    haveI := hHhen
    have h1 := hhens H (I.map (algebraMap A H)) (p.map (algebraMap A H))
    rwa [hJ] at h1
  refine ⟨hWE, hHens, ?_⟩
  subst ht

  have hθa : ∀ a : A, θ (Ideal.Quotient.mk (I.map (algebraMap A H)) (algebraMap A H a)) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s)) (Ideal.Quotient.mk I a) := by
    intro a
    rw [← hθ]
    rfl
  let f : A ⧸ I →+* (A ⧸ p) ⧸ I.map (Ideal.Quotient.mk p) :=
    Ideal.quotientMap (I.map (Ideal.Quotient.mk p)) (Ideal.Quotient.mk p) Ideal.le_comap_map
  have hf : Function.Surjective f := Ideal.quotientMap_surjective Ideal.Quotient.mk_surjective
  have hfa : ∀ a : A, f (Ideal.Quotient.mk I a) =
      Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) (Ideal.Quotient.mk p a) :=
    fun a => Ideal.quotientMap_mk
  have hle : I.map (algebraMap A H) ≤
      ((I.map (Ideal.Quotient.mk p)).map
        (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H)))).comap
        (Ideal.Quotient.mk (p.map (algebraMap A H))) := by
    intro x hx
    rw [Ideal.mem_comap, ← hJ]
    exact Ideal.mem_map_of_mem _ hx
  let φ : H ⧸ I.map (algebraMap A H) →+* ((H ⧸ p.map (algebraMap A H)) ⧸
      (I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H)))) :=
    Ideal.quotientMap _ (Ideal.Quotient.mk (p.map (algebraMap A H))) hle
  have hφ : ∀ h : H, φ (Ideal.Quotient.mk (I.map (algebraMap A H)) h) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk (p.map (algebraMap A H)) h) :=
    fun h => Ideal.quotientMap_mk
  let g := φ.comp θ.symm.toRingHom
  have hφs : Function.Surjective φ :=
    Ideal.quotientMap_surjective (H := hle) Ideal.Quotient.mk_surjective
  have hg : Function.Surjective g := hφs.comp θ.symm.surjective
  have hcomm : g.comp (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s))) =
      (algebraMap ((A ⧸ p) ⧸ I.map (Ideal.Quotient.mk p)) ((H ⧸ p.map (algebraMap A H)) ⧸
      (I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H))))).comp
        f := by
    apply Ideal.Quotient.ringHom_ext
    ext a
    simp only [RingHom.comp_apply]
    rw [← hθa, hfa]
    show φ (θ.symm (θ _)) = _
    rw [RingEquiv.symm_apply_apply, hφ, Ideal.Quotient.algebraMap_quotient_map_quotient,
      Ideal.Quotient.algebraMap_quotient_map_quotient]
  have hpker : p.map (Ideal.Quotient.mk I) ≤ RingHom.ker f := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, hfa, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
  have hρ : (θ.toRingHom.comp (Ideal.Quotient.mk (I.map (algebraMap A H)))).comp (algebraMap A H)
      = (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s))).comp
        (Ideal.Quotient.mk I) := by
    ext a
    exact hθa a
  have hker : RingHom.ker g ≤ (RingHom.ker f).map
      (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s))) := by
    intro y hy
    rw [RingHom.mem_ker] at hy
    obtain ⟨h, hh⟩ := Ideal.Quotient.mk_surjective (θ.symm y)
    have hy' : y = θ (Ideal.Quotient.mk _ h) := by rw [hh, RingEquiv.apply_symm_apply]
    have hgy : g y = φ (θ.symm y) := rfl
    rw [hgy, ← hh, hφ, Ideal.Quotient.eq_zero_iff_mem, ← hJ,
      Ideal.mem_quotient_iff_mem_sup] at hy
    obtain ⟨i, hi, q, hq, rfl⟩ := Submodule.mem_sup.mp hy
    have hyq : y = (θ.toRingHom.comp (Ideal.Quotient.mk (I.map (algebraMap A H)))) q := by
      rw [hy', map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hi, zero_add]
      rfl
    rw [hyq]
    have hmem := Ideal.mem_map_of_mem (θ.toRingHom.comp (Ideal.Quotient.mk (I.map (algebraMap A H))))
      hq
    rw [Ideal.map_map, hρ, ← Ideal.map_map] at hmem
    exact Ideal.map_mono hpker hmem
  have hloc0 := IsLocalization.of_surjective (Submonoid.powers (Ideal.Quotient.mk I s))
    (Localization.Away (Ideal.Quotient.mk I s)) f hf g hg hcomm hker
  rw [Submonoid.map_powers, hfa] at hloc0
  let θ'' := @IsLocalization.algEquiv _ _
    (Submonoid.powers (Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) (Ideal.Quotient.mk p s)))
    ((H ⧸ p.map (algebraMap A H)) ⧸
      (I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H ⧸ p.map (algebraMap A H))))
    _ _ hloc0
    (Localization.Away (Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) (Ideal.Quotient.mk p s)))
    _ _ _
  refine ⟨θ''.toRingEquiv, ?_⟩
  ext x
  exact θ''.commutes x

theorem wc_whlzfc_descent_mod_prime (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (n : ℕ) (a : Fin n → A)
    (hspan : Ideal.span (Set.range (fun k => Ideal.Quotient.mk I (a k))) = ⊤)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (hHwe : ∀ k, Algebra.WeaklyEtale A (H k))
    (hHhen : ∀ k, HenselianRing (H k) (I.map (algebraMap A (H k))))
    (θH : ∀ k, (H k ⧸ I.map (algebraMap A (H k))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k)))
    (hHθ : ∀ k, (θH k).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (H k)))
        (algebraMap A (H k)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k))))
    (C : Fin n → Fin n → Type u) [∀ k l, CommRing (C k l)] [∀ k l, Algebra A (C k l)]
    (hCwe : ∀ k l, Algebra.WeaklyEtale A (C k l))
    (hChen : ∀ k l, HenselianRing (C k l) (I.map (algebraMap A (C k l))))
    (θC : ∀ k l, (C k l ⧸ I.map (algebraMap A (C k l))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k * a l)))
    (hCθ : ∀ k l, (θC k l).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (C k l)))
        (algebraMap A (C k l)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k * a l))))
    (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l)
    (p : Ideal A)
    (hhens : ∀ (R : Type u) [CommRing R] (I' : Ideal R) [HenselianRing R I'] (J : Ideal R),
      HenselianRing (R ⧸ J) (I'.map (Ideal.Quotient.mk J)))
    (hthick : ∀ (s : A) (t : A ⧸ p), Ideal.Quotient.mk p s = t →
      ∀ (H' : Type u) [CommRing H'] [Algebra A H'], Algebra.WeaklyEtale A H' →
      HenselianRing H' (I.map (algebraMap A H')) →
      ∀ (θ : (H' ⧸ I.map (algebraMap A H')) ≃+* Localization.Away (Ideal.Quotient.mk I s)),
      θ.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A H')) (algebraMap A H')
          Ideal.le_comap_map) = algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I s)) →
      Algebra.WeaklyEtale (A ⧸ p) (H' ⧸ p.map (algebraMap A H')) ∧
      HenselianRing (H' ⧸ p.map (algebraMap A H'))
        ((I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H' ⧸ p.map (algebraMap A H')))) ∧
      ∃ θ' : ((H' ⧸ p.map (algebraMap A H')) ⧸
          (I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H' ⧸ p.map (algebraMap A H')))) ≃+*
          Localization.Away (Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) t),
        θ'.toRingHom.comp (Ideal.quotientMap
            ((I.map (Ideal.Quotient.mk p)).map (algebraMap (A ⧸ p) (H' ⧸ p.map (algebraMap A H'))))
            (algebraMap (A ⧸ p) (H' ⧸ p.map (algebraMap A H'))) Ideal.le_comap_map) =
          algebraMap ((A ⧸ p) ⧸ I.map (Ideal.Quotient.mk p))
            (Localization.Away (Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p)) t)))
    (hdesc : ∀ (A' : Type u) [CommRing A'] (I' : Ideal A') [HenselianRing A' I']
      (n' : ℕ) (a' : Fin n' → A')
      (_ : Ideal.span (Set.range (fun k => Ideal.Quotient.mk I' (a' k))) = ⊤)
      (H' : Fin n' → Type u) [∀ k, CommRing (H' k)] [∀ k, Algebra A' (H' k)]
      (_ : ∀ k, Algebra.WeaklyEtale A' (H' k))
      (_ : ∀ k, HenselianRing (H' k) (I'.map (algebraMap A' (H' k))))
      (θH' : ∀ k, (H' k ⧸ I'.map (algebraMap A' (H' k))) ≃+*
        Localization.Away (Ideal.Quotient.mk I' (a' k)))
      (_ : ∀ k, (θH' k).toRingHom.comp (Ideal.quotientMap (I'.map (algebraMap A' (H' k)))
          (algebraMap A' (H' k)) Ideal.le_comap_map) =
        algebraMap (A' ⧸ I') (Localization.Away (Ideal.Quotient.mk I' (a' k))))
      (C' : Fin n' → Fin n' → Type u) [∀ k l, CommRing (C' k l)] [∀ k l, Algebra A' (C' k l)]
      (_ : ∀ k l, Algebra.WeaklyEtale A' (C' k l))
      (_ : ∀ k l, HenselianRing (C' k l) (I'.map (algebraMap A' (C' k l))))
      (θC' : ∀ k l, (C' k l ⧸ I'.map (algebraMap A' (C' k l))) ≃+*
        Localization.Away (Ideal.Quotient.mk I' (a' k * a' l)))
      (_ : ∀ k l, (θC' k l).toRingHom.comp (Ideal.quotientMap (I'.map (algebraMap A' (C' k l)))
          (algebraMap A' (C' k l)) Ideal.le_comap_map) =
        algebraMap (A' ⧸ I') (Localization.Away (Ideal.Quotient.mk I' (a' k * a' l))))
      (φ' : ∀ k l, H' k →ₐ[A'] C' k l) (ψ' : ∀ k l, H' l →ₐ[A'] C' k l),
      ∀ x : ∀ k, H' k, (∀ k l, φ' k l (x k) = ψ' k l (x l)) →
        ∃! y : A', ∀ k, algebraMap A' (H' k) y = x k) :
    ∀ h : ∀ k, H k,
      (∀ k l, φ k l (h k) - ψ k l (h l) ∈ p.map (algebraMap A (C k l))) →
      ∃ y : A, ∀ k, algebraMap A (H k) y - h k ∈ p.map (algebraMap A (H k)) :=
by
  intro h hh
  haveI hA' : HenselianRing (A ⧸ p) (I.map (Ideal.Quotient.mk p)) := hhens A I p
  have hspan' : Ideal.span (Set.range (fun k => Ideal.Quotient.mk (I.map (Ideal.Quotient.mk p))
      (Ideal.Quotient.mk p (a k)))) = ⊤ := by
    have h1 := congrArg (Ideal.map (Ideal.quotientMap (I.map (Ideal.Quotient.mk p))
      (Ideal.Quotient.mk p) Ideal.le_comap_map)) hspan
    rw [Ideal.map_span, Ideal.map_top, ← Set.range_comp] at h1
    rw [← h1]
    congr 2
  have hT := fun k => hthick (a k) (Ideal.Quotient.mk p (a k)) rfl (H k) (hHwe k) (hHhen k)
    (θH k) (hHθ k)
  have hTC := fun k l => hthick (a k * a l)
    (Ideal.Quotient.mk p (a k) * Ideal.Quotient.mk p (a l)) (map_mul _ _ _) (C k l)
    (hCwe k l) (hChen k l) (θC k l) (hCθ k l)
  choose θH' hθH' using fun k => (hT k).2.2
  choose θC' hθC' using fun k l => (hTC k l).2.2
  have hle : ∀ (B D : Type u) [CommRing B] [CommRing D] [Algebra A B] [Algebra A D]
      (f : B →ₐ[A] D),
      p.map (algebraMap A B) ≤ (p.map (algebraMap A D)).comap f.toRingHom := by
    intro B D _ _ _ _ f
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_map]
    apply le_of_eq
    congr 1
    exact f.comp_algebraMap
  let φ' : ∀ k l, (H k ⧸ p.map (algebraMap A (H k))) →ₐ[A ⧸ p]
      (C k l ⧸ p.map (algebraMap A (C k l))) := fun k l =>
    { Ideal.quotientMap (p.map (algebraMap A (C k l))) (φ k l).toRingHom (hle _ _ (φ k l)) with
      commutes' := by
        intro r
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        simp only [Ideal.Quotient.algebraMap_quotient_map_quotient, RingHom.toMonoidHom_eq_coe,
          OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe, MonoidHom.coe_coe, Ideal.quotientMap_mk,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes] }
  let ψ' : ∀ k l, (H l ⧸ p.map (algebraMap A (H l))) →ₐ[A ⧸ p]
      (C k l ⧸ p.map (algebraMap A (C k l))) := fun k l =>
    { Ideal.quotientMap (p.map (algebraMap A (C k l))) (ψ k l).toRingHom (hle _ _ (ψ k l)) with
      commutes' := by
        intro r
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        simp only [Ideal.Quotient.algebraMap_quotient_map_quotient, RingHom.toMonoidHom_eq_coe,
          OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe, MonoidHom.coe_coe, Ideal.quotientMap_mk,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes] }
  have hcompat : ∀ k l, φ' k l (Ideal.Quotient.mk _ (h k)) = ψ' k l (Ideal.Quotient.mk _ (h l)) := by
    intro k l
    show Ideal.Quotient.mk _ (φ k l (h k)) = Ideal.Quotient.mk _ (ψ k l (h l))
    exact Ideal.Quotient.eq.mpr (hh k l)
  obtain ⟨y', hy'⟩ := (hdesc (A ⧸ p) (I.map (Ideal.Quotient.mk p)) n
    (fun k => Ideal.Quotient.mk p (a k)) hspan'
    (fun k => H k ⧸ p.map (algebraMap A (H k))) (fun k => (hT k).1) (fun k => (hT k).2.1)
    θH' hθH'
    (fun k l => C k l ⧸ p.map (algebraMap A (C k l))) (fun k l => (hTC k l).1)
    (fun k l => (hTC k l).2.1) θC' hθC' φ' ψ' (fun k => Ideal.Quotient.mk _ (h k))
    hcompat).exists
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y'
  refine ⟨y, fun k => ?_⟩
  rw [← Ideal.Quotient.eq, ← Ideal.Quotient.algebraMap_quotient_map_quotient]
  exact hy' k

theorem wc_whlz_fibre_constancy (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (n : ℕ) (a : Fin n → A)
    (hspan : Ideal.span (Set.range (fun k => Ideal.Quotient.mk I (a k))) = ⊤)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (hHwe : ∀ k, Algebra.WeaklyEtale A (H k))
    (hHhen : ∀ k, HenselianRing (H k) (I.map (algebraMap A (H k))))
    (θH : ∀ k, (H k ⧸ I.map (algebraMap A (H k))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k)))
    (hHθ : ∀ k, (θH k).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (H k)))
        (algebraMap A (H k)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k))))
    (C : Fin n → Fin n → Type u) [∀ k l, CommRing (C k l)] [∀ k l, Algebra A (C k l)]
    (hCwe : ∀ k l, Algebra.WeaklyEtale A (C k l))
    (hChen : ∀ k l, HenselianRing (C k l) (I.map (algebraMap A (C k l))))
    (θC : ∀ k l, (C k l ⧸ I.map (algebraMap A (C k l))) ≃+*
      Localization.Away (Ideal.Quotient.mk I (a k * a l)))
    (hCθ : ∀ k l, (θC k l).toRingHom.comp (Ideal.quotientMap (I.map (algebraMap A (C k l)))
        (algebraMap A (C k l)) Ideal.le_comap_map) =
      algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k * a l))))
    (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l)
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [WeaklyEtale f]
    (g : ∀ k, Spec (.of (H k)) ⟶ X)
    (hgf : ∀ k, g k ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A (H k))))
    (hg : ∀ k l, Spec.map (CommRingCat.ofHom (φ k l).toRingHom) ≫ g k =
      Spec.map (CommRingCat.ofHom (ψ k l).toRingHom) ≫ g l) :
    ∀ (k l : Fin n) (P : PrimeSpectrum (H k)) (Q : PrimeSpectrum (H l)),
      PrimeSpectrum.comap (algebraMap A (H k)) P = PrimeSpectrum.comap (algebraMap A (H l)) Q →
      g k P = g l Q :=
by
  classical
  intro k l P Q hPQ
  set p : PrimeSpectrum A := PrimeSpectrum.comap (algebraMap A (H k)) P with hp

  have hvnr : ∀ (R : Type u) [CommRing R] [Algebra A R], Algebra.WeaklyEtale A R →
      ∀ x : p.asIdeal.Fiber R, ∃ t : p.asIdeal.Fiber R, x * x * t = x := by
    intro R _ _ hR x
    have hWE : Algebra.WeaklyEtale p.asIdeal.ResidueField (p.asIdeal.Fiber R) := inferInstance
    exact wc_weaklyEtale_field_vnr p.asIdeal.ResidueField (p.asIdeal.Fiber R) hWE
      (fun M _ _ _ _ hM => wc_weaklyEtale_flat_transfer _ _ hWE M hM) x

  have hhens : ∀ (R : Type u) [CommRing R] (I' : Ideal R) [HenselianRing R I'] (J : Ideal R),
      HenselianRing (R ⧸ J) (I'.map (Ideal.Quotient.mk J)) :=
    fun R _ I' _ J => wc_henselian_quotient R I' J
  have hdescp := wc_whlzfc_descent_mod_prime A I n a hspan H hHwe hHhen θH hHθ C hCwe hChen θC
    hCθ φ ψ p.asIdeal hhens
    (fun s t ht H' _ _ hwe hhen θ hθ =>
      wc_whlzfc_thickening_mod_prime A I p.asIdeal s t ht H' hwe hhen θ hθ hhens)
    @wc_whlz_ring_descent
  have hidem := wc_whlzfc_idempotent_constancy A n H C φ ψ p
    (fun R _ _ => wc_fibre_tensor_localization A R p.asIdeal) hdescp

  have hTp := wc_whlzfc_image_preconnected A n H C φ ψ g hg p hidem
  set T : Set X := ⋃ k, (fun P : PrimeSpectrum (H k) => g k P) ''
      (PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' {p}) with hT

  have hTc : IsCompact T := by
    apply isCompact_iUnion
    intro k'
    have hcs : CompactSpace ↑(PrimeSpectrum.comap (algebraMap A (H k')) ⁻¹' {p}) :=
      (PrimeSpectrum.preimageHomeomorphFiber A (H k') p).symm.compactSpace
    exact (isCompact_iff_compactSpace.mpr hcs).image (g k').continuous

  have hTY : T ⊆ (⇑f) ⁻¹' {p} := by
    intro x hx
    rw [hT, Set.mem_iUnion] at hx
    obtain ⟨k', P', hP', rfl⟩ := hx
    show f (g k' P') = p
    have e : f (g k' P') = (g k' ≫ f) P' := (Scheme.Hom.comp_apply (g k') f P').symm
    rw [e, hgf k']
    exact hP'

  have hsub := wc_top_preconnected_subsingleton _ T hTY hTc hTp
    (fun x hx => wc_weaklyEtale_fibre_local_charts A f p hvnr x (hTY hx))
  have hPT : g k P ∈ T := by
    rw [hT, Set.mem_iUnion]
    exact ⟨k, P, (rfl : PrimeSpectrum.comap (algebraMap A (H k)) P = p), rfl⟩
  have hQT : g l Q ∈ T := by
    rw [hT, Set.mem_iUnion]
    exact ⟨l, Q, hPQ.symm, rfl⟩
  exact hsub hPT hQT

theorem wc_whlz_epi_of_cover (B : Type u) [CommRing B] (n : ℕ) (B' : Fin n → Type u)
    [∀ k, CommRing (B' k)] (g : ∀ k, B →+* B' k) (hflat : ∀ k, (g k).Flat)
    (hsurj : ∀ p : PrimeSpectrum B, ∃ k, ∃ P : PrimeSpectrum (B' k),
      PrimeSpectrum.comap (g k) P = p)
    {X : Scheme.{u}} (u v : Spec (.of B) ⟶ X)
    (h : ∀ k, Spec.map (CommRingCat.ofHom (g k)) ≫ u = Spec.map (CommRingCat.ofHom (g k)) ≫ v) :
    u = v :=
by
  classical
  let φ : (k : Fin n) → (Spec (.of (B' k)) ⟶ Spec (.of B)) :=
    fun k => Spec.map (CommRingCat.ofHom (g k))
  have s1 : ∀ k, Flat (φ k) := fun k =>
    (HasRingHomProperty.Spec_iff (P := @Flat.{u}) (φ := CommRingCat.ofHom (g k))).mpr (hflat k)
  haveI : IsZariskiLocalAtSource @Flat.{u} :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @Flat.{u})
  haveI s2 : Flat (Limits.Sigma.desc φ) := IsZariskiLocalAtSource.sigmaDesc (P := @Flat.{u}) s1
  haveI s3 : Surjective (Limits.Sigma.desc φ) := by
    apply Surjective.sigmaDesc_of_union_range_eq_univ
    apply Set.eq_univ_of_forall
    intro x
    obtain ⟨k, P, hP⟩ := hsurj x
    refine Set.mem_iUnion.mpr ⟨k, P, ?_⟩
    simp only [φ, Spec.map_apply, CommRingCat.hom_ofHom]
    exact hP
  haveI hepi : Epi (Limits.Sigma.desc φ) := Flat.epi_of_flat_of_surjective _
  have s5 : Limits.Sigma.desc φ ≫ u = Limits.Sigma.desc φ ≫ v := by
    apply Limits.Sigma.hom_ext
    intro k
    rw [← Category.assoc, ← Category.assoc, Limits.Sigma.ι_comp_desc]
    exact h k
  exact (cancel_epi (Limits.Sigma.desc φ)).mp s5

theorem wc_whlz_glue_of_fibres (A : Type u) [CommRing A] (n : ℕ)
    (H : Fin n → Type u) [∀ k, CommRing (H k)] [∀ k, Algebra A (H k)]
    (C : Fin n → Fin n → Type u) [∀ k l, CommRing (C k l)] [∀ k l, Algebra A (C k l)]
    (φ : ∀ k l, H k →ₐ[A] C k l) (ψ : ∀ k l, H l →ₐ[A] C k l)
    (hflat : ∀ k, Module.Flat A (H k))
    (hsurj : ∀ p : PrimeSpectrum A, ∃ k, ∃ P : PrimeSpectrum (H k),
      PrimeSpectrum.comap (algebraMap A (H k)) P = p)
    (hring : ∀ x : ∀ k, H k, (∀ k l, φ k l (x k) = ψ k l (x l)) →
      ∃! y : A, ∀ k, algebraMap A (H k) y = x k)
    {X : Scheme.{u}} (g : ∀ k, Spec (.of (H k)) ⟶ X)
    (hg : ∀ k l, Spec.map (CommRingCat.ofHom (φ k l).toRingHom) ≫ g k =
      Spec.map (CommRingCat.ofHom (ψ k l).toRingHom) ≫ g l)
    (hfib : ∀ (k l : Fin n) (P : PrimeSpectrum (H k)) (Q : PrimeSpectrum (H l)),
      PrimeSpectrum.comap (algebraMap A (H k)) P = PrimeSpectrum.comap (algebraMap A (H l)) Q →
      g k P = g l Q) :
    ∃ σ : Spec (.of A) ⟶ X, ∀ k, Spec.map (CommRingCat.ofHom (algebraMap A (H k))) ≫ σ = g k :=
by
  classical

  have s5 : ∀ {Z Y₀ : Scheme.{u}} (m : ℕ) (Y : Fin m → Scheme.{u}) (a : ∀ i, Y i ⟶ Z),
      (∀ i, Flat (a i)) → (∀ z : Z, ∃ i, ∃ y : Y i, a i y = z) →
      ∀ (u₁ v₁ : Z ⟶ Y₀), (∀ i, a i ≫ u₁ = a i ≫ v₁) → u₁ = v₁ := by
    intro Z Y₀ m Y a hfl hsu u₁ v₁ h
    have : IsZariskiLocalAtSource @Flat :=
      HasRingHomProperty.instIsZariskiLocalAtSource (P := @Flat)
    have : Flat (Limits.Sigma.desc a) := IsZariskiLocalAtSource.sigmaDesc (fun i => hfl i)
    have : Surjective (Limits.Sigma.desc a) := Surjective.sigmaDesc_of_union_range_eq_univ (by
      ext z
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      exact hsu z)
    have := Flat.epi_of_flat_of_surjective (Limits.Sigma.desc a)
    apply (cancel_epi (Limits.Sigma.desc a)).mp
    apply Limits.Sigma.hom_ext
    intro i
    simp [h i]

  have s1 : ∀ U : Set (PrimeSpectrum A),
      (∀ k, IsOpen (PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' U)) → IsOpen U := by
    intro U hU
    let π : A →+* (∀ k, H k) := RingHom.pi (fun k => algebraMap A (H k))
    have hcomap : ∀ k (Q : PrimeSpectrum (H k)),
        PrimeSpectrum.comap π (PrimeSpectrum.comap (Pi.evalRingHom H k) Q) =
          PrimeSpectrum.comap (algebraMap A (H k)) Q := by
      intro k Q
      rw [← PrimeSpectrum.comap_comp_apply]
      rfl
    have hsurjπ : Function.Surjective (PrimeSpectrum.comap π) := by
      intro p
      obtain ⟨k, P, hP⟩ := hsurj p
      exact ⟨_, (hcomap k P).trans hP⟩
    have hgen : GeneralizingMap (PrimeSpectrum.comap π) := by
      intro Q p' hp'
      obtain ⟨k, Q', rfl⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq Q
      rw [hcomap] at hp'
      have := hflat k
      have hgd : GeneralizingMap (PrimeSpectrum.comap (algebraMap A (H k))) :=
        Algebra.HasGoingDown.iff_generalizingMap_primeSpectrumComap.mp
          Algebra.HasGoingDown.of_flat
      obtain ⟨P', hP', hP'eq⟩ := hgd hp'
      exact ⟨PrimeSpectrum.comap (Pi.evalRingHom H k) P',
        Specializes.map hP' (PrimeSpectrum.continuous_comap _), (hcomap k P').trans hP'eq⟩
    have hq := PrimeSpectrum.isQuotientMap_of_generalizingMap hsurjπ hgen
    rw [← hq.isCoinducing.isOpen_preimage, ← isClosed_compl_iff, ← Set.preimage_compl]
    have hrw : (PrimeSpectrum.comap π ⁻¹' Uᶜ) = ⋃ k, PrimeSpectrum.comap (Pi.evalRingHom H k) ''
        (PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' Uᶜ) := by
      ext Q
      constructor
      · intro hQ
        obtain ⟨k, Q', rfl⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq Q
        refine Set.mem_iUnion.mpr ⟨k, Q', ?_, rfl⟩
        show PrimeSpectrum.comap (algebraMap A (H k)) Q' ∈ Uᶜ
        rw [← hcomap]
        exact hQ
      · intro hQ
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hQ
        obtain ⟨Q', hQ', rfl⟩ := hk
        show PrimeSpectrum.comap π (PrimeSpectrum.comap (Pi.evalRingHom H k) Q') ∈ Uᶜ
        rw [hcomap]
        exact hQ'
    rw [hrw]
    apply isClosed_iUnion_of_finite
    intro k
    have hs : Function.Surjective (Pi.evalRingHom H k) :=
      fun x => ⟨Pi.single k x, Pi.single_eq_same k x⟩
    apply (PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ _ hs).isClosedMap
    rw [Set.preimage_compl]
    exact (hU k).isClosed_compl

  have s2 : ∀ p : PrimeSpectrum A, ∃ s : A, s ∉ p.asIdeal ∧ ∃ W : X.Opens, IsAffineOpen W ∧
      ∀ (k : Fin n) (P : PrimeSpectrum (H k)),
        s ∉ (PrimeSpectrum.comap (algebraMap A (H k)) P).asIdeal → g k P ∈ W := by
    intro p
    obtain ⟨k₀, P₀, hP₀⟩ := hsurj p
    obtain ⟨W, hW, hxW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
      (show g k₀ P₀ ∈ (⊤ : X.Opens) from trivial)
    let U : Set (PrimeSpectrum A) := {q | ∃ l, ∃ Q : PrimeSpectrum (H l),
      PrimeSpectrum.comap (algebraMap A (H l)) Q = q ∧ g l Q ∈ W}
    have hpre : ∀ k, PrimeSpectrum.comap (algebraMap A (H k)) ⁻¹' U =
        ⇑(g k) ⁻¹' (W : Set X) := by
      intro k
      ext P
      constructor
      · rintro ⟨l, Q, hQ, hQW⟩
        show g k P ∈ W
        rw [hfib k l P Q hQ.symm]
        exact hQW
      · intro hP
        exact ⟨k, P, rfl, hP⟩
    have hUo : IsOpen U := s1 U (fun k => by
      rw [hpre k]
      exact (g k).continuous.isOpen_preimage _ W.isOpen)
    have hpU : p ∈ U := ⟨k₀, P₀, hP₀, hxW⟩
    obtain ⟨V, ⟨s, rfl⟩, hpV, hVU⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpU hUo
    refine ⟨s, (PrimeSpectrum.mem_basicOpen _ _).mp hpV, W, hW, fun k P hs => ?_⟩
    obtain ⟨l, Q, hQ, hQW⟩ := hVU ((PrimeSpectrum.mem_basicOpen _ _).mpr hs)
    rw [hfib k l P Q hQ.symm]
    exact hQW

  have s3 : ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [Module.Flat A A'],
      ∀ x : ∀ k, TensorProduct A A' (H k),
        (∀ k l, Algebra.TensorProduct.map (AlgHom.id A' A') (φ k l) (x k) =
          Algebra.TensorProduct.map (AlgHom.id A' A') (ψ k l) (x l)) →
        ∃! y : A', ∀ k, algebraMap A' (TensorProduct A A' (H k)) y = x k := by
    intro A' _ _ _
    let d1 : A →ₗ[A] (∀ k, H k) := LinearMap.pi (fun k => Algebra.linearMap A (H k))
    let d2 : (∀ k, H k) →ₗ[A] (∀ kl : Fin n × Fin n, C kl.1 kl.2) :=
      LinearMap.pi (fun kl => (φ kl.1 kl.2).toLinearMap ∘ₗ LinearMap.proj kl.1 -
        (ψ kl.1 kl.2).toLinearMap ∘ₗ LinearMap.proj kl.2)
    have hd1 : Function.Injective d1 := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro y hy
      have h0 : ∀ k l, φ k l ((0 : ∀ k, H k) k) = ψ k l ((0 : ∀ k, H k) l) := by
        intro k l; simp
      refine (hring 0 h0).unique (y₁ := y) (y₂ := 0) ?_ ?_
      · intro k
        exact congrFun hy k
      · intro k; simp
    have hex : Function.Exact d1 d2 := by
      intro x
      constructor
      · intro hx
        have hc : ∀ k l, φ k l (x k) = ψ k l (x l) := by
          intro k l
          have := congrFun hx (k, l)
          simpa [d2, sub_eq_zero] using this
        obtain ⟨y, hy, -⟩ := hring x hc
        exact ⟨y, funext hy⟩
      · rintro ⟨y, rfl⟩
        funext kl
        simp [d1, d2]
    have hd1' := Module.Flat.lTensor_preserves_injective_linearMap (M := A') d1 hd1
    have hex' := Module.Flat.lTensor_exact A' hex
    let e1 := TensorProduct.piRight A A A' H
    let e2 := TensorProduct.piRight A A A' (fun kl : Fin n × Fin n => C kl.1 kl.2)
    let e0 := TensorProduct.rid A A'
    have key1 : ∀ w : TensorProduct A A' A, ∀ k,
        e1 (LinearMap.lTensor A' d1 w) k = algebraMap A' (TensorProduct A A' (H k)) (e0 w) := by
      intro w k
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul a r =>
        simp [e1, e0, d1, Algebra.algebraMap_eq_smul_one]
        congr 1
        rw [Algebra.TensorProduct.one_def, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      | add w w' hw hw' =>
        rw [map_add, map_add, Pi.add_apply, hw, hw', map_add, map_add]
    have key2 : ∀ z : TensorProduct A A' (∀ k, H k), ∀ kl : Fin n × Fin n,
        e2 (LinearMap.lTensor A' d2 z) kl =
          Algebra.TensorProduct.map (AlgHom.id A' A') (φ kl.1 kl.2) (e1 z kl.1) -
          Algebra.TensorProduct.map (AlgHom.id A' A') (ψ kl.1 kl.2) (e1 z kl.2) := by
      intro z kl
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a h =>
        simp [e1, e2, d2, TensorProduct.tmul_sub]
      | add w w' hw hw' =>
        rw [map_add, map_add, Pi.add_apply, hw, hw', map_add, Pi.add_apply, map_add, Pi.add_apply,
          map_add]
        abel
    intro x hx
    have hz : LinearMap.lTensor A' d2 (e1.symm x) = 0 := by
      apply e2.injective
      rw [map_zero]
      funext kl
      rw [key2, LinearEquiv.apply_symm_apply, hx, sub_self]
      rfl
    obtain ⟨w, hw⟩ := (hex' (e1.symm x)).mp hz
    refine ⟨e0 w, fun k => ?_, fun y' hy' => ?_⟩
    · rw [← key1, hw, LinearEquiv.apply_symm_apply]
    · apply e0.symm.injective
      apply hd1'
      apply e1.injective
      funext k
      rw [key1, key1, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply, hy', ← key1, hw,
        LinearEquiv.apply_symm_apply]

  have s4 : ∀ (A' : Type u) [CommRing A'] [Algebra A A'],
      (∀ x : ∀ k, TensorProduct A A' (H k),
        (∀ k l, Algebra.TensorProduct.map (AlgHom.id A' A') (φ k l) (x k) =
          Algebra.TensorProduct.map (AlgHom.id A' A') (ψ k l) (x l)) →
        ∃! y : A', ∀ k, algebraMap A' (TensorProduct A A' (H k)) y = x k) →
      ∀ (W : X.Opens) (hW : IsAffineOpen W),
      (∀ k (P : PrimeSpectrum (H k)),
        PrimeSpectrum.comap (algebraMap A (H k)) P ∈
          Set.range (PrimeSpectrum.comap (algebraMap A A')) → g k P ∈ W) →
      ∃ τ : Spec (.of A') ⟶ X, ∀ k,
        Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom : A' →+* TensorProduct A A' (H k))) ≫ τ =
          Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight :
              H k →ₐ[A] TensorProduct A A' (H k)).toRingHom) ≫ g k := by
    intro A' _ _ hring' W hW hrange
    have hrng : ∀ k, Set.range ⇑(Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : H k →ₐ[A] TensorProduct A A' (H k)).toRingHom) ≫
          g k) ⊆ Set.range ⇑hW.fromSpec := by
      intro k
      have heq : (algebraMap A' (TensorProduct A A' (H k))).comp (algebraMap A A') =
          (Algebra.TensorProduct.includeRight : H k →ₐ[A] TensorProduct A A' (H k)).toRingHom.comp
            (algebraMap A (H k)) := by
        apply RingHom.ext
        intro a
        rw [RingHom.comp_apply, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply]
        exact ((Algebra.TensorProduct.includeRight :
          H k →ₐ[A] TensorProduct A A' (H k)).commutes a).symm
      have key : ∀ Q : PrimeSpectrum (TensorProduct A A' (H k)),
          PrimeSpectrum.comap (algebraMap A A')
            (PrimeSpectrum.comap (algebraMap A' (TensorProduct A A' (H k))) Q) =
          PrimeSpectrum.comap (algebraMap A (H k)) (PrimeSpectrum.comap
            (Algebra.TensorProduct.includeRight :
              H k →ₐ[A] TensorProduct A A' (H k)).toRingHom Q) := by
        intro Q
        rw [← PrimeSpectrum.comap_comp_apply, ← PrimeSpectrum.comap_comp_apply, heq]
      rw [hW.range_fromSpec]
      rintro _ ⟨Q, rfl⟩
      rw [Scheme.Hom.comp_apply, Spec.map_apply]
      apply hrange
      exact ⟨_, key Q⟩
    let ρ : ∀ k, Γ(X, W) ⟶ CommRingCat.of (TensorProduct A A' (H k)) := fun k =>
      Spec.preimage (IsOpenImmersion.lift hW.fromSpec _ (hrng k))
    have hρ : ∀ k, Spec.map (ρ k) ≫ hW.fromSpec = Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          H k →ₐ[A] TensorProduct A A' (H k)).toRingHom) ≫ g k := by
      intro k
      simp only [ρ, Spec.map_preimage, IsOpenImmersion.lift_fac]
    have hφ : ∀ k l, CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : H k →ₐ[A] TensorProduct A A' (H k)).toRingHom ≫
        CommRingCat.ofHom (Algebra.TensorProduct.map (AlgHom.id A' A') (φ k l)).toRingHom =
        CommRingCat.ofHom (φ k l).toRingHom ≫ CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          C k l →ₐ[A] TensorProduct A A' (C k l)).toRingHom := by
      intro k l
      ext h
      simp
    have hψ : ∀ k l, CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : H l →ₐ[A] TensorProduct A A' (H l)).toRingHom ≫
        CommRingCat.ofHom (Algebra.TensorProduct.map (AlgHom.id A' A') (ψ k l)).toRingHom =
        CommRingCat.ofHom (ψ k l).toRingHom ≫ CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          C k l →ₐ[A] TensorProduct A A' (C k l)).toRingHom := by
      intro k l
      ext h
      simp
    have hc : ∀ k l, ρ k ≫ CommRingCat.ofHom
        (Algebra.TensorProduct.map (AlgHom.id A' A') (φ k l)).toRingHom =
        ρ l ≫ CommRingCat.ofHom
          (Algebra.TensorProduct.map (AlgHom.id A' A') (ψ k l)).toRingHom := by
      intro k l
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, ← cancel_mono hW.fromSpec, Category.assoc, Category.assoc,
        hρ, hρ, ← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp, hφ, hψ,
        Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc, hg k l]
    have hcompat : ∀ (r : Γ(X, W)) (k l : Fin n),
        Algebra.TensorProduct.map (AlgHom.id A' A') (φ k l) ((ρ k).hom r) =
          Algebra.TensorProduct.map (AlgHom.id A' A') (ψ k l) ((ρ l).hom r) := by
      intro r k l
      have := congrArg (fun f => f.hom r) (hc k l)
      simpa using this
    let y : Γ(X, W) → A' := fun r => (hring' (fun k => (ρ k).hom r) (hcompat r)).exists.choose
    have hy : ∀ r k, algebraMap A' (TensorProduct A A' (H k)) (y r) = (ρ k).hom r := fun r =>
      (hring' (fun k => (ρ k).hom r) (hcompat r)).exists.choose_spec
    have huniq : ∀ r (z : A'), (∀ k, algebraMap A' (TensorProduct A A' (H k)) z = (ρ k).hom r) →
        z = y r := fun r z hz => (hring' _ (hcompat r)).unique hz (hy r)
    let t : Γ(X, W) →+* A' :=
      { toFun := y
        map_one' := (huniq 1 1 (fun k => by rw [map_one, map_one])).symm
        map_mul' := fun a b => (huniq (a * b) (y a * y b)
          (fun k => by rw [map_mul, map_mul, hy, hy])).symm
        map_zero' := (huniq 0 0 (fun k => by rw [map_zero, map_zero])).symm
        map_add' := fun a b => (huniq (a + b) (y a + y b)
          (fun k => by rw [map_add, map_add, hy, hy])).symm }
    refine ⟨Spec.map (CommRingCat.ofHom t) ≫ hW.fromSpec, fun k => ?_⟩
    have e1 : CommRingCat.ofHom t ≫ CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : A' →+* TensorProduct A A' (H k)) = ρ k := by
      ext r
      exact hy r k
    rw [← Category.assoc, ← Spec.map_comp, e1, hρ]

  have hloc : ∀ p : PrimeSpectrum A, ∃ s : A, s ∉ p.asIdeal ∧
      ∃ τ : Spec (.of (Localization.Away s)) ⟶ X, ∀ k,
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            Localization.Away s →+* TensorProduct A (Localization.Away s) (H k))) ≫ τ =
          Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
            H k →ₐ[A] TensorProduct A (Localization.Away s) (H k)).toRingHom) ≫ g k := by
    intro p
    obtain ⟨s, hs, W, hW, hWg⟩ := s2 p
    refine ⟨s, hs, ?_⟩
    refine s4 (Localization.Away s) (s3 (Localization.Away s)) W hW ?_
    intro k P hP
    apply hWg k P
    rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s] at hP
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hP

  choose s hs τ hτ using hloc
  let f : ∀ p, Spec (.of (Localization.Away (s p))) ⟶ Spec (.of A) := fun p =>
    Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (s p))))
  let π : ∀ k, Spec (.of (H k)) ⟶ Spec (.of A) := fun k =>
    Spec.map (CommRingCat.ofHom (algebraMap A (H k)))
  have hfo : ∀ p, IsOpenImmersion (f p) := fun p =>
    IsOpenImmersion.of_isLocalization (S := Localization.Away (s p)) (s p)
  have hπflat : ∀ k, Flat (π k) := fun k =>
    HasRingHomProperty.Spec_iff.mpr (RingHom.flat_algebraMap_iff.mpr (hflat k))
  have hcov : ∀ x : Spec (.of A), ∃ j : PrimeSpectrum A, ∃ y, f j y = x := by
    intro x
    let p : PrimeSpectrum A := x
    have hx : p ∈ Set.range (PrimeSpectrum.comap (algebraMap A (Localization.Away (s p)))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (s p)) (s p)]
      exact hs p
    obtain ⟨y, hy⟩ := hx
    exact ⟨p, y,
      (Spec.map_apply (CommRingCat.ofHom (algebraMap A (Localization.Away (s p)))) y).trans hy⟩
  have KI : ∀ p k, Limits.pullback.fst (f p) (π k) ≫ τ p =
      Limits.pullback.snd (f p) (π k) ≫ g k := by
    intro p k
    rw [← pullbackSpecIso_hom_fst A (Localization.Away (s p)) (H k),
      ← pullbackSpecIso_hom_snd A (Localization.Away (s p)) (H k), Category.assoc, Category.assoc]
    congr 1
    exact hτ p k
  have hglue : ∀ p q, Limits.pullback.fst (f p) (f q) ≫ τ p =
      Limits.pullback.snd (f p) (f q) ≫ τ q := by
    intro p q
    let e := Limits.pullback.fst (f p) (f q) ≫ f p
    refine s5 n (fun k => Limits.pullback e (π k)) (fun k => Limits.pullback.fst e (π k))
      (fun k => by have := hπflat k; infer_instance) ?_ _ _ ?_
    · intro z
      obtain ⟨k, P, hP⟩ := hsurj (e z)
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := e) (g := π k) z P
        (hP.symm.trans (Spec.map_apply (CommRingCat.ofHom (algebraMap A (H k))) P).symm)
      exact ⟨k, w, hw⟩
    · intro k
      have c0 : Limits.pullback.fst e (π k) ≫ e = Limits.pullback.snd e (π k) ≫ π k :=
        Limits.pullback.condition
      have cond1 : (Limits.pullback.fst e (π k) ≫ Limits.pullback.fst (f p) (f q)) ≫ f p =
          Limits.pullback.snd e (π k) ≫ π k := by
        rw [Category.assoc]; exact c0
      have cond2 : (Limits.pullback.fst e (π k) ≫ Limits.pullback.snd (f p) (f q)) ≫ f q =
          Limits.pullback.snd e (π k) ≫ π k := by
        rw [Category.assoc, ← Limits.pullback.condition]; exact c0
      calc Limits.pullback.fst e (π k) ≫ Limits.pullback.fst (f p) (f q) ≫ τ p
          = Limits.pullback.lift _ _ cond1 ≫ Limits.pullback.fst (f p) (π k) ≫ τ p := by
            rw [Limits.pullback.lift_fst_assoc, Category.assoc]
        _ = Limits.pullback.lift _ _ cond1 ≫ Limits.pullback.snd (f p) (π k) ≫ g k := by rw [KI]
        _ = Limits.pullback.snd e (π k) ≫ g k := by rw [Limits.pullback.lift_snd_assoc]
        _ = Limits.pullback.lift _ _ cond2 ≫ Limits.pullback.snd (f q) (π k) ≫ g k := by
            rw [Limits.pullback.lift_snd_assoc]
        _ = Limits.pullback.lift _ _ cond2 ≫ Limits.pullback.fst (f q) (π k) ≫ τ q := by rw [KI]
        _ = Limits.pullback.fst e (π k) ≫ Limits.pullback.snd (f p) (f q) ≫ τ q := by
            rw [Limits.pullback.lift_fst_assoc, Category.assoc]
  let 𝒰 : (Spec (.of A)).OpenCover :=
    Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (PrimeSpectrum A)
      (fun p => Spec (.of (Localization.Away (s p)))) f hcov hfo
  let σ := Scheme.Cover.glueMorphisms 𝒰 τ hglue
  have hσ : ∀ p, f p ≫ σ = τ p := fun p => Scheme.Cover.ι_glueMorphisms 𝒰 τ hglue p
  refine ⟨σ, fun k => ?_⟩
  have hcovk : ∀ P : Spec (.of (H k)), ∃ p : PrimeSpectrum A, ∃ y,
      Limits.pullback.snd (f p) (π k) y = P := by
    intro P
    obtain ⟨j, y, hy⟩ := hcov (π k P)
    obtain ⟨w, -, hw⟩ := Scheme.Pullback.exists_preimage_pullback (f := f j) (g := π k) y P hy
    exact ⟨j, w, hw⟩
  have hfin : ∀ p : PrimeSpectrum A,
      Limits.pullback.snd (f p) (π k) ≫ π k ≫ σ = Limits.pullback.snd (f p) (π k) ≫ g k := by
    intro p
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc, hσ, KI]
  let 𝒱 : (Spec (.of (H k))).OpenCover :=
    Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (PrimeSpectrum A)
      (fun p => Limits.pullback (f p) (π k)) (fun p => Limits.pullback.snd (f p) (π k)) hcovk
      (fun p => by have := hfo p; infer_instance)
  apply Scheme.Cover.hom_ext 𝒱
  intro p
  exact hfin p

theorem wc_whl_zariski_glue (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [WeaklyEtale f]
    (b : Spec (.of (A ⧸ I)) ⟶ X)
    (hb : b ≫ f = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    (H_aff : ∀ (A' : Type u) [CommRing A'] (I' : Ideal A') [HenselianRing A' I']
      (R' : Type u) [CommRing R'] [Algebra A' R'] [Algebra.WeaklyEtale A' R']
      (σb : R' →ₐ[A'] A' ⧸ I'), ∃ σ : R' →ₐ[A'] A', (Ideal.Quotient.mkₐ A' I').comp σ = σb) :
    ∃ σ : Spec (.of A) ⟶ X,
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ = b ∧ σ ≫ f = 𝟙 _ :=
by
  classical
  obtain ⟨n, a, H, _, _, C, _, _, φ, ψ, θH, θC, g, hspan, hHwe, hHhen, hHθ, hCwe, hChen, hCθ,
    hL1, hL2, hL3⟩ := wc_whlz_local_lifts A I f b hb H_aff
  have hflat : ∀ k, Module.Flat A (H k) := fun k => (hHwe k).flat
  have hsurj := wc_whlz_jointly_surjective A I (HenselianRing.jac (I := I)) n a hspan H hflat
    θH hHθ
  have hring := wc_whlz_ring_descent A I n a hspan H hHwe hHhen θH hHθ C hCwe hChen θC hCθ φ ψ
  have hfib := wc_whlz_fibre_constancy A I n a hspan H hHwe hHhen θH hHθ C hCwe hChen θC hCθ
    φ ψ f g hL1 hL3
  obtain ⟨σ, hσ⟩ := wc_whlz_glue_of_fibres A n H C φ ψ hflat hsurj hring g hL3 hfib

  have hflatZ : ∀ k, (Ideal.quotientMap (I.map (algebraMap A (H k))) (algebraMap A (H k))
      Ideal.le_comap_map).Flat := by
    intro k
    have e : Ideal.quotientMap (I.map (algebraMap A (H k))) (algebraMap A (H k))
        Ideal.le_comap_map = ((θH k).symm.toRingHom).comp
          (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k)))) := by
      rw [← hHθ k]
      refine RingHom.ext fun x => ?_
      simp
    rw [e]
    refine RingHom.Flat.comp ?_ (RingHom.Flat.of_bijective (θH k).symm.bijective)
    rw [RingHom.flat_algebraMap_iff]
    exact IsLocalization.flat _ (Submonoid.powers (Ideal.Quotient.mk I (a k)))
  have hsurjZ : ∀ p : PrimeSpectrum (A ⧸ I), ∃ k,
      ∃ P : PrimeSpectrum (H k ⧸ I.map (algebraMap A (H k))),
      PrimeSpectrum.comap (Ideal.quotientMap (I.map (algebraMap A (H k))) (algebraMap A (H k))
        Ideal.le_comap_map) P = p := by
    intro p
    have hex : ∃ k, Ideal.Quotient.mk I (a k) ∉ p.asIdeal := by
      by_contra hcon
      push_neg at hcon
      apply p.isPrime.ne_top
      rw [eq_top_iff, ← hspan, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact hcon k
    obtain ⟨k, hk⟩ := hex
    have hdisj : Disjoint (↑(Submonoid.powers (Ideal.Quotient.mk I (a k))) : Set (A ⧸ I))
        ↑p.asIdeal :=
      (Ideal.disjoint_powers_iff_notMem _ p.isPrime.isRadical).mpr hk
    haveI hP : (Ideal.map (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I (a k))))
        p.asIdeal).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers _) _ p.asIdeal p.isPrime hdisj
    have hunder := IsLocalization.under_map_of_isPrime_disjoint
      (Submonoid.powers (Ideal.Quotient.mk I (a k)))
      (Localization.Away (Ideal.Quotient.mk I (a k))) p.isPrime hdisj
    refine ⟨k, ⟨Ideal.comap (θH k).toRingHom (Ideal.map (algebraMap (A ⧸ I)
      (Localization.Away (Ideal.Quotient.mk I (a k)))) p.asIdeal),
      Ideal.comap_isPrime (θH k).toRingHom _⟩, ?_⟩
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap, hHθ k]
    exact hunder
  refine ⟨σ, ?_, ?_⟩
  · apply wc_whlz_epi_of_cover (A ⧸ I) n (fun k => H k ⧸ I.map (algebraMap A (H k)))
      (fun k => Ideal.quotientMap (I.map (algebraMap A (H k))) (algebraMap A (H k))
        Ideal.le_comap_map) hflatZ hsurjZ
    intro k
    have e : Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap A (H k)))
          (algebraMap A (H k)) Ideal.le_comap_map)) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A (H k))))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A (H k))) := by
      rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        Ideal.quotientMap_comp_mk]
    rw [← Category.assoc, e, Category.assoc, hσ k, hL2 k]
  · apply wc_whlz_epi_of_cover A n H (fun k => algebraMap A (H k))
      (fun k => RingHom.flat_algebraMap_iff.mpr (hflat k)) hsurj
    intro k
    rw [← Category.assoc, hσ k, hL1 k, Category.comp_id]

theorem wc_weaklyEtale_henselian_lift {X S : Scheme.{u}} (f : X ⟶ S) [WeaklyEtale f]
    (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (a : Spec (.of A) ⟶ S) (b : Spec (.of (A ⧸ I)) ⟶ X)
    (hab : b ≫ f = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a) :
    ∃! σ : Spec (.of A) ⟶ X,
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ = b ∧ σ ≫ f = a :=
by
  classical

  have huniq : ∀ σ₁ σ₂ : Spec (.of A) ⟶ X,
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ₁ = b ∧ σ₁ ≫ f = a) →
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ₂ = b ∧ σ₂ ≫ f = a) →
      σ₁ = σ₂ := by
    intro σ₁ σ₂ h1 h2
    haveI : Flat (Limits.pullback.diagonal f) := WeaklyEtale.flat_diagonal
    exact wc_whl_unique f A I σ₁ σ₂ (h1.1.trans h2.1.symm) (h1.2.trans h2.2.symm)

  have Haff : ∀ (A' : Type u) [CommRing A'] (I' : Ideal A') [HenselianRing A' I']
      (R' : Type u) [CommRing R'] [Algebra A' R'] [Algebra.WeaklyEtale A' R']
      (σb : R' →ₐ[A'] A' ⧸ I'), ∃ σ : R' →ₐ[A'] A', (Ideal.Quotient.mkₐ A' I').comp σ = σb := by
    intro A' _ I' _ R' _ _ _ σb
    obtain ⟨C, _, _, hC, lam, ε, hε⟩ := wc_whl_affine_reduction A' I' R' σb
    haveI := hC
    obtain ⟨τ⟩ := wc_whl_section_of_trivial_mod_I A' I' C ε
    have hmap : Ideal.map (algebraMap A' C) I' ≤ Ideal.comap τ I' := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
      exact hy
    have key : ∀ c : C, Ideal.Quotient.mk I' (τ c) =
        ε (Ideal.Quotient.mk (Ideal.map (algebraMap A' C) I') c) := by
      intro c
      obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective
        (ε (Ideal.Quotient.mk (Ideal.map (algebraMap A' C) I') c))
      have h1 : ε (Ideal.Quotient.mk (Ideal.map (algebraMap A' C) I') (algebraMap A' C x)) =
          Ideal.Quotient.mk I' x := by
        rw [Ideal.Quotient.mk_algebraMap, ε.commutes, Ideal.Quotient.algebraMap_eq]
      have h2 : Ideal.Quotient.mk (Ideal.map (algebraMap A' C) I') c =
          Ideal.Quotient.mk (Ideal.map (algebraMap A' C) I') (algebraMap A' C x) := by
        apply ε.injective
        rw [h1, hx]
      rw [Ideal.Quotient.eq] at h2
      have h3 := hmap h2
      rw [Ideal.mem_comap, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
        RingHom.id_apply] at h3
      rw [← hx]
      exact Ideal.Quotient.eq.mpr h3
    refine ⟨τ.comp lam, ?_⟩
    apply AlgHom.ext
    intro r
    rw [AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, key, hε]

  haveI : WeaklyEtale (Limits.pullback.snd f a) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback f a)
      inferInstance
  obtain ⟨σ', h1, h2⟩ := wc_whl_zariski_glue A I (Limits.pullback.snd f a)
    (Limits.pullback.lift b (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) hab)
    (Limits.pullback.lift_snd _ _ _) Haff
  have hσ : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫
        (σ' ≫ Limits.pullback.fst f a) = b ∧
      (σ' ≫ Limits.pullback.fst f a) ≫ f = a := by
    constructor
    · rw [← Category.assoc, h1, Limits.pullback.lift_fst]
    · rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, h2, Category.id_comp]
  exact ⟨σ' ≫ Limits.pullback.fst f a, hσ, fun y hy => huniq y _ hy hσ⟩

theorem wc_proet_thickening_bc_hom_bijective {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (A : Type u) [CommRing A] (I : Ideal A) (Vt : Y.ProEt) (e : Vt.left ≅ Spec (.of A))
    (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I)))
    (hsq : IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))
    (hlift : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [WeaklyEtale f] (a : Spec (.of A) ⟶ S)
      (b : Spec (.of (A ⧸ I)) ⟶ X),
      b ≫ f = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ a →
      ∃! σ : Spec (.of A) ⟶ X, Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ σ = b ∧ σ ≫ f = a)
    (V : Y.ProEt) :
    Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) :=
by
  classical
  haveI : WeaklyEtale V.hom := V.prop
  haveI : IsIso c := hsq.isIso_snd_of_isIso
  have hw : Limits.pullback.fst Vt.hom i ≫ e.hom =
      c ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) := hsq.toCommSq.w
  have hK : inv c ≫ Limits.pullback.fst Vt.hom i =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e.inv := by
    rw [← cancel_epi c, IsIso.hom_inv_id_assoc, ← reassoc_of% hw, Iso.hom_inv_id,
      Category.comp_id]
  have F1 : ∀ {W W' : Y.ProEt} (g : W ⟶ W'),
      ((wcProEtBaseChange i).map g).left ≫ Limits.pullback.fst W'.hom i =
        Limits.pullback.fst W.hom i ≫ g.left := fun g => Limits.pullback.lift_fst _ _ _
  have F2 : ∀ {W W' : Y.ProEt} (g : W ⟶ W'),
      ((wcProEtBaseChange i).map g).left ≫ Limits.pullback.snd W'.hom i =
        Limits.pullback.snd W.hom i := fun g => Limits.pullback.lift_snd _ _ _
  have hA : ∀ a : Vt ⟶ V, (e.inv ≫ a.left) ≫ V.hom = e.inv ≫ Vt.hom := fun a => by
    rw [Category.assoc, MorphismProperty.Over.w a]
  constructor
  · intro a₁ a₂ h
    simp only at h
    have h1 : Limits.pullback.fst Vt.hom i ≫ a₁.left =
        Limits.pullback.fst Vt.hom i ≫ a₂.left := by
      rw [← F1 a₁, ← F1 a₂, h]
    have hb : (inv c ≫ Limits.pullback.fst Vt.hom i ≫ a₁.left) ≫ V.hom =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e.inv ≫ Vt.hom := by
      rw [Category.assoc, Category.assoc, MorphismProperty.Over.w a₁, ← Category.assoc, hK,
        Category.assoc]
    obtain ⟨σ, _, huniq⟩ := hlift V.hom (e.inv ≫ Vt.hom) _ hb
    have e1 : e.inv ≫ a₁.left = σ :=
      huniq _ ⟨by rw [← Category.assoc, ← hK, Category.assoc], hA a₁⟩
    have e2 : e.inv ≫ a₂.left = σ :=
      huniq _ ⟨by rw [← Category.assoc, ← hK, Category.assoc, ← h1], hA a₂⟩
    have h3 : a₁.left = a₂.left := by rw [← cancel_epi e.inv, e1, e2]
    exact MorphismProperty.Over.Hom.ext h3
  · intro β
    obtain ⟨β', hβ'⟩ : ∃ β' : Limits.pullback Vt.hom i ⟶ Limits.pullback V.hom i,
        β' = β.left := ⟨β.left, rfl⟩
    have hF3 : β' ≫ Limits.pullback.snd V.hom i = Limits.pullback.snd Vt.hom i := by
      rw [hβ']; exact MorphismProperty.Over.w β
    have hb : (inv c ≫ β' ≫ Limits.pullback.fst V.hom i) ≫ V.hom =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e.inv ≫ Vt.hom := by
      calc (inv c ≫ β' ≫ Limits.pullback.fst V.hom i) ≫ V.hom
          = inv c ≫ β' ≫ (Limits.pullback.fst V.hom i ≫ V.hom) := by
            simp only [Category.assoc]
        _ = inv c ≫ β' ≫ (Limits.pullback.snd V.hom i ≫ i) := by
            rw [Limits.pullback.condition]
        _ = inv c ≫ (β' ≫ Limits.pullback.snd V.hom i) ≫ i := by
            simp only [Category.assoc]
        _ = inv c ≫ (Limits.pullback.snd Vt.hom i ≫ i) := by rw [hF3]
        _ = inv c ≫ (Limits.pullback.fst Vt.hom i ≫ Vt.hom) := by
            rw [Limits.pullback.condition]
        _ = (inv c ≫ Limits.pullback.fst Vt.hom i) ≫ Vt.hom := by
            simp only [Category.assoc]
        _ = _ := by rw [hK, Category.assoc]
    obtain ⟨σ, ⟨hσ1, hσ2⟩, _⟩ := hlift V.hom (e.inv ≫ Vt.hom) _ hb
    let α : Vt ⟶ V := MorphismProperty.Over.homMk (e.hom ≫ σ)
      (by rw [Category.assoc, hσ2, Iso.hom_inv_id_assoc]) trivial
    have hαl : α.left = e.hom ≫ σ := rfl
    have key : ∀ g : Limits.pullback Vt.hom i ⟶ Limits.pullback V.hom i,
        g ≫ Limits.pullback.fst V.hom i = β' ≫ Limits.pullback.fst V.hom i →
        g ≫ Limits.pullback.snd V.hom i = β' ≫ Limits.pullback.snd V.hom i → g = β' :=
      fun g h1 h2 => Limits.pullback.hom_ext h1 h2
    have h1 : Limits.pullback.fst Vt.hom i ≫ α.left = β' ≫ Limits.pullback.fst V.hom i := by
      rw [hαl, reassoc_of% hw, hσ1, IsIso.hom_inv_id_assoc]
    refine ⟨α, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Eq.trans (key _ ((F1 α).trans h1) ((F2 α).trans hF3.symm)) hβ'

theorem wc_sheafOfModules_skyscraper (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    (hW : ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U → ∀ a : W ⟶ U, T.arrows a)
    (A : ModuleCat.{u+1} ((wcRingSheaf S ℓ).obj.obj (Opposite.op W))) :
    ∃ (Sk : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ι : ∀ U : S.ProEt, Sk.val.obj (Opposite.op U) ≃ ((W ⟶ U) → A)),
      (∀ (U U' : S.ProEt) (f : U' ⟶ U) (s : Sk.val.obj (Opposite.op U)) (ψ : W ⟶ U'),
        ι U' ((Sk.val.map f.op).hom s) ψ = ι U s (ψ ≫ f)) ∧
      (∀ (U : S.ProEt) (r : (wcRingSheaf S ℓ).obj.obj (Opposite.op U))
        (s : Sk.val.obj (Opposite.op U)) (ψ : W ⟶ U),
        ι U (r • s) ψ = ((wcRingSheaf S ℓ).obj.map ψ.op).hom r • ι U s ψ) ∧
      (∀ (U : S.ProEt) (s s' : Sk.val.obj (Opposite.op U)), ι U (s + s') = ι U s + ι U s') ∧
      ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g : M.val.obj (Opposite.op W) ⟶ A),
        ∃! G : M ⟶ Sk, ∀ m, ι W ((G.val.app (Opposite.op W)).hom m) (𝟙 W) = g.hom m :=
by
  let Ab : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun X => AddCommGrpCat.of ((W ⟶ X.unop) → A)
      map := fun {X Y} f => AddCommGrpCat.ofHom
        { toFun := fun s ψ => s (ψ ≫ f.unop)
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      map_id := fun X => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro s
        funext ψ
        exact congrArg s (Category.comp_id ψ)
      map_comp := fun {X Y Z} f g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro s
        funext ψ
        exact congrArg s (Category.assoc ψ g.unop f.unop).symm }
  let inst : ∀ X : S.ProEtᵒᵖ, Module ((wcRingSheaf S ℓ).obj.obj X) (Ab.obj X) := fun X =>
    @Pi.module (W ⟶ X.unop) (fun _ => A) ((wcRingSheaf S ℓ).obj.obj X) _ _
      (fun ψ => Module.compHom A ((wcRingSheaf S ℓ).obj.map ψ.op).hom)
  let P : PresheafOfModules.{u+1} (wcRingSheaf S ℓ).obj :=
    @PresheafOfModules.ofPresheaf S.ProEt _ (wcRingSheaf S ℓ).obj Ab inst
      (fun X Y f r m => by
        funext ψ
        show ((wcRingSheaf S ℓ).obj.map (ψ ≫ f.unop).op).hom r • m (ψ ≫ f.unop) =
          ((wcRingSheaf S ℓ).obj.map ψ.op).hom (((wcRingSheaf S ℓ).obj.map f).hom r) •
            m (ψ ≫ f.unop)
        rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp, RingCat.comp_apply])
  have hP : Presheaf.IsSheaf (Scheme.ProEt.topology S) P.presheaf := by
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro U T hT
    rw [← Presieve.isSeparatedFor_and_exists_isAmalgamation_iff_isSheafFor]
    constructor
    · intro x t₁ t₂ h₁ h₂
      funext ψ
      have e := (h₁ ψ (hW U T hT ψ)).trans (h₂ ψ (hW U T hT ψ)).symm
      have e' : (t₁ : (W ⟶ U) → A) (𝟙 W ≫ ψ) = (t₂ : (W ⟶ U) → A) (𝟙 W ≫ ψ) :=
        congrArg (fun s : (W ⟶ W) → A => s (𝟙 W)) e
      simp only [Category.id_comp] at e'
      exact e'
    · intro x hx
      refine ⟨(fun ψ : W ⟶ U => (x ψ (hW U T hT ψ) : (W ⟶ W) → A) (𝟙 W) : (W ⟶ U) → A), ?_⟩
      intro V g hg
      funext ψ'
      have h' : T.arrows (ψ' ≫ g) := hW U T hT (ψ' ≫ g)
      have e := hx ψ' (𝟙 W) hg h' (Category.id_comp (ψ' ≫ g)).symm
      have e' : (x g hg : (W ⟶ V) → A) (𝟙 W ≫ ψ') =
          (x (ψ' ≫ g) h' : (W ⟶ W) → A) (𝟙 W ≫ 𝟙 W) :=
        congrArg (fun s : (W ⟶ W) → A => s (𝟙 W)) e
      simp only [Category.id_comp] at e'
      exact e'.symm
  refine ⟨SheafOfModules.mk P hP,
    fun U => Equiv.refl _, fun U U' f s ψ => rfl, fun U r s ψ => rfl, fun U s s' => rfl, ?_⟩
  intro M g
  let H : M.val ⟶ P :=
    { app := fun X =>
        letI := inst X
        ModuleCat.ofHom
        { toFun := fun m => (fun ψ => g.hom ((M.val.map ψ.op).hom m) : (W ⟶ X.unop) → A)
          map_add' := fun x y => by
            funext ψ
            show g.hom ((M.val.map ψ.op).hom (x + y)) =
              g.hom ((M.val.map ψ.op).hom x) + g.hom ((M.val.map ψ.op).hom y)
            exact (congrArg g.hom ((M.val.map ψ.op).hom.map_add x y)).trans (g.hom.map_add _ _)
          map_smul' := fun r x => by
            funext ψ
            show g.hom ((M.val.map ψ.op).hom (r • x)) =
              ((wcRingSheaf S ℓ).obj.map ψ.op).hom r • g.hom ((M.val.map ψ.op).hom x)
            exact (congrArg g.hom (PresheafOfModules.map_smul M.val ψ.op r x)).trans
              (g.hom.map_smul _ _) }
      naturality := fun {X Y} f => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro m
        funext ψ
        have h1 : (ψ ≫ f.unop).op = f ≫ ψ.op := by rw [op_comp, Quiver.Hom.op_unop]
        show g.hom ((M.val.map ψ.op).hom ((M.val.map f).hom m)) =
          g.hom ((M.val.map (ψ ≫ f.unop).op).hom m)
        rw [h1]
        exact congrArg g.hom (PresheafOfModules.map_comp_apply M.val f ψ.op m).symm }
  refine ⟨⟨H⟩, ?_, ?_⟩
  · intro m
    show g.hom ((M.val.map (𝟙 W).op).hom m) = g.hom m
    have h := PresheafOfModules.presheaf_map_apply_coe M.val (𝟙 (Opposite.op W)) m
    rw [CategoryTheory.Functor.map_id] at h
    exact congrArg g.hom h.symm
  · intro G' hG'
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    rintro ⟨U⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro m
    funext ψ
    have e2 := hG' ((M.val.map ψ.op).hom m)
    have e1 := PresheafOfModules.naturality_apply G'.val ψ.op m
    have e3 : ((G'.val.app (Opposite.op U)).hom m : (W ⟶ U) → A) (𝟙 W ≫ ψ) =
        g.hom ((M.val.map ψ.op).hom m) :=
      (congrArg (fun s : (W ⟶ W) → A => s (𝟙 W)) e1).symm.trans e2
    simp only [Category.id_comp] at e3
    exact e3

theorem wc_pmn_unit_univ_of_skyscraper {Y Z : Scheme.{u}} (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (Vt : Y.ProEt)
    (hinit : ∀ V : Y.ProEt, Function.Bijective (fun a : Vt ⟶ V => (wcProEtBC i).map a))
    (A : ModuleCat.{u+1} ((wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt))))
    (Sk : SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (ι : ∀ U : Z.ProEt, Sk.val.obj (Opposite.op U) ≃ (((wcProEtBC i).obj Vt ⟶ U) → A))
    (hres : ∀ (U U' : Z.ProEt) (f : U' ⟶ U) (s : Sk.val.obj (Opposite.op U))
      (ψ : (wcProEtBC i).obj Vt ⟶ U'), ι U' ((Sk.val.map f.op).hom s) ψ = ι U s (ψ ≫ f))
    (hsmul : ∀ (U : Z.ProEt) (r : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U))
      (s : Sk.val.obj (Opposite.op U)) (ψ : (wcProEtBC i).obj Vt ⟶ U),
      ι U (r • s) ψ = ((wcRingSheaf Z ℓ).obj.map ψ.op).hom r • ι U s ψ)
    (hadd : ∀ (U : Z.ProEt) (s s' : Sk.val.obj (Opposite.op U)), ι U (s + s') = ι U s + ι U s')
    (M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (h : M.val.obj (Opposite.op Vt) →+ A)
    (hh : ∀ (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op Vt)) (m : M.val.obj (Opposite.op Vt)),
      h (r • m) = (show (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) from
        (Di.φ.hom.app (Opposite.op Vt)).hom r) • h m) :
    ∃! F : M ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj Sk,
      ∀ m, ι ((wcProEtBC i).obj Vt) ((F.val.app (Opposite.op Vt)).hom m) (𝟙 _) = h m :=
by
  let e : ∀ V : Y.ProEt, (Vt ⟶ V) ≃ ((wcProEtBC i).obj Vt ⟶ (wcProEtBC i).obj V) :=
    fun V => Equiv.ofBijective _ (hinit V)
  have E2 : ∀ (V : Y.ProEt) (ψ : (wcProEtBC i).obj Vt ⟶ (wcProEtBC i).obj V),
      (wcProEtBC i).map ((e V).symm ψ) = ψ :=
    fun V ψ => Equiv.ofBijective_apply_symm_apply _ (hinit V) ψ
  have E3 : (e Vt).symm (𝟙 ((wcProEtBC i).obj Vt)) = 𝟙 Vt :=
    (e Vt).symm_apply_eq.mpr ((wcProEtBC i).map_id Vt).symm
  have E4 : ∀ {V V' : Y.ProEt} (g : V' ⟶ V) (ψ' : (wcProEtBC i).obj Vt ⟶ (wcProEtBC i).obj V'),
      (e V).symm (ψ' ≫ (wcProEtBC i).map g) = (e V').symm ψ' ≫ g := by
    intro V V' g ψ'
    rw [Equiv.symm_apply_eq]
    show ψ' ≫ (wcProEtBC i).map g = (wcProEtBC i).map ((e V').symm ψ' ≫ g)
    rw [CategoryTheory.Functor.map_comp, E2]
  have ring_nat : ∀ {V V' : Y.ProEt} (a : V' ⟶ V) (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op V)),
      (Di.φ.hom.app (Opposite.op V')).hom (((wcRingSheaf Y ℓ).obj.map a.op).hom r) =
      ((wcRingSheaf Z ℓ).obj.map ((wcProEtBC i).map a).op).hom
        ((Di.φ.hom.app (Opposite.op V)).hom r) := by
    intro V V' a r
    have := congrArg (fun f => f.hom r) (Di.φ.hom.naturality a.op)
    exact this
  let lin : ∀ V : Y.ProEt, (M.val.obj (Opposite.op V)) →ₗ[(wcRingSheaf Y ℓ).obj.obj (Opposite.op V)]
      (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj Sk).val.obj
        (Opposite.op V)) := fun V =>
    { toFun := fun m => (ι ((wcProEtBC i).obj V)).symm
          (fun ψ => h ((M.val.map ((e V).symm ψ).op).hom m))
      map_add' := fun x y => by
        apply (ι ((wcProEtBC i).obj V)).injective
        funext ψ
        refine Eq.trans ?_ (congrFun (hadd _ _ _) ψ).symm
        simp only [Equiv.apply_symm_apply, Pi.add_apply]
        exact (congrArg h (map_add (M.val.map ((e V).symm ψ).op).hom x y)).trans (map_add h _ _)
      map_smul' := fun r x => by
        apply (ι ((wcProEtBC i).obj V)).injective
        funext ψ
        refine Eq.trans ?_ (hsmul _ ((Di.φ.hom.app (Opposite.op V)).hom r) _ ψ).symm
        simp only [Equiv.apply_symm_apply]
        calc h ((M.val.map ((e V).symm ψ).op).hom (r • x))
            = h (((wcRingSheaf Y ℓ).obj.map ((e V).symm ψ).op).hom r •
                (show M.val.obj (Opposite.op Vt) from (M.val.map ((e V).symm ψ).op).hom x)) :=
              congrArg h (PresheafOfModules.map_smul M.val ((e V).symm ψ).op r x)
          _ = (show (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) from
                (Di.φ.hom.app (Opposite.op Vt)).hom
                  (((wcRingSheaf Y ℓ).obj.map ((e V).symm ψ).op).hom r)) •
                h ((M.val.map ((e V).symm ψ).op).hom x) := hh _ _
          _ = ((wcRingSheaf Z ℓ).obj.map ψ.op).hom ((Di.φ.hom.app (Opposite.op V)).hom r) •
                h ((M.val.map ((e V).symm ψ).op).hom x) := by
              rw [ring_nat, E2] <;> rfl }
  let appV : ∀ V : Y.ProEt, M.val.obj (Opposite.op V) ⟶
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj Sk).val.obj
        (Opposite.op V) := fun V => ModuleCat.ofHom (X := ↑(M.val.obj (Opposite.op V)))
          (Y := ↑(((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj
            Sk).val.obj (Opposite.op V))) (lin V)
  have happ : ∀ (V : Y.ProEt) (m : M.val.obj (Opposite.op V))
      (ψ : (wcProEtBC i).obj Vt ⟶ (wcProEtBC i).obj V),
      ι ((wcProEtBC i).obj V) ((appV V).hom m) ψ = h ((M.val.map ((e V).symm ψ).op).hom m) := by
    intro V m ψ
    exact congrFun (Equiv.apply_symm_apply (ι ((wcProEtBC i).obj V))
      (fun ψ => h ((M.val.map ((e V).symm ψ).op).hom m))) ψ
  have s2 : ∀ (G : M ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj Sk),
      (∀ m, ι ((wcProEtBC i).obj Vt) ((G.val.app (Opposite.op Vt)).hom m) (𝟙 _) = h m) →
      ∀ (V : Y.ProEt) (a : Vt ⟶ V) (m : M.val.obj (Opposite.op V)),
      ι ((wcProEtBC i).obj V) ((G.val.app (Opposite.op V)).hom m) ((wcProEtBC i).map a) =
        h ((M.val.map a.op).hom m) := by
    intro G hG V a m
    have n1 := PresheafOfModules.naturality_apply G.val a.op m
    calc ι ((wcProEtBC i).obj V) ((G.val.app (Opposite.op V)).hom m) ((wcProEtBC i).map a)
        = ι ((wcProEtBC i).obj V) ((G.val.app (Opposite.op V)).hom m)
            (𝟙 _ ≫ (wcProEtBC i).map a) := by rw [Category.id_comp]
      _ = ι ((wcProEtBC i).obj Vt) ((Sk.val.map ((wcProEtBC i).map a).op).hom
            ((G.val.app (Opposite.op V)).hom m)) (𝟙 _) := (hres _ _ _ _ _).symm
      _ = ι ((wcProEtBC i).obj Vt) ((G.val.app (Opposite.op Vt)).hom ((M.val.map a.op).hom m))
            (𝟙 _) := congrArg (fun s => ι ((wcProEtBC i).obj Vt) s (𝟙 _)) n1.symm
      _ = h ((M.val.map a.op).hom m) := hG _
  have hF : ∀ m, ι ((wcProEtBC i).obj Vt)
      (((SheafOfModules.Hom.mk (PresheafOfModules.Hom.mk (fun X => appV X.unop) (by
        intro X X' f
        obtain ⟨V⟩ := X
        obtain ⟨V'⟩ := X'
        ext m
        change (appV V').hom ((M.val.map f).hom m) =
          (Sk.val.map ((wcProEtBC i).map f.unop).op).hom ((appV V).hom m)
        apply (ι ((wcProEtBC i).obj V')).injective
        funext ψ'
        refine (happ V' _ ψ').trans ?_
        refine Eq.trans ?_ (hres _ _ ((wcProEtBC i).map f.unop) _ ψ').symm
        refine Eq.trans ?_ (happ V m _).symm
        rw [E4]
        exact congrArg h (PresheafOfModules.map_comp_apply M.val f ((e V').symm ψ').op m).symm)) :
          M ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj Sk).val.app
            (Opposite.op Vt)).hom m) (𝟙 _) = h m := by
    intro m
    refine (happ Vt m (𝟙 _)).trans ?_
    rw [E3]
    have hid : (M.val.map (𝟙 Vt).op).hom m = m := by
      rw [op_id, PresheafOfModules.map_id]
      first
        | rfl
        | exact ModuleCat.restrictScalarsId'App_inv_apply _ _ _ m
        | simp
    rw [hid]
  refine ⟨_, hF, fun F' hF' => ?_⟩
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  obtain ⟨V⟩ := X
  ext m
  apply (ι ((wcProEtBC i).obj V)).injective
  funext ψ
  obtain ⟨a, rfl⟩ := (hinit V).2 ψ
  exact (s2 F' hF' V a m).trans (s2 _ hF V a m).symm

theorem wc_pmn_local_sections_const (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (R : Type u) [CommRing R] [IsLocalRing R] (eV : V.left ≅ Spec (.of R)) :
    ∀ s : C(↥V.left, ULift.{u+1} ℚ_[ℓ]), ∃ c : ℚ_[ℓ], s = ContinuousMap.const _ (ULift.up c) :=
by
  intro s
  refine ⟨(s (eV.inv (IsLocalRing.closedPoint R))).down, ?_⟩
  ext x
  rw [ContinuousMap.const_apply]
  have h1 : (eV.hom x : ↥(Spec (.of R))) ⤳ IsLocalRing.closedPoint R :=
    IsLocalRing.specializes_closedPoint (R := R) (eV.hom x)
  have h2 : eV.inv (eV.hom x) ⤳ eV.inv (IsLocalRing.closedPoint R) :=
    h1.map eV.inv.continuous
  rw [Scheme.hom_inv_apply] at h2
  have h3 : s x ⤳ s (eV.inv (IsLocalRing.closedPoint R)) := h2.map s.continuous
  exact congrArg ULift.down h3.eq

theorem wc_pmn_closed_unit_eval_bij {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (Vt : Y.ProEt)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (eB : Vt.left ≅ Spec (.of B)) (J : Ideal B) (hJ : J ≠ ⊤)
    (c : Limits.pullback Vt.hom i ⟶ Spec (.of (B ⧸ J)))
    (hsq : IsPullback (Limits.pullback.fst Vt.hom i) c eB.hom
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) :
    ∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom :=
by
  have wc_henselianRing_of_ne_top : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
      (J : Ideal B), J ≠ ⊤ → HenselianRing B J := by
    intro B _ _ J hJ
    have hJm : J ≤ IsLocalRing.maximalIdeal B := IsLocalRing.le_maximalIdeal hJ
    have h1u : ∀ x ∈ IsLocalRing.maximalIdeal B, IsUnit (1 + x) := by
      intro x hx
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro h
      have h1 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
        simpa using Ideal.sub_mem _ h hx
      exact (Ideal.ne_top_iff_one _).mp (IsLocalRing.maximalIdeal.isMaximal B).ne_top h1
    refine ⟨?_, ?_⟩
    · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
      exact hJm
    · intro f hf a₀ h₁ h₂
      have hu : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) := by
        obtain ⟨v, hv⟩ := h₂
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (v⁻¹ : (B ⧸ J)ˣ).val
        have h3 : Ideal.Quotient.mk J (Polynomial.eval a₀ (Polynomial.derivative f) * b) = 1 := by
          rw [map_mul, ← hv, hb, Units.mul_inv]
        have h4 : Polynomial.eval a₀ (Polynomial.derivative f) * b - 1 ∈ J := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, h3, map_one, sub_self]
        have h5 : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f) * b) := by
          have h6 : Polynomial.eval a₀ (Polynomial.derivative f) * b =
              1 + (Polynomial.eval a₀ (Polynomial.derivative f) * b - 1) := by ring
          rw [h6]
          exact h1u _ (hJm h4)
        exact isUnit_of_mul_isUnit_left h5
      obtain ⟨a, ha, ham⟩ := HenselianLocalRing.is_henselian f hf a₀ (hJm h₁) hu
      refine ⟨a, ha, ?_⟩
      set δ := a - a₀ with hδ
      obtain ⟨k, hk⟩ := Polynomial.binomExpansion f a₀ δ
      have hroot : Polynomial.eval a f = 0 := ha
      have ha' : a₀ + δ = a := by rw [hδ]; ring
      rw [ha', hroot] at hk

      have hu2 : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f) + k * δ) := by
        obtain ⟨w, hw⟩ := id hu
        have : Polynomial.eval a₀ (Polynomial.derivative f) + k * δ =
            Polynomial.eval a₀ (Polynomial.derivative f) * (1 + ((w⁻¹ : Bˣ) : B) * k * δ) := by
          rw [← hw, mul_add, mul_one, ← mul_assoc, ← mul_assoc, Units.mul_inv, one_mul]
        rw [this, ← hw]
        exact (Units.isUnit w).mul (h1u _ (Ideal.mul_mem_left _ _ ham))
      have hprod : δ * (Polynomial.eval a₀ (Polynomial.derivative f) + k * δ) =
          -Polynomial.eval a₀ f := by
        linear_combination hk.symm
      obtain ⟨w, hw⟩ := hu2
      have : δ = ((w⁻¹ : Bˣ) : B) * (-Polynomial.eval a₀ f) := by
        rw [← hprod, ← hw, mul_comm δ, ← mul_assoc, Units.inv_mul, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ (J.neg_mem h₁)
  have wc_semilinear_bij_of_univ : ∀ {R S : Type (u+1)} [Ring R] [Ring S] (σ : R →+* S)
      (hσ : Function.Bijective σ) (X : Type (u+1)) [AddCommGroup X] [Module R X]
      (Yv : Type (u+1)) [AddCommGroup Yv] [Module S Yv] (η : X →+ Yv)
      (hη : ∀ (r : R) (x : X), η (r • x) = σ r • η x)
      (H : ∀ (A : Type (u+1)) [AddCommGroup A] [Module S A] (h : X →+ A),
        (∀ (r : R) (x : X), h (r • x) = σ r • h x) → ∃! g : Yv →ₗ[S] A, ∀ x, g (η x) = h x),
      Function.Bijective η := by
    intro R S _ _ σ hσ X _ _ Yv _ _ η hη H
    let e := RingEquiv.ofBijective σ hσ
    have he : ∀ r, e r = σ r := fun r => rfl
    have hes : ∀ s, σ (e.symm s) = s := fun s => e.apply_symm_apply s
    letI inst : Module S X := Module.compHom X (e.symm : S →+* R)
    obtain ⟨g, hg, -⟩ := @H X _ inst (AddMonoidHom.id X) (by
      intro r x
      show r • x = (e.symm (σ r)) • x
      rw [← he, e.symm_apply_apply])
    have hinj : Function.Injective η := by
      intro x y hxy
      have h1 := hg x
      have h2 := hg y
      rw [hxy] at h1
      exact h1.symm.trans h2
    refine ⟨hinj, ?_⟩
    let k : Yv →ₗ[S] Yv :=
      { toFun := fun y => η (g y)
        map_add' := fun a b => by simp only [map_add]
        map_smul' := fun s y => by
          rw [map_smul, RingHom.id_apply]
          show η (e.symm s • g y) = s • η (g y)
          rw [hη, hes] }
    obtain ⟨g', -, hu⟩ := H Yv η hη
    have h1 : k = g' := hu k (fun x => by
      show η (g (η x)) = η x
      rw [hg]; rfl)
    have h2 : (LinearMap.id : Yv →ₗ[S] Yv) = g' := hu _ (fun x => rfl)
    intro y
    refine ⟨g y, ?_⟩
    have := congrArg (fun f : Yv →ₗ[S] Yv => f y) (h1.trans h2.symm)
    exact this
  have wc_proet_strict_local_sieve_arrows : ∀ (S : Scheme.{u}) (W : S.ProEt) (A : Type u)
      [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : W.left ≅ Spec (.of A)),
      ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U → ∀ a : W ⟶ U, T.arrows a := by
    intro S W A _ _ _ e

    have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) → Algebra.WeaklyEtale R E := by
      intro R E _ _ _ hW
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
        hW.flat_diagonal
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at hf
      rw [diagonal_SpecMap] at hd
      have hd' : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
        have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
              (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [heq]
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
      exact ⟨hf, hd'⟩

    have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
        Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
      have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
          rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc inferInstance
      let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩

    have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
        e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
      intro U V e g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of A ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
          rw [hφ]
          show e.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]

    have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
        ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
        ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
      intro U R hR W a ⟨eW⟩
      have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW.inv (IsLocalRing.closedPoint A)))
      obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀

    have s3 : ∀ (P : S.ProEt → Prop),
        (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W →
            ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
        ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
      intro P hK
      let JP : GrothendieckTopology S.ProEt :=
        GrothendieckTopology.mk
          (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
          (by
            intro U W a _
            trivial)
          (by
            intro U Y T f hT W a hW
            rw [Sieve.pullback_apply]
            exact hT W (a ≫ f) hW)
          (by
            intro U T hT R hR W a hW
            have h1 := hR (hT W a hW) W (𝟙 W) hW
            rw [Sieve.pullback_apply, Category.id_comp] at h1
            exact h1)
      have hle : Scheme.ProEt.topology S ≤ JP := by
        rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
        intro U R hR
        show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
        intro W a hW
        obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
        exact ⟨Y, h, g, hg, hhg⟩
      intro U T hT W a hW
      have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
      exact h1 W a hW
    intro U T hT a
    exact s3 (fun W' => Nonempty (W'.left ≅ Spec (.of A))) s4 U T hT W a ⟨e⟩
  have wc_pmn_closed_ring_sections_bij : ∀ (C : Type u) [CommRing C] [IsLocalRing C]
      (eW : Limits.pullback Vt.hom i ≅ Spec (.of C)),
      Function.Bijective (Di.φ.hom.app (Opposite.op Vt)).hom := by
    intro C _ _ eW
    have hcan : ∀ s : C(↥Vt.left, ULift.{u+1} ℚ_[ℓ]),
        ((Di.φ.hom.app (Opposite.op Vt)).hom s : C(↥(Limits.pullback Vt.hom i), ULift.{u+1} ℚ_[ℓ])) =
          s.comp (Limits.pullback.fst Vt.hom i).base.hom := hDi Vt
    constructor
    · intro s s' hss
      obtain ⟨c₁, hc₁⟩ := wc_pmn_local_sections_const Y ℓ Vt B eB s
      obtain ⟨c₂, hc₂⟩ := wc_pmn_local_sections_const Y ℓ Vt B eB s'
      have h1 := hcan s
      have h2 := hcan s'
      rw [hss] at h1
      have h3 := h1.symm.trans h2
      have h4 := congrArg (fun g : C(↥(Limits.pullback Vt.hom i), ULift.{u+1} ℚ_[ℓ]) =>
        g (eW.inv (IsLocalRing.closedPoint C))) h3
      simp only [ContinuousMap.comp_apply] at h4
      rw [hc₁, hc₂] at h4
      have h5 : (ULift.up c₁ : ULift.{u+1} ℚ_[ℓ]) = ULift.up c₂ := h4
      show s = s'
      rw [hc₁, hc₂, h5]
    · intro t
      obtain ⟨c₀, hc₀⟩ := wc_pmn_local_sections_const Z ℓ ((wcProEtBC i).obj Vt) C eW t
      refine ⟨(ContinuousMap.const _ (ULift.up c₀) : C(↥Vt.left, ULift.{u+1} ℚ_[ℓ])), ?_⟩
      rw [hcan, ContinuousMap.const_comp]
      exact hc₀.symm
  intro M
  haveI hc : IsIso c := hsq.isIso_snd_of_isIso
  obtain ⟨hBJ, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ

  have hW := @wc_proet_strict_local_sieve_arrows Z ((wcProEtBC i).obj Vt) (B ⧸ J) _ hBJ hsep
    (@asIso _ _ _ _ c hc)

  haveI := wc_henselianRing_of_ne_top B J hJ
  have hinit : ∀ V : Y.ProEt, Function.Bijective (fun a : Vt ⟶ V => (wcProEtBC i).map a) :=
    fun V => wc_proet_thickening_bc_hom_bijective i B J Vt eB c hsq
      (by
        intro X S f _ a b hab
        exact wc_weaklyEtale_henselian_lift f B J a b hab) V

  have hσ := wc_pmn_closed_ring_sections_bij (B ⧸ J) (@asIso _ _ _ _ c hc)
  let σ : (wcRingSheaf Y ℓ).obj.obj (Opposite.op Vt) →+*
      (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) :=
    (Di.φ.hom.app (Opposite.op Vt)).hom
  let η : M.val.obj (Opposite.op Vt) →+
      (Di.Φ.obj M).val.obj (Opposite.op ((wcProEtBC i).obj Vt)) :=
    ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom.toAddMonoidHom
  have hη : ∀ (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op Vt)) (x : M.val.obj (Opposite.op Vt)),
      η (r • x) = σ r • η x := fun r x =>
    ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom.map_smul r x

  have key : ∀ (N : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (G : Di.Φ.obj M ⟶ N)
      (m : M.val.obj (Opposite.op Vt)),
      (((Di.adj.homEquiv M N) G).val.app (Opposite.op Vt)).hom m =
        (G.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom (η m) := fun N G m =>
    congrArg (fun φ => (φ.val.app (Opposite.op Vt)).hom m) (Di.adj.homEquiv_unit M N G)

  have H : ∀ (A : Type (u+1)) [AddCommGroup A]
      [Module ((wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt))) A]
      (h : M.val.obj (Opposite.op Vt) →+ A),
      (∀ (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op Vt)) (x : M.val.obj (Opposite.op Vt)),
        h (r • x) = σ r • h x) →
      ∃! g : (Di.Φ.obj M).val.obj (Opposite.op ((wcProEtBC i).obj Vt)) →ₗ[
          (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt))] A,
        ∀ x, g (η x) = h x := by
    intro A _ _ h hh
    obtain ⟨Sk, ι, hres, hsmul, hadd, huniv⟩ := wc_sheafOfModules_skyscraper Z ℓ
      ((wcProEtBC i).obj Vt) hW (ModuleCat.of _ A)
    obtain ⟨F, hF, hFu⟩ := wc_pmn_unit_univ_of_skyscraper i ℓ Di Vt hinit (ModuleCat.of _ A) Sk ι
      hres hsmul hadd M h hh
    have hprop : ∀ (G : Di.Φ.obj M ⟶ Sk)
        (g : (Di.Φ.obj M).val.obj (Opposite.op ((wcProEtBC i).obj Vt)) → A),
        (∀ y, ι ((wcProEtBC i).obj Vt)
          ((G.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom y) (𝟙 _) = g y) →
        (∀ x, g (η x) = h x) → (Di.adj.homEquiv M Sk) G = F := by
      intro G g hG hg
      refine hFu _ (fun m => ?_)
      rw [key Sk G m, hG, hg]
    let F' := (Di.adj.homEquiv M Sk).symm F
    have hFF : (Di.adj.homEquiv M Sk) F' = F := (Di.adj.homEquiv M Sk).apply_symm_apply F
    let g : (Di.Φ.obj M).val.obj (Opposite.op ((wcProEtBC i).obj Vt)) →ₗ[
        (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt))] A :=
      { toFun := fun y => ι ((wcProEtBC i).obj Vt)
          ((F'.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom y) (𝟙 _)
        map_add' := fun y y' => by
          show ι ((wcProEtBC i).obj Vt) ((F'.val.app _).hom (y + y')) (𝟙 _) =
            ι ((wcProEtBC i).obj Vt) ((F'.val.app _).hom y) (𝟙 _) +
              ι ((wcProEtBC i).obj Vt) ((F'.val.app _).hom y') (𝟙 _)
          rw [map_add, hadd]
          rfl
        map_smul' := fun r y => by
          show ι ((wcProEtBC i).obj Vt) ((F'.val.app _).hom (r • y)) (𝟙 _) =
            r • ι ((wcProEtBC i).obj Vt) ((F'.val.app _).hom y) (𝟙 _)
          rw [LinearMap.map_smul, hsmul]
          congr 1 }
    have hg : ∀ x, g (η x) = h x := by
      intro x
      have e1 := key Sk F' x
      rw [hFF] at e1
      have e2 := hF x
      rw [e1] at e2
      exact e2
    refine ⟨g, hg, fun g₂ hg₂ => ?_⟩
    obtain ⟨G₂, hG₂, -⟩ := huniv (Di.Φ.obj M) (ModuleCat.ofHom g₂)
    have e2 : (Di.adj.homEquiv M Sk) G₂ = F := hprop G₂ g₂ (fun y => hG₂ y) hg₂
    have e1 : F' = G₂ := by
      apply (Di.adj.homEquiv M Sk).injective
      rw [hFF, e2]
    refine LinearMap.ext fun y => ?_
    have h2 := hG₂ y
    rw [ModuleCat.hom_ofHom] at h2
    rw [← h2, ← e1]
    rfl
  have hbij := wc_semilinear_bij_of_univ σ hσ (M.val.obj (Opposite.op Vt))
    ((Di.Φ.obj M).val.obj (Opposite.op ((wcProEtBC i).obj Vt))) η hη H
  exact hbij

theorem wc_pmn_shens_closed_fibre_square (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ (J : Ideal B) (c : Limits.pullback a'
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ⟶
          Spec (.of (B ⧸ J))),
      IsPullback (Limits.pullback.fst a'
          (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))) c
        (𝟙 (Spec (.of B))) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) ∧ J ≠ ⊤ :=
by
  classical
  set g := Limits.pullback.fst V.hom D.f ≫ e.hom with hg

  let φ : A →+* B := (Spec.preimage (a' ≫ g)).hom
  have hφ : Spec.map (CommRingCat.ofHom φ) = a' ≫ g := by
    rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage _
  let J : Ideal B := Ideal.map φ (IsLocalRing.maximalIdeal A)

  obtain ⟨-, -, -, -, -, ε, -, he⟩ := hsh
  have hgeom : ∀ z, wcEtGeomPt ((wcProEtPullback D.f).obj V).left x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _
  have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
      IsLocalRing.closedPoint B :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
  have ha : a' (IsLocalRing.closedPoint B) = x := by
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint
      (AlgebraicClosure (((wcProEtPullback D.f).obj V).left.residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'

  have hgx : g x = IsLocalRing.closedPoint A := by
    show (Limits.pullback.fst V.hom D.f ≫ e.hom) x = IsLocalRing.closedPoint A
    exact (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg e.hom hx₁).trans (Scheme.inv_hom_apply e _))
  have hclosed : (Spec.map (CommRingCat.ofHom φ)) (IsLocalRing.closedPoint B) =
      IsLocalRing.closedPoint A := by
    rw [hφ]
    exact (Scheme.Hom.comp_apply a' g _).trans ((congrArg g ha).trans hgx)
  have hcomap : Ideal.comap φ (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A := by
    have := congrArg PrimeSpectrum.asIdeal hclosed
    exact this

  have hJ : J ≠ ⊤ := by
    intro hJt
    have hle : J ≤ IsLocalRing.maximalIdeal B := by
      rw [Ideal.map_le_iff_le_comap, hcomap]
    rw [hJt, top_le_iff] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top hle

  have h2 : IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))
      (Spec.map (CommRingCat.ofHom (Ideal.quotientMap J φ
        (Ideal.le_comap_map (I := IsLocalRing.maximalIdeal A)))))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)))) := by
    set I := IsLocalRing.maximalIdeal A
    apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
    have hcomm : ∀ r : A, Ideal.quotientMap J φ (Ideal.le_comap_map (I := I))
        (Ideal.Quotient.mk I r) = Ideal.Quotient.mk J (φ r) := fun r =>
      Ideal.quotientMap_mk
    have w : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
        CommRingCat.ofHom (Ideal.quotientMap J φ (Ideal.le_comap_map (I := I))) := by
      ext r
      exact (hcomm r).symm
    have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I))) (r : A),
        s.inl.hom (φ r) = s.inr.hom (Ideal.Quotient.mk I r) := by
      intro s r
      have := congrArg (fun ψ => ψ.hom r) s.condition
      simpa using this
    have H : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I))), J ≤ RingHom.ker s.inl.hom := by
      intro s
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, key s x, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
        map_zero]
    refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk w
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (fun a ha => H s ha)))
      ?_ ?_ ?_)
    · intro s
      ext x
      exact Ideal.Quotient.lift_mk J s.inl.hom (fun a ha => H s ha)
    · intro s
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, hcomm, Ideal.Quotient.lift_mk]
      exact key s x
    · intro s m h1 _
      ext x
      have := congrArg (fun ψ => ψ.hom x) h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply] at this
      simp only [CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
      exact this

  have h1 : IsPullback (Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A)))
      (Limits.pullback.snd a' (Limits.pullback.fst g (wcQmSp A)) ≫
        Limits.pullback.snd g (wcQmSp A))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)))) := by
    rw [hφ]
    exact (IsPullback.paste_horiz
      (IsPullback.of_hasPullback a' (Limits.pullback.fst g (wcQmSp A))).flip
      (IsPullback.of_hasPullback g (wcQmSp A)).flip).flip

  let E := IsPullback.isoIsPullback _ _ h1 h2
  have hfst : E.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) =
      Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A)) :=
    IsPullback.isoIsPullback_hom_fst _ _ _ _
  refine ⟨J, E.hom, ?_, hJ⟩
  exact IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, hfst]⟩

theorem wc_pmn_corep_projective_quot (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (J : Ideal B) (hJ : J ≠ ⊤) (eW : W.left ≅ Spec (.of (B ⧸ J))) :
    ∃ (Ps : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (Ps ⟶ M) ≃ M.val.obj (Opposite.op W)),
      Projective Ps ∧
      ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : Ps ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev M g) :=
by
  classical
  obtain ⟨Ps, ev, hnat, -⟩ :=
    sheafOfModules_free_yoneda (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) W

  haveI hnt : Nontrivial (B ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  haveI : IsLocalRing (B ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  haveI hloc : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hstar : ∀ x : B, x ∈ IsLocalRing.maximalIdeal B ↔
      Ideal.Quotient.mk J x ∈ IsLocalRing.maximalIdeal (B ⧸ J) := by
    intro x
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      mem_nonunits_iff]
    exact ⟨fun h hu => h (isUnit_of_map_unit _ x hu), fun h hu => h (hu.map _)⟩
  haveI hhen : HenselianLocalRing (B ⧸ J) := by
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ h1 h2
    have hlift : f ∈ Polynomial.lifts (Ideal.Quotient.mk J) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact Ideal.Quotient.mk_surjective (f.coeff n)
    obtain ⟨g, hg, -, hgm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hf
    obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective a₀
    have e1 : Polynomial.eval b₀ g ∈ IsLocalRing.maximalIdeal B := by
      rw [hstar, ← Polynomial.eval_map_apply, hg]
      exact h1
    have e2 : IsUnit (Polynomial.eval b₀ (Polynomial.derivative g)) := by
      apply isUnit_of_map_unit (Ideal.Quotient.mk J)
      rw [← Polynomial.eval_map_apply, ← Polynomial.derivative_map, hg]
      exact h2
    obtain ⟨a, ha, hab⟩ := HenselianLocalRing.is_henselian g hgm b₀ e1 e2
    refine ⟨Ideal.Quotient.mk J a, ?_, ?_⟩
    · have := Polynomial.IsRoot.map (f := Ideal.Quotient.mk J) ha
      rwa [hg] at this
    · rw [← map_sub, ← hstar]
      exact hab

  haveI hsep : IsSepClosed (IsLocalRing.ResidueField (B ⧸ J)) := by
    let ψ := IsLocalRing.ResidueField.map (Ideal.Quotient.mk J)
    have hsurj : Function.Surjective ψ := by
      intro z
      obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
      exact ⟨IsLocalRing.residue B b, IsLocalRing.ResidueField.map_residue _ b⟩
    let e := RingEquiv.ofBijective ψ ⟨ψ.injective, hsurj⟩
    refine IsSepClosed.of_exists_root _ ?_
    intro p hpm hirr hsepp
    have hr : (p.map (e.symm : IsLocalRing.ResidueField (B ⧸ J) →+*
        IsLocalRing.ResidueField B)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
      exact (hirr.degree_pos).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hr hsepp.map
    refine ⟨(e : IsLocalRing.ResidueField B →+* IsLocalRing.ResidueField (B ⧸ J)) x, ?_⟩
    have hpe : (p.map (e.symm : IsLocalRing.ResidueField (B ⧸ J) →+*
        IsLocalRing.ResidueField B)).map
        (e : IsLocalRing.ResidueField B →+* IsLocalRing.ResidueField (B ⧸ J)) = p := by
      rw [Polynomial.map_map, RingEquiv.comp_symm, Polynomial.map_id]
    rw [← hpe, Polynomial.eval_map_apply, hx.eq_zero, map_zero]

  have hW : Projective (wcFreeSheaf S W) := wc_proet_free_projective_strict_local S W (B ⧸ J) eW

  have hPs : Projective Ps := by
    obtain ⟨e, he, -⟩ := proet_free_sheaf_hom_equiv S W
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) :=
      sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
    refine ⟨fun {E X} g p _ => ?_⟩
    haveI : Epi ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p) := Functor.map_epi _ p
    obtain ⟨x, hx⟩ : ∃ x : ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj X).obj.obj
        (Opposite.op W), x = ev X g := ⟨_, rfl⟩
    obtain ⟨φ', hφ'⟩ := Projective.factors
      ((e ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj X)).symm x)
      ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p)
    obtain ⟨m, hm⟩ : ∃ m : E.val.obj (Opposite.op W),
        m = e ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj E) φ' := ⟨_, rfl⟩
    have h1 := he _ _ ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p) φ'
    rw [hφ', Equiv.apply_symm_apply] at h1
    refine ⟨(ev E).symm m, ?_⟩
    apply (ev X).injective
    rw [hnat, Equiv.apply_symm_apply]
    subst hm hx
    exact h1.symm
  exact ⟨Ps, ev, hPs, hnat⟩

theorem wc_pmn_res_cocycle_not_cobound (S' : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S'.ProEt)
    (DV : wcHMPullData V.hom ℓ) (hDV : wcHMPullCanonical DV)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf S' ℓ)))
    (N p : ℕ) (hp : p + 1 = N) (f : SheafOfModules.unit (wcRingSheaf S' ℓ) ⟶ I.cocomplex.X N)
    (hf : f ≫ I.cocomplex.d N (N + 1) = 0)
    (hres : letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
      wcHMPull DV N (I.extMk f (N + 1) rfl hf) ≠ 0) :
    ∀ c : ℚ_[ℓ], c ≠ 0 → ∀ τ : (I.cocomplex.X p).val.obj (Opposite.op V),
      ((I.cocomplex.d p N).val.app (Opposite.op V)).hom τ ≠
        (f.val.app (Opposite.op V)).hom
          (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ContinuousMap.const _ (ULift.up c)) :=
by
  classical
  intro c hc τ hcob
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  obtain ⟨P, ev, hnat, hadd⟩ := sheafOfModules_free_yoneda (Scheme.ProEt.topology S')
    (wcRingSheaf S' ℓ) V
  obtain ⟨Θ, hΘ⟩ := wc_proet_free_slice_module_ext S' ℓ V P ev hnat hadd DV hDV N
  obtain ⟨hone, hmul⟩ := wc_hm_fun_one_mul V.left ℓ
  obtain ⟨r, hr⟩ : ∃ r : C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
      r = ContinuousMap.const _ (ULift.up c) := ⟨_, rfl⟩
  obtain ⟨ρ, hρ⟩ : ∃ ρ : P ⟶ SheafOfModules.unit (wcRingSheaf S' ℓ),
      ρ = (ev _).symm r := ⟨_, rfl⟩
  have hρe : ev _ ρ = r := by
    rw [hρ]
    exact Equiv.apply_symm_apply _ _
  obtain ⟨k, hk⟩ : ∃ k : P ⟶ I.cocomplex.X p, ev _ k = τ :=
    ⟨(ev _).symm τ, Equiv.apply_symm_apply _ _⟩
  have hsum : ρ ≫ f = k ≫ I.cocomplex.d p N := by
    apply (ev (I.cocomplex.X N)).injective
    rw [hnat, hnat, hρe, hk, hr]
    exact hcob.symm
  have hu : (ρ ≫ f) ≫ I.cocomplex.d N (N + 1) = 0 := by
    rw [Category.assoc, hf, Limits.comp_zero]
  have hvan : (Abelian.Ext.mk₀ ρ).comp (I.extMk f (N + 1) rfl hf) (zero_add N) = 0 := by
    rw [InjectiveResolution.mk₀_comp_extMk]
    exact (I.extMk_eq_zero_iff (ρ ≫ f) (N + 1) rfl hu p hp).mpr ⟨k, hsum.symm⟩
  have hF : (Abelian.Ext.mk₀ (wcHMFun V.left ℓ r)).comp
      (wcHMPull DV N (I.extMk f (N + 1) rfl hf)) (zero_add N) = 0 := by
    have h1 := hΘ r (I.extMk f (N + 1) rfl hf)
    rw [← hρ, hvan, map_zero] at h1
    exact h1.symm
  have hmulc : (ContinuousMap.const _ (ULift.up c⁻¹) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) * r = 1 := by
    rw [hr]
    refine ContinuousMap.ext (fun x => ULift.ext _ _ ?_)
    show c⁻¹ * c = (1 : ℚ_[ℓ])
    exact inv_mul_cancel₀ hc
  have hinv : wcHMFun V.left ℓ (ContinuousMap.const _ (ULift.up c⁻¹)) ≫ wcHMFun V.left ℓ r =
      𝟙 _ := by
    rw [← hmul, hmulc, hone]
  apply hres
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme.{u}).obj V.left) ℓ)) :=
    HasExt.standard _
  generalize wcHMPull DV N (I.extMk f (N + 1) rfl hf) = z at hF ⊢
  calc z = (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcRingSheaf V.left ℓ)))).comp z
        (zero_add N) := (Abelian.Ext.mk₀_id_comp z).symm
    _ = (Abelian.Ext.mk₀ (wcHMFun V.left ℓ (ContinuousMap.const _ (ULift.up c⁻¹)) ≫
          wcHMFun V.left ℓ r)).comp z (zero_add N) := by rw [hinv]
    _ = ((Abelian.Ext.mk₀ (wcHMFun V.left ℓ (ContinuousMap.const _ (ULift.up c⁻¹)))).comp
          (Abelian.Ext.mk₀ (wcHMFun V.left ℓ r)) (add_zero 0)).comp z (zero_add N) := by
        rw [Abelian.Ext.mk₀_comp_mk₀]
    _ = (Abelian.Ext.mk₀ (wcHMFun V.left ℓ (ContinuousMap.const _ (ULift.up c⁻¹)))).comp
          ((Abelian.Ext.mk₀ (wcHMFun V.left ℓ r)).comp z (zero_add N)) (zero_add N) :=
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add N) (by omega)
    _ = 0 := by rw [hF, Abelian.Ext.comp_zero]

theorem wc_pmn_can_detects_res (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dr : wcHMPullData (Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left) ℓ)
    (hDr : wcHMPullCanonical Dr)
    (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData (S := ((wcProEtPullback D.f).obj V).left)
      (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ)
    (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ))) :
    haveI := Dp.additive
    haveI := Di.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let eK := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map Di.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj V).left ℓ)) ≫
        (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)) :=
      HasExt.standard _
    let F := P ⋙ Di.Φ
    let Ψ := (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    let Hq := HomotopyCategory.quotient (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
      (ComplexShape.up ℤ)
    let Hq' := HomotopyCategory.quotient (SheafOfModules.{u+1}
      (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)) (ComplexShape.up ℤ)
    let c := fun y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1) =>
      (show Hq.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcRingSheaf
            (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))) ⟶
          (Hq.obj Ψ)⟦((n - 1 : ℕ) : ℤ)⟧ from
        Hq.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
              (Di.μ.inv ≫ Di.Φ.map
                (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
                  (wcProEtBC ((wcProEtPullback D.f).map a₀).left) _ _ Dp.cont Dp.φ))) ≫
          Hq.map ((HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).inv.app
              (SheafOfModules.unit (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ))) ≫
          (F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).hom.app _ ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            (CochainComplex.HomComplex.CohomologyClass.homAddEquiv (I.extEquivCohomologyClass y)) ≫
          (F.mapHomotopyCategory (ComplexShape.up ℤ)).map
            ((Hq'.commShiftIso ((n - 1 : ℕ) : ℤ)).hom.app I.cochainComplex) ≫
          ((F.mapHomotopyCategory (ComplexShape.up ℤ)).commShiftIso ((n - 1 : ℕ) : ℤ)).hom.app
            (Hq'.obj I.cochainComplex) ≫
          ((F.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).inv.app
            I.cochainComplex)⟦((n - 1 : ℕ) : ℤ)⟧' ≫
          (Hq.map ((Functor.mapHomologicalComplexCompIso (Iso.refl F) (ComplexShape.up ℤ)).inv.app
              I.cochainComplex))⟦((n - 1 : ℕ) : ℤ)⟧')
    let β := fun y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1) =>
      (show DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcRingSheaf
            (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))) ⟶
          (DerivedCategory.Q.obj Ψ)⟦((n - 1 : ℕ) : ℤ)⟧ from
        (DerivedCategory.quotientCompQhIso _).inv.app _ ≫ DerivedCategory.Qh.map (c y) ≫
          (DerivedCategory.Qh.commShiftIso ((n - 1 : ℕ) : ℤ)).hom.app (Hq.obj Ψ) ≫
          ((DerivedCategory.quotientCompQhIso _).hom.app Ψ)⟦((n - 1 : ℕ) : ℤ)⟧')
    ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1), wcHMPull Dr (n - 1) y ≠ 0 →
      β y ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦((n - 1 : ℕ) : ℤ)⟧' ≠ 0 :=
by
  intro P K eK eΨ F Ψ Hq Hq' c β y hy hzero
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)) ℓ))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((wcProEtPullback D.f).obj E).left ℓ)) :=
    HasExt.standard _
  haveI := Dp.additive
  haveI := Di.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
  obtain ⟨p, hp⟩ : ∃ p, p + 1 = n - 1 := ⟨n - 2, by omega⟩
  obtain ⟨f, hf, rfl⟩ := I.extMk_surjective y (n - 1 + 1) rfl
