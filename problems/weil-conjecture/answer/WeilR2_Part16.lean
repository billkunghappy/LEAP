    · apply hcov
      intro p
      obtain ⟨T, h, t, ht, hs⟩ := hloc p
      refine ⟨T, h, ?_, t, ht⟩
      rw [Presheaf.equalizerSieve_apply, map_zero]
      exact hs
    · intro T f hf
      rw [Presheaf.equalizerSieve_apply] at hf
      exact hf

  have s3 : ∀ (Z : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      {U U' : Z.Etale} (k : U' ⟶ U) (s : G.obj.obj (Opposite.op U)) (p' : U'.left),
      (∃ (T : Z.Etale) (h : T ⟶ U) (t : T.left), h.left t = k.left p' ∧
