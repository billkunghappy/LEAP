    have hγi : γ'.inv ≫ uu = aa := by rw [← hγ', Iso.inv_hom_id_assoc]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa,
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γ'.hom :=
      ⟨Limits.pullback.lift (Limits.pullback.snd uu ff) (Limits.pullback.fst uu ff ≫ γ'.hom)
        (by rw [Category.assoc, hγ']; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨κ', hκ'1, hκ'2⟩ : ∃ κ' : Limits.pullback ff aa ⟶ Limits.pullback uu ff,
        κ' ≫ Limits.pullback.fst uu ff = Limits.pullback.snd ff aa ≫ γ'.inv ∧
        κ' ≫ Limits.pullback.snd uu ff = Limits.pullback.fst ff aa :=
      ⟨Limits.pullback.lift (Limits.pullback.snd ff aa ≫ γ'.inv) (Limits.pullback.fst ff aa)
        (by rw [Category.assoc, hγi]; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hκκ' : κ ≫ κ' = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ'1, reassoc_of% hκ2, Iso.hom_inv_id, Category.comp_id,
          Category.id_comp]
      · rw [Category.assoc, hκ'2, hκ1, Category.id_comp]
    have hκ'κ : κ' ≫ κ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ1, hκ'2, Category.id_comp]
      · rw [Category.assoc, hκ2, reassoc_of% hκ'1, Iso.inv_hom_id, Category.comp_id,
          Category.id_comp]
    exact ⟨κ, ⟨⟨κ', hκκ', hκ'κ⟩⟩, hκ1, hκ2⟩
  obtain ⟨κ, hκiso, hκ1, hκ2⟩ := hisoG D.f V.hom ac γ hγV
  haveI := hκiso
  have hx₀ : Limits.pullback.fst D.f ac (κ x) = D.xs i (IsLocalRing.closedPoint F'') := by
    have h1 := Scheme.Hom.comp_apply κ (Limits.pullback.fst D.f ac) x
    rw [hκ1] at h1
