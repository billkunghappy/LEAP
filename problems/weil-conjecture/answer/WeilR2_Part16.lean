theorem wc_pmn_beta_equivariant {S S' Z : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {g : Z ⟶ S}
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hcomp : w ≫ f = f) (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf S' ℓ))) (N : ℕ) :
    haveI := Df.cont
    haveI := Dw.cont
    haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous (Scheme.ProEt.topology S)
