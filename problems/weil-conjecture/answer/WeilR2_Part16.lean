    change (((wcSliceRes S ℓ W).map ((ev W (P W)).symm (s • ev W (P W) (𝟙 _)))).val.app
        (Opposite.op T)).hom (((ε W).val.app (Opposite.op T)).hom
          (1 : ↑((wcRingSheaf W.left ℓ).val.obj (Opposite.op T)))) =
      ((ε W).val.app (Opposite.op T)).hom
        (((wcHMFun W.left ℓ (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from s)).val.app
          (Opposite.op T)).hom (1 : ↑((wcRingSheaf W.left ℓ).val.obj (Opposite.op T))))
    rw [hσ, hR, hT']
    change (((ev W (P W)).symm (s • ev W (P W) (𝟙 _))).val.app
        (Opposite.op ((wcSliceFunctor S W).obj T))).hom
        (((P W).val.map hTm.op).hom (ev W (P W) (𝟙 _))) = _
    rw [PresheafOfModules.naturality_apply, ha, PresheafOfModules.map_smul]
    rfl
  obtain ⟨Θ₀, hΘ₀⟩ : ∃ Θ₀ : ∀ (q : ℕ) (W : S.ProEt),
      Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S ℓ)) q →+ wcHM W.left ℓ q,
      ∀ q W β, Θ₀ q W β =
        ((Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (wcSliceRes S ℓ W) β)
