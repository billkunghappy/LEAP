    intro h0
    have h1 : ((ℓ : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]
      exact h0
    have hp : Nat.Prime (ringChar F'') := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).1 h1
    have heq : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out : Nat.Prime ℓ)).1 hdvd
    letI := Fintype.ofFinite F''
    have h2 : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F''
    have h3 : ringChar F'' ∣ Nat.card F'' := (ringChar.spec F'' _).1 h2
