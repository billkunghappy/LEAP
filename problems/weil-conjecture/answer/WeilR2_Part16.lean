      (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op V)),
      ((wcRingSheaf Z ℓ).obj.map a.op).hom ((Di.φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.ProEt.topology Z V', ∀ ⦃W' : Z.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : Y.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC i).obj W),
          a' ≫ (wcProEtBC i).map b = g ≫ a ∧ ((wcRingSheaf Y ℓ).obj.map b.op).hom r = 0 := by
    intro V' V a r h0
    have h0' := (congrArg (fun s : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) =>
      s.comp a.left.base.hom) (hDi V r)).symm.trans h0
    obtain ⟨T, hT, H⟩ := hi0 V' V a r h0'
    exact ⟨T, hT, fun W' g hg => H g hg⟩

  letI : Limits.HasColimitsOfSize.{u, u+1} RingCat.{u+1} :=
    Limits.hasColimitsOfSizeShrink.{u, u+1, u+1, u+1} RingCat.{u+1}
  let R₀ : (Z.ProEt)ᵒᵖ ⥤ RingCat.{u+1} := (wcProEtBC i).op.leftKanExtension (wcRingSheaf Y ℓ).obj
  let ψ : (wcRingSheaf Y ℓ).obj ⟶ (wcProEtBC i).op ⋙ R₀ :=
    (wcProEtBC i).op.leftKanExtensionUnit (wcRingSheaf Y ℓ).obj
  let hψ : (Functor.LeftExtension.mk R₀ ψ).IsPointwiseLeftKanExtension :=
    (wcProEtBC i).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit (wcRingSheaf Y ℓ).obj
  haveI : R₀.IsLeftKanExtension ψ := hψ.isLeftKanExtension
  let α : R₀ ⟶ (wcRingSheaf Z ℓ).obj := R₀.descOfIsLeftKanExtension ψ (wcRingSheaf Z ℓ).obj Di.φ.hom
  have hfac : ψ ≫ Functor.whiskerLeft (wcProEtBC i).op α = Di.φ.hom :=
    R₀.descOfIsLeftKanExtension_fac ψ (wcRingSheaf Z ℓ).obj Di.φ.hom

  obtain ⟨RS, RI⟩ := wc_lan_ring_rep (wcProEtBC i) (wcRingSheaf Y ℓ).obj R₀ ψ hψ
  have hAB := fun M : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj =>
    wc_lan_ab_rep (wcProEtBC i) M.presheaf ((wcProEtBC i).op.lan.obj M.presheaf)
      ((wcProEtBC i).op.lanUnit.app M.presheaf)
      ((wcProEtBC i).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit M.presheaf)
  have JR := fun M : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj =>
    wc_lan_joint_rep (wcProEtBC i) (wcRingSheaf Y ℓ).obj R₀ ψ M.presheaf
      ((wcProEtBC i).op.lan.obj M.presheaf) ((wcProEtBC i).op.lanUnit.app M.presheaf) RS (hAB M).1
  have WD := fun M : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj =>
    wc_lan_smul_well_defined (wcProEtBC i) (wcRingSheaf Y ℓ).obj R₀ ψ M
      ((wcProEtBC i).op.lan.obj M.presheaf) ((wcProEtBC i).op.lanUnit.app M.presheaf) RI (hAB M).2
  choose N e hF using fun M : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj =>
    wc_lan_presheafOfModules_mk (wcProEtBC i) (wcRingSheaf Y ℓ).obj R₀ ψ M
      ((wcProEtBC i).op.lan.obj M.presheaf) ((wcProEtBC i).op.lanUnit.app M.presheaf) (WD M) (JR M)

  obtain ⟨Λ, adjΛ, ι, hunit⟩ := s1 (wcProEtBC i) (wcRingSheaf Y ℓ).obj R₀ ψ N e hF
    (fun M Y x t => by
      obtain ⟨W, b, r, _, m, _, hx, _, ht, _⟩ := JR M Y x x t t
      exact ⟨W, b, r, m, hx, ht⟩)

  obtain ⟨hLS, hLI⟩ := wc_lan_ring_comparison_locally_bijective (Scheme.ProEt.topology Y)
    (Scheme.ProEt.topology Z) (wcProEtBC i) (wcRingSheaf Y ℓ) (wcRingSheaf Z ℓ) Di.φ R₀ ψ α hfac
    RS hsurj hinj
  haveI := hLS
  haveI := hLI

  obtain ⟨ι₂⟩ := wc_presheafOfModules_pushforward_restrictScalars_iso (wcProEtBC i) ψ α Di.φ.hom hfac
  let eD : SheafOfModules.pushforward.{u+1} Di.φ ⋙ SheafOfModules.forget (wcRingSheaf Y ℓ) ≅
      SheafOfModules.forget (wcRingSheaf Z ℓ) ⋙ PresheafOfModules.restrictScalars α ⋙
        PresheafOfModules.pushforward.{u+1} ψ :=
    (Iso.refl _ : SheafOfModules.pushforward.{u+1} Di.φ ⋙ SheafOfModules.forget (wcRingSheaf Y ℓ) ≅
      SheafOfModules.forget (wcRingSheaf Z ℓ) ⋙ PresheafOfModules.pushforward.{u+1} Di.φ.hom) ≪≫
      Functor.isoWhiskerLeft (SheafOfModules.forget (wcRingSheaf Z ℓ)) ι₂
  let L := SheafOfModules.forget (wcRingSheaf Y ℓ) ⋙ Λ ⋙ PresheafOfModules.sheafification α
  let adjS := (adjΛ.comp (PresheafOfModules.sheafificationAdjunction α)).restrictFullyFaithful
    (SheafOfModules.fullyFaithfulForget (wcRingSheaf Y ℓ)) (Functor.FullyFaithful.id _)
    (L := L) (R := SheafOfModules.pushforward.{u+1} Di.φ) (Iso.refl _) eD.symm
  have hstar := Adjunction.map_restrictFullyFaithful_unit_app
    (adjΛ.comp (PresheafOfModules.sheafificationAdjunction α))
    (SheafOfModules.fullyFaithfulForget (wcRingSheaf Y ℓ)) (Functor.FullyFaithful.id _)
    (L := L) (R := SheafOfModules.pushforward.{u+1} Di.φ) (Iso.refl _) eD.symm M
  rw [Adjunction.comp_unit_app] at hstar
  have hbij : ∀ {P Q : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj} (f : P ≅ Q)
      (X : (Y.ProEt)ᵒᵖ), Function.Bijective (f.hom.app X).hom := fun f X =>
    ConcreteCategory.bijective_of_isIso ((PresheafOfModules.evaluation _ X).mapIso f).hom
  let M' : PresheafOfModules.{u+1} (wcRingSheaf Y ℓ).obj := M.val
  let smIso : sheafify (Scheme.ProEt.topology Z) ((wcProEtBC i).op.lan.obj M'.presheaf) ≅
      sheafify (Scheme.ProEt.topology Z) (Λ.obj M').presheaf :=
    { hom := sheafifyMap (Scheme.ProEt.topology Z) (ι M').inv
      inv := sheafifyMap (Scheme.ProEt.topology Z) (ι M').hom
      hom_inv_id := by rw [← sheafifyMap_comp, Iso.inv_hom_id, sheafifyMap_id]
      inv_hom_id := by rw [← sheafifyMap_comp, Iso.hom_inv_id, sheafifyMap_id] }
  have hsm : Function.Bijective
      ((sheafifyMap (Scheme.ProEt.topology Z) (ι M').inv).app
        (Opposite.op ((wcProEtBC i).obj Vt))).hom :=
    ConcreteCategory.bijective_of_isIso (smIso.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
  have hc3 : Function.Bijective ((eD.symm.hom.app (L.obj M)).app (Opposite.op Vt)).hom :=
    hbij (eD.symm.app (L.obj M)) (Opposite.op Vt)
  have h' : Function.Bijective (⇑((toSheafify (Scheme.ProEt.topology Z)
        ((wcProEtBC i).op.lan.obj M'.presheaf)).app (Opposite.op ((wcProEtBC i).obj Vt))).hom ∘
      ⇑(((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom) := h
  have e0 : ⇑((adjS.unit.app M).val.app (Opposite.op Vt)).hom =
      ⇑((eD.symm.hom.app (L.obj M)).app (Opposite.op Vt)).hom ∘
        (⇑((sheafifyMap (Scheme.ProEt.topology Z) (ι M').inv).app
            (Opposite.op ((wcProEtBC i).obj Vt))).hom ∘
          (⇑((toSheafify (Scheme.ProEt.topology Z)
              ((wcProEtBC i).op.lan.obj M'.presheaf)).app (Opposite.op ((wcProEtBC i).obj Vt))).hom ∘
            ⇑(((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom)) := by
    funext m
    have h1 := congrArg (fun k => (k.app (Opposite.op Vt)).hom m) hstar
    have h2 : ((adjΛ.unit.app M').app (Opposite.op Vt)).hom m =
        ((ι M').inv.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
          ((((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom m) := by
      rw [← hunit M' Vt m]
      exact (congrArg (fun k : (Λ.obj M').presheaf ⟶ (Λ.obj M').presheaf =>
        (k.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
          (((adjΛ.unit.app M').app (Opposite.op Vt)).hom m)) (ι M').hom_inv_id).symm
    have h3 := congrArg (fun k => (k.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
        (((adjΛ.unit.app M').app (Opposite.op Vt)).hom m))
      (PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app α (Λ.obj M'))
    have h4 := congrArg (fun k => (k.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
        ((((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom m))
      (toSheafify_naturality (Scheme.ProEt.topology Z) (ι M').inv)
    refine h1.trans (congrArg (fun y => ((eD.symm.hom.app (L.obj M)).app (Opposite.op Vt)).hom y) ?_)
    refine h3.trans ?_
    refine (congrArg (fun z => ((toSheafify (Scheme.ProEt.topology Z) (Λ.obj M').presheaf).app
      (Opposite.op ((wcProEtBC i).obj Vt))).hom z) h2).trans ?_
    exact h4
  have hS : Function.Bijective ((adjS.unit.app M).val.app (Opposite.op Vt)).hom := by
    rw [e0]
    exact hc3.comp (hsm.comp h')

  have huniq := Adjunction.unit_leftAdjointUniq_hom_app adjS Di.adj M
  have hc4 : Function.Bijective (((SheafOfModules.pushforward.{u+1} Di.φ).map
      ((adjS.leftAdjointUniq Di.adj).hom.app M)).val.app (Opposite.op Vt)).hom :=
    hbij ((SheafOfModules.forget _).mapIso
      ((SheafOfModules.pushforward.{u+1} Di.φ).mapIso ((adjS.leftAdjointUniq Di.adj).app M)))
      (Opposite.op Vt)
  have e1 : ⇑((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom =
      ⇑(((SheafOfModules.pushforward.{u+1} Di.φ).map
        ((adjS.leftAdjointUniq Di.adj).hom.app M)).val.app (Opposite.op Vt)).hom ∘
        ⇑((adjS.unit.app M).val.app (Opposite.op Vt)).hom := by
    funext x
    exact (congrArg (fun k => (k.val.app (Opposite.op Vt)).hom x) huniq).symm
  rw [e1]
  exact hc4.comp hS

theorem wc_pmn_vp_thick_cover {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (U : Z.ProEt) :
    Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
      ∃ (Vt : Y.ProEt) (_ : (wcProEtBC i).obj Vt ≅ T),
        (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) ∧
        (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) ∧
        ∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
          Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom)
      ∈ Scheme.ProEt.topology Z U :=
by
  classical

  have hB : ∀ (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I] (Vt : Y.ProEt)
      (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I))),
      IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) →
      ∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i := by
    intro A _ I _ Vt e c hsq v hv
    have hcl : IsClosed ({e.hom v} : Set (Spec (.of A))) := by
      have := (Scheme.homeoOfIso e).isClosed_image.mpr hv
      rwa [Set.image_singleton] at this
    have hmax : (e.hom v).asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hcl
    have hIp : I ≤ (e.hom v).asIdeal := by
      refine le_trans (HenselianRing.jac (R := A) (I := I)) ?_
      rw [Ideal.jacobson]
      exact sInf_le ⟨bot_le, hmax⟩
    let q : PrimeSpectrum (A ⧸ I) :=
      ⟨Ideal.map (Ideal.Quotient.mk I) (e.hom v).asIdeal,
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker]; exact hIp)⟩
    have hq : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) q = e.hom v := by
      apply PrimeSpectrum.ext
      show Ideal.comap (Ideal.Quotient.mk I)
        (Ideal.map (Ideal.Quotient.mk I) (e.hom v).asIdeal) = _
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr hIp
    have : IsIso c := hsq.isIso_snd_of_isIso
    let x := (inv c) q
    have hx : c x = q := by
      show (inv c ≫ c) q = q
      rw [IsIso.inv_hom_id]
      rfl
    have hw := hsq.toCommSq.w
    have h1 : e.hom (Limits.pullback.fst Vt.hom i x) = e.hom v := by
      rw [← Scheme.Hom.comp_apply, hw, Scheme.Hom.comp_apply, hx, hq]
    have h2 : Limits.pullback.fst Vt.hom i x = v := (Scheme.homeoOfIso e).injective h1
    refine ⟨Limits.pullback.snd Vt.hom i x, ?_⟩
    rw [← h2, ← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]

  refine (Scheme.ProEt.topology Z).superset_covering (Sieve.generate_mono ?_)
    (wc_proet_wcontr_affine_open_cover i U)
  rintro T f ⟨⟨O, hO, hTO⟩, hT⟩
  obtain ⟨A, iA, I, iI, Vt, e, c, κ, hsq, hV, hiV⟩ :=
    wc_proet_henselian_thickening_exists i T O hO hTO hT
  have hinit : ∀ V : Y.ProEt,
      Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
    intro V
    refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ V
    intro X S g _ a b hab
    exact wc_weaklyEtale_henselian_lift g A I a b hab
  refine ⟨Vt, κ, hV, hB A I Vt e c hsq, fun M => ?_⟩
  apply wc_hm_pull_unit_bij_of_lan i ℓ Di hDi Vt M
  refine Function.Bijective.comp ?_ (wc_proet_lan_unit_bijective_of_init i Vt hinit M.val.presheaf)
  apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
  intro m Q ι hι hpart
  obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
    wc_proet_thickening_clopen_lift i A I Vt e c hsq m Q ι hι hpart
  refine wc_proet_lan_clopen_additive i Vt ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj M)
    m Q ι Vk ιt κk hιt hpt hκ
    (wc_proet_lan_unit_bijective_of_init i Vt hinit M.val.presheaf) (fun k => ?_)
  obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
  refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) M.val.presheaf
  refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
  intro X S g _ a b hab
  exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab

theorem wc_pmn_vp_wlocal_comp_bij {W P : Type*} [TopologicalSpace W] [TopologicalSpace P]
    [CompactSpace P]
    (hc : IsClosed {x : W | IsClosed ({x} : Set W)})
    (hu : ∀ x : W, ∃! y : W, IsClosed ({y} : Set W) ∧ x ⤳ y)
    (hcl : ∀ z : W, IsClosed ({z} : Set W) → ∀ O : Set W, IsOpen O → z ∈ O →
      ∃ V : Set W, IsClopen V ∧ z ∈ V ∧ V ⊆ O)
    (p : C(P, W))
    (hfib : ∀ w : W, IsClosed ({w} : Set W) →
      IsPreconnected (p ⁻¹' {y | y ⤳ w}) ∧ (p ⁻¹' {y | y ⤳ w}).Nonempty)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    Function.Bijective (fun s : C(W, ULift.{v} ℚ_[ℓ]) => s.comp p) :=
by
  classical
  have : TotallyDisconnectedSpace (ULift.{v} ℚ_[ℓ]) :=
    (Homeomorph.ulift (X := ℚ_[ℓ])).symm.totallyDisconnectedSpace
  obtain ⟨r₀, hr₀⟩ : ∃ r₀ : W → W, ∀ x, IsClosed ({r₀ x} : Set W) ∧ x ⤳ r₀ x :=
    ⟨fun x => (hu x).exists.choose, fun x => (hu x).exists.choose_spec⟩
  have hr₀u : ∀ x y : W, IsClosed ({y} : Set W) → x ⤳ y → y = r₀ x :=
    fun x y hy hxy => (hu x).unique ⟨hy, hxy⟩ (hr₀ x)
  have hr₀c : Continuous r₀ := by
    rw [continuous_def]
    intro O hO
    rw [isOpen_iff_forall_mem_open]
    intro x hx
    obtain ⟨V, hV, hzV, hVO⟩ := hcl (r₀ x) (hr₀ x).1 O hO hx
    exact ⟨V, fun x' hx' => hVO ((hr₀ x').2.mem_closed hV.isClosed hx'), hV.isOpen,
      (hr₀ x).2.mem_open hV.isOpen hzV⟩
  let r : C(W, {x : W // IsClosed ({x} : Set W)}) :=
    ⟨fun x => ⟨r₀ x, (hr₀ x).1⟩, hr₀c.subtype_mk _⟩
  have hT2 : T2Space {x : W // IsClosed ({x} : Set W)} := by
    rw [t2Space_iff]
    intro a b hab
    have hne : a.1 ≠ b.1 := fun h => hab (Subtype.ext h)
    obtain ⟨V, hV, haV, hVO⟩ := hcl a.1 a.2 ({b.1}ᶜ) b.2.isOpen_compl hne
    refine ⟨Subtype.val ⁻¹' V, Subtype.val ⁻¹' Vᶜ,
      hV.isOpen.preimage continuous_subtype_val,
      hV.isClosed.isOpen_compl.preimage continuous_subtype_val, haV, ?_, ?_⟩
    · exact fun h => hVO h (Set.mem_singleton _)
    · exact Disjoint.preimage _ disjoint_compl_right
  have hspec : ∀ (f : C(W, ULift.{v} ℚ_[ℓ])) {x y : W}, x ⤳ y → f x = f y :=
    fun f _ _ h => (h.map f.continuous).eq
  constructor
  · intro s t hst
    refine ContinuousMap.ext fun x => ?_
    obtain ⟨y, hy⟩ := (hfib (r₀ x) (hr₀ x).1).2
    have h1 : s (p y) = t (p y) := DFunLike.congr_fun hst y
    have hy' : p y ⤳ r₀ x := hy
    calc s x = s (r₀ x) := hspec s (hr₀ x).2
      _ = s (p y) := (hspec s hy').symm
      _ = t (p y) := h1
      _ = t (r₀ x) := hspec t hy'
      _ = t x := (hspec t (hr₀ x).2).symm
  · intro g
    let q : C(P, {x : W // IsClosed ({x} : Set W)}) := r.comp p
    have hqs : Function.Surjective q := by
      intro c
      obtain ⟨y, hy⟩ := (hfib c.1 c.2).2
      exact ⟨y, Subtype.ext (hr₀u (p y) c.1 c.2 hy).symm⟩
    have hq : Topology.IsQuotientMap q :=
      Topology.IsQuotientMap.of_surjective_continuous hqs q.continuous
    have hfac : Function.FactorsThrough g q := by
      intro a b hab
      have hab' : r₀ (p a) = r₀ (p b) := congrArg Subtype.val hab
      have hF := (hfib (r₀ (p a)) (hr₀ (p a)).1).1
      have ha : a ∈ p ⁻¹' {y | y ⤳ r₀ (p a)} := (hr₀ (p a)).2
      have hb : b ∈ p ⁻¹' {y | y ⤳ r₀ (p a)} := by
        show p b ⤳ r₀ (p a)
        rw [hab']
        exact (hr₀ (p b)).2
      exact (hF.image g g.continuous.continuousOn).subsingleton (Set.mem_image_of_mem g ha)
        (Set.mem_image_of_mem g hb)
    refine ⟨(hq.lift g hfac).comp r, ?_⟩
    refine ContinuousMap.ext fun y => ?_
    show (hq.lift g hfac) (q y) = g y
    exact DFunLike.congr_fun (hq.lift_comp g hfac) y

theorem wc_pltr_wet_residue_geom_point : ∀ {Y : Scheme.{u}} (y : Y) (A : Type u) [CommRing A] [IsLocalRing A] (a : Spec (.of A) ⟶ Y), WeaklyEtale a → a (IsLocalRing.closedPoint A) = y → ∃ ε : IsLocalRing.ResidueField A →+* AlgebraicClosure (Y.residueField y), ε.IsIntegral ∧ Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a = wcEtGeomPt Y y :=
by
  intro Y y A _ _ a ha hy
  have hy' : a (IsLocalRing.closedPoint (CommRingCat.of A)) = y := hy
  subst hy'
  clear hy
  let σ := Scheme.stalkClosedPointTo a
  have hσa : Spec.map σ ≫ Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A))) = a :=
    Scheme.Spec_stalkClosedPointTo_fromSpecStalk a
  have hWσ : WeaklyEtale (Spec.map σ) := by
    haveI := wc_lfi_fromSpecStalk_weaklyEtale Y (a (IsLocalRing.closedPoint (CommRingCat.of A)))
    haveI : WeaklyEtale (Spec.map σ ≫
        Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A)))) := by
      rw [hσa]; exact ha
    exact WeaklyEtale.of_comp (Spec.map σ)
      (Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A))))
  have hWE : @Algebra.WeaklyEtale (Y.presheaf.stalk (a (IsLocalRing.closedPoint (CommRingCat.of A))))
      A _ _ σ.hom.toAlgebra := by
    apply wc_lpkt_specMap_weaklyEtale_ring _ A σ.hom
    rw [CommRingCat.ofHom_hom]
    exact hWσ
  let ρ := IsLocalRing.residue (Y.presheaf.stalk (a (IsLocalRing.closedPoint (CommRingCat.of A))))
  let g : Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A))) →+*
      IsLocalRing.ResidueField A :=
    IsLocalRing.ResidueField.map σ.hom
  have hg : g.comp ρ = (IsLocalRing.residue A).comp σ.hom :=
    IsLocalRing.ResidueField.map_comp_residue σ.hom
  have halg : @Algebra.IsAlgebraic (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A))))
      (IsLocalRing.ResidueField A) _ _ g.toAlgebra := by
    letI := g.toAlgebra
    letI := σ.hom.toAlgebra
    refine ⟨fun x => ?_⟩
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective x
    obtain ⟨f, hf0, hf⟩ := wc_weaklyEtale_point_algebraic _ A (IsLocalRing.ResidueField A) hWE
      (IsLocalRing.residue A) b
    have hrel : (IsLocalRing.residue A).comp (algebraMap _ A) = g.comp ρ := by
      rw [hg]; rfl
    rw [hrel] at hf0 hf
    refine ⟨f.map ρ, ?_, ?_⟩
    · intro h0
      exact hf0 ((Polynomial.map_map ρ g f).symm.trans
        ((congrArg (Polynomial.map g) h0).trans (Polynomial.map_zero g)))
    · show Polynomial.eval₂ g (IsLocalRing.residue A b) (f.map ρ) = 0
      exact (Polynomial.eval₂_map ρ g _).trans hf
  letI := g.toAlgebra
  haveI : Algebra.IsAlgebraic (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A))))
      (IsLocalRing.ResidueField A) := halg
  let φ : IsLocalRing.ResidueField A →ₐ[Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A)))]
      AlgebraicClosure (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A)))) :=
    IsAlgClosed.lift
  obtain ⟨ε, hεdef⟩ : ∃ ε : IsLocalRing.ResidueField A →+*
      AlgebraicClosure (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A)))),
      ε = (φ : IsLocalRing.ResidueField A →+*
        AlgebraicClosure (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A))))) :=
    ⟨_, rfl⟩
  have hεg : ε.comp g = algebraMap (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A))))
      (AlgebraicClosure (Y.residueField (a (IsLocalRing.closedPoint (CommRingCat.of A))))) := by
    rw [hεdef]; exact φ.comp_algebraMap
  refine ⟨ε, ?_, ?_⟩
  · apply RingHom.IsIntegral.tower_top g
    rw [hεg]
    exact algebraMap_isIntegral_iff.mpr inferInstance
  · have hres : Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a =
        Spec.map (CommRingCat.ofHom g) ≫
          Y.fromSpecResidueField (a (IsLocalRing.closedPoint (CommRingCat.of A))) := by
      calc Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a
          = Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ Spec.map σ ≫
              Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A))) := by rw [hσa]
        _ = Spec.map (σ ≫ CommRingCat.ofHom (IsLocalRing.residue A)) ≫
              Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A))) := by
            rw [Spec.map_comp, Category.assoc]
        _ = Spec.map (CommRingCat.ofHom ρ ≫ CommRingCat.ofHom g) ≫
              Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A))) := by
            exact congrArg (fun t => Spec.map t ≫
              Y.fromSpecStalk (a (IsLocalRing.closedPoint (CommRingCat.of A))))
              (CommRingCat.hom_ext hg.symm)
        _ = Spec.map (CommRingCat.ofHom g) ≫
              Y.fromSpecResidueField (a (IsLocalRing.closedPoint (CommRingCat.of A))) := by
            rw [Spec.map_comp, Category.assoc]; rfl
    unfold wcEtGeomPt
    rw [hres, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hεg]

theorem wc_yjl_weaklyEtale_fibre_specializes : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), WeaklyEtale g →
    ∀ x x' : X, x ⤳ x' → g x = g x' → x = x' :=
by
  have s1 : ∀ {K L : CommRingCat.{u}}, IsField K → ∀ (f : Spec L ⟶ Spec K), Flat f := by
    intro K L hK f
    rw [← Spec.map_preimage f]
    exact HasRingHomProperty.Spec_iff.mpr (RingHom.Flat.of_isField hK _)
  have s2 : ∀ {F S : Scheme.{u}} (p : F ⟶ S), Flat (Limits.pullback.diagonal p) →
      (∀ z' : F, Flat (F.fromSpecResidueField z' ≫ p)) → ∀ z z' : F, z ⤳ z' → z = z' := by
    intro F S p hdiag he z z' hzz
    have : Flat (F.fromSpecResidueField z' ≫ p) := he z'
    have hcond : 𝟙 _ ≫ F.fromSpecResidueField z' ≫ p = F.fromSpecResidueField z' ≫ p := by
      rw [Category.id_comp]
    let s : Spec (F.residueField z') ⟶ Limits.pullback (F.fromSpecResidueField z' ≫ p) p :=
      Limits.pullback.lift (𝟙 _) (F.fromSpecResidueField z') hcond
    have hcond2 : (Limits.pullback.fst (F.fromSpecResidueField z' ≫ p) p ≫
        F.fromSpecResidueField z') ≫ p = Limits.pullback.snd (F.fromSpecResidueField z' ≫ p) p ≫ p := by
      rw [Category.assoc]; exact Limits.pullback.condition
    let j : Limits.pullback (F.fromSpecResidueField z' ≫ p) p ⟶ Limits.pullback p p :=
      Limits.pullback.lift _ _ hcond2
    have hsb : s ≫ Limits.pullback.snd (F.fromSpecResidueField z' ≫ p) p =
        F.fromSpecResidueField z' := Limits.pullback.lift_snd _ _ _
    have hsa : s ≫ Limits.pullback.fst (F.fromSpecResidueField z' ≫ p) p = 𝟙 _ :=
      Limits.pullback.lift_fst _ _ _
    have hja : j ≫ Limits.pullback.fst p p =
        Limits.pullback.fst (F.fromSpecResidueField z' ≫ p) p ≫ F.fromSpecResidueField z' :=
      Limits.pullback.lift_fst _ _ _
    have hjb : j ≫ Limits.pullback.snd p p = Limits.pullback.snd (F.fromSpecResidueField z' ≫ p) p :=
      Limits.pullback.lift_snd _ _ _
    have hsj : s ≫ j = F.fromSpecResidueField z' ≫ Limits.pullback.diagonal p := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hja, ← Category.assoc, hsa, Category.id_comp, Category.assoc,
          Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hjb, hsb, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
    have hιpt : ∀ q, F.fromSpecResidueField z' q = z' := fun q => F.fromSpecResidueField_apply z' q
    let pt : Spec (F.residueField z') := IsLocalRing.closedPoint (F.residueField z')
    have hbt0 : Limits.pullback.snd (F.fromSpecResidueField z' ≫ p) p (s pt) = z' := by
      rw [← Scheme.Hom.comp_apply, hsb, hιpt]
    have hjt0 : j (s pt) = Limits.pullback.diagonal p z' := by
      rw [← Scheme.Hom.comp_apply, hsj, Scheme.Hom.comp_apply, hιpt]
    have hzz' : z ⤳ Limits.pullback.snd (F.fromSpecResidueField z' ≫ p) p (s pt) := by
      rw [hbt0]; exact hzz
    obtain ⟨t1, ht1, hbt1⟩ := Flat.generalizingMap _ hzz'
    have hw : j t1 ⤳ Limits.pullback.diagonal p z' := by
      rw [← hjt0]; exact ht1.map j.continuous
    obtain ⟨w, -, hwu⟩ := Flat.generalizingMap _ hw
    have e1 : Limits.pullback.fst p p (j t1) = z' := by
      rw [← Scheme.Hom.comp_apply, hja, Scheme.Hom.comp_apply, hιpt]
    have e2 : Limits.pullback.snd p p (j t1) = z := by
      rw [← Scheme.Hom.comp_apply, hjb, hbt1]
    have e3 : Limits.pullback.fst p p (Limits.pullback.diagonal p w) = w := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.diagonal_fst]; rfl
    have e4 : Limits.pullback.snd p p (Limits.pullback.diagonal p w) = w := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.diagonal_snd]; rfl
    rw [hwu] at e3 e4
    rw [← e2, e4, ← e3, e1]
  intro X Y g hg x x' hxx' hgx
  obtain ⟨y, hy⟩ : ∃ y, g x' = y := ⟨_, rfl⟩
  rw [hy] at hgx
  have hp : WeaklyEtale (g.fiberToSpecResidueField y) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback g (Y.fromSpecResidueField y)) hg
  have hx : x ∈ Set.range (g.fiberι y) := by
    rw [Scheme.Hom.range_fiberι]; exact hgx
  have hx' : x' ∈ Set.range (g.fiberι y) := by
    rw [Scheme.Hom.range_fiberι]; exact hy
  obtain ⟨z, rfl⟩ := hx
  obtain ⟨z', rfl⟩ := hx'
  have hzz : z ⤳ z' := ((g.fiberι y).isEmbedding.isInducing.specializes_iff).mp hxx'
  have := s2 (g.fiberToSpecResidueField y) hp.flat_diagonal
    (fun z' => s1 (Field.toIsField _) _) z z' hzz
  rw [this]

theorem wc_pltr_shens_lift_iso : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (R : Type u) [CommRing R] [IsLocalRing R] (c : Spec (.of R) ⟶ Y), WeaklyEtale c → c (IsLocalRing.closedPoint R) = y → ∀ δ : Spec (.of R) ⟶ Spec (.of B), δ ≫ a = c → IsIso δ :=
by
  intro Y y B _ _ _ Λ _ _ W' φ a hsh R _ _ c hc hcy δ hδ
  haveI ha : WeaklyEtale a := wc_shdata_weaklyEtale y B Λ W' φ a hsh

  have haB : a (IsLocalRing.closedPoint B) = y := by
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
    have h1 : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B)) ≫ a) (IsLocalRing.closedPoint (AlgebraicClosure
          (Y.residueField y))) = (wcEtGeomPt Y y) (IsLocalRing.closedPoint (AlgebraicClosure
          (Y.residueField y))) := by rw [he]
    have hz : Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        (Spec.map (CommRingCat.ofHom e)
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) =
        IsLocalRing.closedPoint B := by
      refine (congrArg (fun z : Spec (.of (IsLocalRing.ResidueField B)) =>
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z)
        (Subsingleton.elim (α := Spec (.of (IsLocalRing.ResidueField B))) _
          (IsLocalRing.closedPoint (IsLocalRing.ResidueField B)))).trans ?_
      exact (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint (IsLocalRing.residue B))
    have hR : (wcEtGeomPt Y y) (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = y :=
      (Scheme.Hom.comp_apply _ _ _).trans (by apply Scheme.fromSpecResidueField_apply)
    have hL : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B)) ≫ a) (IsLocalRing.closedPoint (AlgebraicClosure
          (Y.residueField y))) = a (IsLocalRing.closedPoint B) :=
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)).trans (congrArg a hz)
    exact hL.symm.trans (h1.trans hR)

  haveI : WeaklyEtale (δ ≫ a) := by rw [hδ]; exact hc
  have hδw : WeaklyEtale δ := WeaklyEtale.of_comp δ a

  obtain ⟨ψ, hψ⟩ : ∃ ψ : B →+* R, Spec.map (CommRingCat.ofHom ψ) = δ :=
    ⟨(Spec.preimage δ).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  subst hψ
  have hA := wc_lpkt_specMap_weaklyEtale_ring B R ψ hδw

  have hfib : a (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint R)) =
      a (IsLocalRing.closedPoint B) := by
    have h2 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom ψ)) a (IsLocalRing.closedPoint R)
    rw [hδ] at h2
    rw [← h2, hcy, haB]
  have ht := wc_yjl_weaklyEtale_fibre_specializes a ha _ _
    (IsLocalRing.specializes_closedPoint _) hfib
  have hloc : IsLocalHom ψ := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    exact (Spec.map_apply _ _).symm.trans ht

  letI : Algebra B R := ψ.toAlgebra
  have hbij : Function.Bijective ψ := wc_olivier B R inferInstance inferInstance hloc hA
  haveI : IsIso (CommRingCat.ofHom ψ) := (RingEquiv.ofBijective ψ hbij).toCommRingCatIso.isIso_hom
  infer_instance

theorem wc_pmn_vp_off_node_smooth (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (O : (Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)).Opens)
    (hO : ∀ z ∈ O, Limits.pullback.snd V.hom D.f
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z) ≠
      D.xs i (IsLocalRing.closedPoint F'')) :
    IsUnit ((ℓ : ℕ) : A) ∧
    (∀ z ∈ O, ∃ U : (Limits.pullback V.hom D.f).Opens,
      Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z ∈ U ∧
      Smooth (U.ι ≫ (Limits.pullback.fst V.hom D.f ≫ e.hom))) ∧
    ∀ z : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)),
      (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z) =
      IsLocalRing.closedPoint A :=
by
  classical

  have hC1 : IsUnit ((ℓ : ℕ) : A) := by
    let σ : F'' →+* A := (Spec.preimage (e.inv ≫ V.hom ≫ (wcP1Over F'').hom)).hom
    have hne : ((ℓ : ℕ) : F'') ≠ 0 := by
      intro h0
      have h1 : ringChar F'' ∣ ℓ := ringChar.dvd h0
      have hp : Nat.Prime ℓ := Fact.out
      rcases hp.eq_one_or_self_of_dvd _ h1 with h2 | h2
      · exact CharP.ringChar_ne_one h2
      · apply hℓ
        letI := Fintype.ofFinite F''
        rw [Nat.card_eq_fintype_card, ← h2]
        exact ringChar.dvd (Nat.cast_card_eq_zero F'')
    have h3 := (isUnit_iff_ne_zero.mpr hne).map σ
    rwa [map_natCast] at h3

  have hC3 : ∀ z : ↥(Limits.pullback (C := Scheme.{u})
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A)),
      (Limits.pullback.fst V.hom D.f ≫ e.hom)
        (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z) =
      IsLocalRing.closedPoint A := by
    intro z
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    have hs : Limits.pullback.snd (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField A)) _ _
    rw [hs]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
  refine ⟨hC1, fun z hz => ?_, hC3⟩

  obtain ⟨w, hw⟩ : ∃ w, w =
      Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) z := ⟨_, rfl⟩
  rw [← hw]
  have hv : Limits.pullback.fst V.hom D.f w = e.inv (IsLocalRing.closedPoint A) := by
    have h := hC3 z
    rw [← hw] at h
    rw [← h, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply e.hom e.inv, e.hom_inv_id]
    rfl
  have hfy : D.f (Limits.pullback.snd V.hom D.f w) = D.S i (IsLocalRing.closedPoint F'') := by
    rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply, hv, hV]
  have hnode : ∀ j, Limits.pullback.snd V.hom D.f w ≠ D.xs j (IsLocalRing.closedPoint F'') := by
    intro j hj
    have h2 : D.S j (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
      rw [← hfy, hj]
      have hc := Scheme.Hom.comp_apply (D.xs j) D.f (IsLocalRing.closedPoint F'')
      rw [D.hxs j] at hc
      exact hc
    have h3 : j = i := D.hSinj h2
    subst h3
    rw [hw] at hj
    exact hO z hz hj
  obtain ⟨U', hyU', hU'⟩ := D.smooth_off _ hnode
  refine ⟨(TopologicalSpace.Opens.map (Limits.pullback.snd V.hom D.f).base).obj U', hyU', ?_⟩
  have hsq := IsPullback.paste_vert
    (AlgebraicGeometry.isPullback_morphismRestrict (Limits.pullback.snd V.hom D.f) U')
    (IsPullback.of_hasPullback V.hom D.f).flip
  have h1 := MorphismProperty.of_isPullback (P := @Smooth) hsq hU'
  rw [← Category.assoc]
  exact MorphismProperty.comp_mem _ _ _ h1 (inferInstance : Smooth e.hom)

theorem wc_pmn_vp_bc_a0_isPullback (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] (e : V.left ≅ Spec (.of A))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L]
    (eE : E.left ≅ Spec (.of L)) :
    IsPullback ((wcProEtPullback D.f).map a₀).left
      (Limits.pullback.fst E.hom D.f ≫ eE.hom)
      (Limits.pullback.fst V.hom D.f ≫ e.hom) (eE.inv ≫ a₀.left ≫ e.hom) :=
by
  have h1 : ((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.fst V.hom D.f =
      Limits.pullback.fst E.hom D.f ≫ a₀.left := by
    unfold wcProEtPullback
    erw [MorphismProperty.Over.pullback_map_left]
    exact Limits.pullback.lift_fst _ _ _
  have h2 : ((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.snd V.hom D.f =
      Limits.pullback.snd E.hom D.f := by
    unfold wcProEtPullback
    erw [MorphismProperty.Over.pullback_map_left]
    exact Limits.pullback.lift_snd _ _ _
  have hw : a₀.left ≫ V.hom = E.hom := MorphismProperty.Over.w a₀
  have hout : IsPullback (((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.snd V.hom D.f)
      (Limits.pullback.fst E.hom D.f) D.f (a₀.left ≫ V.hom) := by
    rw [h2, hw]
    exact (IsPullback.of_hasPullback E.hom D.f).flip
  have H : IsPullback ((wcProEtPullback D.f).map a₀).left (Limits.pullback.fst E.hom D.f)
      (Limits.pullback.fst V.hom D.f) a₀.left :=
    IsPullback.of_right hout h1 (IsPullback.of_hasPullback V.hom D.f).flip
  exact H.of_iso (Iso.refl _) (Iso.refl _) eE e (by simp) (by simp) (by simp) (by simp)

theorem wc_pmn_vp_mfc_smooth (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (z : ((wcProEtPullback D.f).obj V).left)
    (hz₁ : Limits.pullback.fst V.hom D.f z = e.inv (IsLocalRing.closedPoint A))
    (hz₂ : Limits.pullback.snd V.hom D.f z ≠ D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left z))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
