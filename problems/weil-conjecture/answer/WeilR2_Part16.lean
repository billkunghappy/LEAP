    haveI hc2 : (wcOverToSlice S U ⋙ wcSliceToOver S U).IsContinuous
        ((Scheme.ProEt.topology S).over U) ((Scheme.ProEt.topology S).over U) :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology U.left) _
    let P := (wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)
    let Q := (wcOverToSlice S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology U.left)
    let α : Q ⋙ P ≅ 𝟭 _ :=
      Functor.sheafPushforwardContinuousComp (wcSliceToOver S U) (wcOverToSlice S U)
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)
          (Scheme.ProEt.topology U.left) ≪≫
        Functor.sheafPushforwardContinuousIso eC AddCommGrpCat.{u+1} _ _ ≪≫
        Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _
    let β : P ⋙ Q ≅ 𝟭 _ :=
      Functor.sheafPushforwardContinuousComp (wcOverToSlice S U) (wcSliceToOver S U)
          AddCommGrpCat.{u+1} ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology U.left)
          ((Scheme.ProEt.topology S).over U) ≪≫
        Functor.sheafPushforwardContinuousIso eD AddCommGrpCat.{u+1} _ _ ≪≫
        Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _
    let E := CategoryTheory.Equivalence.mk Q P α.symm β
    let adj : Q ⊣ P := E.toAdjunction
    let adj' : P ⊣ Q := E.symm.toAdjunction
    haveI : Limits.PreservesColimitsOfSize.{0, 0} P := adj'.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits P :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits P
    haveI : Limits.PreservesLimitsOfSize.{0, 0} P := adj.rightAdjoint_preservesLimits
    haveI : Limits.PreservesFiniteLimits P :=
      Limits.PreservesLimitsOfSize.preservesFiniteLimits P
    haveI : P.IsRightAdjoint := adj.isRightAdjoint
    haveI : P.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint P
    haveI : P.Additive := Functor.additive_of_preserves_binary_products P
    obtain ⟨θ, -⟩ := wc_sheafPullback_free_natIso ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) (wcOverToSlice S U) P adj'
    exact cokL P _ _ (θ (Over.mk x)) N

  have s5 : ∀ (Y : Scheme.{u}) (V : Y.Etale) (N : ℕ),
      Nonempty ((wcEpsInv Y).obj (Limits.cokernel (N • 𝟙 (wcFtcFS Y V))) ≅
        Limits.cokernel (N • 𝟙 (wcFreeSheaf Y ((wcEtToProEt Y).obj V)))) := by
    intro Y V N
    haveI := (wc_etToProEt_flat_cont Y).2
    obtain ⟨h0, h1, h2⟩ := wc_epsInv_exact Y
    haveI := h0
    haveI := h1
    haveI := h2
    haveI : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _
    let adj : wcEpsInv Y ⊣ (wcEtToProEt Y).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) :=
      Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    obtain ⟨θ, -⟩ := wc_sheafPullback_free_natIso (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y) (wcEtToProEt Y) (wcEpsInv Y) adj
    exact cokL (wcEpsInv Y) _ _ (θ V) N

  have transp : ∀ {A B C : Sheaf (Scheme.ProEt.topology (wcGeomPoint F'' (wcP1Over F'') hP).left)
      AddCommGrpCat.{u+1}} (e : B ≅ C), Nonempty (Abelian.Ext A B n ≃ Abelian.Ext A C n) := by
    intro A B C e
    exact ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero n)
             invFun := fun z => z.comp (Abelian.Ext.mk₀ e.inv) (add_zero n)
             left_inv := fun y => by
               simp only
               rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                 e.hom_inv_id, Abelian.Ext.comp_mk₀_id]
             right_inv := fun z => by
               simp only
               rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                 e.inv_hom_id, Abelian.Ext.comp_mk₀_id] }⟩

  haveI hc : (wcSliceToOver (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)).IsContinuous
      (Scheme.ProEt.topology (wcGeomPoint F'' (wcP1Over F'') hP).left)
      ((Scheme.ProEt.topology (wcP1Over F'').left).over (wcGeomPoint F'' (wcP1Over F'') hP)) :=
    (wc_slice_over_sites_cont (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)).1
  obtain ⟨T1⟩ := wc_slice_geom_ext_transfer (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)
    (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Zsl.obj (Over.mk x)))) n

  obtain ⟨φ4⟩ := s4 (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) X x (ℓ ^ r)
  obtain ⟨φ5⟩ := s5 (wcGeomPoint F'' (wcP1Over F'') hP).left (@Scheme.Etale.mk _ _ x.left hxet)
    (ℓ ^ r)
  obtain ⟨T2⟩ := transp (A := wcFreeSheaf (wcGeomPoint F'' (wcP1Over F'') hP).left
    (Scheme.ProEt.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP).left))) (φ4 ≪≫ φ5.symm)

  haveI hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hf : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  obtain ⟨f, hfdef⟩ : ∃ f : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      Spec (.of (AlgebraicClosure F'')), f = Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := ⟨_, rfl⟩
  haveI hf' : IsProper f := by rw [hfdef]; exact hf
  obtain ⟨T3⟩ := wc_proet_etale_comparison_epsInv (AlgebraicClosure F'')
    (wcGeomPoint F'' (wcP1Over F'') hP).left f
    (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (wcFtcFS (wcGeomPoint F'' (wcP1Over F'') hP).left
      (@Scheme.Etale.mk _ _ x.left hxet)))) n
  exact ⟨T1.trans (T2.trans T3)⟩

theorem wc_plt_normalization_facts (F'' : Type u) [Field F''] (M' : ℕ)
