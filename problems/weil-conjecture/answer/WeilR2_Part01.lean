          e.toRingHom.comp ((algebraMap (Z.presheaf.stalk z)
            (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))).comp
              ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤))) = PowerSeries.C) ∨
      ((¬ ∃ W : Z.Opens, z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) ∧
        ∃ (c : R) (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
            (Z.presheaf.stalk z) ≃+* (MvPowerSeries (Fin 2) R ⧸
              Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})),
          c ∈ IsLocalRing.maximalIdeal R ∧
          e.toRingHom.comp ((algebraMap (Z.presheaf.stalk z)
            (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))).comp
              ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤))) =
            (Ideal.Quotient.mk _).comp MvPowerSeries.C)

def wcpaDjNcFibConn.{u} : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
    IsAdicComplete (IsLocalRing.maximalIdeal R) R →
    ∀ (S X : Scheme.{u}) (sS : S ⟶ Spec (.of R)) (q : X ⟶ S), Flat sS → LocallyOfFiniteType sS →
    IsProper q → Flat (q ≫ sS) →
    (∃ V : S.Opens, (∀ s : S, sS s ≠ IsLocalRing.closedPoint R → s ∈ V) ∧ IsIso (q ∣_ V)) →
    ∀ w : S, sS w = IsLocalRing.closedPoint R → IsClosed ({w} : Set S) →
      IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk w)) (S.presheaf.stalk w)) →
      _root_.IsPreconnected (⇑q ⁻¹' {w})

def wcpaDjNcGenIso.{u} : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' : Scheme.{u})
    (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)), wcpaDjSemistable u → wcpaDjSemistable u' →
    ∀ (Y : Scheme.{u}) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z')
      (h : a ≫ u = a' ≫ u'),
      IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) →
      IsPullback a' π u' (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) →
    ∀ (G : Scheme.{u}) (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G), IsClosedImmersion ι →
      AlgebraicGeometry.IsReduced G → IsOpenImmersion j → Dense (Set.range ⇑j) →
      j ≫ ι = Limits.pullback.lift a a' h →
      (∀ γ : G, (ι ≫ Limits.pullback.fst u u') γ ∈ Set.range ⇑a → γ ∈ Set.range ⇑j) →
    ∀ ξ : Z', u' ξ = IsLocalRing.closedPoint R →
      (∀ x : Z', u' x = IsLocalRing.closedPoint R → x ⤳ ξ → x = ξ) →
      ∃ W : Z'.Opens, ξ ∈ W ∧ IsIso ((ι ≫ Limits.pullback.snd u u') ∣_ W)
noncomputable def wcLr1uGerm {P X : Scheme.{u}} [IrreducibleSpace P] (ι : P ⟶ X) (x : X)
    (h : ι (genericPoint P) ⤳ x) : X.presheaf.stalk x ⟶ P.functionField :=
  X.presheaf.stalkSpecializes h ≫ ι.stalkMap (genericPoint P)



def wcLr1uDom {A K : Type*} [CommRing A] [CommRing K] (φ : A →+* K) (S : Set K) : Prop :=
  (∀ a, φ a ∈ S) ∧ ∀ a, ∀ s ∈ S, φ a * s = 1 → IsUnit a


noncomputable def wcLr1uConst {Ω : Type u} [Field Ω] {P : Scheme.{u}} [IrreducibleSpace P]
    (str : P ⟶ Spec (.of Ω)) : Ω →+* P.functionField :=
  ((Scheme.ΓSpecIso (.of Ω)).inv ≫ str.appTop ≫ P.presheaf.germ ⊤ (genericPoint P) trivial).hom


def wcLr1uVanish {P : Scheme.{u}} [IrreducibleSpace P] (c : P) (g : P.functionField) : Prop :=
  ∃ s ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk c),
    (P.presheaf.stalkSpecializes (genericPoint_specializes c)).hom s = g



def wcLr1uMob {Ω : Type u} [Field Ω] {P : Scheme.{u}} [IrreducibleSpace P] (str : P ⟶ Spec (.of Ω))
    (c1 c2 c3 : P) (g : P.functionField) : Prop :=
  wcLr1uVanish c1 g ∧ wcLr1uVanish c2 (g - 1) ∧
  (∃ s ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk c3),
    (P.presheaf.stalkSpecializes (genericPoint_specializes c3)).hom s * g = 1) ∧
  ∀ f : P.functionField, ∃ p q : Polynomial Ω, q.eval₂ (wcLr1uConst str) g ≠ 0 ∧
    f * q.eval₂ (wcLr1uConst str) g = p.eval₂ (wcLr1uConst str) g




def wcLr1uTripod {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P : Scheme.{u}} [IrreducibleSpace P]
    (str : P ⟶ Spec (.of Ω)) (c1 c2 c3 : P) : Set P.functionField :=
  {f | ∃ g, wcLr1uMob str c1 c2 c3 g ∧ ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
    q.eval₂ ((wcLr1uConst str).comp W.subtype) g ≠ 0 ∧
    f * q.eval₂ ((wcLr1uConst str).comp W.subtype) g = p.eval₂ ((wcLr1uConst str).comp W.subtype) g}
def wcpaP1rRawH1 {X : Scheme.{u}} {m : ℕ} (V : Fin m → X.Opens) : Prop :=
  ∀ c : ∀ a b : Fin m, Γ(X, V a ⊓ V b),
    (∀ a b d : Fin m,
      (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (c a d) =
        (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (c b d) +
        (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom (c a b)) →
    ∃ β : ∀ a : Fin m, Γ(X, V a), ∀ a b : Fin m,
      c a b = (X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (β b) -
        (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (β a)

def wcpaP1rModH1 {B : Type u} [CommRing B] {X : Scheme.{u}} (h : X ⟶ Spec (.of B)) (I : Ideal B)
    {m : ℕ} (V : Fin m → X.Opens) : Prop :=
  ∀ z : ∀ a b : Fin m, Γ(X, V a ⊓ V b),
    (∀ a b d : Fin m,
      (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z a d) -
        (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z b d) -
        (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom (z a b)
        ∈ Ideal.map (wcCnSigma h (V a ⊓ V b ⊓ V d)) I) →
    ∃ x : ∀ a : Fin m, Γ(X, V a), ∀ a b : Fin m,
      z a b - ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (x b) -
        (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (x a))
        ∈ Ideal.map (wcCnSigma h (V a ⊓ V b)) I
noncomputable abbrev wcpaDjLkPi {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X C : Scheme.{u}}
    (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W))
    (y : ↥(wcpaDjLkFib W f uX)) :
    ↥(Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
  Limits.pullback.map (f.fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uX
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    f.fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp) y

noncomputable abbrev wcpaDjLkImg {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X C : Scheme.{u}}
    (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W))
    (y : ↥(wcpaDjLkFib W f uX)) : ↥X :=
  Limits.pullback.fst uX
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    (wcpaDjLkPi W f uX y)

abbrev wcpaDjLkSmAt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W))
    (w : ↥(Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) : Prop :=
  ∃ U : (Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens,
    w ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))

open Classical in
noncomputable abbrev wcpaDjLkTerm {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X C : Scheme.{u}}
    (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W))
    (y : ↥(wcpaDjLkFib W f uX)) : ℕ∞ :=
  if wcpaDjLkBad ((wcpaDjLkFib W f uX).presheaf.stalk y) then
    wcpaDjLkDelta ((wcpaDjLkFib W f uX).presheaf.stalk y) ^ 2 +
      2 * wcpaDjLkDelta ((wcpaDjLkFib W f uX).presheaf.stalk y) -
      wcpaDjLkBranches ((wcpaDjLkFib W f uX).presheaf.stalk y)
  else 0

open Classical in
noncomputable def wcpaDjLkLocM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X C : Scheme.{u}}
    (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W)) (S : Set X) : ℕ∞ :=
  ⨆ s : Finset ↥(wcpaDjLkFib W f uX), ∑ y ∈ s,
    if wcpaDjLkImg W f uX y ∈ S then wcpaDjLkTerm W f uX y else 0
abbrev wcCbcmV {Y : Scheme.{u}} (L : wcpaDjCoc Y) (O : Y.Opens) {p : ℕ}
    (a : Fin (p + 1) ↪o Fin L.m) : Y.Opens :=
  (⨅ k, L.V (a k)) ⊓ O

abbrev wcCbcmC {Y : Scheme.{u}} (L : wcpaDjCoc Y) (O : Y.Opens) (p : ℕ) : Type u :=
  ∀ a : Fin (p + 1) ↪o Fin L.m, Γ(Y, wcCbcmV L O a)

noncomputable def wcCbcmD {Y : Scheme.{u}} (L : wcpaDjCoc Y) (O : Y.Opens) (e p : ℕ) :
    wcCbcmC L O p →+ wcCbcmC L O (p + 1) where
  toFun z a :=
    (∑ k : Fin (p + 1), (-1 : Γ(Y, wcCbcmV L O a)) ^ (k : ℕ) *
      (Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤
        wcCbcmV L O ((Fin.succAboveOrderEmb (Fin.castSucc k)).trans a) from
        inf_le_inf_right O (le_iInf fun i => iInf_le (fun j => L.V (a j)) _))).op).hom
        (z ((Fin.succAboveOrderEmb (Fin.castSucc k)).trans a))) +
    (-1 : Γ(Y, wcCbcmV L O a)) ^ (p + 1) *
      ((Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤
        L.V (a (Fin.castSucc (Fin.last p))) ⊓ L.V (a (Fin.last (p + 1))) from
        le_inf (inf_le_left.trans (iInf_le _ _)) (inf_le_left.trans (iInf_le _ _)))).op).hom
        ((L.g (a (Fin.castSucc (Fin.last p))) (a (Fin.last (p + 1))) :
          Γ(Y, L.V (a (Fin.castSucc (Fin.last p))) ⊓ L.V (a (Fin.last (p + 1))))) ^ e) *
      (Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤
        wcCbcmV L O ((Fin.succAboveOrderEmb (Fin.last (p + 1))).trans a) from
        inf_le_inf_right O (le_iInf fun i => iInf_le (fun j => L.V (a j)) _))).op).hom
        (z ((Fin.succAboveOrderEmb (Fin.last (p + 1))).trans a)))
  map_zero' := by
    funext a
    simp
  map_add' := by
    intro z z'
    funext a
    simp only [Pi.add_apply, map_add, mul_add, Finset.sum_add_distrib]
    ring

def wcCbcmFG {B : Type u} [CommRing B] {Y₀ : Scheme.{u}} (q₀ : Y₀ ⟶ Spec (.of B))
    (L₀ : wcpaDjCoc Y₀) (e : ℕ) : Prop :=
  (∃ (k : ℕ) (c : Fin k → wcCbcmC L₀ ⊤ 0), (∀ i, wcCbcmD L₀ ⊤ e 0 (c i) = 0) ∧
    ∀ z : wcCbcmC L₀ ⊤ 0, wcCbcmD L₀ ⊤ e 0 z = 0 → ∃ b : Fin k → B,
      z = ∑ i, ((fun a => wcCnSigma q₀ (wcCbcmV L₀ ⊤ a) (b i) * c i a) : wcCbcmC L₀ ⊤ 0)) ∧
  ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → wcCbcmC L₀ ⊤ (p + 1)),
    (∀ i, wcCbcmD L₀ ⊤ e (p + 1) (c i) = 0) ∧
    ∀ z : wcCbcmC L₀ ⊤ (p + 1), wcCbcmD L₀ ⊤ e (p + 1) z = 0 →
      ∃ (b : Fin k → B) (x : wcCbcmC L₀ ⊤ p),
        z = ∑ i, ((fun a => wcCnSigma q₀ (wcCbcmV L₀ ⊤ a) (b i) * c i a) : wcCbcmC L₀ ⊤ (p + 1)) +
          wcCbcmD L₀ ⊤ e p x
def wcLr1uValAt {Ω : Type u} [Field Ω] {P : Scheme.{u}} [IrreducibleSpace P]
    (str : P ⟶ Spec (.of Ω)) (c : P) (f : P.functionField) (l : Ω) : Prop :=
  wcLr1uVanish c (f - wcLr1uConst str l)

def wcLr1uInDisc {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P : Scheme.{u}}
    [IrreducibleSpace P] (str : P ⟶ Spec (.of Ω)) (h : P.functionField) (c : P) : Prop :=
  ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ wcLr1uValAt str c h (l : Ω)

def wcLr1uInAnn {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P : Scheme.{u}}
    [IrreducibleSpace P] (str : P ⟶ Spec (.of Ω)) (ϖ : ↥W) (h : P.functionField) (c : P) : Prop :=
  ∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ l' ∈ IsLocalRing.maximalIdeal ↥W ∧
    l * l' = ϖ ∧ wcLr1uValAt str c h (l : Ω)
abbrev wcNcgrTo {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (n : ℕ) : Type u :=
  AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)

abbrev wcNcgrTn {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (n : ℕ) : Type u :=
  Localization.Away (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C ϖ))
def wcNdIsHens {A : Type u} [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
    (e : A →+* P) : Prop :=
  HenselianLocalRing P ∧ (∀ a, IsUnit (e a) ↔ a ∉ p) ∧
  ∀ (B : Type u) [CommRing B], HenselianLocalRing B → ∀ g : A →+* B,
    (∀ a, IsUnit (g a) ↔ a ∉ p) → ∃! h : P →+* B, h.comp e = g ∧ IsLocalHom h


def wcNdFix {P : Type u} [CommRing P] (I : Subgroup (P ≃+* P)) : Subring P where
  carrier := {x | ∀ τ ∈ I, τ x = x}
  mul_mem' := fun {a b} ha hb => by
    show ∀ τ ∈ I, τ (a * b) = a * b
    intro τ hτ
    rw [map_mul, ha τ hτ, hb τ hτ]
  one_mem' := by
    show ∀ τ ∈ I, τ 1 = 1
    intro τ _
    exact map_one τ
  add_mem' := fun {a b} ha hb => by
    show ∀ τ ∈ I, τ (a + b) = a + b
    intro τ hτ
    rw [map_add, ha τ hτ, hb τ hτ]
  zero_mem' := by
    show ∀ τ ∈ I, τ 0 = 0
    intro τ _
    exact map_zero τ
  neg_mem' := fun {a} ha => by
    show ∀ τ ∈ I, τ (-a) = -a
    intro τ hτ
    rw [map_neg, ha τ hτ]


def wcNdModelA {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P]
    (σ : ↥W →+* P) : Prop :=
  ∃ f : Polynomial ↥W →+* P, f.comp Polynomial.C = σ ∧
    wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P f


def wcNdModelB {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P]
    (σ : ↥W →+* P) : Prop :=
  ∃ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧
    ∃ f : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* P,
      f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = σ ∧
      wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f


noncomputable abbrev wcNdPt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X C : Scheme.{u}}
    (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W))
    (y : ↥(wcpaDjLkFib W f uX)) : ↥f.normalization :=
  Limits.pullback.fst (f.fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y


noncomputable def wcNdSig {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    (z : Z) : B →+* ↥(Z.presheaf.stalk z) :=
  (Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma h ⊤)
abbrev wcpaDjLlPair {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W)) (x : ↥X) (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) : Prop :=
  σ ≫ uX = 𝟙 _ ∧ σ (IsLocalRing.closedPoint ↥W) = x ∧ a ≠ 0 ∧
    a ∈ IsLocalRing.maximalIdeal ↥W

abbrev wcpaDjLlExh {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) : Prop :=
  ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
    [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
    wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → ι' ≫ r = ι →
    wcpaDjLkModel W (r ≫ uX) ι' →
    ∀ V : X.Opens, (V : Set X) = {x}ᶜ → IsIso (r ∣_ V) →
    ∀ y' : ↥(wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)).presheaf.stalk y') →
      r (wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y') = x →
      wcpaDjLkSmAt W (r ≫ uX) (wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) y')

abbrev wcpaDjLlMinExh {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) : Prop :=
  wcpaDjLlExh W γ uX ι x σ a ∧
  ∀ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W), wcpaDjLlPair W uX x σ' a' →
    σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a →
    wcpaDjLlExh W γ uX ι x σ' a' →
    σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' = σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a

open Classical in
noncomputable def wcpaDjLlDeltaM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    {X C : Scheme.{u}} (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    (uX : X ⟶ Spec (.of ↥W)) (S : Set X) : ℕ∞ :=
  ⨆ s : Finset ↥(wcpaDjLkFib W f uX), ∑ y ∈ s,
    if wcpaDjLkImg W f uX y ∈ S then wcpaDjLkDelta ((wcpaDjLkFib W f uX).presheaf.stalk y)
    else 0

open Classical in
noncomputable def wcpaDjLlBadDeltaM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    {X C : Scheme.{u}} (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    (uX : X ⟶ Spec (.of ↥W)) (S : Set X) : ℕ∞ :=
  ⨆ s : Finset ↥(wcpaDjLkFib W f uX), ∑ y ∈ s,
    if wcpaDjLkBad ((wcpaDjLkFib W f uX).presheaf.stalk y) ∧ wcpaDjLkImg W f uX y ∈ S then
      wcpaDjLkDelta ((wcpaDjLkFib W f uX).presheaf.stalk y)
    else 0
def wcLr1uVtdRT {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral P]
    (str : P ⟶ Spec (.of Ω)) (S : Set P.functionField) (g : P.functionField) : Prop :=
  g ∈ S ∧ ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
    q.eval₂ ((wcLr1uConst str).comp W.subtype) g ≠ 0 ∧
    (q.eval₂ ((wcLr1uConst str).comp W.subtype) g)⁻¹ ∈ S

def wcLr1uVtdCls {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral P]
    (str : P ⟶ Spec (.of Ω)) (h : P.functionField) (d : P) :
    Option (IsLocalRing.ResidueField ↥W) → Prop
  | some l => ∃ w : ↥W, IsLocalRing.residue ↥W w = l ∧ wcLr1uValAt str d h (w : Ω)
  | none => ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ wcLr1uValAt str d h⁻¹ (l : Ω)
def wcpaDjFexH1 (Y : Scheme.{u}) : Prop :=
  ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → wcpaDjTwH1 L ⊤ (wcStructMod Y) 0
def wcpaDjLlFixes {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (uX : X ⟶ Spec (.of ↥W)) (y : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (g : Aut C) : Prop :=
  g.hom ≫ γ = γ ∧ ∃ g' : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization,
    (γ ≫ ι).toNormalization ≫ g' = g.hom ≫ (γ ≫ ι).toNormalization ∧
    g' ≫ (γ ≫ ι).fromNormalization = (γ ≫ ι).fromNormalization ∧
    g' (wcNdPt W (γ ≫ ι) uX y) = wcNdPt W (γ ≫ ι) uX y


def wcpaDjLlSolvStab {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (uX : X ⟶ Spec (.of ↥W)) (y : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) : Prop :=
  ∀ H : Subgroup (Aut C), (∀ g, g ∈ H ↔ wcpaDjLlFixes W γ ι uX y g) → Group.IsSolvable ↥H


def wcpaDjLlDiscParam {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W)) (x : ↥X) (τ : (Spec (.of ↥W) ⟶ X) → ↥W) : Prop :=
  (∀ σ : Spec (.of ↥W) ⟶ X, σ ≫ uX = 𝟙 _ → σ (IsLocalRing.closedPoint ↥W) = x →
      τ σ ∈ IsLocalRing.maximalIdeal ↥W) ∧
  (∀ c ∈ IsLocalRing.maximalIdeal ↥W, ∃ σ : Spec (.of ↥W) ⟶ X,
      σ ≫ uX = 𝟙 _ ∧ σ (IsLocalRing.closedPoint ↥W) = x ∧ τ σ = c) ∧
  ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
    wcpaDjLlPair W uX x σ a → wcpaDjLlPair W uX x σ' a' →
    (σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ↔
      a ∣ a' ∧ a ∣ τ σ' - τ σ)


def wcpaDjLlExhBasic {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X) : Prop :=
  (∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W), wcpaDjLlPair W uX x σ a ∧ wcpaDjLlExh W γ uX ι x σ a) ∧
  (∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
    wcpaDjLlPair W uX x σ a → wcpaDjLlPair W uX x σ' a' → wcpaDjLlExh W γ uX ι x σ a →
    σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' →
    wcpaDjLlExh W γ uX ι x σ' a') ∧
  (∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
    wcpaDjLlPair W uX x σ a → wcpaDjLlPair W uX x σ' a' → wcpaDjLlExh W γ uX ι x σ a →
    wcpaDjLlExh W γ uX ι x σ' a' →
    σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ∨
    σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a)


def wcpaDjLlSolvMin {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)] (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) : Prop :=
  (wcpaDjLlSolvStab W γ ι uX y₀ →
    ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
      wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a) ∧
  ∀ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
    wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ →
    ∀ (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀)
      [QuasiCompact (γ ≫ ι₀)] [QuasiSeparated (γ ≫ ι₀)],
      wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀) r₀ → ι₀ ≫ r₀ = ι →
      wcpaDjLkModel W (r₀ ≫ uX) ι₀ →
      ∀ w : ↥(wcpaDjLkFib W (γ ≫ ι₀) (r₀ ≫ uX)),
        r₀ (wcpaDjLkImg W (γ ≫ ι₀) (r₀ ≫ uX) w) = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
        ¬ wcpaDjLkSmAt W (r₀ ≫ uX) (wcpaDjLkPi W (γ ≫ ι₀) (r₀ ≫ uX) w) →
        wcpaDjLlSolvStab W γ ι₀ (r₀ ≫ uX) w →
        ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
          wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
          σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀ ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ∧
          wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
          ∀ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
            wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' →
            σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀ ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' →
            σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a →
            wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' →
            σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' = σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a
abbrev wcGbT {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ) : Type u :=
  AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)


noncomputable abbrev wcGbt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ) :
    wcGbT W ϖ d :=
  algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ)


noncomputable abbrev wcGbP {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ) :
    Ideal (wcGbT W ϖ d) :=
  (Ideal.span {wcGbt W ϖ d}).radical


abbrev wcGbVhat {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] : Type u :=
  AdicCompletion (Ideal.span {algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
    (wcGbt W ϖ d)}) (Localization.AtPrime (wcGbP W ϖ d))
def wcpaDjNccP1.{u} {Z S : Scheme.{u}} (g : Z ⟶ S) (K : Type u) [Field K] (s : Spec (.of K) ⟶ S)
    (E : Set ↥(Limits.pullback g s)) : Prop :=
  ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback g s)
    (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra),
    IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced Er ∧ Set.range ι = E ∧
    θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
    ι ≫ Limits.pullback.snd g s

open Classical in
def wcpaDjNccCert.{u} (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z' : Scheme.{u}} (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ' : Fin n → (Spec (.of R) ⟶ Z')) : Prop :=
  ∃ (T : Finset (Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))))
    (Eint : Finset ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
    T.Nonempty ∧
    (∀ X ∈ T, X ∈ irreducibleComponents
      ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) ∧
    (∀ X ∈ T, (X ∩ closure Xᶜ).Finite) ∧
    (∀ x ∈ Eint, ∃ X₁ ∈ T, ∃ X₂ ∈ T, X₁ ≠ X₂ ∧ ∀ E ∈ irreducibleComponents
      ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      x ∈ E ↔ (E = X₁ ∨ E = X₂)) ∧
    Eint.card + 1 ≤ T.card ∧
    ∑ X ∈ T, ((X ∩ closure Xᶜ).ncard +
      Nat.card {i : Fin n // ∃ x ∈ X, ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField R))),
        Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x =
          τ' i (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p)} +
      (if wcpaDjNccP1 u' (IsLocalRing.ResidueField R)
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) X then 0 else 2)) ≤
    2 + ∑ X ∈ T, (((Eint : Set ↥(Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) ∩ X).ncard)

def wcpaDjNccNagata.{u} : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
    IsAdicComplete (IsLocalRing.maximalIdeal R) R →
    ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B → _root_.IsReduced B →
      Module.Finite B (integralClosure B (FractionRing B))

def wcpaDjNccExcellent.{u} : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
    IsAdicComplete (IsLocalRing.maximalIdeal R) R →
    ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B →
    ∀ (𝔪 : Ideal B) [𝔪.IsMaximal] (C : Type u) [CommRing C] [Algebra (Localization.AtPrime 𝔪) C],
      Algebra.FiniteType (Localization.AtPrime 𝔪) C →
      (∀ (P : Ideal C) [P.IsPrime],
        IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) →
      ∀ (D : Type u) [CommRing D]
        [Algebra (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
          (Localization.AtPrime 𝔪)) D] [Algebra C D] [Algebra (Localization.AtPrime 𝔪) D]
        [IsScalarTower (Localization.AtPrime 𝔪)
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
            (Localization.AtPrime 𝔪)) D]
        [IsScalarTower (Localization.AtPrime 𝔪) C D],
        Algebra.IsPushout (Localization.AtPrime 𝔪)
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
            (Localization.AtPrime 𝔪)) C D →
        ∀ (Q : Ideal D) [Q.IsPrime],
          IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)

def wcpaDjNccChain.{u} : Prop :=
  ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X], PreconnectedSpace X →
    ∀ x y : X, ∃ (r : ℕ) (K : Fin (r + 1) → Set X), (∀ t, K t ∈ irreducibleComponents X) ∧
      x ∈ K 0 ∧ y ∈ K (Fin.last r) ∧ ∀ t : Fin r, (K t.castSucc ∩ K t.succ).Nonempty
noncomputable def wcCbcmSig {B : Type u} [CommRing B] {Y : Scheme.{u}} (q : Y ⟶ Spec (.of B))
    (L : wcpaDjCoc Y) (O : Y.Opens) (p : ℕ) : B →+* wcCbcmC L O p :=
  Pi.ringHom fun a => wcCnSigma q (wcCbcmV L O a)

noncomputable def wcCbcmPull {Y' Y : Scheme.{u}} (φ : Y' ⟶ Y) (L : wcpaDjCoc Y) (p : ℕ)
    (z : wcCbcmC L ⊤ p) : wcCbcmC (wcpaDjCocPull φ L) ⊤ p :=
  fun a => (φ.appLE (wcCbcmV L ⊤ a) (wcCbcmV (wcpaDjCocPull φ L) ⊤ a) (by
    intro x hx
    refine ⟨?_, trivial⟩
    have h1 := hx.1
    simp only [wcCbcmV] at h1 ⊢
    rw [TopologicalSpace.Opens.coe_iInf, Set.mem_iInter] at h1 ⊢
    exact fun k => h1 k)).hom (z a)

def wcCbcmSingle {m : ℕ} (a : Fin m) : Fin 1 ↪o Fin m :=
  OrderEmbedding.ofStrictMono (fun _ => a) (Subsingleton.strictMono _)

noncomputable def wcCbcmOfFam {Y : Scheme.{u}} (L : wcpaDjCoc Y) (O : Y.Opens)
    (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O)) : wcCbcmC L O 0 :=
  fun b => (Y.presheaf.map (homOfLE (show wcCbcmV L O b ≤ L.V (b 0) ⊓ O from
    inf_le_inf_right O (iInf_le (fun k => L.V (b k)) 0))).op).hom (t (b 0))

noncomputable def wcCbcmToFam {Y : Scheme.{u}} (L : wcpaDjCoc Y) (O : Y.Opens)
    (z : wcCbcmC L O 0) : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O) :=
  fun a => (Y.presheaf.map (homOfLE (show L.V a ⊓ O ≤ wcCbcmV L O (wcCbcmSingle a) from
    inf_le_inf_right O (le_iInf fun _ => le_rfl))).op).hom (z (wcCbcmSingle a))

noncomputable def wcCbcmToFamTop {Y : Scheme.{u}} (L : wcpaDjCoc Y)
    (z : wcCbcmC L ⊤ 0) : ∀ a : Fin L.m, Γ(Y, L.V a) :=
  fun a => (Y.presheaf.map (homOfLE (show L.V a ≤ wcCbcmV L ⊤ (wcCbcmSingle a) from
    le_inf (le_iInf fun _ => le_rfl) le_top)).op).hom (z (wcCbcmSingle a))
abbrev wcAcV {X : Scheme.{u}} {m : ℕ} (V : Fin m → X.Opens) (O : X.Opens) {p : ℕ}
    (a : Fin (p + 1) ↪o Fin m) : X.Opens :=
  (⨅ k, V (a k)) ⊓ O

abbrev wcAcC {X : Scheme.{u}} (M : X.Modules) {m : ℕ} (V : Fin m → X.Opens) (O : X.Opens)
    (p : ℕ) : Type u :=
  ∀ a : Fin (p + 1) ↪o Fin m, Γ(M, wcAcV V O a)

noncomputable def wcAcD {X : Scheme.{u}} (M : X.Modules) {m : ℕ} (V : Fin m → X.Opens)
    (O : X.Opens) (p : ℕ) : wcAcC M V O p →+ wcAcC M V O (p + 1) where
  toFun z a := ∑ k : Fin (p + 2), ((-1 : ℤ) ^ (k : ℕ)) •
    (M.presheaf.map (homOfLE (show wcAcV V O a ≤ wcAcV V O ((Fin.succAboveOrderEmb k).trans a) from
      inf_le_inf_right O (le_iInf fun i => iInf_le (fun j => V (a j)) _))).op).hom
      (z ((Fin.succAboveOrderEmb k).trans a))
  map_zero' := by
    funext a
    simp
  map_add' := by
    intro z z'
    funext a
    simp only [Pi.add_apply, map_add, smul_add, Finset.sum_add_distrib]

def wcAcFG (B : Type u) [CommRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) (M : X.Modules)
    {m : ℕ} (V : Fin m → X.Opens) : Prop :=
  (∃ (k : ℕ) (c : Fin k → wcAcC M V ⊤ 0), (∀ i, wcAcD M V ⊤ 0 (c i) = 0) ∧
    ∀ z : wcAcC M V ⊤ 0, wcAcD M V ⊤ 0 z = 0 → ∃ b : Fin k → B,
      z = ∑ i, ((fun a => wcCnSigma h (wcAcV V ⊤ a) (b i) • c i a) : wcAcC M V ⊤ 0)) ∧
  ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → wcAcC M V ⊤ (p + 1)),
    (∀ i, wcAcD M V ⊤ (p + 1) (c i) = 0) ∧
    ∀ z : wcAcC M V ⊤ (p + 1), wcAcD M V ⊤ (p + 1) z = 0 →
      ∃ (b : Fin k → B) (x : wcAcC M V ⊤ p),
        z = ∑ i, ((fun a => wcCnSigma h (wcAcV V ⊤ a) (b i) • c i a) : wcAcC M V ⊤ (p + 1)) +
          wcAcD M V ⊤ p x
def wcLr1uTcClsX {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral P] (str : P ⟶ Spec (.of Ω)) (ι : P ⟶ X)
    (h : P.functionField) (y : X) : Option (IsLocalRing.ResidueField ↥W) → Prop
  | some l => ∃ hy : ι (genericPoint P) ⤳ y, ∃ w : ↥W, IsLocalRing.residue ↥W w = l ∧
      ∃ s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y),
        (wcLr1uGerm ι y hy).hom s = h - wcLr1uConst str (w : Ω)
  | none => ∃ hy : ι (genericPoint P) ⤳ y, ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∃ s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y),
        (wcLr1uGerm ι y hy).hom s = h⁻¹ - wcLr1uConst str (l : Ω)
def wcLfChart {S Q : Type u} [CommRing S] [CommRing Q] [Algebra S Q] {Y : Scheme.{u}}
    (g : Y ⟶ Spec (.of S)) (y : Y) (𝔭 : Ideal Q) : Prop :=
  ∃ (U : Scheme.{u}) (e : U ⟶ Y) (m : U ⟶ Spec (.of Q)) (x : U),
    Etale e ∧ Etale m ∧ m ≫ Spec.map (CommRingCat.ofHom (algebraMap S Q)) = e ≫ g ∧
    e x = y ∧ PrimeSpectrum.asIdeal (m x) = 𝔭 ∧
    Function.Bijective (e.residueFieldMap x).hom ∧ Function.Bijective (m.residueFieldMap x).hom
def wcNsrInvVal {Ω : Type u} [Field Ω] {C : Scheme.{u}} (γ : C ⟶ wcProjK Ω 1)
    (P : Aut C → Prop) : Prop :=
  ∃ (_ : AlgebraicGeometry.IsIntegral C) (A : ValuationSubring C.functionField),
    IsAlgClosed (IsLocalRing.ResidueField ↥A) ∧
    (∀ f : C.functionField, A.valuation f ≤ 1 →
      ∃ (U : (wcProjK Ω 1).Opens) (s : Γ(wcProjK Ω 1, U)) (hU : genericPoint ↥C ∈ γ ⁻¹ᵁ U),
        A.valuation (f - (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hU).hom
          ((γ.app U).hom s)) < 1) ∧
    ∀ g : Aut C, P g → ∀ (V : C.Opens) (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V)
      (hV' : genericPoint ↥C ∈ g.hom ⁻¹ᵁ V),
      (A.valuation ((C.presheaf.germ V (genericPoint ↥C) hV).hom t) ≤ 1 ↔
        A.valuation ((C.presheaf.germ (g.hom ⁻¹ᵁ V) (genericPoint ↥C) hV').hom
          ((g.hom.app V).hom t)) ≤ 1)

abbrev wcNsrLB {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W) : Prop :=
  wcpaDjLlPair W uX x σ₀ a₀ ∧
  ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W), wcpaDjLlPair W uX x σ a → wcpaDjLlExh W γ uX ι x σ a →
    σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀ ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a

abbrev wcNsrNodeVal {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W) : Prop :=
  ∀ (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀)
    [QuasiCompact (γ ≫ ι₀)] [QuasiSeparated (γ ≫ ι₀)],
    wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀) r₀ → ι₀ ≫ r₀ = ι →
    wcpaDjLkModel W (r₀ ≫ uX) ι₀ →
    ∃ w : ↥(wcpaDjLkFib W (γ ≫ ι₀) (r₀ ≫ uX)),
      r₀ (wcpaDjLkImg W (γ ≫ ι₀) (r₀ ≫ uX) w) = x ∧
      ¬ wcpaDjLkSmAt W (r₀ ≫ uX) (wcpaDjLkPi W (γ ≫ ι₀) (r₀ ≫ uX) w) ∧
      wcNsrInvVal γ (wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w)
def wcpaDjEbcExc {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X X' C : Scheme.{u}}
    (f' : C ⟶ X') [QuasiCompact f'] [QuasiSeparated f'] (uX' : X' ⟶ Spec (.of ↥W))
    (r : X' ⟶ X) (x : ↥X) : Set (Set ↥(wcpaDjLkFib W f' uX')) :=
  {E | E ∈ irreducibleComponents ↥(wcpaDjLkFib W f' uX') ∧
    wcpaDjLkImg W f' uX' '' E ⊆ ⇑r ⁻¹' {x}}

def wcpaDjEbcRat {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X' C : Scheme.{u}}
    (f' : C ⟶ X') [QuasiCompact f'] [QuasiSeparated f'] (uX' : X' ⟶ Spec (.of ↥W))
    (E : Set ↥(wcpaDjLkFib W f' uX')) : Prop :=
  ∃ ξ ∈ E, closure {ξ} = E ∧
    ∃ e : ↥((wcpaDjLkFib W f' uX').presheaf.stalk ξ) ≃+* RatFunc (IsLocalRing.ResidueField ↥W),
      e.toRingHom.comp (wcNdSig (Limits.pullback.snd (f'.fromNormalization ≫ uX')
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ξ) =
        algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W))
noncomputable def wcEbGauss {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) : Subring (RatFunc Ω) :=
  Subring.closure {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
    q.map W.subtype ≠ 0 ∧
    f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
      algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)}

noncomputable def wcEbRing {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) : Subring (RatFunc Ω) :=
  Subring.closure (Set.range (fun w : ↥W => algebraMap Ω (RatFunc Ω) (w : Ω)) ∪
    {RatFunc.X, algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹})

noncomputable def wcEbW {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) :
    ↥W →+* ↥(wcEbRing W a) :=
  ((algebraMap Ω (RatFunc Ω)).comp W.subtype).codRestrict (wcEbRing W a)
    (fun w => Subring.subset_closure (Or.inl ⟨w, rfl⟩))

noncomputable def wcEbNode {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) :
    Ideal ↥(wcEbRing W a) :=
  Ideal.span {(⟨RatFunc.X, Subring.subset_closure (Or.inr (Set.mem_insert _ _))⟩ :
      ↥(wcEbRing W a)),
    (⟨algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹,
      Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))⟩ : ↥(wcEbRing W a))} ⊔
  (IsLocalRing.maximalIdeal ↥W).map (wcEbW W a)

def wcEbDefectless {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] : Prop :=
  letI : Algebra ↥(wcEbGauss W) L :=
    ((algebraMap (RatFunc Ω) L).comp (wcEbGauss W).subtype).toAlgebra
  Module.Finite ↥(wcEbGauss W) ↥(integralClosure ↥(wcEbGauss W) L)

def wcEbNodeAll {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] (a : ↥W) : Prop :=
  letI : Algebra ↥(wcEbRing W a) L :=
    ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(wcEbRing W a) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)) = wcEbNode W a →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime 𝔮 →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) P e →
      wcNdModelB W P (e.comp ((algebraMap ↥(integralClosure ↥(wcEbRing W a) L)
        (Localization.AtPrime 𝔮)).comp ((algebraMap ↥(wcEbRing W a)
          ↥(integralClosure ↥(wcEbRing W a) L)).comp (wcEbW W a))))
noncomputable abbrev wcLr1uFnAnnRing {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    {P : Scheme.{u}} [AlgebraicGeometry.IsIntegral P] (str : P ⟶ Spec (.of Ω))
    (h : P.functionField) (ϖ : ↥W) : Subring P.functionField :=
  (MvPolynomial.eval₂Hom ((wcLr1uConst str).comp W.subtype)
    ![h, wcLr1uConst str (ϖ : Ω) * h⁻¹]).range
def wcNsrCentred {C N : Scheme.{u}} [AlgebraicGeometry.IsIntegral C] (t : C ⟶ N) (n : N)
    (A : ValuationSubring C.functionField) : Prop :=
  ∃ h : t (genericPoint C) ⤳ n, wcLr1uDom (wcLr1uGerm t n h).hom (A : Set C.functionField)


def wcNsrBdry {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (f : C ⟶ X) (uX : X ⟶ Spec (.of ↥W)) (x : X)
    (A : ValuationSubring C.functionField) : Prop :=
  wcNsrCentred f x A ∧
  ∃ (η : X) (h : f (genericPoint C) ⤳ η), η ⤳ x ∧ η ≠ x ∧
    uX η = IsLocalRing.closedPoint ↥W ∧
    (∀ η' : X, uX η' = IsLocalRing.closedPoint ↥W → η' ⤳ η → η' = η) ∧
    ∀ s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk η),
      A.valuation ((wcLr1uGerm f η h).hom s) < 1
noncomputable def wcNcxcPhi (R : Type u) [CommRing R] [IsLocalRing R] (B : Type u) [CommRing B]
    [Algebra R B] (𝔔 : Ideal B) [𝔔.IsPrime] (u v : B) (n : ℕ) :
    MvPolynomial (Fin 2) R →ₐ[R] wcNcxFib R B 𝔔 ⧸ wcNcxFibMax R B 𝔔 ^ n :=
  MvPolynomial.aeval (fun i : Fin 2 => Ideal.Quotient.mk (wcNcxFibMax R B 𝔔 ^ n)
    (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔔)))
      (algebraMap B (Localization.AtPrime 𝔔) (![u, v] i))))
def wcNsrNaDom {C Y : Scheme.{u}} [AlgebraicGeometry.IsIntegral C] (A : ValuationSubring C.functionField)
    (h : C ⟶ Y) (y : ↥Y) : Prop :=
  ∃ hy : h (genericPoint ↥C) ⤳ y,
    (∀ s : ↥(Y.presheaf.stalk y), A.valuation ((wcLr1uGerm h y hy).hom s) ≤ 1) ∧
    ∀ s ∈ IsLocalRing.maximalIdeal ↥(Y.presheaf.stalk y),
      A.valuation ((wcLr1uGerm h y hy).hom s) < 1

def wcNsrNaLim {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W))
    (ι : wcProjK Ω 1 ⟶ X) (x : ↥X) (A : ValuationSubring C.functionField) : Prop :=
  (∀ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W), wcNsrLB W γ uX ι x σ₀ a₀ →
    ∀ (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀),
      wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀) r₀ → ι₀ ≫ r₀ = ι →
      wcpaDjLkModel W (r₀ ≫ uX) ι₀ →
      ∃ z : ↥X₀, r₀ z = x ∧ wcNsrNaDom A (γ ≫ ι₀) z ∧
        ∀ p : ↥(Limits.pullback (r₀ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
          Limits.pullback.fst (r₀ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p = z →
          ¬ wcpaDjLkSmAt W (r₀ ≫ uX) p) ∧
  (∀ (σ : Spec (.of ↥W) ⟶ X) (a b : ↥W), wcpaDjLlPair W uX x σ a →
    wcpaDjLlExh W γ uX ι x σ a → wcNsrLB W γ uX ι x σ b →
    ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ → ι₁ ≫ r₁ = ι →
      wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
      ∀ σ' : Spec (.of ↥W) ⟶ X₁, σ' ≫ r₁ = σ →
        wcNsrNaDom A (γ ≫ ι₁) (σ' (IsLocalRing.closedPoint ↥W)))

abbrev wcNsrNaHyp {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W) : Prop :=
  ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ W ≠ ⊤ ∧ wcpaDjLkCov Ω γ ∧ wcpaDjLkGalois γ ∧
  wcpaDjLkModel W uX ι ∧
  wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) ∧
  wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) ∧
  wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) τ ∧
  wcpaDjLlExhBasic W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) ∧
  (¬ ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
    wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ∧
    wcpaDjLlMinExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a) ∧
  (∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
    wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀) ∧
  (¬ ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
    wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀ ∧
    ∀ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
      wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' →
      σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀)
def wcLfLLP {Q L : Type u} [CommRing Q] [CommRing L] (φ : Q →+* L) (𝔭 : Ideal Q) : Prop :=
  ∀ (B : Type u) [CommRing B], HenselianLocalRing B → ∀ g : Q →+* B,
    (∀ a, IsUnit (g a) ↔ a ∉ 𝔭) → ∃! h : L →+* B, h.comp φ = g ∧ IsLocalHom h
def wcNsrNlbLim {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W))
    (ι : wcProjK Ω 1 ⟶ X) (x : ↥X) (A : ValuationSubring C.functionField) : Prop :=
  ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
    wcpaDjLlPair W uX x σ a → wcpaDjLlPair W uX x σ' a' →
    wcpaDjLlExh W γ uX ι x σ a → wcpaDjLlExh W γ uX ι x σ' a' →
    σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a →
    ¬ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' →
    ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ → ι₁ ≫ r₁ = ι →
      wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
      ∀ σ₁ : Spec (.of ↥W) ⟶ X₁, σ₁ ≫ r₁ = σ' →
        wcNsrNaDom A (γ ≫ ι₁) (σ₁ (IsLocalRing.closedPoint ↥W))

abbrev wcNsrNlbHyp {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W) : Prop :=
  ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ W ≠ ⊤ ∧ wcpaDjLkCov Ω γ ∧ wcpaDjLkGalois γ ∧
  wcpaDjLkModel W uX ι ∧
  wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) ∧
  wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) ∧
  wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) τ ∧
  wcpaDjLlExhBasic W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) ∧
  (¬ ∃ (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W),
    wcNsrLB W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a₀)
noncomputable def wcGcHilb {K : Type u} [Field K] {N : ℕ} {Z : Scheme.{u}} (j : Z ⟶ wcProjK K N)
    (e : ℕ) : ℕ :=
  Module.finrank K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ⧸
    Submodule.span K {F | wcEszVanish j e F})

def wcGcChi (K : Type u) [Field K] {Z : Scheme.{u}} (s : Z ⟶ Spec (.of K)) (c : ℤ) : Prop :=
  ∃ (N : ℕ) (j : Z ⟶ wcProjK K N), IsClosedImmersion j ∧ j ≫ wcProjKStr K N = s ∧
    ∃ d e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → (wcGcHilb j e : ℤ) = (d : ℤ) * (e : ℤ) + c

def wcGcNormDatum {Zt Z : Scheme.{u}} (ν : Zt ⟶ Z) : Prop :=
  IsFinite ν ∧
    (∀ z : Zt, IsDomain (Zt.presheaf.stalk z) ∧ IsIntegrallyClosed (Zt.presheaf.stalk z)) ∧
    ∃ U : Z.Opens, Dense (U : Set Z) ∧ Dense ((ν ⁻¹ᵁ U : Zt.Opens) : Set Zt) ∧ IsIso (ν ∣_ U)

noncomputable def wcGcFibStr {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X C : Scheme.{u}}
    (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f] (uX : X ⟶ Spec (.of ↥W)) :
    wcpaDjLkFib W f uX ⟶ Spec (.of (IsLocalRing.ResidueField ↥W)) :=
  Limits.pullback.snd (f.fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
def wcRfAdm (V F : Type*) [CommRing V] [CommRing F] [Algebra V F] (t : V) : Prop :=
  Function.Injective (algebraMap V F) ∧ IsUnit (algebraMap V F t) ∧
  (∃ G : Finset F, ∀ x : F, ∃ n : ℕ, algebraMap V F t ^ n * x ∈ Submodule.span V (G : Set F)) ∧
  (∀ y : F, y ≠ 0 → ∃ z : F, y * z = 1 ∧ (IsIntegral V y ∨ IsIntegral V z)) ∧
  (∀ y z : F, IsIntegral V y → IsIntegral V z →
    ∃ w : F, IsIntegral V w ∧ (y = w * z ∨ z = w * y)) ∧
  (∀ y : F, y ≠ 0 → IsIntegral V y → ∃ (c : V) (u v : F),
    y = algebraMap V F c * u ∧ u * v = 1 ∧ IsIntegral V u ∧ IsIntegral V v)


def wcRfCart (V F : Type*) [CommRing V] [CommRing F] [Algebra V F] (t : V) : Prop :=
  ∃ (n : ℕ) (b : Fin n → F), (∀ j, IsIntegral V (b j)) ∧
    (∀ x : F, ∃ N : ℕ, algebraMap V F t ^ N * x ∈ Submodule.span V (Set.range b)) ∧
    (∀ c : Fin n → V, (∃ j, IsUnit (c j)) → ∀ (r : V) (y : F), ¬ IsUnit r → IsIntegral V y →
      ∑ j, algebraMap V F (c j) * b j ≠ algebraMap V F r * y)

open Classical in

noncomputable def wcRfAbs (V : Type*) {B : Type*} [CommRing V] [CommRing B] [Algebra V B]
    (τ x : B) : ℝ :=
  if x = 0 then 0 else (2 : ℝ) ^ (-(sSup {q : ℝ | ∃ (m k n : ℕ) (y : B), 0 < n ∧
    IsIntegral V y ∧ τ ^ k * x ^ n = τ ^ m * y ∧ q = ((m : ℝ) - (k : ℝ)) / (n : ℝ)}))
inductive wcLlsKind {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) : Type u
  | disc (t : A) : wcLlsKind W A
  | ann (u v : A) (g : ↥W) : wcLlsKind W A


def wcLlsFS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {L : Type u} [Field L]
    (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] : Type u :=
  Localization.AtPrime 𝔮 ⧸
    (Ideal.span {b : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
      (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮))

noncomputable instance wcLlsFS.instCommRing {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    {L : Type u} [Field L] (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] : CommRing (wcLlsFS W wL R 𝔮) :=
  Ideal.Quotient.commRing _


def wcLlsPD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (𝔭 : Ideal A) (k : wcLlsKind W A) : Prop :=
  Algebra.FiniteType ↥W A ∧ NoZeroSMulDivisors ↥W A ∧ IsIntegrallyClosed A ∧ 𝔭.IsMaximal ∧
  (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 ∧
  match k with
  | .disc t => t ∈ 𝔭 ∧
      𝔭 = Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∧
      ∃ h : A, h ∉ 𝔭 ∧ ∃ f : Polynomial ↥W →+* Localization.Away h,
        f.comp Polynomial.C = (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) ∧
        f Polynomial.X = algebraMap A (Localization.Away h) t ∧
        RingHom.Etale (R := Polynomial ↥W) (S := Localization.Away h) f
  | .ann u v g => g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧ u * v = algebraMap ↥W A g ∧
      𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∧
      ∃ h : A, h ∉ 𝔭 ∧ ∃ f : (MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+*
          Localization.Away h,
        f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) ∧
        f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = algebraMap A (Localization.Away h) u ∧
        f (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = algebraMap A (Localization.Away h) v ∧
        RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
          (S := Localization.Away h) f


def wcLlsSepAt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (z : A) (s : K) : Prop :=
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) 𝔮)


def wcLlsDiscSep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c b : ↥W) : Prop :=
  wcLlsSepAt W A K L (t - algebraMap ↥W A c)
    (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c))


def wcLlsAnnSep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (b : ↥W) : Prop :=
  wcLlsSepAt W A K L u (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u)


def wcLlsLocMax {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (k : wcLlsKind W A) : Prop :=
  match k with
  | .disc t =>
    ∃ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧
      wcLlsDiscSep W A K L t c b ∧
      ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
        b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → b ∣ b' → b ∣ c' - c → b' ∣ b
  | .ann u _ g =>
    ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ b ∣ g ∧ wcLlsAnnSep W A K L u b ∧
      ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ∣ g → b ∣ b' →
        wcLlsAnnSep W A K L u b' → b' ∣ b

open Pointwise in

def wcLlsDec (A : Type u) [CommRing A] (K : Type u) [Field K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] (y : Ideal ↥(integralClosure A L)) : Subgroup (L ≃ₐ[K] L) :=
  MulAction.stabilizer (L ≃ₐ[K] L)
    (((↑) : ↥(integralClosure A L) → L) '' (y : Set ↥(integralClosure A L)))


def wcLlsSolvPt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L]
    [Algebra A L] (𝔭 : Ideal A) (k : wcLlsKind W A) (y : Ideal ↥(integralClosure A L)) : Prop :=
  y.IsPrime ∧ y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 ∧
  Group.IsSolvable ↥(wcLlsDec A K L y) ∧
  ∀ (_ : y.IsPrime) (t : A), k = .disc t →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) ≠ 0


def wcLlsUniq (A : Type u) [CommRing A] (L : Type u) [Field L] [Algebra A L] (𝔭 : Ideal A)
    (y : Ideal ↥(integralClosure A L)) : Prop :=
  ∀ y' : Ideal ↥(integralClosure A L), y'.IsPrime →
    y'.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → y' = y


def wcLlsGenPt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L] (𝔭 : Ideal A)
    (Q : Ideal ↥(integralClosure A L)) : Prop :=
  Q.IsPrime ∧ Q.comap (algebraMap A ↥(integralClosure A L)) ≤ 𝔭 ∧
  ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ Q.comap (algebraMap A ↥(integralClosure A L))


def wcLlsRam (A : Type u) [CommRing A] (K : Type u) [Field K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] (Q : Ideal ↥(integralClosure A L)) : Prop :=
  ∃ g : L ≃ₐ[K] L, g ≠ 1 ∧ ∀ x : ↥(integralClosure A L), ∃ q ∈ Q, (q : L) = g x - x


def wcLlsBR {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
    (𝔭 : Ideal A) (k : wcLlsKind W A) : Prop :=
  match k with
  | .disc t => ∀ c c' : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q) →
      (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c' ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q) → c = c'
  | .ann _ _ _ => ∀ Q, wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q


def wcLlsLocThm {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (P : ℕ → Prop) : Prop :=
  ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 k → wcLlsSolvPt W A K L 𝔭 k y → wcLlsUniq A L 𝔭 y →
    P (Nat.card ↥(wcLlsDec A K L y)) → wcLlsLocMax W A K L k


def wcLlsLocThmBR {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (P : ℕ → Prop) : Prop :=
  ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 k → wcLlsSolvPt W A K L 𝔭 k y → wcLlsUniq A L 𝔭 y → wcLlsBR W A K L 𝔭 k →
    P (Nat.card ↥(wcLlsDec A K L y)) → wcLlsLocMax W A K L k


def wcLlsChartThm {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (P : ℕ → Prop) : Prop :=
  ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 k → wcLlsSolvPt W A K L 𝔭 k y →
    P (Nat.card ↥(wcLlsDec A K L y)) → wcLlsLocMax W A K L k
abbrev wcUbRigid {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (s : C ⟶ Spec (.of Ω))
    (V : ValuationSubring C.functionField) : Prop :=
  ∃ P : C, IsClosed ({P} : Set C) ∧ ∀ f : C.functionField, f ∈ V ↔
    ∃ (g : C.presheaf.stalk P) (c : ↥W),
      (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom g = f ∧
      g - ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop ≫ C.presheaf.germ ⊤ P trivial).hom (c : Ω) ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk P)

abbrev wcUbShare {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W))
    (ι : wcProjK Ω 1 ⟶ X) (σ₀ : Spec (.of ↥W) ⟶ X) (b : ↥W)
    (V A : ValuationSubring C.functionField) : Prop :=
  ∃ (Xb : Scheme.{u}) (rb : Xb ⟶ X) (ιb : wcProjK Ω 1 ⟶ Xb)
    (_ : QuasiCompact (γ ≫ ιb)) (_ : QuasiSeparated (γ ≫ ιb)),
    wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) rb ∧ ιb ≫ rb = ι ∧
    wcpaDjLkModel W (rb ≫ uX) ιb ∧
    ∃ q : ↥(γ ≫ ιb).normalization,
      wcNsrCentred (γ ≫ ιb).toNormalization q V ∧ wcNsrCentred (γ ≫ ιb).toNormalization q A
noncomputable def wcEbCdJ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) :
    MvPolynomial (Fin 1) ↥W →+* RatFunc Ω :=
  MvPolynomial.eval₂Hom ((algebraMap Ω (RatFunc Ω)).comp W.subtype) (fun _ => RatFunc.X)

noncomputable def wcEbCdRho {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) :
    MvPolynomial (Fin 1) ↥W →+* ↥(wcEbRing W a) :=
  MvPolynomial.eval₂Hom (wcEbW W a)
    (fun _ => ⟨RatFunc.X, Subring.subset_closure (Or.inr (Set.mem_insert _ _))⟩)
abbrev wcEbntN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) : Type u :=
  MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}

noncomputable abbrev wcEbntX {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W)
    (i : Fin 2) : wcEbntN W a :=
  Ideal.Quotient.mk _ (MvPolynomial.X i)

def wcEbntPres {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {P : Type u} [CommRing P]
    (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P) : Prop :=
  a ∈ IsLocalRing.maximalIdeal ↥W ∧ a ≠ 0 ∧
    f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = σ ∧
    wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f
abbrev wcNdHfIdx (A : Type u) [CommRing A] [IsLocalRing A] : Type u :=
  Σ n : ℕ, Σ J : {J : Ideal (MvPolynomial (Fin n) A) //
    Algebra.Etale A (MvPolynomial (Fin n) A ⧸ J)},
    (MvPolynomial (Fin n) A ⧸ J.1) →ₐ[A] IsLocalRing.ResidueField A

abbrev wcNdHfStage (A : Type u) [CommRing A] [IsLocalRing A] (i : wcNdHfIdx A) : Type u :=
  MvPolynomial (Fin i.1) A ⧸ i.2.1.1
def wcNsrNaWin {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W))
    (ι : wcProjK Ω 1 ⟶ X) (x : ↥X) (σ : Spec (.of ↥W) ⟶ X) (b : ↥W)
    (V : ValuationSubring C.functionField) : Prop :=
  ∃ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁),
    wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) r₁ ∧ ι₁ ≫ r₁ = ι ∧
    wcpaDjLkModel W (r₁ ≫ uX) ι₁ ∧
    ∃ z : ↥X₁, r₁ z = x ∧ wcNsrNaDom V (γ ≫ ι₁) z ∧
      ∃ p : ↥(Limits.pullback (r₁ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        Limits.pullback.fst (r₁ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p = z ∧
        wcpaDjLkSmAt W (r₁ ≫ uX) p
abbrev wcLlncDom (F : Scheme.{u}) (ξ y : ↥F) (V : ValuationSubring ↥(F.residueField ξ)) : Prop :=
  ∃ h : ξ ⤳ y, ∀ s : ↥(F.presheaf.stalk y),
    ∃ hs : (F.presheaf.stalkSpecializes h ≫ F.residue ξ).hom s ∈ V,
      s ∈ IsLocalRing.maximalIdeal ↥(F.presheaf.stalk y) →
        (⟨(F.presheaf.stalkSpecializes h ≫ F.residue ξ).hom s, hs⟩ : V) ∈
          IsLocalRing.maximalIdeal V
def wcRfEG (V F : Type*) [CommRing V] [CommRing F] [Algebra V F] (t : V) : Prop :=
  ∃ (n : ℕ) (g : Polynomial V) (θ : F), g.Monic ∧ g.natDegree = n ∧ Polynomial.aeval θ g = 0 ∧
    (∃ v : F, IsIntegral V v ∧ Polynomial.aeval θ (Polynomial.derivative g) * v = 1) ∧
    ∀ x : F, ∃ N : ℕ, algebraMap V F t ^ N * x ∈
      Submodule.span V (Set.range fun i : Fin n => θ ^ (i : ℕ))

def wcRfRF (V F : Type*) [CommRing V] [CommRing F] [Algebra V F] (g : Polynomial V) (θ : F) :
    Prop :=
  g.Monic ∧ Polynomial.aeval θ g = 0 ∧
    (∃ v : F, IsIntegral V v ∧ Polynomial.aeval θ (Polynomial.derivative g) * v = 1) ∧
    ∀ y : F, IsIntegral V y → ∃ (h : Polynomial V) (r : V) (z : F), ¬ IsUnit r ∧ IsIntegral V z ∧
      y - Polynomial.aeval θ h = algebraMap V F r * z
noncomputable def wcG2cPhi {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W)) (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) : ↥W →+* ↑Γ(X, V) :=
  (uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom

open Classical in
noncomputable def wcG2cTau {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (V : X.Opens) (t : ↑Γ(X, V)) (σ : Spec (.of ↥W) ⟶ X) : ↥W :=
  if h : σ (IsLocalRing.closedPoint ↥W) ∈ V then
    (Scheme.ΓSpecIso (.of ↥W)).hom.hom
      ((σ.appLE V ⊤ (Scheme.preimage_eq_top_of_closedPoint_mem σ h).ge).hom t)
  else 0

noncomputable def wcG2cKap {C X : Scheme.{u}} [IrreducibleSpace C] (f : C ⟶ X) (V : X.Opens)
    (h : genericPoint C ∈ f ⁻¹ᵁ V) : ↑Γ(X, V) →+* ↑C.functionField :=
  (f.app V ≫ C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) h).hom

def wcG2cChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W)) (x : ↥X) (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤)
    (g : MvPolynomial (Fin 1) ↥W →+* ↑Γ(X, V)) (𝔭 : Ideal ↑Γ(X, V)) : Prop :=
  IsAffineOpen V ∧ x ∈ V ∧ IsDomain ↑Γ(X, V) ∧ g.Etale ∧
  g.comp MvPolynomial.C = wcG2cPhi W uX V hle ∧
  (∀ f : ↑Γ(X, V), f ∈ 𝔭 ↔ x ∉ X.basicOpen f) ∧
  (letI : Algebra ↥W ↑Γ(X, V) := (wcG2cPhi W uX V hle).toAlgebra
   wcLlsPD W ↑Γ(X, V) 𝔭 (.disc (g (MvPolynomial.X 0)))) ∧
  ∃ σ₀ : Spec (.of ↥W) ⟶ X, σ₀ ≫ uX = 𝟙 _ ∧ σ₀ (IsLocalRing.closedPoint ↥W) = x ∧
    wcG2cTau W V (g (MvPolynomial.X 0)) σ₀ = 0
def wcGcDfSec {K : Type u} [Field K] {N : ℕ} {T : Scheme.{u}} (φ : T ⟶ wcProjK K N) (e : ℕ) :
    Set (∀ a : Fin (N + 1), Γ(T, φ ⁻¹ᵁ wcSgD K N a)) :=
  {f | ∀ a b : Fin (N + 1),
    (T.presheaf.map (homOfLE (inf_le_right : φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ≤
        φ ⁻¹ᵁ wcSgD K N b)).op).hom (f b) =
      wcEszG φ a b ^ e *
        (T.presheaf.map (homOfLE (inf_le_left : φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ≤
          φ ⁻¹ᵁ wcSgD K N a)).op).hom (f a)}

noncomputable def wcGcDfRk {K : Type u} [Field K] {N : ℕ} {T : Scheme.{u}}
    (φ : T ⟶ wcProjK K N) (e : ℕ) : ℕ∞ :=
  ⨆ (n : ℕ) (v : Fin n → ↥(wcGcDfSec φ e))
    (_ : ∀ c : Fin n → K, (∀ a : Fin (N + 1),
      ∑ i, wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) (c i) * (v i).1 a = 0) → ∀ i, c i = 0),
    (n : ℕ∞)

def wcGcDfCoc {K : Type u} [Field K] {N : ℕ} {T : Scheme.{u}} (φ : T ⟶ wcProjK K N) (m : ℕ)
    (c : ∀ a b : Fin (N + 1), Γ(T, φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)) : Prop :=
  ∀ a b l : Fin (N + 1),
    (T.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓ φ ⁻¹ᵁ wcSgD K N l ≤
          φ ⁻¹ᵁ wcSgD K N b ⊓ φ ⁻¹ᵁ wcSgD K N l)).op).hom (wcEszG φ b l ^ m) *
      (T.presheaf.map (homOfLE (inf_le_left : φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓
        φ ⁻¹ᵁ wcSgD K N l ≤ φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)).op).hom (c a b) +
      (T.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓ φ ⁻¹ᵁ wcSgD K N l ≤
          φ ⁻¹ᵁ wcSgD K N b ⊓ φ ⁻¹ᵁ wcSgD K N l)).op).hom (c b l) =
    (T.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓ φ ⁻¹ᵁ wcSgD K N l ≤
          φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N l)).op).hom (c a l)

def wcGcDfCob {K : Type u} [Field K] {N : ℕ} {T : Scheme.{u}} (φ : T ⟶ wcProjK K N) (m : ℕ)
    (c : ∀ a b : Fin (N + 1), Γ(T, φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)) : Prop :=
  ∃ s : ∀ a : Fin (N + 1), Γ(T, φ ⁻¹ᵁ wcSgD K N a), ∀ a b : Fin (N + 1),
    c a b = (T.presheaf.map (homOfLE (inf_le_right : φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ≤
        φ ⁻¹ᵁ wcSgD K N b)).op).hom (s b) -
      wcEszG φ a b ^ m *
        (T.presheaf.map (homOfLE (inf_le_left : φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ≤
          φ ⁻¹ᵁ wcSgD K N a)).op).hom (s a)
def wcTrM (V K N : Type*) [CommRing V] [Field K] [Field N] [Algebra K N] [Algebra V N] :
    IntermediateField K N :=
  IntermediateField.fixedField (Subgroup.closure {σ : N ≃ₐ[K] N | ∀ x : N, IsIntegral V x →
    IsIntegral V (σ x - x) ∧ (σ x - x = 0 ∨ ¬ IsIntegral V (σ x - x)⁻¹)}) ⊓
    separableClosure K N
def wcUeReg {C Y : Scheme.{u}} [AlgebraicGeometry.IsIntegral C] (h : C ⟶ Y) (y : ↥Y)
    (f : C.functionField) : Prop :=
  ∃ hy : h (genericPoint ↥C) ⤳ y, ∃ s : ↥(Y.presheaf.stalk y), (wcLr1uGerm h y hy).hom s = f

def wcUeMax {C Y : Scheme.{u}} [AlgebraicGeometry.IsIntegral C] (h : C ⟶ Y) (y : ↥Y)
    (f : C.functionField) : Prop :=
  ∃ hy : h (genericPoint ↥C) ⤳ y, ∃ s ∈ IsLocalRing.maximalIdeal ↥(Y.presheaf.stalk y),
    (wcLr1uGerm h y hy).hom s = f

def wcUeSmPt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X₁ : Scheme.{u}}
    (u₁ : X₁ ⟶ Spec (.of ↥W)) (p : ↥X₁) : Prop :=
  ∃ w : ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
    Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = p ∧
    wcpaDjLkSmAt W u₁ w

noncomputable def wcUeK0 {Ω : Type u} [Field Ω] {C : Scheme.{u}} [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) : Subfield C.functionField :=
  Subfield.closure {f | ∃ (U : (wcProjK Ω 1).Opens) (s : Γ(wcProjK Ω 1, U))
    (hU : genericPoint ↥C ∈ γ ⁻¹ᵁ U),
    (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hU).hom ((γ.app U).hom s) = f}

def wcUeRegAt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W))
    (ι : wcProjK Ω 1 ⟶ X) (x : ↥X) (σ : Spec (.of ↥W) ⟶ X) (a : ↥W)
    (f : C.functionField) (strict : Prop) : Prop :=
  ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁),
    wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ → ι₁ ≫ r₁ = ι →
    wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
    ∀ p : ↥X₁, r₁ p = x → wcUeSmPt W (r₁ ≫ uX) p →
      wcUeReg (γ ≫ ι₁) p f ∧ (strict → wcUeMax (γ ≫ ι₁) p f)

noncomputable def wcUePi {Ω : Type u} [Field Ω] {C X X₁ : Scheme.{u}} (γ : C ⟶ wcProjK Ω 1)
    (ι : wcProjK Ω 1 ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁) (r₁ : X₁ ⟶ X) (h : ι₁ ≫ r₁ = ι)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)] :
    (γ ≫ ι₁).normalization ⟶ (γ ≫ ι).normalization :=
  (γ ≫ ι₁).normalizationDesc
    (Limits.pullback.lift (γ ≫ ι).toNormalization (γ ≫ ι₁)
      (by rw [Scheme.Hom.toNormalization_fromNormalization, Category.assoc, h]))
    (Limits.pullback.snd (γ ≫ ι).fromNormalization r₁)
    (Limits.pullback.lift_snd _ _ _).symm ≫ Limits.pullback.fst _ _
abbrev wcEbdQR {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W) : Type u :=
  MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}

noncomputable abbrev wcEbdQ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W) : Scheme.{u} :=
  Spec (.of (wcEbdQR W c))

noncomputable abbrev wcEbdQX {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W)
    (i : Fin 2) : wcEbdQR W c :=
  Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
    (MvPolynomial.X i)

noncomputable abbrev wcEbdA1 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) : Scheme.{u} :=
  Spec (.of (MvPolynomial (Fin 1) ↥W))

noncomputable abbrev wcEbdStr {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) :
    wcEbdA1 W ⟶ Spec (.of ↥W) :=
  Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))

noncomputable abbrev wcEbdSec {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W) :
    Spec (.of ↥W) ⟶ wcEbdA1 W :=
  Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c)))

noncomputable abbrev wcEbdJ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W) :
    (wcEbdA1 W).IdealSheafData :=
  Scheme.Hom.ker (wcEbdSec W 0) ⊔ wcNcPrincipal (.of ↥W) (wcEbdA1 W) (wcEbdStr W) c

noncomputable abbrev wcEbdShift {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W) :
    wcEbdA1 W ⟶ wcEbdA1 W :=
  Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom MvPolynomial.C
    (fun _ : Fin 1 => MvPolynomial.X 0 + MvPolynomial.C c)))

noncomputable abbrev wcEbdHX {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : ↥W) :
    wcEbdQ W c ⟶ wcEbdA1 W :=
  Spec.map (CommRingCat.ofHom
    ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp
      (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin 2))).toRingHom))
noncomputable abbrev wcLlsaS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {B : Type u}
    [CommRing B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K] (t : B) (c a : ↥W) : K :=
  algebraMap B K (algebraMap ↥W B a) / algebraMap B K (t - algebraMap ↥W B c)

abbrev wcLlsaA {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {B : Type u}
    [CommRing B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K] (t : B) (c a : ↥W) :
    Type u :=
  ↥(Algebra.adjoin B {wcLlsaS W K t c a})

noncomputable abbrev wcLlsaN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {B : Type u}
    [CommRing B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K] (t : B) (c a : ↥W)
    [Algebra ↥W (wcLlsaA W K t c a)] : Ideal (wcLlsaA W K t c a) :=
  Ideal.span {algebraMap B (wcLlsaA W K t c a) (t - algebraMap ↥W B c),
      ⟨wcLlsaS W K t c a, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (wcLlsaA W K t c a))
noncomputable def wcNsrNaKg {Ω : Type u} [Field Ω] [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)]
    {X : Scheme.{u}} (ι : wcProjK Ω 1 ⟶ X) (V : X.Opens)
    (hη : genericPoint ↥(wcProjK Ω 1) ∈ ι ⁻¹ᵁ V) : Γ(X, V) →+* (wcProjK Ω 1).functionField :=
  ((wcProjK Ω 1).presheaf.germ (ι ⁻¹ᵁ V) (genericPoint ↥(wcProjK Ω 1)) hη).hom.comp
    (ι.app V).hom

noncomputable def wcNsrNaOm {Ω : Type u} [Field Ω] [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)]
    {W : ValuationSubring Ω} {X : Scheme.{u}} (ι : wcProjK Ω 1 ⟶ X) (V : X.Opens)
    (hη : genericPoint ↥(wcProjK Ω 1) ∈ ι ⁻¹ᵁ V) (g : MvPolynomial (Fin 1) ↥W →+* Γ(X, V)) :
    ↥W →+* (wcProjK Ω 1).functionField :=
  (wcNsrNaKg ι V hη).comp (g.comp MvPolynomial.C)

noncomputable def wcNsrNaS {Ω : Type u} [Field Ω] [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)]
    {W : ValuationSubring Ω} {X : Scheme.{u}} (ι : wcProjK Ω 1 ⟶ X) (V : X.Opens)
    (hη : genericPoint ↥(wcProjK Ω 1) ∈ ι ⁻¹ᵁ V) (g : MvPolynomial (Fin 1) ↥W →+* Γ(X, V))
    (t : ↥W) : (wcProjK Ω 1).functionField :=
  wcNsrNaKg ι V hη (g (MvPolynomial.X 0) - g (MvPolynomial.C t))

abbrev wcNsrNaChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W)) (x : ↥X) (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤)
    (g : MvPolynomial (Fin 1) ↥W →+* Γ(X, V)) (τ' : (Spec (.of ↥W) ⟶ X) → ↥W) (c : ↥W) : Prop :=
  IsAffineOpen V ∧ x ∈ V ∧ g.Etale ∧
  g.comp MvPolynomial.C = (uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom ∧
  wcpaDjLlDiscParam W uX x τ' ∧
  ∀ (σ : Spec (.of ↥W) ⟶ X) (e : ⊤ ≤ σ ⁻¹ᵁ V), σ ≫ uX = 𝟙 _ →
    σ (IsLocalRing.closedPoint ↥W) = x →
    (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom (g (MvPolynomial.X 0))) = τ' σ + c
noncomputable def wcGrRoute {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] : MvPolynomial (Fin d) ↥W →+* wcGbVhat W ϖ d :=
  (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d)).comp
    (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d))

noncomputable def wcGrZmap {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] (F' : Type u) [CommRing F'] [Algebra (wcGbVhat W ϖ d) F']
    (z : Fin d → F') : MvPolynomial (Fin d) ↥W →+* F' :=
  MvPolynomial.eval₂Hom
    (((algebraMap (wcGbVhat W ϖ d) F').comp (wcGrRoute W ϖ d)).comp MvPolynomial.C) z

def wcGrUnit (V F : Type u) [CommRing V] [CommRing F] [Algebra V F] (y : F) : Prop :=
  IsIntegral V y ∧ ∃ v : F, IsIntegral V v ∧ y * v = 1

def wcGrMax (V F : Type u) [CommRing V] [CommRing F] [Algebra V F] (y : F) : Prop :=
  IsIntegral V y ∧ ∀ v : F, IsIntegral V v → y * v ≠ 1

def wcGrGauss {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] (F' : Type u) [CommRing F'] [Algebra (wcGbVhat W ϖ d) F']
    (z : Fin d → F') : Prop :=
  (∀ i, IsIntegral (wcGbVhat W ϖ d) (z i)) ∧
    ∀ f : MvPolynomial (Fin d) ↥W, (∃ e, IsUnit (f.coeff e)) →
      wcGrUnit (wcGbVhat W ϖ d) F' (wcGrZmap W ϖ d F' z f)

def wcGrEmb {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] (F' : Type u) [CommRing F'] [Algebra (wcGbVhat W ϖ d) F']
    (z : Fin d → F') (ψ : wcGbVhat W ϖ d →+* F') : Prop :=
  ψ.comp (wcGrRoute W ϖ d) = wcGrZmap W ϖ d F' z ∧
    ∀ c : wcGbVhat W ϖ d, IsIntegral (wcGbVhat W ϖ d) (ψ c)

def wcGrLattice {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] (F' : Type u) [CommRing F'] [Algebra (wcGbVhat W ϖ d) F']
    (ψ : wcGbVhat W ϖ d →+* F') : Prop :=
  ∃ (m : ℕ) (G : Fin m → F'), ∀ x : F', ∃ (N : ℕ) (c : Fin m → wcGbVhat W ϖ d),
    algebraMap (wcGbVhat W ϖ d) F' (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d)) ^ N * x =
      ∑ j, ψ (c j) * G j
noncomputable abbrev wcUaAbs {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] {F : Type u} [CommRing F] [Algebra (wcGbVhat W ϖ d) F] (x : F) : ℝ :=
  wcRfAbs (wcGbVhat W ϖ d)
    (algebraMap (wcGbVhat W ϖ d) F (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d))) x

noncomputable abbrev wcUaIota {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] (F : Type u) [CommRing F] [Algebra (wcGbVhat W ϖ d) F] (w : ↥W) : F :=
  algebraMap (wcGbVhat W ϖ d) F (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d)
    (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C w)))

def wcUaConst {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] {F : Type u} [CommRing F] [Algebra (wcGbVhat W ϖ d) F] (c : F) : Prop :=
  ∃ (w : ↥W) (m : ℕ),
    algebraMap (wcGbVhat W ϖ d) F (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d)) ^ m * c =
      wcUaIota W ϖ d F w

noncomputable def wcUaExp {F : Type u} [CommRing F] (p : ℕ) {ι₀ : Type u} (u : ι₀ → F) (l₀ : F)
    (l : ℕ × ι₀ →₀ F) : F :=
  l₀ + l.sum (fun q c => c * u q.2 ^ (p ^ q.1))

def wcUaOrth {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] {F : Type u} [CommRing F] [Algebra (wcGbVhat W ϖ d) F] (p : ℕ)
    {ι₀ : Type u} (u : ι₀ → F) : Prop :=
  ∀ (l₀ : F) (l : ℕ × ι₀ →₀ F), wcUaConst W ϖ d l₀ → (∀ q, wcUaConst W ϖ d (l q)) →
    wcUaAbs W ϖ d l₀ ≤ wcUaAbs W ϖ d (wcUaExp p u l₀ l) ∧
      ∀ q, wcUaAbs W ϖ d (l q) ≤ wcUaAbs W ϖ d (wcUaExp p u l₀ l)

def wcUaDense {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] {F : Type u} [CommRing F] [Algebra (wcGbVhat W ϖ d) F] (p : ℕ)
    {ι₀ : Type u} (u : ι₀ → F) : Prop :=
  ∀ (x : F) (ε : ℝ), 0 < ε → ∃ (l₀ : F) (l : ℕ × ι₀ →₀ F), wcUaConst W ϖ d l₀ ∧
    (∀ q, wcUaConst W ϖ d (l q)) ∧ wcUaAbs W ϖ d (x - wcUaExp p u l₀ l) < ε

def wcUaPerp {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W) (d : ℕ)
    [(wcGbP W ϖ d).IsPrime] {F : Type u} [CommRing F] [Algebra (wcGbVhat W ϖ d) F] (p : ℕ)
    {ι₀ : Type u} (u : ι₀ → F) : Prop :=
  ∀ (μ : ι₀ →₀ F), (∀ j, wcUaConst W ϖ d (μ j)) → ∀ y : F,
    wcUaAbs W ϖ d (μ.sum fun j c => c * u j) ≤ wcUaAbs W ϖ d ((μ.sum fun j c => c * u j) + y ^ p)
def wcUtImm (V K N : Type*) [CommRing V] [Field K] [Field N] [Algebra K N] [Algebra V K]
    [Algebra V N] [IsScalarTower V K N] (A B : IntermediateField K N) : Prop :=
  ∀ y : ↥B, IsIntegral V y → ∃ c : ↥A, IsIntegral V c ∧ ∃ (r : V) (z : ↥B), ¬ IsUnit r ∧
    IsIntegral V z ∧ (y : N) - (c : N) = algebraMap V N r * (z : N)
def wcGcSjRelSec {κ : Type u} [Field κ] {N : ℕ} {Z Zt : Scheme.{u}} (j : Z ⟶ wcProjK κ N)
    (ν : Zt ⟶ Z) (e : ℕ) : Set (∀ a : Fin (N + 1), Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a)) :=
  { b | ∀ a c : Fin (N + 1), ∃ g : Γ(Z, j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N c),
      Zt.presheaf.map (homOfLE inf_le_right).op (b c) -
          wcEszG (ν ≫ j) a c ^ e * Zt.presheaf.map (homOfLE inf_le_left).op (b a) =
        ν.appLE (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N c)
          ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N c) le_rfl g }

noncomputable def wcGcSjQRk {κ : Type u} [Field κ] {N : ℕ} {Z Zt : Scheme.{u}}
    (j : Z ⟶ wcProjK κ N) (ν : Zt ⟶ Z) (e : ℕ) : ℕ∞ :=
  ⨆ (n : ℕ) (v : Fin n → wcGcSjRelSec j ν e)
    (_ : ∀ c : Fin n → κ, (∀ a : Fin (N + 1),
        ∑ i, wcEszScal (ν ≫ j) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) (c i) * (v i).1 a ∈
          Set.range (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl)) →
        ∀ i, c i = 0), (n : ℕ∞)
def wcEbNg {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g : ↥W) : Type u :=
  MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}

noncomputable instance wcEbNg.instCommRing {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (g : ↥W) : CommRing (wcEbNg W g) :=
  Ideal.Quotient.commRing _

noncomputable def wcEbNgC {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g : ↥W) :
    ↥W →+* wcEbNg W g :=
  (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp
    MvPolynomial.C

noncomputable def wcEbNgOrigin {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g : ↥W) :
    Ideal (wcEbNg W g) :=
  (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
    (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}))

def wcEbChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {D : Type u} [CommRing D]
    (w : ↥W →+* D) (𝔮 : Ideal D) [𝔮.IsPrime] : Prop :=
  ∃ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧
    ∃ (E : Type u) (_ : CommRing E) (ψ : wcEbNg W g →+* E), ψ.Etale ∧
      ∃ (𝔓 : Ideal E) (_ : 𝔓.IsPrime), 𝔓.comap ψ = wcEbNgOrigin W g ∧
        Function.Surjective ((Ideal.Quotient.mk 𝔓).comp ψ) ∧
        ∃ φ : Localization.AtPrime 𝔓 ≃+* Localization.AtPrime 𝔮,
          ∀ c : ↥W, φ (algebraMap E (Localization.AtPrime 𝔓) (ψ (wcEbNgC W g c))) =
            algebraMap D (Localization.AtPrime 𝔮) (w c)

def wcEbChartAll {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] (a : ↥W) : Prop :=
  letI : Algebra ↥(wcEbRing W a) L :=
    ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(wcEbRing W a) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)) = wcEbNode W a →
    wcEbChart W ((algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)).comp
      (wcEbW W a)) 𝔮
noncomputable abbrev wcNpI {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) :
    Ideal (MvPolynomial (Fin 2) ↥W) :=
  Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}

abbrev wcNpR0 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) : Type u :=
  MvPolynomial (Fin 2) ↥W ⧸ wcNpI W a
def wcpaDvFilt (V X : Type u) [CommRing V] [IsLocalRing V] [AddCommGroup X] [Module V X] : Prop :=
  ∃ (n : ℕ) (N : ℕ → Submodule V X), N 0 = ⊥ ∧ N n = ⊤ ∧ ∀ k < n, N k ≤ N (k + 1) ∧ ∃ (C : Type u) (_ : CommRing C) (_ : Algebra V C), Algebra.Smooth V C ∧ Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≠ ⊤ ∧ (∀ (L : Type u) [Field L] [Algebra V L], IsDomain (TensorProduct V L C) ∨ Subsingleton (TensorProduct V L C)) ∧ ∃ (r : ℕ) (α : (Fin r → C) →ₗ[V] (X ⧸ N k)), LinearMap.range α = (N (k + 1)).map (N k).mkQ ∧ ∀ u : Fin r → C, α u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (X ⧸ N k)) → u ∈ (IsLocalRing.maximalIdeal V) • (⊤ : Submodule V (Fin r → C))


def wcpaDvConc (V : Type u) [CommRing V] [IsLocalRing V] (R : Type u) [CommRing R] [Algebra V R]
    (M : Type u) [AddCommGroup M] [Module R M] [Module V M] [IsScalarTower V R M] (𝔭 : Ideal R) :
    Prop :=
  ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra V R') (_ : IsScalarTower V R R'),
    Algebra.Etale R R' ∧ ∃ 𝔭' : Ideal R', 𝔭'.IsPrime ∧ 𝔭'.comap (algebraMap R R') = 𝔭 ∧
      (∀ b : R', ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R R' s * b - algebraMap R R' a ∈ 𝔭') ∧
      ∀ f : R', f ∉ 𝔭' → ∃ g : R', g ∉ 𝔭' ∧ f ∣ g ∧
        ∀ (X : Type u) [AddCommGroup X] [Module V X],
          Nonempty (TensorProduct R (Localization.Away g) M ≃ₗ[V] X) → wcpaDvFilt V X
noncomputable def wcGcfMk (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)) (e : ℕ)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) :
    HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      (MvPolynomial.X a) :=
  HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ _)) e F.1
    (by simpa using F.2)

noncomputable def wcGcfPush {R K : Type u} [CommRing R] [CommRing K] (φ : R →+* K) (N e : ℕ)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) :
    MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e :=
  ⟨MvPolynomial.map φ F.1, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
    (((MvPolynomial.mem_homogeneousSubmodule _ _).mp F.2).map φ)⟩

noncomputable def wcGcfXMul {R : Type u} [CommRing R] {N : ℕ} (a : Fin (N + 1)) (M : ℕ) {t : ℕ}
    (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R t) :
    MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R (t + M) :=
  ⟨G.1 * MvPolynomial.X a ^ M, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
    (((MvPolynomial.mem_homogeneousSubmodule _ _).mp G.2).mul (MvPolynomial.isHomogeneous_X_pow a M))⟩

def wcGcfKer {R : Type u} [CommRing R] {N : ℕ} {B : Fin (N + 1) → CommRingCat.{u}}
    (ψ : ∀ a : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X a) →+* B a) (e : ℕ) :
    Set (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) :=
  {F | ∀ a, ψ a (wcGcfMk R N a e F) = 0}

noncomputable def wcGcfPsi {R : Type u} [CommRing R] {N : ℕ} {Y : Scheme.{u}}
    (j : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      MvPolynomial.gradedAlgebra) (a : Fin (N + 1)) :
    HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      (MvPolynomial.X a) →+*
      Γ(Y, j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        (MvPolynomial.X a)) :=
  (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X a) ≫
    j.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      (MvPolynomial.X a))).hom

noncomputable def wcGcfStr {R : Type u} [CommRing R] {Y : Scheme.{u}} (q : Y ⟶ Spec (.of R))
    (V : Y.Opens) : R →+* Γ(Y, V) :=
  ((Scheme.ΓSpecIso (.of R)).inv ≫ q.appLE ⊤ V (by simp)).hom
def wcLlsBrSet {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
    (𝔭 : Ideal A) (z : A) : Set ↥W :=
  {c | c ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
    z - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧ wcLlsRam A K L Q}

def wcLlsBrSub {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (A' : Type u) [CommRing A']
    [Algebra ↥W A'] [Algebra A' K] (s : K) (Z : Set K) : Prop :=
  (∀ w : ↥W, algebraMap A' K (algebraMap ↥W A' w) = algebraMap A K (algebraMap ↥W A w)) ∧
  ((Algebra.adjoin A {s} : Subalgebra A K) : Set K) ⊆ Set.range (algebraMap A' K) ∧
  ∀ x ∈ Set.range (algebraMap A' K), ∃ p q : ↥(Algebra.adjoin A {s}),
    q ∉ Ideal.span (((↑) : ↥(Algebra.adjoin A {s}) → K) ⁻¹'
      (Z ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
        (IsLocalRing.maximalIdeal ↥W : Set ↥W))) ∧
    x * (q : K) = p
def wcEbAnMonoData {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) (L : Type u) [Field L]
    [Algebra ↥(wcEbRing W a) L] (𝔮 : Ideal ↥(integralClosure ↥(wcEbRing W a) L)) [𝔮.IsPrime] :
    Prop :=
  ∃ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧
  ∃ ψ : wcEbNg W g →+* Localization.AtPrime 𝔮, Function.Injective ψ ∧
    (∀ c : ↥W, ψ (wcEbNgC W g c) = algebraMap ↥(integralClosure ↥(wcEbRing W a) L)
      (Localization.AtPrime 𝔮) (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)
        (wcEbW W a c))) ∧
    wcEbNgOrigin W g ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).comap ψ ∧
    ∃ (ζ : Localization.AtPrime 𝔮) (f : Polynomial (wcEbNg W g)), f.Monic ∧
      Polynomial.eval₂ ψ ζ f = 0 ∧
      (∀ p : Polynomial (wcEbNg W g), Polynomial.eval₂ ψ ζ p = 0 → f ∣ p) ∧
      (∀ z : Localization.AtPrime 𝔮, ∃ (p : Polynomial (wcEbNg W g)) (d : wcEbNg W g),
        d ≠ 0 ∧ ψ d * z = Polynomial.eval₂ ψ ζ p) ∧
      ∃ H : Polynomial (wcEbNg W g),
        IsUnit (Polynomial.eval₂ ψ ζ (Polynomial.derivative f * H)) ∧
        ∀ r : ↥(wcEbRing W a), ∃ (k : ℕ) (p : Polynomial (wcEbNg W g)),
          Polynomial.eval₂ ψ ζ (Polynomial.derivative f * H) ^ k *
            algebraMap ↥(integralClosure ↥(wcEbRing W a) L) (Localization.AtPrime 𝔮)
              (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L) r) =
          Polynomial.eval₂ ψ ζ p
noncomputable def wcLlsScS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c' r : ↥W) : K :=
  algebraMap A K (t - algebraMap ↥W A c') / algebraMap A K (algebraMap ↥W A r)

noncomputable def wcLlsScN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c' r : ↥W) :
    Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) :=
  Ideal.span {⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A))
def wcLlsInnerSmooth {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c b e : ↥W) : Prop :=
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) =
      Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) 𝔮) = 0
def wcEbAnInOc {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c : Ω) (f : RatFunc Ω) : Prop :=
  ∃ (p q : Polynomial Ω) (i : ℕ), q.coeff i * c ^ i ≠ 0 ∧
    f * algebraMap (Polynomial Ω) (RatFunc Ω) q = algebraMap (Polynomial Ω) (RatFunc Ω) p ∧
    (∀ j, q.coeff j * c ^ j / (q.coeff i * c ^ i) ∈ W) ∧
    (∀ j, p.coeff j * c ^ j / (q.coeff i * c ^ i) ∈ W)

def wcEbAnInU {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (f : RatFunc Ω) : Prop :=
  ∃ c₀ : Ω, c₀ ≠ 0 ∧ W.valuation c₀ < 1 ∧
    ∀ c : Ω, c ≠ 0 → W.valuation c < 1 → c₀ / c ∈ W → wcEbAnInOc W c f

def wcEbAnGaussStr {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] : Prop :=
  Module.Free ↥(wcEbGauss W) ↥(integralClosure ↥(wcEbGauss W) L) ∧
  Module.finrank ↥(wcEbGauss W) ↥(integralClosure ↥(wcEbGauss W) L) =
    Module.finrank (RatFunc Ω) L ∧
  (∀ V' : ValuationSubring L, (V'.comap (algebraMap (RatFunc Ω) L)).toSubring = wcEbGauss W →
    ∀ s : L, s ≠ 0 → ∃ c : Ω, c ≠ 0 ∧
      V'.valuation (s / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) = 1) ∧
  (∀ b : ↥(integralClosure ↥(wcEbGauss W) L),
    (∀ M : Ideal ↥(integralClosure ↥(wcEbGauss W) L), M.IsMaximal → b ∈ M) →
    ∃ c : Ω, c ≠ 0 ∧ W.valuation c < 1 ∧
      (b : L) / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c) ∈
        integralClosure ↥(wcEbGauss W) L)

def wcEbAnBranchData {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] : Prop :=
  ∃ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    Function.Injective U ∧
    (∀ U' : ValuationSubring L,
      (∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ U' ↔ wcEbAnInU W f) ↔ ∃ b, U b = U') ∧
    (∀ b, 1 ≤ e b) ∧ ∑ b, e b = Module.finrank (RatFunc Ω) L ∧
    (∀ b, algebraMap (RatFunc Ω) L RatFunc.X = η b ^ e b * u b) ∧
    (∀ b, (U b).valuation (u b - 1) < 1) ∧
    (∀ b b', b ≠ b' → (U b').valuation (η b) = 1) ∧
    (∀ b, ∀ V' : ValuationSubring L,
      (V'.comap (algebraMap (RatFunc Ω) L)).toSubring = wcEbGauss W →
      V'.valuation (η b) = 1 ∧ V'.valuation (u b) = 1) ∧
    (∀ b, ∀ s : L, s ≠ 0 → ∃ (c : Ω) (k : ℤ), c ≠ 0 ∧
      (U b).valuation (s / (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c) * η b ^ k)) = 1)
noncomputable def wcNlbConst {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (h : C ⟶ X) (uX : X ⟶ Spec (.of ↥W)) (c : ↥W) :
    C.functionField :=
  (C.presheaf.germ ⊤ (genericPoint ↥C) trivial).hom
    ((h ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c))

def wcNlbWDom {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (h : C ⟶ X) (uX : X ⟶ Spec (.of ↥W))
    (A : ValuationSubring C.functionField) : Prop :=
  ∀ c : ↥W, A.valuation (wcNlbConst W h uX c) ≤ 1 ∧
    (c ∈ IsLocalRing.maximalIdeal ↥W → A.valuation (wcNlbConst W h uX c) < 1)

def wcNlbQ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (h : C ⟶ X) (uX : X ⟶ Spec (.of ↥W)) (x : ↥X)
    (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (A : ValuationSubring C.functionField) : Prop :=
  ∀ (V : X.Opens), IsAffineOpen V → x ∈ V →
    ∀ (hV : genericPoint ↥C ∈ h ⁻¹ᵁ V) (e : ⊤ ≤ σ ⁻¹ᵁ V) (f : Γ(X, V)),
      A.valuation ((C.presheaf.germ (h ⁻¹ᵁ V) (genericPoint ↥C) hV).hom ((h.app V).hom f) -
        wcNlbConst W h uX ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom f))) <
      A.valuation (wcNlbConst W h uX a)
def wcGcSkTriv {Z Zt : Scheme.{u}} (ν : Zt ⟶ Z) (V : Z.Opens) (b : Γ(Zt, ν ⁻¹ᵁ V)) (z : Z) :
    Prop :=
  ∃ (W : Z.Opens) (h : W ≤ V), z ∈ W ∧ ∃ g : Γ(Z, W),
    Zt.presheaf.map (homOfLE (ν.preimage_mono h)).op b = ν.app W g

noncomputable def wcGcSkLocRk {κ : Type u} [Field κ] {N : ℕ} {Z Zt : Scheme.{u}}
    (j : Z ⟶ wcProjK κ N) (ν : Zt ⟶ Z) (a : Fin (N + 1)) (z : Z) : ℕ∞ :=
  ⨆ (n : ℕ) (v : Fin n → Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a))
    (_ : ∀ c : Fin n → κ, wcGcSkTriv ν (j ⁻¹ᵁ wcSgD κ N a)
        (∑ i, wcEszScal (ν ≫ j) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) (c i) * v i) z → ∀ i, c i = 0),
    (n : ℕ∞)
noncomputable def wcLlsRsiS1 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c a : ↥W) : K :=
  algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A a)

noncomputable def wcLlsRsiS2 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c b : ↥W) : K :=
  algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)

def wcLlsRsiSep2 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c a b : ↥W) : Prop :=
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsRsiS1 W A K t c a, wcLlsRsiS2 W A K t c b}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsRsiS1 W A K t c a, wcLlsRsiS2 W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A
          {wcLlsRsiS1 W A K t c a, wcLlsRsiS2 W A K t c b}) L)) =
      Ideal.span {⟨wcLlsRsiS1 W A K t c a,
          Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
        ⟨wcLlsRsiS2 W A K t c b,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A
          {wcLlsRsiS1 W A K t c a, wcLlsRsiS2 W A K t c b})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsRsiS1 W A K t c a, wcLlsRsiS2 W A K t c b}) 𝔮)
noncomputable def wcLlsScJ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) :
    Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) :=
  (Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) |
    ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}).radical

def wcLlsScConn {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) : Prop :=
  wcLlsScJ W A K L t c' b' ≠ ⊤ ∧
    ∀ e : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
      e * e - e ∈ wcLlsScJ W A K L t c' b' →
        e ∈ wcLlsScJ W A K L t c' b' ∨ e - 1 ∈ wcLlsScJ W A K L t c' b'

def wcLlsScDF {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) : Prop :=
  ∃ x : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
    (∀ z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
      ∃ p : Polynomial ↥W, z - Polynomial.eval₂
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})).comp (algebraMap ↥W A)))
        x p ∈ wcLlsScJ W A K L t c' b') ∧
    ∀ p : Polynomial ↥W, Polynomial.eval₂
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})).comp (algebraMap ↥W A)))
        x p ∈ wcLlsScJ W A K L t c' b' → ∀ i, p.coeff i ∈ IsLocalRing.maximalIdeal ↥W

noncomputable def wcLlsScV {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c' b' : ↥W) : K :=
  algebraMap A K (algebraMap ↥W A b') / algebraMap A K (t - algebraMap ↥W A c')

noncomputable def wcLlsScNV {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c' b' : ↥W) :
    Ideal ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) :=
  Ideal.span {algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c'),
      ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp (algebraMap ↥W A))
noncomputable def wcLlsIsiS1 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (a : ↥W) : K :=
  algebraMap A K u / algebraMap A K (algebraMap ↥W A a)

noncomputable def wcLlsIsiS2 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (b : ↥W) : K :=
  algebraMap A K (algebraMap ↥W A b) / algebraMap A K u

def wcLlsIsiSep2 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (a b : ↥W) : Prop :=
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u b}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u b})
        ↥(integralClosure ↥(Algebra.adjoin A
          {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u b}) L)) =
      Ideal.span {⟨wcLlsIsiS1 W A K u a,
          Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
        ⟨wcLlsIsiS2 W A K u b,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A
          {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u b})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u b}) 𝔮)
def wcEbMoBD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ)
    (η u : Fin m → L) : Prop :=
  Function.Injective U ∧
    (∀ U' : ValuationSubring L,
      (∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ U' ↔ wcEbAnInU W f) ↔ ∃ b, U b = U') ∧
    (∀ b, 1 ≤ e b) ∧ ∑ b, e b = Module.finrank (RatFunc Ω) L ∧
    (∀ b, algebraMap (RatFunc Ω) L RatFunc.X = η b ^ e b * u b) ∧
    (∀ b, (U b).valuation (u b - 1) < 1) ∧
    (∀ b b', b ≠ b' → (U b').valuation (η b) = 1) ∧
    (∀ b, ∀ V' : ValuationSubring L,
      (V'.comap (algebraMap (RatFunc Ω) L)).toSubring = wcEbGauss W →
      V'.valuation (η b) = 1 ∧ V'.valuation (u b) = 1) ∧
    (∀ b, ∀ s : L, s ≠ 0 → ∃ (c : Ω) (k : ℤ), c ≠ 0 ∧
      (U b).valuation (s / (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c) * η b ^ k)) = 1)
def wcLlsKPLoc (A : Type u) [CommRing A] (K : Type u) [Field K] [Algebra A K] (s : K) (d : A)
    (x : K) : Prop :=
  ∃ n : ℕ, algebraMap A K d ^ n * x ∈ Algebra.adjoin A {s}

def wcLlsKPMLoc {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (s : K) (d : A) (x : K) : Prop :=
  ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ x' : K, wcLlsKPLoc A K s d x' ∧
    x = algebraMap A K (algebraMap ↥W A π) * x'

def wcLlsKPInnerCore {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (p : ℕ) (𝔭 : Ideal A) (t : A) (c b : ↥W) (d : A) (w : L) (F : Polynomial K) (ε : ↥W)
    (G : Polynomial ↥W) (ω : ↥W) : Prop :=
  d ∉ 𝔭 ∧ ω ≠ 0 ∧ w ∉ Set.range (algebraMap K L) ∧
  F.Monic ∧ F.natDegree = p ∧ Polynomial.aeval w F = 0 ∧
  (∀ i, wcLlsKPLoc A K (wcLlsScS W A K t c b) d (F.coeff i)) ∧
  (∃ U V : Polynomial K, (∀ i, wcLlsKPLoc A K (wcLlsScS W A K t c b) d (U.coeff i)) ∧
    (∀ i, wcLlsKPLoc A K (wcLlsScS W A K t c b) d (V.coeff i)) ∧
    U * F + V * Polynomial.derivative F = Polynomial.C (algebraMap A K (algebraMap ↥W A ω))) ∧
  (∀ i, 2 ≤ i → i < p → wcLlsKPMLoc W A K (wcLlsScS W A K t c b) d (F.coeff i)) ∧
  wcLlsKPMLoc W A K (wcLlsScS W A K t c b) d (F.coeff 1 - algebraMap A K (algebraMap ↥W A ε)) ∧
  wcLlsKPMLoc W A K (wcLlsScS W A K t c b) d
    (F.coeff 0 + Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A))
      (wcLlsScS W A K t c b) G)

def wcLlsKPBoundaryCore {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (p : ℕ) (𝔭 : Ideal A) (t : A) (c b : ↥W) (d : A) (w₁ : L)
    (F₁ : Polynomial K) (m₀ : ℕ) (ω ζ : ↥W) : Prop :=
  d ∉ 𝔭 ∧ ω ≠ 0 ∧ w₁ ∉ Set.range (algebraMap K L) ∧
  F₁.Monic ∧ F₁.natDegree = p ∧ Polynomial.aeval w₁ F₁ = 0 ∧
  (∀ i, wcLlsKPLoc A K (wcLlsScV W A K t c b) d (F₁.coeff i)) ∧
  (∃ U V : Polynomial K, (∀ i, wcLlsKPLoc A K (wcLlsScV W A K t c b) d (U.coeff i)) ∧
    (∀ i, wcLlsKPLoc A K (wcLlsScV W A K t c b) d (V.coeff i)) ∧
    U * F₁ + V * Polynomial.derivative F₁ = Polynomial.C (algebraMap A K (algebraMap ↥W A ω))) ∧
  ζ ^ p = b ∧
  (∀ i, 1 ≤ i → i < p → ∃ x : K, wcLlsKPLoc A K (wcLlsScV W A K t c b) d x ∧
    F₁.coeff i = algebraMap A K (algebraMap ↥W A ζ) ^ (m₀ * (p - i)) * x) ∧
  ¬ p ∣ m₀ ∧ 1 ≤ m₀ ∧
  wcLlsKPLoc A K (wcLlsScV W A K t c b) d
    (-F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀) ∧
  ∃ x₁ x₂ x₃ : K, wcLlsKPMLoc W A K (wcLlsScV W A K t c b) d x₁ ∧
    wcLlsKPLoc A K (wcLlsScV W A K t c b) d x₂ ∧ wcLlsKPLoc A K (wcLlsScV W A K t c b) d x₃ ∧
    -F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀ - 1 =
      x₁ + algebraMap A K (t - algebraMap ↥W A c) * x₂ + wcLlsScV W A K t c b * x₃
def wcLlsCircOK {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {K L : Type u} [Field K]
    [Field L] [Algebra K L] (wK : ↥W →+* K) (d : K) (V : ValuationSubring L) : Prop :=
  ∀ c₁ e₁ : ↥W, e₁ ≠ 0 →
    (∀ p : Polynomial ↥W, (∃ i, IsUnit (p.coeff i)) →
      V.valuation (algebraMap K L (Polynomial.eval₂ wK ((d - wK c₁) / wK e₁) p)) = 1) →
    ∃ (s : L) (P : Polynomial ↥W), 0 < P.natDegree ∧ IsUnit P.leadingCoeff ∧
      V.valuation s = 1 ∧
      V.valuation (algebraMap K L ((d - wK c₁) / wK e₁) -
        Polynomial.eval₂ ((algebraMap K L).comp wK) s P) < 1 ∧
      (c₁ = 0 → ∀ i < P.natDegree, P.coeff i ∈ IsLocalRing.maximalIdeal ↥W) ∧
      ∀ z : L, V.valuation z = 1 → ∃ p q : Polynomial ↥W,
        V.valuation (Polynomial.eval₂ ((algebraMap K L).comp wK) s q) = 1 ∧
        V.valuation (z * Polynomial.eval₂ ((algebraMap K L).comp wK) s q -
          Polynomial.eval₂ ((algebraMap K L).comp wK) s p) < 1
noncomputable def wcLlsCasIota {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] (t : A) (c' b' : ↥W) :
    ↥(integralClosure A L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
  letI : IsScalarTower A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L :=
    IsScalarTower.of_algebraMap_eq (fun a => IsScalarTower.algebraMap_apply A K L a)
  ((integralClosure A L).val.toRingHom).codRestrict
    (integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
    (fun x => IsIntegral.tower_top (A := ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) x.2)

noncomputable abbrev wcLlsCasD (B : Type u) [CommRing B] (w : Ideal B) [w.IsPrime]
    (𝔷 : Ideal B) : Type u :=
  Localization.AtPrime w ⧸ Ideal.map (algebraMap B (Localization.AtPrime w)) 𝔷
noncomputable def wcEbBdResAlg (K : Type u) {L : Type u} [Field K] [Field L] [Algebra K L]
    (V' : ValuationSubring L) :
    IsLocalRing.ResidueField ↥(V'.comap (algebraMap K L)) →+* IsLocalRing.ResidueField ↥V' :=
  Ideal.quotientMap (IsLocalRing.maximalIdeal ↥V')
    ((algebraMap K L).restrict (V'.comap (algebraMap K L)) V' (fun _ hx => hx))
    (by
      have key : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
          A.valuation y < 1 ↔ (y = 0 ∨ y⁻¹ ∉ A) := by
        intro F _ A y
        by_cases hy : y = 0
        · simp [hy]
        · simp only [hy, false_or]
          rw [← A.valuation_le_one_iff, map_inv₀, not_le]
          have hv : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
          exact (one_lt_inv₀ (zero_lt_iff.mpr hv)).symm
      intro x hx
      rw [Ideal.mem_comap, ValuationSubring.valuation_lt_one_iff]
      rw [ValuationSubring.valuation_lt_one_iff] at hx
      show V'.valuation (algebraMap K L (x : K)) < 1
      rw [key]
      rw [key] at hx
      rcases hx with h | h
      · left
        rw [h, map_zero]
      · right
        intro h'
        apply h
        rw [ValuationSubring.mem_comap, map_inv₀]
        exact h')


noncomputable def wcEbBdResDeg (K : Type u) {L : Type u} [Field K] [Field L] [Algebra K L]
    (V' : ValuationSubring L) : ℕ :=
  letI : Algebra (IsLocalRing.ResidueField ↥(V'.comap (algebraMap K L)))
      (IsLocalRing.ResidueField ↥V') := (wcEbBdResAlg K V').toAlgebra
  Module.finrank (IsLocalRing.ResidueField ↥(V'.comap (algebraMap K L)))
    (IsLocalRing.ResidueField ↥V')
noncomputable def wcDrE (A : Type u) [CommRing A] {L : Type u} [Field L] [Algebra A L] (θ : L) :
    Polynomial A :=
  Polynomial.derivative (minpoly A θ) * Polynomial.divX (minpoly A θ)

abbrev wcDrK (K : Type u) [Field K] {L : Type u} [Field L] [Algebra K L] (θ : L) :
    IntermediateField K L :=
  IntermediateField.adjoin K {θ}

def wcDrTh (K : Type u) [Field K] {L : Type u} [Field L] [Algebra K L] (θ : L) :
    ↥(wcDrK K θ) :=
  ⟨θ, IntermediateField.mem_adjoin_simple_self K θ⟩

abbrev wcDrA (A : Type u) [CommRing A] (K : Type u) [Field K] [Algebra A K] {L : Type u}
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (θ : L) :
    Subalgebra A ↥(wcDrK K θ) :=
  Algebra.adjoin A {wcDrTh K θ, (Polynomial.aeval (wcDrTh K θ) (wcDrE A θ))⁻¹}

noncomputable def wcDrA.algW {Ω : Type u} [Field Ω] {W : ValuationSubring Ω}
    {A : Type u} [CommRing A] [Algebra ↥W A] {K : Type u} [Field K] [Algebra A K]
    {L : Type u} [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] {θ : L} :
    Algebra ↥W ↥(wcDrA A K θ) :=
  ((algebraMap A ↥(wcDrA A K θ)).comp (algebraMap ↥W A)).toAlgebra

def wcDrKind {Ω : Type u} [Field Ω] {W : ValuationSubring Ω} {A B : Type u} (φ : A → B) :
    wcLlsKind W A → wcLlsKind W B
  | .disc t => .disc (φ t)
  | .ann u v g => .ann (φ u) (φ v) g

def wcDrSepEl (A : Type u) [CommRing A] (K : Type u) [Field K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] (y : Ideal ↥(integralClosure A L)) (θ : L) : Prop :=
  (∃ hθ : IsIntegral A θ, (⟨θ, hθ⟩ : ↥(integralClosure A L)) ∈ y) ∧
  (∀ δ ∈ wcLlsDec A K L y, δ θ = θ) ∧
  (∀ σ : L ≃ₐ[K] L, σ θ ∈ Subtype.val '' (y : Set ↥(integralClosure A L)) →
    σ ∈ wcLlsDec A K L y) ∧
  Polynomial.aeval θ (wcDrE A θ) ∉ Subtype.val '' (y : Set ↥(integralClosure A L))
noncomputable def wcLlsFcJV {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) :
    Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
  (Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) |
    (∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))) ∨
    (z : L) = algebraMap K L (algebraMap A K (t - algebraMap ↥W A c'))}).radical

noncomputable def wcLlsFcJUV {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) :
    Ideal ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L) :=
  (Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L) |
    ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}).radical

noncomputable def wcLlsFcVel {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) :
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
  algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
    ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩

def wcLlsFcConnW {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) : Prop :=
  ∀ (e₁ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
    (e₂ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)),
    e₁ * e₁ - e₁ ∈ wcLlsScJ W A K L t c' b' → e₂ * e₂ - e₂ ∈ wcLlsFcJV W A K L t c' b' →
    (∃ z : ↥(integralClosure ↥(Algebra.adjoin A
        {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
      z ∈ wcLlsFcJUV W A K L t c' b' ∧ (z : L) = (e₁ : L) - (e₂ : L)) →
    (e₁ ∈ wcLlsScJ W A K L t c' b' ∧ e₂ ∈ wcLlsFcJV W A K L t c' b') ∨
      (e₁ - 1 ∈ wcLlsScJ W A K L t c' b' ∧ e₂ - 1 ∈ wcLlsFcJV W A K L t c' b')

def wcLlsFcFin {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) : Prop :=
  (wcLlsFcJV W A K L t c' b').minimalPrimes.Finite ∧
    ∀ P ∈ (wcLlsFcJV W A K L t c' b').minimalPrimes, wcLlsFcVel W A K L t c' b' ∉ P

def wcLlsFcUni {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c' b' : ↥W) : Prop :=
  ∀ w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L), w.IsPrime →
    wcLlsFcJV W A K L t c' b' ≤ w → wcLlsFcVel W A K L t c' b' ∈ w →
    ∃! P, P ∈ (wcLlsFcJV W A K L t c' b').minimalPrimes ∧ P ≤ w
abbrev wcLlsIsiCR {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (a : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u a}


def wcLlsIsiCirc {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (a : ↥W) : Prop :=
  ∃ (n : ℕ) (φ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a) L) ⧸
      (Ideal.span {c : ↥(integralClosure ↥(wcLlsIsiCR W A K u a) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}).radical ≃+*
      (Fin n → LaurentPolynomial (IsLocalRing.ResidueField ↥W))),
    ∀ (w : ↥W) (c : ↥(integralClosure ↥(wcLlsIsiCR W A K u a) L)),
      (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
      ∀ i, φ (Ideal.Quotient.mk _ c) i = LaurentPolynomial.C (IsLocalRing.residue ↥W w)
def wcLlsAsMidAnnSep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c β b : ↥W) : Prop :=
  let s₁ : K := algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)
  let s₂ : K := algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s₁, s₂}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {s₁, s₂}) ↥(integralClosure ↥(Algebra.adjoin A {s₁, s₂}) L)) =
      Ideal.span {⟨s₁, Algebra.subset_adjoin (by simp)⟩, ⟨s₂, Algebra.subset_adjoin (by simp)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s₁, s₂})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s₁, s₂}) 𝔮)
noncomputable def wcLlsInnerS₁ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (c₁ : ↥W) : K :=
  algebraMap A K u / algebraMap A K (algebraMap ↥W A c₁)

noncomputable def wcLlsInnerS₂ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (c₂ : ↥W) : K :=
  algebraMap A K (algebraMap ↥W A c₂) / algebraMap A K u

def wcLlsInnerSep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (c₁ c₂ : ↥W) : Prop :=
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A
        {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂}) L)) =
      Ideal.span {⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
        ⟨wcLlsInnerS₂ W A K u c₂,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂})).comp
          (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂}) 𝔮)
def wcLlsGaussEtale {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c b : ↥W) : Prop :=
  ∃ (𝔓 : Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c b}))
    (𝔔 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)),
    𝔓.IsPrime ∧
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) ≤ 𝔓 ∧
    𝔓 < Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A 0)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) ∧
    𝔔.IsPrime ∧
    𝔔.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) = 𝔓 ∧
    wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔓 𝔔 ∧
    ¬ wcLlsRam ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K L 𝔔
def wcLlsAnnMidSep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (β b : ↥W) : Prop :=
  let s₁ : K := algebraMap A K u / algebraMap A K (algebraMap ↥W A β)
  let s₂ : K := algebraMap A K (algebraMap ↥W A b) / algebraMap A K u
  ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s₁, s₂}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {s₁, s₂})
        ↥(integralClosure ↥(Algebra.adjoin A {s₁, s₂}) L)) =
      Ideal.span {⟨s₁, Algebra.subset_adjoin (by simp)⟩, ⟨s₂, Algebra.subset_adjoin (by simp)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s₁, s₂})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s₁, s₂}) 𝔮)
abbrev wcLlsASbS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (b : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K u}

def wcLlsASbN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (b : ↥W) :
    Ideal ↥(wcLlsASbS W A K u b) :=
  Ideal.span {algebraMap A ↥(wcLlsASbS W A K u b) u,
      ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
        Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(wcLlsASbS W A K u b)).comp (algebraMap ↥W A))
def wcLlsSmPre {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (B : Type u) [CommRing B] [Algebra ↥W B] [Algebra A B] (𝔮 : Ideal B)
    (t : A) (t' : B) (c b c₃ b₃ : ↥W) : Prop :=
  ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
    (b ∣ θ (algebraMap A B t) - c ↔ b₃ ∣ θ t' - c₃)

def wcLlsSmc {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (M : Type u) [Field M] [Algebra A M] (B : Type u) [CommRing B]
    [Algebra ↥W B] [Algebra A B] [Algebra B M] (𝔭 : Ideal A) (h : A) (𝔮 : Ideal B) (t' : B) :
    Prop :=
  h ∉ 𝔭 ∧
  (∀ x : M, x ∈ Set.range (algebraMap B M) ↔ ∃ k : ℕ, IsIntegral A (algebraMap A M h ^ k * x)) ∧
  wcLlsPD W B 𝔮 (.disc t') ∧ 𝔮.comap (algebraMap A B) = 𝔭 ∧
  ∀ 𝔮' : Ideal B, 𝔮'.IsPrime → 𝔮'.comap (algebraMap A B) = 𝔭 → 𝔮' = 𝔮
noncomputable def wcKpknFSel {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L]
    (y : Ideal ↥(integralClosure A L)) [y.IsPrime] (b : ↥(integralClosure A L)) :
    wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y :=
  Ideal.Quotient.mk _ (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) b)

abbrev wcKpknBrI {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (v : A) : Ideal (Localization.AtPrime 𝔭) :=
  ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭)) ⊔
    Ideal.span {algebraMap A (Localization.AtPrime 𝔭) v}
noncomputable def wcNsrEbRho (F : Scheme.{u}) {ζ w : F} (h : ζ ⤳ w) :
    F.presheaf.stalk w →+* F.residueField ζ :=
  (F.presheaf.stalkSpecializes h ≫ F.residue ζ).hom

def wcNsrEbDom (F : Scheme.{u}) {ζ w : F} (h : ζ ⤳ w)
    (V : ValuationSubring (F.residueField ζ)) : Prop :=
  ∀ s : F.presheaf.stalk w, ∃ hs : wcNsrEbRho F h s ∈ V,
    s ∈ IsLocalRing.maximalIdeal (F.presheaf.stalk w) →
      (⟨wcNsrEbRho F h s, hs⟩ : V) ∈ IsLocalRing.maximalIdeal V

def wcNsrEbSep (F : Scheme.{u}) {ζ ζ' w : F} (h : ζ ⤳ w) (h' : ζ' ⤳ w)
    (V : ValuationSubring (F.residueField ζ)) (V' : ValuationSubring (F.residueField ζ')) :
    Prop :=
  ζ ≠ ζ' ∨ ∃ r s : F.presheaf.stalk w, wcNsrEbRho F h s ≠ 0 ∧ wcNsrEbRho F h' s ≠ 0 ∧
    ¬ (V.valuation (wcNsrEbRho F h r / wcNsrEbRho F h s) < 1 ↔
      V'.valuation (wcNsrEbRho F h' r / wcNsrEbRho F h' s) < 1)
abbrev wcLlsASmS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (β b : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A β),
    algebraMap A K (algebraMap ↥W A b) / algebraMap A K u}

def wcLlsASmN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (β b : ↥W) :
    Ideal ↥(wcLlsASmS W A K u β b) :=
  Ideal.span {⟨algebraMap A K u / algebraMap A K (algebraMap ↥W A β), Algebra.subset_adjoin (by simp)⟩,
      ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u, Algebra.subset_adjoin (by simp)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(wcLlsASmS W A K u β b)).comp (algebraMap ↥W A))
abbrev wcIsicgB {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (a : ↥W) : Subalgebra ↥(wcLlsIsiCR W A K u a) L :=
  integralClosure ↥(wcLlsIsiCR W A K u a) L

abbrev wcIsicgIB {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (a : ↥W) : Ideal ↥(wcIsicgB W A K L u a) :=
  Ideal.span {c : ↥(wcIsicgB W A K L u a) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
    (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}

abbrev wcIsicgC1 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (b : ↥W) : Subalgebra ↥(wcLlsASbS W A K u b) L :=
  integralClosure ↥(wcLlsASbS W A K u b) L

abbrev wcIsicgSig {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (b : ↥W) (Q : Ideal ↥(wcIsicgC1 W A K L u b)) [Q.IsPrime] :
    ↥W →+* Localization.AtPrime Q :=
  (algebraMap ↥(wcIsicgC1 W A K L u b) (Localization.AtPrime Q)).comp
    ((algebraMap ↥(wcLlsASbS W A K u b) ↥(wcIsicgC1 W A K L u b)).comp
      ((algebraMap A ↥(wcLlsASbS W A K u b)).comp (algebraMap ↥W A)))

abbrev wcIsicgU {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (u : A) (b : ↥W) (Q : Ideal ↥(wcIsicgC1 W A K L u b)) [Q.IsPrime] :
    Localization.AtPrime Q :=
  algebraMap ↥(wcIsicgC1 W A K L u b) (Localization.AtPrime Q)
    (algebraMap ↥(wcLlsASbS W A K u b) ↥(wcIsicgC1 W A K L u b)
      (algebraMap A ↥(wcLlsASbS W A K u b) u))

abbrev wcIsicgFib {R B : Type u} [CommRing R] [CommRing B] (ι : R →+* B) (I : Ideal B)
    (Q : Ideal R) [Q.IsPrime] : Type u :=
  Localization (Q.primeCompl.map ι) ⧸
    (I.map (algebraMap B (Localization (Q.primeCompl.map ι)))).radical

noncomputable abbrev wcIsicgFibMk {R B : Type u} [CommRing R] [CommRing B] (ι : R →+* B)
    (I : Ideal B) (Q : Ideal R) [Q.IsPrime] : B →+* wcIsicgFib ι I Q :=
  (Ideal.Quotient.mk _).comp (algebraMap B (Localization (Q.primeCompl.map ι)))
def wcTcBox {Ω : Type u} [Field Ω] {C N : Scheme.{u}} [AlgebraicGeometry.IsIntegral C]
    (sC : C ⟶ Spec (.of Ω)) (t : C ⟶ N) (p : N) (f : Fin 2 → N.presheaf.stalk p) (c : Ω)
    (V : ValuationSubring C.functionField) : Prop :=
  ∃ h : t (genericPoint C) ⤳ p, ∀ i : Fin 2,
    V.valuation ((wcLr1uGerm t p h).hom (f i)) ≤ V.valuation (wcLr1uConst sC c)

def wcTcRad {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {N : Scheme.{u}}
    (uN : N ⟶ Spec (.of ↥W)) (p : N) (f : Fin 2 → N.presheaf.stalk p) : Prop :=
  (∀ i, f i ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk p)) ∧
  ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ g ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk p), ∃ k : ℕ,
      g ^ k ∈ Ideal.span {f 0, f 1,
        ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uN.appTop ≫ N.presheaf.germ ⊤ p trivial).hom c}

def wcTcSep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (sC : C ⟶ Spec (.of Ω))
    (D S₁ S₂ : ValuationSubring C.functionField → Prop) : Prop :=
  ∃ d : ↥W, d ≠ 0 ∧ d ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ e : C.functionField,
    ∀ V : ValuationSubring C.functionField, D V → e ∈ V ∧
      (S₁ V → V.valuation (e - 1) ≤ V.valuation (wcLr1uConst sC (d : Ω))) ∧
      (S₂ V → V.valuation e ≤ V.valuation (wcLr1uConst sC (d : Ω)))
def wcLlsKPNewton {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (p : ℕ) (𝔭 : Ideal A) (t : A) (f₁ : K)
    (c b ζ γ₁ : ↥W) (d : A) (h g : Polynomial ↥W) (M m₀ : ℕ) : Prop :=
  d ∉ 𝔭 ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧
  ζ ^ p = b ∧ γ₁ ≠ 0 ∧
  IsUnit (h.coeff 0) ∧ g.coeff 0 = 0 ∧ g.coeff m₀ = 1 ∧ g.natDegree < M ∧ m₀ < M ∧
  1 ≤ m₀ ∧ ¬ p ∣ m₀ ∧
  (∀ j, j < m₀ → b ^ (m₀ - j) ∣ g.coeff j) ∧
  wcLlsKPLoc A K 0 d f₁ ∧ wcLlsKPLoc A K 0 d f₁⁻¹ ∧
  (∃ y : K, wcLlsKPLoc A K 0 d y ∧
    f₁ - (h.eval₂ ((algebraMap A K).comp (algebraMap ↥W A))
        (algebraMap A K (t - algebraMap ↥W A c))) ^ p =
      algebraMap A K (algebraMap ↥W A γ₁) ^ p *
        (g.eval₂ ((algebraMap A K).comp (algebraMap ↥W A))
            (algebraMap A K (t - algebraMap ↥W A c)) +
          algebraMap A K (t - algebraMap ↥W A c) ^ M * y)) ∧
  ∃ ε₀ : ↥W, ((p : ℕ) : ↥W) = (γ₁ * ζ ^ m₀) ^ (p - 1) * ε₀ ∧
    (IsUnit ε₀ ∨
      (ε₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ k : ℕ, 2 ≤ k ∧ k < m₀ ∧ ¬ p ∣ k ∧
        (∃ e : ↥W, IsUnit e ∧ g.coeff k = b ^ (m₀ - k) * e) ∧
        ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ g.coeff 1 = b ^ (m₀ - 1) * π))
abbrev wcLlsASdmS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c β b : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β),
    algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}

def wcLlsASdmN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c β b : ↥W) :
    Ideal ↥(wcLlsASdmS W A K t c β b) :=
  Ideal.span {⟨algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β),
        Algebra.subset_adjoin (by simp)⟩,
      ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
        Algebra.subset_adjoin (by simp)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(wcLlsASdmS W A K t c β b)).comp (algebraMap ↥W A))
abbrev wcLlsInnerCR {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (c₁ c₂ : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂}

def wcLlsInnerCN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (c₁ c₂ : ↥W) :
    Ideal ↥(wcLlsInnerCR W A K u c₁ c₂) :=
  Ideal.span {⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
      ⟨wcLlsInnerS₂ W A K u c₂,
        Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)).comp (algebraMap ↥W A))
abbrev wcIcxRI {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (a b : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {wcLlsIsiS1 W A K u a, wcLlsIsiS2 W A K u b}

def wcIcxNI {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (a b : ↥W) :
    Ideal ↥(wcIcxRI W A K u a b) :=
  Ideal.span {⟨wcLlsIsiS1 W A K u a, Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
      ⟨wcLlsIsiS2 W A K u b,
        Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(wcIcxRI W A K u a b)).comp (algebraMap ↥W A))

noncomputable def wcIcxIncl {A : Type u} [CommRing A] {K : Type u} [Field K] [Algebra A K]
    (L : Type u) [Field L] [Algebra K L] (S T : Subalgebra A K) (h : S ≤ T) :
    ↥(integralClosure ↥S L) →+* ↥(integralClosure ↥T L) :=
  ((integralClosure ↥S L).val.toRingHom).codRestrict (integralClosure ↥T L)
    (fun x => _root_.IsIntegral.map_of_comp_eq (Subalgebra.inclusion h).toRingHom
      (RingHom.id L) (RingHom.ext fun _ => rfl) x.2)
noncomputable def wcpaBnFac {S : Type*} [CommRing S] (r e : ℕ) (B : Finset (Fin r →₀ ℕ))
    (a : Fin e → B → S) : Polynomial (MvPolynomial (Fin r) S) :=
  Polynomial.X ^ e + ∑ k : Fin e,
    Polynomial.C (∑ m : B, MvPolynomial.monomial (m : Fin r →₀ ℕ) (a k m)) * Polynomial.X ^ (k : ℕ)
def wcEbEpD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] (g : Ω) (η : L) : Subring L :=
  Subring.closure (Set.range (fun w : ↥W =>
      algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (w : Ω))) ∪
    {η, algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) g) / η})
noncomputable def wcEbCiAbPsi {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ρ : Ω) :
    RatFunc Ω :=
  if W.valuation ρ < 1 then 1 - algebraMap Ω (RatFunc Ω) ρ * RatFunc.X⁻¹
  else 1 - algebraMap Ω (RatFunc Ω) ρ⁻¹ * RatFunc.X
noncomputable def wcObiImg {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {L : Type u} [Field L]
    (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (z : R) : wcLlsFS W wL R 𝔮 :=
  Ideal.Quotient.mk
    ((Ideal.span {b : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
      (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)))
    (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)
      (algebraMap R ↥(integralClosure R L) z))
def wcRcsRad {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (b e : ↥W) : Prop :=
  e ∈ IsLocalRing.maximalIdeal ↥W ∧ e ≠ 0 ∧ ∃ q ∈ IsLocalRing.maximalIdeal ↥W, b = e * q

def wcRcsCentL {R L : Type u} [CommRing R] [Field L] [Algebra R L]
    (Q : Ideal ↥(integralClosure R L)) (V : ValuationSubring L) : Prop :=
  (∀ x : ↥(integralClosure R L), (x : L) ∈ V) ∧
    ∀ x : ↥(integralClosure R L), (x ∈ Q ↔ V.valuation (x : L) < 1)

def wcRcsGauss {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {K L : Type u} [Field K]
    [Field L] [Algebra K L] (wK : ↥W →+* K) (d : K) (e : ↥W) (V : ValuationSubring L) : Prop :=
  ∀ p : Polynomial ↥W, (∃ i, IsUnit (p.coeff i)) →
    V.valuation (algebraMap K L (Polynomial.eval₂ wK (d / wK e) p)) = 1

def wcRcsDom (Q₁ : Type u) [CommRing Q₁] [IsDomain Q₁]
    (𝒱 : ValuationSubring (FractionRing Q₁)) : Prop :=
  (∀ q : Q₁, algebraMap Q₁ (FractionRing Q₁) q ∈ 𝒱) ∧
    ∀ q : Q₁, (¬ IsUnit q ↔ 𝒱.valuation (algebraMap Q₁ (FractionRing Q₁) q) < 1)

def wcRcsGaussQ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (Q₁ : Type u) [CommRing Q₁]
    [IsDomain Q₁] (σ : ↥W →+* Q₁) (D : Q₁) (e : ↥W)
    (𝒱 : ValuationSubring (FractionRing Q₁)) : Prop :=
  wcRcsDom Q₁ 𝒱 ∧
    wcRcsGauss W ((algebraMap Q₁ (FractionRing Q₁)).comp σ) (algebraMap Q₁ (FractionRing Q₁) D) e 𝒱

def wcRcsSkel {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (Q₁ : Type u) [CommRing Q₁]
    [IsDomain Q₁] (σ : ↥W →+* Q₁) (D : Q₁) (b : ↥W) : Prop :=
  (∀ e : ↥W, wcRcsRad W b e → ∃ 𝒱, wcRcsGaussQ W Q₁ σ D e 𝒱) ∧
    (∀ e : ↥W, wcRcsRad W b e → ∀ 𝒱 𝒱', wcRcsGaussQ W Q₁ σ D e 𝒱 →
      wcRcsGaussQ W Q₁ σ D e 𝒱' → 𝒱 = 𝒱')

def wcRcsCircQ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (Q₁ : Type u) [CommRing Q₁]
    [IsDomain Q₁] (σ : ↥W →+* Q₁) (D : Q₁) : Prop :=
  ∀ 𝒱 : ValuationSubring (FractionRing Q₁), wcRcsDom Q₁ 𝒱 →
    wcLlsCircOK W ((algebraMap Q₁ (FractionRing Q₁)).comp σ) (algebraMap Q₁ (FractionRing Q₁) D) 𝒱

def wcRcsFinPres {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (Q₁ : Type u) [CommRing Q₁]
    (σ : ↥W →+* Q₁) (D S : Q₁) (b : ↥W) : Prop :=
  ∃ (P₁ : Type u) (_ : CommRing P₁) (σ₁ : ↥W →+* P₁) (f₁ : wcEbntN W b →+* P₁) (j : P₁ →+* Q₁),
    wcEbntPres W σ₁ b f₁ ∧ IsLocalHom j ∧ Function.Injective j ∧ j.Finite ∧
    j.comp σ₁ = σ ∧ j (f₁ (wcEbntX W b 0)) = D ∧ j (f₁ (wcEbntX W b 1)) = S

def wcRcsCoord {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (Q₁ : Type u) [CommRing Q₁]
    [IsDomain Q₁] (σ : ↥W →+* Q₁) (D S : Q₁) (b g ω : ↥W) (z z' η : Q₁) (n : ℕ) : Prop :=
  g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧ IsUnit ω ∧ 1 ≤ n ∧ g ^ n = ω * b ∧
    ¬ IsUnit z ∧ ¬ IsUnit z' ∧ z * z' = σ g ∧ IsUnit η ∧ D = η * z ^ n ∧
    σ ω * S * η = z' ^ n ∧
    ∀ e : ↥W, wcRcsRad W b e → ∀ 𝒱 : ValuationSubring (FractionRing Q₁),
      wcRcsGaussQ W Q₁ σ D e 𝒱 → ∀ μ : ↥W, μ ≠ 0 →
      𝒱.valuation (algebraMap Q₁ (FractionRing Q₁) z) =
        𝒱.valuation (algebraMap Q₁ (FractionRing Q₁) (σ μ)) →
      ∀ y : FractionRing Q₁, 𝒱.valuation y = 1 → ∃ p q : Polynomial ↥W,
        𝒱.valuation (Polynomial.eval₂ ((algebraMap Q₁ (FractionRing Q₁)).comp σ)
          (algebraMap Q₁ (FractionRing Q₁) z / algebraMap Q₁ (FractionRing Q₁) (σ μ)) q) = 1 ∧
        𝒱.valuation (y * Polynomial.eval₂ ((algebraMap Q₁ (FractionRing Q₁)).comp σ)
            (algebraMap Q₁ (FractionRing Q₁) z / algebraMap Q₁ (FractionRing Q₁) (σ μ)) q -
          Polynomial.eval₂ ((algebraMap Q₁ (FractionRing Q₁)).comp σ)
            (algebraMap Q₁ (FractionRing Q₁) z / algebraMap Q₁ (FractionRing Q₁) (σ μ)) p) < 1
abbrev wcRsogS {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c b : ↥W) : K :=
  algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)

abbrev wcRsogR {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c b : ↥W) : Subalgebra A K :=
  Algebra.adjoin A {wcRsogS W A K t c b}

abbrev wcRsogC {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c b : ↥W) : Subalgebra ↥(wcRsogR W A K t c b) L :=
  integralClosure ↥(wcRsogR W A K t c b) L

abbrev wcRsogN {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c b : ↥W) :
    Ideal ↥(wcRsogR W A K t c b) :=
  Ideal.span {algebraMap A ↥(wcRsogR W A K t c b) (t - algebraMap ↥W A c),
      ⟨wcRsogS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
    (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(wcRsogR W A K t c b)).comp (algebraMap ↥W A))

abbrev wcRsogSig {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    (t : A) (c b : ↥W) (Q : Ideal ↥(wcRsogC W A K L t c b)) [Q.IsPrime] :
    ↥W →+* Localization.AtPrime Q :=
  (algebraMap ↥(wcRsogC W A K L t c b) (Localization.AtPrime Q)).comp
    ((algebraMap ↥(wcRsogR W A K t c b) ↥(wcRsogC W A K L t c b)).comp
      ((algebraMap A ↥(wcRsogR W A K t c b)).comp (algebraMap ↥W A)))
noncomputable def wcLlsKPbdsI (T : Type u) [CommRing T] (u s ζ U : T) (x : ℕ → T)
    (p α β m₀ : ℕ) : Ideal (MvPolynomial (Fin 4) T) :=
  Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ,
    MvPolynomial.X 2 * MvPolynomial.X 3 - 1,
    MvPolynomial.C u - MvPolynomial.X 0 ^ p * MvPolynomial.X 3 ^ α,
    MvPolynomial.C s - MvPolynomial.X 1 ^ p * MvPolynomial.X 2 ^ α,
    MvPolynomial.X 2 * (1 + ∑ i ∈ Finset.Ico 1 p, MvPolynomial.C (x i) *
      (MvPolynomial.X 1 ^ m₀ * MvPolynomial.X 2 ^ β) ^ (p - i)) - MvPolynomial.C U}

abbrev wcLlsKPbdsE (T : Type u) [CommRing T] (u s ζ U : T) (x : ℕ → T) (p α β m₀ : ℕ) :
    Type u :=
  MvPolynomial (Fin 4) T ⧸ wcLlsKPbdsI T u s ζ U x p α β m₀

noncomputable abbrev wcLlsKPbdsV (T : Type u) [CommRing T] (u s ζ U : T) (x : ℕ → T)
    (p α β m₀ : ℕ) (i : Fin 4) : wcLlsKPbdsE T u s ζ U x p α β m₀ :=
  Ideal.Quotient.mk _ (MvPolynomial.X i)

def wcLlsKPbdsNodeChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (E : Type u)
    [CommRing E] [Algebra ↥W E] (ζ : ↥W) (Z Z' : E) (𝔓 : Ideal E) : Prop :=
  ∃ (e : E) (f : wcEbntN W ζ →+* Localization.Away e), e ∉ 𝔓 ∧
    f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
      (algebraMap E (Localization.Away e)).comp (algebraMap ↥W E) ∧
    f (wcEbntX W ζ 0) = algebraMap E (Localization.Away e) Z ∧
    f (wcEbntX W ζ 1) = algebraMap E (Localization.Away e) Z' ∧
    RingHom.Etale (R := wcEbntN W ζ) (S := Localization.Away e) f ∧
    𝔓.map (algebraMap E (Localization.Away e)) =
      Ideal.span {algebraMap E (Localization.Away e) Z, algebraMap E (Localization.Away e) Z'} ⊔
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E)).map
          (algebraMap E (Localization.Away e))

abbrev wcLlsKPbdsFib {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (E : Type u) [CommRing E]
    [Algebra ↥W E] (P : Ideal E) [P.IsPrime] : Type u :=
  Localization.AtPrime P ⧸ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E)).map
    (algebraMap E (Localization.AtPrime P))

def wcLlsKPbdsElems {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L]
    [Algebra A L] (t : A) (c b ζ : ↥W) (w₁ : L) (F₁ : Polynomial K) (p m₀ α β : ℕ)
    (x : ℕ → K)
    (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
      algebraMap A K (t - algebraMap ↥W A c)}) L))
    (z z' μ ν : L) : Prop :=
  z * z' = algebraMap A L (algebraMap ↥W A ζ) ∧ μ * ν = 1 ∧
  algebraMap A L (t - algebraMap ↥W A c) = z ^ p * ν ^ α ∧
  algebraMap K L (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) =
    z' ^ p * μ ^ α ∧
  μ * (1 + ∑ i ∈ Finset.Ico 1 p, algebraMap K L (x i) * (z' ^ m₀ * μ ^ β) ^ (p - i)) =
    algebraMap K L (-F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀) ∧
  w₁ = z ^ m₀ * ν ^ β ∧
  (∃ a ∈ 𝔮, ∃ σ, σ ∉ 𝔮 ∧ (σ : L) * z = (a : L)) ∧
  (∃ a ∈ 𝔮, ∃ σ, σ ∉ 𝔮 ∧ (σ : L) * z' = (a : L)) ∧
  (∃ a σ, σ ∉ 𝔮 ∧ (σ : L) * μ = (a : L)) ∧
  (∃ a σ, σ ∉ 𝔮 ∧ (σ : L) * ν = (a : L)) ∧
  ∀ P : Polynomial ↥W, P ≠ 0 →
    Polynomial.eval₂ ((algebraMap A L).comp (algebraMap ↥W A)) z P ≠ 0
noncomputable abbrev wcFlSig {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c b : ↥W) :
    ↥W →+* ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) :=
  (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)).comp
    ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))

noncomputable abbrev wcFlIU {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c b : ↥W) :
    Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) :=
  Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) |
    ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}
noncomputable abbrev wcSdgJ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (s : K) : ↥W →+* ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
  (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
    ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))

noncomputable abbrev wcSdgPt (C : Type u) [CommRing C] (Q : Ideal C) [Q.IsPrime] :
    ↥(Spec (.of C)) :=
  (⟨Q, inferInstance⟩ : PrimeSpectrum C)
def wcHcFact {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (g : ↥W) (x : K)
    (w₁ w₂ : ↥W) (j : ℤ) (τ : ↥W) : Prop :=
  w₁ ≠ 0 ∧ w₂ ≠ 0 ∧ τ ∈ IsLocalRing.maximalIdeal ↥W ∧ τ ≠ 0 ∧ τ ∣ g ∧
  ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
    c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g → g ∣ τ * c₁ →
    ∃ d e : ↥(wcLlsInnerCR W A K u c₁ c₂), d ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
      e ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
      (d : K) * (algebraMap A K (algebraMap ↥W A w₂) * x) =
        algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K u ^ j * (e : K)

def wcHcASBD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ) (g w₁ w₂ : ↥W)
    (j : ℤ) : Prop :=
  (j < 0 ∧ ((ℓ : ℕ) : ↥W) ^ ℓ * w₂ ^ (ℓ - 1) * g ^ ((ℓ - 1) * (-j).toNat) ∣ w₁ ^ (ℓ - 1)) ∨
  (j = 0 ∧ ((ℓ : ℕ) : ↥W) ^ ℓ * w₂ ^ (ℓ - 1) ∣ w₁ ^ (ℓ - 1)) ∨
  (0 < j ∧ ∃ q ∈ IsLocalRing.maximalIdeal ↥W, q ≠ 0 ∧
    ((ℓ : ℕ) : ↥W) ^ ℓ * w₂ ^ (ℓ - 1) * q = w₁ ^ (ℓ - 1) * g ^ ((ℓ - 1) * j.toNat))

def wcHcINSBD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ) (g w₁ w₂ : ↥W)
    (j : ℤ) : Prop :=
  ¬ (ℓ : ℤ) ∣ j ∧
  (0 < j → w₁ ^ (ℓ - 1) * g ^ ((ℓ - 1) * j.toNat) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ * w₂ ^ (ℓ - 1)) ∧
  (j < 0 → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, q ≠ 0 ∧
    w₁ ^ (ℓ - 1) * q = ((ℓ : ℕ) : ↥W) ^ ℓ * w₂ ^ (ℓ - 1) * g ^ ((ℓ - 1) * (-j).toNat))
open Classical in
noncomputable def wcUrTau {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (V : X.Opens) (g : Γ(X, V)) (σ : Spec (.of ↥W) ⟶ X) : ↥W :=
  if e : ⊤ ≤ σ ⁻¹ᵁ V then (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom g) else 0

noncomputable def wcUrT {C X : Scheme.{u}} [AlgebraicGeometry.IsIntegral C] (h : C ⟶ X)
    (V : X.Opens) (g : Γ(X, V)) (hη : genericPoint ↥C ∈ h ⁻¹ᵁ V) : C.functionField :=
  (C.presheaf.germ (h ⁻¹ᵁ V) (genericPoint ↥C) hη).hom ((h.app V).hom g)

def wcUrChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (V : X.Opens) (g : Γ(X, V)) (hη : genericPoint ↥C ∈ (γ ≫ ι) ⁻¹ᵁ V)
    (hx : (γ ≫ ι) (genericPoint ↥C) ⤳ x) : Prop :=
  IsAffineOpen V ∧ ∃ hxV : x ∈ V,
    Function.Injective (wcLr1uGerm (γ ≫ ι) x hx).hom ∧
    (wcLr1uGerm (γ ≫ ι) x hx).hom ((X.presheaf.germ V x hxV).hom g) = wcUrT (γ ≫ ι) V g hη ∧
    (X.presheaf.germ V x hxV).hom g ∈ IsLocalRing.maximalIdeal ↥(X.presheaf.stalk x) ∧
    (∀ P : Polynomial Ω,
      P.eval₂ (wcLr1uConst (γ ≫ wcProjKStr Ω 1)) (wcUrT (γ ≫ ι) V g hη) = 0 → P = 0) ∧
    ∀ s : ↥(X.presheaf.stalk x), ∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧
      (s ∈ IsLocalRing.maximalIdeal ↥(X.presheaf.stalk x) →
        p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W) ∧
      (wcLr1uGerm (γ ≫ ι) x hx).hom s *
          q.eval₂ ((wcLr1uConst (γ ≫ wcProjKStr Ω 1)).comp W.subtype) (wcUrT (γ ≫ ι) V g hη) =
        p.eval₂ ((wcLr1uConst (γ ≫ wcProjKStr Ω 1)).comp W.subtype) (wcUrT (γ ≫ ι) V g hη)
noncomputable def wcLlsKPbdsSubst {S₀ N : Type u} [CommRing S₀] [CommRing N] (γ : S₀ →+* N)
    (a0 a1 : N) (n p α : ℕ) :
    MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀) →+* MvPolynomial (Fin n ⊕ Fin 2) N :=
  MvPolynomial.eval₂Hom
    (MvPolynomial.eval₂Hom (MvPolynomial.C.comp γ)
      ![MvPolynomial.C a0 ^ p * MvPolynomial.X (Sum.inr 1) ^ α,
        MvPolynomial.C a1 ^ p * MvPolynomial.X (Sum.inr 0) ^ α])
    (fun i => MvPolynomial.X (Sum.inl i))

noncomputable def wcLlsKPbdsEqs {S₀ N : Type u} [CommRing S₀] [CommRing N] (γ : S₀ →+* N)
    (a0 a1 : N) (n p α β m₀ : ℕ)
    (Rt : Fin n → MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀))
    (a : ℕ → MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀))
    (c : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)) :
    Fin n ⊕ Fin 2 → MvPolynomial (Fin n ⊕ Fin 2) N :=
  Sum.elim (fun j => wcLlsKPbdsSubst γ a0 a1 n p α (Rt j))
    ![MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1,
      MvPolynomial.X (Sum.inr 0) * (1 + ∑ i ∈ Finset.Ico 1 p, wcLlsKPbdsSubst γ a0 a1 n p α (a i) *
        (MvPolynomial.C a1 ^ m₀ * MvPolynomial.X (Sum.inr 0) ^ β) ^ (p - i)) -
        wcLlsKPbdsSubst γ a0 a1 n p α c]
abbrev wcHcgSF {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W) (x : K)
    (w₁ w₂ : ↥W) (j : ℤ) (τ : ↥W) : Prop :=
  w₁ ≠ 0 ∧ w₂ ≠ 0 ∧ τ ∈ IsLocalRing.maximalIdeal ↥W ∧ τ ≠ 0 ∧ τ ∣ g ∧
  ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → g ∣ τ * c₁ →
    ∃ (d e : ↥(wcLlsInnerCR W A K u c₁ c₂)) (a b : A), a ∉ 𝔭 ∧ b ∉ 𝔭 ∧
      d - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a ∈ wcLlsInnerCN W A K u c₁ c₂ ∧
      e - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) b ∈ wcLlsInnerCN W A K u c₁ c₂ ∧
      (d : K) * (algebraMap A K (algebraMap ↥W A w₂) * x) =
        algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K u ^ j * (e : K)

abbrev wcHcgE {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W)
    (x : K) : Prop :=
  ∃ (w₁ w₂ : ↥W) (j : ℤ) (τ : ↥W), wcHcgSF W A K 𝔭 u g x w₁ w₂ j τ
noncomputable abbrev wcLcTheta {R B : Type u} [CommRing R] [CommRing B] (ι : R →+* B)
    (Q : Ideal R) [Q.IsPrime] :
    Localization.AtPrime Q →+* Localization (Q.primeCompl.map ι) :=
  IsLocalization.map (Localization (Q.primeCompl.map ι)) ι (Submonoid.le_comap_map Q.primeCompl)

noncomputable abbrev wcLcT {P : Type u} [CommRing P] [IsDomain P] (x t : P) : FractionRing P :=
  algebraMap P (FractionRing P) x / algebraMap P (FractionRing P) t

noncomputable abbrev wcLcPT {P : Type u} [CommRing P] [IsDomain P] (x t : P) :
    Subalgebra P (FractionRing P) :=
  Algebra.adjoin P {wcLcT x t, (wcLcT x t)⁻¹}
abbrev wcIccWL {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L] :
    ↥W →+* L :=
  (algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))

abbrev wcIccM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {L : Type u} [Field L]
    (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L] : Ideal ↥(integralClosure R L) :=
  Ideal.span {c : ↥(integralClosure R L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (c : L) = wL w}

noncomputable abbrev wcIccYo {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (u : A) (a : ↥W) : ↥(integralClosure ↥(wcLlsASbS W A K u a) L) :=
  algebraMap ↥(wcLlsASbS W A K u a) ↥(integralClosure ↥(wcLlsASbS W A K u a) L)
    ⟨algebraMap A K (algebraMap ↥W A a) / algebraMap A K u,
      Algebra.subset_adjoin (Set.mem_singleton _)⟩

noncomputable abbrev wcIccUo {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (u : A) (a : ↥W) : ↥(integralClosure ↥(wcLlsASbS W A K u a) L) :=
  algebraMap ↥(wcLlsASbS W A K u a) ↥(integralClosure ↥(wcLlsASbS W A K u a) L)
    (algebraMap A ↥(wcLlsASbS W A K u a) u)

noncomputable abbrev wcIccXI {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (u : A) (a b : ↥W) : ↥(integralClosure ↥(wcIcxRI W A K u a b) L) :=
  algebraMap ↥(wcIcxRI W A K u a b) ↥(integralClosure ↥(wcIcxRI W A K u a b) L)
    ⟨wcLlsIsiS1 W A K u a, Algebra.subset_adjoin (Set.mem_insert _ _)⟩

noncomputable abbrev wcIccSI {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (u : A) (a b : ↥W) : ↥(integralClosure ↥(wcIcxRI W A K u a b) L) :=
  algebraMap ↥(wcIcxRI W A K u a b) ↥(integralClosure ↥(wcIcxRI W A K u a b) L)
    ⟨wcLlsIsiS2 W A K u b,
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩

noncomputable abbrev wcIccYC {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (u : A) (a : ↥W) : ↥(integralClosure ↥(wcLlsIsiCR W A K u a) L) :=
  algebraMap ↥(wcLlsIsiCR W A K u a) ↥(integralClosure ↥(wcLlsIsiCR W A K u a) L)
    ⟨wcLlsIsiS2 W A K u a,
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩

noncomputable abbrev wcIccCst {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (R : Subalgebra A K) (w : ↥W) : ↥(integralClosure ↥R L) :=
  ⟨wcIccWL W A K L w, _root_.isIntegral_algebraMap (R := ↥R) (A := L)
    (x := algebraMap A ↥R (algebraMap ↥W A w))⟩
def wcEgKp (Ω : Type u) [Field Ω] (L : Type u) [Field L] [Algebra (RatFunc Ω) L] (η : L) :
    Subfield L :=
  Subfield.closure (Set.range ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) ∪ {η})

def wcEgSim (Ω : Type u) [Field Ω] (L : Type u) [Field L] [Algebra (RatFunc Ω) L] (η : L)
    (V₁ V₂ : ValuationSubring L) : Prop :=
  ∀ p q : Polynomial Ω,
    Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) η q ≠ 0 →
    (Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) η p /
        Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) η q ∈ V₁ ↔
      Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) η p /
        Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) η q ∈ V₂)

def wcEgCond (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
    [Algebra (RatFunc Ω) L] (g : Ω) (η : L) (V : ValuationSubring L) : Prop :=
  (∀ w : ↥W, algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (w : Ω)) ∈ V) ∧
  (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
    V.valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (w : Ω))) < 1) ∧
  V.valuation η < 1 ∧
  V.valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) g) / η) < 1

noncomputable def wcEgChi (L : Type u) [Field L] (K : Subfield L) [FiniteDimensional ↥K L]
    (s : L) : Polynomial ↥K :=
  LinearMap.charpoly (Algebra.lmul ↥K L s)

noncomputable def wcEgP (n : ℕ) : Polynomial ℤ :=
  Polynomial.X * (Polynomial.X - 1) ^ (n - 1)
noncomputable def wcFrfP {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c ρ : ↥W)
    (X : List ↥W) : ↥W :=
  ((X.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _))).map
    (fun x => x - c)).prod *
    ρ ^ (X.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length

noncomputable def wcFrfM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c ρ : ↥W)
    (Z Y : List ↥W) : ℤ :=
  ((Z.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length : ℤ) -
    ((Y.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length : ℤ)

def wcFrfGood {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ) (c ρ k1 k2 : ↥W)
    (Z Y : List ↥W) : Prop :=
  k2 * wcFrfP W c ρ Y ∣ k1 * wcFrfP W c ρ Z ∨ ¬ (ℓ : ℤ) ∣ wcFrfM W c ρ Z Y

def wcFrfGen {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c ρ : ↥W) (X : List ↥W) : Prop :=
  ∀ z ∈ X, ¬ (ρ ∣ z - c ∧ z - c ∣ ρ)

def wcFrfREP {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A) (F : K)
    (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A) : Prop :=
  k1 ≠ 0 ∧ k2 ≠ 0 ∧ d ∉ 𝔭 ∧ e ∉ 𝔭 ∧
    (∀ z ∈ Z ++ Y, z ∈ IsLocalRing.maximalIdeal ↥W) ∧
    algebraMap A K d * algebraMap A K (algebraMap ↥W A k2) *
        (Y.map (fun y => algebraMap A K (t - algebraMap ↥W A y))).prod * F =
      algebraMap A K (algebraMap ↥W A k1) *
        (Z.map (fun z => algebraMap A K (t - algebraMap ↥W A z))).prod * algebraMap A K e

def wcFrfVAL {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A) (c : ↥W)
    (O : ↥W → ValuationSubring K) : Prop :=
  ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
    (∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
      wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e →
      algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F /
          algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) ∈ O ρ ∧
        algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) /
          (algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F) ∈ O ρ) ∧
    (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
      algebraMap A K (algebraMap ↥W A w₁) / algebraMap A K (algebraMap ↥W A w₂) ∈ O ρ →
      w₂ ∣ w₁) ∧
    (∀ a : A, algebraMap A K a ∈ O ρ)

def wcFrfMem {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A) (ℓ : ℕ) (f₀ : K)
    (c : ↥W) (I : ↥W → Prop) : Prop :=
  ∃ (H : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A),
    wcFrfREP W A K 𝔭 t (f₀ - (H ^ ℓ - H)) k1 k2 Z Y d e ∧
    ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → I ρ →
      wcFrfGen W c ρ (Z ++ Y) → wcFrfGood W ℓ c ρ k1 k2 Z Y

structure wcFrfData {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A) (ℓ : ℕ) (f₀ : K) :
    Type u where
  H : K
  k1 : ↥W
  k2 : ↥W
  Z : List ↥W
  Y : List ↥W
  d : A
  e : A
  rep : wcFrfREP W A K 𝔭 t (f₀ - (H ^ ℓ - H)) k1 k2 Z Y d e
noncomputable abbrev wcKmrBr {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u v : A) (b₀ : ↥W)
    (j : ℕ) (a : A) (p r g' : K) (w : ↥W) : K :=
  (algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀)) ^ j *
      (algebraMap A K a + algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀) * p) +
    algebraMap A K v * r + algebraMap A K (algebraMap ↥W A w) * g'


abbrev wcKmrUnit {A : Type u} [CommRing A] {K : Type u} [Field K] [Algebra A K]
    (𝔭 : Ideal A) (h : K) : Prop :=
  ∃ a' s' : A, a' ∉ 𝔭 ∧ s' ∉ 𝔭 ∧ h * algebraMap A K s' = algebraMap A K a'


abbrev wcKmrNF {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u v : A)
    (b₀ : ↥W) (F : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (a₀ a₁ : A)
    (p₀ p₁ r₀ r₁ g₀ g₁ :
      ↥(Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀)})) : Prop :=
  lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ a₀ ∉ 𝔭 ∧ a₁ ∉ 𝔭 ∧
    F * wcKmrBr W A K u v b₀ n a₁ (p₁ : K) (r₁ : K) (g₁ : K) w *
        algebraMap A K (algebraMap ↥W A lam₂) =
      algebraMap A K (algebraMap ↥W A lam₁) * wcKmrBr W A K u v b₀ k a₀ (p₀ : K) (r₀ : K) (g₀ : K) w


abbrev wcKmrMax {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u v : A)
    (b₀ : ↥W) (ℓ : ℕ) (f' : K) (lam₁ lam₂ : ↥W) : Prop :=
  ∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (a₀' a₁' : A)
    (p₀' p₁' r₀' r₁' g₀' g₁' :
      ↥(Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀)})),
    wcKmrUnit 𝔭 h' →
    wcKmrNF W A K 𝔭 u v b₀ (f' / h' ^ ℓ - 1) lam₁' lam₂' w' n' k' a₀' a₁' p₀' p₁' r₀' r₁' g₀' g₁' →
    lam₁' * lam₂ ∣ lam₁ * lam₂'
noncomputable def wcLlsSmQ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {L : Type u} [Field L]
    (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (x : ↥(integralClosure R L)) :
    wcLlsFS W wL R 𝔮 :=
  Ideal.Quotient.mk
    ((Ideal.span {b : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
      (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)))
    (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) x)
noncomputable def wcFrmP {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ρ : ↥W)
    (X : List ↥W) : ↥W :=
  (X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod *
    ρ ^ (X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length

noncomputable def wcFrmM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ρ : ↥W)
    (Z Y : List ↥W) : ℤ :=
  ((Z.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length : ℤ) -
    ((Y.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length : ℤ)

def wcFrmGood {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ) (ρ k1 k2 : ↥W)
    (Z Y : List ↥W) : Prop :=
  k2 * wcFrmP W ρ Y ∣ k1 * wcFrmP W ρ Z ∨ ¬ (ℓ : ℤ) ∣ wcFrmM W ρ Z Y

def wcFrmGen {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ρ : ↥W) (X : List ↥W) : Prop :=
  ∀ z ∈ X, ¬ (ρ ∣ z ∧ z ∣ ρ)

def wcFrmInt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g ρ : ↥W) : Prop :=
  ρ ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ ≠ 0 ∧ ρ ∣ g ∧ ¬ g ∣ ρ

def wcFrmREP {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (F : K)
    (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A) : Prop :=
  k1 ≠ 0 ∧ k2 ≠ 0 ∧ d ∉ 𝔭 ∧ e ∉ 𝔭 ∧
    algebraMap A K d * algebraMap A K (algebraMap ↥W A k2) *
        (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod * F =
      algebraMap A K (algebraMap ↥W A k1) *
        (Z.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod * algebraMap A K e

def wcFrmVAL {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W)
    (O : ↥W → ValuationSubring K) : Prop :=
  ∀ ρ : ↥W, wcFrmInt W g ρ →
    (∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
      wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e →
      algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F /
          algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) ∈ O ρ ∧
        algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) /
          (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F) ∈ O ρ) ∧
    (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
      algebraMap A K (algebraMap ↥W A w₁) / algebraMap A K (algebraMap ↥W A w₂) ∈ O ρ →
      w₂ ∣ w₁) ∧
    (∀ a : A, algebraMap A K a ∈ O ρ)

def wcFrmMem {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W)
    (ℓ : ℕ) (f₀ : K) (I : ↥W → Prop) : Prop :=
  ∃ (H : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A),
    wcFrmREP W A K 𝔭 u (f₀ - (H ^ ℓ - H)) k1 k2 Z Y d e ∧
    ∀ ρ : ↥W, wcFrmInt W g ρ → I ρ → wcFrmGen W ρ (Z ++ Y) → wcFrmGood W ℓ ρ k1 k2 Z Y

structure wcFrmData {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (ℓ : ℕ) (f₀ : K) :
    Type u where
  H : K
  k1 : ↥W
  k2 : ↥W
  Z : List ↥W
  Y : List ↥W
  d : A
  e : A
  rep : wcFrmREP W A K 𝔭 u (f₀ - (H ^ ℓ - H)) k1 k2 Z Y d e
def wcKpwmgbDeep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (g : ↥W) (σ z : A) (lam : ↥W)
    (j : ℤ) (x₀ y₀ : ↥W) : Prop :=
  ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
    c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
    x₀ ∣ c₁ → c₂ ∣ y₀ →
    ∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A K σ * algebraMap A K z =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (E : K)

def wcKpwmgbGood {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W)
    (ℓ : ℕ) (P : ↥W → Prop) (z : A) : Prop :=
  ∀ (σ : A) (lam : ↥W) (j : ℤ) (x₀ y₀ : ↥W), σ ∉ 𝔭 → lam ≠ 0 →
    (j < 0 → g ^ (-j).toNat ∣ lam) → P x₀ → ¬ P y₀ →
    (∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      x₀ ∣ c₁ → c₂ ∣ y₀ →
      ∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂), E ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
        algebraMap A K σ * algebraMap A K z =
          algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (E : K)) →
    ((∀ c : ↥W, c ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) →
        (0 ≤ j → ∃ ρ : ↥W, P ρ ∧ c ^ ℓ ∣ lam * ρ ^ j.toNat) ∧
        (j < 0 → ∃ ρ : ↥W, ¬ P ρ ∧ c ^ ℓ * ρ ^ (-j).toNat ∣ lam)) ∨
      (¬ (ℓ : ℤ) ∣ j ∧
        (0 < j → ∃ ρ : ↥W, ¬ P ρ ∧
          lam ^ (ℓ - 1) * ρ ^ ((ℓ - 1) * j.toNat) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ) ∧
        (j < 0 → ∃ ρ : ↥W, P ρ ∧
          lam ^ (ℓ - 1) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ * ρ ^ ((ℓ - 1) * (-j).toNat))))
noncomputable def wcGcKappa {κ : Type u} [Field κ] {Z : Scheme.{u}} (s : Z ⟶ Spec (CommRingCat.of κ))
    (z : Z) : κ →+* Z.presheaf.stalk z :=
  ((Scheme.ΓSpecIso (CommRingCat.of κ)).inv ≫ s.appTop ≫ Z.presheaf.germ ⊤ z trivial).hom

def wcGcFFGenus (κ K : Type u) [Field κ] [Field K] [Algebra κ K] (g : ℕ) : Prop :=
  ∃ (I : Type u) (w : I → Additive Kˣ →+ ℤ), wcValFamily κ K I w ∧ Function.Injective w ∧
    (Nonempty I ∨ g = 0) ∧
    (∀ μ : Additive Kˣ →+ ℤ,
      (∀ a b h : Kˣ, (h : K) = (a : K) + (b : K) →
        min (μ (Additive.ofMul a)) (μ (Additive.ofMul b)) ≤ μ (Additive.ofMul h)) →
      (∃ t, μ t = 1) →
      (∀ (c : κ) (hc : algebraMap κ K c ≠ 0), μ (Additive.ofMul (Units.mk0 _ hc)) = 0) →
      ∃ z, μ = w z) ∧
    ∃ c : ℕ, ∀ D : I →₀ ℤ, (c : ℤ) ≤ D.sum (fun _ k => k) →
      FiniteDimensional κ (wcRRL κ K I w D) ∧
      (Module.finrank κ (wcRRL κ K I w D) : ℤ) = D.sum (fun _ k => k) + 1 - g

def wcGcStalkGenus {κ : Type u} [Field κ] {Z : Scheme.{u}} (s : Z ⟶ Spec (CommRingCat.of κ))
    (η : Z) (g : ℕ) : Prop :=
  ∃ _ : IsDomain (Z.presheaf.stalk η),
    letI : Algebra κ (FractionRing (Z.presheaf.stalk η)) :=
      ((algebraMap (Z.presheaf.stalk η) (FractionRing (Z.presheaf.stalk η))).comp
        (wcGcKappa s η)).toAlgebra
    wcGcFFGenus κ (FractionRing (Z.presheaf.stalk η)) g
def wcNsrNafcOneBranch {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C X : Scheme.{u}}
    (γ : C ⟶ wcProjK Ω 1) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) (x : ↥X)
    (σb : Spec (.of ↥W) ⟶ X) (b : ↥W) : Prop :=
  ∀ (Xb : Scheme.{u}) (rb : Xb ⟶ X) (ιb : wcProjK Ω 1 ⟶ Xb)
    [QuasiCompact (γ ≫ ιb)] [QuasiSeparated (γ ≫ ιb)],
    wcCsdIsBlowup (σb.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) rb → ιb ≫ rb = ι →
    wcpaDjLkModel W (rb ≫ uX) ιb →
    ∀ y : ↥(wcpaDjLkFib W (γ ≫ ιb) (rb ≫ uX)),
      rb (wcpaDjLkImg W (γ ≫ ιb) (rb ≫ uX) y) = x →
      ¬ wcpaDjLkSmAt W (rb ≫ uX) (wcpaDjLkPi W (γ ≫ ιb) (rb ≫ uX) y) →
    ∀ A B : Set ↥(wcpaDjLkFib W (γ ≫ ιb) (rb ≫ uX)),
      A ∈ irreducibleComponents ↥(wcpaDjLkFib W (γ ≫ ιb) (rb ≫ uX)) →
      B ∈ irreducibleComponents ↥(wcpaDjLkFib W (γ ≫ ιb) (rb ≫ uX)) → y ∈ A → y ∈ B →
      (∃ z ∈ A, closure {z} = A ∧ rb (wcpaDjLkImg W (γ ≫ ιb) (rb ≫ uX) z) = x) →
      (∃ z ∈ B, closure {z} = B ∧ rb (wcpaDjLkImg W (γ ≫ ιb) (rb ≫ uX) z) = x) → A = B
noncomputable def wcKpwmgbLaur {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A)
    (B : List (↥W × ℤ)) : K :=
  (B.map (fun b => algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2)).sum

def wcKpwmgbPhi {α : Type u} (ℓ : ℕ) (B : List (α × ℤ)) : ℕ :=
  ∑ e ∈ ((B.map Prod.snd).toFinset.filter (fun e => (ℓ : ℤ) ∣ e)), ℓ ^ e.natAbs

def wcKpwmgbWin {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W)
    (f' : K) (ℓ : ℕ) (P : ↥W → Prop) (lam : ↥W) (j : ℤ) (μT : ↥W) (kT : ℤ) (h : K)
    (z s' σ : A) (B : List (↥W × ℤ)) (x₀ y₀ : ↥W) : Prop :=
  h ≠ 0 ∧ s' ∉ 𝔭 ∧ algebraMap A K s' * (f' / h ^ ℓ - 1) = algebraMap A K z ∧
  σ ∉ 𝔭 ∧ P x₀ ∧ ¬ P y₀ ∧
  (∀ b ∈ B, b.2 < 0 → g ^ (-b.2).toNat ∣ b.1) ∧ (∀ b ∈ B, b.1 ≠ 0) ∧
  B.Pairwise (fun b b' => b.2 ≠ b'.2) ∧
  ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
    c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
    x₀ ∣ c₁ → c₂ ∣ y₀ →
    (∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A K σ * ((f' / h ^ ℓ - 1) - wcKpwmgbLaur W A K u B) =
        algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (E : K)) ∧
    ∀ b ∈ B, ∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2 =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K)

def wcKpwmgbCtx {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (g : ↥W) (ℓ : ℕ)
    (P : ↥W → Prop) (c' lam : ↥W) (j : ℤ) (μT : ↥W) (kT : ℤ) (xT yT : ↥W) : Prop :=
  c' ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) ∧ lam ∈ IsLocalRing.maximalIdeal ↥W ∧ lam ≠ 0 ∧
  (j < 0 → g ^ (-j).toNat ∣ lam) ∧ μT ≠ 0 ∧ P xT ∧ ¬ P yT ∧
  ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
    c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
    xT ∣ c₁ → c₂ ∣ yT →
    (∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂), algebraMap A K (algebraMap ↥W A c') ^ ℓ =
      algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K)) ∧
    (∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K)) ∧
    (∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A K (algebraMap ↥W A (lam ^ 2)) * algebraMap A K u ^ (2 * j) =
        algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (r : K)) ∧
    (∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂), algebraMap A K (algebraMap ↥W A c') ^ ℓ =
      algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (r : K))
abbrev wcSewWin {Ω : Type u} [Field Ω] {L : Type u} [Field L] (W : ValuationSubring Ω)
    (φ : Ω →+* L) (s : L) (PL PE : ↥W → Prop) (Φ : ValuationSubring L → Prop) : Prop :=
  ∃ (a b : ↥W), PL a ∧ PE b ∧ ∀ V : ValuationSubring L,
    (∀ w : ↥W, V.valuation (φ (w : Ω)) ≤ 1) →
    (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → V.valuation (φ (w : Ω)) < 1) →
    V.valuation (φ (a : Ω)) < V.valuation s → V.valuation s ≤ V.valuation (φ (b : Ω)) → Φ V
def wcLlsKPOk {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (y : K) : Prop :=
  ∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
    (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b

def wcLlsKPOM {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (y : K) : Prop :=
  ∃ (π : ↥W) (y' : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧ wcLlsKPOk W A K 𝔭 y' ∧
    y = algebraMap A K (algebraMap ↥W A π) * y'
