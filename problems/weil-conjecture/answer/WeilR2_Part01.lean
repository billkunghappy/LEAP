  ⟨MvPolynomial.map (algebraMap E K) (G : MvPolynomial (Fin (N + 1)) E),
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr
      (((MvPolynomial.mem_homogeneousSubmodule 2 _).mp G.2).map (algebraMap E K))⟩

noncomputable def wcLdpRho (F' E K : Type u) [Field F'] [Field E] [Field K] [Algebra F' E]
    [Algebra F' K] [Algebra E K] [IsScalarTower F' E K] (Y : Over (Spec (.of F'))) :
    Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ⟶
      Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) :=
  Limits.pullback.lift (Limits.pullback.fst _ _)
    (Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (algebraMap E K)))
    (by
      rw [Limits.pullback.condition, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq])
def wcEtInvSH (K : Type u) [Field K] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (n : ℕ) : Prop :=
  ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (s : Spec (.of A) ⟶ Spec (.of K)) (Y' : Scheme.{u}) (p : Y' ⟶ Y) (t : Y' ⟶ Spec (.of A)),
    IsPullback p t fY s → ∀ (E : wcEtPullData p n) (j : ℕ), Function.Bijective (wcEtPull E j)

def wcEtGoodSH (K : Type u) [Field K] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (n : ℕ) : Prop :=
  ∀ (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of K)), IsProper fZ → ∀ (W : Scheme.{u}) (a : W ⟶ Y)
    (b : W ⟶ Z), IsPullback a b fY fZ → wcEtInvSH K W (a ≫ fY) n
noncomputable def wcEszSec (K : Type u) [Field K] (N e : ℕ)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (a : Fin (N + 1)) :
    Γ(wcProjK K N, wcSgD K N a) :=
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
  (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
    (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)) e
      (F : MvPolynomial (Fin (N + 1)) K) (by simpa only [smul_eq_mul, mul_one] using F.2))

noncomputable def wcEszDh {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}}
    (κ : W ⟶ wcProjK K N) (e : ℕ) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e)
    (a : Fin (N + 1)) : Γ(W, κ ⁻¹ᵁ wcSgD K N a) :=
  (κ.app (wcSgD K N a)).hom (wcEszSec K N e F a)

noncomputable def wcEszG {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}}
    (κ : W ⟶ wcProjK K N) (a b : Fin (N + 1)) :
    Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) :=
  (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
    κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcSgE K N b a))

noncomputable def wcEszScal {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}}
    (κ : W ⟶ wcProjK K N) (V : W.Opens) : K →+* Γ(W, V) :=
  (W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
    ((κ ≫ wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom)

def wcEszCoc {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}} (κ : W ⟶ wcProjK K N) (m : ℕ)
    (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) : Prop :=
  ∀ a b l : Fin (N + 1),
    (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓
        κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)).op).hom (c a b) +
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓
        κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)).op).hom
          (wcEszG κ a b) ^ m *
      (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
          κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l)).op).hom (c b l) =
    (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
          κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N l)).op).hom (c a l)

def wcEszCob {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}} (κ : W ⟶ wcProjK K N) (m : ℕ)
    (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) : Prop :=
  ∃ d : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a), ∀ a b : Fin (N + 1),
    c a b = (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
        κ ⁻¹ᵁ wcSgD K N a)).op).hom (d a) -
      wcEszG κ a b ^ m *
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom (d b)

noncomputable def wcEszMul {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}}
    (κ : W ⟶ wcProjK K N) (e : ℕ) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e)
    (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) :
    ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) :=
  fun a b => (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
    κ ⁻¹ᵁ wcSgD K N a)).op).hom (wcEszDh κ e F a) * c a b

def wcEszVanish {K : Type u} [Field K] {N : ℕ} {W : Scheme.{u}} (κ : W ⟶ wcProjK K N) (e : ℕ)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) : Prop :=
  ∀ a : Fin (N + 1), wcEszDh κ e F a = 0
noncomputable def wcLdpGrHom (A B : Type u) [Field A] [Field B] [Algebra A B] (N : ℕ) :
    MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B :=
  ⟨MvPolynomial.map (algebraMap A B), fun {i} {x} hx =>
    (MvPolynomial.mem_homogeneousSubmodule i _).mpr
      (((MvPolynomial.mem_homogeneousSubmodule i x).mp hx).map (algebraMap A B))⟩

noncomputable def wcLdpProjMap (A B : Type u) [Field A] [Field B] [Algebra A B] (N : ℕ) :
    wcProjK B N ⟶ wcProjK A N :=
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
  Proj.map (wcLdpGrHom A B N) (by
    intro p hp
    have hp' : p ∈ Ideal.span (Set.range (MvPolynomial.X :
        Fin (N + 1) → MvPolynomial (Fin (N + 1)) B)) := by
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff
          (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩
    change p ∈ (HomogeneousIdeal.map (wcLdpGrHom A B N) _).toIdeal
    rw [HomogeneousIdeal.toIdeal_map]
    refine (Ideal.span_le.mpr ?_) hp'
    rintro _ ⟨i, rfl⟩
    have hfX : wcLdpGrHom A B N (MvPolynomial.X i) = MvPolynomial.X i :=
      MvPolynomial.map_X (algebraMap A B) i
    rw [← hfX]
    apply Ideal.mem_map_of_mem
    change MvPolynomial.X i ∈ HomogeneousIdeal.irrelevant _
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne _
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i))
      one_ne_zero)
def wcLdpDtcRow {C : Type*} [CommRing C] {N t : ℕ} (ξ : Fin (N + 1) → C)
    (η : Fin t → Fin (N + 1) → C) : Option (Fin t) → Fin (N + 1) × Fin (N + 1) → C
  | none, q => ξ q.1 * ξ q.2
  | some k, q => ξ q.1 * η k q.2 + η k q.1 * ξ q.2

def wcLdpDtcPM {C : Type*} [CommRing C] {N t t' : ℕ} (ξ : Fin (N + 1) → C)
    (η : Fin t → Fin (N + 1) → C) (ξ' : Fin (N + 1) → C) (η' : Fin t' → Fin (N + 1) → C) :
    Matrix (Option (Fin t) ⊕ Option (Fin t')) (Fin (N + 1) × Fin (N + 1)) C :=
  Matrix.of fun r q => Sum.elim (wcLdpDtcRow ξ η) (wcLdpDtcRow ξ' η') r q
