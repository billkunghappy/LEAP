    ∃ m : Fin r → (Fin (N + 1) →₀ ℕ), Function.Injective m ∧
      ∀ a a', (a = a' → (G c a).coeff (m a') = 1) ∧ (a ≠ a' → (G c a).coeff (m a') = 0)) ∧
  (∀ (c : Fin (L + 1)) (V : B.Opens) (hV : V ≤ μ ⁻¹ᵁ wcSgD k L c) (i : Fin (N + 1)),
    IsAffineOpen V →
    RingHom.ker ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom =
      Ideal.span (Set.range fun a => wcpaDjFlrgPsi k N sB V i
        (MvPolynomial.map (μ.appLE (wcSgD k L c) V hV).hom (G c a)))) ∧
  (∀ (c : Fin (L + 1)) (p : B) (hp : p ∈ μ ⁻¹ᵁ wcSgD k L c) (e : ℕ), e₀ ≤ e →
    wcpaDjHilbFn (B.residueField p) N (Ideal.span (Set.range fun a =>
      MvPolynomial.map (μ.app (wcSgD k L c) ≫ B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c) p hp ≫
        B.residue p).hom (G c a))) e = Φ e)
