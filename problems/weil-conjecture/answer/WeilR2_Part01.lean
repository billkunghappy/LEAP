            Scheme.etaleTopology
    haveI := hcont'
    exact Functor.op_comp_isSheaf_of_isSheaf (Scheme.Etale.forget X ⋙ Over.forget X)
      (Scheme.smallEtaleTopology X) Scheme.etaleTopology _
      (Presheaf.IsSheaf.of_le (le_trans Scheme.etaleTopology_le_proetaleTopology
        Scheme.proetaleTopology_le_fpqcTopology) s4)

  obtain ⟨hcont, ⟨hT⟩, hmono⟩ := wc_zarToEt_props X
  haveI := hcont

  have hC : ∀ (F₀ : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u+1}),
      (∀ (U V : X.Opens) (h : U ≤ V), Function.Surjective (F₀.obj.map (homOfLE h).op)) →
      ∀ e : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) F₀ 1, e = 0 := by
