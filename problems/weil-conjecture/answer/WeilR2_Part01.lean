def wcpaDjNccWalkOut (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z' : Scheme.{u}} (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ' : Fin n → (Spec (.of R) ⟶ Z')) :
    Prop :=
  ∃ (T : Finset (Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))))
    (Eint : Finset ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
    T.Nonempty ∧
    (∀ X ∈ T, X ∈ irreducibleComponents
      ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) ∧
    (∀ x ∈ Eint, ∃ X₁ ∈ T, ∃ X₂ ∈ T, X₁ ≠ X₂ ∧ x ∈ X₁ ∧ x ∈ X₂) ∧
    (∀ (m : ℕ) (X : Fin (m + 2) → Set ↥(Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
        (p : Fin (m + 2) → ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
      (∀ i, X i ∈ T) → (∀ i, p i ∈ Eint) → Function.Injective X → Function.Injective p →
      (∀ i, p i ∈ X i ∧ p i ∈ X (finRotate (m + 2) i)) → False) ∧
    ∑ X ∈ T, ((X ∩ closure Xᶜ).ncard +
        Nat.card { i // ∃ x ∈ X, ∃ p,
          (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) x =
            (τ' i) ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) p) } +
        if wcpaDjNccP1 u' (IsLocalRing.ResidueField R)
            (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) X then 0 else 2) ≤
      2 + ∑ X ∈ T, (↑Eint ∩ X).ncard
noncomputable abbrev wcNooFib {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (B : Type u)
    [CommRing B] [Algebra ↥W B] (𝔮 : Ideal B) [𝔮.IsPrime] : Type u :=
  Localization.AtPrime 𝔮 ⧸ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)).map
    (algebraMap B (Localization.AtPrime 𝔮))

noncomputable abbrev wcNooPi {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (B : Type u)
    [CommRing B] [Algebra ↥W B] (𝔮 : Ideal B) [𝔮.IsPrime] : B →+* wcNooFib W B 𝔮 :=
  (Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)).map
    (algebraMap B (Localization.AtPrime 𝔮)))).comp (algebraMap B (Localization.AtPrime 𝔮))
def wcGsCoords (m : ℕ) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) : Prop :=
  (∀ k, e k k = 1) ∧ (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{u} m).basicOpen (e k l)) ∧ (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k j) = (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k l) * (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l)).op (e l j)) ∧ (∀ k (s : Γ(wcPm.{u} m, wcPmChart m k)), ∃ p : MvPolynomial (Fin (m + 1)) ℤ, MvPolynomial.eval₂ (Int.castRingHom _) (e k) p = s)

def wcGsTw {Y : Scheme.{u}} {m : ℕ} (g : Y ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (w : ℕ) (L : Y.Modules)
    (φ : ∀ (k : Fin (m + 1)) (O : Y.Opens), O ≤ g ⁻¹ᵁ wcPmChart m k → (Γ(L, O) →+ Γ(wcStructMod Y, O))) : Prop :=
  (∀ k O h, Function.Bijective (φ k O h)) ∧
  (∀ k O h (s : Γ(Y, O)) (x : Γ(L, O)), φ k O h (s • x) = s • φ k O h x) ∧
  (∀ k O O' (h : O ≤ g ⁻¹ᵁ wcPmChart m k) (h' : O' ≤ O) (x : Γ(L, O)),
    φ k O' (h'.trans h) ((L.presheaf.map (homOfLE h').op).hom x) =
      ((wcStructMod Y).presheaf.map (homOfLE h').op).hom (φ k O h x)) ∧
  (∀ k l O (hk : O ≤ g ⁻¹ᵁ wcPmChart m k) (hl : O ≤ g ⁻¹ᵁ wcPmChart m l) (x : Γ(L, O)),
    φ k O hk x = ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k l))) ^ w • φ l O hl x)

def wcGsLaurModel {Y : Scheme.{u}} {m : ℕ} (L : Y.Modules) (D : Fin (m + 1) → Y.Opens)
    (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O))
    (K : Submodule (MvPolynomial (Fin (m + 1)) A) (Fin 1 → MvPolynomial (Fin (m + 1)) A)) (w : ℤ)
    (Θ : ∀ q : ℕ, (Finset (Fin (m + 1)) → Fin 1 → (Fin (m + 1) → ℤ) →₀ A) → wcAcC L D O q) : Prop :=
  (∀ q v v', Θ q (v + v') = Θ q v + Θ q v') ∧
  (∀ q v v', (∀ s : Finset (Fin (m + 1)), s.card = q + 1 → v s = v' s) → Θ q v = Θ q v') ∧
  (∀ q (c : A) v, Θ q (c • v) = fun a =>
    (Y.presheaf.map (homOfLE (inf_le_right : wcAcV D O a ≤ O)).op).hom (ψ c) • Θ q v a) ∧
  (∀ q (y : wcAcC L D O q), ∃ v, (∀ s, (s.card = q + 1 → v s ∈ wcLaurC A (m + 1) 1 (fun _ => 0) w s) ∧
    (s.card ≠ q + 1 → v s = 0)) ∧ Θ q v = y) ∧
  (∀ q v, (∀ s, s.card = q + 1 → v s ∈ wcLaurC A (m + 1) 1 (fun _ => 0) w s) →
    (Θ q v = 0 ↔ ∀ s, s.card = q + 1 → v s ∈ wcLaurK A (m + 1) 1 (fun _ => 0) K w s)) ∧
  (∀ q v, (∀ s, s.card = q + 1 → v s ∈ wcLaurC A (m + 1) 1 (fun _ => 0) w s) →
    Θ (q + 1) (wcAltD (A := A) (m + 1) v) = wcAcD L D O q (Θ q v))
noncomputable def wcLldmLam {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (e b : ↥W) :
    MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) ↥W :=
  MvPolynomial.eval₂Hom MvPolynomial.C
    (fun _ : Fin 1 => MvPolynomial.C e + MvPolynomial.C b * MvPolynomial.X 0)

noncomputable def wcLldmH {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (e b : ↥W) :
    MvPolynomial (Fin 1) ↥W →+* wcNcRing W b :=
  (Ideal.Quotient.mk (wcNcIdeal W b)).comp
    (MvPolynomial.eval₂Hom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)
      (fun _ : Fin 1 => (MvPolynomial.X 0 + MvPolynomial.C e : MvPolynomial (Fin 2) ↥W)))

noncomputable def wcLldmXi (R : Type u) [CommRing R] {Z : Scheme.{u}} (G : Z ⟶ wcLldfA R)
    (z : ↥Z) : MvPolynomial (Fin 1) R →+* Z.presheaf.stalk z :=
  ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) R))).inv ≫ G.appTop ≫
    Z.presheaf.germ ⊤ z trivial).hom
def wcpaDjNccN1 (A : Type u) [CommRing A] : Prop :=
  Module.Finite A (integralClosure A (FractionRing A))

def wcpaDjNccN2 (A : Type u) [CommRing A] : Prop :=
  ∀ (L : Type u) [Field L] [Algebra A L] [Algebra (FractionRing A) L]
    [IsScalarTower A (FractionRing A) L],
    Module.Finite (FractionRing A) L → Module.Finite A (integralClosure A L)

def wcpaDjNccNag (A : Type u) [CommRing A] : Prop :=
  IsNoetherianRing A ∧ ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D],
    Function.Surjective (algebraMap A D) → wcpaDjNccN2 D

def wcpaDjNccNagFin.{u} : Prop :=
  ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C],
    Module.Finite A C → wcpaDjNccNag A → wcpaDjNccNag C

def wcpaDjNccNagPoly.{u} : Prop :=
  ∀ (A : Type u) [CommRing A] [IsDomain A], IsNoetherianRing A → wcpaDjNccN2 A →
    wcpaDjNccN2 (Polynomial A)

def wcpaDjNccNagStar.{u} : Prop :=
  ∀ (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Field K] [Algebra A K]
    [IsFractionRing A K], wcpaDjNccNag A → ∀ x : K, wcpaDjNccN1 (Algebra.adjoin A {x})
noncomputable abbrev wcpaDjGltCcPsi {O₀ Oy : Type u} [CommRing O₀] [CommRing Oy] [IsLocalRing Oy]
    (φ : O₀ →+* Oy) {N : ℕ} (F : Fin (N + 1) → AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy)
    (k₀ : Fin (N + 1)) (Q : Ideal (wcpaDjGltNC (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy) F k₀))
    [Q.IsPrime] :
    O₀ →+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) (Localization.AtPrime Q) :=
  (algebraMap (Localization.AtPrime Q) (AdicCompletion
      (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) (Localization.AtPrime Q))).comp
    ((algebraMap (wcpaDjGltNC (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy) F k₀)
        (Localization.AtPrime Q)).comp
      ((wcpaDjGltNCMap (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy) F k₀).comp
        ((algebraMap Oy (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy)).comp φ)))

noncomputable abbrev wcpaDjGltCcSmMap (O₀ : Type u) [CommRing O₀] [IsLocalRing O₀]
    (P : Ideal (Polynomial (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀))) [P.IsPrime] :
    O₀ →+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime P)) (Localization.AtPrime P) :=
  (algebraMap (Localization.AtPrime P) (AdicCompletion
      (IsLocalRing.maximalIdeal (Localization.AtPrime P)) (Localization.AtPrime P))).comp
    ((algebraMap (Polynomial (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀))
        (Localization.AtPrime P)).comp
      (Polynomial.C.comp (algebraMap O₀ (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀))))
noncomputable def fexRho (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (y : C) :
    C.presheaf.stalk y →+* C.residueField (genericPoint C) :=
  (C.presheaf.stalkSpecializes (genericPoint_specializes y) ≫ C.residue (genericPoint C)).hom
noncomputable abbrev wcVdR0 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c₀ b₀ e' : ↥W) :
    Subalgebra A K :=
  Algebra.adjoin A {wcLlsScS W A K t c₀ b₀, wcLlsScV W A K t (c₀ + b₀ * e') b₀}

noncomputable abbrev wcVdJ0 {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c₀ b₀ e' : ↥W) :
    Ideal ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
  (Ideal.span {c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) |
    ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}).radical

noncomputable def wcVdD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c₀ b₀ e' : ↥W) : Type u :=
  ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) ⧸ wcVdJ0 W A K L t c₀ b₀ e'

noncomputable def wcVdD.commRing {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
    [Field L] [Algebra K L] (t : A) (c₀ b₀ e' : ↥W) : CommRing (wcVdD W A K L t c₀ b₀ e') :=
  Ideal.Quotient.commRing _

noncomputable def wcVdD.mk {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
    [Field L] [Algebra K L] (t : A) (c₀ b₀ e' : ↥W) :
    letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e'
    ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) →+* wcVdD W A K L t c₀ b₀ e' :=
  Ideal.Quotient.mk (wcVdJ0 W A K L t c₀ b₀ e')
def wcpaDjNcceSerre.{v} (T : Type v) [CommRing T] : Prop :=
  ∀ (P : Ideal T) [P.IsPrime],
    (P.height ≤ 1 → IsRegularLocalRing (Localization.AtPrime P)) ∧
    (2 ≤ P.height → ∃ a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P),
      ∃ b ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P),
        (∀ y : Localization.AtPrime P, a * y = 0 → y = 0) ∧
        ∀ y z : Localization.AtPrime P, b * y = a * z → ∃ w, y = a * w)
noncomputable def wcpaRfFrTr {K E : Type*} [Field K] [AddCommGroup E] [Module K E]
    (T : Module.End K E) : K :=
  LinearMap.trace K (LinearMap.range T) (T.restrict (fun x _ => LinearMap.mem_range_self T x))

noncomputable def wcpaRfTRes {K E : Type*} [Field K] [AddCommGroup E] [Module K E]
    (e f g : Module.End K E) : K :=
  wcpaRfFrTr (e * g * (1 - e) * f * e - e * f * (1 - e) * g * e)
noncomputable def fexRfD0 {X : Scheme.{u}} {m : ℕ} (V : Fin m → X.Opens) (β : ∀ a : Fin m, Γ(X, V a)) :
    ∀ a b : Fin m, Γ(X, V a ⊓ V b) := fun a b =>
  (X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (β b) -
    (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (β a)

noncomputable def fexRfD1 {X : Scheme.{u}} {m : ℕ} (V : Fin m → X.Opens)
    (z : ∀ a b : Fin m, Γ(X, V a ⊓ V b)) : ∀ a b d : Fin m, Γ(X, V a ⊓ V b ⊓ V d) := fun a b d =>
  (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
      V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z b d) -
    (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
      V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z a d) +
    (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom (z a b)

noncomputable def fexRfD2 {X : Scheme.{u}} {m : ℕ} (V : Fin m → X.Opens)
    (w : ∀ a b d : Fin m, Γ(X, V a ⊓ V b ⊓ V d)) :
    ∀ a b d e : Fin m, Γ(X, V a ⊓ V b ⊓ V d ⊓ V e) := fun a b d e =>
  (X.presheaf.map (homOfLE (le_inf (le_inf (inf_le_left.trans (inf_le_left.trans inf_le_right))
      (inf_le_left.trans inf_le_right)) inf_le_right :
      V a ⊓ V b ⊓ V d ⊓ V e ≤ V b ⊓ V d ⊓ V e)).op).hom (w b d e) -
    (X.presheaf.map (homOfLE (le_inf (le_inf (inf_le_left.trans (inf_le_left.trans inf_le_left))
      (inf_le_left.trans inf_le_right)) inf_le_right :
      V a ⊓ V b ⊓ V d ⊓ V e ≤ V a ⊓ V d ⊓ V e)).op).hom (w a d e) +
    (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
      V a ⊓ V b ⊓ V d ⊓ V e ≤ V a ⊓ V b ⊓ V e)).op).hom (w a b e) -
    (X.presheaf.map (homOfLE (inf_le_left :
      V a ⊓ V b ⊓ V d ⊓ V e ≤ V a ⊓ V b ⊓ V d)).op).hom (w a b d)
structure wcpaLccSRD {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {Z₁ : Scheme.{u}}
    (u₁ : Z₁ ⟶ Spec (.of ↥W)) (L : wcpaDjCoc Z₁) where
  S : Type u
  [cr : CommRing S]
  𝒜 : ℕ → AddSubgroup S
  [gr : GradedRing 𝒜]
  ρ₀ : ↥W →+* ↥(𝒜 0)
  ev : ∀ a : Fin L.m, S →+* Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)

def wcpaLccSRD.instCR {Ω : Type u} [Field Ω] {W : ValuationSubring Ω} {Z₁ : Scheme.{u}}
    {u₁ : Z₁ ⟶ Spec (.of ↥W)} {L : wcpaDjCoc Z₁} (D : wcpaLccSRD W u₁ L) : CommRing D.S := D.cr

def wcpaLccSRD.instGR {Ω : Type u} [Field Ω] {W : ValuationSubring Ω} {Z₁ : Scheme.{u}}
    {u₁ : Z₁ ⟶ Spec (.of ↥W)} {L : wcpaDjCoc Z₁} (D : wcpaLccSRD W u₁ L) :
    letI := D.cr; GradedRing D.𝒜 := D.gr

noncomputable def wcpaLccUU {Ω : Type u} [Field Ω] {W : ValuationSubring Ω} {Z₁ : Scheme.{u}}
    {u₁ : Z₁ ⟶ Spec (.of ↥W)} {L : wcpaDjCoc Z₁} (D : wcpaLccSRD W u₁ L) :
    letI := D.cr; letI := D.gr; Proj D.𝒜 ⟶ Spec (.of ↥W) :=
  letI := D.cr; letI := D.gr; Proj.toSpecZero D.𝒜 ≫ Spec.map (CommRingCat.ofHom D.ρ₀)

def wcpaLccSRDOK {Ω : Type u} [Field Ω] {W : ValuationSubring Ω} {Z₁ : Scheme.{u}}
    {u₁ : Z₁ ⟶ Spec (.of ↥W)} {L : wcpaDjCoc Z₁} (D : wcpaLccSRD W u₁ L) (m : ℕ) : Prop :=
  letI := D.cr; letI := D.gr;
  Function.Surjective D.ρ₀ ∧
  (∀ (a : Fin L.m) (w : ↥W), D.ev a ((D.ρ₀ w : ↥(D.𝒜 0)) : D.S) =
    (u₁.appLE ⊤ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) ∧
  (∀ k : ℕ, 1 ≤ k → ∀ r ∈ D.𝒜 k, wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * k) (fun a => D.ev a r)) ∧
  (∀ k : ℕ, 1 ≤ k → ∀ x : (∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * k) x → ∃! r : D.S, r ∈ D.𝒜 k ∧ ∀ a, D.ev a r = x a) ∧
  Algebra.FiniteType ↥(D.𝒜 0) D.S ∧
  (∃ (M : ℕ) (d : Fin M → ℕ) (x : Fin M → D.S), (∀ J, 1 ≤ d J ∧ x J ∈ D.𝒜 (d J)) ∧
    (HomogeneousIdeal.irrelevant D.𝒜).toIdeal ≤ Ideal.span (Set.range x)) ∧
  (∀ k : ℕ, 1 ≤ k → ∀ w : ↥W, w ≠ 0 → ∀ y ∈ D.𝒜 k,
    ((D.ρ₀ w : ↥(D.𝒜 0)) : D.S) * y = 0 → y = 0) ∧
  (∀ a : Fin L.m, Ideal.map (D.ev a) (HomogeneousIdeal.irrelevant D.𝒜).toIdeal = ⊤)

def wcpaLccChart {Ω : Type u} [Field Ω] {W : ValuationSubring Ω} {Z₁ : Scheme.{u}}
    {u₁ : Z₁ ⟶ Spec (.of ↥W)} {L : wcpaDjCoc Z₁} (D : wcpaLccSRD W u₁ L)
    (φ : letI := D.cr; letI := D.gr; Z₁ ⟶ Proj D.𝒜) : Prop :=
  letI := D.cr; letI := D.gr;
  φ ≫ wcpaLccUU D = u₁ ∧
  (∀ k : ℕ, 1 ≤ k → ∀ r ∈ D.𝒜 k,
    φ ⁻¹ᵁ Proj.basicOpen D.𝒜 r = ⨆ a, Z₁.basicOpen (D.ev a r)) ∧
  (∀ (k : ℕ) (r : D.S) (hr : r ∈ D.𝒜 k), 1 ≤ k → ∀ (j : ℕ) (β : D.S) (hβ : β ∈ D.𝒜 (j • k))
    (a : Fin L.m) (h : Z₁.basicOpen (D.ev a r) ≤ φ ⁻¹ᵁ Proj.basicOpen D.𝒜 r),
    (φ.appLE (Proj.basicOpen D.𝒜 r) (Z₁.basicOpen (D.ev a r)) h).hom
        ((Proj.awayToSection D.𝒜 r).hom (HomogeneousLocalization.Away.mk D.𝒜 hr j β hβ)) *
      (Z₁.presheaf.map (homOfLE (Z₁.basicOpen_le (D.ev a r))).op).hom (D.ev a r) ^ j =
    (Z₁.presheaf.map (homOfLE (Z₁.basicOpen_le (D.ev a r))).op).hom (D.ev a β))
noncomputable def wcGtRec {T : Type*} [CommRing T] (ℓ : ℕ) (e : ℕ → ℕ) (γ : T) (c x : ℕ → T)
    (H₀ G₀ : Polynomial T) : ℕ → Polynomial T × Polynomial T
  | 0 => (H₀, G₀)
  | t + 1 =>
    ((wcGtRec ℓ e γ c x H₀ G₀ t).1 +
        Polynomial.C γ * Polynomial.C (x (t + 1)) * Polynomial.X ^ (e t),
     (wcGtRec ℓ e γ c x H₀ G₀ t).2 - (∑ k ∈ Finset.Ioo 0 ℓ, Polynomial.C (c k) *
        (Polynomial.C (x (t + 1)) * Polynomial.X ^ (e t)) ^ k *
          (wcGtRec ℓ e γ c x H₀ G₀ t).1 ^ (ℓ - k)) -
      (Polynomial.C (x (t + 1)) * Polynomial.X ^ (e t)) ^ ℓ)

noncomputable def wcGtPhi {T : Type*} [CommRing T] (ℓ q : ℕ) (c : ℕ → T)
    (P : Polynomial T × Polynomial T) (t : ℕ) : Polynomial T :=
  if t = 0 then
    Polynomial.X ^ ℓ + (∑ k ∈ Finset.Ioo 0 ℓ,
      Polynomial.C (c k * (P.1.coeff 0) ^ (ℓ - k)) * Polynomial.X ^ k) - Polynomial.C (P.2.coeff 0)
  else Polynomial.X ^ ℓ - Polynomial.C (P.2.coeff (ℓ * ((t - 1) % q + 1)))
def wcpaDjNccNsCore.{u} : Prop :=
  ∀ (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Field K] [Algebra A K]
    [IsFractionRing A K], wcpaDjNccNag A →
    ∀ (x : K) (r : A) (m : Ideal (Algebra.adjoin A ({x} : Set K))) [m.IsMaximal],
      ((⟨x, Algebra.self_mem_adjoin_singleton A x⟩ : Algebra.adjoin A ({x} : Set K)) -
        algebraMap A (Algebra.adjoin A ({x} : Set K)) r) ∈ m →
      wcpaDjNccN1 (Localization.AtPrime m)

def wcpaDjNccNsLoc.{u} : Prop :=
  ∀ (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsLocalRing A] [Field K]
    [Algebra A K] [IsFractionRing A K], wcpaDjNccNag A →
    ∀ (x : K) (m : Ideal (Algebra.adjoin A ({x} : Set K))) [m.IsMaximal],
      m.comap (algebraMap A (Algebra.adjoin A ({x} : Set K))) = IsLocalRing.maximalIdeal A →
      wcpaDjNccN1 (Localization.AtPrime m)
noncomputable abbrev wcpaDjGslcIdeal {A R : Type*} [CommRing A] [CommRing R] (g : MvPolynomial (Fin 1) A →+* R)
    (a τ : A) : Ideal (Polynomial R) :=
  Ideal.span {Polynomial.C (g (MvPolynomial.C τ)) * Polynomial.X -
    Polynomial.C (g (MvPolynomial.X 0) - g (MvPolynomial.C a))}
def wcLlsVmSmall {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A) (c b μ : ↥W)
    (E : K) : Prop :=
  ∃ (x d : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) (a : A), a ∉ 𝔭 ∧
    d - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a ∈
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) ∧
    E * (d : K) = algebraMap A K (algebraMap ↥W A μ) * (x : K)
def wcSmpNuE (B : Type u) [CommRing B] (M : Type u) [Field M] [Algebra B M] (𝔮₀ : Ideal B) :
    Set M :=
  {x | ∃ e ∈ 𝔮₀, ∃ d : B, d ∉ 𝔮₀ ∧ x * algebraMap B M d = algebraMap B M e}

def wcSmpNuD (B : Type u) [CommRing B] (M : Type u) [Field M] [Algebra B M] (𝔮₀ 𝔮 : Ideal B) :
    Set M :=
  {x | ∃ y σ : B, σ ∉ 𝔮 ∧ x * algebraMap B M σ - algebraMap B M y ∈ wcSmpNuE B M 𝔮₀}

def wcSmpNuMD (B : Type u) [CommRing B] (M : Type u) [Field M] [Algebra B M] (𝔮₀ 𝔮 : Ideal B) :
    Set M :=
  {x | ∃ y ∈ 𝔮, ∃ σ : B, σ ∉ 𝔮 ∧ x * algebraMap B M σ - algebraMap B M y ∈ wcSmpNuE B M 𝔮₀}
noncomputable def wcVdCfIota {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L]
    [Algebra K L] (t : A) (c₀ b₀ e' : ↥W) :
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L) →+*
      ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) where
  toFun c := ⟨(c : L), (mem_integralClosure_iff _ _).mpr
      (IsIntegral.map_of_comp_eq
        ((Subalgebra.inclusion (Algebra.adjoin_mono
          (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) :
            Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} ≤ wcVdR0 W A K t c₀ b₀ e')) :
          ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) →+* ↥(wcVdR0 W A K t c₀ b₀ e'))
        (RingHom.id L) (RingHom.ext fun _ => rfl) ((mem_integralClosure_iff _ _).mp c.2))⟩
  map_one' := Subtype.ext rfl
  map_mul' _ _ := Subtype.ext rfl
  map_zero' := Subtype.ext rfl
  map_add' _ _ := Subtype.ext rfl
abbrev wcGubGen {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] : Type u :=
  Localization (Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))

noncomputable abbrev wcGubBox {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (g : Fin 2 → A) (c : ↥W) : Subalgebra A (wcGubGen W A) :=
  Algebra.adjoin A (Set.range fun i : Fin 2 =>
    algebraMap A (wcGubGen W A) (g i) *
      Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A c)))

noncomputable abbrev wcGubIdl {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (g : Fin 2 → A) (ϖ c : ↥W) : Ideal ↥(wcGubBox W A g c) :=
  Ideal.span {algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A ϖ)}

abbrev wcGubCpl {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (g : Fin 2 → A) (ϖ c : ↥W) : Type u :=
  AdicCompletion (wcGubIdl W A g ϖ c) ↥(wcGubBox W A g c)

def wcGubAdm {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A) : Prop :=
  ϖ ≠ 0 ∧ ϖ ∈ IsLocalRing.maximalIdeal ↥W ∧
  IsDomain A ∧ IsIntegrallyClosed A ∧ Algebra.FinitePresentation ↥W A ∧
  (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) ∧
  (∀ (a : A) (j : ℕ), a ^ j ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
  ringKrullDim (wcGubGen W A) ≤ 1 ∧
  𝔪.IsMaximal ∧ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔪 ∧
  (∀ i, g i ∈ 𝔪) ∧
  (Ideal.span (Set.range g) ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).radical = 𝔪

def wcGubIdem {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (g : Fin 2 → A) (ϖ : ↥W) (x : ∀ c : ↥W, wcGubCpl W A g ϖ c)
    (k : ↥W → ℕ) : Prop :=
  ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    x c * x c = algebraMap A (wcGubCpl W A g ϖ c) (algebraMap ↥W A ϖ) ^ k c * x c

def wcGubCompat {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (g : Fin 2 → A) (ϖ : ↥W) (x : ∀ c : ↥W, wcGubCpl W A g ϖ c)
    (k : ↥W → ℕ) : Prop :=
  ∀ c c' : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → c' ≠ 0 →
    c' ∈ IsLocalRing.maximalIdeal ↥W → c ∣ c' →
    ∀ (m : ℕ) (r : ↥(wcGubBox W A g c)) (r' : ↥(wcGubBox W A g c')),
      Ideal.Quotient.mk (wcGubIdl W A g ϖ c ^ m) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) m (x c) →
      Ideal.Quotient.mk (wcGubIdl W A g ϖ c' ^ m) r' =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ c') m (x c') →
      ∃ t : ↥(wcGubBox W A g c'),
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ k c' * (r : wcGubGen W A) -
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ k c * (r' : wcGubGen W A) =
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (t : wcGubGen W A)

def wcGubConst {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (g : Fin 2 → A) (ϖ : ↥W) (x : ∀ c : ↥W, wcGubCpl W A g ϖ c)
    (k : ↥W → ℕ) : Prop :=
  (∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → x c = 0) ∨
  (∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    x c = algebraMap A (wcGubCpl W A g ϖ c) (algebraMap ↥W A ϖ) ^ k c)

def wcGubChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {N : Scheme.{u}}
    (uN : N ⟶ Spec (.of ↥W)) (n : N) (f : Fin 2 → N.presheaf.stalk n) (A : Type u)
    [CommRing A] [Algebra ↥W A] (𝔪 : Ideal A) (g : Fin 2 → A)
    (φ : A →+* N.presheaf.stalk n) : Prop :=
  Function.Injective φ ∧ (∀ i, φ (g i) = f i) ∧
  𝔪 = Ideal.comap φ (IsLocalRing.maximalIdeal (N.presheaf.stalk n)) ∧
  (∀ s : N.presheaf.stalk n, ∃ a b : A, b ∉ 𝔪 ∧ φ b * s = φ a) ∧
  ∀ w : ↥W, φ (algebraMap ↥W A w) =
    ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uN.appTop ≫ N.presheaf.germ ⊤ n trivial).hom w
def nccwSm {X T : Scheme.{u}} (f : X ⟶ T) (x : X) : Prop :=
  ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ f)

def nccwXChain {N : Type*} (𝒦 : Set (Set N)) (Φ A B : Set N) : Prop :=
  ∃ (s : ℕ) (L : Fin s → Set N) (p : Fin (s + 1) → N),
    (∀ t, L t ∈ 𝒦 ∧ L t ⊆ Φ) ∧ (∀ t, p t ∈ Φ) ∧ p 0 ∈ A ∧ p (Fin.last s) ∈ B ∧
    ∀ t : Fin s, p t.castSucc ∈ L t ∧ p t.succ ∈ L t

noncomputable def nccwC {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {N : Scheme.{u}} (uN : N ⟶ Spec (.of R)) : Set (Set N) :=
  {L | IsClosed L ∧ IsIrreducible L ∧ L.Nontrivial ∧ L ⊆ ⇑uN ⁻¹' {IsLocalRing.closedPoint R}}

noncomputable def nccwKF {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {N S : Scheme.{u}} (uN : N ⟶ Spec (.of R)) (q : N ⟶ S) (zk : S) : Set (Set N) :=
  {L | L ∈ nccwC uN ∧ L ⊆ ⇑q ⁻¹' {zk}}

def nccwHor {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z S N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (q : N ⟶ S) {n : ℕ}
    (st : Fin n → (Spec (.of R) ⟶ N)) (y : N) : Prop :=
  (q ≫ ν ≫ u) y ≠ IsLocalRing.closedPoint R ∧
    ((∃ (i : Fin n) (p : Spec (.of R)), p ≠ IsLocalRing.closedPoint R ∧ y = st i p) ∨
      ¬ nccwSm u (ν (q y)))

noncomputable def nccwXs {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z S N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (q : N ⟶ S) {n : ℕ}
    (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) : Set (Set N) :=
  {J | IsClosed J ∧ IsIrreducible J ∧ ¬ J ⊆ ⇑q ⁻¹' {zk} ∧
    (J ∈ nccwC (q ≫ ν ≫ u) ∨ ∃ y, nccwHor u ν q st y ∧ J = closure {y})}

noncomputable def nccwEx {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z S N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (q : N ⟶ S) {n : ℕ}
    (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) : Set (Set N × N) :=
  {p | p.1 ∈ nccwXs u ν q st zk ∧ p.2 ∈ p.1 ∧ p.2 ∈ ⇑q ⁻¹' {zk}}

open Classical in
noncomputable def nccwDt {P Z' N : Scheme.{u}} (f : P ⟶ Z') (η : Z' → N) (X : Set P) : Set N :=
  if hX : ∃ x : P, closure {x} = X then closure {η (f hX.choose)} else ∅

noncomputable def nccwEE (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z' N S : Scheme.{u}} (u' : Z' ⟶ Spec (.of R)) (η : Z' → N) (q : N ⟶ S) (zk : S) :
    Set (Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) :=
  {X | X ∈ irreducibleComponents
      ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) ∧
    nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) η X ⊆
      ⇑q ⁻¹' {zk}}

noncomputable def nccwEint (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z Z' N S S' : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (ν : S ⟶ Z)
    (ν' : S' ⟶ Z') (q : N ⟶ S) (q' : N ⟶ S') (zk : S) (η : Z' → N) :
    Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) :=
  {x | ¬ nccwSm u' (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) ∧
    IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk
      (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x)))
      (Z'.presheaf.stalk
        (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x))) ∧
    ∃ X₁ X₂, X₁ ∈ nccwEE R u' η q zk ∧ X₂ ∈ nccwEE R u' η q zk ∧ X₁ ≠ X₂ ∧ x ∈ X₁ ∧ x ∈ X₂ ∧
      ∃ w : S', ν' w =
          Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x ∧
        nccwXChain (nccwKF (q ≫ ν ≫ u) q zk) (⇑q' ⁻¹' {w})
          (nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
            η X₁)
          (nccwDt (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
            η X₂)}

def nccwSN (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {Z' : Scheme.{u}}
    (u' : Z' ⟶ Spec (.of R))
    (X : Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) : Prop :=
  ∃ x ∈ X, x ∉ closure Xᶜ ∧
    ¬ nccwSm u' (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x)
open Classical in
noncomputable def nccwSN2 (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z' : Scheme.{u}} (u' : Z' ⟶ Spec (.of R))
    (X : Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) : ℕ :=
  if nccwSN R u' X then 2 else 0

def nccwProps.{v} : Prop :=
  wcpaDjNcForest.{v} ∧ wcpaDjNcLocStr.{v} ∧ wcpaDjNcFibConn.{v} ∧ wcpaDjNcGenIso.{v} ∧
    wcpaDjNccNagata.{v} ∧ wcpaDjNccExcellent.{v} ∧ wcpaDjNccChain.{v}

def nccwF2 {N : Type*} (𝒦 : Set (Set N)) : Prop :=
  ∀ (m : ℕ) (E : Fin (m + 2) → Set N) (p : Fin (m + 2) → N),
    (∀ i, E i ∈ 𝒦) → Function.Injective E → Function.Injective p →
    (∀ i, p i ∈ E i ∧ p i ∈ E (finRotate (m + 2) i)) → False

def nccwF1 (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {N S : Scheme.{u}}
    (uN : N ⟶ Spec (.of R)) (q : N ⟶ S) (zk : S) : Prop :=
  ∀ L ∈ nccwKF uN q zk, ∃ (Er : Scheme.{u}) (ι : Er ⟶ N)
    (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2)
      (IsLocalRing.ResidueField R)) MvPolynomial.gradedAlgebra),
    IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced Er ∧ Set.range ⇑ι = L ∧
    θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2)
        (IsLocalRing.ResidueField R)) MvPolynomial.gradedAlgebra ≫
      Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField R)
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField R) 0))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) = ι ≫ uN

def nccwH (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z Z' Y G : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) {n : ℕ}
    (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z'))
    (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u')
    (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) : Prop :=
  3 ≤ n ∧ wcpaDjStablePtd u n τ ∧ wcpaDjStablePtd u' n τ' ∧ GeometricallyConnected u ∧
  GeometricallyConnected u' ∧
  IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ∧
  IsPullback a' π u' (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ∧
  (∀ i, ∃ t : Spec (.of (FractionRing R)) ⟶ Y, t ≫ π = 𝟙 _ ∧
    t ≫ a = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τ i ∧
    t ≫ a' = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τ' i) ∧
  IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced G ∧ IsOpenImmersion j ∧
  Dense (Set.range ⇑j) ∧ j ≫ ι = Limits.pullback.lift a a' h ∧
  (∀ γ₀ : G, (ι ≫ Limits.pullback.fst u u') γ₀ ∈ Set.range ⇑a → γ₀ ∈ Set.range ⇑j) ∧
  γ' ⤳ γ ∧ γ' ≠ γ ∧
  (ι ≫ Limits.pullback.fst u u') γ' = (ι ≫ Limits.pullback.fst u u') γ ∧
  u ((ι ≫ Limits.pullback.fst u u') γ) = IsLocalRing.closedPoint R ∧
  IsClosed ({(ι ≫ Limits.pullback.fst u u') γ} : Set Z) ∧
  (∀ x : Z', u' x = IsLocalRing.closedPoint R → x ⤳ (ι ≫ Limits.pullback.snd u u') γ' →
    x = (ι ≫ Limits.pullback.snd u u') γ')

def nccwSetup (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z Z' G S S' N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) {n : ℕ}
    (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z'))
    (ι : G ⟶ Limits.pullback u u') (γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G)
    (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N)
    (η : Z' → N) (ηZ : Z → N) : Prop :=

  (q ≫ ν = μ ≫ ι ≫ Limits.pullback.fst u u' ∧ q' ≫ ν' = μ ≫ ι ≫ Limits.pullback.snd u u') ∧

  (IsFinite ν ∧ IsFinite ν' ∧ IsFinite μ ∧ Surjective ν ∧ Surjective ν' ∧ Surjective μ) ∧

  ((∀ x : S, IsDomain (S.presheaf.stalk x) ∧ IsIntegrallyClosed (S.presheaf.stalk x)) ∧
    (∀ x : S', IsDomain (S'.presheaf.stalk x) ∧ IsIntegrallyClosed (S'.presheaf.stalk x)) ∧
    (∀ x : N, IsDomain (N.presheaf.stalk x) ∧ IsIntegrallyClosed (N.presheaf.stalk x))) ∧

  (Flat (ν ≫ u) ∧ LocallyOfFiniteType (ν ≫ u) ∧ Flat (ν' ≫ u') ∧
    LocallyOfFiniteType (ν' ≫ u') ∧ Flat (q ≫ ν ≫ u) ∧ LocallyOfFiniteType (q ≫ ν ≫ u)) ∧

  (IsProper q ∧ IsProper q') ∧

  ((∃ V : S.Opens, (∀ s : S, (ν ≫ u) s ≠ IsLocalRing.closedPoint R → s ∈ V) ∧
      IsIso (q ∣_ V)) ∧
    (∃ V : S'.Opens, (∀ s : S', (ν' ≫ u') s ≠ IsLocalRing.closedPoint R → s ∈ V) ∧
      IsIso (q' ∣_ V))) ∧

  (ν zk = (ι ≫ Limits.pullback.fst u u') γ' ∧
    (q ≫ ν ≫ u) η₀ = IsLocalRing.closedPoint R ∧
    (∀ y : N, (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R → y ⤳ η₀ → y = η₀) ∧
    (∀ y : N, η₀ ⤳ y → q y = zk) ∧
    ν' (q' η₀) = (ι ≫ Limits.pullback.snd u u') γ') ∧

  (∀ ξ : Z', u' ξ = IsLocalRing.closedPoint R →
    (∀ x : Z', u' x = IsLocalRing.closedPoint R → x ⤳ ξ → x = ξ) →
    (q ≫ ν ≫ u) (η ξ) = IsLocalRing.closedPoint R ∧ ν' (q' (η ξ)) = ξ ∧
    (∀ y : N, (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R → y ⤳ η ξ → y = η ξ) ∧
    (∀ y : N, (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R →
      (∀ y' : N, (q ≫ ν ≫ u) y' = IsLocalRing.closedPoint R → y' ⤳ y → y' = y) →
      ν' (q' y) = ξ → y = η ξ) ∧
    (∀ w : S', ν' w = ξ → w = q' (η ξ)) ∧
    (∃ W : S'.Opens, q' (η ξ) ∈ W ∧ IsIso (q' ∣_ W)) ∧
    closure {η ξ} ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} ∧
    (closure {η ξ}).Nontrivial) ∧

  (∀ ξ : Z, u ξ = IsLocalRing.closedPoint R →
    (∀ x : Z, u x = IsLocalRing.closedPoint R → x ⤳ ξ → x = ξ) →
    (q ≫ ν ≫ u) (ηZ ξ) = IsLocalRing.closedPoint R ∧ ν (q (ηZ ξ)) = ξ ∧
    (∀ y : N, (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R → y ⤳ ηZ ξ → y = ηZ ξ) ∧
    (∀ y : N, (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R →
      (∀ y' : N, (q ≫ ν ≫ u) y' = IsLocalRing.closedPoint R → y' ⤳ y → y' = y) →
      ν (q y) = ξ → y = ηZ ξ) ∧
    (∀ w : S, ν w = ξ → w = q (ηZ ξ)) ∧
    (∃ W : S.Opens, q (ηZ ξ) ∈ W ∧ IsIso (q ∣_ W)) ∧
    closure {ηZ ξ} ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} ∧
    (closure {ηZ ξ}).Nontrivial) ∧

  (∀ i, st i ≫ q ≫ ν = τ i ∧ st i ≫ q' ≫ ν' = τ' i) ∧

  (TopologicalSpace.NoetherianSpace ↥(⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) ∧
    TopologicalSpace.NoetherianSpace ↥(⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) ∧
    TopologicalSpace.NoetherianSpace ↥(⇑(ν' ≫ u') ⁻¹' {IsLocalRing.closedPoint R}) ∧
    (∀ L : Set N, IsClosed L → IsIrreducible L →
      L ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} → L.Nontrivial →
      ∀ L' : Set N, IsIrreducible L' → L ⊆ L' →
        L' ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} → L' = L) ∧
    (∀ L : Set N, IsClosed L → IsIrreducible L →
      L ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} →
      (∀ L' : Set N, IsIrreducible L' → L ⊆ L' →
        L' ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} → L' = L) → L.Nontrivial) ∧
    (∀ L : Set S, IsClosed L → IsIrreducible L →
      L ⊆ ⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} → L.Nontrivial →
      ∀ L' : Set S, IsIrreducible L' → L ⊆ L' →
        L' ⊆ ⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} → L' = L) ∧
    (∀ L : Set S, IsClosed L → IsIrreducible L →
      L ⊆ ⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} →
      (∀ L' : Set S, IsIrreducible L' → L ⊆ L' →
        L' ⊆ ⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} → L' = L) → L.Nontrivial)) ∧

  (∀ y : N, (q ≫ ν ≫ u) y ≠ IsLocalRing.closedPoint R →
    (nccwSm u (ν (q y)) ↔ nccwSm u' (ν' (q' y)))) ∧

  ((∀ x : Z', IsDomain (Z'.presheaf.stalk x) → IsIntegrallyClosed (Z'.presheaf.stalk x) →
      ∃ w : S', (∀ w' : S', ν' w' = x ↔ w' = w) ∧ IsIso (ν'.stalkMap w)) ∧
    (∀ x : Z, IsDomain (Z.presheaf.stalk x) → IsIntegrallyClosed (Z.presheaf.stalk x) →
      ∃ w : S, (∀ w' : S, ν w' = x ↔ w' = w) ∧ IsIso (ν.stalkMap w)))

def nccwAll (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z Z' Y G S S' N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) {n : ℕ}
    (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z'))
    (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u')
    (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z')
    (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S)
    (η₀ : N) (η : Z' → N) (ηZ : Z → N) : Prop :=
  IsAdicComplete (IsLocalRing.maximalIdeal R) R ∧ IsAlgClosed (IsLocalRing.ResidueField R) ∧
    nccwProps.{u} ∧ nccwH R u u' τ τ' π a a' h ι j γ γ' ∧
    nccwSetup R u u' τ τ' ι γ' ν ν' μ q q' st zk η₀ η ηZ
noncomputable def fexrLam (S : Type u) [CommRing S] (I : Ideal S) : ℕ∞ :=
  sInf {n : ℕ∞ | ∃ (c : S) (J' : Ideal S), I = Ideal.span {c} * J' ∧ Module.length S (S ⧸ J') = n}

noncomputable def fexrLamAt {B : Type u} [CommRing B] {m : ℕ} (J : Fin m → Ideal B)
    {Y : Scheme.{u}} (g : Y ⟶ Spec (.of B)) (l : Fin m) (y : Y) : ℕ∞ :=
  fexrLam (Y.presheaf.stalk y) (Ideal.map (wcNdSig g y) (J l))
def wcpaDjRtsxcModelOut (B : Type u) [CommRing B] [IsLocalRing B] {n : ℕ} (τ : Fin n → B) (γ : B)
    (T : Finset (Fin n)) (b : Fin n → ℕ) : Prop :=
  algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ ∈
      nonZeroDivisors (AdicCompletion (IsLocalRing.maximalIdeal B) B) ∧
  ((∃ (n' : ℕ) (s : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal B) B)
      (κ : Fin n → Finset (Fin n')) (e₀ : Fin n'),
      (n' : WithBot ℕ∞) = ringKrullDim B ∧
      Ideal.span (Set.range s) = Ideal.map (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B))
        (IsLocalRing.maximalIdeal B) ∧
      Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ) (s e₀) ∧
      (∀ l, (κ l).card ≤ 1 ∧ e₀ ∉ κ l) ∧
      (∀ l l', l ≠ l' → Disjoint (κ l) (κ l')) ∧
      (∀ l, l ∉ T → Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l))
        (∏ c ∈ κ l, s c)) ∧
      (∀ l, l ∈ T → Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l))
        (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ * ∏ c ∈ κ l, s c))) ∨
   (∃ (n' : ℕ) (A' : Type u) (_ : CommRing A') (_ : IsRegularLocalRing A')
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal A') A')
      (x' y' v' : A') (σ' : Fin n' → A') (b' : Fin n' → ℕ)
      (e' : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
        (A' ⧸ Ideal.span {x' * y' - v' * ∏ c, σ' c ^ b' c}))
      (κ : Fin n → Finset (Fin n')) (e₀ : Fin n'),
      IsUnit v' ∧ ((n' + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A' ∧
      Ideal.span ({x', y'} ∪ Set.range σ') = IsLocalRing.maximalIdeal A' ∧
      Associated (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ))
        (Ideal.Quotient.mk _ (σ' e₀)) ∧
      (∀ l, (κ l).card ≤ 1 ∧ e₀ ∉ κ l) ∧
      (∀ l l', l ≠ l' → Disjoint (κ l) (κ l')) ∧
      (∀ l, l ∉ T → Associated (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l)))
        (Ideal.Quotient.mk _ (∏ c ∈ κ l, σ' c))) ∧
      (∀ l, l ∈ T → Associated (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l)))
        (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ) *
          Ideal.Quotient.mk _ (∏ c ∈ κ l, σ' c))) ∧
      (∀ c, b' c ≠ 0 → c = e₀ ∨ ∃ l, c ∈ κ l ∧ (l ∈ T ∨ b l ≠ 0))))

def wcpaDjRtsxcChartOut (R : Type u) [CommRing R] {m n : ℕ} (G : Fin (m + 1) → R)
    (τ : Fin n → R) (T : Finset (Fin n)) (b : Fin n → ℕ) : Prop :=
  ∀ (j : Fin (m + 1)) (𝔔 : Ideal (wcpaDjChartAlg R G j)) [𝔔.IsPrime],
    (∀ c, algebraMap R (wcpaDjChartAlg R G j) c ∈ 𝔔 ↔ ¬ IsUnit c) →
    wcpaDjRtsxcModelOut (Localization.AtPrime 𝔔)
      (fun l => ((algebraMap (wcpaDjChartAlg R G j) (Localization.AtPrime 𝔔)).comp
        (algebraMap R (wcpaDjChartAlg R G j))) (τ l))
      (((algebraMap (wcpaDjChartAlg R G j) (Localization.AtPrime 𝔔)).comp
        (algebraMap R (wcpaDjChartAlg R G j))) (G j)) T b

def wcpaDjRtsxcTransOut (O D B : Type u) [CommRing O] [CommRing D] [IsLocalRing D] [CommRing B]
    [IsLocalRing B] (φ : O →+* D) (κ : O →+* B) (ε : D) (g : B) : Prop :=
  ∃ Ψ : AdicCompletion (IsLocalRing.maximalIdeal D) D ≃+* AdicCompletion (IsLocalRing.maximalIdeal B) B,
    ringKrullDim D = ringKrullDim B ∧
    Ideal.map Ψ (Ideal.map (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D))
        (IsLocalRing.maximalIdeal D)) =
      Ideal.map (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B))
        (IsLocalRing.maximalIdeal B) ∧
    (∀ a, Ψ (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D) (φ a)) =
      algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (κ a)) ∧
    Associated (Ψ (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D) ε))
      (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) g)
def wcpaDjLcB (A : Type u) [CommRing A] (h : A) : Type u :=
  MvPolynomial (Fin 2) A ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}

noncomputable instance wcpaDjLcB.instCommRing (A : Type u) [CommRing A] (h : A) :
    CommRing (wcpaDjLcB A h) :=
  inferInstanceAs (CommRing (MvPolynomial (Fin 2) A ⧸
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}))

noncomputable instance wcpaDjLcB.instAlgebra (A : Type u) [CommRing A] (h : A) :
    Algebra A (wcpaDjLcB A h) :=
  inferInstanceAs (Algebra A (MvPolynomial (Fin 2) A ⧸
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}))


noncomputable abbrev wcpaDjLcBMap (O₀ : Type u) [CommRing O₀] [IsLocalRing O₀]
    (h : AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀)
    (𝔭 : Ideal (wcpaDjLcB (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀) h)) [𝔭.IsPrime] :
    O₀ →+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭))
      (Localization.AtPrime 𝔭) :=
  (algebraMap (Localization.AtPrime 𝔭) (AdicCompletion
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) (Localization.AtPrime 𝔭))).comp
    ((algebraMap (wcpaDjLcB (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀) h)
        (Localization.AtPrime 𝔭)).comp
      ((algebraMap (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀)
          (wcpaDjLcB (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀) h)).comp
        (algebraMap O₀ (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀))))
noncomputable def nccwEbExV {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z S N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (q : N ⟶ S) {n : ℕ}
    (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) : Set (Set N × N) :=
  {p | p ∈ nccwEx u ν q st zk ∧ p.1 ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}}

noncomputable def nccwEbExS {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z S N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (q : N ⟶ S) {n : ℕ}
    (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) : Set (Set N × N) :=
  {p | p ∈ nccwEx u ν q st zk ∧ ∃ (i : Fin n) (p₀ : Spec (.of R)),
    p₀ ≠ IsLocalRing.closedPoint R ∧ p.1 = closure {st i p₀}}

noncomputable def nccwEbExH {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {Z S N : Scheme.{u}} (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (q : N ⟶ S) {n : ℕ}
    (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) : Set (Set N × N) :=
  {p | p ∈ nccwEx u ν q st zk ∧ ∃ y : N, (q ≫ ν ≫ u) y ≠ IsLocalRing.closedPoint R ∧
    ¬ nccwSm u (ν (q y)) ∧ p.1 = closure {y}}

noncomputable def nccwEbSig (R : Type u) [CommRing R] {Z S : Scheme.{u}} (u : Z ⟶ Spec (.of R))
    (ν : S ⟶ Z) (zk : S) :
    R →+* AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk) :=
  (algebraMap (S.presheaf.stalk zk)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))).comp
    ((Scheme.ΓSpecIso (.of R)).inv ≫ (ν ≫ u).appTop ≫ S.presheaf.germ ⊤ zk trivial).hom

noncomputable def nccwEbBv (R : Type u) [CommRing R] [IsLocalRing R] {Z S : Scheme.{u}}
    (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (zk : S) :
    Set (PrimeSpectrum
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))) :=
  {β | (∃ a ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk zk),
      algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) a ∉
        β.asIdeal) ∧
    ∀ r ∈ IsLocalRing.maximalIdeal R, nccwEbSig R u ν zk r ∈ β.asIdeal}

noncomputable def nccwEbBh (R : Type u) [CommRing R] [IsLocalRing R] {Z S : Scheme.{u}}
    (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (zk : S) :
    Set (PrimeSpectrum
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))) :=
  {β | (∃ a ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk zk),
      algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) a ∉
        β.asIdeal) ∧
    (∃ r ∈ IsLocalRing.maximalIdeal R, nccwEbSig R u ν zk r ∉ β.asIdeal) ∧
    ¬ nccwSm u (ν (S.fromSpecStalk zk (PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))) β)))}
noncomputable def wcpaDjChartGen (O : Type u) [CommRing O] {r : ℕ} (f : Fin (r + 1) → O)
    (i l : Fin (r + 1)) : wcpaDjChartAlg O f i :=
  ⟨IsLocalization.mk' _ (f l) ⟨f i, Submonoid.mem_powers _⟩, Algebra.subset_adjoin ⟨l, rfl⟩⟩
noncomputable abbrev nccwffSig {B : Type u} [CommRing B] {X : Scheme.{u}} (h : X ⟶ Spec (.of B))
    (x : X) :
    B →+* AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) :=
  (algebraMap (X.presheaf.stalk x)
    (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp
    ((X.presheaf.germ ⊤ x trivial).hom.comp (wcCnSigma h ⊤))

noncomputable def nccwffG {S : Scheme.{u}} (s : S) {A : Type u} [CommRing A]
    (e : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s) ≃+* A) :
    Spec (.of A) ⟶ S :=
  Spec.map (CommRingCat.ofHom (e.toRingHom.comp (algebraMap (S.presheaf.stalk s)
    (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))))) ≫
    S.fromSpecStalk s

abbrev nccwffQ (R : Type u) [CommRing R] (c : R) : Type u :=
  MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}

noncomputable abbrev nccwffPsi (R : Type u) [CommRing R] (c : R) : R →+* nccwffQ R c :=
  (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c} :
    Ideal (MvPowerSeries (Fin 2) R))).comp MvPowerSeries.C

def nccwffRingOK (A : Type u) [CommRing A] : Prop :=
  IsRegularLocalRing A ∨ ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R)
    (_ : IsDiscreteValuationRing R) (c : R), c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal R ∧
    IsAdicComplete (IsLocalRing.maximalIdeal R) R ∧
    Nonempty (A ≃+* (MvPowerSeries (Fin 2) R ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}))

def nccwffForestOut (A : Type u) [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) : Prop :=
  (∀ E : Set X, wcpaDjNcFibComp (⇑f ⁻¹' {IsLocalRing.closedPoint A}) E → E.Nontrivial →
    ∃ (Er : Scheme.{u}) (ι : Er ⟶ X)
      (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2)
        (IsLocalRing.ResidueField A)) MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced Er ∧ Set.range ⇑ι = E ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2)
          (IsLocalRing.ResidueField A)) MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
          ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField A) 0))) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) = ι ≫ f) ∧
  ∀ (m : ℕ) (E : Fin (m + 2) → Set X) (p : Fin (m + 2) → X),
    (∀ i, wcpaDjNcFibComp (⇑f ⁻¹' {IsLocalRing.closedPoint A}) (E i)) →
    Function.Injective E → Function.Injective p →
    (∀ i, p i ∈ E i ∧ p i ∈ E (finRotate (m + 2) i)) → False
noncomputable abbrev fexaAA (R : Type u) [CommRing R] (ϖ : R) (n : ℕ) : Type u :=
  MvPowerSeries (Fin 2) R ⧸
    Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)}

noncomputable abbrev fexaX (R : Type u) [CommRing R] (ϖ : R) (n : ℕ) : fexaAA R ϖ n :=
  Ideal.Quotient.mk _ (MvPowerSeries.X 0)

noncomputable abbrev fexaY (R : Type u) [CommRing R] (ϖ : R) (n : ℕ) : fexaAA R ϖ n :=
  Ideal.Quotient.mk _ (MvPowerSeries.X 1)

noncomputable abbrev fexaW (R : Type u) [CommRing R] (ϖ : R) (n : ℕ) : fexaAA R ϖ n :=
  Ideal.Quotient.mk _ (MvPowerSeries.C ϖ)

noncomputable def fexaAlpha {A : Type u} [CommRing A] (x w : A) (i : ℕ) : Localization.Away w :=
  algebraMap A _ x * Localization.Away.invSelf w ^ i

noncomputable def fexaBeta {A : Type u} [CommRing A] (y w : A) (n i : ℕ) : Localization.Away w :=
  algebraMap A _ y * Localization.Away.invSelf w ^ (n - 1 - i)

noncomputable def fexaP {A : Type u} [CommRing A] (x y w : A) (n : ℕ) (T : Finset (Fin n)) :
    Subalgebra A (Localization.Away w) :=
  Algebra.adjoin A (⋃ i ∈ T, ({fexaAlpha x w i, fexaBeta y w n i} : Set (Localization.Away w)))

noncomputable def fexaAlphaP {A : Type u} [CommRing A] (x y w : A) (n : ℕ) (i : Fin n) :
    ↥(fexaP x y w n {i}) :=
  ⟨fexaAlpha x w i, Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨i, Finset.mem_singleton_self i,
    Set.mem_insert _ _⟩)⟩

noncomputable def fexaBetaP {A : Type u} [CommRing A] (x y w : A) (n : ℕ) (i : Fin n) :
    ↥(fexaP x y w n {i}) :=
  ⟨fexaBeta y w n i, Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨i, Finset.mem_singleton_self i,
    Set.mem_insert_of_mem _ (Set.mem_singleton _)⟩)⟩

noncomputable def fexaIncl {A : Type u} [CommRing A] (x y w : A) (n : ℕ) {T T' : Finset (Fin n)}
    (h : T ⊆ T') :
    CommRingCat.of ↥(fexaP x y w n T) ⟶ CommRingCat.of ↥(fexaP x y w n T') :=
  CommRingCat.ofHom (Subalgebra.inclusion (Algebra.adjoin_mono (fun z hz => by
    obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
    exact Set.mem_iUnion₂.mpr ⟨i, h hi, hz⟩))).toRingHom

def fexaG {A : Type u} [CommRing A] (x w : A) (n i : ℕ) : A :=
  x ^ (n - 1 - i) * w ^ (i * (i + 1) / 2)

noncomputable def fexaT {A : Type u} [CommRing A] (x y w : A) (n i j : ℕ) : Localization.Away w :=
  if i ≤ j then ∏ k ∈ Finset.Ico i j, fexaBeta y w n k else ∏ k ∈ Finset.Ioc j i, fexaAlpha x w k

def fexaGlued {A : Type u} [CommRing A] (x y w : A) (n : ℕ) (Y : Scheme.{u})
    (ι : ∀ T : Finset (Fin n), T.Nonempty → (Spec (CommRingCat.of ↥(fexaP x y w n T)) ⟶ Y))
    (ρ : Y ⟶ Spec (CommRingCat.of A)) : Prop :=
  (∀ (T T' : Finset (Fin n)) (h : T ⊆ T') (hT : T.Nonempty),
      Spec.map (fexaIncl x y w n h) ≫ ι T hT = ι T' (Finset.Nonempty.mono h hT)) ∧
  (∀ (T : Finset (Fin n)) (hT : T.Nonempty), IsOpenImmersion (ι T hT)) ∧
  (∀ z : Y, ∃ (a : Fin n) (p : Spec (CommRingCat.of ↥(fexaP x y w n {a}))),
      ι {a} (Finset.singleton_nonempty a) p = z) ∧
  (∀ (T1 T2 : Finset (Fin n)) (h1 : T1.Nonempty) (h2 : T2.Nonempty)
      (p1 : Spec (CommRingCat.of ↥(fexaP x y w n T1)))
      (p2 : Spec (CommRingCat.of ↥(fexaP x y w n T2))),
      ι T1 h1 p1 = ι T2 h2 p2 → ∃ p : Spec (CommRingCat.of ↥(fexaP x y w n (T1 ∪ T2))),
        Spec.map (fexaIncl x y w n Finset.subset_union_left) p = p1 ∧
        Spec.map (fexaIncl x y w n Finset.subset_union_right) p = p2) ∧
  (∀ (T : Finset (Fin n)) (hT : T.Nonempty),
      ι T hT ≫ ρ = Spec.map (CommRingCat.ofHom (algebraMap A ↥(fexaP x y w n T))))
noncomputable def wcpaMmsG (K : Type u) [Field K] (n : ℕ) (b : Fin n → ℕ) :
    MvPowerSeries (Fin 2) (MvPowerSeries (Fin n) K) :=
  MvPowerSeries.X 0 * MvPowerSeries.X 1 - 1 * ∏ l, (MvPowerSeries.C (MvPowerSeries.X l) :
    MvPowerSeries (Fin 2) (MvPowerSeries (Fin n) K)) ^ b l

noncomputable def wcpaMmsP (K : Type u) [Field K] (n : ℕ) (T : Finset (Fin n)) :
    Ideal (MvPowerSeries (Fin 2) (MvPowerSeries (Fin n) K)) :=
  Ideal.span ({MvPowerSeries.X 0, MvPowerSeries.X 1} ∪ (fun l => (MvPowerSeries.C (MvPowerSeries.X l) :
    MvPowerSeries (Fin 2) (MvPowerSeries (Fin n) K))) '' (T : Set (Fin n)))
abbrev wcpaDjP1Ring (A : Type u) [CommRing A] {n : ℕ} (x y v : A) (σ : Fin n → A)
    (b : Fin n → ℕ) : Type u :=
  A ⧸ Ideal.span {x * y - v * ∏ m, σ m ^ b m}


abbrev wcpaDjP1Gen (A : Type u) [CommRing A] {n : ℕ} (x y v : A) (σ : Fin n → A)
    (b : Fin n → ℕ) (l : Fin n) : Fin (2 + 1) → wcpaDjP1Ring A x y v σ b :=
  ![Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) x,
    Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) y,
    Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) (σ l)]


def wcpaDjRtsxcPt (B : Type u) [CommRing B] [IsLocalRing B] {n : ℕ} (τ : Fin n → B) (γ : B)
    (T : Finset (Fin n)) : Prop :=
  ∃ (n' : ℕ) (s : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal B) B)
      (κ : Fin n → Finset (Fin n')) (e₀ : Fin n'),
      (n' : WithBot ℕ∞) = ringKrullDim B ∧
      Ideal.span (Set.range s) = Ideal.map (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B))
        (IsLocalRing.maximalIdeal B) ∧
      Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ) (s e₀) ∧
      (∀ l, (κ l).card ≤ 1 ∧ e₀ ∉ κ l) ∧
      (∀ l l', l ≠ l' → Disjoint (κ l) (κ l')) ∧
      (∀ l, l ∉ T → Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l))
        (∏ c ∈ κ l, s c)) ∧
      (∀ l, l ∈ T → Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l))
        (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ * ∏ c ∈ κ l, s c))


def wcpaDjRtsxcNd (B : Type u) [CommRing B] [IsLocalRing B] {n : ℕ} (τ : Fin n → B) (γ : B)
    (T : Finset (Fin n)) (b : Fin n → ℕ) : Prop :=
  ∃ (n' : ℕ) (A' : Type u) (_ : CommRing A') (_ : IsRegularLocalRing A')
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal A') A')
      (x' y' v' : A') (σ' : Fin n' → A') (b' : Fin n' → ℕ)
      (e' : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
        (A' ⧸ Ideal.span {x' * y' - v' * ∏ c, σ' c ^ b' c}))
      (κ : Fin n → Finset (Fin n')) (e₀ : Fin n'),
      IsUnit v' ∧ ((n' + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A' ∧
      Ideal.span ({x', y'} ∪ Set.range σ') = IsLocalRing.maximalIdeal A' ∧
      Associated (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ))
        (Ideal.Quotient.mk _ (σ' e₀)) ∧
      (∀ l, (κ l).card ≤ 1 ∧ e₀ ∉ κ l) ∧
      (∀ l l', l ≠ l' → Disjoint (κ l) (κ l')) ∧
      (∀ l, l ∉ T → Associated (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l)))
        (Ideal.Quotient.mk _ (∏ c ∈ κ l, σ' c))) ∧
      (∀ l, l ∈ T → Associated (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ l)))
        (e' (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) γ) *
          Ideal.Quotient.mk _ (∏ c ∈ κ l, σ' c))) ∧
      (∀ c, b' c ≠ 0 → c = e₀ ∨ ∃ l, c ∈ κ l ∧ (l ∈ T ∨ b l ≠ 0))
abbrev wcGubBx {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {C N : Scheme.{u}}
    [AlgebraicGeometry.IsIntegral C] (sC : C ⟶ Spec (.of Ω)) (t : C ⟶ N) (p : N)
    (f : Fin 2 → N.presheaf.stalk p) (c : Ω) (V : ValuationSubring C.functionField) : Prop :=
  wcUbRigid W sC V ∧ wcNsrCentred t p V ∧ wcTcBox sC t p f c V
abbrev wcpaDjP2Gen (A : Type u) [CommRing A] {n : ℕ} (x y v : A) (σ : Fin n → A)
    (b : Fin n → ℕ) (l l' : Fin n) : Fin (3 + 1) → wcpaDjP1Ring A x y v σ b :=
  ![Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) x,
    Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) y,
    Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) (σ l),
    Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ m, σ m ^ b m}) (σ l')]
noncomputable def wcpaDjTcIncl (R : Type u) [CommRing R] {N : ℕ} (F : Fin (N + 1) → R)
    (k₀ : Fin (N + 1)) (T : Subalgebra R (Localization.Away (F k₀)))
    (hT : ∀ z ∈ T, z ∈ integralClosure (wcpaDjChart R F k₀) (Localization.Away (F k₀))) :
    T →+* wcpaDjGltNC R F k₀ where
  toFun z := (⟨z.1, hT z.1 z.2⟩ : integralClosure (wcpaDjChart R F k₀) (Localization.Away (F k₀)))
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl


noncomputable abbrev wcpaDjLcBX (A : Type u) [CommRing A] (h : A) (i : Fin 2) : wcpaDjLcB A h :=
  Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})
    (MvPolynomial.X i)
def wcBffBase {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ϖ : ↥W) : Prop :=
  ϖ ≠ 0 ∧ ϖ ∈ IsLocalRing.maximalIdeal ↥W ∧
  IsDomain A ∧ IsIntegrallyClosed A ∧ Algebra.FinitePresentation ↥W A ∧
  (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) ∧
  (∀ (a : A) (j : ℕ), a ^ j ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
  ringKrullDim (wcGubGen W A) ≤ 1

def wcBffNoether {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ζ : A) : Prop :=
  ∃ (n : ℕ) (s : Fin n → A), ∀ a : A, ∃ p : Fin n → Polynomial ↥W,
    a - ∑ i, Polynomial.aeval ζ (p i) * s i ∈
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)

def wcBffRep {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ϖ : ↥W) (J : Ideal A) (g : Fin 2 → A) (y : AdicCompletion J A)
    (x : ∀ c : ↥W, wcGubCpl W A g ϖ c) (k : ↥W → ℕ) : Prop :=
  ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ m : ℕ, ∃ n : ℕ,
    ∀ (a : A) (r : ↥(wcGubBox W A g c)),
      Ideal.Quotient.mk (J ^ n) a = AdicCompletion.evalₐ J n y →
      Ideal.Quotient.mk (wcGubIdl W A g ϖ c ^ m) r =
        AdicCompletion.evalₐ (wcGubIdl W A g ϖ c) m (x c) →
      ∃ t : ↥(wcGubBox W A g c),
        algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ k c * algebraMap A (wcGubGen W A) a -
            (r : wcGubGen W A) =
          algebraMap A (wcGubGen W A) (algebraMap ↥W A ϖ) ^ m * (t : wcGubGen W A)
abbrev nccwsuNDS (X : Scheme.{u}) : Prop :=
  ∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)

abbrev nccwsuNL {X Y : Scheme.{u}} (f : X ⟶ Y) : Prop :=
  ∀ y : Y, IsDomain (Y.presheaf.stalk y) → IsIntegrallyClosed (Y.presheaf.stalk y) →
    ∃ w : X, (∀ w' : X, f w' = y ↔ w' = w) ∧ IsIso (f.stalkMap w)

abbrev nccwsuGP {X : Scheme.{u}} (x : X) : Prop := ∀ x' : X, x' ⤳ x → x' = x

abbrev nccwsuGEN {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (v : X ⟶ Spec (.of R)) : Prop :=
  ∀ x : X, ∃ x' : X, x' ⤳ x ∧ v x' ≠ IsLocalRing.closedPoint R

abbrev nccwsuMaxS {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (v : X ⟶ Spec (.of R)) (x : X) : Prop :=
  v x = IsLocalRing.closedPoint R ∧
    ∀ x' : X, v x' = IsLocalRing.closedPoint R → x' ⤳ x → x' = x

abbrev nccwsuH1 {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (v : X ⟶ Spec (.of R)) : Prop :=
  ∀ x₀ x₁ x₂ : X, v x₂ ≠ IsLocalRing.closedPoint R → x₀ ⤳ x₁ → x₁ ⤳ x₂ → x₀ = x₁ ∨ x₁ = x₂

abbrev nccwsuH2 {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (v : X ⟶ Spec (.of R)) : Prop :=
  ∀ x : X, v x ≠ IsLocalRing.closedPoint R → nccwsuGP x → ∀ U : X.Opens, x ∈ U →
    ∃ x' ∈ U, v x' ≠ IsLocalRing.closedPoint R ∧ x ⤳ x' ∧ x' ≠ x

abbrev nccwsuP10 {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (v : X ⟶ Spec (.of R)) : Prop :=
  TopologicalSpace.NoetherianSpace ↥(⇑v ⁻¹' {IsLocalRing.closedPoint R}) ∧
  (∀ L : Set X, IsClosed L → IsIrreducible L → L ⊆ ⇑v ⁻¹' {IsLocalRing.closedPoint R} →
    L.Nontrivial → ∀ L' : Set X, IsIrreducible L' → L ⊆ L' →
      L' ⊆ ⇑v ⁻¹' {IsLocalRing.closedPoint R} → L' = L) ∧
  (∀ L : Set X, IsClosed L → IsIrreducible L → L ⊆ ⇑v ⁻¹' {IsLocalRing.closedPoint R} →
    (∀ L' : Set X, IsIrreducible L' → L ⊆ L' →
      L' ⊆ ⇑v ⁻¹' {IsLocalRing.closedPoint R} → L' = L) → L.Nontrivial)

def nccwsuDimFact.{w} : Prop :=
  ∀ (R : Type w) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ →
    ∀ (B : Type w) [CommRing B] [IsDomain B] [Algebra R B], Algebra.FiniteType R B →
    algebraMap R B ϖ ≠ 0 → ringKrullDim (Localization.Away (algebraMap R B ϖ)) = 1 →
    (∀ P₀ P₁ P₂ : Ideal B, P₀.IsPrime → P₁.IsPrime → P₂.IsPrime → algebraMap R B ϖ ∈ P₀ →
      P₀ ≤ P₁ → P₁ ≤ P₂ → P₀ = P₁ ∨ P₁ = P₂) ∧
    (∀ P ∈ (Ideal.span {algebraMap R B ϖ}).minimalPrimes, ¬ P.IsMaximal)

abbrev nccwsuBir {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {N X : Scheme.{u}} (w : X ⟶ Spec (.of R)) (φ : N ⟶ X) : Prop :=
  Surjective φ ∧
  (∃ V : X.Opens, (V : Set X) = (⇑w ⁻¹' {IsLocalRing.closedPoint R})ᶜ ∧ IsFinite (φ ∣_ V)) ∧
  (∀ y : N, nccwsuGP y → nccwsuGP (φ y)) ∧
  (∀ z : X, nccwsuGP z → ∃ y : N, (∀ y' : N, φ y' = z ↔ y' = y) ∧ IsIso (φ.stalkMap y))

abbrev nccwsuPt {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {N X S₁ : Scheme.{u}} (uN : N ⟶ Spec (.of R)) (ν₁ : S₁ ⟶ X) (q₁ : N ⟶ S₁) (ξ : X)
    (y : N) : Prop :=
  uN y = IsLocalRing.closedPoint R ∧ ν₁ (q₁ y) = ξ ∧
  (∀ y' : N, uN y' = IsLocalRing.closedPoint R → y' ⤳ y → y' = y) ∧
  (∀ y' : N, uN y' = IsLocalRing.closedPoint R →
    (∀ y'' : N, uN y'' = IsLocalRing.closedPoint R → y'' ⤳ y' → y'' = y') →
    ν₁ (q₁ y') = ξ → y' = y) ∧
  (∀ w : S₁, ν₁ w = ξ → w = q₁ y) ∧
  (∃ W : S₁.Opens, q₁ y ∈ W ∧ IsIso (q₁ ∣_ W)) ∧
  closure {y} ⊆ ⇑uN ⁻¹' {IsLocalRing.closedPoint R} ∧
  (closure {y}).Nontrivial
noncomputable abbrev wcpaDjP1nG1 (A : Type u) [CommRing A] (x s : A) : Polynomial (Polynomial A) :=
  Polynomial.C (Polynomial.C x) - Polynomial.C (Polynomial.C s) * Polynomial.C Polynomial.X

noncomputable abbrev wcpaDjP1nG2 (A : Type u) [CommRing A] (y s : A) : Polynomial (Polynomial A) :=
  Polynomial.C (Polynomial.C y) - Polynomial.C (Polynomial.C s) * Polynomial.X

noncomputable abbrev wcpaDjP1nGs (A : Type u) [CommRing A] {n : ℕ} (v : A) (σ : Fin n → A)
    (b : Fin n → ℕ) : Polynomial (Polynomial A) :=
  Polynomial.C Polynomial.X * Polynomial.X -
    Polynomial.C (Polynomial.C v) * ∏ m, Polynomial.C (Polynomial.C (σ m)) ^ b m

noncomputable abbrev wcpaDjP1nJ (A : Type u) [CommRing A] (x y s : A)
    (L : Type u) [CommRing L] [Algebra (Polynomial (Polynomial A)) L] : Ideal L :=
  Ideal.span {algebraMap (Polynomial (Polynomial A)) L (wcpaDjP1nG1 A x s),
    algebraMap (Polynomial (Polynomial A)) L (wcpaDjP1nG2 A y s)}

abbrev wcpaDjP1nE (A : Type u) [CommRing A] (x y s : A)
    (L : Type u) [CommRing L] [Algebra (Polynomial (Polynomial A)) L] : Type u :=
  L ⧸ wcpaDjP1nJ A x y s L

noncomputable abbrev wcpaDjP1nMk (A : Type u) [CommRing A] (x y s : A)
    (L : Type u) [CommRing L] [Algebra (Polynomial (Polynomial A)) L] :
    Polynomial (Polynomial A) →+* wcpaDjP1nE A x y s L :=
  (Ideal.Quotient.mk (wcpaDjP1nJ A x y s L)).comp
    (algebraMap (Polynomial (Polynomial A)) L)
noncomputable abbrev nccwffnzI (R : Type u) [CommRing R] : Ideal (MvPowerSeries (Fin 2) R) :=
  Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C 0}

noncomputable abbrev nccwffnzX (R : Type u) [CommRing R] (i : Fin 2) : nccwffQ R 0 :=
  Ideal.Quotient.mk (nccwffnzI R) (MvPowerSeries.X i)
abbrev wcBffDcSm {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ϖ : ↥W) (ζ : A) (s : ℕ) (e : ↥W) (x : wcGubGen W A) : Prop :=
