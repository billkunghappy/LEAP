noncomputable def wcGModelSmul {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
    (P : wcGModel ℓ Γ) (x : MonoidAlgebra ℤ_[ℓ] Γ) : wcGModelAb P ⟶ wcGModelAb P :=
  CochainComplex.ofHom (X := wcGModelAb P) (Y := wcGModelAb P)
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcSmulHom x (P.ε i))))
    (fun i => by
      dsimp only [wcGModelAb]
      rw [CochainComplex.of_d]
      refine AddCommGrpCat.ext (fun v => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, wcSmulHom, Matrix.smul_vecMul])

noncomputable def wcCxJMap (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    {J J' : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ}
    (f : J ⟶ J') : wcCxJ K hP J ⟶ wcCxJ K hP J' :=
  ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex _).map f
def wcvsSuppJ (S : Scheme.{u}) (U : S.ProEt) (Ub : U.left.Opens)
    (A : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) : Prop :=
  ∀ (V' : Over U) (s : A.obj.obj (Opposite.op V')), ∃ R : Sieve V',
    R ∈ ((Scheme.ProEt.topology S).over U) V' ∧
    ∀ (V'' : Over U) (g : V'' ⟶ V'), R g →
      (∀ v : V''.left.left, V''.hom.left v ∈ Ub) ∨ (A.obj.map g.op).hom s = 0


def wcvsSuppY (Y : Scheme.{u}) (Ub : Y.Opens)
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) : Prop :=
  ∀ (V : Y.ProEt) (s : G.obj.obj (Opposite.op V)), ∃ R : Sieve V,
    R ∈ Scheme.ProEt.topology Y V ∧
    ∀ (V'' : Y.ProEt) (g : V'' ⟶ V), R g →
      (∀ v : V''.left, V''.hom v ∈ Ub) ∨ (G.obj.map g.op).hom s = 0
noncomputable def wcLtcPair {X : Scheme.{u}} {T W : X.ProEt} (a b : T ⟶ W) :
    T.left ⟶ Limits.pullback W.hom W.hom :=
