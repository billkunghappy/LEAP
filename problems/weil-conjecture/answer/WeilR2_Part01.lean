def wcFSys {W Y : Scheme.{u}} (π : W ⟶ Y) (O : Y.Opens)
    (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)) : Prop :=
  (∀ V : Y.Opens, IsAffineOpen V → V ≤ O →
    (∀ c : Γ(Y, V), (π.app V).hom c ∈ 𝒜 V) ∧
    (∀ a ∈ 𝒜 V, ∀ b ∈ 𝒜 V, a + b ∈ 𝒜 V ∧ a * b ∈ 𝒜 V) ∧
    (∃ T : Finset Γ(W, π ⁻¹ᵁ V), (↑T : Set Γ(W, π ⁻¹ᵁ V)) ⊆ 𝒜 V ∧
      ∀ a ∈ 𝒜 V, ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, V), a = ∑ t ∈ T, (π.app V).hom (c t) * t)) ∧
  (∀ U : Y.Opens, IsAffineOpen U → U ≤ O → ∀ f : Γ(Y, U),
    (∀ a ∈ 𝒜 U, (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom a ∈
      𝒜 (Y.basicOpen f)) ∧
    (∀ b ∈ 𝒜 (Y.basicOpen f), ∃ (n : ℕ) (a : Γ(W, π ⁻¹ᵁ U)), a ∈ 𝒜 U ∧
      (π.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n * b =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom a))
