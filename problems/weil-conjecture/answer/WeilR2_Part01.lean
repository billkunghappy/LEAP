def wcpaDjGrIface {B : Type u} [CommRing B] {X Y Z T : Scheme.{u}} (h : X ⟶ Spec (.of B))
    (I : Ideal B) (n : ℕ) (q : Y ⟶ T) (φ : X ⟶ Z) (p : Y ⟶ X) (L : wcpaDjCoc Z) : Prop :=
  ∃ (θ1 : ∀ a : Fin L.m, Γ(X, (wcpaDjCocPull φ L).V a) →
        Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ q ⁻¹ᵁ ⊤))
    (θ2 : ∀ a b : Fin L.m, Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b) →
        Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b ⊓ q ⁻¹ᵁ ⊤))
    (θ3 : ∀ a b c : Fin L.m, Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b ⊓
          (wcpaDjCocPull φ L).V c) →
        Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b ⊓
          (wcpaDjCocPull (p ≫ φ) L).V c ⊓ q ⁻¹ᵁ ⊤)),

    (∀ (a b : Fin L.m) (x x' : Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)),
      x ∈ Ideal.map (wcCnSigma h ((wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b))
        (I ^ (n + 1)) →
      x' ∈ Ideal.map (wcCnSigma h ((wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b))
        (I ^ (n + 1)) →
      θ2 a b (x + x') = θ2 a b x + θ2 a b x') ∧

    (∀ (a b c : Fin L.m) (x x' : Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b ⊓
        (wcpaDjCocPull φ L).V c)),
      x ∈ Ideal.map (wcCnSigma h ((wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b ⊓
