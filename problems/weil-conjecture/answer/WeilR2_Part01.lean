      intro w σ
      obtain ⟨i, rfl⟩ : ∃ i, σ = fun _ => i := ⟨σ 0, funext fun l => by rw [Fin.eq_zero l]⟩
      have hid : Limits.WidePullback.π (fun _ : Fin 1 => f i) 0 ≫ ε i = 𝟙 _ := by
        apply Limits.WidePullback.hom_ext
        · intro l
          rw [Category.assoc, Limits.WidePullback.lift_π, Category.comp_id, Category.id_comp,
            Subsingleton.elim l 0]
        · rw [Category.assoc, Limits.WidePullback.lift_base, Category.id_comp,
