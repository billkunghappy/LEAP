def wcHmtgS.{u} (m r : ℕ) : Prop :=
  ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (π : A) (_hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (_hℓA : IsUnit ((ℓ : ℕ) : A))
    (n : ℕ) (_hn : n = 2 * m + r)
    (c : Matrix (Fin n) (Fin n) A) (_hc : c = wcHmtgMat A n m)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (β : wcQuadModelRing A n π c →+* B)
    (_hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (_hβX : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B)
    (L : Type u) [Field L] [IsSepClosed L] (lam : A →+* L) (_hlamπ : lam π ≠ 0)
    (cL : Matrix (Fin n) (Fin n) L) (_hcL : cL = wcHmtgMat L n m)
    (κ : wcQuadModelRing A n π c →+* wcQuadModelRing L n (lam π) cL)
    (_hκ : ∀ P : MvPolynomial (Fin n) A, κ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) P) =
      Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π) cL) (MvPolynomial.map lam P))
    {Pm : Scheme.{u}} (p₁ : Pm ⟶ Spec (.of B)) (p₂ : Pm ⟶ Spec (.of L))
    (_hPm : IsPullback p₁ p₂
      (Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))))
      (Spec.map (CommRingCat.ofHom lam)))
    (h₀ : Pm ⟶ Spec (.of (wcQuadModelRing L n (lam π) cL)))
    (_hh₀κ : h₀ ≫ Spec.map (CommRingCat.ofHom κ) = p₁ ≫ Spec.map (CommRingCat.ofHom β))
    (_hh₀L : h₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π) cL))) =
      p₂)
    (k : ℕ) (_hk : 1 ≤ k),
    ∀ D₀ : wcZModPullData h₀ (ℓ ^ k), wcZModPullCanonical D₀ →
      ∃ x : wcZModProEtExt (Spec (.of (wcQuadModelRing L n (lam π) cL))) (ℓ ^ k) (2 * m - 1),
        ℓ ^ k ≤ addOrderOf (wcZModPull D₀ (2 * m - 1) x)
def wcQmbtDlytStrictNZ {Y' Z : Scheme.{u}} {iY' : Y' ⟶ Z} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (EY' : wcHMPullData iY' ℓ) (θ : wcSuppExt EY' 2) : Prop :=
  ∀ (R' : CommRingCat.{u}) [HenselianLocalRing R'] [IsSepClosed (IsLocalRing.ResidueField R')]
    (k' : Spec R' ⟶ Z), WeaklyEtale k' → k' (IsLocalRing.closedPoint R') ∈ Set.range iY' →
