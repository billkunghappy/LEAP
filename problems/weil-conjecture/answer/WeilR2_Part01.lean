def wcpaDjTorPt (Z : Scheme.{u}) (B : Set Z) (z : Z) : Prop :=
  ∃ (n q : ℕ)
    (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))
    (h : Fin q → Z.presheaf.stalk z) (J : Fin q → Finset (Fin n)),
    (n : WithBot ℕ∞) = ringKrullDim (Z.presheaf.stalk z) ∧
    Ideal.span (Set.range s) = (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)).map
      (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) ∧
    (∀ i i', i ≠ i' → Disjoint (J i) (J i')) ∧
    (∀ i, Associated (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) (h i))
      (∏ j ∈ J i, s j)) ∧
    ∀ (z' : Z) (hz : z' ⤳ z), (z' ∈ B ↔ ∃ i, (Z.presheaf.stalkSpecializes hz).hom (h i) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk z'))


def wcpaDjTorNode (Z : Scheme.{u}) (B : Set Z) (z : Z) : Prop :=
  ∃ (n q : ℕ) (A : Type u) (_ : CommRing A) (_ : IsRegularLocalRing A)
    (_ : IsAdicComplete (IsLocalRing.maximalIdeal A) A)
    (x y v : A) (σ : Fin n → A) (b : Fin n → ℕ)
    (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+*
      (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
    (h : Fin q → Z.presheaf.stalk z) (J : Fin q → Finset (Fin n)),
    IsUnit v ∧ ((n + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A ∧
    Ideal.span ({x, y} ∪ Set.range σ) = IsLocalRing.maximalIdeal A ∧
    (∀ i i', i ≠ i' → Disjoint (J i) (J i')) ∧ (∀ l, b l ≠ 0 → ∃ i, l ∈ J i) ∧
    (∀ i, Associated (e (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) (h i)))
      (Ideal.Quotient.mk _ (∏ l ∈ J i, σ l))) ∧
    ∀ (z' : Z) (hz : z' ⤳ z), (z' ∈ B ↔ ∃ i, (Z.presheaf.stalkSpecializes hz).hom (h i) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk z'))
