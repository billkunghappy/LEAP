        haveI : (Scheme.Etale.forget S).IsContinuous S.smallEtaleTopology (Scheme.etaleTopology.over S) :=
          Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _)
            (Functor.coverPreserving_restrictedTopology (Scheme.Etale.forget S) (Scheme.etaleTopology.over S))
