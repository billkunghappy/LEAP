    (show h ≫ (O.hom ≫ W.hom) = O'.hom ≫ W'.hom from
      (Category.assoc h O.hom W.hom).symm.trans ((congrArg (· ≫ W.hom) hh).trans
        ((Category.assoc _ _ _).trans (congrArg (O'.hom ≫ ·) (MorphismProperty.Over.w t)))))
    trivial

