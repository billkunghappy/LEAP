    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (Uo : (wcP1Over K).left.Opens) (r : ℕ) (V : ℕ → Scheme.{u})
    (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u) [∀ n, Group (Γ n)]
    (α : (n : ℕ) → Γ n →* Aut (V n)) (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n))) : Prop :=
  ∃ (hα : ∀ n γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι)
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (ι : L ⟶ G) (lam : ℤ_[ℓ] → (L ⟶ L))
    (π : ∀ n, L ⟶ wcTwSh (q' n ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r (ρ n))
    (τ : ∀ n, wcTwSh (q' (n + 1) ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ (n + 1)) (α (n + 1))
        (hα (n + 1)) ℓ (n + 1) r (ρ (n + 1)) ⟶
      wcTwSh (q' n ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r (ρ n)),
    wcLatticeData K ℓ m S G σ Uo r V q' Γ α ρ hα L ι lam π τ ∧ wcCokerTorsion K hP ℓ ι
noncomputable def wcRirTens (R : Type u) [Ring R] : AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} where
  obj A := AddCommGrpCat.of (TensorProduct ℤ R A)
  map f := AddCommGrpCat.ofHom (LinearMap.lTensor R f.hom.toIntLinearMap).toAddMonoidHom
  map_id A := by
    ext x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r a => simp
    | add x y hx hy => simp_all
  map_comp f g := by
    ext x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r a => simp
    | add x y hx hy => simp_all

