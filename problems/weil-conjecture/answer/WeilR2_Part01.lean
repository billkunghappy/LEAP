    Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj)) (SheafOfModules.unit (wcRingSheaf V ℓ)) n →+
      wcHM Wo.toScheme ℓ n :=
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
