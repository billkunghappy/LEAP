            (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b from
            inf_le_left)).op).hom
          ((wcpaDjCocPull (p ≫ φ) L).g a b :
            Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b))) ^ d *
