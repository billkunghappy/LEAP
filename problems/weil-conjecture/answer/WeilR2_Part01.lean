    (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R J)) 1
      (MvPolynomial.X L) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R L)))

noncomputable abbrev wcRsV (R : Type u) [CommRing R] (N m : ℕ) (b : Fin (N + 1)) (c : Fin (m + 1)) :
