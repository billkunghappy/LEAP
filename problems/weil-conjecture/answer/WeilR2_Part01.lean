        C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod n))))
      (fun V V' g => ContinuousMap.ext (fun x =>
        congrArg (fun k => r (k.base x)) (MorphismProperty.Over.w g.unop))))

structure wcZModPullData {S S' : Scheme.{u}} (f : S' ⟶ S) (n : ℕ) where
  cont : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')
  φ : wcZModRingSheaf S n ⟶
    (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC f) RingCat.{u+1} _
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') cont).obj (wcZModRingSheaf S' n)
  Φ : SheafOfModules.{u+1} (wcZModRingSheaf S n) ⥤ SheafOfModules.{u+1} (wcZModRingSheaf S' n)
  adj : Φ ⊣ @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ cont φ
  additive : Φ.Additive
  presLim : Limits.PreservesFiniteLimits Φ
  presColim : Limits.PreservesFiniteColimits Φ
  μ : Φ.obj (SheafOfModules.unit (wcZModRingSheaf S n)) ≅ SheafOfModules.unit (wcZModRingSheaf S' n)

noncomputable def wcZModPull {S S' : Scheme.{u}} {f : S' ⟶ S} {n : ℕ}
    (D : wcZModPullData f n) (i : ℕ) : wcZModProEtExt S n i →+ wcZModProEtExt S' n i :=
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S' n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  ((Abelian.Ext.mk₀ D.μ.inv).precomp _ (zero_add i)).comp
    (((Abelian.Ext.mk₀ D.μ.hom).postcomp _ (add_zero i)).comp
      (D.Φ.mapExtAddHom _ _ i))

def wcZModPullCanonical {S S' : Scheme.{u}} {f : S' ⟶ S} {n : ℕ}
    (D : wcZModPullData f n) : Prop :=
  ∀ (V : S.ProEt) (s : C(↥V.left, ULift.{u+1} (ZMod n))),
    ((D.φ.hom.app (Opposite.op V)).hom s : C(↥(Limits.pullback V.hom f), ULift.{u+1} (ZMod n))) =
      s.comp (Limits.pullback.fst V.hom f).base.hom
noncomputable def wcLpttUSec (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) k) ⟶
      wcLpttEtSh Y (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) k)) :=
