noncomputable def wcScqCcV (K : Type u) [Field K] (e : ℕ) {T : Scheme.{u}}
    (κ : T ⟶ wcProjK K (e + 2 + 1)) (c : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)) :
