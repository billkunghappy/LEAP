    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k))))
    (DσQ : wcEtPullData σQ (ℓ ^ k)),
    haveI := Dh.cont
    haveI := DσQ.cont
    haveI : (wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange σQ).IsContinuous (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology (Limits.pullback fX ξ)) :=
      Functor.isContinuous_comp (wcEtBaseChange (Limits.pullback.fst fX ξ)) (wcEtBaseChange σQ) (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology (Limits.pullback fX ξ)) (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
    let α : wcEtBaseChange (Limits.pullback.fst fX ξ) ⟶ wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange σQ :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) (Limits.pullback.fst fX ξ) :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) (Limits.pullback.fst fX ξ) :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong (Limits.pullback.fst fX ξ))) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong σQ)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) σQ (Limits.pullback.fst fX ξ) (Limits.pullback.fst fX ξ) hσQ1.symm).hom
    haveI := Dh.additive
    haveI := DσQ.additive
