      (g.hom.app (Opposite.op W)).hom t = wcConstSec X (ULift.{u+1} ℤ) W (ULift.up 1) →
      ∃! k : W.left ⟶ V, ∃ φ : W ⟶ wcTorsorEt (pU ≫ U.ι) hE, φ.left = k ∧
        (E.obj.map φ.op).hom s = t
