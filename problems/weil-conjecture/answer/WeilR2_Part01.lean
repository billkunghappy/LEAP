noncomputable def wcLevelWP {C : Type*} [Category C] [Limits.HasFiniteWidePullbacks C]
    {M : Type*} [Category M] (U' : M ⥤ C) {k : ℕ} (V' : Fin k → M ⥤ C) (f' : ∀ i, V' i ⟶ U')
    {p : ℕ} (σ : Fin (p + 1) → Fin k) : M ⥤ C where
  obj n := Limits.widePullback (U'.obj n) (fun j => (V' (σ j)).obj n) (fun j => (f' (σ j)).app n)
  map {n n'} t := Limits.WidePullback.lift
    (Limits.WidePullback.base (fun j => (f' (σ j)).app n) ≫ U'.map t)
    (fun j => Limits.WidePullback.π (fun j => (f' (σ j)).app n) j ≫ (V' (σ j)).map t)
    (fun j => by
      rw [Category.assoc, (f' (σ j)).naturality, ← Category.assoc, Limits.WidePullback.π_arrow])
  map_id n := by
    apply Limits.WidePullback.hom_ext
    · intro j
      erw [Limits.WidePullback.lift_π]
      simp
    · erw [Limits.WidePullback.lift_base]
      simp
  map_comp t t' := by
    apply Limits.WidePullback.hom_ext
    · intro j
      erw [Limits.WidePullback.lift_π, Category.assoc, Limits.WidePullback.lift_π,
        ← Category.assoc, Limits.WidePullback.lift_π]
      simp
    · erw [Limits.WidePullback.lift_base, Category.assoc, Limits.WidePullback.lift_base,
        ← Category.assoc, Limits.WidePullback.lift_base]
      simp
structure wcFetTorsor {Y V : Scheme.{u}} (p : V ⟶ Y) (m : ℕ) (a : ZMod m → (V ⟶ V)) : Prop where
  finite : IsFinite p
  etale : Etale p
  surj : Set.range p = Set.univ
  act_p : ∀ c, a c ≫ p = p
  act_zero : a 0 = 𝟙 V
  act_add : ∀ c c', a (c + c') = a c' ≫ a c
  graph_open : ∀ c, IsOpenImmersion (Limits.pullback.lift (a c) (𝟙 V)
    ((act_p c).trans (Category.id_comp p).symm))
  graph_disj : Pairwise fun c c' =>
    Disjoint (Set.range (Limits.pullback.lift (a c) (𝟙 V) ((act_p c).trans (Category.id_comp p).symm)))
      (Set.range (Limits.pullback.lift (a c') (𝟙 V) ((act_p c').trans (Category.id_comp p).symm)))
  graph_cover : (⋃ c, Set.range (Limits.pullback.lift (a c) (𝟙 V)
    ((act_p c).trans (Category.id_comp p).symm))) = Set.univ
