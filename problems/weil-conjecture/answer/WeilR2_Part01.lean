    (show C(↥W.left, ℤ_[ℓ]) from ((lam.hom.hom.app (Opposite.op W)).hom (ULift.up f)).down) x = f x

noncomputable def wcIzCp {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')] :
    wcIntSheaf S ℓ ⟶
      ((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S')).obj (wcIntSheaf S' ℓ) :=
  ObjectProperty.homMk
    (Functor.whiskerRight (NatTrans.op
        ({ app := fun V => (Limits.pullback.fst V.hom f : Limits.pullback V.hom f ⟶ V.left)
           naturality := fun _ _ _ => Limits.pullback.lift_fst _ _ _ } :
          wcProEtBC f ⋙ Scheme.ProEt.forget S' ⋙ Over.forget S' ⟶
            Scheme.ProEt.forget S ⋙ Over.forget S))
      (continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))

noncomputable def wcIzC0 {S S' : Scheme.{u}} (f : S' ⟶ S) :
    Scheme.ProEt.mk (𝟙 S') ⟶ (wcProEtBC f).obj (Scheme.ProEt.mk (𝟙 S)) :=
  MorphismProperty.Over.homMk (Limits.pullback.lift f (𝟙 S')
      (by exact (Category.comp_id f).trans (Category.id_comp f).symm))
    (Limits.pullback.lift_snd _ _ _) trivial

def wcIzPhiNorm {S S' : Scheme.{u}} (f : S' ⟶ S)
    [(wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')]
    (φ : wcFreeSheaf S' (Scheme.ProEt.mk (𝟙 S')) ⟶
      ((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S')).obj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))) : Prop :=
  (φ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S')))).hom (wcFreeGen S' (Scheme.ProEt.mk (𝟙 S'))) =
    ((((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S')).obj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))).obj.map
        (wcIzC0 f).op).hom
      (show ((((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
          (Scheme.ProEt.topology S')).obj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))).obj.obj
          (Opposite.op ((wcProEtBC f).obj (Scheme.ProEt.mk (𝟙 S))))) from
        ((((wcProEtBC f).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
          (Scheme.ProEt.topology S')).unit.app (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))).hom.app
          (Opposite.op (Scheme.ProEt.mk (𝟙 S)))).hom (wcFreeGen S (Scheme.ProEt.mk (𝟙 S))))
def wcpaDjNCData (Z : Scheme.{u}) (m : ℕ) (Dc : Fin m → Set Z) (z : Z) (n : ℕ)
    (J : Fin m → Finset (Fin n)) : Prop :=
  ∃ (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))
    (g : Fin m → Z.presheaf.stalk z),
    (n : WithBot ℕ∞) = ringKrullDim (Z.presheaf.stalk z) ∧
    Ideal.span (Set.range s) = (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)).map
      (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) ∧
    (∀ i l, i ≠ l → Disjoint (J i) (J l)) ∧
    (∀ i, z ∉ Dc i → J i = ∅) ∧
    (∀ i, z ∈ Dc i →
      Associated (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) (g i))
        (∏ j ∈ J i, s j) ∧
      ∀ (z' : Z) (h : z' ⤳ z), (z' ∈ Dc i ↔ (Z.presheaf.stalkSpecializes h).hom (g i) ∈
        IsLocalRing.maximalIdeal (Z.presheaf.stalk z')))
noncomputable abbrev wcpaDjChart (A : Type u) [CommRing A] {r : ℕ} (f : Fin (r + 1) → A)
    (a : Fin (r + 1)) : Subalgebra A (Localization.Away (f a)) :=
  Algebra.adjoin A (Set.range fun l => IsLocalization.mk' (Localization.Away (f a)) (f l)
    (⟨f a, Submonoid.mem_powers _⟩ : Submonoid.powers (f a)))
noncomputable def wcPclM {X Y : Scheme.{u}} (qb : Y ⟶ X) (a : Y ⟶ Y) (ha : a ≫ qb = qb) :
    wcProEtPullback qb ⋙ wcProEtPullback a ⟶ wcProEtPullback qb where
  app V := MorphismProperty.Over.homMk
    (Limits.pullback.lift
      (Limits.pullback.fst (Limits.pullback.snd V.hom qb) a ≫ Limits.pullback.fst V.hom qb)
      (Limits.pullback.snd (Limits.pullback.snd V.hom qb) a)
      (by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc,
        Limits.pullback.condition, Category.assoc, ha]) :
      Limits.pullback (Limits.pullback.snd V.hom qb) a ⟶ Limits.pullback V.hom qb)
    (Limits.pullback.lift_snd _ _ _) trivial
  naturality V V' f := by
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V.hom qb) a ≫
          Limits.pullback.lift (Limits.pullback.fst V.hom qb ≫ f.left)
            (Limits.pullback.snd V.hom qb) _)
        (Limits.pullback.snd (Limits.pullback.snd V.hom qb) a) _ ≫
      Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V'.hom qb) a ≫ Limits.pullback.fst V'.hom qb)
        (Limits.pullback.snd (Limits.pullback.snd V'.hom qb) a) _ =
      Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V.hom qb) a ≫ Limits.pullback.fst V.hom qb)
        (Limits.pullback.snd (Limits.pullback.snd V.hom qb) a) _ ≫
      Limits.pullback.lift (Limits.pullback.fst V.hom qb ≫ f.left)
        (Limits.pullback.snd V.hom qb) _
    apply Limits.pullback.hom_ext
    · repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_fst_assoc] |
        erw [Limits.pullback.lift_fst])
    · repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_snd_assoc] |
        erw [Limits.pullback.lift_snd])

noncomputable def wcPclGamma {X Y : Scheme.{u}} (qb : Y ⟶ X) (a : Y ⟶ Y) (ha : a ≫ qb = qb) :
    wcProEtPush qb ⟶ wcProEtPush a ⋙ wcProEtPush qb where
  app F := (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
    (Functor.whiskerRight (NatTrans.op (wcPclM qb a ha)) F.obj ≫
      Functor.whiskerLeft (wcProEtBaseChange qb).op
        (toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange a).op ⋙ F.obj)))
  naturality F G x := by
    show (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
        (Functor.whiskerLeft (wcProEtBaseChange qb).op x.hom) ≫
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (Functor.whiskerRight (NatTrans.op (wcPclM qb a ha)) G.obj ≫
            Functor.whiskerLeft (wcProEtBaseChange qb).op
              (toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange a).op ⋙ G.obj))) =
      (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (Functor.whiskerRight (NatTrans.op (wcPclM qb a ha)) F.obj ≫
            Functor.whiskerLeft (wcProEtBaseChange qb).op
              (toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange a).op ⋙ F.obj))) ≫
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcProEtBaseChange qb).op
            (sheafifyMap (Scheme.ProEt.topology Y)
              (Functor.whiskerLeft (wcProEtBaseChange a).op x.hom)))
    rw [← Functor.map_comp, ← Functor.map_comp]
    congr 1
    refine NatTrans.ext (funext fun T => ?_)
    have h1 := reassoc_of% (x.hom.naturality ((wcPclM qb a ha).app T.unop).op)
    have h2 := congrArg (fun φ => φ.app (Opposite.op ((wcProEtBaseChange qb).obj T.unop)))
      (toSheafify_naturality (Scheme.ProEt.topology Y)
        (Functor.whiskerLeft (wcProEtBaseChange a).op x.hom))
    simp only [NatTrans.comp_app] at h2
    simp only [NatTrans.comp_app, Functor.whiskerLeft_app, Functor.whiskerRight_app, NatTrans.op_app]
    erw [Category.assoc, ← h2]
    exact (Category.assoc _ _ _).trans (h1 _).symm
def wcH2LinkR (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (J : Subobject G)
    (Uo : (wcP1Over K).left.Opens) (r : ℕ) (V : ℕ → Scheme.{u})
    (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u) [∀ n, Group (Γ n)]
    (α : (n : ℕ) → Γ n →* Aut (V n)) (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n))) : Prop :=
  ∃ hα : ∀ n γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι,
  ∀ n, 1 ≤ n → ∃ mu : wcH2TwSheaf (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        (Γ n) (α n) (hα n) ℓ n r (ρ n) ⟶
      Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)),
    ∀ (T : (wcP1Over K).left.ProEt),
      (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
      (∀ s : (Limits.kernel mu).obj.obj (Opposite.op T), s = 0) ∧
      (∀ s : (Limits.cokernel mu).obj.obj (Opposite.op T), s = 0)
noncomputable def wcpaDjJacMinor {R : Type u} [CommRing R] {r : ℕ}
    (f : Fin r → MvPolynomial (Fin (r + 1)) R) (j : Fin (r + 1)) : MvPolynomial (Fin (r + 1)) R :=
  (-1) ^ (j : ℕ) * Matrix.det (Matrix.of fun (i l : Fin r) =>
    MvPolynomial.pderiv (j.succAbove l) (f i))

def wcpaDjLogChart {Y T : Scheme.{u}} (q : Y ⟶ T) {n : ℕ} (σ : Fin n → (T ⟶ Y)) (V : Y.Opens)
    (W : T.Opens) (hle : V ≤ q ⁻¹ᵁ W) (r : ℕ)
    (π : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* Γ(Y, V))
    (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W)) (h : Fin n → Γ(Y, V)) : Prop :=
  IsAffineOpen V ∧ IsAffineOpen W ∧ Function.Surjective π ∧
  (∀ c, π (MvPolynomial.C c) = (q.appLE W V hle).hom c) ∧
  RingHom.ker π = Ideal.span (Set.range f) ∧
  ∀ i, IsAffineOpen ((σ i) ⁻¹ᵁ V) ∧ Function.Surjective ((σ i).app V).hom ∧
    RingHom.ker ((σ i).app V).hom = Ideal.span {h i}

def wcpaDjLogTrans {Y T : Scheme.{u}} (q : Y ⟶ T) {n : ℕ} {Va Vb : Y.Opens} {Wa Wb : T.Opens}
    (ha : Va ≤ q ⁻¹ᵁ Wa) (hb : Vb ≤ q ⁻¹ᵁ Wb) {ra rb : ℕ}
    (πa : MvPolynomial (Fin (ra + 1)) Γ(T, Wa) →+* Γ(Y, Va))
    (πb : MvPolynomial (Fin (rb + 1)) Γ(T, Wb) →+* Γ(Y, Vb))
    (fa : Fin ra → MvPolynomial (Fin (ra + 1)) Γ(T, Wa))
    (fb : Fin rb → MvPolynomial (Fin (rb + 1)) Γ(T, Wb))
    (hA : Fin n → Γ(Y, Va)) (hB : Fin n → Γ(Y, Vb)) (g : Γ(Y, Va ⊓ Vb))
    (j : Fin (ra + 1)) (k : Fin (rb + 1)) : Prop :=
  letI : Algebra Γ(T, Wa ⊓ Wb) Γ(Y, Va ⊓ Vb) :=
    (q.appLE (Wa ⊓ Wb) (Va ⊓ Vb) (fun x hx => ⟨ha hx.1, hb hx.2⟩)).hom.toAlgebra
  ∃ N : ℕ,
    ((Y.presheaf.map (homOfLE (inf_le_left : Va ⊓ Vb ≤ Va)).op).hom (πa (wcpaDjJacMinor fa j)) *
      (Y.presheaf.map (homOfLE (inf_le_right : Va ⊓ Vb ≤ Vb)).op).hom
        (πb (wcpaDjJacMinor fb k))) ^ N •
    ((g * (Y.presheaf.map (homOfLE (inf_le_left : Va ⊓ Vb ≤ Va)).op).hom (∏ i, hA i) *
        (Y.presheaf.map (homOfLE (inf_le_left : Va ⊓ Vb ≤ Va)).op).hom
          (πa (wcpaDjJacMinor fa j))) •
      KaehlerDifferential.D Γ(T, Wa ⊓ Wb) Γ(Y, Va ⊓ Vb)
        ((Y.presheaf.map (homOfLE (inf_le_right : Va ⊓ Vb ≤ Vb)).op).hom
          (πb (MvPolynomial.X k))) -
     ((Y.presheaf.map (homOfLE (inf_le_right : Va ⊓ Vb ≤ Vb)).op).hom (∏ i, hB i) *
        (Y.presheaf.map (homOfLE (inf_le_right : Va ⊓ Vb ≤ Vb)).op).hom
          (πb (wcpaDjJacMinor fb k))) •
      KaehlerDifferential.D Γ(T, Wa ⊓ Wb) Γ(Y, Va ⊓ Vb)
        ((Y.presheaf.map (homOfLE (inf_le_left : Va ⊓ Vb ≤ Va)).op).hom
          (πa (MvPolynomial.X j)))) = 0

def wcpaDjLogCanon {Y T : Scheme.{u}} (q : Y ⟶ T) {n : ℕ} (σ : Fin n → (T ⟶ Y))
    (L : wcpaDjCoc Y) : Prop :=
  ∃ (W : Fin L.m → T.Opens) (hle : ∀ a, L.V a ≤ q ⁻¹ᵁ W a) (r : Fin L.m → ℕ)
    (π : ∀ a, MvPolynomial (Fin (r a + 1)) Γ(T, W a) →+* Γ(Y, L.V a))
    (f : ∀ a, Fin (r a) → MvPolynomial (Fin (r a + 1)) Γ(T, W a))
    (h : ∀ a, Fin n → Γ(Y, L.V a)),
    (∀ a, wcpaDjLogChart q σ (L.V a) (W a) (hle a) (r a) (π a) (f a) (h a)) ∧
    ∀ a b (j : Fin (r a + 1)) (k : Fin (r b + 1)),
      wcpaDjLogTrans q (hle a) (hle b) (π a) (π b) (f a) (f b) (h a) (h b)
        (L.g a b : Γ(Y, L.V a ⊓ L.V b)) j k
noncomputable def wcLtcA {X : Scheme.{u}} (Z : Set X) {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {r : ℕ}
    {G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {W : X.ProEt}
    (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W) (T : X.ProEt) :
    AddSubgroup (G.obj.obj (Opposite.op T)) where
  carrier := {s | ((∀ t, T.hom t ∉ Z) → ∀ (T'' : X.ProEt) (h : T'' ⟶ T) (b : T'' ⟶ W)
      (z : T''.left) (i : Fin r), ‖wcLtcVal θ b ((G.obj.map h.op).hom s) z i‖ ≤ 1) ∧
    ((¬ ∀ t, T.hom t ∉ Z) → s = 0)}
  zero_mem' := by
    refine ⟨fun _ T'' h b z i => ?_, fun _ => rfl⟩
    have h0 : wcLtcVal θ b ((G.obj.map h.op).hom 0) z = 0 := by
      have e1 : (G.obj.map h.op).hom 0 = 0 := (G.obj.map h.op).hom.map_zero
      have e2 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom 0 = 0 :=
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom.map_zero
      have e3 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map h.op).hom 0) = 0 := by
        rw [e1]; exact e2
      exact congrArg (fun w => (show C(↥T''.left, Fin r → ℚ_[ℓ]) from w.down) z) e3
    rw [h0]
    simp
  add_mem' := by
    intro x y hx hy
    refine ⟨fun hT T'' h b z i => ?_, fun hT => ?_⟩
    · have hadd : wcLtcVal θ b ((G.obj.map h.op).hom (x + y)) z =
          wcLtcVal θ b ((G.obj.map h.op).hom x) z + wcLtcVal θ b ((G.obj.map h.op).hom y) z := by
        have e1 : (G.obj.map h.op).hom (x + y) = (G.obj.map h.op).hom x + (G.obj.map h.op).hom y :=
          (G.obj.map h.op).hom.map_add x y
        have e2 := (θ.hom.hom.app (Opposite.op (Over.mk b))).hom.map_add
          ((G.obj.map h.op).hom x) ((G.obj.map h.op).hom y)
        have e3 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map h.op).hom (x + y)) =
            (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map h.op).hom x) +
              (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map h.op).hom y) := by
          rw [e1]; exact e2
        exact congrArg (fun w => (show C(↥T''.left, Fin r → ℚ_[ℓ]) from w.down) z) e3
      rw [hadd, Pi.add_apply]
      exact (Padic.nonarchimedean _ _).trans (max_le (hx.1 hT T'' h b z i) (hy.1 hT T'' h b z i))
    · show x + y = 0
      rw [hx.2 hT, hy.2 hT, add_zero]
  neg_mem' := by
    intro x hx
    refine ⟨fun hT T'' h b z i => ?_, fun hT => ?_⟩
    · have hneg : wcLtcVal θ b ((G.obj.map h.op).hom (-x)) z =
          -wcLtcVal θ b ((G.obj.map h.op).hom x) z := by
        have e1 : (G.obj.map h.op).hom (-x) = -(G.obj.map h.op).hom x :=
          (G.obj.map h.op).hom.map_neg x
        have e2 := (θ.hom.hom.app (Opposite.op (Over.mk b))).hom.map_neg ((G.obj.map h.op).hom x)
        have e3 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map h.op).hom (-x)) =
            -(θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map h.op).hom x) := by
          rw [e1]; exact e2
        exact congrArg (fun w => (show C(↥T''.left, Fin r → ℚ_[ℓ]) from w.down) z) e3
      rw [hneg, Pi.neg_apply, norm_neg]
      exact hx.1 hT T'' h b z i
    · show -x = 0
      rw [hx.2 hT, neg_zero]

noncomputable def wcLtcLpre {X : Scheme.{u}} (Z : Set X) {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {r : ℕ}
    {G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {W : X.ProEt}
    (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W) :
    (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj T := AddCommGrpCat.of (wcLtcA Z θ T.unop)
  map {T T'} g := AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
    ((G.obj.map g).hom.comp (wcLtcA Z θ T.unop).subtype) (wcLtcA Z θ T'.unop) (fun x => by
      obtain ⟨x, hx⟩ := x
      show (G.obj.map g).hom x ∈ wcLtcA Z θ T'.unop
      by_cases hT : ∀ t, T.unop.hom t ∉ Z
      · have hT' : ∀ t, T'.unop.hom t ∉ Z := fun t => by
          rw [← MorphismProperty.Over.w g.unop, Scheme.Hom.comp_apply]; exact hT _
        refine ⟨fun _ T'' h b z i => ?_, fun h => absurd hT' h⟩
        have e : (G.obj.map h.op).hom ((G.obj.map g).hom x) =
            (G.obj.map (h ≫ g.unop).op).hom x := by
          rw [op_comp, Functor.map_comp]
          rfl
        rw [e]
        exact hx.1 hT T'' (h ≫ g.unop) b z i
      · rw [hx.2 hT, map_zero]
        exact (wcLtcA Z θ T'.unop).zero_mem))
  map_id T := by
    ext x
    simp
  map_comp f g := by
    ext x
    simp

noncomputable def wcLtcIncl {X : Scheme.{u}} (Z : Set X) {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {r : ℕ}
    {G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {W : X.ProEt}
    (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W) :
    wcLtcLpre Z θ ⟶ G.obj where
  app T := AddCommGrpCat.ofHom (wcLtcA Z θ T.unop).subtype
  naturality _ _ _ := rfl

noncomputable def wcLtcRestr {X : Scheme.{u}} (Z : Set X) {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {r : ℕ}
    {G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {W : X.ProEt}
    (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W) (f : G ⟶ G)
    (hf : ∀ (T : X.ProEt) (x : G.obj.obj (Opposite.op T)), x ∈ wcLtcA Z θ T →
      (f.hom.app (Opposite.op T)).hom x ∈ wcLtcA Z θ T) :
    wcLtcLpre Z θ ⟶ wcLtcLpre Z θ where
  app T := AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
    ((f.hom.app T).hom.comp (wcLtcA Z θ T.unop).subtype) (wcLtcA Z θ T.unop)
    (fun x => hf T.unop x.1 x.2))
  naturality T T' g := by
    ext x
    apply Subtype.ext
    exact congrArg (fun φ => φ.hom x.1) (f.hom.naturality g)
def wcpaDjCompat {Y : Scheme.{u}} (L : wcpaDjCoc Y) (O : Y.Opens) (e : ℕ)
    (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O)) : Prop :=
  ∀ a b,
    (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V b ⊓ O from
        le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t b) =
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ L.V b from
        inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ O from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t a)


def wcpaDjVAData {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (W : T.Opens) (e : ℕ) (M : ℕ)
    (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)) : Prop :=
    (∀ J a b,
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t J b) =
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t J a)) ∧
    (∀ a, Ideal.span (Set.range (fun J => t J a)) = ⊤) ∧
    (∀ J, IsAffineOpen (⨆ a, Y.basicOpen (t J a))) ∧
    ∀ J (f : Γ(Y, ⨆ a, Y.basicOpen (t J a))), ∃ P : MvPolynomial (Fin (M + 1)) Γ(T, W),
      ∀ a, ∃ inv : Γ(Y, Y.basicOpen (t J a)),
        inv * (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a) = 1 ∧
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom f =
          MvPolynomial.eval₂
            ((Y.presheaf.map (homOfLE ((Y.basicOpen_le (t J a)).trans inf_le_right)).op).hom.comp
              (q.app W).hom)
            (fun l => (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t l a) * inv) P


def wcpaDjAmp {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (W : T.Opens) (e : ℕ) : Prop :=
  ∃ (M : ℕ) (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
    (∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) e (t J)) ∧
    (⨆ J, ⨆ a, Y.basicOpen (t J a)) = q ⁻¹ᵁ W ∧
    (∀ J, IsAffineOpen (⨆ a, Y.basicOpen (t J a))) ∧
    ∀ J, letI := ((Y.presheaf.map (homOfLE (show (⨆ a, Y.basicOpen (t J a)) ≤ q ⁻¹ᵁ W from
        iSup_le (fun a => (Y.basicOpen_le (t J a)).trans inf_le_right))).op).hom.comp
          (q.app W).hom).toAlgebra
      Algebra.FiniteType Γ(T, W) Γ(Y, ⨆ a, Y.basicOpen (t J a))


def wcpaDjTwH1 {Y : Scheme.{u}} (L : wcpaDjCoc Y) (U : Y.Opens) (F : Y.Modules) (n : ℕ) : Prop :=
  ∀ c : ∀ a b : Fin L.m, Γ(F, L.V a ⊓ L.V b ⊓ U),
    (∀ a b d,
      (F.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V a ⊓ L.V d ⊓ U from
          inf_le_inf_right U (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c a d) =
        (F.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V b ⊓ L.V d ⊓ U from
          inf_le_inf_right U (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c b d) +
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V b ⊓ L.V d from
          (inf_le_left : L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V a ⊓ L.V b ⊓ L.V d).trans
            (inf_le_inf_right (L.V d) inf_le_right))).op).hom
            (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ n •
        (F.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V a ⊓ L.V b ⊓ U from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b)) →
    ∃ β : ∀ a : Fin L.m, Γ(F, L.V a ⊓ U), ∀ a b,
      c a b = (F.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ U ≤ L.V b ⊓ U from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β b) -
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ U ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n •
        (F.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ U ≤ L.V a ⊓ U from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β a)


def wcpaDjFibRes {Z S : Scheme.{u}} (uu : Z ⟶ S) (y : S) (L : wcpaDjCoc Z) (N : S.Opens)
    (a : Fin L.m) (σ : Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N))
    (τ : Γ(Limits.pullback uu (S.fromSpecResidueField y),
      (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
        Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤)) : Prop :=
  ∃ h : (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
        Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤ ≤
      Limits.pullback.fst uu (S.fromSpecResidueField y) ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N),
    ((Limits.pullback.fst uu (S.fromSpecResidueField y)).appLE (L.V a ⊓ uu ⁻¹ᵁ N) _ h).hom σ = τ
abbrev wcpaTglCF (K : Type u) [Field K] (N : ℕ) : Prop :=
  ∀ (J L j : Fin (N + 1)), wcSgE K N J J = 1 ∧
    (wcProjK K N).basicOpen (wcSgE K N J L) = wcSgD K N J ⊓ wcSgD K N L ∧
    (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op
        (wcSgE K N J j) =
      (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op
          (wcSgE K N J L) *
        (wcProjK K N).presheaf.map
          (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op (wcSgE K N L j)

noncomputable abbrev wcpaTglEps {K : Type u} [Field K] {N : ℕ} {Z : Scheme.{u}}
    (ℓ : Z ⟶ wcProjK K N) (j p : Fin (N + 1)) : Γ(Z, ℓ ⁻¹ᵁ wcSgD K N j) :=
  ℓ.app (wcSgD K N j) (wcSgE K N j p)

abbrev wcpaTglR1 {K : Type u} [Field K] {N : ℕ} {Z : Scheme.{u}} (ℓ : Z ⟶ wcProjK K N) {m : ℕ}
    (V : Fin m → Z.Opens) {r : Fin (N + 1) → ℕ}
    (σ : ∀ i, Fin (r i) → ∀ b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)) (D : ℕ)
    (γ : ∀ i, Fin (r i) → ∀ j b, Γ(Z, V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)) : Prop :=
  ∀ i (c : Fin (r i)) (j : Fin (N + 1)) (b : Fin m),
    Z.presheaf.map (homOfLE (inf_le_left : V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N i ≤
        V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)).op (γ i c j b) =
      Z.presheaf.map (homOfLE (inf_le_left.trans inf_le_right : V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓
          ℓ ⁻¹ᵁ wcSgD K N i ≤ ℓ ⁻¹ᵁ wcSgD K N j)).op (wcpaTglEps ℓ j i) ^ D *
        Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j ⊓ ℓ ⁻¹ᵁ wcSgD K N i ≤ V b ⊓ ℓ ⁻¹ᵁ wcSgD K N i)).op (σ i c b)

abbrev wcpaTglR2 {K : Type u} [Field K] {N : ℕ} {Z : Scheme.{u}} (ℓ : Z ⟶ wcProjK K N)
    (L : wcpaDjCoc Z) (E : ℕ) {r : Fin (N + 1) → ℕ} (D : ℕ)
    (γ : ∀ i, Fin (r i) → ∀ j (b : Fin L.m), Γ(Z, L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)) : Prop :=
  ∀ i (c : Fin (r i)) (b : Fin L.m) (j : Fin (N + 1)) (b' : Fin L.m) (j' : Fin (N + 1)),
    Z.presheaf.map (homOfLE (inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
        (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j')).op (γ i c j' b') =
      Z.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
          (inf_le_right.trans inf_le_left) : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b ⊓ L.V b')).op
          ((L.g b b' : Γ(Z, L.V b ⊓ L.V b')) ^ E) *
        Z.presheaf.map (homOfLE (inf_le_right.trans inf_le_right : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ ℓ ⁻¹ᵁ wcSgD K N j')).op (wcpaTglEps ℓ j' j) ^ D *
        Z.presheaf.map (homOfLE (inf_le_left : (L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j) ⊓
          (L.V b' ⊓ ℓ ⁻¹ᵁ wcSgD K N j') ≤ L.V b ⊓ ℓ ⁻¹ᵁ wcSgD K N j)).op (γ i c j b)
def wcpaDjGcHyp (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) (hτ : ∀ j, τ j ≫ g = 𝟙 S)
    (S'' : Scheme.{u}) (ρ : S'' ⟶ S) (D'' : Set S'') : Prop :=
  wcpaDjStcKmHyp k S Y sS g m τ W mD Dc N I O a ∧
  wcpaDjIsProjOver k (ρ ≫ sS) ∧ IsProper ρ ∧ Surjective ρ ∧
  (∃ V : S.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) ∧
  (∀ s : S'', IsRegularLocalRing (S''.presheaf.stalk s)) ∧ wcpaDjSNCSet S'' D'' ∧
  ⇑ρ ⁻¹' (⋃ i, Dc i) ⊆ D'' ∧ wcpaDjStcPullOrd k g ρ τ hτ D'' O a I

def wcpaDjGcModel (k : Type u) [Field k] {S S'' Y : Scheme.{u}} (sS : S ⟶ Spec (.of k))
    (g : Y ⟶ S) (ρ : S'' ⟶ S) {N : ℕ} (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) {C : Scheme.{u}} (π₅ : C ⟶ Limits.pullback g ρ)
    (A : C ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) : Prop :=
  (∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c)) ∧
  (∃ hA : π₅ ≫ (Limits.pullback.snd g ρ ≫ ρ ≫ sS) =
      A ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))),
    IsFinite (Limits.pullback.lift π₅ A hA)) ∧
  (∃ V : (Limits.pullback g ρ).Opens, V ≠ ⊥ ∧ IsIso (π₅ ∣_ V)) ∧
  (π₅ ⁻¹ᵁ (Limits.pullback.fst g ρ ⁻¹ᵁ O)).ι ≫ A =
    (π₅ ∣_ (Limits.pullback.fst g ρ ⁻¹ᵁ O)) ≫ (Limits.pullback.fst g ρ ∣_ O) ≫ a

def wcpaDjGcPtType {C T : Scheme.{u}} (f : C ⟶ T) (c : C) : Prop :=
  (∃ V : C.Opens, c ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ f)) ∨
  (IsIso (f.residueFieldMap c) ∧
    ∃ (h : AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk (f c)))
        (T.presheaf.stalk (f c)))
      (e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk c)) (C.presheaf.stalk c) ≃+*
        (MvPowerSeries (Fin 2) (AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk (f c)))
          (T.presheaf.stalk (f c))) ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h})),
      h ∈ (IsLocalRing.maximalIdeal (T.presheaf.stalk (f c))).map
        (algebraMap (T.presheaf.stalk (f c)) (AdicCompletion
          (IsLocalRing.maximalIdeal (T.presheaf.stalk (f c))) (T.presheaf.stalk (f c)))) ∧
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk c) (AdicCompletion
          (IsLocalRing.maximalIdeal (C.presheaf.stalk c)) (C.presheaf.stalk c))).comp
          (f.stalkMap c).hom) =
        (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (algebraMap (T.presheaf.stalk (f c))
          (AdicCompletion (IsLocalRing.maximalIdeal (T.presheaf.stalk (f c)))
            (T.presheaf.stalk (f c))))))
def wcSpfRelInj {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type*} [Ring R] (N : ℕ) {A : 𝒜}
    (lamA : R → (A ⟶ A)) : Prop :=
  ∀ {W' W : 𝒜} (i : W' ⟶ W), Mono i → ((N : ℕ) : ℤ) • 𝟙 W = 0 →
    ∀ (lamW' : R → (W' ⟶ W')) (lamW : R → (W ⟶ W)), wcRingAct lamW' → wcRingAct lamW →
    (∀ x, lamW' x ≫ i = i ≫ lamW x) → ∀ g : W' ⟶ A, (∀ x, lamW' x ≫ g = g ≫ lamA x) →
    ∃ h : W ⟶ A, i ≫ h = g ∧ ∀ x, lamW x ≫ h = h ≫ lamA x

noncomputable def wcSpfTwMap {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} {A B : 𝒜}
    (lamA : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (lamB : MonoidAlgebra ℤ_[ℓ] Γ → (B ⟶ B))
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (f : A ⟶ B)
    (hf : ∀ g : Γ, lamA (MonoidAlgebra.single g 1) ≫ f = f ≫ lamB (MonoidAlgebra.single g 1)) :
    wcSpfTw A lamA ρ ⟶ wcSpfTw B lamB ρ :=
  Limits.kernel.map _ _ (Limits.Pi.map (fun _ => f)) (Limits.Pi.map (fun _ => f)) (by
    apply Limits.Pi.hom_ext
    intro aj
    simp only [wcSpfTwD, Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.map_π,
      Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.sub_comp,
      Preadditive.comp_sub, Preadditive.sum_comp, Preadditive.comp_sum,
      Preadditive.nsmul_comp, Preadditive.comp_nsmul, hf])

noncomputable abbrev wcSpfBar {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (A : 𝒜)
    (_lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (_ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ) : 𝒜 :=
  ∏ᶜ (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A)

noncomputable def wcSpfMerge (Γ : Type u) [Group Γ] [Fintype Γ] {p : ℕ}
    (f : Fin (p + 1) → Fin (Fintype.card Γ)) (k : Fin p) : Fin p → Fin (Fintype.card Γ) :=
  fun i => if (i : ℕ) < k then f i.castSucc
    else if (i : ℕ) = k then Fintype.equivFin Γ ((Fintype.equivFin Γ).symm (f i.castSucc) *
      (Fintype.equivFin Γ).symm (f i.succ))
    else f i.succ

noncomputable def wcSpfBarD {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (A : 𝒜)
    (lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ) :
    wcSpfBar A lam ρ p ⟶ wcSpfBar A lam ρ (p + 1) :=
  Limits.Pi.lift (fun fj : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r =>
    Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A) (fun i => fj.1 i.succ, fj.2) ≫
        lam (MonoidAlgebra.single ((Fintype.equivFin Γ).symm (fj.1 0)) 1) +
      ∑ k : Fin p, ((-1 : ℤ) ^ ((k : ℕ) + 1)) •
        Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A)
          (wcSpfMerge Γ fj.1 k, fj.2) +
      ((-1 : ℤ) ^ (p + 1)) • ∑ i : Fin r, wcSpfRhoEnt ρ (fj.1 (Fin.last p)) i fj.2 •
        Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A)
          (fun l => fj.1 l.castSucc, i))

noncomputable def wcSpfBarEps {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (A : 𝒜)
    (lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) :
    wcSpfTw A lam ρ ⟶ wcSpfBar A lam ρ 0 :=
  Limits.kernel.ι (wcSpfTwD A lam ρ) ≫
    Limits.Pi.lift (fun fj : (Fin 0 → Fin (Fintype.card Γ)) × Fin r =>
      Limits.Pi.π (fun _ : Fin r => A) fj.2)
def wcSmsRelInj {R : Type u} [Ring R] {X : CochainComplex AddCommGrpCat.{u+1} ℕ}
    (lamX : R → (X ⟶ X)) (N k : ℕ) : Prop :=
  ∀ (A B : ModuleCat.{u+1} R) (i : A ⟶ B), Function.Injective i.hom → (∀ b : B, N • b = 0) →
    ∀ g : A →+ X.X k, wcChmpLamLin lamX k g →
      ∃ h : B →+ X.X k, wcChmpLamLin lamX k h ∧ ∀ a : A, h (i.hom a) = g a

noncomputable def wcSmsRed (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (Γ : Type u) [Group Γ] :
    MonoidAlgebra ℤ_[ℓ] Γ →+* MonoidAlgebra (ZMod (ℓ ^ n)) Γ :=
  MonoidAlgebra.mapRingHom Γ (PadicInt.toZModPow n)

noncomputable def wcSmsBar {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
    (P : wcGModel ℓ Γ) (n : ℕ) : CochainComplex AddCommGrpCat.{u+1} ℕ :=
  CochainComplex.of
    (fun i => AddCommGrpCat.of (ULift.{u+1} (wcIdemSub ((P.ε i).map (wcSmsRed ℓ n Γ)))))
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom ((P.ε i).map (wcSmsRed ℓ n Γ))
      ((P.ε (i + 1)).map (wcSmsRed ℓ n Γ)) ((P.δ i).map (wcSmsRed ℓ n Γ))
      (by rw [← Matrix.map_mul, P.hδε i]))))
    (fun i => by
      refine AddCommGrpCat.ext (fun x => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, Matrix.vecMul_vecMul, ← Matrix.map_mul, P.hδδ] <;> rfl)

noncomputable def wcSmsBarSmul {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
