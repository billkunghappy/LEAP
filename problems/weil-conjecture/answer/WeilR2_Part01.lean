        haveI : (Scheme.Etale.forget S).LocallyCoverDense (Scheme.etaleTopology.over S) :=
          inferInstanceAs ((MorphismProperty.Over.forget @AlgebraicGeometry.Etale.{u} ⊤ S).LocallyCoverDense
            (S.overGrothendieckTopology @AlgebraicGeometry.Etale.{u}))
