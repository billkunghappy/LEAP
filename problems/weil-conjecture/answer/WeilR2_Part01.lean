abbrev wcEmfEv (r : ℕ) (L : Fin ((r + 2) / 2 - 1 + 1)) : Fin (r + 2) :=
  ⟨2 * L.val, by have := L.isLt; omega⟩

noncomputable abbrev wcEmfU (A : Type u) [CommRing A] (r : ℕ) (π : A)
    (ε : Fin (r + 2) → Fin (r + 2)) (L : Fin ((r + 2) / 2 - 1 + 1)) :
