    (⟨f i, Submonoid.mem_powers _⟩ : Submonoid.powers (f i)))

def wcpaDjTorPtAlg (D : Type u) [CommRing D] [IsLocalRing D] {q : ℕ} (h : Fin q → D) : Prop :=
  ∃ (n : ℕ) (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal D) D)
    (J : Fin q → Finset (Fin n)),
    (n : WithBot ℕ∞) = ringKrullDim D ∧
    Ideal.span (Set.range s) = Ideal.map (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D))
      (IsLocalRing.maximalIdeal D) ∧
    (∀ i i', i ≠ i' → Disjoint (J i) (J i')) ∧
    ∀ i, Associated (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D) (h i))
      (∏ j ∈ J i, s j)

def wcpaDjTorNodeAlg (D : Type u) [CommRing D] [IsLocalRing D] {q : ℕ} (h : Fin q → D) : Prop :=
  ∃ (n : ℕ) (A : Type u) (_ : CommRing A) (_ : IsRegularLocalRing A)
    (_ : IsAdicComplete (IsLocalRing.maximalIdeal A) A)
    (x y v : A) (σ : Fin n → A) (b : Fin n → ℕ)
    (e : AdicCompletion (IsLocalRing.maximalIdeal D) D ≃+*
      (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
    (J : Fin q → Finset (Fin n)),
    IsUnit v ∧ ((n + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A ∧
    Ideal.span ({x, y} ∪ Set.range σ) = IsLocalRing.maximalIdeal A ∧
    (∀ i i', i ≠ i' → Disjoint (J i) (J i')) ∧ (∀ i, (J i).card ≤ 1) ∧
    (∀ l, b l ≠ 0 → ∃ i, l ∈ J i) ∧
    ∀ i, Associated (e (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D) (h i)))
      (Ideal.Quotient.mk _ (∏ l ∈ J i, σ l))

def wcpaDjTorNodeCentre (O : Type u) [CommRing O] [IsLocalRing O] {q : ℕ} (h : Fin q → O)
    (p : Ideal O) : Prop :=
  ∃ (n : ℕ) (A : Type u) (_ : CommRing A) (_ : IsRegularLocalRing A)
    (_ : IsAdicComplete (IsLocalRing.maximalIdeal A) A)
    (x y v : A) (σ : Fin n → A) (b : Fin n → ℕ)
    (e : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+*
      (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
    (J : Fin q → Finset (Fin n)) (T : Finset (Fin n)),
    IsUnit v ∧ ((n + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A ∧
    Ideal.span ({x, y} ∪ Set.range σ) = IsLocalRing.maximalIdeal A ∧
    (∀ i i', i ≠ i' → Disjoint (J i) (J i')) ∧ (∀ i, (J i).card ≤ 1) ∧
    (∀ l, b l ≠ 0 → ∃ i, l ∈ J i) ∧
    (∀ i, Associated (e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (h i)))
      (Ideal.Quotient.mk _ (∏ l ∈ J i, σ l))) ∧
    Ideal.map e (Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) p) =
      Ideal.map (Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
        (Ideal.span ({x, y} ∪ σ '' (T : Set (Fin n)))) ∧
    ((T.card = 1 ∧ ∀ l ∈ T, 2 ≤ b l) ∨ (T.card = 2 ∧ ∀ l ∈ T, b l = 1)) ∧
    ∀ l ∈ T, ∃ i, J i = {l} ∧ h i ∈ p
noncomputable def wcpaDjGltCcG {R : Type u} [CommRing R] {N : ℕ} (I : Finset (Fin (N + 1)))
    (num den : Fin (N + 1) → R) (i : Fin (N + 1)) : R :=
  if i ∈ I then num i * ∏ j ∈ I.erase i, den j else 0
