    (D.obj (Opposite.op l)).hom (MorphismProperty.Over.w (D.map (homOfLE h).op)) G
  ψ k := wcEtInvComp (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
    (MorphismProperty.Over.w (a k)) G
