        (∀ (Z : Cᵒᵖ) (y : K'.obj Z), D.app Z y = 0 → Φ.app Z y = 0) →
        ∃ ψ : K ⟶ I.obj, D ≫ ψ = Φ := by
      intro K' K D Φ h
      have h0 : Limits.kernel.ι D ≫ Φ = 0 := by
        apply NatTrans.ext
        funext Z
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
