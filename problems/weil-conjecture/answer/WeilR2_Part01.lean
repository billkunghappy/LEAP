def wcChartSys (A : Type u) [CommRing A] (n : ℕ)
    (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)]
    (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)]
    (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)]
    (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l)
    (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j)
    (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l)
    (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i) : Prop :=
  (∀ i j a, ρL i j (α1 i a) = α2 i j a) ∧ (∀ i j a, ρR i j (α1 j a) = α2 i j a) ∧
  (∀ i j l a, τ12 i j l (α2 i j a) = α3 i j l a) ∧ (∀ i j l a, τ23 i j l (α2 j l a) = α3 i j l a) ∧
  (∀ i j l a, τ13 i j l (α2 i l a) = α3 i j l a) ∧
  (∀ i j l (x : R1 i), τ12 i j l (ρL i j x) = τ13 i j l (ρL i l x)) ∧
  (∀ i j l (x : R1 j), τ12 i j l (ρR i j x) = τ23 i j l (ρL j l x)) ∧
  (∀ i j l (x : R1 l), τ23 i j l (ρR j l x) = τ13 i j l (ρR i l x)) ∧
  (∀ i (s : R1 i), ∃ p : MvPolynomial (Fin n) A, MvPolynomial.eval₂ (α1 i) (t i) p = s) ∧
  (∀ i, t i i = 1) ∧
  (∀ i j l, ρL i j (t i l) = ρL i j (t i j) * ρR i j (t j l)) ∧
  (∀ i j, IsUnit (ρL i j (t i j)) ∧ (∀ s : R2 i j, ∃ (N : ℕ) (x : R1 i), ρL i j (t i j) ^ N * s = ρL i j x) ∧
      ∀ x : R1 i, ρL i j x = 0 → ∃ N : ℕ, t i j ^ N * x = 0) ∧
  (∀ i j, IsUnit (ρR i j (t j i)) ∧ (∀ s : R2 i j, ∃ (N : ℕ) (x : R1 j), ρR i j (t j i) ^ N * s = ρR i j x) ∧
      ∀ x : R1 j, ρR i j x = 0 → ∃ N : ℕ, t j i ^ N * x = 0) ∧
  (∀ i j l, IsUnit (τ12 i j l (ρL i j (t i j * t i l))) ∧
      (∀ s : R3 i j l, ∃ (N : ℕ) (x : R1 i), τ12 i j l (ρL i j (t i j * t i l)) ^ N * s = τ12 i j l (ρL i j x)) ∧
      ∀ x : R1 i, τ12 i j l (ρL i j x) = 0 → ∃ N : ℕ, (t i j * t i l) ^ N * x = 0) ∧
  (∀ i (x : R1 i), ρR i i x = ρL i i x)

def wcChartH01FG (A : Type u) [CommRing A] (n : ℕ)
    (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)]
    (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)]
    (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)]
    (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j)
    (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j)
    (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l)
    (τ13 : ∀ i j l, R2 i l →+* R3 i j l) : Prop :=
  (∃ (k : ℕ) (c : Fin k → ∀ i, R1 i), ∀ z : ∀ i, R1 i, (∀ i j, ρR i j (z j) = ρL i j (z i)) →
      ∃ b : Fin k → A, z = fun i => ∑ l, α1 i (b l) * c l i) ∧
  (∃ (k : ℕ) (c : Fin k → ∀ p : Fin n × Fin n, R2 p.1 p.2), ∀ z : ∀ p : Fin n × Fin n, R2 p.1 p.2,
      (∀ i j l, τ12 i j l (z (i, j)) + τ23 i j l (z (j, l)) = τ13 i j l (z (i, l))) →
      ∃ (b : Fin k → A) (w : ∀ i, R1 i), z = fun p =>
        ∑ l, α2 p.1 p.2 (b l) * c l p + (ρR p.1 p.2 (w p.2) - ρL p.1 p.2 (w p.1)))
structure wcShObj (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] where
  n : ℕ
  I : Ideal (MvPolynomial (Fin n) R)
  b : (MvPolynomial (Fin n) R ⧸ I) →ₐ[R] A
  et : Algebra.Etale R (MvPolynomial (Fin n) R ⧸ I)

noncomputable instance wcShObj.instCat (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] :
    SmallCategory (wcShObj R A) where
  Hom j j' := {f : (MvPolynomial (Fin j.n) R ⧸ j.I) →ₐ[R] (MvPolynomial (Fin j'.n) R ⧸ j'.I) //
    j'.b.comp f = j.b}
  id j := ⟨AlgHom.id R _, AlgHom.comp_id _⟩
  comp f g := ⟨g.1.comp f.1, by rw [← AlgHom.comp_assoc, g.2, f.2]⟩
  id_comp f := Subtype.ext (AlgHom.comp_id _)
  comp_id f := Subtype.ext (AlgHom.id_comp _)
  assoc f g h := Subtype.ext (AlgHom.comp_assoc _ _ _).symm

noncomputable def wcShD (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] :
    wcShObj R A ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of (MvPolynomial (Fin j.n) R ⧸ j.I)
  map f := CommRingCat.ofHom f.1.toRingHom
  map_id _ := rfl
  map_comp _ _ := rfl
def wcLaurC (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ) (w : ℤ) (σ : Finset (Fin n)) :
    Set (Fin R → (Fin n → ℤ) →₀ A) :=
  {v | ∀ r, v r ∈ Finsupp.supported A A {β : Fin n → ℤ | ∑ i, β i = w - d r ∧ ∀ i, i ∉ σ → 0 ≤ β i}}


noncomputable def wcLaurK (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ)
    (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (w : ℤ)
    (σ : Finset (Fin n)) : Submodule A (Fin R → (Fin n → ℤ) →₀ A) :=
  Submodule.span A {v | ∃ (k : ℕ) (f : Fin R → MvPolynomial (Fin n) A), f ∈ K ∧
      (∀ r, ∀ m ∈ (f r).support, (∑ i, (m i : ℤ)) = w + k * σ.card - d r) ∧
      v = fun r => ∑ m ∈ (f r).support,
        Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((f r).coeff m)}


def wcAltD {A : Type u} [CommRing A] {V : Type u} [AddCommGroup V] [Module A V] (n : ℕ)
    (z : Finset (Fin n) → V) : Finset (Fin n) → V :=
  fun τ => ∑ i ∈ τ, ((-1 : A) ^ (τ.filter (· < i)).card) • z (τ.erase i)


def wcGradedH (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ)
    (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (p : ℕ) (w : ℤ) : Prop :=
  ∃ (k : ℕ) (c : Fin k → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A),
    ∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
      (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) →
      (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ ∈ wcLaurK A n R d K w τ) →
      ∃ (a : Fin k → A) (y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A),
        (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ (p = 0 → y = 0) ∧
        ∀ σ : Finset (Fin n), σ.card = p + 1 →
          z σ - ∑ l, a l • c l σ - wcAltD (A := A) n y σ ∈ wcLaurK A n R d K w σ


noncomputable def wcChartJ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)]
    (α1 : ∀ i, A →+* R1 i) (t : ∀ i : Fin n, Fin n → R1 i) :
    Submodule (MvPolynomial (Fin n) A) (Fin 1 → MvPolynomial (Fin n) A) :=
  Submodule.span (MvPolynomial (Fin n) A) {f | ∃ e : ℕ, (f 0).IsHomogeneous e ∧
    ∀ j, MvPolynomial.eval₂ (α1 j) (t j) (f 0) = 0}
noncomputable def wcLaurEval {A T : Type*} [CommRing A] [CommRing T] (n : ℕ) (α : A →+* T)
    (u : Fin n → T) (v : (Fin n → ℤ) →₀ A) : T :=
  v.sum (fun β c => α c * ∏ k, (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-β k).toNat))
