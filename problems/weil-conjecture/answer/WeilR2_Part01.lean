noncomputable def wcRriP (S : Scheme.{u}) (U : S.ProEt) (M : Type (u+1)) [AddCommGroup M] :
    (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj T := AddCommGrpCat.of (ULift.{u+1} (T.unop ⟶ U) →₀ M)
  map f := AddCommGrpCat.ofHom
    (Finsupp.mapDomain.addMonoidHom (fun φ => ULift.up (f.unop ≫ φ.down)))
  map_id T := by
    apply AddCommGrpCat.hom_ext
    apply Finsupp.addHom_ext
    intro x y
    simp
  map_comp f g := by
    apply AddCommGrpCat.hom_ext
    apply Finsupp.addHom_ext
    intro x y
    simp

noncomputable def wcRriMap (S : Scheme.{u}) (U : S.ProEt) {M N : Type (u+1)} [AddCommGroup M]
    [AddCommGroup N] (f : M →+ N) : wcRriP S U M ⟶ wcRriP S U N where
  app T := AddCommGrpCat.ofHom (Finsupp.mapRange.addMonoidHom f)
  naturality T T' g := by
    apply AddCommGrpCat.hom_ext
    apply Finsupp.addHom_ext
    intro x y
    show Finsupp.mapRange f (map_zero f)
        (Finsupp.mapDomain (fun φ : ULift.{u+1} (T.unop ⟶ U) => ULift.up (g.unop ≫ φ.down))
          (Finsupp.single x y)) =
      Finsupp.mapDomain (fun φ : ULift.{u+1} (T.unop ⟶ U) => ULift.up (g.unop ≫ φ.down))
        (Finsupp.mapRange f (map_zero f) (Finsupp.single x y))
    rw [Finsupp.mapDomain_single, Finsupp.mapRange_single, Finsupp.mapRange_single,
      Finsupp.mapDomain_single]

noncomputable def wcRriIota (S : Scheme.{u}) (U : S.ProEt) {M : Type (u+1)} [AddCommGroup M]
    (m : M) : (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ wcRriP S U M where
  app T := AddCommGrpCat.ofHom
    (FreeAbelianGroup.lift (fun φ : ULift.{u+1} (T.unop ⟶ U) => Finsupp.single φ m))
  naturality T T' g := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    have key : ∀ y : ULift.{u+1} (T.unop ⟶ U),
        FreeAbelianGroup.lift (fun φ : ULift.{u+1} (T'.unop ⟶ U) => Finsupp.single φ m)
          (FreeAbelianGroup.of (ULift.up (g.unop ≫ y.down))) =
        Finsupp.mapDomain (fun φ : ULift.{u+1} (T.unop ⟶ U) => ULift.up (g.unop ≫ φ.down))
          (FreeAbelianGroup.lift (fun φ : ULift.{u+1} (T.unop ⟶ U) => Finsupp.single φ m)
            (FreeAbelianGroup.of y)) := by
      intro y
      rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of, Finsupp.mapDomain_single]
    exact key x

noncomputable def wcRriLift (S : Scheme.{u}) (U : S.ProEt) {M : Type (u+1)} [AddCommGroup M]
    {Q : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
    (g : M →+ ((yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q)) :
    wcRriP S U M ⟶ Q where
