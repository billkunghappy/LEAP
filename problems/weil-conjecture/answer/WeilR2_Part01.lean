  naturality A B f := by
    apply AddCommGrpCat.hom_ext
    have : ((LinearMap.rTensor B (AddMonoidHom.mulLeft a).toIntLinearMap).comp
        (LinearMap.lTensor R f.hom.toIntLinearMap)) =
        ((LinearMap.lTensor R f.hom.toIntLinearMap).comp
        (LinearMap.rTensor A (AddMonoidHom.mulLeft a).toIntLinearMap)) := by
      apply TensorProduct.ext'
      intro r b
      rfl
    ext x
    exact LinearMap.congr_fun this x

