  wcCechFace (fun _ : Fin 1 => Ω) (fun _ => p) (fun _ : Fin 3 => (0 : Fin 1)) j

def wcFpeCocycle (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (c : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2))) : Prop :=
  G.obj.map (wcFpeFace S U Ω p 0).op c - G.obj.map (wcFpeFace S U Ω p 1).op c +
    G.obj.map (wcFpeFace S U Ω p 2).op c = 0
def wcOffS (K : Type u) [Field K] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (d : ℕ) : Set (wcP1Over K).left :=
  {x | d ≠ 0 ∧ x ∈ wcP1ClosedPt K d ∧ ∀ i, x ≠ S i (IsLocalRing.closedPoint K)}

structure wcStalkBasis (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (x : (wcP1Over K).left) (d : ℕ) where
  N : wcFrobNbhd K x d
  r : ℕ
  e : Abelian.Ext (wcFreeSheaf (wcP1Over K).left N.V) G 0 ≃+ (Fin r → ℚ_[ℓ])
  he : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left N.V) G 0),
    e ((Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left N.V) (add_zero 0) y) =
      c • e y

noncomputable def wcStalkLoc (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (x : (wcP1Over K).left) (d : ℕ) :
    Multiset (AlgebraicClosure ℚ_[ℓ]) := by
  classical
  exact if h : Nonempty (wcStalkBasis K ℓ G σ x d) then
    (wcAddEquivMatrix h.some.e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left h.some.N.φ)).precomp
      G (zero_add 0))).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) else 0

def wcZeroAtS (K : Type u) [Field K] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) : Prop :=
  ∀ (i : Fin m) (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
    V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
    ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V) G 0, y = 0

def wcLisseOffS (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) : Prop :=
  ∃ (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (r : ℕ),
    QuasiCompact w.left ∧ ConnectedSpace W.left ∧
    (∀ z, ∀ i, W.hom z ≠ S i (IsLocalRing.closedPoint K)) ∧
    (∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
        ∃ z, w.left z = p) ∧
    wcScalarTriv (wcP1Over K).left ℓ G σ W r

noncomputable def wcPencilKS {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    Subobject (wcPencilVQ D ℓ hP) := by
  classical
  exact if h : ∃ M : Subobject (wcPencilVQ D ℓ hP),
      wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M) ∧
      ∀ M' : Subobject (wcPencilVQ D ℓ hP),
        wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M') → M' ≤ M
    then Classical.choose h else ⊤
noncomputable abbrev wcpaBscPoly {S : Scheme.{u}} (D : wcpaBscChartData S) (i : D.J) :
    Polynomial Γ(S, D.V i) :=
  Polynomial.X ^ 2 - Polynomial.C (D.b i) * Polynomial.X + Polynomial.C (D.a i * D.c i)

noncomputable abbrev wcpaBscChart {S : Scheme.{u}} (D : wcpaBscChartData S) (i : D.J) :
    Scheme.{u} :=
  Spec (CommRingCat.of (AdjoinRoot (wcpaBscPoly D i)))

noncomputable abbrev wcpaBscChartMap {S : Scheme.{u}} (D : wcpaBscChartData S) (i : D.J) :
    wcpaBscChart D i ⟶ S :=
  Spec.map (CommRingCat.ofHom (AdjoinRoot.of (wcpaBscPoly D i))) ≫ (D.affine i).fromSpec
noncomputable def wcOdpJ0 {R : Type u} [CommRing R] {n : ℕ} (t : Fin n → R) (j : Fin n) :
    Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (insert (MvPolynomial.X j - 1)
    (Set.range fun b : Fin n => MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b)))

abbrev wcOdpB {R : Type u} [CommRing R] {n : ℕ} (t : Fin n → R) (j : Fin n)
    (g : MvPolynomial (Fin n) R) : Type u :=
  MvPolynomial (Fin n) R ⧸ (wcOdpJ0 t j ⊔ Ideal.span {g})
/-- Fix A′ (hand replan): the pencil `D` has no MIXED configuration of vanishing cycles, in the
exact form consumed downstream: under the non-isotropy hypothesis, every map from the generic
stalk of `wcPencilE D` to the constant sheaf vanishes. Holds for the Lefschetz pencils built in
`wc_ld_predatum_exists` by conjugacy of vanishing cycles (Deligne, Weil I 5.4). -/
def wcPencilNoMixed {F' F'' : Type u} [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) : Prop :=
  ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (_hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
    (∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) →
    ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP),
      φ = 0
abbrev wcIntXzSum (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (A : PresheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ).obj) (X : S.ProEt) : Type (u+1) :=
  DirectSum (X ⟶ V) (fun a => (A.obj (Opposite.op (wcXzObj S V a)) : Type (u+1)))

noncomputable abbrev wcIntXzSMod (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (A : PresheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ).obj) (X : S.ProEt) (a : X ⟶ V) :
    Module ((wcIntRingSheaf S ℓ).obj.obj (Opposite.op X)) (A.obj (Opposite.op (wcXzObj S V a))) :=
  (inferInstance : Module ((wcIntRingSheaf V.left ℓ).obj.obj (Opposite.op (wcXzObj S V a)))
    (A.obj (Opposite.op (wcXzObj S V a))))

open Classical in
noncomputable def wcIntXzMap (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (A : PresheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ).obj) {X Y : S.ProEt} (g : Y ⟶ X) :
    wcIntXzSum S ℓ V A X →+ wcIntXzSum S ℓ V A Y :=
  DirectSum.toAddMonoid (fun a =>
    (DirectSum.of (fun b : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1)))
      (g ≫ a)).comp (A.map (wcXzRes S V g a).op).hom.toAddMonoidHom)

open Classical in
noncomputable def wcIntXzPre (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (A : PresheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ).obj) :
    (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj X := AddCommGrpCat.of (wcIntXzSum S ℓ V A X.unop)
  map g := AddCommGrpCat.ofHom (wcIntXzMap S ℓ V A g.unop)
  map_id X := by
    have key : ∀ {Y : S.ProEt} {Z : V.left.ProEt} (b b' : Y ⟶ V) (_ : b = b')
        (m : wcXzObj S V b ⟶ Z) (m' : wcXzObj S V b' ⟶ Z) (_ : m.left = m'.left)
        (x : A.obj (Opposite.op Z)),
        DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b
          ((A.map m.op).hom x) =
        DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b'
          ((A.map m'.op).hom x) := by
      intro Y Z b b' hb m m' hm x
      subst hb
      obtain rfl : m = m' := MorphismProperty.Over.Hom.ext hm
      rfl
    apply AddCommGrpCat.hom_ext
    apply DirectSum.addHom_ext
    intro a y
    refine (DirectSum.toAddMonoid_of _ _ _).trans ?_
    refine (key _ a (Category.id_comp a) (wcXzRes S V (𝟙 X.unop) a) (𝟙 (wcXzObj S V a)) rfl
      y).trans ?_
    simp
  map_comp {X Y Z} g h := by
    have key : ∀ {Y : S.ProEt} {Z : V.left.ProEt} (b b' : Y ⟶ V) (_ : b = b')
        (m : wcXzObj S V b ⟶ Z) (m' : wcXzObj S V b' ⟶ Z) (_ : m.left = m'.left)
        (x : A.obj (Opposite.op Z)),
        DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b
          ((A.map m.op).hom x) =
        DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b'
          ((A.map m'.op).hom x) := by
      intro Y Z b b' hb m m' hm x
      subst hb
      obtain rfl : m = m' := MorphismProperty.Over.Hom.ext hm
      rfl
    apply AddCommGrpCat.hom_ext
    apply DirectSum.addHom_ext
    intro a y
    show wcIntXzMap S ℓ V A (h.unop ≫ g.unop) (DirectSum.of _ a y) =
      wcIntXzMap S ℓ V A h.unop (wcIntXzMap S ℓ V A g.unop (DirectSum.of _ a y))
    refine (DirectSum.toAddMonoid_of _ _ _).trans ?_
    refine Eq.trans ?_ (congrArg (wcIntXzMap S ℓ V A h.unop) (DirectSum.toAddMonoid_of _ _ _)).symm
    refine Eq.trans ?_ (DirectSum.toAddMonoid_of _ _ _).symm
    refine (key _ _ (Category.assoc _ _ _) (wcXzRes S V (h.unop ≫ g.unop) a)
      (wcXzRes S V h.unop (g.unop ≫ a) ≫ wcXzRes S V g.unop a) rfl y).trans ?_
    exact congrArg _ (PresheafOfModules.map_comp_apply A (wcXzRes S V g.unop a).op
      (wcXzRes S V h.unop (g.unop ≫ a)).op y)

noncomputable abbrev wcIntXzMod (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (A : PresheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ).obj) (X : (S.ProEt)ᵒᵖ) :
    Module ((wcIntRingSheaf S ℓ).obj.obj X) ((wcIntXzPre S ℓ V A).obj X) :=
  letI := wcIntXzSMod S ℓ V A X.unop
  (inferInstance : Module ((wcIntRingSheaf S ℓ).obj.obj X) (wcIntXzSum S ℓ V A X.unop))

open Classical in
noncomputable def wcIntXzLp0 (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (A : PresheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ).obj) :
    PresheafOfModules.{u+1} (wcIntRingSheaf S ℓ).obj :=
  @PresheafOfModules.ofPresheaf _ _ _ (wcIntXzPre S ℓ V A) (wcIntXzMod S ℓ V A) (by
    intro X Y f r
    letI := wcIntXzSMod S ℓ V A X.unop
    letI := wcIntXzSMod S ℓ V A Y.unop
    show ∀ m : wcIntXzSum S ℓ V A X.unop, wcIntXzMap S ℓ V A f.unop (r • m) =
      ((wcIntRingSheaf S ℓ).obj.map f).hom r • wcIntXzMap S ℓ V A f.unop m
    intro m
    induction m using DirectSum.induction_on with
    | zero => rw [smul_zero, map_zero, smul_zero]
    | of a y =>
      have h1 : ∀ yy : A.obj (Opposite.op (wcXzObj S V a)),
          @id (A.obj (Opposite.op (wcXzObj S V (f.unop ≫ a))))
            ((A.map (wcXzRes S V f.unop a).op).hom (r • yy)) =
          ((wcIntRingSheaf S ℓ).obj.map f).hom r •
            @id (A.obj (Opposite.op (wcXzObj S V (f.unop ≫ a))))
              ((A.map (wcXzRes S V f.unop a).op).hom yy) :=
        fun yy => PresheafOfModules.map_smul A (wcXzRes S V f.unop a).op r yy
      have h2 : (r • DirectSum.of (fun b : X.unop ⟶ V =>
            (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a y : wcIntXzSum S ℓ V A X.unop) =
          DirectSum.of (fun b : X.unop ⟶ V =>
            (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a (r • y) :=
        (DirectSum.of_smul _ _ _ _).symm
      rw [h2]
      refine (DirectSum.toAddMonoid_of _ _ _).trans ?_
      refine Eq.trans ?_ (congrArg (fun z : wcIntXzSum S ℓ V A Y.unop =>
        ((wcIntRingSheaf S ℓ).obj.map f).hom r • z) (DirectSum.toAddMonoid_of _ _ _)).symm
      refine Eq.trans ?_ (DirectSum.of_smul _ _ _ _)
      exact congrArg (DirectSum.of (fun b : Y.unop ⟶ V =>
            (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) (f.unop ≫ a)) (h1 y)
    | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add])
noncomputable abbrev wcpaLqPhi (K : Type u) [Field K] (X : Scheme.{u}) (a : X ⟶ Spec (.of K))
    (x : X) : K →+* X.presheaf.stalk x :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom

def wcpaLqBasis (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (φ : K →+* R)
    (u v : R) : Prop :=
  u ∈ IsLocalRing.maximalIdeal R ∧ v ∈ IsLocalRing.maximalIdeal R ∧
  (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c₁ c₂ : K,
    y - (φ c₁ * u + φ c₂ * v) ∈ IsLocalRing.maximalIdeal R ^ 2) ∧
  (∀ c₁ c₂ : K, φ c₁ * u + φ c₂ * v ∈ IsLocalRing.maximalIdeal R ^ 2 → c₁ = 0 ∧ c₂ = 0)

def wcpaLqHilb (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (φ : K →+* R) :
    Prop :=
  letI : Algebra K R := φ.toAlgebra
  ∀ n : ℕ, 1 ≤ n → Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ n) = 2 * n - 1

def wcpaLqRatNode (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (φ : K →+* R) :
    Prop :=
  wcpaLqHilb K R φ ∧ ∀ u v : R, wcpaLqBasis K R φ u v → ∀ a b c : K, (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0) →
    φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2 ∈ IsLocalRing.maximalIdeal R ^ 3 →
    b ^ 2 - 4 * a * c ≠ 0
/-- Hand replan of `wc_pencil_R_stalk_orth_pairing`: the open of `ℙ¹` off the critical values. -/
noncomputable def wcPencilSOpen {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) :
    (wcP1Over F'').left.Opens :=
  ⟨(⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ,
    isOpen_compl_iff.mpr (isClosed_iUnion_of_finite fun _ => isClosed_closure)⟩

/-- `P̄° = P̄ ∖ (fibres over S)`, as an object of the pro-étale site of `ℙ¹`. -/
noncomputable abbrev wcPencilGeomOffS {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    (wcP1Over F'').left.ProEt :=
  wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP)
/-- Hand replan (GS; de Jong 1996, Lemma 4.11 (ii)(b)): every irreducible component of every
geometric fibre of `f` contains a point near which `f` is smooth of relative dimension 1. -/
def wcpaDjGS {X P : Scheme.{u}} (f : X ⟶ P) : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ P),
    ∀ Z ∈ irreducibleComponents (↥(Limits.pullback f s)), ∃ w ∈ Z,
      ∃ W : (Limits.pullback f s).Opens, w ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd f s)

/-- Hand replan (O4): de Jong's regular projective SNC-alteration theorem in dimension `n`, i.e.
the induction hypothesis `ih` of `hQ` in `wcpa_dejong_regular_projective_alteration`. -/
def wcpaDjAltIH.{w} (n : ℕ) : Prop :=
  ∀ (k : Type w) [Field k] [Finite k] (Y : Scheme.{w})
    [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) [IsProper sY],
    topologicalKrullDim Y = ((n : ℕ) : WithBot ℕ∞) →
    ∀ E : Set Y, IsClosed E → E ≠ Set.univ → wcpaDjSNCAlteration k Y sY E
def wcpaDjMacUp : ℕ → ℕ → ℕ
  | 0, _ => 0
  | e + 1, a =>
    Nat.choose (Nat.findGreatest (fun k => Nat.choose k (e + 1) ≤ a) (a + e + 1) + 1) (e + 2) +
      wcpaDjMacUp e (a - Nat.choose (Nat.findGreatest (fun k => Nat.choose k (e + 1) ≤ a) (a + e + 1)) (e + 1))


noncomputable def wcpaDjHilbFn (K : Type u) [Field K] (N : ℕ)
    (𝔞 : Ideal (MvPolynomial (Fin (N + 1)) K)) (e : ℕ) : ℕ :=
  Module.finrank K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ⧸
    Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
      (Submodule.restrictScalars K 𝔞))


noncomputable abbrev wcpaDjFlrgChart (k : Type u) [Field k] (N : ℕ) {B : Scheme.{u}} (sB : B ⟶ Spec (.of k))
    (V : B.Opens) (i : Fin (N + 1)) : (Limits.pullback (wcProjKStr k N) sB).Opens :=
  (Limits.pullback.fst (wcProjKStr k N) sB ⁻¹ᵁ wcSgD k N i) ⊓
    (Limits.pullback.snd (wcProjKStr k N) sB ⁻¹ᵁ V)


noncomputable def wcpaDjFlrgPsi (k : Type u) [Field k] (N : ℕ) {B : Scheme.{u}}
    (sB : B ⟶ Spec (.of k)) (V : B.Opens) (i : Fin (N + 1)) :
    MvPolynomial (Fin (N + 1)) Γ(B, V) →+*
      Γ(Limits.pullback (wcProjKStr k N) sB, wcpaDjFlrgChart k N sB V i) :=
  MvPolynomial.eval₂Hom
    ((Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
      inf_le_right).hom
    (fun l => ((Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
      (wcpaDjFlrgChart k N sB V i) inf_le_left).hom (wcSgE k N i l))


noncomputable def wcpaDjFlrgHilb (k : Type u) [Field k] (N : ℕ) {B Z : Scheme.{u}} (sB : B ⟶ Spec (.of k))
    (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB)
    (e₀ r L : ℕ) (Φ : ℕ → ℕ) (μ : B ⟶ wcProjK k L)
    (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)) :
    Prop :=
  (1 ≤ e₀ ∧
    Φ e₀ + r = Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) ∧
    ∀ e, e₀ ≤ e → Φ (e + 1) = wcpaDjMacUp e (Φ e)) ∧
