def wcRingFin (H : CommRingCat.{u} ⥤ AddCommGrpCat.{v}) : Prop :=
  ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (R : Λᵒᵖ ⥤ CommRingCat.{u}) (B : CommRingCat.{u})
    (π : ∀ l, R.obj (Opposite.op l) ⟶ B), (∀ {l l' : Λ} (g : l ⟶ l'), R.map g.op ≫ π l = π l') →
    (∀ b : B, ∃ (l : Λ) (r : R.obj (Opposite.op l)), π l r = b) →
    (∀ (l : Λ) (r : R.obj (Opposite.op l)), π l r = 0 → ∃ (l' : Λ) (g : l' ⟶ l), R.map g.op r = 0) →
    (∀ y : H.obj B, ∃ (l : Λ) (x : H.obj (R.obj (Opposite.op l))), H.map (π l) x = y) ∧
    (∀ (l : Λ) (x : H.obj (R.obj (Opposite.op l))), H.map (π l) x = 0 →
      ∃ (l' : Λ) (g : l' ⟶ l), H.map (R.map g.op) x = 0)

def wcTypeFin (Q : CommRingCat.{u} ⥤ Type w) : Prop :=
  ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (R : Λᵒᵖ ⥤ CommRingCat.{u}) (B : CommRingCat.{u})
    (π : ∀ l, R.obj (Opposite.op l) ⟶ B), (∀ {l l' : Λ} (g : l ⟶ l'), R.map g.op ≫ π l = π l') →
    (∀ b : B, ∃ (l : Λ) (r : R.obj (Opposite.op l)), π l r = b) →
    (∀ (l : Λ) (r : R.obj (Opposite.op l)), π l r = 0 → ∃ (l' : Λ) (g : l' ⟶ l), R.map g.op r = 0) →
    (∀ y : Q.obj B, ∃ (l : Λ) (x : Q.obj (R.obj (Opposite.op l))), Q.map (π l) x = y) ∧
    (∀ (l : Λ) (x x' : Q.obj (R.obj (Opposite.op l))), Q.map (π l) x = Q.map (π l) x' →
      ∃ (l' : Λ) (g : l' ⟶ l), Q.map (R.map g.op) x = Q.map (R.map g.op) x')

def wcPresFin (Y : Scheme.{u}) (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) : Prop :=
  ∀ (W : Y.ProEt) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (U' : Λ ⥤ Y.Etale)
    (φ : ∀ l, W ⟶ (wcEtToProEt Y).obj (U'.obj l)),
    (∀ {l l' : Λ} (g : l ⟶ l'), φ l ≫ (wcEtToProEt Y).map (U'.map g) = φ l') →
    (∀ l, IsAffine (U'.obj l).left) →
    (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (U'.obj l).left),
      (∀ {l l' : Λ} (g : l ⟶ l'), z l ≫ (U'.map g).left = z l') →
      ∃! h : Z ⟶ W.left, ∀ l, h ≫ (φ l).left = z l) →
    (∀ s : P.obj (Opposite.op W), ∃ (l : Λ) (t : P.obj (Opposite.op ((wcEtToProEt Y).obj (U'.obj l)))),
      P.map (φ l).op t = s) ∧
    (∀ (l : Λ) (t : P.obj (Opposite.op ((wcEtToProEt Y).obj (U'.obj l)))), P.map (φ l).op t = 0 →
      ∃ (l' : Λ) (g : l' ⟶ l), P.map ((wcEtToProEt Y).map (U'.map g)).op t = 0)
noncomputable def wcLpttEtNuSh (Y : Scheme.{u}) (ℓ n d : ℕ) :
    wcLpttEtUT Y ℓ d ⟶ wcLpttEtSh Y (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0)) :=
  (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcLpttEtNu Y ℓ n d)
noncomputable abbrev wcEtSysExt {Z Y : Scheme.{u}} (g : Z ⟶ Y)
    (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (n : ℕ) :=
  @Abelian.Ext (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) _ _ (HasExt.standard _)
    ((wcEtInv g).obj (wcEtUnitSheaf Y)) F n

open Classical in
noncomputable def wcEtSysPull {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y)
    (he : t ≫ g = e) (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    (F' : Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1})
    (φ : (wcEtInv t).obj F ⟶ F') (n : ℕ) : wcEtSysExt g F n →+ wcEtSysExt e F' n :=
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1}) := HasExt.standard _
  if h : (wcEtInv t).Additive ∧ Limits.PreservesFiniteLimits (wcEtInv t) ∧
      Limits.PreservesFiniteColimits (wcEtInv t) then
    haveI := h.1
    haveI := h.2.1
    haveI := h.2.2
    ((Abelian.Ext.mk₀ φ).postcomp ((wcEtInv e).obj (wcEtUnitSheaf Y)) (add_zero n)).comp
      (((Abelian.Ext.mk₀ (wcEtInvCompInv t g e he (wcEtUnitSheaf Y))).precomp
          ((wcEtInv t).obj F) (zero_add n)).comp
        (Functor.mapExtAddHom (wcEtInv t) ((wcEtInv g).obj (wcEtUnitSheaf Y)) F n))
  else 0

structure wcEtSys {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt)
    (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) where
  F : ∀ k : ℕ, Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op k)).left) AddCommGrpCat.{u+1}
  Finf : Sheaf (Scheme.smallEtaleTopology Uinf.left) AddCommGrpCat.{u+1}
  φ : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F k) ⟶ F l
  ψ : ∀ k : ℕ, (wcEtInv (a k).left).obj (F k) ⟶ Finf

structure wcEtSysHom {S : Scheme.{u}} {Uinf : S.ProEt} {D : ℕᵒᵖ ⥤ S.ProEt}
    {a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)} (A B : wcEtSys D a) where
  f : ∀ k : ℕ, A.F k ⟶ B.F k
  finf : A.Finf ⟶ B.Finf
  comm_φ : ∀ (k l : ℕ) (h : k ≤ l),
    (wcEtInv (D.map (homOfLE h).op).left).map (f k) ≫ B.φ k l h = A.φ k l h ≫ f l
  comm_ψ : ∀ k : ℕ, (wcEtInv (a k).left).map (f k) ≫ B.ψ k = A.ψ k ≫ finf

def wcEtSysOK {S : Scheme.{u}} {Uinf : S.ProEt} {D : ℕᵒᵖ ⥤ S.ProEt}
    {a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)} (A : wcEtSys D a) : Prop :=
  (∀ (k l m : ℕ) (h₁ : k ≤ l) (h₂ : l ≤ m)
      (he : (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left),
      wcEtInvCompInv (D.map (homOfLE h₂).op).left (D.map (homOfLE h₁).op).left
          (D.map (homOfLE (h₁.trans h₂)).op).left he (A.F k) ≫
        (wcEtInv (D.map (homOfLE h₂).op).left).map (A.φ k l h₁) ≫ A.φ l m h₂ =
      A.φ k m (h₁.trans h₂)) ∧
  (∀ (k l : ℕ) (h : k ≤ l) (he : (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left),
      wcEtInvCompInv (a l).left (D.map (homOfLE h).op).left (a k).left he (A.F k) ≫
        (wcEtInv (a l).left).map (A.φ k l h) ≫ A.ψ l = A.ψ k) ∧
  (∀ (V : Uinf.left.Etale) (s : A.Finf.obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Uinf.left.Etale) (h : V' ⟶ V) =>
        ∃ (k : ℕ) (x : ((wcEtInv (a k).left).obj (A.F k)).obj.obj (Opposite.op V')),
          ((A.ψ k).hom.app (Opposite.op V')).hom x = (A.Finf.obj.map h.op).hom s) ∈
        Scheme.smallEtaleTopology Uinf.left V) ∧
  (∀ (k : ℕ) (V : Uinf.left.Etale)
      (x : ((wcEtInv (a k).left).obj (A.F k)).obj.obj (Opposite.op V)),
      ((A.ψ k).hom.app (Opposite.op V)).hom x = 0 →
      Sieve.generate (fun (V' : Uinf.left.Etale) (h : V' ⟶ V) =>
        ∃ (l : ℕ) (hkl : k ≤ l) (he : (a l).left ≫ (D.map (homOfLE hkl).op).left = (a k).left),
          ((wcEtInvCompInv (a l).left (D.map (homOfLE hkl).op).left (a k).left he (A.F k) ≫
              (wcEtInv (a l).left).map (A.φ k l hkl)).hom.app (Opposite.op V')).hom
            ((((wcEtInv (a k).left).obj (A.F k)).obj.map h.op).hom x) = 0) ∈
        Scheme.smallEtaleTopology Uinf.left V)

def wcEtSysCont {S : Scheme.{u}} {Uinf : S.ProEt} {D : ℕᵒᵖ ⥤ S.ProEt}
    {a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)} (A : wcEtSys D a) (n : ℕ) : Prop :=
  (∀ e : wcEtSysExt Uinf.hom A.Finf n,
    ∃ k, ∃ y : wcEtSysExt (D.obj (Opposite.op k)).hom (A.F k) n,
      wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
        (MorphismProperty.Over.w (a k)) (A.F k) A.Finf (A.ψ k) n y = e) ∧
  (∀ k (y : wcEtSysExt (D.obj (Opposite.op k)).hom (A.F k) n),
    wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
        (MorphismProperty.Over.w (a k)) (A.F k) A.Finf (A.ψ k) n y = 0 →
    ∃ l, ∃ h : k ≤ l, wcEtSysPull (D.map (homOfLE h).op).left
        (D.obj (Opposite.op k)).hom (D.obj (Opposite.op l)).hom
        (MorphismProperty.Over.w (D.map (homOfLE h).op)) (A.F k) (A.F l) (A.φ k l h) n y = 0)

noncomputable def wcEtBaseSys {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt)
    (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) : wcEtSys D a where
  F k := (wcEtInv (D.obj (Opposite.op k)).hom).obj G
  Finf := (wcEtInv Uinf.hom).obj G
