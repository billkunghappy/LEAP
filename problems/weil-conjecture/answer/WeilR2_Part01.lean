noncomputable def wcpaDjFK {C : Scheme.{u}} (K : Type u) [Field K] (q : C ⟶ Spec (.of K)) (ξ : C) :
    K →+* C.residueField ξ :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ).hom

def wcpaDjNtV' (K : Type u) {F : Type u} [Field K] [Field F] [Algebra K F]
    (V : ValuationSubring F) : Prop :=
  (∀ c : K, algebraMap K F c ∈ V) ∧ V ≠ ⊤

def wcpaDjFF1 (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] : Prop :=
  ∃ t : F, Transcendental K t ∧ FiniteDimensional (IntermediateField.adjoin K {t}) F

def wcpaDjCtr {C : Scheme.{u}} (L : wcpaDjCoc C) (ξ : C) (V : ValuationSubring (C.residueField ξ))
    (b : Fin L.m) (c : C) : Prop :=
  ∃ (hb : ξ ∈ L.V b) (hc : c ∈ L.V b), wcpaDjChartGood L ξ V b ∧
    ∀ x : Γ(C, L.V b),
      ((C.presheaf.germ (L.V b) c hc).hom x ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk c) ↔
        (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom x ∈ V.nonunits)

def wcpaDjSpecialV {C : Scheme.{u}} {K : Type u} [Field K] (q : C ⟶ Spec (.of K)) {n : ℕ}
    (σ : Fin n → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C) (ξ : C)
    (V : ValuationSubring (C.residueField ξ)) : Prop :=
  ∃ (c : C) (b : Fin L.m), wcpaDjCtr L ξ V b c ∧
    ((¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∨ ∃ i p, σ i p = c)

def wcpaDjLogGen {C T : Scheme.{u}} {n : ℕ} (ξ : C) (V : C.Opens) (hV : ξ ∈ V) {W : T.Opens}
    {r : ℕ} (π : MvPolynomial (Fin (r + 1)) Γ(T, W) →+* Γ(C, V))
    (f : Fin r → MvPolynomial (Fin (r + 1)) Γ(T, W)) (h : Fin n → Γ(C, V))
    (D : C.residueField ξ → C.residueField ξ) (φ : C.residueField ξ) : Prop :=
  ∀ l : Fin (r + 1),
    D ((C.presheaf.germ V ξ hV ≫ C.residue ξ).hom (π (MvPolynomial.X l))) =
      φ * (C.presheaf.germ V ξ hV ≫ C.residue ξ).hom (∏ i, h i) *
        (C.presheaf.germ V ξ hV ≫ C.residue ξ).hom (π (wcpaDjJacMinor f l))
noncomputable def wcpaDjPsK {C : Scheme.{u}} {K : Type u} [Field K] (q : C ⟶ Spec (.of K))
    (ξ : C) : K →+* C.residueField ξ :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ).hom

noncomputable def wcpaDjPsRes {C : Scheme.{u}} (U : C.Opens) (ξ : C) (s : Γ(C, U)) :
    C.residueField ξ := by
  classical
  exact if h : ξ ∈ U then (C.presheaf.germ U ξ h ≫ C.residue ξ).hom s else 0

noncomputable def wcpaDjPsTw {C : Scheme.{u}} (L : wcpaDjCoc C) (a b : Fin L.m) (ξ : C) :
    C.residueField ξ :=
  wcpaDjPsRes (L.V a ⊓ L.V b) ξ (L.g a b : Γ(C, L.V a ⊓ L.V b))

noncomputable def wcpaDjPsSp {C : Scheme.{u}} (x ξ : C) (g : C.presheaf.stalk x) :
    C.residueField ξ := by
  classical
  exact if h : ξ ⤳ x then (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g else 0

def wcpaDjPsInPow {F : Type u} [Field F] (V : ValuationSubring F) (f : F) (n : ℕ) : Prop :=
  ∃ h : f ∈ V, (⟨f, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n

def wcpaDjPsBr {C : Scheme.{u}} {K : Type u} [Field K] (q : C ⟶ Spec (.of K)) (x : C)
    (β : Σ ξ : C, ValuationSubring (C.residueField ξ)) : Prop :=
  closure {β.1} ∈ irreducibleComponents C ∧ β.2 ≠ ⊤ ∧ (∀ c : K, wcpaDjPsK q β.1 c ∈ β.2) ∧
    β.1 ⤳ x ∧ (∀ g : C.presheaf.stalk x, wcpaDjPsInPow β.2 (wcpaDjPsSp x β.1 g) 0) ∧
    ∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x),
      wcpaDjPsInPow β.2 (wcpaDjPsSp x β.1 g) 1
def wcpaScH1 {Y : Scheme.{u}} {M : ℕ} (D : Fin (M + 1) → Y.Opens)
    (E : ∀ k l, Γ(Y, D k ⊓ D l)) (G : Y.Modules) : Prop :=
  ∀ c : ∀ k l, Γ(G, D k ⊓ D l),
    (∀ k l j,
      (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ⊓ D j ≤ D k ⊓ D l)).op).hom (c k l) +
        (Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ⊓ D j ≤ D k ⊓ D l)).op).hom (E k l) •
        (G.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          D k ⊓ D l ⊓ D j ≤ D l ⊓ D j)).op).hom (c l j) =
      (G.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          D k ⊓ D l ⊓ D j ≤ D k ⊓ D j)).op).hom (c k j)) →
    ∃ b : ∀ k, Γ(G, D k), ∀ k l,
      c k l = (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (b k) -
        E k l • (G.presheaf.map (homOfLE (inf_le_right : D k ⊓ D l ≤ D l)).op).hom (b l)

def wcpaScModel {Y : Scheme.{u}} {M : ℕ} (D : Fin (M + 1) → Y.Opens)
    (E : ∀ k l, Γ(Y, D k ⊓ D l)) (G : Y.Modules) (A : Type u) [CommRing A] (R' : ℕ)
    (d : Fin R' → ℕ)
    (K : Submodule (MvPolynomial (Fin (M + 1)) A) (Fin R' → MvPolynomial (Fin (M + 1)) A))
    (H : AddSubgroup (Fin R' → (Fin (M + 1) → ℤ) →₀ A))
    (Θ1 : ∀ k, (Fin R' → (Fin (M + 1) → ℤ) →₀ A) → Γ(G, D k))
    (Θ2 : ∀ k l, (Fin R' → (Fin (M + 1) → ℤ) →₀ A) → Γ(G, D k ⊓ D l))
    (Θ3 : ∀ k l j, (Fin R' → (Fin (M + 1) → ℤ) →₀ A) → Γ(G, D k ⊓ D l ⊓ D j))
    (w : ℕ) : Prop :=
  (∀ k v v', Θ1 k (v + v') = Θ1 k v + Θ1 k v') ∧
  (∀ k l v v', Θ2 k l (v + v') = Θ2 k l v + Θ2 k l v') ∧
  (∀ k l j v v', Θ3 k l j (v + v') = Θ3 k l j v + Θ3 k l j v') ∧
  (∀ k l, k < l → ∀ c : Γ(G, D k ⊓ D l),
    ∃ v ∈ H, v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {k, l} ∧ Θ2 k l v = c) ∧
  (∀ k l, k < l → ∀ v ∈ wcLaurK A (M + 1) R' d K (w : ℤ) {k, l}, Θ2 k l v = 0) ∧
  (∀ k l j, k < l → l < j → ∀ v ∈ H, v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {k, l, j} →
    Θ3 k l j v = 0 → v ∈ wcLaurK A (M + 1) R' d K (w : ℤ) {k, l, j}) ∧
  (∀ k l, k < l → ∀ v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {k},
    Θ2 k l v = (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (Θ1 k v)) ∧
  (∀ k l, k < l → ∀ v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {l},
    Θ2 k l v = E k l • (G.presheaf.map (homOfLE (inf_le_right : D k ⊓ D l ≤ D l)).op).hom (Θ1 l v)) ∧
  (∀ k l j, k < l → l < j → ∀ v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {k, l},
    Θ3 k l j v = (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ⊓ D j ≤ D k ⊓ D l)).op).hom
      (Θ2 k l v)) ∧
  (∀ k l j, k < l → l < j → ∀ v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {k, j},
    Θ3 k l j v = (G.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
      D k ⊓ D l ⊓ D j ≤ D k ⊓ D j)).op).hom (Θ2 k j v)) ∧
  (∀ k l j, k < l → l < j → ∀ v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {l, j},
    Θ3 k l j v = (Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ⊓ D j ≤ D k ⊓ D l)).op).hom
        (E k l) •
      (G.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        D k ⊓ D l ⊓ D j ≤ D l ⊓ D j)).op).hom (Θ2 l j v))

noncomputable def wcpaScE {Y : Scheme.{u}} {M : ℕ} (D : Fin (M + 1) → Y.Opens)
    (x : Fin (M + 1) → ∀ K, Γ(Y, D K)) (n : ℕ) (k l : Fin (M + 1)) : Γ(Y, D k ⊓ D l) :=
  (Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (x l k) ^ n

def wcpaScPow {Y : Scheme.{u}} {M : ℕ} (D : Fin (M + 1) → Y.Opens) (x : Fin (M + 1) → ∀ K, Γ(Y, D K))
    (n : ℕ) : Prop :=
  ∀ i J K, (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x i K) ^ n =
    (Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (x i J) ^ n *
      (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^ n

def wcpaScTw {Y : Scheme.{u}} {M : ℕ} (D : Fin (M + 1) → Y.Opens) (x : Fin (M + 1) → ∀ K, Γ(Y, D K))
    (G : Y.Modules) {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K)) (n : ℕ) : Prop :=
  ∀ ρ J K, (G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (σ ρ K) =
    (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^ n •
      (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (σ ρ J)

noncomputable def wcpaScPEv {Y : Scheme.{u}} {R : Type u} [CommRing R] {M : ℕ} {U₀ : Y.Opens}
    (φ₀ : R →+* Γ(Y, U₀)) {D : Fin (M + 1) → Y.Opens} (hDU : ∀ J, D J ≤ U₀)
    (x : Fin (M + 1) → ∀ K, Γ(Y, D K)) {G : Y.Modules} (r : ℕ) {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K))
    (K : Fin (M + 1)) (f : Fin q → MvPolynomial (Fin (M + 1)) R) : Γ(G, D K) :=
  wcKlmPEv (⇑((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)) (fun i => x i K ^ r)
    (fun ρ => σ ρ K) f

def wcpaScGen {Y : Scheme.{u}} {R : Type u} [CommRing R] {M : ℕ} {U₀ : Y.Opens}
    (φ₀ : R →+* Γ(Y, U₀)) {D : Fin (M + 1) → Y.Opens} (hDU : ∀ J, D J ≤ U₀)
    (x : Fin (M + 1) → ∀ K, Γ(Y, D K)) {G : Y.Modules} (r : ℕ) {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K)) :
    Prop :=
  ∀ K (g : Γ(G, D K)), ∃ f : Fin q → MvPolynomial (Fin (M + 1)) R,
    g = wcpaScPEv φ₀ hDU x r σ K f

def wcpaScChg {Y : Scheme.{u}} {R : Type u} [CommRing R] {M : ℕ} {U₀ : Y.Opens}
    (φ₀ : R →+* Γ(Y, U₀)) {D : Fin (M + 1) → Y.Opens} (hDU : ∀ J, D J ≤ U₀)
    (x : Fin (M + 1) → ∀ K, Γ(Y, D K)) {G : Y.Modules} (r n : ℕ) {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K)) :
    Prop :=
  ∀ (J K : Fin (M + 1)) (t : ℕ) (f : Fin q → MvPolynomial (Fin (M + 1)) R),
    (∀ ρ, (f ρ).IsHomogeneous t) →
    (G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom
        (wcpaScPEv φ₀ hDU x r σ K f) =
      (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^ (r * t + n) •
        (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom
          (wcpaScPEv φ₀ hDU x r σ J f)

def wcpaScSurj {Y : Scheme.{u}} {R : Type u} [CommRing R] {M : ℕ} {U₀ : Y.Opens}
    (φ₀ : R →+* Γ(Y, U₀)) {D : Fin (M + 1) → Y.Opens} (hDU : ∀ J, D J ≤ U₀)
    (x : Fin (M + 1) → ∀ K, Γ(Y, D K)) {G : Y.Modules} (r : ℕ) {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K)) :
    Prop :=
  ∀ (k l : Fin (M + 1)) (c : Γ(G, D k ⊓ D l)),
    ∃ (n : ℕ) (f : Fin q → MvPolynomial (Fin (M + 1)) R),
      ((Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (x l k) ^ r) ^ n • c =
        (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom
          (wcpaScPEv φ₀ hDU x r σ k f)

def wcpaScSat {Y : Scheme.{u}} {R : Type u} [CommRing R] {M : ℕ} {U₀ : Y.Opens}
    (φ₀ : R →+* Γ(Y, U₀)) {D : Fin (M + 1) → Y.Opens} (hDU : ∀ J, D J ≤ U₀)
    (x : Fin (M + 1) → ∀ K, Γ(Y, D K)) {G : Y.Modules} (r : ℕ) {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K)) :
    Prop :=
  ∀ (k l j : Fin (M + 1)) (t : ℕ) (f : Fin q → MvPolynomial (Fin (M + 1)) R),
    (∀ ρ, (f ρ).IsHomogeneous t) →
    (G.presheaf.map (homOfLE (show D k ⊓ D l ⊓ D j ≤ D k from
        inf_le_left.trans inf_le_left)).op).hom (wcpaScPEv φ₀ hDU x r σ k f) = 0 →
    ∃ N : ℕ, ∀ J, wcpaScPEv φ₀ hDU x r σ J
      (fun ρ => (MvPolynomial.X k * MvPolynomial.X l * MvPolynomial.X j) ^ N * f ρ) = 0
noncomputable def wcpaLccScal {X : Scheme.{u}} {K : Type u} [Field K] (g : X ⟶ Spec (.of K))
    (V : X.Opens) : K →+* Γ(X, V) :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫ X.presheaf.map (homOfLE le_top).op).hom

noncomputable def wcpaLccPullFam {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) {K : Type u}
    [Field K] (s : Spec (.of K) ⟶ T) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)) (a : Fin L.m) :
    Γ(Limits.pullback q s, (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓
      (Limits.pullback.snd q s) ⁻¹ᵁ ⊤) :=
  ((Limits.pullback.fst q s).appLE (L.V a ⊓ q ⁻¹ᵁ ⊤)
    ((wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)
    (fun _ hx => ⟨hx.1, trivial⟩)).hom (t a)

def wcpaLccBC {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (e : ℕ) : Prop :=
  ∃ (N : ℕ) (b : Fin N → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
    (∀ j, wcpaDjCompat L (q ⁻¹ᵁ ⊤) e (b j)) ∧
    (∀ t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCompat L (q ⁻¹ᵁ ⊤) e t →
      ∃! c : Fin N → Γ(T, ⊤), ∀ a, t a =
        ∑ j, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom (c j) * b j a) ∧
    ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ T)
      (t' : ∀ a : Fin L.m, Γ(Limits.pullback q s,
        (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)),
      wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q s) L)
        ((Limits.pullback.snd q s) ⁻¹ᵁ ⊤) e t' →
      ∃! c : Fin N → K, ∀ a, t' a =
        ∑ j, wcpaLccScal (Limits.pullback.snd q s) _ (c j) * wcpaLccPullFam q L s (b j) a

def wcpaLccGG {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (e : ℕ) : Prop :=
  ∃ (M : ℕ) (s : Fin M → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
    (∀ J, wcpaDjCompat L (q ⁻¹ᵁ ⊤) e (s J)) ∧ (⨆ J, ⨆ a, Y.basicOpen (s J a)) = ⊤

def wcpaLccHAF {Z₁ T : Scheme.{u}} (u₁ : Z₁ ⟶ T) {r : ℕ} (ε : Fin r → (T ⟶ Z₁)) : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T)
    (E : Set ↥(Limits.pullback u₁ s)), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
    (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
      (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
      ι ≫ Limits.pullback.snd u₁ s) ∧
    1 ≤ (E ∩ closure Eᶜ).ncard ∧ (E ∩ closure Eᶜ).ncard ≤ 2 ∧
    ∀ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      E' = E

def wcpaLccFib {Z₁ Z T : Scheme.{u}} (u₁ : Z₁ ⟶ T) (uu : Z ⟶ T) (φ : Z₁ ⟶ Z) {r : ℕ}
    (ε : Fin r → (T ⟶ Z₁)) : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T)
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s),
    φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ →
    φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s →
    Function.Surjective ⇑φs ∧
    (∀ C : Set ↥(Limits.pullback uu s), C ∈ irreducibleComponents ↥(Limits.pullback uu s) →
      (C ∩ closure Cᶜ).Finite) ∧
    (∀ x y : ↥(Limits.pullback u₁ s), φs x = φs y → x = y ∨
      ∃ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
        (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
        x ∈ E ∧ y ∈ E) ∧
    (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      ∀ x ∈ E, ∀ y ∈ E, φs x = φs y) ∧
    (∃ V : (Limits.pullback u₁ s).Opens,
      (∀ x : ↥(Limits.pullback u₁ s), x ∈ V ↔ ∀ E : Set ↥(Limits.pullback u₁ s),
        E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
        (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
        x ∉ E) ∧
      IsOpenImmersion (V.ι ≫ φs)) ∧
    (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      (E ∩ closure Eᶜ).ncard = 1 → ∀ x ∈ E, ∃ W' : (Limits.pullback uu s).Opens,
        φs x ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ Limits.pullback.snd uu s)) ∧
    (∀ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      ¬ (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      ⇑φs '' E' ∈ irreducibleComponents ↥(Limits.pullback uu s) ∧
      ((∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = ⇑φs '' E' ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd uu s) →
      (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E' ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u₁ s) ∧ Set.InjOn ⇑φs E')) ∧
    ∀ C : Set ↥(Limits.pullback uu s), C ∈ irreducibleComponents ↥(Limits.pullback uu s) →
      ∃ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
        ¬ (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
