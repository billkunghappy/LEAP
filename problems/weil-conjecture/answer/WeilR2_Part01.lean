def wcSmpcgbtiGauss {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (M : Type u) [Field M] [Algebra K M]
    (𝔭 : Ideal A) (t : A) (c b : ↥W) (V : ValuationSubring M) : Prop :=
  (∀ a : A, algebraMap K M (algebraMap A K a) ∈ V) ∧
  (∀ a : A, V.valuation (algebraMap K M (algebraMap A K a)) < 1 ↔ a ∈ 𝔭) ∧
  (∀ w₁ w₂ : ↥W,
    V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w₁) ≤
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w₂) ↔
      w₂ ∣ w₁) ∧
  V.valuation (algebraMap K M (algebraMap A K (t - algebraMap ↥W A c))) =
    V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) b) ∧
  ∀ p : Polynomial ↥W, (∃ i, p.coeff i ∉ IsLocalRing.maximalIdeal ↥W) →
    V.valuation (p.eval₂ ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
        algebraMap A K (t - algebraMap ↥W A c)))) = 1
inductive fexPtTower (B : Type u) [CommRing B] [IsLocalRing B] :
    (Y : Scheme.{u}) → (Y ⟶ Spec (.of B)) → Prop
  | base : fexPtTower B (Spec (.of B)) (𝟙 _)
  | step {Y Y' : Scheme.{u}} (g : Y ⟶ Spec (.of B)) (y : Y) (hy : IsClosed ({y} : Set Y))
      (r : Y' ⟶ Y) : fexPtTower B Y g → g y = IsLocalRing.closedPoint B →
      wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal
        (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)) r →
      fexPtTower B Y' (r ≫ g)
