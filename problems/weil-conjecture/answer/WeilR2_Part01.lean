open Classical in
noncomputable def wc2kA (n : ℕ) : Finset (AlgebraicClosure (ZMod 2)) :=
  ((Polynomial.X ^ (2 ^ n) - Polynomial.X :
    Polynomial (AlgebraicClosure (ZMod 2))).roots.toFinset).erase 0

noncomputable def wc2kTr (n : ℕ) (u : AlgebraicClosure (ZMod 2)) : AlgebraicClosure (ZMod 2) :=
  ∑ i ∈ Finset.range n, u ^ (2 ^ i)

open Classical in
noncomputable def wc2kPsi (n : ℕ) (u : AlgebraicClosure (ZMod 2)) : ℤ :=
  if wc2kTr n u = 0 then 1 else -1

noncomputable def wc2kKl (n : ℕ) (z : AlgebraicClosure (ZMod 2)) : ℤ :=
  ∑ y ∈ wc2kA n, wc2kPsi n (y + z / y)

def wc2kS : ℕ → ℤ → ℤ → ℤ
  | 0, _, _ => 1
  | 1, s, _ => s
  | m + 2, s, Q => s * wc2kS (m + 1) s Q - Q * wc2kS m s Q
