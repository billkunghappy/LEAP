    have hQ : Presieve.IsSheaf (Scheme.smallEtaleTopology X) (Qs.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology X) _).1
        (GrothendieckTopology.HasSheafCompose.isSheaf Qs.obj Qs.property)
    have hIt : Presieve.IsSheaf (Scheme.smallEtaleTopology X) (I ⋙ forget AddCommGrpCat.{u+1}) := by
      intro Z0 R hR x hx
