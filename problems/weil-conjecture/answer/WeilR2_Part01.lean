noncomputable def wcTwEqPre {C : Type*} [Category C] (F : Cᵒᵖ ⥤ AddCommGrpCat.{w})
    {ι : Type*} (a b : ι → (F ⟶ F)) : Cᵒᵖ ⥤ AddCommGrpCat.{w} where
