noncomputable def wcSpfKerMap {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) (g : Y ⟶ Y) (k : ℕ) :
    Limits.kernel (N • 𝟙 (Y.X k)) ⟶ Limits.kernel (N • 𝟙 (Y.X k)) :=
  Limits.kernel.map (N • 𝟙 (Y.X k)) (N • 𝟙 (Y.X k)) (g.f k) (g.f k)
    (by simp only [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
      Category.comp_id])

noncomputable def wcSpfTruncMapF {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) (g : Y ⟶ Y) : (k : ℕ) → wcTruncKerX Y N k ⟶ wcTruncKerX Y N k
  | 0 => Limits.cokernel.map (wcTruncKerD Y N 0) (wcTruncKerD Y N 0) (wcSpfKerMap Y N g 0)
      (wcSpfKerMap Y N g 1) (by
        ext
        simp [wcTruncKerD, wcSpfKerMap, Limits.kernel.map])
  | k + 1 => wcSpfKerMap Y N g (k + 2)

noncomputable def wcSpfTruncMap {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) (g : Y ⟶ Y) : wcTruncKerRes Y N ⟶ wcTruncKerRes Y N :=
  CochainComplex.ofHom (X := wcTruncKerRes Y N) (Y := wcTruncKerRes Y N)
    (wcSpfTruncMapF Y N g) (fun k => by
      have key : ∀ k, wcSpfTruncMapF Y N g k ≫ wcTruncKerDiff Y N k =
          wcTruncKerDiff Y N k ≫ wcSpfTruncMapF Y N g (k + 1) := by
        intro k
        cases k with
        | zero =>
          have h0 : ∀ (a : Limits.cokernel (wcTruncKerD Y N 0) ⟶ Limits.cokernel (wcTruncKerD Y N 0))
              (b : Limits.cokernel (wcTruncKerD Y N 0) ⟶ Limits.kernel (N • 𝟙 (Y.X 2)))
              (c : Limits.kernel (N • 𝟙 (Y.X 2)) ⟶ Limits.kernel (N • 𝟙 (Y.X 2))),
              Limits.cokernel.π (wcTruncKerD Y N 0) ≫ a =
                wcSpfKerMap Y N g 1 ≫ Limits.cokernel.π (wcTruncKerD Y N 0) →
              Limits.cokernel.π (wcTruncKerD Y N 0) ≫ b = wcTruncKerD Y N 1 →
              wcTruncKerD Y N 1 ≫ c = wcSpfKerMap Y N g 1 ≫ wcTruncKerD Y N 1 →
              a ≫ b = b ≫ c := by
            intro a b c ha hb hc
            refine (cancel_epi (Limits.cokernel.π (wcTruncKerD Y N 0))).1 ?_
            rw [← Category.assoc, ha, Category.assoc, hb, ← Category.assoc, hb, hc]
          exact h0 _ _ (wcSpfKerMap Y N g 2) (Limits.cokernel.π_desc _ _ _)
            (Limits.cokernel.π_desc _ _ _) (by
              apply Limits.equalizer.hom_ext
              simp [wcTruncKerD, wcSpfKerMap, Limits.kernel.map])
        | succ k =>
          show wcSpfKerMap Y N g (k + 2) ≫ wcTruncKerD Y N (k + 2) =
            wcTruncKerD Y N (k + 2) ≫ wcSpfKerMap Y N g (k + 3)
          apply Limits.equalizer.hom_ext
          simp [wcTruncKerD, wcSpfKerMap, Limits.kernel.map]
      simpa only [wcTruncKerRes, CochainComplex.of_d] using key k)

