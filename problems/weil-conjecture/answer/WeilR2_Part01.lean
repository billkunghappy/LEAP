      exact e



  have acycQ : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] {G I Q : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (ι : G ⟶ I) (π : I ⟶ Q), (∀ (W : C) (x : G.obj (Opposite.op W)), ι.app (Opposite.op W) x = 0 → x = 0) → (∀ (W : C) (y : I.obj (Opposite.op W)), π.app (Opposite.op W) y = 0 → ∃ x, ι.app (Opposite.op W) x = y) → (∀ (W : C) (x : G.obj (Opposite.op W)), π.app (Opposite.op W) (ι.app (Opposite.op W) x) = 0) → ∀ {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U), (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), Function.Surjective (π.app (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))) → (∀ (p : ℕ) (b : ∀ σ : Fin (p + 1) → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (ρ : Fin (p + 3) → Fin k), ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) • I.map (wcCechFace V f ρ j).op (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) • I.map (wcCechFace V f (fun l => ρ (j.succAbove l)) i).op (b (fun l => ρ (j.succAbove (i.succAbove l))))) = 0) → wcCechAcyclic G V f → wcCechAcyclic I V f → wcCechAcyclic Q V f := by
