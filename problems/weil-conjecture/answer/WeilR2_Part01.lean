    (∀ (a b c : Fin L.m) (x : Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V c)),
      x ∈ Ideal.map (wcCnSigma h ((wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V c))
        (I ^ (n + 1)) →
