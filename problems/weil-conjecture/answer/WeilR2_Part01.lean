    obtain ⟨e', he'⟩ := wc_et_gm_field_affine_coboundary X.functionField hL I n
      ((wcEtBaseChange (X.fromSpecStalk (genericPoint X))).obj W) hAff _ hc'
    exact ⟨W, g, w, e', hw, he'⟩
  have hacyc : ∀ m : ℕ, 1 ≤ m → Limits.IsZero ((((wcEtPush (X.fromSpecStalk (genericPoint X))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).homology m) := by
    intro m hm
    obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    exact wc_et_push_homology_zero_of_locKill _ I.cocomplex m' (hkill m')

  obtain ⟨E₂⟩ := wc_ext_degenerate_leray_equiv L (wcEtPush (X.fromSpecStalk (genericPoint X))) adj
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcEtGm (Spec (X.presheaf.stalk (genericPoint X)))) I hacyc (q + 1)

  haveI hK : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
      (Spec (X.presheaf.stalk (genericPoint X)))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (X.presheaf.stalk (genericPoint X)))) (q + 1)) :=
    hL X.functionField inferInstance q
  haveI hLsub : Subsingleton (Abelian.Ext (L.obj ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))
      (wcEtGm (Spec (X.presheaf.stalk (genericPoint X)))) (q + 1)) := by
    constructor
    intro x y
    have key : ∀ z : Abelian.Ext (L.obj ((constantSheaf (Scheme.smallEtaleTopology X)
