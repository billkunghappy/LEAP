def wcLatticeData (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (Uo : (wcP1Over K).left.Opens) (r : ℕ) (V : ℕ → Scheme.{u})
    (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u) [∀ n, Group (Γ n)]
    (α : (n : ℕ) → Γ n →* Aut (V n)) (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hα : ∀ n γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι)
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (ι : L ⟶ G) (lam : ℤ_[ℓ] → (L ⟶ L))
    (π : ∀ n, L ⟶ wcTwSh (q' n ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r (ρ n))
    (τ : ∀ n, wcTwSh (q' (n + 1) ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ (n + 1)) (α (n + 1))
        (hα (n + 1)) ℓ (n + 1) r (ρ (n + 1)) ⟶
      wcTwSh (q' n ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r (ρ n)) :
    Prop :=
  (lam 1 = 𝟙 L ∧ (∀ a b : ℤ_[ℓ], lam (a + b) = lam a + lam b) ∧
      (∀ a b : ℤ_[ℓ], lam (a * b) = lam b ≫ lam a) ∧
      ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ])) ∧
    Mono ι ∧
    (∀ T : (wcP1Over K).left.ProEt, CompactSpace T.left →
      (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) →
      ∀ s : G.obj.obj (Opposite.op T),
      ∃ (k : ℕ) (s' : L.obj.obj (Opposite.op T)),
        (ι.hom.app (Opposite.op T)).hom s' = ((σ ((ℓ : ℚ_[ℓ]) ^ k)).hom.app (Opposite.op T)).hom s) ∧
    (∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0, (ShortComplex.mk _ _ w).ShortExact) ∧
    (∀ (T : (wcP1Over K).left.ProEt) (s : L.obj.obj (Opposite.op T)),
      (∀ n : ℕ, s ∈ ((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom.range) → s = 0) ∧
    (∀ n, 1 ≤ n → π (n + 1) ≫ τ n = π n) ∧
    (∀ (T : (wcP1Over K).left.ProEt)
      (x : ∀ n, (wcTwSh (q' n ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r
          (ρ n)).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n)

def wcCokerTorsion (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {G L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}} (ι : L ⟶ G) :
    Prop :=
  (∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ι) 0, ∃ k : ℕ, (ℓ ^ k) • z = 0) ∧
  (∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ι) 1, ∃ k : ℕ, (ℓ ^ k) • z = 0)

