    intro z
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  rw [← key x, ← key y, Subsingleton.elim (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))
