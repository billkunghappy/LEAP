def wcpaDjKummerOrd {S S'' : Scheme.{u}} (ρ : S'' ⟶ S) (m : ℕ) (Dc : Fin m → Set S)
    (D'' : Set S'') (d B : ℕ) : Prop :=
  ∀ (s : S'') (n : ℕ) (t : Fin n → S.presheaf.stalk (ρ s))
    (a : {i : Fin m // ρ s ∈ Dc i} → Fin n),
    (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk (ρ s)) →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk (ρ s)) →
    Function.Injective a →
    (∀ (i : {i : Fin m // ρ s ∈ Dc i}) (p' : S) (h : p' ⤳ ρ s),
      (p' ∈ Dc i.1 ↔ (S.presheaf.stalkSpecializes h).hom (t (a i)) ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk p'))) →
    ∃ (n'' : ℕ) (t'' : Fin n'' → S''.presheaf.stalk s) (J'' : Finset (Fin n''))
      (M : {i : Fin m // ρ s ∈ Dc i} → Fin n'' → ℕ),
      (n'' : WithBot ℕ∞) = ringKrullDim (S''.presheaf.stalk s) ∧
      Ideal.span (Set.range t'') = IsLocalRing.maximalIdeal (S''.presheaf.stalk s) ∧
      (∀ (s' : S'') (h : s' ⤳ s), s' ∈ D'' ↔ ∃ l ∈ J'',
        (S''.presheaf.stalkSpecializes h).hom (t'' l) ∈
          IsLocalRing.maximalIdeal (S''.presheaf.stalk s')) ∧
      (∀ i l, M i l ≠ 0 → l ∈ J'') ∧
      (∀ i l, d ∣ M i l) ∧
      (∀ i, ∃ v : (S''.presheaf.stalk s)ˣ,
        (ρ.stalkMap s).hom (t (a i)) = ↑v * ∏ l, t'' l ^ M i l) ∧
      ∀ γ γ' : {i : Fin m // ρ s ∈ Dc i} → ℕ, (∀ i, γ i ≤ B) → (∀ i, γ' i ≤ B) →
        (∀ l, ∑ i, γ i * M i l ≤ ∑ i, γ' i * M i l) ∨
          (∀ l, ∑ i, γ' i * M i l ≤ ∑ i, γ i * M i l)
def wcStrictResSpec {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {Γ : Type*} [Group Γ]
    {A : 𝒜} (ρA : Γ → (A ⟶ A)) (J : InjectiveResolution A)
    (ρJ : Γ → (J.cocomplex ⟶ J.cocomplex)) : Prop :=
  ρJ 1 = 𝟙 _ ∧ (∀ a b, ρJ (a * b) = ρJ b ≫ ρJ a) ∧
  (∀ a, J.ι.f 0 ≫ (ρJ a).f 0 = ρA a ≫ J.ι.f 0) ∧
  ∀ (n : ℕ) {Y W : 𝒜} (i : Y ⟶ W) [Mono i] (ρY : Γ → (Y ⟶ Y)) (ρW : Γ → (W ⟶ W)),
    (∀ a b, ρY (a * b) = ρY b ≫ ρY a) → (∀ a b, ρW (a * b) = ρW b ≫ ρW a) →
    ρY 1 = 𝟙 Y → ρW 1 = 𝟙 W → (∀ a, ρY a ≫ i = i ≫ ρW a) →
    ∀ g : Y ⟶ J.cocomplex.X n, (∀ a, ρY a ≫ g = g ≫ (ρJ a).f n) →
      ∃ h : W ⟶ J.cocomplex.X n, i ≫ h = g ∧ ∀ a, ρW a ≫ h = h ≫ (ρJ a).f n
noncomputable abbrev wcpaBscU {S : Scheme.{u}} (D : wcpaBscChartData S) (i j : D.J) :
    Γ(S, D.V i ⊓ D.V j) :=
  (D.lam i j : Γ(S, D.V i ⊓ D.V j)) * (D.M i j 0 0 * D.M i j 1 1 - D.M i j 0 1 * D.M i j 1 0)

noncomputable abbrev wcpaBscBeta {S : Scheme.{u}} (D : wcpaBscChartData S) (i j : D.J) :
    Γ(S, D.V i ⊓ D.V j) :=
  (D.lam i j : Γ(S, D.V i ⊓ D.V j)) *
    (wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) (D.a i) * (D.M i j 0 0 * D.M i j 0 1) +
      wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) (D.b i) * (D.M i j 0 1 * D.M i j 1 0) +
      wcpaBscRes S (inf_le_left : D.V i ⊓ D.V j ≤ D.V i) (D.c i) * (D.M i j 1 0 * D.M i j 1 1))
noncomputable def wcHypBaseMap {A L : Type u} [CommRing A] [CommRing L] (lam : A →+* L) (n : ℕ)
    (π : A) :
    wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+*
      wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) :=
  Ideal.quotientMap _ (MvPolynomial.map lam) (by
    show Ideal.span _ ≤ Ideal.comap _ (Ideal.span _)
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
    apply Ideal.subset_span
    rw [Set.mem_singleton_iff]
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, Matrix.of_apply,
      apply_ite lam, map_one, map_zero])
def wcPcmLift {R C D B : Type*} [CommRing R] [CommRing C] [CommRing D] [CommRing B]
    [Algebra R C] [Algebra R D] [Algebra R B] (π : D →ₐ[R] B) (ν : C →ₐ[R] B) (e : R)
    (φ : C →ₐ[R] Localization.Away (algebraMap R D e)) : Prop :=
  ∀ (c : C) (x : D) (N : ℕ),
    φ c = IsLocalization.mk' (Localization.Away (algebraMap R D e)) x
      (⟨algebraMap R D e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D e)) →
    ∃ K : ℕ, e ^ K • (π x - e ^ N • ν c) = 0
def wcEtTplStar {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
