theorem wc_et_field_galois_refinement : ∀ (L : Type u) [Field L] (U : (Spec (.of L)).Etale), IsAffine U.left → ∀ R ∈ Scheme.smallEtaleTopology (Spec (.of L)) U, ∃ (k : ℕ) (V : Fin k → (Spec (.of L)).Etale) (f : ∀ i, V i ⟶ U), wcEtGalCov L U k V f ∧ ∀ i, R.arrows (f i) :=
by
  intro L _ U hU R hR

  have s3a : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [FormallyUnramified f] [LocallyOfFiniteType f]
      (x : X), letI : Algebra (Y.residueField (f x)) (X.residueField x) :=
        (f.residueFieldMap x).hom.toAlgebra
      Module.Finite (Y.residueField (f x)) (X.residueField x) := by
    intro X Y f _ _ x
    algebraize [(f.stalkMap x).hom]
    have : IsLocalHom (algebraMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
      inferInstanceAs <| IsLocalHom (f.stalkMap x).hom
    have : Algebra.EssFiniteType (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := by
      rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
      exact LocallyOfFiniteType.stalkMap f x
    have : Algebra.FormallyUnramified (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := by
      rw [← RingHom.formallyUnramified_algebraMap, RingHom.algebraMap_toAlgebra]
      exact FormallyUnramified.stalkMap f x
    have h : Module.Finite (IsLocalRing.ResidueField (Y.presheaf.stalk (f x)))
        (IsLocalRing.ResidueField (X.presheaf.stalk x)) := inferInstance
    have h2 : (algebraMap (IsLocalRing.ResidueField (Y.presheaf.stalk (f x)))
        (IsLocalRing.ResidueField (X.presheaf.stalk x))).Finite := RingHom.finite_algebraMap.mpr h
    exact h2

  have s3b : ∀ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of L)) [Etale h] (y : Y),
      letI : Algebra L (Y.residueField y) := (Spec.preimage (Y.fromSpecResidueField y ≫ h)).hom.toAlgebra
      Module.Finite L (Y.residueField y) ∧ Algebra.IsSeparable L (Y.residueField y) := by
    intro Y h _ y
    haveI : (h y).asIdeal.IsMaximal := by
      haveI : (h y).asIdeal.IsPrime := (h y).isPrime
      rw [Ideal.eq_bot_of_prime (h y).asIdeal]; exact Ideal.bot_isMaximal
    let β : CommRingCat.of L ⟶ (Spec (.of L)).residueField (h y) :=
      CommRingCat.ofHom (algebraMap L (h y).asIdeal.ResidueField) ≫
        (Scheme.Spec.residueFieldIso (.of L) (h y)).inv
    have hβs : Function.Surjective β.hom := by
      have h1 := Ideal.algebraMap_residueField_surjective (h y).asIdeal
      have h2 : Function.Surjective (Scheme.Spec.residueFieldIso (.of L) (h y)).inv.hom :=
        (Scheme.Spec.residueFieldIso (.of L) (h y)).symm.commRingCatIsoToRingEquiv.surjective
      exact h2.comp h1
    have hβi : Function.Injective β.hom := β.hom.injective
    have hβ : Spec.map β = (Spec (.of L)).fromSpecResidueField (h y) := by
      rw [Spec.map_comp]
      exact Scheme.Spec.map_residueFieldIso_inv_eq_fromSpecResidueField _ _
    have hpre : Spec.preimage (Y.fromSpecResidueField y ≫ h) = β ≫ h.residueFieldMap y := by
      rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← hβ, ← Spec.map_comp,
        Spec.preimage_map]
    rw [hpre]
    letI : Algebra L ((Spec (.of L)).residueField (h y)) := β.hom.toAlgebra
    letI : Algebra ((Spec (.of L)).residueField (h y)) (Y.residueField y) :=
      (h.residueFieldMap y).hom.toAlgebra
    letI : Algebra L (Y.residueField y) := (β ≫ h.residueFieldMap y).hom.toAlgebra
    haveI : IsScalarTower L ((Spec (.of L)).residueField (h y)) (Y.residueField y) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Module.Finite ((Spec (.of L)).residueField (h y)) (Y.residueField y) := s3a h y
    haveI : Module.Finite L ((Spec (.of L)).residueField (h y)) :=
      Module.Finite.of_surjective (Algebra.linearMap L _) hβs
    haveI : Algebra.IsSeparable ((Spec (.of L)).residueField (h y)) (Y.residueField y) :=
      inferInstance
    haveI : Algebra.IsSeparable L ((Spec (.of L)).residueField (h y)) :=
      Algebra.IsSeparable.of_algHom L L
        (AlgEquiv.ofBijective (Algebra.ofId L ((Spec (.of L)).residueField (h y)))
          ⟨hβi, hβs⟩).symm.toAlgHom
    exact ⟨Module.Finite.trans ((Spec (.of L)).residueField (h y)) (Y.residueField y),
      Algebra.IsSeparable.trans L ((Spec (.of L)).residueField (h y)) (Y.residueField y)⟩

  have s3c : ∀ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of L)) [Etale h] [IsAffine Y], Finite Y := by
    intro Y h _ _
    haveI : Etale (Y.isoSpec.inv ≫ h) := inferInstance
    have hφ : Spec.map (Spec.preimage (Y.isoSpec.inv ≫ h)) = Y.isoSpec.inv ≫ h :=
      Spec.map_preimage _
    have hφe : (Spec.preimage (Y.isoSpec.inv ≫ h)).hom.Etale :=
      (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp
        (by rw [hφ]; infer_instance)
    letI : Algebra L Γ(Y, ⊤) := (Spec.preimage (Y.isoSpec.inv ≫ h)).hom.toAlgebra
    haveI : Algebra.Etale L Γ(Y, ⊤) := RingHom.Etale.toAlgebra hφe
    haveI : Module.Finite L Γ(Y, ⊤) := Algebra.FormallyUnramified.finite_of_free L Γ(Y, ⊤)
    haveI : IsArtinianRing Γ(Y, ⊤) := IsArtinianRing.of_finite L Γ(Y, ⊤)
    exact Finite.of_equiv _ (Y.isoSpec.hom.homeomorph).toEquiv.symm

  have s3d : ∀ (κ κ' : Type u) [Field κ] [Field κ'] [Algebra κ κ'] [FiniteDimensional κ κ']
      [Algebra.IsSeparable κ κ'], ∃ (M : Type u) (_ : Field M) (_ : Algebra κ M),
      FiniteDimensional κ M ∧ IsGalois κ M ∧ ∃ ι : κ' →ₐ[κ] M,
        (letI : Algebra κ' M := ι.toRingHom.toAlgebra
         Module.Finite κ' M ∧ Algebra.IsSeparable κ' M) := by
    intro κ κ' _ _ _ _ _
    let ι₀ : κ' →ₐ[κ] SeparableClosure κ := IsSepClosed.lift
    let N := IntermediateField.normalClosure κ κ' (SeparableClosure κ)
    have hmem : ∀ z, ι₀ z ∈ N := fun z => AlgHom.fieldRange_le_normalClosure ι₀ ⟨z, rfl⟩
    let ι : κ' →ₐ[κ] N :=
      { toFun := fun z => ⟨ι₀ z, hmem z⟩
        map_one' := by ext; simp
        map_mul' := by intros; ext; simp
        map_zero' := by ext; simp
        map_add' := by intros; ext; simp
        commutes' := by intro r; ext; simp }
    refine ⟨N, inferInstance, inferInstance, normalClosure.is_finiteDimensional κ κ' _,
      IsGalois.normalClosure κ κ' _, ι, ?_⟩
    letI : Algebra κ' N := ι.toRingHom.toAlgebra
    haveI : IsScalarTower κ κ' N := IsScalarTower.of_algebraMap_eq (fun r => (ι.commutes r).symm)
    haveI : FiniteDimensional κ N := normalClosure.is_finiteDimensional κ κ' _
    haveI : IsGalois κ N := IsGalois.normalClosure κ κ' _
    exact ⟨FiniteDimensional.right κ κ' N, Algebra.isSeparable_tower_top_of_isSeparable κ κ' N⟩

  have s3e : ∀ (K M : Type u) [Field K] [Field M] (φ : L →+* K) (ε : K →+* M),
      (letI : Algebra L K := φ.toAlgebra
       Module.Finite L K ∧ Algebra.IsSeparable L K) →
      (letI : Algebra K M := ε.toAlgebra
       Module.Finite K M ∧ Algebra.IsSeparable K M) →
      Etale (Spec.map (CommRingCat.ofHom (ε.comp φ))) := by
    intro K M _ _ φ ε h1 h2
    letI : Algebra L K := φ.toAlgebra
    letI : Algebra K M := ε.toAlgebra
    letI : Algebra L M := (ε.comp φ).toAlgebra
    haveI : IsScalarTower L K M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨h1f, h1s⟩ := h1
    obtain ⟨h2f, h2s⟩ := h2
    haveI : Module.Finite L M := Module.Finite.trans K M
    haveI : Algebra.IsSeparable L M := Algebra.IsSeparable.trans L K M
    haveI : Algebra.Etale L M := Algebra.Etale.mk (Algebra.FormallyEtale.of_isSeparable L M)
      ((Algebra.FinitePresentation.of_finiteType).mp inferInstance)
    have : (algebraMap L M).Etale := RingHom.etale_algebraMap.mpr ‹_›
    exact (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)
      (φ := CommRingCat.ofHom (ε.comp φ))).mpr this

  have s3g : ∀ (Y : (Spec (.of L)).Etale) (g : Y ⟶ U) (y : Y.left) (M : Type u) [Field M]
      [Algebra (U.left.residueField (g.left y)) M] (ε : Y.left.residueField y →+* M),
      ε.comp (g.left.residueFieldMap y).hom = algebraMap (U.left.residueField (g.left y)) M →
      Etale (Spec.map (CommRingCat.ofHom
        (ε.comp (Spec.preimage (Y.left.fromSpecResidueField y ≫ Y.hom)).hom))) →
      ∃ (V : (Spec (.of L)).Etale) (h : V ⟶ Y) (e : V.left ≅ Spec (.of M)), Nonempty V.left ∧
        (∀ v : V.left, (h ≫ g).left v = g.left y) ∧
        e.inv ≫ (h ≫ g).left = Spec.map (CommRingCat.ofHom
          (algebraMap (U.left.residueField (g.left y)) M)) ≫ U.left.fromSpecResidueField (g.left y) := by
    intro Y g y M _ _ ε hε hét
    let V : (Spec (.of L)).Etale := Scheme.Etale.mk (Spec.map (CommRingCat.ofHom
        (ε.comp (Spec.preimage (Y.left.fromSpecResidueField y ≫ Y.hom)).hom)))
    have hw : (Spec.map (CommRingCat.ofHom ε) ≫ Y.left.fromSpecResidueField y) ≫ Y.hom =
        Spec.map (CommRingCat.ofHom
          (ε.comp (Spec.preimage (Y.left.fromSpecResidueField y ≫ Y.hom)).hom)) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage,
        Category.assoc]
    let hV : V ⟶ Y := MorphismProperty.Over.homMk
      (Spec.map (CommRingCat.ofHom ε) ≫ Y.left.fromSpecResidueField y) hw trivial
    refine ⟨V, hV, Iso.refl _, inferInstanceAs (Nonempty (Spec (.of M))), ?_, ?_⟩
    · intro v
      change g.left ((Spec.map (CommRingCat.ofHom ε) ≫ Y.left.fromSpecResidueField y) v) = _
      exact congrArg g.left (Scheme.fromSpecResidueField_apply y _)
    · change 𝟙 _ ≫ (Spec.map (CommRingCat.ofHom ε) ≫ Y.left.fromSpecResidueField y) ≫ g.left = _
      rw [Category.id_comp, Category.assoc,
        ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
        ← Spec.map_comp, ← hε, CommRingCat.ofHom_comp, CommRingCat.ofHom_hom]

  haveI := hU
  haveI : Finite U.left := s3c U.left U.hom
  let k := Nat.card U.left
  let eqv : U.left ≃ Fin k := Finite.equivFin U.left
  change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of L)) U at hR
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
  have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
  choose Y g y hRg _ hgy using fun i : Fin k => hR' (eqv.symm i)
  have key : ∀ i : Fin k, ∃ (V : (Spec (.of L)).Etale) (h : V ⟶ Y i), Nonempty V.left ∧
      (∀ v : V.left, (h ≫ g i).left v = (g i).left (y i)) ∧
      ∃ (κ M : Type u) (_ : Field κ) (_ : Field M) (_ : Algebra L κ) (_ : Algebra κ M)
        (a : Spec (.of κ) ⟶ U.left) (e : V.left ≅ Spec (.of M)),
        Algebra.IsAlgebraic L κ ∧ FiniteDimensional κ M ∧ IsGalois κ M ∧ Mono a ∧
        e.inv ≫ (h ≫ g i).left = Spec.map (CommRingCat.ofHom (algebraMap κ M)) ≫ a := by
    intro i
    letI := ((g i).left.residueFieldMap (y i)).hom.toAlgebra
    haveI : FiniteDimensional (U.left.residueField ((g i).left (y i)))
        ((Y i).left.residueField (y i)) := s3a (g i).left (y i)
    obtain ⟨M, _, _, hfd, hgal, ι, hι⟩ := s3d (U.left.residueField ((g i).left (y i)))
      ((Y i).left.residueField (y i))
    haveI : Etale (Y i).hom := (Y i).prop
    have hρ := s3b (Y i).left (Y i).hom (y i)
    have het := s3e _ M (Spec.preimage ((Y i).left.fromSpecResidueField (y i) ≫ (Y i).hom)).hom
      ι.toRingHom hρ hι
    obtain ⟨V, h, e, hne, hpts, heq⟩ := s3g (Y i) (g i) (y i) M ι.toRingHom
      (AlgHom.comp_algebraMap ι) het
    haveI : Etale U.hom := U.prop
    have hfin := (s3b U.left U.hom ((g i).left (y i))).1
    letI : Algebra L (U.left.residueField ((g i).left (y i))) :=
      (Spec.preimage (U.left.fromSpecResidueField ((g i).left (y i)) ≫ U.hom)).hom.toAlgebra
    exact ⟨V, h, hne, hpts, U.left.residueField ((g i).left (y i)), M, inferInstance,
      inferInstance, inferInstance, inferInstance, U.left.fromSpecResidueField _, e,
      Algebra.IsAlgebraic.of_finite _ _, hfd, hgal, inferInstance, heq⟩
  choose V h hne hpts hdata using key
  refine ⟨k, V, fun i => h i ≫ g i, ?_, fun i => R.downward_closed (hRg i) (h i)⟩
  refine ⟨hU, ?_, ?_, hdata⟩
  · intro x
    obtain ⟨v⟩ := hne (eqv x)
    refine ⟨eqv x, v, ?_⟩
    rw [hpts, hgy, Equiv.symm_apply_apply]
  · intro i j v w hvw
    rw [hpts, hpts, hgy, hgy] at hvw
    exact eqv.symm.injective hvw

theorem wc_et_widePullback_affine : ∀ (Y : Scheme.{u}) (U : Y.Etale) {k : ℕ} (V : Fin k → Y.Etale) (f : ∀ i, V i ⟶ U), IsAffine U.left → (∀ i, IsAffine (V i).left) → ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), IsAffine (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left :=
by
  intro X U k V f hUaff hVaff p σ
  haveI := hUaff

  have leg : ∀ i, IsAffineHom (f i).left := by
    intro i
    haveI := hVaff i
    infer_instance

  have sq : ∀ (n : ℕ) (Xs : Fin (n + 1) → X.Etale) (g : ∀ i, Xs i ⟶ U),
      IsPullback (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback U Xs g ⟶ Limits.widePullback U (fun i : Fin n => Xs i.castSucc)
            (fun i => g i.castSucc))
        (Limits.WidePullback.π g (Fin.last n))
        (Limits.WidePullback.base (fun i : Fin n => g i.castSucc)) (g (Fin.last n)) := by
    intro n Xs g
    have w : (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback U Xs g ⟶ Limits.widePullback U (fun i : Fin n => Xs i.castSucc)
            (fun i => g i.castSucc)) ≫
        Limits.WidePullback.base (fun i : Fin n => g i.castSucc) =
        Limits.WidePullback.π g (Fin.last n) ≫ g (Fin.last n) := by
      rw [Limits.WidePullback.lift_base, Limits.WidePullback.π_arrow]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ w) ?_
    refine Limits.PullbackCone.IsLimit.mk w
      (fun s => Limits.WidePullback.lift (s.fst ≫ Limits.WidePullback.base _)
        (Fin.lastCases (motive := fun j => s.pt ⟶ Xs j) s.snd
          (fun i => s.fst ≫ Limits.WidePullback.π (fun i : Fin n => g i.castSucc) i))
        (fun j => by
          induction j using Fin.lastCases with
          | last => rw [Fin.lastCases_last]; exact s.condition.symm
          | cast i =>
            rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow]))
      (fun s => ?_) (fun s => ?_) (fun s m h1 h2 => ?_)
    · apply Limits.WidePullback.hom_ext
      · intro j
        rw [Category.assoc, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π,
          Fin.lastCases_castSucc]
      · rw [Category.assoc, Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
    · rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
    · apply Limits.WidePullback.hom_ext
      · intro j
        induction j using Fin.lastCases with
        | last => rw [Limits.WidePullback.lift_π, Fin.lastCases_last]; exact h2
        | cast i =>
          rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← h1, Category.assoc,
            Limits.WidePullback.lift_π]
      · rw [Limits.WidePullback.lift_base, ← h1, Category.assoc, Limits.WidePullback.lift_base]

  have main : ∀ (n : ℕ) (τ : Fin n → Fin k),
      IsAffineHom (Limits.WidePullback.base (fun l => f (τ l))).left := by
    intro n
    induction n with
    | zero =>
      intro τ
      let e0 : Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)) ≅ U :=
        { hom := Limits.WidePullback.base _
          inv := Limits.WidePullback.lift (𝟙 U) (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
          hom_inv_id := by
            apply Limits.WidePullback.hom_ext
            · intro j; exact Fin.elim0 j
            · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id,
                Category.id_comp]
          inv_hom_id := Limits.WidePullback.lift_base _ _ _ _ }
      let E := (Scheme.Etale.forget X ⋙ Over.forget X).mapIso e0
      haveI hE : IsIso E.hom := Iso.isIso_hom E
      have hEq : E.hom = (Limits.WidePullback.base (fun l => f (τ l))).left := rfl
      haveI : IsIso (Limits.WidePullback.base (fun l => f (τ l))).left := hEq ▸ hE
      infer_instance
    | succ n ih =>
      intro τ
      have hb := ih (fun i => τ i.castSucc)
      have hsq := (sq n (fun l => V (τ l)) (fun l => f (τ l))).map
        (Scheme.Etale.forget X ⋙ Over.forget X)
      have l1 := leg (τ (Fin.last n))
      have r1 := MorphismProperty.of_isPullback (P := @IsAffineHom) hsq.flip l1
      have hfac : (Limits.WidePullback.base (fun l => f (τ l))).left =
          (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left ≫
          (Limits.WidePullback.base (fun i : Fin n => f (τ i.castSucc))).left := by
        change (Scheme.Etale.forget X ⋙ Over.forget X).map
            (Limits.WidePullback.base (fun l => f (τ l))) =
          (Scheme.Etale.forget X ⋙ Over.forget X).map
            (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
              (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
              (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)) ≫
          (Scheme.Etale.forget X ⋙ Over.forget X).map
            (Limits.WidePullback.base (fun i : Fin n => f (τ i.castSucc)))
        rw [← Functor.map_comp, Limits.WidePullback.lift_base]
      haveI : IsAffineHom (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left := r1
      haveI := hb
      rw [hfac]
      infer_instance

  haveI := main (p + 1) σ
  exact isAffine_of_isAffineHom (Limits.WidePullback.base (fun l => f (σ l))).left

theorem wc_cech_acyclic_of_disjoint : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (U : Y.Etale) {k : ℕ} (V : Fin k → Y.Etale) (f : ∀ i, V i ⟶ U), (∀ (i j : Fin k) (v : (V i).left) (w : (V j).left), (f i).left v = (f j).left w → i = j) → (∀ i, wcCechAcyclic G.obj (fun _ : Fin 1 => V i) (fun _ => f i)) → wcCechAcyclic G.obj V f :=
by
  intro Y G U k V f hdisj hacyc
  classical

  have s1 : ∀ W : Y.Etale, IsEmpty W.left → Subsingleton (G.obj.obj (Opposite.op W)) := by
    intro W hW
    have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology Y W := by
      change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale Y W
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact isEmptyElim x
    exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover G W hbot).isZero

  have s2 : ∀ (n : ℕ) (τ : Fin (n + 1) → Fin k), ¬ (∀ l, τ l = τ 0) →
      IsEmpty (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))).left := by
    intro n τ hτ
    push_neg at hτ
    obtain ⟨l, hl⟩ := hτ
    refine ⟨fun z => hl ?_⟩
    have key : ∀ m, (f (τ m)).left ((Limits.WidePullback.π (fun l => f (τ l)) m).left z) =
        (Limits.WidePullback.base (fun l => f (τ l))).left z := by
      intro m
      have h1 : (Scheme.Etale.forget Y ⋙ Over.forget Y).map (Limits.WidePullback.π (fun l => f (τ l)) m) ≫
          (Scheme.Etale.forget Y ⋙ Over.forget Y).map (f (τ m)) =
          (Scheme.Etale.forget Y ⋙ Over.forget Y).map (Limits.WidePullback.base (fun l => f (τ l))) :=
        ((Scheme.Etale.forget Y ⋙ Over.forget Y).map_comp _ _).symm.trans
          (congrArg (Scheme.Etale.forget Y ⋙ Over.forget Y).map
            (Limits.WidePullback.π_arrow (fun l => f (τ l)) m))
      have h2 : (Limits.WidePullback.π (fun l => f (τ l)) m).left ≫ (f (τ m)).left =
          (Limits.WidePullback.base (fun l => f (τ l))).left := h1
      rw [← Scheme.Hom.comp_apply, h2]
    exact hdisj _ _ _ _ ((key l).trans (key 0).symm)
  intro p c hc

  have hci := fun i => hacyc i p (fun _ => c (fun _ => i)) (fun _ => hc (fun _ => i))
  choose bi hbi using hci

  let T : (Fin (p + 1) → Fin k) → Type (u + 1) := fun σ =>
    ↑(G.obj.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
  obtain ⟨b, hb⟩ : ∃ b : ∀ σ : Fin (p + 1) → Fin k, T σ,
      ∀ i, b (fun _ => i) = bi i (fun _ => 0) :=
    ⟨fun σ => if h : ∀ l, σ l = σ 0 then
        cast (congrArg T (funext fun l => (h l).symm : (fun _ => σ 0) = σ)) (bi (σ 0) (fun _ => 0))
      else 0,
      fun i => (dif_pos (fun _ => rfl)).trans (cast_eq _ _)⟩
  refine ⟨b, fun τ => ?_⟩
  by_cases hτ : ∀ l, τ l = τ 0
  ·
    obtain ⟨i, rfl⟩ : ∃ i, τ = fun _ => i := ⟨τ 0, funext hτ⟩
    refine Eq.trans (Finset.sum_congr rfl (fun j _ => ?_)) (hbi i (fun _ => 0))
    exact congrArg (fun x => ((-1 : ℤ) ^ (j : ℕ)) • G.obj.map (wcCechFace V f (fun _ => i) j).op x)
      (hb i)
  ·
    exact @Subsingleton.elim _ (s1 _ (s2 (p + 1) τ hτ)) _ _

theorem wc_galEqv_universal : ∀ (κ M : Type u) [Field κ] [Field M] [Algebra κ M] [FiniteDimensional κ M] [IsGalois κ M] (n : ℕ) (S : Type u) [CommRing S] (f : Fin (n + 1) → (M →+* S)), (∀ (l : Fin (n + 1)) (c : κ), f l (algebraMap κ M c) = f 0 (algebraMap κ M c)) → ∃! Λ : wcGalEqv κ M (n + 1) →+* S, ∀ (l : Fin (n + 1)) (x : M), Λ (wcGalEqvIncl κ M (n + 1) l x) = f l x :=
by
  intro κ M _ _ _ _ _ n S _ f hf
  classical

  obtain ⟨d, b, c, hDa, hDb⟩ : ∃ (d : ℕ) (b c : Fin d → M),
      (∀ y : M, (∑ j, Algebra.trace κ M (y * c j) • b j) = y) ∧
      (∀ y : M, (∑ j, Algebra.trace κ M (y * b j) • c j) = y) := by
    haveI : Algebra.IsSeparable κ M := IsGalois.to_isSeparable
    have hB := traceForm_nondegenerate κ M
    refine ⟨Module.finrank κ M, Module.finBasis κ M,
      (Algebra.traceForm κ M).dualBasis hB (Module.finBasis κ M), ?_, ?_⟩
    · intro y
      have h := (Algebra.traceForm κ M).dualBasis_repr_apply hB
        ((Algebra.traceForm κ M).dualBasis hB (Module.finBasis κ M)) y
      rw [LinearMap.BilinForm.dualBasis_dualBasis hB (Algebra.traceForm_isSymm κ)] at h
      conv_rhs => rw [← (Module.finBasis κ M).sum_repr y]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [h i, Algebra.traceForm_apply]
    · intro y
      conv_rhs => rw [← ((Algebra.traceForm κ M).dualBasis hB (Module.finBasis κ M)).sum_repr y]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [LinearMap.BilinForm.dualBasis_repr_apply, Algebra.traceForm_apply]

  have hstar : ∀ y : M, y = ∑ σ : Gal(M/κ), (∑ j, b j * σ (c j)) * σ y := by
    intro y
    conv_lhs => rw [← hDa y]
    simp only [Algebra.smul_def, trace_eq_sum_automorphisms, map_mul, Finset.sum_mul,
      Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun σ _ => Finset.sum_congr rfl (fun j _ => by ring))
  have hU : ∀ τ : Gal(M/κ), (∑ j, b j * τ (c j)) = if τ = 1 then 1 else 0 := by
    have hli : LinearIndependent M (fun σ : Gal(M/κ) => ((σ : M →* M) : M → M)) := by
      have h0 := linearIndependent_monoidHom M M
      have hinj : Function.Injective (fun σ : Gal(M/κ) => (σ : M →* M)) := by
        intro σ τ h
        ext x
        exact DFunLike.congr_fun h x
      exact h0.comp _ hinj
    rw [Fintype.linearIndependent_iff] at hli
    intro τ
    have hsingle : ∀ y : M, (∑ σ : Gal(M/κ), if σ = 1 then σ y else 0) = y := by
      intro y; simp
    refine sub_eq_zero.mp (hli (fun σ => (∑ j, b j * σ (c j)) - if σ = 1 then 1 else 0) ?_ τ)
    funext y
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, MonoidHom.coe_coe, sub_mul,
      Finset.sum_sub_distrib, ite_mul, one_mul, zero_mul, Pi.zero_apply]
    rw [hsingle, ← hstar y, sub_self]
  have hgg : ∀ (g : Gal(M/κ)) (x : M), g (g⁻¹ x) = x := fun g x => by
    rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
  have hgg' : ∀ (g : Gal(M/κ)) (x : M), g⁻¹ (g x) = x := fun g x => by
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]

  have hswap : ∀ (φ χ : M →+* S), (∀ a : κ, χ (algebraMap κ M a) = φ (algebraMap κ M a)) →
      ∀ z : M, (∑ j, φ (z * b j) * χ (c j)) = ∑ j, φ (b j) * χ (z * c j) := by
    intro φ χ hχ z
    have L : ∀ j, φ (z * b j) =
        ∑ i, φ (algebraMap κ M (Algebra.trace κ M (z * b j * c i))) * φ (b i) := by
      intro j
      conv_lhs => rw [← hDa (z * b j)]
      simp only [map_sum, Algebra.smul_def, map_mul]
    have R : ∀ i, χ (z * c i) =
        ∑ j, φ (algebraMap κ M (Algebra.trace κ M (z * b j * c i))) * χ (c j) := by
      intro i
      conv_lhs => rw [← hDb (z * c i)]
      simp only [map_sum, Algebra.smul_def, map_mul, hχ]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [show z * c i * b j = z * b j * c i by ring]
    simp only [L, R, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))

  have hC : ∀ (φ ψ : M →+* S), (∀ a : κ, ψ (algebraMap κ M a) = φ (algebraMap κ M a)) →
      (∑ g : Gal(M/κ), ∑ j, φ (b j) * ψ (g⁻¹ (c j))) = 1 ∧
      (∀ g : Gal(M/κ), (∑ j, φ (b j) * ψ (g⁻¹ (c j))) * (∑ j, φ (b j) * ψ (g⁻¹ (c j))) =
        ∑ j, φ (b j) * ψ (g⁻¹ (c j))) ∧
      (∀ g g' : Gal(M/κ), g ≠ g' →
        (∑ j, φ (b j) * ψ (g⁻¹ (c j))) * (∑ j, φ (b j) * ψ (g'⁻¹ (c j))) = 0) ∧
      (∀ (g : Gal(M/κ)) (x : M), φ (g x) * (∑ j, φ (b j) * ψ (g⁻¹ (c j))) =
        ψ x * (∑ j, φ (b j) * ψ (g⁻¹ (c j)))) := by
    intro φ ψ hψ
    have htw : ∀ (g : Gal(M/κ)) (x : M), φ (g x) * (∑ j, φ (b j) * ψ (g⁻¹ (c j))) =
        ψ x * (∑ j, φ (b j) * ψ (g⁻¹ (c j))) := by
      intro g x
      have hχ : ∀ a : κ, (ψ.comp (g⁻¹ : Gal(M/κ)).toRingEquiv.toRingHom) (algebraMap κ M a) =
          φ (algebraMap κ M a) := by
        intro a
        change ψ ((g⁻¹ : Gal(M/κ)) (algebraMap κ M a)) = _
        rw [AlgEquiv.commutes, hψ]
      have hs := hswap φ (ψ.comp (g⁻¹ : Gal(M/κ)).toRingEquiv.toRingHom) hχ (g x)
      change (∑ j, φ (g x * b j) * ψ ((g⁻¹ : Gal(M/κ)) (c j))) =
        ∑ j, φ (b j) * ψ ((g⁻¹ : Gal(M/κ)) (g x * c j)) at hs
      rw [Finset.mul_sum, Finset.mul_sum]
      calc ∑ j, φ (g x) * (φ (b j) * ψ (g⁻¹ (c j)))
          = ∑ j, φ (g x * b j) * ψ (g⁻¹ (c j)) := by
            refine Finset.sum_congr rfl (fun j _ => ?_); rw [map_mul]; ring
        _ = ∑ j, φ (b j) * ψ (g⁻¹ (g x * c j)) := hs
        _ = ∑ j, ψ x * (φ (b j) * ψ (g⁻¹ (c j))) := by
            refine Finset.sum_congr rfl (fun j _ => ?_); rw [map_mul, map_mul, hgg']; ring
    have hsum : (∑ g : Gal(M/κ), ∑ j, φ (b j) * ψ (g⁻¹ (c j))) = 1 := by
      rw [Finset.sum_comm]
      have h1 : ∀ j, (∑ g : Gal(M/κ), φ (b j) * ψ (g⁻¹ (c j))) =
          φ (algebraMap κ M (Algebra.trace κ M (1 * c j))) * φ (b j) := by
        intro j
        rw [← Finset.mul_sum, ← map_sum ψ, one_mul, ← hψ, trace_eq_sum_automorphisms,
          mul_comm (φ (b j)),
          Fintype.sum_equiv (Equiv.inv Gal(M/κ)) (fun g => g⁻¹ (c j)) (fun σ => σ (c j))
            (fun g => rfl)]
      rw [Finset.sum_congr rfl (fun j _ => h1 j)]
      conv_rhs => rw [← map_one φ, ← hDa 1]
      simp only [map_sum, Algebra.smul_def, map_mul]
    have hprod : ∀ g g' : Gal(M/κ),
        (∑ j, φ (b j) * ψ (g⁻¹ (c j))) * (∑ j, φ (b j) * ψ (g'⁻¹ (c j))) =
        ψ (g⁻¹ (∑ j, b j * (g * g'⁻¹) (c j))) * (∑ j, φ (b j) * ψ (g⁻¹ (c j))) := by
      intro g g'
      calc (∑ j, φ (b j) * ψ (g⁻¹ (c j))) * (∑ j, φ (b j) * ψ (g'⁻¹ (c j)))
          = ∑ j, (φ (b j) * (∑ j, φ (b j) * ψ (g⁻¹ (c j)))) * ψ (g'⁻¹ (c j)) := by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun j _ => by ring)
        _ = ∑ j, (ψ (g⁻¹ (b j)) * (∑ j, φ (b j) * ψ (g⁻¹ (c j)))) * ψ (g'⁻¹ (c j)) := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            have := htw g (g⁻¹ (b j))
            rw [hgg] at this
            rw [this]
        _ = ψ (g⁻¹ (∑ j, b j * (g * g'⁻¹) (c j))) * (∑ j, φ (b j) * ψ (g⁻¹ (c j))) := by
            rw [map_sum, map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [map_mul, ← AlgEquiv.mul_apply g⁻¹ (g * g'⁻¹), inv_mul_cancel_left, map_mul]
            ring
    refine ⟨hsum, fun g => ?_, fun g g' hne => ?_, htw⟩
    · rw [hprod g g, mul_inv_cancel, hU 1, if_pos rfl, map_one, map_one, one_mul]
    · rw [hprod g g', hU (g * g'⁻¹), if_neg (fun h => hne (mul_inv_eq_one.mp h)), map_zero,
        map_zero, zero_mul]

  have hD : ∀ F : wcGalEqv κ M (n + 1), F = ∑ k : Fin n → Gal(M/κ),
      wcGalEqvIncl κ M (n + 1) 0 ((F : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) *
        ∏ l : Fin n, ∑ j, wcGalEqvIncl κ M (n + 1) 0 (b j) *
          wcGalEqvIncl κ M (n + 1) l.succ ((k l)⁻¹ (c j)) := by
    intro F
    apply Subtype.ext
    funext h
    simp only [AddSubmonoidClass.coe_finsetSum, Finset.sum_apply, Subring.coe_mul,
      MulMemClass.coe_mul, Pi.mul_apply, SubmonoidClass.coe_finsetProd, Finset.prod_apply]
    have hev : ∀ (l : Fin (n + 1)) (x : M),
        ((wcGalEqvIncl κ M (n + 1) l x : wcGalEqv κ M (n + 1)) :
          (Fin (n + 1) → Gal(M/κ)) → M) h = h l x := fun l x => rfl
    simp only [hev]
    have hfac : ∀ (l : Fin n) (g : Gal(M/κ)),
        (∑ j, h 0 (b j) * h l.succ (g⁻¹ (c j))) = if g = (h 0)⁻¹ * h l.succ then 1 else 0 := by
      intro l g
      have e : (∑ j, h 0 (b j) * h l.succ (g⁻¹ (c j))) =
          h 0 (∑ j, b j * ((h 0)⁻¹ * (h l.succ * g⁻¹)) (c j)) := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, ← AlgEquiv.mul_apply (h 0) ((h 0)⁻¹ * (h l.succ * g⁻¹)),
          mul_inv_cancel_left, AlgEquiv.mul_apply]
      have key : (h 0)⁻¹ * (h l.succ * g⁻¹) = 1 ↔ g = (h 0)⁻¹ * h l.succ := by
        rw [← mul_assoc, mul_inv_eq_one, eq_comm]
      rw [e, hU]
      by_cases hg : g = (h 0)⁻¹ * h l.succ
      · rw [if_pos (key.mpr hg), if_pos hg, map_one]
      · rw [if_neg (fun h' => hg (key.mp h')), if_neg hg, map_zero]
    rw [Fintype.sum_eq_single (fun l => (h 0)⁻¹ * h l.succ)]
    · rw [Finset.prod_eq_one (fun l _ => by rw [hfac, if_pos rfl]), mul_one]
      have hF := F.2 (h 0) (Fin.cons 1 (fun l => (h 0)⁻¹ * h l.succ))
      rw [← hF]
      apply congrArg
      funext l
      rcases Fin.eq_zero_or_eq_succ l with rfl | ⟨i, rfl⟩
      · simp only [Fin.cons_zero, mul_one]
      · simp only [Fin.cons_succ, mul_inv_cancel_left]
    · intro k hk
      obtain ⟨l, hl⟩ := Function.ne_iff.mp hk
      rw [Finset.prod_eq_zero (Finset.mem_univ l) (by rw [hfac, if_neg hl]), mul_zero]

  obtain ⟨e, he1, he2, he3, he4⟩ : ∃ e : Fin n → Gal(M/κ) → S,
      (∀ l, (∑ g, e l g) = 1) ∧ (∀ l g, e l g * e l g = e l g) ∧
      (∀ l g g', g ≠ g' → e l g * e l g' = 0) ∧
      (∀ (l : Fin n) (g : Gal(M/κ)) (x : M), f 0 (g x) * e l g = f l.succ x * e l g) :=
    ⟨fun l g => ∑ j, f 0 (b j) * f l.succ (g⁻¹ (c j)),
      fun l => (hC (f 0) (f l.succ) (hf l.succ)).1,
      fun l => (hC (f 0) (f l.succ) (hf l.succ)).2.1,
      fun l => (hC (f 0) (f l.succ) (hf l.succ)).2.2.1,
      fun l => (hC (f 0) (f l.succ) (hf l.succ)).2.2.2⟩
  have hP1 : (∑ k : Fin n → Gal(M/κ), ∏ l, e l (k l)) = 1 := by
    rw [← Fintype.prod_sum e]
    exact Finset.prod_eq_one (fun l _ => he1 l)
  have hPidem : ∀ k : Fin n → Gal(M/κ),
      (∏ l, e l (k l)) * (∏ l, e l (k l)) = ∏ l, e l (k l) := by
    intro k
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun l _ => he2 l (k l))
  have hPorth : ∀ k k' : Fin n → Gal(M/κ), k ≠ k' →
      (∏ l, e l (k l)) * (∏ l, e l (k' l)) = 0 := by
    intro k k' hk
    obtain ⟨l, hl⟩ := Function.ne_iff.mp hk
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_eq_zero (Finset.mem_univ l) (he3 l _ _ hl)
  let Λ : wcGalEqv κ M (n + 1) →+* S :=
    { toFun := fun F => ∑ k : Fin n → Gal(M/κ),
        f 0 ((F : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) * ∏ l, e l (k l)
      map_one' := by
        calc (∑ k : Fin n → Gal(M/κ), f 0 (((1 : wcGalEqv κ M (n + 1)) :
              (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) * ∏ l, e l (k l))
            = ∑ k : Fin n → Gal(M/κ), ∏ l, e l (k l) := by
              refine Finset.sum_congr rfl (fun k _ => ?_)
              rw [show f 0 (((1 : wcGalEqv κ M (n + 1)) : (Fin (n + 1) → Gal(M/κ)) → M)
                (Fin.cons 1 k)) = 1 from map_one (f 0), one_mul]
          _ = 1 := hP1
      map_mul' := fun F F' => by
        rw [Finset.sum_mul_sum]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [Fintype.sum_eq_single k (fun k' hk' => by
          calc f 0 ((F : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) * (∏ l, e l (k l)) *
                (f 0 ((F' : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k')) * ∏ l, e l (k' l))
              = f 0 ((F : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) *
                f 0 ((F' : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k')) *
                ((∏ l, e l (k l)) * ∏ l, e l (k' l)) := by ring
            _ = 0 := by rw [hPorth k k' (Ne.symm hk'), mul_zero])]
        calc f 0 (((F * F' : wcGalEqv κ M (n + 1)) : (Fin (n + 1) → Gal(M/κ)) → M)
              (Fin.cons 1 k)) * ∏ l, e l (k l)
            = f 0 ((F : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) *
                f 0 ((F' : (Fin (n + 1) → Gal(M/κ)) → M) (Fin.cons 1 k)) *
                ((∏ l, e l (k l)) * ∏ l, e l (k l)) := by
              rw [hPidem]
              exact congrArg (· * _) (map_mul (f 0) _ _)
          _ = _ := by ring
      map_zero' := by
        refine Finset.sum_eq_zero (fun k _ => ?_)
        exact (congrArg (· * _) (map_zero (f 0))).trans (zero_mul _)
      map_add' := fun F F' => by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [← add_mul]
        exact congrArg (· * _) (map_add (f 0) _ _) }
  have hΛι : ∀ (l : Fin (n + 1)) (x : M), Λ (wcGalEqvIncl κ M (n + 1) l x) = f l x := by
    intro l x
    rcases Fin.eq_zero_or_eq_succ l with rfl | ⟨i, rfl⟩
    · show (∑ k : Fin n → Gal(M/κ),
          f 0 ((Fin.cons 1 k : Fin (n + 1) → Gal(M/κ)) 0 x) * ∏ l, e l (k l)) = f 0 x
      simp only [Fin.cons_zero, AlgEquiv.one_apply]
      rw [← Finset.mul_sum, hP1, mul_one]
    · show (∑ k : Fin n → Gal(M/κ),
          f 0 ((Fin.cons 1 k : Fin (n + 1) → Gal(M/κ)) i.succ x) * ∏ l, e l (k l)) = f i.succ x
      simp only [Fin.cons_succ]
      calc (∑ k : Fin n → Gal(M/κ), f 0 (k i x) * ∏ l, e l (k l))
          = ∑ k : Fin n → Gal(M/κ), f i.succ x * ∏ l, e l (k l) := by
            refine Finset.sum_congr rfl (fun k _ => ?_)
            rw [← Finset.mul_prod_erase Finset.univ (fun l => e l (k l)) (Finset.mem_univ i),
              ← mul_assoc, ← mul_assoc, he4 i (k i) x]
        _ = f i.succ x := by rw [← Finset.mul_sum, hP1, mul_one]
  refine ⟨Λ, hΛι, fun Λ' hΛ' => ?_⟩
  apply RingHom.ext
  intro F
  rw [hD F, map_sum, map_sum]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  rw [map_mul, map_mul, map_prod, map_prod, hΛ', hΛι]
  congr 1
  refine Finset.prod_congr rfl (fun l _ => ?_)
  rw [map_sum, map_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_mul, map_mul, hΛ', hΛ', hΛι, hΛι]

