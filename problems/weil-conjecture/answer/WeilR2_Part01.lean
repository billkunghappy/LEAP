      MvPolynomial.gradedAlgebra ≫
    Spec.map (CommRingCat.ofHom (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 0)))

noncomputable abbrev wcRsD (R : Type u) [CommRing R] (n : ℕ) (J : Fin (n + 1)) : (wcRsPj R n).Opens :=
  @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
