def wcIndEtale {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) : Prop :=
  letI := φ.toAlgebra
  ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P] (h : P →ₐ[R] S),
    ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
      ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] S), β.comp α = h

def wcAffIndEt (Y : Scheme.{u}) (A : Y.Opens) (U : Y.ProEt) : Prop :=
  IsAffine U.left ∧ ∃ g : U.left ⟶ (A : Scheme.{u}), g ≫ A.ι = U.hom ∧ wcIndEtale g.appTop.hom

def wcAffCov (Y : Scheme.{u}) (A : Y.Opens) (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt)
    (f : ∀ i, V i ⟶ U) : Prop :=
  wcAffIndEt Y A U ∧ (∀ i, wcAffIndEt Y A (V i)) ∧ (∀ i, wcIndEtale (f i).left.appTop.hom) ∧
    Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology Y U

noncomputable def wcCechFace {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C]
    {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) {p : ℕ} (τ : Fin (p + 2) → Fin k)
    (j : Fin (p + 2)) :
    Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)) ⟶
      Limits.widePullback U (fun l => V (τ (j.succAbove l))) (fun l => f (τ (j.succAbove l))) :=
  Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
    (fun l => Limits.WidePullback.π (fun l => f (τ l)) (j.succAbove l)) (by simp)

def wcCechAcyclic {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C]
    (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) : Prop :=
  ∀ (p : ℕ) (c : ∀ τ : Fin (p + 2) → Fin k,
      G.obj (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))),
    (∀ ρ : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
      G.map (wcCechFace V f ρ j).op (c (fun l => ρ (j.succAbove l))) = 0) →
    ∃ b : ∀ σ : Fin (p + 1) → Fin k,
        G.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))),
      ∀ τ : Fin (p + 2) → Fin k, ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        G.map (wcCechFace V f τ j).op (b (fun l => τ (j.succAbove l))) = c τ

def wcCechH0 {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C]
    (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) : Prop :=
  ∀ x : ∀ i, G.obj (Opposite.op (V i)),
    (∀ σ : Fin 2 → Fin k,
      G.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op (x (σ 0)) =
        G.map (Limits.WidePullback.π (fun l => f (σ l)) 1).op (x (σ 1))) →
    ∃ s : G.obj (Opposite.op U), ∀ i, G.map (f i).op s = x i
