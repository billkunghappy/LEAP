import Mathlib
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

abbrev zqoeEnt (p : ℕ) [Fact p.Prime] (f : PowerSeries (PadicComplex p)) : Prop :=
  ∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k f‖ * ρ ^ k ≤ c

abbrev zqoeReal (p : ℕ) [Fact p.Prime] (L : PowerSeries (PadicComplex p)) : Prop :=
  ∃ A B : PowerSeries (PadicComplex p), PowerSeries.constantCoeff A = 1 ∧
    PowerSeries.constantCoeff B = 1 ∧ zqoeEnt p A ∧ zqoeEnt p B ∧
    PowerSeries.X * (PowerSeries.derivative A * B - A * PowerSeries.derivative B) = L * A * B
noncomputable def lwTwistCount (K : Type*) [Field K] (k : ℕ) (g : MvPolynomial (Fin 2) K)
    (σ : Equiv.Perm (Fin (k + 1))) (u₀ : K) : ℕ :=
  Nat.card {r : Fin (k + 1) → AlgebraicClosure K // Function.Injective r ∧
    (∀ i, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, r i] g = 0) ∧
    ∀ i, r i ^ Nat.card K = r (σ i)}
noncomputable def dwTheta (p : ℕ) [Fact p.Prime] (lam : ℕ → PadicComplex p) (t : PadicComplex p) :
    PadicComplex p :=
  ∑' k, lam k * t ^ k


def dwCDw (p k : ℕ) : ℚ :=
  ∑ j ∈ Finset.range (k / p + 1),
    1 / ((p : ℚ) ^ j * (j.factorial : ℚ) * ((k - p * j).factorial : ℚ))


noncomputable def dwPsi (p : ℕ) [Fact p.Prime] {τ : Type} [Fintype τ] (γ : (τ → ℕ) → PadicComplex p)
    (q : ℕ) (w v : τ → ℕ) : PadicComplex p :=
  if ∀ i, v i ≤ q * w i then γ (fun i => q * w i - v i) else 0


noncomputable def dwTrPsi (p : ℕ) [Fact p.Prime] {τ : Type} [Fintype τ]
    (γ : (τ → ℕ) → PadicComplex p) (q n : ℕ) : PadicComplex p :=
  ∑' v : Fin n → τ → ℕ, ∏ j : Fin n, dwPsi p γ q (v j) (v (finRotate n j))


def dwAH (p : ℕ) : Prop :=
  ∀ e : ℕ → ℚ, e 0 = 1 →
    (∀ k : ℕ, 1 ≤ k → (k : ℚ) * e k =
      ∑ i ∈ (Finset.range (k + 1)).filter (fun i => p ^ i ≤ k), e (k - p ^ i)) →
    ∀ k, padicNorm p (e k) ≤ 1


def dwCBounds (p : ℕ) : Prop :=
  (∀ k, (padicNorm p (dwCDw p k) : ℝ) ≤
      (p : ℝ) ^ ((k : ℝ) / ((p : ℝ) - 1) - (k : ℝ) * ((p : ℝ) - 1) / (p : ℝ) ^ 2)) ∧
    (∀ k, 2 ≤ k → (padicNorm p (dwCDw p k) : ℝ) < (p : ℝ) ^ (((k : ℝ) - 1) / ((p : ℝ) - 1)))


def dwSplit (p : ℕ) [Fact p.Prime] (ζ : PadicComplex p) (lam : ℕ → PadicComplex p) : Prop :=
  ∀ m : ℕ, 1 ≤ m → ∀ t : PadicComplex p, t ^ (p ^ m) = t → ∀ j : ℕ,
    ‖(∑ i ∈ Finset.range m, t ^ (p ^ i)) - (j : PadicComplex p)‖ < 1 →
    ∏ i ∈ Finset.range m, dwTheta p lam (t ^ (p ^ i)) = ζ ^ j


noncomputable def dwBfin (τ : Type) [Fintype τ] (s : ℕ) : Finset (τ → ℕ) := by
  classical
  exact (Fintype.piFinset fun _ : τ => Finset.range (s + 1)).filter (fun w => ∑ i, w i ≤ s)


noncomputable def dwMtr (p : ℕ) [Fact p.Prime] {τ : Type} [Fintype τ]
    (γ : (τ → ℕ) → PadicComplex p) (q s : ℕ) :
    Matrix ↥(dwBfin τ s) ↥(dwBfin τ s) (PadicComplex p) :=
  Matrix.of fun v w => dwPsi p γ q v.1 w.1
