    SheafOfModules.unit (wcZModRingSheaf S n) ⟶ SheafOfModules.unit (wcZModRingSheaf S n) :=
  (SheafOfModules.unitHomEquiv _).symm
    (PresheafOfModules.sectionsMk (M := (SheafOfModules.unit (wcZModRingSheaf S n)).val)
