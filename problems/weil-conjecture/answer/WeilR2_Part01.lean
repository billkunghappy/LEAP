def wcBeqChartRel (K : Type u) [Field K] {X' P : Scheme.{u}} (fX' : X' ⟶ Spec (.of K)) (m : ℕ)
    (ι : P ⟶ Limits.pullback fX' (wcProjKStr K m)) (g : Fin (m + 1) → Γ(X', ⊤)) : Prop :=
  (∀ k, (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)).appLE ⊤ (wcBeqChart K fX' m ι k)
      inf_le_left (g k) ∈ nonZeroDivisors Γ(P, wcBeqChart K fX' m ι k)) ∧
  (∀ k l, (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)).appLE ⊤ (wcBeqChart K fX' m ι k)
      inf_le_left (g l) =
    (ι ≫ Limits.pullback.snd fX' (wcProjKStr K m)).appLE (wcSgD K m k) (wcBeqChart K fX' m ι k)
      inf_le_right (wcSgE K m k l) *
    (ι ≫ Limits.pullback.fst fX' (wcProjKStr K m)).appLE ⊤ (wcBeqChart K fX' m ι k)
      inf_le_left (g k))
