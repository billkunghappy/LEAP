    (show 𝟙 W.left ≫ (𝟙 W.left ≫ W.hom) = W.hom from
      (Category.id_comp _).trans (Category.id_comp _)) trivial

def wcSliceBSpec (S : Scheme.{u}) (W : S.ProEt)
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
    (b : (wcEpsInv W.left).obj ((wcEtInv W.hom).obj G) ⟶
      ((wcSliceFunctor S W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)).obj ((wcEpsInv S).obj G)) : Prop :=
  ∀ (V : S.Etale) (O : W.left.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ W.hom)
    (x : G.obj.obj (Opposite.op V)),
    (b.hom.app (Opposite.op ((wcEtToProEt W.left).obj O))).hom
        (wcEpsRho W.left ((wcEtInv W.hom).obj G) O (wcEtInvRho W.hom G V O h hh x)) =
      (((wcEpsInv S).obj G).obj.map (wcSliceEtHom S W V O h hh).op).hom (wcEpsRho S G V x)

def wcSliceCSpec (S : Scheme.{u}) (W : S.ProEt)
    (c : wcFreeSheaf S W ⟶
      (wcSliceExt S W).obj ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S)))) : Prop :=
  (c.hom.app (Opposite.op W)).hom (wcFreeGen S W) =
    (((wcSliceExt S W).obj ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S)))).obj.map
      (wcSliceTopHom S W).op).hom
      (wcSliceRho S W ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S)))
        ((wcEtToProEt W.left).obj (wcEtTop W.left))
        (wcEpsRho W.left ((wcEtInv W.hom).obj (wcEtUnitSheaf S)) (wcEtTop W.left)
          (wcEtInvRho W.hom (wcEtUnitSheaf S) (wcEtTop S) (wcEtTop W.left) W.hom
            ((Category.comp_id W.hom).trans (Category.id_comp W.hom).symm)
            (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1)))))

def wcSliceSigmaSpec (S : Scheme.{u}) (W W' : S.ProEt) (t : W' ⟶ W)
    (σ : wcEtInv t.left ⋙ wcEpsInv W'.left ⋙ wcSliceExt S W' ⟶ wcEpsInv W.left ⋙ wcSliceExt S W) :
    Prop :=
  ∀ (X : Sheaf (Scheme.smallEtaleTopology W.left) AddCommGrpCat.{u+1}) (O : W.left.Etale)
    (O' : W'.left.Etale) (h : O'.left ⟶ O.left) (hh : h ≫ O.hom = O'.hom ≫ t.left)
    (y : X.obj.obj (Opposite.op O)),
    ((σ.app X).hom.app (Opposite.op ((wcSliceFunctor S W').obj ((wcEtToProEt W'.left).obj O')))).hom
        (wcSliceRho S W' ((wcEpsInv W'.left).obj ((wcEtInv t.left).obj X))
          ((wcEtToProEt W'.left).obj O')
          (wcEpsRho W'.left ((wcEtInv t.left).obj X) O' (wcEtInvRho t.left X O O' h hh y))) =
      (((wcSliceExt S W).obj ((wcEpsInv W.left).obj X)).obj.map
          (wcSliceSliceHom S t O O' h hh).op).hom
        (wcSliceRho S W ((wcEpsInv W.left).obj X) ((wcEtToProEt W.left).obj O)
          (wcEpsRho W.left X O y))
