structure wcpaBscChartData (S : Scheme.{u}) where
  J : Type u
  V : J → S.Opens
  affine : ∀ i, IsAffineOpen (V i)
  cover : ∀ x : S, ∃ i, x ∈ V i
  a : ∀ i, Γ(S, V i)
  b : ∀ i, Γ(S, V i)
  c : ∀ i, Γ(S, V i)
  disc : ∀ i, IsUnit (b i ^ 2 - 4 * a i * c i)
  lam : ∀ i j, (Γ(S, V i ⊓ V j))ˣ
  M : ∀ i j, Matrix (Fin 2) (Fin 2) Γ(S, V i ⊓ V j)
  detM : ∀ i j, IsUnit (M i j).det
  rule_a : ∀ i j, wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (a j) =
    (lam i j : Γ(S, V i ⊓ V j)) *
      (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i) * M i j 0 0 ^ 2 +
        wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i) * (M i j 0 0 * M i j 1 0) +
        wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i) * M i j 1 0 ^ 2)
  rule_b : ∀ i j, wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (b j) =
    (lam i j : Γ(S, V i ⊓ V j)) *
      (2 * wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i) * (M i j 0 0 * M i j 0 1) +
        wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i) *
          (M i j 0 0 * M i j 1 1 + M i j 0 1 * M i j 1 0) +
        2 * wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i) * (M i j 1 0 * M i j 1 1))
  rule_c : ∀ i j, wcpaBscRes S (inf_le_right : V i ⊓ V j ≤ V j) (c j) =
    (lam i j : Γ(S, V i ⊓ V j)) *
      (wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (a i) * M i j 0 1 ^ 2 +
        wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (b i) * (M i j 0 1 * M i j 1 1) +
        wcpaBscRes S (inf_le_left : V i ⊓ V j ≤ V i) (c i) * M i j 1 1 ^ 2)
  M_self : ∀ i, M i i = 1
  lam_self : ∀ i, lam i i = 1
  M_cocycle : ∀ i j l,
    (M i l).map (wcpaBscRes S (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)) =
      (M i j).map (wcpaBscRes S (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)) *
        (M j l).map (wcpaBscRes S (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V j ⊓ V l))
  lam_cocycle : ∀ i j l,
    wcpaBscRes S (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        V i ⊓ V j ⊓ V l ≤ V i ⊓ V l) (lam i l : Γ(S, V i ⊓ V l)) =
      wcpaBscRes S (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j) (lam i j : Γ(S, V i ⊓ V j)) *
        wcpaBscRes S (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V j ⊓ V l) (lam j l : Γ(S, V j ⊓ V l))


