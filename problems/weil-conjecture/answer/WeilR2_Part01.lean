    wcModCoh F X h ℓ i →+ wcModCoh F X h ℓ j →+ wcModCoh F X h ℓ k :=
  @Abelian.Ext.bilinearComp _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcSliceRing F X h ℓ)) (SheafOfModules.unit (wcSliceRing F X h ℓ))
    (SheafOfModules.unit (wcSliceRing F X h ℓ)) i j k hk
