abbrev wcSrmCh (A : Type u) [CommRing A] (r : ℕ) : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
  Matrix.of fun p q : Fin (r + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0

abbrev wcSrmC0 (A : Type u) [CommRing A] (r : ℕ) : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
  Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0

noncomputable abbrev wcSrmGen (A : Type u) [CommRing A] (r : ℕ) (π : A) (i : Fin (r + 2)) :
    wcQuadModelRing A (r + 2) π (wcSrmCh A r) :=
  Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
    (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
      Fin (r + 2)))

noncomputable abbrev wcSrmFimg (A : Type u) [CommRing A] (r : ℕ) (p : Fin (r + 2)) :
    MvPolynomial (Fin (r + 2)) A :=
  if p.val = 0 then MvPolynomial.X p
  else if p.val = 1 then
    MvPolynomial.X p + MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
      ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b
  else if p.val % 2 = 0 then MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X p
  else MvPolynomial.X p
def wcHomMatChar (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [Fintype ιb]
    (θA : A.over W ≅ (wcContSheaf S (ιa → ℚ_[ℓ])).over W)
    (θB : B.over W ≅ (wcContSheaf S (ιb → ℚ_[ℓ])).over W)
    (U : Over W) (φ : A.over U.left ⟶ B.over U.left) (M : U.left.left → Matrix ιb ιa ℚ_[ℓ]) : Prop :=
  ∀ (Y : Over U.left) (g : Y.left ⟶ W), Y.hom ≫ U.hom = g →
    ∀ (a : A.obj.obj (Opposite.op Y.left)) (t : Y.left.left),
      (show C(↥Y.left.left, ιb → ℚ_[ℓ]) from
        ((θB.hom.hom.app (Opposite.op (Over.mk g))).hom ((φ.hom.app (Opposite.op Y)).hom a)).down) t =
      (M (Y.hom.left t)).mulVec ((show C(↥Y.left.left, ιa → ℚ_[ℓ]) from
        ((θA.hom.hom.app (Opposite.op (Over.mk g))).hom a).down) t)
noncomputable def wcClosedAdjTrade {W W₁ T T₁ : Scheme.{u}} {q : W₁ ⟶ W} {k : T ⟶ W}
    {k₁ : T₁ ⟶ W₁} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Dq : wcHMPullData q ℓ) (Dk : wcHMPullData k ℓ) (Dk₁ : wcHMPullData k₁ ℓ)
    (hex : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ))
    {N : SheafOfModules.{u+1} (wcRingSheaf W ℓ)}
    (β : wcSuppObj Dk₁ ⟶ Dq.Φ.obj (wcSuppObj Dk)) (ψ : N ⟶ wcSuppObj Dq) (n : ℕ)
    (x : @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) _ _ (HasExt.standard _)
      (wcSuppObj Dk) N n) : wcSuppExt Dk₁ n := by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W₁ ℓ)) := HasExt.standard _
  haveI := Dq.additive
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).Additive :=
    Adjunction.right_adjoint_additive Dq.adj
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ) := by
    haveI := Dq.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI := hex
  exact (Abelian.Ext.mk₀ β).comp (Function.invFun
    (fun e : Abelian.Ext (Dq.Φ.obj (wcSuppObj Dk)) (SheafOfModules.unit (wcRingSheaf W₁ ℓ)) n =>
      ((Abelian.Ext.mk₀ (Dq.adj.unit.app (wcSuppObj Dk))).comp
        (Abelian.Ext.mapExactFunctor
          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ) e)
        (zero_add n) : Abelian.Ext (wcSuppObj Dk) (wcSuppObj Dq) n))
    (x.comp (Abelian.Ext.mk₀ ψ) (add_zero n))) (zero_add n)
noncomputable def wcPclRhoA {X V : Scheme.{u}} (q : V ⟶ X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
