    rw [← hy]
    exact y.2




  have glue : ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) {U : X.Etale} {k : ℕ} (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.smallEtaleTopology X U → (∀ w : ∀ σ : Fin 1 → Fin k, F.obj.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))), (∀ τ : Fin 2 → Fin k, ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) • F.obj.map (wcCechFace V f τ j).op (w (fun l => τ (j.succAbove l))) = 0) → ∃ t : F.obj.obj (Opposite.op U), ∀ σ : Fin 1 → Fin k, F.obj.map (Limits.WidePullback.base (fun l => f (σ l))).op t = w σ) ∧ (∀ s s' : F.obj.obj (Opposite.op U), (∀ σ : Fin 1 → Fin k, F.obj.map (Limits.WidePullback.base (fun l => f (σ l))).op s = F.obj.map (Limits.WidePullback.base (fun l => f (σ l))).op s') → s = s') := by
    intro F U k V f hcov
    have hcomp : ∀ {A B D : X.Etale} (a : A ⟶ B) (b : B ⟶ D) (y : F.obj.obj (Opposite.op D)),
