def wcRatCoord (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {M : Type*} [AddCommGroup M] {r : ℕ}
    (ι : M →+ (Fin r → ℚ_[ℓ])) : Prop :=
  (∀ x, ι x = 0 ↔ ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0) ∧
  (∀ v : Fin r → ℚ_[ℓ], ∃ (k : ℕ) (x : M), ((ℓ : ℚ_[ℓ]) ^ k) • v = ι x) ∧
  (∀ (x : M) (a : ℤ_[ℓ]), ∃ y, ι y = ((a : ℚ_[ℓ])) • ι x) ∧
  (∀ x, (∀ k : ℕ, ∃ y, ι x = ((ℓ : ℚ_[ℓ]) ^ k) • ι y) → ι x = 0)
noncomputable def wcpaDjFlrgSat (k : Type u) [Field k] (N : ℕ) {B Z : Scheme.{u}}
    (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B)
    (hZ : jZ ≫ wcProjKStr k N = g ≫ sB) (V : B.Opens) :
    Ideal (MvPolynomial (Fin (N + 1)) Γ(B, V)) :=
  Ideal.span {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i : Fin (N + 1),
    wcpaDjFlrgPsi k N sB V i F ∈
      RingHom.ker ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom}

noncomputable abbrev wcpaDjDeg {A : Type u} [CommRing A] (N : ℕ)
