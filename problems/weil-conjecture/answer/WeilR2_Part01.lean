def wcSplitRel {X V : Scheme.{u}} {p : V ⟶ X} {m : ℕ} {a : ZMod m → (V ⟶ V)}
    (ht : wcFetTorsor p m a) {G E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
    (ρ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ G) (f : G ⟶ E)
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (s : E.obj.obj (Opposite.op (wcTorsorEt p ht.etale))) : Prop :=
  (g.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom s =
      wcConstSec X (ULift.{u+1} ℤ) (wcTorsorEt p ht.etale) (ULift.up 1) ∧
    ∀ c : ZMod m, (E.obj.map (wcTorsorAct p ht.etale (a c) (ht.act_p c)).op).hom s =
      s + (f.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
        ((ρ.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) (wcTorsorEt p ht.etale) (ULift.up c)))
