instance wcH2rGamFinite (ℓ k n : ℕ) [Fact (Nat.Prime ℓ)] : Finite (wcH2rGam.{u} ℓ k n) := by
  haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : Nat.Prime ℓ).ne_zero⟩
  exact inferInstanceAs (Finite (ULift.{u} (Multiplicative (AddAut (Fin k → ZMod (ℓ ^ n))))))

noncomputable def wcH2rPre {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hα : ∀ g, (α g).hom ≫ q = q) (ℓ n r : ℕ)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  wcExtZeroPre (wcH2EqPre (wcH2TwBase q ℓ n r)
      (fun g : Γ => Functor.whiskerRight (NatTrans.op (wcPbAct q (α g).hom (hα g)))
        (continuousMapPresheafAb.{0, u} (Fin r → ZMod (ℓ ^ n)) ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}))
      (fun g : Γ => wcH2TwMat q ℓ n r
        (((ρ g)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))))
    (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
noncomputable abbrev wcNcIdeal {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a : ↥W) :
    Ideal (MvPolynomial (Fin 2) ↥W) :=
