abbrev wcCompIdx (C : Scheme.{u}) : Type u :=
  {Z : Set C // Z ∈ irreducibleComponents C ∧ ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞)}
def wcKummerEig {L S B : Type*} [Field L] [CommRing S] [CommRing B] [Algebra S B] [Algebra L B]
    (τ : B →ₐ[S] B) (c : L) : Submodule S B where
  carrier := {b | τ b = algebraMap L B c * b}
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [map_add, ha, hb, mul_add]
  zero_mem' := by
    simp only [Set.mem_setOf_eq]
    rw [map_zero, mul_zero]
  smul_mem' := by
    intro r b hb
    simp only [Set.mem_setOf_eq] at hb ⊢
    rw [map_smul, hb, mul_smul_comm]
