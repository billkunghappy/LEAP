      (n : WithBot ℕ∞) = ringKrullDim (Y.presheaf.stalk y) ∧
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) ∧
      ∃ a : {i : Fin m // y ∈ Dc i} → Fin n, Function.Injective a ∧
        ∀ (i : {i : Fin m // y ∈ Dc i}) (y' : Y) (h : y' ⤳ y),
          (y' ∈ Dc i.1 ↔ (Y.presheaf.stalkSpecializes h).hom (t (a i)) ∈
            IsLocalRing.maximalIdeal (Y.presheaf.stalk y'))

