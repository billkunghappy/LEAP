    MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) a + Finsupp.single (1 : Fin 2) b) G

noncomputable def wcpaDjStcTuCsTw {A : Type u} [CommRing A] (h : A) (j : ℕ)
    (G : MvPowerSeries (Fin 2) A) : PowerSeries A :=
