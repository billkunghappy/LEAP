      have hx := AddSubgroup.mem_iInf.mp x.2
      refine AddSubgroup.mem_iInf.mpr (fun i => ?_)
      have hxi := hx i
      rw [AddMonoidHom.mem_ker] at hxi ⊢
      have h1 := congrArg (fun φ => φ.hom x.1) ((a i).naturality g)
      have h2 := congrArg (fun φ => φ.hom x.1) ((b i).naturality g)
