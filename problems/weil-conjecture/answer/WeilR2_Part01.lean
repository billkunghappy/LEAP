def wcP1ClosedPt (K : Type u) [Field K] (d : ℕ) : Set (wcP1Over K).left :=
  {x | IsClosed ({x} : Set (wcP1Over K).left) ∧
    letI : Module K ((wcP1Over K).left.residueField x) :=
      (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toModule
    Module.finrank K ((wcP1Over K).left.residueField x) = d}

structure wcFrobNbhd (K : Type u) [Field K] (x : (wcP1Over K).left) (d : ℕ) where
  V : (wcP1Over K).left.ProEt
  φ : V ⟶ V
  A : Type u
  [ringA : CommRing A]
  [hensA : HenselianLocalRing A]
  [sepA : IsSepClosed (IsLocalRing.ResidueField A)]
  e : V.left ≅ Spec (.of A)
  hx : V.hom (e.inv (IsLocalRing.closedPoint A)) = x
  ψ : A →+* A
  hψ : e.inv ≫ φ.left ≫ e.hom = Spec.map (CommRingCat.ofHom ψ)
  hfrob : ∀ a : A, ψ a ^ (Nat.card K ^ d) - a ∈ IsLocalRing.maximalIdeal A

structure wcPencilStalkBasis {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (x : (wcP1Over F'').left) (d : ℕ) where
  N : wcFrobNbhd F'' x d
  r : ℕ
  e : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcPencilVQ D ℓ hP) 0 ≃+ (Fin r → ℚ_[ℓ])
  he : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcPencilVQ D ℓ hP) 0),
    e ((Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
      (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) = c • e y

noncomputable def wcPencilLoc {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (x : (wcP1Over F'').left) (d : ℕ) : Multiset (AlgebraicClosure ℚ_[ℓ]) := by
  classical
  exact if h : Nonempty (wcPencilStalkBasis D ℓ hP x d) then
    (wcAddEquivMatrix h.some.e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
      h.some.N.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0))).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ])
  else 0

def wcPencilOffS {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (d : ℕ) :
    Set (wcP1Over F'').left :=
  {x | d ≠ 0 ∧ x ∈ wcP1ClosedPt F'' d ∧ ∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')}

noncomputable def wcPencilNp {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (d : ℕ) : ℕ :=
  Nat.card (wcPencilOffS D d)

noncomputable def wcPencilPt {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (d : ℕ)
    (i : Fin (wcPencilNp D d)) : (wcP1Over F'').left := by
  classical
  exact if h : Finite (wcPencilOffS D d) then ((@Finite.equivFin _ h).symm i).1
    else D.u0 (IsLocalRing.closedPoint F'')

noncomputable def wcPencilLocIdx {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (d : ℕ) (i : Fin (wcPencilNp D d)) : Multiset (AlgebraicClosure ℚ_[ℓ]) :=
  wcPencilLoc D ℓ hP (wcPencilPt D d i) d
