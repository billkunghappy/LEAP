noncomputable def wcBkTruncTheta {C : Type*} [Category C] [Abelian C] (P : C)
    (Y : CochainComplex C ℕ) (N : ℕ) : (k : ℕ) → (P ⟶ Y.X (k + 1)) → (P ⟶ wcTruncKerX Y N k)
  | 0, c => if hc : c ≫ (N • 𝟙 (Y.X 1)) = 0 then
      Limits.kernel.lift (N • 𝟙 (Y.X 1)) c hc ≫ Limits.cokernel.π (wcTruncKerD Y N 0)
    else 0
  | j + 1, c => if hc : c ≫ (N • 𝟙 (Y.X (j + 2))) = 0 then
      Limits.kernel.lift (N • 𝟙 (Y.X (j + 2))) c hc
    else 0
def wcpaDjSolSS {Z T : Scheme.{u}} (u : Z ⟶ T) (K : Type u) [Field K] (s : Spec (.of K) ⟶ T) : Prop :=
  ∀ (w : ↥(Limits.pullback u s)),
    (∃ W : (Limits.pullback u s).Opens, w ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd u s)) ∨
    (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w))
        ((Limits.pullback u s).presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      (e.toRingHom.comp ((algebraMap ((Limits.pullback u s).presheaf.stalk w)
        (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w))
          ((Limits.pullback u s).presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u s).appTop ≫
          (Limits.pullback u s).presheaf.germ ⊤ w trivial).hom)) =
      (Ideal.Quotient.mk _).comp MvPowerSeries.C)

def wcpaDjSolStab {Z T : Scheme.{u}} (u : Z ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z))
    (K : Type u) [Field K] (s : Spec (.of K) ⟶ T) : Prop :=
  ∀ (E : Set ↥(Limits.pullback u s)), E ∈ irreducibleComponents ↥(Limits.pullback u s) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u s) →
    3 ≤ (E ∩ closure Eᶜ).ncard +
      Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u s x = τ i (s p)}
abbrev wcR1sC0 (A : Type u) [CommRing A] (r : ℕ) : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
  Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0

abbrev wcR1sCH (A : Type u) [CommRing A] (r : ℕ) : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
  Matrix.of fun p q : Fin (r + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0

abbrev wcR1sM (A : Type u) [CommRing A] (r : ℕ) (π : A) : Type u :=
  wcQuadModelRing A (r + 2) π (wcR1sC0 A r)

abbrev wcR1sR (A : Type u) [CommRing A] (r : ℕ) (π : A) : Type u :=
  wcQuadModelRing A (r + 2) π (wcR1sCH A r)

noncomputable abbrev wcR1sY0 (A : Type u) [CommRing A] (r : ℕ) (π : A) : wcR1sM A r π :=
  Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sC0 A r))
    (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))

noncomputable abbrev wcR1sY1 (A : Type u) [CommRing A] (r : ℕ) (π : A) : wcR1sM A r π :=
  Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sC0 A r))
    (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))

noncomputable abbrev wcR1sJ (A : Type u) [CommRing A] (r : ℕ) (π : A) : Ideal (wcR1sR A r π) :=
  Ideal.span (Set.range fun i : Fin (r + 2) =>
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sCH A r))
      (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
        Fin (r + 2))))
noncomputable def wcpaDjValOrd {F : Type u} [Field F] (V : ValuationSubring F) (x : F) : ℤ :=
  ((sSup {n : ℕ | ∃ h : x ∈ V, (⟨x, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} : ℕ) : ℤ) -
  ((sSup {n : ℕ | ∃ h : x⁻¹ ∈ V, (⟨x⁻¹, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} : ℕ) : ℤ)

def wcpaDjChartGood {C : Scheme.{u}} (L : wcpaDjCoc C) (ξ : C)
    (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m) : Prop :=
  ∃ hb : ξ ∈ L.V b, ∀ x : Γ(C, L.V b), (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom x ∈ V

noncomputable def wcpaDjCompDeg {C : Scheme.{u}} (L : wcpaDjCoc C) (ξ : C) (a : Fin L.m) : ℤ := by
  classical
  exact ∑ᶠ V : ValuationSubring (C.residueField ξ),
    if h : ξ ∈ L.V a ∧ ∃ b, wcpaDjChartGood L ξ V b then
      wcpaDjValOrd V ((C.presheaf.germ (L.V a ⊓ L.V h.2.choose) ξ
        ⟨h.1, h.2.choose_spec.choose⟩ ≫ C.residue ξ).hom (L.g a h.2.choose : Γ(C, L.V a ⊓ L.V h.2.choose)))
    else 0

noncomputable def wcpaDjKConst {C : Scheme.{u}} (K : Type u) [Field K] (q : C ⟶ Spec (.of K))
    (U : C.Opens) : K →+* Γ(C, U) :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom

def wcpaDjSepSec {C : Scheme.{u}} (K : Type u) [Field K] (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C)
    (e M : ℕ) (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)) : Prop :=
  (∀ J a b,
      (C.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V b ⊓ q ⁻¹ᵁ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t J b) =
        (C.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom ((L.g a b : Γ(C, L.V a ⊓ L.V b)) ^ e) *
        (C.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V a ⊓ q ⁻¹ᵁ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t J a)) ∧
    (∀ a, Ideal.span (Set.range (fun J => t J a)) = ⊤) ∧
    (∀ (J : Fin (M + 1)) (a b : Fin L.m) (x y : C) (hx : x ∈ C.basicOpen (t J a))
        (hy : y ∈ C.basicOpen (t J b)), IsClosed ({x} : Set C) → IsClosed ({y} : Set C) → x ≠ y →
      ∃ (l : Fin (M + 1)) (c : K),
        (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x (C.basicOpen_le (t J a) hx)).hom
            (t l a - wcpaDjKConst K q _ c * t J a) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) ∧
        (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) y (C.basicOpen_le (t J b) hy)).hom
            (t l b - wcpaDjKConst K q _ c * t J b) ∉ IsLocalRing.maximalIdeal (C.presheaf.stalk y)) ∧
    (∀ (J : Fin (M + 1)) (a : Fin L.m) (x : C) (hx : x ∈ C.basicOpen (t J a)),
      IsClosed ({x} : Set C) →
      ∃ c : Fin (M + 1) → K,
        Ideal.span (Set.range (fun l => (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x
            (C.basicOpen_le (t J a) hx)).hom (t l a - wcpaDjKConst K q _ (c l) * t J a))) =
          IsLocalRing.maximalIdeal (C.presheaf.stalk x))
def wcpaDjAvRatio {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (W : T.Opens) {N : ℕ}
    (s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)) (J : Fin (N + 1))
    (ρ : Fin (N + 1) → Γ(Y, ⨆ a, Y.basicOpen (s J a))) : Prop :=
  ∀ a l, (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (s J a')) a)).op).hom (ρ l) *
      (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s J a) =
    (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s l a)

noncomputable def wcpaDjAvChart {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (W : T.Opens)
