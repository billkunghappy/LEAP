noncomputable def wcEtExtZeroPre (Y : Scheme.{u}) (S : Set Y) (m : ℕ) :
    (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj V := AddCommGrpCat.of (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ S))
  map {V W} g := AddCommGrpCat.ofHom (AddSubgroup.inclusion
    (iSup_le fun hp => le_iSup_of_le (fun x => by
      rw [← MorphismProperty.Over.w g.unop, Scheme.Hom.comp_apply]
      exact hp _) le_rfl))
  map_id _ := rfl
  map_comp _ _ := rfl

