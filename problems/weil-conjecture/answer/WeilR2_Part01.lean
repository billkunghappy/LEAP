def wcpaDjGmMu {B : Type u} [CommRing B] {X Y T : Scheme.{u}} (h : X ⟶ Spec (.of B))
    (I : Ideal B) (q : Y ⟶ T) (p : Y ⟶ X) : Prop :=
  ∃ μ : ∀ O : X.Opens, IsAffineOpen O →
      (reesAlgebra (Ideal.map (wcCnSigma h O) I) →+* Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
    (∀ O hO, Function.Surjective (μ O hO)) ∧
    (∀ O hO z, μ O hO z = 0 ↔
      ∀ k, (z : Polynomial Γ(X, O)).coeff k ∈ Ideal.map (wcCnSigma h O) (I ^ (k + 1))) ∧
    (∀ O hO (s : Γ(X, O)), μ O hO (algebraMap Γ(X, O) _ s) =
      (Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom ((p.app O).hom s)) ∧
    (∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O)
      (z : reesAlgebra (Ideal.map (wcCnSigma h O) I))
      (z' : reesAlgebra (Ideal.map (wcCnSigma h O') I)),
      (z' : Polynomial Γ(X, O')) =
        Polynomial.map (X.presheaf.map (homOfLE hle).op).hom (z : Polynomial Γ(X, O)) →
      μ O' hO' z' = (Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤)
        (Scheme.Hom.preimage_mono p hle))).op).hom (μ O hO z))


def wcpaDjGmLam {B : Type u} [CommRing B] {X Y T : Scheme.{u}} (h : X ⟶ Spec (.of B))
    (I : Ideal B) (q : Y ⟶ T) (p : Y ⟶ X) : Prop :=
  ∃ (lam : ∀ O : X.Opens, IsAffineOpen O → ℕ → Γ(X, O) → Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤))
    (Pj : ∀ O : X.Opens, IsAffineOpen O → ℕ → Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤) → Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x x' : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) → x' ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      lam O hO k (x + x') = lam O hO k x + lam O hO k x') ∧
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (s x : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      lam O hO k (s * x) = (Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom
        ((p.app O).hom s) * lam O hO k x) ∧
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      (lam O hO k x = 0 ↔ x ∈ Ideal.map (wcCnSigma h O) (I ^ (k + 1)))) ∧
    (∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O) (k : ℕ)
      (x : Γ(X, O)), x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      (Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤) (Scheme.Hom.preimage_mono p hle))).op).hom
        (lam O hO k x) = lam O' hO' k ((X.presheaf.map (homOfLE hle).op).hom x)) ∧
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (z z' : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      Pj O hO k (z + z') = Pj O hO k z + Pj O hO k z') ∧
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (s : Γ(X, O)) (z : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      Pj O hO k ((Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom
        ((p.app O).hom s) * z) =
      (Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom
        ((p.app O).hom s) * Pj O hO k z) ∧
    (∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O) (k : ℕ)
      (z : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      (Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤) (Scheme.Hom.preimage_mono p hle))).op).hom
        (Pj O hO k z) =
      Pj O' hO' k ((Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤)
        (Scheme.Hom.preimage_mono p hle))).op).hom z)) ∧
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) → Pj O hO k (lam O hO k x) = lam O hO k x) ∧
    (∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (z : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      ∃ x, x ∈ Ideal.map (wcCnSigma h O) (I ^ k) ∧ Pj O hO k z = lam O hO k x)
