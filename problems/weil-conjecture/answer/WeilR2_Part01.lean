noncomputable def wcQdcbDelta {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {j : T ⟶ V}
    (Dj : wcHMPullData j ℓ) {Wo : V.Opens} (Dw : wcHMPullData Wo.ι ℓ)
