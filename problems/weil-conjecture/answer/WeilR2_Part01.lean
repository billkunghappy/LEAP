    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op) _).app J

def wcNTorsRes (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (N : ℕ) (𝓖 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (J : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (η : 𝓖 ⟶ J.X 0) : Prop :=
  (∀ i, ((N : ℕ) : ℤ) • 𝟙 (J.X i) = 0) ∧
  Mono η ∧
  (∃ w : η ≫ J.d 0 1 = 0, (ShortComplex.mk η (J.d 0 1) w).Exact) ∧
  (∀ i, (J.sc (i + 1)).Exact) ∧
  (∀ (i : ℕ) (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (mm : A ⟶ B), Mono mm → ((N : ℕ) : ℤ) • 𝟙 B = 0 →
      ∀ φ : A ⟶ J.X i, ∃ ψ : B ⟶ J.X i, mm ≫ ψ = φ) ∧
  (∀ (i j : ℕ), 1 ≤ j → ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (J.X i) j, y = 0)
noncomputable def wcQdcbPsi {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {j : T ⟶ V}
    (Dj : wcHMPullData j ℓ) {Wo : V.Opens} (Dw : wcHMPullData Wo.ι ℓ)
