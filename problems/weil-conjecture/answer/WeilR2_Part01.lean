open Classical in
noncomputable def wcKtIotaE (ℓ n d k : ℕ) :
    wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶ wcKtE.{u} ℓ n d k :=
