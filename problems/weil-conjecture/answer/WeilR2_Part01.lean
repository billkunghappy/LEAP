    (SheafOfModules.unit (wcSliceRing F X h ℓ)) (SheafOfModules.unit (wcSliceRing F X h ℓ)) n

noncomputable def wcModConst (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (c : ℚ_[ℓ]) :
    SheafOfModules.unit (wcSliceRing F X h ℓ) ⟶ SheafOfModules.unit (wcSliceRing F X h ℓ) :=
  (SheafOfModules.unitHomEquiv _).symm
    (PresheafOfModules.sectionsMk (M := (SheafOfModules.unit (wcSliceRing F X h ℓ)).val)
      (fun V => (ContinuousMap.const _ (ULift.up c) :
        C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ])))
      (fun _ _ _ => rfl))

noncomputable def wcModScalar (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (c : ℚ_[ℓ]) :
    wcModCoh F X h ℓ n →+ wcModCoh F X h ℓ n :=
  @Abelian.Ext.postcomp _ _ _ (HasExt.standard _) _ _ 0
    (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcModConst F X h ℓ c))
