def wcLim1Zero {A : ℕ → Type*} [∀ k, AddCommGroup (A k)] (τ : ∀ k, A (k + 1) →+ A k) : Prop :=
  ∀ β : ∀ k, A k, ∃ z : ∀ k, A k, ∀ k, 1 ≤ k → β k = z k - τ k (z (k + 1))

structure wcLadicPackage {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (D : wcHMPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (q : ℕ) where
  MY : Type (u+2)
  MT : Type (u+2)
  [instMY : AddCommGroup MY]
  [instModY : Module ℤ_[ℓ] MY]
  [instMT : AddCommGroup MT]
  ρY : MY →+ wcHM Y ℓ q
  ρT : MT →+ wcHM T ℓ q
  redY : ∀ k : ℕ, MY →+ wcZModProEtExt Y (ℓ ^ k) q
  redT : ∀ k : ℕ, MT →+ wcZModProEtExt T (ℓ ^ k) q
  τY : ∀ k j : ℕ, wcZModProEtExt Y (ℓ ^ (k + 1)) j →+ wcZModProEtExt Y (ℓ ^ k) j
  τT : ∀ k j : ℕ, wcZModProEtExt T (ℓ ^ (k + 1)) j →+ wcZModProEtExt T (ℓ ^ k) j
  pI : MY →+ MT
  act : C(↥T, ULift.{u+1} ℤ_[ℓ]) → MT →+ MT
  denomY : ∀ x : wcHM Y ℓ q, ∃ (n : ℕ) (y : MY), wcHMScalar Y ℓ q ((ℓ : ℚ_[ℓ]) ^ n) x = ρY y
  denomT : ∀ x : wcHM T ℓ q, ∃ (n : ℕ) (y : MT), wcHMScalar T ℓ q ((ℓ : ℚ_[ℓ]) ^ n) x = ρT y
  torsY : ∀ y : MY, ρY y = 0 → ∃ s : ℕ, (ℓ ^ s : ℕ) • y = 0
  torsT : ∀ y : MT, ρT y = 0 → ∃ s : ℕ, (ℓ ^ s : ℕ) • y = 0
  ρY_smul : ∀ (c : ℤ_[ℓ]) (y : MY), ρY (c • y) = wcHMScalar Y ℓ q (c : ℚ_[ℓ]) (ρY y)
  redY_smul : ∀ (k : ℕ) (c : ℤ_[ℓ]) (y : MY),
    redY k (c • y) = (PadicInt.toZModPow k c).val • redY k y
  redY_compat : ∀ (k : ℕ) (y : MY), 1 ≤ k → τY k q (redY (k + 1) y) = redY k y
  redT_compat : ∀ (k : ℕ) (y : MT), 1 ≤ k → τT k q (redT (k + 1) y) = redT k y
  liftY : ∀ α : ∀ k, wcZModProEtExt Y (ℓ ^ k) q, (∀ k, 1 ≤ k → τY k q (α (k + 1)) = α k) →
    ∃ y : MY, ∀ k, 1 ≤ k → redY k y = α k
  sepY : @wcLim1Zero (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => τY k (q - 1)) →
    ∀ y : MY, (∀ k, 1 ≤ k → redY k y = 0) → y = 0
  sepT : @wcLim1Zero (fun k => wcZModProEtExt T (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => τT k (q - 1)) →
    ∀ y : MT, (∀ k, 1 ≤ k → redT k y = 0) → y = 0
  kerY : ∀ (k : ℕ) (y : MY), redY k y = 0 → ∃ y' : MY, y = (ℓ ^ k : ℕ) • y'
  ρ_pI : ∀ y : MY, ρT (pI y) = wcHMPull D q (ρY y)
  red_pI : ∀ (k : ℕ) (y : MY), redT k (pI y) = wcZModPull (Dk k) q (redY k y)
  ρ_act : ∀ (r : C(↥T, ULift.{u+1} ℤ_[ℓ])) (r' : C(↥T, ULift.{u+1} ℚ_[ℓ])),
    (∀ t, (r' t).down = ((r t).down : ℚ_[ℓ])) → ∀ z : MT,
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    ρT (act r z) = (Abelian.Ext.mk₀ (wcHMFun T ℓ r')).comp (ρT z) (zero_add q)
  red_act : ∀ (k : ℕ) (r : C(↥T, ULift.{u+1} ℤ_[ℓ])) (rk : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))),
    (∀ t, (rk t).down = PadicInt.toZModPow k (r t).down) → ∀ z : MT,
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    redT k (act r z) = (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) rk)).comp (redT k z) (zero_add q)
  τ_pull : ∀ (k j : ℕ) (a : wcZModProEtExt Y (ℓ ^ (k + 1)) j),
    τT k j (wcZModPull (Dk (k + 1)) j a) = wcZModPull (Dk k) j (τY k j a)
  τ_fun : ∀ (k j : ℕ) (r1 : C(↥T, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))))
    (r0 : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))),
    (∀ t, (r0 t).down = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (r1 t).down) →
    ∀ b : wcZModProEtExt T (ℓ ^ (k + 1)) j,
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ (k + 1)))) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    τT k j ((Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ (k + 1)) r1)).comp b (zero_add j)) =
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r0)).comp (τT k j b) (zero_add j)
noncomputable def wcLpttE0 (m : ℕ) (R : CommRingCat.{u}) : (wcKtT.{u} m 0).obj R :=
  (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)
noncomputable def wcPreTens {C : Type*} [Category C] (A B : C ⥤ AddCommGrpCat.{u}) :
    C ⥤ AddCommGrpCat.{u} where
  obj X := AddCommGrpCat.of (TensorProduct ℤ (A.obj X) (B.obj X))
  map f := AddCommGrpCat.ofHom (TensorProduct.map (A.map f).hom.toIntLinearMap
    (B.map f).hom.toIntLinearMap).toAddMonoidHom
  map_id X := by
    ext x
    change TensorProduct.map _ _ x = x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r p => simp
    | add x y hx hy => rw [map_add, hx, hy]
  map_comp f g := by
    ext x
    change TensorProduct.map _ _ x = TensorProduct.map _ _ (TensorProduct.map _ _ x)
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r p => simp
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]

def wcKaSub (R : CommRingCat.{u}) (m : ℕ) (c : Rˣ) : AddSubgroup (ℤ × Additive Rˣ) where
  carrier := {y | (Additive.toMul y.2) ^ m = c ^ y.1}
  add_mem' := by
    intro x y hx hy
    have hx' : (Additive.toMul x.2) ^ m = c ^ x.1 := hx
    have hy' : (Additive.toMul y.2) ^ m = c ^ y.1 := hy
    show (Additive.toMul (x.2 + y.2)) ^ m = c ^ (x.1 + y.1)
    rw [toMul_add, mul_pow, hx', hy', zpow_add]
  zero_mem' := by
    show (Additive.toMul (0 : Additive Rˣ)) ^ m = c ^ (0 : ℤ)
    rw [toMul_zero, one_pow, zpow_zero]
  neg_mem' := by
    intro x hx
    have hx' : (Additive.toMul x.2) ^ m = c ^ x.1 := hx
    show (Additive.toMul (-x.2)) ^ m = c ^ (-x.1)
    rw [toMul_neg, inv_pow, hx', zpow_neg]

noncomputable def wcKaUnit (Y : Scheme.{u}) (a : (Γ(Y, ⊤))ˣ) (W : (Y.Etale)ᵒᵖ) :
    (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ :=
  Units.map W.unop.hom.appTop.hom.toMonoidHom a

noncomputable def wcKaE (Y : Scheme.{u}) (m : ℕ) (a : (Γ(Y, ⊤))ˣ) :
    (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} where
  obj W := AddCommGrpCat.of (wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) m (wcKaUnit Y a W))
  map {W W'} f := AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
    (((AddMonoidHom.id ℤ).prodMap (MonoidHom.toAdditive (Units.map
      (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom.toMonoidHom))).comp
      (wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) m (wcKaUnit Y a W)).subtype)
    (wcKaSub (Scheme.Γ.obj (Opposite.op W'.unop.left)) m (wcKaUnit Y a W'))
    (fun x => by
      have hres : Units.map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom.toMonoidHom
          (wcKaUnit Y a W) = wcKaUnit Y a W' := by
        apply Units.ext
        have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
        have h1 := congrArg (fun q => q.appTop.hom (a : Γ(Y, ⊤))) hw
        simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
        exact h1
      have hx : (Additive.toMul x.1.2) ^ m = (wcKaUnit Y a W) ^ x.1.1 := x.2
      have e1 : (Units.map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom.toMonoidHom
          (Additive.toMul x.1.2)) ^ m = (wcKaUnit Y a W') ^ x.1.1 :=
        (map_pow _ _ _).symm.trans ((congrArg (Units.map
          (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom.toMonoidHom) hx).trans
          ((map_zpow _ _ _).trans (congrArg (fun z => z ^ x.1.1) hres)))
      exact e1))
  map_id := by
    intro W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · apply Additive.toMul.injective
      apply Units.ext
      show (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map (𝟙 W))).hom
          ((Additive.toMul x.1.2 : (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) :
            Scheme.Γ.obj (Opposite.op W.unop.left)) =
        ((Additive.toMul x.1.2 : (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) :
            Scheme.Γ.obj (Opposite.op W.unop.left))
      rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
      all_goals rfl
  map_comp := by
    intro W W' W'' f g
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · apply Additive.toMul.injective
      apply Units.ext
      show (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map (f ≫ g))).hom
          ((Additive.toMul x.1.2 : (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) :
            Scheme.Γ.obj (Opposite.op W.unop.left)) =
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map g)).hom
          ((Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom
            ((Additive.toMul x.1.2 : (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) :
              Scheme.Γ.obj (Opposite.op W.unop.left)))
      rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp]
      all_goals rfl

noncomputable def wcKaBPre (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ) :
    (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  wcPreTens (wcKaE Y (ℓ ^ n) a)
      ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcKtT.{u} (ℓ ^ n) k) ⋙
    AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable def wcKaIota (Y : Scheme.{u}) (m : ℕ) (a : (Γ(Y, ⊤))ˣ) (W : (Y.Etale)ᵒᵖ) :
    Additive (rootsOfUnity m (Scheme.Γ.obj (Opposite.op W.unop.left))) →+
      ↥(wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) m (wcKaUnit Y a W)) :=
  AddMonoidHom.codRestrict ((AddMonoidHom.inr ℤ (Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)).comp
      (MonoidHom.toAdditive (rootsOfUnity m (Scheme.Γ.obj (Opposite.op W.unop.left))).subtype))
    (wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) m (wcKaUnit Y a W))
    (fun ζ => by
      show ((Additive.toMul ζ : rootsOfUnity m (Scheme.Γ.obj (Opposite.op W.unop.left))) :
          (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) ^ m = (wcKaUnit Y a W) ^ (0 : ℤ)
      rw [zpow_zero]
      exact (mem_rootsOfUnity _ _).mp (Additive.toMul ζ).2)

noncomputable def wcKaFApp (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ) (W : (Y.Etale)ᵒᵖ) :
    (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).obj W ⟶
      (wcKaBPre Y ℓ n k a).obj W :=
  AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
    ((TensorProduct.map (wcKaIota Y (ℓ ^ n) a W).toIntLinearMap
      (LinearMap.id : (wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)) →ₗ[ℤ]
        (wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))).toAddMonoidHom.comp
      AddEquiv.ulift.toAddMonoidHom))

noncomputable def wcKaFPre (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ) :
    wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k)) ⟶ wcKaBPre Y ℓ n k a :=
  wcNatOf (wcKaFApp Y ℓ n k a)

noncomputable def wcKaGApp (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ) (W : (Y.Etale)ᵒᵖ) :
    (wcKaBPre Y ℓ n k a).obj W ⟶ (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)).obj W :=
  AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
    ((TensorProduct.lift ((LinearMap.lsmul ℤ
        ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))).comp
      ((AddMonoidHom.fst ℤ (Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)).comp
        (wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) (ℓ ^ n)
          (wcKaUnit Y a W)).subtype).toIntLinearMap)).toAddMonoidHom.comp
      AddEquiv.ulift.toAddMonoidHom))

noncomputable def wcKaGPre (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ) :
    wcKaBPre Y ℓ n k a ⟶ wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k) :=
  wcNatOf (wcKaGApp Y ℓ n k a)

noncomputable def wcKaTup (Y : Scheme.{u}) (ℓ D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (W : (Y.Etale)ᵒᵖ) :
    (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)) :=
  (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (s i),
    by
      have h := hℓ.map W.unop.hom.appTop.hom
      rw [map_natCast] at h
      exact h⟩ : (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))

noncomputable def wcKaT1App (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (W : (Y.Etale)ᵒᵖ) :
    (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).obj W ⟶
      (wcLpttEtPre Y (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ D) (wcRootsFun.{u} (ℓ ^ n)))
        (wcKtT.{u} (ℓ ^ n) k))).obj W :=
  AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
    ((LinearMap.rTensor ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      (TensorProduct.mk ℤ ((wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        ((wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)))).toAddMonoidHom.comp
      AddEquiv.ulift.toAddMonoidHom))

noncomputable def wcKaT1Pre (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k)) ⟶
      wcLpttEtPre Y (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ D) (wcRootsFun.{u} (ℓ ^ n)))
        (wcKtT.{u} (ℓ ^ n) k)) :=
  wcNatOf (wcKaT1App Y ℓ n D k s hℓ)

open Classical in
noncomputable def wcKaEs (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (a : (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (W : (Y.Etale)ᵒᵖ) :
    (wcKaE Y (ℓ ^ n) a).obj W ⟶ (wcKtE.{u} ℓ n D k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)) :=
  if hw : (AddCommGrpCat.ofHom ((zmultiplesHom _ (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W))).comp
        ((AddMonoidHom.fst ℤ (Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)).comp
          (wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) (ℓ ^ n) (wcKaUnit Y a W)).subtype)) :
        (wcKaE Y (ℓ ^ n) a).obj W ⟶ (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) ≫
      (wcKtPsi.{u} ℓ D k).app (Scheme.Γ.obj (Opposite.op W.unop.left)) =
    (AddCommGrpCat.ofHom ((TensorProduct.mk ℤ ((wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W))).toAddMonoidHom.comp
        ((AddMonoidHom.snd ℤ (Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)).comp
          (wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) (ℓ ^ n) (wcKaUnit Y a W)).subtype)) :
        (wcKaE Y (ℓ ^ n) a).obj W ⟶
          (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u}).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) ≫
      ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u})).app
        (Scheme.Γ.obj (Opposite.op W.unop.left)) then
    Limits.pullback.lift _ _ hw ≫
      (Limits.pullbackObjIso (wcKtPsi.{u} ℓ D k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u}))
        (Scheme.Γ.obj (Opposite.op W.unop.left))).inv
  else 0

noncomputable def wcKaT2App (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (a : (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (W : (Y.Etale)ᵒᵖ) :
    (wcKaBPre Y ℓ n k a).obj W ⟶
      (wcLpttEtPre Y (wcTensFun (wcKtE.{u} ℓ n D k) (wcKtT.{u} (ℓ ^ n) k))).obj W :=
  AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
    ((LinearMap.rTensor ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      (wcKaEs Y ℓ n D k s a hℓ W).hom.toIntLinearMap).toAddMonoidHom.comp
      AddEquiv.ulift.toAddMonoidHom))

noncomputable def wcKaT2Pre (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (a : (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    wcKaBPre Y ℓ n k a ⟶ wcLpttEtPre Y (wcTensFun (wcKtE.{u} ℓ n D k) (wcKtT.{u} (ℓ ^ n) k)) :=
  wcNatOf (wcKaT2App Y ℓ n D k s a hℓ)
noncomputable abbrev wcWP {C : Type*} [Category C] [Limits.HasFiniteWidePullbacks C] (U : C) {k : ℕ}
    (V : Fin k → C) (f : ∀ i, V i ⟶ U) {p : ℕ} (σ : Fin (p + 1) → Fin k) : C :=
  Limits.widePullback U (fun t => V (σ t)) (fun t => f (σ t))

noncomputable def wcSysRho {S : Scheme.{u}} {Uinf : S.ProEt} {D : ℕᵒᵖ ⥤ S.ProEt}
    {a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)} (A : wcEtSys D a) (k : ℕ) (O : Uinf.left.Etale)
    (E : (D.obj (Opposite.op k)).left.Etale) (π : O.left ⟶ E.left)
    (hπ : π ≫ E.hom = O.hom ≫ (a k).left) :
    (A.F k).obj.obj (Opposite.op E) →+ A.Finf.obj.obj (Opposite.op O) :=
  ((A.ψ k).hom.app (Opposite.op O)).hom.comp (wcEtInvRho (a k).left (A.F k) E O π hπ)

noncomputable def wcSysTau {S : Scheme.{u}} {Uinf : S.ProEt} {D : ℕᵒᵖ ⥤ S.ProEt}
    {a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)} (A : wcEtSys D a) (k l : ℕ) (h : k ≤ l)
    (E : (D.obj (Opposite.op k)).left.Etale) (E' : (D.obj (Opposite.op l)).left.Etale)
    (e : E'.left ⟶ E.left) (he : e ≫ E.hom = E'.hom ≫ (D.map (homOfLE h).op).left) :
    (A.F k).obj.obj (Opposite.op E) →+ (A.F l).obj.obj (Opposite.op E') :=
  ((A.φ k l h).hom.app (Opposite.op E')).hom.comp
    (wcEtInvRho (D.map (homOfLE h).op).left (A.F k) E E' e he)
def wcEtLevelSC1 {S : Scheme.{u}} (D : ℕᵒᵖ ⥤ S.ProEt)
    (F : ∀ k : ℕ, Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op k)).left) AddCommGrpCat.{u+1})
    (φ : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F k) ⟶ F l) : Prop :=
  ∀ (k l m : ℕ) (h₁ : k ≤ l) (h₂ : l ≤ m)
      (he : (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left),
      wcEtInvCompInv (D.map (homOfLE h₂).op).left (D.map (homOfLE h₁).op).left
          (D.map (homOfLE (h₁.trans h₂)).op).left he (F k) ≫
        (wcEtInv (D.map (homOfLE h₂).op).left).map (φ k l h₁) ≫ φ l m h₂ = φ k m (h₁.trans h₂)

noncomputable def wcEtLevelTheta {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt)
    (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (F : ∀ k : ℕ, Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op k)).left) AddCommGrpCat.{u+1})
    (φ : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F k) ⟶ F l)
    (k l : ℕ) (h : k ≤ l) (he : (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left) :
    (wcEtInv (a k).left).obj (F k) ⟶ (wcEtInv (a l).left).obj (F l) :=
  wcEtInvCompInv (a l).left (D.map (homOfLE h).op).left (a k).left he (F k) ≫
    (wcEtInv (a l).left).map (φ k l h)

noncomputable def wcEtLevelDiag {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt)
    (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (F : ∀ k : ℕ, Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op k)).left) AddCommGrpCat.{u+1})
    (φ : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F k) ⟶ F l) :
    AsSmall.{u+1} ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Uinf.left) AddCommGrpCat.{u+1} :=
  AsSmall.down ⋙ Functor.ofSequence (fun k =>
    wcEtLevelTheta D a F φ k (k + 1) (Nat.le_add_right k 1) (congrArg (fun t => t.left) (ha k 1)))
def wcLiftsTo {A : ℕ → Type*} [∀ k, AddCommGroup (A k)] (τ : ∀ k, A (k + 1) →+ A k)
    (k : ℕ) (a : A k) (n : ℕ) : Prop :=
  ∃ c : ∀ i, A i, c k = a ∧ ∀ i, k ≤ i → i < n → τ i (c (i + 1)) = c i

def wcTowerML {A : ℕ → Type*} [∀ k, AddCommGroup (A k)] (τ : ∀ k, A (k + 1) →+ A k) : Prop :=
  ∀ k, 1 ≤ k → ∃ N, k ≤ N ∧ ∀ a : A k, wcLiftsTo τ k a N → ∀ n, wcLiftsTo τ k a n
noncomputable abbrev wcIntExt (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcIntRingSheaf S ℓ)) (SheafOfModules.unit (wcIntRingSheaf S ℓ)) n

noncomputable def wcIntFun (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) :
    SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcIntRingSheaf S ℓ) :=
  (SheafOfModules.unitHomEquiv _).symm
    (PresheafOfModules.sectionsMk (M := (SheafOfModules.unit (wcIntRingSheaf S ℓ)).val)
      (fun V => (r.comp (Opposite.unop V).hom.base.hom :
        C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ])))
      (fun V V' g => ContinuousMap.ext (fun x =>
        congrArg (fun k => r (k.base x)) (MorphismProperty.Over.w g.unop))))

noncomputable def wcIntAct (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) : wcIntExt S ℓ q →+ wcIntExt S ℓ q :=
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  (Abelian.Ext.mk₀ (wcIntFun S ℓ r)).precomp _ (zero_add q)

noncomputable def wcIntZModPresheafMap (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    wcIntRingPresheaf.{u} ℓ ⟶ wcZModRingPresheaf.{u} (ℓ ^ k) where
  app U := RingCat.ofHom (RingHom.compLeftContinuous (↥(Opposite.unop U))
    ((ULift.ringEquiv.{0, u+1} (R := ZMod (ℓ ^ k))).symm.toRingHom.comp
      ((PadicInt.toZModPow (p := ℓ) k).comp (ULift.ringEquiv.{0, u+1} (R := ℤ_[ℓ])).toRingHom))
    (by
      have hc : Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) k x) := by
        rw [continuous_discrete_rng]
        intro b
        rw [Metric.isOpen_iff]
        intro x hx
        have hℓ : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
        refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ _, fun y hy => ?_⟩
        have h1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
          rw [Metric.mem_ball, dist_eq_norm] at hy
          exact hy.le
        have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) k).mp h1
        rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h2
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
        rw [h2]
        exact hx
      exact continuous_uliftUp.comp (hc.comp continuous_uliftDown)))
  naturality _ _ _ := rfl

noncomputable def wcIntZModRingSheafMap (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    wcIntRingSheaf S ℓ ⟶ wcZModRingSheaf S (ℓ ^ k) :=
  ((Scheme.ProEt.forget S ⋙ Over.forget S).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) Scheme.proetaleTopology).map
    (ObjectProperty.homMk (wcIntZModPresheafMap.{u} ℓ k))

noncomputable abbrev wcIntResUnit (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    SheafOfModules.{u+1} (wcIntRingSheaf S ℓ) :=
  (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).obj
    (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ k)))

abbrev wcIntResExact (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) : Prop :=
  (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).Additive ∧
    Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)) ∧
    Limits.PreservesFiniteColimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k))

noncomputable abbrev wcIntResExt (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k j : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcIntRingSheaf S ℓ)) (wcIntResUnit S ℓ k) j

noncomputable def wcIntRedTr (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k j : ℕ) :
    wcZModProEtExt S (ℓ ^ k) j →+ wcIntResExt S ℓ k j := by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
  exact if h : wcIntResExact S ℓ k then
    haveI := h.1
    haveI := h.2.1
    haveI := h.2.2
    AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)) x)
        (zero_add j))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  else 0

noncomputable def wcIntRed (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k q : ℕ) :
    wcIntExt S ℓ q →+ wcZModProEtExt S (ℓ ^ k) q := by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  exact if h : Function.Bijective (wcIntRedTr S ℓ k q) then
    (AddEquiv.ofBijective (wcIntRedTr S ℓ k q) h).symm.toAddMonoidHom.comp
      ((Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).postcomp
        (SheafOfModules.unit (wcIntRingSheaf S ℓ)) (add_zero q))
  else 0

noncomputable def wcIntRedTau (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k j : ℕ) :
    wcZModProEtExt S (ℓ ^ (k + 1)) j →+ wcZModProEtExt S (ℓ ^ k) j := by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  exact if h : Function.Bijective (wcIntRedTr S ℓ k j) ∧
      ∃ t : wcIntResUnit S ℓ (k + 1) ⟶ wcIntResUnit S ℓ k,
        wcUnitRestrict (wcIntZModRingSheafMap S ℓ (k + 1)) ≫ t =
          wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) then
    (AddEquiv.ofBijective (wcIntRedTr S ℓ k j) h.1).symm.toAddMonoidHom.comp
      (((Abelian.Ext.mk₀ (Classical.choose h.2)).postcomp
        (SheafOfModules.unit (wcIntRingSheaf S ℓ)) (add_zero j)).comp
        (wcIntRedTr S ℓ (k + 1) j))
  else 0

structure wcIntRatData (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] where
  L : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ)
  adj : L ⊣ SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)
  additive : L.Additive
  presLim : Limits.PreservesFiniteLimits L
  presColim : Limits.PreservesFiniteColimits L
  μ : L.obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≅ SheafOfModules.unit (wcRingSheaf S ℓ)

noncomputable def wcIntRho {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (E : wcIntRatData S ℓ)
    (n : ℕ) : wcIntExt S ℓ n →+ wcHM S ℓ n :=
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim
  ((Abelian.Ext.mk₀ E.μ.inv).precomp _ (zero_add n)).comp
    (((Abelian.Ext.mk₀ E.μ.hom).postcomp _ (add_zero n)).comp
      (E.L.mapExtAddHom _ _ n))

structure wcIntPullData {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] where
  cont : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')
  φ : wcIntRingSheaf S ℓ ⟶
    (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC f) RingCat.{u+1} _
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') cont).obj (wcIntRingSheaf S' ℓ)
  Φ : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)
  adj : Φ ⊣ @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ cont φ
  additive : Φ.Additive
  presLim : Limits.PreservesFiniteLimits Φ
  presColim : Limits.PreservesFiniteColimits Φ
  μ : Φ.obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≅ SheafOfModules.unit (wcIntRingSheaf S' ℓ)

noncomputable def wcIntPull {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcIntPullData f ℓ) (n : ℕ) : wcIntExt S ℓ n →+ wcIntExt S' ℓ n :=
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  ((Abelian.Ext.mk₀ D.μ.inv).precomp _ (zero_add n)).comp
    (((Abelian.Ext.mk₀ D.μ.hom).postcomp _ (add_zero n)).comp
      (D.Φ.mapExtAddHom _ _ n))

def wcIntPullCanonical {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcIntPullData f ℓ) : Prop :=
  ∀ (V : S.ProEt) (s : C(↥V.left, ULift.{u+1} ℤ_[ℓ])),
    ((D.φ.hom.app (Opposite.op V)).hom s : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℤ_[ℓ])) =
      s.comp (Limits.pullback.fst V.hom f).base.hom
