        HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp])
structure wcpaDjCoc (Y : Scheme.{u}) where
  m : ℕ
  V : Fin m → Y.Opens
  g : ∀ a b : Fin m, (Γ(Y, V a ⊓ V b))ˣ


def wcpaDjCocOK {Y : Scheme.{u}} (L : wcpaDjCoc Y) : Prop :=
  (∀ a, IsAffineOpen (L.V a)) ∧ (⨆ a, L.V a) = ⊤ ∧ (∀ a, L.g a a = 1) ∧
  ∀ a b c,
    (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V c ≤ L.V a ⊓ L.V b from
        inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b)) *
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V c ≤ L.V b ⊓ L.V c from
        le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom
        (L.g b c : Γ(Y, L.V b ⊓ L.V c)) =
    (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V c ≤ L.V a ⊓ L.V c from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom
        (L.g a c : Γ(Y, L.V a ⊓ L.V c))


noncomputable def wcpaDjCocPull {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y) :
    wcpaDjCoc Y' where
  m := L.m
  V a := h ⁻¹ᵁ L.V a
  g a b := Units.map (((Y'.presheaf.map (homOfLE
      (show h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b) from fun _ hx => hx)).op).hom.comp
      (h.app (L.V a ⊓ L.V b)).hom).toMonoidHom) (L.g a b)


def wcpaDjVA {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (W : T.Opens) (e : ℕ) : Prop :=
  ∃ (M : ℕ) (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
    (∀ J a b,
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t J b) =
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t J a)) ∧
    (∀ a, Ideal.span (Set.range (fun J => t J a)) = ⊤) ∧
    (∀ J, IsAffineOpen (⨆ a, Y.basicOpen (t J a))) ∧
    ∀ J (f : Γ(Y, ⨆ a, Y.basicOpen (t J a))), ∃ P : MvPolynomial (Fin (M + 1)) Γ(T, W),
      ∀ a, ∃ inv : Γ(Y, Y.basicOpen (t J a)),
        inv * (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a) = 1 ∧
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom f =
          MvPolynomial.eval₂
            ((Y.presheaf.map (homOfLE ((Y.basicOpen_le (t J a)).trans inf_le_right)).op).hom.comp
              (q.app W).hom)
            (fun l => (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t l a) * inv) P
def wcpaDjSing (Y : Scheme.{u}) : Set Y := {y | ¬ IsRegularLocalRing (Y.presheaf.stalk y)}

def wcpaDjSingGen (Y : Scheme.{u}) : Set Y :=
  {γ | γ ∈ wcpaDjSing Y ∧ ∀ γ' ∈ wcpaDjSing Y, γ' ⤳ γ → γ' = γ}

def wcpaDjTorNodeSglWt (Z : Scheme.{u}) (B : Set Z) (z : Z) (w : ℕ) : Prop :=
  ∃ (n q : ℕ) (A : Type u) (_ : CommRing A) (_ : IsRegularLocalRing A)
    (_ : IsAdicComplete (IsLocalRing.maximalIdeal A) A)
    (x y v : A) (σ : Fin n → A) (b : Fin n → ℕ)
    (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+*
      (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
    (h : Fin q → Z.presheaf.stalk z) (J : Fin q → Finset (Fin n)),
    IsUnit v ∧ ((n + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A ∧
    Ideal.span ({x, y} ∪ Set.range σ) = IsLocalRing.maximalIdeal A ∧
    (∀ i i', i ≠ i' → Disjoint (J i) (J i')) ∧ (∀ i, (J i).card ≤ 1) ∧
    (∀ l, b l ≠ 0 → ∃ i, l ∈ J i) ∧
    (∀ i, Associated (e (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) (h i)))
      (Ideal.Quotient.mk _ (∏ l ∈ J i, σ l))) ∧
    (∀ (z' : Z) (hz : z' ⤳ z), (z' ∈ B ↔ ∃ i, (Z.presheaf.stalkSpecializes hz).hom (h i) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk z'))) ∧
    ∑ l, b l = w

noncomputable def wcpaDjResMeasure (Y : Scheme.{u}) (B : Set Y) : Lex (ℕ × ℕ) :=
  toLex ((∑ᶠ γ ∈ {γ | γ ∈ wcpaDjSingGen Y ∧
      ringKrullDim (Y.presheaf.stalk γ) = ((2 : ℕ) : WithBot ℕ∞)},
      sInf {w | wcpaDjTorNodeSglWt Y B γ w}), (wcpaDjSingGen Y).ncard)
