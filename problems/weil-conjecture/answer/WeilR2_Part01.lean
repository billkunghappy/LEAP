  (Scheme.Etale.forget X ⋙ Over.forget X).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
    CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable def wcEtGm (X : Scheme.{u}) : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} :=
  (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtGmPre X)

noncomputable def wcZarGm (X : Scheme.{u}) :
    Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} :=
  (presheafToSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
    (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp)
abbrev wcFT {A : Type*} {B : Type*} (α : A → B) (q : ℕ) : Type _ :=
  {t : Fin (q + 1) → A // ∀ l, α (t l) = α (t 0)}

def wcFTFace {A : Type*} {B : Type*} (α : A → B) {q : ℕ} (t : wcFT α (q + 1)) (j : Fin (q + 2)) :
    wcFT α q :=
  ⟨t.1 ∘ j.succAbove, fun l => (t.2 (j.succAbove l)).trans (t.2 (j.succAbove 0)).symm⟩

noncomputable def wcFTd {A : Type*} {B : Type*} (α : A → B) (q : ℕ) :
    FreeAbelianGroup (wcFT α (q + 1)) →+ FreeAbelianGroup (wcFT α q) :=
  FreeAbelianGroup.lift (fun t => ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
    FreeAbelianGroup.of (wcFTFace α t j))

noncomputable def wcFTCons {A : Type*} {B : Type*} (α : A → B) {q : ℕ} (t : wcFT α q) :
    wcFT α (q + 1) :=
  ⟨(Fin.cons (Classical.choose (⟨t.1 0, rfl⟩ : ∃ a, α a = α (t.1 0))) t.1 : Fin (q + 2) → A),
    fun l => by
      induction l using Fin.cases with
      | zero => rfl
      | succ m =>
        simp only [Fin.cons_succ, Fin.cons_zero]
        exact (t.2 m).trans (Classical.choose_spec (⟨t.1 0, rfl⟩ : ∃ a, α a = α (t.1 0))).symm⟩

def wcFTα {C : Type (u+1)} [Category.{u} C] {U : C} {k : ℕ} (V : Fin k → C)
    (f : ∀ i, V i ⟶ U) (Z : Cᵒᵖ) :
    ULift.{u+1} (Σ i : Fin k, (Z.unop ⟶ V i)) → ULift.{u+1} (Z.unop ⟶ U) :=
  fun a => ULift.up (a.down.2 ≫ f a.down.1)

def wcFTRestr {C : Type (u+1)} [Category.{u} C] {U : C} {k : ℕ} (V : Fin k → C)
    (f : ∀ i, V i ⟶ U) {Z Z' : Cᵒᵖ} (g : Z ⟶ Z') {q : ℕ} (t : wcFT (wcFTα V f Z) q) :
    wcFT (wcFTα V f Z') q :=
  ⟨fun l => ULift.up ⟨(t.1 l).down.1, g.unop ≫ (t.1 l).down.2⟩, fun l => by
    have h := congrArg ULift.down (t.2 l)
    simp only [wcFTα] at h ⊢
    rw [Category.assoc, Category.assoc, h]⟩

noncomputable def wcFTK {C : Type (u+1)} [Category.{u} C] {U : C} {k : ℕ} (V : Fin k → C)
    (f : ∀ i, V i ⟶ U) (q : ℕ) : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj Z := AddCommGrpCat.of (FreeAbelianGroup (wcFT (wcFTα V f Z) q))
  map g := AddCommGrpCat.ofHom (FreeAbelianGroup.map (wcFTRestr V f g))
  map_id Z := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro t
    simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.hom_id, AddMonoidHom.id_apply,
      FreeAbelianGroup.map_of_apply]
    congr 1
    apply Subtype.ext
    funext l
    simp [wcFTRestr]
  map_comp g h := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro t
    simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
      FreeAbelianGroup.map_of_apply]
    congr 1
    apply Subtype.ext
    funext l
    simp [wcFTRestr]

noncomputable def wcFTKU {C : Type (u+1)} [Category.{u} C] (U : C) : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj Z := AddCommGrpCat.of (FreeAbelianGroup (ULift.{u+1} (Z.unop ⟶ U)))
  map g := AddCommGrpCat.ofHom (FreeAbelianGroup.map (fun a => ULift.up (g.unop ≫ a.down)))
  map_id Z := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro t
    simp
  map_comp g h := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro t
    simp

noncomputable def wcFTD {C : Type (u+1)} [Category.{u} C] {U : C} {k : ℕ} (V : Fin k → C)
    (f : ∀ i, V i ⟶ U) (q : ℕ) : wcFTK V f (q + 1) ⟶ wcFTK V f q where
  app Z := AddCommGrpCat.ofHom (wcFTd (wcFTα V f Z) q)
  naturality Z Z' g := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro t
    change wcFTd (wcFTα V f Z') q (FreeAbelianGroup.map (wcFTRestr V f g) (FreeAbelianGroup.of t)) =
      FreeAbelianGroup.map (wcFTRestr V f g) (wcFTd (wcFTα V f Z) q (FreeAbelianGroup.of t))
    simp only [wcFTd, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of, map_sum,
      map_zsmul]
    rfl

noncomputable def wcFTE {C : Type (u+1)} [Category.{u} C] {U : C} {k : ℕ} (V : Fin k → C)
    (f : ∀ i, V i ⟶ U) : wcFTK V f 0 ⟶ wcFTKU U where
  app Z := AddCommGrpCat.ofHom (FreeAbelianGroup.map (fun t => wcFTα V f Z (t.1 0)))
  naturality Z Z' g := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro t
    change FreeAbelianGroup.map (fun t => wcFTα V f Z' (t.1 0))
        (FreeAbelianGroup.map (wcFTRestr V f g) (FreeAbelianGroup.of t)) =
      FreeAbelianGroup.map (fun a => ULift.up (g.unop ≫ a.down))
        (FreeAbelianGroup.map (fun t => wcFTα V f Z (t.1 0)) (FreeAbelianGroup.of t))
    simp only [FreeAbelianGroup.map_of_apply]
    congr 1
    simp [wcFTα, wcFTRestr]

noncomputable def wcFTLift {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C]
    {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) {q : ℕ} {Z : Cᵒᵖ}
    (t : wcFT (wcFTα V f Z) q) :
    Z.unop ⟶ Limits.widePullback U (fun l => V (t.1 l).down.1) (fun l => f (t.1 l).down.1) :=
  Limits.WidePullback.lift ((t.1 0).down.2 ≫ f (t.1 0).down.1) (fun l => (t.1 l).down.2)
    (fun l => congrArg ULift.down (t.2 l))

noncomputable def wcFTTaut {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C]
    {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) {q : ℕ} (σ : Fin (q + 1) → Fin k) :
    wcFT (wcFTα V f
      (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) q :=
  ⟨fun l => ULift.up ⟨σ l, Limits.WidePullback.π (fun l => f (σ l)) l⟩, fun l => congrArg ULift.up
    ((Limits.WidePullback.π_arrow (fun l => f (σ l)) l).trans
      (Limits.WidePullback.π_arrow (fun l => f (σ l)) 0).symm)⟩
structure wcEtPres (Y : Scheme.{u}) {U : Y.ProEt} {k : ℕ} (V : Fin k → Y.ProEt)
    (f : ∀ i, V i ⟶ U) where
  Λ : Type u
  [cat : SmallCategory Λ]
  [cofil : IsCofiltered Λ]
  U' : Λ ⥤ Y.Etale
  V' : Fin k → Λ ⥤ Y.Etale
  f' : ∀ i, V' i ⟶ U'
  φ : ∀ l, U ⟶ (wcEtToProEt Y).obj (U'.obj l)
  ψ : ∀ i l, V i ⟶ (wcEtToProEt Y).obj ((V' i).obj l)
  hφ : ∀ {l l' : Λ} (g : l ⟶ l'), φ l ≫ (wcEtToProEt Y).map (U'.map g) = φ l'
  hψ : ∀ (i : Fin k) {l l' : Λ} (g : l ⟶ l'),
    ψ i l ≫ (wcEtToProEt Y).map ((V' i).map g) = ψ i l'
  hf : ∀ i l, ψ i l ≫ (wcEtToProEt Y).map ((f' i).app l) = f i ≫ φ l
  affU : ∀ l, IsAffine (U'.obj l).left
  affV : ∀ i l, IsAffine ((V' i).obj l).left
  limU : ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (U'.obj l).left),
    (∀ {l l' : Λ} (g : l ⟶ l'), z l ≫ (U'.map g).left = z l') →
    ∃! h : Z ⟶ U.left, ∀ l, h ≫ (φ l).left = z l
  limV : ∀ (i : Fin k) (Z : Scheme.{u}) (z : ∀ l, Z ⟶ ((V' i).obj l).left),
    (∀ {l l' : Λ} (g : l ⟶ l'), z l ≫ ((V' i).map g).left = z l') →
    ∃! h : Z ⟶ (V i).left, ∀ l, h ≫ (ψ i l).left = z l

instance wcEtPres.instCat {Y : Scheme.{u}} {U : Y.ProEt} {k : ℕ} {V : Fin k → Y.ProEt}
    {f : ∀ i, V i ⟶ U} (M : wcEtPres Y V f) : SmallCategory M.Λ := M.cat

instance wcEtPres.instCofil {Y : Scheme.{u}} {U : Y.ProEt} {k : ℕ} {V : Fin k → Y.ProEt}
    {f : ∀ i, V i ⟶ U} (M : wcEtPres Y V f) : IsCofiltered M.Λ := M.cofil

structure wcEtModel (Y : Scheme.{u}) {U : Y.ProEt} {k : ℕ} (V : Fin k → Y.ProEt)
    (f : ∀ i, V i ⟶ U) where
  Λ : Type u
  [cat : SmallCategory Λ]
  [cofil : IsCofiltered Λ]
  U' : Λ ⥤ Y.Etale
  V' : Fin k → Λ ⥤ Y.Etale
  f' : ∀ i, V' i ⟶ U'
  φ : ∀ l, U ⟶ (wcEtToProEt Y).obj (U'.obj l)
  ψ : ∀ i l, V i ⟶ (wcEtToProEt Y).obj ((V' i).obj l)
  hφ : ∀ {l l' : Λ} (g : l ⟶ l'), φ l ≫ (wcEtToProEt Y).map (U'.map g) = φ l'
  hψ : ∀ (i : Fin k) {l l' : Λ} (g : l ⟶ l'),
    ψ i l ≫ (wcEtToProEt Y).map ((V' i).map g) = ψ i l'
  hf : ∀ i l, ψ i l ≫ (wcEtToProEt Y).map ((f' i).app l) = f i ≫ φ l
  repV : ∀ (i : Fin k) (E : Y.Etale) (a : V i ⟶ (wcEtToProEt Y).obj E),
    ∃ (l : Λ) (e : (V' i).obj l ⟶ E), ψ i l ≫ (wcEtToProEt Y).map e = a
  rep : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (E : Y.Etale)
      (a : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶ (wcEtToProEt Y).obj E),
    ∃ (l : Λ) (e : Limits.widePullback (U'.obj l) (fun j => (V' (σ j)).obj l)
        (fun j => (f' (σ j)).app l) ⟶ E),
      ∀ m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (U'.obj l) (fun j => (V' (σ j)).obj l)
            (fun j => (f' (σ j)).app l)),
        (∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (f' (σ j)).app l) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ ψ (σ j) l) →
        m ≫ (wcEtToProEt Y).map e = a
  eq : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (l : Λ) (E : Y.Etale)
      (e₁ e₂ : Limits.widePullback (U'.obj l) (fun j => (V' (σ j)).obj l)
        (fun j => (f' (σ j)).app l) ⟶ E),
    (∀ m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (U'.obj l) (fun j => (V' (σ j)).obj l)
            (fun j => (f' (σ j)).app l)),
        (∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (f' (σ j)).app l) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ ψ (σ j) l) →
        m ≫ (wcEtToProEt Y).map e₁ = m ≫ (wcEtToProEt Y).map e₂) →
    ∃ (l' : Λ) (g : l' ⟶ l),
      ∀ w : Limits.widePullback (U'.obj l') (fun j => (V' (σ j)).obj l')
          (fun j => (f' (σ j)).app l') ⟶
          Limits.widePullback (U'.obj l) (fun j => (V' (σ j)).obj l) (fun j => (f' (σ j)).app l),
        (∀ j, w ≫ Limits.WidePullback.π (fun j => (f' (σ j)).app l) j =
          Limits.WidePullback.π (fun j => (f' (σ j)).app l') j ≫ (V' (σ j)).map g) →
        w ≫ e₁ = w ≫ e₂

instance wcEtModel.instCat {Y : Scheme.{u}} {U : Y.ProEt} {k : ℕ} {V : Fin k → Y.ProEt}
    {f : ∀ i, V i ⟶ U} (M : wcEtModel Y V f) : SmallCategory M.Λ := M.cat

instance wcEtModel.instCofil {Y : Scheme.{u}} {U : Y.ProEt} {k : ℕ} {V : Fin k → Y.ProEt}
    {f : ∀ i, V i ⟶ U} (M : wcEtModel Y V f) : IsCofiltered M.Λ := M.cofil

def wcLanLevel (Y : Scheme.{u}) (F : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {U : Y.ProEt} {k : ℕ}
    {V : Fin k → Y.ProEt} {f : ∀ i, V i ⟶ U} (M : wcEtModel Y V f) : Prop :=
  (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (l : M.Λ),
    ∃! m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
        (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l)
          (fun j => (M.f' (σ j)).app l)),
      ∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j) =
        Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l) ∧
  (∀ (i : Fin k) (x : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op (V i))),
    ∃ (l : M.Λ) (t : F.obj (Opposite.op ((M.V' i).obj l))),
      x = ((wcEtToProEt Y).op.lan.obj F).map (M.ψ i l).op
        (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op ((M.V' i).obj l)) t)) ∧
  (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k)
      (x : ((wcEtToProEt Y).op.lan.obj F).obj
        (Opposite.op (Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j))))),
    ∃ (l : M.Λ) (t : F.obj (Opposite.op (Limits.widePullback (M.U'.obj l)
        (fun j => (M.V' (σ j)).obj l) (fun j => (M.f' (σ j)).app l)))),
      ∀ m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l)
            (fun j => (M.f' (σ j)).app l)),
        (∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l) →
        x = ((wcEtToProEt Y).op.lan.obj F).map m.op
          (((wcEtToProEt Y).op.lanUnit.app F).app _ t)) ∧
  (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (l : M.Λ)
      (t : F.obj (Opposite.op (Limits.widePullback (M.U'.obj l)
        (fun j => (M.V' (σ j)).obj l) (fun j => (M.f' (σ j)).app l))))
      (m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l)
            (fun j => (M.f' (σ j)).app l))),
      (∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l) →
      ((wcEtToProEt Y).op.lan.obj F).map m.op (((wcEtToProEt Y).op.lanUnit.app F).app _ t) = 0 →
      ∃ (l' : M.Λ) (g : l' ⟶ l),
        ∀ w : Limits.widePullback (M.U'.obj l') (fun j => (M.V' (σ j)).obj l')
            (fun j => (M.f' (σ j)).app l') ⟶
            Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l)
              (fun j => (M.f' (σ j)).app l),
          (∀ j, w ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j =
            Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map g) →
          F.map w.op t = 0)
def wcSuppIn (Y : Scheme.{u}) (W : Set Y)
    (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) : Prop :=
  ∀ (V : Y.Etale) (s : F.obj.obj (Opposite.op V)),
    Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
      F.obj.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V

def wcPBCV {X Y : Scheme.{u}} (π : X ⟶ Y) : Prop :=
  ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (a : Spec (.of A) ⟶ Y) (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A)) (a' : X' ⟶ X),
    IsPullback a' f' π a → ∀ m : ℕ, m ≠ 0 →
    ∀ F : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1},
    wcSuppIn X' {x | f' x ≠ IsLocalRing.closedPoint A} F → m • 𝟙 F = 0 →
    ∀ q : ℕ, Subsingleton (wcEtExt X' F q)

noncomputable def wcP1 (R : Type u) [CommRing R] :
    @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) R) MvPolynomial.gradedAlgebra ⟶
      Spec (.of ((MvPolynomial.homogeneousSubmodule (Fin 2) R) 0)) :=
  @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) R) MvPolynomial.gradedAlgebra
noncomputable def wcEtGmAtPre (X : Scheme.{u}) (x : X) : (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  (Scheme.Etale.forget X ⋙ Over.pullback (X.fromSpecStalk x) ⋙ Over.forget _).op ⋙ Scheme.Γ ⋙
    forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
    AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable def wcEtGmAt (X : Scheme.{u}) (x : X) :
    Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} :=
  (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtGmAtPre X x)

noncomputable def wcEtGmToAtPre (X : Scheme.{u}) (x : X) : wcEtGmPre X ⟶ wcEtGmAtPre X x :=
  Functor.whiskerRight (NatTrans.op (Functor.whiskerLeft (Scheme.Etale.forget X)
      (Functor.whiskerRight (Over.mapPullbackAdj (X.fromSpecStalk x)).counit (Over.forget X))))
    (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u})

noncomputable def wcEtGmToAt (X : Scheme.{u}) (x : X) : wcEtGm X ⟶ wcEtGmAt X x :=
  (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (wcEtGmToAtPre X x)

def wcIsC1 (K : Type*) [Field K] : Prop :=
  ∀ (n : ℕ) (f : MvPolynomial (Fin n) K), f.IsHomogeneous f.totalDegree → 0 < f.totalDegree →
    f.totalDegree < n → ∃ v : Fin n → K, v ≠ 0 ∧ MvPolynomial.eval v f = 0
noncomputable def wcEtBaseChange {Y Z : Scheme.{u}} (f : Z ⟶ Y) : Y.Etale ⥤ Z.Etale :=
  letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
  MorphismProperty.Over.pullback (@Etale : MorphismProperty Scheme.{u}) ⊤ f
def wcFamLift (R S : CommRingCat.{u}) (k : ℕ) (T : Fin k → CommRingCat.{u}) (r : R ⟶ S)
    (q : ∀ i, S ⟶ T i) : Prop :=
  ∀ (P : CommRingCat.{u}) (ιP : R ⟶ P) (h : P ⟶ S) (Q : Fin k → CommRingCat.{u})
    (γ : ∀ i, P ⟶ Q i) (hQ : ∀ i, Q i ⟶ T i),
    ιP.hom.FinitePresentation → (∀ i, (ιP ≫ γ i).hom.FinitePresentation) → ιP ≫ h = r →
    (∀ i, γ i ≫ hQ i = h ≫ q i) →
    ∃ (nE : ℕ) (IE : Ideal (MvPolynomial (Fin nE) R)) (nF : Fin k → ℕ)
      (IF : ∀ i, Ideal (MvPolynomial (Fin (nF i)) R))
      (α : CommRingCat.of (MvPolynomial (Fin nE) R ⧸ IE) ⟶ S)
      (β : ∀ i, CommRingCat.of (MvPolynomial (Fin (nF i)) R ⧸ IF i) ⟶ T i)
      (g : ∀ i, CommRingCat.of (MvPolynomial (Fin nE) R ⧸ IE) ⟶
        CommRingCat.of (MvPolynomial (Fin (nF i)) R ⧸ IF i))
      (a : P ⟶ CommRingCat.of (MvPolynomial (Fin nE) R ⧸ IE))
      (b : ∀ i, Q i ⟶ CommRingCat.of (MvPolynomial (Fin (nF i)) R ⧸ IF i)),
      (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)).Etale ∧
      (∀ i, (algebraMap R (MvPolynomial (Fin (nF i)) R ⧸ IF i)).Etale) ∧
      (∀ i, CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ g i =
        CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (nF i)) R ⧸ IF i))) ∧
      ιP ≫ a = CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ∧
      (∀ i, ιP ≫ γ i ≫ b i = CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (nF i)) R ⧸ IF i))) ∧
      a ≫ α = h ∧ (∀ i, g i ≫ β i = α ≫ q i) ∧ (∀ i, b i ≫ β i = hQ i) ∧
      (∀ i, a ≫ g i = γ i ≫ b i)
def wcRET (T : Type u) [CommRing T] : Prop :=
  ∀ (f g : Polynomial T), f.Monic →
    (∃ (p₁ p₂ : Polynomial T) (n : ℕ), Polynomial.derivative f * p₁ + f * p₂ = g ^ n) →
    ∀ (m : ℕ) (a : Fin m → T) (F₀ Z W : Polynomial T), F₀.Monic → 0 < F₀.natDegree →
      f.comp Z ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) →
      g.comp Z * W - 1 ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) →
      ∃ (ε : Fin (m + 1) → T) (x : T), (∀ i, ε i * ε i = ε i) ∧ (∀ i j, i ≠ j → ε i * ε j = 0) ∧
        ∑ i, ε i = 1 ∧ f.eval x * ε 0 = 0 ∧ (∃ v : T, g.eval x * v = ε 0) ∧
        ∀ j : Fin m, ∃ w : T, a j * w = ε j.succ
noncomputable def wcZarToEt (X : Scheme.{u}) : X.Opens ⥤ X.Etale :=
  MorphismProperty.Comma.lift (Scheme.restrictFunctor X)
    (fun U => (inferInstance : Etale U.ι)) (fun _ => trivial) (fun _ => trivial)
noncomputable def wcEtPts (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (U : X.Etale) : Type u :=
  {s : Spec (.of Ω) ⟶ U.left // s ≫ U.hom ≫ fX = 𝟙 _}

noncomputable def wcEtPtsMap (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    {U V : X.Etale} (g : V ⟶ U) (t : wcEtPts Ω X fX V) : wcEtPts Ω X fX U :=
  ⟨t.1 ≫ g.left, by rw [Category.assoc, ← Category.assoc g.left, MorphismProperty.Over.w g]; exact t.2⟩

noncomputable def wcEtDivSub (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (U : X.Etale) : AddSubgroup (wcEtPts Ω X fX U → ℤ) where
  carrier := {a | ∀ x : U.left, ∃ W : Set U.left, IsOpen W ∧ x ∈ W ∧ ∃ T : Set X, T.Finite ∧
    ∀ s : wcEtPts Ω X fX U, a s ≠ 0 → s.1 (IsLocalRing.closedPoint Ω) ∈ W →
      (s.1 ≫ U.hom) (IsLocalRing.closedPoint Ω) ∈ T}
  zero_mem' := fun x => ⟨Set.univ, isOpen_univ, Set.mem_univ x, ∅, Set.finite_empty,
    fun _ h _ => absurd rfl h⟩
  add_mem' := by
    intro a b ha hb x
    obtain ⟨W₁, hW₁, hx₁, T₁, hT₁, h₁⟩ := ha x
    obtain ⟨W₂, hW₂, hx₂, T₂, hT₂, h₂⟩ := hb x
    refine ⟨W₁ ∩ W₂, hW₁.inter hW₂, ⟨hx₁, hx₂⟩, T₁ ∪ T₂, hT₁.union hT₂, fun s hs hW => ?_⟩
    by_cases has : a s = 0
    · have hbs : b s ≠ 0 := by simpa [has] using hs
      exact Or.inr (h₂ s hbs hW.2)
    · exact Or.inl (h₁ s has hW.1)
  neg_mem' := by
    intro a ha x
    obtain ⟨W, hW, hx, T, hT, h⟩ := ha x
    exact ⟨W, hW, hx, T, hT, fun s hs hW' => h s (by simpa using hs) hW'⟩

noncomputable def wcEtDivRes (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    {U V : X.Etale} (g : V ⟶ U) : wcEtDivSub Ω X fX U →+ wcEtDivSub Ω X fX V where
  toFun a := ⟨fun t => a.1 (wcEtPtsMap Ω X fX g t), by
    intro v
    obtain ⟨W, hW, hv, T, hT, h⟩ := a.2 (g.left v)
    refine ⟨g.left ⁻¹' W, hW.preimage g.left.continuous, hv, T, hT, fun t ht htW => ?_⟩
    have h1 := h (wcEtPtsMap Ω X fX g t) ht htW
    have e : (t.1 ≫ g.left) ≫ U.hom = t.1 ≫ V.hom := by
      rw [Category.assoc, MorphismProperty.Over.w g]
    change ((t.1 ≫ g.left) ≫ U.hom) (IsLocalRing.closedPoint Ω) ∈ T at h1
    rw [e] at h1
    exact h1⟩
  map_zero' := rfl
  map_add' _ _ := rfl

noncomputable def wcEtDivPre (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) :
    (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  { obj := fun U => AddCommGrpCat.of (wcEtDivSub Ω X fX U.unop)
    map := fun g => AddCommGrpCat.ofHom (wcEtDivRes Ω X fX g.unop)
    map_id := fun U => by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro a
      apply Subtype.ext
      funext t
      change a.1 ⟨t.1 ≫ (𝟙 U.unop : U.unop ⟶ U.unop).left, _⟩ = a.1 t
      congr 1
    map_comp := fun f g => by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro a
      apply Subtype.ext
      funext t
      change a.1 ⟨t.1 ≫ (g.unop ≫ f.unop).left, _⟩ = a.1 ⟨(t.1 ≫ g.unop.left) ≫ f.unop.left, _⟩
      congr 1 } ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}
structure wcFamObj (R S : CommRingCat.{u}) (k : ℕ) (T : Fin k → CommRingCat.{u}) (r : R ⟶ S)
    (q : ∀ i, S ⟶ T i) : Type u where
  nE : ℕ
  IE : Ideal (MvPolynomial (Fin nE) R)
  nF : Fin k → ℕ
  IF : ∀ i, Ideal (MvPolynomial (Fin (nF i)) R)
  α : CommRingCat.of (MvPolynomial (Fin nE) R ⧸ IE) ⟶ S
  β : ∀ i, CommRingCat.of (MvPolynomial (Fin (nF i)) R ⧸ IF i) ⟶ T i
  g : ∀ i, CommRingCat.of (MvPolynomial (Fin nE) R ⧸ IE) ⟶
    CommRingCat.of (MvPolynomial (Fin (nF i)) R ⧸ IF i)
  etE : (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)).Etale
  etF : ∀ i, (algebraMap R (MvPolynomial (Fin (nF i)) R ⧸ IF i)).Etale
  hg : ∀ i, CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ g i =
    CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (nF i)) R ⧸ IF i))
  hα : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ α = r
  hβ : ∀ i, g i ≫ β i = α ≫ q i

structure wcFamHom {R S : CommRingCat.{u}} {k : ℕ} {T : Fin k → CommRingCat.{u}} {r : R ⟶ S}
    {q : ∀ i, S ⟶ T i} (X Y : wcFamObj R S k T r q) : Type u where
  e : CommRingCat.of (MvPolynomial (Fin X.nE) R ⧸ X.IE) ⟶
    CommRingCat.of (MvPolynomial (Fin Y.nE) R ⧸ Y.IE)
  eF : ∀ i, CommRingCat.of (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i) ⟶
    CommRingCat.of (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i)
  h1 : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)) ≫ e =
    CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin Y.nE) R ⧸ Y.IE))
  h2 : e ≫ Y.α = X.α
  h3 : ∀ i, eF i ≫ Y.β i = X.β i
  h4 : ∀ i, X.g i ≫ eF i = e ≫ Y.g i
def wcGrpCohVanish (G : Type*) (A : Type*) [Group G] [CommGroup A] [MulDistribMulAction G A] :
    Prop :=
  ∀ (p : ℕ) (φ : (Fin (p + 2) → G) → A),
    (∀ (g : G) (h : Fin (p + 2) → G), φ (fun l => g * h l) = g • φ h) →
    (∀ h : Fin (p + 3) → G,
      ∏ j : Fin (p + 3), φ (fun l => h (j.succAbove l)) ^ ((-1 : ℤ) ^ (j : ℕ)) = 1) →
    ∃ ψ : (Fin (p + 1) → G) → A,
      (∀ (g : G) (h : Fin (p + 1) → G), ψ (fun l => g * h l) = g • ψ h) ∧
      ∀ h : Fin (p + 2) → G,
        ∏ j : Fin (p + 2), ψ (fun l => h (j.succAbove l)) ^ ((-1 : ℤ) ^ (j : ℕ)) = φ h

def wcCyclicLayerCond (Q : Type*) (B : Type*) [Group Q] [CommGroup B] [MulDistribMulAction Q B] :
    Prop :=
  ∀ K K' : Subgroup Q, K' ≤ K → (K'.subgroupOf K).Normal → (K'.relIndex K).Prime →
    ∀ σ ∈ K, σ ∉ K' →
      (∀ a : B, (∀ h ∈ K, h • a = a) →
        ∃ b : B, (∀ n ∈ K', n • b = b) ∧ ∏ i ∈ Finset.range (K'.relIndex K), (σ ^ i) • b = a) ∧
      (∀ b : B, (∀ n ∈ K', n • b = b) → ∏ i ∈ Finset.range (K'.relIndex K), (σ ^ i) • b = 1 →
        ∃ c : B, (∀ n ∈ K', n • c = c) ∧ b = (σ • c) * c⁻¹)

def wcEtGalCov (L : Type u) [Field L] (U : (Spec (.of L)).Etale) (k : ℕ)
    (V : Fin k → (Spec (.of L)).Etale) (f : ∀ i, V i ⟶ U) : Prop :=
  IsAffine U.left ∧
  (∀ x : U.left, ∃ (i : Fin k) (v : (V i).left), (f i).left v = x) ∧
  (∀ (i j : Fin k) (v : (V i).left) (w : (V j).left), (f i).left v = (f j).left w → i = j) ∧
  ∀ i : Fin k, ∃ (κ M : Type u) (_ : Field κ) (_ : Field M) (_ : Algebra L κ) (_ : Algebra κ M)
    (a : Spec (.of κ) ⟶ U.left) (e : (V i).left ≅ Spec (.of M)),
    Algebra.IsAlgebraic L κ ∧ FiniteDimensional κ M ∧ IsGalois κ M ∧ Mono a ∧
    e.inv ≫ (f i).left = Spec.map (CommRingCat.ofHom (algebraMap κ M)) ≫ a
noncomputable abbrev wcEtPush {X B : Scheme.{u}} (g : X ⟶ B) :
    Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} :=
  sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
    (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g)) ⋙
    presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}

abbrev wcEtLocKill {X' Y : Scheme.{u}} (b : X' ⟶ Y)
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) ℕ)
    (q : ℕ) (P : Y → Prop) : Prop :=
  ∀ (V : Y.Etale) (c : (K.X (q + 1)).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))),
    ((K.d (q + 1) (q + 2)).hom.app (Opposite.op ((wcEtBaseChange b).obj V))).hom c = 0 →
    ∀ v : V.left, P (V.hom v) →
    ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left)
      (e : (K.X q).obj.obj (Opposite.op ((wcEtBaseChange b).obj W))),
      g.left w = v ∧
      ((K.d q (q + 1)).hom.app (Opposite.op ((wcEtBaseChange b).obj W))).hom e =
        ((K.X (q + 1)).obj.map ((wcEtBaseChange b).map g).op).hom c
structure wcCert (A : Type u) [CommRing A] : Type u where
  f : Polynomial A
  g : Polynomial A
  hf : f.Monic
  hcond : ∃ (p₁ p₂ : Polynomial A) (n : ℕ), Polynomial.derivative f * p₁ + f * p₂ = g ^ n
  m : ℕ
  a : Fin m → A
  F₀ : Polynomial A
  Z : Polynomial A
  W : Polynomial A
  hF₀ : F₀.Monic
  hdeg : 0 < F₀.natDegree
  h1 : f.comp Z ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j))))
  h2 : g.comp Z * W - 1 ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j))))
noncomputable abbrev wcEtAff (X : Scheme.{u}) {W₀ : X.Opens} (hW₀ : IsAffineOpen W₀) (C : Type u)
    [CommRing C] [Algebra Γ(X, W₀) C] [Algebra.Etale Γ(X, W₀) C] : X.Etale :=
  MorphismProperty.Over.mk ⊤ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) ≫ hW₀.fromSpec)
    (haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C))) :=
        HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr inferInstance)
     inferInstance)
noncomputable def wcLocVal (R : Type u) [CommRing R] (r : R) : ℕ := by
  classical
  exact if h : ∃ (n : ℕ) (v : Rˣ) (ϖ : R), Irreducible ϖ ∧ r = (v : R) * ϖ ^ n then Nat.find h else 0

noncomputable abbrev wcGenPt (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) : Scheme.{u} :=
  Limits.pullback U.hom (X.fromSpecStalk (genericPoint X))

noncomputable def wcGenSigma (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (W : U.left.Opens) :
    Γ(U.left, W) →+* Γ(wcGenPt X U, (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) :=
  ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W).hom

noncomputable def wcGenRestr (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (W : U.left.Opens) :
    Γ(wcGenPt X U, ⊤) →+* Γ(wcGenPt X U, (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) :=
  ((wcGenPt X U).presheaf.map (homOfLE le_top).op).hom

noncomputable def wcGenRho (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) :
    Γ(U.left, ⊤) →+* Γ(wcGenPt X U, ⊤) :=
  (Scheme.Γ.map ((Over.mapPullbackAdj (X.fromSpecStalk (genericPoint X))).counit.app
    ((Scheme.Etale.forget X).obj U)).left.op).hom

noncomputable def wcGenMap (X : Scheme.{u}) [IsIntegral X] {U V : X.Etale} (c : V ⟶ U) :
    Γ(wcGenPt X U, ⊤) →+* Γ(wcGenPt X V, ⊤) :=
  (Scheme.Γ.map ((Scheme.Etale.forget X ⋙ Over.pullback (X.fromSpecStalk (genericPoint X)) ⋙
    Over.forget _).map c).op).hom

def wcOrdRep (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (b : Γ(wcGenPt X U, ⊤)) (x : U.left)
    (n : ℤ) : Prop :=
  ∃ (W : U.left.Opens) (hx : x ∈ W) (g h : Γ(U.left, W)),
    IsUnit (wcGenSigma X U W g) ∧ wcGenSigma X U W g * wcGenRestr X U W b = wcGenSigma X U W h ∧
    U.left.presheaf.germ W x hx g ≠ 0 ∧ U.left.presheaf.germ W x hx h ≠ 0 ∧
    n = (wcLocVal _ (U.left.presheaf.germ W x hx h) : ℤ) - wcLocVal _ (U.left.presheaf.germ W x hx g)

noncomputable def wcEtOpen (X : Scheme.{u}) (U : X.Etale) (W : U.left.Opens) : X.Etale :=
  MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom) (by haveI : Etale U.hom := U.prop; infer_instance)

noncomputable def wcEtOpenι (X : Scheme.{u}) (U : X.Etale) (W : U.left.Opens) : wcEtOpen X U W ⟶ U :=
  MorphismProperty.Over.homMk W.ι rfl trivial

def wcOrdChar (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsIntegral X]
    (ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX) : Prop :=
  ∀ (U : X.Etale) (b : (Γ(wcGenPt X U, ⊤))ˣ) (s : wcEtPts Ω X fX U) (n : ℤ),
    wcOrdRep X U (b : Γ(wcGenPt X U, ⊤)) (s.1 (IsLocalRing.closedPoint Ω)) n →
    ((ord.app (Opposite.op U) (ULift.up (Additive.ofMul b))).down).1 s = n

noncomputable def wcPull (X : Scheme.{u}) (U : X.Etale) (O : X.Opens) (W : U.left.Opens)
    (hW : W ≤ U.hom ⁻¹ᵁ O) : Γ(X, O) →+* Γ(U.left, W) :=
  (U.hom.appLE O W hW).hom

def wcIsDVR (R : Type u) [CommRing R] : Prop := ∃ _ : IsDomain R, IsDiscreteValuationRing R
noncomputable abbrev wcEtSlice {S : Scheme.{u}} (T : S.Etale) : T.left.Etale ⥤ S.Etale :=
  @MorphismProperty.Over.map Scheme.{u} _ @Etale ⊤ _ T.left S
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition T.hom T.prop

noncomputable abbrev wcEtTop (S : Scheme.{u}) : S.Etale :=
  @MorphismProperty.Over.mk _ _ @Etale ⊤ S S (𝟙 S)
    (@MorphismProperty.id_mem _ _ @Etale MorphismProperty.IsMultiplicative.toContainsIdentities S)
def wcGalEqv (κ M : Type*) [Field κ] [Field M] [Algebra κ M] (n : ℕ) :
    Subring ((Fin n → Gal(M/κ)) → M) where
  carrier := {F | ∀ (σ : Gal(M/κ)) (h : Fin n → Gal(M/κ)), F (fun l => σ * h l) = σ (F h)}
  mul_mem' := fun {a b} ha hb σ h =>
    (congrArg₂ (· * ·) (ha σ h) (hb σ h)).trans (map_mul σ (a h) (b h)).symm
  one_mem' := fun σ _ => (map_one σ).symm
  add_mem' := fun {a b} ha hb σ h =>
    (congrArg₂ (· + ·) (ha σ h) (hb σ h)).trans (map_add σ (a h) (b h)).symm
  zero_mem' := fun σ _ => (map_zero σ).symm
  neg_mem' := fun {a} ha σ h => (congrArg Neg.neg (ha σ h)).trans (map_neg σ (a h)).symm

def wcGalEqvIncl (κ M : Type*) [Field κ] [Field M] [Algebra κ M] (n : ℕ) (l : Fin n) :
    M →+* wcGalEqv κ M n where
  toFun x := ⟨fun h => h l x, fun _ _ => rfl⟩
  map_one' := Subtype.ext (funext fun h => map_one (h l))
  map_mul' x y := Subtype.ext (funext fun h => map_mul (h l) x y)
  map_zero' := Subtype.ext (funext fun h => map_zero (h l))
  map_add' x y := Subtype.ext (funext fun h => map_add (h l) x y)
def wcCobd {X : Type*} {A : Type*} [CommGroup A] (n : ℕ) (φ : (Fin (n + 1) → X) → A) :
    (Fin (n + 2) → X) → A :=
  fun h => ∏ j : Fin (n + 2), φ (fun l => h (j.succAbove l)) ^ ((-1 : ℤ) ^ (j : ℕ))

def wcPrism {X : Type*} {A : Type*} [CommGroup A] (t : X → X) (q : ℕ)
    (Φ : (Fin (q + 2) → X) → A) : (Fin (q + 1) → X) → A :=
  fun g => ∏ i : Fin (q + 1), Φ (fun k : Fin (q + 2) =>
    if h : (k : ℕ) ≤ (i : ℕ) then g ⟨k, by have := i.isLt; omega⟩
    else t (g ⟨(k : ℕ) - 1, by have := k.isLt; omega⟩)) ^ ((-1 : ℤ) ^ (i : ℕ))

def wcLayerCochain {G : Type*} {B : Type*} [Group G] [CommGroup B] [MulDistribMulAction G B]
    (N : Subgroup G) (m : ℕ) (F : (Fin (m + 1) → G) → G → B) : Prop :=
  (∀ (g : G) (x : Fin (m + 1) → G) (y : G), F (fun i => g * x i) (g * y) = g • F x y) ∧
  ∀ (x : Fin (m + 1) → G) (y ν : G), ν ∈ N → F x (y * ν) = F x y

def wcLayerT {G : Type*} {B : Type*} [Group G] [CommGroup B] {m : ℕ} (σ : G)
    (F : (Fin (m + 1) → G) → G → B) : (Fin (m + 1) → G) → G → B :=
  fun x y => F x (y * σ) * (F x y)⁻¹

def wcLayerN {G : Type*} {B : Type*} [Group G] [CommGroup B] {m : ℕ} (σ : G) (l : ℕ)
    (F : (Fin (m + 1) → G) → G → B) : (Fin (m + 1) → G) → G → B :=
  fun x y => ∏ i ∈ Finset.range l, F x (y * σ ^ i)

def wcLayerDh {G : Type*} {B : Type*} [CommGroup B] (m : ℕ)
    (F : (Fin (m + 1) → G) → G → B) : (Fin (m + 2) → G) → G → B :=
  fun x y => wcCobd m (fun x' => F x' y) x
abbrev wcEtLocKillN {X' Y : Scheme.{u}} (b : X' ⟶ Y)
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) ℕ)
    (n : ℕ) (P : Y → Prop) : Prop :=
  ∀ (V : Y.Etale) (c : (K.X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))),
    ((K.d n (n + 1)).hom.app (Opposite.op ((wcEtBaseChange b).obj V))).hom c = 0 →
    ∀ v : V.left, P (V.hom v) →
    ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left)
      (e : (K.X (n - 1)).obj.obj (Opposite.op ((wcEtBaseChange b).obj W))),
      g.left w = v ∧
      ((K.d (n - 1) n).hom.app (Opposite.op ((wcEtBaseChange b).obj W))).hom e =
        ((K.X n).obj.map ((wcEtBaseChange b).map g).op).hom c
def wcSuppSec (Y : Scheme.{u}) (W : Set Y)
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale)
    (b : G.obj.obj (Opposite.op V)) : Prop :=
  Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
    G.obj.map g.op b = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V

def wcZarGlueMod (Y : Scheme.{u}) (W : Set Y)
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) : Prop :=
  ∀ (k : ℕ) (O : Fin k → Y.Opens), (∀ y : Y, y ∉ W → ∃ i, y ∈ O i) →
  ∀ (b : ∀ i, G.obj.obj (Opposite.op ((wcZarToEt Y).obj (O i)))),
    (∀ i j, wcSuppSec Y W G ((wcZarToEt Y).obj (O i ⊓ O j))
      (G.obj.map ((wcZarToEt Y).map (homOfLE inf_le_left)).op (b i) -
        G.obj.map ((wcZarToEt Y).map (homOfLE inf_le_right)).op (b j))) →
    ∃ b₀ : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
      ∀ i (g : (wcZarToEt Y).obj (O i) ⟶ Scheme.Etale.mk (𝟙 Y)),
        wcSuppSec Y W G ((wcZarToEt Y).obj (O i)) (G.obj.map g.op b₀ - b i)

def wcEtGlueMod (Y : Scheme.{u}) (W : Set Y)
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) : Prop :=
  ∀ (R : Sieve (Scheme.Etale.mk (𝟙 Y))),
    R ∈ Scheme.smallEtaleTopology Y (Scheme.Etale.mk (𝟙 Y)) →
  ∀ (s : ∀ (V : Y.Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 Y)), R.arrows g → G.obj.obj (Opposite.op V)),
    (∀ (V₁ V₂ V' : Y.Etale) (g₁ : V₁ ⟶ Scheme.Etale.mk (𝟙 Y)) (g₂ : V₂ ⟶ Scheme.Etale.mk (𝟙 Y))
        (h₁ : R.arrows g₁) (h₂ : R.arrows g₂) (a : V' ⟶ V₁) (c : V' ⟶ V₂), a ≫ g₁ = c ≫ g₂ →
      wcSuppSec Y W G V' (G.obj.map a.op (s V₁ g₁ h₁) - G.obj.map c.op (s V₂ g₂ h₂))) →
    ∃ s₀ : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
      ∀ (V : Y.Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 Y)) (h : R.arrows g),
        wcSuppSec Y W G V (G.obj.map g.op s₀ - s V g h)
def wcCurveOrdData (Ω : Type u) [Field Ω] (X : Scheme.{u}) [IrreducibleSpace X]
    (fX : X ⟶ Spec (.of Ω)) (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U)
    (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ) : Prop :=
  (∀ m, ord (genericPoint X) m = 0) ∧
  (∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U)))) ∧
  (∀ m, {x | ord x m ≠ 0}.Finite) ∧
  (∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1) ∧
  (∀ (x : X) (f g h : (FractionRing Γ(X, U))ˣ),
      (h : FractionRing Γ(X, U)) = (f : FractionRing Γ(X, U)) + (g : FractionRing Γ(X, U)) →
      min (ord x (Additive.ofMul f)) (ord x (Additive.ofMul g)) ≤ ord x (Additive.ofMul h)) ∧
  (∀ f : (FractionRing Γ(X, U))ˣ, (∀ x, 0 ≤ ord x (Additive.ofMul f)) ↔
      ∃ c : Ω, algebraMap Γ(X, U) (FractionRing Γ(X, U))
        ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          ((fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) c)) =
        (f : FractionRing Γ(X, U)))
noncomputable def wcCurveConst (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (U : X.Opens) [IsDedekindDomain Γ(X, U)] : Ω →+* FractionRing Γ(X, U) :=
  (algebraMap Γ(X, U) (FractionRing Γ(X, U))).comp
    ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
      (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom))

noncomputable def wcRRSpace (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (U : X.Opens) [IsDedekindDomain Γ(X, U)] (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ)
    (D : X →₀ ℤ) :
    @Submodule Ω (FractionRing Γ(X, U)) _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule :=
  @Submodule.span Ω (FractionRing Γ(X, U)) _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule
    {f : FractionRing Γ(X, U) | ∃ hf : f ≠ 0,
      ∀ x, 0 ≤ ord x (Additive.ofMul (Units.mk0 f hf)) + D x}
structure wcEtTransport {A B : Scheme.{u}} (f : A ⟶ B)
    (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}) where
  ρ : ∀ (V : B.Etale) (O : A.Etale) (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ f →
    (F.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op O))
  nat : ∀ (V V' : B.Etale) (c : V' ⟶ V) (O O' : A.Etale) (d : O' ⟶ O)
    (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
    (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ f),
    h' ≫ c.left = d.left ≫ h → ∀ x : F.obj.obj (Opposite.op V),
      ρ V' O' h' hh' (F.obj.map c.op x) = G.obj.map d.op (ρ V O h hh x)

def wcEtTransportUniv {A B : Scheme.{u}} {f : A ⟶ B}
    {F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
    {G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}}
    (T : wcEtTransport f F G) : Prop :=
  ∀ (G' : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}) (T' : wcEtTransport f F G'),
    ∃! φ : G ⟶ G', ∀ (V : B.Etale) (O : A.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ f) (x : F.obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op O)).hom (T.ρ V O h hh x) = T'.ρ V O h hh x

def wcEtTransportFactor {A B C : Scheme.{u}} {f : B ⟶ C} {g : A ⟶ B} {e : A ⟶ C}
    (he : g ≫ f = e)
    {F : Sheaf (Scheme.smallEtaleTopology C) AddCommGrpCat.{u+1}}
    {G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
    {H : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}}
    (ρ : wcEtTransport f F G) (τ : wcEtTransport g G H) (σ : wcEtTransport e F H) : Prop :=
  ∀ (V : C.Etale) (O : B.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
    (O₂ : A.Etale) (k : O₂.left ⟶ O.left) (hk : k ≫ O.hom = O₂.hom ≫ g)
    (x : F.obj.obj (Opposite.op V)),
    σ.ρ V O₂ (k ≫ h) (by rw [Category.assoc, hh, ← Category.assoc, hk, Category.assoc, he]) x =
      τ.ρ O O₂ k hk (ρ.ρ V O h hh x)
def wcValFamily (Ω K I : Type*) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) : Prop :=
  (∀ i (a b h : Kˣ), (h : K) = (a : K) + (b : K) →
    min (w i (Additive.ofMul a)) (w i (Additive.ofMul b)) ≤ w i (Additive.ofMul h)) ∧
  (∀ f : Kˣ, {i | w i (Additive.ofMul f) ≠ 0}.Finite) ∧
  (∀ i, ∃ t : Kˣ, w i (Additive.ofMul t) = 1) ∧
  (∀ f : Kˣ, (∀ i, 0 ≤ w i (Additive.ofMul f)) ↔ ∃ c : Ω, algebraMap Ω K c = (f : K))

noncomputable def wcRRL (Ω K I : Type*) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (D : I →₀ ℤ) : Submodule Ω K :=
  Submodule.span Ω {f : K | ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i}

def wcRRFinRank (Ω K : Type*) [Field Ω] [Field K] [Algebra Ω K] : Prop :=
  ∀ f : K, f ∉ Set.range (algebraMap Ω K) → ∃ n : ℕ,
    (∃ u : Fin n → K, ∀ p : Fin n → Polynomial Ω,
      ∑ j, Polynomial.aeval f (p j) * u j = 0 → p = 0) ∧
    (∀ v : Fin (n + 1) → K, ∃ p : Fin (n + 1) → Polynomial Ω,
      p ≠ 0 ∧ ∑ j, Polynomial.aeval f (p j) * v j = 0)

def wcRRResidue (Ω K I : Type*) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) : Prop :=
  ∀ i (f : Kˣ), w i (Additive.ofMul f) = 0 → ∃ c : Ω, (f : K) = algebraMap Ω K c ∨
    ∃ h : Kˣ, (h : K) = (f : K) - algebraMap Ω K c ∧ 0 < w i (Additive.ofMul h)

def wcRRDim (Ω K I : Type*) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) : Prop :=
  Module.finrank Ω (wcRRL Ω K I w 0) = 1 ∧
  (∀ D, FiniteDimensional Ω (wcRRL Ω K I w D)) ∧
  ∀ D D' : I →₀ ℤ, D ≤ D' → wcRRL Ω K I w D ≤ wcRRL Ω K I w D' ∧
    (Module.finrank Ω (wcRRL Ω K I w D') : ℤ) ≤
      Module.finrank Ω (wcRRL Ω K I w D) + (D' - D).sum (fun _ k => k)

def wcRRPole (Ω K I : Type*) [Field Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) : Prop :=
  ∀ (f : Kˣ) (n : ℕ), (∀ v : Fin (n + 1) → K, ∃ p : Fin (n + 1) → Polynomial Ω,
      p ≠ 0 ∧ ∑ j, Polynomial.aeval (f : K) (p j) * v j = 0) →
    finsum (fun i => max 0 (-(w i (Additive.ofMul f)))) ≤ (n : ℤ)
noncomputable def wcPowOver (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) :
    ℕ → Over (Spec (.of Ω))
  | 0 => Over.mk (𝟙 (Spec (.of Ω)))
  | m + 1 => Over.mk (Limits.pullback.fst (wcPowOver Ω X fX m).hom fX ≫ (wcPowOver Ω X fX m).hom)

noncomputable abbrev wcPow (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (m : ℕ) : Scheme.{u} :=
  (wcPowOver Ω X fX m).left

noncomputable abbrev wcPowHom (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (m : ℕ) : wcPow Ω X fX m ⟶ Spec (.of Ω) :=
  (wcPowOver Ω X fX m).hom

noncomputable def wcPowDiv (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) :
    (m : ℕ) → wcPow Ω X fX m → X →₀ ℤ
  | 0, _ => 0
  | m + 1, z => wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX z) +
      Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX z) 1

noncomputable abbrev wcP2 (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (a b : ℕ) : Scheme.{u} :=
  Limits.pullback (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)

def wcStalkReg (X : Scheme.{u}) (U : X.Opens) (x : X) (f : (FractionRing Γ(X, U))ˣ) : Prop :=
  ∃ (V : X.Opens) (_ : x ∈ V) (s : Γ(X, V)) (a b : Γ(X, U)),
    algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ≠ 0 ∧
    (f : FractionRing Γ(X, U)) * algebraMap Γ(X, U) (FractionRing Γ(X, U)) b =
      algebraMap Γ(X, U) (FractionRing Γ(X, U)) a ∧
    (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s *
      (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom b =
      (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a

def wcTrueOrd (X : Scheme.{u}) [IrreducibleSpace X] (U : X.Opens)
    (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ) : Prop :=
  ∀ x : X, x ≠ genericPoint X → ∀ f : (FractionRing Γ(X, U))ˣ,
    (0 ≤ ord x (Additive.ofMul f) ↔ wcStalkReg X U x f)

def wcIncSet (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (U : X.Opens)
    (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ) (a b : ℕ) (α β : ℤ) (B : X →₀ ℤ) :
    Set (wcP2 Ω X fX a b) :=
  {z | IsClosed ({z} : Set (wcP2 Ω X fX a b)) ∧ ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x : X,
    α * wcPowDiv Ω X fX a (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) z) x +
      β * wcPowDiv Ω X fX b (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) z) x +
      B x + ord x (Additive.ofMul h) = 0}
def wcValGe (K : Type*) [Field K] (v : Additive Kˣ →+ ℤ) (k : ℤ) (g : K) : Prop :=
  g = 0 ∨ ∃ hg : g ≠ 0, k ≤ v (Additive.ofMul (Units.mk0 g hg))
noncomputable abbrev wcP3 (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (a b e : ℕ) : Scheme.{u} :=
  Limits.pullback (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a)
    (wcPowHom Ω X fX e)

def wcFixedPoleLocus (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (U : X.Opens) [IsDedekindDomain Γ(X, U)] (ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ)
    (a b e c₁ c₂ : ℕ) (M : X →₀ ℤ) : Set (wcP3 Ω X fX a b e) :=
  {w | IsClosed ({w} : Set (wcP3 Ω X fX a b e)) ∧ ∃ f : FractionRing Γ(X, U),
    f ∈ wcRRSpace Ω X fX U ω (M
      - c₁ • wcPowDiv Ω X fX a (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)
          (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))
      - c₂ • wcPowDiv Ω X fX b (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)
          (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))
      - wcPowDiv Ω X fX e (Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
          (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w)) ∧ f ≠ 0}
noncomputable def wcPowCoord (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) :
    (m : ℕ) → Fin m → (wcPow Ω X fX m ⟶ X)
  | 0, j => j.elim0
  | m + 1, j => Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
      (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
      (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i) j
def wcEtaleChartAt (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (x : X)
    (V : X.Opens) : Prop :=
  ∃ (W : X.Opens) (_ : IsAffineOpen W) (hxW : x ∈ W), W ≤ V ∧
    letI : Algebra Ω Γ(X, W) := ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
      (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)).toAlgebra
    ∃ (t : Γ(X, W)) (E : TensorProduct Ω Γ(X, W) Γ(X, W)),
      (∀ a : Γ(X, W), ∃ θ : TensorProduct Ω Γ(X, W) Γ(X, W),
        E * (TensorProduct.tmul Ω a (1 : Γ(X, W)) - TensorProduct.tmul Ω (1 : Γ(X, W)) a) =
          (TensorProduct.tmul Ω t (1 : Γ(X, W)) - TensorProduct.tmul Ω (1 : Γ(X, W)) t) * θ) ∧
      E - 1 ∈ Ideal.span {z : TensorProduct Ω Γ(X, W) Γ(X, W) | ∃ a : Γ(X, W),
        (X.evaluation W x hxW).hom a = 0 ∧
          (z = TensorProduct.tmul Ω a (1 : Γ(X, W)) ∨ z = TensorProduct.tmul Ω (1 : Γ(X, W)) a)}
def wcQcoh {X : Scheme.{u}} (M : X.Modules) : Prop :=
  ∀ (U : X.Opens), IsAffineOpen U → ∀ f : Γ(X, U),
    (∀ s : Γ(M, X.basicOpen f), ∃ (n : ℕ) (t : Γ(M, U)),
        ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n • s =
          (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t) ∧
    (∀ t : Γ(M, U), (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t = 0 →
        ∃ n : ℕ, f ^ n • t = 0)

def wcCoherentMod {X : Scheme.{u}} (M : X.Modules) : Prop :=
  wcQcoh M ∧ ∀ U : X.Opens, IsAffineOpen U → Module.Finite Γ(X, U) Γ(M, U)

noncomputable def wcStructMod (X : Scheme.{u}) : X.Modules := SheafOfModules.unit X.ringCatSheaf

def wcGenRankOne {X : Scheme.{u}} (G : X.Modules) (T : TopologicalSpace.Closeds X) : Prop :=
  (∀ U : X.Opens, Disjoint (U : Set X) (T : Set X) → ∀ s : Γ(G, U), s = 0) ∧
  ∃ (U : X.Opens) (e : Γ(X, U) →ₗ[Γ(X, U)] Γ(G, U)), IsAffineOpen U ∧ ((U : Set X) ∩ T).Nonempty ∧
     Function.Surjective e ∧ ∀ a : Γ(X, U), e a = 0 ↔ ∀ x ∈ U, x ∈ T → x ∉ X.basicOpen a

def wcCechH01FG (B : Type u) [CommRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B))
    (M : X.Modules) (r : ℕ) (V : Fin r → X.Opens) : Prop :=
  (∃ (k : ℕ) (c : Fin k → ∀ i : Fin r, Γ(M, V i)), ∀ z : ∀ i : Fin r, Γ(M, V i),
      (∀ i j : Fin r, M.presheaf.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op (z j) =
        M.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op (z i)) →
      ∃ b : Fin k → B, z = fun i => ∑ l, ((X.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom.comp
          (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) (b l) • c l i) ∧
  (∃ (k : ℕ) (c : Fin k → ∀ p : Fin r × Fin r, Γ(M, V p.1 ⊓ V p.2)),
    ∀ z : ∀ p : Fin r × Fin r, Γ(M, V p.1 ⊓ V p.2),
      (∀ i j l : Fin r, M.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op (z (i, j)) +
        M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op (z (j, l)) =
        M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op (z (i, l))) →
      ∃ (b : Fin k → B) (w : ∀ i : Fin r, Γ(M, V i)), z = fun p =>
        ∑ l, ((X.presheaf.map (homOfLE (le_top : V p.1 ⊓ V p.2 ≤ ⊤)).op).hom.comp
          (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) (b l) • c l p +
        (M.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op (w p.2) -
          M.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op (w p.1)))
