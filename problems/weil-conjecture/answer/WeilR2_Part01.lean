    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology X)
        ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).obj :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).2
    have hsf := (Presieve.isSheafFor_arrows_iff
      ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).obj f).mp
        (hP.isSheafFor _ hcov)
    refine ⟨fun w hw => ?_, fun s s' hss => ?_⟩
    · let x : ∀ i, F.obj.obj (Opposite.op (V i)) := fun i => F.obj.map (ε i).op (w (fun _ => i))
