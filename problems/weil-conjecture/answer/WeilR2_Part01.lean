    (∀ (a b c : Fin L.m) (x : Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)),
      x ∈ Ideal.map (wcCnSigma h ((wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b))
        (I ^ (n + 1)) →
      θ3 a b c ((X.presheaf.map (homOfLE (inf_le_left : (wcpaDjCocPull φ L).V a ⊓
          (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c ≤
          (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)).op).hom x) =
        (Y.presheaf.map (homOfLE (show (wcpaDjCocPull (p ≫ φ) L).V a ⊓
            (wcpaDjCocPull (p ≫ φ) L).V b ⊓ (wcpaDjCocPull (p ≫ φ) L).V c ⊓ q ⁻¹ᵁ ⊤ ≤
            (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b ⊓ q ⁻¹ᵁ ⊤ from
