noncomputable def wcLdpH (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (p : Fin (N + 1) × Fin 2) :
    Γ(Limits.pullback X.hom (wcProjKStr E 1), wcLdpW E N X ι p) :=
