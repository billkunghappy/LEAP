      (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
      (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _))


def wcRingAct {𝒜 : Type*} [Category 𝒜] [Preadditive 𝒜] {R : Type*} [Ring R] {A : 𝒜}
    (lamA : R → (A ⟶ A)) : Prop :=
  lamA 1 = 𝟙 A ∧ (∀ a b, lamA (a + b) = lamA a + lamA b) ∧
    (∀ a b, lamA (a * b) = lamA b ≫ lamA a)


def wcRingResSpec {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type*} [Ring R] {A : 𝒜}
    (lamA : R → (A ⟶ A)) (I : InjectiveResolution A)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex)) : Prop :=
  wcRingAct lamI ∧ (∀ r, I.ι.f 0 ≫ (lamI r).f 0 = lamA r ≫ I.ι.f 0) ∧
  ∀ (n : ℕ) {Y W : 𝒜} (i : Y ⟶ W) [Mono i] (lamY : R → (Y ⟶ Y)) (lamW : R → (W ⟶ W)),
    wcRingAct lamY → wcRingAct lamW → (∀ r, lamY r ≫ i = i ≫ lamW r) →
    ∀ g : Y ⟶ I.cocomplex.X n, (∀ r, lamY r ≫ g = g ≫ (lamI r).f n) →
      ∃ h : W ⟶ I.cocomplex.X n, i ≫ h = g ∧ ∀ r, lamW r ≫ h = h ≫ (lamI r).f n


def wcFgVan {R : Type*} [Ring R] (D : CochainComplex AddCommGrpCat.{v} ℕ)
    (lamD : R → (D ⟶ D)) : Prop :=
  (∀ n, ∃ (k : ℕ) (z : Fin k → D.X n), (∀ i, (D.d n (n + 1)).hom (z i) = 0) ∧
     ∀ x, (D.d n (n + 1)).hom x = 0 → ∃ (c : Fin k → R) (w : D.X (n - 1)),
       x = ∑ i, ((lamD (c i)).f n).hom (z i) + (D.d (n - 1) n).hom w) ∧
  (∀ n, 3 ≤ n → ∀ y, (D.d n (n + 1)).hom y = 0 → ∃ w, (D.d (n - 1) n).hom w = y)


structure wcThreeTermModel {R : Type u} [Ring R] (D : CochainComplex AddCommGrpCat.{u+1} ℕ)
    (lamD : R → (D ⟶ D)) where
  M : ModuleCat.{u+1} R
  fin : Module.Finite R M
  a : ℕ
  b : ℕ
  d0 : M →ₗ[R] (Fin a → R)
  d1 : (Fin a → R) →ₗ[R] (Fin b → R)
  α0 : M →+ D.X 0
  α1 : (Fin a → R) →+ D.X 1
  α2 : (Fin b → R) →+ D.X 2
  hdd : ∀ x, d1 (d0 x) = 0
  hlin0 : ∀ (r : R) (x : M), α0 (r • x) = ((lamD r).f 0).hom (α0 x)
  hlin1 : ∀ (r : R) (p : Fin a → R), α1 (r • p) = ((lamD r).f 1).hom (α1 p)
  hlin2 : ∀ (r : R) (p : Fin b → R), α2 (r • p) = ((lamD r).f 2).hom (α2 p)
  hc0 : ∀ x, (D.d 0 1).hom (α0 x) = α1 (d0 x)
  hc1 : ∀ p, (D.d 1 2).hom (α1 p) = α2 (d1 p)
  hc2 : ∀ p, (D.d 2 3).hom (α2 p) = 0
  q0i : ∀ x, d0 x = 0 → α0 x = 0 → x = 0
  q0s : ∀ y, (D.d 0 1).hom y = 0 → ∃ x, d0 x = 0 ∧ α0 x = y
  q1i : ∀ p, d1 p = 0 → (∃ y, (D.d 0 1).hom y = α1 p) → ∃ x, d0 x = p
  q1s : ∀ y, (D.d 1 2).hom y = 0 → ∃ p, d1 p = 0 ∧ ∃ w, (D.d 0 1).hom w = α1 p - y
  q2i : ∀ p, (∃ y, (D.d 1 2).hom y = α2 p) → ∃ p', d1 p' = p
  q2s : ∀ y, (D.d 2 3).hom y = 0 → ∃ p, ∃ w, (D.d 1 2).hom w = α2 p - y
  qhi : ∀ n, 3 ≤ n → ∀ y, (D.d n (n + 1)).hom y = 0 → ∃ w, (D.d (n - 1) n).hom w = y
noncomputable def wcpaDjBkPairIdeal (R : Type*) [CommRing R] (m : ℕ) (x : Fin m → R) (B : ℕ) :
    Ideal R :=
  ∏ ΓΓ : (Fin m → Fin (B + 1)) × (Fin m → Fin (B + 1)),
    Ideal.span {∏ i, x i ^ (ΓΓ.1 i : ℕ), ∏ i, x i ^ (ΓΓ.2 i : ℕ)}
def wcpaDjStablePtd {Z S : Scheme.{u}} (g : Z ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ Z)) : Prop :=
  wcpaDjSemistable g ∧ wcpaDjSections g n τ ∧
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S)
    (E : Set ↥(Limits.pullback g s)), E ∈ irreducibleComponents ↥(Limits.pullback g s) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback g s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd g s) →
    3 ≤ (E ∩ closure Eᶜ).ncard +
      Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst g s x = τ i (s p)}


def wcpaDjLocStable {X P : Scheme.{u}} [AlgebraicGeometry.IsIntegral P] (f : X ⟶ P) {n : ℕ}
    (σ : Fin n → (P ⟶ X)) (L : Type u) [Field L] [Algebra P.functionField L]
    (V : ValuationSubring L) : Prop :=
  ∃ (Zv : Scheme.{u}) (uv : Zv ⟶ Spec (CommRingCat.of ↥V)) (τv : Fin n → (Spec (CommRingCat.of ↥V) ⟶ Zv))
    (Yv : Scheme.{u}) (χv : Yv ⟶ X) (ψv : Yv ⟶ Zv) (πv : Yv ⟶ Spec (.of L))
    (tv : Fin n → (Spec (.of L) ⟶ Yv)),
    wcpaDjStablePtd uv n τv ∧
    (∃ (N : ℕ) (j : Zv ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V)
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V)
          MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap ↥V ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V 0))) = uv) ∧
    IsPullback χv πv f
      (Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
        P.fromSpecStalk (genericPoint P)) ∧
    IsPullback ψv πv uv (Spec.map (CommRingCat.ofHom (algebraMap ↥V L))) ∧
    (∀ i, tv i ≫ πv = 𝟙 _) ∧
    (∀ i, tv i ≫ χv = (Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
        P.fromSpecStalk (genericPoint P)) ≫ σ i) ∧
    (∀ i, tv i ≫ ψv = Spec.map (CommRingCat.ofHom (algebraMap ↥V L)) ≫ τv i)
noncomputable def wcpaDjStcRatioSec (k : Type u) [Field k] {Y : Scheme.{u}} (O : Y.Opens) {N : ℕ}
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) (i₀ i : Fin (N + 1)) :
    Γ(Y, O.ι ''ᵁ (a ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i₀))) :=
  (O.ι.appIso _).inv.hom ((a.app _).hom ((@Proj.awayToSection _ _ _ _ _
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra
    (MvPolynomial.X i₀)).hom
    (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra _ _
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i₀)) 1
      (MvPolynomial.X i)
      (by rw [smul_eq_mul, mul_one]
          exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
            (MvPolynomial.isHomogeneous_X k i)))))

def wcpaDjStcMonRel {T : Type u} [CommRing T] {n : ℕ} (x : T) (s : Fin n → T) (num den : T)
    (α : ℤ) (β : Fin n → ℤ) : Prop :=
  ∃ w : Tˣ, num * x ^ (-α).toNat * ∏ l, s l ^ (-(β l)).toNat =
    ↑w * den * x ^ α.toNat * ∏ l, s l ^ (β l).toNat

def wcpaDjStcRatioLink {Y : Scheme.{u}} {V : Y.Opens} (r : Γ(Y, V)) (y : Y)
    (num den : Y.presheaf.stalk y) : Prop :=
  den ∈ nonZeroDivisors (Y.presheaf.stalk y) ∧
  ∀ (w : Y) (hw : w ∈ V) (h : w ⤳ y),
    (Y.presheaf.germ V w hw).hom r * (Y.presheaf.stalkSpecializes h).hom den =
      (Y.presheaf.stalkSpecializes h).hom num

def wcpaDjStcBreaks {ι : Type} (I : Finset ι) {n : ℕ} (α : ι → ℤ) (β : ι → Fin n → ℤ)
    (c : Fin n → ℕ) : Set (Fin n → ℚ) :=
  {0, fun l => (c l : ℚ)} ∪
  {v | ∃ i ∈ I, ∃ j ∈ I, α i ≠ α j ∧
    v = fun l => ((β j l - β i l : ℤ) : ℚ) / ((α i - α j : ℤ) : ℚ)} ∪
  {v | ∃ i ∈ I, ∃ j ∈ I, α i = α j ∧ v = fun l => ((β i l - β j l : ℤ) : ℚ)}

def wcpaDjStcMonoData {Y S : Scheme.{u}} (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (D : Set S)
    {V : Y.Opens} {ι : Type} (I : Finset ι) (r : ι → Γ(Y, V)) (y : Y)
    (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (J : Finset (Fin n)) (α : ι → ℤ)
    (β : ι → Fin n → ℤ) (c : Fin n → ℕ) : Prop :=
    (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk (g y)) ∧
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)) ∧
    (∀ (p' : S) (h : p' ⤳ g y), p' ∈ D ↔ ∃ j ∈ J,
      (S.presheaf.stalkSpecializes h).hom (t j) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p')) ∧
    (∀ i l, β i l ≠ 0 → l ∈ J) ∧ (∀ l, c l ≠ 0 → l ∈ J) ∧
    (((∃ l, c l ≠ 0) ∧
      ∃ (v : (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)))ˣ)
        (e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y) ≃+*
          (MvPowerSeries (Fin 2) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
            (S.presheaf.stalk (g y))) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (↑v * ∏ l, (algebraMap (S.presheaf.stalk (g y))
                (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
                  (S.presheaf.stalk (g y))) (t l)) ^ c l)})),
        e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (AdicCompletion
            (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y))).comp
            (g.stalkMap y).hom) =
          (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (algebraMap (S.presheaf.stalk (g y))
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))) ∧
        ∀ i ∈ I, ∃ num den : Y.presheaf.stalk y, wcpaDjStcRatioLink (r i) y num den ∧
          wcpaDjStcMonRel (e.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0)))
            (fun l => algebraMap (Y.presheaf.stalk y) (AdicCompletion
              (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y))
                ((g.stalkMap y).hom (t l)))
            (algebraMap (Y.presheaf.stalk y) (AdicCompletion
              (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)) num)
            (algebraMap (Y.presheaf.stalk y) (AdicCompletion
              (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)) den)
            (α i) (β i)) ∨
    (c = 0 ∧ (∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) ∧
      ∃ (j : Fin m) (z : Y.presheaf.stalk y), y ∈ Set.range (τ j) ∧
        (∀ (y' : Y) (h : y' ⤳ y), y' ∈ Set.range (τ j) ↔
          (Y.presheaf.stalkSpecializes h).hom z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y')) ∧
        ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y) ≃+*
            PowerSeries (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))),
          e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (AdicCompletion
              (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y))).comp
              (g.stalkMap y).hom) =
            PowerSeries.C.comp (algebraMap (S.presheaf.stalk (g y))
              (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
                (S.presheaf.stalk (g y)))) ∧
          e (algebraMap (Y.presheaf.stalk y) (AdicCompletion
              (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)) z) =
            PowerSeries.X ∧
          ∀ i ∈ I, ∃ num den : Y.presheaf.stalk y, wcpaDjStcRatioLink (r i) y num den ∧
            wcpaDjStcMonRel (algebraMap (Y.presheaf.stalk y) (AdicCompletion
                (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)) z)
              (fun l => algebraMap (Y.presheaf.stalk y) (AdicCompletion
                (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y))
                  ((g.stalkMap y).hom (t l)))
              (algebraMap (Y.presheaf.stalk y) (AdicCompletion
                (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)) num)
              (algebraMap (Y.presheaf.stalk y) (AdicCompletion
                (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)) den)
              (α i) (β i)) ∨
    (c = 0 ∧ (∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) ∧
      y ∉ ⋃ j, Set.range (τ j) ∧ (∀ i, α i = 0) ∧
      ∀ i ∈ I, ∃ num den : Y.presheaf.stalk y, wcpaDjStcRatioLink (r i) y num den ∧
        wcpaDjStcMonRel (1 : Y.presheaf.stalk y) (fun l => (g.stalkMap y).hom (t l)) num den
          0 (β i)))

def wcpaDjStcOrdData {Y S : Scheme.{u}} (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (D : Set S)
    {V : Y.Opens} {ι : Type} (I : Finset ι) (r : ι → Γ(Y, V)) (y : Y) : Prop :=
  ∃ (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (J : Finset (Fin n)) (α : ι → ℤ)
    (β : ι → Fin n → ℤ) (c : Fin n → ℕ),
    wcpaDjStcMonoData g m τ D I r y n t J α β c ∧
    (∀ i ∈ I, ∀ j ∈ I, α i ≠ α j → ∀ l, (α i - α j) ∣ (β j l - β i l)) ∧
    (∀ v ∈ wcpaDjStcBreaks I α β c, ∀ w ∈ wcpaDjStcBreaks I α β c, v ≤ w ∨ w ≤ v)

noncomputable def wcpaDjStcLift {S S'' Y : Scheme.{u}} (g : Y ⟶ S) (ρ : S'' ⟶ S) {m : ℕ}
    (τ : Fin m → (S ⟶ Y)) (hτ : ∀ j, τ j ≫ g = 𝟙 S) (j : Fin m) :
    S'' ⟶ Limits.pullback g ρ :=
  Limits.pullback.lift (ρ ≫ τ j) (𝟙 S'')
    (by rw [Category.assoc, hτ j, Category.comp_id, Category.id_comp])

def wcpaDjStcPullOrd (k : Type u) [Field k] {S S'' Y : Scheme.{u}} (g : Y ⟶ S) (ρ : S'' ⟶ S)
    {m : ℕ} (τ : Fin m → (S ⟶ Y)) (hτ : ∀ j, τ j ≫ g = 𝟙 S) (D'' : Set S'') (O : Y.Opens)
    {N : ℕ} (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) (I : Finset (Fin (N + 1))) : Prop :=
  ∀ i₀ ∈ I, ∀ y : ↥(Limits.pullback g ρ),
    wcpaDjStcOrdData (Limits.pullback.snd g ρ) m (wcpaDjStcLift g ρ τ hτ) D'' I
      (fun i => wcpaDjStcRatioSec k (Limits.pullback.fst g ρ ⁻¹ᵁ O)
        ((Limits.pullback.fst g ρ ∣_ O) ≫ a) i₀ i) y
noncomputable abbrev wcFetgU (K : Type u) [Field K] : lwtrGenField (AlgebraicClosure K) :=
  algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) RatFunc.X


noncomputable abbrev wcFetgIota (K : Type u) [Field K] : K →+* lwtrGenField (AlgebraicClosure K) :=
  (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))).comp
    (algebraMap K (AlgebraicClosure K))


noncomputable abbrev wcFetgEvO (K : Type u) [Field K] (F : Polynomial (Polynomial K))
    (w : lwtrGenField (AlgebraicClosure K)) : lwtrGenField (AlgebraicClosure K) :=
  Polynomial.eval₂ (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) w F


noncomputable abbrev wcFetgHO (K : Type u) [Field K] (h : Polynomial K) :
    lwtrGenField (AlgebraicClosure K) :=
  Polynomial.eval₂ (wcFetgIota K) (wcFetgU K) h


noncomputable abbrev wcFetgEv {K : Type u} [Field K] (F : Polynomial (Polynomial K))
    (a b : AlgebraicClosure K) : AlgebraicClosure K :=
  Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) b F


noncomputable abbrev wcFetgH {K : Type u} [Field K] (h : Polynomial K) (a : AlgebraicClosure K) :
    AlgebraicClosure K :=
  Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) a h


abbrev wcFetgPW (K : Type u) [Field K] (G : Type) [Group G] (h : Polynomial K) (e : ℕ)
    (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K)) : Prop :=
  ∀ a b : AlgebraicClosure K, wcFetgH h a ≠ 0 → wcFetgEv f a b = 0 →
    (∀ g, wcFetgEv f a (wcFetgEv (P g) a b / wcFetgH h a ^ e) = 0) ∧
    Function.Injective (fun g => wcFetgEv (P g) a b / wcFetgH h a ^ e) ∧
    (∀ g g', wcFetgEv (P (g * g')) a b / wcFetgH h a ^ e =
      wcFetgEv (P g') a (wcFetgEv (P g) a b / wcFetgH h a ^ e) / wcFetgH h a ^ e)



abbrev wcFetgFibre (K : Type u) [Field K] (G : Type) [Group G] [Fintype G] (h : Polynomial K)
    (e : ℕ) (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K))
    (a : AlgebraicClosure K) : Prop :=
  (∃ b, wcFetgEv f a b = 0) ∧ ∀ b, wcFetgEv f a b = 0 →
    Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) f =
      ∏ g, (Polynomial.X - Polynomial.C (wcFetgEv (P g) a b / wcFetgH h a ^ e)) ∧
    wcFetgEv (P 1) a b / wcFetgH h a ^ e = b ∧
    ∀ b', wcFetgEv f a b' = 0 → ∃ g, b' = wcFetgEv (P g) a b / wcFetgH h a ^ e





abbrev wcFetgResSpec (K : Type u) [Field K] (G : Type) [Fintype G] [DecidableEq G]
    (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K))
    (c : G → AlgebraicClosure K) (Rm : MvPolynomial (Fin 2) (AlgebraicClosure K))
    (D : Polynomial (AlgebraicClosure K)) : Prop :=
  ∀ (E : Type u) [Field E] [Algebra (AlgebraicClosure K) E] (x : E) (β : G → E),
    Polynomial.map (Polynomial.eval₂RingHom
        ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x) f =
      ∏ g, (Polynomial.X - Polynomial.C (β g)) →
    MvPolynomial.aeval ![Polynomial.C x, Polynomial.X] Rm =
      ∏ g, (Polynomial.X - Polynomial.C (∑ k, algebraMap (AlgebraicClosure K) E (c k) *
        Polynomial.eval₂ (Polynomial.eval₂RingHom
          ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x)
          (β g) (P k))) ∧
    Polynomial.aeval x D = ∏ p ∈ (Finset.univ : Finset G).offDiag,
      ((∑ k, algebraMap (AlgebraicClosure K) E (c k) *
          Polynomial.eval₂ (Polynomial.eval₂RingHom
            ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x)
            (β p.1) (P k)) -
        ∑ k, algebraMap (AlgebraicClosure K) E (c k) *
          Polynomial.eval₂ (Polynomial.eval₂RingHom
            ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x)
            (β p.2) (P k))
noncomputable def wcpaLquLin {K : Type u} [Field K] {m : ℕ} (c w : Fin m → K) :
    MvPolynomial (Fin m) K :=
  ∑ l, MvPolynomial.C (w l) * (MvPolynomial.X l - MvPolynomial.C (c l))

