    ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)

noncomputable def wcLtcVal {X : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {r : ℕ}
    {G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {W : X.ProEt}
    (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W) {T : X.ProEt} (a : T ⟶ W)
    (s : G.obj.obj (Opposite.op T)) (z : T.left) : Fin r → ℚ_[ℓ] :=
  (show C(↥T.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom s).down) z

def wcLtcGam (ℓ r n : ℕ) : Type u := ULift.{u} (GL (Fin r) (ZMod (ℓ ^ n)))

noncomputable instance wcLtcGamGroup (ℓ r n : ℕ) : Group (wcLtcGam.{u} ℓ r n) :=
  inferInstanceAs (Group (ULift.{u} (GL (Fin r) (ZMod (ℓ ^ n)))))

noncomputable def wcLtcRho (ℓ r n : ℕ) : wcLtcGam.{u} ℓ r n →* GL (Fin r) (ZMod (ℓ ^ n)) :=
  (MulEquiv.ulift : ULift.{u} (GL (Fin r) (ZMod (ℓ ^ n))) ≃* GL (Fin r) (ZMod (ℓ ^ n))).toMonoidHom

noncomputable def wcLtcRed (ℓ n r : ℕ) [Fact (Nat.Prime ℓ)] :
    GL (Fin r) ℤ_[ℓ] →* wcLtcGam.{u} ℓ r n :=
  (MulEquiv.ulift.symm : GL (Fin r) (ZMod (ℓ ^ n)) ≃* ULift.{u} (GL (Fin r) (ZMod (ℓ ^ n)))).toMonoidHom.comp
    (Matrix.GeneralLinearGroup.map (PadicInt.toZModPow n))
noncomputable def wcNtT {C : Type*} [Category C] [Abelian C] [EnoughInjectives C] (N : ℕ) (Y : C) :
    C :=
  Limits.kernel (N • 𝟙 (Injective.under (Limits.cokernel (N • 𝟙 Y))))

noncomputable def wcNtEps {C : Type*} [Category C] [Abelian C] [EnoughInjectives C] (N : ℕ)
    (Y : C) : Y ⟶ wcNtT N Y :=
  Limits.cokernel.π (N • 𝟙 Y) ≫ Limits.kernel.lift (N • 𝟙 (Injective.under _))
    (Injective.ι (Limits.cokernel (N • 𝟙 Y))) (by
      have h : N • 𝟙 (Limits.cokernel (N • 𝟙 Y)) = 0 := by
        apply (cancel_epi (Limits.cokernel.π (N • 𝟙 Y))).mp
        have h1 : (N • 𝟙 Y) ≫ Limits.cokernel.π (N • 𝟙 Y) = 0 := Limits.cokernel.condition _
        rw [Preadditive.nsmul_comp, Category.id_comp] at h1
        rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero, h1]
      calc Injective.ι (Limits.cokernel (N • 𝟙 Y)) ≫
            (N • 𝟙 (Injective.under (Limits.cokernel (N • 𝟙 Y))))
          = (N • 𝟙 (Limits.cokernel (N • 𝟙 Y))) ≫ Injective.ι (Limits.cokernel (N • 𝟙 Y)) := by
            rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
        _ = 0 := by rw [h, Limits.zero_comp])

noncomputable def wcNtSeq {C : Type*} [Category C] [Abelian C] [EnoughInjectives C] (N : ℕ)
    (G : C) : ℕ → Σ (A : C), Σ (Y : C), (A ⟶ wcNtT N Y)
  | 0 => ⟨G, G, wcNtEps N G⟩
  | i + 1 => ⟨wcNtT N (wcNtSeq N G i).2.1, Limits.cokernel (wcNtSeq N G i).2.2,
      Limits.cokernel.π (wcNtSeq N G i).2.2 ≫ wcNtEps N _⟩

noncomputable def wcNtCx {C : Type*} [Category C] [Abelian C] [EnoughInjectives C] (N : ℕ)
    (G : C) : CochainComplex C ℕ :=
  CochainComplex.of (fun i => wcNtT N (wcNtSeq N G i).2.1)
    (fun i => (wcNtSeq N G (i + 1)).2.2)
    (fun i => by
      show (wcNtSeq N G (i + 1)).2.2 ≫
        (Limits.cokernel.π (wcNtSeq N G (i + 1)).2.2 ≫ wcNtEps N _) = 0
      rw [Limits.cokernel.condition_assoc, Limits.zero_comp])
def wcNprCorep {S : Scheme.{u}} {m : ℕ} (T : S.Etale)
    (P : SheafOfModules.{u+1} (wcEtZModRing S m)) (e : P.val.obj (Opposite.op T)) : Prop :=
  ∀ M : SheafOfModules.{u+1} (wcEtZModRing S m),
    Function.Bijective (fun φ : P ⟶ M => (φ.val.app (Opposite.op T)).hom e)

noncomputable def wcNprBCElt {S S' : Scheme.{u}} {g : S' ⟶ S} {m : ℕ} (Dg : wcEtPullData g m)
    (T : S.Etale) (P : SheafOfModules.{u+1} (wcEtZModRing S m)) (e : P.val.obj (Opposite.op T)) :
    (Dg.Φ.obj P).val.obj (Opposite.op ((wcEtBaseChange g).obj T)) :=
  ((Dg.adj.unit.app P).val.app (Opposite.op T)).hom e
noncomputable def wcTruncKerD {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) (k : ℕ) : Limits.kernel (N • 𝟙 (Y.X k)) ⟶ Limits.kernel (N • 𝟙 (Y.X (k + 1))) :=
  Limits.kernel.map (N • 𝟙 (Y.X k)) (N • 𝟙 (Y.X (k + 1))) (Y.d k (k + 1)) (Y.d k (k + 1))
    (by simp only [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
      Category.comp_id])

noncomputable def wcTruncKerX {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) : ℕ → C
  | 0 => Limits.cokernel (wcTruncKerD Y N 0)
  | k + 1 => Limits.kernel (N • 𝟙 (Y.X (k + 2)))

noncomputable def wcTruncKerDiff {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) : (k : ℕ) → wcTruncKerX Y N k ⟶ wcTruncKerX Y N (k + 1)
  | 0 => Limits.cokernel.desc (wcTruncKerD Y N 0) (wcTruncKerD Y N 1) (by
      have hdd : ∀ k, wcTruncKerD Y N k ≫ wcTruncKerD Y N (k + 1) = 0 := fun k => by
        ext
        simp [wcTruncKerD, Limits.kernel.map]
      exact hdd 0)
  | k + 1 => wcTruncKerD Y N (k + 2)

noncomputable def wcTruncKerRes {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) : CochainComplex C ℕ :=
  CochainComplex.of (wcTruncKerX Y N) (wcTruncKerDiff Y N) (fun k => by
    have hdd : ∀ k, wcTruncKerD Y N k ≫ wcTruncKerD Y N (k + 1) = 0 := fun k => by
      ext
      simp [wcTruncKerD, Limits.kernel.map]
    cases k with
    | zero =>
      show Limits.cokernel.desc (wcTruncKerD Y N 0) (wcTruncKerD Y N 1) _ ≫
        wcTruncKerD Y N 2 = 0
      rw [← cancel_epi (Limits.cokernel.π (wcTruncKerD Y N 0)), Limits.cokernel.π_desc_assoc,
        Limits.comp_zero]
      exact hdd 1
    | succ k =>
      show wcTruncKerD Y N (k + 2) ≫ wcTruncKerD Y N (k + 3) = 0
      exact hdd (k + 2))
noncomputable def wcSnkcS {A : Type u} [CommRing A] {n : ℕ} (π : A) (c P : Matrix (Fin n) (Fin n) A)
    (a : Fin n) : wcQuadModelRing A n π c :=
  ∑ b, algebraMap A (wcQuadModelRing A n π c) (P⁻¹ a b) *
    Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b)

noncomputable def wcSnkcG {A : Type u} [CommRing A] {n : ℕ} (π : A) (c P : Matrix (Fin n) (Fin n) A)
    (D' : MvPolynomial (Fin n) A) : wcQuadModelRing A n π c :=
  1 - MvPolynomial.eval₂Hom (algebraMap A (wcQuadModelRing A n π c)) (wcSnkcS π c P) D'
noncomputable def wcEtsmKappa {S' : Scheme.{u}} {w : S' ⟶ S'} {m : ℕ}
    (Dw : wcEtPullData w m) (Pf : S'.Etale → SheafOfModules.{u+1} (wcEtZModRing S' m))
    (ev : ∀ (V : S'.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing S' m)),
      (Pf V ⟶ M) ≃ M.val.obj (Opposite.op V))
    (V : S'.Etale) : Pf ((wcEtBaseChange w).obj V) ⟶ Dw.Φ.obj (Pf V) :=
  (ev ((wcEtBaseChange w).obj V) (Dw.Φ.obj (Pf V))).symm
    (((Dw.adj.unit.app (Pf V)).val.app (Opposite.op V)).hom (ev V (Pf V) (𝟙 _)))
noncomputable def wcCgevTotX {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] {N : ModuleCat.{u+1} R}
    (Rs : wcCgevRes N) (n : ℕ) : 𝒜 :=
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  Limits.biproduct (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1))

noncomputable def wcCgevTotEntry {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N) (n : ℕ)
    (x : Σ p : Fin (n + 1), Fin (Rs.a p)) (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)) :
    I.cocomplex.X (n - x.1) ⟶ I.cocomplex.X (n + 1 - y.1) :=
  if (y.1 : ℕ) = x.1 ∧ (y.2 : ℕ) = x.2 then
    ((-1 : ℤ) ^ (x.1 : ℕ)) • I.cocomplex.d (n - x.1) (n + 1 - y.1)
  else if hH : (y.1 : ℕ) = x.1 + 1 then
    (lamI (Rs.c x.1 (Fin.cast (congrArg Rs.a hH) y.2) x.2)).f (n - x.1) ≫
      (I.cocomplex.XIsoOfEq (by have := x.1.isLt; omega)).hom
  else 0

noncomputable def wcCgevTotD {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N) (n : ℕ) :
    wcCgevTotX I Rs n ⟶ wcCgevTotX I Rs (n + 1) :=
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  Limits.biproduct.matrix (fun x y => wcCgevTotEntry I lamI Rs n x y)

noncomputable def wcCgevTot {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N)
    (hdd : ∀ n, wcCgevTotD I lamI Rs n ≫ wcCgevTotD I lamI Rs (n + 1) = 0) :
    CochainComplex 𝒜 ℕ :=
  CochainComplex.of (wcCgevTotX I Rs) (wcCgevTotD I lamI Rs) hdd

noncomputable def wcCgevAugF {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] {N : ModuleCat.{u+1} R}
    (Rs : wcCgevRes N) (n : ℕ) :
    (haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
     Limits.biproduct (fun _ : Fin (Rs.a n) => A)) ⟶ wcCgevTotX I Rs n :=
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  Limits.biproduct.matrix (fun (k : Fin (Rs.a n)) (y : Σ p : Fin (n + 1), Fin (Rs.a p)) =>
    if h : (y.1 : ℕ) = n ∧ (y.2 : ℕ) = k then
      (I.ι.f 0 : A ⟶ I.cocomplex.X 0) ≫ (I.cocomplex.XIsoOfEq (by have := h.1; omega)).hom
    else 0)

noncomputable def wcCgevAug {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type u} [Ring R] {A : 𝒜}
    (lamA : R → (A ⟶ A)) (hA : wcRingAct lamA) (I : InjectiveResolution A)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex)) {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N)
    (hdd : ∀ n, wcCgevTotD I lamI Rs n ≫ wcCgevTotD I lamI Rs (n + 1) = 0)
    (hcomm : ∀ n, wcCgevAugF I Rs n ≫ wcCgevTotD I lamI Rs n =
      (wcCgevK lamA hA Rs).d n (n + 1) ≫ wcCgevAugF I Rs (n + 1)) :
    wcCgevK lamA hA Rs ⟶ wcCgevTot I lamI Rs hdd where
  f := wcCgevAugF I Rs
  comm' := by
    rintro i j (rfl : i + 1 = j)
    have e : (wcCgevTot I lamI Rs hdd).d i (i + 1) = wcCgevTotD I lamI Rs i :=
      CochainComplex.of_d _ _ i
    rw [e]
    exact hcomm i

noncomputable def wcCgevEmbed {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] {N : ModuleCat.{u+1} R}
    (Rs : wcCgevRes N) (P : 𝒜) (n : ℕ) (f : N → (P ⟶ I.cocomplex.X n)) :
    P ⟶ wcCgevTotX I Rs n :=
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  Limits.biproduct.lift (fun y : Σ p : Fin (n + 1), Fin (Rs.a p) =>
    if h : (y.1 : ℕ) = 0 then
      f (Rs.ε (Pi.single (Fin.cast (congrArg Rs.a h) y.2) 1)) ≫
        (I.cocomplex.XIsoOfEq (by omega)).hom
    else 0)
def wcpaDjStcKmHyp (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (mD : ℕ) (Dc : Fin mD → Set S) (N : ℕ) (I : Finset (Fin (N + 1))) (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) : Prop :=
  wcpaDjIsProjOver k sS ∧ wcpaDjIsProjOver k (g ≫ sS) ∧ wcpaDjSplitSemistable g ∧
  wcpaDjMonoNodeForm g (⋃ i, Dc i) ∧ wcpaDjSections g m τ ∧ W ≠ ⊥ ∧
  SmoothOfRelativeDimension 1 (g ∣_ W) ∧ GeometricallyConnected (g ∣_ W) ∧
  (∀ s : S, IsRegularLocalRing (S.presheaf.stalk s)) ∧ wcpaDjSNCComps S mD Dc ∧
  (W : Set S)ᶜ ⊆ ⋃ i, Dc i ∧ g ⁻¹ᵁ W ≤ O ∧
  a ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) =
      O.ι ≫ g ≫ sS ∧
  (∀ c (i : Fin (N + 1)), i ∉ I →
      a c ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) ∧
  (∀ c, (∃ i ∈ I, a c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
      O.ι c ∈ (⋃ j, Set.range ⇑(τ j)) ∪ ⇑g ⁻¹' ((W : Set S)ᶜ))

def wcpaDjStcSNCSys (S : Scheme.{u}) (mD : ℕ) (Dc : Fin mD → Set S) (p : S) (n : ℕ)
    (t : Fin n → S.presheaf.stalk p) (e : {i // p ∈ Dc i} → Fin n) : Prop :=
  (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk p) ∧
  Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk p) ∧
  Function.Injective e ∧
  ∀ (i : {i // p ∈ Dc i}) (p' : S) (h : p' ⤳ p),
    p' ∈ Dc i ↔ (S.presheaf.stalkSpecializes h).hom (t (e i)) ∈
      IsLocalRing.maximalIdeal (S.presheaf.stalk p')

def wcpaDjStcBaseMono (k : Type u) [Field k] {S Y : Scheme.{u}} (g : Y ⟶ S) (m : ℕ)
    (τ : Fin m → (S ⟶ Y)) (mD : ℕ) (Dc : Fin mD → Set S) {N : ℕ} (I : Finset (Fin (N + 1)))
    (O : Y.Opens)
    (a : O.toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) (i₀ : Fin (N + 1)) (B₀ : ℕ) (y : Y) (n : ℕ)
    (t : Fin n → S.presheaf.stalk (g y)) (J : Finset (Fin n)) : Prop :=
  ∃ (α : Fin (N + 1) → ℤ) (β : Fin (N + 1) → Fin n → ℤ) (c : Fin n → ℕ),
    (∀ i, |α i| ≤ (B₀ : ℤ)) ∧ (∀ i l, |β i l| ≤ (B₀ : ℤ)) ∧ (∀ l, c l ≤ B₀) ∧
    wcpaDjStcMonoData g m τ (⋃ i, Dc i) I (fun i => wcpaDjStcRatioSec k O a i₀ i) y n t J α β c

noncomputable abbrev wcpaDjStcTuIdeal (A : Type u) [CommRing A] {n : ℕ} (t : Fin n → A)
    (c : Fin n → ℕ) (v : Aˣ) : Ideal (MvPowerSeries (Fin 2) A) :=
  Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) -
    MvPowerSeries.C (↑v * ∏ l, t l ^ c l)}

abbrev wcpaDjStcTuRing (A : Type u) [CommRing A] {n : ℕ} (t : Fin n → A) (c : Fin n → ℕ)
    (v : Aˣ) : Type u :=
  MvPowerSeries (Fin 2) A ⧸ wcpaDjStcTuIdeal A t c v

def wcpaDjStcToricUnitProp (A : Type u) [CommRing A] [IsRegularLocalRing A] : Prop :=
    IsAdicComplete (IsLocalRing.maximalIdeal A) A →
    ∀ (n : ℕ) (t : Fin n → A), (n : WithBot ℕ∞) = ringKrullDim A →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal A →
    ∀ (c : Fin n → ℕ), (∃ l, c l ≠ 0) → ∀ (v : Aˣ)
    (f g : wcpaDjStcTuRing A t c v) (J : Finset (Fin n)),
    f ≠ 0 → g ≠ 0 →
    (∀ Q : Ideal (wcpaDjStcTuRing A t c v), Q.IsPrime → Q.height = 1 →
      (∀ l ∈ J, (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v)
        (MvPowerSeries.C (t l)) : wcpaDjStcTuRing A t c v) ∉ Q) →
      ∃ p q : wcpaDjStcTuRing A t c v, p ∉ Q ∧ q ∉ Q ∧ p * f = q * g) →
    ∃ (α : ℤ) (β : Fin n → ℤ), (∀ l, l ∉ J → β l = 0) ∧
      wcpaDjStcMonRel (T := wcpaDjStcTuRing A t c v)
        (Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.X (0 : Fin 2)))
        (fun l => Ideal.Quotient.mk (wcpaDjStcTuIdeal A t c v) (MvPowerSeries.C (t l))) f g α β
