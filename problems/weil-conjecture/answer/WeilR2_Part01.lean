    simp only [AddCommGrpCat.hom_comp] at h
    simp only [wcRriP, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
      Finsupp.mapDomain.addMonoidHom_apply, Finsupp.mapDomain_single,
      Finsupp.liftAddHom_apply_single, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    exact h
noncomputable def wcEtqmtAlpha {S S' : Scheme.{u}} (f : S' ⟶ S) (w : S' ⟶ S') (hcomp : w ≫ f = f) :
    wcEtBaseChange f ⟶ wcEtBaseChange f ⋙ wcEtBaseChange w :=
  letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
  letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) w :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) w :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@Etale : MorphismProperty Scheme.{u})
  (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
    (Q := ⊤) w f f hcomp.symm).hom

def wcEtqmtHPhi {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {n : ℕ} (hcomp : w ≫ f = f)
    (Df : wcEtPullData f n) (Dw : wcEtPullData w n) : Prop :=
  haveI := Df.cont
  haveI := Dw.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange w).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
  (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dw.φ) ≫
    (Functor.sheafPushforwardContinuousNatTrans (wcEtqmtAlpha f w hcomp) RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).app (wcEtZModRing S' n) = Df.φ

noncomputable def wcEtqmtGamma {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {n : ℕ}
    (hcomp : w ≫ f = f) (Df : wcEtPullData f n) (Dw : wcEtPullData w n)
    (hφ : wcEtqmtHPhi hcomp Df Dw) :
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ) ⋙
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) ⟶
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) :=
  haveI := Df.cont
  haveI := Dw.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange w).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
  (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
    SheafOfModules.pushforwardNatTrans _ (wcEtqmtAlpha f w hcomp) ≫
    (SheafOfModules.pushforwardCongr hφ).hom

noncomputable def wcEtqmtBeta {S S' : Scheme.{u}} (f : S' ⟶ S) (a : S' ⟶ S') (b : S ⟶ S)
    (hab : a ≫ f = f ≫ b) :
    wcEtBaseChange b ⋙ wcEtBaseChange f ⟶ wcEtBaseChange f ⋙ wcEtBaseChange a :=
  letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
  letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) a :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) a :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong a)) (@Etale : MorphismProperty Scheme.{u})
  letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) b :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) b :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong b)) (@Etale : MorphismProperty Scheme.{u})
  (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
      (Q := ⊤) f b (f ≫ b) rfl).inv ≫
    (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
      (Q := ⊤) a f (f ≫ b) hab.symm).hom

def wcEtqmtSqPhi {S S' : Scheme.{u}} {f : S' ⟶ S} {a : S' ⟶ S'} {b : S ⟶ S} {n : ℕ}
    (hab : a ≫ f = f ≫ b) (Df : wcEtPullData f n) (Da : wcEtPullData a n)
    (Db : wcEtPullData b n) : Prop :=
  haveI := Df.cont
  haveI := Da.cont
  haveI := Db.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange a).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange a) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
  haveI : (wcEtBaseChange b ⋙ wcEtBaseChange f).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange b) (wcEtBaseChange f) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')
  (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Da.φ) ≫
    (Functor.sheafPushforwardContinuousNatTrans (wcEtqmtBeta f a b hab) RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).app (wcEtZModRing S' n) =
  Db.φ ≫ ((wcEtBaseChange b).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S)).map Df.φ

noncomputable def wcEtqmtSq {S S' : Scheme.{u}} {f : S' ⟶ S} {a : S' ⟶ S'} {b : S ⟶ S} {n : ℕ}
    (hab : a ≫ f = f ≫ b) (Df : wcEtPullData f n) (Da : wcEtPullData a n)
    (Db : wcEtPullData b n) (hφ : wcEtqmtSqPhi hab Df Da Db) :
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange a) _ _ Da.cont Da.φ) ⋙
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) ⟶
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ) ⋙
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ) :=
  haveI := Df.cont
  haveI := Da.cont
  haveI := Db.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange a).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange a) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
  haveI : (wcEtBaseChange b ⋙ wcEtBaseChange f).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange b) (wcEtBaseChange f) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')
  (SheafOfModules.pushforwardComp Df.φ Da.φ).hom ≫
    SheafOfModules.pushforwardNatTrans _ (wcEtqmtBeta f a b hab) ≫
    (SheafOfModules.pushforwardCongr hφ).hom ≫ (SheafOfModules.pushforwardComp Db.φ Df.φ).inv

noncomputable abbrev wcEtqmtU {X X' : Scheme.{u}} {p : X' ⟶ X} {n : ℕ} (Dp : wcEtPullData p n) :
    SheafOfModules.unit (wcEtZModRing X n) ⟶ wcEtSuppObj Dp :=
  @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ

noncomputable def wcEtqmtGammaN {X X' : Scheme.{u}} {p : X' ⟶ X} {γ : X' ⟶ X'} {n : ℕ}
    (hγ : γ ≫ p = p) (Dp : wcEtPullData p n) (Dγ : wcEtPullData γ n)
    (hφ : wcEtqmtHPhi hγ Dp Dγ) : wcEtSuppObj Dp ⟶ wcEtSuppObj Dp :=
  (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange γ) _ _ Dγ.cont Dγ.φ) ≫
    (wcEtqmtGamma hγ Dp Dγ hφ).app (SheafOfModules.unit (wcEtZModRing X' n))

noncomputable def wcEtqmtActN {X X' : Scheme.{u}} {p : X' ⟶ X} {a : X' ⟶ X'} {b : X ⟶ X}
    {n : ℕ} (hab : a ≫ p = p ≫ b) (Dp : wcEtPullData p n) (Da : wcEtPullData a n)
    (Db : wcEtPullData b n) (hφ : wcEtqmtSqPhi hab Dp Da Db) :
    wcEtSuppObj Dp ⟶
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ).obj
        (wcEtSuppObj Dp) :=
  (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).map
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange a) _ _ Da.cont Da.φ) ≫
    (wcEtqmtSq hab Dp Da Db hφ).app (SheafOfModules.unit (wcEtZModRing X' n))

noncomputable abbrev wcEtqmtX {A : Type u} [CommRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {U : Scheme.{u}} (g : U ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (a : Fin n) : Γ(U, ⊤) :=
  g.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
    (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a)))

noncomputable abbrev wcEtqmtP {X X' : Scheme.{u}} {p : X' ⟶ X} {n : ℕ} (Dp : wcEtPullData p n) :
    SheafOfModules.{u+1} (wcEtZModRing X' n) ⥤ SheafOfModules.{u+1} (wcEtZModRing X n) :=
  @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ

noncomputable abbrev wcEtqmtTower {A : Type u} [CommRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {U : Scheme.{u}} (ℓ : ℕ)
    (g : U ⟶ Spec (.of (wcQuadModelRing A n π c))) (fX : U ⟶ Spec (.of A)) {Ω : Type u} [Field Ω]
    (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (σ : Spec (.of Ω) ⟶ Spec (.of Ω))
    (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ) (a : Fin n) :=
  @wcQmtmTower A Γ(U, ⊤) Ω _ _ _ ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom
    (Limits.pullback fX ξ) (Limits.pullback.fst fX ξ ≫ U.toSpecΓ) (Limits.pullback.snd fX ξ) σQ
    (wcEtqmtX g a)
def wcLnRepr {N : ℕ} {P P' : wcLnModel (ZMod N)} {i j : ℕ}
    (φ : (wcLnModelAb.{u+1} P).X i ⟶ (wcLnModelAb.{u+1} P').X j)
    (M : Matrix (Fin (P.k i)) (Fin (P'.k j)) (ZMod N)) : Prop :=
  ∀ w : wcIdemSub (P.ε i),
    ((ULift.down (φ.hom (ULift.up w : (wcLnModelAb.{u+1} P).X i)) : wcIdemSub (P'.ε j)) :
      Fin (P'.k j) → ZMod N) = Matrix.vecMul (w : Fin (P.k i) → ZMod N) M
def wcpaDjGdRep : ℕ → ℕ → Multiset ℕ
  | 0, _ => 0
  | d + 1, a => if a = 0 then 0 else
      (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) - (d + 1)) ::ₘ
        wcpaDjGdRep d (a - Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1)) (d + 1))
noncomputable abbrev wcpaLqY {C P' S : Scheme.{u}} (g : C ⟶ P') (ι : S ⟶ C) : Scheme.{u} :=
  Limits.pullback g (ι ≫ g)

noncomputable def wcpaLqDelta {C P' S : Scheme.{u}} (g : C ⟶ P') (ι : S ⟶ C) :
    S ⟶ wcpaLqY g ι :=
  Limits.pullback.lift ι (𝟙 S) (by rw [Category.id_comp])

noncomputable def wcpaLqTheta {C P' S : Scheme.{u}} (g : C ⟶ P') (ι : S ⟶ C) {K : Type u}
    [Field K] (s : Spec (.of K) ⟶ P') (σ : Spec (.of K) ⟶ S) (hs : s = σ ≫ ι ≫ g) :
    Limits.pullback g s ⟶ wcpaLqY g ι :=
  Limits.pullback.lift (Limits.pullback.fst g s) (Limits.pullback.snd g s ≫ σ)
    (by
      rw [Limits.pullback.condition, Category.assoc]
      exact congrArg (fun t => Limits.pullback.snd g s ≫ t) hs)

noncomputable def wcpaLqPsi {C P' S : Scheme.{u}} (g : C ⟶ P') (ι : S ⟶ C) {K : Type u}
    [Field K] (s : Spec (.of K) ⟶ P') (σ : Spec (.of K) ⟶ S) (hs : s = σ ≫ ι ≫ g)
    (Ω : (wcpaLqY g ι).Opens) (w : ↥(Limits.pullback g s))
    (hw : w ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω) :
    Γ(wcpaLqY g ι, Ω) →+* (Limits.pullback g s).presheaf.stalk w :=
  ((wcpaLqTheta g ι s σ hs).app Ω ≫ (Limits.pullback g s).presheaf.germ _ w hw).hom

structure wcpaLqFrame {C P' S : Scheme.{u}} (g : C ⟶ P') (ι : S ⟶ C) where
  Ω : (wcpaLqY g ι).Opens
  V : S.Opens
  hΩ : IsAffineOpen Ω
  hV : IsAffineOpen V
  hΩV : Ω ≤ Limits.pullback.snd g (ι ≫ g) ⁻¹ᵁ V
  hVΩ : V ≤ wcpaLqDelta g ι ⁻¹ᵁ Ω
  u : Γ(wcpaLqY g ι, Ω)
  v : Γ(wcpaLqY g ι, Ω)
  a : Γ(S, V)
  b : Γ(S, V)
  c : Γ(S, V)
  hu : ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom u = 0
  hv : ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom v = 0
  span : ∀ x : Γ(wcpaLqY g ι, Ω), ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom x = 0 →
    x ∈ Ideal.span {u, v} ⊔ RingHom.ker ((wcpaLqDelta g ι).appLE Ω V hVΩ).hom ^ 2
  disc : IsUnit (b ^ 2 - 4 * a * c)
  fpf : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
    (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
    τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
    ∀ (hs : s = σ ≫ ι ≫ g) (h : ⊤ ≤ σ ⁻¹ᵁ V)
      (hw : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ Ω),
      wcpaLqBasis K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))
          (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
            (τ (IsLocalRing.closedPoint K)))
          (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw u)
          (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw v) ∧
        wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
            (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h a) *
            wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw u ^ 2 +
          wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
            (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h b) *
            (wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw u *
              wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw v) +
          wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
            (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ V h c) *
            wcpaLqPsi g ι s σ hs Ω (τ (IsLocalRing.closedPoint K)) hw v ^ 2 ∈
          IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 3

def wcpaLqTrans {C P' S : Scheme.{u}} {g : C ⟶ P'} {ι : S ⟶ C} (F₁ F₂ : wcpaLqFrame g ι)
    (N : S.Opens) (M : Matrix (Fin 2) (Fin 2) Γ(S, N)) : Prop :=
  ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P')
    (τ : Spec (.of K) ⟶ Limits.pullback g s) (σ : Spec (.of K) ⟶ S),
    τ ≫ Limits.pullback.snd g s = 𝟙 _ → τ ≫ Limits.pullback.fst g s = σ ≫ ι →
    ∀ (hs : s = σ ≫ ι ≫ g) (h : ⊤ ≤ σ ⁻¹ᵁ N)
      (hw₁ : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ F₁.Ω)
      (hw₂ : τ (IsLocalRing.closedPoint K) ∈ wcpaLqTheta g ι s σ hs ⁻¹ᵁ F₂.Ω),
      wcpaLqPsi g ι s σ hs F₁.Ω (τ (IsLocalRing.closedPoint K)) hw₁ F₁.u -
          (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
              (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ N h (M 0 0)) *
              wcpaLqPsi g ι s σ hs F₂.Ω (τ (IsLocalRing.closedPoint K)) hw₂ F₂.u +
            wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
              (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ N h (M 0 1)) *
              wcpaLqPsi g ι s σ hs F₂.Ω (τ (IsLocalRing.closedPoint K)) hw₂ F₂.v) ∈
          IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 2 ∧
        wcpaLqPsi g ι s σ hs F₁.Ω (τ (IsLocalRing.closedPoint K)) hw₁ F₁.v -
          (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
              (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ N h (M 1 0)) *
              wcpaLqPsi g ι s σ hs F₂.Ω (τ (IsLocalRing.closedPoint K)) hw₂ F₂.u +
            wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
              (τ (IsLocalRing.closedPoint K)) (wcpaBscEval K σ N h (M 1 1)) *
              wcpaLqPsi g ι s σ hs F₂.Ω (τ (IsLocalRing.closedPoint K)) hw₂ F₂.v) ∈
          IsLocalRing.maximalIdeal
            ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ 2

def wcpaLqSH (k : Type u) [Field k] {C P' S : Scheme.{u}} (sP' : P' ⟶ Spec (.of k))
    (g : C ⟶ P') (ι : S ⟶ C) : Prop :=
  wcpaDjIsProjOver k (g ≫ sP') ∧ wcpaDjIsProjOver k sP' ∧ IsClosedImmersion ι ∧ IsReduced S ∧
    IsProper g ∧
    ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P') (τ : Spec (.of K) ⟶ Limits.pullback g s),
      τ ≫ Limits.pullback.snd g s = 𝟙 _ →
      Limits.pullback.fst g s (τ (IsLocalRing.closedPoint K)) ∈ Set.range ι →
      wcpaLqRatNode K ((Limits.pullback g s).presheaf.stalk (τ (IsLocalRing.closedPoint K)))
        (wcpaLqPhi K (Limits.pullback g s) (Limits.pullback.snd g s)
          (τ (IsLocalRing.closedPoint K)))

def wcpaLqConic {K : Type u} [Field K] (a b c a' b' c' m00 m01 m10 m11 : K) : Prop :=
  ∃ t : K, a' = t * (a * m00 ^ 2 + b * (m00 * m10) + c * m10 ^ 2) ∧
    b' = t * (2 * a * (m00 * m01) + b * (m00 * m11 + m01 * m10) + 2 * c * (m10 * m11)) ∧
    c' = t * (a * m01 ^ 2 + b * (m01 * m11) + c * m11 ^ 2)
structure wcCgevRes {R : Type u} [Ring R] (N : ModuleCat.{u+1} R) where
  a : ℕ → ℕ
  c : ∀ p, Matrix (Fin (a (p + 1))) (Fin (a p)) R
  ε : (Fin (a 0) → R) →ₗ[R] N
  surj : Function.Surjective ε
  ex0 : ∀ v : Fin (a 0) → R, ε v = 0 ↔ ∃ w : Fin (a (0 + 1)) → R, Matrix.vecMul w (c 0) = v
  ex : ∀ (p : ℕ) (v : Fin (a (p + 1)) → R), Matrix.vecMul v (c p) = 0 ↔
    ∃ w : Fin (a (p + 1 + 1)) → R, Matrix.vecMul w (c (p + 1)) = v
  hcc : ∀ p, c (p + 1) * c p = 0

noncomputable def wcCgevK {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type u} [Ring R] {A : 𝒜}
    (lamA : R → (A ⟶ A)) (hA : wcRingAct lamA) {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N) :
    CochainComplex 𝒜 ℕ :=
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  CochainComplex.of (fun p => Limits.biproduct (fun _ : Fin (Rs.a p) => A))
    (fun p => Limits.biproduct.matrix (fun j i => lamA (Rs.c p i j)))
    (fun p => by
      let φ : R →+ (A ⟶ A) := AddMonoidHom.mk' lamA hA.2.1
      apply Limits.biproduct.hom_ext'
      intro j
      apply Limits.biproduct.hom_ext
      intro k
      simp only [Limits.comp_zero, Limits.zero_comp, Category.assoc, Limits.biproduct.matrix_π,
        Limits.biproduct.ι_matrix_assoc, Limits.biproduct.lift_desc]
      have h1 : ∀ i, lamA (Rs.c p i j) ≫ lamA (Rs.c (p + 1) k i) =
          φ (Rs.c (p + 1) k i * Rs.c p i j) := fun i => (hA.2.2 _ _).symm
      have h2 : ∑ i, Rs.c (p + 1) k i * Rs.c p i j = (Rs.c (p + 1) * Rs.c p) k j :=
        (Matrix.mul_apply).symm
      rw [Finset.sum_congr rfl (fun i _ => h1 i), ← map_sum, h2, Rs.hcc p, Matrix.zero_apply,
        map_zero])
noncomputable def wcSrhlExc (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (π : A)
    (c : Matrix (Fin n) (Fin n) A) {X' : Scheme.{u}}
    (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c))) (f' : X' ⟶ Spec (.of A)) :
    Set ↥(Limits.pullback f' (wcQmSp A)) :=
  (fun x => (Limits.pullback.fst f' (wcQmSp A) ≫ β) x) ⁻¹'
    PrimeSpectrum.zeroLocus (Set.range fun i : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
          Fin n)))
def wcPushThetaNorm {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
    (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush ι)
    (θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V)) :
    Prop :=
  ∀ V : Y'.ProEt,
    (AddCommGrpCat.Hom.hom ((adj.homEquiv _ _ (θ V).hom).hom.app (Opposite.op V)))
        (wcFreeGen Y' V) =
      (AddCommGrpCat.Hom.hom ((toSheafify (Scheme.ProEt.topology Y')
          ((wcProEtBaseChange ι).op ⋙ (wcFreeSheaf X' ((wcProEtPullback ι).obj V)).obj)).app
            (Opposite.op V)))
        (wcFreeGen X' ((wcProEtPullback ι).obj V))
def wcpaSfQuotFlat (A V : Type u) [CommRing A] [AddCommGroup V] [Module A V]
