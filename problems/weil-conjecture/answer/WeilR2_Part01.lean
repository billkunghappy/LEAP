noncomputable def wcCnlPbFun {S : Scheme.{u}} {M₀ : Type u} [SmallCategory M₀] (D₀ : M₀ ⥤ S.Etale)
    (m₀ : M₀) {A : S.Etale} (c : A ⟶ D₀.obj m₀) : Over m₀ ⥤ S.Etale where
  obj n := Limits.pullback c (D₀.map n.hom)
  map {n n'} t := Limits.pullback.lift (Limits.pullback.fst c (D₀.map n.hom))
    (Limits.pullback.snd c (D₀.map n.hom) ≫ D₀.map t.left)
    (by rw [Limits.pullback.condition, Category.assoc, ← D₀.map_comp, Over.w t])
  map_id n := by
    apply Limits.pullback.hom_ext
    · simp
    · simp
  map_comp t t' := by
    apply Limits.pullback.hom_ext
    · erw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst]
    · erw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
        Limits.pullback.lift_snd, Category.assoc, ← Functor.map_comp]
      rfl

