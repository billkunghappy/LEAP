def wcTorDescCocyc (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (m : ℕ) [NeZero m]
    (e : ZMod m → TensorProduct R R' R') : Prop :=
  (∀ c, IsIdempotentElem (e c)) ∧ (∀ c c', c ≠ c' → e c * e c' = 0) ∧ ∑ c, e c = 1 ∧
  ∀ c, (Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeRight (e c) :
      TensorProduct R R' (TensorProduct R R' R')) =
    ∑ a, Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeLeft (e a) *
      Algebra.TensorProduct.includeRight (e (c - a))

def wcTorDescCond (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (m : ℕ) [NeZero m]
    (e : ZMod m → TensorProduct R R' R') (v : ZMod m → R') : Prop :=
  ∀ h, (TensorProduct.tmul R (1 : R') (v h) : TensorProduct R R' R') =
    ∑ c, e c * TensorProduct.tmul R (v (h + c)) (1 : R')

noncomputable def wcTorDescL (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (m : ℕ)
    (B : Type u) [CommRing B] [Algebra R B] (ι : B →ₐ[R] (ZMod m → R')) :
    TensorProduct R R' B →ₐ[R'] (ZMod m → R') :=
  Algebra.TensorProduct.lift (Algebra.ofId R' (ZMod m → R')) ι (fun _ _ => Commute.all _ _)

noncomputable def wcTorDescMu (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (m : ℕ)
    (σ : ZMod m → (B →ₐ[R] B)) : TensorProduct R B B →ₐ[R] (ZMod m → B) :=
  AlgHom.pi (fun c => Algebra.TensorProduct.lift (σ c) (AlgHom.id R B)
    (fun _ _ => Commute.all _ _))

def wcTorDescHyp.{v} : Prop :=
  ∀ (R R' : Type v) [CommRing R] [CommRing R'] [Algebra R R'] [Module.FaithfullyFlat R R']
    (m : ℕ) [NeZero m] (e : ZMod m → TensorProduct R R' R'), wcTorDescCocyc R R' m e →
    ∃ (B : Type v) (_ : CommRing B) (_ : Algebra R B) (ι : B →ₐ[R] (ZMod m → R'))
      (σ : ZMod m → (B →ₐ[R] B)), Function.Injective ι ∧
      (∀ x, (∃ b, ι b = x) ↔ wcTorDescCond R R' m e x) ∧
      (∀ c b h, ι (σ c b) h = ι b (h + c)) ∧ Function.Bijective (wcTorDescL R R' m B ι) ∧
      wcFetTorsor (Spec.map (CommRingCat.ofHom (algebraMap R B))) m
        (fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom))

def wcTorLocRel {X : Scheme.{u}} {m : ℕ} {E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
    (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (U : X.Opens) {V : Scheme.{u}} {pU : V ⟶ (U : Scheme.{u})} {a : ZMod m → (V ⟶ V)}
    (ht : wcFetTorsor pU m a) (hE : Etale (pU ≫ U.ι))
    (s : E.obj.obj (Opposite.op (wcTorsorEt (pU ≫ U.ι) hE))) : Prop :=
  (g.hom.app (Opposite.op (wcTorsorEt (pU ≫ U.ι) hE))).hom s =
      wcConstSec X (ULift.{u+1} ℤ) (wcTorsorEt (pU ≫ U.ι) hE) (ULift.up 1) ∧
    ∀ c : ZMod m, (E.obj.map (wcTorsorAct (pU ≫ U.ι) hE (a c)
        (by rw [← Category.assoc, ht.act_p c])).op).hom s =
      s + (f.hom.app (Opposite.op (wcTorsorEt (pU ≫ U.ι) hE))).hom
        (wcConstSec X (ULift.{u+1} (ZMod m)) (wcTorsorEt (pU ≫ U.ι) hE) (ULift.up c))

