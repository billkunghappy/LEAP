noncomputable def wcLpttKt (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    wcLpttEtExt Y (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) k)) (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) (k + 1))) 1 :=
