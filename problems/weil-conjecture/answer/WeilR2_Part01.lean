noncomputable def wcPushTransfer {X Y : Scheme.{u}} (qb : Y ⟶ X) {P : X.ProEt} {Q : Y.ProEt}
    (A : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
