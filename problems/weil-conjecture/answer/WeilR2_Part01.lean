  naturality _ _ _ := Limits.pullback.lift_snd _ _ _
abbrev wcPropBAccPkg (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] (n : ℕ)
    (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] (C₀ : Type u) [CommRing C₀]
    [Algebra C C₀] (P₀ : Ideal C₀) (S : Set (Ideal (TensorProduct C C₀ D))) : Prop :=
  ∃ (C₁ : Type u) (_ : CommRing C₁) (_ : Algebra C₀ C₁) (_ : Algebra C C₁) (_ : IsScalarTower C C₀ C₁) (_ : Algebra.Etale C₀ C₁) (P₁ : Ideal C₁), P₁.IsPrime ∧ P₁.comap (algebraMap C₀ C₁) = P₀ ∧ ∃ (m : ℕ) (e : Fin m → TensorProduct C C₁ D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (e a)) ∧ (∀ a, ∃ φ : E (k a) →+* Localization.Away (e a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C₁ D) (Localization.Away (e a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₁ D).toRingHom) ∧ ∀ Q₁ : Ideal (TensorProduct C C₁ D), Q₁.IsPrime → Q₁.comap (Algebra.TensorProduct.includeLeft : C₁ →ₐ[C] TensorProduct C C₁ D).toRingHom = P₁ → Q₁.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₀ C₁) (AlgHom.id C D)).toRingHom ∈ S → ∃ a, e a ∉ Q₁
