noncomputable def wcGeomPoint (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) : X.left.ProEt :=
  MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
    (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) h


noncomputable def wcGeomFrob (F : Type u) [Field F] [Finite F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    wcGeomPoint F X h ⟶ wcGeomPoint F X h :=
  MorphismProperty.Over.homMk
    (Limits.pullback.map X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (𝟙 X.left)
      (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
          (AlgebraicClosure F) _ _ _).symm : AlgebraicClosure F →+* AlgebraicClosure F)))
      (𝟙 _) (by simp) (by
        rw [Category.comp_id, ← Spec.map_comp]
        congr 1
        ext x
        exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
          (AlgebraicClosure F) _ _ _).symm.commutes x).symm))
    (by
      change Limits.pullback.map _ _ _ _ _ _ _ _ _ ≫ Limits.pullback.fst _ _ =
        Limits.pullback.fst _ _
      exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)) trivial


noncomputable abbrev wcCoh (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ) : Type (u+1) :=
  Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcLadicSheaf X.left ℓ) i


noncomputable def wcCohScalar (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ) (c : ℚ_[ℓ]) :
    wcCoh F X h ℓ i →+ wcCoh F X h ℓ i :=
  (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)).postcomp _ (add_zero i)


noncomputable def wcCohFrob (F : Type u) [Field F] [Finite F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ) :
    wcCoh F X h ℓ i →+ wcCoh F X h ℓ i :=
  (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).precomp _ (zero_add i)


def wcAddEquivMatrix {V : Type*} [AddCommGroup V] {R : Type*} [CommRing R] {r : ℕ}
    (e : V ≃+ (Fin r → R)) (Φ : V →+ V) : Matrix (Fin r) (Fin r) R :=
  Matrix.of fun a b => e (Φ (e.symm (Pi.single b 1))) a
def dwbExpS (s : ℚ) (d : ℕ) : PowerSeries ℚ :=
  PowerSeries.mk fun m => if d ∣ m then s ^ (m / d) / ((m / d).factorial : ℚ) else 0

def dwbAHSeq (p : ℕ) : ℕ → ℚ
  | 0 => 1
  | k + 1 => ((k : ℚ) + 1)⁻¹ * ∑ i ∈ Finset.range (k + 1 + 1),
      if h : 0 < p ^ i ∧ p ^ i ≤ k + 1 then dwbAHSeq p (k + 1 - p ^ i) else 0
decreasing_by exact Nat.sub_lt (Nat.succ_pos _) h.1

def dwbPB (p D N : ℕ) (U : PowerSeries ℚ) : Prop :=
  ∀ j, padicNorm p (PowerSeries.coeff j U) ^ D ≤ (p : ℚ) ^ (N * j)
