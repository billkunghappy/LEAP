  (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))

noncomputable abbrev wcEtInvExt {Z Y : Scheme.{u}} (g : Z ⟶ Y)
    (L A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ) :=
  @Abelian.Ext (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) _ _ (HasExt.standard _)
    ((wcEtInv g).obj L) ((wcEtInv g).obj A) n

open Classical in
noncomputable def wcEtInvExtPull {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y)
    (he : t ≫ g = e) (L A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ) :
    wcEtInvExt g L A n →+ wcEtInvExt e L A n :=
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1}) := HasExt.standard _
  if h : (wcEtInv t).Additive ∧ Limits.PreservesFiniteLimits (wcEtInv t) ∧
      Limits.PreservesFiniteColimits (wcEtInv t) then
    haveI := h.1
    haveI := h.2.1
    haveI := h.2.2
    ((Abelian.Ext.mk₀ (wcEtInvComp t g e he A)).postcomp ((wcEtInv e).obj L)
        (add_zero n)).comp
      (((Abelian.Ext.mk₀ (wcEtInvCompInv t g e he L)).precomp
          ((wcEtInv t).obj ((wcEtInv g).obj A)) (zero_add n)).comp
        (Functor.mapExtAddHom (wcEtInv t) ((wcEtInv g).obj L) ((wcEtInv g).obj A) n))
  else 0
noncomputable def wcCsdC1Ideal (B' : Scheme.{u}) {m n : ℕ} (u : Fin m → Γ(B', ⊤))
