noncomputable abbrev wcpaDjP2mRing (K : Type u) [Field K] (n : ℕ) (V : MvPowerSeries (Fin (n + 2)) K)
    (b : Fin n → ℕ) : Type u :=
  MvPowerSeries (Fin (n + 2)) K ⧸ wcpaDjP2mIdeal K n V b

noncomputable abbrev wcpaDjP2mPsi (K : Type u) [Field K] (n : ℕ) (V : MvPowerSeries (Fin (n + 2)) K)
    (b : Fin n → ℕ) (l₀ m₀ : Fin n) : Fin (3 + 1) → wcpaDjP2mRing K n V b :=
  ![Ideal.Quotient.mk (wcpaDjP2mIdeal K n V b) (MvPowerSeries.X 0),
    Ideal.Quotient.mk (wcpaDjP2mIdeal K n V b) (MvPowerSeries.X 1),
    Ideal.Quotient.mk (wcpaDjP2mIdeal K n V b) (MvPowerSeries.X (Fin.addNat l₀ 2)),
    Ideal.Quotient.mk (wcpaDjP2mIdeal K n V b) (MvPowerSeries.X (Fin.addNat m₀ 2))]

def wcpaDjP2mNMS (A : Type u) [CommRing A] : Prop :=
  ∃ (𝔮 : Ideal A) (_ : 𝔮.IsPrime), ¬ 𝔮.IsMaximal ∧ ¬ IsRegularLocalRing (Localization.AtPrime 𝔮)
def wcIaPt {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ζ : A) (e : ↥W) (ψ : wcGubGen W A →+* Ω) : Prop :=
  (∀ w : ↥W, ψ (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) ∧
  (∀ a : A, ψ (algebraMap A (wcGubGen W A) a) ∈ W) ∧
  ψ (algebraMap A (wcGubGen W A) ζ *
    Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A e))) ∈ W

noncomputable def wcIaSum {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (ζ : A) (r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A)
    (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) : A :=
  c.sum fun i w => algebraMap ↥W A w * Sum.elim (fun p : ℕ × Fin r₁ => ζ ^ p.1 * f₁ p.2) f₀ i

def wcIaOrd (D r₁ r₀ : ℕ) (o₁ : Fin r₁ → ℕ) (o₀ : Fin r₀ → ℕ) :
    (ℕ × Fin r₁) ⊕ Fin r₀ → ℕ :=
  Sum.elim (fun p : ℕ × Fin r₁ => D * p.1 + o₁ p.2) o₀

def wcIaGrad (r₁ r₀ : ℕ) : (ℕ × Fin r₁) ⊕ Fin r₀ → ℕ :=
  Sum.elim (fun p : ℕ × Fin r₁ => p.1) (fun _ => 0)

def wcIaNF {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ζ : A) (D r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A)
    (o₁ : Fin r₁ → ℕ) (o₀ : Fin r₀ → ℕ) (e : ↥W) : Prop :=
  ∀ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (w : ↥W),
    (∀ ψ : wcGubGen W A →+* Ω, wcIaPt W A ζ e ψ →
      ∃ u : ↥W, ψ (algebraMap A (wcGubGen W A) (wcIaSum W A ζ r₁ r₀ f₁ f₀ c)) =
        (w : Ω) * (u : Ω)) ↔
    ∀ i, w ^ D ∣ c i ^ D * e ^ wcIaOrd D r₁ r₀ o₁ o₀ i

def wcIaSP {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ϖ : ↥W) (ζ : A) (r₁ r₀ : ℕ) (f₁ : Fin r₁ → A) (f₀ : Fin r₀ → A) : Prop :=
  ∀ (n M : ℕ) (a : A), ∃ (c : (ℕ × Fin r₁) ⊕ Fin r₀ →₀ ↥W) (b b' : A),
    (∀ i ∈ c.support, wcIaGrad r₁ r₀ i < n) ∧
    a = wcIaSum W A ζ r₁ r₀ f₁ f₀ c + ζ ^ n * b + algebraMap ↥W A ϖ ^ M * b'
noncomputable abbrev wcBdeNewt {A : Type u} [CommRing A] (E : A) (K : ℕ) : A :=
  (fun y : A => 3 * y ^ 2 - 2 * y ^ 3)^[K] E

abbrev wcBdeRel {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ϖ : ↥W) (g : Fin 2 → A) (γ : ↥W) (C : Type u) [CommRing C] [Algebra A C]
    (Ψ : ↥(wcGubBox W A g γ) → C) (ε : C) (L : ℕ) : Prop :=
  ∀ (r : ↥(wcGubBox W A g γ)) (w : ↥W) (a : A), w ≠ 0 →
    algebraMap A (wcGubGen W A) (algebraMap ↥W A w) * (r : wcGubGen W A) =
      algebraMap A (wcGubGen W A) a →
    algebraMap A C (algebraMap ↥W A w) * Ψ r =
      algebraMap A C (algebraMap ↥W A ϖ) ^ L * ε * algebraMap A C a
def wcIaResOrd {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [Algebra ↥W A] (ζ : A) (D k : ℕ) (g : A) : Prop :=
  ∃ (m : ℕ) (y : Fin m → A), 0 < m ∧
    (∀ i : Fin m, y i ∈ Ideal.span {ζ ^ (k * (i.1 + 1))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
    g ^ (D * m) + ∑ i : Fin m, y i * g ^ (D * (m - 1 - i.1)) ∈
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)
noncomputable abbrev wcpaDjP2mSigRel (K : Type u) [Field K] (n : ℕ) (V : MvPowerSeries (Fin (n + 2)) K)
    (b : Fin n → ℕ) (l₀ m₀ : Fin n) : Fin (3 + 1) → MvPolynomial (Fin 3) (MvPowerSeries (Fin (n + 2)) K) :=
  ![MvPolynomial.C (MvPowerSeries.X (Fin.addNat l₀ 2)) * MvPolynomial.X 0 - MvPolynomial.C (MvPowerSeries.X 0),
    MvPolynomial.C (MvPowerSeries.X (Fin.addNat l₀ 2)) * MvPolynomial.X 1 - MvPolynomial.C (MvPowerSeries.X 1),
    MvPolynomial.C (MvPowerSeries.X (Fin.addNat l₀ 2)) * MvPolynomial.X 2 - MvPolynomial.C (MvPowerSeries.X (Fin.addNat m₀ 2)),
    MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C (V * ∏ l ∈ (Finset.univ.erase l₀).erase m₀, MvPowerSeries.X (Fin.addNat l 2) ^ b l) * MvPolynomial.X 2]

theorem torus_count_degree_only : ∀ (F : Type u) [Field F] [Finite F] (σ : Type) [Fintype σ] (g : MvPolynomial σ F), ∃ N : ℕ → ℤ, (∀ n, 0 ≤ N n ∧ N n ≤ ((Nat.card F ^ Fintype.card σ : ℕ) : ℤ) ^ n) ∧ ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E], (Nat.card {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℤ) = N (Module.finrank F E) :=
by
  intro F _ _ σ _ g
  classical
  haveI hp : Fact (ringChar F).Prime := ⟨CharP.char_is_prime F (ringChar F)⟩
  let N : ℕ → ℤ := fun n => if h : n = 0 then 0 else
    haveI : NeZero n := ⟨h⟩
    (Nat.card {x : σ → FiniteField.Extension F (ringChar F) n //
      (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℤ)
  refine ⟨N, fun n => ?_, fun E _ _ _ => ?_⟩
  · by_cases h : n = 0
    · subst h
      simp [N]
    · haveI : NeZero n := ⟨h⟩
      have hN : N n = (Nat.card {x : σ → FiniteField.Extension F (ringChar F) n //
          (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℤ) := by
        show (if h : n = 0 then _ else _) = _
        rw [dif_neg h]
      rw [hN]
      refine ⟨Int.natCast_nonneg _, ?_⟩
      have h1 := Finite.card_subtype_le (α := σ → FiniteField.Extension F (ringChar F) n)
        (fun x => (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0)
      have h2 : Nat.card (σ → FiniteField.Extension F (ringChar F) n) =
          (Nat.card F ^ Fintype.card σ) ^ n := by
        rw [Nat.card_fun, Module.natCard_eq_pow_finrank (K := F), FiniteField.finrank_extension,
          Nat.card_eq_fintype_card (α := σ), ← pow_mul, ← pow_mul, mul_comm]
      rw [h2] at h1
      exact_mod_cast h1
  · have hn : Module.finrank F E ≠ 0 := Module.finrank_pos.ne'
    haveI : NeZero (Module.finrank F E) := ⟨hn⟩
    have hN : N (Module.finrank F E) =
        (Nat.card {x : σ → FiniteField.Extension F (ringChar F) (Module.finrank F E) //
          (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℤ) := by
      show (if h : Module.finrank F E = 0 then _ else _) = _
      rw [dif_neg hn]
    rw [hN]
    let e : E ≃ₐ[F] FiniteField.Extension F (ringChar F) (Module.finrank F E) :=
      FiniteField.algEquivExtension F (ringChar F) (Module.finrank F E) E rfl
    let ψ : (σ → E) ≃ (σ → FiniteField.Extension F (ringChar F) (Module.finrank F E)) :=
      { toFun := fun x i => e (x i)
        invFun := fun y i => e.symm (y i)
        left_inv := fun x => by funext i; simp
        right_inv := fun y => by funext i; simp }
    have hcomp : ∀ x : σ → E,
        MvPolynomial.aeval (fun i => e (x i)) g = e (MvPolynomial.aeval x g) := by
      intro x
      exact (MvPolynomial.comp_aeval_apply (f := x) e.toAlgHom g).symm
    have Φ : {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} ≃
        {y : σ → FiniteField.Extension F (ringChar F) (Module.finrank F E) //
          (∀ i, y i ≠ 0) ∧ MvPolynomial.aeval y g = 0} := by
      refine Equiv.subtypeEquiv ψ (fun x => ?_)
      show _ ↔ (∀ i, e (x i) ≠ 0) ∧ MvPolynomial.aeval (fun i => e (x i)) g = 0
      rw [hcomp x]
      simp only [ne_eq, map_eq_zero_iff e e.injective]
    rw [Nat.card_congr Φ]

theorem perm_necklace : ∀ (S : Type u) [Finite S] (f : Equiv.Perm S) (n : ℕ), 1 ≤ n → (n : ℤ) ∣ ∑ d ∈ n.divisors, (ArithmeticFunction.moebius (n / d) : ℤ) * (Nat.card (Function.fixedPoints ⇑(f ^ d)) : ℤ) :=
by
  intro S _ f n hn
  classical
  haveI := Fintype.ofFinite S
  set g : S → S := ⇑f with hg

  have s2 : ∀ d : ℕ, 1 ≤ d → Nat.card (Function.fixedPoints g^[d]) =
      ∑ k ∈ d.divisors, Nat.card {x : S // Function.minimalPeriod g x = k} := by
    intro d hd
    have h1 : Nat.card (Function.fixedPoints g^[d]) =
        (Finset.univ.filter (fun x => Function.minimalPeriod g x ∣ d)).card := by
      rw [Nat.card_eq_fintype_card, ← Set.toFinset_card]
      congr 1
      ext x
      simp [Function.mem_fixedPoints, ← Function.isPeriodicPt_iff_minimalPeriod_dvd]
      rfl
    rw [h1, Finset.card_eq_sum_card_fiberwise (f := fun x => Function.minimalPeriod g x)
      (t := d.divisors)]
    · refine Finset.sum_congr rfl (fun k hk => ?_)
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
      congr 1
      ext x
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_iff_right_iff_imp]
      intro hx
      rw [hx]
      exact Nat.dvd_of_mem_divisors hk
    · intro x hx
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hx
      simp only [Finset.mem_coe, Nat.mem_divisors]
      exact ⟨hx, by omega⟩

  have s3 : ∀ (a F : ℕ → ℤ), (∀ d : ℕ, 1 ≤ d → F d = ∑ k ∈ d.divisors, a k) →
      ∑ d ∈ n.divisors, (ArithmeticFunction.moebius (n / d) : ℤ) * F d = a n := by
    intro a F hF
    have := (ArithmeticFunction.sum_eq_iff_sum_smul_moebius_eq (f := a) (g := F)).mp
      (fun d hd => (hF d hd).symm) n hn
    rw [← this, Nat.sum_divisorsAntidiagonal'
      (f := fun i j => (ArithmeticFunction.moebius i : ℤ) • F j)]
    simp

  have s4 : n ∣ Nat.card {x : S // Function.minimalPeriod g x = n} := by
    set P := Finset.univ.filter (fun x => Function.minimalPeriod g x = n) with hP
    have hcard : Nat.card {x : S // Function.minimalPeriod g x = n} = P.card := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    rw [hcard]
    let O : S → Finset S := fun x => (Finset.range n).image (fun i => g^[i] x)
    have hmemP : ∀ x, x ∈ P ↔ Function.minimalPeriod g x = n := by
      intro x; simp [hP]
    have hOcard : ∀ x ∈ P, (O x).card = n := by
      intro x hx
      rw [hmemP] at hx
      have hinj := Function.iterate_injOn_Iio_minimalPeriod (f := g) (x := x)
      rw [hx] at hinj
      rw [Finset.card_image_of_injOn, Finset.card_range]
      rw [Finset.coe_range]
      exact hinj
    have hper : ∀ x ∈ P, x ∈ Function.periodicPts g := by
      intro x hx
      rw [hmemP] at hx
      have := Function.isPeriodicPt_minimalPeriod g x
      rw [hx] at this
      exact Function.mk_mem_periodicPts (by omega) this
    have hclos : ∀ x ∈ P, ∀ j, g^[j] x ∈ P := by
      intro x hx j
      rw [hmemP, Function.minimalPeriod_apply_iterate (hper x hx), ← hmemP]
      exact hx
    have hsub : ∀ x ∈ P, ∀ j, O (g^[j] x) ⊆ O x := by
      intro x hx j y hy
      simp only [O, Finset.mem_image, Finset.mem_range] at hy ⊢
      obtain ⟨i, hi, rfl⟩ := hy
      refine ⟨(i + j) % n, Nat.mod_lt _ (by omega), ?_⟩
      rw [← Function.iterate_add_apply]
      have := Function.iterate_mod_minimalPeriod_eq (f := g) (x := x) (n := i + j)
      rw [(hmemP x).mp hx] at this
      exact this
    have hself : ∀ x, x ∈ O x := by
      intro x
      simp only [O, Finset.mem_image, Finset.mem_range]
      exact ⟨0, by omega, rfl⟩
    have hfib : ∀ x₀ ∈ P, P.filter (fun x => O x = O x₀) = O x₀ := by
      intro x₀ hx₀
      ext y
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨_, hy⟩
        rw [← hy]; exact hself y
      · intro hy
        have hy' := hy
        simp only [O, Finset.mem_image, Finset.mem_range] at hy'
        obtain ⟨j, _, rfl⟩ := hy'
        refine ⟨hclos x₀ hx₀ j, ?_⟩
        apply Finset.eq_of_subset_of_card_le (hsub x₀ hx₀ j)
        rw [hOcard _ hx₀, hOcard _ (hclos x₀ hx₀ j)]
    rw [Finset.card_eq_sum_card_fiberwise (f := O) (t := P.image O)
      (fun x hx => Finset.mem_image_of_mem O hx)]
    have hT : ∀ T ∈ P.image O, (P.filter (fun x => O x = T)).card = n := by
      intro T hT
      obtain ⟨x₀, hx₀, rfl⟩ := Finset.mem_image.mp hT
      rw [hfib x₀ hx₀, hOcard x₀ hx₀]
    rw [Finset.sum_congr rfl hT, Finset.sum_const, smul_eq_mul]
    exact Dvd.intro_left _ rfl

  have hF : ∀ d : ℕ, 1 ≤ d → (Nat.card (Function.fixedPoints ⇑(f ^ d)) : ℤ) =
      ∑ k ∈ d.divisors, (Nat.card {x : S // Function.minimalPeriod g x = k} : ℤ) := by
    intro d hd
    rw [Equiv.Perm.coe_pow, ← hg, s2 d hd]
    push_cast
    rfl
  rw [s3 (fun k => (Nat.card {x : S // Function.minimalPeriod g x = k} : ℤ))
    (fun d => (Nat.card (Function.fixedPoints ⇑(f ^ d)) : ℤ)) hF]
  exact Int.natCast_dvd_natCast.mpr s4

theorem torus_count_frobenius_model : ∀ (F : Type u) [Field F] [Finite F] (σ : Type) [Fintype σ] (g : MvPolynomial σ F) (N : ℕ → ℤ), (∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E], (Nat.card {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℤ) = N (Module.finrank F E)) → ∀ n : ℕ, 1 ≤ n → ∃ (S : Type u) (_ : Finite S) (f : Equiv.Perm S), ∀ d ∈ n.divisors, (Nat.card (Function.fixedPoints ⇑(f ^ d)) : ℤ) = N d :=
by
  intro F _ _ σ _ g N hN n hn
  classical
  letI : Fintype F := Fintype.ofFinite F
  have hext : ∀ m : ℕ, 1 ≤ m → ∃ (E : Type u) (_ : Field E) (_ : Algebra F E),
      FiniteDimensional F E ∧ Module.finrank F E = m := by
    intro m hm
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    haveI : NeZero m := ⟨by omega⟩
    refine ⟨ULift.{u} (FiniteField.Extension F (ringChar F) m), inferInstance, inferInstance,
      ?_, ?_⟩
    · exact Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
    · rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
      exact FiniteField.finrank_extension F (ringChar F) m
  obtain ⟨K, _, _, _, hK⟩ := hext n hn
  haveI : Finite K := Module.finite_of_finite F
  let φ : K →ₐ[F] K := FiniteField.frobeniusAlgHom F K
  have hφ : ∀ a : K, φ a = a ^ Nat.card F := fun a => by
    rw [FiniteField.frobeniusAlgHom_apply, Fintype.card_eq_nat_card]
  have hφinj : Function.Injective φ := φ.toRingHom.injective
  let T : {x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} →
      {x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} := fun x =>
    ⟨fun i => φ (x.1 i), fun i => (map_ne_zero φ).mpr (x.2.1 i),
      by rw [← MvPolynomial.comp_aeval_apply x.1 φ g, x.2.2, map_zero]⟩
  have hTinj : Function.Injective T := by
    intro x y hxy
    apply Subtype.ext
    funext i
    have h := congrArg (fun z : {x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} =>
      z.1 i) hxy
    exact hφinj h
  let f : Equiv.Perm {x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} :=
    Equiv.ofBijective T (Finite.injective_iff_bijective.mp hTinj)
  have hf : ∀ (d : ℕ) (x : {x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0}),
      ((f ^ d) x).1 = fun i => x.1 i ^ (Nat.card F ^ d) := by
    intro d
    induction d with
    | zero => intro x; funext i; simp
    | succ d ih =>
      intro x
      rw [pow_succ', Equiv.Perm.mul_apply]
      funext i
      show φ (((f ^ d) x).1 i) = _
      rw [hφ, ih]
      show (x.1 i ^ Nat.card F ^ d) ^ Nat.card F = _
      rw [← pow_mul, ← pow_succ]
  refine ⟨{x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0}, inferInstance, f, ?_⟩
  intro d hd
  have hdn : d ∣ n := (Nat.mem_divisors.mp hd).1
  have hd1 : 1 ≤ d := Nat.pos_of_mem_divisors hd
  obtain ⟨E, _, _, _, hE⟩ := hext d hd1
  haveI : Finite E := Module.finite_of_finite F
  letI : Fintype E := Fintype.ofFinite E
  have hcardE : Nat.card E = Nat.card F ^ d := by
    rw [Module.natCard_eq_pow_finrank (K := F), hE]
  obtain ⟨ι⟩ := FiniteField.nonempty_algHom_of_finrank_dvd (F := F) (K := E) (L := K)
    (by rw [hE, hK]; exact hdn)
  have hιinj : Function.Injective ι := ι.toRingHom.injective
  have hEpow : ∀ b : E, b ^ (Nat.card F ^ d) = b := by
    intro b
    rw [← hcardE, ← Fintype.card_eq_nat_card, FiniteField.pow_card]

  have hroot : ∀ a : K, a ^ (Nat.card F ^ d) = a → ∃ b : E, ι b = a := by
    intro a ha
    by_contra hne
    push_neg at hne
    have hm : 1 < Nat.card F ^ d := by rw [← hcardE]; exact Finite.one_lt_card
    have hP : (Polynomial.X ^ (Nat.card F ^ d) - Polynomial.X : Polynomial K) ≠ 0 :=
      FiniteField.X_pow_card_sub_X_ne_zero K hm
    have hPdeg : (Polynomial.X ^ (Nat.card F ^ d) - Polynomial.X : Polynomial K).natDegree
        = Nat.card F ^ d := FiniteField.X_pow_card_sub_X_natDegree_eq K hm
    have hZ : (Finset.univ.image ι).card = Nat.card F ^ d := by
      rw [Finset.card_image_of_injective _ hιinj, Finset.card_univ, Fintype.card_eq_nat_card,
        hcardE]
    have haZ : a ∉ Finset.univ.image ι := by
      intro h
      obtain ⟨b, -, hb⟩ := Finset.mem_image.mp h
      exact hne b hb
    have hsub : (insert a (Finset.univ.image ι)).val ⊆
        (Polynomial.X ^ (Nat.card F ^ d) - Polynomial.X : Polynomial K).roots := by
      intro c hc
      rw [Polynomial.mem_roots hP, Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow,
        Polynomial.eval_X, sub_eq_zero]
      have hc' : c ∈ insert a (Finset.univ.image ι) := hc
      rcases Finset.mem_insert.mp hc' with hca | hcZ
      · rw [hca]; exact ha
      · obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hcZ
        rw [← map_pow, hEpow]
    have hle := Polynomial.card_le_degree_of_subset_roots hsub
    rw [Finset.card_insert_of_notMem haZ, hZ, hPdeg] at hle
    omega
  let Φ : {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} →
      Function.fixedPoints ⇑(f ^ d) := fun x =>
    ⟨⟨fun i => ι (x.1 i), fun i => (map_ne_zero ι).mpr (x.2.1 i),
      by rw [← MvPolynomial.comp_aeval_apply x.1 ι g, x.2.2, map_zero]⟩, by
      show (f ^ d) _ = _
      apply Subtype.ext
      rw [hf d]
      funext i
      show ι (x.1 i) ^ (Nat.card F ^ d) = ι (x.1 i)
      rw [← map_pow, hEpow]⟩
  have hΦinj : Function.Injective Φ := by
    intro x y hxy
    apply Subtype.ext
    funext i
    have h := congrArg (fun z : Function.fixedPoints ⇑(f ^ d) => z.1.1 i) hxy
    exact hιinj h
  have hΦsurj : Function.Surjective Φ := by
    rintro ⟨y, hy⟩
    have hy' : ∀ i, y.1 i ^ (Nat.card F ^ d) = y.1 i := by
      intro i
      have h1 : (f ^ d) y = y := hy
      have h2 := congrArg (fun z : {x : σ → K // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} =>
        z.1 i) h1
      simp only [hf d] at h2
      exact h2
    have hex : ∀ i, ∃ b : E, ι b = y.1 i := fun i => hroot (y.1 i) (hy' i)
    choose b hb using hex
    have hb0 : ∀ i, b i ≠ 0 := by
      intro i h
      apply y.2.1 i
      rw [← hb i, h, map_zero]
    have hbg : MvPolynomial.aeval b g = 0 := by
      apply hιinj
      rw [MvPolynomial.comp_aeval_apply b ι g, map_zero]
      have hfun : (fun i => ι (b i)) = y.1 := funext hb
      rw [hfun]
      exact y.2.2
    refine ⟨⟨b, hb0, hbg⟩, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    funext i
    exact hb i
  have h4 := Nat.card_congr (Equiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩)
  have h5 := hN E
  rw [hE] at h5
  rw [← h4]
  exact h5

theorem zeta_coeffs_integral : ∀ (N : ℕ → ℤ) (M : ℕ), (∀ n, 1 ≤ n → 0 ≤ N n ∧ N n ≤ (M : ℤ) ^ n) → (∀ n : ℕ, 1 ≤ n → (n : ℤ) ∣ ∑ d ∈ n.divisors, (ArithmeticFunction.moebius (n / d) : ℤ) * N d) → ∃ z : ℕ → ℤ, z 0 = 1 ∧ (∀ k, |z k| ≤ (M : ℤ) ^ k) ∧ ∀ k : ℕ, (k : ℤ) * z k = ∑ j ∈ Finset.Icc 1 k, N j * z (k - j) :=
by
  intro N M hN hneck

  have s1 : ∃ a : ℕ → ℤ, ∀ n : ℕ, 1 ≤ n → N n = ∑ d ∈ n.divisors, (d : ℤ) * a d := by
    refine ⟨fun n => (∑ d ∈ n.divisors, (ArithmeticFunction.moebius (n / d) : ℤ) * N d) / n, ?_⟩
    have key := (ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq (R := ℤ)
      (f := fun d => (d : ℤ) * ((∑ e ∈ d.divisors, (ArithmeticFunction.moebius (d / e) : ℤ) * N e) / d))
      (g := N)).mpr
    intro n hn
    refine (key ?_ n hn).symm
    intro m hm
    simp only [Int.cast_id]
    rw [Nat.sum_divisorsAntidiagonal' (fun a b => (ArithmeticFunction.moebius a : ℤ) * N b)]
    exact (Int.mul_ediv_cancel' (hneck m hm)).symm

  have s7 : ∀ (z : ℕ → ℤ), z 0 = 1 →
      (∀ k : ℕ, (k : ℤ) * z k = ∑ j ∈ Finset.Icc 1 k, N j * z (k - j)) →
      ∀ k : ℕ, |z k| ≤ (M : ℤ) ^ k := by
    intro z h0 hrec
    have strong : ∀ k, 0 ≤ z k ∧ z k ≤ (M : ℤ) ^ k := by
      intro k
      induction k using Nat.strong_induction_on with
      | _ k ih =>
        rcases Nat.eq_zero_or_pos k with rfl | hk
        · simp [h0]
        · have hterm : ∀ j ∈ Finset.Icc 1 k, 0 ≤ N j * z (k - j) ∧ N j * z (k - j) ≤ (M : ℤ) ^ k := by
            intro j hj
            rw [Finset.mem_Icc] at hj
            obtain ⟨h1, h2⟩ := hN j hj.1
            obtain ⟨h3, h4⟩ := ih (k - j) (by omega)
            refine ⟨mul_nonneg h1 h3, ?_⟩
            calc N j * z (k - j) ≤ (M : ℤ) ^ j * (M : ℤ) ^ (k - j) :=
                  mul_le_mul h2 h4 h3 (by positivity)
              _ = (M : ℤ) ^ k := by rw [← pow_add]; congr 1; omega
          have hlo : 0 ≤ (k : ℤ) * z k := by
            rw [hrec k]; exact Finset.sum_nonneg (fun j hj => (hterm j hj).1)
          have hhi : (k : ℤ) * z k ≤ (k : ℤ) * (M : ℤ) ^ k := by
            rw [hrec k]
            calc ∑ j ∈ Finset.Icc 1 k, N j * z (k - j) ≤ ∑ j ∈ Finset.Icc 1 k, (M : ℤ) ^ k :=
                  Finset.sum_le_sum (fun j hj => (hterm j hj).2)
              _ = (k : ℤ) * (M : ℤ) ^ k := by simp
          have hkpos : (0 : ℤ) < k := by exact_mod_cast hk
          exact ⟨(mul_nonneg_iff_of_pos_left hkpos).mp hlo, le_of_mul_le_mul_left hhi hkpos⟩
    intro k
    obtain ⟨h1, h2⟩ := strong k
    rw [abs_le]
    exact ⟨by linarith [pow_nonneg (Nat.cast_nonneg M : (0 : ℤ) ≤ M) k], h2⟩

  have s6 : ∀ (c c' : ℕ → ℤ) (K : ℕ), c 0 = c' 0 →
      (∀ k : ℕ, 1 ≤ k → k ≤ K → (k : ℤ) * c k = ∑ j ∈ Finset.Icc 1 k, N j * c (k - j)) →
      (∀ k : ℕ, 1 ≤ k → k ≤ K → (k : ℤ) * c' k = ∑ j ∈ Finset.Icc 1 k, N j * c' (k - j)) →
      ∀ k : ℕ, k ≤ K → c k = c' k := by
    intro c c' K h0 h h' k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
      intro hk
      rcases Nat.eq_zero_or_pos k with rfl | hpos
      · exact h0
      · have e : (k : ℤ) * c k = (k : ℤ) * c' k := by
          rw [h k hpos hk, h' k hpos hk]
          refine Finset.sum_congr rfl (fun j hj => ?_)
          rw [Finset.mem_Icc] at hj
          rw [ih (k - j) (by omega) (by omega)]
        have hk0 : (k : ℤ) ≠ 0 := by exact_mod_cast hpos.ne'
        exact mul_left_cancel₀ hk0 e

  have s5 : ∀ (a : ℕ → ℤ) (K j : ℕ), 1 ≤ j → j ≤ K →
      ∑ d ∈ Finset.Icc 1 K, (if 0 < j ∧ d ∣ j then (d : ℤ) * a d else 0) =
        ∑ d ∈ j.divisors, (d : ℤ) * a d := by
    intro a K j hj hjK
    rw [← Finset.sum_filter]
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext d
    simp only [Finset.mem_filter, Finset.mem_Icc, Nat.mem_divisors]
    constructor
    · rintro ⟨_, _, h⟩; exact ⟨h, by omega⟩
    · rintro ⟨h, _⟩
      exact ⟨⟨Nat.pos_of_dvd_of_pos h (by omega), (Nat.le_of_dvd (by omega) h).trans hjK⟩, by omega, h⟩

  have s4 : ∀ (P L : PowerSeries ℤ) (K : ℕ),
      PowerSeries.X * PowerSeries.derivative P = L * P → PowerSeries.coeff 0 L = 0 →
      (∀ j : ℕ, 1 ≤ j → j ≤ K → PowerSeries.coeff j L = N j) →
      ∀ k : ℕ, k ≤ K → (k : ℤ) * PowerSeries.coeff k P =
        ∑ j ∈ Finset.Icc 1 k, N j * PowerSeries.coeff (k - j) P := by
    intro P L K h h0 hNL k hk
    have e := congrArg (PowerSeries.coeff k) h
    rw [PowerSeries.coeff_mul k L P, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => PowerSeries.coeff i L * PowerSeries.coeff j P), Finset.sum_range_succ', h0, zero_mul,
      add_zero] at e
    rcases k with _ | m
    · simp
    · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative] at e
      have hI : Finset.Icc 1 (m + 1) = Finset.Ico 1 (m + 1 + 1) := by
        ext x; simp only [Finset.mem_Icc, Finset.mem_Ico]; omega
      rw [hI, Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel, mul_comm]
      push_cast
      rw [e]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      rw [Finset.mem_range] at hi
      rw [add_comm 1 i, hNL (i + 1) (by omega) (by omega)]

  have s3 : ∀ (E L : ℕ → PowerSeries ℤ) (s : Finset ℕ),
      (∀ i ∈ s, PowerSeries.X * PowerSeries.derivative (E i) = L i * E i) →
      PowerSeries.X * PowerSeries.derivative (∏ i ∈ s, E i) = (∑ i ∈ s, L i) * ∏ i ∈ s, E i := by
    intro E L s
    induction s using Finset.induction_on with
    | empty => intro _; simp
    | @insert a s ha ih =>
      intro h
      rw [Finset.prod_insert ha, Finset.sum_insert ha, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      have h1 := h a (Finset.mem_insert_self a s)
      have h2 := ih (fun i hi => h i (Finset.mem_insert_of_mem hi))
      linear_combination (E a) * h2 + (∏ i ∈ s, E i) * h1

  have s2 : ∀ (d : ℕ) (c : ℤ), ∃ E : PowerSeries ℤ, PowerSeries.constantCoeff E = 1 ∧
      PowerSeries.X * PowerSeries.derivative E =
        PowerSeries.mk (fun n => if 0 < n ∧ d ∣ n then (d : ℤ) * c else 0) * E := by
    intro d c
    rcases Nat.eq_zero_or_pos d with rfl | hd
    · refine ⟨1, by simp, ?_⟩
      have : PowerSeries.mk (fun n => if 0 < n ∧ (0:ℕ) ∣ n then ((0:ℕ) : ℤ) * c else 0) = 0 := by
        ext n; simp
      rw [this, Derivation.map_one_eq_zero]; simp
    set G : PowerSeries ℤ := PowerSeries.mk (fun n => if d ∣ n then 1 else 0) with hGdef
    set S : PowerSeries ℤ := PowerSeries.X ^ d * G with hSdef
    set H : PowerSeries ℤ := 1 - PowerSeries.X ^ d with hHdef
    set Λ1 : PowerSeries ℤ := PowerSeries.C (d : ℤ) * S with hΛdef
    have hcS : ∀ n, PowerSeries.coeff n S = if 0 < n ∧ d ∣ n then 1 else 0 := by
      intro n
      rw [hSdef, PowerSeries.coeff_X_pow_mul']
      by_cases hdn : d ≤ n
      · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hdn
        rw [if_pos hdn, hGdef, PowerSeries.coeff_mk, Nat.add_sub_cancel_left]
        have h1 : 0 < d + m := by omega
        simp only [h1, true_and, Nat.dvd_add_self_left]
      · rw [if_neg hdn, if_neg]
        rintro ⟨h0, hdv⟩
        exact hdn (Nat.le_of_dvd h0 hdv)
    have hGH : G * H = 1 := by
      have : G * H = G - S := by rw [hHdef, hSdef]; ring
      rw [this]
      ext n
      rw [map_sub, hcS, hGdef, PowerSeries.coeff_mk, PowerSeries.coeff_one]
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · simp
      · have hn' : n ≠ 0 := by omega
        simp only [hn, true_and, hn', if_false]
        split_ifs <;> simp
    have hΛH : Λ1 * H = PowerSeries.C (d : ℤ) * PowerSeries.X ^ d := by
      have : Λ1 * H = PowerSeries.C (d : ℤ) * PowerSeries.X ^ d * (G * H) := by
        rw [hΛdef, hSdef]; ring
      rw [this, hGH, mul_one]
    have hXH : PowerSeries.X * PowerSeries.derivative H = -(Λ1 * H) := by
      rw [hΛH, hHdef, map_sub, Derivation.map_one_eq_zero, Derivation.leibniz_pow,
        PowerSeries.derivative_X, smul_eq_mul, mul_one, nsmul_eq_mul, map_natCast]
      obtain ⟨e, rfl⟩ : ∃ e, d = e + 1 := ⟨d - 1, by omega⟩
      rw [Nat.add_sub_cancel, pow_succ]
      ring
    have hXG : PowerSeries.X * PowerSeries.derivative G = Λ1 * G := by
      have hD : G * PowerSeries.derivative H + H * PowerSeries.derivative G = 0 := by
        have := congrArg PowerSeries.derivative hGH
        rw [Derivation.leibniz, Derivation.map_one_eq_zero, smul_eq_mul, smul_eq_mul] at this
        exact this
      linear_combination (Λ1 * G - PowerSeries.X * PowerSeries.derivative G) * hGH
        + (PowerSeries.X * G) * hD - (G * G) * hXH
    have hGpow : ∀ b : ℕ, PowerSeries.X * PowerSeries.derivative (G ^ b) =
        (b : PowerSeries ℤ) * Λ1 * G ^ b := by
      intro b
      induction b with
      | zero => simp
      | succ b ih =>
        rw [pow_succ, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        push_cast
        linear_combination G ^ b * hXG + G * ih
    have hHpow : ∀ b : ℕ, PowerSeries.X * PowerSeries.derivative (H ^ b) =
        -((b : PowerSeries ℤ) * Λ1 * H ^ b) := by
      intro b
      induction b with
      | zero => simp
      | succ b ih =>
        rw [pow_succ, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        push_cast
        linear_combination H ^ b * hXH + H * ih
    have hΛc : PowerSeries.mk (fun n => if 0 < n ∧ d ∣ n then (d : ℤ) * c else 0) =
        PowerSeries.C c * Λ1 := by
      ext n
      rw [PowerSeries.coeff_mk, PowerSeries.coeff_C_mul, hΛdef, PowerSeries.coeff_C_mul, hcS]
      split_ifs <;> ring
    have hG0 : PowerSeries.constantCoeff G = 1 := by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, hGdef, PowerSeries.coeff_mk]; simp
    have hH0 : PowerSeries.constantCoeff H = 1 := by
      rw [hHdef]; simp [hd.ne']
    obtain ⟨b, rfl | rfl⟩ := Int.eq_nat_or_neg c
    · refine ⟨G ^ b, by rw [map_pow, hG0, one_pow], ?_⟩
      rw [hGpow, hΛc, map_natCast]
    · refine ⟨H ^ b, by rw [map_pow, hH0, one_pow], ?_⟩
      rw [hHpow, hΛc, map_neg, map_natCast]
      ring

  obtain ⟨a, ha⟩ := s1
  choose E hE0 hE using fun d => s2 d (a d)
  let Λ : ℕ → PowerSeries ℤ := fun d =>
    PowerSeries.mk (fun n => if 0 < n ∧ d ∣ n then (d : ℤ) * a d else 0)
  let P : ℕ → PowerSeries ℤ := fun K => ∏ d ∈ Finset.Icc 1 K, E d
  let L : ℕ → PowerSeries ℤ := fun K => ∑ d ∈ Finset.Icc 1 K, Λ d
  have hPL : ∀ K, PowerSeries.X * PowerSeries.derivative (P K) = L K * P K :=
    fun K => s3 E Λ (Finset.Icc 1 K) (fun i _ => hE i)
  have hP0 : ∀ K, PowerSeries.coeff 0 (P K) = 1 := by
    intro K
    rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, map_prod]
    simp [hE0]
  have hL0 : ∀ K, PowerSeries.coeff 0 (L K) = 0 := by
    intro K
    simp [L, Λ, map_sum]
  have hLj : ∀ K j, 1 ≤ j → j ≤ K → PowerSeries.coeff j (L K) = N j := by
    intro K j hj hjK
    simp only [L, Λ, map_sum, PowerSeries.coeff_mk]
    rw [s5 a K j hj hjK, ha j hj]
  have star : ∀ K k : ℕ, k ≤ K → (k : ℤ) * PowerSeries.coeff k (P K) =
      ∑ j ∈ Finset.Icc 1 k, N j * PowerSeries.coeff (k - j) (P K) :=
    fun K => s4 (P K) (L K) K (hPL K) (hL0 K) (hLj K)
  have cons : ∀ i k, i ≤ k → PowerSeries.coeff i (P i) = PowerSeries.coeff i (P k) := by
    intro i k hik
    exact s6 (fun t => PowerSeries.coeff t (P i)) (fun t => PowerSeries.coeff t (P k)) i
      (by simp only [hP0]) (fun t _ h2 => star i t h2) (fun t _ h2 => star k t (h2.trans hik)) i le_rfl
  have hrec : ∀ k : ℕ, (k : ℤ) * PowerSeries.coeff k (P k) =
      ∑ j ∈ Finset.Icc 1 k, N j * PowerSeries.coeff (k - j) (P (k - j)) := by
    intro k
    rw [star k k le_rfl]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [cons (k - j) k (Nat.sub_le k j)]
  have hz0 : PowerSeries.coeff 0 (P 0) = 1 := hP0 0
  exact ⟨fun k => PowerSeries.coeff k (P k), hz0,
    s7 (fun k => PowerSeries.coeff k (P k)) hz0 hrec, hrec⟩

theorem torus_count_character_sum : ∀ (F : Type u) [Field F] (σ : Type) [Fintype σ] (g : MvPolynomial σ F) (p : ℕ) [Fact p.Prime] (K : Type) [Field K] (ζ : K), ζ ^ p = 1 → ζ ≠ 1 → ∀ (E : Type u) [Field E] [Finite E] [Algebra F E] [Algebra (ZMod p) E], (Nat.card E : K) * (Nat.card {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : K) = ((Nat.card E : K) - 1) ^ Fintype.card σ + ∑ᶠ y : {y : Option σ → E // ∀ i, y i ≠ 0}, ζ ^ (Algebra.trace (ZMod p) E (MvPolynomial.aeval y.1 (MvPolynomial.X none * MvPolynomial.rename some g))).val :=
by
  intro F _ σ _ g p _ K _ ζ hζp hζ1 E _ _ _ _
  classical
  haveI : Fintype E := Fintype.ofFinite E
  let ψ : AddChar E K := (AddChar.zmodChar p hζp).compAddMonoidHom
    (Algebra.trace (ZMod p) E).toAddMonoidHom
  have hψ : ∀ a : E, ψ a = ζ ^ (Algebra.trace (ZMod p) E a).val := fun a => rfl
  have hψ1 : ψ ≠ 1 := by
    obtain ⟨a, ha⟩ := Algebra.trace_surjective (ZMod p) E 1
    rw [AddChar.ne_one_iff]
    refine ⟨a, ?_⟩
    rw [hψ, ha, ZMod.val_one, pow_one]
    exact hζ1
  have hprim : ψ.IsPrimitive := AddChar.IsPrimitive.of_ne_one hψ1
  have hsplit : ∀ f : E → K, ∑ t, f t = f 0 + ∑ t : {t : E // t ≠ 0}, f t :=
    fun f => Fintype.sum_eq_add_sum_subtype_ne f 0
  have hq : (Nat.card E : K) = ∑ _t : E, (1 : K) := by
    simp [Nat.card_eq_fintype_card]
  have hU : (Nat.card {t : E // t ≠ 0} : K) = (Nat.card E : K) - 1 := by
    rw [hq, hsplit, Nat.card_eq_fintype_card]
    simp
  have horth : ∀ c : E, ∑ t : {t : E // t ≠ 0}, ψ (t.1 * c) =
      (if c = 0 then (Nat.card E : K) else 0) - 1 := by
    intro c
    have h1 := AddChar.sum_mulShift c hprim
    rw [hsplit] at h1
    simp only [zero_mul, AddChar.map_zero_eq_one] at h1
    rw [Nat.card_eq_fintype_card]
    by_cases hc : c = 0
    · simp only [hc, if_true] at h1 ⊢
      linear_combination h1
    · simp only [hc, if_false] at h1 ⊢
      linear_combination h1
  have hT : (Nat.card {x : σ → E // ∀ i, x i ≠ 0} : K) =
      ((Nat.card E : K) - 1) ^ Fintype.card σ := by
    rw [Nat.card_congr (Equiv.subtypePiEquivPi (β := fun _ : σ => E) (p := fun _ b => b ≠ 0)),
      Nat.card_pi, Finset.prod_const,
      Finset.card_univ]
    push_cast
    rw [hU]
  let e : {x : σ → E // ∀ i, x i ≠ 0} × {t : E // t ≠ 0} ≃
      {y : Option σ → E // ∀ i, y i ≠ 0} :=
    { toFun := fun z => ⟨fun o => Option.elim o z.2.1 z.1.1, by
        rintro (_|i)
        exacts [z.2.2, z.1.2 i]⟩
      invFun := fun y => (⟨fun i => y.1 (some i), fun i => y.2 (some i)⟩, ⟨y.1 none, y.2 none⟩)
      left_inv := by rintro ⟨x, t⟩; rfl
      right_inv := by
        rintro ⟨y, hy⟩
        apply Subtype.ext
        funext o
        cases o <;> rfl }
  have hG : ∀ z, MvPolynomial.aeval (e z).1 (MvPolynomial.X none * MvPolynomial.rename some g)
      = z.2.1 * MvPolynomial.aeval z.1.1 g := by
    rintro ⟨x, t⟩
    rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_rename]
    rfl
  have hre : ∑ y : {y : Option σ → E // ∀ i, y i ≠ 0}, ζ ^ (Algebra.trace (ZMod p) E
      (MvPolynomial.aeval y.1 (MvPolynomial.X none * MvPolynomial.rename some g))).val =
      ∑ z : {x : σ → E // ∀ i, x i ≠ 0} × {t : E // t ≠ 0},
        ψ (z.2.1 * MvPolynomial.aeval z.1.1 g) :=
    (Fintype.sum_equiv e _ _ (fun z => by rw [hG]; rfl)).symm
  rw [finsum_eq_sum_of_fintype, hre, Fintype.sum_prod_type]
  simp only [horth]
  rw [Finset.sum_sub_distrib, Finset.sum_ite, Finset.sum_const_zero, add_zero,
    Finset.sum_const, Finset.sum_const, nsmul_eq_mul, nsmul_eq_mul, mul_one,
    Finset.card_univ, ← Fintype.card_subtype]
  simp only [Fintype.card_eq_nat_card] at hT ⊢
  rw [hT, Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter
      (fun x : σ → E => ∀ i, x i ≠ 0) (fun x => MvPolynomial.aeval x g = 0))]
  ring

theorem artin_hasse_integral : ∀ (p : ℕ) [Fact p.Prime], dwAH p :=
by
  intro p hpF
  classical
  unfold dwAH
  have hpp : p.Prime := hpF.out
  have hp0 : p ≠ 0 := hpp.ne_zero
  have hp2 : 2 ≤ p := hpp.two_le
  have hpQ : (0 : ℚ) < p := by exact_mod_cast hpp.pos
  intro e he0 hrec

  have hXD : ∀ (W : PowerSeries ℚ) (n : ℕ),
      PowerSeries.coeff n (PowerSeries.X * PowerSeries.derivative W) =
        (n : ℚ) * PowerSeries.coeff n W := by
    intro W n
    rcases n with _ | m
    · simp [PowerSeries.coeff_zero_X_mul]
    · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative]
      push_cast; ring

  have huniq : ∀ (U V ℓ : PowerSeries ℚ), PowerSeries.constantCoeff ℓ = 0 →
      PowerSeries.constantCoeff U = PowerSeries.constantCoeff V →
      PowerSeries.X * PowerSeries.derivative U = ℓ * U →
      PowerSeries.X * PowerSeries.derivative V = ℓ * V → U = V := by
    intro U V ℓ hℓ hUV hU hV
    ext n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [PowerSeries.coeff_zero_eq_constantCoeff_apply,
          PowerSeries.coeff_zero_eq_constantCoeff_apply, hUV]
      · have h1 := congrArg (PowerSeries.coeff n) hU
        have h2 := congrArg (PowerSeries.coeff n) hV
        rw [hXD, PowerSeries.coeff_mul] at h1 h2
        have h3 : ∑ x ∈ Finset.HasAntidiagonal.antidiagonal n,
              PowerSeries.coeff x.1 ℓ * PowerSeries.coeff x.2 U
            = ∑ x ∈ Finset.HasAntidiagonal.antidiagonal n,
              PowerSeries.coeff x.1 ℓ * PowerSeries.coeff x.2 V := by
          refine Finset.sum_congr rfl (fun x hx => ?_)
          have hx : x.1 + x.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
          rcases Nat.eq_zero_or_pos x.1 with h0 | h0
          · rw [h0, PowerSeries.coeff_zero_eq_constantCoeff_apply, hℓ, zero_mul, zero_mul]
          · rw [ih x.2 (by omega)]
        have hn' : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
        exact mul_left_cancel₀ hn' (h1.trans (h3.trans h2.symm))

  obtain ⟨L, hLdef⟩ : ∃ L : PowerSeries ℚ,
      L = PowerSeries.mk (fun m => if ∃ i, p ^ i = m then (1 : ℚ) else 0) := ⟨_, rfl⟩
  obtain ⟨g, hgdef⟩ : ∃ g : PowerSeries ℚ,
      g = PowerSeries.mk (fun k => (-(p : ℚ)) ^ k / (k.factorial : ℚ)) := ⟨_, rfl⟩
  obtain ⟨E, hEdef⟩ : ∃ E : PowerSeries ℚ, E = PowerSeries.mk e := ⟨_, rfl⟩
  have hL0 : PowerSeries.coeff 0 L = 0 := by
    rw [hLdef, PowerSeries.coeff_mk, if_neg]
    rintro ⟨i, hi⟩
    exact pow_ne_zero i hp0 hi
  have hL0c : PowerSeries.constantCoeff L = 0 := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, hL0]

  have hLE : PowerSeries.X * PowerSeries.derivative E = L * E := by
    ext k
    rw [hXD, PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · simp [hL0, hL0c]
    · rw [hEdef, PowerSeries.coeff_mk, hrec k hk]
      simp only [hLdef, PowerSeries.coeff_mk, ite_mul, one_mul, zero_mul, Nat.succ_eq_add_one]
      rw [← Finset.sum_filter]
      have hS : (Finset.range (k + 1)).filter (fun a => ∃ i, p ^ i = a) =
          ((Finset.range (k + 1)).filter (fun i => p ^ i ≤ k)).image (fun i => p ^ i) := by
        ext a
        simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_image]
        constructor
        · rintro ⟨ha, i, rfl⟩
          refine ⟨i, ⟨?_, by omega⟩, rfl⟩
          have := Nat.lt_pow_self (n := i) (by omega : 1 < p)
          omega
        · rintro ⟨i, ⟨_, hi2⟩, rfl⟩
          exact ⟨by omega, i, rfl⟩
      rw [hS, Finset.sum_image (fun i _ j _ hij => Nat.pow_right_injective hp2 hij)]

  have hexpL : PowerSeries.expand p hp0 L = L - PowerSeries.X := by
    ext n
    rw [PowerSeries.coeff_expand, map_sub, PowerSeries.coeff_X, hLdef, PowerSeries.coeff_mk,
      PowerSeries.coeff_mk]
    by_cases hn1 : n = 1
    · subst hn1
      have h1 : ¬ p ∣ 1 := fun h => hpp.one_lt.ne' (Nat.dvd_one.mp h)
      rw [if_neg h1, if_pos (show ∃ i, p ^ i = 1 from ⟨0, pow_zero p⟩), if_pos rfl]
      simp
    · rw [if_neg hn1, sub_zero]
      by_cases hpow : ∃ i, p ^ i = n
      · obtain ⟨i, rfl⟩ := hpow
        have hi : i ≠ 0 := by rintro rfl; exact hn1 (pow_zero p)
        obtain ⟨j, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hi
        have h1 : ∃ k, p ^ k = p ^ (j + 1) / p :=
          ⟨j, by rw [pow_succ, Nat.mul_div_cancel _ hpp.pos]⟩
        rw [if_pos (dvd_pow_self p hi), if_pos h1,
          if_pos (show ∃ i, p ^ i = p ^ (j + 1) from ⟨j + 1, rfl⟩)]
      · rw [if_neg hpow]
        split_ifs with hd hq
        · exfalso
          obtain ⟨j, hj⟩ := hq
          exact hpow ⟨j + 1, by rw [pow_succ, hj, Nat.div_mul_cancel hd]⟩
        all_goals rfl

  have hXDexp : ∀ φ : PowerSeries ℚ,
      PowerSeries.X * PowerSeries.derivative (PowerSeries.expand p hp0 φ) =
        (p : PowerSeries ℚ) * PowerSeries.expand p hp0 (PowerSeries.X * PowerSeries.derivative φ) := by
    intro φ
    ext n
    rw [hXD, ← map_natCast (PowerSeries.C (R := ℚ)) p, PowerSeries.coeff_C_mul,
      PowerSeries.coeff_expand, PowerSeries.coeff_expand]
    split_ifs with hd
    · rw [hXD]
      obtain ⟨m, rfl⟩ := hd
      rw [Nat.mul_div_cancel_left m hpp.pos]
      push_cast; ring
    · simp
  have hU : PowerSeries.X * PowerSeries.derivative (PowerSeries.expand p hp0 E) =
      ((p : PowerSeries ℚ) * (L - PowerSeries.X)) * PowerSeries.expand p hp0 E := by
    rw [hXDexp, hLE, map_mul, hexpL]; ring

  have hgd : PowerSeries.X * PowerSeries.derivative g = -((p : PowerSeries ℚ) * PowerSeries.X) * g := by
    ext n
    rw [hXD]
    rcases n with _ | m
    · simp
    · rw [neg_mul, map_neg, mul_assoc, ← map_natCast (PowerSeries.C (R := ℚ)) p,
        PowerSeries.coeff_C_mul, PowerSeries.coeff_succ_X_mul, hgdef, PowerSeries.coeff_mk,
        PowerSeries.coeff_mk, Nat.factorial_succ]
      have hf : (m.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero m
      push_cast
      field_simp
      ring
  have hV : PowerSeries.X * PowerSeries.derivative (E ^ p * g) =
      ((p : PowerSeries ℚ) * (L - PowerSeries.X)) * (E ^ p * g) := by
    have hD : PowerSeries.derivative (E ^ p * g) = E ^ p * PowerSeries.derivative g +
        (p : PowerSeries ℚ) * E ^ (p - 1) * PowerSeries.derivative E * g := by
      simp only [Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul]
      ring
    have e1 : E ^ (p - 1) * E = E ^ p := by
      rw [← pow_succ, Nat.sub_add_cancel hpp.one_le]
    rw [hD]
    linear_combination (E ^ p) * hgd + ((p : PowerSeries ℚ) * E ^ (p - 1) * g) * hLE +
      ((p : PowerSeries ℚ) * L * g) * e1
  have hE0 : PowerSeries.constantCoeff E = 1 := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, hEdef, PowerSeries.coeff_mk, he0]
  have hg0 : PowerSeries.constantCoeff g = 1 := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, hgdef, PowerSeries.coeff_mk]; simp

  have hEq : PowerSeries.expand p hp0 E = E ^ p * g := by
    refine huniq _ _ ((p : PowerSeries ℚ) * (L - PowerSeries.X)) ?_ ?_ hU hV
    · rw [map_mul, map_sub, PowerSeries.constantCoeff_X, hL0c, sub_zero, mul_zero]
    · rw [map_mul, map_pow, hE0, hg0, one_pow, mul_one,
        ← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_expand,
        if_pos (dvd_zero p), Nat.zero_div, PowerSeries.coeff_zero_eq_constantCoeff_apply, hE0]

  have hgs : ∀ k, 1 ≤ k → padicNorm p (PowerSeries.coeff k g) ≤ (p : ℚ)⁻¹ := by
    intro k hk
    rw [hgdef, PowerSeries.coeff_mk]
    have hpq : (p : ℚ) ≠ 0 := by exact_mod_cast hp0
    have hnum : (-(p : ℚ)) ^ k ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr hpq)
    have hden : (k.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
    rw [padicNorm.eq_zpow_of_nonzero (div_ne_zero hnum hden), padicValRat.div hnum hden,
      padicValRat.pow, padicValRat.neg, padicValRat.self hpp.one_lt, padicValRat.of_nat]
    have hv := padicValNat_factorial_lt_of_ne_zero p (show k ≠ 0 by omega)
    rw [← zpow_neg_one]
    apply zpow_le_zpow_right₀ (by exact_mod_cast hpp.one_le)
    omega

  have hFrob : ∀ P : Polynomial ℚ, (∀ j, padicNorm p (P.coeff j) ≤ 1) →
      ∀ j, padicNorm p ((P ^ p - Polynomial.expand ℚ p P).coeff j) ≤ (p : ℚ)⁻¹ := by
    intro P hP j
    have hlift : P.map (Rat.castHom ℚ_[p]) ∈ Polynomial.lifts (PadicInt.Coe.ringHom (p := p)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      refine ⟨⟨(P.coeff n : ℚ_[p]), ?_⟩, rfl⟩
      rw [Padic.eq_padicNorm]
      exact_mod_cast hP n
    obtain ⟨Q, hQ⟩ := (Polynomial.mem_lifts _).mp hlift
    obtain ⟨D, hD⟩ : ∃ D, D = Q ^ p - Polynomial.expand ℤ_[p] p Q := ⟨_, rfl⟩
    have hDz : D.map PadicInt.toZMod = 0 := by
      rw [hD, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_expand, ZMod.expand_card,
        sub_self]
    have hcoef : ((P ^ p - Polynomial.expand ℚ p P).coeff j : ℚ_[p]) = ((D.coeff j : ℤ_[p]) : ℚ_[p]) := by
      have hmap : (P ^ p - Polynomial.expand ℚ p P).map (Rat.castHom ℚ_[p]) =
          D.map (PadicInt.Coe.ringHom (p := p)) := by
        rw [hD, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_expand, Polynomial.map_sub,
          Polynomial.map_pow, Polynomial.map_expand, hQ]
      have := congrArg (fun R => R.coeff j) hmap
      simp only [Polynomial.coeff_map] at this
      exact this
    have hmem : D.coeff j ∈ IsLocalRing.maximalIdeal ℤ_[p] := by
      rw [← PadicInt.ker_toZMod, RingHom.mem_ker, ← Polynomial.coeff_map, hDz, Polynomial.coeff_zero]
    have hlt : ‖D.coeff j‖ < 1 :=
      PadicInt.mem_nonunits.mp ((IsLocalRing.mem_maximalIdeal _).mp hmem)
    have hle : ‖D.coeff j‖ ≤ (p : ℝ) ^ (-1 : ℤ) := by
      rw [PadicInt.norm_le_pow_iff_norm_lt_pow_add_one]; simpa using hlt
    have key : ((padicNorm p ((P ^ p - Polynomial.expand ℚ p P).coeff j) : ℚ) : ℝ) ≤
        (((p : ℚ)⁻¹ : ℚ) : ℝ) := by
      rw [← Padic.eq_padicNorm, hcoef, ← PadicInt.norm_def]
      push_cast
      simpa using hle
    exact_mod_cast key

  have hE_int : ∀ n, padicNorm p (PowerSeries.coeff n E) ≤ 1 := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, hE0]; simp
    obtain ⟨P, hPdef⟩ : ∃ P : Polynomial ℚ, P = PowerSeries.trunc n E := ⟨_, rfl⟩
    have hPc : ∀ j, padicNorm p (P.coeff j) ≤ 1 := by
      intro j
      rw [hPdef, PowerSeries.coeff_trunc]
      split_ifs with hj
      · exact ih j hj
      · simp
    have hP0 : PowerSeries.constantCoeff (P : PowerSeries ℚ) = 1 := by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, Polynomial.coeff_coe, hPdef,
        PowerSeries.coeff_trunc, if_pos hn, PowerSeries.coeff_zero_eq_constantCoeff_apply, hE0]
    have hdvd : PowerSeries.X ^ n ∣ E - (P : PowerSeries ℚ) := by
      rw [PowerSeries.X_pow_dvd_iff]
      intro m hm
      rw [map_sub, Polynomial.coeff_coe, hPdef, PowerSeries.coeff_trunc, if_pos hm, sub_self]
    obtain ⟨h, hh⟩ := hdvd
    have hh0 : PowerSeries.coeff 0 h = PowerSeries.coeff n E := by
      have := congrArg (PowerSeries.coeff n) hh
      rw [map_sub, Polynomial.coeff_coe, hPdef, PowerSeries.coeff_trunc, if_neg (lt_irrefl n),
        sub_zero, PowerSeries.coeff_X_pow_mul', if_pos le_rfl, Nat.sub_self] at this
      exact this.symm
    obtain ⟨R, hRdef⟩ : ∃ R : PowerSeries ℚ,
        R = ∑ i ∈ Finset.range p, E ^ i * (P : PowerSeries ℚ) ^ (p - 1 - i) := ⟨_, rfl⟩
    have hgeom : E ^ p - (P : PowerSeries ℚ) ^ p = PowerSeries.X ^ n * (h * R) := by
      rw [← geom_sum₂_mul, hh, ← hRdef]; ring
    have hR0 : PowerSeries.constantCoeff R = p := by
      rw [hRdef, map_sum]
      simp only [map_mul, map_pow, hE0, hP0, one_pow, mul_one, Finset.sum_const,
        Finset.card_range, nsmul_eq_mul]
    have hcoefP : ∀ j, PowerSeries.coeff j (E ^ p) = PowerSeries.coeff j ((P : PowerSeries ℚ) ^ p) +
        (if n ≤ j then PowerSeries.coeff (j - n) (h * R) else 0) := by
      intro j
      rw [← PowerSeries.coeff_X_pow_mul', ← hgeom, map_sub]; ring
    have hn_coef : PowerSeries.coeff n (E ^ p) =
        PowerSeries.coeff n ((P : PowerSeries ℚ) ^ p) + p * PowerSeries.coeff n E := by
      rw [hcoefP, if_pos (le_refl n), Nat.sub_self, PowerSeries.coeff_zero_eq_constantCoeff_apply,
        map_mul, hR0, ← PowerSeries.coeff_zero_eq_constantCoeff_apply, hh0]; ring
    have hlt_coef : ∀ j < n, PowerSeries.coeff j (E ^ p) =
        PowerSeries.coeff j ((P : PowerSeries ℚ) ^ p) := by
      intro j hj
      rw [hcoefP, if_neg (by omega), add_zero]
    have hpinv1 : (p : ℚ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast hpp.one_le)
    have hexpc : ∀ j, padicNorm p ((Polynomial.expand ℚ p P).coeff j) ≤ 1 := by
      intro j
      rw [Polynomial.coeff_expand hpp.pos]
      split_ifs
      · exact hPc _
      · simp
    have hPpc : ∀ j, padicNorm p ((P ^ p).coeff j) ≤ 1 := by
      intro j
      have hsplit : (P ^ p).coeff j = (P ^ p - Polynomial.expand ℚ p P).coeff j +
          (Polynomial.expand ℚ p P).coeff j := by
        rw [Polynomial.coeff_sub]; ring
      rw [hsplit]
      exact padicNorm.nonarchimedean.trans (max_le ((hFrob P hPc j).trans hpinv1) (hexpc j))
    have hcoeP : ∀ j, PowerSeries.coeff j ((P : PowerSeries ℚ) ^ p) = (P ^ p).coeff j := by
      intro j; rw [← Polynomial.coe_pow, Polynomial.coeff_coe]
    have hexpE : PowerSeries.coeff n (PowerSeries.expand p hp0 E) =
        (Polynomial.expand ℚ p P).coeff n := by
      rw [PowerSeries.coeff_expand, Polynomial.coeff_expand hpp.pos]
      split_ifs
      · rw [hPdef, PowerSeries.coeff_trunc, if_pos (Nat.div_lt_self hn hpp.one_lt)]
      · rfl
    have hsum : ∑ x ∈ Finset.range n, PowerSeries.coeff x (E ^ p) * PowerSeries.coeff (n - x) g =
        ∑ x ∈ Finset.range n, (P ^ p).coeff x * PowerSeries.coeff (n - x) g := by
      refine Finset.sum_congr rfl (fun x hx => ?_)
      rw [hlt_coef x (Finset.mem_range.mp hx), hcoeP]
    have hkey := congrArg (PowerSeries.coeff n) hEq
    rw [hexpE, PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk] at hkey
    dsimp only [Nat.succ_eq_add_one] at hkey
    rw [Finset.sum_range_succ, Nat.sub_self,
      PowerSeries.coeff_zero_eq_constantCoeff_apply g, hg0, mul_one, hn_coef, hsum, hcoeP] at hkey
    have hpc : (p : ℚ) * PowerSeries.coeff n E =
        -((P ^ p - Polynomial.expand ℚ p P).coeff n) -
          ∑ x ∈ Finset.range n, (P ^ p).coeff x * PowerSeries.coeff (n - x) g := by
      rw [Polynomial.coeff_sub]
      linarith
    have hbound : padicNorm p ((p : ℚ) * PowerSeries.coeff n E) ≤ (p : ℚ)⁻¹ := by
      rw [hpc]
      refine padicNorm.sub.trans (max_le ?_ ?_)
      · rw [padicNorm.neg]; exact hFrob P hPc n
      · apply padicNorm.sum_le' _ (inv_nonneg.mpr hpQ.le)
        intro x hx
        rw [padicNorm.mul]
        have hx' := Finset.mem_range.mp hx
        calc padicNorm p ((P ^ p).coeff x) * padicNorm p (PowerSeries.coeff (n - x) g)
            ≤ 1 * (p : ℚ)⁻¹ :=
              mul_le_mul (hPpc x) (hgs _ (by omega)) (padicNorm.nonneg _) zero_le_one
          _ = (p : ℚ)⁻¹ := one_mul _
    rw [padicNorm.mul, padicNorm.padicNorm_p_of_prime] at hbound
    have hpi : (0 : ℚ) < (p : ℚ)⁻¹ := inv_pos.mpr hpQ
    exact le_of_mul_le_mul_left (by rw [mul_one]; exact hbound) hpi
  intro k
  have := hE_int k
  rwa [hEdef, PowerSeries.coeff_mk] at this

theorem dwork_exp_coeff_bounds : ∀ (p : ℕ) [Fact p.Prime], dwAH p → dwCBounds p :=
by

  have t_small : ∀ (q : ℕ) [hq : Fact q.Prime] (k : ℕ), 2 ≤ k → (q - 1) ^ 2 * k ≤ q ^ 2 →
      (padicNorm q (dwCDw q k) : ℝ) < (q : ℝ) ^ (((k : ℝ) - 1) / ((q : ℝ) - 1)) := by
    intro p hp k hk hle
    have hp2 := hp.out.two_le
    have hp3 : p ≤ 3 := by
      by_contra h
      push_neg at h
      have : 2 * (p - 1) ^ 2 ≤ (p - 1) ^ 2 * k := by rw [mul_comm]; exact Nat.mul_le_mul_left _ hk
      obtain ⟨q, rfl⟩ : ∃ q, p = q + 4 := ⟨p - 4, by omega⟩
      have hq3 : q + 4 - 1 = q + 3 := by omega
      rw [hq3] at this hle
      nlinarith
    interval_cases p
    · have hk4 : k ≤ 4 := by simpa using hle
      interval_cases k
      · have : dwCDw 2 2 = 1 := by simp [dwCDw, Finset.sum_range_succ]; norm_num
        rw [this, padicNorm.one]; norm_num
      · have : dwCDw 2 3 = 2 / 3 := by simp [dwCDw, Finset.sum_range_succ]; norm_num
        have hn : padicNorm 2 (2 / 3 : ℚ) = 1 / 2 := by
          rw [padicNorm.div]
          have h3 : padicNorm 2 ((3 : ℕ) : ℚ) = 1 := (padicNorm.nat_eq_one_iff 3).mpr (by norm_num)
          have h2 : padicNorm 2 ((2 : ℕ) : ℚ) = 1 / 2 := by
            rw [padicNorm.padicNorm_p_of_prime]; norm_num
          push_cast at h2 h3
          rw [h2, h3]; norm_num
        rw [this, hn]; norm_num
      · have : dwCDw 2 4 = 5 / 12 := by simp [dwCDw, Finset.sum_range_succ]; norm_num
        have hn : padicNorm 2 (5 / 12 : ℚ) = 4 := by
          rw [padicNorm.div]
          have h5 : padicNorm 2 ((5 : ℕ) : ℚ) = 1 := (padicNorm.nat_eq_one_iff 5).mpr (by norm_num)
          have h3 : padicNorm 2 ((3 : ℕ) : ℚ) = 1 := (padicNorm.nat_eq_one_iff 3).mpr (by norm_num)
          have h2 : padicNorm 2 ((2 : ℕ) : ℚ) = 1 / 2 := by
            rw [padicNorm.padicNorm_p_of_prime]; norm_num
          push_cast at h2 h3 h5
          have h12 : (12 : ℚ) = 2 * 2 * 3 := by norm_num
          rw [h12, padicNorm.mul, padicNorm.mul, h2, h3, h5]; norm_num
        rw [this, hn]; norm_num
    · have hk2 : k = 2 := by simp at hle; omega
      subst hk2
      have : dwCDw 3 2 = 1 / 2 := by simp [dwCDw]
      have hn : padicNorm 3 (1 / 2 : ℚ) = 1 := by
        rw [padicNorm.div, padicNorm.one]
        have h2 : padicNorm 3 ((2 : ℕ) : ℚ) = 1 := (padicNorm.nat_eq_one_iff 2).mpr (by norm_num)
        push_cast at h2
        rw [h2]; norm_num
      rw [this, hn]
      push_cast
      exact Real.one_lt_rpow (by norm_num) (by norm_num)

  have t_hXd : ∀ (U : PowerSeries ℚ) (j : ℕ),
      PowerSeries.coeff j (PowerSeries.X * PowerSeries.derivative U) =
        (j : ℚ) * PowerSeries.coeff j U := by
    intro U j
    rcases j with _ | j
    · simp [PowerSeries.coeff_zero_X_mul]
    · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative]; push_cast; ring

  have t_leib : ∀ U V : PowerSeries ℚ,
      PowerSeries.X * PowerSeries.derivative (U * V) =
        U * (PowerSeries.X * PowerSeries.derivative V) +
          V * (PowerSeries.X * PowerSeries.derivative U) := by
    intro U V
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]; ring

  have t_uniq : ∀ (U V L : PowerSeries ℚ) (K : ℕ), PowerSeries.constantCoeff U = 1 →
      PowerSeries.constantCoeff V = 1 →
      (∀ j, j ≤ K → PowerSeries.coeff j (PowerSeries.X * PowerSeries.derivative U) =
        PowerSeries.coeff j (L * U)) →
      (∀ j, j ≤ K → PowerSeries.coeff j (PowerSeries.X * PowerSeries.derivative V) =
        PowerSeries.coeff j (L * V)) →
      ∀ k, k ≤ K → PowerSeries.coeff k U = PowerSeries.coeff k V := by
    intro U V L K hU0 hV0 hU hV
    have hL0 : PowerSeries.coeff 0 L = 0 := by
      have h := hU 0 (Nat.zero_le _)
      rw [PowerSeries.coeff_zero_X_mul, PowerSeries.coeff_mul, Finset.Nat.antidiagonal_zero,
        Finset.sum_singleton, PowerSeries.coeff_zero_eq_constantCoeff_apply (φ := U), hU0] at h
      simpa using h.symm
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
      intro hk
      rcases Nat.eq_zero_or_pos k with rfl | hpos
      · rw [PowerSeries.coeff_zero_eq_constantCoeff_apply,
          PowerSeries.coeff_zero_eq_constantCoeff_apply, hU0, hV0]
      · have h1 := hU k hk
        have h2 := hV k hk
        rw [t_hXd, PowerSeries.coeff_mul] at h1 h2
        have hs : ∑ x ∈ Finset.HasAntidiagonal.antidiagonal k,
              PowerSeries.coeff x.1 L * PowerSeries.coeff x.2 U =
            ∑ x ∈ Finset.HasAntidiagonal.antidiagonal k,
              PowerSeries.coeff x.1 L * PowerSeries.coeff x.2 V := by
          refine Finset.sum_congr rfl (fun x hx => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
          rcases Nat.eq_zero_or_pos x.1 with h0 | h0
          · rw [h0, hL0, zero_mul, zero_mul]
          · rw [ih x.2 (by omega) (by omega)]
        have hk0 : (k : ℚ) ≠ 0 := by exact_mod_cast hpos.ne'
        exact mul_left_cancel₀ hk0 (h1.trans (hs.trans h2.symm))

  have t_exp0 : ∀ (s : ℚ) (d : ℕ), PowerSeries.constantCoeff (dwbExpS s d) = 1 := by
    intro s d; simp [dwbExpS]
  have t_exp : ∀ (s : ℚ) (d : ℕ), 1 ≤ d →
      PowerSeries.X * PowerSeries.derivative (dwbExpS s d) =
        PowerSeries.C ((d : ℚ) * s) * (PowerSeries.X ^ d * dwbExpS s d) := by
    intro s d hd
    ext m
    rw [t_hXd, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow_mul']
    simp only [dwbExpS, PowerSeries.coeff_mk]
    by_cases hdm : d ∣ m
    · obtain ⟨n, rfl⟩ := hdm
      rcases n with _ | n
      · have : ¬ d ≤ d * 0 := by omega
        rw [if_neg this]; simp
      · have hle : d ≤ d * (n + 1) := Nat.le_mul_of_pos_right d (Nat.succ_pos n)
        have hsub : d * (n + 1) - d = d * n := by rw [Nat.mul_succ]; omega
        rw [if_pos (dvd_mul_right d _), if_pos hle, hsub, if_pos (dvd_mul_right d _),
          Nat.mul_div_cancel_left _ (by omega), Nat.mul_div_cancel_left _ (by omega),
          Nat.factorial_succ]
        push_cast
        field_simp
        ring
    · rw [if_neg hdm, mul_zero]
      split_ifs with h1 h2
      · exfalso; apply hdm
        have := Nat.dvd_add h2 (dvd_refl d)
        rwa [Nat.sub_add_cancel h1] at this
      · simp
      · simp

  have t_prod : ∀ (s : Finset ℕ) (f g : ℕ → PowerSeries ℚ),
      (∀ i ∈ s, PowerSeries.X * PowerSeries.derivative (f i) = g i * f i) →
      PowerSeries.X * PowerSeries.derivative (∏ i ∈ s, f i) = (∑ i ∈ s, g i) * ∏ i ∈ s, f i := by
    intro s f g
    refine Finset.induction_on s ?_ ?_
    · intro _; simp
    · intro a s ha ih h
      rw [Finset.prod_insert ha, Finset.sum_insert ha, t_leib, h a (Finset.mem_insert_self a s),
        ih (fun i hi => h i (Finset.mem_insert_of_mem hi))]
      ring

  have t_trunc : ∀ (A F G : PowerSeries ℚ) (K : ℕ),
      (∀ j, j ≤ K → PowerSeries.coeff j F = PowerSeries.coeff j G) →
      ∀ j, j ≤ K → PowerSeries.coeff j (A * F) = PowerSeries.coeff j (A * G) := by
    intro A F G K h j hj
    rw [PowerSeries.coeff_mul, PowerSeries.coeff_mul]
    refine Finset.sum_congr rfl (fun x hx => ?_)
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
    rw [h x.2 (by omega)]
  have t_hineq : ∀ q i : ℕ, 2 ≤ i → (q + 1) ^ 2 * (q * i + 1) ≤ (2 * q + 1) * (q + 1) ^ i := by
    intro q i hi
    induction i, hi using Nat.le_induction with
    | base => exact le_of_eq (by ring)
    | succ i hi ih =>
      have hpw : (q + 1) ^ 2 ≤ (q + 1) ^ i := Nat.pow_le_pow_right (by omega) hi
      have h3 : (q + 1) ^ 2 * q ≤ (2 * q + 1) * (q + 1) ^ i * q := by
        have h4 : (q + 1) ^ 2 * q ≤ (q + 1) ^ i * q := Nat.mul_le_mul_right q hpw
        have h5 : (q + 1) ^ i * q ≤ (2 * q + 1) * (q + 1) ^ i * q := by
          apply Nat.mul_le_mul_right; nlinarith
        omega
      calc (q + 1) ^ 2 * (q * (i + 1) + 1) = (q + 1) ^ 2 * (q * i + 1) + (q + 1) ^ 2 * q := by ring
        _ ≤ (2 * q + 1) * (q + 1) ^ i + (2 * q + 1) * (q + 1) ^ i * q := Nat.add_le_add ih h3
        _ = (2 * q + 1) * (q + 1) ^ (i + 1) := by ring
  intro p hp hAH
  have hp2 : 2 ≤ p := hp.out.two_le
  have hp1 : (1 : ℚ) ≤ p := by exact_mod_cast hp.out.one_lt.le
  have hpQ : (p : ℚ) ≠ 0 := by exact_mod_cast hp.out.ne_zero

  have t_ah : dwbAHSeq p 0 = 1 ∧ ∀ k : ℕ, 1 ≤ k → (k : ℚ) * dwbAHSeq p k =
      ∑ i ∈ (Finset.range (k + 1)).filter (fun i => p ^ i ≤ k), dwbAHSeq p (k - p ^ i) := by
    refine ⟨by rw [dwbAHSeq], fun k hk => ?_⟩
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    conv_lhs => rw [dwbAHSeq]
    push_cast
    rw [← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul, Finset.sum_filter]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have hpos : 0 < p ^ i := pow_pos hp.out.pos i
    by_cases h : p ^ i ≤ k + 1
    · rw [dif_pos ⟨hpos, h⟩, if_pos h]
    · rw [dif_neg (fun h' => h h'.2), if_neg h]

  have t_cauchy : ∀ k, dwCDw p k = PowerSeries.coeff k (dwbExpS (1 / (p : ℚ)) p * dwbExpS 1 1) := by
    intro k
    have hp0 : 0 < p := hp.out.pos
    rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun a b => PowerSeries.coeff a (dwbExpS (1 / (p : ℚ)) p) * PowerSeries.coeff b (dwbExpS 1 1))]
    simp only [dwbExpS, PowerSeries.coeff_mk, one_dvd, if_true, Nat.div_one, one_pow, ite_mul,
      zero_mul]
    rw [← Finset.sum_filter]
    have hset : (Finset.range (k.succ)).filter (fun a => p ∣ a) =
        (Finset.range (k / p + 1)).image (fun j => p * j) := by
      ext a
      simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_image]
      constructor
      · rintro ⟨ha, j, rfl⟩
        refine ⟨j, ?_, rfl⟩
        rw [Nat.lt_succ_iff, Nat.le_div_iff_mul_le hp0]
        rw [Nat.mul_comm]; omega
      · rintro ⟨j, hj, rfl⟩
        rw [Nat.lt_succ_iff, Nat.le_div_iff_mul_le hp0] at hj
        exact ⟨by rw [Nat.mul_comm]; omega, dvd_mul_right p j⟩
    rw [hset, Finset.sum_image (fun x _ y _ h => Nat.eq_of_mul_eq_mul_left hp0 h)]
    unfold dwCDw
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Nat.mul_div_cancel_left j hp0]
    field_simp
    rw [one_div, inv_pow, mul_inv_cancel₀ (pow_ne_zero _ (by exact_mod_cast hp0.ne'))]

  have t_expPB : ∀ i, 2 ≤ i →
      dwbPB p (p ^ 2 * (p - 1)) (2 * p - 1) (dwbExpS (-(1 / (p : ℚ) ^ i)) (p ^ i)) := by
    intro i hi m
    simp only [dwbExpS, PowerSeries.coeff_mk]
    split_ifs with hdm
    · obtain ⟨n, rfl⟩ := hdm
      rw [Nat.mul_div_cancel_left n (pow_pos hp.out.pos i)]
      have hb0 : (-(1 / (p : ℚ) ^ i)) ≠ 0 := neg_ne_zero.mpr (one_div_ne_zero (pow_ne_zero _ hpQ))
      have hf0 : ((n.factorial : ℕ) : ℚ) ≠ 0 := by exact_mod_cast (Nat.factorial_pos n).ne'
      have hy0 : (-(1 / (p : ℚ) ^ i)) ^ n / (n.factorial : ℚ) ≠ 0 :=
        div_ne_zero (pow_ne_zero _ hb0) hf0
      have hval : padicValRat p ((-(1 / (p : ℚ) ^ i)) ^ n / (n.factorial : ℚ)) =
          -((n * i + padicValNat p n.factorial : ℕ) : ℤ) := by
        rw [padicValRat.div (pow_ne_zero _ hb0) hf0, padicValRat.pow, padicValRat.neg, one_div,
          padicValRat.inv, padicValRat.pow, padicValRat.self hp.out.one_lt, padicValRat.of_nat]
        push_cast; ring
      rw [padicNorm.eq_zpow_of_nonzero hy0, hval, neg_neg, zpow_natCast, ← pow_mul]
      apply pow_le_pow_right₀ hp1
      have hv : (p - 1) * padicValNat p n.factorial ≤ n := by
        rw [sub_one_mul_padicValNat_factorial]; exact Nat.sub_le _ _
      generalize padicValNat p n.factorial = v at hv ⊢
      obtain ⟨q, hq⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
      rw [hq] at hv ⊢
      have hq1 : q + 1 - 1 = q := by omega
      have h2q : 2 * (q + 1) - 1 = 2 * q + 1 := by omega
      rw [hq1] at hv ⊢
      rw [h2q]
      have hineq := t_hineq q i hi
      calc (n * i + v) * ((q + 1) ^ 2 * q)
            = (q + 1) ^ 2 * (q * i * n) + (q + 1) ^ 2 * (q * v) := by ring
        _ ≤ (q + 1) ^ 2 * (q * i * n) + (q + 1) ^ 2 * n :=
            Nat.add_le_add_left (Nat.mul_le_mul_left _ hv) _
        _ = n * ((q + 1) ^ 2 * (q * i + 1)) := by ring
        _ ≤ n * ((2 * q + 1) * (q + 1) ^ i) := Nat.mul_le_mul_left n hineq
        _ = (2 * q + 1) * ((q + 1) ^ i * n) := by ring
    · rw [padicNorm.zero]
      exact (pow_le_one₀ le_rfl zero_le_one).trans (one_le_pow₀ hp1)

  have t_pbmul : ∀ (D N : ℕ) (U V : PowerSeries ℚ),
      dwbPB p D N U → dwbPB p D N V → dwbPB p D N (U * V) := by
    intro D N U V hU hV j
    have hT : (1 : ℚ) ≤ (p : ℚ) ^ (N * j) := one_le_pow₀ hp1
    rw [PowerSeries.coeff_mul]
    refine Finset.sum_induction _ (fun y => padicNorm p y ^ D ≤ (p : ℚ) ^ (N * j)) ?_ ?_ ?_
    · intro a b ha hb
      calc padicNorm p (a + b) ^ D ≤ (max (padicNorm p a) (padicNorm p b)) ^ D :=
            pow_le_pow_left₀ (padicNorm.nonneg _) padicNorm.nonarchimedean D
        _ ≤ _ := by
            rcases le_total (padicNorm p a) (padicNorm p b) with h | h
            · rw [max_eq_right h]; exact hb
            · rw [max_eq_left h]; exact ha
    · rw [padicNorm.zero]; exact (pow_le_one₀ le_rfl zero_le_one).trans hT
    · intro x hx
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
      rw [padicNorm.mul, mul_pow, ← hx, mul_add, pow_add]
      exact mul_le_mul (hU x.1) (hV x.2) (pow_nonneg (padicNorm.nonneg _) _)
        (pow_nonneg (by positivity) _)
  have t_pbprod : ∀ (D N : ℕ) (s : Finset ℕ) (f : ℕ → PowerSeries ℚ),
      (∀ i ∈ s, dwbPB p D N (f i)) → dwbPB p D N (∏ i ∈ s, f i) := by
    intro D N s f
    refine Finset.induction_on s ?_ ?_
    · intro _ j
      rw [Finset.prod_empty, PowerSeries.coeff_one]
      split_ifs with hj
      · subst hj; simp
      · rw [padicNorm.zero]; exact (pow_le_one₀ le_rfl zero_le_one).trans (one_le_pow₀ hp1)
    · intro a s ha ih h
      rw [Finset.prod_insert ha]
      exact t_pbmul D N _ _ (h a (Finset.mem_insert_self a s))
        (ih (fun i hi => h i (Finset.mem_insert_of_mem hi)))

  have t_rpow : ∀ (x : ℚ) (k : ℕ), 0 ≤ x →
      x ^ (p ^ 2 * (p - 1)) ≤ (p : ℚ) ^ ((2 * p - 1) * k) →
      (x : ℝ) ≤ (p : ℝ) ^ ((k : ℝ) / ((p : ℝ) - 1) - (k : ℝ) * ((p : ℝ) - 1) / (p : ℝ) ^ 2) ∧
      (p ^ 2 < (p - 1) ^ 2 * k → (x : ℝ) < (p : ℝ) ^ (((k : ℝ) - 1) / ((p : ℝ) - 1))) := by
    intro x k hx h
    have hD : p ^ 2 * (p - 1) ≠ 0 := Nat.mul_ne_zero (pow_ne_zero _ (by omega)) (by omega)
    have hx' : (0 : ℝ) ≤ (x : ℝ) := by exact_mod_cast hx
    have hR : (x : ℝ) ^ (p ^ 2 * (p - 1)) ≤ (p : ℝ) ^ ((2 * p - 1) * k) := by
      have := (Rat.cast_le (K := ℝ)).mpr h
      push_cast at this
      exact this
    have hpR : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp2
    have hbase : (x : ℝ) ≤
        (p : ℝ) ^ ((((2 * p - 1) * k : ℕ) : ℝ) * (((p ^ 2 * (p - 1) : ℕ) : ℝ))⁻¹) := by
      calc (x : ℝ) = ((x : ℝ) ^ (p ^ 2 * (p - 1))) ^ (((p ^ 2 * (p - 1) : ℕ) : ℝ))⁻¹ :=
            (Real.pow_rpow_inv_natCast hx' hD).symm
        _ ≤ ((p : ℝ) ^ ((2 * p - 1) * k)) ^ (((p ^ 2 * (p - 1) : ℕ) : ℝ))⁻¹ :=
            Real.rpow_le_rpow (pow_nonneg hx' _) hR (inv_nonneg.mpr (Nat.cast_nonneg _))
        _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg _)]
    have hexp : (((2 * p - 1) * k : ℕ) : ℝ) * (((p ^ 2 * (p - 1) : ℕ) : ℝ))⁻¹ =
        (k : ℝ) / ((p : ℝ) - 1) - (k : ℝ) * ((p : ℝ) - 1) / (p : ℝ) ^ 2 := by
      push_cast [Nat.cast_sub (by omega : 1 ≤ 2 * p), Nat.cast_sub (by omega : 1 ≤ p)]
      have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
      have h2 : (p : ℝ) ≠ 0 := by linarith
      field_simp
      ring
    rw [hexp] at hbase
    refine ⟨hbase, fun hlt => lt_of_le_of_lt hbase ?_⟩
    apply Real.rpow_lt_rpow_of_exponent_lt (by linarith)
    have hcast : (p : ℝ) ^ 2 < ((p : ℝ) - 1) ^ 2 * (k : ℝ) := by
      have := (Nat.cast_lt (α := ℝ)).mpr hlt
      push_cast [Nat.cast_sub (by omega : 1 ≤ p)] at this
      exact this
    have h1 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
    have h2 : (0 : ℝ) < (p : ℝ) ^ 2 := by positivity
    rw [div_sub_div _ _ h1.ne' h2.ne', div_lt_div_iff₀ (mul_pos h1 h2) h1]
    nlinarith [mul_lt_mul_of_pos_right hcast h1]

  have key : ∀ k, padicNorm p (dwCDw p k) ^ (p ^ 2 * (p - 1)) ≤ (p : ℚ) ^ ((2 * p - 1) * k) := by
    intro k
    obtain ⟨he0, hrec⟩ := t_ah
    have hEb : dwbPB p (p ^ 2 * (p - 1)) (2 * p - 1) (PowerSeries.mk (dwbAHSeq p)) := by
      intro j
      rw [PowerSeries.coeff_mk]
      have h := hAH (dwbAHSeq p) he0 hrec j
      calc padicNorm p (dwbAHSeq p j) ^ (p ^ 2 * (p - 1)) ≤ 1 ^ (p ^ 2 * (p - 1)) :=
            pow_le_pow_left₀ (padicNorm.nonneg _) h _
        _ = 1 := one_pow _
        _ ≤ _ := one_le_pow₀ hp1
    have hEode : ∀ j, j ≤ k →
        PowerSeries.coeff j (PowerSeries.X * PowerSeries.derivative (PowerSeries.mk (dwbAHSeq p))) =
        PowerSeries.coeff j ((∑ i ∈ Finset.range (k + 2), PowerSeries.X ^ (p ^ i)) *
          PowerSeries.mk (dwbAHSeq p)) := by
      intro j hj
      rw [t_hXd, Finset.sum_mul, map_sum]
      simp only [PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_mk]
      have hext : ∀ i ∈ Finset.range (k + 2), i ∉ Finset.range (j + 1) →
          (if p ^ i ≤ j then dwbAHSeq p (j - p ^ i) else 0) = 0 := by
        intro i _ hi
        rw [Finset.mem_range, not_lt] at hi
        have : i < p ^ i := Nat.lt_pow_self hp.out.one_lt
        rw [if_neg (by omega)]
      rw [← Finset.sum_subset (Finset.range_mono (show j + 1 ≤ k + 2 by omega)) hext]
      rcases Nat.eq_zero_or_pos j with rfl | hjpos
      · simp
      · rw [hrec j hjpos, Finset.sum_filter]
    obtain ⟨P, hPdef⟩ : ∃ P : PowerSeries ℚ, P = ∏ i ∈ Finset.range k,
        dwbExpS (-(1 / (p : ℚ) ^ (i + 1 + 1))) (p ^ (i + 1 + 1)) := ⟨_, rfl⟩
    have hP : PowerSeries.X * PowerSeries.derivative P =
        (∑ i ∈ Finset.range k, -(PowerSeries.X ^ (p ^ (i + 1 + 1)))) * P := by
      rw [hPdef]
      refine t_prod _ _ _ (fun i _ => ?_)
      rw [t_exp _ _ (Nat.one_le_pow _ _ hp.out.pos)]
      have hc : ((p ^ (i + 1 + 1) : ℕ) : ℚ) * (-(1 / (p : ℚ) ^ (i + 1 + 1))) = -1 := by
        push_cast; field_simp
      rw [hc, map_neg, map_one]; ring
    have hP0 : PowerSeries.constantCoeff P = 1 := by
      rw [hPdef, map_prod]; exact Finset.prod_eq_one (fun i _ => t_exp0 _ _)
    have hPB : dwbPB p (p ^ 2 * (p - 1)) (2 * p - 1) P := by
      rw [hPdef]; exact t_pbprod _ _ _ _ (fun i _ => t_expPB (i + 1 + 1) (by omega))
    have hAL : (PowerSeries.X + PowerSeries.X ^ p : PowerSeries ℚ) =
        (∑ i ∈ Finset.range (k + 2), PowerSeries.X ^ (p ^ i)) +
          ∑ i ∈ Finset.range k, -(PowerSeries.X ^ (p ^ (i + 1 + 1))) := by
      rw [Finset.sum_range_succ', Finset.sum_range_succ', Finset.sum_neg_distrib]
      simp only [pow_zero, pow_one, zero_add]
      abel
    have hWode : ∀ j, j ≤ k →
        PowerSeries.coeff j
          (PowerSeries.X * PowerSeries.derivative (PowerSeries.mk (dwbAHSeq p) * P)) =
        PowerSeries.coeff j
          ((PowerSeries.X + PowerSeries.X ^ p) * (PowerSeries.mk (dwbAHSeq p) * P)) := by
      intro j hj
      rw [t_leib, hP, map_add, t_trunc P _ _ k hEode j hj, ← map_add, hAL]
      congr 1
      ring
    have hCeq : PowerSeries.mk (dwCDw p) = dwbExpS (1 / (p : ℚ)) p * dwbExpS 1 1 := by
      ext j; rw [PowerSeries.coeff_mk, t_cauchy]
    have hCode : PowerSeries.X * PowerSeries.derivative (dwbExpS (1 / (p : ℚ)) p * dwbExpS 1 1) =
        (PowerSeries.X + PowerSeries.X ^ p) * (dwbExpS (1 / (p : ℚ)) p * dwbExpS 1 1) := by
      rw [t_leib, t_exp _ _ le_rfl, t_exp _ _ hp.out.one_lt.le]
      have h1 : ((p : ℕ) : ℚ) * (1 / (p : ℚ)) = 1 := by field_simp
      rw [h1]
      simp only [Nat.cast_one, mul_one, map_one, one_mul, pow_one]
      ring
    have hck : dwCDw p k = PowerSeries.coeff k (PowerSeries.mk (dwbAHSeq p) * P) := by
      have := t_uniq (dwbExpS (1 / (p : ℚ)) p * dwbExpS 1 1) (PowerSeries.mk (dwbAHSeq p) * P)
        (PowerSeries.X + PowerSeries.X ^ p) k (by rw [map_mul, t_exp0, t_exp0, mul_one])
        (by rw [map_mul, hP0, PowerSeries.constantCoeff_mk, he0, mul_one])
        (fun j _ => by rw [hCode]) hWode k le_rfl
      rw [← this, ← hCeq, PowerSeries.coeff_mk]
    rw [hck]
    exact t_pbmul _ _ _ _ hEb hPB k
  refine ⟨fun k => (t_rpow _ k (padicNorm.nonneg _) (key k)).1, fun k hk => ?_⟩
  by_cases h : p ^ 2 < (p - 1) ^ 2 * k
  · exact (t_rpow _ k (padicNorm.nonneg _) (key k)).2 h
  · exact t_small p k hk (by omega)

theorem dwork_lam_bounds : ∀ (p : ℕ) [Fact p.Prime], dwCBounds p →
    (∀ q : ℚ, ‖(q : PadicComplex p)‖ = (padicNorm p q : ℝ)) →
    ∀ ϖ : PadicComplex p, ϖ ^ (p - 1) = -(p : PadicComplex p) →
    ∃ r₀ δ : ℝ, 0 ≤ r₀ ∧ r₀ < 1 ∧ 0 ≤ δ ∧ δ < ‖ϖ‖ ∧
      (∀ k, ‖ϖ ^ k * (dwCDw p k : PadicComplex p)‖ ≤ r₀ ^ k) ∧
      (∀ k, 2 ≤ k → ‖ϖ ^ k * (dwCDw p k : PadicComplex p)‖ ≤ δ) :=
by
  intro p _ hC hN ϖ hϖ
  have hp : p.Prime := Fact.out
  have hp2 : 2 ≤ p := hp.two_le
  have hP2 : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp2
  have hP1 : (1 : ℝ) < (p : ℝ) := by linarith
  have hP0 : (0 : ℝ) < (p : ℝ) := by linarith
  have he0 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
  have hpe : ((p - 1 : ℕ) : ℝ) = (p : ℝ) - 1 := by rw [Nat.cast_pred (by omega)]
  have hNp : ‖(p : PadicComplex p)‖ = (p : ℝ)⁻¹ := by
    have h := hN (p : ℚ)
    rw [Rat.cast_natCast] at h
    rw [h, padicNorm.padicNorm_p_of_prime]
    push_cast
    rfl
  have ha_pow : ‖ϖ‖ ^ (p - 1) = (p : ℝ)⁻¹ := by rw [← norm_pow, hϖ, norm_neg, hNp]
  have hb_pos : 0 < (p : ℝ) ^ (-1 / ((p : ℝ) - 1)) := Real.rpow_pos_of_pos hP0 _
  have hb_pow : ((p : ℝ) ^ (-1 / ((p : ℝ) - 1))) ^ (p - 1) = (p : ℝ)⁻¹ := by
    rw [← Real.rpow_mul_natCast hP0.le, hpe, div_mul_cancel₀ _ he0.ne', Real.rpow_neg_one]
  have ha : ‖ϖ‖ = (p : ℝ) ^ (-1 / ((p : ℝ) - 1)) :=
    (pow_left_inj₀ (norm_nonneg _) hb_pos.le (by omega : p - 1 ≠ 0)).mp
      (ha_pow.trans hb_pow.symm)
  have hapos : 0 < ‖ϖ‖ := ha ▸ hb_pos
  have hak : ∀ k : ℕ, ‖ϖ‖ ^ k = (p : ℝ) ^ (-1 / ((p : ℝ) - 1) * k) := by
    intro k; rw [ha, Real.rpow_mul_natCast hP0.le]
  have hx : ∀ k, ‖ϖ ^ k * (dwCDw p k : PadicComplex p)‖ =
      ‖ϖ‖ ^ k * (padicNorm p (dwCDw p k) : ℝ) := by
    intro k; rw [norm_mul, norm_pow, hN]
  obtain ⟨r₀, hr₀⟩ : ∃ r : ℝ, r = (p : ℝ) ^ (-((p : ℝ) - 1) / (p : ℝ) ^ 2) := ⟨_, rfl⟩
  have hr₀0 : 0 ≤ r₀ := hr₀ ▸ Real.rpow_nonneg hP0.le _
  have hr₀1 : r₀ < 1 := by
    rw [hr₀]
    refine Real.rpow_lt_one_of_one_lt_of_neg hP1 ?_
    apply div_neg_of_neg_of_pos
    · linarith
    · positivity
  have hbound : ∀ k, ‖ϖ ^ k * (dwCDw p k : PadicComplex p)‖ ≤ r₀ ^ k := by
    intro k
    rw [hx, hak, hr₀, ← Real.rpow_mul_natCast hP0.le]
    calc (p : ℝ) ^ (-1 / ((p : ℝ) - 1) * k) * (padicNorm p (dwCDw p k) : ℝ)
        ≤ (p : ℝ) ^ (-1 / ((p : ℝ) - 1) * k) *
            (p : ℝ) ^ ((k : ℝ) / ((p : ℝ) - 1) - (k : ℝ) * ((p : ℝ) - 1) / (p : ℝ) ^ 2) :=
          mul_le_mul_of_nonneg_left (hC.1 k) (Real.rpow_nonneg hP0.le _)
      _ = _ := by
          rw [← Real.rpow_add hP0]
          congr 1
          ring
  have hstrict : ∀ k, 2 ≤ k → ‖ϖ ^ k * (dwCDw p k : PadicComplex p)‖ < ‖ϖ‖ := by
    intro k hk
    rw [hx, hak]
    calc (p : ℝ) ^ (-1 / ((p : ℝ) - 1) * k) * (padicNorm p (dwCDw p k) : ℝ)
        < (p : ℝ) ^ (-1 / ((p : ℝ) - 1) * k) * (p : ℝ) ^ (((k : ℝ) - 1) / ((p : ℝ) - 1)) :=
          mul_lt_mul_of_pos_left (hC.2 k hk) (Real.rpow_pos_of_pos hP0 _)
      _ = ‖ϖ‖ := by
          rw [← Real.rpow_add hP0, ha]
          congr 1
          ring
  obtain ⟨K₀, hK₀⟩ := exists_pow_lt_of_lt_one hapos hr₀1
  have hK : r₀ ^ (max K₀ 2) < ‖ϖ‖ :=
    lt_of_le_of_lt (pow_le_pow_of_le_one hr₀0 hr₀1.le (le_max_left _ _)) hK₀
  obtain ⟨kstar, hks, hkmax⟩ := Finset.exists_max_image (Finset.Icc 2 (max K₀ 2))
    (fun k => ‖ϖ ^ k * (dwCDw p k : PadicComplex p)‖)
    (Finset.nonempty_Icc.mpr (le_max_right _ _))
  have hks2 : 2 ≤ kstar := (Finset.mem_Icc.mp hks).1
  refine ⟨r₀, max (r₀ ^ (max K₀ 2)) ‖ϖ ^ kstar * (dwCDw p kstar : PadicComplex p)‖, hr₀0, hr₀1,
    le_max_of_le_left (pow_nonneg hr₀0 _), max_lt hK (hstrict kstar hks2), hbound, ?_⟩
  intro k hk
  by_cases hkK : k ≤ max K₀ 2
  · exact le_max_of_le_right (hkmax k (Finset.mem_Icc.mpr ⟨hk, hkK⟩))
  · exact le_max_of_le_left
      ((hbound k).trans (pow_le_pow_of_le_one hr₀0 hr₀1.le (not_le.mp hkK).le))

theorem dwork_lam_series_pow : ∀ (p : ℕ) [Fact p.Prime] (ϖ : PadicComplex p),
    ϖ ^ (p - 1) = -(p : PadicComplex p) →
    (PowerSeries.mk fun k => ϖ ^ k * (dwCDw p k : PadicComplex p)) ^ p =
      PowerSeries.rescale ((p : PadicComplex p) * ϖ) (PowerSeries.exp (PadicComplex p)) *
        PowerSeries.expand p (Fact.out : p.Prime).ne_zero
          (PowerSeries.rescale (-((p : PadicComplex p) * ϖ)) (PowerSeries.exp (PadicComplex p))) :=
by
  intro p _ ϖ hϖ
  have hp : p.Prime := Fact.out
  have hp0 : p ≠ 0 := hp.ne_zero
  have hpos : 0 < p := hp.pos

  have s1 : ∀ (f g : PowerSeries (PadicComplex p)) (k : ℕ),
      PowerSeries.coeff k (f * PowerSeries.expand p hp0 g) =
        ∑ j ∈ Finset.range (k / p + 1),
          PowerSeries.coeff (k - p * j) f * PowerSeries.coeff j g := by
    intro f g k
    rw [mul_comm f, PowerSeries.coeff_mul,
      Finset.Nat.sum_antidiagonal_eq_sum_range_succ
        (fun n i => PowerSeries.coeff n (PowerSeries.expand p hp0 g) * PowerSeries.coeff i f)]
    simp only [PowerSeries.coeff_expand, ite_mul, zero_mul]
    rw [← Finset.sum_filter]
    have hset : (Finset.range (k + 1)).filter (fun n => p ∣ n) =
        (Finset.range (k / p + 1)).map
          ⟨fun j => p * j, fun ⦃a b⦄ h => Nat.eq_of_mul_eq_mul_left hpos h⟩ := by
      ext n
      simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_map]
      constructor
      · rintro ⟨hn, c, rfl⟩
        refine ⟨c, ?_, rfl⟩
        have : c ≤ k / p := (Nat.le_div_iff_mul_le hpos).mpr (by rw [mul_comm]; omega)
        omega
      · rintro ⟨j, hj, rfl⟩
        refine ⟨?_, dvd_mul_right _ _⟩
        have : j * p ≤ k := (Nat.le_div_iff_mul_le hpos).mp (by omega)
        show p * j < k + 1
        rw [mul_comm]; omega
    rw [hset, Finset.sum_map]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    show PowerSeries.coeff (p * j / p) g * PowerSeries.coeff (k - p * j) f = _
    rw [Nat.mul_div_cancel_left j hpos]
    ring

  have hϖp : ϖ ^ p = -(p : PadicComplex p) * ϖ := by
    rw [← hϖ, ← pow_succ, Nat.sub_add_cancel hpos]
  have s2 : ∀ j k : ℕ, p * j ≤ k →
      ϖ ^ k * (((1 / ((p : ℚ) ^ j * (j.factorial : ℚ) * ((k - p * j).factorial : ℚ))) : ℚ) :
        PadicComplex p) =
      (ϖ ^ (k - p * j) * (((1 : ℚ) / ((k - p * j).factorial : ℚ) : ℚ) : PadicComplex p)) *
        ((-ϖ) ^ j * (((1 : ℚ) / (j.factorial : ℚ) : ℚ) : PadicComplex p)) := by
    intro j k hjk
    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hjk
    rw [Nat.add_sub_cancel_left]
    have hk : ϖ ^ (p * j + m) = (-ϖ) ^ j * (p : PadicComplex p) ^ j * ϖ ^ m := by
      rw [pow_add, pow_mul, hϖp]; ring
    rw [hk]
    have hpK : (p : PadicComplex p) ≠ 0 := Nat.cast_ne_zero.mpr hp0
    have h1 : (j.factorial : PadicComplex p) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    have h2 : (m.factorial : PadicComplex p) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    push_cast
    field_simp

  have hfac : (PowerSeries.mk fun k => ϖ ^ k * (dwCDw p k : PadicComplex p)) =
      PowerSeries.rescale ϖ (PowerSeries.exp (PadicComplex p)) *
        PowerSeries.expand p hp0 (PowerSeries.rescale (-ϖ) (PowerSeries.exp (PadicComplex p))) := by
    ext k
    rw [s1, PowerSeries.coeff_mk, dwCDw, Rat.cast_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j hj => ?_)
    have hj' : p * j ≤ k := by
      have h := Finset.mem_range.mp hj
      have : j * p ≤ k := (Nat.le_div_iff_mul_le hpos).mp (by omega)
      rw [mul_comm]; exact this
    rw [s2 j k hj', PowerSeries.coeff_rescale, PowerSeries.coeff_rescale, PowerSeries.coeff_exp,
      PowerSeries.coeff_exp, eq_ratCast, eq_ratCast]

  rw [hfac, mul_pow, ← map_pow (PowerSeries.rescale ϖ), ← map_pow (PowerSeries.expand p hp0),
    ← map_pow (PowerSeries.rescale (-ϖ)), PowerSeries.exp_pow_eq_rescale_exp,
    PowerSeries.rescale_rescale, PowerSeries.rescale_rescale, mul_neg]

theorem dwork_exp_rescale_coeff_bound : ∀ (p : ℕ) [Fact p.Prime],
    (∀ q : ℚ, ‖(q : PadicComplex p)‖ = (padicNorm p q : ℝ)) →
    ∀ a : PadicComplex p, ‖a‖ ^ (p - 1) ≤ ((p : ℝ)⁻¹) ^ p →
    ∀ k, ‖PowerSeries.coeff k (PowerSeries.rescale a (PowerSeries.exp (PadicComplex p)))‖ ≤
      ((p : ℝ)⁻¹) ^ k :=
by
  intro p _ hN a ha k
  have hp : p.Prime := Fact.out
  have hcoeff : PowerSeries.coeff k (PowerSeries.rescale a (PowerSeries.exp (PadicComplex p))) =
      a ^ k * ((1 / (k.factorial : ℚ) : ℚ) : PadicComplex p) := by
    rw [PowerSeries.coeff_rescale, PowerSeries.coeff_exp, eq_ratCast]
  have hnorm1 : (padicNorm p (1 / (k.factorial : ℚ)) : ℝ) =
      (p : ℝ) ^ (padicValNat p k.factorial) := by
    have hk : (k.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
    rw [padicNorm.div, padicNorm.one, padicNorm.eq_zpow_of_nonzero hk, padicValRat.of_nat,
      zpow_neg, zpow_natCast]
    push_cast
    simp
  have hleg : (p - 1) * padicValNat p k.factorial ≤ k := by
    rw [sub_one_mul_padicValNat_factorial]; exact Nat.sub_le _ _
  rw [hcoeff, norm_mul, norm_pow, hN, hnorm1]
  have hb : 0 ≤ ‖a‖ := norm_nonneg a
  generalize ‖a‖ = b at ha hb ⊢
  generalize padicValNat p k.factorial = v at hleg ⊢
  obtain ⟨q, hq⟩ : ∃ q, p = q + 1 := ⟨p - 1, by have := hp.two_le; omega⟩
  have hq0 : q ≠ 0 := by have := hp.two_le; omega
  have hP1 : (1 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp.one_lt.le
  have hP0 : (0 : ℝ) < (p : ℝ) := by linarith
  generalize (p : ℝ) = P at hP1 hP0 ha ⊢
  subst hq
  simp only [Nat.add_sub_cancel] at ha hleg
  have hPi : 0 ≤ P⁻¹ := inv_nonneg.mpr hP0.le
  rw [← pow_le_pow_iff_left₀ (mul_nonneg (pow_nonneg hb _) (pow_nonneg hP0.le _))
    (pow_nonneg hPi _) hq0]
  calc (b ^ k * P ^ v) ^ q = (b ^ q) ^ k * P ^ (q * v) := by ring
    _ ≤ ((P⁻¹) ^ (q + 1)) ^ k * P ^ k :=
        mul_le_mul (pow_le_pow_left₀ (pow_nonneg hb _) ha k) (pow_le_pow_right₀ hP1 hleg)
          (pow_nonneg hP0.le _) (pow_nonneg (pow_nonneg hPi _) _)
    _ = ((P⁻¹) ^ k) ^ q := by
        rw [pow_succ, mul_pow, mul_assoc, ← mul_pow, inv_mul_cancel₀ hP0.ne', one_pow, mul_one]
        ring

theorem dwork_theta_telescope : ∀ (p : ℕ) [Fact p.Prime] (Λ H H' : PowerSeries (PadicComplex p)) (ρ : ℝ),
    0 ≤ ρ → ρ < 1 → (∀ k, ‖PowerSeries.coeff k Λ‖ ≤ ρ ^ k) →
    (∀ k, ‖PowerSeries.coeff k H‖ ≤ ρ ^ k) → (∀ k, ‖PowerSeries.coeff k H'‖ ≤ ρ ^ k) →
    H * H' = 1 → Λ ^ p = H * PowerSeries.expand p (Fact.out : p.Prime).ne_zero H' →
    ∀ m : ℕ, 1 ≤ m → ∀ t : PadicComplex p, t ^ (p ^ m) = t →
      (∏ i ∈ Finset.range m, ∑' k, PowerSeries.coeff k Λ * (t ^ (p ^ i)) ^ k) ^ p = 1 :=
by
  intro p _ Λ H H' ρ hρ0 hρ1 hΛb hHb hH'b hHH' hΛ m hm t ht
  have hp : p.Prime := Fact.out

  have evmul : ∀ (f g : PowerSeries (PadicComplex p)) (s : PadicComplex p),
      Summable (fun k => ‖PowerSeries.coeff k f‖ * ‖s‖ ^ k) →
      Summable (fun k => ‖PowerSeries.coeff k g‖ * ‖s‖ ^ k) →
      Summable (fun k => ‖PowerSeries.coeff k (f * g)‖ * ‖s‖ ^ k) ∧
      ∑' k, PowerSeries.coeff k (f * g) * s ^ k =
        (∑' k, PowerSeries.coeff k f * s ^ k) * (∑' k, PowerSeries.coeff k g * s ^ k) := by
    intro f g s hf hg
    have hA : Summable (fun k => ‖PowerSeries.coeff k f * s ^ k‖) := by
      simpa only [norm_mul, norm_pow] using hf
    have hB : Summable (fun k => ‖PowerSeries.coeff k g * s ^ k‖) := by
      simpa only [norm_mul, norm_pow] using hg
    have key : ∀ n : ℕ, ∑ kl ∈ Finset.HasAntidiagonal.antidiagonal n,
        (PowerSeries.coeff kl.1 f * s ^ kl.1) * (PowerSeries.coeff kl.2 g * s ^ kl.2) =
        PowerSeries.coeff n (f * g) * s ^ n := by
      intro n
      rw [PowerSeries.coeff_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun kl hkl => ?_)
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hkl
      rw [← hkl, pow_add]
      ring
    constructor
    · have h := summable_norm_sum_mul_antidiagonal_of_summable_norm hA hB
      simp only [key, norm_mul, norm_pow] at h
      exact h
    · rw [tsum_mul_tsum_eq_tsum_sum_antidiagonal_of_summable_norm hA hB]
      exact tsum_congr (fun n => (key n).symm)

  have evexp : ∀ (f : PowerSeries (PadicComplex p)) (s : PadicComplex p),
      Summable (fun k => ‖PowerSeries.coeff k f‖ * ‖s ^ p‖ ^ k) →
      Summable (fun n => ‖PowerSeries.coeff n
        (PowerSeries.expand p (Fact.out : p.Prime).ne_zero f)‖ * ‖s‖ ^ n) ∧
      ∑' n, PowerSeries.coeff n (PowerSeries.expand p (Fact.out : p.Prime).ne_zero f) * s ^ n =
        ∑' k, PowerSeries.coeff k f * (s ^ p) ^ k := by
    intro f s hf
    have hg : Function.Injective (fun k : ℕ => p * k) :=
      fun a b h => Nat.eq_of_mul_eq_mul_left hp.pos h
    have hoff : ∀ n, n ∉ Set.range (fun k : ℕ => p * k) →
        PowerSeries.coeff n (PowerSeries.expand p (Fact.out : p.Prime).ne_zero f) = 0 := by
      intro n hn
      rw [PowerSeries.coeff_expand, if_neg]
      rintro ⟨c, rfl⟩
      exact hn ⟨c, rfl⟩
    constructor
    · rw [← hg.summable_iff]
      · convert hf using 1
        funext k
        simp only [Function.comp, PowerSeries.coeff_expand_mul, norm_pow, pow_mul]
      · intro n hn
        rw [hoff n hn, norm_zero, zero_mul]
    · rw [← hg.tsum_eq]
      · refine tsum_congr (fun k => ?_)
        simp only [PowerSeries.coeff_expand_mul, pow_mul]
      · intro n hn
        by_contra hc
        exact hn (by simp only [hoff n hc, zero_mul])

  have good : ∀ (f : PowerSeries (PadicComplex p)) (s : PadicComplex p),
      (∀ k, ‖PowerSeries.coeff k f‖ ≤ ρ ^ k) → ‖s‖ ≤ 1 →
      Summable (fun k => ‖PowerSeries.coeff k f‖ * ‖s‖ ^ k) := by
    intro f s hf hs
    refine Summable.of_nonneg_of_le (fun k => by positivity) (fun k => ?_)
      (summable_geometric_of_lt_one hρ0 hρ1)
    calc ‖PowerSeries.coeff k f‖ * ‖s‖ ^ k ≤ ρ ^ k * 1 :=
          mul_le_mul (hf k) (pow_le_one₀ (norm_nonneg _) hs) (by positivity) (by positivity)
      _ = ρ ^ k := mul_one _
  have one_good : ∀ s : PadicComplex p,
      Summable (fun k => ‖PowerSeries.coeff k (1 : PowerSeries (PadicComplex p))‖ * ‖s‖ ^ k) ∧
      ∑' k, PowerSeries.coeff k (1 : PowerSeries (PadicComplex p)) * s ^ k = 1 := by
    intro s
    constructor
    · apply summable_of_ne_finset_zero (s := {0})
      intro k hk
      rw [Finset.mem_singleton] at hk
      rw [PowerSeries.coeff_one, if_neg hk, norm_zero, zero_mul]
    · rw [tsum_eq_single 0]
      · simp
      · intro k hk
        rw [PowerSeries.coeff_one, if_neg hk, zero_mul]

  have evpow : ∀ (f : PowerSeries (PadicComplex p)) (s : PadicComplex p),
      Summable (fun k => ‖PowerSeries.coeff k f‖ * ‖s‖ ^ k) → ∀ j : ℕ,
      Summable (fun k => ‖PowerSeries.coeff k (f ^ j)‖ * ‖s‖ ^ k) ∧
      ∑' k, PowerSeries.coeff k (f ^ j) * s ^ k = (∑' k, PowerSeries.coeff k f * s ^ k) ^ j := by
    intro f s hf j
    induction j with
    | zero => simpa only [pow_zero] using one_good s
    | succ j ih =>
      obtain ⟨h1, h2⟩ := evmul (f ^ j) f s ih.1 hf
      have e1 : f ^ (j + 1) = f ^ j * f := pow_succ f j
      rw [e1, pow_succ, ← ih.2]
      exact ⟨h1, h2⟩

  have ht1 : ‖t‖ ≤ 1 := by
    by_contra h
    push_neg at h
    have h1 : 1 < p ^ m := Nat.one_lt_pow (by omega) hp.one_lt
    have h2 := lt_self_pow₀ h h1
    rw [← norm_pow, ht] at h2
    exact lt_irrefl _ h2
  have hu : ∀ i, ‖t ^ (p ^ i)‖ ≤ 1 := fun i => by
    rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) ht1
  have hup : ∀ i, (t ^ (p ^ i)) ^ p = t ^ (p ^ (i + 1)) := fun i => by
    rw [← pow_mul, pow_succ]

  have factor : ∀ i, (∑' k, PowerSeries.coeff k Λ * (t ^ (p ^ i)) ^ k) ^ p =
      (∑' k, PowerSeries.coeff k H * (t ^ (p ^ i)) ^ k) *
      (∑' k, PowerSeries.coeff k H' * (t ^ (p ^ (i + 1))) ^ k) := by
    intro i
    have hΛg := good Λ _ hΛb (hu i)
    have hHg := good H _ hHb (hu i)
    have hH'g := good H' ((t ^ (p ^ i)) ^ p) hH'b (by rw [hup i]; exact hu (i + 1))
    obtain ⟨hEg, hEv⟩ := evexp H' (t ^ (p ^ i)) hH'g
    rw [← (evpow Λ _ hΛg p).2, hΛ, (evmul H _ _ hHg hEg).2, hEv, hup i]

  have shift : ∏ i ∈ Finset.range m, (∑' k, PowerSeries.coeff k H' * (t ^ (p ^ (i + 1))) ^ k) =
      ∏ i ∈ Finset.range m, (∑' k, PowerSeries.coeff k H' * (t ^ (p ^ i)) ^ k) := by
    obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    rw [Finset.prod_range_succ, Finset.prod_range_succ', ht, pow_zero, pow_one]

  rw [← Finset.prod_pow, Finset.prod_congr rfl (fun i _ => factor i), Finset.prod_mul_distrib,
    shift, ← Finset.prod_mul_distrib]
  refine Finset.prod_eq_one (fun i _ => ?_)
  rw [← (evmul H H' _ (good H _ hHb (hu i)) (good H' _ hH'b (hu i))).2, hHH']
  exact (one_good _).2

theorem padic_root_of_unity_sep : ∀ (p : ℕ) [Fact p.Prime],
    (∀ q : ℚ, ‖(q : PadicComplex p)‖ = (padicNorm p q : ℝ)) →
    ∀ ξ : PadicComplex p, ξ ^ p = 1 → ‖ξ - 1‖ ^ (p - 1) < (p : ℝ)⁻¹ → ξ = 1 :=
by
  intro p _ hN ξ hξ hlt
  have hp : p.Prime := Fact.out
  have hp2 : 2 ≤ p := hp.two_le
  have hNp : ‖(p : PadicComplex p)‖ = (p : ℝ)⁻¹ := by
    have h := hN (p : ℚ)
    rw [Rat.cast_natCast] at h
    rw [h, padicNorm.padicNorm_p_of_prime]
    push_cast
    rfl
  obtain ⟨x, rfl⟩ : ∃ x, ξ = x + 1 := ⟨ξ - 1, by ring⟩
  rw [add_sub_cancel_right] at hlt
  by_contra hne
  have hx0 : x ≠ 0 := by
    intro h; apply hne; rw [h, zero_add]
  have ht0 : 0 < ‖x‖ := norm_pos_iff.mpr hx0
  have hpinv0 : 0 < (p : ℝ)⁻¹ := by
    have : (0 : ℝ) < p := by exact_mod_cast hp.pos
    positivity
  have hpinv1 : (p : ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt)
  have ht1 : ‖x‖ < 1 := by
    by_contra h
    push_neg at h
    have := one_le_pow₀ (n := p - 1) h
    linarith
  obtain ⟨n, hn⟩ : ∃ n, p = n + 2 := ⟨p - 2, by omega⟩
  have hbin : (p : PadicComplex p) * x + ∑ j ∈ Finset.range (n + 1),
      x ^ (j + 1 + 1) * (p.choose (j + 1 + 1) : PadicComplex p) = 0 := by
    have h := add_pow x 1 p
    rw [hξ] at h
    have hr : p + 1 = n + 1 + 1 + 1 := by omega
    rw [hr, Finset.sum_range_succ', Finset.sum_range_succ'] at h
    simp only [one_pow, mul_one, pow_zero, Nat.choose_zero_right, zero_add, pow_one,
      Nat.choose_one_right, Nat.cast_one] at h
    linear_combination -h
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = max (‖x‖ ^ 2 * (p : ℝ)⁻¹) (‖x‖ ^ p) := ⟨_, rfl⟩
  have hterm : ∀ j ∈ Finset.range (n + 1),
      ‖x ^ (j + 1 + 1) * (p.choose (j + 1 + 1) : PadicComplex p)‖ ≤ B := by
    intro j hj
    rw [Finset.mem_range] at hj
    rw [norm_mul, norm_pow, hB]
    rcases Nat.lt_or_ge (j + 1 + 1) p with hk | hk
    · obtain ⟨m, hm⟩ := hp.dvd_choose_self (by omega : j + 1 + 1 ≠ 0) hk
      rw [hm, Nat.cast_mul, norm_mul, hNp]
      have h1 : ‖(m : PadicComplex p)‖ ≤ 1 := IsUltrametricDist.norm_natCast_le_one _ m
      have h2 : ‖x‖ ^ (j + 1 + 1) ≤ ‖x‖ ^ 2 :=
        pow_le_pow_of_le_one (norm_nonneg _) ht1.le (by omega)
      refine le_trans ?_ (le_max_left _ _)
      calc ‖x‖ ^ (j + 1 + 1) * ((p : ℝ)⁻¹ * ‖(m : PadicComplex p)‖)
          ≤ ‖x‖ ^ 2 * ((p : ℝ)⁻¹ * 1) := by gcongr
        _ = ‖x‖ ^ 2 * (p : ℝ)⁻¹ := by ring
    · have hk' : j + 1 + 1 = p := by omega
      rw [hk', Nat.choose_self, Nat.cast_one, norm_one, mul_one]
      exact le_max_right _ _
  have hB0 : 0 ≤ B := by
    rw [hB]; exact le_max_of_le_right (pow_nonneg (norm_nonneg _) p)
  have hsum : ‖∑ j ∈ Finset.range (n + 1),
      x ^ (j + 1 + 1) * (p.choose (j + 1 + 1) : PadicComplex p)‖ ≤ B :=
    IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hB0 hterm
  have hBlt : B < ‖x‖ * (p : ℝ)⁻¹ := by
    rw [hB]
    apply max_lt
    · have h2 : ‖x‖ ^ 2 < ‖x‖ := by nlinarith
      exact mul_lt_mul_of_pos_right h2 hpinv0
    · have h3 : ‖x‖ ^ p = ‖x‖ * ‖x‖ ^ (p - 1) := by
        rw [← pow_succ']; congr 1; omega
      rw [h3]
      exact mul_lt_mul_of_pos_left hlt ht0
  have heq : (p : PadicComplex p) * x = -∑ j ∈ Finset.range (n + 1),
      x ^ (j + 1 + 1) * (p.choose (j + 1 + 1) : PadicComplex p) :=
    eq_neg_of_add_eq_zero_left hbin
  have hn2 := congrArg norm heq
  rw [norm_neg, norm_mul, hNp] at hn2
  linarith

theorem dwork_theta_congruence : ∀ (p : ℕ) [Fact p.Prime] (lam : ℕ → PadicComplex p)
    (ϖ : PadicComplex p) (r₀ δ : ℝ), 0 ≤ r₀ → r₀ < 1 → lam 0 = 1 → lam 1 = ϖ →
    (∀ k, ‖lam k‖ ≤ r₀ ^ k) → 0 ≤ δ → (∀ k, 2 ≤ k → ‖lam k‖ ≤ δ) → δ ≤ ‖ϖ‖ → ‖ϖ‖ ≤ 1 →
    ∀ (m : ℕ) (u : ℕ → PadicComplex p), (∀ i, ‖u i‖ ≤ 1) →
      ‖∏ i ∈ Finset.range m, dwTheta p lam (u i) - (1 + ϖ * ∑ i ∈ Finset.range m, u i)‖ ≤
        max δ (‖ϖ‖ ^ 2) :=
by
  intro p _ lam ϖ r₀ δ hr0 hr1 hl0 hl1 hlr hδ0 hlδ hδϖ hϖ1 m u hu
  have hone : ∀ x : PadicComplex p, ‖x‖ ≤ 1 → ‖dwTheta p lam x - (1 + ϖ * x)‖ ≤ δ := by
    intro x hx
    have hfb : ∀ k, ‖lam k * x ^ k‖ ≤ ‖lam k‖ := by
      intro k
      rw [norm_mul, norm_pow]
      exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hx)
    have hsum : Summable (fun k => lam k * x ^ k) :=
      Summable.of_norm_bounded (summable_geometric_of_lt_one hr0 hr1)
        (fun k => (hfb k).trans (hlr k))
    have hsplit := hsum.sum_add_tsum_nat_add 2
    have e : dwTheta p lam x - (1 + ϖ * x) = ∑' k, lam (k + 2) * x ^ (k + 2) := by
      unfold dwTheta
      rw [← hsplit]
      simp only [Finset.sum_range_succ, Finset.sum_range_zero, hl0, hl1, pow_zero, pow_one,
        one_mul, zero_add]
      ring
    rw [e]
    exact IsUltrametricDist.norm_tsum_le_of_forall_le_of_nonneg hδ0
      (fun k => (hfb _).trans (hlδ _ (by omega)))
  have hϖ2 : ‖ϖ‖ ^ 2 ≤ ‖ϖ‖ := by
    rw [sq]; exact mul_le_of_le_one_right (norm_nonneg _) hϖ1
  have hMϖ : max δ (‖ϖ‖ ^ 2) ≤ ‖ϖ‖ := max_le hδϖ hϖ2
  have hδM : δ ≤ max δ (‖ϖ‖ ^ 2) := le_max_left _ _
  have h2M : ‖ϖ‖ ^ 2 ≤ max δ (‖ϖ‖ ^ 2) := le_max_right _ _
  induction m with
  | zero =>
    rw [Finset.prod_range_zero, Finset.sum_range_zero, mul_zero, add_zero, sub_self, norm_zero]
    exact le_trans hδ0 hδM
  | succ m ih =>
    rw [Finset.prod_range_succ, Finset.sum_range_succ]
    have hε := hone (u m) (hu m)
    have hs : ‖∑ i ∈ Finset.range m, u i‖ ≤ 1 :=
      IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one (fun i _ => hu i)
    generalize ∏ i ∈ Finset.range m, dwTheta p lam (u i) = P at ih ⊢
    generalize ∑ i ∈ Finset.range m, u i = s at ih hs ⊢
    generalize dwTheta p lam (u m) = T at hε ⊢
    have e : P * T - (1 + ϖ * (s + u m)) = (P - (1 + ϖ * s)) + (T - (1 + ϖ * u m)) +
        (ϖ * s + (P - (1 + ϖ * s))) * (ϖ * u m + (T - (1 + ϖ * u m))) := by ring
    rw [e]
    have hA : ‖ϖ * s + (P - (1 + ϖ * s))‖ ≤ ‖ϖ‖ := by
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ (ih.trans hMϖ))
      rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) hs
    have hB : ‖ϖ * u m + (T - (1 + ϖ * u m))‖ ≤ ‖ϖ‖ := by
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ (hε.trans hδϖ))
      rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) (hu m)
    have hAB : ‖(ϖ * s + (P - (1 + ϖ * s))) * (ϖ * u m + (T - (1 + ϖ * u m)))‖ ≤
        max δ (‖ϖ‖ ^ 2) := by
      rw [norm_mul]
      refine le_trans ?_ h2M
      rw [sq]; exact mul_le_mul hA hB (norm_nonneg _) (norm_nonneg _)
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ hAB)
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ih (hε.trans hδM))

theorem dwork_splitting : ∀ (p : ℕ) [Fact p.Prime], dwCBounds p →
    ∃ (ζ : PadicComplex p) (lam : ℕ → PadicComplex p) (r₀ : ℝ), 0 ≤ r₀ ∧ r₀ < 1 ∧ ζ ^ p = 1 ∧
      ζ ≠ 1 ∧ (∀ k, ‖lam k‖ ≤ r₀ ^ k) ∧ dwSplit p ζ lam :=
by
  intro p _ hC
  have hp : p.Prime := Fact.out
  have hp2 : 2 ≤ p := hp.two_le

  have hN : ∀ q : ℚ, ‖(q : PadicComplex p)‖ = (padicNorm p q : ℝ) := by
    intro q
    have h1 : ((q : PadicAlgCl p) : PadicComplex p) = (q : PadicComplex p) :=
      map_ratCast UniformSpace.Completion.coeRingHom q
    rw [← h1, PadicComplex.norm_extends, ← algebraMap.coe_ratCast ℚ_[p] (PadicAlgCl p) q,
      PadicAlgCl.norm_extends, Padic.eq_padicNorm]
  have hNp : ‖(p : PadicComplex p)‖ = (p : ℝ)⁻¹ := by
    have h := hN (p : ℚ)
    rw [Rat.cast_natCast] at h
    rw [h, padicNorm.padicNorm_p_of_prime]
    push_cast
    rfl

  obtain ⟨ϖ, hϖ⟩ := IsAlgClosed.exists_pow_nat_eq (-(p : PadicComplex p)) (show 0 < p - 1 by omega)
  have hPinv : (p : ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt)
  have hPinv0 : 0 < (p : ℝ)⁻¹ := by positivity
  have hϖn : ‖ϖ‖ ^ (p - 1) = (p : ℝ)⁻¹ := by rw [← norm_pow, hϖ, norm_neg, hNp]
  have hϖpos : 0 < ‖ϖ‖ := by
    rcases (norm_nonneg ϖ).lt_or_eq with h | h
    · exact h
    · rw [← h, zero_pow (by omega)] at hϖn; linarith
  have hϖlt : ‖ϖ‖ < 1 := by
    by_contra h
    push_neg at h
    have := one_le_pow₀ (n := p - 1) h
    linarith

  let lam : ℕ → PadicComplex p := fun k => ϖ ^ k * (dwCDw p k : PadicComplex p)
  obtain ⟨r₀, δ, hr₀0, hr₀1, hδ0, hδϖ, hlamr, hlamδ⟩ := dwork_lam_bounds p hC hN ϖ hϖ
  have hc0 : dwCDw p 0 = 1 := by simp [dwCDw]
  have hc1 : dwCDw p 1 = 1 := by
    have h : 1 / p = 0 := Nat.div_eq_of_lt (by omega)
    simp [dwCDw, h]
  have hlam0 : lam 0 = 1 := by simp [lam, hc0]
  have hlam1 : lam 1 = ϖ := by simp [lam, hc1]

  have hHH' : PowerSeries.rescale ((p : PadicComplex p) * ϖ) (PowerSeries.exp (PadicComplex p)) *
      PowerSeries.rescale (-((p : PadicComplex p) * ϖ)) (PowerSeries.exp (PadicComplex p)) = 1 := by
    rw [PowerSeries.exp_mul_exp_eq_exp_add, add_neg_cancel]
    simp [PowerSeries.rescale_zero]
  have hanorm : ‖(p : PadicComplex p) * ϖ‖ ^ (p - 1) = ((p : ℝ)⁻¹) ^ p := by
    rw [norm_mul, mul_pow, hϖn, hNp, ← pow_succ, Nat.sub_add_cancel (by omega)]
  have hHb := dwork_exp_rescale_coeff_bound p hN _ hanorm.le
  have hH'b := dwork_exp_rescale_coeff_bound p hN (-((p : PadicComplex p) * ϖ))
    (by rw [norm_neg]; exact hanorm.le)
  have hρ0 : 0 ≤ max r₀ (p : ℝ)⁻¹ := le_max_of_le_left hr₀0
  have hρ1 : max r₀ (p : ℝ)⁻¹ < 1 := max_lt hr₀1 hPinv
  have htel := dwork_theta_telescope p (PowerSeries.mk lam) _ _ (max r₀ (p : ℝ)⁻¹) hρ0 hρ1
    (fun k => by
      rw [PowerSeries.coeff_mk]
      exact (hlamr k).trans (pow_le_pow_left₀ hr₀0 (le_max_left _ _) k))
    (fun k => (hHb k).trans (pow_le_pow_left₀ hPinv0.le (le_max_right _ _) k))
    (fun k => (hH'b k).trans (pow_le_pow_left₀ hPinv0.le (le_max_right _ _) k))
    hHH' (dwork_lam_series_pow p ϖ hϖ)
  have hpow : ∀ m, 1 ≤ m → ∀ t : PadicComplex p, t ^ (p ^ m) = t →
      (∏ i ∈ Finset.range m, dwTheta p lam (t ^ (p ^ i))) ^ p = 1 := by
    intro m hm t ht
    have h := htel m hm t ht
    simp only [PowerSeries.coeff_mk] at h
    exact h
  have hζp : dwTheta p lam 1 ^ p = 1 := by
    have h := hpow 1 le_rfl 1 (one_pow _)
    simpa using h

  have hM : max δ (‖ϖ‖ ^ 2) < ‖ϖ‖ := by
    refine max_lt hδϖ ?_
    rw [sq]
    exact mul_lt_of_lt_one_left hϖpos hϖlt
  have hcong := dwork_theta_congruence p lam ϖ r₀ δ hr₀0 hr₀1 hlam0 hlam1 hlamr hδ0 hlamδ
    hδϖ.le hϖlt.le
  have hζj : ∀ j : ℕ, ‖dwTheta p lam 1 ^ j - (1 + ϖ * (j : PadicComplex p))‖ ≤
      max δ (‖ϖ‖ ^ 2) := by
    intro j
    have h := hcong j (fun _ => 1) (fun _ => by simp)
    simpa [Finset.prod_const, Finset.sum_const] using h
  have hζ1 : dwTheta p lam 1 ≠ 1 := by
    intro h
    have h' := hζj 1
    rw [pow_one, h] at h'
    have e : (1 : PadicComplex p) - (1 + ϖ * ((1 : ℕ) : PadicComplex p)) = -ϖ := by
      push_cast; ring
    rw [e, norm_neg] at h'
    linarith
  refine ⟨dwTheta p lam 1, lam, r₀, hr₀0, hr₀1, hζp, hζ1, hlamr, ?_⟩

  intro m hm t ht j hj
  have ht1 : ‖t‖ ≤ 1 := by
    by_contra h
    push_neg at h
    have h1 : 1 < p ^ m := Nat.one_lt_pow (by omega) hp.one_lt
    have h2 := lt_self_pow₀ h h1
    rw [← norm_pow, ht] at h2
    exact lt_irrefl _ h2
  have hu : ∀ i, ‖t ^ (p ^ i)‖ ≤ 1 := fun i => by
    rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) ht1
  have h1 := hcong m (fun i => t ^ (p ^ i)) hu
  have hηp := hpow m hm t ht
  generalize hη : ∏ i ∈ Finset.range m, dwTheta p lam (t ^ (p ^ i)) = η at h1 hηp ⊢
  generalize hs : ∑ i ∈ Finset.range m, t ^ (p ^ i) = s at h1 hj
  have hzp : (dwTheta p lam 1 ^ j) ^ p = 1 := by
    rw [← pow_mul, mul_comm, pow_mul, hζp, one_pow]
  have h2 : ‖η - dwTheta p lam 1 ^ j‖ < ‖ϖ‖ := by
    have e : η - dwTheta p lam 1 ^ j = ((η - (1 + ϖ * s)) + ϖ * (s - j)) -
        (dwTheta p lam 1 ^ j - (1 + ϖ * (j : PadicComplex p))) := by ring
    rw [e]
    have h3 : ‖ϖ * (s - j)‖ < ‖ϖ‖ := by
      rw [norm_mul]; exact mul_lt_of_lt_one_right hϖpos hj
    calc _ = ‖((η - (1 + ϖ * s)) + ϖ * (s - j)) +
            -(dwTheta p lam 1 ^ j - (1 + ϖ * (j : PadicComplex p)))‖ := by rw [sub_eq_add_neg]
      _ ≤ max ‖(η - (1 + ϖ * s)) + ϖ * (s - j)‖
            ‖-(dwTheta p lam 1 ^ j - (1 + ϖ * (j : PadicComplex p)))‖ :=
          IsUltrametricDist.norm_add_le_max _ _
      _ < ‖ϖ‖ := by
        rw [norm_neg]
        exact max_lt (lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _)
          (max_lt (h1.trans_lt hM) h3)) ((hζj j).trans_lt hM)
  generalize hz : dwTheta p lam 1 ^ j = z at hzp h2 ⊢
  have hz0 : z ≠ 0 := by
    intro h; rw [h, zero_pow (by omega)] at hzp; exact zero_ne_one hzp
  have hznorm : ‖z‖ = 1 := by
    have h := congrArg norm hzp
    rw [norm_pow, norm_one] at h
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) (by omega)).mp h
  have hξp : (η * z⁻¹) ^ p = 1 := by rw [mul_pow, inv_pow, hηp, hzp, inv_one, mul_one]
  have hξ : ‖η * z⁻¹ - 1‖ ^ (p - 1) < (p : ℝ)⁻¹ := by
    have e : η * z⁻¹ - 1 = (η - z) * z⁻¹ := by rw [sub_mul, mul_inv_cancel₀ hz0]
    rw [e, norm_mul, norm_inv, hznorm, inv_one, mul_one, ← hϖn]
    exact pow_lt_pow_left₀ h2 (norm_nonneg _) (by omega)
  exact (mul_inv_eq_one₀ hz0).mp (padic_root_of_unity_sep p hN _ hξp hξ)

theorem teichmuller_lift : ∀ (F : Type u) [Field F] [Finite F] (p : ℕ) [Fact p.Prime], ringChar F = p →
    ∃ ωF : F → PadicComplex p, (∀ a, ωF a ^ Nat.card F = ωF a) ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E], ∃ ω : E → PadicComplex p,
        (∀ a, ω (algebraMap F E a) = ωF a) ∧ ω 0 = 0 ∧ (∀ x y, ω (x * y) = ω x * ω y) ∧
        Function.Injective ω ∧ (∀ x y, ‖ω (x + y) - ω x - ω y‖ < 1) ∧ (∀ x, ‖ω x‖ ≤ 1) ∧
        (∀ ξ : PadicComplex p, ξ ^ Nat.card E = ξ ↔ ∃ x, ω x = ξ) :=
by
  intro F _ _ p _ hchar
  classical
  have hpp : p.Prime := Fact.out

  have hO_add : ∀ {x y : PadicComplex p}, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → ‖x + y‖ ≤ 1 := fun {x y} hx hy =>
    (IsUltrametricDist.norm_add_le_max x y).trans (max_le hx hy)
  have hO_mul : ∀ {x y : PadicComplex p}, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → ‖x * y‖ ≤ 1 := fun {x y} hx hy => by
    rw [norm_mul]; exact mul_le_one₀ hx (norm_nonneg _) hy
  have hO_sub : ∀ {x y : PadicComplex p}, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → ‖x - y‖ ≤ 1 := fun {x y} hx hy => by
    rw [sub_eq_add_neg]; exact hO_add hx (by rw [norm_neg]; exact hy)
  let O : Subring (PadicComplex p) :=
    { carrier := {x | ‖x‖ ≤ 1}
      mul_mem' := fun {a b} ha hb => hO_mul ha hb
      one_mem' := by simp
      add_mem' := fun {a b} ha hb => hO_add ha hb
      zero_mem' := by simp
      neg_mem' := fun {a} ha => by simpa using ha }
  let m : Ideal O :=
    { carrier := {x | ‖(x : PadicComplex p)‖ < 1}
      add_mem' := fun {a b} ha hb =>
        (IsUltrametricDist.norm_add_le_max (a : PadicComplex p) b).trans_lt (max_lt ha hb)
      zero_mem' := by simp
      smul_mem' := fun c x hx => by
        have hc : ‖(c : PadicComplex p)‖ ≤ 1 := c.2
        have hx' : ‖(x : PadicComplex p)‖ < 1 := hx
        show ‖(c : PadicComplex p) * (x : PadicComplex p)‖ < 1
        rw [norm_mul]
        calc ‖(c : PadicComplex p)‖ * ‖(x : PadicComplex p)‖ ≤ 1 * ‖(x : PadicComplex p)‖ :=
              mul_le_mul_of_nonneg_right hc (norm_nonneg _)
          _ < 1 := by rw [one_mul]; exact hx' }
  have hmax : m.IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h => ?_, fun J x hJ hx hxJ => ?_⟩
    · have h' : ‖((1 : O) : PadicComplex p)‖ < 1 := h
      simp at h'
    · have hx1 : ‖(x : PadicComplex p)‖ = 1 := le_antisymm x.2 (not_lt.mp hx)
      have hx0 : (x : PadicComplex p) ≠ 0 := by
        intro h; rw [h, norm_zero] at hx1; exact zero_ne_one hx1
      let y : O := ⟨(x : PadicComplex p)⁻¹, show ‖(x : PadicComplex p)⁻¹‖ ≤ 1 by
        rw [norm_inv, hx1, inv_one]⟩
      have hyx : y * x = 1 := Subtype.ext (inv_mul_cancel₀ hx0)
      rw [← hyx]; exact J.mul_mem_left y hxJ
  haveI := hmax
  letI : Field (O ⧸ m) := Ideal.Quotient.field m
  let red : PadicComplex p → O ⧸ m := fun x =>
    if h : ‖x‖ ≤ 1 then Ideal.Quotient.mk m ⟨x, h⟩ else 0
  have hred : ∀ x (h : ‖x‖ ≤ 1), red x = Ideal.Quotient.mk m ⟨x, h⟩ := fun x h => by
    simp only [red, dif_pos h]
  have red0 : red 0 = 0 := by
    rw [hred 0 (by simp)]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (show ‖(0 : PadicComplex p)‖ < 1 by simp)
  have red1 : red 1 = 1 := by
    rw [hred 1 (by simp)]
    exact map_one (Ideal.Quotient.mk m)
  have hadd : ∀ x y : PadicComplex p, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → red (x + y) = red x + red y := by
    intro x y hx hy
    rw [hred _ hx, hred _ hy, hred _ (hO_add hx hy), ← map_add]
    rfl
  have hmul : ∀ x y : PadicComplex p, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → red (x * y) = red x * red y := by
    intro x y hx hy
    rw [hred _ hx, hred _ hy, hred _ (hO_mul hx hy), ← map_mul]
    rfl
  have hker : ∀ x : PadicComplex p, ‖x‖ ≤ 1 → (red x = 0 ↔ ‖x‖ < 1) := by
    intro x hx
    rw [hred x hx, Ideal.Quotient.eq_zero_iff_mem]
    exact Iff.rfl
  have hsub : ∀ x y : PadicComplex p, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → red (x - y) = red x - red y := by
    intro x y hx hy
    have h := hadd (x - y) y (hO_sub hx hy) hy
    rw [sub_add_cancel] at h
    exact eq_sub_of_add_eq h.symm
  have hredpow : ∀ ξ : PadicComplex p, ‖ξ‖ ≤ 1 → ∀ n : ℕ, red (ξ ^ n) = red ξ ^ n := by
    intro ξ hξ n
    induction n with
    | zero => rw [pow_zero, pow_zero, red1]
    | succ n ih =>
      rw [pow_succ, pow_succ, hmul _ _ (by rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) hξ) hξ,
        ih]
  have hp1 : ‖((p : ℕ) : PadicComplex p)‖ < 1 := by
    rw [← map_natCast (algebraMap ℚ_[p] (PadicComplex p)) p, norm_algebraMap']
    exact Padic.norm_natCast_lt_one_iff.mpr dvd_rfl
  have hk : CharP (O ⧸ m) p := by
    rw [CharP.charP_iff_prime_eq_zero hpp]
    rw [← map_natCast (Ideal.Quotient.mk m), Ideal.Quotient.eq_zero_iff_mem]
    show ‖((p : O) : PadicComplex p)‖ < 1
    have hc : ((p : O) : PadicComplex p) = (p : PadicComplex p) := map_natCast O.subtype p
    rw [hc]; exact hp1

  have hroots : ∀ Q : ℕ, 2 ≤ Q → p ∣ Q → ∃ R : Finset (PadicComplex p), R.card = Q ∧
      (∀ ξ, ξ ∈ R ↔ ξ ^ Q = ξ) ∧ (∀ ξ ∈ R, ‖ξ‖ ≤ 1) ∧
      (∀ ξ ∈ R, ∀ ξ' ∈ R, ‖ξ - ξ'‖ < 1 → ξ = ξ') := by
    intro Q hQ hpQ
    obtain ⟨N, rfl⟩ : ∃ N, Q = N + 1 := ⟨Q - 1, by omega⟩
    have hN : 0 < N := by omega
    haveI : NeZero N := ⟨hN.ne'⟩
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (PadicComplex p) N
    have hcard := hζ.card_nthRootsFinset
    have hmemN : ∀ ξ : PadicComplex p, ξ ∈ Polynomial.nthRootsFinset N (1 : PadicComplex p) ↔
        ξ ^ N = 1 := fun ξ => Polynomial.mem_nthRootsFinset hN (1 : PadicComplex p)
    have h0 : (0 : PadicComplex p) ∉ Polynomial.nthRootsFinset N (1 : PadicComplex p) := by
      rw [hmemN, zero_pow hN.ne']; exact zero_ne_one
    have hunit : ∀ ξ : PadicComplex p, ξ ^ N = 1 → ‖ξ‖ = 1 := by
      intro ξ h
      have h' := congrArg norm h
      rw [norm_pow, norm_one] at h'
      exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) hN.ne').mp h'
    have hNn : ‖((N : ℕ) : PadicComplex p)‖ = 1 := by
      rw [← map_natCast (algebraMap ℚ_[p] (PadicComplex p)) N, norm_algebraMap',
        Padic.norm_natCast_eq_one_iff, Nat.Prime.coprime_iff_not_dvd hpp]
      intro h
      have h1 : p ∣ 1 := (Nat.dvd_add_right h).mp hpQ
      exact hpp.one_lt.ne' (Nat.dvd_one.mp h1)
    refine ⟨insert 0 (Polynomial.nthRootsFinset N (1 : PadicComplex p)), ?_, ?_, ?_, ?_⟩
    · rw [Finset.card_insert_of_notMem h0, hcard]
    · intro ξ
      rw [Finset.mem_insert, hmemN]
      constructor
      · rintro (rfl | h)
        · exact zero_pow (by omega)
        · rw [pow_succ, h, one_mul]
      · intro h
        by_cases hξ : ξ = 0
        · exact Or.inl hξ
        · right
          rw [pow_succ] at h
          exact (mul_eq_right₀ hξ).mp h
    · intro ξ hξ
      rw [Finset.mem_insert, hmemN] at hξ
      rcases hξ with rfl | h
      · simp
      · exact (hunit ξ h).le
    · intro ξ hξ ξ' hξ' hlt
      rw [Finset.mem_insert, hmemN] at hξ hξ'
      rcases hξ with rfl | hξ
      · rcases hξ' with rfl | hξ'
        · rfl
        · exfalso; rw [zero_sub, norm_neg, hunit _ hξ'] at hlt; exact lt_irrefl _ hlt
      · rcases hξ' with rfl | hξ'
        · exfalso; rw [sub_zero, hunit _ hξ] at hlt; exact lt_irrefl _ hlt
        · have hξ'0 : ξ' ≠ 0 := by
            intro h; rw [h, zero_pow hN.ne'] at hξ'; exact zero_ne_one hξ'
          obtain ⟨η, hη⟩ : ∃ η, η = ξ * ξ'⁻¹ := ⟨_, rfl⟩
          have hηN : η ^ N = 1 := by rw [hη, mul_pow, inv_pow, hξ, hξ', inv_one, one_mul]
          have hηn : ‖η‖ = 1 := hunit η hηN
          have hη1 : ‖η - 1‖ < 1 := by
            have h' : η - 1 = (ξ - ξ') * ξ'⁻¹ := by rw [hη, sub_mul, mul_inv_cancel₀ hξ'0]
            rw [h', norm_mul, norm_inv, hunit _ hξ', inv_one, mul_one]; exact hlt
          by_contra hne
          have hη1' : η ≠ 1 := by
            intro h; apply hne; rw [hη] at h; exact (mul_inv_eq_one₀ hξ'0).mp h
          have hsum : ∑ i ∈ Finset.range N, η ^ i = 0 := by
            have h' := geom_sum_mul η N
            rw [hηN, sub_self] at h'
            exact (mul_eq_zero.mp h').resolve_right (sub_ne_zero.mpr hη1')
          have hle : ∀ i ∈ Finset.range N, ‖η ^ i - 1‖ ≤ ‖η - 1‖ := by
            intro i _
            rw [← geom_sum_mul, norm_mul]
            have h' : ‖∑ j ∈ Finset.range i, η ^ j‖ ≤ 1 :=
              IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
                (fun j _ => by rw [norm_pow, hηn, one_pow])
            calc ‖∑ j ∈ Finset.range i, η ^ j‖ * ‖η - 1‖ ≤ 1 * ‖η - 1‖ :=
                  mul_le_mul_of_nonneg_right h' (norm_nonneg _)
              _ = ‖η - 1‖ := one_mul _
          have hNeq : ((N : ℕ) : PadicComplex p) = -∑ i ∈ Finset.range N, (η ^ i - 1) := by
            rw [Finset.sum_sub_distrib, hsum]; simp
          have h' : ‖((N : ℕ) : PadicComplex p)‖ ≤ ‖η - 1‖ := by
            rw [hNeq, norm_neg]
            exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (norm_nonneg _) hle
          rw [hNn] at h'
          exact lt_irrefl _ (h'.trans_lt hη1)

  have hsepQ : ∀ Q : ℕ, 2 ≤ Q → p ∣ Q → ∀ ξ ξ' : PadicComplex p, ξ ^ Q = ξ → ξ' ^ Q = ξ' →
      red ξ = red ξ' → ξ = ξ' := by
    intro Q hQ hpQ ξ ξ' h h' hr
    obtain ⟨R, -, hRm, hRn, hRs⟩ := hroots Q hQ hpQ
    have hξ := (hRm ξ).mpr h
    have hξ' := (hRm ξ').mpr h'
    refine hRs ξ hξ ξ' hξ' ((hker _ (hO_sub (hRn ξ hξ) (hRn ξ' hξ'))).mp ?_)
    rw [hsub _ _ (hRn ξ hξ) (hRn ξ' hξ'), hr, sub_self]

  have hmain : ∀ (B : Type u) [Field B] (K : Type u) [Field K] [Finite K] [Algebra B K]
      [Algebra B (O ⧸ m)], p ∣ Nat.card K → ∃ φ : K →ₐ[B] (O ⧸ m), ∃ ω : K → PadicComplex p,
        (∀ x, ω x ^ Nat.card K = ω x ∧ red (ω x) = φ x) ∧ ω 0 = 0 ∧
        (∀ x y, ω (x * y) = ω x * ω y) ∧ Function.Injective ω ∧
        (∀ x y, ‖ω (x + y) - ω x - ω y‖ < 1) ∧ (∀ x, ‖ω x‖ ≤ 1) ∧
        (∀ ξ : PadicComplex p, ξ ^ Nat.card K = ξ ↔ ∃ x, ω x = ξ) := by
    intro B _ K _ _ _ _ hpK
    haveI := Fintype.ofFinite K
    obtain ⟨Q, hQ⟩ : ∃ Q, Q = Nat.card K := ⟨_, rfl⟩
    rw [← hQ] at hpK ⊢
    have hQ2 : 2 ≤ Q := by rw [hQ]; exact Finite.one_lt_card
    have hQc : Fintype.card K = Q := by rw [hQ]; exact Fintype.card_eq_nat_card
    obtain ⟨R, hRc, hRm, hRn, hRs⟩ := hroots Q hQ2 hpK
    have hRinj : Set.InjOn red ↑R := fun ξ hξ ξ' hξ' h =>
      hsepQ Q hQ2 hpK ξ ξ' ((hRm ξ).mp hξ) ((hRm ξ').mp hξ') h
    obtain ⟨T, hT⟩ : ∃ T, T = R.image red := ⟨_, rfl⟩
    have hTc : T.card = Q := by rw [hT, Finset.card_image_of_injOn hRinj, hRc]
    have hTr : ∀ t ∈ T, t ^ Q = t := by
      intro t ht
      rw [hT] at ht
      obtain ⟨ξ, hξ, rfl⟩ := Finset.mem_image.mp ht
      rw [← hredpow ξ (hRn ξ hξ) Q, (hRm ξ).mp hξ]
    let f : Polynomial B := Polynomial.X ^ Q - Polynomial.X
    haveI hsf : Polynomial.IsSplittingField B K f := by
      have h := FiniteField.isSplittingField_sub K B
      rw [hQc] at h
      exact h
    have hg : Polynomial.map (algebraMap B (O ⧸ m)) f = Polynomial.X ^ Q - Polynomial.X := by
      simp [f]
    have hg0 : (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m)) ≠ 0 :=
      FiniteField.X_pow_card_sub_X_ne_zero _ (by omega)
    have hgd : (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m)).natDegree = Q :=
      FiniteField.X_pow_card_sub_X_natDegree_eq _ (by omega)
    have hTroots : T.val ≤ (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m)).roots := by
      rw [Multiset.le_iff_subset T.nodup]
      intro t ht
      rw [Polynomial.mem_roots hg0, Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
        Polynomial.eval_X, hTr t ht, sub_self]
    have hcardle := Polynomial.card_roots' (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m))
    have hTeq : T.val = (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m)).roots :=
      Multiset.eq_of_le_of_card_le hTroots (hcardle.trans (hgd.trans hTc.symm).le)
    have hspl : (Polynomial.map (algebraMap B (O ⧸ m)) f).Splits := by
      rw [hg, Polynomial.splits_iff_card_roots, hgd, ← hTeq]
      exact hTc
    let φ : K →ₐ[B] (O ⧸ m) := Polynomial.IsSplittingField.lift K f hspl
    have hφinj : Function.Injective φ := (φ : K →+* O ⧸ m).injective
    have hφT : ∀ x, φ x ∈ T := by
      intro x
      have hr : (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m)).IsRoot (φ x) := by
        rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
          ← map_pow, ← hQc, FiniteField.pow_card, sub_self]
      have hm : φ x ∈ (Polynomial.X ^ Q - Polynomial.X : Polynomial (O ⧸ m)).roots :=
        (Polynomial.mem_roots hg0).mpr hr
      rw [← hTeq] at hm
      exact hm
    have hTφ : ∀ t ∈ T, ∃ x, φ x = t := by
      have hsubT : Finset.univ.image φ ⊆ T := fun t ht => by
        obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp ht
        exact hφT x
      have heq : Finset.univ.image φ = T := Finset.eq_of_subset_of_card_le hsubT (by
        rw [Finset.card_image_of_injective _ hφinj, Finset.card_univ, hQc, hTc])
      intro t ht
      rw [← heq] at ht
      obtain ⟨x, _, hx⟩ := Finset.mem_image.mp ht
      exact ⟨x, hx⟩
    have hex : ∀ x : K, ∃ ξ ∈ R, red ξ = φ x := fun x => by
      have h := hφT x
      rw [hT] at h
      exact Finset.mem_image.mp h
    choose ω hωR hωred using hex
    have hωroot : ∀ x, ω x ^ Q = ω x := fun x => (hRm _).mp (hωR x)
    have hωn : ∀ x, ‖ω x‖ ≤ 1 := fun x => hRn _ (hωR x)
    have h0R : (0 : PadicComplex p) ∈ R := (hRm 0).mpr (zero_pow (by omega))
    refine ⟨φ, ω, fun x => ⟨hωroot x, hωred x⟩, ?_, ?_, ?_, ?_, hωn, ?_⟩
    · exact hRinj (hωR 0) h0R (by rw [hωred, map_zero, red0])
    · intro x y
      have hmR : ω x * ω y ∈ R := (hRm _).mpr (by rw [mul_pow, hωroot, hωroot])
      exact hRinj (hωR (x * y)) hmR (by rw [hωred, hmul _ _ (hωn x) (hωn y), hωred, hωred, map_mul])
    · intro x y h
      apply hφinj
      rw [← hωred, ← hωred, h]
    · intro x y
      have hn2 : ‖ω (x + y) - ω x‖ ≤ 1 := hO_sub (hωn _) (hωn x)
      have hn3 : ‖ω (x + y) - ω x - ω y‖ ≤ 1 := hO_sub hn2 (hωn y)
      refine (hker _ hn3).mp ?_
      rw [hsub _ _ hn2 (hωn y), hsub _ _ (hωn _) (hωn x), hωred, hωred, hωred, map_add]
      ring
    · intro ξ
      constructor
      · intro h
        have hξR := (hRm ξ).mpr h
        have hrT : red ξ ∈ T := by rw [hT]; exact Finset.mem_image_of_mem red hξR
        obtain ⟨x, hx⟩ := hTφ _ hrT
        exact ⟨x, hRinj (hωR x) hξR (by rw [hωred, hx])⟩
      · rintro ⟨x, rfl⟩
        exact hωroot x

  haveI : CharP F p := by rw [← hchar]; exact ringChar.charP F
  haveI := Fintype.ofFinite F
  obtain ⟨a, -, hcardF⟩ := FiniteField.card F p
  have hQF : Nat.card F = p ^ (a : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hcardF
  have hpF : p ∣ Nat.card F := by rw [hQF]; exact dvd_pow_self p a.ne_zero
  have hQ2 : 2 ≤ Nat.card F := Finite.one_lt_card
  haveI := hk
  letI : Algebra (ULift.{u} (ZMod p)) F :=
    ((ZMod.castHom (dvd_refl p) F).comp ULift.ringEquiv.toRingHom).toAlgebra
  letI : Algebra (ULift.{u} (ZMod p)) (O ⧸ m) :=
    ((ZMod.castHom (dvd_refl p) (O ⧸ m)).comp ULift.ringEquiv.toRingHom).toAlgebra
  obtain ⟨φF, ωF, hωF1, -, -, -, -, -, -⟩ := hmain (ULift.{u} (ZMod p)) F hpF
  refine ⟨ωF, fun c => (hωF1 c).1, ?_⟩
  intro E _ _ _
  haveI : Finite E := Module.finite_of_finite F
  have hn : 0 < Module.finrank F E := Module.finrank_pos
  have hcardE : Nat.card E = Nat.card F ^ Module.finrank F E := Module.natCard_eq_pow_finrank
  have hpE : p ∣ Nat.card E := by rw [hcardE]; exact dvd_pow hpF hn.ne'
  have hE2 : 2 ≤ Nat.card E := by rw [hcardE]; exact le_trans hQ2 (Nat.le_self_pow hn.ne' _)
  letI : Algebra F (O ⧸ m) := (φF : F →+* O ⧸ m).toAlgebra
  obtain ⟨φE, ω, hω1, h0, hmul', hinj, hadd', hle, hrange⟩ := hmain F E hpE
  refine ⟨ω, ?_, h0, hmul', hinj, hadd', hle, hrange⟩
  intro c
  apply hsepQ (Nat.card E) hE2 hpE
  · exact (hω1 _).1
  · have hpow : ∀ k : ℕ, ωF c ^ (Nat.card F ^ k) = ωF c := by
      intro k
      induction k with
      | zero => simp
      | succ k ih => rw [pow_succ, pow_mul, ih, (hωF1 c).1]
    rw [hcardE]; exact hpow _
  · rw [(hω1 _).2, (hωF1 c).2, AlgHom.commutes]
    rfl

theorem dwti_root_orthogonality : ∀ (K : Type) [Field K] [IsAlgClosed K] [CharZero K] (τ : Type) [Fintype τ] [DecidableEq τ] (N : ℕ), 1 ≤ N → ∀ M : τ → ℕ, ∑ x ∈ Fintype.piFinset (fun _ : τ => Polynomial.nthRootsFinset N (1 : K)), ∏ i, x i ^ M i = if ∀ i, N ∣ M i then (N : K) ^ Fintype.card τ else 0 :=
by
  intro K _ _ _ τ _ _ N hN M
  have hN0 : 0 < N := hN
  haveI : NeZero (N : K) := ⟨Nat.cast_ne_zero.mpr (by omega)⟩
  obtain ⟨ζ, hζr⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic N K)
    (ne_of_gt (Polynomial.degree_cyclotomic_pos N K hN0))
  have hζ : IsPrimitiveRoot ζ N := (Polynomial.isRoot_cyclotomic_iff).mp hζr
  have hmem : ∀ x : K, x ∈ Polynomial.nthRootsFinset N (1 : K) ↔ x ^ N = 1 :=
    fun x => Polynomial.mem_nthRootsFinset hN0 1
  have hS : ∀ m : ℕ, ∑ x ∈ Polynomial.nthRootsFinset N (1 : K), x ^ m =
      if N ∣ m then (N : K) else 0 := by
    intro m
    split_ifs with hd
    · obtain ⟨k, rfl⟩ := hd
      rw [Finset.sum_congr rfl (fun x hx => by rw [pow_mul, (hmem x).mp hx, one_pow]),
        Finset.sum_const, hζ.card_nthRootsFinset, nsmul_eq_mul, mul_one]
    · have hne : ζ ^ m ≠ 1 := fun h => hd ((hζ.pow_eq_one_iff_dvd m).mp h)
      have hre : ∑ x ∈ Polynomial.nthRootsFinset N (1 : K), (ζ * x) ^ m =
          ∑ x ∈ Polynomial.nthRootsFinset N (1 : K), x ^ m := by
        refine Finset.sum_nbij' (fun x => ζ * x) (fun x => ζ ^ (N - 1) * x) ?_ ?_ ?_ ?_ ?_
        · intro x hx
          have hx' := (hmem x).mp hx
          show ζ * x ∈ Polynomial.nthRootsFinset N (1 : K)
          rw [hmem, mul_pow, hζ.pow_eq_one, hx', one_mul]
        · intro x hx
          have hx' := (hmem x).mp hx
          show ζ ^ (N - 1) * x ∈ Polynomial.nthRootsFinset N (1 : K)
          rw [hmem, mul_pow, ← pow_mul, mul_comm (N - 1) N, pow_mul, hζ.pow_eq_one, one_pow,
            hx', one_mul]
        · intro x _
          show ζ ^ (N - 1) * (ζ * x) = x
          rw [← mul_assoc, ← pow_succ, Nat.sub_add_cancel hN, hζ.pow_eq_one, one_mul]
        · intro x _
          show ζ * (ζ ^ (N - 1) * x) = x
          rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hN, hζ.pow_eq_one, one_mul]
        · intro x _
          rfl
      simp only [mul_pow] at hre
      rw [← Finset.mul_sum] at hre
      have h2 : (ζ ^ m - 1) * ∑ x ∈ Polynomial.nthRootsFinset N (1 : K), x ^ m = 0 := by
        rw [sub_mul, hre, one_mul, sub_self]
      exact (mul_eq_zero.mp h2).resolve_left (sub_ne_zero.mpr hne)
  rw [show (∑ x ∈ Fintype.piFinset (fun _ : τ => Polynomial.nthRootsFinset N (1 : K)),
      ∏ i, x i ^ M i) = ∏ i, ∑ y ∈ Polynomial.nthRootsFinset N (1 : K), y ^ M i from
    Finset.sum_prod_piFinset _ (fun i y => y ^ M i)]
  rw [Finset.prod_congr rfl (fun i _ => hS (M i))]
  split_ifs with h
  · rw [Finset.prod_congr rfl (fun i _ => if_pos (h i)), Finset.prod_const, Finset.card_univ]
  · push_neg at h
    obtain ⟨i₀, hi₀⟩ := h
    exact Finset.prod_eq_zero (Finset.mem_univ i₀) (if_neg hi₀)

theorem dwti_cycle_scalar : ∀ (q n : ℕ), 2 ≤ q → 1 ≤ n → ∀ c : Fin n → ℕ, ((q ^ n - 1) ∣ ∑ j : Fin n, q ^ (j : ℕ) * c j ↔ ∃ u : Fin n → ℕ, ∀ j, u (finRotate n j) + c (Fin.rev j) = q * u j) ∧ ∀ u u' : Fin n → ℕ, (∀ j, u (finRotate n j) + c (Fin.rev j) = q * u j) → (∀ j, u' (finRotate n j) + c (Fin.rev j) = q * u' j) → u = u' :=
by

  have s2 : ∀ (q : ℤ) (b x : ℕ → ℤ) (K : ℕ), (∀ k, k < K → x (k + 1) = q * x k - b k) →
      x K + ∑ k ∈ Finset.range K, q ^ (K - 1 - k) * b k = q ^ K * x 0 := by
    intro q b x K
    induction K with
    | zero => intro _; simp
    | succ K ih =>
      intro h
      have ih' := ih (fun k hk => h k (by omega))
      rw [Finset.sum_range_succ, h K (by omega)]
      have hsum : ∑ k ∈ Finset.range K, q ^ (K + 1 - 1 - k) * b k =
          q * ∑ k ∈ Finset.range K, q ^ (K - 1 - k) * b k := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        have hk' := Finset.mem_range.mp hk
        have e : K + 1 - 1 - k = (K - 1 - k) + 1 := by omega
        rw [e, pow_succ]; ring
      rw [hsum, show K + 1 - 1 - K = 0 by omega, pow_zero, pow_succ]
      linear_combination q * ih'

  have s3 : ∀ (q n : ℕ) (c : Fin n → ℕ), ∑ k ∈ Finset.range n, (q : ℤ) ^ (n - 1 - k) *
      (if h : k < n then (c (Fin.rev ⟨k, h⟩) : ℤ) else 0) =
      ((∑ j : Fin n, q ^ (j : ℕ) * c j : ℕ) : ℤ) := by
    intro q n c
    push_cast
    have h1 : ∑ j : Fin n, (q : ℤ) ^ (j : ℕ) * (c j : ℤ) = ∑ m ∈ Finset.range n,
        (fun m => (q : ℤ) ^ m * (if h : m < n then (c ⟨m, h⟩ : ℤ) else 0)) m := by
      rw [← Fin.sum_univ_eq_sum_range _ n]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp [j.isLt]
    rw [h1]
    refine Eq.trans ?_ (Finset.sum_range_reflect
      (fun m => (q : ℤ) ^ m * (if h : m < n then (c ⟨m, h⟩ : ℤ) else 0)) n)
    refine Finset.sum_congr rfl (fun k hk => ?_)
    have hk' := Finset.mem_range.mp hk
    have hlt : n - 1 - k < n := by omega
    show _ = (q : ℤ) ^ (n - 1 - k) * (if h : n - 1 - k < n then (c ⟨n - 1 - k, h⟩ : ℤ) else 0)
    rw [dif_pos hk', dif_pos hlt]
    have hrev : Fin.rev (⟨k, hk'⟩ : Fin n) = ⟨n - 1 - k, hlt⟩ := by
      ext; simp only [Fin.val_rev]; omega
    rw [hrev]

  have s4 : ∀ (q : ℤ) (b x : ℕ → ℤ) (K : ℕ), 1 ≤ q → (∀ k, 0 ≤ b k) →
      (∀ k, k < K → x (k + 1) = q * x k - b k) → 0 ≤ x K → ∀ k, k ≤ K → 0 ≤ x k := by
    intro q b x K hq hb hrec hK k hk
    by_contra hneg
    push_neg at hneg
    have key : ∀ m, k + m ≤ K → x (k + m) < 0 := by
      intro m
      induction m with
      | zero => intro _; simpa using hneg
      | succ m ih =>
        intro hm
        have h1 := ih (by omega)
        rw [← add_assoc, hrec (k + m) (by omega)]
        nlinarith [mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr hq) h1.le, hb (k + m)]
    have hK' := key (K - k) (by omega)
    rw [show k + (K - k) = K by omega] at hK'
    linarith

  have s5 : ∀ (q n : ℕ) (c u : Fin n → ℕ) (x b : ℕ → ℤ), (∀ k (h : k < n), x k = (u ⟨k, h⟩ : ℤ)) →
      x n = x 0 → (∀ k (h : k < n), b k = (c (Fin.rev ⟨k, h⟩) : ℤ)) →
      ((∀ j, u (finRotate n j) + c (Fin.rev j) = q * u j) ↔
        ∀ k, k < n → x (k + 1) = (q : ℤ) * x k - b k) := by
    intro q n c u x b hx hxn hb
    have G : ∀ k (h : k < n), (u (finRotate n ⟨k, h⟩) : ℤ) = x (k + 1) := by
      intro k h
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      by_cases hk : k = m
      · subst hk
        have hrot : finRotate (k + 1) ⟨k, h⟩ = ⟨0, by omega⟩ := by
          have hl : (⟨k, h⟩ : Fin (k + 1)) = Fin.last k := rfl
          rw [hl, finRotate_last]; rfl
        rw [hrot, hxn, hx 0 (by omega)]
      · have hrot : finRotate (m + 1) ⟨k, h⟩ = ⟨k + 1, by omega⟩ := by
          ext
          rw [coe_finRotate, if_neg]
          intro h'
          apply hk
          simpa [Fin.ext_iff] using h'
        rw [hrot, hx (k + 1) (by omega)]
    constructor
    · intro hrel k hk
      have h0 := hrel ⟨k, hk⟩
      have h' : ((u (finRotate n ⟨k, hk⟩) : ℕ) : ℤ) + (c (Fin.rev ⟨k, hk⟩) : ℤ) =
          (q : ℤ) * (u ⟨k, hk⟩ : ℤ) := by exact_mod_cast h0
      rw [G, ← hb k hk, ← hx k hk] at h'
      linarith
    · intro hrec j
      obtain ⟨k, hk⟩ := j
      have h1 := hrec k hk
      rw [← G k hk, hx k hk, hb k hk] at h1
      have h2 : ((u (finRotate n ⟨k, hk⟩) : ℕ) : ℤ) + (c (Fin.rev ⟨k, hk⟩) : ℤ) =
          (q : ℤ) * (u ⟨k, hk⟩ : ℤ) := by linarith
      exact_mod_cast h2

  intro q n hq hn c
  have hn0 : 0 < n := hn
  have hqn : q ≤ q ^ n := Nat.le_self_pow (by omega) q
  have hP2 : ((q ^ n - 1 : ℕ) : ℤ) = (q : ℤ) ^ n - 1 := by
    rw [Nat.cast_sub (by omega)]; push_cast; ring
  have hne : (q : ℤ) ^ n - 1 ≠ 0 := by
    have h2 : (2 : ℤ) ≤ (q : ℤ) ^ n := by exact_mod_cast (le_trans hq hqn)
    intro h; linarith
  obtain ⟨b, hbdef⟩ : ∃ b : ℕ → ℤ, b = fun k => if h : k < n then (c (Fin.rev ⟨k, h⟩) : ℤ) else 0 :=
    ⟨_, rfl⟩
  have hb : ∀ k (h : k < n), b k = (c (Fin.rev ⟨k, h⟩) : ℤ) := fun k h => by
    rw [hbdef]; exact dif_pos h
  have hb0 : ∀ k, 0 ≤ b k := by
    intro k; rw [hbdef]; dsimp only; split_ifs <;> positivity
  have hS : ∑ k ∈ Finset.range n, (q : ℤ) ^ (n - 1 - k) * b k =
      ((∑ j : Fin n, q ^ (j : ℕ) * c j : ℕ) : ℤ) := by rw [hbdef]; exact s3 q n c
  obtain ⟨M, hM⟩ : ∃ M, M = ∑ j : Fin n, q ^ (j : ℕ) * c j := ⟨_, rfl⟩
  rw [← hM] at hS ⊢
  obtain ⟨X, hXdef⟩ : ∃ X : (Fin n → ℕ) → ℕ → ℤ,
      X = fun u k => if h : k < n then (u ⟨k, h⟩ : ℤ) else (u ⟨0, hn0⟩ : ℤ) := ⟨_, rfl⟩
  have hX1 : ∀ u k (h : k < n), X u k = (u ⟨k, h⟩ : ℤ) := fun u k h => by
    rw [hXdef]; exact dif_pos h
  have hXn : ∀ u, X u n = X u 0 := fun u => by
    rw [hX1 u 0 hn0, hXdef]; exact dif_neg (lt_irrefl n)
  have KC : ∀ u : Fin n → ℕ, (∀ j, u (finRotate n j) + c (Fin.rev j) = q * u j) →
      (M : ℤ) = ((q : ℤ) ^ n - 1) * (u ⟨0, hn0⟩ : ℤ) ∧
      ∀ k (h : k < n), (u ⟨k, h⟩ : ℤ) =
        (q : ℤ) ^ k * (u ⟨0, hn0⟩ : ℤ) - ∑ i ∈ Finset.range k, (q : ℤ) ^ (k - 1 - i) * b i := by
    intro u hu
    have hrec := (s5 q n c u (X u) b (hX1 u) (hXn u) hb).mp hu
    have h0 : X u 0 = (u ⟨0, hn0⟩ : ℤ) := hX1 u 0 hn0
    constructor
    · have h3 := s2 (q : ℤ) b (X u) n hrec
      rw [hXn u, hS, h0] at h3
      linarith
    · intro k hk
      have h3 := s2 (q : ℤ) b (X u) k (fun i hi => hrec i (by omega))
      rw [hX1 u k hk, h0] at h3
      linarith
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rintro ⟨a, ha⟩
    have ha' : (M : ℤ) = ((q : ℤ) ^ n - 1) * a := by rw [ha, Nat.cast_mul, hP2]
    obtain ⟨x, hx0, hxs⟩ : ∃ x : ℕ → ℤ, x 0 = a ∧ ∀ k, x (k + 1) = (q : ℤ) * x k - b k :=
      ⟨fun k => Nat.rec (motive := fun _ => ℤ) (a : ℤ) (fun k xk => (q : ℤ) * xk - b k) k,
        rfl, fun k => rfl⟩
    have hxn : x n = x 0 := by
      have h3 := s2 (q : ℤ) b x n (fun k _ => hxs k)
      rw [hS, hx0] at h3
      rw [hx0]
      linear_combination h3 - ha'
    have hpos := s4 (q : ℤ) b x n (by exact_mod_cast (by omega : 1 ≤ q)) hb0 (fun k _ => hxs k)
      (by rw [hxn, hx0]; positivity)
    refine ⟨fun j => (x j).toNat,
      (s5 q n c (fun j => (x j).toNat) x b ?_ hxn hb).mpr (fun k _ => hxs k)⟩
    intro k h
    exact (Int.toNat_of_nonneg (hpos k h.le)).symm
  · rintro ⟨u, hu⟩
    obtain ⟨h1, -⟩ := KC u hu
    have hd : ((q ^ n - 1 : ℕ) : ℤ) ∣ (M : ℤ) := ⟨_, by rw [hP2]; exact h1⟩
    exact Int.natCast_dvd_natCast.mp hd
  · intro u u' hu hu'
    obtain ⟨h1, h2⟩ := KC u hu
    obtain ⟨h1', h2'⟩ := KC u' hu'
    have h0 : (u ⟨0, hn0⟩ : ℤ) = u' ⟨0, hn0⟩ := mul_left_cancel₀ hne (h1.symm.trans h1')
    funext j
    obtain ⟨k, hk⟩ := j
    have h4 : (u ⟨k, hk⟩ : ℤ) = u' ⟨k, hk⟩ := by rw [h2 k hk, h2' k hk, h0]
    exact_mod_cast h4

theorem dwti_cycle_reindex : ∀ (p : ℕ) [Fact p.Prime] (τ : Type) [Fintype τ] (γ : (τ → ℕ) → PadicComplex p) (q n : ℕ), 2 ≤ q → 1 ≤ n → (∀ c : Fin n → ℕ, ((q ^ n - 1) ∣ ∑ j : Fin n, q ^ (j : ℕ) * c j ↔ ∃ u : Fin n → ℕ, ∀ j, u (finRotate n j) + c (Fin.rev j) = q * u j) ∧ ∀ u u' : Fin n → ℕ, (∀ j, u (finRotate n j) + c (Fin.rev j) = q * u j) → (∀ j, u' (finRotate n j) + c (Fin.rev j) = q * u' j) → u = u') → dwTrPsi p γ q n = ∑' c : Fin n → τ → ℕ, if (∀ i, (q ^ n - 1) ∣ ∑ j : Fin n, q ^ (j : ℕ) * c j i) then ∏ j, γ (c j) else 0 :=
by
  intro p _ τ _ γ q n _hq _hn H
  classical
  unfold dwTrPsi
  have K1 : ∀ v : Fin n → τ → ℕ, (∏ j : Fin n, dwPsi p γ q (v j) (v (finRotate n j))) ≠ 0 →
      ∀ j t, v (finRotate n j) t ≤ q * v j t := by
    intro v hv j
    by_contra h
    apply hv
    apply Finset.prod_eq_zero (Finset.mem_univ j)
    unfold dwPsi
    rw [if_neg h]
  have K2 : ∀ v : Fin n → τ → ℕ, (∀ j t, v (finRotate n j) t ≤ q * v j t) →
      (∏ j : Fin n, dwPsi p γ q (v j) (v (finRotate n j))) =
        ∏ k : Fin n, γ (fun t => q * v (Fin.rev k) t - v (finRotate n (Fin.rev k)) t) := by
    intro v hv
    rw [← Equiv.prod_comp Fin.revPerm
      (fun k => γ (fun t => q * v (Fin.rev k) t - v (finRotate n (Fin.rev k)) t))]
    refine Finset.prod_congr rfl (fun j _ => ?_)
    simp only [Fin.revPerm_apply, Fin.rev_rev]
    unfold dwPsi
    rw [if_pos (hv j)]
  have K3 : ∀ v : Fin n → τ → ℕ, (∀ j t, v (finRotate n j) t ≤ q * v j t) → ∀ t j,
      v (finRotate n j) t + (fun k => q * v (Fin.rev k) t - v (finRotate n (Fin.rev k)) t) (Fin.rev j)
        = q * v j t := by
    intro v hv t j
    simp only [Fin.rev_rev]
    have := hv j t
    omega
  symm
  refine tsum_eq_tsum_of_ne_zero_bij
    (fun y => fun k t => q * y.1 (Fin.rev k) t - y.1 (finRotate n (Fin.rev k)) t) ?_ ?_ ?_
  · rintro ⟨y, hy⟩ ⟨y', hy'⟩ hyy
    have h1 := K1 y hy
    have h2 := K1 y' hy'
    apply Subtype.ext
    funext j t
    have hc : (fun k => q * y (Fin.rev k) t - y (finRotate n (Fin.rev k)) t) =
        (fun k => q * y' (Fin.rev k) t - y' (finRotate n (Fin.rev k)) t) := by
      funext k
      exact congrFun (congrFun hyy k) t
    have hR := K3 y' h2 t
    rw [← hc] at hR
    have := (H (fun k => q * y (Fin.rev k) t - y (finRotate n (Fin.rev k)) t)).2
      (fun j => y j t) (fun j => y' j t) (K3 y h1 t) hR
    exact congrFun this j
  · intro c hc
    rw [Function.mem_support] at hc
    by_cases hD : ∀ t, (q ^ n - 1) ∣ ∑ j : Fin n, q ^ (j : ℕ) * c j t
    · rw [if_pos hD] at hc
      choose U hU using fun t => (H (fun k => c k t)).1.mp (hD t)
      have hv1 : ∀ j t, (fun j t => U t j) (finRotate n j) t ≤ q * (fun j t => U t j) j t := by
        intro j t
        have := hU t j
        simp only at this ⊢
        omega
      have hΦ : ∀ k, (fun t => q * (fun j t => U t j) (Fin.rev k) t -
          (fun j t => U t j) (finRotate n (Fin.rev k)) t) = c k := by
        intro k
        funext t
        have := hU t (Fin.rev k)
        simp only [Fin.rev_rev] at this ⊢
        omega
      refine ⟨⟨fun j t => U t j, ?_⟩, ?_⟩
      · rw [Function.mem_support, K2 _ hv1, Finset.prod_congr rfl (fun k _ => congrArg γ (hΦ k))]
        exact hc
      · funext k
        exact hΦ k
    · rw [if_neg hD] at hc
      exact absurd rfl hc
  · rintro ⟨y, hy⟩
    have h1 := K1 y hy
    have hD : ∀ t, (q ^ n - 1) ∣ ∑ j : Fin n, q ^ (j : ℕ) *
        (fun k t => q * y (Fin.rev k) t - y (finRotate n (Fin.rev k)) t) j t := by
      intro t
      exact (H (fun k => q * y (Fin.rev k) t - y (finRotate n (Fin.rev k)) t)).1.mpr
        ⟨fun j => y j t, K3 y h1 t⟩
    dsimp only
    rw [if_pos hD, K2 y h1]

theorem dwti_factor_expand : ∀ (p : ℕ) [Fact p.Prime] (τ : Type) [Fintype τ] (γ : (τ → ℕ) → PadicComplex p) (r : ℝ) (q n : ℕ) (x : τ → PadicComplex p), 0 ≤ r → r < 1 → (∀ w, ‖γ w‖ ≤ r ^ (∑ i, w i)) → (∀ i, ‖x i‖ ≤ 1) → (Summable fun c : Fin n → τ → ℕ => ‖(∏ j, γ (c j)) * ∏ i, x i ^ (∑ j : Fin n, q ^ (j : ℕ) * c j i)‖) ∧ ∏ j ∈ Finset.range n, ∑' w : τ → ℕ, γ w * ∏ i, (x i ^ q ^ j) ^ w i = ∑' c : Fin n → τ → ℕ, (∏ j, γ (c j)) * ∏ i, x i ^ (∑ j : Fin n, q ^ (j : ℕ) * c j i) :=
by
  have key : ∀ (R : Type) [NormedCommRing R] [CompleteSpace R] (α : Type) (m : ℕ)
      (h : Fin m → α → R), (∀ j, Summable (fun a => ‖h j a‖)) →
      (Summable fun c : Fin m → α => ‖∏ j, h j (c j)‖) ∧
        ∏ j, ∑' a, h j a = ∑' c : Fin m → α, ∏ j, h j (c j) := by
    intro R _ _ α m
    induction m with
    | zero =>
      intro h _
      refine ⟨Summable.of_finite, ?_⟩
      haveI : Fintype (Fin 0 → α) := Fintype.ofFinite _
      rw [tsum_fintype]
      simp
    | succ m ih =>
      intro h hs
      obtain ⟨ih1, ih2⟩ := ih (fun j => h j.succ) (fun j => hs j.succ)
      let e := Fin.consEquiv (fun _ : Fin (m + 1) => α)
      have hpt : ∀ z : α × (Fin m → α),
          ∏ j, h j (e z j) = h 0 z.1 * ∏ j : Fin m, h j.succ (z.2 j) := by
        intro z
        simp [e, Fin.consEquiv_apply, Fin.prod_univ_succ]
      have hsum : Summable fun z : α × (Fin m → α) =>
          ‖h 0 z.1 * ∏ j : Fin m, h j.succ (z.2 j)‖ :=
        Summable.mul_norm (hs 0) ih1
      constructor
      · rw [← e.summable_iff]
        refine hsum.congr (fun z => ?_)
        simp only [Function.comp_apply, hpt]
      · rw [Fin.prod_univ_succ, ih2, tsum_mul_tsum_of_summable_norm (hs 0) ih1, ← e.tsum_eq]
        exact tsum_congr (fun z => (hpt z).symm)
  intro p _ τ _ γ r q n x hr0 hr1 hγ hx
  have hgeom : Summable (fun w : τ → ℕ => r ^ (∑ i, w i)) := by
    have hg1 : Summable (fun a : ℕ => ‖r ^ a‖) :=
      (summable_geometric_of_lt_one hr0 hr1).congr
        (fun a => by rw [norm_pow, Real.norm_eq_abs, abs_of_nonneg hr0])
    obtain ⟨hS, -⟩ := key ℝ ℕ (Fintype.card τ) (fun _ a => r ^ a) (fun _ => hg1)
    let σ := Fintype.equivFin τ
    let e : (Fin (Fintype.card τ) → ℕ) ≃ (τ → ℕ) := Equiv.arrowCongr σ.symm (Equiv.refl ℕ)
    rw [← e.summable_iff]
    refine hS.congr (fun u => ?_)
    show ‖∏ j, r ^ u j‖ = r ^ (∑ t, u (σ t))
    rw [Equiv.sum_comp σ u, norm_prod]
    simp only [norm_pow, Real.norm_eq_abs, abs_of_nonneg hr0]
    rw [Finset.prod_pow_eq_pow_sum]
  set h : Fin n → (τ → ℕ) → PadicComplex p := fun j w => γ w * ∏ i, (x i ^ q ^ (j : ℕ)) ^ w i
    with hh
  have hb : ∀ j w, ‖h j w‖ ≤ r ^ (∑ i, w i) := by
    intro j w
    simp only [hh, norm_mul, norm_prod, norm_pow]
    have h1 : ∏ i, (‖x i‖ ^ q ^ (j : ℕ)) ^ w i ≤ 1 :=
      Finset.prod_le_one₀ (fun i _ => pow_nonneg (pow_nonneg (norm_nonneg _) _) _)
        (fun i _ => pow_le_one₀ (pow_nonneg (norm_nonneg _) _)
          (pow_le_one₀ (norm_nonneg _) (hx i)))
    calc _ ≤ ‖γ w‖ * 1 := mul_le_mul_of_nonneg_left h1 (norm_nonneg _)
      _ = ‖γ w‖ := mul_one _
      _ ≤ _ := hγ w
  have hs : ∀ j, Summable (fun w => ‖h j w‖) := fun j =>
    Summable.of_nonneg_of_le (fun w => norm_nonneg _) (hb j) hgeom
  obtain ⟨S, E⟩ := key (PadicComplex p) (τ → ℕ) n h hs
  have hpt : ∀ c : Fin n → τ → ℕ, ∏ j, h j (c j) =
      (∏ j, γ (c j)) * ∏ i, x i ^ (∑ j : Fin n, q ^ (j : ℕ) * c j i) := by
    intro c
    simp only [hh]
    rw [Finset.prod_mul_distrib, Finset.prod_comm]
    congr 1
    refine Finset.prod_congr rfl (fun i _ => ?_)
    rw [← Finset.prod_pow_eq_pow_sum]
    refine Finset.prod_congr rfl (fun j _ => ?_)
    rw [← pow_mul]
  refine ⟨S.congr (fun c => by rw [hpt]), ?_⟩
  rw [← Fin.prod_univ_eq_prod_range (fun j : ℕ => ∑' w : τ → ℕ, γ w * ∏ i, (x i ^ q ^ j) ^ w i) n]
  rw [show (∏ j : Fin n, ∑' w : τ → ℕ, γ w * ∏ i, (x i ^ q ^ (j : ℕ)) ^ w i) =
    ∏ j, ∑' w, h j w from rfl, E]
  exact tsum_congr hpt

theorem dwork_trace_identity : ∀ (p : ℕ) [Fact p.Prime] (τ : Type) [Fintype τ] [DecidableEq τ]
    (γ : (τ → ℕ) → PadicComplex p) (r : ℝ) (q n : ℕ), 0 ≤ r → r < 1 →
    (∀ w, ‖γ w‖ ≤ r ^ (∑ i, w i)) → 2 ≤ q → 1 ≤ n →
    ((q ^ n - 1 : ℕ) : PadicComplex p) ^ Fintype.card τ * dwTrPsi p γ q n =
      ∑ x ∈ Fintype.piFinset (fun _ : τ => Polynomial.nthRootsFinset (q ^ n - 1) (1 : PadicComplex p)),
        ∏ j ∈ Finset.range n, ∑' w : τ → ℕ, γ w * ∏ i, (x i ^ q ^ j) ^ w i :=
by
  intro p _ τ _ _ γ r q n hr0 hr1 hγ hq hn
  have hqn : q ≤ q ^ n := Nat.le_self_pow (by omega) q
  have hN : 1 ≤ q ^ n - 1 := by omega
  have h3 := dwti_cycle_reindex p τ γ q n hq hn (dwti_cycle_scalar q n hq hn)
  have hnorm : ∀ x ∈ Fintype.piFinset (fun _ : τ =>
      Polynomial.nthRootsFinset (q ^ n - 1) (1 : PadicComplex p)), ∀ i, ‖x i‖ ≤ 1 := by
    intro x hx i
    have hxi := Fintype.mem_piFinset.mp hx i
    rw [Polynomial.mem_nthRootsFinset (by omega)] at hxi
    have h := congrArg norm hxi
    rw [norm_pow, norm_one] at h
    exact le_of_eq ((pow_eq_one_iff_of_nonneg (norm_nonneg _) (by omega)).mp h)
  rw [Finset.sum_congr rfl (fun x hx =>
    (dwti_factor_expand p τ γ r q n x hr0 hr1 hγ (hnorm x hx)).2)]
  rw [← Summable.tsum_finsetSum (fun x hx =>
    (dwti_factor_expand p τ γ r q n x hr0 hr1 hγ (hnorm x hx)).1.of_norm)]
  rw [h3, ← tsum_mul_left]
  refine tsum_congr (fun c => ?_)
  rw [← Finset.mul_sum, dwti_root_orthogonality (PadicComplex p) τ (q ^ n - 1) hN]
  split_ifs <;> ring

theorem finite_fredholm_logderiv : ∀ (K : Type) [Field K] [IsAlgClosed K] (ι : Type) [Fintype ι]
    [DecidableEq ι] (M : Matrix ι ι K) (k : ℕ), 1 ≤ k →
    (k : K) * M.charpolyRev.coeff k = -∑ n ∈ Finset.Icc 1 k, (M ^ n).trace * M.charpolyRev.coeff (k - n) :=
by
  intro K _ _ ι _ _ M k _
  classical

  have s1 : ∀ j : ℕ, M.charpolyRev.coeff j = (-1) ^ j * M.charpoly.roots.esymm j := by
    intro j
    have hd : M.charpoly.natDegree = Fintype.card ι := Matrix.charpoly_natDegree_eq_dim M
    have hspl := IsAlgClosed.splits M.charpoly
    rw [← Matrix.reverse_charpoly, Polynomial.coeff_reverse, hd]
    rcases le_or_gt j (Fintype.card ι) with h | h
    · rw [Polynomial.revAt_le h, Polynomial.coeff_eq_esymm_roots_of_splits hspl (by omega), hd,
        (Matrix.charpoly_monic M).leadingCoeff, Nat.sub_sub_self h, one_mul]
    · rw [Polynomial.revAt_eq_self_of_lt h, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
      have hc : M.charpoly.roots.card = Fintype.card ι := by
        rw [← hd]; exact (Polynomial.splits_iff_card_roots.mp hspl)
      rw [Multiset.esymm, Multiset.powersetCard_eq_empty _ (by omega)]
      simp

  have s2 : ∀ n : ℕ, (M ^ n).trace = (M.charpoly.roots.map (· ^ n)).sum := by
    intro n
    set f : Module.End K (ι → K) := Matrix.toLin' M with hf
    have h1 : (M ^ n).trace = LinearMap.trace K (ι → K) (f ^ n) := by
      rw [← Matrix.trace_toLin'_eq, Matrix.toLin'_pow]
    have h2 : M.charpoly = LinearMap.charpoly f := (Matrix.charpoly_toLin' M).symm
    rw [h1, h2]
    set p := LinearMap.charpoly f with hp
    have s3 : ∀ μ : K, LinearMap.trace K (f.maxGenEigenspace μ)
        ((f ^ n).restrict (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ)) =
        (Module.finrank K (f.maxGenEigenspace μ) : K) * μ ^ n := by
      intro μ
      have hW : Set.MapsTo f (f.maxGenEigenspace μ) (f.maxGenEigenspace μ) :=
        Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl f) μ
      set a : Module.End K (f.maxGenEigenspace μ) := f.restrict hW with ha_def
      set c : Module.End K (f.maxGenEigenspace μ) := algebraMap K _ μ with hc_def
      have ha : (f ^ n).restrict
          (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ) = a ^ n :=
        (Module.End.pow_restrict n hW _).symm
      have hnil : IsNilpotent (a - c) := by
        have := Module.End.isNilpotent_restrict_maxGenEigenspace_sub_algebraMap f μ
        convert this using 1
        ext x
        simp [a, c, LinearMap.coe_restrict_apply, Algebra.algebraMap_eq_smul_one]
        rfl
      have hac : Commute a c := by
        show a * c = c * a
        exact (Algebra.commutes μ a).symm
      have key : ∀ {R : Type} [Ring R] (x y : R), Commute x y → IsNilpotent (x - y) →
          IsNilpotent (x ^ n - y ^ n) := by
        intro R _ x y hxy hn
        have hd : Commute (x - y) x := (Commute.refl x).sub_left hxy.symm
        have hd' : Commute (x - y) y := hxy.sub_left (Commute.refl y)
        have hcomm : Commute (x - y)
            (∑ i ∈ Finset.range n, x ^ i * y ^ (n - 1 - i)) :=
          Commute.sum_right _ _ _ (fun i _ => (hd.pow_right i).mul_right (hd'.pow_right _))
        rw [← hxy.geom_sum₂_mul n]
        exact Commute.isNilpotent_mul_left hcomm.symm hn
      have hnil2 : IsNilpotent (a ^ n - c ^ n) := key a c hac hnil
      have ht : LinearMap.trace K _ (a ^ n - c ^ n) = 0 :=
        (LinearMap.isNilpotent_trace_of_isNilpotent hnil2).eq_zero
      rw [ha]
      have h3 := (LinearMap.trace K (f.maxGenEigenspace μ)).map_sub (a ^ n) (c ^ n)
      have ht' : LinearMap.trace K _ (a ^ n) = LinearMap.trace K _ (c ^ n) :=
        sub_eq_zero.mp (h3.symm.trans ht)
      rw [ht', hc_def, ← map_pow, Algebra.algebraMap_eq_smul_one, map_smul, LinearMap.trace_one,
        smul_eq_mul, mul_comm]
    have hI : DirectSum.IsInternal (fun μ => f.maxGenEigenspace μ) :=
      DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
        (Module.End.independent_maxGenEigenspace f) (Module.End.iSup_maxGenEigenspace_eq_top f)
    have hb : ∀ μ, f.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ p.roots.toFinset := by
      intro μ
      rw [Multiset.mem_toFinset, ← Multiset.count_ne_zero, Polynomial.count_roots,
        hp, ← LinearMap.finrank_maxGenEigenspace_eq, ne_eq, ne_eq, Submodule.finrank_eq_zero]
    have hN : {μ | f.maxGenEigenspace μ ≠ ⊥}.Finite := by
      apply (p.roots.toFinset.finite_toSet).subset
      intro μ hμ
      exact (hb μ).1 hμ
    have hmaps := Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n)
    rw [LinearMap.trace_eq_sum_trace_restrict' hI hN hmaps]
    have hfs : hN.toFinset = p.roots.toFinset := by
      ext μ
      rw [Set.Finite.mem_toFinset, ← hb μ]
      rfl
    rw [hfs, Finset.sum_multiset_map_count]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [s3, LinearMap.finrank_maxGenEigenspace_eq, ← hp, ← Polynomial.count_roots, nsmul_eq_mul]

  have s3 : ∀ (s : Multiset K), (k : K) * ((-1) ^ k * s.esymm k) =
      -∑ n ∈ Finset.Icc 1 k, (s.map (· ^ n)).sum * ((-1) ^ (k - n) * s.esymm (k - n)) := by
    intro s
    set x : Fin s.toList.length → K := fun i => s.toList.get i with hx
    have hmap : (Finset.univ : Finset (Fin s.toList.length)).val.map x = s := by
      rw [Fin.univ_val_map, hx, List.ofFn_get, Multiset.coe_toList]
    have hp : ∀ n, MvPolynomial.aeval x (MvPolynomial.psum (Fin s.toList.length) K n) =
        (s.map (· ^ n)).sum := by
      intro n
      rw [MvPolynomial.psum, map_sum]
      simp only [map_pow, MvPolynomial.aeval_X]
      rw [Finset.sum_eq_multiset_sum]
      conv_rhs => rw [← hmap, Multiset.map_map]
      rfl
    have h := congrArg (MvPolynomial.aeval x)
      (MvPolynomial.mul_esymm_eq_sum (Fin s.toList.length) K k)
    simp only [map_mul, map_natCast, map_pow, map_neg, map_one, map_sum,
      MvPolynomial.aeval_esymm_eq_multiset_esymm, hmap, hp] at h
    have hre : ∑ a ∈ Finset.HasAntidiagonal.antidiagonal k with a.1 < k,
        (-1) ^ a.1 * s.esymm a.1 * (s.map (· ^ a.2)).sum
        = ∑ n ∈ Finset.Icc 1 k, (-1) ^ (k - n) * s.esymm (k - n) * (s.map (· ^ n)).sum := by
      apply Finset.sum_nbij' (fun a => a.2) (fun n => (k - n, n))
      · intro a ha
        simp only [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal] at ha
        simp only [Finset.mem_Icc]
        omega
      · intro n hn
        simp only [Finset.mem_Icc] at hn
        simp only [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal]
        omega
      · intro a ha
        simp only [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal] at ha
        ext <;> simp <;> omega
      · intro n hn
        rfl
      · intro a ha
        simp only [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal] at ha
        have : a.1 = k - a.2 := by omega
        rw [this]
    rw [hre] at h
    have hsign : (-1 : K) ^ k * (-1) ^ (k + 1) = -1 := by
      rw [← pow_add, show k + (k + 1) = 2 * k + 1 by ring, pow_succ, pow_mul]
      simp
    calc (k : K) * ((-1) ^ k * s.esymm k) = (-1) ^ k * ((k : K) * s.esymm k) := by ring
      _ = (-1) ^ k * (-1) ^ (k + 1) * ∑ n ∈ Finset.Icc 1 k,
            (-1) ^ (k - n) * s.esymm (k - n) * (s.map (· ^ n)).sum := by rw [h]; ring
      _ = _ := by
        rw [hsign, neg_one_mul]
        congr 1
        exact Finset.sum_congr rfl (fun n _ => by ring)

  rw [s1 k]
  rw [Finset.sum_congr rfl (fun n _ => by rw [s2 n, s1 (k - n)])]
  exact s3 M.charpoly.roots

theorem det_coeff_bound : ∀ (p : ℕ) [Fact p.Prime] (ι : Type) [Fintype ι] [DecidableEq ι]
    (M : Matrix ι ι (PadicComplex p)) (a b : ι → ℝ), (∀ i, 0 ≤ a i) → (∀ i, 0 < b i) →
    (∀ i j, ‖M i j‖ ≤ a i * b i / b j) → ∀ (k : ℕ) (C : ℝ), 0 ≤ C →
    (∀ S : Finset ι, S.card = k → ∏ i ∈ S, a i ≤ C) → ‖M.charpolyRev.coeff k‖ ≤ C :=
by
  intro p _ ι _ _ M a b ha hb hM k C hC hS
  have hcoeff : M.charpolyRev.coeff k = ∑ σ : Equiv.Perm ι,
      ((Equiv.Perm.sign σ : ℤ) : PadicComplex p) *
      ∑ t ∈ (Finset.univ : Finset ι).powerset, (if k = t.card then
        (∏ i ∈ t, -M (σ i) i) * ∏ i ∈ Finset.univ \ t,
          (if σ i = i then (1 : PadicComplex p) else 0) else 0) := by
    rw [Matrix.charpolyRev, Matrix.det_apply, Polynomial.finsetSum_coeff]
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    have hent : ∀ i, (1 - (Polynomial.X : Polynomial (PadicComplex p)) • M.map Polynomial.C) (σ i) i
        = Polynomial.C (-M (σ i) i) * Polynomial.X
          + Polynomial.C (if σ i = i then (1 : PadicComplex p) else 0) := by
      intro i
      rw [Matrix.sub_apply, Matrix.one_apply, Matrix.smul_apply, Matrix.map_apply, smul_eq_mul,
        Polynomial.C_neg, apply_ite Polynomial.C, Polynomial.C_1, Polynomial.C_0]
      ring
    rw [Finset.prod_congr rfl (fun i _ => hent i), Finset.prod_add, Units.smul_def,
      Polynomial.coeff_smul, Polynomial.finsetSum_coeff, zsmul_eq_mul]
    congr 1
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [Finset.prod_mul_distrib, Finset.prod_const, ← map_prod, ← map_prod]
    have : Polynomial.C (∏ i ∈ t, -M (σ i) i) * Polynomial.X ^ t.card *
        Polynomial.C (∏ i ∈ Finset.univ \ t, (if σ i = i then (1 : PadicComplex p) else 0))
        = Polynomial.C ((∏ i ∈ t, -M (σ i) i) *
          ∏ i ∈ Finset.univ \ t, (if σ i = i then (1 : PadicComplex p) else 0))
          * Polynomial.X ^ t.card := by
      rw [map_mul]; ring
    rw [this, Polynomial.coeff_C_mul_X_pow]
  rw [hcoeff]
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hC (fun σ _ => ?_)
  have hsign : ‖((Equiv.Perm.sign σ : ℤ) : PadicComplex p)‖ = 1 := by
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
  rw [norm_mul, hsign, one_mul]
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hC (fun t _ => ?_)
  split_ifs with hk
  · by_cases hfix : ∀ i ∈ Finset.univ \ t, σ i = i
    · have h1 : ∏ i ∈ Finset.univ \ t, (if σ i = i then (1 : PadicComplex p) else 0) = 1 :=
        Finset.prod_eq_one (fun i hi => by simp [hfix i hi])
      rw [h1, mul_one, norm_prod]
      have hsupp : {x | σ x ≠ x} ⊆ (t : Set ι) := by
        intro x hx
        by_contra hxt
        exact hx (hfix x (by simpa using hxt))
      have hbpos : 0 < ∏ i ∈ t, b i := Finset.prod_pos (fun i _ => hb i)
      calc ∏ i ∈ t, ‖-M (σ i) i‖ ≤ ∏ i ∈ t, (a (σ i) * b (σ i) / b i) := by
            refine Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => ?_)
            rw [norm_neg]; exact hM _ _
        _ = ∏ i ∈ t, a i := by
            rw [Finset.prod_div_distrib, Finset.prod_mul_distrib, Equiv.Perm.prod_comp σ t a hsupp,
              Equiv.Perm.prod_comp σ t b hsupp, mul_div_assoc, div_self hbpos.ne', mul_one]
        _ ≤ C := hS t hk.symm
    · push_neg at hfix
      obtain ⟨i, hi, hne⟩ := hfix
      have h0 : ∏ i ∈ Finset.univ \ t, (if σ i = i then (1 : PadicComplex p) else 0) = 0 :=
        Finset.prod_eq_zero hi (by simp [hne])
      rw [h0, mul_zero, norm_zero]
      exact hC
  · rw [norm_zero]; exact hC

theorem truncated_trace_approx : ∀ (p : ℕ) [Fact p.Prime] (τ : Type) [Fintype τ]
    (γ : (τ → ℕ) → PadicComplex p) (r : ℝ) (q n s : ℕ), 0 ≤ r → r < 1 →
    (∀ w, ‖γ w‖ ≤ r ^ (∑ i, w i)) → 2 ≤ q → 1 ≤ n →
    ‖dwTrPsi p γ q n - ((dwMtr p γ q s) ^ n).trace‖ ≤ r ^ ((q - 1) * (s + 1)) :=
by
  intro p _ τ _ γ r q n s hr0 hr1 hγ hq hn
  classical

  have hpath : ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (M : Matrix ι ι (PadicComplex p)) (m : ℕ)
      (a b : ι), (M ^ (m + 1)) a b =
        ∑ u : Fin m → ι, ∏ j : Fin (m + 1),
          M ((Fin.cons a u : Fin (m + 1) → ι) j) ((Fin.snoc u b : Fin (m + 1) → ι) j) := by
    intro ι _ _ M m
    induction m with
    | zero =>
      intro a b
      simp [Fin.prod_univ_one]
      rfl
    | succ m ih =>
      intro a b
      rw [pow_succ, Matrix.mul_apply]
      simp_rw [ih, Finset.sum_mul]
      rw [← Fintype.sum_prod_type']
      refine Fintype.sum_equiv (Fin.snocEquiv (fun _ => ι)) _ _ (fun x => ?_)
      show _ = ∏ j : Fin (m + 2), M ((Fin.cons a (Fin.snoc x.2 x.1 : Fin (m + 1) → ι) : Fin (m + 2) → ι) j)
        ((Fin.snoc (Fin.snoc x.2 x.1 : Fin (m + 1) → ι) b : Fin (m + 2) → ι) j)
      rw [Fin.prod_univ_castSucc (n := m + 1)]
      simp only [Fin.cons_snoc_eq_snoc_cons, Fin.snoc_castSucc, Fin.snoc_last]

  have hcyc : ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (M : Matrix ι ι (PadicComplex p)) (m : ℕ),
      (M ^ (m + 1)).trace = ∑ w : Fin (m + 1) → ι, ∏ j, M (w j) (w (finRotate (m + 1) j)) := by
    intro ι _ _ M m
    simp only [Matrix.trace, Matrix.diag]
    simp_rw [hpath]
    rw [← Fintype.sum_prod_type']
    refine Fintype.sum_equiv (Fin.consEquiv (fun _ => ι)) _ _ (fun x => ?_)
    simp only [Fin.snoc_eq_cons_rotate]
    rfl
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  set f : (Fin (m + 1) → τ → ℕ) → PadicComplex p :=
    fun v => ∏ j : Fin (m + 1), dwPsi p γ q (v j) (v (finRotate (m + 1) j)) with hf
  have htr : dwTrPsi p γ q (m + 1) = ∑' v, f v := rfl
  set S := Fintype.piFinset (fun _ : Fin (m + 1) => dwBfin τ s) with hSdef

  have hS : ((dwMtr p γ q s) ^ (m + 1)).trace = ∑ v ∈ S, f v := by
    rw [hcyc]
    refine Finset.sum_bij' (fun w _ => fun j => (w j).1)
      (fun v hv => fun j => ⟨v j, Fintype.mem_piFinset.1 hv j⟩) ?_ ?_ ?_ ?_ ?_
    · intro w _; exact Fintype.mem_piFinset.2 (fun j => (w j).2)
    · intro v _; exact Finset.mem_univ _
    · intro w _; rfl
    · intro v _; rfl
    · intro w _; rfl

  have hbound : ∀ v : Fin (m + 1) → τ → ℕ, ‖f v‖ ≤ r ^ ((q - 1) * ∑ j, ∑ i, v j i) := by
    intro v
    by_cases hadm : ∀ j, ∀ i, v (finRotate (m + 1) j) i ≤ q * v j i
    · have hfac : ∀ j, ‖dwPsi p γ q (v j) (v (finRotate (m + 1) j))‖ ≤
          r ^ (q * ∑ i, v j i - ∑ i, v (finRotate (m + 1) j) i) := by
        intro j
        unfold dwPsi
        rw [if_pos (hadm j)]
        refine (hγ _).trans (le_of_eq ?_)
        congr 1
        rw [Finset.mul_sum]
        exact Finset.sum_tsub_distrib _ (fun i _ => hadm j i)
      have hle : ∀ j, ∑ i, v (finRotate (m + 1) j) i ≤ q * ∑ i, v j i := fun j => by
        rw [Finset.mul_sum]; exact Finset.sum_le_sum (fun i _ => hadm j i)
      have h1 : ∑ j, (q * ∑ i, v j i - ∑ i, v (finRotate (m + 1) j) i) +
          ∑ j, ∑ i, v (finRotate (m + 1) j) i = q * ∑ j, ∑ i, v j i := by
        rw [← Finset.sum_add_distrib, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun j _ => Nat.sub_add_cancel (hle j))
      have h2 : ∑ j, ∑ i, v (finRotate (m + 1) j) i = ∑ j, ∑ i, v j i :=
        Equiv.sum_comp (finRotate (m + 1)) (fun j => ∑ i, v j i)
      rw [h2] at h1
      have hexp : ∑ j, (q * ∑ i, v j i - ∑ i, v (finRotate (m + 1) j) i) =
          (q - 1) * ∑ j, ∑ i, v j i := by
        rw [Nat.sub_one_mul]
        exact Nat.eq_sub_of_add_eq h1
      calc ‖f v‖ = ∏ j, ‖dwPsi p γ q (v j) (v (finRotate (m + 1) j))‖ := norm_prod _ _
        _ ≤ ∏ j, r ^ (q * ∑ i, v j i - ∑ i, v (finRotate (m + 1) j) i) := by
          gcongr with j
          exact hfac j
        _ = r ^ ((q - 1) * ∑ j, ∑ i, v j i) := by rw [Finset.prod_pow_eq_pow_sum, hexp]
    · push_neg at hadm
      obtain ⟨j, i, hji⟩ := hadm
      have h0 : f v = 0 := by
        refine Finset.prod_eq_zero (Finset.mem_univ j) ?_
        unfold dwPsi
        rw [if_neg]
        push_neg
        exact ⟨i, hji⟩
      rw [h0, norm_zero]
      exact pow_nonneg hr0 _

  have hρ0 : 0 ≤ r ^ (q - 1) := pow_nonneg hr0 _
  have hρ1 : r ^ (q - 1) < 1 := pow_lt_one₀ hr0 hr1 (by omega)
  have hboundρ : ∀ v, ‖f v‖ ≤ (r ^ (q - 1)) ^ (∑ j, ∑ i, v j i) := fun v => by
    rw [← pow_mul]; exact hbound v
  have hsum : Summable f := by
    apply NonarchimedeanAddGroup.summable_of_tendsto_cofinite_zero
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨K, hK⟩ := exists_pow_lt_of_lt_one hε hρ1
    rw [Filter.eventually_cofinite]
    refine (Fintype.piFinset (fun _ : Fin (m + 1) =>
      Fintype.piFinset (fun _ : τ => Finset.range K))).finite_toSet.subset ?_
    intro v hv
    simp only [Set.mem_setOf_eq, dist_zero_right, not_lt] at hv
    by_contra hvT
    rw [Finset.mem_coe, Fintype.mem_piFinset] at hvT
    push_neg at hvT
    obtain ⟨j, hj⟩ := hvT
    rw [Fintype.mem_piFinset] at hj
    push_neg at hj
    obtain ⟨i, hi⟩ := hj
    rw [Finset.mem_range, not_lt] at hi
    have hA : K ≤ ∑ j, ∑ i, v j i :=
      le_trans hi (le_trans (Finset.single_le_sum (f := fun i => v j i)
        (fun i _ => Nat.zero_le _) (Finset.mem_univ i))
        (Finset.single_le_sum (f := fun j => ∑ i, v j i) (fun j _ => Nat.zero_le _)
          (Finset.mem_univ j)))
    have := (hboundρ v).trans_lt ((pow_le_pow_of_le_one hρ0 hρ1.le hA).trans_lt hK)
    linarith

  have htail : ‖(∑' v, f v) - ∑ v ∈ S, f v‖ ≤ r ^ ((q - 1) * (s + 1)) := by
    rw [← hsum.sum_add_tsum_compl (s := S), add_sub_cancel_left]
    refine IsUltrametricDist.norm_tsum_le_of_forall_le_of_nonneg (pow_nonneg hr0 _) (fun x => ?_)
    have hx : ¬ ∀ j, (x : Fin (m + 1) → τ → ℕ) j ∈ dwBfin τ s :=
      fun h => x.2 (Fintype.mem_piFinset.2 h)
    push_neg at hx
    obtain ⟨j, hj⟩ := hx
    have hA : s + 1 ≤ ∑ i, (x : Fin (m + 1) → τ → ℕ) j i := by
      by_contra h
      push_neg at h
      apply hj
      simp only [dwBfin, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_range]
      refine ⟨fun i => lt_of_le_of_lt (Finset.single_le_sum
        (f := fun i => (x : Fin (m + 1) → τ → ℕ) j i) (fun i _ => Nat.zero_le _)
        (Finset.mem_univ i)) h, by omega⟩
    have hA' : s + 1 ≤ ∑ j, ∑ i, (x : Fin (m + 1) → τ → ℕ) j i :=
      le_trans hA (Finset.single_le_sum (f := fun j => ∑ i, (x : Fin (m + 1) → τ → ℕ) j i)
        (fun j _ => Nat.zero_le _) (Finset.mem_univ j))
    exact (hbound _).trans (pow_le_pow_of_le_one hr0 hr1.le (Nat.mul_le_mul_left _ hA'))
  rw [htr, hS]
  exact htail

theorem superlinear_weight_bound : ∀ (τ : Type) [Fintype τ] (r : ℝ) (q : ℕ), 0 ≤ r → r < 1 → 2 ≤ q →
    ∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, 0 ≤ c ∧ ∀ (k : ℕ) (S : Finset (τ → ℕ)), S.card = k →
      (∏ w ∈ S, r ^ ((q - 1) * ∑ i, w i)) * ρ ^ k ≤ c :=
by
  intro τ _ r q hr0 hr1 hq ρ hρ
  classical
  obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = r ^ (q - 1) := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := hs_def ▸ pow_nonneg hr0 _
  have hs1 : s < 1 := hs_def ▸ pow_lt_one₀ hr0 hr1 (by omega)
  obtain ⟨M, hM⟩ := exists_pow_lt_of_lt_one (inv_pos.mpr hρ) hs1
  have hMρ : s ^ M * ρ < 1 := by
    have := mul_lt_mul_of_pos_right hM hρ
    rwa [inv_mul_cancel₀ hρ.ne'] at this
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = max 1 ρ := ⟨_, rfl⟩
  have hL1 : 1 ≤ L := hL ▸ le_max_left _ _
  have hρL : ρ ≤ L := hL ▸ le_max_right _ _
  obtain ⟨B, hB⟩ : ∃ B : Finset (τ → ℕ), B = Fintype.piFinset (fun _ : τ => Finset.range M) :=
    ⟨_, rfl⟩
  refine ⟨L ^ B.card, pow_nonneg (by linarith) _, ?_⟩
  intro k S hk
  subst hk
  have hf : ∀ w : τ → ℕ, r ^ ((q - 1) * ∑ i, w i) = s ^ (∑ i, w i) := by
    intro w; rw [hs_def, pow_mul]
  simp_rw [hf]
  rw [← Finset.prod_const (s := S) ρ, ← Finset.prod_mul_distrib]
  rw [← Finset.prod_filter_mul_prod_filter_not S (fun w => w ∈ B)]
  have hfnn : ∀ w : τ → ℕ, 0 ≤ s ^ (∑ i, w i) * ρ := fun w => mul_nonneg (pow_nonneg hs0 _) hρ.le
  have hP2 : ∏ w ∈ S.filter (fun w => ¬ w ∈ B), s ^ (∑ i, w i) * ρ ≤ 1 := by
    apply Finset.prod_le_one₀
    · intro w _; exact hfnn w
    · intro w hw
      have hwB : w ∉ B := (Finset.mem_filter.mp hw).2
      have hex : ∃ i, M ≤ w i := by
        by_contra h
        push_neg at h
        exact hwB (hB ▸ Fintype.mem_piFinset.mpr fun i => Finset.mem_range.mpr (h i))
      obtain ⟨i, hi⟩ := hex
      have hle : M ≤ ∑ j, w j :=
        le_trans hi (Finset.single_le_sum (fun j _ => Nat.zero_le (w j)) (Finset.mem_univ i))
      have hpow : s ^ (∑ j, w j) ≤ s ^ M := pow_le_pow_of_le_one hs0 hs1.le hle
      have := mul_le_mul_of_nonneg_right hpow hρ.le
      linarith
  have hP1 : ∏ w ∈ S.filter (fun w => w ∈ B), s ^ (∑ i, w i) * ρ ≤ L ^ B.card := by
    calc _ ≤ ∏ w ∈ S.filter (fun w => w ∈ B), L := by
          apply Finset.prod_le_prod₀
          · intro w _; exact hfnn w
          · intro w _
            have h1 : s ^ (∑ i, w i) ≤ 1 := pow_le_one₀ hs0 hs1.le
            have := mul_le_mul_of_nonneg_right h1 hρ.le
            linarith
      _ = L ^ (S.filter (fun w => w ∈ B)).card := Finset.prod_const _
      _ ≤ L ^ B.card := by
          apply pow_le_pow_right₀ hL1
          apply Finset.card_le_card
          intro w hw; exact (Finset.mem_filter.mp hw).2
  have hP1nn : 0 ≤ ∏ w ∈ S.filter (fun w => w ∈ B), s ^ (∑ i, w i) * ρ :=
    Finset.prod_nonneg (fun w _ => hfnn w)
  calc _ ≤ (∏ w ∈ S.filter (fun w => w ∈ B), s ^ (∑ i, w i) * ρ) * 1 :=
        mul_le_mul_of_nonneg_left hP2 hP1nn
    _ ≤ L ^ B.card := by rw [mul_one]; exact hP1

theorem fredholm_limit : ∀ (p : ℕ) [Fact p.Prime] (t : ℕ → PadicComplex p) (T C : ℕ → ℕ → PadicComplex p),
    (∀ s, C s 0 = 1) →
    (∀ (s k : ℕ), 1 ≤ k → (k : PadicComplex p) * C s k = -∑ n ∈ Finset.Icc 1 k, T s n * C s (k - n)) →
    (∀ n, 1 ≤ n → Filter.Tendsto (fun s => T s n) Filter.atTop (nhds (t n))) →
    (∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ s k, ‖C s k‖ * ρ ^ k ≤ c) →
    ∃ D : PowerSeries (PadicComplex p), PowerSeries.constantCoeff D = 1 ∧
      (∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k D‖ * ρ ^ k ≤ c) ∧
      PowerSeries.X * PowerSeries.derivative D = -(PowerSeries.mk (fun n => if n = 0 then 0 else t n) * D) :=
by
  intro p _ t T C h0 hrec hT hB
  classical
  have hconv' : ∀ k, Filter.Tendsto (fun s => C s k) Filter.atTop
      (nhds (Filter.limUnder Filter.atTop (fun s => C s k))) := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k IH =>
      apply tendsto_nhds_limUnder
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        refine ⟨1, ?_⟩
        simp only [h0]
        exact tendsto_const_nhds
      · have hk0 : (k : PadicComplex p) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
        have heq : ∀ s, C s k = (k : PadicComplex p)⁻¹ *
            (-∑ n ∈ Finset.Icc 1 k, T s n * C s (k - n)) := by
          intro s
          rw [← hrec s k hk, inv_mul_cancel_left₀ hk0]
        refine ⟨(k : PadicComplex p)⁻¹ * (-∑ n ∈ Finset.Icc 1 k,
          t n * Filter.limUnder Filter.atTop (fun s => C s (k - n))), ?_⟩
        refine Filter.Tendsto.congr (fun s => (heq s).symm) ?_
        refine Filter.Tendsto.const_mul _ (Filter.Tendsto.neg ?_)
        refine tendsto_finset_sum _ (fun n hn => ?_)
        have hn' := Finset.mem_Icc.mp hn
        exact (hT n hn'.1).mul (IH (k - n) (by omega))
  obtain ⟨d, hd⟩ : ∃ d : ℕ → PadicComplex p,
      d = fun k => Filter.limUnder Filter.atTop (fun s => C s k) := ⟨_, rfl⟩
  have hconv : ∀ k, Filter.Tendsto (fun s => C s k) Filter.atTop (nhds (d k)) := by
    intro k; rw [hd]; exact hconv' k
  have hd0 : d 0 = 1 := by
    refine tendsto_nhds_unique (hconv 0) ?_
    simp only [h0]
    exact tendsto_const_nhds
  have hdrec : ∀ k : ℕ, 1 ≤ k →
      (k : PadicComplex p) * d k = -∑ n ∈ Finset.Icc 1 k, t n * d (k - n) := by
    intro k hk
    have h1 : Filter.Tendsto (fun s => (k : PadicComplex p) * C s k) Filter.atTop
        (nhds ((k : PadicComplex p) * d k)) := (hconv k).const_mul _
    have h2 : Filter.Tendsto (fun s => (k : PadicComplex p) * C s k) Filter.atTop
        (nhds (-∑ n ∈ Finset.Icc 1 k, t n * d (k - n))) := by
      refine Filter.Tendsto.congr (fun s => (hrec s k hk).symm) ?_
      refine Filter.Tendsto.neg (tendsto_finset_sum _ (fun n hn => ?_))
      exact (hT n (Finset.mem_Icc.mp hn).1).mul (hconv (k - n))
    exact tendsto_nhds_unique h1 h2
  have hshift : ∀ (g : ℕ → PadicComplex p) (j : ℕ),
      ∑ n ∈ Finset.Icc 1 (j + 1), g n = ∑ i ∈ Finset.range (j + 1), g (i + 1) := by
    intro g j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [Finset.sum_Icc_succ_top (by omega), ih]
      exact (Finset.sum_range_succ (fun i => g (i + 1)) (j + 1)).symm
  refine ⟨PowerSeries.mk d, ?_, ?_, ?_⟩
  · rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_mk]
    exact hd0
  · intro ρ hρ
    obtain ⟨c, hc⟩ := hB ρ hρ
    refine ⟨c, fun k => ?_⟩
    rw [PowerSeries.coeff_mk]
    exact le_of_tendsto' (((hconv k).norm).mul_const (ρ ^ k)) (fun s => hc s k)
  · ext m
    rcases m with _ | j
    · rw [PowerSeries.coeff_zero_X_mul, map_neg, PowerSeries.coeff_mul]
      simp
    · have hr := hdrec (j + 1) (by omega)
      rw [hshift] at hr
      rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative, PowerSeries.coeff_mk, map_neg,
        PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ']
      simp only [PowerSeries.coeff_mk, if_pos rfl, zero_mul, add_zero, Nat.add_sub_add_right,
        Nat.succ_ne_zero, if_false, Nat.sub_zero] at hr ⊢
      rw [mul_comm, if_pos trivial, zero_mul, add_zero, ← hr, Nat.cast_succ]

theorem series_product_expansion : ∀ (p : ℕ) [Fact p.Prime] (τ J : Type) [Fintype τ] [Fintype J]
    (u : J → τ → ℕ) (A : J → PadicComplex p) (lam : ℕ → PadicComplex p) (r₀ : ℝ), 0 ≤ r₀ → r₀ < 1 →
    (∀ k, ‖lam k‖ ≤ r₀ ^ k) → (∀ j, ‖A j‖ ≤ 1) →
    ∃ (γ : (τ → ℕ) → PadicComplex p) (r : ℝ), 0 < r ∧ r < 1 ∧ (∀ w, ‖γ w‖ ≤ r ^ (∑ i, w i)) ∧
      ∀ x : τ → PadicComplex p, (∀ i, ‖x i‖ ≤ 1) →
        ∑' w, γ w * ∏ i, x i ^ w i = ∏ j, dwTheta p lam (A j * ∏ i, x i ^ u j i) :=
by
  intro p _ τ J _ _ u A lam r₀ hr₀0 hr₀1 hlam hA

  have s1 : ∀ (J' : Type) [Fintype J'] (f : J' → ℕ → PadicComplex p),
      (∀ j, Summable (fun n => ‖f j n‖)) →
      (Summable (fun k : J' → ℕ => ‖∏ j, f j (k j)‖)) ∧
        ∏ j, ∑' n, f j n = ∑' k : J' → ℕ, ∏ j, f j (k j) := by
    have hE : ∀ {α β : Type} (e : α ≃ β),
        (∀ [Fintype α] (f : α → ℕ → PadicComplex p),
          (∀ j, Summable (fun n => ‖f j n‖)) →
          (Summable (fun k : α → ℕ => ‖∏ j, f j (k j)‖)) ∧
            ∏ j, ∑' n, f j n = ∑' k : α → ℕ, ∏ j, f j (k j)) →
        ∀ [Fintype β] (f : β → ℕ → PadicComplex p), (∀ j, Summable (fun n => ‖f j n‖)) →
        (Summable (fun k : β → ℕ => ‖∏ j, f j (k j)‖)) ∧
            ∏ j, ∑' n, f j n = ∑' k : β → ℕ, ∏ j, f j (k j) := by
      intro α β e ih _ f hf
      letI : Fintype α := Fintype.ofEquiv β e.symm
      obtain ⟨hS, hEq⟩ := ih (fun a => f (e a)) (fun a => hf (e a))
      let E : (α → ℕ) ≃ (β → ℕ) := e.arrowCongr (Equiv.refl ℕ)
      have hcomp : ∀ k' : α → ℕ, ∏ b, f b (E k' b) = ∏ a, f (e a) (k' a) := by
        intro k'
        refine (Fintype.prod_equiv e _ _ (fun a => ?_)).symm
        simp [E, Equiv.arrowCongr_apply]
      constructor
      · rw [← E.summable_iff]
        refine hS.congr (fun k' => ?_)
        exact congrArg norm (hcomp k').symm
      · rw [← E.tsum_eq, tsum_congr hcomp, ← hEq]
        exact (Fintype.prod_equiv e _ _ (fun a => rfl)).symm
    have h0 : ∀ [Fintype PEmpty] (f : PEmpty → ℕ → PadicComplex p),
        (∀ j, Summable (fun n => ‖f j n‖)) →
        (Summable (fun k : PEmpty → ℕ => ‖∏ j, f j (k j)‖)) ∧
            ∏ j, ∑' n, f j n = ∑' k : PEmpty → ℕ, ∏ j, f j (k j) := by
      intro _ f _
      simp only [Finset.univ_eq_empty, Finset.prod_empty]
      refine ⟨Summable.of_finite, ?_⟩
      rw [tsum_eq_single (fun x => x.elim : PEmpty → ℕ)]
      intro b hb
      exact absurd (Subsingleton.elim _ _) hb
    have hO : ∀ {α : Type} [Fintype α],
        (∀ [Fintype α] (f : α → ℕ → PadicComplex p),
          (∀ j, Summable (fun n => ‖f j n‖)) →
          (Summable (fun k : α → ℕ => ‖∏ j, f j (k j)‖)) ∧
            ∏ j, ∑' n, f j n = ∑' k : α → ℕ, ∏ j, f j (k j)) →
        ∀ [Fintype (Option α)] (f : Option α → ℕ → PadicComplex p),
          (∀ j, Summable (fun n => ‖f j n‖)) →
        (Summable (fun k : Option α → ℕ => ‖∏ j, f j (k j)‖)) ∧
            ∏ j, ∑' n, f j n = ∑' k : Option α → ℕ, ∏ j, f j (k j) := by
      intro α _ ih inst f hf
      obtain rfl : inst = instFintypeOption := Subsingleton.elim _ _
      obtain ⟨hS, hEq⟩ := ih (fun a => f (some a)) (fun a => hf (some a))
      have hfam : ∀ k : Option α → ℕ, ∏ j, f j (k j) =
          (fun z : ℕ × (α → ℕ) => f none z.1 * ∏ a, f (some a) (z.2 a))
            (Equiv.piOptionEquivProd k) := by
        intro k
        rw [Fintype.prod_option]
        simp [Equiv.piOptionEquivProd]
      constructor
      · have h1 := Summable.mul_norm (hf none) hS
        rw [← (Equiv.piOptionEquivProd (β := fun _ : Option α => ℕ)).summable_iff] at h1
        refine h1.congr (fun k => ?_)
        exact congrArg norm (hfam k).symm
      · rw [Fintype.prod_option, hEq, tsum_mul_tsum_of_summable_norm (hf none) hS]
        rw [← (Equiv.piOptionEquivProd (β := fun _ : Option α => ℕ)).tsum_eq]
        exact tsum_congr (fun k => (hfam k).symm)
    intro J' _
    exact Finite.induction_empty_option
      (P := fun (J' : Type) => ∀ [Fintype J'] (f : J' → ℕ → PadicComplex p),
        (∀ j, Summable (fun n => ‖f j n‖)) →
        (Summable (fun k : J' → ℕ => ‖∏ j, f j (k j)‖)) ∧
          ∏ j, ∑' n, f j n = ∑' k : J' → ℕ, ∏ j, f j (k j)) hE h0 hO J'

  obtain ⟨r, hr0, hr1, hdecay⟩ : ∃ r : ℝ, 0 < r ∧ r < 1 ∧
      ∀ k : J → ℕ, r₀ ^ (∑ j, k j) ≤ r ^ (∑ i, ∑ j, k j * u j i) := by
    obtain ⟨U, hU⟩ : ∃ U : ℕ, U = 1 + ∑ j, ∑ i, u j i := ⟨_, rfl⟩
    have hU1 : (1 : ℝ) ≤ U := by
      have : 1 ≤ U := by omega
      exact_mod_cast this
    obtain ⟨r₁, hr₁⟩ : ∃ r₁ : ℝ, r₁ = max r₀ (1 / 2) := ⟨_, rfl⟩
    have hr₁h : 1 / 2 ≤ r₁ := hr₁ ▸ le_max_right _ _
    have hr₁1 : r₁ < 1 := hr₁ ▸ max_lt hr₀1 (by norm_num)
    have hr₀r₁ : r₀ ≤ r₁ := hr₁ ▸ le_max_left _ _
    have hUpos : (0 : ℝ) < U := by linarith
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = 1 - (1 - r₁) / U := ⟨_, rfl⟩
    have hdiv0 : 0 < (1 - r₁) / U := div_pos (by linarith) hUpos
    have hdiv1 : (1 - r₁) / U ≤ 1 / 2 := by
      rw [div_le_iff₀ hUpos]
      have : (1 / 2 : ℝ) ≤ 1 / 2 * U := by linarith
      linarith
    have hr0 : 0 < r := by rw [hr]; linarith
    have hr1 : r < 1 := by rw [hr]; linarith
    have hbern : r₁ ≤ r ^ U := by
      have h := one_add_mul_le_pow (a := -((1 - r₁) / U)) (by linarith) U
      have h2 : (U : ℝ) * (-((1 - r₁) / U)) = -(1 - r₁) := by
        rw [mul_neg, mul_div_cancel₀ _ hUpos.ne']
      have h3 : 1 + -((1 - r₁) / (U : ℝ)) = r := by rw [hr]; ring
      rw [h2, h3] at h
      linarith
    refine ⟨r, hr0, hr1, fun k => ?_⟩
    have hE : ∑ i, ∑ j, k j * u j i ≤ U * ∑ j, k j := by
      rw [Finset.sum_comm, Finset.mul_sum]
      refine Finset.sum_le_sum (fun j _ => ?_)
      have hle : ∑ i, u j i ≤ U := by
        have := Finset.single_le_sum (f := fun j => ∑ i, u j i) (fun j _ => Nat.zero_le _)
          (Finset.mem_univ j)
        omega
      calc ∑ i, k j * u j i = k j * ∑ i, u j i := (Finset.mul_sum _ _ _).symm
        _ ≤ k j * U := Nat.mul_le_mul_left _ hle
        _ = U * k j := mul_comm _ _
    calc r₀ ^ (∑ j, k j) ≤ r₁ ^ (∑ j, k j) := pow_le_pow_left₀ hr₀0 hr₀r₁ _
      _ ≤ (r ^ U) ^ (∑ j, k j) := pow_le_pow_left₀ (by linarith) hbern _
      _ = r ^ (U * ∑ j, k j) := (pow_mul _ _ _).symm
      _ ≤ r ^ (∑ i, ∑ j, k j * u j i) := pow_le_pow_of_le_one hr0.le hr1.le hE

  have hc : ∀ k : J → ℕ, ‖∏ j, lam (k j) * A j ^ k j‖ ≤ r₀ ^ (∑ j, k j) := by
    intro k
    rw [norm_prod, ← Finset.prod_pow_eq_pow_sum]
    refine Finset.prod_le_prod₀ (fun j _ => norm_nonneg _) (fun j _ => ?_)
    rw [norm_mul, norm_pow]
    calc ‖lam (k j)‖ * ‖A j‖ ^ k j ≤ r₀ ^ k j * 1 :=
          mul_le_mul (hlam _) (pow_le_one₀ (norm_nonneg _) (hA j)) (by positivity) (by positivity)
      _ = r₀ ^ k j := mul_one _

  obtain ⟨κ, hκ⟩ : ∃ κ : (J → ℕ) → τ → ℕ, ∀ k, κ k = fun i => ∑ j, k j * u j i :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨c, hcd⟩ : ∃ c : (J → ℕ) → PadicComplex p, ∀ k, c k = ∏ j, lam (k j) * A j ^ k j :=
    ⟨_, fun _ => rfl⟩
  refine ⟨fun w => ∑' b : ↑(κ ⁻¹' {w}), c b, r, hr0, hr1, ?_, ?_⟩

  · intro w
    refine IsUltrametricDist.norm_tsum_le_of_forall_le_of_nonneg (pow_nonneg hr0.le _)
      (fun b => ?_)
    have hb : κ b = w := b.2
    have hsum : ∑ i, w i = ∑ i, ∑ j, (b : J → ℕ) j * u j i := by
      exact congrArg (fun v : τ → ℕ => ∑ i, v i) (hb.symm.trans (hκ b))
    rw [hsum, hcd]
    exact (hc b).trans (hdecay b)

  · intro x hx
    have hy : ∀ j, ‖A j * ∏ i, x i ^ u j i‖ ≤ 1 := by
      intro j
      rw [norm_mul, norm_prod]
      refine mul_le_one₀ (hA j) (Finset.prod_nonneg fun _ _ => norm_nonneg _)
        (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun i _ => ?_))
      rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) (hx i)
    obtain ⟨f, hf⟩ : ∃ f : J → ℕ → PadicComplex p,
        ∀ j n, f j n = lam n * (A j * ∏ i, x i ^ u j i) ^ n := ⟨_, fun _ _ => rfl⟩
    have hfs : ∀ j, Summable (fun n => ‖f j n‖) := by
      intro j
      refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun n => ?_)
        (summable_geometric_of_lt_one hr₀0 hr₀1)
      rw [hf, norm_mul, norm_pow]
      calc ‖lam n‖ * ‖A j * ∏ i, x i ^ u j i‖ ^ n ≤ r₀ ^ n * 1 :=
            mul_le_mul (hlam n) (pow_le_one₀ (norm_nonneg _) (hy j)) (by positivity)
              (by positivity)
        _ = r₀ ^ n := mul_one _
    obtain ⟨hS, hEq⟩ := s1 J f hfs
    have hmono : ∀ k : J → ℕ, ∏ j, f j (k j) = c k * ∏ i, x i ^ κ k i := by
      intro k
      rw [hcd, hκ, Finset.prod_congr rfl (fun j _ => hf j (k j))]
      have h1 : ∀ j, lam (k j) * (A j * ∏ i, x i ^ u j i) ^ k j =
          (lam (k j) * A j ^ k j) * ∏ i, x i ^ (k j * u j i) := by
        intro j
        rw [mul_pow, ← Finset.prod_pow, mul_assoc]
        refine congrArg _ (congrArg _ (Finset.prod_congr rfl (fun i _ => ?_)))
        rw [← pow_mul, mul_comm (u j i)]
      rw [Finset.prod_congr rfl (fun j _ => h1 j), Finset.prod_mul_distrib, Finset.prod_comm]
      refine congrArg _ (Finset.prod_congr rfl (fun i _ => ?_))
      exact Finset.prod_pow_eq_pow_sum _ _ _
    have hRHS : ∏ j, dwTheta p lam (A j * ∏ i, x i ^ u j i) =
        ∑' k, c k * ∏ i, x i ^ κ k i := by
      rw [← tsum_congr hmono, ← hEq]
      refine Finset.prod_congr rfl (fun j _ => ?_)
      exact tsum_congr (fun n => (hf j n).symm)
    have hsum : Summable (fun k => c k * ∏ i, x i ^ κ k i) := by
      refine Summable.of_norm ?_
      refine hS.congr (fun k => ?_)
      exact congrArg norm (hmono k)
    have h1 := hsum.hasSum.tsum_fiberwise κ
    have h2 : (fun w => ∑' b : ↑(κ ⁻¹' {w}), c ↑b * ∏ i, x i ^ κ ↑b i) =
        fun w => (∑' b : ↑(κ ⁻¹' {w}), c ↑b) * ∏ i, x i ^ w i := by
      funext w
      rw [← tsum_mul_right]
      refine tsum_congr (fun b => ?_)
      have hb : κ b = w := b.2
      rw [hb]
    rw [h2] at h1
    rw [hRHS]
    exact h1.tsum_eq

theorem character_evaluation : ∀ (F : Type u) [Field F] [Finite F] (τ : Type) [Fintype τ]
    (G : MvPolynomial τ F) (p : ℕ) [Fact p.Prime] (a : ℕ), Nat.card F = p ^ a →
    ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] [Algebra (ZMod p) E]
      (ωF : F → PadicComplex p) (ω : E → PadicComplex p) (ζ : PadicComplex p) (lam : ℕ → PadicComplex p),
      (∀ c, ω (algebraMap F E c) = ωF c) → ω 0 = 0 → (∀ x y, ω (x * y) = ω x * ω y) →
      Function.Injective ω → (∀ x y, ‖ω (x + y) - ω x - ω y‖ < 1) →
      (∀ x, ω x ^ Nat.card E = ω x) → ζ ^ p = 1 → dwSplit p ζ lam →
      ∀ y : τ → E, ∏ j ∈ Finset.range (Module.finrank F E), ∏ v ∈ G.support, ∏ i ∈ Finset.range a,
        dwTheta p lam (ωF (G.coeff v) ^ p ^ i * ∏ k, (ω (y k) ^ Nat.card F ^ j) ^ (p ^ i * v k)) =
        ζ ^ (Algebra.trace (ZMod p) E (MvPolynomial.aeval y G)).val :=
by
  intro F _ _ τ _ G p _ a hQ E _ _ _ _ ωF ω ζ lam hωc hω0 hωmul hωinj hωadd hωroot hζp hsplit y
  classical
  haveI : Finite E := Module.finite_of_finite F
  haveI : Module.Finite (ZMod p) E := Module.Finite.of_finite
  have hp2 := (Fact.out : p.Prime).two_le

  have hcard1 : Nat.card E = p ^ (a * Module.finrank F E) := by
    rw [Module.natCard_eq_pow_finrank (K := F), hQ, ← pow_mul]
  have hcardE : Nat.card E = p ^ Module.finrank (ZMod p) E := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod p), Nat.card_zmod]
  have hm : Module.finrank (ZMod p) E = a * Module.finrank F E :=
    Nat.pow_right_injective hp2 (hcardE.symm.trans hcard1)
  have ha : a ≠ 0 := by
    rintro rfl
    have h1 := Finite.one_lt_card (α := F)
    rw [hQ] at h1
    simp at h1
  have hn : 0 < Module.finrank F E := Module.finrank_pos
  have hm1 : 1 ≤ Module.finrank (ZMod p) E := by
    rw [hm]; exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero ha hn.ne')

  have hadd : ∀ x y : PadicComplex p, ‖x‖ < 1 → ‖y‖ < 1 → ‖x + y‖ < 1 := fun x y hx hy =>
    lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max x y) (max_lt hx hy)
  have hsub : ∀ x y : PadicComplex p, ‖x‖ < 1 → ‖y‖ < 1 → ‖x - y‖ < 1 := fun x y hx hy => by
    rw [sub_eq_add_neg]; exact hadd _ _ hx (by rwa [norm_neg])

  have hω1 : ω 1 = 1 := by
    have h := hωmul 1 1
    rw [one_mul] at h
    have hne : ω 1 ≠ 0 := by
      intro h0; rw [← hω0] at h0; exact one_ne_zero (hωinj h0)
    have h2 : ω 1 * (ω 1 - 1) = 0 := by rw [mul_sub, ← h]; ring
    rcases mul_eq_zero.mp h2 with h' | h'
    · exact absurd h' hne
    · exact sub_eq_zero.mp h'
  let ωh : E →* PadicComplex p := ⟨⟨ω, hω1⟩, hωmul⟩
  have hωpow : ∀ x (k : ℕ), ω (x ^ k) = ω x ^ k := fun x k => map_pow ωh x k

  have hsum : ∀ (f : ℕ → E) (L : ℕ),
      ‖∑ l ∈ Finset.range L, ω (f l) - ω (∑ l ∈ Finset.range L, f l)‖ < 1 := by
    intro f L
    induction L with
    | zero => simp [hω0]
    | succ L ih =>
      rw [Finset.sum_range_succ, Finset.sum_range_succ]
      have h := hsub _ _ ih (hωadd (∑ l ∈ Finset.range L, f l) (f L))
      convert h using 2
      ring
  have hnat : ∀ N : ℕ, ‖ω (N : E) - (N : PadicComplex p)‖ < 1 := by
    intro N
    induction N with
    | zero => simp [hω0]
    | succ N ih =>
      have h := hadd _ _ (hωadd (N : E) 1) ih
      push_cast
      convert h using 2
      rw [hω1]; ring
  have hclose : ∀ z : E, ‖(∑ l ∈ Finset.range (Module.finrank (ZMod p) E), ω z ^ (p ^ l)) -
      ((Algebra.trace (ZMod p) E z).val : PadicComplex p)‖ < 1 := by
    intro z
    have htr : ∑ l ∈ Finset.range (Module.finrank (ZMod p) E), z ^ (p ^ l) =
        (((Algebra.trace (ZMod p) E z).val : ℕ) : E) := by
      have h := FiniteField.algebraMap_trace_eq_sum_pow (ZMod p) E z
      rw [Nat.card_zmod] at h
      rw [← h, ← map_natCast (algebraMap (ZMod p) E) (Algebra.trace (ZMod p) E z).val,
        ZMod.natCast_zmod_val]
    have e1 : ∑ l ∈ Finset.range (Module.finrank (ZMod p) E), ω z ^ (p ^ l) =
        ∑ l ∈ Finset.range (Module.finrank (ZMod p) E), ω (z ^ (p ^ l)) := by
      simp only [hωpow]
    rw [e1]
    have h1 := hsum (fun l => z ^ (p ^ l)) (Module.finrank (ZMod p) E)
    rw [htr] at h1
    have h2 := hadd _ _ h1 (hnat (Algebra.trace (ZMod p) E z).val)
    convert h2 using 2
    ring

  have hωFQ : ∀ (c : F) (j : ℕ), ωF c ^ Nat.card F ^ j = ωF c := by
    intro c j
    haveI := Fintype.ofFinite F
    have hc : c ^ Nat.card F = c := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.pow_card c
    induction j with
    | zero => simp
    | succ j ih => rw [pow_succ, pow_mul, ih, ← hωc, ← hωpow, ← map_pow, hc]
  have harg : ∀ (c : F) (v : τ →₀ ℕ) (i j : ℕ),
      ωF c ^ p ^ i * ∏ k, (ω (y k) ^ Nat.card F ^ j) ^ (p ^ i * v k)
        = ω (algebraMap F E c * ∏ k, y k ^ v k) ^ p ^ (i + a * j) := by
    intro c v i j
    have hωprod : ω (∏ k, y k ^ v k) = ∏ k, ω (y k) ^ v k := by
      show ωh _ = _
      rw [map_prod]
      simp only [map_pow]
      rfl
    rw [hωmul, hωc, hωprod, pow_add, pow_mul p a j, ← hQ, mul_pow, ← Finset.prod_pow]
    congr 1
    · rw [mul_comm, pow_mul, hωFQ]
    · refine Finset.prod_congr rfl (fun k _ => ?_)
      rw [← pow_mul, ← pow_mul]
      congr 1
      ring

  have hre : ∀ (g : ℕ → PadicComplex p) (n : ℕ),
      ∏ j ∈ Finset.range n, ∏ i ∈ Finset.range a, g (i + a * j) = ∏ l ∈ Finset.range (a * n), g l := by
    intro g n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.prod_range_succ, ih, Nat.mul_succ, Finset.prod_range_add]
      congr 1
      exact Finset.prod_congr rfl fun i _ => by rw [add_comm]

  have hzeta : ∀ (s : Finset (τ →₀ ℕ)) (c : (τ →₀ ℕ) → ZMod p),
      ∏ v ∈ s, ζ ^ (c v).val = ζ ^ (∑ v ∈ s, c v).val := by
    intro s c
    rw [Finset.prod_pow_eq_pow_sum]
    have h : (∑ v ∈ s, c v) = ((∑ v ∈ s, (c v).val : ℕ) : ZMod p) := by
      rw [Nat.cast_sum]; simp only [ZMod.natCast_zmod_val]
    rw [h, ZMod.val_natCast]
    conv_lhs => rw [← Nat.div_add_mod (∑ v ∈ s, (c v).val) p, pow_add, pow_mul, hζp, one_pow, one_mul]

  have haeval : MvPolynomial.aeval y G =
      ∑ v ∈ G.support, algebraMap F E (G.coeff v) * ∏ k, y k ^ v k := by
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq']
  calc ∏ j ∈ Finset.range (Module.finrank F E), ∏ v ∈ G.support, ∏ i ∈ Finset.range a,
        dwTheta p lam (ωF (G.coeff v) ^ p ^ i * ∏ k, (ω (y k) ^ Nat.card F ^ j) ^ (p ^ i * v k))
      = ∏ v ∈ G.support, ∏ j ∈ Finset.range (Module.finrank F E), ∏ i ∈ Finset.range a,
        dwTheta p lam (ω (algebraMap F E (G.coeff v) * ∏ k, y k ^ v k) ^ p ^ (i + a * j)) := by
        rw [Finset.prod_comm]
        refine Finset.prod_congr rfl fun v _ => Finset.prod_congr rfl fun j _ =>
          Finset.prod_congr rfl fun i _ => ?_
        rw [harg]
    _ = ∏ v ∈ G.support,
        ζ ^ (Algebra.trace (ZMod p) E (algebraMap F E (G.coeff v) * ∏ k, y k ^ v k)).val := by
        refine Finset.prod_congr rfl fun v _ => ?_
        rw [hre (fun l => dwTheta p lam (ω (algebraMap F E (G.coeff v) * ∏ k, y k ^ v k) ^ p ^ l))
          (Module.finrank F E), ← hm]
        exact hsplit _ hm1 _ (by rw [← hcardE]; exact hωroot _) _ (hclose _)
    _ = ζ ^ (∑ v ∈ G.support,
        Algebra.trace (ZMod p) E (algebraMap F E (G.coeff v) * ∏ k, y k ^ v k)).val := hzeta _ _
    _ = ζ ^ (Algebra.trace (ZMod p) E (MvPolynomial.aeval y G)).val := by
        rw [haeval, map_sum]

theorem teichmuller_sum_reindex : ∀ (p : ℕ) [Fact p.Prime] (E : Type u) [Field E] [Finite E] (τ : Type)
    [Fintype τ] [DecidableEq τ] (ω : E → PadicComplex p) (f : (τ → PadicComplex p) → PadicComplex p),
    ω 0 = 0 → Function.Injective ω → (∀ ξ : PadicComplex p, ξ ^ Nat.card E = ξ ↔ ∃ x, ω x = ξ) →
    ∑ x ∈ Fintype.piFinset (fun _ : τ => Polynomial.nthRootsFinset (Nat.card E - 1) (1 : PadicComplex p)),
      f x = ∑ᶠ y : {y : τ → E // ∀ i, y i ≠ 0}, f (fun i => ω (y.1 i)) :=
by
  intro p _ E _ _ τ _ _ ω f hω0 hinj hroot
  classical
  have hq : 1 < Nat.card E := Finite.one_lt_card
  have hq1 : 0 < Nat.card E - 1 := by omega
  have hpow : ∀ ξ : PadicComplex p, ξ ^ Nat.card E = ξ ^ (Nat.card E - 1) * ξ := by
    intro ξ
    rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ Nat.card E)]
  have key : ∀ ξ : PadicComplex p,
      ξ ∈ Polynomial.nthRootsFinset (Nat.card E - 1) (1 : PadicComplex p) ↔
        ∃ x : E, x ≠ 0 ∧ ω x = ξ := by
    intro ξ
    rw [Polynomial.mem_nthRootsFinset hq1]
    constructor
    · intro h
      have h' : ξ ^ Nat.card E = ξ := by rw [hpow, h, one_mul]
      obtain ⟨x, hx⟩ := (hroot ξ).mp h'
      refine ⟨x, ?_, hx⟩
      rintro rfl
      rw [hω0] at hx
      subst hx
      rw [zero_pow hq1.ne'] at h
      exact zero_ne_one h
    · rintro ⟨x, hx0, rfl⟩
      have h1 : ω x ^ Nat.card E = ω x := (hroot (ω x)).mpr ⟨x, rfl⟩
      have hne : ω x ≠ 0 := by
        intro h
        rw [← hω0] at h
        exact hx0 (hinj h)
      rw [hpow] at h1
      have h2 : ω x ^ (Nat.card E - 1) * ω x = 1 * ω x := by rw [h1, one_mul]
      exact mul_right_cancel₀ hne h2
  haveI : Fintype {y : τ → E // ∀ i, y i ≠ 0} := Fintype.ofFinite _
  rw [finsum_eq_sum_of_fintype]
  symm
  refine Finset.sum_bij (fun y _ => fun i => ω (y.1 i)) ?_ ?_ ?_ ?_
  · intro y _
    rw [Fintype.mem_piFinset]
    intro i
    exact (key _).mpr ⟨y.1 i, y.2 i, rfl⟩
  · intro y₁ _ y₂ _ h
    apply Subtype.ext
    funext i
    exact hinj (congrFun h i)
  · intro x hx
    rw [Fintype.mem_piFinset] at hx
    choose y hy0 hyω using fun i => (key (x i)).mp (hx i)
    exact ⟨⟨y, hy0⟩, Finset.mem_univ _, funext hyω⟩
  · intro y _
    rfl

theorem dwork_trace_formula_entire : ∀ (F : Type u) [Field F] [Finite F] (τ : Type) [Fintype τ] (G : MvPolynomial τ F) (p : ℕ) [Fact p.Prime], ringChar F = p → ∃ (ζ : PadicComplex p) (D : PowerSeries (PadicComplex p)) (t : ℕ → PadicComplex p), ζ ^ p = 1 ∧ ζ ≠ 1 ∧ PowerSeries.constantCoeff D = 1 ∧ (∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k D‖ * ρ ^ k ≤ c) ∧ PowerSeries.X * PowerSeries.derivative D = -(PowerSeries.mk (fun n => if n = 0 then 0 else t n) * D) ∧ ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] [Algebra (ZMod p) E], t (Module.finrank F E) * ((Nat.card E : PadicComplex p) - 1) ^ Fintype.card τ = ∑ᶠ y : {y : τ → E // ∀ i, y i ≠ 0}, ζ ^ (Algebra.trace (ZMod p) E (MvPolynomial.aeval y.1 G)).val :=
by
  intro F _ _ τ _ G p _ hchar
  classical

  obtain ⟨ζ, lam, r₀, hr₀0, hr₀1, hζp, hζ1, hlam, hsplit⟩ :=
    dwork_splitting p (dwork_exp_coeff_bounds p (artin_hasse_integral p))

  haveI : CharP F p := by rw [← hchar]; exact ringChar.charP F
  haveI := Fintype.ofFinite F
  obtain ⟨a, -, hcardF⟩ := FiniteField.card F p
  have hQ : Nat.card F = p ^ (a : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hcardF
  have hQ2 : 2 ≤ Nat.card F := Finite.one_lt_card

  obtain ⟨ωF, hωFpow, hωFE⟩ := teichmuller_lift F p hchar
  have hωF1 : ∀ c, ‖ωF c‖ ≤ 1 := by
    intro c
    by_contra h
    push_neg at h
    have h' := lt_self_pow₀ h (show 1 < Nat.card F by omega)
    rw [← norm_pow, hωFpow c] at h'
    exact lt_irrefl _ h'

  obtain ⟨γ, r, hr0, hr1, hγ, hprod⟩ := series_product_expansion p τ
    (↥(G.support ×ˢ Finset.range (a : ℕ)))
    (fun j k => p ^ j.1.2 * j.1.1 k) (fun j => ωF (G.coeff j.1.1) ^ p ^ j.1.2) lam r₀ hr₀0 hr₀1 hlam
    (fun j => by rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) (hωF1 _))

  have htend : ∀ n, 1 ≤ n → Filter.Tendsto (fun s => ((dwMtr p γ (Nat.card F) s) ^ n).trace)
      Filter.atTop (nhds (dwTrPsi p γ (Nat.card F) n)) := by
    intro n hn
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have hlim : Filter.Tendsto (fun s : ℕ => r ^ ((Nat.card F - 1) * (s + 1))) Filter.atTop (nhds 0) := by
      refine (tendsto_pow_atTop_nhds_zero_of_lt_one hr0.le hr1).comp ?_
      refine Filter.tendsto_atTop_atTop.mpr fun b => ⟨b, fun s hs => ?_⟩
      exact le_trans (by omega) (Nat.le_mul_of_pos_left (s + 1) (by omega))
    refine squeeze_zero (fun s => norm_nonneg _) (fun s => ?_) hlim
    rw [norm_sub_rev]
    exact truncated_trace_approx p τ γ r (Nat.card F) n s hr0.le hr1 hγ hQ2 hn
  have hbound : ∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ s k,
      ‖(dwMtr p γ (Nat.card F) s).charpolyRev.coeff k‖ * ρ ^ k ≤ c := by
    intro ρ hρ
    obtain ⟨c, hc0, hc⟩ := superlinear_weight_bound τ r (Nat.card F) hr0.le hr1 hQ2 ρ hρ
    refine ⟨c, fun s k => ?_⟩
    have hρk : 0 < ρ ^ k := pow_pos hρ k
    rw [← le_div_iff₀ hρk]
    refine det_coeff_bound p _ (dwMtr p γ (Nat.card F) s)
      (fun w => r ^ ((Nat.card F - 1) * ∑ i, w.1 i)) (fun w => r ^ (∑ i, w.1 i))
      (fun w => pow_nonneg hr0.le _) (fun w => pow_pos hr0 _) ?_ k (c / ρ ^ k)
      (div_nonneg hc0 hρk.le) ?_
    · intro v w
      show ‖dwPsi p γ (Nat.card F) v.1 w.1‖ ≤ _
      unfold dwPsi
      split_ifs with hle
      · refine (hγ _).trans (le_of_eq ?_)
        rw [eq_div_iff (pow_pos hr0 _).ne', ← pow_add, ← pow_add]
        congr 1
        rw [← Finset.sum_add_distrib]
        rw [Finset.sum_congr rfl (fun i _ => Nat.sub_add_cancel (hle i))]
        rw [← Finset.mul_sum]
        obtain ⟨Q', hQ'⟩ : ∃ Q', Nat.card F = Q' + 1 := ⟨Nat.card F - 1, by omega⟩
        rw [hQ', Nat.add_sub_cancel]
        ring
      · rw [norm_zero]
        exact div_nonneg (mul_nonneg (pow_nonneg hr0.le _) (pow_nonneg hr0.le _)) (pow_nonneg hr0.le _)
    · intro S hS
      rw [le_div_iff₀ hρk]
      have h := hc k (S.map (Function.Embedding.subtype _)) (by rw [Finset.card_map, hS])
      rw [Finset.prod_map] at h
      exact h
  obtain ⟨D, hD0, hDent, hDode⟩ := fredholm_limit p (fun n => dwTrPsi p γ (Nat.card F) n)
    (fun s n => ((dwMtr p γ (Nat.card F) s) ^ n).trace)
    (fun s k => (dwMtr p γ (Nat.card F) s).charpolyRev.coeff k)
    (fun s => by
      show (dwMtr p γ (Nat.card F) s).charpolyRev.coeff 0 = 1
      rw [Polynomial.coeff_zero_eq_eval_zero, Matrix.eval_charpolyRev])
    (fun s k hk => finite_fredholm_logderiv (PadicComplex p) _ (dwMtr p γ (Nat.card F) s) k hk)
    htend hbound
  refine ⟨ζ, D, fun n => dwTrPsi p γ (Nat.card F) n, hζp, hζ1, hD0, hDent, hDode, ?_⟩

  intro E _ _ _ _
  obtain ⟨ω, hωc, hω0, hωmul, hωinj, hωadd, _hωle, hωroot⟩ := hωFE E
  haveI : Finite E := Module.finite_of_finite F
  have hn : 0 < Module.finrank F E := Module.finrank_pos
  have hcardE : Nat.card E = Nat.card F ^ Module.finrank F E := Module.natCard_eq_pow_finrank
  have hQn : 2 ≤ Nat.card F ^ Module.finrank F E := le_trans hQ2 (Nat.le_self_pow hn.ne' _)
  have h5 := dwork_trace_identity p τ γ r (Nat.card F) (Module.finrank F E) hr0.le hr1 hγ hQ2 hn
  have hsub : ((Nat.card E : PadicComplex p) - 1) =
      ((Nat.card F ^ Module.finrank F E - 1 : ℕ) : PadicComplex p) := by
    rw [Nat.cast_sub (by omega), hcardE]
    push_cast
    ring
  show dwTrPsi p γ (Nat.card F) (Module.finrank F E) * _ = _
  rw [mul_comm, hsub, h5]
  have hfactor : ∀ x ∈ Fintype.piFinset (fun _ : τ =>
        Polynomial.nthRootsFinset (Nat.card F ^ Module.finrank F E - 1) (1 : PadicComplex p)),
      ∏ j ∈ Finset.range (Module.finrank F E), ∑' w : τ → ℕ, γ w * ∏ i, (x i ^ Nat.card F ^ j) ^ w i
      = ∏ j ∈ Finset.range (Module.finrank F E), ∏ v ∈ G.support, ∏ i ∈ Finset.range (a : ℕ),
          dwTheta p lam (ωF (G.coeff v) ^ p ^ i * ∏ k, (x k ^ Nat.card F ^ j) ^ (p ^ i * v k)) := by
    intro x hx
    refine Finset.prod_congr rfl (fun j _ => ?_)
    have hxn : ∀ i, ‖x i ^ Nat.card F ^ j‖ ≤ 1 := by
      intro i
      have hxi := Fintype.mem_piFinset.mp hx i
      rw [Polynomial.mem_nthRootsFinset (by omega)] at hxi
      have h1 : ‖x i‖ = 1 := by
        have h := congrArg norm hxi
        rw [norm_pow, norm_one] at h
        exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) (by omega)).mp h
      rw [norm_pow, h1, one_pow]
    rw [hprod _ hxn]
    exact (Finset.prod_coe_sort (G.support ×ˢ Finset.range (a : ℕ))
      (fun vi : (τ →₀ ℕ) × ℕ => dwTheta p lam (ωF (G.coeff vi.1) ^ p ^ vi.2 *
        ∏ k, (x k ^ Nat.card F ^ j) ^ (p ^ vi.2 * vi.1 k)))).trans (Finset.prod_product _ _ _)
  rw [Finset.sum_congr rfl hfactor]
  have hNE : Nat.card F ^ Module.finrank F E - 1 = Nat.card E - 1 := by rw [hcardE]
  rw [hNE]
  refine (teichmuller_sum_reindex p E τ ω (fun x => ∏ j ∈ Finset.range (Module.finrank F E),
    ∏ v ∈ G.support, ∏ i ∈ Finset.range (a : ℕ),
      dwTheta p lam (ωF (G.coeff v) ^ p ^ i * ∏ k, (x k ^ Nat.card F ^ j) ^ (p ^ i * v k)))
    hω0 hωinj hωroot).trans ?_
  refine finsum_congr (fun y => ?_)
  exact character_evaluation F τ G p a hQ E ωF ω ζ lam hωc hω0 hωmul hωinj hωadd
    (fun x => (hωroot (ω x)).mpr ⟨x, rfl⟩) hζp hsplit y.1

theorem zeta_quotient_of_entire : ∀ (p : ℕ) [Fact p.Prime] (q r : ℕ) (N : ℕ → ℤ) (t : ℕ → PadicComplex p) (D : PowerSeries (PadicComplex p)), 1 ≤ q → PowerSeries.constantCoeff D = 1 → (∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k D‖ * ρ ^ k ≤ c) → PowerSeries.X * PowerSeries.derivative D = -(PowerSeries.mk (fun n => if n = 0 then 0 else t n) * D) → (∀ n : ℕ, 1 ≤ n → (q : PadicComplex p) ^ n * (N n : PadicComplex p) = ((q : PadicComplex p) ^ n - 1) ^ r + t n * ((q : PadicComplex p) ^ n - 1) ^ (r + 1)) → ∃ A B : PowerSeries (PadicComplex p), PowerSeries.constantCoeff A = 1 ∧ PowerSeries.constantCoeff B = 1 ∧ (∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k A‖ * ρ ^ k ≤ c ∧ ‖PowerSeries.coeff k B‖ * ρ ^ k ≤ c) ∧ PowerSeries.X * (PowerSeries.derivative A * B - A * PowerSeries.derivative B) = PowerSeries.mk (fun n => if n = 0 then 0 else (N n : PadicComplex p)) * A * B :=
by
  intro p _ q r N t D hq hD0 hDent hDlog hhyp

  have hmul : ∀ f g : PowerSeries (PadicComplex p), zqoeEnt p f → zqoeEnt p g →
      zqoeEnt p (f * g) := by
    intro f g hf hg ρ hρ
    obtain ⟨cf, hcf⟩ := hf (2 * ρ) (by positivity)
    obtain ⟨cg, hcg⟩ := hg (2 * ρ) (by positivity)
    have hcf0 : 0 ≤ cf := le_trans (by positivity) (hcf 0)
    have hcg0 : 0 ≤ cg := le_trans (by positivity) (hcg 0)
    have hf' : ∀ i, ‖PowerSeries.coeff i f‖ * ρ ^ i ≤ cf / 2 ^ i := by
      intro i
      rw [le_div_iff₀ (by positivity)]
      calc ‖PowerSeries.coeff i f‖ * ρ ^ i * 2 ^ i = ‖PowerSeries.coeff i f‖ * (2 * ρ) ^ i := by
            rw [mul_pow]; ring
        _ ≤ cf := hcf i
    have hg' : ∀ i, ‖PowerSeries.coeff i g‖ * ρ ^ i ≤ cg / 2 ^ i := by
      intro i
      rw [le_div_iff₀ (by positivity)]
      calc ‖PowerSeries.coeff i g‖ * ρ ^ i * 2 ^ i = ‖PowerSeries.coeff i g‖ * (2 * ρ) ^ i := by
            rw [mul_pow]; ring
        _ ≤ cg := hcg i
    refine ⟨cf * cg, fun k => ?_⟩
    have h2 : ((k : ℝ) + 1) ≤ 2 ^ k := by
      have h : k + 1 ≤ 2 ^ k := Nat.lt_two_pow_self
      exact_mod_cast h
    rw [PowerSeries.coeff_mul]
    calc ‖∑ x ∈ Finset.HasAntidiagonal.antidiagonal k,
            PowerSeries.coeff x.1 f * PowerSeries.coeff x.2 g‖ * ρ ^ k
        ≤ (∑ x ∈ Finset.HasAntidiagonal.antidiagonal k,
            ‖PowerSeries.coeff x.1 f‖ * ‖PowerSeries.coeff x.2 g‖) * ρ ^ k := by
          gcongr
          exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => norm_mul_le _ _)
      _ = ∑ x ∈ Finset.HasAntidiagonal.antidiagonal k,
            (‖PowerSeries.coeff x.1 f‖ * ρ ^ x.1) * (‖PowerSeries.coeff x.2 g‖ * ρ ^ x.2) := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun x hx => ?_
          rw [← Finset.HasAntidiagonal.mem_antidiagonal.mp hx, pow_add]; ring
      _ ≤ ∑ x ∈ Finset.HasAntidiagonal.antidiagonal k, (cf / 2 ^ x.1) * (cg / 2 ^ x.2) := by
          apply Finset.sum_le_sum
          intro x _
          exact mul_le_mul (hf' _) (hg' _) (by positivity) (div_nonneg hcf0 (by positivity))
      _ = ∑ x ∈ Finset.HasAntidiagonal.antidiagonal k, cf * cg / 2 ^ k := by
          refine Finset.sum_congr rfl fun x hx => ?_
          rw [← Finset.HasAntidiagonal.mem_antidiagonal.mp hx, pow_add, div_mul_div_comm]
      _ = ((k : ℝ) + 1) * (cf * cg / 2 ^ k) := by
          rw [Finset.sum_const, Finset.Nat.card_antidiagonal, nsmul_eq_mul]; push_cast; ring
      _ ≤ cf * cg := by
          rw [mul_div_assoc', div_le_iff₀ (by positivity)]
          have := mul_le_mul_of_nonneg_right h2 (mul_nonneg hcf0 hcg0)
          linarith
  have hent1 : zqoeEnt p 1 := by
    intro ρ _
    refine ⟨1, fun k => ?_⟩
    rw [PowerSeries.coeff_one]
    split_ifs with h
    · subst h; simp
    · simp

  have hzero : zqoeReal p 0 := ⟨1, 1, map_one _, map_one _, hent1, hent1, by simp⟩
  have hadd : ∀ L₁ L₂, zqoeReal p L₁ → zqoeReal p L₂ → zqoeReal p (L₁ + L₂) := by
    rintro L₁ L₂ ⟨A₁, B₁, hA₁, hB₁, eA₁, eB₁, h₁⟩ ⟨A₂, B₂, hA₂, hB₂, eA₂, eB₂, h₂⟩
    refine ⟨A₁ * A₂, B₁ * B₂, by rw [map_mul, hA₁, hA₂, one_mul],
      by rw [map_mul, hB₁, hB₂, one_mul], hmul _ _ eA₁ eA₂, hmul _ _ eB₁ eB₂, ?_⟩
    simp only [Derivation.leibniz, smul_eq_mul]
    linear_combination A₂ * B₂ * h₁ + A₁ * B₁ * h₂
  have hneg : ∀ L, zqoeReal p L → zqoeReal p (-L) := by
    rintro L ⟨A, B, hA, hB, eA, eB, h⟩
    exact ⟨B, A, hB, hA, eB, eA, by linear_combination (-1 : PowerSeries (PadicComplex p)) * h⟩
  have hzsmul : ∀ (k : ℤ) L, zqoeReal p L → zqoeReal p (k • L) := by
    intro k L hL
    induction k using Int.induction_on with
    | zero => rw [zero_smul]; exact hzero
    | succ i ih => rw [add_smul, one_smul]; exact hadd _ _ ih hL
    | pred i ih => rw [sub_smul, one_smul, sub_eq_add_neg]; exact hadd _ _ ih (hneg _ hL)
  have hsum : ∀ (s : Finset ℕ) (κ : ℕ → ℤ) (L : ℕ → PowerSeries (PadicComplex p)),
      (∀ j ∈ s, zqoeReal p (L j)) → zqoeReal p (∑ j ∈ s, κ j • L j) := by
    intro s κ L hL
    exact Finset.sum_induction _ (zqoeReal p) hadd hzero (fun j hj => hzsmul _ _ (hL j hj))

  have hS : ∀ c : PadicComplex p,
      zqoeReal p (PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n)) := by
    intro c
    have key : PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n) *
        (1 - PowerSeries.C c * PowerSeries.X) = PowerSeries.C c * PowerSeries.X := by
      rw [show PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n) *
          (1 - PowerSeries.C c * PowerSeries.X) = PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n)
          - PowerSeries.C c * (PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n) * PowerSeries.X)
          by ring]
      ext n
      rw [map_sub, PowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul, PowerSeries.coeff_X]
      rcases n with _ | _ | m
      · simp [PowerSeries.coeff_zero_mul_X]
      · simp [PowerSeries.coeff_succ_mul_X]
      · simp only [PowerSeries.coeff_succ_mul_X, PowerSeries.coeff_mk]
        split_ifs <;> first | omega | ring
    have h : zqoeReal p (-(PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n))) := by
      refine ⟨1 - PowerSeries.C c * PowerSeries.X, 1, by simp, map_one _, ?_, hent1, ?_⟩
      · intro ρ hρ
        refine ⟨1 + ‖c‖ * ρ, fun k => ?_⟩
        rw [map_sub, PowerSeries.coeff_C_mul, PowerSeries.coeff_X, PowerSeries.coeff_one]
        rcases k with _ | _ | m
        · simp; positivity
        · simp
        · simp; positivity
      · simp only [map_sub, Derivation.map_one_eq_zero, Derivation.leibniz,
          PowerSeries.derivative_X, PowerSeries.derivative_C, smul_eq_mul]
        linear_combination key
    have := hneg _ h
    rwa [neg_neg] at this

  have hT : ∀ c : PadicComplex p,
      zqoeReal p (PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n * t n)) := by
    intro c
    have hcomm : ∀ f : PowerSeries (PadicComplex p),
        PowerSeries.X * PowerSeries.derivative (PowerSeries.rescale c f) =
          PowerSeries.rescale c (PowerSeries.X * PowerSeries.derivative f) := by
      intro f
      ext n
      rcases n with _ | m
      · simp [PowerSeries.coeff_rescale]
      · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_rescale, PowerSeries.coeff_succ_X_mul,
          PowerSeries.coeff_derivative, PowerSeries.coeff_derivative, PowerSeries.coeff_rescale]
        ring
    have hresT : PowerSeries.rescale c (PowerSeries.mk (fun n => if n = 0 then 0 else t n)) =
        PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n * t n) := by
      ext n
      rw [PowerSeries.coeff_rescale, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
      split_ifs <;> simp
    have h : zqoeReal p (-(PowerSeries.mk (fun n => if n = 0 then 0 else c ^ n * t n))) := by
      refine ⟨PowerSeries.rescale c D, 1, ?_, map_one _, ?_, hent1, ?_⟩
      · rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_rescale, pow_zero,
          one_mul, PowerSeries.coeff_zero_eq_constantCoeff_apply, hD0]
      · intro ρ hρ
        obtain ⟨C₀, hC₀⟩ := hDent ((‖c‖ + 1) * ρ) (by positivity)
        refine ⟨C₀, fun k => ?_⟩
        rw [PowerSeries.coeff_rescale]
        calc ‖c ^ k * PowerSeries.coeff k D‖ * ρ ^ k
            = ‖PowerSeries.coeff k D‖ * (‖c‖ * ρ) ^ k := by
              rw [norm_mul, norm_pow, mul_pow]; ring
          _ ≤ ‖PowerSeries.coeff k D‖ * ((‖c‖ + 1) * ρ) ^ k := by gcongr; linarith
          _ ≤ C₀ := hC₀ k
      · simp only [Derivation.map_one_eq_zero, mul_zero, sub_zero, mul_one]
        rw [hcomm, hDlog, map_neg, map_mul, hresT]
        ring
    have := hneg _ h
    rwa [neg_neg] at this

  have hq0 : (q : PadicComplex p) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hdec : PowerSeries.mk (fun n => if n = 0 then 0 else (N n : PadicComplex p)) =
      (∑ j ∈ Finset.range (r + 1), ((-1) ^ (j + r) * (r.choose j : ℤ)) •
        PowerSeries.mk (fun n => if n = 0 then 0 else
          ((q : PadicComplex p) ^ j * (q : PadicComplex p)⁻¹) ^ n)) +
      ∑ j ∈ Finset.range (r + 2), ((-1) ^ (j + (r + 1)) * ((r + 1).choose j : ℤ)) •
        PowerSeries.mk (fun n => if n = 0 then 0 else
          ((q : PadicComplex p) ^ j * (q : PadicComplex p)⁻¹) ^ n * t n) := by
    ext n
    simp only [map_add, map_sum, map_zsmul, PowerSeries.coeff_mk]
    simp only [zsmul_eq_mul]
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn; simp
    · have hn0 : n ≠ 0 := by omega
      simp only [hn0, ↓reduceIte]
      have hu : (q : PadicComplex p) ^ n * ((q : PadicComplex p)⁻¹) ^ n = 1 := by
        rw [← mul_pow, mul_inv_cancel₀ hq0, one_pow]
      have hc : ∀ j : ℕ, ((q : PadicComplex p) ^ j * (q : PadicComplex p)⁻¹) ^ n =
          ((q : PadicComplex p) ^ n) ^ j * ((q : PadicComplex p)⁻¹) ^ n := by
        intro j; rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm j n]
      apply mul_left_cancel₀ (pow_ne_zero n hq0)
      rw [hhyp n hn, sub_pow, sub_pow, mul_add]
      simp only [Finset.mul_sum]
      congr 1
      · refine Finset.sum_congr rfl fun j _ => ?_
        rw [hc j]; push_cast [one_pow]
        linear_combination (-((-1 : PadicComplex p) ^ (j + r) * (r.choose j : PadicComplex p) *
          ((q : PadicComplex p) ^ n) ^ j)) * hu
      · refine Finset.sum_congr rfl fun j _ => ?_
        rw [hc j]; push_cast [one_pow]
        linear_combination (-((-1 : PadicComplex p) ^ (j + (r + 1)) *
          ((r + 1).choose j : PadicComplex p) * ((q : PadicComplex p) ^ n) ^ j * t n)) * hu

  have hreal : zqoeReal p (PowerSeries.mk (fun n => if n = 0 then 0 else (N n : PadicComplex p))) := by
    rw [hdec]
    exact hadd _ _
      (hsum _ _ (fun j => PowerSeries.mk (fun n => if n = 0 then 0 else
          ((q : PadicComplex p) ^ j * (q : PadicComplex p)⁻¹) ^ n)) (fun j _ => hS _))
      (hsum _ _ (fun j => PowerSeries.mk (fun n => if n = 0 then 0 else
          ((q : PadicComplex p) ^ j * (q : PadicComplex p)⁻¹) ^ n * t n)) (fun j _ => hT _))
  obtain ⟨A, B, hA, hB, eA, eB, h⟩ := hreal
  refine ⟨A, B, hA, hB, fun ρ hρ => ?_, h⟩
  obtain ⟨c₁, hc₁⟩ := eA ρ hρ
  obtain ⟨c₂, hc₂⟩ := eB ρ hρ
  exact ⟨max c₁ c₂, fun k => ⟨(hc₁ k).trans (le_max_left _ _), (hc₂ k).trans (le_max_right _ _)⟩⟩

theorem zeta_identify : ∀ (K : Type) [Field K] [CharZero K] (N z : ℕ → ℤ) (A B : PowerSeries K), z 0 = 1 → (∀ k : ℕ, (k : ℤ) * z k = ∑ j ∈ Finset.Icc 1 k, N j * z (k - j)) → PowerSeries.constantCoeff A = 1 → PowerSeries.constantCoeff B = 1 → PowerSeries.X * (PowerSeries.derivative A * B - A * PowerSeries.derivative B) = PowerSeries.mk (fun n => if n = 0 then 0 else (N n : K)) * A * B → B * PowerSeries.mk (fun k => (z k : K)) = A :=
by
  intro K _ _ N z A B hz0 hrec hA0 hB0 hAB
  generalize hYdef : PowerSeries.mk (fun k => (z k : K)) = Y
  generalize hNt : PowerSeries.mk (fun n => if n = 0 then 0 else (N n : K)) = Nt at hAB
  have hNt0 : PowerSeries.coeff 0 Nt = 0 := by
    rw [← hNt, PowerSeries.coeff_mk, if_pos rfl]

  have hY : PowerSeries.X * PowerSeries.derivative Y = Nt * Y := by
    ext k
    rcases k with _ | m
    · rw [PowerSeries.coeff_zero_X_mul, PowerSeries.coeff_mul]
      simp [hNt0]
    · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative, PowerSeries.coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ
          (fun i j => PowerSeries.coeff i Nt * PowerSeries.coeff j Y),
        Finset.sum_range_succ', hNt0, zero_mul, add_zero]
      have hsum : ∑ j ∈ Finset.Icc 1 (m + 1), N j * z (m + 1 - j)
          = ∑ i ∈ Finset.range (m + 1), N (i + 1) * z (m + 1 - (i + 1)) := by
        rw [← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel]
        exact Finset.sum_congr rfl (fun i _ => by rw [add_comm 1 i])
      have h := hrec (m + 1)
      rw [hsum] at h
      have hK := congrArg (Int.cast : ℤ → K) h
      push_cast at hK
      rw [← hNt, ← hYdef]
      simp only [PowerSeries.coeff_mk, Nat.add_one_ne_zero, ite_false, Nat.add_sub_add_right]
      rw [mul_comm]
      exact hK

  have hW : PowerSeries.X * (PowerSeries.derivative (B * Y) * B - B * Y * PowerSeries.derivative B)
      = Nt * (B * Y) * B := by
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    linear_combination (B * B) * hY

  have hV : PowerSeries.X * (PowerSeries.derivative (B * Y - A) * B
      - (B * Y - A) * PowerSeries.derivative B) = Nt * (B * Y - A) * B := by
    rw [map_sub]
    linear_combination hW - hAB
  have hYc : PowerSeries.constantCoeff Y = 1 := by
    rw [← hYdef, ← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_mk, hz0,
      Int.cast_one]
  have hVc : PowerSeries.constantCoeff (B * Y - A) = 0 := by
    rw [map_sub, map_mul, hB0, hYc, hA0]; ring
  rw [← sub_eq_zero]
  generalize B * Y - A = V at hV hVc ⊢

  have hv : ∀ k, PowerSeries.coeff k V = 0 := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
    rcases k with _ | m
    · rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]; exact hVc
    · have hL1 : ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
          PowerSeries.coeff p.1 V * PowerSeries.coeff p.2 (PowerSeries.derivative B) = 0 := by
        apply Finset.sum_eq_zero
        intro p hp
        have hs := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        rw [ih p.1 (by omega), zero_mul]
      have hL2 : ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
          PowerSeries.coeff p.1 (PowerSeries.derivative V) * PowerSeries.coeff p.2 B
          = PowerSeries.coeff (m + 1) V * ((m : K) + 1) := by
        rw [Finset.sum_eq_single (m, 0)]
        · rw [PowerSeries.coeff_derivative, PowerSeries.coeff_zero_eq_constantCoeff_apply, hB0,
            mul_one]
        · intro p hp hne
          have hs := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          have hlt : p.1 < m := by
            by_contra hc
            apply hne
            exact Prod.ext (by show p.1 = m; omega) (by show p.2 = 0; omega)
          rw [PowerSeries.coeff_derivative, ih (p.1 + 1) (by omega), zero_mul, zero_mul]
        · intro h
          exact absurd (Finset.HasAntidiagonal.mem_antidiagonal.mpr (by simp)) h
      have hCV : ∀ i ≤ m + 1, PowerSeries.coeff i (Nt * V) = 0 := by
        intro i hi
        rw [PowerSeries.coeff_mul]
        apply Finset.sum_eq_zero
        intro p hp
        have hs := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        by_cases h0 : p.1 = 0
        · rw [h0, hNt0, zero_mul]
        · rw [ih p.2 (by omega), mul_zero]
      have hR : PowerSeries.coeff (m + 1) (Nt * V * B) = 0 := by
        rw [PowerSeries.coeff_mul]
        apply Finset.sum_eq_zero
        intro p hp
        have hs := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        rw [hCV p.1 (by omega), zero_mul]
      have h := congrArg (PowerSeries.coeff (m + 1)) hV
      rw [PowerSeries.coeff_succ_X_mul, map_sub,
        PowerSeries.coeff_mul m (PowerSeries.derivative V) B,
        PowerSeries.coeff_mul m V (PowerSeries.derivative B), hL1, hL2, hR, sub_zero] at h
      exact (mul_eq_zero.mp h).resolve_right (Nat.cast_add_one_ne_zero m)
  have hV0 : V = 0 := by
    ext k
    rw [hv k, map_zero]
  exact hV0

theorem padic_meromorphic_polynomial_denominator : ∀ (p : ℕ) [Fact p.Prime] (A B Y : PowerSeries (PadicComplex p)), PowerSeries.constantCoeff B = 1 → (∀ ρ : ℝ, 0 < ρ → ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k A‖ * ρ ^ k ≤ c ∧ ‖PowerSeries.coeff k B‖ * ρ ^ k ≤ c) → B * Y = A → ∀ R : ℝ, 1 ≤ R → ∃ P : Polynomial (PadicComplex p), P.coeff 0 = 1 ∧ ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k ((P : PowerSeries (PadicComplex p)) * Y)‖ * R ^ k ≤ c :=
by

  have weighted_coeff_mul_le : ∀ {K : Type} [NormedField K] [IsUltrametricDist K] (u v : PowerSeries K) (r a b : ℝ), 0 < r → (∀ k, ‖PowerSeries.coeff k u‖ * r ^ k ≤ a) → (∀ k, ‖PowerSeries.coeff k v‖ * r ^ k ≤ b) → ∀ k, ‖PowerSeries.coeff k (u * v)‖ * r ^ k ≤ a * b := by
    intro K _ _ u v r a b hr hu hv k
    have ha : 0 ≤ a := le_trans (by positivity) (hu 0)
    have hb : 0 ≤ b := le_trans (by positivity) (hv 0)
    have hrk : 0 < r ^ k := pow_pos hr k
    rw [PowerSeries.coeff_mul, ← le_div_iff₀ hrk]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity)
    intro x hx
    have hx' := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    rw [norm_mul, le_div_iff₀ hrk, ← hx', pow_add]
    calc ‖PowerSeries.coeff x.1 u‖ * ‖PowerSeries.coeff x.2 v‖ * (r ^ x.1 * r ^ x.2)
        = (‖PowerSeries.coeff x.1 u‖ * r ^ x.1) * (‖PowerSeries.coeff x.2 v‖ * r ^ x.2) := by ring
      _ ≤ a * b := mul_le_mul (hu _) (hv _) (by positivity) ha

  have weighted_coeff_inv_le : ∀ {K : Type} [NormedField K] [IsUltrametricDist K] (H : PowerSeries K) (r : ℝ), 0 < r → PowerSeries.constantCoeff H = 1 → (∀ k, ‖PowerSeries.coeff k H‖ * r ^ k ≤ 1) → ∀ k, ‖PowerSeries.coeff k H⁻¹‖ * r ^ k ≤ 1 := by
    intro K _ _ H r hr h0 hH n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      rw [PowerSeries.coeff_inv, h0, inv_one]
      split_ifs with hn
      · subst hn; simp
      · have hrn : 0 < r ^ n := pow_pos hr n
        rw [norm_mul, norm_neg, norm_one, one_mul, ← le_div_iff₀ hrn]
        apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity)
        intro x hx
        split_ifs with hx2
        · rw [norm_mul, le_div_iff₀ hrn, ← Finset.HasAntidiagonal.mem_antidiagonal.mp hx, pow_add]
          calc ‖PowerSeries.coeff x.1 H‖ * ‖PowerSeries.coeff x.2 H⁻¹‖ * (r ^ x.1 * r ^ x.2)
              = (‖PowerSeries.coeff x.1 H‖ * r ^ x.1) * (‖PowerSeries.coeff x.2 H⁻¹‖ * r ^ x.2) := by ring
            _ ≤ 1 * 1 := mul_le_mul (hH _) (ih _ hx2) (by positivity) zero_le_one
            _ = 1 := one_mul 1
        · rw [norm_zero]; positivity

  have weierstrass_division_identity : ∀ {K : Type} [CommRing K] (e : ℕ) (G V w : PowerSeries K), PowerSeries.mk (fun k => PowerSeries.coeff (k + e) G) * V = 1 → (∀ k, PowerSeries.coeff k w = (if k = 0 then 1 else 0) - PowerSeries.coeff (k + e) ((PowerSeries.trunc e G : PowerSeries K) * V * w)) → G * (V * w) = ((PowerSeries.trunc e ((PowerSeries.trunc e G : PowerSeries K) * V * w) + Polynomial.X ^ e : Polynomial K) : PowerSeries K) := by
    intro K _ e G V w hSV hw
    have star : ∀ F : PowerSeries K, F = (PowerSeries.trunc e F : PowerSeries K) +
        PowerSeries.X ^ e * PowerSeries.mk (fun k => PowerSeries.coeff (k + e) F) := by
      intro F
      ext n
      rw [map_add, Polynomial.coeff_coe, PowerSeries.coeff_trunc, PowerSeries.coeff_X_pow_mul',
        PowerSeries.coeff_mk]
      by_cases h : n < e
      · rw [if_pos h, if_neg (by omega), add_zero]
      · rw [if_neg h, if_pos (by omega), zero_add, Nat.sub_add_cancel (by omega)]
    obtain ⟨Z, hZ⟩ : ∃ Z : PowerSeries K, Z = (PowerSeries.trunc e G : PowerSeries K) * V * w :=
      ⟨_, rfl⟩
    rw [← hZ] at hw ⊢
    have hT : PowerSeries.mk (fun k => PowerSeries.coeff (k + e) Z) = 1 - w := by
      ext k
      rw [PowerSeries.coeff_mk, map_sub, PowerSeries.coeff_one, hw k]
      ring
    rw [Polynomial.coe_add, Polynomial.coe_pow, Polynomial.coe_X]
    have hG := star G
    have hZ' := star Z
    calc G * (V * w) = ((PowerSeries.trunc e G : PowerSeries K) + PowerSeries.X ^ e *
          PowerSeries.mk (fun k => PowerSeries.coeff (k + e) G)) * (V * w) := by rw [← hG]
      _ = Z + PowerSeries.X ^ e * (PowerSeries.mk (fun k => PowerSeries.coeff (k + e) G) * V) * w := by
          rw [hZ]; ring
      _ = Z + PowerSeries.X ^ e * w := by rw [hSV, mul_one]
      _ = (PowerSeries.trunc e Z : PowerSeries K) + PowerSeries.X ^ e *
          PowerSeries.mk (fun k => PowerSeries.coeff (k + e) Z) + PowerSeries.X ^ e * w := by
          rw [← hZ']
      _ = (PowerSeries.trunc e Z : PowerSeries K) + PowerSeries.X ^ e := by rw [hT]; ring

  have weierstrass_fixed_point : ∀ {K : Type} [NormedField K] [IsUltrametricDist K] [CompleteSpace K] (L : PowerSeries K) (r θ : ℝ) (e : ℕ), 0 < r → 0 ≤ θ → θ < 1 → (∀ k, ‖PowerSeries.coeff k L‖ * r ^ k ≤ θ * r ^ e) → ∃ w : PowerSeries K, (∀ k, ‖PowerSeries.coeff k w‖ * r ^ k ≤ 1) ∧ ∀ k, PowerSeries.coeff k w = (if k = 0 then 1 else 0) - PowerSeries.coeff (k + e) (L * w) := by
    intro K _ _ _ L r θ e hr _ hθ1 hL
    have hre : 0 < r ^ e := pow_pos hr e
    have shift : ∀ (x : PowerSeries K) (s : ℝ), (∀ k, ‖PowerSeries.coeff k x‖ * r ^ k ≤ s) →
        ∀ k, ‖PowerSeries.coeff (k + e) (L * x)‖ * r ^ k ≤ θ * s := by
      intro x s hx k
      have h := weighted_coeff_mul_le L x r (θ * r ^ e) s hr hL hx (k + e)
      rw [pow_add] at h
      have h' : ‖PowerSeries.coeff (k + e) (L * x)‖ * r ^ k * r ^ e ≤ θ * s * r ^ e := by
        calc _ = ‖PowerSeries.coeff (k + e) (L * x)‖ * (r ^ k * r ^ e) := by ring
          _ ≤ θ * r ^ e * s := h
          _ = θ * s * r ^ e := by ring
      exact le_of_mul_le_mul_right h' hre
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : PowerSeries K → PowerSeries K, Φ = fun x => PowerSeries.mk
        (fun k => (if k = 0 then 1 else 0) - PowerSeries.coeff (k + e) (L * x)) := ⟨_, rfl⟩
    have hΦ : ∀ x k, PowerSeries.coeff k (Φ x) =
        (if k = 0 then 1 else 0) - PowerSeries.coeff (k + e) (L * x) := by
      intro x k; rw [hΦdef]; exact PowerSeries.coeff_mk _ _
    obtain ⟨xs, hx0, hxs⟩ : ∃ xs : ℕ → PowerSeries K, xs 0 = 1 ∧ ∀ n, xs (n + 1) = Φ (xs n) :=
      ⟨fun n => Φ^[n] 1, rfl, fun n => Function.iterate_succ_apply' Φ n 1⟩
    have hδ : ∀ k, ‖(if k = 0 then (1:K) else 0)‖ * r ^ k ≤ 1 := by
      intro k; split_ifs with h
      · subst h; simp
      · simp
    have hsub : ∀ (a b : K) (k : ℕ), ‖a‖ * r ^ k ≤ 1 → ‖b‖ * r ^ k ≤ 1 → ‖a - b‖ * r ^ k ≤ 1 := by
      intro a b k ha hb
      have h1 : ‖a - b‖ ≤ max ‖a‖ ‖b‖ := by
        have := IsUltrametricDist.norm_add_le_max a (-b)
        rwa [norm_neg, ← sub_eq_add_neg] at this
      have hrk : 0 < r ^ k := pow_pos hr k
      calc ‖a - b‖ * r ^ k ≤ max ‖a‖ ‖b‖ * r ^ k := mul_le_mul_of_nonneg_right h1 hrk.le
        _ = max (‖a‖ * r ^ k) (‖b‖ * r ^ k) := max_mul_of_nonneg _ _ hrk.le
        _ ≤ 1 := max_le ha hb
    have hbound : ∀ n k, ‖PowerSeries.coeff k (xs n)‖ * r ^ k ≤ 1 := by
      intro n
      induction n with
      | zero =>
        intro k
        rw [hx0, PowerSeries.coeff_one]; exact hδ k
      | succ n ih =>
        intro k
        rw [hxs, hΦ]
        apply hsub _ _ k (hδ k)
        calc _ ≤ θ * 1 := shift (xs n) 1 ih k
          _ ≤ 1 := by linarith
    have hΦsub : ∀ y z k, PowerSeries.coeff k (Φ y - Φ z) =
        -PowerSeries.coeff (k + e) (L * (y - z)) := by
      intro y z k
      rw [map_sub, hΦ, hΦ, mul_sub, map_sub]
      ring
    have hdiff : ∀ n k, ‖PowerSeries.coeff k (xs (n + 1) - xs n)‖ * r ^ k ≤ θ ^ n := by
      intro n
      induction n with
      | zero =>
        intro k
        rw [map_sub, pow_zero]
        exact hsub _ _ k (hbound 1 k) (hbound 0 k)
      | succ n ih =>
        intro k
        have heq : xs (n + 1 + 1) - xs (n + 1) = Φ (xs (n + 1)) - Φ (xs n) := by
          rw [← hxs, ← hxs]
        rw [heq, hΦsub, norm_neg, pow_succ]
        calc _ ≤ θ * θ ^ n := shift _ _ ih k
          _ = θ ^ n * θ := mul_comm _ _
    have hconv : ∀ k, ∃ ω : K,
        Filter.Tendsto (fun n => PowerSeries.coeff k (xs n)) Filter.atTop (nhds ω) := by
      intro k
      have hrk : 0 < r ^ k := pow_pos hr k
      apply cauchySeq_tendsto_of_complete
      apply cauchySeq_of_le_geometric θ (r ^ k)⁻¹ hθ1
      intro n
      rw [dist_eq_norm, ← norm_neg, neg_sub, ← map_sub]
      have := hdiff n k
      rw [← le_div_iff₀ hrk] at this
      calc _ ≤ θ ^ n / r ^ k := this
        _ = (r ^ k)⁻¹ * θ ^ n := by rw [div_eq_inv_mul]
    choose ω hω using hconv
    refine ⟨PowerSeries.mk ω, fun k => ?_, fun k => ?_⟩
    · rw [PowerSeries.coeff_mk]
      exact le_of_tendsto' ((hω k).norm.mul_const _) (fun n => hbound n k)
    · rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul]
      have h1 : Filter.Tendsto (fun n => PowerSeries.coeff k (xs (n + 1))) Filter.atTop
          (nhds (ω k)) := (hω k).comp (Filter.tendsto_add_atTop_nat 1)
      have h3 : ∀ n, PowerSeries.coeff k (xs (n + 1)) = (if k = 0 then 1 else 0) -
          ∑ p ∈ (Finset.HasAntidiagonal.antidiagonal (k + e) : Finset (ℕ × ℕ)),
            PowerSeries.coeff p.1 L * PowerSeries.coeff p.2 (xs n) := by
        intro n; rw [hxs, hΦ, PowerSeries.coeff_mul]
      have h2 : Filter.Tendsto (fun n => PowerSeries.coeff k (xs (n + 1))) Filter.atTop
          (nhds ((if k = 0 then 1 else 0) -
            ∑ p ∈ (Finset.HasAntidiagonal.antidiagonal (k + e) : Finset (ℕ × ℕ)),
            PowerSeries.coeff p.1 L * PowerSeries.coeff p.2 (PowerSeries.mk ω))) := by
        simp_rw [h3, PowerSeries.coeff_mk]
        apply Filter.Tendsto.sub tendsto_const_nhds
        apply tendsto_finsetSum
        intro p _
        exact (hω p.2).const_mul _
      exact tendsto_nhds_unique h1 h2

  have first_dominant_index : ∀ {K : Type} [NormedField K] (B : PowerSeries K) (r : ℝ), 0 < r → PowerSeries.constantCoeff B = 1 → (∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k B‖ * (2 * r) ^ k ≤ c) → ∃ (e : ℕ) (θ : ℝ), 0 ≤ θ ∧ θ < 1 ∧ PowerSeries.coeff e B ≠ 0 ∧ (∀ k, ‖PowerSeries.coeff k B‖ * r ^ k ≤ ‖PowerSeries.coeff e B‖ * r ^ e) ∧ (∀ k < e, ‖PowerSeries.coeff k B‖ * r ^ k ≤ θ * (‖PowerSeries.coeff e B‖ * r ^ e)) := by
    intro K _ B r hr hB0 hc
    classical
    obtain ⟨c, hc⟩ := hc
    obtain ⟨α, hα⟩ : ∃ α : ℕ → ℝ, α = fun k => ‖PowerSeries.coeff k B‖ * r ^ k := ⟨_, rfl⟩
    have hαk : ∀ k, α k = ‖PowerSeries.coeff k B‖ * r ^ k := by intro k; rw [hα]
    have hα0 : α 0 = 1 := by
      rw [hαk, pow_zero, mul_one, PowerSeries.coeff_zero_eq_constantCoeff_apply, hB0, norm_one]
    have hαnn : ∀ k, 0 ≤ α k := fun k => by rw [hαk]; positivity
    have hαc : ∀ k, α k * 2 ^ k ≤ c := by
      intro k
      calc α k * 2 ^ k = ‖PowerSeries.coeff k B‖ * (2 * r) ^ k := by rw [hαk, mul_pow]; ring
        _ ≤ c := hc k
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt c (by norm_num : (1:ℝ) < 2)
    have htail : ∀ k, N ≤ k → α k < 1 := by
      intro k hk
      have h1 := hαc k
      have h2 : (2:ℝ) ^ N ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
      have h3 : (0:ℝ) < 2 ^ k := by positivity
      by_contra hcon
      have hcon' : 1 ≤ α k := le_of_not_gt hcon
      nlinarith
    have hNpos : 0 < N := by
      rcases Nat.eq_zero_or_pos N with h | h
      · have := hαc 0
        rw [hα0, pow_zero, mul_one] at this
        rw [h, pow_zero] at hN; linarith
      · exact h
    obtain ⟨m, _, hmmax⟩ :=
      Finset.exists_max_image (Finset.range N) α ⟨0, Finset.mem_range.mpr hNpos⟩
    have hμ1 : 1 ≤ α m := by
      have := hmmax 0 (Finset.mem_range.mpr hNpos)
      rwa [hα0] at this
    have hall : ∀ k, α k ≤ α m := by
      intro k
      by_cases hk : k < N
      · exact hmmax k (Finset.mem_range.mpr hk)
      · linarith [htail k (by omega)]
    have hex : ∃ k, α k = α m := ⟨m, rfl⟩
    obtain ⟨e, he⟩ : ∃ e, e = Nat.find hex := ⟨_, rfl⟩
    have heq : α e = α m := by rw [he]; exact Nat.find_spec hex
    have hlt : ∀ k < e, α k < α m := by
      intro k hk
      have : α k ≠ α m := by rw [he] at hk; exact Nat.find_min hex hk
      exact lt_of_le_of_ne (hall k) this
    have hbe : PowerSeries.coeff e B ≠ 0 := by
      intro h0
      have : α e = 0 := by rw [hαk, h0, norm_zero, zero_mul]
      linarith
    have hμpos : 0 < α m := by linarith
    have hθ : ∃ θ : ℝ, 0 ≤ θ ∧ θ < 1 ∧ ∀ k < e, α k ≤ θ * α m := by
      rcases Nat.eq_zero_or_pos e with h | h
      · exact ⟨0, le_refl _, zero_lt_one, fun k hk => by omega⟩
      · obtain ⟨m', hm'S, hm'max⟩ :=
          Finset.exists_max_image (Finset.range e) α ⟨0, Finset.mem_range.mpr h⟩
        refine ⟨α m' / α m, div_nonneg (hαnn _) hμpos.le,
          (div_lt_one hμpos).mpr (hlt m' (Finset.mem_range.mp hm'S)), fun k hk => ?_⟩
        rw [div_mul_cancel₀ _ hμpos.ne']
        exact hm'max k (Finset.mem_range.mpr hk)
    obtain ⟨θ, hθ0, hθ1, hθk⟩ := hθ
    refine ⟨e, θ, hθ0, hθ1, hbe, fun k => ?_, fun k hk => ?_⟩
    · rw [← hαk, ← hαk, heq]; exact hall k
    · rw [← hαk, ← hαk, heq]; exact hθk k hk

  intro p _ A B Y hB0 hent hBY R hR
  have hRpos : (0 : ℝ) < R := by linarith
  obtain ⟨c2, hc2⟩ := hent (2 * R) (by linarith)
  obtain ⟨e, θ, hθ0, hθ1, hbe, hmax, hlow⟩ :=
    first_dominant_index B R hRpos hB0 ⟨c2, fun k => (hc2 k).2⟩
  obtain ⟨β, hβ⟩ : ∃ β, β = PowerSeries.coeff e B := ⟨_, rfl⟩
  rw [← hβ] at hbe hmax hlow
  have hβn : 0 < ‖β‖ := norm_pos_iff.mpr hbe
  have hRe : 0 < R ^ e := pow_pos hRpos e
  obtain ⟨H, hH⟩ : ∃ H : PowerSeries (PadicComplex p),
      H = PowerSeries.mk (fun k => PowerSeries.coeff (k + e) B) := ⟨_, rfl⟩
  obtain ⟨H', hH'⟩ : ∃ H' : PowerSeries (PadicComplex p), H' = PowerSeries.C β⁻¹ * H :=
    ⟨_, rfl⟩
  have hH'0 : PowerSeries.constantCoeff H' = 1 := by
    rw [hH', map_mul, PowerSeries.constantCoeff_C, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
      hH, PowerSeries.coeff_mk, zero_add, ← hβ]
    exact inv_mul_cancel₀ hbe
  have hH'b : ∀ k, ‖PowerSeries.coeff k H'‖ * R ^ k ≤ 1 := by
    intro k
    rw [hH', PowerSeries.coeff_C_mul, hH, PowerSeries.coeff_mk, norm_mul, norm_inv]
    have h1 := hmax (k + e)
    rw [pow_add] at h1
    have h2 : ‖PowerSeries.coeff (k + e) B‖ * R ^ k ≤ ‖β‖ := by
      have h3 : ‖PowerSeries.coeff (k + e) B‖ * R ^ k * R ^ e ≤ ‖β‖ * R ^ e := by
        rw [mul_assoc]; exact h1
      exact le_of_mul_le_mul_right h3 hRe
    rw [mul_assoc]
    calc ‖β‖⁻¹ * (‖PowerSeries.coeff (k + e) B‖ * R ^ k) ≤ ‖β‖⁻¹ * ‖β‖ :=
          mul_le_mul_of_nonneg_left h2 (inv_nonneg.mpr hβn.le)
      _ = 1 := inv_mul_cancel₀ hβn.ne'
  have hinv := weighted_coeff_inv_le H' R hRpos hH'0 hH'b
  obtain ⟨V, hV⟩ : ∃ V : PowerSeries (PadicComplex p), V = PowerSeries.C β⁻¹ * H'⁻¹ :=
    ⟨_, rfl⟩
  have hVb : ∀ k, ‖PowerSeries.coeff k V‖ * R ^ k ≤ ‖β‖⁻¹ := by
    intro k
    rw [hV, PowerSeries.coeff_C_mul, norm_mul, norm_inv, mul_assoc]
    calc ‖β‖⁻¹ * (‖PowerSeries.coeff k H'⁻¹‖ * R ^ k) ≤ ‖β‖⁻¹ * 1 :=
          mul_le_mul_of_nonneg_left (hinv k) (inv_nonneg.mpr hβn.le)
      _ = ‖β‖⁻¹ := mul_one _
  have hHV : PowerSeries.mk (fun k => PowerSeries.coeff (k + e) B) * V = 1 := by
    rw [← hH, hV]
    calc H * (PowerSeries.C β⁻¹ * H'⁻¹) = (PowerSeries.C β⁻¹ * H) * H'⁻¹ := by ring
      _ = H' * H'⁻¹ := by rw [hH']
      _ = 1 := PowerSeries.mul_inv_cancel _ (by rw [hH'0]; exact one_ne_zero)
  have hV0 : PowerSeries.coeff 0 V ≠ 0 := by
    rw [hV, PowerSeries.coeff_C_mul, PowerSeries.coeff_zero_eq_constantCoeff_apply,
      PowerSeries.constantCoeff_inv, hH'0, inv_one, mul_one]
    exact inv_ne_zero hbe
  have hℓb : ∀ k, ‖PowerSeries.coeff k ((PowerSeries.trunc e B : PowerSeries (PadicComplex p)))‖
      * R ^ k ≤ θ * (‖β‖ * R ^ e) := by
    intro k
    rw [Polynomial.coeff_coe, PowerSeries.coeff_trunc]
    split_ifs with hk
    · exact hlow k hk
    · rw [norm_zero, zero_mul]; positivity
  have hLb0 := weighted_coeff_mul_le _ V R _ _ hRpos hℓb hVb
  have hLb : ∀ k, ‖PowerSeries.coeff k
      ((PowerSeries.trunc e B : PowerSeries (PadicComplex p)) * V)‖ * R ^ k ≤ θ * R ^ e := by
    intro k
    calc _ ≤ θ * (‖β‖ * R ^ e) * ‖β‖⁻¹ := hLb0 k
      _ = θ * R ^ e := by field_simp
  obtain ⟨w, hwb, hwfix⟩ :=
    weierstrass_fixed_point ((PowerSeries.trunc e B : PowerSeries (PadicComplex p)) * V)
      R θ e hRpos hθ0 hθ1 hLb
  have hdiv0 := weierstrass_division_identity e B V w hHV hwfix
  obtain ⟨f, hf⟩ : ∃ f : Polynomial (PadicComplex p),
      f = PowerSeries.trunc e ((PowerSeries.trunc e B : PowerSeries (PadicComplex p)) * V * w)
        + Polynomial.X ^ e := ⟨_, rfl⟩
  have hdiv : B * (V * w) = (f : PowerSeries (PadicComplex p)) := by rw [hf]; exact hdiv0
  have hLw := weighted_coeff_mul_le _ w R _ _ hRpos hLb hwb
  have hw0 : PowerSeries.coeff 0 w ≠ 0 := by
    intro h0
    have h := hwfix 0
    rw [h0, if_pos rfl, zero_add] at h
    have h1 : PowerSeries.coeff e
        ((PowerSeries.trunc e B : PowerSeries (PadicComplex p)) * V * w) = 1 := by
      linear_combination h
    have h2 := hLw e
    rw [h1, norm_one, one_mul, mul_one] at h2
    have h3 := mul_lt_mul_of_pos_right hθ1 hRe
    linarith
  have hf0 : f.coeff 0 ≠ 0 := by
    rw [← Polynomial.coeff_coe, ← hdiv, PowerSeries.coeff_zero_eq_constantCoeff_apply, map_mul,
      map_mul, hB0, one_mul, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
      ← PowerSeries.coeff_zero_eq_constantCoeff_apply]
    exact mul_ne_zero hV0 hw0
  refine ⟨Polynomial.C (f.coeff 0)⁻¹ * f, ?_, ?_⟩
  · rw [Polynomial.coeff_C_mul]
    exact inv_mul_cancel₀ hf0
  · obtain ⟨cA, hcA⟩ := hent R hRpos
    have hq := weighted_coeff_mul_le V w R _ _ hRpos hVb hwb
    have hqA := weighted_coeff_mul_le (V * w) A R _ _ hRpos hq (fun k => (hcA k).1)
    have heq : ((Polynomial.C (f.coeff 0)⁻¹ * f : Polynomial (PadicComplex p)) :
        PowerSeries (PadicComplex p)) * Y = PowerSeries.C (f.coeff 0)⁻¹ * (V * w * A) := by
      rw [Polynomial.coe_mul, Polynomial.coe_C, ← hdiv, ← hBY]
      ring
    refine ⟨‖(f.coeff 0)⁻¹‖ * (‖β‖⁻¹ * 1 * cA), fun k => ?_⟩
    rw [heq, PowerSeries.coeff_C_mul, norm_mul, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hqA k) (norm_nonneg _)

theorem borel_hankel_vanishing : ∀ (p : ℕ) [Fact p.Prime] (z : ℕ → ℤ) (M : ℕ), 1 ≤ M → (∀ k, |z k| ≤ (M : ℤ) ^ k) → (∀ R : ℝ, 1 ≤ R → ∃ P : Polynomial (PadicComplex p), P.coeff 0 = 1 ∧ ∃ c : ℝ, ∀ k, ‖PowerSeries.coeff k ((P : PowerSeries (PadicComplex p)) * PowerSeries.mk (fun k => (z k : PadicComplex p)))‖ * R ^ k ≤ c) → ∃ m S : ℕ, ∀ s, S ≤ s → (Matrix.of fun i j : Fin (m + 1) => (z (s + i + j) : ℚ)).det = 0 :=
by
  intro p _ z M hM hz hRhyp

  have s3 : ∀ (n : ℕ) (G : Matrix (Fin n) (Fin n) (PadicComplex p)) (g : Fin n → ℝ),
      (∀ j, 0 ≤ g j) → (∀ i j, ‖G i j‖ ≤ g j) → ‖G.det‖ ≤ ∏ j, g j := by
    intro n G g hg hG
    rw [Matrix.det_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (Finset.prod_nonneg fun j _ => hg j)
    intro σ _
    have hb : ‖∏ i, G (σ i) i‖ ≤ ∏ i, g i := by
      rw [norm_prod]
      gcongr with i _
      exact hG _ _
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h
    · rw [h, one_smul]; exact hb
    · rw [h, Units.neg_smul, one_smul, norm_neg]; exact hb

  have s6 : ∀ D : ℤ, D ≠ 0 → 1 ≤ ((|D| : ℤ) : ℝ) * ‖(D : PadicComplex p)‖ := by
    intro D hD
    have h1 : ‖(D : PadicComplex p)‖ = ‖(D : ℚ_[p])‖ := by
      rw [← map_intCast (algebraMap ℚ_[p] (PadicComplex p)), norm_algebraMap']
    have h2 : ‖(D : ℚ_[p])‖ = padicNorm p (D : ℚ) := by
      rw [← Padic.eq_padicNorm]; push_cast; rfl
    have hDq : (D : ℚ) ≠ 0 := by exact_mod_cast hD
    rw [h1, h2, padicNorm.eq_zpow_of_nonzero hDq, padicValRat.of_int]
    have hdvd := padicValInt_dvd (p := p) D
    have hle : ((p : ℤ) ^ padicValInt p D) ≤ |D| :=
      Int.le_of_dvd (abs_pos.mpr hD) ((dvd_abs _ _).mpr hdvd)
    have hpos : (0 : ℝ) < (p : ℝ) ^ padicValInt p D := by
      have : (0 : ℝ) < p := by exact_mod_cast (Fact.out : p.Prime).pos
      positivity
    have hle' : (p : ℝ) ^ padicValInt p D ≤ ((|D| : ℤ) : ℝ) := by exact_mod_cast hle
    push_cast
    rw [zpow_neg, zpow_natCast]
    rw [le_mul_inv_iff₀ hpos, one_mul]
    push_cast at hle'
    exact hle'

  have s2 : ∀ (a : ℕ → PadicComplex p) (P : Polynomial (PadicComplex p)) (m s : ℕ), P.coeff 0 = 1 →
      (Matrix.of fun i j : Fin (m + 1) => a (s + i + j)).det =
      (Matrix.of fun i j : Fin (m + 1) => if (j : ℕ) < P.natDegree then a (s + i + j) else
        PowerSeries.coeff (s + i + j) ((P : PowerSeries (PadicComplex p)) * PowerSeries.mk a)).det := by
    intro a P m s hP
    let U : Matrix (Fin (m+1)) (Fin (m+1)) (PadicComplex p) := fun j' j =>
      if P.natDegree ≤ (j:ℕ) then (if (j':ℕ) ≤ j then P.coeff (j - j') else 0)
      else (if j' = j then 1 else 0)
    have hU : U.det = 1 := by
      rw [Matrix.det_of_upperTriangular]
      · apply Finset.prod_eq_one
        intro j _
        simp only [U, le_refl, if_true, Nat.sub_self, hP, ite_self]
      · intro j j' hlt
        have h1 : ¬ ((j : ℕ) ≤ j') := by
          have : (j' : ℕ) < j := hlt
          omega
        have h2 : j ≠ j' := ne_of_gt hlt
        simp only [U, h1, h2, if_false, ite_self]
    have hHU : (Matrix.of fun i j : Fin (m + 1) => a (s + i + j)) * U =
        (Matrix.of fun i j : Fin (m + 1) => if (j : ℕ) < P.natDegree then a (s + i + j) else
          PowerSeries.coeff (s + i + j) ((P : PowerSeries (PadicComplex p)) * PowerSeries.mk a)) := by
      ext i j
      rw [Matrix.mul_apply]
      by_cases hj : (j : ℕ) < P.natDegree
      · have hj' : ¬ P.natDegree ≤ (j : ℕ) := not_le.mpr hj
        simp only [U, hj', if_false, Matrix.of_apply, hj, if_true, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq', Finset.mem_univ]
      · have hj' : P.natDegree ≤ (j : ℕ) := not_lt.mp hj
        simp only [U, hj', if_true, Matrix.of_apply, hj, if_false, mul_ite, mul_zero]
        rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
          (fun x y => PowerSeries.coeff x (P : PowerSeries (PadicComplex p)) *
            PowerSeries.coeff y (PowerSeries.mk a))]
        simp only [Polynomial.coeff_coe, PowerSeries.coeff_mk]
        rw [Fin.sum_univ_eq_sum_range
          (fun x => if x ≤ (j:ℕ) then a (s + i + x) * P.coeff (j - x) else 0) (m + 1)]
        rw [← Finset.sum_filter]
        have hfil : (Finset.range (m + 1)).filter (fun x => x ≤ (j : ℕ)) =
            Finset.range ((j : ℕ) + 1) := by
          ext x; simp only [Finset.mem_filter, Finset.mem_range]; omega
        rw [hfil]
        have hsub : Finset.range ((j : ℕ) + 1) ⊆ Finset.range ((s + i + j : ℕ) + 1) := by
          intro x; simp only [Finset.mem_range]; omega
        rw [← Finset.sum_subset hsub]
        · rw [← Finset.sum_range_reflect]
          apply Finset.sum_congr rfl
          intro l hl
          simp only [Finset.mem_range] at hl
          rw [mul_comm]
          congr 2 <;> omega
        · intro l _ hl
          simp only [Finset.mem_range, not_lt] at hl
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
    rw [← hHU, Matrix.det_mul, hU, mul_one]

  have hMr : (1:ℝ) ≤ M := by exact_mod_cast hM
  have hMpos : (0:ℝ) < M := by linarith
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = 2 * M := ⟨_, rfl⟩
  have hR1 : 1 ≤ R := by rw [hRdef]; linarith
  have hRpos : 0 < R := by linarith
  obtain ⟨P, hP0, c, hc⟩ := hRhyp R hR1
  have hc0 : 0 ≤ c := by
    have h := hc 0
    rw [pow_zero, mul_one] at h
    exact (norm_nonneg _).trans h
  obtain ⟨e, he⟩ : ∃ e, e = P.natDegree := ⟨_, rfl⟩
  obtain ⟨n, hn⟩ : ∃ n, n = M ^ e := ⟨_, rfl⟩
  refine ⟨e + n, ?_⟩
  obtain ⟨D, hD⟩ : ∃ D : ℕ → ℤ, D = fun s => (Matrix.of fun i j : Fin (e + n + 1) => z (s + i + j)).det :=
    ⟨_, rfl⟩
  have hDq : ∀ s, (Matrix.of fun i j : Fin (e + n + 1) => (z (s + i + j) : ℚ)).det = (D s : ℚ) := by
    intro s; rw [hD, Int.cast_det]; rfl

  have hpad : ∀ s, ‖((D s : ℤ) : PadicComplex p)‖ ≤ (c / R ^ s) ^ (n + 1) := by
    intro s
    have h1 : ((D s : ℤ) : PadicComplex p) =
        (Matrix.of fun i j : Fin (e + n + 1) => ((z (s + i + j) : ℤ) : PadicComplex p)).det := by
      rw [hD, Int.cast_det]; rfl
    rw [h1, s2 (fun k => (z k : PadicComplex p)) P (e + n) s hP0, ← he]
    have hcs : 0 ≤ c / R ^ s := div_nonneg hc0 (pow_nonneg hRpos.le _)
    refine (s3 (e + n + 1) _ (fun j : Fin (e + n + 1) => if (j : ℕ) < e then 1 else c / R ^ s)
      ?_ ?_).trans ?_
    · intro j
      split_ifs
      · norm_num
      · exact hcs
    · intro i j
      simp only [Matrix.of_apply]
      split_ifs with hj
      · exact IsUltrametricDist.norm_intCast_le_one _ _
      · have hk := hc (s + i + j)
        rw [le_div_iff₀ (pow_pos hRpos s)]
        calc _ ≤ ‖PowerSeries.coeff (s + i + j) ((P : PowerSeries (PadicComplex p)) *
              PowerSeries.mk (fun k => (z k : PadicComplex p)))‖ * R ^ (s + i + j) :=
              mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hR1 (by omega)) (norm_nonneg _)
          _ ≤ c := hk
    · have hsplit := Fin.prod_univ_add (a := e) (b := n + 1)
        (fun j => if (j : ℕ) < e then (1:ℝ) else c / R ^ s)
      simp at hsplit
      rw [div_pow]
      exact le_of_eq hsplit

  have harch : ∀ s, |D s| ≤ ((e + n + 1).factorial : ℤ) * ((M:ℤ) ^ (s + 2 * (e + n))) ^ (e + n + 1) := by
    intro s
    have h := Matrix.det_le (A := Matrix.of fun i j : Fin (e + n + 1) => z (s + i + j))
      (abv := AbsoluteValue.abs) (x := (M:ℤ) ^ (s + 2 * (e + n))) (by
        intro i j
        simp only [Matrix.of_apply, AbsoluteValue.abs_apply]
        refine (hz _).trans (pow_le_pow_right₀ (by exact_mod_cast hM) ?_)
        have := i.is_lt; have := j.is_lt; omega)
    rw [Fintype.card_fin, nsmul_eq_mul, AbsoluteValue.abs_apply] at h
    rw [hD]; exact h

  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((e + n + 1).factorial : ℝ) * (M:ℝ) ^ (2 * (e + n) * (e + n + 1)) *
      c ^ (n + 1) := ⟨_, rfl⟩
  have hgrow : ∀ s, D s ≠ 0 → ((2:ℝ) ^ (n + 1)) ^ s ≤ K * ((M:ℝ) ^ e) ^ s := by
    intro s hDs
    have h6 := s6 (D s) hDs
    have h4 := hpad s
    have h5 : ((|D s| : ℤ) : ℝ) ≤ ((e + n + 1).factorial : ℝ) *
        ((M:ℝ) ^ (s + 2 * (e + n))) ^ (e + n + 1) := by
      exact_mod_cast harch s
    have hRs : 0 < (R ^ s) ^ (n + 1) := by positivity
    have h4' : ‖((D s : ℤ) : PadicComplex p)‖ * (R ^ s) ^ (n + 1) ≤ c ^ (n + 1) := by
      rw [div_pow, le_div_iff₀ hRs] at h4; exact h4
    have hA0 : 0 ≤ ((|D s| : ℤ) : ℝ) := by positivity
    have key : (R ^ s) ^ (n + 1) ≤ ((e + n + 1).factorial : ℝ) *
        ((M:ℝ) ^ (s + 2 * (e + n))) ^ (e + n + 1) * c ^ (n + 1) := by
      calc (R ^ s) ^ (n + 1) ≤ (((|D s| : ℤ) : ℝ) * ‖((D s : ℤ) : PadicComplex p)‖) * (R ^ s) ^ (n + 1) := by
            nlinarith
        _ = ((|D s| : ℤ) : ℝ) * (‖((D s : ℤ) : PadicComplex p)‖ * (R ^ s) ^ (n + 1)) := by ring
        _ ≤ ((|D s| : ℤ) : ℝ) * c ^ (n + 1) := mul_le_mul_of_nonneg_left h4' hA0
        _ ≤ _ := mul_le_mul_of_nonneg_right h5 (pow_nonneg hc0 _)
    have e1 : (R ^ s) ^ (n + 1) = ((2:ℝ) ^ (n + 1)) ^ s * ((M:ℝ) ^ (n + 1)) ^ s := by
      rw [hRdef]; ring
    have e2 : ((e + n + 1).factorial : ℝ) * ((M:ℝ) ^ (s + 2 * (e + n))) ^ (e + n + 1) * c ^ (n + 1) =
        K * ((M:ℝ) ^ e) ^ s * ((M:ℝ) ^ (n + 1)) ^ s := by
      rw [hK]; ring
    rw [e1, e2] at key
    have hpos : 0 < ((M:ℝ) ^ (n + 1)) ^ s := by positivity
    exact le_of_mul_le_mul_right key hpos

  have hab : (M:ℝ) ^ e < (2:ℝ) ^ (n + 1) := by
    have : M ^ e < 2 ^ (n + 1) := by
      rw [← hn]
      exact (Nat.lt_two_pow_self).trans (Nat.pow_lt_pow_right (by norm_num) (by omega))
    exact_mod_cast this
  have ha0 : (0:ℝ) < (M:ℝ) ^ e := by positivity
  have hy : 1 < (2:ℝ) ^ (n + 1) / (M:ℝ) ^ e := (one_lt_div ha0).mpr hab
  obtain ⟨S, hS⟩ := pow_unbounded_of_one_lt K hy
  refine ⟨S, fun s hs => ?_⟩
  rw [hDq]
  by_contra hne
  have hDs : D s ≠ 0 := by exact_mod_cast hne
  have h1 := hgrow s hDs
  have h2 : ((2:ℝ) ^ (n + 1) / (M:ℝ) ^ e) ^ S ≤ ((2:ℝ) ^ (n + 1) / (M:ℝ) ^ e) ^ s :=
    pow_le_pow_right₀ hy.le hs
  have h3 : ((2:ℝ) ^ (n + 1) / (M:ℝ) ^ e) ^ s ≤ K := by
    rw [div_pow, div_le_iff₀ (pow_pos ha0 s)]
    exact h1
  linarith

theorem kronecker_rational_of_hankel : ∀ (a : ℕ → ℚ) (m S : ℕ), (∀ s, S ≤ s → (Matrix.of fun i j : Fin (m + 1) => a (s + i + j)).det = 0) → ∃ P Q : Polynomial ℚ, Q.coeff 0 = 1 ∧ (Q : PowerSeries ℚ) * PowerSeries.mk a = (P : PowerSeries ℚ) :=
by
  classical

  have t_s3 : ∀ (a : ℕ → ℚ) (k T : ℕ) (c : Fin k → ℚ),
      (∀ s, T ≤ s → a (s + k) = ∑ j : Fin k, c j * a (s + j)) →
      ∃ P Q : Polynomial ℚ, Q.coeff 0 = 1 ∧
        (Q : PowerSeries ℚ) * PowerSeries.mk a = (P : PowerSeries ℚ) := by
    intro a k T c h
    set Q : Polynomial ℚ := 1 - ∑ j : Fin k, Polynomial.C (c j) * Polynomial.X ^ (k - (j : ℕ)) with hQ
    have hQc : (Q : PowerSeries ℚ) =
        1 - ∑ j : Fin k, PowerSeries.C (c j) * PowerSeries.X ^ (k - (j : ℕ)) := by
      have hs : ((∑ j : Fin k, Polynomial.C (c j) * Polynomial.X ^ (k - (j : ℕ)) : Polynomial ℚ) :
          PowerSeries ℚ) = ∑ j : Fin k, ((Polynomial.C (c j) * Polynomial.X ^ (k - (j : ℕ)) :
            Polynomial ℚ) : PowerSeries ℚ) :=
        map_sum (Polynomial.coeToPowerSeries.ringHom (R := ℚ)) _ _
      simp [hQ, hs, Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_mul, Polynomial.coe_pow,
        Polynomial.coe_X, Polynomial.coe_C]
    have hcoef : ∀ N, T + k ≤ N →
        PowerSeries.coeff N ((Q : PowerSeries ℚ) * PowerSeries.mk a) = 0 := by
      intro N hN
      rw [hQc, sub_mul, Finset.sum_mul, map_sub, map_sum]
      simp only [one_mul, PowerSeries.coeff_mk, mul_assoc, PowerSeries.coeff_C_mul,
        PowerSeries.coeff_X_pow_mul']
      obtain ⟨s, rfl⟩ : ∃ s, N = s + k := ⟨N - k, by omega⟩
      rw [h s (by omega), sub_eq_zero]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [if_pos (by omega)]
      congr 2
      omega
    refine ⟨PowerSeries.trunc (T + k) ((Q : PowerSeries ℚ) * PowerSeries.mk a), Q, ?_, ?_⟩
    · rw [hQ, Polynomial.coeff_sub, Polynomial.coeff_one_zero, Polynomial.finset_sum_coeff]
      rw [Finset.sum_eq_zero (fun j _ => ?_), sub_zero]
      rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
    · ext N
      rw [Polynomial.coeff_coe, PowerSeries.coeff_trunc]
      split_ifs with hN
      · rfl
      · exact hcoef N (by omega)

  have t_s1 : ∀ (a : ℕ → ℚ) (k s : ℕ),
      (Matrix.of fun i j : Fin (k + 1) => a (s + i + j)).det = 0 →
      (Matrix.of fun i j : Fin k => a (s + 1 + i + j)).det ≠ 0 →
      (Matrix.of fun i j : Fin k => a (s + i + j)).det ≠ 0 := by
    intro a k s h1 h2
    set M := Matrix.of fun i j : Fin (k + 1) => a (s + i + j) with hM
    have hA : ∀ x : Fin (k + 1) → ℚ, M.mulVec x = 0 → x (Fin.last k) = 0 → x = 0 := by
      intro x hx hxk
      have hN : (Matrix.of fun i j : Fin k => a (s + 1 + i + j)).mulVec
          (fun j => x (Fin.castSucc j)) = 0 := by
        funext i
        have := congrFun hx i.succ
        simp only [Matrix.mulVec, dotProduct, hM, Matrix.of_apply, Pi.zero_apply] at this ⊢
        rw [Fin.sum_univ_castSucc, hxk, mul_zero, add_zero] at this
        rw [← this]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [Fin.val_succ, Fin.coe_castSucc]
        congr 2
        ring
      by_contra hne
      have hx' : (fun j => x (Fin.castSucc j)) ≠ 0 := by
        intro h0
        apply hne
        funext j
        refine Fin.lastCases ?_ (fun j => ?_) j
        · exact hxk
        · exact congrFun h0 j
      exact h2 (Matrix.exists_mulVec_eq_zero_iff.mp ⟨_, hx', hN⟩)
    obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h1
    have hwk : w (Fin.last k) ≠ 0 := fun h => hw0 (hA w hw h)
    intro hdet
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    set v' : Fin (k + 1) → ℚ := Fin.snoc v 0 with hv'
    have hMv : ∀ i : Fin k, M.mulVec v' (Fin.castSucc i) = 0 := by
      intro i
      have := congrFun hv i
      simp only [Matrix.mulVec, dotProduct, hM, Matrix.of_apply, Pi.zero_apply] at this ⊢
      rw [Fin.sum_univ_castSucc]
      simp only [hv', Fin.snoc_castSucc, Fin.snoc_last, mul_zero, add_zero, Fin.coe_castSucc]
      exact this
    have hsymm : M.transpose = M := by
      ext i j
      simp only [hM, Matrix.transpose_apply, Matrix.of_apply]
      congr 1
      ring
    have hsym : dotProduct w (M.mulVec v') = dotProduct (M.mulVec w) v' := by
      rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hsymm]
    rw [hw, zero_dotProduct] at hsym
    have hlast : M.mulVec v' (Fin.last k) = 0 := by
      rw [dotProduct, Fin.sum_univ_castSucc] at hsym
      simp only [hMv, mul_zero, Finset.sum_const_zero, zero_add, mul_eq_zero] at hsym
      exact hsym.resolve_left hwk
    have h0 : v' = 0 := hA v' (by
      funext i
      refine Fin.lastCases hlast (fun i => hMv i) i) (by simp [hv'])
    apply hv0
    funext j
    have := congrFun h0 (Fin.castSucc j)
    simpa [hv'] using this

  have t_s2 : ∀ (a : ℕ → ℚ) (k T : ℕ),
      (∀ s, T ≤ s → (Matrix.of fun i j : Fin (k + 1) => a (s + i + j)).det = 0) →
      (∀ s, T ≤ s → (Matrix.of fun i j : Fin k => a (s + i + j)).det ≠ 0) →
      ∃ c : Fin k → ℚ, ∀ s, T ≤ s → a (s + k) = ∑ j : Fin k, c j * a (s + j) := by
    intro a k T h1 h2
    have hex : ∀ s, T ≤ s → ∃ c : Fin k → ℚ, ∀ i : Fin (k + 1),
        a (s + i + k) = ∑ j : Fin k, c j * a (s + i + j) := by
      intro s hs
      obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr (h1 s hs)
      have hwk : w (Fin.last k) ≠ 0 := by
        intro hk
        apply h2 s hs
        refine Matrix.exists_mulVec_eq_zero_iff.mp ⟨fun j => w (Fin.castSucc j), ?_, ?_⟩
        · intro h0
          apply hw0
          funext j
          exact Fin.lastCases hk (fun j => congrFun h0 j) j
        · funext i
          have := congrFun hw (Fin.castSucc i)
          simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
            Fin.sum_univ_castSucc, hk, mul_zero, add_zero, Fin.coe_castSucc] at this ⊢
          exact this
      refine ⟨fun j => -w (Fin.castSucc j) / w (Fin.last k), fun i => ?_⟩
      have := congrFun hw i
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
        Fin.sum_univ_castSucc, Fin.coe_castSucc, Fin.val_last] at this
      rw [Finset.sum_congr rfl (fun j _ => show -w (Fin.castSucc j) / w (Fin.last k) * a (s + i + j)
        = a (s + i + j) * w (Fin.castSucc j) * (-1 / w (Fin.last k)) by ring), ← Finset.sum_mul]
      rw [show ∑ j : Fin k, a (s + i + j) * w (Fin.castSucc j) = -(a (s + i + k) * w (Fin.last k)) by
        linarith]
      field_simp
    have huniq : ∀ s, T ≤ s → ∀ c c' : Fin k → ℚ,
        (∀ i : Fin k, a (s + i + k) = ∑ j : Fin k, c j * a (s + i + j)) →
        (∀ i : Fin k, a (s + i + k) = ∑ j : Fin k, c' j * a (s + i + j)) → c = c' := by
      intro s hs c c' hc hc'
      by_contra hne
      apply h2 s hs
      refine Matrix.exists_mulVec_eq_zero_iff.mp ⟨c - c', sub_ne_zero.mpr hne, ?_⟩
      funext i
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.sub_apply, Pi.zero_apply]
      calc ∑ j : Fin k, a (s + i + j) * (c j - c' j)
          = (∑ j : Fin k, c j * a (s + i + j)) - ∑ j : Fin k, c' j * a (s + i + j) := by
            rw [← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl (fun j _ => by ring)
        _ = 0 := by rw [← hc i, ← hc' i, sub_self]
    obtain ⟨c, hc⟩ := hex T le_rfl
    have hall : ∀ n, ∀ i : Fin (k + 1),
        a (T + n + i + k) = ∑ j : Fin k, c j * a (T + n + i + j) := by
      intro n
      induction n with
      | zero => simpa using hc
      | succ n ih =>
        obtain ⟨c', hc'⟩ := hex (T + (n + 1)) (by omega)
        have hcc : c = c' := by
          refine huniq (T + (n + 1)) (by omega) c c' (fun i => ?_) (fun i => hc' (Fin.castSucc i))
          have := ih i.succ
          have e : T + (n + 1) + (i : ℕ) = T + n + ((i : ℕ) + 1) := by omega
          simp only [Fin.val_succ] at this
          rw [e]
          exact this
        rw [hcc]
        exact hc'
    refine ⟨c, fun s hs => ?_⟩
    obtain ⟨n, rfl⟩ : ∃ n, s = T + n := ⟨s - T, by omega⟩
    simpa using hall n 0

  intro a m S hS
  have hp : ∃ k, ∃ T, ∀ s, T ≤ s → (Matrix.of fun i j : Fin (k + 1) => a (s + i + j)).det = 0 :=
    ⟨m, S, hS⟩
  obtain ⟨T, hT⟩ := Nat.find_spec hp
  have hmin : ∀ k' < Nat.find hp,
      ¬ ∃ T, ∀ s, T ≤ s → (Matrix.of fun i j : Fin (k' + 1) => a (s + i + j)).det = 0 :=
    fun k' hk' => Nat.find_min hp hk'
  generalize Nat.find hp = k at hT hmin
  have hnz : ∀ s, T ≤ s → (Matrix.of fun i j : Fin k => a (s + i + j)).det ≠ 0 := by
    cases k with
    | zero => intro s _; simp
    | succ k' =>
      intro s1 hs1 hz
      apply hmin k' (Nat.lt_succ_self k')
      refine ⟨s1, fun s hs => ?_⟩
      induction s, hs using Nat.le_induction with
      | base => exact hz
      | succ s hs ih =>
        by_contra hne
        exact t_s1 a (k' + 1) s (hT s (by omega)) hne ih
  obtain ⟨c, hc⟩ := t_s2 a k T hT hnz
  exact t_s3 a k T c hc

theorem virtual_of_rational_zeta : ∀ (N z : ℕ → ℤ) (P Q : Polynomial ℚ), z 0 = 1 → (∀ k : ℕ, (k : ℤ) * z k = ∑ j ∈ Finset.Icc 1 k, N j * z (k - j)) → Q.coeff 0 = 1 → (Q : PowerSeries ℚ) * PowerSeries.mk (fun k => (z k : ℚ)) = (P : PowerSeries ℚ) → ∃ m : ℂ →₀ ℤ, ∀ n : ℕ, 1 ≤ n → (N n : ℂ) = ∑ α ∈ m.support, (m α : ℂ) * α ^ n :=
by
  intro N z P Q h0 hrec hQ0 hQP

  have s1 : PowerSeries.X * PowerSeries.derivative (PowerSeries.mk (fun k => (z k : ℂ))) =
      PowerSeries.mk (fun n => if n = 0 then 0 else (N n : ℂ)) *
        PowerSeries.mk (fun k => (z k : ℂ)) := by
    ext n
    rcases n with _ | k
    · simp [PowerSeries.coeff_mul]
    · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative, PowerSeries.coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk, Finset.sum_range_succ']
      simp only [PowerSeries.coeff_mk]
      have h := congrArg (Int.cast : ℤ → ℂ) (hrec (k + 1))
      push_cast at h
      rw [show Finset.Icc 1 (k + 1) = Finset.Ico 1 (k + 2) from Finset.val_inj.mp rfl,
        Finset.sum_Ico_eq_sum_range] at h
      simp only [Nat.add_one_ne_zero, if_false]
      rw [mul_comm, h]
      simp only [show k + 2 - 1 = k + 1 by omega, ↓reduceIte, zero_mul, add_zero]
      apply Finset.sum_congr rfl
      intro i _
      rw [show 1 + i = i + 1 by ring]

  have s2 : ∀ n : ℕ, ∀ R : Polynomial ℂ, R.natDegree = n → R.coeff 0 = 1 →
      ∃ S : Multiset ℂ, (R : PowerSeries ℂ) =
        (S.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod := by
    intro n
    induction n with
    | zero =>
      intro R hR hc0
      refine ⟨0, ?_⟩
      rw [Polynomial.eq_C_of_natDegree_eq_zero hR, hc0]
      simp
    | succ n ih =>
      intro R hR hc0
      have hdeg : R.degree ≠ 0 :=
        ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp (by omega))
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_root R hdeg
      have hmul : (Polynomial.X - Polynomial.C r) * (R /ₘ (Polynomial.X - Polynomial.C r)) = R :=
        Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hr
      generalize R /ₘ (Polynomial.X - Polynomial.C r) = R₁ at hmul
      have hc : -r * R₁.coeff 0 = 1 := by
        rw [← hc0, ← hmul, Polynomial.mul_coeff_zero]
        simp
      have hr0 : r ≠ 0 := by
        rintro rfl
        simp at hc
      have hR1ne : R₁ ≠ 0 := by
        rintro rfl
        simp at hc
      have hdeg1 : R₁.natDegree = n := by
        have := Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero r) hR1ne
        rw [hmul, Polynomial.natDegree_X_sub_C] at this
        omega
      obtain ⟨S, hS⟩ := ih (Polynomial.C (-r) * R₁)
        (by rw [Polynomial.natDegree_C_mul (neg_ne_zero.mpr hr0)]; exact hdeg1)
        (by rw [Polynomial.coeff_C_mul]; exact hc)
      refine ⟨r⁻¹ ::ₘ S, ?_⟩
      have hlin : (1 - Polynomial.C r⁻¹ * Polynomial.X) * Polynomial.C (-r) =
          (Polynomial.X - Polynomial.C r : Polynomial ℂ) := by
        have : r⁻¹ * -r = -1 := by field_simp
        calc (1 - Polynomial.C r⁻¹ * Polynomial.X) * Polynomial.C (-r)
            = Polynomial.C (-r) - Polynomial.C (r⁻¹ * -r) * Polynomial.X := by
              rw [Polynomial.C_mul]; ring
          _ = Polynomial.X - Polynomial.C r := by
              rw [this, Polynomial.C_neg, Polynomial.C_neg, Polynomial.C_1]; ring
      have hpoly : R = (1 - Polynomial.C r⁻¹ * Polynomial.X) * (Polynomial.C (-r) * R₁) := by
        rw [← hmul, ← hlin]
        ring
      rw [hpoly, Polynomial.coe_mul, hS, Multiset.map_cons, Multiset.prod_cons]
      simp [Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_C, Polynomial.coe_X]

  have s3 : ∀ S : Multiset ℂ, PowerSeries.X * PowerSeries.derivative
      (S.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod =
      -((S.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod *
        PowerSeries.mk (fun n => if n = 0 then 0 else (S.map (fun s => s ^ n)).sum)) := by
    intro S
    induction S using Multiset.induction_on with
    | empty =>
      have : PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else
          ((0 : Multiset ℂ).map (fun s => s ^ n)).sum) = 0 := by
        ext n
        simp
      rw [this]
      simp
    | cons a S ih =>
      have hT : PowerSeries.mk (fun n => if n = 0 then 0 else
            ((a ::ₘ S).map (fun s => s ^ n)).sum) =
          PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else a ^ n) +
            PowerSeries.mk (fun n => if n = 0 then 0 else (S.map (fun s => s ^ n)).sum) := by
        ext n
        simp only [map_add, PowerSeries.coeff_mk, Multiset.map_cons, Multiset.sum_cons]
        split_ifs <;> simp
      have hG : (1 - PowerSeries.C a * PowerSeries.X) *
          PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else a ^ n) =
          PowerSeries.C a * PowerSeries.X := by
        ext n
        rw [sub_mul, one_mul, map_sub, mul_assoc, PowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul]
        rcases n with _ | n
        · simp
        · rw [PowerSeries.coeff_succ_X_mul]
          rcases n with _ | n
          · simp [PowerSeries.coeff_X]
          · simp [PowerSeries.coeff_X, pow_succ]
            ring
      have hdL : PowerSeries.derivative (1 - PowerSeries.C a * PowerSeries.X) =
          -PowerSeries.C a := by
        rw [map_sub, Derivation.leibniz, PowerSeries.derivative_C, PowerSeries.derivative_X,
          Derivation.map_one_eq_zero]
        simp
      rw [Multiset.map_cons, Multiset.prod_cons, hT, Derivation.leibniz, smul_eq_mul, smul_eq_mul,
        hdL]
      linear_combination (1 - PowerSeries.C a * PowerSeries.X) * ih +
        (S.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod * hG

  have s4 : ∀ A B : Multiset ℂ, ∃ m : ℂ →₀ ℤ, ∀ n : ℕ,
      ∑ α ∈ m.support, (m α : ℂ) * α ^ n =
        (A.map (fun a => a ^ n)).sum - (B.map (fun b => b ^ n)).sum := by
    intro A B
    refine ⟨(A.map (fun a => Finsupp.single a (1 : ℤ))).sum -
      (B.map (fun b => Finsupp.single b (1 : ℤ))).sum, fun n => ?_⟩
    have hL : ∀ m' : ℂ →₀ ℤ, Finsupp.linearCombination ℤ (fun α : ℂ => α ^ n) m' =
        ∑ α ∈ m'.support, (m' α : ℂ) * α ^ n := by
      intro m'
      simp only [Finsupp.linearCombination_apply, Finsupp.sum, zsmul_eq_mul]
    rw [← hL, map_sub, map_multiset_sum, map_multiset_sum, Multiset.map_map, Multiset.map_map]
    congr 1 <;> congr 1 <;> apply Multiset.map_congr rfl <;> intro x _ <;>
      simp [Finsupp.linearCombination_single]

  have hY' : PowerSeries.map (Rat.castHom ℂ) (PowerSeries.mk (fun k => (z k : ℚ))) =
      PowerSeries.mk (fun k => (z k : ℂ)) := by
    ext k
    simp [PowerSeries.coeff_map]
  have hT : ((Q.map (Rat.castHom ℂ) : Polynomial ℂ) : PowerSeries ℂ) *
      PowerSeries.mk (fun k => (z k : ℂ)) = ((P.map (Rat.castHom ℂ) : Polynomial ℂ) : PowerSeries ℂ) := by
    rw [Polynomial.polynomial_map_coe, Polynomial.polynomial_map_coe, ← hY', ← map_mul, hQP]
  have hQc : (Q.map (Rat.castHom ℂ)).coeff 0 = 1 := by
    rw [Polynomial.coeff_map, hQ0, map_one]
  have hPc : (P.map (Rat.castHom ℂ)).coeff 0 = 1 := by
    have := congrArg PowerSeries.constantCoeff hT
    rw [map_mul, Polynomial.constantCoeff_coe, Polynomial.constantCoeff_coe, hQc] at this
    rw [← this]
    simp [h0]

  obtain ⟨A, hA⟩ := s2 _ _ rfl hQc
  obtain ⟨B, hB⟩ := s2 _ _ rfl hPc
  have hPB0 : (B.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod ≠ 0 := by
    intro h
    have := congrArg PowerSeries.constantCoeff hB
    rw [h, Polynomial.constantCoeff_coe, hPc] at this
    simp at this
  rw [hA, hB] at hT

  have hA3 := s3 A
  have hB3 := s3 B
  have hd : PowerSeries.X * PowerSeries.derivative
      (B.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod =
      (B.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod *
        (PowerSeries.mk (fun n => if n = 0 then 0 else (N n : ℂ)) -
          PowerSeries.mk (fun n => if n = 0 then 0 else (A.map (fun s => s ^ n)).sum)) := by
    rw [← hT, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    linear_combination (A.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod * s1 +
      PowerSeries.mk (fun k => (z k : ℂ)) * hA3
  have key : (B.map (fun s => 1 - PowerSeries.C s * PowerSeries.X)).prod *
      (PowerSeries.mk (fun n => if n = 0 then 0 else (N n : ℂ)) -
        PowerSeries.mk (fun n => if n = 0 then 0 else (A.map (fun s => s ^ n)).sum) +
        PowerSeries.mk (fun n => if n = 0 then 0 else (B.map (fun s => s ^ n)).sum)) = 0 := by
    linear_combination hB3 - hd
  have heq := (mul_eq_zero.mp key).resolve_left hPB0

  obtain ⟨m, hm⟩ := s4 A B
  refine ⟨m, fun n hn => ?_⟩
  have hc := congrArg (PowerSeries.coeff n) heq
  have hn0 : n ≠ 0 := by omega
  simp only [map_add, map_sub, PowerSeries.coeff_mk, if_neg hn0, map_zero] at hc
  rw [hm n]
  linear_combination hc

theorem torus_hypersurface_virtual : ∀ (F : Type u) [Field F] [Finite F] (σ : Type) [Fintype σ] (g : MvPolynomial σ F), ∃ m : ℂ →₀ ℤ, ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E], (Nat.card {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℂ) = ∑ α ∈ m.support, (m α : ℂ) * α ^ Module.finrank F E :=
by
  intro F _ _ σ _ g
  classical
  haveI hpF : Fact (ringChar F).Prime := ⟨CharP.char_is_prime F (ringChar F)⟩

  obtain ⟨N, hNb, hN⟩ := torus_count_degree_only F σ g

  have hneck : ∀ n : ℕ, 1 ≤ n →
      (n : ℤ) ∣ ∑ d ∈ n.divisors, (ArithmeticFunction.moebius (n / d) : ℤ) * N d := by
    intro n hn
    obtain ⟨S, hS, f, hf⟩ := torus_count_frobenius_model F σ g N hN n hn
    have h := perm_necklace S f n hn
    rwa [Finset.sum_congr rfl (fun d hd => by rw [hf d hd])] at h

  obtain ⟨z, hz0, hzb, hzrec⟩ :=
    zeta_coeffs_integral N (Nat.card F ^ Fintype.card σ) (fun n _ => hNb n) hneck

  obtain ⟨ζ, D, t, hζp, hζ1, hD0, hDent, hDlog, htr⟩ :=
    dwork_trace_formula_entire F (Option σ)
      (MvPolynomial.X none * MvPolynomial.rename some g) (ringChar F) rfl

  have hhyp : ∀ n : ℕ, 1 ≤ n →
      ((Nat.card F : ℕ) : PadicComplex (ringChar F)) ^ n * (N n : PadicComplex (ringChar F)) =
        (((Nat.card F : ℕ) : PadicComplex (ringChar F)) ^ n - 1) ^ Fintype.card σ +
          t n * (((Nat.card F : ℕ) : PadicComplex (ringChar F)) ^ n - 1) ^ (Fintype.card σ + 1) := by
    intro n hn
    haveI : NeZero n := ⟨by omega⟩
    let E := ULift.{u} (FiniteField.Extension F (ringChar F) n)
    haveI : FiniteDimensional F E := Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
    have hfin : Module.finrank F E = n := by
      rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
      exact FiniteField.finrank_extension F (ringChar F) n
    haveI : Finite E := Module.finite_of_finite F
    have hcard : Nat.card E = Nat.card F ^ n := by
      rw [Module.natCard_eq_pow_finrank (K := F), hfin]
    haveI : CharP F (ringChar F) := ringChar.charP F
    haveI : CharP E (ringChar F) :=
      charP_of_injective_algebraMap (algebraMap F E).injective (ringChar F)
    letI : Algebra (ZMod (ringChar F)) E := ZMod.algebra E (ringChar F)
    have h4 := torus_count_character_sum F σ g (ringChar F) (PadicComplex (ringChar F)) ζ hζp hζ1 E
    have h5 := htr E
    rw [Fintype.card_option, hfin, hcard] at h5
    rw [hcard, ← h5] at h4
    have hNE := hN E
    rw [hfin] at hNE
    have hNE' : ((Nat.card {x : σ → E // (∀ i, x i ≠ 0) ∧ MvPolynomial.aeval x g = 0} : ℕ) :
        PadicComplex (ringChar F)) = (N n : PadicComplex (ringChar F)) := by
      rw [← hNE, Int.cast_natCast]
    rw [hNE'] at h4
    push_cast at h4 ⊢
    exact h4

  obtain ⟨A, B, hA0, hB0, hABent, hABlog⟩ :=
    zeta_quotient_of_entire (ringChar F) (Nat.card F) (Fintype.card σ) N t D
      Nat.card_pos hD0 hDent hDlog hhyp

  have hBY := zeta_identify (PadicComplex (ringChar F)) N z A B hz0 hzrec hA0 hB0 hABlog

  have hP := padic_meromorphic_polynomial_denominator (ringChar F) A B _ hB0 hABent hBY

  obtain ⟨m, S, hH⟩ := borel_hankel_vanishing (ringChar F) z (Nat.card F ^ Fintype.card σ)
    (Nat.one_le_pow _ _ Nat.card_pos) hzb hP

  obtain ⟨P, Q, hQ0, hQP⟩ := kronecker_rational_of_hankel (fun k => (z k : ℚ)) m S hH

  obtain ⟨mC, hmC⟩ := virtual_of_rational_zeta N z P Q hz0 hzrec hQ0 hQP

  refine ⟨mC, fun E _ _ _ => ?_⟩
  have hn : 0 < Module.finrank F E := Module.finrank_pos
  rw [← hmC _ hn, ← hN E, Int.cast_natCast]

theorem affine_count_eq_sum_torus : ∀ (F : Type u) [Field F] (σ : Type) [Fintype σ] [DecidableEq σ] (g : MvPolynomial σ F) (E : Type u) [Field E] [Algebra F E] [Finite E], Nat.card {x : σ → E // MvPolynomial.aeval x g = 0} = ∑ S : Finset σ, Nat.card {y : S → E // (∀ i, y i ≠ 0) ∧ MvPolynomial.aeval y (MvPolynomial.aeval (fun i : σ => if h : i ∈ S then (MvPolynomial.X (⟨i, h⟩ : S) : MvPolynomial S F) else 0) g) = 0} :=
by
  intro F _ σ _ _ g E _ _ _
  classical

  have hsub : ∀ (S : Finset σ) (y : S → E),
      MvPolynomial.aeval y (MvPolynomial.aeval (fun i : σ => if h : i ∈ S then
        (MvPolynomial.X (⟨i, h⟩ : S) : MvPolynomial S F) else 0) g)
        = MvPolynomial.aeval (fun i : σ => if h : i ∈ S then y ⟨i, h⟩ else 0) g := by
    intro S y
    rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
    congr 1
    congr 1
    funext i
    by_cases h : i ∈ S
    · simp [h]
    · simp [h]

  let f : {x : σ → E // MvPolynomial.aeval x g = 0} → Finset σ :=
    fun x => Finset.univ.filter (fun i => x.1 i ≠ 0)
  have hmemS : ∀ (S : Finset σ) (x : {x : σ → E // MvPolynomial.aeval x g = 0}),
      f x = S → ∀ i, i ∈ S ↔ x.1 i ≠ 0 := by
    intro S x hx i
    rw [← hx]
    simp [f]

  have hK : ∀ (S : Finset σ) (x : {x : σ → E // MvPolynomial.aeval x g = 0}), f x = S →
      (fun i : σ => if h : i ∈ S then x.1 i else 0) = x.1 := by
    intro S x hx
    funext i
    by_cases h : i ∈ S
    · simp [h]
    · rw [dif_neg h]
      by_contra hne
      exact h ((hmemS S x hx i).mpr (fun h' => hne h'.symm))
  rw [Nat.card_congr (Equiv.sigmaFiberEquiv f).symm, Nat.card_sigma]
  refine Finset.sum_congr rfl (fun S _ => Nat.card_congr ?_)
  exact
    { toFun := fun x => ⟨fun j => x.1.1 j.1, fun j => (hmemS S x.1 x.2 j.1).mp j.2,
        (hsub S _).trans
          ((congrArg (fun z => MvPolynomial.aeval z g) (hK S x.1 x.2)).trans x.1.2)⟩
      invFun := fun y => ⟨⟨fun i => if h : i ∈ S then y.1 ⟨i, h⟩ else 0,
          (hsub S y.1).symm.trans y.2.2⟩, by
        ext i
        by_cases h : i ∈ S
        · simp [f, h, y.2.1]
        · simp [f, h]⟩
      left_inv := fun x => by
        apply Subtype.ext
        apply Subtype.ext
        exact hK S x.1 x.2
      right_inv := fun y => by
        apply Subtype.ext
        funext j
        simp }

theorem system_count_inclusion_exclusion : ∀ (F : Type u) [Field F] (σ : Type) [Fintype σ] (S : Finset (MvPolynomial σ F)) (E : Type u) [Field E] [Algebra F E] [Finite E], (Nat.card {x : σ → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0} : ℤ) = ∑ J ∈ S.powerset, (-1) ^ J.card * ((Nat.card E : ℤ) ^ Fintype.card σ - Nat.card {x : σ → E // MvPolynomial.aeval x (∏ f ∈ J, f) = 0}) :=
by
  intro F _ σ _ S E _ _ _
  classical
  haveI : Fintype E := Fintype.ofFinite E
  let B : MvPolynomial σ F → Finset (σ → E) :=
    fun g => Finset.univ.filter (fun x => MvPolynomial.aeval x g ≠ 0)
  have hcard : ∀ (P : (σ → E) → Prop), Nat.card {x : σ → E // P x} =
      (Finset.univ.filter P).card := by
    intro P
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  have h2 : Finset.univ.filter (fun x : σ → E => ∀ f ∈ S, MvPolynomial.aeval x f = 0) =
      S.inf (fun f => (B f)ᶜ) := by
    ext x
    simp [B, Finset.mem_inf]
  have h4 : ∀ J : Finset (MvPolynomial σ F), J.inf B = B (∏ f ∈ J, f) := by
    intro J
    ext x
    simp [B, Finset.mem_inf, map_prod, Finset.prod_ne_zero_iff]
  have hu : (Finset.univ : Finset (σ → E)).card = Fintype.card E ^ Fintype.card σ := by
    rw [Finset.card_univ, Fintype.card_fun]
  have h5 : ∀ g : MvPolynomial σ F, ((B g).card : ℤ) = (Nat.card E : ℤ) ^ Fintype.card σ -
      Nat.card {x : σ → E // MvPolynomial.aeval x g = 0} := by
    intro g
    have e := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (σ → E)))
      (fun x => MvPolynomial.aeval x g = 0)
    rw [hu] at e
    have e' : (Finset.univ.filter (fun x : σ → E => MvPolynomial.aeval x g = 0)).card +
        (B g).card = Fintype.card E ^ Fintype.card σ := e
    have e'' := congrArg (Nat.cast : ℕ → ℤ) e'
    push_cast at e''
    rw [hcard, Nat.card_eq_fintype_card (α := E)]
    linarith
  have h2' : Nat.card {x : σ → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0} =
      (S.inf (fun f => (B f)ᶜ)).card := by
    rw [hcard]
    congr 1
    ext x
    simp [B, Finset.mem_inf]
  rw [h2', Finset.inclusion_exclusion_card_inf_compl]
  refine Finset.sum_congr rfl (fun J _ => ?_)
  rw [h4, h5]

theorem card_eq_inclusion_exclusion : ∀ (H : Type u) (k : ℕ) (P : Fin k → H → Prop), (∀ h, ∃ i, P i h) → (∀ i, Finite {h // P i h}) → (Nat.card H : ℤ) = ∑ J ∈ (Finset.univ : Finset (Fin k)).powerset.filter (fun J => J.Nonempty), (-1) ^ (J.card + 1) * (Nat.card {h // ∀ j ∈ J, P j h} : ℤ) :=
by
  intro H k P hcov hfin
  classical
  haveI : Finite H := by
    haveI : ∀ i, Finite {h // P i h} := hfin
    exact Finite.of_surjective (fun x : (Σ i : Fin k, {h // P i h}) => x.2.1)
      (fun h => by obtain ⟨i, hi⟩ := hcov h; exact ⟨⟨i, ⟨h, hi⟩⟩, rfl⟩)
  letI : Fintype H := Fintype.ofFinite H
  have key : ∀ h : H, (1 : ℤ) = ∑ J ∈ (Finset.univ : Finset (Fin k)).powerset.filter
      (fun J => J.Nonempty), (-1) ^ (J.card + 1) * (if ∀ j ∈ J, P j h then (1 : ℤ) else 0) := by
    intro h
    have hI := Finset.indicator_biUnion_eq_sum_powerset (Finset.univ : Finset (Fin k))
      (fun i => {h : H | P i h}) (fun _ => (1 : ℤ)) h
    rw [Set.indicator_of_mem] at hI
    · refine hI.trans (Finset.sum_congr rfl (fun J _ => ?_))
      simp only [smul_eq_mul, Set.indicator_apply, Set.mem_iInter₂, Set.mem_setOf_eq]
    · obtain ⟨i, hi⟩ := hcov h
      exact Set.mem_iUnion₂.mpr ⟨i, Finset.mem_univ i, hi⟩
  calc (Nat.card H : ℤ) = ∑ _h : H, (1 : ℤ) := by simp [Nat.card_eq_fintype_card]
    _ = ∑ h : H, ∑ J ∈ (Finset.univ : Finset (Fin k)).powerset.filter (fun J => J.Nonempty),
        (-1) ^ (J.card + 1) * (if ∀ j ∈ J, P j h then (1 : ℤ) else 0) :=
          Finset.sum_congr rfl (fun h _ => key h)
    _ = ∑ J ∈ (Finset.univ : Finset (Fin k)).powerset.filter (fun J => J.Nonempty),
        ∑ h : H, (-1) ^ (J.card + 1) * (if ∀ j ∈ J, P j h then (1 : ℤ) else 0) := Finset.sum_comm
    _ = _ := by
      refine Finset.sum_congr rfl (fun J _ => ?_)
      rw [← Finset.mul_sum, Finset.sum_boole]
      congr 1
      simp [Nat.card_eq_fintype_card, Fintype.card_subtype]

theorem affine_open_points_equiv_algHom : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F))) [LocallyOfFiniteType X.hom] (V : X.left.Opens), IsAffineOpen V → ∃ (A : Type u) (_ : CommRing A) (_ : Algebra F A), Algebra.FiniteType F A ∧ ∀ (E : Type u) [Field E] [Algebra F E], Nonempty ({f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X // Set.range f.left ⊆ (V : Set X.left)} ≃ (A →ₐ[F] E)) :=
by
  intro F _ X _ V hV
  let φ : CommRingCat.of F ⟶ Γ(X.left, V) :=
    (Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ V le_top
  have hT : IsAffineOpen (⊤ : (Spec (CommRingCat.of F)).Opens) := isAffineOpen_top _
  have s3 : Spec.map φ = hV.fromSpec ≫ X.hom := by
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec X.hom hT hV le_top
    have h2 : hT.fromSpec = Spec.map (Scheme.ΓSpecIso (CommRingCat.of F)).inv := by
      rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
    rw [h2] at h1
    simp only [φ, Spec.map_comp]
    exact h1
  have s4 : φ.hom.FiniteType := by
    show ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ V le_top).hom.FiniteType
    rw [CommRingCat.hom_comp]
    apply RingHom.FiniteType.comp
    · exact HasRingHomProperty.appLE @LocallyOfFiniteType X.hom inferInstance ⟨⊤, hT⟩ ⟨V, hV⟩ le_top
    · apply RingHom.FiniteType.of_surjective
      intro y
      exact ⟨(Scheme.ΓSpecIso (CommRingCat.of F)).hom y, by simp⟩
  haveI := hV.isOpenImmersion_fromSpec
  refine ⟨Γ(X.left, V), inferInstance, φ.hom.toAlgebra, s4, ?_⟩
  intro E _ _
  have e1 : Nonempty ({f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
      Set.range f.left ⊆ (V : Set X.left)} ≃
      {ψ : Γ(X.left, V) ⟶ CommRingCat.of E // φ ≫ ψ = CommRingCat.ofHom (algebraMap F E)}) := by
    refine ⟨{ toFun := fun f => ⟨Spec.preimage (IsOpenImmersion.lift hV.fromSpec f.1.left
                (by rw [hV.range_fromSpec]; exact f.2)), ?_⟩,
              invFun := fun ψ => ⟨Over.homMk (Spec.map ψ.1 ≫ hV.fromSpec) ?_, ?_⟩,
              left_inv := ?_, right_inv := ?_ }⟩
    · apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, s3, ← Category.assoc, IsOpenImmersion.lift_fac]
      exact Over.w f.1
    · rw [Category.assoc, ← s3, ← Spec.map_comp, ψ.2]
      rfl
    · rintro _ ⟨x, rfl⟩
      rw [← hV.range_fromSpec]
      exact ⟨Spec.map ψ.1 x, rfl⟩
    · intro f
      apply Subtype.ext
      apply Over.OverMorphism.ext
      simp only [Over.homMk_left]
      rw [Spec.map_preimage, IsOpenImmersion.lift_fac]
    · intro ψ
      apply Subtype.ext
      apply Spec.map_injective
      rw [Spec.map_preimage]
      exact (IsOpenImmersion.lift_uniq _ _ _ _ rfl).symm
  letI : Algebra F Γ(X.left, V) := φ.hom.toAlgebra
  have e2 : Nonempty ({ψ : Γ(X.left, V) ⟶ CommRingCat.of E //
      φ ≫ ψ = CommRingCat.ofHom (algebraMap F E)} ≃ (Γ(X.left, V) →ₐ[F] E)) := by
    refine ⟨{ toFun := fun ψ => { toRingHom := ψ.1.hom, commutes' := fun c => ?_ },
              invFun := fun g => ⟨CommRingCat.ofHom g.toRingHom, ?_⟩,
              left_inv := fun ψ => Subtype.ext rfl,
              right_inv := fun g => AlgHom.ext fun _ => rfl }⟩
    · have := congrArg (fun h : CommRingCat.of F ⟶ CommRingCat.of E => h.hom c) ψ.2
      exact this
    · ext c
      exact g.commutes c
  exact ⟨e1.some.trans e2.some⟩

theorem algHom_equiv_polynomial_solutions : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A] [Algebra F A], Algebra.FiniteType F A → ∃ (r : ℕ) (S : Finset (MvPolynomial (Fin r) F)), ∀ (E : Type u) [Field E] [Algebra F E], Nonempty ((A →ₐ[F] E) ≃ {x : Fin r → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0}) :=
by
  intro F _ A _ _ hFT
  obtain ⟨r, φ, hsurj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT
  have hfg : (RingHom.ker φ).FG := IsNoetherian.noetherian _
  obtain ⟨S, hS⟩ := hfg
  refine ⟨r, S, ?_⟩
  intro E _ _
  have hK : ∀ g : A →ₐ[F] E,
      g.comp φ = MvPolynomial.aeval (fun i => g (φ (MvPolynomial.X i))) := by
    intro g
    apply MvPolynomial.algHom_ext
    intro i
    simp
  have hSker : ∀ f ∈ S, φ f = 0 := by
    intro f hf
    have hmem : f ∈ RingHom.ker φ := by
      rw [← hS]; exact Submodule.subset_span hf
    exact (RingHom.mem_ker).mp hmem
  have hΦ : ∀ g : A →ₐ[F] E, ∀ f ∈ S,
      MvPolynomial.aeval (fun i => g (φ (MvPolynomial.X i))) f = 0 := by
    intro g f hf
    rw [← hK g, AlgHom.comp_apply, hSker f hf, map_zero]
  have hV : ∀ x : {x : Fin r → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0},
      ∀ a ∈ RingHom.ker φ, MvPolynomial.aeval x.1 a = 0 := by
    intro x a ha
    rw [← hS] at ha
    have hle : Submodule.span (MvPolynomial (Fin r) F) (S : Set (MvPolynomial (Fin r) F)) ≤
        RingHom.ker (MvPolynomial.aeval x.1 : MvPolynomial (Fin r) F →ₐ[F] E) := by
      rw [Submodule.span_le]
      intro f hf
      exact (RingHom.mem_ker).mpr (x.2 f hf)
    exact (RingHom.mem_ker).mp (hle ha)
  let e := Ideal.quotientKerAlgEquivOfSurjective hsurj
  let Ψ : {x : Fin r → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0} → (A →ₐ[F] E) := fun x =>
    (Ideal.Quotient.liftₐ (RingHom.ker φ) (MvPolynomial.aeval x.1) (hV x)).comp
      (e.symm : A →ₐ[F] _)
  have hC : ∀ x p, Ψ x (φ p) = MvPolynomial.aeval x.1 p := by
    intro x p
    simp only [Ψ, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
    rw [Ideal.quotientKerAlgEquivOfSurjective_symm_apply]
    rfl
  refine ⟨{ toFun := fun g => ⟨fun i => g (φ (MvPolynomial.X i)), hΦ g⟩
            invFun := Ψ
            left_inv := ?_
            right_inv := ?_ }⟩
  · intro g
    apply AlgHom.ext
    intro a
    obtain ⟨p, rfl⟩ := hsurj a
    rw [hC]
    show MvPolynomial.aeval (fun i => g (φ (MvPolynomial.X i))) p = g (φ p)
    rw [← hK g, AlgHom.comp_apply]
  · intro x
    apply Subtype.ext
    funext i
    show Ψ x (φ (MvPolynomial.X i)) = x.1 i
    rw [hC, MvPolynomial.aeval_X]

theorem proper_finite_affine_cover : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F))) [IsProper X.hom], ∃ (k : ℕ) (U : Fin k → X.left.Opens), (∀ x : X.left, ∃ i, x ∈ U i) ∧ ∀ J : Finset (Fin k), J.Nonempty → ∃ V : X.left.Opens, IsAffineOpen V ∧ (V : Set X.left) = ⋂ j ∈ J, (U j : Set X.left) :=
by
  classical
  intro F _ X _
  haveI : CompactSpace X.left := QuasiCompact.compactSpace_of_compactSpace X.hom
  have hsep : IsSeparated (Limits.terminal.from X.left) := by
    have e : Limits.terminal.from X.left = X.hom ≫ Limits.terminal.from (Spec (.of F)) :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  haveI : X.left.IsSeparated := Scheme.IsSeparated.mk hsep

  have hW : ∀ x : X.left, ∃ W : X.left.Opens, IsAffineOpen W ∧ x ∈ W := by
    intro x
    obtain ⟨U', hU', hxU', -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (X.left.isBasis_affineOpens))
        (show x ∈ (⊤ : X.left.Opens) from trivial)
    exact ⟨U', hU', hxU'⟩
  choose W hWaff hWmem using hW
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (W x : Set X.left))
    (fun x => (W x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hWmem y⟩)
  let e := t.equivFin
  refine ⟨t.card, fun i => W (e.symm i).1, ?_, ?_⟩
  · intro x
    have hx := ht (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxy
  · intro J hJ
    induction hJ using Finset.Nonempty.cons_induction with
    | singleton a =>
      refine ⟨W (e.symm a).1, hWaff _, ?_⟩
      simp
    | cons a s h hs ih =>
      obtain ⟨V, hV, hVeq⟩ := ih
      refine ⟨W (e.symm a).1 ⊓ V, (hWaff _).inf hV, ?_⟩
      rw [TopologicalSpace.Opens.coe_inf, hVeq, Finset.cons_eq_insert, Finset.set_biInter_insert]

theorem point_count_virtual_eigenvalues (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ m : ℂ →₀ ℤ, (0 : ℂ) ∉ m.support ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℂ) =
        ∑ α ∈ m.support, (m α : ℂ) * α ^ Module.finrank F E :=
by

  let L : ℕ → (ℂ →₀ ℤ) →ₗ[ℤ] ℂ := fun n => Finsupp.linearCombination ℤ (fun α : ℂ => α ^ n)
  have hL : ∀ (n : ℕ) (m : ℂ →₀ ℤ), L n m = ∑ α ∈ m.support, (m α : ℂ) * α ^ n := by
    intro n m
    simp only [L, Finsupp.linearCombination_apply, Finsupp.sum, zsmul_eq_mul]
  have hLs : ∀ (n : ℕ) (β : ℂ) (c : ℤ), L n (Finsupp.single β c) = (c : ℂ) * β ^ n := by
    intro n β c
    simp only [L, Finsupp.linearCombination_single, zsmul_eq_mul]

  have hsys : ∀ (r : ℕ) (S : Finset (MvPolynomial (Fin r) F)), ∃ mS : ℂ →₀ ℤ,
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card {x : Fin r → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0} : ℂ) =
          L (Module.finrank F E) mS := by
    intro r S
    have h3 : ∀ (T : Finset (Fin r)) (g : MvPolynomial T F), ∃ m : ℂ →₀ ℤ,
        ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
          (Nat.card {y : T → E // (∀ i, y i ≠ 0) ∧ MvPolynomial.aeval y g = 0} : ℂ) =
            L (Module.finrank F E) m := by
      intro T g
      obtain ⟨m, hm⟩ := torus_hypersurface_virtual F T g
      exact ⟨m, fun E _ _ _ => by rw [hm E, hL]⟩
    choose mT hmT using h3
    refine ⟨∑ J ∈ S.powerset, ((-1 : ℤ) ^ J.card) •
      (Finsupp.single ((Nat.card F : ℂ) ^ r) 1 - ∑ T : Finset (Fin r),
        mT T (MvPolynomial.aeval (fun i : Fin r => if h : i ∈ T then
          (MvPolynomial.X (⟨i, h⟩ : T) : MvPolynomial T F) else 0) (∏ f ∈ J, f))), ?_⟩
    intro E _ _ _
    haveI : Finite E := Module.finite_of_finite F
    have hcard : Nat.card E = Nat.card F ^ Module.finrank F E := Module.natCard_eq_pow_finrank
    have h5 := congrArg (Int.cast : ℤ → ℂ) (system_count_inclusion_exclusion F (Fin r) S E)
    push_cast at h5
    rw [h5, map_sum]
    refine Finset.sum_congr rfl (fun J _ => ?_)
    have hA : ((Nat.card E : ℂ) ^ Fintype.card (Fin r)) =
        L (Module.finrank F E) (Finsupp.single ((Nat.card F : ℂ) ^ r) 1) := by
      rw [hLs, hcard, Fintype.card_fin]
      push_cast
      rw [← pow_mul, ← pow_mul, mul_comm, one_mul]
    have hB : (Nat.card {x : Fin r → E // MvPolynomial.aeval x (∏ f ∈ J, f) = 0} : ℂ) =
        L (Module.finrank F E) (∑ T : Finset (Fin r),
          mT T (MvPolynomial.aeval (fun i : Fin r => if h : i ∈ T then
            (MvPolynomial.X (⟨i, h⟩ : T) : MvPolynomial T F) else 0) (∏ f ∈ J, f))) := by
      rw [affine_count_eq_sum_torus F (Fin r) (∏ f ∈ J, f) E, map_sum]
      push_cast
      exact Finset.sum_congr rfl (fun T _ => hmT T _ E)
    rw [map_zsmul, map_sub, ← hA, ← hB, zsmul_eq_mul]
    push_cast
    rfl

  obtain ⟨k, U, hcov, hint⟩ := proper_finite_affine_cover F X
  have hJ : ∀ J : Finset (Fin k), ∃ mJ : ℂ →₀ ℤ, J.Nonempty →
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        Finite {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
            ∀ j ∈ J, Set.range f.left ⊆ (U j : Set X.left)} ∧
        (Nat.card {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
            ∀ j ∈ J, Set.range f.left ⊆ (U j : Set X.left)} : ℂ) =
          L (Module.finrank F E) mJ := by
    intro J
    by_cases hne : J.Nonempty
    · obtain ⟨V, hV, hVeq⟩ := hint J hne
      obtain ⟨A, _, _, hft, hA⟩ := affine_open_points_equiv_algHom F X V hV
      obtain ⟨r, S, hS⟩ := algHom_equiv_polynomial_solutions F A hft
      obtain ⟨mS, hmS⟩ := hsys r S
      refine ⟨mS, fun _ E _ _ _ => ?_⟩
      haveI : Finite E := Module.finite_of_finite F
      have e : {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
            ∀ j ∈ J, Set.range f.left ⊆ (U j : Set X.left)} ≃
          {x : Fin r → E // ∀ f ∈ S, MvPolynomial.aeval x f = 0} :=
        (Equiv.subtypeEquivRight (fun f => by rw [hVeq, Set.subset_iInter₂_iff])).trans
          ((hA E).some.trans (hS E).some)
      exact ⟨Finite.of_equiv _ e.symm, by rw [Nat.card_congr e, hmS E]⟩
    · exact ⟨0, fun h => absurd h hne⟩
  choose mJ hmJ using hJ
  obtain ⟨m₁, hm₁⟩ : ∃ m₁ : ℂ →₀ ℤ, m₁ = ∑ J ∈ (Finset.univ : Finset (Fin k)).powerset.filter
      (fun J => J.Nonempty), ((-1 : ℤ) ^ (J.card + 1)) • mJ J := ⟨_, rfl⟩

  refine ⟨m₁.erase 0, ?_, ?_⟩
  · simp [Finsupp.support_erase]
  intro E _ _ _
  rw [← hL]
  have hn : 0 < Module.finrank F E := Module.finrank_pos
  have herase : L (Module.finrank F E) (m₁.erase 0) = L (Module.finrank F E) m₁ := by
    conv_rhs => rw [← Finsupp.single_add_erase 0 m₁]
    rw [map_add, hLs, zero_pow hn.ne', mul_zero, zero_add]
  rw [herase]
  haveI : Finite E := Module.finite_of_finite F
  have hcovE : ∀ f : (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X),
      ∃ i, Set.range f.left ⊆ (U i : Set X.left) := by
    intro f
    obtain ⟨i, hi⟩ := hcov (f.left (default : Spec (CommRingCat.of E)))
    refine ⟨i, ?_⟩
    rintro _ ⟨y, rfl⟩
    have hy : y = (default : Spec (CommRingCat.of E)) :=
      Subsingleton.elim (α := Spec (CommRingCat.of E)) _ _
    rw [hy]
    exact hi
  have hfinE : ∀ i : Fin k, Finite {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
      Set.range f.left ⊆ (U i : Set X.left)} := by
    intro i
    have := (hmJ {i} (Finset.singleton_nonempty i) E).1
    exact Finite.of_equiv _ (Equiv.subtypeEquivRight (fun f =>
      (by simp : (∀ j ∈ ({i} : Finset (Fin k)), Set.range f.left ⊆ (U j : Set X.left)) ↔
        Set.range f.left ⊆ (U i : Set X.left))))
  have h6 := congrArg (Int.cast : ℤ → ℂ) (card_eq_inclusion_exclusion
    (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) k
    (fun i f => Set.range f.left ⊆ (U i : Set X.left)) hcovE hfinE)
  push_cast at h6
  rw [h6, hm₁, map_sum]
  refine Finset.sum_congr rfl (fun J hJ => ?_)
  rw [map_zsmul, zsmul_eq_mul, ← (hmJ J (Finset.mem_filter.mp hJ).2 E).2]
  push_cast
  rfl

theorem matrix_trace_pow_eq_sum_roots_pow {ι : Type} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℂ) (n : ℕ) :
    (A ^ n).trace = (A.charpoly.roots.map (· ^ n)).sum :=
by
  set f : Module.End ℂ (ι → ℂ) := Matrix.toLin' A with hf
  have h1 : (A ^ n).trace = LinearMap.trace ℂ (ι → ℂ) (f ^ n) := by
    rw [← Matrix.trace_toLin'_eq, Matrix.toLin'_pow]
  have h2 : A.charpoly = LinearMap.charpoly f := (Matrix.charpoly_toLin' A).symm
  rw [h1, h2]
  set p := LinearMap.charpoly f with hp

  have s3 : ∀ μ : ℂ, LinearMap.trace ℂ (f.maxGenEigenspace μ)
      ((f ^ n).restrict (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ)) =
      (Module.finrank ℂ (f.maxGenEigenspace μ) : ℂ) * μ ^ n := by
    intro μ
    have hW : Set.MapsTo f (f.maxGenEigenspace μ) (f.maxGenEigenspace μ) :=
      Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl f) μ
    set a : Module.End ℂ (f.maxGenEigenspace μ) := f.restrict hW with ha_def
    set c : Module.End ℂ (f.maxGenEigenspace μ) := algebraMap ℂ _ μ with hc_def
    have ha : (f ^ n).restrict
        (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ) = a ^ n :=
      (Module.End.pow_restrict n hW _).symm
    have hnil : IsNilpotent (a - c) := by
      have := Module.End.isNilpotent_restrict_maxGenEigenspace_sub_algebraMap f μ
      convert this using 1
      ext x
      simp [a, c, LinearMap.coe_restrict_apply, Algebra.algebraMap_eq_smul_one]
      rfl
    have hac : Commute a c := by
      show a * c = c * a
      exact (Algebra.commutes μ a).symm
    have key : ∀ {R : Type} [Ring R] (x y : R), Commute x y → IsNilpotent (x - y) →
        IsNilpotent (x ^ n - y ^ n) := by
      intro R _ x y hxy hn
      have hd : Commute (x - y) x := (Commute.refl x).sub_left hxy.symm
      have hd' : Commute (x - y) y := hxy.sub_left (Commute.refl y)
      have hcomm : Commute (x - y)
          (∑ i ∈ Finset.range n, x ^ i * y ^ (n - 1 - i)) :=
        Commute.sum_right _ _ _ (fun i _ => (hd.pow_right i).mul_right (hd'.pow_right _))
      rw [← hxy.geom_sum₂_mul n]
      exact Commute.isNilpotent_mul_left hcomm.symm hn
    have hnil2 : IsNilpotent (a ^ n - c ^ n) := key a c hac hnil
    have ht : LinearMap.trace ℂ _ (a ^ n - c ^ n) = 0 :=
      (LinearMap.isNilpotent_trace_of_isNilpotent hnil2).eq_zero
    rw [ha]
    have h3 := (LinearMap.trace ℂ (f.maxGenEigenspace μ)).map_sub (a ^ n) (c ^ n)
    have ht' : LinearMap.trace ℂ _ (a ^ n) = LinearMap.trace ℂ _ (c ^ n) :=
      sub_eq_zero.mp (h3.symm.trans ht)
    rw [ht', hc_def, ← map_pow, Algebra.algebraMap_eq_smul_one, map_smul, LinearMap.trace_one,
      smul_eq_mul, mul_comm]

  have hI : DirectSum.IsInternal (fun μ => f.maxGenEigenspace μ) :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
      (Module.End.independent_maxGenEigenspace f) (Module.End.iSup_maxGenEigenspace_eq_top f)
  have hb : ∀ μ, f.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ p.roots.toFinset := by
    intro μ
    rw [Multiset.mem_toFinset, ← Multiset.count_ne_zero, Polynomial.count_roots,
      hp, ← LinearMap.finrank_maxGenEigenspace_eq, ne_eq, ne_eq, Submodule.finrank_eq_zero]
  have hN : {μ | f.maxGenEigenspace μ ≠ ⊥}.Finite := by
    apply (p.roots.toFinset.finite_toSet).subset
    intro μ hμ
    exact (hb μ).1 hμ
  have hmaps := Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n)
  rw [LinearMap.trace_eq_sum_trace_restrict' hI hN hmaps]
  have hfs : hN.toFinset = p.roots.toFinset := by
    ext μ
    rw [Set.Finite.mem_toFinset, ← hb μ]
    rfl
  rw [hfs, Finset.sum_multiset_map_count]
  refine Finset.sum_congr rfl (fun μ _ => ?_)
  rw [s3, LinearMap.finrank_maxGenEigenspace_eq, ← hp, ← Polynomial.count_roots, nsmul_eq_mul]

theorem wc_weaklyEtale_algebraicClosure (F : Type u) [Field F] [Finite F] :
    WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
by
  classical

  have hsep : ∀ s : AlgebraicClosure F, ∃ c : TensorProduct F (AlgebraicClosure F) (AlgebraicClosure F),
      Algebra.TensorProduct.lmul' F c = 1 ∧
        c * (TensorProduct.tmul F (1 : AlgebraicClosure F) s - TensorProduct.tmul F s 1) = 0 := by
    intro s
    haveI : Algebra.IsSeparable F (AlgebraicClosure F) := inferInstance
    haveI : FiniteDimensional F (IntermediateField.adjoin F {s}) :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsSeparable.isIntegral F s)
    haveI : Algebra.IsSeparable F (IntermediateField.adjoin F {s}) :=
      Algebra.isSeparable_tower_bot_of_isSeparable F _ (AlgebraicClosure F)
    haveI : Algebra.FormallyUnramified F (IntermediateField.adjoin F {s}) :=
      Algebra.FormallyUnramified.of_isSeparable F _
    haveI : Algebra.FiniteType F (IntermediateField.adjoin F {s}) := Module.Finite.finiteType _
    haveI : Algebra.EssFiniteType F (IntermediateField.adjoin F {s}) :=
      Algebra.EssFiniteType.of_finiteType F _
    obtain ⟨t, ht1, ht2⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := F)
        (S := IntermediateField.adjoin F {s})).mp inferInstance
    let φ := Algebra.TensorProduct.map (IntermediateField.adjoin F {s}).val
      (IntermediateField.adjoin F {s}).val
    have hμ : ∀ x : TensorProduct F (IntermediateField.adjoin F {s}) (IntermediateField.adjoin F {s}),
        Algebra.TensorProduct.lmul' F (φ x) =
          (IntermediateField.adjoin F {s}).val (Algebra.TensorProduct.lmul' F x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a b => simp [φ]
      | add a b ha hb => simp only [map_add, ha, hb]
    let g : IntermediateField.adjoin F {s} := ⟨s, IntermediateField.mem_adjoin_simple_self F s⟩
    refine ⟨φ t, ?_, ?_⟩
    · rw [hμ, ht2, map_one]
    · have hg : φ (TensorProduct.tmul F 1 g - TensorProduct.tmul F g 1) =
          TensorProduct.tmul F (1 : AlgebraicClosure F) s - TensorProduct.tmul F s 1 := by
        simp [φ, g]
      rw [← hg, ← map_mul, mul_comm, ht1 g, map_zero]

  have hflatμ : RingHom.Flat
      (Algebra.TensorProduct.lmul' F :
        TensorProduct F (AlgebraicClosure F) (AlgebraicClosure F) →ₐ[F] AlgebraicClosure F).toRingHom := by
    let μ := (Algebra.TensorProduct.lmul' F :
        TensorProduct F (AlgebraicClosure F) (AlgebraicClosure F) →ₐ[F] AlgebraicClosure F)
    letI : Algebra (TensorProduct F (AlgebraicClosure F) (AlgebraicClosure F)) (AlgebraicClosure F) :=
      μ.toRingHom.toAlgebra
    let M : Submonoid (TensorProduct F (AlgebraicClosure F) (AlgebraicClosure F)) :=
      Submonoid.comap μ.toRingHom (IsUnit.submonoid (AlgebraicClosure F))
    have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
      rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
    haveI : IsLocalization M (AlgebraicClosure F) := by
      refine ⟨?_, ?_, ?_⟩
      · intro y
        exact (hM y.1).mp y.2
      · intro z
        refine ⟨⟨TensorProduct.tmul F z 1, 1⟩, ?_⟩
        show z * μ 1 = μ (TensorProduct.tmul F z 1)
        rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
      · intro x y hxy
        change μ x = μ y at hxy
        have hker : x - y ∈ Ideal.span (Set.range fun s : AlgebraicClosure F =>
            TensorProduct.tmul F (1 : AlgebraicClosure F) s - TensorProduct.tmul F s 1) := by
          rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
            map_sub]
          exact sub_eq_zero.mpr hxy
        have key : ∀ a ∈ Ideal.span (Set.range fun s : AlgebraicClosure F =>
            TensorProduct.tmul F (1 : AlgebraicClosure F) s - TensorProduct.tmul F s 1),
            ∃ c ∈ M, c * a = 0 := by
          intro a ha
          induction ha using Submodule.span_induction with
          | mem a ha =>
            obtain ⟨s, rfl⟩ := ha
            obtain ⟨c, hc1, hc2⟩ := hsep s
            refine ⟨c, (hM c).mpr ?_, hc2⟩
            show IsUnit (Algebra.TensorProduct.lmul' F c)
            rw [hc1]; exact isUnit_one
          | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
          | add a b _ _ ha hb =>
            obtain ⟨c1, h1, e1⟩ := ha
            obtain ⟨c2, h2, e2⟩ := hb
            exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
          | smul r a _ ha =>
            obtain ⟨c, h, e⟩ := ha
            exact ⟨c, h, by rw [smul_eq_mul, mul_left_comm, e, mul_zero]⟩
        obtain ⟨c, hc, e⟩ := key _ hker
        exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
    exact IsLocalization.flat (AlgebraicClosure F) M
  have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Flat)]
    exact RingHom.flat_algebraMap_iff.mpr inferInstance
  have hd : Flat (Limits.pullback.diagonal
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
    rw [diagonal_SpecMap]
    haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' F :
        TensorProduct F (AlgebraicClosure F) (AlgebraicClosure F) →ₐ[F]
          AlgebraicClosure F).toRingHom)) :=
      HasRingHomProperty.Spec_iff.mpr hflatμ
    infer_instance
  exact ⟨hf, hd⟩

theorem wc_ladic_scalar_ring : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    wcLadicScalar S ℓ 1 = 𝟙 _ ∧
    (∀ a b : ℚ_[ℓ], wcLadicScalar S ℓ (a * b) = wcLadicScalar S ℓ b ≫ wcLadicScalar S ℓ a) ∧
    (∀ a b : ℚ_[ℓ], wcLadicScalar S ℓ (a + b) = wcLadicScalar S ℓ a + wcLadicScalar S ℓ b) :=
by
  intro S ℓ _
  have key : ∀ (c : ℚ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcLadicSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  refine ⟨?_, fun a b => ?_, fun a b => ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    exact one_smul _ _
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    apply ULift.ext
    exact mul_smul _ _ _
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
    apply ULift.ext
    exact add_smul _ _ _

theorem wc_int_scalar_ring : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    wcIntScalar S ℓ 1 = 𝟙 _ ∧
    (∀ a b : ℤ_[ℓ], wcIntScalar S ℓ (a * b) = wcIntScalar S ℓ b ≫ wcIntScalar S ℓ a) ∧
    (∀ a b : ℤ_[ℓ], wcIntScalar S ℓ (a + b) = wcIntScalar S ℓ a + wcIntScalar S ℓ b) ∧
    (∀ a : ℤ_[ℓ], wcIntScalar S ℓ a ≫ wcIntToLadic S ℓ =
      wcIntToLadic S ℓ ≫ wcLadicScalar S ℓ (a : ℚ_[ℓ])) :=
by
  intro S ℓ _
  have key : ∀ (c : ℤ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcIntSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcIntScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have keyQ : ∀ (c : ℚ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcLadicSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have keyT : ∀ (U : (S.ProEt)ᵒᵖ) (x : ((wcIntSheaf S ℓ).obj.obj U : Type (u+1)))
      (p : ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))),
      (ULift.down ((wcIntToLadic S ℓ).hom.app U x) :
          C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ])) p =
        (((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ])) p : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro U x p
    rfl
  refine ⟨?_, fun a b => ?_, fun a b => ?_, fun a => ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    exact one_smul _ _
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    apply ULift.ext
    exact mul_smul _ _ _
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
    apply ULift.ext
    exact add_smul a b
      (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]))
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.FullSubcategory.comp_hom,
      NatTrans.comp_app, NatTrans.comp_app, CategoryTheory.comp_apply, CategoryTheory.comp_apply,
      keyQ]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    rw [keyT, ContinuousMap.smul_apply, keyT, key]
    exact PadicInt.coe_mul _ _

theorem wc_int_scalar_ell_mono : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    Mono (wcIntScalar S ℓ (ℓ : ℤ_[ℓ])) :=
by
  intro S ℓ _
  have hℓ : (ℓ : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero
  haveI : Mono (wcIntScalar S ℓ (ℓ : ℤ_[ℓ])).hom := by
    haveI : ∀ U, Mono ((wcIntScalar S ℓ (ℓ : ℤ_[ℓ])).hom.app U) := by
      intro U
      rw [AddCommGrpCat.mono_iff_injective]
      intro x y hxy
      let f : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) := x.down
      let g : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) := y.down
      have h2 : (ℓ : ℤ_[ℓ]) • f = (ℓ : ℤ_[ℓ]) • g := congrArg ULift.down hxy
      have hfg : f = g := by
        apply ContinuousMap.ext
        intro t
        have h3 := congrArg (fun k => k t) h2
        simp only [ContinuousMap.smul_apply, smul_eq_mul] at h3
        exact mul_left_cancel₀ hℓ h3
      exact ULift.ext _ _ hfg
    exact NatTrans.mono_of_mono_app _
  exact Sheaf.Hom.mono_of_presheaf_mono _ _ _

theorem wc_int_coker_zmod : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (a : ℤ_[ℓ]),
    a = (ℓ : ℤ_[ℓ]) ^ n →
    Nonempty (Limits.cokernel (wcIntScalar S ℓ a) ≅ wcZModSheaf S (ℓ ^ n)) :=
by
  intro S ℓ _ n a ha
  subst ha
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos

  have hρc : Continuous (PadicInt.toZModPow (p := ℓ) n) := by
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro y hy
    refine ⟨(ℓ : ℝ) ^ (-(n : ℤ)), zpow_pos hℓpos _, ?_⟩
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} :=
      (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
    rw [h1, hy]

  have hdiv : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ℤ_[ℓ])),
      (∀ t, PadicInt.toZModPow n (g t) = 0) →
      ∃ c : C(T, ℤ_[ℓ]), ∀ t, g t = (ℓ : ℤ_[ℓ]) ^ n * c t := by
    intro T _ g hg
    have hl : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hb : ∀ t, ‖((g t : ℚ_[ℓ])) / (ℓ : ℚ_[ℓ]) ^ n‖ ≤ 1 := by
      intro t
      have h1 : g t ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} := by
        rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact hg t
      have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr h1
      rw [PadicInt.norm_def] at h2
      rw [norm_div, Padic.norm_p_pow]
      exact (div_le_one (zpow_pos hℓpos _)).mpr h2
    refine ⟨⟨fun t => (⟨(g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ n, hb t⟩ : ℤ_[ℓ]),
      Continuous.subtype_mk ((continuous_subtype_val.comp g.continuous).div_const _) hb⟩, ?_⟩
    intro t
    apply PadicInt.ext
    rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    change (g t : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ n * ((g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ n)
    field_simp

  have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
      (g : G ⟶ H),
      (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
      (∀ U, Function.Surjective (g.hom.app U)) →
      (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
      Nonempty (Limits.cokernel f ≅ H) := by
    intro F G H f g h1 h2 h3
    have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
        (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
      intro X Y U y
      rfl
    have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
        (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
        (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
      intro X Y Z p q U y
      rfl
    have w : f ≫ g = 0 := by
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp, hzero, h1]
    haveI : Epi g := by
      haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
      haveI : Epi g.hom := NatTrans.epi_of_epi_app _
      exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
    have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
        f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
      intro A k hk
      have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
        intro U y
        have := congrArg (fun φ => φ.hom.app U y) hk
        simp only at this
        rw [hcomp, hzero] at this
        exact this
      have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
          k.hom.app U x = k.hom.app U x' := by
        intro U x x' hxx
        obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
        have := hk' U y
        rw [hy, map_sub, sub_eq_zero] at this
        exact this
      let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
      have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
      let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
          intro φ ψ
          rw [← map_add]
          apply hd
          rw [map_add, hσ, hσ, hσ]))
      have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
      let l : H ⟶ A := ObjectProperty.homMk
        { app := lU
          naturality := by
            intro U V r
            ext φ
            rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
              ← NatTrans.naturality_apply]
            apply hd
            rw [hσ, NatTrans.naturality_apply, hσ] }
      refine ⟨l, ?_⟩
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp]
      change lU U (g.hom.app U x) = k.hom.app U x
      rw [hlU]
      apply hd
      rw [hσ]
    exact ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel f)
      (Limits.CokernelCofork.IsColimit.ofπ' g w fac)⟩

  let red : wcIntSheaf S ℓ ⟶ wcZModSheaf S (ℓ ^ n) :=
    (sheafCompose (Scheme.ProEt.topology S) AddCommGrpCat.uliftFunctor.{u+1, u}).map
      (((Scheme.ProEt.forget S ⋙ Over.forget S).sheafPushforwardContinuous Ab
          (Scheme.ProEt.topology S) Scheme.proetaleTopology).map
        (ObjectProperty.homMk
          ({ app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.compLeftContinuous
                (↥(Opposite.unop U)) (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom hρc)
             naturality := fun U V f => by ext g; rfl } :
            continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⟶
              continuousMapPresheafAb.{0, u} (ZMod (ℓ ^ n)))))
  refine crit (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n)) red ?_ ?_ ?_
  · intro U x
    let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) :=
      x.down
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change PadicInt.toZModPow n ((ℓ : ℤ_[ℓ]) ^ n * f0 t) = 0
    rw [map_mul, map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self, zero_mul]
  · intro U φ
    let φ0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
      ZMod (ℓ ^ n)) := φ.down
    let ψ0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) :=
      ⟨fun t => (((φ0 t).val : ℕ) : ℤ_[ℓ]),
        (continuous_of_discreteTopology
          (f := fun b : ZMod (ℓ ^ n) => ((b.val : ℕ) : ℤ_[ℓ]))).comp φ0.continuous⟩
    refine ⟨ULift.up ψ0, ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change PadicInt.toZModPow n (((φ0 t).val : ℕ) : ℤ_[ℓ]) = φ0 t
    rw [map_natCast, ZMod.natCast_zmod_val]
  · intro U x hx
    let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ]) :=
      x.down
    have hx' : ∀ t, PadicInt.toZModPow n (f0 t) = 0 := by
      intro t
      have := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ZMod (ℓ ^ n))) t) hx
      exact this
    obtain ⟨c, hc⟩ := hdiv _ f0 hx'
    refine ⟨ULift.up c, ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change (ℓ : ℤ_[ℓ]) ^ n * c t = f0 t
    rw [hc t]

theorem wc_ext_free_slice_zmod : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ) (i : ℕ),
    Nonempty (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S m) i ≃
      Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) (wcZModSheaf U.left m) i) :=
by

  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e

  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc

  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have wc_leftAdjoint_freeYoneda_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (X : C),
      Nonempty (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf K AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj X
    have rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      intro E _ J' _ Y
      exact
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    have r1 := rep J X
    have r2 := rep K (Φ.obj X)
    let r3 : (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]
          rfl }
    exact ⟨r3.uniqueUpToIso r2⟩

  have wc_slice_ext_adjunction : ∀ (S : Scheme.{u}) (U : S.ProEt)
      [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
      [(wcSliceFunctor S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        (Scheme.ProEt.topology S)]
      [Limits.PreservesFiniteLimits ((wcSliceFunctor S U).op.lan :
        ((U.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}))]
      (X : Sheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1})
      (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (i : ℕ),
      Nonempty (Abelian.Ext (((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)).obj X) Y i ≃
        Abelian.Ext X (((wcSliceFunctor S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)).obj Y) i) := by
    intro S U _ _ _ X Y i
    let G := (wcSliceFunctor S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    let F := (wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    let adj : F ⊣ G := (wcSliceFunctor S U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    let adj2 := (wcSliceFunctor S U).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits F :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits F
    haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits G :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits G
    haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
    haveI : G.Additive := Functor.additive_of_preserves_binary_products G
    haveI : F.Additive := adj.left_adjoint_additive
    exact ⟨(adj.extEquiv (X := X) (Y := Y) (n := i)).toEquiv⟩
  intro S U m i

  have hcov : CoverPreserving (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
      (wcSliceFunctor S U) :=
    CoverPreserving.mk (fun {V} {R} hR =>
      (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V)
        (Sieve.functorPushforward (wcSliceFunctor S U) R)).2
        ((Sieve.functorPushforward_comp (wcSliceFunctor S U)
          (Scheme.ProEt.forget S ⋙ Over.forget S) R) ▸ (wc_proet_mem_topology_iff U.left V R).1 hR))
  haveI hcont : (wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S) :=
    Functor.isContinuous_of_coverPreserving (wc_slice_compatiblePreserving S U) hcov
  haveI hcocont : (wcSliceFunctor S U).IsCocontinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S) :=
    Functor.IsCocontinuous.mk (fun {V} {T} hT => by
      have h1 := (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V) T).1 hT
      rw [← wc_slice_pushforward_functorPullback S U V T] at h1
      exact (wc_proet_mem_topology_iff U.left V _).2 h1)

  haveI hlan : Limits.PreservesFiniteLimits ((wcSliceFunctor S U).op.lan :
      ((U.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (wcSliceFunctor S U).op
      (fun Y => wc_lan_eval_iso (wcSliceFunctor S U).op Y)
      (fun Y => wc_slice_costructuredArrow_final S U Y.unop)

  obtain ⟨E₁⟩ := wc_slice_ext_adjunction S U (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
    (wcZModSheaf S m) i
  obtain ⟨e⟩ := wc_leftAdjoint_freeYoneda_iso (Scheme.ProEt.topology U.left)
    (Scheme.ProEt.topology S) (wcSliceFunctor S U)
    ((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S))
    ((wcSliceFunctor S U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S))
    (Scheme.ProEt.mk (𝟙 U.left))
  let e' : ((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S)).obj (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ≅
      wcFreeSheaf S U := e
  let E₀ : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S m) i ≃
      Abelian.Ext (((wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)).obj
          (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))) (wcZModSheaf S m) i :=
    { toFun := fun x => (Abelian.Ext.mk₀ e'.hom).comp x (zero_add i)
      invFun := fun y => (Abelian.Ext.mk₀ e'.inv).comp y (zero_add i)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
  exact ⟨E₀.trans E₁⟩

theorem wc_free_terminal_const : ∀ (Y : Scheme.{u}), Nonempty (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) ≅ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) :=
by
  intro Y
  have huniq : ∀ (V : Y.ProEt) (f g : V ⟶ Scheme.ProEt.mk (𝟙 Y)), f = g := by
    intro V f g
    apply MorphismProperty.Over.Hom.ext
    have hf : f.left ≫ 𝟙 Y = V.hom := MorphismProperty.Over.w f
    have hg : g.left ≫ 𝟙 Y = V.hom := MorphismProperty.Over.w g
    exact (Category.comp_id f.left).symm.trans (hf.trans (hg.symm.trans (Category.comp_id g.left)))
  have hU : ∀ V : Y.ProEt, Unique (V ⟶ Scheme.ProEt.mk (𝟙 Y)) := fun V =>
    { default := MorphismProperty.Over.homMk V.hom
      uniq := fun f => huniq V f _ }
  let e : ∀ V : Y.ProEtᵒᵖ,
      FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ Scheme.ProEt.mk (𝟙 Y))) ≃+ ULift.{u+1} ℤ :=
    fun V => by
      letI := hU V.unop
      exact (FreeAbelianGroup.uniqueEquiv _).trans AddEquiv.ulift.symm
  have he : ∀ (V : Y.ProEtᵒᵖ) (t : ULift.{u+1} (V.unop ⟶ Scheme.ProEt.mk (𝟙 Y))),
      e V (FreeAbelianGroup.of t) = ULift.up 1 := by
    intro V t
    simp [e, FreeAbelianGroup.uniqueEquiv, AddEquiv.ulift] <;> rfl
  let η : (yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
      (Functor.const Y.ProEtᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) :=
    NatIso.ofComponents (fun V => (e V).toAddCommGrpIso) (by
      intro V W f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro t
      change e W (FreeAbelianGroup.map
          (fun x : ULift.{u+1} (V.unop ⟶ Scheme.ProEt.mk (𝟙 Y)) =>
            (ULift.up (f.unop ≫ x.down) : ULift.{u+1} (W.unop ⟶ Scheme.ProEt.mk (𝟙 Y))))
          (FreeAbelianGroup.of t)) = e V (FreeAbelianGroup.of t)
      exact (congrArg (e W) (FreeAbelianGroup.map_of_apply _)).trans
        ((he W _).trans (he V t).symm))
  exact ⟨(presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).mapIso η⟩

theorem wc_zmod_sheaf_const : ∀ (Y : Scheme.{u}) (m : ℕ), Nonempty (wcZModSheaf Y m ≅ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
by
  intro Y m

  let c : (Functor.const Y.ProEtᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶
      (wcZModSheaf Y m).obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk'
          (fun a : ULift.{u+1} (ZMod m) =>
            (ULift.up (ContinuousMap.const _ a.down) :
              ULift.{u+1} C(↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj (Opposite.unop U)),
                ZMod m)))
          (fun a b => rfl))
      naturality := fun U V f => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        apply ULift.ext
        apply ContinuousMap.ext
        intro t
        rfl }

  have hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology Y) c := by
    refine ⟨fun {X} x y hxy => ?_⟩
    rcases isEmpty_or_nonempty (X.unop.left) with hE | ⟨⟨p⟩⟩
    · exact (Scheme.ProEt.topology Y).superset_covering bot_le
        (Scheme.ProEt.bot_mem_topology X.unop)
    · change (ULift.up (ContinuousMap.const _ x.down) : ULift.{u+1} C(↥X.unop.left, ZMod m)) =
          ULift.up (ContinuousMap.const _ y.down) at hxy
      have h1 := congrArg (fun z : ULift.{u+1} C(↥X.unop.left, ZMod m) => z.down p) hxy
      have hxy' : x = y := by
        apply ULift.ext
        exact h1
      subst hxy'
      refine (Scheme.ProEt.topology Y).superset_covering ?_ ((Scheme.ProEt.topology Y).top_mem _)
      intro V f _
      rw [Presheaf.equalizerSieve_apply]

  have hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) c := by
    refine ⟨fun {U} s => ?_⟩
    let s' : C(↥U.left, ZMod m) := ULift.down s
    let O : ZMod m → U.left.Opens := fun a =>
      ⟨s' ⁻¹' {a}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
    haveI := U.prop
    let W : ULift.{u+1} (ZMod m) → Y.ProEt := fun i => Scheme.ProEt.mk ((O i.down).ι ≫ U.hom)
    let f : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (O i.down).ι rfl trivial
    have hcov : ∀ x : ↥U.left, ∃ (i : ULift.{u+1} (ZMod m)) (y : ↥(O i.down).toScheme),
        (O i.down).ι y = x := fun x =>
      ⟨ULift.up (s' x), ⟨x, rfl⟩, Scheme.Opens.ι_apply _ _⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) U.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} (ZMod m))
        (fun i => (O i.down).toScheme) (fun i => (O i.down).ι) hcov (fun i => inferInstance)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun i => (Scheme.Hom.isOpenEmbedding (O i.down).ι).isOpenMap)
    have hR : Presieve.ofArrows (fun i : ULift.{u+1} (ZMod m) => (O i.down).toScheme)
        (fun i => (O i.down).ι) ∈ Scheme.proetalePrecoverage.coverings U.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) (Y := W) f
    have hR' : Presieve.ofArrows W f ∈ (Scheme.ProEt.precoverage Y).coverings U :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR)
    have hRJ : Sieve.generate (Presieve.ofArrows W f) ∈ (Scheme.ProEt.topology Y) U :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine (Scheme.ProEt.topology Y).superset_covering ?_ hRJ
    rintro V g ⟨W', h, f', hf', rfl⟩
    rcases hf' with ⟨i⟩
    rw [Presheaf.imageSieve_apply]
    refine ⟨ULift.up i.down, ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro v
    let y : ↥(O i.down) := (h.left : V.left ⟶ (O i.down).toScheme) v
    change i.down = s' ((O i.down).ι y)
    have h2 := Scheme.Opens.ι_apply (O i.down) y
    have hm : s' y.1 = i.down := y.2
    rw [h2]
    exact hm.symm

  haveI := hinj
  haveI := hsurj
  haveI : IsIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map c) :=
    (GrothendieckTopology.W_iff (Scheme.ProEt.topology Y) c).mp
      (GrothendieckTopology.W_of_isLocallyBijective (Scheme.ProEt.topology Y) c)
  exact ⟨((asIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map c)) ≪≫
    (sheafificationIso (wcZModSheaf Y m)).symm).symm⟩

theorem wc_etToProEt_flat_cont : ∀ (Y : Scheme.{u}), Limits.PreservesFiniteLimits (wcEtToProEt Y) ∧ (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) :=
by
  intro Y
  haveI h1 : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
      (Scheme.ProEt.forget Y)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
      (wcEtToProEt Y) := by
    refine ⟨fun {V} {R} hR => ?_⟩
    obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
    have hP : Presieve.map (wcEtToProEt Y) (@Scheme.Cover.toPresieveOverProp _ _ _ _ _ 𝒰 h₁ h) ∈
        (Scheme.ProEt.precoverage Y).coverings ((wcEtToProEt Y).obj V) :=
      Precoverage.mem_comap_iff.2
        ((congrArg (· ∈ Scheme.proetalePrecoverage.coverings V.left)
            ((congrArg (Presieve.map (Scheme.ProEt.forget Y ⋙ Over.forget Y))
              (Presieve.map_ofArrows (F := wcEtToProEt Y) _)).trans
              (Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) _))).mpr
          (Scheme.etalePrecoverage_le_proetalePrecoverage _ 𝒰.mem₀))
    have hgen := Precoverage.generate_mem_toGrothendieck hP
    refine GrothendieckTopology.superset_covering _ ?_ hgen
    rw [Sieve.generate_le_iff]
    intro W f hf
    cases hf with
    | of hg => exact ⟨_, _, 𝟙 _, (by apply hle; exact hg), (Category.id_comp _).symm⟩
  haveI := flat_of_preservesFiniteLimits (wcEtToProEt Y)
  exact ⟨h1, Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat (Scheme.ProEt.topology Y) (wcEtToProEt Y)) hcov⟩

theorem wc_lan_preservesFiniteLimits : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] [Limits.HasFiniteLimits C] (G : C ⥤ D) [Limits.PreservesFiniteLimits G], Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
by
  intro C D _ _ _ G _
  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  constructor
  intro J _ _
  apply Limits.preservesLimitsOfShape_of_evaluation
  intro Y
  obtain ⟨θ⟩ := wc_lan_eval_iso G.op Y
  haveI := (flat_of_preservesFiniteLimits G).cofiltered Y.unop
  haveI : IsFiltered (CostructuredArrow G.op Y) :=
    IsFiltered.of_equivalence (structuredArrowOpEquivalence G Y.unop)
  haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow G.op Y)) :=
    IsFiltered.of_equivalence (ULiftHom.equiv (C := CostructuredArrow G.op Y))
  haveI : HasExactColimitsOfShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
      AddCommGrpCat.{u+1} := AB5OfSize.ofShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
  haveI : HasExactColimitsOfShape (CostructuredArrow G.op Y) AddCommGrpCat.{u+1} :=
    @HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _
      (ULiftHom.{u+1} (CostructuredArrow G.op Y)) (CostructuredArrow G.op Y) _ _
      (ULiftHom.equiv (C := CostructuredArrow G.op Y)).symm _ _
  exact Limits.preservesLimitsOfShape_of_natIso θ.symm

theorem wc_epsInv_const : ∀ (Y : Scheme.{u}) [(wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)] (B : AddCommGrpCat.{u+1}), Nonempty ((wcEpsInv Y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B) ≅ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj B) :=
by
  intro Y _ B
  have hTet : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTpro : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  let adj1 := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hTet
  let adj2 := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  let ρ : (wcEtToProEt Y).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) ⋙
      (sheafSections (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (Opposite.op (Scheme.Etale.mk (𝟙 Y))) ≅
      (sheafSections (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj
        (Opposite.op (Scheme.ProEt.mk (𝟙 Y))) := Iso.refl _
  let adj3 := (adj1.comp adj2).ofNatIsoRight ρ
  let adj4 := constantSheafAdj (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} hTpro
  exact ⟨(adj3.leftAdjointUniq adj4).app B⟩

theorem wc_proet_cover_surj_quotient : ∀ (Y : Scheme.{u}) (T : Y.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology Y T → (∀ τ : T.left, ∃ (W : Y.ProEt) (f : W ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left) ∧ (∀ O : Set T.left, (∀ (W : Y.ProEt) (f : W ⟶ T), R.arrows f → IsOpen (f.left ⁻¹' O)) → IsOpen O) :=
by
  have subm : ∀ (U : Scheme.{u}) (n : ℕ) (A : Fin n → Scheme.{u}) (h : ∀ i, A i ⟶ U),
      IsAffine U → (∀ i, IsAffine (A i)) → (∀ i, Flat (h i)) →
      (∀ u : U, ∃ i, u ∈ Set.range (h i)) → ∀ O : Set U, (∀ i, IsOpen ((h i) ⁻¹' O)) → IsOpen O := by
    intro U n A h hU hA hfl hsurj O hO
    let A' : ULift.{u} (Fin n) → Scheme.{u} := fun k => A k.down
    let h' : ∀ k, A' k ⟶ U := fun k => h k.down
    haveI : ∀ k, IsAffine (A' k) := fun k => hA k.down
    haveI : ∀ k, Flat (h' k) := fun k => hfl k.down
    have hι : ∀ k (x : A' k), (Limits.Sigma.desc h') ((Limits.Sigma.ι A' k) x) = h' k x := by
      intro k x
      rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
    haveI : Surjective (Limits.Sigma.desc h') := ⟨fun y => by
      obtain ⟨i, a, ha⟩ := hsurj y
      exact ⟨Limits.Sigma.ι A' ⟨i⟩ a, by rw [hι]; exact ha⟩⟩
    haveI : QuasiCompact (Limits.Sigma.desc h') := quasiCompact_of_compactSpace _
    have hq := Flat.isQuotientMap_of_surjective (Limits.Sigma.desc h')
    rw [← hq.isCoinducing.isOpen_preimage, ← (sigmaMk A').isOpen_preimage, isOpen_sigma_iff]
    intro k
    convert hO k.down using 1
    ext x
    simp only [Set.mem_preimage, sigmaMk_mk, hι]
    rfl
  intro Y T R hR
  have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
      (Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget Y) R)).arrows g →
      ∃ (W : Y.ProEt) (f : W ⟶ T) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
    intro Z g hg
    have hg' := (Sieve.overEquiv_iff _ g).mp hg
    obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
    refine ⟨W, φ, ψ.left, hφ, ?_⟩
    have := congrArg CommaMorphism.left heq
    simp only [Over.homMk_left, Over.comp_left] at this
    exact this
  have hS : Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
      (Sieve.functorPushforward (Scheme.ProEt.forget Y) R) ∈ Scheme.proetaleTopology T.left :=
    (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
      (Scheme.ProEt.forget Y) (Scheme.ProEt.topology Y) (Scheme.proetaleTopology.over Y)).cover_preserve hR)
  obtain ⟨R', hR', hle⟩ :=
    (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition (J := Scheme.proetalePrecoverage)).mp hS
  obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
  haveI := h𝒰
  have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
      (Sieve.functorPushforward (Scheme.ProEt.forget Y) R)).arrows (𝒰.f j) := by
    intro j
    apply hle
    rw [hR'eq]
    exact Presieve.ofArrows.mk j
  choose W f e hf he using fun j => fact (𝒰.f j) (hmem j)
  refine ⟨fun τ => ?_, fun O hO => ?_⟩
  · obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hτ' : τ ∈ (U : Set T.left) := hτU
    rw [← hUeq] at hτ'
    obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
    refine ⟨W (c i), f (c i), hf _, e (c i) z, ?_⟩
    rw [← hzτ, he (c i), Scheme.Hom.comp_apply]
  · rw [isOpen_iff_forall_mem_open]
    intro τ hτ
    obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hle' : ∀ i, V i ≤ 𝒰.f (c i) ⁻¹ᵁ U := by
      intro i z hz
      show 𝒰.f (c i) z ∈ (U : Set T.left)
      rw [← hUeq]
      exact Set.mem_iUnion_of_mem i ⟨z, hz, rfl⟩
    let h : ∀ i, (V i).toScheme ⟶ U.toScheme := fun i => (𝒰.f (c i)).resLE U (V i) (hle' i)
    have hflat : ∀ i, Flat (h i) := fun i => by
      haveI := Scheme.Cover.map_prop 𝒰 (c i)
      infer_instance
    have hcomp : ∀ i, h i ≫ U.ι = (V i).ι ≫ 𝒰.f (c i) := fun i => Scheme.Hom.resLE_comp_ι _ _
    have hsurj : ∀ y : U.toScheme, ∃ i, y ∈ Set.range (h i) := by
      intro y
      have hy : U.ι y ∈ (U : Set T.left) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
      rw [← hUeq] at hy
      obtain ⟨i, z, hz, hzy⟩ := Set.mem_iUnion.mp hy
      refine ⟨i, ⟨z, hz⟩, U.ι.isOpenEmbedding.isEmbedding.injective ?_⟩
      show (h i ≫ U.ι) ⟨z, hz⟩ = U.ι y
      rw [hcomp]
      exact hzy
    have hO' : IsOpen (U.ι ⁻¹' O) := by
      refine subm U.toScheme n (fun i => (V i).toScheme) h hUa (fun i => hV i) hflat hsurj _ ?_
      intro i
      have : (h i) ⁻¹' (U.ι ⁻¹' O) = ((V i).ι ≫ e (c i)) ⁻¹' ((f (c i)).left ⁻¹' O) := by
        ext x
        show (h i ≫ U.ι) x ∈ O ↔ ((V i).ι ≫ e (c i) ≫ (f (c i)).left) x ∈ O
        rw [hcomp, he (c i)]
      rw [this]
      exact IsOpen.preimage (Scheme.Hom.continuous _) (hO _ _ (hf _))
    refine ⟨U.ι '' (U.ι ⁻¹' O), Set.image_preimage_subset _ _,
      U.ι.isOpenEmbedding.isOpenMap _ hO', ?_⟩
    rw [Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι]
    exact ⟨hτ, hτU⟩

theorem wc_lan_etale_rep : ∀ (Y : Scheme.{u}) (F : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}) (T : Y.ProEt), (∀ (V : Y.Etale) (h : T ⟶ (wcEtToProEt Y).obj V) (x : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op T)), ∃ (V₁ : Y.Etale) (b : V₁ ⟶ V) (a : T ⟶ (wcEtToProEt Y).obj V₁) (t : F.obj (Opposite.op V₁)), a ≫ (wcEtToProEt Y).map b = h ∧ x = ((wcEtToProEt Y).op.lan.obj F).map a.op (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V₁) t)) ∧ (∀ (V₁ : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V₁) (t : F.obj (Opposite.op V₁)), ((wcEtToProEt Y).op.lan.obj F).map a.op (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V₁) t) = 0 → ∃ (V₂ : Y.Etale) (c : V₂ ⟶ V₁) (a' : T ⟶ (wcEtToProEt Y).obj V₂), a' ≫ (wcEtToProEt Y).map c = a ∧ F.map c.op t = 0) :=
by
  intro Y F T
  haveI : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
      (Scheme.ProEt.forget Y)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
  haveI : RepresentablyFlat (wcEtToProEt Y) := flat_of_preservesFiniteLimits _
  haveI : IsCofiltered (StructuredArrow T (wcEtToProEt Y)) := RepresentablyFlat.cofiltered T
  haveI hI : IsFiltered (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T)) :=
    IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtToProEt Y) T)
  haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))) :=
    IsFiltered.of_equivalence ULiftHom.equiv
  haveI := Limits.preservesColimitsOfShape_of_equiv
    (ULiftHom.equiv (C := CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))).symm
    (forget AddCommGrpCat.{u+1})
  let E := Functor.LeftExtension.mk ((wcEtToProEt Y).op.leftKanExtension F)
    ((wcEtToProEt Y).op.leftKanExtensionUnit F)
  have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
    (wcEtToProEt Y).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op T)
  have hleg : ∀ (V : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V) (t : F.obj (Opposite.op V)),
      (E.coconeAt (Opposite.op T)).ι.app (CostructuredArrow.mk (Y := Opposite.op V) a.op) t =
      ((wcEtToProEt Y).op.lan.obj F).map a.op
        (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V) t) := by
    intro V a t
    rfl
  refine ⟨fun V h x => ?_, fun V₁ a t ht => ?_⟩
  · obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hc x
    let k : CostructuredArrow (wcEtToProEt Y).op (Opposite.op T) :=
      CostructuredArrow.mk (Y := Opposite.op V) h.op
    let m := IsFiltered.max j k
    let f₁ := IsFiltered.leftToMax j k
    let f₂ := IsFiltered.rightToMax j k
    have hw : (wcEtToProEt Y).op.map f₂.left ≫ m.hom = h.op := CostructuredArrow.w f₂
    refine ⟨m.left.unop, f₂.left.unop, m.hom.unop, F.map f₁.left y, ?_, ?_⟩
    · apply Quiver.Hom.op_inj
      rw [op_comp]
      exact hw
    · have hcw := Limits.Cocone.w (E.coconeAt (Opposite.op T)) f₁
      have h2 : (E.coconeAt (Opposite.op T)).ι.app m (F.map f₁.left y) =
          (E.coconeAt (Opposite.op T)).ι.app j y := by
        rw [← hcw]
        rfl
      rw [← hy, ← h2]
      rfl
  · let j : CostructuredArrow (wcEtToProEt Y).op (Opposite.op T) :=
      CostructuredArrow.mk (Y := Opposite.op V₁) a.op
    let t' : ToType ((CostructuredArrow.proj (wcEtToProEt Y).op (Opposite.op T) ⋙ F).obj j) := t
    have h0 : (E.coconeAt (Opposite.op T)).ι.app j t' = (E.coconeAt (Opposite.op T)).ι.app j 0 := by
      rw [map_zero]
      exact (hleg V₁ a t).trans ht
    obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
    have hw : (wcEtToProEt Y).op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
    refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
    · apply Quiver.Hom.op_inj
      rw [op_comp]
      exact hw
    · have : F.map f.left t = 0 := by
        refine hfg.trans ?_
        exact map_zero _
      exact this

theorem wc_etale_open_subobject : ∀ (Y : Scheme.{u}) (V : Y.Etale) (E : Set V.left), IsOpen E → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), Set.range c.left = E ∧ (∀ (T : Y.ProEt) (ψ : T ⟶ (wcEtToProEt Y).obj V), Set.range ψ.left ⊆ E → ∃ ψ' : T ⟶ (wcEtToProEt Y).obj V₁, ψ' ≫ (wcEtToProEt Y).map c = ψ) ∧ (∀ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V), Set.range c₂.left ⊆ E → ∃ c' : V₂ ⟶ V₁, c' ≫ c = c₂) :=
by
  intro Y V E hE
  obtain ⟨U, hUE⟩ : ∃ U : V.left.Opens, (U : Set V.left) = E := ⟨⟨E, hE⟩, rfl⟩
  haveI := V.prop
  have hr : Set.range (Scheme.Opens.ι U) = E := by rw [Scheme.Opens.range_ι, hUE]
  refine ⟨Scheme.Etale.mk (Scheme.Opens.ι U ≫ V.hom),
    MorphismProperty.Over.homMk (Scheme.Opens.ι U) rfl trivial, hr, ?_, ?_⟩
  · intro T ψ hψ
    let g : T.left ⟶ V.left := ψ.left
    have H : Set.range g ⊆ Set.range (Scheme.Opens.ι U) := by rw [hr]; exact hψ
    obtain ⟨l, hfac⟩ : ∃ l : T.left ⟶ (U : Scheme.{u}), l ≫ Scheme.Opens.ι U = g :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H⟩
    have hw : g ≫ V.hom = T.hom := MorphismProperty.Over.w ψ
    have htri : l ≫ Scheme.Opens.ι U ≫ V.hom = T.hom := by rw [← Category.assoc, hfac, hw]
    refine ⟨MorphismProperty.Over.homMk l htri trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact hfac
  · intro V₂ c₂ hc₂
    let g : V₂.left ⟶ V.left := c₂.left
    have H : Set.range g ⊆ Set.range (Scheme.Opens.ι U) := by rw [hr]; exact hc₂
    obtain ⟨l, hfac⟩ : ∃ l : V₂.left ⟶ (U : Scheme.{u}), l ≫ Scheme.Opens.ι U = g :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H⟩
    have hw : g ≫ V.hom = V₂.hom := MorphismProperty.Over.w c₂
    have htri : l ≫ Scheme.Opens.ι U ≫ V.hom = V₂.hom := by rw [← Category.assoc, hfac, hw]
    refine ⟨MorphismProperty.Over.homMk l htri trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact hfac

theorem wc_etale_section_vanishing_open : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (g : G.obj.obj (Opposite.op V)), IsOpen {v : V.left | ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ G.obj.map c.op g = 0} ∧ ∀ (V₁ : Y.Etale) (c : V₁ ⟶ V), Set.range c.left ⊆ {v : V.left | ∃ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V), v ∈ Set.range c₂.left ∧ G.obj.map c₂.op g = 0} → G.obj.map c.op g = 0 :=
by
  intro Y G V g

  have hEtHom : ∀ {A B : Y.Etale} (c : A ⟶ B), Etale c.left := by
    intro A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom
  refine ⟨?_, ?_⟩
  · rw [isOpen_iff_forall_mem_open]
    rintro v ⟨V₁, c, hv, hc⟩
    haveI := hEtHom c
    exact ⟨Set.range c.left, fun w hw => ⟨V₁, c, hw, hc⟩, c.left.isOpenMap.isOpen_range, hv⟩
  · intro V₁ c hsub
    let S : Sieve V₁ :=
      { arrows := fun D d => G.obj.map d.op (G.obj.map c.op g) = 0
        downward_closed := by
          intro D D' d hd e
          change G.obj.map (e ≫ d).op (G.obj.map c.op g) = 0
          rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
          rw [hd, map_zero] }
    have hS : S ∈ Scheme.smallEtaleTopology Y V₁ := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V₁
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro p
      obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨p, rfl⟩
      haveI : Etale c₂.left := hEtHom c₂
      haveI : Etale V₁.hom := V₁.prop
      let fst := Limits.pullback.fst c.left c₂.left
      let snd := Limits.pullback.snd c.left c₂.left
      haveI hfst : Etale fst := inferInstance
      let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
      have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
      let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
      have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback p q₀ hq₀.symm
      have hπ₁ : S.arrows π₁ := by
        change G.obj.map π₁.op (G.obj.map c.op g) = 0
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
          Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
      exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
    have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj G).2
    exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
      change G.obj.map d.op (G.obj.map c.op g) = G.obj.map d.op 0
      rw [map_zero]
      exact hd)

theorem wc_lan_etale_zero_locus : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (T : Y.ProEt) (y : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op T)), ∃ O : Set T.left, IsOpen O ∧ ∀ (W : Y.ProEt) (k : W ⟶ T), (((wcEtToProEt Y).op.lan.obj G.obj).map k.op y = 0 ↔ Set.range k.left ⊆ O) :=
by
  intro Y G T y

  obtain ⟨V₁, -, a, t, -, hy⟩ := (wc_lan_etale_rep Y G.obj T).1
    (MorphismProperty.Over.mk ⊤ (𝟙 Y) (inferInstance : Etale (𝟙 Y)))
    (MorphismProperty.Over.homMk T.hom (Category.comp_id T.hom) trivial) y

  obtain ⟨hE, hEvan⟩ := wc_etale_section_vanishing_open Y G V₁ t
  refine ⟨a.left ⁻¹' _, hE.preimage a.left.continuous, fun W k => ?_⟩

  have hN : ∀ {A B : Y.Etale} (c : A ⟶ B) (z : G.obj.obj (Opposite.op B)),
      ((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op A) (G.obj.map c.op z) =
        ((wcEtToProEt Y).op.lan.obj G.obj).map ((wcEtToProEt Y).map c).op
          (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op B) z) :=
    fun c z => NatTrans.naturality_apply ((wcEtToProEt Y).op.lanUnit.app G.obj) c.op z

  have hPc : ∀ {W₁ W₂ W₃ : Y.ProEt} (k : W₁ ⟶ W₂) (f : W₂ ⟶ W₃)
      (z : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op W₃)),
      ((wcEtToProEt Y).op.lan.obj G.obj).map (k ≫ f).op z =
        ((wcEtToProEt Y).op.lan.obj G.obj).map k.op
          (((wcEtToProEt Y).op.lan.obj G.obj).map f.op z) := by
    intro W₁ W₂ W₃ k f z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have hKy : ((wcEtToProEt Y).op.lan.obj G.obj).map k.op y =
      ((wcEtToProEt Y).op.lan.obj G.obj).map (k ≫ a).op
        (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V₁) t) := by
    rw [hy, hPc]
  rw [hKy]
  constructor
  ·
    intro h0
    obtain ⟨V₂, c, a', hfac, hvan⟩ := (wc_lan_etale_rep Y G.obj W).2 V₁ (k ≫ a) t h0
    rintro _ ⟨p, rfl⟩
    refine ⟨V₂, c, ⟨a'.left p, ?_⟩, hvan⟩
    have e : a'.left ≫ c.left = k.left ≫ a.left := congrArg (fun f => f.left) hfac
    have e2 := congrArg (fun f => f p) e
    simp only [Scheme.Hom.comp_apply] at e2
    exact e2
  ·
    intro hk
    obtain ⟨VE, cE, hr, hlift, -⟩ := wc_etale_open_subobject Y V₁ _ hE
    have hrange : Set.range (k ≫ a).left ⊆ {v : V₁.left | ∃ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V₁),
        v ∈ Set.range c₂.left ∧ G.obj.map c₂.op t = 0} := by
      rintro _ ⟨p, rfl⟩
      have hp := hk ⟨p, rfl⟩
      exact (Scheme.Hom.comp_apply k.left a.left p) ▸ hp
    obtain ⟨ψ', hψ'⟩ := hlift W (k ≫ a) hrange
    have hz : G.obj.map cE.op t = 0 := hEvan VE cE hr.le
    rw [← hψ', hPc, ← hN, hz, map_zero, map_zero]

theorem wc_lan_etale_separated : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (T : Y.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology Y T → ∀ x : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op T), (∀ (W : Y.ProEt) (f : W ⟶ T), R.arrows f → ((wcEtToProEt Y).op.lan.obj G.obj).map f.op x = 0) → x = 0 :=
by
  intro Y G T R hR x hx
  obtain ⟨O, -, hO⟩ := wc_lan_etale_zero_locus Y G T x
  have hall : ∀ τ : T.left, τ ∈ O := fun τ => by
    obtain ⟨W, f, hf, w, hw⟩ := (wc_proet_cover_surj_quotient Y T R hR).1 τ
    exact (hO W f).mp (hx W f hf) ⟨w, hw⟩
  have h := (hO T (𝟙 T)).mpr (fun p _ => hall p)
  rw [op_id, CategoryTheory.Functor.map_id] at h
  exact h

theorem wc_etale_jointly_surjective_covers : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V :=
by
  intro Y V S hS
  change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
  apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
  intro x
  obtain ⟨V₁, c, hc, y, hy⟩ := hS x
  have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
  have hEt : Etale c.left := by
    have h1 : Etale V.hom := V.prop
    have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
    exact Etale.of_comp c.left V.hom
  exact ⟨V₁, c, y, hc, hEt, hy⟩

theorem wc_lan_etale_agree_open : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (R : Sieve ((wcEtToProEt Y).obj V)), R ∈ Scheme.ProEt.topology Y ((wcEtToProEt Y).obj V) → ∀ (x : ∀ (W : Y.ProEt) (f : W ⟶ (wcEtToProEt Y).obj V), R.arrows f → ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op W)), (∀ (W W' : Y.ProEt) (f : W ⟶ (wcEtToProEt Y).obj V) (k : W' ⟶ W) (hf : R.arrows f), x W' (k ≫ f) (R.downward_closed hf k) = ((wcEtToProEt Y).op.lan.obj G.obj).map k.op (x W f hf)) → ∀ (V₁ : Y.Etale) (b : V₁ ⟶ V) (t : G.obj.obj (Opposite.op V₁)), ∃ O : Set V₁.left, IsOpen O ∧ (∀ (M : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁) (hm : R.arrows (m ≫ (wcEtToProEt Y).map b)), Set.range m.left ⊆ O → ((wcEtToProEt Y).op.lan.obj G.obj).map m.op (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V₁) t) = x M (m ≫ (wcEtToProEt Y).map b) hm) ∧ (∀ (W : Y.ProEt) (a : W ⟶ (wcEtToProEt Y).obj V₁) (ha : R.arrows (a ≫ (wcEtToProEt Y).map b)), ((wcEtToProEt Y).op.lan.obj G.obj).map a.op (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V₁) t) = x W (a ≫ (wcEtToProEt Y).map b) ha → Set.range a.left ⊆ O) :=
by
  intro Y G V R hR x hx V₁ b t
  have hPc : ∀ {W₁ W₂ W₃ : Y.ProEt} (k : W₁ ⟶ W₂) (f : W₂ ⟶ W₃)
      (y : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op W₃)),
      ((wcEtToProEt Y).op.lan.obj G.obj).map (k ≫ f).op y =
        ((wcEtToProEt Y).op.lan.obj G.obj).map k.op
          (((wcEtToProEt Y).op.lan.obj G.obj).map f.op y) := by
    intro W₁ W₂ W₃ k f y
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have hPid : ∀ {W : Y.ProEt} (y : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op W)),
      ((wcEtToProEt Y).op.lan.obj G.obj).map (𝟙 W).op y = y := by
    intro W y
    rw [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply]
  have TL : ∀ (W : Y.ProEt) (f f' : W ⟶ (wcEtToProEt Y).obj V) (h : R.arrows f)
      (h' : R.arrows f'), f = f' → x W f h = x W f' h' := by
    intro W f f' h h' e
    subst e
    rfl
  set e := ((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V₁) t with he
  let Z : ∀ (M : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁),
      R.arrows (m ≫ (wcEtToProEt Y).map b) →
      ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op M) :=
    fun M m hm => ((wcEtToProEt Y).op.lan.obj G.obj).map m.op e -
      x M (m ≫ (wcEtToProEt Y).map b) hm
  have TLZ : ∀ (M : Y.ProEt) (n n' : M ⟶ (wcEtToProEt Y).obj V₁)
      (h : R.arrows (n ≫ (wcEtToProEt Y).map b)) (h' : R.arrows (n' ≫ (wcEtToProEt Y).map b)),
      n = n' → Z M n h = Z M n' h' := by
    intro M n n' h h' e
    subst e
    rfl
  have Cmp : ∀ (M W : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁) (k : W ⟶ M)
      (hm : R.arrows (m ≫ (wcEtToProEt Y).map b))
      (h : R.arrows ((k ≫ m) ≫ (wcEtToProEt Y).map b)),
      Z W (k ≫ m) h = ((wcEtToProEt Y).op.lan.obj G.obj).map k.op (Z M m hm) := by
    intro M W m k hm h
    simp only [Z]
    rw [map_sub, hPc, ← hx M W (m ≫ (wcEtToProEt Y).map b) k hm]
    congr 1
  choose Om hOmo hOm using fun (M : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁)
    (hm : R.arrows (m ≫ (wcEtToProEt Y).map b)) => wc_lan_etale_zero_locus Y G M (Z M m hm)

  have hRef : ∀ (T M M' : Y.ProEt) (m : M ⟶ T) (m' : M' ⟶ T) (p : M.left) (p' : M'.left),
      m.left p = m'.left p' → ∀ (O : Set M'.left), IsOpen O → p' ∈ O →
      ∃ (Q : Y.ProEt) (q : Q ⟶ M) (q' : Q ⟶ M'), q ≫ m = q' ≫ m' ∧ p ∈ Set.range q.left ∧
        Set.range q'.left ⊆ O := by
    intro T M M' m m' p p' hpp O hO hp'
    let Oo : M'.left.Opens := ⟨O, hO⟩
    haveI hM' : WeaklyEtale M'.hom := M'.prop
    haveI hT : WeaklyEtale T.hom := T.prop
    haveI hM : WeaklyEtale M.hom := M.prop
    haveI h1 : WeaklyEtale (m'.left ≫ T.hom) := by
      rw [MorphismProperty.Over.w m']; exact hM'
    haveI h2 : WeaklyEtale m'.left := WeaklyEtale.of_comp m'.left T.hom
    let g₁ : (Oo : Scheme.{u}) ⟶ T.left := Oo.ι ≫ m'.left
    have hc : Limits.pullback.fst m.left g₁ ≫ m.left = Limits.pullback.snd m.left g₁ ≫ g₁ :=
      Limits.pullback.condition
    let Q : Y.ProEt := Scheme.ProEt.mk (Limits.pullback.fst m.left g₁ ≫ M.hom)
    let q : Q ⟶ M := MorphismProperty.Over.homMk (Limits.pullback.fst m.left g₁) rfl trivial
    have hw : (Limits.pullback.snd m.left g₁ ≫ Oo.ι) ≫ M'.hom =
        Limits.pullback.fst m.left g₁ ≫ M.hom := by
      rw [← MorphismProperty.Over.w m', ← MorphismProperty.Over.w m, ← Category.assoc _ m.left,
        hc]
      simp only [g₁, Category.assoc]
    let q' : Q ⟶ M' := MorphismProperty.Over.homMk (Limits.pullback.snd m.left g₁ ≫ Oo.ι) hw trivial
    refine ⟨Q, q, q', ?_, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst m.left g₁ ≫ m.left = (Limits.pullback.snd m.left g₁ ≫ Oo.ι) ≫ m'.left
      rw [hc, Category.assoc]
    · obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := m.left) (g := g₁) p
        ⟨p', hp'⟩ (by
          rw [hpp]
          have e1 : g₁ ⟨p', hp'⟩ = m'.left (Oo.ι ⟨p', hp'⟩) := Scheme.Hom.comp_apply _ _ _
          rw [e1, Scheme.Opens.ι_apply])
      exact ⟨z, hz⟩
    · rintro _ ⟨w, rfl⟩
      have e1 : q'.left w = Oo.ι (Limits.pullback.snd m.left g₁ w) := Scheme.Hom.comp_apply _ _ _
      have e2 : Oo.ι (Limits.pullback.snd m.left g₁ w) = (Limits.pullback.snd m.left g₁ w).1 :=
        Scheme.Opens.ι_apply Oo _
      rw [e1, e2]
      exact (Limits.pullback.snd m.left g₁ w).2

  have D : ∀ (M M' : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁)
      (m' : M' ⟶ (wcEtToProEt Y).obj V₁) (hm : R.arrows (m ≫ (wcEtToProEt Y).map b))
      (hm' : R.arrows (m' ≫ (wcEtToProEt Y).map b)) (p : M.left) (p' : M'.left),
      m.left p = m'.left p' → p' ∈ Om M' m' hm' → p ∈ Om M m hm := by
    intro M M' m m' hm hm' p p' hpp hp'
    obtain ⟨Q, q, q', hqq, ⟨z, hz⟩, hq'⟩ := hRef _ M M' m m' p p' hpp _ (hOmo M' m' hm') hp'
    have h1 : ((wcEtToProEt Y).op.lan.obj G.obj).map q'.op (Z M' m' hm') = 0 :=
      (hOm M' m' hm' Q q').mpr hq'
    have hq'm : R.arrows ((q' ≫ m') ≫ (wcEtToProEt Y).map b) := by
      rw [Category.assoc]; exact R.downward_closed hm' q'
    have hqm : R.arrows ((q ≫ m) ≫ (wcEtToProEt Y).map b) := by
      rw [Category.assoc]; exact R.downward_closed hm q
    have h2 : ((wcEtToProEt Y).op.lan.obj G.obj).map q.op (Z M m hm) = 0 := by
      rw [← Cmp M Q m q hm hqm, TLZ Q _ _ hqm hq'm hqq, Cmp M' Q m' q' hm' hq'm, h1]
    have h3 := (hOm M m hm Q q).mp h2
    rw [← hz]
    exact h3 ⟨z, rfl⟩

  have hR' : R.pullback ((wcEtToProEt Y).map b) ∈
      Scheme.ProEt.topology Y ((wcEtToProEt Y).obj V₁) :=
    (Scheme.ProEt.topology Y).pullback_stable _ hR
  let O' : Set V₁.left := {τ | ∃ (M : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁)
    (hm : R.arrows (m ≫ (wcEtToProEt Y).map b)) (p : M.left), m.left p = τ ∧ p ∈ Om M m hm}
  have hpre : ∀ (M : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj V₁)
      (hm : R.arrows (m ≫ (wcEtToProEt Y).map b)), m.left ⁻¹' O' = Om M m hm := by
    intro M m hm
    ext p
    constructor
    · rintro ⟨M', m', hm', p', heq, hp'⟩
      exact D M M' m m' hm hm' p p' heq.symm hp'
    · intro hp
      exact ⟨M, m, hm, p, rfl, hp⟩
  have hO'o : IsOpen O' := by
    apply (wc_proet_cover_surj_quotient Y _ _ hR').2
    intro W f hf
    rw [hpre W f hf]
    exact hOmo W f hf
  refine ⟨O', hO'o, ?_, ?_⟩
  · intro M m hm hr
    have h1 : Set.range (𝟙 M : M ⟶ M).left ⊆ Om M m hm := by
      rintro _ ⟨p, rfl⟩
      rw [← hpre M m hm]
      exact hr ⟨(𝟙 M : M ⟶ M).left p, rfl⟩
    have h2 := (hOm M m hm M (𝟙 M)).mpr h1
    rw [hPid] at h2
    exact sub_eq_zero.mp h2
  · intro W a ha heq
    have h0 : Z W a ha = 0 := sub_eq_zero.mpr heq
    have h1 : ((wcEtToProEt Y).op.lan.obj G.obj).map (𝟙 W).op (Z W a ha) = 0 := by
      rw [hPid]; exact h0
    have h2 := (hOm W a ha W (𝟙 W)).mp h1
    rintro _ ⟨p, rfl⟩
    have h3 : p ∈ a.left ⁻¹' O' := by
      rw [hpre W a ha]
      exact h2 ⟨p, rfl⟩
    exact h3

theorem wc_lan_etale_glue : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (R : Sieve ((wcEtToProEt Y).obj V)), R ∈ Scheme.ProEt.topology Y ((wcEtToProEt Y).obj V) → ∀ (x : ∀ (W : Y.ProEt) (f : W ⟶ (wcEtToProEt Y).obj V), R.arrows f → ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op W)), (∀ (W W' : Y.ProEt) (f : W ⟶ (wcEtToProEt Y).obj V) (k : W' ⟶ W) (hf : R.arrows f), x W' (k ≫ f) (R.downward_closed hf k) = ((wcEtToProEt Y).op.lan.obj G.obj).map k.op (x W f hf)) → ∃ s : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op ((wcEtToProEt Y).obj V)), ∀ (W : Y.ProEt) (f : W ⟶ (wcEtToProEt Y).obj V) (hf : R.arrows f), ((wcEtToProEt Y).op.lan.obj G.obj).map f.op s = x W f hf :=
by
  intro Y G V R hR x hx

  haveI : (wcEtToProEt Y).Full :=
    ⟨fun {A B} f => ⟨MorphismProperty.Over.homMk f.left (MorphismProperty.Over.w f) trivial, by
      apply MorphismProperty.Over.Hom.ext; rfl⟩⟩
  haveI : (wcEtToProEt Y).Faithful :=
    ⟨fun {A B} f g h => MorphismProperty.Over.Hom.ext (congrArg (fun k => k.left) h)⟩
  have hη : ∀ Z : Y.Etale,
      Function.Injective (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op Z)) := by
    intro Z
    have hiso : IsIso (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op Z)) :=
      Functor.LeftExtension.IsPointwiseLeftKanExtensionAt.isIso_hom_app
        (Functor.LeftExtension.mk ((wcEtToProEt Y).op.leftKanExtension G.obj)
          ((wcEtToProEt Y).op.leftKanExtensionUnit G.obj))
        ((wcEtToProEt Y).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit G.obj _)
    exact ((ConcreteCategory.isIso_iff_bijective _).mp hiso).1

  have hN : ∀ {A B : Y.Etale} (c : A ⟶ B) (y : G.obj.obj (Opposite.op B)),
      ((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op A) (G.obj.map c.op y) =
        ((wcEtToProEt Y).op.lan.obj G.obj).map ((wcEtToProEt Y).map c).op
          (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op B) y) :=
    fun c y => NatTrans.naturality_apply ((wcEtToProEt Y).op.lanUnit.app G.obj) c.op y

  have hPc : ∀ {W₁ W₂ W₃ : Y.ProEt} (k : W₁ ⟶ W₂) (f : W₂ ⟶ W₃)
      (y : ((wcEtToProEt Y).op.lan.obj G.obj).obj (Opposite.op W₃)),
      ((wcEtToProEt Y).op.lan.obj G.obj).map (k ≫ f).op y =
        ((wcEtToProEt Y).op.lan.obj G.obj).map k.op
          (((wcEtToProEt Y).op.lan.obj G.obj).map f.op y) := by
    intro W₁ W₂ W₃ k f y
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  have TL : ∀ (W : Y.ProEt) (f f' : W ⟶ (wcEtToProEt Y).obj V) (h : R.arrows f)
      (h' : R.arrows f'), f = f' → x W f h = x W f' h' := by
    intro W f f' h h' e
    subst e
    rfl

  have h4 := fun i : {p : (Σ W : Y.ProEt, W ⟶ (wcEtToProEt Y).obj V) // R.arrows p.2} =>
    (wc_lan_etale_rep Y G.obj i.1.1).1 V i.1.2 (x i.1.1 i.1.2 i.2)
  choose V₁ b a t hR1 hR2 using h4

  have h13 := fun i => wc_lan_etale_agree_open Y G V R hR x hx (V₁ i) (b i) (t i)
  choose O hO0 hO1 hO2 using h13
  have hA : ∀ i, Set.range (a i).left ⊆ O i := by
    intro i
    refine hO2 i i.1.1 (a i) (by rw [hR1 i]; exact i.2) ?_
    rw [← hR2 i]
    exact TL _ _ _ _ _ (hR1 i).symm

  have h6 := fun i => wc_etale_open_subobject Y (V₁ i) (O i) (hO0 i)
  choose V' ι hS0 hS1 _hS2 using h6
  have hL0 := fun i => hS1 i i.1.1 (a i) (hA i)
  choose a' hL using hL0
  have hF : ∀ i, i.1.2 = a' i ≫ (wcEtToProEt Y).map (ι i ≫ b i) := by
    intro i
    rw [Functor.map_comp, ← Category.assoc, hL i, hR1 i]

  have hsurj : ∀ v : V.left, ∃ i, v ∈ Set.range (ι i ≫ b i).left := by
    intro v
    obtain ⟨W, f, hf, w, hw⟩ := (wc_proet_cover_surj_quotient Y ((wcEtToProEt Y).obj V) R hR).1 v
    refine ⟨⟨⟨W, f⟩, hf⟩, (a' ⟨⟨W, f⟩, hf⟩).left w, ?_⟩
    have e : f.left = (a' ⟨⟨W, f⟩, hf⟩).left ≫ (ι ⟨⟨W, f⟩, hf⟩ ≫ b ⟨⟨W, f⟩, hf⟩).left :=
      congrArg (fun k => k.left) (hF ⟨⟨W, f⟩, hf⟩)
    rw [← hw, e]
    exact (Scheme.Hom.comp_apply _ _ _).symm

  have hK : ∀ (i) (Z : Y.Etale) (p : Z ⟶ V' i) (M : Y.ProEt) (m : M ⟶ (wcEtToProEt Y).obj Z)
      (hm : R.arrows (m ≫ (wcEtToProEt Y).map (p ≫ ι i ≫ b i))),
      ((wcEtToProEt Y).op.lan.obj G.obj).map m.op
        (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op Z)
          (G.obj.map p.op (G.obj.map (ι i).op (t i)))) =
        x M (m ≫ (wcEtToProEt Y).map (p ≫ ι i ≫ b i)) hm := by
    intro i Z p M m hm
    rw [hN, hN, ← hPc, ← hPc]
    have eα : ((m ≫ (wcEtToProEt Y).map p) ≫ (wcEtToProEt Y).map (ι i)) ≫ (wcEtToProEt Y).map (b i)
        = m ≫ (wcEtToProEt Y).map (p ≫ ι i ≫ b i) := by
      simp only [Functor.map_comp, Category.assoc]
    have hα : R.arrows
        (((m ≫ (wcEtToProEt Y).map p) ≫ (wcEtToProEt Y).map (ι i)) ≫ (wcEtToProEt Y).map (b i)) := by
      rw [eα]; exact hm
    have hrange : Set.range ((m ≫ (wcEtToProEt Y).map p) ≫ (wcEtToProEt Y).map (ι i)).left ⊆ O i := by
      rw [← hS0 i]
      rintro _ ⟨w, rfl⟩
      exact ⟨(m ≫ (wcEtToProEt Y).map p).left w,
        (Scheme.Hom.comp_apply (m ≫ (wcEtToProEt Y).map p).left (ι i).left w).symm⟩
    rw [hO1 i M _ hα hrange]
    exact TL _ _ _ _ _ eα

  have hC : ∀ (i j) (Z : Y.Etale) (p : Z ⟶ V' i) (q : Z ⟶ V' j),
      p ≫ (ι i ≫ b i) = q ≫ (ι j ≫ b j) →
      G.obj.map p.op (G.obj.map (ι i).op (t i)) = G.obj.map q.op (G.obj.map (ι j).op (t j)) := by
    intro i j Z p q hpq
    apply hη Z
    rw [← sub_eq_zero, ← map_sub]
    apply wc_lan_etale_separated Y G ((wcEtToProEt Y).obj Z)
      (R.pullback ((wcEtToProEt Y).map (p ≫ ι i ≫ b i)))
      ((Scheme.ProEt.topology Y).pullback_stable _ hR)
    intro M m hm
    have hm' : R.arrows (m ≫ (wcEtToProEt Y).map (q ≫ ι j ≫ b j)) := by
      rw [← hpq]; exact hm
    simp only [map_sub]
    rw [hK i Z p M m hm, hK j Z q M m hm', sub_eq_zero]
    exact TL _ _ _ _ _ (by rw [hpq])

  have hSmem : Sieve.generate (Presieve.ofArrows V' (fun i => ι i ≫ b i)) ∈
      Scheme.smallEtaleTopology Y V := by
    apply wc_etale_jointly_surjective_covers
    intro v
    obtain ⟨i, hi⟩ := hsurj v
    exact ⟨V' i, ι i ≫ b i, ⟨V' i, 𝟙 _, ι i ≫ b i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hi⟩
  have hGsh : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj G).2
  have hSF := (Presieve.isSheafFor_arrows_iff _ _).mp (hGsh.isSheafFor _ hSmem)
  obtain ⟨g, hg, -⟩ := hSF (fun i => G.obj.map (ι i).op (t i))
    (fun i j Z p q hpq => hC i j Z p q hpq)
  have hg' : ∀ i, G.obj.map (ι i ≫ b i).op g = G.obj.map (ι i).op (t i) := hg

  refine ⟨((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V) g, ?_⟩
  have hfin : ∀ i : {p : (Σ W : Y.ProEt, W ⟶ (wcEtToProEt Y).obj V) // R.arrows p.2},
      ((wcEtToProEt Y).op.lan.obj G.obj).map i.1.2.op
      (((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V) g) = x i.1.1 i.1.2 i.2 := by
    intro i
    rw [hR2 i, hF i, hPc, ← hN, hg' i, hN, ← hPc, hL i]
  exact fun W f hf => hfin ⟨⟨W, f⟩, hf⟩

theorem wc_epsInv_unit_iso : ∀ (Y : Scheme.{u}) [(wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)] (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), IsIso ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G) :=
by
  intro Y _ G

  have hθinj : ∀ (Q : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (Z : Y.ProEt) (R : Sieve Z), R ∈ Scheme.ProEt.topology Y Z → ∀ x : Q.obj (Opposite.op Z),
        (∀ (W : Y.ProEt) (f : W ⟶ Z), R.arrows f → Q.map f.op x = 0) → x = 0) →
      ∀ (Z : Y.ProEt) (a b : Q.obj (Opposite.op Z)),
        (toSheafify (Scheme.ProEt.topology Y) Q).app (Opposite.op Z) a =
          (toSheafify (Scheme.ProEt.topology Y) Q).app (Opposite.op Z) b → a = b := by
    intro Q hsep Z a b hab
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.ProEt.topology Y) Q
    have hmem := Presheaf.IsLocallyInjective.equalizerSieve_mem
      (J := Scheme.ProEt.topology Y) (φ := toSheafify (Scheme.ProEt.topology Y) Q) a b hab
    have h0 := hsep Z _ hmem (a - b) (fun W f hf => by
      have hf' : Q.map f.op a = Q.map f.op b := hf
      rw [map_sub, hf', sub_self])
    exact sub_eq_zero.mp h0

  have hθsurj : ∀ (Q : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (Z : Y.ProEt) (R : Sieve Z), R ∈ Scheme.ProEt.topology Y Z → ∀ x : Q.obj (Opposite.op Z),
        (∀ (W : Y.ProEt) (f : W ⟶ Z), R.arrows f → Q.map f.op x = 0) → x = 0) →
      ∀ (X : Y.ProEt),
      (∀ (R : Sieve X), R ∈ Scheme.ProEt.topology Y X →
        ∀ (x : ∀ (W : Y.ProEt) (f : W ⟶ X), R.arrows f → Q.obj (Opposite.op W)),
        (∀ (W W' : Y.ProEt) (f : W ⟶ X) (k : W' ⟶ W) (hf : R.arrows f),
          x W' (k ≫ f) (R.downward_closed hf k) = Q.map k.op (x W f hf)) →
        ∃ s : Q.obj (Opposite.op X), ∀ (W : Y.ProEt) (f : W ⟶ X) (hf : R.arrows f),
          Q.map f.op s = x W f hf) →
      Function.Surjective ((toSheafify (Scheme.ProEt.topology Y) Q).app (Opposite.op X)) := by
    intro Q hsep X hglue s
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology Y) Q
    have hR : Presheaf.imageSieve (toSheafify (Scheme.ProEt.topology Y) Q) s ∈
        Scheme.ProEt.topology Y X :=
      Presheaf.IsLocallySurjective.imageSieve_mem s
    have hy : ∀ (W : Y.ProEt) (f : W ⟶ X),
        (Presheaf.imageSieve (toSheafify (Scheme.ProEt.topology Y) Q) s).arrows f →
        ∃ t : Q.obj (Opposite.op W), (toSheafify (Scheme.ProEt.topology Y) Q).app (Opposite.op W) t =
          (sheafify (Scheme.ProEt.topology Y) Q).map f.op s := fun W f hf => hf
    choose y hy' using hy
    obtain ⟨t, ht⟩ := hglue _ hR y (fun W W' f k hf => by
      apply hθinj Q hsep
      rw [hy', NatTrans.naturality_apply, hy', op_comp, Functor.map_comp,
        ConcreteCategory.comp_apply])
    refine ⟨t, ?_⟩
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology Y)
        (sheafify (Scheme.ProEt.topology Y) Q ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology Y) (forget AddCommGrpCat.{u+1})).obj
          ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj Q)).2
    apply (hsh _ hR).isSeparatedFor.ext
    intro W f hf
    change (sheafify (Scheme.ProEt.topology Y) Q).map f.op
        ((toSheafify (Scheme.ProEt.topology Y) Q).app (Opposite.op X) t) =
      (sheafify (Scheme.ProEt.topology Y) Q).map f.op s
    rw [← NatTrans.naturality_apply, ht W f hf, hy']

  haveI : (wcEtToProEt Y).Full :=
    ⟨fun {A B} f => ⟨MorphismProperty.Over.homMk f.left (MorphismProperty.Over.w f) trivial, by
      apply MorphismProperty.Over.Hom.ext; rfl⟩⟩
  haveI : (wcEtToProEt Y).Faithful :=
    ⟨fun {A B} f g h => MorphismProperty.Over.Hom.ext (congrArg (fun k => k.left) h)⟩
  have hη : ∀ (F : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : Y.Etale),
      IsIso (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V)) := fun F V =>
    Functor.LeftExtension.IsPointwiseLeftKanExtensionAt.isIso_hom_app
      (Functor.LeftExtension.mk ((wcEtToProEt Y).op.leftKanExtension F)
        ((wcEtToProEt Y).op.leftKanExtensionUnit F))
      ((wcEtToProEt Y).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F _)

  have hcomp : ∀ V : Y.Etale,
      ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G).hom.app (Opposite.op V) =
      ((wcEtToProEt Y).op.lanUnit.app G.obj).app (Opposite.op V) ≫
        (toSheafify (Scheme.ProEt.topology Y) ((wcEtToProEt Y).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtToProEt Y).obj V)) := by
    intro V
    have h1 := Adjunction.map_restrictFullyFaithful_unit_app
      (((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).comp
        (sheafificationAdjunction (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}))
      (fullyFaithfulSheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (Functor.FullyFaithful.id _)
      (L := Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt Y) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y))
      (R := (wcEtToProEt Y).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y))
      (Iso.refl _) (Iso.refl _) G
    rw [Adjunction.comp_unit_app, Functor.lanAdjunction_unit, sheafificationAdjunction_unit_app] at h1
    have h2 := congrArg (fun f => NatTrans.app f (Opposite.op V)) h1
    refine h2.trans ?_
    ext x
    rfl

  have happ : ∀ V : Y.Etale,
      IsIso (((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G).hom.app
          (Opposite.op V)) := by
    intro V
    rw [hcomp V]
    have i1 := hη G.obj V
    have i2 : IsIso ((toSheafify (Scheme.ProEt.topology Y) ((wcEtToProEt Y).op.lan.obj G.obj)).app
        (Opposite.op ((wcEtToProEt Y).obj V))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr
        ⟨fun a b hab => hθinj _ (wc_lan_etale_separated Y G) _ a b hab,
         hθsurj _ (wc_lan_etale_separated Y G) _ (wc_lan_etale_glue Y G V)⟩
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ i1 i2
  haveI : IsIso ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G).hom :=
    NatIso.isIso_of_isIso_app _
  haveI : IsIso ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G)) :=
    (inferInstance : IsIso ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G).hom)
  exact isIso_of_reflects_iso _ (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})

theorem wc_cech_dd_zero : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) (p : ℕ) (b : ∀ σ : Fin (p + 1) → Fin k, G.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (ρ : Fin (p + 3) → Fin k), ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) • G.map (wcCechFace V f ρ j).op (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) • G.map (wcCechFace V f (fun l => ρ (j.succAbove l)) i).op (b (fun l => ρ (j.succAbove (i.succAbove l))))) = 0 :=
by
  intro C _ _ G U k V f p b ρ

  have SV : ∀ {n : ℕ} (a : Fin (n + 1)) (x : Fin n),
      ((a.succAbove x : Fin (n + 1)) : ℕ) = if (x : ℕ) < (a : ℕ) then (x : ℕ) else (x : ℕ) + 1 := by
    intro n a x
    by_cases h : x.castSucc < a
    · rw [Fin.succAbove_of_castSucc_lt _ _ h]
      rw [Fin.lt_def, Fin.coe_castSucc] at h
      rw [if_pos h, Fin.coe_castSucc]
    · rw [Fin.succAbove_of_le_castSucc _ _ (not_lt.mp h)]
      rw [Fin.lt_def, Fin.coe_castSucc] at h
      rw [if_neg h, Fin.val_succ]

  let g : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun a =>
    if (a.2 : ℕ) < (a.1 : ℕ) then
      (⟨a.2, by have := a.2.isLt; omega⟩, ⟨a.1 - 1, by have := a.1.isLt; omega⟩)
    else (⟨a.2 + 1, by have := a.2.isLt; omega⟩, ⟨min a.1 (p + 1), by omega⟩)
  have hg1 : ∀ a : Fin (p + 3) × Fin (p + 2), (a.2 : ℕ) < (a.1 : ℕ) →
      ((g a).1 : ℕ) = a.2 ∧ ((g a).2 : ℕ) = a.1 - 1 := by
    intro a h
    have := a.2.isLt
    refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
  have hg2 : ∀ a : Fin (p + 3) × Fin (p + 2), ¬ (a.2 : ℕ) < (a.1 : ℕ) →
      ((g a).1 : ℕ) = a.2 + 1 ∧ ((g a).2 : ℕ) = a.1 := by
    intro a h
    have := a.2.isLt
    refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
  have gA : ∀ a : Fin (p + 3) × Fin (p + 2),
      (fun l : Fin (p + 1) => (g a).1.succAbove ((g a).2.succAbove l)) =
        fun l => a.1.succAbove (a.2.succAbove l) := by
    intro a
    funext l
    apply Fin.ext
    have h3 := a.1.isLt
    have h4 := a.2.isLt
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      simp only [SV, e1, e2]
      split_ifs <;> omega
    · obtain ⟨e1, e2⟩ := hg2 a h
      simp only [SV, e1, e2]
      split_ifs <;> omega
  have gB : ∀ a : Fin (p + 3) × Fin (p + 2),
      (-1 : ℤ) ^ ((g a).1 : ℕ) * (-1 : ℤ) ^ ((g a).2 : ℕ) =
        -((-1 : ℤ) ^ (a.1 : ℕ) * (-1 : ℤ) ^ (a.2 : ℕ)) := by
    intro a
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      rw [e1, e2]
      obtain ⟨m, hm⟩ : ∃ m, (a.1 : ℕ) = m + 1 := ⟨(a.1 : ℕ) - 1, by omega⟩
      rw [hm, Nat.add_sub_cancel, pow_succ]
      ring
    · obtain ⟨e1, e2⟩ := hg2 a h
      rw [e1, e2, pow_succ]
      ring
  have gC : ∀ a : Fin (p + 3) × Fin (p + 2), g a ≠ a := by
    intro a hc
    have hv : ((g a).1 : ℕ) = a.1 := by rw [hc]
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      omega
    · obtain ⟨e1, e2⟩ := hg2 a h
      omega
  have gD : ∀ a : Fin (p + 3) × Fin (p + 2), g (g a) = a := by
    intro a
    have h3 := a.1.isLt
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      have h' : ¬ ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
      obtain ⟨f1, f2⟩ := hg2 (g a) h'
      refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega
    · obtain ⟨e1, e2⟩ := hg2 a h
      have h' : ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
      obtain ⟨f1, f2⟩ := hg1 (g a) h'
      refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega

  have s2 : ∀ F : (Fin (p + 1) → Fin (p + 3)) →
      G.obj (Opposite.op (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l)))),
      ∑ j : Fin (p + 3), ∑ i : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
        F (fun l => j.succAbove (i.succAbove l)) = 0 := by
    intro F
    rw [← Fintype.sum_prod_type' (f := fun (j : Fin (p + 3)) (i : Fin (p + 2)) =>
        ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) • F (fun l => j.succAbove (i.succAbove l)))]
    refine Finset.sum_involution (fun a _ => g a) ?_ ?_ ?_ ?_
    · intro a _
      show ((-1 : ℤ) ^ (a.1 : ℕ) * (-1 : ℤ) ^ (a.2 : ℕ)) •
          F (fun l => a.1.succAbove (a.2.succAbove l)) +
        ((-1 : ℤ) ^ ((g a).1 : ℕ) * (-1 : ℤ) ^ ((g a).2 : ℕ)) •
          F (fun l => (g a).1.succAbove ((g a).2.succAbove l)) = 0
      rw [gA a, gB a, neg_smul, add_neg_cancel]
    · intro a _ _
      exact gC a
    · intro a _
      exact Finset.mem_univ _
    · intro a _
      exact gD a

  have hc : ∀ (j : Fin (p + 3)) (i : Fin (p + 2)),
      wcCechFace V f ρ j ≫ wcCechFace V f (fun l => ρ (j.succAbove l)) i =
        Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (ρ l)))
          (fun l => Limits.WidePullback.π (fun l => f (ρ l)) (j.succAbove (i.succAbove l)))
          (by simp) := by
    intro j i
    apply Limits.WidePullback.hom_ext
    · intro l
      simp only [wcCechFace, Category.assoc]
      erw [Limits.WidePullback.lift_π, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π]
    · simp only [wcCechFace, Category.assoc]
      erw [Limits.WidePullback.lift_base, Limits.WidePullback.lift_base,
        Limits.WidePullback.lift_base]
  refine Eq.trans ?_ (s2 (fun α => G.map (Limits.WidePullback.lift
      (Limits.WidePullback.base (fun l => f (ρ l)))
      (fun l => Limits.WidePullback.π (fun l => f (ρ l)) (α l)) (by simp)).op
      (b (fun l => ρ (α l)))))
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [map_zsmul, smul_smul]
  congr 1
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hc j i]

theorem wc_cech_acyclic_quotient : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] {G I Q : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (ι : G ⟶ I) (π : I ⟶ Q), (∀ (W : C) (x : G.obj (Opposite.op W)), ι.app (Opposite.op W) x = 0 → x = 0) → (∀ (W : C) (y : I.obj (Opposite.op W)), π.app (Opposite.op W) y = 0 → ∃ x, ι.app (Opposite.op W) x = y) → (∀ (W : C) (x : G.obj (Opposite.op W)), π.app (Opposite.op W) (ι.app (Opposite.op W) x) = 0) → ∀ {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U), (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), Function.Surjective (π.app (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))) → (∀ (p : ℕ) (b : ∀ σ : Fin (p + 1) → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (ρ : Fin (p + 3) → Fin k), ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) • I.map (wcCechFace V f ρ j).op (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) • I.map (wcCechFace V f (fun l => ρ (j.succAbove l)) i).op (b (fun l => ρ (j.succAbove (i.succAbove l))))) = 0) → wcCechAcyclic G V f → wcCechAcyclic I V f → wcCechAcyclic Q V f :=
by
  intro C _ _ G I Q ι π hinj hex hzero U k V f hsurj hdd hG hI

  have hN : ∀ {F F' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ F') (p : ℕ)
      (b : ∀ σ : Fin (p + 1) → Fin k,
        F.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
      (τ : Fin (p + 2) → Fin k),
      α.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
        (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (b (fun l => τ (j.succAbove l)))) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        F'.map (wcCechFace V f τ j).op
          (α.app (Opposite.op (Limits.widePullback U (fun l => V (τ (j.succAbove l)))
            (fun l => f (τ (j.succAbove l))))) (b (fun l => τ (j.succAbove l)))) := by
    intro F F' α p b τ
    simp only [map_sum, map_zsmul, NatTrans.naturality_apply]

  have hS : ∀ (F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (p : ℕ)
      (x y : ∀ σ : Fin (p + 1) → Fin k,
        F.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
      (τ : Fin (p + 2) → Fin k),
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        F.map (wcCechFace V f τ j).op (x (fun l => τ (j.succAbove l)) - y (fun l => τ (j.succAbove l))) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (x (fun l => τ (j.succAbove l))) -
        ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (y (fun l => τ (j.succAbove l))) := by
    intro F p x y τ
    simp only [map_sub, smul_sub, Finset.sum_sub_distrib]
  intro p c hc

  choose c' hcc using fun τ : Fin (p + 2) → Fin k => hsurj (p + 1) τ (c τ)

  have h2 : ∀ ρ : Fin (p + 3) → Fin k,
      π.app (Opposite.op (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l))))
        (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
          I.map (wcCechFace V f ρ j).op (c' (fun l => ρ (j.succAbove l)))) = 0 := by
    intro ρ
    refine (hN π (p + 1) c' ρ).trans ?_
    simp only [hcc]
    exact hc ρ
  choose g hg using fun ρ => hex _ _ (h2 ρ)

  have h3 : ∀ θ : Fin (p + 4) → Fin k,
      ∑ j : Fin (p + 4), ((-1 : ℤ) ^ (j : ℕ)) •
        G.map (wcCechFace V f θ j).op (g (fun l => θ (j.succAbove l))) = 0 := by
    intro θ
    apply hinj
    refine (hN ι (p + 2) g θ).trans ?_
    simp only [hg]
    exact hdd (p + 1) c' θ

  obtain ⟨b', hb'⟩ := hG (p + 1) g h3

  have hz : ∀ ρ : Fin (p + 3) → Fin k,
      ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        I.map (wcCechFace V f ρ j).op
          ((fun τ : Fin (p + 2) → Fin k =>
            c' τ - ι.app (Opposite.op (Limits.widePullback U (fun l => V (τ l))
              (fun l => f (τ l)))) (b' τ)) (fun l => ρ (j.succAbove l))) = 0 := by
    intro ρ
    refine (hS I (p + 1) c' (fun σ => ι.app _ (b' σ)) ρ).trans ?_
    have e := hN ι (p + 1) b' ρ
    rw [hb' ρ, hg ρ] at e
    rw [sub_eq_zero]
    exact e

  obtain ⟨a, ha⟩ := hI p (fun τ : Fin (p + 2) → Fin k =>
    c' τ - ι.app (Opposite.op (Limits.widePullback U (fun l => V (τ l))
      (fun l => f (τ l)))) (b' τ)) hz

  refine ⟨fun σ => π.app _ (a σ), fun τ => ?_⟩
  have e := hN π p a τ
  rw [ha τ] at e
  beta_reduce at e
  rw [map_sub, hcc τ, hzero, sub_zero] at e
  exact e.symm

theorem wc_cech_degree0_correction : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] {G I Q : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (ι : G ⟶ I) (π : I ⟶ Q), (∀ (W : C) (x : G.obj (Opposite.op W)), ι.app (Opposite.op W) x = 0 → x = 0) → (∀ (W : C) (y : I.obj (Opposite.op W)), π.app (Opposite.op W) y = 0 → ∃ x, ι.app (Opposite.op W) x = y) → (∀ (W : C) (x : G.obj (Opposite.op W)), π.app (Opposite.op W) (ι.app (Opposite.op W) x) = 0) → ∀ {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U), (∀ (p : ℕ) (b : ∀ σ : Fin (p + 1) → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (ρ : Fin (p + 3) → Fin k), ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) • I.map (wcCechFace V f ρ j).op (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) • I.map (wcCechFace V f (fun l => ρ (j.succAbove l)) i).op (b (fun l => ρ (j.succAbove (i.succAbove l))))) = 0) → wcCechAcyclic G V f → ∀ (q : Q.obj (Opposite.op U)) (s : ∀ σ : Fin 1 → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))), (∀ σ : Fin 1 → Fin k, π.app (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) (s σ) = Q.map (Limits.WidePullback.base (fun l => f (σ l))).op q) → ∃ w : ∀ σ : Fin 1 → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))), (∀ σ : Fin 1 → Fin k, π.app (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) (w σ) = Q.map (Limits.WidePullback.base (fun l => f (σ l))).op q) ∧ ∀ τ : Fin 2 → Fin k, ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) • I.map (wcCechFace V f τ j).op (w (fun l => τ (j.succAbove l))) = 0 :=
by
  intro C _ _ G I Q ι π hinj hex hzero U k V f hdd hG q s hs

  have hN : ∀ {F F' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ F') (p : ℕ)
      (b : ∀ σ : Fin (p + 1) → Fin k,
        F.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
      (τ : Fin (p + 2) → Fin k),
      α.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
        (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (b (fun l => τ (j.succAbove l)))) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        F'.map (wcCechFace V f τ j).op
          (α.app (Opposite.op (Limits.widePullback U (fun l => V (τ (j.succAbove l)))
            (fun l => f (τ (j.succAbove l))))) (b (fun l => τ (j.succAbove l)))) := by
    intro F F' α p b τ
    simp only [map_sum, map_zsmul, NatTrans.naturality_apply]

  have hS : ∀ (F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (p : ℕ)
      (x y : ∀ σ : Fin (p + 1) → Fin k,
        F.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
      (τ : Fin (p + 2) → Fin k),
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        F.map (wcCechFace V f τ j).op (x (fun l => τ (j.succAbove l)) - y (fun l => τ (j.succAbove l))) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (x (fun l => τ (j.succAbove l))) -
        ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (y (fun l => τ (j.succAbove l))) := by
    intro F p x y τ
    simp only [map_sub, smul_sub, Finset.sum_sub_distrib]

  have h3 : ∀ τ : Fin 2 → Fin k,
      π.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
        (∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) •
          I.map (wcCechFace V f τ j).op (s (fun l => τ (j.succAbove l)))) = 0 := by
    intro τ
    refine (hN π 0 s τ).trans ?_
    have key : ∀ j : Fin 2, Q.map (wcCechFace V f τ j).op
        (Q.map (Limits.WidePullback.base (fun l => f (τ (j.succAbove l)))).op q) =
        Q.map (Limits.WidePullback.base (fun l => f (τ l))).op q := by
      intro j
      have hfb : wcCechFace V f τ j ≫ Limits.WidePullback.base (fun l => f (τ (j.succAbove l))) =
          Limits.WidePullback.base (fun l => f (τ l)) := by
        unfold wcCechFace
        apply Limits.WidePullback.lift_base
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hfb]
    simp only [hs, key]
    simp

  choose g hg using fun τ : Fin 2 → Fin k => hex _ _ (h3 τ)

  have h4 : ∀ ρ : Fin 3 → Fin k,
      ∑ j : Fin 3, ((-1 : ℤ) ^ (j : ℕ)) •
        G.map (wcCechFace V f ρ j).op (g (fun l => ρ (j.succAbove l))) = 0 := by
    intro ρ
    apply hinj
    refine (hN ι 1 g ρ).trans ?_
    simp only [hg]
    exact hdd 0 s ρ

  obtain ⟨b, hb⟩ := hG 0 g h4

  refine ⟨fun σ => s σ - ι.app _ (b σ), fun σ => ?_, fun τ => ?_⟩
  · beta_reduce
    rw [map_sub, hs σ, hzero, sub_zero]
  · refine (hS I 0 s (fun σ => ι.app _ (b σ)) τ).trans ?_
    have e := hN ι 0 b τ
    rw [hb τ, hg τ] at e
    rw [sub_eq_zero]
    exact e

theorem wc_proet_ses_sectionwise : ∀ (Y : Scheme.{u}) {G I Q : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (ι : G ⟶ I) (π : I ⟶ Q) (w : ι ≫ π = 0), (ShortComplex.mk ι π w).ShortExact → (∀ (W : Y.ProEt) (x : G.obj.obj (Opposite.op W)), ι.hom.app (Opposite.op W) x = 0 → x = 0) ∧ (∀ (W : Y.ProEt) (y : I.obj.obj (Opposite.op W)), π.hom.app (Opposite.op W) y = 0 → ∃ x, ι.hom.app (Opposite.op W) x = y) ∧ (∀ (W : Y.ProEt) (x : G.obj.obj (Opposite.op W)), π.hom.app (Opposite.op W) (ι.hom.app (Opposite.op W) x) = 0) ∧ (∀ (W : Y.ProEt) (q : Q.obj.obj (Opposite.op W)), Presheaf.imageSieve π.hom q ∈ Scheme.ProEt.topology Y W) :=
by
  intro Y G I Q ι π w hS
  haveI := hS.mono_f
  haveI := hS.epi_g
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro W x hx
    have hinj : Function.Injective (ι.hom.app (Opposite.op W)) :=
      (AddCommGrpCat.mono_iff_injective (ι.hom.app (Opposite.op W))).mp
        (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⋙
          (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op W)) ι)
    exact hinj (hx.trans (map_zero _).symm)
  · intro W y hy
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op W)) hS.mono_f inferInstance
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
    exact ⟨x, hx⟩
  · intro W x
    have h := ConcreteCategory.congr_hom
      (congrArg (fun φ : G ⟶ Q => φ.hom.app (Opposite.op W)) w) x
    exact h
  · intro W q
    haveI : Sheaf.IsLocallySurjective π :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
    exact Presheaf.imageSieve_mem (Scheme.ProEt.topology Y) π.hom q

theorem wc_proet_sheaf_cech_glue : ∀ (Y : Scheme.{u}) (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) {U : Y.ProEt} {k : ℕ} (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology Y U → (∀ w : ∀ σ : Fin 1 → Fin k, F.obj.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))), (∀ τ : Fin 2 → Fin k, ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) • F.obj.map (wcCechFace V f τ j).op (w (fun l => τ (j.succAbove l))) = 0) → ∃ t : F.obj.obj (Opposite.op U), ∀ σ : Fin 1 → Fin k, F.obj.map (Limits.WidePullback.base (fun l => f (σ l))).op t = w σ) ∧ (∀ s s' : F.obj.obj (Opposite.op U), (∀ σ : Fin 1 → Fin k, F.obj.map (Limits.WidePullback.base (fun l => f (σ l))).op s = F.obj.map (Limits.WidePullback.base (fun l => f (σ l))).op s') → s = s') :=
by
  intro Y F U k V f hcov

  have hcomp : ∀ {A B D : Y.ProEt} (a : A ⟶ B) (b : B ⟶ D) (y : F.obj.obj (Opposite.op D)),
      F.obj.map a.op (F.obj.map b.op y) = F.obj.map (a ≫ b).op y := by
    intro A B D a b y
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  let ε : ∀ i, V i ⟶ Limits.widePullback U (fun _ : Fin 1 => V i) (fun _ => f i) :=
    fun i => Limits.WidePullback.lift (f i) (fun _ : Fin 1 => 𝟙 (V i))
      (fun _ => Category.id_comp _)

  have hA : ∀ (w : ∀ σ : Fin 1 → Fin k, F.obj.obj (Opposite.op
      (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (σ : Fin 1 → Fin k),
      w σ = F.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op
        (F.obj.map (ε (σ 0)).op (w (fun _ => σ 0))) := by
    intro w σ
    obtain ⟨i, rfl⟩ : ∃ i, σ = fun _ => i := ⟨σ 0, funext fun l => by rw [Fin.eq_zero l]⟩
    have hid : Limits.WidePullback.π (fun _ : Fin 1 => f i) 0 ≫ ε i = 𝟙 _ := by
      apply Limits.WidePullback.hom_ext
      · intro l
        rw [Category.assoc, Limits.WidePullback.lift_π, Category.comp_id, Category.id_comp,
          Subsingleton.elim l 0]
      · rw [Category.assoc, Limits.WidePullback.lift_base, Category.id_comp,
          Limits.WidePullback.π_arrow]
    beta_reduce
    rw [hcomp, hid, op_id, CategoryTheory.Functor.map_id]
    rfl

  have hface : ∀ (τ : Fin 2 → Fin k) (j : Fin 2),
      wcCechFace V f τ j ≫ Limits.WidePullback.π (fun l => f (τ (j.succAbove l))) 0 =
        Limits.WidePullback.π (fun l => f (τ l)) (j.succAbove 0) := by
    intro τ j
    exact Limits.WidePullback.lift_π _ _ _ _ 0

  have hB : ∀ (w : ∀ σ : Fin 1 → Fin k, F.obj.obj (Opposite.op
      (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
      (x : ∀ i, F.obj.obj (Opposite.op (V i))),
      (∀ σ : Fin 1 → Fin k, w σ = F.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op
        (x (σ 0))) →
      (∀ τ : Fin 2 → Fin k, ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) •
        F.obj.map (wcCechFace V f τ j).op (w (fun l => τ (j.succAbove l))) = 0) →
      ∀ (i j : Fin k) (Z : Y.ProEt) (gi : Z ⟶ V i) (gj : Z ⟶ V j), gi ≫ f i = gj ≫ f j →
        F.obj.map gi.op (x i) = F.obj.map gj.op (x j) := by
    intro w x hx hw
    have key : ∀ τ : Fin 2 → Fin k,
        F.obj.map (Limits.WidePullback.π (fun l => f (τ l)) 1).op (x (τ 1)) =
          F.obj.map (Limits.WidePullback.π (fun l => f (τ l)) 0).op (x (τ 0)) := by
      intro τ
      have h := hw τ
      rw [Fin.sum_univ_two, hx (fun l => τ (Fin.succAbove 0 l)),
        hx (fun l => τ (Fin.succAbove 1 l)), hcomp, hcomp, hface, hface] at h
      simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_zsmul, neg_one_zsmul] at h
      have h' : F.obj.map (Limits.WidePullback.π (fun l => f (τ l)) 1).op (x (τ 1)) +
          -F.obj.map (Limits.WidePullback.π (fun l => f (τ l)) 0).op (x (τ 0)) = 0 := h
      exact add_neg_eq_zero.mp h'
    intro i j Z gi gj h
    let τ : Fin 2 → Fin k := Fin.cons i (fun _ : Fin 1 => j)
    let m : Z ⟶ Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)) :=
      Limits.WidePullback.lift (gi ≫ f i)
        (Fin.cons gi (fun _ : Fin 1 => gj) : ∀ l : Fin 2, Z ⟶ V (τ l))
        (fun l => Fin.cases rfl (fun _ => h.symm) l)
    have e0 : m ≫ Limits.WidePullback.π (fun l => f (τ l)) 0 = gi :=
      Limits.WidePullback.lift_π _ _ _ _ 0
    have e1 : m ≫ Limits.WidePullback.π (fun l => f (τ l)) 1 = gj :=
      Limits.WidePullback.lift_π _ _ _ _ 1
    have hm := congrArg (fun y => F.obj.map m.op y) (key τ)
    simp only at hm
    rw [hcomp, hcomp, e0, e1] at hm
    exact hm.symm

  have hP : Presieve.IsSheaf (Scheme.ProEt.topology Y)
      ((sheafCompose (Scheme.ProEt.topology Y) (forget AddCommGrpCat.{u+1})).obj F).obj :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.ProEt.topology Y) (forget AddCommGrpCat.{u+1})).obj F).2
  have hsf := (Presieve.isSheafFor_arrows_iff
    ((sheafCompose (Scheme.ProEt.topology Y) (forget AddCommGrpCat.{u+1})).obj F).obj f).mp
      (hP.isSheafFor _ hcov)
  refine ⟨fun w hw => ?_, fun s s' hss => ?_⟩
  · let x : ∀ i, F.obj.obj (Opposite.op (V i)) := fun i => F.obj.map (ε i).op (w (fun _ => i))
    have hx : ∀ σ : Fin 1 → Fin k, w σ = F.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op
        (x (σ 0)) := fun σ => hA w σ
    obtain ⟨t, ht, -⟩ := hsf x (fun i j Z gi gj h => hB w x hx hw i j Z gi gj h)
    obtain ⟨t', ht'⟩ : ∃ t' : F.obj.obj (Opposite.op U), ∀ i, F.obj.map (f i).op t' = x i :=
      ⟨t, ht⟩
    refine ⟨t', fun σ => ?_⟩
    rw [← Limits.WidePullback.π_arrow (fun l => f (σ l)) 0, ← hcomp, ht' (σ 0)]
    exact (hx σ).symm
  · apply (hP.isSheafFor _ hcov).isSeparatedFor.ext
    intro Z g hg
    rcases hg with ⟨i⟩
    show F.obj.map (f i).op s = F.obj.map (f i).op s'
    have e : f i = ε i ≫ Limits.WidePullback.base (fun _ : Fin 1 => f i) :=
      (Limits.WidePullback.lift_base _ _ _ _).symm
    rw [e, ← hcomp, ← hcomp]
    exact congrArg (F.obj.map (ε i).op) (hss (fun _ => i))

theorem proet_free_sheaf_hom_equiv : ∀ (S : Scheme.{u}) (U : S.ProEt),
    ∃ e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U),
    (∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
      (g : wcFreeSheaf S U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g)) ∧
    (∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}, e F 0 = 0) :=
by
  intro S U
  let e2 : ∀ G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1},
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op U) :=
    fun G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
        (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
  have hnat2 : ∀ (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
      (h : yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
      e2 G' (h ≫ ψ) = ψ.app (Opposite.op U) (e2 G h) := by
    intro G G' ψ h
    have hW := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
      (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u}) h ψ
    have hY := uliftYonedaEquiv_comp.{u+1}
      ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G h)
      (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
          (forget AddCommGrpCat.{u+1})).map ψ)
    exact (congrArg (uliftYonedaEquiv.{u+1} (X := U) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
  let e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun F =>
    ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj)
  have hnat : ∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
      (g : wcFreeSheaf S U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g) := by
    intro F F' φ g
    have hA := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_right
      (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
    exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
  refine ⟨e, hnat, fun F => ?_⟩
  have h1 := hnat F F 0 0
  rw [Limits.zero_comp] at h1
  rw [h1]
  have h0 : (0 : F ⟶ F).hom = 0 :=
    (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero F F
  rw [h0, NatTrans.app_zero]
  rfl

theorem wc_cech_criterion_ext_vanishing : ∀ (Y : Scheme.{u}) (B : Y.ProEt → Prop) (Cov : ∀ (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt), (∀ i, V i ⟶ U) → Prop), (∀ U k V f, Cov U k V f → Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology Y U) → (∀ U k V f, Cov U k V f → ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), B (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) → (∀ U, B U → ∀ R ∈ Scheme.ProEt.topology Y U, ∃ (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), Cov U k V f ∧ ∀ i, R.arrows (f i)) → (∀ (I : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) [Injective I], ∀ U k V f, Cov U k V f → wcCechAcyclic I.obj V f) → ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}), (∀ U k V f, Cov U k V f → wcCechAcyclic G.obj V f) → ∀ U, B U → ∀ (n : ℕ) (e : Abelian.Ext (wcFreeSheaf Y U) G (n + 1)), e = 0 :=
by
  intro Y B Cov H1 H2 H3 H4

  have hsurj : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      (∀ U k V f, Cov U k V f → wcCechAcyclic G.obj V f) →
      (∀ W, B W → Function.Surjective
        ((Limits.cokernel.π (Injective.ι G)).hom.app (Opposite.op W))) ∧
      (∀ U k V f, Cov U k V f → wcCechAcyclic (Limits.cokernel (Injective.ι G)).obj V f) := by
    intro G hG
    have hS : (ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    obtain ⟨hinj, hex, hzero, hloc⟩ := wc_proet_ses_sectionwise Y (Injective.ι G)
      (Limits.cokernel.π (Injective.ι G)) (Limits.cokernel.condition _) hS
    have hb : ∀ W, B W → Function.Surjective
        ((Limits.cokernel.π (Injective.ι G)).hom.app (Opposite.op W)) := by
      intro W hW q
      obtain ⟨k, V, f, hc, hRf⟩ := H3 W hW _ (hloc W q)
      have hs : ∀ σ : Fin 1 → Fin k, ∃ t, (Limits.cokernel.π (Injective.ι G)).hom.app
          (Opposite.op (Limits.widePullback W (fun l => V (σ l)) (fun l => f (σ l)))) t =
          (Limits.cokernel (Injective.ι G)).obj.map
            (Limits.WidePullback.base (fun l => f (σ l))).op q := by
        intro σ
        have h' : (Presheaf.imageSieve (Limits.cokernel.π (Injective.ι G)).hom q).arrows
            (Limits.WidePullback.base (fun l => f (σ l))) := by
          rw [← Limits.WidePullback.π_arrow (fun l => f (σ l)) 0]
          exact (Presheaf.imageSieve (Limits.cokernel.π (Injective.ι G)).hom q).downward_closed
            (hRf (σ 0)) _
        exact h'
      choose s hs using hs
      obtain ⟨w, hw1, hw2⟩ := wc_cech_degree0_correction (Injective.ι G).hom
        (Limits.cokernel.π (Injective.ι G)).hom hinj hex hzero V f
        (wc_cech_dd_zero (Injective.under G).obj V f) (hG W k V f hc) q s hs
      obtain ⟨t, ht⟩ := (wc_proet_sheaf_cech_glue Y (Injective.under G) V f (H1 _ _ _ _ hc)).1 w hw2
      refine ⟨t, (wc_proet_sheaf_cech_glue Y (Limits.cokernel (Injective.ι G)) V f
        (H1 _ _ _ _ hc)).2 _ _ (fun σ => ?_)⟩
      rw [← NatTrans.naturality_apply, ht σ, hw1 σ]
    refine ⟨hb, fun U' k V f hcov => ?_⟩
    exact wc_cech_acyclic_quotient (Injective.ι G).hom (Limits.cokernel.π (Injective.ι G)).hom
      hinj hex hzero V f (fun p σ => hb _ (H2 U' k V f hcov p σ))
      (wc_cech_dd_zero (Injective.under G).obj V f) (hG U' k V f hcov)
      (H4 (Injective.under G) U' k V f hcov)

  have key : ∀ (n : ℕ) (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      (∀ U k V f, Cov U k V f → wcCechAcyclic G.obj V f) → ∀ U, B U →
      ∀ (e : Abelian.Ext (wcFreeSheaf Y U) G (n + 1)), e = 0 := by
    intro n
    induction n with
    | zero =>
      intro G hG U hU e
      obtain ⟨hb, -⟩ := hsurj G hG
      have hS : (ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
          (Limits.cokernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf Y U) hS e
        (Abelian.Ext.eq_zero_of_injective (e.comp (Abelian.Ext.mk₀ (Injective.ι G)) (add_zero _)))
        (n₀ := 0) rfl
      obtain ⟨eq, heq₁, -⟩ := proet_free_sheaf_hom_equiv Y U
      obtain ⟨y, hy⟩ := hb U hU (eq (Limits.cokernel (Injective.ι G)) (Abelian.Ext.homEquiv₀ x₃))
      have hh : (eq (Injective.under G)).symm y ≫ Limits.cokernel.π (Injective.ι G) =
          Abelian.Ext.homEquiv₀ x₃ := by
        apply (eq (Limits.cokernel (Injective.ι G))).injective
        rw [heq₁, Equiv.apply_symm_apply, hy]
      rw [← hx₃, ← Abelian.Ext.mk₀_homEquiv₀_apply x₃, ← hh, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
        show (Abelian.Ext.mk₀ (Limits.cokernel.π (Injective.ι G))).comp hS.extClass (zero_add 1)
          = 0 from hS.comp_extClass, Abelian.Ext.comp_zero]
    | succ n ih =>
      intro G hG U hU e
      obtain ⟨-, hQ⟩ := hsurj G hG
      have hS : (ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
          (Limits.cokernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf Y U) hS e
        (Abelian.Ext.eq_zero_of_injective (e.comp (Abelian.Ext.mk₀ (Injective.ι G)) (add_zero _)))
        (n₀ := n + 1) rfl
      rw [← hx₃, ih _ hQ U hU x₃, Abelian.Ext.zero_comp]
  intro G H5 U hU n e
  exact key n G H5 U hU e

theorem wc_injective_cech_acyclic : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] (I : Sheaf J AddCommGrpCat.{u+1}) [Injective I] {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U), wcCechH0 I.obj V f ∧ wcCechAcyclic I.obj V f :=
by
  classical
  intro C _ _ J _ I _ U k V f
  haveI hG : Injective I.obj :=
    Injective.injective_of_adjoint (sheafificationAdjunction J AddCommGrpCat.{u+1}) I
  have mapc : ∀ {A B Z : C} (a : Z ⟶ B) (b : B ⟶ A) (x : I.obj.obj (Opposite.op A)),
      I.obj.map (a ≫ b).op x = I.obj.map a.op (I.obj.map b.op x) := by
    intro A B Z a b x
    rw [op_comp, Functor.map_comp]
    rfl
  have mapid : ∀ (A : C) (x : I.obj.obj (Opposite.op A)), I.obj.map (𝟙 A).op x = x := by
    intro A x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have hext : ∀ {K' K : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (D : K' ⟶ K) (Φ : K' ⟶ I.obj),
      (∀ (Z : Cᵒᵖ) (y : K'.obj Z), D.app Z y = 0 → Φ.app Z y = 0) →
      ∃ ψ : K ⟶ I.obj, D ≫ ψ = Φ := by
    intro K' K D Φ h
    have h0 : Limits.kernel.ι D ≫ Φ = 0 := by
      apply NatTrans.ext
      funext Z
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      have hx : D.app Z ((Limits.kernel.ι D).app Z x) = 0 := by
        have := congrArg (fun φ : Limits.kernel D ⟶ K => (φ.app Z) x) (Limits.kernel.condition D)
        simp only [NatTrans.comp_app, ConcreteCategory.comp_apply] at this
        rw [this]
        simp
      simpa using h Z _ hx
    exact ⟨(ShortComplex.exact_kernel D).descToInjective Φ h0,
      (ShortComplex.exact_kernel D).comp_descToInjective Φ h0⟩

  have choose_congr : ∀ {A B : Type (u+1)} (α : A → B) (b b' : B) (h : ∃ a, α a = b)
      (h' : ∃ a, α a = b'), b = b' → Classical.choose h = Classical.choose h' := by
    intro A B α b b' h h' e
    subst e
    rfl
  have face_cons_zero : ∀ {A B : Type (u+1)} (α : A → B) {q : ℕ} (t : wcFT α q),
      wcFTFace α (wcFTCons α t) 0 = t := by
    intro A B α q t
    apply Subtype.ext
    funext l
    simp [wcFTFace, wcFTCons]
  have face_cons_succ : ∀ {A B : Type (u+1)} (α : A → B) {q : ℕ} (t : wcFT α (q + 1))
      (j : Fin (q + 2)), wcFTFace α (wcFTCons α t) j.succ = wcFTCons α (wcFTFace α t j) := by
    intro A B α q t j
    apply Subtype.ext
    funext l
    induction l using Fin.cases with
    | zero =>
      simp only [wcFTFace, wcFTCons, Function.comp_apply, Fin.succ_succAbove_zero, Fin.cons_zero]
      exact choose_congr α _ _ _ _ (t.2 (j.succAbove 0)).symm
    | succ m =>
      simp only [wcFTFace, wcFTCons, Function.comp_apply, Fin.succ_succAbove_succ, Fin.cons_succ]
  have T_high : ∀ {A B : Type (u+1)} (α : A → B) (p : ℕ) {M : Type (u+1)} [AddCommGroup M]
      (Φ : FreeAbelianGroup (wcFT α (p + 1)) →+ M),
      (∀ ρ, Φ (wcFTd α (p + 1) (FreeAbelianGroup.of ρ)) = 0) →
      ∀ (y : FreeAbelianGroup (wcFT α (p + 1))), wcFTd α p y = 0 → Φ y = 0 := by
    intro A B α p M _ Φ hΦ y hy
    have key : ((wcFTd α (p + 1)).comp (FreeAbelianGroup.map (wcFTCons α (q := p + 1)))) +
        ((FreeAbelianGroup.map (wcFTCons α (q := p))).comp (wcFTd α p)) = AddMonoidHom.id _ := by
      apply FreeAbelianGroup.lift_ext
      intro t
      simp only [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.id_apply,
        FreeAbelianGroup.map_of_apply, wcFTd, FreeAbelianGroup.lift_apply_of, map_sum, map_zsmul]
      rw [Fin.sum_univ_succ, face_cons_zero]
      simp only [face_cons_succ, Fin.val_zero, pow_zero, one_smul, Fin.val_succ, pow_succ]
      rw [add_assoc, ← Finset.sum_add_distrib, Finset.sum_eq_zero, add_zero]
      intro j _
      rw [mul_neg_one, neg_smul, neg_add_cancel]
    have hzero : Φ.comp (wcFTd α (p + 1)) = 0 :=
      FreeAbelianGroup.lift_ext _ _ (fun ρ => by rw [AddMonoidHom.comp_apply, hΦ]; rfl)
    have e1 := congrArg (fun φ => φ y) key
    simp only [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.id_apply, hy,
      map_zero, add_zero] at e1
    rw [← e1]
    exact congrArg (fun φ => φ (FreeAbelianGroup.map (wcFTCons α (q := p + 1)) y)) hzero
  have T_aug : ∀ {A B : Type (u+1)} (α : A → B) {M : Type (u+1)} [AddCommGroup M]
      (Φ : FreeAbelianGroup (wcFT α 0) →+ M),
      (∀ ρ, Φ (wcFTd α 0 (FreeAbelianGroup.of ρ)) = 0) →
      ∀ (y : FreeAbelianGroup (wcFT α 0)),
        FreeAbelianGroup.map (fun t : wcFT α 0 => α (t.1 0)) y = 0 → Φ y = 0 := by
    intro A B α M _ Φ hΦ y hy
    let r : B → FreeAbelianGroup (wcFT α 0) := fun b =>
      if h : ∃ a, α a = b then FreeAbelianGroup.of ⟨fun _ => Classical.choose h, fun _ => rfl⟩
      else 0
    have key : ((wcFTd α 0).comp (FreeAbelianGroup.map (wcFTCons α (q := 0)))) +
        ((FreeAbelianGroup.lift r).comp (FreeAbelianGroup.map (fun t : wcFT α 0 => α (t.1 0)))) =
          AddMonoidHom.id _ := by
      apply FreeAbelianGroup.lift_ext
      intro t
      have h1 : r (α (t.1 0)) =
          FreeAbelianGroup.of (wcFTFace α (wcFTCons α t) (Fin.succ 0)) := by
        simp only [r]
        rw [dif_pos ⟨t.1 0, rfl⟩]
        congr 1
        apply Subtype.ext
        funext l
        have hl : l = 0 := Fin.fin_one_eq_zero l
        subst hl
        rfl
      simp only [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.id_apply,
        FreeAbelianGroup.map_of_apply, wcFTd, FreeAbelianGroup.lift_apply_of]
      rw [h1, Fin.sum_univ_succ, Fin.sum_univ_succ, Fin.sum_univ_zero, face_cons_zero]
      simp only [Fin.val_zero, Fin.val_succ, pow_zero, zero_add, pow_one, one_smul, neg_smul,
        add_zero]
      abel
    have hzero : Φ.comp (wcFTd α 0) = 0 :=
      FreeAbelianGroup.lift_ext _ _ (fun ρ => by rw [AddMonoidHom.comp_apply, hΦ]; rfl)
    have e1 := congrArg (fun φ => φ y) key
    simp only [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.id_apply, hy,
      map_zero, add_zero] at e1
    rw [← e1]
    exact congrArg (fun φ => φ (FreeAbelianGroup.map (wcFTCons α (q := 0)) y)) hzero

  have I1 : ∀ {q : ℕ} {Z Z' : Cᵒᵖ} (g : Z ⟶ Z') (t : wcFT (wcFTα V f Z) q),
      wcFTLift V f (wcFTRestr V f g t) = g.unop ≫ wcFTLift V f t := by
    intro q Z Z' g t
    apply Limits.WidePullback.hom_ext
    · intro l
      erw [Limits.WidePullback.lift_π, Category.assoc, Limits.WidePullback.lift_π]
      rfl
    · erw [Limits.WidePullback.lift_base, Category.assoc g.unop (wcFTLift V f t),
        Limits.WidePullback.lift_base]
      (try exact Category.assoc _ _ _)
  have I2 : ∀ {q : ℕ} {Z : Cᵒᵖ} (ρ : wcFT (wcFTα V f Z) (q + 1)) (j : Fin (q + 2)),
      wcFTLift V f (wcFTFace (wcFTα V f Z) ρ j) =
        wcFTLift V f ρ ≫ wcCechFace V f (fun l => (ρ.1 l).down.1) j := by
    intro q Z ρ j
    apply Limits.WidePullback.hom_ext
    · intro l
      erw [Limits.WidePullback.lift_π, Category.assoc, wcCechFace, Limits.WidePullback.lift_π,
        Limits.WidePullback.lift_π]
      rfl
    · erw [Limits.WidePullback.lift_base, Category.assoc, wcCechFace,
        Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
      exact congrArg ULift.down (ρ.2 (j.succAbove 0))
  have I3 : ∀ {q : ℕ} (σ : Fin (q + 1) → Fin k), wcFTLift V f (wcFTTaut V f σ) = 𝟙 _ := by
    intro q σ
    apply Limits.WidePullback.hom_ext
    · intro l
      erw [Limits.WidePullback.lift_π, Category.id_comp]
      rfl
    · erw [Limits.WidePullback.lift_base, Category.id_comp]
      exact Limits.WidePullback.π_arrow _ _
  have I4 : ∀ {p : ℕ} (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)),
      wcFTRestr V f (wcCechFace V f τ j).op (wcFTTaut V f (fun l => τ (j.succAbove l))) =
        wcFTFace _ (wcFTTaut V f τ) j := by
    intro p τ j
    apply Subtype.ext
    funext l
    simp only [wcFTRestr, wcFTTaut, wcFTFace, wcCechFace, Function.comp_apply]
    erw [Limits.WidePullback.lift_π]
  refine ⟨?_, ?_⟩
  ·
    intro x hx
    let Φ0 : wcFTK V f 0 ⟶ I.obj :=
      { app := fun Z => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun t : wcFT (wcFTα V f Z) 0 => I.obj.map (t.1 0).down.2.op (x (t.1 0).down.1)))
        naturality := by
          intro Z Z' g
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro t
          change FreeAbelianGroup.lift _
              (FreeAbelianGroup.map (wcFTRestr V f g) (FreeAbelianGroup.of t)) =
            I.obj.map g (FreeAbelianGroup.lift _ (FreeAbelianGroup.of t))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          change I.obj.map (g.unop ≫ (t.1 0).down.2).op (x (t.1 0).down.1) = _
          rw [op_comp, Functor.map_comp]
          rfl }
    obtain ⟨ψ, hψ⟩ := hext (wcFTE V f) Φ0 (by
      intro Z y hy
      refine T_aug (wcFTα V f Z) (Φ0.app Z).hom (fun ρ => ?_) y hy
      let σ : Fin 2 → Fin k := fun l => (ρ.1 l).down.1
      let y : Fin 2 → I.obj.obj (Opposite.op
          (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) :=
        fun l => I.obj.map (Limits.WidePullback.π (fun l => f (σ l)) l).op (x (σ l))
      have hy : ∀ l, y l = y 0 := by
        intro l
        fin_cases l
        · rfl
        · exact (hx σ).symm
      have hL : ∀ l, wcFTLift V f ρ ≫ Limits.WidePullback.π (fun l => f (σ l)) l =
          (ρ.1 l).down.2 := by
        intro l
        unfold wcFTLift
        erw [Limits.WidePullback.lift_π]
        (try rfl)
      have e : ∀ l, I.obj.map (ρ.1 l).down.2.op (x (ρ.1 l).down.1) =
          I.obj.map (wcFTLift V f ρ).op (y l) := by
        intro l
        rw [← hL l, op_comp, Functor.map_comp]
        rfl
      have hsum : (Φ0.app Z).hom (wcFTd (wcFTα V f Z) 0 (FreeAbelianGroup.of ρ)) =
          ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) • I.obj.map (wcFTLift V f ρ).op (y 0) := by
        change FreeAbelianGroup.lift _ (FreeAbelianGroup.lift _ (FreeAbelianGroup.of ρ)) = _
        rw [FreeAbelianGroup.lift_apply_of, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_zsmul, FreeAbelianGroup.lift_apply_of, ← hy (j.succAbove 0)]
        exact congrArg (fun z => ((-1 : ℤ) ^ (j : ℕ)) • z) (e (j.succAbove 0))
      refine hsum.trans ?_
      simp [Fin.sum_univ_succ])
    have hψpt : ∀ (Z : Cᵒᵖ) (t : wcFT (wcFTα V f Z) 0),
        ψ.app Z (FreeAbelianGroup.of (wcFTα V f Z (t.1 0))) = Φ0.app Z (FreeAbelianGroup.of t) := by
      intro Z t
      rw [← hψ]
      rfl
    refine ⟨ψ.app (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U))), fun i => ?_⟩
    have nat' : ψ.app (Opposite.op (V i)) (FreeAbelianGroup.of (ULift.up (f i))) =
        I.obj.map (f i).op (ψ.app (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U)))) := by
      have := NatTrans.naturality_apply ψ (f i).op (FreeAbelianGroup.of (ULift.up (𝟙 U)))
      rw [← this]
      congr 1
      change FreeAbelianGroup.of _ = FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      rw [FreeAbelianGroup.map_of_apply]
      simp
    have h2 := hψpt (Opposite.op (V i)) ⟨fun _ => ULift.up ⟨i, 𝟙 (V i)⟩, fun _ => rfl⟩
    have h3 : Φ0.app (Opposite.op (V i))
        (FreeAbelianGroup.of ⟨fun _ => ULift.up ⟨i, 𝟙 (V i)⟩, fun _ => rfl⟩) = x i := by
      change FreeAbelianGroup.lift _ (FreeAbelianGroup.of _) = x i
      rw [FreeAbelianGroup.lift_apply_of]
      change I.obj.map (𝟙 (V i)).op (x i) = x i
      simp
    have h4 : wcFTα V f (Opposite.op (V i))
        ((⟨fun _ => ULift.up ⟨i, 𝟙 (V i)⟩, fun _ => rfl⟩ :
          wcFT (wcFTα V f (Opposite.op (V i))) 0).1 0) = ULift.up (f i) := by
      simp [wcFTα]
    rw [h4] at h2
    rw [← nat', h2, h3]
  ·
    intro p c hc
    let Φ : wcFTK V f (p + 1) ⟶ I.obj :=
      { app := fun Z => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun t : wcFT (wcFTα V f Z) (p + 1) =>
              I.obj.map (wcFTLift V f t).op (c (fun l => (t.1 l).down.1))))
        naturality := by
          intro Z Z' g
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro t
          change FreeAbelianGroup.lift _
              (FreeAbelianGroup.map (wcFTRestr V f g) (FreeAbelianGroup.of t)) =
            I.obj.map g (FreeAbelianGroup.lift _ (FreeAbelianGroup.of t))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          change I.obj.map (wcFTLift V f (wcFTRestr V f g t)).op
            (c (fun l => (t.1 l).down.1)) = _
          rw [I1 g t]
          exact mapc _ _ _ }
    obtain ⟨ψ, hψ⟩ := hext (wcFTD V f p) Φ (by
      intro Z y hy
      refine T_high (wcFTα V f Z) p (Φ.app Z).hom (fun ρ => ?_) y hy
      have key := congrArg (I.obj.map (wcFTLift V f ρ).op) (hc (fun l => (ρ.1 l).down.1))
      rw [map_zero, map_sum] at key
      change FreeAbelianGroup.lift _ (FreeAbelianGroup.lift _ (FreeAbelianGroup.of ρ)) = 0
      rw [FreeAbelianGroup.lift_apply_of, map_sum]
      refine Eq.trans (Finset.sum_congr rfl (fun j _ => ?_)) key
      rw [map_zsmul, map_zsmul, FreeAbelianGroup.lift_apply_of]
      congr 1
      change I.obj.map (wcFTLift V f (wcFTFace (wcFTα V f Z) ρ j)).op
        (c (fun l => (ρ.1 (j.succAbove l)).down.1)) = _
      rw [I2 ρ j]
      exact mapc _ _ _)
    refine ⟨fun σ => ψ.app (Opposite.op
      (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))
        (FreeAbelianGroup.of (wcFTTaut V f σ)), fun τ => ?_⟩
    have hnat : ∀ j : Fin (p + 2), I.obj.map (wcCechFace V f τ j).op
        (ψ.app (Opposite.op (Limits.widePullback U (fun l => V (τ (j.succAbove l)))
          (fun l => f (τ (j.succAbove l)))))
          (FreeAbelianGroup.of (wcFTTaut V f (fun l => τ (j.succAbove l))))) =
        ψ.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
          (FreeAbelianGroup.of (wcFTFace _ (wcFTTaut V f τ) j)) := by
      intro j
      have := NatTrans.naturality_apply ψ (wcCechFace V f τ j).op
        (FreeAbelianGroup.of (wcFTTaut V f (fun l => τ (j.succAbove l))))
      rw [← this]
      congr 1
      rw [← I4 τ j]
      exact FreeAbelianGroup.map_of_apply _
    calc ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • I.obj.map (wcCechFace V f τ j).op
          (ψ.app (Opposite.op (Limits.widePullback U (fun l => V (τ (j.succAbove l)))
            (fun l => f (τ (j.succAbove l)))))
            (FreeAbelianGroup.of (wcFTTaut V f (fun l => τ (j.succAbove l)))))
        = ψ.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
            (wcFTd _ p (FreeAbelianGroup.of (wcFTTaut V f τ))) := by
          rw [wcFTd, FreeAbelianGroup.lift_apply_of]
          erw [map_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [hnat j]
          exact (map_zsmul (ψ.app _).hom _ _).symm
      _ = Φ.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
            (FreeAbelianGroup.of (wcFTTaut V f τ)) := by
          rw [← hψ]
          rfl
      _ = c τ := by
          change FreeAbelianGroup.lift _ (FreeAbelianGroup.of (wcFTTaut V f τ)) = c τ
          rw [FreeAbelianGroup.lift_apply_of]
          change I.obj.map (wcFTLift V f (wcFTTaut V f τ)).op (c τ) = c τ
          rw [I3]
          exact mapid _ _

theorem proet_qcqs_finite_affine_refinement : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left]
    [QuasiSeparatedSpace U.left]
    (R : Sieve U), R ∈ Scheme.ProEt.topology S U →
    ∃ (k : ℕ) (V : Fin k → S.ProEt) (f : ∀ j, V j ⟶ U), (∀ j, R.arrows (f j)) ∧
      (∀ j, IsAffine (V j).left) ∧
      Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology S U :=
by
  intro S U _ _ R hR
  have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ U.left),
      (Sieve.overEquiv ((Scheme.ProEt.forget S).obj U)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows g →
      ∃ (W : S.ProEt) (f : W ⟶ U) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
    intro Z g hg
    have hg' := (Sieve.overEquiv_iff _ g).mp hg
    obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
    refine ⟨W, φ, ψ.left, hφ, ?_⟩
    have := congrArg CommaMorphism.left heq
    simp only [Over.homMk_left, Over.comp_left] at this
    exact this
  have hS : Sieve.overEquiv ((Scheme.ProEt.forget S).obj U)
      (Sieve.functorPushforward (Scheme.ProEt.forget S) R) ∈ Scheme.proetaleTopology U.left :=
    (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
      (Scheme.ProEt.forget S) (Scheme.ProEt.topology S) (Scheme.proetaleTopology.over S)).cover_preserve hR)
  obtain ⟨R', hR', hle⟩ :=
    (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition (J := Scheme.proetalePrecoverage)).mp hS
  obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
  haveI := h𝒰
  have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget S).obj U)
      (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows (𝒰.f j) := by
    intro j
    apply hle
    rw [hR'eq]
    exact Presieve.ofArrows.mk j
  choose W f e hf he using fun j => fact (𝒰.f j) (hmem j)
  have hcpt : IsCompact ((⊤ : U.left.Opens) : Set U.left) := by
    rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
  obtain ⟨n, c, V, hV, hUeq⟩ :=
    QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hcpt
  have hwe : ∀ i, WeaklyEtale ((V i).ι ≫ 𝒰.f (c i)) := fun i => by
    haveI := Scheme.Cover.map_prop 𝒰 (c i)
    infer_instance
  have hwe' : ∀ i, WeaklyEtale (((V i).ι ≫ 𝒰.f (c i)) ≫ U.hom) := fun i => by
    haveI := hwe i
    haveI := U.prop
    infer_instance
  let Vo : Fin n → S.ProEt := fun i =>
    MorphismProperty.Over.mk ⊤ (((V i).ι ≫ 𝒰.f (c i)) ≫ U.hom) (hwe' i)
  let fo : ∀ i, Vo i ⟶ U := fun i =>
    MorphismProperty.Over.homMk ((V i).ι ≫ 𝒰.f (c i)) rfl trivial
  have hq : ∀ i, QuasiCompact ((V i).ι ≫ 𝒰.f (c i)) := fun i => by
    haveI : IsAffine (V i).toScheme := hV i
    exact quasiCompact_of_compactSpace _
  have hs : ∀ x : U.left, ∃ j y, ((V j).ι ≫ 𝒰.f (c j)) y = x := by
    intro x
    have hx : x ∈ ((⊤ : U.left.Opens) : Set U.left) := trivial
    rw [← hUeq] at hx
    obtain ⟨i, z, hz, hzx⟩ := Set.mem_iUnion.mp hx
    refine ⟨i, ⟨z, hz⟩, ?_⟩
    refine (Scheme.Hom.comp_apply (V i).ι (𝒰.f (c i)) ⟨z, hz⟩).trans ?_
    rw [Scheme.Opens.ι_apply]
    exact hzx
  have H : Presieve.ofArrows (fun i => (V i).toScheme) (fun i => (V i).ι ≫ 𝒰.f (c i)) ∈
      Scheme.proetalePrecoverage.coverings U.left :=
    ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
      (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) _ _ hs (fun _ => trivial)) _ hq
        (inferInstanceAs (Finite (Fin n)))),
      (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
        ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hwe⟩⟩
  have H' : Presieve.ofArrows (fun i => (Vo i).left) (fun i => (fo i).left) ∈
      Scheme.proetalePrecoverage.coverings U.left := H
  refine ⟨n, Vo, fo, fun i => ?_, fun i => hV i, ?_⟩
  · have hk : ((V i).ι ≫ e (c i)) ≫ (W (c i)).hom = (Vo i).hom := by
      change _ = ((V i).ι ≫ 𝒰.f (c i)) ≫ U.hom
      rw [he (c i)]
      simp only [Category.assoc]
      rw [MorphismProperty.Over.w (f (c i))]
    let k : Vo i ⟶ W (c i) := MorphismProperty.Over.homMk ((V i).ι ≫ e (c i)) hk trivial
    have hkf : k ≫ f (c i) = fo i := by
      apply MorphismProperty.Over.Hom.ext
      change ((V i).ι ≫ e (c i)) ≫ (f (c i)).left = (V i).ι ≫ 𝒰.f (c i)
      rw [he (c i), Category.assoc]
    rw [← hkf]
    exact R.downward_closed (hf (c i)) k
  · exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H'))

theorem proet_finite_affine_jointly_surjective_covers : ∀ (S : Scheme.{u}) (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) → (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) → Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U :=
by
  intro S U _ n W h hA hJ
  have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
    intro x
    obtain ⟨j, y, hy⟩ := hJ x
    exact ⟨j, y, hy⟩
  have hq : ∀ i, QuasiCompact (h i).left := fun i => by
    haveI := hA i
    exact quasiCompact_of_compactSpace _
  have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
    have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
      rw [MorphismProperty.Over.w (h i)]
      exact (W i).prop
    haveI := U.prop
    exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
  have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
      Scheme.proetalePrecoverage.coverings U.left :=
    ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
      (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
        hs (fun _ => trivial)) _ hq
        (inferInstanceAs (Finite (Fin n)))),
      (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
        ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
  exact Precoverage.generate_mem_toGrothendieck
    (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

theorem wc_indEtale_weaklyEtale : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S), wcIndEtale φ → @Algebra.WeaklyEtale R S _ _ φ.toAlgebra :=
by
  intro R S _ _ φ hφ
  letI : Algebra R S := φ.toAlgebra
  have hφ' : ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
      (h : P →ₐ[R] S), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
        ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] S), β.comp α = h := hφ

  have hL : ∀ (ι : Type) [Fintype ι] (ρ : MvPolynomial ι R) (a : ι → S),
      MvPolynomial.aeval a ρ = 0 →
      ∃ (E₀ : Type u) (_ : CommRing E₀) (_ : Algebra R E₀), Algebra.Etale R E₀ ∧
        ∃ (β₀ : E₀ →ₐ[R] S) (a₀ : ι → E₀), (∀ i, β₀ (a₀ i) = a i) ∧
          MvPolynomial.aeval a₀ ρ = 0 := by
    intro ι _ ρ a ha
    let I : Ideal (MvPolynomial ι R) := Ideal.span {ρ}
    haveI : Algebra.FinitePresentation R (MvPolynomial ι R ⧸ I) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton ρ)
    have hI : ∀ p ∈ I, MvPolynomial.aeval a p = 0 := by
      intro p hp
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, ha, mul_zero]
    let h : (MvPolynomial ι R ⧸ I) →ₐ[R] S := Ideal.Quotient.liftₐ I (MvPolynomial.aeval a) hI
    obtain ⟨E₀, _, _, hE, α, β₀, hαβ⟩ := hφ' _ h
    have hcomp : α.comp (Ideal.Quotient.mkₐ R I) =
        MvPolynomial.aeval (fun i => α (Ideal.Quotient.mkₐ R I (MvPolynomial.X i))) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp
    refine ⟨E₀, inferInstance, inferInstance, hE, β₀,
      fun i => α (Ideal.Quotient.mkₐ R I (MvPolynomial.X i)), fun i => ?_, ?_⟩
    · have := congrArg (fun g : (MvPolynomial ι R ⧸ I) →ₐ[R] S =>
        g (Ideal.Quotient.mkₐ R I (MvPolynomial.X i))) hαβ
      simp only [AlgHom.comp_apply] at this
      rw [this]
      show Ideal.Quotient.lift I _ hI (Ideal.Quotient.mk I _) = a i
      rw [Ideal.Quotient.lift_mk]
      simp
    · rw [← hcomp, AlgHom.comp_apply]
      have : Ideal.Quotient.mkₐ R I ρ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [this, map_zero]

  have hflat : Module.Flat R S := by
    apply Module.Flat.of_forall_isTrivialRelation
    intro l f x hx
    obtain ⟨E₀, _, _, hE, β₀, a₀, hβ, hρ⟩ := hL (Fin l)
      (∑ i, MvPolynomial.C (f i) * MvPolynomial.X i) x (by
        simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
        rw [← hx]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def])
    have h0 : ∑ i, f i • a₀ i = 0 := by
      simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X] at hρ
      rw [← hρ]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def]
    obtain ⟨k, A, y, hA, hA'⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := R) (M := E₀) (f := f) (x := a₀) h0
    refine ⟨k, A, fun j => β₀ (y j), fun i => ?_, hA'⟩
    rw [← hβ i, hA i, map_sum]
    simp only [map_smul]

  have hrep : ∀ w : TensorProduct R S S, ∃ (m : ℕ) (a b : Fin m → S),
      w = ∑ t, a t ⊗ₜ[R] b t := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
    | tmul x y => exact ⟨1, fun _ => x, fun _ => y, by simp⟩
    | add w₁ w₂ h₁ h₂ =>
      obtain ⟨m₁, a₁, b₁, e₁⟩ := h₁
      obtain ⟨m₂, a₂, b₂, e₂⟩ := h₂
      refine ⟨m₁ + m₂, Fin.append a₁ a₂, Fin.append b₁ b₂, ?_⟩
      rw [Fin.sum_univ_add, e₁, e₂]
      simp [Fin.append_left, Fin.append_right]

  have hdiag : (Algebra.TensorProduct.lmul' R : TensorProduct R S S →ₐ[R] S).Flat := by
    letI : Algebra (TensorProduct R S S) S :=
      (Algebra.TensorProduct.lmul' R : TensorProduct R S S →ₐ[R] S).toRingHom.toAlgebra
    show Module.Flat (TensorProduct R S S) S
    apply Module.Flat.of_forall_isTrivialRelation
    intro l f x hx
    have hx' : ∑ i, Algebra.TensorProduct.lmul' R (f i) * x i = 0 := by
      rw [← hx]
      rfl
    choose m a b hab using fun i => hrep (f i)
    let ρ : MvPolynomial (Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i)))) R :=
      ∑ i, (∑ t : Fin (m i), MvPolynomial.X (Sum.inr (Sum.inl ⟨i, t⟩)) *
        MvPolynomial.X (Sum.inr (Sum.inr ⟨i, t⟩))) * MvPolynomial.X (Sum.inl i)
    have hev : ∀ (B : Type u) [CommRing B] [Algebra R B]
        (v : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → B),
        MvPolynomial.aeval v ρ = ∑ i, (∑ t : Fin (m i), v (Sum.inr (Sum.inl ⟨i, t⟩)) *
          v (Sum.inr (Sum.inr ⟨i, t⟩))) * v (Sum.inl i) := by
      intro B _ _ v
      simp only [ρ, map_sum, map_mul, MvPolynomial.aeval_X]
    let pt : Fin l ⊕ ((Σ i, Fin (m i)) ⊕ (Σ i, Fin (m i))) → S :=
      Sum.elim x (Sum.elim (fun p => a p.1 p.2) (fun p => b p.1 p.2))
    obtain ⟨E₀, _, _, hE, β₀, a₀, hβ, hρ⟩ := hL _ ρ pt (by
      rw [hev, ← hx']
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hab i, map_sum]
      simp [pt, Algebra.TensorProduct.lmul'_apply_tmul])
    let w₀ : Fin l → TensorProduct R E₀ E₀ := fun i =>
      ∑ t : Fin (m i), a₀ (Sum.inr (Sum.inl ⟨i, t⟩)) ⊗ₜ[R] a₀ (Sum.inr (Sum.inr ⟨i, t⟩))
    let x₀ : Fin l → E₀ := fun i => a₀ (Sum.inl i)
    haveI hWE : Algebra.WeaklyEtale R E₀ := inferInstance
    letI : Algebra (TensorProduct R E₀ E₀) E₀ :=
      (Algebra.TensorProduct.lmul' R : TensorProduct R E₀ E₀ →ₐ[R] E₀).toRingHom.toAlgebra
    haveI hE₀flat : Module.Flat (TensorProduct R E₀ E₀) E₀ := hWE.flat_lmul'
    have h0 : ∑ i, w₀ i • x₀ i = 0 := by
      rw [hev] at hρ
      rw [← hρ]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      show Algebra.TensorProduct.lmul' R (w₀ i) * x₀ i = _
      simp [w₀, x₀, map_sum, Algebra.TensorProduct.lmul'_apply_tmul]
    obtain ⟨k, A, z, hA, hA'⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := TensorProduct R E₀ E₀) (M := E₀) (f := w₀) (x := x₀) h0
    have hK : ∀ u : TensorProduct R E₀ E₀,
        Algebra.TensorProduct.lmul' R (Algebra.TensorProduct.map β₀ β₀ u) =
          β₀ (Algebra.TensorProduct.lmul' R u) := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | tmul p q => simp [Algebra.TensorProduct.lmul'_apply_tmul]
      | add p q hp hq => simp only [map_add, hp, hq]
    have hw : ∀ i, Algebra.TensorProduct.map β₀ β₀ (w₀ i) = f i := by
      intro i
      rw [hab i]
      simp only [w₀, map_sum, Algebra.TensorProduct.map_tmul, hβ, pt, Sum.elim_inl,
        Sum.elim_inr]
    refine ⟨k, fun i j => Algebra.TensorProduct.map β₀ β₀ (A i j), fun j => β₀ (z j),
      fun i => ?_, fun j => ?_⟩
    · have := congrArg β₀ (hA i)
      rw [show β₀ (x₀ i) = x i from hβ (Sum.inl i)] at this
      rw [this, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      show β₀ (Algebra.TensorProduct.lmul' R (A i j) * z j) =
        Algebra.TensorProduct.lmul' R (Algebra.TensorProduct.map β₀ β₀ (A i j)) * β₀ (z j)
      rw [map_mul, hK]
    · have := congrArg (Algebra.TensorProduct.map β₀ β₀) (hA' j)
      rw [map_sum, map_zero] at this
      rw [← this]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, hw]
  exact Algebra.WeaklyEtale.mk hflat hdiag

theorem wc_indEt_factor_presented_over_S : ∀ {R S T P : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing P] [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T] [Algebra R P], (∀ (Q : Type u) [CommRing Q] [Algebra S Q] [Algebra.FinitePresentation S Q] (h : Q →ₐ[S] T), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E), Algebra.Etale S E ∧ ∃ (α : Q →ₐ[S] E) (β : E →ₐ[S] T), β.comp α = h) → ∀ {m r : ℕ} (fP : MvPolynomial (Fin m) R →ₐ[R] P) (K : Fin r → MvPolynomial (Fin m) R) (h : P →ₐ[R] T), (∀ k, fP (K k) = 0) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra S E'), Algebra.Etale S E' ∧ ∃ (e : Fin m → E') (β' : E' →ₐ[S] T), (∀ k, MvPolynomial.aeval e (MvPolynomial.map (algebraMap R S) (K k)) = 0) ∧ ∀ t, β' (e t) = h (fP (MvPolynomial.X t)) :=
by
  intro R S T P _ _ _ _ _ _ _ _ _ H m r fP K h hK0
  let w : Fin m → T := fun t => h (fP (MvPolynomial.X t))
  let I : Ideal (MvPolynomial (Fin m) S) :=
    Ideal.span (Set.range (fun k => MvPolynomial.map (algebraMap R S) (K k)))
  have hIfg : I.FG := Submodule.fg_span (Set.finite_range _)
  haveI hQfp : Algebra.FinitePresentation S (MvPolynomial (Fin m) S ⧸ I) :=
    Algebra.FinitePresentation.quotient hIfg
  let hS0 : MvPolynomial (Fin m) S →ₐ[S] T := MvPolynomial.aeval w
  have hRcomp : (MvPolynomial.aeval (R := R) w) = h.comp fP := by
    apply MvPolynomial.algHom_ext
    intro t
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply]
  have hgen : ∀ k, hS0 (MvPolynomial.map (algebraMap R S) (K k)) = 0 := by
    intro k
    show MvPolynomial.aeval w (MvPolynomial.map (algebraMap R S) (K k)) = 0
    rw [MvPolynomial.aeval_map_algebraMap S w (K k), hRcomp, AlgHom.comp_apply, hK0 k, map_zero]
  have hkill : ∀ a ∈ I, hS0 a = 0 := by
    intro a ha
    have hle : I ≤ RingHom.ker hS0 := by
      apply Ideal.span_le.mpr
      rintro _ ⟨k, rfl⟩
      exact RingHom.mem_ker.mpr (hgen k)
    exact RingHom.mem_ker.mp (hle ha)
  let hS : (MvPolynomial (Fin m) S ⧸ I) →ₐ[S] T := Ideal.Quotient.liftₐ I hS0 hkill
  have hSmk : ∀ p, hS (Ideal.Quotient.mk I p) = hS0 p := by
    intro p
    rfl
  obtain ⟨E', instE, algE, hEt, α', β', hαβ⟩ := H (MvPolynomial (Fin m) S ⧸ I) hS
  let e : Fin m → E' := fun t => α' (Ideal.Quotient.mk I (MvPolynomial.X t))
  have hkey : MvPolynomial.aeval e = α'.comp (Ideal.Quotient.mkₐ S I) := by
    apply MvPolynomial.algHom_ext
    intro t
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
  refine ⟨E', instE, algE, hEt, e, β', fun k => ?_, fun t => ?_⟩
  · have hmem : MvPolynomial.map (algebraMap R S) (K k) ∈ I :=
      Ideal.subset_span ⟨k, rfl⟩
    rw [hkey, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
  · show β' (α' (Ideal.Quotient.mk I (MvPolynomial.X t))) = w t
    rw [← AlgHom.comp_apply, hαβ, hSmk]
    show MvPolynomial.aeval w (MvPolynomial.X t) = w t
    rw [MvPolynomial.aeval_X]

theorem wc_etale_standard_presentation : ∀ (S E : Type u) [CommRing S] [CommRing E] [Algebra S E], Algebra.Etale S E → ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (_ : DecidableEq σ) (mp : σ → ι) (f : σ → MvPolynomial ι S) (val : ι → E), Function.Bijective mp ∧ Function.Surjective (MvPolynomial.aeval (R := S) val) ∧ RingHom.ker (MvPolynomial.aeval (R := S) val) = Ideal.span (Set.range f) ∧ ∃ g : MvPolynomial ι S, g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) :=
by
  intro S E _ _ _ hE
  haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 S E :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hE
  obtain ⟨ι, σ, hσ, hι, P, hdim⟩ :=
    Algebra.IsStandardSmoothOfRelativeDimension.out (n := 0) (R := S) (S := E)
  have hdim' : Nat.card ι - Nat.card σ = 0 := hdim
  have hle : Nat.card ι ≤ Nat.card σ := Nat.sub_eq_zero_iff_le.mp hdim'
  letI : Fintype ι := Fintype.ofFinite ι
  letI : Fintype σ := Fintype.ofFinite σ
  letI : DecidableEq σ := Classical.decEq σ
  have hker : RingHom.ker (MvPolynomial.aeval (R := S) P.val) =
      Ideal.span (Set.range P.relation) :=
    (P.span_range_relation_eq_ker.trans P.ker_eq_ker_aeval_val).symm
  refine ⟨ι, σ, inferInstance, inferInstance, inferInstance, P.map, P.relation, P.val,
    P.map_inj.bijective_of_nat_card_le hle, fun s => ⟨P.σ' s, P.aeval_val_σ' s⟩, hker, ?_⟩
  have hM : (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)) =
      P.jacobiMatrix := by
    ext i j
    rw [Matrix.of_apply, P.jacobiMatrix_apply]
  have hJ : P.jacobian = MvPolynomial.aeval P.val
      (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)).det := by
    rw [P.jacobian_eq_jacobiMatrix_det, hM, Algebra.Generators.algebraMap_apply]
  have hu : IsUnit P.jacobian := P.jacobian_isUnit
  rw [hJ] at hu
  obtain ⟨y, hy⟩ := hu.exists_left_inv
  refine ⟨P.σ' y, ?_⟩
  rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_one, P.aeval_val_σ', hy, sub_self]

theorem wc_standard_etale_quotient : ∀ (A : Type u) [CommRing A] {ι σ : Type} [Fintype ι] [Fintype σ] [DecidableEq σ] (mp : σ → ι), Function.Bijective mp → ∀ (f : σ → MvPolynomial ι A) (g : MvPolynomial ι A), g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) → Algebra.Etale A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) :=
by
  intro A _ ι σ _ _ _ mp hbij f g hg
  let P : Algebra.PreSubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
    { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
  have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
    ext i j
    rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    rfl
  have halg : ∀ x : MvPolynomial ι A,
      algebraMap P.Ring (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) x =
        Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
  have hunit : IsUnit P.jacobian := by
    rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
    have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
        (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
      rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
      exact hg
    rw [map_mul, mul_comm] at h1
    exact IsUnit.of_mul_eq_one _ h1
  let Q : Algebra.SubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
    { P with jacobian_isUnit := hunit }
  have hdim : Q.dimension = 0 := by
    show Nat.card ι - Nat.card σ = 0
    rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
  haveI := Q.isStandardSmoothOfRelativeDimension hdim
  infer_instance

theorem wc_indEt_lift_finite_solution : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S], (∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P] (h : P →ₐ[R] S), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧ ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] S), β.comp α = h) → ∀ (N nZ : ℕ) (Z : Fin nZ → MvPolynomial (Fin N) R) (a : Fin N → S), (∀ j, MvPolynomial.aeval a (Z j) = 0) → ∃ (E₀ : Type u) (_ : CommRing E₀) (_ : Algebra R E₀), Algebra.Etale R E₀ ∧ ∃ (β₀ : E₀ →ₐ[R] S) (a₀ : Fin N → E₀), (∀ i, β₀ (a₀ i) = a i) ∧ ∀ j, MvPolynomial.aeval a₀ (Z j) = 0 :=
by
  intro R S _ _ _ H N nZ Z a hZa
  let I : Ideal (MvPolynomial (Fin N) R) := Ideal.span (Set.range Z)
  haveI hFP : Algebra.FinitePresentation R (MvPolynomial (Fin N) R ⧸ I) :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range Z))
  have hI : ∀ p ∈ I, MvPolynomial.aeval a p = 0 := by
    intro p hp
    have hle : I ≤ RingHom.ker (MvPolynomial.aeval (R := R) a) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact (RingHom.mem_ker).mpr (hZa j)
    exact (RingHom.mem_ker).mp (hle hp)
  let h : (MvPolynomial (Fin N) R ⧸ I) →ₐ[R] S :=
    Ideal.Quotient.liftₐ I (MvPolynomial.aeval a) hI
  have hh : ∀ p, h (Ideal.Quotient.mkₐ R I p) = MvPolynomial.aeval a p := fun p => rfl
  obtain ⟨E, _, _, hE, α, β, hαβ⟩ := H (MvPolynomial (Fin N) R ⧸ I) h
  have key : MvPolynomial.aeval (fun i => α (Ideal.Quotient.mkₐ R I (MvPolynomial.X i))) =
      α.comp (Ideal.Quotient.mkₐ R I) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply]
  refine ⟨E, inferInstance, inferInstance, hE, β,
    fun i => α (Ideal.Quotient.mkₐ R I (MvPolynomial.X i)), ?_, ?_⟩
  · intro i
    rw [← AlgHom.comp_apply, hαβ, hh, MvPolynomial.aeval_X]
  · intro j
    rw [key, AlgHom.comp_apply]
    have hz : Ideal.Quotient.mkₐ R I (Z j) = 0 := by
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨j, rfl⟩
    rw [hz, map_zero]

theorem wc_poly_data_descent : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] {ι σ : Type} [Fintype σ] [DecidableEq σ] (mp : σ → ι) (f : σ → MvPolynomial ι S) (g : MvPolynomial ι S) (m r : ℕ) (q : Fin m → MvPolynomial ι S) (K : Fin r → MvPolynomial (Fin m) R), g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) → (∀ k, MvPolynomial.aeval q (MvPolynomial.map (algebraMap R S) (K k)) ∈ Ideal.span (Set.range f)) → ∃ (N nZ : ℕ) (Z : Fin nZ → MvPolynomial (Fin N) R) (a : Fin N → S), (∀ j, MvPolynomial.aeval a (Z j) = 0) ∧ ∀ (B : Type u) [CommRing B] [Algebra R B] (β₀ : B →ₐ[R] S) (a₀ : Fin N → B), (∀ i, β₀ (a₀ i) = a i) → (∀ j, MvPolynomial.aeval a₀ (Z j) = 0) → ∃ (f₀ : σ → MvPolynomial ι B) (g₀ : MvPolynomial ι B) (q₀ : Fin m → MvPolynomial ι B), (∀ j, MvPolynomial.map (β₀ : B →+* S) (f₀ j) = f j) ∧ (∀ t, MvPolynomial.map (β₀ : B →+* S) (q₀ t) = q t) ∧ g₀ * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f₀ j)).det - 1 ∈ Ideal.span (Set.range f₀) ∧ ∀ k, MvPolynomial.aeval q₀ (MvPolynomial.map (algebraMap R B) (K k)) ∈ Ideal.span (Set.range f₀) :=
by
  intro R S _ _ _ ι σ _ _ mp f g m r q K hg hK

  have s1 : ∀ {Λ : Type} [Fintype Λ] (p : Λ → MvPolynomial ι S), ∃ (N : ℕ) (a : Fin N → S) (P : Λ → MvPolynomial ι (MvPolynomial (Fin N) R)), ∀ l, MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) (P l) = p l := by
    intro Λ _ p
    classical
    let e := Fintype.equivFin (Σ l : Λ, ↥(p l).support)
    obtain ⟨c, hc⟩ : ∃ c : (Σ l : Λ, ↥(p l).support) → S, ∀ ω, c ω = (p ω.1).coeff (ω.2 : ι →₀ ℕ) :=
      ⟨_, fun _ => rfl⟩
    refine ⟨Fintype.card (Σ l : Λ, ↥(p l).support), fun n => c (e.symm n),
      fun l => ∑ v : ↥(p l).support, MvPolynomial.monomial (v : ι →₀ ℕ) (MvPolynomial.X (e ⟨l, v⟩)), ?_⟩
    intro l
    rw [map_sum]
    have hterm : ∀ v : ↥(p l).support,
        MvPolynomial.map ((MvPolynomial.aeval (fun n => c (e.symm n)) : MvPolynomial (Fin _) R →ₐ[R] S) : MvPolynomial (Fin _) R →+* S)
          (MvPolynomial.monomial (v : ι →₀ ℕ) (MvPolynomial.X (e ⟨l, v⟩))) =
        MvPolynomial.monomial (v : ι →₀ ℕ) ((p l).coeff v) := by
      intro v
      rw [MvPolynomial.map_monomial]
      congr 1
      rw [AlgHom.coe_toRingHom, MvPolynomial.aeval_X, Equiv.symm_apply_apply, hc]
    rw [Finset.sum_congr rfl (fun v _ => hterm v)]
    rw [Finset.sum_coe_sort (p l).support (fun v => MvPolynomial.monomial v ((p l).coeff v))]
    exact MvPolynomial.support_sum_monomial_coeff (p l)

  have s2 : ∀ {Ξ : Type} [Fintype Ξ] (N : ℕ) (Rel : Ξ → MvPolynomial ι (MvPolynomial (Fin N) R)), ∃ (nZ : ℕ) (Z : Fin nZ → MvPolynomial (Fin N) R), ∀ (B : Type u) [CommRing B] [Algebra R B] (b : Fin N → B), (∀ j, MvPolynomial.aeval b (Z j) = 0) ↔ ∀ x, MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Rel x) = 0 := by
    intro Ξ _ N Rel
    classical
    let e := Fintype.equivFin (Σ x : Ξ, ↥(Rel x).support)
    obtain ⟨c, hc⟩ : ∃ c : (Σ x : Ξ, ↥(Rel x).support) → MvPolynomial (Fin N) R,
        ∀ ω, c ω = (Rel ω.1).coeff (ω.2 : ι →₀ ℕ) := ⟨_, fun _ => rfl⟩
    refine ⟨Fintype.card (Σ x : Ξ, ↥(Rel x).support), fun j => c (e.symm j), ?_⟩
    intro B _ _ b
    constructor
    · intro h x
      ext v
      rw [MvPolynomial.coeff_map]
      by_cases hv : v ∈ (Rel x).support
      · have := h (e ⟨x, ⟨v, hv⟩⟩)
        simp only [Equiv.symm_apply_apply, hc] at this
        simpa using this
      · rw [MvPolynomial.notMem_support_iff.mp hv]
        simp
    · intro h j
      obtain ⟨⟨x, v, hv⟩, rfl⟩ := e.surjective j
      simp only [Equiv.symm_apply_apply, hc]
      have := congrArg (fun P => P.coeff v) (h x)
      simpa [MvPolynomial.coeff_map] using this

  have s3 : ∀ {C B : Type u} [CommRing C] [CommRing B] (φ : C →+* B) (F : σ → MvPolynomial ι C), MvPolynomial.map φ (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (F j)).det = (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (MvPolynomial.map φ (F j))).det := by
    intro C B _ _ φ F
    rw [RingHom.map_det, RingHom.mapMatrix_apply]
    congr 1
    ext i j
    simp [MvPolynomial.pderiv_map]

  have s4 : ∀ {C B : Type u} [CommRing C] [CommRing B] [Algebra R C] [Algebra R B] (φ : C →ₐ[R] B) (Q : Fin m → MvPolynomial ι C) (p : MvPolynomial (Fin m) R), MvPolynomial.map (φ : C →+* B) (MvPolynomial.aeval Q (MvPolynomial.map (algebraMap R C) p)) = MvPolynomial.aeval (fun t => MvPolynomial.map (φ : C →+* B) (Q t)) (MvPolynomial.map (algebraMap R B) p) := by
    intro C B _ _ _ _ φ Q p
    rw [MvPolynomial.aeval_map_algebraMap, MvPolynomial.aeval_map_algebraMap]
    have h := congrArg (fun F => F p) (MvPolynomial.comp_aeval (R := R) Q (MvPolynomial.mapAlgHom φ : MvPolynomial ι C →ₐ[R] MvPolynomial ι B))
    simpa only [AlgHom.comp_apply, MvPolynomial.mapAlgHom_apply] using h

  have s5 : ∀ {B : Type u} [CommRing B] [Algebra R B] (β₀ : B →ₐ[R] S) {N : ℕ} (a₀ : Fin N → B) (a : Fin N → S), (∀ i, β₀ (a₀ i) = a i) → ∀ (P : MvPolynomial ι (MvPolynomial (Fin N) R)), MvPolynomial.map (β₀ : B →+* S) (MvPolynomial.map ((MvPolynomial.aeval a₀ : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) P) = MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) P := by
    intro B _ _ β₀ N a₀ a ha P
    rw [MvPolynomial.map_map]
    have : β₀.comp (MvPolynomial.aeval a₀) = MvPolynomial.aeval a := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [ha]
    rw [← this]
    rfl

  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hg
  have hd' : ∀ k, ∃ d : σ → MvPolynomial ι S, ∑ j, d j * f j =
      MvPolynomial.aeval q (MvPolynomial.map (algebraMap R S) (K k)) :=
    fun k => Ideal.mem_span_range_iff_exists_fun.mp (hK k)
  choose d hd using hd'
  obtain ⟨N, a, P, hP⟩ := s1 (Λ := σ ⊕ (Unit ⊕ (Fin m ⊕ (σ ⊕ (Fin r × σ)))))
    (Sum.elim f (Sum.elim (fun _ => g) (Sum.elim q (Sum.elim c (fun kj => d kj.1 kj.2)))))
  obtain ⟨F, hF⟩ : ∃ F : σ → MvPolynomial ι (MvPolynomial (Fin N) R), ∀ j,
      MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) (F j) = f j :=
    ⟨fun j => P (Sum.inl j), fun j => hP _⟩
  obtain ⟨G, hG⟩ : ∃ G : MvPolynomial ι (MvPolynomial (Fin N) R),
      MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) G = g :=
    ⟨P (Sum.inr (Sum.inl ())), hP _⟩
  obtain ⟨Qg, hQ⟩ : ∃ Qg : Fin m → MvPolynomial ι (MvPolynomial (Fin N) R), ∀ t,
      MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) (Qg t) = q t :=
    ⟨fun t => P (Sum.inr (Sum.inr (Sum.inl t))), fun t => hP _⟩
  obtain ⟨Cg, hC⟩ : ∃ Cg : σ → MvPolynomial ι (MvPolynomial (Fin N) R), ∀ j,
      MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) (Cg j) = c j :=
    ⟨fun j => P (Sum.inr (Sum.inr (Sum.inr (Sum.inl j)))), fun j => hP _⟩
  obtain ⟨Dg, hD⟩ : ∃ Dg : Fin r → σ → MvPolynomial ι (MvPolynomial (Fin N) R), ∀ k j,
      MvPolynomial.map ((MvPolynomial.aeval a : MvPolynomial (Fin N) R →ₐ[R] S) : MvPolynomial (Fin N) R →+* S) (Dg k j) = d k j :=
    ⟨fun k j => P (Sum.inr (Sum.inr (Sum.inr (Sum.inr (k, j))))), fun k j => hP _⟩
  obtain ⟨Rel, hRel1, hRel2⟩ : ∃ Rel : Unit ⊕ Fin r → MvPolynomial ι (MvPolynomial (Fin N) R),
      Rel (Sum.inl ()) = G * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (F j)).det - 1 - ∑ j, Cg j * F j ∧
      ∀ k, Rel (Sum.inr k) = MvPolynomial.aeval Qg (MvPolynomial.map (algebraMap R (MvPolynomial (Fin N) R)) (K k)) - ∑ j, Dg k j * F j :=
    ⟨Sum.elim (fun _ => G * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (F j)).det - 1 - ∑ j, Cg j * F j)
      (fun k => MvPolynomial.aeval Qg (MvPolynomial.map (algebraMap R (MvPolynomial (Fin N) R)) (K k)) - ∑ j, Dg k j * F j),
      rfl, fun _ => rfl⟩
  obtain ⟨nZ, Z, hZ⟩ := s2 N Rel

  have e1 : ∀ (B : Type u) [CommRing B] [Algebra R B] (b : Fin N → B),
      MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Rel (Sum.inl ())) =
        MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) G *
          (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (F j))).det - 1 -
          ∑ j, MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Cg j) *
            MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (F j) := by
    intro B _ _ b
    rw [hRel1, map_sub, map_sub, map_mul, map_one, map_sum, s3]
    simp only [map_mul]
  have e2 : ∀ (B : Type u) [CommRing B] [Algebra R B] (b : Fin N → B) (k : Fin r),
      MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Rel (Sum.inr k)) =
        MvPolynomial.aeval (fun t => MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Qg t))
          (MvPolynomial.map (algebraMap R B) (K k)) -
          ∑ j, MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Dg k j) *
            MvPolynomial.map ((MvPolynomial.aeval b : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (F j) := by
    intro B _ _ b k
    rw [hRel2, map_sub, map_sum, s4]
    simp only [map_mul]
  refine ⟨N, nZ, Z, a, ?_, ?_⟩
  · apply (hZ S a).mpr
    rintro (⟨⟩ | k)
    · rw [e1]
      simp only [hF, hG, hC]
      rw [hc, sub_self]
    · rw [e2]
      simp only [hF, hQ, hD]
      rw [hd k, sub_self]
  · intro B _ _ β₀ a₀ ha₀ hZ₀
    have h0 := (hZ B a₀).mp hZ₀
    refine ⟨fun j => MvPolynomial.map ((MvPolynomial.aeval a₀ : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (F j),
      MvPolynomial.map ((MvPolynomial.aeval a₀ : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) G,
      fun t => MvPolynomial.map ((MvPolynomial.aeval a₀ : MvPolynomial (Fin N) R →ₐ[R] B) : MvPolynomial (Fin N) R →+* B) (Qg t),
      fun j => ?_, fun t => ?_, ?_, fun k => ?_⟩
    · rw [s5 β₀ a₀ a ha₀, hF]
    · rw [s5 β₀ a₀ a ha₀, hQ]
    · have h1 := h0 (Sum.inl ())
      rw [e1, sub_eq_zero] at h1
      exact Ideal.mem_span_range_iff_exists_fun.mpr ⟨_, h1.symm⟩
    · have h2 := h0 (Sum.inr k)
      rw [e2, sub_eq_zero] at h2
      exact Ideal.mem_span_range_iff_exists_fun.mpr ⟨_, h2.symm⟩

theorem wc_indEt_assemble_factorization : ∀ {R S T E₀ P : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing E₀] [CommRing P] [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T] [Algebra R E₀] [Algebra R P] {ι σ : Type} {m r : ℕ} (β₀ : E₀ →ₐ[R] S) (val : ι → T) (f₀ : σ → MvPolynomial ι E₀) (q₀ : Fin m → MvPolynomial ι E₀) (K : Fin r → MvPolynomial (Fin m) R) (fP : MvPolynomial (Fin m) R →ₐ[R] P) (h : P →ₐ[R] T), Function.Surjective fP → Ideal.span (Set.range K) = RingHom.ker fP.toRingHom → (∀ j, MvPolynomial.aeval val (MvPolynomial.map (β₀ : E₀ →+* S) (f₀ j)) = 0) → (∀ k, MvPolynomial.aeval q₀ (MvPolynomial.map (algebraMap R E₀) (K k)) ∈ Ideal.span (Set.range f₀)) → (∀ t, h (fP (MvPolynomial.X t)) = MvPolynomial.aeval val (MvPolynomial.map (β₀ : E₀ →+* S) (q₀ t))) → ∃ (α : P →ₐ[R] MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀)) (β : MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀) →ₐ[R] T), β.comp α = h :=
by
  intro R S T E₀ P _ _ _ _ _ _ _ _ _ _ _ ι σ m r β₀ val f₀ q₀ K fP h hfP hK H1 H2 H3
  classical

  let φ' : MvPolynomial ι E₀ →ₐ[R] T :=
    ((MvPolynomial.aeval (R := S) val).restrictScalars R).comp (MvPolynomial.mapAlgHom β₀)
  have hφ' : ∀ p, φ' p = MvPolynomial.aeval val (MvPolynomial.map (β₀ : E₀ →+* S) p) :=
    fun p => rfl

  have hβ : ∀ a ∈ Ideal.span (Set.range f₀), φ' a = 0 := by
    have hle : Ideal.span (Set.range f₀) ≤ RingHom.ker φ' := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, hφ']
      exact H1 j
    intro a ha
    exact hle ha
  let β : MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀) →ₐ[R] T :=
    Ideal.Quotient.liftₐ (Ideal.span (Set.range f₀)) φ' hβ

  let α₀ : MvPolynomial (Fin m) R →ₐ[R] MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀) :=
    MvPolynomial.aeval (fun t => Ideal.Quotient.mk (Ideal.span (Set.range f₀)) (q₀ t))
  have hα₀ : ∀ x, α₀ x =
      Ideal.Quotient.mk (Ideal.span (Set.range f₀)) (MvPolynomial.aeval q₀ x) := by
    intro x
    have h2 := DFunLike.congr_fun
      (MvPolynomial.comp_aeval (R := R) q₀ (Ideal.Quotient.mkₐ R (Ideal.span (Set.range f₀)))) x
    exact h2.symm
  have hKk : ∀ k, α₀ (K k) = 0 := by
    intro k
    rw [hα₀, Ideal.Quotient.eq_zero_iff_mem]
    have := H2 k
    rwa [MvPolynomial.aeval_map_algebraMap] at this
  have hα : ∀ a ∈ RingHom.ker fP.toRingHom, α₀ a = 0 := by
    have hle : Ideal.span (Set.range K) ≤ RingHom.ker α₀ := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact hKk k
    intro a ha
    rw [← hK] at ha
    exact hle ha

  let eqv := Ideal.quotientKerAlgEquivOfSurjective hfP
  have hα' : ∀ a ∈ RingHom.ker fP, α₀ a = 0 := fun a ha => hα a ha
  let α : P →ₐ[R] MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀) :=
    (Ideal.Quotient.liftₐ (RingHom.ker fP) α₀ hα').comp eqv.symm.toAlgHom
  have hαfP : ∀ x, α (fP x) = α₀ x := by
    intro x
    have he : eqv (Ideal.Quotient.mk (RingHom.ker fP) x) = fP x := rfl
    show Ideal.Quotient.liftₐ (RingHom.ker fP) α₀ hα' (eqv.symm (fP x)) = α₀ x
    rw [← he, AlgEquiv.symm_apply_apply]
    rfl

  have hcomp : β.comp α₀ = h.comp fP := by
    apply MvPolynomial.algHom_ext
    intro t
    rw [AlgHom.comp_apply, AlgHom.comp_apply, H3 t]
    show β (MvPolynomial.aeval (fun t => Ideal.Quotient.mk (Ideal.span (Set.range f₀)) (q₀ t))
      (MvPolynomial.X t)) = _
    rw [MvPolynomial.aeval_X]
    rfl
  refine ⟨α, β, ?_⟩
  apply AlgHom.ext
  intro p
  obtain ⟨x, rfl⟩ := hfP p
  rw [AlgHom.comp_apply, hαfP]
  exact DFunLike.congr_fun hcomp x

theorem wc_indEtale_comp : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (φ : R →+* S) (ψ : S →+* T), wcIndEtale φ → wcIndEtale ψ → wcIndEtale (ψ.comp φ) :=
by
  intro R S T _ _ _ φ ψ hφ hψ
  letI : Algebra R S := φ.toAlgebra
  letI : Algebra S T := ψ.toAlgebra
  letI : Algebra R T := (ψ.comp φ).toAlgebra
  haveI : IsScalarTower R S T := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hφ' : ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
      (h : P →ₐ[R] S), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
        ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] S), β.comp α = h := hφ
  have hψ' : ∀ (Q : Type u) [CommRing Q] [Algebra S Q] [Algebra.FinitePresentation S Q]
      (h : Q →ₐ[S] T), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E), Algebra.Etale S E ∧
        ∃ (α : Q →ₐ[S] E) (β : E →ₐ[S] T), β.comp α = h := hψ
  show ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
      (h : P →ₐ[R] T), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
        ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] T), β.comp α = h
  intro P _ _ _ h
  obtain ⟨m, fP, hfP, hker⟩ := Algebra.FinitePresentation.out (R := R) (A := P)
  obtain ⟨r, K, hK⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hker
  have hKspan : Ideal.span (Set.range K) = RingHom.ker fP.toRingHom := hK
  have hK0 : ∀ k, fP (K k) = 0 := fun k => by
    have hmem : K k ∈ RingHom.ker fP.toRingHom := hKspan ▸ Ideal.subset_span ⟨k, rfl⟩
    exact hmem
  obtain ⟨E', _, _, hE', e, β', hKe, he⟩ := wc_indEt_factor_presented_over_S hψ' fP K h hK0
  obtain ⟨ι, σ, _, _, _, mp, f, val, hbij, hsurj, hkerv, g, hg⟩ :=
    wc_etale_standard_presentation S E' hE'
  let q : Fin m → MvPolynomial ι S := fun t => Function.surjInv hsurj (e t)
  have hqe : ∀ t, MvPolynomial.aeval val (q t) = e t := fun t => Function.surjInv_eq hsurj (e t)
  have hcomp : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra S A] [Algebra S B]
      {τ : Type} (φ' : A →ₐ[S] B) (w : τ → A) (p : MvPolynomial τ S),
      φ' (MvPolynomial.aeval w p) = MvPolynomial.aeval (fun i => φ' (w i)) p := by
    intro A B _ _ _ _ τ φ' w p
    rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
  have hKq : ∀ k, MvPolynomial.aeval q (MvPolynomial.map (algebraMap R S) (K k)) ∈
      Ideal.span (Set.range f) := by
    intro k
    rw [← hkerv, RingHom.mem_ker, hcomp]
    have hfun : (fun t => MvPolynomial.aeval val (q t)) = e := funext hqe
    rw [hfun, hKe k]
  obtain ⟨N, nZ, Z, a, hZa, hspec⟩ := wc_poly_data_descent mp f g m r q K hg hKq
  obtain ⟨E₀, _, _, hE₀, β₀, a₀, ha₀, hZ₀⟩ := wc_indEt_lift_finite_solution hφ' N nZ Z a hZa
  obtain ⟨f₀, g₀, q₀, hf₀, hq₀, hg₀, hK₀⟩ := hspec E₀ β₀ a₀ ha₀ hZ₀
  haveI hEt1 : Algebra.Etale E₀ (MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀)) :=
    wc_standard_etale_quotient E₀ mp hbij f₀ g₀ hg₀
  haveI := hE₀
  have hEt : Algebra.Etale R (MvPolynomial ι E₀ ⧸ Ideal.span (Set.range f₀)) :=
    Algebra.Etale.comp R E₀ _
  have hval' : ∀ j, MvPolynomial.aeval (fun i => β' (val i))
      (MvPolynomial.map (β₀ : E₀ →+* S) (f₀ j)) = 0 := by
    intro j
    rw [hf₀ j, ← hcomp]
    have hfj : f j ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) :=
      hkerv ▸ Ideal.subset_span ⟨j, rfl⟩
    rw [RingHom.mem_ker] at hfj
    rw [hfj, map_zero]
  have hh : ∀ t, h (fP (MvPolynomial.X t)) = MvPolynomial.aeval (fun i => β' (val i))
      (MvPolynomial.map (β₀ : E₀ →+* S) (q₀ t)) := by
    intro t
    rw [hq₀ t, ← he t, ← hqe t, hcomp]
  obtain ⟨α, β, hαβ⟩ := wc_indEt_assemble_factorization β₀ (fun i => β' (val i)) f₀ q₀ K fP h
    hfP hKspan hval' hK₀ hh
  exact ⟨_, inferInstance, inferInstance, hEt, α, β, hαβ⟩

theorem wc_cert_etale_algebra : ∀ (A : Type u) [CommRing A] (f g : Polynomial A), f.Monic → (∃ (p₁ p₂ : Polynomial A) (n : ℕ), Polynomial.derivative f * p₁ + f * p₂ = g ^ n) → ∀ (m : ℕ) (a : Fin m → A) (F₀ Z W : Polynomial A), F₀.Monic → 0 < F₀.natDegree → f.comp Z ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) → g.comp Z * W - 1 ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) → ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E), Algebra.Etale A E ∧ (∀ (L : Type u) [Field L] [IsAlgClosed L] [Algebra A L], Nonempty (E →ₐ[A] L)) ∧ ∀ (B : Type u) [CommRing B] [Algebra A B], Nonempty (E →ₐ[A] B) → ∃ (ε : Fin (m + 1) → B) (x : B), (∀ i, ε i * ε i = ε i) ∧ (∀ i j, i ≠ j → ε i * ε j = 0) ∧ ∑ i, ε i = 1 ∧ (f.map (algebraMap A B)).eval x * ε 0 = 0 ∧ (∃ v : B, (g.map (algebraMap A B)).eval x * v = ε 0) ∧ ∀ j : Fin m, ∃ w : B, algebraMap A B (a j) * w = ε j.succ :=
by
  intro A _ f g hf hcond m a F₀ Z W hF₀ hdeg h1 h2
  let P : StandardEtalePair A := ⟨f, hf, g, hcond⟩
  let Q : A → StandardEtalePair A := fun b =>
    ⟨Polynomial.X, Polynomial.monic_X, Polynomial.C b, ⟨Polynomial.C b, 0, 1, by simp⟩⟩
  let Pf : Fin (m + 1) → StandardEtalePair A := Fin.cons P (fun j => Q (a j))
  have hPf0f : (Pf 0).f = f := rfl
  have hPf0g : (Pf 0).g = g := rfl
  have hPfsf : ∀ j : Fin m, (Pf j.succ).f = Polynomial.X := fun j => rfl
  have hPfsg : ∀ j : Fin m, (Pf j.succ).g = Polynomial.C (a j) := fun j => rfl
  clear_value Pf
  refine ⟨∀ i, (Pf i).Ring, inferInstance, inferInstance, inferInstance, ?_, ?_⟩
  ·
    intro L _ _ _
    by_cases hc : ∃ j, algebraMap A L (a j) ≠ 0
    · obtain ⟨j, hj⟩ := hc
      have hmap : (Pf j.succ).HasMap (0 : L) := by
        unfold StandardEtalePair.HasMap
        refine ⟨?_, ?_⟩
        · rw [hPfsf j, Polynomial.aeval_X]
        · rw [hPfsg j, Polynomial.aeval_C]; exact hj.isUnit
      exact ⟨((Pf j.succ).lift 0 hmap).comp (Pi.evalAlgHom A (fun i => (Pf i).Ring) j.succ)⟩
    · push_neg at hc
      have hdeg' : (F₀.map (algebraMap A L)).degree ≠ 0 := by
        have h := hF₀.natDegree_map (algebraMap A L)
        have hpos : 0 < (F₀.map (algebraMap A L)).natDegree := by rw [h]; exact hdeg
        exact (Polynomial.natDegree_pos_iff_degree_pos.mp hpos).ne'
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root _ hdeg'
      have hz' : Polynomial.eval₂ (algebraMap A L) z F₀ = 0 := by
        rw [← Polynomial.eval_map]; exact hz
      have hle : Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) ≤
          RingHom.ker (Polynomial.eval₂RingHom (algebraMap A L) z) := by
        rw [Ideal.span_le, Set.insert_subset_iff]
        refine ⟨?_, ?_⟩
        · exact RingHom.mem_ker.mpr hz'
        · rintro _ ⟨j, rfl⟩
          show Polynomial.eval₂ (algebraMap A L) z (Polynomial.C (a j)) = 0
          rw [Polynomial.eval₂_C]; exact hc j
      have e1 : Polynomial.eval₂ (algebraMap A L) z (f.comp Z) = 0 := RingHom.mem_ker.mp (hle h1)
      have e2 : Polynomial.eval₂ (algebraMap A L) z (g.comp Z * W - 1) = 0 :=
        RingHom.mem_ker.mp (hle h2)
      rw [Polynomial.eval₂_comp] at e1
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_one, Polynomial.eval₂_comp,
        sub_eq_zero] at e2
      have hmap : (Pf 0).HasMap (Polynomial.eval₂ (algebraMap A L) z Z) := by
        unfold StandardEtalePair.HasMap
        refine ⟨?_, ?_⟩
        · rw [hPf0f, Polynomial.aeval_def]; exact e1
        · rw [hPf0g, Polynomial.aeval_def]; exact IsUnit.of_mul_eq_one _ e2
      exact ⟨((Pf 0).lift _ hmap).comp (Pi.evalAlgHom A (fun i => (Pf i).Ring) 0)⟩
  ·
    intro B _ _ hB
    obtain ⟨θ⟩ := hB
    let e : Fin (m + 1) → (∀ i, (Pf i).Ring) := fun i => Pi.single i 1
    have key : ∀ (i : Fin (m + 1)) (y : ∀ i, (Pf i).Ring) (u : (Pf i).Ring), y i * u = 1 →
        y * Pi.single i u = e i := by
      intro i y u hu
      funext k
      rw [Pi.mul_apply]
      by_cases hk : k = i
      · subst hk; simp only [e, Pi.single_eq_same]; exact hu
      · simp only [e, Pi.single_eq_of_ne hk, mul_zero]
    have he_idem : ∀ i, e i * e i = e i := by
      intro i
      apply key
      simp only [e, Pi.single_eq_same, mul_one]
    have he_orth : ∀ i j, i ≠ j → e i * e j = 0 := by
      intro i j hij
      funext k
      rw [Pi.mul_apply, Pi.zero_apply]
      by_cases hki : k = i
      · subst hki; simp only [e, Pi.single_eq_of_ne hij, mul_zero]
      · simp only [e, Pi.single_eq_of_ne hki, zero_mul]
    have he_sum : ∑ i, e i = 1 := by
      have := Finset.univ_sum_single (fun i => (1 : (Pf i).Ring))
      exact this
    let y : ∀ i, (Pf i).Ring := Pi.single 0 (Pf 0).X
    have hy : ∀ (p : Polynomial A) (k : Fin (m + 1)),
        (Polynomial.aeval y p) k = Polynomial.aeval (y k) p := by
      intro p k
      have := Polynomial.aeval_algHom_apply (Pi.evalAlgHom A (fun i => (Pf i).Ring) k) y p
      rw [Pi.evalAlgHom_apply, Pi.evalAlgHom_apply] at this
      exact this.symm
    have hfE : Polynomial.aeval y f * e 0 = 0 := by
      funext k
      rw [Pi.mul_apply, Pi.zero_apply, hy]
      by_cases hk : k = 0
      · subst hk
        simp only [y, e, Pi.single_eq_same, mul_one]
        rw [← hPf0f]
        exact (StandardEtalePair.hasMap_X (P := Pf 0)).1
      · simp only [e, Pi.single_eq_of_ne hk, mul_zero]
    obtain ⟨u, hu⟩ := (StandardEtalePair.hasMap_X (P := Pf 0)).2.exists_right_inv
    have hgE : Polynomial.aeval y g * Pi.single 0 u = e 0 := by
      apply key
      rw [hy]
      simp only [y, Pi.single_eq_same]
      rw [← hPf0g]
      exact hu
    have hw : ∀ j : Fin m, ∃ w : B, algebraMap A B (a j) * w = θ (e j.succ) := by
      intro j
      have h := (StandardEtalePair.hasMap_X (P := Pf j.succ)).2
      rw [hPfsg j, Polynomial.aeval_C] at h
      obtain ⟨u', hu'⟩ := h.exists_right_inv
      refine ⟨θ (Pi.single j.succ u'), ?_⟩
      rw [← θ.commutes, ← map_mul]
      congr 1
      apply key
      rw [Pi.algebraMap_apply]
      exact hu'
    refine ⟨fun i => θ (e i), θ y, fun i => ?_, fun i j hij => ?_, ?_, ?_,
      ⟨θ (Pi.single 0 u), ?_⟩, hw⟩
    · rw [← map_mul, he_idem i]
    · rw [← map_mul, he_orth i j hij, map_zero]
    · rw [← map_sum, he_sum, map_one]
    · rw [Polynomial.eval_map_algebraMap, Polynomial.aeval_algHom_apply, ← map_mul, hfE, map_zero]
    · rw [Polynomial.eval_map_algebraMap, Polynomial.aeval_algHom_apply, ← map_mul, hgE]

theorem wc_sigma_presentation_etale : ∀ (A : Type u) [CommRing A] (n : ℕ) (ι σ : Fin n → Type) [∀ k, Fintype (ι k)] [∀ k, Fintype (σ k)] [∀ k, DecidableEq (σ k)] (mp : ∀ k, σ k → ι k) (f : ∀ k, σ k → MvPolynomial (ι k) A) (g : ∀ k, MvPolynomial (ι k) A), (∀ k, Function.Bijective (mp k)) → (∀ k, g k * (Matrix.of fun a b => MvPolynomial.pderiv (mp k a) (f k b)).det - 1 ∈ Ideal.span (Set.range (f k))) → Algebra.Etale A (MvPolynomial (Σ k, ι k) A ⧸ Ideal.span (Set.range (fun p : Σ k, σ k => MvPolynomial.rename (Sigma.mk (β := ι) p.1) (f p.1 p.2)))) :=
by
  have wc_standard_etale_quotient : ∀ (A : Type u) [CommRing A] {ι σ : Type} [Fintype ι] [Fintype σ] [DecidableEq σ] (mp : σ → ι), Function.Bijective mp → ∀ (f : σ → MvPolynomial ι A) (g : MvPolynomial ι A), g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) → Algebra.Etale A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) := by
    intro A _ ι σ _ _ _ mp hbij f g hg
    let P : Algebra.PreSubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
      { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
    have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have halg : ∀ x : MvPolynomial ι A,
        algebraMap P.Ring (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
      have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
          (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
        rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
        exact hg
      rw [map_mul, mul_comm] at h1
      exact IsUnit.of_mul_eq_one _ h1
    let Q : Algebra.SubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
      { P with jacobian_isUnit := hunit }
    have hdim : Q.dimension = 0 := by
      show Nat.card ι - Nat.card σ = 0
      rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
    haveI := Q.isStandardSmoothOfRelativeDimension hdim
    infer_instance
  intro A _ n ι σ _ _ _ mp f g hmp hjac
  have blockUnit : ∀ (R : Type u) [CommRing R] (τ : Fin n → Type) [∀ k, Fintype (τ k)]
      [∀ k, DecidableEq (τ k)] (M : ∀ k, Matrix (τ k) (τ k) R),
      (∀ k, IsUnit (M k).det) → IsUnit (Matrix.blockDiagonal' M).det := by
    intro R _ τ _ _ M hM
    choose c hc using fun k => (hM k).exists_left_inv
    have hk : ∀ k, M k * (c k • (M k).adjugate) = 1 := by
      intro k
      rw [Matrix.mul_smul, Matrix.mul_adjugate, smul_smul, hc k, one_smul]
    have hMN : Matrix.blockDiagonal' M *
        Matrix.blockDiagonal' (fun k => c k • (M k).adjugate) = 1 := by
      rw [← Matrix.blockDiagonal'_mul]
      have e : (fun k => M k * (c k • (M k).adjugate)) = fun _ => 1 := funext hk
      rw [e]
      convert Matrix.blockDiagonal'_one
    exact Matrix.isUnit_det_of_right_inverse hMN
  let mp' : (Σ k, σ k) → (Σ k, ι k) := fun p => ⟨p.1, mp p.1 p.2⟩
  have hbij : Function.Bijective mp' := by
    constructor
    · rintro ⟨k, s⟩ ⟨l, t⟩ h
      simp only [mp', Sigma.mk.inj_iff] at h
      obtain ⟨rfl, h2⟩ := h
      have := (hmp k).1 (eq_of_heq h2)
      subst this
      rfl
    · rintro ⟨k, i⟩
      obtain ⟨s, hs⟩ := (hmp k).2 i
      exact ⟨⟨k, s⟩, by simp [mp', hs]⟩
  let r : (Σ k, σ k) → MvPolynomial (Σ k, ι k) A :=
    fun p => MvPolynomial.rename (Sigma.mk (β := ι) p.1) (f p.1 p.2)
  let J : Ideal (MvPolynomial (Σ k, ι k) A) := Ideal.span (Set.range r)
  let q : MvPolynomial (Σ k, ι k) A →+* MvPolynomial (Σ k, ι k) A ⧸ J := Ideal.Quotient.mk J
  let φ : ∀ k, MvPolynomial (ι k) A →+* (MvPolynomial (Σ k, ι k) A ⧸ J) :=
    fun k => q.comp (MvPolynomial.rename (Sigma.mk (β := ι) k)).toRingHom
  have hφf : ∀ k b, φ k (f k b) = 0 := fun k b =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨⟨k, b⟩, rfl⟩)
  have hφker : ∀ k, ∀ x ∈ Ideal.span (Set.range (f k)), φ k x = 0 := by
    intro k x hx
    have hle : Ideal.span (Set.range (f k)) ≤ RingHom.ker (φ k) := by
      rw [Ideal.span_le]
      rintro _ ⟨b, rfl⟩
      exact hφf k b
    exact hle hx
  let M : ∀ k, Matrix (σ k) (σ k) (MvPolynomial (Σ k, ι k) A ⧸ J) :=
    fun k => (Matrix.of fun a b => MvPolynomial.pderiv (mp k a) (f k b)).map (φ k)
  have hMunit : ∀ k, IsUnit (M k).det := by
    intro k
    have h := hφker k _ (hjac k)
    rw [map_sub, map_mul, map_one, sub_eq_zero] at h
    have e : (M k).det = φ k (Matrix.of fun a b => MvPolynomial.pderiv (mp k a) (f k b)).det := by
      rw [RingHom.map_det]
      rfl
    rw [e]
    rw [mul_comm] at h
    exact IsUnit.of_mul_eq_one _ h
  have hblock : (Matrix.of fun a b : (Σ k, σ k) => MvPolynomial.pderiv (mp' a) (r b)).map q =
      Matrix.blockDiagonal' M := by
    ext ⟨k, s⟩ ⟨l, t⟩
    rw [Matrix.map_apply, Matrix.of_apply]
    by_cases hkl : k = l
    · subst hkl
      rw [Matrix.blockDiagonal'_apply_eq]
      show q (MvPolynomial.pderiv (Sigma.mk k (mp k s))
          (MvPolynomial.rename (Sigma.mk (β := ι) k) (f k t))) = _
      rw [MvPolynomial.pderiv_rename sigma_mk_injective]
      rfl
    · rw [Matrix.blockDiagonal'_apply_ne _ _ _ hkl]
      show q (MvPolynomial.pderiv (Sigma.mk k (mp k s))
          (MvPolynomial.rename (Sigma.mk (β := ι) l) (f l t))) = 0
      rw [MvPolynomial.pderiv_eq_zero_of_notMem_vars, map_zero]
      intro hv
      obtain ⟨y, _, hy⟩ := MvPolynomial.mem_vars_rename _ _ hv
      exact hkl (congrArg Sigma.fst hy).symm
  have hBD : IsUnit (Matrix.blockDiagonal' M).det :=
    blockUnit (MvPolynomial (Σ k, ι k) A ⧸ J) σ M hMunit
  have hq : IsUnit (q (Matrix.of fun a b : (Σ k, σ k) => MvPolynomial.pderiv (mp' a) (r b)).det) := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply, hblock]
    exact hBD
  obtain ⟨c, hc⟩ := hq.exists_left_inv
  obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective c
  have hmem : h * (Matrix.of fun a b : (Σ k, σ k) => MvPolynomial.pderiv (mp' a) (r b)).det - 1 ∈ J := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one]
    change Ideal.Quotient.mk J h * q _ - 1 = 0
    rw [hc, sub_self]
  exact wc_standard_etale_quotient A mp' hbij r h hmem

theorem wc_sigma_quotient_solution_lift : ∀ (A : Type u) [CommRing A] (I : Type u) (ι σ : I → Type) (f : ∀ i, σ i → MvPolynomial (ι i) A), (∀ (n : ℕ) (τ : Fin n → I), Function.Injective τ → Algebra.Etale A (MvPolynomial (Σ k, ι (τ k)) A ⧸ Ideal.span (Set.range (fun p : Σ k, σ (τ k) => MvPolynomial.rename (Sigma.mk (β := fun k => ι (τ k)) p.1) (f (τ p.1) p.2))))) → ∀ (N nZ : ℕ) (Z : Fin nZ → MvPolynomial (Fin N) A) (a : Fin N → MvPolynomial (Σ i, ι i) A ⧸ Ideal.span (Set.range (fun p : Σ i, σ i => MvPolynomial.rename (Sigma.mk (β := ι) p.1) (f p.1 p.2)))), (∀ j, MvPolynomial.aeval a (Z j) = 0) → ∃ (E₀ : Type u) (_ : CommRing E₀) (_ : Algebra A E₀), Algebra.Etale A E₀ ∧ ∃ (β₀ : E₀ →ₐ[A] (MvPolynomial (Σ i, ι i) A ⧸ Ideal.span (Set.range (fun p : Σ i, σ i => MvPolynomial.rename (Sigma.mk (β := ι) p.1) (f p.1 p.2))))) (a₀ : Fin N → E₀), (∀ i, β₀ (a₀ i) = a i) ∧ ∀ j, MvPolynomial.aeval a₀ (Z j) = 0 :=
by
  intro A _ I ι σ f hEt N nZ Z a ha
  classical
  let J : Ideal (MvPolynomial (Σ i, ι i) A) := Ideal.span (Set.range (fun p : Σ i, σ i =>
    MvPolynomial.rename (Sigma.mk (β := ι) p.1) (f p.1 p.2)))

  choose p hp using fun t => Ideal.Quotient.mk_surjective (I := J) (a t)
  have hpJ : ∀ l, MvPolynomial.aeval p (Z l) ∈ J := by
    intro l
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk A J, ← AlgHom.comp_apply,
      MvPolynomial.comp_aeval]
    have e : (fun t => Ideal.Quotient.mkₐ A J (p t)) = a :=
      funext fun t => by rw [Ideal.Quotient.mkₐ_eq_mk, hp]
    rw [e]
    exact ha l
  choose c hc using fun l => (Finsupp.mem_ideal_span_range_iff_exists_finsupp).mp (hpJ l)

  let S : Finset I := (Finset.univ.biUnion fun t => (p t).vars.image Sigma.fst) ∪
    (Finset.univ.biUnion fun l => (c l).support.image Sigma.fst)
  have hSa : ∀ t, ∀ x ∈ (p t).vars, x.1 ∈ S := by
    intro t x hx
    exact Finset.mem_union_left _
      (Finset.mem_biUnion.mpr ⟨t, Finset.mem_univ _, Finset.mem_image_of_mem _ hx⟩)
  have hSb : ∀ l, ∀ s ∈ (c l).support, s.1 ∈ S := by
    intro l s hs
    exact Finset.mem_union_right _
      (Finset.mem_biUnion.mpr ⟨l, Finset.mem_univ _, Finset.mem_image_of_mem _ hs⟩)

  obtain ⟨n, τ, hτ, hcov⟩ : ∃ (n : ℕ) (τ : Fin n → I), Function.Injective τ ∧
      ∀ i ∈ S, ∃ k, τ k = i :=
    ⟨S.card, fun k => (S.equivFin.symm k : I),
      Subtype.val_injective.comp S.equivFin.symm.injective,
      fun i hi => ⟨S.equivFin ⟨i, hi⟩, by simp⟩⟩
  let κ : (Σ k, ι (τ k)) → Σ i, ι i := Sigma.map τ (fun _ => id)
  have hκ : Function.Injective κ := hτ.sigma_map (fun _ => Function.injective_id)
  have hrange : ∀ x : (Σ i, ι i), x.1 ∈ S → ∃ y, κ y = x := by
    rintro ⟨i, z⟩ hi
    obtain ⟨k, rfl⟩ := hcov i hi
    exact ⟨⟨k, z⟩, rfl⟩
  set J' : Ideal (MvPolynomial (Σ k, ι (τ k)) A) := Ideal.span (Set.range
    (fun p : Σ k, σ (τ k) => MvPolynomial.rename (Sigma.mk (β := fun k => ι (τ k)) p.1)
      (f (τ p.1) p.2))) with hJ'
  have hren : ∀ (k : Fin n) (b : σ (τ k)),
      MvPolynomial.rename κ (MvPolynomial.rename (Sigma.mk (β := fun k => ι (τ k)) k) (f (τ k) b)) =
        MvPolynomial.rename (Sigma.mk (β := ι) (τ k)) (f (τ k) b) := by
    intro k b
    rw [MvPolynomial.rename_rename]
    rfl

  let Φ : MvPolynomial (Σ k, ι (τ k)) A →ₐ[A] (MvPolynomial (Σ i, ι i) A ⧸ J) :=
    (Ideal.Quotient.mkₐ A J).comp (MvPolynomial.rename κ)
  have hle : J' ≤ RingHom.ker Φ := by
    apply Ideal.span_le.mpr
    rintro _ ⟨⟨k, b⟩, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show Ideal.Quotient.mkₐ A J (MvPolynomial.rename κ
      (MvPolynomial.rename (Sigma.mk (β := fun k => ι (τ k)) k) (f (τ k) b))) = 0
    rw [hren, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨⟨τ k, b⟩, rfl⟩
  let β₀ : (MvPolynomial (Σ k, ι (τ k)) A ⧸ J') →ₐ[A] (MvPolynomial (Σ i, ι i) A ⧸ J) :=
    Ideal.Quotient.liftₐ J' Φ (fun x hx => RingHom.mem_ker.mp (hle hx))
  have hβ₀ : ∀ x, β₀ (Ideal.Quotient.mk J' x) = Ideal.Quotient.mk J (MvPolynomial.rename κ x) := by
    intro x
    rfl

  let K := MvPolynomial.killCompl (R := A) hκ
  have hKp : ∀ t, MvPolynomial.rename κ (K (p t)) = p t := by
    intro t
    obtain ⟨p₀, hp₀⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range (p t) κ hκ (by
      intro x hx
      obtain ⟨y, hy⟩ := hrange x (hSa t x (Finset.mem_coe.mp hx))
      exact ⟨y, hy⟩)
    rw [← hp₀, MvPolynomial.killCompl_rename_app]
  let a₀ : Fin N → (MvPolynomial (Σ k, ι (τ k)) A ⧸ J') := fun t => Ideal.Quotient.mk J' (K (p t))
  have hβ : ∀ t, β₀ (a₀ t) = a t := by
    intro t
    show β₀ (Ideal.Quotient.mk J' (K (p t))) = a t
    rw [hβ₀, hKp, hp]
  have hcomp : MvPolynomial.aeval a₀ =
      ((Ideal.Quotient.mkₐ A J').comp K).comp (MvPolynomial.aeval p) := by
    apply MvPolynomial.algHom_ext
    intro t
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X,
      Ideal.Quotient.mkₐ_eq_mk]
  have hZ : ∀ l, MvPolynomial.aeval a₀ (Z l) = 0 := by
    intro l
    rw [hcomp, AlgHom.comp_apply, AlgHom.comp_apply, ← hc l, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem, map_finsuppSum]
    unfold Finsupp.sum
    refine Ideal.sum_mem _ (fun s hs => ?_)
    dsimp only
    rw [map_mul]
    apply Ideal.mul_mem_left
    rcases s with ⟨i, b⟩
    obtain ⟨k, rfl⟩ := hcov i (hSb l ⟨i, b⟩ hs)
    show K (MvPolynomial.rename (Sigma.mk (β := ι) (τ k)) (f (τ k) b)) ∈ J'
    rw [← hren, MvPolynomial.killCompl_rename_app]
    exact Ideal.subset_span ⟨⟨k, b⟩, rfl⟩
  exact ⟨MvPolynomial (Σ k, ι (τ k)) A ⧸ J', inferInstance, inferInstance, hEt n τ hτ, β₀, a₀,
    hβ, hZ⟩

theorem wc_ret_oneStep : ∀ (A : Type u) [CommRing A], ∃ (A' : Type u) (_ : CommRing A') (φ : A →+* A'), wcIndEtale φ ∧ (∀ (f g : Polynomial A), f.Monic → (∃ (p₁ p₂ : Polynomial A) (n : ℕ), Polynomial.derivative f * p₁ + f * p₂ = g ^ n) → ∀ (m : ℕ) (a : Fin m → A) (F₀ Z W : Polynomial A), F₀.Monic → 0 < F₀.natDegree → f.comp Z ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) → g.comp Z * W - 1 ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) → ∃ (ε : Fin (m + 1) → A') (x : A'), (∀ i, ε i * ε i = ε i) ∧ (∀ i j, i ≠ j → ε i * ε j = 0) ∧ ∑ i, ε i = 1 ∧ (f.map φ).eval x * ε 0 = 0 ∧ (∃ v : A', (g.map φ).eval x * v = ε 0) ∧ ∀ j : Fin m, ∃ w : A', φ (a j) * w = ε j.succ) ∧ ∀ (L : Type u) [Field L] [IsAlgClosed L] (ψ : A →+* L), ∃ ψ' : A' →+* L, ψ'.comp φ = ψ :=
by
  intro A _

  have s6 : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S], (∀ (N nZ : ℕ) (Z : Fin nZ → MvPolynomial (Fin N) R) (a : Fin N → S), (∀ j, MvPolynomial.aeval a (Z j) = 0) → ∃ (E₀ : Type u) (_ : CommRing E₀) (_ : Algebra R E₀), Algebra.Etale R E₀ ∧ ∃ (β₀ : E₀ →ₐ[R] S) (a₀ : Fin N → E₀), (∀ i, β₀ (a₀ i) = a i) ∧ ∀ j, MvPolynomial.aeval a₀ (Z j) = 0) → wcIndEtale (algebraMap R S) := by
    intro R S _ _ _ H
    unfold wcIndEtale
    rw [show (algebraMap R S).toAlgebra = ‹Algebra R S› from
      Algebra.algebra_ext _ _ (fun _ => rfl)]
    intro P _ _ _ h
    obtain ⟨N, qP, hqP, hfg⟩ := Algebra.FinitePresentation.out (R := R) (A := P)
    obtain ⟨nZ, Z, hZ⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hZker : ∀ j, qP (Z j) = 0 := by
      intro j
      have hj : Z j ∈ RingHom.ker qP.toRingHom := by
        rw [← hZ]; exact Submodule.subset_span ⟨j, rfl⟩
      exact RingHom.mem_ker.mp hj
    have hcomp : h.comp qP = MvPolynomial.aeval (fun t => h (qP (MvPolynomial.X t))) := by
      apply MvPolynomial.algHom_ext
      intro t
      simp
    obtain ⟨E₀, _, _, hE₀, β₀, a₀, hβ, ha₀⟩ := H N nZ Z (fun t => h (qP (MvPolynomial.X t)))
      (fun j => by rw [← hcomp, AlgHom.comp_apply, hZker j, map_zero])
    have hle : RingHom.ker qP.toRingHom ≤ RingHom.ker (MvPolynomial.aeval (R := R) a₀).toRingHom := by
      rw [← hZ]
      apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact RingHom.mem_ker.mpr (ha₀ j)
    refine ⟨E₀, inferInstance, inferInstance, hE₀,
      AlgHom.liftOfSurjective qP hqP (MvPolynomial.aeval a₀) hle, β₀, ?_⟩
    apply AlgHom.ext
    intro x
    obtain ⟨p, rfl⟩ := hqP x
    rw [AlgHom.comp_apply, AlgHom.liftOfSurjective_apply, ← AlgHom.comp_apply,
      MvPolynomial.comp_aeval, ← AlgHom.comp_apply h qP, hcomp]
    rw [show (fun i => β₀ (a₀ i)) = (fun t => h (qP (MvPolynomial.X t))) from funext hβ]

  have key : ∀ d : wcCert A, ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (_ : DecidableEq σ)
      (mp : σ → ι) (r : σ → MvPolynomial ι A) (h : MvPolynomial ι A), Function.Bijective mp ∧
      h * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (r j)).det - 1 ∈ Ideal.span (Set.range r) ∧
      (∀ (L : Type u) [Field L] [IsAlgClosed L] (ψ : A →+* L), ∃ v : ι → L,
        ∀ j, MvPolynomial.eval₂ ψ v (r j) = 0) ∧
      ∀ (B : Type u) [CommRing B] [Algebra A B] (w : ι → B), (∀ j, MvPolynomial.aeval w (r j) = 0) →
        ∃ (ε : Fin (d.m + 1) → B) (x : B), (∀ i, ε i * ε i = ε i) ∧ (∀ i j, i ≠ j → ε i * ε j = 0) ∧
          ∑ i, ε i = 1 ∧ (d.f.map (algebraMap A B)).eval x * ε 0 = 0 ∧
          (∃ v : B, (d.g.map (algebraMap A B)).eval x * v = ε 0) ∧
          ∀ j : Fin d.m, ∃ w : B, algebraMap A B (d.a j) * w = ε j.succ := by
    intro d
    obtain ⟨E, _, _, hE, hpts, htr⟩ := wc_cert_etale_algebra A d.f d.g d.hf d.hcond d.m d.a d.F₀
      d.Z d.W d.hF₀ d.hdeg d.h1 d.h2
    obtain ⟨ι, σ, _, _, _, mp, r, val, hmp, hsurj, hker, h, hjac⟩ :=
      wc_etale_standard_presentation A E hE
    refine ⟨ι, σ, inferInstance, inferInstance, inferInstance, mp, r, h, hmp, hjac, ?_, ?_⟩
    · intro L _ _ ψ
      letI : Algebra A L := ψ.toAlgebra
      obtain ⟨e⟩ := hpts L
      refine ⟨fun i => e (val i), fun j => ?_⟩
      have hrj : r j ∈ RingHom.ker (MvPolynomial.aeval (R := A) val) := by
        rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
      have h1 : MvPolynomial.aeval (fun i => e (val i)) (r j) = 0 := by
        rw [← MvPolynomial.comp_aeval, AlgHom.comp_apply, RingHom.mem_ker.mp hrj, map_zero]
      rw [MvPolynomial.aeval_def] at h1
      exact h1
    · intro B _ _ w hw
      apply htr B
      have hle : RingHom.ker (MvPolynomial.aeval (R := A) val).toRingHom ≤
          RingHom.ker (MvPolynomial.aeval (R := A) w).toRingHom := by
        change RingHom.ker (MvPolynomial.aeval (R := A) val) ≤ _
        rw [hker, Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        exact RingHom.mem_ker.mpr (hw j)
      exact ⟨AlgHom.liftOfSurjective _ hsurj _ hle⟩
  choose ι σ instι instσ instdec mp r hh hmp hjac hpts htr using key
  let J : Ideal (MvPolynomial (Σ d, ι d) A) := Ideal.span (Set.range (fun p : Σ d, σ d =>
    MvPolynomial.rename (Sigma.mk (β := ι) p.1) (r p.1 p.2)))

  have s5a : ∀ (d : wcCert A) (j : σ d), MvPolynomial.aeval (R := A)
      (fun x : ι d => Ideal.Quotient.mk J (MvPolynomial.X (Sigma.mk (β := ι) d x))) (r d j) = 0 := by
    intro d j
    have e1 : (fun x : ι d => Ideal.Quotient.mk J (MvPolynomial.X (Sigma.mk (β := ι) d x))) =
        fun x => Ideal.Quotient.mkₐ A J (MvPolynomial.X (Sigma.mk (β := ι) d x)) := rfl
    rw [e1, ← MvPolynomial.comp_aeval, AlgHom.comp_apply]
    have e2 : MvPolynomial.aeval (R := A) (fun x : ι d =>
        (MvPolynomial.X (Sigma.mk (β := ι) d x) : MvPolynomial (Σ d, ι d) A)) (r d j) =
        MvPolynomial.rename (Sigma.mk (β := ι) d) (r d j) := by
      first
        | rfl
        | exact ((MvPolynomial.aeval_X_left_apply _).symm.trans (MvPolynomial.aeval_rename _ _ _)).symm
    rw [e2, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨⟨d, j⟩, rfl⟩
  refine ⟨MvPolynomial (Σ d, ι d) A ⧸ J, inferInstance, algebraMap A _, ?_, ?_, ?_⟩
  ·
    apply s6
    apply wc_sigma_quotient_solution_lift A (wcCert A) ι σ r
    intro n τ _
    exact @wc_sigma_presentation_etale A _ n (fun k => ι (τ k)) (fun k => σ (τ k))
      (fun k => instι (τ k)) (fun k => instσ (τ k)) (fun k => instdec (τ k)) (fun k => mp (τ k))
      (fun k => r (τ k)) (fun k => hh (τ k)) (fun k => hmp (τ k)) (fun k => hjac (τ k))
  ·
    intro f g hf hcond m a F₀ Z W hF₀ hdeg h1 h2
    let d : wcCert A := ⟨f, g, hf, hcond, m, a, F₀, Z, W, hF₀, hdeg, h1, h2⟩
    exact htr d _ (fun x => Ideal.Quotient.mk J (MvPolynomial.X (Sigma.mk (β := ι) d x))) (s5a d)
  ·
    intro L _ _ ψ
    choose v hv using fun d => hpts d L ψ
    let V : (Σ d, ι d) → L := fun x => v x.1 x.2
    have hle : J ≤ RingHom.ker (MvPolynomial.eval₂Hom ψ V) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨⟨d, j⟩, rfl⟩
      show MvPolynomial.eval₂ ψ V (MvPolynomial.rename (Sigma.mk (β := ι) d) (r d j)) = 0
      rw [MvPolynomial.eval₂_rename]
      exact hv d j
    refine ⟨Ideal.Quotient.lift J (MvPolynomial.eval₂Hom ψ V)
      (fun x hx => RingHom.mem_ker.mp (hle hx)), ?_⟩
    ext x
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk,
      MvPolynomial.algebraMap_eq]
    simp

theorem wc_seq_colimit_exists : ∀ (G : ℕ → Type u) [∀ k, CommRing (G k)] (φ : ∀ k, G k →+* G (k + 1)), ∃ (T : Type u) (_ : CommRing T) (ι : ∀ k, G k →+* T) (Φ : ∀ k, G 0 →+* G k), Φ 0 = RingHom.id (G 0) ∧ (∀ k, Φ (k + 1) = (φ k).comp (Φ k)) ∧ (∀ k, (ι (k + 1)).comp (φ k) = ι k) ∧ (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) ∧ (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j), (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) ∧ ∀ (L : Type u) [CommRing L], (∀ k (ψ : G k →+* L), ∃ ψ' : G (k + 1) →+* L, ψ'.comp (φ k) = ψ) → ∀ ψ0 : G 0 →+* L, ∃ Ψ : T →+* L, Ψ.comp (ι 0) = ψ0 :=
by
  intro G _ φ
  classical

  obtain ⟨F, hself, hsucc⟩ : ∃ F : ∀ i j, i ≤ j → (G i →+* G j),
      (∀ i (h : i ≤ i), F i i h = RingHom.id (G i)) ∧
      (∀ i j (h : i ≤ j) (h' : i ≤ j + 1), F i (j + 1) h' = (φ j).comp (F i j h)) :=
    ⟨fun i j h => Nat.leRecOn (C := fun k => G i →+* G k) h (fun {k} g => (φ k).comp g)
        (RingHom.id (G i)),
      fun i h => Nat.leRecOn_self _, fun i j h h' => Nat.leRecOn_succ h _⟩
  have hcomp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k) (hik : i ≤ k),
      (F j k hjk).comp (F i j hij) = F i k hik := by
    intro i j k hij hjk
    induction k, hjk using Nat.le_induction with
    | base => intro hik; rw [hself, RingHom.id_comp]
    | succ k hjk ih =>
      intro hik
      rw [hsucc j k hjk, hsucc i k (hij.trans hjk), RingHom.comp_assoc, ih]
  have : DirectedSystem G (fun i j h => F i j h) :=
    { map_self := fun i x => RingHom.congr_fun (hself i _) x
      map_map := fun k j i hij hjk x => RingHom.congr_fun (hcomp i j k hij hjk _) x }
  have OF : ∀ i j (h : i ≤ j), (Ring.DirectLimit.of G (fun i j h => F i j h) j).comp (F i j h) =
      Ring.DirectLimit.of G (fun i j h => F i j h) i :=
    fun i j h => RingHom.ext fun x => Ring.DirectLimit.of_f (G := G) (f := fun i j h => F i j h) h x
  have hstep : ∀ k, F k (k + 1) (Nat.le_succ k) = φ k := by
    intro k
    rw [hsucc k k le_rfl, hself, RingHom.comp_id]
  refine ⟨Ring.DirectLimit G (fun i j h => F i j h), inferInstance,
    fun k => Ring.DirectLimit.of G (fun i j h => F i j h) k, fun k => F 0 k (Nat.zero_le k),
    hself 0 _, fun k => hsucc 0 k _ _, ?_, ?_, ?_, ?_⟩
  · intro k
    rw [← hstep k]
    exact OF k (k + 1) _
  · intro n t
    choose kk y hy using fun i =>
      Ring.DirectLimit.exists_of (G := G) (f := fun i j h => F i j h) (t i)
    obtain ⟨M, hM⟩ := Finite.exists_le kk
    refine ⟨M, fun i => F (kk i) M (hM i) (y i), fun i => ?_⟩
    rw [← hy i]
    exact Ring.DirectLimit.of_f (G := G) (f := fun i j h => F i j h) (hM i) (y i)
  · intro k n x hx
    have hx' : ∀ i, Ring.DirectLimit.of G (fun i j h => F i j h) k (x i) = 0 := hx
    choose jj hkj hz using fun i => Ring.DirectLimit.of.zero_exact (f' := F) (hx' i)
    obtain ⟨M, hM⟩ := Finite.exists_le jj
    refine ⟨max k M, F k (max k M) (le_max_left _ _), OF _ _ _,
      hcomp 0 k _ _ _ _, fun i => ?_⟩
    rw [← hcomp k (jj i) (max k M) (hkj i) ((hM i).trans (le_max_right _ _)),
      RingHom.comp_apply, hz i, map_zero]
  · intro L _ hL ψ0
    obtain ⟨ψ, hψ0, hψs⟩ : ∃ ψ : ∀ k, G k →+* L, ψ 0 = ψ0 ∧ ∀ k, (ψ (k + 1)).comp (φ k) = ψ k :=
      ⟨fun k => Nat.rec (motive := fun k => G k →+* L) ψ0
          (fun k ψk => Classical.choose (hL k ψk)) k,
        rfl, fun k => Classical.choose_spec (hL k _)⟩
    have hψc : ∀ i j (h : i ≤ j), (ψ j).comp (F i j h) = ψ i := by
      intro i j h
      induction j, h using Nat.le_induction with
      | base => rw [hself, RingHom.comp_id]
      | succ j hij ih => rw [hsucc i j hij, ← RingHom.comp_assoc, hψs, ih]
    refine ⟨Ring.DirectLimit.lift G (fun i j h => F i j h) L ψ
      (fun i j hij x => RingHom.congr_fun (hψc i j hij) x), ?_⟩
    ext x
    simp only [RingHom.comp_apply, Ring.DirectLimit.lift_of, hψ0]

theorem wc_seq_colimit_indEtale : ∀ (R T : Type u) [CommRing R] [CommRing T] (σ : R →+* T) (G : ℕ → Type u) [∀ k, CommRing (G k)] (Φ : ∀ k, R →+* G k) (ι : ∀ k, G k →+* T), (∀ k, (ι k).comp (Φ k) = σ) → (∀ k, wcIndEtale (Φ k)) → (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) → (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j), (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) → wcIndEtale σ :=
by
  intro R T _ _ σ G _ Φ ι hcomp hind hlift hvan
  unfold wcIndEtale
  letI : Algebra R T := σ.toAlgebra
  intro P _ _ _ h
  obtain ⟨N, q, hq, hfg⟩ := Algebra.FinitePresentation.out (R := R) (A := P)
  obtain ⟨nZ, Z, hZ⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hqZ : ∀ l, q (Z l) = 0 := by
    intro l
    have hm : Z l ∈ RingHom.ker q.toRingHom := by
      rw [← hZ]; exact Submodule.subset_span ⟨l, rfl⟩
    exact (RingHom.mem_ker).mp hm
  let a : Fin N → T := fun t => h (q (MvPolynomial.X t))
  have haeval : MvPolynomial.aeval a = h.comp q := by
    apply MvPolynomial.algHom_ext
    intro t
    simp [a]
  have ha0 : ∀ l, MvPolynomial.eval₂ σ a (Z l) = 0 := by
    intro l
    have := AlgHom.congr_fun haeval (Z l)
    rw [AlgHom.comp_apply, hqZ, map_zero, MvPolynomial.aeval_def] at this
    exact this
  obtain ⟨k, x, hx⟩ := hlift N a
  let z : Fin nZ → G k := fun l => MvPolynomial.eval₂ (Φ k) x (Z l)
  have hz : ∀ l, ι k (z l) = 0 := by
    intro l
    show ι k (MvPolynomial.eval₂ (Φ k) x (Z l)) = 0
    rw [MvPolynomial.eval₂_comp_left, hcomp k]
    have hxa : (⇑(ι k) ∘ x) = a := funext hx
    rw [hxa]
    exact ha0 l
  obtain ⟨j, θ, hθι, hθΦ, hθz⟩ := hvan k nZ z hz
  let y : Fin N → G j := fun t => θ (x t)
  have hy : ∀ l, MvPolynomial.eval₂ (Φ j) y (Z l) = 0 := by
    intro l
    rw [← hθΦ]
    show MvPolynomial.eval₂ (θ.comp (Φ k)) (⇑θ ∘ x) (Z l) = 0
    rw [← MvPolynomial.eval₂_comp_left]
    exact hθz l
  letI : Algebra R (G j) := (Φ j).toAlgebra
  let g : MvPolynomial (Fin N) R →ₐ[R] G j := MvPolynomial.aeval y
  have hker : RingHom.ker q.toRingHom ≤ RingHom.ker g.toRingHom := by
    rw [← hZ]
    apply Submodule.span_le.mpr
    rintro _ ⟨l, rfl⟩
    exact RingHom.mem_ker.mpr (hy l)
  let hj := AlgHom.liftOfSurjective q hq g hker
  have hjX : ∀ t, hj (q (MvPolynomial.X t)) = θ (x t) := by
    intro t
    simp [hj, AlgHom.liftOfSurjective_apply, g, y]
  have hI := hind j
  unfold wcIndEtale at hI
  obtain ⟨E, iE, aE, hE, α, β, hαβ⟩ := hI P hj
  let ιj : G j →ₐ[R] T :=
    { toRingHom := ι j, commutes' := fun r => RingHom.congr_fun (hcomp j) r }
  refine ⟨E, iE, aE, hE, α, ιj.comp β, ?_⟩
  have key : ((ιj.comp β).comp α).comp q = h.comp q := by
    apply MvPolynomial.algHom_ext
    intro t
    simp only [AlgHom.comp_apply]
    rw [← AlgHom.comp_apply β α, hαβ, hjX]
    show ι j (θ (x t)) = a t
    rw [← hx t, ← RingHom.comp_apply, hθι]
  apply AlgHom.ext
  intro p
  obtain ⟨m, rfl⟩ := hq p
  exact AlgHom.congr_fun key m

theorem wc_seq_colimit_ret : ∀ (T : Type u) [CommRing T] (G : ℕ → Type u) [∀ k, CommRing (G k)] (φ : ∀ k, G k →+* G (k + 1)) (ι : ∀ k, G k →+* T), (∀ k, (ι (k + 1)).comp (φ k) = ι k) → (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) → (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j), (ι j).comp θ = ι k ∧ ∀ i, θ (x i) = 0) → (∀ (k : ℕ) (f g : Polynomial (G k)), f.Monic → (∃ (p₁ p₂ : Polynomial (G k)) (n : ℕ), Polynomial.derivative f * p₁ + f * p₂ = g ^ n) → ∀ (m : ℕ) (a : Fin m → G k) (F₀ Z W : Polynomial (G k)), F₀.Monic → 0 < F₀.natDegree → f.comp Z ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) → g.comp Z * W - 1 ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) → ∃ (ε : Fin (m + 1) → G (k + 1)) (x : G (k + 1)), (∀ i, ε i * ε i = ε i) ∧ (∀ i j, i ≠ j → ε i * ε j = 0) ∧ ∑ i, ε i = 1 ∧ (f.map (φ k)).eval x * ε 0 = 0 ∧ (∃ v : G (k + 1), (g.map (φ k)).eval x * v = ε 0) ∧ ∀ j : Fin m, ∃ w : G (k + 1), φ k (a j) * w = ε j.succ) → wcRET T :=
by
  intro T _ G _ φ ι hcomp hlift hvan hRet
  classical

  have H1 : ∀ (κ : Type) [Fintype κ] (p : κ → Polynomial T), ∃ (k : ℕ) (q : κ → Polynomial (G k)),
      ∀ i, (q i).map (ι k) = p i ∧ ((p i).Monic → (q i).Monic ∧ (q i).natDegree = (p i).natDegree) := by
    intro κ _ p
    obtain ⟨D, hD⟩ : ∃ D, ∀ i, (p i).natDegree ≤ D :=
      ⟨_, fun i => Finset.le_sup (f := fun i => (p i).natDegree) (Finset.mem_univ i)⟩
    let e := Fintype.equivFin (κ × Fin (D + 1))
    obtain ⟨k, x, hx⟩ := hlift _ (fun l => (p (e.symm l).1).coeff (e.symm l).2)
    have hq0 : ∀ i, (∑ r : Fin (D + 1), Polynomial.C (x (e (i, r))) * Polynomial.X ^ (r : ℕ)).map (ι k)
        = p i := by
      intro i
      rw [Polynomial.map_sum]
      simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C, Polynomial.map_X, hx,
        Equiv.symm_apply_apply]
      rw [Fin.sum_univ_eq_sum_range (fun r => Polynomial.C ((p i).coeff r) * Polynomial.X ^ r) (D + 1)]
      simp only [Polynomial.C_mul_X_pow_eq_monomial]
      exact (Polynomial.as_sum_range' (p i) (D + 1) (Nat.lt_succ_of_le (hD i))).symm
    have hmon : ∀ i, (p i).Monic → ∃ q' : Polynomial (G k), q'.map (ι k) = p i ∧
        q'.natDegree = (p i).natDegree ∧ q'.Monic := fun i hm =>
      Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.mem_lifts _).mpr ⟨_, hq0 i⟩) hm
    refine ⟨k, fun i => if h : (p i).Monic then (hmon i h).choose
      else ∑ r : Fin (D + 1), Polynomial.C (x (e (i, r))) * Polynomial.X ^ (r : ℕ), fun i => ?_⟩
    by_cases h : (p i).Monic
    · simp only [dif_pos h]
      obtain ⟨h1, h2, h3⟩ := (hmon i h).choose_spec
      exact ⟨h1, fun _ => ⟨h3, h2⟩⟩
    · simp only [dif_neg h]
      exact ⟨hq0 i, fun h' => absurd h' h⟩

  have H2 : ∀ (k : ℕ) (κ : Type) [Fintype κ] (q : κ → Polynomial (G k)), (∀ i, (q i).map (ι k) = 0) →
      ∃ (j : ℕ) (θ : G k →+* G j), (ι j).comp θ = ι k ∧ ∀ i, (q i).map θ = 0 := by
    intro k κ _ q hq
    obtain ⟨D, hD⟩ : ∃ D, ∀ i, (q i).natDegree ≤ D :=
      ⟨_, fun i => Finset.le_sup (f := fun i => (q i).natDegree) (Finset.mem_univ i)⟩
    let e := Fintype.equivFin (κ × Fin (D + 1))
    obtain ⟨j, θ, hθ, hx⟩ := hvan k _ (fun l => (q (e.symm l).1).coeff (e.symm l).2) (fun l => by
      rw [← Polynomial.coeff_map, hq, Polynomial.coeff_zero])
    refine ⟨j, θ, hθ, fun i => Polynomial.ext fun s => ?_⟩
    rw [Polynomial.coeff_map, Polynomial.coeff_zero]
    by_cases hs : s ≤ D
    · have := hx (e (i, ⟨s, Nat.lt_succ_of_le hs⟩))
      simpa only [Equiv.symm_apply_apply] using this
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hD i) (not_le.mp hs)), map_zero]
  unfold wcRET
  intro f g hf hpairEx m a F₀ Z W hF₀ hdeg hmem₁ hmem₂
  obtain ⟨p₁, p₂, n, hpair⟩ := hpairEx
  rcases subsingleton_or_nontrivial T with hT | hT
  · exact ⟨0, 0, fun _ => Subsingleton.elim _ _, fun _ _ _ => Subsingleton.elim _ _,
      Subsingleton.elim _ _, Subsingleton.elim _ _, ⟨0, Subsingleton.elim _ _⟩,
      fun _ => ⟨0, Subsingleton.elim _ _⟩⟩

  obtain ⟨c₀, z, hz, hE2⟩ := Ideal.mem_span_insert.mp hmem₁
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hz
  obtain ⟨d₀, z', hz', hE3⟩ := Ideal.mem_span_insert.mp hmem₂
  obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.mp hz'
  rw [← hc] at hE2
  rw [← hd] at hE3

  obtain ⟨k, Q, hQ⟩ := H1 (Fin 9 ⊕ (Fin m ⊕ (Fin m ⊕ Fin m)))
    (Sum.elim ![f, g, p₁, p₂, F₀, Z, W, c₀, d₀]
      (Sum.elim c (Sum.elim d (fun j => Polynomial.C (a j)))))
  obtain ⟨fL, hfL, hfmon⟩ : ∃ fL : Polynomial (G k), fL.map (ι k) = f ∧ fL.Monic :=
    ⟨Q (Sum.inl 0), (hQ _).1, ((hQ (Sum.inl 0)).2 hf).1⟩
  obtain ⟨F0L, hF0L, hF0mon, hF0deg⟩ : ∃ F0L : Polynomial (G k), F0L.map (ι k) = F₀ ∧ F0L.Monic ∧
      F0L.natDegree = F₀.natDegree :=
    ⟨Q (Sum.inl 4), (hQ _).1, ((hQ (Sum.inl 4)).2 hF₀).1, ((hQ (Sum.inl 4)).2 hF₀).2⟩
  obtain ⟨gL, hgL⟩ : ∃ gL : Polynomial (G k), gL.map (ι k) = g := ⟨Q (Sum.inl 1), (hQ _).1⟩
  obtain ⟨p1L, hp1L⟩ : ∃ p1L : Polynomial (G k), p1L.map (ι k) = p₁ := ⟨Q (Sum.inl 2), (hQ _).1⟩
  obtain ⟨p2L, hp2L⟩ : ∃ p2L : Polynomial (G k), p2L.map (ι k) = p₂ := ⟨Q (Sum.inl 3), (hQ _).1⟩
  obtain ⟨ZL, hZL⟩ : ∃ ZL : Polynomial (G k), ZL.map (ι k) = Z := ⟨Q (Sum.inl 5), (hQ _).1⟩
  obtain ⟨WL, hWL⟩ : ∃ WL : Polynomial (G k), WL.map (ι k) = W := ⟨Q (Sum.inl 6), (hQ _).1⟩
  obtain ⟨c0L, hc0L⟩ : ∃ c0L : Polynomial (G k), c0L.map (ι k) = c₀ := ⟨Q (Sum.inl 7), (hQ _).1⟩
  obtain ⟨d0L, hd0L⟩ : ∃ d0L : Polynomial (G k), d0L.map (ι k) = d₀ := ⟨Q (Sum.inl 8), (hQ _).1⟩
  obtain ⟨cL, hcL⟩ : ∃ cL : Fin m → Polynomial (G k), ∀ j, (cL j).map (ι k) = c j :=
    ⟨fun j => Q (Sum.inr (Sum.inl j)), fun j => (hQ _).1⟩
  obtain ⟨dL, hdL⟩ : ∃ dL : Fin m → Polynomial (G k), ∀ j, (dL j).map (ι k) = d j :=
    ⟨fun j => Q (Sum.inr (Sum.inr (Sum.inl j))), fun j => (hQ _).1⟩
  obtain ⟨aL, haL⟩ : ∃ aL : Fin m → G k, ∀ j, ι k (aL j) = a j :=
    ⟨fun j => (Q (Sum.inr (Sum.inr (Sum.inr j)))).coeff 0, fun j => by
      rw [← Polynomial.coeff_map, (hQ _).1]
      exact Polynomial.coeff_C_zero⟩
  clear hQ Q

  obtain ⟨D1, hD1def⟩ : ∃ D : Polynomial (G k),
      D = Polynomial.derivative fL * p1L + fL * p2L - gL ^ n := ⟨_, rfl⟩
  obtain ⟨D2, hD2def⟩ : ∃ D : Polynomial (G k),
      D = fL.comp ZL - (c0L * F0L + ∑ j, cL j * Polynomial.C (aL j)) := ⟨_, rfl⟩
  obtain ⟨D3, hD3def⟩ : ∃ D : Polynomial (G k),
      D = gL.comp ZL * WL - 1 - (d0L * F0L + ∑ j, dL j * Polynomial.C (aL j)) := ⟨_, rfl⟩
  have hD1 : D1.map (ι k) = 0 := by
    rw [hD1def]
    simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_pow,
      ← Polynomial.derivative_map, hfL, hgL, hp1L, hp2L]
    exact sub_eq_zero.mpr hpair
  have hD2 : D2.map (ι k) = 0 := by
    rw [hD2def]
    simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_comp,
      Polynomial.map_sum, Polynomial.map_C, hfL, hZL, hc0L, hF0L, hcL, haL]
    exact sub_eq_zero.mpr hE2
  have hD3 : D3.map (ι k) = 0 := by
    rw [hD3def]
    simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_comp,
      Polynomial.map_sum, Polynomial.map_C, Polynomial.map_one, hgL, hZL, hWL, hd0L, hF0L, hdL, haL]
    exact sub_eq_zero.mpr hE3

  obtain ⟨j, θ, hθ, hkill⟩ := H2 k (Fin 3) ![D1, D2, D3] (by
    intro i
    fin_cases i
    · exact hD1
    · exact hD2
    · exact hD3)
  have e1 : D1.map θ = 0 := hkill 0
  have e2 : D2.map θ = 0 := hkill 1
  have e3 : D3.map θ = 0 := hkill 2
  rw [hD1def] at e1
  rw [hD2def] at e2
  rw [hD3def] at e3
  simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_pow,
    ← Polynomial.derivative_map] at e1
  simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_comp,
    Polynomial.map_sum, Polynomial.map_C] at e2
  simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_comp,
    Polynomial.map_sum, Polynomial.map_C, Polynomial.map_one] at e3
  haveI : Nontrivial (G j) := RingHom.domain_nontrivial (ι j)
  have hmem1' : (fL.map θ).comp (ZL.map θ) ∈ Ideal.span (insert (F0L.map θ)
      (Set.range (fun i => Polynomial.C (θ (aL i))))) := by
    rw [sub_eq_zero.mp e2]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
      (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _
        (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  have hmem2' : (gL.map θ).comp (ZL.map θ) * WL.map θ - 1 ∈ Ideal.span (insert (F0L.map θ)
      (Set.range (fun i => Polynomial.C (θ (aL i))))) := by
    rw [sub_eq_zero.mp e3]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
      (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _
        (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  obtain ⟨ε, x, hid, horth, hsum, hfx, ⟨v, hv⟩, hw⟩ := hRet j (fL.map θ) (gL.map θ) (hfmon.map θ)
    ⟨p1L.map θ, p2L.map θ, n, sub_eq_zero.mp e1⟩ m (fun i => θ (aL i)) (F0L.map θ) (ZL.map θ)
    (WL.map θ) (hF0mon.map θ) (by rw [hF0mon.natDegree_map θ, hF0deg]; exact hdeg) hmem1' hmem2'

  have hfj : (fL.map θ).map (ι j) = f := by rw [Polynomial.map_map, hθ, hfL]
  have hgj : (gL.map θ).map (ι j) = g := by rw [Polynomial.map_map, hθ, hgL]
  have hev : ∀ h : Polynomial (G j), (h.map (ι j)).eval (ι (j + 1) x) =
      ι (j + 1) ((h.map (φ j)).eval x) := by
    intro h
    rw [← hcomp j, ← Polynomial.map_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
  refine ⟨fun i => ι (j + 1) (ε i), ι (j + 1) x, fun i => by rw [← map_mul, hid],
    fun i i' h => by rw [← map_mul, horth i i' h, map_zero], by rw [← map_sum, hsum, map_one],
    ?_, ⟨ι (j + 1) v, ?_⟩, fun i => ?_⟩
  · rw [← hfj, hev, ← map_mul, hfx, map_zero]
  · rw [← hgj, hev, ← map_mul, hv]
  · obtain ⟨w, hw'⟩ := hw i
    refine ⟨ι (j + 1) w, ?_⟩
    show a i * ι (j + 1) w = ι (j + 1) (ε i.succ)
    rw [← hw', map_mul, ← RingHom.comp_apply (ι (j + 1)) (φ j), hcomp j,
      ← RingHom.comp_apply (ι j) θ, hθ, haL]

theorem wc_retCover_exists : ∀ (C : Type u) [CommRing C], ∃ (T : Type u) (_ : CommRing T) (_ : Algebra C T), Module.FaithfullyFlat C T ∧ wcIndEtale (algebraMap C T) ∧ wcRET T :=
by
  intro C _

  have hstep := fun (A : CommRingCat.{u}) => wc_ret_oneStep A
  choose A' instA' φA hInd hRet hLift using hstep
  let Gc : ℕ → CommRingCat.{u} := fun k =>
    Nat.rec (motive := fun _ => CommRingCat.{u}) (CommRingCat.of C)
      (fun _ X => @CommRingCat.of (A' X) (instA' X)) k
  let φ : ∀ k, Gc k →+* Gc (k + 1) := fun k => by exact φA (Gc k)

  obtain ⟨T, _, ι, Φ, hΦ0, hΦs, hιφ, hlift, hvan, hext⟩ :=
    wc_seq_colimit_exists (fun k => Gc k) φ

  have hΦind : ∀ k, wcIndEtale (Φ k) := by
    intro k
    induction k with
    | zero =>
      rw [hΦ0]
      unfold wcIndEtale
      rw [show (RingHom.id (Gc 0)).toAlgebra = Algebra.id _ from
        Algebra.algebra_ext _ _ (fun _ => rfl)]
      intro Q _ _ _ h
      exact ⟨Gc 0, inferInstance, inferInstance, inferInstance, h, AlgHom.id _ _, AlgHom.id_comp h⟩
    | succ k ih =>
      rw [hΦs k]
      exact wc_indEtale_comp (Φ k) (φ k) ih (hInd (Gc k))
  have hιΦ : ∀ k, (ι k).comp (Φ k) = ι 0 := by
    intro k
    induction k with
    | zero => rw [hΦ0, RingHom.comp_id]
    | succ k ih => rw [hΦs k, ← RingHom.comp_assoc, hιφ k, ih]

  letI : Algebra C T := (ι 0).toAlgebra
  have hInd0 : wcIndEtale (algebraMap C T) :=
    wc_seq_colimit_indEtale C T (ι 0) (fun k => Gc k) Φ ι hιΦ hΦind hlift hvan
  have hWE := wc_indEtale_weaklyEtale (algebraMap C T) hInd0
  have hCT : Algebra.WeaklyEtale C T := by
    rwa [show (algebraMap C T).toAlgebra = ‹Algebra C T› from
      Algebra.algebra_ext _ _ (fun _ => rfl)] at hWE
  haveI : Module.Flat C T := hCT.flat
  have hL : ∀ (L : Type u) [Field L] [IsAlgClosed L] (ψ : C →+* L),
      ∃ ψ' : T →+* L, ψ'.comp (algebraMap C T) = ψ := by
    intro L _ _ ψ
    exact hext L (fun k ψk => hLift (Gc k) L ψk) ψ

  have hFF : Module.FaithfullyFlat C T := by
    apply Module.FaithfullyFlat.of_comap_surjective
    intro p
    let K := FractionRing (C ⧸ p.asIdeal)
    let L := AlgebraicClosure K
    let ψ : C →+* L :=
      (algebraMap K L).comp ((algebraMap (C ⧸ p.asIdeal) K).comp (Ideal.Quotient.mk p.asIdeal))
    obtain ⟨ψ', hψ'⟩ := hL L ψ
    refine ⟨⟨RingHom.ker ψ', RingHom.ker_isPrime ψ'⟩, ?_⟩
    ext x
    show x ∈ Ideal.comap (algebraMap C T) (RingHom.ker ψ') ↔ x ∈ p.asIdeal
    rw [RingHom.comap_ker, hψ', RingHom.mem_ker]
    have hinj1 : Function.Injective (algebraMap K L) := (algebraMap K L).injective
    have hinj2 : Function.Injective (algebraMap (C ⧸ p.asIdeal) K) :=
      IsFractionRing.injective (C ⧸ p.asIdeal) K
    constructor
    · intro hx
      have h1 : algebraMap (C ⧸ p.asIdeal) K (Ideal.Quotient.mk p.asIdeal x) = 0 :=
        hinj1 (by rw [map_zero]; exact hx)
      have h2 : Ideal.Quotient.mk p.asIdeal x = 0 := hinj2 (by rw [map_zero]; exact h1)
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
    · intro hx
      show algebraMap K L (algebraMap (C ⧸ p.asIdeal) K (Ideal.Quotient.mk p.asIdeal x)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero, map_zero]
  have hRETT : wcRET T :=
    wc_seq_colimit_ret T (fun k => Gc k) φ ι hιφ hlift
      (fun k n x hx => by
        obtain ⟨j, θ, h1, _, h3⟩ := hvan k n x hx
        exact ⟨j, θ, h1, h3⟩)
      (fun k => hRet (Gc k))
  exact ⟨T, inferInstance, (ι 0).toAlgebra, hFF, hInd0, hRETT⟩

theorem wc_indEtale_of_local_split : ∀ (S T : Type u) [CommRing S] [CommRing T] [Algebra S T], (∀ (n : ℕ) (g : Fin n → T), Ideal.span (Set.range g) = ⊤ → ∃ e : Fin n → T, (∀ i, e i * e i = e i) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ c : T, c * g i = e i) → (∀ (M : Ideal T) [M.IsMaximal], wcIndEtale ((algebraMap T (Localization.AtPrime M)).comp (algebraMap S T))) → wcIndEtale (algebraMap S T) :=
by
  intro S T _ _ _ hsplit hloc

  have s2X : ∀ (n : ℕ) (e : Fin n → T), (∀ i, e i * e i = e i) →
      (∀ i j, i ≠ j → e i * e j = 0) → ∑ i, e i = 1 →
      Function.Bijective (RingHom.pi (fun i => algebraMap T (Localization.Away (e i)))) := by
    intro n e hid horth hsum
    have hK : ∀ i, algebraMap T (Localization.Away (e i)) (e i) = 1 := by
      intro i
      have hu := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (e i)) (e i)
      apply hu.mul_left_cancel
      rw [← map_mul, hid, mul_one]
    have hK' : ∀ i j, j ≠ i → algebraMap T (Localization.Away (e i)) (e j) = 0 := by
      intro i j hji
      rw [← mul_one (algebraMap T _ (e j)), ← hK i, ← map_mul, horth j i hji, map_zero]
    constructor
    · rw [injective_iff_map_eq_zero]
      intro t ht
      have h1 : ∀ i, e i * t = 0 := by
        intro i
        have h3 : algebraMap T (Localization.Away (e i)) t = 0 := congrFun ht i
        have h2 : algebraMap T (Localization.Away (e i)) (e i * t) =
            algebraMap T (Localization.Away (e i)) 0 := by
          rw [map_mul, map_zero, h3, mul_zero]
        obtain ⟨k, hk⟩ := IsLocalization.Away.exists_of_eq (e i) h2
        rw [mul_zero, ← mul_assoc, ← pow_succ, IsIdempotentElem.pow_succ_eq k (hid i)] at hk
        exact hk
      calc t = (∑ i, e i) * t := by rw [hsum, one_mul]
        _ = ∑ i, e i * t := Finset.sum_mul _ _ _
        _ = 0 := Finset.sum_eq_zero (fun i _ => h1 i)
    · intro x
      have hpre : ∀ i, ∃ a : T, algebraMap T (Localization.Away (e i)) a = x i := by
        intro i
        obtain ⟨⟨a, d⟩, hd⟩ := IsLocalization.surj (Submonoid.powers (e i)) (x i)
        obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp d.2
        refine ⟨a, ?_⟩
        simp only at hd
        rw [← hk, map_pow, hK, one_pow, mul_one] at hd
        exact hd.symm
      choose a ha using hpre
      refine ⟨∑ j, e j * a j, ?_⟩
      funext i
      rw [RingHom.pi_apply, map_sum, Finset.sum_eq_single i]
      · rw [map_mul, hK, one_mul, ha]
      · intro j _ hji
        rw [map_mul, hK' i j hji, zero_mul]
      · intro hi; exact absurd (Finset.mem_univ i) hi

  have s3X : ∀ (g : {M : Ideal T // M.IsMaximal} → T), (∀ M, g M ∉ M.1) →
      ∃ (n : ℕ) (m : Fin n → {M : Ideal T // M.IsMaximal}),
        Ideal.span (Set.range (fun i => g (m i))) = ⊤ := by
    classical
    intro g hg
    have htop : Ideal.span (Set.range g) = ⊤ := by
      by_contra h
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ h
      exact hg ⟨M, hM⟩ (hle (Ideal.subset_span ⟨⟨M, hM⟩, rfl⟩))
    obtain ⟨s', hs', hspan⟩ := (Ideal.span_eq_top_iff_finite _).mp htop
    have hpre : ∀ x : s', ∃ M, g M = x := fun x => hs' x.2
    choose pre hpre using hpre
    refine ⟨s'.card, fun i => pre (s'.equivFin.symm i), ?_⟩
    rw [eq_top_iff, ← hspan]
    apply Ideal.span_mono
    intro x hx
    refine ⟨s'.equivFin ⟨x, hx⟩, ?_⟩
    simp [hpre]

  have s1X : ∀ (P E : Type u) [CommRing P] [CommRing E] [Algebra S P] [Algebra S E]
      [Algebra.FiniteType S P] [Algebra.FinitePresentation S E]
      (M : Ideal T) [M.IsPrime] (h : P →ₐ[S] T) (α : P →ₐ[S] E)
      (β : E →ₐ[S] Localization.AtPrime M),
      β.comp α = (IsScalarTower.toAlgHom S T (Localization.AtPrime M)).comp h →
      ∃ g : T, g ∉ M ∧ ∀ (B : Type u) [CommRing B] [Algebra S B] (θ : T →ₐ[S] B), IsUnit (θ g) →
        ∃ β' : E →ₐ[S] B, β'.comp α = θ.comp h := by
    classical
    intro P E _ _ _ _ _ _ M _ h α β hαβ
    obtain ⟨r, π, hπ, hker⟩ := Algebra.FinitePresentation.out (R := S) (A := E)
    obtain ⟨Rs, hRs⟩ := hker
    obtain ⟨Q, hQ⟩ := Algebra.FiniteType.out (R := S) (A := P)
    choose q hq using fun p : P => hπ (α p)
    choose x hx using fun i : Fin r =>
      IsLocalization.surj M.primeCompl (β (π (MvPolynomial.X i)))
    have hDN : (∏ i, ((x i).2 : T)) ∈ M.primeCompl :=
      Submonoid.prod_mem _ (fun i _ => (x i).2.2)
    set D : T := ∏ i, ((x i).2 : T) with hD
    have hιD : IsUnit (algebraMap T (Localization.AtPrime M) D) :=
      IsLocalization.map_units (Localization.AtPrime M) (⟨D, hDN⟩ : M.primeCompl)
    set j : Localization.Away D →+* Localization.AtPrime M :=
      IsLocalization.Away.lift D hιD with hjdef
    have hj : ∀ t, j (algebraMap T (Localization.Away D) t) =
        algebraMap T (Localization.AtPrime M) t :=
      IsLocalization.Away.lift_eq D hιD
    have hκD : IsUnit (algebraMap T (Localization.Away D) D) :=
      IsLocalization.Away.algebraMap_isUnit D
    have hκs : ∀ i, IsUnit (algebraMap T (Localization.Away D) (x i).2) := fun i =>
      isUnit_of_dvd_unit (map_dvd _ (Finset.dvd_prod_of_mem (fun i => ((x i).2 : T))
        (Finset.mem_univ i))) hκD
    set y : Fin r → Localization.Away D :=
      fun i => algebraMap T (Localization.Away D) (x i).1 * ↑(hκs i).unit⁻¹ with hydef
    have hy : ∀ i, j (y i) = β (π (MvPolynomial.X i)) := by
      intro i
      have hιs : IsUnit (algebraMap T (Localization.AtPrime M) (x i).2) :=
        IsLocalization.map_units (Localization.AtPrime M) (x i).2
      apply hιs.mul_right_cancel
      rw [hx i, ← hj, ← hj, ← map_mul]
      congr 1
      rw [hydef, mul_assoc, IsUnit.val_inv_mul, mul_one]
    set Y : MvPolynomial (Fin r) S →ₐ[S] Localization.Away D := MvPolynomial.aeval y with hYdef
    have hjY : ∀ q, j (Y q) = β (π q) := by
      intro q
      have : j.comp (Y : MvPolynomial (Fin r) S →+* Localization.Away D) =
          ((β.comp π : MvPolynomial (Fin r) S →ₐ[S] Localization.AtPrime M) :
            MvPolynomial (Fin r) S →+* Localization.AtPrime M) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          show j (Y (MvPolynomial.C c)) = β (π (MvPolynomial.C c))
          rw [MvPolynomial.algHom_C, MvPolynomial.algHom_C, AlgHom.commutes,
            IsScalarTower.algebraMap_apply S T (Localization.Away D), hj,
            ← IsScalarTower.algebraMap_apply]
        · intro i
          show j (Y (MvPolynomial.X i)) = β (π (MvPolynomial.X i))
          rw [hYdef, MvPolynomial.aeval_X, hy]
      exact RingHom.congr_fun this q
    have kill : ∀ z : Localization.Away D, j z = 0 →
        ∃ t : T, t ∉ M ∧ algebraMap T (Localization.Away D) t * z = 0 := by
      intro z hz
      obtain ⟨⟨a, d⟩, had⟩ := IsLocalization.surj (Submonoid.powers D) z
      simp only at had
      have h1 : algebraMap T (Localization.AtPrime M) a = 0 := by
        rw [← hj, ← had, map_mul, hz, zero_mul]
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M.primeCompl _ a).mp h1
      refine ⟨m, m.2, ?_⟩
      have hdu : IsUnit (algebraMap T (Localization.Away D) d) := by
        obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp d.2
        rw [← hk, map_pow]; exact hκD.pow k
      apply hdu.mul_right_cancel
      rw [zero_mul, mul_assoc, had, ← map_mul, hm, map_zero]
    have hRker : ∀ R ∈ Rs, π R = 0 := fun R hR => by
      have : R ∈ RingHom.ker π.toRingHom := hRs ▸ Ideal.subset_span hR
      exact (RingHom.mem_ker).mp this
    have hkR : ∀ R : Rs, ∃ t : T, t ∉ M ∧ algebraMap T (Localization.Away D) t * Y R = 0 :=
      fun R => kill _ (by rw [hjY, hRker R R.2, map_zero])
    choose tR htRM htR using hkR
    have hkQ : ∀ p : Q, ∃ t : T, t ∉ M ∧
        algebraMap T (Localization.Away D) t *
          (Y (q p) - algebraMap T (Localization.Away D) (h p)) = 0 :=
      fun p => kill _ (by
        rw [map_sub, hjY, hq, hj]
        have := AlgHom.congr_fun hαβ p
        simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] at this
        rw [this, sub_self])
    choose tQ htQM htQ using hkQ
    refine ⟨D * (∏ R : Rs, tR R) * ∏ p : Q, tQ p, ?_, ?_⟩
    · exact M.primeCompl.mul_mem (M.primeCompl.mul_mem hDN
        (Submonoid.prod_mem _ fun R _ => htRM R)) (Submonoid.prod_mem _ fun p _ => htQM p)
    intro B _ _ θ hθg
    have hdvd : ∀ t : T, t ∣ D * (∏ R : Rs, tR R) * ∏ p : Q, tQ p → IsUnit (θ t) :=
      fun t ht => isUnit_of_dvd_unit (map_dvd θ ht) hθg
    have hθD : IsUnit ((θ : T →+* B) D) := hdvd D ((dvd_mul_right D _).mul_right _)
    set θD : Localization.Away D →+* B := IsLocalization.Away.lift D hθD with hθDdef
    have hθDκ : ∀ t, θD (algebraMap T (Localization.Away D) t) = θ t :=
      IsLocalization.Away.lift_eq D hθD
    set Φ : MvPolynomial (Fin r) S →ₐ[S] B := MvPolynomial.aeval (fun i => θD (y i)) with hΦdef
    have hΦ : ∀ q, Φ q = θD (Y q) := by
      intro q
      have : (Φ : MvPolynomial (Fin r) S →+* B) =
          θD.comp (Y : MvPolynomial (Fin r) S →+* Localization.Away D) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          show Φ (MvPolynomial.C c) = θD (Y (MvPolynomial.C c))
          rw [MvPolynomial.algHom_C, MvPolynomial.algHom_C,
            IsScalarTower.algebraMap_apply S T (Localization.Away D), hθDκ, AlgHom.commutes]
        · intro i
          show Φ (MvPolynomial.X i) = θD (Y (MvPolynomial.X i))
          rw [hΦdef, hYdef, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      exact RingHom.congr_fun this q
    have hkerle : RingHom.ker π.toRingHom ≤ RingHom.ker Φ.toRingHom := by
      rw [← hRs, Ideal.span_le]
      intro R hR
      show Φ R = 0
      rw [hΦ]
      have h1 := congrArg θD (htR ⟨R, hR⟩)
      rw [map_mul, hθDκ, map_zero] at h1
      exact (hdvd _ (((Finset.dvd_prod_of_mem _ (Finset.mem_univ _)).mul_left D).mul_right _)
        ).mul_right_eq_zero.mp h1
    refine ⟨π.liftOfSurjective hπ Φ hkerle, ?_⟩
    apply AlgHom.ext_of_adjoin_eq_top hQ
    intro p hp
    show π.liftOfSurjective hπ Φ hkerle (α p) = θ (h p)
    rw [← hq p, AlgHom.liftOfSurjective_apply, hΦ]
    have h1 := congrArg θD (htQ ⟨p, hp⟩)
    rw [map_mul, hθDκ, map_zero, map_sub, hθDκ] at h1
    exact sub_eq_zero.mp ((hdvd _ ((Finset.dvd_prod_of_mem _ (Finset.mem_univ _)).mul_left _)
      ).mul_right_eq_zero.mp h1)

  have hloc' : ∀ (M : Ideal T) [M.IsMaximal] (P : Type u) [CommRing P] [Algebra S P]
      [Algebra.FinitePresentation S P] (h : P →ₐ[S] Localization.AtPrime M),
      ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E), Algebra.Etale S E ∧
        ∃ (α : P →ₐ[S] E) (β : E →ₐ[S] Localization.AtPrime M), β.comp α = h := by
    intro M _
    have h0 := hloc M
    unfold wcIndEtale at h0
    rwa [show ((algebraMap T (Localization.AtPrime M)).comp (algebraMap S T)).toAlgebra =
      (inferInstance : Algebra S (Localization.AtPrime M)) from
      Algebra.algebra_ext _ _ (fun s => (IsScalarTower.algebraMap_apply S T _ s).symm)] at h0
  unfold wcIndEtale
  rw [show (algebraMap S T).toAlgebra = ‹Algebra S T› from
    Algebra.algebra_ext _ _ (fun _ => rfl)]
  intro P _ _ _ h
  have hM : ∀ M : {M : Ideal T // M.IsMaximal}, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E),
      Algebra.Etale S E ∧ ∃ (α : P →ₐ[S] E) (g : T), g ∉ M.1 ∧
        ∀ (B : Type u) [CommRing B] [Algebra S B] (θ : T →ₐ[S] B), IsUnit (θ g) →
          ∃ β' : E →ₐ[S] B, β'.comp α = θ.comp h := by
    intro M
    have := M.2
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hloc' M.1 P ((IsScalarTower.toAlgHom S T _).comp h)
    obtain ⟨g, hg, hlift⟩ := s1X P E M.1 h α β hαβ
    exact ⟨E, _, _, hE, α, g, hg, hlift⟩
  choose E iE aE hE α g hg hlift using hM
  obtain ⟨n, m, hspan⟩ := s3X g hg
  obtain ⟨e, hid, horth, hsum, hc⟩ := hsplit n (fun i => g (m i)) hspan
  have hbij := s2X n e hid horth hsum
  have hunit : ∀ i, IsUnit ((IsScalarTower.toAlgHom S T (Localization.Away (e i))) (g (m i))) := by
    intro i
    obtain ⟨c, hci⟩ := hc i
    apply isUnit_of_mul_isUnit_right (x := algebraMap T (Localization.Away (e i)) c)
    rw [IsScalarTower.toAlgHom_apply, ← map_mul, hci]
    exact IsLocalization.Away.algebraMap_isUnit (e i)
  choose β' hβ' using fun i =>
    hlift (m i) (Localization.Away (e i)) (IsScalarTower.toAlgHom S T _) (hunit i)
  let Θ : T →ₐ[S] ((i : Fin n) → Localization.Away (e i)) :=
    AlgHom.pi (fun i => IsScalarTower.toAlgHom S T _)
  have hΘ : Function.Bijective Θ := hbij
  let Ψ := (AlgEquiv.ofBijective Θ hΘ).symm
  refine ⟨(i : Fin n) → E (m i), inferInstance, inferInstance, inferInstance,
    AlgHom.pi (fun i => α (m i)),
    Ψ.toAlgHom.comp (AlgHom.pi (fun i => (β' i).comp (Pi.evalAlgHom S (fun i => E (m i)) i))), ?_⟩
  apply AlgHom.ext
  intro p
  apply hΘ.1
  have e1 : Θ (Ψ ((AlgHom.pi (fun i => (β' i).comp (Pi.evalAlgHom S (fun i => E (m i)) i)))
      ((AlgHom.pi (fun i => α (m i))) p))) =
      (AlgHom.pi (fun i => (β' i).comp (Pi.evalAlgHom S (fun i => E (m i)) i)))
      ((AlgHom.pi (fun i => α (m i))) p) := (AlgEquiv.ofBijective Θ hΘ).apply_symm_apply _
  simp only [AlgHom.comp_apply]
  refine Eq.trans e1 ?_
  funext i
  have := AlgHom.congr_fun (hβ' i) p
  simpa [Θ] using this

theorem wc_ret_stalk_strictlyHenselian : ∀ (T : Type u) [CommRing T], wcRET T → ∀ (M : Ideal T) [M.IsMaximal], HenselianLocalRing (Localization.AtPrime M) ∧ IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime M)) :=
by
  classical
  intro T _ hRET M hMmax
  have F1 : ∀ t : T, algebraMap T (Localization.AtPrime M) t ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime M) ↔ t ∈ M :=
    fun t => IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime M) M t
  haveI hnt : Nontrivial T :=
    ⟨⟨0, 1, fun h => hMmax.ne_top ((Ideal.eq_top_iff_one M).mpr (h ▸ M.zero_mem))⟩⟩

  have LSP : ∀ (f g : Polynomial T), f.Monic →
      (∃ (p₁ p₂ : Polynomial T) (n : ℕ), Polynomial.derivative f * p₁ + f * p₂ = g ^ n) →
      ∀ (m : ℕ) (a : Fin m → T) (F₀ Z W : Polynomial T), F₀.Monic → 0 < F₀.natDegree →
      f.comp Z ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) →
      g.comp Z * W - 1 ∈ Ideal.span (insert F₀ (Set.range (fun j => Polynomial.C (a j)))) →
      (∀ j, a j ∈ M) → ∃ x : T, algebraMap T (Localization.AtPrime M) (f.eval x) = 0 ∧
        IsUnit (algebraMap T (Localization.AtPrime M) (g.eval x)) := by
    intro f g hf hpair m a F₀ Z W hF₀ hdeg hfZ hgZ haM
    obtain ⟨ε, x, hid, -, hsum, hfx, ⟨v, hv⟩, hw⟩ :=
      hRET f g hf hpair m a F₀ Z W hF₀ hdeg hfZ hgZ
    have hzero : ∀ j : Fin m, algebraMap T (Localization.AtPrime M) (ε j.succ) = 0 := by
      intro j
      obtain ⟨w, hw'⟩ := hw j
      have hem : algebraMap T (Localization.AtPrime M) (ε j.succ) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime M) :=
        (F1 _).mpr (hw' ▸ M.mul_mem_right w (haM j))
      have hee : algebraMap T (Localization.AtPrime M) (ε j.succ) *
          algebraMap T (Localization.AtPrime M) (ε j.succ) =
          algebraMap T (Localization.AtPrime M) (ε j.succ) := by
        rw [← map_mul, hid]
      have hne : ¬ IsUnit (algebraMap T (Localization.AtPrime M) (ε j.succ)) :=
        (IsLocalRing.mem_maximalIdeal _).mp hem
      have hu : IsUnit (1 - algebraMap T (Localization.AtPrime M) (ε j.succ)) :=
        (IsLocalRing.isUnit_or_isUnit_one_sub_self _).resolve_left hne
      have h0 : (1 - algebraMap T (Localization.AtPrime M) (ε j.succ)) *
          algebraMap T (Localization.AtPrime M) (ε j.succ) = 0 := by
        rw [sub_mul, one_mul, hee, sub_self]
      exact hu.mul_right_eq_zero.mp h0
    have hε0 : algebraMap T (Localization.AtPrime M) (ε 0) = 1 := by
      have h := congrArg (algebraMap T (Localization.AtPrime M)) hsum
      rw [map_sum, Fin.sum_univ_succ, map_one] at h
      simpa [hzero] using h
    refine ⟨x, ?_, ?_⟩
    · have h := congrArg (algebraMap T (Localization.AtPrime M)) hfx
      rwa [map_mul, hε0, mul_one, map_zero] at h
    · have h := congrArg (algebraMap T (Localization.AtPrime M)) hv
      rw [map_mul, hε0] at h
      exact IsUnit.of_mul_eq_one _ h

  have hroot : ∀ (G : Polynomial T), G.Monic → G.coeff 0 ∈ M → G.coeff 1 ∉ M →
      ∃ x ∈ M, algebraMap T (Localization.AtPrime M) (G.eval x) = 0 := by
    intro G hG h0 h1
    have h11 : G.coeff 1 * G.coeff 1 ∉ M := fun h =>
      ((Ideal.IsMaximal.isPrime hMmax).mem_or_mem h).elim h1 h1
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv hMmax h11
    have mem1 : G.comp 0 ∈ Ideal.span (insert Polynomial.X
        (Set.range (fun j => Polynomial.C ((![G.coeff 0, i] : Fin 2 → T) j)))) := by
      rw [Polynomial.comp_zero, ← Polynomial.coeff_zero_eq_eval_zero]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨0, rfl⟩)
    have hev : (Polynomial.derivative G * G.divX).eval 0 = G.coeff 1 * G.coeff 1 := by
      rw [Polynomial.eval_mul, ← Polynomial.coeff_zero_eq_eval_zero,
        ← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_derivative, Polynomial.coeff_divX]
      simp
    have hi' : i = 1 - y * (G.coeff 1 * G.coeff 1) := by rw [← hyi]; ring
    have mem2 : (Polynomial.derivative G * G.divX).comp 0 * Polynomial.C y - 1 ∈
        Ideal.span (insert Polynomial.X
          (Set.range (fun j => Polynomial.C ((![G.coeff 0, i] : Fin 2 → T) j)))) := by
      have heq : (Polynomial.derivative G * G.divX).comp 0 * Polynomial.C y - 1 =
          -Polynomial.C i := by
        rw [Polynomial.comp_zero, hev, hi']
        simp only [map_sub, map_one, map_mul]
        ring
      rw [heq]
      exact (Ideal.neg_mem_iff _).mpr (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨1, rfl⟩))
    obtain ⟨x, hx1, hx2⟩ := LSP G (Polynomial.derivative G * G.divX) hG
      ⟨G.divX, 0, 1, by ring⟩ 2 ![G.coeff 0, i] Polynomial.X 0 (Polynomial.C y)
      Polynomial.monic_X (by rw [Polynomial.natDegree_X]; exact Nat.one_pos) mem1 mem2
      (Fin.forall_fin_two.mpr ⟨h0, hi⟩)
    refine ⟨x, ?_, hx1⟩
    rw [Polynomial.eval_mul, map_mul] at hx2
    have hd := isUnit_of_mul_isUnit_right hx2
    have hGx := congrArg (fun p => algebraMap T (Localization.AtPrime M) (p.eval x))
      (Polynomial.divX_mul_X_add G)
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C,
      map_add, map_mul] at hGx
    rw [hx1] at hGx
    rw [← F1]
    have hxe : algebraMap T (Localization.AtPrime M) x =
        -((↑hd.unit⁻¹ : Localization.AtPrime M) *
          algebraMap T (Localization.AtPrime M) (G.coeff 0)) := by
      have h2 : algebraMap T (Localization.AtPrime M) (G.divX.eval x) *
          algebraMap T (Localization.AtPrime M) x =
          -algebraMap T (Localization.AtPrime M) (G.coeff 0) := eq_neg_of_add_eq_zero_left hGx
      calc algebraMap T (Localization.AtPrime M) x
          = (↑hd.unit⁻¹ : Localization.AtPrime M) *
            (algebraMap T (Localization.AtPrime M) (G.divX.eval x) *
              algebraMap T (Localization.AtPrime M) x) := by
            rw [← mul_assoc, hd.val_inv_mul, one_mul]
        _ = _ := by rw [h2, mul_neg]
    rw [hxe]
    exact (Ideal.neg_mem_iff _).mpr (Ideal.mul_mem_left _ _ ((F1 _).mpr h0))

  have hens : HenselianLocalRing (Localization.AtPrime M) := by
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ hfa hf'a
    have hh : (f.comp (Polynomial.X + Polynomial.C a₀)).Monic := hf.comp_X_add_C a₀
    have hh0 : (f.comp (Polynomial.X + Polynomial.C a₀)).coeff 0 = f.eval a₀ := by
      rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp]
      simp
    have hh1 : (f.comp (Polynomial.X + Polynomial.C a₀)).coeff 1 =
        (Polynomial.derivative f).eval a₀ := by
      have h3 := Polynomial.coeff_derivative (f.comp (Polynomial.X + Polynomial.C a₀)) 0
      simp only [Nat.cast_zero, zero_add, mul_one] at h3
      rw [← h3, Polynomial.coeff_zero_eq_eval_zero, Polynomial.derivative_comp]
      simp [Polynomial.eval_comp]
    obtain ⟨⟨s, hs⟩, hsint⟩ := IsLocalization.exist_integer_multiples_of_finset M.primeCompl
      ((Finset.range ((f.comp (Polynomial.X + Polynomial.C a₀)).natDegree + 1)).image
        (f.comp (Polynomial.X + Polynomial.C a₀)).coeff)
    have hσ : IsUnit (algebraMap T (Localization.AtPrime M) s) :=
      IsLocalization.map_units (Localization.AtPrime M) (⟨s, hs⟩ : M.primeCompl)
    generalize hgen : f.comp (Polynomial.X + Polynomial.C a₀) = h at hh hh0 hh1 hsint
    have hd1 : 1 ≤ h.natDegree := by
      by_contra hcon
      have h1 : h = 1 := Polynomial.eq_one_of_monic_natDegree_zero hh (by omega)
      rw [h1, Polynomial.coeff_one_zero] at hh0
      rw [← hh0] at hfa
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr hfa)
    have hint : ∀ i, i ≤ h.natDegree → ∃ t : T,
        algebraMap T (Localization.AtPrime M) t = algebraMap T (Localization.AtPrime M) s * h.coeff i := by
      intro i hi
      obtain ⟨t, ht⟩ := hsint (h.coeff i)
        (Finset.mem_image_of_mem _ (Finset.mem_range.mpr (by omega)))
      refine ⟨t, ?_⟩
      rw [ht]
      exact Algebra.smul_def _ _
    have hHm : (h.scaleRoots (algebraMap T (Localization.AtPrime M) s)).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hh
    have hHlift : h.scaleRoots (algebraMap T (Localization.AtPrime M) s) ∈
        Polynomial.lifts (algebraMap T (Localization.AtPrime M)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy n h.natDegree with hn | hn | hn
      · obtain ⟨t, ht⟩ := hint n hn.le
        refine ⟨t * s ^ (h.natDegree - n - 1), ?_⟩
        rw [map_mul, ht, map_pow]
        generalize hk : h.natDegree - n - 1 = k
        rw [show h.natDegree - n = k + 1 by omega, pow_succ]
        ring
      · refine ⟨1, ?_⟩
        rw [hn, Nat.sub_self, pow_zero, mul_one, map_one, hh.coeff_natDegree]
      · refine ⟨0, ?_⟩
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hn, zero_mul, map_zero]
    obtain ⟨G, hGmap, -, hGm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hHlift hHm
    have hGc : ∀ n, algebraMap T (Localization.AtPrime M) (G.coeff n) =
        (h.scaleRoots (algebraMap T (Localization.AtPrime M) s)).coeff n := by
      intro n; rw [← Polynomial.coeff_map, hGmap]
    have hG0 : G.coeff 0 ∈ M := by
      rw [← F1, hGc, Polynomial.coeff_scaleRoots, hh0]
      exact Ideal.mul_mem_right _ _ hfa
    have hG1 : G.coeff 1 ∉ M := by
      rw [← F1, hGc, Polynomial.coeff_scaleRoots, hh1, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, not_not]
      exact hf'a.mul (hσ.pow _)
    obtain ⟨x, hxM, hx⟩ := hroot G hGm hG0 hG1
    have hHx : (h.scaleRoots (algebraMap T (Localization.AtPrime M) s)).eval
        (algebraMap T (Localization.AtPrime M) x) = 0 := by
      rw [← hGmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hx]
    have hr : algebraMap T (Localization.AtPrime M) s *
        ((↑hσ.unit⁻¹ : Localization.AtPrime M) * algebraMap T (Localization.AtPrime M) x) =
        algebraMap T (Localization.AtPrime M) x := by
      rw [← mul_assoc, hσ.mul_val_inv, one_mul]
    have hhr : h.eval ((↑hσ.unit⁻¹ : Localization.AtPrime M) *
        algebraMap T (Localization.AtPrime M) x) = 0 := by
      have h4 := Polynomial.scaleRoots_eval_mul h
        ((↑hσ.unit⁻¹ : Localization.AtPrime M) * algebraMap T (Localization.AtPrime M) x)
        (algebraMap T (Localization.AtPrime M) s)
      rw [hr, hHx] at h4
      exact (hσ.pow _).mul_right_eq_zero.mp h4.symm
    refine ⟨(↑hσ.unit⁻¹ : Localization.AtPrime M) * algebraMap T (Localization.AtPrime M) x + a₀,
      ?_, ?_⟩
    · show f.eval _ = 0
      have h5 : h.eval ((↑hσ.unit⁻¹ : Localization.AtPrime M) *
          algebraMap T (Localization.AtPrime M) x) =
          f.eval ((↑hσ.unit⁻¹ : Localization.AtPrime M) *
            algebraMap T (Localization.AtPrime M) x + a₀) := by
        rw [← hgen, Polynomial.eval_comp]
        simp
      rw [← h5, hhr]
    · rw [add_sub_cancel_right]
      exact Ideal.mul_mem_left _ _ ((F1 x).mpr hxM)

  have hsep : IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime M)) := by
    let π : T →+* IsLocalRing.ResidueField (Localization.AtPrime M) :=
      (IsLocalRing.residue _).comp (algebraMap T (Localization.AtPrime M))
    have hker : ∀ t, π t = 0 ↔ t ∈ M := fun t => by
      simp only [π, RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff]
      exact F1 t
    have hπs : Function.Surjective π := by
      intro b
      obtain ⟨b', rfl⟩ := IsLocalRing.residue_surjective b
      obtain ⟨⟨t, ⟨s, hs⟩⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl b'
      obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv hMmax hs
      refine ⟨t * y, ?_⟩
      simp only [π, RingHom.comp_apply]
      rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      have hm : IsLocalization.mk' (Localization.AtPrime M) (1 : T) (⟨s, hs⟩ : M.primeCompl) *
          algebraMap T (Localization.AtPrime M) s = 1 :=
        (IsLocalization.mk'_spec (Localization.AtPrime M) (1 : T) (⟨s, hs⟩ : M.primeCompl)).trans
          (map_one _)
      have heq : IsLocalization.mk' (Localization.AtPrime M) t (⟨s, hs⟩ : M.primeCompl) -
          algebraMap T (Localization.AtPrime M) (t * y) =
          algebraMap T (Localization.AtPrime M) (t * i) *
            IsLocalization.mk' (Localization.AtPrime M) (1 : T) (⟨s, hs⟩ : M.primeCompl) := by
        have hi' : i = 1 - y * s := by rw [← hyi]; ring
        rw [IsLocalization.mk'_eq_mul_mk'_one, hi']
        simp only [map_mul, map_sub, map_one]
        linear_combination (algebraMap T (Localization.AtPrime M) t *
          algebraMap T (Localization.AtPrime M) y) * hm
      rw [heq]
      exact Ideal.mul_mem_right _ _ ((F1 _).mpr (M.mul_mem_left t hi))
    apply IsSepClosed.of_exists_root
    intro p hpm hpirr hpsep
    have hpdeg : 0 < p.natDegree := by
      rcases Nat.eq_zero_or_pos p.natDegree with h0 | h0
      · have hp1 := Polynomial.eq_one_of_monic_natDegree_zero hpm h0
        exact absurd (by rw [hp1]; exact isUnit_one) hpirr.not_isUnit
      · exact h0
    obtain ⟨F, hFmap, hFdeg, hFm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr (Polynomial.map_surjective π hπs p)) hpm
    obtain ⟨u, v, huv⟩ := hpsep
    obtain ⟨U, rfl⟩ := Polynomial.map_surjective π hπs u
    obtain ⟨V, rfl⟩ := Polynomial.map_surjective π hπs v
    have hDmap : (U * F + V * Polynomial.derivative F - 1).map π = 0 := by
      rw [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
        ← Polynomial.derivative_map, hFmap, Polynomial.map_one, huv, sub_self]
    have hDM : ∀ k, (U * F + V * Polynomial.derivative F - 1).coeff k ∈ M := fun k =>
      (hker _).mp (by rw [← Polynomial.coeff_map, hDmap, Polynomial.coeff_zero])
    generalize hDdef : U * F + V * Polynomial.derivative F - 1 = D at hDM
    have hDI : D ∈ Ideal.span (insert F (Set.range
        (fun j : Fin (D.natDegree + 1) => Polynomial.C (D.coeff j)))) := by
      have hmem : (∑ k ∈ Finset.range (D.natDegree + 1),
          Polynomial.C (D.coeff k) * Polynomial.X ^ k) ∈ Ideal.span (insert F (Set.range
          (fun j : Fin (D.natDegree + 1) => Polynomial.C (D.coeff j)))) :=
        Ideal.sum_mem _ (fun k hk => Ideal.mul_mem_right _ _
          (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨⟨k, Finset.mem_range.mp hk⟩, rfl⟩)))
      rwa [← Polynomial.as_sum_range_C_mul_X_pow D] at hmem
    have mem1 : F.comp Polynomial.X ∈ Ideal.span (insert F (Set.range
        (fun j : Fin (D.natDegree + 1) => Polynomial.C (D.coeff j)))) := by
      rw [Polynomial.comp_X]
      exact Ideal.subset_span (Set.mem_insert _ _)
    have mem2 : (Polynomial.derivative F).comp Polynomial.X * V - 1 ∈ Ideal.span (insert F
        (Set.range (fun j : Fin (D.natDegree + 1) => Polynomial.C (D.coeff j)))) := by
      have heq : (Polynomial.derivative F).comp Polynomial.X * V - 1 = D - U * F := by
        rw [Polynomial.comp_X, ← hDdef]
        ring
      rw [heq]
      exact Ideal.sub_mem _ hDI (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
    obtain ⟨x, hx, -⟩ := LSP F (Polynomial.derivative F) hFm ⟨1, 0, 1, by ring⟩
      (D.natDegree + 1) (fun j => D.coeff j) F Polynomial.X V hFm
      (by rw [hFdeg]; exact hpdeg) mem1 mem2 (fun j => hDM j)
    refine ⟨π x, ?_⟩
    rw [← hFmap, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    simp only [π, RingHom.comp_apply, hx, map_zero]
  exact ⟨hens, hsep⟩

theorem wc_localization_weaklyEtale : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (M : Submonoid A) [IsLocalization M L], Algebra.WeaklyEtale A L :=
by
  intro A L _ _ _ M _
  haveI hc : TensorProduct.CompatibleSMul A L L L :=
    IsLocalization.tensorProduct_compatibleSMul M L L L
  have key : ∀ z : TensorProduct A L L,
      z = (Algebra.TensorProduct.lmul' A (S := L) z) ⊗ₜ[A] (1 : L) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, TensorProduct.zero_tmul]
    | tmul a b =>
      rw [Algebra.TensorProduct.lmul'_apply_tmul]
      have h := TensorProduct.smul_tmul (R := A) b a (1 : L)
      rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
      exact h.symm
    | add x y hx hy =>
      rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
  have hbij : Function.Bijective (Algebra.TensorProduct.lmul' A (S := L)) := by
    refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[A] (1 : L), ?_⟩⟩
    · rw [key z₁, key z₂, h]
    · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
  exact Algebra.WeaklyEtale.mk (IsLocalization.flat L M)
    (RingHom.Flat.of_bijective (f := (Algebra.TensorProduct.lmul' A (S := L)).toRingHom) hbij)

theorem wc_sh_localization_indEtale : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (M : Submonoid A) [IsLocalization M L], wcIndEtale (algebraMap A L) :=
by
  intro A L _ _ _ M _
  unfold wcIndEtale
  rw [show (algebraMap A L).toAlgebra = ‹Algebra A L› from
    Algebra.algebra_ext _ _ (fun _ => rfl)]
  intro P _ _ _ h
  obtain ⟨m, fP, hsurj, hker⟩ := Algebra.FinitePresentation.out (R := A) (A := P)
  obtain ⟨r, K, hK⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hker
  have hKz : ∀ k, fP (K k) = 0 := by
    intro k
    have hk : K k ∈ RingHom.ker fP.toRingHom := by
      rw [← hK]; exact Submodule.subset_span ⟨k, rfl⟩
    exact hk
  let x : Fin m → L := fun t => h (fP (MvPolynomial.X t))
  have hhx : ∀ q : MvPolynomial (Fin m) A, MvPolynomial.aeval x q = h (fP q) := by
    intro q
    have e : h.comp fP = MvPolynomial.aeval x := by
      apply MvPolynomial.algHom_ext
      intro t
      simp [x]
    rw [← e]; rfl
  have hxK : ∀ k, MvPolynomial.aeval x (K k) = 0 := fun k => by rw [hhx, hKz, map_zero]

  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite M x
  have hb' : ∀ t, ∃ a : A, algebraMap A L a = (b : A) • x t := fun t => hb t
  choose a ha using hb'
  let E1 := Localization.Away (b : A)
  let w : Fin m → E1 := fun t =>
    IsLocalization.mk' E1 (a t) (⟨(b : A), Submonoid.mem_powers _⟩ : Submonoid.powers (b : A))
  have hbL : IsUnit (algebraMap A L (b : A)) := IsLocalization.map_units L b
  have key : ∀ (γ : E1 →ₐ[A] L) t, γ (w t) = x t := by
    intro γ t
    have h1 := IsLocalization.mk'_spec E1 (a t)
      (⟨(b : A), Submonoid.mem_powers _⟩ : Submonoid.powers (b : A))
    have h2 := congrArg γ h1
    rw [map_mul, AlgHom.commutes, AlgHom.commutes, ha t] at h2
    have h3 : γ (w t) * algebraMap A L (b : A) = x t * algebraMap A L (b : A) := by
      rw [mul_comm (x t), ← Algebra.smul_def]
      exact h2
    exact hbL.mul_right_cancel h3
  have hcomp : ∀ (γ : E1 →ₐ[A] L) (q : MvPolynomial (Fin m) A),
      γ (MvPolynomial.aeval w q) = MvPolynomial.aeval x q := by
    intro γ q
    have e1 := congrArg (fun F : MvPolynomial (Fin m) A →ₐ[A] L => F q) (MvPolynomial.comp_aeval w γ)
    have hf : (fun i => γ (w i)) = x := funext (key γ)
    rw [hf] at e1
    exact e1
  let β1 : E1 →ₐ[A] L :=
    AlgHom.mk (IsLocalization.Away.lift (b : A) hbL) (fun r => IsLocalization.Away.lift_eq (b : A) hbL r)

  have hy : ∀ k, ∃ (c : A) (n : ℕ),
      MvPolynomial.aeval w (K k) * algebraMap A E1 ((b : A) ^ n) = algebraMap A E1 c := by
    intro k
    obtain ⟨⟨c, p⟩, hcp⟩ := IsLocalization.surj (Submonoid.powers (b : A)) (MvPolynomial.aeval w (K k))
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp p.2
    refine ⟨c, n, ?_⟩
    rw [hn]
    exact hcp
  choose c n hcn using hy
  have hcL : ∀ k, algebraMap A L (c k) = 0 := by
    intro k
    have h1 := congrArg β1 (hcn k)
    rw [map_mul, AlgHom.commutes, AlgHom.commutes, hcomp β1, hxK, zero_mul] at h1
    exact h1.symm
  have hμ' : ∀ k, ∃ μ : M, (μ : A) * c k = 0 := fun k =>
    (IsLocalization.map_eq_zero_iff M L (c k)).mp (hcL k)
  choose μ hμ using hμ'

  let s : A := (b : A) * ∏ k, (μ k : A)
  have hsM : s ∈ M := M.mul_mem b.2 (M.prod_mem (fun k _ => (μ k).2))
  let E := Localization.Away s
  have hsE : IsUnit (algebraMap A E s) := IsLocalization.Away.algebraMap_isUnit s
  have hdvdU : ∀ d : A, d ∣ s → IsUnit (algebraMap A E d) :=
    fun d hd => isUnit_of_dvd_unit (map_dvd _ hd) hsE
  have hbE : IsUnit (algebraMap A E (b : A)) := hdvdU _ (dvd_mul_right _ _)
  have hμE : ∀ k, IsUnit (algebraMap A E (μ k : A)) := fun k =>
    hdvdU _ (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ (Finset.mem_univ k)) _)
  let ι : E1 →ₐ[A] E :=
    AlgHom.mk (IsLocalization.Away.lift (b : A) hbE) (fun r => IsLocalization.Away.lift_eq (b : A) hbE r)
  let e : Fin m → E := fun t => ι (w t)
  have hcompE : ∀ q : MvPolynomial (Fin m) A, MvPolynomial.aeval e q = ι (MvPolynomial.aeval w q) := by
    intro q
    have e1 := congrArg (fun F : MvPolynomial (Fin m) A →ₐ[A] E => F q) (MvPolynomial.comp_aeval w ι)
    exact e1.symm
  have hKe : ∀ k, MvPolynomial.aeval e (K k) = 0 := by
    intro k
    rw [hcompE]
    have h1 := congrArg ι (hcn k)
    rw [map_mul, AlgHom.commutes, AlgHom.commutes] at h1
    have h2 : algebraMap A E (c k) = 0 := by
      have h3 : algebraMap A E ((μ k : A) * c k) = 0 := by rw [hμ k, map_zero]
      rw [map_mul] at h3
      exact (hμE k).mul_right_eq_zero.mp h3
    rw [h2, map_pow] at h1
    exact (hbE.pow (n k)).mul_left_eq_zero.mp h1
  have hsL : IsUnit (algebraMap A L s) := IsLocalization.map_units L (⟨s, hsM⟩ : M)
  let β : E →ₐ[A] L :=
    AlgHom.mk (IsLocalization.Away.lift s hsL) (fun r => IsLocalization.Away.lift_eq s hsL r)
  have hβe : ∀ t, β (e t) = x t := fun t => key (β.comp ι) t

  let α0 : MvPolynomial (Fin m) A →ₐ[A] E := MvPolynomial.aeval e
  have hα0 : ∀ q ∈ RingHom.ker fP, α0 q = 0 := by
    intro q hq
    have hq' : q ∈ Ideal.span (Set.range K) := by
      have hq2 : q ∈ RingHom.ker fP.toRingHom := hq
      rw [← hK] at hq2
      exact hq2
    have hle : Ideal.span (Set.range K) ≤ RingHom.ker α0 := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨k, rfl⟩
      exact hKe k
    exact hle hq'
  let eqv := Ideal.quotientKerAlgEquivOfSurjective hsurj
  let α : P →ₐ[A] E := (Ideal.Quotient.liftₐ (RingHom.ker fP) α0 hα0).comp eqv.symm.toAlgHom
  have hα : ∀ q, α (fP q) = α0 q := by
    intro q
    have he : eqv.symm (fP q) = Ideal.Quotient.mk _ q := by
      rw [AlgEquiv.symm_apply_eq]
      simp [eqv]
    change (Ideal.Quotient.liftₐ _ α0 hα0) (eqv.symm (fP q)) = α0 q
    rw [he]
    rfl
  refine ⟨E, inferInstance, inferInstance, inferInstance, α, β, ?_⟩
  apply AlgHom.ext
  intro p
  obtain ⟨q, rfl⟩ := hsurj p
  rw [AlgHom.comp_apply, hα, ← hhx]
  have e1 := congrArg (fun F : MvPolynomial (Fin m) A →ₐ[A] L => F q) (MvPolynomial.comp_aeval e β)
  have hf : (fun i => β (e i)) = x := funext hβe
  rw [hf] at e1
  exact e1

theorem wc_sh_family_indEtale : ∀ (S : Type u) [CommRing S] (I : Type u) (n : I → ℕ) (f : ∀ i, Fin (n i) → MvPolynomial (Fin (n i)) S), (∀ i, ∃ g : MvPolynomial (Fin (n i)) S, g * (Matrix.of fun a b => MvPolynomial.pderiv a (f i b)).det - 1 ∈ Ideal.span (Set.range (f i))) → wcIndEtale (algebraMap S (MvPolynomial (Σ i, Fin (n i)) S ⧸ Ideal.span (Set.range (fun p : Σ i, Fin (n i) => MvPolynomial.rename (fun k : Fin (n p.1) => (⟨p.1, k⟩ : Σ i, Fin (n i))) (f p.1 p.2))))) :=
by
  intro S _ I n f hJC

  have s1 : ∀ {R T : Type u} [CommRing R] [CommRing T] [Algebra R T], (∀ (N nZ : ℕ) (Z : Fin nZ → MvPolynomial (Fin N) R) (a : Fin N → T), (∀ j, MvPolynomial.aeval a (Z j) = 0) → ∃ (E₀ : Type u) (_ : CommRing E₀) (_ : Algebra R E₀), Algebra.Etale R E₀ ∧ ∃ (β₀ : E₀ →ₐ[R] T) (a₀ : Fin N → E₀), (∀ i, β₀ (a₀ i) = a i) ∧ ∀ j, MvPolynomial.aeval a₀ (Z j) = 0) → wcIndEtale (algebraMap R T) := by
    intro R T _ _ _ H
    unfold wcIndEtale
    rw [show (algebraMap R T).toAlgebra = ‹Algebra R T› from
      Algebra.algebra_ext _ _ (fun _ => rfl)]
    intro P _ _ _ h
    obtain ⟨N, qP, hqP, hfg⟩ := Algebra.FinitePresentation.out (R := R) (A := P)
    obtain ⟨nZ, Z, hZ⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hZker : ∀ j, qP (Z j) = 0 := by
      intro j
      have hj : Z j ∈ RingHom.ker qP.toRingHom := by
        rw [← hZ]; exact Submodule.subset_span ⟨j, rfl⟩
      exact RingHom.mem_ker.mp hj
    have hcomp : h.comp qP = MvPolynomial.aeval (fun t => h (qP (MvPolynomial.X t))) := by
      apply MvPolynomial.algHom_ext
      intro t
      simp
    obtain ⟨E₀, _, _, hE₀, β₀, a₀, hβ, ha₀⟩ := H N nZ Z (fun t => h (qP (MvPolynomial.X t)))
      (fun j => by rw [← hcomp, AlgHom.comp_apply, hZker j, map_zero])
    have hle : RingHom.ker qP.toRingHom ≤ RingHom.ker (MvPolynomial.aeval (R := R) a₀).toRingHom := by
      rw [← hZ]
      apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact RingHom.mem_ker.mpr (ha₀ j)
    refine ⟨E₀, inferInstance, inferInstance, hE₀,
      AlgHom.liftOfSurjective qP hqP (MvPolynomial.aeval a₀) hle, β₀, ?_⟩
    apply AlgHom.ext
    intro x
    obtain ⟨p, rfl⟩ := hqP x
    rw [AlgHom.comp_apply, AlgHom.liftOfSurjective_apply, ← AlgHom.comp_apply,
      MvPolynomial.comp_aeval, ← AlgHom.comp_apply h qP, hcomp]
    rw [show (fun i => β₀ (a₀ i)) = (fun t => h (qP (MvPolynomial.X t))) from funext hβ]
  apply s1
  apply wc_sigma_quotient_solution_lift S I (fun i => Fin (n i)) (fun i => Fin (n i)) f
  intro n' τ _
  exact @wc_sigma_presentation_etale S _ n' (fun k => Fin (n (τ k))) (fun k => Fin (n (τ k)))
    (fun k => inferInstance) (fun k => inferInstance) (fun k => inferInstance) (fun k => id)
    (fun k => f (τ k)) (fun k => (hJC (τ k)).choose) (fun k => Function.bijective_id)
    (fun k => (hJC (τ k)).choose_spec)

theorem wc_sh_standard_presentation_fin : ∀ (S E : Type u) [CommRing S] [CommRing E] [Algebra S E], Algebra.Etale S E → ∃ (n : ℕ) (f : Fin n → MvPolynomial (Fin n) S) (val : Fin n → E), Function.Surjective (MvPolynomial.aeval (R := S) val) ∧ RingHom.ker (MvPolynomial.aeval (R := S) val) = Ideal.span (Set.range f) ∧ ∃ g : MvPolynomial (Fin n) S, g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1 ∈ Ideal.span (Set.range f) :=
by
  have wc_etale_standard_presentation : ∀ (S E : Type u) [CommRing S] [CommRing E] [Algebra S E], Algebra.Etale S E → ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (_ : DecidableEq σ) (mp : σ → ι) (f : σ → MvPolynomial ι S) (val : ι → E), Function.Bijective mp ∧ Function.Surjective (MvPolynomial.aeval (R := S) val) ∧ RingHom.ker (MvPolynomial.aeval (R := S) val) = Ideal.span (Set.range f) ∧ ∃ g : MvPolynomial ι S, g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) := by
    intro S E _ _ _ hE
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 S E :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hE
    obtain ⟨ι, σ, hσ, hι, P, hdim⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.out (n := 0) (R := S) (S := E)
    have hdim' : Nat.card ι - Nat.card σ = 0 := hdim
    have hle : Nat.card ι ≤ Nat.card σ := Nat.sub_eq_zero_iff_le.mp hdim'
    letI : Fintype ι := Fintype.ofFinite ι
    letI : Fintype σ := Fintype.ofFinite σ
    letI : DecidableEq σ := Classical.decEq σ
    have hker : RingHom.ker (MvPolynomial.aeval (R := S) P.val) =
        Ideal.span (Set.range P.relation) :=
      (P.span_range_relation_eq_ker.trans P.ker_eq_ker_aeval_val).symm
    refine ⟨ι, σ, inferInstance, inferInstance, inferInstance, P.map, P.relation, P.val,
      P.map_inj.bijective_of_nat_card_le hle, fun s => ⟨P.σ' s, P.aeval_val_σ' s⟩, hker, ?_⟩
    have hM : (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)) =
        P.jacobiMatrix := by
      ext i j
      rw [Matrix.of_apply, P.jacobiMatrix_apply]
    have hJ : P.jacobian = MvPolynomial.aeval P.val
        (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)).det := by
      rw [P.jacobian_eq_jacobiMatrix_det, hM, Algebra.Generators.algebraMap_apply]
    have hu : IsUnit P.jacobian := P.jacobian_isUnit
    rw [hJ] at hu
    obtain ⟨y, hy⟩ := hu.exists_left_inv
    refine ⟨P.σ' y, ?_⟩
    rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_one, P.aeval_val_σ', hy, sub_self]
  intro S E _ _ _ hE
  classical
  obtain ⟨ι, σ, _, _, _, mp, f, val, hmp, hsurj, hker, g, hg⟩ :=
    wc_etale_standard_presentation S E hE
  let n : ℕ := Fintype.card ι
  let e : ι ≃ Fin n := Fintype.equivFin ι
  let m : σ ≃ ι := Equiv.ofBijective mp hmp
  let τ : Fin n ≃ σ := e.symm.trans m.symm
  have hK : ∀ k, mp (τ k) = e.symm k := fun k => by
    have : m (m.symm (e.symm k)) = e.symm k := Equiv.apply_symm_apply m _
    exact this
  let val' : Fin n → E := val ∘ e.symm
  let f' : Fin n → MvPolynomial (Fin n) S := fun k => MvPolynomial.rename e (f (τ k))
  have hC : ∀ p : MvPolynomial ι S,
      MvPolynomial.aeval val' (MvPolynomial.rename e p) = MvPolynomial.aeval val p := by
    intro p
    rw [MvPolynomial.aeval_rename]
    have hv : val' ∘ ⇑e = val := by funext i; simp [val']
    rw [hv]
  have hinv : ∀ q : MvPolynomial (Fin n) S,
      MvPolynomial.rename e (MvPolynomial.rename e.symm q) = q := by
    intro q
    rw [MvPolynomial.rename_rename]
    have : (⇑e ∘ ⇑e.symm) = id := by funext x; simp
    rw [this, MvPolynomial.rename_id]
    rfl
  have hspan : ∀ x ∈ Ideal.span (Set.range f),
      MvPolynomial.rename e x ∈ Ideal.span (Set.range f') := by
    intro x hx
    have hle : Ideal.map (MvPolynomial.rename e : MvPolynomial ι S →ₐ[S] MvPolynomial (Fin n) S)
        (Ideal.span (Set.range f)) ≤ Ideal.span (Set.range f') := by
      rw [Ideal.map_span]
      apply Ideal.span_le.mpr
      rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      apply Ideal.subset_span
      refine ⟨τ.symm j, ?_⟩
      simp [f']
    exact hle (Ideal.mem_map_of_mem _ hx)
  refine ⟨n, f', val', ?_, ?_, MvPolynomial.rename e g, ?_⟩
  · intro x
    obtain ⟨p, rfl⟩ := hsurj x
    exact ⟨_, hC p⟩
  · apply le_antisymm
    · intro q hq
      rw [RingHom.mem_ker] at hq
      have h1 : MvPolynomial.rename e.symm q ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
        rw [RingHom.mem_ker, ← hC, hinv]; exact hq
      rw [hker] at h1
      have h2 := hspan _ h1
      rwa [hinv] at h2
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      show MvPolynomial.aeval val' (MvPolynomial.rename e (f (τ k))) = 0
      rw [hC]
      have h3 : f (τ k) ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
        rw [hker]; exact Ideal.subset_span ⟨τ k, rfl⟩
      exact h3
  · have hJ : (Matrix.of fun a b => MvPolynomial.pderiv a (f' b)) =
        ((MvPolynomial.rename e : MvPolynomial ι S →ₐ[S] MvPolynomial (Fin n) S).toRingHom.mapMatrix
          (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j))).submatrix τ τ := by
      refine Matrix.ext (fun a b => ?_)
      simp only [Matrix.of_apply, Matrix.submatrix_apply, RingHom.mapMatrix_apply, Matrix.map_apply]
      have ha : a = e (mp (τ a)) := by rw [hK]; simp
      show MvPolynomial.pderiv a (MvPolynomial.rename e (f (τ b))) = _
      conv_lhs => rw [ha]
      exact MvPolynomial.pderiv_rename e.injective (mp (τ a)) (f (τ b))
    rw [hJ, Matrix.det_submatrix_equiv_self, ← RingHom.map_det]
    have h4 := hspan _ hg
    rw [map_sub, map_mul, map_one] at h4
    exact h4

theorem wc_strict_hull : ∀ (S B : Type u) [CommRing S] [CommRing B] [Algebra S B] [HenselianLocalRing B], IsSepClosed (IsLocalRing.ResidueField B) → ∃ (R : Type u) (_ : CommRing R) (σ : S →+* R) (ρ : R →+* B) (_ : IsLocalRing R), ρ.comp σ = algebraMap S B ∧ HenselianLocalRing R ∧ IsSepClosed (IsLocalRing.ResidueField R) ∧ IsLocalHom ρ ∧ wcIndEtale σ :=
by

  have construction : ∀ (S B : Type u) [CommRing S] [CommRing B] [Algebra S B],
      ∃ (R : Type u) (_ : CommRing R) (σ : S →+* R) (ρ : R →+* B), ρ.comp σ = algebraMap S B ∧
        (∀ r : R, IsUnit (ρ r) → IsUnit r) ∧ wcIndEtale σ ∧
        (letI := σ.toAlgebra; ∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E →
          ∀ ψ : E →ₐ[S] B, ∃ κ : E →ₐ[S] R, ρ.comp (κ : E →+* R) = (ψ : E →+* B)) := by
    classical
    intro S B _ _ _
    let I : Type u := Σ n : ℕ, {d : (Fin n → MvPolynomial (Fin n) S) × (Fin n → B) //
      (∃ g : MvPolynomial (Fin n) S, g * (Matrix.of fun a b => MvPolynomial.pderiv a (d.1 b)).det - 1
        ∈ Ideal.span (Set.range d.1)) ∧ ∀ j, MvPolynomial.aeval d.2 (d.1 j) = 0}
    let nI : I → ℕ := fun i => i.1
    let fI : ∀ i, Fin (nI i) → MvPolynomial (Fin (nI i)) S := fun i => i.2.1.1
    let V := Σ i : I, Fin (nI i)
    let J : Ideal (MvPolynomial V S) := Ideal.span (Set.range (fun p : V =>
      MvPolynomial.rename (fun k : Fin (nI p.1) => (⟨p.1, k⟩ : V)) (fI p.1 p.2)))
    let A := MvPolynomial V S ⧸ J
    have hSA : wcIndEtale (algebraMap S A) :=
      wc_sh_family_indEtale S I nI fI (fun i => i.2.2.1)
    let φ₀ : MvPolynomial V S →ₐ[S] B := MvPolynomial.aeval (fun v : V => v.1.2.1.2 v.2)
    have hJ : ∀ a ∈ J, φ₀ a = 0 := by
      intro a ha
      have hle : J ≤ RingHom.ker φ₀ := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨p, rfl⟩
        change φ₀ _ = 0
        simp only [φ₀, MvPolynomial.aeval_rename]
        exact p.1.2.2.2 p.2
      exact hle ha
    let φ : A →ₐ[S] B := Ideal.Quotient.liftₐ J φ₀ hJ
    have hφmk : ∀ p, φ (Ideal.Quotient.mk J p) = φ₀ p := fun p => rfl
    let M : Submonoid A := Submonoid.comap (φ : A →+* B) (IsUnit.submonoid B)
    obtain ⟨R, _, _, _⟩ : ∃ (R : Type u) (_ : CommRing R) (_ : Algebra A R), IsLocalization M R :=
      ⟨Localization M, inferInstance, inferInstance, inferInstance⟩
    have hAR : wcIndEtale (algebraMap A R) := wc_sh_localization_indEtale A R M
    have hMu : ∀ y : M, IsUnit ((φ : A →+* B) y) := fun y => y.2
    let ρ : R →+* B := IsLocalization.lift hMu
    have hρA : ∀ a : A, ρ (algebraMap A R a) = φ a := fun a => IsLocalization.lift_eq hMu a
    let σ : S →+* R := (algebraMap A R).comp (algebraMap S A)
    refine ⟨R, inferInstance, σ, ρ, ?_, ?_, wc_indEtale_comp _ _ hSA hAR, ?_⟩
    · ext s
      change ρ (algebraMap A R (algebraMap S A s)) = algebraMap S B s
      rw [hρA, φ.commutes]
    · intro r hr
      obtain ⟨⟨a, m⟩, rfl⟩ := IsLocalization.mk'_surjective M r
      have hspec := IsLocalization.mk'_spec R a m
      have h1 : ρ (IsLocalization.mk' R a m) * φ m = φ a := by
        rw [← hρA, ← hρA, ← map_mul, hspec]
      have hau : IsUnit (φ a) := h1 ▸ hr.mul (hMu m)
      have haM : a ∈ M := hau
      have hu : IsUnit (algebraMap A R a) := IsLocalization.map_units R (⟨a, haM⟩ : M)
      rw [← hspec] at hu
      exact (IsUnit.mul_iff.mp hu).1
    · letI := σ.toAlgebra
      intro E _ _ hE ψ
      obtain ⟨n, f, val, hsurj, hker, hJC⟩ := wc_sh_standard_presentation_fin S E hE
      let b : Fin n → B := fun k => ψ (val k)
      have hψval : ∀ p : MvPolynomial (Fin n) S,
          ψ (MvPolynomial.aeval val p) = MvPolynomial.aeval b p := by
        intro p
        have := congrArg (fun F : MvPolynomial (Fin n) S →ₐ[S] B => F p)
          (MvPolynomial.comp_aeval (R := S) val ψ)
        simpa using this
      have hroots : ∀ j, MvPolynomial.aeval b (f j) = 0 := by
        intro j
        rw [← hψval]
        have : f j ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
          rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
        rw [RingHom.mem_ker] at this
        rw [this, map_zero]
      let i : I := ⟨n, ⟨(f, b), hJC, hroots⟩⟩
      let ιAR : A →ₐ[S] R := { algebraMap A R with commutes' := fun s => rfl }
      let g₀ : MvPolynomial (Fin n) S →ₐ[S] R :=
        ιAR.comp ((Ideal.Quotient.mkₐ S J).comp
          (MvPolynomial.rename (fun k : Fin n => (⟨i, k⟩ : V))))
      have hg₀ : ∀ a ∈ RingHom.ker (MvPolynomial.aeval (R := S) val), g₀ a = 0 := by
        intro a ha
        rw [hker] at ha
        have hle : Ideal.span (Set.range f) ≤ RingHom.ker g₀ := by
          refine Ideal.span_le.mpr ?_
          rintro _ ⟨j, rfl⟩
          change ιAR (Ideal.Quotient.mkₐ S J (MvPolynomial.rename _ (f j))) = 0
          rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem.mpr, map_zero]
          exact Ideal.subset_span ⟨⟨i, j⟩, rfl⟩
        exact hle ha
      let eqv := Ideal.quotientKerAlgEquivOfSurjective hsurj
      let κ : E →ₐ[S] R := (Ideal.Quotient.liftₐ _ g₀ hg₀).comp eqv.symm.toAlgHom
      have hκ : ∀ p : MvPolynomial (Fin n) S, κ (MvPolynomial.aeval val p) = g₀ p := by
        intro p
        have he : eqv.symm (MvPolynomial.aeval val p) = Ideal.Quotient.mk _ p := by
          rw [AlgEquiv.symm_apply_eq]
          simp [eqv]
        change (Ideal.Quotient.liftₐ _ g₀ hg₀) (eqv.symm (MvPolynomial.aeval val p)) = g₀ p
        rw [he]
        rfl
      have hρS : ∀ s : S, ρ (algebraMap S R s) = algebraMap S B s := by
        intro s
        change ρ (algebraMap A R (algebraMap S A s)) = algebraMap S B s
        rw [hρA, φ.commutes]
      let ρS : R →ₐ[S] B := AlgHom.mk ρ hρS
      have hcomp : ρS.comp g₀ = ψ.comp (MvPolynomial.aeval val) := by
        apply MvPolynomial.algHom_ext
        intro k
        change ρ (algebraMap A R (Ideal.Quotient.mk J (MvPolynomial.rename _ (MvPolynomial.X k)))) =
          ψ (MvPolynomial.aeval val (MvPolynomial.X k))
        rw [hρA, hφmk, MvPolynomial.rename_X, MvPolynomial.aeval_X]
        simp [MvPolynomial.aeval_X, i, b]
      refine ⟨κ, ?_⟩
      ext x
      obtain ⟨p, rfl⟩ := hsurj x
      change ρ (κ (MvPolynomial.aeval val p)) = ψ (MvPolynomial.aeval val p)
      rw [hκ]
      exact congrArg (fun F : MvPolynomial (Fin n) S →ₐ[S] B => F p) hcomp

  have s2 : ∀ (S R B E : Type u) [CommRing S] [CommRing R] [CommRing B] [CommRing E] [Algebra S R]
      [Algebra S E], Algebra.Etale S E → ∀ (ρ : R →+* B), (∀ r : R, IsUnit (ρ r) → IsUnit r) →
      ∀ (u v : E →ₐ[S] R), ρ.comp (u : E →+* R) = ρ.comp (v : E →+* R) → u = v := by
    intro S R B E _ _ _ _ _ _ hE ρ hρ u v huv
    obtain ⟨t, ht1, ht2⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := S) (S := E)).mp inferInstance
    have hw : ∀ a, (v a - u a) * Algebra.TensorProduct.productMap u v t = 0 := by
      intro a
      have h := congrArg (Algebra.TensorProduct.productMap u v) (ht1 a)
      rw [map_mul, map_sub, Algebra.TensorProduct.productMap_apply_tmul,
        Algebra.TensorProduct.productMap_apply_tmul, map_one, map_one, one_mul, mul_one,
        map_zero] at h
      exact h
    have key : ∀ z : TensorProduct S E E, ρ (Algebra.TensorProduct.productMap u v z) =
        ρ (u (Algebra.TensorProduct.lmul' S z)) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x y =>
        rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          map_mul, map_mul, map_mul]
        have h := RingHom.congr_fun huv y
        simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe] at h
        rw [h]
      | add x y hx hy => simp only [map_add, hx, hy]
    have hρw : ρ (Algebra.TensorProduct.productMap u v t) = 1 := by
      rw [key, ht2, map_one, map_one]
    have hwu : IsUnit (Algebra.TensorProduct.productMap u v t) :=
      hρ _ (by rw [hρw]; exact isUnit_one)
    ext a
    exact (sub_eq_zero.mp (hwu.mul_left_eq_zero.mp (hw a))).symm

  have s3 : ∀ (S R B : Type u) [CommRing S] [CommRing R] [CommRing B] [Algebra S B] (σ : S →+* R)
      (ρ : R →+* B), ρ.comp σ = algebraMap S B →
      (letI := σ.toAlgebra; (∀ (n : ℕ) (r : Fin n → R), ∃ (E : Type u) (_ : CommRing E)
        (_ : Algebra S E), Algebra.Etale S E ∧ ∃ (κ : E →ₐ[S] R) (e : Fin n → E), ∀ i, κ (e i) = r i) ∧
        (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ (κ₁ κ₂ : E →ₐ[S] R),
          ρ.comp (κ₁ : E →+* R) = ρ.comp (κ₂ : E →+* R) → κ₁ = κ₂) ∧
        (∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E → ∀ ψ : E →ₐ[S] B,
          ∃ κ : E →ₐ[S] R, ρ.comp (κ : E →+* R) = (ψ : E →+* B))) →
      ∀ f : Polynomial R, f.Monic → ∀ b : B, (f.map ρ).eval b = 0 →
        IsUnit ((Polynomial.derivative (f.map ρ)).eval b) → ∃ x : R, f.eval x = 0 ∧ ρ x = b := by
    intro S R B _ _ _ _ σ ρ hρσ
    letI := σ.toAlgebra
    rintro ⟨H1, H2, H3⟩ f hf b hb hdb
    obtain ⟨E, _, _, hEt, κ, e, hκe⟩ := H1 f.natDegree (fun i => f.coeff i)
    let F : Polynomial E := Polynomial.X ^ f.natDegree +
      ∑ i : Fin f.natDegree, Polynomial.C (e i) * Polynomial.X ^ (i : ℕ)
    have hFm : F.Monic := Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt e)
    have hFκ : F.map (κ : E →+* R) = f := by
      conv_rhs => rw [hf.as_sum]
      simp only [F, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
        Polynomial.map_mul, Polynomial.map_C]
      congr 1
      rw [← Fin.sum_univ_eq_sum_range (fun i => Polynomial.C (f.coeff i) * Polynomial.X ^ i)
        f.natDegree]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [RingHom.coe_coe, hκe i]
    let P : StandardEtalePair E :=
      ⟨F, hFm, Polynomial.derivative F, ⟨1, 0, 1, by ring⟩⟩
    letI algSP : Algebra S P.Ring := ((algebraMap E P.Ring).comp (algebraMap S E)).toAlgebra
    haveI : IsScalarTower S E P.Ring := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.Etale S P.Ring := Algebra.Etale.comp S E P.Ring
    letI algEB : Algebra E B := (ρ.comp (κ : E →+* R)).toAlgebra
    have hmapB : ∀ q : Polynomial E,
        Polynomial.aeval b q = ((q.map (κ : E →+* R)).map ρ).eval b := by
      intro q
      rw [Polynomial.map_map, Polynomial.aeval_def, Polynomial.eval_map]
      rfl
    have hHas : P.HasMap b := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval b F = 0
        rw [hmapB, hFκ]; exact hb
      · change IsUnit (Polynomial.aeval b (Polynomial.derivative F))
        rw [hmapB, ← Polynomial.derivative_map, ← Polynomial.derivative_map, hFκ]; exact hdb
    let ψ₀ : P.Ring →ₐ[E] B := P.lift b hHas
    have hψ₀E : ∀ x : E, ψ₀ (algebraMap E P.Ring x) = ρ (κ x) := fun x => ψ₀.commutes x
    let ψ : P.Ring →ₐ[S] B :=
      { (ψ₀ : P.Ring →+* B) with
        commutes' := fun s => by
          change ψ₀ (algebraMap E P.Ring (algebraMap S E s)) = algebraMap S B s
          rw [hψ₀E, κ.commutes, ← hρσ]
          rfl }
    obtain ⟨κ'', hκ''⟩ := H3 P.Ring inferInstance ψ
    let j : E →ₐ[S] P.Ring := IsScalarTower.toAlgHom S E P.Ring
    have hj : κ''.comp j = κ := by
      apply H2 E hEt
      ext x
      have h := RingHom.congr_fun hκ'' (algebraMap E P.Ring x)
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe] at h ⊢
      change ρ (κ'' (algebraMap E P.Ring x)) = ρ (κ x)
      rw [h]
      exact hψ₀E x
    refine ⟨κ'' P.X, ?_, ?_⟩
    · have h0 : Polynomial.aeval P.X P.f = 0 := StandardEtalePair.hasMap_X.1
      rw [← hFκ, ← hj, Polynomial.eval_map]
      have := Polynomial.hom_eval₂ F (algebraMap E P.Ring) (κ'' : P.Ring →+* R) P.X
      rw [← Polynomial.aeval_def] at this
      change (κ'' : P.Ring →+* R) (Polynomial.aeval P.X F) = _ at this
      rw [show (Polynomial.aeval P.X F) = 0 from h0, map_zero] at this
      rw [this]
      rfl
    · have h := RingHom.congr_fun hκ'' P.X
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe] at h
      rw [h]
      exact P.lift_X b hHas

  have hD : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (D : Polynomial B) (b c : B),
      b - c ∈ IsLocalRing.maximalIdeal B → IsUnit (D.eval c) → IsUnit (D.eval b) := by
    intro B _ _ D b c hbc hc
    by_contra hcon
    have hmem : D.eval b ∈ IsLocalRing.maximalIdeal B :=
      (IsLocalRing.mem_maximalIdeal _).mpr hcon
    obtain ⟨k, hk⟩ := Polynomial.sub_dvd_eval_sub b c D
    have e : D.eval c = D.eval b - (b - c) * k := by rw [← hk]; ring
    have : D.eval c ∈ IsLocalRing.maximalIdeal B := by
      rw [e]; exact Ideal.sub_mem _ hmem (Ideal.mul_mem_right _ _ hbc)
    exact (IsLocalRing.mem_maximalIdeal _).mp this hc

  have s4 : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsLocalRing R] [HenselianLocalRing B]
      (ρ : R →+* B), (∀ r : R, IsUnit (ρ r) → IsUnit r) →
      (∀ f : Polynomial R, f.Monic → ∀ b : B, (f.map ρ).eval b = 0 →
        IsUnit ((Polynomial.derivative (f.map ρ)).eval b) → ∃ x : R, f.eval x = 0 ∧ ρ x = b) →
      HenselianLocalRing R := by
    intro R B _ _ _ _ ρ hρ hlift
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ h₀ hu
    have hm : ∀ y : R, y ∈ IsLocalRing.maximalIdeal R → ρ y ∈ IsLocalRing.maximalIdeal B := by
      intro y hy
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy ⊢
      exact fun h => hy (hρ y h)
    have h1 : (f.map ρ).eval (ρ a₀) ∈ IsLocalRing.maximalIdeal B := by
      rw [Polynomial.eval_map_apply]; exact hm _ h₀
    have h2 : IsUnit ((Polynomial.derivative (f.map ρ)).eval (ρ a₀)) := by
      rw [Polynomial.derivative_map, Polynomial.eval_map_apply]; exact hu.map ρ
    obtain ⟨b, hb, hbm⟩ := HenselianLocalRing.is_henselian (f.map ρ) (hf.map ρ) (ρ a₀) h1 h2
    have h3 := hD B _ b (ρ a₀) hbm h2
    obtain ⟨x, hx, hxb⟩ := hlift f hf b hb h3
    refine ⟨x, hx, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hxu
    have := hxu.map ρ
    rw [map_sub, hxb] at this
    exact (IsLocalRing.mem_maximalIdeal _).mp hbm this

  have s5 : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsLocalRing R] [HenselianLocalRing B]
      (ρ : R →+* B) [IsLocalHom ρ], IsSepClosed (IsLocalRing.ResidueField B) →
      (∀ f : Polynomial R, f.Monic → ∀ b : B, (f.map ρ).eval b = 0 →
        IsUnit ((Polynomial.derivative (f.map ρ)).eval b) → ∃ x : R, f.eval x = 0 ∧ ρ x = b) →
      IsSepClosed (IsLocalRing.ResidueField R) := by
    intro R B _ _ _ _ ρ _ hsep hlift
    letI fR : Field (IsLocalRing.ResidueField R) := IsLocalRing.ResidueField.field R
    letI fB : Field (IsLocalRing.ResidueField B) := IsLocalRing.ResidueField.field B
    haveI : Nontrivial (IsLocalRing.ResidueField R) := fR.toNontrivial
    haveI : Nontrivial (IsLocalRing.ResidueField B) := fB.toNontrivial
    haveI : IsSimpleRing (IsLocalRing.ResidueField R) := DivisionRing.isSimpleRing _
    refine IsSepClosed.of_exists_root _ ?_
    intro p hpm hpirr hpsep
    obtain ⟨F, hFmap, -, hFm⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective _ IsLocalRing.residue_surjective p)) hpm
    have hqsep : (p.map (IsLocalRing.ResidueField.map ρ)).Separable := hpsep.map
    have hqdeg : (p.map (IsLocalRing.ResidueField.map ρ)).degree ≠ 0 := by
      rw [Polynomial.degree_map]; exact (Polynomial.degree_pos_of_irreducible hpirr).ne'
    obtain ⟨ybar, hy⟩ := IsSepClosed.exists_root _ hqdeg hqsep
    obtain ⟨y₀, rfl⟩ := IsLocalRing.residue_surjective ybar
    have hcomm : (IsLocalRing.residue B).comp ρ =
        (IsLocalRing.ResidueField.map ρ).comp (IsLocalRing.residue R) := by
      ext r; simp [IsLocalRing.ResidueField.map_residue]
    have hFq : (F.map ρ).map (IsLocalRing.residue B) =
        p.map (IsLocalRing.ResidueField.map ρ) := by
      rw [Polynomial.map_map, hcomm, ← Polynomial.map_map, hFmap]
    have h1 : (F.map ρ).eval y₀ ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_map_apply, hFq]
      exact hy
    have h2 : IsUnit ((Polynomial.derivative (F.map ρ)).eval y₀) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← Polynomial.eval_map_apply,
        ← Polynomial.derivative_map, hFq]
      have := hqsep.aeval_derivative_ne_zero (x := IsLocalRing.residue B y₀)
        (by rw [Polynomial.coe_aeval_eq_eval]; exact hy)
      rwa [Polynomial.coe_aeval_eq_eval] at this
    obtain ⟨b, hb, hbm⟩ := HenselianLocalRing.is_henselian (F.map ρ) (hFm.map ρ) y₀ h1 h2
    have h3 := hD B _ b y₀ hbm h2
    obtain ⟨x, hx, -⟩ := hlift F hFm b hb h3
    refine ⟨IsLocalRing.residue R x, ?_⟩
    rw [← hFmap, Polynomial.eval_map_apply, hx, map_zero]

  intro S B _ _ _ _ hsep
  obtain ⟨R, _, σ, ρ, hρσ, hrefl, hind, hlift⟩ := construction S B
  letI : Algebra S R := σ.toAlgebra
  haveI : Nontrivial R := ⟨⟨0, 1, fun h => by
    have h' := congrArg ρ h
    rw [map_zero, map_one] at h'
    exact zero_ne_one h'⟩⟩
  haveI hloc : IsLocalRing R := IsLocalRing.of_nonunits_add (fun a c ha hc => by
    rw [mem_nonunits_iff] at ha hc ⊢
    intro hac
    have h1 : ρ a ∈ nonunits B := mem_nonunits_iff.mpr (fun h => ha (hrefl a h))
    have h2 : ρ c ∈ nonunits B := mem_nonunits_iff.mpr (fun h => hc (hrefl c h))
    have h3 := IsLocalRing.nonunits_add h1 h2
    rw [mem_nonunits_iff] at h3
    exact h3 (by rw [← map_add]; exact hac.map ρ))
  have H1 : ∀ (n : ℕ) (r : Fin n → R), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra S E),
      Algebra.Etale S E ∧ ∃ (κ : E →ₐ[S] R) (e : Fin n → E), ∀ i, κ (e i) = r i := by
    intro n r
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hind (MvPolynomial (Fin n) S) (MvPolynomial.aeval r)
    refine ⟨E, inferInstance, inferInstance, hE, β, fun i => α (MvPolynomial.X i), fun i => ?_⟩
    have := congrArg (fun F : MvPolynomial (Fin n) S →ₐ[S] R => F (MvPolynomial.X i)) hαβ
    simpa using this
  have H2 : ∀ (E : Type u) [CommRing E] [Algebra S E], Algebra.Etale S E →
      ∀ (κ₁ κ₂ : E →ₐ[S] R), ρ.comp (κ₁ : E →+* R) = ρ.comp (κ₂ : E →+* R) → κ₁ = κ₂ :=
    fun E _ _ hE κ₁ κ₂ h => s2 S R B E hE ρ hrefl κ₁ κ₂ h
  have hroot := s3 S R B σ ρ hρσ ⟨H1, H2, hlift⟩
  haveI : IsLocalHom ρ := ⟨hrefl⟩
  exact ⟨R, inferInstance, σ, ρ, hloc, hρσ, s4 R B ρ hrefl hroot, s5 R B ρ hsep hroot,
    ⟨hrefl⟩, hind⟩

theorem wc_weaklyEtale_cancel : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C] [Algebra B C] [IsScalarTower A B C], Algebra.WeaklyEtale A B → Algebra.WeaklyEtale A C → Algebra.WeaklyEtale B C :=
by
  intro A B C _ _ _ _ _ _ _ hAB hAC
  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩
  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      haveI := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu
  have hcomp : Spec.map (CommRingCat.ofHom (algebraMap B C)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A B)) =
      Spec.map (CommRingCat.ofHom (algebraMap A C)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  haveI hg : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A B))) := toSch A B hAB
  haveI hfg : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap B C)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
    rw [hcomp]; exact toSch A C hAC
  exact toRing B C (WeaklyEtale.of_comp (Spec.map (CommRingCat.ofHom (algebraMap B C)))
    (Spec.map (CommRingCat.ofHom (algebraMap A B))))

theorem wc_flat_quot_absorb : ∀ (R : Type u) [CommRing R] (I : Ideal R), Module.Flat R (R ⧸ I) → ∀ x ∈ I, ∃ z ∈ I, x * z = x :=
by
  intro R _ I hflat x hx
  have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : R ⧸ I)) i = 0 := by
    rw [Fin.sum_univ_one]
    show x • (1 : R ⧸ I) = 0
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
      Ideal.Quotient.eq_zero_iff_mem]
    exact hx
  obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
  choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
  set w : R := ∑ j, a 0 j * b j with hw
  have h10 : (1 : R ⧸ I) = ∑ j, a 0 j • y j := h1 0
  have hmk : Ideal.Quotient.mk I w = 1 := by
    rw [hw, map_sum, h10]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
  have hxw : x * w = 0 := by
    rw [hw, Finset.mul_sum]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have := h2 j
    rw [Fin.sum_univ_one] at this
    rw [← mul_assoc, this, zero_mul]
  refine ⟨1 - w, ?_, ?_⟩
  · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
  · rw [mul_sub, mul_one, hxw, sub_zero]

theorem wc_weaklyEtale_point_algebraic : ∀ (A B K : Type u) [CommRing A] [CommRing B] [Algebra A B] [Field K], Algebra.WeaklyEtale A B → ∀ (φ : B →+* K) (b : B), ∃ f : Polynomial A, f.map (φ.comp (algebraMap A B)) ≠ 0 ∧ f.eval₂ (φ.comp (algebraMap A B)) (φ b) = 0 :=
by
  classical

  have s1 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] (x : K), Transcendental k x →
      ∀ z : TensorProduct k K K, (x ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] x) * z = 0 → z = 0 := by
    intro k K _ _ _ x hx z hz
    letI : Algebra (Polynomial k) K := (Polynomial.aeval x).toRingHom.toAlgebra
    have hPK : ∀ p : Polynomial k, algebraMap (Polynomial k) K p = Polynomial.aeval x p :=
      fun p => rfl
    haveI : IsScalarTower k (Polynomial k) K := IsScalarTower.of_algebraMap_eq (fun c => by
      rw [hPK]; exact ((Polynomial.aeval x).commutes c).symm)
    have hinjx : Function.Injective (Polynomial.aeval (R := k) x) :=
      (transcendental_iff_injective).mp hx
    haveI hflat : Module.Flat (Polynomial k) K := by
      rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
      intro y hy
      obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff y).mp hy
      rw [Submodule.mem_bot]
      rw [Submonoid.smul_def, Algebra.smul_def, hPK] at ha
      have ha0 : Polynomial.aeval x (a : Polynomial k) ≠ 0 := by
        intro h
        apply nonZeroDivisors.coe_ne_zero a
        apply hinjx
        rw [h, map_zero]
      exact (mul_eq_zero.mp ha).resolve_left ha0
    let e := Algebra.TensorProduct.cancelBaseChange k (Polynomial k) (Polynomial k) K K
    let u : TensorProduct k (Polynomial k) K :=
      (Polynomial.X : Polynomial k) ⊗ₜ[k] (1 : K) - (1 : Polynomial k) ⊗ₜ[k] x
    have heu : e ((1 : K) ⊗ₜ[Polynomial k] u) = x ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] x := by
      simp only [u, TensorProduct.tmul_sub, map_sub, e,
        Algebra.TensorProduct.cancelBaseChange_tmul]
      rw [Algebra.smul_def, Algebra.smul_def, hPK, hPK, Polynomial.aeval_X, map_one, mul_one,
        mul_one]
    let Ψ : Polynomial K ≃+* TensorProduct k (Polynomial k) K :=
      (polyEquivTensor' k K).toRingEquiv.trans
        (Algebra.TensorProduct.comm k K (Polynomial k)).toRingEquiv
    have hΨ : Ψ (Polynomial.X - Polynomial.C x) = u := by
      simp only [Ψ, RingEquiv.trans_apply, AlgEquiv.coe_ringEquiv]
      have h1 : (polyEquivTensor' k K) (Polynomial.X - Polynomial.C x) =
          (1 : K) ⊗ₜ[k] (Polynomial.X : Polynomial k) - x ⊗ₜ[k] (1 : Polynomial k) := by
        show polyEquivTensor k K _ = _
        rw [polyEquivTensor_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
        rfl
      rw [h1, map_sub, Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.comm_tmul]
    have hmu : Function.Injective (LinearMap.mulLeft (Polynomial k) u) := by
      rw [injective_iff_map_eq_zero]
      intro v hv
      rw [LinearMap.mulLeft_apply] at hv
      have h2 : Ψ.symm u * Ψ.symm v = 0 := by rw [← map_mul, hv, map_zero]
      have h3 : Ψ.symm u ≠ 0 := by
        rw [← hΨ, RingEquiv.symm_apply_apply]; exact Polynomial.X_sub_C_ne_zero x
      have h4 : Ψ.symm v = 0 := (mul_eq_zero.mp h2).resolve_left h3
      rw [← Ψ.apply_symm_apply v, h4, map_zero]
    have hlt := Module.Flat.lTensor_preserves_injective_linearMap (M := K) _ hmu
    have hkey : LinearMap.lTensor K (LinearMap.mulLeft (Polynomial k) u) =
        LinearMap.mulLeft (Polynomial k) ((1 : K) ⊗ₜ[Polynomial k] u) :=
      TensorProduct.ext' (fun a v => by
        rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, LinearMap.mulLeft_apply,
          Algebra.TensorProduct.tmul_mul_tmul, one_mul])
    have h5 : ((1 : K) ⊗ₜ[Polynomial k] u) * e.symm z = 0 := by
      apply e.injective
      rw [map_mul, heu, AlgEquiv.apply_symm_apply, hz, map_zero]
    have h6 : e.symm z = 0 := hlt (by rw [hkey, LinearMap.mulLeft_apply, h5, map_zero])
    rw [← e.apply_symm_apply z, h6, map_zero]

  have s2 : ∀ (A K : Type u) [CommRing A] [Field K] (ψ : A →+* K) (x : K),
      IsAlgebraic (Subfield.closure (Set.range ψ)) x →
      ∃ f : Polynomial A, f.map ψ ≠ 0 ∧ f.eval₂ ψ x = 0 := by
    intro A K _ _ ψ x h
    set k := Subfield.closure (Set.range ψ) with hk
    have hfrac : ∀ c : k, ∃ a d : A, ψ d ≠ 0 ∧ algebraMap k K c * ψ d = ψ a := by
      intro c
      obtain ⟨y, hy, z, hz, hyz⟩ := Subfield.mem_closure_iff.mp c.2
      have hR : ∀ w ∈ Subring.closure (Set.range ψ), ∃ a, ψ a = w := by
        intro w hw
        rw [← RingHom.coe_range, Subring.closure_eq] at hw
        exact RingHom.mem_range.mp hw
      obtain ⟨a, rfl⟩ := hR y hy
      obtain ⟨d, rfl⟩ := hR z hz
      show ∃ a' d', ψ d' ≠ 0 ∧ (c : K) * ψ d' = ψ a'
      by_cases hd : ψ d = 0
      · refine ⟨0, 1, by rw [map_one]; exact one_ne_zero, ?_⟩
        rw [← hyz, hd, div_zero, zero_mul, map_zero]
      · refine ⟨a, d, hd, ?_⟩
        rw [← hyz, div_mul_cancel₀ _ hd]
    have hclear : ∀ g : Polynomial k, ∃ (D : A) (f : Polynomial A), ψ D ≠ 0 ∧
        f.map ψ = Polynomial.C (ψ D) * g.map (algebraMap k K) := by
      intro g
      induction g using Polynomial.induction_on' with
      | add p q hp hq =>
        obtain ⟨D₁, f₁, hD₁, hf₁⟩ := hp
        obtain ⟨D₂, f₂, hD₂, hf₂⟩ := hq
        refine ⟨D₁ * D₂, Polynomial.C D₂ * f₁ + Polynomial.C D₁ * f₂, ?_, ?_⟩
        · rw [map_mul]; exact mul_ne_zero hD₁ hD₂
        · rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
            Polynomial.map_C, hf₁, hf₂, Polynomial.map_add, map_mul, Polynomial.C_mul]
          ring
      | monomial n c =>
        obtain ⟨a, d, hd, hc⟩ := hfrac c
        refine ⟨d, Polynomial.monomial n a, hd, ?_⟩
        rw [Polynomial.map_monomial, Polynomial.map_monomial, Polynomial.C_mul_monomial, ← hc,
          mul_comm]
    obtain ⟨g, hg, hg0⟩ := h
    obtain ⟨D, f, hD, hf⟩ := hclear g
    refine ⟨f, ?_, ?_⟩
    · rw [hf]
      exact mul_ne_zero (Polynomial.C_ne_zero.mpr hD)
        ((Polynomial.map_ne_zero_iff (algebraMap k K).injective).mpr hg)
    · rw [Polynomial.eval₂_eq_eval_map, hf, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_map, ← Polynomial.aeval_def, hg0, mul_zero]

  have s3 : ∀ (A B k K : Type u) [CommRing A] [CommRing B] [Algebra A B] [Field k] [Field K]
      [Algebra k K] (φ : B →+* K),
      (∀ a : A, φ (algebraMap A B a) ∈ Set.range (algebraMap k K)) →
      ∃ Θ : TensorProduct A B B →+* TensorProduct k K K,
        (∀ b : B, Θ (b ⊗ₜ[A] (1 : B)) = φ b ⊗ₜ[k] (1 : K)) ∧
        (∀ b : B, Θ ((1 : B) ⊗ₜ[A] b) = (1 : K) ⊗ₜ[k] φ b) ∧
        ∀ t : TensorProduct A B B, Algebra.TensorProduct.lmul' k (S := K) (Θ t) =
          φ (Algebra.TensorProduct.lmul' A (S := B) t) := by
    intro A B k K _ _ _ _ _ _ φ hk
    letI : Algebra A (TensorProduct k K K) :=
      (Algebra.TensorProduct.includeLeftRingHom.comp (φ.comp (algebraMap A B))).toAlgebra
    let f₁ : B →ₐ[A] TensorProduct k K K :=
      { Algebra.TensorProduct.includeLeftRingHom.comp φ with commutes' := fun a => rfl }
    let f₂ : B →ₐ[A] TensorProduct k K K :=
      { (Algebra.TensorProduct.includeRight : K →ₐ[k] TensorProduct k K K).toRingHom.comp φ with
        commutes' := fun a => by
          obtain ⟨c, hc⟩ := hk a
          show (1 : K) ⊗ₜ[k] φ (algebraMap A B a) = φ (algebraMap A B a) ⊗ₜ[k] (1 : K)
          rw [← hc, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul] }
    have hf₁ : ∀ b, f₁ b = φ b ⊗ₜ[k] (1 : K) := fun b => rfl
    have hf₂ : ∀ b, f₂ b = (1 : K) ⊗ₜ[k] φ b := fun b => rfl
    have hΘ : ∀ b₁ b₂ : B, Algebra.TensorProduct.productMap f₁ f₂ (b₁ ⊗ₜ[A] b₂) =
        φ b₁ ⊗ₜ[k] φ b₂ := by
      intro b₁ b₂
      rw [Algebra.TensorProduct.productMap_apply_tmul, hf₁, hf₂,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    refine ⟨(Algebra.TensorProduct.productMap f₁ f₂).toRingHom, fun b => ?_, fun b => ?_, ?_⟩
    · show Algebra.TensorProduct.productMap f₁ f₂ (b ⊗ₜ[A] (1 : B)) = _
      rw [hΘ, map_one]
    · show Algebra.TensorProduct.productMap f₁ f₂ ((1 : B) ⊗ₜ[A] b) = _
      rw [hΘ, map_one]
    · intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul b₁ b₂ =>
        show Algebra.TensorProduct.lmul' k (S := K)
          (Algebra.TensorProduct.productMap f₁ f₂ (b₁ ⊗ₜ[A] b₂)) = _
        rw [hΘ, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          map_mul]
      | add s t hs ht => simp only [map_add, hs, ht]

  have habsorb : ∀ (R : Type u) [CommRing R] (I : Ideal R), Module.Flat R (R ⧸ I) →
      ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
    intro R _ I hflat x hx
    have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : R ⧸ I)) i = 0 := by
      rw [Fin.sum_univ_one]
      show x • (1 : R ⧸ I) = 0
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hx
    obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
    set w : R := ∑ j, a 0 j * b j with hw
    have h10 : (1 : R ⧸ I) = ∑ j, a 0 j • y j := h1 0
    have hmk : Ideal.Quotient.mk I w = 1 := by
      rw [hw, map_sum, h10]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
    have hxw : x * w = 0 := by
      rw [hw, Finset.mul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have := h2 j
      rw [Fin.sum_univ_one] at this
      rw [← mul_assoc, this, zero_mul]
    refine ⟨1 - w, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
    · rw [mul_sub, mul_one, hxw, sub_zero]

  have s4 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
      Algebra.WeaklyEtale A B → ∀ b : B, ∃ w : TensorProduct A B B,
        Algebra.TensorProduct.lmul' A (S := B) w = 0 ∧
        (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) * w = b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b := by
    intro A B _ _ _ hW b
    have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' A (S := B)) := fun b =>
      ⟨b ⊗ₜ[A] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
    have hflatQ : Module.Flat (TensorProduct A B B)
        (TensorProduct A B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
      let e := RingHom.quotientKerEquivOfSurjective
        (f := (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) hμsurj
      have h1 : ((Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat := hW.flat_lmul'
      have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat :=
        RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
      have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom =
          algebraMap _ (TensorProduct A B B ⧸
            RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
        refine RingHom.ext fun t => ?_
        rw [Ideal.Quotient.algebraMap_eq]
        show e.symm (Algebra.TensorProduct.lmul' A (S := B) t) = Ideal.Quotient.mk _ t
        rw [e.symm_apply_eq]
        rfl
      rw [h3, RingHom.flat_algebraMap_iff] at h2
      exact h2
    obtain ⟨z, hz, hxz⟩ := habsorb _ _ hflatQ
      (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) (by
        rw [RingHom.mem_ker]
        show Algebra.TensorProduct.lmul' A (S := B) (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) = 0
        rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
          Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self])
    exact ⟨z, RingHom.mem_ker.mp hz, hxz⟩

  intro A B K _ _ _ _ hW φ b
  by_contra hno
  let k := Subfield.closure (Set.range (φ.comp (algebraMap A B)))
  have htr : Transcendental k (φ b) := fun halg => hno (s2 A K _ (φ b) halg)
  obtain ⟨Θ, hΘl, hΘr, hΘμ⟩ := s3 A B k K φ
    (fun a => ⟨⟨φ (algebraMap A B a), Subfield.subset_closure ⟨a, rfl⟩⟩, rfl⟩)
  obtain ⟨w, hw0, hw⟩ := s4 A B hW b
  have hδ : (φ b ⊗ₜ[k] (1 : K) - (1 : K) ⊗ₜ[k] φ b) * (Θ w - 1) = 0 := by
    have h := congrArg Θ hw
    rw [map_mul, map_sub, hΘl, hΘr] at h
    rw [mul_sub, mul_one, h, sub_self]
  have h1 : Θ w - 1 = 0 := s1 k K (φ b) htr _ hδ
  have h2 : Θ w = 1 := sub_eq_zero.mp h1
  have h3 := hΘμ w
  rw [h2, map_one, hw0, map_zero] at h3
  exact one_ne_zero h3

theorem wc_henselian_integral_domain_local : ∀ (A D : Type u) [CommRing A] [CommRing D] [IsDomain D] [Algebra A D] [IsLocalRing A], HenselianLocalRing A → Algebra.IsIntegral A D → IsLocalRing D ∧ IsLocalHom (algebraMap A D) :=
by
  intro A D _ _ _ _ _ hHen hInt

  have hloc : IsLocalHom (algebraMap A D) := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have hker : RingHom.ker (algebraMap A D) ≤ IsLocalRing.maximalIdeal A :=
      IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _)
    obtain ⟨Q, hQ, hQu⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := D) (IsLocalRing.maximalIdeal A) hker
    have hmem : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
    rw [← hQu] at hmem
    have hQa : algebraMap A D a ∈ Q := hmem
    exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hQa ha)
  have hofId : ((Algebra.ofId A (IsLocalRing.ResidueField A) : A →ₐ[A] IsLocalRing.ResidueField A) :
      A →+* IsLocalRing.ResidueField A) = IsLocalRing.residue A := by
    ext x
    show Algebra.ofId A (IsLocalRing.ResidueField A) x = IsLocalRing.residue A x
    rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]

  have s2 : ∀ (S : Type u) [CommRing S] [Algebra A S], Algebra.IsStandardEtale A S →
      ∀ φ : S →ₐ[A] IsLocalRing.ResidueField A,
        ∃ τ : S →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro S _ _ hS φ
    obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
    have hm := P.hasMap
    have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
    have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
      rw [Polynomial.aeval_algHom_apply]
      exact (hm.2.map φ).ne_zero
    have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
      obtain ⟨p₁, p₂, N, hc⟩ := P.cond
      have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
      rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
      intro h
      rw [h, zero_mul] at h1
      exact pow_ne_zero N hg0 h1.symm
    have key := (HenselianLocalRing.TFAE A).out 1 2
    obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
    have hA : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
        exact ha
      · have key2 : (Algebra.ofId A (IsLocalRing.ResidueField A)) (Polynomial.aeval a P.g) =
            Polynomial.aeval (φ P.x) P.g := by
          rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
            IsLocalRing.ResidueField.algebraMap_eq, hres]
        rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
    refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
    have h1 : (Algebra.ofId A (IsLocalRing.ResidueField A)).comp (P.lift a hA) =
        φ.comp P.equivRing.symm.toAlgHom := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
        IsLocalRing.ResidueField.algebraMap_eq, hres]
      have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
      show φ P.x = φ (P.equivRing.symm P.X)
      rw [hx]
    ext s
    have h2 := congrArg (fun F => F (P.equivRing s)) h1
    simpa using h2

  have s3 : ∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E →
      ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A,
        ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A] IsLocalRing.ResidueField A :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := s2 _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have s4 : ∀ (f : Polynomial A) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A)), f.Monic →
      g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A) = g₀ * h₀ →
      ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ f = g * h ∧
        g.map (IsLocalRing.residue A) = g₀ ∧ h.map (IsLocalRing.residue A) = h₀ := by
    intro f g₀ h₀ hf hg hh hc hfac
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq A f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap A (IsLocalRing.ResidueField A)) (p : Polynomial A) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)

    have nat : ∀ (ψ : A →ₐ[A] IsLocalRing.ResidueField A),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
              Polynomial.MonicDegreeEq A _) : Polynomial A).map
                (ψ : A →+* IsLocalRing.ResidueField A)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
              Polynomial.MonicDegreeEq A _) : Polynomial A).map
                (ψ : A →+* IsLocalRing.ResidueField A)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A (IsLocalRing.ResidueField A))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
        _ _ hn p ((Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2.monic, ?_,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have s5 : ∀ (q : Polynomial (IsLocalRing.ResidueField A)), q.Monic →
      ∃ (a : ℕ) (r : Polynomial (IsLocalRing.ResidueField A)), r.Monic ∧
        q = Polynomial.X ^ a * r ∧ r.coeff 0 ≠ 0 ∧
        IsCoprime ((Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ a) r := by
    intro q hq
    obtain ⟨r, hr, hnd⟩ :=
      Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd q hq.ne_zero 0
    rw [map_zero, sub_zero] at hr hnd
    refine ⟨_, r, ?_, hr, ?_, ?_⟩
    · exact (Polynomial.monic_X_pow _).of_mul_monic_left (hr ▸ hq)
    · intro h
      exact hnd (Polynomial.X_dvd_iff.mpr h)
    · exact IsCoprime.pow_left ((Irreducible.coprime_iff_not_dvd Polynomial.irreducible_X).mpr hnd)

  refine ⟨?_, hloc⟩
  apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
  intro d
  obtain ⟨F, hF, hFd⟩ := hInt.isIntegral d
  obtain ⟨a, r, hr, hsplit, hr0, hcop⟩ := s5 (F.map (IsLocalRing.residue A)) (hF.map _)
  obtain ⟨g, h, -, -, hFgh, hgr, hhr⟩ :=
    s4 F (Polynomial.X ^ a) r hF (Polynomial.monic_X_pow a) hr hcop hsplit
  have hg1 : IsUnit (g.eval 1) := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    rw [← Polynomial.eval_one_map, hgr, Polynomial.eval_pow, Polynomial.eval_X, one_pow]
    exact one_ne_zero
  have hh0 : IsUnit (h.eval 0) := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    rw [← Polynomial.eval_zero_map, hhr, ← Polynomial.coeff_zero_eq_eval_zero]
    exact hr0
  have hprod : Polynomial.aeval d g * Polynomial.aeval d h = 0 := by
    rw [← map_mul, ← hFgh, Polynomial.aeval_def]
    exact hFd
  rcases mul_eq_zero.mp hprod with hgd | hhd
  · right
    have hdvd := Polynomial.sub_dvd_eval_sub 1 d (g.map (algebraMap A D))
    rw [Polynomial.eval_one_map, Polynomial.eval_map, ← Polynomial.aeval_def, hgd,
      sub_zero] at hdvd
    exact isUnit_of_dvd_unit hdvd (hg1.map _)
  · left
    have hdvd := Polynomial.sub_dvd_eval_sub 0 d (h.map (algebraMap A D))
    rw [Polynomial.eval_zero_map, Polynomial.eval_map, ← Polynomial.aeval_def, hhd,
      sub_zero, zero_sub] at hdvd
    have hu := (isUnit_of_dvd_unit hdvd (hh0.map _)).neg
    rwa [neg_neg] at hu

theorem wc_local_tensor_integral : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C] [IsLocalRing A] [IsLocalRing B] [IsLocalRing C], IsSepClosed (IsLocalRing.ResidueField A) → IsLocalHom (algebraMap A B) → IsLocalHom (algebraMap A C) → Algebra.IsIntegral A C → IsLocalRing (TensorProduct A C B) :=
by
  intro A B C _ _ _ _ _ _ _ _ hSep hAB hAC hInt
  classical

  have hint : Algebra.IsIntegral (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField C) := by
    constructor
    intro y
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective y
    have hc : _root_.IsIntegral A c := Algebra.IsIntegral.isIntegral c
    have h2 : _root_.IsIntegral A (IsLocalRing.residue C c) := by
      have := hc.map (IsScalarTower.toAlgHom A C (IsLocalRing.ResidueField C))
      simpa [IsLocalRing.ResidueField.algebraMap_eq] using this
    exact h2.tower_top
  haveI := hint
  haveI halg : Algebra.IsAlgebraic (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField C) :=
    Algebra.IsIntegral.isAlgebraic

  have hnt : Nontrivial (TensorProduct A (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C)) := by
    let σ : IsLocalRing.ResidueField C →ₐ[IsLocalRing.ResidueField A]
        AlgebraicClosure (IsLocalRing.ResidueField B) := IsAlgClosed.lift
    let f : IsLocalRing.ResidueField C →ₐ[A] AlgebraicClosure (IsLocalRing.ResidueField B) :=
      σ.restrictScalars A
    let g : IsLocalRing.ResidueField B →ₐ[A] AlgebraicClosure (IsLocalRing.ResidueField B) :=
      IsScalarTower.toAlgHom A _ _
    let ψ := Algebra.TensorProduct.lift g f (fun _ _ => Commute.all _ _)
    exact RingHom.domain_nontrivial (ψ : _ →+* AlgebraicClosure (IsLocalRing.ResidueField B))
  haveI := hnt

  set q := ringExpChar (IsLocalRing.ResidueField A) with hqdef
  haveI hq : ExpChar (IsLocalRing.ResidueField A) q := ringExpChar.expChar _
  haveI : IsPurelyInseparable (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField C) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  haveI hF : ExpChar (TensorProduct A (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C)) q := by
    let j : IsLocalRing.ResidueField A →+*
        TensorProduct A (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C) :=
      (Algebra.TensorProduct.includeLeftRingHom).comp
        (algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B))
    exact expChar_of_injective_ringHom j.injective q
  have s4 : ∀ z : TensorProduct A (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C),
      ∃ (n : ℕ) (b : IsLocalRing.ResidueField B),
        z ^ q ^ n = b ⊗ₜ[A] (1 : IsLocalRing.ResidueField C) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul b c =>
      obtain ⟨n, a, ha⟩ := IsPurelyInseparable.pow_mem (IsLocalRing.ResidueField A) q c
      obtain ⟨a0, rfl⟩ := IsLocalRing.residue_surjective a
      refine ⟨n, a0 • b ^ q ^ n, ?_⟩
      have hc : c ^ q ^ n = a0 • (1 : IsLocalRing.ResidueField C) := by
        rw [← ha, ← Algebra.algebraMap_eq_smul_one,
          IsScalarTower.algebraMap_apply A (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField C),
          IsLocalRing.ResidueField.algebraMap_eq]
      rw [Algebra.TensorProduct.tmul_pow, hc, TensorProduct.smul_tmul]
    | add x y hx hy =>
      obtain ⟨n1, b1, h1⟩ := hx
      obtain ⟨n2, b2, h2⟩ := hy
      refine ⟨n1 + n2, b1 ^ q ^ n2 + b2 ^ q ^ n1, ?_⟩
      have e1 : x ^ q ^ (n1 + n2) = (b1 ^ q ^ n2) ⊗ₜ[A] (1 : IsLocalRing.ResidueField C) := by
        rw [pow_add, pow_mul, h1, Algebra.TensorProduct.tmul_pow, one_pow]
      have e2 : y ^ q ^ (n1 + n2) = (b2 ^ q ^ n1) ⊗ₜ[A] (1 : IsLocalRing.ResidueField C) := by
        rw [add_comm, pow_add, pow_mul, h2, Algebra.TensorProduct.tmul_pow, one_pow]
      rw [add_pow_expChar_pow, e1, e2, TensorProduct.add_tmul]

  haveI hFloc : IsLocalRing
      (TensorProduct A (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C)) := by
    refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun z => ?_
    obtain ⟨n, b, hz⟩ := s4 z
    have hqn : q ^ n ≠ 0 := pow_ne_zero _ (expChar_pos (IsLocalRing.ResidueField A) q).ne'
    by_cases hb : b = 0
    · right
      have hnil : IsNilpotent z := ⟨q ^ n, by rw [hz, hb, TensorProduct.zero_tmul]⟩
      exact hnil.isUnit_one_sub
    · left
      have hu : IsUnit (b ⊗ₜ[A] (1 : IsLocalRing.ResidueField C)) :=
        (IsUnit.mk0 b hb).map (Algebra.TensorProduct.includeLeftRingHom (R := A)
          (B := IsLocalRing.ResidueField C))
      rw [← hz] at hu
      exact (isUnit_pow_iff hqn).mp hu

  let πB := IsScalarTower.toAlgHom A B (IsLocalRing.ResidueField B)
  let πC := IsScalarTower.toAlgHom A C (IsLocalRing.ResidueField C)
  have hπB : Function.Surjective πB := IsLocalRing.residue_surjective
  have hπC : Function.Surjective πC := IsLocalRing.residue_surjective
  let Φ := Algebra.TensorProduct.map πB πC
  have hΦs : Function.Surjective Φ := Algebra.TensorProduct.map_surjective _ _ hπB hπC

  have s1 : ∀ (M : Ideal (TensorProduct A B C)), M.IsMaximal → RingHom.ker Φ ≤ M := by
    intro M hM
    rw [Algebra.TensorProduct.map_ker _ _ hπB hπC]
    have hkB : RingHom.ker πB = IsLocalRing.maximalIdeal B := by
      ext x
      rw [RingHom.mem_ker, ← IsLocalRing.residue_eq_zero_iff]
      rfl
    have hkC : RingHom.ker πC = IsLocalRing.maximalIdeal C := by
      ext x
      rw [RingHom.mem_ker, ← IsLocalRing.residue_eq_zero_iff]
      rfl
    have hBint : (algebraMap B (TensorProduct A B C)).IsIntegral :=
      algebraMap_isIntegral_iff.mpr inferInstance
    have hcB : Ideal.comap (algebraMap B (TensorProduct A B C)) M = IsLocalRing.maximalIdeal B := by
      haveI := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hBint M
      exact IsLocalRing.eq_maximalIdeal this
    have hcB' : Ideal.comap (Algebra.TensorProduct.includeLeft : B →ₐ[A] TensorProduct A B C) M =
        IsLocalRing.maximalIdeal B := by
      rw [← hcB]
      rfl
    haveI hMp : M.IsPrime := hM.isPrime
    have hcC : Ideal.comap (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A B C) M =
        IsLocalRing.maximalIdeal C := by
      set Q := Ideal.comap (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A B C) M
      haveI : Q.IsPrime := Ideal.comap_isPrime _ M
      have hQA : Ideal.comap (algebraMap A C) Q = IsLocalRing.maximalIdeal A := by
        have e1 : Ideal.comap (algebraMap A C) Q =
            Ideal.comap (algebraMap A B) (Ideal.comap (algebraMap B (TensorProduct A B C)) M) := by
          ext a
          simp only [Q, Ideal.mem_comap]
          rw [AlgHom.commutes, IsScalarTower.algebraMap_apply A B (TensorProduct A B C)]
        rw [e1, hcB]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap A B)).out 1 5).mp hAB
      have hCint : (algebraMap A C).IsIntegral := algebraMap_isIntegral_iff.mpr hInt
      have hQmax : Q.IsMaximal := by
        apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hCint
        rw [hQA]
        infer_instance
      exact IsLocalRing.eq_maximalIdeal hQmax
    apply sup_le
    · rw [Ideal.map_le_iff_le_comap, hkB]
      exact hcB'.ge
    · rw [Ideal.map_le_iff_le_comap, hkC]
      exact hcC.ge

  have s2 : ∀ x : TensorProduct A B C, IsUnit (Φ x) → IsUnit x := by
    intro x hx
    by_contra hnx
    obtain ⟨M, hM, hxM⟩ := exists_max_ideal_of_mem_nonunits hnx
    obtain ⟨s, hs⟩ := hx.exists_right_inv
    obtain ⟨y, rfl⟩ := hΦs s
    have hk : x * y - 1 ∈ RingHom.ker Φ := by
      rw [RingHom.mem_ker, map_sub, map_mul, hs, map_one, sub_self]
    have h1 := s1 M hM hk
    have h2 : x * y ∈ M := M.mul_mem_right y hxM
    have : (1 : TensorProduct A B C) ∈ M := by
      have := M.sub_mem h2 h1
      simpa using this
    exact hM.ne_top ((Ideal.eq_top_iff_one M).mpr this)

  haveI : Nontrivial (TensorProduct A B C) := RingHom.domain_nontrivial Φ.toRingHom
  haveI hE : IsLocalRing (TensorProduct A B C) := by
    refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun x => ?_
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (Φ x) with h | h
    · exact Or.inl (s2 x h)
    · right
      apply s2
      rw [map_sub, map_one]
      exact h
  exact RingEquiv.isLocalRing (Algebra.TensorProduct.comm A B C).toRingEquiv

theorem wc_weaklyEtale_normal_idem : ∀ (D C : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] [CommRing C] [Algebra D C], Algebra.WeaklyEtale D C → ∀ (c : C) (s : D), s ≠ 0 → c * c = s • c → ∃ c' : C, c = s • c' :=
by
  classical



  have s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (s d : D), s ≠ 0 →
      (∀ B : ValuationSubring (FractionRing D), (∀ e : D, algebraMap D (FractionRing D) e ∈ B) →
        algebraMap D (FractionRing D) d / algebraMap D (FractionRing D) s ∈ B) →
      ∃ d' : D, d = s * d' := by
    intro D _ _ _ s d hs hB
    have hαinj : Function.Injective (algebraMap D (FractionRing D)) :=
      IsFractionRing.injective D (FractionRing D)
    have hαs : algebraMap D (FractionRing D) s ≠ 0 := fun h => hs (hαinj (by rw [h, map_zero]))
    set x : FractionRing D := algebraMap D (FractionRing D) d / algebraMap D (FractionRing D) s
      with hxdef
    by_cases hint : IsIntegral D x
    · obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
      refine ⟨y, hαinj ?_⟩
      rw [map_mul, hy, hxdef, mul_div_cancel₀ _ hαs]
    · exfalso
      have hx0 : x ≠ 0 := by
        intro h; apply hint; rw [h]; exact isIntegral_zero
      set y : FractionRing D := x⁻¹ with hydef
      have hy0 : y ≠ 0 := inv_ne_zero hx0
      have hxy : y * x = 1 := inv_mul_cancel₀ hx0
      have hnotin : x ∉ Algebra.adjoin D {y} := by
        intro hxmem
        apply hint
        rw [Algebra.adjoin_singleton_eq_range_aeval] at hxmem
        obtain ⟨g, hg⟩ := hxmem
        letI : Invertible y := invertibleOfNonzero hy0
        have h1 := Polynomial.eval₂_reflect_mul_pow (algebraMap D (FractionRing D)) y
          g.natDegree g le_rfl
        have hinv : (⅟y : FractionRing D) = x := by rw [invOf_eq_inv, hydef, inv_inv]
        have hg' : Polynomial.eval₂ (algebraMap D (FractionRing D)) y g = x := by
          rw [← Polynomial.aeval_def]; exact hg
        rw [hinv, hg'] at h1
        have h2 : Polynomial.eval₂ (algebraMap D (FractionRing D)) x
            (Polynomial.reflect g.natDegree g) = x ^ (g.natDegree + 1) := by
          have h3 : Polynomial.eval₂ (algebraMap D (FractionRing D)) x
              (Polynomial.reflect g.natDegree g) * y ^ g.natDegree * x ^ g.natDegree =
              x * x ^ g.natDegree := by rw [h1]
          rw [mul_assoc, ← mul_pow, hxy, one_pow, mul_one] at h3
          rw [h3, pow_succ, mul_comm]
        refine ⟨Polynomial.X ^ (g.natDegree + 1) - Polynomial.reflect g.natDegree g, ?_, ?_⟩
        · apply Polynomial.monic_X_pow_sub
          have hnd : (Polynomial.reflect g.natDegree g).natDegree ≤ g.natDegree :=
            Polynomial.natDegree_reflect_le.trans (max_self _).le
          exact (Polynomial.degree_le_of_natDegree_le hnd).trans_lt
            (by exact_mod_cast Nat.lt_succ_self _)
        · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, h2, sub_self]
      let A : Subring (FractionRing D) := (Algebra.adjoin D {y}).toSubring
      have hyA : y ∈ A := Algebra.subset_adjoin (Set.mem_singleton y)
      let y' : A := ⟨y, hyA⟩
      have hnu : ¬ IsUnit y' := by
        intro hu
        obtain ⟨z, hz⟩ := isUnit_iff_exists_inv.mp hu
        have hz' : y * (z : FractionRing D) = 1 := congrArg Subtype.val hz
        have hzx : (z : FractionRing D) = x := by
          calc (z : FractionRing D) = (y * x) * (z : FractionRing D) := by rw [hxy, one_mul]
            _ = x * (y * (z : FractionRing D)) := by ring
            _ = x := by rw [hz', mul_one]
        exact hnotin (hzx ▸ z.2)
      have hspan : Ideal.span {y'} ≠ ⊤ := fun h => hnu (Ideal.span_singleton_eq_top.mp h)
      obtain ⟨M, hM, hyM⟩ := Ideal.exists_le_maximal _ hspan
      haveI := hM.isPrime
      obtain ⟨B, hLB⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.ofPrime A M)
      obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hLB
      have hAL := LocalSubring.le_ofPrime A M
      have hAB : ∀ z ∈ A, z ∈ B := fun z hz => hle (hAL hz)
      have hxB : x ∈ B := hB B (fun e => hAB _ (Subalgebra.algebraMap_mem _ e))
      have hyL : y ∈ (LocalSubring.ofPrime A M).toSubring := hAL hyA
      have hyBu : IsUnit (Subring.inclusion hle ⟨y, hyL⟩) := by
        refine isUnit_iff_exists_inv.mpr ⟨⟨x, hxB⟩, ?_⟩
        apply Subtype.ext
        exact hxy
      have hyLu := hloc.map_nonunit _ hyBu
      obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.mp hyLu
      have hb' : y * (b : FractionRing D) = 1 := congrArg Subtype.val hb
      have hg : ∀ z : M.primeCompl, IsUnit (A.subtype (z : A)) := by
        intro z
        apply IsUnit.mk0
        intro h0
        apply z.2
        have : (z : A) = 0 := Subtype.ext h0
        rw [this]
        exact M.zero_mem
      let f : Localization.AtPrime M →+* FractionRing D :=
        IsLocalization.lift (M := M.primeCompl) (S := Localization.AtPrime M) hg
      have hbr : (b : FractionRing D) ∈ f.range := b.2
      obtain ⟨w, hw⟩ := hbr
      have hfa : f (algebraMap A (Localization.AtPrime M) y') = y := IsLocalization.lift_eq hg y'
      have ha : algebraMap A (Localization.AtPrime M) y' ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime M) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime M) M y').mpr
          (hyM (Ideal.mem_span_singleton_self y'))
      have haw := Ideal.mul_mem_right w _ ha
      have hu : IsUnit (1 - algebraMap A (Localization.AtPrime M) y' * w) :=
        (IsLocalRing.isUnit_or_isUnit_one_sub_self _).resolve_left
          ((IsLocalRing.mem_maximalIdeal _).mp haw)
      have hf0 : f (1 - algebraMap A (Localization.AtPrime M) y' * w) = 0 := by
        rw [map_sub, map_one, map_mul, hfa, hw, hb', sub_self]
      exact (hu.map f).ne_zero hf0



  have s2 : ∀ (ι : Type u) (V : ι → Type u) [∀ i, CommRing (V i)] [∀ i, IsDomain (V i)]
      (N : Type u) [AddCommGroup N] [Module (∀ i, V i) N], (∀ i (a b : V i), a ∣ b ∨ b ∣ a) →
      (∀ g : (∀ i, V i), (∀ i, g i ≠ 0) → ∀ n : N, g • n = 0 → n = 0) →
      Module.Flat (∀ i, V i) N := by
    intro ι V _ _ N _ _ htot htf
    apply Module.Flat.of_forall_isTrivialRelation
    intro l f x hfx
    rcases Nat.eq_zero_or_pos l with hl | hl
    · subst hl
      exact ⟨0, fun i => Fin.elim0 i, fun j => Fin.elim0 j, fun i => Fin.elim0 i,
        fun j => Fin.elim0 j⟩
    have hpiv : ∀ v : ι, ∃ m : Fin l, ∀ j, f m v ∣ f j v := by
      intro v
      have key : ∀ S : Finset (Fin l), S.Nonempty → ∃ m ∈ S, ∀ j ∈ S, f m v ∣ f j v := by
        intro S hS
        induction hS using Finset.Nonempty.cons_induction with
        | singleton a =>
          exact ⟨a, Finset.mem_singleton_self a, fun j hj => by rw [Finset.mem_singleton.mp hj]⟩
        | cons a S haS hS ih =>
          obtain ⟨m, hmS, hm⟩ := ih
          rcases htot v (f m v) (f a v) with h | h
          · refine ⟨m, Finset.mem_cons_of_mem hmS, fun j hj => ?_⟩
            rcases Finset.mem_cons.mp hj with rfl | hj
            · exact h
            · exact hm j hj
          · refine ⟨a, Finset.mem_cons_self a S, fun j hj => ?_⟩
            rcases Finset.mem_cons.mp hj with rfl | hj
            · exact dvd_rfl
            · exact h.trans (hm j hj)
      obtain ⟨m, _, hm⟩ := key Finset.univ ⟨⟨0, hl⟩, Finset.mem_univ _⟩
      exact ⟨m, fun j => hm j (Finset.mem_univ j)⟩
    choose m hm using hpiv
    choose cc hcc using hm
    let hh : (∀ i, V i) := fun v => if f (m v) v = 0 then 1 else f (m v) v
    let β : Fin l → (∀ i, V i) := fun j v => if f (m v) v = 0 then 0 else cc v j
    let e : Fin l → (∀ i, V i) := fun j v => if m v = j then 1 else 0
    have hz : ∀ v j, f (m v) v = 0 → f j v = 0 := by
      intro v j h0
      rw [hcc v j, h0, zero_mul]
    have F1 : ∀ j, hh * β j = f j := by
      intro j; funext v
      simp only [Pi.mul_apply, hh, β]
      split_ifs with h0
      · rw [mul_zero, hz v j h0]
      · rw [hcc v j]
    have F2 : ∑ k, f k * e k = fun v => f (m v) v := by
      funext v
      rw [Finset.sum_apply]
      simp [e]
    have F3 : ∀ j, (∑ k, f k * e k) * β j = f j := by
      intro j; rw [F2]; funext v
      simp only [Pi.mul_apply, β]
      split_ifs with h0
      · rw [mul_zero, hz v j h0]
      · rw [hcc v j]
    have hhne : ∀ v, hh v ≠ 0 := by
      intro v; simp only [hh]; split_ifs with h0
      · exact one_ne_zero
      · exact h0
    have hβx : ∑ j, β j • x j = 0 := by
      apply htf hh hhne
      rw [Finset.smul_sum]
      simp_rw [smul_smul, F1]
      exact hfx
    refine ⟨l, fun i j => (if i = j then 1 else 0) - e i * β j, x, fun i => ?_, fun j => ?_⟩
    · have : ∑ j, ((if i = j then 1 else 0) - e i * β j) • x j = x i - e i • ∑ j, β j • x j := by
        simp_rw [sub_smul, Finset.sum_sub_distrib, ite_smul, one_smul, zero_smul,
          Finset.sum_ite_eq, Finset.mem_univ, if_true, mul_smul, Finset.smul_sum]
      rw [this, hβx, smul_zero, sub_zero]
    · have h1 : ∑ i, f i * ((if i = j then 1 else 0) - e i * β j) =
          f j - (∑ k, f k * e k) * β j := by
        simp_rw [mul_sub, Finset.sum_sub_distrib, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq', Finset.mem_univ, if_true, Finset.sum_mul, mul_assoc]
      rw [h1, F3, sub_self]



  have wc_flat_quot_absorb : ∀ (R : Type u) [CommRing R] (I : Ideal R),
      Module.Flat R (R ⧸ I) → ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
    intro R _ I hflat x hx
    have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : R ⧸ I)) i = 0 := by
      rw [Fin.sum_univ_one]
      show x • (1 : R ⧸ I) = 0
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hx
    obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
    set w : R := ∑ j, a 0 j * b j with hw
    have h10 : (1 : R ⧸ I) = ∑ j, a 0 j • y j := h1 0
    have hmk : Ideal.Quotient.mk I w = 1 := by
      rw [hw, map_sum, h10]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
    have hxw : x * w = 0 := by
      rw [hw, Finset.mul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have := h2 j
      rw [Fin.sum_univ_one] at this
      rw [← mul_assoc, this, zero_mul]
    refine ⟨1 - w, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
    · rw [mul_sub, mul_one, hxw, sub_zero]
  have s3 : ∀ (P' W' : Type u) [CommRing P'] [CommRing W'] [Algebra P' W'],
      Algebra.WeaklyEtale P' W' → ∀ γ' : W', ∃ ω : TensorProduct P' W' W',
        Algebra.TensorProduct.lmul' P' ω = 1 ∧
          (γ' ⊗ₜ[P'] (1 : W')) * ω = ((1 : W') ⊗ₜ[P'] γ') * ω := by
    intro P' W' _ _ _ hWE γ'
    have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' P' (S := W')) := fun b =>
      ⟨b ⊗ₜ[P'] (1 : W'), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
    have hflatQ : Module.Flat (TensorProduct P' W' W')
        (TensorProduct P' W' W' ⧸ RingHom.ker (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom) := by
      let e := RingHom.quotientKerEquivOfSurjective
        (f := (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom) hμsurj
      have h1 : ((Algebra.TensorProduct.lmul' P' (S := W')).toRingHom).Flat := hWE.flat_lmul'
      have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom).Flat :=
        RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
      have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom =
          algebraMap _ (TensorProduct P' W' W' ⧸
            RingHom.ker (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom) := by
        refine RingHom.ext fun x => ?_
        rw [Ideal.Quotient.algebraMap_eq]
        show e.symm (Algebra.TensorProduct.lmul' P' (S := W') x) = Ideal.Quotient.mk _ x
        rw [e.symm_apply_eq]
        rfl
      rw [h3, RingHom.flat_algebraMap_iff] at h2
      exact h2
    have hx : γ' ⊗ₜ[P'] (1 : W') - (1 : W') ⊗ₜ[P'] γ' ∈
        RingHom.ker (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom := by
      rw [RingHom.mem_ker]
      show Algebra.TensorProduct.lmul' P' (S := W') (γ' ⊗ₜ[P'] (1 : W') - (1 : W') ⊗ₜ[P'] γ') = 0
      rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
        mul_one, one_mul, sub_self]
    obtain ⟨z, hz, hxz⟩ := wc_flat_quot_absorb _ _ hflatQ _ hx
    have hz0 : Algebra.TensorProduct.lmul' P' (S := W') z = 0 := RingHom.mem_ker.mp hz
    refine ⟨1 - z, ?_, ?_⟩
    · rw [map_sub, map_one, hz0, sub_zero]
    · rw [← sub_eq_zero, ← sub_mul, mul_sub, mul_one, hxz, sub_self]



  have s4 : ∀ (P W : Type u) [CommRing P] [CommRing W] [Algebra P W], Module.Flat P W →
      ∀ t ∈ nonZeroDivisors P, ∀ (γ : W) (ω : TensorProduct P W W), γ * γ = t • γ →
      Algebra.TensorProduct.lmul' P ω = 1 → (γ ⊗ₜ[P] (1 : W)) * ω = ((1 : W) ⊗ₜ[P] γ) * ω →
      Module.Flat P ↥((Ideal.span {algebraMap P W t, γ} : Ideal W).restrictScalars P) →
      ∃ w : W, γ = t • w := by
    intro P W _ _ _ hWf t ht γ ω hγ hω1 hω2 hIf
    set τ := algebraMap P W t with hτ
    have hsmul : ∀ x : W, t • x = τ * x := fun x => Algebra.smul_def t x
    have hreg : ∀ x : W, τ * x = 0 → x = 0 := by
      intro x hx
      have h := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := W) ht
      apply h
      show t • x = t • 0
      rw [smul_zero, hsmul, hx]
    have hγ' : γ * γ = τ * γ := by rw [hγ, hsmul]
    set I : Ideal W := Ideal.span {τ, γ} with hI
    have hτI : τ ∈ I := Ideal.subset_span (Set.mem_insert _ _)
    have hγI : γ ∈ I := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    let IP : Submodule P W := I.restrictScalars P
    haveI : Module.Flat P IP := hIf
    let gA : W → IP := fun a => ⟨γ * a, Ideal.mul_mem_right a I hγI⟩
    let tA : W → IP := fun a => ⟨τ * a, Ideal.mul_mem_right a I hτI⟩
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset ω
    have B1 : ∑ i ∈ S, i.1 * i.2 = 1 := by
      have h := hω1
      rw [hS, map_sum] at h
      simpa only [Algebra.TensorProduct.lmul'_apply_tmul] using h
    have B2 : ∑ i ∈ S, (γ * i.1) ⊗ₜ[P] i.2 = ∑ i ∈ S, i.1 ⊗ₜ[P] (γ * i.2) := by
      have h := hω2
      rw [hS, Finset.mul_sum, Finset.mul_sum] at h
      simpa only [Algebra.TensorProduct.tmul_mul_tmul, one_mul] using h
    let X : TensorProduct P IP IP := ∑ i ∈ S, (gA i.1 ⊗ₜ[P] tA i.2 - tA i.1 ⊗ₜ[P] gA i.2)
    have hXimg : TensorProduct.map IP.subtype IP.subtype X =
        t • (∑ i ∈ S, (γ * i.1) ⊗ₜ[P] i.2 - ∑ i ∈ S, i.1 ⊗ₜ[P] (γ * i.2)) := by
      rw [smul_sub, Finset.smul_sum, Finset.smul_sum, ← Finset.sum_sub_distrib]
      simp only [X, map_sum, map_sub, TensorProduct.map_tmul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      show (γ * i.1) ⊗ₜ[P] (τ * i.2) - (τ * i.1) ⊗ₜ[P] (γ * i.2) = _
      rw [← hsmul, ← hsmul, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
        TensorProduct.smul_tmul']
    rw [B2, sub_self, smul_zero] at hXimg
    have hinj : Function.Injective (TensorProduct.map IP.subtype IP.subtype) := by
      have h1 : Function.Injective (LinearMap.lTensor IP IP.subtype) :=
        Module.Flat.lTensor_preserves_injective_linearMap _ IP.injective_subtype
      have h2 : Function.Injective (LinearMap.rTensor W IP.subtype) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ IP.injective_subtype
      rw [← LinearMap.rTensor_comp_lTensor, LinearMap.coe_comp]
      exact h2.comp h1
    have hX0 : X = 0 := hinj (by rw [hXimg, map_zero])
    have hc : ∀ x : IP, ∃ c : W, τ * c * γ = γ * (x : W) := by
      intro x
      obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp x.2
      refine ⟨u + v, ?_⟩
      rw [← huv]
      linear_combination (-v) * hγ'
    choose c hcspec using hc
    let J : Submodule P W := (Ideal.span {τ} : Ideal W).restrictScalars P
    have hind : ∀ d : W, τ * d * γ = 0 → ∀ y : IP, d * (y : W) ∈ J := by
      intro d hd y
      have hdγ : d * γ = 0 := hreg _ (by rw [← mul_assoc]; exact hd)
      obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp y.2
      show d * (y : W) ∈ Ideal.span {τ}
      rw [← huv, Ideal.mem_span_singleton']
      exact ⟨d * u, by linear_combination (-v) * hdγ⟩
    let Φ : IP →ₗ[P] IP →ₗ[P] (W ⧸ J) := LinearMap.mk₂ P (fun x y => J.mkQ (c x * (y : W)))
      (fun x₁ x₂ y => by
        rw [← map_add, ← add_mul, ← sub_eq_zero, ← map_sub, ← sub_mul, Submodule.mkQ_apply,
          Submodule.Quotient.mk_eq_zero]
        apply hind
        have h1 := hcspec (x₁ + x₂)
        have h2 := hcspec x₁
        have h3 := hcspec x₂
        rw [Submodule.coe_add] at h1
        linear_combination h1 - h2 - h3)
      (fun p x y => by
        rw [← map_smul, ← sub_eq_zero, ← map_sub, Submodule.mkQ_apply,
          Submodule.Quotient.mk_eq_zero, ← smul_mul_assoc, ← sub_mul]
        apply hind
        have h1 := hcspec (p • x)
        have h2 := hcspec x
        rw [Submodule.coe_smul, Algebra.smul_def] at h1
        rw [Algebra.smul_def]
        linear_combination h1 - (algebraMap P W p) * h2)
      (fun x y₁ y₂ => by rw [Submodule.coe_add, mul_add, map_add])
      (fun p x y => by rw [Submodule.coe_smul, mul_smul_comm, map_smul])
    have hterm1 : ∀ i : W × W, J.mkQ (c (gA i.1) * (τ * i.2)) = 0 := by
      intro i
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      show _ ∈ Ideal.span {τ}
      exact Ideal.mem_span_singleton'.mpr ⟨c (gA i.1) * i.2, by ring⟩
    have hterm2 : ∀ i : W × W, c (tA i.1) * (γ * i.2) = γ * (i.1 * i.2) := by
      intro i
      have h := hcspec (tA i.1)
      have h' : c (tA i.1) * γ = i.1 * γ := by
        apply sub_eq_zero.mp
        apply hreg
        have h2 : τ * c (tA i.1) * γ = γ * (τ * i.1) := h
        linear_combination h2
      calc c (tA i.1) * (γ * i.2) = (c (tA i.1) * γ) * i.2 := by ring
        _ = γ * (i.1 * i.2) := by rw [h']; ring
    have hΦX : TensorProduct.lift Φ X = - J.mkQ γ := by
      simp only [X, map_sum, map_sub, TensorProduct.lift.tmul]
      have hterm : ∀ i ∈ S, Φ (gA i.1) (tA i.2) - Φ (tA i.1) (gA i.2) =
          - J.mkQ (γ * (i.1 * i.2)) := by
        intro i _
        show J.mkQ (c (gA i.1) * (τ * i.2)) - J.mkQ (c (tA i.1) * (γ * i.2)) = _
        rw [hterm1 i, hterm2 i, zero_sub]
      rw [Finset.sum_congr rfl hterm, Finset.sum_neg_distrib, ← map_sum, ← Finset.mul_sum, B1,
        mul_one]
    rw [hX0, map_zero, eq_comm, neg_eq_zero, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] at hΦX
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hΦX
    exact ⟨w, by rw [hsmul, mul_comm, hw]⟩



  have s5 : ∀ (D C P : Type u) [CommRing D] [CommRing C] [Algebra D C] [CommRing P] [Algebra D P],
      Module.Flat D C → ∀ s : D, (∀ (d : D) (p : P), algebraMap D P d = s • p → ∃ d' : D, d = s * d') →
      ∀ (c : C) (w : TensorProduct D P C), s • w = (1 : P) ⊗ₜ[D] c → ∃ c' : C, c = s • c' := by
    intro D C P _ _ _ _ _ hC s hpure c w hw
    let I : Ideal D := Ideal.span {s}
    have hmemI : ∀ (M : Type u) [AddCommGroup M] [Module D M] (x : M),
        x ∈ I • (⊤ : Submodule D M) → ∃ m : M, x = s • m := by
      intro M _ _ x hx
      refine Submodule.smul_induction_on (p := fun x => ∃ m : M, x = s • m) hx ?_ ?_
      · intro r hr n _
        obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hr
        exact ⟨a • n, by rw [smul_smul, mul_comm]⟩
      · intro x y hx hy
        obtain ⟨m₁, rfl⟩ := hx
        obtain ⟨m₂, rfl⟩ := hy
        exact ⟨m₁ + m₂, by rw [smul_add]⟩
    let N : Submodule D P := I • (⊤ : Submodule D P)
    have hsN : ∀ p : P, s • p ∈ N := fun p =>
      Submodule.smul_mem_smul (Ideal.mem_span_singleton_self s) Submodule.mem_top
    have hle : I ≤ N.comap (Algebra.linearMap D P) := by
      intro x hx
      rw [Submodule.mem_comap, Algebra.linearMap_apply, Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem_smul hx Submodule.mem_top
    let f : (D ⧸ I) →ₗ[D] (P ⧸ N) := Submodule.mapQ I N (Algebra.linearMap D P) hle
    have hf : Function.Injective f := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨d, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      rw [LinearMap.mem_ker, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero,
        Algebra.linearMap_apply] at hx
      obtain ⟨p, hp⟩ := hmemI P _ hx
      obtain ⟨d', hd'⟩ := hpure d p hp
      rw [Submodule.Quotient.mk_eq_zero]
      exact Ideal.mem_span_singleton'.mpr ⟨d', by rw [hd', mul_comm]⟩
    have hinj := Module.Flat.rTensor_preserves_injective_linearMap (M := C) f hf
    let q := LinearMap.rTensor C N.mkQ
    have hkill : ∀ z : TensorProduct D (P ⧸ N) C, s • z = 0 := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [smul_zero]
      | tmul x c₀ =>
        obtain ⟨p, rfl⟩ := Submodule.Quotient.mk_surjective _ x
        rw [TensorProduct.smul_tmul', ← Submodule.Quotient.mk_smul,
          (Submodule.Quotient.mk_eq_zero N).mpr (hsN p), TensorProduct.zero_tmul]
      | add x y hx hy => rw [smul_add, hx, hy, add_zero]
    have h1 : LinearMap.rTensor C f (Submodule.Quotient.mk (1 : D) ⊗ₜ[D] c) = 0 := by
      rw [LinearMap.rTensor_tmul, Submodule.mapQ_apply, Algebra.linearMap_apply, map_one]
      have : q ((1 : P) ⊗ₜ[D] c) = 0 := by
        rw [← hw, map_smul, hkill]
      exact this
    have h2 : (Submodule.Quotient.mk (1 : D) : D ⧸ I) ⊗ₜ[D] c = 0 :=
      hinj (by rw [h1, map_zero])
    have h3 := congrArg (TensorProduct.quotTensorEquivQuotSMul C I) h2
    rw [map_zero] at h3
    have h4 : (TensorProduct.quotTensorEquivQuotSMul C I)
        ((Ideal.Quotient.mk I (1 : D)) ⊗ₜ[D] c) = 0 := h3
    rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
      Submodule.Quotient.mk_eq_zero] at h4
    obtain ⟨c', hc'⟩ := hmemI C c h4
    exact ⟨c', hc'⟩



  intro D C _ _ _ _ _ hW c s hs hc
  haveI := hW
  have hαinj : Function.Injective (algebraMap D (FractionRing D)) :=
    IsFractionRing.injective D (FractionRing D)
  have hαs : algebraMap D (FractionRing D) s ≠ 0 := fun h => hs (hαinj (by rw [h, map_zero]))
  let ι := {B : ValuationSubring (FractionRing D) // ∀ e : D, algebraMap D (FractionRing D) e ∈ B}
  letI : Algebra D (∀ i : ι, ↥(i.1)) :=
    (RingHom.pi (fun i : ι => (algebraMap D (FractionRing D)).codRestrict i.1 i.2)).toAlgebra
  have hcomp : ∀ (d : D) (i : ι),
      ((algebraMap D (∀ i : ι, ↥(i.1)) d i : ↥(i.1)) : FractionRing D) =
        algebraMap D (FractionRing D) d := fun d i => rfl
  have hnzd : ∀ g : (∀ i : ι, ↥(i.1)), (∀ i, g i ≠ 0) → g ∈ nonZeroDivisors (∀ i : ι, ↥(i.1)) := by
    intro g hg
    rw [mem_nonZeroDivisors_iff]
    constructor
    · intro x hx
      funext i
      have := congrFun hx i
      rw [Pi.mul_apply, Pi.zero_apply] at this
      exact (mul_eq_zero.mp this).resolve_left (hg i)
    · intro x hx
      funext i
      have := congrFun hx i
      rw [Pi.mul_apply, Pi.zero_apply] at this
      exact (mul_eq_zero.mp this).resolve_right (hg i)

  have hpure : ∀ (d : D) (p : ∀ i : ι, ↥(i.1)),
      algebraMap D (∀ i : ι, ↥(i.1)) d = s • p → ∃ d' : D, d = s * d' := by
    intro d p hdp
    apply s1 D s d hs
    intro B hB
    rw [Algebra.smul_def] at hdp
    have h1 : algebraMap D (FractionRing D) d =
        algebraMap D (FractionRing D) s * ((p ⟨B, hB⟩ : ↥B) : FractionRing D) :=
      congrArg (fun q : (∀ i : ι, ↥(i.1)) => ((q ⟨B, hB⟩ : ↥B) : FractionRing D)) hdp
    rw [h1, mul_div_cancel_left₀ _ hαs]
    exact (p ⟨B, hB⟩).2

  have ht : algebraMap D (∀ i : ι, ↥(i.1)) s ∈ nonZeroDivisors (∀ i : ι, ↥(i.1)) := by
    apply hnzd
    intro i h
    apply hαs
    rw [← hcomp s i, h]
    rfl

  let W := TensorProduct D (∀ i : ι, ↥(i.1)) C
  let γ : W := (1 : ∀ i : ι, ↥(i.1)) ⊗ₜ[D] c
  have hγ : γ * γ = algebraMap D (∀ i : ι, ↥(i.1)) s • γ := by
    simp only [γ]
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hc, TensorProduct.tmul_smul, algebraMap_smul]

  obtain ⟨ω, hω1, hω2⟩ := s3 (∀ i : ι, ↥(i.1)) W inferInstance γ

  have hIflat : Module.Flat (∀ i : ι, ↥(i.1))
      ↥((Ideal.span {algebraMap (∀ i : ι, ↥(i.1)) W (algebraMap D (∀ i : ι, ↥(i.1)) s), γ} :
        Ideal W).restrictScalars (∀ i : ι, ↥(i.1))) := by
    refine s2 ι (fun i : ι => ↥(i.1))
      ↥((Ideal.span {algebraMap (∀ i : ι, ↥(i.1)) W (algebraMap D (∀ i : ι, ↥(i.1)) s), γ} :
        Ideal W).restrictScalars (∀ i : ι, ↥(i.1))) ?_ ?_
    · intro i a b
      exact ValuationRing.dvd_total a b
    · intro g hg n hn
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := W) (hnzd g hg)
      apply Subtype.ext
      apply hreg
      have := congrArg Subtype.val hn
      simpa using this

  obtain ⟨w, hw⟩ := s4 (∀ i : ι, ↥(i.1)) W inferInstance
    (algebraMap D (∀ i : ι, ↥(i.1)) s) ht γ ω hγ hω1 hω2 hIflat
  have hsw : s • w = (1 : ∀ i : ι, ↥(i.1)) ⊗ₜ[D] c := by
    rw [← algebraMap_smul (∀ i : ι, ↥(i.1)) s w]
    exact hw.symm

  exact s5 D C (∀ i : ι, ↥(i.1)) hW.flat s hpure c w hsw

theorem wc_weaklyEtale_field_connected_unique : ∀ (L R : Type u) [Field L] [CommRing R] [Algebra L R], Algebra.WeaklyEtale L R → (∀ e : R, e * e = e → e = 0 ∨ e = 1) → ∀ ψ₁ ψ₂ : R →ₐ[L] L, ψ₁ = ψ₂ :=
by
  intro L R _ _ _ hW hconn ψ₁ ψ₂
  classical
  have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' L (S := R)) := fun b =>
    ⟨b ⊗ₜ[L] (1 : R), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
  have hflatQ : Module.Flat (TensorProduct L R R)
      (TensorProduct L R R ⧸ RingHom.ker (Algebra.TensorProduct.lmul' L (S := R)).toRingHom) := by
    let e := RingHom.quotientKerEquivOfSurjective
      (f := (Algebra.TensorProduct.lmul' L (S := R)).toRingHom) hμsurj
    have h1 : ((Algebra.TensorProduct.lmul' L (S := R)).toRingHom).Flat := hW.flat_lmul'
    have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' L (S := R)).toRingHom).Flat :=
      RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
    have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' L (S := R)).toRingHom =
        algebraMap _ (TensorProduct L R R ⧸
          RingHom.ker (Algebra.TensorProduct.lmul' L (S := R)).toRingHom) := by
      refine RingHom.ext fun t => ?_
      rw [Ideal.Quotient.algebraMap_eq]
      show e.symm (Algebra.TensorProduct.lmul' L (S := R) t) = Ideal.Quotient.mk _ t
      rw [e.symm_apply_eq]
      rfl
    rw [h3, RingHom.flat_algebraMap_iff] at h2
    exact h2
  have habs : ∀ (S : Type u) [CommRing S] (I : Ideal S), Module.Flat S (S ⧸ I) →
      ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
    intro S _ I hflat x hx
    have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : S ⧸ I)) i = 0 := by
      rw [Fin.sum_univ_one]
      show x • (1 : S ⧸ I) = 0
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hx
    obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
    set w : S := ∑ j, a 0 j * b j with hw
    have h10 : (1 : S ⧸ I) = ∑ j, a 0 j • y j := h1 0
    have hmk : Ideal.Quotient.mk I w = 1 := by
      rw [hw, map_sum, h10]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
    have hxw : x * w = 0 := by
      rw [hw, Finset.mul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have := h2 j
      rw [Fin.sum_univ_one] at this
      rw [← mul_assoc, this, zero_mul]
    refine ⟨1 - w, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
    · rw [mul_sub, mul_one, hxw, sub_zero]
  have habs := habs _ _ hflatQ

  have s1 : ∀ b : R, ∃ w : TensorProduct L R R, Algebra.TensorProduct.lmul' L w = 1 ∧
      (b ⊗ₜ[L] (1 : R)) * w = ((1 : R) ⊗ₜ[L] b) * w := by
    intro b
    have hx : b ⊗ₜ[L] (1 : R) - (1 : R) ⊗ₜ[L] b ∈
        RingHom.ker (Algebra.TensorProduct.lmul' L (S := R)).toRingHom := by
      rw [RingHom.mem_ker]
      show Algebra.TensorProduct.lmul' L (S := R) (b ⊗ₜ[L] (1 : R) - (1 : R) ⊗ₜ[L] b) = 0
      rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
        mul_one, one_mul, sub_self]
    obtain ⟨z, hzI, hxz⟩ := habs _ hx
    refine ⟨1 - z, ?_, ?_⟩
    · have hz : Algebra.TensorProduct.lmul' L (S := R) z = 0 := RingHom.mem_ker.mp hzI
      rw [map_sub, map_one, hz, sub_zero]
    · rw [← sub_eq_zero, ← sub_mul, mul_sub, mul_one, hxz, sub_self]

  have s2 : ∀ r : R, ∃ g : R →ₗ[L] R, ∀ b : R, r * g (r * b) = r * b := by
    intro r
    let m := LinearMap.mulLeft L r
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective m.rangeRestrict
      (LinearMap.range_rangeRestrict m)
    obtain ⟨g, hg⟩ := LinearMap.exists_extend s
    refine ⟨g, fun b => ?_⟩
    have hp : r * b ∈ LinearMap.range m := ⟨b, rfl⟩
    have h1 : g (r * b) = s ⟨r * b, hp⟩ := LinearMap.congr_fun hg ⟨r * b, hp⟩
    rw [h1]
    have h2 := congrArg Subtype.val (LinearMap.congr_fun hs ⟨r * b, hp⟩)
    exact h2

  have s3 : ∀ (r : R) (g : R →ₗ[L] R), (∀ b : R, r * g (r * b) = r * b) →
      ∀ w : TensorProduct L R R, Algebra.TensorProduct.lmul' L w = 1 →
      (r ⊗ₜ[L] (1 : R)) * w = ((1 : R) ⊗ₜ[L] r) * w → ∃ y : R, r = r * r * y := by
    intro r g hg w hμ hw
    let Φ : TensorProduct L R R →ₗ[L] R := TensorProduct.lift ((LinearMap.mul L R).compl₂ g)
    have hΦ : ∀ a b : R, Φ (a ⊗ₜ[L] b) = a * g b := by
      intro a b
      simp [Φ, TensorProduct.lift.tmul]
    have hA : ∀ t, r * Φ (((1 : R) ⊗ₜ[L] r) * t) = r * Algebra.TensorProduct.lmul' L t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => rw [mul_zero, map_zero, map_zero]
      | tmul a b =>
        rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, Algebra.TensorProduct.lmul'_apply_tmul,
          one_mul]
        calc r * (a * g (r * b)) = a * (r * g (r * b)) := by ring
          _ = a * (r * b) := by rw [hg]
          _ = r * (a * b) := by ring
      | add x y hx hy => rw [mul_add, map_add, mul_add, hx, hy, map_add, mul_add]
    have hB : ∀ t, Φ ((r ⊗ₜ[L] (1 : R)) * t) = r * Φ t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => rw [mul_zero, map_zero, mul_zero]
      | tmul a b => rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, hΦ, one_mul, mul_assoc]
      | add x y hx hy => rw [mul_add, map_add, hx, hy, map_add, mul_add]
    refine ⟨Φ w, ?_⟩
    calc r = r * Algebra.TensorProduct.lmul' L w := by rw [hμ, mul_one]
      _ = r * Φ (((1 : R) ⊗ₜ[L] r) * w) := (hA w).symm
      _ = r * Φ ((r ⊗ₜ[L] (1 : R)) * w) := by rw [hw]
      _ = r * r * Φ w := by rw [hB, mul_assoc]

  have hunit : ∀ r : R, r = 0 ∨ IsUnit r := by
    intro r
    obtain ⟨g, hg⟩ := s2 r
    obtain ⟨w, hμ, hw⟩ := s1 r
    obtain ⟨y, hy⟩ := s3 r g hg w hμ hw
    have he : (r * y) * (r * y) = r * y := by
      calc (r * y) * (r * y) = (r * r * y) * y := by ring
        _ = r * y := by rw [← hy]
    rcases hconn (r * y) he with h | h
    · left
      rw [hy, mul_assoc, h, mul_zero]
    · right
      exact ⟨⟨r, y, h, by rw [mul_comm]; exact h⟩, rfl⟩

  ext r
  have h0 : ψ₁ (r - algebraMap L R (ψ₁ r)) = 0 := by
    rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
  rcases hunit (r - algebraMap L R (ψ₁ r)) with h | h
  · have hr : r = algebraMap L R (ψ₁ r) := sub_eq_zero.mp h
    rw [hr, AlgHom.commutes, AlgHom.commutes]
  · exfalso
    have h' := h.map ψ₁
    rw [h0] at h'
    exact not_isUnit_zero h'

theorem wc_olivier_unique_point : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [IsLocalRing A] [IsLocalRing B], HenselianLocalRing A → IsSepClosed (IsLocalRing.ResidueField A) → IsLocalHom (algebraMap A B) → Algebra.WeaklyEtale A B → ∀ (K : Type u) [Field K] (φ₁ φ₂ : B →+* K), φ₁.comp (algebraMap A B) = φ₂.comp (algebraMap A B) → φ₁ = φ₂ :=
by
  intro A B _ _ _ _ _ hHen hSep hLoc hW K _ φ₁ φ₂ hφ
  classical
  letI : Algebra A K := (φ₁.comp (algebraMap A B)).toAlgebra
  have hAK : algebraMap A K = φ₁.comp (algebraMap A B) := rfl
  have hφ₁A : φ₁.comp (algebraMap A B) = algebraMap A K := hAK.symm
  have hφ₂A : φ₂.comp (algebraMap A B) = algebraMap A K := hφ.symm.trans hAK.symm

  have hinj : Function.Injective (algebraMap (integralClosure A K) K) :=
    fun x y h => Subtype.ext h
  let j : FractionRing (integralClosure A K) →ₐ[integralClosure A K] K :=
    IsFractionRing.liftAlgHom (g := IsScalarTower.toAlgHom (integralClosure A K)
      (integralClosure A K) K) hinj
  have hj : Function.Injective j := (j : FractionRing (integralClosure A K) →+* K).injective
  have hjA : ∀ x : integralClosure A K,
      j (algebraMap (integralClosure A K) (FractionRing (integralClosure A K)) x) = (x : K) :=
    fun x => j.commutes x

  haveI hA'ic : IsIntegrallyClosed (integralClosure A K) := by
    rw [isIntegrallyClosed_iff (FractionRing (integralClosure A K))]
    intro x hx
    have h1 : IsIntegral (integralClosure A K) (j x) := hx.map j
    have h2 : IsIntegral A (j x) := isIntegral_trans (j x) h1
    refine ⟨⟨j x, h2⟩, hj ?_⟩
    rw [hjA]

  obtain ⟨hA'loc, hA'hom⟩ :=
    wc_henselian_integral_domain_local A (integralClosure A K) hHen inferInstance
  haveI := hA'loc

  have factor : ∀ φ : B →+* K, φ.comp (algebraMap A B) = algebraMap A K →
      ∃ Φ : B →ₐ[A] FractionRing (integralClosure A K), ∀ b, j (Φ b) = φ b := by
    intro φ hφA
    have hrange : ∀ b, φ b ∈ (j : FractionRing (integralClosure A K) →+* K).range := by
      intro b
      obtain ⟨f, hf0, hfe⟩ := wc_weaklyEtale_point_algebraic A B K hW φ b
      rw [hφA] at hf0 hfe
      set f' : Polynomial (integralClosure A K) := f.map (algebraMap A (integralClosure A K))
        with hf'
      have hmapmap : f'.map (algebraMap (integralClosure A K) K) = f.map (algebraMap A K) := by
        rw [hf', Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
      have hf'0 : f' ≠ 0 := by
        intro h
        apply hf0
        rw [← hmapmap, h, Polynomial.map_zero]
      have hroot : Polynomial.aeval (φ b) f' = 0 := by
        rw [hf', Polynomial.aeval_map_algebraMap, Polynomial.aeval_def]
        exact hfe
      have hint := isIntegral_leadingCoeff_smul f' (φ b) hroot
      have hint' : IsIntegral A (f'.leadingCoeff • φ b) := isIntegral_trans _ hint
      have hlc : f'.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hf'0
      have hlcK : ((f'.leadingCoeff : integralClosure A K) : K) ≠ 0 := by
        intro h
        apply hlc
        exact Subtype.ext h
      refine ⟨algebraMap (integralClosure A K) (FractionRing (integralClosure A K))
          ⟨f'.leadingCoeff • φ b, hint'⟩ /
        algebraMap (integralClosure A K) (FractionRing (integralClosure A K)) f'.leadingCoeff, ?_⟩
      rw [map_div₀]
      change j _ / j _ = φ b
      rw [hjA, hjA]
      change (f'.leadingCoeff • φ b) / ((f'.leadingCoeff : integralClosure A K) : K) = φ b
      rw [Algebra.smul_def]
      change ((f'.leadingCoeff : integralClosure A K) : K) * φ b /
        ((f'.leadingCoeff : integralClosure A K) : K) = φ b
      field_simp
    let eL : FractionRing (integralClosure A K) ≃+*
        (j : FractionRing (integralClosure A K) →+* K).range :=
      RingEquiv.ofBijective (j : FractionRing (integralClosure A K) →+* K).rangeRestrict
        ⟨fun x y h => hj (congrArg Subtype.val h),
          (j : FractionRing (integralClosure A K) →+* K).rangeRestrict_surjective⟩
    let Φ' : B →+* FractionRing (integralClosure A K) :=
      eL.symm.toRingHom.comp (φ.codRestrict _ hrange)
    have hjΦ : ∀ b, j (Φ' b) = φ b := by
      intro b
      have h := eL.apply_symm_apply (φ.codRestrict _ hrange b)
      exact congrArg Subtype.val h
    refine ⟨{ Φ' with commutes' := fun a => ?_ }, hjΦ⟩
    apply hj
    change j (Φ' (algebraMap A B a)) = _
    rw [hjΦ, IsScalarTower.algebraMap_apply A (integralClosure A K)
      (FractionRing (integralClosure A K)), hjA]
    rw [← RingHom.comp_apply, hφA, IsScalarTower.algebraMap_apply A (integralClosure A K) K]
    rfl
  obtain ⟨Φ₁, hΦ₁⟩ := factor φ₁ hφ₁A
  obtain ⟨Φ₂, hΦ₂⟩ := factor φ₂ hφ₂A

  haveI hCloc : IsLocalRing (TensorProduct A (integralClosure A K) B) :=
    wc_local_tensor_integral A B (integralClosure A K) hSep hLoc hA'hom inferInstance

  have h7 := wc_weaklyEtale_normal_idem (integralClosure A K)
    (TensorProduct A (integralClosure A K) B) inferInstance

  haveI : Module.Flat A B := hW.flat
  have u6 : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D],
      IsLocalRing (TensorProduct A D B) →
      (∀ (c : TensorProduct A D B) (s : D), s ≠ 0 → c * c = s • c →
        ∃ c' : TensorProduct A D B, c = s • c') →
      ∀ e : TensorProduct A (FractionRing D) B, e * e = e → e = 0 ∨ e = 1 := by
    intro D _ _ _ hCl h7' e he
    haveI := hCl
    let ι : TensorProduct A D B →ₐ[A] TensorProduct A (FractionRing D) B :=
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom A D (FractionRing D)) (AlgHom.id A B)
    have hιinj : Function.Injective ι := by
      have hf : Function.Injective (IsScalarTower.toAlgHom A D (FractionRing D)).toLinearMap :=
        IsFractionRing.injective D (FractionRing D)
      have heq : ∀ x, ι x =
          LinearMap.rTensor B (IsScalarTower.toAlgHom A D (FractionRing D)).toLinearMap x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul a b => rfl
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      intro x y hxy
      rw [heq, heq] at hxy
      exact Module.Flat.rTensor_preserves_injective_linearMap _ hf hxy
    have hιs : ∀ (s : D) (c : TensorProduct A D B),
        ι (s • c) = algebraMap D (FractionRing D) s • ι c := by
      intro s c
      induction c using TensorProduct.induction_on with
      | zero => rw [smul_zero, map_zero, smul_zero]
      | tmul d b =>
        rw [TensorProduct.smul_tmul']
        change (algebraMap D (FractionRing D) (s • d)) ⊗ₜ[A] b =
          algebraMap D (FractionRing D) s • ((algebraMap D (FractionRing D) d) ⊗ₜ[A] b)
        rw [TensorProduct.smul_tmul', smul_eq_mul, smul_eq_mul, map_mul]
      | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]
    have hσ : ∀ s : D, s ≠ 0 → algebraMap D (FractionRing D) s ≠ 0 := by
      intro s hs h
      apply hs
      apply IsFractionRing.injective D (FractionRing D)
      rw [h, map_zero]
    have hden : ∀ e : TensorProduct A (FractionRing D) B,
        ∃ (c : TensorProduct A D B) (s : D), s ≠ 0 ∧ algebraMap D (FractionRing D) s • e = ι c := by
      intro e
      induction e using TensorProduct.induction_on with
      | zero => exact ⟨0, 1, one_ne_zero, by rw [smul_zero, map_zero]⟩
      | tmul ℓ b =>
        obtain ⟨d, s, hs, rfl⟩ := IsFractionRing.div_surjective (A := D) ℓ
        have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
        refine ⟨d ⊗ₜ[A] b, s, hs0, ?_⟩
        have hl : algebraMap D (FractionRing D) s •
            (algebraMap D (FractionRing D) d / algebraMap D (FractionRing D) s) =
            algebraMap D (FractionRing D) d := by
          have := hσ s hs0
          rw [smul_eq_mul]
          field_simp
        rw [TensorProduct.smul_tmul', hl]
        rfl
      | add x y hx hy =>
        obtain ⟨c₁, s₁, hs₁, h₁⟩ := hx
        obtain ⟨c₂, s₂, hs₂, h₂⟩ := hy
        refine ⟨s₂ • c₁ + s₁ • c₂, s₁ * s₂, mul_ne_zero hs₁ hs₂, ?_⟩
        rw [map_add, hιs, hιs, ← h₁, ← h₂, smul_add, map_mul, smul_smul, smul_smul,
          mul_comm (algebraMap D (FractionRing D) s₂)]
    obtain ⟨c, s, hs, hce⟩ := hden e
    have hcc : c * c = s • c := by
      apply hιinj
      rw [map_mul, hιs, ← hce, smul_mul_smul_comm, he, smul_smul]
    obtain ⟨c', hc'⟩ := h7' c s hs hcc
    have hec : e = ι c' := by
      have h1 : algebraMap D (FractionRing D) s • e = algebraMap D (FractionRing D) s • ι c' := by
        rw [hce, hc', hιs]
      rw [← inv_smul_smul₀ (hσ s hs) e, h1, inv_smul_smul₀ (hσ s hs)]
    have hc'i : c' * c' = c' := by
      apply hιinj
      rw [map_mul, ← hec, he]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self c' with hu | hu
    · right
      have : c' = 1 := (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp hc'i
      rw [hec, this, map_one]
    · left
      have hi : IsIdempotentElem (1 - c') := IsIdempotentElem.one_sub hc'i
      have h1 : 1 - c' = 1 := (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp hi
      have : c' = 0 := by
        have := congrArg (fun t => 1 - t) h1
        simpa using this
      rw [hec, this, map_zero]
  have hconn := u6 (integralClosure A K) hCloc h7

  let ψ₁ : TensorProduct A (FractionRing (integralClosure A K)) B →ₐ[FractionRing (integralClosure A K)]
      FractionRing (integralClosure A K) :=
    Algebra.TensorProduct.lift (AlgHom.id _ _) Φ₁ (fun _ _ => Commute.all _ _)
  let ψ₂ : TensorProduct A (FractionRing (integralClosure A K)) B →ₐ[FractionRing (integralClosure A K)]
      FractionRing (integralClosure A K) :=
    Algebra.TensorProduct.lift (AlgHom.id _ _) Φ₂ (fun _ _ => Commute.all _ _)
  have hψ := wc_weaklyEtale_field_connected_unique (FractionRing (integralClosure A K))
    (TensorProduct A (FractionRing (integralClosure A K)) B) inferInstance hconn ψ₁ ψ₂
  refine RingHom.ext fun b => ?_
  have h1 : ψ₁ (1 ⊗ₜ[A] b) = Φ₁ b := by
    simp [ψ₁, Algebra.TensorProduct.lift_tmul]
  have h2 : ψ₂ (1 ⊗ₜ[A] b) = Φ₂ b := by
    simp [ψ₂, Algebra.TensorProduct.lift_tmul]
  have hΦ : Φ₁ b = Φ₂ b := by rw [← h1, ← h2, hψ]
  rw [← hΦ₁ b, ← hΦ₂ b, hΦ]

theorem wc_olivier : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [IsLocalRing A] [IsLocalRing B], HenselianLocalRing A → IsSepClosed (IsLocalRing.ResidueField A) → IsLocalHom (algebraMap A B) → Algebra.WeaklyEtale A B → Function.Bijective (algebraMap A B) :=
by
  intro A B _ _ _ _ _ hHen hSep hLoc hW
  classical
  haveI : Module.Flat A B := hW.flat
  haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' A (S := B)) := fun b =>
    ⟨b ⊗ₜ[A] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩

  have hflatQ : Module.Flat (TensorProduct A B B)
      (TensorProduct A B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
    let e := RingHom.quotientKerEquivOfSurjective
      (f := (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) hμsurj
    have h1 : ((Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat := hW.flat_lmul'
    have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom).Flat :=
      RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
    have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' A (S := B)).toRingHom =
        algebraMap _ (TensorProduct A B B ⧸
          RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom) := by
      refine RingHom.ext fun t => ?_
      rw [Ideal.Quotient.algebraMap_eq]
      show e.symm (Algebra.TensorProduct.lmul' A (S := B) t) = Ideal.Quotient.mk _ t
      rw [e.symm_apply_eq]
      rfl
    rw [h3, RingHom.flat_algebraMap_iff] at h2
    exact h2
  have habs := wc_flat_quot_absorb _ _ hflatQ

  have hIP : ∀ P : Ideal (TensorProduct A B B), P.IsPrime →
      RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom ≤ P := by
    intro P hP
    let q : TensorProduct A B B →+* FractionRing (TensorProduct A B B ⧸ P) :=
      (algebraMap (TensorProduct A B B ⧸ P) (FractionRing (TensorProduct A B B ⧸ P))).comp
        (Ideal.Quotient.mk P)
    have hq : ∀ t, q t = 0 ↔ t ∈ P := by
      intro t
      simp only [q, RingHom.comp_apply]
      rw [map_eq_zero_iff _ (IsFractionRing.injective _ _), Ideal.Quotient.eq_zero_iff_mem]
    have key := wc_olivier_unique_point A B hHen hSep hLoc hW
      (FractionRing (TensorProduct A B B ⧸ P))
      (q.comp Algebra.TensorProduct.includeLeftRingHom)
      (q.comp (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A B B).toRingHom)
      (by
        refine RingHom.ext fun a => ?_
        simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul])
    have hker : RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom =
        KaehlerDifferential.ideal A B := rfl
    rw [hker, ← KaehlerDifferential.span_range_eq_ideal, Ideal.span_le]
    rintro _ ⟨b, rfl⟩
    rw [SetLike.mem_coe, ← hq, map_sub]
    have hb := RingHom.congr_fun key b
    simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply] at hb
    rw [hb, sub_self]

  have hI0 : ∀ x ∈ RingHom.ker (Algebra.TensorProduct.lmul' A (S := B)).toRingHom, x = 0 := by
    intro x hx
    obtain ⟨z, hzI, hxz⟩ := habs x hx
    have hz : IsNilpotent z := by
      rw [← mem_nilradical, nilradical_eq_sInf, Submodule.mem_sInf]
      intro P hP
      exact hIP P hP hzI
    obtain ⟨n, hn⟩ := hz
    have hpow : ∀ k : ℕ, x * z ^ k = x := by
      intro k
      induction k with
      | zero => rw [pow_zero, mul_one]
      | succ k ih => rw [pow_succ, ← mul_assoc, ih, hxz]
    rw [← hpow n, hn, mul_zero]
  have hμinj : Function.Injective (Algebra.TensorProduct.lmul' A (S := B)) := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    exact hI0 t (RingHom.mem_ker.mpr ht)

  refine ⟨FaithfulSMul.algebraMap_injective A B, ?_⟩
  have hsub : Subsingleton (TensorProduct A B (B ⧸ LinearMap.range (Algebra.linearMap A B))) := by
    refine subsingleton_of_forall_eq 0 fun y => ?_
    obtain ⟨t, rfl⟩ := LinearMap.lTensor_surjective B
      (Submodule.mkQ_surjective (LinearMap.range (Algebra.linearMap A B))) y
    have ht : t = (Algebra.TensorProduct.lmul' A (S := B) t) ⊗ₜ[A] (1 : B) :=
      hμinj (by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one])
    have h1 : (LinearMap.range (Algebra.linearMap A B)).mkQ (1 : B) = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨1, by simp⟩
    rw [ht, LinearMap.lTensor_tmul, h1, TensorProduct.tmul_zero]
  haveI := hsub
  haveI := Module.FaithfullyFlat.lTensor_reflects_triviality A B
    (B ⧸ LinearMap.range (Algebra.linearMap A B))
  intro b
  have hb : Submodule.Quotient.mk (p := LinearMap.range (Algebra.linearMap A B)) b = 0 :=
    Subsingleton.elim _ _
  obtain ⟨a, ha⟩ := (Submodule.Quotient.mk_eq_zero _).mp hb
  exact ⟨a, ha⟩

theorem wc_bs_weaklyEtale_indEtale_locally : ∀ (S C : Type u) [CommRing S] [CommRing C] [Algebra S C], Algebra.WeaklyEtale S C → ∃ (T : Type u) (_ : CommRing T) (_ : Algebra C T), Module.FaithfullyFlat C T ∧ Algebra.WeaklyEtale C T ∧ wcIndEtale ((algebraMap C T).comp (algebraMap S C)) :=
by
  intro S C _ _ _ _
  obtain ⟨T, _, _, hFF, hind, hret⟩ := wc_retCover_exists C
  have hCT : Algebra.WeaklyEtale C T := by
    have h := wc_indEtale_weaklyEtale (algebraMap C T) hind
    rwa [show (algebraMap C T).toAlgebra = ‹Algebra C T› from
      Algebra.algebra_ext _ _ (fun _ => rfl)] at h
  refine ⟨T, inferInstance, inferInstance, hFF, hCT, ?_⟩

  have hsplit : ∀ (n : ℕ) (g : Fin n → T), Ideal.span (Set.range g) = ⊤ →
      ∃ e : Fin n → T, (∀ i, e i * e i = e i) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧
        ∑ i, e i = 1 ∧ ∀ i, ∃ c : T, c * g i = e i := by
    intro n g hg
    rcases subsingleton_or_nontrivial T with hT | hT
    · refine ⟨fun _ => 0, fun _ => by simp, fun _ _ _ => by simp, Subsingleton.elim _ _,
        fun _ => ⟨0, Subsingleton.elim _ _⟩⟩
    have hI : Ideal.span (insert (Polynomial.X : Polynomial T)
        (Set.range (fun j => Polynomial.C (g j)))) = ⊤ := by
      apply eq_top_iff.mpr
      have h1 : Ideal.span (Set.range (fun j => Polynomial.C (g j))) = ⊤ := by
        have e1 : Set.range (fun j => Polynomial.C (g j)) =
            (Polynomial.C : T →+* Polynomial T) '' Set.range g := by
          rw [← Set.range_comp]; rfl
        rw [e1, ← Ideal.map_span, hg, Ideal.map_top]
      rw [← h1]
      exact Ideal.span_mono (Set.subset_insert _ _)
    obtain ⟨ε, x, hid, horth, hsum, _, ⟨v, hv⟩, hw⟩ :=
      hret Polynomial.X 0 Polynomial.monic_X ⟨0, 0, 1, by simp⟩ n g Polynomial.X 0 0
        Polynomial.monic_X (by rw [Polynomial.natDegree_X]; exact Nat.one_pos)
        (by rw [hI]; trivial) (by rw [hI]; trivial)
    have hε0 : ε 0 = 0 := by
      rw [← hv, Polynomial.eval_zero, zero_mul]
    refine ⟨fun j => ε j.succ, fun i => hid _, fun i j hij => horth _ _ ?_, ?_, fun i => ?_⟩
    · exact fun h => hij (Fin.succ_injective _ h)
    · rw [Fin.sum_univ_succ, hε0, zero_add] at hsum
      exact hsum
    · obtain ⟨w, hw'⟩ := hw i
      exact ⟨w, by rw [mul_comm]; exact hw'⟩
  letI : Algebra S T := ((algebraMap C T).comp (algebraMap S C)).toAlgebra
  have key : wcIndEtale (algebraMap S T) := by
    apply wc_indEtale_of_local_split S T hsplit
    intro M _
    have hTB : Algebra.WeaklyEtale T (Localization.AtPrime M) :=
      wc_localization_weaklyEtale T (Localization.AtPrime M) M.primeCompl
    obtain ⟨hhens, hsep⟩ := wc_ret_stalk_strictlyHenselian T hret M
    have hSB : Algebra.WeaklyEtale S (Localization.AtPrime M) := by
      haveI : IsScalarTower S C T := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : Algebra.WeaklyEtale S T := Algebra.WeaklyEtale.trans S C T
      exact Algebra.WeaklyEtale.trans S T (Localization.AtPrime M)
    haveI := hhens
    obtain ⟨R, _, σ, ρ, _, hρσ, hRh, hRsep, hρloc, hσind⟩ :=
      wc_strict_hull S (Localization.AtPrime M) hsep
    letI : Algebra R (Localization.AtPrime M) := ρ.toAlgebra
    letI : Algebra S R := σ.toAlgebra
    have htower := IsScalarTower.of_algebraMap_eq (R := S) (S := R) (A := Localization.AtPrime M)
      (fun s => (RingHom.congr_fun hρσ s).symm)
    have hSR : Algebra.WeaklyEtale S R := wc_indEtale_weaklyEtale σ hσind
    have hRB : Algebra.WeaklyEtale R (Localization.AtPrime M) :=
      @wc_weaklyEtale_cancel S R (Localization.AtPrime M) _ _ _ _ _ _ htower hSR hSB
    have hbij : Function.Bijective ρ := wc_olivier R (Localization.AtPrime M) hRh hRsep hρloc hRB
    have hρind : wcIndEtale ρ := by
      let e := RingEquiv.ofBijective ρ hbij
      unfold wcIndEtale
      intro P _ _ _ h
      refine ⟨R, inferInstance, inferInstance, inferInstance, ?_⟩
      let ε : Localization.AtPrime M ≃ₐ[R] R :=
        AlgEquiv.ofRingEquiv (f := e.symm) (fun r => e.symm_apply_apply r)
      refine ⟨ε.toAlgHom.comp h, Algebra.ofId R (Localization.AtPrime M), ?_⟩
      ext p
      exact e.apply_symm_apply (h p)
    have hcomp := wc_indEtale_comp σ ρ hσind hρind
    rw [hρσ, IsScalarTower.algebraMap_eq S T (Localization.AtPrime M)] at hcomp
    exact hcomp
  exact key

theorem wc_affIndEt_refine : ∀ (Y : Scheme.{u}) (A : Y.Opens) (U : Y.ProEt), wcAffIndEt Y A U → ∀ R ∈ Scheme.ProEt.topology Y U, ∃ (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), wcAffCov Y A U k V f ∧ ∀ i, R.arrows (f i) :=
by
  intro Y A U hU R hR
  obtain ⟨hUaff, g, hg, hγ⟩ := hU

  have isoInd : ∀ {R' S' : Type u} [CommRing R'] [CommRing S'] (e : R' ≃+* S'),
      wcIndEtale (e : R' →+* S') := by
    intro R' S' _ _ e
    unfold wcIndEtale
    letI := (e : R' →+* S').toAlgebra
    intro P _ _ _ h
    refine ⟨R', inferInstance, inferInstance, inferInstance, ?_⟩
    let ε : S' ≃ₐ[R'] R' := AlgEquiv.ofRingEquiv (f := e.symm) (fun r => e.symm_apply_apply r)
    refine ⟨ε.toAlgHom.comp h, Algebra.ofId R' S', ?_⟩
    ext p
    exact e.apply_symm_apply (h p)

  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩

  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      haveI := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu

  have appTopWE : ∀ {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z] (h : X ⟶ Z), WeaklyEtale h →
      WeaklyEtale (Spec.map h.appTop) := by
    intro X Z _ _ h hh
    have e : Spec.map h.appTop = X.isoSpec.inv ≫ h ≫ Z.isoSpec.hom := by
      rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
    rw [e]
    infer_instance
  haveI := hUaff
  obtain ⟨k, W, w, hwR, hWaff, hcov⟩ := proet_qcqs_finite_affine_refinement Y U R hR

  have hsurjW : ∀ τ : U.left, ∃ j, τ ∈ Set.range (w j).left := by
    intro τ
    obtain ⟨W', a, ha, y, hy⟩ := (wc_proet_cover_surj_quotient Y U _ hcov).1 τ
    obtain ⟨Z, b, c, hc, rfl⟩ := ha
    rcases hc with ⟨j⟩
    exact ⟨j, b.left y, hy⟩

  have step : ∀ j, ∃ (V : Y.ProEt) (v : V ⟶ W j), IsAffine V.left ∧ Function.Surjective v.left ∧
      wcIndEtale (v.left.appTop.hom.comp (w j).left.appTop.hom) := by
    intro j
    haveI := hWaff j
    have h1 : WeaklyEtale ((w j).left ≫ U.hom) := by
      have hw : (w j).left ≫ U.hom = (W j).hom := MorphismProperty.Over.w (w j)
      rw [hw]
      exact (W j).prop
    have hwj : WeaklyEtale (w j).left := @WeaklyEtale.of_comp _ _ _ (w j).left U.hom h1 U.prop
    letI : Algebra Γ(U.left, ⊤) Γ((W j).left, ⊤) := (w j).left.appTop.hom.toAlgebra
    have hWE : Algebra.WeaklyEtale Γ(U.left, ⊤) Γ((W j).left, ⊤) :=
      toRing _ _ (appTopWE (w j).left hwj)
    obtain ⟨T, _, _, hFF, hTWE, hind⟩ :=
      wc_bs_weaklyEtale_indEtale_locally Γ(U.left, ⊤) Γ((W j).left, ⊤) hWE
    haveI := toSch _ _ hTWE
    haveI := (W j).prop
    let p : Spec (CommRingCat.of T) ⟶ (W j).left :=
      Spec.map (CommRingCat.ofHom (algebraMap Γ((W j).left, ⊤) T)) ≫ (W j).left.isoSpec.inv
    have hinv : (W j).left.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ((W j).left, ⊤)).inv := by
      rw [← Iso.comp_hom_eq_id, ← Scheme.toSpecΓ_appTop, ← Scheme.isoSpec_hom,
        ← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
    have hp : p.appTop = CommRingCat.ofHom (algebraMap Γ((W j).left, ⊤) T) ≫
        (Scheme.ΓSpecIso (CommRingCat.of T)).inv := by
      rw [Scheme.ΓSpecIso_inv_naturality]
      simp only [p]
      rw [Scheme.Hom.comp_appTop, hinv]
      rfl
    refine ⟨Scheme.ProEt.mk (p ≫ (W j).hom), MorphismProperty.Over.homMk p rfl trivial, ?_, ?_, ?_⟩
    · show IsAffine (Spec (CommRingCat.of T))
      infer_instance
    · show Function.Surjective p
      intro x
      obtain ⟨q, hq⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
        (A := Γ((W j).left, ⊤)) (B := T) ((W j).left.isoSpec.hom x)
      refine ⟨q, ?_⟩
      have hq' : (Spec.map (CommRingCat.ofHom (algebraMap Γ((W j).left, ⊤) T))) q =
          (W j).left.isoSpec.hom x := hq
      show (W j).left.isoSpec.inv ((Spec.map (CommRingCat.ofHom (algebraMap Γ((W j).left, ⊤) T))) q) = x
      rw [hq', Scheme.hom_inv_apply]
    · show wcIndEtale (p.appTop.hom.comp (w j).left.appTop.hom)
      have hiso := isoInd (Scheme.ΓSpecIso (CommRingCat.of T)).symm.commRingCatIsoToRingEquiv
      rw [Iso.commRingCatIsoToRingEquiv_toRingHom, Iso.symm_hom] at hiso
      rw [hp, CommRingCat.hom_comp, RingHom.comp_assoc, CommRingCat.hom_ofHom]
      exact wc_indEtale_comp _ _ hind hiso
  choose V v hVaff hvsurj hvind using step
  have hcompInd : ∀ j, wcIndEtale (v j ≫ w j).left.appTop.hom := by
    intro j
    show wcIndEtale ((v j).left ≫ (w j).left).appTop.hom
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact hvind j
  refine ⟨k, V, fun j => v j ≫ w j, ⟨⟨hUaff, g, hg, hγ⟩, fun j => ?_, fun j => hcompInd j, ?_⟩,
    fun j => R.downward_closed (hwR j) (v j)⟩
  · refine ⟨hVaff j, (v j ≫ w j).left ≫ g, ?_, ?_⟩
    · rw [Category.assoc, hg]
      exact MorphismProperty.Over.w _
    · rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
      exact wc_indEtale_comp _ _ hγ (hcompInd j)
  · apply proet_finite_affine_jointly_surjective_covers Y U k V (fun j => v j ≫ w j) hVaff
    intro τ
    obtain ⟨j, σ, hσ⟩ := hsurjW τ
    obtain ⟨ρ, hρ⟩ := hvsurj j σ
    refine ⟨j, ρ, ?_⟩
    show (w j).left ((v j).left ρ) = τ
    rw [hρ, hσ]

theorem wc_indEtale_baseChange : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T], wcIndEtale (algebraMap R S) → wcIndEtale (Algebra.TensorProduct.includeLeftRingHom : T →+* TensorProduct R T S) :=
by
  classical
  intro R S T _ _ _ _ _ hS
  unfold wcIndEtale at hS ⊢
  rw [show (algebraMap R S).toAlgebra = ‹Algebra R S› from
    Algebra.algebra_ext _ _ (fun _ => rfl)] at hS
  rw [show (Algebra.TensorProduct.includeLeftRingHom : T →+* TensorProduct R T S).toAlgebra =
    Algebra.TensorProduct.leftAlgebra from Algebra.algebra_ext _ _ (fun _ => rfl)]
  intro P _ _ _ h

  obtain ⟨n, f, hfs, hfg⟩ := Algebra.FinitePresentation.out (R := T) (A := P)
  obtain ⟨m, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  obtain ⟨x, hx⟩ : ∃ x : Fin n → P, ∀ j, f (MvPolynomial.X j) = x j := ⟨_, fun _ => rfl⟩
  have hg0 : ∀ i, MvPolynomial.aeval x (g i) = 0 := by
    intro i
    have hfx : f = MvPolynomial.aeval x := MvPolynomial.algHom_ext (fun j => by
      rw [MvPolynomial.aeval_X, hx])
    rw [← hfx]
    have hmem : g i ∈ RingHom.ker f.toRingHom := by
      rw [← hg]; exact Submodule.subset_span ⟨i, rfl⟩
    exact RingHom.mem_ker.mp hmem
  have hker : ∀ (A : Type u) [CommRing A] [Algebra T A] (w : Fin n → A),
      (∀ i, MvPolynomial.aeval w (g i) = 0) → ∀ a, f a = 0 → MvPolynomial.aeval w a = 0 := by
    intro A _ _ w hw a ha
    have ha' : a ∈ Submodule.span (MvPolynomial (Fin n) T) (Set.range g) := by
      rw [hg]; exact RingHom.mem_ker.mpr ha
    clear ha
    induction ha' using Submodule.span_induction with
    | mem y hy => obtain ⟨i, rfl⟩ := hy; exact hw i
    | zero => exact map_zero _
    | add y z _ _ hy hz => rw [map_add, hy, hz, add_zero]
    | smul b y _ hy => rw [smul_eq_mul, map_mul, hy, mul_zero]
  have hlift : ∀ (A : Type u) [CommRing A] [Algebra T A] (w : Fin n → A),
      (∀ i, MvPolynomial.aeval w (g i) = 0) → ∃ φ : P →ₐ[T] A, ∀ j, φ (x j) = w j := by
    intro A _ _ w hw
    have hI : ∀ a ∈ RingHom.ker f, MvPolynomial.aeval w a = 0 :=
      fun a ha => hker A w hw a (RingHom.mem_ker.mp ha)
    refine ⟨(Ideal.Quotient.liftₐ _ (MvPolynomial.aeval w) hI).comp
        (Ideal.quotientKerAlgEquivOfSurjective hfs).symm.toAlgHom, fun j => ?_⟩
    have h1 : (Ideal.quotientKerAlgEquivOfSurjective hfs).symm (x j) =
        Ideal.Quotient.mk _ (MvPolynomial.X j) := by
      rw [AlgEquiv.symm_apply_eq, ← hx j]
      rfl
    show (Ideal.Quotient.liftₐ _ (MvPolynomial.aeval w) hI)
      ((Ideal.quotientKerAlgEquivOfSurjective hfs).symm (x j)) = w j
    rw [h1]
    exact MvPolynomial.aeval_X w j
  have huniq : ∀ (A : Type u) [CommRing A] [Algebra T A] (φ ψ : P →ₐ[T] A),
      (∀ j, φ (x j) = ψ (x j)) → φ = ψ := by
    intro A _ _ φ ψ hj
    have hc : φ.comp f = ψ.comp f := MvPolynomial.algHom_ext (fun j => by
      rw [AlgHom.comp_apply, AlgHom.comp_apply, hx]; exact hj j)
    ext p
    obtain ⟨q, rfl⟩ := hfs p
    exact DFunLike.congr_fun hc q

  obtain ⟨ΦT, hΦT⟩ : ∃ ΦT : MvPolynomial S T →ₐ[T] TensorProduct R T S,
      ∀ s, ΦT (MvPolynomial.X s) = (1 : T) ⊗ₜ[R] s :=
    ⟨MvPolynomial.aeval (fun s : S => (1 : T) ⊗ₜ[R] s), fun s => MvPolynomial.aeval_X _ _⟩
  have hΦs : Function.Surjective (MvPolynomial.aeval (R := R) (fun s : S => s)) :=
    fun s => ⟨MvPolynomial.X s, MvPolynomial.aeval_X _ _⟩
  have hME : ∀ y, ΦT y = Algebra.TensorProduct.map (AlgHom.id R T)
      (MvPolynomial.aeval (R := R) (fun s : S => s))
      ((MvPolynomial.algebraTensorAlgEquiv R T (σ := S)).symm y) := by
    have e0 : ΦT = (Algebra.TensorProduct.map (AlgHom.id T T)
        (MvPolynomial.aeval (R := R) (fun s : S => s))).comp
        (MvPolynomial.algebraTensorAlgEquiv R T (σ := S)).symm.toAlgHom := by
      apply MvPolynomial.algHom_ext
      intro s
      rw [hΦT]
      show _ = Algebra.TensorProduct.map (AlgHom.id T T)
        (MvPolynomial.aeval (R := R) (fun s : S => s))
        ((MvPolynomial.algebraTensorAlgEquiv R T (σ := S)).symm (MvPolynomial.X s))
      rw [MvPolynomial.algebraTensorAlgEquiv_symm_X, Algebra.TensorProduct.map_tmul,
        MvPolynomial.aeval_X, AlgHom.id_apply]
    intro y
    rw [e0]
    rfl
  have hMs := Algebra.TensorProduct.map_surjective (AlgHom.id R T)
    (MvPolynomial.aeval (R := R) (fun s : S => s)) (fun t => ⟨t, rfl⟩) hΦs
  have hΦTs : Function.Surjective ΦT := by
    intro z
    obtain ⟨w, hw⟩ := hMs z
    exact ⟨MvPolynomial.algebraTensorAlgEquiv R T w, by rw [hME, AlgEquiv.symm_apply_apply, hw]⟩
  have hker2 : ∀ y, ΦT y = 0 → y ∈ Ideal.map (MvPolynomial.map (algebraMap R T) :
      MvPolynomial S R →+* MvPolynomial S T)
      (RingHom.ker (MvPolynomial.aeval (R := R) (fun s : S => s))) := by
    intro y hy
    have h1 : (MvPolynomial.algebraTensorAlgEquiv R T (σ := S)).symm y ∈
        RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R T)
          (MvPolynomial.aeval (R := R) (fun s : S => s))) := by
      rw [RingHom.mem_ker, ← hME]; exact hy
    rw [Algebra.TensorProduct.lTensor_ker _ hΦs] at h1
    have hle : Ideal.map (Algebra.TensorProduct.includeRight :
        MvPolynomial S R →ₐ[R] TensorProduct R T (MvPolynomial S R))
        (RingHom.ker (MvPolynomial.aeval (R := R) (fun s : S => s))) ≤
        Ideal.comap (MvPolynomial.algebraTensorAlgEquiv R T (σ := S))
          (Ideal.map (MvPolynomial.map (algebraMap R T) :
            MvPolynomial S R →+* MvPolynomial S T)
            (RingHom.ker (MvPolynomial.aeval (R := R) (fun s : S => s)))) := by
      rw [Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap, Ideal.mem_comap, Algebra.TensorProduct.includeRight_apply,
        MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
      exact Ideal.mem_map_of_mem _ hp
    have h4 := hle h1
    rw [Ideal.mem_comap, AlgEquiv.apply_symm_apply] at h4
    exact h4

  obtain ⟨zh, hzh⟩ : ∃ zh : Fin n → MvPolynomial S T, ∀ j, ΦT (zh j) = h (x j) :=
    ⟨fun j => Function.surjInv hΦTs (h (x j)), fun j => Function.surjInv_eq hΦTs _⟩
  have hy0 : ∀ i, ΦT (MvPolynomial.aeval zh (g i)) = 0 := by
    intro i
    rw [MvPolynomial.comp_aeval_apply]
    have e1 : (fun j => ΦT (zh j)) = fun j => h (x j) := funext hzh
    rw [e1, show (MvPolynomial.aeval fun j => h (x j)) (g i) = h (MvPolynomial.aeval x (g i)) from
      (MvPolynomial.comp_aeval_apply x h (g i)).symm, hg0 i, map_zero]
  have hy : ∀ i, MvPolynomial.aeval zh (g i) ∈ Submodule.span (MvPolynomial S T)
      ((MvPolynomial.map (algebraMap R T) : MvPolynomial S R →+* MvPolynomial S T) ''
        (RingHom.ker (MvPolynomial.aeval (R := R) (fun s : S => s)) : Set (MvPolynomial S R))) :=
    fun i => hker2 _ (hy0 i)
  choose F hFsub hFmem using fun i => Submodule.mem_span_finite_of_mem_span (hy i)
  let G : Finset (MvPolynomial S T) := Finset.univ.biUnion F
  have hG : ∀ u ∈ G, ∃ k ∈ RingHom.ker (MvPolynomial.aeval (R := R) (fun s : S => s)),
      MvPolynomial.map (algebraMap R T) k = u := by
    intro u hu
    obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp hu
    exact hFsub i hi
  choose! κ0 hκ0K hκ0 using hG
  have hyc : ∀ i, ∃ c : G → MvPolynomial S T,
      ∑ u, c u * MvPolynomial.map (algebraMap R T) (κ0 u) = MvPolynomial.aeval zh (g i) := by
    intro i
    apply (Ideal.mem_span_range_iff_exists_fun
      (v := fun u : G => MvPolynomial.map (algebraMap R T) (κ0 u))).mp
    refine Submodule.span_mono ?_ (hFmem i)
    intro w hw
    have hwG : w ∈ G := Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hw⟩
    exact ⟨⟨w, hwG⟩, hκ0 w hwG⟩
  choose c hc using hyc

  let Λ : Finset S := (Finset.univ.biUnion fun j => (zh j).vars) ∪
    (Finset.univ.biUnion fun u : G => (κ0 u).vars)
  have hzh'ex : ∀ j, ∃ q : MvPolynomial Λ T, MvPolynomial.rename Subtype.val q = zh j :=
    fun j => MvPolynomial.exists_rename_eq_of_vars_subset_range (zh j) Subtype.val
      Subtype.val_injective (fun s hs => ⟨⟨s, Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hs⟩)⟩, rfl⟩)
  choose zh' hzh' using hzh'ex
  have hκ'ex : ∀ u : G, ∃ q : MvPolynomial Λ R, MvPolynomial.rename Subtype.val q = κ0 u :=
    fun u => MvPolynomial.exists_rename_eq_of_vars_subset_range (κ0 u) Subtype.val
      Subtype.val_injective (fun s hs => ⟨⟨s, Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨u, Finset.mem_univ _, hs⟩)⟩, rfl⟩)
  choose κ' hκ' using hκ'ex

  have hstage : ∀ (Q : Type u) [CommRing Q] [Algebra R Q] (v : Q →ₐ[R] S)
      (θ : MvPolynomial S T →ₐ[T] TensorProduct R T Q) (q : Λ → Q),
      (∀ t : Λ, θ (MvPolynomial.X t.1) = (1 : T) ⊗ₜ[R] q t) →
      (∀ t : Λ, v (q t) = t.1) →
      (∀ u : G, θ (MvPolynomial.map (algebraMap R T) (κ0 u)) = 0) →
      (∀ i, MvPolynomial.aeval (fun j => θ (zh j)) (g i) = 0) ∧
      ∀ j, Algebra.TensorProduct.map (AlgHom.id T T) v (θ (zh j)) = h (x j) := by
    intro Q _ _ v θ q hθ hv hκ
    refine ⟨fun i => ?_, fun j => ?_⟩
    · rw [show MvPolynomial.aeval (fun j => θ (zh j)) (g i) = θ (MvPolynomial.aeval zh (g i)) from
        (MvPolynomial.comp_aeval_apply zh θ (g i)).symm, ← hc i, map_sum]
      exact Finset.sum_eq_zero (fun u _ => by rw [map_mul, hκ u, mul_zero])
    · have hext : ((Algebra.TensorProduct.map (AlgHom.id T T) v).comp θ).comp
          (MvPolynomial.rename (R := T) (Subtype.val : Λ → S)) =
          ΦT.comp (MvPolynomial.rename (R := T) (Subtype.val : Λ → S)) := by
        apply MvPolynomial.algHom_ext
        intro t
        rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.rename_X, hθ t,
          Algebra.TensorProduct.map_tmul, hv, hΦT, AlgHom.id_apply]
      have e2 := DFunLike.congr_fun hext (zh' j)
      rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, hzh' j] at e2
      exact e2.trans (hzh j)

  obtain ⟨P', _, _, hfp, v, z', hz'0, hz'v⟩ : ∃ (P' : Type u) (_ : CommRing P') (_ : Algebra R P'),
      Algebra.FinitePresentation R P' ∧ ∃ (v : P' →ₐ[R] S) (z' : Fin n → TensorProduct R T P'),
      (∀ i, MvPolynomial.aeval z' (g i) = 0) ∧
      ∀ j, Algebra.TensorProduct.map (AlgHom.id T T) v (z' j) = h (x j) := by
    obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial Λ R), I = Ideal.span (Set.range κ') := ⟨_, rfl⟩
    have hκ'I : ∀ u, κ' u ∈ I := fun u => by rw [hI]; exact Ideal.subset_span ⟨u, rfl⟩
    have hvI : ∀ a ∈ I, MvPolynomial.aeval (R := R) (Subtype.val : Λ → S) a = 0 := by
      intro a ha
      rw [hI] at ha
      have hle : Ideal.span (Set.range κ') ≤
          RingHom.ker (MvPolynomial.aeval (R := R) (Subtype.val : Λ → S)) := by
        rw [Ideal.span_le]
        rintro _ ⟨u, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        have e1 := MvPolynomial.aeval_rename (R := R) Subtype.val (fun s : S => s) (κ' u)
        rw [hκ' u] at e1
        exact e1.symm.trans (RingHom.mem_ker.mp (hκ0K u.1 u.2))
      exact RingHom.mem_ker.mp (hle ha)
    obtain ⟨v, hv⟩ : ∃ v : (MvPolynomial Λ R ⧸ I) →ₐ[R] S,
        ∀ p, v (Ideal.Quotient.mk I p) = MvPolynomial.aeval Subtype.val p :=
      ⟨Ideal.Quotient.liftₐ I _ hvI, fun p => rfl⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : S → TensorProduct R T (MvPolynomial Λ R ⧸ I),
        ∀ t : Λ, φ t.1 = (1 : T) ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.X t) :=
      ⟨fun s => if hs : s ∈ Λ then
          (1 : T) ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.X (⟨s, hs⟩ : Λ)) else 0,
        fun t => dif_pos t.2⟩
    let θS : MvPolynomial S T →ₐ[T] TensorProduct R T (MvPolynomial Λ R ⧸ I) :=
      MvPolynomial.aeval φ
    have hθS : ∀ t : Λ, θS (MvPolynomial.X t.1) =
        (1 : T) ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.X t) :=
      fun t => (MvPolynomial.aeval_X _ _).trans (hφ t)
    have hθren : ∀ p : MvPolynomial Λ R,
        θS (MvPolynomial.map (algebraMap R T) (MvPolynomial.rename Subtype.val p)) =
          (1 : T) ⊗ₜ[R] Ideal.Quotient.mk I p := by
      intro p
      show MvPolynomial.aeval φ (MvPolynomial.map (algebraMap R T)
        (MvPolynomial.rename Subtype.val p)) = _
      rw [MvPolynomial.aeval_map_algebraMap, MvPolynomial.aeval_rename]
      have e1 : φ ∘ Subtype.val = fun t : Λ =>
          (1 : T) ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.X t) :=
        funext fun t => hφ t
      rw [e1]
      have key : (MvPolynomial.aeval (fun t : Λ =>
          (1 : T) ⊗ₜ[R] Ideal.Quotient.mk I (MvPolynomial.X t)) :
            MvPolynomial Λ R →ₐ[R] TensorProduct R T (MvPolynomial Λ R ⧸ I)) =
          (Algebra.TensorProduct.includeRight (R := R) (A := T)).comp (Ideal.Quotient.mkₐ R I) :=
        MvPolynomial.algHom_ext (fun t => by
          rw [MvPolynomial.aeval_X, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
            Algebra.TensorProduct.includeRight_apply])
      rw [key, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
        Algebra.TensorProduct.includeRight_apply]
    clear_value θS
    have hθκ : ∀ u : G, θS (MvPolynomial.map (algebraMap R T) (κ0 u)) = 0 := by
      intro u
      rw [← hκ' u, hθren, Ideal.Quotient.eq_zero_iff_mem.mpr (hκ'I u), TensorProduct.tmul_zero]
    have hfpQ : Algebra.FinitePresentation R (MvPolynomial Λ R ⧸ I) := by
      haveI : Algebra.FinitePresentation R (MvPolynomial Λ R) :=
        Algebra.FinitePresentation.mvPolynomial R R Λ
      exact Algebra.FinitePresentation.quotient (I := I)
        (by rw [hI]; exact Submodule.fg_span (Set.finite_range κ'))
    obtain ⟨hA, hB⟩ := hstage (MvPolynomial Λ R ⧸ I) v θS
      (fun t => Ideal.Quotient.mk I (MvPolynomial.X t)) hθS
      (fun t => (hv _).trans (MvPolynomial.aeval_X _ _)) hθκ
    exact ⟨MvPolynomial Λ R ⧸ I, inferInstance, inferInstance, hfpQ, v, fun j => θS (zh j), hA, hB⟩

  obtain ⟨h', hh'⟩ := hlift (TensorProduct R T P') z' hz'0
  obtain ⟨E, _, _, hE, α, β, hβα⟩ := hS P' v
  have hcomp : (Algebra.TensorProduct.map (AlgHom.id T T) β).comp
      (Algebra.TensorProduct.map (AlgHom.id T T) α) = Algebra.TensorProduct.map (AlgHom.id T T) v := by
    rw [← Algebra.TensorProduct.map_comp, AlgHom.comp_id, hβα]
  refine ⟨TensorProduct R T E, inferInstance, inferInstance, Algebra.Etale.baseChange R E T,
    (Algebra.TensorProduct.map (AlgHom.id T T) α).comp h', Algebra.TensorProduct.map (AlgHom.id T T) β, ?_⟩
  apply huniq
  intro j
  simp only [AlgHom.comp_apply]
  rw [hh' j, ← hz'v j, ← hcomp, AlgHom.comp_apply]

theorem wc_affCov_widePullback_mem : ∀ (Y : Scheme.{u}) (A : Y.Opens) (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), wcAffCov Y A U k V f → ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), wcAffIndEt Y A (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))) :=
by
  intro Y A U k V f hc p σ
  obtain ⟨⟨hUaff, gU, hgU, hγU⟩, hV, hf, -⟩ := hc

  have isoInd : ∀ {R' S' : Type u} [CommRing R'] [CommRing S'] (e : R' ≃+* S'),
      wcIndEtale (e : R' →+* S') := by
    intro R' S' _ _ e
    unfold wcIndEtale
    letI := (e : R' →+* S').toAlgebra
    intro P _ _ _ h
    refine ⟨R', inferInstance, inferInstance, inferInstance, ?_⟩
    let ε : S' ≃ₐ[R'] R' := AlgEquiv.ofRingEquiv (f := e.symm) (fun r => e.symm_apply_apply r)
    refine ⟨ε.toAlgHom.comp h, Algebra.ofId R' S', ?_⟩
    ext p
    exact e.apply_symm_apply (h p)

  have isoAppTop : ∀ {X Z : Scheme.{u}} (e : X ≅ Z), wcIndEtale e.hom.appTop.hom := by
    intro X Z e
    have h := isoInd (Scheme.Γ.mapIso e.op).commRingCatIsoToRingEquiv
    rw [Iso.commRingCatIsoToRingEquiv_toRingHom, Functor.mapIso_hom, Iso.op_hom,
      Scheme.Γ_map_op] at h
    exact h

  have sq : ∀ (n : ℕ) (X : Fin (n + 1) → Y.ProEt) (g : ∀ i, X i ⟶ U),
      IsPullback (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback U X g ⟶ Limits.widePullback U (fun i : Fin n => X i.castSucc)
            (fun i => g i.castSucc))
        (Limits.WidePullback.π g (Fin.last n))
        (Limits.WidePullback.base (fun i : Fin n => g i.castSucc)) (g (Fin.last n)) := by
    intro n X g
    have w : (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback U X g ⟶ Limits.widePullback U (fun i : Fin n => X i.castSucc)
            (fun i => g i.castSucc)) ≫
        Limits.WidePullback.base (fun i : Fin n => g i.castSucc) =
        Limits.WidePullback.π g (Fin.last n) ≫ g (Fin.last n) := by
      rw [Limits.WidePullback.lift_base, Limits.WidePullback.π_arrow]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ w) ?_
    refine Limits.PullbackCone.IsLimit.mk w
      (fun s => Limits.WidePullback.lift (s.fst ≫ Limits.WidePullback.base _)
        (Fin.lastCases (motive := fun j => s.pt ⟶ X j) s.snd
          (fun i => s.fst ≫ Limits.WidePullback.π (fun i : Fin n => g i.castSucc) i))
        (fun j => by
          induction j using Fin.lastCases with
          | last => rw [Fin.lastCases_last]; exact s.condition.symm
          | cast i =>
            rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow]))
      (fun s => ?_) (fun s => ?_) (fun s m h1 h2 => ?_)
    · apply Limits.WidePullback.hom_ext
      · intro j
        rw [Category.assoc, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π,
          Fin.lastCases_castSucc]
      · rw [Category.assoc, Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
    · rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
    · apply Limits.WidePullback.hom_ext
      · intro j
        induction j using Fin.lastCases with
        | last => rw [Limits.WidePullback.lift_π, Fin.lastCases_last]; exact h2
        | cast i =>
          rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← h1, Category.assoc,
            Limits.WidePullback.lift_π]
      · rw [Limits.WidePullback.lift_base, ← h1, Category.assoc, Limits.WidePullback.lift_base]

  have s3 : ∀ {P X Y' Z : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y'} {a : X ⟶ Z} {b : Y' ⟶ Z},
      IsPullback fst snd a b → IsAffine X → IsAffine Y' → IsAffine Z →
      IsAffine P ∧ (wcIndEtale b.appTop.hom → wcIndEtale fst.appTop.hom) := by
    intro P X Y' Z fst snd a b h hX hY hZ
    letI : Algebra Γ(Z, ⊤) Γ(X, ⊤) := a.appTop.hom.toAlgebra
    letI : Algebra Γ(Z, ⊤) Γ(Y', ⊤) := b.appTop.hom.toAlgebra
    let inl : Γ(X, ⊤) ⟶ CommRingCat.of (TensorProduct Γ(Z, ⊤) Γ(X, ⊤) Γ(Y', ⊤)) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr : Γ(Y', ⊤) ⟶ CommRingCat.of (TensorProduct Γ(Z, ⊤) Γ(X, ⊤) Γ(Y', ⊤)) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    have hpo : IsPushout a.appTop b.appTop inl inr :=
      CommRingCat.isPushout_tensorProduct Γ(Z, ⊤) Γ(X, ⊤) Γ(Y', ⊤)
    have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    have h3 : IsPullback (Spec.map inl ≫ X.isoSpec.inv) (Spec.map inr ≫ Y'.isoSpec.inv) a b :=
      IsPullback.of_iso hpb (Iso.refl _) X.isoSpec.symm Y'.isoSpec.symm Z.isoSpec.symm
        (Category.id_comp _).symm (Category.id_comp _).symm
        (Scheme.isoSpec_inv_naturality a) (Scheme.isoSpec_inv_naturality b)
    let e := IsPullback.isoIsPullback X Y' h h3
    have he : e.hom ≫ Spec.map inl ≫ X.isoSpec.inv = fst := IsPullback.isoIsPullback_hom_fst X Y' h h3
    have hPaff : IsAffine P := IsAffine.of_isIso e.hom
    refine ⟨hPaff, fun hb => ?_⟩
    have hinv : X.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(X, ⊤)).inv := by
      rw [← Iso.comp_hom_eq_id, ← Scheme.toSpecΓ_appTop, ← Scheme.isoSpec_hom,
        ← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
    have hfst : fst.appTop = inl ≫ (Scheme.ΓSpecIso
        (CommRingCat.of (TensorProduct Γ(Z, ⊤) Γ(X, ⊤) Γ(Y', ⊤)))).inv ≫ e.hom.appTop := by
      rw [← he, Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, hinv,
        ← Scheme.ΓSpecIso_inv_naturality inl, Category.assoc]
    have hinc : wcIndEtale (Algebra.TensorProduct.includeLeftRingHom :
        Γ(X, ⊤) →+* TensorProduct Γ(Z, ⊤) Γ(X, ⊤) Γ(Y', ⊤)) :=
      wc_indEtale_baseChange _ _ _ hb
    have hΓ := isoInd (Scheme.ΓSpecIso
      (CommRingCat.of (TensorProduct Γ(Z, ⊤) Γ(X, ⊤) Γ(Y', ⊤)))).symm.commRingCatIsoToRingEquiv
    rw [Iso.commRingCatIsoToRingEquiv_toRingHom, Iso.symm_hom] at hΓ
    rw [hfst, CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
      RingHom.comp_assoc]
    exact wc_indEtale_comp _ _ (wc_indEtale_comp _ _ hinc hΓ) (isoAppTop e)

  have main : ∀ (n : ℕ) (τ : Fin n → Fin k),
      wcAffIndEt Y A (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))) := by
    intro n
    induction n with
    | zero =>
      intro τ
      let e0 : Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)) ≅ U :=
        { hom := Limits.WidePullback.base _
          inv := Limits.WidePullback.lift (𝟙 U) (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
          hom_inv_id := by
            apply Limits.WidePullback.hom_ext
            · intro j; exact Fin.elim0 j
            · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id,
                Category.id_comp]
          inv_hom_id := Limits.WidePullback.lift_base _ _ _ _ }
      let E := (Scheme.ProEt.forget Y ⋙ Over.forget Y).mapIso e0
      have hWaff : IsAffine (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))).left :=
        @IsAffine.of_isIso _ _ E.hom (Iso.isIso_hom E) hUaff
      refine ⟨hWaff, (Limits.WidePullback.base (fun l => f (τ l))).left ≫ gU, ?_, ?_⟩
      · rw [Category.assoc, hgU]
        exact MorphismProperty.Over.w _
      · rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
        exact wc_indEtale_comp _ _ hγU (isoAppTop E)
    | succ n ih =>
      intro τ
      obtain ⟨hWaff, g', hg', hγ'⟩ := ih (fun i => τ i.castSucc)
      have hsq := (sq n (fun l => V (τ l)) (fun l => f (τ l))).map
        (Scheme.ProEt.forget Y ⋙ Over.forget Y)
      obtain ⟨haff, hind⟩ := s3 hsq hWaff (hV (τ (Fin.last n))).1 hUaff
      refine ⟨haff, (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
        (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
        (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left ≫ g', ?_, ?_⟩
      · rw [Category.assoc, hg']
        exact MorphismProperty.Over.w _
      · rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
        exact wc_indEtale_comp _ _ hγ' (hind (hf _))
  exact main (p + 1) σ

theorem wc_lan_cechH0_of_model : ∀ (Y : Scheme.{u}) (F : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U) (M : wcEtModel Y V f), wcLanLevel Y F M → (∀ (U' : Y.Etale) (k' : ℕ) (V' : Fin k' → Y.Etale) (f' : ∀ i, V' i ⟶ U'), wcCechH0 F V' f') → wcCechH0 ((wcEtToProEt Y).op.lan.obj F) V f :=
by
  intro Y F U k V f M hL hEt x hx
  obtain ⟨hL1, hL2, -, hL4⟩ := hL

  have hN : ∀ {T : Y.ProEt} {E₁ E₂ : Y.Etale} (a : T ⟶ (wcEtToProEt Y).obj E₁) (e : E₁ ⟶ E₂)
      (t : F.obj (Opposite.op E₂)),
      ((wcEtToProEt Y).op.lan.obj F).map (a ≫ (wcEtToProEt Y).map e).op
        (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₂) t) =
      ((wcEtToProEt Y).op.lan.obj F).map a.op
        (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₁) (F.map e.op t)) := by
    intro T E₁ E₂ a e t
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
    congr 1
    exact (NatTrans.naturality_apply ((wcEtToProEt Y).op.lanUnit.app F) e.op t).symm
  have hPc : ∀ {A B C : Y.ProEt} (p : A ⟶ B) (q : B ⟶ C)
      (z : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op C)),
      ((wcEtToProEt Y).op.lan.obj F).map p.op (((wcEtToProEt Y).op.lan.obj F).map q.op z) =
      ((wcEtToProEt Y).op.lan.obj F).map (p ≫ q).op z := by
    intro A B C p q z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have hFc : ∀ {A B C : Y.Etale} (p : A ⟶ B) (q : B ⟶ C) (z : F.obj (Opposite.op C)),
      F.map p.op (F.map q.op z) = F.map (p ≫ q).op z := by
    intro A B C p q z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  choose l1 t1 ht1 using fun i => hL2 i (x i)
  obtain ⟨K⟩ := IsCofiltered.cone_nonempty (Discrete.functor l1)
  let l₀ : M.Λ := K.pt
  let g₀ : ∀ i, l₀ ⟶ l1 i := fun i => K.π.app ⟨i⟩
  let t : ∀ i, F.obj (Opposite.op ((M.V' i).obj l₀)) :=
    fun i => F.map ((M.V' i).map (g₀ i)).op (t1 i)
  have hxt : ∀ i, x i = ((wcEtToProEt Y).op.lan.obj F).map (M.ψ i l₀).op
      (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op ((M.V' i).obj l₀)) (t i)) := by
    intro i
    rw [ht1 i, ← M.hψ i (g₀ i), hN]
  clear_value t

  have hkill : ∀ σ : Fin 2 → Fin k, ∃ (l₂ : M.Λ) (h : l₂ ⟶ l₀), ∀ (l' : M.Λ) (c : l' ⟶ l₂),
      F.map (Limits.WidePullback.π (fun l => (M.f' (σ l)).app l') 0).op
        (F.map ((M.V' (σ 0)).map (c ≫ h)).op (t (σ 0))) =
      F.map (Limits.WidePullback.π (fun l => (M.f' (σ l)).app l') 1).op
        (F.map ((M.V' (σ 1)).map (c ≫ h)).op (t (σ 1))) := by
    intro σ
    obtain ⟨m, hm, -⟩ := hL1 1 σ l₀
    have hm' : ∀ j : Fin 2, m ≫ (wcEtToProEt Y).map
        (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₀) j) =
        Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l₀ := hm
    obtain ⟨d, hd_def⟩ : ∃ d : F.obj (Opposite.op (Limits.widePullback (M.U'.obj l₀)
        (fun j => (M.V' (σ j)).obj l₀) (fun j => (M.f' (σ j)).app l₀))),
        d = F.map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₀) 0).op (t (σ 0)) -
          F.map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₀) 1).op (t (σ 1)) :=
      ⟨_, rfl⟩
    have e : ∀ a : Fin 2, ((wcEtToProEt Y).op.lan.obj F).map m.op
        (((wcEtToProEt Y).op.lanUnit.app F).app _
          (F.map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₀) a).op (t (σ a)))) =
        ((wcEtToProEt Y).op.lan.obj F).map (Limits.WidePullback.π (fun l => f (σ l)) a).op
          (x (σ a)) := by
      intro a
      rw [← hN, hm' a, ← hPc, ← hxt]
    have hd : ((wcEtToProEt Y).op.lan.obj F).map m.op
        (((wcEtToProEt Y).op.lanUnit.app F).app _ d) = 0 := by
      rw [hd_def, map_sub, map_sub, e 0, e 1, sub_eq_zero]
      exact hx σ
    obtain ⟨l₂, h, hw⟩ := hL4 1 σ l₀ d m hm hd
    have hwc : ∀ {a b : M.Λ} (c : a ⟶ b), ∃ w : Limits.widePullback (M.U'.obj a)
        (fun j => (M.V' (σ j)).obj a) (fun j => (M.f' (σ j)).app a) ⟶
        Limits.widePullback (M.U'.obj b) (fun j => (M.V' (σ j)).obj b)
          (fun j => (M.f' (σ j)).app b),
        ∀ j, w ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app b) j =
          Limits.WidePullback.π (fun j => (M.f' (σ j)).app a) j ≫ (M.V' (σ j)).map c := by
      intro a b c
      refine ⟨Limits.WidePullback.lift (Limits.WidePullback.base _ ≫ M.U'.map c)
        (fun j => Limits.WidePullback.π _ j ≫ (M.V' (σ j)).map c) ?_,
        fun j => Limits.WidePullback.lift_π _ _ _ _ j⟩
      intro j
      rw [Category.assoc, (M.f' (σ j)).naturality c, ← Category.assoc,
        Limits.WidePullback.π_arrow]
    refine ⟨l₂, h, fun l' c => ?_⟩
    obtain ⟨wc, hwc'⟩ := hwc c
    obtain ⟨wh, hwh⟩ := hwc h
    have hdh : F.map wh.op d = 0 := hw wh hwh
    have e2 : ∀ a : Fin 2,
        F.map (Limits.WidePullback.π (fun l => (M.f' (σ l)).app l') a).op
          (F.map ((M.V' (σ a)).map (c ≫ h)).op (t (σ a))) =
        F.map (wc ≫ wh).op
          (F.map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₀) a).op (t (σ a))) := by
      intro a
      have hmor : Limits.WidePullback.π (fun l => (M.f' (σ l)).app l') a ≫
          (M.V' (σ a)).map (c ≫ h) =
          (wc ≫ wh) ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₀) a := by
        rw [Category.assoc, hwh a, ← Category.assoc, hwc' a, Category.assoc, Functor.map_comp]
      rw [hFc, hFc, hmor]
    rw [e2 0, e2 1, ← sub_eq_zero, ← map_sub, ← hd_def, ← hFc, hdh, map_zero]

  choose l₂ h₂ hk using hkill
  classical
  obtain ⟨K2⟩ := IsCofiltered.cone_nonempty (Limits.WidePullbackShape.wideCospan l₀ l₂ h₂)
  let ls : M.Λ := K2.pt
  let g : ls ⟶ l₀ := K2.π.app none
  let c : ∀ σ, ls ⟶ l₂ σ := fun σ => K2.π.app (some σ)
  have hc : ∀ σ, c σ ≫ h₂ σ = g := fun σ => K2.w (Limits.WidePullbackShape.Hom.term σ)

  let tS : ∀ i, F.obj (Opposite.op ((M.V' i).obj ls)) := fun i => F.map ((M.V' i).map g).op (t i)
  obtain ⟨sS, hsS⟩ := hEt (M.U'.obj ls) k (fun i => (M.V' i).obj ls) (fun i => (M.f' i).app ls) tS
    (by
      intro σ
      have := hk σ ls (c σ)
      rw [hc σ] at this
      exact this)
  have hsS' : ∀ i, F.map ((M.f' i).app ls).op sS = tS i := hsS
  refine ⟨((wcEtToProEt Y).op.lan.obj F).map (M.φ ls).op
    (((wcEtToProEt Y).op.lanUnit.app F).app _ sS), fun i => ?_⟩
  rw [hPc, ← M.hf i ls, hN, hsS' i]
  show ((wcEtToProEt Y).op.lan.obj F).map (M.ψ i ls).op
      (((wcEtToProEt Y).op.lanUnit.app F).app _ (F.map ((M.V' i).map g).op (t i))) = x i
  rw [← hN, M.hψ i g, hxt i]

theorem wc_lan_cechAcyclic_of_model : ∀ (Y : Scheme.{u}) (F : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U) (M : wcEtModel Y V f), wcLanLevel Y F M → (∀ (U' : Y.Etale) (k' : ℕ) (V' : Fin k' → Y.Etale) (f' : ∀ i, V' i ⟶ U'), wcCechAcyclic F V' f') → wcCechAcyclic ((wcEtToProEt Y).op.lan.obj F) V f :=
by
  intro Y F U k V f M hL hE
  obtain ⟨hL1, -, hL3, hL4⟩ := hL
  haveI : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
      (Scheme.ProEt.forget Y)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance

  have hN : ∀ {T : Y.ProEt} {E₁ E₂ : Y.Etale} (a : T ⟶ (wcEtToProEt Y).obj E₁) (e : E₁ ⟶ E₂)
      (t : F.obj (Opposite.op E₂)),
      ((wcEtToProEt Y).op.lan.obj F).map (a ≫ (wcEtToProEt Y).map e).op
        (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₂) t) =
      ((wcEtToProEt Y).op.lan.obj F).map a.op
        (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₁) (F.map e.op t)) := by
    intro T E₁ E₂ a e t
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
    congr 1
    exact (NatTrans.naturality_apply ((wcEtToProEt Y).op.lanUnit.app F) e.op t).symm
  have hPc : ∀ {A B C : Y.ProEt} (p : A ⟶ B) (q : B ⟶ C)
      (z : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op C)),
      ((wcEtToProEt Y).op.lan.obj F).map p.op (((wcEtToProEt Y).op.lan.obj F).map q.op z) =
      ((wcEtToProEt Y).op.lan.obj F).map (p ≫ q).op z := by
    intro A B C p q z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have hFc : ∀ {A B C : Y.Etale} (p : A ⟶ B) (q : B ⟶ C) (z : F.obj (Opposite.op C)),
      F.map p.op (F.map q.op z) = F.map (p ≫ q).op z := by
    intro A B C p q z
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  have s2u : ∀ (q : ℕ) (U' : Y.Etale) (V' : Fin (q + 1) → Y.Etale) (f' : ∀ j, V' j ⟶ U')
      (T : Y.ProEt) (a b : T ⟶ (wcEtToProEt Y).obj (Limits.widePullback U' V' f')),
      (∀ j, a ≫ (wcEtToProEt Y).map (Limits.WidePullback.π f' j) =
        b ≫ (wcEtToProEt Y).map (Limits.WidePullback.π f' j)) → a = b := by
    intro q U' V' f' T a b hab
    let K := Limits.WidePullbackShape.wideCospan U' V' f'
    have hLim : Limits.IsLimit ((wcEtToProEt Y).mapCone (Limits.limit.cone K)) :=
      Limits.isLimitOfPreserves (wcEtToProEt Y) (Limits.limit.isLimit K)
    apply hLim.hom_ext
    intro J
    rcases J with _ | j
    · change a ≫ (wcEtToProEt Y).map (Limits.WidePullback.base f') =
        b ≫ (wcEtToProEt Y).map (Limits.WidePullback.base f')
      rw [← Limits.WidePullback.π_arrow f' 0, Functor.map_comp, ← Category.assoc,
        ← Category.assoc, hab 0]
    · exact hab j

  have hext : ∀ (q : ℕ) (σ : Fin (q + 1) → Fin k) (l : M.Λ) {Z : Y.Etale}
      (a b : Z ⟶ Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l)
        (fun j => (M.f' (σ j)).app l)),
      (∀ j, a ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j =
        b ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j) → a = b := by
    intro q σ l Z a b hab
    apply Limits.WidePullback.hom_ext
    · exact hab
    · rw [← Limits.WidePullback.π_arrow (fun j => (M.f' (σ j)).app l) 0, ← Category.assoc,
        ← Category.assoc, hab 0]

  have hwc : ∀ (q : ℕ) (σ : Fin (q + 1) → Fin k) {a b : M.Λ} (c : a ⟶ b),
      ∃ w : Limits.widePullback (M.U'.obj a) (fun j => (M.V' (σ j)).obj a)
          (fun j => (M.f' (σ j)).app a) ⟶
        Limits.widePullback (M.U'.obj b) (fun j => (M.V' (σ j)).obj b)
          (fun j => (M.f' (σ j)).app b),
        ∀ j, w ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app b) j =
          Limits.WidePullback.π (fun j => (M.f' (σ j)).app a) j ≫ (M.V' (σ j)).map c := by
    intro q σ a b c
    refine ⟨Limits.WidePullback.lift (Limits.WidePullback.base _ ≫ M.U'.map c)
      (fun j => Limits.WidePullback.π _ j ≫ (M.V' (σ j)).map c) ?_,
      fun j => Limits.WidePullback.lift_π _ _ _ _ j⟩
    intro j
    rw [Category.assoc, (M.f' (σ j)).naturality c, ← Category.assoc,
      Limits.WidePullback.π_arrow]

  have hT : ∀ (q : ℕ) (σ : Fin (q + 1) → Fin k) {l₁ l₂ : M.Λ} (g : l₂ ⟶ l₁)
      (w : Limits.widePullback (M.U'.obj l₂) (fun j => (M.V' (σ j)).obj l₂)
          (fun j => (M.f' (σ j)).app l₂) ⟶
        Limits.widePullback (M.U'.obj l₁) (fun j => (M.V' (σ j)).obj l₁)
          (fun j => (M.f' (σ j)).app l₁)),
      (∀ j, w ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₁) j =
        Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₂) j ≫ (M.V' (σ j)).map g) →
      ∀ m₂ : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l₂) (fun j => (M.V' (σ j)).obj l₂)
            (fun j => (M.f' (σ j)).app l₂)),
        (∀ j, m₂ ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₂) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l₂) →
        ∀ j, (m₂ ≫ (wcEtToProEt Y).map w) ≫
            (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₁) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l₁ := by
    intro q σ l₁ l₂ g w hw m₂ hm₂ j
    rw [Category.assoc, ← Functor.map_comp, hw j, Functor.map_comp, ← Category.assoc, hm₂ j,
      Category.assoc, M.hψ (σ j) g]

  have efE : ∀ (l : M.Λ) {q : ℕ} (ρ : Fin (q + 2) → Fin k) (j : Fin (q + 2)) (a : Fin (q + 1)),
      wcCechFace (fun i => (M.V' i).obj l) (fun i => (M.f' i).app l) ρ j ≫
        Limits.WidePullback.π (fun a => (M.f' (ρ (j.succAbove a))).app l) a =
      Limits.WidePullback.π (fun a => (M.f' (ρ a)).app l) (j.succAbove a) := by
    intro l q ρ j a
    simp only [wcCechFace, Limits.WidePullback.lift_π]
  have efP : ∀ {q : ℕ} (ρ : Fin (q + 2) → Fin k) (j : Fin (q + 2)) (a : Fin (q + 1)),
      wcCechFace V f ρ j ≫ Limits.WidePullback.π (fun a => f (ρ (j.succAbove a))) a =
      Limits.WidePullback.π (fun a => f (ρ a)) (j.succAbove a) := by
    intro q ρ j a
    simp only [wcCechFace, Limits.WidePullback.lift_π]

  have hF : ∀ (q : ℕ) (ρ : Fin (q + 2) → Fin k) (j : Fin (q + 2)) (l : M.Λ)
      (m : Limits.widePullback U (fun a => V (ρ a)) (fun a => f (ρ a)) ⟶
        (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l) (fun a => (M.V' (ρ a)).obj l)
          (fun a => (M.f' (ρ a)).app l)))
      (m' : Limits.widePullback U (fun a => V (ρ (j.succAbove a)))
          (fun a => f (ρ (j.succAbove a))) ⟶
        (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l)
          (fun a => (M.V' (ρ (j.succAbove a))).obj l)
          (fun a => (M.f' (ρ (j.succAbove a))).app l))),
      (∀ a, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun a => (M.f' (ρ a)).app l) a) =
        Limits.WidePullback.π (fun a => f (ρ a)) a ≫ M.ψ (ρ a) l) →
      (∀ a, m' ≫ (wcEtToProEt Y).map
          (Limits.WidePullback.π (fun a => (M.f' (ρ (j.succAbove a))).app l) a) =
        Limits.WidePullback.π (fun a => f (ρ (j.succAbove a))) a ≫
          M.ψ (ρ (j.succAbove a)) l) →
      m ≫ (wcEtToProEt Y).map
          (wcCechFace (fun i => (M.V' i).obj l) (fun i => (M.f' i).app l) ρ j) =
        wcCechFace V f ρ j ≫ m' := by
    intro q ρ j l m m' hm hm'
    apply s2u q (M.U'.obj l) (fun a => (M.V' (ρ (j.succAbove a))).obj l)
      (fun a => (M.f' (ρ (j.succAbove a))).app l)
    intro a
    rw [Category.assoc, ← Functor.map_comp, efE l ρ j a, hm (j.succAbove a), Category.assoc,
      hm' a, ← Category.assoc, efP ρ j a]
  unfold wcCechAcyclic
  intro p c hc

  choose l1 t1 ht1 using fun τ : Fin (p + 2) → Fin k => hL3 (p + 1) τ (c τ)
  obtain ⟨K⟩ := IsCofiltered.cone_nonempty (Discrete.functor l1)
  let l₀ : M.Λ := K.pt
  let g₀ : ∀ τ, l₀ ⟶ l1 τ := fun τ => K.π.app ⟨τ⟩
  choose w0 hw0 using fun τ : Fin (p + 2) → Fin k => hwc (p + 1) τ (g₀ τ)
  obtain ⟨t0, ht0def⟩ : ∃ t0 : ∀ τ : Fin (p + 2) → Fin k, F.obj (Opposite.op
      (Limits.widePullback (M.U'.obj l₀) (fun a => (M.V' (τ a)).obj l₀)
        (fun a => (M.f' (τ a)).app l₀))),
      ∀ τ, t0 τ = F.map (w0 τ).op (t1 τ) := ⟨_, fun _ => rfl⟩
  have ht0 : ∀ (τ : Fin (p + 2) → Fin k)
      (m : Limits.widePullback U (fun a => V (τ a)) (fun a => f (τ a)) ⟶
        (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l₀) (fun a => (M.V' (τ a)).obj l₀)
          (fun a => (M.f' (τ a)).app l₀))),
      (∀ a, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun a => (M.f' (τ a)).app l₀) a) =
        Limits.WidePullback.π (fun a => f (τ a)) a ≫ M.ψ (τ a) l₀) →
      c τ = ((wcEtToProEt Y).op.lan.obj F).map m.op
        (((wcEtToProEt Y).op.lanUnit.app F).app _ (t0 τ)) := by
    intro τ m hm
    rw [ht1 τ (m ≫ (wcEtToProEt Y).map (w0 τ)) (hT (p + 1) τ (g₀ τ) (w0 τ) (hw0 τ) m hm), hN,
      ht0def τ]

  obtain ⟨e, he⟩ : ∃ e : ∀ ρ : Fin (p + 3) → Fin k, F.obj (Opposite.op
      (Limits.widePullback (M.U'.obj l₀) (fun a => (M.V' (ρ a)).obj l₀)
        (fun a => (M.f' (ρ a)).app l₀))),
      ∀ ρ, e ρ = ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        F.map (wcCechFace (fun i => (M.V' i).obj l₀) (fun i => (M.f' i).app l₀) ρ j).op
          (t0 (fun a => ρ (j.succAbove a))) := ⟨_, fun _ => rfl⟩

  have h3 : ∀ (ρ : Fin (p + 3) → Fin k)
      (m : Limits.widePullback U (fun a => V (ρ a)) (fun a => f (ρ a)) ⟶
        (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l₀) (fun a => (M.V' (ρ a)).obj l₀)
          (fun a => (M.f' (ρ a)).app l₀))),
      (∀ a, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun a => (M.f' (ρ a)).app l₀) a) =
        Limits.WidePullback.π (fun a => f (ρ a)) a ≫ M.ψ (ρ a) l₀) →
      ((wcEtToProEt Y).op.lan.obj F).map m.op
        (((wcEtToProEt Y).op.lanUnit.app F).app _ (e ρ)) = 0 := by
    intro ρ m hm
    refine Eq.trans ?_ (hc ρ)
    rw [he ρ]
    simp only [map_sum, map_zsmul]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    obtain ⟨m', hm', -⟩ := hL1 (p + 1) (fun a => ρ (j.succAbove a)) l₀
    rw [← hN, hF (p + 1) ρ j l₀ m m' hm hm', ← hPc, ← ht0 _ m' hm']

  have h4 : ∀ ρ : Fin (p + 3) → Fin k, ∃ (l₂ : M.Λ) (h : l₂ ⟶ l₀),
      ∀ w : Limits.widePullback (M.U'.obj l₂) (fun a => (M.V' (ρ a)).obj l₂)
          (fun a => (M.f' (ρ a)).app l₂) ⟶
        Limits.widePullback (M.U'.obj l₀) (fun a => (M.V' (ρ a)).obj l₀)
          (fun a => (M.f' (ρ a)).app l₀),
        (∀ a, w ≫ Limits.WidePullback.π (fun a => (M.f' (ρ a)).app l₀) a =
          Limits.WidePullback.π (fun a => (M.f' (ρ a)).app l₂) a ≫ (M.V' (ρ a)).map h) →
        F.map w.op (e ρ) = 0 := by
    intro ρ
    obtain ⟨m, hm, -⟩ := hL1 (p + 2) ρ l₀
    exact hL4 (p + 2) ρ l₀ (e ρ) m hm (h3 ρ m hm)
  choose l₂ h₂ hk using h4
  classical
  obtain ⟨K2⟩ := IsCofiltered.cone_nonempty (Limits.WidePullbackShape.wideCospan l₀ l₂ h₂)
  let ls : M.Λ := K2.pt
  let g : ls ⟶ l₀ := K2.π.app none
  let cc : ∀ ρ, ls ⟶ l₂ ρ := fun ρ => K2.π.app (some ρ)
  have hcc : ∀ ρ, cc ρ ≫ h₂ ρ = g := fun ρ => K2.w (Limits.WidePullbackShape.Hom.term ρ)
  have hkill : ∀ (ρ : Fin (p + 3) → Fin k)
      (w : Limits.widePullback (M.U'.obj ls) (fun a => (M.V' (ρ a)).obj ls)
          (fun a => (M.f' (ρ a)).app ls) ⟶
        Limits.widePullback (M.U'.obj l₀) (fun a => (M.V' (ρ a)).obj l₀)
          (fun a => (M.f' (ρ a)).app l₀)),
      (∀ a, w ≫ Limits.WidePullback.π (fun a => (M.f' (ρ a)).app l₀) a =
        Limits.WidePullback.π (fun a => (M.f' (ρ a)).app ls) a ≫ (M.V' (ρ a)).map g) →
      F.map w.op (e ρ) = 0 := by
    intro ρ w hw
    obtain ⟨w₁, hw₁⟩ := hwc (p + 2) ρ (cc ρ)
    obtain ⟨w₂, hw₂⟩ := hwc (p + 2) ρ (h₂ ρ)
    have hww : w = w₁ ≫ w₂ := by
      apply hext (p + 2) ρ l₀
      intro a
      rw [hw a, Category.assoc, hw₂ a, ← Category.assoc, hw₁ a, Category.assoc,
        ← Functor.map_comp, hcc ρ]
    rw [hww, ← hFc, hk ρ w₂ hw₂, map_zero]

  choose wT hwT using fun τ : Fin (p + 2) → Fin k => hwc (p + 1) τ g
  obtain ⟨tS, htS⟩ : ∃ tS : ∀ τ : Fin (p + 2) → Fin k, F.obj (Opposite.op
      (Limits.widePullback (M.U'.obj ls) (fun a => (M.V' (τ a)).obj ls)
        (fun a => (M.f' (τ a)).app ls))),
      ∀ τ, tS τ = F.map (wT τ).op (t0 τ) := ⟨_, fun _ => rfl⟩

  have h6 : ∀ ρ : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
      F.map (wcCechFace (fun i => (M.V' i).obj ls) (fun i => (M.f' i).app ls) ρ j).op
        (tS (fun a => ρ (j.succAbove a))) = 0 := by
    intro ρ
    obtain ⟨wρ, hwρ⟩ := hwc (p + 2) ρ g
    have hkey : ∀ j : Fin (p + 3),
        wcCechFace (fun i => (M.V' i).obj ls) (fun i => (M.f' i).app ls) ρ j ≫
          wT (fun a => ρ (j.succAbove a)) =
        wρ ≫ wcCechFace (fun i => (M.V' i).obj l₀) (fun i => (M.f' i).app l₀) ρ j := by
      intro j
      apply hext (p + 1) (fun a => ρ (j.succAbove a)) l₀
      intro a
      rw [Category.assoc, hwT _ a, ← Category.assoc, efE ls ρ j a, Category.assoc,
        efE l₀ ρ j a, hwρ]
    refine Eq.trans ?_ (hkill ρ wρ hwρ)
    rw [he ρ]
    simp only [map_sum, map_zsmul]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [htS, hFc, hFc, hkey j]

  obtain ⟨β, hβ⟩ := hE (M.U'.obj ls) k (fun i => (M.V' i).obj ls) (fun i => (M.f' i).app ls)
    p tS h6

  choose mS hmS using fun σ : Fin (p + 1) → Fin k => (hL1 p σ ls).exists
  refine ⟨fun σ => ((wcEtToProEt Y).op.lan.obj F).map (mS σ).op
    (((wcEtToProEt Y).op.lanUnit.app F).app _ (β σ)), fun τ => ?_⟩
  obtain ⟨mτ, hmτ, -⟩ := hL1 (p + 1) τ ls
  beta_reduce
  rw [ht0 τ (mτ ≫ (wcEtToProEt Y).map (wT τ)) (hT (p + 1) τ g (wT τ) (hwT τ) mτ hmτ), hN,
    ← htS τ, ← hβ τ]
  simp only [map_sum, map_zsmul]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [hPc, ← hF p τ j ls mτ (mS (fun a => τ (j.succAbove a)))
    hmτ (hmS (fun a => τ (j.succAbove a))), hN]

theorem wc_etModel_of_pres : ∀ (Y : Scheme.{u}) (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), wcEtPres Y V f → Nonempty (wcEtModel Y V f) :=
by
  intro Y U k V f Pr

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (F : C ⥤ Scheme.{u}) (p : ℕ) (B : C)
      (objs : Fin (p + 1) → C) (arrows : ∀ j, objs j ⟶ B) [Limits.HasWidePullback B objs arrows]
      [Limits.PreservesLimit (Limits.WidePullbackShape.wideCospan B objs arrows) F]
      (Z : Scheme.{u}) (h : ∀ j, Z ⟶ F.obj (objs j)),
      (∀ j j', h j ≫ F.map (arrows j) = h j' ≫ F.map (arrows j')) →
      ∃! m : Z ⟶ F.obj (Limits.widePullback B objs arrows),
        ∀ j, m ≫ F.map (Limits.WidePullback.π arrows j) = h j := by
    intro C _ F p B objs arrows _ _ Z h hh
    let K := Limits.WidePullbackShape.wideCospan B objs arrows
    have hc : Limits.IsLimit (F.mapCone (Limits.limit.cone K)) :=
      Limits.isLimitOfPreserves F (Limits.limit.isLimit K)
    let s : Limits.Cone (K ⋙ F) := Limits.WidePullbackShape.mkCone (h 0 ≫ F.map (arrows 0)) h
      (fun j => by simpa [K] using hh j 0)
    obtain ⟨m, hm, huniq⟩ := hc.existsUnique s
    refine ⟨m, fun j => hm (some j), fun m' hm' => huniq m' ?_⟩
    intro x
    cases x with
    | none =>
      change m' ≫ F.map (Limits.WidePullback.base arrows) = h 0 ≫ F.map (arrows 0)
      rw [← hm' 0, Category.assoc, ← F.map_comp, Limits.WidePullback.π_arrow]
    | some j => exact hm' j

  have s2 : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Y.Etale) (T : Y.ProEt)
      (π : ∀ l, T ⟶ (wcEtToProEt Y).obj (D.obj l)),
      (∀ {l l' : Λ} (g : l ⟶ l'), π l ≫ (wcEtToProEt Y).map (D.map g) = π l') →
      (∀ l, IsAffine (D.obj l).left) →
      (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (D.obj l).left),
        (∀ {l l' : Λ} (g : l ⟶ l'), z l ≫ (D.map g).left = z l') →
        ∃! h : Z ⟶ T.left, ∀ l, h ≫ (π l).left = z l) →
      (∀ (E : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj E),
        ∃ (l : Λ) (e : D.obj l ⟶ E), π l ≫ (wcEtToProEt Y).map e = a) ∧
      (∀ (l : Λ) (E : Y.Etale) (e₁ e₂ : D.obj l ⟶ E),
        π l ≫ (wcEtToProEt Y).map e₁ = π l ≫ (wcEtToProEt Y).map e₂ →
        ∃ (l' : Λ) (g : l' ⟶ l), D.map g ≫ e₁ = D.map g ≫ e₂) := by
    intro Λ _ _ D T π hπ hAff hlim
    let D₀ : Λ ⥤ Scheme.{u} := D ⋙ Scheme.Etale.forget Y ⋙ Over.forget Y
    let c : Limits.Cone D₀ :=
      { pt := T.left
        π := { app := fun l => (π l).left
               naturality := fun l l' g => by
                 have := congrArg (fun x => x.left) (hπ g)
                 exact (Category.id_comp _).trans this.symm } }
    have hc : Limits.IsLimit c := Limits.IsLimit.ofExistsUnique (fun s =>
      hlim s.pt s.π.app (fun g => s.w g))
    let t : D₀ ⟶ (Functor.const Λ).obj Y :=
      { app := fun l => (D.obj l).hom
        naturality := fun l l' g => by
          exact (MorphismProperty.Over.w (D.map g)).trans (Category.comp_id _).symm }
    have : ∀ l, IsAffine (D₀.obj l) := hAff
    have : ∀ {i j : Λ} (g : i ⟶ j), IsAffineHom (D₀.map g) := fun g => isAffineHom_of_isAffine _
    have : ∀ l, CompactSpace (D₀.obj l) := fun l => inferInstance
    have : ∀ l, QuasiSeparatedSpace (D₀.obj l) := fun l => inferInstance
    refine ⟨fun E a => ?_, fun l E e₁ e₂ he => ?_⟩
    · obtain ⟨l, g, hg1, hg2⟩ := Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D₀ t
        E.hom c hc a.left (by
          ext l
          exact (MorphismProperty.Over.w (π l)).trans (MorphismProperty.Over.w a).symm)
      exact ⟨l, MorphismProperty.Over.homMk g hg2 trivial, MorphismProperty.Over.Hom.ext hg1⟩
    · have h1 : c.π.app l ≫ e₁.left = c.π.app l ≫ e₂.left := congrArg (fun x => x.left) he
      obtain ⟨k, hik, hjk, hk⟩ := Scheme.exists_hom_hom_comp_eq_comp_of_locallyOfFiniteType D₀ t
        E.hom c hc (i := l) e₁.left (MorphismProperty.Over.w e₁).symm (j := l) e₂.left
        (MorphismProperty.Over.w e₂).symm h1
      refine ⟨IsCofiltered.eq hik hjk, IsCofiltered.eqHom hik hjk ≫ hik, ?_⟩
      have hq := IsCofiltered.eq_condition hik hjk
      have hk' : D.map hik ≫ e₁ = D.map hjk ≫ e₂ := MorphismProperty.Over.Hom.ext hk
      calc D.map (IsCofiltered.eqHom hik hjk ≫ hik) ≫ e₁
          = D.map (IsCofiltered.eqHom hik hjk) ≫ D.map hik ≫ e₁ := by
            rw [D.map_comp, Category.assoc]
        _ = D.map (IsCofiltered.eqHom hik hjk) ≫ D.map hjk ≫ e₂ := by rw [hk']
        _ = D.map (IsCofiltered.eqHom hik hjk ≫ hik) ≫ e₂ := by
            rw [hq, D.map_comp, Category.assoc]

  have s4 : ∀ (p : ℕ) (U' : Y.Etale) (V' : Fin (p + 1) → Y.Etale) (f' : ∀ j, V' j ⟶ U'),
      IsAffine U'.left → (∀ j, IsAffine (V' j).left) →
      IsAffine (Limits.widePullback U' V' f').left := by
    intro p U' V' f' hU hV
    let K := Limits.WidePullbackShape.wideCospan U' V' f'
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget Y ⋙ Over.forget Y)
      (Limits.limit.isLimit K)
    have : ∀ x, IsAffine ((K ⋙ (Scheme.Etale.forget Y ⋙ Over.forget Y)).obj x) := by
      intro x
      cases x with
      | none => exact hU
      | some j => exact hV j
    exact Scheme.isAffine_of_isLimit _ hc

  have H : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      (∀ (E : Y.Etale)
          (a : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶ (wcEtToProEt Y).obj E),
        ∃ (l : Pr.Λ) (e : Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
            (fun j => (Pr.f' (σ j)).app l) ⟶ E),
          ∀ m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
              (wcEtToProEt Y).obj (Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
                (fun j => (Pr.f' (σ j)).app l)),
            (∀ j, m ≫ (wcEtToProEt Y).map
                (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j) =
              Limits.WidePullback.π (fun j => f (σ j)) j ≫ Pr.ψ (σ j) l) →
            m ≫ (wcEtToProEt Y).map e = a) ∧
      (∀ (l : Pr.Λ) (E : Y.Etale)
          (e₁ e₂ : Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
            (fun j => (Pr.f' (σ j)).app l) ⟶ E),
        (∀ m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
              (wcEtToProEt Y).obj (Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
                (fun j => (Pr.f' (σ j)).app l)),
            (∀ j, m ≫ (wcEtToProEt Y).map
                (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j) =
              Limits.WidePullback.π (fun j => f (σ j)) j ≫ Pr.ψ (σ j) l) →
            m ≫ (wcEtToProEt Y).map e₁ = m ≫ (wcEtToProEt Y).map e₂) →
        ∃ (l' : Pr.Λ) (g : l' ⟶ l),
          ∀ w : Limits.widePullback (Pr.U'.obj l') (fun j => (Pr.V' (σ j)).obj l')
              (fun j => (Pr.f' (σ j)).app l') ⟶
              Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
                (fun j => (Pr.f' (σ j)).app l),
            (∀ j, w ≫ Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j =
              Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l') j ≫ (Pr.V' (σ j)).map g) →
            w ≫ e₁ = w ≫ e₂) := by
    intro p σ

    have hT : ∀ (l : Pr.Λ) (X : Y.Etale)
        (a b : X ⟶ Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
          (fun j => (Pr.f' (σ j)).app l)),
        (∀ j, a ≫ Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j =
          b ≫ Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j) → a = b := by
      intro l X a b hab
      apply Limits.WidePullback.hom_ext _ a b hab
      rw [← Limits.WidePullback.π_arrow (fun j => (Pr.f' (σ j)).app l) 0, ← Category.assoc,
        ← Category.assoc, hab 0]

    let τ : ∀ {l l' : Pr.Λ} (g : l ⟶ l'),
        Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
          (fun j => (Pr.f' (σ j)).app l) ⟶
        Limits.widePullback (Pr.U'.obj l') (fun j => (Pr.V' (σ j)).obj l')
          (fun j => (Pr.f' (σ j)).app l') := fun {l l'} g =>
      Limits.WidePullback.lift
        (Limits.WidePullback.base (fun j => (Pr.f' (σ j)).app l) ≫ Pr.U'.map g)
        (fun j => Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j ≫ (Pr.V' (σ j)).map g)
        (fun j => by
          rw [Category.assoc, (Pr.f' (σ j)).naturality g, ← Category.assoc,
            Limits.WidePullback.π_arrow])
    have hτ : ∀ {l l' : Pr.Λ} (g : l ⟶ l') (j : Fin (p + 1)),
        τ g ≫ Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l') j =
          Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j ≫ (Pr.V' (σ j)).map g :=
      fun {l l'} g j => Limits.WidePullback.lift_π _ _ _ _ j
    have hτb : ∀ {l l' : Pr.Λ} (g : l ⟶ l'),
        τ g ≫ Limits.WidePullback.base (fun j => (Pr.f' (σ j)).app l') =
          Limits.WidePullback.base (fun j => (Pr.f' (σ j)).app l) ≫ Pr.U'.map g :=
      fun {l l'} g => Limits.WidePullback.lift_base _ _ _ _
    let D : Pr.Λ ⥤ Y.Etale :=
      { obj := fun l => Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
          (fun j => (Pr.f' (σ j)).app l)
        map := fun g => τ g
        map_id := fun l => by
          apply hT
          intro j
          rw [hτ, CategoryTheory.Functor.map_id, Category.comp_id, Category.id_comp]
        map_comp := fun {l₁ l₂ l₃} g g' => by
          apply hT
          intro j
          rw [hτ, Category.assoc, hτ, ← Category.assoc, hτ, Category.assoc,
            CategoryTheory.Functor.map_comp] }

    have hcomp : ∀ (l : Pr.Λ) (j : Fin (p + 1)),
        (Limits.WidePullback.π (fun j => f (σ j)) j).left ≫ (Pr.ψ (σ j) l).left ≫
          ((Pr.f' (σ j)).app l).left =
        (Limits.WidePullback.base (fun j => f (σ j))).left ≫ (Pr.φ l).left := by
      intro l j
      change (Limits.WidePullback.π (fun j => f (σ j)) j ≫ Pr.ψ (σ j) l ≫
          (wcEtToProEt Y).map ((Pr.f' (σ j)).app l)).left =
        (Limits.WidePullback.base (fun j => f (σ j)) ≫ Pr.φ l).left
      rw [Pr.hf, ← Category.assoc, Limits.WidePullback.π_arrow]
    have hpa : ∀ (l : Pr.Λ) (j : Fin (p + 1)),
        (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left ≫
          ((Pr.f' (σ j)).app l).left =
        (Limits.WidePullback.base (fun j => (Pr.f' (σ j)).app l)).left := by
      intro l j
      have := Limits.WidePullback.π_arrow (fun j => (Pr.f' (σ j)).app l) j
      exact congrArg (fun x => x.left) this
    have hL : ∀ (l : Pr.Λ) (Z : Scheme.{u})
        (a b : Z ⟶ (Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
          (fun j => (Pr.f' (σ j)).app l)).left),
        (∀ j, a ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left =
          b ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left) → a = b := by
      intro l Z a b hab
      have hu := s1 (Scheme.Etale.forget Y ⋙ Over.forget Y) p (Pr.U'.obj l)
        (fun j => (Pr.V' (σ j)).obj l) (fun j => (Pr.f' (σ j)).app l) Z
        (fun j => b ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left)
        (fun j j' => by
          change (b ≫ _) ≫ ((Pr.f' (σ j)).app l).left = (b ≫ _) ≫ ((Pr.f' (σ j')).app l).left
          rw [Category.assoc, Category.assoc, hpa l j, hpa l j'])
      exact hu.unique (fun j => hab j) (fun j => rfl)
    have hleg : ∀ l : Pr.Λ, ∃! m : (Limits.widePullback U (fun j => V (σ j))
          (fun j => f (σ j))).left ⟶
        (Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
          (fun j => (Pr.f' (σ j)).app l)).left,
        ∀ j, m ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left =
          (Limits.WidePullback.π (fun j => f (σ j)) j).left ≫ (Pr.ψ (σ j) l).left := by
      intro l
      exact s1 (Scheme.Etale.forget Y ⋙ Over.forget Y) p (Pr.U'.obj l)
        (fun j => (Pr.V' (σ j)).obj l) (fun j => (Pr.f' (σ j)).app l) _
        (fun j => (Limits.WidePullback.π (fun j => f (σ j)) j).left ≫ (Pr.ψ (σ j) l).left)
        (fun j j' =>
          (Category.assoc _ _ _).trans ((hcomp l j).trans ((hcomp l j').symm.trans
            (Category.assoc _ _ _).symm)))
    choose m₀ hm₀ _ using hleg
    have hw : ∀ l : Pr.Λ, m₀ l ≫ (Limits.widePullback (Pr.U'.obj l)
        (fun j => (Pr.V' (σ j)).obj l) (fun j => (Pr.f' (σ j)).app l)).hom =
        (Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j))).hom := by
      intro l
      exact (congrArg (fun x => m₀ l ≫ x) (MorphismProperty.Over.w
        (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) 0)).symm).trans
        ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun x => x ≫ ((Pr.V' (σ 0)).obj l).hom) (hm₀ l 0)).trans
        ((Category.assoc _ _ _).trans
        ((congrArg (fun x => (Limits.WidePullback.π (fun j => f (σ j)) 0).left ≫ x)
          (MorphismProperty.Over.w (Pr.ψ (σ 0) l))).trans
        (MorphismProperty.Over.w (Limits.WidePullback.π (fun j => f (σ j)) 0))))))
    let πl : ∀ l : Pr.Λ, Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
        (wcEtToProEt Y).obj (Limits.widePullback (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l)
          (fun j => (Pr.f' (σ j)).app l)) :=
      fun l => MorphismProperty.Over.homMk (m₀ l) (hw l) trivial
    have hC : ∀ (l : Pr.Λ) (j : Fin (p + 1)),
        πl l ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ Pr.ψ (σ j) l :=
      fun l j => MorphismProperty.Over.Hom.ext (hm₀ l j)
    have hU : ∀ (l : Pr.Λ) (T : Y.ProEt)
        (a b : T ⟶ (wcEtToProEt Y).obj (Limits.widePullback (Pr.U'.obj l)
          (fun j => (Pr.V' (σ j)).obj l) (fun j => (Pr.f' (σ j)).app l))),
        (∀ j, a ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j) =
          b ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j)) →
        a = b := fun l T a b hab =>
      MorphismProperty.Over.Hom.ext (hL l _ a.left b.left (fun j => congrArg (fun x => x.left) (hab j)))
    have hN : ∀ {l l' : Pr.Λ} (g : l ⟶ l'), πl l ≫ (wcEtToProEt Y).map (D.map g) = πl l' := by
      intro l l' g
      apply hU l'
      intro j
      change πl l ≫ (wcEtToProEt Y).map (τ g) ≫ _ = _
      rw [← Functor.map_comp, hτ g j, Functor.map_comp, ← Category.assoc, hC l j, Category.assoc,
        Pr.hψ, hC l' j]

    have hlim : ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (D.obj l).left),
        (∀ {l l' : Pr.Λ} (g : l ⟶ l'), z l ≫ (D.map g).left = z l') →
        ∃! h : Z ⟶ (Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j))).left,
          ∀ l, h ≫ (πl l).left = z l := by
      intro Z z hz
      have hz' : ∀ {l l' : Pr.Λ} (g : l ⟶ l') (j : Fin (p + 1)),
          (z l ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left) ≫
            ((Pr.V' (σ j)).map g).left =
          z l' ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l') j).left := by
        intro l l' g j
        rw [← hz g, Category.assoc, Category.assoc]
        exact congrArg (fun x => z l ≫ x.left) (hτ g j).symm
      have hzb : ∀ {l l' : Pr.Λ} (g : l ⟶ l'),
          (z l ≫ (Limits.WidePullback.base (fun j => (Pr.f' (σ j)).app l)).left) ≫
            (Pr.U'.map g).left =
          z l' ≫ (Limits.WidePullback.base (fun j => (Pr.f' (σ j)).app l')).left := by
        intro l l' g
        rw [← hz g, Category.assoc, Category.assoc]
        exact congrArg (fun x => z l ≫ x.left) (hτb g).symm
      have hcompV : ∀ j, ∃! h : Z ⟶ (V (σ j)).left, ∀ l, h ≫ (Pr.ψ (σ j) l).left =
          z l ≫ (Limits.WidePullback.π (fun j => (Pr.f' (σ j)).app l) j).left :=
        fun j => Pr.limV (σ j) Z _ (fun g => hz' g j)
      choose hj hhj hhju using hcompV
      obtain ⟨hU0, hU0p, hU0u⟩ := Pr.limU Z _ hzb
      have hagree : ∀ j, hj j ≫ (f (σ j)).left = hU0 := by
        intro j
        apply hU0u
        intro l
        have e1 : (f (σ j)).left ≫ (Pr.φ l).left =
            (Pr.ψ (σ j) l).left ≫ ((Pr.f' (σ j)).app l).left :=
          (congrArg (fun x => x.left) (Pr.hf (σ j) l)).symm
        rw [Category.assoc, e1]
        exact (Category.assoc _ _ _).symm.trans
          ((congrArg (fun x => x ≫ ((Pr.f' (σ j)).app l).left) (hhj j l)).trans
          ((Category.assoc _ _ _).trans (congrArg (fun x => z l ≫ x) (hpa l j))))
      obtain ⟨Hh, hHh, hHhu⟩ := s1 (Scheme.ProEt.forget Y ⋙ Over.forget Y) p U
        (fun j => V (σ j)) (fun j => f (σ j)) Z hj
        (fun j j' => (hagree j).trans (hagree j').symm)
      have hprop : ∀ (H' : Z ⟶ (Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j))).left),
          (∀ l, H' ≫ (πl l).left = z l) →
          ∀ j, H' ≫ (Limits.WidePullback.π (fun j => f (σ j)) j).left = hj j := by
        intro H' hH' j
        apply hhju j
        intro l
        rw [← hH' l]
        exact (Category.assoc _ _ _).trans
          ((congrArg (fun x => H' ≫ x) (hm₀ l j)).symm.trans (Category.assoc _ _ _).symm)
      refine ⟨Hh, fun l => ?_, fun H' hH' => hHhu H' (hprop H' hH')⟩
      apply hL l
      intro j
      exact (Category.assoc _ _ _).trans ((congrArg (fun x => Hh ≫ x) (hm₀ l j)).trans
        ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun x => x ≫ (Pr.ψ (σ j) l).left) (hHh j)).trans (hhj j l))))
    have hAffD : ∀ l, IsAffine (D.obj l).left := fun l =>
      s4 p (Pr.U'.obj l) (fun j => (Pr.V' (σ j)).obj l) (fun j => (Pr.f' (σ j)).app l)
        (Pr.affU l) (fun j => Pr.affV (σ j) l)
    obtain ⟨Hrep, Heq⟩ := s2 Pr.Λ D (Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)))
      πl hN hAffD hlim
    refine ⟨fun E a => ?_, fun l E e₁ e₂ hyp => ?_⟩
    · obtain ⟨l, e, he⟩ := Hrep E a
      refine ⟨l, e, fun m hm => ?_⟩
      have hm' : m = πl l := hU l _ m (πl l) (fun j => (hm j).trans (hC l j).symm)
      rw [hm']
      exact he
    · obtain ⟨l', g, hg⟩ := Heq l E e₁ e₂ (hyp (πl l) (hC l))
      refine ⟨l', g, fun w hw => ?_⟩
      have hw' : w = τ g := hT l _ w (τ g) (fun j => (hw j).trans (hτ g j).symm)
      rw [hw']
      exact hg
  exact ⟨⟨Pr.Λ, Pr.U', Pr.V', Pr.f', Pr.φ, Pr.ψ, Pr.hφ, Pr.hψ, Pr.hf,
    fun i E a =>
      (s2 Pr.Λ (Pr.V' i) (V i) (Pr.ψ i) (fun g => Pr.hψ i g) (Pr.affV i) (Pr.limV i)).1 E a,
    fun p σ => (H p σ).1,
    fun p σ => (H p σ).2⟩⟩

theorem wc_indEt_family_lift : ∀ (R S : CommRingCat.{u}) (k : ℕ) (T : Fin k → CommRingCat.{u}) (r : R ⟶ S) (q : ∀ i, S ⟶ T i), wcIndEtale r.hom → (∀ i, wcIndEtale (r ≫ q i).hom) → wcFamLift R S k T r q :=
by
  classical

  have s1 : ∀ (R T : CommRingCat.{u}) (t : R ⟶ T), wcIndEtale t.hom →
      ∀ (P : CommRingCat.{u}) (ιP : R ⟶ P) (h : P ⟶ T), ιP.hom.FinitePresentation → ιP ≫ h = t →
      ∃ (E : CommRingCat.{u}) (ρE : R ⟶ E) (a : P ⟶ E) (σ : E ⟶ T),
        ρE.hom.Etale ∧ ιP ≫ a = ρE ∧ ρE ≫ σ = t ∧ a ≫ σ = h := by
    intro R T t ht P ιP h hP hh
    letI : Algebra R T := t.hom.toAlgebra
    letI : Algebra R P := ιP.hom.toAlgebra
    haveI : Algebra.FinitePresentation R P := hP
    let h' : P →ₐ[R] T :=
      { h.hom with
        commutes' := fun x => by
          change h.hom (ιP.hom x) = t.hom x
          rw [← hh]
          rfl }
    obtain ⟨E₀, _, _, hE, α, β, hαβ⟩ := ht P h'
    refine ⟨CommRingCat.of E₀, CommRingCat.ofHom (algebraMap R E₀),
      CommRingCat.ofHom (α : P →+* E₀), CommRingCat.ofHom (β : E₀ →+* T), ?_, ?_, ?_, ?_⟩
    · rw [CommRingCat.hom_ofHom]
      exact RingHom.etale_algebraMap.mpr hE
    · apply CommRingCat.hom_ext
      ext x
      exact α.commutes x
    · apply CommRingCat.hom_ext
      ext x
      exact β.commutes x
    · apply CommRingCat.hom_ext
      ext x
      exact DFunLike.congr_fun hαβ x

  have s2 : ∀ (R E : CommRingCat.{u}) (ρE : R ⟶ E), ρE.hom.Etale →
      ∃ (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) (e : E ≅ CommRingCat.of (MvPolynomial (Fin n) R ⧸ I)),
        (algebraMap R (MvPolynomial (Fin n) R ⧸ I)).Etale ∧
        ρE ≫ e.hom = CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin n) R ⧸ I)) := by
    intro R E ρE hρ
    letI : Algebra R E := ρE.hom.toAlgebra
    haveI hE : Algebra.Etale R E := hρ
    haveI : Algebra.FinitePresentation R E := Algebra.Etale.finitePresentation
    obtain ⟨n, f, hf, -⟩ := Algebra.FinitePresentation.out (R := R) (A := E)
    let e₀ := Ideal.quotientKerAlgEquivOfSurjective hf
    haveI : Algebra.Etale R (MvPolynomial (Fin n) R ⧸ RingHom.ker f) := Algebra.Etale.of_equiv e₀.symm
    refine ⟨n, RingHom.ker f, e₀.symm.toRingEquiv.toCommRingCatIso,
      RingHom.etale_algebraMap.mpr inferInstance, ?_⟩
    apply CommRingCat.hom_ext
    ext x
    exact e₀.symm.commutes x

  have s3 : ∀ (R T : CommRingCat.{u}) (t : R ⟶ T),
      (∀ (P : CommRingCat.{u}) (ιP : R ⟶ P) (h : P ⟶ T), ιP.hom.FinitePresentation → ιP ≫ h = t →
        ∃ (E : CommRingCat.{u}) (ρE : R ⟶ E) (a : P ⟶ E) (σ : E ⟶ T),
          ρE.hom.Etale ∧ ιP ≫ a = ρE ∧ ρE ≫ σ = t ∧ a ≫ σ = h) →
      ∀ (P Q E : CommRingCat.{u}) (ιP : R ⟶ P) (γ : P ⟶ Q) (hQ : Q ⟶ T) (ρE : R ⟶ E) (a : P ⟶ E)
        (σ : E ⟶ T), ρE.hom.FinitePresentation → ιP.hom.FinitePresentation →
        (ιP ≫ γ).hom.FinitePresentation → ιP ≫ a = ρE → ρE ≫ σ = t → a ≫ σ = γ ≫ hQ →
        ∃ (F : CommRingCat.{u}) (ρF : R ⟶ F) (g : E ⟶ F) (b : Q ⟶ F) (β : F ⟶ T),
          ρF.hom.Etale ∧ ρE ≫ g = ρF ∧ ιP ≫ γ ≫ b = ρF ∧ g ≫ β = σ ∧ b ≫ β = hQ ∧
            a ≫ g = γ ≫ b := by
    intro R T t hlift P Q E ιP γ hQ ρE a σ hρ hP hPQ h1 h2 h3
    have hγ : γ.hom.FinitePresentation := by
      rw [CommRingCat.hom_comp] at hPQ
      exact RingHom.FinitePresentation.of_comp_finiteType ιP.hom hPQ
        (RingHom.FiniteType.of_finitePresentation hP)
    have hinl : (Limits.pushout.inl a γ).hom.FinitePresentation :=
      RingHom.IsStableUnderBaseChange.pushout_inl RingHom.finitePresentation_isStableUnderBaseChange
        RingHom.finitePresentation_respectsIso a γ hγ
    have hι : (ρE ≫ Limits.pushout.inl a γ).hom.FinitePresentation := by
      rw [CommRingCat.hom_comp]
      exact RingHom.FinitePresentation.comp hinl hρ
    have hd : (ρE ≫ Limits.pushout.inl a γ) ≫ Limits.pushout.desc σ hQ h3 = t := by
      rw [Category.assoc, Limits.pushout.inl_desc, h2]
    obtain ⟨F, ρF, a', β, hρF, k1, k2, k3⟩ := hlift _ _ _ hι hd
    refine ⟨F, ρF, Limits.pushout.inl a γ ≫ a', Limits.pushout.inr a γ ≫ a', β, hρF,
      ?_, ?_, ?_, ?_, ?_⟩
    · rw [← Category.assoc]
      exact k1
    · rw [← Limits.pushout.condition_assoc, ← Category.assoc ιP a, h1, ← Category.assoc]
      exact k1
    · rw [Category.assoc, k3, Limits.pushout.inl_desc]
    · rw [Category.assoc, k3, Limits.pushout.inr_desc]
    · exact Limits.pushout.condition_assoc a'

  intro R S k T r q hr hrq P ιP h Q γ hQ hP hPQ hh hc
  obtain ⟨E₀, ρ₀, a₀, σ₀, hρ₀, e1, e2, e3⟩ := s1 R S r hr P ιP h hP hh
  have hρ₀fp : ρ₀.hom.FinitePresentation := by
    letI : Algebra R E₀ := ρ₀.hom.toAlgebra
    haveI : Algebra.Etale R E₀ := hρ₀
    exact Algebra.Etale.finitePresentation
  have hF : ∀ i, ∃ (F : CommRingCat.{u}) (ρF : R ⟶ F) (g : E₀ ⟶ F) (b : Q i ⟶ F) (β : F ⟶ T i),
      ρF.hom.Etale ∧ ρ₀ ≫ g = ρF ∧ ιP ≫ γ i ≫ b = ρF ∧ g ≫ β = σ₀ ≫ q i ∧ b ≫ β = hQ i ∧
        a₀ ≫ g = γ i ≫ b := fun i =>
    s3 R (T i) (r ≫ q i) (s1 R (T i) (r ≫ q i) (hrq i)) P (Q i) E₀ ιP (γ i) (hQ i) ρ₀ a₀
      (σ₀ ≫ q i) hρ₀fp hP (hPQ i) e1 (by rw [← Category.assoc, e2])
      (by rw [← Category.assoc, e3, hc i])
  choose F₀ ρF g₀ b₀ β₀ hρF f1 f2 f3 f4 f5 using hF
  obtain ⟨nE, IE, ε, hEet, hε⟩ := s2 R E₀ ρ₀ hρ₀
  choose nF IF εF hFet hεF using fun i => s2 R (F₀ i) (ρF i) (hρF i)
  refine ⟨nE, IE, nF, IF, ε.inv ≫ σ₀, fun i => (εF i).inv ≫ β₀ i,
    fun i => ε.inv ≫ g₀ i ≫ (εF i).hom, a₀ ≫ ε.hom, fun i => b₀ i ≫ (εF i).hom,
    hEet, hFet, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    rw [← hε, ← hεF i, ← f1 i]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  · rw [← hε, ← Category.assoc, e1]
  · intro i
    rw [← hεF i, ← f2 i]
    simp only [Category.assoc]
  · simp only [Category.assoc, Iso.hom_inv_id_assoc, e3]
  · intro i
    simp only [Category.assoc, Iso.hom_inv_id_assoc, f3]
  · intro i
    simp only [Category.assoc, Iso.hom_inv_id_assoc, f4]
  · intro i
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Category.assoc, f5 i, Category.assoc]

theorem wc_indEt_family_presentation_of_lift : ∀ (R S : CommRingCat.{u}) (k : ℕ) (T : Fin k → CommRingCat.{u}) (r : R ⟶ S) (q : ∀ i, S ⟶ T i), wcFamLift R S k T r q → ∃ (Λ : Type u) (_ : SmallCategory Λ) (_ : IsFiltered Λ) (E : Λ ⥤ CommRingCat.{u}) (F : Fin k → Λ ⥤ CommRingCat.{u}) (ρ : (Functor.const Λ).obj R ⟶ E) (g : ∀ i, E ⟶ F i) (α : E ⟶ (Functor.const Λ).obj S) (β : ∀ i, F i ⟶ (Functor.const Λ).obj (T i)), (∀ l, (ρ.app l).hom.Etale) ∧ (∀ i l, (ρ.app l ≫ (g i).app l).hom.Etale) ∧ (∀ l, ρ.app l ≫ α.app l = r) ∧ (∀ i l, (g i).app l ≫ (β i).app l = α.app l ≫ q i) ∧ Nonempty (Limits.IsColimit (Limits.Cocone.mk S α)) ∧ ∀ i, Nonempty (Limits.IsColimit (Limits.Cocone.mk (T i) (β i))) :=
by
  intro R S k T r q hL
  classical

  have EFP : ∀ X : wcFamObj R S k T r q,
      (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)).FinitePresentation := fun X =>
    RingHom.finitePresentation_algebraMap.mpr
      (@Algebra.Etale.finitePresentation _ _ _ _ _ (RingHom.etale_algebraMap.mp X.etE))
  have EFPF : ∀ (X : wcFamObj R S k T r q) (i : Fin k),
      (algebraMap R (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)).FinitePresentation := fun X i =>
    RingHom.finitePresentation_algebraMap.mpr
      (@Algebra.Etale.finitePresentation _ _ _ _ _ (RingHom.etale_algebraMap.mp (X.etF i)))
  have hext : ∀ {X Y : wcFamObj R S k T r q} (f g : wcFamHom X Y), f.e = g.e →
      (∀ i, f.eF i = g.eF i) → f = g := by
    intro X Y f g h1 h2
    cases f; cases g
    simp only [wcFamHom.mk.injEq]
    exact ⟨h1, funext h2⟩

  have c1 : ∀ (X : wcFamObj R S k T r q) (J : Ideal (MvPolynomial (Fin X.nE) R ⧸ X.IE))
      (Jf : ∀ i, Ideal (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)), J.FG → (∀ i, (Jf i).FG) →
      (∀ i, Ideal.map (X.g i).hom J ≤ Jf i) → (∀ a ∈ J, X.α.hom a = 0) →
      (∀ i, ∀ b ∈ Jf i, (X.β i).hom b = 0) →
      ∃ (Y : wcFamObj R S k T r q) (f : wcFamHom X Y), (∀ a ∈ J, f.e.hom a = 0) ∧
        ∀ i, ∀ b ∈ Jf i, (f.eF i).hom b = 0 := by
    intro X J Jf hJ hJf hmap hα hβ
    have H : ∀ i, J ≤ Ideal.comap (X.g i).hom (Jf i) := fun i =>
      Ideal.map_le_iff_le_comap.mp (hmap i)
    let P : CommRingCat.{u} := CommRingCat.of ((MvPolynomial (Fin X.nE) R ⧸ X.IE) ⧸ J)
    let ιP : R ⟶ P := CommRingCat.ofHom ((Ideal.Quotient.mk J).comp
      (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)))
    let h : P ⟶ S := CommRingCat.ofHom (Ideal.Quotient.lift J X.α.hom hα)
    let Q : Fin k → CommRingCat.{u} := fun i =>
      CommRingCat.of ((MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i) ⧸ Jf i)
    let γ : ∀ i, P ⟶ Q i := fun i =>
      CommRingCat.ofHom (Ideal.quotientMap (Jf i) (X.g i).hom (H i))
    let hQ : ∀ i, Q i ⟶ T i := fun i =>
      CommRingCat.ofHom (Ideal.Quotient.lift (Jf i) (X.β i).hom (hβ i))
    have fp1 : ιP.hom.FinitePresentation :=
      (EFP X).comp_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hJ)
    have fp2 : ∀ i, (ιP ≫ γ i).hom.FinitePresentation := by
      intro i
      have e : (ιP ≫ γ i).hom = (Ideal.Quotient.mk (Jf i)).comp
          (algebraMap R (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)) := by
        refine RingHom.ext fun x => ?_
        have e0 : (X.g i).hom (algebraMap R _ x) = algebraMap R _ x :=
          congrArg (fun φ => CommRingCat.Hom.hom φ x) (X.hg i)
        change Ideal.Quotient.mk (Jf i) ((X.g i).hom (algebraMap R _ x)) = _
        rw [e0]
        rfl
      rw [e]
      exact (EFPF X i).comp_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hJf i)
    have h3 : ιP ≫ h = r := by
      rw [← X.hα]
      rfl
    have h4 : ∀ i, γ i ≫ hQ i = h ≫ q i := by
      intro i
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun a => ?_
      change (X.β i).hom ((X.g i).hom a) = (q i).hom (X.α.hom a)
      exact congrArg (fun φ => CommRingCat.Hom.hom φ a) (X.hβ i)
    obtain ⟨nE, IE, nF, IF, α', β', g', a, b, c1', c2', c3', c4', c5', c6', c7', c8', c9'⟩ :=
      hL P ιP h Q γ hQ fp1 fp2 h3 h4
    have hαY : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ α' = r := by
      rw [← c4', Category.assoc, c6', h3]
    let Y : wcFamObj R S k T r q := ⟨nE, IE, nF, IF, α', β', g', c1', c2', c3', hαY, c7'⟩
    have f1 : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)) ≫
        (CommRingCat.ofHom (Ideal.Quotient.mk J) ≫ a) =
        CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) :=
      (Category.assoc _ _ _).symm.trans c4'
    have f2 : (CommRingCat.ofHom (Ideal.Quotient.mk J) ≫ a) ≫ α' = X.α := by
      rw [Category.assoc, c6']
      rfl
    have f3 : ∀ i, (CommRingCat.ofHom (Ideal.Quotient.mk (Jf i)) ≫ b i) ≫ β' i = X.β i := by
      intro i
      rw [Category.assoc, c8' i]
      rfl
    have f4 : ∀ i, X.g i ≫ (CommRingCat.ofHom (Ideal.Quotient.mk (Jf i)) ≫ b i) =
        (CommRingCat.ofHom (Ideal.Quotient.mk J) ≫ a) ≫ g' i := by
      intro i
      have e : X.g i ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Jf i)) =
          CommRingCat.ofHom (Ideal.Quotient.mk J) ≫ γ i := rfl
      rw [← Category.assoc, e, Category.assoc, Category.assoc, c9' i]
    refine ⟨Y, ⟨CommRingCat.ofHom (Ideal.Quotient.mk J) ≫ a,
      fun i => CommRingCat.ofHom (Ideal.Quotient.mk (Jf i)) ≫ b i, f1, f2, f3, f4⟩, ?_, ?_⟩
    · intro a0 ha0
      change a.hom (Ideal.Quotient.mk J a0) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha0, map_zero]
    · intro i b0 hb0
      change (b i).hom (Ideal.Quotient.mk (Jf i) b0) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb0, map_zero]

  have c2 : ∀ X Y : wcFamObj R S k T r q, ∃ Z : wcFamObj R S k T r q,
      Nonempty (wcFamHom X Z) ∧ Nonempty (wcFamHom Y Z) := by
    intro X Y
    let ρX := CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE))
    let ρY := CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin Y.nE) R ⧸ Y.IE))
    let ρXi := fun i => CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i))
    let ρYi := fun i => CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i))
    have w : ρX ≫ X.α = ρY ≫ Y.α := X.hα.trans Y.hα.symm
    have wi : ∀ i, ρX ≫ X.g i ≫ Limits.pushout.inl (ρXi i) (ρYi i) =
        ρY ≫ Y.g i ≫ Limits.pushout.inr (ρXi i) (ρYi i) := by
      intro i
      rw [← Category.assoc, X.hg i, ← Category.assoc, Y.hg i]
      exact Limits.pushout.condition
    have wi' : ∀ i, ρXi i ≫ X.β i = ρYi i ≫ Y.β i := by
      intro i
      have e1 : ρXi i ≫ X.β i = r ≫ q i := by
        change CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)) ≫
          X.β i = r ≫ q i
        rw [← X.hg i, Category.assoc, X.hβ i, ← Category.assoc, X.hα]
      have e2 : ρYi i ≫ Y.β i = r ≫ q i := by
        change CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i)) ≫
          Y.β i = r ≫ q i
        rw [← Y.hg i, Category.assoc, Y.hβ i, ← Category.assoc, Y.hα]
      exact e1.trans e2.symm
    have fp1 : (ρX ≫ Limits.pushout.inl ρX ρY).hom.FinitePresentation := by
      rw [CommRingCat.hom_comp]
      exact RingHom.FinitePresentation.comp
        (RingHom.IsStableUnderBaseChange.pushout_inl
          RingHom.finitePresentation_isStableUnderBaseChange
          RingHom.finitePresentation_respectsIso ρX ρY (EFP Y)) (EFP X)
    have fp2 : ∀ i, ((ρX ≫ Limits.pushout.inl ρX ρY) ≫
        Limits.pushout.desc (X.g i ≫ Limits.pushout.inl (ρXi i) (ρYi i))
          (Y.g i ≫ Limits.pushout.inr (ρXi i) (ρYi i)) (wi i)).hom.FinitePresentation := by
      intro i
      have e : (ρX ≫ Limits.pushout.inl ρX ρY) ≫
          Limits.pushout.desc (X.g i ≫ Limits.pushout.inl (ρXi i) (ρYi i))
            (Y.g i ≫ Limits.pushout.inr (ρXi i) (ρYi i)) (wi i) =
          ρXi i ≫ Limits.pushout.inl (ρXi i) (ρYi i) := by
        rw [Category.assoc, Limits.pushout.inl_desc, ← Category.assoc, X.hg i]
      rw [e, CommRingCat.hom_comp]
      exact RingHom.FinitePresentation.comp
        (RingHom.IsStableUnderBaseChange.pushout_inl
          RingHom.finitePresentation_isStableUnderBaseChange
          RingHom.finitePresentation_respectsIso (ρXi i) (ρYi i) (EFPF Y i)) (EFPF X i)
    have h3 : (ρX ≫ Limits.pushout.inl ρX ρY) ≫ Limits.pushout.desc X.α Y.α w = r := by
      rw [Category.assoc, Limits.pushout.inl_desc]
      exact X.hα
    have h4 : ∀ i, Limits.pushout.desc (X.g i ≫ Limits.pushout.inl (ρXi i) (ρYi i))
          (Y.g i ≫ Limits.pushout.inr (ρXi i) (ρYi i)) (wi i) ≫
          Limits.pushout.desc (X.β i) (Y.β i) (wi' i) =
        Limits.pushout.desc X.α Y.α w ≫ q i := by
      intro i
      apply Limits.pushout.hom_ext
      · rw [Limits.pushout.inl_desc_assoc, Category.assoc, Limits.pushout.inl_desc,
          Limits.pushout.inl_desc_assoc, X.hβ i]
      · rw [Limits.pushout.inr_desc_assoc, Category.assoc, Limits.pushout.inr_desc,
          Limits.pushout.inr_desc_assoc, Y.hβ i]
    obtain ⟨nE, IE, nF, IF, α', β', g', a, b, c1', c2', c3', c4', c5', c6', c7', c8', c9'⟩ :=
      hL (Limits.pushout ρX ρY) (ρX ≫ Limits.pushout.inl ρX ρY) (Limits.pushout.desc X.α Y.α w)
        (fun i => Limits.pushout (ρXi i) (ρYi i))
        (fun i => Limits.pushout.desc (X.g i ≫ Limits.pushout.inl (ρXi i) (ρYi i))
          (Y.g i ≫ Limits.pushout.inr (ρXi i) (ρYi i)) (wi i))
        (fun i => Limits.pushout.desc (X.β i) (Y.β i) (wi' i)) fp1 fp2 h3 h4
    have hαZ : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ α' = r := by
      rw [← c4', Category.assoc, c6', h3]
    let Z : wcFamObj R S k T r q := ⟨nE, IE, nF, IF, α', β', g', c1', c2', c3', hαZ, c7'⟩
    have fX1 : ρX ≫ (Limits.pushout.inl ρX ρY ≫ a) =
        CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) :=
      (Category.assoc _ _ _).symm.trans c4'
    have fX2 : (Limits.pushout.inl ρX ρY ≫ a) ≫ α' = X.α := by
      rw [Category.assoc, c6', Limits.pushout.inl_desc]
    have fX3 : ∀ i, (Limits.pushout.inl (ρXi i) (ρYi i) ≫ b i) ≫ β' i = X.β i := by
      intro i
      rw [Category.assoc, c8' i, Limits.pushout.inl_desc]
    have fX4 : ∀ i, X.g i ≫ (Limits.pushout.inl (ρXi i) (ρYi i) ≫ b i) =
        (Limits.pushout.inl ρX ρY ≫ a) ≫ g' i := by
      intro i
      rw [Category.assoc, c9' i, ← Category.assoc, ← Category.assoc, Limits.pushout.inl_desc]
    have fY1 : ρY ≫ (Limits.pushout.inr ρX ρY ≫ a) =
        CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) := by
      rw [← Category.assoc, ← Limits.pushout.condition]
      exact c4'
    have fY2 : (Limits.pushout.inr ρX ρY ≫ a) ≫ α' = Y.α := by
      rw [Category.assoc, c6', Limits.pushout.inr_desc]
    have fY3 : ∀ i, (Limits.pushout.inr (ρXi i) (ρYi i) ≫ b i) ≫ β' i = Y.β i := by
      intro i
      rw [Category.assoc, c8' i, Limits.pushout.inr_desc]
    have fY4 : ∀ i, Y.g i ≫ (Limits.pushout.inr (ρXi i) (ρYi i) ≫ b i) =
        (Limits.pushout.inr ρX ρY ≫ a) ≫ g' i := by
      intro i
      rw [Category.assoc, c9' i, ← Category.assoc, ← Category.assoc, Limits.pushout.inr_desc]
    exact ⟨Z, ⟨⟨Limits.pushout.inl ρX ρY ≫ a, fun i => Limits.pushout.inl (ρXi i) (ρYi i) ≫ b i,
      fX1, fX2, fX3, fX4⟩⟩, ⟨⟨Limits.pushout.inr ρX ρY ≫ a,
      fun i => Limits.pushout.inr (ρXi i) (ρYi i) ≫ b i, fY1, fY2, fY3, fY4⟩⟩⟩

  have c3 : ∀ (X Y : wcFamObj R S k T r q) (f g : wcFamHom X Y),
      ∃ (J : Ideal (MvPolynomial (Fin Y.nE) R ⧸ Y.IE))
        (Jf : ∀ i, Ideal (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i)),
        J.FG ∧ (∀ i, (Jf i).FG) ∧ (∀ i, Ideal.map (Y.g i).hom J ≤ Jf i) ∧
        (∀ a ∈ J, Y.α.hom a = 0) ∧ (∀ i, ∀ b ∈ Jf i, (Y.β i).hom b = 0) ∧
        ∀ (Z : wcFamObj R S k T r q) (h : wcFamHom Y Z), (∀ a ∈ J, h.e.hom a = 0) →
          (∀ i, ∀ b ∈ Jf i, (h.eF i).hom b = 0) →
          f.e ≫ h.e = g.e ≫ h.e ∧ ∀ i, f.eF i ≫ h.eF i = g.eF i ≫ h.eF i := by
    intro X Y f g
    let J : Ideal (MvPolynomial (Fin Y.nE) R ⧸ Y.IE) := Ideal.span (Set.range fun j : Fin X.nE =>
      f.e.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j)) -
        g.e.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j)))
    let Jf : ∀ i, Ideal (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i) := fun i =>
      Ideal.map (Y.g i).hom J ⊔ Ideal.span (Set.range fun j : Fin (X.nF i) =>
        (f.eF i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j)) -
          (g.eF i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j)))
    have hαJ : ∀ a ∈ J, Y.α.hom a = 0 := by
      intro a ha
      have hle : J ≤ RingHom.ker Y.α.hom := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, map_sub]
        have e1 : Y.α.hom (f.e.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j))) =
            X.α.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j)) :=
          congrArg (fun φ => CommRingCat.Hom.hom φ (Ideal.Quotient.mk X.IE (MvPolynomial.X j))) f.h2
        have e2 : Y.α.hom (g.e.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j))) =
            X.α.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j)) :=
          congrArg (fun φ => CommRingCat.Hom.hom φ (Ideal.Quotient.mk X.IE (MvPolynomial.X j))) g.h2
        rw [e1, e2, sub_self]
      exact hle ha
    have hβJ : ∀ i, ∀ b ∈ Jf i, (Y.β i).hom b = 0 := by
      intro i b hb
      have hle : Jf i ≤ RingHom.ker (Y.β i).hom := by
        refine sup_le ?_ ?_
        · rw [Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, RingHom.mem_ker]
          have e : (Y.β i).hom ((Y.g i).hom a) = (q i).hom (Y.α.hom a) :=
            congrArg (fun φ => CommRingCat.Hom.hom φ a) (Y.hβ i)
          rw [e, hαJ a ha, map_zero]
        · rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          rw [SetLike.mem_coe, RingHom.mem_ker, map_sub]
          have e1 : (Y.β i).hom ((f.eF i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j))) =
              (X.β i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j)) :=
            congrArg (fun φ => CommRingCat.Hom.hom φ
              (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j))) (f.h3 i)
          have e2 : (Y.β i).hom ((g.eF i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j))) =
              (X.β i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j)) :=
            congrArg (fun φ => CommRingCat.Hom.hom φ
              (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j))) (g.h3 i)
          rw [e1, e2, sub_self]
      exact hle hb
    refine ⟨J, Jf, Submodule.fg_span (Set.finite_range _), fun i => Submodule.FG.sup
      (Ideal.FG.map (Submodule.fg_span (Set.finite_range _)) _)
      (Submodule.fg_span (Set.finite_range _)), fun i => le_sup_left, hαJ, hβJ, ?_⟩
    intro Z h hk1 hk2
    constructor
    · apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        have ef : ((CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)) ≫ f.e) ≫
            h.e).hom c = (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin Z.nE) R ⧸ Z.IE))).hom c :=
          congrArg (fun φ => CommRingCat.Hom.hom φ c) (by rw [f.h1, h.h1])
        have eg : ((CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)) ≫ g.e) ≫
            h.e).hom c = (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin Z.nE) R ⧸ Z.IE))).hom c :=
          congrArg (fun φ => CommRingCat.Hom.hom φ c) (by rw [g.h1, h.h1])
        exact ef.trans eg.symm
      · intro j
        have hm : f.e.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j)) -
            g.e.hom (Ideal.Quotient.mk X.IE (MvPolynomial.X j)) ∈ J := Ideal.subset_span ⟨j, rfl⟩
        have h0 := hk1 _ hm
        rw [map_sub, sub_eq_zero] at h0
        exact h0
    · intro i
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        have key : ∀ f' : wcFamHom X Y,
            (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)) ≫ f'.eF i) ≫
              h.eF i =
            CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i)) ≫ h.eF i := by
          intro f'
          calc (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)) ≫
                f'.eF i) ≫ h.eF i
              = CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)) ≫
                  (X.g i ≫ f'.eF i) ≫ h.eF i := by
                rw [← X.hg i]; simp only [Category.assoc]
            _ = (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE)) ≫ f'.e) ≫
                  Y.g i ≫ h.eF i := by
                rw [f'.h4 i]; simp only [Category.assoc]
            _ = CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (Y.nF i)) R ⧸ Y.IF i)) ≫
                  h.eF i := by
                rw [f'.h1, ← Category.assoc, Y.hg i]
        have ef := congrArg (fun φ => CommRingCat.Hom.hom φ c) (key f)
        have eg := congrArg (fun φ => CommRingCat.Hom.hom φ c) (key g)
        exact ef.trans eg.symm
      · intro j
        have hm : (f.eF i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j)) -
            (g.eF i).hom (Ideal.Quotient.mk (X.IF i) (MvPolynomial.X j)) ∈ Jf i :=
          Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)
        have h0 := hk2 i _ hm
        rw [map_sub, sub_eq_zero] at h0
        exact h0

  have c4 : ∀ s : S, ∃ (X : wcFamObj R S k T r q) (x : MvPolynomial (Fin X.nE) R ⧸ X.IE),
      X.α.hom x = s := by
    intro s
    let M : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 1) R)
    let ιP : R ⟶ M := CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 1) R))
    let h : M ⟶ S := CommRingCat.ofHom (MvPolynomial.eval₂Hom r.hom (fun _ => s))
    have fp : ιP.hom.FinitePresentation := RingHom.finitePresentation_algebraMap.mpr
      (Algebra.FinitePresentation.mvPolynomial R R (Fin 1))
    have h3 : ιP ≫ h = r := by
      apply CommRingCat.hom_ext
      refine RingHom.ext fun c => ?_
      exact MvPolynomial.eval₂Hom_C _ _ c
    obtain ⟨nE, IE, nF, IF, α', β', g', a, b, c1', c2', c3', c4', c5', c6', c7', c8', c9'⟩ :=
      hL M ιP h (fun _ => M) (fun _ => 𝟙 M) (fun i => h ≫ q i) fp
        (fun i => by
          show (ιP ≫ 𝟙 M).hom.FinitePresentation
          rw [Category.comp_id]
          exact fp) h3 (fun i => Category.id_comp _)
    have hαX : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ α' = r := by
      rw [← c4', Category.assoc, c6', h3]
    refine ⟨⟨nE, IE, nF, IF, α', β', g', c1', c2', c3', hαX, c7'⟩, a.hom (MvPolynomial.X 0), ?_⟩
    have e : α'.hom (a.hom (MvPolynomial.X 0)) = h.hom (MvPolynomial.X 0) :=
      congrArg (fun φ => CommRingCat.Hom.hom φ (MvPolynomial.X 0)) c6'
    exact e.trans (MvPolynomial.eval₂Hom_X' _ _ _)

  have c5 : ∀ (i₀ : Fin k) (t : T i₀), ∃ (X : wcFamObj R S k T r q)
      (y : MvPolynomial (Fin (X.nF i₀)) R ⧸ X.IF i₀), (X.β i₀).hom y = t := by
    intro i₀ t
    let M : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 1) R)
    let τ : ∀ i, T i := Pi.single i₀ t
    let γ : ∀ _ : Fin k, R ⟶ M := fun _ =>
      CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 1) R))
    let hQ : ∀ i, M ⟶ T i := fun i =>
      CommRingCat.ofHom (MvPolynomial.eval₂Hom (r ≫ q i).hom (fun _ => τ i))
    have fp : (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 1) R))).hom.FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr
        (Algebra.FinitePresentation.mvPolynomial R R (Fin 1))
    obtain ⟨nE, IE, nF, IF, α', β', g', a, b, c1', c2', c3', c4', c5', c6', c7', c8', c9'⟩ :=
      hL R (𝟙 R) r (fun _ => M) γ hQ
        (by rw [CommRingCat.hom_id]; exact RingHom.FinitePresentation.id _)
        (fun i => by
          show (𝟙 R ≫ γ i).hom.FinitePresentation
          rw [Category.id_comp]
          exact fp)
        (Category.id_comp r)
        (fun i => by
          apply CommRingCat.hom_ext
          refine RingHom.ext fun c => ?_
          exact MvPolynomial.eval₂Hom_C _ _ c)
    have hαX : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin nE) R ⧸ IE)) ≫ α' = r := by
      rw [← c4', Category.assoc, c6']
      exact Category.id_comp r
    refine ⟨⟨nE, IE, nF, IF, α', β', g', c1', c2', c3', hαX, c7'⟩,
      (b i₀).hom (MvPolynomial.X 0), ?_⟩
    have e : (β' i₀).hom ((b i₀).hom (MvPolynomial.X 0)) = (hQ i₀).hom (MvPolynomial.X 0) :=
      congrArg (fun φ => CommRingCat.Hom.hom φ (MvPolynomial.X 0)) (c8' i₀)
    exact e.trans ((MvPolynomial.eval₂Hom_X' _ _ _).trans (Pi.single_eq_same _ _))

  have c6 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (E : J ⥤ CommRingCat.{u})
      (S' : CommRingCat.{u}) (α : E ⟶ (Functor.const J).obj S'),
      (∀ s : S', ∃ (j : J) (x : E.obj j), (α.app j).hom x = s) →
      (∀ (j : J) (x y : E.obj j), (α.app j).hom x = (α.app j).hom y →
        ∃ (j' : J) (f : j ⟶ j'), (E.map f).hom x = (E.map f).hom y) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk S' α)) := by
    intro J _ _ E S' α hs hi
    haveI : Limits.ReflectsColimitsOfShape J (forget CommRingCat.{u}) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact ⟨Limits.isColimitOfReflects (forget _)
      (Limits.Types.FilteredColimit.isColimitOf' (E ⋙ forget _) _
        (fun x => by
          obtain ⟨j, y, hy⟩ := hs x
          exact ⟨j, y, hy.symm⟩) hi)⟩

  let idH : ∀ X : wcFamObj R S k T r q, wcFamHom X X := fun X =>
    { e := 𝟙 _
      eF := fun _ => 𝟙 _
      h1 := Category.comp_id _
      h2 := Category.id_comp _
      h3 := fun _ => Category.id_comp _
      h4 := fun _ => by rw [Category.comp_id, Category.id_comp] }
  let compH : ∀ {X Y Z : wcFamObj R S k T r q}, wcFamHom X Y → wcFamHom Y Z → wcFamHom X Z :=
    fun f g =>
    { e := f.e ≫ g.e
      eF := fun i => f.eF i ≫ g.eF i
      h1 := by rw [← Category.assoc, f.h1, g.h1]
      h2 := by rw [Category.assoc, g.h2, f.h2]
      h3 := fun i => by rw [Category.assoc, g.h3, f.h3]
      h4 := fun i => by rw [← Category.assoc, f.h4, Category.assoc, g.h4, Category.assoc] }
  letI cat : SmallCategory (wcFamObj R S k T r q) :=
    { Hom := fun X Y => wcFamHom X Y
      id := idH
      comp := compH
      id_comp := fun f => hext _ _ (Category.id_comp _) (fun _ => Category.id_comp _)
      comp_id := fun f => hext _ _ (Category.comp_id _) (fun _ => Category.comp_id _)
      assoc := fun f g h => hext _ _ (Category.assoc _ _ _) (fun _ => Category.assoc _ _ _) }
  haveI hfo : IsFilteredOrEmpty (wcFamObj R S k T r q) :=
    { cocone_objs := fun X Y => by
        obtain ⟨Z, ⟨f⟩, ⟨f'⟩⟩ := c2 X Y
        exact ⟨Z, f, f', trivial⟩
      cocone_maps := fun X Y f g => by
        obtain ⟨J, Jf, hJ, hJf, hmap, hα, hβ, hco⟩ := c3 X Y f g
        obtain ⟨Z, h, hk1, hk2⟩ := c1 Y J Jf hJ hJf hmap hα hβ
        exact ⟨Z, h, hext _ _ (hco Z h hk1 hk2).1 (hco Z h hk1 hk2).2⟩ }
  obtain ⟨X0, -, -⟩ := c4 0
  haveI : Nonempty (wcFamObj R S k T r q) := ⟨X0⟩
  haveI hfilt : IsFiltered (wcFamObj R S k T r q) := {}
  let E : wcFamObj R S k T r q ⥤ CommRingCat.{u} :=
    { obj := fun X => CommRingCat.of (MvPolynomial (Fin X.nE) R ⧸ X.IE)
      map := fun f => wcFamHom.e f
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }
  let F : Fin k → wcFamObj R S k T r q ⥤ CommRingCat.{u} := fun i =>
    { obj := fun X => CommRingCat.of (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i)
      map := fun f => wcFamHom.eF f i
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }
  let ρ : (Functor.const (wcFamObj R S k T r q)).obj R ⟶ E :=
    { app := fun X => CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin X.nE) R ⧸ X.IE))
      naturality := fun X Y f => (Category.id_comp _).trans (wcFamHom.h1 f).symm }
  let gg : ∀ i, E ⟶ F i := fun i =>
    { app := fun X => X.g i
      naturality := fun X Y f => (wcFamHom.h4 f i).symm }
  let α : E ⟶ (Functor.const (wcFamObj R S k T r q)).obj S :=
    { app := fun X => X.α
      naturality := fun X Y f => (wcFamHom.h2 f).trans (Category.comp_id _).symm }
  let β : ∀ i, F i ⟶ (Functor.const (wcFamObj R S k T r q)).obj (T i) := fun i =>
    { app := fun X => X.β i
      naturality := fun X Y f => (wcFamHom.h3 f i).trans (Category.comp_id _).symm }
  refine ⟨wcFamObj R S k T r q, cat, hfilt, E, F, ρ, gg, α, β, fun l => l.etE, ?_,
    fun l => l.hα, fun i l => l.hβ i, ?_, ?_⟩
  · intro i l
    have e : ρ.app l ≫ (gg i).app l =
        CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin (l.nF i)) R ⧸ l.IF i)) := l.hg i
    rw [e]
    exact l.etF i
  · refine c6 _ E S α (fun s => c4 s) ?_
    intro X x y hxy
    let J : Ideal (MvPolynomial (Fin X.nE) R ⧸ X.IE) := Ideal.span {x - y}
    have hαJ : ∀ a ∈ J, X.α.hom a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      have hxy' : X.α.hom x = X.α.hom y := hxy
      rw [map_mul, map_sub, hxy', sub_self, mul_zero]
    have hβJ : ∀ i, ∀ b ∈ Ideal.map (X.g i).hom J, (X.β i).hom b = 0 := by
      intro i b hb
      have hle : Ideal.map (X.g i).hom J ≤ RingHom.ker (X.β i).hom := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, RingHom.mem_ker]
        have e : (X.β i).hom ((X.g i).hom a) = (q i).hom (X.α.hom a) :=
          congrArg (fun φ => CommRingCat.Hom.hom φ a) (X.hβ i)
        rw [e, hαJ a ha, map_zero]
      exact hle hb
    obtain ⟨Y, f, hf1, -⟩ := c1 X J (fun i => Ideal.map (X.g i).hom J)
      (Submodule.fg_span (Set.finite_singleton _))
      (fun i => Ideal.FG.map (Submodule.fg_span (Set.finite_singleton _)) _)
      (fun i => le_rfl) hαJ hβJ
    refine ⟨Y, f, ?_⟩
    have h0 := hf1 (x - y) (Ideal.subset_span (Set.mem_singleton _))
    rw [map_sub, sub_eq_zero] at h0
    exact h0
  · intro i₀
    refine c6 _ (F i₀) (T i₀) (β i₀) (fun t => c5 i₀ t) ?_
    intro X x y hxy
    let Jf : ∀ i, Ideal (MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i) := fun i =>
      Ideal.span {(Pi.single i₀ (x - y) : ∀ i, MvPolynomial (Fin (X.nF i)) R ⧸ X.IF i) i}
    have hβJ : ∀ i, ∀ b ∈ Jf i, (X.β i).hom b = 0 := by
      intro i b hb
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hb
      rw [map_mul]
      by_cases hi : i = i₀
      · subst hi
        have hxy' : (X.β i).hom x = (X.β i).hom y := hxy
        rw [Pi.single_eq_same, map_sub, hxy', sub_self, mul_zero]
      · rw [Pi.single_eq_of_ne hi, map_zero, mul_zero]
    obtain ⟨Y, f, -, hf2⟩ := c1 X ⊥ Jf (Submodule.fg_bot)
      (fun i => Submodule.fg_span (Set.finite_singleton _))
      (fun i => by rw [Ideal.map_bot]; exact bot_le)
      (fun a ha => by rw [(Submodule.mem_bot _).mp ha, map_zero]) hβJ
    refine ⟨Y, f, ?_⟩
    have h0 := hf2 i₀ _ (Ideal.subset_span (Set.mem_singleton _))
    rw [Pi.single_eq_same, map_sub, sub_eq_zero] at h0
    exact h0

theorem wc_etPres_of_ringPres : ∀ (Y : Scheme.{u}) (A : Y.Opens), IsAffineOpen A → ∀ (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U) (gU : U.left ⟶ (A : Scheme.{u})), gU ≫ A.ι = U.hom → ∀ (Λ : Type u) [SmallCategory Λ] [IsFiltered Λ] (E : Λ ⥤ CommRingCat.{u}) (F : Fin k → Λ ⥤ CommRingCat.{u}) (ρ : (Functor.const Λ).obj Γ((A : Scheme.{u}), ⊤) ⟶ E) (g : ∀ i, E ⟶ F i) (α : E ⟶ (Functor.const Λ).obj Γ(U.left, ⊤)) (β : ∀ i, F i ⟶ (Functor.const Λ).obj Γ((V i).left, ⊤)), (∀ l, (ρ.app l).hom.Etale) → (∀ i l, (ρ.app l ≫ (g i).app l).hom.Etale) → (∀ l, ρ.app l ≫ α.app l = gU.appTop) → (∀ i l, (g i).app l ≫ (β i).app l = α.app l ≫ (f i).left.appTop) → (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ Spec (E.obj l)), (∀ {l l' : Λ} (g' : l ⟶ l'), z l' ≫ Spec.map (E.map g') = z l) → ∃! h : Z ⟶ U.left, ∀ l, h ≫ U.left.toSpecΓ ≫ Spec.map (α.app l) = z l) → (∀ (i : Fin k) (Z : Scheme.{u}) (z : ∀ l, Z ⟶ Spec ((F i).obj l)), (∀ {l l' : Λ} (g' : l ⟶ l'), z l' ≫ Spec.map ((F i).map g') = z l) → ∃! h : Z ⟶ (V i).left, ∀ l, h ≫ (V i).left.toSpecΓ ≫ Spec.map ((β i).app l) = z l) → Nonempty (wcEtPres Y V f) :=
by
  intro Y A hA U k V f gU hgU Λ _ _ E F ρ g α β h1 h2 h3 h4 hU hV
  haveI : IsAffine (A : Scheme.{u}) := hA
  obtain ⟨j, hj, hjet⟩ : ∃ j : Spec Γ((A : Scheme.{u}), ⊤) ⟶ Y,
      (A : Scheme.{u}).toSpecΓ ≫ j = A.ι ∧ Etale j :=
    ⟨(A : Scheme.{u}).isoSpec.inv ≫ A.ι,
      by rw [← Category.assoc, Scheme.toSpecΓ_isoSpec_inv, Category.id_comp], inferInstance⟩
  haveI := hjet
  have Nρ : ∀ {b a : Λ} (h : b ⟶ a), ρ.app b ≫ E.map h = ρ.app a := by
    intro b a h
    have := ρ.naturality h
    simp only [Functor.const_obj_map, Category.id_comp] at this
    exact this.symm
  have Nα : ∀ {b a : Λ} (h : b ⟶ a), E.map h ≫ α.app a = α.app b := by
    intro b a h
    have := α.naturality h
    simp only [Functor.const_obj_map, Category.comp_id] at this
    exact this
  have Nβ : ∀ (i : Fin k) {b a : Λ} (h : b ⟶ a), (F i).map h ≫ (β i).app a = (β i).app b := by
    intro i b a h
    have := (β i).naturality h
    simp only [Functor.const_obj_map, Category.comp_id] at this
    exact this
  have Ng : ∀ (i : Fin k) {b a : Λ} (h : b ⟶ a),
      E.map h ≫ (g i).app a = (g i).app b ≫ (F i).map h :=
    fun i b a h => (g i).naturality h
  have NρF : ∀ (i : Fin k) {b a : Λ} (h : b ⟶ a),
      (ρ.app b ≫ (g i).app b) ≫ (F i).map h = ρ.app a ≫ (g i).app a := by
    intro i b a h
    rw [Category.assoc, ← Ng, ← Category.assoc, Nρ]
  have e1 : ∀ l, Etale (Spec.map (ρ.app l) ≫ j) := by
    intro l
    haveI : Etale (Spec.map (ρ.app l)) := (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (h1 l)
    infer_instance
  have e2 : ∀ i l, Etale (Spec.map (ρ.app l ≫ (g i).app l) ≫ j) := by
    intro i l
    haveI : Etale (Spec.map (ρ.app l ≫ (g i).app l)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (h2 i l)
    infer_instance
  let U' : Λᵒᵖ ⥤ Y.Etale :=
    { obj := fun l => MorphismProperty.Over.mk ⊤ (Spec.map (ρ.app l.unop) ≫ j) (e1 l.unop)
      map := fun {l₁ l₂} m => MorphismProperty.Over.homMk (Spec.map (E.map m.unop)) (by
          change Spec.map (E.map m.unop) ≫ Spec.map (ρ.app l₂.unop) ≫ j =
            Spec.map (ρ.app l₁.unop) ≫ j
          rw [← Category.assoc, ← Spec.map_comp, Nρ]) trivial
      map_id := fun l => by
        apply MorphismProperty.Over.Hom.ext
        change Spec.map (E.map (𝟙 l).unop) = 𝟙 _
        rw [unop_id, E.map_id, Spec.map_id]
      map_comp := fun {l₁ l₂ l₃} m m' => by
        apply MorphismProperty.Over.Hom.ext
        change Spec.map (E.map (m ≫ m').unop) =
          Spec.map (E.map m.unop) ≫ Spec.map (E.map m'.unop)
        rw [unop_comp, E.map_comp, Spec.map_comp] }
  let V' : Fin k → Λᵒᵖ ⥤ Y.Etale := fun i =>
    { obj := fun l => MorphismProperty.Over.mk ⊤
        (Spec.map (ρ.app l.unop ≫ (g i).app l.unop) ≫ j) (e2 i l.unop)
      map := fun {l₁ l₂} m => MorphismProperty.Over.homMk (Spec.map ((F i).map m.unop)) (by
          change Spec.map ((F i).map m.unop) ≫ Spec.map (ρ.app l₂.unop ≫ (g i).app l₂.unop) ≫ j =
            Spec.map (ρ.app l₁.unop ≫ (g i).app l₁.unop) ≫ j
          rw [← Category.assoc, ← Spec.map_comp, NρF]) trivial
      map_id := fun l => by
        apply MorphismProperty.Over.Hom.ext
        change Spec.map ((F i).map (𝟙 l).unop) = 𝟙 _
        rw [unop_id, (F i).map_id, Spec.map_id]
      map_comp := fun {l₁ l₂ l₃} m m' => by
        apply MorphismProperty.Over.Hom.ext
        change Spec.map ((F i).map (m ≫ m').unop) =
          Spec.map ((F i).map m.unop) ≫ Spec.map ((F i).map m'.unop)
        rw [unop_comp, (F i).map_comp, Spec.map_comp] }
  let f' : ∀ i, V' i ⟶ U' := fun i =>
    { app := fun l => MorphismProperty.Over.homMk (Spec.map ((g i).app l.unop)) (by
          change Spec.map ((g i).app l.unop) ≫ Spec.map (ρ.app l.unop) ≫ j =
            Spec.map (ρ.app l.unop ≫ (g i).app l.unop) ≫ j
          rw [← Category.assoc, ← Spec.map_comp]) trivial
      naturality := fun {l₁ l₂} m => by
        apply MorphismProperty.Over.Hom.ext
        change Spec.map ((F i).map m.unop) ≫ Spec.map ((g i).app l₂.unop) =
          Spec.map ((g i).app l₁.unop) ≫ Spec.map (E.map m.unop)
        rw [← Spec.map_comp, ← Spec.map_comp, Ng] }
  let φ : ∀ l, U ⟶ (wcEtToProEt Y).obj (U'.obj l) := fun l =>
    MorphismProperty.Over.homMk (U.left.toSpecΓ ≫ Spec.map (α.app l.unop)) (by
      change (U.left.toSpecΓ ≫ Spec.map (α.app l.unop)) ≫ Spec.map (ρ.app l.unop) ≫ j = U.hom
      rw [Category.assoc, ← Category.assoc (Spec.map (α.app l.unop)), ← Spec.map_comp, h3,
        ← Scheme.toSpecΓ_naturality_assoc, hj, hgU]) trivial
  have hr : ∀ (i : Fin k) (a : Λ),
      (ρ.app a ≫ (g i).app a) ≫ (β i).app a = ((f i).left ≫ gU).appTop := by
    intro i a
    rw [Category.assoc, h4, ← Category.assoc, h3, Scheme.Hom.comp_appTop]
  let ψ : ∀ i l, V i ⟶ (wcEtToProEt Y).obj ((V' i).obj l) := fun i l =>
    MorphismProperty.Over.homMk ((V i).left.toSpecΓ ≫ Spec.map ((β i).app l.unop)) (by
      change ((V i).left.toSpecΓ ≫ Spec.map ((β i).app l.unop)) ≫
        Spec.map (ρ.app l.unop ≫ (g i).app l.unop) ≫ j = (V i).hom
      rw [Category.assoc, ← Category.assoc (Spec.map ((β i).app l.unop)), ← Spec.map_comp, hr,
        ← Scheme.toSpecΓ_naturality_assoc, Category.assoc, hj, hgU,
        MorphismProperty.Over.w (f i)]) trivial
  exact ⟨{
    Λ := Λᵒᵖ
    cat := inferInstance
    cofil := isCofiltered_op_of_isFiltered Λ
    U' := U'
    V' := V'
    f' := f'
    φ := φ
    ψ := ψ
    hφ := fun {l l'} m => by
      apply MorphismProperty.Over.Hom.ext
      change (U.left.toSpecΓ ≫ Spec.map (α.app l.unop)) ≫ Spec.map (E.map m.unop) =
        U.left.toSpecΓ ≫ Spec.map (α.app l'.unop)
      rw [Category.assoc, ← Spec.map_comp, Nα]
    hψ := fun i {l l'} m => by
      apply MorphismProperty.Over.Hom.ext
      change ((V i).left.toSpecΓ ≫ Spec.map ((β i).app l.unop)) ≫ Spec.map ((F i).map m.unop) =
        (V i).left.toSpecΓ ≫ Spec.map ((β i).app l'.unop)
      rw [Category.assoc, ← Spec.map_comp, Nβ]
    hf := fun i l => by
      apply MorphismProperty.Over.Hom.ext
      change ((V i).left.toSpecΓ ≫ Spec.map ((β i).app l.unop)) ≫ Spec.map ((g i).app l.unop) =
        (f i).left ≫ U.left.toSpecΓ ≫ Spec.map (α.app l.unop)
      rw [Category.assoc, ← Spec.map_comp, h4, Spec.map_comp, Scheme.toSpecΓ_naturality_assoc]
    affU := fun l => show IsAffine (Spec (E.obj l.unop)) from inferInstance
    affV := fun i l => show IsAffine (Spec ((F i).obj l.unop)) from inferInstance
    limU := fun Z z hz => by
      obtain ⟨h, hh, huniq⟩ := hU Z (fun a => z (Opposite.op a)) (fun {a a'} g' => hz g'.op)
      exact ⟨h, fun l => hh l.unop, fun h' hh' => huniq h' (fun a => hh' (Opposite.op a))⟩
    limV := fun i Z z hz => by
      obtain ⟨h, hh, huniq⟩ := hV i Z (fun a => z (Opposite.op a)) (fun {a a'} g' => hz g'.op)
      exact ⟨h, fun l => hh l.unop, fun h' hh' => huniq h' (fun a => hh' (Opposite.op a))⟩ }⟩

theorem wc_etPres_of_affIndEt : ∀ (Y : Scheme.{u}) (A : Y.Opens), IsAffineOpen A → ∀ (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), wcAffIndEt Y A U → (∀ i, wcAffIndEt Y A (V i)) → Nonempty (wcEtPres Y V f) :=
by

  have s3 : ∀ (Λ₀ : Type u) [SmallCategory Λ₀] (E : Λ₀ ⥤ CommRingCat.{u}) (X : Scheme.{u}),
      IsAffine X → ∀ (α : E ⟶ (Functor.const Λ₀).obj Γ(X, ⊤)),
      Nonempty (Limits.IsColimit (Limits.Cocone.mk Γ(X, ⊤) α)) →
      ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ Spec (E.obj l)),
      (∀ {l l' : Λ₀} (g : l ⟶ l'), z l' ≫ Spec.map (E.map g) = z l) →
      ∃! h : Z ⟶ X, ∀ l, h ≫ X.toSpecΓ ≫ Spec.map (α.app l) = z l := by
    intro Λ₀ _ E X hX α hc Z z hz
    obtain ⟨hc⟩ := hc
    have hl := Limits.isLimitOfPreserves Scheme.Spec hc.op
    let s : Limits.Cone (E.op ⋙ Scheme.Spec) :=
      { pt := Z
        π := { app := fun l => z l.unop
               naturality := fun l l' g => by
                 change 𝟙 Z ≫ z l'.unop = z l.unop ≫ Spec.map (E.map g.unop)
                 rw [Category.id_comp, hz g.unop] } }
    have hfac : ∀ l : Λ₀, hl.lift s ≫ Spec.map (α.app l) = z l :=
      fun l => hl.fac s (Opposite.op l)
    refine ⟨hl.lift s ≫ X.isoSpec.inv, fun l => ?_, fun h' hh' => ?_⟩
    · rw [Category.assoc, Scheme.isoSpec_inv_toSpecΓ_assoc]
      exact hfac l
    · have e : h' ≫ X.toSpecΓ = hl.lift s := by
        apply hl.uniq s
        intro l
        rw [Category.assoc]
        exact hh' l.unop
      rw [← e, Category.assoc, Scheme.toSpecΓ_isoSpec_inv, Category.comp_id]
  intro Y A hA U k V f hU hV
  obtain ⟨hUaff, gU, hgU, hindU⟩ := hU
  have hV' : ∀ i, IsAffine (V i).left ∧ wcIndEtale (gU.appTop ≫ (f i).left.appTop).hom := by
    intro i
    obtain ⟨hVa, gVi, hgVi, hindVi⟩ := hV i
    have e : gVi = (f i).left ≫ gU := by
      rw [← cancel_mono A.ι, hgVi, Category.assoc, hgU]
      exact (MorphismProperty.Over.w (f i)).symm
    subst e
    rw [Scheme.Hom.comp_appTop] at hindVi
    exact ⟨hVa, hindVi⟩
  have hL := wc_indEt_family_lift Γ((A : Scheme.{u}), ⊤) Γ(U.left, ⊤) k
    (fun i => Γ((V i).left, ⊤)) gU.appTop (fun i => (f i).left.appTop) hindU
    (fun i => (hV' i).2)
  obtain ⟨Λ, _, _, E, F, ρ, g, α, β, h1, h2, h3, h4, hcS, hcT⟩ :=
    wc_indEt_family_presentation_of_lift _ _ k _ _ _ hL
  exact wc_etPres_of_ringPres Y A hA U k V f gU hgU Λ E F ρ g α β h1 h2 h3 h4
    (s3 Λ E U.left hUaff α hcS) (fun i => s3 Λ (F i) (V i).left (hV' i).1 (β i) (hcT i))

theorem wc_lanLevel_of_model : ∀ (Y : Scheme.{u}) (F : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U) (M : wcEtModel Y V f), wcLanLevel Y F M :=
by
  intro Y F U k V f M
  haveI : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
      (Scheme.ProEt.forget Y)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance

  have s1 : ∀ (T : Y.ProEt), (∀ (E : Y.Etale) (h : T ⟶ (wcEtToProEt Y).obj E) (x : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op T)), ∃ (V₁ : Y.Etale) (b : V₁ ⟶ E) (a : T ⟶ (wcEtToProEt Y).obj V₁) (t : F.obj (Opposite.op V₁)), a ≫ (wcEtToProEt Y).map b = h ∧ x = ((wcEtToProEt Y).op.lan.obj F).map a.op (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V₁) t)) ∧ (∀ (V₁ : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V₁) (t : F.obj (Opposite.op V₁)), ((wcEtToProEt Y).op.lan.obj F).map a.op (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V₁) t) = 0 → ∃ (V₂ : Y.Etale) (c : V₂ ⟶ V₁) (a' : T ⟶ (wcEtToProEt Y).obj V₂), a' ≫ (wcEtToProEt Y).map c = a ∧ F.map c.op t = 0) := by
    intro T
    haveI : RepresentablyFlat (wcEtToProEt Y) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow T (wcEtToProEt Y)) := RepresentablyFlat.cofiltered T
    haveI hI : IsFiltered (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtToProEt Y) T)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((wcEtToProEt Y).op.leftKanExtension F)
      ((wcEtToProEt Y).op.leftKanExtensionUnit F)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
      (wcEtToProEt Y).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op T)
    have hleg : ∀ (V : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V) (t : F.obj (Opposite.op V)),
        (E.coconeAt (Opposite.op T)).ι.app (CostructuredArrow.mk (Y := Opposite.op V) a.op) t =
        ((wcEtToProEt Y).op.lan.obj F).map a.op
          (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V) t) := by
      intro V a t
      rfl
    refine ⟨fun V h x => ?_, fun V₁ a t ht => ?_⟩
    · obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hc x
      let k : CostructuredArrow (wcEtToProEt Y).op (Opposite.op T) :=
        CostructuredArrow.mk (Y := Opposite.op V) h.op
      let m := IsFiltered.max j k
      let f₁ := IsFiltered.leftToMax j k
      let f₂ := IsFiltered.rightToMax j k
      have hw : (wcEtToProEt Y).op.map f₂.left ≫ m.hom = h.op := CostructuredArrow.w f₂
      refine ⟨m.left.unop, f₂.left.unop, m.hom.unop, F.map f₁.left y, ?_, ?_⟩
      · apply Quiver.Hom.op_inj
        rw [op_comp]
        exact hw
      · have hcw := Limits.Cocone.w (E.coconeAt (Opposite.op T)) f₁
        have h2 : (E.coconeAt (Opposite.op T)).ι.app m (F.map f₁.left y) =
            (E.coconeAt (Opposite.op T)).ι.app j y := by
          rw [← hcw]
          rfl
        rw [← hy, ← h2]
        rfl
    · let j : CostructuredArrow (wcEtToProEt Y).op (Opposite.op T) :=
        CostructuredArrow.mk (Y := Opposite.op V₁) a.op
      let t' : ToType ((CostructuredArrow.proj (wcEtToProEt Y).op (Opposite.op T) ⋙ F).obj j) := t
      have h0 : (E.coconeAt (Opposite.op T)).ι.app j t' = (E.coconeAt (Opposite.op T)).ι.app j 0 := by
        rw [map_zero]
        exact (hleg V₁ a t).trans ht
      obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
      have hw : (wcEtToProEt Y).op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
      refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
      · apply Quiver.Hom.op_inj
        rw [op_comp]
        exact hw
      · have : F.map f.left t = 0 := by
          refine hfg.trans ?_
          exact map_zero _
        exact this

  have s2 : ∀ (p : ℕ) (U' : Y.Etale) (V' : Fin (p + 1) → Y.Etale) (f' : ∀ j, V' j ⟶ U') (T : Y.ProEt) (h : ∀ j, T ⟶ (wcEtToProEt Y).obj (V' j)), (∀ j j', h j ≫ (wcEtToProEt Y).map (f' j) = h j' ≫ (wcEtToProEt Y).map (f' j')) → ∃! m : T ⟶ (wcEtToProEt Y).obj (Limits.widePullback U' V' f'), ∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π f' j) = h j := by
    intro p U' V' f' T h hh
    let K := Limits.WidePullbackShape.wideCospan U' V' f'
    have hL : Limits.IsLimit ((wcEtToProEt Y).mapCone (Limits.limit.cone K)) :=
      Limits.isLimitOfPreserves (wcEtToProEt Y) (Limits.limit.isLimit K)
    let s : Limits.Cone (K ⋙ wcEtToProEt Y) :=
      Limits.WidePullbackShape.mkCone (h 0 ≫ (wcEtToProEt Y).map (f' 0)) h
        (fun j => by simpa [K] using hh j 0)
    have hfac : ∀ j, hL.lift s ≫ (wcEtToProEt Y).map (Limits.WidePullback.π f' j) = h j :=
      fun j => hL.fac s (some j)
    have e1 : ∀ g : T ⟶ (wcEtToProEt Y).obj (Limits.widePullback U' V' f'),
        (∀ j, g ≫ (wcEtToProEt Y).map (Limits.WidePullback.π f' j) = h j) →
        g ≫ (wcEtToProEt Y).map (Limits.WidePullback.base f') = h 0 ≫ (wcEtToProEt Y).map (f' 0) := by
      intro g hg
      rw [← Limits.WidePullback.π_arrow f' 0, Functor.map_comp, ← Category.assoc, hg 0]
    refine ⟨hL.lift s, hfac, fun m' hm' => ?_⟩
    apply hL.hom_ext
    intro J
    rcases J with _ | j
    · exact (e1 m' hm').trans (e1 _ hfac).symm
    · exact (hm' j).trans (hfac j).symm

  have s3 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) {l l' : M.Λ} (g : l' ⟶ l),
      (∃ w : Limits.widePullback (M.U'.obj l') (fun j => (M.V' (σ j)).obj l') (fun j => (M.f' (σ j)).app l') ⟶ Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l) (fun j => (M.f' (σ j)).app l),
        ∀ j, w ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map g) ∧
      ∀ w₁ w₂ : Limits.widePullback (M.U'.obj l') (fun j => (M.V' (σ j)).obj l') (fun j => (M.f' (σ j)).app l') ⟶ Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l) (fun j => (M.f' (σ j)).app l),
        (∀ j, w₁ ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map g) →
        (∀ j, w₂ ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map g) →
        w₁ = w₂ := by
    intro p σ l l' g
    constructor
    · refine ⟨Limits.WidePullback.lift
        (Limits.WidePullback.base (fun j => (M.f' (σ j)).app l') ≫ M.U'.map g)
        (fun j => Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map g)
        ?_, fun j => Limits.WidePullback.lift_π _ _ _ _ j⟩
      intro j
      beta_reduce
      rw [Category.assoc, (M.f' (σ j)).naturality g, ← Category.assoc,
        Limits.WidePullback.π_arrow (fun j => (M.f' (σ j)).app l') j]
    · intro w₁ w₂ h₁ h₂
      apply Limits.WidePullback.hom_ext
      · intro j
        rw [h₁ j, h₂ j]
      · rw [← Limits.WidePullback.π_arrow (fun j => (M.f' (σ j)).app l) 0, ← Category.assoc,
          ← Category.assoc, h₁ 0, h₂ 0]

  have s4 : ∀ (T : Y.ProEt) (E₁ E₂ : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj E₁) (e : E₁ ⟶ E₂) (t : F.obj (Opposite.op E₂)), ((wcEtToProEt Y).op.lan.obj F).map a.op (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₁) (F.map e.op t)) = ((wcEtToProEt Y).op.lan.obj F).map (a ≫ (wcEtToProEt Y).map e).op (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₂) t) := by
    intro T E₁ E₂ a e t
    have h : ((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₁) (F.map e.op t) =
        ((wcEtToProEt Y).op.lan.obj F).map ((wcEtToProEt Y).map e).op
          (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op E₂) t) :=
      NatTrans.naturality_apply ((wcEtToProEt Y).op.lanUnit.app F) e.op t
    rw [h, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  have hT : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) {l₁ l₂ : M.Λ} (g : l₂ ⟶ l₁)
      (w : Limits.widePullback (M.U'.obj l₂) (fun j => (M.V' (σ j)).obj l₂) (fun j => (M.f' (σ j)).app l₂) ⟶ Limits.widePullback (M.U'.obj l₁) (fun j => (M.V' (σ j)).obj l₁) (fun j => (M.f' (σ j)).app l₁)),
      (∀ j, w ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₁) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₂) j ≫ (M.V' (σ j)).map g) →
      ∀ m₂ : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l₂) (fun j => (M.V' (σ j)).obj l₂)
            (fun j => (M.f' (σ j)).app l₂)),
        (∀ j, m₂ ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₂) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l₂) →
        ∀ j, (m₂ ≫ (wcEtToProEt Y).map w) ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₁) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l₁ := by
    intro p σ l₁ l₂ g w hw m₂ hm₂ j
    rw [Category.assoc, ← Functor.map_comp, hw j, Functor.map_comp, ← Category.assoc, hm₂ j,
      Category.assoc, M.hψ (σ j) g]

  have hC : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) {l l₂ l' : M.Λ} (g' : l' ⟶ l₂) (g₂ : l₂ ⟶ l)
      (w' : Limits.widePullback (M.U'.obj l') (fun j => (M.V' (σ j)).obj l') (fun j => (M.f' (σ j)).app l') ⟶ Limits.widePullback (M.U'.obj l₂) (fun j => (M.V' (σ j)).obj l₂) (fun j => (M.f' (σ j)).app l₂))
      (w₂ : Limits.widePullback (M.U'.obj l₂) (fun j => (M.V' (σ j)).obj l₂) (fun j => (M.f' (σ j)).app l₂) ⟶ Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l) (fun j => (M.f' (σ j)).app l)),
      (∀ j, w' ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₂) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map g') →
      (∀ j, w₂ ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l₂) j ≫ (M.V' (σ j)).map g₂) →
      ∀ j, (w' ≫ w₂) ≫ Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j = Limits.WidePullback.π (fun j => (M.f' (σ j)).app l') j ≫ (M.V' (σ j)).map (g' ≫ g₂) := by
    intro p σ l l₂ l' g' g₂ w' w₂ hw' hw₂ j
    rw [Category.assoc, hw₂ j, ← Category.assoc, hw' j, Category.assoc, Functor.map_comp]

  have hC1 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (l : M.Λ),
      ∃! m : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj l) (fun j => (M.V' (σ j)).obj l)
            (fun j => (M.f' (σ j)).app l)),
        ∀ j, m ≫ (wcEtToProEt Y).map (Limits.WidePullback.π (fun j => (M.f' (σ j)).app l) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l := by
    intro p σ l
    refine s2 p (M.U'.obj l) (fun j => (M.V' (σ j)).obj l) (fun j => (M.f' (σ j)).app l) _
      (fun j => Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l) ?_
    have hj : ∀ j, (Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) l) ≫
        (wcEtToProEt Y).map ((M.f' (σ j)).app l) =
        Limits.WidePullback.base (fun j => f (σ j)) ≫ M.φ l := by
      intro j
      rw [Category.assoc, M.hf (σ j) l, ← Category.assoc,
        Limits.WidePullback.π_arrow (fun j => f (σ j)) j]
    intro j j'
    exact (hj j).trans (hj j').symm
  unfold wcLanLevel
  refine ⟨hC1, ?_, ?_, ?_⟩

  · intro i x
    obtain ⟨l₀⟩ := (IsCofiltered.nonempty : Nonempty M.Λ)
    obtain ⟨V₁, b, a, t, -, hx⟩ := (s1 (V i)).1 ((M.V' i).obj l₀) (M.ψ i l₀) x
    obtain ⟨l, e, he⟩ := M.repV i V₁ a
    refine ⟨l, F.map e.op t, ?_⟩
    rw [hx, s4, he]

  · intro p σ x
    obtain ⟨l₀⟩ := (IsCofiltered.nonempty : Nonempty M.Λ)
    obtain ⟨m₀, -, -⟩ := hC1 p σ l₀
    obtain ⟨V₁, b, a, t, -, hx⟩ := (s1 _).1 _ m₀ x
    obtain ⟨l, e, he⟩ := M.rep p σ V₁ a
    refine ⟨l, F.map e.op t, fun m hm => ?_⟩
    rw [hx, s4, he m hm]

  · intro p σ l t m hm h0
    obtain ⟨V₂, c, a', eqc, hct⟩ := (s1 _).2 _ m t h0
    obtain ⟨l₁, e, hrep⟩ := M.rep p σ V₂ a'
    obtain ⟨⟨w₁, hw₁⟩, -⟩ := s3 p σ (IsCofiltered.minToLeft l₁ l)
    obtain ⟨⟨w₂, hw₂⟩, -⟩ := s3 p σ (IsCofiltered.minToRight l₁ l)
    have claim : ∀ m₂ : Limits.widePullback U (fun j => V (σ j)) (fun j => f (σ j)) ⟶
          (wcEtToProEt Y).obj (Limits.widePullback (M.U'.obj (IsCofiltered.min l₁ l))
            (fun j => (M.V' (σ j)).obj (IsCofiltered.min l₁ l))
            (fun j => (M.f' (σ j)).app (IsCofiltered.min l₁ l))),
        (∀ j, m₂ ≫ (wcEtToProEt Y).map (Limits.WidePullback.π
            (fun j => (M.f' (σ j)).app (IsCofiltered.min l₁ l)) j) =
          Limits.WidePullback.π (fun j => f (σ j)) j ≫ M.ψ (σ j) (IsCofiltered.min l₁ l)) →
        m₂ ≫ (wcEtToProEt Y).map (w₁ ≫ e ≫ c) = m₂ ≫ (wcEtToProEt Y).map w₂ := by
      intro m₂ hm₂
      have h1 : m₂ ≫ (wcEtToProEt Y).map (w₁ ≫ e ≫ c) = m := by
        simp only [Functor.map_comp, ← Category.assoc]
        rw [hrep _ (hT p σ (IsCofiltered.minToLeft l₁ l) w₁ hw₁ m₂ hm₂), eqc]
      have h2 : m₂ ≫ (wcEtToProEt Y).map w₂ = m :=
        (hC1 p σ l).unique (hT p σ (IsCofiltered.minToRight l₁ l) w₂ hw₂ m₂ hm₂) hm
      rw [h1, h2]
    obtain ⟨l', g', heq⟩ := M.eq p σ (IsCofiltered.min l₁ l) _ (w₁ ≫ e ≫ c) w₂ claim
    refine ⟨l', g' ≫ IsCofiltered.minToRight l₁ l, fun w hw => ?_⟩
    obtain ⟨⟨w', hw'⟩, -⟩ := s3 p σ g'
    have hcomp : w = w' ≫ w₂ :=
      (s3 p σ (g' ≫ IsCofiltered.minToRight l₁ l)).2 w (w' ≫ w₂) hw
        (hC p σ g' (IsCofiltered.minToRight l₁ l) w' w₂ hw' hw₂)
    have hw3 : w = (w' ≫ w₁ ≫ e) ≫ c := by
      rw [hcomp, ← heq w' hw']
      simp only [Category.assoc]
    rw [hw3, op_comp, Functor.map_comp, ConcreteCategory.comp_apply, hct, map_zero]

theorem wc_lan_affCov_cech : ∀ (Y : Scheme.{u}) (A : Y.Opens), IsAffineOpen A → ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U), wcAffCov Y A U k V f → wcCechH0 ((wcEtToProEt Y).op.lan.obj I.obj) V f ∧ wcCechAcyclic ((wcEtToProEt Y).op.lan.obj I.obj) V f :=
by
  intro Y A hA I _ U k V f hc
  obtain ⟨Pr⟩ := wc_etPres_of_affIndEt Y A hA U k V f hc.1 hc.2.1
  obtain ⟨M⟩ := wc_etModel_of_pres Y U k V f Pr
  have hL := wc_lanLevel_of_model Y I.obj U k V f M
  exact ⟨wc_lan_cechH0_of_model Y I.obj U k V f M hL
      (fun U' k' V' f' => (wc_injective_cech_acyclic (Scheme.smallEtaleTopology Y) I V' f').1),
    wc_lan_cechAcyclic_of_model Y I.obj U k V f M hL
      (fun U' k' V' f' => (wc_injective_cech_acyclic (Scheme.smallEtaleTopology Y) I V' f').2)⟩

theorem wc_epsInv_affine_vanishing : ∀ (Y : Scheme.{u}) (A : Y.Opens), IsAffineOpen A → ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk A.ι)) ((wcEpsInv Y).obj I) (n + 1)), e = 0 :=
by
  intro Y A hA I _ n e

  let P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := (wcEtToProEt Y).op.lan.obj I.obj
  have hsep : ∀ (Z : Y.ProEt) (R : Sieve Z), R ∈ Scheme.ProEt.topology Y Z →
      ∀ x : P.obj (Opposite.op Z), (∀ (W : Y.ProEt) (f : W ⟶ Z), R.arrows f → P.map f.op x = 0) →
        x = 0 :=
    fun Z R hR x hx => wc_lan_etale_separated Y I Z R hR x hx

  have hθinj : ∀ (Z : Y.ProEt) (a b : P.obj (Opposite.op Z)),
      (toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op Z) a =
        (toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op Z) b → a = b := by
    intro Z a b hab
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.ProEt.topology Y) P
    have hmem := Presheaf.IsLocallyInjective.equalizerSieve_mem
      (J := Scheme.ProEt.topology Y) (φ := toSheafify (Scheme.ProEt.topology Y) P) a b hab
    have h0 := hsep Z _ hmem (a - b) (fun W f hf => by
      have hf' : P.map f.op a = P.map f.op b := hf
      rw [map_sub, hf', sub_self])
    exact sub_eq_zero.mp h0

  have hθsurj : ∀ (X : Y.ProEt),
      (∀ (R : Sieve X), R ∈ Scheme.ProEt.topology Y X →
        ∀ (x : ∀ (W : Y.ProEt) (f : W ⟶ X), R.arrows f → P.obj (Opposite.op W)),
        (∀ (W W' : Y.ProEt) (f : W ⟶ X) (k : W' ⟶ W) (hf : R.arrows f),
          x W' (k ≫ f) (R.downward_closed hf k) = P.map k.op (x W f hf)) →
        ∃ s : P.obj (Opposite.op X), ∀ (W : Y.ProEt) (f : W ⟶ X) (hf : R.arrows f),
          P.map f.op s = x W f hf) →
      Function.Surjective ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op X)) := by
    intro X hglue s
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology Y) P
    have hR : Presheaf.imageSieve (toSheafify (Scheme.ProEt.topology Y) P) s ∈
        Scheme.ProEt.topology Y X :=
      Presheaf.IsLocallySurjective.imageSieve_mem s
    have hy : ∀ (W : Y.ProEt) (f : W ⟶ X),
        (Presheaf.imageSieve (toSheafify (Scheme.ProEt.topology Y) P) s).arrows f →
        ∃ t : P.obj (Opposite.op W), (toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op W) t =
          (sheafify (Scheme.ProEt.topology Y) P).map f.op s := fun W f hf => hf
    choose y hy' using hy
    obtain ⟨t, ht⟩ := hglue _ hR y (fun W W' f k hf => by
      apply hθinj
      rw [hy', NatTrans.naturality_apply, hy', op_comp, Functor.map_comp,
        ConcreteCategory.comp_apply])
    refine ⟨t, ?_⟩
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology Y)
        (sheafify (Scheme.ProEt.topology Y) P ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology Y) (forget AddCommGrpCat.{u+1})).obj
          ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P)).2
    apply (hsh _ hR).isSeparatedFor.ext
    intro W f hf
    change (sheafify (Scheme.ProEt.topology Y) P).map f.op
        ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op X) t) =
      (sheafify (Scheme.ProEt.topology Y) P).map f.op s
    rw [← NatTrans.naturality_apply, ht W f hf, hy']

  have hglue : ∀ (X : Y.ProEt), wcAffIndEt Y A X →
      ∀ (R : Sieve X), R ∈ Scheme.ProEt.topology Y X →
        ∀ (x : ∀ (W : Y.ProEt) (f : W ⟶ X), R.arrows f → P.obj (Opposite.op W)),
        (∀ (W W' : Y.ProEt) (f : W ⟶ X) (k : W' ⟶ W) (hf : R.arrows f),
          x W' (k ≫ f) (R.downward_closed hf k) = P.map k.op (x W f hf)) →
        ∃ s : P.obj (Opposite.op X), ∀ (W : Y.ProEt) (f : W ⟶ X) (hf : R.arrows f),
          P.map f.op s = x W f hf := by
    intro X hX R hR x hx
    have hxc : ∀ (W : Y.ProEt) (g g' : W ⟶ X) (hg : R.arrows g) (hg' : R.arrows g'), g = g' →
        x W g hg = x W g' hg' := by
      intro W g g' hg hg' h
      subst h
      rfl
    obtain ⟨k, V, f, hc, hRf⟩ := wc_affIndEt_refine Y A X hX R hR
    obtain ⟨s, hs⟩ := (wc_lan_affCov_cech Y A hA I X k V f hc).1 (fun i => x (V i) (f i) (hRf i))
      (fun σ => (hx _ _ (f (σ 0)) (Limits.WidePullback.π (fun l => f (σ l)) 0) (hRf (σ 0))).symm.trans
        ((hxc _ _ _ _ _ ((Limits.WidePullback.π_arrow (fun l => f (σ l)) 0).trans
          (Limits.WidePullback.π_arrow (fun l => f (σ l)) 1).symm)).trans
          (hx _ _ (f (σ 1)) (Limits.WidePullback.π (fun l => f (σ l)) 1) (hRf (σ 1)))))
    refine ⟨s, fun W g hg => ?_⟩
    apply sub_eq_zero.mp
    apply hsep W ((Sieve.generate (Presieve.ofArrows V f)).pullback g)
      ((Scheme.ProEt.topology Y).pullback_stable g hc.2.2.2)
    intro W' h hh
    obtain ⟨W'', a, b, hb, heq⟩ := hh
    rcases hb with ⟨i⟩
    have e1 : P.map h.op (P.map g.op s) = P.map a.op (P.map (f i).op s) := by
      rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
        ← Functor.map_comp, ← op_comp, ← op_comp, heq]
    have e2 : P.map (f i).op s = x (V i) (f i) (hRf i) := hs i
    rw [map_sub, e1, e2, ← hx _ _ _ _ (hRf i), hxc _ _ _ _ (R.downward_closed hg h) heq,
      hx _ _ _ _ hg, sub_self]

  have hθbij : ∀ (X : Y.ProEt), wcAffIndEt Y A X →
      Function.Bijective ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op X)) :=
    fun X hX => ⟨fun a b h => hθinj X a b h, hθsurj X (hglue X hX)⟩

  have hacycP : ∀ (U : Y.ProEt) (k : ℕ) (V : Fin k → Y.ProEt) (f : ∀ i, V i ⟶ U),
      wcAffCov Y A U k V f → wcCechAcyclic (sheafify (Scheme.ProEt.topology Y) P) V f := by
    intro U k V f hc p c' hc'
    have hb : ∀ (q : ℕ) (σ : Fin (q + 1) → Fin k), Function.Bijective
        ((toSheafify (Scheme.ProEt.topology Y) P).app
          (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) :=
      fun q σ => hθbij _ (wc_affCov_widePullback_mem Y A U k V f hc q σ)
    let c : ∀ τ : Fin (p + 2) → Fin k,
        P.obj (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)))) :=
      fun τ => Function.surjInv (hb (p + 1) τ).2 (c' τ)
    have hcc : ∀ τ : Fin (p + 2) → Fin k,
        (toSheafify (Scheme.ProEt.topology Y) P).app _ (c τ) = c' τ :=
      fun τ => Function.surjInv_eq (hb (p + 1) τ).2 (c' τ)
    have hcoc : ∀ ρ : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        P.map (wcCechFace V f ρ j).op (c (fun l => ρ (j.succAbove l))) = 0 := by
      intro ρ
      apply (hb (p + 2) ρ).1
      rw [map_zero, map_sum, ← hc' ρ]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_zsmul, NatTrans.naturality_apply, hcc]
    obtain ⟨b, hb'⟩ := (wc_lan_affCov_cech Y A hA I U k V f hc).2 p c hcoc
    refine ⟨fun σ => (toSheafify (Scheme.ProEt.topology Y) P).app _ (b σ), fun τ => ?_⟩
    rw [← hcc τ, ← hb' τ, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, NatTrans.naturality_apply]

  have hid : wcIndEtale (RingHom.id Γ((A : Scheme.{u}), ⊤)) := by
    unfold wcIndEtale
    rw [show (RingHom.id Γ((A : Scheme.{u}), ⊤)).toAlgebra = Algebra.id _ from
      Algebra.algebra_ext _ _ (fun _ => rfl)]
    intro Q _ _ _ h
    exact ⟨Γ((A : Scheme.{u}), ⊤), inferInstance, inferInstance, inferInstance, h,
      AlgHom.id _ _, AlgHom.id_comp h⟩
  have hbase : wcAffIndEt Y A (Scheme.ProEt.mk A.ι) := by
    refine ⟨hA, 𝟙 _, Category.id_comp _, ?_⟩
    change wcIndEtale (CommRingCat.Hom.hom (Scheme.Hom.appTop (𝟙 (A : Scheme.{u}))))
    rw [Scheme.Hom.id_appTop, CommRingCat.hom_id]
    exact hid

  exact wc_cech_criterion_ext_vanishing Y (wcAffIndEt Y A) (wcAffCov Y A)
    (fun U k V f hc => hc.2.2.2) (wc_affCov_widePullback_mem Y A) (wc_affIndEt_refine Y A)
    (fun I' _ U k V f _ => (wc_injective_cech_acyclic (Scheme.ProEt.topology Y) I' V f).2)
    ((wcEpsInv Y).obj I) hacycP (Scheme.ProEt.mk A.ι) hbase n e

theorem wc_proet_globalize_vanishing : ∀ (Y : Scheme.{u}) [CompactSpace Y] [IsSeparated (Limits.terminal.from Y)] [(wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)], (∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, IsIso ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app G)) → (∀ (A : Y.Opens), IsAffineOpen A → ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk A.ι)) ((wcEpsInv Y).obj I) (n + 1)), e = 0) → ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) ((wcEpsInv Y).obj I) (n + 1)), e = 0 :=
by
  intro Y _ _ _ hU hA I _ n e
  classical

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasWeakSheafify J AddCommGrpCat.{u+1}], ∃ e : ∀ (X : C) (F : Sheaf J AddCommGrpCat.{u+1}), ((presheafToSheaf J AddCommGrpCat.{u+1}).obj (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F) ≃ F.obj.obj (Opposite.op X), (∀ (X X' : C) (i : X' ⟶ X) (F : Sheaf J AddCommGrpCat.{u+1}) (g : (presheafToSheaf J AddCommGrpCat.{u+1}).obj (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F), e X' F ((presheafToSheaf J AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ g) = F.obj.map i.op (e X F g)) ∧ (∀ (X : C) (F : Sheaf J AddCommGrpCat.{u+1}) (g₁ g₂ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F), e X F (g₁ + g₂) = e X F g₁ + e X F g₂) := by
    intro C _ J _
    let e : ∀ (X : C) (F : Sheaf J AddCommGrpCat.{u+1}), ((presheafToSheaf J AddCommGrpCat.{u+1}).obj (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F) ≃ F.obj.obj (Opposite.op X) :=
      fun X F => ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans
        (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u}) F.obj).trans
          (uliftYonedaEquiv.{u+1} (X := X) (F := F.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ X F g, e X F g = (toSheafify J (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ g.hom).app (Opposite.op X) (FreeAbelianGroup.of (ULift.up (𝟙 X))) := fun _ _ _ => rfl
    refine ⟨e, ?_, ?_⟩
    · intro X X' i F g
      rw [he, he]
      have h1 : toSheafify J (yoneda.obj X' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ((presheafToSheaf J AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ g).hom
          = Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ toSheafify J (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ g.hom := by
        change toSheafify J _ ≫ sheafifyMap J (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ g.hom = _
        rw [← Category.assoc, ← toSheafify_naturality, Category.assoc]
      rw [h1]
      set φ := toSheafify J (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ g.hom
      have h2 : (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op X') (FreeAbelianGroup.of (ULift.up (𝟙 X')))
          = (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map i.op (FreeAbelianGroup.of (ULift.up (𝟙 X))) := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) = FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans ((congrArg FreeAbelianGroup.of ?_).trans (FreeAbelianGroup.map_of_apply _).symm)
        change ULift.up (𝟙 X' ≫ i) = ULift.up (i ≫ 𝟙 X)
        rw [Category.id_comp, Category.comp_id]
      have hn := ConcreteCategory.congr_hom (φ.naturality i.op)
        (FreeAbelianGroup.of (ULift.up (𝟙 X)) : (yoneda.obj X ⋙ uliftFunctor.{u+1,u} ⋙ AddCommGrpCat.free).obj (Opposite.op X))
      exact (congrArg (fun y => φ.app (Opposite.op X') y) h2).trans hn
    · intro X F g₁ g₂
      simp only [he, NatTrans.comp_app, Sheaf.Hom.add_app, Preadditive.comp_add]
      rfl

  have s3 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] {X X' : C} (i : X' ⟶ X), Mono i → Mono ((presheafToSheaf J AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := by
    intro C _ J _ X X' i hi
    have hinj : ∀ {α β : Type (u+1)} (φ : α → β), Function.Injective φ → Function.Injective (FreeAbelianGroup.map φ) := by
      intro α β φ hφ
      rcases isEmpty_or_nonempty α with hα | hα
      · intro x y _
        have h0 : ∀ z : FreeAbelianGroup α, z = 0 := by
          intro z
          induction z using FreeAbelianGroup.induction_on with
          | zero => rfl
          | of x => exact (IsEmpty.false x).elim
          | neg x hx => rw [hx, neg_zero]
          | add x y hx hy => rw [hx, hy, add_zero]
        rw [h0 x, h0 y]
      · have hl : Function.LeftInverse (FreeAbelianGroup.map (Function.invFun φ)) (FreeAbelianGroup.map φ) := by
          intro x
          rw [← AddMonoidHom.comp_apply, ← FreeAbelianGroup.map_comp, Function.invFun_comp hφ, FreeAbelianGroup.map_id]
          rfl
        exact hl.injective
    have hw : Mono (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      have : ∀ Z, Mono ((Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app Z) := by
        intro Z
        rw [AddCommGrpCat.mono_iff_injective]
        let φ : ULift.{u+1} (Z.unop ⟶ X') → ULift.{u+1} (Z.unop ⟶ X) := fun h => ULift.up (h.down ≫ i)
        have hφ : Function.Injective φ := fun a b h => ULift.ext _ _ ((cancel_mono i).mp (congrArg ULift.down h))
        exact hinj φ hφ
      exact NatTrans.mono_of_mono_app _
    exact Functor.map_mono _ _

  have s8sub : ∀ (W : Y.Opens) (Z : Y.ProEt) (f g : Z ⟶ Scheme.ProEt.mk W.ι), f = g := by
    intro W Z f g
    apply MorphismProperty.Over.Hom.ext
    have h1 : f.left ≫ W.ι = g.left ≫ W.ι := (MorphismProperty.Over.w f).trans (MorphismProperty.Over.w g).symm
    exact (cancel_mono W.ι).mp h1
  have s8ex : ∀ (W : Y.Opens) (Z : Y.ProEt), Set.range Z.hom ⊆ (W : Set Y) → Nonempty (Z ⟶ Scheme.ProEt.mk W.ι) := by
    intro W Z h
    have hr : Set.range Z.hom ⊆ Set.range W.ι := h.trans (Scheme.Opens.range_ι W).ge
    let k : Z.left ⟶ (W : Scheme.{u}) := IsOpenImmersion.lift W.ι Z.hom hr
    have hk : k ≫ W.ι = Z.hom := IsOpenImmersion.lift_fac _ _ _
    exact ⟨MorphismProperty.Over.homMk (B := Scheme.ProEt.mk W.ι) k hk trivial⟩
  have s8et : ∀ (W : Y.Opens) (Z : Y.Etale) (f g : Z ⟶ Scheme.Etale.mk W.ι), f = g := by
    intro W Z f g
    apply MorphismProperty.Over.Hom.ext
    have h1 : f.left ≫ W.ι = g.left ≫ W.ι := (MorphismProperty.Over.w f).trans (MorphismProperty.Over.w g).symm
    exact (cancel_mono W.ι).mp h1
  have hrange : ∀ (W : Y.Opens) (Z : Y.ProEt) (g : Z ⟶ Scheme.ProEt.mk W.ι) (x : Z.left), Z.hom x ∈ W := by
    intro W Z g x
    rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]
    have h := Set.mem_range_self (f := W.ι) (g.left x)
    rw [Scheme.Opens.range_ι] at h
    exact h

  have s4 : ∀ (T : Y.ProEt) (U V : Y.Opens), (∀ x, T.hom x ∈ U ⊔ V) → ∀ (R : Sieve T), (∀ (T' : Y.ProEt) (f : T' ⟶ T), ((∀ x, T'.hom x ∈ U) ∨ (∀ x, T'.hom x ∈ V)) → R.arrows f) → R ∈ Scheme.ProEt.topology Y T := by
    intro T U V hT R hR0
    let O : ULift.{u+1} Bool → T.left.Opens := fun i => if i.down then T.hom ⁻¹ᵁ U else T.hom ⁻¹ᵁ V
    have := T.prop
    let W : ULift.{u+1} Bool → Y.ProEt := fun i => Scheme.ProEt.mk ((O i).ι ≫ T.hom)
    let f : ∀ i, W i ⟶ T := fun i => MorphismProperty.Over.homMk (O i).ι rfl trivial
    have hcov : ∀ x : ↥T.left, ∃ (i : ULift.{u+1} Bool) (y : ↥(O i).toScheme), (O i).ι y = x := by
      intro x
      have hx := hT x
      rw [TopologicalSpace.Opens.mem_sup] at hx
      rcases hx with hx | hx
      · exact ⟨ULift.up true, ⟨x, hx⟩, Scheme.Opens.ι_apply _ _⟩
      · exact ⟨ULift.up false, ⟨x, hx⟩, Scheme.Opens.ι_apply _ _⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} Bool)
        (fun i => (O i).toScheme) (fun i => (O i).ι) hcov (fun i => inferInstance)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun i => (Scheme.Hom.isOpenEmbedding (O i).ι).isOpenMap)
    have hR : Presieve.ofArrows (fun i : ULift.{u+1} Bool => (O i).toScheme)
        (fun i => (O i).ι) ∈ Scheme.proetalePrecoverage.coverings T.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) (Y := W) f
    have hR' : Presieve.ofArrows W f ∈ (Scheme.ProEt.precoverage Y).coverings T :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR)
    have hRJ : Sieve.generate (Presieve.ofArrows W f) ∈ (Scheme.ProEt.topology Y) T :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine (Scheme.ProEt.topology Y).superset_covering ?_ hRJ
    rintro V' g ⟨W', h, f', hf', rfl⟩
    rcases hf' with ⟨i⟩
    apply R.downward_closed
    apply hR0
    rcases i with ⟨b⟩
    cases b
    · right
      intro x
      let y : ↥(O (ULift.up false)) := x
      change T.hom ((O (ULift.up false)).ι y) ∈ V
      have h2 := Scheme.Opens.ι_apply (O (ULift.up false)) y
      rw [h2]
      exact y.2
    · left
      intro x
      let y : ↥(O (ULift.up true)) := x
      change T.hom ((O (ULift.up true)).ι y) ∈ U
      have h2 := Scheme.Opens.ι_apply (O (ULift.up true)) y
      rw [h2]
      exact y.2

  have s5 : ∀ {W₀ W₁ W₂ W : Y.ProEt} (a : W₀ ⟶ W₁) (b : W₀ ⟶ W₂) (c : W₁ ⟶ W) (d : W₂ ⟶ W), Mono c → Mono d → (∀ (Z : Y.ProEt) (g₁ : Z ⟶ W₁) (g₂ : Z ⟶ W₂), g₁ ≫ c = g₂ ≫ d → ∃ k : Z ⟶ W₀, k ≫ a = g₁ ∧ k ≫ b = g₂) → (∀ R : Sieve W, R.arrows c → R.arrows d → R ∈ Scheme.ProEt.topology Y W) → ∀ (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (s₁ : F.obj.obj (Opposite.op W₁)) (s₂ : F.obj.obj (Opposite.op W₂)), F.obj.map a.op s₁ = F.obj.map b.op s₂ → ∃! t : F.obj.obj (Opposite.op W), F.obj.map c.op t = s₁ ∧ F.obj.map d.op t = s₂ := by
    intro W₀ W₁ W₂ W a b c d hc hd hpb hcov F s₁ s₂ hab
    let P : Y.ProEtᵒᵖ ⥤ Type (u+1) := F.obj ⋙ forget AddCommGrpCat.{u+1}
    have hP : Presieve.IsSheaf (Scheme.ProEt.topology Y) P :=
      (isSheaf_iff_isSheaf_of_type _ P).mp ((Presheaf.isSheaf_iff_isSheaf_forget _ F.obj (forget AddCommGrpCat.{u+1})).mp F.property)
    let X : Bool → Y.ProEt := fun i => Bool.casesOn i W₂ W₁
    let π : (i : Bool) → X i ⟶ W := fun i => Bool.casesOn (motive := fun i => X i ⟶ W) i d c
    have hR : Sieve.generate (Presieve.ofArrows X π) ∈ Scheme.ProEt.topology Y W := by
      apply hcov
      · exact Sieve.le_generate _ _ _ (Presieve.ofArrows.mk true)
      · exact Sieve.le_generate _ _ _ (Presieve.ofArrows.mk false)
    have hsf := (Presieve.isSheafFor_arrows_iff P π).mp (hP.isSheafFor _ hR)
    let x : (i : Bool) → P.obj (Opposite.op (X i)) := fun i => Bool.casesOn (motive := fun i => P.obj (Opposite.op (X i))) i s₂ s₁
    have key : ∀ (Z : Y.ProEt) (g₁ : Z ⟶ W₁) (g₂ : Z ⟶ W₂), g₁ ≫ c = g₂ ≫ d → F.obj.map g₁.op s₁ = F.obj.map g₂.op s₂ := by
      intro Z g₁ g₂ h
      obtain ⟨k, hk1, hk2⟩ := hpb Z g₁ g₂ h
      rw [← hk1, ← hk2, op_comp, op_comp, Functor.map_comp, Functor.map_comp, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, hab]
    have hcomp : Presieve.Arrows.Compatible P π x := by
      intro i j Z gi gj h
      cases i <;> cases j
      · have : gi = gj := (cancel_mono d).mp h
        rw [this]
      · exact (key Z gj gi h.symm).symm
      · exact key Z gi gj h
      · have : gi = gj := (cancel_mono c).mp h
        rw [this]
    obtain ⟨t, ht, huniq⟩ := hsf x hcomp
    refine ⟨t, ⟨ht true, ht false⟩, fun t' ht' => huniq t' ?_⟩
    intro i
    cases i
    · exact ht'.2
    · exact ht'.1

  have s6 : ∀ (H : Y.ProEt → Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (hm : ∀ {X X' : Y.ProEt}, (X' ⟶ X) → (H X' ⟶ H X))
      (hcomp : ∀ {X X' X'' : Y.ProEt} (i : X'' ⟶ X') (j : X' ⟶ X), hm i ≫ hm j = hm (i ≫ j))
      (e : ∀ (X : Y.ProEt) (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}), (H X ⟶ F) ≃ F.obj.obj (Opposite.op X))
      (hnat : ∀ (X X' : Y.ProEt) (i : X' ⟶ X) (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (g : H X ⟶ F), e X' F (hm i ≫ g) = F.obj.map i.op (e X F g))
      (hadd : ∀ (X : Y.ProEt) (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (g₁ g₂ : H X ⟶ F), e X F (g₁ + g₂) = e X F g₁ + e X F g₂)
      {W₀ W₁ W₂ W : Y.ProEt} (a : W₀ ⟶ W₁) (b : W₀ ⟶ W₂) (c : W₁ ⟶ W) (d : W₂ ⟶ W)
      (hma : Mono (hm a)) (hac : a ≫ c = b ≫ d)
      (hglue : ∀ (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (s₁ : F.obj.obj (Opposite.op W₁)) (s₂ : F.obj.obj (Opposite.op W₂)), F.obj.map a.op s₁ = F.obj.map b.op s₂ → ∃! t : F.obj.obj (Opposite.op W), F.obj.map c.op t = s₁ ∧ F.obj.map d.op t = s₂),
      ∃ hz : Limits.biprod.lift (hm a) (hm b) ≫ Limits.biprod.desc (hm c) (-hm d) = 0,
        (ShortComplex.mk _ _ hz).ShortExact := by
    intro H hm hcomp e hnat hadd W₀ W₁ W₂ W a b c d hma hac hglue
    have he0 : ∀ X F, e X F 0 = 0 := by
      intro X F
      have h := hadd X F 0 0
      rw [add_zero] at h
      exact left_eq_add.mp h
    have heneg : ∀ X F (g : H X ⟶ F), e X F (-g) = - e X F g := by
      intro X F g
      have h := hadd X F g (-g)
      rw [add_neg_cancel, he0] at h
      exact (neg_eq_of_add_eq_zero_right h.symm).symm
    have hz : Limits.biprod.lift (hm a) (hm b) ≫ Limits.biprod.desc (hm c) (-hm d) = 0 := by
      rw [Limits.biprod.lift_desc, Preadditive.comp_neg, hcomp, hcomp, hac, add_neg_cancel]
    refine ⟨hz, ?_⟩
    have hmono : Mono (Limits.biprod.lift (hm a) (hm b)) := by
      have := hma
      exact mono_of_mono_fac (Limits.biprod.lift_fst (hm a) (hm b))
    have hcompat : ∀ {Z : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (φ : H W₁ ⊞ H W₂ ⟶ Z), Limits.biprod.lift (hm a) (hm b) ≫ φ = 0 →
        Z.obj.map a.op (e W₁ Z (Limits.biprod.inl ≫ φ)) = Z.obj.map b.op (-(e W₂ Z (Limits.biprod.inr ≫ φ))) := by
      intro Z φ hφ
      rw [← hnat, map_neg, ← hnat]
      have h0 : e W₀ Z (Limits.biprod.lift (hm a) (hm b) ≫ φ) = 0 := by rw [hφ, he0]
      rw [Limits.biprod.lift_eq, Preadditive.add_comp, Category.assoc, Category.assoc, hadd] at h0
      exact eq_neg_of_add_eq_zero_left h0
    let desc : ∀ {Z : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (φ : H W₁ ⊞ H W₂ ⟶ Z), Limits.biprod.lift (hm a) (hm b) ≫ φ = 0 → (H W ⟶ Z) :=
      fun {Z} φ hφ => (e W Z).symm (hglue Z _ _ (hcompat φ hφ)).exists.choose
    have hdesc : ∀ {Z : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (φ : H W₁ ⊞ H W₂ ⟶ Z) (hφ : Limits.biprod.lift (hm a) (hm b) ≫ φ = 0),
        Z.obj.map c.op (e W Z (desc φ hφ)) = e W₁ Z (Limits.biprod.inl ≫ φ) ∧
        Z.obj.map d.op (e W Z (desc φ hφ)) = -(e W₂ Z (Limits.biprod.inr ≫ φ)) := by
      intro Z φ hφ
      simp only [desc, Equiv.apply_symm_apply]
      exact (hglue Z _ _ (hcompat φ hφ)).exists.choose_spec
    have hcok : Limits.IsColimit (Limits.CokernelCofork.ofπ (Limits.biprod.desc (hm c) (-hm d)) hz) := by
      refine Limits.CokernelCofork.IsColimit.ofπ _ hz (fun φ hφ => desc φ hφ) ?_ ?_
      · intro Z φ hφ
        obtain ⟨h1, h2⟩ := hdesc φ hφ
        apply Limits.biprod.hom_ext'
        · rw [Limits.biprod.inl_desc_assoc]
          apply (e W₁ Z).injective
          rw [hnat, h1]
        · rw [Limits.biprod.inr_desc_assoc]
          apply (e W₂ Z).injective
          rw [Preadditive.neg_comp, heneg, hnat, h2, neg_neg]
      · intro Z φ hφ m hm'
        obtain ⟨h1, h2⟩ := hdesc φ hφ
        apply (e W Z).injective
        refine (hglue Z _ _ (hcompat φ hφ)).unique ⟨?_, ?_⟩ ⟨h1, h2⟩
        · rw [← hnat, ← hm', Limits.biprod.inl_desc_assoc]
        · rw [← hnat, ← hm', Limits.biprod.inr_desc_assoc, Preadditive.neg_comp, heneg, neg_neg]
    obtain ⟨hex, hepi⟩ := (ShortComplex.exact_and_epi_g_iff_g_is_cokernel (ShortComplex.mk _ _ hz)).mpr ⟨hcok⟩
    exact ShortComplex.ShortExact.mk' hex hmono hepi

  have s1 : ∀ {A B₁ B₂ W G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f₁ : A ⟶ B₁) (f₂ : A ⟶ B₂) (g : B₁ ⊞ B₂ ⟶ W) (hz : Limits.biprod.lift f₁ f₂ ≫ g = 0), (ShortComplex.mk _ g hz).ShortExact → (∀ (n : ℕ) (e : Abelian.Ext A G (n + 1)), e = 0) → (∀ (n : ℕ) (e : Abelian.Ext B₁ G (n + 1)), e = 0) → (∀ (n : ℕ) (e : Abelian.Ext B₂ G (n + 1)), e = 0) → (∀ y : A ⟶ G, ∃ z : B₁ ⟶ G, f₁ ≫ z = y) → ∀ (n : ℕ) (e : Abelian.Ext W G (n + 1)), e = 0 := by
    intro A B₁ B₂ W G f₁ f₂ g hz hS hA0 hB₁ hB₂ hsurj n e
    have hmid : ∀ x : Abelian.Ext (B₁ ⊞ B₂) G (n + 1), x = 0 := by
      intro x
      have h1 : (Abelian.Ext.mk₀ (Limits.biprod.inl : B₁ ⟶ B₁ ⊞ B₂)).comp x (zero_add _) = 0 := hB₁ n _
      have h2 : (Abelian.Ext.mk₀ (Limits.biprod.inr : B₂ ⟶ B₁ ⊞ B₂)).comp x (zero_add _) = 0 := hB₂ n _
      calc x = (Abelian.Ext.mk₀ (𝟙 (B₁ ⊞ B₂))).comp x (zero_add _) := (Abelian.Ext.mk₀_id_comp x).symm
        _ = (Abelian.Ext.mk₀ Limits.biprod.fst).comp ((Abelian.Ext.mk₀ Limits.biprod.inl).comp x (zero_add _)) (zero_add _) + (Abelian.Ext.mk₀ Limits.biprod.snd).comp ((Abelian.Ext.mk₀ Limits.biprod.inr).comp x (zero_add _)) (zero_add _) := by
            rw [← Limits.biprod.total, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp,
              ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀,
              Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega),
              Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)]
        _ = 0 := by rw [h1, h2, Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
    set S := ShortComplex.mk _ g hz with hSdef
    have h0 : (Abelian.Ext.mk₀ S.g).comp e (zero_add _) = 0 := hmid _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS G e h0 (show 1 + n = n + 1 by omega)
    rw [← hx₁]
    cases n with
    | succ k =>
      rw [hA0 k x₁, Abelian.Ext.comp_zero]
    | zero =>
      obtain ⟨z, hz'⟩ := hsurj (Abelian.Ext.homEquiv₀ x₁)
      have hx : x₁ = (Abelian.Ext.mk₀ S.f).comp (Abelian.Ext.mk₀ (Limits.biprod.fst ≫ z)) (add_zero 0) := by
        rw [Abelian.Ext.mk₀_comp_mk₀]
        have : S.f ≫ Limits.biprod.fst ≫ z = Abelian.Ext.homEquiv₀ x₁ := by
          show Limits.biprod.lift f₁ f₂ ≫ Limits.biprod.fst ≫ z = _
          rw [Limits.biprod.lift_fst_assoc, hz']
        rw [this, Abelian.Ext.mk₀_homEquiv₀_apply]
      rw [hx, ← Abelian.Ext.comp_assoc hS.extClass (Abelian.Ext.mk₀ S.f) _ (add_zero 1) (add_zero 0) (by omega),
        ShortComplex.ShortExact.extClass_comp, Abelian.Ext.zero_comp]

  have s7 : ∀ {T T' : Y.Etale} (i : T' ⟶ T), Function.Surjective (I.obj.map i.op) → Function.Surjective (((wcEpsInv Y).obj I).obj.map ((wcEtToProEt Y).map i).op) := by
    intro T T' i hsurj
    set η := (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).unit.app I with hη
    haveI := hU I
    haveI : IsIso η.hom := (sheafToPresheaf _ _).map_isIso η
    haveI : IsIso (η.hom.app (Opposite.op T')) := inferInstance
    have hbij : Function.Bijective (η.hom.app (Opposite.op T')) := ConcreteCategory.bijective_of_isIso _
    intro y
    obtain ⟨x, rfl⟩ := hbij.2 y
    obtain ⟨z, rfl⟩ := hsurj x
    refine ⟨η.hom.app (Opposite.op T) z, ?_⟩
    have hn := ConcreteCategory.congr_hom (η.hom.naturality i.op) z
    exact hn.symm

  obtain ⟨eP, hnatP, haddP⟩ := s2 (Scheme.ProEt.topology Y)
  obtain ⟨eE, hnatE, haddE⟩ := s2 (Scheme.smallEtaleTopology Y)

  have s11 : ∀ {X X' : Y.Etale} (i : X' ⟶ X), Mono i → Function.Surjective (I.obj.map i.op) := by
    intro X X' i hi s
    haveI := s3 (Scheme.smallEtaleTopology Y) i hi
    refine ⟨eE X I (Injective.factorThru ((eE X' I).symm s) ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))), ?_⟩
    rw [← hnatE, Injective.comp_factorThru, Equiv.apply_symm_apply]

  let 𝒢 := (wcEpsInv Y).obj I
  let Hp : Y.Opens → Prop := fun W => ∀ (n : ℕ) (e : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk W.ι)) 𝒢 (n + 1)), e = 0

  have s9 : (∀ A : Y.Opens, IsAffineOpen A → Hp A) → (∀ A V : Y.Opens, IsAffineOpen A → Hp V → Hp (A ⊓ V) → Hp (A ⊔ V)) → Hp ⊤ := by
    intro hA' hstep
    have key : ∀ k : ℕ, ∀ t : Finset Y.Opens, t.card ≤ k → (∀ B ∈ t, IsAffineOpen B) → Hp (t.sup id) := by
      intro k
      induction k with
      | zero =>
        intro t ht _
        rw [Finset.card_eq_zero.mp (Nat.le_zero.mp ht), Finset.sup_empty]
        exact hA' ⊥ (isAffineOpen_bot Y)
      | succ k ih =>
        intro t ht hta
        rcases t.eq_empty_or_nonempty with h | ⟨A, hAt⟩
        · rw [h, Finset.sup_empty]; exact hA' ⊥ (isAffineOpen_bot Y)
        · have e1 : t.sup id = A ⊔ (t.erase A).sup id := by
            conv_lhs => rw [← Finset.insert_erase hAt]
            rw [Finset.sup_insert]; rfl
          have hc : (t.erase A).card ≤ k := by rw [Finset.card_erase_of_mem hAt]; omega
          have hta' : ∀ B ∈ t.erase A, IsAffineOpen B := fun B hB => hta B (Finset.mem_of_mem_erase hB)
          have hAaff : IsAffineOpen A := hta A hAt
          have e2 : A ⊓ (t.erase A).sup id = ((t.erase A).image (fun B => A ⊓ B)).sup id := by
            rw [Finset.sup_inf_distrib_left, Finset.sup_image]; rfl
          rw [e1]
          apply hstep A _ hAaff (ih _ hc hta')
          rw [e2]
          apply ih _ (Finset.card_image_le.trans hc)
          intro B hB
          obtain ⟨B', hB', rfl⟩ := Finset.mem_image.mp hB
          exact hAaff.inf (hta' B' hB')
    have hcpt : IsCompact ((⊤ : Y.Opens) : Set Y) := by
      rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
    obtain ⟨s, hs, hsU⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hcpt
    let t := hs.toFinset.image (fun i : Y.affineOpens => (i : Y.Opens))
    have ht : t.sup id = ⊤ := by
      rw [Finset.sup_image, Finset.sup_eq_iSup, hsU]
      simp [Set.Finite.mem_toFinset]
    rw [← ht]
    refine key _ t le_rfl ?_
    intro B hB
    obtain ⟨B', _, rfl⟩ := Finset.mem_image.mp hB
    exact B'.2
  have htop : Hp ⊤ := by
    apply s9 (fun A hA' n e => hA A hA' I n e)

    intro A V hAaff hV hAV
    let a : Scheme.ProEt.mk (A ⊓ V).ι ⟶ Scheme.ProEt.mk A.ι :=
      MorphismProperty.Over.homMk (Y.homOfLE (inf_le_left : A ⊓ V ≤ A)) (Y.homOfLE_ι _) trivial
    let b : Scheme.ProEt.mk (A ⊓ V).ι ⟶ Scheme.ProEt.mk V.ι :=
      MorphismProperty.Over.homMk (Y.homOfLE (inf_le_right : A ⊓ V ≤ V)) (Y.homOfLE_ι _) trivial
    let c : Scheme.ProEt.mk A.ι ⟶ Scheme.ProEt.mk (A ⊔ V).ι :=
      MorphismProperty.Over.homMk (Y.homOfLE (le_sup_left : A ≤ A ⊔ V)) (Y.homOfLE_ι _) trivial
    let d : Scheme.ProEt.mk V.ι ⟶ Scheme.ProEt.mk (A ⊔ V).ι :=
      MorphismProperty.Over.homMk (Y.homOfLE (le_sup_right : V ≤ A ⊔ V)) (Y.homOfLE_ι _) trivial
    let a' : Scheme.Etale.mk (A ⊓ V).ι ⟶ Scheme.Etale.mk A.ι :=
      MorphismProperty.Over.homMk (Y.homOfLE (inf_le_left : A ⊓ V ≤ A)) (Y.homOfLE_ι _) trivial
    have hmonoc : Mono c := ⟨fun g h _ => s8sub _ _ g h⟩
    have hmonod : Mono d := ⟨fun g h _ => s8sub _ _ g h⟩
    have hmonoa : Mono a := ⟨fun g h _ => s8sub _ _ g h⟩
    have hmonoa' : Mono a' := ⟨fun g h _ => s8et _ _ g h⟩
    have hpb : ∀ (Z : Y.ProEt) (g₁ : Z ⟶ Scheme.ProEt.mk A.ι) (g₂ : Z ⟶ Scheme.ProEt.mk V.ι), g₁ ≫ c = g₂ ≫ d → ∃ k : Z ⟶ Scheme.ProEt.mk (A ⊓ V).ι, k ≫ a = g₁ ∧ k ≫ b = g₂ := by
      intro Z g₁ g₂ _
      have hsub : Set.range Z.hom ⊆ ((A ⊓ V : Y.Opens) : Set Y) := by
        rintro _ ⟨x, rfl⟩
        exact ⟨hrange A Z g₁ x, hrange V Z g₂ x⟩
      obtain ⟨k⟩ := s8ex (A ⊓ V) Z hsub
      exact ⟨k, s8sub _ _ _ _, s8sub _ _ _ _⟩
    have hcovR : ∀ R : Sieve (Scheme.ProEt.mk (A ⊔ V).ι), R.arrows c → R.arrows d → R ∈ Scheme.ProEt.topology Y (Scheme.ProEt.mk (A ⊔ V).ι) := by
      intro R hc hd
      apply s4 (Scheme.ProEt.mk (A ⊔ V).ι) A V (fun x => hrange (A ⊔ V) (Scheme.ProEt.mk (A ⊔ V).ι) (𝟙 _) x) R
      intro T' f hT'
      rcases hT' with hT' | hT'
      · obtain ⟨k⟩ := s8ex A T' (by rintro _ ⟨x, rfl⟩; exact hT' x)
        rw [s8sub _ _ f (k ≫ c)]
        exact R.downward_closed hc k
      · obtain ⟨k⟩ := s8ex V T' (by rintro _ ⟨x, rfl⟩; exact hT' x)
        rw [s8sub _ _ f (k ≫ d)]
        exact R.downward_closed hd k
    have hglue := s5 a b c d hmonoc hmonod hpb hcovR
    let hm : ∀ {X X' : Y.ProEt}, (X' ⟶ X) → (wcFreeSheaf Y X' ⟶ wcFreeSheaf Y X) :=
      fun i => (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    have hcomp : ∀ {X X' X'' : Y.ProEt} (i : X'' ⟶ X') (j : X' ⟶ X), hm i ≫ hm j = hm (i ≫ j) := by
      intro X X' X'' i j
      have h := (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map_comp
        (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (Functor.whiskerRight (yoneda.map j) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      exact h.symm
    have hma : Mono (hm a) := s3 (Scheme.ProEt.topology Y) a hmonoa
    have hac : a ≫ c = b ≫ d := s8sub _ _ _ _
    obtain ⟨hz, hSE⟩ := s6 (fun X => wcFreeSheaf Y X) hm hcomp eP (fun X X' i F g => hnatP X X' i F g) haddP a b c d hma hac hglue
    have hsurjA : Function.Surjective (𝒢.obj.map a.op) := s7 a' (s11 a' hmonoa')
    have hdeg0 : ∀ y : wcFreeSheaf Y (Scheme.ProEt.mk (A ⊓ V).ι) ⟶ 𝒢, ∃ z : wcFreeSheaf Y (Scheme.ProEt.mk A.ι) ⟶ 𝒢, hm a ≫ z = y := by
      intro y
      obtain ⟨σ', hσ'⟩ := hsurjA (eP _ 𝒢 y)
      refine ⟨(eP _ 𝒢).symm σ', ?_⟩
      apply (eP _ 𝒢).injective
      refine (hnatP (Scheme.ProEt.mk A.ι) (Scheme.ProEt.mk (A ⊓ V).ι) a 𝒢 ((eP _ 𝒢).symm σ')).trans ?_
      rw [Equiv.apply_symm_apply, hσ']
    exact s1 (hm a) (hm b) _ hz hSE hAV (fun n e => hA A hAaff I n e) hV hdeg0

  have hsub1 : ∀ (f g : Scheme.ProEt.mk (⊤ : Y.Opens).ι ⟶ Scheme.ProEt.mk (⊤ : Y.Opens).ι), f = g := s8sub _ _
  have hsub2 : ∀ (f g : Scheme.ProEt.mk (𝟙 Y) ⟶ Scheme.ProEt.mk (𝟙 Y)), f = g := by
    intro f g
    apply MorphismProperty.Over.Hom.ext
    have h1 : f.left ≫ 𝟙 Y = g.left ≫ 𝟙 Y := (MorphismProperty.Over.w f).trans (MorphismProperty.Over.w g).symm
    exact (cancel_mono (𝟙 Y)).mp h1
  let p : Scheme.ProEt.mk (⊤ : Y.Opens).ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk (⊤ : Y.Opens).ι (Category.comp_id _) trivial
  have hr : Set.range (𝟙 Y : Y ⟶ Y) ⊆ Set.range (⊤ : Y.Opens).ι := fun x _ => (Scheme.Opens.range_ι (⊤ : Y.Opens)).ge trivial
  let k : (Y : Scheme.{u}) ⟶ ((⊤ : Y.Opens) : Scheme.{u}) := IsOpenImmersion.lift (⊤ : Y.Opens).ι (𝟙 Y) hr
  have hk : k ≫ (⊤ : Y.Opens).ι = 𝟙 Y := IsOpenImmersion.lift_fac _ _ _
  let q : Scheme.ProEt.mk (𝟙 Y) ⟶ Scheme.ProEt.mk (⊤ : Y.Opens).ι :=
    MorphismProperty.Over.homMk k hk trivial
  let iso : Scheme.ProEt.mk (⊤ : Y.Opens).ι ≅ Scheme.ProEt.mk (𝟙 Y) :=
    { hom := p, inv := q, hom_inv_id := hsub1 _ _, inv_hom_id := hsub2 _ _ }
  let ψ : wcFreeSheaf Y (Scheme.ProEt.mk (⊤ : Y.Opens).ι) ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) :=
    (yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1,u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).mapIso iso
  have h0 : (Abelian.Ext.mk₀ ψ.hom).comp e (zero_add (n + 1)) = 0 := htop n _
  calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
    _ = ((Abelian.Ext.mk₀ ψ.inv).comp (Abelian.Ext.mk₀ ψ.hom) (add_zero 0)).comp e
          (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
    _ = (Abelian.Ext.mk₀ ψ.inv).comp ((Abelian.Ext.mk₀ ψ.hom).comp e (zero_add (n + 1)))
          (zero_add (n + 1)) :=
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
    _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

theorem wc_ext_transfer_exact : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C] {D : Type*} [Category D] [Abelian D] [HasExt D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] (X : C), (∀ Y : C, Function.Bijective (fun f : X ⟶ Y => F.map f)) → (∀ (I : C) [Injective I] (n : ℕ) (e : Abelian.Ext (F.obj X) (F.obj I) (n + 1)), e = 0) → ∀ (Y : C) (n : ℕ), Function.Bijective (Abelian.Ext.mapExactFunctor F (X := X) (Y := Y) (n := n)) :=
by
  intro C _ _ _ _ D _ _ _ F _ _ _ X ha hb
  have key : ∀ (n : ℕ) (Y : C),
      Function.Bijective (Abelian.Ext.mapExactFunctor F (X := X) (Y := Y) (n := n)) := by
    intro n
    induction n with
    | zero =>
      intro Y
      constructor
      · intro x₁ x₂ h
        have e1 := Abelian.Ext.mk₀_homEquiv₀_apply x₁
        have e2 := Abelian.Ext.mk₀_homEquiv₀_apply x₂
        rw [← e1, ← e2, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀] at h
        have h1 := (Abelian.Ext.mk₀_bijective _ _).1 h
        have h2 : Abelian.Ext.homEquiv₀ x₁ = Abelian.Ext.homEquiv₀ x₂ := (ha Y).1 h1
        rw [← e1, ← e2, h2]
      · intro z'
        obtain ⟨f, hf⟩ := (ha Y).2 (Abelian.Ext.homEquiv₀ z')
        refine ⟨Abelian.Ext.mk₀ f, ?_⟩
        rw [Abelian.Ext.mapExactFunctor_mk₀]
        simp only at hf
        rw [hf, Abelian.Ext.mk₀_homEquiv₀_apply]
    | succ n ih =>
      intro Y
      let ι := Injective.ι Y
      let S : ShortComplex C :=
        ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hFS : (S.map F).ShortExact := hS.map_of_exact F
      haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under Y))
      have bridge : ∀ w : Abelian.Ext X S.X₃ n,
          Abelian.Ext.mapExactFunctor F (w.comp hS.extClass rfl) =
            (Abelian.Ext.mapExactFunctor F w).comp hFS.extClass rfl := by
        intro w
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass]
      constructor
      · let Φ : Abelian.Ext X Y (n + 1) →+ Abelian.Ext (F.obj X) (F.obj Y) (n + 1) :=
          AddMonoidHom.mk' (Abelian.Ext.mapExactFunctor F)
            (Abelian.Ext.mapExactFunctor_add F X Y (n + 1))
        have hker : ∀ z : Abelian.Ext X Y (n + 1), Abelian.Ext.mapExactFunctor F z = 0 →
            z = 0 := by
          intro z hz
          have h0 : z.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS z h0 (n₀ := n) rfl
          have h1 : (Abelian.Ext.mapExactFunctor F w).comp hFS.extClass rfl = 0 := by
            rw [← bridge, hw]; exact hz
          obtain ⟨v', hv'⟩ := Abelian.Ext.covariant_sequence_exact₃ (F.obj X) hFS
            (Abelian.Ext.mapExactFunctor F w) rfl h1
          obtain ⟨v, hv⟩ := (ih S.X₂).2 v'
          have hw2 : w = v.comp (Abelian.Ext.mk₀ S.g) (add_zero n) := by
            apply (ih S.X₃).1
            rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, hv]
            exact hv'.symm
          rw [← hw, hw2, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
            hS.comp_extClass, Abelian.Ext.comp_zero]
        intro z₁ z₂ h
        rw [← sub_eq_zero]
        apply hker
        have hsub := map_sub Φ z₁ z₂
        change Abelian.Ext.mapExactFunctor F (z₁ - z₂) =
          Abelian.Ext.mapExactFunctor F z₁ - Abelian.Ext.mapExactFunctor F z₂ at hsub
        rw [hsub, h, sub_self]
      · intro z'
        have h0 : z'.comp (Abelian.Ext.mk₀ (S.map F).f) (add_zero _) = 0 :=
          hb (Injective.under Y) n _
        obtain ⟨w', hw'⟩ :=
          Abelian.Ext.covariant_sequence_exact₁ (F.obj X) hFS z' h0 (n₀ := n) rfl
        obtain ⟨w, hw⟩ := (ih S.X₃).2 w'
        refine ⟨w.comp hS.extClass rfl, ?_⟩
        rw [bridge, hw, hw']
  exact fun Y n => key n Y

theorem wc_proet_etale_comparison_zmod : ∀ (K : Type u) [Field K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (m : ℕ) (i : ℕ),
    Nonempty (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y m) i ≃
      wcEtCoh Y m i) :=
by
  intro K _ Y f _ m i

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsSeparated (Limits.terminal.from Y) := by
    have e : Limits.terminal.from Y = f ≫ Limits.terminal.from (Spec (.of K)) :=
      Limits.terminal.hom_ext _ _
    rw [e]; infer_instance

  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hlim
  haveI := hcont
  haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
    haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    exact Limits.preservesFiniteLimits_of_natIso
      (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
  haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
  haveI : (wcEpsInv Y).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI hadd : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives

  have hunit := fun G => wc_epsInv_unit_iso Y G
  haveI : ∀ G, IsIso (adj.unit.app G) := hunit
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  let Zet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Λet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
  have ha : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : Zet ⟶ G => (wcEpsInv Y).map g) :=
    fun G => (adj.fullyFaithfulLOfIsIsoUnit).map_bijective Zet G

  let ψ : (wcEpsInv Y).obj Zet ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) :=
    (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} ℤ))).some ≪≫
      (wc_free_terminal_const Y).some.symm
  let χ : (wcEpsInv Y).obj Λet ≅ wcZModSheaf Y m :=
    (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).some ≪≫
      (wc_zmod_sheaf_const Y m).some.symm
  have hb : ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ)
      (e : Abelian.Ext ((wcEpsInv Y).obj Zet) ((wcEpsInv Y).obj I) (n + 1)), e = 0 := by
    intro I _ n e
    have h0 : (Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)) = 0 :=
      wc_proet_globalize_vanishing Y hunit (wc_epsInv_affine_vanishing Y) I n _
    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ ψ.hom).comp (Abelian.Ext.mk₀ ψ.inv) (add_zero 0)).comp e
            (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ ψ.hom).comp ((Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)))
            (zero_add (n + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

  have hΦ := wc_ext_transfer_exact (wcEpsInv Y) Zet ha hb Λet i
  let Φ := Equiv.ofBijective _ hΦ

  have pre : ∀ {A A' B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : A ≅ A'),
      Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A' B i) := by
    intro A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add i)
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add i)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A B' i) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E1⟩ := pre (B := wcZModSheaf Y m) ψ.symm
  obtain ⟨E2⟩ := post (A := (wcEpsInv Y).obj Zet) χ.symm
  exact ⟨E1.trans (E2.trans Φ.symm)⟩

theorem wc_et_coh_coeff_devissage : ∀ (Y : Scheme.{u}) (m : ℕ), m ≠ 0 →
    (∀ p : ℕ, p.Prime → p ∣ m → ∀ i : ℕ, Finite (wcEtCoh Y p i)) →
    ∀ i : ℕ, Finite (wcEtCoh Y m i) :=
by
  intro Y
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})), S.ShortExact →
      ∀ n : ℕ, Finite (Abelian.Ext X S.X₁ n) → Finite (Abelian.Ext X S.X₃ n) →
        Finite (Abelian.Ext X S.X₂ n) := by
    intro X S hS n h1 h3
    let ψ : Abelian.Ext X S.X₂ n →+ Abelian.Ext X S.X₃ n :=
      (Abelian.Ext.mk₀ S.g).postcomp X (add_zero n)
    let φ : Abelian.Ext X S.X₁ n →+ Abelian.Ext X S.X₂ n :=
      (Abelian.Ext.mk₀ S.f).postcomp X (add_zero n)
    have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
      Abelian.Ext.covariant_sequence_exact₂ X hS b hb
    let σ : Abelian.Ext X S.X₃ n → Abelian.Ext X S.X₂ n :=
      fun c => if h : ∃ b, ψ b = c then h.choose else 0
    have hσ : ∀ b, ψ (σ (ψ b)) = ψ b := by
      intro b
      have h : ∃ b', ψ b' = ψ b := ⟨b, rfl⟩
      simp only [σ, dif_pos h]
      exact h.choose_spec
    have hpre : ∀ b, ∃ a, φ a = b - σ (ψ b) := fun b =>
      hex _ (by rw [map_sub, hσ, sub_self])
    choose τ hτ using hpre
    refine Finite.of_injective (fun b => (ψ b, τ b)) ?_
    intro b b' hbb
    simp only [Prod.mk.injEq] at hbb
    obtain ⟨e1, e2⟩ := hbb
    have := hτ b
    rw [e2, hτ b', e1] at this
    exact (sub_left_inj.mp this).symm

  have hzero : ∀ (X Z : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Limits.IsZero Z → ∀ n, Finite (Abelian.Ext X Z n) := by
    intro X Z hZ n
    have hx : ∀ x : Abelian.Ext X Z n, x = 0 := by
      intro x
      have := Abelian.Ext.comp_mk₀_id x
      rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
      exact this.symm
    haveI : Subsingleton (Abelian.Ext X Z n) := ⟨fun x y => by rw [hx x, hx y]⟩
    exact Finite.of_subsingleton

  have hses : ∀ (p k : ℕ), p ≠ 0 →
      ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
        (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
        (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
    intro p k hp
    have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
        ZMod.natCast_self]
    let α : ZMod k →+ ZMod (p * k) :=
      ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
      intro z
      show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
      rw [ZMod.lift_coe]
      change z • (p : ZMod (p * k)) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
      map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ g = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩

  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Y)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})

  intro m
  refine Nat.strong_induction_on m ?_
  intro m IH hm0 hP i
  rcases eq_or_ne m 1 with rfl | hm1
  · exact hzero _ _ (Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)) i
  · obtain ⟨p, hp, k, rfl⟩ : ∃ p, p.Prime ∧ ∃ k, m = p * k := by
      obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd hm1
      exact ⟨p, hp, hpm⟩
    have hk : k ≠ 0 := by
      rintro rfl
      exact hm0 (mul_zero p)
    have hlt : k < p * k := (Nat.lt_mul_iff_one_lt_left (Nat.pos_of_ne_zero hk)).mpr hp.one_lt
    have hK := IH k hlt hk (fun q hq hqk => hP q hq (dvd_mul_of_dvd_right hqk p))
    have hPp := hP p hp (dvd_mul_right p k)
    obtain ⟨f, g, hw, hS₀⟩ := hses p k hp.ne_zero
    have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    exact hmid _ _ hS i (hK i) (hPp i)

theorem wc_proper_finite_dim : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K))
    [IsProper f], ∃ n : ℕ, topologicalKrullDim Y ≤ (n : WithBot ℕ∞) :=
by
  intro K _ Y f _

  have s2 : ∀ (ι : Type u) (U : ι → Y.Opens), (∀ x : Y, ∃ i, x ∈ U i) → ∀ N : ℕ,
      (∀ i, topologicalKrullDim (U i) ≤ (N : WithBot ℕ∞)) →
      topologicalKrullDim Y ≤ (N : WithBot ℕ∞) := by
    intro ι U hcov N hN
    unfold topologicalKrullDim Order.krullDim
    refine iSup_le fun p => ?_
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨i, hi⟩ := hcov x
    have hmem : ∀ j, x ∈ (p j : Set Y) := fun j => (p.monotone (Fin.zero_le j)) hx
    let T : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds (U i) := fun j =>
      { carrier := (Subtype.val : U i → Y) ⁻¹' (p j : Set Y)
        isIrreducible' := ⟨⟨⟨x, hi⟩, hmem j⟩, (p j).isIrreducible.isPreirreducible.preimage
          (U i).isOpen.isOpenEmbedding_subtypeVal⟩
        isClosed' := (p j).isClosed.preimage continuous_subtype_val }
    have hT : StrictMono T := by
      intro a b hab
      have hlt : p a < p b := p.strictMono hab
      refine lt_of_le_of_ne ?_ ?_
      · intro y hy
        exact (p.monotone hab.le) hy
      · intro heq
        apply hlt.ne
        apply le_antisymm hlt.le
        have h1 : (p b : Set Y) ⊆ closure ((p b : Set Y) ∩ (U i : Set Y)) :=
          subset_closure_inter_of_isPreirreducible_of_isOpen
            (p b).isIrreducible.isPreirreducible (U i).isOpen ⟨x, hmem b, hi⟩
        have h2 : (p b : Set Y) ∩ (U i : Set Y) ⊆ (p a : Set Y) := by
          rintro y ⟨hyb, hyU⟩
          have hy : (⟨y, hyU⟩ : U i) ∈ (T b : Set (U i)) := hyb
          rw [← heq] at hy
          exact hy
        intro y hy
        have := closure_mono h2 (h1 hy)
        rwa [(p a).isClosed.closure_eq] at this
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds (U i)) :=
      ⟨p.length, T, fun j => hT Fin.castSucc_lt_succ⟩
    have := Order.LTSeries.length_le_krullDim q
    exact this.trans (hN i)

  have s4 : ∀ U : Y.Opens, IsAffineOpen U → ∃ n : ℕ, topologicalKrullDim U ≤ (n : WithBot ℕ∞) := by
    intro U hU
    have hR : topologicalKrullDim (Spec Γ(Y, U)) = ringKrullDim Γ(Y, U) :=
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _
    rw [IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso hU.isoSpec).isHomeomorph, hR]
    have hψ := Scheme.Hom.finiteType_appLE f (isAffineOpen_top (Spec (.of K))) hU (by simp)
    have hε : (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _
        ((Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.symm.surjective)
    have hφ := hψ.comp hε
    letI := ((f.appLE ⊤ U (by simp)).hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom).toAlgebra
    have hft : Algebra.FiniteType K Γ(Y, U) := hφ
    obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    refine ⟨n, (ringKrullDim_le_of_surjective g.toRingHom hg).trans ?_⟩
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing]
    simp [ringKrullDim_eq_zero_of_field]

  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  have hV : ∀ y : Y, ∃ V : Y.Opens, IsAffineOpen V ∧ y ∈ V := by
    intro y
    obtain ⟨V, hV, hyV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show y ∈ (⊤ : Y.Opens) from trivial)
    exact ⟨V, hV, hyV⟩
  choose V hVa hyV using hV
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun y => (V y : Set Y))
    (fun y => (V y).isOpen.mem_nhds (hyV y))
  choose n hn using fun y => s4 (V y) (hVa y)
  refine ⟨t.sup n, s2 t (fun y => V y) ?_ (t.sup n) ?_⟩
  · intro x
    have hx : x ∈ ⋃ y ∈ t, (V y : Set Y) := by rw [ht]; trivial
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    exact ⟨⟨y, hy⟩, hxy⟩
  · intro i
    refine (hn i).trans ?_
    exact_mod_cast Finset.le_sup i.2

theorem wc_et_coh_empty_finite : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ),
    Finite (wcEtCoh Y m q) :=
by
  intro Y hY m q
  have s1 : ∀ U : Y.Etale, IsEmpty U.left := fun U => ⟨fun x => hY.false (U.hom.base x)⟩
  have s2 : ∀ U : Y.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Y U := by
    intro U
    change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Y U
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    exact ((s1 U).false x).elim
  have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, Limits.IsZero G := by
    intro G
    have h : Limits.IsZero G.obj :=
      Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
    exact Limits.IsZero.of_full_of_faithful_of_isZero
      (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) G h
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
      Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
    intro A B hB
    have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
      intro x
      rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    exact ⟨fun x y => (hx x).trans (hx y).symm⟩
  haveI := hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB
  unfold wcEtCoh
  exact Finite.of_subsingleton

theorem wc_et_coh_sepClosed_point_finite : ∀ (k : Type u) [Field k] [IsSepClosed k] (m : ℕ),
    m ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh (Spec (.of k)) m q) :=
by
  intro k _ _ m hm q

  have hsec : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of k)), Etale f → Nonempty X →
      ∃ σ : Spec (.of k) ⟶ X, σ ≫ f = 𝟙 _ := by
    intro X f hf hX
    obtain ⟨x⟩ := hX
    obtain ⟨V, hV, hxV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) trivial
    haveI := hV.isOpenImmersion_fromSpec
    have hjx : x ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hxV
    obtain ⟨y, -⟩ := hjx
    have hA : Nontrivial Γ(X, V) :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp (⟨y⟩ : Nonempty (PrimeSpectrum Γ(X, V)))
    haveI : Etale (hV.fromSpec ≫ f) := inferInstance
    have hφ : Spec.map (Spec.preimage (hV.fromSpec ≫ f)) = hV.fromSpec ≫ f := Spec.map_preimage _
    have hφe : (Spec.preimage (hV.fromSpec ≫ f)).hom.Etale :=
      (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp
        (by rw [hφ]; infer_instance)
    letI : Algebra k Γ(X, V) := (Spec.preimage (hV.fromSpec ≫ f)).hom.toAlgebra
    haveI : Algebra.Etale k Γ(X, V) := RingHom.Etale.toAlgebra hφe
    obtain ⟨I, _, Ai, _, _, e, hAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k Γ(X, V)).mp inferInstance
    have hI : Nonempty I := by
      by_contra hne
      rw [not_nonempty_iff] at hne
      haveI : Subsingleton (∀ i, Ai i) := ⟨fun a b => funext fun i => (hne.false i).elim⟩
      exact not_subsingleton Γ(X, V) e.toEquiv.subsingleton
    obtain ⟨i⟩ := hI
    haveI := (hAi i).2
    have hsurj := IsSepClosed.algebraMap_surjective k (Ai i)
    let ε : k ≃ₐ[k] Ai i := AlgEquiv.ofBijective (Algebra.ofId k (Ai i))
      ⟨(algebraMap k (Ai i)).injective, hsurj⟩
    let ρ₀ : Γ(X, V) →ₐ[k] k := ε.symm.toAlgHom.comp ((Pi.evalAlgHom k Ai i).comp e.toAlgHom)
    have hφρ : Spec.preimage (hV.fromSpec ≫ f) ≫ CommRingCat.ofHom ρ₀.toRingHom = 𝟙 _ := by
      ext c
      exact ρ₀.commutes c
    refine ⟨Spec.map (CommRingCat.ofHom ρ₀.toRingHom) ≫ hV.fromSpec, ?_⟩
    rw [Category.assoc, ← hφ, ← Spec.map_comp, hφρ, Spec.map_id]

  let T : (Spec (.of k)).Etale := Scheme.Etale.mk (𝟙 (Spec (.of k)))
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have hcov : ∀ R ∈ (Scheme.smallEtaleTopology (Spec (.of k))) T, R.arrows (𝟙 T) := by
    intro R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of k)) T at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
    obtain ⟨x⟩ : Nonempty (Spec (.of k)) := inferInstance
    obtain ⟨Y, f, y, hf, -, -⟩ := hR' x
    obtain ⟨σ, hσ⟩ := hsec Y.left Y.hom Y.prop ⟨y⟩
    let σ' : T ⟶ Y := MorphismProperty.Over.homMk σ (by exact hσ)
    have h := R.downward_closed hf σ'
    rwa [hT.hom_ext (σ' ≫ f) (𝟙 T)] at h

  have hsurjT : ∀ {F G : (Spec (.of k)).Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : F ⟶ G),
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology (Spec (.of k))) φ →
      Function.Surjective (φ.app (Opposite.op T)) := by
    intro F G φ hφ s
    have h1 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology (Spec (.of k))) φ s
    have h2 := hcov _ h1
    rw [Presheaf.imageSieve_apply] at h2
    obtain ⟨t, ht⟩ := h2
    exact ⟨t, by simpa using ht⟩

  haveI : ((sheafSections (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}).obj
      (Opposite.op T)).PreservesEpimorphisms := by
    constructor
    intro F G φ hφ
    have h1 : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
    exact (AddCommGrpCat.epi_iff_surjective _).mpr (hsurjT φ.hom h1)

  have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
    refine ⟨fun {E X} f e he => ?_⟩
    have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
    obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
    refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext ⟨n⟩
    have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
      ext; simp
    change e (n • y) = f ⟨n⟩
    rw [h1, map_zsmul, map_zsmul, hy]
  have adj := constantSheafAdj (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1} hT
  haveI hproj := adj.map_projective _ hP
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  unfold wcEtCoh
  cases q with
  | zero =>
    have e := Sheaf.H.equiv₀ ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of k)))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) hT
    haveI : NeZero m := ⟨hm⟩
    have hls := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology (Spec (.of k)))
      ((Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :
        (Spec (.of k)).Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1})
    have hs := hsurjT _ hls
    have hfin : Finite (((constantSheaf (Scheme.smallEtaleTopology (Spec (.of k)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj
          (Opposite.op T)) :=
      @Finite.of_surjective _ _ (show Finite (ULift.{u+1} (ZMod m)) from inferInstance) _ hs
    exact Finite.of_equiv _ e.toEquiv.symm
  | succ n =>
    exact @Finite.of_subsingleton _ (Abelian.Ext.subsingleton_of_projective _ _ n)

theorem wc_zero_dim_split_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u})
    (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) →
    Nonempty W →
    ∃ (k : Type u) (_ : Field k) (iZ : Spec (.of k) ⟶ W) (X' : Scheme.{u}) (b : X' ⟶ W),
      IsSepClosed k ∧ IsClosedImmersion iZ ∧ IsClosedImmersion b ∧
      (∀ U : W.Opens, (U : Set W) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧
      Disjoint (Set.range b) (Set.range iZ) ∧
      topologicalKrullDim X' ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ Nat.card X' < Nat.card W :=
by
  intro Ω _ _ W fW _ hdim hne
  classical

  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace fW
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian fW
  haveI : IsNoetherian W := ⟨⟩

  have hmax : ∀ C : TopologicalSpace.IrreducibleCloseds W, IsMax C := by
    have h0 : topologicalKrullDim W ≤ 0 := by simpa using hdim
    exact Order.krullDim_nonpos_iff_forall_isMax.mp h0

  have hT1 : T1Space W := by
    rw [t1Space_iff_specializes_imp_eq]
    intro x y hxy
    let Cx : TopologicalSpace.IrreducibleCloseds W :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Cy : TopologicalSpace.IrreducibleCloseds W :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hle : Cy ≤ Cx := specializes_iff_closure_subset.mp hxy
    have hge : Cx ≤ Cy := hmax Cy hle
    have heq : closure ({x} : Set W) = closure {y} := le_antisymm hge hle
    exact (inseparable_iff_closure_eq.mpr heq).eq
  haveI := hT1

  have hfin : Finite W := by
    have hcomp : ∀ x : W, irreducibleComponent x = {x} := by
      intro x
      let Sx : TopologicalSpace.IrreducibleCloseds W :=
        ⟨{x}, isIrreducible_singleton, isClosed_singleton⟩
      let Kx : TopologicalSpace.IrreducibleCloseds W :=
        ⟨irreducibleComponent x, isIrreducible_irreducibleComponent,
          isClosed_irreducibleComponent⟩
      have hle : Sx ≤ Kx := by
        show ({x} : Set W) ⊆ irreducibleComponent x
        exact Set.singleton_subset_iff.mpr mem_irreducibleComponent
      have hge : Kx ≤ Sx := hmax Sx hle
      exact le_antisymm hge hle
    have hfc := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := W)
    haveI : Finite (irreducibleComponents W) := hfc.to_subtype
    refine Finite.of_injective (fun x : W => (⟨irreducibleComponent x,
      irreducibleComponent_mem_irreducibleComponents x⟩ : irreducibleComponents W)) ?_
    intro x y hxy
    have h := congrArg Subtype.val hxy
    simp only [hcomp] at h
    exact Set.singleton_injective h
  haveI := hfin
  obtain ⟨w⟩ := hne

  haveI : JacobsonSpace W := LocallyOfFiniteType.jacobsonSpace fW
  haveI hlft : LocallyOfFiniteType (W.fromSpecResidueField w) :=
    isClosed_singleton_iff_locallyOfFiniteType.mp isClosed_singleton
  have hac : IsAlgClosed (W.residueField w) := by
    let g := W.fromSpecResidueField w ≫ fW
    let φ := Spec.preimage g
    have hφ : φ.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp
        (by rw [Spec.map_preimage]; infer_instance)
    letI := φ.hom.toAlgebra
    haveI : Algebra.FiniteType Ω (W.residueField w) := hφ
    haveI : Module.Finite Ω (W.residueField w) :=
      finite_of_finite_type_of_isJacobsonRing Ω (W.residueField w)
    haveI : Algebra.IsIntegral Ω (W.residueField w) := Algebra.IsIntegral.of_finite Ω _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := W.residueField w)
    exact IsAlgClosed.of_ringEquiv Ω (W.residueField w) (RingEquiv.ofBijective _ hbij)

  let U₀ : W.Opens := ⟨({w} : Set W)ᶜ, isClosed_singleton.isOpen_compl⟩
  have hrange : Set.range U₀.ι = ({w} : Set W)ᶜ := Scheme.Opens.range_ι U₀
  have hbci : IsClosedImmersion U₀.ι :=
    IsClosedImmersion.of_isPreimmersion U₀.ι
      (by rw [hrange]; exact isClosed_compl_iff.mpr (isOpen_discrete _))
  have hiZ : IsClosedImmersion (W.fromSpecResidueField w) :=
    IsClosedImmersion.of_isPreimmersion _
      (by rw [Scheme.range_fromSpecResidueField]; exact isClosed_singleton)
  have hemb := U₀.ι.isOpenEmbedding.isEmbedding
  refine ⟨W.residueField w, inferInstance, W.fromSpecResidueField w, U₀, U₀.ι,
    IsSepClosed.of_isAlgClosed _, hiZ, hbci, ?_, ?_, ?_, ?_⟩
  · intro U hU
    rw [Scheme.range_fromSpecResidueField] at hU
    rw [isIso_iff_isOpenImmersion_and_surjective]
    refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
    have hyU : U.ι y ∈ (U : Set W) := by
      rw [← Scheme.Opens.range_ι U]; exact ⟨y, rfl⟩
    have hy : U.ι y ∈ Set.range U₀.ι := by rw [hrange, ← hU]; exact hyU
    obtain ⟨x, hx⟩ := hy
    have hxU : x ∈ U₀.ι ⁻¹ᵁ U := by
      show U₀.ι x ∈ U
      rw [hx]; exact hyU
    obtain ⟨x', hx'⟩ : x ∈ Set.range (U₀.ι ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]; exact hxU
    refine ⟨x', ?_⟩
    apply U.ι.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply, hx', hx]
  · rw [hrange, Scheme.range_fromSpecResidueField]
    exact disjoint_compl_left
  · have h1 : topologicalKrullDim U₀ = topologicalKrullDim (Set.range U₀.ι) :=
      IsHomeomorph.topologicalKrullDim_eq _ hemb.toHomeomorph.isHomeomorph
    rw [h1]
    exact (topologicalKrullDim_subspace_le W _).trans hdim
  · rw [← Nat.card_range_of_injective hemb.injective, Nat.card_coe_set_eq, hrange,
      ← Set.ncard_univ]
    apply Set.ncard_lt_ncard _ (Set.toFinite _)
    rw [Set.ssubset_univ_iff]
    exact Set.compl_ne_univ.mpr (Set.singleton_nonempty w)

theorem wc_reduced_subscheme_exists : ∀ (C : Scheme.{u}), ∃ (R : Scheme.{u}) (r : R ⟶ C),
    IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IsReduced R :=
by
  intro C
  let J : C.IdealSheafData := (⊥ : C.IdealSheafData).radical
  have h2 : Set.range J.subschemeι = Set.univ := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
      Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
  have hring : ∀ U : C.affineOpens, _root_.IsReduced (Γ(C, U) ⧸ J.ideal U) := fun U =>
    (Ideal.isRadical_iff_quotient_reduced _).mp
      (by
        show ((⊥ : C.IdealSheafData).radical.ideal U).IsRadical
        rw [Scheme.IdealSheafData.radical_ideal]
        exact Ideal.radical_isRadical _)
  have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) := fun (U : C.affineOpens) => by
    haveI := hring U
    exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(C, (U : C.Opens)) ⧸ J.ideal U))))
  have h3 : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
  exact ⟨J.subscheme, J.subschemeι, inferInstance, h2, h3⟩

theorem noether_integralClosure_finite : ∀ (k : Type u) [Field k] [PerfectField k] (D : Type u) [CommRing D] [IsDomain D] [Algebra k D] [Algebra.FiniteType k D], Module.Finite D (integralClosure D (FractionRing D)) :=
by

  have s3 : ∀ (A K0 L : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
      [IsNoetherianRing A] [Field K0] [Algebra A K0] [IsFractionRing A K0] [Field L]
      [Algebra K0 L] [Algebra A L] [IsScalarTower A K0 L] [FiniteDimensional K0 L] (p : ℕ)
      [ExpChar A p],
      ∃ (e : ℕ) (N : Submodule A L), N.FG ∧ ∀ c ∈ integralClosure A L, c ^ (p ^ e) ∈ N := by
    intro A K0 L _ _ _ _ _ _ _ _ _ _ _ _ p _
    haveI hCs : Module.Finite A (integralClosure A (separableClosure K0 L)) :=
      IsIntegralClosure.finite A K0 (separableClosure K0 L)
        (integralClosure A (separableClosure K0 L))
    let ι : separableClosure K0 L →ₐ[A] L := ((separableClosure K0 L).val).restrictScalars A
    have hι : Function.Injective ι := Subtype.val_injective
    have hinjA : Function.Injective (algebraMap A (separableClosure K0 L)) := by
      rw [IsScalarTower.algebraMap_eq A K0 (separableClosure K0 L)]
      exact (algebraMap K0 (separableClosure K0 L)).injective.comp (IsFractionRing.injective A K0)
    haveI : ExpChar (separableClosure K0 L) p := expChar_of_injective_algebraMap hinjA p
    haveI := IsPurelyInseparable.hasExponent_of_finiteDimensional
      (K := separableClosure K0 L) (L := L)
    refine ⟨IsPurelyInseparable.exponent (separableClosure K0 L) L,
      Submodule.map (ι.toLinearMap ∘ₗ (integralClosure A (separableClosure K0 L)).val.toLinearMap) ⊤,
      Module.Finite.fg_top.map _, ?_⟩
    intro c hc
    obtain ⟨y, hy⟩ := IsPurelyInseparable.exponent_def (separableClosure K0 L) c
    rw [ringExpChar.eq (separableClosure K0 L) p] at hy
    have hyι : ι y = c ^ (p ^ IsPurelyInseparable.exponent (separableClosure K0 L) L) := hy
    have hyint : IsIntegral A y := by
      apply (isIntegral_algHom_iff ι hι).mp
      rw [hyι]
      exact (mem_integralClosure_iff A L).mp hc |>.pow _
    exact ⟨⟨y, hyint⟩, trivial, hyι⟩

  have s4 : ∀ (k : Type u) [Field k] (p : ℕ) [ExpChar k p] [PerfectRing k p] (s e : ℕ),
      Module.Finite (iterateFrobenius (MvPolynomial (Fin s) k) p e).range
        (MvPolynomial (Fin s) k) := by
    intro k _ p _ _ s e
    have hq : 0 < p ^ e := pow_pos (expChar_pos k p) e
    have hC : ∀ a : k, (MvPolynomial.C a : MvPolynomial (Fin s) k) ∈
        (iterateFrobenius (MvPolynomial (Fin s) k) p e).range := by
      intro a
      obtain ⟨d, hd⟩ := (bijective_iterateFrobenius k p e).2 a
      refine ⟨MvPolynomial.C d, ?_⟩
      rw [iterateFrobenius_def, ← MvPolynomial.C_pow, ← iterateFrobenius_def (R := k), hd]
    have hX : ∀ i, IsIntegral (iterateFrobenius (MvPolynomial (Fin s) k) p e).range
        (MvPolynomial.X i : MvPolynomial (Fin s) k) := by
      intro i
      apply IsIntegral.of_pow hq
      have hm : (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ (p ^ e) ∈
          (iterateFrobenius (MvPolynomial (Fin s) k) p e).range :=
        ⟨MvPolynomial.X i, iterateFrobenius_def p e _⟩
      have h2 : algebraMap (iterateFrobenius (MvPolynomial (Fin s) k) p e).range
          (MvPolynomial (Fin s) k) ⟨_, hm⟩ = (MvPolynomial.X i) ^ (p ^ e) := rfl
      rw [← h2]
      exact isIntegral_algebraMap
    have hS : Module.Finite (iterateFrobenius (MvPolynomial (Fin s) k) p e).range
        (Algebra.adjoin (iterateFrobenius (MvPolynomial (Fin s) k) p e).range
          (Set.range (MvPolynomial.X : Fin s → MvPolynomial (Fin s) k))) :=
      Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
        (by rintro _ ⟨i, rfl⟩; exact hX i)
    have htop : Algebra.adjoin (iterateFrobenius (MvPolynomial (Fin s) k) p e).range
          (Set.range (MvPolynomial.X : Fin s → MvPolynomial (Fin s) k)) = ⊤ := by
      rw [Algebra.eq_top_iff]
      intro f
      induction f using MvPolynomial.induction_on with
      | C a => exact Subalgebra.algebraMap_mem _ (⟨MvPolynomial.C a, hC a⟩ :
          (iterateFrobenius (MvPolynomial (Fin s) k) p e).range)
      | add f g hf hg => exact add_mem hf hg
      | mul_X f n hf => exact mul_mem hf (Algebra.subset_adjoin ⟨n, rfl⟩)
    exact Module.Finite.equiv
      ((Subalgebra.equivOfEq _ ⊤ htop).trans Subalgebra.topEquiv).toLinearEquiv

  have s5 : ∀ (P L : Type u) [CommRing P] [CommRing L] [IsReduced L] [Algebra P L] (p e : ℕ)
      [ExpChar P p] [ExpChar L p] [IsNoetherianRing P]
      [Module.Finite (iterateFrobenius P p e).range P]
      (C N : Submodule P L), N.FG → (∀ c ∈ C, c ^ (p ^ e) ∈ N) → C.FG := by
    intro P L _ _ _ _ p e _ _ _ _ C N hN hC
    let σ : P →+* (iterateFrobenius P p e).range := (iterateFrobenius P p e).rangeRestrict
    haveI : RingHomSurjective σ := ⟨RingHom.rangeRestrict_surjective _⟩
    haveI : IsNoetherianRing (iterateFrobenius P p e).range :=
      isNoetherianRing_of_surjective P _ σ (RingHom.rangeRestrict_surjective _)
    have hN' : (N.restrictScalars (iterateFrobenius P p e).range).FG := hN.restrictScalars
    let f : L →ₛₗ[σ] L :=
      { toFun := fun x => x ^ (p ^ e)
        map_add' := fun x y => add_pow_expChar_pow x y p e
        map_smul' := fun a x => by
          have h1 : ((σ a : (iterateFrobenius P p e).range) : P) = a ^ (p ^ e) :=
            iterateFrobenius_def p e a
          show (a • x) ^ (p ^ e) = ((σ a : (iterateFrobenius P p e).range) : P) • x ^ (p ^ e)
          rw [h1, Algebra.smul_def, Algebra.smul_def, mul_pow, map_pow] }
    have hinj : Function.Injective f := by
      intro x y h
      apply iterateFrobenius_inj L p e
      rw [iterateFrobenius_def, iterateFrobenius_def]
      exact h
    have hle : Submodule.map f C ≤ N.restrictScalars (iterateFrobenius P p e).range := by
      rintro _ ⟨c, hc, rfl⟩
      exact hC c hc
    exact Submodule.fg_of_fg_map_injective f hinj (hN'.of_le hle)

  intro k _ _ D _ _ _ _
  obtain ⟨s, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg k D
  letI : Algebra (MvPolynomial (Fin s) k) D := g.toRingHom.toAlgebra
  haveI : Module.Finite (MvPolynomial (Fin s) k) D := hfin
  haveI : FaithfulSMul (MvPolynomial (Fin s) k) D :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  letI : Algebra (FractionRing (MvPolynomial (Fin s) k)) (FractionRing D) :=
    FractionRing.liftAlgebra (MvPolynomial (Fin s) k) (FractionRing D)
  have hinjL : Function.Injective (algebraMap (MvPolynomial (Fin s) k) (FractionRing D)) := by
    rw [IsScalarTower.algebraMap_eq (MvPolynomial (Fin s) k) D (FractionRing D)]
    exact (IsFractionRing.injective D (FractionRing D)).comp hinj
  haveI : ExpChar (FractionRing D) (ringExpChar k) :=
    expChar_of_injective_algebraMap hinjL (ringExpChar k)
  haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) D := Algebra.IsIntegral.of_finite _ _
  have hiff : ∀ x : FractionRing D,
      IsIntegral (MvPolynomial (Fin s) k) x ↔ IsIntegral D x := fun x =>
    ⟨fun h => h.tower_top, fun h => isIntegral_trans x h⟩
  obtain ⟨e, N, hN, hpow⟩ := s3 (MvPolynomial (Fin s) k) (FractionRing (MvPolynomial (Fin s) k))
    (FractionRing D) (ringExpChar k)
  haveI := s4 k (ringExpChar k) s e
  have hCP : (Subalgebra.toSubmodule
      (integralClosure (MvPolynomial (Fin s) k) (FractionRing D))).FG :=
    s5 (MvPolynomial (Fin s) k) (FractionRing D) (ringExpChar k) e _ N hN
      (fun c hc => hpow c hc)
  let φ : integralClosure D (FractionRing D) →ₗ[MvPolynomial (Fin s) k] FractionRing D :=
    ((integralClosure D (FractionRing D)).val.toLinearMap).restrictScalars _
  have hφ : Function.Injective φ := Subtype.val_injective
  have hrange : LinearMap.range φ =
      Subalgebra.toSubmodule (integralClosure (MvPolynomial (Fin s) k) (FractionRing D)) := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact (hiff _).mpr y.2
    · intro hx
      exact ⟨⟨x, (hiff x).mp hx⟩, rfl⟩
  haveI : Module.Finite (MvPolynomial (Fin s) k) (LinearMap.range φ) := by
    rw [Module.Finite.iff_fg, hrange]; exact hCP
  haveI : Module.Finite (MvPolynomial (Fin s) k) (integralClosure D (FractionRing D)) :=
    Module.Finite.equiv (LinearEquiv.ofInjective φ hφ).symm
  exact Module.Finite.of_restrictScalars_finite (MvPolynomial (Fin s) k) D _

theorem integralClosure_prod_minimal_finite : ∀ (A : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A] (L : Type u) [CommRing L] [Algebra A L], Nonempty (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)) → (∀ P ∈ minimalPrimes A, Module.Finite (A ⧸ P) (integralClosure (A ⧸ P) (FractionRing (A ⧸ P)))) → Module.Finite A (integralClosure A L) :=
by
  intro A _ _ _ L _ _ ⟨e⟩ hfin
  classical

  have s1 : ∀ (P : Ideal A) [P.IsPrime], P ∈ minimalPrimes A → ∀ x ∈ P,
      algebraMap A (Localization.AtPrime P) x = 0 := by
    intro P _ hP x hx
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    have hq : (J.comap (algebraMap A (Localization.AtPrime P))).IsPrime := Ideal.comap_isPrime _ _
    have hle : J.comap (algebraMap A (Localization.AtPrime P)) ≤ P := by
      intro z hz
      by_contra hzP
      have hu : IsUnit (algebraMap A (Localization.AtPrime P) z) :=
        IsLocalization.map_units (Localization.AtPrime P) (⟨z, hzP⟩ : P.primeCompl)
      exact hJ.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp hz) hu)
    have hge : P ≤ J.comap (algebraMap A (Localization.AtPrime P)) := hP.2 ⟨hq, bot_le⟩ hle
    exact Ideal.mem_comap.mp (hge hx)

  have s2 : ∀ (P : Ideal A) [P.IsPrime], (∀ x ∈ P, algebraMap A (Localization.AtPrime P) x = 0) →
      ∃ φ : Localization.AtPrime P →ₐ[A] FractionRing (A ⧸ P), Function.Injective φ := by
    intro P _ hP
    have hunit : ∀ s : P.primeCompl, IsUnit (algebraMap A (FractionRing (A ⧸ P)) s) := by
      intro s
      apply Ne.isUnit
      rw [IsScalarTower.algebraMap_apply A (A ⧸ P) (FractionRing (A ⧸ P)),
        Ideal.Quotient.algebraMap_eq]
      intro h
      have h2 : Ideal.Quotient.mk P (s : A) = 0 :=
        IsFractionRing.injective (A ⧸ P) (FractionRing (A ⧸ P)) (h.trans (map_zero _).symm)
      exact s.2 (Ideal.Quotient.eq_zero_iff_mem.mp h2)
    let g : Localization.AtPrime P →+* FractionRing (A ⧸ P) :=
      IsLocalization.lift (M := P.primeCompl) hunit
    have hg : ∀ a : A, g (algebraMap A (Localization.AtPrime P) a) =
        algebraMap A (FractionRing (A ⧸ P)) a := fun a => IsLocalization.lift_eq hunit a
    let φ : Localization.AtPrime P →ₐ[A] FractionRing (A ⧸ P) :=
      { g with commutes' := hg }
    refine ⟨φ, ?_⟩
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl z
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) x s
    have h1 : φ (IsLocalization.mk' (Localization.AtPrime P) x s) *
        φ (algebraMap A (Localization.AtPrime P) s) = φ (algebraMap A (Localization.AtPrime P) x) := by
      rw [← map_mul, hspec]
    rw [hz, zero_mul] at h1
    have h2 : algebraMap A (FractionRing (A ⧸ P)) x = 0 := by
      rw [← hg x]; exact h1.symm
    rw [IsScalarTower.algebraMap_apply A (A ⧸ P) (FractionRing (A ⧸ P)),
      Ideal.Quotient.algebraMap_eq] at h2
    have h3 : Ideal.Quotient.mk P x = 0 :=
      IsFractionRing.injective (A ⧸ P) (FractionRing (A ⧸ P)) (h2.trans (map_zero _).symm)
    have hx0 : algebraMap A (Localization.AtPrime P) x = 0 :=
      hP x (Ideal.Quotient.eq_zero_iff_mem.mp h3)
    show IsLocalization.mk' (Localization.AtPrime P) x s = 0
    rw [IsLocalization.mk'_eq_mul_mk'_one, hx0, zero_mul]

  let ι := {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}
  haveI : Finite ι := by
    haveI := (minimalPrimes.finite_of_isNoetherianRing A).to_subtype
    refine Finite.of_injective (fun P : ι => (⟨P.1.asIdeal, P.2⟩ : minimalPrimes A)) ?_
    intro P Q h
    exact Subtype.ext (PrimeSpectrum.ext (congrArg Subtype.val h))
  have hφ : ∀ i : ι, ∃ φ : Localization.AtPrime i.1.asIdeal →ₐ[A] FractionRing (A ⧸ i.1.asIdeal),
      Function.Injective φ :=
    fun i => s2 i.1.asIdeal (s1 i.1.asIdeal i.2)
  choose φ hφinj using hφ
  let K := fun i : ι => FractionRing (A ⧸ i.1.asIdeal)
  let Ψ : ((i : ι) → Localization.AtPrime i.1.asIdeal) →ₐ[A] ((i : ι) → K i) :=
    Pi.algHom A K (fun i => (φ i).comp (Pi.evalAlgHom A _ i))
  let Φ : L →ₐ[A] ((i : ι) → K i) := Ψ.comp e.toAlgHom
  have hΦ : Function.Injective Φ := by
    intro x y hxy
    apply e.injective
    funext i
    apply hφinj i
    exact congrFun hxy i
  let C := fun i : ι => integralClosure (A ⧸ i.1.asIdeal) (K i)
  haveI hCfin : ∀ i, Module.Finite A (C i) := fun i => by
    haveI := hfin i.1.asIdeal i.2
    exact Module.Finite.trans (A ⧸ i.1.asIdeal) (C i)
  haveI : IsNoetherian A ((i : ι) → C i) := isNoetherian_of_isNoetherianRing_of_finite A _
  have hint : ∀ (x : integralClosure A L) (i : ι), Φ x.1 i ∈ C i := by
    intro x i
    have h1 : IsIntegral A (Φ x.1 i) :=
      (show IsIntegral A x.1 from x.2).map ((Pi.evalAlgHom A K i).comp Φ)
    exact h1.tower_top
  let ψ : integralClosure A L →ₗ[A] ((i : ι) → C i) :=
    { toFun := fun x i => ⟨Φ x.1 i, hint x i⟩
      map_add' := fun x y => by funext i; apply Subtype.ext; simp
      map_smul' := fun a x => by funext i; apply Subtype.ext; simp }
  refine Module.Finite.of_injective ψ ?_
  intro x y hxy
  apply Subtype.ext
  apply hΦ
  funext i
  exact congrArg Subtype.val (congrFun hxy i)

theorem integralClosure_prod_minimal_stalks_normal : ∀ (A : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A] (L : Type u) [CommRing L] [Algebra A L], Nonempty (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)) → ∀ (Q : Ideal (integralClosure A L)) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) :=
by
  intro A _ _ _ L _ _ ⟨e⟩ Q _
  classical

  have s1a : ∀ (P : Ideal A) [P.IsPrime], P ∈ minimalPrimes A → ∀ x ∈ P,
      algebraMap A (Localization.AtPrime P) x = 0 := by
    intro P _ hP x hx
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    have hq : (J.comap (algebraMap A (Localization.AtPrime P))).IsPrime := Ideal.comap_isPrime _ _
    have hle : J.comap (algebraMap A (Localization.AtPrime P)) ≤ P := by
      intro z hz
      by_contra hzP
      have hu : IsUnit (algebraMap A (Localization.AtPrime P) z) :=
        IsLocalization.map_units (Localization.AtPrime P) (⟨z, hzP⟩ : P.primeCompl)
      exact hJ.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp hz) hu)
    have hge : P ≤ J.comap (algebraMap A (Localization.AtPrime P)) := hP.2 ⟨hq, bot_le⟩ hle
    exact Ideal.mem_comap.mp (hge hx)

  have s1 : ∀ (P : Ideal A) [P.IsPrime], P ∈ minimalPrimes A →
      ∀ z : Localization.AtPrime P, z = 0 ∨ IsUnit z := by
    intro P _ hP z
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl z
    by_cases ha : a ∈ P
    · left
      show IsLocalization.mk' (Localization.AtPrime P) a s = 0
      rw [IsLocalization.mk'_eq_mul_mk'_one, s1a P hP a ha, zero_mul]
    · right
      exact IsUnit.of_mul_eq_one _
        (IsLocalization.mk'_mul_mk'_eq_one' (M := P.primeCompl) (S := Localization.AtPrime P) a s ha)

  have s2 : ∀ (ι : Type u) (K : ι → Type u) [∀ i, CommRing (K i)] [∀ i, Algebra A (K i)]
      [DecidableEq ι] (j : ι) (w : K j), IsIntegral A w →
      IsIntegral A (Pi.single j w : (i : ι) → K i) := by
    intro ι K _ _ _ j w hw
    obtain ⟨p, hp, hpw⟩ := hw
    refine ⟨Polynomial.X * p, Polynomial.monic_X.mul hp, ?_⟩
    rw [← Polynomial.aeval_def]
    have key : ∀ i, (Polynomial.aeval (Pi.single j w : (i : ι) → K i) p) i =
        Polynomial.aeval ((Pi.single j w : (i : ι) → K i) i) p := fun i =>
      (Polynomial.aeval_algHom_apply (Pi.evalAlgHom A K i) _ p).symm
    rw [map_mul, Polynomial.aeval_X]
    funext i
    rw [Pi.mul_apply, key i, Pi.zero_apply]
    by_cases hij : i = j
    · rw [hij, Pi.single_eq_same, Polynomial.aeval_def, hpw, mul_zero]
    · rw [Pi.single_eq_of_ne hij, zero_mul]

  have s3 : ∀ (B K : Type u) [CommRing B] [CommRing K] [Nontrivial K], (∀ z : K, z = 0 ∨ IsUnit z) →
      ∀ (ρ : B →+* K) (Q : Ideal B) [Q.IsPrime] (ε : B), ε ∉ Q → (∀ b : B, ρ b = 0 → b * ε = 0) →
      (∀ z : K, ∃ x y : B, ρ y ≠ 0 ∧ z * ρ y = ρ x) →
      (∀ z : K, ρ.IsIntegralElem z → ∃ b : B, ρ b = z) →
      IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro B K _ _ _ h0u ρ Q hQ ε hε hker hfrac hint
    have hfield : IsField K := by
      refine ⟨exists_pair_ne K, fun a b => mul_comm a b, fun {a} ha => ?_⟩
      rcases h0u a with h | h
      · exact absurd h ha
      · exact h.exists_right_inv
    haveI : IsDomain K := hfield.isDomain
    have hne : ∀ s : B, s ∉ Q → ρ s ≠ 0 := by
      intro s hs h
      have h1 := hker s h
      rcases hQ.mem_or_mem (show s * ε ∈ Q by rw [h1]; exact Q.zero_mem) with h2 | h2
      · exact hs h2
      · exact hε h2
    have hunit : ∀ s : Q.primeCompl, IsUnit (ρ s) := fun s =>
      (h0u _).resolve_left (hne s.1 s.2)
    let ψ : Localization.AtPrime Q →+* K := IsLocalization.lift (M := Q.primeCompl) hunit
    have hψ : ∀ b, ψ (algebraMap B (Localization.AtPrime Q) b) = ρ b := fun b =>
      IsLocalization.lift_eq hunit b
    have hψinj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
      have hspec := IsLocalization.mk'_spec (Localization.AtPrime Q) b s
      have h1 : ψ (IsLocalization.mk' (Localization.AtPrime Q) b s) *
          ψ (algebraMap B (Localization.AtPrime Q) s) = ψ (algebraMap B (Localization.AtPrime Q) b) := by
        rw [← map_mul, hspec]
      rw [hz, zero_mul, hψ] at h1
      have h2 := hker b h1.symm
      have h3 : algebraMap B (Localization.AtPrime Q) b * algebraMap B (Localization.AtPrime Q) ε = 0 := by
        rw [← map_mul, h2, map_zero]
      have hu : IsUnit (algebraMap B (Localization.AtPrime Q) ε) :=
        IsLocalization.map_units (Localization.AtPrime Q) (⟨ε, hε⟩ : Q.primeCompl)
      have h4 : algebraMap B (Localization.AtPrime Q) b = 0 := hu.mul_left_eq_zero.mp h3
      show IsLocalization.mk' (Localization.AtPrime Q) b s = 0
      rw [IsLocalization.mk'_eq_mul_mk'_one, h4, zero_mul]
    haveI hdom : IsDomain (Localization.AtPrime Q) := Function.Injective.isDomain ψ hψinj
    refine ⟨hdom, ?_⟩
    letI : Algebra (Localization.AtPrime Q) K := ψ.toAlgebra
    haveI : IsFractionRing (Localization.AtPrime Q) K := by
      refine ⟨?_, ?_, ?_⟩
      · intro y
        apply (h0u _).resolve_left
        show ψ y ≠ 0
        intro h
        exact nonZeroDivisors.ne_zero y.2 (hψinj (h.trans (map_zero ψ).symm))
      · intro z
        obtain ⟨x, y, hy, hz⟩ := hfrac z
        have hy' : algebraMap B (Localization.AtPrime Q) y ∈ nonZeroDivisors (Localization.AtPrime Q) := by
          apply mem_nonZeroDivisors_of_ne_zero
          intro h
          apply hy
          rw [← hψ, h, map_zero]
        refine ⟨⟨algebraMap B _ x, ⟨_, hy'⟩⟩, ?_⟩
        show z * ψ (algebraMap B _ y) = ψ (algebraMap B _ x)
        rw [hψ, hψ, hz]
      · intro x y h
        exact ⟨1, by rw [hψinj h]⟩
    letI : Algebra B K := ρ.toAlgebra
    haveI : IsScalarTower B (Localization.AtPrime Q) K :=
      IsScalarTower.of_algebraMap_eq (fun b => (hψ b).symm)
    rw [isIntegrallyClosed_iff K]
    intro z hz
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization Q.primeCompl z hz
    rw [Submonoid.smul_def, Algebra.smul_def] at hm
    obtain ⟨b, hb⟩ := hint _ hm
    refine ⟨IsLocalization.mk' (Localization.AtPrime Q) b m, ?_⟩
    show ψ (IsLocalization.mk' _ b m) = z
    have hmne : ρ m ≠ 0 := hne m.1 m.2
    apply mul_right_cancel₀ hmne
    have e1 : ψ (IsLocalization.mk' (Localization.AtPrime Q) b m) * ρ m = ρ b := by
      rw [← hψ m, ← map_mul, IsLocalization.mk'_spec, hψ]
    rw [e1, hb]
    exact mul_comm _ _

  let ι := {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}
  haveI : Finite ι := by
    haveI := (minimalPrimes.finite_of_isNoetherianRing A).to_subtype
    refine Finite.of_injective (fun P : ι => (⟨P.1.asIdeal, P.2⟩ : minimalPrimes A)) ?_
    intro P Q h
    exact Subtype.ext (PrimeSpectrum.ext (congrArg Subtype.val h))
  haveI : Fintype ι := Fintype.ofFinite ι
  let K := fun i : ι => Localization.AtPrime i.1.asIdeal
  have hεint : ∀ i : ι, IsIntegral A (e.symm (Pi.single i 1)) := fun i =>
    (s2 ι K i 1 isIntegral_one).map e.symm
  let εB : ι → integralClosure A L := fun i => ⟨e.symm (Pi.single i 1), hεint i⟩
  have hsum : ∑ i, εB i = 1 := by
    apply Subtype.ext
    rw [AddSubmonoidClass.coe_finset_sum]
    show ∑ i, e.symm (Pi.single i 1) = 1
    have h1 : ∑ i, (Pi.single i 1 : (i : ι) → K i) = 1 := Finset.univ_sum_single 1
    rw [← map_sum, h1, map_one]
  obtain ⟨j, hj⟩ : ∃ j, εB j ∉ Q := by
    by_contra h
    push_neg at h
    apply ‹Q.IsPrime›.ne_top
    rw [Ideal.eq_top_iff_one, ← hsum]
    exact Ideal.sum_mem Q (fun i _ => h i)
  let ρA : integralClosure A L →ₐ[A] Localization.AtPrime j.1.asIdeal :=
    (Pi.evalAlgHom A K j).comp (e.toAlgHom.comp (integralClosure A L).val)
  let ρ : integralClosure A L →+* Localization.AtPrime j.1.asIdeal := ρA.toRingHom
  have hρA : ∀ a : A, ρ (algebraMap A (integralClosure A L) a) =
      algebraMap A (Localization.AtPrime j.1.asIdeal) a := fun a => ρA.commutes a
  have hker : ∀ b : integralClosure A L, ρ b = 0 → b * εB j = 0 := by
    intro b hb
    apply Subtype.ext
    apply e.injective
    show e (b.1 * e.symm (Pi.single j 1)) = e 0
    rw [map_mul, e.apply_symm_apply, map_zero]
    funext i
    rw [Pi.mul_apply, Pi.zero_apply]
    by_cases hij : i = j
    · rw [hij, Pi.single_eq_same, mul_one]
      exact hb
    · rw [Pi.single_eq_of_ne hij, mul_zero]
  have hfrac : ∀ z : Localization.AtPrime j.1.asIdeal, ∃ x y : integralClosure A L,
      ρ y ≠ 0 ∧ z * ρ y = ρ x := by
    intro z
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective j.1.asIdeal.primeCompl z
    refine ⟨algebraMap A _ a, algebraMap A _ t, ?_, ?_⟩
    · rw [hρA]
      exact (IsLocalization.map_units (Localization.AtPrime j.1.asIdeal) t).ne_zero
    · rw [hρA, hρA]
      exact IsLocalization.mk'_spec (Localization.AtPrime j.1.asIdeal) a t
  have hint : ∀ z : Localization.AtPrime j.1.asIdeal, ρ.IsIntegralElem z →
      ∃ b : integralClosure A L, ρ b = z := by
    intro z hz
    letI : Algebra (integralClosure A L) (Localization.AtPrime j.1.asIdeal) := ρ.toAlgebra
    haveI : IsScalarTower A (integralClosure A L) (Localization.AtPrime j.1.asIdeal) :=
      IsScalarTower.of_algebraMap_eq (fun a => (hρA a).symm)
    have hz' : IsIntegral (integralClosure A L) z := hz
    have hzA : IsIntegral A z := isIntegral_trans z hz'
    have hl : IsIntegral A (e.symm (Pi.single j z)) := (s2 ι K j z hzA).map e.symm
    refine ⟨⟨e.symm (Pi.single j z), hl⟩, ?_⟩
    show e (e.symm (Pi.single j z)) j = z
    rw [e.apply_symm_apply, Pi.single_eq_same]
  exact s3 (integralClosure A L) (Localization.AtPrime j.1.asIdeal) (s1 j.1.asIdeal j.2) ρ Q
    (εB j) hj hker hfrac hint

theorem reduced_noetherian_generic_normal : ∀ (A : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A], (∀ P ∈ minimalPrimes A, Module.Finite (A ⧸ P) (integralClosure (A ⧸ P) (FractionRing (A ⧸ P)))) → ∀ P ∈ minimalPrimes A, ∃ f : A, f ∉ P ∧ ∀ (B : Type u) [CommRing B] [Algebra A B] [IsLocalization.Away f B], IsDomain B ∧ IsIntegrallyClosed B :=
by
  intro A _ _ _ hfin P hP
  classical
  haveI hPp : P.IsPrime := hP.1.1

  have s1 : ∃ g : A, g ∉ P ∧ ∀ x ∈ P, g * x = 0 := by
    set S : Finset (Ideal A) := (minimalPrimes.finite_of_isNoetherianRing A).toFinset.erase P
      with hS
    have hQ : ¬ S.inf id ≤ P := by
      intro hle
      obtain ⟨P', hP'S, hP'le⟩ := (Ideal.IsPrime.inf_le' hPp).mp hle
      rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset] at hP'S
      obtain ⟨hne, hP'min⟩ := hP'S
      have hle' : P ≤ P' := hP.2 ⟨hP'min.1.1, bot_le⟩ hP'le
      exact hne (le_antisymm hP'le hle')
    obtain ⟨g, hgQ, hgP⟩ := SetLike.not_le_iff_exists.mp hQ
    refine ⟨g, hgP, fun x hx => ?_⟩
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ J)
    apply hpJ
    by_cases hpP : p = P
    · rw [hpP]; exact Ideal.mul_mem_left _ _ hx
    · have hpS : p ∈ S := by
        rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset]; exact ⟨hpP, hp⟩
      have hgp : g ∈ id p := (Finset.inf_le (f := id) hpS : S.inf id ≤ id p) hgQ
      exact Ideal.mul_mem_right _ _ hgp

  have s2 : ∃ d : A ⧸ P, d ≠ 0 ∧ ∀ c ∈ integralClosure (A ⧸ P) (FractionRing (A ⧸ P)),
      IsLocalization.IsInteger (A ⧸ P) (d • c) := by
    obtain ⟨s, hs⟩ := Module.finite_def.mp (hfin P hP)
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset
      (nonZeroDivisors (A ⧸ P)) (s.image Subtype.val)
    refine ⟨(b : A ⧸ P), nonZeroDivisors.ne_zero b.2, fun c hc => ?_⟩
    have key : ∀ y : integralClosure (A ⧸ P) (FractionRing (A ⧸ P)),
        y ∈ Submodule.span (A ⧸ P) (s : Set (integralClosure (A ⧸ P) (FractionRing (A ⧸ P)))) →
        IsLocalization.IsInteger (A ⧸ P) ((b : A ⧸ P) • (y : FractionRing (A ⧸ P))) := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy => exact hb _ (Finset.mem_image_of_mem _ hy)
      | zero =>
        rw [ZeroMemClass.coe_zero, smul_zero]; exact IsLocalization.isInteger_zero
      | add y y' _ _ hy hy' =>
        rw [AddMemClass.coe_add, smul_add]; exact IsLocalization.isInteger_add hy hy'
      | smul r y _ hy =>
        show IsLocalization.IsInteger (A ⧸ P) ((b : A ⧸ P) • (r • (y : FractionRing (A ⧸ P))))
        rw [smul_comm]
        exact IsLocalization.isInteger_smul hy
    exact key ⟨c, hc⟩ (by rw [hs]; trivial)

  obtain ⟨g, hgP, hg⟩ := s1
  obtain ⟨d, hd0, hd⟩ := s2
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective d
  have haP : a ∉ P := fun h => hd0 (Ideal.Quotient.eq_zero_iff_mem.mpr h)
  refine ⟨g * a, fun h => (hPp.mem_or_mem h).elim hgP haP, ?_⟩
  intro B _ _ _
  set f := g * a with hf
  have hfP : f ∉ P := fun h => (hPp.mem_or_mem h).elim hgP haP
  have hann : ∀ x ∈ P, f * x = 0 := fun x hx => by
    rw [hf, mul_comm g a, mul_assoc, hg x hx, mul_zero]
  have hcond : ∀ c ∈ integralClosure (A ⧸ P) (FractionRing (A ⧸ P)),
      IsLocalization.IsInteger (A ⧸ P) (Ideal.Quotient.mk P f • c) := by
    intro c hc
    rw [hf, map_mul, mul_smul]
    exact IsLocalization.isInteger_smul (hd c hc)

  have hκ : ∀ x : A, algebraMap A (FractionRing (A ⧸ P)) x =
      algebraMap (A ⧸ P) (FractionRing (A ⧸ P)) (Ideal.Quotient.mk P x) := fun x => by
    rw [IsScalarTower.algebraMap_apply A (A ⧸ P) (FractionRing (A ⧸ P)),
      Ideal.Quotient.algebraMap_eq]
  have hκ0 : ∀ x : A, algebraMap A (FractionRing (A ⧸ P)) x = 0 → x ∈ P := by
    intro x hx
    rw [hκ] at hx
    exact Ideal.Quotient.eq_zero_iff_mem.mp
      (IsFractionRing.injective (A ⧸ P) (FractionRing (A ⧸ P)) (hx.trans (map_zero _).symm))
  have hκf : algebraMap A (FractionRing (A ⧸ P)) f ≠ 0 := fun h => hfP (hκ0 f h)
  have hunit : ∀ y : Submonoid.powers f, IsUnit (algebraMap A (FractionRing (A ⧸ P)) y) := by
    rintro ⟨y, hy⟩
    obtain ⟨n, rfl⟩ := hy
    show IsUnit (algebraMap A (FractionRing (A ⧸ P)) (f ^ n))
    rw [map_pow]
    exact (Ne.isUnit hκf).pow n
  let φ : B →+* FractionRing (A ⧸ P) := IsLocalization.lift (M := Submonoid.powers f) hunit
  have hφ : ∀ x : A, φ (algebraMap A B x) = algebraMap A (FractionRing (A ⧸ P)) x :=
    fun x => IsLocalization.lift_eq hunit x
  have hjf : IsUnit (algebraMap A B f) := IsLocalization.Away.algebraMap_isUnit f
  have hjP : ∀ x ∈ P, algebraMap A B x = 0 := by
    intro x hx
    have h0 : algebraMap A B f * algebraMap A B x = 0 := by
      rw [← map_mul, hann x hx, map_zero]
    exact hjf.mul_right_eq_zero.mp h0
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers f) z
    have hspec := IsLocalization.mk'_spec B x s
    have h1 : φ (IsLocalization.mk' B x s) * φ (algebraMap A B s) = φ (algebraMap A B x) := by
      rw [← map_mul, hspec]
    rw [hz, zero_mul, hφ] at h1
    show IsLocalization.mk' B x s = 0
    rw [IsLocalization.mk'_eq_mul_mk'_one, hjP x (hκ0 x h1.symm), zero_mul]
  haveI : IsDomain B := Function.Injective.isDomain φ hinj
  letI : Algebra B (FractionRing (A ⧸ P)) := φ.toAlgebra
  have hφalg : algebraMap B (FractionRing (A ⧸ P)) = φ := rfl
  haveI : FaithfulSMul B (FractionRing (A ⧸ P)) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  haveI : IsFractionRing B (FractionRing (A ⧸ P)) := by
    apply IsFractionRing.of_field
    intro z
    obtain ⟨x, y, -, hxy⟩ := IsFractionRing.div_surjective (A ⧸ P) z
    obtain ⟨x', rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
    refine ⟨algebraMap A B x', algebraMap A B y', ?_⟩
    rw [hφalg, hφ, hφ, hκ, hκ, hxy]
  haveI : IsScalarTower A B (FractionRing (A ⧸ P)) :=
    IsScalarTower.of_algebraMap_eq (fun x => (hφ x).symm)
  refine ⟨inferInstance, (isIntegrallyClosed_iff (FractionRing (A ⧸ P))).mpr ?_⟩
  intro z hz
  obtain ⟨⟨m, hm⟩, hmz⟩ :=
    IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers f) z hz
  obtain ⟨n, rfl⟩ := hm
  have h0 : IsIntegral A ((f ^ n : A) • z) := hmz
  have h1 : IsIntegral (A ⧸ P) ((f ^ n : A) • z) := h0.tower_top
  obtain ⟨e, he⟩ := hcond _ h1
  obtain ⟨e', rfl⟩ := Ideal.Quotient.mk_surjective e
  have he' : algebraMap A (FractionRing (A ⧸ P)) e' =
      algebraMap A (FractionRing (A ⧸ P)) (f ^ (n + 1)) * z := by
    rw [hκ, he, Algebra.smul_def, Algebra.smul_def, ← mul_assoc, ← hκ, ← map_mul, ← pow_succ']
  have hu : IsUnit (algebraMap A B (f ^ (n + 1))) := by
    rw [map_pow]; exact hjf.pow _
  have hne : φ (algebraMap A B (f ^ (n + 1))) ≠ 0 := by
    rw [hφ, map_pow]; exact pow_ne_zero _ hκf
  refine ⟨algebraMap A B e' * ↑hu.unit⁻¹, ?_⟩
  apply mul_right_cancel₀ hne
  rw [hφalg, ← map_mul, mul_assoc, hu.val_inv_mul, mul_one, hφ, hφ, he', mul_comm]

theorem generic_points_scheme : ∀ (Ω : Type u) [Field Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR], ∃ (X : Scheme.{u}) (g : X ⟶ R), QuasiCompact g ∧ QuasiSeparated g ∧ ∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra; Nonempty (Γ(X, g ⁻¹ᵁ V) ≃ₐ[Γ(R, V)] ((P : {P : PrimeSpectrum Γ(R, V) // P.asIdeal ∈ minimalPrimes Γ(R, V)}) → Localization.AtPrime P.1.asIdeal)) :=
by

  have s1 : ∀ (α : Type u) [TopologicalSpace α] [QuasiSober α] [TopologicalSpace.NoetherianSpace α], {x : α | ∀ y : α, y ⤳ x → y = x}.Finite := by
    intro α _ _ _
    refine Set.Finite.of_injOn (f := fun x => closure ({x} : Set α)) (t := irreducibleComponents α) ?_ ?_
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    · intro x hx
      refine ⟨isIrreducible_singleton.closure, fun S hS hsub => ?_⟩
      obtain ⟨z, hz⟩ := QuasiSober.sober hS.closure isClosed_closure
      have hx' : x ∈ closure S := subset_closure (hsub (subset_closure rfl))
      have hzx : z ⤳ x := by rw [specializes_iff_mem_closure, hz.def]; exact hx'
      have hzx' : z = x := hx z hzx
      subst hzx'
      intro s hs
      show s ∈ closure ({z} : Set α)
      rw [hz.def]
      exact subset_closure hs
    · intro x hx x' _ hxx
      have h1 : x ∈ closure ({x'} : Set α) := by
        have : x ∈ closure ({x} : Set α) := subset_closure rfl
        simpa [hxx] using this
      exact (hx x' (specializes_iff_mem_closure.mpr h1)).symm

  have s2 : ∀ (σ : Type u) (Y : σ → Scheme.{u}) (R : Scheme.{u}) (f : ∀ i, Y i ⟶ R) (V : R.Opens), ∃ e : Γ(∐ Y, (Limits.Sigma.desc f) ⁻¹ᵁ V) ≃+* ((i : σ) → Γ(Y i, (f i) ⁻¹ᵁ V)), ∀ (a : Γ(R, V)) (i : σ), e (((Limits.Sigma.desc f).app V).hom a) i = ((f i).app V).hom a := by
    intro σ Y R f V
    set g := Limits.Sigma.desc f with hg
    set W := g ⁻¹ᵁ V with hW
    let ι := fun i => Limits.Sigma.ι Y i
    have h : ∀ i, (f i) ⁻¹ᵁ V = (ι i) ⁻¹ᵁ W := fun i => by
      rw [hW, ← Scheme.Hom.comp_preimage, hg, Limits.Sigma.ι_comp_desc]
    let ρ : ∀ i, Γ(∐ Y, W) ⟶ Γ(Y i, (f i) ⁻¹ᵁ V) := fun i =>
      (ι i).app W ≫ (Y i).presheaf.map (eqToHom (h i)).op
    have helper : ∀ {Z : Scheme.{u}} (φ ψ : Z ⟶ R), φ = ψ → ∀ (h1 : ψ ⁻¹ᵁ V = φ ⁻¹ᵁ V),
        φ.app V ≫ Z.presheaf.map (eqToHom h1).op = ψ.app V := by
      intro Z φ ψ e h1
      subst e
      simp
    have key : ∀ i, g.app V ≫ ρ i = (f i).app V := by
      intro i
      simp only [ρ, ← Category.assoc]
      rw [← Scheme.Hom.comp_app]
      exact helper _ _ (Limits.Sigma.ι_comp_desc f i) _
    let U : σ → (∐ Y).Opens := fun i => (ι i) ''ᵁ ((ι i) ⁻¹ᵁ W)
    have hUW : ∀ i, U i ≤ W := fun i => by
      simp only [U, Scheme.Hom.image_preimage_eq_opensRange_inf]; exact inf_le_right
    have hcov : W ≤ iSup U := by
      intro x hx
      obtain ⟨⟨i, y⟩, rfl⟩ := (sigmaMk Y).surjective x
      rw [sigmaMk_mk] at hx ⊢
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨i, ?_⟩
      show _ ∈ U i
      simp only [U, Scheme.Hom.image_preimage_eq_opensRange_inf]
      exact ⟨⟨y, rfl⟩, hx⟩
    have hdisj : ∀ i j, i ≠ j → U i ⊓ U j = ⊥ := by
      intro i j hij
      have := disjoint_opensRange_sigmaι Y i j hij
      simp only [U, Scheme.Hom.image_preimage_eq_opensRange_inf]
      exact eq_bot_iff.mpr (le_trans (inf_le_inf inf_le_left inf_le_left) this.le_bot)
    have happ : ∀ i, (ι i).app W =
        (∐ Y).presheaf.map (homOfLE (hUW i)).op ≫ ((ι i).appIso ((ι i) ⁻¹ᵁ W)).hom := by
      intro i
      rw [← cancel_mono ((ι i).appIso ((ι i) ⁻¹ᵁ W)).inv, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
      exact Scheme.Hom.app_appIso_inv _ _
    let Φ : Γ(∐ Y, W) →+* ((i : σ) → Γ(Y i, (f i) ⁻¹ᵁ V)) := RingHom.pi (fun i => (ρ i).hom)
    have hinj : Function.Injective Φ := by
      intro s t hst
      apply TopCat.Sheaf.eq_of_locally_eq' (∐ Y).sheaf U W (fun i => homOfLE (hUW i)) hcov
      intro i
      have h1 : (ρ i).hom s = (ρ i).hom t := congrFun hst i
      have h2 : ((ι i).app W).hom s = ((ι i).app W).hom t := by
        have := congrArg ((Y i).presheaf.map (eqToHom (h i).symm).op).hom h1
        simpa [ρ] using this
      rw [happ] at h2
      have h3 := congrArg ((ι i).appIso ((ι i) ⁻¹ᵁ W)).inv.hom h2
      simp at h3
      exact h3
    have hsurj : Function.Surjective Φ := by
      intro z
      let sf : ∀ i, Γ(∐ Y, U i) := fun i => ((ι i).appIso ((ι i) ⁻¹ᵁ W)).inv.hom
        (((Y i).presheaf.map (eqToHom (h i).symm).op).hom (z i))
      have hsub : ∀ (O : (∐ Y).Opens), O = ⊥ → Subsingleton Γ(∐ Y, O) := by
        intro O hO; subst hO; infer_instance
      have hcomp : TopCat.Presheaf.IsCompatible (∐ Y).sheaf.obj U sf := by
        intro i j
        by_cases hij : i = j
        · subst hij; rfl
        · exact @Subsingleton.elim _ (hsub _ (hdisj i j hij)) _ _
      obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' (∐ Y).sheaf U W
        (fun i => homOfLE (hUW i)) hcov sf hcomp
      refine ⟨s, funext fun i => ?_⟩
      show (ρ i).hom s = z i
      have h1 : ((∐ Y).presheaf.map (homOfLE (hUW i)).op).hom s = sf i := hs i
      have e1 : (ρ i).hom s = ((Y i).presheaf.map (eqToHom (h i)).op).hom
          (((ι i).appIso ((ι i) ⁻¹ᵁ W)).hom.hom (sf i)) := by
        rw [← h1]
        simp only [ρ, happ, CommRingCat.hom_comp]
        rfl
      rw [e1]
      simp [sf]
    refine ⟨RingEquiv.ofBijective Φ ⟨hinj, hsurj⟩, fun a i => ?_⟩
    show (ρ i).hom ((g.app V).hom a) = _
    rw [← key i]
    rfl

  have s3 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V) (η : R) (hη : η ∈ V), ∃ e : Γ(Spec (R.presheaf.stalk η), (R.fromSpecStalk η) ⁻¹ᵁ V) ≃+* Localization.AtPrime (hV.primeIdealOf ⟨η, hη⟩).asIdeal, ∀ a : Γ(R, V), e (((R.fromSpecStalk η).app V).hom a) = algebraMap Γ(R, V) (Localization.AtPrime (hV.primeIdealOf ⟨η, hη⟩).asIdeal) a := by
    intro R V hV η hη
    have hpre : (R.fromSpecStalk η) ⁻¹ᵁ V = ⊤ := by
      apply top_le_iff.mp
      intro x _
      have h1 : R.fromSpecStalk η x ∈ Set.range (R.fromSpecStalk η) := ⟨x, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h1
      exact (h1 : R.fromSpecStalk η x ⤳ η).mem_open V.isOpen hη
    let r : Γ(Spec (R.presheaf.stalk η), ⊤) ⟶ Γ(Spec (R.presheaf.stalk η), (R.fromSpecStalk η) ⁻¹ᵁ V) :=
      (Spec (R.presheaf.stalk η)).presheaf.map (homOfLE le_top).op
    haveI : IsIso r := by
      have : IsIso (homOfLE (le_top : (R.fromSpecStalk η) ⁻¹ᵁ V ≤ ⊤)) :=
        ⟨⟨homOfLE hpre.ge, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      exact Functor.map_isIso _ _
    let ψ := (Scheme.ΓSpecIso (R.presheaf.stalk η)).inv ≫ r
    let α : R.presheaf.stalk η ≃+* Γ(Spec (R.presheaf.stalk η), (R.fromSpecStalk η) ⁻¹ᵁ V) :=
      (asIso ψ).commRingCatIsoToRingEquiv
    letI : Algebra Γ(R, V) (R.presheaf.stalk η) :=
      TopCat.Presheaf.algebra_section_stalk R.presheaf ⟨η, hη⟩
    haveI := hV.isLocalization_stalk ⟨η, hη⟩
    let β : R.presheaf.stalk η ≃ₐ[Γ(R, V)] Localization.AtPrime (hV.primeIdealOf ⟨η, hη⟩).asIdeal :=
      IsLocalization.algEquiv (hV.primeIdealOf ⟨η, hη⟩).asIdeal.primeCompl _ _
    refine ⟨α.symm.trans β.toRingEquiv, fun a => ?_⟩
    have happ : (R.fromSpecStalk η).app V = R.presheaf.germ V η hη ≫ ψ := Scheme.fromSpecStalk_app hη
    rw [happ, CommRingCat.hom_comp, RingHom.comp_apply, RingEquiv.trans_apply]
    have : α.symm (ψ.hom ((R.presheaf.germ V η hη).hom a)) = (R.presheaf.germ V η hη).hom a :=
      α.symm_apply_apply _
    rw [this]
    exact β.commutes a

  have s4 : ∀ (R : Scheme.{u}) (V : R.Opens) (η : R), (∀ y : R, y ⤳ η → y = η) → η ∉ V → Subsingleton Γ(Spec (R.presheaf.stalk η), (R.fromSpecStalk η) ⁻¹ᵁ V) := by
    intro R V η hgen hη
    have hpre : (R.fromSpecStalk η) ⁻¹ᵁ V = ⊥ := by
      apply le_bot_iff.mp
      intro x hx
      exfalso
      have h1 : R.fromSpecStalk η x ∈ Set.range (R.fromSpecStalk η) := ⟨x, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h1
      have h2 := hgen _ h1
      apply hη
      have hx' : R.fromSpecStalk η x ∈ V := hx
      rw [h2] at hx'
      exact hx'
    rw [hpre]
    infer_instance

  have s5 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V), (∀ (y : R) (hy : y ∈ V), (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(R, V) ↔ ∀ y' : R, y' ⤳ y → y' = y) ∧ ∀ P : PrimeSpectrum Γ(R, V), ∃ h : hV.fromSpec P ∈ V, hV.primeIdealOf ⟨hV.fromSpec P, h⟩ = P := by
    intro R V hV
    have hsnd : ∀ P : PrimeSpectrum Γ(R, V), ∃ h : hV.fromSpec P ∈ V, hV.primeIdealOf ⟨hV.fromSpec P, h⟩ = P := by
      intro P
      have h : hV.fromSpec P ∈ V := by
        have : hV.fromSpec P ∈ Set.range hV.fromSpec := ⟨P, rfl⟩
        rw [hV.range_fromSpec] at this
        exact this
      refine ⟨h, hV.fromSpec.isOpenEmbedding.injective ?_⟩
      exact hV.fromSpec_primeIdealOf ⟨_, h⟩
    refine ⟨fun y hy => ⟨fun hmin y' hy' => ?_, fun hgen => ?_⟩, hsnd⟩
    · have hy'V : y' ∈ V := hy'.mem_open V.isOpen hy
      have hq : hV.fromSpec (hV.primeIdealOf ⟨y', hy'V⟩) = y' := hV.fromSpec_primeIdealOf _
      have hp : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf _
      have hsp : hV.fromSpec (hV.primeIdealOf ⟨y', hy'V⟩) ⤳ hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) := by
        rw [hq, hp]; exact hy'
      have hsp' := hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hsp
      have hle := (PrimeSpectrum.le_iff_specializes _ _).mpr hsp'
      have hge := hmin.2 ⟨(hV.primeIdealOf ⟨y', hy'V⟩).isPrime, bot_le⟩ hle
      have heq : hV.primeIdealOf ⟨y', hy'V⟩ = hV.primeIdealOf ⟨y, hy⟩ :=
        PrimeSpectrum.ext (le_antisymm hle hge)
      rw [← hq, ← hp, heq]
    · have hfy : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
      refine ⟨⟨(hV.primeIdealOf ⟨y, hy⟩).isPrime, bot_le⟩, fun q ⟨hq, _⟩ hle => ?_⟩
      let q' : PrimeSpectrum Γ(R, V) := ⟨q, hq⟩
      have hsp : q' ⤳ hV.primeIdealOf ⟨y, hy⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h1 : hV.fromSpec q' ⤳ y := hfy ▸ hsp.map hV.fromSpec.continuous
      have h2 : hV.fromSpec q' = hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) :=
        (hgen _ h1).trans hfy.symm
      have h3 := hV.fromSpec.isOpenEmbedding.injective h2
      have : q' = hV.primeIdealOf ⟨y, hy⟩ := h3
      rw [← this]

  have s6 : ∀ (A : Type u) [CommRing A] (σ : Type u) (F : σ → Type u) [∀ i, CommRing (F i)] (φ : ∀ i, A →+* F i) (S : Set σ) (ι : Type u) (L : ι → Type u) [∀ j, CommRing (L j)] [∀ j, Algebra A (L j)] (b : S → ι), Function.Bijective b → ∀ e : ∀ s : S, F s ≃+* L (b s), (∀ (s : S) (a : A), e s (φ s a) = algebraMap A (L (b s)) a) → (∀ i ∉ S, Subsingleton (F i)) → ∃ Ψ : ((i : σ) → F i) ≃+* ((j : ι) → L j), ∀ (a : A) (j : ι), Ψ (fun i => φ i a) j = algebraMap A (L j) a := by
    intro A _ σ F _ φ S ι L _ _ b hb e he hsub
    classical
    let Ψ₁ : ((i : σ) → F i) →+* ((s : S) → F s) := RingHom.pi (fun s => Pi.evalRingHom F s.1)
    have hΨ₁ : Function.Bijective Ψ₁ := by
      constructor
      · intro x y hxy
        funext i
        by_cases hi : i ∈ S
        · exact congrFun hxy ⟨i, hi⟩
        · exact @Subsingleton.elim _ (hsub i hi) _ _
      · intro z
        refine ⟨fun i => if hi : i ∈ S then z ⟨i, hi⟩ else 0, ?_⟩
        funext s
        show (if hi : s.1 ∈ S then z ⟨s.1, hi⟩ else 0) = z s
        rw [dif_pos s.2]
    let E1 := RingEquiv.ofBijective Ψ₁ hΨ₁
    let E2 : ((s : S) → F s) ≃+* ((s : S) → L (b s)) := RingEquiv.piCongrRight e
    let E3 : ((s : S) → L (b s)) ≃+* ((j : ι) → L j) :=
      RingEquiv.piCongrLeft L (Equiv.ofBijective b hb)
    refine ⟨(E1.trans E2).trans E3, fun a j => ?_⟩
    obtain ⟨s, rfl⟩ := hb.2 j
    have h3 : ∀ w : (s : S) → L (b s), E3 w (b s) = w s := by
      intro w
      exact Equiv.piCongrLeft_apply_apply L (Equiv.ofBijective b hb) w s
    rw [RingEquiv.trans_apply, h3]
    show e s (φ s a) = _
    exact he s a

  intro Ω _ R fR _
  classical
  haveI := QuasiCompact.compactSpace_of_compactSpace fR
  haveI := LocallyOfFiniteType.isLocallyNoetherian fR
  haveI : AlgebraicGeometry.IsNoetherian R := AlgebraicGeometry.IsNoetherian.mk
  have hT := s1 R
  set T : Set R := {x : R | ∀ y : R, y ⤳ x → y = x} with hTdef
  haveI : Finite T := hT.to_subtype
  let Y : T → Scheme.{u} := fun η => Spec (R.presheaf.stalk η.1)
  let f : ∀ η : T, Y η ⟶ R := fun η => R.fromSpecStalk η.1
  let g : (∐ Y) ⟶ R := Limits.Sigma.desc f
  haveI : IsAffineHom (g ≫ fR) := isAffineHom_of_isAffine _
  haveI : IsAffineHom g := IsAffineHom.of_comp g fR
  refine ⟨∐ Y, g, inferInstance, inferInstance, ?_⟩
  intro V
  letI := (g.app V).hom.toAlgebra
  obtain ⟨E, hE⟩ := s2 T Y R f V
  have hV : IsAffineOpen (V : R.Opens) := V.2
  let S : Set T := {η | η.1 ∈ (V : R.Opens)}
  let ι := {P : PrimeSpectrum Γ(R, V) // P.asIdeal ∈ minimalPrimes Γ(R, V)}
  obtain ⟨h5a, h5b⟩ := s5 R V hV
  let b : S → ι := fun s => ⟨hV.primeIdealOf ⟨s.1.1, s.2⟩, (h5a s.1.1 s.2).mpr s.1.2⟩
  have hb : Function.Bijective b := by
    constructor
    · intro s s' hss
      have h1 : hV.primeIdealOf ⟨s.1.1, s.2⟩ = hV.primeIdealOf ⟨s'.1.1, s'.2⟩ :=
        congrArg Subtype.val hss
      have h2 := congrArg hV.fromSpec h1
      rw [hV.fromSpec_primeIdealOf, hV.fromSpec_primeIdealOf] at h2
      exact Subtype.ext (Subtype.ext h2)
    · rintro ⟨P, hP⟩
      obtain ⟨h, hPeq⟩ := h5b P
      have hP' : (hV.primeIdealOf ⟨hV.fromSpec P, h⟩).asIdeal ∈ minimalPrimes Γ(R, V) := by
        rw [hPeq]; exact hP
      have hgen := (h5a _ h).mp hP'
      exact ⟨⟨⟨hV.fromSpec P, hgen⟩, h⟩, Subtype.ext hPeq⟩
  let F : T → Type u := fun η => Γ(Y η, (f η) ⁻¹ᵁ V)
  let φ : ∀ η : T, Γ(R, V) →+* F η := fun η => ((f η).app V).hom
  let L : ι → Type u := fun j => Localization.AtPrime j.1.asIdeal
  choose e he using fun s : S => s3 R V hV s.1.1 s.2
  have hsub : ∀ η ∉ S, Subsingleton (F η) := fun η hη =>
    s4 R V η.1 η.2 hη
  obtain ⟨Ψ, hΨ⟩ := s6 Γ(R, V) T F φ S ι L b hb e he hsub
  refine ⟨AlgEquiv.ofRingEquiv (f := E.trans Ψ) ?_⟩
  intro a
  funext j
  rw [RingEquiv.trans_apply, RingHom.algebraMap_toAlgebra]
  have : E ((g.app V).hom a) = fun η => φ η a := funext (hE a)
  rw [this, hΨ, Pi.algebraMap_apply]

theorem wc_reduced_curve_normalization : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (R : Scheme.{u})
    (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R],
    topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∃ (X' : Scheme.{u}) (b : X' ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R),
      IsProper b ∧ IsClosedImmersion iZ ∧
      (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧
      (∀ x : X', IsDomain (X'.presheaf.stalk x) ∧ IsIntegrallyClosed (X'.presheaf.stalk x)) ∧
      topologicalKrullDim X' ≤ ((1 : ℕ) : WithBot ℕ∞) ∧
      topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞) ∧
      topologicalKrullDim ↥(Limits.pullback b iZ) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by

  have s0 : ∀ (Ω : Type u) [Field Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR]
      (V : R.affineOpens), ∃ φ : Ω →+* Γ(R, V), φ.FiniteType := by
    intro Ω _ R fR _ V
    have h := HasRingHomProperty.appLE @LocallyOfFiniteType fR inferInstance
      ⟨⊤, isAffineOpen_top _⟩ V (by simp)
    refine ⟨(fR.appLE ⊤ V.1 (by simp)).hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom, ?_⟩
    exact h.comp (RingHom.FiniteType.of_surjective _
      (Scheme.ΓSpecIso (.of Ω)).commRingCatIsoToRingEquiv.symm.surjective)

  have s4b : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] (L : Type u)
      [CommRing L] [Algebra B L], Nonempty (L ≃ₐ[B] ((P : {P : PrimeSpectrum B //
        P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)) →
      Function.Bijective (algebraMap B (integralClosure B L)) := by
    intro B _ _ _ L _ _ ⟨e⟩
    have hmin : (⊥ : Ideal B) ∈ minimalPrimes B := by
      refine ⟨⟨Ideal.isPrime_bot, bot_le⟩, fun q _ _ => bot_le⟩
    let P0 : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B} :=
      ⟨⟨⊥, Ideal.isPrime_bot⟩, hmin⟩
    have huniq : ∀ P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}, P = P0 := by
      intro P
      apply Subtype.ext
      apply PrimeSpectrum.ext
      exact le_antisymm (P.2.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le) bot_le
    haveI : IsFractionRing B (Localization.AtPrime P0.1.asIdeal) := by
      have : P0.1.asIdeal.primeCompl = nonZeroDivisors B := by
        ext x; simp [Ideal.primeCompl, P0, mem_nonZeroDivisors_iff_ne_zero]
      show IsLocalization (nonZeroDivisors B) _
      rw [← this]; infer_instance
    let π : L →ₐ[B] Localization.AtPrime P0.1.asIdeal := (Pi.evalAlgHom B _ P0).comp e.toAlgHom
    have hπinj : Function.Injective π := by
      intro x y hxy
      apply e.injective
      funext P
      rw [huniq P]
      exact hxy
    constructor
    · intro a a' h
      have h2 : algebraMap B L a = algebraMap B L a' := congrArg Subtype.val h
      have h3 := congrArg π h2
      rw [π.commutes, π.commutes] at h3
      exact IsFractionRing.injective B _ h3
    · rintro ⟨x, hx⟩
      have hx' : IsIntegral B (π x) := hx.map π
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hx'
      refine ⟨a, Subtype.ext (hπinj ?_)⟩
      show π (algebraMap B L a) = π x
      rw [π.commutes, ha]

  have s6a : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
      (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        Module.Finite Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) →
      IsFinite (Scheme.Hom.fromNormalization g) := by
    intro X R g _ _ h
    rw [isFinite_iff]
    refine ⟨inferInstance, fun U hU => ?_⟩
    rw [Scheme.Hom.fromNormalization_app g hU]
    letI := (g.app U).hom.toAlgebra
    have h1 := h ⟨U, hU⟩
    rw [CommRingCat.hom_comp]
    apply RingHom.Finite.comp
    · exact RingHom.Finite.of_surjective _
        (Scheme.Hom.normalizationObjIso g hU).commRingCatIsoToRingEquiv.symm.surjective
    · exact RingHom.finite_algebraMap.mpr h1

  have s6b : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
      (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        ∀ (Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) [Q.IsPrime],
          IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) →
      ∀ x : Scheme.Hom.normalization g,
        IsDomain ((Scheme.Hom.normalization g).presheaf.stalk x) ∧
        IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk x) := by
    intro X R g _ _ h x
    set b := Scheme.Hom.fromNormalization g
    obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
    have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
      (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
    let p := (hW.primeIdealOf ⟨x, hx⟩).asIdeal
    let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := p.comap e.symm.toRingHom
    haveI : Q.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨hd, hic⟩ := h ⟨V, hV⟩ Q
    set y : (b ⁻¹ᵁ V : Scheme) := ⟨x, hx⟩
    show IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) ∧
      IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk y.1)
    letI : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
        ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf y
    haveI := hW.isLocalization_stalk y
    have hM : p.primeCompl.map e.toMonoidHom = Q.primeCompl := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        show e.symm (e w) ∉ p
        rw [e.symm_apply_apply]
        exact hw
      · intro hz
        exact ⟨e.symm z, hz, e.apply_symm_apply z⟩
    let f : (Scheme.Hom.normalization g).presheaf.stalk y.1 ≃+* Localization.AtPrime Q :=
      IsLocalization.ringEquivOfRingEquiv (M := p.primeCompl) (T := Q.primeCompl) _ _ e hM
    haveI : IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      MulEquiv.isDomain _ f.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv f.symm⟩

  have s6c : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g] (W : R.Opens),
      IsAffineOpen W → (letI := (g.app W).hom.toAlgebra;
        Function.Bijective (algebraMap Γ(R, W) (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) →
      IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro X R g _ _ W hW hbij
    set b := Scheme.Hom.fromNormalization g
    haveI : IsAffine W := hW
    haveI : IsAffine (b ⁻¹ᵁ W : Scheme) := hW.preimage b
    have hiso : IsIso (b.app W) := by
      rw [Scheme.Hom.fromNormalization_app g hW]
      letI := (g.app W).hom.toAlgebra
      haveI : IsIso (CommRingCat.ofHom (algebraMap Γ(R, W)
          (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) :=
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
      infer_instance
    have hiso' : ∀ U' : R.Opens, U' = W → IsIso (b.app U') := by
      rintro U' rfl; exact hiso
    have htop : IsIso (Scheme.Hom.appTop (b ∣_ W)) := by
      rw [morphismRestrict_appTop]
      have h3 := hiso' _ (Scheme.Opens.ι_image_top W)
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ h3 (Functor.map_isIso _ _)
    have := Scheme.isoSpec_hom_naturality (b ∣_ W)
    have h2 : b ∣_ W = (b ⁻¹ᵁ W : Scheme).isoSpec.hom ≫ Spec.map (Scheme.Hom.appTop (b ∣_ W)) ≫
        (W : Scheme).isoSpec.inv := by
      rw [← Category.assoc, this]; simp
    rw [h2]
    infer_instance

  have s7 : ∀ (X Y : Scheme.{u}) (b : X ⟶ Y) [IsIntegralHom b],
      topologicalKrullDim X ≤ topologicalKrullDim Y := by
    intro X Y b _
    have incomp : ∀ (t t' : X), t' ⤳ t → b t = b t' → t = t' := by
      intro t t' hsp heq
      obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b t) (U := ⊤) trivial
      have ht : t ∈ b ⁻¹ᵁ V := hbV
      have ht' : t' ∈ b ⁻¹ᵁ V := by
        show b t' ∈ V
        rw [← heq]; exact hbV
      haveI : IsAffine (V : Scheme) := hV
      haveI : IsAffine (b ⁻¹ᵁ V : Scheme) := hV.preimage b
      let x : (b ⁻¹ᵁ V : Scheme) := ⟨t, ht⟩
      let x' : (b ⁻¹ᵁ V : Scheme) := ⟨t', ht'⟩
      have hxsp : x' ⤳ x := by
        rw [← (b ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.specializes_iff]
        exact hsp
      have hxne : x = x' → t = t' := fun h => congrArg Subtype.val h
      have himg : (b ∣_ V) x = (b ∣_ V) x' := by
        apply V.ι.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι,
          Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
        exact heq
      apply hxne
      by_contra hne
      set e := (b ⁻¹ᵁ V : Scheme).isoSpec
      set φ := Scheme.Hom.appTop (b ∣_ V)
      have hnat := Scheme.isoSpec_hom_naturality (b ∣_ V)
      have hφ : φ.hom.IsIntegral := by
        have := IsIntegralHom.isIntegral_app (b ∣_ V) ⊤ (isAffineOpen_top _)
        exact this
      let s := e.hom x
      let s' := e.hom x'
      have hssp : s' ⤳ s := hxsp.map e.hom.continuous
      have hsne : s ≠ s' := fun h => hne (e.hom.isOpenEmbedding.injective h)
      have hlt : s'.asIdeal < s.asIdeal :=
        lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes s' s).mpr hssp)
          (fun h => hsne (PrimeSpectrum.ext h).symm)
      letI := φ.hom.toAlgebra
      haveI : Algebra.IsIntegral _ _ := ⟨hφ⟩
      haveI := s'.isPrime
      have hlt' := Ideal.IsIntegral.under_lt_under (R := Γ((V : Scheme), ⊤)) hlt
      have h1 : (Spec.map φ) s = (V : Scheme).isoSpec.hom ((b ∣_ V) x) := by
        rw [← Scheme.Hom.comp_apply, hnat, Scheme.Hom.comp_apply]
      have h1' : (Spec.map φ) s' = (V : Scheme).isoSpec.hom ((b ∣_ V) x') := by
        rw [← Scheme.Hom.comp_apply, hnat, Scheme.Hom.comp_apply]
      have h2 : (Spec.map φ) s = (Spec.map φ) s' := by rw [h1, h1', himg]
      have h3 : ((Spec.map φ) s).asIdeal = Ideal.under _ s.asIdeal := rfl
      have h3' : ((Spec.map φ) s').asIdeal = Ideal.under _ s'.asIdeal := rfl
      rw [← h3, ← h3', h2] at hlt'
      exact lt_irrefl _ hlt'
    have hcl : ∀ (a c : Y), c ⤳ a → a ≠ c →
        (⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩ :
          TopologicalSpace.IrreducibleCloseds Y) <
        ⟨closure {c}, isIrreducible_singleton.closure, isClosed_closure⟩ := by
      intro a c hca hac
      refine lt_of_le_of_ne ?_ ?_
      · show closure {a} ⊆ closure {c}
        exact specializes_iff_closure_subset.mp hca
      · intro h
        have h' : closure ({a} : Set Y) = closure {c} :=
          congrArg TopologicalSpace.IrreducibleCloseds.carrier h
        have hac' : a ⤳ c := specializes_iff_closure_subset.mpr h'.ge
        exact hac (hac'.antisymm hca).eq
    let F : TopologicalSpace.IrreducibleCloseds X → TopologicalSpace.IrreducibleCloseds Y :=
      fun T => ⟨closure {b T.isIrreducible.genericPoint}, isIrreducible_singleton.closure,
        isClosed_closure⟩
    have hF : StrictMono F := by
      intro T T' hTT'
      have hgT := T.isIrreducible.isGenericPoint_genericPoint_closure
      have hgT' := T'.isIrreducible.isGenericPoint_genericPoint_closure
      rw [T.isClosed.closure_eq] at hgT
      rw [T'.isClosed.closure_eq] at hgT'
      have htT : T.isIrreducible.genericPoint ∈ (T : Set X) := hgT.mem
      have hsp : T'.isIrreducible.genericPoint ⤳ T.isIrreducible.genericPoint :=
        hgT'.specializes (hTT'.le htT)
      have hne : T.isIrreducible.genericPoint ≠ T'.isIrreducible.genericPoint := by
        intro heq
        apply hTT'.ne
        apply TopologicalSpace.IrreducibleCloseds.ext
        rw [← hgT.def, ← hgT'.def, heq]
      exact hcl _ _ (hsp.map b.continuous) (fun h => hne (incomp _ _ hsp h))
    exact Order.krullDim_le_of_strictMono F hF

  have s8 : ∀ (R Z : Scheme.{u}) (iZ : Z ⟶ R) [IsClosedImmersion iZ],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      (∀ z : Z, ∃ y : R, y ⤳ iZ z ∧ y ≠ iZ z) →
      topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro R Z iZ _ hR hgen
    have hcl : ∀ (a b : R), b ⤳ a → a ≠ b →
        (⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩ :
          TopologicalSpace.IrreducibleCloseds R) <
        ⟨closure {b}, isIrreducible_singleton.closure, isClosed_closure⟩ := by
      intro a b hba hab
      refine lt_of_le_of_ne ?_ ?_
      · show closure {a} ⊆ closure {b}
        exact specializes_iff_closure_subset.mp hba
      · intro h
        have h' : closure ({a} : Set R) = closure {b} :=
          congrArg TopologicalSpace.IrreducibleCloseds.carrier h
        have hab' : a ⤳ b := specializes_iff_closure_subset.mpr h'.ge
        exact hab (hab'.antisymm hba).eq
    unfold topologicalKrullDim
    show Order.krullDim (TopologicalSpace.IrreducibleCloseds Z) ≤ ((0 : ℕ∞) : WithBot ℕ∞)
    rw [WithBot.coe_zero, Order.krullDim_nonpos_iff_forall_isMax]
    intro T T' hTT'
    have hgT := T.isIrreducible.isGenericPoint_genericPoint_closure
    have hgT' := T'.isIrreducible.isGenericPoint_genericPoint_closure
    rw [T.isClosed.closure_eq] at hgT
    rw [T'.isClosed.closure_eq] at hgT'
    set t := T.isIrreducible.genericPoint
    set t' := T'.isIrreducible.genericPoint
    have htT : t ∈ (T : Set Z) := hgT.mem
    have hsp : t' ⤳ t := hgT'.specializes (hTT' htT)
    by_cases heq : t = t'
    · show (T' : Set Z) ⊆ T
      rw [← hgT.def, ← hgT'.def, heq]
    · exfalso
      have hsp' : iZ t' ⤳ iZ t := hsp.map iZ.continuous
      have hne' : iZ t ≠ iZ t' := fun h => heq (iZ.isClosedEmbedding.injective h)
      obtain ⟨y, hy, hyne⟩ := hgen t'
      have l1 := hcl _ _ hsp' hne'
      have l2 := hcl _ _ hy hyne.symm
      have hR' : Order.krullDim (TopologicalSpace.IrreducibleCloseds R) ≤ 1 := by
        have := hR; unfold topologicalKrullDim at this; exact_mod_cast this
      rcases Order.krullDim_le_one_iff.mp hR'
          ⟨closure {iZ t'}, isIrreducible_singleton.closure, isClosed_closure⟩ with h | h
      · exact (h.not_lt l1)
      · exact (h.not_lt l2)

  have s9 : ∀ (R : Scheme.{u}) (N : Set R), IsClosed N →
      ∃ (Z : Scheme.{u}) (iZ : Z ⟶ R), IsClosedImmersion iZ ∧ Set.range iZ = N := by
    intro R N hN
    refine ⟨(Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subscheme,
      (Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subschemeι, inferInstance, ?_⟩
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl

  have s10 : ∀ (X R : Scheme.{u}) (b : X ⟶ R) (U : R.Opens),
      (∀ y ∈ U, ∃ V : R.Opens, y ∈ V ∧ IsIso (b ∣_ V)) → IsIso (b ∣_ U) := by
    intro X R b U h
    have hmono : ∀ (V W : R.Opens), W ≤ V → IsIso (b ∣_ V) → IsIso (b ∣_ W) := by
      intro V W hWV hV
      have h1 : IsIso ((b ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)) :=
        IsZariskiLocalAtTarget.restrict (P := MorphismProperty.isomorphisms Scheme) hV _
      have e : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hWV
      have h2 := (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b V (V.ι ⁻¹ᵁ W)) |>.mp h1
      rw [e] at h2
      exact h2
    choose! V hyV hV using h
    have key : ∀ y : U, IsIso ((b ∣_ U) ∣_ (U.ι ⁻¹ᵁ V y.1)) := by
      intro y
      have h1 : IsIso (b ∣_ (U.ι ''ᵁ (U.ι ⁻¹ᵁ V y.1))) := by
        apply hmono (V y.1) _ _ (hV y.1 y.2)
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
        exact inf_le_right
      exact (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b U (U.ι ⁻¹ᵁ V y.1)) |>.mpr h1
    have htop : ⨆ y : U, U.ι ⁻¹ᵁ V y.1 = ⊤ := by
      rw [eq_top_iff]
      intro z _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hyV z.1 z.2⟩
    exact (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := MorphismProperty.isomorphisms Scheme) _ htop).mpr key

  have s12 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V) (y : R) (hy : y ∈ V),
      ((∀ y' : R, y' ⤳ y → y' = y) →
        (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(R, V)) ∧
      ∀ f : Γ(R, V), f ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal → y ∈ R.basicOpen f := by
    intro R V hV y hy
    have hfy : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
    refine ⟨fun hgen => ?_, fun f hf => ?_⟩
    · refine ⟨⟨(hV.primeIdealOf ⟨y, hy⟩).isPrime, bot_le⟩, fun q ⟨hq, _⟩ hle => ?_⟩
      let q' : PrimeSpectrum Γ(R, V) := ⟨q, hq⟩
      have hsp : q' ⤳ hV.primeIdealOf ⟨y, hy⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h1 : hV.fromSpec q' ⤳ y := hfy ▸ hsp.map hV.fromSpec.continuous
      have h2 : hV.fromSpec q' = hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) :=
        (hgen _ h1).trans hfy.symm
      have h3 := hV.fromSpec.isOpenEmbedding.injective h2
      have : q' = hV.primeIdealOf ⟨y, hy⟩ := h3
      rw [← this]
    · have h1 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen f := hf
      rw [← hV.fromSpec_preimage_basicOpen] at h1
      have h2 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ R.basicOpen f := h1
      rwa [hfy] at h2

  intro Ω _ _ R fR _ _ hR
  obtain ⟨X, g, hqc, hqs, hL⟩ := generic_points_scheme Ω R fR
  haveI := hqc
  haveI := hqs
  have hnoeth : ∀ (V : R.Opens) (hV : IsAffineOpen V), IsNoetherianRing Γ(R, V) := by
    intro V hV
    obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
    exact Algebra.FiniteType.isNoetherianRing Ω _
  have hfinP : ∀ (V : R.Opens) (hV : IsAffineOpen V), ∀ P ∈ minimalPrimes Γ(R, V),
      Module.Finite (Γ(R, V) ⧸ P)
        (integralClosure (Γ(R, V) ⧸ P) (FractionRing (Γ(R, V) ⧸ P))) := by
    intro V hV P hP
    obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
    haveI : P.IsPrime := hP.1.1
    exact noether_integralClosure_finite Ω (Γ(R, V) ⧸ P)
  haveI hfin : IsFinite (Scheme.Hom.fromNormalization g) := by
    apply s6a X R g
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_finite Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V) (hfinP V.1 V.2)
  have hnorm := s6b X R g (fun V => by
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_stalks_normal Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V))
  have hgen : ∀ y : R, (∀ y' : R, y' ⤳ y → y' = y) →
      ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro y hy
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    obtain ⟨hmin, hbasic⟩ := s12 R V hV y hyV
    haveI := hnoeth V hV
    obtain ⟨f, hf, hB⟩ := reduced_noetherian_generic_normal Γ(R, V) (hfinP V hV) _ (hmin hy)
    have hW : IsAffineOpen (R.basicOpen f) := hV.basicOpen f
    haveI := hV.isLocalization_basicOpen f
    obtain ⟨hdom, hic⟩ := hB Γ(R, R.basicOpen f)
    refine ⟨R.basicOpen f, hbasic f hf, ?_⟩
    apply s6c X R g _ hW
    letI := (g.app (R.basicOpen f)).hom.toAlgebra
    exact s4b Γ(R, R.basicOpen f) Γ(X, g ⁻¹ᵁ R.basicOpen f) (hL ⟨R.basicOpen f, hW⟩)
  let G : Set R := {y | ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W)}
  have hGopen : IsOpen G := by
    rw [isOpen_iff_forall_mem_open]
    rintro y ⟨W, hyW, hW⟩
    exact ⟨W, fun z hz => ⟨W, hz, hW⟩, W.isOpen, hyW⟩
  obtain ⟨Z, iZ, hiZ, hrange⟩ := s9 R Gᶜ hGopen.isClosed_compl
  haveI := hiZ
  have hnongen : ∀ z : Z, ∃ y' : R, y' ⤳ iZ z ∧ y' ≠ iZ z := by
    intro z
    have hz : iZ z ∈ Gᶜ := by rw [← hrange]; exact ⟨z, rfl⟩
    by_contra hcon
    push_neg at hcon
    obtain ⟨W, hyW, hW⟩ := hgen (iZ z) hcon
    exact hz ⟨W, hyW, hW⟩
  have hdZ := s8 R Z iZ hR hnongen
  refine ⟨Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g, Z, iZ, inferInstance, hiZ,
    ?_, hnorm, ?_, hdZ, ?_⟩
  · intro U hU
    apply s10 _ R _ U
    intro y hy
    have h : y ∈ (U : Set R) := hy
    rw [hU, hrange, compl_compl] at h
    exact h
  · exact (s7 _ _ (Scheme.Hom.fromNormalization g)).trans hR
  · exact (s7 _ _ (Limits.pullback.snd (Scheme.Hom.fromNormalization g) iZ)).trans hdZ

theorem wc_normal_split_component : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    Nonempty X →
    ∃ (Z : Scheme.{u}) (iZ : Z ⟶ X) (X' : Scheme.{u}) (b : X' ⟶ X),
      IsClosedImmersion iZ ∧ IsClosedImmersion b ∧
      (∀ U : X.Opens, (U : Set X) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧
      Disjoint (Set.range b) (Set.range iZ) ∧ IrreducibleSpace Z ∧
      (∀ z : Z, IsDomain (Z.presheaf.stalk z) ∧ IsIntegrallyClosed (Z.presheaf.stalk z)) ∧
      (∀ x : X', IsDomain (X'.presheaf.stalk x) ∧ IsIntegrallyClosed (X'.presheaf.stalk x)) ∧
      topologicalKrullDim Z ≤ topologicalKrullDim X ∧
      topologicalKrullDim X' ≤ topologicalKrullDim X ∧
      (irreducibleComponents X').ncard < (irreducibleComponents X).ncard :=
by
  intro Ω _ _ X fX _ hnorm hne
  classical

  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX
  haveI : IsNoetherian X := ⟨⟩
  have hfin : (irreducibleComponents X).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  have key : ∀ C ∈ irreducibleComponents X, ∀ x ∈ C,
      C = closure (Set.range (X.fromSpecStalk x)) := by
    intro C hC x hxC
    haveI : IsDomain (X.presheaf.stalk x) := (hnorm x).1
    have hG : IsIrreducible (Set.range (X.fromSpecStalk x)) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ _).image _
        (X.fromSpecStalk x).continuous.continuousOn
    have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
    have hgen : IsGenericPoint hC.prop.genericPoint C := by
      have := hC.prop.isGenericPoint_genericPoint_closure
      rwa [hCcl.closure_eq] at this
    have hηG : hC.prop.genericPoint ∈ Set.range (X.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]
      exact hgen.specializes hxC
    have hle : C ⊆ closure (Set.range (X.fromSpecStalk x)) := by
      rw [← hgen.def]
      exact closure_mono (Set.singleton_subset_iff.mpr hηG)
    exact hC.eq_of_le hG.closure hle
  have hdisj : ∀ C ∈ irreducibleComponents X, ∀ D ∈ irreducibleComponents X, C ≠ D →
      Disjoint C D := by
    intro C hC D hD hCD
    exact Set.disjoint_left.mpr fun x hxC hxD =>
      hCD ((key C hC x hxC).trans (key D hD x hxD).symm)

  obtain ⟨x₀⟩ := hne
  set Z₀ : Set X := irreducibleComponent x₀ with hZ₀def
  have hZ₀ : Z₀ ∈ irreducibleComponents X := irreducibleComponent_mem_irreducibleComponents x₀
  have hirr : IsIrreducible Z₀ := hZ₀.prop
  have hcl : IsClosed Z₀ := isClosed_of_mem_irreducibleComponents Z₀ hZ₀

  have hop : IsOpen Z₀ := by
    have hc : Z₀ᶜ = ⋃ C ∈ irreducibleComponents X \ {Z₀}, C := by
      ext y
      simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_diff, Set.mem_singleton_iff,
        exists_prop]
      constructor
      · intro hy
        exact ⟨irreducibleComponent y, ⟨irreducibleComponent_mem_irreducibleComponents y,
          fun h => hy (h ▸ mem_irreducibleComponent)⟩, mem_irreducibleComponent⟩
      · rintro ⟨C, ⟨hC, hCZ⟩, hyC⟩ hyZ
        exact Set.disjoint_left.mp (hdisj C hC Z₀ hZ₀ hCZ) hyC hyZ
    rw [← isClosed_compl_iff, hc]
    exact (hfin.subset Set.diff_subset).isClosed_biUnion
      fun C hC => isClosed_of_mem_irreducibleComponents C hC.1

  let UZ : X.Opens := ⟨Z₀, hop⟩
  let UX : X.Opens := ⟨Z₀ᶜ, hcl.isOpen_compl⟩
  have hrZ : Set.range UZ.ι = Z₀ := Scheme.Opens.range_ι UZ
  have hrX : Set.range UX.ι = Z₀ᶜ := Scheme.Opens.range_ι UX
  have hiZ : IsClosedImmersion UZ.ι :=
    IsClosedImmersion.of_isPreimmersion UZ.ι (by rw [hrZ]; exact hcl)
  have hb : IsClosedImmersion UX.ι :=
    IsClosedImmersion.of_isPreimmersion UX.ι (by rw [hrX]; exact hop.isClosed_compl)

  have hnormU : ∀ (V : X.Opens) (z : V.toScheme),
      IsDomain (V.toScheme.presheaf.stalk z) ∧ IsIntegrallyClosed (V.toScheme.presheaf.stalk z) := by
    intro V z
    let e := (V.stalkIso z).commRingCatIsoToRingEquiv
    haveI h1 : ∀ y : X, IsDomain (X.presheaf.stalk y) := fun y => (hnorm y).1
    haveI h2 : ∀ y : X, IsIntegrallyClosed (X.presheaf.stalk y) := fun y => (hnorm y).2
    haveI : IsDomain (V.toScheme.presheaf.stalk z) := MulEquiv.isDomain _ e.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv e.symm⟩
  have hembX := UX.ι.isOpenEmbedding
  refine ⟨UZ, UZ.ι, UX, UX.ι, hiZ, hb, ?_, ?_, ?_, hnormU UZ, hnormU UX, ?_, ?_, ?_⟩
  ·
    intro U hU
    rw [hrZ] at hU
    rw [isIso_iff_isOpenImmersion_and_surjective]
    refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
    have hyU : U.ι y ∈ (U : Set X) := by
      rw [← Scheme.Opens.range_ι U]; exact ⟨y, rfl⟩
    have hy : U.ι y ∈ Set.range UX.ι := by rw [hrX, ← hU]; exact hyU
    obtain ⟨x, hx⟩ := hy
    have hxU : x ∈ UX.ι ⁻¹ᵁ U := by
      show UX.ι x ∈ U
      rw [hx]; exact hyU
    obtain ⟨x', hx'⟩ : x ∈ Set.range (UX.ι ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]; exact hxU
    refine ⟨x', ?_⟩
    apply U.ι.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply, hx', hx]
  · rw [hrX, hrZ]
    exact disjoint_compl_left
  ·
    have hpre : IsPreirreducible (UZ.ι ⁻¹' Z₀) :=
      hirr.isPreirreducible.preimage UZ.ι.isOpenEmbedding
    have huniv : UZ.ι ⁻¹' Z₀ = Set.univ := by rw [← hrZ]; exact Set.preimage_range _
    rw [huniv] at hpre
    have hx0 : x₀ ∈ Set.range UZ.ι := by rw [hrZ]; exact mem_irreducibleComponent
    obtain ⟨p, _⟩ := hx0
    exact { isPreirreducible_univ := hpre, toNonempty := ⟨p⟩ }
  · have hembZ := UZ.ι.isOpenEmbedding.isEmbedding
    have h1 : topologicalKrullDim UZ = topologicalKrullDim (Set.range UZ.ι) :=
      IsHomeomorph.topologicalKrullDim_eq _ hembZ.toHomeomorph.isHomeomorph
    rw [h1]
    exact topologicalKrullDim_subspace_le _ _
  · have h1 : topologicalKrullDim UX = topologicalKrullDim (Set.range UX.ι) :=
      IsHomeomorph.topologicalKrullDim_eq _ hembX.isEmbedding.toHomeomorph.isHomeomorph
    rw [h1]
    exact topologicalKrullDim_subspace_le _ _
  ·
    let v : UX.toScheme → X := UX.ι
    have hv : Topology.IsOpenEmbedding v := hembX
    have hmap : ∀ S ∈ irreducibleComponents UX.toScheme,
        v '' S ∈ irreducibleComponents X \ {Z₀} := by
      intro S hS
      have hI : IsIrreducible (v '' S) := hS.prop.image v hv.continuous.continuousOn
      obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _ hI
      obtain ⟨p, hp⟩ := hS.prop.nonempty
      have hpC : v p ∈ C := hsub ⟨p, hp, rfl⟩
      have hpW : v p ∈ Z₀ᶜ := by rw [← hrX]; exact ⟨p, rfl⟩
      have hCne : C ≠ Z₀ := fun h => hpW (h ▸ hpC)
      have hCW : C ⊆ Set.range v := by
        intro y hy
        show y ∈ Set.range UX.ι
        rw [hrX]
        exact fun hyZ => Set.disjoint_left.mp (hdisj C hC Z₀ hZ₀ hCne) hy hyZ
      have hpre : IsIrreducible (v ⁻¹' C) :=
        ⟨⟨p, hpC⟩, hC.prop.isPreirreducible.preimage hv⟩
      have hSle : S ⊆ v ⁻¹' C := fun q hq => hsub ⟨q, hq, rfl⟩
      have hSeq : S = v ⁻¹' C := hS.eq_of_le hpre hSle
      have himg : v '' S = C := by rw [hSeq, Set.image_preimage_eq_of_subset hCW]
      rw [himg]
      exact ⟨hC, hCne⟩
    have hinj : Set.InjOn (fun S : Set UX.toScheme => v '' S) (irreducibleComponents UX.toScheme) :=
      (Set.image_injective.mpr hv.injective).injOn
    calc (irreducibleComponents UX.toScheme).ncard
        ≤ (irreducibleComponents X \ {Z₀}).ncard :=
          Set.ncard_le_ncard_of_injOn _ hmap hinj (hfin.subset Set.diff_subset)
      _ < (irreducibleComponents X).ncard := Set.ncard_diff_singleton_lt_of_mem hZ₀ hfin

theorem wc_et_kummer_presheaf_kappa : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ wcEtGmPre X, κ ≫ (ℓ • 𝟙 (wcEtGmPre X)) = 0 ∧ Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) κ ∧ ∀ (U : Scheme.Etale X) (s : ToType ((wcEtGmPre X).obj (Opposite.op U))), (ℓ • 𝟙 (wcEtGmPre X)).app (Opposite.op U) s = 0 → Presheaf.imageSieve κ s ∈ Scheme.smallEtaleTopology X U :=
by
  intro Ω _ _ X fX ℓ hℓ hℓΩ
  classical
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  haveI : NeZero ℓ := ⟨hℓ0⟩
  haveI : NeZero (ℓ : Ω) := ⟨hℓΩ⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity Ω ℓ
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ

  have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (φ : Ω →+* O) (v : O),
      v ^ ℓ = 1 → ∃ k : ℕ, v = φ ζ ^ k := by
    intro O _ _ φ v hv
    let π := IsLocalRing.residue O
    have hinj : Function.Injective (π.comp φ) := (π.comp φ).injective
    have hprim : IsPrimitiveRoot ((π.comp φ) ζ) ℓ := hζ.map_of_injective hinj
    have hπv : π v ^ ℓ = 1 := by rw [← map_pow, hv, map_one]
    obtain ⟨i, -, hiv⟩ := hprim.eq_pow_of_pow_eq_one hπv
    refine ⟨i, ?_⟩
    have hw : (φ ζ ^ i) ^ ℓ = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζ.pow_eq_one, map_one, one_pow]
    have hπw : π (φ ζ ^ i) = π v := by rw [map_pow]; exact hiv
    have hS : (∑ j ∈ Finset.range ℓ, v ^ j * (φ ζ ^ i) ^ (ℓ - 1 - j)) * (v - φ ζ ^ i) = 0 := by
      rw [geom_sum₂_mul, hv, hw, sub_self]
    have hSu : IsUnit (∑ j ∈ Finset.range ℓ, v ^ j * (φ ζ ^ i) ^ (ℓ - 1 - j)) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      have e : π (∑ j ∈ Finset.range ℓ, v ^ j * (φ ζ ^ i) ^ (ℓ - 1 - j)) =
          (ℓ : IsLocalRing.ResidueField O) * π v ^ (ℓ - 1) := by
        rw [map_sum, ← geom_sum₂_self]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, map_pow, map_pow, hπw]
      rw [e]
      refine mul_ne_zero ?_ (pow_ne_zero _ ?_)
      · have h1 : (ℓ : IsLocalRing.ResidueField O) = (π.comp φ) (ℓ : Ω) := by rw [map_natCast]
        rw [h1]
        exact (map_ne_zero_iff _ hinj).mpr hℓΩ
      · intro h0
        rw [h0, zero_pow hℓ0] at hπv
        exact zero_ne_one hπv
    exact sub_eq_zero.mp (hSu.mul_right_eq_zero.mp hS)

  have s3 : ∀ (Y : Scheme.{u}) (y : Y) (a b : Γ(Y, ⊤)),
      (Y.presheaf.germ ⊤ y trivial).hom a = (Y.presheaf.germ ⊤ y trivial).hom b →
      ∃ W : Y.Opens, y ∈ W ∧ W.ι.appTop.hom a = W.ι.appTop.hom b := by
    intro Y y a b h
    obtain ⟨W, hyW, iU, iV, e⟩ :=
      TopCat.Presheaf.germ_eq (U := ⊤) (V := ⊤) Y.presheaf y trivial trivial a b h
    refine ⟨W, hyW, ?_⟩
    obtain rfl : iV = iU := Subsingleton.elim _ _
    have e' : (Y.presheaf.map iV.op).hom a = (Y.presheaf.map iV.op).hom b := e
    have gen : ∀ (V : Y.Opens) (j : V ⟶ ⊤), V ≤ W →
        (Y.presheaf.map j.op).hom a = (Y.presheaf.map j.op).hom b := by
      intro V j hVW
      obtain rfl : j = homOfLE hVW ≫ iV := Subsingleton.elim _ _
      rw [op_comp, Functor.map_comp, CommRingCat.comp_apply, CommRingCat.comp_apply, e']
    rw [Scheme.Opens.ι_appTop]
    exact gen _ _ (by simp)

  have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hG3 : ∀ (U : X.Etale) (a b : ToType ((wcEtGmPre X).obj (Opposite.op U))),
      ((Additive.toMul a.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
        ((Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) → a = b :=
    fun U a b h => ULift.ext _ _ (Additive.toMul.injective (Units.ext h))
  let cX : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  let ψ : ∀ U : X.Etale, Ω →+* Γ(U.left, ⊤) := fun U => U.hom.appTop.hom.comp cX
  have hψnat : ∀ (U V : X.Etale) (f : V ⟶ U) (a : Ω), f.left.appTop.hom (ψ U a) = ψ V a := by
    intro U V f a
    have hw : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
    simp only [ψ, RingHom.comp_apply]
    rw [← hw, Scheme.Hom.comp_appTop]
    rfl
  have hζmod : ∀ (m : ℕ), ζ ^ m = ζ ^ (m % ℓ) := fun m => by
    conv_lhs => rw [← Nat.div_add_mod m ℓ, pow_add, pow_mul, hζ.pow_eq_one, one_pow, one_mul]
  have hζu : IsUnit ζ := hζ.isUnit hℓ0
  let zU : ∀ U : X.Etale, (Γ(U.left, ⊤))ˣ := fun U => Units.map (ψ U).toMonoidHom hζu.unit
  have hzU : ∀ U : X.Etale, ((zU U : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ := fun U => by
    simp [zU]
  have hzpow : ∀ (U : X.Etale) (m : ℕ), ((zU U ^ m : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ ^ m :=
    fun U m => by rw [Units.val_pow_eq_pow_val, hzU]
  have hψmod : ∀ (U : X.Etale) (m : ℕ), ψ U ζ ^ m = ψ U ζ ^ (m % ℓ) := fun U m => by
    rw [← map_pow, ← map_pow, ← hζmod]
  have hzmod : ∀ (U : X.Etale) (m : ℕ), zU U ^ m = zU U ^ (m % ℓ) := fun U m => by
    ext
    rw [hzpow, hzpow, ← hψmod]
  let κf : ∀ U : X.Etale, ULift.{u+1} (ZMod ℓ) →+ ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) :=
    fun U => AddMonoidHom.mk' (fun x => ULift.up (Additive.ofMul (zU U ^ x.down.val))) (by
      intro a b
      apply ULift.ext
      apply Additive.toMul.injective
      change zU U ^ (a.down + b.down).val = zU U ^ a.down.val * zU U ^ b.down.val
      rw [ZMod.val_add, ← hzmod, pow_add])
  let κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶
      wcEtGmPre X :=
    { app := fun U => AddCommGrpCat.ofHom (κf U.unop)
      naturality := by
        intro U V f
        ext x
        apply hG3 V.unop
        change ((zU V.unop ^ x.down.val : (Γ(V.unop.left, ⊤))ˣ) : Γ(V.unop.left, ⊤)) =
          f.unop.left.appTop.hom ((zU U.unop ^ x.down.val : (Γ(U.unop.left, ⊤))ˣ) : Γ(U.unop.left, ⊤))
        rw [hzpow, hzpow, map_pow, hψnat] }
  have hκv : ∀ (U : X.Etale) (x : ULift.{u+1} (ZMod ℓ)),
      ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
        ψ U ζ ^ x.down.val := fun U x => hzpow U x.down.val
  refine ⟨κ, ?_, ?_, ?_⟩
  ·
    rw [Preadditive.comp_nsmul, Category.comp_id]
    ext U x
    simp only [NatTrans.app_nsmul, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply]
    apply ULift.ext
    apply Additive.toMul.injective
    change (zU U.unop ^ x.down.val) ^ ℓ = 1
    rw [← pow_mul, mul_comm, pow_mul, hzmod U.unop ℓ, Nat.mod_self, pow_zero, one_pow]
  ·
    refine ⟨fun {U'} x y hxy => ?_⟩
    obtain ⟨U⟩ := U'
    rcases isEmpty_or_nonempty U.left with hE | ⟨⟨y₀⟩⟩
    · exact hcov _ _ (fun v => isEmptyElim v)
    · haveI : Nontrivial Γ(U.left, ⊤) := @Scheme.component_nontrivial U.left ⊤ ⟨⟨y₀, trivial⟩⟩
      have hinj : Function.Injective (ψ U) := (ψ U).injective
      have hprim := hζ.map_of_injective hinj
      have h1 : ψ U ζ ^ x.down.val = ψ U ζ ^ y.down.val := by
        rw [← hκv U x, ← hκv U y]
        exact congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
          ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hxy
      have hval := hprim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h1
      have hxy' : x = y := ULift.ext _ _ (ZMod.val_injective _ hval)
      subst hxy'
      rw [Presheaf.equalizerSieve_self_eq_top]
      exact (Scheme.smallEtaleTopology X).top_mem _
  ·
    intro U s hs
    have hs' : ℓ • s = 0 := by
      first
        | exact hs
        | simpa using hs
    have hv : ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) ^ ℓ = 1 :=
      congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
          ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hs'
    refine hcov U _ (fun y => ?_)
    obtain ⟨k, hk⟩ := s2 (U.left.presheaf.stalk y)
      ((U.left.presheaf.germ ⊤ y trivial).hom.comp (ψ U))
      ((U.left.presheaf.germ ⊤ y trivial).hom
        ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)))
      (by rw [← map_pow, hv, map_one])
    rw [RingHom.comp_apply, ← map_pow] at hk
    obtain ⟨W, hyW, hW⟩ := s3 U.left y _ _ hk
    let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom) inferInstance
    let c : V₁ ⟶ U := MorphismProperty.Over.homMk W.ι rfl trivial
    refine ⟨V₁, c, ⟨ULift.up (k : ZMod ℓ), ?_⟩, ?_⟩
    · apply hG3 V₁
      rw [hκv]
      change _ = W.ι.appTop.hom ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))
      rw [hW, map_pow, show W.ι.appTop.hom (ψ U ζ) = ψ V₁ ζ from hψnat U V₁ c ζ,
        ZMod.val_natCast]
      exact (hψmod V₁ k).symm
    · exact ⟨⟨y, hyW⟩, rfl⟩

theorem wc_et_gm_pow_locally_surjective : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (ℓ : ℕ), (ℓ : Ω) ≠ 0 → Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) (ℓ • 𝟙 (wcEtGmPre X)) :=
by
  intro Ω _ X fX ℓ hℓΩ
  classical
  have hℓ0 : ℓ ≠ 0 := by
    rintro rfl
    exact hℓΩ Nat.cast_zero

  have s2 : ∀ (R : Type u) [CommRing R], IsUnit (ℓ : R) → ∀ a : R, IsUnit a →
      ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
        ∃ t : B, t ^ ℓ = algebraMap R B a := by
    intro R _ hℓR a ha
    set f : Polynomial R := Polynomial.X ^ ℓ - Polynomial.C a with hf
    have hfm : f.Monic := Polynomial.monic_X_pow_sub_C a hℓ0
    obtain ⟨u, hu⟩ := (hℓR.mul ha).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
      refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (ℓ : R)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (ℓ : R) * Polynomial.X ^ (ℓ - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (ℓ - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ ℓ :=
        pow_sub_one_mul hℓ0 Polynomial.X
      have hu' : Polynomial.C u * (Polynomial.C (ℓ : R) * Polynomial.C a) = 1 := by
        rw [← map_mul, ← map_mul, hu, map_one]
      rw [hd, hf, pow_one]
      linear_combination hu' + (Polynomial.C u * Polynomial.C (ℓ : R)) * hX
    let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
    have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
    refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
    · rcases subsingleton_or_nontrivial R with hR | hR
      · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
        intro x
        exact isEmptyElim x
      · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
        let pb := AdjoinRoot.powerBasis' hfm
        have hdim : 0 < pb.dim := by
          rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
          exact Nat.pos_of_ne_zero hℓ0
        have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
        exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
    · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
      exact sub_eq_zero.mp h1

  have s3 : ∀ (Y : Scheme.{u}) (B : Type u) [CommRing B] [Algebra Γ(Y, ⊤) B],
      Algebra.Etale Γ(Y, ⊤) B → Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(Y, ⊤) B)) →
      ∃ (V : Scheme.{u}) (p : V ⟶ Y) (ψ : B →+* Γ(V, ⊤)), Etale p ∧ Function.Surjective p ∧
        ∀ r : Γ(Y, ⊤), ψ (algebraMap Γ(Y, ⊤) B r) = p.appTop.hom r := by
    intro Y B _ _ hB hsurj
    let φ : CommRingCat.of Γ(Y, ⊤) ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap Γ(Y, ⊤) B)
    let g : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) := Spec.map φ
    have hg : Etale g := by
      apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
      rw [CommRingCat.hom_ofHom]
      exact RingHom.etale_algebraMap.mpr hB
    have hgs : Surjective g := by
      constructor
      exact hsurj
    let p := Limits.pullback.fst Y.toSpecΓ g
    let q := Limits.pullback.snd Y.toSpecΓ g
    refine ⟨Limits.pullback Y.toSpecΓ g, p,
      ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop).hom,
      inferInstance, p.surjective, fun r => ?_⟩
    have hc : Y.toSpecΓ.appTop ≫ p.appTop = g.appTop ≫ q.appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
    have hn := Scheme.ΓSpecIso_inv_naturality φ
    have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
      rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
      exact Iso.inv_hom_id_assoc _ _
    exact congrArg (fun h => h.hom r) key

  have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
  let aU : (Γ(U.left, ⊤))ˣ := Additive.toMul s.down
  let cU : Ω →+* Γ(U.left, ⊤) :=
    ((U.hom ≫ fX).appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hℓR : IsUnit (ℓ : Γ(U.left, ⊤)) := by
    rw [← map_natCast cU]
    exact (Ne.isUnit hℓΩ).map cU
  obtain ⟨B, _, _, hBet, hBsurj, t, ht⟩ := s2 Γ(U.left, ⊤) hℓR (aU : Γ(U.left, ⊤)) aU.isUnit
  obtain ⟨V, p, ψ, hpet, hpsurj, hψ⟩ := s3 U.left B hBet hBsurj
  have hT : ψ t ^ ℓ = p.appTop.hom (aU : Γ(U.left, ⊤)) := by rw [← map_pow, ht, hψ]
  have hTu : IsUnit (ψ t) := by
    have h1 : IsUnit (ψ t ^ ℓ) := by rw [hT]; exact aU.isUnit.map _
    exact (isUnit_pow_iff hℓ0).mp h1
  haveI := hpet
  let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) inferInstance
  let c : V₁ ⟶ U := MorphismProperty.Over.homMk p rfl trivial
  have hc : (Presheaf.imageSieve (ℓ • 𝟙 (wcEtGmPre X)) s).arrows c := by
    refine ⟨ULift.up (Additive.ofMul hTu.unit), ?_⟩
    simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
      AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
    apply ULift.ext
    apply Additive.toMul.injective
    apply Units.ext
    change ((hTu.unit ^ ℓ : (Γ(V, ⊤))ˣ) : Γ(V, ⊤)) = p.appTop.hom (aU : Γ(U.left, ⊤))
    rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hT]
  exact hcov U _ (fun v => ⟨V₁, c, hc, hpsurj v⟩)

theorem wc_et_kummer_ses : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
    ∃ (ι : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ wcEtGm X)
      (h : ι ≫ (ℓ • 𝟙 (wcEtGm X)) = 0), (ShortComplex.mk ι (ℓ • 𝟙 (wcEtGm X)) h).ShortExact :=
by
  intro Ω _ _ X fX ℓ hℓ hℓΩ

  have hA : ∀ (P₁ P₂ P₃ : (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃),
      f ≫ g = 0 → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) f →
      (∀ (U : Scheme.Etale X) (s : ToType (P₂.obj (Opposite.op U))),
        g.app (Opposite.op U) s = 0 → Presheaf.imageSieve f s ∈ Scheme.smallEtaleTopology X U) →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) g →
      ∀ (g' : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₂ ⟶
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₃),
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = g' →
        ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫ g' = 0,
          (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
            AddCommGrpCat.{u+1}).map f) g' h).ShortExact := by
    intro P₁ P₂ P₃ f g hfg hinj hex hsurj g' hg'
    subst hg'
    have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, hfg, Functor.map_zero]
    refine ⟨h, ?_⟩
    have hmono : Mono ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) := by
      haveI : Sheaf.IsLocallyInjective
          ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) :=
        (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ f).mpr hinj
      exact Sheaf.mono_of_isLocallyInjective _
    have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g).mpr hsurj
    refine ShortComplex.ShortExact.mk' ?_ hmono hepi
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (Limits.kernel.lift g f hfg) := by
      refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
      have ht : g.app (Opposite.op U) ((Limits.kernel.ι g).app (Opposite.op U) s) = 0 := by
        rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
        rfl
      refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
      intro V φ hφ
      obtain ⟨r, hr⟩ := hφ
      refine ⟨r, ?_⟩
      have hm : Mono ((Limits.kernel.ι g).app (Opposite.op V)) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance _
      apply (AddCommGrpCat.mono_iff_injective _).mp hm
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
        ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
    have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f hfg)) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
    have heq : Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f hfg) ≫
        (Limits.PreservesKernel.iso
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) g).hom := by
      rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h)
    rw [heq]
    exact epi_comp _ _

  have hmap : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (ℓ • 𝟙 (wcEtGmPre X)) = ℓ • 𝟙 (wcEtGm X) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl

  obtain ⟨κ, h0, hinj, hex⟩ := wc_et_kummer_presheaf_kappa Ω X fX ℓ hℓ hℓΩ
  obtain ⟨h, hS⟩ := hA _ _ _ κ (ℓ • 𝟙 (wcEtGmPre X)) h0 hinj hex
    (wc_et_gm_pow_locally_surjective Ω X fX ℓ hℓΩ) (ℓ • 𝟙 (wcEtGm X)) hmap
  exact ⟨(presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ, h, hS⟩

theorem wc_et_gm_h0_units : ∀ (X : Scheme.{u}),
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm X) 0 ≃+ Additive (Γ(X, ⊤))ˣ) :=
by
  intro X
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hrep : (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}).IsRepresentable :=
    (Functor.RepresentableBy.mk (F := Scheme.Γ.{u} ⋙ forget CommRingCat.{u})
      (Y := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ))))
      (fun {U} => (AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := U)).trans
        (Equiv.funUnique PUnit.{u+1} Γ(U, ⊤)))
      (by intro U U' f g; rfl)).isRepresentable
  have hΓt : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) :=
    GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _

  have hUt : Presieve.IsSheaf Scheme.fpqcTopology.{u}
      (Scheme.Γ.{u} ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ forget CommGrpCat) := by
    intro Y S hS x hx
    have h := hΓt S hS
    let P := Scheme.Γ.{u}
    let U := Scheme.Γ.{u} ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ forget CommGrpCat
    let e : ∀ Z : Scheme.{u}, U.obj (Opposite.op Z) ≃ (P.obj (Opposite.op Z))ˣ :=
      fun _ => Equiv.refl _
    have hmap : ∀ {Z Z' : Scheme.{u}} (g : Z' ⟶ Z) (w : U.obj (Opposite.op Z)),
        ((e Z' (U.map g.op w) : (P.obj (Opposite.op Z'))ˣ) : P.obj (Opposite.op Z')) =
          (P.map g.op).hom ((e Z w : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z)) :=
      fun _ _ => rfl
    let a : Presieve.FamilyOfElements (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) S.arrows :=
      fun Z f hf => ((e Z (x f hf) : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z))
    let b : Presieve.FamilyOfElements (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) S.arrows :=
      fun Z f hf => (((e Z (x f hf))⁻¹ : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z))
    have ha : a.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hc
      have := congrArg (fun w => ((e Z w : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z)))
        (hx g₁ g₂ h₁ h₂ hc)
      exact this
    have hb : b.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hc
      have := congrArg (fun w => (((e Z w)⁻¹ : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z)))
        (hx g₁ g₂ h₁ h₂ hc)
      exact this
    have hga : ∀ ⦃Z⦄ (f : Z ⟶ Y) (hf : S.arrows f),
        (P.map f.op).hom (h.amalgamate a ha) = a f hf := fun Z f hf => h.valid_glue ha f hf
    have hgb : ∀ ⦃Z⦄ (f : Z ⟶ Y) (hf : S.arrows f),
        (P.map f.op).hom (h.amalgamate b hb) = b f hf := fun Z f hf => h.valid_glue hb f hf
    have hst : h.amalgamate a ha * h.amalgamate b hb = 1 := by
      apply h.isSeparatedFor.ext
      intro Z f hf
      change (P.map f.op).hom _ = (P.map f.op).hom _
      rw [map_mul, map_one, hga f hf, hgb f hf]
      exact Units.mul_inv _
    let w : (P.obj (Opposite.op Y))ˣ :=
      ⟨h.amalgamate a ha, h.amalgamate b hb, hst, by rw [mul_comm]; exact hst⟩
    refine ⟨(e Y).symm w, ?_, ?_⟩
    · intro Z f hf
      apply (e Z).injective
      apply Units.ext
      rw [hmap]
      exact hga f hf
    · intro w₂ hw₂
      apply (e Y).injective
      apply Units.ext
      apply h.isSeparatedFor.ext
      intro Z f hf
      change (P.map f.op).hom _ = (P.map f.op).hom _
      rw [← hmap, hw₂ f hf]
      exact (hga f hf).symm
  have s4 : Presheaf.IsSheaf Scheme.fpqcTopology.{u}
      (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) :=
    (Presheaf.isSheaf_iff_isSheaf_forget Scheme.fpqcTopology _ (forget AddCommGrpCat.{u+1})).2
      ((isSheaf_iff_isSheaf_of_type _ _).2
        ((Presieve.isSheaf_comp_uliftFunctor_iff.{u, u+1} Scheme.fpqcTopology).2 hUt))

  have hcont : (Scheme.Etale.forget X ⋙ Over.forget X).IsContinuous
      (Scheme.smallEtaleTopology X) Scheme.etaleTopology := by
    set_option backward.isDefEq.respectTransparency.types false in
    exact
      haveI : (Scheme.Etale.forget X).LocallyCoverDense (Scheme.etaleTopology.over X) :=
        inferInstanceAs ((MorphismProperty.Over.forget @AlgebraicGeometry.Etale.{u} ⊤ X).LocallyCoverDense
          (X.overGrothendieckTopology @AlgebraicGeometry.Etale.{u}))
      haveI := flat_of_preservesFiniteLimits (Scheme.Etale.forget X)
      haveI : (Scheme.Etale.forget X).IsContinuous X.smallEtaleTopology (Scheme.etaleTopology.over X) :=
        Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _)
          (Functor.coverPreserving_restrictedTopology (Scheme.Etale.forget X) (Scheme.etaleTopology.over X))
      Functor.isContinuous_comp (Scheme.Etale.forget X) (Over.forget X) _ (Scheme.etaleTopology.over X)
          Scheme.etaleTopology
  have hP : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtGmPre X) := by
    haveI := hcont
    exact Functor.op_comp_isSheaf_of_isSheaf (Scheme.Etale.forget X ⋙ Over.forget X)
      (Scheme.smallEtaleTopology X) Scheme.etaleTopology _
      (Presheaf.IsSheaf.of_le (le_trans Scheme.etaleTopology_le_proetaleTopology
        Scheme.proetaleTopology_le_fpqcTopology) s4)
  haveI := isIso_toSheafify (Scheme.smallEtaleTopology X) hP
  exact ⟨(Sheaf.H.equiv₀ (wcEtGm X)
        (@MorphismProperty.Over.mkIdTerminal _ _ @AlgebraicGeometry.Etale.{u} X
          MorphismProperty.IsMultiplicative.toContainsIdentities)).trans
      ((((asIso (toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X))).app
        (Opposite.op (@MorphismProperty.Over.mk _ _ @AlgebraicGeometry.Etale.{u} ⊤ X X (𝟙 X)
          (@MorphismProperty.id_mem _ _ @AlgebraicGeometry.Etale.{u}
            MorphismProperty.IsMultiplicative.toContainsIdentities X)))).addCommGroupIsoToAddEquiv).symm.trans
        AddEquiv.ulift)⟩

theorem wc_h1_quotient_of_acyclic_middle : ∀ {C : Type u₁} [Category.{v₁} C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{w}]
    [HasExt (Sheaf J AddCommGrpCat.{w})] {T : C} (hT : Limits.IsTerminal T)
    {A B Q : Sheaf J AddCommGrpCat.{w}} (f : A ⟶ B) (g : B ⟶ Q) (hfg : f ≫ g = 0),
    (ShortComplex.mk f g hfg).ShortExact →
    (∀ e : Abelian.Ext ((constantSheaf J AddCommGrpCat.{w}).obj
      (AddCommGrpCat.of (ULift.{w} ℤ))) B 1, e = 0) →
    Nonempty (Abelian.Ext ((constantSheaf J AddCommGrpCat.{w}).obj
        (AddCommGrpCat.of (ULift.{w} ℤ))) A 1 ≃+
      (Q.obj.obj (Opposite.op T) ⧸ (g.hom.app (Opposite.op T)).hom.range)) :=
by
  intro C _ J _ _ T hT A B Q f g hfg hS hB
  let P := (constantSheaf J AddCommGrpCat.{w}).obj (AddCommGrpCat.of (ULift.{w} ℤ))
  let S := ShortComplex.mk f g hfg
  let δ : Abelian.Ext P Q 0 →+ Abelian.Ext P A 1 := hS.extClass.postcomp P (zero_add 1)
  let gs : Abelian.Ext P B 0 →+ Abelian.Ext P Q 0 := (Abelian.Ext.mk₀ g).postcomp P (add_zero 0)
  have hsurj : Function.Surjective δ := by
    intro x₁
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x₁ (hB _) (zero_add 1)
    exact ⟨x₃, hx₃⟩
  have hker : gs.range = δ.ker := by
    ext x
    constructor
    · rintro ⟨x₂, rfl⟩
      rw [AddMonoidHom.mem_ker]
      change (x₂.comp (Abelian.Ext.mk₀ S.g) (add_zero 0)).comp hS.extClass (zero_add 1) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
    · intro hx
      rw [AddMonoidHom.mem_ker] at hx
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x (zero_add 1) hx
      exact ⟨x₂, hx₂⟩
  let e₁ : (Abelian.Ext P Q 0 ⧸ gs.range) ≃+ Abelian.Ext P A 1 :=
    QuotientAddGroup.liftEquiv gs.range hsurj hker
  let eB := Sheaf.H.equiv₀ B hT
  let eQ := Sheaf.H.equiv₀ Q hT
  have hmap : AddSubgroup.map (eQ : Abelian.Ext P Q 0 →+ Q.obj.obj (Opposite.op T)) gs.range =
      (g.hom.app (Opposite.op T)).hom.range := by
    ext y
    constructor
    · rintro ⟨z, ⟨x, rfl⟩, rfl⟩
      exact ⟨eB x, Sheaf.H.equiv₀_naturality hT g x⟩
    · rintro ⟨b, rfl⟩
      refine ⟨gs (eB.symm b), ⟨eB.symm b, rfl⟩, ?_⟩
      have h := Sheaf.H.equiv₀_naturality hT g (eB.symm b)
      rw [AddEquiv.apply_symm_apply] at h
      exact h.symm
  let e₂ : (Abelian.Ext P Q 0 ⧸ gs.range) ≃+
      (Q.obj.obj (Opposite.op T) ⧸ (g.hom.app (Opposite.op T)).hom.range) :=
    QuotientAddGroup.congr _ _ eQ hmap
  exact ⟨e₁.symm.trans e₂⟩

theorem wc_sheaf_ses_sectionwise : ∀ {C : Type u₁} [Category.{v₁} C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{w}]
    {A B Q : Sheaf J AddCommGrpCat.{w}} (f : A ⟶ B) (g : B ⟶ Q) (hfg : f ≫ g = 0),
    (ShortComplex.mk f g hfg).ShortExact →
    (∀ (U : C) (a : A.obj.obj (Opposite.op U)), f.hom.app (Opposite.op U) a = 0 → a = 0) ∧
    (∀ (U : C) (b : B.obj.obj (Opposite.op U)), g.hom.app (Opposite.op U) b = 0 →
      ∃ a, f.hom.app (Opposite.op U) a = b) :=
by
  intro C _ J _ A B Q f g hfg hS
  haveI := hS.mono_f
  refine ⟨?_, ?_⟩
  · intro U a ha
    have hinj : Function.Injective (f.hom.app (Opposite.op U)) :=
      (AddCommGrpCat.mono_iff_injective (f.hom.app (Opposite.op U))).mp
        (Functor.map_mono (sheafToPresheaf J AddCommGrpCat.{w} ⋙
          (evaluation _ AddCommGrpCat.{w}).obj (Opposite.op U)) f)
    exact hinj (ha.trans (map_zero _).symm)
  · intro U b hb
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf J AddCommGrpCat.{w} ⋙ (evaluation _ AddCommGrpCat.{w}).obj (Opposite.op U))
      hS.mono_f inferInstance
    obtain ⟨a, ha⟩ := (ShortComplex.ab_exact_iff _).mp hE b hb
    exact ⟨a, ha⟩

theorem wc_sheaf_epi_locallySurjective : ∀ {C : Type u₁} [Category.{v₁} C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{w}]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})] {B Q : Sheaf J AddCommGrpCat.{w}}
    (g : B ⟶ Q) [Epi g], ∀ (U : C) (q : Q.obj.obj (Opposite.op U)),
    Presheaf.imageSieve g.hom q ∈ J U :=
by
  intro C _ J _ _ B Q g _ U q

  have hpb : ∀ {V W : C} (h : W ⟶ V) (s : Q.obj.obj (Opposite.op V)),
      Presheaf.imageSieve g.hom (Q.obj.map h.op s) =
        Sieve.pullback h (Presheaf.imageSieve g.hom s) := by
    intro V W h s
    ext Z f
    change (∃ t, g.hom.app _ t = Q.obj.map f.op (Q.obj.map h.op s)) ↔
      (∃ t, g.hom.app _ t = Q.obj.map (f ≫ h).op s)
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  let IU : ∀ V : Cᵒᵖ, AddSubgroup (Q.obj.obj V) := fun V =>
    { carrier := {s | Presheaf.imageSieve g.hom s ∈ J V.unop}
      zero_mem' := by
        refine J.superset_covering ?_ (J.top_mem _)
        intro Z f _
        exact ⟨0, by simp⟩
      add_mem' := by
        intro a b ha hb
        refine J.superset_covering ?_ (J.intersection_covering ha hb)
        rintro Z f ⟨⟨t₁, h₁⟩, ⟨t₂, h₂⟩⟩
        exact ⟨t₁ + t₂, by rw [map_add, h₁, h₂, map_add]⟩
      neg_mem' := by
        intro a ha
        refine J.superset_covering ?_ ha
        rintro Z f ⟨t, h⟩
        exact ⟨-t, by rw [map_neg, h, map_neg]⟩ }
  have hstab : ∀ {V W : Cᵒᵖ} (φ : V ⟶ W) (s : Q.obj.obj V), s ∈ IU V →
      Q.obj.map φ s ∈ IU W := by
    intro V W φ s hs
    have h1 := hpb φ.unop s
    simp only [Quiver.Hom.op_unop] at h1
    change Presheaf.imageSieve g.hom (Q.obj.map φ s) ∈ J W.unop
    rw [h1]
    exact J.pullback_stable _ hs
  let I : Cᵒᵖ ⥤ AddCommGrpCat.{w} :=
    { obj := fun V => AddCommGrpCat.of (IU V)
      map := fun {V W} φ => AddCommGrpCat.ofHom
        (AddMonoidHom.codRestrict ((Q.obj.map φ).hom.comp (IU V).subtype) (IU W)
          (fun s => hstab φ s.1 s.2))
      map_id := by
        intro V
        ext s
        simp
      map_comp := by
        intro V W Z φ ψ
        ext s
        change Q.obj.map (φ ≫ ψ) s.1 = Q.obj.map ψ (Q.obj.map φ s.1)
        rw [Functor.map_comp, ConcreteCategory.comp_apply] }
  let ι₀ : I ⟶ Q.obj :=
    { app := fun V => AddCommGrpCat.ofHom (IU V).subtype
      naturality := by
        intro V W φ
        ext s
        rfl }
  have hgb : ∀ (V : Cᵒᵖ) (b : B.obj.obj V), g.hom.app V b ∈ IU V := by
    intro V b
    change Presheaf.imageSieve g.hom (g.hom.app V b) ∈ J V.unop
    rw [Presheaf.imageSieve_app g.hom (U := V.unop) b]
    exact J.top_mem _
  let g₀ : B.obj ⟶ I :=
    { app := fun V => AddCommGrpCat.ofHom
        (AddMonoidHom.codRestrict (g.hom.app V).hom (IU V) (fun b => hgb V b))
      naturality := by
        intro V W φ
        ext b
        exact ConcreteCategory.congr_hom (g.hom.naturality φ) b }

  have hQ : Presieve.IsSheaf J (Q.obj ⋙ forget AddCommGrpCat.{w}) :=
    (isSheaf_iff_isSheaf_of_type J _).1
      (GrothendieckTopology.HasSheafCompose.isSheaf Q.obj Q.property)
  have hIt : Presieve.IsSheaf J (I ⋙ forget AddCommGrpCat.{w}) := by
    intro X R hR x hx
    let x' : Presieve.FamilyOfElements (Q.obj ⋙ forget AddCommGrpCat.{w}) R :=
      fun Y f hf => (x f hf).1
    have hx' : x'.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hc
      exact congrArg Subtype.val (hx g₁ g₂ h₁ h₂ hc)
    let s := (hQ R hR).amalgamate x' hx'
    have hvalid : ∀ {Y : C} (f : Y ⟶ X) (hf : R f), Q.obj.map f.op s = x' f hf :=
      fun f hf => (hQ R hR).valid_glue hx' f hf
    have hmem : s ∈ IU (Opposite.op X) := by
      change Presheaf.imageSieve g.hom s ∈ J X
      refine J.transitive hR _ (fun Y f hf => ?_)
      rw [← hpb, hvalid f hf]
      exact (x f hf).2
    refine ⟨(⟨s, hmem⟩ : IU (Opposite.op X)), fun Y f hf => ?_, fun y hy => ?_⟩
    · apply Subtype.ext
      exact hvalid f hf
    · apply Subtype.ext
      refine (hQ R hR).isSeparatedFor x' _ s ?_ ((hQ R hR).isAmalgamation hx')
      intro Y f hf
      change ((I ⋙ forget AddCommGrpCat.{w}).map f.op y).1 = (x f hf).1
      rw [hy f hf]
  have hI : Presheaf.IsSheaf J I :=
    Presheaf.isSheaf_of_isSheaf_comp J I (forget AddCommGrpCat.{w})
      ((isSheaf_iff_isSheaf_of_type J _).2 hIt)
  let Is : Sheaf J AddCommGrpCat.{w} := ⟨I, hI⟩
  let ι : Is ⟶ Q := ObjectProperty.homMk ι₀
  let g' : B ⟶ Is := ObjectProperty.homMk g₀
  have hfac : g' ≫ ι = g := by
    apply Sheaf.hom_ext
    ext V b
    rfl
  have : Epi ι := epi_of_epi_fac hfac
  have : ∀ V, Mono (ι₀.app V) := fun V =>
    (AddCommGrpCat.mono_iff_injective _).2 Subtype.val_injective
  have : Mono ι₀ := NatTrans.mono_of_mono_app ι₀
  have : Mono ι := Functor.mono_of_mono_map (sheafToPresheaf J AddCommGrpCat.{w})
    (show Mono ι₀ from inferInstance)
  have : IsIso ι := isIso_of_mono_of_epi ι
  have hι₀ : IsIso ι₀ := (inferInstance : IsIso ((sheafToPresheaf J AddCommGrpCat.{w}).map ι))
  have : IsIso (ι₀.app (Opposite.op U)) := NatIso.isIso_app_of_isIso ι₀ _
  have hsurj : Function.Surjective (ι₀.app (Opposite.op U)) :=
    (ConcreteCategory.bijective_of_isIso (ι₀.app (Opposite.op U))).2
  obtain ⟨y, hy⟩ := hsurj q
  rw [← hy]
  exact y.2

theorem wc_sheaf_ses_of_sectionwise : ∀ {C : Type u₁} [Category.{v₁} C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{w}]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    {A B Q : Sheaf J AddCommGrpCat.{w}} (f : A ⟶ B) (g : B ⟶ Q) (hfg : f ≫ g = 0),
    (∀ (U : C) (a : A.obj.obj (Opposite.op U)), f.hom.app (Opposite.op U) a = 0 → a = 0) →
    (∀ (U : C) (b : B.obj.obj (Opposite.op U)), g.hom.app (Opposite.op U) b = 0 →
      ∃ a, f.hom.app (Opposite.op U) a = b) →
    (∀ (U : C) (q : Q.obj.obj (Opposite.op U)), Presheaf.imageSieve g.hom q ∈ J U) →
    (ShortComplex.mk f g hfg).ShortExact :=
by
  intro C _ J _ _ A B Q f g hfg hinj hmid hloc
  have hmono : Mono f := by
    haveI : Sheaf.IsLocallyInjective f := (Sheaf.isLocallyInjective_iff_injective f).mpr
      (fun X => (injective_iff_map_eq_zero _).mpr (fun a ha => hinj X.unop a ha))
    exact Sheaf.mono_of_isLocallyInjective f
  have hepi : Epi g := by
    haveI : Sheaf.IsLocallySurjective g := Presheaf.IsLocallySurjective.mk (fun {U} q => hloc U q)
    exact Sheaf.epi_of_isLocallySurjective g
  have hι : ∀ X : Cᵒᵖ, Function.Injective ((Limits.kernel.ι g).hom.app X) := fun X => by
    have h1 : Mono ((sheafToPresheaf J AddCommGrpCat.{w}).map (Limits.kernel.ι g)) :=
      Functor.map_mono (sheafToPresheaf J AddCommGrpCat.{w}) (Limits.kernel.ι g)
    exact (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app _).mp h1 X)
  have hk : Epi (Limits.kernel.lift g f hfg) := by
    haveI : Sheaf.IsLocallySurjective (Limits.kernel.lift g f hfg) :=
      Presheaf.isLocallySurjective_of_surjective J _ (fun X s => by
        have hb : g.hom.app X ((Limits.kernel.ι g).hom.app X s) = 0 := by
          have h := congrArg (fun φ => (φ.hom.app X) s) (Limits.kernel.condition g)
          exact h
        obtain ⟨a, ha⟩ := hmid X.unop _ hb
        refine ⟨a, hι X ?_⟩
        have h := congrArg (fun φ => (φ.hom.app X) a) (Limits.kernel.lift_ι g f hfg)
        exact h.trans ha)
    exact Sheaf.epi_of_isLocallySurjective _
  exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_epi_kernel_lift _).mpr hk) hmono hepi

theorem wc_injective_sheaf_restriction_surjective : ∀ {C : Type u₁} [Category.{v₁} C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{max v₁ w}]
    (I : Sheaf J AddCommGrpCat.{max v₁ w}) [Injective I] {U V : C} (m : U ⟶ V) [Mono m],
    Function.Surjective (I.obj.map m.op) :=
by
  classical
  intro C _ J _ I _ U V m _
  haveI hG : Injective I.obj :=
    Injective.injective_of_adjoint (sheafificationAdjunction J AddCommGrpCat.{max v₁ w}) I
  let F : C → (Cᵒᵖ ⥤ AddCommGrpCat.{max v₁ w}) := fun X =>
    { obj := fun Z => AddCommGrpCat.of (FreeAbelianGroup (ULift.{w} (Z.unop ⟶ X)))
      map := fun g => AddCommGrpCat.ofHom
        (FreeAbelianGroup.map (fun a => ULift.up (g.unop ≫ a.down)))
      map_id := by
        intro Z
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro t
        simp
      map_comp := by
        intro Z Z' Z'' g h
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro t
        simp }
  let μ : F U ⟶ F V :=
    { app := fun Z => AddCommGrpCat.ofHom (FreeAbelianGroup.map
        (fun a : ULift.{w} (Z.unop ⟶ U) => (ULift.up (a.down ≫ m) : ULift.{w} (Z.unop ⟶ V))))
      naturality := by
        intro Z Z' g
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro t
        change FreeAbelianGroup.map _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of t)) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of t))
        simp only [FreeAbelianGroup.map_of_apply, Category.assoc] }
  have hinj : ∀ Z, Function.Injective (μ.app Z) := by
    intro Z
    let f : ULift.{w} (Z.unop ⟶ U) → ULift.{w} (Z.unop ⟶ V) := fun a => ULift.up (a.down ≫ m)
    have hf : Function.Injective f := by
      intro a b hab
      apply ULift.ext
      exact (cancel_mono m).1 (congrArg ULift.down hab)
    let r : FreeAbelianGroup (ULift.{w} (Z.unop ⟶ V)) →+ FreeAbelianGroup (ULift.{w} (Z.unop ⟶ U)) :=
      FreeAbelianGroup.lift (fun b =>
        if h : ∃ a, f a = b then FreeAbelianGroup.of (Classical.choose h) else 0)
    have key : r.comp (FreeAbelianGroup.map f) = AddMonoidHom.id _ := by
      apply FreeAbelianGroup.lift_ext
      intro a
      have h : ∃ a', f a' = f a := ⟨a, rfl⟩
      simp only [AddMonoidHom.comp_apply, AddMonoidHom.id_apply, FreeAbelianGroup.map_of_apply,
        r, FreeAbelianGroup.lift_apply_of]
      rw [dif_pos h, hf (Classical.choose_spec h)]
    have e : ∀ z, r (FreeAbelianGroup.map f z) = z := fun z => congrArg (fun φ => φ z) key
    intro x y hxy
    rw [← e x, ← e y]
    exact congrArg r hxy
  haveI : ∀ Z, Mono (μ.app Z) := fun Z => (AddCommGrpCat.mono_iff_injective _).2 (hinj Z)
  haveI : Mono μ := NatTrans.mono_of_mono_app μ
  intro s
  let Φ : F U ⟶ I.obj :=
    { app := fun Z => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
        (fun a : ULift.{w} (Z.unop ⟶ U) => I.obj.map a.down.op s))
      naturality := by
        intro Z Z' g
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro t
        change FreeAbelianGroup.lift _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of t)) =
          I.obj.map g (FreeAbelianGroup.lift _ (FreeAbelianGroup.of t))
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        change I.obj.map (g.unop ≫ t.down).op s = _
        rw [op_comp, Functor.map_comp]
        rfl }
  let ψ := Injective.factorThru Φ μ
  have hψ : μ ≫ ψ = Φ := Injective.comp_factorThru Φ μ
  refine ⟨ψ.app (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))), ?_⟩
  have nat := NatTrans.naturality_apply ψ m.op (FreeAbelianGroup.of (ULift.up (𝟙 V)))
  rw [← nat]
  have h1 : (F V).map m.op (FreeAbelianGroup.of (ULift.up (𝟙 V))) =
      μ.app (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U))) := by
    change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
      FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
    rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply]
    simp
  rw [h1]
  have h2 : ψ.app (Opposite.op U) (μ.app (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U)))) =
      Φ.app (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U))) := by
    rw [← hψ]
    rfl
  rw [h2]
  change FreeAbelianGroup.lift _ (FreeAbelianGroup.of _) = s
  rw [FreeAbelianGroup.lift_apply_of]
  change I.obj.map (𝟙 U).op s = s
  simp

theorem wc_flasque_lift_global : ∀ (T : Type u₁) [TopologicalSpace T]
    {F B Q : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{w}} (ι : F ⟶ B) (g : B ⟶ Q),
    Presheaf.IsSheaf (Opens.grothendieckTopology T) B →
    Presheaf.IsSheaf (Opens.grothendieckTopology T) Q →
    (∀ (U : TopologicalSpace.Opens T) (a : F.obj (Opposite.op U)),
      g.app (Opposite.op U) (ι.app (Opposite.op U) a) = 0) →
    (∀ (U : TopologicalSpace.Opens T) (b : B.obj (Opposite.op U)), g.app (Opposite.op U) b = 0 →
      ∃ a, ι.app (Opposite.op U) a = b) →
    (∀ (U V : TopologicalSpace.Opens T) (h : U ≤ V), Function.Surjective (F.map (homOfLE h).op)) →
    (∀ (U : TopologicalSpace.Opens T) (q : Q.obj (Opposite.op U)) (x : T), x ∈ U →
      ∃ (W : TopologicalSpace.Opens T) (h : W ≤ U), x ∈ W ∧ ∃ b : B.obj (Opposite.op W),
        g.app (Opposite.op W) b = Q.map (homOfLE h).op q) →
    ∀ U : TopologicalSpace.Opens T, Function.Surjective (g.app (Opposite.op U)) :=
by
  intro T _ F B Q ι g hB hQ h0 hex hfl hloc

  have rr : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{w})
      {A₁ A₂ A₃ : TopologicalSpace.Opens T} (f₁ : A₁ ⟶ A₂) (f₂ : A₂ ⟶ A₃)
      (s : P.obj (Opposite.op A₃)),
      P.map f₁.op (P.map f₂.op s) = P.map (homOfLE ((leOfHom f₁).trans (leOfHom f₂))).op s := by
    intro P A₁ A₂ A₃ f₁ f₂ s
    rw [← Functor.map_comp_apply]
    rfl
  have natg : ∀ {A A' : TopologicalSpace.Opens T} (f : A ⟶ A') (s : B.obj (Opposite.op A')),
      g.app (Opposite.op A) (B.map f.op s) = Q.map f.op (g.app (Opposite.op A') s) :=
    fun f s => NatTrans.naturality_apply g f.op s
  have natι : ∀ {A A' : TopologicalSpace.Opens T} (f : A ⟶ A') (s : F.obj (Opposite.op A')),
      ι.app (Opposite.op A) (F.map f.op s) = B.map f.op (ι.app (Opposite.op A') s) :=
    fun f s => NatTrans.naturality_apply ι f.op s

  have glue : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{w}),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      ∀ (κ : Type (max u₁ w)) (V : κ → TopologicalSpace.Opens T)
        (sf : ∀ i, P.obj (Opposite.op (V i))),
      (∀ i j, P.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op (sf i) =
        P.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op (sf j)) →
      ∃ s : P.obj (Opposite.op (iSup V)),
        (∀ i, P.map (homOfLE (le_iSup V i)).op s = sf i) ∧
        ∀ s' : P.obj (Opposite.op (iSup V)),
          (∀ i, P.map (homOfLE (le_iSup V i)).op s' = sf i) → s' = s := by
    intro P hP κ V sf hc
    have hPt := GrothendieckTopology.HasSheafCompose.isSheaf
      (J := Opens.grothendieckTopology T) (F := forget AddCommGrpCat.{w}) P hP
    obtain ⟨s, hs, hu⟩ := TopCat.Presheaf.IsSheaf.isSheafUniqueGluing_types
      (X := TopCat.of T) (F := P ⋙ forget AddCommGrpCat.{w}) hPt sf hc
    exact ⟨s, hs, hu⟩
  have sep : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{w}),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      ∀ (κ : Type (max u₁ w)) (V : κ → TopologicalSpace.Opens T)
        (s₁ s₂ : P.obj (Opposite.op (iSup V))),
      (∀ i, P.map (homOfLE (le_iSup V i)).op s₁ = P.map (homOfLE (le_iSup V i)).op s₂) →
      s₁ = s₂ := by
    intro P hP κ V s₁ s₂ h
    obtain ⟨s, _, hu⟩ := glue P hP κ V (fun i => P.map (homOfLE (le_iSup V i)).op s₂)
      (fun i j => by rw [rr, rr])
    rw [hu s₁ h, hu s₂ (fun i => rfl)]
  intro U q

  have extend : ∀ (V : TopologicalSpace.Opens T) (hV : V ≤ U) (t : B.obj (Opposite.op V)),
      g.app (Opposite.op V) t = Q.map (homOfLE hV).op q →
      ∀ (W : TopologicalSpace.Opens T) (hW : W ≤ U) (b : B.obj (Opposite.op W)),
      g.app (Opposite.op W) b = Q.map (homOfLE hW).op q →
      ∃ (V' : TopologicalSpace.Opens T) (h₁ : V ≤ V') (h₂ : W ≤ V') (h₃ : V' ≤ U)
        (t' : B.obj (Opposite.op V')),
        B.map (homOfLE h₁).op t' = t ∧ g.app (Opposite.op V') t' = Q.map (homOfLE h₃).op q := by
    intro V hV t ht W hW b hb
    have pV : V ⊓ W ≤ V := inf_le_left
    have pW : V ⊓ W ≤ W := inf_le_right
    have hgd : g.app (Opposite.op (V ⊓ W))
        (B.map (homOfLE pV).op t - B.map (homOfLE pW).op b) = 0 := by
      rw [map_sub, natg, natg, ht, hb, rr, rr, sub_eq_zero]
    obtain ⟨a, ha⟩ := hex _ _ hgd
    obtain ⟨a', ha'⟩ := hfl _ _ pW a
    have hgb' : g.app (Opposite.op W) (b + ι.app (Opposite.op W) a') =
        Q.map (homOfLE hW).op q := by
      rw [map_add, h0, add_zero, hb]
    have hb'D : B.map (homOfLE pW).op (b + ι.app (Opposite.op W) a') =
        B.map (homOfLE pV).op t := by
      rw [map_add, ← natι, ha', ha]
      abel
    let Uf : ULift.{max u₁ w} Bool → TopologicalSpace.Opens T := fun i => cond i.down V W
    let sf : ∀ i : ULift.{max u₁ w} Bool, B.obj (Opposite.op (Uf i)) := fun i =>
      match i with
      | ⟨true⟩ => t
      | ⟨false⟩ => b + ι.app (Opposite.op W) a'
    have hc : ∀ i j, B.map (homOfLE (inf_le_left : Uf i ⊓ Uf j ≤ Uf i)).op (sf i) =
        B.map (homOfLE (inf_le_right : Uf i ⊓ Uf j ≤ Uf j)).op (sf j) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩
      · rfl
      · have e := congrArg (fun x => (B.map
          (homOfLE (le_inf inf_le_right inf_le_left : W ⊓ V ≤ V ⊓ W)).op) x) hb'D
        simp only [rr] at e
        exact e
      · exact hb'D.symm
      · rfl
    obtain ⟨s, hs, -⟩ := glue B hB (ULift.{max u₁ w} Bool) Uf sf hc
    have h₃ : iSup Uf ≤ U := iSup_le (by rintro ⟨_ | _⟩; exacts [hW, hV])
    refine ⟨iSup Uf, le_iSup Uf ⟨true⟩, le_iSup Uf ⟨false⟩, h₃, s, hs ⟨true⟩, ?_⟩
    apply sep Q hQ _ Uf
    intro i
    rw [← natg, hs i, rr]
    rcases i with ⟨_ | _⟩
    · exact hgb'
    · exact ht

  let Pt := Σ (V : {V : TopologicalSpace.Opens T // V ≤ U}),
    {t : B.obj (Opposite.op V.1) // g.app (Opposite.op V.1) t = Q.map (homOfLE V.2).op q}
  let r : Pt → Pt → Prop := fun a b =>
    ∃ h : a.1.1 ≤ b.1.1, B.map (homOfLE h).op b.2.1 = a.2.1
  have rtrans : ∀ {a b c : Pt}, r a b → r b c → r a c := by
    rintro a b c ⟨h₁, e₁⟩ ⟨h₂, e₂⟩
    refine ⟨h₁.trans h₂, ?_⟩
    rw [← e₁, ← e₂, rr]
  have hbound : ∀ c : Set Pt, IsChain r c → ∃ ub, ∀ a ∈ c, r a ub := by
    intro c hc
    let V : c → TopologicalSpace.Opens T := fun i => i.1.1.1
    have hV : ∀ i, V i ≤ U := fun i => i.1.1.2
    let t : ∀ i : c, B.obj (Opposite.op (V i)) := fun i => i.1.2.1
    have hcomp : ∀ i j : c, B.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op (t i) =
        B.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op (t j) := by
      intro i j
      by_cases hij : i = j
      · subst hij; rfl
      · rcases hc i.2 j.2 (fun h => hij (Subtype.ext h)) with ⟨h, e⟩ | ⟨h, e⟩
        · show B.map _ i.1.2.1 = B.map _ j.1.2.1
          rw [← e, rr]
        · show B.map _ i.1.2.1 = B.map _ j.1.2.1
          rw [← e, rr]
    obtain ⟨s, hs, -⟩ := glue B hB c V t hcomp
    have hgs : g.app (Opposite.op (iSup V)) s = Q.map (homOfLE (iSup_le hV)).op q := by
      apply sep Q hQ c V
      intro i
      rw [← natg, hs i, rr]
      exact i.1.2.2
    exact ⟨⟨⟨iSup V, iSup_le hV⟩, ⟨s, hgs⟩⟩, fun a ha => ⟨le_iSup V ⟨a, ha⟩, hs ⟨a, ha⟩⟩⟩
  obtain ⟨m, hm⟩ := exists_maximal_of_chains_bounded hbound rtrans
  rcases m with ⟨⟨V₀, hV₀⟩, t₀, ht₀⟩
  have hUV : U ≤ V₀ := by
    intro x hxU
    by_contra hx
    obtain ⟨W, hW, hxW, b, hb⟩ := hloc U q x hxU
    obtain ⟨V', h₁, h₂, h₃, t', ht'1, ht'2⟩ := extend V₀ hV₀ t₀ ht₀ W hW b hb
    obtain ⟨h, -⟩ := hm ⟨⟨V', h₃⟩, t', ht'2⟩ ⟨h₁, ht'1⟩
    exact hx (h (h₂ hxW))
  refine ⟨B.map (homOfLE hUV).op t₀, ?_⟩
  rw [natg, ht₀, rr]
  show Q.map (𝟙 (Opposite.op U)) q = q
  exact Functor.map_id_apply Q _ q

theorem wc_zarToEt_props : ∀ (X : Scheme.{u}),
    (wcZarToEt X).IsContinuous (Opens.grothendieckTopology X) (Scheme.smallEtaleTopology X) ∧
    Nonempty (Limits.IsTerminal ((wcZarToEt X).obj ⊤)) ∧
    ∀ (U V : X.Opens) (h : U ≤ V), Mono ((wcZarToEt X).map (homOfLE h)) :=
by
  intro X
  have s1 : ∀ (W : X.Etale) (U : X.Opens) (a b : W ⟶ (wcZarToEt X).obj U), a = b := by
    intro W U a b
    apply MorphismProperty.Over.Hom.ext
    have ha : a.left ≫ U.ι = W.hom := MorphismProperty.Over.w a
    have hb : b.left ≫ U.ι = W.hom := MorphismProperty.Over.w b
    exact (cancel_mono U.ι).mp (ha.trans hb.symm)
  have s2 : ∀ (W : X.Etale) (U : X.Opens), Set.range W.hom ⊆ (U : Set X) →
      Nonempty (W ⟶ (wcZarToEt X).obj U) := by
    intro W U hW
    have hW' : Set.range W.hom ⊆ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hW
    let l : W.left ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι W.hom hW'
    have hl : l ≫ U.ι = W.hom := IsOpenImmersion.lift_fac U.ι W.hom hW'
    exact ⟨MorphismProperty.Over.homMk (A := W) (B := (wcZarToEt X).obj U) l hl trivial⟩
  have s2' : ∀ (W : X.Etale) (U : X.Opens), (W ⟶ (wcZarToEt X).obj U) →
      Set.range W.hom ⊆ (U : Set X) := by
    intro W U a y hy
    obtain ⟨w, rfl⟩ := hy
    have ha : a.left ≫ U.ι = W.hom := MorphismProperty.Over.w a
    have h1 : U.ι (a.left w) ∈ Set.range U.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at h1
    rw [← ha]
    exact h1
  have hCP : CompatiblePreserving.{max u (u+1)} (Scheme.smallEtaleTopology X) (wcZarToEt X) := by
    constructor
    intro ℱ Z T x hx Y₁ Y₂ W f₁ f₂ g₁ g₂ hg₁ hg₂ _
    obtain ⟨h⟩ := s2 W (Y₁ ⊓ Y₂) (by
      rw [TopologicalSpace.Opens.coe_inf]
      exact Set.subset_inter (s2' W Y₁ f₁) (s2' W Y₂ f₂))
    have e1 : f₁ = h ≫ (wcZarToEt X).map (homOfLE (inf_le_left : Y₁ ⊓ Y₂ ≤ Y₁)) := s1 _ _ _ _
    have e2 : f₂ = h ≫ (wcZarToEt X).map (homOfLE (inf_le_right : Y₁ ⊓ Y₂ ≤ Y₂)) := s1 _ _ _ _
    have hc := hx (homOfLE (inf_le_left : Y₁ ⊓ Y₂ ≤ Y₁)) (homOfLE (inf_le_right : Y₁ ⊓ Y₂ ≤ Y₂))
      hg₁ hg₂ (Subsingleton.elim _ _)
    rw [e1, e2, op_comp, op_comp, Functor.map_comp, Functor.map_comp]
    exact congrArg (ℱ.obj.map h.op) hc
  have hCov : CoverPreserving (Opens.grothendieckTopology X) (Scheme.smallEtaleTopology X)
      (wcZarToEt X) := by
    constructor
    intro U S hS
    change _ ∈ Scheme.smallGrothendieckTopology @Etale X _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    let v' : ↥U := v
    obtain ⟨V, f, hf, hxV⟩ := (Opens.mem_grothendieckTopology X).1 hS (v' : X) v'.2
    refine ⟨(wcZarToEt X).obj V, (wcZarToEt X).map f, (⟨(v' : X), hxV⟩ : ↥V),
      Sieve.image_mem_functorPushforward (wcZarToEt X) S hf, ?_, ?_⟩
    · show Etale (X.homOfLE (leOfHom f))
      infer_instance
    · show (X.homOfLE (leOfHom f)) (⟨(v' : X), hxV⟩ : ↥V) = v'
      exact Subtype.ext (Scheme.homOfLE_apply _ _)
  refine ⟨Functor.isContinuous_of_coverPreserving hCP hCov,
    ⟨Limits.IsTerminal.ofUniqueHom
      (fun W => Classical.choice (s2 W ⊤ (by
        rw [TopologicalSpace.Opens.coe_top]; exact Set.subset_univ _)))
      (fun W m => s1 W ⊤ _ _)⟩,
    fun U V h => ⟨fun g k _ => s1 _ U g k⟩⟩

theorem wc_et_gm_zariski_restriction : ∀ (X : Scheme.{u}),
    (wcZarToEt X).IsContinuous (Opens.grothendieckTopology X) (Scheme.smallEtaleTopology X) →
    Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtGmPre X) →
    Nonempty ((wcZarToEt X).op ⋙ (wcEtGm X).obj ≅
      (wcZarGm X).obj ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) :=
by
  intro X hc hP
  haveI := hc
  let e1 : (wcZarToEt X).op ⋙ (wcEtGm X).obj ≅ (wcZarToEt X).op ⋙ wcEtGmPre X :=
    Functor.isoWhiskerLeft (wcZarToEt X).op
      (@asIso _ _ _ _ (toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X))
        (isIso_toSheafify _ hP)).symm
  let e2 : (wcZarToEt X).op ⋙ wcEtGmPre X ≅
      (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp) ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u} :=
    Functor.isoWhiskerRight (Scheme.restrictFunctorΓ (X := X))
      (forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u})
  have h1 : Presheaf.IsSheaf (Opens.grothendieckTopology X) ((wcZarToEt X).op ⋙ wcEtGmPre X) :=
    @Functor.op_comp_isSheaf_of_isSheaf _ _ _ _ (wcZarToEt X) _ _ (Opens.grothendieckTopology X)
      (Scheme.smallEtaleTopology X) hc (wcEtGmPre X) hP
  have h2 := (Presheaf.isSheaf_of_iso_iff e2).1 h1
  have hZ : Presheaf.IsSheaf (Opens.grothendieckTopology X)
      (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp) :=
    (Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget AddCommGrpCat.{u})).2
      ((isSheaf_iff_isSheaf_of_type _ _).2
        ((Presieve.isSheaf_comp_uliftFunctor_iff.{u, u+1} _).1
          ((isSheaf_iff_isSheaf_of_type _ _).1
            (GrothendieckTopology.HasSheafCompose.isSheaf (F := forget AddCommGrpCat.{u+1}) _ h2))))
  let e4 : (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp) ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ≅
      (wcZarGm X).obj ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} :=
    Functor.isoWhiskerRight
      (@asIso _ _ _ _ (toSheafify (Opens.grothendieckTopology X)
        (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp)) (isIso_toSheafify _ hZ))
      AddCommGrpCat.uliftFunctor.{u+1, u}
  exact ⟨e1.trans (e2.trans e4)⟩

theorem wc_gm_torsor_zariski_local : ∀ (X : Scheme.{u}),
    Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtGmPre X) →
    (∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.FaithfullyFlat A B]
      (c : TensorProduct A B B), IsUnit c →
      (Algebra.TensorProduct.map (AlgHom.id A B) Algebra.TensorProduct.includeRight c :
          TensorProduct A B (TensorProduct A B B)) =
        Algebra.TensorProduct.map (AlgHom.id A B) Algebra.TensorProduct.includeLeft c *
        Algebra.TensorProduct.includeRight c →
      ∀ (p : Ideal A), p.IsPrime → ∃ s : A, s ∉ p ∧ ∃ m n : B,
        ((1 : B) ⊗ₜ[A] m : TensorProduct A B B) = c * (m ⊗ₜ[A] (1 : B)) ∧
          m * n = algebraMap A B s) →
    ∀ {B Q : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} (f : wcEtGm X ⟶ B)
      (g : B ⟶ Q), f ≫ g = 0 →
    (∀ (V : X.Etale) (a : (wcEtGm X).obj.obj (Opposite.op V)),
      f.hom.app (Opposite.op V) a = 0 → a = 0) →
    (∀ (V : X.Etale) (b : B.obj.obj (Opposite.op V)), g.hom.app (Opposite.op V) b = 0 →
      ∃ a, f.hom.app (Opposite.op V) a = b) →
    (∀ (V : X.Etale) (q : Q.obj.obj (Opposite.op V)),
      Presheaf.imageSieve g.hom q ∈ Scheme.smallEtaleTopology X V) →
    ∀ (W : X.Opens) (q : Q.obj.obj (Opposite.op ((wcZarToEt X).obj W))) (x : X), x ∈ W →
      ∃ (W' : X.Opens) (h : W' ≤ W), x ∈ W' ∧
        ∃ b : B.obj.obj (Opposite.op ((wcZarToEt X).obj W')),
          g.hom.app _ b = Q.obj.map ((wcZarToEt X).map (homOfLE h)).op q :=
by
  intro X hP hDesc B Q f g hfg hinj hmid hls W q x hx

  have s1 : ∃ θ : ∀ Z : X.Etale, Additive (Γ(Z.left, ⊤))ˣ →+ (wcEtGm X).obj.obj (Opposite.op Z),
      (∀ Z, Function.Bijective (θ Z)) ∧
      ∀ (Z Z' : X.Etale) (h : Z ⟶ Z') (w : (Γ(Z'.left, ⊤))ˣ),
        (wcEtGm X).obj.map h.op (θ Z' (Additive.ofMul w)) =
          θ Z (Additive.ofMul (Units.map h.left.appTop.hom.toMonoidHom w)) := by
    haveI := isIso_toSheafify (Scheme.smallEtaleTopology X) hP
    refine ⟨fun Z => ((toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X)).app
        (Opposite.op Z)).hom.comp
      (AddEquiv.ulift.symm : Additive (Γ(Z.left, ⊤))ˣ ≃+ ULift.{u+1} (Additive (Γ(Z.left, ⊤))ˣ)).toAddMonoidHom,
      ?_, ?_⟩
    · intro Z
      exact (ConcreteCategory.bijective_of_isIso
        ((toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X)).app (Opposite.op Z))).comp
        AddEquiv.ulift.symm.bijective
    · intro Z Z' h w
      exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X)) h.op
        (ULift.up (Additive.ofMul w))).symm

  have s2 : ∀ (V : X.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology X V →
      ∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left := by
    intro V S hS v
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    obtain ⟨Y, f, y, hf, _, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS v
    exact ⟨Y, f, hf, y, hy⟩

  have s3 : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) [Etale f] (W : X.Opens) (x : X) (v : Y), x ∈ W →
      f v = x → ∃ (W₀ : X.Opens) (_ : IsAffineOpen W₀) (V : Y.Opens), IsAffineOpen V ∧ W₀ ≤ W ∧
        x ∈ W₀ ∧ v ∈ V ∧ V ≤ f ⁻¹ᵁ W₀ ∧ ∀ y ∈ W₀, ∃ z ∈ V, f z = y := by
    intro Y f _ W x v hx hv
    obtain ⟨W₁, hW₁, hxW₁, hW₁W⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hx
    have hvW₁ : v ∈ f ⁻¹ᵁ W₁ := by
      show f v ∈ W₁
      rw [hv]; exact hxW₁
    obtain ⟨V', hV', hvV', hV'le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens) hvW₁
    let O : X.Opens := ⟨f '' (V' : Set Y), f.isOpenMap _ V'.isOpen⟩
    have hxO : x ∈ O := ⟨v, hvV', hv⟩
    obtain ⟨r, hrO, hxr⟩ := IsAffineOpen.exists_basicOpen_le (X := X) hW₁ (V := O) ⟨x, hxO⟩ hxW₁
    have hbo := Scheme.basicOpen_appLE f V' W₁ hV'le r
    refine ⟨X.basicOpen r, hW₁.basicOpen r, Y.basicOpen ((f.appLE W₁ V' hV'le).hom r),
      hV'.basicOpen _, (X.basicOpen_le r).trans hW₁W, hxr, ?_, ?_, ?_⟩
    · rw [hbo]
      refine ⟨hvV', ?_⟩
      show f v ∈ X.basicOpen r
      rw [hv]; exact hxr
    · rw [hbo]
      exact inf_le_right
    · intro y hy
      obtain ⟨z, hz, hzy⟩ := hrO hy
      refine ⟨z, ?_, hzy⟩
      rw [hbo]
      refine ⟨hz, ?_⟩
      show f z ∈ X.basicOpen r
      rw [hzy]; exact hy

  have s4 : ∀ (V₁ : X.Etale) (W₀ : X.Opens) (hW₀ : IsAffineOpen W₀) (V : V₁.left.Opens),
      IsAffineOpen V → V ≤ V₁.hom ⁻¹ᵁ W₀ → (∀ y ∈ W₀, ∃ z ∈ V, V₁.hom z = y) →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra Γ(X, W₀) C) (_ : Algebra.Etale Γ(X, W₀) C),
        Module.FaithfullyFlat Γ(X, W₀) C ∧ Nonempty (wcEtAff X hW₀ C ⟶ V₁) := by
    intro V₁ W₀ hW₀ V hV i hsurj
    let φ := V₁.hom.appLE W₀ V i
    letI : Algebra Γ(X, W₀) Γ(V₁.left, V) := φ.hom.toAlgebra
    have hEt : RingHom.Etale φ.hom :=
      HasRingHomProperty.appLE @Etale V₁.hom V₁.prop ⟨W₀, hW₀⟩ ⟨V, hV⟩ i
    haveI hE : Algebra.Etale Γ(X, W₀) Γ(V₁.left, V) := RingHom.etale_algebraMap.mp hEt
    have hsq : Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) Γ(V₁.left, V))) ≫ hW₀.fromSpec =
        hV.fromSpec ≫ V₁.hom := IsAffineOpen.SpecMap_appLE_fromSpec V₁.hom hW₀ hV i
    refine ⟨Γ(V₁.left, V), inferInstance, inferInstance, hE, ?_, ?_⟩
    · apply Module.FaithfullyFlat.of_comap_surjective
      intro P
      let P' : Spec Γ(X, W₀) := P
      have hy : hW₀.fromSpec P' ∈ W₀ := hW₀.range_fromSpec.subset ⟨P', rfl⟩
      obtain ⟨z, hzV, hz⟩ := hsurj _ hy
      have hz' : z ∈ Set.range hV.fromSpec := hV.range_fromSpec.symm.subset hzV
      obtain ⟨Q, rfl⟩ := hz'
      refine ⟨Q, ?_⟩
      have h1 : hW₀.fromSpec (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) Γ(V₁.left, V))) Q) =
          hW₀.fromSpec P' := by
        rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply, hz]
      exact hW₀.fromSpec.isOpenEmbedding.injective h1
    · exact ⟨MorphismProperty.Over.homMk hV.fromSpec hsq.symm trivial⟩

  have s5 : ∀ (W : X.Opens) (Z : X.Etale) (a b : Z ⟶ (wcZarToEt X).obj W), a = b := by
    intro W Z a b
    apply MorphismProperty.Over.Hom.ext
    have ha : a.left ≫ W.ι = Z.hom := MorphismProperty.Over.w a
    have hb : b.left ≫ W.ι = Z.hom := MorphismProperty.Over.w b
    exact (cancel_mono W.ι).mp (ha.trans hb.symm)

  have key : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (x : R),
      (Spec.map φ).appTop.hom ((Scheme.ΓSpecIso R).inv.hom x) =
        (Scheme.ΓSpecIso S).inv.hom (φ.hom x) := by
    intro R S φ x
    rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality]
    rfl
  have key2 : ∀ (Z : Scheme.{u}) (R S : CommRingCat.{u}) (φ : R ⟶ S) (k : Z ⟶ Spec S) (x : R),
      (k ≫ Spec.map φ).appTop.hom ((Scheme.ΓSpecIso R).inv.hom x) =
        k.appTop.hom ((Scheme.ΓSpecIso S).inv.hom (φ.hom x)) := by
    intro Z R S φ k x
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, key]
  have specAlg : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [Algebra A R]
      [Algebra A S] (φ : R →ₐ[A] S),
      Spec.map (CommRingCat.ofHom (φ : R →+* S)) ≫ Spec.map (CommRingCat.ofHom (algebraMap A R)) =
        Spec.map (CommRingCat.ofHom (algebraMap A S)) := by
    intro A R S _ _ _ _ _ φ
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact AlgHom.comp_algebraMap _

  have s6 : ∀ (G B Q : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (θ : ∀ Z : X.Etale, Additive (Γ(Z.left, ⊤))ˣ →+ G.obj.obj (Opposite.op Z)),
      (∀ Z, Function.Surjective (θ Z)) →
      (∀ (Z Z' : X.Etale) (h : Z ⟶ Z') (w : (Γ(Z'.left, ⊤))ˣ),
        G.obj.map h.op (θ Z' (Additive.ofMul w)) =
          θ Z (Additive.ofMul (Units.map h.left.appTop.hom.toMonoidHom w))) →
      ∀ (f : G ⟶ B) (g : B ⟶ Q),
      (∀ (V : X.Etale) (b : B.obj.obj (Opposite.op V)), g.hom.app (Opposite.op V) b = 0 →
        ∃ a, f.hom.app (Opposite.op V) a = b) →
      ∀ (W₀ : X.Opens) (hW₀ : IsAffineOpen W₀) (C : Type u) [CommRing C] [Algebra Γ(X, W₀) C]
      [Algebra.Etale Γ(X, W₀) C] (b : B.obj.obj (Opposite.op (wcEtAff X hW₀ C))),
      (∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ wcEtAff X hW₀ C),
        Q.obj.map p₁.op (g.hom.app _ b) = Q.obj.map p₂.op (g.hom.app _ b)) →
      ∃ c : TensorProduct Γ(X, W₀) C C, IsUnit c ∧
        ∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ wcEtAff X hW₀ C)
          (h : Z.left ⟶ Spec (CommRingCat.of (TensorProduct Γ(X, W₀) C C))),
          h ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) = p₁.left →
          h ≫ Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
              C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) =
            p₂.left →
          ∃ w : (Γ(Z.left, ⊤))ˣ, (w : Γ(Z.left, ⊤)) =
              h.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).inv.hom c) ∧
            B.obj.map p₁.op b - B.obj.map p₂.op b =
              f.hom.app (Opposite.op Z) (θ Z (Additive.ofMul w)) := by
    intro G B Q θ hθs hnat f g hmid W₀ hW₀ C _ _ _ b hcomp
    haveI : Algebra.Etale Γ(X, W₀) (TensorProduct Γ(X, W₀) C C) := Algebra.Etale.comp _ C _
    have hL : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          C →+* TensorProduct Γ(X, W₀) C C)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) (TensorProduct Γ(X, W₀) C C))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hR : Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
          C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) (TensorProduct Γ(X, W₀) C C))) :=
      specAlg _ _ _ _
    have hL' : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          C →+* TensorProduct Γ(X, W₀) C C)) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) ≫ hW₀.fromSpec) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) (TensorProduct Γ(X, W₀) C C))) ≫
          hW₀.fromSpec := by rw [← Category.assoc, hL]
    have hR' : Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
          C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) ≫ hW₀.fromSpec) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) (TensorProduct Γ(X, W₀) C C))) ≫
          hW₀.fromSpec := by rw [← Category.assoc, hR]
    let Z₂ := wcEtAff X hW₀ (TensorProduct Γ(X, W₀) C C)
    let π₁ : Z₂ ⟶ wcEtAff X hW₀ C := MorphismProperty.Over.homMk
      (Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)) hL' trivial
    let π₂ : Z₂ ⟶ wcEtAff X hW₀ C := MorphismProperty.Over.homMk
      (Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
          C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C))) hR' trivial
    have hd : g.hom.app (Opposite.op Z₂) (B.obj.map π₁.op b - B.obj.map π₂.op b) = 0 := by
      rw [map_sub, NatTrans.naturality_apply g.hom π₁.op b, NatTrans.naturality_apply g.hom π₂.op b,
        hcomp Z₂ π₁ π₂, sub_self]
    obtain ⟨a, ha⟩ := hmid Z₂ _ hd
    obtain ⟨w₀', hw₀'⟩ := hθs Z₂ a
    let w₀ : (Γ(Z₂.left, ⊤))ˣ := Additive.toMul w₀'
    let c : TensorProduct Γ(X, W₀) C C :=
      (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).hom.hom (w₀ : Γ(Z₂.left, ⊤))
    have hc : (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).inv.hom c =
        (w₀ : Γ(Z₂.left, ⊤)) := Iso.hom_inv_id_apply _ _
    refine ⟨c, w₀.isUnit.map _, ?_⟩
    intro Z p₁ p₂ h h1 h2
    have hk : h ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) (TensorProduct Γ(X, W₀) C C))) ≫
        hW₀.fromSpec) = Z.hom := by
      rw [← hL', ← Category.assoc, h1]
      exact MorphismProperty.Over.w p₁
    let k : Z ⟶ Z₂ := MorphismProperty.Over.homMk h hk trivial
    have hk1 : k ≫ π₁ = p₁ := MorphismProperty.Over.Hom.ext h1
    have hk2 : k ≫ π₂ = p₂ := MorphismProperty.Over.Hom.ext h2
    refine ⟨Units.map h.appTop.hom.toMonoidHom w₀, ?_, ?_⟩
    · change h.appTop.hom (w₀ : Γ(Z₂.left, ⊤)) = _
      rw [hc]
    · rw [← hk1, ← hk2, op_comp, op_comp, Functor.map_comp, Functor.map_comp,
        ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, ← map_sub, ← ha,
        ← NatTrans.naturality_apply f.hom k.op a, ← hw₀']
      exact congrArg (f.hom.app (Opposite.op Z)) (hnat Z Z₂ k w₀)

  have s7 : ∀ (G B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (θ : ∀ Z : X.Etale, Additive (Γ(Z.left, ⊤))ˣ →+ G.obj.obj (Opposite.op Z)),
      (∀ Z, Function.Injective (θ Z)) → ∀ (f : G ⟶ B),
      (∀ (V : X.Etale) (a : G.obj.obj (Opposite.op V)), f.hom.app (Opposite.op V) a = 0 → a = 0) →
      ∀ (W₀ : X.Opens) (hW₀ : IsAffineOpen W₀) (C : Type u) [CommRing C] [Algebra Γ(X, W₀) C]
      [Algebra.Etale Γ(X, W₀) C] (b : B.obj.obj (Opposite.op (wcEtAff X hW₀ C)))
      (c : TensorProduct Γ(X, W₀) C C),
      (∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ wcEtAff X hW₀ C)
          (h : Z.left ⟶ Spec (CommRingCat.of (TensorProduct Γ(X, W₀) C C))),
          h ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) = p₁.left →
          h ≫ Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
              C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) =
            p₂.left →
          ∃ w : (Γ(Z.left, ⊤))ˣ, (w : Γ(Z.left, ⊤)) =
              h.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).inv.hom c) ∧
            B.obj.map p₁.op b - B.obj.map p₂.op b =
              f.hom.app (Opposite.op Z) (θ Z (Additive.ofMul w))) →
      (Algebra.TensorProduct.map (AlgHom.id Γ(X, W₀) C) Algebra.TensorProduct.includeRight c :
          TensorProduct Γ(X, W₀) C (TensorProduct Γ(X, W₀) C C)) =
        Algebra.TensorProduct.map (AlgHom.id Γ(X, W₀) C) Algebra.TensorProduct.includeLeft c *
        Algebra.TensorProduct.includeRight c := by
    intro G B θ hθi f hinj W₀ hW₀ C _ _ _ b c hprop
    haveI : Algebra.Etale Γ(X, W₀) (TensorProduct Γ(X, W₀) C C) := Algebra.Etale.comp _ C _
    haveI : Algebra.Etale Γ(X, W₀) (TensorProduct Γ(X, W₀) C (TensorProduct Γ(X, W₀) C C)) :=
      Algebra.Etale.comp _ C _
    let A := Γ(X, W₀)
    let T2 := TensorProduct A C C
    let T3 := TensorProduct A C T2
    let iL : C →ₐ[A] T2 := Algebra.TensorProduct.includeLeft
    let iR : C →ₐ[A] T2 := Algebra.TensorProduct.includeRight
    let σ₁₂ : T2 →ₐ[A] T3 :=
      Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft
    let σ₁₃ : T2 →ₐ[A] T3 :=
      Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight
    let σ₂₃ : T2 →ₐ[A] T3 := Algebra.TensorProduct.includeRight
    have gen : ∀ (A' C' : Type u) [CommRing A'] [CommRing C'] [Algebra A' C'],
      ((Algebra.TensorProduct.includeRight :
          TensorProduct A' C' C' →ₐ[A'] TensorProduct A' C' (TensorProduct A' C' C')).comp
          Algebra.TensorProduct.includeLeft =
        (Algebra.TensorProduct.map (AlgHom.id A' C') Algebra.TensorProduct.includeLeft).comp
          (Algebra.TensorProduct.includeRight : C' →ₐ[A'] TensorProduct A' C' C')) ∧
      ((Algebra.TensorProduct.includeRight :
          TensorProduct A' C' C' →ₐ[A'] TensorProduct A' C' (TensorProduct A' C' C')).comp
          Algebra.TensorProduct.includeRight =
        (Algebra.TensorProduct.map (AlgHom.id A' C') Algebra.TensorProduct.includeRight).comp
          (Algebra.TensorProduct.includeRight : C' →ₐ[A'] TensorProduct A' C' C')) ∧
      ((Algebra.TensorProduct.map (AlgHom.id A' C') Algebra.TensorProduct.includeRight :
          TensorProduct A' C' C' →ₐ[A'] TensorProduct A' C' (TensorProduct A' C' C')).comp
          (Algebra.TensorProduct.includeLeft : C' →ₐ[A'] TensorProduct A' C' C') =
        (Algebra.TensorProduct.map (AlgHom.id A' C') Algebra.TensorProduct.includeLeft).comp
          (Algebra.TensorProduct.includeLeft : C' →ₐ[A'] TensorProduct A' C' C')) := by
      intro A' C' _ _ _
      refine ⟨?_, ?_, ?_⟩ <;> (apply AlgHom.ext; intro x; simp)
    obtain ⟨e1, e2, e3⟩ := gen A C
    change σ₂₃.comp iL = σ₁₂.comp iR at e1
    change σ₂₃.comp iR = σ₁₃.comp iR at e2
    change σ₁₃.comp iL = σ₁₂.comp iL at e3
    have sp : ∀ (φ : T2 →ₐ[A] T3) (ψ : C →ₐ[A] T2),
        Spec.map (CommRingCat.ofHom (φ : T2 →+* T3)) ≫ Spec.map (CommRingCat.ofHom (ψ : C →+* T2)) =
          Spec.map (CommRingCat.ofHom ((φ.comp ψ : C →ₐ[A] T3) : C →+* T3)) := by
      intro φ ψ
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    let Z₃ := wcEtAff X hW₀ T3
    have hmk : ∀ π : C →ₐ[A] T3, Spec.map (CommRingCat.ofHom (π : C →+* T3)) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) ≫ hW₀.fromSpec) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) T3)) ≫ hW₀.fromSpec := by
      intro π
      rw [← Category.assoc, specAlg]
    let mk : (C →ₐ[A] T3) → (Z₃ ⟶ wcEtAff X hW₀ C) := fun π =>
      MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom (π : C →+* T3))) (hmk π) trivial
    have cg : ∀ π π' : C →ₐ[A] T3, π = π' →
        Spec.map (CommRingCat.ofHom (π : C →+* T3)) = Spec.map (CommRingCat.ofHom (π' : C →+* T3)) :=
      fun π π' h => by rw [h]
    obtain ⟨w₁₂, hw₁₂, h₁₂⟩ := hprop Z₃ (mk (σ₁₂.comp iL)) (mk (σ₁₂.comp iR))
      (Spec.map (CommRingCat.ofHom (σ₁₂ : T2 →+* T3))) (sp σ₁₂ iL) (sp σ₁₂ iR)
    obtain ⟨w₂₃, hw₂₃, h₂₃⟩ := hprop Z₃ (mk (σ₁₂.comp iR)) (mk (σ₁₃.comp iR))
      (Spec.map (CommRingCat.ofHom (σ₂₃ : T2 →+* T3))) ((sp σ₂₃ iL).trans (cg _ _ e1))
      ((sp σ₂₃ iR).trans (cg _ _ e2))
    obtain ⟨w₁₃, hw₁₃, h₁₃⟩ := hprop Z₃ (mk (σ₁₂.comp iL)) (mk (σ₁₃.comp iR))
      (Spec.map (CommRingCat.ofHom (σ₁₃ : T2 →+* T3))) ((sp σ₁₃ iL).trans (cg _ _ e3))
      (sp σ₁₃ iR)
    have hfi : Function.Injective (f.hom.app (Opposite.op Z₃)) := by
      intro x y hxy
      exact sub_eq_zero.mp (hinj Z₃ _ (by rw [map_sub, hxy, sub_self]))
    have hw : w₁₃ = w₁₂ * w₂₃ := by
      have : f.hom.app (Opposite.op Z₃) (θ Z₃ (Additive.ofMul w₁₃)) =
          f.hom.app (Opposite.op Z₃) (θ Z₃ (Additive.ofMul (w₁₂ * w₂₃))) := by
        rw [ofMul_mul, map_add, map_add, ← h₁₃, ← h₁₂, ← h₂₃]
        abel
      exact Additive.ofMul.injective (hθi Z₃ (hfi this))
    have hcoe := congrArg (fun u : (Γ(Z₃.left, ⊤))ˣ => (u : Γ(Z₃.left, ⊤))) hw
    simp only [Units.val_mul] at hcoe
    rw [hw₁₃, hw₁₂, hw₂₃] at hcoe
    have k1 := key (CommRingCat.of T2) (CommRingCat.of T3) (CommRingCat.ofHom (σ₁₃ : T2 →+* T3)) c
    have k2 := key (CommRingCat.of T2) (CommRingCat.of T3) (CommRingCat.ofHom (σ₁₂ : T2 →+* T3)) c
    have k3 := key (CommRingCat.of T2) (CommRingCat.of T3) (CommRingCat.ofHom (σ₂₃ : T2 →+* T3)) c
    erw [k1, k2, k3, ← map_mul] at hcoe
    have hinv := congrArg (Scheme.ΓSpecIso (CommRingCat.of T3)).hom.hom hcoe
    erw [Iso.inv_hom_id_apply, Iso.inv_hom_id_apply] at hinv
    exact hinv

  have s8 : ∀ (G B Q : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (θ : ∀ Z : X.Etale, Additive (Γ(Z.left, ⊤))ˣ →+ G.obj.obj (Opposite.op Z)),
      (∀ (Z Z' : X.Etale) (h : Z ⟶ Z') (w : (Γ(Z'.left, ⊤))ˣ),
        G.obj.map h.op (θ Z' (Additive.ofMul w)) =
          θ Z (Additive.ofMul (Units.map h.left.appTop.hom.toMonoidHom w))) →
      ∀ (f : G ⟶ B) (g : B ⟶ Q), f ≫ g = 0 →
      ∀ (W₀ : X.Opens) (hW₀ : IsAffineOpen W₀) (C D : Type u) [CommRing C] [CommRing D]
      [Algebra Γ(X, W₀) C] [Algebra Γ(X, W₀) D] [Algebra C D] [IsScalarTower Γ(X, W₀) C D]
      [Algebra.Etale Γ(X, W₀) C] [Algebra.Etale Γ(X, W₀) D]
      (b : B.obj.obj (Opposite.op (wcEtAff X hW₀ C))) (c : TensorProduct Γ(X, W₀) C C),
      (∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ wcEtAff X hW₀ C)
          (h : Z.left ⟶ Spec (CommRingCat.of (TensorProduct Γ(X, W₀) C C))),
          h ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) = p₁.left →
          h ≫ Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
              C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) =
            p₂.left →
          ∃ w : (Γ(Z.left, ⊤))ˣ, (w : Γ(Z.left, ⊤)) =
              h.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).inv.hom c) ∧
            B.obj.map p₁.op b - B.obj.map p₂.op b =
              f.hom.app (Opposite.op Z) (θ Z (Additive.ofMul w))) →
      ∀ (m : C), ((1 : C) ⊗ₜ[Γ(X, W₀)] m : TensorProduct Γ(X, W₀) C C) =
        c * (m ⊗ₜ[Γ(X, W₀)] (1 : C)) → IsUnit (algebraMap C D m) →
      ∃ (κ : wcEtAff X hW₀ D ⟶ wcEtAff X hW₀ C) (b' : B.obj.obj (Opposite.op (wcEtAff X hW₀ D))),
        (∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ wcEtAff X hW₀ D), B.obj.map p₁.op b' = B.obj.map p₂.op b') ∧
        g.hom.app _ b' = Q.obj.map κ.op (g.hom.app _ b) := by
    intro G B Q θ hnat f g hfg W₀ hW₀ C D _ _ _ _ _ _ _ _ b c hprop m hm hu
    have hgf : ∀ (V : X.Etale) (x : G.obj.obj (Opposite.op V)),
        g.hom.app (Opposite.op V) (f.hom.app (Opposite.op V) x) = 0 := fun V x => by
      have h := congrArg (fun φ : G ⟶ Q => φ.hom.app (Opposite.op V) x) hfg
      exact h
    have hκ : Spec.map (CommRingCat.ofHom (algebraMap C D)) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) ≫ hW₀.fromSpec) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) D)) ≫ hW₀.fromSpec := by
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq]
    let ED := wcEtAff X hW₀ D
    let κ : ED ⟶ wcEtAff X hW₀ C :=
      MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom (algebraMap C D))) hκ trivial
    let μ : (Γ(ED.left, ⊤))ˣ := (hu.map (Scheme.ΓSpecIso (CommRingCat.of D)).inv.hom).unit
    have hμ : (μ : Γ(ED.left, ⊤)) =
        (Scheme.ΓSpecIso (CommRingCat.of D)).inv.hom (algebraMap C D m) :=
      IsUnit.unit_spec _
    let b' : B.obj.obj (Opposite.op ED) :=
      B.obj.map κ.op b + f.hom.app (Opposite.op ED) (θ ED (Additive.ofMul μ))
    refine ⟨κ, b', ?_, ?_⟩
    · intro Z p₁ p₂
      let q₁ : Z ⟶ wcEtAff X hW₀ C := p₁ ≫ κ
      let q₂ : Z ⟶ wcEtAff X hW₀ C := p₂ ≫ κ
      have w1 : (q₁.left ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C))) ≫
          hW₀.fromSpec = Z.hom := (Category.assoc _ _ _).trans (MorphismProperty.Over.w q₁)
      have w2 : (q₂.left ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C))) ≫
          hW₀.fromSpec = Z.hom := (Category.assoc _ _ _).trans (MorphismProperty.Over.w q₂)
      have hq : q₁.left ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) =
          q₂.left ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) C)) :=
        (cancel_mono hW₀.fromSpec).mp (w1.trans w2.symm)
      let h : Z.left ⟶ Spec (CommRingCat.of (TensorProduct Γ(X, W₀) C C)) :=
        Limits.pullback.lift q₁.left q₂.left hq ≫ (pullbackSpecIso Γ(X, W₀) C C).hom
      have h1 : h ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
          q₁.left :=
        (Category.assoc _ _ _).trans ((congrArg _ (pullbackSpecIso_hom_fst _ _ _)).trans
          (Limits.pullback.lift_fst _ _ _))
      have h2 : h ≫ Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
              C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) =
          q₂.left :=
        (Category.assoc _ _ _).trans ((congrArg _ (pullbackSpecIso_hom_snd _ _ _)).trans
          (Limits.pullback.lift_snd _ _ _))
      obtain ⟨w, hw, hdiff⟩ := hprop Z q₁ q₂ h h1 h2
      let v₁ : (Γ(Z.left, ⊤))ˣ := Units.map p₁.left.appTop.hom.toMonoidHom μ
      let v₂ : (Γ(Z.left, ⊤))ˣ := Units.map p₂.left.appTop.hom.toMonoidHom μ
      have hb1 : B.obj.map p₁.op b' = B.obj.map (p₁ ≫ κ).op b +
          f.hom.app (Opposite.op Z) (θ Z (Additive.ofMul v₁)) := by
        show B.obj.map p₁.op (B.obj.map κ.op b +
          f.hom.app (Opposite.op ED) (θ ED (Additive.ofMul μ))) = _
        rw [map_add, op_comp, Functor.map_comp, ConcreteCategory.comp_apply,
          ← NatTrans.naturality_apply f.hom p₁.op, hnat]
      have hb2 : B.obj.map p₂.op b' = B.obj.map (p₂ ≫ κ).op b +
          f.hom.app (Opposite.op Z) (θ Z (Additive.ofMul v₂)) := by
        show B.obj.map p₂.op (B.obj.map κ.op b +
          f.hom.app (Opposite.op ED) (θ ED (Additive.ofMul μ))) = _
        rw [map_add, op_comp, Functor.map_comp, ConcreteCategory.comp_apply,
          ← NatTrans.naturality_apply f.hom p₂.op, hnat]
      have e1 : p₁.left ≫ Spec.map (CommRingCat.ofHom (algebraMap C D)) =
          h ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := h1.symm
      have e2 : p₂.left ≫ Spec.map (CommRingCat.ofHom (algebraMap C D)) =
          h ≫ Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
              C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) :=
        h2.symm
      have hv1 : (v₁ : Γ(Z.left, ⊤)) = h.appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).inv.hom
            (m ⊗ₜ[Γ(X, W₀)] (1 : C))) := by
        have k := key2 Z.left (CommRingCat.of C) (CommRingCat.of D)
          (CommRingCat.ofHom (algebraMap C D)) p₁.left m
        have k' := key2 Z.left (CommRingCat.of C) (CommRingCat.of (TensorProduct Γ(X, W₀) C C))
          (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) h m
        change p₁.left.appTop.hom (μ : Γ(ED.left, ⊤)) = _
        rw [hμ]
        exact k.symm.trans ((congrArg (fun t : Z.left ⟶ Spec (CommRingCat.of C) =>
          t.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom m)) e1).trans k')
      have hv2 : (v₂ : Γ(Z.left, ⊤)) = h.appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct Γ(X, W₀) C C))).inv.hom
            ((1 : C) ⊗ₜ[Γ(X, W₀)] m)) := by
        have k := key2 Z.left (CommRingCat.of C) (CommRingCat.of D)
          (CommRingCat.ofHom (algebraMap C D)) p₂.left m
        have k' := key2 Z.left (CommRingCat.of C) (CommRingCat.of (TensorProduct Γ(X, W₀) C C))
          (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
              C →ₐ[Γ(X, W₀)] TensorProduct Γ(X, W₀) C C) : C →+* TensorProduct Γ(X, W₀) C C)) h m
        change p₂.left.appTop.hom (μ : Γ(ED.left, ⊤)) = _
        rw [hμ]
        exact k.symm.trans ((congrArg (fun t : Z.left ⟶ Spec (CommRingCat.of C) =>
          t.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom m)) e2).trans k')
      have hwv : w * v₁ = v₂ := by
        apply Units.ext
        rw [Units.val_mul, hw, hv1, hv2, ← map_mul, ← map_mul, ← hm]
      rw [hb1, hb2]
      change B.obj.map q₁.op b + _ = B.obj.map q₂.op b + _
      rw [sub_eq_iff_eq_add.mp hdiff, ← hwv, ofMul_mul, map_add, map_add]
      abel
    · show g.hom.app _ (B.obj.map κ.op b +
        f.hom.app (Opposite.op ED) (θ ED (Additive.ofMul μ))) = _
      rw [map_add, NatTrans.naturality_apply g.hom κ.op b, hgf, add_zero]

  have s9 : ∀ (W₀ : X.Opens) (hW₀ : IsAffineOpen W₀) (C D : Type u) [CommRing C]
      [CommRing D] [Algebra Γ(X, W₀) C] [Algebra Γ(X, W₀) D] [Algebra C D]
      [IsScalarTower Γ(X, W₀) C D] [Algebra.Etale Γ(X, W₀) D] [Module.FaithfullyFlat Γ(X, W₀) C]
      (s : Γ(X, W₀)) [IsLocalization.Away (algebraMap Γ(X, W₀) C s) D],
      ∃ ε : wcEtAff X hW₀ D ⟶ (wcZarToEt X).obj (X.basicOpen s), Function.Surjective ε.left := by
    intro W₀ hW₀ C D _ _ _ _ _ _ _ _ s _
    let F := Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) D)) ≫ hW₀.fromSpec
    have hcomap : ∀ z : Spec (CommRingCat.of D),
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) D)) z =
          PrimeSpectrum.comap (algebraMap Γ(X, W₀) D) z := fun z => rfl
    have hrange : Set.range F ⊆ Set.range (X.basicOpen s).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hunit : IsUnit (algebraMap Γ(X, W₀) D s) := by
        rw [IsScalarTower.algebraMap_apply Γ(X, W₀) C D]
        exact IsLocalization.Away.algebraMap_isUnit _
      have hsP : Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) D)) z ∈
          PrimeSpectrum.basicOpen s := by
        rw [hcomap]
        intro hmem
        exact z.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem hunit)
      rw [← hW₀.fromSpec_preimage_basicOpen] at hsP
      exact hsP
    let l := IsOpenImmersion.lift (X.basicOpen s).ι F hrange
    have hl : l ≫ (X.basicOpen s).ι = F := IsOpenImmersion.lift_fac _ _ _
    refine ⟨MorphismProperty.Over.homMk l hl trivial, ?_⟩
    intro y
    have hyx : (X.basicOpen s).ι y ∈ (X.basicOpen s : Set X) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
    have hy : ((X.basicOpen s).ι y) ∈ Set.range hW₀.fromSpec := by
      rw [hW₀.range_fromSpec]
      exact X.basicOpen_le s hyx
    obtain ⟨P, hP⟩ := hy
    have hsP : P ∈ PrimeSpectrum.basicOpen s := by
      rw [← hW₀.fromSpec_preimage_basicOpen]
      show hW₀.fromSpec P ∈ X.basicOpen s
      rw [hP]
      exact hyx
    obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := Γ(X, W₀)) (B := C) P
    have hQs : Q ∈ PrimeSpectrum.basicOpen (algebraMap Γ(X, W₀) C s) := by
      intro hmem
      apply hsP
      rw [← hQ]
      exact hmem
    rw [← SetLike.mem_coe, ← PrimeSpectrum.localization_away_comap_range D] at hQs
    obtain ⟨z, hz⟩ := hQs
    refine ⟨z, ?_⟩
    apply (X.basicOpen s).ι.isOpenEmbedding.injective
    change (l ≫ (X.basicOpen s).ι) z = _
    rw [hl, ← hP]
    change hW₀.fromSpec (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W₀) D)) z) = _
    congr 1
    change PrimeSpectrum.comap (algebraMap Γ(X, W₀) D) z = P
    rw [IsScalarTower.algebraMap_eq Γ(X, W₀) C D, PrimeSpectrum.comap_comp_apply, hz, hQ]

  have s10 : ∀ (V : X.Etale) (S : Sieve V),
      (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) →
      S ∈ Scheme.smallEtaleTopology X V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have s11 : ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      {V U : X.Etale} (e : V ⟶ U),
      Sieve.generate (Presieve.singleton e) ∈ Scheme.smallEtaleTopology X U →
      (∀ t t' : F.obj.obj (Opposite.op U), F.obj.map e.op t = F.obj.map e.op t' → t = t') ∧
      ∀ s : F.obj.obj (Opposite.op V), (∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ V), p₁ ≫ e = p₂ ≫ e →
        F.obj.map p₁.op s = F.obj.map p₂.op s) →
        ∃ t : F.obj.obj (Opposite.op U), F.obj.map e.op t = s := by
    intro F V U e he
    have hF : Presieve.IsSheaf (Scheme.smallEtaleTopology X) (F.obj ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) F.obj
          (forget AddCommGrpCat.{u+1})).1 F.property)
    have h1 := (Presieve.isSheafFor_iff_generate (Presieve.singleton e)).2 (hF _ he)
    have h2 := (Presieve.isSheafFor_singleton (P := F.obj ⋙ forget AddCommGrpCat)).1 h1
    refine ⟨fun t t' htt => ?_, fun s hs => ?_⟩
    · obtain ⟨t₀, _, ht₀⟩ := h2 (F.obj.map e.op t) (fun {Z} p₁ p₂ hp => by
        change F.obj.map p₁.op (F.obj.map e.op t) = F.obj.map p₂.op (F.obj.map e.op t)
        rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
          ← Functor.map_comp, ← op_comp, ← op_comp, hp])
      exact (ht₀ t rfl).trans (ht₀ t' htt.symm).symm
    · obtain ⟨t₀, ht₀, _⟩ := h2 s (fun {Z} p₁ p₂ hp => hs Z p₁ p₂ hp)
      exact ⟨t₀, ht₀⟩

  obtain ⟨θ, hθ, hnat⟩ := s1
  obtain ⟨V₁, c, hcS, v₁, hv₁⟩ := s2 _ (Presheaf.imageSieve g.hom q)
    (hls ((wcZarToEt X).obj W) q) (⟨x, hx⟩ : (W : Scheme.{u}))
  have hv : V₁.hom v₁ = x := by
    have hw : c.left ≫ W.ι = V₁.hom := MorphismProperty.Over.w c
    exact (congrArg (fun φ : V₁.left ⟶ X => φ v₁) hw).symm.trans
      ((Scheme.Hom.comp_apply c.left W.ι v₁).trans (congrArg W.ι hv₁))
  haveI : Etale V₁.hom := V₁.prop
  obtain ⟨W₀, hW₀, V, hV, hW₀W, hxW₀, -, hVle, hsurj⟩ := s3 V₁.left V₁.hom W x v₁ hx hv
  obtain ⟨C, iC, iA, iE, hff, ⟨α⟩⟩ := s4 V₁ W₀ hW₀ V hV hVle hsurj
  obtain ⟨b, hb⟩ := (Presheaf.imageSieve g.hom q).downward_closed hcS α
  have hcomp : ∀ (Z : X.Etale) (p₁ p₂ : Z ⟶ wcEtAff X hW₀ C),
      Q.obj.map p₁.op (g.hom.app _ b) = Q.obj.map p₂.op (g.hom.app _ b) := by
    intro Z p₁ p₂
    rw [hb, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
      ← Functor.map_comp, ← op_comp, ← op_comp, s5 W Z (p₁ ≫ α ≫ c) (p₂ ≫ α ≫ c)]
  obtain ⟨c₀, hunit, hprop⟩ := s6 (wcEtGm X) B Q θ (fun Z => (hθ Z).2) hnat f g hmid W₀ hW₀ C b
    hcomp
  have hcoc := s7 (wcEtGm X) B θ (fun Z => (hθ Z).1) f hinj W₀ hW₀ C b c₀ hprop
  let P := hW₀.primeIdealOf ⟨x, hxW₀⟩
  obtain ⟨s, hs, m, n, hm1, hmn⟩ := hDesc Γ(X, W₀) C c₀ hunit hcoc P.asIdeal P.isPrime
  have hxs : x ∈ X.basicOpen s := by
    have h1 : (P : Spec Γ(X, W₀)) ∈ hW₀.fromSpec ⁻¹ᵁ X.basicOpen s := by
      rw [hW₀.fromSpec_preimage_basicOpen]; exact hs
    have h2 := hW₀.fromSpec_primeIdealOf ⟨x, hxW₀⟩
    change hW₀.fromSpec P ∈ X.basicOpen s at h1
    rw [h2] at h1
    exact h1
  have hle : X.basicOpen s ≤ W := (X.basicOpen_le s).trans hW₀W
  let D := Localization.Away (algebraMap Γ(X, W₀) C s)
  haveI : Algebra.Etale Γ(X, W₀) D := Algebra.Etale.comp _ C _
  have hunitD : IsUnit (algebraMap C D m) := by
    have h1 : IsUnit (algebraMap C D (algebraMap Γ(X, W₀) C s)) :=
      IsLocalization.Away.algebraMap_isUnit _
    have h2 : algebraMap C D (algebraMap Γ(X, W₀) C s) = algebraMap C D m * algebraMap C D n := by
      rw [← map_mul, hmn]
    rw [h2] at h1
    exact isUnit_of_mul_isUnit_left h1
  obtain ⟨κ, b', hcomp', hgb'⟩ := s8 (wcEtGm X) B Q θ hnat f g hfg W₀ hW₀ C D b c₀ hprop m hm1
    hunitD
  obtain ⟨ε, hεs⟩ := s9 W₀ hW₀ C D s
  have hcov : Sieve.generate (Presieve.singleton ε) ∈
      Scheme.smallEtaleTopology X ((wcZarToEt X).obj (X.basicOpen s)) := by
    apply s10
    intro u
    obtain ⟨z, hz⟩ := hεs u
    exact ⟨_, ε, Sieve.le_generate _ _ _ (Presieve.singleton_self ε), z, hz⟩
  obtain ⟨t, ht⟩ := (s11 B ε hcov).2 b' (fun Z p₁ p₂ _ => hcomp' Z p₁ p₂)
  refine ⟨X.basicOpen s, hle, hxs, t, ?_⟩
  apply (s11 Q ε hcov).1
  rw [← NatTrans.naturality_apply g.hom ε.op t, ht, hgb', hb, ← ConcreteCategory.comp_apply,
    ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp,
    s5 W _ (κ ≫ α ≫ c) (ε ≫ (wcZarToEt X).map (homOfLE hle))]

theorem wc_ff_unit_cocycle_locally_trivial : ∀ (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B] [Module.FaithfullyFlat A B] (c : TensorProduct A B B), IsUnit c →
    (Algebra.TensorProduct.map (AlgHom.id A B) Algebra.TensorProduct.includeRight c :
        TensorProduct A B (TensorProduct A B B)) =
      Algebra.TensorProduct.map (AlgHom.id A B) Algebra.TensorProduct.includeLeft c *
      Algebra.TensorProduct.includeRight c →
    ∀ (p : Ideal A), p.IsPrime → ∃ s : A, s ∉ p ∧ ∃ m n : B,
      ((1 : B) ⊗ₜ[A] m : TensorProduct A B B) = c * (m ⊗ₜ[A] (1 : B)) ∧
        m * n = algebraMap A B s :=
by
  intro A B _ _ _ _ c hc hcoc p hp
  classical

  have hμ : Algebra.TensorProduct.lmul' A c = (1 : B) := by
    let ψ : TensorProduct A B (TensorProduct A B B) →ₐ[A] TensorProduct A B B :=
      Algebra.TensorProduct.map (AlgHom.id A B) (Algebra.TensorProduct.lmul' A)
    have h13 : ∀ w : TensorProduct A B B, ψ (Algebra.TensorProduct.map (AlgHom.id A B)
        Algebra.TensorProduct.includeRight w) = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x y => simp [ψ]
      | add x y hx hy => simp only [map_add, hx, hy]
    have h12 : ∀ w : TensorProduct A B B, ψ (Algebra.TensorProduct.map (AlgHom.id A B)
        Algebra.TensorProduct.includeLeft w) = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x y => simp [ψ]
      | add x y hx hy => simp only [map_add, hx, hy]
    have h23 : ∀ z : TensorProduct A B B, ψ (Algebra.TensorProduct.includeRight z) =
        (1 : B) ⊗ₜ[A] Algebra.TensorProduct.lmul' A z := by
      intro z
      simp [ψ]
    have h := congrArg ψ hcoc
    rw [map_mul, h13, h12, h23] at h
    have h' : c * 1 = c * ((1 : B) ⊗ₜ[A] Algebra.TensorProduct.lmul' A c) := by
      rw [mul_one]; exact h
    have h'' := hc.mul_left_cancel h'
    apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := A) (B := B) B
    simp only [TensorProduct.mk_apply]
    rw [← Algebra.TensorProduct.one_def]
    exact h''.symm

  let δ : B →ₗ[A] TensorProduct A B B :=
    TensorProduct.mk A B B 1 - (LinearMap.mulLeft A c) ∘ₗ (TensorProduct.mk A B B).flip 1
  have hδ : ∀ m, δ m = (1 : B) ⊗ₜ[A] m - c * (m ⊗ₜ[A] (1 : B)) := fun m => rfl
  have hker : ∀ m, m ∈ LinearMap.ker δ ↔ (1 : B) ⊗ₜ[A] m = c * (m ⊗ₜ[A] (1 : B)) := by
    intro m
    rw [LinearMap.mem_ker, hδ, sub_eq_zero]
  have hstar : ∀ w : TensorProduct A B B, LinearMap.lTensor B δ w =
      Algebra.TensorProduct.map (AlgHom.id A B) Algebra.TensorProduct.includeRight w -
        Algebra.TensorProduct.includeRight c *
          Algebra.TensorProduct.map (AlgHom.id A B) Algebra.TensorProduct.includeLeft w := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul x m =>
      rw [LinearMap.lTensor_tmul, hδ, TensorProduct.tmul_sub]
      simp [Algebra.TensorProduct.tmul_mul_tmul]
    | add x y hx hy =>
      rw [map_add, hx, hy, map_add, map_add]
      ring
  have hc0 : LinearMap.lTensor B δ c = 0 := by
    rw [hstar, hcoc]
    ring
  have hex := Module.Flat.lTensor_exact B (LinearMap.exact_subtype_ker_map δ)
  obtain ⟨z, hz⟩ := (hex c).mp hc0
  have hspan : ∀ z : TensorProduct A B (LinearMap.ker δ),
      Algebra.TensorProduct.lmul' A (LinearMap.lTensor B (LinearMap.ker δ).subtype z) ∈
        Submodule.span B (LinearMap.ker δ : Set B) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul x m =>
      rw [LinearMap.lTensor_tmul, Submodule.subtype_apply,
        Algebra.TensorProduct.lmul'_apply_tmul]
      exact Ideal.mul_mem_left _ x (Ideal.subset_span m.2)
    | add x y hx hy =>
      rw [map_add, map_add]
      exact Submodule.add_mem _ hx hy
  have h1 : (1 : B) ∈ Submodule.span B (LinearMap.ker δ : Set B) := by
    rw [← hμ, ← hz]
    exact hspan z
  obtain ⟨S, hSsub, hS1⟩ := Submodule.mem_span_finite_of_mem_span h1
  have hSM : ∀ m ∈ S, (1 : B) ⊗ₜ[A] m = c * (m ⊗ₜ[A] (1 : B)) :=
    fun m hm => (hker m).mp (hSsub hm)

  have hsym : ∀ m m' : B, (1 : B) ⊗ₜ[A] m = c * (m ⊗ₜ[A] (1 : B)) →
      (1 : B) ⊗ₜ[A] m' = c * (m' ⊗ₜ[A] (1 : B)) → m ⊗ₜ[A] m' = m' ⊗ₜ[A] m := by
    intro m m' hm hm'
    have e1 : m ⊗ₜ[A] m' = (m ⊗ₜ[A] (1 : B)) * ((1 : B) ⊗ₜ[A] m') := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have e2 : m' ⊗ₜ[A] m = (m' ⊗ₜ[A] (1 : B)) * ((1 : B) ⊗ₜ[A] m) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [e1, e2, hm, hm']
    ring

  let φ : ∀ t : B, A →ₗ[A] (S → B ⧸ Submodule.span A ({t} : Set B)) := fun t =>
    LinearMap.pi (fun i : S => LinearMap.toSpanSingleton A _ (Submodule.Quotient.mk (i : B)))
  have hann : ∀ t ∈ S, t ∈ Ideal.map (algebraMap A B) (LinearMap.ker (φ t)) := by
    intro t ht
    have hvan' : ∀ m ∈ S,
        t ⊗ₜ[A] (Submodule.Quotient.mk m : B ⧸ Submodule.span A ({t} : Set B)) = 0 := by
      intro m hm
      have e : t ⊗ₜ[A] (Submodule.Quotient.mk m : B ⧸ Submodule.span A ({t} : Set B)) =
          LinearMap.lTensor B (Submodule.span A ({t} : Set B)).mkQ (t ⊗ₜ[A] m) := rfl
      rw [e, hsym t m (hSM t ht) (hSM m hm), LinearMap.lTensor_tmul, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_span_singleton_self t),
        TensorProduct.tmul_zero]
    have hvan : LinearMap.lTensor B (φ t) (t ⊗ₜ[A] (1 : A)) = 0 := by
      rw [LinearMap.lTensor_tmul]
      apply (TensorProduct.piRight A A B (fun _ : S => B ⧸ Submodule.span A ({t} : Set B))).injective
      rw [map_zero, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
      funext i
      show t ⊗ₜ[A] ((1 : A) • (Submodule.Quotient.mk (i : B) :
        B ⧸ Submodule.span A ({t} : Set B))) = 0
      rw [one_smul]
      exact hvan' i i.2
    have hex' := Module.Flat.lTensor_exact B (LinearMap.exact_subtype_ker_map (φ t))
    obtain ⟨w, hw⟩ := (hex' _).mp hvan
    have hrid : ∀ w : TensorProduct A B (LinearMap.ker (φ t)),
        TensorProduct.rid A B (LinearMap.lTensor B (LinearMap.ker (φ t)).subtype w) ∈
          Ideal.map (algebraMap A B) (LinearMap.ker (φ t)) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x a =>
        rw [LinearMap.lTensor_tmul, TensorProduct.rid_tmul, Submodule.subtype_apply,
          Algebra.smul_def]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ a.2)
      | add x y hx hy =>
        rw [map_add, map_add]
        exact Ideal.add_mem _ hx hy
    have := hrid w
    rwa [hw, TensorProduct.rid_tmul, one_smul] at this

  have hex5 : ∃ t ∈ S, ∃ s ∈ LinearMap.ker (φ t), s ∉ p := by
    by_contra hcon
    push_neg at hcon
    have hle : Submodule.span B (S : Set B) ≤ Ideal.map (algebraMap A B) p := by
      rw [Submodule.span_le]
      intro t ht
      exact Ideal.map_mono (fun s hs => hcon t ht s hs) (hann t ht)
    have htop : Ideal.map (algebraMap A B) p = ⊤ := (Ideal.eq_top_iff_one _).mpr (hle hS1)
    apply hp.ne_top
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B) p, htop, Ideal.comap_top]
  obtain ⟨t, ht, s, hsI, hsp⟩ := hex5
  have key : ∀ x ∈ Submodule.span B (S : Set B),
      algebraMap A B s * x ∈ Ideal.span ({t} : Set B) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem m hm =>
      have h1 : s • (Submodule.Quotient.mk m : B ⧸ Submodule.span A ({t} : Set B)) = 0 :=
        congrFun (LinearMap.mem_ker.mp hsI) ⟨m, hm⟩
      have h2 : s • m ∈ Submodule.span A ({t} : Set B) := by
        rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_smul]
        exact h1
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp h2
      rw [← Algebra.smul_def, ← ha, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self t)
    | zero => simp
    | add x y _ _ hx hy =>
      rw [mul_add]
      exact Ideal.add_mem _ hx hy
    | smul b x _ hx =>
      rw [smul_eq_mul, mul_left_comm]
      exact Ideal.mul_mem_left _ b hx
  have h1t := key 1 hS1
  rw [mul_one] at h1t
  obtain ⟨n, hn⟩ := Ideal.mem_span_singleton'.mp h1t
  exact ⟨s, hsp, t, n, hSM t ht, by rw [mul_comm]; exact hn⟩

theorem wc_et_gm_h1_zariski : ∀ (X : Scheme.{u}),
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
    Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm X) 1 ≃+
      Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1) :=
by
  intro X
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _

  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} _
  letI iZ1 : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  haveI : EssentiallySmall.{u+1} X.Etale := inferInstance
  haveI := Sheaf.isGrothendieckAbelian_of_essentiallySmall.{u+1} (Scheme.smallEtaleTopology X)
    AddCommGrpCat.{u+1}
  haveI : EssentiallySmall.{u+1} X.Opens := inferInstance
  haveI := Sheaf.isGrothendieckAbelian_of_essentiallySmall.{u+1} (Opens.grothendieckTopology X)
    AddCommGrpCat.{u+1}
  haveI : EssentiallySmall.{u} X.Opens := inferInstance
  haveI := Sheaf.isGrothendieckAbelian_of_essentiallySmall.{u} (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}

  have hP : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtGmPre X) := by
    have hrep : (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}).IsRepresentable :=
      (Functor.RepresentableBy.mk (F := Scheme.Γ.{u} ⋙ forget CommRingCat.{u})
        (Y := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ))))
        (fun {U} => (AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := U)).trans
          (Equiv.funUnique PUnit.{u+1} Γ(U, ⊤)))
        (by intro U U' f g; rfl)).isRepresentable
    have hΓt : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hUt : Presieve.IsSheaf Scheme.fpqcTopology.{u}
        (Scheme.Γ.{u} ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ forget CommGrpCat) := by
      intro Y S hS x hx
      have h := hΓt S hS
      let P := Scheme.Γ.{u}
      let U := Scheme.Γ.{u} ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ forget CommGrpCat
      let e : ∀ Z : Scheme.{u}, U.obj (Opposite.op Z) ≃ (P.obj (Opposite.op Z))ˣ :=
        fun _ => Equiv.refl _
      have hmap : ∀ {Z Z' : Scheme.{u}} (g : Z' ⟶ Z) (w : U.obj (Opposite.op Z)),
          ((e Z' (U.map g.op w) : (P.obj (Opposite.op Z'))ˣ) : P.obj (Opposite.op Z')) =
            (P.map g.op).hom ((e Z w : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z)) :=
        fun _ _ => rfl
      let a : Presieve.FamilyOfElements (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) S.arrows :=
        fun Z f hf => ((e Z (x f hf) : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z))
      let b : Presieve.FamilyOfElements (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) S.arrows :=
        fun Z f hf => (((e Z (x f hf))⁻¹ : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z))
      have ha : a.Compatible := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hc
        have := congrArg (fun w => ((e Z w : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z)))
          (hx g₁ g₂ h₁ h₂ hc)
        exact this
      have hb : b.Compatible := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hc
        have := congrArg (fun w => (((e Z w)⁻¹ : (P.obj (Opposite.op Z))ˣ) : P.obj (Opposite.op Z)))
          (hx g₁ g₂ h₁ h₂ hc)
        exact this
      have hga : ∀ ⦃Z⦄ (f : Z ⟶ Y) (hf : S.arrows f),
          (P.map f.op).hom (h.amalgamate a ha) = a f hf := fun Z f hf => h.valid_glue ha f hf
      have hgb : ∀ ⦃Z⦄ (f : Z ⟶ Y) (hf : S.arrows f),
          (P.map f.op).hom (h.amalgamate b hb) = b f hf := fun Z f hf => h.valid_glue hb f hf
      have hst : h.amalgamate a ha * h.amalgamate b hb = 1 := by
        apply h.isSeparatedFor.ext
        intro Z f hf
        change (P.map f.op).hom _ = (P.map f.op).hom _
        rw [map_mul, map_one, hga f hf, hgb f hf]
        exact Units.mul_inv _
      let w : (P.obj (Opposite.op Y))ˣ :=
        ⟨h.amalgamate a ha, h.amalgamate b hb, hst, by rw [mul_comm]; exact hst⟩
      refine ⟨(e Y).symm w, ?_, ?_⟩
      · intro Z f hf
        apply (e Z).injective
        apply Units.ext
        rw [hmap]
        exact hga f hf
      · intro w₂ hw₂
        apply (e Y).injective
        apply Units.ext
        apply h.isSeparatedFor.ext
        intro Z f hf
        change (P.map f.op).hom _ = (P.map f.op).hom _
        rw [← hmap, hw₂ f hf]
