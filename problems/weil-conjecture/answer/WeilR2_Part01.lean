abbrev wcpaLccAFc {Z₁ T : Scheme.{u}} (u₁ : Z₁ ⟶ T) {r : ℕ} (ε : Fin r → (T ⟶ Z₁))
    {K : Type u} [Field K] (s : Spec (.of K) ⟶ T) (E : Set ↥(Limits.pullback u₁ s)) : Prop :=
  ∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)


def wcpaLccSH {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {Z₁ : Scheme.{u}}
    (u₁ : Z₁ ⟶ Spec (.of ↥W)) {r : ℕ} (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ) : Prop :=
  wcpaDjSemistable u₁ ∧ wcpaDjSections u₁ r ε ∧ wcpaDjCocOK L ∧
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t ∧
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) ∧
    wcpaLccHAF u₁ ε ∧ 0 < m ∧ (∀ k : ℕ, 1 ≤ k → wcpaLccBC u₁ L (m * k)) ∧ wcpaLccGG u₁ L m


def wcpaLccGenBy {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (m d₀ : ℕ) : Prop :=
  ∀ k : ℕ, d₀ < k → ∀ x : (∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
    wcpaDjCompat L (q ⁻¹ᵁ ⊤) (m * k) x →
    ∃ (n : ℕ) (i : Fin n → ℕ) (y z : Fin n → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
      (∀ l, 1 ≤ i l ∧ i l ≤ d₀ ∧ wcpaDjCompat L (q ⁻¹ᵁ ⊤) (m * i l) (y l) ∧
        wcpaDjCompat L (q ⁻¹ᵁ ⊤) (m * (k - i l)) (z l)) ∧
      ∀ a, x a = ∑ l, y l a * z l a


def wcpaLccP1 {X Y : Scheme.{u}} (ψ : X ⟶ Y) : Prop :=
  ∀ V : Y.Opens, Function.Bijective (ψ.app V).hom


def wcpaLccP2 {Z₁ T Y : Scheme.{u}} (u₁ : Z₁ ⟶ T) (L : wcpaDjCoc Z₁) (m : ℕ) {K : Type u}
    [Field K] (s : Spec (.of K) ⟶ T) (ψ : Limits.pullback u₁ s ⟶ Y) : Prop :=
  ∃ (M : ℕ) (d : Fin M → ℕ)
    (g : Fin M → ∀ a : Fin L.m, Γ(Limits.pullback u₁ s,
      (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤))
    (D : Fin M → Y.Opens),
    (∀ J, 1 ≤ d J) ∧
    (∀ J, wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
      ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) (m * d J) (g J)) ∧
    (∀ J, IsAffineOpen (D J)) ∧ (⨆ J, D J) = ⊤ ∧
    ∀ J, ψ ⁻¹ᵁ D J = ⨆ a, (Limits.pullback u₁ s).basicOpen (g J a)


def wcpaLccUnitAt {X : Scheme.{u}} (L : wcpaDjCoc X) (O : X.Opens)
    (g : ∀ a : Fin L.m, Γ(X, L.V a ⊓ O)) (x : X) : Prop :=
  ∃ (a : Fin L.m) (hx : x ∈ L.V a ⊓ O), IsUnit ((X.presheaf.germ (L.V a ⊓ O) x hx).hom (g a))


def wcpaLccNonUnitAt {X : Scheme.{u}} (L : wcpaDjCoc X) (O : X.Opens)
    (g : ∀ a : Fin L.m, Γ(X, L.V a ⊓ O)) (x : X) : Prop :=
  ∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ O), ¬ IsUnit ((X.presheaf.germ (L.V a ⊓ O) x hx).hom (g a))


def wcpaLccSep {Z₁ T : Scheme.{u}} (u₁ : Z₁ ⟶ T) {r : ℕ} (ε : Fin r → (T ⟶ Z₁))
    (L : wcpaDjCoc Z₁) (m : ℕ) {K : Type u} [Field K] (s : Spec (.of K) ⟶ T) : Prop :=
  ∀ x : ↥(Limits.pullback u₁ s), IsClosed ({x} : Set ↥(Limits.pullback u₁ s)) →
    (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E → x ∉ E) →
    ∃ (k : ℕ) (g : ∀ a : Fin L.m, Γ(Limits.pullback u₁ s,
        (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤)),
      1 ≤ k ∧
      wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
        ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) (m * k) g ∧
      wcpaLccUnitAt (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
        ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) g x ∧
      ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E →
        ∀ e ∈ E, wcpaLccNonUnitAt (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
          ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) g e


def wcpaLccContr {Z₁ Z T : Scheme.{u}} (u₁ : Z₁ ⟶ T) (uu : Z ⟶ T) {r : ℕ}
    (ε : Fin r → (T ⟶ Z₁)) {K : Type u} [Field K] (s : Spec (.of K) ⟶ T)
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s) : Prop :=
  (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      ∀ x ∈ E, ∀ y ∈ E, φs x = φs y) ∧
  (∀ C : Set ↥(Limits.pullback u₁ s), C ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      ¬ wcpaLccAFc u₁ ε s C → ∃ x ∈ C, ∃ y ∈ C, φs x ≠ φs y) ∧
  (∀ x : ↥(Limits.pullback u₁ s), IsClosed ({x} : Set ↥(Limits.pullback u₁ s)) →
      (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E → x ∉ E) →
      ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E →
      ∀ e ∈ E, φs x ≠ φs e)


def wcpaLccOffExc {Z₁ Z T : Scheme.{u}} (u₁ : Z₁ ⟶ T) (uu : Z ⟶ T) {r : ℕ}
    (ε : Fin r → (T ⟶ Z₁)) {K : Type u} [Field K] (s : Spec (.of K) ⟶ T)
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s) : Prop :=
  Function.Surjective ⇑φs ∧
  (∀ x y : ↥(Limits.pullback u₁ s), φs x = φs y → x = y ∨
    ∃ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
      x ∈ E ∧ y ∈ E) ∧
  (∃ V : (Limits.pullback u₁ s).Opens,
    (∀ x : ↥(Limits.pullback u₁ s), x ∈ V ↔ ∀ E : Set ↥(Limits.pullback u₁ s),
      E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      x ∉ E) ∧
