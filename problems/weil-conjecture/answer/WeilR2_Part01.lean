            Scheme.etaleTopology
    haveI := hcont
    exact Functor.op_comp_isSheaf_of_isSheaf (Scheme.Etale.forget S ⋙ Over.forget S)
      (Scheme.smallEtaleTopology S) Scheme.etaleTopology _
      (Presheaf.IsSheaf.of_le (le_trans Scheme.etaleTopology_le_proetaleTopology
        Scheme.proetaleTopology_le_fpqcTopology) s4)

  haveI := isIso_toSheafify (Scheme.smallEtaleTopology (Spec (X.presheaf.stalk (genericPoint X))))
    (hGmSheaf (Spec (X.presheaf.stalk (genericPoint X))))
  let e : wcEtGmAt X (genericPoint X) ≅ (wcEtPush (X.fromSpecStalk (genericPoint X))).obj
      (wcEtGm (Spec (X.presheaf.stalk (genericPoint X)))) :=
    (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerLeft (@Functor.op X.Etale _ (Spec (X.presheaf.stalk (genericPoint X))).Etale _
          (wcEtBaseChange (X.fromSpecStalk (genericPoint X))))
        (asIso (toSheafify (Scheme.smallEtaleTopology (Spec (X.presheaf.stalk (genericPoint X))))
          (wcEtGmPre (Spec (X.presheaf.stalk (genericPoint X)))))))

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (X.presheaf.stalk (genericPoint X))))
    AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI := wc_et_enough_injectives (Spec (X.presheaf.stalk (genericPoint X)))
  let I := injectiveResolution (wcEtGm (Spec (X.presheaf.stalk (genericPoint X))))
  obtain ⟨L, ⟨adj⟩, hLfl, ⟨eL⟩⟩ := wc_et_push_left_adjoint (X.fromSpecStalk (genericPoint X))
  haveI := hLfl

  have hkill : ∀ n : ℕ, wcEtLocKill (X.fromSpecStalk (genericPoint X)) I.cocomplex n (fun _ => True) := by
