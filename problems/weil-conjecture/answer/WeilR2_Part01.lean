    Submodule A ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) :=
  Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e).subtype
    (Submodule.restrictScalars A J)

def wcpaDjGen {A : Type u} [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A))
    (e : ℕ) : Prop :=
  ∀ F ∈ J, F.IsHomogeneous (e + 1) → F ∈ Submodule.span A
    {H | ∃ (l : Fin (N + 1)) (G : MvPolynomial (Fin (N + 1)) A),
      G ∈ J ∧ G.IsHomogeneous e ∧ H = MvPolynomial.X l * G}

def wcpaDjFlrgGood (k : Type u) [Field k] (N : ℕ) {B Z : Scheme.{u}}
    (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B)
    (hZ : jZ ≫ wcProjKStr k N = g ≫ sB) (e₀ r : ℕ) (Φ : ℕ → ℕ) (D : B.Opens) : Prop :=
  IsAffineOpen D ∧
  ∃ (m : Fin r → (Fin (N + 1) →₀ ℕ)) (F : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, D)),
    Function.Injective m ∧ (∀ a, (m a).degree = e₀) ∧ (∀ a, (F a).IsHomogeneous e₀) ∧
    (∀ a a', (F a).coeff (m a') = if a = a' then 1 else 0) ∧
    (∀ (p : B) (hp : p ∈ D) (e : ℕ), e₀ ≤ e →
      wcpaDjHilbFn (B.residueField p) N (Ideal.span (Set.range fun a =>
        MvPolynomial.map (B.presheaf.germ D p hp ≫ B.residue p).hom (F a))) e = Φ e) ∧
    ∀ t : Γ(B, D),
      (∀ e, e₀ ≤ e → wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen t)) e) ∧
      (∀ a, MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le t)).op).hom (F a) ∈
        wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen t)) ∧
      (∀ G ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen t), G.IsHomogeneous e₀ →
        G ∈ Submodule.span Γ(B, B.basicOpen t) (Set.range fun a =>
          MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le t)).op).hom (F a)))
def wcpaDjSNCComps (Y : Scheme.{u}) (m : ℕ) (Dc : Fin m → Set Y) : Prop :=
  (∀ i, IsClosed (Dc i)) ∧
