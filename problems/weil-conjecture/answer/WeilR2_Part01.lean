        (AddCommGrpCat.mono_iff_injective (f.hom.app (Opposite.op U))).mp
          (Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
            (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op U)) f)
      exact hinj (ha.trans (map_zero _).symm)
    · intro U b hb
      have hE := hS.exact.map_of_mono_of_preservesKernel
        (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
          (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op U))
        hS.mono_f inferInstance
      obtain ⟨a, ha⟩ := (ShortComplex.ab_exact_iff _).mp hE b hb
      exact ⟨a, ha⟩




  have epiLS : ∀ {Bs Qs : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
