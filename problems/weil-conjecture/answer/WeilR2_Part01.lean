def wcLldfChart {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {X : Scheme.{u}}
    (uX : X ⟶ Spec (.of ↥W)) (σ σ₁ : Spec (.of ↥W) ⟶ X) (a : ↥W) (U : X.Opens)
    (m : U.toScheme ⟶ wcLldfA ↥W) (σU σ₁U : Spec (.of ↥W) ⟶ U.toScheme) (c : ↥W) : Prop :=
  IsAffineOpen U ∧ Etale m ∧ m ≫ wcLldfPiA ↥W = U.ι ≫ uX ∧ σU ≫ U.ι = σ ∧ σ₁U ≫ U.ι = σ₁ ∧
    σU ≫ m = wcLldfEv ↥W 0 ∧ σ₁U ≫ m = wcLldfEv ↥W (a * c) ∧
    RingHom.ker σU.appTop.hom = Ideal.span {m.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} ∧
    RingHom.ker σ₁U.appTop.hom = Ideal.span {m.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0 - MvPolynomial.C (a * c)))} ∧
    ∀ p : ↥U.toScheme, m p = m (σU (IsLocalRing.closedPoint ↥W)) →
      p = σU (IsLocalRing.closedPoint ↥W)

def wcLldfModelHyp {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (a a'' c : ↥W)
    {M' M₂ M₁ : Scheme.{u}} (r0 : M' ⟶ wcLldfA ↥W) (ρ : Spec (.of ↥W) ⟶ M')
    (r20 : M₂ ⟶ M') (r10 : M₁ ⟶ wcLldfA ↥W) : Prop :=
  wcCsdIsBlowup ((wcLldfEv ↥W 0).ker ⊔ wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) a) r0 ∧
    ρ ≫ r0 = wcLldfEv ↥W (a * c) ∧
    wcCsdIsBlowup (ρ.ker ⊔ wcNcPrincipal (.of ↥W) M' (r0 ≫ wcLldfPiA ↥W) a'') r20 ∧
    wcCsdIsBlowup ((wcLldfEv ↥W (a * c)).ker ⊔
      wcNcPrincipal (.of ↥W) (wcLldfA ↥W) (wcLldfPiA ↥W) (a * a'')) r10
abbrev wcLlsKPnfRel {K : Type u} [Field K] (O : ValuationSubring K) (ℓ : ℕ) (B N N' : K) : Prop :=
