        (wcpaDjCocPull φ L).V c)) (I ^ (n + 1)) →
      θ3 a b c (((X.presheaf.map (homOfLE (show (wcpaDjCocPull φ L).V a ⊓
          (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c ≤
          (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom
          ((wcpaDjCocPull φ L).g b c :
            Γ(X, (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c))) ^ d * x) =
        ((Y.presheaf.map (homOfLE (show (wcpaDjCocPull (p ≫ φ) L).V a ⊓
            (wcpaDjCocPull (p ≫ φ) L).V b ⊓ (wcpaDjCocPull (p ≫ φ) L).V c ⊓ q ⁻¹ᵁ ⊤ ≤
