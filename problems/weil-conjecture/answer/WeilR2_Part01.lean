def wcGCocycle {U : Scheme.{u}} {Γ : Type} [Group Γ] {ι : Type} {V : ι → Scheme.{u}}
    (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) : Prop :=
  ∀ (i j k : ι) (Z : Scheme.{u}) (a : Z ⟶ V i) (b : Z ⟶ V j) (c : Z ⟶ V k)
    (hab : a ≫ v i = b ≫ v j) (hbc : b ≫ v j = c ≫ v k) (hac : a ≫ v i = c ≫ v k) (z : Z),
    g i k (Limits.pullback.lift a c hac z) =
      g i j (Limits.pullback.lift a b hab z) * g j k (Limits.pullback.lift b c hbc z)

def wcGFam {U : Scheme.{u}} {Γ : Type} [Group Γ] {ι : Type} {V : ι → Scheme.{u}}
    (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) {T : Scheme.{u}}
    (t : T ⟶ U) (lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ) : Prop :=
  (∀ l, IsLocallyConstant (lam l)) ∧
  ∀ (l l' : ι) (Z : Scheme.{u}) (a : Z ⟶ T) (b : Z ⟶ V l) (b' : Z ⟶ V l')
    (h : a ≫ t = b ≫ v l) (h' : a ≫ t = b' ≫ v l') (h'' : b ≫ v l = b' ≫ v l') (z : Z),
    lam l' (Limits.pullback.lift a b' h' z) =
      lam l (Limits.pullback.lift a b h z) * g l l' (Limits.pullback.lift b b' h'' z)

def wcGRep {U : Scheme.{u}} {Γ : Type} [Group Γ] {ι : Type} {V : ι → Scheme.{u}}
    (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ) (O : U.Opens)
    {E : Scheme.{u}} (π : E ⟶ U) (Λ : ∀ l, ↥(Limits.pullback π (v l)) → Γ) : Prop :=
  Set.range π ⊆ (O : Set U) ∧ wcGFam v g π Λ ∧
  ∀ (T : Scheme.{u}) (t : T ⟶ U), Set.range t ⊆ (O : Set U) →
    ∀ lam : ∀ l, ↥(Limits.pullback t (v l)) → Γ, wcGFam v g t lam →
    ∃! φ : T ⟶ E, ∃ h : φ ≫ π = t, ∀ (l : ι) (w : ↥(Limits.pullback t (v l))),
      lam l w = Λ l (Limits.pullback.map t (v l) π (v l) φ (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, h]) (by simp) w)

def wcGTorDescCocyc (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (Γ : Type)
    [Group Γ] [Fintype Γ] (e : Γ → TensorProduct R R' R') : Prop :=
  (∀ c, IsIdempotentElem (e c)) ∧ (∀ c c', c ≠ c' → e c * e c' = 0) ∧ ∑ c, e c = 1 ∧
  ∀ c, (Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeRight (e c) :
      TensorProduct R R' (TensorProduct R R' R')) =
    ∑ a, Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeLeft (e a) *
      Algebra.TensorProduct.includeRight (e (a⁻¹ * c))

def wcGTorDescCond (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (Γ : Type)
    [Group Γ] [Fintype Γ] (e : Γ → TensorProduct R R' R') (x : Γ → R') : Prop :=
  ∀ h, (TensorProduct.tmul R (1 : R') (x h) : TensorProduct R R' R') =
