theorem wc_gen_fibre_affine_localization : ∀ (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (O : X.Opens) (W : U.left.Opens), IsAffineOpen O → IsAffineOpen W → (O : Set X).Nonempty → ∀ hW : W ≤ U.hom ⁻¹ᵁ O, (∀ f : Γ(U.left, W), wcGenSigma X U W f = 0 → ∃ a : Γ(X, O), a ≠ 0 ∧ wcPull X U O W hW a * f = 0) ∧ (∀ c : Γ(wcGenPt X U, (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W), ∃ (a : Γ(X, O)) (h : Γ(U.left, W)), a ≠ 0 ∧ wcGenSigma X U W (wcPull X U O W hW a) * c = wcGenSigma X U W h) :=
by
  intro X _ U O W hO hWa hne hW

  have s1 : ∀ (A B K : Type u) [CommRing A] [CommRing B] [CommRing K] [Algebra A B] [Algebra A K]
      (M : Submonoid A), IsLocalization M K →
      (∀ b : B, b ⊗ₜ[A] (1 : K) = 0 → ∃ a ∈ M, algebraMap A B a * b = 0) ∧
      (∀ t : TensorProduct A B K, ∃ a ∈ M, ∃ h : B,
        (algebraMap A B a ⊗ₜ[A] (1 : K)) * t = h ⊗ₜ[A] (1 : K)) := by
    intro A B K _ _ _ _ _ M hloc
    have hb : IsBaseChange K (TensorProduct.mk A K B 1) := TensorProduct.isBaseChange A B K
    have hL : IsLocalizedModule M (TensorProduct.mk A K B 1) :=
      (isLocalizedModule_iff_isBaseChange M K (TensorProduct.mk A K B 1)).mpr hb
    let e : TensorProduct A K B ≃ₗ[A] TensorProduct A B K := TensorProduct.comm A K B
    have hL' : IsLocalizedModule M
        ((e : TensorProduct A K B →ₗ[A] TensorProduct A B K) ∘ₗ TensorProduct.mk A K B 1) :=
      IsLocalizedModule.of_linearEquiv M _ e
    have hι : ∀ b : B, ((e : TensorProduct A K B →ₗ[A] TensorProduct A B K) ∘ₗ
        TensorProduct.mk A K B 1) b = b ⊗ₜ[A] (1 : K) := by
      intro b
      simp [e]
    refine ⟨fun b hb0 => ?_, fun t => ?_⟩
    · have h1 : ((e : TensorProduct A K B →ₗ[A] TensorProduct A B K) ∘ₗ
          TensorProduct.mk A K B 1) b =
          ((e : TensorProduct A K B →ₗ[A] TensorProduct A B K) ∘ₗ TensorProduct.mk A K B 1) 0 := by
        rw [hι, hb0, map_zero]
      obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := M) h1
      refine ⟨c, c.2, ?_⟩
      rw [← Algebra.smul_def]
      rw [smul_zero] at hc
      exact hc
    · obtain ⟨⟨h, c⟩, hc⟩ := IsLocalizedModule.surj M
        ((e : TensorProduct A K B →ₗ[A] TensorProduct A B K) ∘ₗ TensorProduct.mk A K B 1) t
      refine ⟨c, c.2, h, ?_⟩
      rw [hι] at hc
      rw [← hc]
      simp only [Submonoid.smul_def]
      rw [Algebra.smul_def, Algebra.TensorProduct.algebraMap_apply]

  have s2 : ∀ (X Y : Scheme.{u}) (f : Y ⟶ X) (O : X.Opens) (W : Y.Opens), IsAffineOpen O →
      ∀ (hW : IsAffineOpen W) (hWO : W ≤ f ⁻¹ᵁ O) (x : X) (hx : x ∈ O),
      letI : Algebra Γ(X, O) Γ(Y, W) := (f.appLE O W hWO).hom.toAlgebra
      letI : Algebra Γ(X, O) (X.presheaf.stalk x) := (X.presheaf.germ O x hx).hom.toAlgebra
      IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
          (R := Γ(X, O)) (A := Γ(Y, W)) (B := X.presheaf.stalk x))) ≫ hW.isoSpec.inv)
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := Γ(X, O))
          (A := Γ(Y, W)) (B := X.presheaf.stalk x)).toRingHom))
        (W.ι ≫ f) (X.fromSpecStalk x) := by
    intro X Y f O W hO hW hWO x hx
    letI : Algebra Γ(X, O) Γ(Y, W) := (f.appLE O W hWO).hom.toAlgebra
    letI : Algebra Γ(X, O) (X.presheaf.stalk x) := (X.presheaf.germ O x hx).hom.toAlgebra
    let φ := f.appLE O W hWO
    let γ := X.presheaf.germ O x hx
    have P1 : IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
          (R := Γ(X, O)) (A := Γ(Y, W)) (B := X.presheaf.stalk x))))
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := Γ(X, O))
          (A := Γ(Y, W)) (B := X.presheaf.stalk x)).toRingHom))
        (Spec.map φ) (Spec.map γ) :=
      isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct Γ(X, O) Γ(Y, W) (X.presheaf.stalk x))
    haveI : IsOpenImmersion hO.fromSpec := hO.isOpenImmersion_fromSpec
    have e1 : Spec.map φ ≫ hO.fromSpec = hW.fromSpec ≫ f :=
      IsAffineOpen.SpecMap_appLE_fromSpec f hO hW hWO
    have e2 : Spec.map γ ≫ hO.fromSpec = X.fromSpecStalk x :=
      (IsAffineOpen.fromSpecStalk.eq_1 hO hx).symm.trans (hO.fromSpecStalk_eq_fromSpecStalk hx)
    have P2 : IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
          (R := Γ(X, O)) (A := Γ(Y, W)) (B := X.presheaf.stalk x))))
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := Γ(X, O))
          (A := Γ(Y, W)) (B := X.presheaf.stalk x)).toRingHom))
        (hW.fromSpec ≫ f) (X.fromSpecStalk x) := by
      refine IsPullback.mk' ?_ ?_ ?_
      · rw [← e1, ← e2, ← Category.assoc, P1.w, Category.assoc]
      · intro T a b h1 h2
        exact P1.hom_ext h1 h2
      · intro T a b hab
        have hab' : a ≫ Spec.map φ = b ≫ Spec.map γ := by
          rw [← cancel_mono hO.fromSpec, Category.assoc, Category.assoc, e1, e2]
          rw [← Category.assoc] at hab
          exact hab
        exact ⟨P1.lift a b hab', P1.lift_fst _ _ _, P1.lift_snd _ _ _⟩
    refine IsPullback.of_iso P2 (Iso.refl _) hW.isoSpec.symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp
    · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc,
        IsAffineOpen.isoSpec_inv_ι]
    · simp

  have s3 : ∀ (X Y Z : Scheme.{u}) (f : Y ⟶ X) (g : Z ⟶ X) (W : Y.Opens) (hW : IsAffineOpen W)
      (T : CommRingCat.{u}) (inl : Γ(Y, W) ⟶ T) (q : Spec T ⟶ Z),
      IsPullback (Spec.map inl ≫ hW.isoSpec.inv) q (W.ι ≫ f) g →
      ∃ e : Γ(↑((Limits.pullback.fst f g) ⁻¹ᵁ W), ⊤) ≃+* T, ∀ y : Γ(↑W, ⊤),
        e ((Limits.pullback.fst f g ∣_ W).appTop.hom y) = inl.hom (W.topIso.hom.hom y) := by
    intro X Y Z f g W hW T inl q hP
    have P3 := (isPullback_morphismRestrict (Limits.pullback.fst f g) W).paste_vert
      (IsPullback.of_hasPullback f g)
    let E := IsPullback.isoIsPullback _ _ hP P3
    have hE : E.hom ≫ (Limits.pullback.fst f g ∣_ W) = Spec.map inl ≫ hW.isoSpec.inv :=
      IsPullback.isoIsPullback_hom_fst _ _ hP P3
    have key : (Limits.pullback.fst f g ∣_ W).appTop ≫ E.hom.appTop ≫ (Scheme.ΓSpecIso T).hom =
        W.topIso.hom ≫ inl := by
      rw [← Category.assoc, ← Scheme.Hom.comp_appTop, hE, Scheme.Hom.comp_appTop, Category.assoc,
        Scheme.ΓSpecIso_naturality, IsAffineOpen.isoSpec_inv_appTop, Category.assoc,
        Iso.inv_hom_id_assoc]
    refine ⟨(Scheme.Γ.mapIso E.op ≪≫ Scheme.ΓSpecIso T).commRingCatIsoToRingEquiv, fun y => ?_⟩
    exact congrArg (fun φ => φ.hom y) key

  have s4 : ∀ (P Y : Scheme.{u}) (f : P ⟶ Y) (W : Y.Opens) (s : Γ(Y, W)),
      (f ⁻¹ᵁ W).topIso.inv.hom ((f.app W).hom s) = (f ∣_ W).appTop.hom (W.topIso.inv.hom s) := by
    intro P Y f W s
    have key : f.app W ≫ (f ⁻¹ᵁ W).topIso.inv = W.topIso.inv ≫ (f ∣_ W).appTop := by
      rw [morphismRestrict_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.topIso_inv]
      erw [Scheme.Hom.naturality_assoc]
      congr 1
      erw [← Functor.map_comp]
      rfl
    exact congrArg (fun φ => φ.hom s) key

  have hη : genericPoint X ∈ O :=
    ((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr (by simpa using hne)
  haveI : Nonempty O := ⟨⟨_, hη⟩⟩
  haveI : IsDomain Γ(X, O) := @IsIntegral.component_integral X _ O ⟨⟨_, hη⟩⟩
  letI : Algebra Γ(X, O) Γ(U.left, W) := (U.hom.appLE O W hW).hom.toAlgebra
  letI : Algebra Γ(X, O) (X.presheaf.stalk (genericPoint X)) :=
    (X.presheaf.germ O (genericPoint X) hη).hom.toAlgebra
  have hP := s2 X U.left U.hom O W hO hWa hW (genericPoint X) hη
  obtain ⟨e, he⟩ := s3 X U.left (Spec (X.presheaf.stalk (genericPoint X))) U.hom
    (X.fromSpecStalk (genericPoint X)) W hWa
    (CommRingCat.of (TensorProduct Γ(X, O) Γ(U.left, W) (X.presheaf.stalk (genericPoint X))))
    (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := Γ(X, O)) (A := Γ(U.left, W)) (B := X.presheaf.stalk (genericPoint X))))
    (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := Γ(X, O))
      (A := Γ(U.left, W)) (B := X.presheaf.stalk (genericPoint X))).toRingHom)) hP
  let Ψ := ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W).topIso.commRingCatIsoToRingEquiv.symm.trans e
  have KEY : ∀ s : Γ(U.left, W), Ψ (wcGenSigma X U W s) =
      s ⊗ₜ[Γ(X, O)] (1 : X.presheaf.stalk (genericPoint X)) := by
    intro s
    change e (((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W).topIso.inv.hom
      (((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W).hom s)) = _
    rw [s4, he, Iso.inv_hom_id_apply]
    rfl
  have hloc : IsLocalization (nonZeroDivisors Γ(X, O)) (X.presheaf.stalk (genericPoint X)) :=
    functionField_isFractionRing_of_isAffineOpen X O hO
  obtain ⟨H1, H2⟩ := s1 Γ(X, O) Γ(U.left, W) (X.presheaf.stalk (genericPoint X))
    (nonZeroDivisors Γ(X, O)) hloc
  refine ⟨fun f hf => ?_, fun c => ?_⟩
  · obtain ⟨a, ha, hfa⟩ := H1 f (by rw [← KEY, hf, map_zero])
    exact ⟨a, nonZeroDivisors.ne_zero ha, hfa⟩
  · obtain ⟨a, ha, h, hh⟩ := H2 (Ψ c)
    refine ⟨a, h, nonZeroDivisors.ne_zero ha, Ψ.injective ?_⟩
    rw [map_mul, KEY, KEY]
    exact hh

theorem wc_ord_rep_exists : ∀ (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (b : (Γ(wcGenPt X U, ⊤))ˣ) (x : U.left), ∃ n : ℤ, wcOrdRep X U (b : Γ(wcGenPt X U, ⊤)) x n :=
by
  intro X _ U b x

  have hcong : ∀ {A B : Scheme.{u}} (f g : A ⟶ B) (O' : B.Opens) (V : A.Opens)
      (e : V ≤ f ⁻¹ᵁ O') (e' : V ≤ g ⁻¹ᵁ O'), f = g → f.appLE O' V e = g.appLE O' V e' := by
    intro A B f g O' V e e' hfg
    subst hfg
    rfl

  have s3 : ∀ (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O) (a : Γ(X, O)), a ≠ 0 →
      IsUnit (wcGenSigma X U W (wcPull X U O W hW a)) := by
    intro O W hW a ha
    have hO : genericPoint X ∈ O := by
      by_contra hη
      have hOe : O = ⊥ := by
        ext y
        simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
        intro hy
        exact hη (((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr ⟨y, trivial, hy⟩)
      have hs : Subsingleton Γ(X, O) :=
        CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty hOe)
      exact ha (@Subsingleton.elim _ hs _ _)
    have hu : IsUnit ((X.presheaf.germ O (genericPoint X) hO).hom a) := by
      rw [isUnit_iff_ne_zero]
      intro h0
      apply ha
      apply germ_injective_of_isIntegral X (genericPoint X) hO
      rw [h0, map_zero]
    have e1 : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X)) ≫
          X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O := by
      intro p hp
      have hp' : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) ≫ U.hom) p ∈ O := by
        rw [Scheme.Hom.comp_apply]
        exact hW hp
      rw [Limits.pullback.condition] at hp'
      exact hp'
    have key : U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W =
        (X.fromSpecStalk (genericPoint X)).app O ≫
          (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X))).appLE
            ((X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O)
            ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) e1 := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, ← Scheme.Hom.comp_appLE]
      exact hcong _ _ _ _ _ _ Limits.pullback.condition
    have e2 : wcGenSigma X U W (wcPull X U O W hW a) =
        (U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W).hom a :=
      rfl
    rw [e2, key, Scheme.fromSpecStalk_app hO]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    exact ((hu.map _).map _).map _

  have s4 : ∀ (W : U.left.Opens) (h : Γ(U.left, W)), IsUnit (wcGenSigma X U W h) →
      ∀ (y : U.left) (hy : y ∈ W), U.left.presheaf.germ W y hy h ≠ 0 := by
    intro W h hu y hy h0
    have h0' : (U.left.presheaf.germ W y hy) h = (U.left.presheaf.germ W y hy) 0 := by
      rw [h0, map_zero]
    obtain ⟨N, hyN, iU, iV, hN⟩ := TopCat.Presheaf.germ_eq _ y hy hy h 0 h0'
    rw [map_zero] at hN
    haveI : Etale U.hom := U.prop
    have hopen : IsOpen (U.hom '' (N : Set U.left)) := U.hom.isOpenMap _ N.isOpen
    have hη : genericPoint X ∈ U.hom '' (N : Set U.left) :=
      ((genericPoint_spec X).mem_open_set_iff hopen).mpr ⟨U.hom y, trivial, y, hyN, rfl⟩
    obtain ⟨z, hzN, hz⟩ := hη
    obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := U.hom)
      (g := X.fromSpecStalk (genericPoint X)) z (IsLocalRing.closedPoint _)
      (by rw [hz, Scheme.fromSpecStalk_closedPoint])
    have hpN : p ∈ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ N := by
      show (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) p ∈ N
      rw [hp1]
      exact hzN
    haveI : Nonempty ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ N) :=
      ⟨⟨p, hpN⟩⟩
    haveI := Scheme.component_nontrivial (wcGenPt X U)
      ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ N)
    have nat := congrArg (fun φ => φ.hom h) (Scheme.Hom.naturality
      (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) iU.op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at nat
    have e2 : ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app N).hom
        ((U.left.presheaf.map iU.op).hom h) =
        ((wcGenPt X U).presheaf.map ((TopologicalSpace.Opens.map
          (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).base).map iU).op).hom
          (wcGenSigma X U W h) := nat
    rw [hN, map_zero] at e2
    have h0u : IsUnit (0 : Γ(wcGenPt X U,
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ N)) := by
      rw [e2]
      exact hu.map _
    exact not_isUnit_zero h0u

  obtain ⟨O, hO, hxO, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := U.hom x)
    (U := ⊤) trivial
  obtain ⟨W, hWa, hxW, hsub⟩ := exists_isAffineOpen_mem_and_subset (x := x)
    (U := U.hom ⁻¹ᵁ O) hxO
  have hW : W ≤ U.hom ⁻¹ᵁ O := hsub
  obtain ⟨a, h, ha, heq⟩ := (wc_gen_fibre_affine_localization X U O W hO hWa ⟨U.hom x, hxO⟩ hW).2
    (wcGenRestr X U W (b : Γ(wcGenPt X U, ⊤)))
  have hg := s3 O W hW a ha
  have hc : IsUnit (wcGenRestr X U W (b : Γ(wcGenPt X U, ⊤))) := b.isUnit.map _
  have hh : IsUnit (wcGenSigma X U W h) := heq ▸ hg.mul hc
  exact ⟨_, W, hxW, wcPull X U O W hW a, h, hg, heq, s4 W _ hg x hxW, s4 W h hh x hxW, rfl⟩

theorem wc_etale_stalk_dvr : ∀ {V U : Scheme.{u}} (g : V ⟶ U) [Etale g] [IsLocallyNoetherian U] (v : V), wcIsDVR (U.presheaf.stalk (g v)) → wcIsDVR (V.presheaf.stalk v) ∧ ∀ ϖ, Irreducible ϖ → Irreducible ((g.stalkMap v).hom ϖ) :=
by
  intro V U g _ _ v hA
  haveI : IsLocallyNoetherian V := LocallyOfFiniteType.isLocallyNoetherian g
  obtain ⟨hAdom, hAdvr⟩ := hA

  have hinj : Function.Injective (g.stalkMap v).hom := by
    letI := (g.stalkMap v).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (U.presheaf.stalk (g v)) (V.presheaf.stalk v)) :=
      inferInstanceAs (IsLocalHom (g.stalkMap v).hom)
    haveI : Module.Flat (U.presheaf.stalk (g v)) (V.presheaf.stalk v) := Flat.stalkMap g v
    haveI : Module.FaithfullyFlat (U.presheaf.stalk (g v)) (V.presheaf.stalk v) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    exact FaithfulSMul.algebraMap_injective (U.presheaf.stalk (g v)) (V.presheaf.stalk v)
  have hmap : Ideal.map (g.stalkMap v).hom (IsLocalRing.maximalIdeal (U.presheaf.stalk (g v))) =
      IsLocalRing.maximalIdeal (V.presheaf.stalk v) := by
    letI := (g.stalkMap v).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (U.presheaf.stalk (g v)) (V.presheaf.stalk v)) :=
      inferInstanceAs (IsLocalHom (g.stalkMap v).hom)
    haveI : Algebra.FormallyUnramified (U.presheaf.stalk (g v)) (V.presheaf.stalk v) :=
      FormallyUnramified.stalkMap g v
    haveI : Algebra.EssFiniteType (U.presheaf.stalk (g v)) (V.presheaf.stalk v) :=
      LocallyOfFiniteType.stalkMap g v
    exact Algebra.FormallyUnramified.map_maximalIdeal

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (t : B),
      IsLocalRing.maximalIdeal B = Ideal.span {t} →
      ∀ b : B, b ≠ 0 → ∃ (n : ℕ) (w : B), IsUnit w ∧ b = w * t ^ n := by
    intro B _ _ _ t hm b hb
    classical
    have hex : ∃ k, b ∉ (IsLocalRing.maximalIdeal B) ^ k := by
      by_contra hcon
      push_neg at hcon
      have h1 : b ∈ ⨅ i, (IsLocalRing.maximalIdeal B) ^ i := Submodule.mem_iInf _ |>.mpr hcon
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal B)
        (IsLocalRing.maximalIdeal.isMaximal B).ne_top] at h1
      exact hb ((Ideal.mem_bot).mp h1)
    have hk := Nat.find_spec hex
    have hk0 : Nat.find hex ≠ 0 := by
      intro h0
      rw [h0, pow_zero, Ideal.one_eq_top] at hk
      exact hk Submodule.mem_top
    obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hk0
    have hbn : b ∈ (IsLocalRing.maximalIdeal B) ^ n :=
      not_not.mp (Nat.find_min hex (show n < Nat.find hex by omega))
    rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hbn
    obtain ⟨c, hc⟩ := hbn
    refine ⟨n, c, ?_, hc.symm⟩
    by_contra hcu
    have hcm : c ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal c).mpr hcu
    rw [hm, Ideal.mem_span_singleton'] at hcm
    obtain ⟨d, hd⟩ := hcm
    apply hk
    rw [hn, hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    exact ⟨d, by rw [← hc, ← hd, pow_succ]; ring⟩

  have s2 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (t : B),
      IsLocalRing.maximalIdeal B = Ideal.span {t} → (∀ n : ℕ, t ^ n ≠ 0) →
      (∀ b : B, b ≠ 0 → ∃ (n : ℕ) (w : B), IsUnit w ∧ b = w * t ^ n) →
      wcIsDVR B ∧ Irreducible t := by
    intro B _ _ t hm hpow hfac
    haveI : NoZeroDivisors B := ⟨fun {x y} hxy => by
      by_contra hne
      push_neg at hne
      obtain ⟨a, w₁, hw₁, hx⟩ := hfac x hne.1
      obtain ⟨b, w₂, hw₂, hy⟩ := hfac y hne.2
      have h : (w₁ * w₂) * t ^ (a + b) = 0 := by
        rw [← hxy, hx, hy, pow_add]; ring
      exact hpow (a + b) ((hw₁.mul hw₂).mul_right_eq_zero.mp h)⟩
    haveI : IsDomain B := NoZeroDivisors.to_isDomain B
    have htm : t ∈ IsLocalRing.maximalIdeal B := by
      rw [hm]; exact Ideal.mem_span_singleton_self t
    have ht0 : t ≠ 0 := by simpa using hpow 1
    have hnu : ¬ IsUnit t := (IsLocalRing.mem_maximalIdeal t).mp htm
    have hirr : Irreducible t := by
      refine irreducible_iff.mpr ⟨hnu, fun x y hxy => ?_⟩
      by_contra hcon
      push_neg at hcon
      have hx : x ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal x).mpr hcon.1
      have hy : y ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal y).mpr hcon.2
      rw [hm, Ideal.mem_span_singleton'] at hx hy
      obtain ⟨x', hx'⟩ := hx
      obtain ⟨y', hy'⟩ := hy
      have h1 : t * 1 = t * (x' * y' * t) := by
        rw [mul_one]
        nth_rewrite 1 [hxy]
        rw [← hx', ← hy']
        ring
      have h2 := mul_left_cancel₀ ht0 h1
      have h3 : t * (x' * y') = 1 := by linear_combination -h2
      exact hnu ⟨⟨t, x' * y', h3, by rw [mul_comm]; exact h3⟩, rfl⟩
    refine ⟨⟨inferInstance, IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
      ⟨t, hirr, fun {x} hx => ?_⟩⟩, hirr⟩
    obtain ⟨n, w, hw, hxe⟩ := hfac x hx
    exact ⟨n, hw.unit, by rw [IsUnit.unit_spec, hxe, mul_comm]⟩

  haveI := hAdom
  haveI := hAdvr
  have K : ∀ ϖ : U.presheaf.stalk (g v), Irreducible ϖ →
      wcIsDVR (V.presheaf.stalk v) ∧ Irreducible ((g.stalkMap v).hom ϖ) := by
    intro ϖ hϖ
    have hmA := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hmB : IsLocalRing.maximalIdeal (V.presheaf.stalk v) =
        Ideal.span {(g.stalkMap v).hom ϖ} := by
      rw [← hmap, hmA, Ideal.map_span, Set.image_singleton]
    have hpow : ∀ n : ℕ, ((g.stalkMap v).hom ϖ) ^ n ≠ 0 := by
      intro n h
      rw [← map_pow] at h
      apply pow_ne_zero n hϖ.ne_zero
      apply hinj
      rw [h, map_zero]
    exact s2 _ _ hmB hpow (s1 _ _ hmB)
  obtain ⟨ϖ₀, hϖ₀⟩ := IsDiscreteValuationRing.exists_irreducible (U.presheaf.stalk (g v))
  exact ⟨(K ϖ₀ hϖ₀).1, fun ϖ hϖ => (K ϖ hϖ).2⟩

theorem wc_rational_point_stalk_dvr' : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (U : X.Etale) (s : wcEtPts Ω X fX U), wcIsDVR (U.left.presheaf.stalk (s.1 (IsLocalRing.closedPoint Ω))) ∧ IsClosed ({s.1 (IsLocalRing.closedPoint Ω)} : Set U.left) ∧ U.hom (s.1 (IsLocalRing.closedPoint Ω)) ≠ genericPoint X :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U s
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX

  have hrange : ∀ {Y : Scheme.{u}} (t : Spec (.of Ω) ⟶ Y), IsClosedImmersion t →
      IsClosed ({t (IsLocalRing.closedPoint Ω)} : Set Y) := by
    intro Y t ht
    have h1 : Set.range (⇑t) = {t (IsLocalRing.closedPoint Ω)} := by
      ext x
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint Ω)]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← h1]
    exact t.isClosedEmbedding.isClosed_range
  have hy : IsClosed ({s.1 (IsLocalRing.closedPoint Ω)} : Set U.left) := by
    haveI := isClosedImmersion_of_comp_eq_id (U.hom ≫ fX) s.1 s.2
    exact hrange s.1 inferInstance
  have hz : IsClosed ({U.hom (s.1 (IsLocalRing.closedPoint Ω))} : Set X) := by
    haveI := isClosedImmersion_of_comp_eq_id fX (s.1 ≫ U.hom) (by rw [Category.assoc]; exact s.2)
    have := hrange (s.1 ≫ U.hom) inferInstance
    have e : (s.1 ≫ U.hom) (IsLocalRing.closedPoint Ω) = U.hom (s.1 (IsLocalRing.closedPoint Ω)) :=
      Scheme.Hom.comp_apply _ _ _
    rw [e] at this
    exact this

  have hne : U.hom (s.1 (IsLocalRing.closedPoint Ω)) ≠ genericPoint X := by
    intro heq
    rw [heq] at hz
    have huniv : (Set.univ : Set X) = {genericPoint X} := by
      rw [← hz.closure_eq]
      exact (isGenericPoint_def.mp (genericPoint_spec X)).symm
    have hS : ∀ S : TopologicalSpace.IrreducibleCloseds X, (S : Set X) = {genericPoint X} := by
      intro S
      apply Set.Subset.antisymm
      · rw [← huniv]; exact Set.subset_univ _
      · obtain ⟨a, ha⟩ := S.isIrreducible.nonempty
        have hmem : a ∈ (Set.univ : Set X) := Set.mem_univ a
        rw [huniv] at hmem
        rw [Set.singleton_subset_iff, ← Set.mem_singleton_iff.mp hmem]
        exact ha
    haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds X) := ⟨fun S T => by
      apply TopologicalSpace.IrreducibleCloseds.ext
      rw [hS S, hS T]⟩
    have h0 : topologicalKrullDim X ≤ 0 := by
      rw [topologicalKrullDim]
      exact Order.krullDim_nonpos_of_subsingleton
    rw [hdim] at h0
    norm_num at h0

  have hdvrX : ∀ z : X, z ≠ genericPoint X → wcIsDVR (X.presheaf.stalk z) := by
    intro z hz0
    have hnf : ¬ IsField (X.presheaf.stalk z) := by
      intro hF
      have hm : IsLocalRing.maximalIdeal (X.presheaf.stalk z) = ⊥ :=
        (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
      have hsub : ∀ a b : PrimeSpectrum (X.presheaf.stalk z), a = b := by
        intro a b
        have ha : a.asIdeal = ⊥ :=
          le_bot_iff.mp (hm ▸ IsLocalRing.le_maximalIdeal a.isPrime.ne_top)
        have hb : b.asIdeal = ⊥ :=
          le_bot_iff.mp (hm ▸ IsLocalRing.le_maximalIdeal b.isPrime.ne_top)
        exact PrimeSpectrum.ext (ha.trans hb.symm)
      have hη : genericPoint X ∈ Set.range (X.fromSpecStalk z) := by
        rw [Scheme.range_fromSpecStalk]
        exact (genericPoint_spec X).specializes (Set.mem_univ z)
      obtain ⟨a, ha⟩ := hη
      have hc := Scheme.fromSpecStalk_closedPoint (X := X) (x := z)
      rw [hsub a (IsLocalRing.closedPoint _)] at ha
      exact hz0 (hc.symm.trans ha)
    have hdimR : ringKrullDim (X.presheaf.stalk z) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
      rw [← hdim]
      calc ringKrullDim (X.presheaf.stalk z)
          = topologicalKrullDim (PrimeSpectrum (X.presheaf.stalk z)) :=
            (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm
        _ = topologicalKrullDim (Set.range (X.fromSpecStalk z)) :=
            IsHomeomorph.topologicalKrullDim_eq _
              (Scheme.Hom.isEmbedding (X.fromSpecStalk z)).toHomeomorph.isHomeomorph
        _ ≤ topologicalKrullDim X := topologicalKrullDim_subspace_le X _
    have hex : ∃! P : Ideal (X.presheaf.stalk z), P ≠ ⊥ ∧ P.IsPrime := by
      refine ⟨IsLocalRing.maximalIdeal _, ⟨?_, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩, ?_⟩
      · intro h
        exact hnf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
      · rintro Q ⟨hQ0, hQ⟩
        haveI : Ring.KrullDimLE 1 (X.presheaf.stalk z) := Ring.krullDimLE_iff.mpr hdimR
        rcases Ring.krullDimLE_one_iff.mp this Q hQ with h | h
        · rw [IsDomain.minimalPrimes_eq_singleton_bot] at h
          exact absurd h hQ0
        · exact IsLocalRing.eq_maximalIdeal h
    have h4 : IsIntegrallyClosed (X.presheaf.stalk z) ∧
        ∃! P : Ideal (X.presheaf.stalk z), P ≠ ⊥ ∧ P.IsPrime := ⟨hnorm z, hex⟩
    have hdvr : IsDiscreteValuationRing (X.presheaf.stalk z) :=
      ((IsDiscreteValuationRing.TFAE (X.presheaf.stalk z) hnf).out 1 4).mpr h4
    exact (⟨inferInstance, hdvr⟩ : ∃ _ : IsDomain (X.presheaf.stalk z),
      IsDiscreteValuationRing (X.presheaf.stalk z))

  have hRz := hdvrX _ hne
  haveI : IsLocallyNoetherian ((Functor.fromPUnit X).obj U.right) :=
    inferInstanceAs (IsLocallyNoetherian X)
  haveI : Etale U.hom := U.prop
  exact ⟨(wc_etale_stalk_dvr U.hom (s.1 (IsLocalRing.closedPoint Ω)) hRz).1, hy, hne⟩

theorem wc_ord_rep_unique : ∀ (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (b : Γ(wcGenPt X U, ⊤)) (x : U.left) (n n' : ℤ), wcIsDVR (U.left.presheaf.stalk x) → wcOrdRep X U b x n → wcOrdRep X U b x n' → n = n' :=
by
  intro X _ U b x n n' hD hr hr'
  obtain ⟨hdom, hdvr⟩ := hD

  have stepA : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R),
      Irreducible ϖ → ∀ (w : Rˣ) (k : ℕ), wcLocVal R ((w : R) * ϖ ^ k) = k := by
    intro R _ _ _ ϖ hϖ w k
    unfold wcLocVal
    split_ifs with h
    · classical
      obtain ⟨v, ϖ', hϖ', hv⟩ := Nat.find_spec h
      have hk := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' w v k _ hv
      exact hk.symm
    · exact absurd ⟨k, w, ϖ, hϖ, rfl⟩ h

  have locMul : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (r s : R),
      r ≠ 0 → s ≠ 0 → wcLocVal R (r * s) = wcLocVal R r + wcLocVal R s := by
    intro R _ _ _ r s hr hs
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨a, u₁, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hϖ
    obtain ⟨c, u₂, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
    have e : (u₁ : R) * ϖ ^ a * ((u₂ : R) * ϖ ^ c) = ((u₁ * u₂ : Rˣ) : R) * ϖ ^ (a + c) := by
      rw [Units.val_mul, pow_add]; ring
    rw [e, stepA R ϖ hϖ, stepA R ϖ hϖ, stepA R ϖ hϖ]

  have compA : ∀ (V W : U.left.Opens) (hle : W ≤ V) (f : Γ(U.left, V)),
      wcGenSigma X U W (U.left.presheaf.map (homOfLE hle).op f) =
      (wcGenPt X U).presheaf.map (homOfLE (fun _ hy => hle hy :
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V)).op
        (wcGenSigma X U V f) := by
    intro V W hle f
    have := congrArg (fun φ => φ.hom f) (Scheme.Hom.naturality
      (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) (homOfLE hle).op)
    exact this
  have compB : ∀ (V W : U.left.Opens) (hle : W ≤ V) (b : Γ(wcGenPt X U, ⊤)),
      wcGenRestr X U W b =
      (wcGenPt X U).presheaf.map (homOfLE (fun _ hy => hle hy :
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V)).op
        (wcGenRestr X U V b) := by
    intro V W hle b
    have hle' : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V := fun _ hy => hle hy
    have htop : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V ≤ ⊤ := le_top
    have := congrArg (fun φ => φ.hom b) ((wcGenPt X U).presheaf.map_comp
      (homOfLE htop).op (homOfLE hle').op)
    exact this

  haveI : Etale U.hom := U.prop
  have kernel : ∀ (V : X.Opens), IsAffineOpen V → genericPoint X ∈ V →
      ∀ (W₀ : U.left.Opens) (hW₀ : IsAffineOpen W₀), W₀ ≤ U.hom ⁻¹ᵁ V →
      ∀ s : Γ(U.left, W₀), wcGenSigma X U W₀ s = 0 → s = 0 := by
    intro V hV hη W₀ hW₀ e s hs
    have hs' : ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W₀) s = 0 := hs
    let φ := U.hom.appLE V W₀ e
    let g := X.presheaf.germ V (genericPoint X) hη
    letI : Algebra Γ(X, V) Γ(U.left, W₀) := φ.hom.toAlgebra
    letI : Algebra Γ(X, V) (X.presheaf.stalk (genericPoint X)) := g.hom.toAlgebra
    haveI : Module.Flat Γ(X, V) Γ(U.left, W₀) := Flat.flat_appLE U.hom hV hW₀ e
    have hginj : Function.Injective (algebraMap Γ(X, V) (X.presheaf.stalk (genericPoint X))) :=
      germ_injective_of_isIntegral X _ hη
    let T := CommRingCat.of (TensorProduct Γ(X, V) Γ(U.left, W₀) (X.presheaf.stalk (genericPoint X)))
    let inl : Γ(U.left, W₀) ⟶ T := CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := Γ(X, V)) (A := Γ(U.left, W₀)) (B := X.presheaf.stalk (genericPoint X)))
    let inr : X.presheaf.stalk (genericPoint X) ⟶ T :=
      CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := Γ(X, V)) (A := Γ(U.left, W₀)) (B := X.presheaf.stalk (genericPoint X))).toRingHom
    have hsq : φ ≫ inl = g ≫ inr := by
      have := (CommRingCat.isPushout_tensorProduct Γ(X, V) Γ(U.left, W₀)
        (X.presheaf.stalk (genericPoint X))).toCommSq.w
      exact this
    have hinl : Function.Injective inl.hom := fun a b hab =>
      Algebra.TensorProduct.includeLeft_injective (S := Γ(X, V)) hginj hab
    have e1 : Spec.map φ ≫ hV.fromSpec = hW₀.fromSpec ≫ U.hom :=
      IsAffineOpen.SpecMap_appLE_fromSpec U.hom hV hW₀ e
    have e2 : Spec.map g ≫ hV.fromSpec = X.fromSpecStalk (genericPoint X) :=
      (IsAffineOpen.fromSpecStalk.eq_1 hV hη).symm.trans (hV.fromSpecStalk_eq_fromSpecStalk hη)
    have hw : (Spec.map inl ≫ hW₀.fromSpec) ≫ U.hom =
        Spec.map inr ≫ X.fromSpecStalk (genericPoint X) := by
      rw [Category.assoc, ← e1, ← e2, ← Category.assoc, ← Category.assoc, ← Spec.map_comp,
        ← Spec.map_comp, hsq]
    have hm : Limits.pullback.lift _ _ hw ≫
        Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) =
        Spec.map inl ≫ hW₀.fromSpec := Limits.pullback.lift_fst _ _ _
    have key : ∀ (ψ : Spec T ⟶ U.left) (eψ : (⊤ : (Spec T).Opens) ≤ ψ ⁻¹ᵁ W₀),
        ψ = Limits.pullback.lift _ _ hw ≫
          Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) →
        (ψ.appLE W₀ ⊤ eψ) s = 0 := by
      rintro ψ eψ rfl
      rw [Scheme.Hom.comp_appLE, CommRingCat.comp_apply, hs', map_zero]
    have eT : (⊤ : (Spec T).Opens) ≤ (Spec.map inl ≫ hW₀.fromSpec) ⁻¹ᵁ W₀ := by
      intro z _
      have hz : hW₀.fromSpec ((Spec.map inl) z) ∈ (W₀ : Set U.left) := by
        rw [← hW₀.range_fromSpec]; exact ⟨_, rfl⟩
      change (Spec.map inl ≫ hW₀.fromSpec) z ∈ (W₀ : Set U.left)
      rw [Scheme.Hom.comp_apply]
      exact hz
    have h1 := key _ eT hm.symm
    have h2 : (Spec.map inl ≫ hW₀.fromSpec).appLE W₀ ⊤ eT =
        (Scheme.ΓSpecIso Γ(U.left, W₀)).inv ≫ (Spec.map inl).appTop := by
      rw [Scheme.Hom.comp_appLE, IsAffineOpen.fromSpec_app_self, Category.assoc]
      erw [Scheme.Hom.map_appLE]
      congr 1
    rw [h2, CommRingCat.comp_apply] at h1
    have h3 : inl s = 0 := by
      have := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso Γ(U.left, W₀)).inv s))
        (Scheme.ΓSpecIso_naturality inl)
      simp only [CommRingCat.comp_apply] at this
      rw [h1, map_zero, Iso.inv_hom_id_apply] at this
      exact this.symm
    exact hinl (h3.trans (map_zero inl.hom).symm)

  have germKer : ∀ (W : U.left.Opens) (f : Γ(U.left, W)), wcGenSigma X U W f = 0 →
      ∀ (y : U.left) (hy : y ∈ W), U.left.presheaf.germ W y hy f = 0 := by
    intro W f hf y hy
    obtain ⟨O, hO, hyO, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := U.hom y)
      (U := ⊤) trivial
    have hne : ((O : Set X)).Nonempty := ⟨U.hom y, hyO⟩
    have hη : genericPoint X ∈ O :=
      ((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr (by simpa using hne)
    have hyWO : y ∈ W ⊓ U.hom ⁻¹ᵁ O := ⟨hy, hyO⟩
    obtain ⟨W₀, hW₀, hyW₀, hsub⟩ := exists_isAffineOpen_mem_and_subset hyWO
    have le : W₀ ≤ W := fun z hz => (hsub hz).1
    have eO : W₀ ≤ U.hom ⁻¹ᵁ O := fun z hz => (hsub hz).2
    have hf₀ : wcGenSigma X U W₀ (U.left.presheaf.map (homOfLE le).op f) = 0 := by
      rw [compA _ _ le, hf, map_zero]
    have h0 := kernel O hO hη W₀ hW₀ eO _ hf₀
    rw [← TopCat.Presheaf.germ_res_apply U.left.presheaf (homOfLE le) y hyW₀ f, h0, map_zero]
  obtain ⟨W, hx, g, h, -, he, hg, hh, hn⟩ := hr
  obtain ⟨W', hx', g', h', -, he', hg', hh', hn'⟩ := hr'
  haveI := hdom
  haveI := hdvr
  have hxx : x ∈ W ⊓ W' := ⟨hx, hx'⟩
  have l : W ⊓ W' ≤ W := inf_le_left
  have l' : W ⊓ W' ≤ W' := inf_le_right
  have germ₁ : ∀ f, U.left.presheaf.germ (W ⊓ W') x hxx (U.left.presheaf.map (homOfLE l).op f) =
      U.left.presheaf.germ W x hx f := fun f => TopCat.Presheaf.germ_res_apply _ _ _ _ _
  have germ₂ : ∀ f, U.left.presheaf.germ (W ⊓ W') x hxx (U.left.presheaf.map (homOfLE l').op f) =
      U.left.presheaf.germ W' x hx' f := fun f => TopCat.Presheaf.germ_res_apply _ _ _ _ _
  have hσD : wcGenSigma X U (W ⊓ W')
      (U.left.presheaf.map (homOfLE l).op g * U.left.presheaf.map (homOfLE l').op h' -
        U.left.presheaf.map (homOfLE l').op g' * U.left.presheaf.map (homOfLE l).op h) = 0 := by
    rw [map_sub, map_mul, map_mul, compA _ _ l g, compA _ _ l' h', compA _ _ l' g',
      compA _ _ l h, ← he, ← he']
    simp only [map_mul]
    rw [← compB _ _ l b, ← compB _ _ l' b]
    ring
  have hDx := germKer _ _ hσD x hxx
  rw [map_sub, map_mul, map_mul, germ₁, germ₁, germ₂, germ₂, sub_eq_zero] at hDx
  have hv := congrArg (wcLocVal _) hDx
  rw [locMul _ _ _ hg hh', locMul _ _ _ hg' hh] at hv
  have hv' : (wcLocVal _ (U.left.presheaf.germ W x hx g) : ℤ) +
      wcLocVal _ (U.left.presheaf.germ W' x hx' h') =
      wcLocVal _ (U.left.presheaf.germ W' x hx' g') +
      wcLocVal _ (U.left.presheaf.germ W x hx h) := by exact_mod_cast hv
  rw [hn, hn']
  linarith

theorem wc_ord_rep_mul : ∀ (X : Scheme.{u}) [IsIntegral X] (U : X.Etale) (b₁ b₂ : Γ(wcGenPt X U, ⊤)) (x : U.left) (n₁ n₂ : ℤ), wcIsDVR (U.left.presheaf.stalk x) → wcOrdRep X U b₁ x n₁ → wcOrdRep X U b₂ x n₂ → wcOrdRep X U (b₁ * b₂) x (n₁ + n₂) :=
by
  intro X _ U b₁ b₂ x n₁ n₂ hD hr₁ hr₂
  obtain ⟨hdom, hdvr⟩ := hD

  have stepA : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R),
      Irreducible ϖ → ∀ (w : Rˣ) (k : ℕ), wcLocVal R ((w : R) * ϖ ^ k) = k := by
    intro R _ _ _ ϖ hϖ w k
    unfold wcLocVal
    split_ifs with h
    · classical
      obtain ⟨v, ϖ', hϖ', hv⟩ := Nat.find_spec h
      have hk := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' w v k _ hv
      exact hk.symm
    · exact absurd ⟨k, w, ϖ, hϖ, rfl⟩ h

  have locMul : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (r s : R),
      r ≠ 0 → s ≠ 0 → wcLocVal R (r * s) = wcLocVal R r + wcLocVal R s := by
    intro R _ _ _ r s hr hs
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨a, u₁, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hϖ
    obtain ⟨c, u₂, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
    have e : (u₁ : R) * ϖ ^ a * ((u₂ : R) * ϖ ^ c) = ((u₁ * u₂ : Rˣ) : R) * ϖ ^ (a + c) := by
      rw [Units.val_mul, pow_add]; ring
    rw [e, stepA R ϖ hϖ, stepA R ϖ hϖ, stepA R ϖ hϖ]

  have compA : ∀ (V W : U.left.Opens) (hle : W ≤ V) (f : Γ(U.left, V)),
      wcGenSigma X U W (U.left.presheaf.map (homOfLE hle).op f) =
      (wcGenPt X U).presheaf.map (homOfLE (fun _ hy => hle hy :
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V)).op
        (wcGenSigma X U V f) := by
    intro V W hle f
    have := congrArg (fun φ => φ.hom f) (Scheme.Hom.naturality
      (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) (homOfLE hle).op)
    exact this
  have compB : ∀ (V W : U.left.Opens) (hle : W ≤ V) (b : Γ(wcGenPt X U, ⊤)),
      wcGenRestr X U W b =
      (wcGenPt X U).presheaf.map (homOfLE (fun _ hy => hle hy :
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V)).op
        (wcGenRestr X U V b) := by
    intro V W hle b
    have hle' : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V := fun _ hy => hle hy
    have htop : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ V ≤ ⊤ := le_top
    have := congrArg (fun φ => φ.hom b) ((wcGenPt X U).presheaf.map_comp
      (homOfLE htop).op (homOfLE hle').op)
    exact this
  obtain ⟨W₁, hx₁, g₁, h₁, hu₁, he₁, hg₁, hh₁, hn₁⟩ := hr₁
  obtain ⟨W₂, hx₂, g₂, h₂, hu₂, he₂, hg₂, hh₂, hn₂⟩ := hr₂
  haveI := hdom
  haveI := hdvr
  have hx : x ∈ W₁ ⊓ W₂ := ⟨hx₁, hx₂⟩
  have le₁ : W₁ ⊓ W₂ ≤ W₁ := inf_le_left
  have le₂ : W₁ ⊓ W₂ ≤ W₂ := inf_le_right
  have germ₁ : ∀ f, U.left.presheaf.germ (W₁ ⊓ W₂) x hx (U.left.presheaf.map (homOfLE le₁).op f) =
      U.left.presheaf.germ W₁ x hx₁ f := fun f => TopCat.Presheaf.germ_res_apply _ _ _ _ _
  have germ₂ : ∀ f, U.left.presheaf.germ (W₁ ⊓ W₂) x hx (U.left.presheaf.map (homOfLE le₂).op f) =
      U.left.presheaf.germ W₂ x hx₂ f := fun f => TopCat.Presheaf.germ_res_apply _ _ _ _ _
  refine ⟨W₁ ⊓ W₂, hx,
    U.left.presheaf.map (homOfLE le₁).op g₁ * U.left.presheaf.map (homOfLE le₂).op g₂,
    U.left.presheaf.map (homOfLE le₁).op h₁ * U.left.presheaf.map (homOfLE le₂).op h₂,
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [map_mul, compA _ _ le₁, compA _ _ le₂]
    exact (hu₁.map _).mul (hu₂.map _)
  · simp only [map_mul]
    rw [compA _ _ le₁ g₁, compA _ _ le₂ g₂, compA _ _ le₁ h₁, compA _ _ le₂ h₂,
      compB _ _ le₁ b₁, compB _ _ le₂ b₂, ← he₁, ← he₂]
    simp only [map_mul]
    ring
  · rw [map_mul, germ₁, germ₂]
    exact mul_ne_zero hg₁ hg₂
  · rw [map_mul, germ₁, germ₂]
    exact mul_ne_zero hh₁ hh₂
  · rw [map_mul, map_mul, germ₁, germ₂, germ₁, germ₂, locMul _ _ _ hh₁ hh₂,
      locMul _ _ _ hg₁ hg₂, hn₁, hn₂]
    push_cast
    ring

theorem wc_ord_rep_pullback : ∀ (X : Scheme.{u}) [IsIntegral X] [IsLocallyNoetherian X] (U V : X.Etale) (c : V ⟶ U) (b : Γ(wcGenPt X U, ⊤)) (t : V.left) (n : ℤ), wcIsDVR (U.left.presheaf.stalk (c.left t)) → wcOrdRep X U b (c.left t) n → wcOrdRep X V (wcGenMap X c b) t n :=
by
  intro X _ _ U V c b t n hD hR
  obtain ⟨W, hx, g, h, hu, he, hg, hh, hn⟩ := hR

  have stepA : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R),
      Irreducible ϖ → ∀ (w : Rˣ) (k : ℕ), wcLocVal R ((w : R) * ϖ ^ k) = k := by
    intro R _ _ _ ϖ hϖ w k
    unfold wcLocVal
    split_ifs with h
    · classical
      obtain ⟨v, ϖ', hϖ', hv⟩ := Nat.find_spec h
      have hk := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' w v k _ hv
      exact hk.symm
    · exact absurd ⟨k, w, ϖ, hϖ, rfl⟩ h

  have transport : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
      [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] (φ : A →+* B),
      (∀ ϖ : A, Irreducible ϖ → Irreducible (φ ϖ)) → ∀ r : A, r ≠ 0 →
      φ r ≠ 0 ∧ wcLocVal B (φ r) = wcLocVal A r := by
    intro A B _ _ _ _ _ _ φ hφ r hr
    obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible A
    obtain ⟨k, w, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hπ
    have hφπ := hφ π hπ
    have e : φ ((w : A) * π ^ k) = ((Units.map φ.toMonoidHom w : Bˣ) : B) * (φ π) ^ k := by
      rw [map_mul, map_pow, Units.coe_map]
      rfl
    rw [e, stepA B (φ π) hφπ, stepA A π hπ]
    exact ⟨mul_ne_zero (Units.ne_zero _) (pow_ne_zero _ hφπ.ne_zero), rfl⟩

  have appLE_eq : ∀ {S T : Scheme.{u}} {k k' : S ⟶ T} (e : k = k') (O : T.Opens) (O' : S.Opens)
      (h₁ : O' ≤ k ⁻¹ᵁ O) (h₂ : O' ≤ k' ⁻¹ᵁ O), k.appLE O O' h₁ = k'.appLE O O' h₂ := by
    intro S T k k' e O O' h₁ h₂
    subst e
    rfl

  let cK : wcGenPt X V ⟶ wcGenPt X U :=
    (Scheme.Etale.forget X ⋙ Over.pullback (X.fromSpecStalk (genericPoint X)) ⋙
      Over.forget _).map c
  have sq : cK ≫ Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) =
      Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X)) ≫ c.left := by
    have hpm := Over.pullback_map_left (X.fromSpecStalk (genericPoint X))
      ((Scheme.Etale.forget X).obj V) (k := (Scheme.Etale.forget X).map c)
    exact (congrArg (fun k => k ≫ Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)))
      hpm).trans (Limits.pullback.lift_fst _ _ _)
  have hle : (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ (c.left ⁻¹ᵁ W) ≤
      cK ⁻¹ᵁ ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) := by
    intro y hy
    have e : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) (cK y) =
        c.left ((Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) y) := by
      rw [← Scheme.Hom.comp_apply, sq, Scheme.Hom.comp_apply]
    show (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) (cK y) ∈ W
    rw [e]
    exact hy
  let ψm := cK.appLE ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W)
    ((Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ (c.left ⁻¹ᵁ W)) hle
  have hσm : c.left.app W ≫
      (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))).app (c.left ⁻¹ᵁ W) =
      (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W ≫ ψm := by
    rw [← Scheme.Hom.comp_app, Scheme.Hom.app_eq_appLE]
    exact (appLE_eq sq.symm W _ _ _).trans (Scheme.Hom.comp_appLE cK _ W _ hle)
  have hσ : ∀ f : Γ(U.left, W), wcGenSigma X V (c.left ⁻¹ᵁ W) ((c.left.app W).hom f) =
      ψm.hom (wcGenSigma X U W f) := fun f => congrArg (fun k => k.hom f) hσm
  have htopV : (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ (c.left ⁻¹ᵁ W) ≤
      cK ⁻¹ᵁ ⊤ := le_top
  have htopU : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤ ⊤ := le_top
  have hrm : cK.app ⊤ ≫ (wcGenPt X V).presheaf.map (homOfLE htopV).op =
      (wcGenPt X U).presheaf.map (homOfLE htopU).op ≫ ψm := by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    show _ = _ ≫ cK.appLE _ _ hle
    rw [Scheme.Hom.map_appLE]
  have hr : ∀ b : Γ(wcGenPt X U, ⊤), wcGenRestr X V (c.left ⁻¹ᵁ W) (wcGenMap X c b) =
      ψm.hom (wcGenRestr X U W b) := fun b => congrArg (fun k => k.hom b) hrm

  obtain ⟨hdA, hvA⟩ := hD
  haveI : Etale U.hom := U.prop
  haveI : IsLocallyNoetherian ((Functor.fromPUnit X).obj U.right) :=
    inferInstanceAs (IsLocallyNoetherian X)
  haveI : IsLocallyNoetherian U.left := LocallyOfFiniteType.isLocallyNoetherian U.hom
  haveI : Etale c.left := Etale.of_comp c.left U.hom
  obtain ⟨⟨hdB, hvB⟩, hirr⟩ := wc_etale_stalk_dvr c.left t ⟨hdA, hvA⟩
  have tr := transport _ _ (c.left.stalkMap t).hom hirr
  have gsa := Scheme.Hom.germ_stalkMap_apply c.left W t hx
  refine ⟨c.left ⁻¹ᵁ W, hx, (c.left.app W).hom g, (c.left.app W).hom h, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hσ]
    exact hu.map ψm.hom
  · rw [hσ g, hr b, hσ h, ← map_mul, he]
  · rw [← gsa]
    exact (tr _ hg).1
  · rw [← gsa]
    exact (tr _ hh).1
  · rw [← gsa, ← gsa, (tr _ hh).2, (tr _ hg).2]
    exact hn

theorem wc_ord_rep_locally_zero : ∀ (X : Scheme.{u}) [IsIntegral X] [IsLocallyNoetherian X], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (U : X.Etale) (b : (Γ(wcGenPt X U, ⊤))ˣ) (x : U.left), ∃ W : Set U.left, IsOpen W ∧ x ∈ W ∧ ∃ T : Set X, T.Finite ∧ ∀ y : U.left, y ∈ W → U.hom y ∉ T → wcOrdRep X U (b : Γ(wcGenPt X U, ⊤)) y 0 :=
by
  intro X _ _ hdim U b x

  have hv0 : ∀ (R : Type u) [CommRing R] (r : R), IsUnit r → wcLocVal R r = 0 := by
    intro R _ r hr
    classical
    unfold wcLocVal
    split_ifs with h
    · rw [Nat.find_eq_zero]
      obtain ⟨n, w, ϖ, hϖ, _⟩ := h
      exact ⟨hr.unit, ϖ, hϖ, by simp⟩
    · rfl

  have hηmem : ∀ (O : X.Opens) (a : Γ(X, O)), a ≠ 0 → genericPoint X ∈ O := by
    intro O a ha
    by_contra hη
    have hOe : O = ⊥ := by
      ext y
      simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
      intro hy
      exact hη (((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr ⟨y, trivial, hy⟩)
    have hs : Subsingleton Γ(X, O) :=
      CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty hOe)
    exact ha (@Subsingleton.elim _ hs _ _)

  have s1 : ∀ z : X, z ≠ genericPoint X → IsClosed ({z} : Set X) := by
    intro z hz
    have hd : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 1 := by
      have h1 := hdim.le
      rw [topologicalKrullDim.eq_1, Nat.cast_one] at h1
      exact h1
    have hmm := Order.krullDim_le_one_iff.mp hd
    let Zc : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Tp : TopologicalSpace.IrreducibleCloseds X :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
    have hmin : IsMin Zc := by
      rcases hmm Zc with h | h
      · exact h
      · exfalso
        have hle : Zc ≤ Tp := by
          rw [← SetLike.coe_subset_coe]
          exact Set.subset_univ _
        have h2 : Tp ≤ Zc := h hle
        rw [← SetLike.coe_subset_coe] at h2
        have hc : closure ({z} : Set X) = Set.univ := Set.eq_univ_of_univ_subset h2
        have hg : IsGenericPoint z Set.univ := isGenericPoint_def.mpr hc
        exact hz (hg.eq (genericPoint_spec X))
    rw [← closure_subset_iff_isClosed]
    intro ζ hζ
    let Zζ : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {ζ}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hle1 : closure ({ζ} : Set X) ⊆ closure {z} :=
      closure_minimal (Set.singleton_subset_iff.mpr hζ) isClosed_closure
    have hle : Zζ ≤ Zc := by
      rw [← SetLike.coe_subset_coe]
      exact hle1
    have h2 := hmin hle
    rw [← SetLike.coe_subset_coe] at h2
    have heq : closure ({ζ} : Set X) = closure {z} := le_antisymm hle1 h2
    exact (inseparable_iff_closure_eq.mpr heq).eq

  have s2 : ∀ (O : X.Opens), IsAffineOpen O → ∀ f : Γ(X, O), f ≠ 0 →
      ((O : Set X) \ (X.basicOpen f : Set X)).Finite := by
    intro O hO f hf
    have hηO := hηmem O f hf
    have hηD : genericPoint X ∈ X.basicOpen f := by
      rw [Scheme.mem_basicOpen X f _ hηO, isUnit_iff_ne_zero]
      intro h0
      apply hf
      apply germ_injective_of_isIntegral X (genericPoint X) hηO
      rw [h0, map_zero]
    haveI : IsNoetherianRing Γ(X, O) := IsLocallyNoetherian.component_noetherian ⟨O, hO⟩
    haveI : TopologicalSpace.NoetherianSpace (O : Set X) := noetherianSpace_of_isAffineOpen O hO
    let S₀ : Set (O : Set X) := Subtype.val ⁻¹' (X.basicOpen f : Set X)ᶜ
    have hS₀ : IsClosed S₀ :=
      (X.basicOpen f).isOpen.isClosed_compl.preimage continuous_subtype_val
    have himg : (O : Set X) \ (X.basicOpen f : Set X) = Subtype.val '' S₀ := by
      ext q
      constructor
      · rintro ⟨hq, hq'⟩
        exact ⟨⟨q, hq⟩, hq', rfl⟩
      · rintro ⟨p, hp, rfl⟩
        exact ⟨p.2, hp⟩
    obtain ⟨𝒮, h𝒮fin, h𝒮cl, h𝒮irr, h𝒮eq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hS₀
    rw [himg, h𝒮eq, Set.sUnion_eq_biUnion, Set.image_iUnion₂]
    refine h𝒮fin.biUnion (fun Z hZ => ?_)
    apply Set.Subsingleton.finite
    have hZsub : Z ⊆ S₀ := by
      rw [h𝒮eq]
      exact Set.subset_sUnion_of_mem hZ
    have hZ'irr : IsIrreducible (Subtype.val '' Z) :=
      (h𝒮irr Z hZ).image _ continuous_subtype_val.continuousOn
    have hξ := hZ'irr.isGenericPoint_genericPoint_closure
    obtain ⟨p, hp⟩ := (h𝒮irr Z hZ).nonempty
    have hξO : hZ'irr.genericPoint ∈ (O : Set X) := by
      rw [hξ.mem_open_set_iff O.isOpen]
      exact ⟨p.1, subset_closure ⟨p, hp, rfl⟩, p.2⟩
    obtain ⟨C, hCcl, hCeq⟩ := isClosed_induced_iff.mp (h𝒮cl Z hZ)
    have hclC : closure (Subtype.val '' Z) ⊆ C := by
      apply closure_minimal _ hCcl
      rintro _ ⟨q, hq, rfl⟩
      rw [← hCeq] at hq
      exact hq
    have hξZ : (⟨hZ'irr.genericPoint, hξO⟩ : (O : Set X)) ∈ Z := by
      have hmem : (⟨hZ'irr.genericPoint, hξO⟩ : (O : Set X)) ∈ Subtype.val ⁻¹' C := hclC hξ.mem
      rw [hCeq] at hmem
      exact hmem
    have hξnD : hZ'irr.genericPoint ∉ X.basicOpen f := hZsub hξZ
    have hξne : hZ'irr.genericPoint ≠ genericPoint X := by
      intro h
      apply hξnD
      rw [h]
      exact hηD
    have hcl1 : IsClosed ({hZ'irr.genericPoint} : Set X) := s1 _ hξne
    have hcl2 : closure (Subtype.val '' Z) = {hZ'irr.genericPoint} := by
      rw [← (isGenericPoint_def.mp hξ), hcl1.closure_eq]
    have hsub2 : Subtype.val '' Z ⊆ {hZ'irr.genericPoint} := by
      rw [← hcl2]
      exact subset_closure
    exact Set.subsingleton_singleton.anti hsub2

  have s3g : ∀ (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O) (a : Γ(X, O))
      (y : U.left) (hy : y ∈ W), U.hom y ∈ X.basicOpen a →
      IsUnit (U.left.presheaf.germ W y hy (wcPull X U O W hW a)) := by
    intro O W hW a y hy hD
    have hyO : U.hom y ∈ O := hW hy
    have e : wcPull X U O W hW a = U.left.presheaf.map (homOfLE hW).op (U.hom.app O a) := rfl
    rw [e, TopCat.Presheaf.germ_res_apply]
    have hu := ((Scheme.mem_basicOpen X a (U.hom y) hyO).mp hD).map (U.hom.stalkMap y).hom
    have hc := congrArg (fun φ => φ.hom a) (Scheme.Hom.germ_stalkMap U.hom O y hyO)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hc
    erw [hc] at hu
    exact hu

  have hcong : ∀ {A B : Scheme.{u}} (f g : A ⟶ B) (O' : B.Opens) (V : A.Opens)
      (e : V ≤ f ⁻¹ᵁ O') (e' : V ≤ g ⁻¹ᵁ O'), f = g → f.appLE O' V e = g.appLE O' V e' := by
    intro A B f g O' V e e' hfg
    subst hfg
    rfl

  have s5 : ∀ (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O) (a : Γ(X, O)), a ≠ 0 →
      IsUnit (wcGenSigma X U W (wcPull X U O W hW a)) := by
    intro O W hW a ha
    have hO : genericPoint X ∈ O := hηmem O a ha
    have hu : IsUnit ((X.presheaf.germ O (genericPoint X) hO).hom a) := by
      rw [isUnit_iff_ne_zero]
      intro h0
      apply ha
      apply germ_injective_of_isIntegral X (genericPoint X) hO
      rw [h0, map_zero]
    have e1 : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X)) ≫
          X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O := by
      intro p hp
      have hp' : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) ≫ U.hom) p ∈ O := by
        rw [Scheme.Hom.comp_apply]
        exact hW hp
      rw [Limits.pullback.condition] at hp'
      exact hp'
    have key : U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W =
        (X.fromSpecStalk (genericPoint X)).app O ≫
          (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X))).appLE
            ((X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O)
            ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) e1 := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, ← Scheme.Hom.comp_appLE]
      exact hcong _ _ _ _ _ _ Limits.pullback.condition
    have e2 : wcGenSigma X U W (wcPull X U O W hW a) =
        (U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W).hom a :=
      rfl
    rw [e2, key, Scheme.fromSpecStalk_app hO]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    exact ((hu.map _).map _).map _

  obtain ⟨O, hO, hxO, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := U.hom x)
    (U := ⊤) trivial
  obtain ⟨W, hWa, hxW, hsub⟩ := exists_isAffineOpen_mem_and_subset (x := x)
    (U := U.hom ⁻¹ᵁ O) hxO
  have hW : W ≤ U.hom ⁻¹ᵁ O := hsub
  haveI : Nonempty O := ⟨⟨U.hom x, hxO⟩⟩
  haveI : IsDomain Γ(X, O) := IsIntegral.component_integral O
  have L := wc_gen_fibre_affine_localization X U O W hO hWa ⟨U.hom x, hxO⟩ hW
  have H3 : wcGenRestr X U W (b : Γ(wcGenPt X U, ⊤)) *
      wcGenRestr X U W ((b⁻¹ : (Γ(wcGenPt X U, ⊤))ˣ) : Γ(wcGenPt X U, ⊤)) = 1 := by
    rw [← map_mul, Units.mul_inv, map_one]
  obtain ⟨a₁, h, ha₁, H1⟩ := L.2 (wcGenRestr X U W (b : Γ(wcGenPt X U, ⊤)))
  obtain ⟨a₂, h', ha₂, H2⟩ :=
    L.2 (wcGenRestr X U W ((b⁻¹ : (Γ(wcGenPt X U, ⊤))ˣ) : Γ(wcGenPt X U, ⊤)))
  have hf0 : wcGenSigma X U W (h * h' - wcPull X U O W hW (a₁ * a₂)) = 0 := by
    simp only [map_sub, map_mul]
    rw [← H1, ← H2]
    linear_combination (wcGenSigma X U W (wcPull X U O W hW a₁) *
      wcGenSigma X U W (wcPull X U O W hW a₂)) * H3
  obtain ⟨a₃, ha₃, H4⟩ := L.1 _ hf0
  have he0 : a₃ * (a₁ * a₂) ≠ 0 := mul_ne_zero ha₃ (mul_ne_zero ha₁ ha₂)
  have E1 : wcPull X U O W hW (a₃ * (a₁ * a₂)) = wcPull X U O W hW a₃ * (h * h') := by
    rw [mul_sub, sub_eq_zero] at H4
    rw [map_mul, ← H4]
  have E2 : wcPull X U O W hW (a₃ * (a₁ * a₂)) =
      wcPull X U O W hW a₃ * (wcPull X U O W hW a₁ * wcPull X U O W hW a₂) := by
    rw [map_mul, map_mul]
  refine ⟨(W : Set U.left), W.isOpen, hxW,
    (O : Set X) \ (X.basicOpen (a₃ * (a₁ * a₂)) : Set X), s2 O hO _ he0, ?_⟩
  intro y hy hyT
  have hyO : U.hom y ∈ O := hW hy
  have hD : U.hom y ∈ X.basicOpen (a₃ * (a₁ * a₂)) := by
    by_contra hn
    exact hyT ⟨hyO, hn⟩
  have uh : IsUnit (U.left.presheaf.germ W y hy h) := by
    have u := s3g O W hW _ y hy hD
    rw [E1, map_mul, map_mul] at u
    exact isUnit_of_mul_isUnit_left (isUnit_of_mul_isUnit_right u)
  have ug : IsUnit (U.left.presheaf.germ W y hy (wcPull X U O W hW a₁)) := by
    have u := s3g O W hW _ y hy hD
    rw [E2, map_mul, map_mul] at u
    exact isUnit_of_mul_isUnit_left (isUnit_of_mul_isUnit_right u)
  refine ⟨W, hy, wcPull X U O W hW a₁, h, s5 O W hW a₁ ha₁, H1, ug.ne_zero, uh.ne_zero, ?_⟩
  rw [hv0 _ _ uh, hv0 _ _ ug]
  simp

theorem wc_ord_construct : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX]
    [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∃ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord :=
by
  intro Ω _ _ X fX _ _ hnorm hdim
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX

  let ν : ∀ U : X.Etale, (Γ(wcGenPt X U, ⊤))ˣ → wcEtPts Ω X fX U → ℤ := fun U b s =>
    Classical.choose (wc_ord_rep_exists X U b (s.1 (IsLocalRing.closedPoint Ω)))
  have hν : ∀ (U : X.Etale) (b : (Γ(wcGenPt X U, ⊤))ˣ) (s : wcEtPts Ω X fX U),
      wcOrdRep X U (b : Γ(wcGenPt X U, ⊤)) (s.1 (IsLocalRing.closedPoint Ω)) (ν U b s) :=
    fun U b s => Classical.choose_spec (wc_ord_rep_exists X U b (s.1 (IsLocalRing.closedPoint Ω)))
  have hdvr : ∀ (U : X.Etale) (s : wcEtPts Ω X fX U),
      wcIsDVR (U.left.presheaf.stalk (s.1 (IsLocalRing.closedPoint Ω))) :=
    fun U s => (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim U s).1

  have hchar : ∀ (U : X.Etale) (b : (Γ(wcGenPt X U, ⊤))ˣ) (s : wcEtPts Ω X fX U) (n : ℤ),
      wcOrdRep X U (b : Γ(wcGenPt X U, ⊤)) (s.1 (IsLocalRing.closedPoint Ω)) n → ν U b s = n :=
    fun U b s n h => wc_ord_rep_unique X U _ _ _ _ (hdvr U s) (hν U b s) h

  have hadd : ∀ (U : X.Etale) (b₁ b₂ : (Γ(wcGenPt X U, ⊤))ˣ) (s : wcEtPts Ω X fX U),
      ν U (b₁ * b₂) s = ν U b₁ s + ν U b₂ s := by
    intro U b₁ b₂ s
    apply hchar
    rw [Units.val_mul]
    exact wc_ord_rep_mul X U _ _ _ _ _ (hdvr U s) (hν U b₁ s) (hν U b₂ s)

  have hnat : ∀ (U V : X.Etale) (c : V ⟶ U) (b : (Γ(wcGenPt X U, ⊤))ˣ) (t : wcEtPts Ω X fX V),
      ν V (Units.map (wcGenMap X c).toMonoidHom b) t = ν U b (wcEtPtsMap Ω X fX c t) := by
    intro U V c b t
    apply hchar
    have h1 := hν U b (wcEtPtsMap Ω X fX c t)
    have h2 := hdvr U (wcEtPtsMap Ω X fX c t)
    have e : (wcEtPtsMap Ω X fX c t).1 (IsLocalRing.closedPoint Ω) =
        c.left (t.1 (IsLocalRing.closedPoint Ω)) := by
      change (t.1 ≫ c.left) (IsLocalRing.closedPoint Ω) = _
      exact Scheme.Hom.comp_apply _ _ _
    rw [e] at h1 h2
    exact wc_ord_rep_pullback X U V c _ _ _ h2 h1

  have hmem : ∀ (U : X.Etale) (b : (Γ(wcGenPt X U, ⊤))ˣ), ν U b ∈ wcEtDivSub Ω X fX U := by
    intro U b x
    obtain ⟨W, hW, hx, T, hT, hz⟩ := wc_ord_rep_locally_zero X hdim U b x
    refine ⟨W, hW, hx, T, hT, fun s hs hsW => ?_⟩
    by_contra hnot
    apply hs
    apply hchar
    apply hz _ hsW
    intro hT'
    apply hnot
    have e : (s.1 ≫ U.hom) (IsLocalRing.closedPoint Ω) = U.hom (s.1 (IsLocalRing.closedPoint Ω)) :=
      Scheme.Hom.comp_apply _ _ _
    rw [e]
    exact hT'

  let app : ∀ U : X.Etale, AddCommGrpCat.of (ULift.{u+1} (Additive (Γ(wcGenPt X U, ⊤))ˣ)) ⟶
      AddCommGrpCat.of (ULift.{u+1} (wcEtDivSub Ω X fX U)) := fun U =>
    AddCommGrpCat.ofHom (AddMonoidHom.mk'
      (fun x => ULift.up ⟨ν U (Additive.toMul x.down), hmem U _⟩) (fun x y => by
        apply ULift.ext
        apply Subtype.ext
        funext s
        exact hadd U _ _ s))
  refine ⟨{ app := fun U => app U.unop, naturality := ?_ }, ?_⟩
  · intro U V f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply ULift.ext
    apply Subtype.ext
    funext t
    exact hnat U.unop V.unop f.unop (Additive.toMul x.down) t
  · intro U b s n h
    exact hchar U b s n h

theorem wc_ord_locally_surjective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX]
    [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord →
    Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) ord :=
by
  intro Ω _ _ X fX _ _ hnorm hdim ord hchar

  have hval : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (ϖ : R) (v : Rˣ) (n : ℕ), Irreducible ϖ → wcLocVal R ((v : R) * ϖ ^ n) = n := by
    intro R _ _ _ ϖ v n hϖ
    classical
    unfold wcLocVal
    have hex : ∃ (n' : ℕ) (v' : Rˣ) (ϖ' : R), Irreducible ϖ' ∧
        (v : R) * ϖ ^ n = (v' : R) * ϖ' ^ n' := ⟨n, v, ϖ, hϖ, rfl⟩
    rw [dif_pos hex, Nat.find_eq_iff]
    refine ⟨⟨v, ϖ, hϖ, rfl⟩, fun m hm ⟨v', ϖ', hϖ', heq⟩ => ?_⟩
    have := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' v v' n m heq
    omega
  have hv1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (ϖ : R), Irreducible ϖ → wcLocVal R ϖ = 1 := by
    intro R _ _ _ ϖ hϖ
    have := hval R ϖ 1 1 hϖ
    simpa using this
  have hv0 : ∀ (R : Type u) [CommRing R] (r : R), IsUnit r → wcLocVal R r = 0 := by
    intro R _ r hr
    classical
    unfold wcLocVal
    split_ifs with h
    · rw [Nat.find_eq_zero]
      obtain ⟨n, w, ϖ, hϖ, _⟩ := h
      exact ⟨hr.unit, ϖ, hϖ, by simp⟩
    · rfl

  have hs2 : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType fY] (ξ : Y),
      ∃ s : Spec (.of Ω) ⟶ Y, s ≫ fY = 𝟙 _ ∧ ξ ⤳ s (IsLocalRing.closedPoint Ω) := by
    intro Y fY _ ξ
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace fY
    obtain ⟨y, hyξ, hyc⟩ := nonempty_inter_closedPoints (Z := closure ({ξ} : Set Y))
      ⟨ξ, subset_closure rfl⟩ isClosed_closure.isLocallyClosed
    have hxy : ξ ⤳ y := specializes_iff_mem_closure.mpr hyξ
    have hyc' : IsClosed ({y} : Set Y) := hyc
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hyc'
    let ψ : CommRingCat.of Ω ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ fY)
    have hψ : Spec.map ψ = Y.fromSpecResidueField y ≫ fY := Spec.map_preimage _
    have hft : ψ.hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map ψ) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    letI : Algebra Ω (Y.residueField y) := ψ.hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    have hsurj : Function.Surjective ψ.hom := by
      intro s
      have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
      exact ⟨c, hc⟩
    let e : Ω ≃+* Y.residueField y := RingEquiv.ofBijective ψ.hom ⟨ψ.hom.injective, hsurj⟩
    refine ⟨Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
      Y.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hψ, ← Spec.map_comp, ← Spec.map_id]
      congr 1
      ext c
      change e.symm (ψ.hom c) = c
      exact e.symm_apply_apply c
    · have h1 : (Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
          Y.fromSpecResidueField y) (IsLocalRing.closedPoint Ω) = y :=
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
      rw [h1]
      exact hxy

  have huniq : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (s s' : Spec (.of Ω) ⟶ Y),
      s ≫ fY = 𝟙 _ → s' ≫ fY = 𝟙 _ →
      s (IsLocalRing.closedPoint Ω) = s' (IsLocalRing.closedPoint Ω) → s = s' := by
    intro Y fY s s' hs hs' hpt
    have key : ∀ (y : Y) (φ φ' : Y.residueField y ⟶ CommRingCat.of Ω),
        Spec.map φ ≫ Y.fromSpecResidueField y ≫ fY = 𝟙 _ →
        Spec.map φ' ≫ Y.fromSpecResidueField y ≫ fY = 𝟙 _ → φ = φ' := by
      intro y φ φ' h1 h2
      let ψ : CommRingCat.of Ω ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ fY)
      have hψ : Spec.map ψ = Y.fromSpecResidueField y ≫ fY := Spec.map_preimage _
      have e1 : ψ ≫ φ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hψ, h1, Spec.map_id]
      have e2 : ψ ≫ φ' = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hψ, h2, Spec.map_id]
      have f1 : ∀ c, φ.hom (ψ.hom c) = c := fun c => congrArg (fun F => F.hom c) e1
      have f2 : ∀ c, φ'.hom (ψ.hom c) = c := fun c => congrArg (fun F => F.hom c) e2
      have g1 : ∀ t, ψ.hom (φ.hom t) = t := fun t => φ.hom.injective (f1 _)
      ext t
      rw [← g1 t, f2, f1]
    have e1 := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω Y s
    have e2 := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω Y s'
    obtain ⟨φ, hφ⟩ : ∃ φ : Y.residueField (s' (IsLocalRing.closedPoint Ω)) ⟶ CommRingCat.of Ω,
        Spec.map φ ≫ Y.fromSpecResidueField (s' (IsLocalRing.closedPoint Ω)) = s := by
      rw [← hpt]; exact ⟨_, e1⟩
    obtain ⟨φ', hφ'⟩ : ∃ φ' : Y.residueField (s' (IsLocalRing.closedPoint Ω)) ⟶ CommRingCat.of Ω,
        Spec.map φ' ≫ Y.fromSpecResidueField (s' (IsLocalRing.closedPoint Ω)) = s' := ⟨_, e2⟩
    have := key _ φ φ' (by rw [← Category.assoc, hφ, hs]) (by rw [← Category.assoc, hφ', hs'])
    subst this
    exact hφ.symm.trans hφ'

  have hgerm : ∀ (U : X.Etale) (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O)
      (a : Γ(X, O)) (y : U.left) (hy : y ∈ W),
      U.left.presheaf.germ W y hy (wcPull X U O W hW a) =
        (U.hom.stalkMap y).hom (X.presheaf.germ O (U.hom y) (hW hy) a) := by
    intro U O W hW a y hy
    exact (TopCat.Presheaf.germ_res_apply U.left.presheaf (homOfLE hW) y hy ((U.hom.app O).hom a)).trans
      (Scheme.Hom.germ_stalkMap_apply U.hom O y (hW hy) a).symm

  have hiso : ∀ (Y : Scheme.{u}) [IsLocallyNoetherian Y] (y : Y), IsClosed ({y} : Set Y) →
      wcIsDVR (Y.presheaf.stalk y) → ∀ (W : Y.Opens) (hy : y ∈ W) (f : Γ(Y, W)),
      Y.presheaf.germ W y hy f ≠ 0 → ∃ (N : Y.Opens) (hN : N ≤ W), y ∈ N ∧
        ∀ (z : Y) (hz : z ∈ N), z ≠ y → IsUnit (Y.presheaf.germ W z (hN hz) f) := by
    intro Y _ y hcl hdvr W hy f hf
    classical
    obtain ⟨hdom, hdvr⟩ := hdvr
    obtain ⟨V, hV, hyV, hVW⟩ := exists_isAffineOpen_mem_and_subset hy
    have hVW' : V ≤ W := hVW
    haveI : IsNoetherianRing Γ(Y, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
    let f' : Γ(Y, V) := Y.presheaf.map (homOfLE hVW').op f
    have hgf : ∀ (z : Y) (hz : z ∈ V), Y.presheaf.germ V z hz f' = Y.presheaf.germ W z (hVW' hz) f :=
      fun z hz => TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hVW') z hz f
    have hunit : ∀ (z : Y) (hz : z ∈ V) (r : Γ(Y, V)),
        IsUnit (Y.presheaf.germ V z hz r) ↔ r ∉ (hV.primeIdealOf ⟨z, hz⟩).asIdeal := by
      intro z hz r
      letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨z, hz⟩ : V)
      haveI := hV.isLocalization_stalk ⟨z, hz⟩
      exact IsLocalization.AtPrime.isUnit_to_map_iff (Y.presheaf.stalk z)
        (hV.primeIdealOf ⟨z, hz⟩).asIdeal r
    let m := hV.primeIdealOf ⟨y, hyV⟩

    have hspec : ∀ (z : Y) (hz : z ∈ V), m ≤ hV.primeIdealOf ⟨z, hz⟩ → z = y := by
      intro z hz hle
      have h1 : m ⤳ hV.primeIdealOf ⟨z, hz⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h2 := h1.map hV.fromSpec.continuous
      rw [IsAffineOpen.fromSpec_primeIdealOf, IsAffineOpen.fromSpec_primeIdealOf] at h2
      have h3 : z ∈ closure ({y} : Set Y) := specializes_iff_mem_closure.mp h2
      rw [hcl.closure_eq] at h3
      exact h3

    have hkey : ∀ P : Ideal Γ(Y, V), P.IsPrime → f' ∈ P → P ≤ m.asIdeal → P = m.asIdeal := by
      intro P hP hfP hPm
      letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨y, hyV⟩ : V)
      haveI := hV.isLocalization_stalk ⟨y, hyV⟩
      have hdisj : Disjoint (m.asIdeal.primeCompl : Set Γ(Y, V)) (P : Set Γ(Y, V)) := by
        rw [Set.disjoint_left]
        intro r hr hrP
        exact hr (hPm hrP)
      have hQp := IsLocalization.isPrime_of_isPrime_disjoint m.asIdeal.primeCompl
        (Y.presheaf.stalk y) P hP hdisj
      have hQne : Ideal.map (algebraMap Γ(Y, V) (Y.presheaf.stalk y)) P ≠ ⊥ := by
        intro h0
        have hm : algebraMap Γ(Y, V) (Y.presheaf.stalk y) f' ∈
            Ideal.map (algebraMap Γ(Y, V) (Y.presheaf.stalk y)) P := Ideal.mem_map_of_mem _ hfP
        rw [h0, Ideal.mem_bot] at hm
        apply hf
        rw [← hgf y hyV]
        exact hm
      have hQm := IsLocalRing.eq_maximalIdeal (hQp.isMaximal hQne)
      have e1 := IsLocalization.under_map_of_isPrime_disjoint m.asIdeal.primeCompl
        (Y.presheaf.stalk y) hP hdisj
      have e2 := IsLocalization.AtPrime.under_maximalIdeal (Y.presheaf.stalk y) m.asIdeal
      rw [hQm] at e1
      exact e1.symm.trans e2

    let Ms := (Ideal.span {f'}).minimalPrimes
    have hfin : Ms.Finite := Ideal.finite_minimalPrimes_of_isNoetherianRing _ _
    have hex : ∀ P ∈ Ms, P ≠ m.asIdeal → ∃ g ∈ P, g ∉ m.asIdeal := by
      intro P hP hne
      by_contra hcon
      push_neg at hcon
      apply hne
      have hPp : P.IsPrime := hP.1.1
      have hfP : f' ∈ P := hP.1.2 (Ideal.subset_span rfl)
      exact hkey P hPp hfP hcon
    let gfun : Ideal Γ(Y, V) → Γ(Y, V) := fun P =>
      if h : P ∈ Ms ∧ P ≠ m.asIdeal then Classical.choose (hex P h.1 h.2) else 1
    have hgfun : ∀ P, gfun P ∉ m.asIdeal := by
      intro P
      simp only [gfun]
      split_ifs with h
      · exact (Classical.choose_spec (hex P h.1 h.2)).2
      · intro h1
        exact m.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have hgfunP : ∀ P, P ∈ Ms → P ≠ m.asIdeal → gfun P ∈ P := by
      intro P h1 h2
      simp only [gfun, dif_pos (And.intro h1 h2)]
      exact (Classical.choose_spec (hex P h1 h2)).1
    let g : Γ(Y, V) := ∏ P ∈ hfin.toFinset, gfun P
    have hgm : g ∉ m.asIdeal := by
      intro h
      haveI := m.isPrime
      obtain ⟨P, -, hP⟩ := (Ideal.IsPrime.prod_mem_iff).mp h
      exact hgfun P hP
    refine ⟨Y.basicOpen g, (Y.basicOpen_le g).trans hVW', ?_, ?_⟩
    · rw [Scheme.mem_basicOpen Y g y hyV, hunit]
      exact hgm
    · intro z hz hzy
      have hzV : z ∈ V := Y.basicOpen_le g hz
      have hgz : g ∉ (hV.primeIdealOf ⟨z, hzV⟩).asIdeal := by
        rw [← hunit]; exact (Scheme.mem_basicOpen Y g z hzV).mp hz
      rw [← hgf z hzV, hunit]
      intro hfz
      haveI := (hV.primeIdealOf ⟨z, hzV⟩).isPrime
      obtain ⟨P, hPM, hPz⟩ := Ideal.exists_minimalPrimes_le
        ((Ideal.span_singleton_le_iff_mem _).mpr hfz)
      by_cases hPm : P = m.asIdeal
      · apply hzy
        apply hspec z hzV
        rw [← PrimeSpectrum.asIdeal_le_asIdeal, ← hPm]
        exact hPz
      · apply hgz
        apply Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem gfun ((Set.Finite.mem_toFinset hfin).mpr hPM))
        exact hPz (hgfunP P hPM hPm)

  have hcong : ∀ {A B : Scheme.{u}} (f g : A ⟶ B) (O' : B.Opens) (V : A.Opens)
      (e : V ≤ f ⁻¹ᵁ O') (e' : V ≤ g ⁻¹ᵁ O'), f = g → f.appLE O' V e = g.appLE O' V e' := by
    intro A B f g O' V e e' hfg
    subst hfg
    rfl
  have hσu : ∀ (U : X.Etale) (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O) (a : Γ(X, O)),
      a ≠ 0 → IsUnit (wcGenSigma X U W (wcPull X U O W hW a)) := by
    intro U O W hW a ha
    have hO : genericPoint X ∈ O := by
      by_contra hη
      have hOe : O = ⊥ := by
        ext y
        simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
        intro hy
        exact hη (((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr ⟨y, trivial, hy⟩)
      have hs : Subsingleton Γ(X, O) :=
        CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty hOe)
      exact ha (@Subsingleton.elim _ hs _ _)
    have hu : IsUnit ((X.presheaf.germ O (genericPoint X) hO).hom a) := by
      rw [isUnit_iff_ne_zero]
      intro h0
      apply ha
      apply germ_injective_of_isIntegral X (genericPoint X) hO
      rw [h0, map_zero]
    have e1 : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X)) ≫
          X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O := by
      intro p hp
      have hp' : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) ≫ U.hom) p ∈ O := by
        rw [Scheme.Hom.comp_apply]
        exact hW hp
      rw [Limits.pullback.condition] at hp'
      exact hp'
    have key : U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W =
        (X.fromSpecStalk (genericPoint X)).app O ≫
          (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X))).appLE
            ((X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O)
            ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) e1 := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, ← Scheme.Hom.comp_appLE]
      exact hcong _ _ _ _ _ _ Limits.pullback.condition
    have e2 : wcGenSigma X U W (wcPull X U O W hW a) =
        (U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W).hom a :=
      rfl
    rw [e2, key, Scheme.fromSpecStalk_app hO]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    exact ((hu.map _).map _).map _

  have hρ : ∀ (V : X.Etale) (e : Γ(V.left, ⊤)), wcGenRho X V e =
      (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))).appTop.hom e := by
    intro V e
    (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
  have hbridge : ∀ (V : X.Etale) (e : Γ(V.left, ⊤)),
      wcGenRestr X V ⊤ (wcGenRho X V e) = wcGenSigma X V ⊤ e := by
    intro V e
    rw [hρ]
    unfold wcGenRestr wcGenSigma
    have h2 : (homOfLE le_top : (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤ ⟶
        (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤) = 𝟙 _ :=
      Subsingleton.elim _ _
    erw [h2, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hρu : ∀ (V : X.Etale) (e : Γ(V.left, ⊤)), IsUnit (wcGenSigma X V ⊤ e) →
      IsUnit (wcGenRho X V e) := by
    intro V e h
    rw [hρ]
    exact h
  haveI hXN : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX

  classical
  constructor
  intro U d
  let d' : wcEtDivSub Ω X fX U := d.down
  haveI : Etale U.hom := U.prop
  haveI : IsLocallyNoetherian U.left := LocallyOfFiniteType.isLocallyNoetherian (U.hom ≫ fX)

  have hXpt : ∀ s : wcEtPts Ω X fX U,
      wcIsDVR (X.presheaf.stalk (U.hom (s.1 (IsLocalRing.closedPoint Ω)))) ∧
        IsClosed ({U.hom (s.1 (IsLocalRing.closedPoint Ω))} : Set X) := by
    intro s
    have h := wc_rational_point_stalk_dvr' Ω X fX hnorm hdim (wcEtTop X) ⟨s.1 ≫ U.hom, by
      have h : (s.1 ≫ U.hom) ≫ fX = 𝟙 _ := by rw [Category.assoc]; exact s.2
      exact (congrArg (fun k => (s.1 ≫ U.hom) ≫ k) (Category.id_comp fX)).trans h⟩
    exact ⟨h.1, h.2.1⟩
  apply wc_etale_jointly_surjective_covers X U
  intro x
  obtain ⟨s₁, hs₁, hxy⟩ := hs2 U.left (U.hom ≫ fX) x
  let s₀ : wcEtPts Ω X fX U := ⟨s₁, hs₁⟩
  have hclU := (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim U s₀).2.1
  have hdvrU := (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim U s₀).1
  obtain ⟨hdq, hdvrq⟩ := (hXpt s₀).1
  obtain ⟨ϖ, hϖ⟩ := @IsDiscreteValuationRing.exists_irreducible _ _ hdq hdvrq
  obtain ⟨O, hqO, a, ha⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf ϖ
  have ha0 : a ≠ 0 := by
    intro h0
    apply hϖ.ne_zero
    rw [← ha, h0, map_zero]
  have hyW0 : s₁ (IsLocalRing.closedPoint Ω) ∈ U.hom ⁻¹ᵁ O := hqO
  have hirrq : ∀ (w : X) (hw : w ∈ O), w = U.hom (s₁ (IsLocalRing.closedPoint Ω)) →
      wcIsDVR (X.presheaf.stalk w) ∧ Irreducible (X.presheaf.germ O w hw a) := by
    rintro w hw rfl
    refine ⟨(hXpt s₀).1, ?_⟩
    rw [show X.presheaf.germ O (U.hom (s₁ (IsLocalRing.closedPoint Ω))) hw a = ϖ from ha]
    exact hϖ

  have hfy : U.left.presheaf.germ (U.hom ⁻¹ᵁ O) (s₁ (IsLocalRing.closedPoint Ω)) hyW0
      (wcPull X U O (U.hom ⁻¹ᵁ O) le_rfl a) ≠ 0 := by
    rw [hgerm U O (U.hom ⁻¹ᵁ O) le_rfl a _ hyW0]
    obtain ⟨hdv, hirr⟩ := hirrq _ hyW0 rfl
    exact ((@wc_etale_stalk_dvr U.left X U.hom _ hXN _ hdv).2 _ hirr).ne_zero
  obtain ⟨N, hN, hyN, hNunit⟩ := hiso U.left _ hclU hdvrU (U.hom ⁻¹ᵁ O) hyW0 _ hfy
  have hNunitX : ∀ (z : U.left) (hz : z ∈ N), z ≠ s₁ (IsLocalRing.closedPoint Ω) →
      IsUnit (X.presheaf.germ O (U.hom z) (hN hz) a) := by
    intro z hz hzy
    have h1 := hNunit z hz hzy
    rw [hgerm U O (U.hom ⁻¹ᵁ O) le_rfl a z (hN hz)] at h1
    exact (isUnit_map_iff _ _).mp h1

  obtain ⟨Wd, hWdo, hyWd, T, hT, hTprop⟩ := d'.2 (s₁ (IsLocalRing.closedPoint Ω))
  let S : Set X := {t | t ∈ T ∧ t ≠ U.hom (s₁ (IsLocalRing.closedPoint Ω)) ∧ IsClosed ({t} : Set X)}
  have hSc : IsClosed S := by
    have h := (hT.subset (fun t (ht : t ∈ S) => ht.1)).isClosed_biUnion
      (f := fun t => ({t} : Set X)) (fun t ht => ht.2.2)
    rwa [Set.biUnion_of_singleton] at h
  let N' : U.left.Opens := N ⊓ ⟨Wd, hWdo⟩ ⊓ U.hom ⁻¹ᵁ ⟨Sᶜ, hSc.isOpen_compl⟩
  have hyN' : s₁ (IsLocalRing.closedPoint Ω) ∈ N' := ⟨⟨hyN, hyWd⟩, fun h => h.2.1 rfl⟩
  have hN'W : N' ≤ U.hom ⁻¹ᵁ O := fun z hz => hN hz.1.1
  have hsupp : ∀ s : wcEtPts Ω X fX U, s.1 (IsLocalRing.closedPoint Ω) ∈ N' → d'.1 s ≠ 0 →
      s.1 (IsLocalRing.closedPoint Ω) = s₁ (IsLocalRing.closedPoint Ω) := by
    intro s hz hd
    by_contra hzy
    have hT' : U.hom (s.1 (IsLocalRing.closedPoint Ω)) ∈ T := hTprop s hd hz.1.2
    have hq : U.hom (s.1 (IsLocalRing.closedPoint Ω)) = U.hom (s₁ (IsLocalRing.closedPoint Ω)) := by
      by_contra hne
      exact hz.2 ⟨hT', hne, (hXpt s).2⟩
    have hu := hNunitX _ hz.1.1 hzy
    exact (hirrq _ (hN hz.1.1) hq).2.not_isUnit hu

  let V₁ : X.Etale := wcEtOpen X U N'
  let c : V₁ ⟶ U := wcEtOpenι X U N'
  haveI : Etale V₁.hom := V₁.prop
  have hO1 : ⊤ ≤ V₁.hom ⁻¹ᵁ O := fun z _ => hN'W (by
    have : N'.ι z ∈ Set.range N'.ι := ⟨z, rfl⟩
    rwa [Scheme.Opens.range_ι] at this)
  let e : Γ(V₁.left, ⊤) := wcPull X V₁ O ⊤ hO1 a
  have hσe : IsUnit (wcGenSigma X V₁ ⊤ e) := hσu V₁ O ⊤ hO1 a ha0
  have he : IsUnit (wcGenRho X V₁ e) := hρu V₁ e hσe
  have hgermV : ∀ z' : V₁.left,
      (N'.ι z' = s₁ (IsLocalRing.closedPoint Ω) →
        Irreducible (V₁.left.presheaf.germ ⊤ z' trivial e)) ∧
      (N'.ι z' ≠ s₁ (IsLocalRing.closedPoint Ω) →
        IsUnit (V₁.left.presheaf.germ ⊤ z' trivial e)) := by
    intro z'
    have hz : N'.ι z' ∈ N' := by
      have : N'.ι z' ∈ Set.range N'.ι := ⟨z', rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    refine ⟨fun hzy => ?_, fun hzy => ?_⟩
    · rw [hgerm V₁ O ⊤ hO1 a z' trivial]
      obtain ⟨hdv, hirr⟩ := hirrq (V₁.hom z') (hO1 trivial)
        (show U.hom (N'.ι z') = U.hom (s₁ (IsLocalRing.closedPoint Ω)) by rw [hzy])
      exact (@wc_etale_stalk_dvr V₁.left X V₁.hom _ hXN z' hdv).2 _ hirr
    · rw [hgerm V₁ O ⊤ hO1 a z' trivial]
      exact IsUnit.map _ (hNunitX (N'.ι z') hz.1.1 hzy)
  let m : ℤ := d'.1 s₀
  let b : (Γ(wcGenPt X V₁, ⊤))ˣ := he.unit ^ m
  refine ⟨V₁, c, ?_, ?_⟩
  swap
  · show x ∈ Set.range N'.ι
    rw [Scheme.Opens.range_ι]
    exact Specializes.mem_open hxy N'.isOpen hyN'
  rw [Presheaf.imageSieve_apply]
  refine ⟨ULift.up (Additive.ofMul b), ?_⟩
  apply ULift.ext
  apply Subtype.ext
  funext s'

  have hu : ((he.unit : (Γ(wcGenPt X V₁, ⊤))ˣ) : Γ(wcGenPt X V₁, ⊤)) = wcGenRho X V₁ e :=
    he.unit_spec
  have hU : he.unit ^ m * he.unit ^ ((-m).toNat) = he.unit ^ (m.toNat) := by
    rw [← zpow_natCast, ← zpow_natCast, ← zpow_add]
    congr 1
    omega
  have hU' := congrArg (fun w : (Γ(wcGenPt X V₁, ⊤))ˣ =>
    wcGenRestr X V₁ ⊤ (w : Γ(wcGenPt X V₁, ⊤))) hU
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow, hu, hbridge] at hU'
  obtain ⟨hdz, hdvz⟩ := (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim V₁ s').1
  let z' := s'.1 (IsLocalRing.closedPoint Ω)
  let n : ℤ := if N'.ι z' = s₁ (IsLocalRing.closedPoint Ω) then m else 0
  have hgne : V₁.left.presheaf.germ ⊤ z' trivial e ≠ 0 := by
    by_cases hzy : N'.ι z' = s₁ (IsLocalRing.closedPoint Ω)
    · exact ((hgermV z').1 hzy).ne_zero
    · exact ((hgermV z').2 hzy).ne_zero
  have hrep : wcOrdRep X V₁ (b : Γ(wcGenPt X V₁, ⊤)) z' n := by
    refine ⟨⊤, trivial, e ^ ((-m).toNat), e ^ (m.toNat), ?_, ?_, ?_, ?_, ?_⟩
    · rw [map_pow]; exact hσe.pow _
    · rw [map_pow, map_pow, mul_comm]; exact hU'
    · rw [map_pow]; exact pow_ne_zero _ hgne
    · rw [map_pow]; exact pow_ne_zero _ hgne
    · rw [map_pow, map_pow]
      by_cases hzy : N'.ι z' = s₁ (IsLocalRing.closedPoint Ω)
      · have hirr := (hgermV z').1 hzy
        have h1 : ∀ k : ℕ, wcLocVal _ ((V₁.left.presheaf.germ ⊤ z' trivial e) ^ k) = k := by
          intro k
          have := @hval _ _ hdz hdvz _ 1 k hirr
          rwa [Units.val_one, one_mul] at this
        rw [h1, h1]
        simp only [n, if_pos hzy]
        omega
      · have hun := (hgermV z').2 hzy
        rw [hv0 _ _ (hun.pow _), hv0 _ _ (hun.pow _)]
        simp only [n, if_neg hzy]
        rfl
  have hL := hchar V₁ b s' n hrep
  have hR : (d'.1 (wcEtPtsMap Ω X fX c s')) = n := by
    have hpt : (wcEtPtsMap Ω X fX c s').1 (IsLocalRing.closedPoint Ω) = N'.ι z' := rfl
    have hmem : N'.ι z' ∈ N' := by
      have : N'.ι z' ∈ Set.range N'.ι := ⟨z', rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    by_cases hzy : N'.ι z' = s₁ (IsLocalRing.closedPoint Ω)
    · simp only [n, if_pos hzy]
      have hs : wcEtPtsMap Ω X fX c s' = s₀ := by
        apply Subtype.ext
        exact huniq U.left (U.hom ≫ fX) _ _ (wcEtPtsMap Ω X fX c s').2 hs₁ (hpt.trans hzy)
      rw [hs]
    · simp only [n, if_neg hzy]
      by_contra hd
      exact hzy (hpt.symm.trans (hsupp _ (hpt ▸ hmem) hd))
  exact hL.trans hR.symm

theorem wc_ord_kernel_local : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX]
    [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord →
    ∀ (U : X.Etale) (b : ToType ((wcEtGmAtPre X (genericPoint X)).obj (Opposite.op U))),
      ord.app (Opposite.op U) b = 0 →
      Presheaf.imageSieve (wcEtGmToAtPre X (genericPoint X)) b ∈ Scheme.smallEtaleTopology X U :=
by
  intro Ω _ _ X fX _ _ hnorm hdim ord hchar U b h0

  have hs1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
      ∀ r s : R, r ≠ 0 → s ≠ 0 → wcLocVal R r = wcLocVal R s → ∃ v : Rˣ, r = (v : R) * s := by
    intro R _ _ _ r s hr hs hrs
    have hval : ∀ (ϖ : R) (v : Rˣ) (n : ℕ), Irreducible ϖ → wcLocVal R ((v : R) * ϖ ^ n) = n := by
      intro ϖ v n hϖ
      classical
      unfold wcLocVal
      have hex : ∃ (n' : ℕ) (v' : Rˣ) (ϖ' : R), Irreducible ϖ' ∧
          (v : R) * ϖ ^ n = (v' : R) * ϖ' ^ n' := ⟨n, v, ϖ, hϖ, rfl⟩
      rw [dif_pos hex, Nat.find_eq_iff]
      refine ⟨⟨v, ϖ, hϖ, rfl⟩, fun m hm ⟨v', ϖ', hϖ', heq⟩ => ?_⟩
      have := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' v v' n m heq
      omega
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨i, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hϖ
    obtain ⟨k, u', rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
    rw [hval ϖ u i hϖ, hval ϖ u' k hϖ] at hrs
    subst hrs
    refine ⟨u * u'⁻¹, ?_⟩
    rw [Units.val_mul, mul_assoc, ← mul_assoc (u'⁻¹ : Rˣ).val, Units.inv_mul, one_mul]

  have hs2 : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType fY] (ξ : Y),
      ∃ s : Spec (.of Ω) ⟶ Y, s ≫ fY = 𝟙 _ ∧ ξ ⤳ s (IsLocalRing.closedPoint Ω) := by
    intro Y fY _ ξ
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace fY
    obtain ⟨y, hyξ, hyc⟩ := nonempty_inter_closedPoints (Z := closure ({ξ} : Set Y))
      ⟨ξ, subset_closure rfl⟩ isClosed_closure.isLocallyClosed
    have hxy : ξ ⤳ y := specializes_iff_mem_closure.mpr hyξ
    have hyc' : IsClosed ({y} : Set Y) := hyc
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hyc'
    let ψ : CommRingCat.of Ω ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ fY)
    have hψ : Spec.map ψ = Y.fromSpecResidueField y ≫ fY := Spec.map_preimage _
    have hft : ψ.hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map ψ) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    letI : Algebra Ω (Y.residueField y) := ψ.hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    have hsurj : Function.Surjective ψ.hom := by
      intro s
      have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
      exact ⟨c, hc⟩
    let e : Ω ≃+* Y.residueField y := RingEquiv.ofBijective ψ.hom ⟨ψ.hom.injective, hsurj⟩
    refine ⟨Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
      Y.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hψ, ← Spec.map_comp, ← Spec.map_id]
      congr 1
      ext c
      change e.symm (ψ.hom c) = c
      exact e.symm_apply_apply c
    · have h1 : (Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
          Y.fromSpecResidueField y) (IsLocalRing.closedPoint Ω) = y :=
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
      rw [h1]
      exact hxy

  have hs5 : ∀ (β : Γ(wcGenPt X U, ⊤)) (W : U.left.Opens) (g h : Γ(U.left, W)) (y : U.left)
      (hy : y ∈ W) (v : (U.left.presheaf.stalk y)ˣ), IsUnit (wcGenSigma X U W g) →
      wcGenSigma X U W g * wcGenRestr X U W β = wcGenSigma X U W h →
      U.left.presheaf.germ W y hy h = (v : U.left.presheaf.stalk y) * U.left.presheaf.germ W y hy g →
      ∃ (N : U.left.Opens) (e : Γ(U.left, N)), y ∈ N ∧ IsUnit e ∧
        wcGenSigma X U N e = wcGenRestr X U N β := by
    intro β W g h y hy v hσg heq hgerm
    obtain ⟨N₁, hyN₁, u₀, hu₀⟩ :=
      TopCat.Presheaf.exists_germ_eq U.left.presheaf (v : U.left.presheaf.stalk y)
    have hyN₂ : y ∈ U.left.basicOpen u₀ :=
      (U.left.mem_basicOpen u₀ y hyN₁).mpr (by rw [hu₀]; exact v.isUnit)
    have hN₂N₁ : U.left.basicOpen u₀ ≤ N₁ := U.left.basicOpen_le u₀
    let M : U.left.Opens := U.left.basicOpen u₀ ⊓ W
    have hyM : y ∈ M := ⟨hyN₂, hy⟩
    let iM1 : M ⟶ N₁ := homOfLE (inf_le_left.trans hN₂N₁)
    let iM2 : M ⟶ W := homOfLE inf_le_right
    let A : Γ(U.left, M) := U.left.presheaf.map iM1.op u₀ * U.left.presheaf.map iM2.op g
    let B : Γ(U.left, M) := U.left.presheaf.map iM2.op h
    have hAB : U.left.presheaf.germ M y hyM A = U.left.presheaf.germ M y hyM B := by
      simp only [A, B, map_mul, TopCat.Presheaf.germ_res_apply]
      rw [hu₀, hgerm]
    obtain ⟨N, hyN, iU, iV, hUV⟩ := TopCat.Presheaf.germ_eq U.left.presheaf y hyM hyM A B hAB
    have hiUV : iU = iV := Subsingleton.elim _ _
    subst hiUV
    let e : Γ(U.left, N) := U.left.presheaf.map (iU ≫ iM1).op u₀
    have he : IsUnit e := by
      have h1 : e = U.left.presheaf.map
          (homOfLE (show N ≤ U.left.basicOpen u₀ from fun z hz => (iU.le hz).1)).op
          (U.left.presheaf.map (homOfLE hN₂N₁).op u₀) := by
        simp only [e]
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]
        rfl
      rw [h1]
      exact (RingedSpace.isUnit_res_basicOpen _ u₀).map _
    have hstar : e * U.left.presheaf.map (iU ≫ iM2).op g =
        U.left.presheaf.map (iU ≫ iM2).op h := by
      have := hUV
      simp only [A, B, map_mul] at this
      simp only [e, op_comp, Functor.map_comp, CommRingCat.comp_apply]
      exact this
    have hnat : ∀ (f : Γ(U.left, W)), wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op f) =
        (wcGenPt X U).presheaf.map (homOfLE ((Limits.pullback.fst U.hom
          (X.fromSpecStalk (genericPoint X))).preimage_mono (iU ≫ iM2).le)).op
          (wcGenSigma X U W f) := by
      intro f
      simp only [wcGenSigma]
      have := Scheme.Hom.naturality (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)))
        (iU ≫ iM2).op
      have := congrArg (fun φ => φ.hom f) this
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    have hres : wcGenRestr X U N β =
        (wcGenPt X U).presheaf.map (homOfLE ((Limits.pullback.fst U.hom
          (X.fromSpecStalk (genericPoint X))).preimage_mono (iU ≫ iM2).le)).op
          (wcGenRestr X U W β) := by
      simp only [wcGenRestr]
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    refine ⟨N, e, hyN, he, ?_⟩
    have hu : IsUnit (wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op g)) := by
      rw [hnat]; exact hσg.map _
    have key : wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op h) =
        wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op g) * wcGenRestr X U N β := by
      rw [hres, hnat, hnat, ← map_mul, heq]
    apply hu.mul_left_cancel
    rw [← key, ← hstar, map_mul, mul_comm]

  have hs3 : ∀ (W : U.left.Opens) (e : Γ(U.left, W)) (b : Γ(wcGenPt X U, ⊤)),
      wcGenSigma X U W e = wcGenRestr X U W b →
      wcGenRho X (wcEtOpen X U W) (W.topIso.inv e) = wcGenMap X (wcEtOpenι X U W) b := by
    intro W e b hσ
    have appLE_eq : ∀ {A B : Scheme.{u}} (f g : A ⟶ B), f = g → ∀ (P : B.Opens) (Q : A.Opens)
        (h1 : Q ≤ f ⁻¹ᵁ P) (h2 : Q ≤ g ⁻¹ᵁ P), f.appLE P Q h1 = g.appLE P Q h2 := by
      intro A B f g hfg P Q h1 h2; subst hfg; rfl
    have appTop_eq : ∀ {A B : Scheme.{u}} (f : A ⟶ B), f.appTop = f.appLE ⊤ ⊤ le_top := by
      intro A B f; rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]; rfl
    let j := X.fromSpecStalk (genericPoint X)
    let fst := Limits.pullback.fst U.hom j
    let fst₁ := Limits.pullback.fst (wcEtOpen X U W).hom j
    let ιK := (Scheme.Etale.forget X ⋙ Over.pullback j ⋙ Over.forget _).map (wcEtOpenι X U W)
    have hcomm : ιK ≫ fst = fst₁ ≫ W.ι := by
      simp only [ιK, fst, fst₁, Functor.comp_map, Over.forget_map, Over.pullback_map_left]
      exact Limits.pullback.lift_fst _ _ _
    have hrho : ∀ z, wcGenRho X (wcEtOpen X U W) z = fst₁.appTop.hom z := by
      intro z
      (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
    have hmap : ∀ z, wcGenMap X (wcEtOpenι X U W) z = ιK.appTop.hom z := by
      intro z
      (simp [wcGenMap, Scheme.Γ_map]) <;> rfl
    have htop : W.topIso.inv = W.ι.appLE W ⊤ (by rw [Scheme.Opens.ι_preimage_self]) := by
      rw [Scheme.Opens.topIso_inv, Scheme.Opens.ι_appLE]; rfl
    have hle : (⊤ : (wcGenPt X (wcEtOpen X U W)).Opens) ≤ ιK ⁻¹ᵁ (fst ⁻¹ᵁ W) := by
      intro p _
      change fst (ιK p) ∈ W
      have h1 : fst (ιK p) = W.ι (fst₁ p) :=
        (Scheme.Hom.comp_apply ιK fst p).symm.trans
          ((congrArg (fun φ => φ p) hcomm).trans (Scheme.Hom.comp_apply fst₁ W.ι p))
      rw [h1]
      have h2 : W.ι (fst₁ p) ∈ Set.range W.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at h2
    have h0' : (⊤ : (wcGenPt X (wcEtOpen X U W)).Opens) ≤ (fst₁ ≫ W.ι) ⁻¹ᵁ W := hcomm ▸ hle
    have LHSmor : W.topIso.inv ≫ fst₁.appTop = (fst₁ ≫ W.ι).appLE W ⊤ h0' := by
      rw [htop, appTop_eq]
      exact Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
    have RHSmor : (wcGenPt X U).presheaf.map (homOfLE le_top).op ≫ ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle =
        ιK.appTop :=
      (Scheme.Hom.map_appLE ιK hle _).trans (appTop_eq ιK).symm
    have mid : fst.app W ≫ ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle = (ιK ≫ fst).appLE W ⊤ hle := by
      rw [Scheme.Hom.app_eq_appLE]
      exact Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
    have E1 : fst₁.appTop.hom (W.topIso.inv.hom e) = ((fst₁ ≫ W.ι).appLE W ⊤ h0').hom e := by
      have := congrArg (fun φ => CommRingCat.Hom.hom φ e) LHSmor
      exact this
    have E2 : (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom ((fst.app W).hom e) =
        ((ιK ≫ fst).appLE W ⊤ hle).hom e := by
      have := congrArg (fun φ => CommRingCat.Hom.hom φ e) mid
      exact this
    have E3 : (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom
        (((wcGenPt X U).presheaf.map (homOfLE le_top).op).hom b) = ιK.appTop.hom b := by
      have := congrArg (fun φ => CommRingCat.Hom.hom φ b) RHSmor
      exact this
    have E4 : ((ιK ≫ fst).appLE W ⊤ hle).hom e = ((fst₁ ≫ W.ι).appLE W ⊤ h0').hom e :=
      congrArg (fun φ => CommRingCat.Hom.hom φ e) (appLE_eq _ _ hcomm W ⊤ hle h0')
    refine (hrho _).trans (Eq.trans ?_ (hmap b).symm)
    have E5 : (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom ((fst.app W).hom e) =
        (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom
          (((wcGenPt X U).presheaf.map (homOfLE le_top).op).hom b) :=
      congrArg (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom hσ
    exact E1.trans (E4.symm.trans (E2.symm.trans (E5.trans E3)))

  let β : (Γ(wcGenPt X U, ⊤))ˣ := Additive.toMul b.down
  have hloc : ∀ x : U.left, ∃ (N : U.left.Opens) (a : (Γ((wcEtOpen X U N).left, ⊤))ˣ), x ∈ N ∧
      wcGenRho X (wcEtOpen X U N) (a : Γ((wcEtOpen X U N).left, ⊤)) =
        wcGenMap X (wcEtOpenι X U N) (β : Γ(wcGenPt X U, ⊤)) := by
    intro x
    haveI : Etale U.hom := U.prop
    obtain ⟨s₁, hs₁, hxy⟩ := hs2 U.left (U.hom ≫ fX) x
    let s : wcEtPts Ω X fX U := ⟨s₁, hs₁⟩
    obtain ⟨n, W, hyW, g, h, hσg, heq, hg0, hh0, hn⟩ :=
      wc_ord_rep_exists X U β (s₁ (IsLocalRing.closedPoint Ω))
    have hc := hchar U β s n ⟨W, hyW, g, h, hσg, heq, hg0, hh0, hn⟩
    have h0' : ord.app (Opposite.op U) (ULift.up (Additive.ofMul β)) = 0 := h0
    have hz : ((ord.app (Opposite.op U) (ULift.up (Additive.ofMul β))).down).1 s = 0 := by
      rw [h0']; rfl
    have hn0 : n = 0 := hc.symm.trans hz
    have hval : wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW h) =
        wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW g) := by
      have : (wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW h) : ℤ) =
          wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW g) := by
        omega
      exact_mod_cast this
    obtain ⟨hdom, hdvr⟩ := (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim U s).1
    obtain ⟨v₀, hv₀⟩ := @hs1 _ _ hdom hdvr _ _ hh0 hg0 hval
    obtain ⟨N, e, hyN, he, hσe⟩ := hs5 (β : Γ(wcGenPt X U, ⊤)) W g h _ hyW v₀ hσg heq hv₀
    obtain ⟨a, ha⟩ := he.map (N.topIso.inv).hom
    refine ⟨N, a, Specializes.mem_open hxy N.isOpen hyN, ?_⟩
    exact (congrArg (wcGenRho X (wcEtOpen X U N)) ha).trans (hs3 N e β hσe)

  apply wc_etale_jointly_surjective_covers X U
  intro v
  obtain ⟨N, a, hvN, hEq⟩ := hloc v
  refine ⟨wcEtOpen X U N, wcEtOpenι X U N, ?_, ?_⟩
  · rw [Presheaf.imageSieve_apply]
    refine ⟨ULift.up (Additive.ofMul a), ?_⟩
    change ULift.up (Additive.ofMul (Units.map (wcGenRho X (wcEtOpen X U N)).toMonoidHom a)) =
      ULift.up (Additive.ofMul (Units.map (wcGenMap X (wcEtOpenι X U N)).toMonoidHom β))
    congr 2
    apply Units.ext
    simp only [Units.coe_map]
    exact hEq
  · show v ∈ Set.range N.ι
    rw [Scheme.Opens.range_ι]
    exact hvN

theorem wc_et_divisor_ord_exact : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX]
    [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∃ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX,
      wcEtGmToAtPre X (genericPoint X) ≫ ord = 0 ∧
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) ord ∧
      ∀ (U : X.Etale) (b : ToType ((wcEtGmAtPre X (genericPoint X)).obj (Opposite.op U))),
        ord.app (Opposite.op U) b = 0 →
        Presheaf.imageSieve (wcEtGmToAtPre X (genericPoint X)) b ∈ Scheme.smallEtaleTopology X U :=
by
  intro Ω _ _ X fX _ _ hnorm hdim
  obtain ⟨ord, hchar⟩ := wc_ord_construct Ω X fX hnorm hdim

  have hv0 : ∀ (R : Type u) [CommRing R] (r : R), IsUnit r → wcLocVal R r = 0 := by
    intro R _ r hr
    classical
    unfold wcLocVal
    split_ifs with h
    · rw [Nat.find_eq_zero]
      obtain ⟨n, w, ϖ, hϖ, _⟩ := h
      exact ⟨hr.unit, ϖ, hϖ, by simp⟩
    · rfl

  have hbridge : ∀ (U : X.Etale) (e : Γ(U.left, ⊤)),
      wcGenRestr X U ⊤ (wcGenRho X U e) = wcGenSigma X U ⊤ e := by
    intro U e
    have h1 : wcGenRho X U e =
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).appTop.hom e := by
      (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
    rw [h1]
    unfold wcGenRestr wcGenSigma
    have h2 : (homOfLE le_top : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤ ⟶
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤) = 𝟙 _ :=
      Subsingleton.elim _ _
    erw [h2, op_id, CategoryTheory.Functor.map_id]
    rfl

  have hK : wcEtGmToAtPre X (genericPoint X) ≫ ord = 0 := by
    apply NatTrans.ext
    funext U
    induction U using Opposite.rec with
    | op U =>
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro a
    let a' : (Γ(U.left, ⊤))ˣ := Additive.toMul a.down
    let b : (Γ(wcGenPt X U, ⊤))ˣ := Units.map (wcGenRho X U).toMonoidHom a'
    have hb : (b : Γ(wcGenPt X U, ⊤)) = wcGenRho X U (a' : Γ(U.left, ⊤)) := rfl
    change ord.app (Opposite.op U) (ULift.up (Additive.ofMul b)) = 0
    apply ULift.ext
    apply Subtype.ext
    funext s
    change ((ord.app (Opposite.op U) (ULift.up (Additive.ofMul b))).down).1 s = (0 : ℤ)
    apply hchar U b s 0
    have hu : IsUnit (U.left.presheaf.germ ⊤ (s.1 (IsLocalRing.closedPoint Ω)) trivial
        (a' : Γ(U.left, ⊤))) :=
      a'.isUnit.map (U.left.presheaf.germ ⊤ (s.1 (IsLocalRing.closedPoint Ω)) trivial).hom
    refine ⟨⊤, trivial, 1, (a' : Γ(U.left, ⊤)), ?_, ?_, ?_, ?_, ?_⟩
    · rw [map_one]; exact isUnit_one
    · rw [map_one, one_mul, hb, hbridge]
    · rw [map_one]; exact one_ne_zero
    · exact hu.ne_zero
    · rw [hv0 _ _ hu, map_one, hv0 _ _ isUnit_one]
      rfl
  exact ⟨ord, hK, wc_ord_locally_surjective Ω X fX hnorm hdim ord hchar,
    wc_ord_kernel_local Ω X fX hnorm hdim ord hchar⟩

theorem wc_et_div_cech_acyclic : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (U : X.Etale) (k : ℕ)
    (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
    (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      CompactSpace (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left) →
    (∀ s : wcEtPts Ω X fX U, ∃ (i : Fin k) (t : wcEtPts Ω X fX (V i)), wcEtPtsMap Ω X fX (f i) t = s) →
    wcCechAcyclic (wcEtDivPre Ω X fX) V f :=
by
  intro Ω _ X fX U k V f hcpt hsurj
  classical

  have s1 : ∀ {A B : Type u} (α : A → B) (ch : B → A), (∀ b, α (ch b) = b) →
      ∀ (p : ℕ) (g : (Fin (p + 2) → A) → ℤ),
      (∀ y : Fin (p + 3) → A, (∀ l, α (y l) = α (y 0)) →
        ∑ j : Fin (p + 3), (-1 : ℤ) ^ (j : ℕ) * g (fun l => y (j.succAbove l)) = 0) →
      ∀ x : Fin (p + 2) → A, (∀ l, α (x l) = α (x 0)) →
        g x = ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) *
          g (Fin.cons (ch (α (x 0))) (fun l => x (j.succAbove l)) : Fin (p + 2) → A) := by
    intro A B α ch hch p g hg x hx
    set a := ch (α (x 0)) with ha
    have hy : ∀ l, α ((Fin.cons a x : Fin (p + 3) → A) l) =
        α ((Fin.cons a x : Fin (p + 3) → A) 0) := by
      intro l
      refine Fin.cases ?_ (fun m => ?_) l
      · rfl
      · simp only [Fin.cons_succ, Fin.cons_zero]
        rw [ha, hch]; exact hx m
    have h := hg _ hy
    rw [Fin.sum_univ_succ] at h
    have e0 : (fun l => (Fin.cons a x : Fin (p + 3) → A) ((0 : Fin (p + 3)).succAbove l)) = x := by
      funext l; simp
    have e1 : ∀ j' : Fin (p + 2),
        (fun l => (Fin.cons a x : Fin (p + 3) → A) (j'.succ.succAbove l)) =
        (Fin.cons a (fun l => x (j'.succAbove l)) : Fin (p + 2) → A) := by
      intro j'
      funext l
      refine Fin.cases ?_ (fun m => ?_) l
      · simp
      · simp [Fin.succ_succAbove_succ]
    rw [e0] at h
    simp only [e1, Fin.val_zero, pow_zero, one_mul, Fin.val_succ, pow_succ] at h
    have h2 : ∑ x_1 : Fin (p + 2), (-1 : ℤ) ^ (x_1 : ℕ) * -1 *
          g (Fin.cons a fun l => x (x_1.succAbove l))
        = - ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) * g (Fin.cons a (fun l => x (j.succAbove l))) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun j _ => by ring)
    rw [h2] at h
    linarith

  have s2 : ∀ (n : ℕ) (W : Fin n → X.Etale) (g : ∀ l, W l ⟶ U) (u : wcEtPts Ω X fX U)
      (t : ∀ l, wcEtPts Ω X fX (W l)), (∀ l, wcEtPtsMap Ω X fX (g l) (t l) = u) →
      ∃ w : wcEtPts Ω X fX (Limits.widePullback U W g),
        wcEtPtsMap Ω X fX (Limits.WidePullback.base g) w = u ∧
        ∀ l, wcEtPtsMap Ω X fX (Limits.WidePullback.π g l) w = t l := by
    intro n W g u t h
    let F := Scheme.Etale.forget X ⋙ Over.forget X
    have hL := Limits.isLimitOfPreserves F
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan U W g))
    let c : Limits.Cone (Limits.WidePullbackShape.wideCospan U W g ⋙ F) :=
      Limits.WidePullbackShape.mkCone (F := Limits.WidePullbackShape.wideCospan U W g ⋙ F)
        (X := Spec (.of Ω)) u.1 (fun l => (t l).1) (fun l => congrArg Subtype.val (h l))
    have hb : hL.lift c ≫ (Limits.WidePullback.base g).left = u.1 := hL.fac c none
    have hp : ∀ l, hL.lift c ≫ (Limits.WidePullback.π g l).left = (t l).1 :=
      fun l => hL.fac c (some l)
    refine ⟨⟨hL.lift c, ?_⟩, Subtype.ext hb, fun l => Subtype.ext (hp l)⟩
    have hw : (Limits.WidePullback.base g).left ≫ U.hom = (Limits.widePullback U W g).hom :=
      MorphismProperty.Over.w _
    have e1 : hL.lift c ≫ (Limits.widePullback U W g).hom = u.1 ≫ U.hom :=
      (congrArg (hL.lift c ≫ ·) hw.symm).trans
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.hom) hb))
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ fX) e1).trans
      ((Category.assoc _ _ _).trans u.2))

  have s3 : ∀ (n : ℕ) (W : Fin n → X.Etale) (g : ∀ l, W l ⟶ U)
      (w w' : wcEtPts Ω X fX (Limits.widePullback U W g)),
      wcEtPtsMap Ω X fX (Limits.WidePullback.base g) w =
        wcEtPtsMap Ω X fX (Limits.WidePullback.base g) w' →
      (∀ l, wcEtPtsMap Ω X fX (Limits.WidePullback.π g l) w =
        wcEtPtsMap Ω X fX (Limits.WidePullback.π g l) w') → w = w' := by
    intro n W g w w' hb hp
    let F := Scheme.Etale.forget X ⋙ Over.forget X
    have hL := Limits.isLimitOfPreserves F
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan U W g))
    apply Subtype.ext
    apply hL.hom_ext
    intro j
    cases j with
    | none => exact congrArg Subtype.val hb
    | some l => exact congrArg Subtype.val (hp l)

  have s4 : ∀ (W : X.Etale), CompactSpace W.left → ∀ a ∈ wcEtDivSub Ω X fX W,
      ∃ T : Set X, T.Finite ∧
        ∀ s : wcEtPts Ω X fX W, a s ≠ 0 → (s.1 ≫ W.hom) (IsLocalRing.closedPoint Ω) ∈ T := by
    intro W hW a ha
    choose O hO hxO T hT hsupp using ha
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover O hO
      (fun x _ => Set.mem_iUnion.2 ⟨x, hxO x⟩)
    refine ⟨⋃ x ∈ t, T x, Set.Finite.biUnion t.finite_toSet (fun x _ => hT x), fun s hs => ?_⟩
    have hmem := ht (Set.mem_univ (s.1 (IsLocalRing.closedPoint Ω)))
    simp only [Set.mem_iUnion] at hmem
    obtain ⟨x, hx, hxs⟩ := hmem
    exact Set.mem_biUnion hx (hsupp x s hs hxs)

  have s5 : ∀ (W : X.Etale) (m : ℕ) (Z : Fin m → X.Etale) (h : ∀ j, W ⟶ Z j)
      (a : ∀ j, (wcEtDivPre Ω X fX).obj (Opposite.op (Z j))) (n : Fin m → ℤ)
      (t : wcEtPts Ω X fX W),
      (∑ j, n j • (wcEtDivPre Ω X fX).map (h j).op (a j)).down.1 t =
        ∑ j, n j * (a j).down.1 (wcEtPtsMap Ω X fX (h j) t) := by
    intro W m Z h a n t
    let ev : (wcEtDivPre Ω X fX).obj (Opposite.op W) →+ ℤ :=
      (Pi.evalAddMonoidHom (fun _ => ℤ) t).comp
        ((wcEtDivSub Ω X fX W).subtype.comp (AddEquiv.ulift).toAddMonoidHom)
    have hev : ∀ z, ev z = z.down.1 t := fun z => rfl
    rw [← hev, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, smul_eq_mul]
    rfl

  have s6 : ∀ (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2))
      (t : wcEtPts Ω X fX (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)))),
      wcEtPtsMap Ω X fX (Limits.WidePullback.base (fun l => f (τ (j.succAbove l))))
          (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t) =
        wcEtPtsMap Ω X fX (Limits.WidePullback.base (fun l => f (τ l))) t ∧
      ∀ l : Fin (p + 1),
        wcEtPtsMap Ω X fX (Limits.WidePullback.π (fun l => f (τ (j.succAbove l))) l)
          (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t) =
        wcEtPtsMap Ω X fX (Limits.WidePullback.π (fun l => f (τ l)) (j.succAbove l)) t := by
    intro p τ j t
    constructor
    · apply Subtype.ext
      have e : wcCechFace V f τ j ≫ Limits.WidePullback.base (fun l => f (τ (j.succAbove l))) =
          Limits.WidePullback.base (fun l => f (τ l)) :=
        Limits.WidePullback.lift_base _ _ _ _
      change t.1 ≫ (wcCechFace V f τ j).left ≫ _ = t.1 ≫ _
      rw [← e]; rfl
    · intro l
      apply Subtype.ext
      have e : wcCechFace V f τ j ≫ Limits.WidePullback.π (fun l => f (τ (j.succAbove l))) l =
          Limits.WidePullback.π (fun l => f (τ l)) (j.succAbove l) :=
        Limits.WidePullback.lift_π _ _ _ _ _
      change t.1 ≫ (wcCechFace V f τ j).left ≫ _ = t.1 ≫ _
      rw [← e]; rfl

  have s7a : ∀ (n : ℕ) (W : Fin n → X.Etale) (g : ∀ l, W l ⟶ U)
      (w : wcEtPts Ω X fX (Limits.widePullback U W g)) (l : Fin n),
      wcEtPtsMap Ω X fX (g l) (wcEtPtsMap Ω X fX (Limits.WidePullback.π g l) w) =
        wcEtPtsMap Ω X fX (Limits.WidePullback.base g) w := by
    intro n W g w l
    apply Subtype.ext
    change (w.1 ≫ (Limits.WidePullback.π g l).left) ≫ (g l).left = w.1 ≫ _
    rw [← Limits.WidePullback.π_arrow g l, Category.assoc]; rfl

  have s7b : ∀ {W' W : X.Etale} (h : W' ⟶ W) (t : wcEtPts Ω X fX W'),
      (wcEtPtsMap Ω X fX h t).1 ≫ W.hom = t.1 ≫ W'.hom := by
    intro W' W h t
    change (t.1 ≫ h.left) ≫ W.hom = _
    rw [Category.assoc, MorphismProperty.Over.w h]

  intro p c hc
  let A := Σ i : Fin k, wcEtPts Ω X fX (V i)
  let α : A → wcEtPts Ω X fX U := fun a => wcEtPtsMap Ω X fX (f a.1) a.2
  have hα : Function.Surjective α := fun s => by
    obtain ⟨i, t, h⟩ := hsurj s
    exact ⟨⟨i, t⟩, h⟩
  obtain ⟨ch, hch⟩ : ∃ ch : wcEtPts Ω X fX U → A, ∀ b, α (ch b) = b :=
    ⟨Function.surjInv hα, Function.surjInv_eq hα⟩
  have hLift : ∀ (n : ℕ) (x : Fin (n + 1) → A), (∀ l, α (x l) = α (x 0)) →
      ∃ w : wcEtPts Ω X fX (Limits.widePullback U (fun l => V (x l).1) (fun l => f (x l).1)),
        wcEtPtsMap Ω X fX (Limits.WidePullback.base (fun l => f (x l).1)) w = α (x 0) ∧
        ∀ l, wcEtPtsMap Ω X fX (Limits.WidePullback.π (fun l => f (x l).1) l) w = (x l).2 :=
    fun n x hx => s2 (n + 1) (fun l => V (x l).1) (fun l => f (x l).1) (α (x 0))
      (fun l => (x l).2) hx
  choose Lift hL1 hL2 using hLift
  obtain ⟨g, hgpos, hgneg⟩ : ∃ g : (Fin (p + 2) → A) → ℤ,
      (∀ x (hx : ∀ l, α (x l) = α (x 0)),
        g x = (c (fun l => (x l).1)).down.1 (Lift (p + 1) x hx)) ∧
      (∀ x, ¬ (∀ l, α (x l) = α (x 0)) → g x = 0) :=
    ⟨fun x => if hx : (∀ l, α (x l) = α (x 0)) then
        (c (fun l => (x l).1)).down.1 (Lift (p + 1) x hx) else 0,
      fun x hx => dif_pos hx, fun x hx => dif_neg hx⟩

  have hgc : ∀ y : Fin (p + 3) → A, (∀ l, α (y l) = α (y 0)) →
      ∑ j : Fin (p + 3), (-1 : ℤ) ^ (j : ℕ) * g (fun l => y (j.succAbove l)) = 0 := by
    intro y hy
    have h0 : (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        (wcEtDivPre Ω X fX).map (wcCechFace V f (fun l => (y l).1) j).op
          (c (fun l => (y (j.succAbove l)).1))).down.1 (Lift (p + 2) y hy) = 0 := by
      rw [hc (fun l => (y l).1)]; rfl
    have h1 := (s5 _ (p + 3)
      (fun j => Limits.widePullback U (fun l => V (y (j.succAbove l)).1)
        (fun l => f (y (j.succAbove l)).1))
      (fun j => wcCechFace V f (fun l => (y l).1) j)
      (fun j => c (fun l => (y (j.succAbove l)).1)) (fun j => (-1 : ℤ) ^ (j : ℕ))
      (Lift (p + 2) y hy)).symm.trans h0
    refine Eq.trans (Finset.sum_congr rfl fun j _ => ?_) h1
    have hcj : ∀ l, α (y (j.succAbove l)) = α (y (j.succAbove 0)) :=
      fun l => (hy _).trans (hy _).symm
    have hj : g (fun l => y (j.succAbove l)) = (c (fun l => (y (j.succAbove l)).1)).down.1
        (wcEtPtsMap Ω X fX (wcCechFace V f (fun l => (y l).1) j) (Lift (p + 2) y hy)) := by
      rw [hgpos _ hcj]
      exact congrArg (fun s => (c (fun l => (y (j.succAbove l)).1)).down.1 s)
        (s3 (p + 2) (fun l => V (y (j.succAbove l)).1) (fun l => f (y (j.succAbove l)).1)
          (Lift (p + 1) (fun l => y (j.succAbove l)) hcj)
          (wcEtPtsMap Ω X fX (wcCechFace V f (fun l => (y l).1) j) (Lift (p + 2) y hy))
          ((hL1 _ _ hcj).trans ((hy (j.succAbove 0)).trans ((hL1 _ _ hy).symm.trans
            (s6 (p + 1) (fun l => (y l).1) j (Lift (p + 2) y hy)).1.symm)))
          (fun l => (hL2 _ _ hcj l).trans ((hL2 _ _ hy (j.succAbove l)).symm.trans
            ((s6 (p + 1) (fun l => (y l).1) j (Lift (p + 2) y hy)).2 l).symm)))
    exact congrArg (fun z => (-1 : ℤ) ^ (j : ℕ) * z) hj

  let xt : ∀ (n : ℕ) (σ : Fin (n + 1) → Fin k),
      wcEtPts Ω X fX (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))) →
        Fin (n + 1) → A :=
    fun n σ t l => ⟨σ l, wcEtPtsMap Ω X fX (Limits.WidePullback.π (fun l => f (σ l)) l) t⟩
  have hxt : ∀ (n : ℕ) (σ : Fin (n + 1) → Fin k)
      (t : wcEtPts Ω X fX (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))
      (l : Fin (n + 1)),
      α (xt n σ t l) = wcEtPtsMap Ω X fX (Limits.WidePullback.base (fun l => f (σ l))) t :=
    fun n σ t l => s7a (n + 1) (fun l => V (σ l)) (fun l => f (σ l)) t l
  let bv : ∀ σ : Fin (p + 1) → Fin k,
      wcEtPts Ω X fX (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))) → ℤ :=
    fun σ t => g (Fin.cons (ch (α (xt p σ t 0))) (xt p σ t))
  have hT : ∀ ρ : Fin (p + 2) → Fin k, ∃ T : Set X, T.Finite ∧
      ∀ s : wcEtPts Ω X fX (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l))),
        (c ρ).down.1 s ≠ 0 →
        (s.1 ≫ (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l))).hom)
          (IsLocalRing.closedPoint Ω) ∈ T :=
    fun ρ => s4 _ (hcpt (p + 1) ρ) _ (c ρ).down.2
  choose T hTf hTs using hT
  have hbmem : ∀ σ : Fin (p + 1) → Fin k, bv σ ∈ wcEtDivSub Ω X fX
      (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))) := by
    intro σ x
    refine ⟨Set.univ, isOpen_univ, Set.mem_univ _, ⋃ ρ, T ρ, Set.finite_iUnion hTf,
      fun t ht _ => ?_⟩
    by_cases hy : ∀ l, α ((Fin.cons (ch (α (xt p σ t 0))) (xt p σ t) : Fin (p + 2) → A) l) =
        α ((Fin.cons (ch (α (xt p σ t 0))) (xt p σ t) : Fin (p + 2) → A) 0)
    · have hne : (c (fun l => ((Fin.cons (ch (α (xt p σ t 0))) (xt p σ t) :
          Fin (p + 2) → A) l).1)).down.1 (Lift (p + 1) _ hy) ≠ 0 :=
        fun h => ht ((hgpos _ hy).trans h)
      have hm := hTs _ _ hne
      have e1 : α ((Fin.cons (ch (α (xt p σ t 0))) (xt p σ t) : Fin (p + 2) → A) 0) =
          wcEtPtsMap Ω X fX (Limits.WidePullback.base (fun l => f (σ l))) t :=
        (hch _).trans (hxt p σ t 0)
      have heq := (s7b (W := U) _ (Lift (p + 1) _ hy)).symm.trans
        ((congrArg (fun s => s.1 ≫ U.hom) ((hL1 (p + 1) _ hy).trans e1)).trans (s7b (W := U) _ t))
      refine Set.mem_iUnion.2 ⟨fun l => ((Fin.cons (ch (α (xt p σ t 0))) (xt p σ t) :
        Fin (p + 2) → A) l).1, ?_⟩
      rw [← heq]
      exact hm
    · exact absurd (hgneg _ hy) ht

  refine ⟨fun σ => ULift.up ⟨bv σ, hbmem σ⟩, fun τ => ?_⟩
  refine ULift.ext _ _ (Subtype.ext (funext fun t => ?_))
  have hcomp : ∀ l, α (xt (p + 1) τ t l) = α (xt (p + 1) τ t 0) :=
    fun l => (hxt (p + 1) τ t l).trans (hxt (p + 1) τ t 0).symm
  have hD : ∀ j : Fin (p + 2), bv (fun l => τ (j.succAbove l))
      (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t) =
      g (Fin.cons (ch (α (xt (p + 1) τ t 0))) (fun l => xt (p + 1) τ t (j.succAbove l))) := by
    intro j
    have htup : xt p (fun l => τ (j.succAbove l)) (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t) =
        fun l => xt (p + 1) τ t (j.succAbove l) :=
      funext fun l => congrArg (Sigma.mk (τ (j.succAbove l))) ((s6 p τ j t).2 l)
    have e : α (xt p (fun l => τ (j.succAbove l)) (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t) 0) =
        α (xt (p + 1) τ t 0) :=
      (hxt p _ _ 0).trans ((s6 p τ j t).1.trans (hxt (p + 1) τ t 0).symm)
    change g (Fin.cons (ch (α (xt p (fun l => τ (j.succAbove l))
      (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t) 0)))
      (xt p (fun l => τ (j.succAbove l)) (wcEtPtsMap Ω X fX (wcCechFace V f τ j) t))) = _
    rw [e, htup]
  have hLt : Lift (p + 1) (xt (p + 1) τ t) hcomp = t :=
    s3 (p + 2) (fun l => V (τ l)) (fun l => f (τ l)) _ t
      ((hL1 _ _ hcomp).trans (hxt (p + 1) τ t 0)) (fun l => hL2 _ _ hcomp l)
  have hgx : g (xt (p + 1) τ t) = (c τ).down.1 t :=
    (hgpos _ hcomp).trans (congrArg (fun s => (c τ).down.1 s) hLt)
  have hsum : ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) *
      g (Fin.cons (ch (α (xt (p + 1) τ t 0))) (fun l => xt (p + 1) τ t (j.succAbove l))) =
      (c τ).down.1 t :=
    (s1 α ch hch p g hgc (xt (p + 1) τ t) hcomp).symm.trans hgx
  have hs5 := s5 _ (p + 2) _ (fun j => wcCechFace V f τ j)
    (fun j => ULift.up ⟨bv (fun l => τ (j.succAbove l)), hbmem _⟩)
    (fun j => (-1 : ℤ) ^ (j : ℕ)) t
  refine hs5.trans (Eq.trans ?_ hsum)
  refine Finset.sum_congr rfl fun (j : Fin (p + 2)) _ => ?_
  exact congrArg (fun z => (-1 : ℤ) ^ (j : ℕ) * z) (hD j)

theorem wc_etale_lift_alg_closed_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
    (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
    ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v :=
by
  intro Ω _ _ V U g _ s v hv
  have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
      U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
    rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
  have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
  generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
  obtain ⟨u, φ⟩ := p
  simp only at hs h1
  rw [← h1] at hv
  subst hv
  letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
  haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
  haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
    Algebra.IsSeparable.isAlgebraic _ _
  letI : Algebra (U.residueField (g v)) Ω := φ.hom.toAlgebra
  let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
    IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
  let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
  have hχ : g.residueFieldMap v ≫ χ = φ := by
    ext r
    exact χ₀.commutes r
  have key : ∀ x : Spec (.of Ω), (Spec.map χ ≫ V.fromSpecResidueField v) x = v := by
    intro x
    rw [Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply _ _
  refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_, key _⟩
  rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
    ← Category.assoc, ← Spec.map_comp, hχ, hs]

theorem wc_et_div_isSheaf : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)),
    Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX) :=
by
  intro Ω _ _ X fX
  rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX)
    (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
  intro U S hS x hx

  have hSurj : ∀ y : U.left, ∃ (Y : X.Etale) (g : Y ⟶ U) (w : Y.left),
      S.arrows g ∧ g.left w = y := by
    change S ∈ Scheme.smallGrothendieckTopology @Etale X U at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    intro y
    obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS y
    exact ⟨Y, g, w, hg, hw⟩

  have hLift : ∀ {Y : X.Etale} (g : Y ⟶ U) (s : wcEtPts Ω X fX U) (w : Y.left),
      g.left w = s.1 (IsLocalRing.closedPoint Ω) →
      ∃ t : wcEtPts Ω X fX Y, wcEtPtsMap Ω X fX g t = s ∧
        t.1 (IsLocalRing.closedPoint Ω) = w := by
    intro Y g s w hw
    obtain ⟨t', ht', hpt⟩ := wc_etale_lift_alg_closed_point Ω g.left s.1 w hw
    have hsec : t' ≫ Y.hom ≫ fX = 𝟙 _ := by
      rw [← MorphismProperty.Over.w g]
      simp only [Category.assoc]
      rw [← Category.assoc t' g.left, ht']
      exact s.2
    exact ⟨⟨t', hsec⟩, Subtype.ext ht', hpt⟩

  have hPB : ∀ {Y Y' : X.Etale} (f : Y ⟶ U) (f' : Y' ⟶ U) (t : wcEtPts Ω X fX Y)
      (t' : wcEtPts Ω X fX Y'), wcEtPtsMap Ω X fX f t = wcEtPtsMap Ω X fX f' t' →
      ∃ (P : X.Etale) (p₁ : P ⟶ Y) (p₂ : P ⟶ Y') (p : wcEtPts Ω X fX P),
        p₁ ≫ f = p₂ ≫ f' ∧ wcEtPtsMap Ω X fX p₁ p = t ∧ wcEtPtsMap Ω X fX p₂ p = t' := by
    intro Y Y' f f' t t' e
    have e' : t.1 ≫ f.left = t'.1 ≫ f'.left := congrArg Subtype.val e
    haveI hEt : Etale (Limits.pullback.fst f.left f'.left ≫ Y.hom) := by
      haveI : Etale Y.hom := Y.prop
      infer_instance
    let P : X.Etale :=
      MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f.left f'.left ≫ Y.hom) hEt
    have hw : Limits.pullback.snd f.left f'.left ≫ Y'.hom =
        Limits.pullback.fst f.left f'.left ≫ Y.hom := by
      rw [← MorphismProperty.Over.w f, ← MorphismProperty.Over.w f', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let p₁ : P ⟶ Y := MorphismProperty.Over.homMk (Limits.pullback.fst f.left f'.left) rfl trivial
    let p₂ : P ⟶ Y' := MorphismProperty.Over.homMk (Limits.pullback.snd f.left f'.left) hw trivial
    have hsec : Limits.pullback.lift t.1 t'.1 e' ≫ P.hom ≫ fX = 𝟙 _ := by
      change Limits.pullback.lift t.1 t'.1 e' ≫ (Limits.pullback.fst f.left f'.left ≫ Y.hom) ≫ fX
        = 𝟙 _
      rw [Category.assoc, ← Category.assoc (Limits.pullback.lift _ _ _), Limits.pullback.lift_fst]
      exact t.2
    refine ⟨P, p₁, p₂, ⟨_, hsec⟩, ?_, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst f.left f'.left ≫ f.left =
        Limits.pullback.snd f.left f'.left ≫ f'.left
      exact Limits.pullback.condition
    · apply Subtype.ext
      change Limits.pullback.lift t.1 t'.1 e' ≫ Limits.pullback.fst f.left f'.left = t.1
      exact Limits.pullback.lift_fst _ _ _
    · apply Subtype.ext
      change Limits.pullback.lift t.1 t'.1 e' ≫ Limits.pullback.snd f.left f'.left = t'.1
      exact Limits.pullback.lift_snd _ _ _

  have hComp : ∀ {Y₁ Y₂ : X.Etale} (g₁ : Y₁ ⟶ U) (g₂ : Y₂ ⟶ U) (h₁ : S.arrows g₁)
      (h₂ : S.arrows g₂) (t₁ : wcEtPts Ω X fX Y₁) (t₂ : wcEtPts Ω X fX Y₂),
      wcEtPtsMap Ω X fX g₁ t₁ = wcEtPtsMap Ω X fX g₂ t₂ →
      (x g₁ h₁).down.1 t₁ = (x g₂ h₂).down.1 t₂ := by
    intro Y₁ Y₂ g₁ g₂ h₁ h₂ t₁ t₂ e
    obtain ⟨P, p₁, p₂, p, hc, e₁, e₂⟩ := hPB g₁ g₂ t₁ t₂ e
    have h' := congrArg (fun z : ULift.{u+1} (wcEtDivSub Ω X fX P) => z.down.1 p)
      (hx p₁ p₂ h₁ h₂ hc)
    subst e₁ e₂
    exact h'

  have hPts : ∀ s : wcEtPts Ω X fX U, ∃ (Y : X.Etale) (g : Y ⟶ U) (_ : S.arrows g)
      (t : wcEtPts Ω X fX Y), wcEtPtsMap Ω X fX g t = s := by
    intro s
    obtain ⟨Y, g, w, hg, hw⟩ := hSurj (s.1 (IsLocalRing.closedPoint Ω))
    obtain ⟨t, ht, -⟩ := hLift g s w hw
    exact ⟨Y, g, hg, t, ht⟩
  choose Yc gc hc tc htc using hPts
  let A₀ : wcEtPts Ω X fX U → ℤ := fun s => (x (gc s) (hc s)).down.1 (tc s)
  have hA₀ : ∀ {Y : X.Etale} (g : Y ⟶ U) (h : S.arrows g) (t : wcEtPts Ω X fX Y),
      A₀ (wcEtPtsMap Ω X fX g t) = (x g h).down.1 t := by
    intro Y g h t
    exact hComp _ _ _ _ _ _ (htc _)

  have hmem : A₀ ∈ wcEtDivSub Ω X fX U := by
    intro y
    obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
    obtain ⟨W', hW', hwW', T, hT, hP⟩ := (x g hg).down.2 w
    refine ⟨g.left '' W', g.left.isOpenMap W' hW', ⟨w, hwW', hw⟩, T, hT, fun s hs hsW => ?_⟩
    obtain ⟨w', hw'W, hw'⟩ := hsW
    obtain ⟨t, ht, htw⟩ := hLift g s w' hw'
    have hne : (x g hg).down.1 t ≠ 0 := by
      rw [← hA₀ g hg t, ht]
      exact hs
    have h1 := hP t hne (by rw [htw]; exact hw'W)
    have e : s.1 ≫ U.hom = t.1 ≫ Y.hom := by
      rw [← ht]
      change (t.1 ≫ g.left) ≫ U.hom = t.1 ≫ Y.hom
      rw [Category.assoc, MorphismProperty.Over.w g]
    rw [e]
    exact h1

  refine ⟨(ULift.up ⟨A₀, hmem⟩ : ULift.{u+1} (wcEtDivSub Ω X fX U)), ?_, ?_⟩
  · intro Y g hg
    apply ULift.ext
    apply Subtype.ext
    funext t
    exact hA₀ g hg t
  · intro y hy
    apply ULift.ext
    apply Subtype.ext
    funext s
    change y.down.1 s = A₀ s
    calc y.down.1 s = y.down.1 (wcEtPtsMap Ω X fX (gc s) (tc s)) :=
          congrArg (fun z => y.down.1 z) (htc s).symm
      _ = (x (gc s) (hc s)).down.1 (tc s) :=
          congrArg (fun z : ULift.{u+1} (wcEtDivSub Ω X fX (Yc s)) => z.down.1 (tc s))
            (hy (gc s) (hc s))
      _ = A₀ s := rfl

theorem wc_et_sheafify_cokernel_iso : ∀ (X : Scheme.{u}) {A B C : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f : A ⟶ B) (g : B ⟶ C),
    f ≫ g = 0 → Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) g →
    (∀ (U : X.Etale) (b : ToType (B.obj (Opposite.op U))), g.app (Opposite.op U) b = 0 →
      Presheaf.imageSieve f b ∈ Scheme.smallEtaleTopology X U) →
    Nonempty (Limits.cokernel ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) ≅
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj C) :=
by
  intro X A B C f g hfg hsurj hex
  have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = 0 := by
    rw [← Functor.map_comp, hfg, Functor.map_zero]
  have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g) := by
    rw [← Sheaf.isLocallySurjective_iff_epi']
    exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g).mpr hsurj
  have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
      (Limits.kernel.lift g f hfg) := by
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    have ht : g.app (Opposite.op U) ((Limits.kernel.ι g).app (Opposite.op U) s) = 0 := by
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
      rfl
    refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
    intro V φ hφ
    obtain ⟨r, hr⟩ := hφ
    refine ⟨r, ?_⟩
    have hm : Mono ((Limits.kernel.ι g).app (Opposite.op V)) :=
      (NatTrans.mono_iff_mono_app _).mp inferInstance _
    apply (AddCommGrpCat.mono_iff_injective _).mp hm
    rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
      ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
  have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (Limits.kernel.lift g f hfg)) := by
    rw [← Sheaf.isLocallySurjective_iff_epi']
    exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
  have heq : Limits.kernel.lift
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f hfg) ≫
      (Limits.PreservesKernel.iso
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) g).hom := by
    rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
  have hexact : (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map f) ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map g) h).Exact := by
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h)
    rw [heq]
    exact epi_comp _ _
  haveI : Epi (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map f) ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map g) h).g := hepi
  have hG := hexact.gIsCokernel
  exact ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _) hG⟩

theorem wc_cechAcyclic_of_iso : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C]
    {G H : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (e : G ≅ H) {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U),
    wcCechAcyclic G V f → wcCechAcyclic H V f :=
by
  intro C _ _ G H e U k V f hG
  have hN : ∀ {F F' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ F') (p : ℕ)
      (b : ∀ σ : Fin (p + 1) → Fin k,
        F.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
      (τ : Fin (p + 2) → Fin k),
      α.app (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))
        (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          F.map (wcCechFace V f τ j).op (b (fun l => τ (j.succAbove l)))) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        F'.map (wcCechFace V f τ j).op
          (α.app (Opposite.op (Limits.widePullback U (fun l => V (τ (j.succAbove l)))
            (fun l => f (τ (j.succAbove l))))) (b (fun l => τ (j.succAbove l)))) := by
    intro F F' α p b τ
    simp only [map_sum, map_zsmul, NatTrans.naturality_apply]
  intro p c hc
  have h3 : ∀ ρ : Fin (p + 3) → Fin k,
      ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        G.map (wcCechFace V f ρ j).op
          ((fun τ : Fin (p + 2) → Fin k =>
            e.inv.app (Opposite.op (Limits.widePullback U (fun l => V (τ l))
              (fun l => f (τ l)))) (c τ)) (fun l => ρ (j.succAbove l))) = 0 := by
    intro ρ
    refine (hN e.inv (p + 1) c ρ).symm.trans ?_
    rw [hc ρ, map_zero]
  obtain ⟨b', hb'⟩ := hG p (fun τ : Fin (p + 2) → Fin k =>
    e.inv.app (Opposite.op (Limits.widePullback U (fun l => V (τ l))
      (fun l => f (τ l)))) (c τ)) h3
  refine ⟨fun σ => e.hom.app _ (b' σ), fun τ => ?_⟩
  have h := hN e.hom p b' τ
  rw [hb' τ] at h
  beta_reduce at h
  rw [Iso.inv_hom_id_app_apply] at h
  exact h.symm

theorem wc_et_widePullback_qcqs : ∀ (X : Scheme.{u}) (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
    CompactSpace U.left → QuasiSeparatedSpace U.left → (∀ i, IsAffine (V i).left) →
    ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      CompactSpace (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left ∧
      QuasiSeparatedSpace (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left :=
by
  intro X U k V f hUc hUqs hVaff p σ
  haveI := hUc
  haveI := hUqs

  have leg : ∀ i, QuasiCompact (f i).left ∧ QuasiSeparated (f i).left := by
    intro i
    haveI := hVaff i
    exact ⟨inferInstance, inferInstance⟩

  have sq : ∀ (n : ℕ) (Xs : Fin (n + 1) → X.Etale) (g : ∀ i, Xs i ⟶ U),
      IsPullback (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback U Xs g ⟶ Limits.widePullback U (fun i : Fin n => Xs i.castSucc)
            (fun i => g i.castSucc))
        (Limits.WidePullback.π g (Fin.last n))
        (Limits.WidePullback.base (fun i : Fin n => g i.castSucc)) (g (Fin.last n)) := by
    intro n Xs g
    have w : (Limits.WidePullback.lift (Limits.WidePullback.base g)
        (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
        (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
          Limits.widePullback U Xs g ⟶ Limits.widePullback U (fun i : Fin n => Xs i.castSucc)
            (fun i => g i.castSucc)) ≫
        Limits.WidePullback.base (fun i : Fin n => g i.castSucc) =
        Limits.WidePullback.π g (Fin.last n) ≫ g (Fin.last n) := by
      rw [Limits.WidePullback.lift_base, Limits.WidePullback.π_arrow]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ w) ?_
    refine Limits.PullbackCone.IsLimit.mk w
      (fun s => Limits.WidePullback.lift (s.fst ≫ Limits.WidePullback.base _)
        (Fin.lastCases (motive := fun j => s.pt ⟶ Xs j) s.snd
          (fun i => s.fst ≫ Limits.WidePullback.π (fun i : Fin n => g i.castSucc) i))
        (fun j => by
          induction j using Fin.lastCases with
          | last => rw [Fin.lastCases_last]; exact s.condition.symm
          | cast i =>
            rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow]))
      (fun s => ?_) (fun s => ?_) (fun s m h1 h2 => ?_)
    · apply Limits.WidePullback.hom_ext
      · intro j
        rw [Category.assoc, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π,
          Fin.lastCases_castSucc]
      · rw [Category.assoc, Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
    · rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
    · apply Limits.WidePullback.hom_ext
      · intro j
        induction j using Fin.lastCases with
        | last => rw [Limits.WidePullback.lift_π, Fin.lastCases_last]; exact h2
        | cast i =>
          rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← h1, Category.assoc,
            Limits.WidePullback.lift_π]
      · rw [Limits.WidePullback.lift_base, ← h1, Category.assoc, Limits.WidePullback.lift_base]

  have main : ∀ (n : ℕ) (τ : Fin n → Fin k),
      QuasiCompact (Limits.WidePullback.base (fun l => f (τ l))).left ∧
      QuasiSeparated (Limits.WidePullback.base (fun l => f (τ l))).left := by
    intro n
    induction n with
    | zero =>
      intro τ
      let e0 : Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)) ≅ U :=
        { hom := Limits.WidePullback.base _
          inv := Limits.WidePullback.lift (𝟙 U) (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
          hom_inv_id := by
            apply Limits.WidePullback.hom_ext
            · intro j; exact Fin.elim0 j
            · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id,
                Category.id_comp]
          inv_hom_id := Limits.WidePullback.lift_base _ _ _ _ }
      let E := (Scheme.Etale.forget X ⋙ Over.forget X).mapIso e0
      haveI hE : IsIso E.hom := Iso.isIso_hom E
      have hEq : E.hom = (Limits.WidePullback.base (fun l => f (τ l))).left := rfl
      haveI : IsIso (Limits.WidePullback.base (fun l => f (τ l))).left := hEq ▸ hE
      exact ⟨inferInstance, inferInstance⟩
    | succ n ih =>
      intro τ
      obtain ⟨hqc, hqs⟩ := ih (fun i => τ i.castSucc)
      have hsq := (sq n (fun l => V (τ l)) (fun l => f (τ l))).map
        (Scheme.Etale.forget X ⋙ Over.forget X)
      obtain ⟨lqc, lqs⟩ := leg (τ (Fin.last n))
      have rqc := MorphismProperty.of_isPullback (P := @QuasiCompact) hsq.flip lqc
      have rqs := MorphismProperty.of_isPullback (P := @QuasiSeparated) hsq.flip lqs
      have hfac : (Limits.WidePullback.base (fun l => f (τ l))).left =
          (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left ≫
          (Limits.WidePullback.base (fun i : Fin n => f (τ i.castSucc))).left := by
        change (Scheme.Etale.forget X ⋙ Over.forget X).map
            (Limits.WidePullback.base (fun l => f (τ l))) =
          (Scheme.Etale.forget X ⋙ Over.forget X).map
            (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
              (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
              (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)) ≫
          (Scheme.Etale.forget X ⋙ Over.forget X).map
            (Limits.WidePullback.base (fun i : Fin n => f (τ i.castSucc)))
        rw [← Functor.map_comp, Limits.WidePullback.lift_base]
      haveI : QuasiCompact (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left := rqc
      haveI : QuasiSeparated (Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (τ l)))
            (fun i : Fin n => Limits.WidePullback.π (fun l => f (τ l)) i.castSucc)
            (fun i => Limits.WidePullback.π_arrow (fun l => f (τ l)) i.castSucc)).left := rqs
      haveI := hqc
      haveI := hqs
      rw [hfac]
      exact ⟨inferInstance, inferInstance⟩

  obtain ⟨hqc, hqs⟩ := main (p + 1) σ
  exact ⟨QuasiCompact.compactSpace_of_compactSpace
      (Limits.WidePullback.base (fun l => f (σ l))).left,
    quasiSeparatedSpace_of_quasiSeparated (Limits.WidePullback.base (fun l => f (σ l))).left⟩

theorem wc_et_finite_affine_refinement : ∀ (X : Scheme.{u}) (U : X.Etale), CompactSpace U.left →
    ∀ R ∈ Scheme.smallEtaleTopology X U, ∃ (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
      (∀ i, R.arrows (f i)) ∧ (∀ i, IsAffine (V i).left) ∧
      ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left :=
by
  intro X U hc R hR
  have hSurj : ∀ y : U.left, ∃ (Y : X.Etale) (g : Y ⟶ U) (w : Y.left),
      R.arrows g ∧ g.left w = y := by
    change R ∈ Scheme.smallGrothendieckTopology @Etale X U at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    intro y
    obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U R).mp hR y
    exact ⟨Y, g, w, hg, hw⟩
  have hNbhd : ∀ y : U.left, ∃ (V : X.Etale) (f : V ⟶ U),
      R.arrows f ∧ IsAffine V.left ∧ y ∈ Set.range f.left := by
    intro y
    obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
    obtain ⟨a, ha⟩ := Y.left.affineCover.covers w
    haveI : Etale Y.hom := Y.prop
    let V : X.Etale := MorphismProperty.Over.mk ⊤
      (Y.left.affineCover.f (Y.left.affineCover.idx w) ≫ Y.hom)
      (inferInstance : Etale (Y.left.affineCover.f (Y.left.affineCover.idx w) ≫ Y.hom))
    let h : V ⟶ Y := MorphismProperty.Over.homMk
      (Y.left.affineCover.f (Y.left.affineCover.idx w)) rfl trivial
    refine ⟨V, h ≫ g, R.downward_closed hg h, ?_, ⟨a, ?_⟩⟩
    · show IsAffine (Y.left.affineCover.X (Y.left.affineCover.idx w))
      infer_instance
    · change g.left (Y.left.affineCover.f (Y.left.affineCover.idx w) a) = y
      rw [ha, hw]
  choose Vy fy hR' hA hy using hNbhd
  have hopen : ∀ y, Set.range (fy y).left ∈ nhds y := fun y =>
    ((fy y).left.isOpenMap.isOpen_range).mem_nhds (hy y)
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover _ hopen
  classical
  refine ⟨t.card, fun i => Vy (t.equivFin.symm i).1, fun i => fy (t.equivFin.symm i).1,
    fun i => hR' _, fun i => hA _, ?_⟩
  intro x
  have hx : x ∈ ⋃ y ∈ t, Set.range (fy y).left := by rw [ht]; trivial
  obtain ⟨y, hyt, hxy⟩ := Set.mem_iUnion₂.mp hx
  have key : ∀ z : t, z = ⟨y, hyt⟩ → x ∈ Set.range (fy z.1).left := by
    rintro _ rfl
    exact hxy
  exact ⟨t.equivFin ⟨y, hyt⟩, key _ (Equiv.symm_apply_apply _ _)⟩

theorem wc_et_gm_divisor_coker_acyclic : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X],
    (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (Limits.cokernel (wcEtGmToAt X (genericPoint X))) (q + 1)) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q
  haveI := wc_et_enough_injectives X

  obtain ⟨ord, h0, hsurj, hker⟩ := wc_et_divisor_ord_exact Ω X fX hnorm hdim
  obtain ⟨e7⟩ := wc_et_sheafify_cokernel_iso X (wcEtGmToAtPre X (genericPoint X)) ord h0 hsurj hker
  have hD := wc_et_div_isSheaf Ω X fX
  haveI := isIso_toSheafify (Scheme.smallEtaleTopology X) hD
  let G := Limits.cokernel (wcEtGmToAt X (genericPoint X))
  let E : wcEtDivPre Ω X fX ≅ G.obj :=
    asIso (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX)) ≪≫
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso e7.symm

  let B : X.Etale → Prop := fun U => CompactSpace U.left ∧ QuasiSeparatedSpace U.left
  let Cov : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale), (∀ i, V i ⟶ U) → Prop :=
    fun U k V f => B U ∧ (∀ i, IsAffine (V i).left) ∧ ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left
  have H1 : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f →
      Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.smallEtaleTopology X U := by
    intro U k V f hC
    apply wc_etale_jointly_surjective_covers X U
    intro v
    obtain ⟨i, hi⟩ := hC.2.2 v
    refine ⟨V i, f i, ?_, hi⟩
    exact ⟨V i, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩
  have H2 : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f →
      ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      B (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))) := by
    intro U k V f hC p σ
    exact wc_et_widePullback_qcqs X U k V f hC.1.1 hC.1.2 hC.2.1 p σ
  have H3 : ∀ (U : X.Etale), B U → ∀ R ∈ Scheme.smallEtaleTopology X U,
      ∃ (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f ∧ ∀ i, R.arrows (f i) := by
    intro U hB R hR
    obtain ⟨k, V, f, hRf, haff, hsurjf⟩ := wc_et_finite_affine_refinement X U hB.1 R hR
    exact ⟨k, V, f, ⟨hB, haff, hsurjf⟩, hRf⟩
  have hT := @MorphismProperty.Over.mkIdTerminal Scheme.{u} _ @Etale X
    MorphismProperty.IsMultiplicative.toContainsIdentities
  have hBT : CompactSpace X ∧ QuasiSeparatedSpace X :=
    ⟨QuasiCompact.compactSpace_of_compactSpace fX, quasiSeparatedSpace_of_quasiSeparated fX⟩

  have H5 : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f →
      wcCechAcyclic G.obj V f := by
    intro U k V f hC
    apply wc_cechAcyclic_of_iso E V f
    apply wc_et_div_cech_acyclic Ω X fX U k V f
    · intro p σ
      exact (wc_et_widePullback_qcqs X U k V f hC.1.1 hC.1.2 hC.2.1 p σ).1
    · intro s
      obtain ⟨i, v, hv⟩ := hC.2.2 (s.1 (IsLocalRing.closedPoint Ω))
      obtain ⟨t', ht', -⟩ := wc_etale_lift_alg_closed_point Ω (f i).left s.1 v hv
      refine ⟨i, ⟨t', ?_⟩, ?_⟩
      · rw [← MorphismProperty.Over.w (f i)]
        simp only [Category.assoc]
        rw [← Category.assoc, ht']
        exact s.2
      · apply Subtype.ext
        exact ht'

  exact wc_et_cartan_criterion_const X B Cov H1 H2 H3 _ hT hBT G H5 q

theorem wc_et_push_left_adjoint : ∀ {X B : Scheme.{u}} (g : X ⟶ B), ∃ (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) ∧ Limits.PreservesFiniteLimits L ∧ Nonempty (L.obj ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≅ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) :=
by

  have hlan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] [Limits.HasFiniteLimits C]
      (G : C ⥤ D) [Limits.PreservesFiniteLimits G],
      Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ _ G _
    have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
      exact key
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := wc_lan_eval_iso G.op Y
    haveI := (flat_of_preservesFiniteLimits G).cofiltered Y.unop
    haveI : IsFiltered (CostructuredArrow G.op Y) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence G Y.unop)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow G.op Y)) :=
      IsFiltered.of_equivalence (ULiftHom.equiv (C := CostructuredArrow G.op Y))
    haveI : HasExactColimitsOfShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
        AddCommGrpCat.{u+1} := AB5OfSize.ofShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
    haveI : HasExactColimitsOfShape (CostructuredArrow G.op Y) AddCommGrpCat.{u+1} :=
      @HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _
        (ULiftHom.{u+1} (CostructuredArrow G.op Y)) (CostructuredArrow G.op Y) _ _
        (ULiftHom.equiv (C := CostructuredArrow G.op Y)).symm _ _
    exact Limits.preservesLimitsOfShape_of_natIso θ.symm

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  intro X B g
  let Φ := wcEtBaseChange g
  haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget X)⟩
  haveI := flat_of_preservesFiniteLimits Φ
  haveI : Φ.IsContinuous (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
  haveI := hlan Φ
  let adj0 := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous Φ AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)
  let e : wcEtPush g ≅ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) :=
    Functor.isoWhiskerRight (Φ.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)).symm
      (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology B)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _
  let hTB : Limits.IsTerminal (⊤_ B.Etale) := Limits.terminalIsTerminal
  let hTX : Limits.IsTerminal (Φ.obj (⊤_ B.Etale)) := Limits.IsTerminal.isTerminalObj Φ _ hTB
  let a2 := ((constantSheafAdj (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} hTB).comp adj0).ofNatIsoRight
    (Iso.refl _ : Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) ⋙
      (sheafSections (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (Opposite.op (⊤_ B.Etale)) ≅
      (sheafSections (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (Opposite.op (Φ.obj (⊤_ B.Etale))))
  let eL := a2.leftAdjointUniq (constantSheafAdj (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} hTX)
  exact ⟨Functor.sheafPullbackConstruction.sheafPullback Φ AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X), ⟨adj0.ofNatIsoRight e.symm⟩,
      Limits.comp_preservesFiniteLimits (sheafToPresheaf _ _)
        (Φ.op.lan ⋙ presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      ⟨eL.app (AddCommGrpCat.of (ULift.{u+1} ℤ))⟩⟩

theorem wc_ext_degenerate_leray_equiv : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A), letI := HasExt.standard C; letI := HasExt.standard D; (∀ q : ℕ, 1 ≤ q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → ∀ p : ℕ, Nonempty (Abelian.Ext P (R.obj A) p ≃ Abelian.Ext (L.obj P) A p) :=
by
  intro C D _ _ _ _ L R _ adj _ P A I
  letI := HasExt.standard C
  letI := HasExt.standard D
  intro h p
  cases p with
  | zero =>
    exact ⟨Abelian.Ext.homEquiv₀.trans ((adj.homEquiv P A).symm.trans Abelian.Ext.homEquiv₀.symm)⟩
  | succ q =>
    haveI := adj.isRightAdjoint
    haveI : L.PreservesMonomorphisms := inferInstance
    let J := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    let e := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 A
    let u : A ⟶ I.cocomplex.X 0 := e.inv ≫ I.ι.f 0
    have hu : u ≫ I.cocomplex.d 0 1 = 0 := by
      simp only [u, Category.assoc, InjectiveResolution.ι_f_zero_comp_complex_d, Limits.comp_zero]
    have hf0 : R.map u ≫ J.d 0 1 = 0 := by
      change R.map u ≫ R.map (I.cocomplex.d 0 1) = 0
      rw [← R.map_comp, hu, R.map_zero]
    let ι := (CochainComplex.fromSingle₀Equiv J (R.obj A)).symm ⟨R.map u, hf0⟩
    have hι0 : ι.f 0 = R.map u := CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
    haveI hmu : Mono u := mono_comp _ _
    haveI : R.PreservesMonomorphisms := Functor.preservesMonomorphisms_of_isRightAdjoint R
    have hS : (ShortComplex.mk u (I.cocomplex.d 0 1) hu).Exact := by
      refine ShortComplex.exact_of_iso ?_ I.exact₀
      have heu : e.hom ≫ u = I.ι.f 0 := by simp only [u, Iso.hom_inv_id_assoc]
      refine ShortComplex.isoMk e (Iso.refl _) (Iso.refl _) ?_ ?_
      · exact heu.trans (Category.comp_id (I.ι.f 0)).symm
      · exact (Category.id_comp _).trans (Category.comp_id _).symm
    have hSR := hS.map_of_mono_of_preservesKernel R hmu inferInstance
    haveI hqi : QuasiIso ι := by
      rw [quasiIso_iff]
      intro i
      cases i with
      | zero =>
        rw [CochainComplex.quasiIsoAt₀_iff]
        rw [ShortComplex.quasiIso_iff_of_zeros _ (by simp; try rfl) (by simp; try rfl)
          (J.shape 0 0 (by simp))]
        constructor
        · refine ShortComplex.exact_of_iso ?_ hSR
          refine ShortComplex.isoMk
            (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (R.obj A)).symm
            (Iso.refl _) (Iso.refl _) ?_ ?_
          · simp [hι0]
            try exact (Category.id_comp _).trans (Category.comp_id _).symm
          · exact (Category.id_comp _).trans (Category.comp_id _).symm
        · change Mono (ι.f 0)
          rw [hι0]
          exact Functor.map_mono R u
      | succ n =>
        rw [quasiIsoAt_iff_exactAt ι (n+1) (CochainComplex.exactAt_succ_single_obj _ n)]
        exact (J.exactAt_iff_isZero_homology (n+1)).mpr (h (n+1) (by omega))
    let K : InjectiveResolution (R.obj A) :=
      { cocomplex := J
        injective := fun n => adj.map_injective _ (I.injective n)
        ι := ι
        quasiIso := hqi }
    let φ : ∀ n : ℕ, (L.obj P ⟶ I.cocomplex.X n) ≃+ (P ⟶ K.cocomplex.X n) := fun n =>
      { adj.homEquiv P (I.cocomplex.X n) with
        map_add' := fun f g => by
          simp [Adjunction.homEquiv_unit] }
    have hφ : ∀ (n m : ℕ) (g : L.obj P ⟶ I.cocomplex.X n),
        φ m (g ≫ I.cocomplex.d n m) = φ n g ≫ K.cocomplex.d n m := by
      intro n m g
      change adj.homEquiv _ _ (g ≫ I.cocomplex.d n m) = adj.homEquiv _ _ g ≫ R.map (I.cocomplex.d n m)
      exact adj.homEquiv_naturality_right _ _
    have k0I : ∀ (f f' : L.obj P ⟶ I.cocomplex.X (q+1)) hf hf', f = f' →
        I.extMk f (q+1+1) rfl hf = I.extMk f' (q+1+1) rfl hf' := by
      intro f f' hf hf' hff
      subst hff
      rfl
    have k0K : ∀ (f f' : P ⟶ K.cocomplex.X (q+1)) hf hf', f = f' →
        K.extMk f (q+1+1) rfl hf = K.extMk f' (q+1+1) rfl hf' := by
      intro f f' hf hf' hff
      subst hff
      rfl
    have k1I : ∀ (g g' : L.obj P ⟶ I.cocomplex.X (q+1)) hg hg',
        I.extMk g (q+1+1) rfl hg = I.extMk g' (q+1+1) rfl hg' ↔
          ∃ k : L.obj P ⟶ I.cocomplex.X q, k ≫ I.cocomplex.d q (q+1) = g - g' := by
      intro g g' hg hg'
      have hsub : (g - g') ≫ I.cocomplex.d (q+1) (q+1+1) = 0 := by
        rw [Preadditive.sub_comp, hg, hg', sub_zero]
      have e1 : I.extMk g (q+1+1) rfl hg =
          I.extMk (g - g') (q+1+1) rfl hsub + I.extMk g' (q+1+1) rfl hg' := by
        rw [I.add_extMk]
        exact k0I _ _ _ _ (by abel)
      rw [e1, add_eq_right]
      exact I.extMk_eq_zero_iff (g - g') (q+1+1) rfl hsub q rfl
    have k1K : ∀ (g g' : P ⟶ K.cocomplex.X (q+1)) hg hg',
        K.extMk g (q+1+1) rfl hg = K.extMk g' (q+1+1) rfl hg' ↔
          ∃ k : P ⟶ K.cocomplex.X q, k ≫ K.cocomplex.d q (q+1) = g - g' := by
      intro g g' hg hg'
      have hsub : (g - g') ≫ K.cocomplex.d (q+1) (q+1+1) = 0 := by
        rw [Preadditive.sub_comp, hg, hg', sub_zero]
      have e1 : K.extMk g (q+1+1) rfl hg =
          K.extMk (g - g') (q+1+1) rfl hsub + K.extMk g' (q+1+1) rfl hg' := by
        rw [K.add_extMk]
        exact k0K _ _ _ _ (by abel)
      rw [e1, add_eq_right]
      exact K.extMk_eq_zero_iff (g - g') (q+1+1) rfl hsub q rfl
    have k2 : ∀ (g : L.obj P ⟶ I.cocomplex.X (q+1)),
        g ≫ I.cocomplex.d (q+1) (q+1+1) = 0 ↔ φ (q+1) g ≫ K.cocomplex.d (q+1) (q+1+1) = 0 := by
      intro g
      rw [← hφ, map_eq_zero_iff _ (φ _).injective]
    choose gx hgx hgxs using fun x : Abelian.Ext (L.obj P) A (q+1) =>
      I.extMk_surjective x (q+1+1) rfl
    let Φ : Abelian.Ext (L.obj P) A (q+1) → Abelian.Ext P (R.obj A) (q+1) := fun x =>
      K.extMk (φ (q+1) (gx x)) (q+1+1) rfl ((k2 _).mp (hgx x))
    have hΦ : ∀ (g : L.obj P ⟶ I.cocomplex.X (q+1)) hg,
        Φ (I.extMk g (q+1+1) rfl hg) = K.extMk (φ (q+1) g) (q+1+1) rfl ((k2 _).mp hg) := by
      intro g hg
      have hx := hgxs (I.extMk g (q+1+1) rfl hg)
      obtain ⟨k, hk⟩ := (k1I _ _ _ _).mp hx
      refine (k1K _ _ _ _).mpr ⟨φ q k, ?_⟩
      rw [← hφ, hk, map_sub]
    have hinj : Function.Injective Φ := by
      intro x y hxy
      obtain ⟨k', hk'⟩ := (k1K _ _ _ _).mp hxy
      rw [← hgxs x, ← hgxs y]
      refine (k1I _ _ _ _).mpr ⟨(φ q).symm k', ?_⟩
      apply (φ (q+1)).injective
      rw [hφ, AddEquiv.apply_symm_apply, hk', map_sub]
    have hsurj : Function.Surjective Φ := by
      intro z
      obtain ⟨f, hf, rfl⟩ := K.extMk_surjective z (q+1+1) rfl
      have hg : ((φ (q+1)).symm f) ≫ I.cocomplex.d (q+1) (q+1+1) = 0 := by
        rw [k2, AddEquiv.apply_symm_apply]
        exact hf
      refine ⟨I.extMk ((φ (q+1)).symm f) (q+1+1) rfl hg, ?_⟩
      rw [hΦ]
      exact k0K _ _ _ _ (AddEquiv.apply_symm_apply _ _)
    exact ⟨(Equiv.ofBijective Φ ⟨hinj, hsurj⟩).symm⟩

theorem wc_et_push_homology_zero_of_locKill : ∀ {X' Y : Scheme.{u}} (b : X' ⟶ Y) (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) ℕ) (q : ℕ), wcEtLocKill b K q (fun _ => True) → Limits.IsZero ((((wcEtPush b).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology (q + 1)) :=
by
  intro X' Y b K q hK

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have s1 : ∀ (H : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : Y.Etale) (z : H.obj (Opposite.op V)),
        Presheaf.equalizerSieve (F := H) (X := Opposite.op V) z 0 ∈ Scheme.smallEtaleTopology Y V) →
      Limits.IsZero ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj H) := by
    intro H hH
    obtain ⟨Z, hZ⟩ := (Limits.HasZeroObject.zero : ∃ Z : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      Limits.IsZero Z)
    let f : H ⟶ Z := 0
    have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) f := by
      apply Presheaf.IsLocallyInjective.mk
      intro X x y _
      refine GrothendieckTopology.superset_covering _ ?_ (hH X.unop (x - y))
      intro W g hg
      rw [Presheaf.equalizerSieve_apply] at hg ⊢
      rw [map_sub, map_zero, sub_eq_zero] at hg
      exact hg
    have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) f := by
      apply Presheaf.IsLocallySurjective.mk
      intro U s
      have htop : Presheaf.imageSieve f s = ⊤ := by
        ext W g
        simp only [Sieve.top_apply, iff_true]
        rw [Presheaf.imageSieve_apply]
        refine ⟨0, ?_⟩
        have : Subsingleton (ToType (Z.obj (Opposite.op W))) :=
          AddCommGrpCat.isZero_iff_subsingleton.mp (hZ.obj _)
        exact Subsingleton.elim _ _
      rw [htop]
      exact (Scheme.smallEtaleTopology Y).top_mem U
    have hW : (Scheme.smallEtaleTopology Y).W f :=
      (GrothendieckTopology.W_iff_isLocallyBijective _ f).2 ⟨hinj, hsurj⟩
    haveI := (GrothendieckTopology.W_iff _ f).1 hW
    exact Limits.IsZero.of_iso (Functor.map_isZero _ hZ)
      (asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f))

  have s2 : ∀ (S : ShortComplex ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})),
      (∀ (V : Y.Etale) (c : S.X₂.obj (Opposite.op V)), (S.g.app (Opposite.op V)).hom c = 0 →
        ∀ v : V.left, ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left) (e : S.X₁.obj (Opposite.op W)),
          g.left w = v ∧ (S.f.app (Opposite.op W)).hom e = (S.X₂.map g.op).hom c) →
      ∀ (V : Y.Etale) (z : S.homology.obj (Opposite.op V)),
        Presheaf.equalizerSieve (F := S.homology) (X := Opposite.op V) z 0 ∈
          Scheme.smallEtaleTopology Y V := by
    intro S hS V z
    have hπ : Epi (S.homologyπ.app (Opposite.op V)) :=
      (NatTrans.epi_iff_epi_app _).1 inferInstance _
    obtain ⟨k, rfl⟩ := (AddCommGrpCat.epi_iff_surjective _).1 hπ z
    have hι : ∀ X, Function.Injective (ConcreteCategory.hom (S.iCycles.app X)) := fun X =>
      (AddCommGrpCat.mono_iff_injective _).1 ((NatTrans.mono_iff_mono_app _).1 inferInstance X)
    have hc : (S.g.app (Opposite.op V)).hom ((S.iCycles.app (Opposite.op V)).hom k) = 0 := by
      have := congrArg (fun φ => (φ.app (Opposite.op V)).hom k) S.iCycles_g
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] at this
      exact this
    apply hcov
    intro v
    obtain ⟨W, g, w, e, hw, he⟩ := hS V _ hc v
    refine ⟨W, g, ?_, w, hw⟩
    rw [Presheaf.equalizerSieve_apply, map_zero]
    have h1 : ConcreteCategory.hom (S.cycles.map g.op) k =
        ConcreteCategory.hom (S.toCycles.app (Opposite.op W)) e := by
      apply hι
      rw [NatTrans.naturality_apply]
      have n2 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) S.toCycles_i
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply] at n2
      exact (he.symm.trans n2.symm)
    rw [← NatTrans.naturality_apply, h1]
    have n3 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) S.toCycles_comp_homologyπ
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at n3
    simpa using n3

  let Φ : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⥤
      ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    sheafToPresheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (Y.Etale)ᵒᵖ (X'.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (@Functor.op Y.Etale _ X'.Etale _ (wcEtBaseChange b))
  let Sp : ShortComplex ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    ShortComplex.mk (Φ.map (K.d q (q+1))) (Φ.map (K.d (q+1) (q+2)))
      (by rw [← Functor.map_comp, K.d_comp_d, Functor.map_zero])
  have hloc : ∀ (V : Y.Etale) (c : Sp.X₂.obj (Opposite.op V)), (Sp.g.app (Opposite.op V)).hom c = 0 →
      ∀ v : V.left, ∃ (W : Y.Etale) (g : W ⟶ V) (w : W.left) (e : Sp.X₁.obj (Opposite.op W)),
        g.left w = v ∧ (Sp.f.app (Opposite.op W)).hom e = (Sp.X₂.map g.op).hom c :=
    fun V c hc v => hK V c hc v trivial
  have hZ := s1 Sp.homology (s2 Sp hloc)
  exact Limits.IsZero.of_iso hZ
    ((HomologicalComplex.homologyIsoSc' (((wcEtPush b).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj K) q (q+1) (q+2) (CochainComplex.prev_nat_succ q)
        (CochainComplex.next ℕ (q+1)) :
      _ ≅ (Sp.map (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).homology) ≪≫
      Sp.mapHomologyIso (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}))

theorem wc_et_generic_fibre_affine_nbhd : ∀ (X : Scheme.{u}) [IsIntegral X] (V : X.Etale) (v : V.left), ∃ (W : X.Etale) (g : W ⟶ V) (w : W.left), g.left w = v ∧ IsAffine (Limits.pullback W.hom (X.fromSpecStalk (genericPoint X))) :=
by
  intro X _ V v
  haveI : Etale V.hom := V.prop
  obtain ⟨U, hU, hxU, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (X := X) (x := V.hom v) (U := (⊤ : X.Opens)) trivial
  obtain ⟨A, hA, hvA, hAU⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (x := v) (U := V.hom ⁻¹ᵁ U) ((Scheme.Hom.mem_preimage V.hom).mpr hxU)
  let W : X.Etale := MorphismProperty.Over.mk ⊤ (A.ι ≫ V.hom)
    (inferInstance : Etale (A.ι ≫ V.hom))
  let g : W ⟶ V := MorphismProperty.Over.homMk A.ι rfl trivial
  let w : W.left := (⟨v, hvA⟩ : (A : Scheme))
  have hη : genericPoint X ∈ U :=
    (genericPoint_specializes (α := X) (V.hom v)).mem_open U.isOpen hxU
  have hrange : Set.range (A.ι ≫ V.hom) ⊆ Set.range U.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
    exact (Scheme.Hom.mem_preimage V.hom).mp (hAU z.2)
  let a : (A : Scheme) ⟶ (U : Scheme) := IsOpenImmersion.lift U.ι (A.ι ≫ V.hom) hrange
  have ha : a ≫ U.ι = A.ι ≫ V.hom := IsOpenImmersion.lift_fac _ _ _
  let s := U.fromSpecStalkOfMem (genericPoint X) hη
  have hs : s ≫ U.ι = X.fromSpecStalk (genericPoint X) := Scheme.Opens.fromSpecStalkOfMem_ι _ _ _
  haveI : IsAffine (A : Scheme) := hA
  haveI : IsAffine (U : Scheme) := hU
  have e₁ : Limits.pullback a s ≅ Limits.pullback (a ≫ U.ι) (s ≫ U.ι) :=
    (Limits.pullbackIsPullbackOfCompMono a s U.ι).conePointUniqueUpToIso
      (Limits.limit.isLimit _)
  have e₂ : Limits.pullback (a ≫ U.ι) (s ≫ U.ι) ≅
      Limits.pullback (A.ι ≫ V.hom) (X.fromSpecStalk (genericPoint X)) :=
    Limits.pullback.congrHom ha hs
  refine ⟨W, g, w, ?_, ?_⟩
  · show A.ι ⟨v, hvA⟩ = v
    exact Scheme.Opens.ι_apply _ _
  · show IsAffine (Limits.pullback (A.ι ≫ V.hom) (X.fromSpecStalk (genericPoint X)))
    exact IsAffine.of_isIso (e₁ ≪≫ e₂).inv

theorem wc_et_affine_etale_field_split : ∀ (K : Type u) [Field K] (T : Scheme.{u}) [IsAffine T] (f : T ⟶ Spec (.of K)) [Etale f], ∃ (n : ℕ) (L : Fin n → Type u) (_ : ∀ i, Field (L i)) (_ : ∀ i, Algebra K (L i)), (∀ i, Algebra.IsAlgebraic K (L i)) ∧ ∃ t : ∀ i, Spec (.of (L i)) ⟶ T, (∀ i, IsOpenImmersion (t i)) ∧ (∀ i j, i ≠ j → Disjoint (Set.range (t i)) (Set.range (t j))) ∧ (∀ x : T, ∃ i, x ∈ Set.range (t i)) :=
by
  intro K _ T _ f _
  classical

  haveI : Etale (T.isoSpec.inv ≫ f) := inferInstance
  have hφ : Spec.map (Spec.preimage (T.isoSpec.inv ≫ f)) = T.isoSpec.inv ≫ f :=
    Spec.map_preimage _
  have hφe : (Spec.preimage (T.isoSpec.inv ≫ f)).hom.Etale :=
    (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp
      (by rw [hφ]; infer_instance)
  letI : Algebra K Γ(T, ⊤) := (Spec.preimage (T.isoSpec.inv ≫ f)).hom.toAlgebra
  haveI : Algebra.Etale K Γ(T, ⊤) := RingHom.Etale.toAlgebra hφe
  haveI : Module.Finite K Γ(T, ⊤) := Algebra.FormallyUnramified.finite_of_free K Γ(T, ⊤)
  haveI : IsArtinianRing Γ(T, ⊤) := IsArtinianRing.of_finite K Γ(T, ⊤)
  haveI : _root_.IsReduced Γ(T, ⊤) := Algebra.FormallyUnramified.isReduced_of_field K Γ(T, ⊤)

  have s2 : ∀ (A : Type u) [CommRing A] [IsArtinianRing A] [_root_.IsReduced A]
      (p : PrimeSpectrum A),
      IsOpenImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p.asIdeal))) ∧
      (∀ y, Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p.asIdeal)) y = p) ∧
      ∃ y, Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p.asIdeal)) y = p := by
    intro A _ _ _ p
    obtain ⟨e, he, hs⟩ :=
      PrimeSpectrum.isClopen_iff.mp (isClopen_discrete ({p} : Set (PrimeSpectrum A)))
    have hb1 : e ∉ p.asIdeal := by
      have hp : p ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum A)) := by
        rw [← hs]; rfl
      exact (PrimeSpectrum.mem_basicOpen e p).mp hp
    have hb2 : ∀ q : PrimeSpectrum A, q ≠ p → e ∈ q.asIdeal := by
      intro q hq
      by_contra h
      have hq' : q ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum A)) :=
        (PrimeSpectrum.mem_basicOpen e q).mpr h
      rw [← hs] at hq'
      exact hq hq'
    have hc : p.asIdeal = Ideal.span {1 - e} := by
      apply le_antisymm
      · intro x hx
        have hxe : x * e = 0 := by
          apply IsNilpotent.eq_zero
          rw [nilpotent_iff_mem_prime]
          intro J hJ
          by_cases hq : (⟨J, hJ⟩ : PrimeSpectrum A) = p
          · have hJp : J = p.asIdeal := congrArg PrimeSpectrum.asIdeal hq
            rw [hJp]
            exact p.asIdeal.mul_mem_right e hx
          · exact J.mul_mem_left x (hb2 ⟨J, hJ⟩ hq)
        rw [Ideal.mem_span_singleton']
        exact ⟨x, by rw [mul_sub, mul_one, hxe, sub_zero]⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        have h0 : e * (1 - e) ∈ p.asIdeal := by
          have h00 : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he.eq, sub_self]
          rw [h00]
          exact p.asIdeal.zero_mem
        exact (p.isPrime.mem_or_mem h0).resolve_left hb1
    haveI hloc : IsLocalization.Away e (A ⧸ p.asIdeal) := by
      apply IsLocalization.away_of_isIdempotentElem he
      · rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker, hc]
      · rw [Ideal.Quotient.algebraMap_eq]
        exact Ideal.Quotient.mk_surjective
    refine ⟨?_, ?_⟩
    · have h := IsOpenImmersion.of_isLocalization (R := A) (S := A ⧸ p.asIdeal) e
      rwa [Ideal.Quotient.algebraMap_eq] at h
    · have h1 := PrimeSpectrum.localization_away_comap_range (A ⧸ p.asIdeal) e
      rw [Ideal.Quotient.algebraMap_eq] at h1
      refine ⟨fun y => ?_, ?_⟩
      · have hy : PrimeSpectrum.comap (Ideal.Quotient.mk p.asIdeal) y ∈
            ({p} : Set (PrimeSpectrum A)) := by
          rw [hs, ← h1]; exact ⟨y, rfl⟩
        exact Set.mem_singleton_iff.mp hy
      · have hp : p ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk p.asIdeal)) := by
          rw [h1, ← hs]; rfl
        obtain ⟨y, hy⟩ := hp
        exact ⟨y, hy⟩

  let n := Nat.card (PrimeSpectrum Γ(T, ⊤))
  let eq : PrimeSpectrum Γ(T, ⊤) ≃ Fin n := Finite.equivFin _
  let P : Fin n → PrimeSpectrum Γ(T, ⊤) := fun i => eq.symm i
  haveI hmax : ∀ i, (P i).asIdeal.IsMaximal := fun i => IsArtinianRing.isMaximal_of_isPrime _
  letI instF : ∀ i, Field (Γ(T, ⊤) ⧸ (P i).asIdeal) := fun i => Ideal.Quotient.field _
  have hgh : ∀ y, T.isoSpec.hom (T.isoSpec.inv y) = y := fun y => by
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
  have hhg : ∀ x, T.isoSpec.inv (T.isoSpec.hom x) = x := fun x => by
    rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
  refine ⟨n, fun i => Γ(T, ⊤) ⧸ (P i).asIdeal, instF, fun i => inferInstance, ?_, ?_⟩
  · intro i
    haveI : Module.Finite K (Γ(T, ⊤) ⧸ (P i).asIdeal) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ K _).toLinearMap
        (Ideal.Quotient.mkₐ_surjective K _)
    exact Algebra.IsAlgebraic.of_finite K _
  · have hpt : ∀ i y, (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P i).asIdeal)) ≫
        T.isoSpec.inv) y = T.isoSpec.inv (P i) := by
      intro i y
      rw [Scheme.Hom.comp_apply]
      exact congrArg T.isoSpec.inv ((s2 _ (P i)).2.1 y)
    refine ⟨fun i => Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P i).asIdeal)) ≫
      T.isoSpec.inv, ?_, ?_, ?_⟩
    · intro i
      haveI := (s2 Γ(T, ⊤) (P i)).1
      infer_instance
    · intro i j hij
      rw [Set.disjoint_left]
      rintro _ ⟨y, rfl⟩ ⟨z, hz⟩
      apply hij
      have h : T.isoSpec.inv (P j) = T.isoSpec.inv (P i) :=
        (hpt j z).symm.trans (hz.trans (hpt i y))
      have h' := congrArg T.isoSpec.hom h
      have h'' := (hgh (P j)).symm.trans (h'.trans (hgh (P i)))
      exact (eq.symm.injective h'').symm
    · intro x
      let y : PrimeSpectrum Γ(T, ⊤) := T.isoSpec.hom x
      obtain ⟨z, hz⟩ := (s2 _ (P (eq y))).2.2
      refine ⟨eq y, z, ?_⟩
      have h2 : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P (eq y)).asIdeal))) z =
          T.isoSpec.hom x := hz.trans (eq.symm_apply_apply y)
      show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P (eq y)).asIdeal)) ≫
        T.isoSpec.inv) z = x
      rw [Scheme.Hom.comp_apply, h2, hhg]

theorem wc_et_disjoint_cover_bijective : ∀ {S : Scheme.{u}} (T : S.Etale) (n : ℕ) (Ti : Fin n → S.Etale) (t : ∀ i, Ti i ⟶ T), (∀ i, IsOpenImmersion (t i).left) → (∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left)) → (∀ x : T.left, ∃ i, x ∈ Set.range (t i).left) → ∀ (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}), Function.Bijective (fun (s : F.obj.obj (Opposite.op T)) (i : Fin n) => (F.obj.map (t i).op).hom s) :=
by
  intro S T n Ti t hopen hdisj hcov F
  classical

  have s1 : ∀ W : S.Etale, IsEmpty W.left → Subsingleton (F.obj.obj (Opposite.op W)) := by
    intro W hW
    have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology S W := by
      change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale S W
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact isEmptyElim x
    exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover F W hbot).isZero

  have s2 : Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallEtaleTopology S T := by
    change Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallGrothendieckTopology @Etale S T
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨i, y, hy⟩ := hcov x
    haveI := hopen i
    have hmem : (Sieve.generate (Presieve.ofArrows Ti t)).arrows (t i) :=
      Sieve.le_generate (Presieve.ofArrows Ti t) (Ti i) (t i) (Presieve.ofArrows.mk i)
    exact ⟨Ti i, t i, y, hmem, inferInstance, hy⟩

  let P := F.obj ⋙ forget AddCommGrpCat
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology S) P :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) F.obj
        (forget AddCommGrpCat)).1 F.cond)
  have s3 := (Presieve.isSheafFor_arrows_iff P t).1 (hP.isSheafFor _ s2)

  have s4 : ∀ x : ∀ i, P.obj (Opposite.op (Ti i)), Presieve.Arrows.Compatible P t x := by
    intro x i j Z gi gj h
    have hl : gi.left ≫ (t i).left = gj.left ≫ (t j).left := by
      have h1 : (Scheme.Etale.forget S ⋙ Over.forget S).map gi ≫
          (Scheme.Etale.forget S ⋙ Over.forget S).map (t i) =
          (Scheme.Etale.forget S ⋙ Over.forget S).map gj ≫
          (Scheme.Etale.forget S ⋙ Over.forget S).map (t j) := by
        rw [← Functor.map_comp, ← Functor.map_comp, h]
      exact h1
    by_cases hij : i = j
    · subst hij
      haveI := hopen i
      have hg : gi = gj := by
        apply MorphismProperty.Over.Hom.ext
        exact (cancel_mono (t i).left).1 hl
      rw [hg]
    · haveI : IsEmpty Z.left := ⟨fun z => by
        have hz : (t i).left (gi.left z) = (t j).left (gj.left z) := by
          rw [← Scheme.Hom.comp_apply, hl, Scheme.Hom.comp_apply]
        exact Set.disjoint_left.1 (hdisj i j hij) ⟨_, rfl⟩ ⟨_, hz.symm⟩⟩
      exact @Subsingleton.elim _ (s1 Z inferInstance) _ _
  refine ⟨fun s s' hss => ?_, fun x => ?_⟩
  · obtain ⟨s0, _, huniq⟩ := s3 (fun i => (F.obj.map (t i).op).hom s) (s4 _)
    exact (huniq s (fun i => rfl)).trans (huniq s' (fun i => (congrFun hss i).symm)).symm
  · obtain ⟨s, hs, _⟩ := s3 x (s4 x)
    exact ⟨s, funext hs⟩

theorem wc_et_slice_continuous : ∀ {S : Scheme.{u}} (T : S.Etale), (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) ∧ (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) :=
by
  intro S T
  haveI hT : Etale T.hom := T.prop
  have hSurj : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
      ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro Y V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩
  have hCov : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)
      (wcEtSlice T) := by
    refine CoverPreserving.mk (fun {V} {R} hR => ?_)
    apply hCov
    intro v
    obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
    exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c, ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
      ⟨w, hw⟩⟩
  have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology S) (wcEtSlice T) := by
    apply CompatiblePreserving.mk
    intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
    haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
    let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcEtSlice T).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
  have hcont : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology S) :=
    Functor.isContinuous_of_coverPreserving hcomp hcov
  have hcocont : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology S) := by
    refine Functor.IsCocontinuous.mk (fun {V} {S'} hS' => ?_)
    apply hCov
    intro v
    obtain ⟨V₁, c, w, hc, hcw⟩ := hSurj S ((wcEtSlice T).obj V) S' hS' v
    have hw : (c.left ≫ V.hom) ≫ T.hom = V₁.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w c)
    haveI : Etale ((c.left ≫ V.hom) ≫ T.hom) := hw ▸ V₁.prop
    haveI : Etale (c.left ≫ V.hom) := Etale.of_comp _ T.hom
    let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (c.left ≫ V.hom) ‹_›
    let c' : X' ⟶ V := MorphismProperty.Over.homMk c.left rfl trivial
    let e' : (wcEtSlice T).obj X' ⟶ V₁ :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
    have he' : (wcEtSlice T).map c' = e' ≫ c := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    refine ⟨X', c', ?_, ⟨w, hcw⟩⟩
    show S'.arrows ((wcEtSlice T).map c')
    rw [he']
    exact S'.downward_closed hc e'
  exact ⟨hcont, hcocont⟩

theorem wc_et_slice_lan_finite_limits : ∀ {S : Scheme.{u}} (T : S.Etale), Limits.PreservesFiniteLimits ((wcEtSlice T).op.lan : ((T.left.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
by

  have hfinal : ∀ {S : Scheme.{u}} (T W : S.Etale),
      ∃ (I : Type u) (D : Discrete I ⥤ CostructuredArrow (wcEtSlice T).op (Opposite.op W)),
        D.Final := by
    intro S T W
    have hWf : ∀ f : W ⟶ T, Etale f.left := fun f => by
      have h : f.left ≫ T.hom = W.hom := MorphismProperty.Over.w f
      haveI : Etale (f.left ≫ T.hom) := h ▸ W.prop
      haveI : Etale T.hom := T.prop
      exact Etale.of_comp f.left T.hom
    let Wf : (W ⟶ T) → T.left.Etale := fun f => MorphismProperty.Over.mk ⊤ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ T, W ⟶ (wcEtSlice T).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ T, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ T) ⥤
        CostructuredArrow (wcEtSlice T).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcEtSlice T).op (Opposite.op W)) (f : W ⟶ T)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcEtSlice T).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcEtSlice T).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcEtSlice T).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ T, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ T) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ T.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcEtSlice T).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ T,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcEtSlice T).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have hlaneval : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have hpres : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  intro S T
  exact hpres (wcEtSlice T).op
    (fun Y => hlaneval (wcEtSlice T).op Y)
    (fun Y => hfinal T Y.unop)

theorem wc_injective_resolution_transfer : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [L.PreservesMonomorphisms] [Limits.PreservesFiniteColimits R] (A : C) (A' : D) (e : R.obj A ≅ A') (I : InjectiveResolution A), ∃ (J : InjectiveResolution A') (φ : ∀ n : ℕ, R.obj (I.cocomplex.X n) ≅ J.cocomplex.X n), ∀ n : ℕ, R.map (I.cocomplex.d n (n + 1)) ≫ (φ (n + 1)).hom = (φ n).hom ≫ J.cocomplex.d n (n + 1) :=
by
  intro C D _ _ _ _ L R _ adj _ _ A A' e I
  haveI : Limits.PreservesLimitsOfSize.{0, 0} R := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits R := Limits.PreservesLimitsOfSize.preservesFiniteLimits R
  haveI : R.PreservesHomology := R.preservesHomologyOfExact
  let isoPart : (CochainComplex.single₀ D).obj A' ⟶
      (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj ((CochainComplex.single₀ C).obj A) :=
    (CochainComplex.single₀ D).map e.inv ≫
      (HomologicalComplex.singleMapHomologicalComplex R (ComplexShape.up ℕ) 0).inv.app A
  haveI : QuasiIso isoPart := quasiIso_of_isIso isoPart
  haveI : QuasiIso ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology I.ι R
  let J : InjectiveResolution A' :=
    { cocomplex := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
      injective := fun n => Adjunction.map_injective adj (I.cocomplex.X n) (I.injective n)
      hasHomology := inferInstance
      ι := isoPart ≫ (R.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι
      quasiIso := quasiIso_comp _ _ }
  refine ⟨J, fun n => Iso.refl _, fun n => ?_⟩
  simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
  rfl

theorem wc_ext_vanish_cocycle_lift : ∀ {C : Type*} [Category C] [Abelian C] (P A : C) (I : InjectiveResolution A) (n : ℕ), letI := HasExt.standard C; Subsingleton (Abelian.Ext P A (n + 1)) → ∀ f : P ⟶ I.cocomplex.X (n + 1), f ≫ I.cocomplex.d (n + 1) (n + 2) = 0 → ∃ g : P ⟶ I.cocomplex.X n, g ≫ I.cocomplex.d n (n + 1) = f :=
by
  intro C _ _ P A I n hsub f hf
  letI := HasExt.standard C
  exact (I.extMk_eq_zero_iff f (n + 2) rfl hf n rfl).1 (Subsingleton.elim _ _)

theorem wc_et_const_hom_sections_equiv : ∀ (Y : Scheme.{u}) (T₀ : Y.Etale), Limits.IsTerminal T₀ → ∃ ε : ∀ M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M) ≃ M.obj.obj (Opposite.op T₀), (∀ (M M' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : M ⟶ M') (g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M), ε M' (g ≫ ψ) = (ψ.hom.app (Opposite.op T₀)).hom (ε M g)) ∧ (∀ M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ε M 0 = 0) :=
by
  intro Y T₀ hT
  let adj := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hT
  let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
    { toFun := fun φ => φ.hom (ULift.up 1)
      invFun := fun x => AddCommGrpCat.ofHom
        ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
      left_inv := fun φ => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        rintro ⟨n⟩
        have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
          apply ULift.ext
          simp
        change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
        rw [zmultiplesHom_apply, hn, map_zsmul]
      right_inv := fun x => by
        change (zmultiplesHom X x) (1 : ℤ) = x
        rw [zmultiplesHom_apply, one_zsmul] }
  let ε : ∀ M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M) ≃ M.obj.obj (Opposite.op T₀) := fun M =>
    (adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans (ev (M.obj.obj (Opposite.op T₀)))
  have hnat : ∀ (M M' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : M ⟶ M')
      (g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M),
      ε M' (g ≫ ψ) = (ψ.hom.app (Opposite.op T₀)).hom (ε M g) := by
    intro M M' ψ g
    simp only [ε, Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
    rfl
  refine ⟨ε, hnat, fun M => ?_⟩
  have h := hnat M M 0 0
  rw [Limits.zero_comp] at h
  rw [h]
  rfl

theorem wc_et_gm_pre_isSheaf : ∀ (X : Scheme.{u}), Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtGmPre X) :=
by
  intro X

  have s2a : Scheme.etaleTopology.{u} ≤ Scheme.fpqcTopology.{u} := by
    apply Precoverage.toGrothendieck_mono
    apply le_inf
    · apply Scheme.precoverage_le_qcPrecoverage_of_isOpenMap
      intro X Y f hf
      have := hf
      exact f.isOpenMap
    · apply Scheme.precoverage_mono
      intro X Y f hf
      have := hf
      infer_instance

  have s2b : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) := by
    let A1 : Scheme.{u} := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ)))
    let e : yoneda.obj A1 ≅ Scheme.Γ ⋙ forget CommRingCat.{u} :=
      NatIso.ofComponents (fun T => Equiv.toIso
        ((AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := T.unop)).trans
          (Equiv.funUnique PUnit.{u+1} _))) (by
        intro T T' g
        ext h
        exact AffineSpace.toSpecMvPolyIntEquiv_comp PUnit.{u+1} g.unop h PUnit.unit)
    exact Presieve.isSheaf_iso Scheme.fpqcTopology e
      (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (yoneda.obj A1))

  have s3 : ∀ (F : Scheme.{u}ᵒᵖ ⥤ Type u), Presieve.IsSheaf Scheme.etaleTopology F →
      Presieve.IsSheaf (Scheme.smallEtaleTopology X)
        ((Scheme.Etale.forget X ⋙ Over.forget X).op ⋙ F) := by
    intro F hF U S hS x hx
    have hSurj : ∀ y : U.left, ∃ (Y : X.Etale) (g : Y ⟶ U) (w : Y.left),
        S.arrows g ∧ g.left w = y := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale X U at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      intro y
      obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS y
      exact ⟨Y, g, w, hg, hw⟩
    let ι := Σ (Y : X.Etale), {f : Y ⟶ U // S.arrows f}
    have hR : Presieve.ofArrows (fun i : ι => i.1.left) (fun i => i.2.1.left) ∈
        (Scheme.precoverage @Etale).coverings U.left := by
      refine (Scheme.ofArrows_mem_precoverage_iff @Etale).mpr ⟨fun y => ?_, fun i => inferInstance⟩
      obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
      exact ⟨⟨Y, g, hg⟩, w, hw⟩
    have hgen : Sieve.generate (Presieve.ofArrows (fun i : ι => i.1.left) (fun i => i.2.1.left)) ∈
        Scheme.etaleTopology U.left := Precoverage.generate_mem_toGrothendieck hR
    have hsf := (Presieve.isSheafFor_arrows_iff F (fun i : ι => i.2.1.left)).mp
      ((Presieve.isSheafFor_iff_generate _).mpr (hF _ hgen))
    let z : ∀ i : ι, F.obj (Opposite.op i.1.left) := fun i => x i.2.1 i.2.2
    have hz : Presieve.Arrows.Compatible F (fun i : ι => i.2.1.left) z := by
      rintro ⟨Y₁, f₁, h₁⟩ ⟨Y₂, f₂, h₂⟩ Z gi gj e
      haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom) := by
        haveI : Etale Y₁.hom := Y₁.prop
        infer_instance
      let P : X.Etale :=
        MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom) hEt
      have hw : Limits.pullback.snd f₁.left f₂.left ≫ Y₂.hom =
          Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom := by
        rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₁ : P ⟶ Y₁ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
      let p₂ : P ⟶ Y₂ :=
        MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
      have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
        apply MorphismProperty.Over.Hom.ext
        change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
          Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
        exact Limits.pullback.condition
      have hc : F.map (Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩) =
          F.map (Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩) :=
        hx p₁ p₂ h₁ h₂ hcomm
      let l := Limits.pullback.lift gi gj e
      change F.map gi.op (z ⟨Y₁, f₁, h₁⟩) = F.map gj.op (z ⟨Y₂, f₂, h₂⟩)
      calc F.map gi.op (z ⟨Y₁, f₁, h₁⟩)
          = F.map (l ≫ Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩) := by
            rw [Limits.pullback.lift_fst]
        _ = F.map l.op (F.map (Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩)) := by
            rw [op_comp, FunctorToTypes.map_comp_apply]
        _ = F.map l.op (F.map (Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩)) := by
            rw [hc]
        _ = F.map (l ≫ Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩) := by
            rw [op_comp, FunctorToTypes.map_comp_apply]
        _ = F.map gj.op (z ⟨Y₂, f₂, h₂⟩) := by
            rw [Limits.pullback.lift_snd]
    obtain ⟨t, ht, huniq⟩ := hsf z hz
    exact ⟨t, fun Y f hf => ht ⟨Y, f, hf⟩, fun y hy => huniq y (fun i => hy i.2.1 i.2.2)⟩

  have s4 : ∀ (J : GrothendieckTopology X.Etale) (R : (X.Etale)ᵒᵖ ⥤ CommRingCat.{u}),
      Presieve.IsSheaf J (R ⋙ forget CommRingCat.{u}) →
      Presieve.IsSheaf J (R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⋙
          forget AddCommGrpCat.{u+1}) := by
    intro J R hR V S hS x hx
    have hP := hR S hS
    let Q := R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⋙
          forget AddCommGrpCat.{u+1}
    let P := R ⋙ forget CommRingCat.{u}
    let val : ∀ (W : (X.Etale)ᵒᵖ), Q.obj W → P.obj W :=
      fun W a => ((Additive.toMul (ULift.down a) : (R.obj W)ˣ) : R.obj W)
    let ival : ∀ (W : (X.Etale)ᵒᵖ), Q.obj W → P.obj W :=
      fun W a => (((Additive.toMul (ULift.down a) : (R.obj W)ˣ)⁻¹ : (R.obj W)ˣ) : R.obj W)
    have hmap : ∀ {W W' : (X.Etale)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
        val W' (Q.map g a) = P.map g (val W a) := fun g a => rfl
    have hmapi : ∀ {W W' : (X.Etale)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
        ival W' (Q.map g a) = P.map g (ival W a) := fun g a => rfl
    have hext : ∀ {W : (X.Etale)ᵒᵖ} (a b : Q.obj W), val W a = val W b → a = b := by
      intro W a b h
      apply ULift.ext
      apply Additive.toMul.injective
      exact Units.ext h
    let a : Presieve.FamilyOfElements P S.arrows := fun Y f hf => val _ (x f hf)
    let b : Presieve.FamilyOfElements P S.arrows := fun Y f hf => ival _ (x f hf)
    have ha : a.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      change P.map g₁.op (val _ (x f₁ h₁)) = P.map g₂.op (val _ (x f₂ h₂))
      rw [← hmap, ← hmap]
      exact congrArg (val _) (hx g₁ g₂ h₁ h₂ comm)
    have hb : b.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      change P.map g₁.op (ival _ (x f₁ h₁)) = P.map g₂.op (ival _ (x f₂ h₂))
      rw [← hmapi, ← hmapi]
      exact congrArg (ival _) (hx g₁ g₂ h₁ h₂ comm)
    let α := hP.amalgamate a ha
    let β := hP.amalgamate b hb
    have hα : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : S.arrows f), P.map f.op α = a f hf :=
      fun Y f hf => hP.valid_glue ha f hf
    have hβ : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : S.arrows f), P.map f.op β = b f hf :=
      fun Y f hf => hP.valid_glue hb f hf
    have hαβ : (α * β : R.obj (Opposite.op V)) = 1 := by
      apply hP.isSeparatedFor.ext
      intro Y f hf
      change (R.map f.op).hom (α * β) = (R.map f.op).hom 1
      rw [map_mul, map_one]
      change P.map f.op α * P.map f.op β = 1
      rw [hα f hf, hβ f hf]
      exact Units.mul_inv _
    have hβα : (β * α : R.obj (Opposite.op V)) = 1 := by
      apply hP.isSeparatedFor.ext
      intro Y f hf
      change (R.map f.op).hom (β * α) = (R.map f.op).hom 1
      rw [map_mul, map_one]
      change P.map f.op β * P.map f.op α = 1
      rw [hα f hf, hβ f hf]
      exact Units.inv_mul _
    let υ : (R.obj (Opposite.op V))ˣ := ⟨α, β, hαβ, hβα⟩
    let t : Q.obj (Opposite.op V) := ULift.up (Additive.ofMul υ)
    refine ⟨t, ?_, ?_⟩
    · intro Y f hf
      apply hext
      rw [hmap]
      exact hα f hf
    · intro y hy
      apply hext
      refine hP.isSeparatedFor a (val _ y) α (fun Y f hf => ?_) hα
      rw [← hmap, hy f hf]

  rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) (wcEtGmPre X)
    (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
  exact s4 (Scheme.smallEtaleTopology X) ((Scheme.Etale.forget X ⋙ Over.forget X).op ⋙ Scheme.Γ)
    (s3 (Scheme.Γ ⋙ forget CommRingCat.{u})
      (Presieve.isSheaf_of_le _ s2a s2b))

theorem wc_et_gm_field_affine_coboundary : ∀ (K : Type u) [Field K], (∀ (L : Type u) [Field L] [Algebra K L], Algebra.IsAlgebraic K L → letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of L))) (q + 1))) → ∀ (I : InjectiveResolution (wcEtGm (Spec (.of K)))) (q : ℕ) (T : (Spec (.of K)).Etale), IsAffine T.left → ∀ c : (I.cocomplex.X (q + 1)).obj.obj (Opposite.op T), ((I.cocomplex.d (q + 1) (q + 2)).hom.app (Opposite.op T)).hom c = 0 → ∃ e : (I.cocomplex.X q).obj.obj (Opposite.op T), ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op T)).hom e = c :=
by
  intro K _ hL I q T hT c hc
  haveI := hT
  haveI : Etale T.hom := T.prop

  have key : ∀ (T' : (Spec (.of K)).Etale),
      (letI : HasExt (Sheaf (Scheme.smallEtaleTopology T'.left) AddCommGrpCat.{u+1}) :=
          HasExt.standard _;
        Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T'.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm T'.left) (q + 1))) →
      ∀ c' : (I.cocomplex.X (q + 1)).obj.obj (Opposite.op T'),
        ((I.cocomplex.d (q + 1) (q + 2)).hom.app (Opposite.op T')).hom c' = 0 →
        ∃ e : (I.cocomplex.X q).obj.obj (Opposite.op T'),
          ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op T')).hom e = c' := by
    intro T' hExt c' hc'
    obtain ⟨hcont, hcocont⟩ := wc_et_slice_continuous T'
    haveI := hcont
    haveI := hcocont
    haveI := wc_et_slice_lan_finite_limits T'
    let Rf := (wcEtSlice T').sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology (Spec (.of K)))
    let Lf := (wcEtSlice T').sheafPullback AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology (Spec (.of K)))
    let adj := (wcEtSlice T').sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology (Spec (.of K)))
    let adj2 := (wcEtSlice T').sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology (Spec (.of K)))
    haveI : Lf.PreservesMonomorphisms := inferInstance
    haveI : Limits.PreservesColimitsOfSize.{0, 0} Rf := adj2.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits Rf :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits Rf
    haveI : Rf.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rf
    haveI : Rf.Additive := Functor.additive_of_preserves_binary_products Rf
    let eG : Rf.obj (wcEtGm (Spec (.of K))) ≅ wcEtGm T'.left :=
      (fullyFaithfulSheafToPresheaf _ _).preimageIso
        ((Functor.isoWhiskerLeft (wcEtSlice T').op
          (@asIso _ _ _ _ (toSheafify (Scheme.smallEtaleTopology (Spec (.of K)))
            (wcEtGmPre (Spec (.of K)))) (isIso_toSheafify _ (wc_et_gm_pre_isSheaf _)))).symm ≪≫
          @asIso _ _ _ _ (toSheafify (Scheme.smallEtaleTopology T'.left) (wcEtGmPre T'.left))
            (isIso_toSheafify _ (wc_et_gm_pre_isSheaf T'.left)))
    obtain ⟨Jr, φ, hφ⟩ := wc_injective_resolution_transfer Lf Rf adj
      (wcEtGm (Spec (.of K))) (wcEtGm T'.left) eG I
    let top := wcEtTop T'.left
    have hterm : Limits.IsTerminal top :=
      @MorphismProperty.Over.mkIdTerminal _ _ @Etale T'.left
        MorphismProperty.IsMultiplicative.toContainsIdentities
    obtain ⟨ε, hεnat, hε0⟩ := wc_et_const_hom_sections_equiv T'.left top hterm
    let ev : ∀ m, (I.cocomplex.X m).obj.obj (Opposite.op T') ≃+
        (Jr.cocomplex.X m).obj.obj (Opposite.op top) := fun m =>
      (((sheafToPresheaf _ _).mapIso (φ m)).app (Opposite.op top)).addCommGroupIsoToAddEquiv
    have hcomm : ∀ m (x : (I.cocomplex.X m).obj.obj (Opposite.op T')),
        ev (m + 1) (((I.cocomplex.d m (m + 1)).hom.app (Opposite.op T')).hom x) =
          ((Jr.cocomplex.d m (m + 1)).hom.app (Opposite.op top)).hom (ev m x) := by
      intro m x
      exact congrArg (fun k => (k.hom.app (Opposite.op top)).hom x) (hφ m)
    have hc2 : ev (q + 2) (((I.cocomplex.d (q + 1) (q + 2)).hom.app (Opposite.op T')).hom c') =
        ((Jr.cocomplex.d (q + 1) (q + 2)).hom.app (Opposite.op top)).hom (ev (q + 1) c') :=
      hcomm (q + 1) c'
    rw [hc', map_zero] at hc2
    obtain ⟨f, hfdef⟩ : ∃ f, ε (Jr.cocomplex.X (q + 1)) f = ev (q + 1) c' :=
      ⟨_, Equiv.apply_symm_apply _ _⟩
    have hf : f ≫ Jr.cocomplex.d (q + 1) (q + 2) = 0 := by
      apply (ε (Jr.cocomplex.X (q + 2))).injective
      rw [hεnat, hfdef, hε0]
      exact hc2.symm
    obtain ⟨g, hg⟩ := wc_ext_vanish_cocycle_lift
      ((constantSheaf (Scheme.smallEtaleTopology T'.left) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm T'.left) Jr q hExt f hf
    refine ⟨(ev q).symm (ε (Jr.cocomplex.X q) g), ?_⟩
    apply (ev (q + 1)).injective
    rw [hcomm q, AddEquiv.apply_symm_apply, ← hεnat, hg, hfdef]

  obtain ⟨n, L, instF, alg, halg, t, hopen, hdisj, hcov⟩ :=
    wc_et_affine_etale_field_split K T.left T.hom
  let Ti : Fin n → (Spec (.of K)).Etale := fun i =>
    haveI := hopen i
    MorphismProperty.Over.mk ⊤ (t i ≫ T.hom) inferInstance
  let τ : ∀ i, Ti i ⟶ T := fun i => MorphismProperty.Over.homMk (t i) rfl trivial
  have hlocal : ∀ i, ∃ e : (I.cocomplex.X q).obj.obj (Opposite.op (Ti i)),
      ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op (Ti i))).hom e =
        ((I.cocomplex.X (q + 1)).obj.map (τ i).op).hom c := by
    intro i
    letI := alg i
    apply key (Ti i) (hL (L i) (halg i) q)
    have h1 := (I.cocomplex.d (q + 1) (q + 2)).hom.naturality (τ i).op
    have h2 := congrArg (fun φ => φ.hom c) h1
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h2
    rw [h2, hc, map_zero]
  choose eloc heloc using hlocal
  have hbij := fun F => wc_et_disjoint_cover_bijective T n Ti τ (fun i => hopen i) hdisj hcov F
  obtain ⟨e, he⟩ := (hbij (I.cocomplex.X q)).2 eloc
  refine ⟨e, (hbij (I.cocomplex.X (q + 1))).1 ?_⟩
  funext i
  have he' := congrFun he i
  simp only at he'
  show ((I.cocomplex.X (q + 1)).obj.map (τ i).op).hom
      (((I.cocomplex.d q (q + 1)).hom.app (Opposite.op T)).hom e) =
    ((I.cocomplex.X (q + 1)).obj.map (τ i).op).hom c
  have h1 := (I.cocomplex.d q (q + 1)).hom.naturality (τ i).op
  have h2 := congrArg (fun φ => φ.hom e) h1
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h2
  rw [← h2, he', heloc i]

theorem wc_et_gm_generic_push_acyclic : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X],
    (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    (∀ (L : Type u) [Field L] [Algebra X.functionField L], Algebra.IsAlgebraic X.functionField L →
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of L)))
        (q + 1))) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (wcEtGmAt X (genericPoint X)) (q + 1)) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim hL
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q

  have hGmSheaf : ∀ S : Scheme.{u}, Presheaf.IsSheaf (Scheme.smallEtaleTopology S) (wcEtGmPre S) := by
    intro S
    have hrep : (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}).IsRepresentable :=
      (Functor.RepresentableBy.mk (F := Scheme.Γ.{u} ⋙ forget CommRingCat.{u})
        (Y := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ))))
        (fun {U} => (AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := U)).trans
          (Equiv.funUnique PUnit.{u+1} Γ(U, ⊤)))
        (by intro U U' f g; rfl)).isRepresentable
    have hΓt : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ.{u} ⋙ forget CommRingCat.{u}) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hUt : Presieve.IsSheaf Scheme.fpqcTopology.{u}
        (Scheme.Γ.{u} ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ forget CommGrpCat) := by
      intro Y S hS x hx
      have h := hΓt S hS
      let P := Scheme.Γ.{u}
      let U := Scheme.Γ.{u} ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ forget CommGrpCat
      let e : ∀ Z : Scheme.{u}, U.obj (Opposite.op Z) ≃ (P.obj (Opposite.op Z))ˣ :=
        fun _ => Equiv.refl _
      have hmap : ∀ {Z Z' : Scheme.{u}} (g : Z' ⟶ Z) (w : U.obj (Opposite.op Z)),
          ((e Z' (U.map g.op w) : (P.obj (Opposite.op Z'))ˣ) : P.obj (Opposite.op Z')) =
