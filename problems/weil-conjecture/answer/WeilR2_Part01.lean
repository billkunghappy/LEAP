open Classical in
noncomputable def wcNatOf {C : Type*} [Category C] {D : Type*} [Category D] [Preadditive D]
    {F G : C ⥤ D} (a : ∀ X, F.obj X ⟶ G.obj X) : F ⟶ G :=
  if h : ∀ ⦃X Y : C⦄ (f : X ⟶ Y), F.map f ≫ a Y = a X ≫ G.map f then
    { app := a, naturality := h } else 0

open Classical in
noncomputable def wcExtOfMaps {C : Type*} [Category C] [Abelian C] [HasExt C] {A B D : C}
    (f : A ⟶ B) (g : B ⟶ D) : Abelian.Ext D A 1 :=
  if h : f ≫ g = 0 then
    (if hS : (ShortComplex.mk f g h).ShortExact then hS.extClass else 0)
  else 0

noncomputable def wcTensFun (A B : CommRingCat.{u} ⥤ AddCommGrpCat.{u}) :
    CommRingCat.{u} ⥤ AddCommGrpCat.{u} where
  obj R := AddCommGrpCat.of (TensorProduct ℤ (A.obj R) (B.obj R))
  map f := AddCommGrpCat.ofHom (TensorProduct.map (A.map f).hom.toIntLinearMap
    (B.map f).hom.toIntLinearMap).toAddMonoidHom
  map_id R := by
    ext x
    change TensorProduct.map _ _ x = x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r p => simp
    | add x y hx hy => rw [map_add, hx, hy]
  map_comp f g := by
    ext x
    change TensorProduct.map _ _ x = TensorProduct.map _ _ (TensorProduct.map _ _ x)
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r p => simp
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]

noncomputable def wcTensNat {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A')
    (β : B ⟶ B') : wcTensFun A B ⟶ wcTensFun A' B' :=
  wcNatOf (fun R => AddCommGrpCat.ofHom
    (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom)

