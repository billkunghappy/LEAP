def wcSmsConeExact {B W : CochainComplex AddCommGrpCat.{u+1} ℕ} (Ψ' : B ⟶ W) : Prop :=
  (∀ (β : B.X 1) (γ : W.X 0), (B.d 1 2).hom β = 0 → (Ψ'.f 1).hom β = (W.d 0 1).hom γ →
      ∃ b : B.X 0, (B.d 0 1).hom b = β ∧ (Ψ'.f 0).hom b = γ) ∧
    (∀ (n : ℕ) (β : B.X (n + 2)) (γ : W.X (n + 1)), (B.d (n + 2) (n + 3)).hom β = 0 →
      (Ψ'.f (n + 2)).hom β = (W.d (n + 1) (n + 2)).hom γ →
      ∃ (b : B.X (n + 1)) (w : W.X n), (B.d (n + 1) (n + 2)).hom b = β ∧
        (Ψ'.f (n + 1)).hom b + (W.d n (n + 1)).hom w = γ) ∧
    (∀ b : B.X 0, (B.d 0 1).hom b = 0 → (Ψ'.f 0).hom b = 0 → b = 0)

noncomputable def wcSmsTwMapF {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} {Y Y' : CochainComplex 𝒜 ℕ}
    {lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)} {lamY' : MonoidAlgebra ℤ_[ℓ] Γ → (Y' ⟶ Y')}
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (u : Y ⟶ Y') (hu : ∀ x, lamY x ≫ u = u ≫ lamY' x)
    (k : ℕ) : wcSpfTw (Y.X k) (fun x => (lamY x).f k) ρ ⟶ wcSpfTw (Y'.X k) (fun x => (lamY' x).f k) ρ :=
  Limits.kernel.map (wcSpfTwD (Y.X k) (fun x => (lamY x).f k) ρ)
    (wcSpfTwD (Y'.X k) (fun x => (lamY' x).f k) ρ)
    (Limits.Pi.map (fun _ => u.f k)) (Limits.Pi.map (fun _ => u.f k)) (by
      have hk : ∀ x, (lamY x).f k ≫ u.f k = u.f k ≫ (lamY' x).f k := fun x => by
        rw [← HomologicalComplex.comp_f, hu, HomologicalComplex.comp_f]
      apply Limits.Pi.hom_ext
      intro aj
      simp only [wcSpfTwD, Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.map_π,
        Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.sub_comp,
        Preadditive.comp_sub, Preadditive.sum_comp, Preadditive.comp_sum,
        Preadditive.nsmul_comp, Preadditive.comp_nsmul, hk])

noncomputable def wcSmsTwMap {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} {Y Y' : CochainComplex 𝒜 ℕ}
    {lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)} {lamY' : MonoidAlgebra ℤ_[ℓ] Γ → (Y' ⟶ Y')}
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (u : Y ⟶ Y') (hu : ∀ x, lamY x ≫ u = u ≫ lamY' x) :
    wcSpfTwCx Y lamY ρ ⟶ wcSpfTwCx Y' lamY' ρ :=
  CochainComplex.ofHom (X := wcSpfTwCx Y lamY ρ) (Y := wcSpfTwCx Y' lamY' ρ)
    (fun k => wcSmsTwMapF ρ u hu k)
    (fun k => by
      have hd : ∀ (Z : CochainComplex 𝒜 ℕ) (lamZ : MonoidAlgebra ℤ_[ℓ] Γ → (Z ⟶ Z)),
          (wcSpfTwCx Z lamZ ρ).d k (k + 1) ≫
            Limits.kernel.ι (wcSpfTwD (Z.X (k + 1)) (fun x => (lamZ x).f (k + 1)) ρ) =
          Limits.kernel.ι (wcSpfTwD (Z.X k) (fun x => (lamZ x).f k) ρ) ≫
            Limits.Pi.map (fun _ => Z.d k (k + 1)) := fun Z lamZ => by
        dsimp only [wcSpfTwCx]
        erw [CochainComplex.of_d]
        exact Limits.kernel.lift_ι _ _ _
      have hF : ∀ j, wcSmsTwMapF ρ u hu j ≫
            Limits.kernel.ι (wcSpfTwD (Y'.X j) (fun x => (lamY' x).f j) ρ) =
          Limits.kernel.ι (wcSpfTwD (Y.X j) (fun x => (lamY x).f j) ρ) ≫
            Limits.Pi.map (fun _ => u.f j) := fun j => Limits.kernel.lift_ι _ _ _
      have sq : ∀ {K0 K0' K1 K1' P0 P0' P1 P1' : 𝒜} (ι0 : K0 ⟶ P0) (ι0' : K0' ⟶ P0')
          (ι1 : K1 ⟶ P1) (ι1' : K1' ⟶ P1') (_ : Mono ι1') (A : K0 ⟶ K0') (B : K1 ⟶ K1')
          (dY : K0 ⟶ K1) (dY' : K0' ⟶ K1') (pA : P0 ⟶ P0') (pB : P1 ⟶ P1') (pd : P0 ⟶ P1)
          (pd' : P0' ⟶ P1'), A ≫ ι0' = ι0 ≫ pA → B ≫ ι1' = ι1 ≫ pB → dY ≫ ι1 = ι0 ≫ pd →
          dY' ≫ ι1' = ι0' ≫ pd' → pA ≫ pd' = pd ≫ pB → A ≫ dY' = dY ≫ B := by
        intro K0 K0' K1 K1' P0 P0' P1 P1' ι0 ι0' ι1 ι1' _ A B dY dY' pA pB pd pd' hA hB hd hd' hp
        refine (cancel_mono ι1').1 ?_
        rw [Category.assoc, hd', ← Category.assoc, hA, Category.assoc, hp, Category.assoc, hB,
          reassoc_of% hd]
      refine sq _ _ _ _ Limits.equalizer.ι_mono _ _ _ _ _ _ _ _ (hF k) (hF (k + 1))
        (hd Y lamY) (hd Y' lamY') ?_
      apply Limits.Pi.hom_ext
      intro i
      simp only [Category.assoc, Limits.Pi.map_π, Limits.Pi.map_π_assoc,
        HomologicalComplex.Hom.comm])
noncomputable def wcCcModPre {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (n : ℕ) :
    (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  wcExtZeroPre ((wcPbFun q).op ⋙ continuousMapPresheafAb.{0, u} (ZMod n) ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u})
    (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
