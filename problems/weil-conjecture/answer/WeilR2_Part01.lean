  ∃ f : Fin (2 * n + 1) → ((Fin (N + 1) → Fin (N + 1) → K) →ₗ[K] K),
    ∀ w : Fin (N + 1) → Fin (N + 1) → K, (∀ i, f i w = 0) →
      wcLdpSing2 K N κ (wcLdpQuad K N w) x ∧ wcLdpSing2 K N κ (wcLdpQuad K N w) x'
