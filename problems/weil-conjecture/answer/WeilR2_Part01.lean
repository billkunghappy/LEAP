    (wcNatOf (F := wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k))
      (G := wcLpttEtPre Y (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) k)))
      (fun W => AddCommGrpCat.ofHom
        (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((TensorProduct.mk ℤ ((wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
              ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
              (FreeAbelianGroup.of
                (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (s i),
                  by
                    have h := hℓ.map W.unop.hom.appTop.hom
                    rw [map_natCast] at h
                    exact h⟩ :
                  (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left))))).toAddMonoidHom.comp
            AddEquiv.ulift.toAddMonoidHom))))

noncomputable def wcLpttGen0 (Y : Scheme.{u}) (ℓ n : ℕ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
