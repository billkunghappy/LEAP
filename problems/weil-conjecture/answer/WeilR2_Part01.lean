structure wcEtPullData {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ) where
  cont : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')
  φ : wcEtZModRing S n ⟶
    (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange g) RingCat.{u+1} _
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S') cont).obj (wcEtZModRing S' n)
  Φ : SheafOfModules.{u+1} (wcEtZModRing S n) ⥤ SheafOfModules.{u+1} (wcEtZModRing S' n)
  adj : Φ ⊣ @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ cont φ
  additive : Φ.Additive
  presLim : Limits.PreservesFiniteLimits Φ
  presColim : Limits.PreservesFiniteColimits Φ
  μ : Φ.obj (SheafOfModules.unit (wcEtZModRing S n)) ≅ SheafOfModules.unit (wcEtZModRing S' n)

noncomputable def wcEtPull {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ}
    (D : wcEtPullData g n) (i : ℕ) : wcEtZModExt S n i →+ wcEtZModExt S' n i :=
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  ((Abelian.Ext.mk₀ D.μ.inv).precomp _ (zero_add i)).comp
    (((Abelian.Ext.mk₀ D.μ.hom).postcomp _ (add_zero i)).comp (D.Φ.mapExtAddHom _ _ i))
def wcpaDjFmlNCSet (Z : Scheme.{u}) (B : Set Z) : Prop :=
  IsClosed B ∧ ∀ z : Z, ∃ (n : ℕ)
    (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))
    (J : Finset (Fin n)) (f : Z.presheaf.stalk z),
    (n : WithBot ℕ∞) = ringKrullDim (Z.presheaf.stalk z) ∧
    Ideal.span (Set.range s) = (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)).map
      (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) ∧
    Associated (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) f)
      (∏ j ∈ J, s j) ∧
    ∀ (z' : Z) (h : z' ⤳ z), (z' ∈ B ↔ (Z.presheaf.stalkSpecializes h).hom f ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk z'))

def wcpaDjMonoNodeForm {Y S : Scheme.{u}} (g : Y ⟶ S) (D : Set S) : Prop :=
  ∀ y : Y, (∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) ∨
    ∃ (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (J : Finset (Fin n)) (a : Fin n → ℕ),
      (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk (g y)) ∧
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)) ∧
      (∀ (p' : S) (h : p' ⤳ g y), (p' ∈ D ↔ ∃ j ∈ J, (S.presheaf.stalkSpecializes h).hom (t j) ∈
          IsLocalRing.maximalIdeal (S.presheaf.stalk p'))) ∧
      (∀ j, a j ≠ 0 → j ∈ J) ∧
      ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y) ≃+*
          (MvPowerSeries (Fin 2) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))) ⧸
            Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (∏ j,
              (algebraMap (S.presheaf.stalk (g y)) (AdicCompletion (IsLocalRing.maximalIdeal
                (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y))) (t j)) ^ a j)}),
        e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (AdicCompletion (IsLocalRing.maximalIdeal
            (Y.presheaf.stalk y)) (Y.presheaf.stalk y))).comp (g.stalkMap y).hom) =
          (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (algebraMap (S.presheaf.stalk (g y))
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y)))))
noncomputable def wcLdpQuad (L : Type u) [Field L] (N : ℕ) (a : Fin (N + 1) → Fin (N + 1) → L) :
    MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L 2 :=
  ⟨∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
      MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q),
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr
      (MvPolynomial.IsHomogeneous.sum _ _ _ fun p _ =>
        MvPolynomial.IsHomogeneous.sum _ _ _ fun q _ =>
          MvPolynomial.IsHomogeneous.C_mul
            ((MvPolynomial.isHomogeneous_X L p).mul (MvPolynomial.isHomogeneous_X L q)) _)⟩

def wcLdpCrit (E : Type u) [Field E] (N : ℕ) {X : Scheme.{u}} (s : X ⟶ Spec (.of E))
    (ι : X ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (x : X) : Prop :=
  ¬ wcLdpOnAxis E N ι G₀ G₁ x ∧ ∃ (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
    ¬ wcLdpSubmersive E s x (wcLdpGerm E N ι G₀ a x hx) (wcLdpGerm E N ι G₁ a x hx)

def wcLdpAxisReg (E : Type u) [Field E] (N : ℕ) {X : Scheme.{u}} (ι : X ⟶ wcProjK E N)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (x : X) : Prop :=
  wcLdpOnAxis E N ι G₀ G₁ x → ∀ (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
    ∃ (k : ℕ) (t : Fin k → X.presheaf.stalk x),
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) =
        Ideal.span (insert (wcLdpGerm E N ι G₀ a x hx)
          (insert (wcLdpGerm E N ι G₁ a x hx) (Set.range t))) ∧
      ((k + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim (X.presheaf.stalk x)

def wcLdpODPAt (E : Type u) [Field E] (N n : ℕ) {X : Scheme.{u}} (ι : X ⟶ wcProjK E N)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (x : X) : Prop :=
  ∀ (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
    ∃ (t : Fin n → X.presheaf.stalk x) (A : Matrix (Fin n) (Fin n) (X.presheaf.stalk x)),
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) = Ideal.span (Set.range t) ∧
      wcLdpGerm E N ι H a x hx - ∑ k, ∑ l, A k l * t k * t l ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 3 ∧
      IsUnit (A + A.transpose).det
