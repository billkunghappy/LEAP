  have sesSec : ∀ {A Bs Qs : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (f : A ⟶ Bs) (g : Bs ⟶ Qs) (hfg : f ≫ g = 0),
      (ShortComplex.mk f g hfg).ShortExact →
      (∀ (U : X.Etale) (a : A.obj.obj (Opposite.op U)), f.hom.app (Opposite.op U) a = 0 → a = 0) ∧
      (∀ (U : X.Etale) (b : Bs.obj.obj (Opposite.op U)), g.hom.app (Opposite.op U) b = 0 →
        ∃ a, f.hom.app (Opposite.op U) a = b) := by
    intro A Bs Qs f g hfg hS
