abbrev wcpaDjGltHat (Y : Scheme.{u}) (y : Y) : Type u :=
  AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)

def wcpaDjGltLocModel {Y S : Scheme.{u}} (g : Y ⟶ S) {V : Y.Opens} {ι : Type} (I : Finset ι)
    (r : ι → Γ(Y, V)) (y : Y) (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (α : ι → ℤ)
    (β : ι → Fin n → ℤ) (c : Fin n → ℕ) (x : wcpaDjGltHat Y y) : Prop :=
  (∀ i ∈ I, ∃ num den : Y.presheaf.stalk y, wcpaDjStcRatioLink (r i) y num den ∧
    wcpaDjStcMonRel x
      (fun l => algebraMap (Y.presheaf.stalk y) (wcpaDjGltHat Y y) ((g.stalkMap y).hom (t l)))
      (algebraMap (Y.presheaf.stalk y) (wcpaDjGltHat Y y) num)
      (algebraMap (Y.presheaf.stalk y) (wcpaDjGltHat Y y) den) (α i) (β i)) ∧
  (((∃ l, c l ≠ 0) ∧
    ∃ (v : (wcpaDjGltHat S (g y))ˣ)
      (e : wcpaDjGltHat Y y ≃+*
        (MvPowerSeries (Fin 2) (wcpaDjGltHat S (g y)) ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (↑v * ∏ l,
            (algebraMap (S.presheaf.stalk (g y)) (wcpaDjGltHat S (g y)) (t l)) ^ c l)})),
      e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (wcpaDjGltHat Y y)).comp
          (g.stalkMap y).hom) =
        (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp
          (algebraMap (S.presheaf.stalk (g y)) (wcpaDjGltHat S (g y)))) ∧
      e x = Ideal.Quotient.mk _ (MvPowerSeries.X 0)) ∨
   (c = 0 ∧ ∃ e : wcpaDjGltHat Y y ≃+* PowerSeries (wcpaDjGltHat S (g y)),
      e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (wcpaDjGltHat Y y)).comp
          (g.stalkMap y).hom) =
        PowerSeries.C.comp (algebraMap (S.presheaf.stalk (g y)) (wcpaDjGltHat S (g y))) ∧
      e x = PowerSeries.X))

noncomputable def wcpaDjGltMon {R : Type u} [CommRing R] {n N : ℕ} (I : Finset (Fin (N + 1)))
    (x : R) (t : Fin n → R) (α : Fin (N + 1) → ℤ) (β : Fin (N + 1) → Fin n → ℤ) (a₀ : ℤ)
    (b₀ : Fin n → ℤ) (i : Fin (N + 1)) : R :=
  if i ∈ I then x ^ (α i - a₀).toNat * ∏ l, t l ^ (β i l - b₀ l).toNat else 0

def wcpaDjGltNC (R : Type u) [CommRing R] {N : ℕ} (F : Fin (N + 1) → R)
    (k₀ : Fin (N + 1)) : Type u :=
  ↥(integralClosure (wcpaDjChart R F k₀) (Localization.Away (F k₀)))

noncomputable instance wcpaDjGltNC.instCommRing (R : Type u) [CommRing R] {N : ℕ}
    (F : Fin (N + 1) → R) (k₀ : Fin (N + 1)) : CommRing (wcpaDjGltNC R F k₀) :=
  inferInstanceAs (CommRing ↥(integralClosure (wcpaDjChart R F k₀) (Localization.Away (F k₀))))

noncomputable def wcpaDjGltNCMap (R : Type u) [CommRing R] {N : ℕ} (F : Fin (N + 1) → R)
    (k₀ : Fin (N + 1)) : R →+* wcpaDjGltNC R F k₀ :=
  (algebraMap (wcpaDjChart R F k₀)
      ↥(integralClosure (wcpaDjChart R F k₀) (Localization.Away (F k₀)))).comp
    (algebraMap R (wcpaDjChart R F k₀))

def wcpaDjGltChartId {C Y : Scheme.{u}} (π : C ⟶ Y) (c : C) {N : ℕ}
    (F : Fin (N + 1) → wcpaDjGltHat Y (π c)) (k₀ : Fin (N + 1))
    (Q : Ideal (wcpaDjGltNC (wcpaDjGltHat Y (π c)) F k₀)) [Q.IsPrime]
    (e : wcpaDjGltHat C c ≃+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime Q))
      (Localization.AtPrime Q)) : Prop :=
  Q.comap ((wcpaDjGltNCMap (wcpaDjGltHat Y (π c)) F k₀).comp
      (algebraMap (Y.presheaf.stalk (π c)) (wcpaDjGltHat Y (π c)))) =
    IsLocalRing.maximalIdeal (Y.presheaf.stalk (π c)) ∧
  e.toRingHom.comp ((algebraMap (C.presheaf.stalk c) (wcpaDjGltHat C c)).comp
      (π.stalkMap c).hom) =
    (algebraMap (Localization.AtPrime Q) (AdicCompletion
        (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) (Localization.AtPrime Q))).comp
      ((algebraMap (wcpaDjGltNC (wcpaDjGltHat Y (π c)) F k₀) (Localization.AtPrime Q)).comp
        ((wcpaDjGltNCMap (wcpaDjGltHat Y (π c)) F k₀).comp
          (algebraMap (Y.presheaf.stalk (π c)) (wcpaDjGltHat Y (π c)))))
def wcH2rGam (ℓ k n : ℕ) : Type u := ULift.{u} (Multiplicative (AddAut (Fin k → ZMod (ℓ ^ n))))

noncomputable instance wcH2rGamGroup (ℓ k n : ℕ) : Group (wcH2rGam.{u} ℓ k n) :=
