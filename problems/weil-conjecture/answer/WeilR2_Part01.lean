    (κ : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)).obj
      (SheafOfModules.unit (wcIntRingSheaf T ℓ)) ≅ wcIntSheaf T ℓ) : Prop :=
