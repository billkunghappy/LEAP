  let eQ := QuotientAddGroup.congr _ _ eu hmap

  obtain ⟨ψ⟩ := wc_et_gm_zariski_restriction X hcont hP
  let φ : ε.obj G ≅ 𝒰.obj F :=
    (fullyFaithfulSheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u+1}).preimageIso ψ
  let P1 := (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let Tr : Abelian.Ext P1 (ε.obj G) 1 ≃+ Abelian.Ext P1 (𝒰.obj F) 1 :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ φ.hom) (add_zero 1)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ φ.inv) (add_zero 1)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      map_add' := fun x y => Abelian.Ext.add_comp x y _ _ }
  exact ⟨eE.trans (eZ.symm.trans (Tr.trans (eU.trans (eQ.trans eF.symm))))⟩

theorem wc_et_gm_to_generic_mono : ∀ (X : Scheme.{u}) [IsIntegral X],
    Mono (wcEtGmToAt X (genericPoint X)) :=
by
  intro X _

  have s3 : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) [Flat f] (V : X.Opens), IsAffineOpen V →
      (V : Set X).Nonempty → ∀ (W : Y.Opens) (hW : IsAffineOpen W), W ≤ f ⁻¹ᵁ V →
      ∀ s : Γ(Y, ⊤), (Limits.pullback.fst f (X.fromSpecStalk (genericPoint X))).appTop s = 0 →
        hW.fromSpec.appTop s = 0 := by
    intro Y f _ V hV hne W hW e s hs
    have hη : genericPoint X ∈ V :=
      ((genericPoint_spec X).mem_open_set_iff V.isOpen).mpr (by simpa using hne)
    let φ := f.appLE V W e
    let g := X.presheaf.germ V (genericPoint X) hη
    letI : Algebra Γ(X, V) Γ(Y, W) := φ.hom.toAlgebra
    letI : Algebra Γ(X, V) (X.presheaf.stalk (genericPoint X)) := g.hom.toAlgebra
    haveI : Module.Flat Γ(X, V) Γ(Y, W) := Flat.flat_appLE f hV hW e
    have hginj : Function.Injective (algebraMap Γ(X, V) (X.presheaf.stalk (genericPoint X))) :=
      germ_injective_of_isIntegral X _ hη
    let T := CommRingCat.of (TensorProduct Γ(X, V) Γ(Y, W) (X.presheaf.stalk (genericPoint X)))
    let inl : Γ(Y, W) ⟶ T := CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := Γ(X, V)) (A := Γ(Y, W)) (B := X.presheaf.stalk (genericPoint X)))
    let inr : X.presheaf.stalk (genericPoint X) ⟶ T :=
      CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := Γ(X, V)) (A := Γ(Y, W)) (B := X.presheaf.stalk (genericPoint X))).toRingHom
    have hsq : φ ≫ inl = g ≫ inr := by
      have := (CommRingCat.isPushout_tensorProduct Γ(X, V) Γ(Y, W)
        (X.presheaf.stalk (genericPoint X))).toCommSq.w
      exact this
    have hinl : Function.Injective inl.hom := fun a b hab =>
      Algebra.TensorProduct.includeLeft_injective (S := Γ(X, V)) hginj hab
    have e1 : Spec.map φ ≫ hV.fromSpec = hW.fromSpec ≫ f :=
      IsAffineOpen.SpecMap_appLE_fromSpec f hV hW e
    have e2 : Spec.map g ≫ hV.fromSpec = X.fromSpecStalk (genericPoint X) :=
      (IsAffineOpen.fromSpecStalk.eq_1 hV hη).symm.trans (hV.fromSpecStalk_eq_fromSpecStalk hη)
    have hw : (Spec.map inl ≫ hW.fromSpec) ≫ f = Spec.map inr ≫ X.fromSpecStalk (genericPoint X) := by
      rw [Category.assoc, ← e1, ← e2, ← Category.assoc, ← Category.assoc, ← Spec.map_comp,
        ← Spec.map_comp, hsq]
    have hm : Limits.pullback.lift _ _ hw ≫ Limits.pullback.fst f (X.fromSpecStalk (genericPoint X)) =
        Spec.map inl ≫ hW.fromSpec := Limits.pullback.lift_fst _ _ _
    have h1 : (Spec.map inl).appTop (hW.fromSpec.appTop s) = 0 := by
      have : (Spec.map inl ≫ hW.fromSpec).appTop s = 0 := by
        rw [← hm, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, hs, map_zero]
      rwa [Scheme.Hom.comp_appTop, CommRingCat.comp_apply] at this
    have h2 : inl ((Scheme.ΓSpecIso Γ(Y, W)).hom (hW.fromSpec.appTop s)) = 0 := by
      rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_naturality, CommRingCat.comp_apply, h1, map_zero]
    have h3 : (Scheme.ΓSpecIso Γ(Y, W)).hom (hW.fromSpec.appTop s) = 0 :=
      hinl (h2.trans (map_zero inl.hom).symm)
    rw [← Iso.hom_inv_id_apply (Scheme.ΓSpecIso Γ(Y, W)) (hW.fromSpec.appTop s), h3, map_zero]

  have s2 : ∀ (Y : Scheme.{u}) (W : Y.Opens) (hW : IsAffineOpen W) (s : Γ(Y, ⊤)),
      hW.fromSpec.appTop s =
        (Scheme.ΓSpecIso Γ(Y, W)).inv (Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op s) := by
    intro Y W hW s
    have key : hW.fromSpec.appTop =
        Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ (Scheme.ΓSpecIso Γ(Y, W)).inv := by
      rw [← hW.isoSpec_inv_ι, Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_inv_appTop,
        Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      erw [← Functor.map_comp_assoc]
      rfl
    rw [key, CommRingCat.comp_apply]

  have s4 : ∀ (Y P : Scheme.{u}) (f : Y ⟶ X) (p : P ⟶ Y),
      (∀ V : X.Opens, IsAffineOpen V → (V : Set X).Nonempty → ∀ W : Y.Opens, IsAffineOpen W →
        W ≤ f ⁻¹ᵁ V → ∀ s : Γ(Y, ⊤), p.appTop s = 0 →
          Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op s = 0) →
      Function.Injective p.appTop.hom := by
    intro Y P f p H
    rw [injective_iff_map_eq_zero]
    intro s hs
    apply TopCat.Presheaf.section_ext Y.sheaf ⊤ s 0
    intro y hy
    change (Y.presheaf.germ ⊤ y hy) s = (Y.presheaf.germ ⊤ y hy) 0
    obtain ⟨V, hV, hfyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := f y) (U := ⊤) trivial
    obtain ⟨W, hW, hyW, hWsub⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := f ⁻¹ᵁ V) hfyV
    have h0 := H V hV ⟨f y, hfyV⟩ W hW hWsub s hs
    rw [map_zero, ← TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (le_top : W ≤ ⊤)) y hyW s,
      h0, map_zero]

  let G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u+1} := forget₂ CommRingCat CommMonCat ⋙
    CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}
  have hG : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S), Function.Injective φ.hom →
      Function.Injective (ConcreteCategory.hom (G'.map φ)) := by
    intro R S φ hφ a b hab
    have h' : φ.hom ((Additive.toMul a.down : Rˣ) : R) = φ.hom ((Additive.toMul b.down : Rˣ) : R) :=
      congrArg (fun x => ((Additive.toMul (ULift.down x) : Sˣ) : S)) hab
    exact ULift.ext _ _ (Additive.toMul.injective (Units.ext (hφ h')))
  have hinj : ∀ U : (Scheme.Etale X)ᵒᵖ,
      Function.Injective (ConcreteCategory.hom ((wcEtGmToAtPre X (genericPoint X)).app U)) := by
    intro U
    haveI : Etale U.unop.hom := U.unop.prop
    have hp : Function.Injective
        (Limits.pullback.fst U.unop.hom (X.fromSpecStalk (genericPoint X))).appTop.hom := by
      apply s4 U.unop.left _ U.unop.hom
      intro V hV hne W hW hle s hs
      have h := s3 U.unop.left U.unop.hom V hV hne W hW hle s hs
      rw [s2] at h
      rw [← Iso.inv_hom_id_apply (Scheme.ΓSpecIso _)
        (U.unop.left.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op s), h, map_zero]
    have hU : (wcEtGmToAtPre X (genericPoint X)).app U =
        G'.map (Scheme.Γ.map (Limits.pullback.fst U.unop.hom (X.fromSpecStalk (genericPoint X))).op) := by
      simp only [wcEtGmToAtPre, Functor.whiskerRight_app, NatTrans.op_app, Functor.whiskerLeft_app,
        Over.mapPullbackAdj_counit_app, Over.forget_map, Over.homMk_left, G']
      rfl
    rw [hU]
    apply hG
    rw [Scheme.Γ_map_op]
    exact hp
  haveI : Sheaf.IsLocallyInjective ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (wcEtGmToAtPre X (genericPoint X))) :=
    (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ _).mpr
      (Presheaf.isLocallyInjective_of_injective _ _ hinj)
  exact Sheaf.mono_of_isLocallyInjective ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (wcEtGmToAtPre X (genericPoint X)))

theorem wc_et_enough_injectives : ∀ (X : Scheme.{u}), EnoughInjectives (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
by
  intro X
  haveI : EssentiallySmall.{u+1} X.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}
  exact IsGrothendieckAbelian.enoughInjectives.{u+1}

theorem wc_et_cartan_criterion_const : ∀ (X : Scheme.{u}) [EnoughInjectives (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})]
    (B : X.Etale → Prop) (Cov : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale), (∀ i, V i ⟶ U) → Prop),
    (∀ U k V f, Cov U k V f → Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.smallEtaleTopology X U) →
    (∀ U k V f, Cov U k V f → ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      B (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) →
    (∀ U, B U → ∀ R ∈ Scheme.smallEtaleTopology X U, ∃ (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
      Cov U k V f ∧ ∀ i, R.arrows (f i)) →
    ∀ (T : X.Etale), Limits.IsTerminal T → B T →
    ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
    (∀ U k V f, Cov U k V f → wcCechAcyclic G.obj V f) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ n : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G (n + 1)) :=
by
  intro X _ B Cov H1 H2 H3 T hT hBT G H5
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _



  have dd : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U) (p : ℕ) (b : ∀ σ : Fin (p + 1) → Fin k, G.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (ρ : Fin (p + 3) → Fin k), ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) • G.map (wcCechFace V f ρ j).op (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) • G.map (wcCechFace V f (fun l => ρ (j.succAbove l)) i).op (b (fun l => ρ (j.succAbove (i.succAbove l))))) = 0 := by
    intro C _ _ G U k V f p b ρ
    have SV : ∀ {n : ℕ} (a : Fin (n + 1)) (x : Fin n),
        ((a.succAbove x : Fin (n + 1)) : ℕ) = if (x : ℕ) < (a : ℕ) then (x : ℕ) else (x : ℕ) + 1 := by
      intro n a x
      by_cases h : x.castSucc < a
      · rw [Fin.succAbove_of_castSucc_lt _ _ h]
        rw [Fin.lt_def, Fin.coe_castSucc] at h
        rw [if_pos h, Fin.coe_castSucc]
      · rw [Fin.succAbove_of_le_castSucc _ _ (not_lt.mp h)]
        rw [Fin.lt_def, Fin.coe_castSucc] at h
        rw [if_neg h, Fin.val_succ]
    let g : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun a =>
      if (a.2 : ℕ) < (a.1 : ℕ) then
        (⟨a.2, by have := a.2.isLt; omega⟩, ⟨a.1 - 1, by have := a.1.isLt; omega⟩)
      else (⟨a.2 + 1, by have := a.2.isLt; omega⟩, ⟨min a.1 (p + 1), by omega⟩)
    have hg1 : ∀ a : Fin (p + 3) × Fin (p + 2), (a.2 : ℕ) < (a.1 : ℕ) →
        ((g a).1 : ℕ) = a.2 ∧ ((g a).2 : ℕ) = a.1 - 1 := by
      intro a h
      have := a.2.isLt
      refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
    have hg2 : ∀ a : Fin (p + 3) × Fin (p + 2), ¬ (a.2 : ℕ) < (a.1 : ℕ) →
        ((g a).1 : ℕ) = a.2 + 1 ∧ ((g a).2 : ℕ) = a.1 := by
      intro a h
      have := a.2.isLt
      refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
    have gA : ∀ a : Fin (p + 3) × Fin (p + 2),
        (fun l : Fin (p + 1) => (g a).1.succAbove ((g a).2.succAbove l)) =
          fun l => a.1.succAbove (a.2.succAbove l) := by
      intro a
      funext l
      apply Fin.ext
      have h3 := a.1.isLt
      have h4 := a.2.isLt
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        simp only [SV, e1, e2]
        split_ifs <;> omega
      · obtain ⟨e1, e2⟩ := hg2 a h
        simp only [SV, e1, e2]
        split_ifs <;> omega
    have gB : ∀ a : Fin (p + 3) × Fin (p + 2),
        (-1 : ℤ) ^ ((g a).1 : ℕ) * (-1 : ℤ) ^ ((g a).2 : ℕ) =
          -((-1 : ℤ) ^ (a.1 : ℕ) * (-1 : ℤ) ^ (a.2 : ℕ)) := by
      intro a
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        rw [e1, e2]
        obtain ⟨m, hm⟩ : ∃ m, (a.1 : ℕ) = m + 1 := ⟨(a.1 : ℕ) - 1, by omega⟩
        rw [hm, Nat.add_sub_cancel, pow_succ]
        ring
      · obtain ⟨e1, e2⟩ := hg2 a h
        rw [e1, e2, pow_succ]
        ring
    have gC : ∀ a : Fin (p + 3) × Fin (p + 2), g a ≠ a := by
      intro a hc
      have hv : ((g a).1 : ℕ) = a.1 := by rw [hc]
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        omega
      · obtain ⟨e1, e2⟩ := hg2 a h
        omega
    have gD : ∀ a : Fin (p + 3) × Fin (p + 2), g (g a) = a := by
      intro a
      have h3 := a.1.isLt
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        have h' : ¬ ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
        obtain ⟨f1, f2⟩ := hg2 (g a) h'
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega
      · obtain ⟨e1, e2⟩ := hg2 a h
        have h' : ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
        obtain ⟨f1, f2⟩ := hg1 (g a) h'
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega
    have s2 : ∀ F : (Fin (p + 1) → Fin (p + 3)) →
        G.obj (Opposite.op (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l)))),
        ∑ j : Fin (p + 3), ∑ i : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
          F (fun l => j.succAbove (i.succAbove l)) = 0 := by
      intro F
      rw [← Fintype.sum_prod_type' (f := fun (j : Fin (p + 3)) (i : Fin (p + 2)) =>
          ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) • F (fun l => j.succAbove (i.succAbove l)))]
      refine Finset.sum_involution (fun a _ => g a) ?_ ?_ ?_ ?_
      · intro a _
        show ((-1 : ℤ) ^ (a.1 : ℕ) * (-1 : ℤ) ^ (a.2 : ℕ)) •
            F (fun l => a.1.succAbove (a.2.succAbove l)) +
          ((-1 : ℤ) ^ ((g a).1 : ℕ) * (-1 : ℤ) ^ ((g a).2 : ℕ)) •
            F (fun l => (g a).1.succAbove ((g a).2.succAbove l)) = 0
        rw [gA a, gB a, neg_smul, add_neg_cancel]
      · intro a _ _
        exact gC a
      · intro a _
        exact Finset.mem_univ _
      · intro a _
        exact gD a
    have hc : ∀ (j : Fin (p + 3)) (i : Fin (p + 2)),
        wcCechFace V f ρ j ≫ wcCechFace V f (fun l => ρ (j.succAbove l)) i =
          Limits.WidePullback.lift (Limits.WidePullback.base (fun l => f (ρ l)))
            (fun l => Limits.WidePullback.π (fun l => f (ρ l)) (j.succAbove (i.succAbove l)))
            (by simp) := by
      intro j i
      apply Limits.WidePullback.hom_ext
      · intro l
        simp only [wcCechFace, Category.assoc]
        erw [Limits.WidePullback.lift_π, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π]
      · simp only [wcCechFace, Category.assoc]
        erw [Limits.WidePullback.lift_base, Limits.WidePullback.lift_base,
          Limits.WidePullback.lift_base]
    refine Eq.trans ?_ (s2 (fun α => G.map (Limits.WidePullback.lift
        (Limits.WidePullback.base (fun l => f (ρ l)))
        (fun l => Limits.WidePullback.π (fun l => f (ρ l)) (α l)) (by simp)).op
        (b (fun l => ρ (α l)))))
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_zsmul, smul_smul]
    congr 1
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hc j i]



  have deg0 : ∀ {C : Type (u+1)} [Category.{u} C] [Limits.HasFiniteWidePullbacks C] {G I Q : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (ι : G ⟶ I) (π : I ⟶ Q), (∀ (W : C) (x : G.obj (Opposite.op W)), ι.app (Opposite.op W) x = 0 → x = 0) → (∀ (W : C) (y : I.obj (Opposite.op W)), π.app (Opposite.op W) y = 0 → ∃ x, ι.app (Opposite.op W) x = y) → (∀ (W : C) (x : G.obj (Opposite.op W)), π.app (Opposite.op W) (ι.app (Opposite.op W) x) = 0) → ∀ {U : C} {k : ℕ} (V : Fin k → C) (f : ∀ i, V i ⟶ U), (∀ (p : ℕ) (b : ∀ σ : Fin (p + 1) → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))) (ρ : Fin (p + 3) → Fin k), ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) • I.map (wcCechFace V f ρ j).op (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) • I.map (wcCechFace V f (fun l => ρ (j.succAbove l)) i).op (b (fun l => ρ (j.succAbove (i.succAbove l))))) = 0) → wcCechAcyclic G V f → ∀ (q : Q.obj (Opposite.op U)) (s : ∀ σ : Fin 1 → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))))), (∀ σ : Fin 1 → Fin k, π.app (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) (s σ) = Q.map (Limits.WidePullback.base (fun l => f (σ l))).op q) → ∃ w : ∀ σ : Fin 1 → Fin k, I.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))), (∀ σ : Fin 1 → Fin k, π.app (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))) (w σ) = Q.map (Limits.WidePullback.base (fun l => f (σ l))).op q) ∧ ∀ τ : Fin 2 → Fin k, ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) • I.map (wcCechFace V f τ j).op (w (fun l => τ (j.succAbove l))) = 0 := by
    intro C _ _ G I Q ι π hinj hex hzero U k V f hdd hG q s hs
    have hN : ∀ {F F' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ F') (p : ℕ)
        (b : ∀ σ : Fin (p + 1) → Fin k,
          F.obj (Opposite.op (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))))
        (τ : Fin (p + 2) → Fin k),
