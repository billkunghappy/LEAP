def wcWdHasDescent {T T' : Scheme.{u}} (k : T ⟶ T') (Fr : T ⟶ T) : Prop :=
  ∀ (E : Scheme.{u}) (πE : E ⟶ T) (FE FE' : E ⟶ E), IsFinite πE → Etale πE →
    FE ≫ FE' = 𝟙 E → FE' ≫ FE = 𝟙 E → FE ≫ πE = πE ≫ Fr →
    ∃ (Y : Scheme.{u}) (πY : Y ⟶ T') (j : E ⟶ Y), IsFinite πY ∧ Etale πY ∧ IsPullback j πE πY k ∧
      Surjective j ∧ FE ≫ j = j ∧
      ∀ (Y' : Scheme.{u}) (πY' : Y' ⟶ T') (E' : Scheme.{u}) (πE' : E' ⟶ T) (j' : E' ⟶ Y') (F2 : E' ⟶ E'),
        IsAffineHom πY' → j' ≫ πY' = πE' ≫ k → F2 ≫ πE' = πE' ≫ Fr → F2 ≫ j' = j' →
        ∀ f : E ⟶ E', f ≫ πE' = πE → f ≫ F2 = FE ≫ f →
          ∃! g : Y ⟶ Y', g ≫ πY' = πY ∧ j ≫ g = f ≫ j'

def wcWdRingCore.{w} : Prop :=
  ∀ (K : Type w) [Field K] [Finite K] (A : Type w) [CommRing A] [Algebra K A] [Algebra.FiniteType K A]
    (B : Type w) [CommRing B] [Algebra (TensorProduct K A (AlgebraicClosure K)) B] [Algebra A B]
    [IsScalarTower A (TensorProduct K A (AlgebraicClosure K)) B]
    [Module.Finite (TensorProduct K A (AlgebraicClosure K)) B]
    [Algebra.Etale (TensorProduct K A (AlgebraicClosure K)) B] (ψ : B ≃+* B),
    (∀ (r : TensorProduct K A (AlgebraicClosure K)) (b : B), ψ (r • b) = wcWdTau K A r • ψ b) →
    ∃ C : Subalgebra A B, (∀ b, b ∈ C ↔ ψ b = b) ∧ Module.Finite A C ∧
      Function.Bijective (Algebra.TensorProduct.productMap C.val
        (IsScalarTower.toAlgHom A (TensorProduct K A (AlgebraicClosure K)) B))
