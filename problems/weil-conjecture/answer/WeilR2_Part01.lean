noncomputable def wcSpfTwCx {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (Y : CochainComplex 𝒜 ℕ)
    (lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) :
    CochainComplex 𝒜 ℕ :=
  CochainComplex.of (fun k => wcSpfTw (Y.X k) (fun x => (lamY x).f k) ρ)
    (fun k => Limits.kernel.map _ _ (Limits.Pi.map (fun _ => Y.d k (k + 1)))
      (Limits.Pi.map (fun _ => Y.d k (k + 1))) (by
        apply Limits.Pi.hom_ext
        intro aj
