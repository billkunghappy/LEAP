  fun {T V} j Dj Wo Dw =>
    if h : wcQdPre j Dj Wo Dw then
      wcQdcbDelta Dj Dw (Classical.choose (hGEN j h.1 Dj h.2.2.2.1 Wo h.2.2.2.2.1 Dw h.2.2.2.2.2))
        n₀ n₁ h10
        ((Classical.choose_spec (hGEN j h.1 Dj h.2.2.2.1 Wo h.2.2.2.2.1 Dw h.2.2.2.2.2)).2 n₀)
        h.2.2.1
