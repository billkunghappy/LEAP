  (∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K)) ∧
  (∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
    (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
    ∃ z : W.left, w.left z = p) ∧
  (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
      (σ c) ≫ θ.hom =
    θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
      (wcConstScalar (wcP1Over K).left ℓ k c)) ∧
  (∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
    (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
    ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1) ∧
  (∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
    (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
      ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
        ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1)

def wcH2Link (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (J : Subobject G)
    (Uo : (wcP1Over K).left.Opens) (r : ℕ) (V : ℕ → Scheme.{u})
    (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u) [∀ n, Group (Γ n)]
    (α : (n : ℕ) → Γ n →* Aut (V n)) (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n))) : Prop :=
  ∃ hα : ∀ n γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι,
  ∀ n, 1 ≤ n → ∃ lam : Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) ⟶
      wcH2TwSheaf (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        (Γ n) (α n) (hα n) ℓ n r (ρ n),
    ∀ (T : (wcP1Over K).left.ProEt),
      (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
      (∀ s : (Limits.kernel lam).obj.obj (Opposite.op T), s = 0) ∧
      (∀ s : (Limits.cokernel lam).obj.obj (Opposite.op T), s = 0)
structure wcEtxcDatum {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    (fX : X ⟶ Spec (.of A)) {Ω : Type u} [Field Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (ℓ k : ℕ) where
  σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ
  hσQ1 : σQ ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst fX ξ
  hσQ2 : σQ ≫ Limits.pullback.snd fX ξ = Limits.pullback.snd fX ξ ≫ σ
  Dh : wcEtPullData (Limits.pullback.fst fX ξ) (ℓ ^ k)
  Dg : wcEtPullData (Limits.pullback.fst fX (wcQmSp A)) (ℓ ^ k)
  I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k)))
  DσQ : wcEtPullData σQ (ℓ ^ k)
  hφ : haveI := Dh.cont
    haveI := DσQ.cont
    haveI : (wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange σQ).IsContinuous
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ)) :=
      Functor.isContinuous_comp (wcEtBaseChange (Limits.pullback.fst fX ξ)) (wcEtBaseChange σQ)
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
        (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
    let α : wcEtBaseChange (Limits.pullback.fst fX ξ) ⟶
        wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange σQ :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u})
          (Limits.pullback.fst fX ξ) := ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
          (Limits.pullback.fst fX ξ) :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong (Limits.pullback.fst fX ξ)))
          (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong σQ)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) σQ (Limits.pullback.fst fX ξ) (Limits.pullback.fst fX ξ) hσQ1.symm).hom
    (Dh.φ ≫ ((wcEtBaseChange (Limits.pullback.fst fX ξ)).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ))).map DσQ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ))).app
          (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k)) = Dh.φ
  t : haveI := DσQ.additive
    (DσQ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex
  ht : haveI := DσQ.additive
    (DσQ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
      (HomologicalComplex.singleMapHomologicalComplex DσQ.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k))) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((DσQ.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange σQ) _ _ DσQ.cont DσQ.φ)) ≫
        I.ι'

noncomputable def wcEtxcDatum.Psi {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    {fX : X ⟶ Spec (.of A)} {Ω : Type u} [Field Ω] {ξ : Spec (.of Ω) ⟶ Spec (.of A)}
    {σ : Spec (.of Ω) ⟶ Spec (.of Ω)} {ℓ k : ℕ} (D : wcEtxcDatum fX ξ σ ℓ k) :
    CochainComplex (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX (wcQmSp A)) (ℓ ^ k))) ℤ :=
  haveI := D.Dh.additive
  haveI := D.DσQ.additive
  haveI := D.Dg.additive
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX ξ))
    _ _ D.Dh.cont D.Dh.φ
  haveI : P.Additive := Adjunction.right_adjoint_additive D.Dh.adj
  (D.Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
    ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj D.I.cochainComplex)

noncomputable def wcEtxcDatum.TPsi {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    {fX : X ⟶ Spec (.of A)} {Ω : Type u} [Field Ω] {ξ : Spec (.of Ω) ⟶ Spec (.of A)}
    {σ : Spec (.of Ω) ⟶ Spec (.of Ω)} {ℓ k : ℕ} (D : wcEtxcDatum fX ξ σ ℓ k) : D.Psi ⟶ D.Psi :=
  haveI := D.Dh.cont
  haveI := D.DσQ.cont
  haveI : (wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange D.σQ).IsContinuous
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ)) :=
    Functor.isContinuous_comp (wcEtBaseChange (Limits.pullback.fst fX ξ)) (wcEtBaseChange D.σQ)
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
      (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
  let α : wcEtBaseChange (Limits.pullback.fst fX ξ) ⟶
      wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange D.σQ :=
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u})
        (Limits.pullback.fst fX ξ) := ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        (Limits.pullback.fst fX ξ) :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong (Limits.pullback.fst fX ξ)))
        (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) D.σQ :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) D.σQ :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong D.σQ)) (@Etale : MorphismProperty Scheme.{u})
    (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
      (Q := ⊤) D.σQ (Limits.pullback.fst fX ξ) (Limits.pullback.fst fX ξ) D.hσQ1.symm).hom
  haveI := D.Dh.additive
  haveI := D.DσQ.additive
  haveI := D.Dg.additive
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX ξ))
    _ _ D.Dh.cont D.Dh.φ
  haveI : P.Additive := Adjunction.right_adjoint_additive D.Dh.adj
  let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange D.σQ) _ _ D.DσQ.cont D.DσQ.φ
  haveI : Pw.Additive := Adjunction.right_adjoint_additive D.DσQ.adj
  let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp D.Dh.φ D.DσQ.φ).hom ≫
      SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr D.hφ).hom
  let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app D.I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ D.DσQ.Φ ⋙ Pw from D.DσQ.adj.unit)
        (ComplexShape.up ℤ)).app D.I.cochainComplex ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (D.DσQ.Φ ⋙ Pw))
        (ComplexShape.up ℤ)).inv.app D.I.cochainComplex ≫
      (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map D.t
  let T : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj D.I.cochainComplex ⟶
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj D.I.cochainComplex :=
    (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
        (ComplexShape.up ℤ)).hom.app D.I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app D.I.cochainComplex
  (D.Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T

def wcEtxcDatum.VarNZ {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    {fX : X ⟶ Spec (.of A)} {Ω : Type u} [Field Ω] {ξ : Spec (.of Ω) ⟶ Spec (.of A)}
    {σ : Spec (.of Ω) ⟶ Spec (.of Ω)} {ℓ k : ℕ} (D : wcEtxcDatum fX ξ σ ℓ k) : Prop :=
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX (wcQmSp A)) (ℓ ^ k)))
  ℓ ^ (k - 1) • (DerivedCategory.Q.map D.TPsi - 𝟙 (DerivedCategory.Q.obj D.Psi)) ≠ 0

noncomputable def wcEtxcJs {A : Type u} [CommRing A] [IsLocalRing A] {X U : Scheme.{u}}
    (fX : X ⟶ Spec (.of A)) (j : U ⟶ X) :
    Limits.pullback (j ≫ fX) (wcQmSp A) ⟶ Limits.pullback fX (wcQmSp A) :=
  Limits.pullback.map (j ≫ fX) (wcQmSp A) fX (wcQmSp A) j (𝟙 _) (𝟙 _)
    (by rw [Category.comp_id]) (by rw [Category.comp_id, Category.id_comp])
def wcQdHKER {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (i : T ⟶ V)
    (Di : wcHMPullData i ℓ) : Prop :=
  ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Di)).val.obj (Opposite.op U))
    (W : V.ProEt) (g : W ⟶ U), IsAffine W.left →
    ∃ (n : ℕ) (W' : Fin n → V.ProEt) (e : ∀ a, W' a ⟶ W),
      (∀ a, IsAffine (W' a).left) ∧ (∀ x : ↥W.left, ∃ a, x ∈ Set.range (e a).left) ∧
      ∀ a, (∀ x : ↥(W' a).left, (W' a).hom x ∉ Set.range i) ∨
        ((Limits.kernel (wcSuppUnitMap Di)).val.map (e a ≫ g).op).hom k = 0

def wcQdPre {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (j : T ⟶ V)
    (Dj : wcHMPullData j ℓ) (Wo : V.Opens) (Dw : wcHMPullData Wo.ι ℓ) : Prop :=
  IsClosedImmersion j ∧ wcHMPullCanonical Dj ∧ Epi (wcSuppUnitMap Dj) ∧ wcQdHKER j Dj ∧
    (Wo : Set ↥V) = (Set.range j)ᶜ ∧ wcHMPullCanonical Dw

abbrev wcQdDelta.{u} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n₀ n₁ : ℕ) : Type (u+2) :=
  ∀ {T V : Scheme.{u}} (j : T ⟶ V) (Dj : wcHMPullData j ℓ) (Wo : V.Opens)
    (_ : wcHMPullData Wo.ι ℓ), wcHM Wo.toScheme ℓ n₀ →+ wcSuppExt Dj n₁

def wcQdDeltaXK {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {n₀ n₁ : ℕ} (δ : wcQdDelta.{u} ℓ n₀ n₁) : Prop :=
  ∀ {T V : Scheme.{u}} (j : T ⟶ V) (Dj : wcHMPullData j ℓ) (Wo : V.Opens)
    (Dw : wcHMPullData Wo.ι ℓ), wcQdPre j Dj Wo Dw →
    (∀ α : wcHM Wo.toScheme ℓ n₀, δ j Dj Wo Dw α = 0 →
      ∃ x : wcHM V ℓ n₀, wcHMPull Dw n₀ x = α) ∧
    (∀ x : wcHM V ℓ n₀, δ j Dj Wo Dw (wcHMPull Dw n₀ x) = 0)

def wcQdDeltaN {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {n₀ n₁ : ℕ} (δ : wcQdDelta.{u} ℓ n₀ n₁) : Prop :=
  ∀ {T V T' V' : Scheme.{u}} (j : T ⟶ V) (Dj : wcHMPullData j ℓ) (Wo : V.Opens)
    (Dw : wcHMPullData Wo.ι ℓ), wcQdPre j Dj Wo Dw →
    ∀ (j' : T' ⟶ V') (Dj' : wcHMPullData j' ℓ) (Wo' : V'.Opens)
      (Dw' : wcHMPullData Wo'.ι ℓ), wcQdPre j' Dj' Wo' Dw' →
    ∀ (f : V' ⟶ V) (fO : Wo'.toScheme ⟶ Wo.toScheme), fO ≫ Wo.ι = Wo'.ι ≫ f →
    ∀ (Df : wcHMPullData f ℓ), wcHMPullCanonical Df →
    ∀ (γ : wcSuppObj Dj' ⟶ Df.Φ.obj (wcSuppObj Dj)),
      wcSuppUnitMap Dj' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap Dj) →
    ∀ (DfO : wcHMPullData fO ℓ), wcHMPullCanonical DfO →
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
      ∀ α : wcHM Wo.toScheme ℓ n₀,
        δ j' Dj' Wo' Dw' (wcHMPull DfO n₀ α) =
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Dj Df n₁ (δ j Dj Wo Dw α)) (zero_add _)

def wcQdGEN.{u} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] : Prop :=
  ∀ {T V : Scheme.{u}} (j : T ⟶ V), IsClosedImmersion j → ∀ (Dj : wcHMPullData j ℓ),
    wcQdHKER j Dj → ∀ (Wo : V.Opens), (Wo : Set ↥V) = (Set.range j)ᶜ →
    ∀ (Dw : wcHMPullData Wo.ι ℓ), wcHMPullCanonical Dw →
    ∃ ε : SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ) ⟶
        Dw.Φ.obj (Limits.kernel (wcSuppUnitMap Dj)),
      ε ≫ Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) = Dw.μ.inv ∧
      ∀ n : ℕ,
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
        haveI := Dw.additive; haveI := Dw.presLim; haveI := Dw.presColim
        Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj))
            (SheafOfModules.unit (wcRingSheaf V ℓ)) n =>
          (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp
            (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n)) (zero_add n))

def wcQdKumP (L : Type u) [Field L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1) : Prop :=
  ∀ (T T' : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (qT' : T' ⟶ Spec (.of L)) (f : T' ⟶ T),
    f ≫ qT = qT' →
    ∀ (D : wcHMPullData f ℓ), wcHMPullCanonical D →
    ∀ (E : wcIntRatData T ℓ),
      E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap T ℓ) →
    ∀ (E' : wcIntRatData T' ℓ),
      E'.adj.homEquiv _ _ E'.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap T' ℓ) →
    ∀ (a : (Γ(T, ⊤))ˣ),
      wcHMPull D 1 (wcIntRho E 1 (κΛ T qT a)) =
        wcIntRho E' 1 (κΛ T' qT' (Units.map f.appTop.hom.toMonoidHom a))

def wcQdBO {Y' Z : Scheme.{u}} (iY' : Y' ⟶ Z) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] : Prop :=
  ∀ (U0 : Z.Opens) (x0 : Γ(Z, U0)), (∀ z ∈ U0, (z ∈ Set.range iY' ↔ z ∉ Z.basicOpen x0)) →
    ∀ (T X : Scheme.{u}) (g : X ⟶ Z) (hle : ⊤ ≤ g ⁻¹ᵁ U0) (i : T ⟶ X), IsClosedImmersion i →
    Set.range i = g ⁻¹' Set.range iY' →
    ∀ (s : Γ(X, ⊤)), s = (g.appLE U0 ⊤ hle).hom x0 →
      ((X.basicOpen s : X.Opens) : Set ↥X) = (Set.range i)ᶜ ∧
      IsUnit ((X.basicOpen s).ι.appTop.hom s) ∧
      ∀ (Di : wcHMPullData i ℓ), wcHMPullCanonical Di → wcQdHKER i Di
def wcChmpTorsFG {R : Type u} [Ring R] (ℓ : ℕ) (N : ModuleCat.{u+1} R) : Prop :=
  Module.Finite R N ∧ ∀ x : N, ℓ • x = 0


def wcChmpLamLin {R : Type u} [Ring R] {D : CochainComplex AddCommGrpCat.{u+1} ℕ}
    (lamD : R → (D ⟶ D)) (j : ℕ) {N : Type (u+1)} [AddCommGroup N] [Module R N]
    (f : N →+ D.X j) : Prop :=
  ∀ (r : R) (x : N), f (r • x) = ((lamD r).f j).hom (f x)


def wcChmpInjD {R : Type u} [Ring R] {D : CochainComplex AddCommGrpCat.{u+1} ℕ}
    (lamD : R → (D ⟶ D)) (n : ℕ) : Prop :=
  ∀ (A B : ModuleCat.{u+1} R) (i : A ⟶ B), Function.Injective i.hom →
    ∀ g : A →+ D.X n, wcChmpLamLin lamD n g →
      ∃ h : B →+ D.X n, wcChmpLamLin lamD n h ∧ ∀ x : A, h (i.hom x) = g x


def wcChmpVanD {R : Type u} [Ring R] {D : CochainComplex AddCommGrpCat.{u+1} ℕ}
    (lamD : R → (D ⟶ D)) (N : ModuleCat.{u+1} R) : Prop :=
  ∀ j, 4 ≤ j → ∀ f : N →+ D.X j, wcChmpLamLin lamD j f →
    (∀ x, (D.d j (j + 1)).hom (f x) = 0) →
    ∃ h : N →+ D.X (j - 1), wcChmpLamLin lamD (j - 1) h ∧ ∀ x, (D.d (j - 1) j).hom (h x) = f x


abbrev wcChmpModL (R : Type u) [Ring R] (ℓ k : ℕ) : Type u :=
  (Fin k → R) ⧸ LinearMap.range (ℓ • LinearMap.id : (Fin k → R) →ₗ[R] (Fin k → R))


abbrev wcChmpModBar (R : Type u) [Ring R] (ℓ : ℕ) (M : Type (u+1)) [AddCommGroup M]
    [Module R M] : Type (u+1) :=
  M ⧸ LinearMap.range (ℓ • LinearMap.id : M →ₗ[R] M)
noncomputable def wcBfEv {R : Type u} [CommRing R] {m : ℕ} (p : Fin m → R)
    (s : MvPolynomial (Fin m) R) (hs : MvPolynomial.eval p s = 1) :
    HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin m) R) s →+* R :=
  (Localization.awayLift (MvPolynomial.eval p) s (by rw [hs]; exact isUnit_one)).comp
    (algebraMap (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin m) R) s)
      (Localization.Away s))
noncomputable def wcEtqmTube {A : Type u} [CommRing A] [IsLocalRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {U : Scheme.{u}} (g : U ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (fX : U ⟶ Spec (.of A)) (a : Fin n) : (Limits.pullback fX (wcQmSp A)).Opens :=
  (Limits.pullback fX (wcQmSp A)).basicOpen
    ((Limits.pullback.fst fX (wcQmSp A) ≫ g).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a))))
structure wcLnModel (Λ : Type) [CommRing Λ] where
  k : ℕ → ℕ
  hk : ∀ i, 3 ≤ i → k i = 0
  ε : ∀ i, Matrix (Fin (k i)) (Fin (k i)) Λ
  hε : ∀ i, ε i * ε i = ε i
  δ : ∀ i, Matrix (Fin (k i)) (Fin (k (i + 1))) Λ
  hδδ : ∀ i, δ i * δ (i + 1) = 0
  hεδ : ∀ i, ε i * δ i = δ i
  hδε : ∀ i, δ i * ε (i + 1) = δ i
  f : ∀ i, Matrix (Fin (k i)) (Fin (k i)) Λ
  hεf : ∀ i, ε i * f i = f i
  hfε : ∀ i, f i * ε i = f i
  hδf : ∀ i, δ i * f (i + 1) = f i * δ i

noncomputable def wcLnModelAb.{v} {Λ : Type} [CommRing Λ] (Q : wcLnModel Λ) :
    CochainComplex AddCommGrpCat.{v} ℕ :=
  CochainComplex.of (fun i => AddCommGrpCat.of (ULift.{v} (wcIdemSub (Q.ε i))))
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (Q.ε i) (Q.ε (i + 1)) (Q.δ i) (Q.hδε i))))
    (fun i => by
      refine AddCommGrpCat.ext (fun x => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, Matrix.vecMul_vecMul, Q.hδδ] <;> rfl)

noncomputable def wcLnModelFrob.{v} {Λ : Type} [CommRing Λ] (Q : wcLnModel Λ) :
    wcLnModelAb.{v} Q ⟶ wcLnModelAb.{v} Q :=
  CochainComplex.ofHom (X := wcLnModelAb.{v} Q) (Y := wcLnModelAb.{v} Q)
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (Q.ε i) (Q.ε i) (Q.f i) (Q.hfε i))))
    (fun i => by
      dsimp only [wcLnModelAb]
      rw [CochainComplex.of_d]
      refine AddCommGrpCat.ext (fun x => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, Matrix.vecMul_vecMul, Q.hδf])

noncomputable def wcLnTr {Λ : Type} [CommRing Λ] (Q : wcLnModel Λ) (e : ℕ) : Λ :=
  ∑ i ∈ Finset.range 3, (-1 : Λ) ^ i * ((Q.f i) ^ e).trace

noncomputable def wcRhoRed (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ] [Fintype Γ]
    {r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (x : MonoidAlgebra ℤ_[ℓ] Γ) :
    Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) :=
  ∑ g : Γ, PadicInt.toZModPow n (x.coeff g) • ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))))

def wcIsTwist (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ] [Fintype Γ] {r : ℕ}
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (P : wcGModel ℓ Γ) (Q : wcLnModel (ZMod (ℓ ^ n))) : Prop :=
  ∃ b : ∀ i, Fin (Q.k i) ≃ Fin (P.k i) × Fin r,
    (∀ i x y, Q.ε i x y = wcRhoRed ℓ n ρ (P.ε i (b i x).1 (b i y).1) (b i x).2 (b i y).2) ∧
    (∀ i x y, Q.δ i x y =
      wcRhoRed ℓ n ρ (P.δ i (b i x).1 (b (i + 1) y).1) (b i x).2 (b (i + 1) y).2) ∧
    (∀ i x y, Q.f i x y = wcRhoRed ℓ n ρ (P.f i (b i x).1 (b i y).1) (b i x).2 (b i y).2)

noncomputable def wcCxJ (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
