noncomputable def wcExtZeroSub {C : Type*} [Category C] (F : Cᵒᵖ ⥤ AddCommGrpCat.{w})
    (p : C → Prop) (T : Cᵒᵖ) : AddSubgroup (F.obj T) :=
  ⨆ _ : p T.unop, ⊤

noncomputable def wcExtZeroPre {C : Type*} [Category C] (F : Cᵒᵖ ⥤ AddCommGrpCat.{w})
    (p : C → Prop) (hp : ∀ {T T' : C} (_ : T' ⟶ T), p T → p T') : Cᵒᵖ ⥤ AddCommGrpCat.{w} where
  obj T := AddCommGrpCat.of (wcExtZeroSub F p T)
  map {T T'} g := AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
    ((F.map g).hom.comp (wcExtZeroSub F p T).subtype) (wcExtZeroSub F p T') (fun x => by
      by_cases h : p T'.unop
      · show _ ∈ (⨆ _ : p _, (⊤ : AddSubgroup _)); rw [iSup_pos h]; exact AddSubgroup.mem_top _
      · have h' : ¬ p T.unop := fun h' => h (hp g.unop h')
        have hx : x.1 ∈ (⨆ _ : p T.unop, (⊤ : AddSubgroup (F.obj T))) := x.2
        rw [iSup_neg h', AddSubgroup.mem_bot] at hx
        simp [hx]))
  map_id T := by
    ext x
    simp
  map_comp f g := by
    ext x
    simp

noncomputable def wcExtZeroMap {C : Type*} [Category C] {F F' : Cᵒᵖ ⥤ AddCommGrpCat.{w}}
    (η : F ⟶ F') (p : C → Prop) (hp : ∀ {T T' : C} (_ : T' ⟶ T), p T → p T') :
    wcExtZeroPre F p hp ⟶ wcExtZeroPre F' p hp where
  app T := AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
    ((η.app T).hom.comp (wcExtZeroSub F p T).subtype) (wcExtZeroSub F' p T) (fun x => by
      by_cases h : p T.unop
      · show _ ∈ (⨆ _ : p _, (⊤ : AddSubgroup _)); rw [iSup_pos h]; exact AddSubgroup.mem_top _
      · have hx : x.1 ∈ (⨆ _ : p T.unop, (⊤ : AddSubgroup (F.obj T))) := x.2
        rw [iSup_neg h, AddSubgroup.mem_bot] at hx
        simp [hx]))
  naturality T T' g := by
    ext x
    apply Subtype.ext
    exact congrArg (fun φ => φ.hom x.1) (η.naturality g)

noncomputable def wcPbFun {X V : Scheme.{u}} (q : V ⟶ X) : X.ProEt ⥤ Scheme.{u} :=
  Scheme.ProEt.forget X ⋙ Over.pullback q ⋙ Over.forget V

noncomputable def wcPbAct {X V : Scheme.{u}} (q : V ⟶ X) (a : V ⟶ V) (ha : a ≫ q = q) :
    wcPbFun q ⟶ wcPbFun q where
  app T := Limits.pullback.map ((Scheme.ProEt.forget X).obj T).hom q
    ((Scheme.ProEt.forget X).obj T).hom q (𝟙 _) a (𝟙 X) (by simp) (by simp [ha])
  naturality T T' g := by
    apply Limits.pullback.hom_ext <;>
      simp only [wcPbFun, Functor.comp_map, Over.forget_map, Over.pullback_map_left,
        Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd,
        Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd_assoc, Category.comp_id,
        Category.id_comp]

