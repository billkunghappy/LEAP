noncomputable def wcSpfRedP {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (n : ℕ) : wcCcPre q Z ℓ ⟶ wcSpfQPre q Z ℓ n :=
  wcExtZeroMap (Functor.whiskerLeft (wcPbFun q).op (Functor.whiskerRight
      ({ app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.compLeftContinuous (↥(Opposite.unop U))
            (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom (by
              have hc : Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) n x) := by
                rw [continuous_discrete_rng]
                intro b
                rw [Metric.isOpen_iff]
                intro x hx
                have hℓ : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
                refine ⟨(ℓ : ℝ) ^ (-(n : ℤ)), zpow_pos hℓ _, fun y hy => ?_⟩
                have h1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(n : ℤ)) := by
                  rw [Metric.mem_ball, dist_eq_norm] at hy
                  exact hy.le
                have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) n).mp h1
                rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h2
                simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
                rw [h2]
                exact hx
              exact hc))
         naturality := fun _ _ _ => rfl } :
        continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⟶ continuousMapPresheafAb.{0, u} (ZMod (ℓ ^ n)))
      AddCommGrpCat.uliftFunctor.{u+1, u}))
    (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)

