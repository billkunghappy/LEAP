noncomputable def wcLCPb {Y X : Scheme.{u}} (a : X ⟶ Y) (A : Type (u+1)) [AddCommGroup A] :
    (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
