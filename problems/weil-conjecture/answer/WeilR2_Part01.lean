    (∀ (d : ℕ) (β : ∀ a : Fin L.m, Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ q ⁻¹ᵁ ⊤))
      (c : ∀ a b : Fin L.m, Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)),
      (∀ a b, c a b ∈ Ideal.map (wcCnSigma h ((wcpaDjCocPull φ L).V a ⊓
        (wcpaDjCocPull φ L).V b)) (I ^ (n + 1))) →
