noncomputable def wcScqHtTuple (K : Type u) [Field K] (n : ℕ) {T : Scheme.{u}}
    (fT : T ⟶ Spec (.of K)) (g : T ⟶ wcProjK K (n + 1)) (c : Fin (n + 1)) (J : Fin (n + 1 + 1)) :
    Γ(Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))),
      Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)) :=
  if J.val = 0 then
    ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
        (homOfLE (le_top : Limits.pullback.fst fT
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ≤ ⊤)).op).hom
      ((Limits.pullback.snd fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).inv.hom Polynomial.X)) *
    ((Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).app
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
      ((g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ J))
  else
    ((Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).app
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
      ((g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ J))
def wcFamWit (K : Type u) [Field K] (T : Scheme.{u}) (f : T ⟶ (wcP1Over K).left) (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) : Prop :=
  ∃ (M' : ℕ) (Xu : Over (Spec (.of K))) (d : ℕ) (_ : SmoothOfRelativeDimension d Xu.hom)
    (h : Xu.left ⟶ wcProjK K M') (_ : IsProper h) (_ : h ≫ wcProjKStr K M' = Xu.hom)
    (Δ : Set (wcProjK K M')) (lam : (wcP1Over K).left ⟶ wcProjK K M')
    (p : T ⟶ Xu.left),
    2 ≤ M' ∧ IsClosed Δ ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra K Ω],
      IsIrreducible (⇑(wcLdpProjMap K Ω M') ⁻¹' Δ)) ∧
    (∀ x : Xu.left, h x ∉ Δ → ∃ U : Xu.left.Opens, x ∈ U ∧ Smooth (U.ι ≫ h)) ∧
    IsClosedImmersion lam ∧ lam ≫ wcProjKStr K M' = (wcP1Over K).hom ∧
    (∃ L : Fin (M' - 1) → MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) K 1,
      LinearIndependent K (fun a => (L a : MvPolynomial (Fin (M' + 1)) K)) ∧
      Set.range lam = {x | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) K) MvPolynomial.gradedAlgebra
        (L a : MvPolynomial (Fin (M' + 1)) K)}) ∧
    IsPullback p f h lam ∧
    (∀ t : (wcP1Over K).left, lam t ∈ Δ ↔ ∃ i, t = S i (IsLocalRing.closedPoint K)) ∧
    ∀ i : Fin m, ∃ (U : (wcProjK K M').Opens)
      (hU : lam (S i (IsLocalRing.closedPoint K)) ∈ U) (φ : Γ(wcProjK K M', U)),
      (∀ (x : wcProjK K M') (hx : x ∈ U), x ∈ Δ ↔
        ((wcProjK K M').presheaf.germ U x hx).hom φ ∈
          IsLocalRing.maximalIdeal ((wcProjK K M').presheaf.stalk x)) ∧
      IsLocalRing.maximalIdeal
          ((wcP1Over K).left.presheaf.stalk (S i (IsLocalRing.closedPoint K))) =
        Ideal.span {(lam.stalkMap (S i (IsLocalRing.closedPoint K))).hom
          (((wcProjK K M').presheaf.germ U _ hU).hom φ)}
structure wcHonestPL {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) where
  W : (wcP1Over F'').left.ProEt
  w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP
  N : ℕ
  θ : (wcRq D.f ℓ (n - 1)).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin N → ℚ_[ℓ])).over W
  hθc : ∀ c : ℚ_[ℓ],
    ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
        (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over F'').left ℓ N c)
  hqc : QuasiCompact w.left
  hconn : ConnectedSpace W.left
  hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
    (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
      D.S i (IsLocalRing.closedPoint F'')) →
    ∃ z : W.left, w.left z = p
  hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
    a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ
  fr : (W ⟶ W) → ((Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ]))
  hfr : ∀ γ : W ⟶ W, γ ≫ w = w →
    ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W)) (z : W.left),
    (show C(↥W.left, Fin N → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
    fr γ ((show C(↥W.left, Fin N → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)
  hfr1 : fr (𝟙 W) = LinearMap.id
  hcomp : ∀ γ γ' : W ⟶ W, γ ≫ w = w → γ' ≫ w = w → fr (γ ≫ γ') = fr γ' ∘ₗ fr γ
  d : Fin D.m → (Fin N → ℚ_[ℓ])
  lam : Fin D.m → Module.Dual ℚ_[ℓ] (Fin N → ℚ_[ℓ])
  hdz : ∀ i, d i = 0 ↔ lam i = 0
  htv : ∀ i, ∃ γ : W ⟶ W, γ ≫ w = w ∧ ∀ x, fr γ x = x + lam i x • d i
  hconj : ∀ i i' : Fin D.m, ∃ (γ : W ⟶ W) (c : ℚ_[ℓ]), γ ≫ w = w ∧ c ≠ 0 ∧
    fr γ (d i) = c • d i' ∧ ∀ x, lam i' (fr γ x) = c⁻¹ * lam i x
  hrange : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ x, fr γ x - x ∈ Submodule.span ℚ_[ℓ]
    {v | ∃ (γ' : W ⟶ W) (i : Fin D.m), γ' ≫ w = w ∧ fr γ' (d i) = v}
  hgen : ∀ U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]),
    (∀ (γ : W ⟶ W) (i : Fin D.m), γ ≫ w = w → ∀ u ∈ U, lam i (fr γ u) = 0) →
    ∀ γ : W ⟶ W, γ ≫ w = w → ∀ u ∈ U, fr γ u = u
  hloc : ∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
      (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : V.left ≅ Spec (.of A)),
      V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
      ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ W) (z : V'.left),
        a ≫ v = b ≫ w ∧
        (∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
          (show C(↥V'.left, Fin N → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = 0 → s = 0) ∧
        ∀ x : Fin N → ℚ_[ℓ], lam i x = 0 ↔
          ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
            (show C(↥V'.left, Fin N → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
              (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = x


noncomputable def wcHonestEhon {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (H : wcHonestPL D ℓ hP) : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]) :=
  Submodule.span ℚ_[ℓ] {v | ∃ (γ : H.W ⟶ H.W) (i : Fin D.m), γ ≫ H.w = H.w ∧ H.fr γ (H.d i) = v}


noncomputable def wcHonestMov {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (H : wcHonestPL D ℓ hP) : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]) :=
  Submodule.span ℚ_[ℓ] {v | ∃ (γ : H.W ⟶ H.W) (u : Fin H.N → ℚ_[ℓ]), γ ≫ H.w = H.w ∧
    u ∈ wcHonestEhon H ∧ H.fr γ u - u = v}
noncomputable def wcBeqEv (K : Type u) [Field K] (m : ℕ) (k : Fin (m + 1)) :
    MvPolynomial (Fin (m + 1)) K →+* Γ(wcProjK K m, wcSgD K m k) :=
  MvPolynomial.eval₂Hom
    ((Scheme.ΓSpecIso (.of K)).inv ≫ (wcProjKStr K m).appTop ≫
      (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m k ≤ ⊤)).op).hom
    (fun l => wcSgE K m k l)
def wcPLSpImg {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (π : wcPencilPL D ℓ hP) {V V' : (wcP1Over F'').left.ProEt} (u : V' ⟶ V) (c : V' ⟶ π.W)
    (pt : V'.left) : Set (Fin π.r → ℚ_[ℓ]) :=
  {x | ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
    (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom
      (((wcRq D.f ℓ (n - 1)).obj.map u.op).hom s)).down) pt = x}

def wcPLInv {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (π : wcPencilPL D ℓ hP) {V V' : (wcP1Over F'').left.ProEt} (u : V' ⟶ V) (c : V' ⟶ π.W) :
    Set (Fin π.r → ℚ_[ℓ]) :=
  {x | ∀ (τ : V' ⟶ V') (σ : π.W ⟶ π.W) (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
    τ ≫ u = u → σ ≫ π.w = π.w → τ ≫ c = c ≫ σ →
    (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
      (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
      g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z)) →
    g x = x}
def wcLdnmM (N : ℕ) : ℕ := (N + 1) * (N + 1) - 1

def wcLdnmIdx (N : ℕ) : Fin (N + 1) × Fin (N + 1) ≃ Fin (wcLdnmM N + 1) :=
  finProdFinEquiv.trans (finCongr (by
    have h : 0 < (N + 1) * (N + 1) := Nat.mul_pos (Nat.succ_pos N) (Nat.succ_pos N)
    unfold wcLdnmM
    omega))

noncomputable def wcLdnmMono (E : Type u) [Field E] (N : ℕ) (q : Fin (N + 1) × Fin (N + 1)) :
    MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2 :=
  wcLdpQuad E N (fun p p' => if (p, p') = q then 1 else 0)

noncomputable abbrev wcLdnmU (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (p : Fin (N + 1) × Fin (wcLdnmM N + 1)) :
    (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).Opens :=
  Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N p.1) ⊓
    Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) ⁻¹ᵁ wcSgD E (wcLdnmM N) p.2

noncomputable def wcLdnmPhi (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (p : Fin (N + 1) × Fin (wcLdnmM N + 1)) :
    Γ(Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)), wcLdnmU E N X ι p) :=
  ∑ q : Fin (N + 1) × Fin (N + 1),
    ((Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))).appLE (wcSgD E (wcLdnmM N) p.2)
      (wcLdnmU E N X ι p) inf_le_right).hom (wcSgE E (wcLdnmM N) p.2 (wcLdnmIdx N q)) *
    ((Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))).appLE (ι ⁻¹ᵁ wcSgD E N p.1)
      (wcLdnmU E N X ι p) inf_le_left).hom
      ((ι.app (wcSgD E N p.1)).hom (wcLdpSec E N (wcLdnmMono E N q) p.1))

def wcLdnmLocEq (P : Scheme.{u}) (I : Type) (W : I → P.Opens) (H : ∀ i, Γ(P, W i))
    (Z : Scheme.{u}) (g : Z ⟶ P) : Prop :=
  IsClosedImmersion g ∧
  (∀ (i : I) (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W i),
    Function.Surjective (g.app O).hom ∧
    RingHom.ker (g.app O).hom = Ideal.span {P.presheaf.map (homOfLE hOW).op (H i)}) ∧
  (∀ p : P, p ∈ Set.range g ↔ ∀ (i : I) (hp : p ∈ W i),
    (P.presheaf.germ (W i) p hp).hom (H i) ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk p)) ∧
  (∀ (z : Z) (i : I) (hz : g z ∈ W i), Function.Surjective (g.stalkMap z).hom ∧
    RingHom.ker (g.stalkMap z).hom = Ideal.span {(P.presheaf.germ (W i) (g z) hz).hom (H i)})

def wcLdnmNS {A B : Scheme.{u}} (h : A ⟶ B) : Set A :=
  {x | ¬ ∃ U : A.Opens, x ∈ U ∧ Smooth (U.ι ≫ h)}

def wcLdnmPencilRule (E : Type u) [Field E] (N : ℕ) (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N)) : Prop :=
  ∀ (t : (wcP1Over E).left) (r : Fin (wcLdnmM N + 1)) (hr : lam t ∈ wcSgD E (wcLdnmM N) r)
    (e : Fin 2) (he : t ∈ wcSgD E 1 e) (q : Fin (N + 1) × Fin (N + 1)),
    (lam.stalkMap t).hom
        (((wcProjK E (wcLdnmM N)).presheaf.germ (wcSgD E (wcLdnmM N) r) (lam t) hr).hom
          (wcSgE E (wcLdnmM N) r (wcLdnmIdx N q))) *
      (wcLdpConst E (wcP1Over E).hom t (v₁ ((wcLdnmIdx N).symm r)) *
          ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e) t he).hom (wcSgE E 1 e 0) -
        wcLdpConst E (wcP1Over E).hom t (v₀ ((wcLdnmIdx N).symm r)) *
          ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e) t he).hom (wcSgE E 1 e 1)) =
    wcLdpConst E (wcP1Over E).hom t (v₁ q) *
        ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e) t he).hom (wcSgE E 1 e 0) -
      wcLdpConst E (wcP1Over E).hom t (v₀ q) *
        ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e) t he).hom (wcSgE E 1 e 1)
def wcHonestFrame {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (W : (wcP1Over F'').left.ProEt) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) : Prop :=
  ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W)) (z : W.left),
    (show C(↥W.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
    g ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)


def wcHonestIsInertia {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (i : Fin D.m) (σ : W ⟶ W) : Prop :=
  σ ≫ w = w ∧
  ∃ (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A)
    (_ : IsSepClosed (IsLocalRing.ResidueField A)) (e : V.left ≅ Spec (.of A)),
    V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') ∧
    ∃ (L : Type u) (_ : Field L) (_ : IsSepClosed L) (Vt : (wcP1Over F'').left.ProEt)
      (_ : Vt.left ≅ Spec (.of L)) (u' : Vt ⟶ V) (c : Vt ⟶ W) (τ : Vt ⟶ Vt),
      u' ≫ v = c ≫ w ∧ τ ≫ u' = u' ∧ τ ≫ c = c ≫ σ
noncomputable abbrev wcCtrSK (K : Type u) [Field K] :
    Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of K) :=
  Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))

noncomputable abbrev wcCtrA1 (K : Type u) [Field K] :
    Spec (.of (Polynomial K)) ⟶ Spec (.of K) :=
  Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))
noncomputable def wcHonestRg {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (H : wcHonestPL D ℓ hP) : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]) :=
  Submodule.span ℚ_[ℓ] {v | ∃ (γ : H.W ⟶ H.W) (u : Fin H.N → ℚ_[ℓ]), γ ≫ H.w = H.w ∧
    H.fr γ u - u = v}
noncomputable def wcOverRestrict (S : Scheme.{u}) {V W : S.ProEt} (lam : V ⟶ W)
    {G₁ G₂ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
    (ν : G₁.over W ⟶ G₂.over W) : G₁.over V ⟶ G₂.over V :=
  ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} lam).map ν

open Classical in
noncomputable def wcPunctGys (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt) (g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) :
    Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) G 1 →+
      wcCohG F'' (wcP1Over F'') hP G 2 :=
  if h : Mono (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) ∧
      ∃ κ : Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
          (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) ⟶
        Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' u0 hP)),
      IsIso κ ∧
      Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
          (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) ≫ κ =
        wcFreeSheafMap (wcP1Over F'').left g₀ ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' u0 hP)) then
    haveI : IsIso (Classical.choose h.2) := (Classical.choose_spec h.2).1
    ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctIncl F'' u0 hP)) ≫ inv (Classical.choose h.2))).precomp G (zero_add 2)).comp
      ((ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (wcFreeSheafMap
        (wcP1Over F'').left (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀))) h.1
          inferInstance).extClass.precomp G (show 1 + 1 = 2 from rfl))
  else 0

def wcPunctFramePkg (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (V₀ : (wcP1Over F'').left.ProEt)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Fr : ∀ G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1},
      ((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over V₀ ⟶ G.over V₀) →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
          (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) G 1) : Prop :=
  (∀ (G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (σ : G ⟶ G') (μ : (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over V₀ ⟶ G.over V₀),
      Fr G' (μ ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} V₀).map σ) =
        (Fr G μ).comp (Abelian.Ext.mk₀ σ) (add_zero 1)) ∧
  (∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) (k : ℕ)
      (φ : G.over V₀ ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over V₀)
      (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
          (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) G 1),
      ∃ v : Fin k → ℚ_[ℓ], Fr G (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} V₀).map (wcContSheafMap (wcP1Over F'').left
            (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) v).toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional _)) ≫ φ.inv) = x)

open Classical in
noncomputable def wcPunctFrameCls (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (V₀ : (wcP1Over F'').left.ProEt)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) :
    ((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over V₀ ⟶ G.over V₀) →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) G 1 :=
  if h : ∃ Fr, wcPunctFramePkg F'' u0 V₀ ℓ Fr then Classical.choose h G else 0
def wcPfamHyp {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ)
    (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M'))
    (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left) : Prop :=
  (∃ d : ℕ, SmoothOfRelativeDimension d Xu.hom) ∧ IsProper h ∧
    h ≫ wcProjKStr F'' M' = Xu.hom ∧ 2 ≤ M' ∧ IsClosed Δ ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra F'' Ω],
      IsIrreducible (⇑(wcLdpProjMap F'' Ω M') ⁻¹' Δ)) ∧
    (∀ x : Xu.left, h x ∉ Δ → ∃ U : Xu.left.Opens, x ∈ U ∧ Smooth (U.ι ≫ h)) ∧
    IsClosedImmersion lam ∧ lam ≫ wcProjKStr F'' M' = (wcP1Over F'').hom ∧
    (∃ L : Fin (M' - 1) → MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 1,
      LinearIndependent F'' (fun a => (L a : MvPolynomial (Fin (M' + 1)) F'')) ∧
      Set.range lam = {x | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'') MvPolynomial.gradedAlgebra
        (L a : MvPolynomial (Fin (M' + 1)) F'')}) ∧
    IsPullback p D.f h lam ∧
    (∀ t : (wcP1Over F'').left, lam t ∈ Δ ↔ ∃ i, t = D.S i (IsLocalRing.closedPoint F'')) ∧
    ∀ i : Fin D.m, ∃ (U : (wcProjK F'' M').Opens)
      (hU : lam (D.S i (IsLocalRing.closedPoint F'')) ∈ U) (φ : Γ(wcProjK F'' M', U)),
      (∀ (x : wcProjK F'' M') (hx : x ∈ U), x ∈ Δ ↔
        ((wcProjK F'' M').presheaf.germ U x hx).hom φ ∈
          IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk x)) ∧
      IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.S i (IsLocalRing.closedPoint F''))) =
        Ideal.span {(lam.stalkMap (D.S i (IsLocalRing.closedPoint F''))).hom
          (((wcProjK F'' M').presheaf.germ U _ hU).hom φ)}

structure wcPfamCover {F'' : Type u} [Field F''] (M' : ℕ) {X : Scheme.{u}}
    (h : X ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) where
  W' : (wcProjK F'' M').ProEt
  w' : W' ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP
  r' : ℕ
  θ' : (wcRq h ℓ q).over W' ≅ (wcContSheaf (wcProjK F'' M') (Fin r' → ℚ_[ℓ])).over W'
  hθc' : ∀ c : ℚ_[ℓ],
    ((Scheme.ProEt.topology (wcProjK F'' M')).overPullback AddCommGrpCat.{u+1} W').map
        (wcRqScalar h ℓ q c) ≫ θ'.hom =
      θ'.hom ≫ ((Scheme.ProEt.topology (wcProjK F'' M')).overPullback AddCommGrpCat.{u+1} W').map
        (wcConstScalar (wcProjK F'' M') ℓ r' c)
  hconn' : ConnectedSpace W'.left
  hoff' : ∀ z : W'.left, W'.hom z ∉ Δ
  hcov' : ∀ p : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p ∉ Δ → ∃ z : W'.left, w'.left z = p
  hgal' : ∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ W'), ConnectedSpace V.left →
    a ≫ w' = b ≫ w' → ∃ σ : W' ⟶ W', σ ≫ w' = w' ∧ b = a ≫ σ

def wcPfamFrame {F'' : Type u} [Field F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω : wcPfamCover M' h Δ ℓ q hPP) (σ : Ω.W' ⟶ Ω.W')
    (g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])) : Prop :=
  ∀ (s : (wcRq h ℓ q).obj.obj (Opposite.op Ω.W')) (z : Ω.W'.left),
    (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
    g ((show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z)

def wcPfamInertFr {F'' : Type u} [Field F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω : wcPfamCover M' h Δ ℓ q hPP) {V T : (wcProjK F'' M').ProEt} (u : T ⟶ V)
    (c : T ⟶ Ω.W') : Set ((Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])) :=
  {g | ∃ (τ : T ⟶ T) (σ : Ω.W' ⟶ Ω.W'), τ ≫ u = u ∧ σ ≫ Ω.w' = Ω.w' ∧ τ ≫ c = c ≫ σ ∧
    wcPfamFrame Ω σ g}

def wcPfamPtAt {F'' : Type u} [Field F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω : wcPfamCover M' h Δ ℓ q hPP) (y : wcProjK F'' M') {V T : (wcProjK F'' M').ProEt}
    (u : T ⟶ V) (c : T ⟶ Ω.W') : Prop :=
  ∃ (v : V ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) (A : Type u) (_ : CommRing A)
    (_ : HenselianLocalRing A) (_ : IsSepClosed (IsLocalRing.ResidueField A))
    (e : V.left ≅ Spec (.of A)) (L : Type u) (_ : Field L) (_ : IsSepClosed L)
    (_ : T.left ≅ Spec (.of L)),
    u ≫ v = c ≫ Ω.w' ∧ V.hom (e.inv (IsLocalRing.closedPoint A)) = y

def wcPfamXiPt {F'' : Type u} [Field F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω : wcPfamCover M' h Δ ℓ q hPP) {V T : (wcProjK F'' M').ProEt}
    (u : T ⟶ V) (c : T ⟶ Ω.W') : Prop :=
  ∃ (v : V ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) (A : Type u) (_ : CommRing A)
    (_ : HenselianLocalRing A) (_ : IsSepClosed (IsLocalRing.ResidueField A))
    (e : V.left ≅ Spec (.of A)) (L : Type u) (_ : Field L) (_ : IsSepClosed L)
    (_ : T.left ≅ Spec (.of L)),
    u ≫ v = c ≫ Ω.w' ∧
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (v.left (e.inv (IsLocalRing.closedPoint A))) ∈ Δ ∧
    ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {v.left (e.inv (IsLocalRing.closedPoint A))}

def wcPLInertFr {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (π : wcPencilPL D ℓ hP) {V T : (wcP1Over F'').left.ProEt} (u : T ⟶ V) (c : T ⟶ π.W) :
    Set ((Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])) :=
  {g | ∃ (τ : T ⟶ T) (σ : π.W ⟶ π.W), τ ≫ u = u ∧ σ ≫ π.w = π.w ∧ τ ≫ c = c ≫ σ ∧
    wcHonestFrame D ℓ π.W π.r π.θ σ g}
noncomputable def wcLdnmTvRho {Z Y : Scheme.{u}} (h : Z ⟶ Y) (z : Z) (y : Y) (e : h z = y) :
    Y.presheaf.stalk y →+* Z.presheaf.stalk z :=
  (h.stalkMap z).hom.comp (Y.presheaf.stalkSpecializes (specializes_of_eq e)).hom
abbrev wcPfamLineBeta {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] {M' : ℕ} {X : Scheme.{u}} (h : X ⟶ wcProjK F'' M')
    (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') :=
  ∀ (V : (wcProjK F'' M').ProEt) (T : (wcP1Over F'').left.ProEt) (b : T.left ⟶ V.left),
    b ≫ V.hom = T.hom ≫ lam →
    ((wcRq h ℓ (n - 1)).obj.obj (Opposite.op V) →+
      (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T))

def wcPfamLineCmp {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (π : wcPencilPL D ℓ hP) {M' : ℕ} {X : Scheme.{u}} {h : X ⟶ wcProjK F'' M'}
    {Δ : Set (wcProjK F'' M')}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (β : wcPfamLineBeta D ℓ h lam)
    (T : (wcP1Over F'').left.ProEt) (a : T ⟶ π.W) (b : T.left ⟶ Ω.W'.left)
    (hb : b ≫ Ω.W'.hom = T.hom ≫ lam)
    (M : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])) : Prop :=
  ConnectedSpace T.left ∧
  a.left ≫ π.w.left ≫ Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
    b ≫ Ω.w'.left ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ∧
  ∀ (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W')) (t : T.left),
    (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) (b t) =
    M ((show C(↥T.left, Fin π.r → ℚ_[ℓ]) from
      ((π.θ.hom.hom.app (Opposite.op (Over.mk a))).hom (β Ω.W' T b hb s)).down) t)

def wcPfamLineBC {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} {D : wcLefschetzDatum F' F'' Y n} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (π : wcPencilPL D ℓ hP) {M' : ℕ} {X : Scheme.{u}} {h : X ⟶ wcProjK F'' M'}
    {Δ : Set (wcProjK F'' M')}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (β : wcPfamLineBeta D ℓ h lam) : Prop :=
  (∀ (V : (wcProjK F'' M').ProEt) (T T' : (wcP1Over F'').left.ProEt) (f : T' ⟶ T)
      (b : T.left ⟶ V.left) (hb : b ≫ V.hom = T.hom ≫ lam)
      (hb' : (f.left ≫ b) ≫ V.hom = T'.hom ≫ lam)
      (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)),
      ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom (β V T b hb s) = β V T' (f.left ≫ b) hb' s) ∧
  (∀ (V V' : (wcProjK F'' M').ProEt) (g : V' ⟶ V) (T : (wcP1Over F'').left.ProEt)
      (b : T.left ⟶ V'.left) (hb : b ≫ V'.hom = T.hom ≫ lam)
      (hb' : (b ≫ g.left) ≫ V.hom = T.hom ≫ lam)
      (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V' T b hb (((wcRq h ℓ (n - 1)).obj.map g.op).hom s) = β V T (b ≫ g.left) hb' s) ∧
  ∀ (T : (wcP1Over F'').left.ProEt) (a : T ⟶ π.W) (b : T.left ⟶ Ω.W'.left)
    (hb : b ≫ Ω.W'.hom = T.hom ≫ lam), ConnectedSpace T.left →
    a.left ≫ π.w.left ≫ Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      b ≫ Ω.w'.left ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) →
    ∃ M : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]), wcPfamLineCmp π Ω lam β T a b hb M
noncomputable def wcSddcUnitsFun : Scheme.{u}ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
    AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable def wcSddcMPre (Y : Scheme.{u}) (O : Y.Opens) : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  (wcProEtBaseChange O.ι).op ⋙ ((Scheme.ProEt.forget O.toScheme ⋙ Over.forget O.toScheme).op ⋙
    Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u})

noncomputable def wcSddcFst (Y : Scheme.{u}) (O : Y.Opens) :
    wcProEtBaseChange O.ι ⋙ Scheme.ProEt.forget O.toScheme ⋙ Over.forget O.toScheme ⟶
      Scheme.ProEt.forget Y ⋙ Over.forget Y where
  app W := Limits.pullback.fst W.hom O.ι
  naturality W W' f := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)

noncomputable def wcSddcIota (Y : Scheme.{u}) (O : Y.Opens) :
    (Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⟶
      wcSddcMPre Y O :=
  Functor.whiskerRight (NatTrans.op (wcSddcFst Y O)) wcSddcUnitsFun

noncomputable def wcSddcOpenSub {S : Scheme.{u}} (W : S.ProEt) (N : W.left.Opens) : S.ProEt :=
  MorphismProperty.Over.mk ⊤ (N.ι ≫ W.hom)
    (@MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ (etale_le_weaklyEtale _ _ _ inferInstance) W.prop)

noncomputable def wcSddcOpenSubIncl {S : Scheme.{u}} (W : S.ProEt) (N : W.left.Opens) :
    wcSddcOpenSub W N ⟶ W :=
  MorphismProperty.Over.homMk N.ι rfl trivial

noncomputable def wcSddcYU (Y : Scheme.{u}) (U : Y.Opens) : Y.ProEt :=
  wcSddcOpenSub (Scheme.ProEt.mk (𝟙 Y)) U

noncomputable def wcSddcUnitOr {R : Type*} [Monoid R] (x : R) : Rˣ := by
  classical
  exact if h : IsUnit x then h.unit else 1

noncomputable def wcSddcSigma (Y : Scheme.{u}) (O : Y.Opens) (U : Y.Opens) (t : Γ(Y, U)) :
    (wcSddcMPre Y O).obj (Opposite.op (wcSddcYU Y U)) :=
  ULift.up (Additive.ofMul (wcSddcUnitOr
    ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t))))

def wcSddcLE {Y Z : Scheme.{u}} (i : Z ⟶ Y) (U : Y.Opens) (t : Γ(Y, U)) : Prop :=
  IsAffineOpen U ∧ t ∈ nonZeroDivisors Γ(Y, U) ∧
    (∀ (x : Y) (hx : x ∈ U), x ∈ Set.range i ↔
      (Y.presheaf.germ U x hx).hom t ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) ∧
    ∀ (z : Z) (hz : i z ∈ U), Function.Surjective (i.stalkMap z).hom ∧
      RingHom.ker (i.stalkMap z).hom = Ideal.span {(Y.presheaf.germ U (i z) hz).hom t}

def wcSddcLocDesc {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
    (p : wcSddcMPre Y O ⟶ D.obj) (W : Y.ProEt) (s : D.obj.obj (Opposite.op W)) (x : W.left) :
    Prop :=
  ∃ N : W.left.Opens, x ∈ N ∧
    (((∀ z : ↥(Limits.pullback W.hom i : Scheme.{u}), Limits.pullback.fst W.hom i z ∉ N) ∧
        D.obj.map (wcSddcOpenSubIncl W N).op s = 0) ∨
      ∃ (U : Y.Opens) (t : Γ(Y, U)) (c : ℤ) (g : wcSddcOpenSub W N ⟶ wcSddcYU Y U),
        wcSddcLE i U t ∧
        D.obj.map (wcSddcOpenSubIncl W N).op s =
          c • D.obj.map g.op (p.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)))
noncomputable def wcQmInv {X B : Scheme.{u}} (g : X ⟶ B) :
    Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} :=
  sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⋙
    (wcEtBaseChange g).op.lan ⋙ presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}

instance wcQmInv.instPZM {X B : Scheme.{u}} (g : X ⟶ B) : (wcQmInv g).PreservesZeroMorphisms := by
  haveI : ((wcEtBaseChange g).op.lan : ((B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ _).IsLeftAdjoint :=
    (Functor.lanAdjunction _ _).isLeftAdjoint
  unfold wcQmInv
  infer_instance



noncomputable def wcQmHyp (Y : Scheme.{u})
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ℕ) (q : ℕ) :=
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  ((DerivedCategory.singleFunctor (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).obj
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶
    (shiftFunctor (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}))
      (q : ℤ)).obj (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)))


noncomputable abbrev wcQmCx {M Y Z : Scheme.{u}} (G : M ⟶ Y) (i : Z ⟶ Y)
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}) ℕ) :
    CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ :=
  ((wcQmInv i).mapHomologicalComplex (ComplexShape.up ℕ)).obj
    (((wcEtPush G).mapHomologicalComplex (ComplexShape.up ℕ)).obj K)


noncomputable abbrev wcQmSp (A : Type u) [CommRing A] [IsLocalRing A] :
    Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
  Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))


abbrev wcQmUs {Z : Scheme.{u}} (z : Z) : Z.Opens :=
  ⟨(closure {z})ᶜ, isClosed_closure.isOpen_compl⟩


noncomputable abbrev wcQmWs {Z Y X : Scheme.{u}} (i : Z ⟶ Y) (j : X ⟶ Y) [IsOpenImmersion j]
    (z : Z) : Z.Opens :=
  wcQmUs z ⊓ i ⁻¹ᵁ j.opensRange


def wcQmOffV {Z : Scheme.{u}} (U W : Z.Opens) (hWU : W ≤ U)
    (F : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ) (m : ℕ) :
    Prop :=
  ∃ (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (W : Scheme.{u}))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))
    (φ : ((wcQmInv U.ι).mapHomologicalComplex (ComplexShape.up ℕ)).obj F ⟶
      ((wcEtPush (Z.homOfLE hWU)).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex),
    QuasiIso φ


def wcQmBdChart {Xb X : Scheme.{u}} (A : Type u) [CommRing A] [IsLocalRing A]
    (pb : Xb ⟶ Spec (.of A)) (j : X ⟶ Xb) (d : ℕ) : Prop :=
  ∀ y : Xb, pb y = IsLocalRing.closedPoint A → y ∉ Set.range j →
    ∃ (V : Xb.Opens) (e : (V : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Option (Fin d)) A))),
      y ∈ V ∧ Etale e ∧
      e ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Option (Fin d)) A))) =
        V.ι ≫ pb ∧
      ∀ v : (V : Scheme.{u}), (V.ι v ∉ Set.range j ↔
        (MvPolynomial.X none : MvPolynomial (Option (Fin d)) A) ∈ (e v).asIdeal)
def wcLdnmDiaCoord (K : Type u) [Field K] (M : ℕ) (s : wcProjK K M) (r : Fin (M + 1))
    (α : Fin (M + 1) → K) : Prop :=
  ∃ hr : s ∈ wcSgD K M r, ∀ q : Fin (M + 1),
    ((wcProjK K M).presheaf.germ (wcSgD K M r) s hr).hom (wcSgE K M r q) -
        wcLdpConst K (wcProjKStr K M) s (α q) ∈
      IsLocalRing.maximalIdeal ((wcProjK K M).presheaf.stalk s)


def wcLdnmDiaSing (K : Type u) [Field K] (N : ℕ) {X : Scheme.{u}} (ι : X ⟶ wcProjK K N)
    (α : Fin (N + 1) × Fin (N + 1) → K) (x : X) : Prop :=
  ∀ (b : Fin (N + 1)) (hb : x ∈ ι ⁻¹ᵁ wcSgD K N b),
    wcLdpGerm K N ι (wcLdpQuad K N fun p p' => α (p, p')) b x hb ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2
def wcFpqcFamDescHyp.{w} : Prop :=
  ∀ (T Y : Scheme.{w}) (I : Type) [Finite I] (X : I → Scheme.{w}) (f : ∀ i, X i ⟶ T),
    (∀ i, Flat (f i)) → (∀ i, QuasiCompact (f i)) → (∀ x : T, ∃ i, x ∈ Set.range (f i)) →
    ∀ (s : ∀ i, X i ⟶ Y),
      (∀ (i j : I) (Z : Scheme.{w}) (a : Z ⟶ X i) (b : Z ⟶ X j), a ≫ f i = b ≫ f j →
        a ≫ s i = b ≫ s j) →
      ∃! φ : T ⟶ Y, ∀ i, f i ≫ φ = s i

def wcFpqcLcDescHyp.{w} : Prop :=
  ∀ (T : Scheme.{w}) (I : Type) [Finite I] (X : I → Scheme.{w}) (f : ∀ i, X i ⟶ T),
    (∀ i, Flat (f i)) → (∀ i, QuasiCompact (f i)) → (∀ x : T, ∃ i, x ∈ Set.range (f i)) →
    ∀ (A : Type) (h : ↥T → A), (∀ i, IsLocallyConstant (fun x : ↥(X i) => h (f i x))) →
    IsLocallyConstant h
def wcMntTame {A L : Type u} [CommRing A] [Field L] (ℓ : ℕ) (φA : A →+* L) (σ : L →+* L)
    (ϖ : A) : Prop :=
  ∀ k : ℕ, 1 ≤ k → ∀ z : L, z ^ (ℓ ^ k) = φA ϖ → IsPrimitiveRoot (σ z * z⁻¹) (ℓ ^ k)
def wcVQFrame {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]) : Prop :=
  ∀ (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W)) (z : W.left),
    (show C(↥W.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
    g.mulVec ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)

def wcVQGalFrame {F' F'' : Type u} [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) : Prop :=
  (∀ c : ℚ_[ℓ],
    ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
        (wcPencilVQScalar D ℓ hP c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over F'').left ℓ r c)) ∧
  QuasiCompact w.left ∧ ConnectedSpace W.left ∧
  (∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
  (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
    (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
      D.S i (IsLocalRing.closedPoint F'')) →
    ∃ z : W.left, w.left z = p) ∧
  (∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
    a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) ∧
  φ ≫ w = w ≫ wcGeomFrob F'' (wcP1Over F'') hP ∧
  (∀ δ : W ⟶ W, δ ≫ w = w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ γ ≫ φ = φ ≫ δ) ∧
  (∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), γ ≫ w = w →
    wcVQFrame D ℓ hP W r θ γ g → ∀ a b, ‖g a b‖ ≤ 1) ∧
  (∀ g : Matrix (Fin r) (Fin r) ℚ_[ℓ], wcVQFrame D ℓ hP W r θ φ g →
    (∀ a b, ‖g a b‖ ≤ 1) ∧ ∃ g' : Matrix (Fin r) (Fin r) ℚ_[ℓ], g * g' = 1 ∧ ∀ a b, ‖g' a b‖ ≤ 1)
noncomputable def wcQmEdge (Y : Scheme.{u}) (y : Y)
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ℕ) (q : ℕ) :
    wcQmHyp Y K q → (wcEtStalk Y y).obj (K.homology q) :=
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  fun e =>
    wcEtGlobalGerm (K.homology q) y
      ((((DerivedCategory.singleFunctorCompHomologyFunctorIso
            (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).inv.app
            ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫
          (DerivedCategory.homologyFunctor
            (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).map e ≫
          ((DerivedCategory.homologyFunctor
            (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) 0).shiftIso
              (q : ℤ) 0 (q : ℤ) (add_zero _)).hom.app
            (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫
          (DerivedCategory.homologyFunctorFactors
            (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (q : ℤ)).hom.app
            (K.extend ComplexShape.embeddingUpNat) ≫
          (K.extendHomologyIso ComplexShape.embeddingUpNat rfl).hom).hom.app
          (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
        (((toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Scheme.Etale Y)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app
            (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up 1)))
noncomputable def wcPfamLineIota {X B : Scheme.{u}} (lam : B ⟶ X) (V : X.ProEt) (T : B.ProEt)
    (b : T.left ⟶ V.left) (hb : b ≫ V.hom = T.hom ≫ lam) :
    T ⟶ (wcProEtBaseChange lam).obj V :=
  MorphismProperty.Over.homMk (Limits.pullback.lift b T.hom hb) (Limits.pullback.lift_snd _ _ _)
    trivial
noncomputable def wcLtdRing {X Y : Scheme.{u}} {R S : Type u} [CommRing R] [CommRing S]
    (eX : X ≅ Spec (.of R)) (eY : Y ≅ Spec (.of S)) (g : Y ⟶ X) : R →+* S :=
  (Spec.preimage (eY.inv ≫ g ≫ eX.hom)).hom

def wcLtdTameAgree {A L : Type u} [CommRing A] [Field L] (p : ℕ) (ι : A →+* L) (f : A)
    (σ₁ σ₂ : L →+* L) : Prop :=
  ∀ (w : L) (m : ℕ), 0 < m → ¬ p ∣ m → w ^ m = ι f → σ₁ w = σ₂ w
def wcPfamEllTame {F'' : Type u} [Field F''] (M' : ℕ) (Δ : Set (wcProjK F'' M')) (ℓ : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    {E : Scheme.{u}} (πE : E ⟶ Ub.toScheme) : Prop :=
  ∀ (V T₀ : (wcProjK F'' M').ProEt) (u : T₀ ⟶ V)
    (v : V ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A)) (L₀ : Type u) [Field L₀] [IsSepClosed L₀]
    (_ : T₀.left ≅ Spec (.of L₀)),
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (v.left (e.inv (IsLocalRing.closedPoint A))) ∈ Δ →
    (∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {v.left (e.inv (IsLocalRing.closedPoint A))}) →
    ∀ τ : T₀ ⟶ T₀, τ ≫ u = u → ∀ x : T₀.left ⟶ E, x ≫ πE ≫ Ub.ι = u.left ≫ v.left →
      ∃ k : ℕ, (fun f : T₀.left ⟶ E => τ.left ≫ f)^[ℓ ^ k] x = x
def wcSddcH0 {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (p' : wcSddcMPre Y O ⟶ D.obj) : Prop :=
  ∀ (W : Y.ProEt) (m : (wcSddcMPre Y O).obj (Opposite.op W)),
    (∀ w : W.left, W.hom w ∉ Set.range i) → p'.app (Opposite.op W) m = 0

def wcSddcHc {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (p' : wcSddcMPre Y O ⟶ D.obj) : Prop :=
  ∀ (W : Y.ProEt) (U U' : Y.Opens) (t : Γ(Y, U)) (t' : Γ(Y, U'))
    (g : W ⟶ wcSddcYU Y U) (g' : W ⟶ wcSddcYU Y U'), wcSddcLE i U t → wcSddcLE i U' t' →
    D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) =
      D.obj.map g'.op (p'.app (Opposite.op (wcSddcYU Y U')) (wcSddcSigma Y O U' t'))

def wcSddcHn {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (p' : wcSddcMPre Y O ⟶ D.obj) : Prop :=
  ∀ (W : Y.ProEt) (U : Y.Opens) (t : Γ(Y, U)) (g : W ⟶ wcSddcYU Y U) (c : ℤ), wcSddcLE i U t →
    (∃ w : W.left, W.hom w ∈ Set.range i) →
    c • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) = 0 → c = 0

def wcSddcDesc {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (p' : wcSddcMPre Y O ⟶ D.obj)
    (W : Y.ProEt) (b : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W)))
    (s : D.obj.obj (Opposite.op W)) : Prop :=
  ∀ x : W.left, ∃ N : W.left.Opens, x ∈ N ∧
    (((∀ z : ↥(Limits.pullback W.hom i), Limits.pullback.fst W.hom i z ∉ N) ∧
        D.obj.map (wcSddcOpenSubIncl W N).op s = 0) ∨
      ∃ (U : Y.Opens) (t : Γ(Y, U)) (c : ℤ) (g : wcSddcOpenSub W N ⟶ wcSddcYU Y U),
        wcSddcLE i U t ∧
        (∀ z : ↥(Limits.pullback W.hom i), Limits.pullback.fst W.hom i z ∈ N →
          wcContEval Z ((wcProEtBaseChange i).obj W) b z = c) ∧
        D.obj.map (wcSddcOpenSubIncl W N).op s =
          c • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)))
def wcSddcDatum {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (p' : wcSddcMPre Y O ⟶ D.obj)
    (W : Y.ProEt) (b : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W)))
    (N : W.left.Opens) (v : D.obj.obj (Opposite.op (wcSddcOpenSub W N))) : Prop :=
  ((∀ z : ↥(Limits.pullback W.hom i), Limits.pullback.fst W.hom i z ∉ N) ∧ v = 0) ∨
    ∃ (U : Y.Opens) (t : Γ(Y, U)) (c : ℤ) (g : wcSddcOpenSub W N ⟶ wcSddcYU Y U),
      wcSddcLE i U t ∧
      (∀ z : ↥(Limits.pullback W.hom i), Limits.pullback.fst W.hom i z ∈ N →
        wcContEval Z ((wcProEtBaseChange i).obj W) b z = c) ∧
      v = c • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t))
noncomputable def wcTpsRingOf {X : Scheme.{u}} {T V : X.ProEt} {S R : Type u} [CommRing S]
    [CommRing R] (eT : T.left ≅ Spec (.of S)) (eV : V.left ≅ Spec (.of R)) (u : T ⟶ V) :
    R →+* S :=
  (Spec.preimage (eT.inv ≫ u.left ≫ eV.hom)).hom


noncomputable abbrev wcTpsBase {X : Scheme.{u}} {T V : X.ProEt} {L R : Type u} [Field L]
    [CommRing R] (eL : T.left ≅ Spec (.of L)) (eV : V.left ≅ Spec (.of R)) (u : T ⟶ V) :
    Subfield L :=
  Subfield.closure (Set.range (wcTpsRingOf eL eV u))
noncomputable abbrev wcQmbtGen (A' : Type u) [CommRing A'] (n : ℕ) (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') : Option (Fin n) → wcQuadModelRing A' n (π' ^ 2) c' :=
  fun i => Option.elim i (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π')
    (fun p => Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p))

noncomputable abbrev wcQmbtChartHat {A' : Type u} [CommRing A'] {n : ℕ} (j p : Fin n) :
    MvPolynomial (Option (Fin n)) A' :=
  if p = j then 1 else MvPolynomial.X (some p)

noncomputable abbrev wcQmbtChartIdeal (A' : Type u) [CommRing A'] (n : ℕ) (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) : Ideal (MvPolynomial (Option (Fin n)) A') :=
  Ideal.span {MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π',
    ∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q -
      MvPolynomial.X none ^ 2}

abbrev wcQmbtChart (A' : Type u) [CommRing A'] (n : ℕ) (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) : Type u :=
  MvPolynomial (Option (Fin n)) A' ⧸ wcQmbtChartIdeal A' n π' c' j

noncomputable abbrev wcQmbtChartNoneIdeal (A' : Type u) [CommRing A'] (n : ℕ)
    (c' : Matrix (Fin n) (Fin n) A') : Ideal (MvPolynomial (Fin n) A') :=
  Ideal.span {∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1}

abbrev wcQmbtChartNone (A' : Type u) [CommRing A'] (n : ℕ) (c' : Matrix (Fin n) (Fin n) A') :
    Type u :=
  MvPolynomial (Fin n) A' ⧸ wcQmbtChartNoneIdeal A' n c'

noncomputable abbrev wcQmbtCharts (A' : Type u) [CommRing A'] (n : ℕ) (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') : Option (Fin n) → CommRingCat.{u} :=
  fun k => Option.elim k (CommRingCat.of (wcQmbtChartNone A' n c'))
    (fun j => CommRingCat.of (wcQmbtChart A' n π' c' j))

abbrev wcQmbtSSRing (A' : Type u) [CommRing A'] (m : ℕ) (π' : A') : Type u :=
  wcQuadModelRing A' (m + 2) π'
    (Matrix.of fun i j : Fin (m + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
abbrev wcQmtmC (A : Type u) [CommRing A] (r : ℕ) : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
  Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0

noncomputable abbrev wcQmtmX {A : Type u} [CommRing A] {r : ℕ} {π : A} {B : Type u} [CommRing B]
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (k : Fin (r + 2)) : B :=
  (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
    (MvPolynomial.X k))

noncomputable abbrev wcQmtmPush {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) :
    SheafOfModules.{u+1} (wcRingSheaf S' ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ) :=
  @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ

noncomputable abbrev wcQmtmUnit {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) :
    SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ (wcQmtmPush D).obj (SheafOfModules.unit (wcRingSheaf S' ℓ)) :=
  @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ

noncomputable def wcQmtmAlpha {S S' : Scheme.{u}} (f : S' ⟶ S) (w : S' ⟶ S') (hcomp : w ≫ f = f) :
    wcProEtBC f ⟶ wcProEtBC f ⋙ wcProEtBC w :=
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong f))
      (@WeaklyEtale : MorphismProperty Scheme.{u})
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
      (@WeaklyEtale : MorphismProperty Scheme.{u})
  (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
    (Q := ⊤) _ _ _ hcomp.symm).hom

def wcQmtmHPhi {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hcomp : w ≫ f = f) (Df : wcHMPullData f ℓ) (Dw : wcHMPullData w ℓ) : Prop :=
  haveI := Df.cont
  haveI := Dw.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dw.φ) ≫
    (Functor.sheafPushforwardContinuousNatTrans (wcQmtmAlpha f w hcomp) RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).app (wcRingSheaf S' ℓ) = Df.φ

noncomputable def wcQmtmGamma {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (hcomp : w ≫ f = f) (Df : wcHMPullData f ℓ) (Dw : wcHMPullData w ℓ)
    (hφ : wcQmtmHPhi hcomp Df Dw) :
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ) ⋙
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ) ⟶
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ) :=
  haveI := Df.cont
  haveI := Dw.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
    SheafOfModules.pushforwardNatTrans _ (wcQmtmAlpha f w hcomp) ≫
    (SheafOfModules.pushforwardCongr hφ).hom

structure wcQmtmTower {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    (ℓ : ℕ) (φA : A →+* L) (σ : L →+* L) {XE : Scheme.{u}}
    (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L)) (w : XE ⟶ XE) (x₀ : B) where
  ζ : ℕ → L
  hζ : ∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k)
  hζc : ∀ k, ζ (k + 1) ^ ℓ = ζ k
  hζA : ∀ k, ∃ a : A, φA a = ζ k
  χ : Multiplicative (Localization.Away (ℓ : ℤ)) →* Lˣ
  hχ : ∀ (a : ℤ) (k : ℕ), ((χ (Multiplicative.ofAdd
    (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) : Lˣ) : L) = ζ k ^ a
  γR : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
    AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))
  hγR : ∀ (x : Localization.Away (ℓ : ℤ)) (c : L), γR (AddMonoidAlgebra.single x c) =
    AddMonoidAlgebra.single x (((χ (Multiplicative.ofAdd x) : Lˣ) : L) * c)
  σG : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
    AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))
  hσG : ∀ (x : Localization.Away (ℓ : ℤ)) (c : L), σG (AddMonoidAlgebra.single x c) =
    AddMonoidAlgebra.single x (σ c)
  g₀ : XE ⟶ Spec (CommRingCat.of (LaurentPolynomial L))
  hg₀q : g₀ ≫ Spec.map (CommRingCat.ofHom (LaurentPolynomial.C : L →+* LaurentPolynomial L)) = q
  hg₀T : g₀.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
      (LaurentPolynomial.T 1)) = p.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x₀)
  XEi : Scheme.{u}
  πi : XEi ⟶ XE
  gi : XEi ⟶ Spec (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))
  hT : IsPullback πi gi g₀ (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
    (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))
  γi : XEi ⟶ XEi
  wi : XEi ⟶ XEi
  hγπ : γi ≫ πi = πi
  hγg : γi ≫ gi = gi ≫ Spec.map (CommRingCat.ofHom γR)
  hwπ : wi ≫ πi = πi ≫ w
  hwg : wi ≫ gi = gi ≫ Spec.map (CommRingCat.ofHom σG)

def wcQmtmGammaSec {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Dπ : wcHMPullData T.πi ℓ)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) : Prop :=
  ∀ (V : XE.ProEt) (s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]))
    (κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi),
    κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
    κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ T.γi →
    ((γN.val.app (Opposite.op V)).hom s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) =
      s.comp κ.base.hom

def wcQmtmActSec {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Dπ : wcHMPullData T.πi ℓ) (Dτ : wcHMPullData w ℓ)
    (aN : wcSuppObj Dπ ⟶ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w) _ _ Dτ.cont Dτ.φ).obj (wcSuppObj Dπ)) : Prop :=
  ∀ (V : XE.ProEt) (s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]))
    (κ : Limits.pullback (Limits.pullback.snd V.hom w) T.πi ⟶ Limits.pullback V.hom T.πi),
    κ ≫ Limits.pullback.fst V.hom T.πi =
      Limits.pullback.fst (Limits.pullback.snd V.hom w) T.πi ≫ Limits.pullback.fst V.hom w →
    κ ≫ Limits.pullback.snd V.hom T.πi =
      Limits.pullback.snd (Limits.pullback.snd V.hom w) T.πi ≫ T.wi →
    ((aN.val.app (Opposite.op V)).hom s :
      C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])) =
      s.comp κ.base.hom
noncomputable abbrev wcQmbtCnPres (M : Type u) [CommRing M] (g : Polynomial M) (b : M) :
    Ideal (MvPolynomial (Fin 2) M) :=
  Ideal.span {Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) M) g,
    MvPolynomial.X 1 * MvPolynomial.C b *
      Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) M) (Polynomial.derivative g) - 1}

noncomputable abbrev wcQmbtCnMk (A' : Type u) [CommRing A'] (n : ℕ) (π' : A') :
    MvPolynomial (Fin (n - 2 + 2)) A' →+* wcQmbtSSRing A' (n - 2) π' :=
  Ideal.Quotient.mk _

noncomputable def wcQmbtCnHat {A' : Type u} [CommRing A'] (π' : A') {n : ℕ} (i k0 : Fin n)
    (eps : A') (e : Fin n ≃ Fin (n - 2 + 2)) (p : Fin n) : Polynomial (wcQmbtSSRing A' (n - 2) π') :=
  if p = i then Polynomial.X else
    Polynomial.C (wcQmbtCnMk A' n π' (MvPolynomial.X (e p)) -
      if p = k0 then algebraMap A' (wcQmbtSSRing A' (n - 2) π') eps else 0)

noncomputable def wcQmbtCnPoly {A' : Type u} [CommRing A'] (π' : A') {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (i k0 : Fin n) (eps : A') (e : Fin n ≃ Fin (n - 2 + 2)) :
    Polynomial (wcQmbtSSRing A' (n - 2) π') :=
  ∑ p, ∑ q, Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) *
    wcQmbtCnHat π' i k0 eps e p * wcQmbtCnHat π' i k0 eps e q - 1

noncomputable def wcQmbtCnD {A' : Type u} [CommRing A'] {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (i : Fin n) : wcQmbtChartNone A' n c' :=
  Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
    (∑ q, (MvPolynomial.C (c' i q) + MvPolynomial.C (c' q i)) * MvPolynomial.X q)
noncomputable def wcTsfKappa {S' : Scheme.{u}} {w : S' ⟶ S'} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Dw : wcHMPullData w ℓ) (Pf : S'.ProEt → SheafOfModules.{u+1} (wcRingSheaf S' ℓ))
    (ev : ∀ (V : S'.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)),
      (Pf V ⟶ M) ≃ M.val.obj (Opposite.op V))
    (V : S'.ProEt) : Pf ((wcProEtBC w).obj V) ⟶ Dw.Φ.obj (Pf V) :=
  (ev ((wcProEtBC w).obj V) (Dw.Φ.obj (Pf V))).symm
    (((Dw.adj.unit.app (Pf V)).val.app (Opposite.op V)).hom (ev V (Pf V) (𝟙 _)))
noncomputable def wcModUnitOne {C : Type (u+1)} [Category.{u} C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{u+1}) (U : C) : (SheafOfModules.unit R).val.obj (Opposite.op U) :=
  (1 : R.val.obj (Opposite.op U))
def wcBpChartHyp {X X' : Scheme.{u}} (r : X' ⟶ X) {ι : Type} (g : ι → Γ(X, ⊤))
    (U : ι → X'.Opens) (t : ∀ l : ι, ι → Γ(X', U l)) : Prop :=
  (⨆ l, U l) = ⊤ ∧
  (∀ l, IsAffineOpen (U l)) ∧
  (∀ l j, (r.appLE ⊤ (U l) (by simp)).hom (g j) =
    t l j * (r.appLE ⊤ (U l) (by simp)).hom (g l)) ∧
  (∀ l, (r.appLE ⊤ (U l) (by simp)).hom (g l) ∈ nonZeroDivisors Γ(X', U l)) ∧
  (∀ l (s : Γ(X', U l)), s ∈ Subring.closure
    (Set.range (r.appLE ⊤ (U l) (by simp)).hom ∪ Set.range (t l))) ∧
  (∀ l k, X'.basicOpen (t l k) ≤ U k)
noncomputable def wcNodeBranchU {S : Scheme.{u}} {C : Type u} [CommRing C]
    (eC : S ≅ Spec (.of C)) (f : C) : S.ProEt :=
  wcVRes S (Scheme.ProEt.mk (𝟙 S)) (eC.hom ⁻¹ᵁ PrimeSpectrum.basicOpen f)
def wcNtcWConds (Δ : Scheme.{u}) : Prop :=
  IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
  (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
  ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
  (∀ x : Δ, IsClosed ({x} : Set Δ) →
    HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x))
noncomputable abbrev wcSecEv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt) :
    SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤ AddCommGrpCat.{u+1} :=
  SheafOfModules.toSheaf (wcRingSheaf S ℓ) ⋙
    sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation (S.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
noncomputable def wcR0 (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (S.ProEt)ᵒᵖ ⥤ CommRingCat.{u+1} :=
  (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
    ({ obj := fun U => CommRingCat.of C(↥(Opposite.unop U), ULift.{u+1} ℚ_[ℓ])
       map := fun f => CommRingCat.ofHom
         (ContinuousMap.compRightAlgHom ℤ (ULift.{u+1} ℚ_[ℓ]) f.unop.base.hom).toRingHom
       map_id := fun _ => rfl
       map_comp := fun _ _ => rfl } : Scheme.{u}ᵒᵖ ⥤ CommRingCat.{u+1})

noncomputable def wcTnsGen {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1}) (hR : Presheaf.IsSheaf J (R0 ⋙ forget₂ CommRingCat RingCat)) :
    SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
    SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
    SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) :=
  (SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat))) ⋙
    MonoidalCategory.curriedTensor _ ⋙
    (Functor.whiskeringLeft _ _ _).obj
      (SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat))) ⋙
    (Functor.whiskeringRight _ _ _).obj
      (PresheafOfModules.sheafification (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat)))

noncomputable def wcTns (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤
      SheafOfModules.{u+1} (wcRingSheaf S ℓ) :=
  wcTnsGen (Scheme.ProEt.topology S) (wcR0 S ℓ) (wcRingSheaf S ℓ).property
def wcTorsionPBCAt {S Z E : Scheme.{u}} (i : Z ⟶ S) (g : E ⟶ S) (m : ℕ) (W : S.ProEt) : Prop :=
  ∀ (Dg : wcZModPullData g m), wcZModPullCanonical Dg →
  ∀ (Di : wcZModPullData i m), wcZModPullCanonical Di →
  ∀ (I : InjectiveResolution (SheafOfModules.unit (wcZModRingSheaf E m))),
    haveI := Dg.additive
    haveI := Di.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let evW := SheafOfModules.toSheaf (wcZModRingSheaf S m) ⋙
      sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
    let evWs := SheafOfModules.toSheaf (wcZModRingSheaf Z m) ⋙
      sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
      (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op ((wcProEtBC i).obj W))
    ∀ (J : CochainComplex (SheafOfModules.{u+1} (wcZModRingSheaf Z m)) ℤ) (m₀ : ℤ),
      J.IsStrictlyGE m₀ → (∀ k, Injective (J.X k)) →
      ∀ (j : (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J), QuasiIso j →
      ∀ (w : (evW.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶
          (evWs.mapHomologicalComplex (ComplexShape.up ℤ)).obj J),
        (∀ (k : ℤ) (x : (K.X k).val.obj (Opposite.op W)),
          (w.f k).hom x =
            ((j.f k).val.app (Opposite.op ((wcProEtBC i).obj W))).hom
              (((Di.adj.unit.app (K.X k)).val.app (Opposite.op W)).hom x)) →
        QuasiIso w
def wcQx1uKummerChar {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Vt : (Spec (.of B)).ProEt)
    (sc : ℤ_[ℓ] → (Limits.pullback Vt.hom p ⟶
      Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi))
    (v : ℕ → Γ(Limits.pullback Vt.hom p, ⊤)) : Prop :=
  (∀ a : ℤ_[ℓ], sc a ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi = 𝟙 _) ∧
  ∀ (a : ℤ_[ℓ]) (m k : ℕ) (c : L),
    (sc a ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.gi).appTop.hom
      ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
        (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
      (Limits.pullback.snd Vt.hom p ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom c) *
        ((Limits.pullback.snd Vt.hom p ≫ q).appTop.hom
            ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^ (PadicInt.toZModPow k a).val *
          v k) ^ m
noncomputable abbrev wcXnpC0 (A : Type u) [CommRing A] (r : ℕ) : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
  Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0

noncomputable abbrev wcXnpX (A : Type u) [CommRing A] (r : ℕ) (π : A) (i : Fin (r + 2)) :
    wcQuadModelRing A (r + 2) π (wcXnpC0 A r) :=
  Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcXnpC0 A r)) (MvPolynomial.X i)

noncomputable abbrev wcXnpX0 (A : Type u) [CommRing A] (r : ℕ) (π : A) :
    wcQuadModelRing A (r + 2) π (wcXnpC0 A r) :=
  wcXnpX A r π ⟨0, by omega⟩

noncomputable abbrev wcXnpX1 (A : Type u) [CommRing A] (r : ℕ) (π : A) :
    wcQuadModelRing A (r + 2) π (wcXnpC0 A r) :=
  wcXnpX A r π ⟨1, by omega⟩

noncomputable abbrev wcXnpEis (A : Type u) [CommRing A] (ℓ : ℕ) (π : A) : Type u :=
  AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C π)

noncomputable abbrev wcXnpRho (A : Type u) [CommRing A] (ℓ : ℕ) (π : A) : wcXnpEis A ℓ π :=
  AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C π)

noncomputable abbrev wcXnpS (A : Type u) [CommRing A] (ℓ : ℕ) (π : A) (r : ℕ) : Type u :=
  wcQuadModelRing (wcXnpEis A ℓ π) (r + 2) (wcXnpRho A ℓ π) (wcXnpC0 (wcXnpEis A ℓ π) r)

noncomputable abbrev wcXnpCovIdeal (C : Type u) [CommRing C] (n : ℕ) (c0 c1 : C) :
    Ideal (MvPolynomial (Fin 2) C) :=
  Ideal.span {MvPolynomial.X 0 ^ n - MvPolynomial.C c0, MvPolynomial.X 1 ^ n - MvPolynomial.C c1}

noncomputable abbrev wcXnpCov (C : Type u) [CommRing C] (n : ℕ) (c0 c1 : C) : Type u :=
  MvPolynomial (Fin 2) C ⧸ wcXnpCovIdeal C n c0 c1

noncomputable abbrev wcXnpY (C : Type u) [CommRing C] (n : ℕ) (c0 c1 : C) (i : Fin 2) :
    wcXnpCov C n c0 c1 :=
  Ideal.Quotient.mk (wcXnpCovIdeal C n c0 c1) (MvPolynomial.X i)
def wcXspSplitCoeff (Ω : Type u) [Field Ω] (e : ℕ) (p q : Fin (2 * e + 2 + 1)) : Ω :=
  if p.val % 2 = 0 ∧ q.val = p.val + 1 ∧ p.val < 2 * e + 2 then 1
  else if p.val = 2 * e + 2 ∧ q.val = 2 * e + 2 then -1 else 0


def wcXspExtCoeff {k : Type u} [Field k] {n : ℕ} (a0 : Fin n → Fin n → k)
    (p q : Fin (n + 1)) : k :=
  if h : p.val < n ∧ q.val < n then a0 ⟨p.val, h.1⟩ ⟨q.val, h.2⟩
  else if p.val = n ∧ q.val = n then -1 else 0


def wcXspVplus (K : Type u) [Field K] (N : ℕ) (a : Fin (N + 1) → Fin (N + 1) → K) :
    Set (wcProjK K N) :=
  {p | p ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      ((wcLdpQuad K N a : MvPolynomial (Fin (N + 1)) K))}
noncomputable abbrev wcZModSecEv (S : Scheme.{u}) (m : ℕ) (W : S.ProEt) :
    SheafOfModules.{u+1} (wcZModRingSheaf S m) ⥤ AddCommGrpCat.{u+1} :=
  SheafOfModules.toSheaf (wcZModRingSheaf S m) ⋙
    sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
def wcAbPBCAt {S Z E : Scheme.{u}} (i : Z ⟶ S) (g : E ⟶ S) (W : S.ProEt)
    (hi : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z))
    (hg : (wcProEtBC g).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology E))
    (M : Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}) : Prop :=
  letI := hi
  letI := hg
  let Pg := (wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)
  let Pi := (wcProEtBC i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  let Li := (wcProEtBC i).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  let adj := (wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  haveI : Pg.Additive := by
    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := ((wcProEtBC g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)).rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Pi.Additive := by
    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := adj.rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Li.Additive := Adjunction.left_adjoint_additive adj
  ∀ (I : InjectiveResolution M),
    let K := (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    ∀ (J : CochainComplex (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) ℤ) (m₀ : ℤ),
      J.IsStrictlyGE m₀ → (∀ m, Injective (J.X m)) →
      ∀ (j : (Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J), QuasiIso j →
      ∀ (w : ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
            (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj K ⟶
          ((sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
            (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj
              (Opposite.op ((wcProEtBC i).obj W))).mapHomologicalComplex (ComplexShape.up ℤ)).obj J),
        (∀ (m : ℤ) (x : (K.X m).obj.obj (Opposite.op W)),
          (w.f m).hom x = ((j.f m).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom
            (((adj.unit.app (K.X m)).hom.app (Opposite.op W)).hom x)) →
        QuasiIso w
abbrev wcYrcWCTR {S : Scheme.{u}} (W : S.ProEt) : Prop :=
  IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
    (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
    ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
    (∀ x : W.left, IsClosed ({x} : Set W.left) →
      HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))

abbrev wcYrcAP {Wl Y : Scheme.{u}} (w : Wl ⟶ Y) {N : ℕ} (V : Fin N → Y.Opens) (n : ℕ)
    (ε : Fin n → Γ(Wl, ⊤)) (j : Fin n → Fin N) : Prop :=
  (∀ a, ε a * ε a = ε a) ∧ (∀ a b, a ≠ b → ε a * ε b = 0) ∧ ∑ a, ε a = 1 ∧
    ∀ a, ∀ v : Wl, v ∈ Wl.basicOpen (ε a) → w v ∈ V (j a)

abbrev wcYrcKummerPkg (L : Type u) [Field L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1) : Prop :=
  (∀ (T : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (k : ℕ) (a b : (Γ(T, ⊤))ˣ),
      κt T qT k (a * b) = κt T qT k a + κt T qT k b) ∧
    (∀ (T T' : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (qT' : T' ⟶ Spec (.of L)) (f : T' ⟶ T),
      f ≫ qT = qT' → ∀ (k : ℕ) (D : wcZModPullData f (ℓ ^ k)), wcZModPullCanonical D →
      ∀ a : (Γ(T, ⊤))ˣ, wcZModPull D 1 (κt T qT k a) =
        κt T' qT' k (Units.map f.appTop.hom.toMonoidHom a)) ∧
    (∀ (T : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (k : ℕ) (a : (Γ(T, ⊤))ˣ), 1 ≤ k →
      (κt T qT k a = 0 ↔ ∃ b : (Γ(T, ⊤))ˣ, b ^ (ℓ ^ k) = a)) ∧
    (∀ (T : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (k : ℕ) (a : (Γ(T, ⊤))ˣ), 1 ≤ k →
      wcIntRed T ℓ k 1 (κΛ T qT a) = κt T qT k a)
noncomputable abbrev wcQmbtBofQhat (K : Type u) [CommRing K] (n : ℕ) (c : Matrix (Fin n) (Fin n) K)
    (j : Fin n) : MvPolynomial (Option (Fin n)) K :=
  ∑ p, ∑ q, MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q

noncomputable def wcQmbtBofRelNone (K : Type u) [CommRing K] (n : ℕ) (c : Matrix (Fin n) (Fin n) K) :
    Fin 1 → MvPolynomial (Fin n) K :=
  fun _ => ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
    MvPolynomial.C 1

noncomputable def wcQmbtBofRelChart (K : Type u) [CommRing K] (n : ℕ) (c : Matrix (Fin n) (Fin n) K)
    (j : Fin n) : Fin 2 → MvPolynomial (Option (Fin n)) K :=
  ![MvPolynomial.X (some j), wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2]

noncomputable def wcQmbtBofRelDiv (K : Type u) [CommRing K] (n : ℕ) (c : Matrix (Fin n) (Fin n) K)
    (j : Fin n) : Fin 3 → MvPolynomial (Option (Fin n)) K :=
  ![MvPolynomial.X (some j), MvPolynomial.X none, wcQmbtBofQhat K n c j]

noncomputable abbrev wcQmbtBofSIdeal (A' : Type u) [CommRing A'] (n : ℕ) (π' : A')
    (c : Matrix (Fin n) (Fin n) A') (j : Fin n) : Ideal (wcQmbtChart A' n π' c j) :=
  Ideal.span {Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c j) (MvPolynomial.X none)}
def wcZModClassicalMod (S : Scheme.{u}) (m : ℕ)
    (M : SheafOfModules.{u+1} (wcZModRingSheaf S m)) : Prop :=
  ∃ H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}, m • 𝟙 H = 0 ∧
    Nonempty ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj M ≅ (wcEpsInv S).obj H)
abbrev wcQmdlIdx {n : ℕ} (hn : 4 ≤ n) (j : Fin n) : Fin (n - 2 + 1 + 1) :=
  Fin.cast (by omega) j

noncomputable abbrev wcQmdlV (K : Type u) [Field K] {n : ℕ} (hn : 4 ≤ n) {E : Scheme.{u}}
    (jE : E ⟶ wcProjK K (n - 2 + 1)) (j : Fin n) : E.Opens :=
  jE ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)

noncomputable abbrev wcQmdlA {A' : Type u} [CommRing A'] [IsLocalRing A'] {n : ℕ} (hn : 4 ≤ n)
    (c' : Matrix (Fin n) (Fin n) A') {K : Type u} [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → K :=
  fun a b => σ (IsLocalRing.residue A' (c' (Fin.cast (by omega) a) (Fin.cast (by omega) b)))

noncomputable abbrev wcQmdlCX (A' : Type u) [CommRing A'] (n : ℕ) (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) (i : Option (Fin n)) : wcQmbtChart A' n π' c' j :=
  Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X i)

def wcQmdlChartPkg {A' : Type u} [CommRing A'] {n : ℕ} (π' : A') (c' : Matrix (Fin n) (Fin n) A')
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c')))
    (φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j)
    (φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c')
    (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁)
    (e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁) : Prop :=
  (∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (MvPolynomial.X (some j) * wcQmbtChartHat j p)) ∧
  (∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      algebraMap A' (wcQmbtChart A' n π' c' j)) ∧
  (∀ j, φ j (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c' j)) ∧
  (∀ j, Ideal.map (φ j) (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
      Ideal.span {φ j (wcQmbtGen A' n π' c' (some j))}) ∧
  (∀ p, φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π' * MvPolynomial.X p)) ∧
  φ0.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      algebraMap A' (wcQmbtChartNone A' n c') ∧
  (∀ j, IsOpenImmersion (e j)) ∧ IsOpenImmersion e0 ∧
  (∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j))) ∧
  e0 ≫ r₁ = Spec.map (CommRingCat.ofHom φ0) ∧
  ∀ x : X₁, (∃ y, e0 y = x) ∨ ∃ j y, e j y = x

def wcQmdlChiPkg {A' : Type u} [CommRing A'] [IsLocalRing A'] {n : ℕ} (π' : A') (hn : 4 ≤ n)
    (c' : Matrix (Fin n) (Fin n) A') {K : Type u} [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Over (Spec (.of K)))
    (jE : E.left ⟶ wcProjK K (n - 2 + 1)) (j : Fin n)
    (χ : wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
    (ψ : (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j))) : Prop :=
  χ (wcQmdlCX A' n π' c' j none) = 0 ∧ χ (wcQmdlCX A' n π' c' j (some j)) = 0 ∧
  (∀ p, p ≠ j → χ (wcQmdlCX A' n π' c' j (some p)) =
    (jE.app (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))).hom
      (wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) (wcQmdlIdx hn p))) ∧
  (∀ x : A', χ (algebraMap A' (wcQmbtChart A' n π' c' j) x) =
    wcCnSigma E.hom (wcQmdlV K hn jE j) (σ (IsLocalRing.residue A' x))) ∧
  ∀ f : wcQmbtChart A' n π' c' j,
    ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom f) =
      (wcQmdlV K hn jE j).topIso.inv.hom (χ f)
noncomputable abbrev wcQxeV (K : Type u) [Field K] {n : ℕ} {E : Scheme.{u}}
    (jE : E ⟶ wcProjK K n) (j : Fin n) : E.Opens :=
  jE ⁻¹ᵁ wcSgD K n j.castSucc

def wcQxeChiPkg {A' : Type u} [CommRing A'] [IsLocalRing A'] {n : ℕ} (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') {K : Type u} [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) {E : Scheme.{u}}
    (jE : E ⟶ wcProjK K n) (j : Fin n)
    (χ : wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
    (ψ : (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j))) : Prop :=
  χ (wcQmdlCX A' n π' c' j none) =
      (jE.app (wcSgD K n j.castSucc)).hom (wcSgE K n j.castSucc (Fin.last n)) ∧
  χ (wcQmdlCX A' n π' c' j (some j)) = 0 ∧
  (∀ p, p ≠ j → χ (wcQmdlCX A' n π' c' j (some p)) =
    (jE.app (wcSgD K n j.castSucc)).hom (wcSgE K n j.castSucc p.castSucc)) ∧
  (∀ x : A', χ (algebraMap A' (wcQmbtChart A' n π' c' j) x) =
    wcCnSigma (jE ≫ wcProjKStr K n) (wcQxeV K jE j) (σ (IsLocalRing.residue A' x))) ∧
  ∀ f : wcQmbtChart A' n π' c' j,
    ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom f) =
      (wcQxeV K jE j).topIso.inv.hom (χ f)
noncomputable abbrev wcYkpGpre (S : Scheme.{u}) : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
    CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable abbrev wcYkpMupre (S : Scheme.{u}) (m : ℕ) : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
    AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable abbrev wcYkpG (S : Scheme.{u})
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpGpre S)) :
    Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
  ⟨wcYkpGpre S, hG⟩

noncomputable abbrev wcYkpMu (S : Scheme.{u}) (m : ℕ)
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S m)) :
    Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
  ⟨wcYkpMupre S m, hμ⟩

noncomputable def wcYkpIota (S : Scheme.{u}) (m : ℕ)
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpGpre S))
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S m)) :
    wcYkpMu S m hμ ⟶ wcYkpG S hG :=
  ObjectProperty.homMk
    { app := fun W => AddCommGrpCat.ofHom
        { toFun := fun ζ => ULift.up (Additive.ofMul
            ((Additive.toMul ζ.down : rootsOfUnity m Γ(W.unop.left, ⊤)) : (Γ(W.unop.left, ⊤))ˣ))
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      naturality := by
        intro W W' g
        ext ζ
        apply ULift.ext
        apply Additive.toMul.injective
        apply Units.ext
        rfl }

def wcYkpDlog (L : Type u) [Field L] (S : Scheme.{u}) (qS : S ⟶ Spec (.of L)) (m : ℕ) (ζ : L)
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S m))
    (e : wcYkpMu S m hμ ≅ wcContSheaf S (ZMod m)) : Prop :=
  ∀ (W : S.ProEt) (v : rootsOfUnity m Γ(W.left, ⊤)) (z : W.left) (j : ℕ),
    (show C(↥W.left, ZMod m) from
      ((e.hom.hom.app (Opposite.op W)).hom (ULift.up (Additive.ofMul v))).down) z = (j : ZMod m) ↔
      (W.left.evaluation ⊤ z trivial).hom ((v : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) =
        ((W.left.evaluation ⊤ z trivial).hom
          ((W.hom ≫ qS).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom ζ))) ^ j
noncomputable def wcYkpPow (S : Scheme.{u}) (ℓ k : ℕ)
    (hμ₁ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S (ℓ ^ (k + 1))))
    (hμ₀ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S (ℓ ^ k))) :
    wcYkpMu S (ℓ ^ (k + 1)) hμ₁ ⟶ wcYkpMu S (ℓ ^ k) hμ₀ :=
  ObjectProperty.homMk
    { app := fun W => AddCommGrpCat.ofHom
