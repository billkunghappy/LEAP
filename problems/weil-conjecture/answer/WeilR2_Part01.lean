              (wcpaDjCocPull (p ≫ φ) L).V b ⊓ (wcpaDjCocPull (p ≫ φ) L).V c).trans
              (inf_le_inf_right ((wcpaDjCocPull (p ≫ φ) L).V c) inf_le_right))).op).hom
          ((wcpaDjCocPull (p ≫ φ) L).g b c :
            Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V b ⊓ (wcpaDjCocPull (p ≫ φ) L).V c))) ^ d *
