noncomputable abbrev wcInjAug {C : Type*} [Category C] [Limits.HasZeroObject C]
    [Limits.HasZeroMorphisms C] {Z : C} (I : InjectiveResolution Z) : Z ⟶ I.cocomplex.X 0 :=
  (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 Z).inv ≫ I.ι.f 0

def wcSubCoherent (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F')) : Prop :=
  (∀ (F : Finset R) (V O : (wcSubX R F).Etale) (c : O ⟶ V)
      (hc : c.left ≫ V.hom = O.hom ≫ wcSubT R (Finset.Subset.refl F))
      (x : (G F).obj.obj (Opposite.op V)),
      (e F F (Finset.Subset.refl F)).ρ V O c.left hc x = ((G F).obj.map c.op).hom x) ∧
  (∀ (F F' F'' : Finset R) (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcEtTransportFactor
        (show wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) by
          show Spec.map _ ≫ Spec.map _ = Spec.map _
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
              (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
              Subring.inclusion (Subring.closure_mono
                (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
            apply RingHom.ext
            intro x
            apply Subtype.ext
            simp
          rw [e2])
        (e F F' h₁) (e F' F'' h₂) (e F F'' (Finset.Subset.trans h₁ h₂)))

def wcSubCocone (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H) : Prop :=
  ∀ (F F' : Finset R) (h : F ⊆ F'),
    wcEtTransportFactor
      (show wcSubP R F' ≫ wcSubT R h = wcSubP R F by
        show Spec.map _ ≫ Spec.map _ = Spec.map _
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
        have e1 : (Subring.closure (F' : Set R)).subtype.comp
            (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
            (Subring.closure (F : Set R)).subtype := by
          apply RingHom.ext
          intro x
          simp
        rw [e1])
      (e F F' h) (σ F') (σ F)

def wcSubLocGen (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H) : Prop :=
  ∀ (U : (Spec (.of R)).Etale) (s : H.obj.obj (Opposite.op U)) (u : U.left),
    ∃ (U' : (Spec (.of R)).Etale) (c : U' ⟶ U) (u' : U'.left) (F : Finset R)
      (V : (wcSubX R F).Etale) (k : U'.left ⟶ V.left) (hk : k ≫ V.hom = U'.hom ≫ wcSubP R F)
      (t : (G F).obj.obj (Opposite.op V)),
      c.left u' = u ∧ (σ F).ρ V U' k hk t = (H.obj.map c.op).hom s

def wcSubLocKer (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H) : Prop :=
  ∀ (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale) (k : U.left ⟶ V.left)
    (hk : k ≫ V.hom = U.hom ≫ wcSubP R F) (t : (G F).obj.obj (Opposite.op V)),
    (σ F).ρ V U k hk t = 0 → ∀ u : U.left,
    ∃ (U' : (Spec (.of R)).Etale) (c : U' ⟶ U) (u' : U'.left) (F' : Finset R) (h : F ⊆ F')
      (O : (wcSubX R F').Etale) (k' : U'.left ⟶ O.left) (hk' : k' ≫ O.hom = U'.hom ≫ wcSubP R F')
      (k'' : O.left ⟶ V.left) (hk'' : k'' ≫ V.hom = O.hom ≫ wcSubT R h),
      c.left u' = u ∧ k' ≫ k'' = c.left ≫ k ∧ (e F F' h).ρ V O k'' hk'' t = 0

def wcSubAffSec (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H) : Prop :=
  ∀ (F₀ : Finset R) (V₀ : (wcSubX R F₀).Etale) (U : (Spec (.of R)).Etale) (k₀ : U.left ⟶ V₀.left),
    IsAffine V₀.left → IsPullback k₀ U.hom V₀.hom (wcSubP R F₀) →
    (∀ s : H.obj.obj (Opposite.op U), ∃ (F : Finset R) (h : F₀ ⊆ F) (O : (wcSubX R F).Etale)
        (kO : U.left ⟶ O.left) (hkO : kO ≫ O.hom = U.hom ≫ wcSubP R F) (k₁ : O.left ⟶ V₀.left)
        (t : (G F).obj.obj (Opposite.op O)),
        kO ≫ k₁ = k₀ ∧ IsPullback k₁ O.hom V₀.hom (wcSubT R h) ∧ (σ F).ρ O U kO hkO t = s) ∧
    (∀ (F : Finset R) (h : F₀ ⊆ F) (O : (wcSubX R F).Etale) (kO : U.left ⟶ O.left)
        (hkO : kO ≫ O.hom = U.hom ≫ wcSubP R F) (k₁ : O.left ⟶ V₀.left),
        kO ≫ k₁ = k₀ → IsPullback k₁ O.hom V₀.hom (wcSubT R h) →
        ∀ t : (G F).obj.obj (Opposite.op O), (σ F).ρ O U kO hkO t = 0 →
        ∃ (F' : Finset R) (h' : F ⊆ F') (O' : (wcSubX R F').Etale) (kO' : U.left ⟶ O'.left)
          (k₂ : O'.left ⟶ O.left) (hk₂ : k₂ ≫ O.hom = O'.hom ≫ wcSubT R h'),
          kO' ≫ O'.hom = U.hom ≫ wcSubP R F' ∧ kO' ≫ k₂ = kO ∧
          IsPullback k₂ O'.hom O.hom (wcSubT R h') ∧ (e F F' h').ρ O O' k₂ hk₂ t = 0)
noncomputable abbrev wcR2gsH (Y : Scheme.{u}) (m i : ℕ) :=
  @Abelian.Ext (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) _ _ (HasExt.standard _)
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) i

noncomputable def wcR2gsConstRes {Y : Scheme.{u}} (T : Y.Etale)
    [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)]
    (A : AddCommGrpCat.{u+1}) :
    (constantSheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).obj A ⟶
      ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A) :=
  ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology T.left)
    (Functor.whiskerLeft (wcEtSlice T).op
      (toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj A)) :
        (Functor.const (T.left.Etale)ᵒᵖ).obj A ⟶ _)
    (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A)).property)

noncomputable def wcR2gsRes {Y : Scheme.{u}} (T : Y.Etale) (m q : ℕ) :
    wcR2gsH Y m q →+ wcR2gsH T.left m q := by
  classical
  exact if hP : ∃ _ : (wcEtSlice T).IsContinuous
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y),
      ((wcEtSlice T).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).Additive ∧
      Limits.PreservesFiniteLimits
        ((wcEtSlice T).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)) ∧
      Limits.PreservesFiniteColimits
        ((wcEtSlice T).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)) ∧
      IsIso (wcR2gsConstRes T (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) then
    haveI := hP.fst
    haveI := hP.snd.1
    haveI := hP.snd.2.1
    haveI := hP.snd.2.2.1
    haveI := hP.snd.2.2.2
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ (wcR2gsConstRes T
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))).comp
        ((Abelian.Ext.mapExactFunctor
          ((wcEtSlice T).sheafPushforwardContinuous
            AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)) x).comp
          (Abelian.Ext.mk₀ (inv (wcR2gsConstRes T
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) (add_zero q)) (zero_add q))
      (fun a b => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add])
  else 0
noncomputable def wcEtCanConst {X Y : Scheme.{u}} (g : Y ⟶ X) (A : AddCommGrpCat.{u+1}) :
    (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A ⟶
      (wcEtPush g).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A) :=
  (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
    ((({ app := fun _ => 𝟙 A, naturality := fun _ _ _ => rfl } :
        (Functor.const (X.Etale)ᵒᵖ).obj A ⟶
          (wcEtBaseChange g).op ⋙ (Functor.const (Y.Etale)ᵒᵖ).obj A)) ≫
      Functor.whiskerLeft (wcEtBaseChange g).op
        (toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj A)))

noncomputable def wcEtBaseChangeFst {X Y : Scheme.{u}} (g : Y ⟶ X) :
    wcEtBaseChange g ⋙ Scheme.Etale.forget Y ⋙ Over.forget Y ⟶
      Scheme.Etale.forget X ⋙ Over.forget X where
  app V := Limits.pullback.fst V.hom g
  naturality V V' f := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]

noncomputable def wcEtCanGm {X Y : Scheme.{u}} (g : Y ⟶ X) :
    wcEtGm X ⟶ (wcEtPush g).obj (wcEtGm Y) :=
  (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
    (Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
        (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ≫
      Functor.whiskerLeft (wcEtBaseChange g).op
        (toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)))

noncomputable def wcExtTwist {C : Type*} [Category C] [Abelian C] [HasExt C] (F : C ⥤ C)
    [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
    {P Y : C} (cP : P ⟶ F.obj P) (cY : Y ⟶ F.obj Y) [IsIso cY] (n : ℕ) :
    Abelian.Ext P Y n → Abelian.Ext P Y n := fun h =>
  (Abelian.Ext.mk₀ cP).comp ((Abelian.Ext.mapExactFunctor F h).comp
    (Abelian.Ext.mk₀ (inv cY)) (add_zero n)) (zero_add n)
def wcCg2LocEtale {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (M : Submonoid R) : Prop :=
  (IsLocalization.map (Localization (M.map φ)) φ M.le_comap_map :
    Localization M →+* Localization (M.map φ)).Etale

def wcCg2FibrePts {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] (s : B →ₐ[A] A)
    (C : Type u) [CommRing C] [Algebra B C] : Prop :=
  letI : Algebra B (FractionRing A) := ((algebraMap A (FractionRing A)).comp s.toRingHom).toAlgebra
  ∃ (n : ℕ) (ρ : Fin n → (TensorProduct B (FractionRing A) C →ₐ[FractionRing A] FractionRing A)),
    Function.Injective ρ ∧
      Module.finrank (FractionRing A) (TensorProduct B (FractionRing A) C) ≤ n

def wcCg2SchemePts {E : Type u} [Field E] (Z : Scheme.{u}) (z : Z ⟶ Spec (.of E)) : Prop :=
  letI : Algebra E Γ(Z, ⊤) :=
    (z.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom).toAlgebra
  ∃ (n : ℕ) (ρ : Fin n → (Γ(Z, ⊤) →ₐ[E] E)), Function.Injective ρ ∧ Module.finrank E Γ(Z, ⊤) ≤ n
def wcCg2HP (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (a b : R) : Prop :=
  IsSMulRegular M a ∧ IsSMulRegular M b ∧ ∀ m n : M, b • m = a • n → ∃ k : M, m = a • k
def wcEtPcLocDies {Y S : Scheme.{u}} (h : Y ⟶ S) (ℓ n : ℕ) (α : wcEtZModExt Y ℓ n) : Prop :=
  ∀ x : S, ∃ (S' : Scheme.{u}) (s' : S' ⟶ S), Etale s' ∧ x ∈ Set.range s' ∧
    ∀ (Y' : Scheme.{u}) (h' : Y' ⟶ S') (w' : Y' ⟶ Y), IsPullback w' h' h s' →
      ∀ D : wcEtPullData w' ℓ, wcEtPull D n α = 0

def wcEtPcMVSurj {Y S : Scheme.{u}} (h : Y ⟶ S) (ℓ : ℕ) (A B : Y.Opens) (k : ℕ) : Prop :=
  ∀ (S1 : Scheme.{u}) (s1 : S1 ⟶ S), Etale s1 →
    ∀ (Y1 : Scheme.{u}) (h1 : Y1 ⟶ S1) (w1 : Y1 ⟶ Y), IsPullback w1 h1 h s1 →
    ∀ (γ : wcEtZModExt ((w1 ⁻¹ᵁ (A ⊓ B) : Y1.Opens) : Scheme.{u}) ℓ k) (x : S1),
    ∃ (S2 : Scheme.{u}) (s2 : S2 ⟶ S1), Etale s2 ∧ x ∈ Set.range s2 ∧
      ∀ (Y2 : Scheme.{u}) (h2 : Y2 ⟶ S2) (w2 : Y2 ⟶ Y1), IsPullback w2 h2 h1 s2 →
      ∃ (a : wcEtZModExt ((w2 ⁻¹ᵁ (w1 ⁻¹ᵁ A) : Y2.Opens) : Scheme.{u}) ℓ k)
        (b : wcEtZModExt ((w2 ⁻¹ᵁ (w1 ⁻¹ᵁ B) : Y2.Opens) : Scheme.{u}) ℓ k),
      ∀ (Dγ : wcEtPullData (w2 ∣_ (w1 ⁻¹ᵁ (A ⊓ B))) ℓ)
        (Da : wcEtPullData (Y2.homOfLE (show w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (A ⊓ B)) ≤ w2 ⁻¹ᵁ (w1 ⁻¹ᵁ A) from
          fun _ hy => hy.1)) ℓ)
        (Db : wcEtPullData (Y2.homOfLE (show w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (A ⊓ B)) ≤ w2 ⁻¹ᵁ (w1 ⁻¹ᵁ B) from
          fun _ hy => hy.2)) ℓ),
      wcEtPull Dγ k γ = wcEtPull Da k a + wcEtPull Db k b

def wcEtPunctCore (K : Type u) [Field K] (ℓ c : ℕ) : Prop :=
  ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 1 ≤ n → n + 2 ≤ 2 * c → ∀ α : wcEtZModExt (U : Scheme.{u}) ℓ n, wcEtPcLocDies (U.ι ≫ p) ℓ n α

noncomputable def wcEtPcCovA {K : Type u} [Field K] {c' : ℕ} {P : Scheme.{u}}
    (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (U : P.Opens) : (U : Scheme.{u}).Opens :=
  (U.ι ≫ q) ⁻¹ᵁ PrimeSpectrum.basicOpen (MvPolynomial.X 0)

noncomputable def wcEtPcCovB {K : Type u} [Field K] {c' : ℕ} {P : Scheme.{u}}
    (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (U : P.Opens) : (U : Scheme.{u}).Opens :=
  (U.ι ≫ q) ⁻¹ᵁ (⨆ i : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X i.succ))
noncomputable def wcPlpChartMap {A₀ : Type u} [CommRing A₀] {X : Scheme.{u}} (f : X ⟶ Spec (.of A₀))
    {U : X.Opens} (hU : IsAffineOpen U) : A₀ →+* Γ(X, U) :=
  (Spec.preimage (hU.fromSpec ≫ f)).hom


def wcPlpRegA {A : Type u} [CommRing A] (𝔭 : Ideal A) [𝔭.IsPrime] (a b : A) : Prop :=
  a ∈ 𝔭 ∧ b ∈ 𝔭 ∧
    (∀ y : Localization.AtPrime 𝔭, algebraMap A (Localization.AtPrime 𝔭) a * y = 0 → y = 0) ∧
    (∀ y z : Localization.AtPrime 𝔭,
      algebraMap A (Localization.AtPrime 𝔭) b * y = algebraMap A (Localization.AtPrime 𝔭) a * z →
        ∃ w, y = algebraMap A (Localization.AtPrime 𝔭) a * w)


def wcPlpRegC {A R C : Type u} [CommRing A] [CommRing R] [CommRing C] (ψ : A →+* R) (φ : R →+* C)
    (𝔮 : Ideal R) [𝔮.IsPrime] (a b : A) : Prop :=
  (∀ y : Localization (𝔮.primeCompl.map φ),
      algebraMap C (Localization (𝔮.primeCompl.map φ)) (φ (ψ a)) * y = 0 → y = 0) ∧
    (∀ y z : Localization (𝔮.primeCompl.map φ),
      algebraMap C (Localization (𝔮.primeCompl.map φ)) (φ (ψ b)) * y =
          algebraMap C (Localization (𝔮.primeCompl.map φ)) (φ (ψ a)) * z →
        ∃ w, y = algebraMap C (Localization (𝔮.primeCompl.map φ)) (φ (ψ a)) * w)


def wcPlpClosedPurity.{v} : Prop :=
  ∀ (A R C : Type v) [CommRing A] [CommRing R] [CommRing C] [IsNoetherianRing A]
    (ψ : A →+* R) (φ : R →+* C), ψ.Smooth → φ.Finite →
    ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (𝔮 : Ideal R) [𝔮.IsPrime], 𝔮.comap ψ = 𝔭 →
    (∀ Q : Ideal R, Q.IsPrime → 𝔮 ≤ Q → Q.comap ψ = 𝔭 → Q = 𝔮) →
    (∃ a b : A, wcPlpRegA 𝔭 a b ∧ wcPlpRegC ψ φ 𝔮 a b) →
    (∀ (Q : Ideal R) [Q.IsPrime], Q ≤ 𝔮 → Q.comap ψ ≠ 𝔭 → wcCg2LocEtale φ Q.primeCompl) →
    (∀ (Q : Ideal R) [Q.IsPrime], Q ≤ 𝔮 → Q.comap ψ = 𝔭 →
      (∀ Q' : Ideal R, Q'.IsPrime → Q' ≤ Q → Q'.comap ψ = 𝔭 → Q' = Q) →
      wcCg2LocEtale φ Q.primeCompl) →
    wcCg2LocEtale φ 𝔮.primeCompl


def wcPlpGeneralPurity.{v} : Prop :=
  ∀ (A R C : Type v) [CommRing A] [CommRing R] [CommRing C] [IsNoetherianRing A]
    (ψ : A →+* R) (φ : R →+* C), ψ.Smooth → φ.Finite →
    ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (𝔮 : Ideal R) [𝔮.IsPrime], 𝔮.comap ψ = 𝔭 →
    (∃ a b : A, wcPlpRegA 𝔭 a b ∧ wcPlpRegC ψ φ 𝔮 a b) →
    (∀ (Q : Ideal R) [Q.IsPrime], Q ≤ 𝔮 → Q ≠ 𝔮 → wcCg2LocEtale φ Q.primeCompl) →
    (∃ Q₀ : Ideal R, Q₀.IsPrime ∧ Q₀ ≤ 𝔮 ∧ Q₀ ≠ 𝔮 ∧ Q₀.comap ψ = 𝔭) →
    wcCg2LocEtale φ 𝔮.primeCompl
def wcEtDivPullProp (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (σ : X ⟶ X) (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) [IsIso ρ]
    (α : wcEtDivPre Ω X fX ⟶ (wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX) : Prop :=
  ∀ (V : X.Etale) (a : (wcEtDivPre Ω X fX).obj (Opposite.op V))
    (t : wcEtPts Ω X fX ((wcEtBaseChange σ).obj V)) (s : wcEtPts Ω X fX V),
    s.1 = inv ρ ≫ t.1 ≫ Limits.pullback.fst V.hom σ →
    (ULift.down (α.app (Opposite.op V) a)).1 t = (ULift.down a).1 s

noncomputable def wcEtCanDiv (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    (σ : X ⟶ X) (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) [IsIso ρ] :
    (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtDivPre Ω X fX) ⟶
      (wcEtPush σ).obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (wcEtDivPre Ω X fX)) := by
  classical
  exact if h : ∃ α, wcEtDivPullProp Ω X fX σ ρ α then
    (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (Classical.choose h ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
        (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX)))
  else 0
noncomputable def wcVRes (S : Scheme.{u}) (V : S.ProEt) (O : V.left.Opens) : S.ProEt :=
  MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom)
    (@MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ (etale_le_weaklyEtale _ _ _ inferInstance) V.prop)

noncomputable def wcVResLE (S : Scheme.{u}) (V : S.ProEt) {O O' : V.left.Opens} (h : O ≤ O') :
    wcVRes S V O ⟶ wcVRes S V O' :=
  MorphismProperty.Over.homMk (V.left.homOfLE h)
    (by
      show V.left.homOfLE h ≫ (O'.ι ≫ V.hom) = O.ι ≫ V.hom
      rw [← Category.assoc, Scheme.homOfLE_ι]) trivial

noncomputable def wcVResEndo (S : Scheme.{u}) (V : S.ProEt) (a : V ⟶ V) (O : V.left.Opens)
    (hO : O ≤ a.left ⁻¹ᵁ O) : wcVRes S V O ⟶ wcVRes S V O :=
  MorphismProperty.Over.homMk (a.left.resLE O O hO)
    (by
      show a.left.resLE O O hO ≫ (O.ι ≫ V.hom) = O.ι ≫ V.hom
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, MorphismProperty.Over.w a])
    trivial

noncomputable def wcTopSec (Y : Scheme.{u}) (O : Y.Opens) (hO : ⊤ ≤ O) : Y ⟶ O :=
  IsOpenImmersion.lift O.ι (𝟙 Y) (by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hO trivial)

noncomputable def wcVResSec (S : Scheme.{u}) (V : S.ProEt) (O : V.left.Opens) (hO : ⊤ ≤ O) :
    V ⟶ wcVRes S V O :=
  MorphismProperty.Over.homMk (wcTopSec V.left O hO)
    (by
      have hts : ∀ (Y : Scheme.{u}) (O : Y.Opens) (hO : ⊤ ≤ O), wcTopSec Y O hO ≫ O.ι = 𝟙 Y :=
        fun Y O hO => IsOpenImmersion.lift_fac _ _ _
      show wcTopSec V.left O hO ≫ (O.ι ≫ V.hom) = V.hom
      rw [← Category.assoc, hts, Category.id_comp]) trivial

noncomputable def wcKOpen (X : Scheme.{u}) {d : ℕ} (fV : Fin d → Γ(X, ⊤)) (a b : ℕ) : X.Opens where
  carrier := {x | (∀ i : Fin d, a ≤ i.val → x ∈ X.basicOpen (fV i)) ∧
    ∃ i : Fin d, i.val < b ∧ x ∈ X.basicOpen (fV i)}
  is_open' := by
    have e : {x | (∀ i : Fin d, a ≤ i.val → x ∈ X.basicOpen (fV i)) ∧
        ∃ i : Fin d, i.val < b ∧ x ∈ X.basicOpen (fV i)} =
        (⋂ i ∈ {i : Fin d | a ≤ i.val}, (X.basicOpen (fV i) : Set X)) ∩
        (⋃ i ∈ {i : Fin d | i.val < b}, (X.basicOpen (fV i) : Set X)) := by
      ext x
      simp
    rw [e]
    exact ((Set.toFinite _).isOpen_biInter fun i _ => (X.basicOpen (fV i)).isOpen).inter
      (isOpen_biUnion fun i _ => (X.basicOpen (fV i)).isOpen)

noncomputable def wcMVComplex (S : Scheme.{u}) (V : S.ProEt) {O₁₂ O₁ O₂ O : V.left.Opens}
    (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O) (h₄ : O₂ ≤ O) :
    ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
  ShortComplex.mk
    (Limits.biprod.lift (wcFreeSheafMap S (wcVResLE S V h₁)) (-wcFreeSheafMap S (wcVResLE S V h₂)))
    (Limits.biprod.desc (wcFreeSheafMap S (wcVResLE S V h₃)) (wcFreeSheafMap S (wcVResLE S V h₄)))
    (by
      have hfun : ∀ {A B C : S.ProEt} (a : A ⟶ B) (b : B ⟶ C),
          wcFreeSheafMap S a ≫ wcFreeSheafMap S b = wcFreeSheafMap S (a ≫ b) := by
        intro A B C a b
        have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
            Functor.whiskerRight (yoneda.map (a ≫ b))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
          rw [yoneda.map_comp, Functor.whiskerRight_comp]
        exact ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
          (congrArg (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map e)
      have hsq : wcVResLE S V h₁ ≫ wcVResLE S V h₃ = wcVResLE S V h₂ ≫ wcVResLE S V h₄ := by
        apply MorphismProperty.Over.Hom.ext
        show V.left.homOfLE h₁ ≫ V.left.homOfLE h₃ = V.left.homOfLE h₂ ≫ V.left.homOfLE h₄
        rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_homOfLE]
      rw [Limits.biprod.lift_desc, Preadditive.neg_comp, hfun, hfun, hsq, add_neg_cancel])

open Classical in
noncomputable def wcMVClass (S : Scheme.{u}) (V : S.ProEt) {O₁₂ O₁ O₂ O : V.left.Opens}
    (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O) (h₄ : O₂ ≤ O) :
    Abelian.Ext (wcFreeSheaf S (wcVRes S V O)) (wcFreeSheaf S (wcVRes S V O₁₂)) 1 :=
  if hS : (wcMVComplex S V h₁ h₂ h₃ h₄).ShortExact then hS.extClass else 0

noncomputable def wcKChain (S : Scheme.{u}) (V : S.ProEt) {d : ℕ} (fV : Fin d → Γ(V.left, ⊤))
    (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q : ℕ) :
    (t : ℕ) → (Abelian.Ext (wcFreeSheaf S (wcVRes S V (wcKOpen V.left fV 1 1))) M q →+
      Abelian.Ext (wcFreeSheaf S (wcVRes S V (wcKOpen V.left fV (t + 1) (t + 1)))) M (q + t))
  | 0 => AddMonoidHom.id _
  | t + 1 =>
    ((wcMVClass S V
        (O₁₂ := wcKOpen V.left fV (t + 1) (t + 1)) (O₁ := wcKOpen V.left fV (t + 1 + 1) (t + 1))
        (O₂ := wcKOpen V.left fV (t + 1) (t + 1 + 1)) (O := wcKOpen V.left fV (t + 1 + 1) (t + 1 + 1))
        (by rintro x ⟨h1, i, hi, h2⟩; exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩)
        (by rintro x ⟨h1, i, hi, h2⟩; exact ⟨h1, i, by omega, h2⟩)
        (by rintro x ⟨h1, i, hi, h2⟩; exact ⟨h1, i, by omega, h2⟩)
        (by rintro x ⟨h1, i, hi, h2⟩; exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩)).precomp M
        (by omega : 1 + (q + t) = q + (t + 1))).comp (wcKChain S V fV M q t)

noncomputable def wcKFinal (S : Scheme.{u}) (V : S.ProEt) {d : ℕ} (fV : Fin d → Γ(V.left, ⊤))
    (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (hT : ⊤ ≤ wcKOpen V.left fV (d - 1 + 1) (d - 1 + 1)) :
    Abelian.Ext (wcFreeSheaf S (wcVRes S V (wcKOpen V.left fV 1 1))) M d →+
      Abelian.Ext (wcFreeSheaf S V) M (2 * d - 1) :=
  ((Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResSec S V _ hT))).precomp M
    (by omega : 0 + (d + (d - 1)) = 2 * d - 1)).comp (wcKChain S V fV M d (d - 1))

noncomputable def wcParamFn {S : Scheme.{u}} {T VT : S.ProEt} (j : VT ⟶ T) {A : Type u} [CommRing A]
    (e : T.left ≅ Spec (.of A)) {d : ℕ} (f : Fin d → A) : Fin d → Γ(VT.left, ⊤) :=
  fun i => (j.left ≫ e.hom).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom (f i))
def wcEtPunctTopCore (K : Type u) [Field K] (ℓ c : ℕ) (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens) (N : ℕ) (ω : wcEtZModExt (U₀ : Scheme.{u}) ℓ N) : Prop :=
  ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u})), pr ≫ U₀.ι = U.ι ≫ q → ∀ (α : wcEtZModExt (U : Scheme.{u}) ℓ N) (x : S), ∃ (S' : Scheme.{u}) (s' : S' ⟶ S), Etale s' ∧ x ∈ Set.range s' ∧ ∃ k : ℕ, ∀ (Y' : Scheme.{u}) (h' : Y' ⟶ S') (w' : Y' ⟶ (U : Scheme.{u})), IsPullback w' h' (U.ι ≫ p) s' → ∀ (Dw' : wcEtPullData w' ℓ) (Dc : wcEtPullData (w' ≫ pr) ℓ), wcEtPull Dw' N α = k • wcEtPull Dc N ω

noncomputable def wcEtPtCovA0 {K : Type u} [Field K] {c' : ℕ}
    (U₀ : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens) : (U₀ : Scheme.{u}).Opens :=
  U₀.ι ⁻¹ᵁ PrimeSpectrum.basicOpen (MvPolynomial.X 0)

noncomputable def wcEtPtCovB0 {K : Type u} [Field K] {c' : ℕ}
    (U₀ : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens) : (U₀ : Scheme.{u}).Opens :=
  U₀.ι ⁻¹ᵁ (⨆ i : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X i.succ))

def wcEtMVGenTop {Y S Y₀ : Scheme.{u}} (h : Y ⟶ S) (pr : Y ⟶ Y₀) (ℓ : ℕ) (A₀ B₀ : Y₀.Opens) (n : ℕ)
    (ε₀ : wcEtZModExt ((A₀ ⊓ B₀ : Y₀.Opens) : Scheme.{u}) ℓ n) : Prop :=
  ∀ (S1 : Scheme.{u}) (s1 : S1 ⟶ S), Etale s1 →
    ∀ (Y1 : Scheme.{u}) (h1 : Y1 ⟶ S1) (w1 : Y1 ⟶ Y), IsPullback w1 h1 h s1 →
    ∀ (γ : wcEtZModExt (((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀) : Y1.Opens) : Scheme.{u}) ℓ n) (x : S1),
    ∃ (S2 : Scheme.{u}) (s2 : S2 ⟶ S1), Etale s2 ∧ x ∈ Set.range s2 ∧ ∃ k : ℕ,
      ∀ (Y2 : Scheme.{u}) (h2 : Y2 ⟶ S2) (w2 : Y2 ⟶ Y1), IsPullback w2 h2 h1 s2 →
      ∃ (a : wcEtZModExt ((w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ A₀) : Y2.Opens) : Scheme.{u}) ℓ n)
        (b : wcEtZModExt ((w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ B₀) : Y2.Opens) : Scheme.{u}) ℓ n),
      ∀ (Dγ : wcEtPullData (w2 ∣_ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀))) ℓ)
        (Da : wcEtPullData (Y2.homOfLE (show w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) ≤
          w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ A₀) from fun _ hy => hy.1)) ℓ)
        (Db : wcEtPullData (Y2.homOfLE (show w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) ≤
          w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ B₀) from fun _ hy => hy.2)) ℓ)
        (Dε : wcEtPullData (w2 ∣_ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) ≫ (w1 ≫ pr) ∣_ (A₀ ⊓ B₀)) ℓ),
      wcEtPull Dγ n γ = wcEtPull Da n a + wcEtPull Db n b + k • wcEtPull Dε n ε₀
noncomputable abbrev wcR2gsZ (Y : Scheme.{u}) : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
  (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))

def wcR2gsNUT {S Z : Scheme.{u}} (g : Z ⟶ S)
    (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    (ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1},
      wcEtTransport g G (L.obj G)) : Prop :=
  (∀ G, wcEtTransportUniv (ρ G)) ∧
    ∀ (G G' : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
      (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (x : G.obj.obj (Opposite.op V)),
      (ρ G').ρ V O h hh ((ψ.hom.app (Opposite.op V)).hom x) =
        ((L.map ψ).hom.app (Opposite.op O)).hom ((ρ G).ρ V O h hh x)

structure wcR2gsAdjData {S Z : Scheme.{u}} (g : Z ⟶ S) (m : ℕ) where
  L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤
    Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}
  adj : Nonempty (L ⊣ wcEtPush g)
  additive : L.Additive
  presLim : Limits.PreservesFiniteLimits L
  presColim : Limits.PreservesFiniteColimits L
  ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}, wcEtTransport g G (L.obj G)
  nut : wcR2gsNUT g L ρ
  ε : wcR2gsZ Z ⟶ L.obj (wcR2gsZ S)
  epsNorm : ∀ hg : g ≫ (wcEtTop S).hom = (wcEtTop Z).hom ≫ g,
    (ε.hom.app (Opposite.op (wcEtTop Z))).hom
        (wcConstSec Z (ULift.{u+1} ℤ) (wcEtTop Z) (ULift.up 1)) =
      (ρ (wcR2gsZ S)).ρ (wcEtTop S) (wcEtTop Z) g hg
        (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1))
  κ : L.obj (wcConstZ S m) ≅ wcConstZ Z m
  kapNorm : ∀ hg : g ≫ (wcEtTop S).hom = (wcEtTop Z).hom ≫ g,
    (κ.hom.hom.app (Opposite.op (wcEtTop Z))).hom
        ((ρ (wcConstZ S m)).ρ (wcEtTop S) (wcEtTop Z) g hg
          (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) (ULift.up 1))) =
      wcConstSec Z (ULift.{u+1} (ZMod m)) (wcEtTop Z) (ULift.up 1)

instance wcR2gsAdjData.instAdditive {S Z : Scheme.{u}} {g : Z ⟶ S} {m : ℕ}
    (A : wcR2gsAdjData g m) : A.L.Additive := A.additive

instance wcR2gsAdjData.instPresLim {S Z : Scheme.{u}} {g : Z ⟶ S} {m : ℕ}
    (A : wcR2gsAdjData g m) : Limits.PreservesFiniteLimits A.L := A.presLim

instance wcR2gsAdjData.instPresColim {S Z : Scheme.{u}} {g : Z ⟶ S} {m : ℕ}
    (A : wcR2gsAdjData g m) : Limits.PreservesFiniteColimits A.L := A.presColim

def wcR2gsGerm {X Z : Scheme.{u}} (f : Z ⟶ X)
    (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    (ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
      wcEtTransport f G (L.obj G))
    (U : X.Etale) (σ : Z ⟶ U.left) (γ : wcR2gsZ Z ⟶ L.obj (wcFtcFS X U)) : Prop :=
  ∀ hσ : σ ≫ U.hom = (wcEtTop Z).hom ≫ f,
    (γ.hom.app (Opposite.op (wcEtTop Z))).hom
        (wcConstSec Z (ULift.{u+1} ℤ) (wcEtTop Z) (ULift.up 1)) =
      (ρ (wcFtcFS X U)).ρ U (wcEtTop Z) σ hσ (wcFtcGen X U)

noncomputable def wcR2gsAPull {Y Z : Scheme.{u}} {σ : Z ⟶ Y} {m : ℕ} (A : wcR2gsAdjData σ m)
    (q : ℕ) (y : wcR2gsH Y m q) : wcR2gsH Z m q :=
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  (Abelian.Ext.mk₀ A.ε).comp
    ((Abelian.Ext.mapExactFunctor A.L y).comp (Abelian.Ext.mk₀ A.κ.hom) (add_zero q)) (zero_add q)

noncomputable def wcR2gsLoc0 {X Z : Scheme.{u}} {f : Z ⟶ X} {m : ℕ} (A : wcR2gsAdjData f m)
    (U : X.Etale) (γ : wcR2gsZ Z ⟶ A.L.obj (wcFtcFS X U))
    (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (q : ℕ) :
    @Abelian.Ext (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) _ _ (HasExt.standard _)
      (wcFtcFS X U) F q →
    @Abelian.Ext (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) _ _ (HasExt.standard _)
      (wcR2gsZ Z) (A.L.obj F) q :=
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  fun e => (Abelian.Ext.mk₀ γ).comp (Abelian.Ext.mapExactFunctor A.L e) (zero_add q)

noncomputable def wcR2gsLocHom {X Z : Scheme.{u}} {f : Z ⟶ X} {m : ℕ} (A : wcR2gsAdjData f m)
    (U : X.Etale) (γ : wcR2gsZ Z ⟶ A.L.obj (wcFtcFS X U)) (q : ℕ) :
    @Abelian.Ext (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) _ _ (HasExt.standard _)
      (wcFtcFS X U) (wcConstZ X m) q →+ wcR2gsH Z m q :=
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  AddMonoidHom.mk' (fun e => ((Abelian.Ext.mk₀ γ).comp (Abelian.Ext.mapExactFunctor A.L e)
      (zero_add q)).comp (Abelian.Ext.mk₀ A.κ.hom) (add_zero q))
    (fun a b => by
      rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add, Abelian.Ext.add_comp])
def wcCsdInvPull {X T : Scheme.{u}} (I : X.IdealSheafData) (h : T ⟶ X) : Prop :=
  ∀ t : T, ∃ (U : X.affineOpens) (V : T.affineOpens) (hVU : V.1 ≤ h ⁻¹ᵁ U.1) (a : Γ(X, U.1)),
    t ∈ V.1 ∧ a ∈ I.ideal U ∧ (h.appLE U.1 V.1 hVU).hom a ∈ nonZeroDivisors Γ(T, V.1) ∧
    Ideal.map (h.appLE U.1 V.1 hVU).hom (I.ideal U) = Ideal.span {(h.appLE U.1 V.1 hVU).hom a}


def wcCsdIsBlowup {X X' : Scheme.{u}} (I : X.IdealSheafData) (r : X' ⟶ X) : Prop :=
  wcCsdInvPull I r ∧ ∀ (T : Scheme.{u}) (h : T ⟶ X), wcCsdInvPull I h → ∃! h' : T ⟶ X', h' ≫ r = h


inductive wcCsdAdmTower (B : Scheme.{u}) (U : B.Opens) : (X : Scheme.{u}) → (X ⟶ B) → Prop
  | base : wcCsdAdmTower B U B (𝟙 B)
  | step {X X' : Scheme.{u}} (q : X ⟶ B) (I : X.IdealSheafData) (r : X' ⟶ X) :
      wcCsdAdmTower B U X q → (I.support : Set X) ∩ ((q ⁻¹ᵁ U : X.Opens) : Set X) = ∅ →
      wcCsdIsBlowup I r → wcCsdAdmTower B U X' (r ≫ q)
noncomputable abbrev wcZSh (Y : Scheme.{u}) : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
  (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))

instance wcEtSheafFinBiprod (Y : Scheme.{u}) :
    Limits.HasFiniteBiproducts (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
  Limits.HasFiniteBiproducts.of_hasFiniteProducts


def wcHalAcyc {Y X : Scheme.{u}}
    (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (e : L.obj (wcZSh Y) ≅ wcZSh X) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ) : Prop :=
  (∀ ψ : wcZSh X ⟶ L.obj F, ∃! φ : wcZSh Y ⟶ F, e.inv ≫ L.map φ = ψ) ∧
  ∀ p : ℕ, 1 ≤ p → p ≤ n → Subsingleton (wcEtExt X (L.obj F) p)
def wcGermRing (X : Scheme.{u}) : Type u := ∀ x : X, X.presheaf.stalk x

noncomputable instance wcGermRing.instCommRing (X : Scheme.{u}) : CommRing (wcGermRing X) :=
  inferInstanceAs (CommRing (∀ x : X, X.presheaf.stalk x))

noncomputable instance wcGermRing.instAlgebra (X : Scheme.{u}) : Algebra Γ(X, ⊤) (wcGermRing X) :=
  RingHom.toAlgebra (show Γ(X, ⊤) →+* wcGermRing X from
    RingHom.pi fun x => (X.presheaf.germ ⊤ x trivial).hom)
noncomputable def wcTwrInclM (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) :
    ℤ_[ℓ] →+ ((k : ℕ) → ZMod (ℓ ^ (m + k))) :=
  AddMonoidHom.pi (fun k => (PadicInt.toZModPow (p := ℓ) (m + k)).toAddMonoidHom)

noncomputable def wcTwrCastM (ℓ m k : ℕ) : ZMod (ℓ ^ (m + k + 1)) →+ ZMod (ℓ ^ (m + k)) :=
  (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + k))) (ZMod (ℓ ^ (m + k)))).toAddMonoidHom

noncomputable def wcTwrShiftM (ℓ m : ℕ) :
    ((k : ℕ) → ZMod (ℓ ^ (m + k))) →+ ((k : ℕ) → ZMod (ℓ ^ (m + k))) :=
  AddMonoidHom.pi (fun k => Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ (m + k))) k -
    (wcTwrCastM ℓ m k).comp (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ (m + k))) (k + 1)))
noncomputable def wcUnitTupleFun (ℓ d : ℕ) : CommRingCat.{u} ⥤ Type u where
  obj R := {t : Fin d → Rˣ // IsUnit ((ℓ : ℕ) : R)}
  map {R S} φ := TypeCat.ofHom (fun (t : {t : Fin d → Rˣ // IsUnit ((ℓ : ℕ) : R)}) =>
    (⟨fun i => Units.map φ.hom.toMonoidHom (t.1 i), by simpa using t.2.map φ.hom⟩ :
      {t : Fin d → Sˣ // IsUnit ((ℓ : ℕ) : S)}))
  map_id R := rfl
  map_comp φ ψ := rfl

noncomputable def wcUnitTuplePre (S : Scheme.{u}) (ℓ d : ℕ) : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d) ⋙
    (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

noncomputable def wcUnitTuple (S : Scheme.{u}) (ℓ d : ℕ) :
    Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
  (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj (wcUnitTuplePre S ℓ d)

noncomputable def wcUnitTupleMap (S : Scheme.{u}) (V : S.ProEt) (ℓ d : ℕ)
    (t : Fin d → (Γ(V.left, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(V.left, ⊤))) :
    wcFreeSheaf S V ⟶ wcUnitTuple S ℓ d :=
  (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
    (Functor.whiskerRight
      ((yonedaEquiv (X := V)
        (F := (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)).symm
        (Subtype.mk t hℓ : {t : Fin d → (Γ(V.left, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(V.left, ⊤))}))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
def wcCokSub (X : Scheme.{u}) (K Q : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    (π : K ⟶ Q)
    (eK : ∀ V : X.Opens, K.obj.obj (Opposite.op V) ≃+ Additive (∀ x : V, (X.presheaf.stalk (x : X))ˣ))
    (q : Q.obj.obj (Opposite.op ⊤)) : Submodule Γ(X, ⊤) (wcGermRing X) where
  carrier := {a | ∀ (W : X.Opens) (t : K.obj.obj (Opposite.op W)),
      π.hom.app (Opposite.op W) t = Q.obj.map (homOfLE (le_top : W ≤ ⊤)).op q →
      ∀ x : X, x ∈ W → ∃ (W' : X.Opens) (h : W' ≤ W), x ∈ W' ∧ ∃ c : Γ(X, W'),
        ∀ (y : X) (hy : y ∈ W'), a y =
          ((Additive.toMul (eK W t) ⟨y, h hy⟩ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y) *
            (X.presheaf.germ W' y hy).hom c}
  zero_mem' := by
    intro W t _ x hx
    refine ⟨W, le_rfl, hx, 0, fun y hy => ?_⟩
    rw [map_zero, mul_zero]
    rfl
  add_mem' := by
    intro a b ha hb W t ht x hx
    obtain ⟨W₁, h₁, hx₁, c₁, hc₁⟩ := ha W t ht x hx
    obtain ⟨W₂, h₂, hx₂, c₂, hc₂⟩ := hb W t ht x hx
    refine ⟨W₁ ⊓ W₂, inf_le_left.trans h₁, ⟨hx₁, hx₂⟩,
      (X.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom c₁ +
        (X.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom c₂, fun y hy => ?_⟩
    have e1 := TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)) y hy c₁
    have e2 := TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)) y hy c₂
    change a y + b y = _
    rw [map_add, mul_add, hc₁ y hy.1, hc₂ y hy.2]
    erw [e1, e2]
  smul_mem' := by
    intro r a ha W t ht x hx
    obtain ⟨W₁, h₁, hx₁, c₁, hc₁⟩ := ha W t ht x hx
    refine ⟨W₁, h₁, hx₁,
      (X.presheaf.map (homOfLE (le_top : W₁ ≤ ⊤)).op).hom r * c₁, fun y hy => ?_⟩
    have e1 := TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : W₁ ≤ ⊤)) y hy r
    change (X.presheaf.germ ⊤ y trivial).hom r * a y = _
    rw [map_mul, hc₁ y hy]
    erw [e1]
    ring
def wcGmLHRank : ℕ → ℕ
  | 0 => 1
  | 1 => 1
  | _ + 2 => 0

def wcGmLHGen {D : Type*} [Category D] {P : D} {Kx : ℕ → D} (g0 : P ⟶ Kx 0) (g1 : P ⟶ Kx 1) :
    (n : ℕ) → Fin (wcGmLHRank n) → (P ⟶ Kx n)
  | 0, _ => g0
  | 1, _ => g1
  | _ + 2, i => i.elim0
abbrev wcCsdChartAt {X T : Scheme.{u}} (I : X.IdealSheafData) (h : T ⟶ X) (U : X.affineOpens)
    (a : Γ(X, U.1)) (t : T) : Prop :=
  ∃ (V : T.affineOpens) (e : V.1 ≤ h ⁻¹ᵁ U.1), t ∈ V.1 ∧
    (h.appLE U.1 V.1 e).hom a ∈ nonZeroDivisors Γ(T, V.1) ∧
    Ideal.map (h.appLE U.1 V.1 e).hom (I.ideal U) = Ideal.span {(h.appLE U.1 V.1 e).hom a}
noncomputable def wcwlDelta (A : Type u) [CommRing A] (c : A) :
    ∀ x : PrimeSpectrum A, Localization.AtPrime x.asIdeal :=
  fun x => Ring.inverse (algebraMap A (Localization.AtPrime x.asIdeal) c)
noncomputable def wcwlRing (A : Type u) [CommRing A] :
    Subalgebra A (∀ x : PrimeSpectrum A, Localization.AtPrime x.asIdeal) :=
  Algebra.adjoin A (Set.range (wcwlDelta A))
noncomputable def wcwlEv (A : Type u) [CommRing A] (x : PrimeSpectrum A) :
    wcwlRing A →+* Localization.AtPrime x.asIdeal :=
  (Pi.evalRingHom (fun y : PrimeSpectrum A => Localization.AtPrime y.asIdeal) x).comp
    (wcwlRing A).val.toRingHom
noncomputable def wcwlZ (A : Type u) [CommRing A] (x : PrimeSpectrum A) : Ideal (wcwlRing A) :=
  Ideal.comap (wcwlEv A x) (IsLocalRing.maximalIdeal (Localization.AtPrime x.asIdeal))
noncomputable def wcwlI (A : Type u) [CommRing A] : Ideal (wcwlRing A) :=
  ⨅ x : PrimeSpectrum A, wcwlZ A x
noncomputable def wcEtInv {Z Y : Scheme.{u}} (g : Z ⟶ Y) :
    Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} :=
  sheafToPresheaf _ _ ⋙ (wcEtBaseChange g).op.lan ⋙ presheafToSheaf _ _

noncomputable def wcEtInvLift {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale)
    (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) : O ⟶ (wcEtBaseChange g).obj V :=
  MorphismProperty.Over.homMk (Limits.pullback.lift h O.hom hh) (Limits.pullback.lift_snd _ _ _)
    trivial

noncomputable def wcEtInvRho {Z Y : Scheme.{u}} (g : Z ⟶ Y)
    (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (O : Z.Etale)
    (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) :
    A.obj.obj (Opposite.op V) →+ ((wcEtInv g).obj A).obj.obj (Opposite.op O) :=
  ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
      (Opposite.op O)).hom.comp
    ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V O h hh).op).hom.comp
      (((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom)

def wcEtInvCompat {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
    (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (φ : (wcEtInv t).obj ((wcEtInv g).obj A) ⟶ (wcEtInv e).obj A) : Prop :=
  ∀ (V : Y.Etale) (O₁ : Z.Etale) (h₁ : O₁.left ⟶ V.left) (hh₁ : h₁ ≫ V.hom = O₁.hom ≫ g)
    (O₂ : Z'.Etale) (h₂ : O₂.left ⟶ O₁.left) (hh₂ : h₂ ≫ O₁.hom = O₂.hom ≫ t)
    (x : A.obj.obj (Opposite.op V)),
    (φ.hom.app (Opposite.op O₂)).hom
      (wcEtInvRho t ((wcEtInv g).obj A) O₁ O₂ h₂ hh₂ (wcEtInvRho g A V O₁ h₁ hh₁ x)) =
    wcEtInvRho e A V O₂ (h₂ ≫ h₁)
      (by rw [Category.assoc, hh₁, ← Category.assoc, hh₂, Category.assoc, he]) x

open Classical in
noncomputable def wcEtInvComp {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y)
    (he : t ≫ g = e) (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :
    (wcEtInv t).obj ((wcEtInv g).obj A) ⟶ (wcEtInv e).obj A :=
  if h : ∃ φ, wcEtInvCompat t g e he A φ then Classical.choose h else 0

def wcEtInvCompatInv {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y)
    (he : t ≫ g = e) (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (ψ : (wcEtInv e).obj A ⟶ (wcEtInv t).obj ((wcEtInv g).obj A)) : Prop :=
  ∀ (V : Y.Etale) (O₁ : Z.Etale) (h₁ : O₁.left ⟶ V.left) (hh₁ : h₁ ≫ V.hom = O₁.hom ≫ g)
    (O₂ : Z'.Etale) (h₂ : O₂.left ⟶ O₁.left) (hh₂ : h₂ ≫ O₁.hom = O₂.hom ≫ t)
    (x : A.obj.obj (Opposite.op V)),
    (ψ.hom.app (Opposite.op O₂)).hom (wcEtInvRho e A V O₂ (h₂ ≫ h₁)
      (by rw [Category.assoc, hh₁, ← Category.assoc, hh₂, Category.assoc, he]) x) =
    wcEtInvRho t ((wcEtInv g).obj A) O₁ O₂ h₂ hh₂ (wcEtInvRho g A V O₁ h₁ hh₁ x)

open Classical in
noncomputable def wcEtInvCompInv {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y)
    (he : t ≫ g = e) (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :
    (wcEtInv e).obj A ⟶ (wcEtInv t).obj ((wcEtInv g).obj A) :=
  if h : ∃ ψ, wcEtInvCompatInv t g e he A ψ then Classical.choose h else 0

noncomputable abbrev wcEtUnitSheaf (Y : Scheme.{u}) :
