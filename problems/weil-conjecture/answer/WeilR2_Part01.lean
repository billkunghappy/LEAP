          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) : Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) RingCat.{u+1} :=
  (wcZModRingSheaf X.left n).over (wcGeomPoint F X h)

noncomputable abbrev wcZModSliceCoh (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n i : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcZModSliceRing F X h n)) _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcZModSliceRing F X h n)) (SheafOfModules.unit (wcZModSliceRing F X h n)) i

noncomputable def wcZModSliceCup (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n i j k : ℕ) (hk : i + j = k) :
    wcZModSliceCoh F X h n i →+ wcZModSliceCoh F X h n j →+ wcZModSliceCoh F X h n k :=
  @Abelian.Ext.bilinearComp _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcZModSliceRing F X h n)) (SheafOfModules.unit (wcZModSliceRing F X h n))
    (SheafOfModules.unit (wcZModSliceRing F X h n)) i j k hk

noncomputable abbrev wcZModProEtExt (Y : Scheme.{u}) (n i : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcZModRingSheaf Y n)) _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcZModRingSheaf Y n)) (SheafOfModules.unit (wcZModRingSheaf Y n)) i

noncomputable def wcZModProEtCup (Y : Scheme.{u}) (n i j k : ℕ) (hk : i + j = k) :
    wcZModProEtExt Y n i →+ wcZModProEtExt Y n j →+ wcZModProEtExt Y n k :=
  @Abelian.Ext.bilinearComp _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcZModRingSheaf Y n)) (SheafOfModules.unit (wcZModRingSheaf Y n))
    (SheafOfModules.unit (wcZModRingSheaf Y n)) i j k hk

noncomputable abbrev wcEtZModRing (Y : Scheme.{u}) (n : ℕ) :
    Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1} :=
  (constantSheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).obj (RingCat.of (ULift.{u+1} (ZMod n)))

noncomputable abbrev wcEtZModExt (Y : Scheme.{u}) (n i : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y n)) _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcEtZModRing Y n)) (SheafOfModules.unit (wcEtZModRing Y n)) i

noncomputable def wcEtZModCup (Y : Scheme.{u}) (n i j k : ℕ) (hk : i + j = k) :
    wcEtZModExt Y n i →+ wcEtZModExt Y n j →+ wcEtZModExt Y n k :=
  @Abelian.Ext.bilinearComp _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcEtZModRing Y n)) (SheafOfModules.unit (wcEtZModRing Y n))
    (SheafOfModules.unit (wcEtZModRing Y n)) i j k hk
noncomputable def wcFSysSubring {Y W : Scheme.{u}} (π : W ⟶ Y)
    (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)) (h𝒜 : wcFSys π ⊤ 𝒜) (U : Y.AffineZariskiSite) :
    Subring Γ(W, π ⁻¹ᵁ U.1) where
  carrier := 𝒜 U.1
  zero_mem' := by
    have h := (h𝒜.1 U.1 U.2 le_top).1 0
    rwa [map_zero] at h
  one_mem' := by
    have h := (h𝒜.1 U.1 U.2 le_top).1 1
    rwa [map_one] at h
  add_mem' ha hb := ((h𝒜.1 U.1 U.2 le_top).2.1 _ ha _ hb).1
  mul_mem' ha hb := ((h𝒜.1 U.1 U.2 le_top).2.1 _ ha _ hb).2
  neg_mem' {a} ha := by
    have h := ((h𝒜.1 U.1 U.2 le_top).2.1 _ ((h𝒜.1 U.1 U.2 le_top).1 (-1)) _ ha).2
    rwa [map_neg, map_one, neg_one_mul] at h

noncomputable def wcFSysDiagram {Y W : Scheme.{u}} (π : W ⟶ Y)
    (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)) (h𝒜 : wcFSys π ⊤ 𝒜) :
    Y.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} where
  obj U := CommRingCat.of (wcFSysSubring π 𝒜 h𝒜 U.unop)
  map {U U'} i := CommRingCat.ofHom ((W.presheaf.map (homOfLE (π.preimage_mono
      (Scheme.AffineZariskiSite.toOpens_mono i.unop.le))).op).hom.restrict _ _ (by
    intro a ha
    obtain ⟨f, hf⟩ : ∃ f : Γ(Y, U.unop.1), Y.basicOpen f = U'.unop.1 := i.unop.le
    have key : ∀ (V₁ : Y.Opens) (_ : Y.basicOpen f = V₁) (hle : π ⁻¹ᵁ V₁ ≤ π ⁻¹ᵁ U.unop.1),
        (W.presheaf.map (homOfLE hle).op).hom a ∈ 𝒜 V₁ := by
      rintro V₁ rfl hle
      exact (h𝒜.2 U.unop.1 U.unop.2 le_top f).1 a ha
    exact key U'.unop.1 hf _))
  map_id U := by
    ext x
    change (W.presheaf.map (𝟙 (Opposite.op (π ⁻¹ᵁ U.unop.1)))).hom x.1 = x.1
    rw [W.presheaf.map_id]
    rfl
  map_comp {U U' U''} i i' := by
    ext x
    change (W.presheaf.map
      ((homOfLE (π.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono i.unop.le))).op ≫
      (homOfLE (π.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono i'.unop.le))).op)).hom x.1 =
      (W.presheaf.map
        (homOfLE (π.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono i'.unop.le))).op).hom
      ((W.presheaf.map
        (homOfLE (π.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono i.unop.le))).op).hom x.1)
    rw [W.presheaf.map_comp]
    rfl

noncomputable def wcFSysDiagramMap {Y W : Scheme.{u}} (π : W ⟶ Y)
    (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)) (h𝒜 : wcFSys π ⊤ 𝒜) :
    (Scheme.AffineZariskiSite.toOpensFunctor Y).op ⋙ Y.presheaf ⟶ wcFSysDiagram π 𝒜 h𝒜 where
  app U := CommRingCat.ofHom ((π.app U.unop.1).hom.codRestrict (wcFSysSubring π 𝒜 h𝒜 U.unop)
    (fun c => (h𝒜.1 U.unop.1 U.unop.2 le_top).1 c))
  naturality {U U'} i := by
    ext x
    exact Subtype.ext congr($(π.naturality ((Scheme.AffineZariskiSite.toOpensFunctor Y).op.map i)) x)
noncomputable def wcRootsFun (m : ℕ) : CommRingCat.{u} ⥤ AddCommGrpCat.{u} where
  obj R := AddCommGrpCat.of (Additive (rootsOfUnity m R))
  map φ := AddCommGrpCat.ofHom (MonoidHom.toAdditive (restrictRootsOfUnity φ.hom m))
  map_id _ := by
    apply AddCommGrpCat.hom_ext
    refine AddMonoidHom.ext fun x => ?_
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Units.ext
    rfl
  map_comp _ _ := by
    apply AddCommGrpCat.hom_ext
    refine AddMonoidHom.ext fun x => ?_
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Units.ext
    rfl

noncomputable def wcTwistFun (m d : ℕ) : AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} where
  obj A := AddCommGrpCat.of (TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin d => A)))
  map f := AddCommGrpCat.ofHom (LinearMap.lTensor (ZMod m)
    (PiTensorProduct.map (fun _ : Fin d => f.hom.toIntLinearMap))).toAddMonoidHom
  map_id A := by
    apply AddCommGrpCat.hom_ext
    simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.hom_id]
    rw [show (fun _ : Fin d => (AddMonoidHom.id A).toIntLinearMap) = fun _ => LinearMap.id from rfl,
      PiTensorProduct.map_id, LinearMap.lTensor_id]
    rfl
  map_comp f g := by
    apply AddCommGrpCat.hom_ext
    simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.hom_comp]
    rw [show (fun _ : Fin d => (g.hom.comp f.hom).toIntLinearMap) =
        fun _ => g.hom.toIntLinearMap ∘ₗ f.hom.toIntLinearMap from rfl,
      PiTensorProduct.map_comp, LinearMap.lTensor_comp]
    rfl

noncomputable def wcRootTwistPre (S : Scheme.{u}) (m d : ℕ) :
    (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun.{u} m ⋙
    wcTwistFun.{u} m d ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}

noncomputable def wcRootTwist (S : Scheme.{u}) (m d : ℕ) :
    Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
  (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj (wcRootTwistPre S m d)
noncomputable def somTensorPresheaf.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) : Cᵒᵖ ⥤ AddCommGrpCat.{w+1} where
  obj X := AddCommGrpCat.of (TensorProduct ℤ (R₀.obj X) (P.obj X))
  map f := AddCommGrpCat.ofHom (TensorProduct.map (R₀.map f).hom.toAddMonoidHom.toIntLinearMap
    (P.map f).hom.toIntLinearMap).toAddMonoidHom
  map_id X := by
    ext x
    change TensorProduct.map _ _ x = x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r p => simp
    | add x y hx hy => rw [map_add, hx, hy]
  map_comp f g := by
    ext x
    change TensorProduct.map _ _ x = TensorProduct.map _ _ (TensorProduct.map _ _ x)
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul r p => simp
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]


noncomputable def somTensorObj.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) : PresheafOfModules.{w+1} R₀ :=
  @PresheafOfModules.ofPresheaf _ _ R₀ (somTensorPresheaf R₀ P)
    (fun X => (TensorProduct.leftModule : Module (R₀.obj X) (TensorProduct ℤ (R₀.obj X) (P.obj X))))
    (fun X Y f r m => by
      let t : TensorProduct ℤ (R₀.obj X) (P.obj X) := m
      show TensorProduct.map (R₀.map f).hom.toAddMonoidHom.toIntLinearMap
          (P.map f).hom.toIntLinearMap (r • t) = (R₀.map f).hom r •
          TensorProduct.map (R₀.map f).hom.toAddMonoidHom.toIntLinearMap
          (P.map f).hom.toIntLinearMap t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul s p => simp [TensorProduct.smul_tmul']
      | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add])


noncomputable def somTensorUnit.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) :
    P ⟶ (PresheafOfModules.toPresheaf R₀).obj (somTensorObj R₀ P) where
  app X := AddCommGrpCat.ofHom (TensorProduct.mk ℤ (R₀.obj X) (P.obj X) 1).toAddMonoidHom
  naturality X Y f := by
    ext p
    change (1 : R₀.obj Y) ⊗ₜ[ℤ] ((P.map f).hom p) = TensorProduct.map _ _ ((1 : R₀.obj X) ⊗ₜ[ℤ] p)
    simp


noncomputable def somPsi.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) (M : PresheafOfModules.{w+1} R₀)
    (ψ : P ⟶ (PresheafOfModules.toPresheaf R₀).obj M) (X : Cᵒᵖ) : P.obj X →+ M.obj X :=
  (ψ.app X).hom


noncomputable def somLiftLin.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) (M : PresheafOfModules.{w+1} R₀)
    (ψ : P ⟶ (PresheafOfModules.toPresheaf R₀).obj M) (X : Cᵒᵖ) :
    TensorProduct ℤ (R₀.obj X) (P.obj X) →ₗ[ℤ] (M.obj X) :=
  TensorProduct.lift (LinearMap.mk₂ ℤ
    (fun (r : R₀.obj X) (p : P.obj X) => r • somPsi R₀ P M ψ X p)
    (fun r r' p => add_smul r r' _)
    (fun c r p => smul_assoc c r _)
    (fun r p p' => by simp only [map_add, smul_add])
    (fun c r p => by simp only [map_zsmul, smul_comm r c]))


noncomputable def somLift.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) (M : PresheafOfModules.{w+1} R₀)
    (ψ : P ⟶ (PresheafOfModules.toPresheaf R₀).obj M) : somTensorObj R₀ P ⟶ M :=
  PresheafOfModules.homMk
    { app := fun X => AddCommGrpCat.ofHom (somLiftLin R₀ P M ψ X).toAddMonoidHom
      naturality := fun X Y f => by
        ext x
        change somLiftLin R₀ P M ψ Y (TensorProduct.map (R₀.map f).hom.toAddMonoidHom.toIntLinearMap
          (P.map f).hom.toIntLinearMap x) = (M.map f).hom (somLiftLin R₀ P M ψ X x)
        induction x using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero, map_zero, map_zero]; rfl
        | tmul r p =>
          have h1 := PresheafOfModules.map_smul M f r (somPsi R₀ P M ψ X p)
          have h2 : somPsi R₀ P M ψ Y ((P.map f).hom p) = (M.map f).hom (somPsi R₀ P M ψ X p) :=
            congrArg (fun g => g.hom p) (ψ.naturality f)
          change (R₀.map f).hom r • somPsi R₀ P M ψ Y ((P.map f).hom p) =
            (M.map f).hom (r • somPsi R₀ P M ψ X p)
          rw [h2]
          exact h1.symm
        | add x y hx hy =>
          rw [map_add, map_add, hx, hy, map_add, map_add]; rfl }
    (fun X r m => by
      have htm : ∀ (r : R₀.obj X) (p : P.obj X),
          somLiftLin R₀ P M ψ X (r ⊗ₜ p) = r • somPsi R₀ P M ψ X p := fun r p => rfl
      let t : TensorProduct ℤ (R₀.obj X) (P.obj X) := m
      show somLiftLin R₀ P M ψ X (r • t) = r • somLiftLin R₀ P M ψ X t
      induction t using TensorProduct.induction_on with
      | zero => rw [smul_zero, map_zero, smul_zero]
      | tmul s p =>
        rw [TensorProduct.smul_tmul', htm, htm, smul_eq_mul, mul_smul]
      | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add])


noncomputable def somHomEquiv.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) (P : Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) (M : PresheafOfModules.{w+1} R₀) :
    (somTensorObj R₀ P ⟶ M) ≃ (P ⟶ (PresheafOfModules.toPresheaf R₀).obj M) where
  toFun φ := somTensorUnit R₀ P ≫ (PresheafOfModules.toPresheaf R₀).map φ
  invFun ψ := somLift R₀ P M ψ
  left_inv φ := by
    apply PresheafOfModules.hom_ext
    intro X
    ext x
    change somLiftLin R₀ P M (somTensorUnit R₀ P ≫ (PresheafOfModules.toPresheaf R₀).map φ) X x =
      (φ.app X).hom x
    induction x using TensorProduct.induction_on with
    | zero => exact (map_zero _).trans ((φ.app X).hom.map_zero).symm
    | tmul r p =>
      change r • (φ.app X).hom ((1 : R₀.obj X) ⊗ₜ[ℤ] p) = (φ.app X).hom (r ⊗ₜ[ℤ] p)
      refine ((φ.app X).hom.map_smul r
        ((1 : R₀.obj X) ⊗ₜ[ℤ] p : (somTensorObj R₀ P).obj X)).symm.trans ?_
      congr 1
      show (r • (1 : R₀.obj X)) ⊗ₜ[ℤ] p = r ⊗ₜ[ℤ] p
      rw [smul_eq_mul, mul_one]
    | add x y hx hy =>
      rw [map_add, hx, hy]
      exact ((φ.app X).hom.map_add x y).symm
  right_inv ψ := by
    ext X p
    change (1 : R₀.obj X) • somPsi R₀ P M ψ X p = somPsi R₀ P M ψ X p
    exact one_smul _ _


noncomputable def somTensorFunctor.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) : (Cᵒᵖ ⥤ AddCommGrpCat.{w+1}) ⥤ PresheafOfModules.{w+1} R₀ :=
  Adjunction.leftAdjointOfEquiv (G := PresheafOfModules.toPresheaf R₀) (F_obj := somTensorObj R₀)
    (fun P M => somHomEquiv R₀ P M) (by
      intro P M M' g h
      change somTensorUnit R₀ P ≫ (PresheafOfModules.toPresheaf R₀).map (h ≫ g) =
        (somTensorUnit R₀ P ≫ (PresheafOfModules.toPresheaf R₀).map h) ≫
          (PresheafOfModules.toPresheaf R₀).map g
      rw [Functor.map_comp, Category.assoc])


noncomputable def somTensorAdj.{w} {C : Type (w+1)} [Category.{w} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{w+1}) : somTensorFunctor R₀ ⊣ PresheafOfModules.toPresheaf R₀ :=
  Adjunction.adjunctionOfEquivLeft _ _
noncomputable abbrev wcFtcFS (X : Scheme.{u}) (Y : X.Etale) :
    Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} :=
  (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

noncomputable abbrev wcFtcGen (X : Scheme.{u}) (Y : X.Etale) :
    (wcFtcFS X Y).obj.obj (Opposite.op Y) :=
  wcSmeGen Y Y (FreeAbelianGroup.of (ULift.up (𝟙 Y)))
noncomputable def wcProEtPullback {A B : Scheme.{u}} (f : A ⟶ B) : B.ProEt ⥤ A.ProEt :=
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  MorphismProperty.Over.pullback (@WeaklyEtale : MorphismProperty Scheme.{u}) ⊤ f
noncomputable def wcIntRatPresheafMap (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcIntRingPresheaf.{u} ℓ ⟶ wcRingPresheaf.{u} ℓ where
  app U := RingCat.ofHom (RingHom.compLeftContinuous (↥(Opposite.unop U))
    ((ULift.ringEquiv.{0, u+1} (R := ℚ_[ℓ])).symm.toRingHom.comp
      ((PadicInt.Coe.ringHom (p := ℓ)).comp (ULift.ringEquiv.{0, u+1} (R := ℤ_[ℓ])).toRingHom))
    (continuous_uliftUp.comp (continuous_subtype_val.comp continuous_uliftDown)))
  naturality _ _ _ := rfl

noncomputable def wcIntRatRingSheafMap (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcIntRingSheaf S ℓ ⟶ wcRingSheaf S ℓ :=
  ((Scheme.ProEt.forget S ⋙ Over.forget S).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) Scheme.proetaleTopology).map
    (ObjectProperty.homMk (wcIntRatPresheafMap.{u} ℓ))

noncomputable def wcIntRatSliceMap (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] : wcIntSliceRing F X h ℓ ⟶ wcSliceRing F X h ℓ :=
  ((Scheme.ProEt.topology X.left).overPullback RingCat.{u+1} (wcGeomPoint F X h)).map
    (wcIntRatRingSheafMap X.left ℓ)

noncomputable def wcUnitRestrict {C : Type*} [Category C] {J : GrothendieckTopology C}
    {R R' : Sheaf J RingCat} (α : R ⟶ R') :
    SheafOfModules.unit R ⟶ (SheafOfModules.restrictScalars α).obj (SheafOfModules.unit R') :=
  (SheafOfModules.unitHomEquiv _).symm
    (PresheafOfModules.sectionsMk
      (M := ((SheafOfModules.restrictScalars α).obj (SheafOfModules.unit R')).val)
      (fun V => (1 : R'.obj.obj V)) (fun _ _ f => map_one (R'.obj.map f).hom))

noncomputable abbrev wcIntRatRestrict (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    SheafOfModules.{u+1} (wcSliceRing F X h ℓ) ⥤ SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ) :=
  SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)
noncomputable def wcSliceToOver (S : Scheme.{u}) (U : S.ProEt) : U.left.ProEt ⥤ Over U :=
  (wcSliceFunctor S U).toOver U (fun W => MorphismProperty.Over.homMk W.hom rfl trivial)
    (fun g => MorphismProperty.Over.Hom.ext (MorphismProperty.Over.w g))

noncomputable def wcOverToSlice (S : Scheme.{u}) (U : S.ProEt) : Over U ⥤ U.left.ProEt where
  obj V := @Scheme.ProEt.mk U.left V.left.left V.hom.left
    (haveI : WeaklyEtale (V.hom.left ≫ U.hom) := (MorphismProperty.Over.w V.hom) ▸ V.left.prop
     WeaklyEtale.of_comp V.hom.left U.hom)
  map {_ _} g := MorphismProperty.Over.homMk g.left.left
    (congrArg (fun k => k.left) (Over.w g)) trivial
  map_id _ := rfl
  map_comp _ _ := rfl
noncomputable abbrev wcEtHomMk {X A B : Scheme.{u}} (p : A ⟶ X) (hp : Etale p) (q : B ⟶ X)
    (hq : Etale q) (k : B ⟶ A) (h : k ≫ p = q) : wcTorsorEt q hq ⟶ wcTorsorEt p hp :=
  MorphismProperty.Over.homMk k h trivial
def wcpaDjIsProjOver (k : Type u) [Field k] {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)) : Prop :=
  ∃ (N : ℕ) (j : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    IsClosedImmersion j ∧
    j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) = s


def wcpaDjSNCSet (Y : Scheme.{u}) (E : Set Y) : Prop :=
  ∃ (m : ℕ) (Dc : Fin m → Set Y), (∀ i, IsClosed (Dc i)) ∧ E = ⋃ i, Dc i ∧
    ∀ y : Y, ∃ (n : ℕ) (t : Fin n → Y.presheaf.stalk y),
      (n : WithBot ℕ∞) = ringKrullDim (Y.presheaf.stalk y) ∧
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) ∧
      ∃ a : {i : Fin m // y ∈ Dc i} → Fin n, Function.Injective a ∧
        ∀ (i : {i : Fin m // y ∈ Dc i}) (y' : Y) (h : y' ⤳ y),
          (y' ∈ Dc i.1 ↔ (Y.presheaf.stalkSpecializes h).hom (t (a i)) ∈
            IsLocalRing.maximalIdeal (Y.presheaf.stalk y'))


def wcpaDjSNCAlteration (k : Type u) [Field k] (X : Scheme.{u}) (sX : X ⟶ Spec (.of k))
    (E : Set X) : Prop :=
  ∃ (Z : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z) (sZ : Z ⟶ Spec (.of k)) (φ : Z ⟶ X),
    φ ≫ sX = sZ ∧ IsProper sZ ∧ (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) ∧
    IsProper φ ∧ Surjective φ ∧ (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) ∧
    wcpaDjIsProjOver k sZ ∧ ∃ D : Set Z, wcpaDjSNCSet Z D ∧ ⇑φ ⁻¹' E ⊆ D


def wcpaDjSplitSemistable {C P : Scheme.{u}} (g : C ⟶ P) : Prop :=
  Flat g ∧ IsProper g ∧
  ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ P) (w : ↥(Limits.pullback g s)),
    (∃ W : (Limits.pullback g s).Opens, w ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g s)) ∨
    (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk w))
        ((Limits.pullback g s).presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      (e.toRingHom.comp ((algebraMap ((Limits.pullback g s).presheaf.stalk w)
        (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk w))
          ((Limits.pullback g s).presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g s).appTop ≫
          (Limits.pullback g s).presheaf.germ ⊤ w trivial).hom)) =
      (Ideal.Quotient.mk _).comp MvPowerSeries.C)


def wcpaDjSections {C P : Scheme.{u}} (g : C ⟶ P) (m : ℕ) (τ : Fin m → (P ⟶ C)) : Prop :=
  (∀ j, τ j ≫ g = 𝟙 P) ∧ (∀ i j (p q : P), i ≠ j → τ i p ≠ τ j q) ∧
  (∀ j (p : P), ∃ W : C.Opens, τ j p ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g))
def wcTarLcCoc (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (m : ℕ)
    (lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) (ZMod m)) : Prop :=
  ∀ P : PrimeSpectrum (TensorProduct R R' (TensorProduct R R' R')),
    lc (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id R R')
        (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R')).toRingHom P) =
      lc (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id R R')
        (Algebra.TensorProduct.includeLeft : R' →ₐ[R] TensorProduct R R' R')).toRingHom P) +
      lc (PrimeSpectrum.comap (Algebra.TensorProduct.includeRight :
        TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).toRingHom P)
def lwubSB {K : Type*} [Field K] (m : ℕ) (δ : ℤ) (F : PowerSeries (MvPolynomial (Fin 2) K)) :
    Prop :=
  ∀ k : ℕ, ∀ s ∈ (PowerSeries.coeff k F).support,
    ((s 0 + s 1 : ℕ) : ℤ) ≤ 2 * (m : ℤ) * (k : ℤ) + δ
noncomputable def wcCnSigma {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    (U : Z.Opens) : B →+* Γ(Z, U) :=
  (Z.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
    (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)

noncomputable abbrev wcCnThick {B : Type u} [CommRing B] [IsLocalRing B] {Z : Scheme.{u}}
    (h : Z ⟶ Spec (.of B)) (n : ℕ) : Scheme.{u} :=
  Limits.pullback h (Spec.map (CommRingCat.ofHom
    (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))

noncomputable abbrev wcCnThickι {B : Type u} [CommRing B] [IsLocalRing B] {Z : Scheme.{u}}
    (h : Z ⟶ Spec (.of B)) (n : ℕ) : wcCnThick h n ⟶ Z :=
  Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
    (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))

noncomputable abbrev wcCnPush {X Z : Scheme.{u}} (g : X ⟶ Z) : Z.Modules :=
  (Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf)

def wcCnAdicSys {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (I : Ideal B)
    (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n) : Prop :=
  (∀ n, wcCoherentMod (Ms n)) ∧
  (∀ n (U : Z.Opens), IsAffineOpen U →
    Function.Surjective (Scheme.Modules.Hom.app (ψ n) U) ∧
    ∀ s : Γ(Ms (n + 1), U), Scheme.Modules.Hom.app (ψ n) U s = 0 ↔
      s ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(Ms (n + 1), U))) ∧
  (∀ n (U : Z.Opens), IsAffineOpen U →
    Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(Ms n, U)) = ⊥)

def wcCnAlg {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (I : Ideal B)
    (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n) (M : Z.Modules) (φ : ∀ n, M ⟶ Ms n) :
    Prop :=
  wcCoherentMod M ∧ (∀ n, φ (n + 1) ≫ ψ n = φ n) ∧
  ∀ n (U : Z.Opens), IsAffineOpen U →
    Function.Surjective (Scheme.Modules.Hom.app (φ n) U) ∧
    ∀ s : Γ(M, U), Scheme.Modules.Hom.app (φ n) U s = 0 ↔
      s ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(M, U))

def wcCnRingTower {Z : Scheme.{u}} {W : ℕ → Scheme.{u}} (g : ∀ n, W n ⟶ Z)
    (ψ : ∀ n, wcCnPush (g (n + 1)) ⟶ wcCnPush (g n)) : Prop :=
  ∀ n (U : Z.Opens) (x y : Γ(W (n + 1), g (n + 1) ⁻¹ᵁ U)),
    (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (ψ n) U (x * y)) =
      (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (ψ n) U x) *
        (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (ψ n) U y) ∧
    (show Γ(W n, g n ⁻¹ᵁ U) from
      Scheme.Modules.Hom.app (ψ n) U (1 : Γ(W (n + 1), g (n + 1) ⁻¹ᵁ U))) = 1

def wcCnQuotData {B : Type u} [CommRing B] {Z V Wn : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    (J : Ideal B) (p : V ⟶ Z) (g : Wn ⟶ Z)
    (ρ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) →+* Γ(Wn, g ⁻¹ᵁ U))) : Prop :=
  (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Γ(V, p ⁻¹ᵁ U)),
    ρ U' hU' (V.presheaf.map (homOfLE (p.preimage_mono hle)).op x) =
      Wn.presheaf.map (homOfLE (g.preimage_mono hle)).op (ρ U hU x)) ∧
  (∀ (U : Z.Opens) (hU : IsAffineOpen U) (r : Γ(Z, U)), ρ U hU (p.app U r) = g.app U r) ∧
  (∀ (U : Z.Opens) (hU : IsAffineOpen U), Function.Surjective (ρ U hU)) ∧
  (∀ (U : Z.Opens) (hU : IsAffineOpen U),
    RingHom.ker (ρ U hU) = Ideal.map (p.app U).hom (Ideal.map (wcCnSigma h U) J))

def wcCnFormalFns.{v} : Prop :=
  ∀ (B : Type v) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{v}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n) (M : Z.Modules)
    (φ : ∀ n, M ⟶ Ms n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Ms ψ →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Ms ψ M φ →
    ∀ s : ∀ n, Γ(Ms n, ⊤), (∀ n, Scheme.Modules.Hom.app (ψ n) ⊤ (s (n + 1)) = s n) →
      ∃! s₀ : Γ(M, ⊤), ∀ n, Scheme.Modules.Hom.app (φ n) ⊤ s₀ = s n

def wcCnProjExist.{v} : Prop :=
  ∀ (B : Type v) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{v}) (h : Z ⟶ Spec (.of B))
    (m : ℕ) (g : Z ⟶ wcPm.{v} m), IsClosedImmersion (Limits.prod.lift h g) →
    ∀ (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n),
      wcCnAdicSys h (IsLocalRing.maximalIdeal B) Ms ψ →
      ∃ (M : Z.Modules) (φ : ∀ n, M ⟶ Ms n), wcCnAlg h (IsLocalRing.maximalIdeal B) Ms ψ M φ
noncomputable abbrev wcSgD (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1)) : (wcProjK K n).Opens :=
  @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
    MvPolynomial.gradedAlgebra (MvPolynomial.X J)

noncomputable abbrev wcSgE (K : Type u) [Field K] (n : ℕ) (J L : Fin (n + 1)) :
    Γ(wcProjK K n, wcSgD K n J) :=
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
  (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
    (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K J)) 1
      (MvPolynomial.X L) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K L)))

noncomputable abbrev wcSgV (K : Type u) [Field K] (N m : ℕ) (b : Fin (N + 1)) (c : Fin (m + 1)) :
    (Limits.pullback (wcProjKStr K N) (wcProjKStr K m)).Opens :=
  Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m) ⁻¹ᵁ wcSgD K N b ⊓
    Limits.pullback.snd (wcProjKStr K N) (wcProjKStr K m) ⁻¹ᵁ wcSgD K m c
noncomputable abbrev wcHM (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcRingSheaf S ℓ)) (SheafOfModules.unit (wcRingSheaf S ℓ)) n

noncomputable def wcHMConst (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (c : ℚ_[ℓ]) :
    SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ) :=
  (SheafOfModules.unitHomEquiv _).symm
    (PresheafOfModules.sectionsMk (M := (SheafOfModules.unit (wcRingSheaf S ℓ)).val)
      (fun V => (ContinuousMap.const _ (ULift.up c) :
        C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])))
      (fun _ _ _ => rfl))

noncomputable def wcHMScalar (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (c : ℚ_[ℓ]) :
    wcHM S ℓ n →+ wcHM S ℓ n :=
  @Abelian.Ext.postcomp _ _ _ (HasExt.standard _) _ _ 0
    (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ c))
    (SheafOfModules.unit (wcRingSheaf S ℓ)) n n (add_zero n)

noncomputable def wcHMCup (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i j k : ℕ) (hk : i + j = k) :
    wcHM S ℓ i →+ wcHM S ℓ j →+ wcHM S ℓ k :=
  @Abelian.Ext.bilinearComp _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcRingSheaf S ℓ)) (SheafOfModules.unit (wcRingSheaf S ℓ))
    (SheafOfModules.unit (wcRingSheaf S ℓ)) i j k hk

noncomputable def wcProEtBC {S S' : Scheme.{u}} (f : S' ⟶ S) : S.ProEt ⥤ S'.ProEt :=
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  MorphismProperty.Over.pullback (@WeaklyEtale : MorphismProperty Scheme.{u}) ⊤ f

structure wcHMPullData {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] where
  cont : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')
  φ : wcRingSheaf S ℓ ⟶
    (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC f) RingCat.{u+1} _
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') cont).obj (wcRingSheaf S' ℓ)
  Φ : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S' ℓ)
  adj : Φ ⊣ @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ cont φ
  additive : Φ.Additive
  presLim : Limits.PreservesFiniteLimits Φ
  presColim : Limits.PreservesFiniteColimits Φ
  μ : Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅ SheafOfModules.unit (wcRingSheaf S' ℓ)

noncomputable def wcHMPull {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) (n : ℕ) : wcHM S ℓ n →+ wcHM S' ℓ n :=
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  ((Abelian.Ext.mk₀ D.μ.inv).precomp _ (zero_add n)).comp
    (((Abelian.Ext.mk₀ D.μ.hom).postcomp _ (add_zero n)).comp
      (D.Φ.mapExtAddHom _ _ n))

def wcHMPullCanonical {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) : Prop :=
  ∀ (V : S.ProEt) (s : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
    ((D.φ.hom.app (Opposite.op V)).hom s : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) =
      s.comp (Limits.pullback.fst V.hom f).base.hom

def wcIsAbsFrob {Y : Scheme.{u}} (φ : Y ⟶ Y) (q : ℕ) : Prop :=
  (∀ y : Y, φ y = y) ∧
  ∀ (U : Y.Opens) (hU : U ≤ φ ⁻¹ᵁ U) (s : Γ(Y, U)), (φ.appLE U U hU).hom s = s ^ q

noncomputable def wcIter {Y : Scheme.{u}} (F' : Y ⟶ Y) : ℕ → (Y ⟶ Y)
  | 0 => 𝟙 Y
  | m + 1 => wcIter F' m ≫ F'

noncomputable def wcGraph {Y B : Scheme.{u}} (π : Y ⟶ B) (F' : Y ⟶ Y) (hF : F' ≫ π = π) (m : ℕ) :
    Y ⟶ Limits.pullback π π :=
  Limits.pullback.lift (𝟙 Y) (wcIter F' m) (by
    induction m with
    | zero => rfl
    | succ m ih =>
      change 𝟙 Y ≫ π = (wcIter F' m ≫ F') ≫ π
      rw [Category.assoc, hF]
      exact ih)

noncomputable abbrev wcXbar (F : Type u) [Field F] (X : Over (Spec (.of F))) : Scheme.{u} :=
  Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))

noncomputable abbrev wcPi2 (F : Type u) [Field F] (X : Over (Spec (.of F))) :
    wcXbar F X ⟶ Spec (.of (AlgebraicClosure F)) :=
  Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))

noncomputable abbrev wcGeomFrobX (F : Type u) [Field F] [Finite F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    wcXbar F X ⟶ wcXbar F X :=
  (wcGeomFrob F X h).left

def wcDI {Xs Ys : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {p1 p2 : Ys ⟶ Xs}
    (D1 : wcHMPullData p1 ℓ) (D2 : wcHMPullData p2 ℓ) (d : ℕ)
    (η : wcHM Xs ℓ (2 * d) →+ ℚ_[ℓ]) (ω : wcHM Xs ℓ (2 * d)) (c : wcHM Ys ℓ (2 * d)) : Prop :=
  ∀ (j : ℕ) (hj : j ≤ 2 * d) (a : wcHM Xs ℓ j) (b : wcHM Xs ℓ (2 * d - j)),
    wcHMCup Ys ℓ (j + 2 * d) (2 * d - j) (4 * d) (by omega)
        (wcHMCup Ys ℓ j (2 * d) (j + 2 * d) rfl (wcHMPull D1 j a) c) (wcHMPull D2 (2 * d - j) b) =
      wcHMScalar Ys ℓ (4 * d) (η (wcHMCup Xs ℓ j (2 * d - j) (2 * d) (by omega) a b))
        (wcHMCup Ys ℓ (2 * d) (2 * d) (4 * d) (by omega)
          (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω))
noncomputable def wcProEtBaseChange {Y Z : Scheme.{u}} (f : Z ⟶ Y) : Y.ProEt ⥤ Z.ProEt :=
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  MorphismProperty.Over.pullback (@WeaklyEtale : MorphismProperty Scheme.{u}) ⊤ f

noncomputable abbrev wcProEtPush {X B : Scheme.{u}} (g : X ⟶ B) :
    Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1} :=
  sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
    (Functor.whiskeringLeft (B.ProEt)ᵒᵖ (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (wcProEtBaseChange g).op ⋙
    presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}

noncomputable def wcRq {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) :
    Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1} :=
  ((wcProEtPush g).rightDerived q).obj (wcLadicSheaf X ℓ)

noncomputable def wcRqScalar {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (c : ℚ_[ℓ]) : wcRq g ℓ q ⟶ wcRq g ℓ q :=
  ((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ c)

noncomputable abbrev wcP1Over (K : Type u) [Field K] : Over (Spec (.of K)) :=
  Over.mk (wcProjKStr K 1)

noncomputable abbrev wcCohG (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (G : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) (i : ℕ) : Type (u+1) :=
  Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i

noncomputable def wcCohGFrob (F : Type u) [Field F] [Finite F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (G : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) (i : ℕ) :
    wcCohG F X h G i →+ wcCohG F X h G i :=
  (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).precomp _ (zero_add i)

noncomputable def wcCohGEnd (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (G : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) (i : ℕ) (σ : G ⟶ G) :
    wcCohG F X h G i →+ wcCohG F X h G i :=
  (Abelian.Ext.mk₀ σ).postcomp _ (add_zero i)

def wcIsEigen {V : Type*} [AddCommGroup V] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (s : ℚ_[ℓ] → V →+ V)
    (Φ : V →+ V) (μ : AlgebraicClosure ℚ_[ℓ]) : Prop :=
  ∃ (r : ℕ) (e : V ≃+ (Fin r → ℚ_[ℓ])), (∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x) ∧
    μ ∈ (wcAddEquivMatrix e Φ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ])

structure wcLefschetzDatum (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) where
  Yt : Over (Spec (.of F''))
  gi : GeometricallyIrreducible Yt.hom
  proper : IsProper Yt.hom
  smooth : SmoothOfRelativeDimension n Yt.hom
  b : Yt.left ⟶ Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' F'')))
  hb : b ≫ Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' F''))) = Yt.hom
  bsurj : Surjective b
  bfin : ∃ V : (Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' F'')))).Opens,
    V ≠ ⊥ ∧ IsFinite (b ∣_ V)
  f : Yt.left ⟶ (wcP1Over F'').left
  hf : f ≫ (wcP1Over F'').hom = Yt.hom
  fconn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ (wcP1Over F'').left),
    ConnectedSpace ↥(Limits.pullback f t)
  m : ℕ
  S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)
  hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _
  hSinj : Function.Injective (fun i => S i (IsLocalRing.closedPoint F''))
  xs : Fin m → (Spec (.of F'') ⟶ Yt.left)
  hxs : ∀ i, xs i ≫ f = S i
  smooth_off : ∀ y : Yt.left, (∀ i, y ≠ xs i (IsLocalRing.closedPoint F'')) →
    ∃ U : Yt.left.Opens, y ∈ U ∧ Smooth (U.ι ≫ f)
  odp : ∀ i : Fin m,
    ∃ (t : Fin n → Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F'')))
      (τ : (wcP1Over F'').left.presheaf.stalk (f (xs i (IsLocalRing.closedPoint F''))))
      (A : Matrix (Fin n) (Fin n) (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F'')))),
      IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F''))) =
          Ideal.span (Set.range t) ∧
        IsLocalRing.maximalIdeal
            ((wcP1Over F'').left.presheaf.stalk (f (xs i (IsLocalRing.closedPoint F'')))) =
          Ideal.span {τ} ∧
        (f.stalkMap (xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
          IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F''))) ^ 3 ∧
        IsUnit (A + A.transpose).det
  u0 : Spec (.of F'') ⟶ (wcP1Over F'').left
  hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _
  hu0S : ∀ i, u0 (IsLocalRing.closedPoint F'') ≠ S i (IsLocalRing.closedPoint F'')
  Z : Over (Spec (.of F''))
  ιZ : Z.left ⟶ Limits.pullback f u0
  hιZ : IsClosedImmersion ιZ
  hιZY : ιZ ≫ Limits.pullback.snd f u0 = Z.hom
  Zaff : ∃ U : (Limits.pullback f u0).Opens, (U : Set ↥(Limits.pullback f u0)) = (Set.range ιZ)ᶜ ∧
    IsAffineOpen U
  Zproper : IsProper Z.hom
  Zsmooth : SmoothOfRelativeDimension (n - 2) Z.hom
  Zgi : 4 ≤ n → GeometricallyIrreducible Z.hom
  N' : ℕ
  jZ : Z.left ⟶ @Proj _ _ _ _ _
    (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F'') MvPolynomial.gradedAlgebra
  hjZ : IsClosedImmersion jZ
  hjZY : jZ ≫ @Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F'') MvPolynomial.gradedAlgebra ≫
    Spec.map (CommRingCat.ofHom (algebraMap F''
      ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F'' 0))) = Z.hom
def wcCnKilled {Z : Scheme.{u}} (𝒦 : Z.IdealSheafData) (G : Z.Modules) : Prop :=
  ∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ a ∈ 𝒦.ideal ⟨V, hV⟩, ∀ s : Γ(G, V), a • s = 0

def wcCnXi {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (I : Ideal B)
    (𝒦 : Z.IdealSheafData) : Prop :=
  ∀ (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n), wcCnAdicSys h I Ms ψ →
    (∀ n, wcCnKilled 𝒦 (Ms n)) → ∃ (M : Z.Modules) (φ : ∀ n, M ⟶ Ms n), wcCnAlg h I Ms ψ M φ

def wcCnAlmostIso {Z : Scheme.{u}} (𝒥 : Z.IdealSheafData) (t : ℕ) {F H : Z.Modules}
    (α : F ⟶ H) : Prop :=
  ∀ (V : Z.Opens) (hV : IsAffineOpen V),
    (∀ s : Γ(F, V), Scheme.Modules.Hom.app α V s = 0 → ∀ a ∈ 𝒥.ideal ⟨V, hV⟩ ^ t, a • s = 0) ∧
    (∀ y : Γ(H, V), ∀ a ∈ 𝒥.ideal ⟨V, hV⟩ ^ t, ∃ s : Γ(F, V), Scheme.Modules.Hom.app α V s = a • y)
def wcGalCover {W E : Scheme.{u}} (q : E ⟶ W) (Γ : Type u) [Group Γ] (α : Γ →* Aut E) : Prop :=
  Finite Γ ∧ IsFinite q ∧ Etale q ∧ AlgebraicGeometry.Surjective q ∧
  ∃ hα : ∀ γ, (α γ).hom ≫ q = q,
    IsIso (Limits.Sigma.desc (fun γ : Γ => Limits.pullback.lift (α γ).hom (𝟙 E)
      ((hα γ).trans (Category.id_comp q).symm)) : ∐ (fun _ : Γ => E) ⟶ Limits.pullback q q)

def wcEtSplits {X E : Scheme.{u}} (e : E ⟶ X) (T : X.Etale) (A : Type u) (s : A → (E ⟶ T.left)) :
    Prop :=
  Finite A ∧ ∃ hs : ∀ a, s a ≫ T.hom = e,
    IsIso (Limits.Sigma.desc (fun a => Limits.pullback.lift (s a) (𝟙 E)
      ((hs a).trans (Category.id_comp e).symm)) : ∐ (fun _ : A => E) ⟶ Limits.pullback T.hom e)
def wcGRing (B : Type u) [CommRing B] : Prop := IsNoetherianRing B ∧ ∀ (𝔪 : Ideal B) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)
def wcPfcRes (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (Λ : Type u)
    [CommRing Λ] [Algebra R Λ] (φ : A →ₐ[R] Λ) (𝔮 : Ideal Λ) : Prop :=
  ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B)
    (ψ : A →ₐ[R] B) (χ : B →ₐ[R] Λ), χ.comp ψ = φ ∧
    (Ideal.span (φ '' {a : A | Algebra.Smooth R (Localization.Away a)})).radical ≤
      (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ∧
    ¬ (Ideal.span (χ '' {b : B | Algebra.Smooth R (Localization.Away b)})).radical ≤ 𝔮


def wcPfcAnnSeq {S : Type u} [CommRing S] {r : ℕ} (x : Fin r → S) : Prop :=
  ∀ i : Fin r, ∀ y : S,
    y * x i ^ 2 ∈ Ideal.span ((fun j : Fin r => x j ^ 8) '' {j | j < i}) →
    y * x i ∈ Ideal.span ((fun j : Fin r => x j ^ 8) '' {j | j < i})


def wcPfcPowIdeal {R : Type u} [CommRing R] {r : ℕ} (π : Fin r → R) : Ideal R :=
  Ideal.span (Set.range fun i => π i ^ 8)


def wcPfcStrictStd (R : Type u) [CommRing R] (A : Type u) [CommRing A] [Algebra R A] (a : A) :
    Prop :=
  ∃ (n m c : ℕ) (_ : c ≤ n) (hcm : c ≤ m) (f : Fin m → MvPolynomial (Fin n) R)
    (e : (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)) ≃ₐ[R] A),
    e.symm a ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span (Set.range f)))
      (Ideal.span (Set.range (fun I : Fin c ↪ Fin n =>
        Matrix.det (Matrix.of (fun j l : Fin c =>
          MvPolynomial.pderiv (I l) (f (Fin.castLE hcm j))))))) ∧
    ∀ j : Fin m, c ≤ j.val → ∃ g : MvPolynomial (Fin n) R,
      Ideal.Quotient.mk (Ideal.span (Set.range f)) g = e.symm a ∧
      g * f j ∈ Ideal.span (f '' {i | i.val < c}) + Ideal.span (Set.range f) ^ 2
def wcCnTwisted {Z : Scheme.{u}} {m : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (F : Z.Modules) (w : ℕ)
    (s : ∀ k : Fin (m + 1), Γ(F, g ⁻¹ᵁ wcPmChart m k)) : Prop :=
  ∀ k l : Fin (m + 1),
    (F.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (s k) =
    ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ w •
    (F.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
      g ⁻¹ᵁ wcPmChart m l)).op).hom (s l)

def wcCnLocFree {Z : Scheme.{u}} (L : Z.Modules) : Prop :=
  wcCoherentMod L ∧ ∀ z : Z, ∃ (U : Z.Opens) (r : ℕ) (ε : Fin r → Γ(L, U)), z ∈ U ∧ IsAffineOpen U ∧
    ∀ (V : Z.Opens) (hV : V ≤ U), Function.Bijective
      (fun a : Fin r → Γ(Z, V) => ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i))

def wcCnUnifLift.{v} : Prop :=
  ∀ (B : Type v) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (Z : Scheme.{v})
    (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{v} m), IsClosedImmersion (Limits.prod.lift h g) →
    ∀ e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{v} m, wcPmChart m k), (∀ k, e k k = 1) →
    (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{v} m).basicOpen (e k l)) →
    (∀ k l j, (wcPm.{v} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k j) =
      (wcPm.{v} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k l) *
      (wcPm.{v} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m l)).op (e l j)) →
    (∀ k (s : Γ(wcPm.{v} m, wcPmChart m k)), ∃ p : MvPolynomial (Fin (m + 1)) ℤ,
      MvPolynomial.eval₂ (Int.castRingHom _) (e k) p = s) →
    ∀ (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Gs ψ →
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → ∀ (n : ℕ) (s : ∀ k, Γ(Gs n, g ⁻¹ᵁ wcPmChart m k)),
      wcCnTwisted g e (Gs n) d s →
      ∃ s' : ∀ k, Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k), wcCnTwisted g e (Gs (n + 1)) d s' ∧
        ∀ k, Scheme.Modules.Hom.app (ψ n) (g ⁻¹ᵁ wcPmChart m k) (s' k) = s k
def wcCnARM {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (I : Ideal B)
    (M : Z.Modules) (r : ℕ) (U : Fin r → Z.Opens) (q : ℕ) (deg : Fin q → ℕ)
    (y : Fin q → ∀ i : Fin r, Γ(M, U i)) : Prop :=
  ∀ (n : ℕ) (x : ∀ i : Fin r, Γ(M, U i)),
    (∀ p : Fin r × Fin r,
      M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
        M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1) ∈
      Ideal.map (wcCnSigma h (U p.1 ⊓ U p.2)) (I ^ n) •
        (⊤ : Submodule Γ(Z, U p.1 ⊓ U p.2) Γ(M, U p.1 ⊓ U p.2))) →
    ∃ (a : Fin q → B) (w : ∀ i : Fin r, Γ(M, U i)),
      (∀ l, a l ∈ I ^ (n - deg l)) ∧
      (∀ i, w i ∈ Ideal.map (wcCnSigma h (U i)) (I ^ n) • (⊤ : Submodule Γ(Z, U i) Γ(M, U i))) ∧
      ∀ p : Fin r × Fin r,
        M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
          M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1) =
        ∑ l, wcCnSigma h (U p.1 ⊓ U p.2) (a l) •
          (M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (y l p.2) -
            M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (y l p.1)) +
        (M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (w p.2) -
          M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (w p.1))
noncomputable instance wcMvGradedAlgebra (σ : Type*) (R : Type*) [CommSemiring R] :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule σ R) := MvPolynomial.gradedAlgebra

def wcBlIdx (n : ℕ) : Type := {T : Finset (Fin (n + 1)) // T.Nonempty}

instance wcBlIdx.instPreorder (n : ℕ) : Preorder (wcBlIdx n) where
  le T T' := T'.1 ⊆ T.1
  le_refl T := Finset.Subset.refl T.1
  le_trans _ _ _ hab hbc := Finset.Subset.trans hbc hab

noncomputable abbrev wcBlB (K : Type u) [Field K] (n : ℕ) (T : Finset (Fin (n + 1))) : Type u :=
  HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
    (∏ m ∈ T, MvPolynomial.X m)

noncomputable abbrev wcBlι (K : Type u) [Field K] (n : ℕ) (T : Finset (Fin (n + 1)))
    (hT : T.Nonempty) : Spec (.of (wcBlB K n T)) ⟶ wcProjK K n :=
  Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
    (∏ m ∈ T, MvPolynomial.X m) (m := T.card)
    ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      simpa using MvPolynomial.IsHomogeneous.prod T
        (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K)) (fun _ => 1)
        (fun m _ => MvPolynomial.isHomogeneous_X K m)))
    (Finset.card_pos.mpr hT)

noncomputable def wcBlCover (K : Type u) [Field K] (n : ℕ) : (wcProjK K n).OpenCover :=
  Scheme.Cover.mkOfCovers (wcBlIdx n) (fun T => Spec (.of (wcBlB K n T.1)))
    (fun T => wcBlι K n T.1 T.2) (by
    intro x
    have hY : (⨆ j : Fin (n + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : x ∈ (⨆ j : Fin (n + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    refine ⟨⟨{j}, Finset.singleton_nonempty j⟩, Scheme.Hom.mem_opensRange.mp ?_⟩
    rw [Proj.opensRange_awayι]
    simpa using hj)

instance wcBlCover.instPreorder (K : Type u) [Field K] (n : ℕ) : Preorder (wcBlCover K n).I₀ :=
  wcBlIdx.instPreorder n

noncomputable def wcBlGHom {R S : Type u} [CommRing R] [CommRing S] {m : ℕ} (φ : R →+* S)
    (v : Fin m → MvPolynomial (Fin 2) S) (hv : ∀ i, (v i).IsHomogeneous 1) :
    MvPolynomial.homogeneousSubmodule (Fin m) R →+*ᵍ MvPolynomial.homogeneousSubmodule (Fin 2) S :=
  ⟨MvPolynomial.eval₂Hom (MvPolynomial.C.comp φ) v, fun {i} {x} hx => by
    rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
    have := hx.eval₂ (MvPolynomial.C.comp φ) v (fun r => MvPolynomial.isHomogeneous_C _ _) hv
    simpa using this⟩

noncomputable def wcBlPhi (K : Type u) [Field K] (n : ℕ) (T T' : Finset (Fin (n + 1)))
    (h : T' ⊆ T) : wcBlB K n T' →+* wcBlB K n T :=
  HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
    (e := (T \ T').card) (g := ∏ m ∈ T \ T', MvPolynomial.X m)
    ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
        simpa using MvPolynomial.IsHomogeneous.prod (T \ T')
          (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K)) (fun _ => 1)
          (fun m _ => MvPolynomial.isHomogeneous_X K m)))
    ((Finset.prod_sdiff h).symm.trans (mul_comm _ _))

noncomputable abbrev wcBlTr (K : Type u) [Field K] (n : ℕ) (T T' : Finset (Fin (n + 1)))
    (h : T' ⊆ T) : Spec (.of (wcBlB K n T)) ⟶ Spec (.of (wcBlB K n T')) :=
  Spec.map (CommRingCat.ofHom (wcBlPhi K n T T' h))

noncomputable abbrev wcBlNt (K : Type u) [Field K] (n : ℕ) (T : Finset (Fin (n + 1))) :
    Proj (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T)) ⟶ Spec (.of (wcBlB K n T)) :=
  wcP1 (wcBlB K n T) ≫ Spec.map (CommRingCat.ofHom
    (algebraMap (wcBlB K n T) ((MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T)) 0)))

noncomputable def wcBlNu (K : Type u) [Field K] (n : ℕ) (T : wcBlIdx n) (l : Fin (n + 1)) :
    wcBlB K n T.1 :=
  HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
    ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
        simpa using MvPolynomial.IsHomogeneous.prod T.1
          (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K)) (fun _ => 1)
          (fun m _ => MvPolynomial.isHomogeneous_X K m))) 1
    (MvPolynomial.X l * ∏ m ∈ T.1.erase (T.1.min' T.2), MvPolynomial.X m) (by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have h1 := Finset.card_pos.mpr T.2
      have h2 := Finset.card_erase_of_mem (Finset.min'_mem T.1 T.2)
      have h3 := (MvPolynomial.isHomogeneous_X K l).mul (MvPolynomial.IsHomogeneous.prod
        (T.1.erase (T.1.min' T.2)) (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K))
        (fun _ => 1) (fun m _ => MvPolynomial.isHomogeneous_X K m))
      convert h3 using 1
      simp only [Finset.sum_const, smul_eq_mul, mul_one, h2]
      omega)

noncomputable def wcBlG (K : Type u) [Field K] (n : ℕ) (T T' : wcBlIdx n) (h : T'.1 ⊆ T.1) :
    MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T'.1) →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1) :=
  wcBlGHom (wcBlPhi K n T.1 T'.1 h)
    ![MvPolynomial.C (wcBlNu K n T (T'.1.min' T'.2)) * MvPolynomial.X 0, MvPolynomial.X 1]
    (fun i => by
      fin_cases i
      · exact MvPolynomial.isHomogeneous_C_mul_X _ _
      · exact MvPolynomial.isHomogeneous_X _ _)

noncomputable def wcBlF (K : Type u) [Field K] (n : ℕ) (T : wcBlIdx n) :
    MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n T.1) :=
  wcBlGHom ((algebraMap _ (wcBlB K n T.1)).comp
      (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
    (Fin.lastCases (MvPolynomial.X 1) (fun l => MvPolynomial.C (wcBlNu K n T l) * MvPolynomial.X 0))
    (fun i => by
      induction i using Fin.lastCases with
      | last => simpa using MvPolynomial.isHomogeneous_X _ _
      | cast l => simpa using MvPolynomial.isHomogeneous_C_mul_X _ _)

noncomputable def wcGradeZeroHom {A B σ τ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜]
    [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ) : ↥(𝒜 0) →+* ↥(ℬ 0) where
  toFun a := ⟨f a, f.map_mem a.2⟩
  map_one' := Subtype.ext (by simp [SetLike.GradeZero.coe_one])
  map_mul' a b := Subtype.ext (by simp [SetLike.GradeZero.coe_mul])
  map_zero' := Subtype.ext (by simp)
  map_add' a b := Subtype.ext (by simp)
noncomputable def wcCnComplIdeal {Z : Scheme.{u}} (U : Z.Opens) : Z.IdealSheafData :=
  Scheme.IdealSheafData.vanishingIdeal ⟨(U : Set Z)ᶜ, U.isOpen.isClosed_compl⟩

def wcCnUnitRel {Z P : Scheme.{u}} (p : P ⟶ Z) (Fs : ℕ → Z.Modules) (F'' : P.Modules)
    (φ'' : ∀ n, F'' ⟶ (Scheme.Modules.pullback p).obj (Fs n)) (Hs : ℕ → Z.Modules)
    (φH : ∀ n, (Scheme.Modules.pushforward p).obj F'' ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) : Prop :=
  ∀ (V : Z.Opens), IsAffineOpen V → ∀ (n : ℕ) (x : Γ(Fs n, V))
    (y : Γ((Scheme.Modules.pushforward p).obj F'', V)),
    Scheme.Modules.Hom.app (φH n) V y = Scheme.Modules.Hom.app (α n) V x →
    Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' n)) V y =
      Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n)) V x

def wcCnLimBound {Z : Scheme.{u}} (Fs Hs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n)
    (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) (V : Z.Opens) (J : Ideal Γ(Z, V))
    (t : ℕ) : Prop :=
  (∀ x : ∀ n, Γ(Fs n, V), (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) →
    (∀ n, Scheme.Modules.Hom.app (α n) V (x n) = 0) → ∀ a ∈ J ^ t, ∀ n, a • x n = 0) ∧
  (∀ y : ∀ n, Γ(Hs n, V), (∀ n, Scheme.Modules.Hom.app (ψH n) V (y (n + 1)) = y n) →
    ∀ a ∈ J ^ t, ∃ x : ∀ n, Γ(Fs n, V), (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) ∧
      ∀ n, Scheme.Modules.Hom.app (α n) V (x n) = a • y n)

def wcCnLevelBound {Z : Scheme.{u}} (Fs Hs : ℕ → Z.Modules) (α : ∀ n, Fs n ⟶ Hs n)
    (V : Z.Opens) (J : Ideal Γ(Z, V)) (t : ℕ) : Prop :=
  ∀ n, (∀ s : Γ(Fs n, V), Scheme.Modules.Hom.app (α n) V s = 0 → ∀ a ∈ J ^ t, a • s = 0) ∧
    (∀ y : Γ(Hs n, V), ∀ a ∈ J ^ t, ∃ s : Γ(Fs n, V), Scheme.Modules.Hom.app (α n) V s = a • y)
def wcCnUtlH1Van {Z : Scheme.{u}} {m : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k))
    {G' G : Z.Modules} (ψ : G' ⟶ G) (w : ℕ) : Prop :=
  ∀ c : ∀ k l : Fin (m + 1), Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l),
    (∀ k l, Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) (c k l) = 0) →
    (∀ k l j : Fin (m + 1),
      (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓
          g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)).op).hom (c k l) +
        ((Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ w •
        (G'.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (c l j) =
      (G'.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (c k j)) →
    ∃ b : ∀ k : Fin (m + 1), Γ(G', g ⁻¹ᵁ wcPmChart m k),
      (∀ k, Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k) (b k) = 0) ∧
      ∀ k l : Fin (m + 1), c k l =
        (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m k)).op).hom (b k) -
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ w •
        (G'.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom (b l)

def wcCnUtlVan (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ)
    (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (p : ℕ) (w : ℤ) :
    Prop :=
  ∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
    (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) →
    (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ ∈ wcLaurK A n R d K w τ) →
    ∃ y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
      (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧
      ∀ σ : Finset (Fin n), σ.card = p + 1 → z σ - wcAltD (A := A) n y σ ∈ wcLaurK A n R d K w σ

def wcCnUtlModel {Z : Scheme.{u}} {m : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k))
    {G' G : Z.Modules} (ψ : G' ⟶ G) (A : Type u) [CommRing A] (R : ℕ) (d : Fin R → ℕ)
    (K : Submodule (MvPolynomial (Fin (m + 1)) A) (Fin R → MvPolynomial (Fin (m + 1)) A))
    (H : AddSubgroup (Fin R → (Fin (m + 1) → ℤ) →₀ A))
    (Θ1 : ∀ k : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) → Γ(G', g ⁻¹ᵁ wcPmChart m k))
    (Θ2 : ∀ k l : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
      Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
    (Θ3 : ∀ k l j : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
      Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j))
    (w : ℕ) : Prop :=
  (∀ k v v', Θ1 k (v + v') = Θ1 k v + Θ1 k v') ∧
  (∀ k l v v', Θ2 k l (v + v') = Θ2 k l v + Θ2 k l v') ∧
  (∀ k l j v v', Θ3 k l j (v + v') = Θ3 k l j v + Θ3 k l j v') ∧
  (∀ k, ∀ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k},
    Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k) (Θ1 k v) = 0) ∧
  (∀ k l : Fin (m + 1), k < l → ∀ c : Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l),
    Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) c = 0 →
    ∃ v ∈ H, v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k, l} ∧ Θ2 k l v = c) ∧
  (∀ k l : Fin (m + 1), k < l → ∀ v ∈ wcLaurK A (m + 1) R d K (w : ℤ) {k, l}, Θ2 k l v = 0) ∧
  (∀ k l j : Fin (m + 1), k < l → l < j → ∀ v ∈ H, v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k, l, j} →
    Θ3 k l j v = 0 → v ∈ wcLaurK A (m + 1) R d K (w : ℤ) {k, l, j}) ∧
  (∀ k l : Fin (m + 1), k < l → ∀ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k},
    Θ2 k l v = (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (Θ1 k v)) ∧
  (∀ k l : Fin (m + 1), k < l → ∀ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {l},
    Θ2 k l v = ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ w •
      (G'.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (Θ1 l v)) ∧
  (∀ k l j : Fin (m + 1), k < l → l < j → ∀ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k, l},
    Θ3 k l j v = (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)).op).hom (Θ2 k l v)) ∧
  (∀ k l j : Fin (m + 1), k < l → l < j → ∀ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k, j},
    Θ3 k l j v = (G'.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left)
      inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (Θ2 k j v)) ∧
  (∀ k l j : Fin (m + 1), k < l → l < j → ∀ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {l, j},
    Θ3 k l j v = ((Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ w •
      (G'.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (Θ2 l j v))
noncomputable abbrev wcSqzObj (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] :
    CommRingCat.{u} :=
  letI : Module Rᵐᵒᵖ M := Module.compHom M (RingEquiv.toOpposite R).symm.toRingHom
  haveI : IsCentralScalar R M := ⟨fun _ _ => rfl⟩
  CommRingCat.of (TrivSqZeroExt R M)

noncomputable def wcSqzHom {R R' M M' : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    [CommRing R'] [AddCommGroup M'] [Module R' M'] (ρ : R →+* R') (μ : M →+ M')
    (hμ : ∀ (r : R) (m : M), μ (r • m) = ρ r • μ m) : wcSqzObj R M ⟶ wcSqzObj R' M' :=
  letI : Module Rᵐᵒᵖ M := Module.compHom M (RingEquiv.toOpposite R).symm.toRingHom
  haveI : IsCentralScalar R M := ⟨fun _ _ => rfl⟩
  letI : Module R'ᵐᵒᵖ M' := Module.compHom M' (RingEquiv.toOpposite R').symm.toRingHom
  haveI : IsCentralScalar R' M' := ⟨fun _ _ => rfl⟩
  CommRingCat.ofHom
    { toFun := fun x => (Prod.mk (ρ x.fst) (μ x.snd) : TrivSqZeroExt R' M')
      map_one' := by
        refine TrivSqZeroExt.ext ?_ ?_
        · exact (congrArg ρ (TrivSqZeroExt.fst_one)).trans (map_one ρ)
        · exact (congrArg μ (TrivSqZeroExt.snd_one)).trans (map_zero μ)
      map_mul' := fun x y => by
        refine TrivSqZeroExt.ext ?_ ?_
        · show ρ (x * y).fst = ρ x.fst * ρ y.fst
          rw [TrivSqZeroExt.fst_mul, map_mul]
        · show μ (x * y).snd = ρ x.fst • μ y.snd + MulOpposite.op (ρ y.fst) • μ x.snd
          rw [TrivSqZeroExt.snd_mul, op_smul_eq_smul, op_smul_eq_smul, map_add, hμ, hμ]
      map_zero' := by
        refine TrivSqZeroExt.ext ?_ ?_
        · exact map_zero ρ
        · exact map_zero μ
      map_add' := fun x y => by
        refine TrivSqZeroExt.ext ?_ ?_
        · exact map_add ρ x.fst y.fst
        · exact map_add μ x.snd y.snd }

noncomputable def wcSqzPresheaf {Z : Scheme.{u}} (M : Z.Modules) : Z.Opensᵒᵖ ⥤ CommRingCat.{u} where
  obj W := wcSqzObj Γ(Z, W.unop) Γ(M, W.unop)
  map {W W'} i := wcSqzHom (Z.presheaf.map i).hom (M.presheaf.map i).hom
    (fun r m => Scheme.Modules.map_smul M i.unop r m)
  map_id W := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    refine TrivSqZeroExt.ext ?_ ?_
    · show (Z.presheaf.map (𝟙 W)).hom x.fst = x.fst
      rw [CategoryTheory.Functor.map_id]; rfl
    · show (M.presheaf.map (𝟙 W)).hom x.snd = x.snd
      rw [CategoryTheory.Functor.map_id]; rfl
  map_comp {W W' W''} i j := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    refine TrivSqZeroExt.ext ?_ ?_
    · show (Z.presheaf.map (i ≫ j)).hom x.fst = (Z.presheaf.map j).hom ((Z.presheaf.map i).hom x.fst)
      rw [CategoryTheory.Functor.map_comp]; rfl
    · show (M.presheaf.map (i ≫ j)).hom x.snd = (M.presheaf.map j).hom ((M.presheaf.map i).hom x.snd)
      rw [CategoryTheory.Functor.map_comp]; rfl

noncomputable def wcSqzUnit {Z : Scheme.{u}} (M : Z.Modules) : Z.presheaf ⟶ wcSqzPresheaf M where
  app W :=
    letI : Module (Γ(Z, W.unop))ᵐᵒᵖ Γ(M, W.unop) :=
      Module.compHom _ (RingEquiv.toOpposite Γ(Z, W.unop)).symm.toRingHom
    haveI : IsCentralScalar Γ(Z, W.unop) Γ(M, W.unop) := ⟨fun _ _ => rfl⟩
    CommRingCat.ofHom (TrivSqZeroExt.inlHom Γ(Z, W.unop) Γ(M, W.unop))
  naturality {W W'} i := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    refine TrivSqZeroExt.ext ?_ ?_
    · rfl
    · exact (map_zero (M.presheaf.map i).hom).symm
def wcCnJAdicSys {Z : Scheme.{u}} (𝒥 : Z.IdealSheafData) (Gs : ℕ → Z.Modules)
    (τ : ∀ e, Gs (e + 1) ⟶ Gs e) : Prop :=
  (∀ e, wcCoherentMod (Gs e)) ∧
  (∀ e (V : Z.Opens) (hV : IsAffineOpen V),
    Function.Surjective (Scheme.Modules.Hom.app (τ e) V) ∧
    ∀ s : Γ(Gs (e + 1), V), Scheme.Modules.Hom.app (τ e) V s = 0 ↔
      s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) •
        (⊤ : Submodule Γ(Z, V) Γ(Gs (e + 1), V))) ∧
  (∀ e (V : Z.Opens) (hV : IsAffineOpen V),
    (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(Gs e, V)) = ⊥)

def wcCnJAlg {Z : Scheme.{u}} (𝒥 : Z.IdealSheafData) (Gs : ℕ → Z.Modules)
    (τ : ∀ e, Gs (e + 1) ⟶ Gs e) (G : Z.Modules) (φ : ∀ e, G ⟶ Gs e) : Prop :=
  wcCoherentMod G ∧ (∀ e, φ (e + 1) ≫ τ e = φ e) ∧
  ∀ e (V : Z.Opens) (hV : IsAffineOpen V),
    Function.Surjective (Scheme.Modules.Hom.app (φ e) V) ∧
    ∀ s : Γ(G, V), Scheme.Modules.Hom.app (φ e) V s = 0 ↔
      s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(G, V))

structure wcCn088AQuot {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    (I : Ideal B) (𝒦 𝒥 : Z.IdealSheafData) (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n)
    (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) where
  Fq : ℕ → ℕ → Z.Modules
  pF : ∀ e n, Fs n ⟶ Fq e n
  τF : ∀ e n, Fq (e + 1) n ⟶ Fq e n
  ψq : ∀ e n, Fq e (n + 1) ⟶ Fq e n
  Hq : ℕ → ℕ → Z.Modules
  pH : ∀ e n, Hs n ⟶ Hq e n
  τH : ∀ e n, Hq (e + 1) n ⟶ Hq e n
  ψHq : ∀ e n, Hq e (n + 1) ⟶ Hq e n
  αq : ∀ e n, Fq e n ⟶ Hq e n
  c : ℕ
  Fq_adic : ∀ e, wcCnAdicSys h I (Fq e) (ψq e)
  Hq_adic : ∀ e, wcCnAdicSys h I (Hq e) (ψHq e)
  Fq_jadic : ∀ n, wcCnJAdicSys 𝒥 (fun e => Fq e n) (fun e => τF e n)
  Hq_jadic : ∀ n, wcCnJAdicSys 𝒥 (fun e => Hq e n) (fun e => τH e n)
  pF_jalg : ∀ n, wcCnJAlg 𝒥 (fun e => Fq e n) (fun e => τF e n) (Fs n) (fun e => pF e n)
  pH_jalg : ∀ n, wcCnJAlg 𝒥 (fun e => Hq e n) (fun e => τH e n) (Hs n) (fun e => pH e n)
  Fq_killed : ∀ e n, wcCnKilled 𝒦 (Fq e n)
  pF_ψ : ∀ e n, pF e (n + 1) ≫ ψq e n = ψ n ≫ pF e n
  pH_ψ : ∀ e n, pH e (n + 1) ≫ ψHq e n = ψH n ≫ pH e n
  τF_ψ : ∀ e n, τF e (n + 1) ≫ ψq e n = ψq (e + 1) n ≫ τF e n
  τH_ψ : ∀ e n, τH e (n + 1) ≫ ψHq e n = ψHq (e + 1) n ≫ τH e n
  pF_α : ∀ e n, pF e n ≫ αq e n = α n ≫ pH e n
  αq_ψ : ∀ e n, αq e (n + 1) ≫ ψHq e n = ψq e n ≫ αq e n
  αq_τ : ∀ e n, αq (e + 1) n ≫ τH e n = τF e n ≫ αq e n
  αq_almost : ∀ e n, wcCnAlmostIso 𝒥 c (αq e n)

structure wcCn088ALayers {B : Type u} [CommRing B] {Z : Scheme.{u}} {h : Z ⟶ Spec (.of B)}
    {I : Ideal B} {𝒦 𝒥 : Z.IdealSheafData} {Fs : ℕ → Z.Modules} {ψ : ∀ n, Fs (n + 1) ⟶ Fs n}
    {Hs : ℕ → Z.Modules} {ψH : ∀ n, Hs (n + 1) ⟶ Hs n} {α : ∀ n, Fs n ⟶ Hs n}
    (Q : wcCn088AQuot h I 𝒦 𝒥 Fs ψ Hs ψH α) (H : Z.Modules) (φH : ∀ n, H ⟶ Hs n) where
  G : ℕ → Z.Modules
  τ : ∀ e, G (e + 1) ⟶ G e
  χ : ∀ e n, G e ⟶ Q.Fq e n
  H' : ℕ → Z.Modules
  τH' : ∀ e, H' (e + 1) ⟶ H' e
  q : ∀ e, H ⟶ H' e
  χH : ∀ e n, H' e ⟶ Q.Hq e n
  β : ∀ e, G e ⟶ H' e
  cβ : ℕ
  G_jadic : wcCnJAdicSys 𝒥 G τ
  G_alg : ∀ e, wcCnAlg h I (Q.Fq e) (Q.ψq e) (G e) (χ e)
  τ_χ : ∀ e n, τ e ≫ χ e n = χ (e + 1) n ≫ Q.τF e n
  H'_jadic : wcCnJAdicSys 𝒥 H' τH'
  q_jalg : wcCnJAlg 𝒥 H' τH' H q
  q_χH : ∀ e n, q e ≫ χH e n = φH n ≫ Q.pH e n
  β_τ : ∀ e, β (e + 1) ≫ τH' e = τ e ≫ β e
  β_χ : ∀ e n, β e ≫ χH e n = χ e n ≫ Q.αq e n
  β_almost : ∀ e, wcCnAlmostIso 𝒥 cβ (β e)
noncomputable def wcCnTrans {X : Scheme.{u}} {Gs : ℕ → X.Modules} (ψ : ∀ n, Gs (n + 1) ⟶ Gs n)
    (n : ℕ) : ∀ c : ℕ, Gs (n + c) ⟶ Gs n
  | 0 => 𝟙 (Gs n)
  | c + 1 => ψ (n + c) ≫ wcCnTrans ψ n c
noncomputable def wcKlmLP {T : Type*} [CommRing T] {N : ℕ} (u : Fin N → T) (β : Fin N → ℤ) : T :=
  ∏ i, (u i ^ (β i).toNat * Ring.inverse (u i) ^ (-β i).toNat)

noncomputable def wcKlmEps {B : Type*} [CommRing B] {r : ℕ} (b : Fin r → B) (p : ℕ)
    (c : MvPolynomial (Fin r) B) : B :=
  MvPolynomial.eval b (MvPolynomial.homogeneousComponent p c)

noncomputable def wcKlmEv {A T M : Type*} [CommRing A] [CommRing T] [AddCommGroup M] [Module T M]
    {N R : ℕ} (α : A → T) (u : Fin N → T) (ℓ : Fin R → M) (v : Fin R → (Fin N → ℤ) →₀ A) : M :=
  ∑ r, (v r).sum (fun β c => (α c * wcKlmLP u β) • ℓ r)

noncomputable def wcKlmPEv {A T M : Type*} [CommRing A] [CommRing T] [AddCommGroup M] [Module T M]
    {N R : ℕ} (α : A → T) (u : Fin N → T) (ℓ : Fin R → M) (f : Fin R → MvPolynomial (Fin N) A) :
    M :=
  ∑ r, ∑ μ ∈ (f r).support, (α ((f r).coeff μ) * ∏ i, u i ^ μ i) • ℓ r

noncomputable def wcKlmTh1 {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    {m r q : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k))
    (p : ℕ) (k : Fin (m + 1)) (v : Fin q → (Fin (m + 1) → ℤ) →₀ MvPolynomial (Fin r) B) :
    Γ(Gs p, g ⁻¹ᵁ wcPmChart m k) :=
  wcKlmEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) (wcKlmEps b p c))
    (fun i => g.app (wcPmChart m k) (e k i)) (fun ρ => L k ρ p) v

noncomputable def wcKlmTh2 {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    {m r q : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k))
    (p : ℕ) (k l : Fin (m + 1)) (v : Fin q → (Fin (m + 1) → ℤ) →₀ MvPolynomial (Fin r) B) :
    Γ(Gs p, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) :=
  wcKlmEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) (wcKlmEps b p c))
    (fun i => (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)))
    (fun ρ => ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p)) v

noncomputable def wcKlmTh3 {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    {m r q : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k))
    (p : ℕ) (k l j : Fin (m + 1)) (v : Fin q → (Fin (m + 1) → ℤ) →₀ MvPolynomial (Fin r) B) :
    Γ(Gs p, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j) :=
  wcKlmEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)
      (wcKlmEps b p c))
    (fun i => (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)))
    (fun ρ => ((Gs p).presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p)) v

def wcKlmH (B : Type u) [CommRing B] (r q N p : ℕ) :
    AddSubgroup (Fin q → (Fin N → ℤ) →₀ MvPolynomial (Fin r) B) where
  carrier := {v | ∀ ρ β, (v ρ β).IsHomogeneous p}
  zero_mem' := fun _ _ => MvPolynomial.isHomogeneous_zero _ _ _
  add_mem' := fun {_ _} ha hb ρ β => (ha ρ β).add (hb ρ β)
  neg_mem' := fun {_} ha ρ β => (ha ρ β).neg

noncomputable def wcKlmK {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    {m r q : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)) :
    Submodule (MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B))
      (Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) :=
  Submodule.span _ {f | (∃ d : ℕ, ∀ ρ, (f ρ).IsHomogeneous d) ∧ ∀ (a : Fin (m + 1)) (p : ℕ),
    wcKlmPEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m a) (wcKlmEps b p c))
      (fun i => g.app (wcPmChart m a) (e a i)) (fun ρ => L a ρ p) f = 0}

def wcKlmHyp {B : Type u} [CommRing B] [IsLocalRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
    {m r q : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n) (D : ℕ)
    (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)) : Prop :=
  IsClosedImmersion (Limits.prod.lift h g) ∧
  (∀ k, e k k = 1) ∧
  (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{u} m).basicOpen (e k l)) ∧
  (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k j) =
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k l) *
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m l)).op (e l j)) ∧
  (∀ k (s : Γ(wcPm.{u} m, wcPmChart m k)), ∃ p : MvPolynomial (Fin (m + 1)) ℤ,
      MvPolynomial.eval₂ (Int.castRingHom _) (e k) p = s) ∧
  wcCnAdicSys h (IsLocalRing.maximalIdeal B) Gs ψ ∧
  Ideal.span (Set.range b) = IsLocalRing.maximalIdeal B ∧
  (∀ ρ, wcCnTwisted g e (Gs 0) D (fun k => L k ρ 0)) ∧
  (∀ k, Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k) (Set.range fun ρ => L k ρ 0) = ⊤) ∧
  (∀ k ρ p, Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k) (L k ρ (p + 1)) = L k ρ p)
noncomputable def wcCnJaAppL {X : Scheme.{u}} {M N : X.Modules} (φ : M ⟶ N) (U : X.Opens) :
    Γ(M, U) →ₗ[Γ(X, U)] Γ(N, U) where
  toFun s := Scheme.Modules.Hom.app φ U s
  map_add' x y := map_add _ x y
  map_smul' r x := Scheme.Modules.Hom.app_smul φ r x
noncomputable def wcCnSecLin {X : Scheme.{u}} {P Q : X.Modules} (f : P ⟶ Q) (V : X.Opens) :
    Γ(P, V) →ₗ[Γ(X, V)] Γ(Q, V) where
  toFun x := Scheme.Modules.Hom.app f V x
  map_add' x y := map_add _ x y
  map_smul' r x := Scheme.Modules.Hom.app_smul f r x
noncomputable def wcCnMulRing {R : Type u} [CommRing R] {N : Type u} [AddCommGroup N] [Module R N]
    (o : N) (mu : MultilinearMap R (fun _ : Fin 2 => N) N)
    (hc : ∀ x y : N, mu ![x, y] = mu ![y, x])
    (ha : ∀ x y z : N, mu ![mu ![x, y], z] = mu ![x, mu ![y, z]])
    (hu : ∀ x : N, mu ![o, x] = x) : CommRing N :=
  { (inferInstance : AddCommGroup N) with
    mul := fun x y => mu ![x, y]
    one := o
    left_distrib := fun x y z => by
      have h := mu.map_update_add ![x, y] 1 y z
      have e1 : ∀ c : N, Function.update ![x, y] 1 c = ![x, c] := fun c => by
        funext j; fin_cases j <;> rfl
      rw [e1, e1, e1] at h
      exact h
    right_distrib := fun x y z => by
      have h := mu.map_update_add ![x, z] 0 x y
      have e0 : ∀ c : N, Function.update ![x, z] 0 c = ![c, z] := fun c => by
        funext j; fin_cases j <;> rfl
      rw [e0, e0, e0] at h
      exact h
    zero_mul := fun x => mu.map_coord_zero (m := ![0, x]) 0 rfl
    mul_zero := fun x => mu.map_coord_zero (m := ![x, 0]) 1 rfl
    mul_assoc := ha
    one_mul := hu
    mul_one := fun x => (hc x o).trans (hu x)
    mul_comm := hc }

noncomputable def wcCnMulObj {R : Type u} [CommRing R] {N : Type u} [AddCommGroup N] [Module R N]
    (o : N) (mu : MultilinearMap R (fun _ : Fin 2 => N) N)
    (hc : ∀ x y : N, mu ![x, y] = mu ![y, x])
    (ha : ∀ x y z : N, mu ![mu ![x, y], z] = mu ![x, mu ![y, z]])
    (hu : ∀ x : N, mu ![o, x] = x) : CommRingCat.{u} :=
  @CommRingCat.of N (wcCnMulRing o mu hc ha hu)

noncomputable def wcCnMulUnit {R : Type u} [CommRing R] {N : Type u} [AddCommGroup N] [Module R N]
    (o : N) (mu : MultilinearMap R (fun _ : Fin 2 => N) N)
    (hc : ∀ x y : N, mu ![x, y] = mu ![y, x])
    (ha : ∀ x y z : N, mu ![mu ![x, y], z] = mu ![x, mu ![y, z]])
    (hu : ∀ x : N, mu ![o, x] = x) : R →+* wcCnMulObj o mu hc ha hu where
  toFun r := (r • o : N)
  map_one' := by
    show (1 : R) • o = o
    exact one_smul R o
  map_mul' r s := by
    show (r * s) • o = mu ![r • o, s • o]
    have h := mu.map_update_smul ![o, s • o] 0 r o
    have e1 : Function.update ![o, s • o] 0 (r • o) = ![r • o, s • o] := by
      funext i; fin_cases i <;> rfl
    have e2 : Function.update ![o, s • o] 0 o = ![o, s • o] := by
      funext i; fin_cases i <;> rfl
    rw [e1, e2, hu] at h
    rw [h, mul_smul]
  map_zero' := by
    show (0 : R) • o = (0 : N)
    exact zero_smul R o
  map_add' r s := by
    show (r + s) • o = r • o + s • o
    exact add_smul r s o

noncomputable def wcCnAlgObj {Z : Scheme.{u}} (M : Z.Modules)
    (one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U))
    (μ : ∀ U : Z.Opens, IsAffineOpen U → MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U))
    (hc : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)), μ U hU ![x, y] = μ U hU ![y, x])
    (ha : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]])
    (hu : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x)
    (U : Z.AffineZariskiSite) : CommRingCat.{u} :=
  wcCnMulObj (one U.toOpens U.2) (μ U.toOpens U.2) (hc U.toOpens U.2) (ha U.toOpens U.2)
    (hu U.toOpens U.2)

noncomputable def wcCnAlgRes {Z : Scheme.{u}} (M : Z.Modules)
    (one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U))
    (μ : ∀ U : Z.Opens, IsAffineOpen U → MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U))
    (hone : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
      M.presheaf.map (homOfLE hle).op (one U hU) = one U' hU')
    (hμ : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Fin 2 → Γ(M, U)),
      M.presheaf.map (homOfLE hle).op (μ U hU x) =
        μ U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i)))
    (hc : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)), μ U hU ![x, y] = μ U hU ![y, x])
    (ha : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]])
    (hu : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x)
    {U V : Z.AffineZariskiSite} (h : V ≤ U) :
    wcCnAlgObj M one μ hc ha hu U ⟶ wcCnAlgObj M one μ hc ha hu V :=
  CommRingCat.ofHom (R := wcCnAlgObj M one μ hc ha hu U) (S := wcCnAlgObj M one μ hc ha hu V)
  { toFun := fun x => M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono h)).op x
    map_one' := hone _ _ U.2 V.2 _
    map_mul' := fun x y => by
      show M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono h)).op
          (μ _ U.2 ![x, y]) =
        μ _ V.2 ![M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono h)).op x,
          M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono h)).op y]
      rw [hμ _ _ U.2 V.2]
      congr 1
      funext i
      fin_cases i <;> rfl
    map_zero' := map_zero (M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono h)).op).hom
    map_add' := map_add (M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono h)).op).hom }

noncomputable def wcCnAlgFun {Z : Scheme.{u}} (M : Z.Modules)
    (one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U))
    (μ : ∀ U : Z.Opens, IsAffineOpen U → MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U))
    (hone : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
      M.presheaf.map (homOfLE hle).op (one U hU) = one U' hU')
    (hμ : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Fin 2 → Γ(M, U)),
      M.presheaf.map (homOfLE hle).op (μ U hU x) =
        μ U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i)))
    (hc : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)), μ U hU ![x, y] = μ U hU ![y, x])
    (ha : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]])
    (hu : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x) :
    Z.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} where
  obj U := wcCnAlgObj M one μ hc ha hu U.unop
  map {U V} g := wcCnAlgRes M one μ hone hμ hc ha hu (leOfHom g.unop)
  map_id U := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    change M.presheaf.map (𝟙 (Opposite.op U.unop.toOpens)) (x : Γ(M, U.unop.toOpens)) = x
    rw [CategoryTheory.Functor.map_id]
    rfl
  map_comp {U V W} g g' := by
    have key : ∀ (A B C : Z.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (s : Γ(M, A)),
        M.presheaf.map (homOfLE h3).op s =
          M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op s) := by
      intro A B C h1 h2 h3 s
      rw [← CategoryTheory.comp_apply, ← CategoryTheory.Functor.map_comp]
      rfl
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    exact key U.unop.toOpens V.unop.toOpens W.unop.toOpens
      (Scheme.AffineZariskiSite.toOpens_mono (leOfHom g.unop))
      (Scheme.AffineZariskiSite.toOpens_mono (leOfHom g'.unop))
      (Scheme.AffineZariskiSite.toOpens_mono (leOfHom (g ≫ g').unop)) x

noncomputable def wcCnAlgUnit {Z : Scheme.{u}} (M : Z.Modules)
    (one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U))
    (μ : ∀ U : Z.Opens, IsAffineOpen U → MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U))
    (hone : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
      M.presheaf.map (homOfLE hle).op (one U hU) = one U' hU')
    (hμ : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Fin 2 → Γ(M, U)),
      M.presheaf.map (homOfLE hle).op (μ U hU x) =
        μ U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i)))
    (hc : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)), μ U hU ![x, y] = μ U hU ![y, x])
    (ha : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]])
    (hu : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x) :
    (Scheme.AffineZariskiSite.toOpensFunctor Z).op ⋙ Z.presheaf ⟶
      wcCnAlgFun M one μ hone hμ hc ha hu where
  app U := CommRingCat.ofHom (R := Γ(Z, U.unop.toOpens))
    (S := wcCnAlgObj M one μ hc ha hu U.unop)
    (wcCnMulUnit (one U.unop.toOpens U.unop.2) (μ U.unop.toOpens U.unop.2)
      (hc U.unop.toOpens U.unop.2) (ha U.unop.toOpens U.unop.2) (hu U.unop.toOpens U.unop.2))
  naturality U V g := by
    have key : ∀ r : Γ(Z, U.unop.toOpens),
        M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono (leOfHom g.unop))).op
            (r • one U.unop.toOpens U.unop.2) =
          (Z.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono (leOfHom g.unop))).op
            r) • one V.unop.toOpens V.unop.2 := by
      intro r
      rw [Scheme.Modules.map_smul, hone _ _ U.unop.2 V.unop.2]
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    exact (key r).symm

noncomputable def wcCnAlgEquiv {Z : Scheme.{u}} (M : Z.Modules)
    (one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U))
    (μ : ∀ U : Z.Opens, IsAffineOpen U → MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U))
    (hone : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
      M.presheaf.map (homOfLE hle).op (one U hU) = one U' hU')
    (hμ : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Fin 2 → Γ(M, U)),
      M.presheaf.map (homOfLE hle).op (μ U hU x) =
        μ U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i)))
    (hc : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)), μ U hU ![x, y] = μ U hU ![y, x])
    (ha : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]])
    (hu : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x)
    (U : Z.AffineZariskiSite) :
    Γ(M, U.toOpens) ≃+ (wcCnAlgFun M one μ hone hμ hc ha hu).obj (Opposite.op U) where
  toFun x := x
  invFun x := x
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
def wcCnCechT {R : Type u} [CommRing R] {r : ℕ} (A : Fin r → Type u) [∀ i, CommRing (A i)]
    [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)]
    [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j)
    (L : Type u) [AddCommGroup L] [Module R L] : Submodule R (∀ i, TensorProduct R (A i) L) where
  carrier := {τ | ∀ i j, LinearMap.rTensor L (ρl i j).toLinearMap (τ i) =
    LinearMap.rTensor L (ρr i j).toLinearMap (τ j)}
  add_mem' := by
    intro a b ha hb i j
    simp only [Pi.add_apply, map_add]
    rw [ha i j, hb i j]
  zero_mem' := by
    intro i j
    simp only [Pi.zero_apply, map_zero]
  smul_mem' := by
    intro c a ha i j
    simp only [Pi.smul_apply, map_smul]
    rw [ha i j]

def wcCnLimMod {R : Type u} [CommRing R] (N : ℕ → Type u) [∀ n, AddCommGroup (N n)]
    [∀ n, Module R (N n)] (ψ : ∀ n, N (n + 1) →ₗ[R] N n) : Submodule R (∀ n, N n) where
  carrier := {x | ∀ n, ψ n (x (n + 1)) = x n}
  add_mem' := by
    intro a b ha hb n
    simp only [Pi.add_apply, map_add]
    rw [ha n, hb n]
  zero_mem' := by
    intro n
    simp only [Pi.zero_apply, map_zero]
  smul_mem' := by
    intro c a ha n
    simp only [Pi.smul_apply, map_smul]
    rw [ha n]

def wcCnChartCompat {Z P : Scheme.{u}} (p : P ⟶ Z) (V : Z.Opens) {r : ℕ} (W : Fin r → P.Opens)
    (hW : ∀ i, W i ≤ p ⁻¹ᵁ V) [∀ i, Algebra Γ(Z, V) Γ(P, W i)]
    [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)]
    (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j))
    (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)) : Prop :=
  (∀ i, IsAffineOpen (W i)) ∧ (∀ x ∈ p ⁻¹ᵁ V, ∃ i, x ∈ W i) ∧ (∀ i j, IsAffineOpen (W i ⊓ W j)) ∧
  (∀ i (a : Γ(Z, V)), algebraMap Γ(Z, V) Γ(P, W i) a = (p.appLE V (W i) (hW i)).hom a) ∧
  (∀ i j (a : Γ(Z, V)), algebraMap Γ(Z, V) Γ(P, W i ⊓ W j) a =
    (p.appLE V (W i ⊓ W j) (le_trans inf_le_left (hW i))).hom a) ∧
  (∀ i j (a : Γ(P, W i)),
    ρl i j a = (P.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom a) ∧
  (∀ i j (a : Γ(P, W j)),
    ρr i j a = (P.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom a)
noncomputable def wcGalRes {X' E : Scheme.{u}} (e' : E ⟶ X') (M : Type (u+1)) [AddCommGroup M]
    {T T'' : X'.Etale} (c : T'' ⟶ T) :
    LocallyConstant ((wcEtBaseChange e').obj T).left M →+
      LocallyConstant ((wcEtBaseChange e').obj T'').left M :=
  ((wcLCPb e' M).map c.op).hom

noncomputable def wcGalDescSub {X' E : Scheme.{u}} (e' : E ⟶ X') (S : Set X') (H : Type u)
    [Group H] (β : H →* Aut E) (hβ : ∀ x, (β x).hom ≫ e' = e') (M : Type (u+1))
    [AddCommGroup M] (act : H →* AddMonoid.End M) (K : AddSubgroup M) (T : X'.Etale) :
    AddSubgroup (LocallyConstant ((wcEtBaseChange e').obj T).left M) where
  carrier := {f | ∀ (T'' : X'.Etale) (c : T'' ⟶ T),
    (∀ y, wcGalRes e' M c f y ∈ K) ∧
    (∀ (x : H) (y : ((wcEtBaseChange e').obj T'').left),
      wcGalRes e' M c f (wcPbρ e' e' (β x).hom (hβ x) T'' y) = act x (wcGalRes e' M c f y)) ∧
    (wcGalRes e' M c f = 0 ∨ ∀ t, T''.hom t ∈ S)}
  zero_mem' := by
    intro T'' c
    rw [map_zero]
    refine ⟨fun y => ?_, fun x y => ?_, Or.inl rfl⟩
    · rw [LocallyConstant.coe_zero, Pi.zero_apply]
      exact K.zero_mem
    · rw [LocallyConstant.coe_zero, Pi.zero_apply, Pi.zero_apply]
      exact (map_zero (act x)).symm
  add_mem' := by
    intro f g hf hg T'' c
    obtain ⟨hf1, hf2, hf3⟩ := hf T'' c
    obtain ⟨hg1, hg2, hg3⟩ := hg T'' c
    rw [map_add]
    refine ⟨fun y => ?_, fun x y => ?_, ?_⟩
    · rw [LocallyConstant.coe_add, Pi.add_apply]
      exact K.add_mem (hf1 y) (hg1 y)
    · rw [LocallyConstant.coe_add, Pi.add_apply, Pi.add_apply, hf2, hg2, map_add]
    · rcases hf3 with h1 | h1
      · rcases hg3 with h2 | h2
        · exact Or.inl (by rw [h1, h2, add_zero])
        · exact Or.inr h2
      · exact Or.inr h1
  neg_mem' := by
    intro f hf T'' c
    obtain ⟨hf1, hf2, hf3⟩ := hf T'' c
    rw [map_neg]
    refine ⟨fun y => ?_, fun x y => ?_, ?_⟩
    · rw [LocallyConstant.coe_neg, Pi.neg_apply]
      exact K.neg_mem (hf1 y)
    · rw [LocallyConstant.coe_neg, Pi.neg_apply, Pi.neg_apply, hf2, map_neg]
    · rcases hf3 with h1 | h1
      · exact Or.inl (by rw [h1, neg_zero])
      · exact Or.inr h1

noncomputable def wcGalDescPre {X' E : Scheme.{u}} (e' : E ⟶ X') (S : Set X') (H : Type u)
    [Group H] (β : H →* Aut E) (hβ : ∀ x, (β x).hom ≫ e' = e') (M : Type (u+1))
    [AddCommGroup M] (act : H →* AddMonoid.End M) (K : AddSubgroup M) :
    (X'.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} where
  obj T := AddCommGrpCat.of (wcGalDescSub e' S H β hβ M act K T.unop)
  map {T T'} c := AddCommGrpCat.ofHom
    (((wcGalRes e' M c.unop).comp (wcGalDescSub e' S H β hβ M act K T.unop).subtype).codRestrict
      (wcGalDescSub e' S H β hβ M act K T'.unop) (fun f => by
        intro T'' c''
        have e : wcGalRes e' M c'' (wcGalRes e' M c.unop f.1) =
            wcGalRes e' M (c'' ≫ c.unop) f.1 := by
          show ((wcLCPb e' M).map c''.op).hom (((wcLCPb e' M).map c.unop.op).hom f.1) =
            ((wcLCPb e' M).map (c'' ≫ c.unop).op).hom f.1
          rw [op_comp, CategoryTheory.Functor.map_comp]
          rfl
        simp only [AddMonoidHom.comp_apply, AddSubgroup.coe_subtype]
        rw [e]
        exact f.2 T'' (c'' ≫ c.unop)))
  map_id T := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro f
    apply Subtype.ext
    show ((wcLCPb e' M).map (𝟙 T.unop).op).hom f.1 = f.1
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  map_comp {T T' T''} c c' := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro f
    apply Subtype.ext
    show ((wcLCPb e' M).map (c.unop.op ≫ c'.unop.op)).hom f.1 =
      ((wcLCPb e' M).map c'.unop.op).hom (((wcLCPb e' M).map c.unop.op).hom f.1)
    rw [CategoryTheory.Functor.map_comp]
    rfl

noncomputable def wcGalDesc {X' E : Scheme.{u}} (e' : E ⟶ X') (S : Set X') (H : Type u)
    [Group H] (β : H →* Aut E) (hβ : ∀ x, (β x).hom ≫ e' = e') (M : Type (u+1))
    [AddCommGroup M] (act : H →* AddMonoid.End M) (K : AddSubgroup M) :
    Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} :=
  (presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
    (wcGalDescPre e' S H β hβ M act K)
noncomputable def wcElkDelta {R : Type*} [CommRing R] {n m s : ℕ}
    (F : Fin m → MvPolynomial (Fin n) R) (E : Fin s → Fin m) (ι : Fin s → Fin n) :
    MvPolynomial (Fin n) R :=
  (Matrix.of fun i j : Fin s => MvPolynomial.pderiv (ι i) (F (E j))).det

noncomputable def wcElkEq1 {R : Type*} [CommRing R] {n m : ℕ} (π : R)
    (F : Fin m → MvPolynomial (Fin n) R) (l : Fin m) : MvPolynomial (Fin (n + m)) R :=
  MvPolynomial.rename (Fin.castAdd m) (F l) -
    MvPolynomial.C (π ^ 4) * MvPolynomial.X (Fin.natAdd n l)

noncomputable def wcElkP {R : Type*} [CommRing R] {n m s : ℕ} (π : R)
    (A : MvPolynomial (Fin n) R) (E : Fin s → Fin m) (H : Fin m → Fin s → MvPolynomial (Fin n) R)
    (G : Fin m → MvPolynomial (Fin n) R) (l : Fin m) : MvPolynomial (Fin (n + m)) R :=
  MvPolynomial.rename (Fin.castAdd m) A * MvPolynomial.X (Fin.natAdd n l) -
    ∑ j, MvPolynomial.rename (Fin.castAdd m) (H l j) * MvPolynomial.X (Fin.natAdd n (E j)) -
    MvPolynomial.C (π ^ 4) * MvPolynomial.rename (Fin.castAdd m) (G l)

noncomputable def wcElkIdeal {R : Type*} [CommRing R] {n m r : ℕ} (π : R)
    (F : Fin m → MvPolynomial (Fin n) R) (s : Fin r → ℕ) (E : ∀ k, Fin (s k) → Fin m)
    (ι : ∀ k, Fin (s k) → Fin n) (U : Fin r → MvPolynomial (Fin n) R)
    (H : ∀ k, Fin m → Fin (s k) → MvPolynomial (Fin n) R)
    (G : Fin r → Fin m → MvPolynomial (Fin n) R) : Ideal (MvPolynomial (Fin (n + m)) R) :=
  Ideal.span (Set.range (wcElkEq1 π F) ∪
    Set.range (fun kl : Fin r × Fin m =>
      wcElkP π (U kl.1 * wcElkDelta F (E kl.1) (ι kl.1)) (E kl.1) (H kl.1) (G kl.1) kl.2))
def wcCnFfAR0 {R : Type u} [CommRing R] (𝔞 : Ideal R) {r : ℕ} (A : Fin r → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u)
    [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j)
    (ρr : ∀ i j, A j →ₐ[R] A2 i j) (L : Type u) [AddCommGroup L] [Module R L] (c : ℕ) : Prop :=
  ∀ n : ℕ, ∀ τ ∈ wcCnCechT A A2 ρl ρr L,
    (∀ i, τ i ∈ 𝔞 ^ (n + c) • (⊤ : Submodule R (TensorProduct R (A i) L))) →
    τ ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr L

def wcCnFfAR1 {R : Type u} [CommRing R] (𝔞 : Ideal R) {r : ℕ} (A : Fin r → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u)
    [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j)
    (ρr : ∀ i j, A j →ₐ[R] A2 i j) (L : Type u) [AddCommGroup L] [Module R L] (c : ℕ) : Prop :=
  ∀ (n : ℕ) (ω : ∀ i, TensorProduct R (A i) L),
    (∀ i j, LinearMap.rTensor L (ρl i j).toLinearMap (ω i) -
        LinearMap.rTensor L (ρr i j).toLinearMap (ω j) ∈
      𝔞 ^ (n + c) • (⊤ : Submodule R (TensorProduct R (A2 i j) L))) →
    ∃ w : ∀ i, TensorProduct R (A i) L,
      (∀ i, w i ∈ 𝔞 ^ n • (⊤ : Submodule R (TensorProduct R (A i) L))) ∧
      ω - w ∈ wcCnCechT A A2 ρl ρr L

def wcCnFfHaus {R : Type u} [CommRing R] (𝔞 : Ideal R) {r : ℕ} (A : Fin r → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u)
    [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j)
    (ρr : ∀ i j, A j →ₐ[R] A2 i j) (L : Type u) [AddCommGroup L] [Module R L] : Prop :=
  ∀ τ ∈ wcCnCechT A A2 ρl ρr L, (∀ n : ℕ, τ ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr L) → τ = 0

def wcCnFfCompl {R : Type u} [CommRing R] (𝔞 : Ideal R) {r : ℕ} (A : Fin r → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u)
    [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j)
    (ρr : ∀ i j, A j →ₐ[R] A2 i j) (L : Type u) [AddCommGroup L] [Module R L] : Prop :=
  ∀ u : ℕ → (∀ i, TensorProduct R (A i) L), (∀ n, u n ∈ wcCnCechT A A2 ρl ρr L) →
    (∀ n : ℕ, u (n + 1) - u n ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr L) →
    ∃ t ∈ wcCnCechT A A2 ρl ρr L, ∀ n : ℕ, t - u n ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr L

def wcCnFfGen {R : Type u} [CommRing R] {r : ℕ} (A : Fin r → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u)
    [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j)
    (ρr : ∀ i j, A j →ₐ[R] A2 i j) (S : Type u) [CommRing S] [Algebra R S] : Prop :=
  ∃ (k : ℕ) (y : Fin k → ∀ i, TensorProduct R (A i) S), (∀ l, y l ∈ wcCnCechT A A2 ρl ρr S) ∧
    ∀ τ ∈ wcCnCechT A A2 ρl ρr S, ∃ s : Fin k → S,
      τ = ∑ l, (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R (s l)) (y l i) :
        ∀ i, TensorProduct R (A i) S)

def wcCnFfHC {R : Type u} [CommRing R] (𝔞 : Ideal R) (S : Type u) [CommRing S] [Algebra R S] :
    Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M],
    Module.Finite S M →
    (∀ x : M, (∀ n : ℕ, x ∈ 𝔞 ^ n • (⊤ : Submodule R M)) → x = 0) ∧
    ∀ u : ℕ → M, (∀ n : ℕ, u (n + 1) - u n ∈ 𝔞 ^ n • (⊤ : Submodule R M)) →
      ∃ t : M, ∀ n : ℕ, t - u n ∈ 𝔞 ^ n • (⊤ : Submodule R M)
def wcfdTnLocNormal (N : Type u) [CommRing N] : Prop :=
  ∀ (P : Ideal N) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)
abbrev wcfdPnpIdx (R : Type*) [CommRing R] : Type _ :=
  {P : PrimeSpectrum R // P.asIdeal ∈ minimalPrimes R}

abbrev wcfdPnpTot (R : Type*) [CommRing R] : Type _ :=
  (P : wcfdPnpIdx R) → Localization.AtPrime P.1.asIdeal
noncomputable def wcGeomPointMap (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    wcGeomPoint F X hX ⟶ (wcProEtPullback p.left).obj (wcGeomPoint F Y hY) :=
  MorphismProperty.Over.homMk
    (Limits.pullback.lift
      (Limits.pullback.lift
        (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          p.left)
        (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (by rw [Category.assoc, Over.w p, Limits.pullback.condition]))
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.lift_fst _ _ _) :
      Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
        Limits.pullback (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left)
    (by
      change Limits.pullback.lift _ _ _ ≫ Limits.pullback.snd _ _ = _
      exact Limits.pullback.lift_snd _ _ _) trivial

noncomputable def wcSliceBC (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    Over (wcGeomPoint F Y hY) ⥤ Over (wcGeomPoint F X hX) :=
  Over.post (wcProEtPullback p.left) ⋙ Over.pullback (wcGeomPointMap F p hX hY)

noncomputable def wcSliceProj (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (V : Over (wcGeomPoint F Y hY)) : ((wcSliceBC F p hX hY).obj V).left.left ⟶ V.left.left :=
  (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom
      (wcGeomPointMap F p hX hY)).left ≫
    (Limits.pullback.fst V.left.hom p.left : Limits.pullback V.left.hom p.left ⟶ V.left.left)

noncomputable def wcSliceRingMap (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcSliceBC F p hX hY).IsContinuous ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))] :
    wcSliceRing F Y hY ℓ ⟶ ((wcSliceBC F p hX hY).sheafPushforwardContinuous RingCat.{u+1}
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))).obj (wcSliceRing F X hX ℓ) :=
  ObjectProperty.homMk
    { app := fun V => RingCat.ofHom (ContinuousMap.compRightAlgHom ℤ (ULift.{u+1} ℚ_[ℓ])
          (wcSliceProj F p hX hY V.unop).base.hom).toRingHom
      naturality := fun V V' k => by
        have h1 : ((wcSliceBC F p hX hY).map k.unop).left ≫
            Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V.unop).hom
              (wcGeomPointMap F p hX hY) =
            Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V'.unop).hom
              (wcGeomPointMap F p hX hY) ≫ (wcProEtPullback p.left).map k.unop.left :=
          Limits.pullback.lift_fst _ _ _
        have h2 : ((wcSliceBC F p hX hY).map k.unop).left.left ≫
            (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V.unop).hom
              (wcGeomPointMap F p hX hY)).left =
            (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V'.unop).hom
              (wcGeomPointMap F p hX hY)).left ≫ ((wcProEtPullback p.left).map k.unop.left).left :=
          congrArg (fun f => f.left) h1
        have h3 : ((wcProEtPullback p.left).map k.unop.left).left ≫
            (Limits.pullback.fst V.unop.left.hom p.left : Limits.pullback V.unop.left.hom p.left ⟶ _) =
            (Limits.pullback.fst V'.unop.left.hom p.left :
              Limits.pullback V'.unop.left.hom p.left ⟶ _) ≫ k.unop.left.left :=
          Limits.pullback.lift_fst _ _ _
        have key : wcSliceProj F p hX hY V'.unop ≫ k.unop.left.left =
            ((wcSliceBC F p hX hY).map k.unop).left.left ≫ wcSliceProj F p hX hY V.unop :=
          (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) h3.symm).trans
            (((Category.assoc _ _ _).symm.trans (congrArg (fun g => g ≫ _) h2.symm)).trans
              (Category.assoc _ _ _)))
        apply RingCat.hom_ext
        apply RingHom.ext
        intro s
        let s' : C(↥(Opposite.unop V).left.left, ULift.{u+1} ℚ_[ℓ]) := s
        apply ContinuousMap.ext
        intro x
        exact congrArg (fun f => s' (f.base x)) key }

def wcModPullOK (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] : Prop :=
  ∃ _ : (wcSliceBC F p hX hY).IsContinuous ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)),
    ∃ _ : (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).IsRightAdjoint,
      (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).Additive ∧
      Limits.PreservesFiniteLimits (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)) ∧
      Limits.PreservesFiniteColimits (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)) ∧
      IsIso (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)) ∧
      ∀ c : ℚ_[ℓ], (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).map
          (wcModConst F Y hY ℓ c) ≫
          SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ) =
        SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ) ≫ wcModConst F X hX ℓ c

noncomputable def wcModPull (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) : wcModCoh F Y hY ℓ n →+ wcModCoh F X hX ℓ n := by
  classical
  exact if hP : wcModPullOK F p hX hY ℓ then
    haveI := hP.fst
    haveI := hP.snd.fst
    haveI := hP.snd.snd.1
    haveI := hP.snd.snd.2.1
    haveI := hP.snd.snd.2.2.1
    haveI := hP.snd.snd.2.2.2.1
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F Y hY ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X hX ℓ)) := HasExt.standard _
    AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀
        (inv (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)) x).comp
          (Abelian.Ext.mk₀ (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))
          (add_zero n)) (zero_add n))
      (fun a b => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add])
  else 0

noncomputable def wcFrobRingMap (F : Type u) [Field F] [Finite F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcSliceRing F X h ℓ ⟶ ((Over.map (wcGeomFrob F X h)).sheafPushforwardContinuous RingCat.{u+1}
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))).obj (wcSliceRing F X h ℓ) :=
  𝟙 (wcSliceRing F X h ℓ)

noncomputable def wcModFrob (F : Type u) [Field F] [Finite F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) : wcModCoh F X h ℓ n →+ wcModCoh F X h ℓ n := by
  classical
  exact if hΨ : (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)).Additive ∧
      Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)) ∧
      Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)) then
    haveI := hΨ.1
    haveI := hΨ.2.1
    haveI := hΨ.2.2
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
    AddMonoidHom.mk' (fun x => (Abelian.Ext.mapExactFunctor
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)) x : wcModCoh F X h ℓ n))
      (fun a b => Abelian.Ext.mapExactFunctor_add _ _ _ _ _ _)
  else 0

noncomputable def wcProdPr1 (F : Type u) [Field F] (Y₁ Y₂ : Over (Spec (.of F))) :
    Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom) ⟶ Y₁ :=
  Over.homMk (Limits.pullback.fst Y₁.hom Y₂.hom) rfl

noncomputable def wcProdPr2 (F : Type u) [Field F] (Y₁ Y₂ : Over (Spec (.of F))) :
    Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom) ⟶ Y₂ :=
  Over.homMk (Limits.pullback.snd Y₁.hom Y₂.hom) Limits.pullback.condition.symm
noncomputable def wcR2Graph {B B'' : Scheme.{u}} (π : B'' ⟶ B) (V : B.Etale) (e : V.left ⟶ B'')
    (heπ : e ≫ π = V.hom) {T : B.Etale} (g : T ⟶ V) : T.left ⟶ ((wcEtBaseChange π).obj T).left :=
  (Limits.pullback.lift (f := T.hom) (g := π) (𝟙 T.left) (g.left ≫ e)
    (by rw [Category.id_comp, Category.assoc, heπ, MorphismProperty.Over.w g]) :
    T.left ⟶ Limits.pullback T.hom π)

noncomputable def wcR2FreeMap {B : Scheme.{u}} (V : B.Etale) (G : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (s : G.obj (Opposite.op V)) : wcFTKU V ⟶ G where
  app T := AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun g : ULift.{u+1} (T.unop ⟶ V) =>
    (G.map g.down.op).hom s))
  naturality T T' c := by
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro g
    simp only [wcFTKU, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp,
      Function.comp_apply, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of]
    rw [op_comp, Functor.map_comp]
    rfl

def wcR2GraphInd {B B'' : Scheme.{u}} (π : B'' ⟶ B) (V : B.Etale) (e : V.left ⟶ B'')
    (heπ : e ≫ π = V.hom) (S : Set B'') (ℓ : ℕ)
    (γ0 : (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj V))) : Prop :=
  ∀ (T : B.Etale) (g : T ⟶ V) (W : B''.Etale) (h : W ⟶ (wcEtBaseChange π).obj T),
    (Set.range h.left ⊆ Set.range (wcR2Graph π V e heπ g) →
      ∃ y : (wcEtExtZeroPre B'' S ℓ).obj (Opposite.op W), y.1 = ULift.up 1 ∧
        ((wcEtExtZero B'' S ℓ).obj.map h.op).hom
            (((wcEtExtZero B'' S ℓ).obj.map ((wcEtBaseChange π).map g).op).hom γ0) =
          ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
            (Opposite.op W)).hom y) ∧
    (Set.range h.left ⊆ (Set.range (wcR2Graph π V e heπ g))ᶜ →
      ((wcEtExtZero B'' S ℓ).obj.map h.op).hom
          (((wcEtExtZero B'' S ℓ).obj.map ((wcEtBaseChange π).map g).op).hom γ0) = 0)
noncomputable def wcSuppObj {X Y : Scheme.{u}} {i : X ⟶ Y} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) :=
  (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
    (SheafOfModules.unit (wcRingSheaf X ℓ))

noncomputable def wcSuppUnitMap {X Y : Scheme.{u}} {i : X ⟶ Y} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ wcSuppObj D :=
  D.adj.unit.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map D.μ.hom

noncomputable abbrev wcSuppExt {X Y : Scheme.{u}} {i : X ⟶ Y} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (n : ℕ) :=
  @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) _ _ (HasExt.standard _)
    (wcSuppObj D) (SheafOfModules.unit (wcRingSheaf Y ℓ)) n

noncomputable def wcSuppClass {X Y : Scheme.{u}} {i : X ⟶ Y} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (n : ℕ) (θ : wcSuppExt D n) : wcHM Y ℓ n :=
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  (Abelian.Ext.mk₀ (wcSuppUnitMap D)).comp θ (zero_add n)
structure wcPreDatum (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) where
  Yt : Over (Spec (.of F''))
  gi : GeometricallyIrreducible Yt.hom
  proper : IsProper Yt.hom
  smooth : SmoothOfRelativeDimension n Yt.hom
  b : Yt.left ⟶ Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' F'')))
  hb : b ≫ Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' F''))) = Yt.hom
  bsurj : Surjective b
  bfin : ∃ V : (Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' F'')))).Opens,
    V ≠ ⊥ ∧ IsFinite (b ∣_ V)
  f : Yt.left ⟶ (wcP1Over F'').left
  hf : f ≫ (wcP1Over F'').hom = Yt.hom
  fconn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ (wcP1Over F'').left),
    ConnectedSpace ↥(Limits.pullback f t)
  m : ℕ
  S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)
  hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _
  hSinj : Function.Injective (fun i => S i (IsLocalRing.closedPoint F''))
  xs : Fin m → (Spec (.of F'') ⟶ Yt.left)
  hxs : ∀ i, xs i ≫ f = S i
  smooth_off : ∀ y : Yt.left, (∀ i, y ≠ xs i (IsLocalRing.closedPoint F'')) →
    ∃ U : Yt.left.Opens, y ∈ U ∧ Smooth (U.ι ≫ f)
  odp : ∀ i : Fin m,
    ∃ (t : Fin n → Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F'')))
      (τ : (wcP1Over F'').left.presheaf.stalk (f (xs i (IsLocalRing.closedPoint F''))))
      (A : Matrix (Fin n) (Fin n) (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F'')))),
      IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F''))) =
          Ideal.span (Set.range t) ∧
        IsLocalRing.maximalIdeal
            ((wcP1Over F'').left.presheaf.stalk (f (xs i (IsLocalRing.closedPoint F'')))) =
          Ideal.span {τ} ∧
        (f.stalkMap (xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
          IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint F''))) ^ 3 ∧
        IsUnit (A + A.transpose).det
  M : ℕ
  jt : Yt.left ⟶ @Proj _ _ _ _ _
    (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) F'') MvPolynomial.gradedAlgebra
  hjt : IsClosedImmersion jt
  hjtY : jt ≫ @Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) F'') MvPolynomial.gradedAlgebra ≫
    Spec.map (CommRingCat.ofHom (algebraMap F''
      ↥(MvPolynomial.homogeneousSubmodule (Fin (M + 1)) F'' 0))) = Yt.hom
structure wcPureTraceData (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q β r : ℕ) where
  np : ℕ → ℕ
  hnp : ∀ e : ℕ, 1 ≤ e → ∑ d ∈ e.divisors, d * np d ≤ q ^ e + 1
  loc : (d : ℕ) → Fin (np d) → Multiset (AlgebraicClosure ℚ_[ℓ])
  hcard : ∀ d x, Multiset.card (loc d x) = r
  hrat : ∀ d x (m : ℕ), ∃ c : ℚ,
    ((loc d x).map (· ^ m)).sum = algebraMap ℚ (AlgebraicClosure ℚ_[ℓ]) c
  hzero : ∀ d x, (0 : AlgebraicClosure ℚ_[ℓ]) ∉ loc d x
  hsymp : ∀ d x, (loc d x).map (fun γ => (q : AlgebraicClosure ℚ_[ℓ]) ^ (β * d) / γ) = loc d x
  tensor : ∀ k : ℕ, 1 ≤ k → ∃ (N : ℕ) (Hk : Multiset (AlgebraicClosure ℚ_[ℓ])), ∀ e : ℕ, 1 ≤ e →
    ∑ d ∈ e.divisors, ∑ x : Fin (np d),
        (d : AlgebraicClosure ℚ_[ℓ]) * ((loc d x).map (· ^ (e / d))).sum ^ (2 * k) =
      (N : AlgebraicClosure ℚ_[ℓ]) * (q : AlgebraicClosure ℚ_[ℓ]) ^ (e * (k * β + 1)) -
        (Hk.map (· ^ e)).sum
  H : Multiset (AlgebraicClosure ℚ_[ℓ])
  hH : ∀ e : ℕ, 1 ≤ e →
    ∑ d ∈ e.divisors, ∑ x : Fin (np d),
        (d : AlgebraicClosure ℚ_[ℓ]) * ((loc d x).map (· ^ (e / d))).sum =
      -(H.map (· ^ e)).sum
def wcpaDjSemistable {C P : Scheme.{u}} (g : C ⟶ P) : Prop :=
  Flat g ∧ IsProper g ∧
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ P) (w : ↥(Limits.pullback g s)),
    (∃ W : (Limits.pullback g s).Opens, w ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g s)) ∨
    (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk w))
        ((Limits.pullback g s).presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      (e.toRingHom.comp ((algebraMap ((Limits.pullback g s).presheaf.stalk w)
        (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g s).presheaf.stalk w))
          ((Limits.pullback g s).presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g s).appTop ≫
          (Limits.pullback g s).presheaf.germ ⊤ w trivial).hom)) =
      (Ideal.Quotient.mk _).comp MvPowerSeries.C)
def wcPencilGC (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) : Prop :=
  ∃ r : ℕ, Nonempty (G.over (wcGeomPoint K (wcP1Over K) hP) ≅
    (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP))

def wcPencilStable {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (M : Subobject (wcRq D.f ℓ (n - 1))) : Prop :=
  ∀ c : ℚ_[ℓ], ∃ ψ : Subobject.underlying.obj M ⟶ Subobject.underlying.obj M,
    ψ ≫ M.arrow = M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c

noncomputable def wcPencilC {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    Subobject (wcRq D.f ℓ (n - 1)) := by
  classical
  exact if h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
      wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) ∧
      ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
        wcPencilGC F'' hP ℓ (Subobject.underlying.obj M') → M' ≤ M
    then Classical.choose h else ⊤

noncomputable def wcPencilE {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    Subobject (wcRq D.f ℓ (n - 1)) := by
  classical
  exact if h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
      wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
      ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
        wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    then Classical.choose h else ⊤

noncomputable def wcPencilVQ {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1} :=
  Limits.cokernel (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
    inf_le_left)

noncomputable def wcPencilVQScalar {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (c : ℚ_[ℓ]) : wcPencilVQ D ℓ hP ⟶ wcPencilVQ D ℓ hP := by
  classical
  exact if h : ∃ (ψ : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilE D ℓ hP))
      (φ : wcPencilVQ D ℓ hP ⟶ wcPencilVQ D ℓ hP),
      ψ ≫ (wcPencilE D ℓ hP).arrow = (wcPencilE D ℓ hP).arrow ≫ wcRqScalar D.f ℓ (n - 1) c ∧
      Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
        inf_le_left) ≫ φ =
        ψ ≫ Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left)
    then Classical.choose (Classical.choose_spec h) else 0
def wcpaDjZarNCSet (Y : Scheme.{u}) (B : Set Y) : Prop :=
  IsClosed B ∧ ∀ y : Y, ∃ (n : ℕ) (t : Fin n → Y.presheaf.stalk y),
    (n : WithBot ℕ∞) = ringKrullDim (Y.presheaf.stalk y) ∧
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) ∧
    ∃ J : Finset (Fin n), ∀ (y' : Y) (h : y' ⤳ y),
      (y' ∈ B ↔ ∃ j ∈ J, (Y.presheaf.stalkSpecializes h).hom (t j) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk y'))
noncomputable def wcSuppPullExt {X Y Y' : Scheme.{u}} {i : X ⟶ Y} {f : Y' ⟶ Y} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (D : wcHMPullData i ℓ) (Df : wcHMPullData f ℓ) (n : ℕ)
    (θ : wcSuppExt D n) :
    @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) _ _ (HasExt.standard _)
      (Df.Φ.obj (wcSuppObj D)) (SheafOfModules.unit (wcRingSheaf Y' ℓ)) n :=
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  (Abelian.Ext.mapExactFunctor Df.Φ θ).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)
noncomputable def wcLdpSec (E : Type u) [Field E] (N : ℕ)
    (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (a : Fin (N + 1)) :
    Γ(wcProjK E N, wcSgD E N a) :=
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E))
  (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)).hom
    (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E a)) 2
      (G : MvPolynomial (Fin (N + 1)) E) G.2)

noncomputable def wcLdpGerm (E : Type u) [Field E] (N : ℕ) {X : Scheme.{u}} (ι : X ⟶ wcProjK E N)
    (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (a : Fin (N + 1)) (x : X)
    (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a) : X.presheaf.stalk x :=
  (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom ((ι.app (wcSgD E N a)).hom (wcLdpSec E N G a))

def wcLdpOnAxis (E : Type u) [Field E] (N : ℕ) {X : Scheme.{u}} (ι : X ⟶ wcProjK E N)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (x : X) : Prop :=
  ∀ (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
    wcLdpGerm E N ι G₀ a x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
    wcLdpGerm E N ι G₁ a x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)

def wcLdpZero (K : Type u) [Field K] (N : ℕ) {X : Scheme.{u}} (κ : X ⟶ wcProjK K N)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (x : X) : Prop :=
  ∀ (a : Fin (N + 1)) (hx : x ∈ κ ⁻¹ᵁ wcSgD K N a),
    wcLdpGerm K N κ H a x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)

noncomputable def wcLdpConst (E : Type u) [Field E] {X : Scheme.{u}} (s : X ⟶ Spec (.of E))
    (x : X) : E →+* X.presheaf.stalk x :=
  (X.presheaf.germ ⊤ x trivial).hom.comp
    (s.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom)

def wcLdpSubmersive (E : Type u) [Field E] {X : Scheme.{u}} (s : X ⟶ Spec (.of E)) (x : X)
    (g₀ g₁ : X.presheaf.stalk x) : Prop :=
  letI := (wcLdpConst E s x).toAlgebra
  g₀ • KaehlerDifferential.D E (X.presheaf.stalk x) g₁ -
      g₁ • KaehlerDifferential.D E (X.presheaf.stalk x) g₀ ∉
    (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) •
      (⊤ : Submodule (X.presheaf.stalk x) (KaehlerDifferential E (X.presheaf.stalk x)))

def wcLdpGoodPencil (E : Type u) [Field E] (N n : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (m : ℕ) (y : Fin m → (Spec (.of E) ⟶ X.left)) (c : Fin m → Fin 2 → E) : Prop :=
  (∃ x : X.left, ¬ wcLdpOnAxis E N ι G₀ G₁ x) ∧
  (∀ (x : X.left) (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a), wcLdpOnAxis E N ι G₀ G₁ x →
    ∃ (k : ℕ) (t : Fin k → X.left.presheaf.stalk x),
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) =
        Ideal.span (insert (wcLdpGerm E N ι G₀ a x hx)
          (insert (wcLdpGerm E N ι G₁ a x hx) (Set.range t))) ∧
      ((k + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim (X.left.presheaf.stalk x)) ∧
  (∀ i, y i ≫ X.hom = 𝟙 _) ∧
  (∀ i, ¬ wcLdpOnAxis E N ι G₀ G₁ (y i (IsLocalRing.closedPoint E))) ∧
  (∀ i, c i ≠ 0) ∧
  (∀ i i', i ≠ i' → c i 0 * c i' 1 - c i 1 * c i' 0 ≠ 0) ∧
  (∀ (x : X.left) (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
    ¬ wcLdpOnAxis E N ι G₀ G₁ x → (∀ i, x ≠ y i (IsLocalRing.closedPoint E)) →
    wcLdpSubmersive E X.hom x (wcLdpGerm E N ι G₀ a x hx) (wcLdpGerm E N ι G₁ a x hx)) ∧
  (∀ (i : Fin m) (a : Fin (N + 1))
    (hx : y i (IsLocalRing.closedPoint E) ∈ ι ⁻¹ᵁ wcSgD E N a),
    ∃ (t : Fin n → X.left.presheaf.stalk (y i (IsLocalRing.closedPoint E)))
      (A : Matrix (Fin n) (Fin n) (X.left.presheaf.stalk (y i (IsLocalRing.closedPoint E)))),
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk (y i (IsLocalRing.closedPoint E))) =
          Ideal.span (Set.range t) ∧
        wcLdpGerm E N ι (c i 1 • G₀ - c i 0 • G₁) a (y i (IsLocalRing.closedPoint E)) hx -
            ∑ k, ∑ l, A k l * t k * t l ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk (y i (IsLocalRing.closedPoint E))) ^ 3 ∧
        IsUnit (A + A.transpose).det)

def wcLdpIncLocal (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1)) : Prop :=
  ∀ (z : Yt.left) (a : Fin (N + 1))
    (ha : Limits.pullback.fst X.hom (wcProjKStr E 1) (g z) ∈ ι ⁻¹ᵁ wcSgD E N a)
    (e : Fin 2) (he : Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) ∈ wcSgD E 1 e),
    Function.Surjective (g.stalkMap z).hom ∧
    RingHom.ker (g.stalkMap z).hom = Ideal.span {
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a _ ha) -
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (((wcProjK E 1).presheaf.germ (wcSgD E 1 e) _ he).hom (wcSgE E 1 e (e + 1))) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] e) a _ ha)}
def wcpaDjSmIn (k : Type u) [Field k] {X P : Scheme.{u}} (sP : P ⟶ Spec (.of k)) (f : X ⟶ P)
    (U : P.Opens) {n : ℕ} (σ : Fin n → (P ⟶ X)) : Prop :=
  wcpaDjIsProjOver k (f ≫ sP) ∧ wcpaDjIsProjOver k sP ∧ U ≠ ⊥ ∧
  SmoothOfRelativeDimension 1 (f ∣_ U) ∧ GeometricallyConnected (f ∣_ U) ∧ 3 ≤ n ∧
  (∀ i, σ i ≫ f = 𝟙 P) ∧ (∀ (i j : Fin n) (p : P), p ∈ U → i ≠ j → σ i p ≠ σ j p)


def wcpaDjMarkedAlt (k : Type u) [Field k] {X P X' P' : Scheme.{u}} (sP : P ⟶ Spec (.of k))
    (f : X ⟶ P) (U : P.Opens) {n : ℕ} (σ : Fin n → (P ⟶ X)) (sP' : P' ⟶ Spec (.of k))
    (f' : X' ⟶ P') (U' : P'.Opens) {m : ℕ} (σ' : Fin m → (P' ⟶ X')) (β : P' ⟶ P)
    (α : X' ⟶ X) : Prop :=
  β ≫ sP = sP' ∧ IsProper β ∧ Surjective β ∧ (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) ∧
  α ≫ f = f' ≫ β ∧ IsProper α ∧ Surjective α ∧ (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α ∣_ V)) ∧
  wcpaDjSmIn k sP' f' U' σ' ∧
  ⇑α ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f ⁻¹' ((U : Set P)ᶜ)) ⊆
    (⋃ j, Set.range ⇑(σ' j)) ∪ ⇑f' ⁻¹' ((U' : Set P')ᶜ)


def wcpaDjSmOut (k : Type u) [Field k] {X₂ P₁ : Scheme.{u}} (sP₁ : P₁ ⟶ Spec (.of k))
    (f₂ : X₂ ⟶ P₁) (U₁ : P₁.Opens) {n : ℕ} (σ : Fin n → (P₁ ⟶ X₂)) : Prop :=
  ∃ (P' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P') (sP' : P' ⟶ Spec (.of k))
    (β₂ : P' ⟶ P₁),
    β₂ ≫ sP₁ = sP' ∧ wcpaDjIsProjOver k sP' ∧ IsProper β₂ ∧ Surjective β₂ ∧
    (∃ V : P₁.Opens, V ≠ ⊥ ∧ IsFinite (β₂ ∣_ V)) ∧
    ∃ (C : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C) (g : C ⟶ P') (h₂ : C ⟶ X₂),
      h₂ ≫ f₂ = g ≫ β₂ ∧ wcpaDjIsProjOver k (g ≫ sP') ∧ wcpaDjSemistable g ∧
      IsProper h₂ ∧ Surjective h₂ ∧ (∃ V : X₂.Opens, V ≠ ⊥ ∧ IsFinite (h₂ ∣_ V)) ∧
      ∃ (U' : P'.Opens) (m : ℕ) (τ : Fin m → (P' ⟶ C)),
        U' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (g ∣_ U') ∧ GeometricallyConnected (g ∣_ U') ∧
        wcpaDjSections g m τ ∧
        ⇑h₂ ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f₂ ⁻¹' ((U₁ : Set P₁)ᶜ)) ⊆
          (⋃ i, Set.range ⇑(τ i)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ)


def wcpaDjGeomReducedFibres {X P : Scheme.{u}} (f : X ⟶ P) : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ P),
    AlgebraicGeometry.IsReduced (Limits.pullback f s)


def wcpaDjThreePoint {X P : Scheme.{u}} (f : X ⟶ P) {n : ℕ} (σ : Fin n → (P ⟶ X)) : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ P)
    (G : Set ↥(Limits.pullback f s)), G ∈ irreducibleComponents ↥(Limits.pullback f s) →
    ∃ e : Fin 3 → Fin n, Function.Injective (fun t => σ (e t) (s (IsLocalRing.closedPoint K))) ∧
      ∀ t, ∃ w ∈ G, Limits.pullback.fst f s w = σ (e t) (s (IsLocalRing.closedPoint K)) ∧
        ∃ W : (Limits.pullback f s).Opens, w ∈ W ∧
          SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd f s)


def wcpaDjStableModel (k : Type u) [Field k] {X P : Scheme.{u}} (sP : P ⟶ Spec (.of k))
    (f : X ⟶ P) (U : P.Opens) {n : ℕ} (σ : Fin n → (P ⟶ X)) : Prop :=
  ∃ (P'' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P'') (sP'' : P'' ⟶ Spec (.of k))
    (β' : P'' ⟶ P) (C' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C') (g' : C' ⟶ P'')
    (τ : Fin n → (P'' ⟶ C')) (U'' : P''.Opens) (ψ₀ : (g' ⁻¹ᵁ U'').toScheme ⟶ X),
    β' ≫ sP = sP'' ∧ wcpaDjIsProjOver k sP'' ∧ IsProper β' ∧ Surjective β' ∧
    (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β' ∣_ V)) ∧
    wcpaDjIsProjOver k (g' ≫ sP'') ∧ wcpaDjSemistable g' ∧ wcpaDjSections g' n τ ∧
    U'' ≠ ⊥ ∧ U'' ≤ β' ⁻¹ᵁ U ∧ SmoothOfRelativeDimension 1 (g' ∣_ U'') ∧
    GeometricallyConnected (g' ∣_ U'') ∧
    IsPullback ψ₀ (g' ∣_ U'') f (U''.ι ≫ β') ∧
    ∀ (c : (g' ⁻¹ᵁ U'').toScheme) (i : Fin n),
      ψ₀ c = σ i (β' (g' ((g' ⁻¹ᵁ U'').ι c))) ↔ (g' ⁻¹ᵁ U'').ι c = τ i (g' ((g' ⁻¹ᵁ U'').ι c))
