def wcpaDjLaChart (k : Type u) [Field k] {S Z : Scheme.{u}} (sS : S ⟶ Spec (.of k)) (uu : Z ⟶ S)
    (L : wcpaDjCoc Z) (N₁ : S.Opens) (M : ℕ)
    (σ' : Fin (M + 1) → ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ N₁))
    (φ : (uu ⁻¹ᵁ N₁).toScheme ⟶ wcProjK k M) : Prop :=
  φ ≫ wcProjKStr k M = (uu ∣_ N₁) ≫ N₁.ι ≫ sS ∧
  (∀ J, φ ⁻¹ᵁ wcSgD k M J = (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (⨆ a, Z.basicOpen (σ' J a))) ∧
  ∀ (J l : Fin (M + 1)) (a : Fin L.m) (O : (uu ⁻¹ᵁ N₁).toScheme.Opens)
    (hO : O ≤ φ ⁻¹ᵁ wcSgD k M J) (h' : O ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ (L.V a ⊓ uu ⁻¹ᵁ N₁)),
    O ≤ (uu ⁻¹ᵁ N₁).ι ⁻¹ᵁ Z.basicOpen (σ' J a) →
    (φ.appLE (wcSgD k M J) O hO).hom (wcSgE k M J l) *
      ((uu ⁻¹ᵁ N₁).ι.appLE (L.V a ⊓ uu ⁻¹ᵁ N₁) O h').hom (σ' J a) =
      ((uu ⁻¹ᵁ N₁).ι.appLE (L.V a ⊓ uu ⁻¹ᵁ N₁) O h').hom (σ' l a)

def wcpaDjLaSep {S Z : Scheme.{u}} (uu : Z ⟶ S) (y : S) (L : wcpaDjCoc Z) (M : ℕ)
    (τ : Fin (M + 1) → ∀ a : Fin L.m, Γ(Limits.pullback uu (S.fromSpecResidueField y),
        (wcpaDjCocPull (Limits.pullback.fst uu (S.fromSpecResidueField y)) L).V a ⊓
          Limits.pullback.snd uu (S.fromSpecResidueField y) ⁻¹ᵁ ⊤))
    (N₀ : S.Opens)
    (hN₀ : ⊤ ≤ (Limits.pullback.snd uu (S.fromSpecResidueField y) ≫ S.fromSpecResidueField y) ⁻¹ᵁ N₀) :
    Prop :=
  ∀ (J : Fin (M + 1)) (w w' : ↥(Limits.pullback uu (S.fromSpecResidueField y))), w ≠ w' →
    w ∈ (⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a)) →
    w' ∈ (⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a)) →
    ∃ (Pol : MvPolynomial (Fin (M + 1)) Γ(S, N₀))
      (h : Γ(Limits.pullback uu (S.fromSpecResidueField y),
        ⨆ a, (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a))),
      (∀ a, ∃ inv : Γ(Limits.pullback uu (S.fromSpecResidueField y),
          (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a)),
        inv * ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le (τ J a))).op).hom
            (τ J a) = 1 ∧
        ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
          (homOfLE (le_iSup (fun a' => (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen
            (τ J a')) a)).op).hom h =
          MvPolynomial.eval₂
            (((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
              (homOfLE (le_top : (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen (τ J a) ≤
                ⊤)).op).hom.comp
              ((Limits.pullback.snd uu (S.fromSpecResidueField y) ≫
                S.fromSpecResidueField y).appLE N₀ ⊤ hN₀).hom)
            (fun l => ((Limits.pullback uu (S.fromSpecResidueField y)).presheaf.map
              (homOfLE ((Limits.pullback uu (S.fromSpecResidueField y)).basicOpen_le
                (τ J a))).op).hom (τ l a) * inv) Pol) ∧
      ¬ (w ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen h ↔
        w' ∈ (Limits.pullback uu (S.fromSpecResidueField y)).basicOpen h)
def wcpaDjCompatMod {X : Scheme.{u}} {B : Type u} [CommRing B] (h : X ⟶ Spec (.of B))
    (L : wcpaDjCoc X) (I : Ideal B) (d : ℕ) (x : ∀ a : Fin L.m, Γ(X, L.V a)) : Prop :=
  ∀ a b,
    (X.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (x b) -
      (L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ d *
      (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (x a) ∈
    Ideal.map (wcCnSigma h (L.V a ⊓ L.V b)) I
noncomputable def wcSmsTheta (ℓ n : ℕ) {Γ : Type u} [Group Γ] [Fintype Γ] {r p q : ℕ}
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (b : Fin q ≃ Fin p × Fin r)
    (w : Fin q → ZMod (ℓ ^ n)) (j : Fin r) : Fin p → MonoidAlgebra (ZMod (ℓ ^ n)) Γ :=
  fun a => ∑ h : Γ, MonoidAlgebra.single h
    (∑ i : Fin r, w (b.symm (a, i)) *
      ((ρ h⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j)

noncomputable def wcStiFwd (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ] [Fintype Γ]
    {r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (P : wcGModel ℓ Γ) (Q : wcLnModel (ZMod (ℓ ^ n)))
    (k : ℕ) (b : Fin (Q.k k) ≃ Fin (P.k k) × Fin r) (j : Fin r) :
    (wcLnModelAb.{u+1} Q).X k ⟶ (wcSmsBar P n).X k :=
  AddCommGrpCat.ofHom (wcULiftHom (AddMonoidHom.mk'
    (fun w : wcIdemSub (Q.ε k) => (⟨Matrix.vecMul (wcSmsTheta ℓ n ρ b w.1 j)
        ((P.ε k).map (wcSmsRed ℓ n Γ)), by
      show Matrix.vecMul (Matrix.vecMul _ _) _ = _
      rw [Matrix.vecMul_vecMul, ← Matrix.map_mul, P.hε k]⟩ :
        wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ))))
    (fun w w' => Subtype.ext (by
      show Matrix.vecMul (wcSmsTheta ℓ n ρ b (w.1 + w'.1) j) ((P.ε k).map (wcSmsRed ℓ n Γ)) =
        Matrix.vecMul (wcSmsTheta ℓ n ρ b w.1 j) ((P.ε k).map (wcSmsRed ℓ n Γ)) +
        Matrix.vecMul (wcSmsTheta ℓ n ρ b w'.1 j) ((P.ε k).map (wcSmsRed ℓ n Γ))
      rw [← Matrix.add_vecMul]
      congr 1
      funext a
      apply MonoidAlgebra.ext
      ext g
      simp [wcSmsTheta, MonoidAlgebra.coeff_sum, Finsupp.single_apply, add_mul,
        Finset.sum_add_distrib]))))

noncomputable def wcStiBwd (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ]
    {r : ℕ} (P : wcGModel ℓ Γ) (Q : wcLnModel (ZMod (ℓ ^ n)))
    (k : ℕ) (b : Fin (Q.k k) ≃ Fin (P.k k) × Fin r) (i : Fin r) :
    (wcSmsBar P n).X k ⟶ (wcLnModelAb.{u+1} Q).X k :=
  AddCommGrpCat.ofHom (wcULiftHom (AddMonoidHom.mk'
    (fun v : wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ)) => (⟨Matrix.vecMul
        (fun x => if (b x).2 = i then (v.1 (b x).1).coeff 1 else 0) (Q.ε k), by
      show Matrix.vecMul (Matrix.vecMul _ _) _ = _
      rw [Matrix.vecMul_vecMul, Q.hε k]⟩ : wcIdemSub (Q.ε k)))
    (fun v v' => Subtype.ext (by
      show Matrix.vecMul (fun x => if (b x).2 = i then ((v + v').1 (b x).1).coeff 1 else 0) (Q.ε k) =
        Matrix.vecMul (fun x => if (b x).2 = i then (v.1 (b x).1).coeff 1 else 0) (Q.ε k) +
        Matrix.vecMul (fun x => if (b x).2 = i then (v'.1 (b x).1).coeff 1 else 0) (Q.ε k)
      rw [← Matrix.add_vecMul]
      congr 1
      funext x
      simp only [Pi.add_apply, AddSubgroup.coe_add]
      split_ifs <;> simp [MonoidAlgebra.coeff_add]))))

noncomputable def wcStiVP {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ] (P : wcGModel ℓ Γ)
    (n k : ℕ) : (wcSmsBar P n).X k →+ (Fin (P.k k) → MonoidAlgebra (ZMod (ℓ ^ n)) Γ) :=
  (wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ))).subtype.comp AddEquiv.ulift.toAddMonoidHom

noncomputable def wcStiVQ.{v} {Λ : Type} [CommRing Λ] (Q : wcLnModel Λ) (k : ℕ) :
    (wcLnModelAb.{v} Q).X k →+ (Fin (Q.k k) → Λ) :=
  (wcIdemSub (Q.ε k)).subtype.comp AddEquiv.ulift.toAddMonoidHom
def wcpaClPinch {R : Type u} [CommRing R] {Zt Z : Scheme.{u}} (ut : Zt ⟶ Spec (.of R))
    (uu : Z ⟶ Spec (.of R)) (m : ℕ) (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (π : Zt ⟶ Z)
    (O U : Zt.Opens) (V O' : Z.Opens) : Prop :=
  π ≫ uu = ut ∧ (∀ a, σ a ≫ ut = 𝟙 _) ∧
  (∀ e, σ (e, 0) ≫ π = σ (e, 1) ≫ π) ∧
  (∀ x : Zt, x ∈ O ↔ ∀ a, x ∉ Set.range (σ a)) ∧
  IsAffineOpen U ∧ IsAffineOpen V ∧ (∀ a, Set.range (σ a) ⊆ (U : Set Zt)) ∧
  V ⊔ O' = ⊤ ∧
  (∃ hO : π ⁻¹ᵁ O' = O, IsIso (π.resLE O' O hO.ge)) ∧
  (∃ hU : π ⁻¹ᵁ V = U, Function.Injective (π.appLE V U hU.ge).hom ∧
    ∀ g : Γ(Zt, U), (∃ f, (π.appLE V U hU.ge).hom f = g) ↔
      ∀ e (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ U) (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ U),
        ((σ (e, 0)).appLE U ⊤ h₀).hom g = ((σ (e, 1)).appLE U ⊤ h₁).hom g)
noncomputable def wcSpfBarL {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (A : 𝒜)
    (lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ) :
    wcSpfBar A lam ρ p ⟶ wcSpfBar A lam ρ (p + 1) :=
  Limits.Pi.lift (fun fj : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r =>
    Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A) (fun i => fj.1 i.succ, fj.2) ≫
      lam (MonoidAlgebra.single ((Fintype.equivFin Γ).symm (fj.1 0)) 1))

noncomputable def wcSpfBarM {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (A : 𝒜)
    (lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ)
    (k : Fin p) : wcSpfBar A lam ρ p ⟶ wcSpfBar A lam ρ (p + 1) :=
  Limits.Pi.lift (fun fj : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r =>
    Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A) (wcSpfMerge Γ fj.1 k, fj.2))

noncomputable def wcSpfBarR {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (A : 𝒜)
    (lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ) :
    wcSpfBar A lam ρ p ⟶ wcSpfBar A lam ρ (p + 1) :=
  Limits.Pi.lift (fun fj : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r =>
    ∑ i : Fin r, wcSpfRhoEnt ρ (fj.1 (Fin.last p)) i fj.2 •
      Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => A) (fun l => fj.1 l.castSucc, i))
def wcpaDjCocSec {C : Scheme.{u}} {K : Type u} [Field K] (q : C ⟶ Spec (.of K))
    (L : wcpaDjCoc C) (e : ℕ) (s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)) : Prop :=
  ∀ a b,
    (C.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V b ⊓ q ⁻¹ᵁ ⊤ from
        le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (s b) =
      (C.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V a ⊓ L.V b from
        inf_le_left)).op).hom ((L.g a b : Γ(C, L.V a ⊓ L.V b)) ^ e) *
      (C.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V a ⊓ q ⁻¹ᵁ ⊤ from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (s a)

noncomputable def wcpaDjLinComb {C : Scheme.{u}} (K : Type u) [Field K] (q : C ⟶ Spec (.of K))
    (L : wcpaDjCoc C) {M : ℕ} (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤))
    (c : Fin (M + 1) → K) (a : Fin L.m) : Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤) :=
  ∑ l, wcpaDjKConst K q _ (c l) * t l a
noncomputable def wcSpfModBarD {Γ : Type u} [Group Γ] [Fintype Γ] {ℓ n r : ℕ} {M : Type*}
    [AddCommGroup M] (act : Γ → (M →+ M)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ)
    (u : (Fin p → Fin (Fintype.card Γ)) × Fin r → M) :
    (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r → M :=
  fun fj => act ((Fintype.equivFin Γ).symm (fj.1 0)) (u (fun i => fj.1 i.succ, fj.2)) +
    ∑ k : Fin p, ((-1 : ℤ) ^ ((k : ℕ) + 1)) • u (wcSpfMerge Γ fj.1 k, fj.2) +
    ((-1 : ℤ) ^ (p + 1)) • ∑ i : Fin r, wcSpfRhoEnt ρ (fj.1 (Fin.last p)) i fj.2 •
      u (fun l => fj.1 l.castSucc, i)
def wcpaSvTwV {Y : Scheme.{u}} {N : ℕ} (O : Fin N → Y.Opens) (z : ∀ ν μ, Γ(Y, O ν ⊓ O μ))
    (G : Y.Modules) : Prop :=
  ∀ c : ∀ ν μ, Γ(G, O ν ⊓ O μ),
    (∀ ν μ l,
      (G.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O ν ⊓ O l from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c ν l) =
        (G.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O μ ⊓ O l from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (c μ l) +
        (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O μ ⊓ O l from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (z μ l) •
        (G.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O ν ⊓ O μ from inf_le_left)).op).hom
          (c ν μ)) →
    ∃ b : ∀ ν, Γ(G, O ν), ∀ ν μ,
      c ν μ = (G.presheaf.map (homOfLE (show O ν ⊓ O μ ≤ O μ from inf_le_right)).op).hom (b μ) -
        z ν μ • (G.presheaf.map (homOfLE (show O ν ⊓ O μ ≤ O ν from inf_le_left)).op).hom (b ν)
noncomputable def wcSpfQPre {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ n : ℕ) :
    (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  wcExtZeroPre ((wcPbFun q).op ⋙ continuousMapPresheafAb.{0, u} (ZMod (ℓ ^ n)) ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u})
    (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
