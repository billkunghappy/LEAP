def wcIdemSub {R : Type*} [Ring R] {a : ℕ} (ε : Matrix (Fin a) (Fin a) R) :
    AddSubgroup (Fin a → R) where
  carrier := {v | Matrix.vecMul v ε = v}
  add_mem' {v w} hv hw := by
    show Matrix.vecMul (v + w) ε = v + w
    rw [Matrix.add_vecMul, hv, hw]
  zero_mem' := Matrix.zero_vecMul ε
  neg_mem' {v} hv := by
    show Matrix.vecMul (-v) ε = -v
    rw [Matrix.neg_vecMul, hv]

def wcVecMulHom {R : Type*} [Ring R] {a b : ℕ} (εa : Matrix (Fin a) (Fin a) R)
    (εb : Matrix (Fin b) (Fin b) R) (M : Matrix (Fin a) (Fin b) R) (hM : M * εb = M) :
    wcIdemSub εa →+ wcIdemSub εb where
  toFun v := ⟨Matrix.vecMul v.1 M, by
    show Matrix.vecMul (Matrix.vecMul v.1 M) εb = _
    rw [Matrix.vecMul_vecMul, hM]⟩
  map_zero' := Subtype.ext (Matrix.zero_vecMul M)
  map_add' v w := Subtype.ext (Matrix.add_vecMul M v.1 w.1)

def wcSmulHom {R : Type*} [Ring R] {a : ℕ} (c : R) (ε : Matrix (Fin a) (Fin a) R) :
    wcIdemSub ε →+ wcIdemSub ε where
  toFun v := ⟨c • v.1, by
    show Matrix.vecMul (c • v.1) ε = c • v.1
    rw [Matrix.smul_vecMul, v.2]⟩
  map_zero' := Subtype.ext (smul_zero c)
  map_add' v w := Subtype.ext (smul_add c v.1 w.1)

def wcULiftHom {A B : Type*} [AddCommGroup A] [AddCommGroup B] (f : A →+ B) :
    ULift.{w} A →+ ULift.{w} B :=
  AddEquiv.ulift.symm.toAddMonoidHom.comp (f.comp AddEquiv.ulift.toAddMonoidHom)

structure wcGModel (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] where
  k : ℕ → ℕ
  hk : ∀ i, 3 ≤ i → k i = 0
  ε : ∀ i, Matrix (Fin (k i)) (Fin (k i)) (MonoidAlgebra ℤ_[ℓ] Γ)
  hε : ∀ i, ε i * ε i = ε i
  δ : ∀ i, Matrix (Fin (k i)) (Fin (k (i + 1))) (MonoidAlgebra ℤ_[ℓ] Γ)
  hδδ : ∀ i, δ i * δ (i + 1) = 0
  hεδ : ∀ i, ε i * δ i = δ i
  hδε : ∀ i, δ i * ε (i + 1) = δ i
  f : ∀ i, Matrix (Fin (k i)) (Fin (k i)) (MonoidAlgebra ℤ_[ℓ] Γ)
  hεf : ∀ i, ε i * f i = f i
  hfε : ∀ i, f i * ε i = f i
  hδf : ∀ i, δ i * f (i + 1) = f i * δ i

noncomputable def wcGModelAb {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
    (P : wcGModel ℓ Γ) : CochainComplex AddCommGrpCat.{u+1} ℕ :=
  CochainComplex.of (fun i => AddCommGrpCat.of (ULift.{u+1} (wcIdemSub (P.ε i))))
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (P.ε i) (P.ε (i + 1)) (P.δ i) (P.hδε i))))
    (fun i => by
      refine AddCommGrpCat.ext (fun x => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, Matrix.vecMul_vecMul, P.hδδ] <;> rfl)

noncomputable def wcGModelFrob {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
    (P : wcGModel ℓ Γ) : wcGModelAb P ⟶ wcGModelAb P :=
  CochainComplex.ofHom (X := wcGModelAb P) (Y := wcGModelAb P)
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (P.ε i) (P.ε i) (P.f i) (P.hfε i))))
    (fun i => by
      dsimp only [wcGModelAb]
      rw [CochainComplex.of_d]
      refine AddCommGrpCat.ext (fun x => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, Matrix.vecMul_vecMul, P.hδf])

noncomputable def wcGModelAct {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
    (P : wcGModel ℓ Γ) (γ : Γ) : wcGModelAb P ⟶ wcGModelAb P :=
  CochainComplex.ofHom (X := wcGModelAb P) (Y := wcGModelAb P)
    (fun i => AddCommGrpCat.ofHom (wcULiftHom (wcSmulHom (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]))
      (P.ε i))))
    (fun i => by
      dsimp only [wcGModelAb]
      rw [CochainComplex.of_d]
      refine AddCommGrpCat.ext (fun x => ULift.ext _ _ (Subtype.ext ?_))
      simp [wcULiftHom, wcVecMulHom, wcSmulHom, Matrix.smul_vecMul])

noncomputable def wcGModelHS {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ]
    (P : wcGModel ℓ Γ) (e : ℕ) (g : Γ) : ℤ_[ℓ] :=
  ∑ i ∈ Finset.range 3, (-1 : ℤ_[ℓ]) ^ i * ∑ j : Fin (P.k i), ((P.f i ^ e) j j).coeff g

noncomputable def wcGModelTr {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ] [Fintype Γ]
    (P : wcGModel ℓ Γ) (e : ℕ) (γ : Γ) : ℤ_[ℓ] :=
  ∑ i ∈ Finset.range 3, (-1 : ℤ_[ℓ]) ^ i * ∑ j : Fin (P.k i), ∑ τ : Γ,
    (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) * MonoidAlgebra.single τ 1 * (P.f i ^ e) j j).coeff τ

def wcIsModel (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (Z : Set (wcP1Over K).left) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {V : Scheme.{u}}
    (q : V ⟶ (wcP1Over K).left) (Γ : Type u) [Group Γ] (α : Γ →* Aut V)
    (hα : ∀ γ, (α γ).hom ≫ q = q) (P : wcGModel ℓ Γ) : Prop :=
  ∃ Ψ : wcGModelAb P ⟶ wcCx K hP (wcCoverSheaf q Z ℓ),
    QuasiIso Ψ ∧ Nonempty (Homotopy (Ψ ≫ wcCxFrob K hP (wcCoverSheaf q Z ℓ)) (wcGModelFrob P ≫ Ψ)) ∧
    ∀ γ : Γ, Nonempty (Homotopy (Ψ ≫ wcCxMap K hP (wcCoverAct q Z ℓ (α γ).hom (hα γ)))
      (wcGModelAct P γ ≫ Ψ))

