    (ι : X.left ⟶ wcProjK E N) (p : Fin (N + 1) × Fin 2) :
    (Limits.pullback X.hom (wcProjKStr E 1)).Opens :=
  Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N p.1) ⊓
