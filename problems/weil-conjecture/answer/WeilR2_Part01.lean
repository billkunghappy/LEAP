          Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.sub_comp,
          Preadditive.comp_sub, Preadditive.sum_comp, Preadditive.comp_sum,
          Preadditive.nsmul_comp, Preadditive.comp_nsmul, HomologicalComplex.Hom.comm]))
    (fun k => by
      have h0 : ∀ {K0 K1 K2 P0 P1 P2 : 𝒜} (ι0 : K0 ⟶ P0) (ι1 : K1 ⟶ P1) (ι2 : K2 ⟶ P2)
          (p0 : P0 ⟶ P1) (p1 : P1 ⟶ P2) (a : K0 ⟶ K1) (b : K1 ⟶ K2),
          a ≫ ι1 = ι0 ≫ p0 → b ≫ ι2 = ι1 ≫ p1 → p0 ≫ p1 = 0 → Mono ι2 → a ≫ b = 0 := by
        intro K0 K1 K2 P0 P1 P2 ι0 ι1 ι2 p0 p1 a b ha hb hp _
        refine (cancel_mono ι2).1 ?_
        rw [Category.assoc, hb, ← Category.assoc, ha, Category.assoc, hp, Limits.comp_zero,
          Limits.zero_comp]
      refine h0 _ _ _ _ _ _ _ (Limits.kernel.lift_ι _ _ _) (Limits.kernel.lift_ι _ _ _) ?_
        Limits.equalizer.ι_mono
      apply Limits.Pi.hom_ext
