noncomputable def wcHMFun (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : C(↥S, ULift.{u+1} ℚ_[ℓ])) :
    SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ) :=
  (SheafOfModules.unitHomEquiv _).symm
    (PresheafOfModules.sectionsMk (M := (SheafOfModules.unit (wcRingSheaf S ℓ)).val)
      (fun V => (r.comp (Opposite.unop V).hom.base.hom :
        C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])))
      (fun V V' g => ContinuousMap.ext (fun x =>
        congrArg (fun k => r (k.base x)) (MorphismProperty.Over.w g.unop))))
noncomputable def wcEtSuppRestr {X Y Y' X' : Scheme.{u}} {i : X ⟶ Y} {f : Y' ⟶ Y} {i' : X' ⟶ Y'}
    {n : ℕ} (D : wcEtPullData i n) (Df : wcEtPullData f n) (D' : wcEtPullData i' n)
    (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)) (k : ℕ) :
    wcEtSuppExt D k →+ wcEtSuppExt D' k :=
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' n)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  ((Abelian.Ext.mk₀ γ).precomp (SheafOfModules.unit (wcEtZModRing Y' n)) (zero_add k)).comp
    (((Abelian.Ext.mk₀ Df.μ.hom).postcomp (Df.Φ.obj (wcEtSuppObj D)) (add_zero k)).comp
      (Df.Φ.mapExtAddHom (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Y n)) k))

def wcEtCutOut {W Z : Scheme.{u}} (i : Z ⟶ W) {c : ℕ} (h : Fin c → Γ(W, ⊤)) : Prop :=
  IsAffine W ∧ IsClosedImmersion i ∧ RingHom.ker i.appTop.hom = Ideal.span (Set.range h)

def wcEtGoodChart (K : Type u) [Field K] {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K))
    (i : Z ⟶ W) (c : ℕ) (h : Fin c → Γ(W, ⊤)) : Prop :=
  ∃ n : ℕ, c ≤ n ∧ SmoothOfRelativeDimension n fW ∧ SmoothOfRelativeDimension (n - c) (i ≫ fW) ∧
    wcEtCutOut i h

abbrev wcEtLocThom (K : Type u) [Field K] (ℓ : ℕ) :=
  ∀ {W Z : Scheme.{u}} (_ : W ⟶ Spec (.of K)) (i : Z ⟶ W) (D : wcEtPullData i ℓ) (c : ℕ),
    (Fin c → Γ(W, ⊤)) → wcEtSuppExt D (2 * c)

def wcEtThomGL {K : Type u} [Field K] {ℓ : ℕ} (T : wcEtLocThom K ℓ) : Prop :=
  ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) (D : wcEtPullData i ℓ) (c : ℕ)
    (h : Fin c → Γ(W, ⊤)) (A : Matrix (Fin c) (Fin c) Γ(W, ⊤)), IsUnit A.det →
    wcEtGoodChart K fW i c h → T fW i D c (A.mulVec h) = T fW i D c h

def wcEtThomNat {K : Type u} [Field K] {ℓ : ℕ} (T : wcEtLocThom K ℓ) : Prop :=
  ∀ {W Z W' Z' : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (fW' : W' ⟶ Spec (.of K)) (f : W' ⟶ W),
    f ≫ fW = fW' → ∀ (i : Z ⟶ W) (i' : Z' ⟶ W') (g : Z' ⟶ Z), IsPullback g i' i f →
    ∀ (D : wcEtPullData i ℓ) (Df : wcEtPullData f ℓ) (D' : wcEtPullData i' ℓ)
      (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)),
    wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) →
    ∀ (c : ℕ) (h : Fin c → Γ(W, ⊤)), wcEtGoodChart K fW i c h →
    wcEtGoodChart K fW' i' c (fun j => f.appTop.hom (h j)) →
    wcEtSuppRestr D Df D' γ (2 * c) (T fW i D c h) = T fW' i' D' c (fun j => f.appTop.hom (h j))

def wcEtThomPt {K : Type u} [Field K] {ℓ : ℕ} (T : wcEtLocThom K ℓ) : Prop :=
  ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) (D : wcEtPullData i ℓ) (c : ℕ)
    (h : Fin c → Γ(W, ⊤)), SmoothOfRelativeDimension c fW →
    SmoothOfRelativeDimension 0 (i ≫ fW) → wcEtCutOut i h → Nonempty Z → T fW i D c h ≠ 0

def wcEtIsThom {K : Type u} [Field K] {ℓ : ℕ} (T : wcEtLocThom K ℓ) {X Z : Scheme.{u}}
    (fX : X ⟶ Spec (.of K)) {i : Z ⟶ X} (D : wcEtPullData i ℓ) (c : ℕ)
    (θ : wcEtSuppExt D (2 * c)) : Prop :=
  ∀ (W : X.Opens) (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι →
    ∀ (DW : wcEtPullData iW ℓ) (EW : wcEtPullData W.ι ℓ)
      (γ : wcEtSuppObj DW ⟶ EW.Φ.obj (wcEtSuppObj D)),
    wcEtSuppUnitMap DW ≫ γ = EW.μ.inv ≫ EW.Φ.map (wcEtSuppUnitMap D) →
    ∀ h : Fin c → Γ(W, ⊤), wcEtCutOut iW h →
      wcEtSuppRestr D EW DW γ (2 * c) θ = T (W.ι ≫ fX) iW DW c h
noncomputable abbrev wcTpFree (S : Scheme.{u}) (W : S.ProEt) : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
  yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free

noncomputable abbrev wcTpFreeMap (S : Scheme.{u}) {W W' : S.ProEt} (f : W ⟶ W') :
    wcTpFree S W ⟶ wcTpFree S W' :=
  Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

noncomputable abbrev wcTpSh (S : Scheme.{u}) :
    ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
  presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
noncomputable def wcEtGlobalGerm {S : Scheme.{u}} (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (b : S) :
    G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 S))) → (wcEtStalk S b).obj G :=
  fun x => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt S b)) (Scheme.Etale.forget S)).op ⋙ G.obj)
    (Opposite.op (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 S)) (Over.homMk (wcEtGeomPt S b) (by simp))))).hom x
def wcEtSheetNorm {X Y' : Scheme.{u}} {p : Y' ⟶ X} {ℓ : ℕ} (Dp : wcEtPullData p ℓ)
    (τ : wcEtSuppObj Dp ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)) : Prop :=
  ∀ (V : X.Etale) (σ : V.left ⟶ Y') (hσ : σ ≫ p = V.hom)
    (e : (wcEtSuppObj Dp).val.obj (Opposite.op V)),
    (∀ (O : Y'.Etale) (w : O ⟶ (wcEtBaseChange p).obj V),
      Set.range w.left ⊆ Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ
        (by rw [Category.id_comp, hσ])) →
      @Eq ((wcEtZModRing Y' ℓ).obj.obj (Opposite.op O))
        (((SheafOfModules.unit (wcEtZModRing Y' ℓ)).val.map w.op).hom e) 1) →
    (∀ (O : Y'.Etale) (w : O ⟶ (wcEtBaseChange p).obj V),
      Disjoint (Set.range w.left) (Set.range (Limits.pullback.lift (f := V.hom) (g := p)
        (𝟙 V.left) σ (by rw [Category.id_comp, hσ]))) →
      @Eq ((wcEtZModRing Y' ℓ).obj.obj (Opposite.op O))
        (((SheafOfModules.unit (wcEtZModRing Y' ℓ)).val.map w.op).hom e) 0) →
    @Eq ((wcEtZModRing X ℓ).obj.obj (Opposite.op V)) ((τ.val.app (Opposite.op V)).hom e) 1

def wcEtLocalSheet (K : Type u) [Field K] {X Y' : Scheme.{u}} (p : Y' ⟶ X)
    (y₀' : Spec (.of K) ⟶ Y') (T : X.Etale) (t₀ : Spec (.of K) ⟶ T.left) (s : T.left ⟶ Y')
    (hs : s ≫ p = T.hom) : Prop :=
  t₀ ≫ T.hom = y₀' ≫ p ∧ t₀ ≫ s = y₀' ∧
    IsOpenImmersion (Limits.pullback.lift (f := T.hom) (g := p) (𝟙 T.left) s
      (by rw [Category.id_comp, hs])) ∧
    (∀ t : T.left, T.hom t = (y₀' ≫ p) (IsLocalRing.closedPoint K) →
      t = t₀ (IsLocalRing.closedPoint K)) ∧
    (∀ z : ↥(Limits.pullback T.hom p),
      Limits.pullback.snd T.hom p z = y₀' (IsLocalRing.closedPoint K) →
      z ∈ Set.range (Limits.pullback.lift (f := T.hom) (g := p) (𝟙 T.left) s
        (by rw [Category.id_comp, hs])))
noncomputable abbrev wcLinU (K : Type u) [Field K] (N e : ℕ)
    (ℓ : Fin (e + 1) → MvPolynomial (Fin (N + 1)) K) : (wcProjK K N).Opens :=
  ⨆ i : Fin (e + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
    MvPolynomial.gradedAlgebra (ℓ i)

def wcLinChart (K : Type u) [Field K] (N e : ℕ) (ℓ : Fin (e + 1) → MvPolynomial (Fin (N + 1)) K)
    (π : (wcLinU K N e ℓ : Scheme.{u}) ⟶ wcProjK K e) (i : Fin (e + 1))
    (hℓ : ∀ k, ℓ k ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) : Prop :=
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) := MvPolynomial.gradedAlgebra
  ∃ ρ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K)
      (MvPolynomial.X i) →+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ i),
    (∀ k : Fin (e + 1), ρ (HomogeneousLocalization.Away.mk _
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)) 1
        (MvPolynomial.X k)
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k))) =
      HomogeneousLocalization.Away.mk _ (hℓ i) 1 (ℓ k) (hℓ k)) ∧
    (∀ r : K, ρ (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K)
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap K _ r)) =
      HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (ℓ i)) (algebraMap K _ r)) ∧
    (Proj.basicOpenIsoSpec _ (ℓ i) (hℓ i) one_pos).inv ≫
        (wcProjK K N).homOfLE (le_iSup (fun k => Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ k)) i) ≫ π =
      Spec.map (CommRingCat.ofHom ρ) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) (MvPolynomial.X i)
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))
          one_pos
noncomputable abbrev wcHalA1 {K A : Type u} [Field K] [CommRing A]
    (s : Spec (.of A) ⟶ Spec (.of K)) : Scheme.{u} :=
  Limits.pullback s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))

noncomputable abbrev wcHalA1Proj {K A : Type u} [Field K] [CommRing A]
    (s : Spec (.of A) ⟶ Spec (.of K)) : wcHalA1 s ⟶ Spec (.of A) :=
  Limits.pullback.fst s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))

def wcHalShData {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
    (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y) : Prop :=
  W'.Initial ∧ (∀ l, IsAffine (W'.obj l).right.left) ∧
    (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W'.map t).right.left = φ l') ∧
    (∀ l, φ l ≫ (W'.obj l).right.hom = a) ∧
    (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W'.obj l).right.left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W'.map t).right.left = z l') →
      ∃! z₀ : T ⟶ Spec (.of B), ∀ l, z₀ ≫ φ l = z l) ∧
    ∃ e : IsLocalRing.ResidueField B →+* AlgebraicClosure (Y.residueField y), e.IsIntegral ∧
      Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a =
        wcEtGeomPt Y y
noncomputable abbrev wcEtSliceOf {S : Scheme.{u}} (V : Scheme.{u}) (s : V ⟶ S) (hsE : Etale s) : V.Etale ⥤ S.Etale :=
  wcEtSlice (MorphismProperty.Over.mk ⊤ s hsE)

def wcEtSheetExtZero {X Y' : Scheme.{u}} (p : Y' ⟶ X) {ℓ : ℕ} (Dp : wcEtPullData p ℓ) (T : X.Etale)
    (s : T.left ⟶ Y') (hs : s ≫ p = T.hom) (hsE : Etale s)
    (hcX : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X))
    (hcY : (wcEtSliceOf T.left s hsE).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y'))
    (ψX : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hcX).obj (wcEtZModRing X ℓ))
    (ψY : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSliceOf T.left s hsE) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y') hcY).obj (wcEtZModRing Y' ℓ))
    (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ))
    (f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY).obj N ⟶
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX).obj
        ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).obj N)) : Prop :=
  ∀ (U : T.left.Etale)
    (a : ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY).obj N).val.obj (Opposite.op U)),
    (∀ (O : Y'.Etale) (k : O ⟶ (wcEtSliceOf T.left s hsE).obj U)
        (w : O ⟶ (wcEtBaseChange p).obj ((wcEtSlice T).obj U)),
        w.left ≫ Limits.pullback.fst ((wcEtSlice T).obj U).hom p = k.left →
        (N.val.map w.op).hom ((f.val.app (Opposite.op U)).hom a) = (N.val.map k.op).hom a) ∧
    (∀ (O : Y'.Etale) (w : O ⟶ (wcEtBaseChange p).obj ((wcEtSlice T).obj U)),
        Disjoint (Set.range w.left) (Set.range (Limits.pullback.lift (f := ((wcEtSlice T).obj U).hom) (g := p)
          (𝟙 U.left) (U.hom ≫ s)
          (show 𝟙 U.left ≫ (U.hom ≫ T.hom) = (U.hom ≫ s) ≫ p by
            rw [Category.id_comp, Category.assoc, hs]))) →
        (N.val.map w.op).hom ((f.val.app (Opposite.op U)).hom a) = 0)
noncomputable def wcUnSec (K : Type u) [Field K] (N : ℕ) {Y' : Scheme.{u}} (j : Y' ⟶ wcProjK K N)
    (h : MvPolynomial (Fin (N + 1)) K) (O : Y'.Opens)
    (hO : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h) :
    HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h →+*
      Γ(Y', O) :=
  (Proj.awayToSection _ h ≫ j.appLE _ O hO).hom


noncomputable def wcUnK (K : Type u) [Field K] (N : ℕ) {Y' : Scheme.{u}} (j : Y' ⟶ wcProjK K N)
    (O : Y'.Opens) : K →+* Γ(Y', O) :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ wcProjKStr K N).appLE ⊤ O
    (le_top.trans_eq (Scheme.Hom.preimage_top _).symm)).hom


noncomputable def wcUnEv (K : Type u) [Field K] {Y' : Scheme.{u}} (y₁ : Spec (.of K) ⟶ Y')
    (O : Y'.Opens) (hO : y₁ (IsLocalRing.closedPoint K) ∈ O) : Γ(Y', O) →+* K :=
  (y₁.appLE O ⊤ (by
    intro x _
    show y₁ x ∈ O
    rw [Subsingleton.elim x (IsLocalRing.closedPoint K)]
    exact hO) ≫ (Scheme.ΓSpecIso (.of K)).hom).hom
noncomputable def wcAugConeX {D : Type*} [Category D] [Abelian D] (K L : CochainComplex D ℕ) :
    ℕ → D
  | 0 => K.X 0
  | m + 1 => K.X (m + 1) ⊞ L.X m

noncomputable def wcAugConeD0 {D : Type*} [Category D] [Abelian D] {K L : CochainComplex D ℕ}
    (α : K ⟶ L) : K.X 0 ⟶ K.X (0 + 1) ⊞ L.X 0 :=
  Limits.biprod.lift (-(K.d 0 (0 + 1))) (α.f 0)

noncomputable def wcAugConeDS {D : Type*} [Category D] [Abelian D] {K L : CochainComplex D ℕ}
    (α : K ⟶ L) (m : ℕ) : K.X (m + 1) ⊞ L.X m ⟶ K.X (m + 1 + 1) ⊞ L.X (m + 1) :=
  Limits.biprod.lift (-(Limits.biprod.fst ≫ K.d (m + 1) (m + 1 + 1)))
    (Limits.biprod.fst ≫ α.f (m + 1) + Limits.biprod.snd ≫ L.d m (m + 1))

noncomputable def wcAugConeD {D : Type*} [Category D] [Abelian D] {K L : CochainComplex D ℕ}
    (α : K ⟶ L) : ∀ n : ℕ, wcAugConeX K L n ⟶ wcAugConeX K L (n + 1)
  | 0 => wcAugConeD0 α
  | m + 1 => wcAugConeDS α m
