noncomputable def wcSliceSliceHom (S : Scheme.{u}) {W W' : S.ProEt} (t : W' ⟶ W) (O : W.left.Etale)
    (O' : W'.left.Etale) (h : O'.left ⟶ O.left) (hh : h ≫ O.hom = O'.hom ≫ t.left) :
    (wcSliceFunctor S W').obj ((wcEtToProEt W'.left).obj O') ⟶
      (wcSliceFunctor S W).obj ((wcEtToProEt W.left).obj O) :=
