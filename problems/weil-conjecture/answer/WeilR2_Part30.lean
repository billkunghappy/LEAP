theorem wcpa_dj_lr1s_nf_cnf_fmp_component_glue : ∀ (T A : Type u) [CommRing T] [CommRing A] [Algebra T A] (t : T), IsUnit (algebraMap T A t) → _root_.IsReduced A → IsNoetherianRing A → (∀ (M : Type u) [AddCommGroup M] [Module T M], Module.Finite T M → (∀ m : M, t • m = 0 → m = 0) → Module.FinitePresentation T M) → (∀ p ∈ minimalPrimes A, Module.Finite T ↥(integralClosure T (A ⧸ p))) → Module.Finite T ↥(integralClosure T A) :=
by
  intro T A _ _ _ t hu hred hnoeth hfp hc
  classical

  have hzero : ∀ x : A, (∀ p ∈ minimalPrimes A, x ∈ p) → x = 0 := by
    intro x hx
    have hmem : x ∈ sInf (minimalPrimes A) := Ideal.mem_sInf.mpr (fun p hp => hx p hp)
    have h2 : sInf (minimalPrimes A) = (⊥ : Ideal A).radical := Ideal.sInf_minimalPrimes
    rw [h2] at hmem
    obtain ⟨n, hn⟩ := hmem
    exact IsNilpotent.eq_zero ⟨n, Ideal.mem_bot.mp hn⟩
  have hfin : (minimalPrimes A).Finite := minimalPrimes.finite_of_isNoetherianRing A
  haveI : Finite ↥(minimalPrimes A) := hfin.to_subtype
  haveI : Fintype ↥(minimalPrimes A) := Fintype.ofFinite _

  have hdetect : ∀ a : A, (∀ i : ↥(minimalPrimes A),
      _root_.IsIntegral T (Ideal.Quotient.mk i.1 a)) → _root_.IsIntegral T a := by
    intro a ha
    choose g hgm hga using ha
    refine ⟨∏ i, g i, Polynomial.monic_prod_of_monic _ _ (fun i _ => hgm i), ?_⟩
    apply hzero
    intro p hp
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have e : Ideal.Quotient.mk p (Polynomial.eval₂ (algebraMap T A) a (∏ i, g i)) =
        Polynomial.aeval (Ideal.Quotient.mk p a) (∏ i, g i) := by
      rw [← Ideal.Quotient.mkₐ_eq_mk T, ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply]
    rw [e, map_prod]
    refine Finset.prod_eq_zero (Finset.mem_univ ⟨p, hp⟩) ?_
    rw [Polynomial.aeval_def]
    exact hga ⟨p, hp⟩

  have hker : ∀ (N Q : Type u) [AddCommGroup N] [Module T N] [AddCommGroup Q] [Module T Q],
      Module.Finite T N → ∀ (f : N →ₗ[T] Q) (R : Submodule T Q),
      (∀ x : Q, t • x ∈ R → x ∈ R) → (Submodule.comap f R).FG := by
    intro N Q _ _ _ _ hN f R hR
    let g := R.mkQ ∘ₗ f
    haveI : Module.Finite T (LinearMap.range g) := Module.Finite.range g
    have htf : ∀ m : LinearMap.range g, t • m = 0 → m = 0 := by
      intro m hm
      obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective R (m : Q ⧸ R)
      have h1 : t • (m : Q ⧸ R) = 0 := by
        have := congrArg (fun z : LinearMap.range g => (z : Q ⧸ R)) hm
        simpa using this
      rw [← hx, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at h1
      apply Subtype.ext
      rw [← hx, (Submodule.Quotient.mk_eq_zero R).mpr (hR x h1)]
      rfl
    haveI := hfp (LinearMap.range g) inferInstance htf
    have := Module.FinitePresentation.fg_ker g.rangeRestrict (LinearMap.surjective_rangeRestrict g)
    rwa [LinearMap.ker_rangeRestrict, LinearMap.ker_comp, Submodule.ker_mkQ] at this
  haveI hcf : ∀ i : ↥(minimalPrimes A), Module.Finite T (integralClosure T (A ⧸ i.1)) :=
    fun i => hc i.1 i.2
  let f : (∀ i : ↥(minimalPrimes A), integralClosure T (A ⧸ i.1)) →ₗ[T]
      (∀ i : ↥(minimalPrimes A), A ⧸ i.1) :=
    LinearMap.pi (fun i => (integralClosure T (A ⧸ i.1)).val.toLinearMap ∘ₗ LinearMap.proj i)
  let πL : A →ₗ[T] (∀ i : ↥(minimalPrimes A), A ⧸ i.1) :=
    LinearMap.pi (fun i => (Ideal.Quotient.mkₐ T i.1).toLinearMap)
  have hsat : ∀ x : (∀ i : ↥(minimalPrimes A), A ⧸ i.1), t • x ∈ LinearMap.range πL →
