  by_cases hx : x = 0
  · unfold wcRfAbs; simp [hx]
  by_cases hy : y = 0
  · unfold wcRfAbs; simp [hy]
  have hxy : x * y ≠ 0 := mul_ne_zero hx hy
  unfold wcRfAbs
  rw [if_neg hxy, if_neg hx, if_neg hy, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  congr 1
  change -(sSup (Q (x * y))) = -(sSup (Q x)) + -(sSup (Q y))
