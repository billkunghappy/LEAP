theorem wcpa_dj_p1rec_node_residue : ∀ (K A : Type u) [Field K] [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] (φ : K →+* A),
    (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
      (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
    Function.Surjective ((IsLocalRing.residue A).comp φ) :=
by
  intro K A _ _ _ _ φ ⟨e, he⟩ x
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
  obtain ⟨f, hf⟩ := Ideal.Quotient.mk_surjective
    (I := Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})
    (e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a))
  refine ⟨MvPowerSeries.constantCoeff f, ?_⟩
  have hc : e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (φ (MvPowerSeries.constantCoeff f))) =
      Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
        MvPowerSeries (Fin 2) K)}) (MvPowerSeries.C (MvPowerSeries.constantCoeff f)) := by
    have := RingHom.congr_fun he (MvPowerSeries.constantCoeff f)
    simpa using this
  show IsLocalRing.residue A (φ (MvPowerSeries.constantCoeff f)) = IsLocalRing.residue A a
  rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
  by_contra hn
  have hu : IsUnit (a - φ (MvPowerSeries.constantCoeff f)) :=
    IsLocalRing.notMem_maximalIdeal.mp hn
  have hu2 := (hu.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))).map e
  rw [map_sub, map_sub, ← hf, hc, ← map_sub] at hu2
  obtain ⟨v, hv⟩ := hu2.exists_right_inv
  obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective v
  rw [← map_mul, ← map_one (Ideal.Quotient.mk _), ← sub_eq_zero, ← map_sub,
    Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hv
  obtain ⟨s, hs⟩ := hv
  have h2 := congrArg MvPowerSeries.constantCoeff hs
  simp at h2

theorem wcpa_dj_p1rec_rational_closed : ∀ (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (y : C), Function.Surjective (wcpaDjFK K q y) →
    IsClosed ({y} : Set C) :=
by
  intro K _ C q y hsurj
  rw [← closure_subset_iff_isClosed]
  intro z hz
  have h : y ⤳ z := specializes_iff_mem_closure.mpr hz
  set φ : C.presheaf.stalk z →+* C.residueField y :=
    (C.presheaf.stalkSpecializes h ≫ C.residue y).hom with hφdef
  have hfac : ∀ k : K, wcpaDjFK K q y k = φ (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
      C.presheaf.germ ⊤ z trivial).hom k) := by
    intro k
    have e : C.presheaf.germ ⊤ z trivial ≫ C.presheaf.stalkSpecializes h =
        C.presheaf.germ ⊤ y trivial :=
      TopCat.Presheaf.germ_stalkSpecializes _ _ _
    have e' : (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ y trivial ≫
        C.residue y = ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
        C.presheaf.germ ⊤ z trivial) ≫ (C.presheaf.stalkSpecializes h ≫ C.residue y) := by
      rw [← e]
      simp only [Category.assoc]
    show ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ y trivial ≫
        C.residue y).hom k = _
    rw [e']
    rfl
  have hφs : Function.Surjective φ := by
    intro w
    obtain ⟨k, hk⟩ := hsurj w
    exact ⟨_, (hfac k).symm.trans hk⟩
  have hkerφ : RingHom.ker φ = IsLocalRing.maximalIdeal (C.presheaf.stalk z) := by
    haveI := RingHom.ker_isMaximal_of_surjective φ hφs
    exact IsLocalRing.eq_maximalIdeal this
  have hkerres : RingHom.ker (C.residue y).hom =
      IsLocalRing.maximalIdeal (C.presheaf.stalk y) := by
    haveI := RingHom.ker_isMaximal_of_surjective _ (Scheme.residue_surjective C y)
    exact IsLocalRing.eq_maximalIdeal this
  have hpt : (Spec.map (C.presheaf.stalkSpecializes h))
      (IsLocalRing.closedPoint (C.presheaf.stalk y)) =
      IsLocalRing.closedPoint (C.presheaf.stalk z) := by
    refine (Spec.map_apply _ _).trans ?_
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal]
    show Ideal.comap _ (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _
    rw [← hkerres, RingHom.comap_ker, ← hkerφ]
    rfl
  have e3 : C.fromSpecStalk z ((Spec.map (C.presheaf.stalkSpecializes h))
      (IsLocalRing.closedPoint (C.presheaf.stalk y))) =
      C.fromSpecStalk y (IsLocalRing.closedPoint (C.presheaf.stalk y)) := by
    have H := congrArg (fun f : Spec (C.presheaf.stalk y) ⟶ C =>
      f (IsLocalRing.closedPoint (C.presheaf.stalk y)))
      (Scheme.SpecMap_stalkSpecializes_fromSpecStalk h)
    exact H
  have e4 : C.fromSpecStalk z (IsLocalRing.closedPoint (C.presheaf.stalk z)) =
      C.fromSpecStalk y (IsLocalRing.closedPoint (C.presheaf.stalk y)) := by
    rw [← hpt]; exact e3
  rw [Scheme.fromSpecStalk_closedPoint, Scheme.fromSpecStalk_closedPoint] at e4
  exact e4

theorem wcpa_dj_lr1k_nd_fibre_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)],
    wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX),
    ¬ IsClosed ({w} : Set ↥(wcpaDjLkFib W (φ ≫ ι) uX)) →
    ¬ wcpaDjLkBad ((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) :=
by
  intro Ω _ _ W _hW hWt Ct φ _hcov X uX ι _ _ hM w hw

  have s1 : ∀ (R : Type u) [CommRing R], IsField R → ¬ wcpaDjLkBad R := by
    intro R _ hR hbad
    apply hbad
    left
    haveI : Nontrivial R := ⟨hR.exists_pair_ne⟩
    have hbij := IsField.localization_map_bijective (Rₘ := FractionRing R)
      (M := nonZeroDivisors R) zero_notMem_nonZeroDivisors hR
    show Module.length R _ = 0
    rw [Module.length_eq_zero_iff, Submodule.Quotient.subsingleton_iff, eq_top_iff]
    rintro x -
    obtain ⟨r, hr⟩ := hbij.2 (x : FractionRing R)
    exact ⟨r, Subtype.ext hr⟩

  have s2 : ∀ (Z : Scheme.{u}) (w : Z), (∀ z : Z, z ⤳ w → z = w) →
      Ring.KrullDimLE 0 (Z.presheaf.stalk w) := by
    intro Z w h
    apply Ring.KrullDimLE.mk₀
    intro I hI
    have hz : Z.fromSpecStalk w ⟨I, hI⟩ ⤳ w := by
      have : Z.fromSpecStalk w ⟨I, hI⟩ ∈ Set.range (Z.fromSpecStalk w) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    have h1 := h _ hz
    have h2 : (⟨I, hI⟩ : PrimeSpectrum _) = IsLocalRing.closedPoint _ :=
      (Z.fromSpecStalk w).isEmbedding.injective (h1.trans Scheme.fromSpecStalk_closedPoint.symm)
    have h3 : I = IsLocalRing.maximalIdeal _ := congrArg PrimeSpectrum.asIdeal h2
    rw [h3]
    infer_instance

  have s3 : ∀ {A B : Scheme.{u}} (ρ : A ⟶ B) [IsIntegralHom ρ] (a b : A), a ⤳ b → ρ a = ρ b →
      a = b := by
    intro A B ρ _ a b hab he
    obtain ⟨V, hV, hbV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show ρ b ∈ (⊤ : B.Opens) from trivial)
    have hU : IsAffineOpen (ρ ⁻¹ᵁ V) := hV.preimage ρ
    have hbU : b ∈ ρ ⁻¹ᵁ V := hbV
    have haU : a ∈ ρ ⁻¹ᵁ V := hab.mem_open (ρ ⁻¹ᵁ V).isOpen hbU
    obtain ⟨P, hPa⟩ : ∃ P : ↥(Spec Γ(A, ρ ⁻¹ᵁ V)), hU.fromSpec P = a :=
      ⟨_, hU.fromSpec_primeIdealOf ⟨a, haU⟩⟩
    obtain ⟨Q, hQb⟩ : ∃ Q : ↥(Spec Γ(A, ρ ⁻¹ᵁ V)), hU.fromSpec Q = b :=
      ⟨_, hU.fromSpec_primeIdealOf ⟨b, hbU⟩⟩
    have hspec : P ⤳ Q := by
      rw [← hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hPa, hQb]
      exact hab
    have hPQ : P.asIdeal ≤ Q.asIdeal := (PrimeSpectrum.le_iff_specializes P Q).mpr hspec
    have hcomm := IsAffineOpen.SpecMap_appLE_fromSpec ρ hV hU (le_refl _)
    have hpt : ∀ x, hV.fromSpec (Spec.map (ρ.appLE V (ρ ⁻¹ᵁ V) (le_refl _)) x) =
        ρ (hU.fromSpec x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply]
    have hint := IsIntegralHom.isIntegral_app ρ V hV
    rw [Scheme.Hom.app_eq_appLE] at hint
    have hcontr : Spec.map (ρ.appLE V (ρ ⁻¹ᵁ V) (le_refl _)) P =
        Spec.map (ρ.appLE V (ρ ⁻¹ᵁ V) (le_refl _)) Q := by
      apply hV.fromSpec.isOpenEmbedding.injective
      rw [hpt, hpt, hPa, hQb, he]
    rw [Spec.map_apply, Spec.map_apply] at hcontr
    have hPQ' : P = Q := by
      by_contra hne
      have hlt : P.asIdeal < Q.asIdeal :=
        lt_of_le_of_ne hPQ (fun h => hne (PrimeSpectrum.ext h))
      obtain ⟨x, hxQ, hxP⟩ := SetLike.exists_of_lt hlt
      letI := (ρ.appLE V (ρ ⁻¹ᵁ V) (le_refl _)).hom.toAlgebra
      haveI : P.asIdeal.IsPrime := P.isPrime
      have hlt2 := Ideal.under_lt_under_of_integral_mem_sdiff (R := Γ(B, V)) hlt.le
        (show x ∈ (Q.asIdeal : Set _) \ (P.asIdeal : Set _) from ⟨hxQ, hxP⟩) (hint x)
      have heq := congrArg PrimeSpectrum.asIdeal hcontr
      exact hlt2.ne heq
    rw [← hPa, ← hQb, hPQ']

  have s4 : ∀ {C P : Scheme.{u}} (g : C ⟶ P), wcpaDjSemistable g → ∀ (K : Type u) [Field K]
      [IsAlgClosed K] (s : Spec (.of K) ⟶ P) (x₀ x₁ x₂ : ↥(Limits.pullback g s)),
      x₀ ⤳ x₁ → x₁ ⤳ x₂ → x₀ ≠ x₁ → x₁ ≠ x₂ → False := by
    intro C P g hg K _ _ s x₀ x₁ x₂ h01 h12 n01 n12
    haveI : IsProper g := hg.2.1
    haveI := LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd g s)
    haveI := LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g s)
    have hncl : ¬ IsClosed ({x₁} : Set ↥(Limits.pullback g s)) := by
      intro hc
      have hm : x₂ ∈ closure ({x₁} : Set ↥(Limits.pullback g s)) :=
        specializes_iff_mem_closure.mp h12
      rw [hc.closure_eq] at hm
      exact n12 (Set.mem_singleton_iff.mp hm).symm
    rcases hg.2.2 K s x₁ with ⟨V, hxV, hVsm⟩ | ⟨e, he⟩
    · haveI := hVsm
      have hdim : topologicalKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) :=
        wc_smooth_alg_closed_dim_le K V (V.ι ≫ Limits.pullback.snd g s) 1
      have hx0V : x₀ ∈ V := h01.mem_open V.isOpen hxV
      obtain ⟨x₂', hx2V, h12', n12'⟩ : ∃ x₂' ∈ V, x₁ ⤳ x₂' ∧ x₁ ≠ x₂' := by
        by_contra hcon
        push_neg at hcon
        apply hncl
        apply isClosed_singleton_of_isLocallyClosed_singleton
        refine ⟨(V : Set ↥(Limits.pullback g s)), closure {x₁}, V.isOpen, isClosed_closure, ?_⟩
        ext z
        constructor
        · intro hz
          rw [Set.mem_singleton_iff] at hz
          subst hz
          exact ⟨hxV, subset_closure rfl⟩
        · rintro ⟨hzV, hzc⟩
          exact (hcon z hzV (specializes_iff_mem_closure.mpr hzc)).symm
      have hsp : ∀ a b : V.toScheme, V.ι a ⤳ V.ι b → a ⤳ b := fun a b h =>
        (V.ι.isOpenEmbedding.isInducing.specializes_iff).mp h
      have hne : ∀ a b : V.toScheme, V.ι a ≠ V.ι b → b ≠ a := fun a b h e => h (e ▸ rfl)
      let a0 : V.toScheme := ⟨x₀, hx0V⟩
      let a1 : V.toScheme := ⟨x₁, hxV⟩
      let a2 : V.toScheme := ⟨x₂', hx2V⟩
      have s01 : a0 ⤳ a1 := hsp a0 a1 h01
      have s12 : a1 ⤳ a2 := hsp a1 a2 h12'
      have e01 : a1 ≠ a0 := hne a0 a1 n01
      have e12 : a2 ≠ a1 := hne a1 a2 n12'
      have F0 := wc_closure_point_krullDim_facts V.toScheme a0 a1 1
      have F1 := wc_closure_point_krullDim_facts V.toScheme a1 a2 1
      have F2 := wc_closure_point_krullDim_facts V.toScheme a2 a2 1
      have d0 := F0.2.1.trans hdim
      have d1 := F1.2.1.trans hdim
      have h1 := F0.2.2 (specializes_iff_mem_closure.mp s01) e01 d0
      have h2 := F1.2.2 (specializes_iff_mem_closure.mp s12) e12 d1
      have h0 := F2.1
      have b1 : (0 : WithBot ℕ∞) + 1 ≤ topologicalKrullDim ↥(closure ({a1} : Set V.toScheme)) :=
        (add_le_add h0 le_rfl).trans h2
      have b2 : (0 : WithBot ℕ∞) + 1 + 1 ≤ ((1 : ℕ) : WithBot ℕ∞) :=
        ((add_le_add b1 le_rfl).trans h1).trans d0
      have b3 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
        have e : (0 : WithBot ℕ∞) + 1 + 1 = ((2 : ℕ) : WithBot ℕ∞) := by norm_num
        rw [← e]
        exact b2
      have b4 : (2 : ℕ) ≤ 1 := by exact_mod_cast b3
      omega
    · have hsurj := wcpa_dj_p1rec_node_residue K _
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g s).appTop ≫
          (Limits.pullback g s).presheaf.germ ⊤ x₁ trivial).hom ⟨e, he⟩
      exact hncl (wcpa_dj_p1rec_rational_closed K _ (Limits.pullback.snd g s) x₁ hsurj)

  have s5 : ∀ {Y X S T : Scheme.{u}} (h : Y ⟶ X) (u : X ⟶ S) (s : T ⟶ S) [IsClosedImmersion s],
      (∀ a b : Y, a ⤳ b → h a = h b → a = b) →
      (∀ x₀ x₁ x₂ : ↥(Limits.pullback u s), x₀ ⤳ x₁ → x₁ ⤳ x₂ → x₀ ≠ x₁ → x₁ ≠ x₂ → False) →
      ∀ y₀ y₁ y₂ : ↥(Limits.pullback (h ≫ u) s), y₀ ⤳ y₁ → y₁ ⤳ y₂ → y₀ ≠ y₁ → y₁ ≠ y₂ →
        False := by
    intro Y X S T h u s _ hinj hCB y₀ y₁ y₂ h01 h12 n01 n12
    let m : Limits.pullback (h ≫ u) s ⟶ Limits.pullback u s :=
      Limits.pullback.lift (Limits.pullback.fst (h ≫ u) s ≫ h) (Limits.pullback.snd (h ≫ u) s)
        (by rw [Category.assoc]; exact Limits.pullback.condition)
    have hm : m ≫ Limits.pullback.fst u s = Limits.pullback.fst (h ≫ u) s ≫ h :=
      Limits.pullback.lift_fst _ _ _
    have pinj : Function.Injective (Limits.pullback.fst (h ≫ u) s) :=
      (Limits.pullback.fst (h ≫ u) s).isClosedEmbedding.isEmbedding.injective
    have e1 : ∀ a, (Limits.pullback.fst u s) (m a) = h (Limits.pullback.fst (h ≫ u) s a) := by
      intro a
      rw [← Scheme.Hom.comp_apply, hm, Scheme.Hom.comp_apply]
    have key : ∀ a b, a ⤳ b → m a = m b → a = b := by
      intro a b hab hm'
      apply pinj
      apply hinj _ _ (hab.map (Limits.pullback.fst (h ≫ u) s).continuous)
      rw [← e1, ← e1, hm']
    exact hCB (m y₀) (m y₁) (m y₂) (h01.map m.continuous) (h12.map m.continuous)
      (fun e => n01 (key _ _ h01 e)) (fun e => n12 (key _ _ h12 e))

  have s6 : ∀ (A B S : Type u) [CommRing A] [CommRing B] [CommRing S] (σ : ↥W →+* A)
      (α : A →+* B) (j : B →+* S) (ψ : Ω →+* S), Function.Injective j →
      ψ.comp (algebraMap ↥W Ω) = (j.comp α).comp σ →
      (∀ t : S, (j.comp α).IsIntegralElem t ↔ ∃ c, j c = t) →
      (Ideal.map (α.comp σ) (IsLocalRing.maximalIdeal ↥W)).IsRadical := by
    intro A B S _ _ _ σ α j ψ hj hcomp hint
    have hkey : ∀ w' : W, j ((α.comp σ) w') = ψ (w' : Ω) := fun w' =>
      (RingHom.congr_fun hcomp w').symm
    obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
      by_contra h
      push_neg at h
      exact hWt (eq_top_iff.mpr fun y _ => h y)
    have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
    have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
    have ha₀m : (⟨x⁻¹, hxi⟩ : W) ∈ IsLocalRing.maximalIdeal W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have h1 : (x⁻¹ : Ω) * (v : Ω) = 1 := congrArg Subtype.val hv
      have h2 : x = v := by
        calc x = x * (x⁻¹ * v) := by rw [h1, mul_one]
          _ = v := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
      exact hx (h2 ▸ v.2)
    have ha₀0 : (⟨x⁻¹, hxi⟩ : W) ≠ 0 := fun h => hx0 (inv_eq_zero.mp (congrArg Subtype.val h))
    have hnf : ∀ z ∈ Ideal.map (α.comp σ) (IsLocalRing.maximalIdeal ↥W),
        ∃ a ∈ IsLocalRing.maximalIdeal W, a ≠ 0 ∧ ∃ c : B, z = (α.comp σ) a * c := by
      intro z hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨a', ha', rfl⟩
        by_cases h0 : a' = 0
        · exact ⟨_, ha₀m, ha₀0, 0, by rw [h0, map_zero, mul_zero]⟩
        · exact ⟨a', ha', h0, 1, by rw [mul_one]⟩
      · exact ⟨_, ha₀m, ha₀0, 0, by rw [mul_zero]⟩
      · rintro z z' - - ⟨a, ham, ha0, c, rfl⟩ ⟨a', ham', ha0', c', rfl⟩
        rcases ValuationRing.dvd_total a a' with ⟨d, hd⟩ | ⟨d, hd⟩
        · exact ⟨a, ham, ha0, c + (α.comp σ) d * c', by rw [hd, map_mul]; ring⟩
        · exact ⟨a', ham', ha0', (α.comp σ) d * c + c', by rw [hd, map_mul]; ring⟩
      · rintro y z - ⟨a, ham, ha0, c, rfl⟩
        exact ⟨a, ham, ha0, y * c, by rw [smul_eq_mul]; ring⟩
    intro b hb
    obtain ⟨n, hn⟩ := hb
    rcases Nat.eq_zero_or_pos n with hn0 | hnpos
    · rw [hn0, pow_zero] at hn
      rw [(Ideal.eq_top_iff_one _).mpr hn]
      exact Submodule.mem_top
    obtain ⟨a, ham, ha0, c, hc⟩ := hnf _ hn
    have haΩ : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
    obtain ⟨ρ, hρ⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) hnpos
    have hρ0 : ρ ≠ 0 := by
      rintro rfl
      rw [zero_pow hnpos.ne'] at hρ
      exact haΩ hρ.symm
    have hρW : ρ ∈ W := by
      by_contra hρW
      have hρi : ρ⁻¹ ∈ W := (W.mem_or_inv_mem ρ).resolve_left hρW
      have hai : (a : Ω)⁻¹ ∈ W := by
        rw [← hρ, ← inv_pow]
        exact W.pow_mem hρi n
      apply ham
      exact isUnit_iff_exists_inv.mpr ⟨⟨_, hai⟩, Subtype.ext (mul_inv_cancel₀ haΩ)⟩
    set r : W := ⟨ρ, hρW⟩ with hr
    have hrn : r ^ n = a := Subtype.ext (by simp [r, hρ])
    have hrm : r ∈ IsLocalRing.maximalIdeal W := by
      intro hu
      apply ham
      rw [← hrn]
      exact hu.pow n
    set t : S := ψ ρ⁻¹ * j b with ht
    have htn : t ^ n = j c := by
      rw [ht, mul_pow, ← map_pow, ← map_pow, hc, map_mul, hkey, inv_pow, hρ, ← mul_assoc,
        ← map_mul, inv_mul_cancel₀ haΩ, map_one, one_mul]
    letI : Algebra A S := (j.comp α).toAlgebra
    have h1 : IsIntegral A (t ^ n) := by
      rw [htn]
      exact (hint (j c)).mpr ⟨c, rfl⟩
    have h2 : IsIntegral A t := IsIntegral.of_pow hnpos h1
    obtain ⟨b', hb'⟩ := (hint t).mp h2
    have hjb : j b = j ((α.comp σ) r * b') := by
      rw [map_mul, hkey, hb', ht, ← mul_assoc, ← map_mul]
      show j b = ψ (ρ * ρ⁻¹) * j b
      rw [mul_inv_cancel₀ hρ0, map_one, one_mul]
    rw [hj hjb]
    exact Ideal.mul_mem_right b' _ (Ideal.mem_map_of_mem _ hrm)

  have s7 : ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)), (∀ y : Y, ∃ U : Y.Opens,
      IsAffineOpen U ∧ y ∈ U ∧ (Ideal.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ g.appTop ≫
        Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          (IsLocalRing.maximalIdeal ↥W)).IsRadical) →
      ∀ w : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
      _root_.IsReduced ((Limits.pullback g (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) := by
    intro Y g hY w
    haveI hs : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    obtain ⟨U, hU, hyU, hrad⟩ := hY (Limits.pullback.fst g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)
    letI alg : Algebra ↥W Γ(Y, U) := ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ g.appTop ≫
      Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
    have h2 : hU.fromSpec ≫ g = Spec.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ g.appTop ≫
        Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op) := by
      have h := IsAffineOpen.SpecMap_appLE_fromSpec g (isAffineOpen_top (Spec (.of ↥W))) hU le_top
      rw [← h]
      rw [Spec.map_comp]
      congr 1
      rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec]
      rfl
    have hchart : hU.fromSpec ≫ g = Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))) := by
      rw [h2]; rfl
    haveI : _root_.IsReduced (TensorProduct ↥W Γ(Y, U) (IsLocalRing.ResidueField ↥W)) := by
      have hq : _root_.IsReduced (Γ(Y, U) ⧸ Ideal.map (algebraMap ↥W Γ(Y, U))
          (IsLocalRing.maximalIdeal ↥W)) := (Ideal.isRadical_iff_quotient_reduced _).mp hrad
      have e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot (A := ↥W) Γ(Y, U)
        (IsLocalRing.maximalIdeal ↥W)
      exact isReduced_of_injective e.symm.toRingHom e.symm.injective
    haveI : IsReduced (Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
      isReduced_of_isOpenImmersion (pullbackSpecIso ↥W Γ(Y, U) (IsLocalRing.ResidueField ↥W)).hom
    let m' := Limits.pullback.lift
      (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≫
          hU.fromSpec)
      (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (f := g) (by rw [Category.assoc, hchart, Limits.pullback.condition])
    have hm1 : m' ≫ Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
        Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≫
            hU.fromSpec := Limits.pullback.lift_fst _ _ _
    have hm2 : m' ≫ Limits.pullback.snd g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
      Limits.pullback.lift_snd _ _ _
    have big : IsPullback (m' ≫ Limits.pullback.snd g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
        (hU.fromSpec ≫ g) := by
      rw [hm2, hchart]
      exact (IsPullback.of_hasPullback _ _).flip
    have hpb : IsPullback m'
        (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))))
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        (Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        hU.fromSpec :=
      IsPullback.of_right big hm1 (IsPullback.of_hasPullback g _).flip
    haveI : IsOpenImmersion m' :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip inferInstance
    obtain ⟨a, ha⟩ : ∃ a : ↥(Spec Γ(Y, U)), hU.fromSpec a = Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w :=
      ⟨_, hU.fromSpec_primeIdealOf ⟨_, hyU⟩⟩
    have hab : Spec.map (CommRingCat.ofHom (algebraMap ↥W Γ(Y, U))) a =
        Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))
          (Limits.pullback.snd g _ w) := by
      rw [← hchart, Scheme.Hom.comp_apply, ha, ← Scheme.Hom.comp_apply,
        Limits.pullback.condition, Scheme.Hom.comp_apply]
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback a _ hab
    have hmz : m' z = w := by
      apply (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).isClosedEmbedding.injective
      rw [← Scheme.Hom.comp_apply, hm1, Scheme.Hom.comp_apply, hz1, ha]
    rw [← hmz]
    exact isReduced_of_injective (m'.stalkMap z).hom
      (ConcreteCategory.bijective_of_isIso (m'.stalkMap z)).1

  have s8 : ∀ (Ct X : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (uX : X ⟶ Spec (.of ↥W))
      (f : Ct ⟶ X) [QuasiCompact f] [QuasiSeparated f],
      f ≫ uX = ct ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) →
      ∀ y : ↥f.normalization, ∃ U : f.normalization.Opens, IsAffineOpen U ∧ y ∈ U ∧
        (Ideal.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ (f.fromNormalization ≫ uX).appTop ≫
          f.normalization.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
            (IsLocalRing.maximalIdeal ↥W)).IsRadical := by
    intro Ct X ct uX f _ _ hfu y
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset
      (show f.fromNormalization y ∈ (⊤ : X.Opens) from trivial)
    obtain ⟨j, hj, hjc, hjint⟩ := wc_pdp_normalization_chart f V hV
    refine ⟨f.fromNormalization ⁻¹ᵁ V, hV.preimage _, hyV, ?_⟩
    set σc : CommRingCat.of ↥W ⟶ Γ(X, V) := (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
      X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op with hσc
    set ψc : CommRingCat.of Ω ⟶ Γ(Ct, f ⁻¹ᵁ V) := (Scheme.ΓSpecIso (.of Ω)).inv ≫ ct.appTop ≫
      Ct.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ V ≤ ⊤)).op with hψc
    have hlast : (Scheme.ΓSpecIso (.of ↥W)).inv ≫ (f.fromNormalization ≫ uX).appTop ≫
        f.normalization.presheaf.map
          (homOfLE (le_top : f.fromNormalization ⁻¹ᵁ V ≤ ⊤)).op =
        σc ≫ f.fromNormalization.app V := by
      rw [hσc, Scheme.Hom.comp_appTop, Category.assoc, Category.assoc, Category.assoc,
        f.fromNormalization.naturality]
      rfl
    have hcompat : CommRingCat.ofHom (algebraMap ↥W Ω) ≫ ψc = σc ≫ f.app V := by
      rw [hψc, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc, ← Category.assoc
        (Scheme.Hom.appTop _), ← Scheme.Hom.comp_appTop, ← hfu, Scheme.Hom.comp_appTop, hσc,
        Category.assoc, Category.assoc, Category.assoc, f.naturality]
      rfl
    rw [hlast]
    apply s6 Γ(X, V) _ Γ(Ct, f ⁻¹ᵁ V) σc.hom (f.fromNormalization.app V).hom j ψc.hom hj
    · rw [hjc]
      exact congrArg CommRingCat.Hom.hom hcompat
    · rw [hjc]
      exact hjint

  haveI hs : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI := wcpa_dj_nc_residue_algclosed Ω W
  have hCB0 := s4 uX hM.1 (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
  have hinj := s3 (φ ≫ ι).fromNormalization
  have hCB := s5 (φ ≫ ι).fromNormalization uX
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) hinj hCB0
  have hw' : ∃ w', w ⤳ w' ∧ w' ≠ w := by
    by_contra hcon
    push_neg at hcon
    apply hw
    apply isClosed_of_closure_subset
    intro z hz
    rw [← specializes_iff_mem_closure] at hz
    exact hcon z hz
  obtain ⟨w', hww', hne⟩ := hw'
  have hgen : ∀ z, z ⤳ w → z = w := by
    intro z hz
    by_contra hzw
    exact hCB z w w' hz hww' hzw (Ne.symm hne)
  haveI := s2 _ w hgen
  have hcomm : (φ ≫ ι) ≫ uX =
      (φ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [Category.assoc, hM.2.2.w, ← Category.assoc]
  haveI := s7 (φ ≫ ι).normalization ((φ ≫ ι).fromNormalization ≫ uX)
    (s8 Ct X (φ ≫ wcProjKStr Ω 1) uX (φ ≫ ι) hcomm) w
  apply s1
  exact Ring.KrullDimLE.isField_of_isReduced

theorem wcpa_dj_lus_sm_hensel_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) (V : Y.Opens), SmoothOfRelativeDimension 1 (V.ι ≫ g) →
    ∀ (t : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Y),
    t (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ V →
    t ≫ g = Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) →
    ∃ σ : Spec (.of ↥W) ⟶ Y, σ ≫ g = 𝟙 _ ∧
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ σ = t :=
by
  intro Ω _ _ W Y g V hsm t htV htg

  haveI hHen : HenselianLocalRing ↥W := by
    refine ⟨fun f hf a₀ ha₀ _ => ?_⟩
    set fΩ := f.map (algebraMap ↥W Ω) with hfΩdef
    have hfΩ : fΩ.Monic := hf.map _
    have hfΩ0 : fΩ ≠ 0 := hfΩ.ne_zero
    have hprod : (fΩ.roots.map fun a => Polynomial.X - Polynomial.C a).prod = fΩ :=
      Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hfΩ
        (IsAlgClosed.card_roots_eq_natDegree)
    have heval : algebraMap ↥W Ω (f.eval a₀) =
        (fΩ.roots.map fun θ => algebraMap ↥W Ω a₀ - θ).prod := by
      rw [← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, ← hfΩdef]
      conv_lhs => rw [← hprod]
      rw [Polynomial.eval_multiset_prod, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro θ _
      simp
    have hint : ∀ θ ∈ fΩ.roots, ∃ w : ↥W, algebraMap ↥W Ω w = θ := by
      intro θ hθ
      have hi : IsIntegral ↥W θ := by
        refine ⟨f, hf, ?_⟩
        rw [← Polynomial.eval_map]
        exact (Polynomial.mem_roots hfΩ0).mp hθ
      exact IsIntegrallyClosed.isIntegral_iff.mp hi
    have hv : W.valuation (algebraMap ↥W Ω (f.eval a₀)) < 1 :=
      (ValuationSubring.valuation_lt_one_iff W _).mp ha₀
    rw [heval, map_multiset_prod, Multiset.map_map] at hv
    by_contra hcon
    apply (not_le.mpr hv)
    apply Multiset.one_le_prod
    intro x hx
    obtain ⟨θ, hθ, rfl⟩ := Multiset.mem_map.mp hx
    obtain ⟨w, rfl⟩ := hint θ hθ
    by_contra hlt
    rw [not_le] at hlt
    apply hcon
    refine ⟨w, ?_, ?_⟩
    · apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, ← hfΩdef]
      exact (Polynomial.mem_roots hfΩ0).mp hθ
    · have h1 : a₀ - w ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [ValuationSubring.valuation_lt_one_iff]
        exact hlt
      have h2 := neg_mem h1
      rwa [neg_sub] at h2

  obtain ⟨U, hU, htU, hUV⟩ := exists_isAffineOpen_mem_and_subset htV
  have hUle : U ≤ V := hUV
  haveI : Smooth (V.ι ≫ g) := SmoothOfRelativeDimension.smooth 1 _
  have hfs : hU.fromSpec = (hU.isoSpec.inv ≫ Y.homOfLE hUle) ≫ V.ι := by
    rw [Category.assoc, Scheme.homOfLE_ι, IsAffineOpen.isoSpec_inv_ι]
  haveI hsm2 : Smooth (hU.fromSpec ≫ g) := by
    rw [hfs, Category.assoc]
    infer_instance
  set φ : CommRingCat.of ↥W ⟶ Γ(Y, U) := Spec.preimage (hU.fromSpec ≫ g) with hφdef
  have hφ : Spec.map φ = hU.fromSpec ≫ g := Spec.map_preimage _
  have hφsm : φ.hom.Smooth := by
    rw [← HasRingHomProperty.Spec_iff (P := @Smooth), hφ]
    exact hsm2

  have hrange : Set.range t ⊆ Set.range hU.fromSpec := by
    rw [IsAffineOpen.range_fromSpec]
    rintro _ ⟨p, rfl⟩
    rw [Subsingleton.elim p (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))]
    exact htU
  set t' := IsOpenImmersion.lift hU.fromSpec t hrange with ht'def
  have ht' : t' ≫ hU.fromSpec = t := IsOpenImmersion.lift_fac _ _ _
  set ψ : Γ(Y, U) ⟶ CommRingCat.of (IsLocalRing.ResidueField ↥W) := Spec.preimage t' with hψdef
  have hψ : Spec.map ψ ≫ hU.fromSpec = t := by rw [Spec.map_preimage]; exact ht'

  have K1 : φ ≫ ψ = CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
    apply Spec.map_inj.mp
    rw [Spec.map_comp, hφ, ← Category.assoc, hψ, htg]
  letI : Algebra ↥W Γ(Y, U) := φ.hom.toAlgebra
  haveI : Algebra.Smooth ↥W Γ(Y, U) := RingHom.Smooth.toAlgebra hφsm
  let σb : Γ(Y, U) →ₐ[↥W] IsLocalRing.ResidueField ↥W :=
    { ψ.hom with
      commutes' := fun r => by
        show ψ.hom (φ.hom r) = algebraMap ↥W (IsLocalRing.ResidueField ↥W) r
        rw [← CommRingCat.comp_apply, K1]
        rfl }
  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian ↥W Γ(Y, U) σb
  let τ' : Γ(Y, U) ⟶ CommRingCat.of ↥W := CommRingCat.ofHom (τ : Γ(Y, U) →+* ↥W)
  refine ⟨Spec.map τ' ≫ hU.fromSpec, ?_, ?_⟩
  · have e1 : φ ≫ τ' = 𝟙 _ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      show τ (algebraMap ↥W Γ(Y, U) r) = r
      rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
    rw [Category.assoc, ← hφ, ← Spec.map_comp, e1, Spec.map_id]
  · have e2 : τ' ≫ CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) = ψ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      show algebraMap ↥W (IsLocalRing.ResidueField ↥W) (τ x) = ψ.hom x
      rw [IsLocalRing.ResidueField.algebraMap_eq, hτ x]
      rfl
    rw [← Category.assoc, ← Spec.map_comp, e2, hψ]

theorem wcpa_dj_lr1k_eb_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∃ σ : Spec (.of ↥W) ⟶ X, σ ≫ uX = 𝟙 _ ∧
      σ (IsLocalRing.closedPoint ↥W) = wcpaDjLkImg W (γ ≫ ι) uX y₀ :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm
  haveI : IsProper uX := hM.1.2.1
  haveI := wcpa_dj_nc_residue_algclosed Ω W
  have hcl : IsClosed ({y₀} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) := by
    by_contra h
    exact wcpa_dj_lr1k_nd_fibre_reduced Ω W hW hWt C γ hcov X uX ι hM y₀ h hy₀

  obtain ⟨Pi, hPiy, hp, hq⟩ : ∃ P : wcpaDjLkFib W (γ ≫ ι) uX ⟶ Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))),
      (∀ y, wcpaDjLkPi W (γ ≫ ι) uX y = P y) ∧
      P ≫ Limits.pullback.fst uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
        Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≫
          (γ ≫ ι).fromNormalization ∧
      P ≫ Limits.pullback.snd uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
        Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    ⟨Limits.pullback.map ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (γ ≫ ι).fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp),
      fun _ => rfl, Limits.pullback.lift_fst _ _ _,
      (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)⟩
  have hbig : IsPullback (Pi ≫ Limits.pullback.snd uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      ((γ ≫ ι).fromNormalization ≫ uX) := by
    rw [hq]
    exact (IsPullback.of_hasPullback _ _).flip
  have hsq := IsPullback.of_right hbig hp (IsPullback.of_hasPullback uX
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).flip
  haveI : IsIntegralHom Pi :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) hsq.flip inferInstance
  have hPi : IsClosed ({wcpaDjLkPi W (γ ≫ ι) uX y₀} :
      Set ↥(Limits.pullback uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) := by
    have h := Pi.isClosedMap _ hcl
    rw [Set.image_singleton] at h
    rw [hPiy]
    exact h
  obtain ⟨t₀, ht₀, ht₀pt⟩ := wc_glc_closed_point_section (IsLocalRing.ResidueField ↥W) _
    (Limits.pullback.snd uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) _ hPi
  have hfp : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp _ _ uX hM.1.1 inferInstance
  obtain ⟨W', hxW', hsmW'⟩ := wcpa_dj_bsc_smooth_descend _ _ uX _
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) _ hM.1.1 hfp hSm
  have htpt : (t₀ ≫ Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
