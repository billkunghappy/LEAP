  have charOf : ∀ (R : Type u) [CommRing R] [Algebra F R] [Nontrivial R], CharP R p := by
    intro R _ _ _
    rw [CharP.charP_iff_prime_eq_zero hpp, ← map_natCast (algebraMap F R) p,
      CharP.cast_eq_zero, map_zero]
  haveI : CharP K p := charOf K
  haveI : CharP L p := charOf L
  haveI : CharP (TensorProduct F L K) p := charOf _
  rw [isReduced_iff_pow_one_lt p hpp.one_lt]
  intro x hx
  set r := Module.finrank F L
  let b := Module.finBasis F L
  have hc : ∀ i j, ∃ c : E → F, b.repr (b i ^ p) j = ∑ e, c e ^ p * m e := fun i j => H1 _
  choose c hc using hc
  have hbp : ∀ i, b i ^ p = ∑ j, (∑ e, c i j e ^ p * m e) • b j := by
    intro i
    conv_lhs => rw [← b.sum_repr (b i ^ p)]
    simp only [hc]

  have s2 : ∀ v : Fin r → F, (∀ j e, ∑ i, c i j e * v i = 0) → v = 0 := by
    intro v hv
    have key : ∀ j, ∑ i, (v i ^ p * ∑ e, c i j e ^ p * m e) =
        ∑ e, m e * (∑ i, c i j e * v i) ^ p := by
      intro j
      simp_rw [sum_pow_char, mul_pow, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun e _ => by ring
    have h1 : (∑ i, v i • b i) ^ p = 0 := by
      rw [sum_pow_char]
      simp_rw [smul_pow, hbp, Finset.smul_sum, smul_smul]
      rw [Finset.sum_comm]
      simp_rw [← Finset.sum_smul, key, hv, zero_pow hpp.ne_zero, mul_zero,
        Finset.sum_const_zero, zero_smul, Finset.sum_const_zero]
    have h2 : ∑ i, v i • b i = 0 := (pow_eq_zero_iff hpp.ne_zero).mp h1
    funext i
    exact Fintype.linearIndependent_iff.mp b.linearIndependent v h2 i

  obtain ⟨φ₀, hφ₀⟩ := TensorProduct.eq_repr_basis_left b x
  set φ : Fin r → K := ⇑φ₀ with hφdef
  have hx' : x = ∑ i, b i ⊗ₜ[F] φ i := by
    rw [← hφ₀, Finsupp.sum_fintype]
    intro i
    exact TensorProduct.tmul_zero _ _

  have s3 : ∀ j e, ∑ i, algebraMap F K (c i j e) * φ i = 0 := by
    have hxp : x ^ p = ∑ j, b j ⊗ₜ[F]
        (∑ e, (∑ i, algebraMap F K (c i j e) * φ i) ^ p * algebraMap F K (m e)) := by
      rw [hx', sum_pow_char]
      simp_rw [Algebra.TensorProduct.tmul_pow, hbp, TensorProduct.sum_tmul,
        TensorProduct.smul_tmul, Algebra.smul_def]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← TensorProduct.tmul_sum]
      congr 1
      simp_rw [sum_pow_char, mul_pow, map_sum, map_mul, map_pow, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun e _ => by ring
    rw [hx] at hxp
    set y : Fin r → K := fun j =>
      ∑ e, (∑ i, algebraMap F K (c i j e) * φ i) ^ p * algebraMap F K (m e) with hydef
    have hg : (Finsupp.equivFunOnFinite.symm y).sum (fun j n => b j ⊗ₜ[F] n) = 0 := by
      rw [Finsupp.sum_fintype _ _ (fun i => TensorProduct.tmul_zero _ _)]
      simpa using hxp.symm
    have hg0 := TensorProduct.sum_tmul_basis_left_eq_zero b _ hg
    intro j e
    have hyj : y j = 0 := by
      have := congrArg (fun g : Fin r →₀ K => g j) hg0
      simpa using this
    exact H2 (fun e => ∑ i, algebraMap F K (c i j e) * φ i) hyj e

  let C : Matrix (Fin r × E) (Fin r) F := fun je i => c i je.1 je.2
  have hCinj : ∀ v : Fin r → F, C.mulVec v = 0 → v = 0 := by
    intro v hv
    apply s2 v
    intro j e
    have := congrFun hv (j, e)
    simpa [Matrix.mulVec, dotProduct, C] using this
  have hker : LinearMap.ker (Matrix.toLin' C) = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro v hv
    exact hCinj v (by rwa [Matrix.toLin'_apply] at hv)
  obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
  have hDC : LinearMap.toMatrix' g * C = 1 := by
    have := congrArg LinearMap.toMatrix' hg
    rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
  have hDCK : (LinearMap.toMatrix' g).map (algebraMap F K) * C.map (algebraMap F K) = 1 := by
    rw [← Matrix.map_mul, hDC, Matrix.map_one _ (map_zero _) (map_one _)]
  have hCφ : (C.map (algebraMap F K)).mulVec φ = 0 := by
    funext ⟨j, e⟩
    exact s3 j e
  have hφ : φ = 0 := by
    rw [← Matrix.one_mulVec φ, ← hDCK, ← Matrix.mulVec_mulVec, hCφ, Matrix.mulVec_zero]
  rw [hx', hφ]
  simp

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_ws_tensor_embed : ∀ (T A V F L K : Type u) [CommRing T] [IsDomain T] [CommRing A] [IsDomain A] [CommRing V] [Field F] [Field L] [Field K] [Algebra T A] [Algebra T V] [Algebra T F] [Algebra T L] [Algebra A L] [Algebra F L] [Algebra T K] [Algebra V K] [Algebra F K] [IsScalarTower T A L] [IsScalarTower T F L] [IsScalarTower T V K] [IsScalarTower T F K] [IsFractionRing T F] [IsFractionRing A L] (M : Submonoid V), IsLocalization M K → Function.Injective (algebraMap T A) → (∀ b : A, b ≠ 0 → IsUnit (TensorProduct.tmul T b (1 : V))) → (∀ m ∈ M, IsUnit (TensorProduct.tmul T (1 : A) m)) → _root_.IsReduced (TensorProduct F L K) → _root_.IsReduced (TensorProduct T A V) :=
by
  intro T A V F L K _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ M hM hinj h2 h3 h4
  classical
  have hgL : ∀ y : nonZeroDivisors A,
      IsUnit ((Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct T A V) y) := by
    intro y
    rw [Algebra.TensorProduct.includeLeftRingHom_apply]
    exact h2 y.1 (nonZeroDivisors.ne_zero y.2)
  let ψL : L →+* TensorProduct T A V :=
    IsLocalization.lift (M := nonZeroDivisors A) (S := L) hgL
  have hψL : ∀ a : A, ψL (algebraMap A L a) = TensorProduct.tmul T a (1 : V) := fun a => by
    simp only [ψL]
    rw [IsLocalization.lift_eq]
    rfl
  have hgK : ∀ y : M,
      IsUnit ((Algebra.TensorProduct.includeRight : V →ₐ[T] TensorProduct T A V).toRingHom y) :=
    fun y => h3 y.1 y.2
  let ψK : K →+* TensorProduct T A V := IsLocalization.lift (M := M) (S := K) hgK
  have hψK : ∀ v : V, ψK (algebraMap V K v) = TensorProduct.tmul T (1 : A) v := fun v => by
    simp only [ψK]
    rw [IsLocalization.lift_eq]
    rfl
  have hgF : ∀ y : nonZeroDivisors T, IsUnit (algebraMap T (TensorProduct T A V) y) := by
    intro y
    rw [Algebra.TensorProduct.algebraMap_apply]
    apply h2
    intro h
    apply nonZeroDivisors.ne_zero y.2
    apply hinj
    rw [h, map_zero]
  let ψF : F →+* TensorProduct T A V :=
    IsLocalization.lift (M := nonZeroDivisors T) (S := F) hgF
  have hψF : ∀ x : T, ψF (algebraMap T F x) = algebraMap T (TensorProduct T A V) x :=
    fun x => IsLocalization.lift_eq hgF x
  have c1 : ψL.comp (algebraMap F L) = ψF := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors T)
    ext x
    simp only [RingHom.comp_apply]
    rw [hψF, ← IsScalarTower.algebraMap_apply T F L, IsScalarTower.algebraMap_apply T A L, hψL,
      Algebra.TensorProduct.algebraMap_apply]
  have c2 : ψK.comp (algebraMap F K) = ψF := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors T)
    ext x
    simp only [RingHom.comp_apply]
    rw [hψF, ← IsScalarTower.algebraMap_apply T F K, IsScalarTower.algebraMap_apply T V K, hψK,
      Algebra.TensorProduct.algebraMap_apply']
  have key : ∀ x : T, TensorProduct.tmul F (algebraMap T L x) (1 : K) =
      TensorProduct.tmul F (1 : L) (algebraMap T K x) := by
    intro x
    rw [IsScalarTower.algebraMap_apply T F L, IsScalarTower.algebraMap_apply T F K,
      Algebra.algebraMap_eq_smul_one (algebraMap T F x),
      Algebra.algebraMap_eq_smul_one (A := K) (algebraMap T F x), TensorProduct.smul_tmul]
  let α : A →ₐ[T] TensorProduct F L K :=
    (Algebra.TensorProduct.includeLeft (S := T)).comp (IsScalarTower.toAlgHom T A L)
  let β : V →ₐ[T] TensorProduct F L K :=
    { (Algebra.TensorProduct.includeRight : K →ₐ[F] TensorProduct F L K).toRingHom.comp
        (algebraMap V K) with
      commutes' := fun x => by
        show TensorProduct.tmul F (1 : L) (algebraMap V K (algebraMap T V x)) = _
        rw [← IsScalarTower.algebraMap_apply T V K, ← key, Algebra.TensorProduct.algebraMap_apply] }
  let φ : TensorProduct T A V →ₐ[T] TensorProduct F L K := Algebra.TensorProduct.productMap α β
  letI : Algebra F (TensorProduct T A V) := ψF.toAlgebra
  let ψL' : L →ₐ[F] TensorProduct T A V :=
    { ψL with
      commutes' := fun r => by
        show ψL (algebraMap F L r) = ψF r
        rw [← c1]
        rfl }
  let ψK' : K →ₐ[F] TensorProduct T A V :=
    { ψK with
      commutes' := fun r => by
        show ψK (algebraMap F K r) = ψF r
        rw [← c2]
        rfl }
  let ψ : TensorProduct F L K →ₐ[F] TensorProduct T A V := Algebra.TensorProduct.productMap ψL' ψK'
  have hround : ∀ z : TensorProduct T A V, ψ (φ z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul a v =>
      have e1 : φ (TensorProduct.tmul T a v) =
          TensorProduct.tmul F (algebraMap A L a) (algebraMap V K v) := by
        show α a * β v = _
        show TensorProduct.tmul F (algebraMap A L a) (1 : K) *
          TensorProduct.tmul F (1 : L) (algebraMap V K v) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e1, Algebra.TensorProduct.productMap_apply_tmul]
      show ψL (algebraMap A L a) * ψK (algebraMap V K v) = _
      rw [hψL, hψK, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hφinj : Function.Injective φ := Function.LeftInverse.injective hround
  exact isReduced_of_injective φ hφinj

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_ws_residue_kernel : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) (f₁ : MvPolynomial (Fin d) ↥W) (y : wcGbT W ϖ d), (∀ m : Fin d →₀ ℕ, f₁.coeff m ∈ IsLocalRing.maximalIdeal ↥W) → algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) f₁ + wcGbt W ϖ d * y ∈ wcGbP W ϖ d :=
by
  intro Ω _ _ W hW ϖ hϖ0 _hϖnu d f₁ y hcoef
  classical
  have hrad : ∀ a : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → ∃ N : ℕ, ϖ ∣ a ^ N := by
    intro a ha
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hmem : a ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro J ⟨hJc, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact Ideal.mem_bot.mp h1
      have hJmax : J.IsMaximal := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
        · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
        · exact h
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact ha
    obtain ⟨n, hn⟩ := hmem
    exact ⟨n, Ideal.mem_span_singleton.mp hn⟩
  have hCmem : ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) ∈ wcGbP W ϖ d := by
    intro c hc
    obtain ⟨N, w, hw⟩ := hrad c hc
    show algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) ∈
      (Ideal.span {algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ)}).radical
    refine ⟨N, ?_⟩
    rw [← map_pow, ← map_pow, hw, map_mul, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have e : f₁ = ∑ m ∈ f₁.support, MvPolynomial.C (f₁.coeff m) * MvPolynomial.monomial m 1 := by
    conv_lhs => rw [MvPolynomial.as_sum f₁]
    exact Finset.sum_congr rfl (fun m _ => by rw [MvPolynomial.C_mul_monomial, mul_one])
  have hf₁ : algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) f₁ ∈ wcGbP W ϖ d := by
    rw [e, map_sum]
    exact Ideal.sum_mem _ (fun m _ => by
      rw [map_mul]
      exact Ideal.mul_mem_right _ _ (hCmem _ (hcoef m)))
  have ht : wcGbt W ϖ d * y ∈ wcGbP W ϖ d := by
    apply Ideal.mul_mem_right
    show algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ) ∈
      (Ideal.span {algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ)}).radical
    exact Ideal.le_radical (Ideal.mem_span_singleton_self _)
  exact Ideal.add_mem _ hf₁ ht

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_ws_residue_map : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) [(wcGbP W ϖ d).IsPrime], (∀ (f₁ : MvPolynomial (Fin d) ↥W) (y : wcGbT W ϖ d), (∀ m : Fin d →₀ ℕ, f₁.coeff m ∈ IsLocalRing.maximalIdeal ↥W) → algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) f₁ + wcGbt W ϖ d * y ∈ wcGbP W ϖ d) → ∃ ρ : wcGbVhat W ϖ d →+* FractionRing (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)), ∀ P : MvPolynomial (Fin d) ↥W, ρ (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d) (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) P))) = algebraMap (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)) (FractionRing (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W))) (MvPolynomial.map (IsLocalRing.residue ↥W) P) :=
by
  intro Ω _ W ϖ hϖ0 hϖnu d _ hH
  classical
  have hres0 : ∀ a : ↥W, ¬ IsUnit a → IsLocalRing.residue ↥W a = 0 := fun a ha =>
    (IsLocalRing.residue_eq_zero_iff a).mpr ((IsLocalRing.mem_maximalIdeal a).mpr ha)

  have hψI : ∀ q ∈ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) ^ 1,
      MvPolynomial.map (IsLocalRing.residue ↥W) q = 0 := by
    intro q hq
    rw [pow_one] at hq
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hq
    rw [map_mul, MvPolynomial.map_C, hres0 ϖ hϖnu, map_zero, mul_zero]
  obtain ⟨ρ₀, hρ₀⟩ : ∃ ρ : wcGbT W ϖ d →+* MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W),
      ∀ q : MvPolynomial (Fin d) ↥W, ρ (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) q) =
        MvPolynomial.map (IsLocalRing.residue ↥W) q := by
    refine ⟨(Ideal.Quotient.lift _ (MvPolynomial.map (IsLocalRing.residue ↥W)) hψI).comp
      (AdicCompletion.evalₐ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) 1).toRingHom,
      fun q => ?_⟩
    show Ideal.Quotient.lift _ (MvPolynomial.map (IsLocalRing.residue ↥W)) hψI
      (AdicCompletion.evalₐ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) 1
        (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) q)) = _
    rw [AlgHom.commutes]
    rfl
  have hρ₀t : ρ₀ (wcGbt W ϖ d) = 0 := by
    show ρ₀ (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ)) = 0
    rw [hρ₀, MvPolynomial.map_C, hres0 ϖ hϖnu, map_zero]

  have hCϖ : (MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W) ≠ 0 := by
    rw [Ne, MvPolynomial.C_eq_zero]; exact hϖ0
  have htf : ∀ x : MvPolynomial (Fin d) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 :=
    fun x hx => (mul_eq_zero.mp hx).resolve_left hCϖ

  have approxGen : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) →
      ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C)
        (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c +
          algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = p ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : C) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩
  have hunit : ∀ y : (wcGbP W ϖ d).primeCompl,
      IsUnit ((algebraMap (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W))
        (FractionRing (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)))).comp ρ₀
        (y : wcGbT W ϖ d)) := by
    intro y
    have hy : (y : wcGbT W ϖ d) ∉ wcGbP W ϖ d := y.2
    obtain ⟨c, y', hcy⟩ := approxGen _ _ htf 1 (y : wcGbT W ϖ d)
    have hc : MvPolynomial.map (IsLocalRing.residue ↥W) c ≠ 0 := by
      intro h0
      apply hy
      rw [hcy, pow_one]
      refine hH c y' (fun m => ?_)
      have h1 : (MvPolynomial.map (IsLocalRing.residue ↥W) c).coeff m =
          (0 : MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)).coeff m := by rw [h0]
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at h1
      exact (IsLocalRing.residue_eq_zero_iff _).mp h1
    have hval : ρ₀ (y : wcGbT W ϖ d) = MvPolynomial.map (IsLocalRing.residue ↥W) c := by
      rw [hcy, map_add, map_mul, map_pow, hρ₀ c]
      have h2 : ρ₀ (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ)) = 0 :=
        hρ₀t
      rw [h2, pow_one, zero_mul, add_zero]
    rw [RingHom.comp_apply, hval]
    exact isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hc)

  obtain ⟨ρV, hρV⟩ : ∃ ρV : Localization.AtPrime (wcGbP W ϖ d) →+*
      FractionRing (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)),
      ∀ x : wcGbT W ϖ d, ρV (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) x) =
        algebraMap (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W))
          (FractionRing (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W))) (ρ₀ x) :=
    ⟨IsLocalization.lift (S := Localization.AtPrime (wcGbP W ϖ d)) hunit,
      fun x => IsLocalization.lift_eq hunit x⟩

  have hτI : ∀ a ∈ (Ideal.span {algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
      (wcGbt W ϖ d)}) ^ 1, ρV a = 0 := by
    intro a ha
    rw [pow_one] at ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hρV, hρ₀t, map_zero, mul_zero]
  refine ⟨(Ideal.Quotient.lift _ ρV hτI).comp
    (AdicCompletion.evalₐ (Ideal.span {algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
      (wcGbt W ϖ d)}) 1).toRingHom, fun P => ?_⟩

  show Ideal.Quotient.lift _ ρV hτI
    (AdicCompletion.evalₐ (Ideal.span {algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
      (wcGbt W ϖ d)}) 1
      (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)
        (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
          (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) P)))) = _
  rw [AlgHom.commutes]
  refine Eq.trans ?_ ((hρV _).trans (congrArg _ (hρ₀ P)))
  rfl

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_ws_poly_p_independent : ∀ (k : Type u) [Field k] (d p : ℕ) [Fact p.Prime] [CharP k p] (z : (Fin d → Fin p) → FractionRing (MvPolynomial (Fin d) k)), ∑ e, z e ^ p * algebraMap (MvPolynomial (Fin d) k) (FractionRing (MvPolynomial (Fin d) k)) (MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm (fun i => ((e i : ℕ)))) 1) = 0 → ∀ e, z e = 0 :=
by
  intro k _ d p _ _ z hz
  classical
  have hp : 0 < p := (Fact.out : p.Prime).pos
  have hp0 : p ≠ 0 := hp.ne'
  set E : (Fin d → Fin p) → (Fin d →₀ ℕ) :=
    fun e => Finsupp.equivFunOnFinite.symm (fun i => ((e i : ℕ))) with hE

  have s1 : ∀ (v ν : Fin d →₀ ℕ) (e e' : Fin d → Fin p),
      p • v + E e' = p • ν + E e → v = ν ∧ e' = e := by
    intro v ν e e' h
    have hi : ∀ i, p * v i + (e' i : ℕ) = p * ν i + (e i : ℕ) := by
      intro i
      have := DFunLike.congr_fun h i
      simpa [hE] using this
    have he : ∀ i, (e' i : ℕ) = (e i : ℕ) := by
      intro i
      have h1 : ((e' i : ℕ) + p * v i) % p = ((e i : ℕ) + p * ν i) % p := by
        rw [Nat.add_comm (e' i : ℕ), hi i, Nat.add_comm]
      rwa [Nat.add_mul_mod_self_left, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (e' i).isLt,
        Nat.mod_eq_of_lt (e i).isLt] at h1
    refine ⟨?_, ?_⟩
    · ext i
      have h2 := hi i
      rw [he i] at h2
      exact Nat.eq_of_mul_eq_mul_left hp (by omega)
    · funext i
      exact Fin.ext (he i)

  have s2 : ∀ a : MvPolynomial (Fin d) k,
      a ^ p = ∑ v ∈ a.support, MvPolynomial.monomial (p • v) (a.coeff v ^ p) := by
    intro a
    conv_lhs => rw [MvPolynomial.as_sum a]
    rw [sum_pow_char]
    refine Finset.sum_congr rfl (fun v _ => ?_)
    rw [MvPolynomial.monomial_pow]

  have s3 : ∀ (a : MvPolynomial (Fin d) k) (ν : Fin d →₀ ℕ) (e e' : Fin d → Fin p),
      (a ^ p * MvPolynomial.monomial (E e') 1).coeff (p • ν + E e) =
        if e' = e then a.coeff ν ^ p else 0 := by
    intro a ν e e'
    rw [s2 a, Finset.sum_mul, MvPolynomial.coeff_sum]
    simp only [MvPolynomial.monomial_mul, mul_one, MvPolynomial.coeff_monomial]
    split_ifs with hee
    · subst hee
      rw [Finset.sum_eq_single ν]
      · simp
      · intro v _ hv
        rw [if_neg]
        intro h
        exact hv (s1 v ν e' e' h).1
      · intro hν
        rw [MvPolynomial.notMem_support_iff.mp hν, zero_pow hp0]
        simp
    · apply Finset.sum_eq_zero
      intro v _
      rw [if_neg]
      intro h
      exact hee (s1 v ν e e' h).2

  have s4 : ∀ a : (Fin d → Fin p) → MvPolynomial (Fin d) k,
      ∑ e', a e' ^ p * MvPolynomial.monomial (E e') 1 = 0 → ∀ e, a e = 0 := by
    intro a ha e
    ext ν
    have h := congrArg (fun q : MvPolynomial (Fin d) k => q.coeff (p • ν + E e)) ha
    simp only [MvPolynomial.coeff_sum, s3, MvPolynomial.coeff_zero,
      Finset.sum_ite_eq', Finset.mem_univ, if_true] at h
    rw [MvPolynomial.coeff_zero]
    exact (pow_eq_zero_iff hp0).mp h

  have hz' : ∑ e, z e ^ p * algebraMap (MvPolynomial (Fin d) k)
      (FractionRing (MvPolynomial (Fin d) k)) (MvPolynomial.monomial (E e) 1) = 0 := hz
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite
    (nonZeroDivisors (MvPolynomial (Fin d) k)) z
  have hb' : ∀ e, ∃ y : MvPolynomial (Fin d) k, algebraMap (MvPolynomial (Fin d) k)
      (FractionRing (MvPolynomial (Fin d) k)) y = (b : MvPolynomial (Fin d) k) • z e :=
    fun e => hb e
  choose a ha using hb'
  have hb0 : algebraMap (MvPolynomial (Fin d) k) (FractionRing (MvPolynomial (Fin d) k))
      (b : MvPolynomial (Fin d) k) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
  have hsum : ∑ e, a e ^ p * MvPolynomial.monomial (E e) 1 = 0 := by
    apply IsFractionRing.injective (MvPolynomial (Fin d) k) (FractionRing (MvPolynomial (Fin d) k))
    rw [map_zero, map_sum]
    have key : ∀ e, algebraMap (MvPolynomial (Fin d) k) (FractionRing (MvPolynomial (Fin d) k))
        (a e ^ p * MvPolynomial.monomial (E e) 1) =
        algebraMap (MvPolynomial (Fin d) k) (FractionRing (MvPolynomial (Fin d) k))
          (b : MvPolynomial (Fin d) k) ^ p *
        (z e ^ p * algebraMap (MvPolynomial (Fin d) k) (FractionRing (MvPolynomial (Fin d) k))
          (MvPolynomial.monomial (E e) 1)) := by
      intro e
      rw [map_mul, map_pow, ha e, Algebra.smul_def, mul_pow]
      ring
    rw [Finset.sum_congr rfl (fun e _ => key e), ← Finset.mul_sum, hz', mul_zero]
  intro e
  have h2 := ha e
  rw [s4 a hsum e, map_zero, Algebra.smul_def] at h2
  exact (mul_eq_zero.mp h2.symm).resolve_left hb0

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_weak_stability : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) [(wcGbP W ϖ d).IsPrime], (∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (c : ↥W) (N : ℕ) (f₀ : wcGbT W ϖ d), c ≠ 0 ∧ c ∣ ϖ ^ N ∧ f₀ ∉ wcGbP W ϖ d ∧ f = algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * f₀) → (∀ x y : wcGbT W ϖ d, ∃ u z : wcGbT W ϖ d, u ∉ wcGbP W ϖ d ∧ (u * x = z * y ∨ u * y = z * x)) → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra (wcGbT W ϖ d) A], IsUnit (algebraMap (wcGbT W ϖ d) A (wcGbt W ϖ d)) → (∃ G : Finset A, ∀ a : A, ∃ n : ℕ, algebraMap (wcGbT W ϖ d) A (wcGbt W ϖ d) ^ n * a ∈ Submodule.span (wcGbT W ϖ d) (G : Set A)) → Function.Injective (algebraMap (wcGbT W ϖ d) A) → (∀ b : A, b ≠ 0 → ∃ (b' : A) (f : wcGbT W ϖ d), f ∉ wcGbP W ϖ d ∧ b * b' = algebraMap (wcGbT W ϖ d) A f) → _root_.IsReduced (TensorProduct (wcGbT W ϖ d) A (wcGbVhat W ϖ d)) :=
by
  classical

  have s5 : ∀ (R κ : Type u) [CommRing R] [IsDomain R] [Field κ] (ρ : R →+* κ) (E : Type) [Fintype E] (p : ℕ) (m : E → R), (∀ x y : R, x ∣ y ∨ y ∣ x) → (∀ z : E → κ, ∑ e, z e ^ p * ρ (m e) = 0 → ∀ e, z e = 0) → ∀ c : E → FractionRing R, ∑ e, c e ^ p * algebraMap R (FractionRing R) (m e) = 0 → ∀ e, c e = 0 := by
    intro R κ _ _ _ ρ E _ p m hdvd hind c hc
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors R) (Finset.univ : Finset E) c
    have hb' : ∀ e, ∃ x : R, algebraMap R (FractionRing R) x = algebraMap R (FractionRing R) (b : R) * c e := by
      intro e
      obtain ⟨x, hx⟩ := hb e (Finset.mem_univ e)
      exact ⟨x, by rw [hx]; exact Algebra.smul_def _ _⟩
    choose x hx using hb'
    have hb0 : algebraMap R (FractionRing R) (b : R) ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
    have hxs : ∑ e, x e ^ p * m e = 0 := by
      apply IsFractionRing.injective R (FractionRing R)
      rw [map_sum, map_zero]
      simp_rw [map_mul, map_pow, hx, mul_pow, mul_assoc, ← Finset.mul_sum, hc, mul_zero]
    have hx0 : ∀ e, x e = 0 := by
      by_contra hne
      push_neg at hne
      obtain ⟨e₁, he₁⟩ := hne
      have hmin : ∀ s : Finset E, s.Nonempty → ∃ e₀ ∈ s, ∀ e ∈ s, x e₀ ∣ x e := by
        intro s hs
        induction s using Finset.induction_on with
        | empty => exact absurd hs Finset.not_nonempty_empty
        | insert a s has ih =>
          rcases s.eq_empty_or_nonempty with h | h
          · subst h
            refine ⟨a, Finset.mem_insert_self a ∅, fun e he => ?_⟩
            have : e = a := by simpa using he
            rw [this]
          · obtain ⟨e₀, he₀, hdiv⟩ := ih h
            rcases hdvd (x a) (x e₀) with h1 | h1
            · refine ⟨a, Finset.mem_insert_self a s, fun e he => ?_⟩
              rcases Finset.mem_insert.mp he with rfl | he
              · exact dvd_rfl
              · exact h1.trans (hdiv e he)
            · refine ⟨e₀, Finset.mem_insert_of_mem he₀, fun e he => ?_⟩
              rcases Finset.mem_insert.mp he with rfl | he
              · exact h1
              · exact hdiv e he
      obtain ⟨e₀, -, hdiv⟩ := hmin Finset.univ ⟨e₁, Finset.mem_univ e₁⟩
      have hdiv' : ∀ e, x e₀ ∣ x e := fun e => hdiv e (Finset.mem_univ e)
      have hxe₀ : x e₀ ≠ 0 := by
        intro h
        apply he₁
        obtain ⟨y, hy⟩ := hdiv' e₁
        rw [hy, h, zero_mul]
      choose y hy using hdiv'
      have hsum : x e₀ ^ p * ∑ e, y e ^ p * m e = 0 := by
        rw [Finset.mul_sum, ← hxs]
        refine Finset.sum_congr rfl (fun e _ => ?_)
        rw [hy e, mul_pow]; ring
      have hys : ∑ e, y e ^ p * m e = 0 :=
        (mul_eq_zero.mp hsum).resolve_left (pow_ne_zero p hxe₀)
      have hρ := hind (fun e => ρ (y e)) (by
        have := congrArg ρ hys
        rw [map_sum, map_zero] at this
        simpa only [map_mul, map_pow] using this) e₀
      have hy1 : y e₀ = 1 := by
        have h := hy e₀
        have h' : x e₀ * 1 = x e₀ * y e₀ := by rw [mul_one]; exact h
        exact (mul_left_cancel₀ hxe₀ h').symm
      simp only [hy1, map_one] at hρ
      exact one_ne_zero hρ
    intro e
    have h := hx e
    rw [hx0 e, map_zero] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hb0

  have hmain : ∀ (T A Vh : Type u) [CommRing T] [CommRing A] [IsDomain A] [CommRing Vh] [IsDomain Vh] [Algebra T A] [Algebra T Vh] (t : T),
      IsUnit (algebraMap T A t) →
      (∃ G : Finset A, ∀ a : A, ∃ n : ℕ, algebraMap T A t ^ n * a ∈ Submodule.span T (G : Set A)) →
      Function.Injective (algebraMap T A) →
      (∀ b : A, b ≠ 0 → ∃ (b' : A) (f : T), IsUnit (algebraMap T Vh f) ∧ b * b' = algebraMap T A f) →
      (∀ f : T, f ≠ 0 → ∃ (g : T) (N : ℕ) (f₀ : T), IsUnit (algebraMap T Vh f₀) ∧ f * g = t ^ N * f₀) →
      (∀ x : Vh, x ≠ 0 → ∃ N : ℕ, x ∣ algebraMap T Vh t ^ N) →
      (∀ p : ℕ, Nat.Prime p → CharP T p → ∃ (E : Type) (_ : Fintype E) (m : E → T),
        (∀ x : T, ∃ c : E → T, x = ∑ e, c e ^ p * m e) ∧
        (∀ z : E → FractionRing Vh, ∑ e, z e ^ p * algebraMap T (FractionRing Vh) (m e) = 0 → ∀ e, z e = 0)) →
      _root_.IsReduced (TensorProduct T A Vh) := by
    intro T A Vh _ _ _ _ _ _ _ t hu hG hinj hloc hfac hdivN hchar
    haveI : IsDomain T := hinj.isDomain
    have htmul : ∀ x : T, TensorProduct.tmul T (algebraMap T A x) (1 : Vh) =
        TensorProduct.tmul T (1 : A) (algebraMap T Vh x) := by
      intro x
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    have hτu : IsUnit (TensorProduct.tmul T (1 : A) (algebraMap T Vh t)) := by
      rw [← htmul, ← Algebra.TensorProduct.includeLeftRingHom_apply]
      exact hu.map _
    by_cases hτ0 : algebraMap T Vh t = 0
    · rw [hτ0, TensorProduct.tmul_zero, isUnit_zero_iff] at hτu
      haveI : Subsingleton (TensorProduct T A Vh) := subsingleton_of_zero_eq_one hτu
      exact ⟨fun x _ => Subsingleton.elim _ _⟩
    have hinjV : Function.Injective (algebraMap T Vh) := by
      rw [injective_iff_map_eq_zero]
      intro f hf
      by_contra hf0
      obtain ⟨g, N, f₀, hf₀, hfg⟩ := hfac f hf0
      have h := congrArg (algebraMap T Vh) hfg
      rw [map_mul, map_mul, map_pow, hf, zero_mul] at h
      exact (mul_ne_zero (pow_ne_zero N hτ0) hf₀.ne_zero) h.symm
    have hTL : Function.Injective (algebraMap T (FractionRing A)) := by
      rw [IsScalarTower.algebraMap_eq T A (FractionRing A), RingHom.coe_comp]
      exact (IsFractionRing.injective A (FractionRing A)).comp hinj
    have hTK : Function.Injective (algebraMap T (FractionRing Vh)) := by
      rw [IsScalarTower.algebraMap_eq T Vh (FractionRing Vh), RingHom.coe_comp]
      exact (IsFractionRing.injective Vh (FractionRing Vh)).comp hinjV
    haveI : FaithfulSMul T (FractionRing A) := (faithfulSMul_iff_algebraMap_injective T _).mpr hTL
    haveI : FaithfulSMul T (FractionRing Vh) := (faithfulSMul_iff_algebraMap_injective T _).mpr hTK
    letI : Algebra (FractionRing T) (FractionRing A) := FractionRing.liftAlgebra T (FractionRing A)
    letI : Algebra (FractionRing T) (FractionRing Vh) := FractionRing.liftAlgebra T (FractionRing Vh)
    haveI : IsScalarTower T (FractionRing T) (FractionRing A) :=
      FractionRing.isScalarTower_liftAlgebra T (FractionRing A)
    haveI : IsScalarTower T (FractionRing T) (FractionRing Vh) :=
      FractionRing.isScalarTower_liftAlgebra T (FractionRing Vh)

    haveI hfin : FiniteDimensional (FractionRing T) (FractionRing A) := by
      obtain ⟨G, hG'⟩ := hG
      refine ⟨⟨G.image (algebraMap A (FractionRing A)), ?_⟩⟩
      rw [eq_top_iff]
      rintro ℓ -
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective A ℓ
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      obtain ⟨b', f, hfu, hbb'⟩ := hloc b hb0
      have hf0 : f ≠ 0 := by
        rintro rfl
        rw [map_zero] at hfu
        exact not_isUnit_zero hfu
      have hb'0 : b' ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hbb'
        exact hf0 (hinj (hbb'.symm.trans (map_zero _).symm))
      obtain ⟨n, hn⟩ := hG' (a * b')
      have e : ((G.image (algebraMap A (FractionRing A)) : Finset _) : Set (FractionRing A)) =
          (IsScalarTower.toAlgHom T A (FractionRing A)).toLinearMap '' (G : Set A) := by
        ext y; simp
      have h1 : algebraMap A (FractionRing A) (algebraMap T A t ^ n * (a * b')) ∈
          Submodule.span T ((G.image (algebraMap A (FractionRing A)) : Finset _) :
            Set (FractionRing A)) := by
        rw [e, ← Submodule.map_span]
        exact Submodule.mem_map_of_mem hn
      have h2 : algebraMap A (FractionRing A) (algebraMap T A t ^ n * (a * b')) ∈
          Submodule.span (FractionRing T) ((G.image (algebraMap A (FractionRing A)) : Finset _) :
            Set (FractionRing A)) :=
        Submodule.span_le_restrictScalars T (FractionRing T) _ h1
      have h3 := Submodule.smul_mem _ ((algebraMap T (FractionRing T) (t ^ n * f))⁻¹) h2
      convert h3 using 1
      have hA0 : algebraMap A (FractionRing A) (algebraMap T A t) ≠ 0 :=
        fun h => hu.ne_zero (IsFractionRing.injective A (FractionRing A) (h.trans (map_zero _).symm))
      have hbL : algebraMap A (FractionRing A) b ≠ 0 :=
        fun h => hb0 (IsFractionRing.injective A (FractionRing A) (h.trans (map_zero _).symm))
      have hb'L : algebraMap A (FractionRing A) b' ≠ 0 :=
        fun h => hb'0 (IsFractionRing.injective A (FractionRing A) (h.trans (map_zero _).symm))
      rw [Algebra.smul_def, map_inv₀, ← IsScalarTower.algebraMap_apply,
        IsScalarTower.algebraMap_apply T A (FractionRing A), map_mul, map_pow, ← hbb']
      simp only [map_mul, map_pow]
      field_simp

    have hred : _root_.IsReduced (TensorProduct (FractionRing T) (FractionRing A) (FractionRing Vh)) := by
      rcases CharP.char_is_prime_or_zero T (ringChar T) with hp | hp
      · obtain ⟨p, hpp, hcp⟩ : ∃ p : ℕ, Nat.Prime p ∧ CharP T p := ⟨ringChar T, hp, ringChar.charP T⟩
        haveI := Fact.mk hpp
        haveI := hcp
        haveI : CharP (FractionRing T) p :=
          charP_of_injective_algebraMap (IsFractionRing.injective T (FractionRing T)) p
        obtain ⟨E, hE, m, hspan, hind⟩ := hchar p hpp hcp
        refine wcpa_dj_lr1s_nf_cnf_fmp_gb_ws_frobenius_criterion (FractionRing T) (FractionRing A)
          (FractionRing Vh) p E (fun e => algebraMap T (FractionRing T) (m e)) ?_ ?_
        · intro y
          obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective T y
          have hb0 : algebraMap T (FractionRing T) b ≠ 0 :=
            IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
          obtain ⟨c, hc⟩ := hspan (a * b ^ (p - 1))
          refine ⟨fun e => algebraMap T (FractionRing T) (c e) / algebraMap T (FractionRing T) b, ?_⟩
          have hc' := congrArg (algebraMap T (FractionRing T)) hc
          simp only [map_mul, map_pow, map_sum] at hc'
          rw [eq_comm]
          simp_rw [div_pow, div_mul_eq_mul_div]
          rw [← Finset.sum_div, ← hc', div_eq_div_iff (pow_ne_zero _ hb0) hb0, mul_assoc,
            pow_sub_one_mul hpp.ne_zero]
        · intro z hz
          apply hind z
          simpa only [← IsScalarTower.algebraMap_apply] using hz
