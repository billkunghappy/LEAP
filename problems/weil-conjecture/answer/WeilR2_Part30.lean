theorem wcpa_dj_lr1k_eb_bd_lb_composite_ring : ∀ (L : Type u) [Field L] (V' : ValuationSubring L) (Q : ValuationSubring (IsLocalRing.ResidueField ↥V')), ∃ U : ValuationSubring L, (∀ x : L, x ∈ U ↔ ∃ h : x ∈ V', IsLocalRing.residue ↥V' ⟨x, h⟩ ∈ Q) ∧ (∀ x : L, U.valuation x = 1 ↔ ∃ h : x ∈ V', V'.valuation x = 1 ∧ Q.valuation (IsLocalRing.residue ↥V' ⟨x, h⟩) = 1) ∧ (∀ x : L, U.valuation x < 1 ↔ ∃ h : x ∈ V', V'.valuation x < 1 ∨ Q.valuation (IsLocalRing.residue ↥V' ⟨x, h⟩) < 1) :=
by
  intro L _ V' Q
  have s2 : ∀ (K : Type u) [Field K] (A : ValuationSubring K) (x : K),
      A.valuation x = 1 ↔ x ≠ 0 ∧ x ∈ A ∧ x⁻¹ ∈ A := by
    intro K _ A x
    constructor
    · intro hx
      have hx0 : x ≠ 0 := by
        rintro rfl
        rw [map_zero] at hx
        exact zero_ne_one hx
      refine ⟨hx0, (A.valuation_le_one_iff x).mp hx.le, ?_⟩
      apply (A.valuation_le_one_iff _).mp
      rw [map_inv₀, hx, inv_one]
    · rintro ⟨hx0, hxA, hxiA⟩
      have hu : IsUnit (⟨x, hxA⟩ : A) :=
        isUnit_iff_exists_inv.mpr ⟨⟨x⁻¹, hxiA⟩, Subtype.ext (mul_inv_cancel₀ hx0)⟩
      exact (A.valuation_eq_one_iff _).mp hu
  set r := IsLocalRing.residue ↥V' with hr
  have rcongr : ∀ (a b : L) (ha : a ∈ V') (hb : b ∈ V'), a = b → r ⟨a, ha⟩ = r ⟨b, hb⟩ := by
    rintro a b ha hb rfl; rfl
  have rinv : ∀ (x : L) (hx : x ∈ V') (hxi : x⁻¹ ∈ V'), x ≠ 0 →
      r ⟨x, hx⟩ ≠ 0 ∧ r ⟨x⁻¹, hxi⟩ = (r ⟨x, hx⟩)⁻¹ := by
    intro x hx hxi hx0
    have h1 : r ⟨x, hx⟩ * r ⟨x⁻¹, hxi⟩ = 1 := by
      rw [← map_mul, ← map_one r]
      congr 1
      exact Subtype.ext (mul_inv_cancel₀ hx0)
    exact ⟨left_ne_zero_of_mul_eq_one h1, eq_inv_of_mul_eq_one_right h1⟩
  have rmax : ∀ (x : L) (hx : x ∈ V'), V'.valuation x < 1 → r ⟨x, hx⟩ = 0 := by
    intro x hx hlt
    exact (IsLocalRing.residue_eq_zero_iff _).mpr ((V'.valuation_lt_one_iff ⟨x, hx⟩).mpr hlt)
  have runit : ∀ (x : L) (hx : x ∈ V'), r ⟨x, hx⟩ ≠ 0 → V'.valuation x = 1 := by
    intro x hx hne
    exact (V'.valuation_eq_one_iff ⟨x, hx⟩).mp ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne)
  let S : Subring L := (Q.toSubring.comap r).map V'.subtype
  have hS : ∀ x : L, x ∈ S ↔ ∃ h : x ∈ V', r ⟨x, h⟩ ∈ Q := by
    intro x
    rw [Subring.mem_map]
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y.2, hy⟩
    · rintro ⟨h, hq⟩
      exact ⟨⟨x, h⟩, hq, rfl⟩
  have hmi : ∀ x : L, x ∈ S ∨ x⁻¹ ∈ S := by
    intro x
    by_cases hx : x ∈ V'
    · by_cases hq : r ⟨x, hx⟩ ∈ Q
      · exact Or.inl ((hS x).mpr ⟨hx, hq⟩)
      · right
        have hne : r ⟨x, hx⟩ ≠ 0 := fun h => hq (h ▸ Q.zero_mem)
        have hv := runit x hx hne
        obtain ⟨hx0, -, hxi⟩ := (s2 L V' x).mp hv
        obtain ⟨-, hri⟩ := rinv x hx hxi hx0
        refine (hS _).mpr ⟨hxi, ?_⟩
        rw [hri]
        exact (Q.mem_or_inv_mem _).resolve_left hq
    · right
      have hxi : x⁻¹ ∈ V' := (V'.mem_or_inv_mem x).resolve_left hx
      refine (hS _).mpr ⟨hxi, ?_⟩
      have hlt : V'.valuation x⁻¹ < 1 := by
        rcases V'.valuation_lt_one_or_eq_one ⟨x⁻¹, hxi⟩ with h | h
        · exact h
        · exfalso
          obtain ⟨-, -, h2⟩ := (s2 L V' x⁻¹).mp h
          rw [inv_inv] at h2
          exact hx h2
      rw [rmax _ hxi hlt]
      exact Q.zero_mem
  let U : ValuationSubring L := { S with mem_or_inv_mem' := hmi }
  have hU1 : ∀ x : L, x ∈ U ↔ ∃ h : x ∈ V', r ⟨x, h⟩ ∈ Q := fun x => hS x
  have hC2 : ∀ x : L, U.valuation x = 1 ↔
      ∃ h : x ∈ V', V'.valuation x = 1 ∧ Q.valuation (r ⟨x, h⟩) = 1 := by
    intro x
    rw [s2 L U x, hU1 x, hU1 x⁻¹]
    constructor
    · rintro ⟨hx0, ⟨h, hq⟩, ⟨h', hq'⟩⟩
      refine ⟨h, (s2 L V' x).mpr ⟨hx0, h, h'⟩, ?_⟩
      obtain ⟨hne, hri⟩ := rinv x h h' hx0
      rw [hri] at hq'
      exact (s2 _ Q _).mpr ⟨hne, hq, hq'⟩
    · rintro ⟨h, hv, hqv⟩
      obtain ⟨hx0, -, h'⟩ := (s2 L V' x).mp hv
      obtain ⟨-, hq, hq'⟩ := (s2 _ Q _).mp hqv
      obtain ⟨-, hri⟩ := rinv x h h' hx0
      refine ⟨hx0, ⟨h, hq⟩, ⟨h', ?_⟩⟩
      rw [hri]
      exact hq'
  have hC3 : ∀ x : L, U.valuation x < 1 ↔
      ∃ h : x ∈ V', V'.valuation x < 1 ∨ Q.valuation (r ⟨x, h⟩) < 1 := by
    intro x
    rw [lt_iff_le_and_ne, U.valuation_le_one_iff, hU1]
    constructor
    · rintro ⟨⟨h, hq⟩, hne⟩
      refine ⟨h, ?_⟩
      rcases V'.valuation_lt_one_or_eq_one ⟨x, h⟩ with h1 | h1
      · exact Or.inl h1
      · right
        refine lt_of_le_of_ne ((Q.valuation_le_one_iff _).mpr hq) ?_
        intro h2
        exact hne ((hC2 x).mpr ⟨h, h1, h2⟩)
    · rintro ⟨h, h1 | h1⟩
      · refine ⟨⟨h, ?_⟩, ?_⟩
        · rw [rmax x h h1]; exact Q.zero_mem
        · intro h2
          obtain ⟨h', h3, -⟩ := (hC2 x).mp h2
          exact (ne_of_lt h1) h3
      · refine ⟨⟨h, (Q.valuation_le_one_iff _).mp h1.le⟩, ?_⟩
        intro h2
        obtain ⟨h', -, h3⟩ := (hC2 x).mp h2
        rw [rcongr x x h' h rfl] at h3
        exact (ne_of_lt h1) h3
  exact ⟨U, hU1, hC2, hC3⟩

theorem wcpa_dj_lr1k_eb_bd_lb_composite_factor : ∀ (L : Type u) [Field L] (V' U' : ValuationSubring L), U' ≤ V' → ∃ Q : ValuationSubring (IsLocalRing.ResidueField ↥V'), ∀ x : L, x ∈ U' ↔ ∃ h : x ∈ V', IsLocalRing.residue ↥V' ⟨x, h⟩ ∈ Q :=
by
  intro L _ V' U' hle
  classical
  have s3 : ∀ m : L, V'.valuation m < 1 → m ∈ U' := by
    intro m hm
    by_contra hmU
    have hm0 : m ≠ 0 := fun h => hmU (h ▸ U'.zero_mem)
    have hinv : m⁻¹ ∈ U' := (U'.mem_or_inv_mem m).resolve_left hmU
    have hmV : m ∈ V' := (V'.valuation_le_one_iff m).mp hm.le
    have hunit : IsUnit (⟨m, hmV⟩ : ↥V') :=
      IsUnit.of_mul_eq_one (⟨m⁻¹, hle hinv⟩ : ↥V') (Subtype.ext (mul_inv_cancel₀ hm0))
    have h1 : V'.valuation m = 1 := (V'.valuation_eq_one_iff ⟨m, hmV⟩).mp hunit
    rw [h1] at hm
    exact lt_irrefl _ hm
  let S : Subring ↥V' := Subring.comap V'.subtype U'.toSubring
  let Q₀ : Subring (IsLocalRing.ResidueField ↥V') := Subring.map (IsLocalRing.residue ↥V') S
  have hQ₀ : ∀ z : IsLocalRing.ResidueField ↥V', z ∈ Q₀.carrier ∨ z⁻¹ ∈ Q₀.carrier := by
    intro z
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
    by_cases hy : (y : L) ∈ U'
    · left
      exact Subring.mem_map.mpr ⟨y, hy, rfl⟩
    · right
      have hinv : (y : L)⁻¹ ∈ U' := (U'.mem_or_inv_mem _).resolve_left hy
      have hy0 : (y : L) ≠ 0 := fun h => hy (h ▸ U'.zero_mem)
      refine Subring.mem_map.mpr ⟨⟨(y : L)⁻¹, hle hinv⟩, hinv, ?_⟩
      have hmul : y * (⟨(y : L)⁻¹, hle hinv⟩ : ↥V') = 1 := Subtype.ext (mul_inv_cancel₀ hy0)
      have h2 := congrArg (IsLocalRing.residue ↥V') hmul
      rw [map_mul, map_one] at h2
      exact eq_inv_of_mul_eq_one_right h2
  let Q : ValuationSubring (IsLocalRing.ResidueField ↥V') := ⟨Q₀, hQ₀⟩
  refine ⟨Q, fun x => ⟨fun hx => ⟨hle hx, Subring.mem_map.mpr ⟨⟨x, hle hx⟩, hx, rfl⟩⟩, ?_⟩⟩
  rintro ⟨h, hq⟩
  obtain ⟨y, hyS, hyeq⟩ := Subring.mem_map.mp hq
  have hyU : (y : L) ∈ U' := hyS
  have h0 : IsLocalRing.residue ↥V' (⟨x, h⟩ - y) = 0 := by rw [map_sub, hyeq, sub_self]
  have hmax := (IsLocalRing.residue_eq_zero_iff _).mp h0
  have hlt := (V'.valuation_lt_one_iff _).mp hmax
  have hsub : x - (y : L) ∈ U' := s3 _ hlt
  have h3 := add_mem hsub hyU
  rwa [sub_add_cancel] at h3

theorem wcpa_dj_lr1k_eb_bd_lb_trace_transfer : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (V' : ValuationSubring L) (k : Type u) [Field k] (θ : RatFunc k ≃+* IsLocalRing.ResidueField ↥(V'.comap (algebraMap K L))) (I : K → Prop) (D : RatFunc k → Prop), D 0 → (∀ f : K, I f ↔ ∃ h : f ∈ V'.comap (algebraMap K L), (V'.comap (algebraMap K L)).valuation f < 1 ∨ D (θ.symm (IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨f, h⟩))) → ∀ Q : ValuationSubring (IsLocalRing.ResidueField ↥V'), ((∀ f : K, (∃ h : algebraMap K L f ∈ V', IsLocalRing.residue ↥V' ⟨algebraMap K L f, h⟩ ∈ Q) ↔ I f) ↔ (∀ g : RatFunc k, wcEbBdResAlg K V' (θ g) ∈ Q ↔ D g)) :=
by
  intro K L _ _ _ V' k _ θ I D hD0 hI Q
  have rc : ∀ (f : K) (h : f ∈ V'.comap (algebraMap K L)),
      wcEbBdResAlg K V' (IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨f, h⟩) =
        IsLocalRing.residue ↥V' ⟨algebraMap K L f, h⟩ := fun f h => rfl
  have rz : ∀ (f : K) (h : f ∈ V'.comap (algebraMap K L)),
      (V'.comap (algebraMap K L)).valuation f < 1 ↔
        IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨f, h⟩ = 0 := by
    intro f h
    rw [IsLocalRing.residue_eq_zero_iff]
    exact ((V'.comap (algebraMap K L)).valuation_lt_one_iff ⟨f, h⟩).symm
  have lhs : ∀ (f : K) (h : f ∈ V'.comap (algebraMap K L)),
      (∃ h' : algebraMap K L f ∈ V', IsLocalRing.residue ↥V' ⟨algebraMap K L f, h'⟩ ∈ Q) ↔
        wcEbBdResAlg K V' (IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨f, h⟩) ∈ Q := by
    intro f h
    rw [rc f h]
    exact ⟨fun ⟨_, hq⟩ => hq, fun hq => ⟨h, hq⟩⟩
  constructor
  · intro Hf g
    by_cases hg : g = 0
    · subst hg
      simp only [map_zero]
      exact iff_of_true Q.zero_mem hD0
    · have hθg : θ g ≠ 0 := (map_ne_zero θ).mpr hg
      obtain ⟨x, hx⟩ := IsLocalRing.residue_surjective (θ g)
      have hx' : IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨(x : K), x.2⟩ = θ g := hx
      have hns : ¬ (V'.comap (algebraMap K L)).valuation (x : K) < 1 := by
        intro hv
        apply hθg
        rw [← hx']
        exact (rz _ x.2).mp hv
      rw [← hx', ← lhs (x : K) x.2, Hf (x : K), hI (x : K)]
      constructor
      · rintro ⟨h', hor⟩
        rcases hor with hv | hd
        · exact absurd hv hns
        · have e : IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨(x : K), h'⟩ = θ g := hx
          rw [e, RingEquiv.symm_apply_apply] at hd
          exact hd
      · intro hd
        refine ⟨x.2, Or.inr ?_⟩
        rw [hx', RingEquiv.symm_apply_apply]
        exact hd
  · intro Hg f
    rw [hI f]
    by_cases hf : f ∈ V'.comap (algebraMap K L)
    · rw [lhs f hf]
      by_cases hv : (V'.comap (algebraMap K L)).valuation f < 1
      · refine iff_of_true ?_ ⟨hf, Or.inl hv⟩
        rw [(rz f hf).mp hv, map_zero]
        exact Q.zero_mem
      · have e := Hg (θ.symm (IsLocalRing.residue ↥(V'.comap (algebraMap K L)) ⟨f, hf⟩))
        rw [RingEquiv.apply_symm_apply] at e
        rw [e]
        constructor
        · intro hd
          exact ⟨hf, Or.inr hd⟩
        · rintro ⟨h', hor⟩
          rcases hor with hv' | hd
          · exact absurd hv' hv
          · exact hd
    · refine iff_of_false ?_ ?_
      · rintro ⟨h, _⟩
        exact hf h
      · rintro ⟨h, _⟩
        exact hf h

theorem wcpa_dj_lr1k_eb_bd_local_branches : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      (V' : ValuationSubring L),
    (V'.comap (algebraMap (RatFunc Ω) L)).toSubring = wcEbGauss W →
    0 < wcEbBdResDeg (RatFunc Ω) V' →
    (∀ s : L, s ≠ 0 → ∃ c : Ω, c ≠ 0 ∧
      V'.valuation (s / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) = 1) →
    ∃ (s : ℕ) (P : Fin s → ValuationSubring L) (e : Fin s → ℕ) (π : Fin s → L),
      (∀ j, P j ≤ V') ∧
      (∀ U' : ValuationSubring L, U' ≤ V' →
        ((∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ U' ↔ wcEbAnInU W f) ↔
          ∃ j, P j = U')) ∧
      (∀ j, 1 ≤ e j) ∧ ∑ j, e j = wcEbBdResDeg (RatFunc Ω) V' ∧
      V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) = 1 ∧
      (∀ j, V'.valuation (π j) = 1) ∧
      ∀ j (η : L), V'.valuation (η - π j) < 1 →
        (P j).valuation η < 1 ∧
        (∀ j', j' ≠ j → (P j').valuation η = 1) ∧
        (P j).valuation (algebraMap (RatFunc Ω) L RatFunc.X / η ^ e j - 1) < 1 ∧
        ∀ s : L, s ≠ 0 → ∃ (c : Ω) (k : ℤ), c ≠ 0 ∧
          (P j).valuation (s / (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c) * η ^ k)) = 1 :=
by
  classical
  intro Ω _ _ W _hdim hW L _ _ _ V' hVtr hf hG3

  have rescongr : ∀ (a b : L) (ha : a ∈ V') (hb : b ∈ V'), a = b →
      IsLocalRing.residue ↥V' ⟨a, ha⟩ = IsLocalRing.residue ↥V' ⟨b, hb⟩ := by
    rintro a b ha hb rfl; rfl
  have resmul : ∀ (a b : L) (ha : a ∈ V') (hb : b ∈ V'),
      IsLocalRing.residue ↥V' ⟨a * b, mul_mem ha hb⟩ =
        IsLocalRing.residue ↥V' ⟨a, ha⟩ * IsLocalRing.residue ↥V' ⟨b, hb⟩ :=
    fun a b ha hb => map_mul (IsLocalRing.residue ↥V') ⟨a, ha⟩ ⟨b, hb⟩
  have val_of_res : ∀ (a : L) (ha : a ∈ V'), IsLocalRing.residue ↥V' ⟨a, ha⟩ ≠ 0 →
      V'.valuation a = 1 := fun a ha hne =>
    (V'.valuation_eq_one_iff ⟨a, ha⟩).mp ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne)

  have hXG : (RatFunc.X : RatFunc Ω) ∈ wcEbGauss W := by
    apply Subring.subset_closure
    refine ⟨Polynomial.X, 1, ⟨0, by simp⟩, by simp, ?_⟩
    simp [RatFunc.algebraMap_X]
  have hXiG : (RatFunc.X : RatFunc Ω)⁻¹ ∈ wcEbGauss W := by
    apply Subring.subset_closure
    refine ⟨1, Polynomial.X, ⟨1, by simp⟩, by simp [Polynomial.X_ne_zero], ?_⟩
    simp [RatFunc.algebraMap_X, RatFunc.X_ne_zero]
  have hXV : (RatFunc.X : RatFunc Ω) ∈ V'.comap (algebraMap (RatFunc Ω) L) := by
    have h : (RatFunc.X : RatFunc Ω) ∈ (V'.comap (algebraMap (RatFunc Ω) L)).toSubring := by
      rw [hVtr]; exact hXG
    exact h
  have hXiV : (RatFunc.X : RatFunc Ω)⁻¹ ∈ V'.comap (algebraMap (RatFunc Ω) L) := by
    have h : (RatFunc.X : RatFunc Ω)⁻¹ ∈ (V'.comap (algebraMap (RatFunc Ω) L)).toSubring := by
      rw [hVtr]; exact hXiG
    exact h
  have hXV' : algebraMap (RatFunc Ω) L RatFunc.X ∈ V' := ValuationSubring.mem_comap.mp hXV
  have hXiV' : (algebraMap (RatFunc Ω) L RatFunc.X)⁻¹ ∈ V' := by
    rw [← map_inv₀]; exact ValuationSubring.mem_comap.mp hXiV
  have hX0 : algebraMap (RatFunc Ω) L RatFunc.X ≠ 0 :=
    (map_ne_zero (algebraMap (RatFunc Ω) L)).mpr RatFunc.X_ne_zero
  have hX : V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) = 1 := by
    apply (V'.valuation_eq_one_iff ⟨_, hXV'⟩).mp
    exact isUnit_iff_exists_inv.mpr ⟨⟨_, hXiV'⟩, Subtype.ext (mul_inv_cancel₀ hX0)⟩

  obtain ⟨θ, hθX, hθC⟩ :=
    wcpa_dj_lr1k_eb_bd_lb_gauss_residue_equiv Ω W (V'.comap (algebraMap (RatFunc Ω) L)) hVtr
  have hInU := wcpa_dj_lr1k_eb_bd_lb_inu_residue Ω W hW _ hVtr θ hθX hθC
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  letI alg : Algebra (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.ResidueField ↥V') :=
    ((wcEbBdResAlg (RatFunc Ω) V').comp θ.toRingHom).toAlgebra
  have hfr : Module.finrank (RatFunc (IsLocalRing.ResidueField ↥W))
      (IsLocalRing.ResidueField ↥V') = wcEbBdResDeg (RatFunc Ω) V' := by
    unfold wcEbBdResDeg
    letI : Algebra (IsLocalRing.ResidueField ↥(V'.comap (algebraMap (RatFunc Ω) L)))
        (IsLocalRing.ResidueField ↥V') := (wcEbBdResAlg (RatFunc Ω) V').toAlgebra
    exact Algebra.finrank_eq_of_equiv_equiv θ (RingEquiv.refl _) (RingHom.ext fun x => rfl)
  haveI : FiniteDimensional (RatFunc (IsLocalRing.ResidueField ↥W))
      (IsLocalRing.ResidueField ↥V') :=
    Module.finite_of_finrank_pos (by rw [hfr]; exact hf)
  have hresX : IsLocalRing.residue ↥V' ⟨algebraMap (RatFunc Ω) L RatFunc.X, hXV'⟩ =
      algebraMap (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.ResidueField ↥V')
        RatFunc.X := by
    show _ = wcEbBdResAlg (RatFunc Ω) V' (θ RatFunc.X)
    rw [hθX hXV]
    rfl

  obtain ⟨s, Q, e, ϖ, w, hQa, he1, hesum, hXw, hϖ, hval⟩ :=
    wcpa_dj_lr1k_eb_bd_lb_curve_places (IsLocalRing.ResidueField ↥W)
      (IsLocalRing.ResidueField ↥V')

  have hcomp := fun j => wcpa_dj_lr1k_eb_bd_lb_composite_ring L V' (Q j)
  choose P hPmem hP1 hPlt using hcomp

  have hlift := fun j => IsLocalRing.residue_surjective (R := ↥V') (ϖ j)
  choose y hy using hlift
  have hD0 : (fun g : RatFunc (IsLocalRing.ResidueField ↥W) =>
      ∃ p q : Polynomial (IsLocalRing.ResidueField ↥W), q.eval 0 ≠ 0 ∧
        g * algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
          (RatFunc (IsLocalRing.ResidueField ↥W)) q =
        algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
          (RatFunc (IsLocalRing.ResidueField ↥W)) p) 0 :=
    ⟨0, 1, by simp, by simp⟩
  have hTT := wcpa_dj_lr1k_eb_bd_lb_trace_transfer (RatFunc Ω) L V'
    (IsLocalRing.ResidueField ↥W) θ (wcEbAnInU W) (fun g : RatFunc (IsLocalRing.ResidueField ↥W) =>
      ∃ p q : Polynomial (IsLocalRing.ResidueField ↥W), q.eval 0 ≠ 0 ∧
        g * algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
          (RatFunc (IsLocalRing.ResidueField ↥W)) q =
        algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
          (RatFunc (IsLocalRing.ResidueField ↥W)) p) hD0 hInU
  refine ⟨s, P, e, fun j => (y j : L), ?_, ?_, he1, hesum.trans hfr, hX, ?_, ?_⟩
  ·
    intro j x hx
    obtain ⟨h, _⟩ := (hPmem j x).mp hx
    exact h
  ·
    intro U' hU'
    obtain ⟨Q', hQ'⟩ := wcpa_dj_lr1k_eb_bd_lb_composite_factor L V' U' hU'
    constructor
    · intro htr
      have h1 : ∀ f : RatFunc Ω, (∃ h : algebraMap (RatFunc Ω) L f ∈ V',
          IsLocalRing.residue ↥V' ⟨algebraMap (RatFunc Ω) L f, h⟩ ∈ Q') ↔ wcEbAnInU W f :=
        fun f => (hQ' _).symm.trans (htr f)
      have h2 := (hTT Q').mp h1
      obtain ⟨j, hj⟩ := (hQa Q').mp (fun g => h2 g)
      refine ⟨j, ?_⟩
      ext x
      rw [hPmem j x, hj]
      exact (hQ' x).symm
    · rintro ⟨j, rfl⟩
      have h2 := (hQa (Q j)).mpr ⟨j, rfl⟩
      have h1 := (hTT (Q j)).mpr (fun g => h2 g)
      intro f
      exact (hPmem j _).trans (h1 f)
  ·
    intro j
    apply val_of_res _ (y j).2
    show IsLocalRing.residue ↥V' (y j) ≠ 0
    rw [hy j]; exact (hϖ j).1
  ·
    intro j η hη
    have hϖ0 : ϖ j ≠ 0 := (hϖ j).1
    have hdV : η - (y j : L) ∈ V' := (V'.valuation_le_one_iff _).mp hη.le
    have hηV : η ∈ V' := by
      have h := add_mem hdV (y j).2
      rwa [sub_add_cancel] at h
    have hmax : (⟨η, hηV⟩ : ↥V') - y j ∈ IsLocalRing.maximalIdeal ↥V' :=
      (V'.valuation_lt_one_iff _).mpr hη
    have hres : IsLocalRing.residue ↥V' ⟨η, hηV⟩ = ϖ j := by
      rw [← hy j, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact hmax
    have hv1 : V'.valuation η = 1 := val_of_res η hηV (by rw [hres]; exact hϖ0)
    have hη0 : η ≠ 0 := by
      intro h; rw [h, map_zero] at hv1; exact zero_ne_one hv1
    have hηiV : η⁻¹ ∈ V' :=
      (V'.valuation_le_one_iff _).mp (by rw [map_inv₀, hv1, inv_one])
    have hresi : IsLocalRing.residue ↥V' ⟨η⁻¹, hηiV⟩ = (ϖ j)⁻¹ := by
      have h1 : IsLocalRing.residue ↥V' ⟨η⁻¹, hηiV⟩ * IsLocalRing.residue ↥V' ⟨η, hηV⟩ = 1 := by
        rw [← resmul _ _ hηiV hηV, rescongr _ 1 _ (one_mem V') (inv_mul_cancel₀ hη0)]
        exact map_one _
      rw [hres] at h1
      exact eq_inv_of_mul_eq_one_left h1
    have hzp : ∀ n : ℤ, ∃ h : η ^ n ∈ V', IsLocalRing.residue ↥V' ⟨η ^ n, h⟩ = ϖ j ^ n := by
      intro n
      refine Int.induction_on n ?_ ?_ ?_
      · refine ⟨by rw [zpow_zero]; exact (one_mem V'), ?_⟩
        rw [rescongr _ 1 _ (one_mem V') (zpow_zero η), zpow_zero]
        exact map_one _
      · rintro i ⟨hi, hri⟩
        refine ⟨by rw [zpow_add_one₀ hη0]; exact mul_mem hi hηV, ?_⟩
        rw [rescongr _ _ _ (mul_mem hi hηV) (zpow_add_one₀ hη0 _), resmul _ _ hi hηV, hri, hres,
          zpow_add_one₀ hϖ0]
      · rintro i ⟨hi, hri⟩
        refine ⟨by rw [zpow_sub_one₀ hη0]; exact mul_mem hi hηiV, ?_⟩
        rw [rescongr _ _ _ (mul_mem hi hηiV) (zpow_sub_one₀ hη0 _), resmul _ _ hi hηiV, hri, hresi,
          zpow_sub_one₀ hϖ0]
    refine ⟨?_, ?_, ?_, ?_⟩
    ·
      refine (hPlt j η).mpr ⟨hηV, Or.inr ?_⟩
      rw [hres]; exact (hϖ j).2.1
    ·
      intro j' hj'
      refine (hP1 j' η).mpr ⟨hηV, hv1, ?_⟩
      rw [hres]; exact (hϖ j).2.2 j' hj'
    ·
      obtain ⟨hm, hrm⟩ := hzp (-(e j : ℤ))
      have heq : algebraMap (RatFunc Ω) L RatFunc.X / η ^ e j - 1 =
          algebraMap (RatFunc Ω) L RatFunc.X * η ^ (-(e j : ℤ)) - 1 := by
        rw [zpow_neg, zpow_natCast, div_eq_mul_inv]
      have hmem' : algebraMap (RatFunc Ω) L RatFunc.X * η ^ (-(e j : ℤ)) - 1 ∈ V' :=
        sub_mem (mul_mem hXV' hm) (one_mem V')
      have hmem : algebraMap (RatFunc Ω) L RatFunc.X / η ^ e j - 1 ∈ V' := by
        rw [heq]; exact hmem'
      refine (hPlt j _).mpr ⟨hmem, Or.inr ?_⟩
      have hr3 : IsLocalRing.residue ↥V' ⟨_, hmem⟩ = w j - 1 := by
        rw [rescongr _ _ hmem hmem' heq]
        show IsLocalRing.residue ↥V' ((⟨_, hXV'⟩ : ↥V') * ⟨_, hm⟩ - 1) = _
