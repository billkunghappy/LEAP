theorem wcpa_dj_sfi_rational_generization : ∀ (L : Type u) [Field L] (Y : Scheme.{u}) (b : Y ⟶ Spec (.of L)) (w w₁ : Y), w ⤳ w₁ → (∀ y : Y.presheaf.stalk w, ∃ c : L, y - ((Scheme.ΓSpecIso (.of L)).inv ≫ b.appTop ≫ Y.presheaf.germ ⊤ w trivial).hom c ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w)) → w = w₁ :=
