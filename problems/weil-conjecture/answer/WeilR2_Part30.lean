    apply Polynomial.ringHom_ext
    · intro w
      simp [hι, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    · simp [hx, RatFunc.algebraMap_X]
  rw [hjc] at hGeval

  have hswapRH : (Polynomial.eval₂RingHom (Polynomial.eval₂RingHom ι η) x).comp
      ((Polynomial.Bivariate.swap (R := Ω)).toRingEquiv.toRingHom) =
      Polynomial.eval₂RingHom (Polynomial.eval₂RingHom ι x) η := by
    have hCι : ∀ b : L, (Polynomial.eval₂RingHom ι b).comp Polynomial.C = ι := by
      intro b
      ext r
      simp
    apply Polynomial.ringHom_ext
    · intro q
      simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom]
      show Polynomial.eval₂ (Polynomial.eval₂RingHom ι η) x
          (Polynomial.Bivariate.swap (R := Ω) (Polynomial.C q)) = _
      rw [Polynomial.Bivariate.swap_C, Polynomial.eval₂_map, hCι, Polynomial.eval₂_C]
      rfl
    · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom]
      show Polynomial.eval₂ (Polynomial.eval₂RingHom ι η) x
          (Polynomial.Bivariate.swap (R := Ω) Polynomial.X) = _
      have hsX : Polynomial.Bivariate.swap (R := Ω) Polynomial.X = Polynomial.C Polynomial.X := by
        have h0 := AlgEquiv.symm_apply_apply (Polynomial.Bivariate.swap (R := Ω))
          (Polynomial.C Polynomial.X)
        rw [Polynomial.Bivariate.swap_X, Polynomial.Bivariate.swap_symm] at h0
        exact h0
      rw [hsX, Polynomial.eval₂_C, Polynomial.eval₂_X]
      simp
  have hswap : Polynomial.eval₂ (Polynomial.eval₂RingHom ι η) x
      (Polynomial.Bivariate.swap (R := Ω) G) = 0 := by
    have := congrArg (fun f => f G) hswapRH
    simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom] at this
    rw [← hGeval]
    exact this

  set φ : Polynomial Ω →+* RatFunc Ω := (algebraMap (Polynomial Ω) (RatFunc Ω)).comp
    (Polynomial.compRingHom (Polynomial.C γ * Polynomial.X)) with hφ
  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro P hP
    have h1 : P.comp (Polynomial.C γ * Polynomial.X) = 0 := by
      apply RatFunc.algebraMap_injective Ω
      rw [map_zero]
      simpa [hφ] using hP
    have h2 : (Polynomial.C γ * Polynomial.X).comp (Polynomial.C γ⁻¹ * Polynomial.X) =
        Polynomial.X := by
      rw [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp, ← mul_assoc,
        ← Polynomial.C_mul, mul_inv_cancel₀ hγ, Polynomial.C_1, one_mul]
    calc P = P.comp ((Polynomial.C γ * Polynomial.X).comp (Polynomial.C γ⁻¹ * Polynomial.X)) := by
          rw [h2, Polynomial.comp_X]
      _ = (P.comp (Polynomial.C γ * Polynomial.X)).comp (Polynomial.C γ⁻¹ * Polynomial.X) :=
          (Polynomial.comp_assoc _ _ _).symm
      _ = 0 := by rw [h1, Polynomial.zero_comp]
  have hιγ : ι γ ≠ 0 := (map_ne_zero ι).mpr hγ
  have hψφ : ψ.comp φ = Polynomial.eval₂RingHom ι η := by
    apply Polynomial.ringHom_ext
    · intro w
      have e : φ (Polynomial.C w) = algebraMap Ω (RatFunc Ω) w := by
        simp [hφ, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
      rw [RingHom.comp_apply, e, hψw, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rfl
    · have e : φ Polynomial.X = algebraMap Ω (RatFunc Ω) γ * RatFunc.X := by
        simp [hφ, RatFunc.algebraMap_C, RatFunc.algebraMap_X, RatFunc.algebraMap_eq_C]
      rw [RingHom.comp_apply, e, map_mul, hψw, hψX, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_X]
      exact mul_div_cancel₀ η hιγ

  refine ⟨Polynomial.map φ (Polynomial.Bivariate.swap (R := Ω) G), ?_, ?_⟩
  · rw [Ne, Polynomial.map_eq_zero_iff hφinj]
    intro h
    apply hGne
    exact (Polynomial.Bivariate.swap (R := Ω)).injective (h.trans (map_zero _).symm)
  · rw [Polynomial.eval₂_map, hψφ]
    exact hswap

theorem wcpa_dj_lr1k_eb_pd_es_finite_of_alg : ∀ (Ω : Type u) [Field Ω] (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L] (ψ : RatFunc Ω →+* L), (∀ w : Ω, ψ (algebraMap Ω (RatFunc Ω) w) = algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w)) → (∃ H : Polynomial (RatFunc Ω), H ≠ 0 ∧ Polynomial.eval₂ ψ (algebraMap (RatFunc Ω) L RatFunc.X) H = 0) → letI : Algebra (RatFunc Ω) L := ψ.toAlgebra; FiniteDimensional (RatFunc Ω) L :=
by
  intro Ω _ L _ instA instFD ψ hψw hH
  obtain ⟨H, hH0, hH⟩ := hH
  obtain ⟨n, v, hv⟩ : ∃ (n : ℕ) (v : Fin n → L), ∀ x : L, ∃ c : Fin n → RatFunc Ω,
      x = ∑ i, algebraMap (RatFunc Ω) L (c i) * v i := by
    refine ⟨_, Module.finBasis (RatFunc Ω) L, fun x => ⟨(Module.finBasis (RatFunc Ω) L).repr x, ?_⟩⟩
    conv_lhs => rw [← (Module.finBasis (RatFunc Ω) L).sum_repr x]
    simp only [Algebra.smul_def]
  generalize hα : algebraMap (RatFunc Ω) L = α at hψw hH hv
  clear hα instFD instA
  letI : Algebra (RatFunc Ω) L := ψ.toAlgebra
  show FiniteDimensional (RatFunc Ω) L
  have hint : IsIntegral (RatFunc Ω) (α RatFunc.X) :=
    IsAlgebraic.isIntegral ⟨H, hH0, by rw [Polynomial.aeval_def]; exact hH⟩
  haveI hM : FiniteDimensional (RatFunc Ω)
      (IntermediateField.adjoin (RatFunc Ω) {α RatFunc.X}) :=
    IntermediateField.adjoin.finiteDimensional hint
  set M := IntermediateField.adjoin (RatFunc Ω) {α RatFunc.X} with hMdef
  have hX : α RatFunc.X ∈ M := IntermediateField.mem_adjoin_simple_self (RatFunc Ω) (α RatFunc.X)
  have hpoly : ∀ p : Polynomial Ω, α (algebraMap (Polynomial Ω) (RatFunc Ω) p) ∈ M := by
    intro p
    refine Polynomial.induction_on p ?_ ?_ ?_
    · intro a
      rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C, ← hψw a]
      exact IntermediateField.algebraMap_mem M _
    · intro p q hp hq
      rw [map_add, map_add]
      exact add_mem hp hq
    · intro k a ih
      rw [pow_succ, ← mul_assoc, map_mul, map_mul, RatFunc.algebraMap_X]
      exact mul_mem ih hX
  have hmem : ∀ f : RatFunc Ω, α f ∈ M := by
    intro f
    refine RatFunc.induction_on (P := fun f => α f ∈ M) f ?_
    intro p q _
    rw [map_div₀]
    exact div_mem (hpoly p) (hpoly q)
  haveI : Module.Finite M L := by
    classical
    refine ⟨⟨Finset.univ.image v, ?_⟩⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, eq_top_iff]
    intro x _
    obtain ⟨c, hc⟩ := hv x
    rw [hc]
    refine Submodule.sum_mem _ fun i _ => ?_
    have e : α (c i) * v i = (⟨α (c i), hmem (c i)⟩ : M) • v i := rfl
    rw [e]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  exact FiniteDimensional.trans (RatFunc Ω) M L

theorem wcpa_dj_lr1k_eb_pd_es_ratfunc_decomp : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (p : ℕ) [Fact p.Prime] [CharP Ω p] (f : RatFunc Ω), ∃ g : Fin p → RatFunc Ω, f = ∑ j : Fin p, g j ^ p * RatFunc.X ^ (j : ℕ) :=
by
  intro Ω _ _ p hpf _ f
  classical
  have hp : p.Prime := hpf.out
  have hp0 : 0 < p := hp.pos
  have hpoly : ∀ P : Polynomial Ω, ∃ S : Fin p → Polynomial Ω,
      P = ∑ j : Fin p, S j ^ p * Polynomial.X ^ (j : ℕ) := by
    intro P
    induction P using Polynomial.induction_on' with
    | add P Q hP hQ =>
      obtain ⟨S, hS⟩ := hP
      obtain ⟨T, hT⟩ := hQ
      refine ⟨fun j => S j + T j, ?_⟩
      rw [hS, hT, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [add_pow_char, add_mul]
    | monomial n a =>
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq a hp0
      let j₀ : Fin p := ⟨n % p, Nat.mod_lt n hp0⟩
      refine ⟨fun j => if j = j₀ then Polynomial.C r * Polynomial.X ^ (n / p) else 0, ?_⟩
      rw [Finset.sum_eq_single j₀]
      · dsimp only
        rw [if_pos rfl, mul_pow, ← Polynomial.C_pow, hr, ← pow_mul, mul_assoc, ← pow_add]
        have hn : n / p * p + (j₀ : ℕ) = n := Nat.div_add_mod' n p
        rw [hn, Polynomial.C_mul_X_pow_eq_monomial]
      · intro j _ hj
        dsimp only
        rw [if_neg hj, zero_pow hp.ne_zero, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ _) h
  obtain ⟨S, hS⟩ := hpoly (f.num * f.denom ^ (p - 1))
  have hD : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 :=
    RatFunc.algebraMap_ne_zero f.denom_ne_zero
  refine ⟨fun j => algebraMap (Polynomial Ω) (RatFunc Ω) (S j) /
    algebraMap (Polynomial Ω) (RatFunc Ω) f.denom, ?_⟩
  have h1 : algebraMap (Polynomial Ω) (RatFunc Ω) (f.num * f.denom ^ (p - 1)) =
      ∑ j : Fin p, algebraMap (Polynomial Ω) (RatFunc Ω) (S j) ^ p * RatFunc.X ^ (j : ℕ) := by
    rw [hS, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, map_pow, map_pow, RatFunc.algebraMap_X]
  have h2 : ∑ j : Fin p, (algebraMap (Polynomial Ω) (RatFunc Ω) (S j) /
        algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) ^ p * RatFunc.X ^ (j : ℕ)
      = (∑ j : Fin p, algebraMap (Polynomial Ω) (RatFunc Ω) (S j) ^ p * RatFunc.X ^ (j : ℕ)) /
        algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ^ p := by
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [div_pow, div_mul_eq_mul_div]
  have hpp : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ^ p =
      algebraMap (Polynomial Ω) (RatFunc Ω) f.denom *
        algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ^ (p - 1) := by
    rw [← pow_succ', Nat.sub_add_cancel hp.one_le]
  rw [h2, ← h1, map_mul, map_pow, hpp, mul_div_mul_right _ _ (pow_ne_zero _ hD)]
  exact (RatFunc.num_div_denom f).symm

theorem wcpa_dj_lr1k_eb_pd_es_frob_decomp : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (p : ℕ) [Fact p.Prime] [CharP K p] (x : K), (∀ f : K, ∃ g : Fin p → K, f = ∑ j : Fin p, g j ^ p * x ^ (j : ℕ)) → ∀ z : L, ∃ a : Fin p → L, z = ∑ j : Fin p, a j ^ p * algebraMap K L x ^ (j : ℕ) :=
by
  intro K L _ _ _ _ _ p _ _ x hK z
  classical
  haveI : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
  haveI : ExpChar K p := inferInstance
  haveI : ExpChar L p := inferInstance
  set ι := algebraMap K L with hι
  let b := Module.finBasis K L
  have hspan := Field.span_map_pow_expChar_pow_eq_top_of_isSeparable (F := K) (E := L) p 1 b.span_eq
  simp only [pow_one] at hspan
  have hz : z ∈ Submodule.span K (Set.range fun i => b i ^ p) := by rw [hspan]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hz
  choose G hG using hK
  refine ⟨fun j => ∑ i, ι (G (c i) j) * b i, ?_⟩
  have e : ∀ i, ι (c i) = ∑ j : Fin p, ι (G (c i) j) ^ p * ι x ^ (j : ℕ) := by
    intro i
    conv_lhs => rw [hG (c i)]
    simp only [map_sum, map_mul, map_pow]
  calc z = ∑ i, ι (c i) * b i ^ p := by
          rw [← hc]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Algebra.smul_def]
    _ = ∑ i, ∑ j : Fin p, (ι (G (c i) j) * b i) ^ p * ι x ^ (j : ℕ) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [e i, Finset.sum_mul]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          ring
    _ = ∑ j : Fin p, ∑ i, (ι (G (c i) j) * b i) ^ p * ι x ^ (j : ℕ) := Finset.sum_comm
    _ = ∑ j : Fin p, (∑ i, ι (G (c i) j) * b i) ^ p * ι x ^ (j : ℕ) := by
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [sum_pow_char, Finset.sum_mul]

theorem wcpa_dj_lr1k_eb_pd_es_pth_monomial : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L] [Algebra (RatFunc Ω) L] (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L), wcEbMoBD W L m U e η u → ∀ b : Fin m, η b ≠ 0 → ∀ p : ℕ, 2 ≤ p → ∀ w : L, w ^ p = η b → ∃ N : ℤ, N ≠ 0 ∧ ∃ d : Ω, d ≠ 0 ∧ wcEbAnInU W (RatFunc.X ^ N / algebraMap Ω (RatFunc Ω) d) ∧ wcEbAnInU W (algebraMap Ω (RatFunc Ω) d / RatFunc.X ^ N) :=
by
  intro Ω _ W L _ _ m U e η u hMoBD b hη0 p hp w hw
  obtain ⟨_, hU, _, _, hX, hu, _, _, hunif⟩ := hMoBD
  have hp0 : p ≠ 0 := by omega
  have hw0 : w ≠ 0 := by
    rintro rfl
    exact hη0 (by rw [← hw, zero_pow hp0])
  have hB0 : (U b).valuation (η b) ≠ 0 := ((U b).valuation.ne_zero_iff).mpr hη0
  obtain ⟨c, k, hc0, hck⟩ := hunif b w hw0
  have hιc : algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c) ≠ 0 := by
    rw [map_ne_zero, map_ne_zero]; exact hc0
  have hA0 : (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ≠ 0 :=
    ((U b).valuation.ne_zero_iff).mpr hιc
  have hE1 : (U b).valuation w = (U b).valuation (algebraMap (RatFunc Ω) L
      (algebraMap Ω (RatFunc Ω) c)) * (U b).valuation (η b) ^ k := by
    have hden : (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) *
        (U b).valuation (η b) ^ k ≠ 0 := mul_ne_zero hA0 (zpow_ne_zero k hB0)
    rw [map_div₀, map_mul, map_zpow₀] at hck
    exact (div_eq_one_iff_eq hden).mp hck
  have hE2 : (U b).valuation (η b) ^ (1 - k * (p : ℤ)) =
      (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ^ p := by
    have h1 : (U b).valuation (η b) = (U b).valuation (algebraMap (RatFunc Ω) L
        (algebraMap Ω (RatFunc Ω) c)) ^ p * (U b).valuation (η b) ^ (k * (p : ℤ)) := by
      conv_lhs => rw [← hw]
      rw [map_pow, hE1, mul_pow, zpow_mul, zpow_natCast]
    rw [zpow_sub₀ hB0, zpow_one, div_eq_iff (zpow_ne_zero _ hB0)]
    exact h1
  have hM0 : (1 - k * (p : ℤ)) ≠ 0 := by
    intro h
    have h2 : k * (p : ℤ) = 1 := by linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one' h2 with ⟨_, h3⟩ | ⟨_, h3⟩ <;> omega
  have hub : (U b).valuation (u b) = 1 := by
    have h1 := Valuation.map_one_add_of_lt (U b).valuation (hu b)
    rwa [add_sub_cancel] at h1
  have hE3 : (U b).valuation (algebraMap (RatFunc Ω) L RatFunc.X) =
      (U b).valuation (η b) ^ (e b) := by
    rw [hX b, map_mul, map_pow, hub, mul_one]
  have hd0 : c ^ (p * e b) ≠ 0 := pow_ne_zero _ hc0
  have hιd : (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω)
      (c ^ (p * e b)))) =
      (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ^ (p * e b) := by
    rw [map_pow, map_pow, map_pow]
  have hE4 : (U b).valuation (algebraMap (RatFunc Ω) L RatFunc.X) ^ (1 - k * (p : ℤ)) =
      (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ^ (p * e b) := by
    rw [hE3, ← zpow_natCast ((U b).valuation (η b)) (e b), ← zpow_mul, mul_comm ((e b : ℤ)),
      zpow_mul, hE2, zpow_natCast, ← pow_mul]
  have hne : (U b).valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ^
      (p * e b) ≠ 0 := pow_ne_zero _ hA0
  have hUb : ∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ U b ↔ wcEbAnInU W f :=
    (hU (U b)).mpr ⟨b, rfl⟩
  refine ⟨1 - k * (p : ℤ), hM0, c ^ (p * e b), hd0, (hUb _).mp ?_, (hUb _).mp ?_⟩
  · rw [← ValuationSubring.valuation_le_one_iff]
    simp only [map_div₀, map_zpow₀]
    rw [hE4, hιd, div_self hne]
  · rw [← ValuationSubring.valuation_le_one_iff]
    simp only [map_div₀, map_zpow₀]
    rw [hE4, hιd, div_self hne]

theorem wcpa_dj_lr1k_eb_pd_es_window_monomial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (N : ℤ), N ≠ 0 → ∀ d : Ω, d ≠ 0 → ¬ (wcEbAnInU W (RatFunc.X ^ N / algebraMap Ω (RatFunc Ω) d) ∧ wcEbAnInU W (algebraMap Ω (RatFunc Ω) d / RatFunc.X ^ N)) :=
by
  intro Ω _ _ W N hN d hd

  have s1 : ∀ (n : ℕ) (d c : Ω), d ≠ 0 → c ≠ 0 →
      wcEbAnInOc W c (RatFunc.X ^ n / algebraMap Ω (RatFunc Ω) d) → c ^ n / d ∈ W := by
    intro n d c hd hc ⟨p, q, i, hqi, hf, _, hp⟩
    have hqi' : q.coeff i ≠ 0 := left_ne_zero_of_mul hqi
    have hdne : algebraMap Ω (RatFunc Ω) d ≠ 0 := (map_ne_zero _).mpr hd
    have hpoly : Polynomial.X ^ n * q = Polynomial.C d * p := by
      apply RatFunc.algebraMap_injective Ω
      rw [map_mul, map_mul, map_pow, RatFunc.algebraMap_X, RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C, ← hf]
      field_simp
    have hco : q.coeff i = d * p.coeff (i + n) := by
      have := congrArg (fun r => Polynomial.coeff r (i + n)) hpoly
      simpa only [Polynomial.coeff_X_pow_mul, Polynomial.coeff_C_mul] using this
    have hpn : p.coeff (i + n) ≠ 0 := by
      intro h; apply hqi'; rw [hco, h, mul_zero]
    have e : c ^ n / d = p.coeff (i + n) * c ^ (i + n) / (q.coeff i * c ^ i) := by
      rw [hco, pow_add]
      field_simp
    rw [e]
    exact hp (i + n)

  have s2 : ∀ (n : ℕ) (d c : Ω), d ≠ 0 → c ≠ 0 →
      wcEbAnInOc W c (algebraMap Ω (RatFunc Ω) d / RatFunc.X ^ n) → d / c ^ n ∈ W := by
    intro n d c hd hc ⟨p, q, i, hqi, hf, _, hp⟩
    have hqi' : q.coeff i ≠ 0 := left_ne_zero_of_mul hqi
    have hXne : (RatFunc.X : RatFunc Ω) ^ n ≠ 0 := pow_ne_zero _ RatFunc.X_ne_zero
    have hpoly : Polynomial.C d * q = Polynomial.X ^ n * p := by
      apply RatFunc.algebraMap_injective Ω
      rw [map_mul, map_mul, map_pow, RatFunc.algebraMap_X, RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C, ← hf]
      field_simp
    have hco := congrArg (fun r => Polynomial.coeff r i) hpoly
    simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul'] at hco
    have hni : n ≤ i := by
      by_contra h
      rw [if_neg h] at hco
      exact mul_ne_zero hd hqi' hco
    rw [if_pos hni] at hco
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hni
    rw [Nat.add_sub_cancel_left] at hco
    have e : d / c ^ n = p.coeff k * c ^ k / (q.coeff (n + k) * c ^ (n + k)) := by
      rw [← hco, pow_add]
      field_simp
    have := hp k
    rw [e]
    exact this

  have core : ∀ (n : ℕ), n ≠ 0 → ∀ d : Ω, d ≠ 0 →
      ¬ (wcEbAnInU W (RatFunc.X ^ n / algebraMap Ω (RatFunc Ω) d) ∧
        wcEbAnInU W (algebraMap Ω (RatFunc Ω) d / RatFunc.X ^ n)) := by
    intro n hn d hd ⟨⟨c₀, h0, hv0, Hf⟩, ⟨c₁, h1, hv1, Hg⟩⟩
    obtain ⟨cs, hcs0, hvcs, hc0s, hc1s⟩ : ∃ cs : Ω, cs ≠ 0 ∧ W.valuation cs < 1 ∧
        c₀ / cs ∈ W ∧ c₁ / cs ∈ W := by
      rcases W.mem_or_inv_mem (c₀ / c₁) with h | h
      · exact ⟨c₁, h1, hv1, h, by rw [div_self h1]; exact W.one_mem⟩
      · refine ⟨c₀, h0, hv0, by rw [div_self h0]; exact W.one_mem, ?_⟩
        rwa [inv_div] at h
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq cs (n := 2) two_pos
    have hcc : c * c = cs := by rw [← hc, sq]
    have hc0 : c ≠ 0 := by rintro rfl; apply hcs0; rw [← hcc, mul_zero]
    have hvc : W.valuation c < 1 := by
      by_contra h
      push_neg at h
      have h2 : 1 ≤ W.valuation (c * c) := by
        rw [Valuation.map_mul]; exact one_le_mul_of_one_le_of_one_le h h
      rw [hcc] at h2
      exact absurd hvcs (not_lt.mpr h2)
    have hcW : c ∈ W := (W.valuation_le_one_iff c).mp hvc.le
    have adm_c : c₀ / c ∈ W := by
      have e : c₀ / c = (c₀ / cs) * c := by rw [← hcc]; field_simp
      rw [e]; exact mul_mem hc0s hcW
    have hA := s1 n d c hd hc0 (Hf c hc0 hvc adm_c)
    have hB := s2 n d (c * c) hd (mul_ne_zero hc0 hc0)
      (Hg (c * c) (mul_ne_zero hc0 hc0) (by rw [hcc]; exact hvcs) (by rw [hcc]; exact hc1s))
    have hprod : (c ^ n)⁻¹ ∈ W := by
      have e : (c ^ n)⁻¹ = c ^ n / d * (d / (c * c) ^ n) := by
        rw [mul_pow]; field_simp
      rw [e]; exact mul_mem hA hB
    have hv1' : W.valuation ((c ^ n)⁻¹) ≤ 1 := (W.valuation_le_one_iff _).mpr hprod
    have hvn : W.valuation (c ^ n) < 1 := by
      rw [Valuation.map_pow]; exact pow_lt_one₀ zero_le hvc hn
    have h1' : W.valuation (c ^ n * (c ^ n)⁻¹) = 1 := by
      rw [mul_inv_cancel₀ (pow_ne_zero _ hc0), Valuation.map_one]
    rw [Valuation.map_mul] at h1'
    have h3 : W.valuation (c ^ n) * W.valuation ((c ^ n)⁻¹) ≤ W.valuation (c ^ n) :=
      mul_le_of_le_one_right' hv1'
    rw [h1'] at h3
    exact absurd hvn (not_lt.mpr h3)

  rintro ⟨H1, H2⟩
  rcases Int.eq_nat_or_neg N with ⟨n, rfl | rfl⟩
  · have hn : n ≠ 0 := by rintro rfl; exact hN (by simp)
    rw [zpow_natCast] at H1 H2
    exact core n hn d hd ⟨H1, H2⟩
  · have hn : n ≠ 0 := by rintro rfl; exact hN (by simp)
    have hXne : (RatFunc.X : RatFunc Ω) ^ n ≠ 0 := pow_ne_zero _ RatFunc.X_ne_zero
    have hdne : algebraMap Ω (RatFunc Ω) d ≠ 0 := (map_ne_zero _).mpr hd
    have e1 : (RatFunc.X : RatFunc Ω) ^ (-(n : ℤ)) / algebraMap Ω (RatFunc Ω) d =
        algebraMap Ω (RatFunc Ω) d⁻¹ / RatFunc.X ^ n := by
      rw [zpow_neg, zpow_natCast, map_inv₀]; field_simp
    have e2 : algebraMap Ω (RatFunc Ω) d / (RatFunc.X : RatFunc Ω) ^ (-(n : ℤ)) =
        RatFunc.X ^ n / algebraMap Ω (RatFunc Ω) d⁻¹ := by
      rw [zpow_neg, zpow_natCast, map_inv₀]; field_simp
    rw [e1] at H1
    rw [e2] at H2
    exact core n hn d⁻¹ (inv_ne_zero hd) ⟨H2, H1⟩

theorem wcpa_dj_lr1k_eb_pd_es_pth_transfer : ∀ (L : Type u) [Field L] (p : ℕ) [Fact p.Prime] [CharP L p] (x y : L), (∀ z : L, ∃ a : Fin p → L, z = ∑ j : Fin p, a j ^ p * x ^ (j : ℕ)) → (∀ w : L, w ^ p ≠ y) → ∀ z : L, ∃ a : Fin p → L, z = ∑ j : Fin p, a j ^ p * y ^ (j : ℕ) :=
by
  intro L _ p _ _ x y hx hy z
  have hp : p.Prime := Fact.out
  set K : Subfield L := (frobenius L p).fieldRange with hK
  have memK : ∀ c : L, c ∈ K ↔ ∃ a : L, a ^ p = c := by
    intro c
    rw [hK, RingHom.mem_fieldRange]
    simp only [frobenius_def]
  have hspan : Submodule.span K (Set.range (fun j : Fin p => x ^ (j : ℕ))) = ⊤ := by
    rw [eq_top_iff]
    intro w _
    obtain ⟨a, ha⟩ := hx w
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun j => ⟨a j ^ p, (memK _).2 ⟨a j, rfl⟩⟩, ?_⟩
    rw [ha]
    rfl
  have : FiniteDimensional K L := by
    apply Module.Finite.of_fg_top
    rw [← hspan]
    exact Submodule.fg_span (Set.finite_range _)
  have hle : Module.finrank K L ≤ p := by
    have := finrank_le_of_span_eq_top hspan
    simpa using this
  let cK : K := ⟨y ^ p, (memK _).2 ⟨y, rfl⟩⟩
  have hnoroot : ∀ b : K, b ^ p ≠ cK := by
    intro b hb
    have h1 : (b : L) ^ p = y ^ p := by
      have := congrArg (fun t : K => (t : L)) hb
      simpa [cK] using this
    have h2 : (b : L) = y := frobenius_inj L p (by simpa [frobenius_def] using h1)
    obtain ⟨w, hw⟩ := (memK _).1 b.2
    exact hy w (hw.trans h2)
  have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C cK) :=
    X_pow_sub_C_irreducible_of_prime hp hnoroot
  have haeval : Polynomial.aeval y (Polynomial.X ^ p - Polynomial.C cK) = 0 := by
    rw [map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C]
    show y ^ p - y ^ p = 0
    exact sub_self _
  have hmonic := Polynomial.monic_X_pow_sub_C cK hp.ne_zero
  have hmin := minpoly.eq_of_irreducible_of_monic hirr haeval hmonic
  have hdeg : (minpoly K y).natDegree = p := by
    rw [← hmin, Polynomial.natDegree_X_pow_sub_C]
  have hli : LinearIndependent K (fun j : Fin p => y ^ (j : ℕ)) := by
    have := linearIndependent_pow (K := K) y
    rw [hdeg] at this
    exact this
  have hcard : Fintype.card (Fin p) = Module.finrank K L := by
    have := hli.fintype_card_le_finrank
    rw [Fintype.card_fin] at this ⊢
    omega
  have hspan2 := hli.span_eq_top_of_card_eq_finrank' hcard
  have hz : z ∈ Submodule.span K (Set.range (fun j : Fin p => y ^ (j : ℕ))) := by
    rw [hspan2]; trivial
  rw [Submodule.mem_span_range_iff_exists_fun] at hz
  obtain ⟨c, hc⟩ := hz
  choose a ha using fun j => (memK _).1 (c j).2
  refine ⟨a, ?_⟩
  rw [← hc]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [ha j]
  rfl

theorem wcpa_dj_lr1k_eb_pd_es_sep_of_decomp : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] (p : ℕ) [Fact p.Prime] [CharP L p] (y : L), y ∈ (algebraMap K L).range → (∀ z : L, ∃ a : Fin p → L, z = ∑ j : Fin p, a j ^ p * y ^ (j : ℕ)) → Algebra.IsSeparable K L :=
by
  intro K L _ _ _ _ p _ _ y hy hdec
  obtain ⟨c, hc⟩ := hy
  have : ExpChar L p := ExpChar.prime (Fact.out)
  have hyS : y ∈ separableClosure K L := hc ▸ (separableClosure K L).algebraMap_mem c
  obtain ⟨e, he⟩ := (IsPurelyInseparable.hasExponent_iff' (separableClosure K L) L p).mp
    inferInstance
  have heS : ∀ a : L, a ^ p ^ e ∈ separableClosure K L := by
    intro a
    obtain ⟨s, hs⟩ := he a
    rw [← hs]
    exact s.2
  have step : ∀ n : ℕ, (∀ a : L, a ^ p ^ (n + 1) ∈ separableClosure K L) →
      ∀ a : L, a ^ p ^ n ∈ separableClosure K L := by
    intro n hn a
    obtain ⟨b, hb⟩ := hdec a
    rw [hb, sum_pow_char_pow]
    refine sum_mem (fun j _ => ?_)
    rw [mul_pow]
    refine mul_mem ?_ (pow_mem (pow_mem hyS _) _)
    rw [← pow_mul, ← pow_succ']
    exact hn _
  have desc : ∀ m n : ℕ, (∀ a : L, a ^ p ^ (n + m) ∈ separableClosure K L) →
      ∀ a : L, a ^ p ^ n ∈ separableClosure K L := by
    intro m
    induction m with
    | zero => intro n h; simpa using h
    | succ m ih =>
      intro n h
      apply step n
      apply ih (n + 1)
      rw [show n + 1 + m = n + (m + 1) by omega]
      exact h
  have hall : ∀ a : L, a ∈ separableClosure K L := by
    intro a
    have := desc e 0 (by rw [zero_add]; exact heS) a
    simpa using this
  rw [Algebra.isSeparable_def]
  intro x
  exact mem_separableClosure_iff.mp (hall x)

theorem wcpa_dj_lr1k_eb_pd_eta_separable : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
