        _ = Ideal.span {ℓ} * m ^ 2 := by ring
        _ = Ideal.span {ℓ} * (Ideal.span {ℓ} * m) := by rw [hB]
    refine ⟨?_, hB, ?_⟩
    · rw [mem_nonZeroDivisors_iff_right]
      intro a ha
      by_contra ha0
      have hnil : a ∉ nilradical R := by
        intro h
        exact ha0 (hred.eq_zero a h)
      rw [nilradical_eq_sInf, Submodule.mem_sInf] at hnil
      push_neg at hnil
      obtain ⟨P, hP, haP⟩ := hnil
      haveI hPp : Ideal.IsPrime P := hP
      obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_minimalPrimes_le (I := ⊥) (J := P) bot_le
      have hQp : Q.IsPrime := hQ.1.1
