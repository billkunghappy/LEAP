      obtain ⟨a, j, ha, hcj, hlt⟩ := ih hp
      refine ⟨a, j + 1, ha, by rw [Polynomial.coeff_mul_X]; exact hcj, ?_⟩
      have e1 : Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
            (η b) (p * Polynomial.X) -
          algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) a) * η b ^ (j + 1) =
