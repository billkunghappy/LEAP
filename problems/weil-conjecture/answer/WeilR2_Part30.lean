theorem wcpa_dj_lr1k_eb_ep_conductor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (L : Type u) [Field L] [Algebra (RatFunc Ω) L]
    [FiniteDimensional (RatFunc Ω) L] (g : ↥W), g ≠ 0 → g ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ η : L, (∀ p : Polynomial Ω, Polynomial.eval₂
        ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) η p = 0 → p = 0) →
    ∀ ζ : L, IsIntegral ↥(wcEbEpD W L (g : Ω) η) ζ →
      (∀ p : Polynomial ↥(wcEbEpD W L (g : Ω) η), p ≠ 0 → Polynomial.aeval ζ p = 0 →
        (minpoly ↥(wcEbEpD W L (g : Ω) η) ζ).natDegree ≤ p.natDegree) ∧
      ((∀ z : L, ∃ (p : Polynomial ↥(wcEbEpD W L (g : Ω) η)) (d : ↥(wcEbEpD W L (g : Ω) η)),
          d ≠ 0 ∧ (d : L) * z = Polynomial.aeval ζ p) →
        Polynomial.aeval ζ (Polynomial.derivative (minpoly ↥(wcEbEpD W L (g : Ω) η) ζ)) ≠ 0 →
        ∀ z : L, IsIntegral ↥(wcEbEpD W L (g : Ω) η) z →
          ∃ P : Polynomial ↥(wcEbEpD W L (g : Ω) η),
            Polynomial.aeval ζ (Polynomial.derivative (minpoly ↥(wcEbEpD W L (g : Ω) η) ζ)) * z =
              Polynomial.aeval ζ P) :=
by
  classical
  intro Ω _ _ W L _ _ _ g hg0 hgm η htr ζ hζ

  let ι₀ : Ω →+* L := (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))
  let φ : Polynomial Ω →+* L := Polynomial.eval₂RingHom ι₀ η
  have hφ : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro p hp
    exact htr p hp
  let τ : RatFunc Ω →+* L := IsFractionRing.lift (K := RatFunc Ω) hφ
  have hτ : Function.Injective τ := τ.injective
  have hτC : ∀ w : Ω, τ (algebraMap Ω (RatFunc Ω) w) = ι₀ w := by
    intro w
    have h1 : algebraMap Ω (RatFunc Ω) w =
