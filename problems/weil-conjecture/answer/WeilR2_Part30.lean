    unfold wcEbBdResDeg
    exact Module.finrank_pos

theorem wcpa_dj_lr1k_eb_bd_lb_gauss_residue_equiv : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (V : ValuationSubring (RatFunc Ω)), V.toSubring = wcEbGauss W → ∃ θ : RatFunc (IsLocalRing.ResidueField ↥W) ≃+* IsLocalRing.ResidueField ↥V, (∀ h : (RatFunc.X : RatFunc Ω) ∈ V, θ RatFunc.X = IsLocalRing.residue ↥V ⟨RatFunc.X, h⟩) ∧ ∀ (w : ↥W) (h : algebraMap Ω (RatFunc Ω) (w : Ω) ∈ V), θ (algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.residue ↥W w)) = IsLocalRing.residue ↥V ⟨algebraMap Ω (RatFunc Ω) (w : Ω), h⟩ :=
by
  classical
  intro Ω _ _ W V hV

  have key : ∀ (x : Ω) (R : Polynomial Ω),
      algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x * R) =
        algebraMap Ω (RatFunc Ω) x * algebraMap (Polynomial Ω) (RatFunc Ω) R := by
    intro x R
    rw [map_mul, Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply]
  have hCx : ∀ x : Ω, algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x) =
      algebraMap Ω (RatFunc Ω) x := by
    intro x
    have h := key x 1
    rwa [mul_one, map_one, mul_one] at h
  have alg_inj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
    RatFunc.algebraMap_injective Ω
  have g0 : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.map W.subtype ≠ 0 := by
    rintro q ⟨i, hi⟩ h
    have h1 := congrArg (fun P => P.coeff i) h
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
    have h2 : q.coeff i = 0 := Subtype.ext h1
    exact hi.ne_zero h2

  have s1 : ∀ P Q : Polynomial ↥W, (∃ i, IsUnit (P.coeff i)) → (∃ j, IsUnit (Q.coeff j)) →
      ∃ k, IsUnit ((P * Q).coeff k) := by
    rintro P Q ⟨i, hi⟩ ⟨j, hj⟩
    have hP : P.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have h1 := congrArg (fun R => R.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h1
    have hQ : Q.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have h1 := congrArg (fun R => R.coeff j) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hj h1
    have hPQ : (P * Q).map (IsLocalRing.residue ↥W) ≠ 0 := by
      rw [Polynomial.map_mul]
      exact mul_ne_zero hP hQ
    obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hPQ
    rw [Polynomial.mem_support_iff, Polynomial.coeff_map] at hk
    exact ⟨k, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hk⟩

  have s2 : ∀ P : Polynomial Ω, P ≠ 0 → ∃ (a : Ω) (P₀ : Polynomial ↥W), a ≠ 0 ∧
      (∃ i, IsUnit (P₀.coeff i)) ∧ P = Polynomial.C a * P₀.map W.subtype := by
    intro P hP
    obtain ⟨j, hj, hmax⟩ := Finset.exists_max_image P.support
      (fun n => W.valuation (P.coeff n)) (Polynomial.support_nonempty.mpr hP)
    have ha0 : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hcoef : ∀ n, (P.coeff j)⁻¹ * P.coeff n ∈ W := by
      intro n
      by_cases hn : P.coeff n = 0
      · rw [hn, mul_zero]; exact W.zero_mem
      · rw [← ValuationSubring.valuation_le_one_iff]
        have hle := hmax n (Polynomial.mem_support_iff.mpr hn)
        calc W.valuation ((P.coeff j)⁻¹ * P.coeff n)
            = W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff n) := Valuation.map_mul _ _ _
          _ ≤ W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff j) := by gcongr
          _ = W.valuation ((P.coeff j)⁻¹ * P.coeff j) := (Valuation.map_mul _ _ _).symm
          _ = 1 := by rw [inv_mul_cancel₀ ha0, Valuation.map_one]
    have hlift : Polynomial.C (P.coeff j)⁻¹ * P ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_C_mul]
      exact ⟨⟨_, hcoef n⟩, rfl⟩
    obtain ⟨P₀, hP₀⟩ := (Polynomial.mem_lifts _).mp hlift
    refine ⟨P.coeff j, P₀, ha0, ⟨j, ?_⟩, ?_⟩
    · have h1 : ((P₀.coeff j : ↥W) : Ω) = 1 := by
        have h3 := congrArg (fun R => R.coeff j) hP₀
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at h3
        rw [inv_mul_cancel₀ ha0] at h3
        exact h3
      have h2 : P₀.coeff j = 1 := Subtype.ext h1
      rw [h2]
      exact isUnit_one
    · rw [hP₀, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1, one_mul]

  have s3 : ∀ f : RatFunc Ω, f ≠ 0 → ∃ (a : Ω) (N D : Polynomial ↥W), a ≠ 0 ∧
      (∃ i, IsUnit (N.coeff i)) ∧ (∃ j, IsUnit (D.coeff j)) ∧
      f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) =
        algebraMap Ω (RatFunc Ω) a * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) := by
    intro f hf
    have hnum : f.num ≠ 0 := RatFunc.num_ne_zero hf
    have hden : f.denom ≠ 0 := RatFunc.denom_ne_zero f
    obtain ⟨a₁, N, ha₁, hN, hNe⟩ := s2 _ hnum
    obtain ⟨b, D, hb, hD, hDe⟩ := s2 _ hden
    refine ⟨a₁ / b, N, D, div_ne_zero ha₁ hb, hN, hD, ?_⟩
    have hd0 : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 := by
      intro h
      apply hden
      apply alg_inj
      rw [h, map_zero]
    have hf' : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
        algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
      have hnd := RatFunc.num_div_denom f
      calc f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom
          = (algebraMap (Polynomial Ω) (RatFunc Ω) f.num /
              algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) *
              algebraMap (Polynomial Ω) (RatFunc Ω) f.denom := by rw [hnd]
        _ = algebraMap (Polynomial Ω) (RatFunc Ω) f.num := div_mul_cancel₀ _ hd0
    rw [hNe, hDe, key, key] at hf'
    have hcb : algebraMap Ω (RatFunc Ω) b ≠ 0 := (map_ne_zero _).mpr hb
    rw [map_div₀, div_mul_eq_mul_div, eq_div_iff hcb, ← hf']
    ring

  obtain ⟨T, hT⟩ : ∃ T : Subring (RatFunc Ω), ∀ f : RatFunc Ω, f ∈ T ↔
      ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ q.map W.subtype ≠ 0 ∧
        f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
          algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) := by
    refine ⟨{ carrier := {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
                q.map W.subtype ≠ 0 ∧
                f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
                  algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)}
              mul_mem' := ?_
              one_mem' := ?_
              add_mem' := ?_
              zero_mem' := ?_
              neg_mem' := ?_ }, fun f => Iff.rfl⟩
    · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
      have hq := s1 q₁ q₂ hq₁ hq₂
      refine ⟨p₁ * p₂, q₁ * q₂, hq, g0 _ hq, ?_⟩
      rw [Polynomial.map_mul, Polynomial.map_mul, map_mul, map_mul, ← h₁, ← h₂]
      ring
    · exact ⟨1, 1, ⟨0, by simp⟩, by simp, by simp⟩
    · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
      have hq := s1 q₁ q₂ hq₁ hq₂
      refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, hq, g0 _ hq, ?_⟩
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_mul, map_add,
        map_mul, map_mul, map_mul, ← h₁, ← h₂]
      ring
    · exact ⟨0, 1, ⟨0, by simp⟩, by simp, by simp⟩
    · rintro f ⟨p, q, hq, hq0, h⟩
      refine ⟨-p, q, hq, hq0, ?_⟩
      rw [Polynomial.map_neg, map_neg, ← h]
      ring

  have hVsub : V.toSubring = T := by
    rw [hV]
    unfold wcEbGauss
    apply le_antisymm
    · exact Subring.closure_le.mpr (fun f hf => (hT f).mpr hf)
    · intro f hf
      exact Subring.subset_closure ((hT f).mp hf)
  have hVT : ∀ f : RatFunc Ω, f ∈ V ↔ f ∈ T := by
    intro f
    show f ∈ V.toSubring ↔ f ∈ T
    rw [hVsub]

  have hC2 : ∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W := by
    intro a
    rw [hVT, hT]
    constructor
    · rintro ⟨p, q, hq, -, h⟩
      rw [← key] at h
      have h2 := alg_inj h
      obtain ⟨i, hi⟩ := hq
      have h3 := congrArg (fun R => R.coeff i) h2
      simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map] at h3
      obtain ⟨w, hw⟩ := hi.exists_left_inv
      have h4 : a = W.subtype (p.coeff i) * W.subtype w := by
        rw [← h3, mul_assoc, ← map_mul, mul_comm (q.coeff i) w, hw, map_one, mul_one]
      rw [h4]
      exact (p.coeff i * w).2
    · intro h
      refine ⟨Polynomial.C ⟨a, h⟩, 1, ⟨0, by simp⟩, by simp, ?_⟩
      rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C]
      exact (hCx a).symm

  have hpoly : ∀ p : Polynomial ↥W,
      algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) ∈ V := by
    intro p
    rw [hVT, hT]
    exact ⟨p, 1, ⟨0, by simp⟩, by simp, by simp⟩
  have hn0 : ∀ p : Polynomial ↥W, (∃ i, IsUnit (p.coeff i)) →
      algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) ≠ 0 :=
    fun p hp h => g0 p hp (alg_inj (h.trans (map_zero _).symm))
  have hpinv : ∀ p : Polynomial ↥W, (∃ i, IsUnit (p.coeff i)) →
      (algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype))⁻¹ ∈ V := by
    intro p hp
    rw [hVT, hT]
    refine ⟨1, p, hp, g0 p hp, ?_⟩
    rw [Polynomial.map_one, map_one]
    exact inv_mul_cancel₀ (hn0 p hp)
  have rescongr' : ∀ x y : ↥V, (x : RatFunc Ω) = (y : RatFunc Ω) →
      IsLocalRing.residue ↥V x = IsLocalRing.residue ↥V y :=
    fun x y h => congrArg _ (Subtype.ext h)
  have hunitres : ∀ p : Polynomial ↥W, (∃ i, IsUnit (p.coeff i)) →
      IsLocalRing.residue ↥V ⟨algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype), hpoly p⟩
        ≠ 0 := by
    intro p hp
    rw [IsLocalRing.residue_ne_zero_iff_isUnit]
    exact isUnit_iff_exists_inv.mpr ⟨⟨_, hpinv p hp⟩, Subtype.ext (mul_inv_cancel₀ (hn0 p hp))⟩
  have hX : (RatFunc.X : RatFunc Ω) ∈ V := by
    have h := hpoly Polynomial.X
    rwa [Polynomial.map_X, RatFunc.algebraMap_X] at h

  obtain ⟨ψ, hψ⟩ : ∃ ψ : ↥W →+* ↥V, ∀ w : ↥W,
      ((ψ w : ↥V) : RatFunc Ω) = algebraMap Ω (RatFunc Ω) (w : Ω) :=
    ⟨RingHom.codRestrict ((algebraMap Ω (RatFunc Ω)).comp W.subtype) V
      (fun w => (hC2 w).2 w.2), fun w => rfl⟩
  haveI : IsLocalHom ψ := by
    constructor
    intro w hw
    obtain ⟨u, hu⟩ := hw
    have h1 : (((u⁻¹ : (↥V)ˣ) : ↥V) : RatFunc Ω) * algebraMap Ω (RatFunc Ω) (w : Ω) = 1 := by
      rw [← hψ, ← hu]
      exact congrArg Subtype.val u.inv_mul
    have hw0 : (w : Ω) ≠ 0 := by
      intro h
      rw [h, map_zero, mul_zero] at h1
      exact zero_ne_one h1
    have hinv : (w : Ω)⁻¹ ∈ W := by
      rw [← hC2, map_inv₀, ← eq_inv_of_mul_eq_one_left h1]
      exact ((u⁻¹ : (↥V)ˣ) : ↥V).2
    exact isUnit_iff_exists_inv.mpr ⟨⟨_, hinv⟩, Subtype.ext (mul_inv_cancel₀ hw0)⟩

  obtain ⟨θ₀, hθ₀C, hθ₀X⟩ : ∃ θ₀ : Polynomial (IsLocalRing.ResidueField ↥W) →+*
      IsLocalRing.ResidueField ↥V,
      (∀ r, θ₀ (Polynomial.C r) = IsLocalRing.ResidueField.map ψ r) ∧
      θ₀ Polynomial.X = IsLocalRing.residue ↥V ⟨RatFunc.X, hX⟩ :=
    ⟨Polynomial.eval₂RingHom (IsLocalRing.ResidueField.map ψ)
      (IsLocalRing.residue ↥V ⟨RatFunc.X, hX⟩),
      fun r => Polynomial.eval₂_C _ _, Polynomial.eval₂_X _ _⟩

  have hkeyfun : θ₀.comp (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) =
      (IsLocalRing.residue ↥V).comp (RingHom.codRestrict
        ((algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype)) V
        (fun p => hpoly p)) := by
    apply Polynomial.ringHom_ext
    · intro a
      show θ₀ ((Polynomial.C a).map (IsLocalRing.residue ↥W)) =
        IsLocalRing.residue ↥V ⟨algebraMap (Polynomial Ω) (RatFunc Ω)
          ((Polynomial.C a).map W.subtype), hpoly _⟩
      calc θ₀ ((Polynomial.C a).map (IsLocalRing.residue ↥W))
          = θ₀ (Polynomial.C (IsLocalRing.residue ↥W a)) := by rw [Polynomial.map_C]
        _ = IsLocalRing.ResidueField.map ψ (IsLocalRing.residue ↥W a) := hθ₀C _
        _ = IsLocalRing.residue ↥V (ψ a) := IsLocalRing.ResidueField.map_residue ψ a
        _ = _ := by
          apply rescongr'
          rw [hψ]
          show algebraMap Ω (RatFunc Ω) (a : Ω) =
            algebraMap (Polynomial Ω) (RatFunc Ω) ((Polynomial.C a).map W.subtype)
          rw [Polynomial.map_C, hCx]
          rfl
    · show θ₀ ((Polynomial.X : Polynomial ↥W).map (IsLocalRing.residue ↥W)) =
        IsLocalRing.residue ↥V ⟨algebraMap (Polynomial Ω) (RatFunc Ω)
          ((Polynomial.X : Polynomial ↥W).map W.subtype), hpoly _⟩
      calc θ₀ ((Polynomial.X : Polynomial ↥W).map (IsLocalRing.residue ↥W))
          = θ₀ Polynomial.X := by rw [Polynomial.map_X]
        _ = IsLocalRing.residue ↥V ⟨RatFunc.X, hX⟩ := hθ₀X
        _ = _ := by
          apply rescongr'
          show (RatFunc.X : RatFunc Ω) = algebraMap (Polynomial Ω) (RatFunc Ω)
            ((Polynomial.X : Polynomial ↥W).map W.subtype)
          rw [Polynomial.map_X, RatFunc.algebraMap_X]
  have hkey : ∀ p : Polynomial ↥W, θ₀ (p.map (IsLocalRing.residue ↥W)) =
      IsLocalRing.residue ↥V ⟨algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype), hpoly p⟩ :=
    fun p => RingHom.congr_fun hkeyfun p
  have hCw : ∀ w : ↥W, θ₀ (Polynomial.C (IsLocalRing.residue ↥W w)) =
      IsLocalRing.residue ↥V ⟨algebraMap Ω (RatFunc Ω) (w : Ω), (hC2 _).2 w.2⟩ := by
    intro w
    rw [hθ₀C, IsLocalRing.ResidueField.map_residue]
    exact rescongr' _ _ (hψ w)

  have hθ₀ne : ∀ pb : Polynomial (IsLocalRing.ResidueField ↥W), pb ≠ 0 → θ₀ pb ≠ 0 := by
    intro pb hpb
    obtain ⟨p, rfl⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
      IsLocalRing.residue_surjective pb
    have hp : ∃ i, IsUnit (p.coeff i) := by
      obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hpb
      rw [Polynomial.mem_support_iff, Polynomial.coeff_map] at hk
      exact ⟨k, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hk⟩
    rw [hkey]
    exact hunitres p hp
  have hφ : nonZeroDivisors (Polynomial (IsLocalRing.ResidueField ↥W)) ≤
      (nonZeroDivisors (IsLocalRing.ResidueField ↥V)).comap θ₀ :=
    fun q hq => mem_nonZeroDivisors_of_ne_zero (hθ₀ne q (nonZeroDivisors.ne_zero hq))
  obtain ⟨θ', hdiv⟩ : ∃ θ' : RatFunc (IsLocalRing.ResidueField ↥W) →+*
      IsLocalRing.ResidueField ↥V, ∀ p q,
      θ' (algebraMap _ _ p / algebraMap _ _ q) = θ₀ p / θ₀ q :=
    ⟨RatFunc.liftRingHom θ₀ hφ, RatFunc.liftRingHom_apply_div θ₀ hφ⟩
  have hL1 : ∀ p, θ' (algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
      (RatFunc (IsLocalRing.ResidueField ↥W)) p) = θ₀ p := by
    intro p
    have h := hdiv p 1
    rwa [map_one, div_one, map_one, div_one] at h
  have hinj : Function.Injective θ' := θ'.injective
  have hsurj : Function.Surjective θ' := by
    intro y
    obtain ⟨⟨f, hf⟩, rfl⟩ := IsLocalRing.residue_surjective y
    by_cases hf0 : f = 0
    · refine ⟨0, ?_⟩
      rw [map_zero, ← map_zero (IsLocalRing.residue ↥V)]
      exact rescongr' _ _ hf0.symm
    obtain ⟨a, N, D, _, hN, hD, he⟩ := s3 f hf0
    have haW : a ∈ W := by
      rw [← hC2]
      have h1 : algebraMap Ω (RatFunc Ω) a =
          f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) *
            (algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype))⁻¹ := by
        rw [he, mul_assoc, mul_inv_cancel₀ (hn0 N hN), mul_one]
      rw [h1]
      exact mul_mem (mul_mem hf (hpoly D)) (hpinv N hN)
    refine ⟨algebraMap _ _ (Polynomial.C (IsLocalRing.residue ↥W ⟨a, haW⟩) *
      N.map (IsLocalRing.residue ↥W)) / algebraMap _ _ (D.map (IsLocalRing.residue ↥W)), ?_⟩
    rw [hdiv, map_mul, hCw, hkey N, hkey D, div_eq_iff (hunitres D hD)]
    have hprod : (⟨f, hf⟩ : ↥V) * ⟨_, hpoly D⟩ =
        ⟨algebraMap Ω (RatFunc Ω) a, (hC2 _).2 haW⟩ * ⟨_, hpoly N⟩ := Subtype.ext he
    have h2 := congrArg (IsLocalRing.residue ↥V) hprod
    rw [map_mul, map_mul] at h2
    exact h2.symm
  refine ⟨RingEquiv.ofBijective θ' ⟨hinj, hsurj⟩, ?_, ?_⟩
  · intro h
    show θ' RatFunc.X = _
    rw [← RatFunc.algebraMap_X (K := IsLocalRing.ResidueField ↥W), hL1, hθ₀X]
  · intro w h
    show θ' (algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W))
      (IsLocalRing.residue ↥W w)) = _
    rw [RatFunc.algebraMap_eq_C (K := IsLocalRing.ResidueField ↥W), ← RatFunc.algebraMap_C, hL1,
      hCw]

theorem wcpa_dj_lr1k_eb_cg_gauss_formula : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (V : ValuationSubring (RatFunc Ω)), V.toSubring = wcEbGauss W →
    (∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W) →
    ∀ R : Polynomial Ω,
      (∀ j, V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j)) ≤
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R)) ∧
      ∃ j, V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) =
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j)) :=
by
  intro Ω _ W V hV H1 R
  classical

  have hmem : ∀ f : RatFunc Ω, f ∈ wcEbGauss W → f ∈ V := by
    intro f hf
    rw [← hV] at hf
    exact hf
  have prim : ∀ R' : Polynomial Ω, (∀ j, R'.coeff j ∈ W) → (∃ i, R'.coeff i = 1) →
      V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R') = 1 := by
    intro R' hW hex
    obtain ⟨i, hi⟩ := hex
    have hlift : R' ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨R'.coeff n, hW n⟩, rfl⟩
    obtain ⟨R'', hR''⟩ := (Polynomial.mem_lifts R').mp hlift
    have hci : R''.coeff i = 1 := by
      apply Subtype.ext
      have h := Polynomial.coeff_map (p := R'') W.subtype i
      rw [hR'', hi] at h
      exact h.symm
    have hR'0 : R' ≠ 0 := by
      intro h
      rw [h, Polynomial.coeff_zero] at hi
      exact zero_ne_one hi
    have hg0 : algebraMap (Polynomial Ω) (RatFunc Ω) R' ≠ 0 := by
      intro h
      apply hR'0
      apply RatFunc.algebraMap_injective Ω
      rw [map_zero]
      exact h
    have h1 : algebraMap (Polynomial Ω) (RatFunc Ω) R' ∈ V := by
      apply hmem
      apply Subring.subset_closure
      refine ⟨R'', 1, ⟨0, ?_⟩, ?_, ?_⟩
      · rw [Polynomial.coeff_one_zero]; exact isUnit_one
      · rw [Polynomial.map_one]; exact one_ne_zero
      · rw [Polynomial.map_one, map_one, mul_one, hR'']
    have h2 : (algebraMap (Polynomial Ω) (RatFunc Ω) R')⁻¹ ∈ V := by
      apply hmem
      apply Subring.subset_closure
      refine ⟨1, R'', ⟨i, ?_⟩, ?_, ?_⟩
      · rw [hci]; exact isUnit_one
      · rw [hR'']; exact hR'0
      · rw [hR'', Polynomial.map_one, map_one, inv_mul_cancel₀ hg0]
    have e1 := (V.valuation_le_one_iff _).mpr h1
    have e2 := (V.valuation_le_one_iff _).mpr h2
    rw [map_inv₀] at e2
    have hv0 : V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R') ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr hg0
    exact le_antisymm e1 ((inv_le_one₀ (zero_lt_iff.mpr hv0)).mp e2)
  by_cases hR : R = 0
  · subst hR
    refine ⟨fun j => ?_, 0, ?_⟩
    · rw [Polynomial.coeff_zero, map_zero, map_zero, map_zero, map_zero]
    · rw [Polynomial.coeff_zero, map_zero, map_zero, map_zero, map_zero]
  · have hsupp : R.support.Nonempty := Polynomial.support_nonempty.mpr hR
    obtain ⟨j0, hj0, hmax⟩ := Finset.exists_max_image R.support
      (fun j => V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j))) hsupp
    have ha0 : R.coeff j0 ≠ 0 := Polynomial.mem_support_iff.mp hj0
    have hstar : ∀ j, V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j)) ≤
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j0)) := by
      intro j
      by_cases hj : j ∈ R.support
      · exact hmax j hj
      · rw [Polynomial.notMem_support_iff.mp hj, map_zero, map_zero]
        exact zero_le
    have hwa : 0 < V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j0)) :=
      zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr ((map_ne_zero _).mpr ha0))
    have hR'W : ∀ j, (Polynomial.C (R.coeff j0)⁻¹ * R).coeff j ∈ W := by
      intro j
      rw [Polynomial.coeff_C_mul, ← H1, ← V.valuation_le_one_iff, map_mul, map_mul, map_inv₀,
        map_inv₀, inv_mul_le_one₀ hwa]
      exact hstar j
    have hR'1 : (Polynomial.C (R.coeff j0)⁻¹ * R).coeff j0 = 1 := by
      rw [Polynomial.coeff_C_mul, inv_mul_cancel₀ ha0]
    have hν' := prim _ hR'W ⟨j0, hR'1⟩
    have hRe : R = Polynomial.C (R.coeff j0) * (Polynomial.C (R.coeff j0)⁻¹ * R) := by
      rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1, one_mul]
    have hν : V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) =
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j0)) := by
      have e : algebraMap (Polynomial Ω) (RatFunc Ω) R =
          algebraMap Ω (RatFunc Ω) (R.coeff j0) *
            algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C (R.coeff j0)⁻¹ * R) := by
        conv_lhs => rw [hRe]
        rw [map_mul, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
      rw [e, map_mul, hν', mul_one]
    exact ⟨fun j => hν ▸ hstar j, j0, hν⟩

theorem wcpa_dj_lr1k_eb_cg_inoc_iff : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (V : ValuationSubring (RatFunc Ω)),
    (∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W) →
    (∀ R : Polynomial Ω,
      (∀ j, V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j)) ≤
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R)) ∧
      ∃ j, V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) =
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j))) →
    ∀ (c : Ω), c ≠ 0 → ∀ (f : RatFunc Ω) (p q : Polynomial Ω), q ≠ 0 →
      f * algebraMap (Polynomial Ω) (RatFunc Ω) q = algebraMap (Polynomial Ω) (RatFunc Ω) p →
      (wcEbAnInOc W c f ↔
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
            (p.comp (Polynomial.C c * Polynomial.X))) ≤
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
            (q.comp (Polynomial.C c * Polynomial.X)))) :=
by
  intro Ω _ W V h1 hGF c hc f p q hq hf
  classical

  have hD : ∀ a b : Ω, b ≠ 0 → (a / b ∈ W ↔ V.valuation (algebraMap Ω (RatFunc Ω) a) ≤
      V.valuation (algebraMap Ω (RatFunc Ω) b)) := by
    intro a b hb
    have hb' : V.valuation (algebraMap Ω (RatFunc Ω) b) ≠ 0 := by
      rw [Valuation.ne_zero_iff]
      exact (map_ne_zero_iff _ (algebraMap Ω (RatFunc Ω)).injective).mpr hb
    rw [← h1, ← V.valuation_le_one_iff, map_div₀, Valuation.map_div]
    exact div_le_one₀ (zero_lt_iff.mpr hb')

  have hZ : ∀ R : Polynomial Ω, R ≠ 0 →
      V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) ≠ 0 := by
    intro R hR
    rw [Valuation.ne_zero_iff]
    exact (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial Ω) (RatFunc Ω))).mpr hR

  have hCC : ∀ P Q : Polynomial Ω,
      ((∃ i, Q.coeff i ≠ 0 ∧ (∀ j, Q.coeff j / Q.coeff i ∈ W) ∧
          (∀ j, P.coeff j / Q.coeff i ∈ W)) ↔
        (Q ≠ 0 ∧ V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) P) ≤
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) Q))) := by
    intro P Q
    constructor
    · rintro ⟨i, hi, hQ, hP⟩
      have hQ0 : Q ≠ 0 := fun h => hi (by rw [h, Polynomial.coeff_zero])
      obtain ⟨hQle, m, hm⟩ := hGF Q
      obtain ⟨-, k, hk⟩ := hGF P
      have e1 : V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) Q) =
          V.valuation (algebraMap Ω (RatFunc Ω) (Q.coeff i)) := by
        refine le_antisymm ?_ (hQle i)
        rw [hm]
        exact (hD _ _ hi).mp (hQ m)
      refine ⟨hQ0, ?_⟩
      rw [hk, e1]
      exact (hD _ _ hi).mp (hP k)
    · rintro ⟨hQ0, hle⟩
      obtain ⟨hQle, i, hi⟩ := hGF Q
      have hPle := (hGF P).1
      have hci : Q.coeff i ≠ 0 := by
        intro h
        apply hZ Q hQ0
        rw [hi, h, map_zero, map_zero]
      refine ⟨i, hci, fun j => (hD _ _ hci).mpr ?_, fun j => (hD _ _ hci).mpr ?_⟩
      · rw [← hi]; exact hQle j
      · rw [← hi]; exact (hPle j).trans hle

  have hnz : ∀ r : Polynomial Ω, r ≠ 0 → r.comp (Polynomial.C c * Polynomial.X) ≠ 0 := by
    intro r hr h
    apply hr
    ext j
    have h2 := congrArg (fun s => s.coeff j) h
    simp only [Polynomial.comp_C_mul_X_coeff, Polynomial.coeff_zero] at h2
    rw [Polynomial.coeff_zero]
    exact (mul_eq_zero.mp h2).resolve_right (pow_ne_zero _ hc)
  unfold wcEbAnInOc
  constructor
  · rintro ⟨p', q', i, hi, hf', hQ, hP⟩
    obtain ⟨hQ'0, hle'⟩ := (hCC (p'.comp (Polynomial.C c * Polynomial.X))
      (q'.comp (Polynomial.C c * Polynomial.X))).mp
      ⟨i, by rw [Polynomial.comp_C_mul_X_coeff]; exact hi,
        fun j => by rw [Polynomial.comp_C_mul_X_coeff, Polynomial.comp_C_mul_X_coeff]; exact hQ j,
        fun j => by rw [Polynomial.comp_C_mul_X_coeff, Polynomial.comp_C_mul_X_coeff]; exact hP j⟩
    have hpq : p * q' = p' * q := by
      apply IsFractionRing.injective (Polynomial Ω) (RatFunc Ω)
      rw [map_mul, map_mul, ← hf, ← hf']
      ring
    have hcomp : (p.comp (Polynomial.C c * Polynomial.X)) * (q'.comp (Polynomial.C c * Polynomial.X)) =
        (p'.comp (Polynomial.C c * Polynomial.X)) * (q.comp (Polynomial.C c * Polynomial.X)) := by
      rw [← Polynomial.mul_comp, ← Polynomial.mul_comp, hpq]
    have hval := congrArg (fun r => V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) r)) hcomp
    simp only [map_mul] at hval
    have hpos : 0 < V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
        (q'.comp (Polynomial.C c * Polynomial.X))) := zero_lt_iff.mpr (hZ _ hQ'0)
    refine le_of_mul_le_mul_right ?_ hpos
    rw [hval]
    calc V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) (p'.comp (Polynomial.C c * Polynomial.X))) *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) (q.comp (Polynomial.C c * Polynomial.X)))
        ≤ V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) (q'.comp (Polynomial.C c * Polynomial.X))) *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) (q.comp (Polynomial.C c * Polynomial.X))) := by
          gcongr
      _ = _ := mul_comm _ _
  · intro hle
    obtain ⟨i, hi, hQ, hP⟩ := (hCC _ _).mpr ⟨hnz q hq, hle⟩
    refine ⟨p, q, i, ?_, hf, fun j => ?_, fun j => ?_⟩
    · rw [Polynomial.comp_C_mul_X_coeff] at hi; exact hi
    · have h3 := hQ j
      rw [Polynomial.comp_C_mul_X_coeff, Polynomial.comp_C_mul_X_coeff] at h3
      exact h3
    · have h3 := hP j
      rw [Polynomial.comp_C_mul_X_coeff, Polynomial.comp_C_mul_X_coeff] at h3
      exact h3

theorem wcpa_dj_lr1k_eb_cg_scale_in : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (V : ValuationSubring (RatFunc Ω)),
    (∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W) →
    (∀ a : Ω, V.valuation (algebraMap Ω (RatFunc Ω) a) < 1 ↔ W.valuation a < 1) →
    (∀ R : Polynomial Ω,
      (∀ j, V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j)) ≤
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R)) ∧
      ∃ j, V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) =
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff j))) →
    (∀ (c : Ω), c ≠ 0 → ∀ (f : RatFunc Ω) (p q : Polynomial Ω), q ≠ 0 →
      f * algebraMap (Polynomial Ω) (RatFunc Ω) q = algebraMap (Polynomial Ω) (RatFunc Ω) p →
      (wcEbAnInOc W c f ↔
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
            (p.comp (Polynomial.C c * Polynomial.X))) ≤
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
            (q.comp (Polynomial.C c * Polynomial.X))))) →
    ∀ f ∈ V, ∀ c : Ω, c ≠ 0 → W.valuation c < 1 →
      wcEbAnInU W (algebraMap Ω (RatFunc Ω) c * f) :=
by
  intro Ω _ _ W V H1 H2 GF Ψ f hf c hc hcW
  classical

  have hcoeff : ∀ (R : Polynomial Ω) (s : Ω) (k : ℕ),
      V.valuation (algebraMap Ω (RatFunc Ω) ((R.comp (Polynomial.C s * Polynomial.X)).coeff k)) =
        V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff k)) *
          V.valuation (algebraMap Ω (RatFunc Ω) s) ^ k := by
    intro R s k
    rw [Polynomial.comp_C_mul_X_coeff, map_mul, map_pow, Valuation.map_mul, Valuation.map_pow]

  have s1 : ∀ (R : Polynomial Ω) (s : Ω), V.valuation (algebraMap Ω (RatFunc Ω) s) ≤ 1 →
      V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
          (R.comp (Polynomial.C s * Polynomial.X))) ≤
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) := by
    intro R s hs
    obtain ⟨k, hk⟩ := (GF (R.comp (Polynomial.C s * Polynomial.X))).2
    rw [hk, hcoeff]
    calc V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff k)) *
          V.valuation (algebraMap Ω (RatFunc Ω) s) ^ k
        ≤ V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff k)) :=
          mul_le_of_le_one_right' (pow_le_one₀ zero_le' hs)
      _ ≤ _ := (GF R).1 k

  have s2 : ∀ (R : Polynomial Ω) (s : Ω), V.valuation (algebraMap Ω (RatFunc Ω) s) ≤ 1 →
      V.valuation (algebraMap Ω (RatFunc Ω) s) ^ R.natDegree *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) ≤
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
          (R.comp (Polynomial.C s * Polynomial.X))) := by
    intro R s hs
    obtain ⟨m, hm⟩ := (GF R).2
    rw [hm]
    by_cases hRm : R.coeff m = 0
    · rw [hRm, map_zero, Valuation.map_zero, mul_zero]
      exact zero_le'
    · have hmd : m ≤ R.natDegree := Polynomial.le_natDegree_of_ne_zero hRm
      calc V.valuation (algebraMap Ω (RatFunc Ω) s) ^ R.natDegree *
            V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff m))
          ≤ V.valuation (algebraMap Ω (RatFunc Ω) s) ^ m *
              V.valuation (algebraMap Ω (RatFunc Ω) (R.coeff m)) :=
            mul_le_mul' (pow_le_pow_of_le_one zero_le' hs hmd) le_rfl
        _ = V.valuation (algebraMap Ω (RatFunc Ω)
              ((R.comp (Polynomial.C s * Polynomial.X)).coeff m)) := by
            rw [hcoeff, mul_comm]
        _ ≤ _ := (GF _).1 m

  have hCc : ∀ a : Ω, algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C a) =
      algebraMap Ω (RatFunc Ω) a := by
    intro a
    rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
  have hQ : f.denom ≠ 0 := RatFunc.denom_ne_zero f
  have hQne : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 := RatFunc.algebraMap_ne_zero hQ
  have hfQ : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
      algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
    rw [eq_comm, ← div_eq_iff hQne]
    exact RatFunc.num_div_denom f
  have hg : (algebraMap Ω (RatFunc Ω) c * f) * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
      algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C c * f.num) := by
    rw [map_mul, mul_assoc, hfQ, hCc]
  have hPQ : V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.num) ≤
      V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) := by
    have h := congrArg V.valuation hfQ
    rw [Valuation.map_mul] at h
    rw [← h]
    exact mul_le_of_le_one_left' ((ValuationSubring.valuation_le_one_iff V f).mpr hf)
  have hCmul : ∀ R : Polynomial Ω,
      V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C c * R)) =
        V.valuation (algebraMap Ω (RatFunc Ω) c) *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) R) := by
    intro R
    rw [map_mul, Valuation.map_mul, hCc]

  obtain ⟨c₀, hc₀⟩ := IsAlgClosed.exists_pow_nat_eq c
    (by omega : 0 < f.denom.natDegree + 1)
  have hc₀0 : c₀ ≠ 0 := by
    rintro rfl
    apply hc
    rw [← hc₀]
    exact zero_pow (Nat.succ_ne_zero _)
  have hwc : V.valuation (algebraMap Ω (RatFunc Ω) c) =
      V.valuation (algebraMap Ω (RatFunc Ω) c₀) ^ (f.denom.natDegree + 1) := by
    rw [← hc₀, map_pow, Valuation.map_pow]
  have hwc1 : V.valuation (algebraMap Ω (RatFunc Ω) c) < 1 := (H2 c).mpr hcW
  have hy1 : V.valuation (algebraMap Ω (RatFunc Ω) c₀) < 1 := by
    by_contra h
    push_neg at h
    have h' := one_le_pow₀ (n := f.denom.natDegree + 1) h
    rw [← hwc] at h'
    exact absurd hwc1 (not_lt.mpr h')
  refine ⟨c₀, hc₀0, (H2 c₀).mp hy1, ?_⟩
  intro c' hc' hc'W hdiv
  have hx1 : V.valuation (algebraMap Ω (RatFunc Ω) c') < 1 := (H2 c').mpr hc'W
  have hx0 : V.valuation (algebraMap Ω (RatFunc Ω) c') ≠ 0 := by
    rw [Ne, Valuation.zero_iff]
    exact (map_ne_zero _).mpr hc'
  have hyx : V.valuation (algebraMap Ω (RatFunc Ω) c₀) ≤
      V.valuation (algebraMap Ω (RatFunc Ω) c') := by
    have h1 := (ValuationSubring.valuation_le_one_iff V _).mpr ((H1 _).mpr hdiv)
    rw [map_div₀, map_div₀] at h1
    exact (div_le_one₀ (zero_lt_iff.mpr hx0)).mp h1
  refine (Ψ c' hc' _ (Polynomial.C c * f.num) f.denom hQ hg).mpr ?_
  rw [Polynomial.mul_comp, Polynomial.C_comp, hCmul]
  calc V.valuation (algebraMap Ω (RatFunc Ω) c) *
        V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω)
          (f.num.comp (Polynomial.C c' * Polynomial.X)))
      ≤ V.valuation (algebraMap Ω (RatFunc Ω) c) *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.num) :=
        mul_le_mul' le_rfl (s1 _ _ hx1.le)
    _ ≤ V.valuation (algebraMap Ω (RatFunc Ω) c) *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) :=
        mul_le_mul' le_rfl hPQ
    _ = V.valuation (algebraMap Ω (RatFunc Ω) c₀) ^ f.denom.natDegree *
          V.valuation (algebraMap Ω (RatFunc Ω) c₀) *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) := by
        rw [hwc, pow_succ]
    _ ≤ V.valuation (algebraMap Ω (RatFunc Ω) c₀) ^ f.denom.natDegree *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) :=
        mul_le_mul' (mul_le_of_le_one_right' hy1.le) le_rfl
    _ ≤ V.valuation (algebraMap Ω (RatFunc Ω) c') ^ f.denom.natDegree *
          V.valuation (algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) :=
        mul_le_mul' (pow_le_pow_left₀ zero_le' hyx _) le_rfl
    _ ≤ _ := s2 _ _ hx1.le

theorem wcpa_dj_lr1k_eb_cg_scale_out : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (V : ValuationSubring (RatFunc Ω)),
