            IsLocalRing.ResidueField ↥(V i)) = 1 := Finset.mem_singleton.mp (default : ↥(({1} : Finset (IsLocalRing.ResidueField ↥(V i))))).2
        show ((default : ↥(({1} : Finset (IsLocalRing.ResidueField ↥(V i))))) :
            IsLocalRing.ResidueField ↥(V i)) ≠ 0
        rw [h1]; exact one_ne_zero)
    simp only [Finset.card_singleton, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      smul_eq_mul, mul_one] at hb
