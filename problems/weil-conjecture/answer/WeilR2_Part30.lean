    rw [Ideal.Quotient.subsingleton_iff, pow_zero, Ideal.one_eq_top, sup_top_eq]
  let θ0 : (A ⧸ (I ⊔ p ^ 0)) ≃+* (T ⧸ (J ⊔ 𝔫 ^ 0)) :=
