      Polynomial.monic_prod_of_monic _ _ (fun g _ => Polynomial.monic_X_sub_C g)
    have hdegp : (∏ g ∈ G, (Polynomial.X - Polynomial.C g)).natDegree = G.card := by
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun g _ => Polynomial.monic_X_sub_C g)]
      simp
    have hdeg : (Polynomial.X * ∏ g ∈ G, (Polynomial.X - Polynomial.C g) -
