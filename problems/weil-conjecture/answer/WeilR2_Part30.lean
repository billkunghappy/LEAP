    obtain ⟨b1, b2⟩ := pin y N k₂ j₂ 1 y₂ z₂ hN hy₂ hz₂ hl₂ hu₂
    obtain ⟨c1, c2⟩ := pin (x * y) N (k₁ + k₂) (j₁ + j₂) 2 (y₁ * y₂) (z₁ * z₂) hN
