      have hv : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      exact (one_lt_inv₀ (zero_lt_iff.mpr hv)).symm
  have key1 : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
      A.valuation y = 1 ↔ (y ≠ 0 ∧ y ∈ A ∧ y⁻¹ ∈ A) := by
    intro F _ A y
    constructor
    · intro h
      have hy : y ≠ 0 := by
        intro h0
        rw [h0, map_zero] at h
        exact zero_ne_one h
      refine ⟨hy, (A.valuation_le_one_iff y).mp h.le, (A.valuation_le_one_iff _).mp ?_⟩
      rw [map_inv₀, h, inv_one]
    · rintro ⟨hy, h1, h2⟩
      have hv : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      have e1 : A.valuation y ≤ 1 := (A.valuation_le_one_iff y).mpr h1
      have e2 : A.valuation y⁻¹ ≤ 1 := (A.valuation_le_one_iff _).mpr h2
      rw [map_inv₀] at e2
      exact le_antisymm e1 ((inv_le_one₀ (zero_lt_iff.mpr hv)).mp e2)

  have hle1 : ∀ x : Ω, W.valuation x < 1 → x ∈ W :=
    fun x hx => (W.valuation_le_one_iff x).mp hx.le
  have hsq : ∀ x : Ω, W.valuation x < 1 → W.valuation (x * x) < 1 := by
    intro x hx
    rw [map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' hx.le) hx
  have hsqrt : ∀ x : Ω, W.valuation (x * x) ≤ 1 → W.valuation x ≤ 1 := by
    intro x hx
    rw [map_mul] at hx
    exact not_lt.mp fun h => (not_lt.mpr hx) (lt_of_lt_of_le h (le_mul_of_one_le_right' h.le))
  have hsqrt' : ∀ x : Ω, W.valuation (x * x) < 1 → W.valuation x < 1 := by
    intro x hx
    rw [map_mul] at hx
    exact not_le.mp fun h => (not_le.mpr hx) (le_trans h (le_mul_of_one_le_right' h))
  obtain ⟨t, ht0, ht1⟩ : ∃ t : Ω, t ≠ 0 ∧ W.valuation t < 1 := by
    obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
      by_contra h'
      apply hW
      ext x
      exact iff_of_true (not_not.mp (not_exists.mp h' x)) (ValuationSubring.mem_top x)
    have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
    exact ⟨x⁻¹, inv_ne_zero hx0, (key W x⁻¹).mpr (Or.inr (by rwa [inv_inv]))⟩
  have mkI : ∀ x : Ω, x ≠ 0 → W.valuation x < 1 →
      ∃ θ : {θ : ↥W // θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W}, ((θ.1 : ↥W) : Ω) = x := by
    intro x hx0 hx1
    exact ⟨⟨⟨x, hle1 x hx1⟩, fun h => hx0 (congrArg Subtype.val h),
      (W.valuation_lt_one_iff _).mpr hx1⟩, rfl⟩

  obtain ⟨Good, hGood⟩ : ∃ G : ValuationSubring L → Prop, ∀ V, G V ↔ ∃ b : Fin m,
      V.valuation (u b - 1) < 1 ∧
      V.valuation (η b) ^ e b = V.valuation (algebraMap (RatFunc Ω) L RatFunc.X) ∧
      ∀ b', b' ≠ b → V.valuation (η b') = 1 := ⟨_, fun _ => Iff.rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : {θ : ↥W // θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W} →
      Set (ValuationSubring L), ∀ θ V, V ∈ B θ ↔
        ((∃ c : Ω, c ≠ 0 ∧ W.valuation c < 1 ∧ ((θ.1 : ↥W) : Ω) / (c * c) ∈ W ∧
          ∀ g : RatFunc Ω, algebraMap (RatFunc Ω) L g ∈ V ↔ wcEbAnInOc W c g) ∧ ¬ Good V) :=
    ⟨fun θ => {V | (∃ c : Ω, c ≠ 0 ∧ W.valuation c < 1 ∧ ((θ.1 : ↥W) : Ω) / (c * c) ∈ W ∧
          ∀ g : RatFunc Ω, algebraMap (RatFunc Ω) L g ∈ V ↔ wcEbAnInOc W c g) ∧ ¬ Good V},
      fun _ _ => Iff.rfl⟩

  by_contra hcon
  have hne : ∀ θ, (B θ).Nonempty := by
    intro θ
    by_contra hemp
    apply hcon
    refine ⟨θ.1, θ.2.1, θ.2.2, ?_⟩
    intro a ha0 ham hθa c hc O hO V' hV'
    by_contra hnot
    apply hemp
    refine ⟨V', (hB θ V').mpr ⟨⟨c, ?_, ?_, ?_, ?_⟩, ?_⟩⟩
    · intro hc0
      have h0 : (a : Ω) = 0 := by rw [← hc, hc0, zero_mul]
      exact ha0 (Subtype.ext h0)
    · apply hsqrt'
      rw [hc]
      exact (W.valuation_lt_one_iff a).mp ham
    · rw [hc]; exact hθa
    · intro g
      rw [← hO g, ← hV', ValuationSubring.mem_comap]
    · rw [hGood]; exact hnot

  have hmono : ∀ θ θ' : {θ : ↥W // θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W},
      ((θ.1 : ↥W) : Ω) / ((θ'.1 : ↥W) : Ω) ∈ W → B θ' ⊆ B θ := by
    intro θ θ' h V hV
    obtain ⟨⟨c, hc0, hc1, hθc, hmem⟩, hbad⟩ := (hB θ' V).mp hV
    have hθ'0 : ((θ'.1 : ↥W) : Ω) ≠ 0 := fun h0 => θ'.2.1 (Subtype.ext h0)
    refine (hB θ V).mpr ⟨⟨c, hc0, hc1, ?_, hmem⟩, hbad⟩
    have := mul_mem h hθc
    rwa [div_mul_div_cancel₀ hθ'0] at this
  have hdir : ∀ θ₁ θ₂ : {θ : ↥W // θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W},
      ∃ θ₃, B θ₃ ⊆ B θ₁ ∧ B θ₃ ⊆ B θ₂ := by
    intro θ₁ θ₂
    have h10 : ((θ₁.1 : ↥W) : Ω) ≠ 0 := fun h0 => θ₁.2.1 (Subtype.ext h0)
    have h20 : ((θ₂.1 : ↥W) : Ω) ≠ 0 := fun h0 => θ₂.2.1 (Subtype.ext h0)
    rcases W.mem_or_inv_mem (((θ₁.1 : ↥W) : Ω) / ((θ₂.1 : ↥W) : Ω)) with h | h
    · exact ⟨θ₂, hmono θ₁ θ₂ h, hmono θ₂ θ₂ (by rw [div_self h20]; exact W.one_mem)⟩
    · rw [inv_div] at h
      exact ⟨θ₁, hmono θ₁ θ₁ (by rw [div_self h10]; exact W.one_mem), hmono θ₂ θ₁ h⟩
  obtain ⟨θ₀, -⟩ := mkI t ht0 ht1
  haveI : Nonempty {θ : ↥W // θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W} := ⟨θ₀⟩

  obtain ⟨Ulim, hU⟩ := wcpa_dj_lr1k_eb_mono_bs_limit_valuation L _ B hdir hne

  have dich : ∀ f : RatFunc Ω, ∃ c₀ : Ω, c₀ ≠ 0 ∧ W.valuation c₀ < 1 ∧
      ((∀ c : Ω, c ≠ 0 → W.valuation c < 1 → c₀ / c ∈ W → wcEbAnInOc W c f) ∨
       (∀ c : Ω, c ≠ 0 → W.valuation c < 1 → c₀ / c ∈ W → ∀ V : ValuationSubring (RatFunc Ω),
          (∀ g : RatFunc Ω, g ∈ V ↔ wcEbAnInOc W c g) → f ∉ V)) := by
    intro f
    have hQ : f.denom ≠ 0 := RatFunc.denom_ne_zero f
    have hιQ : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 :=
      (map_ne_zero_iff _ (RatFunc.algebraMap_injective Ω)).mpr hQ
    have hfQ : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
        algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
      have h := RatFunc.num_div_denom f
      calc f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom
          = algebraMap (Polynomial Ω) (RatFunc Ω) f.num /
              algebraMap (Polynomial Ω) (RatFunc Ω) f.denom *
              algebraMap (Polynomial Ω) (RatFunc Ω) f.denom := by rw [h]
        _ = algebraMap (Polynomial Ω) (RatFunc Ω) f.num := div_mul_cancel₀ _ hιQ
    obtain ⟨c₀, hc₀0, hc₀1, hcase⟩ :=
      wcpa_dj_lr1k_eb_mono_bs_poly_window Ω W hW f.num f.denom hQ
    refine ⟨c₀, hc₀0, hc₀1, ?_⟩
    rcases hcase with ⟨l, hQl, hwin⟩ | ⟨k, l, hPk, hQl, hwin⟩
    · left
      intro c hc0 hc1 hcw
      exact ⟨f.num, f.denom, l, mul_ne_zero hQl (pow_ne_zero _ hc0), hfQ,
        fun j => (hwin c hc0 hc1 hcw j).1, fun j => (hwin c hc0 hc1 hcw j).2⟩
    · right
      intro c hc0 hc1 hcw V hV
      obtain ⟨hr, hlt⟩ := hwin c hc0 hc1 hcw
      have h := wcpa_dj_lr1k_eb_mono_bs_offwindow_nonmem Ω W c V hV f.num f.denom k l hc0 hPk hQl
        (fun j => (hr j).1) (fun j => (hr j).2) hlt
      rwa [RatFunc.num_div_denom] at h

  have hover : ∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ Ulim ↔ wcEbAnInU W f := by
    intro f
    obtain ⟨c₀, hc₀0, hc₀1, hAB⟩ := dich f
    obtain ⟨θ, hθ⟩ := mkI (c₀ * c₀) (mul_ne_zero hc₀0 hc₀0) (hsq c₀ hc₀1)
    obtain ⟨V, hVB, hag⟩ := hU θ {algebraMap (RatFunc Ω) L f}
    obtain ⟨⟨c, hc0, hc1, hθc, hmem⟩, _⟩ := (hB θ V).mp hVB
    have hag' := hag _ (Finset.mem_singleton_self _)
    have hc₀c : c₀ / c ∈ W := by
      rw [hθ] at hθc
      have e : c₀ * c₀ / (c * c) = (c₀ / c) * (c₀ / c) := by ring
      rw [e] at hθc
      exact (W.valuation_le_one_iff _).mp (hsqrt _ ((W.valuation_le_one_iff _).mpr hθc))
    rcases hAB with hA | hBc
    · exact iff_of_true (hag'.mp ((hmem f).mpr (hA c hc0 hc1 hc₀c))) ⟨c₀, hc₀0, hc₀1, hA⟩
    · refine iff_of_false (fun hf => hBc c hc0 hc1 hc₀c (V.comap (algebraMap (RatFunc Ω) L))
        (fun g => hmem g) (hag'.mpr hf)) ?_
      rintro ⟨c₁, hc₁0, hc₁1, h₁⟩
      have finish : ∀ c₂ : Ω, c₂ ≠ 0 → W.valuation c₂ < 1 → c₀ / c₂ ∈ W → c₁ / c₂ ∈ W →
          False := by
        intro c₂ hc₂0 hc₂1 h0 h1
        obtain ⟨θ₂, hθ₂⟩ := mkI (c₂ * c₂) (mul_ne_zero hc₂0 hc₂0) (hsq c₂ hc₂1)
        obtain ⟨V₂, hV₂B, -⟩ := hU θ₂ ∅
        obtain ⟨⟨c₃, hc₃0, hc₃1, hθc₃, hmem₃⟩, _⟩ := (hB θ₂ V₂).mp hV₂B
        have h23 : c₂ / c₃ ∈ W := by
          rw [hθ₂] at hθc₃
          have e : c₂ * c₂ / (c₃ * c₃) = (c₂ / c₃) * (c₂ / c₃) := by ring
          rw [e] at hθc₃
          exact (W.valuation_le_one_iff _).mp (hsqrt _ ((W.valuation_le_one_iff _).mpr hθc₃))
        have h03 : c₀ / c₃ ∈ W := by
          have := mul_mem h0 h23
          rwa [div_mul_div_cancel₀ hc₂0] at this
        have h13 : c₁ / c₃ ∈ W := by
          have := mul_mem h1 h23
          rwa [div_mul_div_cancel₀ hc₂0] at this
        have hin := h₁ c₃ hc₃0 hc₃1 h13
        exact hBc c₃ hc₃0 hc₃1 h03 (V₂.comap (algebraMap (RatFunc Ω) L)) (fun g => hmem₃ g)
          ((hmem₃ f).mpr hin)
      rcases W.mem_or_inv_mem (c₀ / c₁) with h | h
      · exact finish c₁ hc₁0 hc₁1 h (by rw [div_self hc₁0]; exact W.one_mem)
      · rw [inv_div] at h
        exact finish c₀ hc₀0 hc₀1 (by rw [div_self hc₀0]; exact W.one_mem) h

  obtain ⟨b, hb⟩ := (hBD2 Ulim).mp hover
  subst hb

  obtain ⟨V, hVB, hag⟩ := hU θ₀ (({u b - 1, (u b - 1)⁻¹} : Finset L) ∪
    (Finset.univ.image η ∪ Finset.univ.image (fun b' => (η b')⁻¹)))
  obtain ⟨_, hbad⟩ := (hB θ₀ V).mp hVB
  apply hbad
  rw [hGood]
  have hT2 : (u b - 1)⁻¹ ∈ (({u b - 1, (u b - 1)⁻¹} : Finset L) ∪
      (Finset.univ.image η ∪ Finset.univ.image (fun b' => (η b')⁻¹))) :=
    Finset.mem_union_left _ (Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
  have hT3 : ∀ b', η b' ∈ (({u b - 1, (u b - 1)⁻¹} : Finset L) ∪
      (Finset.univ.image η ∪ Finset.univ.image (fun b' => (η b')⁻¹))) := fun b' =>
    Finset.mem_union_right _ (Finset.mem_union_left _
      (Finset.mem_image_of_mem _ (Finset.mem_univ b')))
  have hT4 : ∀ b', (η b')⁻¹ ∈ (({u b - 1, (u b - 1)⁻¹} : Finset L) ∪
      (Finset.univ.image η ∪ Finset.univ.image (fun b' => (η b')⁻¹))) := fun b' =>
    Finset.mem_union_right _ (Finset.mem_union_right _
      (Finset.mem_image_of_mem (fun b' => (η b')⁻¹) (Finset.mem_univ b')))
  have hV1 : V.valuation (u b - 1) < 1 := by
    have h6 := hBD6 b
    rw [key] at h6
    rw [key]
    rcases h6 with h | h
    · exact Or.inl h
    · exact Or.inr (fun h' => h ((hag _ hT2).mp h'))
  refine ⟨b, hV1, ?_, ?_⟩
  · have hu1 : V.valuation (u b) = 1 := by
      have h := Valuation.map_add_eq_of_lt_left V.valuation
        (show V.valuation (u b - 1) < V.valuation 1 by rw [map_one]; exact hV1)
      rw [map_one] at h
      calc V.valuation (u b) = V.valuation (1 + (u b - 1)) := by congr 1; ring
        _ = 1 := h
    rw [hBD5 b, map_mul, map_pow, hu1, mul_one]
  · intro b' hb'
    have h7 := hBD7 b' b hb'
    rw [key1] at h7
    rw [key1]
    obtain ⟨h0, h1, h2⟩ := h7
    exact ⟨h0, (hag _ (hT3 b')).mpr h1, (hag _ (hT4 b')).mpr h2⟩

theorem wcpa_dj_lr1k_eb_ci_minpoly_mem : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] (O : ValuationSubring K) (z : L),
    (∀ V' : ValuationSubring L, V'.comap (algebraMap K L) = O → z ∈ V') →
    ∀ i : ℕ, (minpoly K z).coeff i ∈ O :=
by
  intro K L _ _ _ _ O z hz
  classical

  have s1 : ∀ (A : Subring L) (M : Ideal ↥A), M.IsPrime → ∃ V : ValuationSubring L,
      A ≤ V.toSubring ∧ ∀ a : ↥A, a ∈ M → V.valuation (a : L) < 1 := by
    intro A M hM
    haveI := hM
    obtain ⟨V, hBV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.ofPrime A M)
    rw [LocalSubring.le_def] at hBV
    obtain ⟨h, hloc⟩ := hBV
    refine ⟨V, (LocalSubring.le_ofPrime A M).trans h, ?_⟩
    intro a ha
    have haV : (a : L) ∈ V := h (LocalSubring.le_ofPrime A M a.2)
    rcases lt_or_eq_of_le ((V.valuation_le_one_iff _).mpr haV) with hlt | heq
    · exact hlt
    · exfalso
      have hu : IsUnit (⟨(a : L), haV⟩ : V) := (V.valuation_eq_one_iff _).mpr heq
      have hb : Subring.inclusion h (algebraMap ↥A ↥(LocalSubring.ofPrime A M).toSubring a)
          = ⟨(a : L), haV⟩ := by
        apply Subtype.ext
        show ((algebraMap ↥A ↥(LocalSubring.ofPrime A M).toSubring a : _) : L) = (a : L)
        have e := IsScalarTower.algebraMap_apply ↥A ↥(LocalSubring.ofPrime A M).toSubring L a
        exact e.symm
      have hbu : IsUnit (algebraMap ↥A ↥(LocalSubring.ofPrime A M).toSubring a) :=
        isUnit_of_map_unit (Subring.inclusion h) _ (by rw [hb]; exact hu)
      exact ((IsLocalization.AtPrime.isUnit_to_map_iff _ M a).mp hbu) ha

  have s2 : ∀ (g : Polynomial ↥O) (y : L), y ≠ 0 → Polynomial.aeval y g = 0 →
      IsUnit (g.coeff 0) → _root_.IsIntegral ↥O y⁻¹ := by
    intro g y hy hg hu
    have hu0 : g.coeff 0 ≠ 0 := hu.ne_zero
    have htc : g.trailingCoeff = g.coeff 0 := Polynomial.trailingCoeff_eq_coeff_zero hu0
    have hlc : g.reverse.leadingCoeff = g.coeff 0 := by rw [Polynomial.reverse_leadingCoeff, htc]
    obtain ⟨w, hw⟩ : ∃ w : ↥O, w * g.coeff 0 = 1 := ⟨↑hu.unit⁻¹, hu.val_inv_mul⟩
    have hmon : (Polynomial.C w * g.reverse).Monic :=
      Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one (by rw [hlc]; exact hw)
    letI := invertibleOfNonzero hy
    have hrev := Polynomial.eval₂_reverse_mul_pow (algebraMap ↥O L) y g
    have hg' : Polynomial.eval₂ (algebraMap ↥O L) y g = 0 := by
      rw [← Polynomial.aeval_def]; exact hg
    rw [hg', invOf_eq_inv] at hrev
    have hr0 : Polynomial.aeval y⁻¹ g.reverse = 0 :=
      (mul_eq_zero.mp hrev).resolve_right (pow_ne_zero _ hy)
    refine ⟨Polynomial.C w * g.reverse, hmon, ?_⟩
    rw [← Polynomial.aeval_def, map_mul, hr0, mul_zero]

  have hint : _root_.IsIntegral ↥O z := by
    by_contra hni
    have hz0 : z ≠ 0 := by rintro rfl; exact hni isIntegral_zero
    have hy0 : z⁻¹ ≠ 0 := inv_ne_zero hz0
    have hnot : ∀ g : Polynomial ↥O, Polynomial.aeval z⁻¹ g = 0 → ¬ IsUnit (g.coeff 0) := by
      intro g hg hu
      have := s2 g z⁻¹ hy0 hg hu
      rw [inv_inv] at this
      exact hni this
    let φ : Polynomial ↥O →+* L := Polynomial.eval₂RingHom (algebraMap ↥O L) z⁻¹
    let A : Subring L := φ.range
    let ψ : Polynomial ↥O →+* ↥A := φ.rangeRestrict
    have hψ : Function.Surjective ψ := RingHom.rangeRestrict_surjective φ
    have hψv : ∀ p, (ψ p : L) = Polynomial.eval₂ (algebraMap ↥O L) z⁻¹ p := fun p => rfl
    let J₀ : Ideal (Polynomial ↥O) :=
      Ideal.comap (Polynomial.constantCoeff) (IsLocalRing.maximalIdeal ↥O)
    have hJ₀ : ∀ p, p ∈ J₀ ↔ p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥O := by
      intro p
      rw [Ideal.mem_comap, Polynomial.constantCoeff_apply]
    let J : Ideal ↥A := Ideal.map ψ J₀
    have hJ : J ≠ ⊤ := by
      intro hJt
      have h1 : (1 : ↥A) ∈ J := hJt ▸ Submodule.mem_top
      obtain ⟨p, hp, hp1⟩ := (Ideal.mem_map_iff_of_surjective ψ hψ).mp h1
      have hpe : Polynomial.eval₂ (algebraMap ↥O L) z⁻¹ p = 1 := by
        rw [← hψv, hp1]; rfl
      apply hnot (p - 1)
      · rw [Polynomial.aeval_def, Polynomial.eval₂_sub, hpe, Polynomial.eval₂_one, sub_self]
      · have hm : p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥O := (hJ₀ p).mp hp
        rw [Polynomial.coeff_sub, Polynomial.coeff_one_zero]
        have h3 := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hm
        have h2 : p.coeff 0 - 1 = -(1 - p.coeff 0) := by ring
        rw [h2]
        exact h3.neg
    obtain ⟨M, hMmax, hJM⟩ := Ideal.exists_le_maximal J hJ
    obtain ⟨V, hAV, hVM⟩ := s1 A M hMmax.isPrime
    have hC : ∀ o : ↥O, (ψ (Polynomial.C o) : L) = algebraMap K L (o : K) := by
      intro o
      rw [hψv, Polynomial.eval₂_C, IsScalarTower.algebraMap_apply ↥O K L o]
      rfl
    have hX : (ψ Polynomial.X : L) = z⁻¹ := by
      rw [hψv, Polynomial.eval₂_X]
    have c1 : ∀ o : ↥O, algebraMap K L (o : K) ∈ V := by
      intro o
      rw [← hC o]
      exact hAV (ψ (Polynomial.C o)).2
    have c2 : ∀ o : ↥O, o ∈ IsLocalRing.maximalIdeal ↥O →
        V.valuation (algebraMap K L (o : K)) < 1 := by
      intro o ho
      have hmem : ψ (Polynomial.C o) ∈ M :=
        hJM (Ideal.mem_map_of_mem ψ ((hJ₀ _).mpr (by rw [Polynomial.coeff_C_zero]; exact ho)))
      have := hVM _ hmem
      rwa [hC o] at this
    have c4 : V.valuation z⁻¹ < 1 := by
      have hmem : ψ Polynomial.X ∈ M :=
        hJM (Ideal.mem_map_of_mem ψ ((hJ₀ _).mpr
          (by rw [Polynomial.coeff_X_zero]; exact Ideal.zero_mem _)))
      have := hVM _ hmem
      rwa [hX] at this
    have c3 : V.comap (algebraMap K L) = O := by
      ext x
      rw [ValuationSubring.mem_comap]
      constructor
      · intro hx
        by_contra hxO
        have hx0 : x ≠ 0 := fun h => hxO (h ▸ O.zero_mem)
        have hxi : x⁻¹ ∈ O := (O.mem_or_inv_mem x).resolve_left hxO
        have hm : (⟨x⁻¹, hxi⟩ : ↥O) ∈ IsLocalRing.maximalIdeal ↥O := by
          rw [ValuationSubring.valuation_lt_one_iff]
          show O.valuation x⁻¹ < 1
          rcases lt_or_eq_of_le ((O.valuation_le_one_iff _).mpr hxi) with h | h
          · exact h
          · exfalso
            have hv : O.valuation x = 1 := by rw [← inv_inv x, map_inv₀, h, inv_one]
            exact hxO ((O.valuation_le_one_iff x).mp hv.le)
        have h1 : V.valuation (algebraMap K L x⁻¹) < 1 := c2 _ hm
        have h2 : V.valuation (algebraMap K L x) ≤ 1 := (V.valuation_le_one_iff _).mpr hx
        have h3 := mul_lt_one_of_lt_of_le h1 h2
        rw [← map_mul, ← map_mul, inv_mul_cancel₀ hx0, map_one, map_one] at h3
        exact lt_irrefl _ h3
      · intro hx
        exact c1 ⟨x, hx⟩
    have hzV := hz V c3
    have h5 := mul_lt_one_of_lt_of_le c4 ((V.valuation_le_one_iff z).mpr hzV)
    rw [← map_mul, inv_mul_cancel₀ hz0, map_one] at h5
    exact lt_irrefl _ h5
  intro i
  rw [minpoly.isIntegrallyClosed_eq_field_fractions' (R := ↥O) K hint, Polynomial.coeff_map]
  exact ((minpoly ↥O z).coeff i).2

theorem wcpa_dj_lr1k_eb_ci_annulus_bounded : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ι : Type) [Fintype ι] (F : ι → RatFunc Ω) (c₀ : Ω),
    c₀ ≠ 0 → W.valuation c₀ < 1 →
    (∀ (j : ι) (c : Ω), c ≠ 0 → W.valuation c < 1 → c₀ / c ∈ W → wcEbAnInOc W c (F j)) →
    ∃ θ : ↥W, θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W ∧ c₀ / (θ : Ω) ∈ W ∧
      ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → (θ : Ω) / (a : Ω) ∈ W →
        ∀ j : ι, ∃ (r s : ↥(wcEbRing W a)), s ∉ wcEbNode W a ∧
          F j * (s : RatFunc Ω) = (r : RatFunc Ω) :=
have t_psi_mem : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (a : ↥W) (Z : Multiset Ω) (ha0 : a ≠ 0)
    (hZ : ∀ ρ ∈ Z, W.valuation ρ < 1 → W.valuation (ρ / (a : Ω)) < 1),
    (Z.map (wcEbCiAbPsi W)).prod ∈ wcEbRing W a := by
  intro Ω _ W a Z ha0 hZ
  have ha0' : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hC : ∀ w : Ω, w ∈ W → algebraMap Ω (RatFunc Ω) w ∈ wcEbRing W a := fun w hw =>
    Subring.subset_closure (Or.inl ⟨⟨w, hw⟩, rfl⟩)
  have hX : (RatFunc.X : RatFunc Ω) ∈ wcEbRing W a :=
    Subring.subset_closure (Or.inr (Set.mem_insert _ _))
  have haX : algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹ ∈ wcEbRing W a :=
    Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))
  apply Subring.multiset_prod_mem
  intro x hx
  obtain ⟨ρ, hρ, rfl⟩ := Multiset.mem_map.mp hx
  unfold wcEbCiAbPsi
  split_ifs with h
  · have hw : ρ / (a : Ω) ∈ W := (W.valuation_le_one_iff _).mp (hZ ρ hρ h).le
    have e : algebraMap Ω (RatFunc Ω) ρ * RatFunc.X⁻¹ =
        algebraMap Ω (RatFunc Ω) (ρ / (a : Ω)) *
          (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹) := by
      rw [← mul_assoc, ← map_mul, div_mul_cancel₀ _ ha0']
    rw [e]
    exact Subring.sub_mem _ (Subring.one_mem _) (Subring.mul_mem _ (hC _ hw) haX)
  · have hw : ρ⁻¹ ∈ W := by
      by_cases hρ0 : ρ = 0
      · rw [hρ0, inv_zero]; exact W.zero_mem
      · rw [← W.valuation_le_one_iff, map_inv₀]
        exact inv_le_one_of_one_le₀ (not_lt.mp h)
    exact Subring.sub_mem _ (Subring.one_mem _) (Subring.mul_mem _ (hC _ hw) hX)

have t_theta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (c₀ : Ω)
    (Z : Multiset Ω) (hc₀0 : c₀ ≠ 0) (hc₀1 : W.valuation c₀ < 1),
    ∃ θ : ↥W, θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W ∧ c₀ / (θ : Ω) ∈ W ∧
      ∀ ρ ∈ Z, W.valuation ρ < 1 → ∀ c : Ω, c ≠ 0 → (θ : Ω) / c ∈ W →
        W.valuation (ρ / c) < 1 := by
  intro Ω _ _ W c₀ Z hc₀0 hc₀1
  classical
  obtain ⟨μ, hμT, hμmax⟩ := Multiset.exists_max_image (fun x => W.valuation x)
    (s := c₀ ::ₘ Z.filter (fun ρ => W.valuation ρ < 1)) (Multiset.cons_ne_zero)
  have hTlt : ∀ x ∈ c₀ ::ₘ Z.filter (fun ρ => W.valuation ρ < 1), W.valuation x < 1 := by
    intro x hx
    rcases Multiset.mem_cons.mp hx with rfl | hx
    · exact hc₀1
    · exact (Multiset.mem_filter.mp hx).2
  have hμ1 : W.valuation μ < 1 := hTlt μ hμT
  have hc₀μ : W.valuation c₀ ≤ W.valuation μ := hμmax c₀ (Multiset.mem_cons_self _ _)
  have hc₀v : W.valuation c₀ ≠ 0 := (Valuation.ne_zero_iff _).mpr hc₀0
  have hμ0 : W.valuation μ ≠ 0 := by
    intro h; rw [h] at hc₀μ
    exact hc₀v (le_antisymm hc₀μ zero_le')
  obtain ⟨t, ht⟩ := IsAlgClosed.exists_pow_nat_eq μ (by norm_num : 0 < 2)
  have htv : W.valuation t ^ 2 = W.valuation μ := by rw [← map_pow, ht]
  have ht1 : W.valuation t < 1 := (pow_lt_one_iff two_ne_zero).mp (by rw [htv]; exact hμ1)
  have ht0 : W.valuation t ≠ 0 := by
    intro h; apply hμ0; rw [← htv, h]; simp
  have hkey : W.valuation μ < W.valuation t := by
    rw [← htv, sq]
    exact mul_lt_of_lt_one_right (zero_lt_iff.mpr ht0) ht1
  have htW : t ∈ W := (W.valuation_le_one_iff t).mp ht1.le
  have htne : t ≠ 0 := fun h => ht0 (by rw [h, map_zero])
  refine ⟨⟨t, htW⟩, fun h => htne (congrArg Subtype.val h), ?_, ?_, ?_⟩
  · exact (ValuationSubring.valuation_lt_one_iff W ⟨t, htW⟩).mpr ht1
  · show c₀ / t ∈ W
    rw [← W.valuation_le_one_iff, map_div₀]
    exact div_le_one_of_le₀ (hc₀μ.trans hkey.le) zero_le'
  · intro ρ hρ hρ1 c hc0 hθc
    have hρT : ρ ∈ c₀ ::ₘ Z.filter (fun ρ => W.valuation ρ < 1) :=
      Multiset.mem_cons_of_mem (Multiset.mem_filter.mpr ⟨hρ, hρ1⟩)
    have h1 : W.valuation ρ < W.valuation t := lt_of_le_of_lt (hμmax ρ hρT) hkey
    have hcv : W.valuation c ≠ 0 := (Valuation.ne_zero_iff _).mpr hc0
    have h2 : W.valuation t ≤ W.valuation c := by
      have := (W.valuation_le_one_iff _).mpr hθc
      rw [map_div₀] at this
      exact (div_le_one₀ (zero_lt_iff.mpr hcv)).mp this
    rw [map_div₀]
    exact (div_lt_one₀ (zero_lt_iff.mpr hcv)).mpr (lt_of_lt_of_le h1 h2)

have t_gauss_unit : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (c : Ω) (O : ValuationSubring (RatFunc Ω)) (hc0 : c ≠ 0)
    (hO : ∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f),
    (∀ (κ : Ω) (k : ℤ), algebraMap Ω (RatFunc Ω) κ * RatFunc.X ^ k ∈ O ↔ κ * c ^ k ∈ W) ∧
    ∀ ρ : Ω, (W.valuation ρ < 1 → W.valuation (ρ / c) < 1) → W.valuation c < 1 →
      O.valuation (wcEbCiAbPsi W ρ) = 1 := by
  intro Ω _ W c O hc0 hO
  have hXne : (RatFunc.X : RatFunc Ω) ≠ 0 := RatFunc.X_ne_zero
  have hCc : ∀ w : Ω, algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C w) =
      algebraMap Ω (RatFunc Ω) w := fun w => by rw [RatFunc.algebraMap_C]; rfl
  have hconstW : ∀ w : Ω, algebraMap Ω (RatFunc Ω) w ∈ O ↔ w ∈ W := by
    intro w
    constructor
    · intro hw
      obtain ⟨p, q, i, hqi, hpq, -, hp⟩ := (hO _).mp hw
      have hpq' : p = Polynomial.C w * q := by
        apply IsFractionRing.injective (Polynomial Ω) (RatFunc Ω)
        rw [map_mul, hCc, hpq]
      have h := hp i
      rwa [hpq', Polynomial.coeff_C_mul, mul_assoc, mul_div_assoc, div_self hqi, mul_one] at h
    · intro hw
      rw [hO]
      refine ⟨Polynomial.C w, 1, 0, by simp, ?_, ?_, ?_⟩
      · rw [map_one, mul_one, hCc]
      · intro j
        by_cases hj : j = 0
        · subst hj; simp
        · simp [Polynomial.coeff_one, hj]
      · intro j
        by_cases hj : j = 0
        · subst hj; simpa using hw
        · simp [Polynomial.coeff_C, hj]
  have hsmall : ∀ w : Ω, W.valuation w < 1 → O.valuation (algebraMap Ω (RatFunc Ω) w) < 1 := by
    intro w hw
    by_cases hw0 : w = 0
    · rw [hw0, map_zero, map_zero]; exact zero_lt_one
    have hwW : w ∈ W := (W.valuation_le_one_iff w).mp hw.le
    have hle : O.valuation (algebraMap Ω (RatFunc Ω) w) ≤ 1 :=
      (O.valuation_le_one_iff _).mpr ((hconstW w).mpr hwW)
    rcases lt_or_eq_of_le hle with h | h
    · exact h
    exfalso
    have hinv : (algebraMap Ω (RatFunc Ω) w)⁻¹ ∈ O := by
      rw [← O.valuation_le_one_iff, map_inv₀, h, inv_one]
    rw [← map_inv₀, hconstW, ← W.valuation_le_one_iff, map_inv₀] at hinv
    have hw0' : W.valuation w ≠ 0 := (Valuation.ne_zero_iff _).mpr hw0
    have := mul_lt_one_of_lt_of_le hw hinv
    rw [mul_inv_cancel₀ hw0'] at this
    exact lt_irrefl _ this
  have hunit1 : ∀ x y : RatFunc Ω, x ∈ O → y ∈ O → x * y = 1 → O.valuation x = 1 := by
    intro x y hx hy hxy
    have hx' := (O.valuation_le_one_iff x).mpr hx
    have hy' := (O.valuation_le_one_iff y).mpr hy
    rcases lt_or_eq_of_le hx' with h | h
    · exfalso
      have := mul_lt_one_of_lt_of_le h hy'
      rw [← map_mul, hxy, map_one] at this
      exact lt_irrefl _ this
    · exact h
  have hu1mem : algebraMap Ω (RatFunc Ω) c⁻¹ * RatFunc.X ∈ O := by
    rw [hO]
    refine ⟨Polynomial.X, Polynomial.C c, 0, by simpa using hc0, ?_, ?_, ?_⟩
    · rw [hCc, RatFunc.algebraMap_X, mul_comm, ← mul_assoc, ← map_mul, mul_inv_cancel₀ hc0,
        map_one, one_mul]
    · intro j
      by_cases hj : j = 0
      · subst hj; simp [hc0]
      · simp [Polynomial.coeff_C, hj]
    · intro j
      by_cases hj : j = 1
      · subst hj; simp [hc0]
      · simp [Polynomial.coeff_X, hj, Ne.symm hj]
  have hu2mem : algebraMap Ω (RatFunc Ω) c * RatFunc.X⁻¹ ∈ O := by
    rw [hO]
    refine ⟨Polynomial.C c, Polynomial.X, 1, by simpa using hc0, ?_, ?_, ?_⟩
    · rw [hCc, RatFunc.algebraMap_X, mul_assoc, inv_mul_cancel₀ hXne, mul_one]
    · intro j
      by_cases hj : j = 1
      · subst hj; simp [hc0]
      · simp [Polynomial.coeff_X, hj, Ne.symm hj]
    · intro j
      by_cases hj : j = 0
      · subst hj; simp [hc0]
      · simp [Polynomial.coeff_C, hj]
  have hprod12 : (algebraMap Ω (RatFunc Ω) c⁻¹ * RatFunc.X) *
      (algebraMap Ω (RatFunc Ω) c * RatFunc.X⁻¹) = 1 := by
    rw [mul_mul_mul_comm, ← map_mul, inv_mul_cancel₀ hc0, map_one, one_mul,
      mul_inv_cancel₀ hXne]
  have hu1 := hunit1 _ _ hu1mem hu2mem hprod12
  have hu2 := hunit1 _ _ hu2mem hu1mem (by rw [mul_comm]; exact hprod12)
  refine ⟨fun κ k => ?_, ?_⟩
  · have e : algebraMap Ω (RatFunc Ω) κ * RatFunc.X ^ k =
        algebraMap Ω (RatFunc Ω) (κ * c ^ k) * (algebraMap Ω (RatFunc Ω) c⁻¹ * RatFunc.X) ^ k := by
      rw [mul_zpow, ← map_zpow₀, ← mul_assoc, ← map_mul, mul_assoc κ, ← mul_zpow,
        mul_inv_cancel₀ hc0, one_zpow, mul_one]
    rw [e, ← O.valuation_le_one_iff, map_mul, map_zpow₀, hu1, one_zpow, mul_one,
      O.valuation_le_one_iff, hconstW]
  · intro ρ hρ hc1
    unfold wcEbCiAbPsi
    split_ifs with h
    · apply Valuation.map_one_sub_of_lt
      have e2 : algebraMap Ω (RatFunc Ω) ρ * RatFunc.X⁻¹ =
          algebraMap Ω (RatFunc Ω) (ρ / c) * (algebraMap Ω (RatFunc Ω) c * RatFunc.X⁻¹) := by
        rw [← mul_assoc, ← map_mul, div_mul_cancel₀ _ hc0]
      rw [e2, map_mul, hu2, mul_one]
      exact hsmall _ (hρ h)
    · apply Valuation.map_one_sub_of_lt
      have e2 : algebraMap Ω (RatFunc Ω) ρ⁻¹ * RatFunc.X =
          algebraMap Ω (RatFunc Ω) (ρ⁻¹ * c) * (algebraMap Ω (RatFunc Ω) c⁻¹ * RatFunc.X) := by
        rw [← mul_assoc, ← map_mul, mul_assoc, mul_inv_cancel₀ hc0, mul_one]
      rw [e2, map_mul, hu1, mul_one]
      apply hsmall
      rw [map_mul, map_inv₀, mul_comm]
      exact mul_lt_one_of_lt_of_le hc1 (inv_le_one_of_one_le₀ (not_lt.mp h))

have t_pin : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (θ : ↥W) (κ : Ω) (k : ℤ) (hθ0 : θ ≠ 0)
    (hθm : θ ∈ IsLocalRing.maximalIdeal ↥W)
    (H : ∀ c : Ω, c ≠ 0 → W.valuation c < 1 → (θ : Ω) / c ∈ W → κ * c ^ k ∈ W)
    (a : ↥W) (ha0 : a ≠ 0) (ham : a ∈ IsLocalRing.maximalIdeal ↥W)
    (hθa : (θ : Ω) / (a : Ω) ∈ W),
      algebraMap Ω (RatFunc Ω) κ * RatFunc.X ^ k ∈ wcEbRing W a := by
  intro Ω _ _ W θ κ k hθ0 hθm H a ha0 ham hθa
  have hθ0' : (θ : Ω) ≠ 0 := fun h => hθ0 (Subtype.ext h)
  have ha0' : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hθv : W.valuation (θ : Ω) < 1 := (ValuationSubring.valuation_lt_one_iff W θ).mp hθm
  have hav : W.valuation (a : Ω) < 1 := (ValuationSubring.valuation_lt_one_iff W a).mp ham
  have hC : ∀ w : Ω, w ∈ W → algebraMap Ω (RatFunc Ω) w ∈ wcEbRing W a := fun w hw =>
    Subring.subset_closure (Or.inl ⟨⟨w, hw⟩, rfl⟩)
  have hX : (RatFunc.X : RatFunc Ω) ∈ wcEbRing W a :=
    Subring.subset_closure (Or.inr (Set.mem_insert _ _))
  have haX : algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹ ∈ wcEbRing W a :=
    Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))
  have hXne : (RatFunc.X : RatFunc Ω) ≠ 0 := RatFunc.X_ne_zero
  have hCa : algebraMap Ω (RatFunc Ω) (a : Ω) ≠ 0 := (map_ne_zero _).mpr ha0'
  rcases lt_or_ge k 0 with hk | hk
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, k = -(n : ℤ) := ⟨(-k).toNat, by omega⟩
    have hw := H (a : Ω) ha0' hav hθa
    have e : algebraMap Ω (RatFunc Ω) κ * RatFunc.X ^ k =
        algebraMap Ω (RatFunc Ω) (κ * (a : Ω) ^ k) *
          (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹) ^ n := by
      subst hn
      simp only [zpow_neg, zpow_natCast, map_mul, map_pow, map_inv₀, mul_pow, inv_pow]
      field_simp
    rw [e]
    exact Subring.mul_mem _ (hC _ hw) (Subring.pow_mem _ haX _)
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, k = (n : ℤ) := ⟨k.toNat, by omega⟩
    subst hn
    simp only [zpow_natCast] at H ⊢
    suffices hκ : κ ∈ W from Subring.mul_mem _ (hC _ hκ) (Subring.pow_mem _ hX _)
    by_contra hκ
    have hκv : 1 < W.valuation κ := by
      rw [← not_le, W.valuation_le_one_iff]; exact hκ
    have hκ0 : κ ≠ 0 := by rintro rfl; exact hκ W.zero_mem
    have hκv0 : W.valuation κ ≠ 0 := (Valuation.ne_zero_iff _).mpr hκ0
    have hθθ : (θ : Ω) / (θ : Ω) ∈ W := by rw [div_self hθ0']; exact W.one_mem
    have h1 := H θ hθ0' hθv hθθ
    rcases Nat.eq_zero_or_pos n with rfl | hnpos
    · rw [pow_zero, mul_one] at h1; exact hκ h1
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq κ⁻¹ (by omega : 0 < 2 * n)
    have hcv : W.valuation c ^ (2 * n) = (W.valuation κ)⁻¹ := by rw [← map_pow, hc, map_inv₀]
    have hinvlt : (W.valuation κ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ hκv
    have hc1 : W.valuation c < 1 :=
      (pow_lt_one_iff (by omega : 2 * n ≠ 0)).mp (by rw [hcv]; exact hinvlt)
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [zero_pow (by omega)] at hc
      exact inv_ne_zero hκ0 hc.symm
    have h1v : W.valuation κ * W.valuation (θ : Ω) ^ n ≤ 1 := by
      rw [← map_pow, ← map_mul]; exact (W.valuation_le_one_iff _).mpr h1
    have hθc : W.valuation (θ : Ω) ≤ W.valuation c := by
      by_contra hlt
      push_neg at hlt
      have h2 : W.valuation c ^ (2 * n) < W.valuation (θ : Ω) ^ (2 * n) :=
        pow_lt_pow_left₀ hlt zero_le' (by omega)
      have h3 : W.valuation (θ : Ω) ^ (2 * n) ≤ W.valuation (θ : Ω) ^ n := by
        rw [two_mul, pow_add]
        exact mul_le_of_le_one_left zero_le' (pow_le_one₀ zero_le' hθv.le)
      have h4 : W.valuation (θ : Ω) ^ n ≤ (W.valuation κ)⁻¹ := by
        calc W.valuation (θ : Ω) ^ n
            = (W.valuation κ)⁻¹ * (W.valuation κ * W.valuation (θ : Ω) ^ n) := by
              rw [← mul_assoc, inv_mul_cancel₀ hκv0, one_mul]
          _ ≤ (W.valuation κ)⁻¹ * 1 := by gcongr
          _ = _ := mul_one _
      exact lt_irrefl _ (lt_of_lt_of_le h2 (h3.trans (h4.trans hcv.symm.le)))
    have hθcW : (θ : Ω) / c ∈ W := by
      rw [← W.valuation_le_one_iff, map_div₀]; exact div_le_one_of_le₀ hθc zero_le'
    have h5 := H c hc0 hc1 hθcW
    have e : (κ * c ^ n) * (κ * c ^ n) = κ := by
      have hcc : c ^ n * c ^ n = κ⁻¹ := by rw [← pow_add, ← two_mul, hc]
      calc (κ * c ^ n) * (κ * c ^ n) = κ * κ * (c ^ n * c ^ n) := by ring
        _ = κ := by rw [hcc, mul_assoc, mul_inv_cancel₀ hκ0, mul_one]
    exact hκ (e ▸ mul_mem h5 h5)

have t_factor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (F : RatFunc Ω), ∃ (κ : Ω) (k : ℤ) (Zn Zd : Multiset Ω),
    F * (Zd.map (wcEbCiAbPsi W)).prod =
      algebraMap Ω (RatFunc Ω) κ * RatFunc.X ^ k * (Zn.map (wcEbCiAbPsi W)).prod := by
  intro Ω _ _ W F
  classical
  obtain ⟨lam, hlam⟩ : ∃ f : Ω → Ω, ∀ ρ, f ρ = if W.valuation ρ < 1 then 1 else -ρ :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨ex, hex⟩ : ∃ f : Ω → ℕ, ∀ ρ, f ρ = if W.valuation ρ < 1 then 1 else 0 :=
    ⟨_, fun _ => rfl⟩
  have hXne : (RatFunc.X : RatFunc Ω) ≠ 0 := RatFunc.X_ne_zero
  have hCc : ∀ w : Ω, algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C w) =
      algebraMap Ω (RatFunc Ω) w := fun w => by rw [RatFunc.algebraMap_C]; rfl
  have hlam0 : ∀ ρ, lam ρ ≠ 0 := by
    intro ρ
    rw [hlam]
    split_ifs with h
    · exact one_ne_zero
