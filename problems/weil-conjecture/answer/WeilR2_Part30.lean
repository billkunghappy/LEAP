    rw [map_inv₀] at hfiO
    have h0 : algebraMap (RatFunc Ω) L f ≠ 0 := (map_ne_zero _).mpr hne
    have hu : IsUnit (⟨algebraMap (RatFunc Ω) L f, hfO⟩ : ↥V') :=
      isUnit_iff_exists_inv.mpr ⟨(⟨(algebraMap (RatFunc Ω) L f)⁻¹, hfiO⟩ : ↥V'),
