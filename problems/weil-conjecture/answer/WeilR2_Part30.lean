  rw [hcx, hdy]
  exact h2

theorem wcpa_dj_lr1k_nis_pole_kill : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : ValuationSubring (RatFunc Ω)), V.toSubring = wcEbGauss W → ∀ (M : Type u) [Field M] [Algebra (RatFunc Ω) M] [FiniteDimensional (RatFunc Ω) M] [IsGalois (RatFunc Ω) M] (V' : ValuationSubring M), V'.comap (algebraMap (RatFunc Ω) M) = V → (∀ x : M, x ≠ 0 → ∃ d : RatFunc Ω, d ≠ 0 ∧ ∃ u : V'ˣ, x = algebraMap (RatFunc Ω) M d * (u : M)) → letI : Algebra V M := ((algebraMap (RatFunc Ω) M).comp V.subtype).toAlgebra; ∀ b : M, IsIntegral V b → V'.valuation (b - 1) < 1 → (∀ σ : M ≃ₐ[RatFunc Ω] M, (∀ x : M, σ x ∈ V' ↔ x ∈ V') ∨ V'.valuation (σ b) < 1) → ∀ y ∈ V', ∃ k : ℕ, IsIntegral V (b ^ k * y) :=
