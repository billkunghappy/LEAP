    | mem x hx =>
      rcases hx with ⟨y, rfl⟩ | hx
      · exact ⟨Polynomial.C y, 1, by simp, by simp⟩
      · rw [Set.mem_singleton_iff] at hx
        exact ⟨Polynomial.X, 1, by simp, by simp [hx]⟩
    | one => exact ⟨1, 1, by simp, by simp⟩
    | add x y hx hy ihx ihy =>
