      rw [pow_succ' s, mul_assoc, ih, vmul, Matrix.mulVec_mulVec, ← pow_succ' M₀]



  have hπU : algebraMap K L π ∈ U₀ := (U₀.valuation_le_one_iff _).mp hπ1.le
  have hπV : π ∈ V₀ := by rw [← hU₀]; exact ValuationSubring.mem_comap.mpr hπU
  obtain ⟨π₀, rfl⟩ : ∃ π₀ : ↥V₀, (π₀ : K) = π := ⟨⟨π, hπV⟩, rfl⟩
  simp only [← hf] at hπ1 hmin
  have hπne : f π₀ ≠ 0 := by rw [hf]; exact (map_ne_zero _).mpr hπ0
  have hπm : π₀ ∈ IsLocalRing.maximalIdeal ↥V₀ := (s8 U₀ hU₀ π₀).mp hπ1
  have hρπ : IsLocalRing.residue ↥V₀ π₀ = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hπm
  have hdiv : ∀ d : ↥V₀, d ∈ IsLocalRing.maximalIdeal ↥V₀ → ∃ g : ↥V₀, d = π₀ * g := by
    intro d hd
    have h1 := hmin _ ((s8 U₀ hU₀ d).mpr hd)
    rw [hf, hf] at h1
    have h2 : algebraMap K L ((d : K) / π₀) ∈ U₀ := by
      rw [← U₀.valuation_le_one_iff, map_div₀, map_div₀]
      exact div_le_one_of_le₀ h1 zero_le'
    have h3 : (d : K) / π₀ ∈ V₀ := by
      have h4 : (d : K) / π₀ ∈ U₀.comap (algebraMap K L) := ValuationSubring.mem_comap.mpr h2
      rw [hU₀] at h4
      exact h4
    refine ⟨⟨(d : K) / π₀, h3⟩, Subtype.ext ?_⟩
    show (d : K) = (π₀ : K) * ((d : K) / (π₀ : K))
    field_simp

  have hQ : ∀ d : Fin N → ↥V₀, (∀ i, IsLocalRing.residue ↥V₀ (d i) = 0) →
      ∃ g, vec d = f π₀ * vec g := by
    intro d hd
    choose g hg using fun i => hdiv (d i) ((IsLocalRing.residue_eq_zero_iff _).mp (hd i))
    refine ⟨g, ?_⟩
    rw [← vsmul]
    congr 1
    funext i
    rw [Pi.smul_apply, smul_eq_mul]
    exact hg i

  have hR' : ∀ (w : Fin N → ↥V₀) (y : L),
      (∀ V : ValuationSubring L, V.comap (algebraMap K L) = V₀ → y ∈ V) →
      vec w = f π₀ * y → ∀ i, IsLocalRing.residue ↥V₀ (w i) = 0 := by
    intro w y hy hw i
    obtain ⟨h, hh⟩ := hspan' y (s1 y hy)
    have : w = π₀ • h := vinj _ _ (by rw [hw, vsmul, ← hh])
    rw [this, Pi.smul_apply, smul_eq_mul, map_mul, hρπ, zero_mul]



  have hKey : ∀ w : Fin N → ↥V₀, (∀ i, IsLocalRing.residue ↥V₀ ((M₀ ^ N).mulVec w i) = 0) →
      U₀.valuation (vec w) < 1 → ∀ i, IsLocalRing.residue ↥V₀ (w i) = 0 := by
    intro w hw hU
    obtain ⟨g, hg⟩ := hQ _ hw
    have hsw : s ^ N * vec w = f π₀ * vec g := by rw [vpow, hg]
    apply hR' w (vec w / f π₀)
    · intro V hV
      rw [← V.valuation_le_one_iff, map_div₀]
      by_cases hVU : V = U₀
      · rw [hVU]
        exact div_le_one_of_le₀ (hmin _ hU) zero_le'
      · have h1 : V.valuation (vec w) = V.valuation (f π₀) * V.valuation (vec g) := by
          rw [← map_mul, ← hsw, map_mul, map_pow, hsV1 V hV hVU, one_pow, one_mul]
        rw [h1]
        exact div_le_one_of_le₀ (mul_le_of_le_one_right' (hval_le V _ (vmem g V hV))) zero_le'
    · field_simp



  have s3 : ∀ x : L, IsIntegral ↥V₀ x → ∃ c : ↥V₀, U₀.valuation (x - f c) < 1 := by
    intro x hx
    have hxmem : x ∈ U₀ := s7 U₀ hU₀ x hx
    have hxU : U₀.valuation x ≤ 1 := (U₀.valuation_le_one_iff _).mpr hxmem
    obtain ⟨p, hpm, hp⟩ := hx
    set q := p.map (IsLocalRing.residue ↥V₀) with hq
    have hqm : q.Monic := hpm.map _
    have hqprod : (q.roots.map (fun r => Polynomial.X - Polynomial.C r)).prod = q :=
      Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hqm
        IsAlgClosed.card_roots_eq_natDegree
    choose lam hlam using
      (IsLocalRing.residue_surjective : Function.Surjective (IsLocalRing.residue ↥V₀))
    set g : Polynomial ↥V₀ :=
      (q.roots.map (fun r => Polynomial.X - Polynomial.C (lam r))).prod with hg
    have hgq : g.map (IsLocalRing.residue ↥V₀) = q := by
      rw [hg, Polynomial.map_multiset_prod, Multiset.map_map]
      conv_rhs => rw [← hqprod]
      congr 1
      apply Multiset.map_congr rfl
      intro r _
      simp [hlam r]
    have hcoef : ∀ j, (p - g).coeff j ∈ IsLocalRing.maximalIdeal ↥V₀ := by
      intro j
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.coeff_map, Polynomial.map_sub, hgq,
        ← hq, sub_self, Polynomial.coeff_zero]
    have h1 : U₀.valuation (Polynomial.eval₂ f x (p - g)) < 1 := by
      rw [Polynomial.eval₂_eq_sum_range]
      refine Valuation.map_sum_lt _ one_ne_zero fun j _ => ?_
      rw [map_mul, map_pow]
      exact (mul_le_of_le_one_right' (pow_le_one₀ zero_le' hxU)).trans_lt
        ((s8 U₀ hU₀ _).mpr (hcoef j))
    have hp' : Polynomial.eval₂ f x p = 0 := by rw [hfalg]; exact hp
    have h2 : Polynomial.eval₂ f x g = (q.roots.map (fun r => x - f (lam r))).prod := by
      rw [hg, Polynomial.eval₂_multiset_prod, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro r _
      simp
    have h3 : U₀.valuation (Polynomial.eval₂ f x g) < 1 := by
      have : Polynomial.eval₂ f x g = -Polynomial.eval₂ f x (p - g) := by
        rw [Polynomial.eval₂_sub, hp']; ring
      rw [this, Valuation.map_neg]; exact h1
    by_contra hall
    push_neg at hall
    have h4 : U₀.valuation ((q.roots.map (fun r => x - f (lam r))).prod) = 1 := by
      rw [map_multiset_prod, Multiset.map_map]
      apply Multiset.prod_eq_one
      intro y hy
      obtain ⟨r, _, rfl⟩ := Multiset.mem_map.mp hy
      exact le_antisymm (hval_le U₀ _ (U₀.sub_mem hxmem (hfV U₀ hU₀ _))) (hall _)
    rw [h2, h4] at h3
    exact lt_irrefl _ h3



  have hmapv : ∀ (A : Matrix (Fin N) (Fin N) ↥V₀) (w : Fin N → ↥V₀) (j : Fin N),
      IsLocalRing.residue ↥V₀ (A.mulVec w j) =
        (A.map (IsLocalRing.residue ↥V₀)).mulVec (fun k => IsLocalRing.residue ↥V₀ (w k)) j :=
    fun A w j => RingHom.map_mulVec _ A w j

  have hroots : ∀ μ : IsLocalRing.ResidueField ↥V₀,
      ((M₀.map (IsLocalRing.residue ↥V₀)).charpoly).eval μ = 0 → μ = 0 ∨ μ = 1 := by
    intro μ hμ
    by_contra hcon
    push_neg at hcon
    obtain ⟨hμ0, hμ1⟩ := hcon
    rw [Matrix.eval_charpoly] at hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hμ
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective μ
    choose w hw using fun j => IsLocalRing.residue_surjective (v j)
    have hvw : v = fun j => IsLocalRing.residue ↥V₀ (w j) := funext fun j => (hw j).symm
    subst hvw
    set d : Fin N → ↥V₀ := c • w - M₀.mulVec w with hd
    have hdres : ∀ j, IsLocalRing.residue ↥V₀ (d j) = 0 := by
      intro j
      have h1 : (Matrix.scalar (Fin N) (IsLocalRing.residue ↥V₀ c) -
          M₀.map (IsLocalRing.residue ↥V₀)).mulVec
          (fun k => IsLocalRing.residue ↥V₀ (w k)) j = IsLocalRing.residue ↥V₀ (d j) := by
        rw [hd, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, map_sub, map_mul, hmapv,
          Matrix.sub_mulVec, Pi.sub_apply, Matrix.scalar_apply, Matrix.mulVec_diagonal]
      rw [← h1, hv]
      rfl
    obtain ⟨g, hg⟩ := hQ d hdres
    have hdv : vec d = (f c - s) * vec w := by
      rw [hd, vsub, vsmul, ← vmul]; ring
    have hcu : IsUnit c := (IsLocalRing.residue_ne_zero_iff_isUnit c).mp hμ0
    have hc1u : IsUnit (c - 1) := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      (by rw [map_sub, map_one]; exact sub_ne_zero.mpr hμ1)
    have ht1 : ∀ V : ValuationSubring L, V.comap (algebraMap K L) = V₀ →
        V.valuation (f c - s) = 1 := by
      intro V hV
      by_cases hVU : V = U₀
      · rw [hVU]
        have h1 : U₀.valuation (-s) < U₀.valuation (f c) := by
          rw [Valuation.map_neg, hunit1 U₀ hU₀ c hcu]; exact hsU
        rw [sub_eq_add_neg, Valuation.map_add_eq_of_lt_left _ h1, hunit1 U₀ hU₀ c hcu]
      · have h1 : V.valuation (-(s - 1)) < V.valuation (f (c - 1)) := by
          rw [Valuation.map_neg, hunit1 V hV _ hc1u]; exact hsep V hV hVU
        have : f c - s = f (c - 1) + -(s - 1) := by rw [map_sub, map_one]; ring
        rw [this, Valuation.map_add_eq_of_lt_left _ h1, hunit1 V hV _ hc1u]
    have ht0 : f c - s ≠ 0 := by
      intro h
      have := ht1 U₀ hU₀
      rw [h, map_zero] at this
      exact zero_ne_one this
    have htw : (f c - s) * vec w = f π₀ * vec g := by rw [← hdv, hg]
    have := hR' w ((f c - s)⁻¹ * vec g) ?_ ?_
    · apply hv0
      funext j
      exact this j
    · intro V hV
      rw [← V.valuation_le_one_iff, map_mul, map_inv₀, ht1 V hV, inv_one, one_mul]
      exact hval_le V _ (vmem g V hV)
    · calc vec w = (f c - s)⁻¹ * ((f c - s) * vec w) := by
            rw [← mul_assoc, inv_mul_cancel₀ ht0, one_mul]
        _ = f π₀ * ((f c - s)⁻¹ * vec g) := by rw [htw]; ring

  have hzero : ((M₀.map (IsLocalRing.residue ↥V₀)).charpoly).eval 0 = 0 := by
    rw [Matrix.eval_charpoly, map_zero, zero_sub, Matrix.det_neg]
    have hdet : IsLocalRing.residue ↥V₀ M₀.det = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hMM := Matrix.mul_nonsing_inv M₀ hu
      obtain ⟨c₁, hc₁⟩ := hspan' 1 isIntegral_one
      have h1 : s * vec (M₀⁻¹.mulVec c₁) = 1 := by
        rw [vmul, Matrix.mulVec_mulVec, hMM, Matrix.one_mulVec, ← hc₁]
      have h2 := congrArg U₀.valuation h1
      rw [map_mul, map_one] at h2
      have h3 := (mul_le_of_le_one_right' (hval_le U₀ _ (vmem (M₀⁻¹.mulVec c₁) U₀ hU₀))).trans_lt hsU
      rw [h2] at h3
      exact lt_irrefl _ h3
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det, hdet, mul_zero]

  have hker : Module.finrank (IsLocalRing.ResidueField ↥V₀)
      ↥(LinearMap.ker (Matrix.toLin' ((M₀.map (IsLocalRing.residue ↥V₀)) ^ N))) ≤ 1 := by
    set Z := LinearMap.ker (Matrix.toLin' ((M₀.map (IsLocalRing.residue ↥V₀)) ^ N)) with hZ
    have hmemZ : ∀ w : Fin N → ↥V₀, (fun j => IsLocalRing.residue ↥V₀ (w j)) ∈ Z →
        ∀ j, IsLocalRing.residue ↥V₀ ((M₀ ^ N).mulVec w j) = 0 := by
      intro w hw j
      rw [hmapv, Matrix.map_pow]
      rw [hZ, LinearMap.mem_ker, Matrix.toLin'_apply] at hw
      rw [hw]
      rfl
    by_cases hZ0 : ∀ v ∈ Z, v = 0
    · apply finrank_le_one (0 : ↥Z)
      intro z
      exact ⟨0, by rw [zero_smul]; exact Subtype.ext (hZ0 z z.2).symm⟩
    · push_neg at hZ0
      obtain ⟨v₀, hv₀Z, hv₀⟩ := hZ0
      choose w₀ hw₀ using fun j => IsLocalRing.residue_surjective (v₀ j)
      have hv₀e : v₀ = fun j => IsLocalRing.residue ↥V₀ (w₀ j) := funext fun j => (hw₀ j).symm
      subst hv₀e
      obtain ⟨c₀, hc₀⟩ := s3 (vec w₀) (s1 _ (fun V hV => vmem w₀ V hV))
      have hc₀u : IsUnit c₀ := by
        by_contra hnu
        have hm : U₀.valuation (f c₀) < 1 :=
          (s8 U₀ hU₀ c₀).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
        have hx : U₀.valuation (vec w₀) < 1 := by
          have : vec w₀ = (vec w₀ - f c₀) + f c₀ := by ring
          rw [this]
          exact Valuation.map_add_lt _ hc₀ hm
        apply hv₀
        funext j
        exact hKey w₀ (hmemZ w₀ hv₀Z) hx j
      have hρc₀ : IsLocalRing.residue ↥V₀ c₀ ≠ 0 :=
        (IsLocalRing.residue_ne_zero_iff_isUnit c₀).mpr hc₀u
      apply finrank_le_one (⟨_, hv₀Z⟩ : ↥Z)
      rintro ⟨v, hvZ⟩
      choose w hw using fun j => IsLocalRing.residue_surjective (v j)
      have hve : v = fun j => IsLocalRing.residue ↥V₀ (w j) := funext fun j => (hw j).symm
      subst hve
      obtain ⟨c, hc⟩ := s3 (vec w) (s1 _ (fun V hV => vmem w V hV))
      set w' := c₀ • w - c • w₀ with hw'
      have hw'Z : (fun j => IsLocalRing.residue ↥V₀ (w' j)) ∈ Z := by
        have : (fun j => IsLocalRing.residue ↥V₀ (w' j)) =
            IsLocalRing.residue ↥V₀ c₀ • (fun j => IsLocalRing.residue ↥V₀ (w j)) -
              IsLocalRing.residue ↥V₀ c • (fun j => IsLocalRing.residue ↥V₀ (w₀ j)) := by
          funext j
          simp [hw']
        rw [this]
        exact Z.sub_mem (Z.smul_mem _ hvZ) (Z.smul_mem _ hv₀Z)
      have hU : U₀.valuation (vec w') < 1 := by
        have : vec w' = f c₀ * (vec w - f c) - f c * (vec w₀ - f c₀) := by
          rw [hw', vsub, vsmul, vsmul]; ring
        rw [this, sub_eq_add_neg]
        refine Valuation.map_add_lt _ ?_ ?_
        · rw [map_mul]
          exact (mul_le_of_le_one_left' (hfle U₀ hU₀ c₀)).trans_lt hc
        · rw [Valuation.map_neg, map_mul]
          exact (mul_le_of_le_one_left' (hfle U₀ hU₀ c)).trans_lt hc₀
      have hres := hKey w' (hmemZ w' hw'Z) hU
      refine ⟨IsLocalRing.residue ↥V₀ c / IsLocalRing.residue ↥V₀ c₀, Subtype.ext ?_⟩
      show (IsLocalRing.residue ↥V₀ c / IsLocalRing.residue ↥V₀ c₀) •
          (fun j => IsLocalRing.residue ↥V₀ (w₀ j)) = fun j => IsLocalRing.residue ↥V₀ (w j)
      funext j
      have := hres j
      simp only [hw', Pi.sub_apply, Pi.smul_apply, smul_eq_mul, map_sub, map_mul] at this
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [div_mul_eq_mul_div, div_eq_iff hρc₀]
      linear_combination -this



  have hpat : (M₀.map (IsLocalRing.residue ↥V₀)).charpoly =
      Polynomial.X * (Polynomial.X - 1) ^ (N - 1) := by
    set A := M₀.map (IsLocalRing.residue ↥V₀) with hA
    set χ := A.charpoly with hχ
    have hmon : χ.Monic := Matrix.charpoly_monic A
    have hdeg : χ.natDegree = N := by
      rw [hχ, Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
    have hne : χ ≠ 0 := hmon.ne_zero
    have hcard : Multiset.card χ.roots = N := by
      rw [IsAlgClosed.card_roots_eq_natDegree, hdeg]
    have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmon
      (hcard.trans hdeg.symm)
    have hmult : χ.rootMultiplicity 0 ≤ 1 := by
      have h := LinearMap.finrank_maxGenEigenspace_eq (Matrix.toLin' A) 0
      rw [Matrix.charpoly_toLin', Module.End.maxGenEigenspace_eq_genEigenspace_finrank,
        Module.End.genEigenspace_nat, Module.finrank_fin_fun, zero_smul, sub_zero,
        ← Matrix.toLin'_pow] at h
      rw [show χ = A.charpoly from rfl, ← h]
      exact hker
    have hroot0 : 0 < χ.rootMultiplicity 0 := (Polynomial.rootMultiplicity_pos hne).mpr hzero
    have hcount : χ.roots.count 0 = 1 := by rw [Polynomial.count_roots]; omega
    have hmem0 : (0 : IsLocalRing.ResidueField ↥V₀) ∈ χ.roots :=
      Multiset.count_pos.mp (by omega)
    set R' := χ.roots.erase 0 with hR'
    have hR'card : Multiset.card R' = N - 1 := by
      rw [hR', Multiset.card_erase_of_mem hmem0, hcard, Nat.pred_eq_sub_one]
    have hR'rep : R' = Multiset.replicate (N - 1) 1 := by
      rw [Multiset.eq_replicate]
      refine ⟨hR'card, fun b hb => ?_⟩
      have hb' : b ∈ χ.roots := Multiset.mem_of_mem_erase hb
      have hb0 : b ≠ 0 := by
        rintro rfl
        have h1 := Multiset.count_erase_self (0 : IsLocalRing.ResidueField ↥V₀) χ.roots
        have h2 := Multiset.count_pos.mpr hb
        rw [hcount] at h1
        rw [← hR'] at h1
        omega
      rcases hroots b ((Polynomial.mem_roots hne).mp hb') with h | h
      · exact absurd h hb0
      · exact h
    rw [← hprod, ← Multiset.cons_erase hmem0, ← hR', hR'rep]
    simp only [Multiset.map_cons, Multiset.prod_cons, Multiset.map_replicate,
      Multiset.prod_replicate, map_zero, map_one, sub_zero]



  have hP : (M₀.map (IsLocalRing.residue ↥V₀)).charpoly =
      (wcEgP N).map (Int.castRingHom (IsLocalRing.ResidueField ↥V₀)) := by
    rw [hpat, wcEgP]
    simp [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_sub]
  set a : ↥V₀ := M₀.charpoly.coeff i - (((wcEgP N).coeff i : ℤ) : ↥V₀) with ha
  have hρa : IsLocalRing.residue ↥V₀ a = 0 := by
    have h1 := congrArg (fun p => Polynomial.coeff p i) hP
    simp only [Matrix.charpoly_map, Polynomial.coeff_map, eq_intCast] at h1
    rw [ha, map_sub, h1, map_intCast, sub_self]
  have hgoal : algebraMap K L ((LinearMap.charpoly (Algebra.lmul K L s)).coeff i) -
      (((wcEgP N).coeff i : ℤ) : L) = f a := by
    rw [hchi, Polynomial.coeff_map, hf, ha]
    simp
  rw [hgoal]
  exact (s8 U₀ hU₀ a).mpr ((IsLocalRing.residue_eq_zero_iff _).mp hρa)

theorem wcpa_dj_lr1k_eb_eg_sep_bcf_eta_gauss_one : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (L : Type u) [Field L] [Algebra (RatFunc Ω) L]
    (V₁ U : ValuationSubring L) (η : L),
    (V₁.comap (algebraMap (RatFunc Ω) L)).toSubring = wcEbGauss W →
    U ≤ V₁ → V₁.valuation η = 1 → U.valuation η < 1 →
    (∀ w : ↥W, algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (w : Ω)) ∈ U) →
    ∀ ψ : RatFunc Ω →+* L,
      (∀ w : Ω, ψ (algebraMap Ω (RatFunc Ω) w) =
        algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w)) →
      ψ RatFunc.X = η →
      ∀ x : RatFunc Ω, x ∈ wcEbGauss W ↔ ψ x ∈ V₁ :=
by
  classical
  intro Ω _ _ W

  obtain ⟨VG, hVG, hVG2, -, hVG4⟩ : ∃ V : ValuationSubring (RatFunc Ω), V.toSubring = wcEbGauss W ∧
      (∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W) ∧
      (∀ a : Ω, V.valuation (algebraMap Ω (RatFunc Ω) a) < 1 ↔ W.valuation a < 1) ∧
      ∀ f : RatFunc Ω, f ≠ 0 → ∃ a : Ω, a ≠ 0 ∧ ∃ u : Vˣ,
        f = algebraMap Ω (RatFunc Ω) a * ((u : V) : RatFunc Ω) := by
    have key : ∀ (x : Ω) (R : Polynomial Ω),
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x * R) =
          algebraMap Ω (RatFunc Ω) x * algebraMap (Polynomial Ω) (RatFunc Ω) R := by
      intro x R
      rw [map_mul, Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply]
    have alg_inj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
      RatFunc.algebraMap_injective Ω
    have g0 : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.map W.subtype ≠ 0 := by
      rintro q ⟨i, hi⟩ h
      have h1 := congrArg (fun P => P.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      have h2 : q.coeff i = 0 := Subtype.ext h1
      exact hi.ne_zero h2
    have s1 : ∀ P Q : Polynomial ↥W, (∃ i, IsUnit (P.coeff i)) → (∃ j, IsUnit (Q.coeff j)) →
        ∃ k, IsUnit ((P * Q).coeff k) := by
      rintro P Q ⟨i, hi⟩ ⟨j, hj⟩
      have hP : P.map (IsLocalRing.residue ↥W) ≠ 0 := by
        intro h
        have h1 := congrArg (fun R => R.coeff i) h
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h1
      have hQ : Q.map (IsLocalRing.residue ↥W) ≠ 0 := by
        intro h
        have h1 := congrArg (fun R => R.coeff j) h
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hj h1
      have hPQ : (P * Q).map (IsLocalRing.residue ↥W) ≠ 0 := by
        rw [Polynomial.map_mul]
        exact mul_ne_zero hP hQ
      obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hPQ
      rw [Polynomial.mem_support_iff, Polynomial.coeff_map] at hk
      exact ⟨k, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hk⟩
    have s2 : ∀ P : Polynomial Ω, P ≠ 0 → ∃ (a : Ω) (P₀ : Polynomial ↥W), a ≠ 0 ∧
        (∃ i, IsUnit (P₀.coeff i)) ∧ P = Polynomial.C a * P₀.map W.subtype := by
      intro P hP
      obtain ⟨j, hj, hmax⟩ := Finset.exists_max_image P.support
        (fun n => W.valuation (P.coeff n)) (Polynomial.support_nonempty.mpr hP)
      have ha0 : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
      have hcoef : ∀ n, (P.coeff j)⁻¹ * P.coeff n ∈ W := by
        intro n
        by_cases hn : P.coeff n = 0
        · rw [hn, mul_zero]; exact W.zero_mem
        · rw [← ValuationSubring.valuation_le_one_iff]
          have hle := hmax n (Polynomial.mem_support_iff.mpr hn)
          calc W.valuation ((P.coeff j)⁻¹ * P.coeff n)
              = W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff n) := Valuation.map_mul _ _ _
            _ ≤ W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff j) := by gcongr
            _ = W.valuation ((P.coeff j)⁻¹ * P.coeff j) := (Valuation.map_mul _ _ _).symm
            _ = 1 := by rw [inv_mul_cancel₀ ha0, Valuation.map_one]
      have hlift : Polynomial.C (P.coeff j)⁻¹ * P ∈ Polynomial.lifts W.subtype := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        rw [Polynomial.coeff_C_mul]
        exact ⟨⟨_, hcoef n⟩, rfl⟩
      obtain ⟨P₀, hP₀⟩ := (Polynomial.mem_lifts _).mp hlift
      refine ⟨P.coeff j, P₀, ha0, ⟨j, ?_⟩, ?_⟩
      · have h1 : ((P₀.coeff j : ↥W) : Ω) = 1 := by
          have h3 := congrArg (fun R => R.coeff j) hP₀
          simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at h3
          rw [inv_mul_cancel₀ ha0] at h3
          exact h3
        have h2 : P₀.coeff j = 1 := Subtype.ext h1
        rw [h2]
        exact isUnit_one
      · rw [hP₀, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1, one_mul]
    have s3 : ∀ f : RatFunc Ω, f ≠ 0 → ∃ (a : Ω) (N D : Polynomial ↥W), a ≠ 0 ∧
        (∃ i, IsUnit (N.coeff i)) ∧ (∃ j, IsUnit (D.coeff j)) ∧
        f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) =
          algebraMap Ω (RatFunc Ω) a * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) := by
      intro f hf
      have hnum : f.num ≠ 0 := RatFunc.num_ne_zero hf
      have hden : f.denom ≠ 0 := RatFunc.denom_ne_zero f
      obtain ⟨a₁, N, ha₁, hN, hNe⟩ := s2 _ hnum
      obtain ⟨b, D, hb, hD, hDe⟩ := s2 _ hden
      refine ⟨a₁ / b, N, D, div_ne_zero ha₁ hb, hN, hD, ?_⟩
      have hd0 : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 := by
        intro h
        apply hden
        apply alg_inj
        rw [h, map_zero]
      have hf' : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
          algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
        have hnd := RatFunc.num_div_denom f
        calc f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom
            = (algebraMap (Polynomial Ω) (RatFunc Ω) f.num /
                algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) *
                algebraMap (Polynomial Ω) (RatFunc Ω) f.denom := by rw [hnd]
          _ = algebraMap (Polynomial Ω) (RatFunc Ω) f.num := div_mul_cancel₀ _ hd0
      rw [hNe, hDe, key, key] at hf'
      have hcb : algebraMap Ω (RatFunc Ω) b ≠ 0 := (map_ne_zero _).mpr hb
      rw [map_div₀, div_mul_eq_mul_div, eq_div_iff hcb, ← hf']
      ring
    have s4 : ∀ {K : Type u} [Field K] (A : ValuationSubring K) (x : K),
        A.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ A) := by
      intro K _ A x
      by_cases hx : x = 0
      · subst hx
        simp
      · have hpos : 0 < A.valuation x := (Valuation.pos_iff _).mpr hx
        rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_inv, inv_le_one₀ hpos]
        simp [hx]
    obtain ⟨T, hT⟩ : ∃ T : Subring (RatFunc Ω), ∀ f : RatFunc Ω, f ∈ T ↔
        ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ q.map W.subtype ≠ 0 ∧
          f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
            algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) := by
      refine ⟨{ carrier := {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
                  q.map W.subtype ≠ 0 ∧
                  f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
                    algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)}
                mul_mem' := ?_
                one_mem' := ?_
                add_mem' := ?_
                zero_mem' := ?_
                neg_mem' := ?_ }, fun f => Iff.rfl⟩
      · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
        have hq := s1 q₁ q₂ hq₁ hq₂
        refine ⟨p₁ * p₂, q₁ * q₂, hq, g0 _ hq, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_mul, map_mul, map_mul, ← h₁, ← h₂]
        ring
      · exact ⟨1, 1, ⟨0, by simp⟩, by simp, by simp⟩
      · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
        have hq := s1 q₁ q₂ hq₁ hq₂
        refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, hq, g0 _ hq, ?_⟩
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_mul, map_add,
          map_mul, map_mul, map_mul, ← h₁, ← h₂]
        ring
      · exact ⟨0, 1, ⟨0, by simp⟩, by simp, by simp⟩
      · rintro f ⟨p, q, hq, hq0, h⟩
        refine ⟨-p, q, hq, hq0, ?_⟩
        rw [Polynomial.map_neg, map_neg, ← h]
        ring
    have hmem : ∀ f : RatFunc Ω, f ∈ T ∨ f⁻¹ ∈ T := by
      intro f
      by_cases hf : f = 0
      · left
        rw [hf]
        exact T.zero_mem
      obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
      rcases W.mem_or_inv_mem a with h | h
      · left
        rw [hT]
        refine ⟨Polynomial.C ⟨a, h⟩ * N, D, hD, g0 _ hD, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_C, key]
        exact he
      · right
        rw [hT]
        refine ⟨Polynomial.C ⟨a⁻¹, h⟩ * D, N, hN, g0 _ hN, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_C, key]
        have hsub : W.subtype ⟨a⁻¹, h⟩ = a⁻¹ := rfl
        have hca : algebraMap Ω (RatFunc Ω) a ≠ 0 := (map_ne_zero _).mpr ha
        rw [hsub, map_inv₀]
        calc f⁻¹ * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)
            = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ * (algebraMap Ω (RatFunc Ω) a *
                algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)) := by
              rw [mul_assoc, inv_mul_cancel_left₀ hca]
          _ = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ *
                (f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype)) := by rw [he]
          _ = (algebraMap Ω (RatFunc Ω) a)⁻¹ *
                algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := by
              rw [mul_comm f⁻¹, mul_assoc, inv_mul_cancel_left₀ hf]
    obtain ⟨V, hVT, hVsub⟩ : ∃ V : ValuationSubring (RatFunc Ω), (∀ f, f ∈ V ↔ f ∈ T) ∧
        V.toSubring = T := ⟨{ T with mem_or_inv_mem' := hmem }, fun f => Iff.rfl, rfl⟩
    have hC2 : ∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W := by
      intro a
      rw [hVT, hT]
      constructor
      · rintro ⟨p, q, hq, -, h⟩
        rw [← key] at h
        have h2 := alg_inj h
        obtain ⟨i, hi⟩ := hq
        have h3 := congrArg (fun R => R.coeff i) h2
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map] at h3
        obtain ⟨w, hw⟩ := hi.exists_left_inv
        have h4 : a = W.subtype (p.coeff i) * W.subtype w := by
          rw [← h3, mul_assoc, ← map_mul, mul_comm (q.coeff i) w, hw, map_one, mul_one]
        rw [h4]
        exact (p.coeff i * w).2
      · intro h
        refine ⟨Polynomial.C ⟨a, h⟩, 1, ⟨0, by simp⟩, by simp, ?_⟩
        rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C]
        have h5 := key a 1
        rw [mul_one, map_one, mul_one] at h5
        exact h5.symm
    refine ⟨V, ?_, hC2, ?_, ?_⟩
    · rw [hVsub]
      unfold wcEbGauss
      apply le_antisymm
      · intro f hf
        exact Subring.subset_closure ((hT f).mp hf)
      · exact Subring.closure_le.mpr (fun f hf => (hT f).mpr hf)
    · intro a
      rw [s4 V, s4 W, map_eq_zero, ← map_inv₀, hC2]
    · intro f hf
      obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
      have hN0 : algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) ≠ 0 :=
        fun h => g0 N hN (alg_inj (h.trans (map_zero _).symm))
      have hD0 : algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) ≠ 0 :=
        fun h => g0 D hD (alg_inj (h.trans (map_zero _).symm))
      obtain ⟨g, hg⟩ : ∃ g : RatFunc Ω, g = algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) /
          algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := ⟨_, rfl⟩
      have hg0 : g ≠ 0 := by rw [hg]; exact div_ne_zero hN0 hD0
      have hgV : g ∈ V := by
        rw [hVT, hT]
        refine ⟨N, D, hD, g0 _ hD, ?_⟩
        rw [hg]
        exact div_mul_cancel₀ _ hD0
      have hgiV : g⁻¹ ∈ V := by
        rw [hVT, hT]
        refine ⟨D, N, hN, g0 _ hN, ?_⟩
        rw [hg, inv_div]
        exact div_mul_cancel₀ _ hN0
      refine ⟨a, ha, ⟨⟨g, hgV⟩, ⟨g⁻¹, hgiV⟩, Subtype.ext (mul_inv_cancel₀ hg0),
        Subtype.ext (inv_mul_cancel₀ hg0)⟩, ?_⟩
      show f = algebraMap Ω (RatFunc Ω) a * g
      rw [hg, mul_div_assoc', eq_div_iff hD0]
      exact he

  haveI hk : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    refine IsAlgClosed.of_exists_root _ ?_
    intro pb hmon hirr
    have hdeg : 0 < pb.degree := Polynomial.degree_pos_of_irreducible hirr
    have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.mem_lifts]
      exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
    obtain ⟨p, hpmap, hpdeg, hpmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
    have hPdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hpmon.degree_map, hpdeg]
      exact ne_of_gt hdeg
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hPdeg
    have hx' : Polynomial.eval x (p.map (algebraMap ↥W Ω)) = 0 := hx
    have hint : IsIntegral ↥W x := ⟨p, hpmon, by rw [← Polynomial.eval_map]; exact hx'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hpy : p.eval y = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval_map_apply, hy]
      exact hx'
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hpmap, Polynomial.eval_map_apply, hpy, map_zero]
  intro L _ _ V₁ U η h hUV hV₁η hUη hWU ψ hψw hψX
  let ι : Ω →+* L := (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))
  have hlt_iff : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F), y ≠ 0 →
      (A.valuation y < 1 ↔ y⁻¹ ∉ A) := by
    intro F _ A y hy
    rw [← A.valuation_le_one_iff, map_inv₀, not_le]
    have h0 : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
    rw [one_lt_inv₀ (zero_lt_iff.mpr h0)]

  have hVeq : V₁.comap (algebraMap (RatFunc Ω) L) = VG :=
    ValuationSubring.toSubring_injective (h.trans hVG.symm)
  have hGmem : ∀ y : RatFunc Ω, y ∈ wcEbGauss W ↔ y ∈ VG := fun y => by
    rw [← hVG]; exact Iff.rfl
  have hcomap : ∀ y : RatFunc Ω, algebraMap (RatFunc Ω) L y ∈ V₁ ↔ y ∈ VG := fun y => by
    rw [← hVeq]; exact Iff.rfl
  have hι : ∀ w : Ω, ι w ∈ V₁ ↔ w ∈ W := fun w => (hcomap _).trans (hVG2 w)
  have hηV : η ∈ V₁ := (V₁.valuation_le_one_iff η).mp hV₁η.le

  have hF1 : ∀ m : ↥W, m ∈ IsLocalRing.maximalIdeal ↥W → V₁.valuation (ι (m : Ω)) < 1 := by
    intro m hm
    by_cases hm0 : (m : Ω) = 0
    · rw [hm0, map_zero, map_zero]; exact zero_lt_one
    · have hι0 : ι (m : Ω) ≠ 0 := (map_ne_zero ι).mpr hm0
      rw [hlt_iff V₁ _ hι0, ← map_inv₀, hι]
      intro hinv
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hm))
        (isUnit_iff_exists_inv.mpr ⟨⟨(m : Ω)⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ hm0)⟩)

  have hF2 : ∀ z : L, V₁.valuation z < 1 → U.valuation z < 1 := by
    intro z hz
    by_cases hz0 : z = 0
    · rw [hz0, map_zero]; exact zero_lt_one
    · rw [hlt_iff V₁ z hz0] at hz
      rw [hlt_iff U z hz0]
      exact fun hU => hz (hUV hU)

  have hlin : ∀ α : ↥W, V₁.valuation (η - ι (α : Ω)) = 1 := by
    intro α
    have hαV : ι (α : Ω) ∈ V₁ := (hι _).mpr α.2
    have hzV : η - ι (α : Ω) ∈ V₁ := sub_mem hηV hαV
    have hle : V₁.valuation (η - ι (α : Ω)) ≤ 1 := (V₁.valuation_le_one_iff _).mpr hzV
    by_contra hne
    have hlt : V₁.valuation (η - ι (α : Ω)) < 1 := lt_of_le_of_ne hle hne
    have hUz := hF2 _ hlt
    have hUα : U.valuation (ι (α : Ω)) < 1 := by
      have := Valuation.map_sub_lt U.valuation hUη hUz
      rwa [sub_sub_cancel] at this
    by_cases hu : IsUnit α
    · obtain ⟨β, hβ⟩ := isUnit_iff_exists_inv.mp hu
      have hβU : ι (β : Ω) ∈ U := hWU β
      have hβle : U.valuation (ι (β : Ω)) ≤ 1 := (U.valuation_le_one_iff _).mpr hβU
      have hprod : ι (α : Ω) * ι (β : Ω) = 1 := by
        rw [← map_mul, ← map_one ι]
        congr 1
        exact congrArg Subtype.val hβ
      have h1 : U.valuation (ι (α : Ω) * ι (β : Ω)) < 1 := by
        rw [map_mul]; exact mul_lt_one_of_lt_of_le hUα hβle
      rw [hprod, map_one] at h1
      exact lt_irrefl _ h1
    · have hαm : α ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu)
      have h1 := hF1 α hαm
      have h2 := Valuation.map_add_lt V₁.valuation hlt h1
      rw [sub_add_cancel, hV₁η] at h2
      exact lt_irrefl _ h2

  have hfac : ∀ R : Polynomial ↥W, (∃ i, IsUnit (R.coeff i)) →
      ∃ (c : ↥W) (s : Multiset ↥W) (M : Polynomial ↥W), IsUnit c ∧
        (∀ j, M.coeff j ∈ IsLocalRing.maximalIdeal ↥W) ∧
        R = Polynomial.C c * (s.map (fun a => Polynomial.X - Polynomial.C a)).prod + M := by
    rintro R ⟨i, hi⟩
    have hRb0 : R.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h0
      have h1 := congrArg (fun P => P.coeff i) h0
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h1
    have hsplit := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := R.map (IsLocalRing.residue ↥W)))
    let σ := Function.surjInv (IsLocalRing.residue_surjective (R := ↥W))
    have hσ : ∀ z, IsLocalRing.residue ↥W (σ z) = z := Function.surjInv_eq _
    refine ⟨σ (R.map (IsLocalRing.residue ↥W)).leadingCoeff,
      (R.map (IsLocalRing.residue ↥W)).roots.map σ,
      R - Polynomial.C (σ (R.map (IsLocalRing.residue ↥W)).leadingCoeff) *
        (((R.map (IsLocalRing.residue ↥W)).roots.map σ).map
          (fun a => Polynomial.X - Polynomial.C a)).prod, ?_, ?_, (add_sub_cancel _ _).symm⟩
    · apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [hσ]
      exact Polynomial.leadingCoeff_ne_zero.mpr hRb0
    · intro j
      have hms : Multiset.map (Polynomial.map (IsLocalRing.residue ↥W))
          (Multiset.map (fun a => Polynomial.X - Polynomial.C a)
            (Multiset.map σ (R.map (IsLocalRing.residue ↥W)).roots)) =
          Multiset.map (fun a => Polynomial.X - Polynomial.C a)
            (R.map (IsLocalRing.residue ↥W)).roots := by
        rw [Multiset.map_map, Multiset.map_map]
        congr 1
        funext z
        simp [hσ]
      have hmap : Polynomial.map (IsLocalRing.residue ↥W)
          (R - Polynomial.C (σ (R.map (IsLocalRing.residue ↥W)).leadingCoeff) *
            (((R.map (IsLocalRing.residue ↥W)).roots.map σ).map
              (fun a => Polynomial.X - Polynomial.C a)).prod) = 0 := by
        rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C, hσ,
          Polynomial.map_multiset_prod, hms, hsplit, sub_self]
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.coeff_map, hmap, Polynomial.coeff_zero]

  have hP : ∀ R : Polynomial ↥W, (∃ i, IsUnit (R.coeff i)) →
      V₁.valuation (Polynomial.eval₂ (ι.comp W.subtype) η R) = 1 := by
    intro R hR
    obtain ⟨c, s, M, hc, hM, hRe⟩ := hfac R hR
    rw [hRe, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C]
    have hcv : V₁.valuation ((ι.comp W.subtype) c) = 1 := by
      obtain ⟨d, hd⟩ := isUnit_iff_exists_inv.mp hc
      have hcV : (ι.comp W.subtype) c ∈ V₁ := (hι (c : Ω)).mpr c.2
      have hdV : (ι.comp W.subtype) d ∈ V₁ := (hι (d : Ω)).mpr d.2
      have hcd : (ι.comp W.subtype) c * (ι.comp W.subtype) d = 1 := by
        rw [← map_mul, hd, map_one]
      have h1 := (V₁.valuation_le_one_iff _).mpr hcV
      have h2 := (V₁.valuation_le_one_iff _).mpr hdV
      apply le_antisymm h1
      by_contra hlt
      push_neg at hlt
      have h3 : V₁.valuation ((ι.comp W.subtype) c * (ι.comp W.subtype) d) < 1 := by
        rw [map_mul]; exact mul_lt_one_of_lt_of_le hlt h2
      rw [hcd, map_one] at h3
      exact lt_irrefl _ h3
    have hprodv : V₁.valuation (Polynomial.eval₂ (ι.comp W.subtype) η
        (s.map (fun a => Polynomial.X - Polynomial.C a)).prod) = 1 := by
      rw [Polynomial.eval₂_multiset_prod, map_multiset_prod, Multiset.map_map, Multiset.map_map]
      apply Multiset.prod_eq_one
      intro x hx
      obtain ⟨a, -, rfl⟩ := Multiset.mem_map.mp hx
      simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C]
      exact hlin a
    have hMv : V₁.valuation (Polynomial.eval₂ (ι.comp W.subtype) η M) < 1 := by
      rw [Polynomial.eval₂_eq_sum_range]
      apply Valuation.map_sum_lt _ one_ne_zero
      intro i _
      rw [map_mul, map_pow]
      exact mul_lt_one_of_lt_of_le (hF1 _ (hM i)) (pow_le_one₀ zero_le' hV₁η.le)
    rw [Valuation.map_add_eq_of_lt_left]
    · rw [map_mul, hcv, hprodv, mul_one]
    · rw [map_mul, hcv, hprodv, mul_one]; exact hMv

  have hψpoly : ∀ p : Polynomial Ω,
      ψ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = Polynomial.eval₂ ι η p := by
    intro p
    have hext : ψ.comp (algebraMap (Polynomial Ω) (RatFunc Ω)) = Polynomial.eval₂RingHom ι η := by
      apply Polynomial.ringHom_ext
      · intro a
        have e1 : algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C a) =
            algebraMap Ω (RatFunc Ω) a := by
          rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
        show ψ (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C a)) =
          Polynomial.eval₂ ι η (Polynomial.C a)
        rw [e1, hψw, Polynomial.eval₂_C]
        rfl
      · show ψ (algebraMap (Polynomial Ω) (RatFunc Ω) Polynomial.X) =
          Polynomial.eval₂ ι η Polynomial.X
        rw [RatFunc.algebraMap_X, hψX, Polynomial.eval₂_X]
    exact RingHom.congr_fun hext p
  have hle : wcEbGauss W ≤ V₁.toSubring.comap ψ := by
    unfold wcEbGauss
    rw [Subring.closure_le]
    rintro f ⟨p, q, hq, -, hf⟩
    show ψ f ∈ V₁
    have h1 := congrArg ψ hf
    rw [map_mul, hψpoly, hψpoly, Polynomial.eval₂_map, Polynomial.eval₂_map] at h1
    have hqv := hP q hq
    have hpV : Polynomial.eval₂ (ι.comp W.subtype) η p ∈ V₁ := by
      rw [Polynomial.eval₂_eq_sum_range]
      exact sum_mem (fun i _ => mul_mem ((hι ((p.coeff i : ↥W) : Ω)).mpr (p.coeff i).2)
        (pow_mem hηV _))
    rw [← V₁.valuation_le_one_iff]
    have h2 := congrArg V₁.valuation h1
    rw [map_mul, hqv, mul_one] at h2
    rw [h2]
    exact (V₁.valuation_le_one_iff _).mpr hpV
  intro x
  constructor
  · intro hx
    exact hle hx
  · intro hx
    by_cases hx0 : x = 0
    · rw [hx0]; exact (wcEbGauss W).zero_mem
    obtain ⟨a, _ha0, u₀, hxu⟩ := hVG4 x hx0
    have hy' : (((u₀⁻¹ : VGˣ) : VG) : RatFunc Ω) ∈ wcEbGauss W :=
      (hGmem _).mpr ((u₀⁻¹ : VGˣ) : VG).2
    have hyy : ((u₀ : VG) : RatFunc Ω) * (((u₀⁻¹ : VGˣ) : VG) : RatFunc Ω) = 1 :=
      congrArg Subtype.val (Units.mul_inv u₀)
    have hψy' : ψ (((u₀⁻¹ : VGˣ) : VG) : RatFunc Ω) ∈ V₁ := hle hy'
    have hxa : x * (((u₀⁻¹ : VGˣ) : VG) : RatFunc Ω) = algebraMap Ω (RatFunc Ω) a := by
      rw [hxu, mul_assoc, hyy, mul_one]
    have hιa : ι a ∈ V₁ := by
      have h1 := congrArg ψ hxa
      rw [map_mul, hψw] at h1
      show algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) a) ∈ V₁
      rw [← h1]
      exact mul_mem hx hψy'
    have haW : a ∈ W := (hι a).mp hιa
    rw [hGmem, hxu]
    exact mul_mem ((hVG2 a).mpr haW) ((u₀ : VG).2)

theorem wcpa_dj_lr1k_eb_eg_sep_bcf_dvr_finite : ∀ (k : Type u) [Field k] [IsAlgClosed k]
    (k₀ : Type u) [Field k₀] (θ : RatFunc k ≃+* k₀) (Q₀ : ValuationSubring k₀),
    (∀ c : k, θ (algebraMap k (RatFunc k) c) ∈ Q₀) → Q₀.valuation (θ RatFunc.X) < 1 →
    ∀ (F : Type u) [Field F] [Algebra k₀ F] [FiniteDimensional k₀ F],
      letI : Algebra ↥Q₀ F := ((algebraMap k₀ F).comp Q₀.subtype).toAlgebra
      Module.Finite ↥Q₀ ↥(integralClosure ↥Q₀ F) :=
by
  classical

  have s5 : ∀ (A : Type u) [CommRing A]
      (R : Type u) [CommRing R] (F : Type u) [CommRing F] [Algebra A F] [Algebra R F]
      (φ : A →+* R), (∀ a : A, algebraMap A F a = algebraMap R F (φ a)) →
      Module.Finite A ↥(integralClosure A F) →
      (∀ (n : ℕ) (a : Fin n → R), ∃ σ : A, IsUnit (φ σ) ∧ ∀ i, ∃ p : A, φ p = φ σ * a i) →
      Module.Finite R ↥(integralClosure R F) := by
    intro A _ R _ F _ _ _ φ hφ hfin hden
    obtain ⟨r, γ, hγ⟩ := Module.Finite.exists_fin (R := A) (M := integralClosure A F)
    have hcomp : (algebraMap R F).comp φ = (RingHom.id F).comp (algebraMap A F) :=
      RingHom.ext fun a => (hφ a).symm
    have key : ∀ y : F, IsIntegral R y →
        ∃ c : Fin r → R, y = ∑ j, algebraMap R F (c j) * (γ j : F) := by
      intro y hy
      obtain ⟨P, hPm, hPy⟩ := hy
      obtain ⟨σ, hu, hp⟩ := hden P.natDegree (fun i => P.coeff i)
      choose p hp using hp
      have hlift : Polynomial.scaleRoots P (φ σ) ∈ Polynomial.lifts φ := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        rw [Polynomial.coeff_scaleRoots]
        rcases lt_trichotomy i P.natDegree with h | h | h
        · refine ⟨p ⟨i, h⟩ * σ ^ (P.natDegree - 1 - i), ?_⟩
          rw [map_mul, map_pow, hp ⟨i, h⟩]
          have he : P.natDegree - i = (P.natDegree - 1 - i) + 1 := by omega
          rw [he, pow_succ]
          ring
        · subst h
          rw [hPm.coeff_natDegree, Nat.sub_self, pow_zero, one_mul]
          exact ⟨1, map_one φ⟩
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
          exact ⟨0, map_zero φ⟩
      obtain ⟨M, hMmap, -, hMm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
        ((Polynomial.monic_scaleRoots_iff _).mpr hPm)
      have hz : IsIntegral A (algebraMap R F (φ σ) * y) := by
        refine ⟨M, hMm, ?_⟩
        have h1 : Polynomial.eval₂ (algebraMap A F) (algebraMap R F (φ σ) * y) M =
            Polynomial.eval₂ (algebraMap R F) (algebraMap R F (φ σ) * y) (M.map φ) := by
          rw [Polynomial.eval₂_map, hcomp]
          rfl
        rw [h1, hMmap, Polynomial.scaleRoots_eval₂_mul, hPy, mul_zero]
      have hmem : (⟨_, hz⟩ : integralClosure A F) ∈ Submodule.span A (Set.range γ) := by
        rw [hγ]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hmem
      have hc' : algebraMap R F (φ σ) * y = ∑ j, algebraMap R F (φ (c j)) * (γ j : F) := by
        have h2 : ((∑ i, c i • γ i : integralClosure A F) : F) = algebraMap R F (φ σ) * y :=
          congrArg Subtype.val hc
        rw [← h2, AddSubmonoidClass.coe_finsetSum]
        refine Finset.sum_congr rfl fun j _ => ?_
        show c j • (γ j : F) = _
        rw [Algebra.smul_def, hφ]
      obtain ⟨w, hw⟩ := hu.exists_left_inv
      refine ⟨fun j => w * φ (c j), ?_⟩
      calc y = algebraMap R F w * (algebraMap R F (φ σ) * y) := by
            rw [← mul_assoc, ← map_mul, hw, map_one, one_mul]
        _ = ∑ j, algebraMap R F (w * φ (c j)) * (γ j : F) := by
            rw [hc', Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, mul_assoc]
    have hγR : ∀ j, IsIntegral R (γ j : F) := fun j =>
      IsIntegral.map_of_comp_eq φ (RingHom.id F) hcomp (γ j).2
    let t : Fin r → integralClosure R F := fun j => ⟨γ j, hγR j⟩
    have htop : Submodule.span R (Set.range t) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨c, hc⟩ := key x x.2
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨c, Subtype.ext ?_⟩
      rw [hc, AddSubmonoidClass.coe_finsetSum]
      refine Finset.sum_congr rfl fun j _ => ?_
      show c j • (γ j : F) = _
      rw [Algebra.smul_def]
    exact ⟨⟨Finset.univ.image t, by rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]; exact htop⟩⟩
  intro k _ _ k₀ _ θ Q₀ hc hX F _ _ _

  have hXm : θ RatFunc.X ∈ Q₀ := (Q₀.valuation_le_one_iff _).mp hX.le
  have hmem : ∀ p : Polynomial k, θ (algebraMap (Polynomial k) (RatFunc k) p) ∈ Q₀ := by
    intro p
    induction p using Polynomial.induction_on with
    | C a => rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C]; exact hc a
    | add p q hp hq => rw [map_add, map_add]; exact add_mem hp hq
    | monomial n a ih =>
      rw [pow_succ, ← mul_assoc, map_mul, map_mul, RatFunc.algebraMap_X]
      exact mul_mem ih hXm
  have hunit : ∀ p : Polynomial k, p.coeff 0 ≠ 0 →
      Q₀.valuation (θ (algebraMap (Polynomial k) (RatFunc k) p)) = 1 := by
    intro p h0
    have hdec : p = Polynomial.X * p.divX + Polynomial.C (p.coeff 0) :=
      (Polynomial.X_mul_divX_add p).symm
    set e := θ (algebraMap k (RatFunc k) (p.coeff 0)) with he
    have hCe : θ (algebraMap (Polynomial k) (RatFunc k) (Polynomial.C (p.coeff 0))) = e := by
      rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C]
    have he0 : e ≠ 0 := by
      rw [he]
      exact (map_ne_zero θ).mpr ((map_ne_zero _).mpr h0)
    have heinv : e⁻¹ = θ (algebraMap k (RatFunc k) (p.coeff 0)⁻¹) := by
      rw [he, map_inv₀, map_inv₀]
    have hve : Q₀.valuation e = 1 := by
      refine le_antisymm ((Q₀.valuation_le_one_iff _).mpr (hc _)) ?_
      by_contra hlt
      rw [not_le] at hlt
      have h2 : Q₀.valuation e⁻¹ ≤ 1 := by
        rw [heinv]; exact (Q₀.valuation_le_one_iff _).mpr (hc _)
      have h3 : Q₀.valuation e * Q₀.valuation e⁻¹ < 1 := mul_lt_one_of_lt_of_le hlt h2
      rw [← map_mul, mul_inv_cancel₀ he0, map_one] at h3
      exact lt_irrefl _ h3
    have hlt : Q₀.valuation (θ RatFunc.X * θ (algebraMap (Polynomial k) (RatFunc k) p.divX)) <
        Q₀.valuation e := by
      rw [hve, map_mul]
      exact mul_lt_one_of_lt_of_le hX ((Q₀.valuation_le_one_iff _).mpr (hmem _))
    rw [hdec, map_add, map_add, map_mul, map_mul, RatFunc.algebraMap_X, hCe, add_comm,
      Valuation.map_add_eq_of_lt_left _ hlt, hve]

  have hfrac : ∀ a : k₀, a ∈ Q₀ → ∃ p q : Polynomial k, q.coeff 0 ≠ 0 ∧
      θ (algebraMap (Polynomial k) (RatFunc k) p) =
        a * θ (algebraMap (Polynomial k) (RatFunc k) q) := by
    intro a ha
    have hden0 : algebraMap (Polynomial k) (RatFunc k) (θ.symm a).denom ≠ 0 :=
      RatFunc.algebraMap_ne_zero (RatFunc.denom_ne_zero _)
    have hι : algebraMap (Polynomial k) (RatFunc k) (θ.symm a).num =
        θ.symm a * algebraMap (Polynomial k) (RatFunc k) (θ.symm a).denom := by
      rw [← div_eq_iff hden0]; exact RatFunc.num_div_denom _
    have heq : θ (algebraMap (Polynomial k) (RatFunc k) (θ.symm a).num) =
        a * θ (algebraMap (Polynomial k) (RatFunc k) (θ.symm a).denom) := by
      rw [hι, map_mul, RingEquiv.apply_symm_apply]
    refine ⟨(θ.symm a).num, (θ.symm a).denom, ?_, heq⟩
    intro h0
    have hXd : Polynomial.X ∣ (θ.symm a).denom := Polynomial.X_dvd_iff.mpr h0
    have hnum0 : (θ.symm a).num.coeff 0 ≠ 0 := by
      intro hn
      have hXn : Polynomial.X ∣ (θ.symm a).num := Polynomial.X_dvd_iff.mpr hn
      exact Polynomial.not_isUnit_X ((RatFunc.isCoprime_num_denom _).isUnit_of_dvd' hXn hXd)
    obtain ⟨d, hd⟩ := hXd
    have h1 := hunit _ hnum0
    rw [heq, map_mul, hd, map_mul, map_mul, RatFunc.algebraMap_X, map_mul] at h1
    have h2 : Q₀.valuation a * (Q₀.valuation (θ RatFunc.X) *
        Q₀.valuation (θ (algebraMap (Polynomial k) (RatFunc k) d))) < 1 := by
      calc _ ≤ 1 * (Q₀.valuation (θ RatFunc.X) *
            Q₀.valuation (θ (algebraMap (Polynomial k) (RatFunc k) d))) := by
            gcongr
            exact (Q₀.valuation_le_one_iff _).mpr ha
        _ < 1 := by
            rw [one_mul]
            exact mul_lt_one_of_lt_of_le hX ((Q₀.valuation_le_one_iff _).mpr (hmem _))
    rw [h1] at h2
    exact lt_irrefl _ h2

  have hcd : ∀ (n : ℕ) (a : Fin n → k₀), (∀ i, a i ∈ Q₀) →
      ∃ σ : Polynomial k, σ.coeff 0 ≠ 0 ∧ ∀ i, ∃ p : Polynomial k,
        θ (algebraMap (Polynomial k) (RatFunc k) p) =
          θ (algebraMap (Polynomial k) (RatFunc k) σ) * a i := by
    intro n a ha
    choose p q hq hpq using fun i => hfrac (a i) (ha i)
    refine ⟨∏ i, q i, ?_, fun i => ⟨p i * ∏ j ∈ Finset.univ.erase i, q j, ?_⟩⟩
    · rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_prod]
      exact Finset.prod_ne_zero_iff.mpr fun i _ => by
        rw [← Polynomial.coeff_zero_eq_eval_zero]; exact hq i
    · rw [← Finset.mul_prod_erase Finset.univ q (Finset.mem_univ i)]
      simp only [map_mul]
      rw [hpq i]
      ring

  letI instA : Algebra (Polynomial k) F :=
    (((algebraMap k₀ F).comp θ.toRingHom).comp (algebraMap (Polynomial k) (RatFunc k))).toAlgebra
  have hfinA : Module.Finite (Polynomial k) ↥(integralClosure (Polynomial k) F) := by
    letI instR : Algebra (RatFunc k) F := ((algebraMap k₀ F).comp θ.toRingHom).toAlgebra
    haveI : IsScalarTower (Polynomial k) (RatFunc k) F :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : FiniteDimensional (RatFunc k) F :=
      Module.Finite.of_equiv_equiv (A₁ := k₀) (B₁ := F) θ.symm (RingEquiv.refl F)
        (RingHom.ext fun x => by simp [RingHom.algebraMap_toAlgebra])
    obtain ⟨D, hD, hDf⟩ := wcpa_dj_lr1k_cp_integral_model k F
    haveI := IsAlgClosed.perfectField k
    exact wcpa_dj_lr1k_cp_noether_transfer k F D hD hDf
      (fun D' _ _ _ _ => noether_integralClosure_finite k D')

  let φ : Polynomial k →+* ↥Q₀ :=
    (θ.toRingHom.comp (algebraMap (Polynomial k) (RatFunc k))).codRestrict Q₀ hmem
  letI instQ : Algebra ↥Q₀ F := ((algebraMap k₀ F).comp Q₀.subtype).toAlgebra
  refine s5 (Polynomial k) ↥Q₀ F φ (fun a => rfl) hfinA ?_
  intro n a
  obtain ⟨σ, hσ, hp⟩ := hcd n (fun i => (a i : k₀)) (fun i => (a i).2)
  refine ⟨σ, (Q₀.valuation_eq_one_iff (φ σ)).mpr (hunit σ hσ), fun i => ?_⟩
  obtain ⟨p, hp'⟩ := hp i
  exact ⟨p, Subtype.ext hp'⟩

theorem wcpa_dj_lr1k_eb_eg_sep_bcf_composite_finite : ∀ (K L : Type u) [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] (ζ : ValuationSubring K),
    letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
    Module.Free ↥ζ ↥(integralClosure ↥ζ L) →
    Module.finrank ↥ζ ↥(integralClosure ↥ζ L) = Module.finrank K L →
    (∀ z : ↥(integralClosure ↥ζ L),
      (∀ M : Ideal ↥(integralClosure ↥ζ L), M.IsMaximal → z ∈ M) →
      ∃ c : K, c ≠ 0 ∧ ζ.valuation c < 1 ∧
        (z : L) / algebraMap K L c ∈ integralClosure ↥ζ L) →
    ∀ Q₀ : ValuationSubring (IsLocalRing.ResidueField ↥ζ),
    (∀ (F : Type u) [Field F] [Algebra (IsLocalRing.ResidueField ↥ζ) F]
        [FiniteDimensional (IsLocalRing.ResidueField ↥ζ) F],
      letI : Algebra ↥Q₀ F :=
        ((algebraMap (IsLocalRing.ResidueField ↥ζ) F).comp Q₀.subtype).toAlgebra
      Module.Finite ↥Q₀ ↥(integralClosure ↥Q₀ F)) →
    ∀ 𝒰 : ValuationSubring K,
    (∀ x : K, x ∈ 𝒰 ↔ ∃ h : x ∈ ζ, IsLocalRing.residue ↥ζ ⟨x, h⟩ ∈ Q₀) →
    letI : Algebra ↥𝒰 L := ((algebraMap K L).comp 𝒰.subtype).toAlgebra
    Module.Finite ↥𝒰 ↥(integralClosure ↥𝒰 L) :=
by

  have T_s1 : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (ζ : ValuationSubring K),
      letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
      (∀ z : ↥(integralClosure ↥ζ L),
        (∀ M : Ideal ↥(integralClosure ↥ζ L), M.IsMaximal → z ∈ M) →
        ∃ c : K, c ≠ 0 ∧ ζ.valuation c < 1 ∧
          (z : L) / algebraMap K L c ∈ integralClosure ↥ζ L) →
      IsReduced (↥(integralClosure ↥ζ L) ⧸
        Ideal.map (algebraMap ↥ζ ↥(integralClosure ↥ζ L)) (IsLocalRing.maximalIdeal ↥ζ)) := by
    intro K L _ _ _ ζ
    letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
    intro hJ
    rw [isReduced_iff]
    rintro x ⟨n, hn⟩
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hzn : z ^ n ∈ Ideal.map (algebraMap ↥ζ ↥(integralClosure ↥ζ L))
        (IsLocalRing.maximalIdeal ↥ζ) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_pow]; exact hn
    have hint : (algebraMap ↥ζ ↥(integralClosure ↥ζ L)).IsIntegral :=
      fun x => Algebra.IsIntegral.isIntegral x
    have hM : ∀ M : Ideal ↥(integralClosure ↥ζ L), M.IsMaximal → z ∈ M := by
      intro M hM
      have h1 : (M.comap (algebraMap ↥ζ ↥(integralClosure ↥ζ L))).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint M
      have h2 : M.comap (algebraMap ↥ζ ↥(integralClosure ↥ζ L)) = IsLocalRing.maximalIdeal ↥ζ :=
        IsLocalRing.eq_maximalIdeal h1
      have h3 : Ideal.map (algebraMap ↥ζ ↥(integralClosure ↥ζ L))
          (IsLocalRing.maximalIdeal ↥ζ) ≤ M :=
        Ideal.map_le_iff_le_comap.mpr h2.ge
      exact hM.isPrime.mem_of_pow_mem n (h3 hzn)
    obtain ⟨c, hc0, hcv, hcz⟩ := hJ z hM
    have hcζ : c ∈ ζ := (ζ.valuation_le_one_iff c).mp hcv.le
    have hcm : (⟨c, hcζ⟩ : ↥ζ) ∈ IsLocalRing.maximalIdeal ↥ζ :=
      (ζ.valuation_lt_one_iff _).mpr hcv
    have hz : z = algebraMap ↥ζ ↥(integralClosure ↥ζ L) ⟨c, hcζ⟩ * ⟨_, hcz⟩ := by
      apply Subtype.ext
      show (z : L) = algebraMap K L c * ((z : L) / algebraMap K L c)
      rw [mul_div_cancel₀]
      exact (map_ne_zero _).mpr hc0
    rw [Ideal.Quotient.eq_zero_iff_mem, hz]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hcm)

  have T_s2 : ∀ (k : Type u) [Field k] (Q₀ : ValuationSubring k) (F : Type u) [Field F]
      [Algebra k F] [FiniteDimensional k F],
      letI : Algebra ↥Q₀ F := ((algebraMap k F).comp Q₀.subtype).toAlgebra
      Module.Finite ↥Q₀ ↥(integralClosure ↥Q₀ F) →
      ∃ β : Fin (Module.finrank k F) → F, (∀ l, IsIntegral ↥Q₀ (β l)) ∧
        (∀ s : F, IsIntegral ↥Q₀ s →
          ∃ d : Fin (Module.finrank k F) → ↥Q₀, s = ∑ l, algebraMap ↥Q₀ F (d l) * β l) ∧
        (∀ c : Fin (Module.finrank k F) → ↥Q₀,
          ∑ l, algebraMap ↥Q₀ F (c l) * β l = 0 → ∀ l, c l = 0) := by
    intro K _ V L _ _ _
    letI : Algebra ↥V L := ((algebraMap K L).comp V.subtype).toAlgebra
    intro hfin
    haveI : IsScalarTower ↥V K L := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    have htors : Submodule.torsion ↥V ↥(integralClosure ↥V L) = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [Submodule.mem_torsion_iff] at hx
      obtain ⟨a, ha⟩ := hx
      rw [Submodule.mem_bot]
      have ha0 : ((a : ↥V) : K) ≠ 0 := by
        have := nonZeroDivisors.ne_zero a.2
        exact fun h => this (Subtype.ext h)
      have h1 : ((a • x : ↥(integralClosure ↥V L)) : L) = 0 := by rw [ha]; rfl
      have h2 : ((a • x : ↥(integralClosure ↥V L)) : L) =
          algebraMap K L ((a : ↥V) : K) * (x : L) := by
        show ((a : ↥V) • (x : L)) = _
        rw [Algebra.smul_def]
        rfl
      rw [h2] at h1
      rcases mul_eq_zero.mp h1 with h | h
      · exact absurd ((map_eq_zero _).mp h) ha0
      · exact Subtype.ext h
    haveI hflat : Module.Flat ↥V ↥(integralClosure ↥V L) :=
      Module.Flat.flat_iff_torsion_eq_bot_of_isBezout.mpr htors
    haveI hfree : Module.Free ↥V ↥(integralClosure ↥V L) :=
      Module.free_of_flat_of_isLocalRing
    haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
    have hloc := IsIntegralClosure.isLocalization (A := ↥V) (K := K) (L := L)
      (C := ↥(integralClosure ↥V L))
    have hlm : IsLocalizedModule (nonZeroDivisors ↥V)
        (IsScalarTower.toAlgHom ↥V ↥(integralClosure ↥V L) L).toLinearMap :=
      isLocalizedModule_iff_isLocalization.mpr hloc
    have hrank : Module.finrank ↥V ↥(integralClosure ↥V L) = Module.finrank K L :=
      (Module.finrank_of_isLocalizedModule_of_free K (nonZeroDivisors ↥V)
        (IsScalarTower.toAlgHom ↥V ↥(integralClosure ↥V L) L).toLinearMap).symm
    let bs := Module.finBasisOfFinrankEq ↥V ↥(integralClosure ↥V L) hrank
    refine ⟨fun l => (bs l : L), fun l => (bs l).2, ?_, ?_⟩
    · intro s hs
      refine ⟨bs.equivFun ⟨s, hs⟩, ?_⟩
      calc s = ((∑ l, bs.equivFun ⟨s, hs⟩ l • bs l : ↥(integralClosure ↥V L)) : L) := by
            rw [bs.sum_equivFun]
        _ = _ := by
            rw [AddSubmonoidClass.coe_finset_sum]
            refine Finset.sum_congr rfl (fun l _ => ?_)
            rw [Subalgebra.coe_smul, Algebra.smul_def]
    · intro c hc
      have h0 : ∑ l, c l • bs l = 0 := by
        apply Subtype.ext
        rw [AddSubmonoidClass.coe_finset_sum]
        simp only [Subalgebra.coe_smul, Algebra.smul_def]
        exact hc
      exact Fintype.linearIndependent_iff.mp bs.linearIndependent c h0

  have T_s3 : ∀ (k : Type u) [Field k]
      (Q₀ : ValuationSubring k) (A : Type u) [CommRing A] [Algebra k A] [FiniteDimensional k A]
      [IsReduced A],
      (∀ (F : Type u) [Field F] [Algebra k F] [FiniteDimensional k F],
        letI : Algebra ↥Q₀ F := ((algebraMap k F).comp Q₀.subtype).toAlgebra
        ∃ β : Fin (Module.finrank k F) → F, (∀ l, IsIntegral ↥Q₀ (β l)) ∧
          (∀ s : F, IsIntegral ↥Q₀ s →
            ∃ d : Fin (Module.finrank k F) → ↥Q₀, s = ∑ l, algebraMap ↥Q₀ F (d l) * β l) ∧
          (∀ c : Fin (Module.finrank k F) → ↥Q₀,
            ∑ l, algebraMap ↥Q₀ F (c l) * β l = 0 → ∀ l, c l = 0)) →
      letI : Algebra ↥Q₀ A := ((algebraMap k A).comp Q₀.subtype).toAlgebra
      ∀ n : ℕ, Module.finrank k A = n →
      ∃ a : Fin n → A, (∀ i, IsIntegral ↥Q₀ (a i)) ∧
        ∀ c : Fin n → ↥Q₀,
          (∑ i, algebraMap ↥Q₀ A (c i) * a i) ∈ Submodule.span ↥(integralClosure ↥Q₀ A)
            {x : A | ∃ μ ∈ IsLocalRing.maximalIdeal ↥Q₀, x = algebraMap ↥Q₀ A μ} →
          ∀ i, c i ∈ IsLocalRing.maximalIdeal ↥Q₀ := by
    intro k _ Q₀ A _ _ _ _ HB
    letI : Algebra ↥Q₀ A := ((algebraMap k A).comp Q₀.subtype).toAlgebra
    intro n hn
    classical
    haveI : IsArtinianRing A := IsArtinianRing.of_finite k A
    letI : Fintype (MaximalSpectrum A) := Fintype.ofFinite _
    letI hFld : ∀ I : MaximalSpectrum A, Field (A ⧸ I.asIdeal) := fun I =>
      @Ideal.Quotient.field _ _ _ I.isMaximal
    haveI hFD : ∀ I : MaximalSpectrum A, FiniteDimensional k (A ⧸ I.asIdeal) := fun I =>
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ k I.asIdeal).toLinearMap
        (Ideal.Quotient.mkₐ_surjective k _)
    have hβ := fun I : MaximalSpectrum A => HB (A ⧸ I.asIdeal)
    choose β hβint hβspan hβuniq using hβ
    let κA : ↥Q₀ →+* A := (algebraMap k A).comp Q₀.subtype
    let κ : ∀ I : MaximalSpectrum A, ↥Q₀ →+* A ⧸ I.asIdeal := fun I =>
      (algebraMap k (A ⧸ I.asIdeal)).comp Q₀.subtype
    have hcomp : ∀ I : MaximalSpectrum A, (Ideal.Quotient.mk I.asIdeal).comp κA = κ I :=
      fun I => RingHom.ext fun q => Ideal.Quotient.mk_algebraMap k I.asIdeal (q : k)
    let e := IsArtinianRing.equivPi A
    let eL : A ≃ₗ[k] ((I : MaximalSpectrum A) → A ⧸ I.asIdeal) :=
      { toFun := e
        invFun := e.symm
        map_add' := map_add e
        map_smul' := fun c x => by
          funext I
          simp only [RingHom.id_apply, Pi.smul_apply]
          rw [IsArtinianRing.equivPi_apply, IsArtinianRing.equivPi_apply, Algebra.smul_def,
            map_mul, Ideal.Quotient.mk_algebraMap, ← Algebra.smul_def]
        left_inv := e.symm_apply_apply
        right_inv := e.apply_symm_apply }
    have hsum : Module.finrank k A =
        ∑ I : MaximalSpectrum A, Module.finrank k (A ⧸ I.asIdeal) := by
      rw [LinearEquiv.finrank_eq eL, Module.finrank_pi_fintype]
    let T := Σ I : MaximalSpectrum A, Fin (Module.finrank k (A ⧸ I.asIdeal))
    have hT : Fintype.card T = n := by
      rw [Fintype.card_sigma]
      simp only [Fintype.card_fin]
      rw [← hsum, hn]
    let eT : T ≃ Fin n := Fintype.equivFinOfCardEq hT
    let a' : T → A := fun t => e.symm (Pi.single t.1 (β t.1 t.2))
    have ha' : ∀ (t : T) (J : MaximalSpectrum A),
        Ideal.Quotient.mk J.asIdeal (a' t) = (Pi.single t.1 (β t.1 t.2) :
          (I : MaximalSpectrum A) → A ⧸ I.asIdeal) J := by
      intro t J
      rw [← IsArtinianRing.equivPi_apply, AlgEquiv.apply_symm_apply]
    have hmkint : ∀ (I : MaximalSpectrum A) (s : A), IsIntegral ↥Q₀ s →
        ∃ P : Polynomial ↥Q₀, P.Monic ∧
          Polynomial.eval₂ (κ I) (Ideal.Quotient.mk I.asIdeal s) P = 0 := by
      intro I s hs
      obtain ⟨P, hPm, hP⟩ := hs
      refine ⟨P, hPm, ?_⟩
      rw [← hcomp I, ← Polynomial.hom_eval₂]
      change Ideal.Quotient.mk I.asIdeal (Polynomial.eval₂ κA s P) = 0
      rw [show Polynomial.eval₂ κA s P = 0 from hP, map_zero]
    refine ⟨fun i => a' (eT.symm i), ?_, ?_⟩
    · intro i
      set t := eT.symm i
      obtain ⟨P₀, hP₀m, hP₀⟩ := hβint t.1 t.2
      refine ⟨Polynomial.X * P₀, Polynomial.monic_X.mul hP₀m, ?_⟩
      change Polynomial.eval₂ κA (a' t) (Polynomial.X * P₀) = 0
      apply e.injective
      funext J
      rw [map_zero, IsArtinianRing.equivPi_apply, Polynomial.hom_eval₂, hcomp J, ha' t J,
        Polynomial.eval₂_mul, Polynomial.eval₂_X]
      by_cases hJ : J = t.1
      · subst hJ
        rw [Pi.single_eq_same]
        rw [show Polynomial.eval₂ (κ t.1) (β t.1 t.2) P₀ = 0 from hP₀, mul_zero]
        rfl
      · rw [Pi.single_eq_of_ne hJ, zero_mul]
        rfl
    · have himg : ∀ (I : MaximalSpectrum A), ∀ x ∈ Submodule.span ↥(integralClosure ↥Q₀ A)
          {x : A | ∃ μ ∈ IsLocalRing.maximalIdeal ↥Q₀, x = algebraMap ↥Q₀ A μ},
          ∃ d : Fin (Module.finrank k (A ⧸ I.asIdeal)) → ↥Q₀,
            (∀ l, d l ∈ IsLocalRing.maximalIdeal ↥Q₀) ∧
            Ideal.Quotient.mk I.asIdeal x = ∑ l, κ I (d l) * β I l := by
        intro I x hx
        induction hx using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨μ, hμ, rfl⟩ := hx
          obtain ⟨e1, he1⟩ := hβspan I 1 isIntegral_one
          refine ⟨fun l => μ * e1 l, fun l => Ideal.mul_mem_right _ _ hμ, ?_⟩
          have h1 : Ideal.Quotient.mk I.asIdeal (algebraMap ↥Q₀ A μ) = κ I μ := by
            rw [← hcomp I]; rfl
          rw [h1]
          calc κ I μ = κ I μ * 1 := (mul_one _).symm
            _ = κ I μ * ∑ l, κ I (e1 l) * β I l := congrArg (κ I μ * ·) he1
            _ = _ := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun l _ => ?_)
              rw [map_mul, mul_assoc]
        | zero =>
          refine ⟨0, fun l => zero_mem _, ?_⟩
          simp
        | add x y _ _ hx hy =>
          obtain ⟨d1, hd1, h1⟩ := hx
          obtain ⟨d2, hd2, h2⟩ := hy
          refine ⟨d1 + d2, fun l => add_mem (hd1 l) (hd2 l), ?_⟩
          rw [map_add, h1, h2, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun l _ => ?_)
          simp only [Pi.add_apply, map_add, add_mul]
        | smul s x _ hx =>
          obtain ⟨d, hd, h⟩ := hx
          have hsI : IsIntegral ↥Q₀ (Ideal.Quotient.mk I.asIdeal (s : A)) := by
            obtain ⟨P, hPm, hP⟩ := hmkint I s s.2
            exact ⟨P, hPm, hP⟩
          have hE := fun l => hβspan I (Ideal.Quotient.mk I.asIdeal (s : A) * β I l)
            (hsI.mul (hβint I l))
          choose E hE using hE
          refine ⟨fun l' => ∑ l, d l * E l l', fun l' => Ideal.sum_mem _ (fun l _ =>
            Ideal.mul_mem_right _ _ (hd l)), ?_⟩
          rw [Subalgebra.smul_def, smul_eq_mul, map_mul, h]
          calc Ideal.Quotient.mk I.asIdeal (s : A) * ∑ l, κ I (d l) * β I l
              = ∑ l, κ I (d l) * (Ideal.Quotient.mk I.asIdeal (s : A) * β I l) := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun l _ => ?_)
                ring
            _ = ∑ l, κ I (d l) * ∑ l', κ I (E l l') * β I l' := by
                refine Finset.sum_congr rfl (fun l _ => ?_)
                exact congrArg (κ I (d l) * ·) (hE l)
            _ = _ := by
                simp only [Finset.mul_sum, map_sum, map_mul, Finset.sum_mul]
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl (fun l' _ => Finset.sum_congr rfl (fun l _ => ?_))
                ring
      intro c hc i
      set t := eT.symm i with ht
      obtain ⟨d, hd, hdeq⟩ := himg t.1 _ hc
      have hcomp1 : Ideal.Quotient.mk t.1.asIdeal
          (∑ j, algebraMap ↥Q₀ A (c j) * a' (eT.symm j)) =
          ∑ l, κ t.1 (c (eT ⟨t.1, l⟩)) * β t.1 l := by
        rw [map_sum]
        rw [Fintype.sum_equiv eT.symm (fun j => Ideal.Quotient.mk t.1.asIdeal
            (algebraMap ↥Q₀ A (c j) * a' (eT.symm j)))
          (fun s : T => Ideal.Quotient.mk t.1.asIdeal (algebraMap ↥Q₀ A (c (eT s)) * a' s))
          (fun j => by simp)]
        rw [Fintype.sum_sigma]
        rw [Finset.sum_eq_single t.1]
        · refine Finset.sum_congr rfl (fun l _ => ?_)
          rw [map_mul, ha' ⟨t.1, l⟩ t.1]
          simp only [Pi.single_eq_same]
          rw [← hcomp t.1]
          rfl
        · intro J _ hJ
          refine Finset.sum_eq_zero (fun l _ => ?_)
          rw [map_mul, ha' ⟨J, l⟩ t.1]
          simp only
          rw [Pi.single_eq_of_ne (Ne.symm hJ), mul_zero]
        · intro h
          exact absurd (Finset.mem_univ _) h
      rw [hcomp1] at hdeq
      have hzero : ∑ l, κ t.1 (c (eT ⟨t.1, l⟩) - d l) * β t.1 l = 0 := by
        simp only [map_sub, sub_mul, Finset.sum_sub_distrib]
        rw [hdeq, sub_self]
      have h1 := hβuniq t.1 (fun l => c (eT ⟨t.1, l⟩) - d l) hzero t.2
      have h2 : c (eT ⟨t.1, t.2⟩) = d t.2 := sub_eq_zero.mp h1
      have h3 : eT ⟨t.1, t.2⟩ = i := by
        rw [show (⟨t.1, t.2⟩ : T) = t from rfl, ht, Equiv.apply_symm_apply]
      rw [← h3, h2]
      exact hd t.2

  have T_s4 : ∀ (K L : Type u) [Field K] [Field L]
      [Algebra K L] (ζ : ValuationSubring K) (Q₀ : ValuationSubring (IsLocalRing.ResidueField ↥ζ))
      (𝒰 : ValuationSubring K),
      (∀ x : K, x ∈ 𝒰 ↔ ∃ h : x ∈ ζ, IsLocalRing.residue ↥ζ ⟨x, h⟩ ∈ Q₀) →
      letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
      letI : Algebra ↥𝒰 L := ((algebraMap K L).comp 𝒰.subtype).toAlgebra
      ∀ (A : Type u) [CommRing A] [Algebra (IsLocalRing.ResidueField ↥ζ) A],
      letI : Algebra ↥Q₀ A :=
        ((algebraMap (IsLocalRing.ResidueField ↥ζ) A).comp Q₀.subtype).toAlgebra
      ∀ π : ↥(integralClosure ↥ζ L) →+* A,
      (∀ x : ↥ζ, π (algebraMap ↥ζ ↥(integralClosure ↥ζ L) x) =
        algebraMap (IsLocalRing.ResidueField ↥ζ) A (IsLocalRing.residue ↥ζ x)) →
      (∀ z : ↥(integralClosure ↥ζ L), π z = 0 →
        z ∈ Ideal.map (algebraMap ↥ζ ↥(integralClosure ↥ζ L)) (IsLocalRing.maximalIdeal ↥ζ)) →
      ∀ b : ↥(integralClosure ↥ζ L), IsIntegral ↥Q₀ (π b) → IsIntegral ↥𝒰 (b : L) := by
    intro K L _ _ _ ζ Q₀ 𝒰 hmem
    letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
    letI : Algebra ↥𝒰 L := ((algebraMap K L).comp 𝒰.subtype).toAlgebra
    intro A _ _
    letI : Algebra ↥Q₀ A :=
      ((algebraMap (IsLocalRing.ResidueField ↥ζ) A).comp Q₀.subtype).toAlgebra
    intro π hπ hker b hb
    have hle : 𝒰 ≤ ζ := fun x hx => ((hmem x).mp hx).1
    let ι : ↥𝒰 →+* ↥ζ := ValuationSubring.inclusion 𝒰 ζ hle
    let ρ : ↥𝒰 →+* ↥Q₀ :=
      { toFun := fun x => ⟨IsLocalRing.residue ↥ζ (ι x), ((hmem x).mp x.2).2⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun x y => Subtype.ext (by simp)
        map_zero' := Subtype.ext (by simp)
        map_add' := fun x y => Subtype.ext (by simp) }
    have hρ : ∀ x, ((ρ x : ↥Q₀) : IsLocalRing.ResidueField ↥ζ) = IsLocalRing.residue ↥ζ (ι x) :=
      fun x => rfl
    have hρsurj : Function.Surjective ρ := by
      intro q
      obtain ⟨y, hy⟩ := IsLocalRing.residue_surjective (q : IsLocalRing.ResidueField ↥ζ)
      have hyU : (y : K) ∈ 𝒰 := (hmem y).mpr ⟨y.2, by rw [hy]; exact q.2⟩
      exact ⟨⟨y, hyU⟩, Subtype.ext (by rw [hρ, ← hy]; rfl)⟩
    have hrange : ∀ z : ↥ζ, IsLocalRing.residue ↥ζ z ∈ Q₀ → z ∈ Set.range ι := by
      intro z hz
      exact ⟨⟨z, (hmem z).mpr ⟨z.2, hz⟩⟩, rfl⟩
    have hcompL : (algebraMap ↥ζ L).comp ι = algebraMap ↥𝒰 L := RingHom.ext fun _ => rfl
    have hcompA : π.comp ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι) =
        (algebraMap ↥Q₀ A).comp ρ := RingHom.ext fun x => hπ (ι x)
    have hcompV : ((integralClosure ↥ζ L).val : ↥(integralClosure ↥ζ L) →+* L).comp
        ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι) = algebraMap ↥𝒰 L :=
      RingHom.ext fun _ => rfl
    have hmy : ∀ (m : ↥ζ), m ∈ IsLocalRing.maximalIdeal ↥ζ → ∀ y : L, IsIntegral ↥ζ y →
        IsIntegral ↥𝒰 (algebraMap ↥ζ L m * y) := by
      intro m hm y hy
      obtain ⟨Q, hQm, hQ⟩ := hy
      have hQ'm : (Q.scaleRoots m).Monic := (Polynomial.monic_scaleRoots_iff m).mpr hQm
      have hlift : Q.scaleRoots m ∈ Polynomial.lifts ι := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        apply hrange
        rw [Polynomial.coeff_scaleRoots]
        rcases lt_trichotomy i Q.natDegree with hi | hi | hi
        · rw [(IsLocalRing.residue_eq_zero_iff _).mpr]
          · exact Q₀.zero_mem
          · exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hm _ (by omega))
        · rw [hi, Nat.sub_self, pow_zero, mul_one, hQm.coeff_natDegree, map_one]
          exact Q₀.one_mem
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, zero_mul, map_zero]
          exact Q₀.zero_mem
      obtain ⟨R, hRmap, -, hRm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hQ'm
      refine ⟨R, hRm, ?_⟩
      rw [← hcompL, ← Polynomial.eval₂_map, hRmap, Polynomial.scaleRoots_eval₂_mul, hQ, mul_zero]
    have hI : ∀ z ∈ Ideal.map (algebraMap ↥ζ ↥(integralClosure ↥ζ L))
        (IsLocalRing.maximalIdeal ↥ζ),
        ∀ y : ↥(integralClosure ↥ζ L),
          IsIntegral ↥𝒰 (((y * z : ↥(integralClosure ↥ζ L))) : L) := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨m, hm, rfl⟩ := hx
        intro y
        have : (((y * algebraMap ↥ζ ↥(integralClosure ↥ζ L) m :
            ↥(integralClosure ↥ζ L))) : L) = algebraMap ↥ζ L m * (y : L) := by
          show (y : L) * algebraMap ↥ζ L m = _
          rw [mul_comm]
        rw [this]
        exact hmy m hm (y : L) y.2
      | zero =>
        intro y
        rw [mul_zero]
        exact isIntegral_zero
      | add x x' _ _ hx hx' =>
        intro y
        rw [mul_add, Subalgebra.coe_add]
        exact (hx y).add (hx' y)
      | smul a x _ hx =>
        intro y
        rw [smul_eq_mul, ← mul_assoc]
        exact hx (y * a)
    obtain ⟨P₀, hP₀m, hP₀⟩ := hb
    have hP₁m : (Polynomial.X * P₀).Monic := Polynomial.monic_X.mul hP₀m
    have hP₁d : (Polynomial.X * P₀).natDegree ≠ 0 := by
      rw [Polynomial.natDegree_mul Polynomial.X_ne_zero hP₀m.ne_zero, Polynomial.natDegree_X]
      omega
    have hlift : Polynomial.X * P₀ ∈ Polynomial.lifts ρ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact hρsurj _
    obtain ⟨P, hPmap, hPdeg, hPm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hP₁m
    set w : ↥(integralClosure ↥ζ L) :=
      Polynomial.eval₂ ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι) b P with hw
    have hπw : π w = 0 := by
      rw [hw, Polynomial.hom_eval₂, hcompA, ← Polynomial.eval₂_map, hPmap, Polynomial.eval₂_mul,
        Polynomial.eval₂_X]
      rw [show Polynomial.eval₂ (algebraMap ↥Q₀ A) (π b) P₀ = 0 from hP₀, mul_zero]
    have hwL : (w : L) = Polynomial.aeval (b : L) P := by
      rw [Polynomial.aeval_def]
      have := Polynomial.hom_eval₂ P ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι)
        ((integralClosure ↥ζ L).val : ↥(integralClosure ↥ζ L) →+* L) b
      rw [hcompV] at this
      exact this
    have hwint : IsIntegral ↥𝒰 (Polynomial.aeval (b : L) P) := by
      rw [← hwL]
      have := hI w (hker w hπw) 1
      rwa [one_mul] at this
    exact IsIntegral.of_aeval_monic hPm (by rw [hPdeg]; exact hP₁d) hwint

  have T_s5 : ∀ (K L : Type u) [Field K] [Field L]
      [Algebra K L] (ζ : ValuationSubring K) (Q₀ : ValuationSubring (IsLocalRing.ResidueField ↥ζ))
      (𝒰 : ValuationSubring K),
      (∀ x : K, x ∈ 𝒰 ↔ ∃ h : x ∈ ζ, IsLocalRing.residue ↥ζ ⟨x, h⟩ ∈ Q₀) →
      letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
      letI : Algebra ↥𝒰 L := ((algebraMap K L).comp 𝒰.subtype).toAlgebra
      ∀ (A : Type u) [CommRing A] [Algebra (IsLocalRing.ResidueField ↥ζ) A],
      letI : Algebra ↥Q₀ A :=
        ((algebraMap (IsLocalRing.ResidueField ↥ζ) A).comp Q₀.subtype).toAlgebra
      ∀ π : ↥(integralClosure ↥ζ L) →+* A,
      (∀ x : ↥ζ, π (algebraMap ↥ζ ↥(integralClosure ↥ζ L) x) =
        algebraMap (IsLocalRing.ResidueField ↥ζ) A (IsLocalRing.residue ↥ζ x)) →
      ∀ (n : ℕ) (a : Fin n → A),
      (∀ c : Fin n → ↥Q₀,
        (∑ i, algebraMap ↥Q₀ A (c i) * a i) ∈ Submodule.span ↥(integralClosure ↥Q₀ A)
          {x : A | ∃ μ ∈ IsLocalRing.maximalIdeal ↥Q₀, x = algebraMap ↥Q₀ A μ} →
        ∀ i, c i ∈ IsLocalRing.maximalIdeal ↥Q₀) →
      ∀ b : Fin n → ↥(integralClosure ↥ζ L), (∀ i, π (b i) = a i) →
      ∀ c : Fin n → ↥𝒰,
        (∑ i, algebraMap ↥𝒰 L (c i) * (b i : L)) ∈ Submodule.span ↥(integralClosure ↥𝒰 L)
          {x : L | ∃ m ∈ IsLocalRing.maximalIdeal ↥𝒰, x = algebraMap ↥𝒰 L m} →
        ∀ i, c i ∈ IsLocalRing.maximalIdeal ↥𝒰 := by
    intro K L _ _ _ ζ Q₀ 𝒰 hmem
    letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
    letI : Algebra ↥𝒰 L := ((algebraMap K L).comp 𝒰.subtype).toAlgebra
    intro A _ _
    letI : Algebra ↥Q₀ A :=
      ((algebraMap (IsLocalRing.ResidueField ↥ζ) A).comp Q₀.subtype).toAlgebra
    intro π hπ n a ha b hb c hc
    have hle : 𝒰 ≤ ζ := fun x hx => ((hmem x).mp hx).1
    let ι : ↥𝒰 →+* ↥ζ := ValuationSubring.inclusion 𝒰 ζ hle
    let ρ : ↥𝒰 →+* ↥Q₀ :=
      { toFun := fun x => ⟨IsLocalRing.residue ↥ζ (ι x), ((hmem x).mp x.2).2⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun x y => Subtype.ext (by simp)
        map_zero' := Subtype.ext (by simp)
        map_add' := fun x y => Subtype.ext (by simp) }
    have hρ : ∀ x, ((ρ x : ↥Q₀) : IsLocalRing.ResidueField ↥ζ) = IsLocalRing.residue ↥ζ (ι x) :=
      fun x => rfl
    have hmax1 : ∀ x : ↥𝒰, x ∈ IsLocalRing.maximalIdeal ↥𝒰 →
        ρ x ∈ IsLocalRing.maximalIdeal ↥Q₀ := by
      intro x hx
      by_contra hne
      have hu : IsUnit (ρ x) := IsLocalRing.notMem_maximalIdeal.mp hne
      have hr0 : IsLocalRing.residue ↥ζ (ι x) ≠ 0 := by
        intro h0
        have : ρ x = 0 := Subtype.ext (by rw [hρ, h0]; rfl)
        rw [this] at hu
        exact not_isUnit_zero hu
      have hxm : ι x ∉ IsLocalRing.maximalIdeal ↥ζ := fun h =>
        hr0 ((IsLocalRing.residue_eq_zero_iff _).mpr h)
      have h1 : ¬ ζ.valuation (x : K) < 1 := fun h => hxm ((ζ.valuation_lt_one_iff (ι x)).mpr h)
      have h2 : ζ.valuation (x : K) ≤ 1 := (ζ.valuation_le_one_iff _).mpr (hle x.2)
      have h3 : ζ.valuation (x : K) = 1 := le_antisymm h2 (not_lt.mp h1)
      have hx0 : (x : K) ≠ 0 := by
        intro h; rw [h, map_zero] at h3; exact zero_ne_one h3
      have hinv : (x : K)⁻¹ ∈ ζ :=
        (ζ.valuation_le_one_iff _).mp (by rw [map_inv₀, h3, inv_one])
      obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hu
      have hv' : IsLocalRing.residue ↥ζ (ι x) * (v : IsLocalRing.ResidueField ↥ζ) = 1 := by
        have := congrArg (fun q : ↥Q₀ => (q : IsLocalRing.ResidueField ↥ζ)) hv
        simpa [hρ] using this
      have h1' : IsLocalRing.residue ↥ζ ⟨(x : K)⁻¹, hinv⟩ * IsLocalRing.residue ↥ζ (ι x) = 1 := by
        rw [← map_mul, ← map_one (IsLocalRing.residue ↥ζ)]
        congr 1
        apply Subtype.ext
        show (x : K)⁻¹ * (x : K) = 1
        exact inv_mul_cancel₀ hx0
      have heq : IsLocalRing.residue ↥ζ ⟨(x : K)⁻¹, hinv⟩ =
          (v : IsLocalRing.ResidueField ↥ζ) := by
        linear_combination (-(IsLocalRing.residue ↥ζ ⟨(x : K)⁻¹, hinv⟩)) * hv' +
          (v : IsLocalRing.ResidueField ↥ζ) * h1'
      have hU : (x : K)⁻¹ ∈ 𝒰 := (hmem _).mpr ⟨hinv, by rw [heq]; exact v.2⟩
      have hxu : IsUnit x := isUnit_iff_exists_inv.mpr ⟨⟨(x : K)⁻¹, hU⟩,
        Subtype.ext (mul_inv_cancel₀ hx0)⟩
      exact (IsLocalRing.notMem_maximalIdeal.mpr hxu) hx
    have hmax2 : ∀ x : ↥𝒰, ρ x ∈ IsLocalRing.maximalIdeal ↥Q₀ →
        x ∈ IsLocalRing.maximalIdeal ↥𝒰 := by
      intro x hx
      by_contra hne
      have hu : IsUnit x := IsLocalRing.notMem_maximalIdeal.mp hne
      exact (IsLocalRing.notMem_maximalIdeal.mpr (hu.map ρ)) hx
    have hcompL : (algebraMap ↥ζ L).comp ι = algebraMap ↥𝒰 L := RingHom.ext fun _ => rfl
    have hcompA : π.comp ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι) =
        (algebraMap ↥Q₀ A).comp ρ := RingHom.ext fun x => hπ (ι x)
    have hcompV : ((integralClosure ↥ζ L).val : ↥(integralClosure ↥ζ L) →+* L).comp
        ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι) = algebraMap ↥𝒰 L :=
      RingHom.ext fun _ => rfl
    have hB : ∀ y : L, IsIntegral ↥𝒰 y → ∃ hy : y ∈ integralClosure ↥ζ L,
        IsIntegral ↥Q₀ (π ⟨y, hy⟩) := by
      intro y hy
      obtain ⟨P, hPm, hP⟩ := hy
      have hyζ : y ∈ integralClosure ↥ζ L := by
        refine ⟨P.map ι, hPm.map ι, ?_⟩
        rw [Polynomial.eval₂_map, hcompL]
        exact hP
      refine ⟨hyζ, P.map ρ, hPm.map ρ, ?_⟩
      have h0 : Polynomial.eval₂ ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι)
          (⟨y, hyζ⟩ : ↥(integralClosure ↥ζ L)) P = 0 := by
        apply Subtype.ext
        have := Polynomial.hom_eval₂ P ((algebraMap ↥ζ ↥(integralClosure ↥ζ L)).comp ι)
          ((integralClosure ↥ζ L).val : ↥(integralClosure ↥ζ L) →+* L) ⟨y, hyζ⟩
        rw [hcompV] at this
        exact this.trans hP
      have := congrArg π h0
      rw [Polynomial.hom_eval₂, hcompA, map_zero] at this
      rw [Polynomial.eval₂_map]
      exact this
    have hspan : ∀ x ∈ Submodule.span ↥(integralClosure ↥𝒰 L)
        {x : L | ∃ m ∈ IsLocalRing.maximalIdeal ↥𝒰, x = algebraMap ↥𝒰 L m},
        ∃ hx : x ∈ integralClosure ↥ζ L, π ⟨x, hx⟩ ∈ Submodule.span ↥(integralClosure ↥Q₀ A)
          {x : A | ∃ μ ∈ IsLocalRing.maximalIdeal ↥Q₀, x = algebraMap ↥Q₀ A μ} := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨m, hm, rfl⟩ := hx
        refine ⟨(algebraMap ↥ζ ↥(integralClosure ↥ζ L) (ι m)).2, ?_⟩
        show π (algebraMap ↥ζ ↥(integralClosure ↥ζ L) (ι m)) ∈ _
        apply Submodule.subset_span
        exact ⟨ρ m, hmax1 m hm, by rw [hπ]; rfl⟩
      | zero =>
        refine ⟨zero_mem _, ?_⟩
        show π 0 ∈ _
        rw [map_zero]
        exact zero_mem _
      | add x y _ _ hx hy =>
        obtain ⟨hx1, hx2⟩ := hx
        obtain ⟨hy1, hy2⟩ := hy
        refine ⟨add_mem hx1 hy1, ?_⟩
        show π (⟨x, hx1⟩ + ⟨y, hy1⟩) ∈ _
        rw [map_add]
        exact add_mem hx2 hy2
      | smul s x _ hx =>
        obtain ⟨hx1, hx2⟩ := hx
        obtain ⟨hs1, hs2⟩ := hB (s : L) s.2
        have hmul : (s : L) * x ∈ integralClosure ↥ζ L := mul_mem hs1 hx1
        refine ⟨by rw [Subalgebra.smul_def, smul_eq_mul]; exact hmul, ?_⟩
        have e : (⟨s • x, by rw [Subalgebra.smul_def, smul_eq_mul]; exact hmul⟩ :
            ↥(integralClosure ↥ζ L)) = ⟨(s : L), hs1⟩ * ⟨x, hx1⟩ := by
          apply Subtype.ext
          show s • x = (s : L) * x
          rw [Subalgebra.smul_def, smul_eq_mul]
        rw [e, map_mul]
        have := Submodule.smul_mem (Submodule.span ↥(integralClosure ↥Q₀ A)
          {x : A | ∃ μ ∈ IsLocalRing.maximalIdeal ↥Q₀, x = algebraMap ↥Q₀ A μ})
          (⟨π ⟨(s : L), hs1⟩, hs2⟩ : ↥(integralClosure ↥Q₀ A)) hx2
        rw [Subalgebra.smul_def, smul_eq_mul] at this
        exact this
    obtain ⟨hx, hπx⟩ := hspan _ hc
    have e : (⟨∑ i, algebraMap ↥𝒰 L (c i) * (b i : L), hx⟩ : ↥(integralClosure ↥ζ L)) =
        ∑ i, algebraMap ↥ζ ↥(integralClosure ↥ζ L) (ι (c i)) * b i := by
      apply Subtype.ext
      show ∑ i, algebraMap ↥𝒰 L (c i) * (b i : L) =
        ((∑ i, algebraMap ↥ζ ↥(integralClosure ↥ζ L) (ι (c i)) * b i :
          ↥(integralClosure ↥ζ L)) : L)
      rw [AddSubmonoidClass.coe_finset_sum]
      exact Finset.sum_congr rfl (fun i _ => rfl)
    have e2 : π (∑ i, algebraMap ↥ζ ↥(integralClosure ↥ζ L) (ι (c i)) * b i) =
        ∑ i, algebraMap ↥Q₀ A (ρ (c i)) * a i := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, hπ, hb i]
      rfl
    rw [e, e2] at hπx
    intro i
    exact hmax2 (c i) (ha (fun i => ρ (c i)) hπx i)

  have T_crit : ∀ (K : Type u) [Field K]
      (O : ValuationSubring K) (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L],
      letI : Algebra O L := ((algebraMap K L).comp O.subtype).toAlgebra
      ∀ b : Fin (Module.finrank K L) → L, (∀ i, IsIntegral O (b i)) →
        (∀ c : Fin (Module.finrank K L) → O,
          (∑ i, algebraMap O L (c i) * b i) ∈ Submodule.span (integralClosure O L)
            {x : L | ∃ m ∈ IsLocalRing.maximalIdeal O, x = algebraMap O L m} →
          ∀ i, c i ∈ IsLocalRing.maximalIdeal O) →
        Module.Finite O (integralClosure O L) := by
    intro K _ O L _ _ _
    letI : Algebra O L := ((algebraMap K L).comp O.subtype).toAlgebra
    intro b hb H
    have haO : ∀ c : O, algebraMap O L c = algebraMap K L (c : K) := fun c => rfl
    have norm : ∀ g : Fin (Module.finrank K L) → K, (∃ i, g i ≠ 0) →
        ∃ j, g j ≠ 0 ∧ (∀ i, g i / g j ∈ O) ∧
          ((∃ i, g i ∉ O) → (g j)⁻¹ ∈ O ∧ O.valuation (g j)⁻¹ < 1) := by
      intro g ⟨i₀, hi₀⟩
      obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i => O.valuation (g i))
        ⟨i₀, Finset.mem_univ _⟩
      have hvi₀ : O.valuation (g i₀) ≠ 0 := (Valuation.ne_zero_iff _).mpr hi₀
      have hvj : O.valuation (g j) ≠ 0 := by
        intro h
        have := hj i₀ (Finset.mem_univ _)
        rw [h] at this
        exact hvi₀ (le_antisymm this zero_le')
      have hgj : g j ≠ 0 := (Valuation.ne_zero_iff _).mp hvj
      refine ⟨j, hgj, ?_, ?_⟩
      · intro i
        rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div]
        exact div_le_one_of_le₀ (hj i (Finset.mem_univ _)) zero_le'
      · rintro ⟨i₁, hi₁⟩
        rw [← ValuationSubring.valuation_le_one_iff, not_le] at hi₁
        have h1 : 1 < O.valuation (g j) := lt_of_lt_of_le hi₁ (hj i₁ (Finset.mem_univ _))
        have h2 : O.valuation (g j)⁻¹ < 1 := by
          rw [Valuation.map_inv]; exact inv_lt_one_of_one_lt₀ h1
        exact ⟨(ValuationSubring.valuation_le_one_iff _ _).mp h2.le, h2⟩
    have hsum : ∀ (g : Fin (Module.finrank K L) → K) (j : Fin (Module.finrank K L))
        (hc : ∀ i, g i / g j ∈ O),
        ∑ i, algebraMap O L ⟨g i / g j, hc i⟩ * b i =
          algebraMap K L (g j)⁻¹ * ∑ i, g i • b i := by
      intro g j hc
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [haO, Algebra.smul_def, ← mul_assoc, ← map_mul]
      show algebraMap K L (g i / g j) * b i = _
      rw [div_eq_inv_mul]
    have hone : ∀ (g : Fin (Module.finrank K L) → K) (j : Fin (Module.finrank K L)), g j ≠ 0 →
        ∀ (h : g j / g j ∈ O), (⟨g j / g j, h⟩ : O) ∉ IsLocalRing.maximalIdeal O := by
      intro g j hj h
      have : (⟨g j / g j, h⟩ : O) = 1 := Subtype.ext (by simp [hj])
      rw [this]
      exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one
    have hli : LinearIndependent K b := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      by_contra hne
      push_neg at hne
      obtain ⟨j, hgj, hc, -⟩ := norm g hne
      have hmem := H (fun i => ⟨g i / g j, hc i⟩) (by
        rw [hsum g j hc, hg, mul_zero]
        exact Submodule.zero_mem _) j
      exact hone g j hgj (hc j) hmem
    haveI : Nonempty (Fin (Module.finrank K L)) := ⟨⟨0, Module.finrank_pos⟩⟩
    let bas := basisOfLinearIndependentOfCardEqFinrank hli (Fintype.card_fin _)
    have hbas : ∀ i, bas i = b i := fun i => by simp [bas]
    have hrepr : ∀ x : L, ∑ i, bas.repr x i • b i = x := by
      intro x
      conv_rhs => rw [← bas.sum_repr x]
      simp only [hbas]
    have hcoord : ∀ x : L, x ∈ integralClosure O L → ∀ i, bas.repr x i ∈ O := by
      intro x hx
      by_contra hne
      push_neg at hne
      obtain ⟨i₁, hi₁⟩ := hne
      have hgi₁ : bas.repr x i₁ ≠ 0 := fun h => hi₁ (by rw [h]; exact O.zero_mem)
      obtain ⟨j, hgj, hc, h3⟩ := norm (fun i => bas.repr x i) ⟨i₁, hgi₁⟩
      obtain ⟨htO, htlt⟩ := h3 ⟨i₁, hi₁⟩
      have htm : (⟨(bas.repr x j)⁻¹, htO⟩ : O) ∈ IsLocalRing.maximalIdeal O :=
        (ValuationSubring.valuation_lt_one_iff O _).mpr htlt
      have hmem := H (fun i => ⟨bas.repr x i / bas.repr x j, hc i⟩) (by
        have e := hsum (fun i => bas.repr x i) j hc
        simp only [hrepr x] at e
        rw [e]
        have h1 : algebraMap O L ⟨(bas.repr x j)⁻¹, htO⟩ ∈ Submodule.span (integralClosure O L)
            {x : L | ∃ m ∈ IsLocalRing.maximalIdeal O, x = algebraMap O L m} :=
          Submodule.subset_span ⟨_, htm, rfl⟩
        have h2 := Submodule.smul_mem _ (⟨x, hx⟩ : integralClosure O L) h1
        rw [Subalgebra.smul_def, smul_eq_mul] at h2
        rw [mul_comm]
        exact h2) j
      exact hone (fun i => bas.repr x i) j hgj (hc j) hmem
    let φ : (Fin (Module.finrank K L) → O) →ₗ[O] integralClosure O L :=
      Fintype.linearCombination O (fun i => (⟨b i, hb i⟩ : integralClosure O L))
    have hsurj : Function.Surjective φ := by
      rintro ⟨x, hx⟩
      refine ⟨fun i => ⟨bas.repr x i, hcoord x hx i⟩, ?_⟩
      apply Subtype.ext
      simp only [φ, Fintype.linearCombination_apply]
      rw [AddSubmonoidClass.coe_finset_sum]
      conv_rhs => rw [← hrepr x]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Subalgebra.coe_smul, Algebra.smul_def, Algebra.smul_def]
      rfl
    exact Module.Finite.of_surjective φ hsurj

  intro K L _ _ _ _ ζ
  letI : Algebra ↥ζ L := ((algebraMap K L).comp ζ.subtype).toAlgebra
  intro hF hR hJ Q₀ hH 𝒰 hmem
  letI : Algebra ↥𝒰 L := ((algebraMap K L).comp 𝒰.subtype).toAlgebra
  haveI := hF
  haveI : Module.Finite ↥ζ ↥(integralClosure ↥ζ L) :=
    Module.finite_of_finrank_pos (by rw [hR]; exact Module.finrank_pos)
  let I₁ : Ideal ↥(integralClosure ↥ζ L) :=
    Ideal.map (algebraMap ↥ζ ↥(integralClosure ↥ζ L)) (IsLocalRing.maximalIdeal ↥ζ)
  have h1 : Module.Finite (↥ζ ⧸ IsLocalRing.maximalIdeal ↥ζ) (↥(integralClosure ↥ζ L) ⧸ I₁) :=
    Module.Finite.of_basis (IsLocalRing.basisQuotient
      (Module.Free.chooseBasis ↥ζ ↥(integralClosure ↥ζ L)))
  have h2 : Module.finrank (↥ζ ⧸ IsLocalRing.maximalIdeal ↥ζ) (↥(integralClosure ↥ζ L) ⧸ I₁) =
      Module.finrank K L :=
    (IsLocalRing.finrank_quotient_map (R := ↥ζ) (S := ↥(integralClosure ↥ζ L))).trans hR
  letI instA : Algebra (IsLocalRing.ResidueField ↥ζ) (↥(integralClosure ↥ζ L) ⧸ I₁) :=
    Ideal.Quotient.algebraQuotientMapQuotient
  letI instM : Module (IsLocalRing.ResidueField ↥ζ) (↥(integralClosure ↥ζ L) ⧸ I₁) :=
    instA.toModule
  haveI hFD : FiniteDimensional (IsLocalRing.ResidueField ↥ζ)
      (↥(integralClosure ↥ζ L) ⧸ I₁) := h1
  have hdim : Module.finrank (IsLocalRing.ResidueField ↥ζ) (↥(integralClosure ↥ζ L) ⧸ I₁) =
      Module.finrank K L := h2
  have hπ : ∀ x : ↥ζ, Ideal.Quotient.mk I₁ (algebraMap ↥ζ ↥(integralClosure ↥ζ L) x) =
      algebraMap (IsLocalRing.ResidueField ↥ζ) (↥(integralClosure ↥ζ L) ⧸ I₁)
        (IsLocalRing.residue ↥ζ x) := fun x => rfl
  have hker : ∀ z : ↥(integralClosure ↥ζ L), Ideal.Quotient.mk I₁ z = 0 → z ∈ I₁ :=
    fun z h => Ideal.Quotient.eq_zero_iff_mem.mp h
  haveI hred : IsReduced (↥(integralClosure ↥ζ L) ⧸ I₁) := T_s1 K L ζ hJ
  have HB : ∀ (F : Type u) [Field F] [Algebra (IsLocalRing.ResidueField ↥ζ) F]
      [FiniteDimensional (IsLocalRing.ResidueField ↥ζ) F],
      letI : Algebra ↥Q₀ F :=
        ((algebraMap (IsLocalRing.ResidueField ↥ζ) F).comp Q₀.subtype).toAlgebra
      ∃ β : Fin (Module.finrank (IsLocalRing.ResidueField ↥ζ) F) → F,
        (∀ l, IsIntegral ↥Q₀ (β l)) ∧
        (∀ s : F, IsIntegral ↥Q₀ s →
          ∃ d : Fin (Module.finrank (IsLocalRing.ResidueField ↥ζ) F) → ↥Q₀,
            s = ∑ l, algebraMap ↥Q₀ F (d l) * β l) ∧
        (∀ c : Fin (Module.finrank (IsLocalRing.ResidueField ↥ζ) F) → ↥Q₀,
          ∑ l, algebraMap ↥Q₀ F (c l) * β l = 0 → ∀ l, c l = 0) :=
    fun F _ _ _ => T_s2 (IsLocalRing.ResidueField ↥ζ) Q₀ F (hH F)
  obtain ⟨a, haI, haR⟩ := T_s3 (IsLocalRing.ResidueField ↥ζ) Q₀
    (↥(integralClosure ↥ζ L) ⧸ I₁) HB (Module.finrank K L) hdim
  choose b hb using fun i => Ideal.Quotient.mk_surjective (I := I₁) (a i)
  have hbint : ∀ i, IsIntegral ↥𝒰 ((b i : L)) := fun i =>
    T_s4 K L ζ Q₀ 𝒰 hmem _ (Ideal.Quotient.mk I₁) hπ hker (b i) (by rw [hb i]; exact haI i)
  exact T_crit K 𝒰 L (fun i => (b i : L)) hbint
    (T_s5 K L ζ Q₀ 𝒰 hmem _ (Ideal.Quotient.mk I₁) hπ (Module.finrank K L) a haR b hb)

theorem wcpa_dj_lr1k_eb_eg_sep_bc_free : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
