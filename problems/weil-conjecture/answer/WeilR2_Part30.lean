  obtain ⟨hs1a, hs1b⟩ := wcpa_dj_lr1k_eb_pd_eg_inoc_facts Ω W c hc0

  obtain ⟨t, ht⟩ : ∃ t : L, t = η b / ι γ := ⟨_, rfl⟩
  have hψX' : ψ RatFunc.X = t := by rw [hψX, ht]; rfl
  have hG1 : ∀ p : Polynomial Ω,
      ψ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = Polynomial.eval₂ ι t p := by
    have hh : ψ.comp (algebraMap (Polynomial Ω) (RatFunc Ω)) = Polynomial.eval₂RingHom ι t := by
      apply Polynomial.ringHom_ext
      · intro w
        have h1 : algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C w) =
            algebraMap Ω (RatFunc Ω) w := by
          rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
        rw [RingHom.comp_apply, h1, hψw, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rfl
      · rw [RingHom.comp_apply, RatFunc.algebraMap_X, hψX', Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_X]
    intro p
    exact RingHom.congr_fun hh p

  have hG2 : ∀ w : Ω, ι w ∈ V' ↔ w ∈ W := by
    intro w
    have h1 : algebraMap Ω (RatFunc Ω) w ∈ V'.comap (algebraMap (RatFunc Ω) L) ↔ ι w ∈ V' :=
      ValuationSubring.mem_comap
    rw [← h1, hV', hO]
    exact hs1a w

  obtain ⟨s, hs⟩ : ∃ s : L, s = algebraMap (RatFunc Ω) L
      (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) := ⟨_, rfl⟩
  have hG3 : ∀ P : Polynomial ↥W, (∃ i, IsUnit (P.coeff i)) →
      V'.valuation (Polynomial.eval₂ (ι.comp W.subtype) s P) = 1 := by
    intro P hP
    obtain ⟨hin, hunit⟩ := hs1b P
    obtain ⟨hne, hinv⟩ := hunit hP
    have hx : Polynomial.eval₂ (ι.comp W.subtype) s P = algebraMap (RatFunc Ω) L
        (Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype)
          (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P) := by
      rw [hs, Polynomial.hom_eval₂] <;> rfl
    rw [hx]
    generalize Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype)
          (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P = f at hin hne hinv ⊢
    have hfO : f ∈ V'.comap (algebraMap (RatFunc Ω) L) := by
