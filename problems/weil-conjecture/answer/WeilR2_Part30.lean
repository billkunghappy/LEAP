      ∀ (a q : ℕ → L), (∀ i, i < f.natDegree → a i ∈ A ∧ q i ∈ A ∧ f.coeff i * q i = a i) →
      IsIntegral ↥A ((∏ i ∈ Finset.range f.natDegree, q i) * s₀) := by
    intro A s₀ f hf he a q h
    have hPA : ∀ i, ∏ j ∈ (Finset.range f.natDegree).erase i, q j ∈ A := fun i =>
      A.prod_mem (fun j hj => (h j (Finset.mem_range.mp (Finset.mem_of_mem_erase hj))).2.1)
    have hQA : ∏ i ∈ Finset.range f.natDegree, q i ∈ A :=
      A.prod_mem (fun i hi => (h i (Finset.mem_range.mp hi)).2.1)
