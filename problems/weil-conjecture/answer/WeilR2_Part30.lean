    have h3 : 1 < (2 : ℝ) ^ (-sSup (S x)) :=
      Real.one_lt_rpow (by norm_num) (by linarith)
    linarith
  ·
    intro r z hr hz
    by_cases hx0 : algebraMap V B r * z = 0
    · rw [hx0, habs0]
      norm_num
    obtain ⟨M, y₁, hrM⟩ := hrad r hr
    have hM : 0 < M := by
      rcases Nat.eq_zero_or_pos M with h | h
      · exfalso
        rw [h, pow_zero] at hrM
        exact htnu (isUnit_iff_exists_inv.mpr ⟨y₁, hrM.symm⟩)
      · exact h
    have hq : (1 / (M : ℝ)) ∈ S (algebraMap V B r * z) :=
      (hmem _ _).mpr ⟨1, 0, M, algebraMap V B y₁ * z ^ M, hM,
        isIntegral_algebraMap.mul (hz.pow M),
        by rw [pow_zero, one_mul, pow_one, mul_pow, ← map_pow, hrM, map_mul, hτ]; ring,
        by norm_num⟩
    have h1 := le_csSup (hbdd _ hx0) hq
    rw [habs _ hx0]
    have hMr : (0 : ℝ) < M := by exact_mod_cast hM
    have hpos : 0 < 1 / (M : ℝ) := by positivity
    exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  ·
    have hτ0 : τ ≠ 0 := hunit.ne_zero
    rw [habs τ hτ0]
    have h1 : (1 : ℝ) ∈ S τ :=
      (hmem _ _).mpr ⟨1, 0, 1, 1, one_pos, isIntegral_one, by ring, by norm_num⟩
    have hle : ∀ q ∈ S τ, q ≤ 1 := by
      intro q hq
      obtain ⟨m, k, n, y, hn, hy, h, rfl⟩ := (hmem _ _).mp hq
      have h2 : m ≤ k + n := hcancel (k + n) m y hy (by rw [pow_add]; exact h)
      have hn' : (0 : ℝ) < n := by exact_mod_cast hn
      rw [div_le_iff₀ hn']
      have h3 : (m : ℝ) ≤ k + n := by exact_mod_cast h2
      linarith
    have hS1 : sSup (S τ) = 1 := le_antisymm (csSup_le ⟨1, h1⟩ hle) (le_csSup ⟨1, hle⟩ h1)
    rw [hS1, Real.rpow_neg_one]
    norm_num

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_cc_na_cart_closed : ∀ (V F L : Type u) [CommRing V] [CommRing F] [IsDomain F] [CommRing L] [Algebra V F] [Algebra V L] [Algebra F L] [IsScalarTower V F L] (t : V), ¬ IsUnit t → (∀ x y : V, x ∣ y ∨ y ∣ x) → (∀ f : ℕ → V, (∀ n : ℕ, ∃ y : V, f (n + 1) - f n = t ^ n * y) → ∃ l : V, ∀ n : ℕ, ∃ y : V, l - f n = t ^ n * y) → Function.Injective (algebraMap V F) → IsUnit (algebraMap V F t) → wcRfCart V F t → (∀ w : F, IsIntegral V (algebraMap F L w) → IsIntegral V w) → ∀ (N : L → ℝ), (∀ x : L, (∀ k : ℕ, N x ≤ (1 / 2 : ℝ) ^ k) → x = 0) → (∀ x y : L, N (x + y) ≤ max (N x) (N y)) → (∀ x : L, N (-x) = N x) → (∀ (x : L) (m : ℕ), N x ≤ (1 / 2 : ℝ) ^ m → ∃ w : L, IsIntegral V w ∧ x = algebraMap V L t ^ m * w) → (∀ (w : L) (k : ℕ), IsIntegral V w → N (algebraMap V L t ^ k * w) ≤ (1 / 2 : ℝ) ^ k) → ∀ α : L, α ∉ Set.range (algebraMap F L) → ∃ δ : ℝ, 0 < δ ∧ ∀ c : F, δ ≤ N (α - algebraMap F L c) :=
by
  intro V F L _ _ _ _ _ _ _ _ t htnu htot hcpl hinjF hunitF hFc hrefl N N0 N1 N2 N3 N4 α hα
  classical
  obtain ⟨n, b, hbi, hspan, hUC⟩ := hFc

  have hdom : ∀ (c : Fin n → V) (s : Finset (Fin n)), s.Nonempty → ∃ j, ∀ i ∈ s, c j ∣ c i := by
    intro c s
    induction s using Finset.induction_on with
    | empty => intro hs; exact absurd hs Finset.not_nonempty_empty
    | insert a s ha ih =>
      intro _
      rcases s.eq_empty_or_nonempty with h | h
      · refine ⟨a, fun i hi => ?_⟩
        rcases Finset.mem_insert.mp hi with rfl | hi
        · exact dvd_rfl
        · rw [h] at hi; simp at hi
      · obtain ⟨j, hj⟩ := ih h
        rcases htot (c j) (c a) with h' | h'
        · refine ⟨j, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with rfl | hi
          · exact h'
          · exact hj i hi
        · refine ⟨a, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with rfl | hi
          · exact dvd_rfl
          · exact h'.trans (hj i hi)

  have Sp : ∀ x : F, IsIntegral V x → x ∈ Submodule.span V (Set.range b) := by
    intro x hx
    obtain ⟨M, hM⟩ := hspan x
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun V).mp hM
    have htN : IsUnit (algebraMap V F t ^ M) := hunitF.pow M
    have star : (∃ e : Fin n → V, ∀ i, c i = t ^ M * e i) →
        x ∈ Submodule.span V (Set.range b) := by
      rintro ⟨e, he⟩
      have h1 : algebraMap V F t ^ M * x = algebraMap V F t ^ M * ∑ i, e i • b i := by
        rw [← hc, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [he i, Algebra.smul_def, Algebra.smul_def, map_mul, map_pow, mul_assoc]
      have h2 : x = ∑ i, e i • b i := htN.mul_left_cancel h1
      rw [h2]
      exact (Submodule.mem_span_range_iff_exists_fun V).mpr ⟨e, rfl⟩
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      exact star ⟨fun _ => 0, fun i => i.elim0⟩
    obtain ⟨j, hj⟩ := hdom c Finset.univ ⟨⟨0, hn⟩, Finset.mem_univ _⟩
    have hex : ∀ i, ∃ e : V, c i = c j * e := fun i => hj i (Finset.mem_univ i)
    choose e he using hex
    set e' : Fin n → V := fun i => if i = j then 1 else e i with he'def
    have he' : ∀ i, c i = c j * e' i := by
      intro i
      by_cases hij : i = j
      · rw [he'def]; simp only [hij, if_true, mul_one]
      · rw [he'def]; simp only [hij, if_false]; exact he i
    rcases htot (t ^ M) (c j) with ⟨f, hf⟩ | ⟨r, hr⟩
    · exact star ⟨fun i => f * e' i, fun i => by rw [he' i, hf, mul_assoc]⟩
    · by_cases hru : IsUnit r
      · obtain ⟨u, rfl⟩ := hru
        have hcj : c j = t ^ M * ↑u⁻¹ := by
          rw [hr, mul_assoc, Units.mul_inv, mul_one]
        exact star ⟨fun i => ↑u⁻¹ * e' i, fun i => by rw [he' i, hcj, mul_assoc]⟩
      · exfalso
        have hcj : c j ≠ 0 := by
          intro h0
          apply htN.ne_zero
          rw [← map_pow, hr, h0, zero_mul, map_zero]
        have hcj' : algebraMap V F (c j) ≠ 0 := (map_ne_zero_iff _ hinjF).mpr hcj
        have hsum : algebraMap V F (c j) * ∑ i, algebraMap V F (e' i) * b i =
            algebraMap V F (c j) * (algebraMap V F r * x) := by
          rw [Finset.mul_sum, ← mul_assoc, ← map_mul, ← hr, map_pow, ← hc]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Algebra.smul_def, he' i, map_mul, mul_assoc]
        have hw := mul_left_cancel₀ hcj' hsum
        refine hUC e' ⟨j, ?_⟩ r x hru hx hw
        rw [he'def]; simp only [if_true]; exact isUnit_one

  have LI : ∀ c : Fin n → V, ∑ j, c j • b j = 0 → ∀ j, c j = 0 := by
    intro c hc i₀
    by_contra hi₀
    obtain ⟨j, hj⟩ := hdom c Finset.univ ⟨i₀, Finset.mem_univ _⟩
    have hex : ∀ i, ∃ e : V, c i = c j * e := fun i => hj i (Finset.mem_univ i)
    choose e he using hex
    set e' : Fin n → V := fun i => if i = j then 1 else e i with he'def
    have he' : ∀ i, c i = c j * e' i := by
      intro i
      by_cases hij : i = j
      · rw [he'def]; simp only [hij, if_true, mul_one]
      · rw [he'def]; simp only [hij, if_false]; exact he i
    have hcj : c j ≠ 0 := by
      intro h0; apply hi₀; rw [he' i₀, h0, zero_mul]
    have hcj' : algebraMap V F (c j) ≠ 0 := (map_ne_zero_iff _ hinjF).mpr hcj
    have hsum : algebraMap V F (c j) * ∑ i, algebraMap V F (e' i) * b i =
        algebraMap V F (c j) * (algebraMap V F t * 0) := by
      rw [mul_zero, mul_zero, ← hc, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, he' i, map_mul, mul_assoc]
    have hw := mul_left_cancel₀ hcj' hsum
    refine hUC e' ⟨j, ?_⟩ t 0 htnu isIntegral_zero hw
    rw [he'def]; simp only [if_true]; exact isUnit_one

  have Coef : ∀ (μ μ' : Fin n → V) (w : F) (k : ℕ), IsIntegral V w →
      ∑ i, μ' i • b i - ∑ i, μ i • b i = algebraMap V F t ^ k * w →
      ∀ i, ∃ y, μ' i - μ i = t ^ k * y := by
    intro μ μ' w k hw h i
    obtain ⟨f, hf⟩ := (Submodule.mem_span_range_iff_exists_fun V).mp (Sp w hw)
    have e2 : ∑ j, (t ^ k * f j) • b j = algebraMap V F t ^ k * ∑ j, f j • b j := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [mul_smul, Algebra.smul_def (t ^ k), map_pow]
    have h0 : ∑ j, (μ' j - μ j - t ^ k * f j) • b j = 0 := by
      have e1 : ∑ j, (μ' j - μ j - t ^ k * f j) • b j =
          (∑ j, μ' j • b j - ∑ j, μ j • b j) - algebraMap V F t ^ k * ∑ j, f j • b j := by
        rw [← e2]
        simp only [sub_smul, Finset.sum_sub_distrib]
      rw [e1, h, hf, sub_self]
    exact ⟨f i, by linear_combination LI _ h0 i⟩

  obtain ⟨σ, hσ⟩ := hunitF.exists_left_inv
  have hτ : algebraMap V L t = algebraMap F L (algebraMap V F t) :=
    IsScalarTower.algebraMap_apply V F L t
  have approx : ∀ (c c' : F) (k : ℕ), N (α - algebraMap F L c) ≤ (1 / 2 : ℝ) ^ k →
      N (α - algebraMap F L c') ≤ (1 / 2 : ℝ) ^ k →
      ∃ w : F, IsIntegral V w ∧ c' - c = algebraMap V F t ^ k * w := by
    intro c c' k h1 h2
    have hx : N (algebraMap F L (c' - c)) ≤ (1 / 2 : ℝ) ^ k := by
      have e : algebraMap F L (c' - c) = (α - algebraMap F L c) + -(α - algebraMap F L c') := by
        rw [map_sub]; ring
      rw [e]
      exact (N1 _ _).trans (max_le h1 (by rw [N2]; exact h2))
    obtain ⟨wL, hwL, hxw⟩ := N3 _ k hx
    refine ⟨σ ^ k * (c' - c), hrefl _ ?_, ?_⟩
    · have e : algebraMap F L (σ ^ k * (c' - c)) = wL := by
        rw [map_mul, hxw, hτ, map_pow, ← mul_assoc, ← mul_pow, ← map_mul, hσ, map_one,
          one_pow, one_mul]
      rw [e]; exact hwL
    · rw [← mul_assoc, ← mul_pow, mul_comm (algebraMap V F t) σ, hσ, one_pow, one_mul]

  have close : ∀ (c c' g : F) (k : ℕ), IsIntegral V g → c' - c = algebraMap V F t ^ k * g →
      N (α - algebraMap F L c) ≤ (1 / 2 : ℝ) ^ k → N (α - algebraMap F L c') ≤ (1 / 2 : ℝ) ^ k := by
    intro c c' g k hg hcc h1
    have h3 : algebraMap F L (c' - c) = algebraMap V L t ^ k * algebraMap F L g := by
      rw [hcc, map_mul, map_pow, hτ]
    rw [map_sub] at h3
    have e : α - algebraMap F L c' =
        (α - algebraMap F L c) + -(algebraMap V L t ^ k * algebraMap F L g) := by
      linear_combination (-1 : L) * h3
    rw [e]
