theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_ca_gauss_recoord_rc_sep_coords (k κ : Type u) [Field k] [Field κ] [Algebra k κ] [PerfectField k] (d n : ℕ) (s : Fin d → κ) (hs : AlgebraicIndependent k s) (b : Fin n → κ) (hb : ∀ x : κ, ∃ a : Fin n → κ, (∀ j, a j ∈ IntermediateField.adjoin k (Set.range s)) ∧ x = ∑ j, a j * b j) : ∃ z : Fin d → κ, AlgebraicIndependent k z ∧ FiniteDimensional ↥(IntermediateField.adjoin k (Set.range z)) κ ∧ Algebra.IsSeparable ↥(IntermediateField.adjoin k (Set.range z)) κ :=
