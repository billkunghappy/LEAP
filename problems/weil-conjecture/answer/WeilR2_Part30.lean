  have hcomap : (Submodule.comap (LinearMap.mulLeft T (algebraMap T A h)) F₀).FG := by
    apply Submodule.fg_of_fg_map_injective _ hμinj
    rwa [Submodule.map_comap_eq]

  have heq : Subalgebra.toSubmodule (integralClosure T A) =
      Submodule.comap (LinearMap.mulLeft T (algebraMap T A h)) F₀ := by
    ext x
    rw [Subalgebra.mem_toSubmodule, mem_integralClosure_iff, hchar x, Submodule.mem_comap,
      LinearMap.mulLeft_apply]
  have hfg : (Subalgebra.toSubmodule (integralClosure T A)).FG := heq ▸ hcomap
  haveI : Module.Finite T (Subalgebra.toSubmodule (integralClosure T A)) :=
