      have hb : a ∣ (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ (hpre σ hσV)).hom
          (g (MvPolynomial.X 0))) -
          (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ'.appLE V ⊤ (hpre σ' hσ'V)).hom
          (g (MvPolynomial.X 0))) := by
        have hmem : g (MvPolynomial.X 0) - g (MvPolynomial.C
            ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ'.appLE V ⊤ (hpre σ' hσ'V)).hom
              (g (MvPolynomial.X 0))))) ∈ Ideal.comap
            (((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (σ'.appLE V ⊤ (hpre σ' hσ'V)).hom)
            (Ideal.span {a'}) := by
          rw [Ideal.mem_comap, Ideal.mem_span_singleton, hcomp, map_sub, map_sub,
            hL10 σ' hP'.1, sub_self]
          exact dvd_zero _
        have := h1 hmem
        rwa [Ideal.mem_comap, Ideal.mem_span_singleton, hcomp, map_sub, map_sub,
          hL10 σ hP.1] at this
      exact ⟨ha, hτd ▸ (dvd_neg.mpr hb)⟩
    · rintro ⟨ha, hb⟩
      have hb' : a ∣ (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ (hpre σ hσV)).hom
          (g (MvPolynomial.X 0))) -
          (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ'.appLE V ⊤ (hpre σ' hσ'V)).hom
