    fun a => (transfer _).trans (hOv a)
  by_cases hx0 : x = 0
  · refine ⟨1, ?_⟩
    rw [hx0, map_zero, pow_one, zero_lt_iff]
    exact (Valuation.ne_zero_iff _).mpr hy
  obtain ⟨c, hc0, hcx⟩ := hG3 x hx0
  obtain ⟨d, hd0, hdy⟩ := hG3 y hy
  rw [map_div₀, div_eq_one_iff_eq ((Valuation.ne_zero_iff _).mpr (hι0 c hc0))] at hcx
