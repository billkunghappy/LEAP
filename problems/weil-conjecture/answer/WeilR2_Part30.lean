      Polynomial.eval₂ (algebraMap V L) γ gm = 0 ∧
      Polynomial.eval₂ (algebraMap V L) γ (Polynomial.derivative gm) ≠ 0 := by
    intro V K L _ _ _ _ _ _ _ _ _ _ α hα
    obtain ⟨m₀, hm₀⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors V) α hα.isIntegral
    have hm : (m₀ : V) ≠ 0 := nonZeroDivisors.coe_ne_zero m₀
    have hγ : m₀ • α = algebraMap V L (m₀ : V) * α := by
      rw [Submonoid.smul_def, Algebra.smul_def]
    rw [hγ] at hm₀
    refine ⟨m₀, algebraMap V L (m₀ : V) * α, minpoly V (algebraMap V L (m₀ : V) * α), hm, rfl,
