  obtain ⟨S₀, hS₀⟩ := hfin.fg_top
  have key : Subalgebra.toSubmodule (integralClosure T A) =
      Submodule.span T ((S₀.image Subtype.val : Finset A) : Set A) := by
    apply le_antisymm
    · intro x hx
      have hx0 : x ∈ integralClosure T₀ A := hdesc x hx
      have hxs : (⟨x, hx0⟩ : integralClosure T₀ A) ∈
          Submodule.span T₀ (S₀ : Set (integralClosure T₀ A)) := hS₀ ▸ Submodule.mem_top
      have := Submodule.mem_map_of_mem
        (f := (integralClosure T₀ A).val.toLinearMap) hxs
      rw [Submodule.map_span] at this
      have e : ((S₀.image Subtype.val : Finset _) : Set A) =
          (integralClosure T₀ A).val.toLinearMap '' (S₀ : Set _) := by
        ext y; simp
      rw [← e] at this
      exact Submodule.span_le_restrictScalars T₀ T _ this
    · rw [Submodule.span_le]
      intro g hg
      rw [Finset.coe_image] at hg
      obtain ⟨s, -, rfl⟩ := hg
