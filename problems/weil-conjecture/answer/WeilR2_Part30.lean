      simp [ψ]
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective φ hφs h𝔫max with htop | hmax
    · apply hni
      have h1 : (1 : ↥A) ∈ Ideal.map φ 𝔫 := by rw [htop]; exact Submodule.mem_top
      obtain ⟨P, hP𝔫, hP1⟩ := (Ideal.mem_map_iff_of_surjective φ hφs).mp h1
      have hP1' : f₀ P = 1 := congrArg Subtype.val hP1
      set Q := P - 1 with hQ
