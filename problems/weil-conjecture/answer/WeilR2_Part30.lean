      rw [← hz', ← hc']; ring
  obtain ⟨hℓnzd, hB, c, hcm, hc⟩ := s2



  have h7 : ∀ s ∈ nonZeroDivisors R, ∃ (N : ℕ) (r : R), ℓ ^ N = s * r := by
