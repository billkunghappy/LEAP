    apply IsLocalization.injective (M := Submonoid.powers u) (Localization.Away u)
    rw [Submonoid.powers_le]
    rw [mem_nonZeroDivisors_iff_right]
    exact fun x hx => htor x (by rw [mul_comm]; exact hx)

