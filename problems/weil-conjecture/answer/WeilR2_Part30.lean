      rw [hNe, hDe, key, key] at hf'
      have hcb : algebraMap Ω (RatFunc Ω) b ≠ 0 := (map_ne_zero _).mpr hb
      rw [map_div₀, div_mul_eq_mul_div, eq_div_iff hcb, ← hf']
      ring
    have s4 : ∀ {K : Type u} [Field K] (A : ValuationSubring K) (x : K),
        A.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ A) := by
      intro K _ A x
      by_cases hx : x = 0
      · subst hx
        simp
      · have hpos : 0 < A.valuation x := (Valuation.pos_iff _).mpr hx
        rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_inv, inv_le_one₀ hpos]
        simp [hx]
    obtain ⟨T, hT⟩ : ∃ T : Subring (RatFunc Ω), ∀ f : RatFunc Ω, f ∈ T ↔
        ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ q.map W.subtype ≠ 0 ∧
          f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
            algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) := by
      refine ⟨{ carrier := {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
                  q.map W.subtype ≠ 0 ∧
                  f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
                    algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)}
                mul_mem' := ?_
                one_mem' := ?_
                add_mem' := ?_
                zero_mem' := ?_
                neg_mem' := ?_ }, fun f => Iff.rfl⟩
      · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
        have hq := s1 q₁ q₂ hq₁ hq₂
        refine ⟨p₁ * p₂, q₁ * q₂, hq, g0 _ hq, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_mul, map_mul, map_mul, ← h₁, ← h₂]
        ring
      · exact ⟨1, 1, ⟨0, by simp⟩, by simp, by simp⟩
      · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
        have hq := s1 q₁ q₂ hq₁ hq₂
        refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, hq, g0 _ hq, ?_⟩
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_mul, map_add,
          map_mul, map_mul, map_mul, ← h₁, ← h₂]
        ring
      · exact ⟨0, 1, ⟨0, by simp⟩, by simp, by simp⟩
      · rintro f ⟨p, q, hq, hq0, h⟩
        refine ⟨-p, q, hq, hq0, ?_⟩
        rw [Polynomial.map_neg, map_neg, ← h]
        ring
    have hmem : ∀ f : RatFunc Ω, f ∈ T ∨ f⁻¹ ∈ T := by
      intro f
      by_cases hf : f = 0
      · left
        rw [hf]
        exact T.zero_mem
      obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
      rcases W.mem_or_inv_mem a with h | h
      · left
        rw [hT]
        refine ⟨Polynomial.C ⟨a, h⟩ * N, D, hD, g0 _ hD, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_C, key]
        exact he
      · right
        rw [hT]
        refine ⟨Polynomial.C ⟨a⁻¹, h⟩ * D, N, hN, g0 _ hN, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_C, key]
        have hsub : W.subtype ⟨a⁻¹, h⟩ = a⁻¹ := rfl
        have hca : algebraMap Ω (RatFunc Ω) a ≠ 0 := (map_ne_zero _).mpr ha
        rw [hsub, map_inv₀]
        calc f⁻¹ * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)
            = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ * (algebraMap Ω (RatFunc Ω) a *
                algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)) := by
              rw [mul_assoc, inv_mul_cancel_left₀ hca]
          _ = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ *
                (f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype)) := by rw [he]
          _ = (algebraMap Ω (RatFunc Ω) a)⁻¹ *
                algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := by
              rw [mul_comm f⁻¹, mul_assoc, inv_mul_cancel_left₀ hf]
    obtain ⟨V, hVT, hVsub⟩ : ∃ V : ValuationSubring (RatFunc Ω), (∀ f, f ∈ V ↔ f ∈ T) ∧
        V.toSubring = T := ⟨{ T with mem_or_inv_mem' := hmem }, fun f => Iff.rfl, rfl⟩
    have hC2 : ∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W := by
      intro a
      rw [hVT, hT]
      constructor
      · rintro ⟨p, q, hq, -, h⟩
        rw [← key] at h
        have h2 := alg_inj h
        obtain ⟨i, hi⟩ := hq
        have h3 := congrArg (fun R => R.coeff i) h2
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map] at h3
        obtain ⟨w, hw⟩ := hi.exists_left_inv
        have h4 : a = W.subtype (p.coeff i) * W.subtype w := by
          rw [← h3, mul_assoc, ← map_mul, mul_comm (q.coeff i) w, hw, map_one, mul_one]
        rw [h4]
        exact (p.coeff i * w).2
      · intro h
        refine ⟨Polynomial.C ⟨a, h⟩, 1, ⟨0, by simp⟩, by simp, ?_⟩
        rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C]
        have h5 := key a 1
        rw [mul_one, map_one, mul_one] at h5
        exact h5.symm
    refine ⟨V, ?_, hC2, ?_, ?_⟩
    · rw [hVsub]
      unfold wcEbGauss
      apply le_antisymm
      · intro f hf
        exact Subring.subset_closure ((hT f).mp hf)
      · exact Subring.closure_le.mpr (fun f hf => (hT f).mpr hf)
    · intro a
      rw [s4 V, s4 W, map_eq_zero, ← map_inv₀, hC2]
    · intro f hf
      obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
      have hN0 : algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) ≠ 0 :=
        fun h => g0 N hN (alg_inj (h.trans (map_zero _).symm))
      have hD0 : algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) ≠ 0 :=
        fun h => g0 D hD (alg_inj (h.trans (map_zero _).symm))
      obtain ⟨g, hg⟩ : ∃ g : RatFunc Ω, g = algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) /
          algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := ⟨_, rfl⟩
      have hg0 : g ≠ 0 := by rw [hg]; exact div_ne_zero hN0 hD0
      have hgV : g ∈ V := by
        rw [hVT, hT]
        refine ⟨N, D, hD, g0 _ hD, ?_⟩
        rw [hg]
        exact div_mul_cancel₀ _ hD0
      have hgiV : g⁻¹ ∈ V := by
        rw [hVT, hT]
        refine ⟨D, N, hN, g0 _ hN, ?_⟩
        rw [hg, inv_div]
        exact div_mul_cancel₀ _ hN0
      refine ⟨a, ha, ⟨⟨g, hgV⟩, ⟨g⁻¹, hgiV⟩, Subtype.ext (mul_inv_cancel₀ hg0),
        Subtype.ext (inv_mul_cancel₀ hg0)⟩, ?_⟩
      show f = algebraMap Ω (RatFunc Ω) a * g
      rw [hg, mul_div_assoc', eq_div_iff hD0]
      exact he
  intro Ω _ _ W a c ha0 ham hcc
  obtain ⟨V, hV, hC, hCv, -⟩ := hG Ω W

  have key : ∀ (x : Ω) (R : Polynomial Ω),
      algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x * R) =
        algebraMap Ω (RatFunc Ω) x * algebraMap (Polynomial Ω) (RatFunc Ω) R := by
    intro x R
    rw [map_mul, Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply]
  have alg_inj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
    RatFunc.algebraMap_injective Ω
  have algC : ∀ x : Ω, algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x) =
      algebraMap Ω (RatFunc Ω) x := by
    intro x
    have h := key x 1
    rwa [mul_one, map_one, mul_one] at h
  have ratio : ∀ (x d : Ω), d ≠ 0 → W.valuation x ≤ W.valuation d → x / d ∈ W := by
    intro x d hd hle
    rw [div_eq_inv_mul, ← ValuationSubring.valuation_le_one_iff]
    calc W.valuation (d⁻¹ * x) = W.valuation d⁻¹ * W.valuation x := Valuation.map_mul _ _ _
      _ ≤ W.valuation d⁻¹ * W.valuation d := by gcongr
      _ = W.valuation (d⁻¹ * d) := (Valuation.map_mul _ _ _).symm
      _ = 1 := by rw [inv_mul_cancel₀ hd, Valuation.map_one]

  have liftW : ∀ q : Polynomial Ω, (∀ i, q.coeff i ∈ W) →
      ∃ q' : Polynomial ↥W, q'.map W.subtype = q := by
    intro q hq
    have hl : q ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨_, hq n⟩, rfl⟩
    exact (Polynomial.mem_lifts _).mp hl
  have memV : ∀ f : RatFunc Ω, (∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
        q.map W.subtype ≠ 0 ∧
        f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
          algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)) → f ∈ V := by
    intro f hf
    have h1 : f ∈ wcEbGauss W := Subring.subset_closure hf
    rw [← hV] at h1
    exact h1
  have hW1 : ∀ q : Polynomial Ω, (∀ i, q.coeff i ∈ W) →
      algebraMap (Polynomial Ω) (RatFunc Ω) q ∈ V := by
    intro q hq
    obtain ⟨q', hq'⟩ := liftW q hq
    apply memV
    refine ⟨q', 1, ⟨0, by simp⟩, by simp, ?_⟩
    rw [Polynomial.map_one, map_one, mul_one, hq']
  have hW2 : ∀ q : Polynomial Ω, (∀ i, q.coeff i ∈ W) → (∃ k, q.coeff k = 1) →
      (algebraMap (Polynomial Ω) (RatFunc Ω) q)⁻¹ ∈ V := by
    rintro q hq ⟨k, hk⟩
    obtain ⟨q', hq'⟩ := liftW q hq
    have hq0 : q ≠ 0 := by
      intro h
      rw [h, Polynomial.coeff_zero] at hk
      exact zero_ne_one hk
    have hA0 : algebraMap (Polynomial Ω) (RatFunc Ω) q ≠ 0 := by
      intro h
      apply hq0
      apply alg_inj
      rw [h, map_zero]
    apply memV
    refine ⟨1, q', ⟨k, ?_⟩, by rw [hq']; exact hq0, ?_⟩
    · have h1 : W.subtype (q'.coeff k) = 1 := by
        rw [← Polynomial.coeff_map, hq', hk]
      have h2 : q'.coeff k = 1 := Subtype.ext h1
      rw [h2]
      exact isUnit_one
    · rw [hq', Polynomial.map_one, map_one]
      exact inv_mul_cancel₀ hA0
  have hW3 : ∀ q : Polynomial Ω, algebraMap (Polynomial Ω) (RatFunc Ω) q ∈ V →
      ∀ i, q.coeff i ∈ W := by
    intro q hqV
    by_cases hq0 : q = 0
    · intro i
      rw [hq0, Polynomial.coeff_zero]
      exact W.zero_mem
    obtain ⟨k, hk, hmax⟩ := Finset.exists_max_image q.support
      (fun n => W.valuation (q.coeff n)) (Polynomial.support_nonempty.mpr hq0)
    have hd0 : q.coeff k ≠ 0 := Polynomial.mem_support_iff.mp hk
    have hcoef : ∀ n, q.coeff n / q.coeff k ∈ W := by
      intro n
      apply ratio _ _ hd0
      by_cases hn : q.coeff n = 0
      · rw [hn, Valuation.map_zero]
        exact zero_le'
      · exact hmax n (Polynomial.mem_support_iff.mpr hn)
    have hq₀ := hW2 (Polynomial.C (q.coeff k)⁻¹ * q)
      (fun n => by rw [Polynomial.coeff_C_mul, ← div_eq_inv_mul]; exact hcoef n)
      ⟨k, by rw [Polynomial.coeff_C_mul, inv_mul_cancel₀ hd0]⟩
    have hA0 : algebraMap (Polynomial Ω) (RatFunc Ω) q ≠ 0 := by
      intro h
      apply hq0
      apply alg_inj
      rw [h, map_zero]
    have hdV : algebraMap Ω (RatFunc Ω) (q.coeff k) ∈ V := by
      have e : algebraMap Ω (RatFunc Ω) (q.coeff k) =
          algebraMap (Polynomial Ω) (RatFunc Ω) q *
            (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C (q.coeff k)⁻¹ * q))⁻¹ := by
        rw [key, map_inv₀, mul_inv, inv_inv, mul_left_comm, mul_inv_cancel₀ hA0, mul_one]
      rw [e]
      exact mul_mem hqV hq₀
    have hdW : q.coeff k ∈ W := (hC _).mp hdV
    intro i
    have e2 : q.coeff i = q.coeff k * (q.coeff i / q.coeff k) := by
      rw [mul_div_cancel₀ _ hd0]
    rw [e2]
    exact mul_mem hdW (hcoef i)

  have ha0' : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hc0 : c ≠ 0 := by
    rintro rfl
    apply ha0'
    rw [← hcc, mul_zero]
  have hav : W.valuation (a : Ω) < 1 := (W.valuation_lt_one_iff a).mp ham
  have hcv : W.valuation c < 1 := by
    by_contra h
    push_neg at h
    have h2 : (1 : _) ≤ W.valuation c * W.valuation c := one_le_mul h h
    rw [← Valuation.map_mul, hcc] at h2
    exact absurd hav (not_lt.mpr h2)
  have hcW : c ∈ W := by
    rw [← ValuationSubring.valuation_le_one_iff]
    exact hcv.le

  have compne : ∀ p : Polynomial Ω, p ≠ 0 → p.comp (Polynomial.C c * Polynomial.X) ≠ 0 := by
    intro p hp h
    obtain ⟨n, hn⟩ := Polynomial.support_nonempty.mpr hp
    have h1 := congrArg (fun r => r.coeff n) h
    simp only [Polynomial.comp_C_mul_X_coeff, Polynomial.coeff_zero] at h1
    exact mul_ne_zero (Polynomial.mem_support_iff.mp hn) (pow_ne_zero n hc0) h1
  obtain ⟨τ, hτ⟩ : ∃ τ : RatFunc Ω →+* RatFunc Ω, ∀ p : Polynomial Ω,
      τ (algebraMap (Polynomial Ω) (RatFunc Ω) p) =
        algebraMap (Polynomial Ω) (RatFunc Ω) (p.comp (Polynomial.C c * Polynomial.X)) := by
    have hφ : nonZeroDivisors (Polynomial Ω) ≤
        (nonZeroDivisors (RatFunc Ω)).comap ((algebraMap (Polynomial Ω) (RatFunc Ω)).comp
          (Polynomial.compRingHom (Polynomial.C c * Polynomial.X))) := by
      intro p hp
      rw [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero]
      rw [mem_nonZeroDivisors_iff_ne_zero] at hp
      rw [RingHom.comp_apply, Polynomial.coe_compRingHom_apply]
      intro h
      exact compne p hp (alg_inj (h.trans (map_zero _).symm))
    refine ⟨RatFunc.liftRingHom _ hφ, fun p => ?_⟩
    rw [RatFunc.liftRingHom_algebraMap, RingHom.comp_apply, Polynomial.coe_compRingHom_apply]
  have τC : ∀ b : Ω, τ (algebraMap Ω (RatFunc Ω) b) = algebraMap Ω (RatFunc Ω) b := by
    intro b
    rw [← algC, hτ, Polynomial.C_comp]
  have τX : τ RatFunc.X = algebraMap Ω (RatFunc Ω) c * RatFunc.X := by
    rw [← RatFunc.algebraMap_X, hτ, Polynomial.X_comp, key]

  obtain ⟨S, hS⟩ : ∃ S : Polynomial Ω → Ω → Polynomial Ω, ∀ p d,
      S p d = Polynomial.C d⁻¹ * p.comp (Polynomial.C c * Polynomial.X) := ⟨_, fun _ _ => rfl⟩
  have coeffS : ∀ (p : Polynomial Ω) (d : Ω) (j : ℕ), (S p d).coeff j = p.coeff j * c ^ j / d := by
    intro p d j
    rw [hS, Polynomial.coeff_C_mul, Polynomial.comp_C_mul_X_coeff, div_eq_inv_mul]
  have star : ∀ (f : RatFunc Ω) (p q : Polynomial Ω) (d : Ω),
      f * algebraMap (Polynomial Ω) (RatFunc Ω) q = algebraMap (Polynomial Ω) (RatFunc Ω) p →
      τ f * algebraMap (Polynomial Ω) (RatFunc Ω) (S q d) =
        algebraMap (Polynomial Ω) (RatFunc Ω) (S p d) := by
    intro f p q d h
    have h2 := congrArg τ h
    rw [map_mul, hτ, hτ] at h2
    rw [hS, hS, key, key, ← h2]
    ring
  have inoc : ∀ f : RatFunc Ω, τ f ∈ V ↔ wcEbAnInOc W c f := by
    intro f
    constructor
    · intro hf
      have hden : f.denom ≠ 0 := RatFunc.denom_ne_zero f
      have hd0 : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 := by
        intro h
        apply hden
        apply alg_inj
        rw [h, map_zero]
      have hfq : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
          algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
        have hnd := RatFunc.num_div_denom f
        calc f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom
            = (algebraMap (Polynomial Ω) (RatFunc Ω) f.num /
                algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) *
                algebraMap (Polynomial Ω) (RatFunc Ω) f.denom := by rw [hnd]
          _ = algebraMap (Polynomial Ω) (RatFunc Ω) f.num := div_mul_cancel₀ _ hd0
      obtain ⟨i, hi, hmax⟩ := Finset.exists_max_image f.denom.support
        (fun n => W.valuation (f.denom.coeff n * c ^ n)) (Polynomial.support_nonempty.mpr hden)
      have hdi : f.denom.coeff i * c ^ i ≠ 0 :=
        mul_ne_zero (Polynomial.mem_support_iff.mp hi) (pow_ne_zero i hc0)
      have hqr : ∀ j, f.denom.coeff j * c ^ j / (f.denom.coeff i * c ^ i) ∈ W := by
        intro j
        apply ratio _ _ hdi
        by_cases hj : f.denom.coeff j = 0
        · rw [hj, zero_mul, Valuation.map_zero]
          exact zero_le'
        · exact hmax j (Polynomial.mem_support_iff.mpr hj)
      refine ⟨f.num, f.denom, i, hdi, hfq, hqr, ?_⟩
      have hq₀V := hW1 (S f.denom (f.denom.coeff i * c ^ i))
        (fun j => by rw [coeffS]; exact hqr j)
      have hp₀V : algebraMap (Polynomial Ω) (RatFunc Ω) (S f.num (f.denom.coeff i * c ^ i)) ∈ V := by
        rw [← star f f.num f.denom _ hfq]
        exact mul_mem hf hq₀V
      intro j
      have h3 := hW3 _ hp₀V j
      rwa [coeffS] at h3
    · rintro ⟨p, q, i, hd, hfq, hq, hp⟩
      have h := star f p q (q.coeff i * c ^ i) hfq
      have hq₀1 : (S q (q.coeff i * c ^ i)).coeff i = 1 := by
        rw [coeffS, div_self hd]
      have hq₀V := hW2 (S q (q.coeff i * c ^ i)) (fun j => by rw [coeffS]; exact hq j) ⟨i, hq₀1⟩
      have hp₀V := hW1 (S p (q.coeff i * c ^ i)) (fun j => by rw [coeffS]; exact hp j)
      have hne : algebraMap (Polynomial Ω) (RatFunc Ω) (S q (q.coeff i * c ^ i)) ≠ 0 := by
        intro h0
        have h1 := alg_inj (h0.trans (map_zero _).symm)
        rw [h1, Polynomial.coeff_zero] at hq₀1
        exact zero_ne_one hq₀1
      rw [(eq_div_iff hne).mpr h, div_eq_mul_inv]
      exact mul_mem hp₀V hq₀V

  have hXV : RatFunc.X ∈ V := by
    rw [← RatFunc.algebraMap_X]
    apply hW1
    intro i
    rw [Polynomial.coeff_X]
    split_ifs
    · exact W.one_mem
    · exact W.zero_mem
  have hXiV : (RatFunc.X : RatFunc Ω)⁻¹ ∈ V := by
    rw [← RatFunc.algebraMap_X]
    apply hW2
    · intro i
      rw [Polynomial.coeff_X]
      split_ifs
      · exact W.one_mem
      · exact W.zero_mem
    · exact ⟨1, Polynomial.coeff_X_one⟩
  have hcV : algebraMap Ω (RatFunc Ω) c ∈ V := (hC c).mpr hcW
  have hc0' : algebraMap Ω (RatFunc Ω) c ≠ 0 := (map_ne_zero _).mpr hc0
  have τaX : τ (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹) =
      algebraMap Ω (RatFunc Ω) c * RatFunc.X⁻¹ := by
    rw [map_mul, map_inv₀, τC, τX, ← hcc, map_mul, mul_inv, ← mul_assoc,
      mul_assoc (algebraMap Ω (RatFunc Ω) c) (algebraMap Ω (RatFunc Ω) c)
        (algebraMap Ω (RatFunc Ω) c)⁻¹, mul_inv_cancel₀ hc0', mul_one]

  have hRO : wcEbRing W a ≤ (V.comap τ).toSubring := by
    unfold wcEbRing
    rw [Subring.closure_le]
    rintro x (⟨w, rfl⟩ | hx)
    · show τ (algebraMap Ω (RatFunc Ω) (w : Ω)) ∈ V
      rw [τC]
      exact (hC _).mpr w.2
    · rcases hx with rfl | rfl
      · show τ RatFunc.X ∈ V
        rw [τX]
        exact mul_mem hcV hXV
      · show τ (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹) ∈ V
        rw [τaX]
        exact mul_mem hcV hXiV

  have vkey : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
      A.valuation y < 1 ↔ (y = 0 ∨ y⁻¹ ∉ A) := by
    intro F _ A y
    by_cases hy : y = 0
    · simp [hy]
    · simp only [hy, false_or]
      rw [← A.valuation_le_one_iff, map_inv₀, not_le]
      have hv : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      exact (one_lt_inv₀ (zero_lt_iff.mpr hv)).symm
  have hT : ∀ x : RatFunc Ω, (V.comap τ).valuation x < 1 ↔ V.valuation (τ x) < 1 := by
    intro x
    rw [vkey, vkey, map_eq_zero, ← map_inv₀, ValuationSubring.mem_comap]

  obtain ⟨I, hI⟩ : ∃ I : Ideal ↥(wcEbRing W a), ∀ r, r ∈ I ↔
      (V.comap τ).valuation (r : RatFunc Ω) < 1 := by
    refine ⟨{ carrier := {r | (V.comap τ).valuation (r : RatFunc Ω) < 1}
              add_mem' := ?_
              zero_mem' := ?_
              smul_mem' := ?_ }, fun r => Iff.rfl⟩
    · intro x y hx hy
      show (V.comap τ).valuation ((x : RatFunc Ω) + (y : RatFunc Ω)) < 1
      exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hx hy)
    · show (V.comap τ).valuation (0 : RatFunc Ω) < 1
      rw [Valuation.map_zero]
      exact zero_lt_one
    · intro r x hx
      show (V.comap τ).valuation ((r : RatFunc Ω) * (x : RatFunc Ω)) < 1
      have hr : (V.comap τ).valuation (r : RatFunc Ω) ≤ 1 := by
        rw [ValuationSubring.valuation_le_one_iff]
        exact hRO r.2
      rw [Valuation.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' hr) hx
  have hNI : wcEbNode W a ≤ I := by
    unfold wcEbNode
    apply sup_le
    · rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · rw [SetLike.mem_coe, hI, hT]
        show V.valuation (τ RatFunc.X) < 1
        rw [τX, Valuation.map_mul]
        have h1 : V.valuation RatFunc.X ≤ 1 := by
          rw [ValuationSubring.valuation_le_one_iff]
          exact hXV
        exact lt_of_le_of_lt (mul_le_of_le_one_right' h1) ((hCv c).mpr hcv)
      · rw [SetLike.mem_coe, hI, hT]
        show V.valuation (τ (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹)) < 1
        rw [τaX, Valuation.map_mul]
        have h1 : V.valuation (RatFunc.X : RatFunc Ω)⁻¹ ≤ 1 := by
          rw [ValuationSubring.valuation_le_one_iff]
          exact hXiV
        exact lt_of_le_of_lt (mul_le_of_le_one_right' h1) ((hCv c).mpr hcv)
    · rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, hI, hT]
      show V.valuation (τ (algebraMap Ω (RatFunc Ω) (m : Ω))) < 1
      rw [τC, hCv]
      exact (W.valuation_lt_one_iff m).mp hm

  have residue : ∀ r : ↥(wcEbRing W a), ∃ w : ↥W, r - wcEbW W a w ∈ wcEbNode W a := by
    rintro ⟨x, hx⟩
    refine Subring.closure_induction
      (s := (Set.range fun w : ↥W => algebraMap Ω (RatFunc Ω) (w : Ω)) ∪
        {RatFunc.X, algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹})
      (p := fun x hx => ∃ w : ↥W,
        (⟨x, hx⟩ : ↥(wcEbRing W a)) - wcEbW W a w ∈ wcEbNode W a) ?_ ?_ ?_ ?_ ?_ ?_ hx
    · intro x hxS
      rcases hxS with ⟨w, rfl⟩ | hx2
      · refine ⟨w, ?_⟩
        show wcEbW W a w - wcEbW W a w ∈ wcEbNode W a
        rw [sub_self]
        exact zero_mem _
      · rcases hx2 with rfl | rfl
        · refine ⟨0, ?_⟩
          rw [map_zero, sub_zero]
          unfold wcEbNode
          exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
        · refine ⟨0, ?_⟩
          rw [map_zero, sub_zero]
          unfold wcEbNode
          exact Ideal.mem_sup_left
            (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    · refine ⟨0, ?_⟩
      show (0 : ↥(wcEbRing W a)) - wcEbW W a 0 ∈ wcEbNode W a
      rw [map_zero, sub_zero]
      exact zero_mem _
    · refine ⟨1, ?_⟩
      show (1 : ↥(wcEbRing W a)) - wcEbW W a 1 ∈ wcEbNode W a
      rw [map_one, sub_self]
      exact zero_mem _
    · intro x y hx hy ihx ihy
      obtain ⟨w₁, h₁⟩ := ihx
      obtain ⟨w₂, h₂⟩ := ihy
      refine ⟨w₁ + w₂, ?_⟩
      show (⟨x, hx⟩ + ⟨y, hy⟩ : ↥(wcEbRing W a)) - wcEbW W a (w₁ + w₂) ∈ wcEbNode W a
      have e : (⟨x, hx⟩ + ⟨y, hy⟩ : ↥(wcEbRing W a)) - wcEbW W a (w₁ + w₂) =
          ((⟨x, hx⟩ : ↥(wcEbRing W a)) - wcEbW W a w₁) +
            ((⟨y, hy⟩ : ↥(wcEbRing W a)) - wcEbW W a w₂) := by
        rw [map_add]
        ring
      rw [e]
      exact add_mem h₁ h₂
    · intro x hx ih
      obtain ⟨w, h⟩ := ih
      refine ⟨-w, ?_⟩
      show -(⟨x, hx⟩ : ↥(wcEbRing W a)) - wcEbW W a (-w) ∈ wcEbNode W a
      have e : -(⟨x, hx⟩ : ↥(wcEbRing W a)) - wcEbW W a (-w) =
          -((⟨x, hx⟩ : ↥(wcEbRing W a)) - wcEbW W a w) := by
        rw [map_neg]
        ring
      rw [e]
      exact neg_mem h
    · intro x y hx hy ihx ihy
      obtain ⟨w₁, h₁⟩ := ihx
      obtain ⟨w₂, h₂⟩ := ihy
      refine ⟨w₁ * w₂, ?_⟩
      show (⟨x, hx⟩ * ⟨y, hy⟩ : ↥(wcEbRing W a)) - wcEbW W a (w₁ * w₂) ∈ wcEbNode W a
      have e : (⟨x, hx⟩ * ⟨y, hy⟩ : ↥(wcEbRing W a)) - wcEbW W a (w₁ * w₂) =
          ((⟨x, hx⟩ : ↥(wcEbRing W a)) - wcEbW W a w₁) * ⟨y, hy⟩ +
            wcEbW W a w₁ * ((⟨y, hy⟩ : ↥(wcEbRing W a)) - wcEbW W a w₂) := by
        rw [map_mul]
        ring
      rw [e]
      exact add_mem (Ideal.mul_mem_right _ _ h₁) (Ideal.mul_mem_left _ _ h₂)

  refine ⟨V.comap τ, fun f => by rw [ValuationSubring.mem_comap]; exact inoc f, hRO, ?_⟩
  intro r
  constructor
  · intro hr
    obtain ⟨w, hw⟩ := residue r
    have hrI : r ∈ I := (hI r).mpr hr
    have hwI : wcEbW W a w ∈ I := by
      have h1 := I.sub_mem hrI (hNI hw)
      rwa [sub_sub_cancel] at h1
    rw [hI, hT] at hwI
    have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := by
      have h2 : V.valuation (τ (algebraMap Ω (RatFunc Ω) (w : Ω))) < 1 := hwI
      rw [τC, hCv] at h2
      exact (W.valuation_lt_one_iff w).mpr h2
    have hwN : wcEbW W a w ∈ wcEbNode W a := by
      unfold wcEbNode
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hwm)
    have h3 := (wcEbNode W a).add_mem hw hwN
    rwa [sub_add_cancel] at h3
  · intro hr
    exact (hI r).mp (hNI hr)

theorem wcpa_dj_lr1k_eb_an_finite_centres : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] (R : Subring K) (O : ValuationSubring K), R ≤ O.toSubring →
    letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
    ∃ (n : ℕ) (𝔮 : Fin n → Ideal ↥(integralClosure ↥R L)), (∀ j, (𝔮 j).IsPrime) ∧
      (∀ j, ∃ V' : ValuationSubring L, V'.comap (algebraMap K L) = O ∧
        ∀ s : ↥(integralClosure ↥R L), s ∈ 𝔮 j ↔ V'.valuation (s : L) < 1) ∧
      (∀ V' : ValuationSubring L, V'.comap (algebraMap K L) = O →
        ∃ j, ∀ s : ↥(integralClosure ↥R L), s ∈ 𝔮 j ↔ V'.valuation (s : L) < 1) :=
by
  intro K L _ _ _ _ R O hRO
  letI : Algebra ↥R L := ((algebraMap K L).comp R.subtype).toAlgebra
  classical
  have key : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
      A.valuation y < 1 ↔ (y = 0 ∨ y⁻¹ ∉ A) := by
    intro F _ A y
    by_cases hy : y = 0
    · simp [hy]
    · simp only [hy, false_or]
      rw [← A.valuation_le_one_iff, map_inv₀, not_le]
      have hv : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      exact (one_lt_inv₀ (zero_lt_iff.mpr hv)).symm
  have transfer : ∀ (V' : ValuationSubring L),
      V'.comap (algebraMap K L) = O → ∀ x : K,
      V'.valuation (algebraMap K L x) < 1 ↔ O.valuation x < 1 := by
    intro V' hV' x
    rw [key, key, map_eq_zero, ← map_inv₀, ← hV']
    rfl

  have c1 : ∀ V' : ValuationSubring L, V'.comap (algebraMap K L) = O →
      ∃ P : Ideal ↥(integralClosure ↥R L), P.IsPrime ∧
        ∀ s : ↥(integralClosure ↥R L), s ∈ P ↔ V'.valuation (s : L) < 1 := by
    intro V' hV'
    have hR : ∀ r : R, ((algebraMap K L).comp R.subtype) r ∈ V' := by
      intro r
      have : (r : K) ∈ V'.comap (algebraMap K L) := by rw [hV']; exact hRO r.2
      exact this
    have hS : ∀ s : ↥(integralClosure ↥R L), (s : L) ∈ V' := by
      intro s
      obtain ⟨p, hpm, hp⟩ := s.2
      let ψ : R →+* V' := ((algebraMap K L).comp R.subtype).codRestrict V' hR
      have hcomp : (algebraMap V' L).comp ψ = algebraMap R L := by ext; rfl
      have hint : _root_.IsIntegral V' (s : L) :=
        ⟨p.map ψ, hpm.map ψ, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
      rw [← hy]; exact y.2
    let φ : ↥(integralClosure ↥R L) →+* V' :=
      ((integralClosure ↥R L).val.toRingHom).codRestrict V' hS
    refine ⟨Ideal.comap φ (IsLocalRing.maximalIdeal V'), Ideal.IsPrime.comap φ, ?_⟩
    intro s
    rw [Ideal.mem_comap, ValuationSubring.valuation_lt_one_iff]
    rfl

  have c2 : ∀ (m : ℕ) (V : Fin m → ValuationSubring L)
      (P : Fin m → Ideal ↥(integralClosure ↥R L)),
      (∀ t, (V t).comap (algebraMap K L) = O) → (∀ t, (P t).IsPrime) →
      (∀ t (s : ↥(integralClosure ↥R L)), s ∈ P t ↔ (V t).valuation (s : L) < 1) →
      Function.Injective P → ∃ e : Fin m → L, (∀ t, ¬ (V t).valuation (e t) < 1) ∧
        ∀ t u, t ≠ u → (V u).valuation (e t) < 1 := by
    intro m V P hV hP hmem hinj
    have hcon : ∀ t u, (P t).comap (algebraMap ↥R ↥(integralClosure ↥R L)) =
        (P u).comap (algebraMap ↥R ↥(integralClosure ↥R L)) := by
      intro t u
      ext r
      rw [Ideal.mem_comap, Ideal.mem_comap, hmem, hmem]
      show (V t).valuation (algebraMap K L (r : K)) < 1 ↔
        (V u).valuation (algebraMap K L (r : K)) < 1
      rw [transfer _ (hV t), transfer _ (hV u)]
    have hinc : ∀ t u, t ≠ u → ¬ (P u ≤ P t) := by
      intro t u htu hle
      have hlt : P u < P t := lt_of_le_of_ne hle (fun h => htu (hinj h).symm)
      haveI := hP u
      have := Ideal.IsIntegral.comap_lt_comap (R := ↥R) hlt
      have h2 : Ideal.under (↥R) (P u) = Ideal.under (↥R) (P t) := hcon u t
      rw [h2] at this
      exact lt_irrefl _ this
    have hx : ∀ t u, t ≠ u → ∃ x, x ∈ P u ∧ x ∉ P t := by
      intro t u htu
      exact SetLike.not_le_iff_exists.mp (hinc t u htu)
    choose x hxu hxt using hx
    let y : Fin m → Fin m → ↥(integralClosure ↥R L) :=
      fun t u => if h : t = u then 1 else x t u h
    refine ⟨fun t => ((∏ u ∈ Finset.univ.erase t, y t u : ↥(integralClosure ↥R L)) : L),
      ?_, ?_⟩
    · intro t hlt
      have h1 := (hmem t _).mpr hlt
      haveI := hP t
      obtain ⟨u, hu, hyu⟩ := Ideal.IsPrime.prod_mem_iff.mp h1
      have hut : t ≠ u := fun h => Finset.ne_of_mem_erase hu h.symm
      have : y t u = x t u hut := dif_neg hut
      rw [this] at hyu
      exact hxt t u hut hyu
    · intro t u htu
      apply (hmem u _).mp
      have hu : u ∈ Finset.univ.erase t :=
        Finset.mem_erase.mpr ⟨fun h => htu h.symm, Finset.mem_univ _⟩
      have : y t u = x t u htu := dif_neg htu
      exact Ideal.prod_mem (P u) hu (by rw [this]; exact hxu t u htu)

  have c3 : ∀ (m : ℕ) (V : Fin m → ValuationSubring L) (e : Fin m → L),
      (∀ t, (V t).comap (algebraMap K L) = O) → (∀ t, ¬ (V t).valuation (e t) < 1) →
      (∀ t u, t ≠ u → (V u).valuation (e t) < 1) → m ≤ Module.finrank K L := by
    intro m V e hV hself hsep
    have hli : LinearIndependent K e := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      by_contra hne
      push_neg at hne
      obtain ⟨i₀, hi₀⟩ := hne
      obtain ⟨k, -, hk⟩ := Finset.exists_max_image Finset.univ (fun t => O.valuation (g t))
        ⟨i₀, Finset.mem_univ _⟩
      have hgk : g k ≠ 0 := by
        intro h0
        have := hk i₀ (Finset.mem_univ _)
        rw [h0, map_zero] at this
        exact hi₀ ((Valuation.zero_iff _).mp (le_antisymm this zero_le'))
      have hd : ∀ t, algebraMap K L (g t / g k) ∈ V k := by
        intro t
        have hmem : g t / g k ∈ O := by
          rw [← O.valuation_le_one_iff, map_div₀]
          exact div_le_one_of_le₀ (hk t (Finset.mem_univ _)) zero_le'
        have : g t / g k ∈ (V k).comap (algebraMap K L) := by rw [hV k]; exact hmem
        exact this
      have hrel : ∑ t, algebraMap K L (g t / g k) * e t = 0 := by
        have : ∑ t, algebraMap K L (g t / g k) * e t =
            algebraMap K L (g k)⁻¹ * ∑ t, g t • e t := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun t _ => ?_)
          rw [Algebra.smul_def, div_eq_mul_inv, map_mul]
          ring
        rw [this, hg, mul_zero]
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ k), div_self hgk, map_one,
        one_mul] at hrel
      have hek : e k = -∑ t ∈ Finset.univ.erase k, algebraMap K L (g t / g k) * e t :=
        eq_neg_of_add_eq_zero_left hrel
      apply hself k
      rw [hek, Valuation.map_neg]
      apply Valuation.map_sum_lt _ one_ne_zero
      intro t ht
      rw [Valuation.map_mul]
      exact lt_of_le_of_lt
        (mul_le_of_le_one_left' (((V k).valuation_le_one_iff _).mpr (hd t)))
        (hsep t k (Finset.ne_of_mem_erase ht))
    have := hli.fintype_card_le_finrank
    simpa using this

  set C : Set (Ideal ↥(integralClosure ↥R L)) := {I | ∃ V' : ValuationSubring L,
    V'.comap (algebraMap K L) = O ∧
      ∀ s : ↥(integralClosure ↥R L), s ∈ I ↔ V'.valuation (s : L) < 1} with hC
  have hprimeC : ∀ I ∈ C, I.IsPrime := by
    rintro I ⟨V', hV', hI⟩
    obtain ⟨P, hP, hPm⟩ := c1 V' hV'
    have : I = P := Ideal.ext (fun s => (hI s).trans (hPm s).symm)
    rw [this]; exact hP
  have hCfin : C.Finite := by
    by_contra hinf
    obtain ⟨T, hTC, hTcard⟩ :=
      Set.Infinite.exists_subset_card_eq hinf (Module.finrank K L + 1)
    let E := T.equivFin
    let P : Fin T.card → Ideal ↥(integralClosure ↥R L) := fun j => (E.symm j : Ideal _)
    have hPC : ∀ j, P j ∈ C := fun j => hTC (E.symm j).2
    choose V hV hVm using hPC
    have hPinj : Function.Injective P := by
      intro a b hab
      exact E.symm.injective (Subtype.ext hab)
    obtain ⟨e, he1, he2⟩ :=
      c2 T.card V P hV (fun j => hprimeC _ ⟨V j, hV j, hVm j⟩) hVm hPinj
    have := c3 T.card V e hV he1 he2
    omega
  let F := hCfin.toFinset
  let E := F.equivFin
  refine ⟨F.card, fun j => (E.symm j : Ideal _), ?_, ?_, ?_⟩
  · intro j
    exact hprimeC _ (hCfin.mem_toFinset.mp (E.symm j).2)
  · intro j
    exact hCfin.mem_toFinset.mp (E.symm j).2
  · intro V' hV'
    obtain ⟨P, hP, hPm⟩ := c1 V' hV'
    have hPC : P ∈ C := ⟨V', hV', hPm⟩
    refine ⟨E ⟨P, hCfin.mem_toFinset.mpr hPC⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hPm

theorem wcpa_dj_lr1k_eb_mono_branch_select : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∃ θ : ↥W, θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W ∧
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → (θ : Ω) / (a : Ω) ∈ W →
      ∀ c : Ω, c * c = (a : Ω) →
      ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f) →
      ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O →
      ∃ b : Fin m, V'.valuation (u b - 1) < 1 ∧
        V'.valuation (η b) ^ e b = V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) ∧
        ∀ b', b' ≠ b → V'.valuation (η b') = 1 :=
by

  have wcpa_dj_lr1k_eb_mono_bs_limit_valuation : ∀ (L : Type u) [Field L] (I : Type u)
      [Nonempty I] (B : I → Set (ValuationSubring L)),
      (∀ i j : I, ∃ k : I, B k ⊆ B i ∧ B k ⊆ B j) → (∀ i : I, (B i).Nonempty) →
      ∃ U : ValuationSubring L, ∀ (i : I) (T : Finset L), ∃ V ∈ B i, ∀ x ∈ T,
        (x ∈ V ↔ x ∈ U) := by
    intro L _ I _ B hdir hne
    classical
    let C : Set (L → Bool) := {g | g 0 = true ∧ g 1 = true ∧
      (∀ x y, g x = true → g y = true → g (x + y) = true) ∧
      (∀ x y, g x = true → g y = true → g (x * y) = true) ∧
      (∀ x, g x = true → g (-x) = true) ∧ (∀ x, g x = true ∨ g x⁻¹ = true)}
    have key : ∀ (x y z : L) (p : Bool → Bool → Bool → Prop),
        IsClosed {g : L → Bool | p (g x) (g y) (g z)} := by
      intro x y z p
      have hc : Continuous (fun g : L → Bool => ((g x, g y, g z) : Bool × Bool × Bool)) := by
        fun_prop
      exact IsClosed.preimage hc
        (isClosed_discrete ({t : Bool × Bool × Bool | p t.1 t.2.1 t.2.2}))
    have hC : IsClosed C := by
      have e : C = {g : L → Bool | g 0 = true} ∩ ({g : L → Bool | g 1 = true} ∩
          ((⋂ x : L, ⋂ y : L, {g : L → Bool | g x = true → g y = true → g (x + y) = true}) ∩
          ((⋂ x : L, ⋂ y : L, {g : L → Bool | g x = true → g y = true → g (x * y) = true}) ∩
          ((⋂ x : L, {g : L → Bool | g x = true → g (-x) = true}) ∩
          (⋂ x : L, {g : L → Bool | g x = true ∨ g x⁻¹ = true}))))) := by
        ext g
        simp only [C, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
      rw [e]
      refine IsClosed.inter (key 0 0 0 (fun a _ _ => a = true)) (IsClosed.inter
        (key 1 1 1 (fun a _ _ => a = true)) (IsClosed.inter ?_ (IsClosed.inter ?_
        (IsClosed.inter ?_ ?_))))
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          key x y (x + y) (fun a b c => a = true → b = true → c = true)
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          key x y (x * y) (fun a b c => a = true → b = true → c = true)
      · exact isClosed_iInter fun x => key x x (-x) (fun a _ c => a = true → c = true)
      · exact isClosed_iInter fun x => key x x x⁻¹ (fun a _ c => a = true ∨ c = true)
    let χ : ValuationSubring L → (L → Bool) := fun V x => decide (x ∈ V)
    have hχ : ∀ V, χ V ∈ C := by
      intro W'
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
      · simp [χ, W'.zero_mem]
      · simp [χ, W'.one_mem]
      · intro x y hx hy
        simp only [χ, decide_eq_true_eq] at hx hy ⊢
        exact W'.add_mem _ _ hx hy
      · intro x y hx hy
        simp only [χ, decide_eq_true_eq] at hx hy ⊢
        exact W'.mul_mem _ _ hx hy
      · intro x hx
        simp only [χ, decide_eq_true_eq] at hx ⊢
        exact W'.neg_mem _ hx
      · intro x
        simp only [χ, decide_eq_true_eq]
        exact W'.mem_or_inv_mem x
    let S : I → Set (L → Bool) := fun i => closure (χ '' B i)
    have hSdir : Directed (· ⊇ ·) S := by
      intro i j
      obtain ⟨k, hki, hkj⟩ := hdir i j
      exact ⟨k, closure_mono (Set.image_mono hki), closure_mono (Set.image_mono hkj)⟩
    have hSne : ∀ i, (S i).Nonempty := by
      intro i
      obtain ⟨V, hV⟩ := hne i
