  · apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range b)
    rintro x ⟨i, rfl⟩
    exact hb i
  · apply IsFractionRing.of_field
    intro z
    obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples
      (nonZeroDivisors (Polynomial k)) (Finset.univ : Finset s) (fun i => b.repr z i)
    choose a ha using fun i => hd i (Finset.mem_univ i)
