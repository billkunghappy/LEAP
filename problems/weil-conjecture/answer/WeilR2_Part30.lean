  obtain ⟨e, he⟩ := s7 _ _ rb ψ.range hE₀ (fun K _ j x => by
    by_cases halg : ∃ P : Polynomial K, P ≠ 0 ∧ P.eval₂ (rb.comp j) x = 0
    · exact s5 _ _ K rb j hroot x halg
    · push_neg at halg
      exact s6 _ _ K rb j hrbs hunit x halg)
  refine ⟨e, fun a w hw => ?_⟩
  rw [← hrb, hw, he]

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_ua_dn_hensel_section : ∀ (A κ' K₁ : Type u) [CommRing A] [Field κ'] [Field K₁] (ρb : A →+* κ'), Function.Surjective ρb → (∀ a : A, ρb a = 0 → IsNilpotent a) → ∀ (ψ : K₁ →+* A) (θb : κ'), (∀ y : κ', ∃ P : Polynomial K₁, y = P.eval₂ (ρb.comp ψ) θb) → (∃ P : Polynomial K₁, P.eval₂ (ρb.comp ψ) θb = 0 ∧ P.derivative.eval₂ (ρb.comp ψ) θb ≠ 0) → ∃ σ : κ' →+* A, (∀ y : κ', ρb (σ y) = y) ∧ ∀ c : K₁, σ (ρb (ψ c)) = ψ c :=
by
  intro A κ' K₁ _ _ _ ρb hsurj hnil ψ θb hgen hsep
  obtain ⟨P, hP0, hP1⟩ := hsep
  have unit_lift : ∀ a : A, ρb a ≠ 0 → IsUnit a := by
    intro a ha
    obtain ⟨b, hb⟩ := hsurj (ρb a)⁻¹
    have hn : IsNilpotent (a * b - 1) :=
      hnil _ (by rw [map_sub, map_mul, hb, mul_inv_cancel₀ ha, map_one, sub_self])
    have hu : IsUnit (a * b) := by
      have := hn.isUnit_one_add
      rwa [add_sub_cancel] at this
    exact isUnit_of_mul_isUnit_left hu
  have nil_zero : ∀ z : A, IsNilpotent z → ρb z = 0 := fun z hz => (hz.map ρb).eq_zero
  have hPne : P ≠ 0 := by
    rintro rfl
    simp at hP1
  obtain ⟨x, hx⟩ := hsurj θb
  have hhom : ∀ (Q : Polynomial K₁) (z : A),
      ρb (Q.eval₂ ψ z) = Q.eval₂ (ρb.comp ψ) (ρb z) := fun Q z => Polynomial.hom_eval₂ Q ψ ρb z
  obtain ⟨r, hr1, hr2⟩ : ∃ r : A, IsNilpotent (x - r) ∧ P.eval₂ ψ r = 0 := by
    letI : Algebra K₁ A := ψ.toAlgebra
    have h1 : IsNilpotent (Polynomial.aeval x P) := by
      apply hnil
      rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra, hhom, hx, hP0]
    have h2 : IsUnit (Polynomial.aeval x (Polynomial.derivative P)) := by
      apply unit_lift
      rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra, hhom, hx]
      exact hP1
    obtain ⟨r, ⟨hr1, hr2⟩, -⟩ := Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero h1 h2
    refine ⟨r, hr1, ?_⟩
    rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra] at hr2
    exact hr2
  have hρr : ρb r = θb := by
    have := nil_zero _ hr1
    rw [map_sub, sub_eq_zero] at this
    rw [← this, hx]
  have star : ∀ Q : Polynomial K₁, ρb (Q.eval₂ ψ r) = Q.eval₂ (ρb.comp ψ) θb := by
