    have hv : V'.valuation ((1 + j : ↥R) : M) = 1 := by
      show V'.valuation (1 + (j : M)) = 1
      exact Valuation.map_one_add_of_lt _ ((hJmem j).1 hj)
    have hne : ((1 + j : ↥R) : M) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hv; exact zero_ne_one hv
    have hinvR : ((1 + j : ↥R) : M)⁻¹ ∈ R := by
      rw [hRmem]
      refine ⟨?_, fun σ hσ => ?_⟩
      · rw [← V'.valuation_le_one_iff, map_inv₀, hv, inv_one]
      · rw [map_inv₀, ((hRmem _).1 (1 + j).2).2 σ hσ]
    refine isUnit_iff_exists_inv.2 ⟨⟨_, hinvR⟩, ?_⟩
    apply Subtype.ext
    show ((1 + j : ↥R) : M) * ((1 + j : ↥R) : M)⁻¹ = 1
    exact mul_inv_cancel₀ hne

  obtain ⟨r, g, hg, hgen⟩ := wcpa_dj_lr1k_nis_poly_closure_fg Ω W hW M H'
  obtain ⟨hgV, hgenV⟩ := wcpa_dj_lr1k_nis_localize_to_gauss Ω W V hV M
    (fun x => ∀ τ ∈ H', τ x = x)
    (fun f x hx τ hτ => by rw [map_mul, AlgEquiv.commutes, hx τ hτ]) r g
    (fun i => (hg i).1) (fun x hx hfix => hgen x hx hfix)
  have hιR : ∀ c : RatFunc Ω, c ∈ V → algebraMap (RatFunc Ω) M c ∈ R := by
    intro c hc
    rw [hRmem]
    refine ⟨?_, fun σ _ => σ.commutes c⟩
    rw [← hV'] at hc
    exact hc

  obtain ⟨b, hbint, hb1, hbσ⟩ := wcpa_dj_lr1k_nis_unit_at_center (RatFunc Ω) V M V' hV'
  have hbv : V'.valuation b = 1 := by
    have e : b = 1 + (b - 1) := by ring
    rw [e]; exact Valuation.map_one_add_of_lt _ hb1
  haveI : Fintype ↥H := Fintype.ofFinite _

  have hrep : ∀ y ∈ V', (∀ τ ∈ H', τ y = y) →
      ∃ c : Fin r → M, (∀ l, c l ∈ R) ∧ y = ∑ l, c l * g l := by
    intro y hy hyfix
    obtain ⟨k, hk⟩ := wcpa_dj_lr1k_nis_pole_kill Ω W hW V hV M V' hV' hE1 b hbint hb1 hbσ y hy
    obtain ⟨t, ht⟩ : ∃ t : M, t = ∏ σ : ↥H, (σ : M ≃ₐ[RatFunc Ω] M) (b ^ k) := ⟨_, rfl⟩
    have hbk1 : V'.valuation (b ^ k) = 1 := by rw [map_pow, hbv, one_pow]
    have htv : V'.valuation t = 1 := by
      rw [ht, map_prod]
      exact Finset.prod_eq_one (fun σ _ => hval1 σ σ.2 _ hbk1)
    have ht0 : t ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at htv; exact zero_ne_one htv
    have htfix : ∀ ρ ∈ H, ρ t = t := by
      intro ρ hρ
      rw [ht, map_prod]
      exact Fintype.prod_equiv (Equiv.mulLeft (⟨ρ, hρ⟩ : ↥H)) _ _ (fun σ => by
        simp only [Equiv.coe_mulLeft, Subgroup.coe_mul, AlgEquiv.mul_apply])
    have hσint : ∀ σ : M ≃ₐ[RatFunc Ω] M, IsIntegral V (σ (b ^ k)) := by
      intro σ
      rw [hconj]
      intro ρ
      rw [← AlgEquiv.mul_apply]
      exact (hconj (b ^ k)).1 (hbint.pow k) (ρ * σ)
    have hxint : IsIntegral V (t * y) := by
      rw [ht, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ (1 : ↥H))]
      have e1 : ((1 : ↥H) : M ≃ₐ[RatFunc Ω] M) (b ^ k) = b ^ k := rfl
      rw [e1, mul_right_comm]
      refine hk.mul ?_
      refine Finset.prod_induction _ (fun z => IsIntegral V z) (fun a c ha hc => ha.mul hc)
        isIntegral_one (fun σ _ => hσint σ)
    have hxfix : ∀ τ ∈ H', τ (t * y) = t * y := by
      intro τ hτ
      rw [map_mul, htfix τ (hH'H hτ), hyfix τ hτ]
    obtain ⟨c, hc⟩ := hgenV (t * y) hxint hxfix
    refine ⟨fun l => t⁻¹ * algebraMap (RatFunc Ω) M (c l : RatFunc Ω), fun l => ?_, ?_⟩
    · refine R.mul_mem ?_ (hιR _ (c l).2)
      rw [hRmem]
      refine ⟨?_, fun σ hσ => by rw [map_inv₀, htfix σ hσ]⟩
      rw [← V'.valuation_le_one_iff, map_inv₀, htv, inv_one]
    · calc y = t⁻¹ * (t * y) := by rw [inv_mul_cancel_left₀ ht0]
        _ = _ := by rw [hc, Finset.mul_sum]; simp only [mul_assoc]

  have hgR : ∀ i, g i ∈ R := by
    apply wcpa_dj_lr1k_nis_nakayama M R J hJunit r g
    intro i
    have hgi : g i ∈ V' := by simpa using (hconj (g i)).1 (hgV i) 1
    obtain ⟨z, hzV, hzfix, hz⟩ := hcon (g i) hgi (hg i).2
    have hzR : z ∈ R := (hRmem z).2 ⟨hzV, hzfix⟩
    by_cases hδ : g i - z = 0
    · refine ⟨⟨z, hzR⟩, fun _ => 0, fun _ => J.zero_mem, ?_⟩
      show g i = z + ∑ l : Fin r, ((0 : ↥R) : M) * g l
      have h0 : ((0 : ↥R) : M) = 0 := rfl
      rw [h0]
      simp only [zero_mul, Finset.sum_const_zero, add_zero]
      exact sub_eq_zero.1 hδ
    · obtain ⟨d, hd0, u, hu⟩ := hE1 _ hδ
      have hιd0 : algebraMap (RatFunc Ω) M d ≠ 0 := (map_ne_zero _).2 hd0
      have hufix : ∀ τ ∈ H', τ (u : M) = u := by
        intro τ hτ
        have h1 : τ (g i - z) = g i - z := by
          rw [map_sub, (hg i).2 τ hτ, hzfix τ (hH'H hτ)]
        rw [hu, map_mul, AlgEquiv.commutes] at h1
        exact mul_left_cancel₀ hιd0 h1
      obtain ⟨c', hc'R, hc'⟩ := hrep u u.val.2 hufix
      have huv : V'.valuation (u : M) = 1 := V'.valuation_unit u
      have hdv : V'.valuation (algebraMap (RatFunc Ω) M d) < 1 := by
        have h2 := hz
        rw [hu, Valuation.map_mul, huv, mul_one] at h2
        exact h2
      have hdV : algebraMap (RatFunc Ω) M d ∈ V' := (V'.valuation_le_one_iff _).1 hdv.le
      have hdR : algebraMap (RatFunc Ω) M d ∈ R := (hRmem _).2 ⟨hdV, fun σ _ => σ.commutes d⟩
      refine ⟨⟨z, hzR⟩, fun l => ⟨algebraMap (RatFunc Ω) M d * c' l, R.mul_mem hdR (hc'R l)⟩,
        fun l => ?_, ?_⟩
      · rw [hJmem]
        show V'.valuation (algebraMap (RatFunc Ω) M d * c' l) < 1
        rw [Valuation.map_mul]
        have hc'v : V'.valuation (c' l) ≤ 1 :=
          (V'.valuation_le_one_iff _).2 ((hRmem _).1 (hc'R l)).1
        exact lt_of_le_of_lt (mul_le_of_le_one_right' hc'v) hdv
      · show g i = z + ∑ l, algebraMap (RatFunc Ω) M d * c' l * g l
        calc g i = z + (g i - z) := by ring
          _ = z + algebraMap (RatFunc Ω) M d * ∑ l, c' l * g l := by rw [hu, ← hc']
          _ = _ := by rw [Finset.mul_sum]; simp only [mul_assoc]

  have hstar : ∀ y ∈ V', (∀ τ ∈ H', τ y = y) → ∀ σ ∈ H, σ y = y := by
    intro y hy hyfix
    obtain ⟨c, hcR, hc⟩ := hrep y hy hyfix
    have hyR : y ∈ R := by
      rw [hc]; exact R.sum_mem (fun l _ => R.mul_mem (hcR l) (hgR l))
    exact ((hRmem y).1 hyR).2

  have hex : ∃ x : M, (∀ τ ∈ H', τ x = x) ∧ ¬ ∀ σ ∈ H, σ x = x := by
    by_contra hno
    push_neg at hno
    have hle : IntermediateField.fixedField H' ≤ IntermediateField.fixedField H := by
      intro x hx
      rw [IntermediateField.mem_fixedField_iff] at hx ⊢
      exact hno x hx
    rw [IntermediateField.le_iff_le, IntermediateField.fixingSubgroup_fixedField] at hle
    have h1 := Subgroup.card_le_of_le hle
    rw [hcard] at h1
    have h2 : 0 < Nat.card H' := Nat.card_pos
    have h3 := hp.two_le
    nlinarith
  obtain ⟨x, hxfix, hxnot⟩ := hex
  apply hxnot
  intro σ hσ
  by_cases hx0 : x = 0
  · rw [hx0, map_zero]
  obtain ⟨d, hd0, u, hu⟩ := hE1 x hx0
  have hιd0 : algebraMap (RatFunc Ω) M d ≠ 0 := (map_ne_zero _).2 hd0
  have hufix : ∀ τ ∈ H', τ (u : M) = u := by
    intro τ hτ
    have h1 := hxfix τ hτ
    rw [hu, map_mul, AlgEquiv.commutes] at h1
    exact mul_left_cancel₀ hιd0 h1
  rw [hu, map_mul, AlgEquiv.commutes, hstar _ u.val.2 hufix σ hσ]

theorem wcpa_dj_lr1k_lrd_insep_step : ∀ (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] (V' : ValuationSubring M) (H H' : Subgroup (M ≃ₐ[K] M)) (p : ℕ), p.Prime → V'.valuation (p : M) < 1 → H' ≤ H → (∃ s : ℕ, Nat.card H = p ^ s) → (∀ σ ∈ H, ∀ x : M, σ x ∈ V' ↔ x ∈ V') → (∀ σ ∈ H, ∀ y ∈ V', V'.valuation (σ y - y) < 1) → ∀ y : M, y ∈ V' → (∀ τ ∈ H', τ y = y) → (∀ z : M, z ∈ V' → (∀ σ ∈ H, σ z = z) → ¬ V'.valuation (y - z) < 1) → ∃ x : Fin p → M, (∀ i, x i ∈ V' ∧ ∀ τ ∈ H', τ (x i) = x i) ∧ ∀ c : Fin p → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ H, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * x i) = 1 :=
by
  intro K _ M _ _ _ V' H H' p hp hpV hH'H hHs hHpres hHtriv y hyV hyfix hynew
  classical
  obtain ⟨s, hs⟩ := hHs

  have s1 : ∀ (k : Type u) [Field k] [CharP k p] (E : Subfield k) (x : k), x ∉ E →
      x ^ (p ^ s) ∈ E → ∀ a : Fin p → k, (∀ i, a i ∈ E) → (∃ i, a i ≠ 0) →
      ∑ i, a i * x ^ (i : ℕ) ≠ 0 := by
    intro k _ _ E x hx hxs a ha hne hsum
    haveI : Fact p.Prime := ⟨hp⟩
    have hcoe : ∀ v : E, algebraMap E k v = v := fun _ => rfl
    set e : E := ⟨x ^ (p ^ s), hxs⟩ with he
    have hps : 0 < p ^ s := pow_pos hp.pos s
    have hf : (Polynomial.X ^ (p ^ s) - Polynomial.C e : Polynomial E).Monic :=
      Polynomial.monic_X_pow_sub_C e hps.ne'
    have hfx : Polynomial.aeval x (Polynomial.X ^ (p ^ s) - Polynomial.C e : Polynomial E) = 0 := by
      rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hcoe, sub_self]
    have hint : IsIntegral E x := ⟨_, hf, hfx⟩
    have hμm : (minpoly E x).Monic := minpoly.monic hint
    have hdvd : minpoly E x ∣ Polynomial.X ^ (p ^ s) - Polynomial.C e := minpoly.dvd E x hfx
    have hmapf : (Polynomial.X ^ (p ^ s) - Polynomial.C e : Polynomial E).map (algebraMap E k)
        = (Polynomial.X - Polynomial.C x) ^ (p ^ s) := by
      rw [sub_pow_char_pow, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
        Polynomial.map_C, hcoe, Polynomial.C_pow]
    have hdvd2 : (minpoly E x).map (algebraMap E k) ∣ (Polynomial.X - Polynomial.C x) ^ (p ^ s) :=
      hmapf ▸ Polynomial.map_dvd (algebraMap E k) hdvd
    obtain ⟨i, hi, hassoc⟩ := (dvd_prime_pow (Polynomial.prime_X_sub_C x) _).1 hdvd2
    have heq : (minpoly E x).map (algebraMap E k) = (Polynomial.X - Polynomial.C x) ^ i :=
      Polynomial.eq_of_monic_of_associated (hμm.map _) ((Polynomial.monic_X_sub_C x).pow i) hassoc
    have hdeg : (minpoly E x).natDegree = i := by
      have := congrArg Polynomial.natDegree heq
      rwa [hμm.natDegree_map, Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C,
        mul_one] at this
    have hipos : 0 < i := hdeg ▸ minpoly.natDegree_pos hint
    have hnc : ((minpoly E x).map (algebraMap E k)).nextCoeff
        = algebraMap E k (minpoly E x).nextCoeff :=
      Polynomial.nextCoeff_map (algebraMap E k).injective _
    have hnc2 : ((Polynomial.X - Polynomial.C x) ^ i).nextCoeff = i • (-x) := by
      rw [(Polynomial.monic_X_sub_C x).nextCoeff_pow, Polynomial.nextCoeff_X_sub_C]
    have hix : (i : k) * x ∈ E := by
      have h1 : algebraMap E k (minpoly E x).nextCoeff ∈ E := ((minpoly E x).nextCoeff).2
      rw [← hnc, heq, hnc2, nsmul_eq_mul] at h1
      have h2 := E.neg_mem h1
      simpa using h2
    have hpi : p ≤ i := by
      by_contra hlt
      push_neg at hlt
      have hnd : ¬ p ∣ i := Nat.not_dvd_of_pos_of_lt hipos hlt
      have hi0 : (i : k) ≠ 0 := by
        rw [ne_eq, CharP.cast_eq_zero_iff k p]; exact hnd
      apply hx
      have : x = (i : k)⁻¹ * ((i : k) * x) := by field_simp
      rw [this]
      exact E.mul_mem (E.inv_mem (natCast_mem E i)) hix
    obtain ⟨i₀, hi₀⟩ := hne
    set g : Polynomial E := ∑ j : Fin p, Polynomial.C (⟨a j, ha j⟩ : E) * Polynomial.X ^ (j : ℕ)
      with hg
    have hgx : Polynomial.aeval x g = 0 := by
      rw [← hsum, hg, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, hcoe]
    have hgc : g.coeff i₀ = ⟨a i₀, ha i₀⟩ := by
      rw [hg, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow, Fin.val_inj]
      simp
    have hg0 : g ≠ 0 := by
      intro h
      rw [h, Polynomial.coeff_zero] at hgc
      apply hi₀
      have := congrArg Subtype.val hgc
      simpa using this.symm
    have h1 := minpoly.degree_le_of_ne_zero E x hg0 hgx
    have h2 : g.degree < p := Polynomial.degree_sum_fin_lt _
    rw [Polynomial.degree_eq_natDegree hμm.ne_zero, hdeg] at h1
    have h3 := lt_of_le_of_lt h1 h2
    have h4 : i < p := by exact_mod_cast h3
    omega

  have hres : ∀ a b : V', V'.valuation ((a : M) - b) < 1 →
      IsLocalRing.residue V' a = IsLocalRing.residue V' b := by
    intro a b h
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact (ValuationSubring.valuation_lt_one_iff V' _).2 (by simpa using h)
  have hres' : ∀ a b : V', IsLocalRing.residue V' a = IsLocalRing.residue V' b →
      V'.valuation ((a : M) - b) < 1 := by
    intro a b h
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff] at h
    simpa using (ValuationSubring.valuation_lt_one_iff V' _).1 h

  haveI hchar : CharP (IsLocalRing.ResidueField V') p := by
    rw [CharP.charP_iff_prime_eq_zero hp]
    have h1 : IsLocalRing.residue V' (p : V') = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff]
      exact (ValuationSubring.valuation_lt_one_iff V' _).2 (by simpa using hpV)
    rwa [map_natCast] at h1

  obtain ⟨E, hE⟩ : ∃ E : Subfield (IsLocalRing.ResidueField V'), ∀ e, e ∈ E ↔
      ∃ z : V', (∀ σ ∈ H, σ (z : M) = z) ∧ IsLocalRing.residue V' z = e := by
    refine ⟨{ carrier := {e | ∃ z : V', (∀ σ ∈ H, σ (z : M) = z) ∧ IsLocalRing.residue V' z = e}
              zero_mem' := ⟨0, fun σ _ => by simp, map_zero _⟩
              one_mem' := ⟨1, fun σ _ => by simp, map_one _⟩
              add_mem' := ?_
              mul_mem' := ?_
              neg_mem' := ?_
              inv_mem' := ?_ }, fun e => Iff.rfl⟩
    · rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
      exact ⟨a * b, fun σ hσ => by simp [ha σ hσ, hb σ hσ], map_mul _ _ _⟩
    · rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
      exact ⟨a + b, fun σ hσ => by simp [ha σ hσ, hb σ hσ], map_add _ _ _⟩
    · rintro _ ⟨a, ha, rfl⟩
      exact ⟨-a, fun σ hσ => by simp [ha σ hσ], map_neg _ _⟩
    · rintro _ ⟨a, ha, rfl⟩
      by_cases h0 : IsLocalRing.residue V' a = 0
      · exact ⟨0, fun σ _ => by simp, by rw [h0, inv_zero, map_zero]⟩
      · have hu : IsUnit a := (IsLocalRing.residue_ne_zero_iff_isUnit a).1 h0
        have e1 : ((hu.unit⁻¹ : V'ˣ) : V') * a = 1 := by
          have := hu.unit.inv_mul
          rwa [hu.unit_spec] at this
        have e2 : (((hu.unit⁻¹ : V'ˣ) : V') : M) = (a : M)⁻¹ := by
          apply eq_inv_of_mul_eq_one_left
          have := congrArg V'.subtype e1
          rwa [map_mul, map_one] at this
        refine ⟨((hu.unit⁻¹ : V'ˣ) : V'), fun σ hσ => ?_, ?_⟩
        · rw [e2, map_inv₀, ha σ hσ]
        · apply eq_inv_of_mul_eq_one_left
          rw [← map_mul, e1, map_one]

  have hHfin : Finite H := Nat.finite_of_card_ne_zero (by rw [hs]; exact pow_ne_zero _ hp.ne_zero)
  letI : Fintype H := Fintype.ofFinite H
  set yV : V' := ⟨y, hyV⟩ with hyVdef
  set Nv : V' := ∏ σ : H, (⟨(σ : M ≃ₐ[K] M) y, (hHpres σ σ.2 y).2 hyV⟩ : V') with hNv
  have hNcoe : (Nv : M) = ∏ σ : H, (σ : M ≃ₐ[K] M) y := map_prod V'.subtype _ _
  have hNfix : ∀ ρ ∈ H, ρ (Nv : M) = Nv := by
    intro ρ hρ
    rw [hNcoe, map_prod]
    exact Fintype.prod_equiv (Equiv.mulLeft ⟨ρ, hρ⟩) _ _ (fun σ => rfl)
  have hNres : IsLocalRing.residue V' Nv = IsLocalRing.residue V' yV ^ (p ^ s) := by
    rw [hNv, map_prod]
    have : ∀ σ : H, IsLocalRing.residue V'
        (⟨(σ : M ≃ₐ[K] M) y, (hHpres σ σ.2 y).2 hyV⟩ : V') = IsLocalRing.residue V' yV :=
      fun σ => hres _ _ (hHtriv σ σ.2 y hyV)
    rw [Finset.prod_congr rfl (fun σ _ => this σ), Finset.prod_const, Finset.card_univ,
      Fintype.card_eq_nat_card, hs]

  have hyE1 : IsLocalRing.residue V' yV ^ (p ^ s) ∈ E := (hE _).2 ⟨Nv, hNfix, hNres⟩
  have hyE2 : IsLocalRing.residue V' yV ∉ E := by
    intro h
    obtain ⟨z, hz, hzr⟩ := (hE _).1 h
    exact hynew z z.2 hz (hres' yV z hzr.symm)

  refine ⟨fun i => y ^ (i : ℕ), fun i => ⟨V'.pow_mem hyV _, fun τ hτ => by
    simp only [map_pow, hyfix τ hτ]⟩, ?_⟩

  intro c hc hcfix ⟨i₀, hi₀⟩
  set cc : Fin p → V' := fun i => ⟨c i, hc i⟩ with hcc
  have haE : ∀ i, IsLocalRing.residue V' (cc i) ∈ E := fun i => (hE _).2 ⟨cc i, hcfix i, rfl⟩
  have ha0 : IsLocalRing.residue V' (cc i₀) ≠ 0 := by
    rw [IsLocalRing.residue_ne_zero_iff_isUnit]
    exact (ValuationSubring.valuation_eq_one_iff V' (cc i₀)).2 hi₀
  have hne := s1 _ E _ hyE2 hyE1 (fun i => IsLocalRing.residue V' (cc i)) haE ⟨i₀, ha0⟩
  set S : V' := ∑ i, cc i * yV ^ (i : ℕ) with hS
  have hSres : IsLocalRing.residue V' S
      = ∑ i, IsLocalRing.residue V' (cc i) * IsLocalRing.residue V' yV ^ (i : ℕ) := by
    rw [hS, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow]
  have hSunit : IsUnit S := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hSres]
    exact hne
  have hScoe : (S : M) = ∑ i, c i * y ^ (i : ℕ) := by
    rw [show (S : M) = V'.subtype S from rfl, hS, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow]
    rfl
  show V'.valuation (∑ i, c i * y ^ (i : ℕ)) = 1
  rw [← hScoe]
  exact (ValuationSubring.valuation_eq_one_iff V' S).1 hSunit

theorem wcpa_dj_lr1k_lrd_ri_tower : ∀ (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] (V' : ValuationSubring M) (H J : Subgroup (M ≃ₐ[K] M)) (a b : ℕ) (x : Fin a → M) (y : Fin b → M), J ≤ H → (∀ i, x i ∈ V' ∧ ∀ τ ∈ J, τ (x i) = x i) → (∀ c : Fin a → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ H, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * x i) = 1) → (∀ i, y i ∈ V') → (∀ c : Fin b → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ J, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * y i) = 1) → ∃ z : Fin (a * b) → M, (∀ i, z i ∈ V') ∧ ∀ c : Fin (a * b) → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ H, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * z i) = 1 :=
by
  intro K _ M _ _ V' H J a b x y hJH hx hxri hy hyri
  classical
  let e : Fin a × Fin b ≃ Fin (a * b) := finProdFinEquiv
  refine ⟨fun k => x (e.symm k).1 * y (e.symm k).2, fun k => mul_mem (hx _).1 (hy _), ?_⟩
  intro c hc hcH hcu
  have hsum : ∑ k, c k * (x (e.symm k).1 * y (e.symm k).2)
      = ∑ j : Fin b, (∑ i : Fin a, c (e (i, j)) * x i) * y j := by
    rw [← Equiv.sum_comp e (fun k => c k * (x (e.symm k).1 * y (e.symm k).2))]
    simp only [Equiv.symm_apply_apply]
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    ring
  show V'.valuation (∑ k, c k * (x (e.symm k).1 * y (e.symm k).2)) = 1
  rw [hsum]
  apply hyri (fun j => ∑ i : Fin a, c (e (i, j)) * x i)
  · intro j
    exact sum_mem (fun i _ => mul_mem (hc _) (hx i).1)
  · intro j σ hσ
    simp only [map_sum, map_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hcH _ σ (hJH hσ), (hx i).2 σ hσ]
  · obtain ⟨k0, hk0⟩ := hcu
    refine ⟨(e.symm k0).2, ?_⟩
    apply hxri (fun i => c (e (i, (e.symm k0).2)))
    · intro i; exact hc _
    · intro i σ hσ; exact hcH _ σ hσ
    · refine ⟨(e.symm k0).1, ?_⟩
      show V'.valuation (c (e ((e.symm k0).1, (e.symm k0).2))) = 1
      rw [Prod.mk.eta, Equiv.apply_symm_apply]
      exact hk0

theorem wcpa_dj_lr1k_lrd_inertia_faithful : ∀ (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] (V' : ValuationSubring M) (σ : M ≃ₐ[K] M), (∀ x : M, σ x ∈ V' ↔ x ∈ V') → (∀ y ∈ V', (∀ τ : M ≃ₐ[K] M, (∀ x : M, τ x ∈ V' ↔ x ∈ V') → (∀ z ∈ V', V'.valuation (τ z - z) < 1) → τ y = y) → V'.valuation (σ y - y) < 1) → ∀ y ∈ V', V'.valuation (σ y - y) < 1 :=
by
  intro K _ M _ _ _ V' σ hσ H y hy
  classical
  let Inert : (M ≃ₐ[K] M) → Prop := fun τ =>
    (∀ x : M, τ x ∈ V' ↔ x ∈ V') ∧ ∀ z ∈ V', V'.valuation (τ z - z) < 1
  set I : Finset (M ≃ₐ[K] M) := Finset.univ.filter Inert with hIdef
  have hmemI : ∀ τ, τ ∈ I ↔ Inert τ := fun τ => by simp [hIdef]
  have h1 : (1 : M ≃ₐ[K] M) ∈ I := by
    rw [hmemI]
    refine ⟨fun x => Iff.rfl, fun z _ => ?_⟩
    rw [AlgEquiv.one_apply, sub_self, Valuation.map_zero]
    exact zero_lt_one
  have hmul : ∀ τ₁ ∈ I, ∀ τ₂ ∈ I, τ₁ * τ₂ ∈ I := by
    intro τ₁ h₁ τ₂ h₂
    rw [hmemI] at h₁ h₂ ⊢
    refine ⟨fun x => (h₁.1 (τ₂ x)).trans (h₂.1 x), fun z hz => ?_⟩
    have e : (τ₁ * τ₂) z - z = (τ₁ (τ₂ z) - τ₂ z) + (τ₂ z - z) := by
      rw [AlgEquiv.mul_apply]; ring
    rw [e]
    exact Valuation.map_add_lt _ (h₁.2 _ ((h₂.1 z).2 hz)) (h₂.2 z hz)
  set P : Polynomial M := ∏ τ ∈ I, (Polynomial.X - Polynomial.C (τ y)) with hP

  have hcoeff : ∀ n, P.coeff n ∈ V' := by
    have hl : P ∈ Polynomial.lifts V'.subtype := by
      apply Subsemiring.prod_mem
      intro τ hτ
      have hτy : τ y ∈ V' := (((hmemI τ).1 hτ).1 y).2 hy
      refine ⟨Polynomial.X - Polynomial.C ⟨τ y, hτy⟩, ?_⟩
      simp
    intro n
    obtain ⟨a, ha⟩ := (Polynomial.lifts_iff_coeff_lifts P).1 hl n
    rw [← ha]
    exact a.2

  have hfix : ∀ ρ ∈ I, P.map (ρ : M →+* M) = P := by
    intro ρ hρ
    have hinj : Function.Injective (fun τ : M ≃ₐ[K] M => ρ * τ) :=
      fun a b h => mul_left_cancel h
    have himg : I.image (fun τ => ρ * τ) = I := by
      apply Finset.eq_of_subset_of_card_le
      · intro x hx
        obtain ⟨τ, hτ, rfl⟩ := Finset.mem_image.1 hx
        exact hmul ρ hρ τ hτ
      · rw [Finset.card_image_of_injective _ hinj]
    rw [hP, Polynomial.map_prod]
    conv_rhs => rw [← himg]
    rw [Finset.prod_image (fun a _ b _ h => hinj h)]
    refine Finset.prod_congr rfl (fun τ _ => ?_)
    simp [AlgEquiv.mul_apply]

  have hc : ∀ n, V'.valuation (σ (P.coeff n) - P.coeff n) < 1 := by
    intro n
    apply H _ (hcoeff n)
    intro τ hτs hτv
    have hτ : τ ∈ I := (hmemI τ).2 ⟨hτs, hτv⟩
    have := congrArg (fun p => Polynomial.coeff p n) (hfix τ hτ)
    simpa [Polynomial.coeff_map] using this
  have hPy : P.eval y = 0 := by
    rw [hP, Polynomial.eval_prod]
    apply Finset.prod_eq_zero h1
    simp
  have hPσ : (P.map (σ : M →+* M)).eval (σ y) = 0 := by
    have e : σ y = (σ : M →+* M) y := rfl
    rw [e, Polynomial.eval_map, Polynomial.eval₂_at_apply, hPy, map_zero]
  have hσy : σ y ∈ V' := (hσ y).2 hy
  have hsmall : V'.valuation (P.eval (σ y)) < 1 := by
    have key : P.eval (σ y) = (P - P.map (σ : M →+* M)).eval (σ y) := by
      rw [Polynomial.eval_sub, hPσ, sub_zero]
    rw [key, Polynomial.eval_eq_sum_range]
    apply Valuation.map_sum_lt _ one_ne_zero
    intro i _
    rw [Polynomial.coeff_sub, Polynomial.coeff_map, map_mul, map_pow]
    have h1 : V'.valuation (P.coeff i - (σ : M →+* M) (P.coeff i)) < 1 := by
      rw [Valuation.map_sub_swap]; exact hc i
    have h2 : V'.valuation (σ y) ^ i ≤ 1 :=
      pow_le_one₀ zero_le' ((V'.valuation_le_one_iff _).2 hσy)
    exact lt_of_le_of_lt (mul_le_of_le_one_right' h2) h1
  have hprod : P.eval (σ y) = ∏ τ ∈ I, (σ y - τ y) := by
    rw [hP, Polynomial.eval_prod]
    simp
  obtain ⟨τ, hτ, hτsmall⟩ : ∃ τ ∈ I, V'.valuation (σ y - τ y) < 1 := by
    by_contra hne
    push_neg at hne
    have hone : V'.valuation (P.eval (σ y)) = 1 := by
      rw [hprod, map_prod]
      apply Finset.prod_eq_one
      intro τ hτ
      have hτy : τ y ∈ V' := (((hmemI τ).1 hτ).1 y).2 hy
      exact le_antisymm ((V'.valuation_le_one_iff _).2 (sub_mem hσy hτy)) (hne τ hτ)
    rw [hone] at hsmall
    exact lt_irrefl _ hsmall
  have e : σ y - y = (σ y - τ y) + (τ y - y) := by ring
  rw [e]
  exact Valuation.map_add_lt _ hτsmall (((hmemI τ).1 hτ).2 y hy)

theorem wcpa_dj_lr1k_lrd_artin_residue_count : ∀ (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] (V' : ValuationSubring M) (D J : Subgroup (M ≃ₐ[K] M)), J ≤ D → (∀ σ ∈ D, ∀ τ ∈ J, σ * τ * σ⁻¹ ∈ J) → (∀ σ ∈ D, ∀ x : M, σ x ∈ V' ↔ x ∈ V') → (∀ τ ∈ J, ∀ y ∈ V', V'.valuation (τ y - y) < 1) → (∀ σ ∈ D, (∀ y ∈ V', (∀ τ ∈ J, τ y = y) → V'.valuation (σ y - y) < 1) → σ ∈ J) → ∃ x : Fin (J.relIndex D) → M, (∀ i, x i ∈ V' ∧ ∀ τ ∈ J, τ (x i) = x i) ∧ ∀ c : Fin (J.relIndex D) → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ D, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * x i) = 1 :=
by
  intro K _ M _ _ _ V' D J hJD hnorm hpres htriv hfaith
  classical
  have hpresV : ∀ σ ∈ D, ∀ y : V', (σ : M ≃ₐ[K] M) (y : M) ∈ V' :=
    fun σ hσ y => (hpres σ hσ y).2 y.2
  letI act : MulSemiringAction D V' :=
    { smul := fun g y => ⟨(g : M ≃ₐ[K] M) y, hpresV g g.2 y⟩
      one_smul := fun y => Subtype.ext rfl
      mul_smul := fun g h y => Subtype.ext rfl
      smul_zero := fun g => Subtype.ext (map_zero (g : M ≃ₐ[K] M))
      smul_add := fun g x y => Subtype.ext (map_add (g : M ≃ₐ[K] M) _ _)
      smul_one := fun g => Subtype.ext (map_one (g : M ≃ₐ[K] M))
      smul_mul := fun g x y => Subtype.ext (map_mul (g : M ≃ₐ[K] M) _ _) }

  have hres_eq : ∀ y z : V', IsLocalRing.residue V' y = IsLocalRing.residue V' z ↔
      V'.valuation ((y : M) - z) < 1 := by
    intro y z
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff,
      ValuationSubring.valuation_lt_one_iff]
    rfl
  have hres_ne : ∀ y : V', IsLocalRing.residue V' y ≠ 0 ↔ V'.valuation (y : M) = 1 := by
    intro y
    rw [Ne, IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff]
    constructor
    · intro h; exact le_antisymm (V'.valuation_le_one y) (not_lt.mp h)
    · intro h; rw [h]; exact lt_irrefl _

  let E : Subfield (IsLocalRing.ResidueField V') :=
    { carrier := {a | ∃ y : V', (∀ τ ∈ J, τ (y : M) = y) ∧ IsLocalRing.residue V' y = a}
      mul_mem' := by
        rintro _ _ ⟨y, hy, rfl⟩ ⟨z, hz, rfl⟩
        refine ⟨y * z, fun τ hτ => ?_, map_mul _ y z⟩
        show τ ((y : M) * z) = (y : M) * z
        rw [map_mul, hy τ hτ, hz τ hτ]
      one_mem' := ⟨1, fun τ _ => map_one τ, map_one _⟩
      add_mem' := by
        rintro _ _ ⟨y, hy, rfl⟩ ⟨z, hz, rfl⟩
        refine ⟨y + z, fun τ hτ => ?_, map_add _ y z⟩
        show τ ((y : M) + z) = (y : M) + z
        rw [map_add, hy τ hτ, hz τ hτ]
      zero_mem' := ⟨0, fun τ _ => map_zero τ, map_zero _⟩
      neg_mem' := by
        rintro _ ⟨y, hy, rfl⟩
        refine ⟨-y, fun τ hτ => ?_, map_neg _ y⟩
        show τ (-(y : M)) = -(y : M)
        rw [map_neg, hy τ hτ]
      inv_mem' := by
        rintro _ ⟨y, hy, rfl⟩
        by_cases h0 : IsLocalRing.residue V' y = 0
        · refine ⟨0, fun τ _ => map_zero τ, ?_⟩
          rw [h0, inv_zero, map_zero]
        · have hu : IsUnit y := (IsLocalRing.residue_ne_zero_iff_isUnit y).mp h0
          have h1 : ((hu.unit⁻¹ : V'ˣ) : V') * y = 1 := by
            have := hu.unit.inv_mul
            rwa [hu.unit_spec] at this
          have h1M : (((hu.unit⁻¹ : V'ˣ) : V') : M) * (y : M) = 1 := congrArg Subtype.val h1
          have e : (((hu.unit⁻¹ : V'ˣ) : V') : M) = (y : M)⁻¹ := eq_inv_of_mul_eq_one_left h1M
          refine ⟨((hu.unit⁻¹ : V'ˣ) : V'), fun τ hτ => ?_, ?_⟩
          · rw [e, map_inv₀, hy τ hτ]
          · apply eq_inv_of_mul_eq_one_left
            rw [← map_mul, h1, map_one] }
  have hstab : ∀ (g : D) (a : IsLocalRing.ResidueField V'), a ∈ E → g • a ∈ E := by
    rintro g _ ⟨y, hy, rfl⟩
    refine ⟨g • y, fun τ hτ => ?_, by rw [IsLocalRing.ResidueField.residue_smul]⟩
    show τ ((g : M ≃ₐ[K] M) y) = (g : M ≃ₐ[K] M) y
    have h1 : (g : M ≃ₐ[K] M)⁻¹ * τ * (g : M ≃ₐ[K] M) ∈ J := by
      simpa using hnorm (g : M ≃ₐ[K] M)⁻¹ (inv_mem g.2) τ hτ
    have h2 := hy _ h1
    have h3 : (g : M ≃ₐ[K] M) (((g : M ≃ₐ[K] M)⁻¹ * τ * (g : M ≃ₐ[K] M)) (y : M)) =
        τ ((g : M ≃ₐ[K] M) y) := by
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply]
      exact AlgEquiv.apply_symm_apply _ _
    rw [← h3, h2]
  let Ψ : D →* (E ≃+* E) :=
    { toFun := fun g =>
        { toFun := fun a => ⟨g • (a : IsLocalRing.ResidueField V'), hstab g a a.2⟩
          invFun := fun a => ⟨g⁻¹ • (a : IsLocalRing.ResidueField V'), hstab g⁻¹ a a.2⟩
          left_inv := fun a => Subtype.ext (inv_smul_smul g (a : IsLocalRing.ResidueField V'))
          right_inv := fun a => Subtype.ext (smul_inv_smul g (a : IsLocalRing.ResidueField V'))
          map_mul' := fun a b => Subtype.ext (smul_mul' g (a : IsLocalRing.ResidueField V') b)
          map_add' := fun a b => Subtype.ext (smul_add g (a : IsLocalRing.ResidueField V') b) }
      map_one' := by
        apply RingEquiv.ext; intro a; apply Subtype.ext
        exact one_smul D (a : IsLocalRing.ResidueField V')
      map_mul' := fun g h => by
        apply RingEquiv.ext; intro a; apply Subtype.ext
        exact mul_smul g h (a : IsLocalRing.ResidueField V') }
  have hker : Ψ.ker = J.subgroupOf D := by
    ext g
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    constructor
    · intro h
      apply hfaith g g.2
      intro y hy hyfix
      have hmem : IsLocalRing.residue V' ⟨y, hy⟩ ∈ E := ⟨⟨y, hy⟩, hyfix, rfl⟩
      have h1 := congrArg (fun f : E ≃+* E => ((f ⟨_, hmem⟩ : E) : IsLocalRing.ResidueField V')) h
      change g • IsLocalRing.residue V' ⟨y, hy⟩ = IsLocalRing.residue V' ⟨y, hy⟩ at h1
      rw [← IsLocalRing.ResidueField.residue_smul, hres_eq] at h1
      exact h1
    · intro hg
      apply RingEquiv.ext; intro a; apply Subtype.ext
      obtain ⟨y, hy, hya⟩ := a.2
      change g • (a : IsLocalRing.ResidueField V') = (a : IsLocalRing.ResidueField V')
      rw [← hya, ← IsLocalRing.ResidueField.residue_smul, hres_eq]
      exact htriv g hg y y.2
  haveI : Finite Ψ.range := Finite.of_surjective _ Ψ.rangeRestrict_surjective
  letI : Fintype Ψ.range := Fintype.ofFinite _
  have hfr : Module.finrank (FixedPoints.subfield Ψ.range E) E = J.relIndex D := by
    rw [FixedPoints.finrank_eq_card, ← Nat.card_eq_fintype_card]
    rw [← Subgroup.index_ker, hker]
    rfl
  let bb := Module.finBasisOfFinrankEq (FixedPoints.subfield Ψ.range E) E hfr
  choose xV hxfix hxres using fun i => (bb i : E).2
  refine ⟨fun i => (xV i : M), fun i => ⟨(xV i).2, hxfix i⟩, ?_⟩
  rintro c hcV hcfix ⟨i₀, hi₀⟩
  let cV : Fin (J.relIndex D) → V' := fun i => ⟨c i, hcV i⟩
  have hcE : ∀ i, IsLocalRing.residue V' (cV i) ∈ E :=
    fun i => ⟨cV i, fun τ hτ => hcfix i τ (hJD hτ), rfl⟩
  have hfixF : ∀ i, (⟨IsLocalRing.residue V' (cV i), hcE i⟩ : E) ∈
      FixedPoints.subfield Ψ.range E := by
    intro i m
    obtain ⟨g, hg⟩ := MonoidHom.mem_range.mp m.2
    rw [Subgroup.smul_def, RingAut.smul_def, ← hg]
    apply Subtype.ext
    change g • IsLocalRing.residue V' (cV i) = IsLocalRing.residue V' (cV i)
    rw [← IsLocalRing.ResidueField.residue_smul]
    congr 1
    exact Subtype.ext (hcfix i g g.2)
  let cF : Fin (J.relIndex D) → FixedPoints.subfield Ψ.range E := fun i => ⟨_, hfixF i⟩
  have hsum0 : IsLocalRing.residue V' (∑ i, cV i * xV i) ≠ 0 := by
    intro h0
    have h1 : (∑ i, cF i • bb i) = 0 := by
      apply Subtype.ext
      change E.subtype (∑ i, cF i • bb i) = 0
      rw [map_sum, ← h0, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, hxres i]
      rfl
    have h2 := (Fintype.linearIndependent_iff.mp bb.linearIndependent) cF h1 i₀
    have h3 : IsLocalRing.residue V' (cV i₀) = 0 := by
      have := congrArg (fun z : FixedPoints.subfield Ψ.range E =>
        ((z : E) : IsLocalRing.ResidueField V')) h2
      exact this
    exact (hres_ne (cV i₀)).mpr hi₀ h3
  have hs : ((∑ i, cV i * xV i : V') : M) = ∑ i, c i * (xV i : M) := by
    show V'.subtype (∑ i, cV i * xV i) = _
    rw [map_sum]
    rfl
  have := (hres_ne _).mp hsum0
  rw [hs] at this
  exact this

theorem wcpa_dj_lr1k_lrd_pgroup_induction : ∀ (K : Type u) [Field K] (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] (V' : ValuationSubring M) (I : Subgroup (M ≃ₐ[K] M)) (p : ℕ), p.Prime → (∃ r : ℕ, Nat.card I = p ^ r) → (∀ H H' : Subgroup (M ≃ₐ[K] M), H ≤ I → H' ≤ H → (∀ σ ∈ H, ∀ τ ∈ H', σ * τ * σ⁻¹ ∈ H') → Nat.card H = p * Nat.card H' → ∃ x : Fin p → M, (∀ i, x i ∈ V' ∧ ∀ τ ∈ H', τ (x i) = x i) ∧ ∀ c : Fin p → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ H, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * x i) = 1) → ∃ y : Fin (Nat.card I) → M, (∀ i, y i ∈ V') ∧ ∀ c : Fin (Nat.card I) → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ I, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * y i) = 1 :=
by
  intro K _ M _ _ _ V' I p hp hIp hstep
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  have tower : ∀ (H J : Subgroup (M ≃ₐ[K] M)) (a b : ℕ) (x : Fin a → M) (y : Fin b → M),
      J ≤ H → (∀ i, x i ∈ V' ∧ ∀ τ ∈ J, τ (x i) = x i) →
      (∀ c : Fin a → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ H, σ (c i) = c i) →
        (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * x i) = 1) →
      (∀ i, y i ∈ V') →
      (∀ c : Fin b → M, (∀ i, c i ∈ V') → (∀ i, ∀ σ ∈ J, σ (c i) = c i) →
        (∃ i, V'.valuation (c i) = 1) → V'.valuation (∑ i, c i * y i) = 1) →
      ∃ z : Fin (a * b) → M, (∀ i, z i ∈ V') ∧ ∀ c : Fin (a * b) → M, (∀ i, c i ∈ V') →
        (∀ i, ∀ σ ∈ H, σ (c i) = c i) → (∃ i, V'.valuation (c i) = 1) →
        V'.valuation (∑ i, c i * z i) = 1 := by
    intro H J a b x y hJH hx hxri hy hyri
    let e : Fin a × Fin b ≃ Fin (a * b) := finProdFinEquiv
    refine ⟨fun k => x (e.symm k).1 * y (e.symm k).2, fun k => mul_mem (hx _).1 (hy _), ?_⟩
    intro c hc hcH hcu
    have hsum : ∑ k, c k * (x (e.symm k).1 * y (e.symm k).2)
        = ∑ j : Fin b, (∑ i : Fin a, c (e (i, j)) * x i) * y j := by
      rw [← Equiv.sum_comp e (fun k => c k * (x (e.symm k).1 * y (e.symm k).2))]
