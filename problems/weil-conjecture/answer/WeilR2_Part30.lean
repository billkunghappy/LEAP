  haveI : HenselianLocalRing P := he.1
  have h𝔪 : ∀ x : P, x ∈ IsLocalRing.maximalIdeal P ↔ ¬ IsUnit x := fun x => by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  choose γ hγ using fun k : ℕ =>
