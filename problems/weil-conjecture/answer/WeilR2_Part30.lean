    classical
    intro Ω _ _ W
    have key : ∀ (x : Ω) (R : Polynomial Ω),
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C x * R) =
          algebraMap Ω (RatFunc Ω) x * algebraMap (Polynomial Ω) (RatFunc Ω) R := by
      intro x R
      rw [map_mul, Polynomial.C_eq_algebraMap, ← IsScalarTower.algebraMap_apply]
    have alg_inj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
      RatFunc.algebraMap_injective Ω
    have g0 : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.map W.subtype ≠ 0 := by
      rintro q ⟨i, hi⟩ h
      have h1 := congrArg (fun P => P.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
      have h2 : q.coeff i = 0 := Subtype.ext h1
      exact hi.ne_zero h2
    have s1 : ∀ P Q : Polynomial ↥W, (∃ i, IsUnit (P.coeff i)) → (∃ j, IsUnit (Q.coeff j)) →
        ∃ k, IsUnit ((P * Q).coeff k) := by
      rintro P Q ⟨i, hi⟩ ⟨j, hj⟩
      have hP : P.map (IsLocalRing.residue ↥W) ≠ 0 := by
        intro h
        have h1 := congrArg (fun R => R.coeff i) h
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h1
      have hQ : Q.map (IsLocalRing.residue ↥W) ≠ 0 := by
        intro h
        have h1 := congrArg (fun R => R.coeff j) h
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h1
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hj h1
      have hPQ : (P * Q).map (IsLocalRing.residue ↥W) ≠ 0 := by
        rw [Polynomial.map_mul]
        exact mul_ne_zero hP hQ
      obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hPQ
      rw [Polynomial.mem_support_iff, Polynomial.coeff_map] at hk
      exact ⟨k, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hk⟩
    have s2 : ∀ P : Polynomial Ω, P ≠ 0 → ∃ (a : Ω) (P₀ : Polynomial ↥W), a ≠ 0 ∧
        (∃ i, IsUnit (P₀.coeff i)) ∧ P = Polynomial.C a * P₀.map W.subtype := by
      intro P hP
      obtain ⟨j, hj, hmax⟩ := Finset.exists_max_image P.support
        (fun n => W.valuation (P.coeff n)) (Polynomial.support_nonempty.mpr hP)
      have ha0 : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
      have hcoef : ∀ n, (P.coeff j)⁻¹ * P.coeff n ∈ W := by
        intro n
        by_cases hn : P.coeff n = 0
        · rw [hn, mul_zero]; exact W.zero_mem
        · rw [← ValuationSubring.valuation_le_one_iff]
          have hle := hmax n (Polynomial.mem_support_iff.mpr hn)
          calc W.valuation ((P.coeff j)⁻¹ * P.coeff n)
              = W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff n) := Valuation.map_mul _ _ _
            _ ≤ W.valuation (P.coeff j)⁻¹ * W.valuation (P.coeff j) := by gcongr
            _ = W.valuation ((P.coeff j)⁻¹ * P.coeff j) := (Valuation.map_mul _ _ _).symm
            _ = 1 := by rw [inv_mul_cancel₀ ha0, Valuation.map_one]
      have hlift : Polynomial.C (P.coeff j)⁻¹ * P ∈ Polynomial.lifts W.subtype := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        rw [Polynomial.coeff_C_mul]
        exact ⟨⟨_, hcoef n⟩, rfl⟩
      obtain ⟨P₀, hP₀⟩ := (Polynomial.mem_lifts _).mp hlift
      refine ⟨P.coeff j, P₀, ha0, ⟨j, ?_⟩, ?_⟩
      · have h1 : ((P₀.coeff j : ↥W) : Ω) = 1 := by
          have h3 := congrArg (fun R => R.coeff j) hP₀
          simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at h3
          rw [inv_mul_cancel₀ ha0] at h3
          exact h3
        have h2 : P₀.coeff j = 1 := Subtype.ext h1
        rw [h2]
        exact isUnit_one
      · rw [hP₀, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1, one_mul]
    have s3 : ∀ f : RatFunc Ω, f ≠ 0 → ∃ (a : Ω) (N D : Polynomial ↥W), a ≠ 0 ∧
        (∃ i, IsUnit (N.coeff i)) ∧ (∃ j, IsUnit (D.coeff j)) ∧
        f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) =
          algebraMap Ω (RatFunc Ω) a * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) := by
      intro f hf
      have hnum : f.num ≠ 0 := RatFunc.num_ne_zero hf
      have hden : f.denom ≠ 0 := RatFunc.denom_ne_zero f
      obtain ⟨a₁, N, ha₁, hN, hNe⟩ := s2 _ hnum
      obtain ⟨b, D, hb, hD, hDe⟩ := s2 _ hden
      refine ⟨a₁ / b, N, D, div_ne_zero ha₁ hb, hN, hD, ?_⟩
      have hd0 : algebraMap (Polynomial Ω) (RatFunc Ω) f.denom ≠ 0 := by
        intro h
        apply hden
        apply alg_inj
        rw [h, map_zero]
      have hf' : f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom =
          algebraMap (Polynomial Ω) (RatFunc Ω) f.num := by
        have hnd := RatFunc.num_div_denom f
        calc f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom
            = (algebraMap (Polynomial Ω) (RatFunc Ω) f.num /
                algebraMap (Polynomial Ω) (RatFunc Ω) f.denom) *
                algebraMap (Polynomial Ω) (RatFunc Ω) f.denom := by rw [hnd]
          _ = algebraMap (Polynomial Ω) (RatFunc Ω) f.num := div_mul_cancel₀ _ hd0
      rw [hNe, hDe, key, key] at hf'
      have hcb : algebraMap Ω (RatFunc Ω) b ≠ 0 := (map_ne_zero _).mpr hb
      rw [map_div₀, div_mul_eq_mul_div, eq_div_iff hcb, ← hf']
      ring
    have s4 : ∀ {K : Type u} [Field K] (A : ValuationSubring K) (x : K),
        A.valuation x < 1 ↔ (x = 0 ∨ x⁻¹ ∉ A) := by
      intro K _ A x
      by_cases hx : x = 0
      · subst hx
        simp
      · have hpos : 0 < A.valuation x := (Valuation.pos_iff _).mpr hx
        rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_inv, inv_le_one₀ hpos]
        simp [hx]
    obtain ⟨T, hT⟩ : ∃ T : Subring (RatFunc Ω), ∀ f : RatFunc Ω, f ∈ T ↔
        ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ q.map W.subtype ≠ 0 ∧
          f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
            algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype) := by
      refine ⟨{ carrier := {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
                  q.map W.subtype ≠ 0 ∧
                  f * algebraMap (Polynomial Ω) (RatFunc Ω) (q.map W.subtype) =
                    algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype)}
                mul_mem' := ?_
                one_mem' := ?_
                add_mem' := ?_
                zero_mem' := ?_
                neg_mem' := ?_ }, fun f => Iff.rfl⟩
      · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
        have hq := s1 q₁ q₂ hq₁ hq₂
        refine ⟨p₁ * p₂, q₁ * q₂, hq, g0 _ hq, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_mul, map_mul, map_mul, ← h₁, ← h₂]
        ring
      · exact ⟨1, 1, ⟨0, by simp⟩, by simp, by simp⟩
      · rintro f g ⟨p₁, q₁, hq₁, -, h₁⟩ ⟨p₂, q₂, hq₂, -, h₂⟩
        have hq := s1 q₁ q₂ hq₁ hq₂
        refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, hq, g0 _ hq, ?_⟩
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_mul, map_add,
          map_mul, map_mul, map_mul, ← h₁, ← h₂]
        ring
      · exact ⟨0, 1, ⟨0, by simp⟩, by simp, by simp⟩
      · rintro f ⟨p, q, hq, hq0, h⟩
        refine ⟨-p, q, hq, hq0, ?_⟩
        rw [Polynomial.map_neg, map_neg, ← h]
        ring
    have hmem : ∀ f : RatFunc Ω, f ∈ T ∨ f⁻¹ ∈ T := by
      intro f
      by_cases hf : f = 0
      · left
        rw [hf]
        exact T.zero_mem
      obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
      rcases W.mem_or_inv_mem a with h | h
      · left
        rw [hT]
        refine ⟨Polynomial.C ⟨a, h⟩ * N, D, hD, g0 _ hD, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_C, key]
        exact he
      · right
        rw [hT]
        refine ⟨Polynomial.C ⟨a⁻¹, h⟩ * D, N, hN, g0 _ hN, ?_⟩
        rw [Polynomial.map_mul, Polynomial.map_C, key]
        have hsub : W.subtype ⟨a⁻¹, h⟩ = a⁻¹ := rfl
        have hca : algebraMap Ω (RatFunc Ω) a ≠ 0 := (map_ne_zero _).mpr ha
        rw [hsub, map_inv₀]
        calc f⁻¹ * algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)
            = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ * (algebraMap Ω (RatFunc Ω) a *
                algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype)) := by
              rw [mul_assoc, inv_mul_cancel_left₀ hca]
          _ = f⁻¹ * (algebraMap Ω (RatFunc Ω) a)⁻¹ *
                (f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype)) := by rw [he]
          _ = (algebraMap Ω (RatFunc Ω) a)⁻¹ *
                algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := by
              rw [mul_comm f⁻¹, mul_assoc, inv_mul_cancel_left₀ hf]
    obtain ⟨V, hVT, hVsub⟩ : ∃ V : ValuationSubring (RatFunc Ω), (∀ f, f ∈ V ↔ f ∈ T) ∧
        V.toSubring = T := ⟨{ T with mem_or_inv_mem' := hmem }, fun f => Iff.rfl, rfl⟩
    have hC2 : ∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W := by
      intro a
      rw [hVT, hT]
      constructor
      · rintro ⟨p, q, hq, -, h⟩
        rw [← key] at h
        have h2 := alg_inj h
        obtain ⟨i, hi⟩ := hq
        have h3 := congrArg (fun R => R.coeff i) h2
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map] at h3
        obtain ⟨w, hw⟩ := hi.exists_left_inv
        have h4 : a = W.subtype (p.coeff i) * W.subtype w := by
          rw [← h3, mul_assoc, ← map_mul, mul_comm (q.coeff i) w, hw, map_one, mul_one]
        rw [h4]
        exact (p.coeff i * w).2
      · intro h
        refine ⟨Polynomial.C ⟨a, h⟩, 1, ⟨0, by simp⟩, by simp, ?_⟩
        rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C]
        have h5 := key a 1
        rw [mul_one, map_one, mul_one] at h5
        exact h5.symm
    refine ⟨V, ?_, hC2, ?_, ?_⟩
    · rw [hVsub]
      unfold wcEbGauss
      apply le_antisymm
      · intro f hf
        exact Subring.subset_closure ((hT f).mp hf)
      · exact Subring.closure_le.mpr (fun f hf => (hT f).mpr hf)
    · intro a
      rw [s4 V, s4 W, map_eq_zero, ← map_inv₀, hC2]
    · intro f hf
      obtain ⟨a, N, D, ha, hN, hD, he⟩ := s3 f hf
      have hN0 : algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) ≠ 0 :=
        fun h => g0 N hN (alg_inj (h.trans (map_zero _).symm))
      have hD0 : algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) ≠ 0 :=
        fun h => g0 D hD (alg_inj (h.trans (map_zero _).symm))
      obtain ⟨g, hg⟩ : ∃ g : RatFunc Ω, g = algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype) /
          algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) := ⟨_, rfl⟩
      have hg0 : g ≠ 0 := by rw [hg]; exact div_ne_zero hN0 hD0
      have hgV : g ∈ V := by
        rw [hVT, hT]
        refine ⟨N, D, hD, g0 _ hD, ?_⟩
        rw [hg]
        exact div_mul_cancel₀ _ hD0
      have hgiV : g⁻¹ ∈ V := by
        rw [hVT, hT]
        refine ⟨D, N, hN, g0 _ hN, ?_⟩
        rw [hg, inv_div]
        exact div_mul_cancel₀ _ hN0
      refine ⟨a, ha, ⟨⟨g, hgV⟩, ⟨g⁻¹, hgiV⟩, Subtype.ext (mul_inv_cancel₀ hg0),
        Subtype.ext (inv_mul_cancel₀ hg0)⟩, ?_⟩
      show f = algebraMap Ω (RatFunc Ω) a * g
      rw [hg, mul_div_assoc', eq_div_iff hD0]
      exact he

  have s1 : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
      (R : Subring K) (V : ValuationSubring K), V.toSubring = R →
      Module.Finite ↥R ↥(integralClosure ↥R L) →
      Module.Free ↥R ↥(integralClosure ↥R L) ∧
        Module.finrank ↥R ↥(integralClosure ↥R L) = Module.finrank K L := by
    intro K L _ _ _ _ R V hV hfin
    subst hV
    haveI : ValuationRing ↥V.toSubring := inferInstanceAs (ValuationRing ↥V)
    haveI : IsLocalRing ↥V.toSubring := inferInstanceAs (IsLocalRing ↥V)
    haveI : IsFractionRing ↥V.toSubring K := inferInstanceAs (IsFractionRing ↥V K)
    have htors : Submodule.torsion ↥V.toSubring ↥(integralClosure ↥V.toSubring L) = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [Submodule.mem_torsion_iff] at hx
      obtain ⟨a, ha⟩ := hx
      rw [Submodule.mem_bot]
      have ha0 : ((a : ↥V.toSubring) : K) ≠ 0 := by
        have := nonZeroDivisors.ne_zero a.2
        exact fun h => this (Subtype.ext h)
      have h1 : ((a • x : ↥(integralClosure ↥V.toSubring L)) : L) = 0 := by rw [ha]; rfl
      have h2 : ((a • x : ↥(integralClosure ↥V.toSubring L)) : L) =
          algebraMap K L ((a : ↥V.toSubring) : K) * (x : L) := by
        show ((a : ↥V.toSubring) • (x : L)) = _
        rw [Algebra.smul_def]
        rfl
      rw [h2] at h1
      rcases mul_eq_zero.mp h1 with h | h
      · exact absurd ((map_eq_zero _).mp h) ha0
      · exact Subtype.ext h
    haveI hflat : Module.Flat ↥V.toSubring ↥(integralClosure ↥V.toSubring L) :=
      Module.Flat.flat_iff_torsion_eq_bot_of_isBezout.mpr htors
    haveI hfree : Module.Free ↥V.toSubring ↥(integralClosure ↥V.toSubring L) :=
      Module.free_of_flat_of_isLocalRing
    refine ⟨hfree, ?_⟩
    haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
    have hloc := IsIntegralClosure.isLocalization (A := ↥V.toSubring) (K := K) (L := L)
      (C := ↥(integralClosure ↥V.toSubring L))
    have hlm : IsLocalizedModule (nonZeroDivisors ↥V.toSubring)
        (IsScalarTower.toAlgHom ↥V.toSubring ↥(integralClosure ↥V.toSubring L) L).toLinearMap :=
      isLocalizedModule_iff_isLocalization.mpr hloc
    exact (Module.finrank_of_isLocalizedModule_of_free K (nonZeroDivisors ↥V.toSubring)
      (IsScalarTower.toAlgHom ↥V.toSubring ↥(integralClosure ↥V.toSubring L) L).toLinearMap).symm

  have s4 : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (R : Subring K)
      (V : ValuationSubring K), V.toSubring = R →
      Module.Finite ↥R ↥(integralClosure ↥R L) → ∀ b : ↥(integralClosure ↥R L),
      (∀ M : Ideal ↥(integralClosure ↥R L), M.IsMaximal → b ∈ M) →
      ∃ (N : ℕ) (m : K) (y : L), 0 < N ∧ m ∈ V ∧ V.valuation m < 1 ∧
        y ∈ integralClosure ↥R L ∧ (b : L) ^ N = algebraMap K L m * y := by
    intro K L _ _ _ R V hV hfin b hb
    subst hV
    haveI : ValuationRing ↥V.toSubring := inferInstanceAs (ValuationRing ↥V)
    haveI : IsLocalRing ↥V.toSubring := inferInstanceAs (IsLocalRing ↥V)
    have hrep : ∀ z ∈ Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
        (IsLocalRing.maximalIdeal ↥V.toSubring), ∃ μ ∈ IsLocalRing.maximalIdeal ↥V.toSubring,
        ∃ y : ↥(integralClosure ↥V.toSubring L),
          z = algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L) μ * y := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨μ, hμ, rfl⟩ := hx
        exact ⟨μ, hμ, 1, (mul_one _).symm⟩
      | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨μ₁, h₁, y₁, rfl⟩ := hx
        obtain ⟨μ₂, h₂, y₂, rfl⟩ := hy
        rcases ValuationRing.dvd_total μ₁ μ₂ with ⟨t, rfl⟩ | ⟨t, rfl⟩
        · exact ⟨μ₁, h₁, y₁ + algebraMap _ _ t * y₂, by rw [map_mul]; ring⟩
        · exact ⟨μ₂, h₂, algebraMap _ _ t * y₁ + y₂, by rw [map_mul]; ring⟩
      | smul a x _ hx =>
        obtain ⟨μ, hμ, y, rfl⟩ := hx
        exact ⟨μ, hμ, a * y, by rw [smul_eq_mul]; ring⟩
    letI : Field (↥V.toSubring ⧸ IsLocalRing.maximalIdeal ↥V.toSubring) :=
      Ideal.Quotient.field _
    haveI : Module.Finite ↥V.toSubring (↥(integralClosure ↥V.toSubring L) ⧸
        Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
          (IsLocalRing.maximalIdeal ↥V.toSubring)) := inferInstance
    haveI : Module.Finite (↥V.toSubring ⧸ IsLocalRing.maximalIdeal ↥V.toSubring)
        (↥(integralClosure ↥V.toSubring L) ⧸
        Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
          (IsLocalRing.maximalIdeal ↥V.toSubring)) :=
      Module.Finite.of_restrictScalars_finite ↥V.toSubring _ _
    haveI : IsArtinianRing (↥(integralClosure ↥V.toSubring L) ⧸
        Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
          (IsLocalRing.maximalIdeal ↥V.toSubring)) :=
      IsArtinianRing.of_finite (↥V.toSubring ⧸ IsLocalRing.maximalIdeal ↥V.toSubring) _
    obtain ⟨k, hk⟩ := IsArtinianRing.isNilpotent_jacobson_bot
      (R := ↥(integralClosure ↥V.toSubring L) ⧸
        Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
          (IsLocalRing.maximalIdeal ↥V.toSubring))
    have hbJ : Ideal.Quotient.mk _ b ∈ (⊥ : Ideal (↥(integralClosure ↥V.toSubring L) ⧸
        Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
          (IsLocalRing.maximalIdeal ↥V.toSubring))).jacobson := by
      rw [Ideal.jacobson, Ideal.mem_sInf]
      rintro M ⟨-, hM⟩
      exact hb _ (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
    have hpow : Ideal.Quotient.mk (Ideal.map (algebraMap ↥V.toSubring
          ↥(integralClosure ↥V.toSubring L)) (IsLocalRing.maximalIdeal ↥V.toSubring)) (b ^ k) = 0 := by
      have := Ideal.pow_mem_pow hbJ k
      rw [hk] at this
      rw [map_pow]
      exact (Ideal.mem_bot.mp this)
    have hbI : b ^ (k + 1) ∈ Ideal.map (algebraMap ↥V.toSubring ↥(integralClosure ↥V.toSubring L))
          (IsLocalRing.maximalIdeal ↥V.toSubring) := by
      rw [pow_succ]
      exact Ideal.mul_mem_right _ _ (Ideal.Quotient.eq_zero_iff_mem.mp hpow)
    obtain ⟨μ, hμ, y, hy⟩ := hrep _ hbI
    refine ⟨k + 1, (μ : K), (y : L), Nat.succ_pos k, μ.2, ?_, y.2, ?_⟩
    · exact (V.valuation_lt_one_iff ⟨μ.1, μ.2⟩).mp hμ
    · have := congrArg (fun z : ↥(integralClosure ↥V.toSubring L) => (z : L)) hy
      simp only [SubmonoidClass.coe_pow, Subalgebra.coe_mul] at this
      rw [this]
      rfl

  have s5 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), W ≠ ⊤ →
      ∀ (R : Subring (RatFunc Ω)) (V : ValuationSubring (RatFunc Ω)), V.toSubring = R →
      (∀ a : Ω, V.valuation (algebraMap Ω (RatFunc Ω) a) < 1 ↔ W.valuation a < 1) →
      (∀ f : RatFunc Ω, f ≠ 0 → ∃ a : Ω, a ≠ 0 ∧ ∃ u : Vˣ,
        f = algebraMap Ω (RatFunc Ω) a * ((u : V) : RatFunc Ω)) →
      ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] (b : L) (N : ℕ) (m : RatFunc Ω) (y : L),
      0 < N → V.valuation m < 1 → y ∈ integralClosure ↥R L →
      b ^ N = algebraMap (RatFunc Ω) L m * y →
      ∃ c : Ω, c ≠ 0 ∧ W.valuation c < 1 ∧
        b / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c) ∈ integralClosure ↥R L := by
    intro Ω _ _ W hW R V hV hlt hfac L _ _ b N m y hN hm hy heq
    subst hV
    by_cases hm0 : m = 0
    · have hb : b = 0 := by
        rw [hm0, map_zero, zero_mul] at heq
        exact (pow_eq_zero_iff hN.ne').mp heq
      obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
        by_contra h
        push_neg at h
        exact hW (eq_top_iff.mpr (fun x _ => h x))
      have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
      have h1 : 1 < W.valuation x := by
        rw [← not_le, W.valuation_le_one_iff]; exact hx
      refine ⟨x⁻¹, inv_ne_zero hx0, ?_, ?_⟩
      · rw [map_inv₀]; exact inv_lt_one_of_one_lt₀ h1
      · rw [hb, zero_div]; exact zero_mem _
    · obtain ⟨a, ha0, u, hu⟩ := hfac m hm0
      have hva : W.valuation a < 1 := by
        rw [← hlt]
        have : V.valuation m = V.valuation (algebraMap Ω (RatFunc Ω) a) := by
          rw [hu, map_mul, V.valuation_unit, mul_one]
        rw [← this]; exact hm
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq a hN
      have hc0 : c ≠ 0 := by
        rintro rfl
        rw [zero_pow hN.ne'] at hc
        exact ha0 hc.symm
      refine ⟨c, hc0, ?_, ?_⟩
      · by_contra h
        push_neg at h
        have h2 := one_le_pow₀ (n := N) h
        rw [← map_pow, hc] at h2
        exact absurd hva (not_lt.mpr h2)
      · have hιa : algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) a) ≠ 0 := by
          rw [map_ne_zero, map_ne_zero]; exact ha0
        have hpow : (b / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ^ N =
            algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω) * y := by
          rw [div_pow, ← map_pow, ← map_pow, hc, heq, hu, map_mul, mul_assoc,
            mul_div_cancel_left₀ _ hιa]
        have hmem : algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω) * y ∈
            integralClosure ↥V.toSubring L := by
          refine mul_mem ?_ hy
          have : algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω) =
              algebraMap ↥V.toSubring L ⟨((u : V) : RatFunc Ω), (u : V).2⟩ := rfl
          rw [this]
          exact isIntegral_algebraMap
        rw [mem_integralClosure_iff] at hmem ⊢
        rw [← hpow] at hmem
        exact IsIntegral.of_pow hN hmem

  have s2 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (V : ValuationSubring (RatFunc Ω)),
      (∀ f : RatFunc Ω, f ≠ 0 → ∃ a : Ω, a ≠ 0 ∧ ∃ u : Vˣ,
        f = algebraMap Ω (RatFunc Ω) a * ((u : V) : RatFunc Ω)) →
      ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
        (V' : ValuationSubring L), V'.comap (algebraMap (RatFunc Ω) L) = V →
      ∀ s : L, s ≠ 0 → ∃ c : Ω, c ≠ 0 ∧
        V'.valuation (s / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) = 1 := by
    intro Ω _ _ V hfac L _ _ _ V' hV' s hs
    classical
    have hdep : ¬ LinearIndependent (RatFunc Ω)
        (fun i : Fin (Module.finrank (RatFunc Ω) L + 1) => s ^ (i : ℕ)) := by
      intro h
      have := h.fintype_card_le_finrank
      simp at this
    rw [Fintype.not_linearIndependent_iff] at hdep
    obtain ⟨g, hg, i₁, hi₁⟩ := hdep
    have hxsum : ∑ i, algebraMap (RatFunc Ω) L (g i) * s ^ (i : ℕ) = 0 := by
      simpa [Algebra.smul_def] using hg
    have hx0 : ∀ i, algebraMap (RatFunc Ω) L (g i) * s ^ (i : ℕ) ≠ 0 ↔ g i ≠ 0 := by
      intro i
      simp [hs]
    have hne : ∀ z : L, V'.valuation z ≠ 0 ↔ z ≠ 0 := fun z => Valuation.ne_zero_iff _
    obtain ⟨i₀, -, hi₀⟩ := Finset.exists_max_image Finset.univ
      (fun i => V'.valuation (algebraMap (RatFunc Ω) L (g i) * s ^ (i : ℕ)))
      ⟨i₁, Finset.mem_univ _⟩
    have hwx0 : V'.valuation (algebraMap (RatFunc Ω) L (g i₀) * s ^ (i₀ : ℕ)) ≠ 0 := by
      have h1 : 0 < V'.valuation (algebraMap (RatFunc Ω) L (g i₁) * s ^ (i₁ : ℕ)) := by
        rw [zero_lt_iff, hne]; exact (hx0 i₁).mpr hi₁
      exact (lt_of_lt_of_le h1 (hi₀ i₁ (Finset.mem_univ _))).ne'
    obtain ⟨j, hj, hji⟩ : ∃ j, j ≠ i₀ ∧
        V'.valuation (algebraMap (RatFunc Ω) L (g j) * s ^ (j : ℕ)) =
          V'.valuation (algebraMap (RatFunc Ω) L (g i₀) * s ^ (i₀ : ℕ)) := by
      by_contra hcon
      push_neg at hcon
      have hlt : ∀ j ∈ Finset.univ.erase i₀,
          V'.valuation (algebraMap (RatFunc Ω) L (g j) * s ^ (j : ℕ)) <
            V'.valuation (algebraMap (RatFunc Ω) L (g i₀) * s ^ (i₀ : ℕ)) := by
        intro j hj
        exact lt_of_le_of_ne (hi₀ j (Finset.mem_univ _)) (hcon j (Finset.ne_of_mem_erase hj))
      have hsum := Valuation.map_sum_lt V'.valuation hwx0 hlt
      have heq : ∑ j ∈ Finset.univ.erase i₀, algebraMap (RatFunc Ω) L (g j) * s ^ (j : ℕ) =
          -(algebraMap (RatFunc Ω) L (g i₀) * s ^ (i₀ : ℕ)) := by
        rw [eq_neg_iff_add_eq_zero, add_comm]
        exact (Finset.add_sum_erase Finset.univ
          (fun j => algebraMap (RatFunc Ω) L (g j) * s ^ (j : ℕ)) (Finset.mem_univ i₀)).trans hxsum
      rw [heq, Valuation.map_neg] at hsum
      exact lt_irrefl _ hsum
    have hgi₀ : g i₀ ≠ 0 := (hx0 i₀).mp ((hne _).mp hwx0)
    have hgj : g j ≠ 0 := (hx0 j).mp ((hne _).mp (hji ▸ hwx0))
    have hs0 : V'.valuation s ≠ 0 := (hne s).mpr hs
    have key : ∀ i j : Fin (Module.finrank (RatFunc Ω) L + 1), (i : ℕ) < j → g i ≠ 0 →
        g j ≠ 0 →
        V'.valuation (algebraMap (RatFunc Ω) L (g i) * s ^ (i : ℕ)) =
          V'.valuation (algebraMap (RatFunc Ω) L (g j) * s ^ (j : ℕ)) →
        ∃ (d : ℕ) (k : RatFunc Ω), 0 < d ∧ k ≠ 0 ∧
          V'.valuation s ^ d = V'.valuation (algebraMap (RatFunc Ω) L k) := by
      intro i j hij hgi hgj hw
      refine ⟨j - i, g i / g j, Nat.sub_pos_of_lt hij, div_ne_zero hgi hgj, ?_⟩
      rw [map_mul, map_mul, map_pow, map_pow] at hw
      have hj' : (j : ℕ) = i + (j - i) := by omega
      rw [hj', pow_add] at hw
      have hsi : V'.valuation s ^ (i : ℕ) ≠ 0 := pow_ne_zero _ hs0
      have hgjw : V'.valuation (algebraMap (RatFunc Ω) L (g j)) ≠ 0 :=
        (hne _).mpr ((map_ne_zero _).mpr hgj)
      rw [map_div₀, Valuation.map_div, eq_div_iff hgjw]
      apply mul_left_cancel₀ hsi
      calc V'.valuation s ^ (i : ℕ) * (V'.valuation s ^ ((j : ℕ) - i) *
            V'.valuation (algebraMap (RatFunc Ω) L (g j)))
          = V'.valuation (algebraMap (RatFunc Ω) L (g j)) *
            (V'.valuation s ^ (i : ℕ) * V'.valuation s ^ ((j : ℕ) - i)) := by ac_rfl
        _ = V'.valuation (algebraMap (RatFunc Ω) L (g i)) * V'.valuation s ^ (i : ℕ) := hw.symm
        _ = V'.valuation s ^ (i : ℕ) * V'.valuation (algebraMap (RatFunc Ω) L (g i)) :=
            mul_comm _ _
    obtain ⟨d, k, hd, hk0, hdk⟩ : ∃ (d : ℕ) (k : RatFunc Ω), 0 < d ∧ k ≠ 0 ∧
        V'.valuation s ^ d = V'.valuation (algebraMap (RatFunc Ω) L k) := by
      rcases lt_trichotomy (i₀ : ℕ) (j : ℕ) with h | h | h
      · exact key i₀ j h hgi₀ hgj hji.symm
      · exact absurd (Fin.ext h).symm hj
      · exact key j i₀ h hgj hgi₀ hji
    obtain ⟨a, ha0, u, hu⟩ := hfac k hk0
    have hu1 : V'.valuation (algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω)) = 1 := by
      have hmem1 : algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω) ∈ V' := by
        have : ((u : V) : RatFunc Ω) ∈ V'.comap (algebraMap (RatFunc Ω) L) := by
          rw [hV']; exact (u : V).2
        exact this
      have hmem2 : algebraMap (RatFunc Ω) L (((u⁻¹ : Vˣ) : V) : RatFunc Ω) ∈ V' := by
        have : (((u⁻¹ : Vˣ) : V) : RatFunc Ω) ∈ V'.comap (algebraMap (RatFunc Ω) L) := by
          rw [hV']; exact ((u⁻¹ : Vˣ) : V).2
        exact this
      have h1 := (V'.valuation_le_one_iff _).mpr hmem1
      have h2 := (V'.valuation_le_one_iff _).mpr hmem2
      have hprod : V'.valuation (algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω)) *
          V'.valuation (algebraMap (RatFunc Ω) L (((u⁻¹ : Vˣ) : V) : RatFunc Ω)) = 1 := by
        rw [← map_mul, ← map_mul]
        have : ((u : V) : RatFunc Ω) * (((u⁻¹ : Vˣ) : V) : RatFunc Ω) = 1 := by
          show ((((u : V) * ((u⁻¹ : Vˣ) : V)) : V) : RatFunc Ω) = 1
          rw [Units.mul_inv]
          rfl
        rw [this, map_one, map_one]
      by_contra hne1
      have hlt1 := lt_of_le_of_ne h1 hne1
      have : V'.valuation (algebraMap (RatFunc Ω) L ((u : V) : RatFunc Ω)) *
          V'.valuation (algebraMap (RatFunc Ω) L (((u⁻¹ : Vˣ) : V) : RatFunc Ω)) < 1 :=
        mul_lt_one_of_lt_of_le hlt1 h2
      rw [hprod] at this
      exact lt_irrefl _ this
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq a hd
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [zero_pow hd.ne'] at hc
      exact ha0 hc.symm
    refine ⟨c, hc0, ?_⟩
    have hsd : V'.valuation s ^ d =
        V'.valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ^ d := by
      rw [hdk, hu, map_mul, map_mul, hu1, mul_one, ← map_pow, ← map_pow, ← map_pow, hc]
    have hseq := (pow_left_inj₀ zero_le' zero_le' hd.ne').mp hsd
    have hcne : V'.valuation (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) c)) ≠ 0 := by
      rw [hne, map_ne_zero, map_ne_zero]; exact hc0
    rw [Valuation.map_div, hseq, div_self hcne]

  intro Ω _ _ W _hdim hW L _ _ _ _ hdef
  obtain ⟨V, hV, _hmem, hlt, hfac⟩ := gv Ω W
  have e : (((algebraMap (RatFunc Ω) L).comp (wcEbGauss W).subtype).toAlgebra :
      Algebra ↥(wcEbGauss W) L) = (inferInstance : Algebra ↥(wcEbGauss W) L) :=
    Algebra.algebra_ext _ _ (fun _ => rfl)
  have transport : ∀ (I J : Algebra ↥(wcEbGauss W) L), I = J →
      (letI := I; Module.Finite ↥(wcEbGauss W) ↥(integralClosure ↥(wcEbGauss W) L)) →
      (letI := J; Module.Finite ↥(wcEbGauss W) ↥(integralClosure ↥(wcEbGauss W) L)) := by
    intro I J hIJ h
    subst hIJ
    exact h
  have hfin : Module.Finite ↥(wcEbGauss W) ↥(integralClosure ↥(wcEbGauss W) L) :=
    transport _ _ e hdef
  obtain ⟨hfree, hrank⟩ := s1 (RatFunc Ω) L (wcEbGauss W) V hV hfin
  refine ⟨hfree, hrank, ?_, ?_⟩
  · intro V' hV' s hs
    have hV'' : V'.comap (algebraMap (RatFunc Ω) L) = V :=
      ValuationSubring.toSubring_injective (hV'.trans hV.symm)
    exact s2 Ω V hfac L V' hV'' s hs
  · intro b hb
    obtain ⟨N, m, y, hN, _hmV, hmlt, hy, heq⟩ := s4 (RatFunc Ω) L (wcEbGauss W) V hV hfin b hb
    exact s5 Ω W hW (wcEbGauss W) V hV hlt hfac L (b : L) N m y hN hmlt hy heq

theorem wcpa_dj_lr1k_eb_rs_pole : ∀ (L : Type u) [Field L] (m : ℕ) (V : Fin m → ValuationSubring L), (∀ i j, V i ≤ V j → i = j) → (∀ i, ∀ x y : L, y ≠ 0 → (V i).valuation x < 1 → ∃ N : ℕ, (V i).valuation x ^ N < (V i).valuation y) → ∀ (i : Fin m) (S : Finset (Fin m)), i ∉ S → S.Nonempty → ∃ z : L, 1 < (V i).valuation z ∧ ∀ j ∈ S, (V j).valuation z < 1 :=
by
  classical
  intro L _ m V hinc harch i S hiS hS
  have pair : ∀ A B : ValuationSubring L, ¬ A ≤ B → ¬ B ≤ A →
      ∃ w : L, 1 < A.valuation w ∧ B.valuation w < 1 := by
    intro A B hAB hBA
    obtain ⟨b, hbA, hbB⟩ := SetLike.not_le_iff_exists.mp hAB
    obtain ⟨a, haB, haA⟩ := SetLike.not_le_iff_exists.mp hBA
    have hb0 : b ≠ 0 := by rintro rfl; exact hbB B.zero_mem
    have hAa : 1 < A.valuation a := by
      rw [← not_le, A.valuation_le_one_iff]; exact haA
    have hAb : A.valuation b ≤ 1 := (A.valuation_le_one_iff b).mpr hbA
    have hBa : B.valuation a ≤ 1 := (B.valuation_le_one_iff a).mpr haB
    have hBb : 1 < B.valuation b := by
      rw [← not_le, B.valuation_le_one_iff]; exact hbB
    have hAb0 : 0 < A.valuation b := (Valuation.pos_iff _).mpr hb0
    have hBb0 : 0 < B.valuation b := (Valuation.pos_iff _).mpr hb0
    refine ⟨a / b, ?_, ?_⟩
    · rw [map_div₀, lt_div_iff₀ hAb0, one_mul]
      exact lt_of_le_of_lt hAb hAa
    · rw [map_div₀, div_lt_one₀ hBb0]
      exact lt_of_le_of_lt hBa hBb
  have hle1 : ∀ (j : Fin m) (x : L), (V j).valuation x < 1 → ∀ a b : ℕ, a ≤ b →
      (V j).valuation x ^ b ≤ (V j).valuation x ^ a :=
    fun j x h a b hab => pow_le_pow_of_le_one zero_le' h.le hab
  have unif : ∀ (T : Finset (Fin m)) (z w : L), w ≠ 0 → (∀ j ∈ T, (V j).valuation z < 1) →
      ∃ N : ℕ, 1 ≤ N ∧ ∀ j ∈ T, (V j).valuation z ^ N * (V j).valuation w < 1 := by
    intro T z w hw
    induction T using Finset.induction_on with
    | empty => intro _; exact ⟨1, le_rfl, by simp⟩
    | insert j T' hjT ih =>
      intro hz
      obtain ⟨N₀, hN₀, hN₀'⟩ := ih (fun j' hj' => hz j' (Finset.mem_insert_of_mem hj'))
      obtain ⟨Nj, hNj⟩ := harch j z w⁻¹ (inv_ne_zero hw) (hz j (Finset.mem_insert_self j T'))
      refine ⟨N₀ + Nj, by omega, ?_⟩
      intro j' hj'
      rcases Finset.mem_insert.mp hj' with h | h
      · subst h
        have hw0 : 0 < (V j').valuation w := (Valuation.pos_iff _).mpr hw
        have h1 : (V j').valuation z ^ (N₀ + Nj) < ((V j').valuation w)⁻¹ := by
          rw [← map_inv₀]
          exact lt_of_le_of_lt (hle1 j' z (hz _ (Finset.mem_insert_self _ _)) Nj _ (by omega)) hNj
        calc (V j').valuation z ^ (N₀ + Nj) * (V j').valuation w
            < ((V j').valuation w)⁻¹ * (V j').valuation w := mul_lt_mul_of_pos_right h1 hw0
          _ = 1 := inv_mul_cancel₀ hw0.ne'
      · calc (V j').valuation z ^ (N₀ + Nj) * (V j').valuation w
            ≤ (V j').valuation z ^ N₀ * (V j').valuation w :=
              mul_le_mul_of_nonneg_right
                (hle1 j' z (hz _ (Finset.mem_insert_of_mem h)) N₀ _ (by omega)) zero_le'
          _ < 1 := hN₀' j' h
  have step : ∀ (k : Fin m) (T : Finset (Fin m)) (z w : L) (N : ℕ), 1 ≤ N →
      1 < (V i).valuation z → (∀ j ∈ T, (V j).valuation z < 1) → 1 < (V i).valuation w →
      (V k).valuation w < 1 → (∀ j ∈ T, (V j).valuation z ^ N * (V j).valuation w < 1) →
      ∃ t : L, 1 < (V i).valuation t ∧ (V k).valuation t < 1 ∧ ∀ j ∈ T, (V j).valuation t < 1 := by
    intro k T z w N hN hzi hzT hwi hwk hzw
    have hN0 : N ≠ 0 := by omega
    by_cases hzk : (V k).valuation z ≤ 1
    · refine ⟨z ^ N * w, ?_, ?_, ?_⟩
      · rw [map_mul, map_pow]
        exact one_lt_mul_of_le_of_lt (one_le_pow₀ hzi.le) hwi
      · rw [map_mul, map_pow]
        exact lt_of_le_of_lt (mul_le_of_le_one_left' (pow_le_one₀ zero_le' hzk)) hwk
      · intro j hj
        rw [map_mul, map_pow]
        exact hzw j hj
    · push_neg at hzk
      have U1 : ∀ j, 1 < (V j).valuation (z ^ N) →
          (V j).valuation (z ^ N * w / (1 + z ^ N)) = (V j).valuation w := by
        intro j h
        have h1 : (V j).valuation (1 + z ^ N) = (V j).valuation (z ^ N) :=
          Valuation.map_add_eq_of_lt_right _ (by rw [Valuation.map_one]; exact h)
        have h0 : (V j).valuation (z ^ N) ≠ 0 := (zero_lt_one.trans h).ne'
        rw [map_div₀, map_mul, h1, mul_div_cancel_left₀ _ h0]
      have U2 : ∀ j, (V j).valuation (z ^ N) < 1 →
          (V j).valuation (z ^ N * w / (1 + z ^ N)) =
            (V j).valuation (z ^ N) * (V j).valuation w := by
        intro j h
        have h1 : (V j).valuation (1 + z ^ N) = 1 := by
          rw [Valuation.map_add_eq_of_lt_left _ (by rw [Valuation.map_one]; exact h),
            Valuation.map_one]
        rw [map_div₀, map_mul, h1, div_one]
      refine ⟨z ^ N * w / (1 + z ^ N), ?_, ?_, ?_⟩
      · rw [U1 i (by rw [map_pow]; exact one_lt_pow₀ hzi hN0)]; exact hwi
      · rw [U1 k (by rw [map_pow]; exact one_lt_pow₀ hzk hN0)]; exact hwk
      · intro j hj
        rw [U2 j (by rw [map_pow]; exact pow_lt_one₀ zero_le' (hzT j hj) hN0), map_pow]
        exact hzw j hj
  have P : ∀ k, k ≠ i → ∃ w : L, 1 < (V i).valuation w ∧ (V k).valuation w < 1 := by
    intro k hk
    exact pair (V i) (V k) (fun h => hk (hinc i k h).symm) (fun h => hk (hinc k i h))
  revert hiS
  induction hS using Finset.Nonempty.cons_induction with
  | singleton k =>
    intro hiS
    have hk : k ≠ i := fun h => hiS (by rw [h]; exact Finset.mem_singleton_self i)
    obtain ⟨w, hw1, hw2⟩ := P k hk
    exact ⟨w, hw1, fun j hj => by rw [Finset.mem_singleton.mp hj]; exact hw2⟩
  | cons k T hkT hT ih =>
    intro hiS
    have hk : k ≠ i := fun h => hiS (Finset.mem_cons.mpr (Or.inl h.symm))
    have hiT : i ∉ T := fun h => hiS (Finset.mem_cons_of_mem h)
    obtain ⟨z, hz1, hz2⟩ := ih hiT
    obtain ⟨w, hw1, hw2⟩ := P k hk
    have hw0 : w ≠ 0 := by
      rintro rfl
      rw [Valuation.map_zero] at hw1
      exact (not_lt.mpr zero_le') hw1
    obtain ⟨N, hN, hN'⟩ := unif T z w hw0 hz2
    obtain ⟨t, ht1, ht2, ht3⟩ := step k T z w N hN hz1 hz2 hw1 hw2 hN'
    refine ⟨t, ht1, fun j hj => ?_⟩
    rcases Finset.mem_cons.mp hj with h | h
    · rw [h]; exact ht2
    · exact ht3 j h

theorem wcpa_dj_lr1k_eb_rs_resapprox : ∀ (L : Type u) [Field L] (m : ℕ) (V : Fin m → ValuationSubring L), (∀ i, ∀ x y : L, y ≠ 0 → (V i).valuation x < 1 → ∃ N : ℕ, (V i).valuation x ^ N < (V i).valuation y) → (∀ i, (∃ j, j ≠ i) → ∃ z : L, 1 < (V i).valuation z ∧ ∀ j, j ≠ i → (V j).valuation z < 1) → ∀ i, ∀ x ∈ V i, ∃ y : L, (V i).valuation (y - x) < 1 ∧ ∀ j, j ≠ i → (V j).valuation y < 1 :=
by
  classical
  intro L _ m V harch hpole i x hx
  by_cases hex : ∃ j, j ≠ i
  swap
  · exact ⟨x, by simp, fun j hj => absurd ⟨j, hj⟩ hex⟩
  by_cases hx0 : x = 0
  · exact ⟨0, by simp [hx0], fun j _ => by simp⟩
  obtain ⟨z, hz1, hz2⟩ := hpole i hex
  have hiz : (V i).valuation (1 + z) = (V i).valuation z :=
    Valuation.map_add_eq_of_lt_right _ (by rw [Valuation.map_one]; exact hz1)
  have h1z : 1 + z ≠ 0 := by
    intro h
    rw [h, Valuation.map_zero] at hiz
    rw [← hiz] at hz1
    exact absurd hz1 (not_lt.mpr zero_le')
  set e := z * (1 + z)⁻¹ with he
  have he1 : e - 1 = -(1 + z)⁻¹ := by
    rw [he]; field_simp; ring
  have hie1 : (V i).valuation (e - 1) < 1 := by
    rw [he1, Valuation.map_neg, map_inv₀, hiz]
    exact inv_lt_one_of_one_lt₀ hz1
  have hie : (V i).valuation e = 1 := by
    have := Valuation.map_eq_of_sub_lt (V i).valuation (y := e) (x := 1)
      (by rw [Valuation.map_one]; exact hie1)
    rwa [Valuation.map_one] at this
  have hje : ∀ j, j ≠ i → (V j).valuation e < 1 := by
    intro j hj
    have h1 : (V j).valuation (1 + z) = 1 := by
      rw [Valuation.map_add_eq_of_lt_left _ (by rw [Valuation.map_one]; exact hz2 j hj),
        Valuation.map_one]
    rw [he, Valuation.map_mul, map_inv₀, h1, inv_one, mul_one]
    exact hz2 j hj
  have hN : ∀ j, ∃ N : ℕ, j ≠ i → (V j).valuation e ^ N < (V j).valuation x⁻¹ := by
    intro j
    by_cases hj : j = i
    · exact ⟨0, fun h => absurd hj h⟩
    · obtain ⟨N, hN⟩ := harch j e x⁻¹ (inv_ne_zero hx0) (hje j hj)
      exact ⟨N, fun _ => hN⟩
  choose N hN using hN
  refine ⟨e ^ (∑ j, N j) * x, ?_, ?_⟩
  · have hgeom : e ^ (∑ j, N j) * x - x
        = x * ((∑ k ∈ Finset.range (∑ j, N j), e ^ k) * (e - 1)) := by
      rw [geom_sum_mul]; ring
    rw [hgeom, Valuation.map_mul, Valuation.map_mul]
    have hs : (V i).valuation (∑ k ∈ Finset.range (∑ j, N j), e ^ k) ≤ 1 :=
      Valuation.map_sum_le _ (fun k _ => by rw [Valuation.map_pow, hie, one_pow])
    have hxv : (V i).valuation x ≤ 1 := ((V i).valuation_le_one_iff x).mpr hx
    exact lt_of_le_of_lt (mul_le_of_le_one_left' hxv)
      (lt_of_le_of_lt (mul_le_of_le_one_left' hs) hie1)
  · intro j hj
    have hxj : (V j).valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
    have hle : (V j).valuation e ^ (∑ j, N j) ≤ (V j).valuation e ^ N j :=
      pow_le_pow_right_of_le_one' (hje j hj).le
        (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j))
    have hlt : (V j).valuation e ^ (∑ j, N j) < ((V j).valuation x)⁻¹ := by
      rw [← map_inv₀]; exact lt_of_le_of_lt hle (hN j hj)
    rw [Valuation.map_mul, Valuation.map_pow]
    calc (V j).valuation e ^ (∑ j, N j) * (V j).valuation x
        < ((V j).valuation x)⁻¹ * (V j).valuation x :=
          mul_lt_mul_of_pos_right hlt (zero_lt_iff.mpr hxj)
      _ = 1 := inv_mul_cancel₀ hxj

theorem wcpa_dj_lr1k_eb_rs_indep_bound : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] (O : ValuationSubring K) (m : ℕ) (V : Fin m → ValuationSubring L), (∀ i, (V i).comap (algebraMap K L) = O) → (∀ i, ∀ x ∈ V i, ∃ y : L, (V i).valuation (y - x) < 1 ∧ ∀ j, j ≠ i → (V j).valuation y < 1) → ∀ S : (i : Fin m) → Finset (IsLocalRing.ResidueField ↥(V i)), (∀ i, letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra; LinearIndependent (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (fun ξ : ↥(S i) => (ξ : IsLocalRing.ResidueField ↥(V i)))) → ∑ i, (S i).card ≤ Module.finrank K L :=
by
  classical
  intro K L _ _ _ _ O m V hcomap hRA S hLI

  have happrox : ∀ (i : Fin m) (ξ : IsLocalRing.ResidueField ↥(V i)), ∃ (y : L) (hy : y ∈ V i),
      IsLocalRing.residue ↥(V i) ⟨y, hy⟩ = ξ ∧ ∀ j, j ≠ i → (V j).valuation y < 1 := by
    intro i ξ
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective ξ
    obtain ⟨y, hy1, hy2⟩ := hRA i x x.2
    have hyx : y - x ∈ V i := ((V i).valuation_le_one_iff _).mp hy1.le
    have hy : y ∈ V i := by
      have h := add_mem hyx x.2
      rwa [sub_add_cancel] at h
    refine ⟨y, hy, ?_, hy2⟩
    have hm : (⟨y - x, hyx⟩ : ↥(V i)) ∈ IsLocalRing.maximalIdeal ↥(V i) :=
      ((V i).valuation_lt_one_iff _).mpr hy1
    have h0 := (IsLocalRing.residue_eq_zero_iff _).mpr hm
    have he : (⟨y - x, hyx⟩ : ↥(V i)) = ⟨y, hy⟩ - x := Subtype.ext rfl
    rw [he, map_sub, sub_eq_zero] at h0
    exact h0

  choose y hy hres hsmall using
    fun p : (i : Fin m) × ↥(S i) => happrox p.1 (p.2 : IsLocalRing.ResidueField ↥(V p.1))
  have hmem : ∀ (p : (i : Fin m) × ↥(S i)) (j : Fin m), y p ∈ V j := by
    intro p j
    by_cases h : j = p.1
    · rw [h]; exact hy p
    · exact ((V j).valuation_le_one_iff _).mp (hsmall p j h).le
  have hzero : ∀ (p : (i : Fin m) × ↥(S i)) (j : Fin m), j ≠ p.1 →
      IsLocalRing.residue ↥(V j) ⟨y p, hmem p j⟩ = 0 := by
    intro p j h
    exact (IsLocalRing.residue_eq_zero_iff _).mpr (((V j).valuation_lt_one_iff _).mpr (hsmall p j h))

  have hLIy : LinearIndependent K y := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    by_contra hne
    push_neg at hne
    obtain ⟨p₀, hp₀⟩ := hne
    obtain ⟨⟨l, ξ₀⟩, -, hq⟩ := Finset.exists_max_image Finset.univ
      (fun p => O.valuation (g p)) ⟨p₀, Finset.mem_univ _⟩
    have hgq : g ⟨l, ξ₀⟩ ≠ 0 := by
      intro h0
      have h1 : O.valuation (g p₀) ≤ O.valuation (g ⟨l, ξ₀⟩) := hq p₀ (Finset.mem_univ _)
      rw [h0, map_zero] at h1
      exact hp₀ ((Valuation.zero_iff _).mp (le_antisymm h1 zero_le'))
    obtain ⟨d, hd⟩ : ∃ d : (i : Fin m) × ↥(S i) → K, d = fun p => g p / g ⟨l, ξ₀⟩ := ⟨_, rfl⟩
    have hdO : ∀ p, d p ∈ (V l).comap (algebraMap K L) := by
      intro p
      rw [hcomap l, hd, ← O.valuation_le_one_iff]
      simp only [map_div₀]
      exact div_le_one_of_le₀ (hq p (Finset.mem_univ _)) zero_le'
    have hrel : ∑ p, algebraMap K L (d p) * y p = 0 := by
      have e : ∑ p, algebraMap K L (d p) * y p = algebraMap K L (g ⟨l, ξ₀⟩)⁻¹ * ∑ p, g p • y p := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun p _ => ?_)
        simp only [hd]
        rw [Algebra.smul_def, div_eq_mul_inv, map_mul]
        ring
      rw [e, hg, mul_zero]
    have hsumV : (∑ p, (⟨algebraMap K L (d p), hdO p⟩ : ↥(V l)) * ⟨y p, hmem p l⟩) = 0 := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finsetSum]
      exact hrel
    have hres0 := congrArg (IsLocalRing.residue ↥(V l)) hsumV
    rw [map_sum, map_zero] at hres0
    have hstar : ∀ p, IsLocalRing.residue ↥(V l) ⟨algebraMap K L (d p), hdO p⟩ =
        wcEbBdResAlg K (V l) (IsLocalRing.residue ↥((V l).comap (algebraMap K L)) ⟨d p, hdO p⟩) :=
      fun p => rfl
    have hresl : ∀ ξ : ↥(S l), IsLocalRing.residue ↥(V l) ⟨y ⟨l, ξ⟩, hmem ⟨l, ξ⟩ l⟩ = ξ :=
      fun ξ => hres ⟨l, ξ⟩
    letI : Algebra (IsLocalRing.ResidueField ↥((V l).comap (algebraMap K L)))
        (IsLocalRing.ResidueField ↥(V l)) := (wcEbBdResAlg K (V l)).toAlgebra
    have hLIl : LinearIndependent (IsLocalRing.ResidueField ↥((V l).comap (algebraMap K L)))
        (fun ξ : ↥(S l) => (ξ : IsLocalRing.ResidueField ↥(V l))) := hLI l
    have hkey : ∑ ξ : ↥(S l), IsLocalRing.residue ↥((V l).comap (algebraMap K L))
        ⟨d ⟨l, ξ⟩, hdO ⟨l, ξ⟩⟩ • (ξ : IsLocalRing.ResidueField ↥(V l)) = 0 := by
      rw [← hres0, Fintype.sum_sigma, Finset.sum_eq_single l]
      · refine Finset.sum_congr rfl (fun ξ _ => ?_)
        beta_reduce
        rw [map_mul, hstar ⟨l, ξ⟩, hresl ξ, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      · intro i _ hil
        refine Finset.sum_eq_zero (fun ξ _ => ?_)
        beta_reduce
        rw [map_mul, hzero ⟨i, ξ⟩ l (Ne.symm hil), mul_zero]
      · intro h; exact absurd (Finset.mem_univ l) h
    have hall : IsLocalRing.residue ↥((V l).comap (algebraMap K L)) ⟨d ⟨l, ξ₀⟩, hdO ⟨l, ξ₀⟩⟩ = 0 :=
      Fintype.linearIndependent_iff.mp hLIl
        (fun ξ => IsLocalRing.residue ↥((V l).comap (algebraMap K L)) ⟨d ⟨l, ξ⟩, hdO ⟨l, ξ⟩⟩)
        hkey ξ₀
    have hd1 : d ⟨l, ξ₀⟩ = 1 := by rw [hd]; exact div_self hgq
    have h1 : (⟨d ⟨l, ξ₀⟩, hdO ⟨l, ξ₀⟩⟩ : ↥((V l).comap (algebraMap K L))) = 1 := Subtype.ext hd1
    rw [h1, map_one] at hall
    exact one_ne_zero hall

  have hcard : Fintype.card ((i : Fin m) × ↥(S i)) = ∑ i, (S i).card := by
    rw [Fintype.card_sigma]
    simp
  rw [← hcard]
  exact hLIy.fintype_card_le_finrank

theorem wcpa_dj_lr1k_eb_rs_fd_sum : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (m : ℕ) (V : Fin m → ValuationSubring L) (n : ℕ), (∀ S : (i : Fin m) → Finset (IsLocalRing.ResidueField ↥(V i)), (∀ i, letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra; LinearIndependent (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (fun ξ : ↥(S i) => (ξ : IsLocalRing.ResidueField ↥(V i)))) → ∑ i, (S i).card ≤ n) → (∀ i, letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra; FiniteDimensional (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i))) ∧ ∑ i, wcEbBdResDeg K (V i) ≤ n :=
by
  classical
  intro K L _ _ _ m V n H
  refine ⟨fun i₀ => ?_, ?_⟩
  · letI : Algebra (IsLocalRing.ResidueField ↥((V i₀).comap (algebraMap K L)))
        (IsLocalRing.ResidueField ↥(V i₀)) := (wcEbBdResAlg K (V i₀)).toAlgebra
    have hbound : ∀ s : Finset (IsLocalRing.ResidueField ↥(V i₀)),
        LinearIndependent (IsLocalRing.ResidueField ↥((V i₀).comap (algebraMap K L)))
          (fun ξ : ↥s => (ξ : IsLocalRing.ResidueField ↥(V i₀))) → s.card ≤ n := by
      intro s hs
      let S : (i : Fin m) → Finset (IsLocalRing.ResidueField ↥(V i)) :=
        Function.update (fun i => (∅ : Finset (IsLocalRing.ResidueField ↥(V i)))) i₀ s
      have hS : ∀ i, letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra; LinearIndependent (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (fun ξ : ↥(S i) => (ξ : IsLocalRing.ResidueField ↥(V i))) := by
        intro i
        rcases eq_or_ne i i₀ with h | h
        · subst h
          have hSi : S i = s := by simp only [S, Function.update_self]
          rw [hSi]
          exact hs
        · letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L)))
            (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra
          have hSi : S i = ∅ := by simp only [S, Function.update_of_ne h]
          have : IsEmpty ↥(S i) := by rw [hSi]; infer_instance
          exact linearIndependent_empty_type
      have hsum : ∑ i, (S i).card = s.card := by
        rw [Fintype.sum_eq_single i₀]
        · simp only [S, Function.update_self]
        · intro i h
          simp only [S, Function.update_of_ne h, Finset.card_empty]
      have := H S hS
      omega
    have hr := rank_le hbound
    have hlt : Module.rank (IsLocalRing.ResidueField ↥((V i₀).comap (algebraMap K L)))
        (IsLocalRing.ResidueField ↥(V i₀)) < Cardinal.aleph0 :=
      lt_of_le_of_lt hr (Cardinal.natCast_lt_aleph0)
    exact Module.rank_lt_aleph0_iff.mp hlt
  · have hT : ∀ i, letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra; ∃ s : Finset (IsLocalRing.ResidueField ↥(V i)), s.card = wcEbBdResDeg K (V i) ∧ LinearIndependent (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (fun ξ : ↥s => (ξ : IsLocalRing.ResidueField ↥(V i))) := by
      intro i
      letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L)))
          (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra
      exact exists_finset_linearIndependent_of_le_finrank (le_of_eq rfl)
    choose T hTcard hTind using hT
    have h := H T hTind
    have e : ∑ i, wcEbBdResDeg K (V i) = ∑ i, (T i).card :=
      Finset.sum_congr rfl (fun i _ => (hTcard i).symm)
    rw [e]
    exact h

theorem wcpa_dj_lr1k_eb_rs_centre_cover : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (R : Subring K) (O : ValuationSubring K), O.toSubring = R → (∀ V'' : ValuationSubring L, V''.comap (algebraMap K L) = O → ∀ s : ↥(integralClosure ↥R L), (s : L) ∈ V'') ∧ ∀ M : Ideal ↥(integralClosure ↥R L), M.IsMaximal → ∃ V'' : ValuationSubring L, V''.comap (algebraMap K L) = O ∧ (∀ s : ↥(integralClosure ↥R L), (s : L) ∈ V'') ∧ ∀ s ∈ M, V''.valuation (s : L) < 1 :=
by
  intro K L _ _ _ R O hRO
  have memR : ∀ x : K, x ∈ O → x ∈ R := fun x hx => by
    rw [← hRO]; exact hx
  have memO : ∀ x : K, x ∈ R → x ∈ O := fun x hx => by
    rw [← hRO] at hx; exact hx
  have hA : ∀ V'' : ValuationSubring L, (∀ r : K, r ∈ R → algebraMap K L r ∈ V'') →
      ∀ s : ↥(integralClosure ↥R L), (s : L) ∈ V'' := by
    intro V'' hR0 s
    have hR : ∀ r : R, ((algebraMap K L).comp R.subtype) r ∈ V'' := fun r => hR0 r r.2
    obtain ⟨p, hpm, hp⟩ := s.2
    let ψ : R →+* V'' := ((algebraMap K L).comp R.subtype).codRestrict V'' hR
    have hcomp : (algebraMap V'' L).comp ψ = algebraMap R L := by ext; rfl
    have hint : _root_.IsIntegral V'' (s : L) :=
      ⟨p.map ψ, hpm.map ψ, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    rw [← hy]; exact y.2
  refine ⟨fun V'' hV'' => hA V'' (fun r hr => by
      have : r ∈ V''.comap (algebraMap K L) := by rw [hV'']; exact memO r hr
      exact this), ?_⟩
  intro M hM
  obtain ⟨V'', hle, himg⟩ := Ideal.image_subset_nonunits_valuationSubring
    (A := (integralClosure ↥R L).toSubring) M hM.ne_top
  have hS : ∀ s : ↥(integralClosure ↥R L), (s : L) ∈ V'' := fun s => hle s.2
  have hlt : ∀ s ∈ M, V''.valuation (s : L) < 1 := fun s hs =>
    (V''.mem_nonunits_iff).mp (himg ⟨s, hs, rfl⟩)
  refine ⟨V'', ?_, hS, hlt⟩
  ext x
  rw [ValuationSubring.mem_comap]
  constructor
  · intro hxV
    by_contra hx
    have hx0 : x ≠ 0 := fun h => hx (h ▸ O.zero_mem)
    have hxi : x⁻¹ ∈ O := (O.mem_or_inv_mem x).resolve_left hx
    have hvxi : O.valuation x⁻¹ < 1 := by
      have h1 : 1 < O.valuation x := by
        rw [← not_le, O.valuation_le_one_iff]; exact hx
      exact (Valuation.one_lt_val_iff _ hx0).mp h1
    have := hM
    have hP : (Ideal.comap (algebraMap ↥R ↥(integralClosure ↥R L)) M).IsMaximal :=
      Ideal.IsMaximal.under ↥R M
    have hr : (⟨x⁻¹, memR _ hxi⟩ : R) ∈
        Ideal.comap (algebraMap ↥R ↥(integralClosure ↥R L)) M := by
      by_contra hr
      obtain ⟨y, i, hi, hyi⟩ := hP.exists_inv hr
      have hiK : (i : K) = 1 - (y : K) * x⁻¹ := by
        have := congrArg Subtype.val hyi
        simp only [Subring.coe_add, Subring.coe_mul, Subring.coe_one] at this
        linear_combination this
      have hv1 : O.valuation ((y : K) * x⁻¹) < 1 := by
        rw [Valuation.map_mul]
        exact lt_of_le_of_lt
          (mul_le_of_le_one_left' ((O.valuation_le_one_iff _).mpr (memO _ y.2))) hvxi
      have hvi : O.valuation (i : K) = 1 := by
        rw [hiK]; exact Valuation.map_one_sub_of_lt _ hv1
      have hi0 : (i : K) ≠ 0 := fun h => by
        rw [h, map_zero] at hvi; exact zero_ne_one hvi
      have hiinv : (i : K)⁻¹ ∈ O :=
        (O.valuation_le_one_iff _).mp (by rw [map_inv₀, hvi, inv_one])
      have h1 : (⟨(i : K)⁻¹, memR _ hiinv⟩ : R) * i ∈
          Ideal.comap (algebraMap ↥R ↥(integralClosure ↥R L)) M :=
        Ideal.mul_mem_left _ _ hi
      have h2 : (⟨(i : K)⁻¹, memR _ hiinv⟩ : R) * i = 1 := Subtype.ext (inv_mul_cancel₀ hi0)
      rw [h2] at h1
      exact hP.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have h3 : V''.valuation (algebraMap K L x⁻¹) < 1 := hlt _ (Ideal.mem_comap.mp hr)
    have h4 : V''.valuation (algebraMap K L x) ≤ 1 := (V''.valuation_le_one_iff _).mpr hxV
    have h5 : V''.valuation (algebraMap K L x) * V''.valuation (algebraMap K L x⁻¹) = 1 := by
      rw [← Valuation.map_mul, ← map_mul, mul_inv_cancel₀ hx0, map_one, Valuation.map_one]
    have h6 := lt_of_le_of_lt (mul_le_of_le_one_left' h4) h3
    rw [h5] at h6
    exact lt_irrefl _ h6
  · intro hx
    exact hS ⟨algebraMap R L ⟨x, memR x hx⟩, Subalgebra.algebraMap_mem _ _⟩

theorem wcpa_dj_lr1k_eb_rs_lower_count : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] (R : Subring K) (O : ValuationSubring K), O.toSubring = R → Module.Free ↥R ↥(integralClosure ↥R L) → Module.finrank ↥R ↥(integralClosure ↥R L) = Module.finrank K L → (∀ b : ↥(integralClosure ↥R L), (∀ M : Ideal ↥(integralClosure ↥R L), M.IsMaximal → b ∈ M) → ∃ c : K, c ≠ 0 ∧ O.valuation c < 1 ∧ (b : L) / algebraMap K L c ∈ integralClosure ↥R L) → ∀ (r : ℕ) (V : Fin r → ValuationSubring L), (∀ i, (V i).comap (algebraMap K L) = O) → (∀ i, ∀ s : ↥(integralClosure ↥R L), (s : L) ∈ V i) → (∀ M : Ideal ↥(integralClosure ↥R L), M.IsMaximal → ∃ i, ∀ s ∈ M, (V i).valuation (s : L) < 1) → (∀ i, ∀ x ∈ V i, ∃ y : L, (V i).valuation (y - x) < 1 ∧ ∀ j, j ≠ i → (V j).valuation y < 1) → (∀ i, letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i)) := (wcEbBdResAlg K (V i)).toAlgebra; FiniteDimensional (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L))) (IsLocalRing.ResidueField ↥(V i))) → Module.finrank K L ≤ ∑ i, wcEbBdResDeg K (V i) :=
by
  classical
  intro K L _ _ _ _ R O hO hfree hrank hG4 r V hcomap hB hcov hRA hFD
  subst hO
  haveI := hfree
  by_contra hlt
  push_neg at hlt

  have hbasis : ∀ i, ∃ ξ : Fin (wcEbBdResDeg K (V i)) → IsLocalRing.ResidueField ↥(V i),
      ∀ w : IsLocalRing.ResidueField ↥(V i), ∃ a : Fin (wcEbBdResDeg K (V i)) →
        IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L)),
        w = ∑ k, wcEbBdResAlg K (V i) (a k) * ξ k := by
    intro i
    letI : Algebra (IsLocalRing.ResidueField ↥((V i).comap (algebraMap K L)))
