    by_contra hcon
    push_neg at hcon
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hs1 : ∀ w : ↥W, ¬ IsUnit w → ∃ M : ℕ, ϖ ∣ w ^ M := by
      intro w hw
      have hrad : w ∈ (Ideal.span {ϖ}).radical := by
        rw [Ideal.radical_eq_sInf]
        refine Ideal.mem_sInf.mpr ?_
        rintro J ⟨hJc, hJp⟩
        have hJne : J ≠ ⊥ := by
          intro h
          apply hϖ0
          have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
          rw [h] at h1
          exact Ideal.mem_bot.mp h1
        have hJmax : J.IsMaximal := by
          rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
          · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
          · exact h
        rw [IsLocalRing.eq_maximalIdeal hJmax]
        exact (IsLocalRing.mem_maximalIdeal w).mpr hw
      obtain ⟨M, hM⟩ := hrad
      exact ⟨M, Ideal.mem_span_singleton.mp hM⟩
    have hCmem : ∀ w : ↥W, ¬ IsUnit w →
        algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C w) ∈ wcGbP W ϖ d := by
      intro w hw
      obtain ⟨M, w', hw'⟩ := hs1 w hw
      refine ⟨M, ?_⟩
      have e1 : algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C w) ^ M =
          wcGbt W ϖ d * algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C w') := by
        rw [← map_pow, ← map_pow, hw', map_mul, map_mul]
      rw [e1]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    have hQmem : algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) Q ∈ wcGbP W ϖ d := by
      rw [MvPolynomial.as_sum Q, map_sum]
      refine Ideal.sum_mem _ (fun e _ => ?_)
      have hm : MvPolynomial.monomial e (Q.coeff e) =
          MvPolynomial.C (Q.coeff e) * MvPolynomial.monomial e (1 : ↥W) := by
        rw [MvPolynomial.C_mul_monomial, mul_one]
      rw [hm, map_mul]
      exact Ideal.mul_mem_right _ _ (hCmem _ (hcon e))
    have htN : algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ) ^ (N + 1)
        ∈ wcGbP W ϖ d :=
      Ideal.pow_mem_of_mem _ (Ideal.le_radical (Ideal.mem_span_singleton_self _)) (N + 1)
        (Nat.succ_pos N)
    apply hGp
    rw [hG]
    exact Ideal.add_mem _ hQmem (Ideal.mul_mem_right _ _ htN)
  refine ⟨P, Q, algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) *
      (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) u -
      algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) v *
        algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d) a +
      wcGrRoute W ϖ d Q * y₁), hQunit, ?_⟩
  have hrP : wcGrRoute W ϖ d P = algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d)
      (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) P) := rfl
  have hrQ : wcGrRoute W ϖ d Q = algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d)
      (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) Q) := rfl
  have hF' := congrArg (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d)) hF
  have hG' := congrArg (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d)) hG
  rw [map_add, map_mul, map_pow] at hF' hG'
  rw [hrP, hrQ, hE1]
  linear_combination hE2 - (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d) a) * hG' + hF'

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_ua_dn_coeff_field : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (w₀ : ↥W), ¬ IsUnit w₀ → (ringChar (IsLocalRing.ResidueField ↥W)).Prime → ((ringChar (IsLocalRing.ResidueField ↥W) : ℕ) : ↥W) ∈ Ideal.span {w₀} → (∀ c : ↥W, ¬ IsUnit c → ∃ M : ℕ, c ^ M ∈ Ideal.span {w₀}) → ∃ e : IsLocalRing.ResidueField ↥W →+* (↥W ⧸ Ideal.span {w₀}), ∀ (a : IsLocalRing.ResidueField ↥W) (w : ↥W), Ideal.Quotient.mk (Ideal.span {w₀}) w = e a → IsLocalRing.residue ↥W w = a :=
by
  intro Ω _ _ W w₀ hnu hp hpmem _
  classical

  have s1 : ∀ (n : ℕ) (G : Polynomial ↥W), G.Monic → G.natDegree = n →
      ∀ x : IsLocalRing.ResidueField ↥W, (G.map (IsLocalRing.residue ↥W)).eval x = 0 →
      ∃ z : ↥W, G.eval z = 0 ∧ IsLocalRing.residue ↥W z = x := by
    intro n
    induction n with
    | zero =>
      intro G hG hdeg x hx
      have h1 : G = 1 := Polynomial.eq_one_of_monic_natDegree_zero hG hdeg
      subst h1
      simp at hx
    | succ m ih =>
      intro G hG hdeg x hx
      have hG'm : (G.map (algebraMap ↥W Ω)).Monic := hG.map _
      have hG'deg : (G.map (algebraMap ↥W Ω)).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hG'm.ne_zero, hG.natDegree_map, hdeg]
        exact_mod_cast Nat.succ_ne_zero m
      obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root _ hG'deg
      have hζint : IsIntegral ↥W ζ := ⟨G, hG, by rw [← Polynomial.eval_map]; exact hζ⟩
      obtain ⟨w₁, hw₁⟩ := IsIntegrallyClosed.isIntegral_iff.mp hζint
      have hroot : G.IsRoot w₁ := by
        show G.eval w₁ = 0
        apply IsFractionRing.injective ↥W Ω
        rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hw₁]
        exact hζ
      obtain ⟨H, hfac⟩ : ∃ H, (Polynomial.X - Polynomial.C w₁) * H = G :=
        ⟨_, Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot⟩
      have hHm : H.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C w₁) (by rw [hfac]; exact hG)
      have hHdeg : H.natDegree = m := by
        have h2 := (Polynomial.monic_X_sub_C w₁).natDegree_mul hHm
        rw [hfac, hdeg, Polynomial.natDegree_X_sub_C] at h2
        omega
      rw [← hfac] at hx
      simp only [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
        Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at hx
      rcases mul_eq_zero.mp hx with h | h
      · exact ⟨w₁, hroot, (sub_eq_zero.mp h).symm⟩
      · obtain ⟨z, hz, hzx⟩ := ih H hHm hHdeg x h
        refine ⟨z, ?_, hzx⟩
        rw [← hfac, Polynomial.eval_mul, hz, mul_zero]

  have s5 : ∀ (Q k K : Type u) [CommRing Q] [Field k] [Field K] (rb : Q →+* k) (j : K →+* Q),
      (∀ F : Polynomial Q, F.Monic → ∀ x : k, (F.map rb).eval x = 0 → ∃ r : Q, F.eval r = 0 ∧ rb r = x) →
      ∀ x : k, (∃ P : Polynomial K, P ≠ 0 ∧ P.eval₂ (rb.comp j) x = 0) →
      ∃ E : Subring Q, (∀ y ∈ E, y ≠ 0 → ∃ z ∈ E, y * z = 1) ∧ (∀ c : K, j c ∈ E) ∧
        ∃ q ∈ E, rb q = x := by
    intro Q k K _ _ _ rb j hlift x hP
    obtain ⟨P, hP0, hPx⟩ := hP
    letI : Algebra K k := (rb.comp j).toAlgebra
    have halg : IsAlgebraic K x := ⟨P, hP0, by rw [Polynomial.aeval_def]; exact hPx⟩
    have hint : IsIntegral K x := halg.isIntegral
    have hfm : (minpoly K x).Monic := minpoly.monic hint
    haveI : Fact (Irreducible (minpoly K x)) := ⟨minpoly.irreducible hint⟩
    obtain ⟨r, hr, hrx⟩ := hlift ((minpoly K x).map j) (hfm.map j) x (by
      rw [Polynomial.map_map, Polynomial.eval_map]
      have h1 := minpoly.aeval K x
      rw [Polynomial.aeval_def] at h1
      exact h1)
    have hr' : (minpoly K x).eval₂ j r = 0 := by rw [← Polynomial.eval_map]; exact hr
    refine ⟨(AdjoinRoot.lift j r hr').range, ?_, fun c => RingHom.mem_range.mpr
      ⟨AdjoinRoot.of _ c, AdjoinRoot.lift_of hr'⟩, r,
      RingHom.mem_range.mpr ⟨AdjoinRoot.root _, AdjoinRoot.lift_root hr'⟩, hrx⟩
    intro y hy hy0
    obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hy
    have ha0 : a ≠ 0 := fun h => hy0 (by rw [h, map_zero])
    exact ⟨AdjoinRoot.lift j r hr' a⁻¹, RingHom.mem_range.mpr ⟨a⁻¹, rfl⟩,
      by rw [← map_mul, mul_inv_cancel₀ ha0, map_one]⟩

  have s6 : ∀ (Q k K : Type u) [CommRing Q] [Field k] [Field K] (rb : Q →+* k) (j : K →+* Q),
      Function.Surjective rb → (∀ q : Q, rb q ≠ 0 → IsUnit q) →
      ∀ x : k, (∀ P : Polynomial K, P ≠ 0 → P.eval₂ (rb.comp j) x ≠ 0) →
      ∃ E : Subring Q, (∀ y ∈ E, y ≠ 0 → ∃ z ∈ E, y * z = 1) ∧ (∀ c : K, j c ∈ E) ∧
        ∃ q ∈ E, rb q = x := by
    intro Q k K _ _ _ rb j hs hu x htr
    obtain ⟨y, hy⟩ := hs x
    have hg : ∀ P : nonZeroDivisors (Polynomial K), IsUnit (Polynomial.eval₂RingHom j y P) := by
      intro P
      apply hu
      have h1 : rb (Polynomial.eval₂RingHom j y P) = (P : Polynomial K).eval₂ (rb.comp j) x := by
        rw [← hy, Polynomial.coe_eval₂RingHom]
        exact Polynomial.hom_eval₂ _ _ _ _
      rw [h1]
      exact htr _ (nonZeroDivisors.ne_zero P.2)
    let φ : FractionRing (Polynomial K) →+* Q := IsLocalization.lift hg
    have hφ : ∀ P : Polynomial K, φ (algebraMap _ _ P) = P.eval₂ j y := fun P =>
      IsLocalization.lift_eq hg P
    refine ⟨φ.range, ?_, fun c => RingHom.mem_range.mpr ⟨algebraMap _ _ (Polynomial.C c), ?_⟩, y,
      RingHom.mem_range.mpr ⟨algebraMap (Polynomial K) _ Polynomial.X, ?_⟩, hy⟩
    · intro z hz hz0
      obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hz
      have ha0 : a ≠ 0 := fun h => hz0 (by rw [h, map_zero])
      exact ⟨φ a⁻¹, RingHom.mem_range.mpr ⟨a⁻¹, rfl⟩,
        by rw [← map_mul, mul_inv_cancel₀ ha0, map_one]⟩
    · rw [hφ, Polynomial.eval₂_C]
    · rw [hφ, Polynomial.eval₂_X]

  have s7 : ∀ (Q k : Type u) [CommRing Q] [Field k] (rb : Q →+* k) (E₀ : Subring Q),
      (∀ y ∈ E₀, y ≠ 0 → ∃ z ∈ E₀, y * z = 1) →
      (∀ (K : Type u) [Field K] (j : K →+* Q) (x : k), ∃ E : Subring Q,
        (∀ y ∈ E, y ≠ 0 → ∃ z ∈ E, y * z = 1) ∧ (∀ c : K, j c ∈ E) ∧ ∃ q ∈ E, rb q = x) →
      ∃ e : k →+* Q, ∀ a : k, rb (e a) = a := by
    intro Q k _ _ rb E₀ hE₀ hext
    haveI : Nontrivial Q := RingHom.domain_nontrivial rb
    obtain ⟨E, -, hEmax⟩ := zorn_le_nonempty₀
      {E : Subring Q | ∀ y ∈ E, y ≠ 0 → ∃ z ∈ E, y * z = 1} (by
      intro c hcS hc y hy
      refine ⟨sSup c, ?_, fun z hz => le_sSup hz⟩
      intro a ha ha0
      obtain ⟨E', hE'c, haE'⟩ := (Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn).mp ha
      obtain ⟨b, hb, hab⟩ := hcS hE'c a haE' ha0
      exact ⟨b, le_sSup hE'c hb, hab⟩) E₀ hE₀
    have hES : ∀ y ∈ E, y ≠ 0 → ∃ z ∈ E, y * z = 1 := hEmax.prop
    have hfield : IsField ↥E := by
      refine ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩, fun a b => mul_comm a b, ?_⟩
      intro a ha
      obtain ⟨b, hb, hab⟩ := hES a a.2 (fun h => ha (Subtype.ext h))
      exact ⟨⟨b, hb⟩, Subtype.ext hab⟩
