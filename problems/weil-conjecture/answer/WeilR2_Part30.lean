    rw [hp, Polynomial.coeff_map]; exact ((minpoly K₁ α).coeff i).2
  have hpα : p.eval α = 0 := by
    rw [hp, Polynomial.eval_map, ← Polynomial.aeval_def]; exact hmα
  have hp'α : p.derivative.eval α ≠ 0 := by
