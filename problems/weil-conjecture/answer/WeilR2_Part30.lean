    rw [Category.assoc, hmπ, ← Category.assoc, hσ₀V, hσ₀]
  have hG := hsecEval (σ₀V ≫ m) hsec₀
  have hb₀ : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₀V ≫ m).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) =
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₀.appLE V ⊤ e₀).hom (g (MvPolynomial.X 0))) := by
    rw [hlift σ₀ σ₀V hσ₀V e₀, ← hEx, hcompTop]
  rw [hb₀] at hG

  have hmem : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₀.appLE V ⊤ e₀).hom (g (MvPolynomial.X 0)))
