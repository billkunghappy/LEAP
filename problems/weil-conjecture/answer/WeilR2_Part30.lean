            (algebraMap Ω (RatFunc Ω))) (η b) p +
          algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) a) := by
        rw [Polynomial.eval₂_add, Polynomial.eval₂_C]; rfl
      rcases lt_or_gt_of_ne hAB with hlt' | hgt'
      · refine ⟨a', j, ha', by rw [Polynomial.coeff_add, Polynomial.coeff_C, if_neg hj, add_zero,
