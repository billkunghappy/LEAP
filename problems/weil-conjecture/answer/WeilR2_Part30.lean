    have hlift : f.scaleRoots Q ∈ Polynomial.lifts A.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i f.natDegree with hi | hi | hi
      · obtain ⟨ha, hq, hfa⟩ := h i hi
        have e1 : Q = q i * ∏ j ∈ (Finset.range f.natDegree).erase i, q j := by
          rw [← hQ]; exact (Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hi)).symm
        have e2 : Q ^ (f.natDegree - i) = Q * Q ^ (f.natDegree - i - 1) := by
          rw [← pow_succ']; congr 1; omega
        have key : f.coeff i * Q ^ (f.natDegree - i) =
            a i * (∏ j ∈ (Finset.range f.natDegree).erase i, q j) * Q ^ (f.natDegree - i - 1) := by
          rw [← hfa, e2]
