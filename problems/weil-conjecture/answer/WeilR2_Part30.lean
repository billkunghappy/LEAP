by
  classical

  have sp_prim_power : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
      (q : ℕ) [ExpChar L q] (n0 : ℕ) (z0 : Fin n0 → L), ∃ (e D : ℕ) (α : L), IsSeparable K α ∧
      ∀ i, ∃ a : Fin D → K, z0 i ^ (q ^ e) = ∑ k : Fin D, algebraMap K L (a k) * α ^ (k : ℕ) := by
    intro K L _ _ _ _ q _ n0 z0
    set S := separableClosure K L with hS
    have : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
    have : IsPurelyInseparable S L := separableClosure.isPurelyInseparable K L
    have : Algebra.IsSeparable K S := separableClosure.isSeparable K L
    have : FiniteDimensional K S := IntermediateField.finiteDimensional_left S
    have hS1 : ExpChar S (ringExpChar S) := ringExpChar.expChar S
    have hL1 : ExpChar L (ringExpChar S) :=
      expChar_of_injective_algebraMap (algebraMap S L).injective (ringExpChar S)
    have hq : ringExpChar S = q := ExpChar.eq hL1 inferInstance
    have : ExpChar S q := hq ▸ hS1
    have hpm : ∀ i, ∃ n : ℕ, ∃ s : S, z0 i ^ (q ^ n) = (s : L) := by
      intro i
      obtain ⟨n, s, hs⟩ := IsPurelyInseparable.pow_mem S q (z0 i)
      exact ⟨n, s, hs.symm⟩
    choose n s hs using hpm
    set e := Finset.univ.sup n with he
    have hw : ∀ i, z0 i ^ (q ^ e) = ((s i ^ (q ^ (e - n i)) : S) : L) := by
      intro i
      have hle : n i ≤ e := Finset.le_sup (Finset.mem_univ i)
      have : q ^ e = q ^ (n i) * q ^ (e - n i) := by
        rw [← pow_add, Nat.add_sub_cancel' hle]
      rw [this, pow_mul, hs i]
      rfl
