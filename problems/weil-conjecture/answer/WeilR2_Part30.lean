  have hσ₀s : σ₀ (IsLocalRing.closedPoint ↥W) ∈ V :=
    e₀ (show IsLocalRing.closedPoint ↥W ∈ (⊤ : (Spec (.of ↥W)).Opens) from trivial)
  have e : ⊤ ≤ (ΔU ≫ V.ι) ⁻¹ᵁ V :=
    (Scheme.preimage_eq_top_of_closedPoint_mem (ΔU ≫ V.ι) (by rw [hσs]; exact hσ₀s)).ge
  refine ⟨ΔU ≫ V.ι, e, ?_, hσs, ?_⟩
  · rw [Category.assoc, ← hmπ, ← Category.assoc, hΔU, hεsec]
  · rw [hlift (ΔU ≫ V.ι) ΔU rfl e, ← hEx, ← hcompTop, hΔU, hεval]

theorem wcpa_dj_lr1k_ll_disc_param : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
