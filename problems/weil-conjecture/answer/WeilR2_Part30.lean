    have hinj : Function.Injective (rb.comp E.subtype) := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      by_contra ha0
      obtain ⟨b, hb, hab⟩ := hES a a.2 (fun h => ha0 (Subtype.ext h))
      have h1 : rb ((a : Q) * b) = 1 := by rw [hab, map_one]
      rw [map_mul] at h1
      have h2 : rb (a : Q) = 0 := ha
      rw [h2, zero_mul] at h1
      exact zero_ne_one h1
    let eqv := RingEquiv.ofBijective (rb.comp E.subtype) ⟨hinj, fun x => hsurj x⟩
    refine ⟨E.subtype.comp eqv.symm.toRingHom, fun a => ?_⟩
    exact eqv.apply_symm_apply a

  have hw₀m : w₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hnu
  have hI : ∀ a ∈ Ideal.span {w₀}, IsLocalRing.residue ↥W a = 0 := by
    intro a ha
    rw [IsLocalRing.residue_eq_zero_iff]
    exact (Ideal.span_singleton_le_iff_mem _).mpr hw₀m ha
  let rb : (↥W ⧸ Ideal.span {w₀}) →+* IsLocalRing.ResidueField ↥W :=
    Ideal.Quotient.lift _ (IsLocalRing.residue ↥W) hI
  have hrb : ∀ w, rb (Ideal.Quotient.mk _ w) = IsLocalRing.residue ↥W w := fun w =>
    Ideal.Quotient.lift_mk _ _ _
  have hrbs : Function.Surjective rb := by
    intro x
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective x
    exact ⟨_, hrb w⟩
  have hunit : ∀ q, rb q ≠ 0 → IsUnit q := by
    intro q hq
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective q
    rw [hrb, IsLocalRing.residue_ne_zero_iff_isUnit] at hq
    exact hq.map _
  haveI : Nontrivial (↥W ⧸ Ideal.span {w₀}) := RingHom.domain_nontrivial rb

  have hroot : ∀ F : Polynomial (↥W ⧸ Ideal.span {w₀}), F.Monic → ∀ x,
      (F.map rb).eval x = 0 → ∃ r, F.eval r = 0 ∧ rb r = x := by
    intro F hF x hx
    have hl : F ∈ Polynomial.lifts (Ideal.Quotient.mk (Ideal.span {w₀})) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact Ideal.Quotient.mk_surjective _
    obtain ⟨G, hGF, -, hGm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl hF
    have hGres : G.map (IsLocalRing.residue ↥W) = F.map rb := by
      rw [← hGF, Polynomial.map_map]
      congr 1
    obtain ⟨z, hz, hzx⟩ := s1 _ G hGm rfl x (by rw [hGres]; exact hx)
    refine ⟨Ideal.Quotient.mk _ z, ?_, by rw [hrb, hzx]⟩
    rw [← hGF, Polynomial.eval_map, Polynomial.eval₂_at_apply, hz, map_zero]

  haveI : Fact (ringChar (IsLocalRing.ResidueField ↥W)).Prime := ⟨hp⟩
  have hpQ : ((ringChar (IsLocalRing.ResidueField ↥W) : ℕ) : ↥W ⧸ Ideal.span {w₀}) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk (Ideal.span {w₀}))]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hpmem
  haveI : CharP (↥W ⧸ Ideal.span {w₀}) (ringChar (IsLocalRing.ResidueField ↥W)) :=
    (CharP.charP_iff_prime_eq_zero hp).mpr hpQ
  let ψ : ZMod (ringChar (IsLocalRing.ResidueField ↥W)) →+* (↥W ⧸ Ideal.span {w₀}) :=
    ZMod.castHom (dvd_refl _) _
  have hE₀ : ∀ y ∈ ψ.range, y ≠ 0 → ∃ z ∈ ψ.range, y * z = 1 := by
    intro y hy hy0
    obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hy
    have ha0 : a ≠ 0 := fun h => hy0 (by rw [h, map_zero])
    exact ⟨ψ a⁻¹, RingHom.mem_range.mpr ⟨a⁻¹, rfl⟩,
