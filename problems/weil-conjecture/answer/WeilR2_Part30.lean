  have hdesc : ∀ a : A, IsIntegral T a → IsIntegral T₀ a := by
    intro a ha
    have h1 : IsIntegral T' a := by
      obtain ⟨p, hpm, hp⟩ := ha
      refine ⟨p.map (φ.rangeRestrict : T →+* T'), hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have e : (algebraMap T' A).comp (φ.rangeRestrict : T →+* T') = algebraMap T A := by
        ext t; rfl
      rw [e]; exact hp
