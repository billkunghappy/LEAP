    exact hs3 _ hR hfin
  ·
    choose U hU hyU using hcov
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun y => (U y : Set Y))
      (fun y => (U y).isOpen) (fun z _ => Set.mem_iUnion.2 ⟨z, hyU z⟩)
    have hT : ∀ y, ∃ T : Set (PrimeSpectrum Γ(Y, U y)), T.Finite ∧
        ∀ 𝔭 : PrimeSpectrum Γ(Y, U y), 𝔭 ∉ T → ∀ (R : Type u) [CommRing R]
          [Algebra Γ(Y, U y) R] [IsLocalization.AtPrime R 𝔭.asIdeal],
          Module.length R (↥(integralClosure R (FractionRing R)) ⧸
            LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) = 0 := by
      intro y
      obtain ⟨hft, hdimU⟩ := hchart (U y) (hU y)
      letI : Algebra κ Γ(Y, U y) :=
        ((Scheme.ΓSpecIso (.of κ)).inv ≫ q.appLE ⊤ (U y) le_top).hom.toAlgebra
      haveI : Algebra.FiniteType κ Γ(Y, U y) := hft
      exact wcpa_dj_lr1k_imfc_generic_normal κ Γ(Y, U y) (hdimU.trans hY)
    choose T hTfin hTzero using hT
    refine Set.Finite.subset (Set.Finite.biUnion (Finset.finite_toSet t)
      (fun y _ => (hTfin y).image (fun p => (hU y).fromSpec p))) ?_
    intro z hz
    obtain ⟨y, hyt, hzy⟩ : ∃ y ∈ t, z ∈ U y := by
      have := ht (Set.mem_univ z)
      simpa using this
    rw [Set.mem_iUnion₂]
    refine ⟨y, hyt, (hU y).primeIdealOf ⟨z, hzy⟩, ?_, (hU y).fromSpec_primeIdealOf ⟨z, hzy⟩⟩
    by_contra hnot
    letI : Algebra Γ(Y, U y) (Y.presheaf.stalk z) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨z, hzy⟩
    haveI hloc : IsLocalization.AtPrime (Y.presheaf.stalk z)
        ((hU y).primeIdealOf ⟨z, hzy⟩).asIdeal :=
      (hU y).isLocalization_stalk ⟨z, hzy⟩
    exact hz (hTzero y _ hnot (Y.presheaf.stalk z))

theorem wcpa_dj_lr1k_imp_measure_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι → wcpaDjLkMeasure W (γ ≫ ι) uX < ⊤ :=
by
  classical
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM
  obtain ⟨hproj, hsm, hirr, hfinγ, hgen⟩ := hcov
  obtain ⟨hss, hXp, hpb⟩ := hM
  haveI : IsFinite γ := hfinγ

  haveI hνfin : IsFinite (γ ≫ ι).fromNormalization :=
    wcpa_dj_lr1s_normalization_finite Ω W hW hWt C (γ ≫ wcProjKStr Ω 1) γ hproj hsm hirr hfinγ
      rfl hgen X uX ι hss hXp hpb

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : PerfectField (IsLocalRing.ResidueField ↥W) := IsAlgClosed.perfectField _

  have hdimXκ := (wcpa_dj_lus_cvs_ct_closed_fibre_dim Ω W hκ X uX hss).2

  have hdim : topologicalKrullDim ↥(wcpaDjLkFib W (γ ≫ ι) uX) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    let s₀ := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))
    let p := Limits.pullback.map ((γ ≫ ι).fromNormalization ≫ uX) s₀ uX s₀
      (γ ≫ ι).fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp)
    have hp1 : p ≫ Limits.pullback.snd uX s₀ =
        Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX) s₀ := by
      show Limits.pullback.lift _ _ _ ≫ _ = _
      rw [Limits.pullback.lift_snd, Category.comp_id]
    have hp2 : p ≫ Limits.pullback.fst uX s₀ =
        Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX) s₀ ≫ (γ ≫ ι).fromNormalization := by
      show Limits.pullback.lift _ _ _ ≫ _ = _
      rw [Limits.pullback.lift_fst]
    have H : IsPullback p (Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX) s₀)
        (Limits.pullback.fst uX s₀) (γ ≫ ι).fromNormalization := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd uX s₀) (v₁₃ := s₀) (h₂₂ := uX)
        ?_ hp2 (IsPullback.of_hasPullback uX s₀).flip
      rw [hp1]
      exact (IsPullback.of_hasPullback ((γ ≫ ι).fromNormalization ≫ uX) s₀).flip
    haveI : IsFinite p := MorphismProperty.of_isPullback (P := @IsFinite) H.flip hνfin
    exact (wc_finite_topologicalKrullDim_le p).trans hdimXκ

  haveI : IsProper uX := hss.2.1
  haveI : QuasiCompact (Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI : LocallyOfFiniteType (Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI : CompactSpace ↥(wcpaDjLkFib W (γ ≫ ι) uX) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))

  have hc : (γ ≫ ι) ≫ uX =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [Category.assoc, Category.assoc, hpb.w]
  haveI : AlgebraicGeometry.IsReduced (wcpaDjLkFib W (γ ≫ ι) uX) :=
    wcpa_dj_lr1k_imf_fib_reduced Ω W hWt C X (γ ≫ ι) uX (γ ≫ wcProjKStr Ω 1) hc

  obtain ⟨hδtop, hδfin⟩ := wcpa_dj_lr1k_imf_curve_delta_finite (IsLocalRing.ResidueField ↥W)
    (wcpaDjLkFib W (γ ≫ ι) uX) (Limits.pullback.snd ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) hdim

  have key : ∀ (T : Type u) (g : T → ℕ∞) (S : Finset T), (∀ y, g y ≠ ⊤) → (∀ y ∉ S, g y = 0) →
      (⨆ s : Finset T, ∑ y ∈ s, g y) < ⊤ := by
    intro T g S h1 h2
    refine lt_of_le_of_lt (b := ∑ y ∈ S, g y) (iSup_le fun s => ?_) ?_
    · calc ∑ y ∈ s, g y ≤ ∑ y ∈ s ∪ S, g y :=
            Finset.sum_le_sum_of_subset Finset.subset_union_left
        _ = ∑ y ∈ S, g y :=
            (Finset.sum_subset Finset.subset_union_right (fun y _ hy => h2 y hy)).symm
    · exact ENat.sum_lt_top.mpr (fun y _ => lt_top_iff_ne_top.mpr (h1 y))
  have hmeas : wcpaDjLkMeasure W (γ ≫ ι) uX =
      ⨆ s : Finset ↥(wcpaDjLkFib W (γ ≫ ι) uX), ∑ y ∈ s, wcpaDjLkTerm W (γ ≫ ι) uX y := rfl
  rw [hmeas]
  refine key _ _ hδfin.toFinset ?_ ?_
  · intro y
    show (if wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) then
      wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) ^ 2 +
        2 * wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) -
        wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) else 0) ≠ ⊤
    split_ifs with hb
    · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (hδtop y)
      rw [← hn]
      refine ne_top_of_le_ne_top (b := ((n ^ 2 + 2 * n : ℕ) : ℕ∞)) (ENat.coe_ne_top _) ?_
      refine le_trans tsub_le_self ?_
      push_cast
      exact le_rfl
    · exact ENat.zero_ne_top
  · intro y hy
    have h0 : wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) = 0 := by
      by_contra h
      exact hy (hδfin.mem_toFinset.mpr h)
    show (if wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) then
      wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) ^ 2 +
        2 * wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) -
        wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) else 0) = 0
    exact if_neg (fun hb => hb (Or.inl h0))

theorem wcpa_dj_bsc_smooth_descend : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (K : Type u) [Field K] (s : Spec (.of K) ⟶ S) (w : ↥(Limits.pullback g s)), Flat g → LocallyOfFinitePresentation g → (∃ W : (Limits.pullback g s).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g s)) → ∃ W' : Y.Opens, Limits.pullback.fst g s w ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g) :=
by
  intro S Y g K _ s w hflat hlfp ⟨W, hwW, hWsm⟩
  classical

  have s2 : ∀ (P X B : Scheme.{u}) (snd : P ⟶ B) (ι : X ⟶ P) (h : X ⟶ B), IsOpenImmersion ι →
      ι ≫ snd = h → ∀ (w : P), w ∈ Set.range ι → ∀ (W : P.Opens), w ∈ W →
      SmoothOfRelativeDimension 1 (W.ι ≫ snd) →
      ∃ x : X, ι x = w ∧ ∃ W' : X.Opens, x ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ h) := by
    intro P X B snd ι h hι hh w hw W hwW hW
    obtain ⟨x, hx⟩ := hw
    refine ⟨x, hx, ι ⁻¹ᵁ W, ?_, ?_⟩
    · show ι x ∈ W
      rw [hx]; exact hwW
    · have e1 : (ι ⁻¹ᵁ W).ι ≫ h = (ι ∣_ W) ≫ (W.ι ≫ snd) := by
        rw [← hh, ← Category.assoc, ← Category.assoc, morphismRestrict_ι]
      rw [e1]
      haveI : SmoothOfRelativeDimension 0 (ι ∣_ W) := inferInstance
      haveI := hW
      exact smoothOfRelativeDimension_comp 0 1 (ι ∣_ W) (W.ι ≫ snd)

  have s4 : ∀ (A T : Type u) [CommRing A] [CommRing T] [Algebra A T] (n : ℕ) (Q : Ideal T)
      [Q.IsPrime] (s : T), s ∉ Q →
      Algebra.IsStandardSmoothOfRelativeDimension n A (Localization.Away s) →
      Algebra.IsSmoothAt A Q := by
    intro A T _ _ _ n Q _ s hs hstd
    haveI := hstd
    haveI : Algebra.IsStandardSmooth A (Localization.Away s) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FormallySmooth A (Localization.Away s) := inferInstance
    letI : Algebra (Localization.Away s) (Localization.AtPrime Q) :=
      (IsLocalization.lift (M := Submonoid.powers s) (S := Localization.Away s)
        (g := algebraMap T (Localization.AtPrime Q)) (by
          rintro ⟨_, k, rfl⟩
          show IsUnit (algebraMap T (Localization.AtPrime Q) (s ^ k))
          rw [map_pow]
          exact (IsLocalization.map_units (Localization.AtPrime Q)
            (⟨s, hs⟩ : Q.primeCompl)).pow k)).toAlgebra
    haveI : IsScalarTower T (Localization.Away s) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun t => (IsLocalization.lift_eq _ t).symm)
    haveI : IsScalarTower A (Localization.Away s) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        rw [IsScalarTower.algebraMap_apply A T (Localization.Away s),
          ← IsScalarTower.algebraMap_apply T (Localization.Away s) (Localization.AtPrime Q),
