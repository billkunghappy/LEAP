    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  have hess : Algebra.EssFiniteType k κ := by
    apply IntermediateField.fg_top_iff.mp
    refine ⟨((Set.finite_range s).union (Set.finite_range b)).toFinset, ?_⟩
    rw [Set.Finite.coe_toFinset, eq_top_iff]
    intro x _
    obtain ⟨a, ha, rfl⟩ := hb x
    refine sum_mem (fun j _ => mul_mem ?_ ?_)
    · exact IntermediateField.adjoin.mono k _ _ Set.subset_union_left (ha j)
    · exact IntermediateField.subset_adjoin k _ (Set.mem_union_right _ ⟨j, rfl⟩)
  have hsTB : IsTranscendenceBasis k s := by
    have : Algebra.IsAlgebraic K₀ κ := Algebra.IsAlgebraic.of_finite K₀ κ
    apply hs.isTranscendenceBasis_iff_isAlgebraic.mpr
    exact ⟨fun x => IntermediateField.isAlgebraic_adjoin_iff.mp (Algebra.IsAlgebraic.isAlgebraic x)⟩
  obtain ⟨S, hS, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField k κ
  have hcard := hsTB.lift_cardinalMk_eq hS
  rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at hcard
  obtain ⟨e⟩ := Cardinal.mk_eq_nat_iff.mp hcard.symm
  set z : Fin d → κ := Subtype.val ∘ e.symm with hzdef
  have hz : Set.range z = S := by
    rw [hzdef, Set.range_comp, Equiv.range_eq_univ, Set.image_univ, Subtype.range_coe]
  have hzind : AlgebraicIndependent k z := hS.1.comp e.symm e.symm.injective
  have hzTB : IsTranscendenceBasis k z := hS.comp_equiv e.symm
  refine ⟨z, hzind, ?_, ?_⟩
