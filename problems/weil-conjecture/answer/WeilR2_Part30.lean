  have wcpa_dj_mscc_cc_ker_open_lift : ∀ (X T : Scheme.{u}) (U : X.Opens) (Δ : T ⟶ X) (ΔU : T ⟶ U.toScheme), ΔU ≫ U.ι = Δ → ∀ h : Γ(X, U), RingHom.ker (Δ.app U).hom = Ideal.span {h} → RingHom.ker ΔU.appTop.hom = Ideal.span {U.topIso.inv.hom h} := by
