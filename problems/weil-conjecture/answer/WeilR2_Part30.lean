    obtain ⟨z, hwz, hint⟩ := h4a _ hw0
    refine ⟨M * N, Nat.findGreatest S (M * N + j₀ * N), y₁, z, hy₁, hint.resolve_left hwi, h₁, ?_⟩
    calc τ ^ (M * N) * x ^ N * z = τ ^ Nat.findGreatest S (M * N + j₀ * N) * y₁ * z := by rw [h₁]
      _ = τ ^ Nat.findGreatest S (M * N + j₀ * N) * (τ * (y₁ * ↑u⁻¹)) * z := by rw [hτw]
