      rwa [h3] at h2
    have hfg : (⊤ : Submodule K L).FG := htop ▸ Submodule.fg_span (Set.finite_range b)
    exact Module.Finite.of_fg_top hfg

  have sp_clear_denom : ∀ (V K L : Type u) [CommRing V] [IsDomain V] [Field K] [Algebra V K]
      [IsFractionRing V K] [CommRing L] [Algebra V L] [Algebra K L] [IsScalarTower V K L] (D : ℕ)
      (m : V), m ≠ 0 → ∀ (α : L) (a : Fin D → K), ∃ (s : V) (c : Fin D → V), s ≠ 0 ∧
      algebraMap V L s * ∑ k : Fin D, algebraMap K L (a k) * α ^ (k : ℕ) =
        ∑ k : Fin D, algebraMap V L (c k) * (algebraMap V L m * α) ^ (k : ℕ) := by
    intro V K L _ _ _ _ _ _ _ _ _ D m hm α a
    obtain ⟨β, hβ⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors V) Finset.univ a
    have hc : ∀ k : Fin D, ∃ c' : V, algebraMap V K c' = algebraMap V K (β : V) * a k := by
      intro k
      obtain ⟨c', hc'⟩ := hβ k (Finset.mem_univ k)
      refine ⟨c', ?_⟩
      rw [hc', Algebra.smul_def]
    choose c' hc' using hc
    refine ⟨(β : V) * m ^ D, fun k => c' k * m ^ (D - (k : ℕ)), ?_, ?_⟩
    · exact mul_ne_zero (nonZeroDivisors.coe_ne_zero β) (pow_ne_zero _ hm)
    · rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      have hk : m ^ D = m ^ (D - (k : ℕ)) * m ^ (k : ℕ) :=
        (pow_sub_mul_pow m (le_of_lt k.2)).symm
      have hck : algebraMap V L (c' k) = algebraMap V L (β : V) * algebraMap K L (a k) := by
        rw [IsScalarTower.algebraMap_apply V K L, hc' k, map_mul, ← IsScalarTower.algebraMap_apply]
      rw [hk]
      simp only [map_mul, map_pow, mul_pow]
      rw [hck]
      ring

  have core : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] (F : Type u) [CommRing F]
      [IsDomain F] [Algebra V F] (t : V), Function.Injective (algebraMap V F) →
      IsUnit (algebraMap V F t) → (∀ y : F, y ≠ 0 → ∃ z : F, y * z = 1) → ∀ (nb : ℕ)
      (b : Fin nb → F), (∀ x : F, ∃ N : ℕ, algebraMap V F t ^ N * x ∈
        Submodule.span V (Set.range b)) → (∀ x : V, x ≠ 0 → ∃ N : ℕ, x ∣ t ^ N) →
      ∀ (z : Fin d → F), ∃ (e D N : ℕ) (γ : F) (gm : Polynomial V), IsIntegral V γ ∧ gm.Monic ∧
        Polynomial.eval₂ (algebraMap V F) γ gm = 0 ∧
        Polynomial.eval₂ (algebraMap V F) γ (Polynomial.derivative gm) ≠ 0 ∧
        ∀ i, ∃ c : Fin D → V, (algebraMap V F t) ^ N * z i ^ (ringExpChar F ^ e) =
          ∑ k, algebraMap V F (c k) * γ ^ (k : ℕ) := by
    intro V _ _ _ F _ _ _ t h1 h2 h4 nb b hbspan VV4 z
    have hF : IsField F := ⟨exists_pair_ne F, mul_comm, fun {y} hy => h4 y hy⟩
    letI : Field F := hF.toField
    have : FaithfulSMul V F := (faithfulSMul_iff_algebraMap_injective V F).mpr h1
    letI : Algebra (FractionRing V) F := FractionRing.liftAlgebra V F
    have : IsScalarTower V (FractionRing V) F := FractionRing.isScalarTower_liftAlgebra V F
    have htN : ∀ N : ℕ, t ^ N ≠ 0 := by
      intro N h0
      apply (h2.pow N).ne_zero
      rw [← map_pow, h0, map_zero]
    have : FiniteDimensional (FractionRing V) F := by
      apply sp_fin_dim V (FractionRing V) F nb b
