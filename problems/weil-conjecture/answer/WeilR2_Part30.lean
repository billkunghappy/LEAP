    · have h3 : x * y ∈ Ideal.span {ℓ} * (Ideal.span {ℓ} * m) := hC ▸ hxy
      obtain ⟨z, hz, hz'⟩ := Ideal.mem_span_singleton_mul.mp h3
      obtain ⟨c, hc, hc'⟩ := Ideal.mem_span_singleton_mul.mp hz
