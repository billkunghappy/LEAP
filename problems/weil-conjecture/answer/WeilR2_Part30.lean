    have hK𝔪 : K ≤ 𝔪 := hK ▸ (Ideal.map_mono hI₀).trans hgq
    have hpn : q ^ n ≤ q := Ideal.pow_le_self hn
    have h𝔪n : 𝔪 ^ n ≤ 𝔪 := Ideal.pow_le_self hn
    obtain ⟨hHR, hunitR, hmemR, hnilR⟩ :=
      s1 R q (I₀ ⊔ q ^ n) n hq hn le_sup_right (sup_le hI₀ hpn)
    obtain ⟨hHQ, hunitQ, -, -⟩ :=
