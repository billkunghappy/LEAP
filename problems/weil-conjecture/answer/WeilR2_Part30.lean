by
  intro Ω _ _ W hdim hW L _ _ _ _ m U e η u hMoBD a ha0 ham c hc O hO V' hV' b hb1 hb2 g hgm
    hg0 hge htr γ hγγ ψ hψw hψX
  classical
  let ι : Ω →+* L := (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))

  have ha0' : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hc0 : c ≠ 0 := by
    rintro rfl
    apply ha0'
    rw [← hc, zero_mul]
  have hg0' : (g : Ω) ≠ 0 := fun h => hg0 (Subtype.ext h)
  have hγ0 : γ ≠ 0 := by
    rintro rfl
